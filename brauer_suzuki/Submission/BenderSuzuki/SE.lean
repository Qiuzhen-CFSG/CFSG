/-!
## Definition of Strongly Embedded Subgroup

Following [IG; Definition 17.1, Proposition 17.11], a proper subgroup `M` of a
finite group `X` is *strongly embedded* if `M` contains a Sylow `2`-subgroup of
`X` and for every involution `x ∈ M`, the centralizer `C_X(x)` is contained in
`M`.
-/

/-- A subgroup `M` of a finite group `X` is *strongly embedded* if:
1. `M` is a proper subgroup of `X`;
2. `M` contains a Sylow `2`-subgroup of `X`;
3. For every involution `x ∈ M`, the centralizer `C_X(x)` is contained in `M`.

This is equivalent to the definition in [IG; 17.1, 17.11]. -/
public def IsStronglyEmbedded {X : Type u} [Group X] [Finite X] (M : Subgroup X) : Prop :=
  M ≠ ⊤ ∧
  (∃ S : Sylow 2 X, (S : Subgroup X) ≤ M) ∧
  ∀ x : X, x ∈ M → IsInvolution x → Subgroup.centralizer ({x} : Set X) ≤ M

/-- `M` contains a Sylow `2`-subgroup of `X`. -/
theorem IsStronglyEmbedded.containsSylowTwo {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (h : IsStronglyEmbedded M) : ∃ S : Sylow 2 X, (S : Subgroup X) ≤ M :=
  h.2.1

/-- For every involution `x ∈ M`, `C_X(x) ≤ M`. -/
theorem IsStronglyEmbedded.centralizer_le {X : Type u} [Group X] [Finite X] {M : Subgroup X}
    (h : IsStronglyEmbedded M) {x : X} (hxM : x ∈ M) (hxInv : IsInvolution x) :
    Subgroup.centralizer ({x} : Set X) ≤ M :=
  h.2.2 x hxM hxInv

/-- The set of all involutions of a group `X`. -/
def involutionsSet (X : Type u) [Group X] : Set X :=
  {x : X | IsInvolution x}

/-- The subgroup generated by all involutions of `X`, denoted `⟨I(X)⟩` in the source. -/
public def involutionCore (X : Type u) [Group X] : Subgroup X :=
  Subgroup.closure (involutionsSet X)

/-- `involutionCore X` is normal in `X`. -/
public theorem involutionCore_normal {X : Type u} [Group X] : (involutionCore X).Normal := by
  -- The set of involutions is closed under conjugation (by `isInvolution_rightConjugateElem`).
  -- Hence its closure is normal.
  refine ⟨fun n hn g => ?_⟩
  -- Use induction on `hn : n ∈ involutionCore X = Subgroup.closure (involutionsSet X)`
  -- Predicate: p n hn := g * n * g⁻¹ ∈ involutionCore X
  let p (x : X) (_hx : x ∈ involutionCore X) : Prop :=
    g * x * g⁻¹ ∈ involutionCore X
  refine Subgroup.closure_induction (p := p) ?_ ?_ ?_ ?_ hn
  · -- base case: n ∈ involutionsSet X
    intro x hx
    dsimp [p]
    have hx_inv : IsInvolution x := hx
    have h_conj : IsInvolution (rightConjugateElem x g⁻¹) :=
      isInvolution_rightConjugateElem hx_inv
    have hmem : rightConjugateElem x g⁻¹ ∈ involutionsSet X := h_conj
    simpa [rightConjugateElem] using Subgroup.subset_closure hmem
  · -- n = 1: g * 1 * g⁻¹ = 1
    dsimp [p]
    group
    exact Subgroup.one_mem _
  · -- multiplication: g*(a*b)*g⁻¹ = (g*a*g⁻¹)*(g*b*g⁻¹)
    intro a b _ha _hb ha' hb'
    dsimp [p] at ha' hb' ⊢
    -- ha' : g * a * g⁻¹ ∈ involutionCore X
    -- hb' : g * b * g⁻¹ ∈ involutionCore X
    -- Goal: g * (a * b) * g⁻¹ ∈ involutionCore X
    have h : g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) := by group
    rw [h]
    exact Subgroup.mul_mem _ ha' hb'
  · -- inverse: g*a⁻¹*g⁻¹ = (g*a*g⁻¹)⁻¹
    intro a _ha ha'
    dsimp [p] at ha' ⊢
    have h : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
    rw [h]
    exact Subgroup.inv_mem _ ha'

/-- `O_{2'}(G)` is the largest normal subgroup of odd order, i.e., the `2'`-core. -/
public def twoPrimeCore (X : Type u) [Group X] : Subgroup X :=
  pPrimeCore 2 X

/-- The `2'`-core is normal (instance for typeclass search). -/
public instance twoPrimeCore_normal {X : Type u} [Group X] : (twoPrimeCore X).Normal := by
  unfold twoPrimeCore
  infer_instance

/-!
## Simple Bender Groups

The *simple Bender groups* are the groups
`L_2(2^n)`, `²B_2(2^{n/2})`, and `U_3(2^n)` for `n ≥ 2`.
-/

/-- A finite group `G` is a simple Bender group if it is isomorphic to one of:
`L_2(2^n)`, `²B_2(2^{n/2})`, or `U_3(2^n)` for some `n ≥ 2`.

Note: For Suzuki groups `²B_2(2^{n/2})`, the parameter `n` must be odd and `≥ 3`.
The condition `n ≥ 2` in the source covers all three families uniformly.
Note: In this encoding, the Suzuki parameter `n` corresponds to the field size
`2^{2n+1}`; the source's unified parameter `n` gives `²B_2(2^{n/2})`, so our `n`
is `(source_n - 2)/4` for Suzuki groups.  The bound `1 ≤ n` includes `Sz(8)`
(`SuzukiMatrixGroup 1` = `²B_2(2^3)`). -/
public inductive IsSimpleBenderGroup (G : Type u) [Group G] [Finite G] : Prop
  | isPSL2 : (∃ n : ℕ, 2 ≤ n ∧ Nonempty (G ≃* PSL2BinaryMatrixGroup n)) → IsSimpleBenderGroup G
  | isSuzuki : (∃ n : ℕ, 1 ≤ n ∧ Nonempty (G ≃* SuzukiMatrixGroup n)) → IsSimpleBenderGroup G
  | isPSU3 : (∃ n : ℕ, 2 ≤ n ∧
      ∃ (E : Type) (_ : Field E) (_ : Finite E) (J : HermitianForm 3 E),
        J.form = !![0, 0, 1; 0, 1, 0; 1, 0, 0] ∧
        Nat.card E = (2 ^ n) ^ 2 ∧
        Nat.card {x : E // J.conj x = x} = 2 ^ n ∧
        Nonempty (G ≃* ProjectiveSpecialUnitaryMatrixGroup J)) → IsSimpleBenderGroup G

/-- `IsSimpleBenderGroup` implies the group is simple. -/
theorem IsSimpleBenderGroup.isSimple {G : Type u} [Group G] [Finite G]
    (h : IsSimpleBenderGroup G) : IsSimpleGroup G := by
  rcases h with ⟨⟨n, hn, h⟩⟩ | ⟨⟨n, hn, h⟩⟩ | ⟨⟨n, hn, E, hEfield, hEfinite, J, hJform, hEcard, hfixedCard, h⟩⟩
  · -- PSL(2, 2^n) case: n ≥ 2
    have hnpos : n ≠ 0 := by omega
    have hcard : Nat.card (BinaryGaloisField n) = 2 ^ n := by
      simpa [BinaryGaloisField] using GaloisField.card 2 n hnpos
    have hcard_ne_two : Nat.card (BinaryGaloisField n) ≠ 2 := by
      rw [hcard]
      have h2n_ge_4 : 2 ^ 2 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
      have h4 : 2 ^ 2 = 4 := by norm_num
      rw [h4] at h2n_ge_4
      omega
    have hcard_ne_three : Nat.card (BinaryGaloisField n) ≠ 3 := by
      rw [hcard]
      have h2n_ge_4 : 2 ^ 2 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
      have h4 : 2 ^ 2 = 4 := by norm_num
      rw [h4] at h2n_ge_4
      omega
    haveI : IsSimpleGroup (PSL2BinaryMatrixGroup n) := by
      dsimp [PSL2BinaryMatrixGroup, PSL2MatrixGroup]
      apply External.huppert_II_6_13 (K := BinaryGaloisField n) 2 (by omega)
        (Or.inr hcard_ne_two) (Or.inr hcard_ne_three)
    exact Nonempty.elim h fun e => e.isSimpleGroup_congr.mpr ‹_›
  · -- Suzuki case: n ≥ 1
    have hnpos : 0 < n := by omega
    haveI : IsSimpleGroup (SuzukiMatrixGroup n) :=
      (External.huppert_blackburn_XI_3_6 n hnpos).1
    exact Nonempty.elim h fun e => e.isSimpleGroup_congr.mpr ‹_›
  · -- PSU(3, 2^n) case: n ≥ 2
    have hqpos : 2 < 2 ^ n := by
      have : 2 ^ 2 = 4 := by norm_num
      have hpow : 2 ^ 2 ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
      omega
    haveI : IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J) := by
      apply External.huppert_II_10_13 J (2 ^ n) hqpos hEcard hfixedCard
    exact Nonempty.elim h fun e => e.isSimpleGroup_congr.mpr ‹_›

/-!
## Definition SZ: Strongly `Z`-embedded subgroup

(Source: Definition SZ, page 37)
-/

/-- `M` controls `X`-fusion in a Sylow `2`-subgroup of `M` (Definition SZ(c)).

This means there exists a Sylow `2`-subgroup `S` of `M` such that for any `a, b ∈ S`,
if `a` and `b` are conjugate in `X`, they are already conjugate in `M`. -/
public def controlsFusionInSylowTwo {X : Type u} [Group X] [Finite X] (M : Subgroup X) : Prop :=
  ∃ (S : Sylow 2 M), ∀ (a b : X),
    a ∈ (Subgroup.map (Subgroup.subtype M) (S : Subgroup M)) →
    b ∈ (Subgroup.map (Subgroup.subtype M) (S : Subgroup M)) →
    (∃ (g : X), rightConjugateElem a g = b) →
    (∃ (m : X), m ∈ M ∧ rightConjugateElem a m = b)

/-- `M` is strongly `Z`-embedded in `X` (Definition SZ, page 37).

Conditions:
(a) `Z_M ≠ ∅`;
(b) `C_X(z) ≤ M` for every `z ∈ Z_M`;
(c) `M` controls `X`-fusion in a Sylow `2`-subgroup of `M`;
(d) if `H` is a proper subgroup of `X` with `Z_H ∩ M` nonempty and `H ≰ M`,
    then `H° ∩ M` is strongly embedded in `H°`, where `H° = ⟨Z_H⟩`. -/
public structure IsStronglyZEmbedded {X : Type u} [Group X] [Finite X] (Z : Set X) (M : Subgroup X) : Prop where
  ZM_nonempty : (Z ∩ (M : Set X)).Nonempty
  centralizer_le : ∀ z ∈ Z, z ∈ M → Subgroup.centralizer ({z} : Set X) ≤ M
  controls_fusion : controlsFusionInSylowTwo M
  inductive_condition :
    ∀ (H : Subgroup X), H ≠ ⊤ → ((Z ∩ (H : Set X)) ∩ (M : Set X)).Nonempty → ¬ (H ≤ M) →
      let H0 := Subgroup.closure (Z ∩ (H : Set X))
      IsStronglyEmbedded ((H0 ⊓ M).subgroupOf H0)

/-- An involution `x` in a finite group `G` is `2`-central if its centralizer contains
a Sylow `2`-subgroup of `G`. -/
public def Is2CentralInvolution {G : Type u} [Group G] [Finite G] (x : G) : Prop :=
  ∃ S : Sylow 2 G, (S : Subgroup G) ≤ Subgroup.centralizer ({x} : Set G)

/-- `Z` is a conjugacy class of `2`-central involutions in `X`: nonempty,
every element is an involution and `2`-central, `Z` is closed under conjugation,
and any two elements of `Z` are conjugate. -/
public def IsConjugacyClassOf2CentralInvolutions {X : Type u} [Group X] [Finite X] (Z : Set X) : Prop :=
  Z.Nonempty ∧ (∀ x ∈ Z, IsInvolution x ∧ Is2CentralInvolution x) ∧
    (∀ x g, x ∈ Z → rightConjugateElem x g ∈ Z) ∧
    (∀ x ∈ Z, ∀ z' ∈ Z, ∃ g : X, rightConjugateElem x g = z')

/-- A subgroup `B` is a Borel subgroup of a finite group `G` (in the context of simple
Bender groups): `B` is solvable and contains a Sylow `2`-subgroup of `G` as a normal
subgroup of `B`.

Reference: source (1F), page 41. -/
public def IsBorelSubgroup {G : Type u} [Group G] [Finite G] (B : Subgroup G) : Prop :=
  IsSolvable B ∧
  ∃ S : Sylow 2 G, (S : Subgroup G) ≤ B ∧ ((S : Subgroup G).subgroupOf B).Normal

/-!
## Theorem SE (Bender-Suzuki)

Let `X` be a finite group containing a strongly embedded subgroup `M`.
Set `L = ⟨I(X)⟩`. Then either `L` has `2`-rank `1` or
`L / O_{2'}(L)` is a simple Bender group.

Moreover, if `X` is simple, then `X` itself is a simple Bender group.
-/

/-- Theorem SE (Bender and Suzuki).

Let `X` be a finite group containing a strongly embedded subgroup `M`.
Let `L = ⟨I(X)⟩` be the subgroup generated by all involutions of `X`.
Then one of the following holds:

1. `L` has `2`-rank `1` (i.e., `¬ TwoRankAtLeastTwo L`); or
2. `L / O_{2'}(L)` is a simple Bender group. In this case:
   - `O_{2'}(L) ≤ M ∩ L`;
   - `(M ∩ L) / O_{2'}(L)` is a Borel subgroup of `L / O_{2'}(L)`.

Finally, if `X` is simple, then `X` itself is a simple Bender group
(i.e., `X ≅ L_2(2^n)`, `²B_2(2^{n/2})`, or `U_3(2^n)` for some `n ≥ 2`). -/
public theorem theorem_SE {X : Type u} [Group X] [Finite X] (M : Subgroup X)
    (h_se : IsStronglyEmbedded M) :
    let L := involutionCore X
    (¬ TwoRankAtLeastTwo L) ∨
    (IsSimpleBenderGroup (L ⧸ twoPrimeCore L) ∧
      (twoPrimeCore L).map (Subgroup.subtype L) ≤ M ⊓ L ∧
      let Q := L ⧸ twoPrimeCore L
      IsBorelSubgroup (((M ⊓ L).subgroupOf L).map (QuotientGroup.mk' (twoPrimeCore L)))) := by
  sorry

/-- The simplification of Theorem SE when `X` is simple.

When `m_2(X) = 1`, the involutions of `X` lie in `Z*(X)` [IG; 15.2, 15.3] and so
`X` cannot be simple, which justifies the final statement. -/
public theorem theorem_SE_simple {X : Type u} [Group X] [Finite X] (M : Subgroup X)
    (h_se : IsStronglyEmbedded M) (h_simple : IsSimpleGroup X) :
    IsSimpleBenderGroup X := by
  -- This follows from `theorem_SE` together with the fact that in a simple group,
  -- O_{2'}(X) = 1 and the 2-rank 1 case cannot occur (by Glauberman's Z*-theorem
  -- [IG; 15.2, 15.3]).
  sorry

/-!
## Subsidiary Theorems (Core Steps)

The following theorems constitute the core steps in the proof of Theorem SE
(as outlined in Section 2 of the source). They are stated in the context of
a minimal counterexample `X` to Theorem ZD, which also provides a proof of
Theorem SE.

### Notation Setup (following (2A)--(2C), (3A)--(3C), (3E))

We fix:
- `X`: a finite group (minimal counterexample to Theorem ZD)
- `Z`: an `X`-invariant set of involutions, product-disconnected with respect to `M`
- `M`: a proper subgroup of `X`
- `Ω = {M^g | g ∈ X}`: the set of `X`-conjugates of `M`
- `α = M`: the distinguished point in `Ω`
- `z ∈ Z_M`: a fixed involution
- `C = C_X(z)`
- `m = |Z_M| = |M : C_M(z)|` (odd by Proposition 3.6e)
-/

section SubsidiaryTheorems

variable {X : Type u} [Group X] [Finite X]
  (Z : Set X)
  (M : Subgroup X)
  (Ω : Type v) [MulAction X Ω] [Finite Ω]
  (α : Ω)
  (z : X)

/-- The full conclusion of Theorem ZD (source pages 38-39).

Let `L = ⟨Z'⟩` and `O = O_{2'}(L)`.  Then either `L` has `2`-rank `1`, or
there exists `u ∈ M' ∩ L` of order `1` or `2` such that

(a) `L = [L,L]⟨u⟩`;
(b) `L/O = [L,L]̄ × ⟨ū⟩` (direct product in the quotient);
(c) `[L,L]̄` is a simple Bender group;
(d) `O ≤ M' ∩ [L,L]` and `M'̄ ∩ [L,L]̄` is a Borel subgroup of `[L,L]̄`;
(e) `Z'̄ ⊆ ū·[L,L]̄ \ {ū}`. -/
public def conclusionOfTheoremZD' (Z' : Set X) (M' : Subgroup X) : Prop :=
  let L := Subgroup.closure Z'
  let O := pPrimeCore 2 L
  (¬ TwoRankAtLeastTwo L) ∨
  (∃ (u : X) (hu : u ∈ M' ⊓ L), (u = 1 ∨ IsInvolution u) ∧
    -- (a) L = [L,L]⟨u⟩
    L = (⁅L, L⁆) ⊔ (Subgroup.closure {u}) ∧
    -- set up quotient machinery
    let π := QuotientGroup.mk' O
    let C := ((⁅L, L⁆).subgroupOf L).map π
    let U := ((Subgroup.closure {u}).subgroupOf L).map π
    let uL : L := ⟨u, (Subgroup.mem_inf.mp hu).right⟩
    -- (b) in the quotient L/O: commutator image C and u-image U form direct product
    C ⊓ U = ⊥ ∧ (⊤ : Subgroup (L ⧸ O)) = C ⊔ U ∧
    -- (c) C is a simple Bender group
    IsSimpleBenderGroup C ∧
    -- (d) O ≤ M' ∩ [L,L];  M'̄ ∩ C is a Borel subgroup of C (as a subgroup of C)
    O.map (Subgroup.subtype L) ≤ M' ⊓ (⁅L, L⁆) ∧
    IsBorelSubgroup (((((M' ⊓ L).subgroupOf L).map π) ⊓ C).subgroupOf C) ∧
    -- (e) the *set* image of Z' in the quotient is contained in u·C minus u
    (∀ z (hz : z ∈ Z'), (π ⟨z, Subgroup.subset_closure hz⟩)⁻¹ * π uL ∈ C) ∧
    (∀ z (hz : z ∈ Z'), π ⟨z, Subgroup.subset_closure hz⟩ ≠ π uL))

/-- The setup for a minimal counterexample to Theorem ZD.

This collects the hypotheses from (2A), (2B), (2C), (3A), (3B), (3C), and the
definition of product-disconnection (Definition ZD, page 37-38). -/
public structure MinimalCounterexampleZD where
  /-- `Z` is an `X`-invariant set of involutions. -/
  hZ_inv : ∀ x : X, x ∈ Z → IsInvolution x
  hZ_closed : ∀ (x g : X), x ∈ Z → rightConjugateElem x g ∈ Z
  /-- `Z` is product-disconnected in `X` with respect to `M`.

  Definition ZD(a): `Z_M ≠ ∅`. -/
  hZ_prod_disconnected_M_nonempty : (Z ∩ (M : Set X)).Nonempty
  /-- Definition ZD(b): for any `z' ∈ Z_M` and `g ∈ X`, `z'^g ∈ M` iff `g ∈ M`. -/
  hZ_prod_disconnected_conj : ∀ (z' : X) (g : X),
    z' ∈ Z ∩ (M : Set X) → (rightConjugateElem z' g ∈ M ↔ g ∈ M)
  /-- Definition ZD(c): define `P` to be the set of *involutions* `u` of `X` expressible
  as a product `u = x*z` of two (commuting) elements of `Z`. Then `C_X(u) ≤ M`
  for all `u ∈ P ∩ M`. -/
  hZ_prod_disconnected_P : ∀ (u : X),
    IsInvolution u → (∃ (x z' : X), x ∈ Z ∧ z' ∈ Z ∧ Commute x z' ∧ u = x * z') → u ∈ M →
    Subgroup.centralizer ({u} : Set X) ≤ M
  /-- `M` is a proper subgroup. -/
  hM_proper : M ≠ ⊤
  /-- `Ω` is the set of `X`-conjugates of `M`, transitive action. -/
  hΩ_trans : MulAction.IsPretransitive X Ω
  hα_stab : MulAction.stabilizer X α = M
  /-- `z` is a fixed element of `Z_M`. -/
  hz : z ∈ Z ∩ (M : Set X)
  /-- (3A): `m_2(X) > 1`. -/
  hX_2rank_gt_1 : TwoRankAtLeastTwo X
  /-- (3B): `X = ⟨Z⟩`. -/
  hX_gen_by_Z : Subgroup.closure Z = ⊤
  /-- Minimality: `X` is a minimal counterexample to Theorem ZD.
  By (1D), for any proper subgroup `H` of `X` with `Z_{H∩M} ≠ ∅` and
  `H∩M < H`, the set `Z_H` is product-disconnected in `H` w.r.t. `H∩M`.
  The induction hypothesis applies to `H` with `Z_H` and `H∩M`. -/
  hX_min : ∀ (H : Subgroup X), H ≠ ⊤ →
    ((Z ∩ (H : Set X)) ∩ ((H ⊓ M) : Set X)).Nonempty →
    (∀ (z' : X) (g : X), z' ∈ (Z ∩ (H : Set X)) ∩ ((H ⊓ M) : Set X) → g ∈ H →
      (rightConjugateElem z' g ∈ (H ⊓ M) ↔ g ∈ (H ⊓ M))) →
    (∀ (u : X), IsInvolution u →
      (∃ (x z' : X), x ∈ Z ∩ (H : Set X) ∧ z' ∈ Z ∩ (H : Set X) ∧ Commute x z' ∧ u = x * z') →
      u ∈ (H ⊓ M) → (Subgroup.centralizer ({u} : Set X) ⊓ H) ≤ (H ⊓ M)) →
    conclusionOfTheoremZD' (Z ∩ (H : Set X)) (H ⊓ M)

/-- The parameter `m = |Z_M|`. -/
def param_m (_h : MinimalCounterexampleZD Z M Ω α z) : ℕ :=
  Nat.card ((Z ∩ (M : Set X) : Set X))

/-- `m` is odd (Proposition 3.6e). -/
def param_m_odd (_h : MinimalCounterexampleZD Z M Ω α z) : Odd (param_m Z M Ω α z _h) := by
  sorry

/-- The set `S` from (2D): triples `(γ, δ, s)` where `γ, δ ∈ Ω`, `s ∈ Z`, and
`γ^s = γ ≠ δ`. -/
def setS (Z' : Set X) (Ω' : Type v) [MulAction X Ω'] : Set (Ω' × Ω' × X) :=
  { p : Ω' × Ω' × X | p.1 ∈ Set.univ ∧ p.2.1 ∈ Set.univ ∧ p.2.2 ∈ Z' ∧ (p.2.2 • p.1 = p.1) ∧ (p.1 ≠ p.2.1) }

/-!
## Section 3: Basic Setup and Counting Arguments

The following lemmas are proved in the context of a minimal counterexample
`X` to Theorem ZD.
-/

/-- Lemma 3.1(a): if z'^g ∈ M then g ∈ M, for z' ∈ Z_M.
This is exactly the product-disconnection condition (b). -/
theorem lemma_3_1a (h : MinimalCounterexampleZD Z M Ω α z) (z' g : X)
    (hz' : z' ∈ Z ∩ (M : Set X)) : (rightConjugateElem z' g ∈ M ↔ g ∈ M) :=
  h.hZ_prod_disconnected_conj z' g hz'

/-- Lemma 3.1(b): C_X(z') ≤ M for z' ∈ Z_M.

Proof: If x ∈ C_X(z'), then z'^x = z' ∈ M.  By product-disconnection (b),
this implies x ∈ M. -/
theorem lemma_3_1b (h : MinimalCounterexampleZD Z M Ω α z) (z' : X)
    (hz' : z' ∈ Z ∩ (M : Set X)) :
    Subgroup.centralizer ({z'} : Set X) ≤ M := by
  intro x hx
  -- hx : x ∈ Subgroup.centralizer ({z'} : Set X), i.e., x commutes with z'
  have hx_comm : Commute x z' := by
    rw [Subgroup.mem_centralizer_singleton_iff] at hx
    exact hx
  -- Then rightConjugateElem z' x = x⁻¹ * z' * x = z'
  have h_conj_eq : rightConjugateElem z' x = z' := by
    dsimp [rightConjugateElem]
    calc
      x⁻¹ * z' * x = x⁻¹ * (z' * x) := by group
      _ = x⁻¹ * (x * z') := by rw [hx_comm.eq]
      _ = z' := by group
  -- Since z' ∈ M, we have rightConjugateElem z' x ∈ M
  have h_conj_mem : rightConjugateElem z' x ∈ M := by
    rw [h_conj_eq]
    exact hz'.2
  -- By product-disconnection (b), this implies x ∈ M
  rcases (h.hZ_prod_disconnected_conj z' x hz').mp h_conj_mem with hxM
  exact hxM

/-- Lemma 3.1(c): If R ≤ M and Z_R ≠ ∅, then N_X(R) ≤ M. -/
theorem lemma_3_1c (h : MinimalCounterexampleZD Z M Ω α z) (R : Subgroup X)
    (hR_le_M : R ≤ M) (hZR_nonempty : (Z ∩ (R : Set X)).Nonempty) :
    Subgroup.normalizer (R : Set X) ≤ M := by
  rcases hZR_nonempty with ⟨z', hz'⟩
  have hz'ZM : z' ∈ Z ∩ (M : Set X) := by
    rcases hz' with ⟨hz'Z, hz'R⟩
    exact ⟨hz'Z, hR_le_M hz'R⟩
  intro n hn
  -- hn : n ∈ Subgroup.normalizer (R : Set X)
  -- Using `mem_normalizer_iff''` which says: n ∈ N(R) ↔ ∀ h, h ∈ R ↔ n⁻¹ * h * n ∈ R
  have hn_normalizer : rightConjugateElem z' n ∈ R := by
    rcases hz' with ⟨hz'Z, hz'R⟩
    have hmem : z' ∈ (R : Set X) ↔ n⁻¹ * z' * n ∈ (R : Set X) :=
      (Subgroup.mem_normalizer_iff''.mp hn) (z' : X)
    -- hmem.mp : z' ∈ (R : Set X) → n⁻¹ * z' * n ∈ (R : Set X)
    -- Goal: n⁻¹ * z' * n ∈ (R : Set X) (after dsimp)
    dsimp [rightConjugateElem]
    exact hmem.mp hz'R
  have hzn_mem_M : rightConjugateElem z' n ∈ M := hR_le_M hn_normalizer
  -- By lemma_3_1a, this implies n ∈ M
  have h_equiv : rightConjugateElem z' n ∈ M ↔ n ∈ M :=
    lemma_3_1a Z M Ω α z h z' n hz'ZM
  -- h_equiv.mp : rightConjugateElem z' n ∈ M → n ∈ M
  exact Iff.mp h_equiv hzn_mem_M

/-- Lemma 3.1(g): for each u ∈ Z, u^X meets X - M nontrivially. -/
theorem lemma_3_1g (h : MinimalCounterexampleZD Z M Ω α z) (u : X) (hu : u ∈ Z) :
    ∃ (g : X), rightConjugateElem u g ∉ M := by
  by_cases huM : u ∈ M
  · -- u ∈ Z_M. By (a), for any g ∈ X - M, u^g ∉ M.
    have huZM : u ∈ Z ∩ (M : Set X) := ⟨hu, huM⟩
    -- There exists g ∈ X - M because M ≠ ⊤.
    have h_exists : ∃ g : X, g ∉ M := by
      by_contra h_all
      push_neg at h_all
      have hM_top : M = ⊤ := by
        ext x; simp; exact h_all x
      exact h.hM_proper hM_top
    rcases h_exists with ⟨g, hgM⟩
    have h_conj_not_M : rightConjugateElem u g ∉ M := by
      rw [h.hZ_prod_disconnected_conj u g huZM]
      exact hgM
    exact ⟨g, h_conj_not_M⟩
  · -- u ∉ M, then u itself (conjugate by 1) works
    refine ⟨1, ?_⟩
    simpa [rightConjugateElem] using huM

/-- If s and t are involutions and st has even order, then there exists a nontrivial
central involution in ⟨s,t⟩, namely (st)^k where k = orderOf(st)/2. -/
lemma central_involution_of_two_involutions {G : Type*} [Group G] (s t : G)
    (hs : s ^ 2 = 1) (ht : t ^ 2 = 1) (hst_even : Even (orderOf (s * t)))
    (hst_pos : 0 < orderOf (s * t)) :
    ∃ (v : G), v ^ 2 = 1 ∧ v ≠ 1 ∧ Commute v s ∧ Commute v t := by
  rcases hst_even with ⟨k, hk⟩
  -- hk : orderOf (s * t) = k + k  (since Even uses n = k + k)
  let v := (s * t) ^ k
  have hs_sq_eq_one : s * s = 1 := by
    rw [← pow_two, hs]
  have ht_sq_eq_one : t * t = 1 := by
    rw [← pow_two, ht]
  have hk_pos : 0 < k := by
    by_contra hk_nonpos
    have hk_zero : k = 0 := by omega
    have h_order_zero : orderOf (s * t) = 0 := by
      rw [hk, hk_zero, add_zero]
    omega
  have hv_sq' : v * v = 1 := by
    calc
      v * v = v ^ 2 := by rw [pow_two]
      _ = ((s * t) ^ k) ^ 2 := rfl
      _ = (s * t) ^ (k * 2) := by rw [pow_mul]
      _ = (s * t) ^ (2 * k) := by rw [mul_comm]
      _ = (s * t) ^ (k + k) := by ring
      _ = (s * t) ^ (orderOf (s * t)) := by rw [hk]
      _ = 1 := pow_orderOf_eq_one (s * t)
  have hv_sq : v ^ 2 = 1 := by
    rw [pow_two, hv_sq']
  have hv_ne_one : v ≠ 1 := by
    intro hv_eq_one
    have h_order_le : orderOf (s * t) ≤ k := orderOf_le_of_pow_eq_one (by omega) hv_eq_one
    rw [hk] at h_order_le
    omega
  -- Useful: s⁻¹ = s and t⁻¹ = t (since s² = t² = 1)
  have hs_inv : s⁻¹ = s :=
    (eq_inv_of_mul_eq_one_left hs_sq_eq_one).symm
  have ht_inv : t⁻¹ = t :=
    (eq_inv_of_mul_eq_one_left ht_sq_eq_one).symm
  -- Key identity: s*(st)*s = (st)⁻¹
  have h_conj : s * (s * t) * s = (s * t)⁻¹ := by
    calc
      s * (s * t) * s = (s * s) * t * s := by group
      _ = 1 * t * s := by rw [hs_sq_eq_one]
      _ = t * s := by group
      _ = (s * t)⁻¹ := by
        rw [mul_inv_rev, hs_inv, ht_inv]
  -- Show s * v * s = v
  have h_conv_s : s * v * s = v := by
    calc
      s * v * s = s * (s * t) ^ k * s := rfl
      _ = s * (s * t) ^ k * s⁻¹ := by rw [hs_inv]
      _ = (s * (s * t) * s⁻¹) ^ k := by
        rw [(conj_pow (a := s) (b := s * t) (i := k)).symm]
      _ = (s * (s * t) * s) ^ k := by rw [hs_inv]
      _ = ((s * t)⁻¹) ^ k := by rw [h_conj]
      _ = ((s * t) ^ k)⁻¹ := by rw [inv_pow]
      _ = v⁻¹ := rfl
      _ = v := by
        apply (eq_inv_of_mul_eq_one_left hv_sq').symm
  -- From s*v*s = v, deduce s*v = v*s
  have h_comm_s : Commute v s := by
    have : s * v = v * s := by
      calc
        s * v = s * v * 1 := by group
        _ = s * v * (s * s) := by rw [hs_sq_eq_one]
        _ = (s * v * s) * s := by group
        _ = v * s := by rw [h_conv_s]
    rw [Commute, SemiconjBy]
    exact this.symm
  -- Similarly for t
  have h_conj_t : t * (s * t) * t = (s * t)⁻¹ := by
    calc
      t * (s * t) * t = (t * s) * (t * t) := by group
      _ = (t * s) * 1 := by rw [ht_sq_eq_one]
      _ = t * s := by group
      _ = (s * t)⁻¹ := by
        rw [mul_inv_rev, ht_inv, hs_inv]
  have h_conv_t : t * v * t = v := by
    calc
      t * v * t = t * (s * t) ^ k * t := rfl
      _ = t * (s * t) ^ k * t⁻¹ := by rw [ht_inv]
      _ = (t * (s * t) * t⁻¹) ^ k := by
        rw [(conj_pow (a := t) (b := s * t) (i := k)).symm]
      _ = (t * (s * t) * t) ^ k := by rw [ht_inv]
      _ = ((s * t)⁻¹) ^ k := by rw [h_conj_t]
      _ = ((s * t) ^ k)⁻¹ := by rw [inv_pow]
      _ = v⁻¹ := rfl
      _ = v := by
        apply (eq_inv_of_mul_eq_one_left hv_sq').symm
  have h_comm_t : Commute v t := by
    have : t * v = v * t := by
      calc
        t * v = t * v * 1 := by group
        _ = t * v * (t * t) := by rw [ht_sq_eq_one]
        _ = (t * v * t) * t := by group
        _ = v * t := by rw [h_conv_t]
    rw [Commute, SemiconjBy]
    exact this.symm
  exact ⟨v, hv_sq, hv_ne_one, h_comm_s, h_comm_t⟩

/-- In a dihedral group generated by two involutions s,t, the conjugate of s by (st)^i is s·(st)^{2i}. -/
lemma conj_s_by_st_pow {G : Type*} [Group G] (s t : G) (hs : s ^ 2 = 1) (ht : t ^ 2 = 1)
    (i : ℕ) : rightConjugateElem s ((s * t) ^ i) = s * (s * t) ^ (2 * i) := by
  -- Key identity: s*(st) = t (since s² = 1)
  have h_s_st : s * (s * t) = t := by
    calc
      s * (s * t) = (s * s) * t := by group
      _ = 1 * t := by rw [hs]
      _ = t := by group
  -- Also: (st)⁻¹ = ts
  have h_inv : (s * t)⁻¹ = t * s := by
    rw [mul_inv_rev, inv_eq_self_of_sq_eq_one hs, inv_eq_self_of_sq_eq_one ht]
  -- Prove (st)^i * s = s * (ts)^i by induction
  have h_conj : ∀ i : ℕ, (s * t) ^ i * s = s * (t * s) ^ i := by
    intro i
    induction' i with k IH
    · simp
    · rw [pow_succ, mul_assoc, IH, ← mul_assoc, pow_succ']
      -- (st)^k * s * (st) = s * (ts)^k * (st)
      -- Need: s * (ts)^k * (st) = s * (ts)^(k+1)
      -- i.e., (ts)^k * (st) = (ts)^(k+1)
      -- But (ts)^k * (st) = (ts)^k * (ts) * ? No.
      -- Actually, (ts)^k * (st) = (ts)^(k+1) is false.
      -- Let me recompute. The goal is:
      -- (st)^(k+1) * s = s * (ts)^(k+1)
      -- LHS: (st)^k * (st) * s = (st)^k * s * (ts)  (because (st)*s = s*(ts)? Let me check)
      -- (st)*s = s*t*s = s*(ts). Yes!
      -- So (st)^(k+1) * s = (st)^k * (st) * s = (st)^k * s * (ts) = s * (ts)^k * (ts) = s * (ts)^(k+1)
      calc
        (s * t) ^ (k + 1) * s = ((s * t) ^ k * (s * t)) * s := by rw [pow_succ]
        _ = (s * t) ^ k * ((s * t) * s) := by group
        _ = (s * t) ^ k * (s * (t * s)) := by
          -- (st)*s = s*(ts)
          calc
            (s * t) * s = s * (t * s) := by group
        _ = ((s * t) ^ k * s) * (t * s) := by group
        _ = (s * (t * s) ^ k) * (t * s) := by rw [IH]
        _ = s * ((t * s) ^ k * (t * s)) := by group
        _ = s * (t * s) ^ (k + 1) := by rw [pow_succ]
  -- Now compute rightConjugateElem s ((st)^i)
  calc
    rightConjugateElem s ((s * t) ^ i) = ((s * t) ^ i)⁻¹ * s * (s * t) ^ i := rfl
    _ = (t * s) ^ i * s * (s * t) ^ i := by rw [h_inv, inv_pow]
    _ = (t * s) ^ i * (s * (s * t) ^ i) := by
      -- Use h_conj with s and t swapped: (ts)^i * s = s * (st)^i?
      -- Actually, using h_conj with s:=t, t:=s:
      -- (ts)^i * t = t * (st)^i
      -- But we need (ts)^i * s.
      -- Let me derive differently.
      -- From h_conj: (st)^i * s = s * (ts)^i
      -- Swap s↔t: (ts)^i * t = t * (st)^i
      -- But we need (ts)^i * s, not (ts)^i * t.
      -- Actually, the formula is symmetric: (ts)^i * s = s * (st)^i (by the same proof with s↔t)
      -- Let's prove that as a corollary.
      have h_conj' : ∀ i : ℕ, (t * s) ^ i * s = s * (s * t) ^ i := by
        intro i
        -- This is the same as h_conj with s↔t
        calc
          (t * s) ^ i * s = (t * s) ^ i * (s * 1) := by group
          _ = (t * s) ^ i * (s * (t * t)) := by rw [ht, mul_one]
          _ = ((t * s) ^ i * s) * t * t := by group
        -- Hmm, this doesn't work. Let me just use the same induction as h_conj but with s↔t.
        -- Actually, the formula I need is exactly h_conj with s↔t, but the RHS becomes s*(st)^i? No.
        -- Let me just re-prove it.
      sorry
    _ = s * (s * t) ^ (2 * i) := by
      sorry
  -- The above is incomplete. Let me use a different approach.
  -- We can prove this by induction on i.
  induction' i with k IH
  · simp
  · rw [pow_succ, mul_inv_rev, mul_assoc]
    -- Goal: (st)^k⁻¹ * (st)⁻¹ * s * (st)^k * (st) = s * (st)^(2*(k+1))
    sorry

/-- Lemma 3.2(a): For t ∈ Z_{X-M} and s ∈ Z_M ∪ Z_{Mt}, st has odd order. -/
theorem lemma_3_2a (h : MinimalCounterexampleZD Z M Ω α z) (t s : X)
    (ht : t ∈ Z) (ht_not_M : t ∉ M)
    (hs : s ∈ Z ∩ (M : Set X) ∨ (s ∈ Z ∧ ∃ m : X, m ∈ M ∧ s = rightConjugateElem t m)) :
    Odd (orderOf (s * t)) := by
  -- This requires the classification of involutions in a dihedral group.
  sorry

/-- Lemma 3.2(b): Under the same hypotheses, s = t^x for some x ∈ Z_{⟨s,t⟩}. -/
theorem lemma_3_2b (h : MinimalCounterexampleZD Z M Ω α z) (t s : X)
    (ht : t ∈ Z) (ht_not_M : t ∉ M)
    (hs : s ∈ Z ∩ (M : Set X) ∨ (s ∈ Z ∧ ∃ m : X, m ∈ M ∧ s = rightConjugateElem t m)) :
    ∃ (x : X), x ∈ Z ∩ ((Subgroup.closure {s, t}) : Set X) ∧ rightConjugateElem t x = s := by
  sorry

end SubsidiaryTheorems

/-!
### Theorem 1 (Reduction to the Simple Case)

`X` is simple and `M` is strongly `Z`-embedded in `X`. Moreover, `Z` is a
conjugacy class of `2`-central involutions of `X`.

(Source: Section 4, page 42)
-/

/-- Theorem 1.

Under the hypotheses of a minimal counterexample `X` to Theorem ZD:
1. `X` is simple.
2. `M` is strongly `Z`-embedded in `X`.
3. `Z` is a conjugacy class of involutions of `X`. -/
theorem theorem_1 {X : Type u} [Group X] [Finite X]
    (Z : Set X) (M : Subgroup X) (Ω : Type v) [MulAction X Ω] [Finite Ω] (α : Ω) (z : X)
    (h : MinimalCounterexampleZD Z M Ω α z) :
    IsSimpleGroup X ∧ IsStronglyZEmbedded Z M ∧ IsConjugacyClassOf2CentralInvolutions Z := by
  sorry

/-!
### Theorem 2 (p-Subgroups Fixing Two or More Points)

Let `p` be an odd prime. If there exists a `p`-subgroup of `X` with precisely
two fixed points on `Ω`, then `X` is `2`-transitive on `Ω`. Otherwise, if we
choose any `β ∈ Ω` and a `p`-subgroup `P` of `X_β` maximal with respect to the
property of fixing at least `3` points of `Ω`, then `N_X(P)` is transitive on
the set `Ω_P` of fixed points of `P` on `Ω`, and any element of `Ω_P` is fixed
by some involution of `Z` normalizing `P`.

(Source: Section 5, page 42)
-/

/-- Theorem 2. -/
theorem theorem_2 {X : Type u} [Group X] [Finite X]
    (Z : Set X) (M : Subgroup X) (Ω : Type v) [MulAction X Ω] [Finite Ω] (α : Ω) (z : X)
    (h : MinimalCounterexampleZD Z M Ω α z) (p : ℕ) (hp_odd : Odd p) (hp_prime : Nat.Prime p) :
    ((∃ (Q : Subgroup X), IsPGroup p Q ∧
      Nat.card (MulAction.fixedPoints Q Ω : Set Ω) = 2) →
      MulAction.IsMultiplyPretransitive X Ω 2) ∧
    (¬ (∃ (Q : Subgroup X), IsPGroup p Q ∧
      Nat.card (MulAction.fixedPoints Q Ω : Set Ω) = 2) →
      ∀ (β : Ω) (P : Subgroup X),
        IsPGroup p P → P ≤ MulAction.stabilizer X β →
        Nat.card (MulAction.fixedPoints P Ω : Set Ω) ≥ 3 →
        (∀ (Q : Subgroup X), IsPGroup p Q → P ≤ Q →
          Q ≤ MulAction.stabilizer X β →
          Nat.card (MulAction.fixedPoints Q Ω : Set Ω) ≥ 3 → Q = P) →
        (∀ ω₁ ∈ MulAction.fixedPoints P Ω, ∀ ω₂ ∈ MulAction.fixedPoints P Ω,
          ∃ n ∈ Subgroup.normalizer (P : Set X), n • ω₁ = ω₂) ∧
        ∀ ω ∈ MulAction.fixedPoints P Ω, ∃ s ∈ Z,
          IsInvolution s ∧ s ∈ Subgroup.normalizer (P : Set X) ∧ s • ω = ω) := by
  sorry

/-!
### Corollary 3

Suppose that `X` is not `2`-transitive on `Ω`. Then there exists
`t ∈ Z_{X-M}` such that if we set `D = X_{α, α^t}` and choose any `z ∈ Z_M`,
we have

`X = ⟨z, t, [t, O_{2'}(D)]⟩`.

(Source: Section 6, page 42)
-/

/-- Corollary 3. -/
theorem corollary_3 {X : Type u} [Group X] [Finite X]
    (Z : Set X) (M : Subgroup X) (Ω : Type v) [MulAction X Ω] [Finite Ω] (α : Ω) (z : X)
    (h : MinimalCounterexampleZD Z M Ω α z)
    (h_not_2trans : ¬ MulAction.IsMultiplyPretransitive X Ω 2) :
    ∃ (t : X), t ∈ Z ∧ t ∉ M ∧
    let D := M ⊓ rightConjugate M t
    let O2D := (twoPrimeCore D).map (Subgroup.subtype D)
    Subgroup.closure ({z, t} ∪ (↑(⁅Subgroup.closure {t}, O2D⁆) : Set X)) = ⊤ := by
  sorry

/-!
### Theorem 4

The following conditions hold:
(a) `X` is `2`-transitive on `Ω`; and
(b) if `z ∈ Z_M` and `z` normalizes the odd order subgroup `W` of `M`, then
either `[z, W] = 1` or `W` fixes a unique point of `Ω`.

(Source: Section 6--7, page 43)
-/

/-- Theorem 4. -/
theorem theorem_4 {X : Type u} [Group X] [Finite X]
    (Z : Set X) (M : Subgroup X) (Ω : Type v) [MulAction X Ω] [Finite Ω] (α : Ω) (z : X)
    (h : MinimalCounterexampleZD Z M Ω α z) :
    MulAction.IsMultiplyPretransitive X Ω 2 ∧
    (∀ (z' : X) (W : Subgroup X),
      z' ∈ Z → z' ∈ M → Odd (Nat.card ↥W) → W ≤ M →
      (∀ w ∈ W, rightConjugateElem w z' ∈ W) →
      (⁅Subgroup.closure {z'}, W⁆ = ⊥ ∨
        Nat.card (MulAction.fixedPoints W Ω : Set Ω) = 1)) := by
  sorry

/-!
### Corollary 5

The following conditions hold:
(a) `X` permutes `S` transitively; and
(b) if `(γ, δ, s) ∈ S`, then `X_{γ, δ, δ^s} = C_{X_{γ, δ}}(s)`.

Here `S = {(γ, δ, s) | γ ∈ Ω, δ ∈ Ω, s ∈ Z, γ^s = γ ≠ δ}`.

(Source: Section 6, page 43)
-/

/-- Corollary 5. -/
theorem corollary_5 {X : Type u} [Group X] [Finite X]
    (Z : Set X) (M : Subgroup X) (Ω : Type v) [MulAction X Ω] [Finite Ω] (α : Ω) (z : X)
    (h : MinimalCounterexampleZD Z M Ω α z) :
    -- X permutes S transitively: existence of g ∈ X mapping any two elements of S
    (∀ (p q : Ω × Ω × X), p ∈ setS Z Ω → q ∈ setS Z Ω →
      ∃ (g : X), (g • p.1, g • p.2.1, rightConjugateElem p.2.2 g) = q) ∧
    (∀ (γ δ : Ω) (s : X),
      (γ, δ, s) ∈ setS Z Ω →
      MulAction.stabilizer X (γ, δ, s • δ) =
        Subgroup.centralizer ({s} : Set X) ⊓ MulAction.stabilizer X (γ, δ)) := by
  sorry

/-!
### Theorem 6

If `M` is strongly embedded in `X`, then for any `g ∈ X - M`,
`M ∩ M^g` has a nilpotent normal complement in `M`.

(Source: Sections 8--11, page 43)
-/

/-- Theorem 6. -/
theorem theorem_6 {X : Type u} [Group X] [Finite X]
    (Z : Set X) (M : Subgroup X) (Ω : Type v) [MulAction X Ω] [Finite Ω] (α : Ω) (z : X)
    (h : MinimalCounterexampleZD Z M Ω α z)
    (h_se : IsStronglyEmbedded M) (g : X) (hg : g ∉ M) :
    ∃ (N : Subgroup X), N ≤ M ∧ Group.IsNilpotent N ∧ (N.subgroupOf M).Normal ∧
      (M ⊓ rightConjugate M g) ⊓ N = ⊥ ∧
      (M ⊓ rightConjugate M g) ⊔ N = M := by
  sorry

/-!
### Corollary 7

`M` is not strongly embedded in `X`.

This corollary (with Theorem 1) completes the proof of Theorem SE by
contradiction on a minimal counterexample.

(Source: Section 11, page 43)
-/

/-- Corollary 7. -/
theorem corollary_7 {X : Type u} [Group X] [Finite X]
    (Z : Set X) (M : Subgroup X) (Ω : Type v) [MulAction X Ω] [Finite Ω] (α : Ω) (z : X)
    (h : MinimalCounterexampleZD Z M Ω α z) :
    ¬ IsStronglyEmbedded M := by
  sorry

/-!
### Theorem 8

Let `t ∈ Z_{X-M}`, `z ∈ Z_M` and `D = M ∩ M^t`. Then

`X = ⟨z, t, [t, O_{2'}(D)]⟩`.

(Source: Sections 12--15, page 43)
-/

/-- Theorem 8. -/
theorem theorem_8 {X : Type u} [Group X] [Finite X]
    (Z : Set X) (M : Subgroup X) (Ω : Type v) [MulAction X Ω] [Finite Ω] (α : Ω) (z : X)
    (h : MinimalCounterexampleZD Z M Ω α z) (t : X) (ht : t ∈ Z) (ht_not_M : t ∉ M) :
    let D := M ⊓ rightConjugate M t
    let O2D := (twoPrimeCore D).map (Subgroup.subtype D)
    Subgroup.closure ({z, t} ∪ (↑(⁅Subgroup.closure {t}, O2D⁆) : Set X)) = ⊤ := by
  sorry

/-!
### Theorem 9

`M` is strongly embedded in `X`.

Together with Corollary 7, this yields the final contradiction completing the
proof of Theorem ZD (and hence Theorem SE).

(Source: Section 16, page 44)
-/

/-- Theorem 9. -/
theorem theorem_9 {X : Type u} [Group X] [Finite X]
    (Z : Set X) (M : Subgroup X) (Ω : Type v) [MulAction X Ω] [Finite Ω] (α : Ω) (z : X)
    (h : MinimalCounterexampleZD Z M Ω α z) :
    IsStronglyEmbedded M := by
  sorry

end BenderSuzuki
