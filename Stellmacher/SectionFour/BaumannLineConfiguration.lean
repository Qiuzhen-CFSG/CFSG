module
public import Stellmacher.SectionFour.BaumannOriginalAction
public import Stellmacher.SectionFour.PartnerCoreMCore
public import Stellmacher.SectionTwo.BaumannNaturalLineData
public import Stellmacher.SectionTwo.SelectedCoordinateSpanning
public import Stellmacher.SectionTwo.SelectedRawFactorResidualModule
public import Stellmacher.SectionTwo.ResidualModuleOddOrbitCommutator
public import Theory.GroupTheory.SylowImageIntersection

/-!
# The actual natural-line configuration in Stellmacher (4.6)

Keep the critical partner Pstar, the original native Sylow SP mapping to S,
and its original module V. The literal Baumann subgroup B of O_2(C) admits
one finite family of native modules W_j and coordinate subgroups T_j. The
modules generate V and are pairwise disjoint; B is generated by V and the
coordinates, [V,T_j]=[W_j,B] has order two, and each line lies in W_j.
One selected W_i spans V under SP and commutes, in the original ambient
group, with every conjugate by an odd subgroup normalizing B.

The partner-core identification and the vanishing fixed factor establish
the faithful self-centralizing action on the unchanged V. The rich raw
factor family is retained throughout. Its selected coordinate lift gives
K with K SP=Pstar; fixed-free Sylow-three action and the selected-module
normal-closure criterion show that W_i spans V under SP. The exact local
characteristic obstruction and pushing-up theorem identify the selected
module with the actual four-element core-residual commutator of K. The
ambient form of (2.5) then supplies its odd-self commutation. Finally, the
native coordinate-line theorem applies to the restriction of the exact
quotient map on B, whose kernel is V and whose image is the Sylow
intersection with the raw product. No factor or action is replaced.

This packages the original-family data for the automorphism, line-orbit,
and Hall arguments in Stellmacher (4.6), journal p26. Source:
refs/latex/stellmacher-n-group.tex, proof of (4.6).
-/

open scoped Pointwise
namespace Stellmacher.SectionFour
universe u

private theorem native_sylow_of_ambient
    {G : Type*} [Group G] [Finite G]
    (P : Subgroup G) (L : Subgroup P) (B : Subgroup G)
    (hBP : B ≤ P) (h : IsSylowSubgroupIn B (L.map P.subtype)) :
    ∃ T : Sylow 2 L, T.map L.subtype = B.subgroupOf P := by
  obtain ⟨U, hU⟩ := h
  let e : L ≃* L.map P.subtype := L.equivMapOfInjective P.subtype P.subtype_injective
  let T := U.mapSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  refine ⟨T, ?_⟩
  apply Subgroup.map_injective P.subtype_injective
  rw [Subgroup.map_subgroupOf_eq_of_le hBP]
  change (((U : Subgroup (L.map P.subtype)).map e.symm.toMonoidHom).map
    L.subtype).map P.subtype = B
  rw [Subgroup.map_map, Subgroup.map_map]
  have hf : (P.subtype.comp L.subtype).comp e.symm.toMonoidHom = (L.map P.subtype).subtype := by
    ext x
    have he := Subgroup.coe_equivMapOfInjective_apply L P.subtype P.subtype_injective (e.symm x)
    change ((e (e.symm x) : L.map P.subtype) : G) = (((e.symm x : L) : P) : G) at he
    rw [e.apply_symm_apply] at he
    exact he.symm
  rw [hf]
  exact hU

public theorem baumann_line_configuration
    {G : Type u} [Group G] [Finite G]
    (S : Sylow 2 G) (heven : Even (Nat.card G))
    (P Pstar E B : Subgroup G) (hpair : (P, Pstar) ∈ Lambda S)
    (hPC : P ≤ cSubgroup S) (hEP : E ≤ Pstar)
    (hsolv : Group.IsSolvable Pstar) (hchar : IsCharacteristicTwoType Pstar)
    (hE : (E : Set G) = (twoResidualAmbient Pstar : Set G) *
      (twoCoreAmbient (cSubgroup S) : Set G))
    (hSyl : IsSylowSubgroupIn (twoCoreAmbient (cSubgroup S)) E)
    (hB : B = twoCoreAmbient (cSubgroup S) ⊓ Subgroup.centralizer
      (omegaOneCenterAmbient (elementaryAbelianMaxJ (twoCoreAmbient (cSubgroup S))) : Set G))
    (hBS : B ≤ (S : Subgroup G))
    (SP : Sylow 2 Pstar) (hsec : SectionTwo.Hypotheses Pstar)
    (hSPmap : (SP : Subgroup Pstar).map Pstar.subtype = (S : Subgroup G))
    (hV : SectionTwo.vSubgroup SP =
      Subgroup.normalClosure ((zSubgroup S).subgroupOf Pstar : Set Pstar)) :
    let V := SectionTwo.vSubgroup SP
    let BN := B.subgroupOf Pstar
    ∃ (n : ℕ) (W Ti : Fin n → Subgroup Pstar) (i : Fin n),
      (∀ j, W j ≤ BN) ∧ V = ⨆ j, W j ∧ Pairwise (fun j k => Disjoint (W j) (W k)) ∧
      (∀ j, ⁅W j, BN⁆ ≤ W j) ∧
      (∀ j, Ti j ≤ BN) ∧ BN = V ⊔ ⨆ j, Ti j ∧
      (∀ j, ⁅V, Ti j⁆ = ⁅W j, BN⁆ ∧ Nat.card (⁅W j, BN⁆ : Subgroup Pstar) = 2) ∧
      V = ⨆ s : SP, (W i).map (MulAut.conj (s : Pstar)).toMonoidHom ∧
      ∀ U : Subgroup G, Odd (Nat.card U) → U ≤ Subgroup.normalizer (B : Set G) →
        ∀ u : U, ⁅(W i).map Pstar.subtype, ((W i).map Pstar.subtype).conjBy (u : G)⁆ = ⊥ := by
  classical
  let V := SectionTwo.vSubgroup SP
  let BN := B.subgroupOf Pstar
  let L := Subgroup.normalClosure (BN : Set Pstar)
  let C := SectionTwo.cSubgroup SP
  let _ : V.Normal := Subgroup.normalClosure_normal
  let _ : L.Normal := Subgroup.normalClosure_normal
  let _ : C.Normal := by
    change (Subgroup.centralizer (V : Set Pstar)).Normal
    infer_instance
  let _ : IsElementaryAbelian 2 V := (SectionTwo.vSubgroup_le_twoCore_and_elementaryAbelian hsec SP).2
  let _ : Group.IsSolvable Pstar := hsolv
  let q := QuotientGroup.mk' C
  have hq := QuotientGroup.mk'_surjective C
  have hker : q.ker = SectionTwo.cSubgroup SP := QuotientGroup.ker_mk' C
  let _ := SectionTwo.quotientConjugationAction SP q hq hker
  let N := E.subgroupOf Pstar
  let barN := N.map q
  let L0 := (L.map q).subgroupOf barN
  have hSPstar : (S : Subgroup G) ≤ Pstar := hSPmap ▸ Subgroup.map_subtype_le _
  have hBP : B ≤ Pstar := hBS.trans hSPstar
  have hBNmap : BN.map Pstar.subtype = B := Subgroup.map_subgroupOf_eq_of_le hBP
  have hBNS : BN ≤ (SP : Subgroup Pstar) := by
    apply (Subgroup.map_le_map_iff_of_injective Pstar.subtype_injective).mp
    rw [hBNmap, hSPmap]
    exact hBS
  have hVB : V ≤ BN := by
    apply (Subgroup.map_le_map_iff_of_injective Pstar.subtype_injective).mp
    rw [hBNmap, hB]
    change (SectionTwo.vSubgroup SP).map Pstar.subtype ≤ _
    rw [hV]
    exact original_v_le_baumann S heven P Pstar E hpair hPC hEP hsolv hchar hE hSyl
  have hQ : pCore 2 Pstar = V := by
    rw [partner_core_eq_v S heven P Pstar E hpair hPC hEP hsolv hchar hE hSyl]
    exact hV.symm
  have hcentral : Subgroup.centralizer (V : Set Pstar) ≤ V := by
    rw [← hQ]
    exact hchar
  obtain ⟨PL, hPL⟩ := native_sylow_of_ambient Pstar L B hBP (by
    change IsSylowSubgroupIn B
      ((Subgroup.normalClosure (B.subgroupOf Pstar : Set Pstar)).map Pstar.subtype)
    rw [hB]
    exact baumann_isSylow_normalClosure S heven P Pstar E hpair hPC hEP hsolv hchar hE hSyl)
  have hgen : L ⊔ (SP : Subgroup Pstar) = ⊤ := by
    apply Subgroup.map_injective Pstar.subtype_injective
    rw [Subgroup.map_sup, hSPmap, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    rw [show L = Subgroup.normalClosure (B.subgroupOf Pstar : Set Pstar) from rfl, hB]
    exact baumann_closure_sup_sylow S heven P Pstar E hpair hPC hEP hsolv hchar hE hSyl
  have hunique : IsUniqueMaximalContaining (SP : Subgroup Pstar) (⊤ : Subgroup Pstar) := by
    apply native_uniqueMaximalContaining
    rw [hSPmap]
    exact hpair.2.1.2
  have hfixed : V ⊓ Subgroup.centralizer (L : Set Pstar) = ⊥ := by
    change SectionTwo.vSubgroup SP ⊓ Subgroup.centralizer
      (Subgroup.normalClosure (B.subgroupOf Pstar : Set Pstar) : Set Pstar) = ⊥
    rw [hV, hB]
    exact baumann_fixed_factor_eq_bot S heven P Pstar E hpair hPC hEP hsolv hchar hE hSyl
  have hdata := baumann_original_action_data S heven P Pstar E hpair hPC hEP
    hsolv hchar hE hSyl SP hsec hSPmap hV q hq hker
  rw [← hB] at hdata
  change SectionTwo.BaumannFactorActionData V L q barN at hdata
  obtain ⟨n, D, hLmap, hprod, _hDin, hD, hDn, hmodule, hWdata, hWprod⟩ := hdata.factors
  change IsInternalDirectProductFamily L0 D at hprod
  let W (j : Fin n) : Subgroup Pstar := (commutatorAction (D j) V).map V.subtype
  let Dbar (j : Fin n) : Subgroup (Pstar ⧸ C) := (D j).map barN.subtype
  have hWle (j : Fin n) : W j ≤ V := Subgroup.map_subtype_le _
  have hWV : V = ⨆ j, W j := by
    have hh := hWprod.1
    change V = ⨆ j : Option (Fin n), match j with
      | none => V ⊓ Subgroup.centralizer (L : Set Pstar)
      | some j => W j at hh
    simpa only [iSup_option, hfixed, bot_sup_eq] using hh
  have hWdisj : Pairwise fun j k => Disjoint (W j) (W k) := by
    intro j k hjk
    exact hWprod.2.1 (some j) (some k) (by simpa using hjk)
  have hdisj : Pairwise fun j k => Disjoint (commutatorAction (D j) V) (commutatorAction (D k) V) := by
    intro j k hjk
    exact hmodule.2.1 (some j) (some k) (by simpa using hjk)
  have hDbarprod : IsInternalDirectProductFamily (L.map q) Dbar := by
    have hh := hprod.map_injective barN.subtype barN.subtype_injective
    rwa [hLmap] at hh
  have hDbarSL (j : Fin n) : IsSL2Two (Dbar j) := by
    obtain ⟨e⟩ := (hD j).1
    exact ⟨(Subgroup.equivMapOfInjective (D j) barN.subtype barN.subtype_injective).symm.trans e⟩
  have hBne : BN.map q ≠ ⊥ := by
    intro hb
    have hBC : BN ≤ C := by
      have hh := (Subgroup.map_eq_bot_iff BN).mp hb
      simpa only [q, QuotientGroup.ker_mk'] using hh
    have hBV : BN = V := le_antisymm (hBC.trans hcentral) hVB
    have hn : BN.Normal := by rw [hBV]; infer_instance
    have hbad : Pstar ≤ Subgroup.normalizer (B : Set G) :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hBP).mp hn
    rw [hB] at hbad
    exact baumann_not_normalized_by_partner S heven P Pstar hpair hPC hbad
  have hWnorm (j : Fin n) : L ≤ Subgroup.normalizer (W j : Set Pstar) := by
    have hDj : D j ≤ L0 := by rw [hprod.1]; exact le_iSup D j
    have hnorm : L0 ≤ Subgroup.normalizer (D j : Set barN) :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hDj).mp (hDn j)
    have hinv := commutatorAction_isInvariant_of_normalizing_actor (V := V) L0 (D j) hnorm
    apply Subgroup.le_normalizer_iff.mpr
    intro l hl w hw
    obtain ⟨v, hv, rfl⟩ := hw
    have hql : q l ∈ L.map q := Subgroup.mem_map_of_mem q hl
    have hLbarN : L.map q ≤ barN := by rw [← hLmap]; exact Subgroup.map_subtype_le _
    let a : L0 := ⟨⟨q l, hLbarN hql⟩, hql⟩
    have hmem := (hinv.invariant a v).mp hv
    refine ⟨a • v, hmem, ?_⟩
    exact SectionTwo.quotientConjugationAction_smul_coe SP q hq hker l v
  let T3 : Sylow 3 Pstar := Classical.choice Sylow.nonempty
  have hfixed3 : V ⊓ Subgroup.centralizer (T3 : Set Pstar) = ⊥ := by
    change SectionTwo.vSubgroup SP ⊓ Subgroup.centralizer (T3 : Set Pstar) = ⊥
    rw [hV]
    exact partner_sylow_three_fixed_factor_eq_bot S heven P Pstar E
      hpair hPC hEP hsolv hchar hE hSyl T3
  have hcop : Nat.Coprime (Nat.card T3) (Nat.card V) := by
    obtain ⟨a, ha⟩ := T3.isPGroup'.exists_card_eq
    obtain ⟨b, hb⟩ := (IsElementaryAbelian.isPGroup 2 V).exists_card_eq
    rw [ha, hb]
    exact (show Nat.Coprime 3 2 by decide).pow a b
  have hcomm : V ≤ ⁅V, (⊤ : Subgroup Pstar)⁆ := by
    have hh := Subgroup.eq_commutator_sup_centralizer_of_solvable_coprime V
      (T3 : Subgroup Pstar) Subgroup.le_normalizer_of_normal inferInstance hcop
    change V = ⁅V, (T3 : Subgroup Pstar)⁆ ⊔
      (V ⊓ Subgroup.centralizer (T3 : Set Pstar)) at hh
    rw [hfixed3, sup_bot_eq] at hh
    exact hh.le.trans (Subgroup.commutator_mono le_rfl le_top)
  have hZS : SectionTwo.zSubgroup SP ≤ Subgroup.centralizer (SP : Set Pstar) := by
    intro z hz
    change z ∈ omegaOneCenterAmbient (SP : Subgroup Pstar) at hz
    exact Subgroup.mem_centralizer_iff.mpr fun s hs =>
      ((mem_omegaOneCenterAmbient_iff _ z).mp hz).2.2 s hs
  obtain ⟨K, PK, i, hBK, hKL, hPK, hKA, hKS, hKimage, hspan⟩ :=
    SectionTwo.exists_generating_coordinate_with_spanning hsolv SP
      (SectionTwo.zSubgroup SP) V BN L PL hPL hgen hunique q hq hBne
      (Sylow.map_image_eq_inf SP L BN PL hPL hBNS q) Dbar W hDbarprod hDbarSL
      (fun j => (hWdata j).1) hWle hWnorm Subgroup.le_normalClosure rfl hZS hcomm
  have hPKne : (PK : Subgroup K) ≠ ⊥ := by
    intro hk
    apply hBne
    rw [← hPK, hk, Subgroup.map_bot, Subgroup.map_bot]
  have hevenK : Even (Nat.card K) := by
    have hdvd : 2 ∣ Nat.card PK := PK.isPGroup'.card_eq_or_dvd.resolve_left
      (fun hc => hPKne (Subgroup.card_eq_one.mp hc))
    exact even_iff_two_dvd.mpr (hdvd.trans (Subgroup.card_subgroup_dvd_card (PK : Subgroup K)))
  have hsecK : SectionTwo.Hypotheses K :=
    ⟨inferInstance, hevenK, characteristicTwo_of_contains_core hchar K
      (hQ ▸ hVB.trans hBK)⟩
  have hP : ∀ A : Subgroup PK, A.Characteristic → A ≠ ⊥ →
      ¬ (A.map (PK : Subgroup K).subtype).Normal :=
    baumann_factor_characteristic_obstruction S heven P Pstar E hpair hPC hEP hsolv hchar hE hSyl
      K PK SP hSPmap (by rw [← hB]; exact hPK) hKS
  have hcardK := (PushingUp.sl2Two_coreResidual_card_four hsecK PK hP hKA).2.1
  let RK := ⁅pCore 2 K, twoResidualAmbient (⊤ : Subgroup K)⁆
  have hRKmap : RK.map K.subtype = ⁅twoCoreAmbient K, twoResidualAmbient K⁆ := by
    rw [show RK = ⁅pCore 2 K, twoResidualAmbient (⊤ : Subgroup K)⁆ from rfl,
      Subgroup.map_commutator]
    rw [map_twoResidualAmbient_of_subgroup_image ⊤ K.subtype K
      ((MonoidHom.range_eq_map K.subtype).symm.trans (Subgroup.range_subtype K))]
    rfl
  have hcardKA : Nat.card (⁅twoCoreAmbient K, twoResidualAmbient K⁆ : Subgroup Pstar) = 4 := by
    rw [← hRKmap, Subgroup.card_map_of_injective K.subtype_injective]
    exact hcardK
  have hDK : (D i).map barN.subtype ≤ K.map q := by rw [hKimage]; exact le_sup_left
  have hWKeq : RK.map K.subtype = W i := hRKmap.trans
    (SectionTwo.selected_raw_factor_residual_module hsec SP q hq hker K
      (hVB.trans hBK) barN (D i) hDK hcardKA (hD i))
  have hodd : ∀ U : Subgroup G, Odd (Nat.card U) → U ≤ Subgroup.normalizer (B : Set G) →
      ∀ u : U, ⁅(W i).map Pstar.subtype, ((W i).map Pstar.subtype).conjBy (u : G)⁆ = ⊥ := by
    intro U hU hUB u
    let f : K →* G := Pstar.subtype.comp K.subtype
    have hf : Function.Injective f := Pstar.subtype_injective.comp K.subtype_injective
    have hPKf : (PK : Subgroup K).map f = B := by
      rw [← Subgroup.map_map, hPK, hBNmap]
    have hh := SectionTwo.local_residual_odd_conjugate_commutator_eq_bot hsecK PK hP hKA
      f hf U hU (hPKf ▸ hUB) u
    change ⁅RK.map f, (RK.map f).conjBy (u : G)⁆ = ⊥ at hh
    have hWf : RK.map f = (W i).map Pstar.subtype := by
      rw [← Subgroup.map_map, hWKeq]
    rwa [hWf] at hh
  have hNnormal : N.Normal := (baumann_normal_supplement_data S heven P Pstar E
    hpair hPC hEP hsolv hchar hE hSyl).1
  let _ : N.Normal := hNnormal
  let _ : barN.Normal := Subgroup.Normal.map hNnormal q hq
  have hLnormal : (L.map q).Normal := Subgroup.Normal.map inferInstance q hq
  let _ : (L.map q).Normal := hLnormal
  have hL0normal : L0.Normal := Subgroup.Normal.subgroupOf hLnormal barN
  let Tq := SP.mapSurjective hq
  obtain ⟨T, hT⟩ := Tq.exists_subgroupOf_eq_of_normal barN
  have hLbarN : L.map q ≤ barN := by rw [← hLmap]; exact Subgroup.map_subtype_le _
  have hBNL : BN ≤ L := Subgroup.le_normalClosure
  have hBbarN : BN.map q ≤ barN := (Subgroup.map_mono hBNL).trans hLbarN
  let f : BN →* barN := (q.comp BN.subtype).codRestrict barN
    (fun b => hBbarN (Subgroup.mem_map_of_mem q b.property))
  have hfcomp : barN.subtype.comp f = q.comp BN.subtype := rfl
  have hfrangemap : f.range.map barN.subtype = BN.map q := by
    rw [← MonoidHom.range_comp, hfcomp, MonoidHom.range_comp, Subgroup.range_subtype]
  have hTmap : (T : Subgroup barN).map barN.subtype = (Tq : Subgroup (Pstar ⧸ C)) ⊓ barN := by
    rw [hT]
    exact Subgroup.subgroupOf_map_subtype _ _
  have hfrange : f.range = (T : Subgroup barN) ⊓ L0 := by
    apply Subgroup.map_injective barN.subtype_injective
    rw [hfrangemap, Subgroup.map_inf _ _ _ barN.subtype_injective, hTmap]
    change BN.map q = ((Tq : Subgroup (Pstar ⧸ C)) ⊓ barN) ⊓
      ((L.map q).subgroupOf barN).map barN.subtype
    rw [hLmap]
    have hBinf := Sylow.map_image_eq_inf SP L BN PL hPL hBNS q
    change BN.map q = (Tq : Subgroup (Pstar ⧸ C)) ⊓ L.map q at hBinf
    rw [hBinf]
    rw [inf_assoc, inf_eq_right.mpr hLbarN]
  have hVC : V ≤ C := by
    change V ≤ Subgroup.centralizer (V : Set Pstar)
    exact Subgroup.le_centralizer_iff_isMulCommutative.mpr inferInstance
  have hfker : f.ker = V.subgroupOf BN := by
    ext b
    change f b = 1 ↔ (b : Pstar) ∈ V
    have heq : f b = 1 ↔ q (b : Pstar) = 1 := by
      exact ⟨fun he => congrArg Subtype.val he, fun he => Subtype.ext he⟩
    rw [heq]
    change (b : Pstar) ∈ q.ker ↔ (b : Pstar) ∈ V
    rw [hker]
    exact ⟨fun hb => hcentral hb, fun hb => hVC hb⟩
  have hact : ∀ b : BN, ∀ v : V,
      ((f b • v : V) : Pstar) = b * (v : Pstar) * (b : Pstar)⁻¹ := by
    intro b v
    exact SectionTwo.quotientConjugationAction_smul_coe SP q hq hker b v
  obtain ⟨Ti, hTi, hTiGen, hlines⟩ := SectionTwo.baumann_natural_line_data
    BN V hVB f hfker T L0 hL0normal hfrange hact D hprod hD hdata.faithful hdisj
  exact ⟨n, W, Ti, i, fun j => (hWle j).trans hVB,
    hWV, hWdisj, fun j => Subgroup.le_normalizer_iff_commutator_le_left.mp
      (hBNL.trans (hWnorm j)), hTi, hTiGen, hlines, hspan, hodd⟩

end Stellmacher.SectionFour
