module
public import Stellmacher.SectionFiveToSeven.Result7_8.GeometricExtraction
public import Theory.Frattini.PGroup
/-!
# The neighboring-core configuration for an elementary actor

Under the genuine Section Seven hypotheses, an elementary abelian actor
A in the neighboring core and outside the current core gives a transported
neighbor m. The join A with Q_m contains its conjugator and generates the
current stabilizer with the full new edge. Its geometric actor intersection
A intersect G_m has index two in A.

The elementary hypothesis makes the Frattini subgroup trivial. Apply (7.8)
with a prescribed outside actor and then its proved geometric extraction:
this identifies the extracted actor coatom with A intersect G_m. The
extracted group is generated by A and its conjugate inside Q_m, hence lies
in the claimed join. Enlarging the extracted group preserves full-edge
generation and retains the same conjugator and coatom cardinality.

This is the elementary branch of (8.4)(6), printed p.39 of Stellmacher,
Journal of Algebra 190 (1997), `refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionsFiveToSeven
open CosetGraphContext SevenSix
public theorem sevenEight_elementary_geometric_configuration
    {G : Type*} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2)
    (Γ : CosetGraphContext G S P1 P2)
    (d l : Γ.Vertex) (hl : l ∈ neighborhood Γ d)
    (A : Subgroup G) (hA : A ≤ q Γ l)
    (hAnot : ¬ A ≤ q Γ d) (hElem : IsElementaryAbelian 2 A) :
    ∃ y : G, y ∈ A ⊔ q Γ (Γ.act y⁻¹ l) ∧
      A ⊔ q Γ (Γ.act y⁻¹ l) ≤ stabilizer Γ d ∧
      Γ.act y⁻¹ l ∈ neighborhood Γ d ∧
      (A ⊔ q Γ (Γ.act y⁻¹ l)) ⊔
        (stabilizer Γ d ⊓ stabilizer Γ (Γ.act y⁻¹ l)) = stabilizer Γ d ∧
      Nat.card A = 2 * Nat.card ↥(A ⊓ stabilizer Γ (Γ.act y⁻¹ l)) := by
  classical
  let := hElem
  let : Fact (IsPGroup 2 A) := ⟨IsElementaryAbelian.isPGroup 2 A⟩
  have hPhi : frattiniAmbient A ≤ q Γ d := by
    rw [frattiniAmbient, frattini_eq_bot_of_isElementaryAbelian (p := 2), Subgroup.map_bot]
    exact bot_le
  obtain ⟨actor, haA, haCore⟩ := SetLike.not_le_iff_exists.mp hAnot
  obtain ⟨y,A0,E,hEP,hyP,h0A,hgen,hcard,hyE,hysq,h0core,hedge,hmodel,horbit,hby,hres,ha0⟩ :=
    sevenEight_quotient_configuration_with_actor h Γ d l hl A hA hAnot hPhi actor haA haCore
  obtain ⟨data⟩ := SectionNine.nine_three_geometric_extraction h Γ d l hl
    A E A0 hA hPhi actor haA ha0 y hyE hEP hgen h0A hcard h0core hedge hmodel hby
  have hQmP : q Γ (Γ.act data.x⁻¹ l) ≤ stabilizer Γ d :=
    ((lemma_seven_three h Γ).sylow_and_core _ d
      ((mem_neighborhood_iff_adjacent Γ).mpr
        (Γ.adjacent_symm ((mem_neighborhood_iff_adjacent Γ).mp data.neighbor))) default).2.2
  have hAP : A ≤ stabilizer Γ d := hA.trans
    (((lemma_seven_three h Γ).sylow_and_core l d
      ((mem_neighborhood_iff_adjacent Γ).mpr
        (Γ.adjacent_symm ((mem_neighborhood_iff_adjacent Γ).mp hl))) default).2.2)
  have hEL : E ≤ A ⊔ q Γ (Γ.act data.x⁻¹ l) := by
    exact data.generated.le.trans (sup_le le_sup_left (data.conjugate_core_le.trans le_sup_right))
  refine ⟨data.x, hEL (Subgroup.map_subtype_le _ data.residual_mem),
    sup_le hAP hQmP, data.neighbor, ?_, ?_⟩
  · apply le_antisymm (sup_le (sup_le hAP hQmP) inf_le_left)
    exact data.edge_generated.ge.trans (sup_le_sup_right hEL _)
  · rw [← data.coatom_eq]
    exact data.coatom_card
end Stellmacher.SectionsFiveToSeven
