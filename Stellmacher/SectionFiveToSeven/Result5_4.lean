module

public import Stellmacher.SectionFiveToSeven.Defs
public import Stellmacher.ElementaryAbelianMaxOrder
public import Stellmacher.ElementaryAbelianMaxJ
public import Stellmacher.SectionThree.PairCoreNormalizer
public import Theory.ElementaryAbelian.Join
public import Theory.GroupTheory.PGroup.CharacteristicTwoNormalClosure
public import Theory.GroupTheory.PGroup.NormalSubgroups

/-!
# Stellmacher (5.4): the central involutions lie in the amalgam core

Let `H₀=⟨F₁,F₂⟩`, with `T` Sylow in both generators and containing the
Baumann subgroup of `S`.  The common-core normalizer theorem puts `H₀` in
`N=N_H(T∩O₂(H₀))`.  Sylow extension and the two stability consequences of
(5.1)(c) identify `J(S)` with the elementary Thompson subgroup of Sylow
2-subgroups of both `H₀` and `N`.  A nontrivial normal subgroup of a finite
2-group meets its center, proving `T∩O₂(H₀)≠1` and hence that `N` is 2-local.

The common argument applies to any elementary subgroup `Z ≤ J(S)`
centralized by `T`; the original theorem takes `Z=Ω₁(Z(S))`. Normalizer control gives
`[O₂(N),Z]≤T∩O₂(H₀)` while `Z` centralizes that intersection.  The abstract
normal-closure theorem then follows the journal's corrected endpoint: the
three-subgroups lemma forces the derived subgroup of `⟨Z^N⟩` into `O₂(N)`,
its abelianization is a 2-group generated by involutions, and characteristic
two places the full normal closure in `O₂(N)`.  Intersecting with `H₀` finishes
the proof. The public general form also applies to the central involutions
of `T`, as proved in `FiveFourSharedOmega`, for the applications of (3.9)
in (6.1) and (6.3). The public join-Sylow Thompson transport records the
same `J(S)=J(U)` equality under either branch of the stated alternative,
so those applications retain the chosen join Sylow without assuming `S=S₀`.
The global-Sylow generalization `omegaOneCenter_le_core_of_globalSylow`
requires only B(S) containment, a nontrivial core, and normalization of
S intersect O₂(L). It repeats the same normalizer argument without the
local-family assumptions used to obtain that normalization, as needed for
the repeated transfer in (6.4).

Source: `refs/latex/stellmacher-n-group.tex`, (5.4), and the journal scan,
p. 30.  The journal has `[O²(W),O₂(N)]=1`; the LaTeX transcription's
`[O₂(W),O₂(N)]=1` is a superscript/subscript error.
-/

open scoped Pointwise

namespace Stellmacher.SectionsFiveToSeven

universe u

variable {H : Type u} [Group H] [Finite H]

omit [Finite H] in
private theorem twoCoreIn_normal_subgroupOf (P : Subgroup H) :
    ((twoCoreIn P).subgroupOf P).Normal := by
  rw [← Subgroup.comap_subtype, twoCoreIn,
    Subgroup.comap_map_eq_self_of_injective P.subtype_injective]
  exact (inferInstance : (pCore 2 P).Normal)

omit [Finite H] in
private theorem twoCoreIn_isPGroup (P : Subgroup H) :
    IsPGroup 2 (twoCoreIn P) :=
  (pCore_isPGroup (p := 2) (G := P)).map P.subtype

omit [Finite H] in
private theorem normal_pSubgroup_le_twoCoreIn
    (Q P : Subgroup H) (hQP : Q ≤ P)
    (hQp : IsPGroup 2 Q) (hQnormal : (Q.subgroupOf P).Normal) :
    Q ≤ twoCoreIn P := by
  have hQpP : IsPGroup 2 (Q.subgroupOf P) :=
    hQp.of_equiv (Subgroup.subgroupOfEquivOfLe hQP).symm
  have hle : Q.subgroupOf P ≤ pCore 2 P := le_sSup ⟨hQnormal, hQpP⟩
  calc
    Q = (Q.subgroupOf P).map P.subtype :=
      (Subgroup.map_subgroupOf_eq_of_le hQP).symm
    _ ≤ (pCore 2 P).map P.subtype := Subgroup.map_mono hle
    _ = twoCoreIn P := rfl

omit [Finite H] in
private theorem isPGroup_of_isSylowTwoIn
    (S P : Subgroup H) (hSP : IsSylowTwoIn S P) : IsPGroup 2 S := by
  obtain ⟨_, R, rfl⟩ := hSP
  exact R.isPGroup'.map P.subtype

omit [Finite H] in
private theorem exists_isSylowTwoIn_of_le
    (T P : Subgroup H) (hTP : T ≤ P) (hTp : IsPGroup 2 T) :
    ∃ U : Subgroup H, T ≤ U ∧ IsSylowTwoIn U P := by
  let TP : Subgroup P := T.subgroupOf P
  have hTPp : IsPGroup 2 TP :=
    hTp.of_equiv (Subgroup.subgroupOfEquivOfLe hTP).symm
  obtain ⟨U, hTPU⟩ := hTPp.exists_le_sylow
  let Uamb : Subgroup H := (U : Subgroup P).map P.subtype
  refine ⟨Uamb, ?_, Subgroup.map_subtype_le _, U, rfl⟩
  calc
    T = TP.map P.subtype := (Subgroup.map_subgroupOf_eq_of_le hTP).symm
    _ ≤ (U : Subgroup P).map P.subtype := Subgroup.map_mono hTPU
    _ = Uamb := rfl

private theorem omegaOneCenter_inf_normal_ne_bot
    (P Q : Subgroup H) (hQP : Q ≤ P) (hPp : IsPGroup 2 P)
    (hQnormal : (Q.subgroupOf P).Normal) (hQne : Q ≠ ⊥) :
    omegaOneCenter P ⊓ Q ≠ ⊥ := by
  let QP : Subgroup P := Q.subgroupOf P
  have hQPne : QP ≠ ⊥ := by
    intro hbot
    apply hQne
    calc
      Q = QP.map P.subtype :=
        (Subgroup.map_subgroupOf_eq_of_le hQP).symm
      _ = ⊥ := by rw [hbot]; simp
  let _ : QP.Normal := hQnormal
  let _ : Nontrivial QP := (Subgroup.nontrivial_iff_ne_bot QP).2 hQPne
  let _ : Fact (IsPGroup 2 P) := ⟨hPp⟩
  obtain ⟨x, hxne, hxcenter⟩ :=
    exists_nontrivial_center_mem_normal (G := P) (p := 2) QP
  let I : Subgroup (Subgroup.center P) :=
    QP.comap (Subgroup.center P).subtype
  have hIne : I ≠ ⊥ := by
    intro hbot
    let xc : Subgroup.center P := ⟨(x : P), hxcenter⟩
    have hxcI : xc ∈ I := x.property
    have hxone : xc = 1 := Subgroup.mem_bot.mp (hbot ▸ hxcI)
    have hxP : (x : P) = (1 : P) := by
      simpa [xc] using congrArg Subtype.val hxone
    exact hxne (Subtype.ext hxP)
  let _ : Nontrivial I := (Subgroup.nontrivial_iff_ne_bot I).2 hIne
  have hcenterp : IsPGroup 2 (Subgroup.center P) :=
    hPp.to_subgroup (Subgroup.center P)
  have hIp : IsPGroup 2 I := hcenterp.to_subgroup I
  obtain ⟨n, hn, hcardI⟩ := hIp.nontrivial_iff_card.mp inferInstance
  have htwoDvd : 2 ∣ Nat.card I := by
    rw [hcardI]
    exact dvd_pow_self 2 (Nat.pos_iff_ne_zero.mp hn)
  let OI : Subgroup (Subgroup.center P) :=
    (omega₁ (G := I) (p := 2)).map I.subtype
  have hOIne : OI ≠ ⊥ := by
    simpa [OI] using omega₁_map_subtype_ne_bot I 2 htwoDvd
  let _ : IsElementaryAbelian 2 (omega₁ (G := I) (p := 2)) :=
    IsElementaryAbelian.omega₁_of_isMulCommutative I
  let _ : IsElementaryAbelian 2 OI := IsElementaryAbelian.map_subtype
  have hOIomega : OI ≤ omega₁ (G := Subgroup.center P) (p := 2) :=
    elementaryAbelian_le_omega₁
  have hOIQP : OI.map (Subgroup.center P).subtype ≤ QP := by
    rw [Subgroup.map_le_iff_le_comap]
    change OI ≤ I
    exact Subgroup.map_subtype_le _
  let A : Subgroup H :=
    (OI.map (Subgroup.center P).subtype).map P.subtype
  have hAne : A ≠ ⊥ := by
    intro hbot
    apply hOIne
    have hinner : OI.map (Subgroup.center P).subtype = ⊥ := by
      exact (Subgroup.map_eq_bot_iff_of_injective
        (OI.map (Subgroup.center P).subtype) P.subtype_injective).mp hbot
    exact (Subgroup.map_eq_bot_iff_of_injective OI
      (Subgroup.center P).subtype_injective).mp hinner
  have hAZ : A ≤ omegaOneCenter P := by
    unfold omegaOneCenter
    exact Subgroup.map_mono (Subgroup.map_mono hOIomega)
  have hAQ : A ≤ Q := by
    calc
      A ≤ QP.map P.subtype := Subgroup.map_mono hOIQP
      _ = Q := Subgroup.map_subgroupOf_eq_of_le hQP
  exact fun hbot => hAne (le_bot_iff.mp ((le_inf hAZ hAQ).trans_eq hbot))

omit [Finite H] in
private theorem le_normalizer_twoCoreIn (P : Subgroup H) :
    P ≤ Subgroup.normalizer (twoCoreIn P : Set H) := by
  exact (Subgroup.normal_subgroupOf_iff_le_normalizer
    (Subgroup.map_subtype_le (pCore 2 P))).mp
      (twoCoreIn_normal_subgroupOf P)

omit [Finite H] in
private theorem omegaOneCenter_le (P : Subgroup H) :
    omegaOneCenter P ≤ P := by
  unfold omegaOneCenter
  exact (Subgroup.map_mono (Subgroup.map_subtype_le _)).trans
    (Subgroup.map_subtype_le _)

omit [Finite H] in
private theorem omegaOneCenter_le_centerAmbient (P : Subgroup H) :
    omegaOneCenter P ≤ (Subgroup.center P).map P.subtype := by
  unfold omegaOneCenter
  exact Subgroup.map_mono (Subgroup.map_subtype_le _)

omit [Finite H] in
private theorem omegaOneCenter_isElementaryAbelian (P : Subgroup H) :
    IsElementaryAbelian 2 (omegaOneCenter P) := by
  unfold omegaOneCenter
  exact ((IsElementaryAbelian.omega₁_of_isMulCommutative
    (p := 2) (Subgroup.center P)).map
      (Subgroup.center P).subtype).map P.subtype

omit [Finite H] in
private theorem elementaryAbelianMaxJ_le (P : Subgroup H) :
    elementaryAbelianMaxJ P ≤ P := by
  exact sSup_le fun _ hA => hA.1

omit [Finite H] in
private theorem normalizer_le_normalizer_J (P : Subgroup H) :
    Subgroup.normalizer (P : Set H) ≤
      Subgroup.normalizer (elementaryAbelianMaxJ P : Set H) := by
  intro x hx
  rw [Subgroup.mem_normalizer_iff_map_conj_eq]
  have hP := Subgroup.mem_normalizer_iff_map_conj_eq.mp hx
  have hJ := elementaryAbelianMaxJ_map_equiv (MulAut.conj x) P
  change P.map (MulAut.conj x).toMonoidHom = P at hP
  rw [hP] at hJ
  exact hJ.symm

private theorem omegaOneCenter_le_elementaryAbelianMaxJ (P : Subgroup H) :
    omegaOneCenter P ≤ elementaryAbelianMaxJ P := by
  let A : Subgroup H :=
    Classical.choose (elementaryAbelianMaxSubgroups_nonempty P)
  have hA : A ∈ elementaryAbelianMaxSubgroups P :=
    Classical.choose_spec (elementaryAbelianMaxSubgroups_nonempty P)
  have hZcentralA : omegaOneCenter P ≤ Subgroup.centralizer (A : Set H) := by
    intro z hz
    rw [Subgroup.mem_centralizer_iff]
    intro a ha
    obtain ⟨zc, hzcenter, hzeq⟩ := omegaOneCenter_le_centerAmbient P hz
    have hcomm := Subgroup.mem_center_iff.mp hzcenter ⟨a, hA.1 ha⟩
    change a * z = z * a
    rw [← hzeq]
    exact congrArg Subtype.val hcomm
  let _ : IsElementaryAbelian 2 A := hA.2.1
  let _ : IsElementaryAbelian 2 (omegaOneCenter P) :=
    omegaOneCenter_isElementaryAbelian P
  have hsupElem : IsElementaryAbelian 2 ↑(A ⊔ omegaOneCenter P : Subgroup H) :=
    IsElementaryAbelian.sup_of_le_centralizer hZcentralA
  have hsupLeP : A ⊔ omegaOneCenter P ≤ P :=
    sup_le hA.1 (omegaOneCenter_le P)
  have hcard : Nat.card ↑(A ⊔ omegaOneCenter P : Subgroup H) ≤ Nat.card A :=
    hA.2.2 (A ⊔ omegaOneCenter P) hsupLeP hsupElem
  have heq : A = A ⊔ omegaOneCenter P :=
    Subgroup.eq_of_le_of_card_ge le_sup_left hcard
  exact (show omegaOneCenter P ≤ A by rw [heq]; exact le_sup_right).trans
    (le_sSup hA)

omit [Finite H] in
private theorem subgroup_le_centralizer_omegaOneCenter (P : Subgroup H) :
    P ≤ Subgroup.centralizer (omegaOneCenter P : Set H) := by
  intro p hp
  rw [Subgroup.mem_centralizer_iff]
  intro z hz
  obtain ⟨zc, hzcenter, hzeq⟩ := omegaOneCenter_le_centerAmbient P hz
  have hcomm := Subgroup.mem_center_iff.mp hzcenter ⟨p, hp⟩
  change z * p = p * z
  rw [← hzeq]
  exact (congrArg Subtype.val hcomm).symm

omit [Finite H] in
private theorem elementaryAbelianMaxJ_le_baumannIn (P : Subgroup H) :
    elementaryAbelianMaxJ P ≤ baumannIn P := by
  refine le_inf (elementaryAbelianMaxJ_le P) ?_
  exact subgroup_le_centralizer_omegaOneCenter (elementaryAbelianMaxJ P)

private theorem elementaryAbelianMaxJ_eq_of_globalSylow
    (S0 : Sylow 2 H) (S T U : Subgroup H)
    (hS : S = (S0 : Subgroup H))
    (hJT : elementaryAbelianMaxJ S ≤ T)
    (hTU : T ≤ U) (hUp : IsPGroup 2 U) :
    elementaryAbelianMaxJ S = elementaryAbelianMaxJ U := by
  obtain ⟨R, hUR⟩ := hUp.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq H S0 R
  have hRmap : (R : Subgroup H) =
      (S0 : Subgroup H).map (MulAut.conj g).toMonoidHom := by
    have hsub := congrArg Sylow.toSubgroup hg
    rw [Sylow.coe_subgroup_smul] at hsub
    exact hsub.symm
  have hRmapS : (R : Subgroup H) =
      S.map (MulAut.conj g).toMonoidHom := by rw [hS, hRmap]
  have horderRS : elementaryAbelianMaxOrder (R : Subgroup H) =
      elementaryAbelianMaxOrder S := by
    rw [hRmapS, elementaryAbelianMaxOrder_map_equiv]
  have hJU : elementaryAbelianMaxJ S ≤ U := hJT.trans hTU
  have horderSU :=
    (elementaryAbelianMaxOrder_le_and_j_le_of_maxJ_le S U hJU).1
  have horderUR :=
    (elementaryAbelianMaxOrder_le_and_j_le_of_eq U (R : Subgroup H) hUR).1
  have horderEqSU : elementaryAbelianMaxOrder S =
      elementaryAbelianMaxOrder U :=
    Nat.le_antisymm horderSU (horderUR.trans_eq horderRS)
  have hJSU : elementaryAbelianMaxJ S ≤ elementaryAbelianMaxJ U :=
    (elementaryAbelianMaxOrder_le_and_j_le_of_maxJ_le S U hJU).2
      horderEqSU
  have horderEqUR : elementaryAbelianMaxOrder U =
      elementaryAbelianMaxOrder (R : Subgroup H) := by
    rw [horderRS, horderEqSU]
  have hJUR : elementaryAbelianMaxJ U ≤
      elementaryAbelianMaxJ (R : Subgroup H) :=
    (elementaryAbelianMaxOrder_le_and_j_le_of_eq U (R : Subgroup H) hUR).2
      horderEqUR
  have hJmap : elementaryAbelianMaxJ (R : Subgroup H) =
      (elementaryAbelianMaxJ S).map (MulAut.conj g).toMonoidHom := by
    rw [hRmapS, elementaryAbelianMaxJ_map_equiv]
  have hcardR : Nat.card (elementaryAbelianMaxJ (R : Subgroup H)) =
      Nat.card (elementaryAbelianMaxJ S) := by
    rw [hJmap]
    exact Subgroup.card_map_of_injective (MulAut.conj g).injective
  have hcardUS : Nat.card (elementaryAbelianMaxJ U) ≤
      Nat.card (elementaryAbelianMaxJ S) := by
    rw [← hcardR]
    exact Subgroup.card_le_of_le hJUR
  exact Subgroup.eq_of_le_of_card_ge hJSU hcardUS

/-- Thompson transport to the actual join Sylow under the (5.4) alternative. -/
public theorem elementaryAbelianMaxJ_eq_of_family_join_sylow
    (S0 : Sylow 2 H) (S P1 P2 T F1 F2 H0 M U : Subgroup H)
    (h : HypothesisTwo H S0 S P1 P2)
    (hJT : elementaryAbelianMaxJ S ≤ T)
    (hTS0 : T ≤ (S0 : Subgroup H))
    (hF1 : F1 ∈ PFamily (⊤ : Subgroup H) T)
    (hF2 : F2 ∈ PFamily (⊤ : Subgroup H) T)
    (hH0 : H0 = F1 ⊔ F2)
    (hM : IsMaximalTwoLocalContaining (S0 : Subgroup H) M)
    (hcore : twoCoreIn H0 ≠ ⊥)
    (halt : S = (S0 : Subgroup H) ∨ ¬ H0 ≤ M)
    (hTU : T ≤ U) (hSylowU : IsSylowTwoIn U H0) :
    elementaryAbelianMaxJ S = elementaryAbelianMaxJ U := by
  rcases halt with hS | hH0not
  · exact elementaryAbelianMaxJ_eq_of_globalSylow S0 S T U hS hJT hTU
      (isPGroup_of_isSylowTwoIn U H0 hSylowU)
  · cases h.fiveOne.alternative with
    | a hS _ _ =>
        exact elementaryAbelianMaxJ_eq_of_globalSylow S0 S T U hS hJT hTU
          (isPGroup_of_isSylowTwoIn U H0 hSylowU)
    | b hS _ =>
        exact elementaryAbelianMaxJ_eq_of_globalSylow S0 S T U hS hJT hTU
          (isPGroup_of_isSylowTwoIn U H0 hSylowU)
    | c Mc hMc _ _ _ _ _ _ _ _ _ _ hc3 =>
        have hMcM : M = Mc := hMc.2 M hM
        have hjoinNot : ¬ F1 ⊔ F2 ≤ Mc := by
          simpa [← hMcM, ← hH0] using hH0not
        have hcoreJoin : twoCoreIn (F1 ⊔ F2) ≠ ⊥ := by
          simpa [← hH0] using hcore
        rcases hc3 T hJT hTS0
            F1 F2 hF1 hF2 hcoreJoin with hjoin | hstable
        · exact (hjoinNot hjoin).elim
        · exact hstable U hTU (by simpa [← hH0] using hSylowU)

private theorem elementaryAbelianMaxJ_eq_of_twoLocal_sylow
    (S0 : Sylow 2 H) (S P1 P2 T K M R : Subgroup H)
    (h : HypothesisTwo H S0 S P1 P2)
    (hM : IsMaximalTwoLocalContaining (S0 : Subgroup H) M)
    (hJT : elementaryAbelianMaxJ S ≤ T) (hTR : T ≤ R)
    (hKlocal : IsTwoLocal K) (hSylowR : IsSylowTwoIn R K)
    (halt : S = (S0 : Subgroup H) ∨ ¬ K ≤ M) :
    elementaryAbelianMaxJ S = elementaryAbelianMaxJ R := by
  rcases halt with hS | hKnot
  · exact elementaryAbelianMaxJ_eq_of_globalSylow S0 S T R hS hJT hTR
      (isPGroup_of_isSylowTwoIn R K hSylowR)
  · cases h.fiveOne.alternative with
    | a hS _ _ =>
        exact elementaryAbelianMaxJ_eq_of_globalSylow S0 S T R hS hJT hTR
          (isPGroup_of_isSylowTwoIn R K hSylowR)
    | b hS _ =>
        exact elementaryAbelianMaxJ_eq_of_globalSylow S0 S T R hS hJT hTR
          (isPGroup_of_isSylowTwoIn R K hSylowR)
    | c Mc hMc _ _ _ _ _ _ _ _ _ hstable _ =>
        have hMcM : M = Mc := hMc.2 M hM
        exact hstable K hKlocal (by simpa [← hMcM] using hKnot)
          R (hJT.trans hTR) hSylowR

/-- Elementary subgroups of `J(S)` centralized by `T` lie in the join core. -/
public theorem elementary_thompson_centralizer_le_join_core
    (S0 : Sylow 2 H) (S P1 P2 : Subgroup H)
    (h : HypothesisTwo H S0 S P1 P2)
    (T F1 F2 H0 M : Subgroup H)
    (hT : baumannIn S ≤ T ∧ T ≤ S)
    (hF1 : F1 ∈ PFamily (⊤ : Subgroup H) T)
    (hF2 : F2 ∈ PFamily (⊤ : Subgroup H) T)
    (hH0 : H0 = F1 ⊔ F2)
    (hM : IsMaximalTwoLocalContaining (S0 : Subgroup H) M)
    (hcore : twoCoreIn H0 ≠ ⊥)
    (halt : S = (S0 : Subgroup H) ∨ ¬ H0 ≤ M)
    (Z : Subgroup H) [hZelem : IsElementaryAbelian 2 Z]
    (hZJ : Z ≤ elementaryAbelianMaxJ S)
    (hTZ : T ≤ Subgroup.centralizer (Z : Set H)) :
    Z ≤ twoCoreIn H0 := by
  have hJT : elementaryAbelianMaxJ S ≤ T :=
    (elementaryAbelianMaxJ_le_baumannIn S).trans hT.1
  have hTS0 : T ≤ (S0 : Subgroup H) :=
    hT.2.trans h.fiveOne.S_le_S0
  have hTp : IsPGroup 2 T :=
    isPGroup_of_isSylowTwoIn T F1 hF1.1.2.1
  have hTH0 : T ≤ H0 := by
    rw [hH0]
    exact hF1.1.2.1.1.trans le_sup_left
  let Q0 : Subgroup H := twoCoreIn H0
  let T0 : Subgroup H := T ⊓ Q0
  let N : Subgroup H := Subgroup.normalizer (T0 : Set H)
  have hH0N : H0 ≤ N := by
    have hp := SectionThree.pair_le_normalizer_inf_twoCoreAmbient
      T F1 F2 H0 hF1.1.2.1.2 hF2.1.2.1.2 hH0
    simpa [N, T0, Q0, twoCoreIn, twoCoreAmbient] using hp
  obtain ⟨S1, hTS1, hSylow1⟩ :=
    exists_isSylowTwoIn_of_le T H0 hTH0 hTp
  have hJS1 : elementaryAbelianMaxJ S = elementaryAbelianMaxJ S1 :=
    elementaryAbelianMaxJ_eq_of_family_join_sylow
      S0 S P1 P2 T F1 F2 H0 M S1 h hJT hTS0 hF1 hF2 hH0 hM
        hcore halt hTS1 hSylow1
  have hQ0S1 : Q0 ≤ S1 := by
    obtain ⟨_, R, hR⟩ := hSylow1
    calc
      Q0 = (pCore 2 H0).map H0.subtype := rfl
      _ ≤ (R : Subgroup H0).map H0.subtype := Subgroup.map_mono
        ((pCore_isPGroup (p := 2) (G := H0)).le_sylow_of_normal R)
      _ = S1 := hR
  have hQ0normalS1 : (Q0.subgroupOf S1).Normal := by
    apply (Subgroup.normal_subgroupOf_iff_le_normalizer hQ0S1).mpr
    exact hSylow1.1.trans (le_normalizer_twoCoreIn H0)
  have hS1p : IsPGroup 2 S1 :=
    isPGroup_of_isSylowTwoIn S1 H0 hSylow1
  have homegaInf : omegaOneCenter S1 ⊓ Q0 ≠ ⊥ :=
    omegaOneCenter_inf_normal_ne_bot S1 Q0 hQ0S1 hS1p hQ0normalS1 hcore
  have homegaT : omegaOneCenter S1 ≤ T := by
    calc
      omegaOneCenter S1 ≤ elementaryAbelianMaxJ S1 :=
        omegaOneCenter_le_elementaryAbelianMaxJ S1
      _ = elementaryAbelianMaxJ S := hJS1.symm
      _ ≤ T := hJT
  have hT0ne : T0 ≠ ⊥ := by
    intro hbot
    apply homegaInf
    exact le_bot_iff.mp ((inf_le_inf homegaT le_rfl).trans_eq hbot)
  have hT0p : IsPGroup 2 T0 := hTp.to_le inf_le_left
  have hNlocal : IsTwoLocal N := ⟨T0, hT0ne, hT0p, rfl⟩
  have hTN : T ≤ N := hTH0.trans hH0N
  have hBN : baumannIn S ≤ N := hT.1.trans hTN
  have hNchar : Stellmacher.IsCharacteristicTwoType N :=
    (h.local_B N hNlocal hBN).2
  obtain ⟨S2, hTS2, hSylow2⟩ :=
    exists_isSylowTwoIn_of_le T N hTN hTp
  have haltN : S = (S0 : Subgroup H) ∨ ¬ N ≤ M := by
    rcases halt with hS | hH0not
    · exact Or.inl hS
    · exact Or.inr fun hNM => hH0not (hH0N.trans hNM)
  have hJS2 : elementaryAbelianMaxJ S = elementaryAbelianMaxJ S2 :=
    elementaryAbelianMaxJ_eq_of_twoLocal_sylow
      S0 S P1 P2 T N M S2 h hM hJT hTS2 hNlocal hSylow2 haltN
  let Q : Subgroup H := twoCoreIn N
  have hQS2 : Q ≤ S2 := by
    obtain ⟨_, R, hR⟩ := hSylow2
    calc
      Q = (pCore 2 N).map N.subtype := rfl
      _ ≤ (R : Subgroup N).map N.subtype := Subgroup.map_mono
        ((pCore_isPGroup (p := 2) (G := N)).le_sylow_of_normal R)
      _ = S2 := hR
  let R0 : Subgroup H := Q ⊓ H0
  have hR0H0 : R0 ≤ H0 := inf_le_right
  have hH0normQ : H0 ≤ Subgroup.normalizer (Q : Set H) :=
    hH0N.trans (le_normalizer_twoCoreIn N)
  have hR0normalH0 : (R0.subgroupOf H0).Normal := by
    apply (Subgroup.normal_subgroupOf_iff_le_normalizer hR0H0).mpr
    exact (le_inf hH0normQ H0.le_normalizer).trans
      Subgroup.inf_normalizer_le_normalizer_inf
  have hR0p : IsPGroup 2 R0 :=
    (twoCoreIn_isPGroup N).to_le inf_le_left
  have hR0Q0 : R0 ≤ Q0 :=
    normal_pSubgroup_le_twoCoreIn R0 H0 hR0H0 hR0p hR0normalH0
  have hQTQ0 : Q ⊓ T ≤ Q0 := by
    exact (le_inf inf_le_left (inf_le_right.trans hTH0)).trans hR0Q0
  have hJ2T : elementaryAbelianMaxJ S2 ≤ T := by
    rw [← hJS2]
    exact hJT
  have hJ2S2 : elementaryAbelianMaxJ S2 ≤ S2 :=
    elementaryAbelianMaxJ_le S2
  have hJ2normQ : elementaryAbelianMaxJ S2 ≤
      Subgroup.normalizer (Q : Set H) :=
    hJ2S2.trans (hSylow2.1.trans (le_normalizer_twoCoreIn N))
  have hQnormJ2 : Q ≤
      Subgroup.normalizer (elementaryAbelianMaxJ S2 : Set H) :=
    hQS2.trans (S2.le_normalizer.trans (normalizer_le_normalizer_J S2))
  have hQJleQ : ⁅Q, elementaryAbelianMaxJ S2⁆ ≤ Q :=
    Subgroup.le_normalizer_iff_commutator_le_left.mp hJ2normQ
  have hQJleJ : ⁅Q, elementaryAbelianMaxJ S2⁆ ≤
      elementaryAbelianMaxJ S2 :=
    Subgroup.le_normalizer_iff_commutator_le_right.mp hQnormJ2
  have hQJleT0 : ⁅Q, elementaryAbelianMaxJ S2⁆ ≤ T0 := by
    intro x hx
    have hxQ := hQJleQ hx
    have hxT := hJ2T (hQJleJ hx)
    exact ⟨hxT, hQTQ0 ⟨hxQ, hxT⟩⟩
  have hZJ2 : Z ≤ elementaryAbelianMaxJ S2 := by
    rw [← hJS2]
    exact hZJ
  have hQZleT0 : ⁅Q, Z⁆ ≤ T0 :=
    (Subgroup.commutator_mono le_rfl hZJ2).trans hQJleT0
  have hT0Z : ⁅T0, Z⁆ = ⊥ := by
    rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact inf_le_left.trans hTZ
  have hT0leN : T0 ≤ N := by
    exact Subgroup.le_normalizer
  have hT0normalN : (T0.subgroupOf N).Normal := by
    apply (Subgroup.normal_subgroupOf_iff_le_normalizer hT0leN).mpr
    exact le_rfl
  have hZN : Z ≤ N := by
    exact hZJ.trans (hJT.trans hTN)
  let T0N : Subgroup N := T0.subgroupOf N
  let ZN : Subgroup N := Z.subgroupOf N
  have hQZinternal : ⁅pCore 2 N, ZN⁆ ≤ T0N := by
    apply (Subgroup.map_le_map_iff_of_injective N.subtype_injective).mp
    rw [Subgroup.map_commutator,
      Subgroup.map_subgroupOf_eq_of_le hZN,
      Subgroup.map_subgroupOf_eq_of_le hT0leN]
    exact hQZleT0
  have hT0Zinternal : ⁅T0N, ZN⁆ = ⊥ := by
    apply (Subgroup.map_eq_bot_iff_of_injective
      (⁅T0N, ZN⁆) N.subtype_injective).mp
    rw [Subgroup.map_commutator,
      Subgroup.map_subgroupOf_eq_of_le hT0leN,
      Subgroup.map_subgroupOf_eq_of_le hZN, hT0Z]
  have hT0Nnormal : T0N.Normal := hT0normalN
  have hZNelem : IsElementaryAbelian 2 ZN := by
    let _ : IsElementaryAbelian 2 Z := hZelem
    exact IsElementaryAbelian.subgroupOf hZN
  have hWNp : IsPGroup 2 (Subgroup.normalClosure (ZN : Set N)) :=
    normalClosure_isPGroup_of_characteristicTwo T0N ZN hNchar
      hT0Nnormal hQZinternal hT0Zinternal hZNelem
  have hWNleCore : Subgroup.normalClosure (ZN : Set N) ≤ pCore 2 N :=
    le_sSup ⟨Subgroup.normalClosure_normal, hWNp⟩
  have hZQ : Z ≤ Q := by
    calc
      Z = ZN.map N.subtype :=
        (Subgroup.map_subgroupOf_eq_of_le hZN).symm
      _ ≤ (pCore 2 N).map N.subtype :=
        Subgroup.map_mono (Subgroup.le_normalClosure.trans hWNleCore)
      _ = Q := rfl
  have hZH0 : Z ≤ H0 :=
    hZJ.trans (hJT.trans hTH0)
  exact (le_inf hZQ hZH0).trans hR0Q0


/-- **Stellmacher (5.4).**  The central elementary-abelian subgroup of `S` is
contained in the 2-core of `⟨F₁,F₂⟩` under the stated alternative. -/
public theorem lemma_five_four
    (S0 : Sylow 2 H) (S P1 P2 : Subgroup H)
    (h : HypothesisTwo H S0 S P1 P2)
    (T F1 F2 H0 M : Subgroup H)
    (hT : baumannIn S ≤ T ∧ T ≤ S)
    (hF1 : F1 ∈ PFamily (⊤ : Subgroup H) T)
    (hF2 : F2 ∈ PFamily (⊤ : Subgroup H) T)
    (hH0 : H0 = F1 ⊔ F2)
    (hM : IsMaximalTwoLocalContaining (S0 : Subgroup H) M)
    (hcore : twoCoreIn H0 ≠ ⊥)
    (halt : S = (S0 : Subgroup H) ∨ ¬ H0 ≤ M) :
    omegaOneCenter S ≤ twoCoreIn H0 := by
  let _ : IsElementaryAbelian 2 (omegaOneCenter S) :=
    omegaOneCenter_isElementaryAbelian S
  exact elementary_thompson_centralizer_le_join_core
    S0 S P1 P2 h T F1 F2 H0 M hT hF1 hF2 hH0 hM hcore halt
    (omegaOneCenter S) (omegaOneCenter_le_elementaryAbelianMaxJ S)
    (hT.2.trans (subgroup_le_centralizer_omegaOneCenter S))


/-- The global Sylow form of (5.4) needs only normalization of the core intersection. -/
public theorem omegaOneCenter_le_core_of_globalSylow
    (S0 : Sylow 2 H) (S P1 P2 : Subgroup H)
    (h : HypothesisTwo H S0 S P1 P2) (hS : S = (S0 : Subgroup H))
    (L : Subgroup H) (hBL : baumannIn S ≤ L) (hcore : twoCoreIn L ≠ ⊥)
    (hLN : L ≤ Subgroup.normalizer (S ⊓ twoCoreIn L : Set H)) :
    omegaOneCenter S ≤ twoCoreIn L := by
  let B := baumannIn S
  let Q0 := twoCoreIn L
  let Q := S ⊓ Q0
  let N := Subgroup.normalizer (Q : Set H)
  have hBp : IsPGroup 2 B := (hS ▸ S0.isPGroup').to_le inf_le_left
  have hJB : elementaryAbelianMaxJ S ≤ B := elementaryAbelianMaxJ_le_baumannIn S
  obtain ⟨R1, hBR1, hR1⟩ := exists_isSylowTwoIn_of_le B L hBL hBp
  have hJR1 : elementaryAbelianMaxJ S = elementaryAbelianMaxJ R1 :=
    elementaryAbelianMaxJ_eq_of_globalSylow S0 S B R1 hS hJB hBR1
      (isPGroup_of_isSylowTwoIn R1 L hR1)
  have hQ0R1 : Q0 ≤ R1 := by
    obtain ⟨_, R, hR⟩ := hR1
    exact hR ▸ Subgroup.map_mono
      ((pCore_isPGroup (p := 2) (G := L)).le_sylow_of_normal R)
  have hQnR1 : (Q0.subgroupOf R1).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hQ0R1).mpr
      (hR1.1.trans (le_normalizer_twoCoreIn L))
  have hne : Q ≠ ⊥ := by
    have hi := omegaOneCenter_inf_normal_ne_bot R1 Q0 hQ0R1
      (isPGroup_of_isSylowTwoIn R1 L hR1) hQnR1 hcore
    have hOS : omegaOneCenter R1 ≤ S :=
      (omegaOneCenter_le_elementaryAbelianMaxJ R1).trans
        (hJR1.symm.le.trans (elementaryAbelianMaxJ_le S))
    intro he
    exact hi (bot_unique ((inf_le_inf hOS le_rfl).trans_eq he))
  have hQp : IsPGroup 2 Q := (hS ▸ S0.isPGroup').to_le inf_le_left
  have hNlocal : IsTwoLocal N := ⟨Q, hne, hQp, rfl⟩
  have hBN : B ≤ N := hBL.trans hLN
  have hchar : IsCharacteristicTwoType N := (h.local_B N hNlocal hBN).2
  obtain ⟨R2, hBR2, hR2⟩ := exists_isSylowTwoIn_of_le B N hBN hBp
  have hJR2 : elementaryAbelianMaxJ S = elementaryAbelianMaxJ R2 :=
    elementaryAbelianMaxJ_eq_of_globalSylow S0 S B R2 hS hJB hBR2
      (isPGroup_of_isSylowTwoIn R2 N hR2)
  let O := twoCoreIn N
  have hOR2 : O ≤ R2 := by
    obtain ⟨_, R, hR⟩ := hR2
    exact hR ▸ Subgroup.map_mono
      ((pCore_isPGroup (p := 2) (G := N)).le_sylow_of_normal R)
  have hOLcore : O ⊓ L ≤ Q0 := by
    have hn : ((O ⊓ L).subgroupOf L).Normal :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer inf_le_right).mpr
        ((le_inf (hLN.trans (le_normalizer_twoCoreIn N)) L.le_normalizer).trans
          Subgroup.inf_normalizer_le_normalizer_inf)
    exact normal_pSubgroup_le_twoCoreIn (O ⊓ L) L inf_le_right
      ((twoCoreIn_isPGroup N).to_le inf_le_left) hn
  have hJnO : elementaryAbelianMaxJ R2 ≤ Subgroup.normalizer (O : Set H) :=
    (elementaryAbelianMaxJ_le R2).trans (hR2.1.trans (le_normalizer_twoCoreIn N))
  have hOnJ : O ≤ Subgroup.normalizer (elementaryAbelianMaxJ R2 : Set H) :=
    hOR2.trans (R2.le_normalizer.trans (normalizer_le_normalizer_J R2))
  have hcommJ : ⁅O, elementaryAbelianMaxJ R2⁆ ≤ Q := by
    have hcO := Subgroup.le_normalizer_iff_commutator_le_left.mp hJnO
    have hcJ := Subgroup.le_normalizer_iff_commutator_le_right.mp hOnJ
    have hcB := hcJ.trans (hJR2.symm.le.trans hJB)
    exact le_inf (hcB.trans inf_le_left)
      ((le_inf hcO (hcB.trans hBL)).trans hOLcore)
  let Z := omegaOneCenter S
  have hZJ : Z ≤ elementaryAbelianMaxJ R2 :=
    (omegaOneCenter_le_elementaryAbelianMaxJ S).trans hJR2.le
  have hOZ : ⁅O, Z⁆ ≤ Q := (Subgroup.commutator_mono le_rfl hZJ).trans hcommJ
  have hQZ : ⁅Q, Z⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
    (inf_le_left.trans (subgroup_le_centralizer_omegaOneCenter S))
  have hQN : Q ≤ N := Subgroup.le_normalizer
  have hZN : Z ≤ N := (omegaOneCenter_le_elementaryAbelianMaxJ S).trans
    (hJB.trans hBN)
  let QN := Q.subgroupOf N
  let ZN := Z.subgroupOf N
  have hinternal : ⁅pCore 2 N, ZN⁆ ≤ QN := by
    apply (Subgroup.map_le_map_iff_of_injective N.subtype_injective).mp
    rw [Subgroup.map_commutator, Subgroup.map_subgroupOf_eq_of_le hZN,
      Subgroup.map_subgroupOf_eq_of_le hQN]
    exact hOZ
  have hcentral : ⁅QN, ZN⁆ = ⊥ := by
    apply (Subgroup.map_eq_bot_iff_of_injective _ N.subtype_injective).mp
    rw [Subgroup.map_commutator, Subgroup.map_subgroupOf_eq_of_le hQN,
      Subgroup.map_subgroupOf_eq_of_le hZN, hQZ]
  have hQNnormal : QN.Normal := Subgroup.normal_in_normalizer
  have hZNelem : IsElementaryAbelian 2 ZN := by
    let _ := omegaOneCenter_isElementaryAbelian S
    exact IsElementaryAbelian.subgroupOf hZN
  have hp := normalClosure_isPGroup_of_characteristicTwo QN ZN hchar
    hQNnormal hinternal hcentral hZNelem
  have hclosure : Subgroup.normalClosure (ZN : Set N) ≤ pCore 2 N :=
    le_sSup ⟨Subgroup.normalClosure_normal, hp⟩
  have hZO : Z ≤ O := by
    rw [← Subgroup.map_subgroupOf_eq_of_le hZN]
    exact Subgroup.map_mono (Subgroup.le_normalClosure.trans hclosure)
  exact (le_inf hZO ((omegaOneCenter_le_elementaryAbelianMaxJ S).trans
    (hJB.trans hBL))).trans hOLcore

end Stellmacher.SectionsFiveToSeven
