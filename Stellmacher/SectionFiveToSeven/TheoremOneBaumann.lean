module

public import Stellmacher.SectionFiveToSeven.Defs

/-!
# The common source Baumann subgroup

Theorem 1 and the Section Five local hypotheses use exactly the same Baumann
subgroup: the centralizer in S of the omega subgroup of the center of the
Thompson subgroup generated by largest elementary abelian subgroups. The
shared elementary Thompson definitions make the two interfaces agree by
reduction. This bridges the source-correct main hypothesis to Hypothesis Two.

Source: Stellmacher, Theorem 1 and the notation preceding Section 2,
printed pp.12 and19.
-/

namespace Stellmacher.SectionsFiveToSeven
universe u

public theorem baumannSubgroup_eq_baumannIn
    {H : Type u} [Group H] (S0 : Sylow 2 H) :
    Stellmacher.baumannSubgroup S0 = baumannIn (S0 : Subgroup H) := rfl

public theorem baumannSubgroup_le_sylow
    {H : Type u} [Group H] (S0 : Sylow 2 H) :
    Stellmacher.baumannSubgroup S0 ≤ (S0 : Subgroup H) := inf_le_left

end Stellmacher.SectionsFiveToSeven
