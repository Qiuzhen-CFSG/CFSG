module
public import Stellmacher.SectionFiveToSeven.Defs
public import Stellmacher.OmegaOneCenterMap

/-!
# The graph vertex subgroup as the supplied local module

For any vertex d of the actual coset-graph context and any supplied Sylow
two-subgroup U of its stabilizer, the ambient image of SectionTwo.vSubgroup U
equals the graph-defined subgroup Z_d. No replacement Sylow or additional
Section Seven hypotheses are needed.

The normal closure of Ω₁(Z(U)) is generated by its conjugates. Covariance
of the omega center puts each such conjugate in the omega center of a
conjugate Sylow subgroup, hence in the join defining Z_d. Conversely,
Sylow conjugacy expresses every generator of that join as a conjugate of
the chosen omega center, which lies in the chosen normal closure.

This identifies the actual Z_a with the original Section Two module when
applying (2.2) and (2.4) in Stellmacher (8.3). Source: Section Seven notation
and (8.3), refs/latex/stellmacher-n-group.tex, journal pp.33 and 38.
The same mathematical argument occurs for the distinct free-amalgam graph
in PushingUp/VertexZLocalModule; this theorem uses the present graph's
literal zAt definition and retains the caller's Sylow subgroup.
-/

namespace Stellmacher.SectionsFiveToSeven
open CosetGraphContext
universe u

private theorem omega_sylow_le_local_module
    {G : Type u} [Group G] [Finite G] (U T : Sylow 2 G) :
    omegaOneCenterAmbient (T : Subgroup G) ≤ SectionTwo.vSubgroup U := by
  let V := SectionTwo.vSubgroup U
  let _ : V.Normal := Subgroup.normalClosure_normal
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G U T
  have hT : (T : Subgroup G) = (U : Subgroup G).map (MulAut.conj g).toMonoidHom := by
    rw [← hg, Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def]
    congr 1
  rw [hT, omegaOneCenterAmbient_map_injective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective]
  rintro x ⟨y, hy, rfl⟩
  have hyV : y ∈ V := Subgroup.le_normalClosure hy
  exact (inferInstance : V.Normal).conj_mem y hyV g

public theorem vertexZ_eq_local_vSubgroup
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (Gamma : CosetGraphContext G S P1 P2) (d : Gamma.Vertex)
    (U : Sylow 2 (stabilizer Gamma d)) :
    (SectionTwo.vSubgroup U).map (stabilizer Gamma d).subtype = z Gamma d := by
  let P := stabilizer Gamma d
  have hgen (T : Sylow 2 P) :
      (omegaOneCenterAmbient (T : Subgroup P)).map P.subtype ≤ z Gamma d := by
    rw [z, Gamma.zAt_def]
    rw [← omegaOneCenterAmbient_map_injective P.subtype P.subtype_injective]
    exact le_sSup ⟨T, rfl⟩
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap]
    change Subgroup.normalClosure (omegaOneCenterAmbient (U : Subgroup P) : Set P) ≤ _
    rw [Subgroup.normalClosure]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    obtain ⟨y, hy, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨g, hg⟩ := isConj_iff.mp hconj
    have hconjOmega : (omegaOneCenterAmbient (U : Subgroup P)).map
        (MulAut.conj g).toMonoidHom = omegaOneCenterAmbient ((g • U : Sylow 2 P) : Subgroup P) := by
      have hconjSylow : ((g • U : Sylow 2 P) : Subgroup P) =
          (U : Subgroup P).map (MulAut.conj g).toMonoidHom := by
        rw [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def]
        congr 1
      rw [hconjSylow, omegaOneCenterAmbient_map_injective
        (MulAut.conj g).toMonoidHom (MulAut.conj g).injective]
    have hxOmega : x ∈ omegaOneCenterAmbient ((g • U : Sylow 2 P) : Subgroup P) := by
      rw [← hconjOmega]
      exact ⟨y, hy, hg⟩
    exact hgen (g • U) (Subgroup.mem_map_of_mem P.subtype hxOmega)
  · rw [z, Gamma.zAt_def]
    apply sSup_le
    rintro Z ⟨T, rfl⟩
    change omegaOneCenterAmbient ((T : Subgroup (Gamma.vertexStabilizer d)).map
      (Gamma.vertexStabilizer d).subtype) ≤ _
    rw [omegaOneCenterAmbient_map_injective
      (Gamma.vertexStabilizer d).subtype (Gamma.vertexStabilizer d).subtype_injective]
    exact Subgroup.map_mono (omega_sylow_le_local_module U T)

end Stellmacher.SectionsFiveToSeven

