module
public import Stellmacher.SectionFiveToSeven.Defs
public import Stellmacher.SectionTwo.OddConjugationOrbitCore
public import Stellmacher.PushingUp.SL2TwoCoreResidualCardFour
public import Stellmacher.SL2FrattiniUniqueMaximal
public import Stellmacher.TwoResidualSylowSupplement

/-!
# The actual residual-module odd orbit is normal locally

Let the native finite local group satisfy Section Two, pushing-up (P),
and the nested SL₂(2) Frattini condition, and inject it into H. An odd-order
subgroup U normalizing the image B of its supplied Sylow subgroup acts on
the actual core-residual module W₁. The subgroup W generated by those
conjugates contains W₁, lies in B, and is normalized by both U and the
image of the native local group.

The explicit conjugation version of (2.5) bounds W by the image of the
native two-core. Normality of W₁ and normalization of B by U show that B
normalizes every conjugate and hence W. Since [O₂(G),O²(G)]=W₁≤W, the
core bound makes O²(G) normalize W too. Residual-Sylow generation gives
normalization by G. The acting subgroup U preserves its orbit closure by
multiplication of the actors. This proves normality for the actual smaller
W₁ orbit, without assuming that every suborbit of the full canonical
V-orbit is normal.

Source: Stellmacher (6.1), Journal of Algebra 190 (1997), p.30, the
application of (2.5), in `refs/latex/stellmacher-n-group.tex`.
-/

namespace Stellmacher.SectionsFiveToSeven
universe u v

private theorem residual_normal {G : Type*} [Group G] :
    (twoResidualAmbient (⊤ : Subgroup G)).Normal := by
  have hres : (twoResidualSubgroup (⊤ : Subgroup G)).Normal := by
    unfold twoResidualSubgroup
    rw [sInf_eq_iInf]
    exact Subgroup.normal_iInf_normal fun N => Subgroup.normal_iInf_normal fun hN => hN.1
  unfold twoResidualAmbient
  exact hres.map _ fun x => ⟨⟨x, by simp⟩, rfl⟩

public theorem sixOne_odd_orbit_data
    {G : Type u} [Group G] [Finite G]
    (h : SectionTwo.Hypotheses G) (T : Sylow 2 G)
    (hP : ∀ X : Subgroup T, X.Characteristic → X ≠ ⊥ →
      ¬ (X.map (T : Subgroup G).subtype).Normal)
    (hA : IsSL2Two ((G ⧸ pCore 2 G) ⧸ frattini (G ⧸ pCore 2 G)))
    {H : Type v} [Group H] [Finite H]
    (f : G →* H) (hf : Function.Injective f)
    (U : Subgroup H) (hU : Odd (Nat.card U))
    (hnorm : U ≤ Subgroup.normalizer (((T : Subgroup G).map f : Subgroup H) : Set H)) :
    let W1 := (⁅pCore 2 G, twoResidualAmbient (⊤ : Subgroup G)⁆).map f
    let W := conjugateClosure W1 U
    W1 ≤ W ∧ W ≤ (T : Subgroup G).map f ∧
      f.range ≤ Subgroup.normalizer (W : Set H) ∧
      U ≤ Subgroup.normalizer (W : Set H) := by
  let R := twoResidualAmbient (⊤ : Subgroup G)
  let W0 := ⁅pCore 2 G, R⁆
  let W1 := W0.map f
  let W := conjugateClosure W1 U
  let B := (T : Subgroup G).map f
  let _ : R.Normal := residual_normal
  let _ : W0.Normal := inferInstance
  let _ : (SectionTwo.vSubgroup T).Normal := Subgroup.normalClosure_normal
  let _ : (SectionTwo.cSubgroup T).Normal := Subgroup.normal_centralizer
  obtain ⟨hSL, _hcard, hWeq⟩ := PushingUp.sl2Two_coreResidual_card_four h T hP hA
  let q := QuotientGroup.mk' (SectionTwo.cSubgroup T)
  have hq := QuotientGroup.mk'_surjective (SectionTwo.cSubgroup T)
  have hker : q.ker = SectionTwo.cSubgroup T := QuotientGroup.ker_mk' _
  have hUK := isUniqueMaximalContaining_of_sl2Two_frattini T hA
  have hW0V : W0 ≤ SectionTwo.vSubgroup T := by
    rw [show W0 = ⁅pCore 2 G, R⁆ from rfl, hWeq]
    exact Subgroup.commutator_le_left _ _
  have hraw := SectionTwo.odd_conjugation_orbit_le_core
    h T hP hUK q hq hker hSL f hf U hU hnorm W0 hW0V
  have hWcore : W ≤ (pCore 2 G).map f := by
    apply (Subgroup.closure_le _).mpr
    rintro z ⟨u, w, rfl⟩
    obtain ⟨x, hx, he⟩ := w.property
    rw [← he]
    exact hraw (Subgroup.subset_closure ⟨u, ⟨x, hx⟩, rfl⟩)
  have hW1W : W1 ≤ W := by
    intro w hw
    exact Subgroup.subset_closure ⟨1, ⟨w, hw⟩, by simp⟩
  have hWB : W ≤ B := hWcore.trans
    (Subgroup.map_mono ((pCore_isPGroup (p := 2) (G := G)).le_sylow_of_normal T))
  have hBW1 : B ≤ Subgroup.normalizer (W1 : Set H) := by
    apply Subgroup.le_normalizer_iff.mpr
    rintro b ⟨t, ht, rfl⟩ w ⟨w0, hw0, rfl⟩
    exact ⟨t * w0 * t⁻¹, (inferInstance : W0.Normal).conj_mem w0 hw0 t, by simp⟩
  have hBW : B ≤ Subgroup.normalizer (W : Set H) := by
    apply Subgroup.le_normalizer_iff.mpr
    intro b hb x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨u, w, rfl⟩ := hx
      have hub : (u : H)⁻¹ * b * (u : H) ∈ B := by
        simpa only [inv_inv] using
          (Subgroup.mem_normalizer_iff.mp (hnorm (U.inv_mem u.property)) b).mp hb
      have hconj : ((u : H)⁻¹ * b * (u : H)) * (w : H) *
          ((u : H)⁻¹ * b * (u : H))⁻¹ ∈ W1 :=
        (Subgroup.mem_normalizer_iff.mp (hBW1 hub) w).mp w.property
      apply Subgroup.subset_closure
      refine ⟨u, ⟨_, hconj⟩, ?_⟩
      group
    | one => simp
    | mul x y hx hy ihx ihy =>
      convert W.mul_mem ihx ihy using 1; group
    | inv x hx ih =>
      convert W.inv_mem ih using 1; group
  have hRW : R.map f ≤ Subgroup.normalizer (W : Set H) := by
    apply Subgroup.le_normalizer_iff_commutator_le_left.mpr
    have hc : ⁅W, R.map f⁆ ≤ W1 := by
      have hm := Subgroup.commutator_mono hWcore (le_refl (R.map f))
      rw [← Subgroup.map_commutator] at hm
      exact hm
    exact hc.trans hW1W
  have hgen : R.map f ⊔ B = f.range := by
    rw [show B = (T : Subgroup G).map f from rfl, ← Subgroup.map_sup,
      twoResidualAmbient_top_sup_sylow T, ← MonoidHom.range_eq_map]
  have hEW : f.range ≤ Subgroup.normalizer (W : Set H) := by
    rw [← hgen]
    exact sup_le hRW hBW
  have hUW : U ≤ Subgroup.normalizer (W : Set H) := by
    apply Subgroup.le_normalizer_iff.mpr
    intro u hu x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨v, w, rfl⟩ := hx
      apply Subgroup.subset_closure
      refine ⟨⟨u * v, U.mul_mem hu v.property⟩, w, ?_⟩
      group
    | one => simp
    | mul x y hx hy ihx ihy =>
      convert W.mul_mem ihx ihy using 1; group
    | inv x hx ih =>
      convert W.inv_mem ih using 1; group
  exact ⟨hW1W, hWB, hEW, hUW⟩

end Stellmacher.SectionsFiveToSeven
