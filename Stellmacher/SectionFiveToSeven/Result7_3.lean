module

public import Stellmacher.SectionFiveToSeven.Result7_1
public import Stellmacher.SectionFiveToSeven.PFamilyConjugation
public import Stellmacher.SectionThree.LemmaThreeFour

/-!
# Stellmacher's Lemma 7.3

This module proves the standard local facts at an edge of the Section 7 coset
graph.  Edge transitivity identifies the two vertex stabilizers simultaneously
with conjugates of `P₁` and `P₂`; conjugacy of Sylow subgroups inside the
edge stabilizer then transports the `PFamily`, solvability, and
characteristic-2 hypotheses to the Sylow subgroup selected on that edge.

For a vertex stabilizer `P`, its subgroup `Z` is the join of the omega-one
centers of all Sylow 2-subgroups.  Characteristic 2 puts `Z` in
`Ω₁(Z(O₂(P)))`. Applying Lemma 3.4 to `C_S(Z)` gives either
`C_S(Z)=O₂(P)`, or `P=C_P(Z)S`; Sylow conjugacy then makes `Z` equal to both
`Ω₁(Z(P))` and `Ω₁(Z(S))`.  In the latter situation at one end
of an edge, the omega-one center at the other end is central in the group
generated by the two stabilizers and hence lies in the trivial ambient
2-core. Characteristic 2 then forces the entire neighboring center to be
trivial. The normal Sylow omega-center equality is also exported for the
centralizer hypothesis in (7.7).
The solvability projection from the same edge transport is exported for the
faithful local quotient actions in Section 8.
The local-family and normal center data are also exported through a narrow
edge interface for the primitive extraction in (7.8).

Source: `refs/latex/stellmacher-n-group.tex`, Lemma (7.3), corresponding to
Journal of Algebra 190 (1997), p. 33.
-/

open scoped Pointwise

namespace Stellmacher.SectionsFiveToSeven

open CosetGraphContext

universe u v

private theorem omegaOneCenter_le_centerAmbient
    {G : Type u} [Group G] (A : Subgroup G) :
    omegaOneCenter A ≤ (Subgroup.center A).map A.subtype := by
  unfold omegaOneCenter
  exact Subgroup.map_mono (Subgroup.map_subtype_le _)

private theorem omegaOneCenter_isElementaryAbelian
    {G : Type u} [Group G] (A : Subgroup G) :
    IsElementaryAbelian 2 (omegaOneCenter A) := by
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hinner : IsElementaryAbelian 2
      (omega₁ (G := Subgroup.center A) (p := 2)) :=
    IsElementaryAbelian.omega₁_of_isMulCommutative (p := 2)
      (Subgroup.center A)
  have hcenter : IsElementaryAbelian 2
      ((omega₁ (G := Subgroup.center A) (p := 2)).map
        (Subgroup.center A).subtype) :=
    IsElementaryAbelian.map (p := 2) (A :=
      omega₁ (G := Subgroup.center A) (p := 2))
      (Subgroup.center A).subtype
  exact IsElementaryAbelian.map (p := 2) (A :=
    (omega₁ (G := Subgroup.center A) (p := 2)).map
      (Subgroup.center A).subtype) A.subtype

private theorem omega₁_map_equiv
    {A B : Type u} [Group A] [Group B] (e : A ≃* B) :
    (omega₁ (G := A) (p := 2)).map e.toMonoidHom =
      omega₁ (G := B) (p := 2) := by
  let X : Set A := {x | x ^ (2 ^ 1) = 1}
  let Y : Set B := {y | y ^ (2 ^ 1) = 1}
  have hXY : e '' X = Y := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      have hx' : x ^ (2 ^ 1) = 1 := hx
      simpa [Y] using congrArg e.toMonoidHom hx'
    · intro hy
      refine ⟨e.symm y, ?_, by simp⟩
      have hy' : y ^ (2 ^ 1) = 1 := hy
      simpa [X] using congrArg e.symm.toMonoidHom hy'
  change (Subgroup.closure X).map e.toMonoidHom = Subgroup.closure Y
  rw [MonoidHom.map_closure]
  exact congrArg Subgroup.closure hXY

private theorem omegaOneCenter_map_equiv
    {G G' : Type u} [Group G] [Group G']
    (e : G ≃* G') (A : Subgroup G) :
    omegaOneCenter (A.map e.toMonoidHom) =
      (omegaOneCenter A).map e.toMonoidHom := by
  let eA : A ≃* A.map e.toMonoidHom :=
    A.equivMapOfInjective e.toMonoidHom e.injective
  let eZ : Subgroup.center A ≃* Subgroup.center (A.map e.toMonoidHom) :=
    Subgroup.centerCongr eA
  have hOmega :
      (omega₁ (G := Subgroup.center A) (p := 2)).map eZ.toMonoidHom =
        omega₁ (G := Subgroup.center (A.map e.toMonoidHom)) (p := 2) :=
    omega₁_map_equiv eZ
  symm
  unfold omegaOneCenter
  rw [← hOmega]
  simp only [Subgroup.map_map]
  apply congrArg (fun f : Subgroup.center A →* G' ↦
    (omega₁ (G := Subgroup.center A) (p := 2)).map f)
  ext z
  rfl

private theorem elementaryAbelian_le_omegaOneCenter
    {G : Type u} [Group G] {E Q : Subgroup G}
    (hEcenter : E ≤ (Subgroup.center Q).map Q.subtype)
    (hE : IsElementaryAbelian 2 E) :
    E ≤ omegaOneCenter Q := by
  let _ : IsElementaryAbelian 2 E := hE
  intro x hx
  obtain ⟨z, hzcenter, hzx⟩ := hEcenter hx
  let zc : Subgroup.center Q := ⟨z, hzcenter⟩
  have hxpow : x ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian x hx
  have hzpowQ : z ^ 2 = 1 := by
    apply Q.subtype_injective
    change (z : G) ^ 2 = 1
    exact (congrArg (fun y : G ↦ y ^ 2) hzx).trans hxpow
  have hzpowC : zc ^ 2 = 1 := by
    apply (Subgroup.center Q).subtype_injective
    exact hzpowQ
  have hzomega : zc ∈ omega₁ (G := Subgroup.center Q) (p := 2) := by
    rw [omega₁, omega]
    apply Subgroup.subset_closure
    simpa using hzpowC
  have hzambient : (z : G) ∈ omegaOneCenter Q := by
    unfold omegaOneCenter
    exact Subgroup.mem_map_of_mem Q.subtype
      (Subgroup.mem_map_of_mem (Subgroup.center Q).subtype hzomega)
  rw [← hzx]
  exact hzambient

private theorem twoCoreIn_le_sylow
    {G : Type u} [Group G] [Finite G]
    {S P : Subgroup G} (hSP : IsSylowTwoIn S P) :
    twoCoreIn P ≤ S := by
  obtain ⟨_, T, hTmap⟩ := hSP
  calc
    twoCoreIn P = (pCore 2 P).map P.subtype := rfl
    _ ≤ (T : Subgroup P).map P.subtype :=
      Subgroup.map_mono
        ((pCore_isPGroup (p := 2) (G := P)).le_sylow_of_normal T)
    _ = S := hTmap

private theorem omegaOneCenter_sylow_le_omegaOneCenter_twoCore
    {G : Type u} [Group G] [Finite G]
    {S P : Subgroup G}
    (hSP : IsSylowTwoIn S P)
    (hchar : Stellmacher.IsCharacteristicTwoType P) :
    omegaOneCenter S ≤ omegaOneCenter (twoCoreIn P) := by
  let Q : Subgroup G := twoCoreIn P
  have hQS : Q ≤ S := twoCoreIn_le_sylow hSP
  have hSPle : S ≤ P := hSP.1
  have hOmegaCenterS := omegaOneCenter_le_centerAmbient S
  have hOmegaQ : omegaOneCenter S ≤ Q := by
    intro x hx
    obtain ⟨s, hscenter, hsx⟩ := hOmegaCenterS hx
    have hxS : x ∈ S := by
      rw [← hsx]
      exact s.property
    let xP : P := ⟨x, hSPle hxS⟩
    have hxcentralQ : xP ∈ Subgroup.centralizer (pCore 2 P : Set P) := by
      rw [Subgroup.mem_centralizer_iff]
      intro q hq
      apply P.subtype_injective
      have hqS : (q : G) ∈ S := by
        apply hQS
        exact Subgroup.mem_map_of_mem P.subtype hq
      have hscomm := Subgroup.mem_center_iff.mp hscenter ⟨(q : G), hqS⟩
      change (q : G) * x = x * (q : G)
      rw [← hsx]
      exact congrArg Subtype.val hscomm
    have hxcore : xP ∈ pCore 2 P := hchar hxcentralQ
    exact Subgroup.mem_map_of_mem P.subtype hxcore
  have hOmegaCenterQ :
      omegaOneCenter S ≤ (Subgroup.center Q).map Q.subtype := by
    intro x hx
    let xQ : Q := ⟨x, hOmegaQ hx⟩
    have hxcenter : xQ ∈ Subgroup.center Q := by
      rw [Subgroup.mem_center_iff]
      intro q
      apply Q.subtype_injective
      have hqS : (q : G) ∈ S := hQS q.property
      obtain ⟨s, hscenter, hsx⟩ := hOmegaCenterS hx
      have hscomm := Subgroup.mem_center_iff.mp hscenter ⟨(q : G), hqS⟩
      change (q : G) * x = x * (q : G)
      rw [← hsx]
      exact congrArg Subtype.val hscomm
    exact ⟨xQ, hxcenter, rfl⟩
  exact elementaryAbelian_le_omegaOneCenter hOmegaCenterQ
    (omegaOneCenter_isElementaryAbelian S)

private noncomputable def sylowOmegaJoin
    {G : Type u} [Group G] [Finite G] (P : Subgroup G) : Subgroup G :=
  sSup {Z : Subgroup G |
    ∃ T : Sylow 2 P,
      Z = omegaOneCenter ((T : Subgroup P).map P.subtype)}

private theorem sylowAmbient_smul
    {G : Type u} [Group G] [Finite G] (P : Subgroup G)
    (T : Sylow 2 P) (g : P) :
    (((g • T : Sylow 2 P) : Subgroup P).map P.subtype) =
      (((T : Subgroup P).map P.subtype).map
        (MulAut.conj (g : G)).toMonoidHom) := by
  change (((T : Subgroup P).map
      (MulAut.conj g).toMonoidHom).map P.subtype) = _
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1

private theorem sylowOmegaJoin_map_conj
    {G : Type u} [Group G] [Finite G] (P : Subgroup G) (g : P) :
    (sylowOmegaJoin P).map (MulAut.conj (g : G)).toMonoidHom =
      sylowOmegaJoin P := by
  apply le_antisymm
  · unfold sylowOmegaJoin
    rw [sSup_eq_iSup, Subgroup.map_iSup]
    refine iSup_le fun W ↦ ?_
    rw [Subgroup.map_iSup]
    refine iSup_le fun hW ↦ ?_
    rcases hW with ⟨T, rfl⟩
    rw [← omegaOneCenter_map_equiv,
      ← sylowAmbient_smul]
    refine le_iSup_of_le
      (omegaOneCenter
        ((((g • T : Sylow 2 P) : Subgroup P).map P.subtype))) ?_
    exact le_iSup_of_le ⟨g • T, rfl⟩ le_rfl
  · unfold sylowOmegaJoin
    rw [sSup_eq_iSup]
    refine iSup_le fun W ↦ ?_
    refine iSup_le fun hW ↦ ?_
    rcases hW with ⟨T, rfl⟩
    have hgen :
        omegaOneCenter
            ((((g⁻¹ • T : Sylow 2 P) : Subgroup P).map P.subtype)) ≤
          sylowOmegaJoin P :=
      le_sSup ⟨g⁻¹ • T, rfl⟩
    have hmap :
        (omegaOneCenter
            ((((g⁻¹ • T : Sylow 2 P) : Subgroup P).map P.subtype))).map
              (MulAut.conj (g : G)).toMonoidHom ≤
          (sylowOmegaJoin P).map
              (MulAut.conj (g : G)).toMonoidHom :=
      Subgroup.map_mono hgen
    rw [← omegaOneCenter_map_equiv,
      ← sylowAmbient_smul] at hmap
    simpa [sylowOmegaJoin, sSup_eq_iSup] using hmap

private theorem sylowOmegaJoin_le
    {G : Type u} [Group G] [Finite G] (P : Subgroup G) :
    sylowOmegaJoin P ≤ P := by
  unfold sylowOmegaJoin
  rw [sSup_eq_iSup]
  refine iSup_le fun W ↦ ?_
  refine iSup_le fun hW ↦ ?_
  rcases hW with ⟨T, rfl⟩
  exact (omegaOneCenter_le_centerAmbient _).trans
    ((Subgroup.map_subtype_le _).trans (Subgroup.map_subtype_le _))

private theorem sylowOmegaJoin_normalIn
    {G : Type u} [Group G] [Finite G] (P : Subgroup G) :
    NormalIn (sylowOmegaJoin P) P := by
  refine ⟨sylowOmegaJoin_le P, ?_⟩
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer
    (sylowOmegaJoin_le P)).mpr
  intro g hg
  exact Subgroup.mem_normalizer_iff_map_conj_eq.mpr
    (sylowOmegaJoin_map_conj P ⟨g, hg⟩)

private theorem sylowOmegaJoin_le_omegaOneCenter_twoCore
    {G : Type u} [Group G] [Finite G]
    (P : Subgroup G) (hchar : Stellmacher.IsCharacteristicTwoType P) :
    sylowOmegaJoin P ≤ omegaOneCenter (twoCoreIn P) := by
  unfold sylowOmegaJoin
  rw [sSup_eq_iSup]
  refine iSup_le fun W ↦ ?_
  refine iSup_le fun hW ↦ ?_
  rcases hW with ⟨T, rfl⟩
  exact omegaOneCenter_sylow_le_omegaOneCenter_twoCore
    ⟨Subgroup.map_subtype_le _, T, rfl⟩ hchar

private theorem centralizerIntersection_normal
    {G : Type u} [Group G] [Finite G]
    {W P Z : Subgroup G} (hWP : W ≤ P)
    (hZ : NormalIn Z P) :
    ((W ⊓ Subgroup.centralizer (Z : Set G)).subgroupOf W).Normal := by
  have hWnormZ : W ≤ Subgroup.normalizer (Z : Set G) :=
    hWP.trans ((Subgroup.normal_subgroupOf_iff_le_normalizer hZ.1).mp hZ.2)
  have hNormCentralizer :
      Subgroup.normalizer (Z : Set G) ≤
        Subgroup.normalizer (Subgroup.centralizer (Z : Set G) : Set G) := by
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer
      (Subgroup.centralizer_le_normalizer (Z : Set G))).mp inferInstance
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer inf_le_left).mpr
  exact (le_inf W.le_normalizer (hWnormZ.trans hNormCentralizer)).trans
    Subgroup.inf_normalizer_le_normalizer_inf

private theorem twoResidualSubgroup_eq_hktPResidual
    {G : Type u} [Group G] [Finite G] (P : Subgroup G) :
    twoResidualSubgroup P = BenderSuzuki.External.hktPResidual 2 P := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hRnormal : (BenderSuzuki.External.hktPResidual 2 P).Normal :=
    BenderSuzuki.External.hktPResidual_normal
  let _ : (BenderSuzuki.External.hktPResidual 2 P).Normal := hRnormal
  apply le_antisymm
  · rw [twoResidualSubgroup]
    apply sInf_le
    refine ⟨hRnormal, ?_⟩
    obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := 2)).mp
      (BenderSuzuki.External.hktPResidual_quotient_isPGroup
        (q := 2) (Q := P))
    exact ⟨n, by simpa [Subgroup.index_eq_card] using hn⟩
  · intro x hx
    rw [twoResidualSubgroup, Subgroup.mem_sInf]
    intro N hN
    let _ : N.Normal := hN.1
    apply BenderSuzuki.External.hktPResidual_le N hN.1 ?_ hx
    rw [IsPGroup.iff_card]
    obtain ⟨n, hn⟩ := hN.2
    exact ⟨n, by simpa [Subgroup.index_eq_card] using hn⟩

private theorem twoResidualAmbient_sup_sylow
    {G : Type u} [Group G] [Finite G]
    {W P : Subgroup G} (hWP : IsSylowTwoIn W P) :
    twoResidualAmbient P ⊔ W = P := by
  classical
  obtain ⟨hWleP, T, hTmap⟩ := hWP
  let R : Subgroup P := BenderSuzuki.External.hktPResidual 2 P
  have hRnormal : R.Normal :=
    BenderSuzuki.External.hktPResidual_normal
  let _ : R.Normal := hRnormal
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hRTtop : R ⊔ (T : Subgroup P) = ⊤ := by
    let qR : P →* P ⧸ R := QuotientGroup.mk' R
    have hquotR : IsPGroup 2 (P ⧸ R) :=
      BenderSuzuki.External.hktPResidual_quotient_isPGroup
    let Tbar : Sylow 2 (P ⧸ R) :=
      T.mapSurjective (QuotientGroup.mk'_surjective R)
    have hTbarTop : (Tbar : Subgroup (P ⧸ R)) = ⊤ := by
      symm
      exact Tbar.is_maximal' (hquotR.to_subgroup ⊤) le_top
    have hmapT : (T : Subgroup P).map qR = ⊤ := by
      simpa [Tbar, qR] using hTbarTop
    rw [sup_comm]
    calc
      (T : Subgroup P) ⊔ R = (T : Subgroup P) ⊔ qR.ker := by
        rw [QuotientGroup.ker_mk']
      _ = ((T : Subgroup P).map qR).comap qR :=
        (Subgroup.comap_map_eq qR (T : Subgroup P)).symm
      _ = ⊤ := by rw [hmapT]; simp
  have hmapTop :
      ((R ⊔ (T : Subgroup P)).map P.subtype) = P := by
    rw [hRTtop, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  rw [Subgroup.map_sup, hTmap] at hmapTop
  change (twoResidualSubgroup P).map P.subtype ⊔ W = P
  rw [twoResidualSubgroup_eq_hktPResidual]
  exact hmapTop

private theorem omegaOneCenter_group_le_sylow
    {G : Type u} [Group G] [Finite G]
    {W P : Subgroup G} (hWP : IsSylowTwoIn W P)
    (hchar : Stellmacher.IsCharacteristicTwoType P) :
    omegaOneCenter P ≤ omegaOneCenter W := by
  have hCenterCore :
      (Subgroup.center P).map P.subtype ≤ twoCoreIn P := by
    intro x hx
    obtain ⟨z, hz, rfl⟩ := hx
    exact Subgroup.mem_map_of_mem P.subtype
      (hchar (Subgroup.center_le_centralizer (pCore 2 P : Set P) hz))
  have hOmegaW : omegaOneCenter P ≤
      (Subgroup.center W).map W.subtype := by
    intro x hx
    have hxW : x ∈ W := twoCoreIn_le_sylow hWP (hCenterCore
      (omegaOneCenter_le_centerAmbient P hx))
    let xW : W := ⟨x, hxW⟩
    have hxcenter : xW ∈ Subgroup.center W := by
      rw [Subgroup.mem_center_iff]
      intro w
      apply W.subtype_injective
      obtain ⟨z, hzcenter, hzx⟩ :=
        omegaOneCenter_le_centerAmbient P hx
      have hcomm := Subgroup.mem_center_iff.mp hzcenter
        ⟨(w : G), hWP.1 w.property⟩
      change (w : G) * x = x * (w : G)
      rw [← hzx]
      exact congrArg Subtype.val hcomm
    exact ⟨xW, hxcenter, rfl⟩
  exact elementaryAbelian_le_omegaOneCenter hOmegaW
    (omegaOneCenter_isElementaryAbelian P)

private theorem sylow_le_centralizer_omegaOneCenter
    {G : Type u} [Group G] (W : Subgroup G) :
    W ≤ Subgroup.centralizer (omegaOneCenter W : Set G) := by
  intro w hw
  rw [Subgroup.mem_centralizer_iff]
  intro z hz
  obtain ⟨zc, hzcenter, hzeq⟩ :=
    omegaOneCenter_le_centerAmbient W hz
  have hcomm := Subgroup.mem_center_iff.mp hzcenter ⟨w, hw⟩
  change z * w = w * z
  rw [← hzeq]
  exact (congrArg Subtype.val hcomm).symm

private theorem twoCore_le_centralizer_of_join_le_omega
    {G : Type u} [Group G] [Finite G]
    {P Z : Subgroup G}
    (hZ : Z ≤ omegaOneCenter (twoCoreIn P)) :
    twoCoreIn P ≤ Subgroup.centralizer (Z : Set G) := by
  intro q hq
  rw [Subgroup.mem_centralizer_iff]
  intro z hz
  obtain ⟨zc, hzcenter, hzeq⟩ :=
    omegaOneCenter_le_centerAmbient (twoCoreIn P) (hZ hz)
  have hcomm := Subgroup.mem_center_iff.mp hzcenter ⟨q, hq⟩
  change z * q = q * z
  rw [← hzeq]
  exact (congrArg Subtype.val hcomm).symm

private theorem le_centerAmbient_of_le_centralizer
    {G : Type u} [Group G] {A P : Subgroup G}
    (hAP : A ≤ P)
    (hPC : P ≤ Subgroup.centralizer (A : Set G)) :
    A ≤ (Subgroup.center P).map P.subtype := by
  intro a ha
  let aP : P := ⟨a, hAP ha⟩
  have haCenter : aP ∈ Subgroup.center P := by
    rw [Subgroup.mem_center_iff]
    intro p
    apply P.subtype_injective
    exact (Subgroup.mem_centralizer_iff.mp (hPC p.property) a ha).symm
  exact ⟨aP, haCenter, rfl⟩

private theorem sylowOmegaJoin_eq_of_normalOmega
    {G : Type u} [Group G] [Finite G]
    {W P : Subgroup G} (hWP : IsSylowTwoIn W P)
    (hNormal : NormalIn (omegaOneCenter W) P) :
    sylowOmegaJoin P = omegaOneCenter W := by
  classical
  obtain ⟨_, T, hTmap⟩ := hWP
  apply le_antisymm
  · unfold sylowOmegaJoin
    rw [sSup_eq_iSup]
    refine iSup_le fun A ↦ ?_
    refine iSup_le fun hA ↦ ?_
    rcases hA with ⟨T', rfl⟩
    obtain ⟨x, hx⟩ := MulAction.exists_smul_eq P T T'
    have hxnorm : (x : G) ∈
        Subgroup.normalizer (omegaOneCenter W : Set G) :=
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hNormal.1).mp
        hNormal.2) x.property
    have hmap := Subgroup.mem_normalizer_iff_map_conj_eq.mp hxnorm
    rw [← hx, sylowAmbient_smul, omegaOneCenter_map_equiv, hTmap]
    exact hmap.le
  · apply le_sSup
    exact ⟨T, hTmap ▸ rfl⟩

private theorem local_centralizer_alternative
    {G : Type u} [Group G] [Finite G]
    {W P : Subgroup G}
    (hSec : Stellmacher.SectionThree.Hypotheses G W)
    (hP : P ∈ PFamily (⊤ : Subgroup G) W)
    (hsolv : Group.IsSolvable P)
    (hchar : Stellmacher.IsCharacteristicTwoType P) :
    (W ⊓ Subgroup.centralizer (sylowOmegaJoin P : Set G) =
        twoCoreIn P) ∨
      (sylowOmegaJoin P = omegaOneCenter P ∧
        sylowOmegaJoin P = omegaOneCenter W) := by
  classical
  let Z : Subgroup G := sylowOmegaJoin P
  let Q : Subgroup G := twoCoreIn P
  let C : Subgroup G := Subgroup.centralizer (Z : Set G)
  let T₀ : Subgroup G := W ⊓ C
  have hWP : IsSylowTwoIn W P := hP.1.2.1
  have hQW : Q ≤ W := twoCoreIn_le_sylow hWP
  have hZomega : Z ≤ omegaOneCenter Q :=
    sylowOmegaJoin_le_omegaOneCenter_twoCore P hchar
  have hQC : Q ≤ C :=
    twoCore_le_centralizer_of_join_le_omega hZomega
  have hQT₀ : Q ≤ T₀ := le_inf hQW hQC
  have hZnormal : NormalIn Z P := sylowOmegaJoin_normalIn P
  have hT₀normal : (T₀.subgroupOf W).Normal :=
    centralizerIntersection_normal hWP.1 hZnormal
  have h34 := Stellmacher.SectionThree.lemma_three_four W hSec P
    ((pFamily_iff_pSet (⊤ : Subgroup G) W P).mp hP) T₀
    ⟨inf_le_left, hT₀normal⟩ hsolv
  rcases h34 with hT₀Q | hcomm
  · exact Or.inl (le_antisymm hT₀Q hQT₀)
  · right
    have hPnormZ : P ≤ Subgroup.normalizer (Z : Set G) :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hZnormal.1).mp
        hZnormal.2
    have hNormC : Subgroup.normalizer (Z : Set G) ≤
        Subgroup.normalizer (C : Set G) := by
      exact (Subgroup.normal_subgroupOf_iff_le_normalizer
        (Subgroup.centralizer_le_normalizer (Z : Set G))).mp inferInstance
    have hRC : twoResidualAmbient P ≤ C := by
      rw [← hcomm]
      exact (Subgroup.commutator_mono le_rfl inf_le_right).trans
        ((Subgroup.le_normalizer_iff_commutator_le_right).mp
          ((Subgroup.map_subtype_le (twoResidualSubgroup P)).trans
            (hPnormZ.trans hNormC)))
    have hP_le_CW : P ≤ C ⊔ W := by
      rw [← twoResidualAmbient_sup_sylow hWP]
      exact sup_le (hRC.trans le_sup_left) le_sup_right
    let A : Subgroup G := omegaOneCenter W
    have hAW : A ≤ W :=
      (omegaOneCenter_le_centerAmbient W).trans
        (Subgroup.map_subtype_le _)
    have hAZ : A ≤ Z := by
      apply le_sSup
      obtain ⟨_, T, hTmap⟩ := hWP
      exact ⟨T, hTmap ▸ rfl⟩
    have hCnormA : C ≤ Subgroup.normalizer (A : Set G) :=
      (Subgroup.centralizer_le hAZ).trans
        (Subgroup.centralizer_le_normalizer (A : Set G))
    have hWnormA : W ≤ Subgroup.normalizer (A : Set G) :=
      (sylow_le_centralizer_omegaOneCenter W).trans
        (Subgroup.centralizer_le_normalizer (A : Set G))
    have hPnormA : P ≤ Subgroup.normalizer (A : Set G) :=
      hP_le_CW.trans (sup_le hCnormA hWnormA)
    have hAP : A ≤ P := hAW.trans hWP.1
    have hAnormal : NormalIn A P :=
      ⟨hAP, (Subgroup.normal_subgroupOf_iff_le_normalizer hAP).mpr
        hPnormA⟩
    have hZA : Z = A := sylowOmegaJoin_eq_of_normalOmega hWP hAnormal
    have hPcentralA : P ≤ Subgroup.centralizer (A : Set G) := by
      apply hP_le_CW.trans
      exact sup_le (Subgroup.centralizer_le hAZ) (by
        simpa [A] using sylow_le_centralizer_omegaOneCenter W)
    have hAomegaP : A ≤ omegaOneCenter P :=
      elementaryAbelian_le_omegaOneCenter
        (le_centerAmbient_of_le_centralizer hAP hPcentralA)
        (omegaOneCenter_isElementaryAbelian W)
    have homegaPA : omegaOneCenter P ≤ A :=
      omegaOneCenter_group_le_sylow hWP hchar
    exact ⟨hZA.trans (le_antisymm hAomegaP homegaPA), hZA⟩

private theorem le_centralizer_of_le_centerAmbient
    {G : Type u} [Group G] {A P : Subgroup G}
    (hA : A ≤ (Subgroup.center P).map P.subtype) :
    P ≤ Subgroup.centralizer (A : Set G) := by
  rw [Subgroup.le_centralizer_iff]
  intro a ha
  rw [Subgroup.mem_centralizer_iff]
  intro p hp
  obtain ⟨ac, hacenter, haeq⟩ := hA ha
  have hcomm := Subgroup.mem_center_iff.mp hacenter ⟨p, hp⟩
  change p * a = a * p
  rw [← haeq]
  exact congrArg Subtype.val hcomm

private theorem omegaOneCenter_ne_bot_of_center_ne_bot
    {G : Type u} [Group G] [Finite G]
    (P : Subgroup G)
    (hcenterP : IsPGroup 2 (Subgroup.center P))
    (hcenter : Subgroup.center P ≠ ⊥) :
    omegaOneCenter P ≠ ⊥ := by
  let _ : Nontrivial (Subgroup.center P) :=
    (Subgroup.nontrivial_iff_ne_bot (Subgroup.center P)).2 hcenter
  obtain ⟨n, hn, hcard⟩ := hcenterP.nontrivial_iff_card.mp inferInstance
  have hdvd : 2 ∣ Nat.card (Subgroup.center P) := by
    rw [hcard]
    exact dvd_pow_self 2 (Nat.pos_iff_ne_zero.mp hn)
  have hinner := omega₁_map_subtype_ne_bot
    (G := P) (Subgroup.center P) 2 hdvd
  intro homega
  apply hinner
  apply (Subgroup.map_eq_bot_iff_of_injective
    (H := (omega₁ (G := Subgroup.center P) (p := 2)).map
      (Subgroup.center P).subtype)
    (f := P.subtype) P.subtype_injective).mp
  simpa [omegaOneCenter] using homega

private theorem local_neighbor_center_trivial
    {G : Type u} [Group G] [Finite G]
    {W P L : Subgroup G}
    (hWP : IsSylowTwoIn W P)
    (hWL : IsSylowTwoIn W L)
    (hcharL : Stellmacher.IsCharacteristicTwoType L)
    (hgenerated : P ⊔ L = ⊤)
    (hcoreG : pCore 2 G = ⊥)
    (hZeq : sylowOmegaJoin P = omegaOneCenter P) :
    Subgroup.center L = ⊥ := by
  let A : Subgroup G := omegaOneCenter L
  have hALomega : A ≤ omegaOneCenter W :=
    omegaOneCenter_group_le_sylow hWL hcharL
  have homegaWZ : omegaOneCenter W ≤ sylowOmegaJoin P := by
    apply le_sSup
    obtain ⟨_, T, hTmap⟩ := hWP
    exact ⟨T, hTmap ▸ rfl⟩
  have hAcenterP : A ≤ (Subgroup.center P).map P.subtype :=
    hALomega.trans (homegaWZ.trans_eq hZeq |>.trans
      (omegaOneCenter_le_centerAmbient P))
  have hAcenterL : A ≤ (Subgroup.center L).map L.subtype :=
    omegaOneCenter_le_centerAmbient L
  have hPC : P ≤ Subgroup.centralizer (A : Set G) :=
    le_centralizer_of_le_centerAmbient hAcenterP
  have hLC : L ≤ Subgroup.centralizer (A : Set G) :=
    le_centralizer_of_le_centerAmbient hAcenterL
  have htopC : (⊤ : Subgroup G) ≤
      Subgroup.centralizer (A : Set G) := by
    rw [← hgenerated]
    exact sup_le hPC hLC
  have hAnormal : A.Normal := by
    apply Subgroup.normalizer_eq_top_iff.mp
    exact top_unique (htopC.trans
      (Subgroup.centralizer_le_normalizer (A : Set G)))
  let _ : IsElementaryAbelian 2 A :=
    omegaOneCenter_isElementaryAbelian L
  have hAp : IsPGroup 2 A :=
    IsElementaryAbelian.isPGroup 2 A
  have hAcore : A ≤ pCore 2 G := le_sSup ⟨hAnormal, hAp⟩
  have hAbot : A = ⊥ := by
    apply le_antisymm
    · simpa [hcoreG] using hAcore
    · exact bot_le
  by_contra hcenter
  have hcenterCore : Subgroup.center L ≤ pCore 2 L :=
    (Subgroup.center_le_centralizer (pCore 2 L : Set L)).trans hcharL
  have hcenterP : IsPGroup 2 (Subgroup.center L) :=
    IsPGroup.to_le (pCore_isPGroup (p := 2) (G := L)) hcenterCore
  exact (omegaOneCenter_ne_bot_of_center_ne_bot L hcenterP hcenter) hAbot

private theorem sectionSeven_even_order
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2) :
    Even (Nat.card G) := by
  have hSp : IsPGroup 2 S := by
    obtain ⟨_, T, hTmap⟩ := h.P1_mem.1.2.1
    rw [← hTmap]
    exact T.isPGroup'.map P1.subtype
  let _ : Nontrivial S := (Subgroup.nontrivial_iff_ne_bot S).2 h.S_nontrivial
  obtain ⟨n, hn, hcard⟩ := hSp.nontrivial_iff_card.mp inferInstance
  apply even_iff_two_dvd.mpr
  apply (show 2 ∣ Nat.card S by
    rw [hcard]
    exact dvd_pow_self 2 (Nat.pos_iff_ne_zero.mp hn)).trans
  exact Subgroup.card_subgroup_dvd_card S

private theorem sectionThreeHypotheses_of_pFamily
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 W P : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2)
    (hP : P ∈ PFamily (⊤ : Subgroup G) W) :
    Stellmacher.SectionThree.Hypotheses G W := by
  have hWP : IsSylowTwoIn W P := hP.1.2.1
  have hWne : W ≠ ⊥ := by
    intro hW
    apply hP.1.2.2.1
    apply le_antisymm
    · rw [← hW]
      exact twoCoreIn_le_sylow hWP
    · exact bot_le
  have hWp : IsPGroup 2 W := by
    obtain ⟨_, T, hTmap⟩ := hWP
    rw [← hTmap]
    exact T.isPGroup'.map P.subtype
  exact
    { even_order := sectionSeven_even_order h
      nontrivial_two_subgroup := ⟨hWne, hWp⟩ }

private theorem isSylowTwoIn_inf_right
    {G : Type u} [Group G] [Finite G]
    {S P K : Subgroup G}
    (hSP : IsSylowTwoIn S P) (hSK : S ≤ K) :
    IsSylowTwoIn S (P ⊓ K) := by
  classical
  obtain ⟨hSleP, T, hTmap⟩ := hSP
  let I : Subgroup G := P ⊓ K
  let J : Subgroup P := I.subgroupOf P
  have hTJ : (T : Subgroup P) ≤ J := by
    intro t ht
    have htS : (t : G) ∈ S := by
      rw [← hTmap]
      exact Subgroup.mem_map_of_mem P.subtype ht
    exact ⟨htS |> hSleP, hSK htS⟩
  let TJ : Sylow 2 J := T.subtype hTJ
  let eJI : J ≃* I :=
    { toFun := fun x ↦ ⟨(x : G), x.property⟩
      invFun := fun x ↦ ⟨⟨(x : G), x.property.1⟩, x.property⟩
      left_inv := fun x ↦ rfl
      right_inv := fun x ↦ rfl
      map_mul' := fun x y ↦ rfl }
  let TI : Sylow 2 I :=
    TJ.mapSurjective (f := eJI.toMonoidHom) eJI.surjective
  refine ⟨?_, TI, ?_⟩
  · exact le_inf hSleP hSK
  · ext x
    constructor
    · intro hx
      obtain ⟨i, hi, rfl⟩ := hx
      change i ∈ (TJ : Subgroup J).map eJI.toMonoidHom at hi
      obtain ⟨j, hj, hji⟩ := hi
      have hjT : (j : P) ∈ T := hj
      rw [← hTmap]
      have : (i : G) = (j : G) := congrArg Subtype.val hji.symm
      exact ⟨(j : P), hjT, this.symm⟩
    · intro hx
      rw [← hTmap] at hx
      obtain ⟨t, ht, htx⟩ := hx
      have htS : (t : G) ∈ S := by
        rw [← hTmap]
        exact Subgroup.mem_map_of_mem P.subtype ht
      let j : J := ⟨t, hTJ ht⟩
      let i : I := eJI j
      refine ⟨i, ?_, ?_⟩
      · change i ∈ (TJ : Subgroup J).map eJI.toMonoidHom
        exact Subgroup.mem_map_of_mem eJI.toMonoidHom ht
      · exact htx

private theorem map_internal_ambient
    {G : Type u} [Group G]
    (e : G ≃* G) (P : Subgroup G) (T : Subgroup P) :
    let eP : P ≃* P.map e.toMonoidHom :=
      P.equivMapOfInjective e.toMonoidHom e.injective
    (T.map eP.toMonoidHom).map (P.map e.toMonoidHom).subtype =
      (T.map P.subtype).map e.toMonoidHom := by
  dsimp only
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1

private theorem isSylowTwoIn_map_equiv
    {G : Type u} [Group G] [Finite G]
    (e : G ≃* G) (S P : Subgroup G)
    (h : IsSylowTwoIn S P) :
    IsSylowTwoIn (S.map e.toMonoidHom) (P.map e.toMonoidHom) := by
  obtain ⟨hSP, T, hTmap⟩ := h
  let eP : P ≃* P.map e.toMonoidHom :=
    P.equivMapOfInjective e.toMonoidHom e.injective
  let T' : Sylow 2 (P.map e.toMonoidHom) :=
    T.mapSurjective (f := eP.toMonoidHom) eP.surjective
  refine ⟨Subgroup.map_mono hSP, T', ?_⟩
  have hT' : (T' : Subgroup (P.map e.toMonoidHom)) =
      (T : Subgroup P).map eP.toMonoidHom :=
    Sylow.coe_mapSurjective eP.surjective T
  rw [hT', map_internal_ambient, hTmap]

private theorem characteristicTwo_map_equiv
    {G : Type u} [Group G]
    (e : G ≃* G) (P : Subgroup G)
    (hchar : Stellmacher.IsCharacteristicTwoType P) :
    Stellmacher.IsCharacteristicTwoType (P.map e.toMonoidHom) := by
  let eP : P ≃* P.map e.toMonoidHom :=
    P.equivMapOfInjective e.toMonoidHom e.injective
  have hcore : (pCore 2 P).map eP.toMonoidHom =
      pCore 2 (P.map e.toMonoidHom) :=
    pCore_map_iso 2 eP
  intro y hy
  let x : P := eP.symm y
  have hxcentral : x ∈ Subgroup.centralizer (pCore 2 P : Set P) := by
    rw [Subgroup.mem_centralizer_iff]
    intro q hq
    apply eP.injective
    have heq := Subgroup.mem_centralizer_iff.mp hy (eP q)
      (hcore ▸ Subgroup.mem_map_of_mem eP.toMonoidHom hq)
    change eP (q * x) = eP (x * q)
    rw [map_mul, map_mul, show eP x = y from eP.apply_symm_apply y]
    exact heq
  have hxcore := hchar hxcentral
  have heycore : eP x ∈ pCore 2 (P.map e.toMonoidHom) := by
    rw [← hcore]
    exact Subgroup.mem_map_of_mem eP.toMonoidHom hxcore
  simpa only [x, eP.apply_symm_apply] using heycore

private theorem solvable_map_equiv
    {G : Type u} [Group G]
    (e : G ≃* G) (P : Subgroup G)
    (hsolv : Group.IsSolvable P) :
    Group.IsSolvable (P.map e.toMonoidHom) := by
  let eP : P ≃* P.map e.toMonoidHom :=
    P.equivMapOfInjective e.toMonoidHom e.injective
  let _ : Group.IsSolvable P := hsolv
  exact Group.isSolvable_of_surjective (f := eP.toMonoidHom) eP.surjective

private theorem map_conj_eq_self_of_mem
    {G : Type u} [Group G] (P : Subgroup G) (x : G) (hx : x ∈ P) :
    P.map (MulAut.conj x).toMonoidHom = P := by
  exact Subgroup.mem_normalizer_iff_map_conj_eq.mp (P.le_normalizer hx)

private theorem mem_stabilizer_iff
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G} (Gamma : CosetGraphContext G S P1 P2)
    {g : G} {d : Gamma.Vertex} :
    g ∈ stabilizer Gamma d ↔ Gamma.act g d = d := by
  have hdef : (stabilizer Gamma d : Set G) =
      {x | Gamma.act x d = d} := Gamma.stabilizer_def d
  exact Set.ext_iff.mp hdef g

private theorem stabilizer_act
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G} (Gamma : CosetGraphContext G S P1 P2)
    (g : G) (d : Gamma.Vertex) :
    stabilizer Gamma (Gamma.act g d) =
      conjugateBy (stabilizer Gamma d) g⁻¹ := by
  ext x
  rw [mem_stabilizer_iff, conjugateBy, Subgroup.mem_map_equiv,
    mem_stabilizer_iff]
  simp only [MulAut.conj_symm_apply, inv_inv]
  constructor
  · intro hx
    calc
      Gamma.act (g * x * g⁻¹) d =
          Gamma.act g⁻¹ (Gamma.act (g * x) d) := Gamma.act_mul _ _ _
      _ = Gamma.act g⁻¹ (Gamma.act x (Gamma.act g d)) := by
        rw [Gamma.act_mul]
      _ = Gamma.act g⁻¹ (Gamma.act g d) := by rw [hx]
      _ = Gamma.act (g * g⁻¹) d := (Gamma.act_mul _ _ _).symm
      _ = d := by rw [mul_inv_cancel, Gamma.act_one]
  · intro hx
    calc
      Gamma.act x (Gamma.act g d) = Gamma.act (g * x) d :=
        (Gamma.act_mul _ _ _).symm
      _ = Gamma.act g (Gamma.act (g * x * g⁻¹) d) := by
        rw [← Gamma.act_mul]
        simp [mul_assoc]
      _ = Gamma.act g d := by rw [hx]

private theorem adjacent_irrefl
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G} (Gamma : CosetGraphContext G S P1 P2)
    (d : Gamma.Vertex) : ¬ Gamma.adjacent d d := by
  rcases Gamma.coset₁_surjective d with ⟨g, hg | hg⟩
  · rw [hg]
    exact Gamma.no_adj_coset₁_coset₁ g g
  · rw [hg]
    exact Gamma.no_adj_coset₂_coset₂ g g

private theorem neighborhood_mem_adjacent
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G} (Gamma : CosetGraphContext G S P1 P2)
    {d l : Gamma.Vertex} (hl : l ∈ neighborhood Gamma d) :
    Gamma.adjacent d l := by
  have hdist : Gamma.distance d l = 1 := by
    rw [neighborhood, Gamma.neighbors_def] at hl
    simpa [Gamma.distance_symm] using hl
  rcases Gamma.distance_path d l with ⟨f, hstart, hend, hpath⟩
  have hpos : 0 < Gamma.distance d l := hdist ▸ Nat.zero_lt_one
  have hedge := hpath ⟨0, hpos⟩
  have hi : (⟨0, hpos⟩ : Fin (Gamma.distance d l)).succ =
      ⟨Gamma.distance d l, Nat.lt_succ_self (Gamma.distance d l)⟩ := by
    apply Fin.ext
    simp [hdist]
  rw [hi, hend] at hedge
  simpa [hstart] using hedge

private structure EdgeLocalData
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G} (Gamma : CosetGraphContext G S P1 P2)
    (d l : Gamma.Vertex) (W : Subgroup G) : Prop where
  first_mem : stabilizer Gamma d ∈
    PFamily (⊤ : Subgroup G) W
  second_mem : stabilizer Gamma l ∈
    PFamily (⊤ : Subgroup G) W
  first_solvable : Group.IsSolvable (stabilizer Gamma d)
  second_solvable : Group.IsSolvable (stabilizer Gamma l)
  first_characteristicTwo :
    Stellmacher.IsCharacteristicTwoType (stabilizer Gamma d)
  second_characteristicTwo :
    Stellmacher.IsCharacteristicTwoType (stabilizer Gamma l)
  generated : stabilizer Gamma d ⊔ stabilizer Gamma l = ⊤

private theorem edgeLocalData_of_map
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 B1 B2 : Subgroup G}
    (_h : SectionSevenHypotheses G S P1 P2)
    (Gamma : CosetGraphContext G S P1 P2)
    {d l : Gamma.Vertex}
    (e : G ≃* G)
    (hB1 : B1 ∈ PFamily (⊤ : Subgroup G) S)
    (hB2 : B2 ∈ PFamily (⊤ : Subgroup G) S)
    (hB1solv : Group.IsSolvable B1)
    (hB2solv : Group.IsSolvable B2)
    (hB1char : Stellmacher.IsCharacteristicTwoType B1)
    (hB2char : Stellmacher.IsCharacteristicTwoType B2)
    (hgen : B1 ⊔ B2 = ⊤)
    (hfirst : stabilizer Gamma d = B1.map e.toMonoidHom)
    (hsecond : stabilizer Gamma l = B2.map e.toMonoidHom)
    (T : Sylow 2 ↥(stabilizer Gamma d ⊓ stabilizer Gamma l)) :
    EdgeLocalData Gamma d l
      (sylowTwoAmbient (stabilizer Gamma d ⊓ stabilizer Gamma l) T) := by
  classical
  let W : Subgroup G :=
    sylowTwoAmbient (stabilizer Gamma d ⊓ stabilizer Gamma l) T
  let U : Subgroup G := S.map e.toMonoidHom
  have hSleB2 : S ≤ B2 := hB2.1.2.1.1
  have hSbase : IsSylowTwoIn S (B1 ⊓ B2) :=
    isSylowTwoIn_inf_right hB1.1.2.1 hSleB2
  have hUedge0 := isSylowTwoIn_map_equiv e S (B1 ⊓ B2) hSbase
  have hMapInf : (B1 ⊓ B2).map e.toMonoidHom =
      stabilizer Gamma d ⊓ stabilizer Gamma l := by
    rw [Subgroup.map_inf B1 B2 e.toMonoidHom e.injective,
      ← hfirst, ← hsecond]
  have hUedge : IsSylowTwoIn U
      (stabilizer Gamma d ⊓ stabilizer Gamma l) := by
    rw [hMapInf] at hUedge0
    exact hUedge0
  obtain ⟨_, TU, hTUmap⟩ := hUedge
  obtain ⟨x, hx⟩ := MulAction.exists_smul_eq
    (↥(stabilizer Gamma d ⊓ stabilizer Gamma l)) TU T
  have hUmap : U.map (MulAut.conj (x : G)).toMonoidHom = W := by
    calc
      U.map (MulAut.conj (x : G)).toMonoidHom =
          ((((TU : Subgroup
            ↥(stabilizer Gamma d ⊓ stabilizer Gamma l)).map
              (stabilizer Gamma d ⊓ stabilizer Gamma l).subtype)).map
                (MulAut.conj (x : G)).toMonoidHom) := by rw [hTUmap]
      _ = (((x • TU : Sylow 2
            ↥(stabilizer Gamma d ⊓ stabilizer Gamma l)) : Subgroup
              ↥(stabilizer Gamma d ⊓ stabilizer Gamma l)).map
                (stabilizer Gamma d ⊓ stabilizer Gamma l).subtype) :=
          (sylowAmbient_smul
            (stabilizer Gamma d ⊓ stabilizer Gamma l) TU x).symm
      _ = W := by rw [hx]; rfl
  have hMapped1 : B1.map e.toMonoidHom ∈
      PFamily (⊤ : Subgroup G) U := by
    have hm := (pFamily_map_equiv_iff e (⊤ : Subgroup G) S B1).mpr hB1
    simpa [U, Subgroup.map_top_of_surjective e.toMonoidHom e.surjective] using hm
  have hMapped2 : B2.map e.toMonoidHom ∈
      PFamily (⊤ : Subgroup G) U := by
    have hm := (pFamily_map_equiv_iff e (⊤ : Subgroup G) S B2).mpr hB2
    simpa [U, Subgroup.map_top_of_surjective e.toMonoidHom e.surjective] using hm
  have hxfirst : (x : G) ∈ stabilizer Gamma d := x.property.1
  have hxsecond : (x : G) ∈ stabilizer Gamma l := x.property.2
  have hfirstFixed := map_conj_eq_self_of_mem
    (stabilizer Gamma d) (x : G) hxfirst
  have hsecondFixed := map_conj_eq_self_of_mem
    (stabilizer Gamma l) (x : G) hxsecond
  have hfirstW : stabilizer Gamma d ∈
      PFamily (⊤ : Subgroup G) W := by
    rw [← hfirst] at hMapped1
    have hm := (pFamily_map_equiv_iff (MulAut.conj (x : G))
      (⊤ : Subgroup G) U (stabilizer Gamma d)).mpr hMapped1
    rw [Subgroup.map_top_of_surjective
        (MulAut.conj (x : G)).toMonoidHom (MulAut.conj (x : G)).surjective,
      hUmap, hfirstFixed] at hm
    exact hm
  have hsecondW : stabilizer Gamma l ∈
      PFamily (⊤ : Subgroup G) W := by
    rw [← hsecond] at hMapped2
    have hm := (pFamily_map_equiv_iff (MulAut.conj (x : G))
      (⊤ : Subgroup G) U (stabilizer Gamma l)).mpr hMapped2
    rw [Subgroup.map_top_of_surjective
        (MulAut.conj (x : G)).toMonoidHom (MulAut.conj (x : G)).surjective,
      hUmap, hsecondFixed] at hm
    exact hm
  refine
    { first_mem := hfirstW
      second_mem := hsecondW
      first_solvable := ?_
      second_solvable := ?_
      first_characteristicTwo := ?_
      second_characteristicTwo := ?_
      generated := ?_ }
  · rw [hfirst]
    exact solvable_map_equiv e B1 hB1solv
  · rw [hsecond]
    exact solvable_map_equiv e B2 hB2solv
  · rw [hfirst]
    exact characteristicTwo_map_equiv e B1 hB1char
  · rw [hsecond]
    exact characteristicTwo_map_equiv e B2 hB2char
  · rw [hfirst, hsecond, ← Subgroup.map_sup, hgen]
    exact Subgroup.map_top_of_surjective e.toMonoidHom e.surjective

private theorem edgeLocalData
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2)
    (Gamma : CosetGraphContext G S P1 P2)
    {d l : Gamma.Vertex} (hl : l ∈ neighborhood Gamma d)
    (T : Sylow 2 ↥(stabilizer Gamma d ⊓ stabilizer Gamma l)) :
    EdgeLocalData Gamma d l
      (sylowTwoAmbient (stabilizer Gamma d ⊓ stabilizer Gamma l) T) := by
  let r := lemma_seven_one h Gamma
  obtain ⟨a, b, hab, ha, hb⟩ := r.distinguished_edge
  have hdl : Gamma.adjacent d l := neighborhood_mem_adjacent Gamma hl
  obtain ⟨g, hg | hg⟩ := r.edge_not_vertex_transitive.1 hab hdl
  · let e : G ≃* G := MulAut.conj g⁻¹
    have hfirst : stabilizer Gamma d = P1.map e.toMonoidHom := by
      calc
        stabilizer Gamma d = stabilizer Gamma (Gamma.act g a) := by rw [hg.1]
        _ = conjugateBy (stabilizer Gamma a) g⁻¹ := stabilizer_act Gamma g a
        _ = P1.map e.toMonoidHom := by rw [ha]; rfl
    have hsecond : stabilizer Gamma l = P2.map e.toMonoidHom := by
      calc
        stabilizer Gamma l = stabilizer Gamma (Gamma.act g b) := by rw [hg.2]
        _ = conjugateBy (stabilizer Gamma b) g⁻¹ := stabilizer_act Gamma g b
        _ = P2.map e.toMonoidHom := by rw [hb]; rfl
    exact edgeLocalData_of_map h Gamma e h.P1_mem h.P2_mem
      h.P1_solvable h.P2_solvable h.P1_characteristicTwo
      h.P2_characteristicTwo h.generated hfirst hsecond T
  · let e : G ≃* G := MulAut.conj g⁻¹
    have hfirst : stabilizer Gamma d = P2.map e.toMonoidHom := by
      calc
        stabilizer Gamma d = stabilizer Gamma (Gamma.act g b) := by rw [hg.2]
        _ = conjugateBy (stabilizer Gamma b) g⁻¹ := stabilizer_act Gamma g b
        _ = P2.map e.toMonoidHom := by rw [hb]; rfl
    have hsecond : stabilizer Gamma l = P1.map e.toMonoidHom := by
      calc
        stabilizer Gamma l = stabilizer Gamma (Gamma.act g a) := by rw [hg.1]
        _ = conjugateBy (stabilizer Gamma a) g⁻¹ := stabilizer_act Gamma g a
        _ = P1.map e.toMonoidHom := by rw [ha]; rfl
    exact edgeLocalData_of_map h Gamma e h.P2_mem h.P1_mem
      h.P2_solvable h.P1_solvable h.P2_characteristicTwo
      h.P1_characteristicTwo (by rw [sup_comm, h.generated])
      hfirst hsecond T

/-- Vertex stabilizers inherit solvability from the local edge data. -/
public theorem stabilizer_solvable_of_neighbor
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2)
    (Gamma : CosetGraphContext G S P1 P2)
    {d l : Gamma.Vertex} (hl : l ∈ neighborhood Gamma d) :
    Group.IsSolvable (stabilizer Gamma d) := by
  let T : Sylow 2 ↥(stabilizer Gamma d ⊓ stabilizer Gamma l) := default
  exact (edgeLocalData h Gamma hl T).first_solvable

/-- The Section 3 local data transported to an arbitrary edge Sylow subgroup.
This is the shared input for primitive extraction in (7.8). -/
public theorem edge_sectionThree_data
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2)
    (Gamma : CosetGraphContext G S P1 P2)
    {d l : Gamma.Vertex} (hl : l ∈ neighborhood Gamma d)
    (T : Sylow 2 ↥(stabilizer Gamma d ⊓ stabilizer Gamma l)) :
    let W := sylowTwoAmbient (stabilizer Gamma d ⊓ stabilizer Gamma l) T
    Stellmacher.SectionThree.Hypotheses G W ∧
      stabilizer Gamma d ∈ Stellmacher.SectionThree.PSet (⊤ : Subgroup G) W ∧
      stabilizer Gamma l ∈ Stellmacher.SectionThree.PSet (⊤ : Subgroup G) W ∧
      Group.IsSolvable (stabilizer Gamma d) ∧
      stabilizer Gamma d ⊔ stabilizer Gamma l = ⊤ ∧
      NormalIn (z Gamma l) (stabilizer Gamma l) := by
  have hd := edgeLocalData h Gamma hl T
  refine ⟨sectionThreeHypotheses_of_pFamily h hd.first_mem,
    (pFamily_iff_pSet _ _ _).mp hd.first_mem,
    (pFamily_iff_pSet _ _ _).mp hd.second_mem, hd.first_solvable, hd.generated, ?_⟩
  rw [z, Gamma.zAt_def]
  exact sylowOmegaJoin_normalIn (stabilizer Gamma l)

public structure LemmaSevenThreeConclusion
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G}
    (Gamma : CosetGraphContext G S P1 P2) : Prop where
  sylow_and_core :
    ∀ d l, l ∈ neighborhood Gamma d →
      ∀ T : Sylow 2 ↥(stabilizer Gamma d ⊓ stabilizer Gamma l),
        IsSylowTwoIn
            (sylowTwoAmbient (stabilizer Gamma d ⊓ stabilizer Gamma l) T)
            (stabilizer Gamma d) ∧
          IsSylowTwoIn
            (sylowTwoAmbient (stabilizer Gamma d ⊓ stabilizer Gamma l) T)
            (stabilizer Gamma l) ∧
          q Gamma d ≤ stabilizer Gamma l
  center_core :
    ∀ d l, l ∈ neighborhood Gamma d →
      z Gamma d ≤ omegaOneCenter (q Gamma d)
  centralizer_alternative :
    ∀ d l, l ∈ neighborhood Gamma d →
      ∀ T : Sylow 2 ↥(stabilizer Gamma d ⊓ stabilizer Gamma l),
        (sylowTwoAmbient (stabilizer Gamma d ⊓ stabilizer Gamma l) T ⊓
            Subgroup.centralizer (z Gamma d : Set G) = q Gamma d) ∨
          (z Gamma d = omegaOneCenter (stabilizer Gamma d) ∧
            z Gamma d = omegaOneCenter
              (sylowTwoAmbient (stabilizer Gamma d ⊓ stabilizer Gamma l) T))
  center_neighbor_trivial :
    ∀ d l, l ∈ neighborhood Gamma d →
      z Gamma d = omegaOneCenter (stabilizer Gamma d) →
        Subgroup.center (stabilizer Gamma l) = ⊥

/-- If the omega-center of a Sylow subgroup is normal in a vertex stabilizer,
its conjugate join defining the vertex center is that same subgroup. -/
public theorem z_eq_omega_sylow_of_normal
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G} (Gamma : CosetGraphContext G S P1 P2)
    (d : Gamma.Vertex) (hS : IsSylowTwoIn S (stabilizer Gamma d))
    (hNormal : NormalIn (omegaOneCenter S) (stabilizer Gamma d)) :
    z Gamma d = omegaOneCenter S := by
  rw [z, Gamma.zAt_def]
  exact sylowOmegaJoin_eq_of_normalOmega hS hNormal

/-- **Stellmacher (7.3).**  Sylow, center, and centralizer properties along
an edge of the coset graph. -/
public theorem lemma_seven_three
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2)
    (Gamma : CosetGraphContext G S P1 P2) :
    LemmaSevenThreeConclusion Gamma := by
  classical
  refine
    { sylow_and_core := ?_
      center_core := ?_
      centralizer_alternative := ?_
      center_neighbor_trivial := ?_ }
  · intro d l hl T
    let W : Subgroup G :=
      sylowTwoAmbient (stabilizer Gamma d ⊓ stabilizer Gamma l) T
    have hd := edgeLocalData h Gamma hl T
    have hQW : q Gamma d ≤ W := by
      rw [q, Gamma.twoCoreAt_def]
      exact twoCoreIn_le_sylow hd.first_mem.1.2.1
    exact ⟨hd.first_mem.1.2.1, hd.second_mem.1.2.1,
      hQW.trans hd.second_mem.1.2.1.1⟩
  · intro d l hl
    let T : Sylow 2 ↥(stabilizer Gamma d ⊓ stabilizer Gamma l) := default
    have hd := edgeLocalData h Gamma hl T
    rw [z, Gamma.zAt_def, q, Gamma.twoCoreAt_def]
    exact sylowOmegaJoin_le_omegaOneCenter_twoCore
      (stabilizer Gamma d) hd.first_characteristicTwo
  · intro d l hl T
    have hd := edgeLocalData h Gamma hl T
    have halt := local_centralizer_alternative
      (sectionThreeHypotheses_of_pFamily h hd.first_mem)
      hd.first_mem hd.first_solvable hd.first_characteristicTwo
    rw [z, Gamma.zAt_def, q, Gamma.twoCoreAt_def]
    exact halt
  · intro d l hl hcenter
    let T : Sylow 2 ↥(stabilizer Gamma d ⊓ stabilizer Gamma l) := default
    have hd := edgeLocalData h Gamma hl T
    have hZeq : sylowOmegaJoin (stabilizer Gamma d) =
        omegaOneCenter (stabilizer Gamma d) := by
      change Gamma.zAt d = omegaOneCenter (stabilizer Gamma d) at hcenter
      rw [Gamma.zAt_def] at hcenter
      exact hcenter
    exact local_neighbor_center_trivial
      hd.first_mem.1.2.1 hd.second_mem.1.2.1
      hd.second_characteristicTwo hd.generated h.twoCore_eq_bot hZeq

end Stellmacher.SectionsFiveToSeven
