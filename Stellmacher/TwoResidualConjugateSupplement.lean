module
public import Stellmacher.SectionThree.PrimitiveDihedralExtraction.Quotient
public import Theory.GroupTheory.NormalNilpotentConjugateGenerator

/-!
# A conjugate generator supplements the two-residual

If a finite group is generated by a subgroup A and one of its ambient
conjugates, then A together with the two-residual generates the whole group.
This is the residual supplement needed in the selected residual-core argument
between (5) and (6) of Stellmacher (8.4), Journal of Algebra 190 (1997), p.39.

Pass to the two-group quotient by the two-residual. The images of A and its
conjugate still generate the quotient. The normal-nilpotent conjugate-generator
theorem, applied with the entire quotient as its nilpotent normal subgroup,
forces the conjugate image to be the whole quotient. Conjugation preserves
top, so the image of A is also top. Taking its inverse image gives the claimed
supplement with the actual two-residual kernel.
-/

namespace Stellmacher
open BenderSuzuki.External

/-- A subgroup that generates the group with a conjugate supplements its two-residual. -/
public theorem twoResidualAmbient_top_sup_of_conjugate_generation
    {G : Type*} [Group G] [Finite G]
    (A : Subgroup G) (x : G) (hgen : A ⊔ A.conjBy x = ⊤) :
    twoResidualAmbient (⊤ : Subgroup G) ⊔ A = ⊤ := by
  classical
  let R := hktPResidual 2 G
  let : R.Normal := hktPResidual_normal
  let q := QuotientGroup.mk' R
  let Abar := A.map q
  let c := (MulAut.conj (q x)).toMonoidHom
  have hmapConj : (A.conjBy x).map q = Abar.conjBy (q x) := by
    simp only [Abar, Subgroup.conjBy, Subgroup.map_map]
    have heq : q.comp (MulAut.conj x).toMonoidHom = c.comp q := by
      ext y
      simp [c]
    exact congrArg (fun f => A.map f) heq
  have hgenbar : Abar ⊔ Abar.conjBy (q x) = ⊤ := by
    rw [← hmapConj, ← Subgroup.map_sup, hgen, ← MonoidHom.range_eq_map]
    exact q.range_eq_top_of_surjective (QuotientGroup.mk'_surjective R)
  let : Group.IsNilpotent (G ⧸ R) :=
    (hktPResidual_quotient_isPGroup (q := 2) (Q := G)).isNilpotent
  have hconjtop : Abar.conjBy (q x) = ⊤ :=
    Subgroup.eq_top_of_conjugate_normal_nilpotent_generator_le
      ⊤ Abar (Abar.conjBy (q x)) inferInstance inferInstance le_top hgenbar (q x) le_rfl
  have hAtop : Abar = ⊤ := by
    apply Subgroup.map_injective (f := c) (MulAut.conj (q x)).injective
    change Abar.conjBy (q x) = (⊤ : Subgroup (G ⧸ R)).map c
    rw [hconjtop, ← MonoidHom.range_eq_map]
    exact (c.range_eq_top_of_surjective (MulAut.conj (q x)).surjective).symm
  have hlift := congrArg (Subgroup.comap q) hAtop
  change (A.map q).comap q = (⊤ : Subgroup (G ⧸ R)).comap q at hlift
  rw [Subgroup.comap_map_eq, Subgroup.comap_top] at hlift
  rw [SectionThree.twoResidualAmbient_top_eq_hktPResidual, sup_comm]
  simpa [q, R, QuotientGroup.ker_mk'] using hlift

end Stellmacher
