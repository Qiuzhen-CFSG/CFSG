module

public import Stellmacher.SectionsOneToFourDefs

/-!
# A residual commutator from generation modulo a normal subgroup

Let `Q` be a 2-subgroup of a finite group.  If `Q` commutes with a subgroup
`F` modulo a normal subgroup `Z`, and `F` together with `Q` generates the
ambient group, then `[Q,O²(G)]` lies in `Z`.

Indeed, `D=FZ` is normalized by both `D` and `Q`, hence is normal.  The
quotient `G/D` is generated by the image of the 2-group `Q`, so it is a
2-group.  The defining intersection for `O²(G)` lies in `D`, after which the
original commutator bound gives the result.

This is the graph-free finite-group reduction used in the first containment
of Stellmacher, *Pushing up*, Arch. Math. 46 (1986), (3.2)(a), journal p.14.
-/

open scoped Pointwise

namespace Stellmacher

universe u

private theorem residual_le_normal_sup_pGroup
    {G : Type u} [Group G] [Finite G]
    (D C : Subgroup G) (hDnormal : D.Normal)
    (hC2 : IsPGroup 2 C) (hgen : D ⊔ C = ⊤) :
    twoResidualAmbient (⊤ : Subgroup G) ≤ D := by
  let _ : D.Normal := hDnormal
  let q : G →* G ⧸ D := QuotientGroup.mk' D
  have hCmap : C.map q = ⊤ := by
    have hmap := congrArg (fun K : Subgroup G ↦ K.map q) hgen
    rw [Subgroup.map_sup] at hmap
    have hDmap : D.map q = ⊥ := by
      apply (Subgroup.map_eq_bot_iff (f := q) (H := D)).2
      simp [q, QuotientGroup.ker_mk']
    have htopmap : (⊤ : Subgroup G).map q = ⊤ := by
      simpa [MonoidHom.range_eq_map] using
        (MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective D) :
          q.range = ⊤)
    simpa [hDmap, htopmap] using hmap
  have hquot2 : IsPGroup 2 (G ⧸ D) := by
    have htop2 : IsPGroup 2 (⊤ : Subgroup (G ⧸ D)) := by
      rw [← hCmap]
      exact hC2.map q
    exact htop2.of_equiv Subgroup.topEquiv
  obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := 2)).mp hquot2
  let Dtop : Subgroup (⊤ : Subgroup G) := D.subgroupOf ⊤
  have hDtopNormal : Dtop.Normal := hDnormal.subgroupOf ⊤
  have hDtopIndex : Dtop.index = 2 ^ n := by
    calc
      Dtop.index = D.relIndex ⊤ := rfl
      _ = D.index := Subgroup.relIndex_top_right D
      _ = Nat.card (G ⧸ D) := Subgroup.index_eq_card D
      _ = 2 ^ n := hn
  have hresDtop : twoResidualSubgroup (⊤ : Subgroup G) ≤ Dtop :=
    sInf_le ⟨hDtopNormal, n, hDtopIndex⟩
  intro x hx
  obtain ⟨y, hy, rfl⟩ := hx
  exact hresDtop hy

private theorem commutator_sup_right_le_normal
    {G : Type u} [Group G]
    (Q F Z : Subgroup G) (hZnormal : Z.Normal)
    (hQF : ⁅Q, F⁆ ≤ Z) : ⁅Q, F ⊔ Z⁆ ≤ Z := by
  let _ : Z.Normal := hZnormal
  let q : G →* G ⧸ Z := QuotientGroup.mk' Z
  have hZmap : Z.map q = ⊥ := by
    apply (Subgroup.map_eq_bot_iff (f := q) (H := Z)).2
    simp [q, QuotientGroup.ker_mk']
  have hQFmap : ⁅Q.map q, F.map q⁆ = ⊥ := by
    rw [← Subgroup.map_commutator]
    apply le_bot_iff.mp
    exact (Subgroup.map_mono hQF).trans (le_of_eq hZmap)
  have hmappedBot : (⁅Q, F ⊔ Z⁆).map q = ⊥ := by
    rw [Subgroup.map_commutator, Subgroup.map_sup, hZmap, sup_bot_eq,
      hQFmap]
  have hker :=
    (Subgroup.map_eq_bot_iff (f := q) (H := ⁅Q, F ⊔ Z⁆)).mp hmappedBot
  simpa [q, QuotientGroup.ker_mk'] using hker

/-- If a 2-subgroup and a second subgroup generate modulo a normal subgroup
on which their commutator vanishes, then the 2-residual has the same
commutator bound. -/
public theorem residual_commutator_le_of_generated_modulo
    {G : Type u} [Group G] [Finite G]
    (Q F Z : Subgroup G)
    (hZnormal : Z.Normal) (hQ2 : IsPGroup 2 Q)
    (hQF : ⁅Q, F⁆ ≤ Z) (hFQ : F ⊔ Q = ⊤) :
    ⁅Q, twoResidualAmbient (⊤ : Subgroup G)⁆ ≤ Z := by
  let D : Subgroup G := F ⊔ Z
  have hQD : ⁅Q, D⁆ ≤ Z := by
    simpa [D] using commutator_sup_right_le_normal Q F Z hZnormal hQF
  have hQnormD : Q ≤ Subgroup.normalizer (D : Set G) := by
    rw [Subgroup.le_normalizer_iff_commutator_le_right]
    exact hQD.trans (le_sup_right : Z ≤ F ⊔ Z)
  have hDQtop : D ⊔ Q = ⊤ := by
    apply top_unique
    rw [← hFQ]
    exact sup_le (le_sup_left.trans le_sup_left) le_sup_right
  have hDnormal : D.Normal := by
    rw [← Subgroup.normalizer_eq_top_iff]
    apply top_unique
    rw [← hDQtop]
    exact sup_le D.le_normalizer hQnormD
  have hresD : twoResidualAmbient (⊤ : Subgroup G) ≤ D :=
    residual_le_normal_sup_pGroup D Q hDnormal hQ2 hDQtop
  exact (Subgroup.commutator_mono le_rfl hresD).trans hQD

end Stellmacher
