module
public import Stellmacher.SectionTwo.TwoFourGeneratingCoordinate
public import Theory.GroupTheory.NormalClosureSelectedModule

/-!
# A generating coordinate with a spanning original module

Keep a specified SL2(2) factor family in the quotient and its corresponding
modules W_i inside a normal module V. Suppose B is Sylow in normal L,
LS=G, and the ambient Sylow has a unique maximal overgroup. If V is
normally generated by Z centralizing S, V is contained in [V,G], and L
normalizes every W_i, some generating coordinate lift K has a selected
module whose S-conjugates generate V.

The full-image coordinate lift retains K, its Sylow and the selected index.
Its image lies in D_i joined with the Sylow image, so G is generated by
S and the preimage of D_i. The selected-module normal-closure criterion
then proves the spanning equality. No arbitrary-factor permutation is used.
This is the one-module spanning assertion in Stellmacher (4.6), journal
p26; refs/latex/stellmacher-n-group.tex.
-/

namespace Stellmacher.SectionTwo
universe u

public theorem exists_generating_coordinate_with_spanning
    {G X : Type u} [Group G] [Finite G] [Group X] [Finite X]
    (hsolv : Group.IsSolvable G) (S : Sylow 2 G)
    (Z V B L : Subgroup G) [V.Normal] [L.Normal]
    (PL : Sylow 2 L) (hPL : PL.map L.subtype = B)
    (hgen : L ⊔ (S : Subgroup G) = ⊤)
    (hunique : IsUniqueMaximalContaining (S : Subgroup G) (⊤ : Subgroup G))
    (q : G →* X) (hq : Function.Surjective q)
    (hBne : B.map q ≠ ⊥)
    (hBinf : B.map q = ((S : Subgroup G).map q) ⊓ L.map q)
    {n : ℕ} (D : Fin n → Subgroup X) (W : Fin n → Subgroup G)
    (hprod : IsInternalDirectProductFamily (L.map q) D)
    (hSL : ∀ i, IsSL2Two (D i))
    (hW : ∀ i, W i = ambientCommutator ((D i).comap q) V)
    (hWV : ∀ i, W i ≤ V)
    (hLW : ∀ i, L ≤ Subgroup.normalizer (W i : Set G))
    (hZV : Z ≤ V) (hV : V = Subgroup.normalClosure (Z : Set G))
    (hZS : Z ≤ Subgroup.centralizer (S : Set G))
    (hcomm : V ≤ ⁅V, (⊤ : Subgroup G)⁆) :
    ∃ (K : Subgroup G) (PK : Sylow 2 K) (i : Fin n),
      B ≤ K ∧ K ≤ L ∧ PK.map K.subtype = B ∧
      IsSL2Two ((K ⧸ pCore 2 K) ⧸ frattini (K ⧸ pCore 2 K)) ∧
      K ⊔ (S : Subgroup G) = ⊤ ∧
      K.map q = D i ⊔ ⨆ j : {j : Fin n // j ≠ i}, ((S : Subgroup G).map q) ⊓ D j ∧
      V = ⨆ s : S, (W i).map (MulAut.conj (s : G)).toMonoidHom := by
  let T := S.mapSurjective hq
  have hEn : (L.map q).Normal := Subgroup.Normal.map inferInstance q hq
  obtain ⟨K, PK, i, hBK, hKL, hPK, hKA, hKS, hKimage⟩ :=
    exists_generating_coordinate_frattini_lift_with_image hsolv S T q hq
      (B.map q) (L.map q) B L PL hPL rfl hBinf hBne rfl hgen hunique hEn D hprod hSL
  have hKmap : K.map q ≤ D i ⊔ (S : Subgroup G).map q := by
    rw [hKimage]
    exact sup_le le_sup_left ((iSup_le fun _ => inf_le_left).trans le_sup_right)
  have hmap : K.map q ≤ (((D i).comap q) ⊔ (S : Subgroup G)).map q := by
    rwa [Subgroup.map_sup, Subgroup.map_comap_eq_self_of_surjective hq]
  have hker : q.ker ≤ (D i).comap q ⊔ (S : Subgroup G) :=
    ((D i).ker_le_comap q).trans le_sup_left
  have hKle : K ≤ (D i).comap q ⊔ (S : Subgroup G) := by
    have hh := Subgroup.map_le_map_iff.mp hmap
    rwa [sup_eq_left.mpr hker] at hh
  have hAS : (D i).comap q ⊔ (S : Subgroup G) = ⊤ := by
    apply top_unique
    rw [← hKS]
    exact sup_le hKle le_sup_right
  refine ⟨K, PK, i, hBK, hKL, hPK, hKA, hKS, hKimage, ?_⟩
  apply Subgroup.eq_iSup_conjugates_of_selected_module Z V (W i) ((D i).comap q) L
    (S : Subgroup G) hZV hV hZS hcomm (hWV i) hAS ?_ hgen (hLW i)
  rw [hW i]
  exact le_of_eq (Subgroup.commutator_comm V ((D i).comap q))

end Stellmacher.SectionTwo
