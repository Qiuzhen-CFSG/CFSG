module

public import Stellmacher.SectionTwo.TwoFourGeneratingCoordinate
public import Stellmacher.SectionTwo.LemmaTwoThree
public import Stellmacher.BaumannNormalizer

/-!
# The local Frattini `SL₂(2)` factor in Stellmacher (2.4)

This module extracts the subgroup `L₁` used in Stellmacher (2.4), Journal of
Algebra 190 (1997), p. 20.  In the faithful quotient by `C_G(V)`, result (2.2)
writes the normal subgroup generated by the Thompson image as an internal
product of `SL₂(2)` factors.  Result (2.3) makes the Baumann subgroup `B` a
Sylow 2-subgroup of its normal closure `L`.  The generating-coordinate theorem
then lifts one factor back to a subgroup `B ≤ L₁ ≤ L`, preserves the Sylow
image, and supplies the exact nested quotient
`(L₁/O₂(L₁))/Φ(L₁/O₂(L₁)) ≅ SL₂(2)`.

Two source-local inputs are made explicit.  Mapping the Thompson normal closure
identifies `L/C_L(V)` with the selected factor product.  Also `L ∨ S = G`:
if `B` were normal, the core-centralizer equality would force `V` to centralize
`J(S)`; otherwise Frattini's argument and the unique maximal overgroup of `S`
force the join to be top.  The conclusion deliberately keeps the nested
Frattini quotient.  The journal has the more general odd-dihedral lift
`L₁/O₂(L₁) ≅ D_{2·3^n}`; the stronger un-Frattini `SL₂(2)` quotient is neither
assumed nor asserted here.
-/

namespace Stellmacher.SectionTwo

universe u

private theorem le_unique_maximal_ambient'
    {G : Type u} [Group G] [Finite G]
    {S K : Subgroup G} {M : Subgroup (⊤ : Subgroup G)}
    (huniq : ∀ M' : Subgroup (⊤ : Subgroup G), IsCoatom M' →
      S ≤ M'.map (⊤ : Subgroup G).subtype → M' = M)
    (hSK : S ≤ K) (hKne : K ≠ ⊤) :
    K ≤ M.map (⊤ : Subgroup G).subtype := by
  let _ : Finite (⊤ : Subgroup G) := Subtype.finite
  have hKsub_ne : K.subgroupOf (⊤ : Subgroup G) ≠ ⊤ := by
    intro htop
    apply hKne
    rw [← Subgroup.map_subgroupOf_eq_of_le
      (show K ≤ (⊤ : Subgroup G) from le_top), htop,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  obtain ⟨M', hM'coat, hKM'⟩ :=
    (eq_top_or_exists_le_coatom (K.subgroupOf (⊤ : Subgroup G))).resolve_left hKsub_ne
  have hSM' : S ≤ M'.map (⊤ : Subgroup G).subtype := by
    rw [← Subgroup.map_subgroupOf_eq_of_le
      (show K ≤ (⊤ : Subgroup G) from le_top)] at hSK
    exact hSK.trans (Subgroup.map_mono hKM')
  rw [← huniq M' hM'coat hSM']
  rw [← Subgroup.map_subgroupOf_eq_of_le
    (show K ≤ (⊤ : Subgroup G) from le_top)]
  exact Subgroup.map_mono hKM'

private theorem baumann_normalClosure_sup_sylow_eq_top
    {G : Type u} [Group G] [Finite G]
    (S : Sylow 2 G) (B L : Subgroup G)
    (hB : B = (S : Subgroup G) ⊓ Subgroup.centralizer
      (omegaOneCenterAmbient
        (elementaryAbelianMaxJ (S : Subgroup G)) : Set G))
    (hcore : pCore 2 G =
      (S : Subgroup G) ⊓ Subgroup.centralizer (vSubgroup S : Set G))
    (hnot : ¬ vSubgroup S ≤
      Subgroup.centralizer
        (elementaryAbelianMaxJ (S : Subgroup G) : Set G))
    (hunique : IsUniqueMaximalContaining (S : Subgroup G) (⊤ : Subgroup G))
    (hLnormal : L.Normal) (P : Sylow 2 L)
    (hPmap : P.map L.subtype = B) :
    L ⊔ (S : Subgroup G) = ⊤ := by
  classical
  let _ : L.Normal := hLnormal
  let J := elementaryAbelianMaxJ (S : Subgroup G)
  have hJS : J ≤ (S : Subgroup G) := sSup_le fun _ hA ↦ hA.1
  have hJB : J ≤ B := by
    rw [hB]
    refine le_inf hJS ?_
    intro j hj
    rw [Subgroup.mem_centralizer_iff]
    intro z hz
    exact ((mem_omegaOneCenterAmbient_iff _ _).mp hz).2.2 j hj |>.symm
  have hBS : B ≤ (S : Subgroup G) := hB ▸ inf_le_left
  have hBp : IsPGroup 2 B := S.isPGroup'.to_le hBS
  have hBnotNormal : ¬ B.Normal := by
    intro hBnormal
    have hBcore : B ≤ pCore 2 G := le_sSup ⟨hBnormal, hBp⟩
    have hBcentV : B ≤ Subgroup.centralizer (vSubgroup S : Set G) := by
      rw [hcore] at hBcore
      exact hBcore.trans inf_le_right
    have hVcentB : vSubgroup S ≤ Subgroup.centralizer (B : Set G) :=
      Subgroup.le_centralizer_iff.mp hBcentV
    exact hnot (hVcentB.trans (Subgroup.centralizer_le hJB))
  have hNproper : Subgroup.normalizer (B : Set G) ≠ ⊤ := by
    intro htop
    exact hBnotNormal (Subgroup.normalizer_eq_top_iff.mp htop)
  have hSleN : (S : Subgroup G) ≤ Subgroup.normalizer (B : Set G) := by
    rw [hB]
    exact (S : Subgroup G).le_normalizer.trans
      (Stellmacher.normalizer_le_normalizer_baumann (S : Subgroup G))
  have hfrattini : Subgroup.normalizer (B : Set G) ⊔ L = ⊤ := by
    simpa only [hPmap] using P.normalizer_sup_eq_top
  obtain ⟨M, hMcoat, _hSM, huniq⟩ := hunique
  by_contra hLSproper
  have hNleM : Subgroup.normalizer (B : Set G) ≤
      M.map (⊤ : Subgroup G).subtype :=
    le_unique_maximal_ambient' huniq hSleN hNproper
  have hLSleM : L ⊔ (S : Subgroup G) ≤
      M.map (⊤ : Subgroup G).subtype :=
    le_unique_maximal_ambient' huniq le_sup_right hLSproper
  have htop : (⊤ : Subgroup G) ≤ M.map (⊤ : Subgroup G).subtype := by
    calc
      (⊤ : Subgroup G) = Subgroup.normalizer (B : Set G) ⊔ L :=
        hfrattini.symm
      _ ≤ M.map (⊤ : Subgroup G).subtype :=
        sup_le hNleM (le_sup_left.trans hLSleM)
  have hMtop : M = ⊤ := by
    apply Subgroup.map_subtype_inj.mp
    apply le_antisymm
    · exact Subgroup.map_mono le_top
    · simpa [← MonoidHom.range_eq_map, Subgroup.range_subtype] using htop
  exact hMcoat.1 hMtop

/-- Choose the generating local subgroup in Stellmacher (2.4), retaining the
source's exact nested Frattini `SL₂(2)` quotient. -/
public theorem two_four_exists_local_sl2Frattini_factor
    {G : Type u} [Group G] [Finite G]
    (h : Hypotheses G) (S : Sylow 2 G)
    (hcore : pCore 2 G =
      (S : Subgroup G) ⊓ Subgroup.centralizer (vSubgroup S : Set G))
    (hnot : ¬ vSubgroup S ≤ Subgroup.centralizer
      (elementaryAbelianMaxJ (S : Subgroup G) : Set G))
    (hunique :
      IsUniqueMaximalContaining (S : Subgroup G) (⊤ : Subgroup G)) :
    let B := (S : Subgroup G) ⊓ Subgroup.centralizer
      (omegaOneCenterAmbient (elementaryAbelianMaxJ (S : Subgroup G)) : Set G)
    let L := Subgroup.normalClosure (B : Set G)
    ∃ (L₁ : Subgroup G) (P₁ : Sylow 2 L₁),
      B ≤ L₁ ∧ L₁ ≤ L ∧ P₁.map L₁.subtype = B ∧
      IsSL2Two
        ((L₁ ⧸ pCore 2 L₁) ⧸ frattini (L₁ ⧸ pCore 2 L₁)) ∧
      L₁ ⊔ (S : Subgroup G) = ⊤ := by
  classical
  let B := (S : Subgroup G) ⊓ Subgroup.centralizer
    (omegaOneCenterAmbient (elementaryAbelianMaxJ (S : Subgroup G)) : Set G)
  let L := Subgroup.normalClosure (B : Set G)
  let J := elementaryAbelianMaxJ (S : Subgroup G)
  let E := Subgroup.normalClosure (J : Set G)
  let C := cSubgroup S
  let _ : (vSubgroup S).Normal := Subgroup.normalClosure_normal
  let _ : C.Normal := by
    dsimp only [C, cSubgroup]
    infer_instance
  let barG := G ⧸ C
  let q : G →* barG := QuotientGroup.mk' C
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective C
  have hker : q.ker = cSubgroup S := QuotientGroup.ker_mk' C
  let T : Sylow 2 barG := S.mapSurjective hq
  let Jbar : Subgroup barG := J.map q
  let Bbar : Subgroup barG := B.map q
  let Ebar : Subgroup barG := ⁅SectionOne.oddCore barG, Jbar⁆ ⊔ Jbar
  have hJne : Jbar ≠ ⊥ := by
    intro hbot
    have hJC : J ≤ Subgroup.centralizer (vSubgroup S : Set G) := by
      change J ≤ cSubgroup S
      rw [← hker]
      exact (Subgroup.map_eq_bot_iff J).mp hbot
    exact hnot (Subgroup.le_centralizer_iff.mp hJC)
  have h22 := lemma_two_two h S q hq hker
    ((S : Subgroup G).map q) Jbar Bbar rfl B rfl rfl rfl hJne
  obtain ⟨n, D, _Vf, hEgen, hprod, hSL, _hVf, _hVprod⟩ :=
    h22.parts_c_d
  change Ebar = ⨆ i, D i at hEgen
  change IsInternalDirectProductFamily Ebar D at hprod
  have hEnormal : Ebar.Normal := h22.part_a
  have hJS : J ≤ (S : Subgroup G) := sSup_le fun _ hA ↦ hA.1
  have hJleT : Jbar ≤ (T : Subgroup barG) := by
    exact (Subgroup.map_mono hJS).trans_eq (Sylow.coe_mapSurjective hq S).symm
  have hJinf : Jbar = (T : Subgroup barG) ⊓ Ebar := by
    simpa only [Ebar, SectionOne.oddCore] using
      (SectionOne.oddCore_commutator_join_sylow_inf T Jbar hJleT)
  have hclosure : Subgroup.normalClosure (Jbar : Set barG) = Ebar := by
    change Subgroup.normalClosure (Jbar : Set barG) =
      ⁅SectionOne.oddCore barG, Jbar⁆ ⊔ Jbar
    apply le_antisymm
    · apply Subgroup.normalClosure_le_normal
      intro x hx
      exact (show Jbar ≤ ⁅SectionOne.oddCore barG, Jbar⁆ ⊔ Jbar from
        le_sup_right) hx
    · exact sup_le
        ((Subgroup.commutator_mono le_rfl Subgroup.le_normalClosure).trans
          (Subgroup.commutator_le_right _ _))
        Subgroup.le_normalClosure
  have hEmap : E.map q = Ebar := by
    rw [show E = Subgroup.normalClosure (J : Set G) from rfl,
      Subgroup.map_normalClosure _ q hq]
    exact hclosure
  obtain ⟨P, hPmap⟩ := lemma_two_three h S hcore B L rfl rfl
  have hLsup : L = E ⊔ B :=
    normalClosure_baumann_eq_thompson_sup_of_image_eq
      S B rfl q hker hcore h22.part_b
  have hLmap : L.map q = Ebar := by
    calc
      L.map q = (E ⊔ B).map q := congrArg (fun K : Subgroup G ↦ K.map q) hLsup
      _ = Ebar ⊔ Bbar := by rw [Subgroup.map_sup, hEmap]
      _ = Ebar ⊔ Jbar := by rw [h22.part_b]
      _ = Ebar := sup_eq_left.mpr le_sup_right
  have hgenL : L ⊔ (S : Subgroup G) = ⊤ :=
    baumann_normalClosure_sup_sylow_eq_top S B L rfl hcore hnot hunique
      Subgroup.normalClosure_normal P hPmap
  exact exists_generating_coordinate_frattini_lift h.solvable S T q hq
    Jbar Ebar B L P hPmap h22.part_b.symm hJinf hJne hLmap hgenL
    hunique hEnormal D hprod hSL

end Stellmacher.SectionTwo
