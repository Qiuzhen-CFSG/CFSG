module

public import Stellmacher.SectionTwo.QuotientAction

/-!
# Lifting opposite subgroups and their fixed-space span

For the named faithful quotient-conjugation action on `V=vSubgroup S`,
suppose the image of `E` is generated by the image of `J ≤ E` and one
conjugate, and their fixed spaces span `V`. A lift `x ∈ E` of that same
conjugator gives `E = (J ∨ J^x) ∨ (E ∩ ker q)`, together with the ambient
decomposition `V = C_V(J) ∨ C_V(J^x)`. Neither normality of `E` nor
Section Two standing hypotheses are needed.

Choose the lift inside `E` using image membership. Equality of the quotient
images lifts every element of `E` to the generated subgroup up to a kernel
element still in `E`. Mapping the fixed-space equality through the subtype
of `V` and using the exact named quotient action identifies its two summands
with the two ambient centralizer intersections. Both conclusions retain the
same conjugating element.

This transports the two-conjugate group/module construction in Stellmacher
(2.3), Journal of Algebra 190 (1997), p.20, following
`refs/latex/stellmacher-n-group.tex`.
-/

namespace Stellmacher.SectionTwo
universe u v

public theorem quotient_opposite_lift
    {G : Type u} [Group G] (S : Sylow 2 G)
    {barG : Type v} [Group barG] (q : G →* barG)
    (hq : Function.Surjective q) (hker : q.ker = cSubgroup S)
    (E J : Subgroup G) (hJE : J ≤ E)
    (b : barG) (hb : b ∈ E.map q)
    (hgen : E.map q = J.map q ⊔ (J.map q).conjBy b)
    (hspan : letI := quotientConjugationAction S q hq hker
      FixedPoints.subgroup (J.map q) (vSubgroup S) ⊔
        FixedPoints.subgroup ((J.map q).conjBy b) (vSubgroup S) = ⊤) :
    ∃ x ∈ E, E = (J ⊔ J.conjBy x) ⊔ (E ⊓ q.ker) ∧
      vSubgroup S = (vSubgroup S ⊓ Subgroup.centralizer (J : Set G)) ⊔
        (vSubgroup S ⊓ Subgroup.centralizer (J.conjBy x : Set G)) := by
  let := quotientConjugationAction S q hq hker
  obtain ⟨x, hxE, hxb⟩ := hb
  have hconj : (J.conjBy x).map q = (J.map q).conjBy b := by
    rw [← hxb]
    unfold Subgroup.conjBy
    rw [Subgroup.map_map, Subgroup.map_map]
    congr 1
    ext a
    simp [MulAut.conj_apply]
  let K := J ⊔ J.conjBy x
  have hKE : K ≤ E := by
    apply sup_le hJE
    rintro y ⟨j, hj, rfl⟩
    exact E.mul_mem (E.mul_mem hxE (hJE hj)) (E.inv_mem hxE)
  have hmap : K.map q = E.map q := by
    change (J ⊔ J.conjBy x).map q = E.map q
    rw [Subgroup.map_sup, hconj, ← hgen]
  refine ⟨x, hxE, le_antisymm ?_ (sup_le hKE inf_le_left), ?_⟩
  · intro e he
    have hqe : q e ∈ K.map q := by rw [hmap]; exact Subgroup.mem_map_of_mem q he
    obtain ⟨k, hk, hke⟩ := hqe
    have hdiff : k⁻¹ * e ∈ E ⊓ q.ker := by
      refine ⟨E.mul_mem (E.inv_mem (hKE hk)) he, ?_⟩
      change q (k⁻¹ * e) = 1
      rw [map_mul, map_inv, hke, inv_mul_cancel]
    have hh := (K ⊔ (E ⊓ q.ker)).mul_mem
      ((le_sup_left : K ≤ K ⊔ (E ⊓ q.ker)) hk)
      ((le_sup_right : E ⊓ q.ker ≤ K ⊔ (E ⊓ q.ker)) hdiff)
    simpa only [mul_inv_cancel_left] using hh
  · have hh := congrArg (fun A : Subgroup (vSubgroup S) => A.map (vSubgroup S).subtype) hspan
    rw [Subgroup.map_sup, ← hconj,
      quotientConjugationAction_fixedPoints_image_map S q hq hker J,
      quotientConjugationAction_fixedPoints_image_map S q hq hker (J.conjBy x),
      ← MonoidHom.range_eq_map, Subgroup.range_subtype] at hh
    exact hh.symm

end Stellmacher.SectionTwo

