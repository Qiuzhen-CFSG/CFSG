module
public import Stellmacher.SectionTwo.LemmaTwoFive
public import Theory.GroupAction.SubgroupConjugation

/-!
# Ambient odd conjugation orbits in the native two-core

Under the exact hypotheses of Stellmacher (2.5), inject the native local
group into an ambient group. An odd-order subgroup normalizing the image
of the supplied Sylow subgroup conjugates every X≤V(S) into the image of
the native two-core, and the subgroup generated by these conjugates stays
there. The same supplied Sylow subgroup is used throughout.

The Sylow subgroup is identified with its injective image. Transporting
literal ambient conjugation through this equivalence gives a homomorphism
into its automorphism group. Its image has odd order, so (2.5) bounds the
full canonical V orbit. The conjugation equation identifies every ambient
X-orbit generator with the image of one of those controlled translates.

Source: the application of (2.5) to the Hall 2′-subgroup in Stellmacher
(6.1), Journal of Algebra 190 (1997), p.30. This result retains the actual
ambient conjugation; it does not replace it by an arbitrary orbit.
-/

namespace Stellmacher.SectionTwo
universe u v

public theorem odd_conjugation_orbit_le_core
    {G : Type u} [Group G] [Finite G]
    (h : Hypotheses G) (S : Sylow 2 G)
    (hP : ∀ K : Subgroup S, K.Characteristic → K ≠ ⊥ →
      ¬ (K.map (S : Subgroup G).subtype).Normal)
    (hunique : IsUniqueMaximalContaining (S : Subgroup G) (⊤ : Subgroup G))
    {barG : Type u} [Group barG] [Finite barG]
    (q : G →* barG) (hq : Function.Surjective q)
    (hker : q.ker = cSubgroup S) (hbar : IsSL2Two barG)
    {H : Type v} [Group H] [Finite H]
    (f : G →* H) (hf : Function.Injective f)
    (U : Subgroup H) (hU : Odd (Nat.card U))
    (hnorm : U ≤ Subgroup.normalizer (((S : Subgroup G).map f : Subgroup H) : Set H))
    (X : Subgroup G) (hXV : X ≤ vSubgroup S) :
    Subgroup.closure {z : H | ∃ u : U, ∃ x : X,
      z = (u : H) * f (x : G) * (u : H)⁻¹} ≤ (pCore 2 G).map f := by
  let B := (S : Subgroup G).map f
  let e : S ≃* B := (S : Subgroup G).equivMapOfInjective f hf
  let _ := Subgroup.conjMulDistribMulActionOfLeNormalizer U B hnorm
  let ρ : U →* MulAut S := (MulAut.congr e.symm).toMonoidHom.comp
    (MulDistribMulAction.toMulAut U B)
  have he (x : S) : ((e x : B) : H) = f (x : G) :=
    Subgroup.coe_equivMapOfInjective_apply _ _ _ x
  have hρ (u : U) (x : S) :
      f ((ρ u x : S) : G) = (u : H) * f (x : G) * (u : H)⁻¹ := by
    rw [← he]
    change ((e (e.symm (u • e x)) : B) : H) = _
    rw [e.apply_symm_apply]
    change (u : H) * ((e x : B) : H) * (u : H)⁻¹ = _
    rw [he]
  have hodd : Odd (Nat.card ρ.range) := Odd.of_dvd_nat hU (Subgroup.card_range_dvd ρ)
  obtain ⟨Y, hY, _hYn, hYcore⟩ := lemma_two_five h S hP hunique q hq hker hbar ρ.range hodd
  have hVS : vSubgroup S ≤ (S : Subgroup G) :=
    (vSubgroup_le_twoCore_and_elementaryAbelian h S).1.trans (fitting_pCore_le_sylow S)
  apply (Subgroup.closure_le _).mpr
  rintro z ⟨u, x, rfl⟩
  let t : S := ⟨x, hVS (hXV x.property)⟩
  have ht : t ∈ vSubgroupInSylow S := hXV x.property
  have htranslate : ((ρ u t : S) : G) ∈ automorphismTranslateV S (ρ u) :=
    ⟨ρ u t, ⟨t, ht, rfl⟩, rfl⟩
  have htY : ((ρ u t : S) : G) ∈ Y := by
    rw [hY]
    exact (le_iSup (fun τ : ρ.range => automorphismTranslateV S (τ : MulAut S))
      ⟨ρ u, ⟨u, rfl⟩⟩) htranslate
  exact ⟨((ρ u t : S) : G), hYcore htY, hρ u t⟩

end Stellmacher.SectionTwo
