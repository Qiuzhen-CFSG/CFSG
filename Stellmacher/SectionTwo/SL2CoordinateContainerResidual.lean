module

public import Stellmacher.SL2DerivedCard
public import Stellmacher.SectionOne.SL2FamilySylowCoordinates
public import Stellmacher.SectionThree.PrimitiveDihedralExtraction.CyclicResidual

/-!
# The actual two-residual of an SL₂ coordinate container

Let a normal subgroup of a finite group be generated by a finite internal
family of `SL₂(2)` factors. For a supplied ambient Sylow two-subgroup `T`,
join one entire factor `D i` with the Sylow lines in every other factor.
The two-residual of this coordinate container is exactly the ambient image
of the actual derived subgroup of `D i`.

The shared indexed-coordinate theorem identifies `T ∩ E` with the join of
all factor lines and gives each line order two. The derived subgroup of
`D i` has order three, so it and the selected line generate `D i` by the
order-six cardinality bound. Hence the coordinate container is the join of
that derived subgroup and `T ∩ E`. The selected line normalizes the derived
subgroup; all other lines centralize it by pairwise factor commutation.
The normal odd-subgroup/two-group quotient residual theorem therefore
identifies the actual two-residual, without any action-module cardinality
assumption or normality of the selected factor in the whole ambient group.

This is the group calculation for the coordinate container in (2.2), used
in the one-factor argument of Stellmacher (6.3), journal pp.20 and 31;
`refs/latex/stellmacher-n-group.tex`.
-/

namespace Stellmacher.SectionTwo

public theorem twoResidual_coordinate_container {X : Type*} [Group X] [Finite X]
    (T : Sylow 2 X) (E : Subgroup X) (hEnormal : E.Normal)
    {n : ℕ} (D : Fin n → Subgroup X)
    (hprod : IsInternalDirectProductFamily E D) (hSL : ∀ i, IsSL2Two (D i))
    (i : Fin n) :
    twoResidualAmbient (D i ⊔ ⨆ j : {j : Fin n // j ≠ i}, (T : Subgroup X) ⊓ D j.val) =
      (commutator (D i)).map (D i).subtype := by
  have hcoord := SectionOne.sl2_family_sylow_coordinates T E hEnormal D hprod hSL
  let F := (commutator (D i)).map (D i).subtype
  let Q := (T : Subgroup X) ⊓ E
  let O := ⨆ j : {j : Fin n // j ≠ i}, (T : Subgroup X) ⊓ D j.val
  have hDiE (j : Fin n) : D j ≤ E := by rw [hprod.1]; exact le_iSup D j
  have hFDi : F ≤ D i := Subgroup.map_subtype_le _
  have hFcard : Nat.card F = 3 := by
    rw [Subgroup.card_map_of_injective (D i).subtype_injective]
    exact Stellmacher.isSL2Two_commutator_card (hSL i)
  have hDi : D i = F ⊔ ((T : Subgroup X) ⊓ D i) := by
    have hle : F ⊔ ((T : Subgroup X) ⊓ D i) ≤ D i := sup_le hFDi inf_le_right
    have hthree : 3 ∣ Nat.card ↥(F ⊔ ((T : Subgroup X) ⊓ D i)) := by
      rw [← hFcard]
      exact Subgroup.card_dvd_of_le le_sup_left
    have htwo : 2 ∣ Nat.card ↥(F ⊔ ((T : Subgroup X) ⊓ D i)) := by
      have hdvd := Subgroup.card_dvd_of_le (show (T : Subgroup X) ⊓ D i ≤
        F ⊔ ((T : Subgroup X) ⊓ D i) from le_sup_right)
      simpa only [hcoord.2 i] using hdvd
    have hsix := (show Nat.Coprime 3 2 by decide).mul_dvd_of_dvd_of_dvd hthree htwo
    apply (Subgroup.eq_of_le_of_card_ge hle ?_).symm
    rw [SectionOne.RankOneThreeGroupAssembly.isSL2Two_card (hSL i)]
    exact Nat.le_of_dvd Nat.card_pos hsix
  have hOQ : O ≤ Q := by
    apply iSup_le
    intro j
    exact le_inf inf_le_left (inf_le_right.trans (hDiE j.val))
  have hQcontainer : Q ≤ D i ⊔ O := by
    rw [show Q = (T : Subgroup X) ⊓ E from rfl, hcoord.1]
    apply iSup_le
    intro j
    by_cases hji : j = i
    · subst j
      exact inf_le_right.trans le_sup_left
    · exact (le_iSup (fun j : {j : Fin n // j ≠ i} => (T : Subgroup X) ⊓ D j.val)
        ⟨j, hji⟩).trans le_sup_right
  have hcontainer : D i ⊔ O = F ⊔ Q := by
    apply le_antisymm
    · apply sup_le
      · rw [hDi]
        exact sup_le le_sup_left ((le_inf inf_le_left (inf_le_right.trans (hDiE i))).trans le_sup_right)
      · exact hOQ.trans le_sup_right
    · exact sup_le (hFDi.trans le_sup_left) hQcontainer
  have hDinorm : D i ≤ Subgroup.normalizer (F : Set X) := by
    apply (Subgroup.normal_subgroupOf_iff_le_normalizer hFDi).mp
    change ((commutator (D i)).map (D i).subtype).subgroupOf (D i) |>.Normal
    rw [subgroupOf_map_subtype_eq]
    infer_instance
  have hQnorm : Q ≤ Subgroup.normalizer (F : Set X) := by
    rw [show Q = (T : Subgroup X) ⊓ E from rfl, hcoord.1]
    apply iSup_le
    intro j
    by_cases hji : j = i
    · subst j
      exact inf_le_right.trans hDinorm
    · apply inf_le_right.trans
      apply le_trans (show D j ≤ Subgroup.centralizer (F : Set X) from ?_)
        (Subgroup.centralizer_le_normalizer _)
      intro z hz
      rw [Subgroup.mem_centralizer_iff]
      intro f hf
      exact hprod.2.2 i j (Ne.symm hji) f (hFDi hf) z hz
  have hFp : IsPGroup 3 F := IsPGroup.of_card (n := 1) (by simpa using hFcard)
  have hQp : IsPGroup 2 Q := T.isPGroup'.to_le inf_le_left
  change twoResidualAmbient (D i ⊔ O) = F
  rw [hcontainer]
  exact SectionThree.twoResidualAmbient_sup_eq_odd_normal_subgroup F Q
    Nat.prime_three (by decide) hFp hQp hQnorm

end Stellmacher.SectionTwo
