module
public import Stellmacher.SectionTwo.QuotientModuleTransport
public import Theory.GroupTheory.NormalClosureCommutatorSupplement
public import Theory.GroupAction.NormalizingFixedPoints

/-!
# The fixed summand of a normal supplement

For the exact Section Two quotient-conjugation action, let E be normal in
the quotient and suppose its full preimage supplements the given Sylow
subgroup. If the E-fixed subgroup is disjoint from the E-action commutator,
then every E-fixed vector is fixed by the Sylow image.

The original V is normally generated by the central involutions of S.
The normal-supplement commutator theorem therefore identifies [V,G] with
[V,q^(-1)(E)]. Exact quotient-action transport puts all action commutators
in [V,E]. Normality of E preserves its fixed subgroup, so a commutator
of an E-fixed vector lies in both disjoint subgroups and is trivial.
No finiteness or solvability hypotheses are needed for this transfer.

This supplies the fixed-summand hypothesis in the factor selection used in
Stellmacher (6.4), Journal of Algebra 190 (1997), p.32, with the actual
barred residual product established on p.31. Source:
`refs/latex/stellmacher-n-group.tex`.
-/

namespace Stellmacher.SectionTwo
universe u v

public theorem quotientConjugationAction_fixedPoints_le_sylow_of_normal_supplement
    {G : Type u} [Group G] (S : Sylow 2 G)
    {X : Type v} [Group X] (q : G →* X)
    (hq : Function.Surjective q) (hker : q.ker = cSubgroup S)
    (E : Subgroup X) [E.Normal]
    (hgen : E.comap q ⊔ (S : Subgroup G) = ⊤) :
    letI := quotientConjugationAction S q hq hker
    Disjoint (FixedPoints.subgroup E (vSubgroup S)) (commutatorAction E (vSubgroup S)) →
      FixedPoints.subgroup E (vSubgroup S) ≤
        FixedPoints.subgroup ((S : Subgroup G).map q) (vSubgroup S) := by
  let _ := quotientConjugationAction S q hq hker
  intro hd
  let V := vSubgroup S
  let _ : V.Normal := Subgroup.normalClosure_normal
  have hZV : zSubgroup S ≤ V := Subgroup.le_normalClosure
  have hZS : zSubgroup S ≤ Subgroup.centralizer (S : Set G) := by
    intro z hz
    obtain ⟨zS, ⟨zZ, _hzZ, rfl⟩, rfl⟩ := hz
    exact (Subgroup.mem_centralizer_iff.mpr fun s hs =>
      congrArg Subtype.val ((Subgroup.mem_center_iff.mp zZ.property) ⟨s, hs⟩))
  have hcomm := Subgroup.commutator_normalClosure_eq_of_normal_supplement
    (zSubgroup S) V (E.comap q) (S : Subgroup G) hZV rfl hZS hgen
  have hU : commutatorAction (⊤ : Subgroup X) V ≤ commutatorAction E V := by
    apply (Subgroup.map_le_map_iff_of_injective V.subtype_injective).mp
    rw [quotientConjugationAction_commutator_map S q hq hker,
      quotientConjugationAction_commutator_map S q hq hker]
    change ⁅(⊤ : Subgroup X).comap q, V⁆ ≤ ⁅E.comap q, V⁆
    rw [Subgroup.comap_top, Subgroup.commutator_comm (⊤ : Subgroup G),
      hcomm, Subgroup.commutator_comm V]
  have hInv := fixedPoints_isInvariant_of_normalizing_actor (V := V) (⊤ : Subgroup X) E
    (by rw [Subgroup.normalizer_eq_top])
  intro w hw s
  have hsmul : (s : X) • w ∈ FixedPoints.subgroup E V :=
    (hInv.invariant (⟨s, Subgroup.mem_top _⟩ : (⊤ : Subgroup X)) w).mp hw
  have hc : w⁻¹ * (s : X) • w ∈ commutatorAction E V := by
    apply hU
    rw [commutatorAction_eq_closure]
    exact Subgroup.subset_closure ⟨(⟨s, Subgroup.mem_top _⟩ : (⊤ : Subgroup X)), w, rfl⟩
  have heq : w⁻¹ * (s : X) • w = 1 :=
    (Subgroup.disjoint_def.mp hd) ((FixedPoints.subgroup E V).mul_mem
      ((FixedPoints.subgroup E V).inv_mem hw) hsmul) hc
  exact (inv_mul_eq_one.mp heq).symm

end Stellmacher.SectionTwo
