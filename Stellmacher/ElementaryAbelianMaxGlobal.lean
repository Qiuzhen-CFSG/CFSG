module

public import Stellmacher.ElementaryAbelianMaxJ
public import Mathlib.GroupTheory.Sylow

/-!
# The global elementary Thompson subgroup

Automorphism invariance gives characteristicity of `J(G)`. Sylow
conjugacy puts every elementary two-subgroup into a chosen Sylow subgroup
without changing its order, proving `J(T) ≤ J(G)`. This is the elementary
Thompson subgroup, generated by elementary abelian groups of largest order.

Source application: Aschbacher–Smith, *The Classification of Quasithin
Groups*, final proof of Theorem 15.3.1, printed p.1155 (PDF p.1172).
-/

public section
namespace Stellmacher
open Subgroup
open scoped Pointwise
variable {H : Type*} [Group H]

/-- The elementary Thompson subgroup of the whole group is characteristic. -/
theorem elementaryAbelianMaxJ_top_characteristic :
    (elementaryAbelianMaxJ (⊤ : Subgroup H)).Characteristic := by
  rw [characteristic_iff_map_eq]
  intro e
  rw [← elementaryAbelianMaxJ_map_equiv, map_top_of_surjective _ e.surjective]

/-- Every maximal elementary subgroup of a Sylow group is maximal in the ambient group. -/
theorem elementaryAbelianMaxJ_sylow_le_top [Finite H] (T : Sylow 2 H) :
    elementaryAbelianMaxJ (T : Subgroup H) ≤ elementaryAbelianMaxJ (⊤ : Subgroup H) := by
  apply sSup_le
  intro A hA
  apply le_sSup
  refine ⟨le_top, hA.2.1, ?_⟩
  intro B _ hB
  obtain ⟨S, hBS⟩ := (hB.isPGroup).exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq H S T
  let e := MulAut.conj g
  have hST : (S : Subgroup H).map e.toMonoidHom = (T : Subgroup H) := by
    change ((g • S : Sylow 2 H) : Subgroup H) = (T : Subgroup H)
    rw [hg]
  have hBT : B.map e.toMonoidHom ≤ (T : Subgroup H) := (map_mono hBS).trans hST.le
  have hc := hA.2.2 (B.map e.toMonoidHom) hBT (hB.map e.toMonoidHom)
  rwa [card_map_of_injective e.injective] at hc
end Stellmacher
