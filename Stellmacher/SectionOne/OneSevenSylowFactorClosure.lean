module
public import Stellmacher.SectionOne.OneSevenGlobalProduct
public import Stellmacher.SectionOne.OneSevenOddCoreProduct
public import Stellmacher.SectionOne.SL2ProductSylowCoordinates
public import Mathlib.Tactic.Group

/-!
# A Sylow-normal subgroup lies in the selected involution closure

Let D be a canonical one-seven factor, S an ambient Sylow two-subgroup,
and R≤S normal in S. If R normalizes D, D and S generate the ambient group,
and D∩R contains an involution u, then R is contained in the S-conjugate
closure of the cyclic subgroup generated by u. All action and factor
hypotheses are the original Section One hypotheses.

The S-conjugates of D form a centerless internal SL₂(2) product E. Their
join is normal because it is normalized by S and contains D. The centralizer
of E embeds in the two-group quotient by E and is normal, so the ambient
trivial two-core kills it. Normality of R in S transports its normalization
of D to every factor; factorwise innerness therefore puts R inside E.
The Sylow intersection S∩E is generated by its order-two factor coordinates.
Each coordinate is the corresponding conjugate of the involution subgroup,
which proves the desired containment.

This is the group-side normal-closure step after (9.4)(5), Journal of Algebra
190 (1997), printed p.51/PDF p.41 of `refs/files/stellmacher-n-group.pdf`.
The concrete application supplies the actual initial-core and core-intersection
images in the next local quotient. No factor normalization or containment
conclusion is inserted into the faithful-module hypotheses.
-/

namespace Stellmacher.SectionOne
open Subgroup
universe u

private theorem product_centralizer_eq_bot
    {G : Type u} [Group G] [Finite G]
    (S : Sylow 2 G) (E : Subgroup G) [E.Normal]
    (F : Finset (Subgroup G)) (hprod : IsInternalDirectProduct E F)
    (hSL : ∀ D ∈ F, IsSL2Two D)
    (hgen : E ⊔ (S : Subgroup G) = ⊤) (hcore : pCore 2 G = ⊥) :
    centralizer (E : Set G) = ⊥ := by
  let q := QuotientGroup.mk' E
  let C := centralizer (E : Set G)
  have hdis := sl2_product_disjoint_centralizer E F hprod hSL
  have hQp : IsPGroup 2 (G ⧸ E) := by
    have himage : (S : Subgroup G).map q = ⊤ := by
      have hh := congrArg (fun K : Subgroup G => K.map q) hgen
      rw [Subgroup.map_sup, (map_eq_bot_iff E).mpr (by simp [q]), bot_sup_eq,
        map_top_of_surjective q (QuotientGroup.mk'_surjective E)] at hh
      exact hh
    have hh := S.isPGroup'.map q
    rw [himage] at hh
    exact hh.of_equiv topEquiv
  have hinj : Function.Injective (q.comp C.subtype) := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    apply eq_bot_iff.mpr
    intro x hx
    have hxE : (x : G) ∈ E := by
      change q (x : G) = 1 at hx
      exact (QuotientGroup.eq_one_iff _).mp hx
    exact Subtype.ext (hdis.le_bot ⟨hxE,x.property⟩)
  have hCcore : C ≤ pCore 2 G :=
    le_sSup ⟨inferInstance,hQp.of_injective (q.comp C.subtype) hinj⟩
  exact le_bot_iff.mp (hCcore.trans_eq hcore)

public theorem oneSevenFactor_sylow_normal_subgroup_le_conjugateClosure
    {G V : Type u} [Group G] [Finite G] [Group V] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (hyp : Hypotheses G V) (D : Subgroup G) (hD : IsOneSevenFactor (V := V) D)
    (S : Sylow 2 G) (R : Subgroup G) (hRS : R ≤ (S : Subgroup G))
    (hRN : (R.subgroupOf (S : Subgroup G)).Normal)
    (hRD : R ≤ normalizer (D : Set G)) (hgen : D ⊔ (S : Subgroup G) = ⊤)
    (u : G) (huD : u ∈ D) (huR : u ∈ R) (hu : _root_.IsInvolution u) :
    R ≤ conjugateClosure (zpowers u) (S : Subgroup G) := by
  classical
  let _ : Fintype S := Fintype.ofFinite S
  let F : Finset (Subgroup G) := Finset.univ.image (fun s : S => D.conjBy (s : G))
  let E := conjugateClosure D (S : Subgroup G)
  let T := conjugateClosure (zpowers u) (S : Subgroup G)
  have hF (X : Subgroup G) : X ∈ F ↔ ∃ s : S, D.conjBy (s : G) = X := by
    simp [F]
  have hfactor (X : Subgroup G) (hX : X ∈ F) : IsOneSevenFactor (V := V) X := by
    obtain ⟨s,rfl⟩ := (hF X).mp hX
    exact hD.conjBy D s
  have hSL (X : Subgroup G) (hX : X ∈ F) : IsSL2Two X := (hfactor X hX).1
  have hEgen : E = ⨆ X : {X : Subgroup G // X ∈ F}, (X : Subgroup G) := by
    apply le_antisymm
    · apply (closure_le _).mpr
      rintro point ⟨s,d,rfl⟩
      have hmem : D.conjBy (s : G) ∈ F := (hF _).mpr ⟨s,rfl⟩
      exact (le_iSup (fun X : {X : Subgroup G // X ∈ F} => (X : Subgroup G))
        ⟨D.conjBy (s:G),hmem⟩) ⟨d,d.property,rfl⟩
    · apply iSup_le
      intro X
      obtain ⟨s,hs⟩ := (hF X).mp X.property
      rw [← hs]
      rintro point ⟨d,hd,rfl⟩
      exact Subgroup.subset_closure ⟨s,⟨d,hd⟩,rfl⟩
  have hprod : IsInternalDirectProduct E F := by
    have himage : Finset.univ.image (fun X : {X : Subgroup G // X ∈ F} =>
        (X : Subgroup G)) = F := by ext X; simp
    rw [← himage]
    apply RankOneThreeGroupAssembly.internalDirectProduct_image_of_iSup_centerless_commuting
      E (fun X : {X : Subgroup G // X ∈ F} => (X : Subgroup G)) hEgen
    · intro X
      exact RankOneThreeGroupAssembly.center_eq_bot_of_isSL2Two (hSL X X.property)
    · intro X Y hne
      exact (oneSevenFactor_eq_or_commute hyp X Y (hfactor X X.property)
        (hfactor Y Y.property)).resolve_left (fun h => hne (Subtype.ext h))
  have hDE : D ≤ E := by
    intro d hd
    exact Subgroup.subset_closure ⟨1,⟨d,hd⟩,by simp⟩
  have hSE : (S : Subgroup G) ≤ normalizer (E : Set G) := by
    change (S : Subgroup G) ≤ normalizer (conjugateClosure D (S : Subgroup G) : Set G)
    rw [conjugateClosure,le_normalizer_closure_iff]
    intro s hs point hpoint
    obtain ⟨t,d,rfl⟩ := hpoint
    apply Subgroup.subset_closure
    refine ⟨⟨s*(t:G),(S : Subgroup G).mul_mem hs t.property⟩,d,?_⟩
    change s*((t:G)*(d:G)*(t:G)⁻¹)*s⁻¹ = (s*(t:G))*(d:G)*(s*(t:G))⁻¹
    group
  let _ : E.Normal := by
    have hnormal : (⊤ : Subgroup G) ≤ normalizer (E : Set G) := by
      rw [← hgen]
      exact sup_le (hDE.trans E.le_normalizer) hSE
    constructor
    intro x hx g
    exact (mem_normalizer_iff.mp (hnormal (mem_top g)) x).mp hx
  have hES : E ⊔ (S : Subgroup G) = ⊤ := top_unique (by
    rw [← hgen]
    exact sup_le_sup_right hDE _)
  have hSR : (S : Subgroup G) ≤ normalizer (R : Set G) :=
    (normal_subgroupOf_iff_le_normalizer hRS).mp hRN
  have hRX (X : Subgroup G) (hX : X ∈ F) : R ≤ normalizer (X : Set G) := by
    obtain ⟨s,rfl⟩ := (hF X).mp hX
    rw [conjBy, ← map_normalizer_eq_of_bijective D (MulAut.conj (s:G)).bijective]
    intro r hr
    have hback : (s:G)⁻¹*r*(s:G) ∈ R := by
      simpa only [inv_inv] using
        (mem_normalizer_iff.mp (hSR ((S : Subgroup G).inv_mem s.property)) r).mp hr
    refine ⟨(s:G)⁻¹*r*(s:G),hRD hback,?_⟩
    change (s:G)*((s:G)⁻¹*r*(s:G))*(s:G)⁻¹ = r
    group
  have hRE : R ≤ E := by
    have hh := sl2_product_factor_normalizer_le_sup_centralizer E R F hprod hSL hRX
    rwa [product_centralizer_eq_bot S E F hprod hSL hES hyp.twoCore_eq_bot,sup_bot_eq] at hh
  have hcoordinates := sl2_product_sylow_coordinates S E inferInstance F hprod hSL
  have huS : u ∈ (S : Subgroup G) := hRS huR
  have hseedCard : Nat.card (zpowers u) = 2 := by
    rw [Nat.card_zpowers,orderOf_eq_prime hu.2 hu.1]
  have hET : (S : Subgroup G) ⊓ E ≤ T := by
    rw [hcoordinates.2.1]
    apply iSup_le
    intro X
    obtain ⟨s,hs⟩ := (hF X).mp X.property
    let L := (zpowers u).conjBy (s:G)
    have hLX : L ≤ (S : Subgroup G) ⊓ X := by
      apply le_inf
      · rintro point ⟨a,ha,rfl⟩
        exact (S : Subgroup G).mul_mem
          ((S : Subgroup G).mul_mem s.property ((zpowers_le.mpr huS) ha))
          ((S : Subgroup G).inv_mem s.property)
      · rw [← hs]
        exact map_mono (zpowers_le.mpr huD)
    have hLcard : Nat.card L = 2 := by
      rw [show L = (zpowers u).map (MulAut.conj (s:G)).toMonoidHom from rfl,
        card_map_of_injective (MulAut.conj (s:G)).injective,hseedCard]
    have heq : L = (S : Subgroup G) ⊓ X := eq_of_le_of_card_ge hLX (by
      rw [hLcard,hcoordinates.2.2.2 X X.property])
    rw [← heq]
    rintro point ⟨a,ha,rfl⟩
    exact Subgroup.subset_closure ⟨s,⟨a,ha⟩,rfl⟩
  exact (le_inf hRS hRE).trans hET

end Stellmacher.SectionOne

