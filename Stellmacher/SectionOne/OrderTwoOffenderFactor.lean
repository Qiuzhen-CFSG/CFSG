module
public import Stellmacher.SectionOne.OneSevenSmallSylow
public import Stellmacher.SectionOne.OneASL2Factors

/-!
# The canonical factor generated by an order-two offender

Under the faithful Section One binary action hypotheses, an offender A of
order two generates exactly one canonical SL₂(2) factor when joined to its
commutator with the odd core. The conclusion includes its actual four-element
support and normality under the ambient odd core, not just an abstract group
isomorphism.

In the existing relative group E=[O₂′(G),A]A, the subgroup A is a Sylow
subgroup of order two. Its offender join is all of that Sylow, and the
identity [O₂′(E),A]=O₂′(E) makes its normal closure all of E. The proved
small-Sylow consequence of (1.7) identifies E as SL₂(2). The existing local
canonical-factor decomposition of E contains a factor of order six; equal
orders make that factor all of E and retain every ambient factor clause.

Source: Stellmacher (1.7), printed p.19, and the selected first factor in
(9.4)(1), printed p.51 of `refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionOne
universe u

public theorem oneSevenFactor_of_card_two_offender
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G) (A : Subgroup G)
    (hA : oneA (V := V) (S : Subgroup G) A) (hcard : Nat.card A = 2) :
    IsOneSevenFactor (V := V) (⁅oddCore G, A⁆ ⊔ A) := by
  classical
  let E := ⁅oddCore G, A⁆ ⊔ A
  change IsOneSevenFactor (V := V) E
  have hAne : A ≠ ⊥ := by
    intro heq
    have hone := Subgroup.card_eq_one.mpr heq
    omega
  obtain ⟨T, hTA, hE, hT, hodd, hm, _⟩ := oneA_relative_rank_one_setup h S A hA hAne
  have hoddMap : (oddCore E).map E.subtype = ⁅oddCore G, A⁆ :=
    oneA_relative_oddCore_map h S A hA hAne
  have hTcard : Nat.card T = 2 := by
    rw [hTA, Nat.card_congr (Subgroup.subgroupOfEquivOfLe
      (show A ≤ E from le_sup_right)).toEquiv, hcard]
  have hgen : oddCore E ⊔ (T : Subgroup E) = ⊤ := by
    apply Subgroup.map_injective E.subtype_injective
    rw [Subgroup.map_sup, hoddMap, hTA, Subgroup.map_subgroupOf_eq_of_le
      (show A ≤ E from le_sup_right), ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hToneA : oneA (V := V) (T : Subgroup E) (T : Subgroup E) := ⟨le_rfl, hT, hm.le⟩
  have hJ : oneJ (V := V) (T : Subgroup E) = (T : Subgroup E) :=
    le_antisymm (sSup_le fun _ hY => hY.1) (le_sSup hToneA)
  have hnormalGeneration : Subgroup.normalClosure (T : Set E) = ⊤ := by
    apply top_unique
    rw [← hgen]
    apply sup_le ?_ Subgroup.le_normalClosure
    rw [hodd]
    exact (Subgroup.commutator_mono le_rfl Subgroup.le_normalClosure).trans
      (Subgroup.commutator_le_right _ _)
  have hEtop : oneE (V := V) (T : Subgroup E) = ⊤ := by
    change Subgroup.normalClosure (oneJ (V := V) (T : Subgroup E) : Set E) = ⊤
    rw [hJ]
    exact hnormalGeneration
  have hSL : IsSL2Two E := isSL2Two_of_oneE_eq_top_of_sylow_card_two hE T hTcard hEtop
  obtain ⟨family, hprod, hfamily⟩ := oneA_sl2_factors h S A hA hAne
  change IsInternalDirectProduct E family at hprod
  have hnonempty : family.Nonempty := by
    by_contra hnone
    have hempty : family = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnone
    have hEbot : E = ⊥ := by
      rw [hprod.1, hempty]
      simp
    apply hAne
    exact bot_unique ((show A ≤ E from le_sup_right).trans_eq hEbot)
  obtain ⟨factor, hfactor⟩ := hnonempty
  have hfactorE : factor ≤ E := by
    rw [hprod.1]
    exact le_iSup (fun D : {D : Subgroup G // D ∈ family} => D.val) ⟨factor, hfactor⟩
  have heq : factor = E := Subgroup.eq_of_le_of_card_ge hfactorE (by
    rw [RankOneThreeGroupAssembly.isSL2Two_card hSL,
      RankOneThreeGroupAssembly.isSL2Two_card (hfamily factor hfactor).1])
  exact heq ▸ hfamily factor hfactor

end Stellmacher.SectionOne
