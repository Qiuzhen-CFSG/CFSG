module

public import Stellmacher.DirectProductCommutator
public import Stellmacher.SectionOne.OneSevenModuleProduct
public import Stellmacher.SectionOne.SL2FamilySylowCard
public import Theory.GroupTheory.SylowNormalIntersection

/-!
# Irreducible support in an internal product of one-seven factors

This module isolates the product-support argument used at the end of
Stellmacher's proof of (3.9).  The derived subgroup of an internal family of
one-seven factors is elementary abelian of order-exponent three.  Moreover,
two irreducible, Sylow-two-invariant subgroups of that derived product which
are generated by their commutators with the Sylow intersection either agree
or have mutually fixed action commutators.

For the support argument, write `Q i = S ⊓ D i` and `F i = (D i)'`.
Sylow coordinates give `J = ⨆ i, Q i`, while the internal product gives
`E' = ⨆ i, F i`.  Thus each local commutator `[K,Q i]` is either trivial
or all of the order-three group `F i`.  If unequal irreducible sections
shared a nontrivial coordinate, their intersection would be a nontrivial
invariant subgroup, forcing equality.  Distinct supports therefore lie in
distinct factors, and the cross-factor fixed-point theorem from (1.7)
supplies the two final inclusions.  Explicit Sylow invariance of the sections
is essential for the intersection argument.

Source: Stellmacher (1.7) as used in (3.9), journal page 24,
`refs/latex/stellmacher-n-group.tex`.
-/


namespace Stellmacher.SectionOne

universe u

public theorem internalOneSevenProduct_derived_isElementaryAbelian
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [MulDistribMulAction G V]
    (E : Subgroup G) {n : ℕ} (D : Fin n → Subgroup G)
    (hprod : IsInternalDirectProductFamily E D)
    (hD : ∀ i, IsOneSevenFactor (V := V) (D i)) :
    IsElementaryAbelian 3 ((commutator E).map E.subtype) := by
  classical
  let P := ∀ i, D i
  have hcomm : Pairwise (fun i j : Fin n => ∀ x y : G,
      x ∈ D i → y ∈ D j → Commute x y) := by
    intro i j hij x y hx hy
    exact hprod.2.2 i j hij x hx y hy
  let f : P →* G := Subgroup.noncommPiCoprod hcomm
  have hf : f.range = E := by
    rw [Subgroup.noncommPiCoprod_range]
    exact hprod.1.symm
  have hmap : (commutator P).map f = (commutator E).map E.subtype := by
    rw [map_commutator_eq, hf, Subgroup.map_subtype_commutator]
  have hcard (i : Fin n) : Nat.card (commutator (D i)) = 3 := by
    rw [← Subgroup.card_map_of_injective (D i).subtype_injective]
    exact (hD i).2.1.2.1
  have hPelementary : IsElementaryAbelian 3 (commutator P) := by
    refine
      { toIsMulCommutative := ⟨⟨?_⟩⟩
        exponent_dvd_p := ?_ }
    · intro x y
      apply Subtype.ext
      funext i
      have hx : (x : P) i ∈ commutator (D i) := by
        have hm := Subgroup.mem_map_of_mem
          (Pi.evalMonoidHom (fun i : Fin n => D i) i) x.property
        rw [map_commutator_eq] at hm
        exact Subgroup.commutator_mono le_top le_top hm
      have hy : (y : P) i ∈ commutator (D i) := by
        have hm := Subgroup.mem_map_of_mem
          (Pi.evalMonoidHom (fun i : Fin n => D i) i) y.property
        rw [map_commutator_eq] at hm
        exact Subgroup.commutator_mono le_top le_top hm
      let _ : IsCyclic (commutator (D i)) := isCyclic_of_prime_card (hcard i)
      exact congrArg Subtype.val
        ((IsMulCommutative.is_comm (M := commutator (D i))).comm
          ⟨(x : P) i, hx⟩ ⟨(y : P) i, hy⟩)
    · rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
      intro x
      apply Subtype.ext
      funext i
      have hx : (x : P) i ∈ commutator (D i) := by
        have hm := Subgroup.mem_map_of_mem
          (Pi.evalMonoidHom (fun i : Fin n => D i) i) x.property
        rw [map_commutator_eq] at hm
        exact Subgroup.commutator_mono le_top le_top hm
      have hp := pow_card_eq_one' (
        x := (⟨(x : P) i, hx⟩ : commutator (D i)))
      rw [hcard i] at hp
      exact congrArg Subtype.val hp
  let _ : Fact (Nat.Prime 3) := ⟨by decide⟩
  let _ : IsElementaryAbelian 3 (commutator P) := hPelementary
  have himage := IsElementaryAbelian.map (p := 3) (A := commutator P) f
  rwa [hmap] at himage

private theorem family_sylow_coordinates
    {G : Type u} [Group G] [Finite G] (S : Sylow 2 G)
    (E : Subgroup G) (hEnormal : E.Normal) {n : ℕ}
    (D : Fin n → Subgroup G)
    (hprod : IsInternalDirectProductFamily E D)
    (hD : ∀ i, IsSL2Two (D i)) :
    (S : Subgroup G) ⊓ E = ⨆ i, (S : Subgroup G) ⊓ D i ∧
      ∀ i, Nat.card (↥((S : Subgroup G) ⊓ D i)) = 2 := by
  classical
  let F := Finset.univ.image D
  have hmem (i : Fin n) : D i ∈ F :=
    Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩
  have hprodF : IsInternalDirectProduct E F := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hprod.1]
      apply le_antisymm
      · exact iSup_le fun i =>
          le_iSup (fun K : {K : Subgroup G // K ∈ F} => K.val) ⟨D i, hmem i⟩
      · apply iSup_le
        intro K
        obtain ⟨i, _hi, hiK⟩ := Finset.mem_image.mp K.property
        rw [← hiK]
        exact le_iSup D i
    · intro K hKF
      obtain ⟨i, _hi, rfl⟩ := Finset.mem_image.mp hKF
      have hDiE : D i ≤ E := by
        rw [hprod.1]
        exact le_iSup D i
      apply (Subgroup.normal_subgroupOf_iff_le_normalizer hDiE).mpr
      rw [hprod.1]
      apply iSup_le
      intro j
      by_cases hji : j = i
      · subst j
        exact (D i).le_normalizer
      · apply le_trans _ (Subgroup.centralizer_le_normalizer (D i : Set G))
        rw [Subgroup.le_centralizer_iff]
        intro x hx y hy
        exact (hprod.2.2 i j (Ne.symm hji) x hx y hy).symm
    · intro K hKF L hLF hKL
      obtain ⟨i, _hi, rfl⟩ := Finset.mem_image.mp hKF
      obtain ⟨j, _hj, rfl⟩ := Finset.mem_image.mp hLF
      exact hprod.2.1 i j (fun hij => hKL (congrArg D hij))
    · intro K hKF L hLF hKL
      obtain ⟨i, _hi, rfl⟩ := Finset.mem_image.mp hKF
      obtain ⟨j, _hj, rfl⟩ := Finset.mem_image.mp hLF
      exact hprod.2.2 i j (fun hij => hKL (congrArg D hij))
  have hF : ∀ K ∈ F, IsSL2Two K := by
    intro K hKF
    obtain ⟨i, _hi, rfl⟩ := Finset.mem_image.mp hKF
    exact hD i
  obtain ⟨_helem, hgen, _hcard, hcoord⟩ :=
    sl2_product_sylow_coordinates S E hEnormal F hprodF hF
  constructor
  · rw [hgen]
    apply le_antisymm
    · apply iSup_le
      intro K
      obtain ⟨i, _hi, hiK⟩ := Finset.mem_image.mp K.property
      rw [← hiK]
      exact le_iSup (fun i => (S : Subgroup G) ⊓ D i) i
    · apply iSup_le
      intro i
      exact le_iSup (fun K : {K : Subgroup G // K ∈ F} =>
        (S : Subgroup G) ⊓ K.val) ⟨D i, hmem i⟩
  · intro i
    exact hcoord (D i) (hmem i)

private theorem commutator_eq_iSup_right_of_eq_iSup
    {G : Type u} [Group G] (K J : Subgroup G) {I : Sort*}
    (Q : I → Subgroup G) (hQJ : ∀ i, Q i ≤ J)
    (hJnormK : J ≤ Subgroup.normalizer (K : Set G))
    (hJgen : J = ⨆ i, Q i) :
    ⁅K, J⁆ = ⨆ i, ⁅K, Q i⁆ := by
  let hconj : MulDistribMulAction J K :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer J K hJnormK
  let _ : MulDistribMulAction J K := hconj
  let QJ (i : I) : Subgroup J := (Q i).subgroupOf J
  have hQJgen : (⊤ : Subgroup J) = ⨆ i, QJ i := by
    apply (Subgroup.map_injective J.subtype_injective)
    have hmaptop : (⊤ : Subgroup J).map J.subtype = J := by
      ext x
      constructor
      · rintro ⟨y, _hy, rfl⟩
        exact y.property
      · intro hx
        exact ⟨⟨x, hx⟩, trivial, rfl⟩
    rw [hmaptop, Subgroup.map_iSup]
    calc
      J = ⨆ i, Q i := hJgen
      _ = ⨆ i, (QJ i).map J.subtype := by
        congr 1
        funext i
        exact (Subgroup.map_subgroupOf_eq_of_le (hQJ i)).symm
  have hact : commutatorAction (↥(⊤ : Subgroup J)) K =
      ⨆ i, commutatorAction (↥(QJ i)) K :=
    RankOneThreeGroupAssembly.commutatorAction_eq_iSup_of_eq_iSup
      (V := K) QJ hQJgen
  have htop : commutatorAction (↥(⊤ : Subgroup J)) K = commutatorAction J K := by
    rw [commutatorAction_eq_closure, commutatorAction_eq_closure]
    congr 1
    ext z
    constructor
    · rintro ⟨a, k, rfl⟩
      refine ⟨(a : J), k, ?_⟩
      rfl
    · rintro ⟨a, k, rfl⟩
      refine ⟨(⟨a, trivial⟩ : (⊤ : Subgroup J)), k, ?_⟩
      rfl
  have hlocal (i : I) :
      (commutatorAction (↥(QJ i)) K).map K.subtype = ⁅K, Q i⁆ := by
    rw [commutatorAction_eq_closure]
    rw [MonoidHom.map_closure]
    rw [Subgroup.commutator_def]
    congr 1
    ext z
    constructor
    · rintro ⟨x, ⟨a, k, rfl⟩, rfl⟩
      refine ⟨(k : G)⁻¹, K.inv_mem k.property, (a : G), a.property, ?_⟩
      have haction : ((a • k : K) : G) =
          (a : G) * (k : G) * (a : G)⁻¹ := by
        change ((hconj.smul (a : J) k : K) : G) = _
        exact Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe_explicit
          J K hJnormK (a : J) k
      change (k : G)⁻¹ * (a : G) * (k : G)⁻¹⁻¹ * (a : G)⁻¹ =
        (k : G)⁻¹ * ((a • k : K) : G)
      rw [haction]
      group
    · rintro ⟨k, hk, a, ha, rfl⟩
      let aJ : QJ i := ⟨⟨a, hQJ i ha⟩, ha⟩
      let kK : K := ⟨k, hk⟩
      refine ⟨(kK⁻¹)⁻¹ * (aJ • kK⁻¹), ⟨aJ, kK⁻¹, rfl⟩, ?_⟩
      have haction : ((aJ • kK⁻¹ : K) : G) = a * k⁻¹ * a⁻¹ := by
        change ((hconj.smul (aJ : J) kK⁻¹ : K) : G) = _
        exact Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe_explicit
          J K hJnormK (aJ : J) kK⁻¹
      change k⁻¹⁻¹ * ((aJ • kK⁻¹ : K) : G) = k * a * k⁻¹ * a⁻¹
      rw [haction]
      group
  calc
    ⁅K, J⁆ = (commutatorAction J K).map K.subtype :=
      (commutatorAction_subgroup_conj_map_eq_commutator K J hJnormK).symm
    _ = (commutatorAction (↥(⊤ : Subgroup J)) K).map K.subtype := by rw [htop]
    _ = (⨆ i, commutatorAction (↥(QJ i)) K).map K.subtype := by rw [hact]
    _ = ⨆ i, (commutatorAction (↥(QJ i)) K).map K.subtype := by
      rw [Subgroup.map_iSup]
    _ = ⨆ i, ⁅K, Q i⁆ := by
      congr 1
      funext i
      exact hlocal i

private theorem internalOneSevenProduct_derived_eq_iSup
    {G : Type u} [Group G] [Finite G]
    (E : Subgroup G) {n : ℕ} (D : Fin n → Subgroup G)
    (hprod : IsInternalDirectProductFamily E D) :
    (commutator E).map E.subtype =
      ⨆ i, (commutator (D i)).map (D i).subtype := by
  classical
  let P := ∀ i, D i
  let F (i : Fin n) : Subgroup G :=
    (commutator (D i)).map (D i).subtype
  have hcomm : Pairwise (fun i j : Fin n => ∀ x y : G,
      x ∈ D i → y ∈ D j → Commute x y) := by
    intro i j hij x y hx hy
    exact hprod.2.2 i j hij x hx y hy
  let f : P →* G := Subgroup.noncommPiCoprod hcomm
  have hf : f.range = E :=
    (Subgroup.noncommPiCoprod_range).trans hprod.1.symm
  have hmap : (commutator P).map f = (commutator E).map E.subtype := by
    rw [map_commutator_eq, hf, Subgroup.map_subtype_commutator]
  apply le_antisymm
  · rw [← hmap]
    rintro x ⟨p, hp, rfl⟩
    rw [Subgroup.noncommPiCoprod_apply]
    apply Subgroup.noncommProd_mem
    intro i _hi
    apply (le_iSup F i)
    have hpi : p i ∈ commutator (D i) := by
      have hm := Subgroup.mem_map_of_mem
        (Pi.evalMonoidHom (fun i : Fin n => D i) i) hp
      rw [map_commutator_eq] at hm
      exact Subgroup.commutator_mono le_top le_top hm
    exact Subgroup.mem_map_of_mem (D i).subtype hpi
  · apply iSup_le
    intro i
    rw [Subgroup.map_subtype_commutator, Subgroup.map_subtype_commutator]
    have hDiE : D i ≤ E := by
      rw [hprod.1]
      exact le_iSup D i
    exact Subgroup.commutator_mono hDiE hDiE

private theorem eq_bot_or_eq_of_le_card_three
    {G : Type u} [Group G] [Finite G] (A F : Subgroup G)
    (hAF : A ≤ F) (hFcard : Nat.card F = 3) :
    A = ⊥ ∨ A = F := by
  by_cases hA : A = ⊥
  · exact Or.inl hA
  right
  apply le_antisymm hAF
  obtain ⟨x, hxne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hA
  have hxF : (x : G) ∈ F := hAF x.property
  have hxFne : (⟨x, hxF⟩ : F) ≠ 1 := by
    intro hx
    apply hxne
    apply Subtype.ext
    exact congrArg (fun z : F => (z : G)) hx
  let _ : Fact (Nat.Prime 3) := ⟨by decide⟩
  intro y hy
  have hyz : (⟨y, hy⟩ : F) ∈ Subgroup.zpowers (⟨x, hxF⟩ : F) :=
    mem_zpowers_of_prime_card (G := F) (p := 3) hFcard hxFne
  obtain ⟨z, hz⟩ := Subgroup.mem_zpowers_iff.mp hyz
  have hyEq : y = (x : G) ^ z := by
    simpa using congrArg Subtype.val hz.symm
  rw [hyEq]
  exact A.zpow_mem x.property z

public theorem selectedProduct_irreducible_eq_or_cross_fixed
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (E J K L : Subgroup G) (hEnormal : E.Normal)
    (hJ : J = (S : Subgroup G) ⊓ E)
    (hKcomm : ⁅K, J⁆ = K) (hLcomm : ⁅L, J⁆ = L)
    (hKinv : IsConjugateInvariantBy K (S : Subgroup G))
    (hLinv : IsConjugateInvariantBy L (S : Subgroup G))
    (hKirred : IsIrreducibleSection (S : Subgroup G) ⊥ K)
    (hLirred : IsIrreducibleSection (S : Subgroup G) ⊥ L)
    {n : ℕ} (D : Fin n → Subgroup G)
    (hprod : IsInternalDirectProductFamily E D)
    (hinj : Function.Injective D)
    (hD : ∀ i, IsOneSevenFactor (V := V) (D i))
    (hmodule : IsInternalDirectProductFamily (⊤ : Subgroup V)
      (fun i : Option (Fin n) => match i with
        | none => FixedPoints.subgroup E V
        | some i => commutatorAction (D i) V))
    (hKderived : K ≤ (commutator E).map E.subtype)
    (hLderived : L ≤ (commutator E).map E.subtype) :
    K = L ∨
      (commutatorAction L V ≤ FixedPoints.subgroup K V ∧
        commutatorAction K V ≤ FixedPoints.subgroup L V) := by
  classical
  have _hmodule := hmodule
  let Q (i : Fin n) : Subgroup G := (S : Subgroup G) ⊓ D i
  let F (i : Fin n) : Subgroup G :=
    (commutator (D i)).map (D i).subtype
  let R : Subgroup G := (commutator E).map E.subtype
  have hDiE (i : Fin n) : D i ≤ E := by
    rw [hprod.1]
    exact le_iSup D i
  have hJS : J ≤ (S : Subgroup G) := by
    rw [hJ]
    exact inf_le_left
  have hQJ (i : Fin n) : Q i ≤ J := by
    rw [hJ]
    exact le_inf inf_le_left (inf_le_right.trans (hDiE i))
  have hSnormK : (S : Subgroup G) ≤ Subgroup.normalizer (K : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro s hs k hk
    exact hKinv ⟨s, hs⟩ k hk
  have hSnormL : (S : Subgroup G) ≤ Subgroup.normalizer (L : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro s hs l hl
    exact hLinv ⟨s, hs⟩ l hl
  have hJnormK : J ≤ Subgroup.normalizer (K : Set G) := hJS.trans hSnormK
  have hJnormL : J ≤ Subgroup.normalizer (L : Set G) := hJS.trans hSnormL
  obtain ⟨hcoordGen, hQcard⟩ :=
    family_sylow_coordinates S E hEnormal D hprod
      (fun i => (hD i).1)
  have hJgen : J = ⨆ i, Q i := hJ.trans hcoordGen
  have hRgen : R = ⨆ i, F i :=
    internalOneSevenProduct_derived_eq_iSup E D hprod
  have hEnormD (i : Fin n) : E ≤ Subgroup.normalizer (D i : Set G) := by
    rw [hprod.1]
    apply iSup_le
    intro j
    by_cases hji : j = i
    · subst j
      exact (D i).le_normalizer
    · apply le_trans _ (Subgroup.centralizer_le_normalizer (D i : Set G))
      rw [Subgroup.le_centralizer_iff]
      intro x hx y hy
      exact (hprod.2.2 i j (Ne.symm hji) x hx y hy).symm
  have hRleE : R ≤ E := Subgroup.map_subtype_le _
  have hRnormD (i : Fin n) : R ≤ Subgroup.normalizer (D i : Set G) :=
    hRleE.trans (hEnormD i)
  have hFleD (i : Fin n) : F i ≤ D i := Subgroup.map_subtype_le _
  have hRcommD (i : Fin n) : ⁅R, D i⁆ ≤ F i := by
    rw [Subgroup.commutator_comm]
    rw [commutator_eq_iSup_right_of_eq_iSup
      (D i) R F (fun j => by rw [hRgen]; exact le_iSup F j)
      (hRnormD i) hRgen]
    apply iSup_le
    intro j
    by_cases hji : j = i
    · subst j
      calc
        ⁅D i, F i⁆ ≤ ⁅D i, D i⁆ :=
          Subgroup.commutator_mono le_rfl (hFleD i)
        _ = F i := (Subgroup.map_subtype_commutator (D i)).symm
    · have hbot : ⁅D i, F j⁆ = ⊥ := by
        rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
        intro d hd
        rw [Subgroup.mem_centralizer_iff]
        intro f hf
        exact (hprod.2.2 i j (Ne.symm hji) d hd f (hFleD j hf)).symm
      rw [hbot]
      exact bot_le
  have hKlocal (i : Fin n) : ⁅K, Q i⁆ ≤ F i :=
    (Subgroup.commutator_mono hKderived inf_le_right).trans (hRcommD i)
  have hLlocal (i : Fin n) : ⁅L, Q i⁆ ≤ F i :=
    (Subgroup.commutator_mono hLderived inf_le_right).trans (hRcommD i)
  have hKgen : K = ⨆ i, ⁅K, Q i⁆ := by
    calc
      K = ⁅K, J⁆ := hKcomm.symm
      _ = ⨆ i, ⁅K, Q i⁆ :=
        commutator_eq_iSup_right_of_eq_iSup K J Q hQJ hJnormK hJgen
  have hLgen : L = ⨆ i, ⁅L, Q i⁆ := by
    calc
      L = ⁅L, J⁆ := hLcomm.symm
      _ = ⨆ i, ⁅L, Q i⁆ :=
        commutator_eq_iSup_right_of_eq_iSup L J Q hQJ hJnormL hJgen
  have hFcard (i : Fin n) : Nat.card (F i) = 3 := (hD i).2.1.2.1
  have hKlocalCases (i : Fin n) : ⁅K, Q i⁆ = ⊥ ∨ ⁅K, Q i⁆ = F i :=
    eq_bot_or_eq_of_le_card_three _ _ (hKlocal i) (hFcard i)
  have hLlocalCases (i : Fin n) : ⁅L, Q i⁆ = ⊥ ∨ ⁅L, Q i⁆ = F i :=
    eq_bot_or_eq_of_le_card_three _ _ (hLlocal i) (hFcard i)
  by_cases hKL : K = L
  · exact Or.inl hKL
  right
  have hKLdisj : Disjoint K L := by
    rw [Subgroup.disjoint_def]
    have hinv : IsConjugateInvariantBy (K ⊓ L) (S : Subgroup G) := by
      intro s x hx
      exact ⟨hKinv s x hx.1, hLinv s x hx.2⟩
    rcases hKirred.2.2 (K ⊓ L) bot_le inf_le_left hinv with hinf | hinf
    · intro x hxK hxL
      have hxbot : x ∈ (⊥ : Subgroup G) := hinf.le ⟨hxK, hxL⟩
      simpa using hxbot
    · have hKleL : K ≤ L := by
        rw [← hinf]
        exact inf_le_right
      rcases hLirred.2.2 K bot_le hKleL hKinv with hKbot | hKeqL
      · exact (hKirred.2.1 hKbot.symm).elim
      · exact (hKL hKeqL).elim
  have hseparate (i : Fin n) :
      ¬(⁅K, Q i⁆ = F i ∧ ⁅L, Q i⁆ = F i) := by
    rintro ⟨hKi, hLi⟩
    have hFK : F i ≤ K := by
      rw [hKgen]
      exact hKi ▸ le_iSup (fun j => ⁅K, Q j⁆) i
    have hFL : F i ≤ L := by
      rw [hLgen]
      exact hLi ▸ le_iSup (fun j => ⁅L, Q j⁆) i
    have hFbot : F i ≤ ⊥ := by
      intro x hx
      exact hKLdisj.le_bot ⟨hFK hx, hFL hx⟩
    have heq : F i = ⊥ := le_bot_iff.mp hFbot
    have hc := hFcard i
    rw [heq] at hc
    simp at hc
  have hcross
      (X Y : Subgroup G) (Xc Yc : Fin n → Subgroup G)
      (hXgen : X = ⨆ i, Xc i) (hYgen : Y = ⨆ i, Yc i)
      (hXcases : ∀ i, Xc i = ⊥ ∨ Xc i = F i)
      (hYcases : ∀ i, Yc i = ⊥ ∨ Yc i = F i)
      (hsep : ∀ i, ¬(Xc i = F i ∧ Yc i = F i)) :
      commutatorAction Y V ≤ FixedPoints.subgroup X V := by
    rw [RankOneThreeGroupAssembly.commutatorAction_eq_iSup_of_eq_iSup Yc hYgen]
    apply iSup_le
    intro i
    rcases hYcases i with hYi | hYi
    · rw [hYi, commutatorAction_eq_closure, Subgroup.closure_le]
      rintro z ⟨a, v, rfl⟩
      have ha : (a : G) = 1 := a.property
      have ha' : a = 1 := Subtype.ext ha
      subst a
      simp
    · rw [hYi, ← oneSevenFactor_full_commutator_eq_derived (D i) (hD i)]
      intro v hv
      rw [FixedPoints.mem_subgroup]
      intro x
      have hXstab : X ≤ MulAction.stabilizer G v := by
        rw [hXgen]
        apply iSup_le
        intro j
        rcases hXcases j with hXj | hXj
        · rw [hXj]
          exact bot_le
        · have hji : j ≠ i := by
            intro hji
            subst j
            exact hsep i ⟨hXj, hYi⟩
          have hDne : D j ≠ D i := fun hEq => hji (hinj hEq)
          have hfix := oneSevenFactor_commutatorAction_le_fixedPoints
            h (D j) (D i) (hD j) (hD i) hDne hv
          intro y hy
          exact (FixedPoints.mem_subgroup (M := D j) (a := v)).mp hfix
            ⟨y, hFleD j (hXj ▸ hy)⟩
      exact hXstab x.property
  constructor
  · exact hcross K L (fun i => ⁅K, Q i⁆) (fun i => ⁅L, Q i⁆)
      hKgen hLgen hKlocalCases hLlocalCases hseparate
  · exact hcross L K (fun i => ⁅L, Q i⁆) (fun i => ⁅K, Q i⁆)
      hLgen hKgen hLlocalCases hKlocalCases (fun i hboth => hseparate i hboth.symm)

end Stellmacher.SectionOne
