module
public import Stellmacher.SectionOne.SL2ProductNormalizerRigidity

/-!
# SL₂(2) products are generated by conjugates of their Sylow subgroup

For a normal subgroup E generated by SL₂(2) factors, E lies in the ambient
normal closure of S ∩ E, where S is a Sylow 2-subgroup. This is the
normal-closure step identifying E₀ with E in Stellmacher (1.7), Journal
of Algebra 190 (1997), p.19, in `refs/latex/stellmacher-n-group.tex`.

Every square-one element of E is conjugate into S by Sylow conjugacy; the
conjugate stays in E by normality. It therefore lies in the normal closure
of S ∩ E, as does the original element. Each element of SL₂(2) is a product
of two square-one elements, so all the factors, and then their join E, lie
in this normal closure. No action or factor independence is needed for
this implication beyond the generation field of the product hypothesis.
-/

namespace Stellmacher.SectionOne

public theorem sl2_product_le_normalClosure_sylow_inf
    {G : Type*} [Group G] [Finite G]
    (S : Sylow 2 G) (E : Subgroup G) (hE : E.Normal)
    (F : Finset (Subgroup G)) (hprod : IsInternalDirectProduct E F)
    (hSL : ∀ D ∈ F, IsSL2Two D) :
    E ≤ Subgroup.normalClosure (((S : Subgroup G) ⊓ E : Subgroup G) : Set G) := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let N := Subgroup.normalClosure (((S : Subgroup G) ⊓ E : Subgroup G) : Set G)
  have ht (t : G) (htE : t ∈ E) (ht2 : t ^ 2 = 1) : t ∈ N := by
    have htp : IsPGroup 2 (Subgroup.zpowers t) :=
      (IsElementaryAbelian.zpowers_of_pow_eq_one (p := 2) ht2).isPGroup 2 _
    obtain ⟨T, hT⟩ := htp.exists_le_sylow
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G T S
    have htS : g * t * g⁻¹ ∈ (S : Subgroup G) := by
      rw [← hg]
      exact Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom
        (hT (Subgroup.mem_zpowers t))
    have htn : g * t * g⁻¹ ∈ N :=
      Subgroup.le_normalClosure ⟨htS, hE.conj_mem t htE g⟩
    have hback := (inferInstance : N.Normal).conj_mem (g * t * g⁻¹) htn g⁻¹
    simpa [mul_assoc] using hback
  change E ≤ N
  rw [hprod.1]
  refine iSup_le ?_
  intro D
  have hDE : (D : Subgroup G) ≤ E := by
    rw [hprod.1]
    exact le_iSup (fun X : {X : Subgroup G // X ∈ F} => (X : Subgroup G)) D
  intro d hd
  obtain ⟨a, b, ha, hb, hab⟩ := sl2_involution_products (hSL D D.property)
    (⟨d, hd⟩ : (D : Subgroup G))
  have hae : (a : G) ∈ E := hDE a.property
  have hbe : (b : G) ∈ E := hDE b.property
  have ham : (a : G) ∈ N := ht a hae (congrArg Subtype.val ha)
  have hbm : (b : G) ∈ N := ht b hbe (congrArg Subtype.val hb)
  have heq : d = (a : G) * (b : G) := congrArg Subtype.val hab
  exact heq ▸ N.mul_mem ham hbm

end Stellmacher.SectionOne
