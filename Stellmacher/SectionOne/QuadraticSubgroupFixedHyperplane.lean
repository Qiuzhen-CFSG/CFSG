module

public import Stellmacher.SectionOne.LemmaOneTwo
public import Stellmacher.SectionOne.LemmaOneFive

/-!
# A fixed hyperplane for a quadratic subgroup

A quadratic subgroup of a Sylow two-subgroup admits a subgroup of index at
most two whose fixed space escapes any prescribed proper module subgroup,
provided the ambient Section One group is generated by its odd core and
Sylow and the Sylow fixed space generates the module under the group action.

Restrict the acting group to the odd core joined with the quadratic subgroup.
The odd normal complement identifies the latter as a Sylow subgroup. Its
normal two-core centralizes the odd complement; ambient odd-core centralizer
control therefore makes this two-core trivial. Ambient fixed-space generation
passes to this restricted group by the odd-core/Sylow factorization. Apply
(1.2) and choose one fixed space escaping the prescribed proper subgroup.
The trivial quadratic subgroup is handled separately.

This is the hereditary use of Stellmacher (1.2) in (9.3), Journal of Algebra
190 (1997), p.49, relation (2); source `refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionOne
universe u v
open scoped Pointwise

private theorem oddCore_eq_normal_complement
    {H : Type u} [Group H] [Finite H] (N B : Subgroup H) [N.Normal]
    (hcomp : N.IsComplement' B) (hBp : IsPGroup 2 B)
    (hNodd : Nat.Coprime 2 (Nat.card N)) : oddCore H = N := by
  let q : H →* H ⧸ N := QuotientGroup.mk' N
  have hQp : IsPGroup 2 (H ⧸ N) :=
    hBp.of_equiv hcomp.symm.QuotientMulEquiv.symm
  have hmapP : IsPGroup 2 ((oddCore H).map q) := hQp.to_subgroup _
  have hmapOdd : Nat.Coprime 2 (Nat.card ((oddCore H).map q)) :=
    (pPrimeCore_coprime_card (p := 2) (G := H)).of_dvd_right
      (Subgroup.card_map_dvd (H := oddCore H) q)
  have hmapBot : (oddCore H).map q = ⊥ := by
    apply Subgroup.card_eq_one.mp
    rcases hmapP.card_eq_or_dvd with hc | hd
    · exact hc
    · exact False.elim ((Nat.prime_two.coprime_iff_not_dvd.mp hmapOdd) hd)
  apply le_antisymm
  · have hle := (Subgroup.map_eq_bot_iff (f := q) (H := oddCore H)).mp hmapBot
    simpa [q, QuotientGroup.ker_mk'] using hle
  · exact le_sSup ⟨inferInstance, hNodd⟩

private theorem quadratic_subgroup_group_setup
    {G : Type u} {V : Type v} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G) (A : Subgroup G)
    (hAS : A ≤ (S : Subgroup G)) (hAne : A ≠ ⊥) :
    let E : Subgroup G := oddCore G ⊔ A
    ∃ T : Sylow 2 E, (T : Subgroup E) = A.subgroupOf E ∧
      Hypotheses E V ∧ oddCore E = (oddCore G).subgroupOf E := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let W : Subgroup G := oddCore G
  let F : Subgroup G := W
  let E : Subgroup G := F ⊔ A
  let N : Subgroup E := F.subgroupOf E
  let B : Subgroup E := A.subgroupOf E
  let _ : W.Normal := pPrimeCore_normal
  let _ : Group.IsSolvable G := h.G_solvable
  have hAp : IsPGroup 2 A := S.isPGroup'.to_le hAS
  have hFA : F ≤ E := le_sup_left
  have hAE : A ≤ E := le_sup_right
  have hFodd : Nat.Coprime 2 (Nat.card F) := pPrimeCore_coprime_card
  have hNcard : Nat.card N = Nat.card F :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hFA).toEquiv
  have hBcard : Nat.card B = Nat.card A :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAE).toEquiv
  have hNodd : Nat.Coprime 2 (Nat.card N) := by rwa [hNcard]
  have hEnormF : E ≤ Subgroup.normalizer (F : Set G) :=
    Subgroup.le_normalizer_of_normal
  let _ : N.Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hFA).mpr hEnormF
  have hBp : IsPGroup 2 B :=
    hAp.of_equiv (Subgroup.subgroupOfEquivOfLe hAE).symm
  have hcopNB : Nat.Coprime (Nat.card N) (Nat.card B) := by
    obtain ⟨n, hn⟩ := hBp.exists_card_eq
    rw [hn]
    exact hNodd.symm.pow_right n
  have hdisj : Disjoint N B := Subgroup.disjoint_of_coprime_natCard hcopNB
  have hsup : N ⊔ B = ⊤ := (Subgroup.codisjoint_subgroupOf_sup F A).eq_top
  have hcomp : N.IsComplement' B := by
    apply Subgroup.isComplement'_of_disjoint_and_mul_eq_univ hdisj
    rw [Set.eq_univ_iff_forall]
    intro e
    have he : e ∈ N ⊔ B := by rw [hsup]; trivial
    exact Subgroup.mem_sup_of_normal_left.mp he
  let T : Sylow 2 E := hBp.toSylow (by
    rw [hcomp.index_eq_card]
    exact Nat.prime_two.coprime_iff_not_dvd.mp hNodd)
  have hTN : (T : Subgroup E) = B := rfl
  have hoddCore : oddCore E = N := oddCore_eq_normal_complement N B hcomp hBp hNodd
  have hcentB : B ⊓ Subgroup.centralizer (N : Set E) = ⊥ := by
    apply le_bot_iff.mp
    intro b hb
    have hbG : (b : G) ∈ A ⊓ Subgroup.centralizer (F : Set G) := by
      refine ⟨hb.1, ?_⟩
      change (b : G) ∈ Subgroup.centralizer (F : Set G)
      rw [Subgroup.mem_centralizer_iff]
      intro f hf
      exact congrArg Subtype.val
        (Subgroup.mem_centralizer_iff.mp hb.2 (⟨f, hFA hf⟩ : E) hf)
    have hbS : (b : G) ∈ (S : Subgroup G) ⊓
        Subgroup.centralizer (oddCore G : Set G) := ⟨hAS hbG.1, hbG.2⟩
    rw [lemma_one_five_sylow_oddCore_centralizer_bot h S] at hbS
    exact Subtype.ext hbS
  have hcoreB : pCore 2 E ≤ B :=
    (pCore_isPGroup (p := 2) (G := E)).le_sylow_of_normal T
  have hcoreCentN : pCore 2 E ≤ Subgroup.centralizer (N : Set E) := by
    apply Subgroup.commutator_eq_bot_iff_le_centralizer.mp
    have hc : Nat.Coprime (Nat.card (pCore 2 E)) (Nat.card N) := by
      obtain ⟨n, hn⟩ := (pCore_isPGroup (p := 2) (G := E)).exists_card_eq
      rw [hn]
      exact hNodd.pow_left n
    exact le_bot_iff.mp ((Subgroup.commutator_le_inf
      (H₁ := pCore 2 E) (H₂ := N)).trans
        (Subgroup.disjoint_of_coprime_natCard hc).le_bot)
  have hcoreBot : pCore 2 E = ⊥ := by
    apply le_bot_iff.mp
    exact (le_inf hcoreB hcoreCentN).trans (le_of_eq hcentB)
  have hEeven : Even (Nat.card E) := by
    have hAeven : 2 ∣ Nat.card A := by
      rcases hAp.card_eq_or_dvd with hcard | hdvd
      · exact False.elim (hAne (Subgroup.card_eq_one.mp hcard))
      · exact hdvd
    exact even_iff_two_dvd.mpr
      (hAeven.trans (by rw [← hBcard]; exact Subgroup.card_subgroup_dvd_card B))
  have hfaithE : fixingSubgroup E (Set.univ : Set V) = ⊥ := by
    apply le_bot_iff.mp
    intro e he
    have heG : (e : G) ∈ fixingSubgroup G (Set.univ : Set V) := by
      rw [mem_fixingSubgroup_iff] at he ⊢
      intro v hv
      exact he v hv
    rw [h.action_faithful] at heG
    exact Subtype.ext heG
  exact ⟨T, hTN, ⟨inferInstance, hEeven, hfaithE, hcoreBot⟩, hoddCore⟩

private theorem commutatorSubgroup_subgroupOf
    {G : Type u} {V : Type v} [Group G] [Group V] [MulDistribMulAction G V]
    (E A : Subgroup G) (hAE : A ≤ E) (M : Subgroup V) :
    commutatorSubgroup (A.subgroupOf E) V M = commutatorSubgroup A V M := by
  unfold commutatorSubgroup
  congr 1
  ext x
  constructor
  · rintro ⟨a, v, hv, rfl⟩
    exact ⟨⟨((a : E) : G), a.property⟩, v, hv, rfl⟩
  · rintro ⟨a, v, hv, rfl⟩
    exact ⟨⟨⟨a, hAE a.property⟩, a.property⟩, v, hv, rfl⟩

/-- A quadratic subgroup has a subgroup of index at most two whose fixed
space escapes the specified proper subgroup of the module. -/
public theorem exists_fixed_hyperplane_of_quadratic_subgroup
    {G : Type u} {V : Type v} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hG : (⊤ : Subgroup G) = oddCore G ⊔ (S : Subgroup G))
    (hgenerate : (⊤ : Subgroup V) = actionClosure G V (FixedPoints.subgroup S V))
    (Y : Subgroup G) (hYS : Y ≤ (S : Subgroup G))
    (hquadratic : IsQuadraticAction Y V) (R : Subgroup V) (hR : R ≠ ⊤) :
    ∃ Y₀ : Subgroup G, Y₀ ≤ Y ∧ Nat.card Y ≤ 2 * Nat.card Y₀ ∧
      ¬ FixedPoints.subgroup Y₀ V ≤ R := by
  classical
  by_cases hY : Y = ⊥
  · subst Y
    refine ⟨⊥, le_rfl, ?_, ?_⟩
    · simp
    · intro hfixed
      apply hR
      apply top_unique
      apply le_trans ?_ hfixed
      intro x _
      rw [FixedPoints.mem_subgroup]
      intro a
      have ha : (a : G) = 1 := a.property
      change (a : G) • x = x
      rw [ha, one_smul]
  let E : Subgroup G := oddCore G ⊔ Y
  have hYE : Y ≤ E := le_sup_right
  have hWE : oddCore G ≤ E := le_sup_left
  obtain ⟨T, hTY, hE, hodd⟩ := quadratic_subgroup_group_setup h S Y hYS hY
  have hTquad : IsQuadraticAction T V := by
    rw [hTY]
    change commutatorSubgroup (Y.subgroupOf E) V
      (commutatorSubgroup (Y.subgroupOf E) V ⊤) = ⊥
    rw [commutatorSubgroup_subgroupOf E Y hYE,
      commutatorSubgroup_subgroupOf E Y hYE]
    exact hquadratic
  have hEG : (⊤ : Subgroup E) = oddCore E ⊔ (T : Subgroup E) := by
    rw [hodd, hTY]
    exact (Subgroup.codisjoint_subgroupOf_sup (oddCore G) Y).eq_top.symm
  have hgenE : (⊤ : Subgroup V) =
      actionClosure E V (FixedPoints.subgroup T V) := by
    apply le_antisymm ?_ le_top
    rw [hgenerate, actionClosure]
    apply (Subgroup.closure_le _).mpr
    rintro x ⟨g, v, hv, rfl⟩
    have hg : g ∈ oddCore G ⊔ (S : Subgroup G) := by rw [← hG]; trivial
    let _ : (oddCore G).Normal := pPrimeCore_normal
    obtain ⟨w, hw, t, ht, rfl⟩ := Subgroup.mem_sup_of_normal_left.mp hg
    have htfix : t • v = v := hv ⟨t, ht⟩
    rw [mul_smul, htfix]
    apply Subgroup.subset_closure
    refine ⟨⟨w, hWE hw⟩, v, ?_, rfl⟩
    rw [FixedPoints.mem_subgroup]
    intro a
    have haY : ((a : E) : G) ∈ Y := by
      exact hTY.le a.property
    exact hv ⟨((a : E) : G), hYS haY⟩
  have hfixedgen := lemma_one_two hE T hEG hTquad hgenE
  obtain ⟨T₀, hcard, hescape⟩ : ∃ T₀ : Subgroup T,
      Nat.card T = 2 * Nat.card T₀ ∧ ¬ FixedPoints.subgroup T₀ V ≤ R := by
    by_contra! hall
    apply hR
    apply top_unique
    rw [hfixedgen]
    exact iSup_le fun T₀ => iSup_le fun hc => hall T₀ hc
  let f : T →* G := E.subtype.comp (T : Subgroup E).subtype
  have hf : Function.Injective f := E.subtype_injective.comp
    (T : Subgroup E).subtype_injective
  let Y₀ := T₀.map f
  have hTcard : Nat.card T = Nat.card Y := by
    rw [hTY]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hYE).toEquiv
  have hY₀card : Nat.card Y₀ = Nat.card T₀ := Subgroup.card_map_of_injective hf
  refine ⟨Y₀, ?_, ?_, ?_⟩
  · rintro x ⟨t, _, rfl⟩
    exact hTY.le t.property
  · rw [hY₀card, ← hTcard, hcard]
  · intro hfixed
    apply hescape
    apply le_trans ?_ hfixed
    intro v hv
    rw [FixedPoints.mem_subgroup] at hv ⊢
    rintro ⟨a, ha⟩
    obtain ⟨t, ht, rfl⟩ := ha
    exact hv ⟨t, ht⟩

end Stellmacher.SectionOne
