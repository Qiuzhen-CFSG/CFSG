module

public import Stellmacher.SectionOne.RankOneExceptionalAction
public import Stellmacher.SectionOne.ExceptionalGroupClassification

/-!
# The exceptional branch with an explicit bound on m

Under the higher-rank local recursive hypotheses of Stellmacher (1.6),
failure of genericity and m(S)≤2 give the full exceptional alternative:
m(S)=2, G is SL2(2) × SL2(2), V*=[V,O₂′(G)] has order sixteen, and
its S-action is nonquadratic. The action assembly proves all numerical
and action fields, including Sylow order four and odd-core order nine.
The independent finite-group classification then identifies the full
ambient group, without assuming it is generated by its odd core and S.

The extra m-bound is explicit. This does not replace the audited false
unrestricted m(S)=2 assertion; it preserves the exact four-field conclusion
for the bounded range needed by later applications.
Source: `refs/latex/stellmacher-n-group.tex`, (1.6), journal p.18.
-/

namespace Stellmacher.SectionOne
open RankOneThreeGroupAssembly
universe u

public theorem rank_one_three_group_exceptional_branch_of_m_le_two
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hS : IsElementaryAbelian 2 (S : Subgroup G))
    (hScard : 4 ≤ Nat.card (S : Subgroup G))
    (hW : oddCore G = ⁅oddCore G, (S : Subgroup G)⁆)
    (hWthree : IsPGroup 3 (oddCore G))
    (hmin : ∀ Y : Subgroup G, Y ≤ (S : Subgroup G) → Y ≠ ⊥ →
      m (G := G) (V := V) (S : Subgroup G) ≤ m (G := G) (V := V) Y)
    (hlocal : RankOneAssemblyLocalHypothesis (G := G) (V := V) (S : Subgroup G))
    (hnongeneric : ¬ RankOneAssemblyGenericHypothesis (G := G) (V := V) (S : Subgroup G))
    (hm : m (G := G) (V := V) (S : Subgroup G) ≤ 2) :
    m (G := G) (V := V) (S : Subgroup G) = 2 ∧
      Nonempty (G ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2) ×
        Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) ∧
      Nat.card (commutatorAction (oddCore G) V) = 2 ^ 4 ∧
      vStarAction₂ (G := G) (V := V) (S : Subgroup G) ≠ ⊥ := by
  obtain ⟨hmEq, hSfour, hWcard, hVstar, hnonquad⟩ :=
    rank_one_exceptional_small_m_action_conclusions h S hS hW hWthree hmin hlocal hnongeneric hm
  exact ⟨hmEq, group_mulEquiv_sl2Two_prod_of_oddCore_card_nine h S hS
    (le_antisymm hSfour.le hScard) hWcard,
    hVstar, hnonquad⟩

end Stellmacher.SectionOne

