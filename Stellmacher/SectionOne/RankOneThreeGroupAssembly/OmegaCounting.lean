module

public import Stellmacher.SectionOne.RankOneThreeGroupAssembly.Basic
public import Stellmacher.SectionOne.RankOneThreeGroupAssembly.OmegaGeneration
public import Stellmacher.SectionOne.RankOneThreeGroupAssembly.OmegaIndependence

/-!
# Counting the complete omega product

Independent omega factors contribute powers of three to the group and powers of four to the action module. Their commutativity upgrades the local-generation theorem to exact odd-core generation.

This module supports the rank-at-least-two case of Stellmacher (1.6).
The action is on an elementary abelian two-group; the local hypotheses and
minimal-offender conditions are explicit in the declarations that use them.
Source: `refs/latex/stellmacher-n-group.tex`, proof of (1.6), journal pp.18–19.
-/

open scoped Pointwise symmDiff

namespace Stellmacher.SectionOne.RankOneThreeGroupAssembly

universe u v

/-- A finite supremum can be read either through `Finset.sup` or as the
indexed supremum over its subtype of members. -/
private theorem finset_sup_eq_iSup_subtype
    {G : Type u} [Group G] (T : Finset (Subgroup G)) :
    T.sup id = ⨆ F : {F : Subgroup G // F ∈ T}, (F : Subgroup G) := by
  apply le_antisymm
  · apply Finset.sup_le
    intro F hF
    exact le_iSup (fun X : {X : Subgroup G // X ∈ T} => (X : Subgroup G))
      ⟨F, hF⟩
  · refine iSup_le ?_
    intro F
    exact Finset.le_sup (s := T) (f := id) F.property

public theorem finset_sup_apply_eq_iSup_subtype
    {G : Type u} [Group G] {ι : Type*}
    (T : Finset ι) (K : ι → Subgroup G) :
    T.sup K = ⨆ i : {i : ι // i ∈ T}, K i := by
  apply le_antisymm
  · apply Finset.sup_le
    intro i hi
    exact le_iSup (fun j : {j : ι // j ∈ T} => K j) ⟨i, hi⟩
  · refine iSup_le ?_
    intro i
    exact Finset.le_sup (s := T) (f := K) i.property

/-- The subgroup generated by the complete `oneOmega` family is abelian.
For distinct factors this is part of Lemma (1.4); a single factor is cyclic
because it has prime order three. -/
public theorem oneOmegaGenerated_isMulCommutative
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [MulDistribMulAction G V]
    (hdecomp : LemmaOneFourConclusion (G := G) (V := V)
      (oneOmegaGenerated (G := G) (V := V))
      (oneOmegaFinset (G := G) (V := V))) :
    IsMulCommutative (oneOmegaGenerated (G := G) (V := V)) := by
  apply Subgroup.le_centralizer_iff_isMulCommutative.mp
  rw [hdecomp.part_a.1]
  refine iSup_le ?_
  intro D
  rw [Subgroup.le_centralizer_iff]
  refine iSup_le ?_
  intro E
  by_cases hED : (E : Subgroup G) = (D : Subgroup G)
  · rw [hED]
    have hcyc : IsCyclic D := by
      let hprime : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
      let _ : Fact (Nat.Prime 3) := hprime
      exact isCyclic_of_prime_card
        ((mem_oneOmegaFinset_iff (G := G) (V := V) (D : Subgroup G)).mp
          D.property).2.1
    let _ : IsCyclic D := hcyc
    exact Subgroup.le_centralizer_iff_isMulCommutative.mpr inferInstance
  · intro e he
    rw [Subgroup.mem_centralizer_iff]
    intro d hd
    exact hdecomp.part_a.2.2.2 (D : Subgroup G) D.property
      (E : Subgroup G) E.property (fun h => hED h.symm) d hd e he

/-- Every finite subfamily of the complete omega coordinates has the
expected order.  Coordinate independence comes from their mutually
distinguishing order-four action modules, rather than merely from the
pairwise-disjoint field of the recorded internal product. -/
public theorem natCard_finset_sup_oneOmega
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (hdecomp : LemmaOneFourConclusion (G := G) (V := V)
      (oneOmegaGenerated (G := G) (V := V))
      (oneOmegaFinset (G := G) (V := V)))
    (T : Finset (Subgroup G))
    (hT : ∀ F ∈ T, oneOmega (G := G) (V := V) F) :
    Nat.card ↥(T.sup id) = 3 ^ T.card := by
  classical
  induction T using Finset.induction_on with
  | empty => simp
  | @insert F T hFT ih =>
      have hF : oneOmega (G := G) (V := V) F := hT F (by simp)
      have hTrest : ∀ E ∈ T, oneOmega (G := G) (V := V) E := by
        intro E hE
        exact hT E (Finset.mem_insert_of_mem hE)
      have hdisjIndexed : Disjoint F
          (⨆ E : {E : Subgroup G // E ∈ T}, (E : Subgroup G)) := by
        apply oneOmega_disjoint_iSup_of_distinct hdecomp F hF
          (fun E : {E : Subgroup G // E ∈ T} => (E : Subgroup G))
          (fun E => hTrest E E.property)
        intro E hEF
        exact hFT (hEF ▸ E.property)
      have hdisj : Disjoint F (T.sup id) := by
        rw [finset_sup_eq_iSup_subtype T]
        exact hdisjIndexed
      let W : Subgroup G := oneOmegaGenerated (G := G) (V := V)
      have hFleW : F ≤ W := by
        change F ≤ oneOmegaGenerated (G := G) (V := V)
        rw [hdecomp.part_a.1]
        exact le_iSup
          (fun E : {E : Subgroup G //
            E ∈ oneOmegaFinset (G := G) (V := V)} => (E : Subgroup G))
          ⟨F, (mem_oneOmegaFinset_iff (G := G) (V := V) F).mpr hF⟩
      have hTleW : T.sup id ≤ W := by
        apply Finset.sup_le
        intro E hE
        change E ≤ oneOmegaGenerated (G := G) (V := V)
        rw [hdecomp.part_a.1]
        exact le_iSup
          (fun D : {D : Subgroup G //
            D ∈ oneOmegaFinset (G := G) (V := V)} => (D : Subgroup G))
          ⟨E, (mem_oneOmegaFinset_iff (G := G) (V := V) E).mpr
            (hTrest E hE)⟩
      have hWW : W ≤ Subgroup.centralizer (W : Set G) :=
        Subgroup.le_centralizer_iff_isMulCommutative.mpr
          (oneOmegaGenerated_isMulCommutative hdecomp)
      have hcomm : T.sup id ≤ Subgroup.centralizer (F : Set G) := by
        intro x hx
        rw [Subgroup.mem_centralizer_iff]
        intro f hf
        exact (Subgroup.mem_centralizer_iff.mp (hWW (hTleW hx))) f
          (hFleW hf)
      rw [Finset.sup_insert]
      change Nat.card ↥(F ⊔ T.sup id) = 3 ^ (insert F T).card
      rw [natCard_sup_eq_mul_of_disjoint_of_le_centralizer F (T.sup id)
          hdisj hcomm,
        hF.2.1, ih hTrest, Finset.card_insert_of_notMem hFT,
        pow_succ, Nat.mul_comm]

/-- The action modules of a finite family of complete omega factors form a
genuine product of four-point coordinates. -/
public theorem natCard_finset_sup_oneOmega_action
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (hdecomp : LemmaOneFourConclusion (G := G) (V := V)
      (oneOmegaGenerated (G := G) (V := V))
      (oneOmegaFinset (G := G) (V := V)))
    (T : Finset (Subgroup G))
    (hT : ∀ F ∈ T, oneOmega (G := G) (V := V) F) :
    Nat.card ↥(T.sup (fun F => commutatorAction F V)) = 4 ^ T.card := by
  classical
  induction T using Finset.induction_on with
  | empty => simp
  | @insert F T hFT ih =>
      have hF : oneOmega (G := G) (V := V) F := hT F (by simp)
      have hTrest : ∀ E ∈ T, oneOmega (G := G) (V := V) E := by
        intro E hE
        exact hT E (Finset.mem_insert_of_mem hE)
      have hdisjIndexed : Disjoint (commutatorAction F V)
          (⨆ E : {E : Subgroup G // E ∈ T},
            commutatorAction (E : Subgroup G) V) := by
        apply oneOmega_action_disjoint_iSup_of_distinct hdecomp F hF
          (fun E : {E : Subgroup G // E ∈ T} => (E : Subgroup G))
          (fun E => hTrest E E.property)
        intro E hEF
        exact hFT (hEF ▸ E.property)
      have hdisj : Disjoint (commutatorAction F V)
          (T.sup (fun E => commutatorAction E V)) := by
        rw [finset_sup_apply_eq_iSup_subtype T]
        exact hdisjIndexed
      have hcomm : T.sup (fun E => commutatorAction E V) ≤
          Subgroup.centralizer (commutatorAction F V : Set V) := by
        intro x hx
        rw [Subgroup.mem_centralizer_iff]
        intro y hy
        exact (IsMulCommutative.is_comm (M := V)).comm y x
      rw [Finset.sup_insert]
      change Nat.card ↥(commutatorAction F V ⊔
        T.sup (fun E => commutatorAction E V)) = 4 ^ (insert F T).card
      rw [natCard_sup_eq_mul_of_disjoint_of_le_centralizer
          (commutatorAction F V)
          (T.sup (fun E => commutatorAction E V)) hdisj hcomm,
        hF.2.2, ih hTrest, Finset.card_insert_of_notMem hFT,
        pow_succ, Nat.mul_comm]

public theorem isInvariant_finset_sup
    {A V ι : Type*} [Group A] [Group V] [MulDistribMulAction A V]
    (T : Finset ι) (K : ι → Subgroup V)
    (hK : ∀ i ∈ T, IsInvariant A V (K i)) :
    IsInvariant A V (T.sup K) := by
  classical
  induction T using Finset.induction_on with
  | empty =>
      simp
      exact ⟨fun a v => by
        constructor
        · intro hv
          rw [hv]
          simp
        · intro hv
          have hback := congrArg (fun z => a⁻¹ • z) hv
          simpa using hback⟩
  | @insert i T hi ih =>
      rw [Finset.sup_insert]
      let hKi : IsInvariant A V (K i) := hK i (by simp)
      let hKT : IsInvariant A V (T.sup K) := ih fun j hj =>
        hK j (Finset.mem_insert_of_mem hj)
      let _ : IsInvariant A V (K i) := hKi
      let _ : IsInvariant A V (T.sup K) := hKT
      exact isInvariant_sup (K i) (T.sup K)

/-- Once the odd core is the complete `oneOmega` product, the local
commutators from Lemma (1.5)(d) actually generate it.  The missing reverse
inclusion is obtained inside `W ⊔ S`: the complete omega product makes `W`
abelian, hence every local commutator is normal in that join, and the quotient
generation argument applies. -/
public theorem oddCore_eq_iSup_local_commutators_of_oneOmega_decomposition
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hS_elem : IsElementaryAbelian 2 (S : Subgroup G))
    (hScard : 4 ≤ Nat.card (S : Subgroup G))
    (hW : oddCore G = ⁅oddCore G, (S : Subgroup G)⁆)
    (hcoreEq : oddCore G = oneOmegaGenerated (G := G) (V := V))
    (hdecomp : LemmaOneFourConclusion (G := G) (V := V)
      (oneOmegaGenerated (G := G) (V := V))
      (oneOmegaFinset (G := G) (V := V))) :
    let I := {A : Subgroup G //
      oneAmax (G := G) (V := V) (S : Subgroup G) A ∧ Nat.card A = 2}
    oddCore G = ⨆ A : I,
      ⁅oddCore G ⊓ Subgroup.centralizer ((A : Subgroup G) : Set G),
        (S : Subgroup G)⁆ := by
  let W : Subgroup G := oddCore G
  let H : Subgroup G := W ⊔ (S : Subgroup G)
  let I := {A : Subgroup G //
    oneAmax (G := G) (V := V) (S : Subgroup G) A ∧ Nat.card A = 2}
  let C : I → Subgroup G := fun A =>
    W ⊓ Subgroup.centralizer ((A : Subgroup G) : Set G)
  let WA : I → Subgroup G := fun A => ⁅C A, (S : Subgroup G)⁆
  have hgenC : W = ⨆ A : I, C A := by
    simpa only [W, I, C] using
      (lemma_one_five h S (S : Subgroup G) le_rfl).part_d hS_elem hScard
  have hWcomm : IsMulCommutative W := by
    change IsMulCommutative (oddCore G)
    rw [hcoreEq]
    exact oneOmegaGenerated_isMulCommutative hdecomp
  have hWAleW (A : I) : WA A ≤ W := by
    let _ : W.Normal := pPrimeCore_normal
    exact (Subgroup.commutator_mono inf_le_left le_rfl).trans
      (Subgroup.commutator_le_left W (S : Subgroup G))
  have hCleH (A : I) : C A ≤ H :=
    (inf_le_left : C A ≤ W).trans le_sup_left
  have hWAleH (A : I) : WA A ≤ H := (hWAleW A).trans le_sup_left
  let CH : I → Subgroup H := fun A => (C A).subgroupOf H
  let WAH : I → Subgroup H := fun A => (WA A).subgroupOf H
  let N : Subgroup H := ⨆ A : I, WAH A
  have hWANormal (A : I) : (WAH A).Normal := by
    have hWnorm : W ≤ Subgroup.normalizer (WA A) := by
      exact ((Subgroup.le_centralizer_iff).mpr
        ((hWAleW A).trans
          (Subgroup.le_centralizer_iff_isMulCommutative.mpr hWcomm))).trans
        (Subgroup.centralizer_le_normalizer (WA A : Set G))
    have hSnorm : (S : Subgroup G) ≤ Subgroup.normalizer (WA A) := by
      exact Subgroup.normalizer_commutator_ge_right (C A) (S : Subgroup G)
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer (hWAleH A)).2
      (sup_le hWnorm hSnorm)
  have hNnormal : N.Normal := by
    dsimp only [N]
    simpa using Subgroup.biSup_normal Set.univ WAH (fun A _ => hWANormal A)
  let _ : N.Normal := hNnormal
  have hgenCH : W.subgroupOf H = ⨆ A : I, CH A := by
    apply Subgroup.map_injective H.subtype_injective
    calc
      (W.subgroupOf H).map H.subtype = W :=
        Subgroup.map_subgroupOf_eq_of_le le_sup_left
      _ = ⨆ A : I, C A := hgenC
      _ = ⨆ A : I, (CH A).map H.subtype := by
        congr 1
        funext A
        exact (Subgroup.map_subgroupOf_eq_of_le (hCleH A)).symm
      _ = (⨆ A : I, CH A).map H.subtype := by
        rw [Subgroup.map_iSup]
  have hlocalComm (A : I) :
      ⁅CH A, (S : Subgroup G).subgroupOf H⁆ ≤ N := by
    intro x hx
    have hxmap : ((x : H) : G) ∈
        (⁅CH A, (S : Subgroup G).subgroupOf H⁆).map H.subtype :=
      ⟨x, hx, rfl⟩
    rw [commutator_subgroupOf_map_eq (S := H)
      (H := (S : Subgroup G)) (R := C A) le_sup_right (hCleH A)] at hxmap
    exact le_iSup WAH A hxmap
  have hcommLe :
      ⁅W.subgroupOf H, (S : Subgroup G).subgroupOf H⁆ ≤ N :=
    commutator_le_normal_of_eq_iSup
      (W.subgroupOf H) ((S : Subgroup G).subgroupOf H) N CH hgenCH hlocalComm
  have hWsubEq : W.subgroupOf H =
      ⁅W.subgroupOf H, (S : Subgroup G).subgroupOf H⁆ := by
    apply Subgroup.map_injective H.subtype_injective
    rw [commutator_subgroupOf_map_eq (S := H)
      (H := (S : Subgroup G)) (R := W) le_sup_right le_sup_left,
      Subgroup.map_subgroupOf_eq_of_le le_sup_left]
    exact hW
  have hWsubLeN : W.subgroupOf H ≤ N := by rw [hWsubEq]; exact hcommLe
  have hNleWsub : N ≤ W.subgroupOf H := by
    dsimp only [N]
    refine iSup_le ?_
    intro A x hx
    exact hWAleW A hx
  have hNeq : N = W.subgroupOf H := le_antisymm hNleWsub hWsubLeN
  change W = ⨆ A : I, WA A
  calc
    W = (W.subgroupOf H).map H.subtype :=
      (Subgroup.map_subgroupOf_eq_of_le le_sup_left).symm
    _ = N.map H.subtype := congrArg (fun X : Subgroup H => X.map H.subtype) hNeq.symm
    _ = (⨆ A : I, WAH A).map H.subtype := rfl
    _ = ⨆ A : I, (WAH A).map H.subtype := by rw [Subgroup.map_iSup]
    _ = ⨆ A : I, WA A := by
      congr 1
      funext A
      exact Subgroup.map_subgroupOf_eq_of_le (hWAleH A)

end Stellmacher.SectionOne.RankOneThreeGroupAssembly
