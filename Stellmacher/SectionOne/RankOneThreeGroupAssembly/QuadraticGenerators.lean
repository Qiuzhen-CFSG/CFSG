/-!
# Quadratic generators and the omega cover count

Quadratic action of order-two generators propagates when their fixed subgroups agree. Comparing the local cover with the complete omega family counts the additional distinguished support coordinates.

This module supports the rank-at-least-two case of Stellmacher (1.6).
The action is on an elementary abelian two-group; the local hypotheses and
minimal-offender conditions are explicit in the declarations that use them.
Source: `refs/latex/stellmacher-n-group.tex`, proof of (1.6), journal pp.18–19.
-/

open scoped Pointwise symmDiff

namespace Stellmacher.SectionOne.RankOneThreeGroupAssembly

universe u v

/-- If an elementary abelian actor is generated by order-two subgroups whose
fixed points on an invariant summand already equal the full actor's fixed
points, then its action on that summand is quadratic. -/
public theorem commutatorAction₂_invariant_subgroup_eq_bot_of_card_two_generators
    {G V I : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (S A : Subgroup G) (B : I → Subgroup G) (C : Subgroup V)
    [IsInvariant G V C]
    (hgen : S = A ⊔ ⨆ i, B i)
    (hAcard : Nat.card A = 2) (hBcard : ∀ i, Nat.card (B i) = 2)
    (hfixA : C ⊓ FixedPoints.subgroup S V =
      C ⊓ FixedPoints.subgroup A V)
    (hfixB : ∀ i, C ⊓ FixedPoints.subgroup S V =
      C ⊓ FixedPoints.subgroup (B i) V) :
    let hCinvS : IsInvariant S V C := isInvariant_restrict_actor S C
    let _ : IsInvariant S V C := hCinvS
    commutatorAction₂ S C = ⊥ := by
  let hCinvS : IsInvariant S V C := isInvariant_restrict_actor S C
  let _ : IsInvariant S V C := hCinvS
  let _ : IsElementaryAbelian 2 C := isElementaryAbelian_subgroup C
  let hCinvA : IsInvariant A V C := isInvariant_restrict_actor A C
  let _ : IsInvariant A V C := hCinvA
  let hCinvB (i : I) : IsInvariant (B i) V C :=
    isInvariant_restrict_actor (B i) C
  have hfixedRestrictedA : FixedPoints.subgroup S C =
      FixedPoints.subgroup A C := by
    apply Subgroup.map_injective C.subtype_injective
    rw [fixedPoints_subgroup_map_subtype_eq_inf C,
      fixedPoints_subgroup_map_subtype_eq_inf C]
    exact hfixA
  have hfixedRestrictedB (i : I) : FixedPoints.subgroup S C =
      FixedPoints.subgroup (B i) C := by
    let _ : IsInvariant (B i) V C := hCinvB i
    apply Subgroup.map_injective C.subtype_injective
    rw [fixedPoints_subgroup_map_subtype_eq_inf C,
      fixedPoints_subgroup_map_subtype_eq_inf C]
    exact hfixB i
  have hcommA : commutatorAction A C ≤ FixedPoints.subgroup S C := by
    have hquadA : commutatorAction₂ A C = ⊥ :=
      commutatorAction₂_eq_bot_of_actor_card_two hAcard
    rw [hfixedRestrictedA]
    intro d hd
    rw [FixedPoints.mem_subgroup]
    intro a
    have hdelta : d⁻¹ * (a • d) ∈ commutatorAction₂ A C :=
      Subgroup.subset_closure ⟨a, d, hd, rfl⟩
    rw [hquadA] at hdelta
    exact (eq_of_inv_mul_eq_one (by simpa using hdelta)).symm
  have hcommB (i : I) : commutatorAction (B i) C ≤
      FixedPoints.subgroup S C := by
    let _ : IsInvariant (B i) V C := hCinvB i
    have hquadB : commutatorAction₂ (B i) C = ⊥ :=
      commutatorAction₂_eq_bot_of_actor_card_two (hBcard i)
    rw [hfixedRestrictedB i]
    intro d hd
    rw [FixedPoints.mem_subgroup]
    intro b
    have hdelta : d⁻¹ * (b • d) ∈ commutatorAction₂ (B i) C :=
      Subgroup.subset_closure ⟨b, d, hd, rfl⟩
    rw [hquadB] at hdelta
    exact (eq_of_inv_mul_eq_one (by simpa using hdelta)).symm
  let K : Option I → Subgroup G
    | none => A
    | some i => B i
  have hgen' : S = ⨆ i, K i := by
    rw [hgen]
    simp only [K, iSup_option]
  have hcommEq : commutatorAction S C =
      ⨆ i, commutatorAction (K i) C :=
    commutatorAction_eq_iSup_of_eq_iSup K hgen'
  apply commutatorAction₂_eq_bot_of_le_fixedPoints
  rw [hcommEq]
  apply iSup_le
  intro i
  cases i with
  | none => exact hcommA
  | some i => exact hcommB i

/-- A complete omega factor contained in the join of a family of complete
omega factors is one of the displayed factors.  This is the relative form
of coordinate uniqueness; it only needs containment in the join. -/
public theorem oneOmega_eq_member_of_le_iSup
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (hdecomp : LemmaOneFourConclusion (G := G) (V := V)
      (oneOmegaGenerated (G := G) (V := V))
      (oneOmegaFinset (G := G) (V := V)))
    {I : Sort*} (K : I → Subgroup G)
    (hKomega : ∀ i, oneOmega (G := G) (V := V) (K i))
    (F : Subgroup G) (hFomega : oneOmega (G := G) (V := V) F)
    (hFle : F ≤ ⨆ i, K i) : ∃ i, F = K i := by
  classical
  by_contra hnone
  push Not at hnone
  have hdisj : Disjoint F (⨆ i, K i) :=
    oneOmega_disjoint_iSup_of_distinct hdecomp F hFomega K hKomega
      (fun i => (hnone i).symm)
  have hFbot : F = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    intro f hf
    exact Subgroup.disjoint_def.mp hdisj hf (hFle hf)
  have hcard := hFomega.2.1
  rw [hFbot] at hcard
  norm_num at hcard

/-- If `Z` lists the complete omega factors outside a locally generated
family and the two lists are disjoint, then the complete omega finset has
cardinality `|I| + |Z|`. -/
private theorem oneOmegaFinset_card_eq_add_of_local_cover
    {G V I : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V] [Finite I]
    (hdecomp : LemmaOneFourConclusion (G := G) (V := V)
      (oneOmegaGenerated (G := G) (V := V))
      (oneOmegaFinset (G := G) (V := V)))
    (K : I → Subgroup G) (hKinj : Function.Injective K)
    (hKomega : ∀ i, oneOmega (G := G) (V := V) (K i))
    (Z : Finset (Subgroup G))
    (hZsub : Z ⊆ oneOmegaFinset (G := G) (V := V))
    (hKnotZ : ∀ i, K i ∉ Z)
    (hcover : ∀ F : Subgroup G,
      oneOmega (G := G) (V := V) F → F ∉ Z → F ≤ ⨆ i, K i) :
    (oneOmegaFinset (G := G) (V := V)).card = Nat.card I + Z.card := by
  classical
  let _ : Fintype I := Fintype.ofFinite I
  let KI : Finset (Subgroup G) := Finset.univ.image K
  have hEq : oneOmegaFinset (G := G) (V := V) = Z ∪ KI := by
    ext F
    constructor
    · intro hFmem
      have hFomega :=
        (mem_oneOmegaFinset_iff (G := G) (V := V) F).mp hFmem
      by_cases hFZ : F ∈ Z
      · exact Finset.mem_union_left KI hFZ
      · obtain ⟨i, hi⟩ := oneOmega_eq_member_of_le_iSup
          hdecomp K hKomega F hFomega (hcover F hFomega hFZ)
        apply Finset.mem_union_right Z
        rw [Finset.mem_image]
        exact ⟨i, Finset.mem_univ i, hi.symm⟩
    · intro hF
      rw [Finset.mem_union] at hF
      rcases hF with hFZ | hFK
      · exact hZsub hFZ
      · rw [Finset.mem_image] at hFK
        obtain ⟨i, _hi, rfl⟩ := hFK
        exact (mem_oneOmegaFinset_iff (G := G) (V := V) (K i)).mpr
          (hKomega i)
  have hdisj : Disjoint Z KI := by
    rw [Finset.disjoint_left]
    intro F hFZ hFK
    rw [Finset.mem_image] at hFK
    obtain ⟨i, _hi, rfl⟩ := hFK
    exact hKnotZ i hFZ
  rw [hEq, Finset.card_union_of_disjoint hdisj,
    Finset.card_image_iff.mpr hKinj.injOn,
    Finset.card_univ, Nat.card_eq_fintype_card, Nat.add_comm]

/-- For the local family belonging to `A`, the complete omega factors are
exactly the factors moved by `A` together with the locally lifted factors,
which are fixed by `A`. -/
public theorem local_generic_coordinate_family_omega_card
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (S A : Subgroup G) (hS : IsElementaryAbelian 2 S)
    (hnorm : ∀ K : Subgroup G, oneOmega (G := G) (V := V) K →
      S ≤ Subgroup.normalizer K)
    (hcoreEq : oddCore G = oneOmegaGenerated (G := G) (V := V))
    (hdecomp : LemmaOneFourConclusion (G := G) (V := V)
      (oneOmegaGenerated (G := G) (V := V))
      (oneOmegaFinset (G := G) (V := V)))
    (hW : oddCore G = ⁅oddCore G, S⁆)
    (a : S) (hAeq : A = Subgroup.zpowers (a : G))
    (d : LocalGenericCoordinateFamily (G := G) (V := V)
      ⁅oddCore G ⊓ Subgroup.centralizer (A : Set G), S⁆ S A) :
    (oneOmegaFinset (G := G) (V := V)).card =
      Nat.card d.index +
        (omegaSupport (G := G) (V := V) S hnorm a).card := by
  classical
  let _ : Finite d.index := d.index_finite
  let W_A := ⁅oddCore G ⊓ Subgroup.centralizer (A : Set G), S⁆
  let Z := omegaSupport (G := G) (V := V) S hnorm a
  have hfactorLe (i : d.index) : d.factor i ≤ W_A := by
    calc
      d.factor i ≤ ⨆ j, d.factor j := le_iSup d.factor i
      _ = W_A := d.factor_generated.symm
  have hKnot (i : d.index) : d.factor i ∉ Z := by
    apply oneOmega_not_mem_support_of_le_local_commutator
      S hS hnorm a (d.factor i) (d.factor_omega i)
    rw [← hAeq]
    exact hfactorLe i
  exact oneOmegaFinset_card_eq_add_of_local_cover hdecomp d.factor
    d.factor_injective d.factor_omega Z
    (omegaSupport_subset_oneOmegaFinset S hnorm a) hKnot
    (fun F hF hFnot => by
      calc
        F ≤ W_A := by
          change F ≤ ⁅oddCore G ⊓
            Subgroup.centralizer (A : Set G), S⁆
          rw [hAeq]
          exact oneOmega_le_local_commutator_of_not_mem_support
            S hnorm hcoreEq hdecomp hW a F hF hFnot
        _ = ⨆ i, d.factor i := d.factor_generated)

/-- A nonidentity Sylow element moves at least one complete omega factor.
Otherwise it centralizes their join, hence the odd core, contradicting the
Fitting centralizer lemma. -/
public theorem omegaSupport_card_pos_of_ne_one
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hS : IsElementaryAbelian 2 (S : Subgroup G))
    (hWthree : IsPGroup 3 (oddCore G))
    (hnorm : ∀ F : Subgroup G, oneOmega (G := G) (V := V) F →
      (S : Subgroup G) ≤ Subgroup.normalizer F)
    (hcoreEq : oddCore G = oneOmegaGenerated (G := G) (V := V))
    (hdecomp : LemmaOneFourConclusion (G := G) (V := V)
      (oneOmegaGenerated (G := G) (V := V))
      (oneOmegaFinset (G := G) (V := V)))
    (s : S) (hsne : s ≠ 1) :
    0 < (omegaSupport (G := G) (V := V)
      (S : Subgroup G) hnorm s).card := by
  classical
  let Z := omegaSupport (G := G) (V := V) (S : Subgroup G) hnorm s
  by_contra hnot
  have hZempty : Z = ∅ := Finset.card_eq_zero.mp (Nat.eq_zero_of_not_pos hnot)
  have hWcent : oddCore G ≤
      Subgroup.centralizer (Subgroup.zpowers (s : G) : Set G) := by
    rw [hcoreEq, hdecomp.part_a.1]
    apply iSup_le
    intro F
    have hF := (mem_oneOmegaFinset_iff (G := G) (V := V)
      (F : Subgroup G)).mp F.property
    apply Subgroup.commutator_eq_bot_iff_le_centralizer.mp
    exact commutator_oneOmega_zpowers_eq_bot_of_not_mem_support
      (S : Subgroup G) hnorm s (F : Subgroup G) hF (by
        intro hmem
        have : (F : Subgroup G) ∈ Z := hmem
        rw [hZempty] at this
        simp at this)
  have hscent : (s : G) ∈ Subgroup.centralizer (oddCore G : Set G) := by
    have hzle : Subgroup.zpowers (s : G) ≤
        Subgroup.centralizer (oddCore G : Set G) := by
      rw [← Subgroup.commutator_eq_bot_iff_le_centralizer,
        Subgroup.commutator_comm,
        Subgroup.commutator_eq_bot_iff_le_centralizer]
      exact hWcent
    exact hzle (Subgroup.mem_zpowers (s : G))
  have hsbot : (s : G) ∈
      (S : Subgroup G) ⊓ Subgroup.centralizer (oddCore G : Set G) :=
    ⟨s.property, hscent⟩
  rw [sylow_inf_centralizer_oddCore_eq_bot
    h (S : Subgroup G) hS hWthree] at hsbot
  exact hsne (Subtype.ext hsbot)

end Stellmacher.SectionOne.RankOneThreeGroupAssembly
