module

public import Stellmacher.SectionOne.LemmaOneSixSmallM
public import Stellmacher.SectionOne.RankOneExceptionalSmallM

/-!
# Stellmacher (1.6) with an explicit bound m(S)≤2

The bounded theorem retains the full four-alternative conclusion and every
standing hypothesis of the source-facing (1.6), with the explicit numerical
bound. Its companion also retains a commutator containment: if S is
nonquadratic on V, then [V,S] lies in [V,O₂′(G)]. The original public theorem
is the first projection of that companion, with its statement unchanged.

An order-two Sylow subgroup gives the small alternative when m>1; otherwise
the proved m≤1 classification applies. For larger Sylow subgroups, the
existing local-quotient construction has m=1, so the completed m≤1 theorem
supplies its restricted induction interface directly. The local odd cores
generate a three-group. Genericity gives the proved omega or SL2 product
alternatives; its failure invokes the complete bounded exceptional branch.
For the additional containment, the order-two and generic alternatives are
quadratic, so only the exceptional case remains. Its normalized action data
places [V,S] in the module generated by a selected F≤O₂′(G); inclusion of
actor generator sets puts that module in [V,O₂′(G)]. There is no recursive
use of this theorem or dependence on the unrestricted (1.6) assertion.

This gives the bounded classification needed for applications where the
fixed-point indices establish m(S)≤2, in particular the range arising in
the later (8.6) calculation. That bound must still be verified by each caller.
Source: `refs/latex/stellmacher-n-group.tex`, (1.6), journal pp.17–19.
-/

namespace Stellmacher.SectionOne
open SmallMProof RankOneThreeGroupAssembly
universe u

public theorem lemma_one_six_of_m_le_two_with_commutator
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hS_elem : IsElementaryAbelian 2 (S : Subgroup G))
    (hW : oddCore G = ⁅oddCore G, (S : Subgroup G)⁆)
    (hmin : ∀ Y : Subgroup G, Y ≤ (S : Subgroup G) → Y ≠ ⊥ →
      m (G := G) (V := V) (S : Subgroup G) ≤ m (G := G) (V := V) Y)
    (hm : m (G := G) (V := V) (S : Subgroup G) ≤ 2) :
    LemmaOneSixConclusion (G := G) (V := V) (S : Subgroup G) ∧
      (commutatorAction₂ (S : Subgroup G) V ≠ ⊥ →
        commutatorAction (S : Subgroup G) V ≤ commutatorAction (oddCore G) V) := by
  rcases sylow_two_card_eq_two_or_ge_four h.G_even S with hsmall | hlarge
  · have hquad := commutatorAction₂_eq_bot_of_actor_card_two (V := V) hsmall
    refine ⟨?_, fun hnon => (hnon hquad).elim⟩
    by_cases hmgt : 1 < m (G := G) (V := V) (S : Subgroup G)
    · exact LemmaOneSixConclusion.small hsmall hmgt
    · exact lemma_one_six_of_m_le_one h S hS_elem hW hmin (not_lt.mp hmgt)
  · have hind : ∀ {G₁ V₁ : Type u}
        [Group G₁] [Group V₁] [Finite G₁] [Finite V₁]
        [IsElementaryAbelian 2 V₁] [MulDistribMulAction G₁ V₁],
        (h₁ : Hypotheses G₁ V₁) → (T : Sylow 2 G₁) →
        (hT : IsElementaryAbelian 2 (T : Subgroup G₁)) →
        (hW₁ : oddCore G₁ = ⁅oddCore G₁, (T : Subgroup G₁)⁆) →
        (∀ Y : Subgroup G₁, Y ≤ (T : Subgroup G₁) → Y ≠ ⊥ →
          m (G := G₁) (V := V₁) (T : Subgroup G₁) ≤ m (G := G₁) (V := V₁) Y) →
        m (G := G₁) (V := V₁) (T : Subgroup G₁) ≤ 1 →
        Nat.card (T : Subgroup G₁) < Nat.card (S : Subgroup G) →
        LemmaOneSixConclusion (G := G₁) (V := V₁) (T : Subgroup G₁) := by
      intro G₁ V₁ _ _ _ _ _ _ h₁ T hT hW₁ hmin₁ hm₁ _hlt
      exact lemma_one_six_of_m_le_one h₁ T hT hW₁ hmin₁ hm₁
    have hlocal := local_recursive_sl2_assembly_hypothesis h S hS_elem hlarge hmin hind
    have hW3 : IsPGroup 3 (oddCore G) :=
      oddCore_isPGroup_three_of_local_commutators h S hS_elem hlarge hW
        (fun A hAmax hAcard => local_WA_isPGroup_three
          h S hS_elem hlarge hmin A hAmax hAcard hind)
    by_cases hgeneric : RankOneAssemblyGenericHypothesis (G := G) (V := V) (S : Subgroup G)
    · rcases generic_rank_one_three_group_alternatives
        h S hS_elem hlarge hW hW3 hmin hlocal hgeneric with
        ⟨hprod, hquad, hfixed⟩ | ⟨hprod, hquad, hfixed⟩
      · exact ⟨LemmaOneSixConclusion.omegaProduct hprod hquad hfixed, fun hn => (hn hquad).elim⟩
      · exact ⟨LemmaOneSixConclusion.sl2Product hprod hquad hfixed, fun hn => (hn hquad).elim⟩
    · obtain ⟨hmEq, hG, hVstar, hnonquad⟩ :=
        rank_one_three_group_exceptional_branch_of_m_le_two
          h S hS_elem hlarge hW hW3 hmin hlocal hgeneric hm
      refine ⟨LemmaOneSixConclusion.doubleSL2 hmEq hG hVstar hnonquad, ?_⟩
      intro _hnon
      obtain ⟨_, _, F, hFW, _, _, _, _, _, _, hcomm⟩ :=
        exists_exceptional_small_m_normalized_action_data (S : Subgroup G)
          hS_elem hgeneric hmin hm
      apply hcomm.trans
      unfold commutatorAction commutatorSubgroup
      apply Subgroup.closure_mono
      rintro v ⟨a, x, hx, rfl⟩
      exact ⟨⟨a, hFW a.property⟩, x, hx, rfl⟩

public theorem lemma_one_six_of_m_le_two
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hS_elem : IsElementaryAbelian 2 (S : Subgroup G))
    (hW : oddCore G = ⁅oddCore G, (S : Subgroup G)⁆)
    (hmin : ∀ Y : Subgroup G, Y ≤ (S : Subgroup G) → Y ≠ ⊥ →
      m (G := G) (V := V) (S : Subgroup G) ≤ m (G := G) (V := V) Y)
    (hm : m (G := G) (V := V) (S : Subgroup G) ≤ 2) :
    LemmaOneSixConclusion (G := G) (V := V) (S : Subgroup G) :=
  (lemma_one_six_of_m_le_two_with_commutator h S hS_elem hW hmin hm).1

end Stellmacher.SectionOne

