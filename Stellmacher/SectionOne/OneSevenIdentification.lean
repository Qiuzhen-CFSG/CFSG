module
public import Stellmacher.SectionOne.OneSevenGlobalProduct
public import Stellmacher.SectionOne.OneSevenSylowOffender
public import Stellmacher.SectionOne.SL2ProductSylowNormalClosure

/-!
# Identifying the global product in Stellmacher (1.7)

The action-defined subgroup J(V,S) is exactly the Sylow intersection of
the normal product generated by all one-seven factors; its normal closure
is that product. These are the identifications S₀=J(V,S) and E₀=E in
Stellmacher (1.7), Journal of Algebra 190 (1997), p.19, in
`refs/latex/stellmacher-n-group.tex`.

Every offender belongs to the global product by its local factorization.
Conversely the product's Sylow intersection is an offender, giving the
first equality. Normality bounds the normal closure of J from above, while
the generation of every SL₂(2) factor by square-one elements bounds it
from below. The identities also hold in the trivial-offender case.
-/

namespace Stellmacher.SectionOne
universe u

public theorem oneSeven_global_identification
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G) :
    oneJ (V := V) (S : Subgroup G) = (S : Subgroup G) ⊓ oneSevenGenerated (V := V) ∧
    oneE (V := V) (S : Subgroup G) = oneSevenGenerated (V := V) := by
  obtain ⟨hEnormal, hprod, hJE⟩ := oneSeven_global_product h S
  let E := oneSevenGenerated (G := G) (V := V)
  let F := oneSevenFactors (G := G) (V := V)
  have hF : ∀ D ∈ F, IsOneSevenFactor (V := V) D :=
    fun D hD => (mem_oneSevenFactors_iff D).mp hD
  have hA := oneSevenFactor_product_sylow_oneA h S E hEnormal F hprod hF
  have hJ : oneJ (V := V) (S : Subgroup G) = (S : Subgroup G) ⊓ E := by
    apply le_antisymm
    · exact le_inf (sSup_le fun A hA => hA.1) hJE
    · exact le_sSup hA
  refine ⟨hJ, ?_⟩
  let _ : E.Normal := hEnormal
  apply le_antisymm
  · exact Subgroup.normalClosure_le_normal hJE
  · have hh := sl2_product_le_normalClosure_sylow_inf S E hEnormal F hprod
      (fun D hD => (hF D hD).1)
    change E ≤ Subgroup.normalClosure (oneJ (V := V) (S : Subgroup G) : Set G)
    rw [hJ]
    exact hh

end Stellmacher.SectionOne
