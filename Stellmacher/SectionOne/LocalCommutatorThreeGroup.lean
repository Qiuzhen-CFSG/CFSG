module

public import Stellmacher.SectionOne.LemmaOneFive
public import Theory.GroupAction.CoprimeHall
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Assembling the local 3-groups after Stellmacher (1.6)

This module proves the local-to-global step used on journal page 17.  Let
`W = O_{2'}(G)` and suppose `W = [W,S]`.  If every local commutator
`[C_W(A),S]`, for an order-two `oneAmax` subgroup `A`, is a 3-group, then
`W` itself is a 3-group.

The proof applies solvable coprime action to an `S`-invariant Hall
`{3}ᶜ`-subgroup `K` of `W`.  Fixed-point generation reduces an element of
`K` to an index-two subgroup of `S`.  The index-two dichotomy exported by the
proof of (1.5) either makes that element `S`-fixed immediately, or supplies an
order-two `oneAmax` subgroup `A`; its displacement then lies in both the local
3-group and `K`, hence is trivial.  Thus `K` is fixed by `S`, so `[W,S]` lies
in the 3-core of `W`; the hypothesis `W = [W,S]` finishes the argument.
Part (1.5)(d) supplies the required order-two subgroups and rules out the
degenerate actor.

Source: `refs/latex/stellmacher-n-group.tex`, lines 452--453.
-/

@[expose] public section

open scoped BigOperators commutatorElement Pointwise

namespace Stellmacher.SectionOne

universe u

private lemma isPGroup_of_isPiSubgroup_singleton
    {G : Type u} [Group G] [Finite G] {H : Subgroup G} {q : Nat.Primes}
    (hH : IsPiSubgroup (G := G) ({q} : Set Nat.Primes) H) :
    IsPGroup q.val H := by
  let : Fact q.val.Prime := ⟨q.2⟩
  rw [IsPGroup.iff_card]
  have hcard_ne_zero : Nat.card H ≠ 0 := Nat.card_pos.ne'
  refine ⟨(Nat.card H).primeFactorsList.length, ?_⟩
  rw [← List.prod_replicate, ← List.eq_replicate_of_mem ?_,
    Nat.prod_primeFactorsList hcard_ne_zero]
  intro p hp
  obtain ⟨hp_prime, hp_dvd⟩ := (Nat.mem_primeFactorsList hcard_ne_zero).mp hp
  let p' : Nat.Primes := ⟨p, hp_prime⟩
  have hp_mem : p' ∈ ({q} : Set Nat.Primes) := hH p' hp_dvd
  simpa [p'] using congrArg Subtype.val hp_mem

private theorem isElementaryAbelian_of_le
    {G : Type u} [Group G] {S A : Subgroup G}
    (hS : IsElementaryAbelian 2 S) (hA : A ≤ S) :
    IsElementaryAbelian 2 A := by
  let : IsElementaryAbelian 2 S := hS
  refine {
    toIsMulCommutative := {
      is_comm := ⟨?_⟩ }
    exponent_dvd_p := ?_ }
  · intro a b
    apply Subtype.ext
    change (a : G) * (b : G) = (b : G) * (a : G)
    exact congrArg Subtype.val
      ((IsMulCommutative.is_comm (M := S)).comm
        ⟨a, hA a.property⟩ ⟨b, hA b.property⟩)
  · refine Monoid.exponent_dvd_iff_forall_pow_eq_one.2 ?_
    intro a
    apply Subtype.ext
    have ha := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 S)
      (⟨a, hA a.property⟩ : S)
    simpa using congrArg Subtype.val ha

/-- If all order-two `oneAmax` local commutators are 3-groups, then the odd
core is a 3-group, provided it is generated by its commutators with `S`. -/
public theorem oddCore_isPGroup_three_of_local_commutators
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hS_elem : IsElementaryAbelian 2 (S : Subgroup G))
    (hScard : 4 ≤ Nat.card (S : Subgroup G))
    (hW : oddCore G = ⁅oddCore G, (S : Subgroup G)⁆)
    (hlocal : ∀ A : Subgroup G,
      oneAmax (G := G) (V := V) (S : Subgroup G) A →
      Nat.card A = 2 →
      IsPGroup 3
        ↥(⁅oddCore G ⊓ Subgroup.centralizer (A : Set G),
          (S : Subgroup G)⁆)) :
    IsPGroup 3 (oddCore G) := by
  classical
  let three : Nat.Primes := ⟨3, by decide⟩
  let pi : Set Nat.Primes := {three}
  let W : Subgroup G := oddCore G
  let SG : Subgroup G := (S : Subgroup G)
  by_cases hWbot : W = ⊥
  · change IsPGroup 3 W
    rw [hWbot]
    exact IsPGroup.of_bot
  have hpartd :
      W = ⨆ A : {A : Subgroup G //
          oneAmax (G := G) (V := V) SG A ∧ Nat.card A = 2},
        W ⊓ Subgroup.centralizer ((A : Subgroup G) : Set G) := by
    simpa [W, SG] using
      (lemma_one_five h S SG le_rfl).part_d hS_elem hScard
  let I := {A : Subgroup G //
    oneAmax (G := G) (V := V) SG A ∧ Nat.card A = 2}
  have hI : Nonempty I := by
    by_contra hIempty
    have : IsEmpty I := not_nonempty_iff.mp hIempty
    have hsupbot :
        (⨆ A : I, W ⊓ Subgroup.centralizer ((A : Subgroup G) : Set G)) = ⊥ := by
      simp
    exact hWbot (hpartd.trans hsupbot)
  let A0 : I := Classical.choice hI
  have hSne : SG ≠ ⊥ := by
    intro hbot
    have hA0bot : (A0 : Subgroup G) = ⊥ := by
      apply le_antisymm
      · simpa [SG, hbot] using A0.property.1.1
      · exact bot_le
    have hcardA0 : Nat.card (A0 : Subgroup G) = 1 := by simp [hA0bot]
    have hcardA0two : Nat.card (A0 : Subgroup G) = 2 := A0.property.2
    omega
  let : IsElementaryAbelian 2 SG := hS_elem
  let : CommGroup SG := IsMulCommutative.instCommGroup
  let : Fact (IsPGroup 2 SG) := ⟨IsElementaryAbelian.isPGroup 2 SG⟩
  let : Nontrivial SG := (Subgroup.nontrivial_iff_ne_bot SG).2 hSne
  have hScardSG : 4 ≤ Nat.card SG := by simpa [SG] using hScard
  have hSncyc : ¬ IsCyclic SG := by
    intro hcyc
    let : IsCyclic SG := hcyc
    have hcardS : Nat.card SG = 2 := by
      rw [← hcyc.exponent_eq_card]
      exact IsElementaryAbelian.exponent_eq_prime
    omega
  let hWnormal : W.Normal := by
    dsimp [W]
    exact pPrimeCore_normal
  let hSnormW : SG ≤ Subgroup.normalizer (W : Set G) :=
    Subgroup.le_normalizer_of_normal
  let : MulDistribMulAction SG W :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer SG W hSnormW
  let _ : Group.IsSolvable G := h.G_solvable
  have hsolvW : Group.IsSolvable W := by infer_instance
  have hcopSW : Nat.Coprime (Nat.card SG) (Nat.card W) := by
    obtain ⟨n, hn⟩ := (IsElementaryAbelian.isPGroup 2 SG).exists_card_eq
    rw [hn]
    exact (pPrimeCore_coprime_card (G := G) (p := 2)).pow_left n
  obtain ⟨K, hKHall, hKinv⟩ :=
    exists_isHallSubgroup_isInvariant
      (G := W) (A := SG) hsolvW hcopSW {p | p ∉ pi}
  let _ : IsInvariant SG W K := hKinv
  let Kamb : Subgroup G := K.map W.subtype
  have hKambcard : Nat.card Kamb = Nat.card K := by
    exact Subgroup.card_map_of_injective W.subtype_injective
  have hthree_not_dvd_K : ¬ 3 ∣ Nat.card K := by
    intro hdvd
    have hmem := hKHall.p_in_pi_of_p_dvd_card three (by simpa [three] using hdvd)
    exact hmem (by simp [pi])
  have hcopSK : Nat.Coprime 2 (Nat.card K) := by
    have hcop2W : Nat.Coprime 2 (Nat.card W) := by
      change Nat.Coprime 2 (Nat.card (pPrimeCore 2 G))
      exact pPrimeCore_coprime_card
    exact Nat.Coprime.of_dvd_right (Subgroup.card_subgroup_dvd_card K)
      hcop2W
  have hKgen :
      (⨆ (Y : Subgroup SG) (_ : IsCyclic (SG ⧸ Y)),
        fixedPointSubgroup Y K) = ⊤ :=
    iSup_fixedPointSubgroup_cyclicQuot_eq_top_of_noncyclic_abelian_pGroup_action
      (G := K) (A := SG) (p := 2) hcopSK (hncyc := hSncyc)
  have hKterms :
      (⨆ (Y : Subgroup SG) (_ : IsCyclic (SG ⧸ Y)),
        fixedPointSubgroup Y K) ≤ fixedPointSubgroup SG K := by
    refine iSup₂_le ?_
    intro Y hYcyc k hk
    rw [FixedPoints.mem_subgroup] at hk ⊢
    by_cases hYtop : Y = ⊤
    · intro s
      have hsY : s ∈ Y := by simp [hYtop]
      exact hk ⟨s, hsY⟩
    have hYnormal : Y.Normal := inferInstance
    let _ : Y.Normal := hYnormal
    have hYelem : IsElementaryAbelian 2 (SG ⧸ Y) := by
      refine
        { toIsMulCommutative := inferInstance
          exponent_dvd_p := ?_ }
      refine Monoid.exponent_dvd_iff_forall_pow_eq_one.2 ?_
      intro q
      obtain ⟨s, rfl⟩ := QuotientGroup.mk'_surjective Y q
      have hs2 : s ^ 2 = 1 :=
        Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
          (IsElementaryAbelian.exponent_dvd_p 2 SG) s
      simpa only [map_pow, map_one] using congrArg (QuotientGroup.mk' Y) hs2
    let _ : IsElementaryAbelian 2 (SG ⧸ Y) := hYelem
    let _ : Nontrivial (SG ⧸ Y) := QuotientGroup.nontrivial_iff.mpr hYtop
    have hYcardQ : Nat.card (SG ⧸ Y) = 2 := by
      rw [← hYcyc.exponent_eq_card]
      exact IsElementaryAbelian.exponent_eq_prime
    have hYcard : Nat.card SG = 2 * Nat.card Y := by
      simpa [hYcardQ] using
        (Subgroup.card_eq_card_quotient_mul_card_subgroup Y)
    let B : Subgroup G := Y.map SG.subtype
    have hBleS : B ≤ SG := Subgroup.map_subtype_le Y
    have hBcard : Nat.card SG = 2 * Nat.card B := by
      rw [Subgroup.card_map_of_injective SG.subtype_injective]
      exact hYcard
    have hkcentB : (k : G) ∈ Subgroup.centralizer (B : Set G) := by
      rw [Subgroup.mem_centralizer_iff]
      intro b hb
      rcases Subgroup.mem_map.mp hb with ⟨y, hy, rfl⟩
      have hfixK : (y : SG) • k = k := by
        exact hk ⟨y, hy⟩
      have hfixW : (y : SG) • (k : W) = (k : W) := by
        exact congrArg Subtype.val hfixK
      have hconj := congrArg Subtype.val hfixW
      have hconj' :
          (y : G) * (k : G) * (y : G)⁻¹ = (k : G) := by
        simpa [Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe,
          hSnormW] using hconj
      have hmul := congrArg (fun z : G => z * (y : G)) hconj'
      simpa [mul_assoc] using hmul
    intro s
    rcases lemma_one_five_oneAmax_or_centralizer_eq h hS_elem hBleS hBcard with
      hBgood | hBfixed
    · have hBne : B ≠ ⊥ := by
        intro hBbot
        have hBcardOne : Nat.card B = 1 := by simp [hBbot]
        omega
      have hBelem : IsElementaryAbelian 2 B :=
        isElementaryAbelian_of_le hS_elem hBleS
      obtain ⟨A, hArel, hAcard⟩ :=
        lemma_one_five_exists_oneAmax_card_two_relative
          h S B hBleS hBelem hBne
      have hAgood : oneAmax (G := G) (V := V) SG A :=
        lemma_one_five_oneAmax_transfer hS_elem hBgood hArel
      have hA_le_B : A ≤ B := hArel.1
      have hkcentA : (k : G) ∈ Subgroup.centralizer (A : Set G) :=
        (Subgroup.centralizer_le (show (A : Set G) ⊆ (B : Set G) from hA_le_B)) hkcentB
      let L : Subgroup G := ⁅W ⊓ Subgroup.centralizer (A : Set G), SG⁆
      have hLthree : IsPGroup 3 L := by
        simpa [L, W, SG] using hlocal A hAgood hAcard
      let d : G := (k : G)⁻¹ * (s : G) * (k : G) * (s : G)⁻¹
      have hdL : d ∈ L := by
        simpa only [d, L, commutatorElement_def, inv_inv] using
          (Subgroup.commutator_mem_commutator
            (H₁ := W ⊓ Subgroup.centralizer (A : Set G)) (H₂ := SG)
            ⟨W.inv_mem (k : W).property,
              (Subgroup.centralizer (A : Set G)).inv_mem hkcentA⟩
            s.property)
      have hdK : d ∈ Kamb := by
        refine Subgroup.mem_map.mpr ⟨k⁻¹ * s • k, (k⁻¹ * s • k).property, ?_⟩
        simp only [d, Subgroup.subtype_apply]
        simp [Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe,
          mul_assoc]
      obtain ⟨n, hLcard⟩ := hLthree.exists_card_eq
      have hcopLK : Nat.Coprime (Nat.card L) (Nat.card Kamb) := by
        rw [hLcard, hKambcard]
        exact ((by decide : Nat.Prime 3).coprime_pow_of_not_dvd
          hthree_not_dvd_K).symm
      have hdisj : Disjoint L Kamb := Subgroup.disjoint_of_coprime_natCard hcopLK
      have hdOne : d = 1 := by
        have hdbot : d ∈ (⊥ : Subgroup G) := hdisj.le_bot ⟨hdL, hdK⟩
        simpa using hdbot
      have hconj : (s : G) * (k : G) * (s : G)⁻¹ = (k : G) := by
        calc
          (s : G) * (k : G) * (s : G)⁻¹ = (k : G) * d := by
            simp [d]
            group
          _ = (k : G) := by rw [hdOne]; simp
      have hconjW : s • (k : W) = (k : W) := by
        apply Subtype.ext
        exact
          (Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe_explicit
            SG W hSnormW s (k : W)).trans hconj
      apply Subtype.ext
      exact hconjW
    · have hkWS : (k : G) ∈ W ⊓ Subgroup.centralizer (SG : Set G) := by
        rw [← hBfixed]
        exact ⟨(k : W).property, hkcentB⟩
      have hscomm : (s : G) * (k : G) = (k : G) * (s : G) :=
        Subgroup.mem_centralizer_iff.mp hkWS.2 (s : G) s.property
      have hconjW : s • (k : W) = (k : W) := by
        apply Subtype.ext
        calc
          ((s • (k : W) : W) : G) =
              (s : G) * (k : G) * (s : G)⁻¹ :=
            Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe_explicit
              SG W hSnormW s (k : W)
          _ = (k : G) := by rw [hscomm]; simp [mul_assoc]
      apply Subtype.ext
      exact hconjW
  have hKtop : fixedPointSubgroup SG K = ⊤ := by
    apply top_unique
    rw [← hKgen]
    exact hKterms
  have hKfixed : K ≤ fixedPointSubgroup SG W := by
    intro k hk
    rw [FixedPoints.mem_subgroup]
    intro s
    let kK : K := ⟨k, hk⟩
    have hkfix : ∀ s : SG, s • kK = kK := by
      have : kK ∈ fixedPointSubgroup SG K := by rw [hKtop]; simp
      exact this
    exact congrArg Subtype.val (hkfix s)
  have hcomm_le : commutatorAction (A := SG) (G := W) ≤ piCore pi W :=
    commutatorAction_le_piCore_of_hall_complement_le_fixedPointSubgroup
      (G := W) (A := SG) hsolvW hcopSW pi K hKHall hKfixed
  have hmapcomm :
      (commutatorAction (A := SG) (G := W)).map W.subtype = ⁅W, SG⁆ :=
    commutatorAction_subgroup_conj_map_eq_commutator W SG hSnormW
  have hcommtop : commutatorAction (A := SG) (G := W) = ⊤ := by
    apply top_unique
    intro w _hw
    have hwcomm : (w : G) ∈ ⁅W, SG⁆ := by
      rw [← hW]
      exact w.property
    rw [← hmapcomm] at hwcomm
    rcases Subgroup.mem_map.mp hwcomm with ⟨c, hc, hcw⟩
    have hc_eq : c = w := W.subtype_injective hcw
    simpa [hc_eq] using hc
  have hcoretop : piCore pi W = ⊤ := by
    apply top_unique
    rw [← hcommtop]
    exact hcomm_le
  have hcorepi : IsPiSubgroup (G := W) pi (⊤ : Subgroup W) := by
    rw [← hcoretop]
    exact piCore_isPiSubgroup pi
  have hcorepi' : IsPiSubgroup (G := W) ({three} : Set Nat.Primes) (⊤ : Subgroup W) := by
    simpa [pi] using hcorepi
  have htopthree : IsPGroup 3 (⊤ : Subgroup W) := by
    simpa [three] using isPGroup_of_isPiSubgroup_singleton hcorepi'
  change IsPGroup 3 W
  exact htopthree.of_equiv Subgroup.topEquiv

end Stellmacher.SectionOne
