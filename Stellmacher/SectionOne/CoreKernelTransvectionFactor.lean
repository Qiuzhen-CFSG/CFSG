module
public import Stellmacher.SectionOne.OrderTwoOffenderFactor
public import Stellmacher.SectionOne.FixedIndexTwoOffender
public import Theory.GroupAction.CardTwoDisplacementInvolution
public import Theory.GroupAction.ActorSubtypeCommutator
public import Theory.GroupTheory.PCoreKernelRange

/-!
# A canonical factor for a transvection in a core quotient

Let a finite solvable group act on a finite elementary abelian two-group,
with action kernel equal to its two-core. An actor whose displacement
subgroup has order two determines a canonical Section One factor in the
literal automorphism range: the factor is generated by the actor and its
commutator with the odd core. The result retains both the faithful Section
One hypotheses and all clauses of `IsOneSevenFactor`, including its
four-element support and odd-core normality.

The range has trivial two-core by the core-kernel quotient theorem. The
rank-one displacement makes the induced actor an involution. Its cyclic
subgroup has fixed index two and fixes its own displacement, so it is an
order-two offender in a containing Sylow subgroup. The canonical factor
then follows from the proved order-two consequence of (1.7).

This is the action-theoretic factor selection used in Stellmacher (9.4)(1),
printed p.51 of `refs/files/stellmacher-n-group.pdf`. The Section Nine
consumer constructs the quotient action separately; keeping its literal
range here preserves the exact action and invariance instances.
-/

namespace Stellmacher.SectionOne
universe u

public theorem core_kernel_transvection_factor
    {P V : Type u} [Group P] [Finite P] [Group V] [Finite V]
    [IsElementaryAbelian 2 V]
    (hsolvable : Group.IsSolvable P) (action : P →* MulAut V)
    (hkernel : action.ker = pCore 2 P) (actor : P)
    (hrank : Nat.card (commutatorAction (Subgroup.zpowers (action actor)) V) = 2) :
    Hypotheses action.range V ∧
      IsOneSevenFactor (V := V)
        (⁅oddCore action.range, Subgroup.zpowers (action.rangeRestrict actor)⁆ ⊔
          Subgroup.zpowers (action.rangeRestrict actor)) := by
  classical
  let _ := hsolvable
  let X := action.range
  let induced := action.rangeRestrict actor
  let Y := Subgroup.zpowers induced
  have hautomorphism := isInvolution_of_card_two_displacement (action actor) hrank
  have hinduced : _root_.IsInvolution induced :=
    ⟨fun heq => hautomorphism.1 (congrArg Subtype.val heq), Subtype.ext hautomorphism.2⟩
  have hYcard : Nat.card Y = 2 := by
    rw [Nat.card_zpowers, orderOf_eq_prime hinduced.2 hinduced.1]
  have hfaithful : fixingSubgroup X (Set.univ : Set V) = ⊥ := by
    apply bot_unique
    intro mover hmover
    apply Subtype.ext
    ext point
    exact ((mem_fixingSubgroup_iff X).mp hmover) point (Set.mem_univ point)
  have hyp : Hypotheses X V := {
    G_solvable := Group.isSolvable_of_surjective action.rangeRestrict_surjective
    G_even := even_iff_two_dvd.mpr (by
      rw [← hYcard]
      exact Y.card_subgroup_dvd_card)
    action_faithful := hfaithful
    twoCore_eq_bot := pCore_range_eq_bot_of_ker_eq_pCore 2 action hkernel }
  have hnontrivial : Nontrivial V := by
    apply not_subsingleton_iff_nontrivial.mp
    intro hsub
    let _ := hsub
    apply hautomorphism.1
    ext point
    exact Subsingleton.elim _ _
  let _ := hnontrivial
  let _ : IsElementaryAbelian 2 Y := IsElementaryAbelian.zpowers_of_pow_eq_one hinduced.2
  obtain ⟨sylow, hle⟩ := IsPGroup.exists_le_sylow (IsElementaryAbelian.isPGroup 2 Y)
  have hrankY : Nat.card (commutatorAction Y V) = 2 := by
    rw [← commutatorAction_map_actor_subtype X Y, MonoidHom.map_zpowers]
    exact hrank
  let generator : Y := ⟨induced, Subgroup.mem_zpowers induced⟩
  have hgenerator : generator ≠ 1 ∧ generator ^ 2 = 1 :=
    ⟨fun heq => hinduced.1 (congrArg Subtype.val heq), Subtype.ext hinduced.2⟩
  obtain ⟨hcount, hfixed⟩ := card_two_action_fixed_commutator_card_data
    (U := V) generator hgenerator hYcard
  have hindex : Nat.card V = 2 * Nat.card (FixedPoints.subgroup Y V) := by
    simpa only [hrankY, Nat.mul_comm] using hcount
  have hA := (oneA_of_quadratic_fixed_index_two hyp sylow Y hle hindex hfixed).1
  exact ⟨hyp, oneSevenFactor_of_card_two_offender hyp sylow Y hA hYcard⟩

end Stellmacher.SectionOne
