module
public import Stellmacher.SectionOne.OneSevenGlobalProduct

/-!
# Saturation of a selected one-seven product

A subgroup generated by any family of raw one-seven factors is the full
global factor subgroup if it contains the ambient three-core. The action
and Section One hypotheses are the original supplied ones.

If a global factor were omitted, the factor-pair theorem would make it
commute with each selected factor, hence with their join. Its nontrivial
derived subgroup lies in the three-core and therefore in that join. It
would consequently lie in the omitted factor's trivial center, a
contradiction. No independence of a module sum is used.

This is the factor comparison underlying Stellmacher (8.3), journal p38,
where the three-core containment is supplied by the full two-residual.
Source: refs/latex/stellmacher-n-group.tex, final comparison of (2.2) and
(8.1).
-/

namespace Stellmacher.SectionOne
universe u v

public theorem oneSevenGenerated_eq_of_threeCore_le
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) {I : Sort v} (D : I → Subgroup G)
    (hD : ∀ i, IsOneSevenFactor (V := V) (D i))
    (E : Subgroup G) (hE : E = ⨆ i, D i) (hthree : pCore 3 G ≤ E) :
    E = oneSevenGenerated (G := G) (V := V) := by
  classical
  apply le_antisymm
  · rw [hE]
    exact iSup_le fun i => le_sSup (hD i)
  · apply sSup_le
    intro F hF
    by_contra hnot
    have hEF : E ≤ Subgroup.centralizer (F : Set G) := by
      rw [hE]
      apply iSup_le
      intro i
      have hne : F ≠ D i := by
        intro heq
        apply hnot
        rw [heq, hE]
        exact le_iSup D i
      have hc := (oneSevenFactor_eq_or_commute h F (D i) hF (hD i)).resolve_left hne
      intro d hd
      rw [Subgroup.mem_centralizer_iff]
      intro f hf
      exact hc f hf d hd
    let R := (commutator F).map F.subtype
    have hRE : R ≤ E := (oneSevenFactor_derived_le_threeCore F hF).trans hthree
    have hRbot : R = ⊥ := by
      apply bot_unique
      intro r hr
      have hrF : r ∈ F := (Subgroup.map_subtype_le _) hr
      have hrcent : (⟨r, hrF⟩ : F) ∈ Subgroup.center F := by
        rw [Subgroup.mem_center_iff]
        intro f
        apply Subtype.ext
        exact Subgroup.mem_centralizer_iff.mp (hEF (hRE hr)) f f.property
      rw [RankOneThreeGroupAssembly.center_eq_bot_of_isSL2Two hF.1] at hrcent
      exact congrArg Subtype.val hrcent
    have hcard : Nat.card R = 3 := hF.2.1.2.1
    have hone : Nat.card R = 1 := Subgroup.card_eq_one.mpr hRbot
    omega

end Stellmacher.SectionOne

