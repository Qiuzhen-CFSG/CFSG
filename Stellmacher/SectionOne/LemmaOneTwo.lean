module

public import Stellmacher.SectionOne.LemmaOneOne
public import Theory.GroupAction.CommutatorSemidirect
public import Theory.GroupAction.Quadratic
public import Theory.ThreeSubgroups
public import Mathlib.Algebra.Pointwise.Stabilizer

/-!
# Stellmacher's Lemma 1.2

This module proves the fixed-point generation lemma used at the start of
Stellmacher's argument.  If `G = O_{2'}(G) S`, the Sylow subgroup `S` acts
quadratically on the elementary abelian module `V`, and the `G`-conjugates of
`C_V(S)` generate `V`, then the fixed spaces of the index-two subgroups of
`S` generate `V`.

The proof follows the source.  Lemma 1.1 makes `S` elementary abelian and
generates the odd core by the groups `C_W(H)` for index-two `H`.  In
`V ⋊ G`, the relative three-subgroups lemma shows that `[C_W(H),S]`
stabilizes the required join of fixed spaces.  Coprime action splits
`C_W(H)` into that commutator subgroup and its `S`-fixed subgroup, so both
`O_{2'}(G)` and `S` stabilize the join.  The stated generation of `V` then
finishes the proof.

Source: `refs/latex/stellmacher-n-group.tex`, lines 282--300 (Lemma 1.2).
-/

open scoped BigOperators Pointwise commutatorElement

namespace Stellmacher.SectionOne

universe u v

/-- The subgroup generated by all `A`-translates of `H`.

This is the action-theoretic angle-bracket notation `⟨H^A⟩` used by the
source. -/
@[expose] public def actionClosure
    (A : Type u) (V : Type v) [Group A] [Group V]
    [MulDistribMulAction A V] (H : Subgroup V) : Subgroup V :=
  Subgroup.closure {x : V | ∃ a : A, ∃ h : V, h ∈ H ∧ x = a • h}

private theorem commutatorSubgroup_le_of_smul_mem
    {A X : Type*} [Group A] [Group X] [MulDistribMulAction A X]
    (K : Subgroup X) (hK : ∀ a : A, ∀ x : X, x ∈ K → a • x ∈ K) :
    commutatorSubgroup A X K ≤ K := by
  rw [commutatorSubgroup]
  refine (Subgroup.closure_le K).2 ?_
  rintro x ⟨a, y, hy, rfl⟩
  exact K.mul_mem (K.inv_mem hy) (hK a y hy)

private theorem fixedPoints_smul_mem_of_centralizes
    {A X : Type*} [Group A] [Group X] [MulDistribMulAction A X]
    (B C : Subgroup A) (hcentral : B ≤ Subgroup.centralizer (C : Set A))
    (b : B) (x : X) (hx : x ∈ FixedPoints.subgroup C X) :
    (b : A) • x ∈ FixedPoints.subgroup C X := by
  rw [FixedPoints.mem_subgroup] at hx ⊢
  intro c
  have hcomm : (b : A) * (c : A) = (c : A) * (b : A) :=
    (hcentral b.property (c : A) c.property).symm
  calc
    (c : A) • ((b : A) • x) = ((c : A) * (b : A)) • x := by rw [mul_smul]
    _ = ((b : A) * (c : A)) • x := by rw [hcomm]
    _ = (b : A) • ((c : A) • x) := by rw [mul_smul]
    _ = (b : A) • x := by
      rw [show (c : A) • x = x by simpa [Subgroup.smul_def] using hx c]

private theorem map_inr_le_normalizer_fixedPoints_map_inl
    {A X : Type*} [Group A] [Group X] [MulDistribMulAction A X]
    (B C : Subgroup A) (hcentral : B ≤ Subgroup.centralizer (C : Set A)) :
    let φ : A →* MulAut X := MulDistribMulAction.toMulAut A X
    let inl : X →* X ⋊[φ] A := SemidirectProduct.inl
    let inr : A →* X ⋊[φ] A := SemidirectProduct.inr
    B.map inr ≤ Subgroup.normalizer ((FixedPoints.subgroup C X).map inl) := by
  dsimp only
  let φ : A →* MulAut X := MulDistribMulAction.toMulAut A X
  let inl : X →* X ⋊[φ] A := SemidirectProduct.inl
  let inr : A →* X ⋊[φ] A := SemidirectProduct.inr
  have hact : commutatorSubgroup B X (FixedPoints.subgroup C X) ≤
      FixedPoints.subgroup C X :=
    commutatorSubgroup_le_of_smul_mem _
      (fun b => fixedPoints_smul_mem_of_centralizes B C hcentral b)
  have hmap := Subgroup.map_mono (f := inl) hact
  have hbridge := commutatorSubgroup_map_semidirect_inl_eq_commutator
    (G := X) (A := A) B (FixedPoints.subgroup C X)
  rw [hbridge] at hmap
  rw [Subgroup.le_normalizer_iff_commutator_le_left]
  exact hmap

private theorem centralizer_stabilizes_indexFixedSup
    {G : Type u} {V : Type v} [Group G] [Group V]
    [MulDistribMulAction G V]
    (S : Sylow 2 G) :
    Subgroup.centralizer (S : Set G) ≤
      MulAction.stabilizer G
        ((⨆ (S0 : Subgroup S) (_ : Nat.card S = 2 * Nat.card S0),
          FixedPoints.subgroup S0 V : Subgroup V) : Set V) := by
  let V0 : Subgroup V :=
    ⨆ (S0 : Subgroup S) (_ : Nat.card S = 2 * Nat.card S0),
      FixedPoints.subgroup S0 V
  intro g hg
  rw [MulAction.mem_stabilizer_set]
  intro x
  have hforward (g : G) (hg : g ∈ Subgroup.centralizer (S : Set G))
      (x : V) (hx : x ∈ V0) : g • x ∈ V0 := by
    refine Subgroup.iSup_induction
      (C := fun z => g • z ∈ V0)
      (fun S0 : Subgroup S =>
        ⨆ (_ : Nat.card S = 2 * Nat.card S0), FixedPoints.subgroup S0 V) hx ?_ (by simp) ?_
    · intro S0 y hy
      refine Subgroup.iSup_induction
        (C := fun z => g • z ∈ V0)
        (fun _ : Nat.card S = 2 * Nat.card S0 => FixedPoints.subgroup S0 V)
        hy ?_ (by simp) ?_
      · intro hS0 y hy
        apply Subgroup.mem_iSup_of_mem S0
        apply Subgroup.mem_iSup_of_mem hS0
        rw [FixedPoints.mem_subgroup] at hy ⊢
        intro s
        have hcomm : (s : G) * g = g * (s : G) :=
          hg (s : G) (show (s : G) ∈ (S : Subgroup G) from (s : S).property)
        change (s : G) • (g • y) = g • y
        calc
          (s : G) • (g • y) = ((s : G) * g) • y := by rw [mul_smul]
          _ = (g * (s : G)) • y := by rw [hcomm]
          _ = g • ((s : G) • y) := by rw [mul_smul]
          _ = g • y := by
            rw [show (s : G) • y = y by simpa [Subgroup.smul_def] using hy s]
      · intro y z hy hz
        simpa [smul_mul'] using V0.mul_mem hy hz
    · intro y z hy hz
      simpa [smul_mul'] using V0.mul_mem hy hz
  constructor
  · intro hx
    have := hforward g⁻¹ (Subgroup.centralizer _ |>.inv_mem hg) (g • x) hx
    simpa [inv_smul_smul] using this
  · exact hforward g hg x

private theorem map_inr_normalizer_implies_stabilizer
    {A X : Type*} [Group A] [Group X] [MulDistribMulAction A X]
    (B : Subgroup A) (K : Subgroup X)
    (hnorm :
      let φ : A →* MulAut X := MulDistribMulAction.toMulAut A X
      let inl : X →* X ⋊[φ] A := SemidirectProduct.inl
      let inr : A →* X ⋊[φ] A := SemidirectProduct.inr
      B.map inr ≤ Subgroup.normalizer (K.map inl)) :
    B ≤ MulAction.stabilizer A (K : Set X) := by
  let φ : A →* MulAut X := MulDistribMulAction.toMulAut A X
  let inl : X →* X ⋊[φ] A := SemidirectProduct.inl
  let inr : A →* X ⋊[φ] A := SemidirectProduct.inr
  have hinl : Function.Injective (inl : X → X ⋊[φ] A) := by
    simpa [inl] using (SemidirectProduct.inl_injective (φ := φ))
  have hinlmem (x : X) : inl x ∈ K.map inl ↔ x ∈ K := by
    constructor
    · rintro ⟨y, hy, heq⟩
      exact hinl heq ▸ hy
    · exact Subgroup.mem_map_of_mem inl
  intro b hb
  rw [MulAction.mem_stabilizer_set]
  intro x
  have hbmap : inr b ∈ B.map inr := Subgroup.mem_map_of_mem inr hb
  have hbN := hnorm hbmap
  have hconj := Subgroup.mem_normalizer_iff.mp hbN (inl x)
  have hconjeq : inr b * inl x * (inr b)⁻¹ = inl (b • x) := by
    simpa [inl, inr, φ] using (SemidirectProduct.inl_aut (φ := φ) b x).symm
  constructor
  · intro hx
    have hbxmap : inl (b • x) ∈ K.map inl := (hinlmem (b • x)).2 hx
    rw [← hconjeq] at hbxmap
    exact (hinlmem x).1 (hconj.2 hbxmap)
  · intro hx
    have hxmap : inl x ∈ K.map inl := (hinlmem x).2 hx
    have hconjmem := hconj.1 hxmap
    rw [hconjeq] at hconjmem
    exact (hinlmem (b • x)).1 hconjmem

private theorem commutator_stabilizes_indexFixedSup
    {G : Type u} {V : Type v} [Group G] [Group V]
    [Finite V] [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (S : Sylow 2 G) (hquadratic : IsQuadraticAction S V)
    (hScomm : IsMulCommutative S)
    (H : Subgroup S) (hH : Nat.card S = 2 * Nat.card H) :
    let V0 : Subgroup V :=
      ⨆ (S0 : Subgroup S) (_ : Nat.card S = 2 * Nat.card S0),
        FixedPoints.subgroup S0 V
    let Hamb : Subgroup G := H.map (S : Subgroup G).subtype
    let N : Subgroup G := oddCore G ⊓ Subgroup.centralizer (Hamb : Set G)
    ⁅N, (S : Subgroup G)⁆ ≤ MulAction.stabilizer G (V0 : Set V) := by
  dsimp only
  let V0 : Subgroup V :=
    ⨆ (S0 : Subgroup S) (_ : Nat.card S = 2 * Nat.card S0),
      FixedPoints.subgroup S0 V
  let Hamb : Subgroup G := H.map (S : Subgroup G).subtype
  let N : Subgroup G := oddCore G ⊓ Subgroup.centralizer (Hamb : Set G)
  let φ : G →* MulAut V := MulDistribMulAction.toMulAut G V
  let SD := V ⋊[φ] G
  let : Group SD := inferInstance
  let : CommGroup S := IsMulCommutative.instCommGroup
  let : CommGroup V := IsMulCommutative.instCommGroup
  let inl : V →* SD := SemidirectProduct.inl
  let inr : G →* SD := SemidirectProduct.inr
  let NV : Subgroup SD := N.map inr
  let SV : Subgroup SD := (S : Subgroup G).map inr
  let V0V : Subgroup SD := V0.map inl
  let CHV : Subgroup SD := (FixedPoints.subgroup Hamb V).map inl
  let RV : Subgroup SD := (⊤ : Subgroup V).map inl
  have hNcentral : N ≤ Subgroup.centralizer (Hamb : Set G) := inf_le_right
  have hNnorm : NV ≤ Subgroup.normalizer CHV := by
    dsimp [NV, CHV]
    exact map_inr_le_normalizer_fixedPoints_map_inl (X := V) N Hamb hNcentral
  have hScentral : (S : Subgroup G) ≤ Subgroup.centralizer (Hamb : Set G) := by
    intro s hs
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨a, ha, rfl⟩
    exact (congrArg Subtype.val (mul_comm ⟨s, hs⟩ a)).symm
  have hSnorm : SV ≤ Subgroup.normalizer CHV := by
    dsimp [SV, CHV]
    exact map_inr_le_normalizer_fixedPoints_map_inl (X := V) (S : Subgroup G) Hamb hScentral
  have hV0norm : V0V ≤ Subgroup.normalizer CHV := by
    rw [Subgroup.le_normalizer_iff_commutator_le_right]
    refine Subgroup.commutator_le.mpr ?_
    rintro x ⟨vx, hvx, rfl⟩ y ⟨vy, hvy, rfl⟩
    have hcomm : Commute vx vy := Commute.all vx vy
    have : ⁅inl vx, inl vy⁆ = 1 := by
      rw [commutatorElement_eq_one_iff_commute]
      exact hcomm.map inl
    rw [this]
    exact CHV.one_mem
  have hquadfix : commutatorAction S V ≤ FixedPoints.subgroup S V :=
    commutatorAction_le_fixedPoints_of_commutatorAction₂_eq_bot hquadratic
  have hfixle : FixedPoints.subgroup S V ≤ FixedPoints.subgroup Hamb V := by
    intro x hx
    rw [FixedPoints.mem_subgroup] at hx ⊢
    intro a
    rcases Subgroup.mem_map.mp a.property with ⟨s, hs, heq⟩
    change (a : G) • x = x
    rw [← heq]
    simpa [Subgroup.smul_def] using hx s
  have hcommSV0 : ⁅SV, V0V⁆ ≤ CHV := by
    rw [Subgroup.commutator_comm]
    have hmono : commutatorSubgroup S V V0 ≤ commutatorAction S V :=
      commutatorSubgroup_mono le_top
    have hmap := Subgroup.map_mono (f := inl) (hmono.trans (hquadfix.trans hfixle))
    have hbridge := commutatorSubgroup_map_semidirect_inl_eq_commutator
      (G := V) (A := G) (S : Subgroup G) V0
    simpa [SV, V0V, CHV, φ, SD, inl, inr] using hbridge ▸ hmap
  have hrot1 : ⁅⁅SV, V0V⁆, NV⁆ ≤ CHV :=
    (Subgroup.commutator_mono hcommSV0 le_rfl).trans
      (Subgroup.le_normalizer_iff_commutator_le_left.mp hNnorm)
  have hRVnormal : RV.Normal := by
    have hRV : RV = inl.range := by
      ext x
      simp [RV]
    rw [hRV]
    dsimp [inl, SD]
    rw [SemidirectProduct.range_inl_eq_ker_rightHom]
    infer_instance
  have hrot2 : ⁅⁅V0V, NV⁆, SV⁆ ≤ CHV := by
    have hinner : ⁅V0V, NV⁆ ≤ RV := by
      exact (Subgroup.commutator_mono
        (show V0V ≤ RV from Subgroup.map_mono le_top) le_top).trans
        (Subgroup.commutator_le_left RV ⊤)
    have hout : ⁅⁅V0V, NV⁆, SV⁆ ≤ ⁅RV, SV⁆ :=
      Subgroup.commutator_mono hinner le_rfl
    have hfull : ⁅RV, SV⁆ ≤ CHV := by
      have hmap := Subgroup.map_mono (f := inl) (hquadfix.trans hfixle)
      have hbridge := commutatorSubgroup_map_semidirect_inl_eq_commutator
        (G := V) (A := G) (S : Subgroup G) (⊤ : Subgroup V)
      simpa [RV, SV, CHV, φ, SD, inl, inr] using hbridge ▸ hmap
    exact hout.trans hfull
  have hthree : ⁅⁅NV, SV⁆, V0V⁆ ≤ CHV :=
    Subgroup.commutator_commutator_le_of_rotate_of_le_normalizer
      hNnorm hSnorm hV0norm hrot1 hrot2
  have hCHVle : CHV ≤ V0V := by
    dsimp [CHV, V0V]
    apply Subgroup.map_mono
    intro x hx
    exact Subgroup.mem_iSup_of_mem H (Subgroup.mem_iSup_of_mem hH (by
      rw [FixedPoints.mem_subgroup] at hx ⊢
      intro a
      have ha := hx
        ⟨(a : S), Subgroup.mem_map_of_mem (S : Subgroup G).subtype a.property⟩
      simpa [Subgroup.smul_def] using ha))
  have hDnorm : (⁅N, (S : Subgroup G)⁆).map inr ≤ Subgroup.normalizer V0V := by
    rw [Subgroup.map_commutator]
    rw [Subgroup.le_normalizer_iff_commutator_le_right]
    exact hthree.trans hCHVle
  exact map_inr_normalizer_implies_stabilizer ⁅N, (S : Subgroup G)⁆ V0 hDnorm

private theorem oddCentralizer_stabilizes_indexFixedSup
    {G : Type u} {V : Type v} [Group G] [Group V]
    [Finite G] [Finite V] [IsElementaryAbelian 2 V]
    [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hquadratic : IsQuadraticAction S V)
    (hSelem : IsElementaryAbelian 2 S)
    (H : Subgroup S) (hH : Nat.card S = 2 * Nat.card H) :
    oddCore G ⊓
        Subgroup.centralizer
          ((H.map (S : Subgroup G).subtype : Subgroup G) : Set G) ≤
      MulAction.stabilizer G
        ((⨆ (S0 : Subgroup S) (_ : Nat.card S = 2 * Nat.card S0),
          FixedPoints.subgroup S0 V : Subgroup V) : Set V) := by
  let W : Subgroup G := oddCore G
  let Hamb : Subgroup G := H.map (S : Subgroup G).subtype
  let N : Subgroup G := W ⊓ Subgroup.centralizer (Hamb : Set G)
  let V0 : Subgroup V :=
    ⨆ (S0 : Subgroup S) (_ : Nat.card S = 2 * Nat.card S0),
      FixedPoints.subgroup S0 V
  let : Group.IsSolvable G := h.G_solvable
  let : IsElementaryAbelian 2 S := hSelem
  let : CommGroup S := IsMulCommutative.instCommGroup
  have hScentral : (S : Subgroup G) ≤ Subgroup.centralizer (Hamb : Set G) := by
    intro s hs
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    rcases Subgroup.mem_map.mp hx with ⟨a, ha, rfl⟩
    exact (congrArg Subtype.val (mul_comm ⟨s, hs⟩ a)).symm
  have hWnormal : W.Normal := by
    dsimp [W]
    exact pPrimeCore_normal
  have hSnormW : (S : Subgroup G) ≤ Subgroup.normalizer (W : Set G) :=
    Subgroup.le_normalizer_of_normal
  have hSnormC : (S : Subgroup G) ≤
      Subgroup.normalizer (Subgroup.centralizer (Hamb : Set G) : Set G) :=
    hScentral.trans (Subgroup.centralizer (Hamb : Set G)).le_normalizer
  have hSnormN : (S : Subgroup G) ≤ Subgroup.normalizer (N : Set G) := by
    rw [Subgroup.le_normalizer_iff_commutator_le_right]
    apply le_inf
    · exact (Subgroup.commutator_mono le_rfl inf_le_left).trans
        (Subgroup.le_normalizer_iff_commutator_le_right.mp hSnormW)
    · exact (Subgroup.commutator_mono le_rfl inf_le_right).trans
        (Subgroup.le_normalizer_iff_commutator_le_right.mp hSnormC)
  let : MulDistribMulAction S N :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer (S : Subgroup G) N hSnormN
  have hNsolv : Group.IsSolvable N := inferInstance
  have hNcop2 : Nat.Coprime 2 (Nat.card N) := by
    have hWcop : Nat.Coprime 2 (Nat.card W) := by
      dsimp [W]
      exact pPrimeCore_coprime_card
    exact hWcop.coprime_dvd_right
      (Subgroup.card_dvd_of_le (show N ≤ W from inf_le_left))
  have hScopN : Nat.Coprime (Nat.card S) (Nat.card N) := by
    obtain ⟨n, hn⟩ := S.isPGroup'.exists_card_eq
    rw [hn]
    exact hNcop2.pow_left n
  have hsup :
      fixedPointSubgroup S N ⊔ commutatorAction S N = ⊤ :=
    fixedPointSubgroup_sup_commutatorAction_eq_top_of_solvable_coprime hNsolv hScopN
  have hfix :
      fixedPointSubgroup S N =
        (subgroupCentralizerIn N (S : Subgroup G)).subgroupOf N :=
    fixedPointSubgroup_subgroup_conj_eq_subgroupCentralizerIn
      N (S : Subgroup G) hSnormN
  have hfixmap :
      (fixedPointSubgroup S N).map N.subtype =
        N ⊓ Subgroup.centralizer (S : Set G) := by
    rw [hfix, Subgroup.map_subgroupOf_eq_of_le
      (show subgroupCentralizerIn N (S : Subgroup G) ≤ N from inf_le_left)]
    rfl
  have hcommmap :
      (commutatorAction S N).map N.subtype = ⁅N, (S : Subgroup G)⁆ :=
    commutatorAction_subgroup_conj_map_eq_commutator
      N (S : Subgroup G) hSnormN
  have htopmap : (⊤ : Subgroup N).map N.subtype = N := by
    ext x
    simp
  have hmap := congrArg (fun K : Subgroup N => K.map N.subtype) hsup
  rw [Subgroup.map_sup, hfixmap, hcommmap, htopmap] at hmap
  have hNeq : N =
      (N ⊓ Subgroup.centralizer (S : Set G)) ⊔ ⁅N, (S : Subgroup G)⁆ :=
    hmap.symm
  change N ≤ MulAction.stabilizer G (V0 : Set V)
  rw [hNeq]
  apply sup_le
  · exact inf_le_right.trans (centralizer_stabilizes_indexFixedSup S)
  · exact commutator_stabilizes_indexFixedSup S hquadratic
      (show IsMulCommutative S from inferInstance) H hH

/-- **Stellmacher (1.2).** If `G=WS`, the action of `S` on `V` is quadratic,
and `V` is generated by the `G`-translates of `C_V(S)`, then `V` is generated
by the fixed-point subgroups of the index-two subgroups of `S`.

Source: `refs/latex/stellmacher-n-group.tex`, lines 282--286. -/
public theorem lemma_one_two
    {G : Type u} {V : Type v} [Group G] [Group V]
    [Finite G] [Finite V] [IsElementaryAbelian 2 V]
    [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hG : (⊤ : Subgroup G) = oddCore G ⊔ (S : Subgroup G))
    (hquadratic : IsQuadraticAction S V)
    (hgenerate : (⊤ : Subgroup V) =
      actionClosure G V (FixedPoints.subgroup S V)) :
    (⊤ : Subgroup V) =
      ⨆ (S0 : Subgroup S) (_ : Nat.card S = 2 * Nat.card S0),
        FixedPoints.subgroup S0 V := by
  let V0 : Subgroup V :=
    ⨆ (S0 : Subgroup S) (_ : Nat.card S = 2 * Nat.card S0),
      FixedPoints.subgroup S0 V
  have h11 := lemma_one_one h S
  have hSelem : IsElementaryAbelian 2 S := h11.part_d hquadratic
  let : IsElementaryAbelian 2 S := hSelem
  let : CommGroup S := IsMulCommutative.instCommGroup
  have hWstab : oddCore G ≤ MulAction.stabilizer G (V0 : Set V) := by
    rw [h11.part_c hSelem]
    refine iSup_le fun H => iSup_le fun hH => ?_
    exact oddCentralizer_stabilizes_indexFixedSup h S hquadratic hSelem H hH
  have hScentral : (S : Subgroup G) ≤
      Subgroup.centralizer ((S : Subgroup G) : Set G) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    exact (congrArg Subtype.val (mul_comm ⟨a, ha⟩ ⟨b, hb⟩)).symm
  have hSstab : (S : Subgroup G) ≤ MulAction.stabilizer G (V0 : Set V) :=
    hScentral.trans (centralizer_stabilizes_indexFixedSup S)
  have htopstab : (⊤ : Subgroup G) ≤ MulAction.stabilizer G (V0 : Set V) := by
    rw [hG]
    exact sup_le hWstab hSstab
  have hS_ne_bot : (S : Subgroup G) ≠ ⊥ :=
    Sylow.ne_bot_of_dvd_card S h.G_even.two_dvd
  let : Nontrivial S :=
    (Subgroup.nontrivial_iff_ne_bot (S : Subgroup G)).2 hS_ne_bot
  let : Fact (Nat.Prime 2) := ⟨by decide⟩
  let : Fact (IsPGroup 2 S) := ⟨S.isPGroup'⟩
  have hbotne : (⊥ : Subgroup S) ≠ ⊤ := by simp
  obtain ⟨M, hMcoat, _⟩ :=
    (eq_top_or_exists_le_coatom (⊥ : Subgroup S)).resolve_left hbotne
  have hMcardQ : Nat.card (S ⧸ M) = 2 :=
    _root_.card_quotient_coatom_eq_prime hMcoat
  have hMcard : Nat.card S = 2 * Nat.card M := by
    simpa [hMcardQ, Nat.mul_comm] using
      (Subgroup.card_eq_card_quotient_mul_card_subgroup M)
  have hfixSle : FixedPoints.subgroup S V ≤ V0 := by
    intro x hx
    apply Subgroup.mem_iSup_of_mem M
    apply Subgroup.mem_iSup_of_mem hMcard
    rw [FixedPoints.mem_subgroup] at hx ⊢
    intro m
    exact hx (m : S)
  apply le_antisymm
  · rw [hgenerate]
    rw [actionClosure]
    refine (Subgroup.closure_le V0).2 ?_
    rintro x ⟨g, y, hy, rfl⟩
    have hgstab := htopstab (show g ∈ (⊤ : Subgroup G) by simp)
    rw [MulAction.mem_stabilizer_set] at hgstab
    exact (hgstab y).2 (hfixSle hy)
  · exact le_top

end Stellmacher.SectionOne
