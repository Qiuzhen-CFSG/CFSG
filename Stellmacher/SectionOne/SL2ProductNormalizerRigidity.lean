module
public import Stellmacher.SectionsOneToFourDefs
public import Mathlib.GroupTheory.NoncommPiCoprod

/-!
# Normalizer rigidity for products of SL₂(2) factors

Suppose `E` is generated by a finite family of commuting normal `SL₂(2)`
factors, and `W` normalizes `E` while acting trivially on `E/E'`. Then
`W` normalizes every factor. This is the factor-preservation step in the
first paragraph of Stellmacher (1.7), Journal of Algebra 190 (1997), p. 19,
as transcribed in `refs/latex/stellmacher-n-group.tex`.

Each element of `SL₂(2)` is a product of two elements whose squares are
one, and its derived subgroup has exponent three. These two facts are
checked on the six concrete matrices by kernel reduction and transported
through the given isomorphisms. The canonical homomorphism from the product
of the commuting factors has image `E`; its derived image is therefore a
3-group, proving that `E'` is a 3-group without an independence assumption.

For a factor `D` and an involution `t ∈ D`, trivial action on `E/E'`
puts every `W`-conjugate of `t` inside `DE'`. In `E/D`, its image
thus belongs to a 3-group and has square one, so is trivial. Products of
such involutions generate `D`, giving its normalization.
-/

open scoped commutatorElement

namespace Stellmacher.SectionOne

/-- Every element of SL₂(2) is a product of two square-one elements. -/
public theorem sl2_involution_products
    {H : Type*} [Group H] [Finite H] (h : IsSL2Two H) (x : H) :
    ∃ a b : H, a ^ 2 = 1 ∧ b ^ 2 = 1 ∧ x = a * b := by
  obtain ⟨e⟩ := h
  have hfinite : ∀ x : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2),
      ∃ a b, a ^ 2 = 1 ∧ b ^ 2 = 1 ∧ x = a * b := by
    decide +kernel
  obtain ⟨a, b, ha, hb, hx⟩ := hfinite (e x)
  refine ⟨e.symm a, e.symm b, ?_, ?_, ?_⟩
  · simpa using congrArg e.symm ha
  · simpa using congrArg e.symm hb
  · exact e.injective (by simp [hx])

private theorem sl2_commutator_cube
    {H : Type*} [Group H] [Finite H] (h : IsSL2Two H)
    (x : H) (hx : x ∈ commutator H) : x ^ 3 = 1 := by
  obtain ⟨e⟩ := h
  have hmul : ∀ a b : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2),
      a ^ 3 = 1 → b ^ 3 = 1 → (a * b) ^ 3 = 1 := by
    decide +kernel
  have hcomm : ∀ a b : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2),
      ⁅a, b⁆ ^ 3 = 1 := by
    decide +kernel
  let C : Subgroup H :=
    { carrier := {x | (e x) ^ 3 = 1}
      one_mem' := by simp
      mul_mem' := by intro a b ha hb; simpa using hmul (e a) (e b) ha hb
      inv_mem' := by intro a ha; simp_all [inv_pow] }
  have hle : commutator H ≤ C := by
    rw [commutator_def, Subgroup.commutator_le]
    intro a _ b _
    change e ⁅a, b⁆ ^ 3 = 1
    rw [map_commutatorElement]
    exact hcomm _ _
  have hcube : e x ^ 3 = 1 := hle hx
  exact e.injective (by simpa using hcube)

private theorem product_derived_isPGroup_three
    {G : Type*} [Group G] [Finite G]
    (E : Subgroup G) (F : Finset (Subgroup G))
    (hprod : IsInternalDirectProduct E F)
    (hSL : ∀ D : Subgroup G, D ∈ F → IsSL2Two D) :
    IsPGroup 3 (commutator E) := by
  classical
  let I := {D : Subgroup G // D ∈ F}
  let P := ∀ i : I, (i : Subgroup G)
  have hcomm : Pairwise (fun i j : I => ∀ x y : G,
      x ∈ (i : Subgroup G) → y ∈ (j : Subgroup G) → Commute x y) := by
    intro i j hij x y hx hy
    exact hprod.2.2.2 i i.property j j.property
      (fun heq => hij (Subtype.ext heq)) x hx y hy
  let f : P →* G := Subgroup.noncommPiCoprod hcomm
  have hf : f.range = E := by
    rw [Subgroup.noncommPiCoprod_range]
    exact hprod.1.symm
  have hmap : (commutator P).map f = (commutator E).map E.subtype := by
    rw [map_commutator_eq, hf, Subgroup.map_subtype_commutator]
  have hPp : IsPGroup 3 (commutator P) := by
    intro x
    refine ⟨1, ?_⟩
    apply Subtype.ext
    funext i
    have heval : (x : P) i ∈ commutator (i : Subgroup G) := by
      have hm := Subgroup.mem_map_of_mem (Pi.evalMonoidHom (fun i : I => (i : Subgroup G)) i)
        x.property
      rw [map_commutator_eq] at hm
      exact Subgroup.commutator_mono le_top le_top hm
    exact sl2_commutator_cube (hSL i i.property) _ heval
  have himage : IsPGroup 3 ((commutator E).map E.subtype) := by
    rw [← hmap]
    exact hPp.map f
  exact himage.of_equiv ((commutator E).equivMapOfInjective E.subtype E.subtype_injective).symm

/-- Acting trivially on the derived quotient of an SL₂(2) product fixes every factor. -/
public theorem sl2_product_normalized_of_trivial_derived_quotient_action
    {G : Type*} [Group G] [Finite G]
    (E W : Subgroup G) (F : Finset (Subgroup G))
    (hprod : IsInternalDirectProduct E F)
    (hSL : ∀ D : Subgroup G, D ∈ F → IsSL2Two D)
    (hWE : W ≤ Subgroup.normalizer (E : Set G))
    (hquot : ⁅W,E⁆ ≤ (commutator E).map E.subtype) :
    ∀ D : Subgroup G, D ∈ F → W ≤ Subgroup.normalizer (D : Set G) := by
  classical
  let _ : Fact (Nat.Prime 3) := ⟨by decide⟩
  have hderived := product_derived_isPGroup_three E F hprod hSL
  intro D hDF
  have hDE : D ≤ E := by
    rw [hprod.1]
    exact le_iSup (fun i : {i : Subgroup G // i ∈ F} => (i : Subgroup G)) ⟨D, hDF⟩
  let DE : Subgroup E := D.subgroupOf E
  let _ : DE.Normal := hprod.2.1 D hDF
  let q : E →* E ⧸ DE := QuotientGroup.mk' DE
  let M := (commutator E).map q
  have hMthree : IsPGroup 3 M := hderived.map q
  have hinvol (w : G) (hw : w ∈ W) (d : D) (hd : d ^ 2 = 1) :
      w * (d : G) * w⁻¹ ∈ D := by
    let dE : E := ⟨d, hDE d.property⟩
    let cE : E := ⟨w * (d : G) * w⁻¹,
      (Subgroup.mem_normalizer_iff.mp (hWE hw) (d : G)).mp (hDE d.property)⟩
    have hcomm : cE * dE⁻¹ ∈ commutator E := by
      have hm : ⁅w, (d : G)⁆ ∈ (commutator E).map E.subtype :=
        hquot (Subgroup.commutator_mem_commutator hw (hDE d.property))
      obtain ⟨x, hx, hxeq⟩ := hm
      have heq : x = cE * dE⁻¹ := by
        apply Subtype.ext
        simpa [cE, dE, commutatorElement_def] using hxeq
      simpa [heq] using hx
    have hdq : q dE = 1 := (QuotientGroup.eq_one_iff _).2 d.property
    have hcq : q cE ∈ M := by
      have hm := Subgroup.mem_map_of_mem q hcomm
      change q cE ∈ (commutator E).map q
      simpa only [map_mul, map_inv, hdq, inv_one, mul_one] using hm
    have hcpow : cE ^ 2 = 1 := by
      apply Subtype.ext
      have hdG : (d : G) ^ 2 = 1 := congrArg Subtype.val hd
      change (w * (d : G) * w⁻¹) ^ 2 = 1
      rw [← MulAut.conj_apply, ← map_pow, hdG, map_one]
    have hqpow : q cE ^ 2 = 1 := by rw [← map_pow, hcpow, map_one]
    have htrivial : (⟨q cE, hcq⟩ : M) = 1 := by
      by_contra hne
      have hthree : 3 ∣ orderOf (⟨q cE, hcq⟩ : M) := hMthree.dvd_orderOf hne
      have htwo : orderOf (⟨q cE, hcq⟩ : M) ∣ 2 :=
        orderOf_dvd_of_pow_eq_one (Subtype.ext hqpow)
      have hbad := hthree.trans htwo
      norm_num at hbad
    have hc1 : q cE = 1 := congrArg Subtype.val htrivial
    have hcDE : cE ∈ DE := (QuotientGroup.eq_one_iff (N := DE) cE).1 hc1
    exact hcDE
  rw [Subgroup.le_normalizer_iff]
  intro w hw d hd
  obtain ⟨a, b, ha, hb, hab⟩ := sl2_involution_products (hSL D hDF) (⟨d, hd⟩ : D)
  have heq : d = (a : G) * (b : G) := congrArg Subtype.val hab
  rw [heq]
  have hfactor : w * ((a : G) * (b : G)) * w⁻¹ =
      (w * (a : G) * w⁻¹) * (w * (b : G) * w⁻¹) := by group
  rw [hfactor]
  exact D.mul_mem (hinvol w hw a ha) (hinvol w hw b hb)

end Stellmacher.SectionOne
