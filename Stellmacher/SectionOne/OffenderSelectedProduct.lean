module

public import Stellmacher.SectionOne.OneSevenGlobalProduct
public import Stellmacher.SectionOne.OneSevenModuleProduct

/-!
# The SL2 subproduct generated by offender members

Let J be generated by a family of actual members of A(V,S). Then
E=[O2'(G),J]J is a selected subproduct of the global one-seven factors,
normal inside that global product, and has the corresponding four-element
support decomposition of V. This uses the offender generators, not merely
the weaker inclusion J≤J(V,S), which would allow diagonal subgroups.

Select the global factors contained in E. The local factorization of every
nontrivial offender places its full local product in the selected join.
This join contains J and is normalized by the odd core, so contains E and
hence equals it. Relative normality and independence descend from the global
product. Since E≤O2'(G)J and the odd core meets S trivially, J=S∩E.
Reindexing the selected finite family gives the shared group/module factors,
using the previously proved module decomposition for one-seven factors.
The finite-family form is also public so the simultaneous opposite-Sylow
argument in (2.3) can use these actual selected factors directly.
The odd-core/Sylow intersection identity is public as well, for the final
quotient-image Sylow reduction in (2.3).

This supplies the selected-factor step in Stellmacher (2.2), journal page20,
refs/latex/stellmacher-n-group.tex. Ambient normality of E is deliberately
not asserted here; the subsequent weak-closure/Frattini argument supplies it.
-/

namespace Stellmacher.SectionOne
universe u v

public theorem offender_selected_finite_product
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G) {I : Sort v}
    (A : I → Subgroup G) (hA : ∀ i, oneA (V := V) (S : Subgroup G) (A i))
    (J : Subgroup G) (hJ : J = ⨆ i, A i) :
    let E := ⁅oddCore G, J⁆ ⊔ J
    E ≤ oneSevenGenerated (G := G) (V := V) ∧
    (E.subgroupOf (oneSevenGenerated (G := G) (V := V))).Normal ∧
    ∃ F : Finset (Subgroup G), IsInternalDirectProduct E F ∧
      ∀ D ∈ F, IsOneSevenFactor (V := V) D := by
  classical
  let W := oddCore G
  let E := ⁅W, J⁆ ⊔ J
  let E₀ := oneSevenGenerated (G := G) (V := V)
  let F₀ := oneSevenFactors (G := G) (V := V)
  let F := F₀.filter (fun D => D ≤ E)
  let K : Subgroup G := ⨆ D : {D : Subgroup G // D ∈ F}, D.val
  obtain ⟨hE₀normal, hprod₀, hJE₀⟩ := oneSeven_global_product h S
  have hmem (D : Subgroup G) : D ∈ F ↔ IsOneSevenFactor (V := V) D ∧ D ≤ E := by
    simp [F, F₀]
  have hKleE : K ≤ E := iSup_le fun D => ((hmem D.val).mp D.property).2
  have hDleK (D : Subgroup G) (hDF : D ∈ F) : D ≤ K :=
    le_iSup (fun D : {D : Subgroup G // D ∈ F} => D.val) ⟨D, hDF⟩
  have hJleK : J ≤ K := by
    rw [hJ]
    apply iSup_le
    intro i
    by_cases hne : A i = ⊥
    · rw [hne]
      exact bot_le
    obtain ⟨FA, hprodA, hFA⟩ := oneA_sl2_factors h S (A i) (hA i) hne
    have hAiJ : A i ≤ J := by rw [hJ]; exact le_iSup A i
    have hlocal : ⁅W, A i⁆ ⊔ A i ≤ E :=
      sup_le_sup (Subgroup.commutator_mono le_rfl hAiJ) hAiJ
    apply (show A i ≤ ⁅W, A i⁆ ⊔ A i from le_sup_right).trans
    rw [hprodA.1]
    apply iSup_le
    intro D
    apply hDleK D.val
    apply (hmem D.val).mpr
    refine ⟨hFA D.val D.property, ?_⟩
    apply le_trans (le_iSup (fun L : {L : Subgroup G // L ∈ FA} => L.val) D)
    rw [← hprodA.1]
    exact hlocal
  have hWnormK : W ≤ Subgroup.normalizer (K : Set G) := by
    rw [Subgroup.le_normalizer_iff]
    intro w hw x hx
    have hle : K ≤ K.comap (MulAut.conj w).toMonoidHom := by
      apply iSup_le
      intro D d hd
      have hD := ((hmem D.val).mp D.property).1
      have hWD : W ≤ Subgroup.normalizer (D.val : Set G) :=
        (show W ≤ W ⊔ D.val from le_sup_left).trans
          ((Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_right).mp hD.2.2.2)
      exact (hDleK D.val D.property)
        ((Subgroup.mem_normalizer_iff.mp (hWD hw) d).mp hd)
    exact hle hx
  have hEK : E = K := by
    apply le_antisymm ?_ hKleE
    apply sup_le ?_ hJleK
    exact (Subgroup.commutator_mono le_rfl hJleK).trans
      (Subgroup.le_normalizer_iff_commutator_le_right.mp hWnormK)
  have hEleE₀ : E ≤ E₀ := by
    rw [hEK]
    exact iSup_le fun D => le_sSup (((hmem D.val).mp D.property).1)
  have hE₀normD (D : Subgroup G) (hDF : D ∈ F) :
      E₀ ≤ Subgroup.normalizer (D : Set G) := by
    have hDF₀ : D ∈ F₀ := (Finset.mem_filter.mp hDF).1
    have hDE₀ : D ≤ E₀ := le_sSup (((hmem D).mp hDF).1)
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer hDE₀).mp (hprod₀.2.1 D hDF₀)
  have hEnormal : (E.subgroupOf E₀).Normal := by
    apply (Subgroup.normal_subgroupOf_iff_le_normalizer hEleE₀).mpr
    rw [Subgroup.le_normalizer_iff]
    intro e he x hx
    have hle : E ≤ E.comap (MulAut.conj e).toMonoidHom := by
      nth_rw 1 [hEK]
      apply iSup_le
      intro D d hd
      exact ((hmem D.val).mp D.property).2
        ((Subgroup.mem_normalizer_iff.mp (hE₀normD D.val D.property he) d).mp hd)
    exact hle hx
  refine ⟨hEleE₀, hEnormal, F, ?_, fun D hD => ((hmem D).mp hD).1⟩
  refine ⟨hEK, ?_, ?_, ?_⟩
  · intro D hD
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer ((hmem D).mp hD).2).mpr
      (hEleE₀.trans (hE₀normD D hD))
  · intro D hD L hL hne
    exact hprod₀.2.2.1 D (Finset.mem_filter.mp hD).1 L (Finset.mem_filter.mp hL).1 hne
  · intro D hD L hL hne
    exact hprod₀.2.2.2 D (Finset.mem_filter.mp hD).1 L (Finset.mem_filter.mp hL).1 hne

public theorem oddCore_commutator_join_sylow_inf
    {G : Type u} [Group G] [Finite G] (S : Sylow 2 G)
    (J : Subgroup G) (hJS : J ≤ (S : Subgroup G)) :
    J = (S : Subgroup G) ⊓ (⁅oddCore G, J⁆ ⊔ J) := by
  let W := oddCore G
  let _ : W.Normal := pPrimeCore_normal
  have hdisj : Disjoint (S : Subgroup G) W := by
    apply Subgroup.disjoint_of_coprime_natCard
    obtain ⟨n, hn⟩ := S.isPGroup'.exists_card_eq
    rw [hn]
    exact (pPrimeCore_coprime_card (G := G) (p := 2)).pow_left n
  apply le_antisymm (le_inf hJS le_sup_right)
  intro x hx
  have hxWJ : x ∈ W ⊔ J :=
    (sup_le_sup (Subgroup.commutator_le_left W J) le_rfl) hx.2
  obtain ⟨w, hw, j, hj, hmul⟩ := Subgroup.mem_sup_of_normal_left.mp hxWJ
  have hwS : w ∈ (S : Subgroup G) := by
    have hweq : w = x * j⁻¹ := by rw [← hmul]; group
    rw [hweq]
    exact (S : Subgroup G).mul_mem hx.1 ((S : Subgroup G).inv_mem (hJS hj))
  have hwone : w = 1 := hdisj.le_bot ⟨hwS, hw⟩
  simpa [← hmul, hwone] using hj


public theorem offender_generated_selected_product
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G) {I : Sort v}
    (A : I → Subgroup G) (hA : ∀ i, oneA (V := V) (S : Subgroup G) (A i))
    (J : Subgroup G) (hJ : J = ⨆ i, A i) :
    let E := ⁅oddCore G, J⁆ ⊔ J
    J = (S : Subgroup G) ⊓ E ∧
    E ≤ oneSevenGenerated (G := G) (V := V) ∧
    (E.subgroupOf (oneSevenGenerated (G := G) (V := V))).Normal ∧
    ∃ (n : ℕ) (D : Fin n → Subgroup G),
      IsInternalDirectProductFamily E D ∧
      Function.Injective D ∧
      (∀ i, IsOneSevenFactor (V := V) (D i)) ∧
      (∀ i, ((D i).subgroupOf E).Normal) ∧
      IsInternalDirectProductFamily (⊤ : Subgroup V)
        (fun i : Option (Fin n) => match i with
          | none => FixedPoints.subgroup E V
          | some i => commutatorAction (D i) V) := by
  classical
  let E := ⁅oddCore G, J⁆ ⊔ J
  obtain ⟨hEglobal, hEnorm, F, hprod, hF⟩ := offender_selected_finite_product h S A hA J hJ
  change IsInternalDirectProduct E F at hprod
  have hJS : J ≤ (S : Subgroup G) := by rw [hJ]; exact iSup_le fun i => (hA i).1
  refine ⟨oddCore_commutator_join_sylow_inf S J hJS, hEglobal, hEnorm, ?_⟩
  let L := {D : Subgroup G // D ∈ F}
  let n := Fintype.card L
  let e : Fin n ≃ L := (Fintype.equivFin L).symm
  let D : Fin n → Subgroup G := fun i => (e i).val
  have hDi (i : Fin n) : D i ∈ F := (e i).property
  have hinj : Function.Injective D := by
    intro i j hij
    exact e.injective (Subtype.ext hij)
  have hgen : E = ⨆ i : Fin n, D i := by
    rw [hprod.1]
    apply le_antisymm
    · apply iSup_le
      intro K
      obtain ⟨i, rfl⟩ := e.surjective K
      exact le_iSup D i
    · apply iSup_le
      intro i
      exact le_iSup (fun K : L => (K : Subgroup G)) (e i)
  have hD : ∀ i, IsOneSevenFactor (V := V) (D i) := fun i => hF (D i) (hDi i)
  refine ⟨n, D, ⟨hgen, ?_, ?_⟩, hinj, hD, (fun i => hprod.2.1 (D i) (hDi i)),
    oneSevenFactor_module_product h D hD hinj E hgen⟩
  · intro i j hij
    exact hprod.2.2.1 (D i) (hDi i) (D j) (hDi j) (fun heq => hij (hinj heq))
  · intro i j hij
    exact hprod.2.2.2 (D i) (hDi i) (D j) (hDi j) (fun heq => hij (hinj heq))

end Stellmacher.SectionOne
