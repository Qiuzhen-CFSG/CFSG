module
public import Stellmacher.SectionOne.QuadraticMixedLayerFixedHyperplane
public import Theory.GroupAction.SubgroupConjugation
public import Theory.GroupAction.Lemmas

/-!
# Quadratic conjugate closures and coatom centralizers

Let a solvable subgroup act by literal conjugation on an elementary binary
subgroup generated by conjugates of a Sylow-fixed seed. Suppose the actor
has normal layers R≤L with R a two-group, L/R odd, and L supplemented by
the supplied Sylow subgroup. If a subgroup Y of that Sylow acts quadratically,
then centralizers in the module of subgroups of index at most two in Y
control the whole module: when all these centralizers lie in Z, so does V.

Construct the actual subgroup conjugation homomorphism. The generating seed
is fixed by the Sylow image, so its translates give exact fixed generation.
The ambient double commutator identity proves quadratic action on the same
module. The mixed-layer form of hereditary (1.2), applied to V∩Z, would give
an escaping fixed point unless V≤Z. Conjugation compatibility places that
point in the corresponding ambient centralizer and yields the contradiction.

Source: the application of (1.2) in Stellmacher (10.1)(a3)(9), Journal of
Algebra 190 (1997), printed pp.61–62. The statement uses a literal closure
set and is independent of graph notation and normalizer conclusions.
-/

namespace Stellmacher.SectionOne
open scoped commutatorElement

public theorem quadratic_conjugate_closure_le_of_coatom_centralizers
    {G : Type*} [Group G] [Finite G]
    (P V Z B : Subgroup G) [Group.IsSolvable P] [IsElementaryAbelian 2 V]
    (hPV : P ≤ Subgroup.normalizer (V : Set G))
    (hBV : B ≤ V)
    (hV : V = Subgroup.closure {x : G | ∃ actor : P, ∃ point : B,
      x = (actor : G) * (point : G) * (actor : G)⁻¹})
    (R L : Subgroup P) [R.Normal] [L.Normal]
    (hR2 : IsPGroup 2 R) (hRL : R ≤ L) (hodd : Nat.Coprime 2 (R.relIndex L))
    (S : Sylow 2 P) (hsupp : (⊤ : Subgroup P) = L ⊔ (S : Subgroup P))
    (hseed : (S : Subgroup P).map P.subtype ≤ Subgroup.centralizer (B : Set G))
    (Y : Subgroup P) (hYS : Y ≤ (S : Subgroup P))
    (hdouble : ⁅⁅V,Y.map P.subtype⁆,Y.map P.subtype⁆ = ⊥)
    (hfixed : ∀ F : Subgroup P, F ≤ Y → F.relIndex Y ≤ 2 →
      V ⊓ Subgroup.centralizer (F.map P.subtype : Set G) ≤ Z) : V ≤ Z := by
  classical
  let _ := Subgroup.conjMulDistribMulActionOfLeNormalizer P V hPV
  let action : P →* MulAut V := MulDistribMulAction.toMulAut P V
  have haction (actor : P) (point : V) :
      ((action actor point : V) : G) = (actor:G)*(point:G)*(actor:G)⁻¹ := rfl
  have hgen : (⊤ : Subgroup V) = actionClosure action.range V
      (FixedPoints.subgroup ((S : Subgroup P).map action.rangeRestrict) V) := by
    let C := actionClosure action.range V
      (FixedPoints.subgroup ((S : Subgroup P).map action.rangeRestrict) V)
    have hBfixed (b : B) : (⟨b,hBV b.property⟩ : V) ∈
        FixedPoints.subgroup ((S : Subgroup P).map action.rangeRestrict) V := by
      intro actor
      obtain ⟨a,ha,heq⟩ := actor.property
      change (actor : action.range).val (⟨b,hBV b.property⟩ : V) = _
      rw [← heq]
      apply Subtype.ext
      change (a:G)*(b:G)*(a:G)⁻¹ = b
      have hc : (b:G)*(a:G)=(a:G)*(b:G) := Subgroup.mem_centralizer_iff.mp
        (hseed (Subgroup.mem_map_of_mem P.subtype ha)) b b.property
      rw [← hc]
      simp
    have hVC : V ≤ C.map V.subtype := by
      conv_lhs => rw [hV]
      apply (Subgroup.closure_le _).mpr
      rintro point ⟨actor,b,rfl⟩
      have hm : action actor (⟨b,hBV b.property⟩ : V) ∈ C :=
        Subgroup.subset_closure ⟨action.rangeRestrict actor,
          (⟨b,hBV b.property⟩ : V),hBfixed b,rfl⟩
      exact ⟨action actor (⟨b,hBV b.property⟩ : V),hm,haction actor _⟩
    apply le_antisymm ?_ le_top
    intro point _
    obtain ⟨v,hv,heq⟩ := hVC point.property
    exact (Subtype.ext heq : v=point) ▸ hv
  let Yimage := Y.map action.rangeRestrict
  have hcomm : commutatorAction Yimage V ≤
      (⁅V,Y.map P.subtype⁆).comap V.subtype := by
    rw [commutatorAction_eq_closure,Subgroup.closure_le]
    rintro point ⟨actor,v,rfl⟩
    obtain ⟨a,ha,heq⟩ := actor.property
    change (v:G)⁻¹ * ((actor:action.range).val v : V) ∈ ⁅V,Y.map P.subtype⁆
    rw [← heq]
    change (v:G)⁻¹ * ((action a v : V) : G) ∈ ⁅V,Y.map P.subtype⁆
    rw [haction]
    simpa only [commutatorElement_def,inv_inv,mul_assoc,Subgroup.coe_subtype] using
      Subgroup.commutator_mem_commutator (V.inv_mem v.property)
        (Subgroup.mem_map_of_mem P.subtype ha)
  have hquad : IsQuadraticAction Yimage V := by
    apply bot_unique
    change Subgroup.closure {point : V | ∃ actor : Yimage, ∃ v : V,
      v ∈ commutatorAction Yimage V ∧ point=v⁻¹*actor • v} ≤ ⊥
    apply (Subgroup.closure_le _).mpr
    rintro point ⟨actor,v,hv,rfl⟩
    obtain ⟨a,ha,heq⟩ := actor.property
    apply Subgroup.mem_bot.mpr
    apply Subtype.ext
    change (v:G)⁻¹ * ((actor:action.range).val v : V) = 1
    rw [← heq]
    change (v:G)⁻¹ * ((action a v : V) : G) = 1
    rw [haction]
    have hh := Subgroup.commutator_mem_commutator
      (⁅V,Y.map P.subtype⁆.inv_mem (hcomm hv))
      (Subgroup.mem_map_of_mem P.subtype ha)
    rw [hdouble] at hh
    simpa only [Subgroup.mem_bot,commutatorElement_def,inv_inv,mul_assoc,Subgroup.coe_subtype] using hh
  by_contra hnot
  have hZproper : Z.subgroupOf V ≠ ⊤ := by
    intro hh
    apply hnot
    intro v hv
    exact hh.ge (show (⟨v,hv⟩ : V) ∈ ⊤ from Subgroup.mem_top _)
  have hlift : ∃ F : Subgroup P, F ≤ Y ∧ Nat.card Y ≤ 2 * Nat.card F ∧
      ¬ FixedPoints.subgroup (F.map action.rangeRestrict) V ≤ Z.subgroupOf V := by
    exact quadratic_fixed_hyperplane_lift_of_mixed_layer action R L hR2 hRL hodd
      S hsupp hgen Y hYS hquad (Z.subgroupOf V) hZproper
  obtain ⟨F,hFY,hcard,hescape⟩ := hlift
  have hindex : F.relIndex Y ≤ 2 := by
    have hh := Subgroup.relIndex_mul_relIndex (⊥ : Subgroup P) F Y bot_le hFY
    simp only [Subgroup.relIndex_bot_left] at hh
    have hp : 0 < Nat.card F := Nat.card_pos
    nlinarith
  apply hescape
  intro v hv
  apply hfixed F hFY hindex
  refine ⟨v.property,?_⟩
  change (v:G) ∈ Subgroup.centralizer (F.map P.subtype : Set G)
  rw [Subgroup.mem_centralizer_iff]
  rintro a ⟨aP,ha,rfl⟩
  have heq := hv ⟨action.rangeRestrict aP,
    Subgroup.mem_map_of_mem action.rangeRestrict ha⟩
  have hh := congrArg Subtype.val heq
  change ((action aP v : V) : G) = v at hh
  rw [haction] at hh
  exact (mul_inv_eq_iff_eq_mul.mp hh)

end Stellmacher.SectionOne

