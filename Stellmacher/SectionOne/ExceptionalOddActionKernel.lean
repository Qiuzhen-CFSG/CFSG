module

public import Stellmacher.SectionOne.LemmaOneFive
public import Theory.GroupAction.NormalizingActor
public import Theory.GroupAction.CoprimeCommutatorCentralizer
public import Theory.GroupTheory.OddCyclicThreeNormalizer
public import Theory.GroupTheory.CoprimeCentralizerDecomposition

/-!
# Centrality of the exceptional odd action kernel

Let the elementary Sylow two-subgroup have order four, and suppose the odd
core is generated by its commutators with it. Assume the order-two maximal
offenders have local commutators of order three. If the full Sylow action
commutator lies in `U=[V,F]` and both the Sylow subgroup and its odd
centralizer normalize `F`, then `C_W(U)` centralizes the Sylow subgroup
and the whole odd core.

Coprime action first makes the odd kernel centralize the Sylow subgroup.
It then normalizes every local order-three commutator, so oddness makes it
centralize that commutator. The odd Sylow centralizer normalizes the kernel
because it preserves `U`. Coprime decomposition of each local centralizer
therefore makes the kernel normal in it. Lemma (1.5)(d) gives normality in
the odd core, and the three-subgroups lemma gives the required centrality.

This justifies the kernel-centrality step of Stellmacher (1.6), journal p.18,
without assuming that the local commutators themselves generate the odd
core. Source: `refs/latex/stellmacher-n-group.tex`.
-/

open scoped IsMulCommutative

namespace Stellmacher.SectionOne

universe u

private theorem normalizes_action_kernel
    {G V : Type*} [Group G] [Group V] [MulDistribMulAction G V]
    (W N : Subgroup G) (U : Subgroup V)
    (hNW : N ≤ Subgroup.normalizer (W : Set G)) [IsInvariant N V U] :
    N ≤ Subgroup.normalizer (W ⊓ fixingSubgroup G (U : Set V) : Subgroup G) := by
  apply Subgroup.le_normalizer_iff.mpr
  rintro n hn q ⟨hqW, hqfix⟩
  refine ⟨(Subgroup.mem_normalizer_iff.mp (hNW hn) q).mp hqW, ?_⟩
  change n * q * n⁻¹ ∈ fixingSubgroup G (U : Set V)
  rw [mem_fixingSubgroup_iff]
  intro v hv
  have hinv : n⁻¹ • v ∈ U :=
    (IsInvariant.invariant (A := N) (G := V) (H := U) (⟨n, hn⟩ : N)⁻¹ v).mp hv
  have hq := (mem_fixingSubgroup_iff (M := G) (s := (U : Set V))).mp hqfix _ hinv
  rw [mul_smul, mul_smul, hq, smul_inv_smul]

public theorem exceptional_odd_action_kernel_centralizes
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (h : Hypotheses G V) (S : Sylow 2 G)
    (hS : IsElementaryAbelian 2 (S : Subgroup G))
    (hScard : Nat.card (S : Subgroup G) = 4)
    (hW : oddCore G = ⁅oddCore G, (S : Subgroup G)⁆)
    (hlocal : ∀ X : Subgroup G,
      oneAmax (G := G) (V := V) (S : Subgroup G) X → Nat.card X = 2 →
      Nat.card (⁅oddCore G ⊓ Subgroup.centralizer (X : Set G), (S : Subgroup G)⁆ : Subgroup G) = 3)
    (F : Subgroup G)
    (hnorm : (S : Subgroup G) ⊔
      (oddCore G ⊓ Subgroup.centralizer ((S : Subgroup G) : Set G)) ≤
        Subgroup.normalizer (F : Set G))
    (hcomm : commutatorAction (S : Subgroup G) V ≤ commutatorAction F V) :
    let Q := oddCore G ⊓ fixingSubgroup G (commutatorAction F V : Set V)
    ⁅Q, (S : Subgroup G)⁆ = ⊥ ∧ ⁅Q, oddCore G⁆ = ⊥ := by
  let W : Subgroup G := oddCore G
  let SG : Subgroup G := S
  let C : Subgroup G := W ⊓ Subgroup.centralizer (SG : Set G)
  let U : Subgroup V := commutatorAction F V
  let Q : Subgroup G := W ⊓ fixingSubgroup G (U : Set V)
  let _ : W.Normal := pPrimeCore_normal
  let _ : Group.IsSolvable G := h.G_solvable
  have hSnorm : SG ≤ Subgroup.normalizer (F : Set G) := le_sup_left.trans hnorm
  have hCnorm : C ≤ Subgroup.normalizer (F : Set G) := le_sup_right.trans hnorm
  let _ : IsInvariant SG V U := commutatorAction_isInvariant_of_normalizing_actor SG F hSnorm
  let _ : IsInvariant C V U := commutatorAction_isInvariant_of_normalizing_actor C F hCnorm
  have hSnormQ : SG ≤ Subgroup.normalizer (Q : Set G) :=
    normalizes_action_kernel W SG U Subgroup.le_normalizer_of_normal
  have hCnormQ : C ≤ Subgroup.normalizer (Q : Set G) :=
    normalizes_action_kernel W C U Subgroup.le_normalizer_of_normal
  have hQodd : Nat.Coprime 2 (Nat.card Q) :=
    (pPrimeCore_coprime_card (G := G) (p := 2)).of_dvd_right
      (Subgroup.card_dvd_of_le (show Q ≤ W from inf_le_left))
  have hcopQV : Nat.Coprime (Nat.card Q) (Nat.card V) := by
    obtain ⟨n, hn⟩ := (IsElementaryAbelian.isPGroup 2 V).exists_card_eq
    rw [hn]
    exact hQodd.symm.pow_right n
  let _ : IsInvariant SG V (commutatorAction Q V) :=
    commutatorAction_isInvariant_of_normalizing_actor SG Q hSnormQ
  have hQfix : Q ≤ fixingSubgroup G (commutatorAction SG V : Set V) := by
    intro q hq
    rw [mem_fixingSubgroup_iff]
    intro v hv
    exact (mem_fixingSubgroup_iff (M := G) (s := (U : Set V))).mp hq.2 v (hcomm hv)
  have hSQ : ⁅SG, Q⁆ = ⊥ :=
    commutator_eq_bot_of_coprime_fixing_action_commutator SG Q hcopQV hQfix h.action_faithful
  have hQS : ⁅Q, SG⁆ = ⊥ := by rw [Subgroup.commutator_comm]; exact hSQ
  have hQCS : Q ≤ Subgroup.centralizer (SG : Set G) :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hQS
  have hWnormQ : W ≤ Subgroup.normalizer (Q : Set G) := by
    have hgen := (lemma_one_five h S (S : Subgroup G) le_rfl).part_d hS
      (by omega : 4 ≤ Nat.card (S : Subgroup G))
    change W = _ at hgen
    rw [hgen]
    refine iSup_le ?_
    intro X
    let D := W ⊓ Subgroup.centralizer ((X : Subgroup G) : Set G)
    let L := ⁅D, SG⁆
    have hCD : C ≤ D :=
      inf_le_inf le_rfl (Subgroup.centralizer_le X.property.1.1)
    have hQD : Q ≤ D :=
      le_inf inf_le_left (hQCS.trans (Subgroup.centralizer_le X.property.1.1))
    have hQL : Q ≤ Subgroup.normalizer (L : Set G) :=
      hQD.trans (Subgroup.normalizer_commutator_ge_left D SG)
    have hLcard : Nat.card L = 3 := hlocal X X.property.1 X.property.2
    have hLQ : ⁅L, Q⁆ = ⊥ :=
      Subgroup.commutator_eq_bot_of_odd_normalizes_card_three L Q hLcard hQodd hQL
    have hLnormQ : L ≤ Subgroup.normalizer (Q : Set G) :=
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hLQ).trans
        (Subgroup.centralizer_le_normalizer (Q : Set G))
    have hSnormD : SG ≤ Subgroup.normalizer (D : Set G) := by
      have hSnormX : SG ≤ Subgroup.normalizer ((X : Subgroup G) : Set G) := by
        let _ : IsMulCommutative SG := hS.toIsMulCommutative
        exact (Subgroup.normal_subgroupOf_iff_le_normalizer X.property.1.1).mp inferInstance
      have hnormCent : Subgroup.normalizer ((X : Subgroup G) : Set G) ≤
          Subgroup.normalizer (Subgroup.centralizer ((X : Subgroup G) : Set G) : Set G) :=
        (Subgroup.normal_subgroupOf_iff_le_normalizer
          (Subgroup.centralizer_le_normalizer ((X : Subgroup G) : Set G))).mp inferInstance
      exact (le_inf Subgroup.le_normalizer_of_normal (hSnormX.trans hnormCent)).trans
        Subgroup.inf_normalizer_le_normalizer_inf
    have hDodd : Nat.Coprime 2 (Nat.card D) :=
      (pPrimeCore_coprime_card (G := G) (p := 2)).of_dvd_right
        (Subgroup.card_dvd_of_le (show D ≤ W from inf_le_left))
    have hcopSD : Nat.Coprime (Nat.card SG) (Nat.card D) := by
      change Nat.Coprime (Nat.card (S : Subgroup G)) (Nat.card D)
      rw [hScard]
      exact hDodd.pow_left 2
    have hDC : D ⊓ Subgroup.centralizer (SG : Set G) = C :=
      le_antisymm (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
        (le_inf hCD inf_le_right)
    have hdecomp : D = L ⊔ C := by
      simpa only [hDC] using Subgroup.eq_commutator_sup_centralizer_of_solvable_coprime
        D SG hSnormD inferInstance hcopSD
    change D ≤ Subgroup.normalizer (Q : Set G)
    rw [hdecomp]
    exact sup_le hLnormQ hCnormQ
  have hQWle : ⁅Q, W⁆ ≤ Q :=
    Subgroup.le_normalizer_iff_commutator_le_left.mp hWnormQ
  have hrot : ⁅⁅Q, W⁆, SG⁆ = ⊥ := by
    apply le_antisymm _ bot_le
    exact (Subgroup.commutator_mono hQWle le_rfl).trans hQS.le
  have hWQ : ⁅W, Q⁆ = ⊥ := by
    have hW' : W = ⁅W, SG⁆ := hW
    rw [hW']
    exact Subgroup.commutator_commutator_eq_bot_of_rotate (by rw [hSQ]; simp) hrot
  exact ⟨hQS, by rw [Subgroup.commutator_comm]; exact hWQ⟩

end Stellmacher.SectionOne

