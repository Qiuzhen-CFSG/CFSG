module
public import Stellmacher.SL2DerivedCard
public import Mathlib.Tactic.IntervalCases

/-!
# Full image of an SL₂(2) factor under an SL₂(2) quotient

Let F be generated by the ambient derived subgroup of an SL₂(2) subgroup
D and a two-subgroup R. Every surjective homomorphism from F to an SL₂(2)
group maps D onto that whole group. The statement keeps the actual
subgroup inclusion and supplied homomorphism; it assumes no normalization
of D by R and no new quotient identification.

A proper image of D has order one, two or three, so it is abelian.
The derived-subgroup image therefore vanishes. Mapping the supplied
generation equality then makes the entire target an image of R, hence
a two-group, contradicting its order six.

This elementary image argument supplies the full selected-factor image
used in the all-central branch of Stellmacher (9.4), printed pp.51–52 /
PDF pp.41–42. The subsequent canonical-factor normalizer theorem uses this
actual full image to derive the required normalization.
-/

namespace Stellmacher.SectionOne
universe u

public theorem sl2_factor_image_eq_top_of_derived_supplement
    {G L : Type u} [Group G] [Finite G] [Group L] [Finite L]
    (D F R : Subgroup G) (hDF : D ≤ F) (hRF : R ≤ F)
    (hD : IsSL2Two D) (hR : IsPGroup 2 R)
    (hgen : F = (commutator D).map D.subtype ⊔ R)
    (f : F →* L) (hsurj : Function.Surjective f) (hL : IsSL2Two L) :
    (D.subgroupOf F).map f = ⊤ := by
  let J := (D.subgroupOf F).map f
  have hcardL : Nat.card L = 6 := RankOneThreeGroupAssembly.isSL2Two_card hL
  have hcardD : Nat.card (D.subgroupOf F) = 6 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hDF).toEquiv]
    exact RankOneThreeGroupAssembly.isSL2Two_card hD
  by_contra hproper
  have hJlt : Nat.card J < 6 := by
    have hle : Nat.card J ≤ 6 := by
      rw [← hcardD]
      exact Nat.le_of_dvd Nat.card_pos ((D.subgroupOf F).card_map_dvd f)
    have hne : Nat.card J ≠ 6 := by
      intro hh
      apply hproper
      exact Subgroup.eq_top_of_card_eq J (hh.trans hcardL.symm)
    omega
  have hdiv : Nat.card J ∣ 6 := hcardL ▸ Subgroup.card_subgroup_dvd_card J
  have hcases : Nat.card J = 1 ∨ Nat.card J = 2 ∨ Nat.card J = 3 := by
    interval_cases hc : Nat.card J <;> norm_num at *
  have hJcomm : IsMulCommutative J := by
    rcases hcases with h1 | h2 | h3
    · have hbot : J = ⊥ := Subgroup.card_eq_one.mp h1
      rw [hbot]
      infer_instance
    · exact (isCyclic_of_prime_card h2).isMulCommutative
    · exact (isCyclic_of_prime_card h3).isMulCommutative
  have hderivedNative : ((commutator D).map D.subtype).subgroupOf F =
      ⁅D.subgroupOf F,D.subgroupOf F⁆ := by
    apply Subgroup.map_injective F.subtype_injective
    rw [Subgroup.map_subgroupOf_eq_of_le ((Subgroup.map_subtype_le _).trans hDF),
      Subgroup.map_commutator,Subgroup.map_subgroupOf_eq_of_le hDF,
      Subgroup.map_subtype_commutator]
  have hderivedImage : (((commutator D).map D.subtype).subgroupOf F).map f = ⊥ := by
    rw [hderivedNative,Subgroup.map_commutator]
    exact Subgroup.commutator_self_eq_bot_iff.mpr hJcomm
  have htop : (R.subgroupOf F).map f = ⊤ := by
    have hnative : ((commutator D).map D.subtype).subgroupOf F ⊔ R.subgroupOf F = ⊤ := by
      rw [← Subgroup.subgroupOf_sup ((Subgroup.map_subtype_le _).trans hDF) hRF,
        ← hgen,Subgroup.subgroupOf_self]
    have hh := congrArg (fun X : Subgroup F => X.map f) hnative
    rwa [Subgroup.map_sup,hderivedImage,bot_sup_eq,Subgroup.map_top_of_surjective f hsurj] at hh
  have hLp : IsPGroup 2 L := by
    have hh : IsPGroup 2 ((R.subgroupOf F).map f) := hR.comap_subtype.map f
    rw [htop] at hh
    exact hh.of_equiv Subgroup.topEquiv
  obtain ⟨n,hn⟩ := hLp.exists_card_eq
  have hthree : 3 ∣ 2^n := by rw [← hn,hcardL]; decide
  have hh : 3 ∣ 2 := Nat.prime_three.dvd_of_dvd_pow hthree
  norm_num at hh

end Stellmacher.SectionOne
