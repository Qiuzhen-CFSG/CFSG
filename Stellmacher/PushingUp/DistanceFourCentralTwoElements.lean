module
public import Stellmacher.PushingUp.DistanceFourNormality
public import Stellmacher.PushingUp.LocalCharacteristicObstruction
public import Theory.Frattini.PGroup
public import Stellmacher.PushingUp.DistanceFourCentralQuotient

/-!
# Central two-elements in the distance-four subgroup

In the critical-distance-four configuration of Stellmacher, *Pushing up*,
Arch. Math. 46 (1986), (3.3), p.15, every central 2-element of the finite
vertex stabilizer `G_a` belongs to `U = Z_a Z_c Z_u`. This is the input that
lifts the proved normality of `U Z(G_a)` to normality of `U` itself.
The theorem retains the original pushing-up hypotheses and chosen configuration.

The odd-index centralizer theorem places the center of any Sylow `P` of
`G_a` inside `Q_a`. The proved factorization `Q_a = D U` writes a central
Sylow element as `d w`. Since `d` centralizes `U`, the factor `w` is in
`Z(U) = Z_a` and has square one. Thus the square equals `d²` and centralizes
`F`; it also centralizes `Q_a`, so it is central in `G_a = F Q_a`.

The Frattini subgroup of the abelian group `Z(P)` is generated by squares.
Its image is therefore central in `G_a`, while it is characteristic in `P`.
Transported standing condition (P) forces that Frattini subgroup to vanish,
so `Z(P)` has exponent two. A central 2-element generates a normal 2-subgroup
and lies in `P`; it consequently belongs to `Omega_1(Z(P)) ≤ Z_a ≤ U`.
Only the vertex stabilizer is required to be finite.
-/

namespace Stellmacher.PushingUp
open scoped Pointwise

private theorem square_central_of_core_factorization
    {G : Type*} [Group G] (Q D U F : Subgroup G) [D.Normal]
    (hQ : Q = D ⊔ U) (hgen : F ⊔ Q = ⊤)
    (hDU : D ≤ Subgroup.centralizer U) (hDF : D ≤ Subgroup.centralizer F)
    (hUsq : ∀ u ∈ U, (∀ w ∈ U, w * u = u * w) → u ^ 2 = 1)
    (z : G) (hzQ : z ∈ Q) (hz : ∀ q ∈ Q, q * z = z * q) :
    z ^ 2 ∈ Subgroup.center G := by
  obtain ⟨d, hd, u, hu, hdu⟩ := Subgroup.mem_sup_of_normal_left.mp (hQ ▸ hzQ)
  have hUQ : U ≤ Q := hQ ▸ le_sup_right
  have huCent : ∀ w ∈ U, w * u = u * w := by
    intro w hw
    have hdw := Subgroup.mem_centralizer_iff.mp (hDU hd) w hw
    apply mul_left_cancel (a := d)
    calc
      d * (w * u) = w * (d * u) := by rw [← mul_assoc, ← hdw, mul_assoc]
      _ = (d * u) * w := by rw [hdu]; exact hz w (hUQ hw)
      _ = d * (u * w) := mul_assoc _ _ _
  have hu2 := hUsq u hu huCent
  have hduComm : Commute d u := (Subgroup.mem_centralizer_iff.mp (hDU hd) u hu).symm
  have hz2 : z ^ 2 = d ^ 2 := by rw [← hdu, hduComm.mul_pow, hu2, mul_one]
  have hQcent : Q ≤ Subgroup.centralizer ({z ^ 2} : Set G) := by
    intro q hq
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    exact ((show Commute q z from hz q hq).pow_right 2).eq.symm
  have hFcent : F ≤ Subgroup.centralizer ({z ^ 2} : Set G) := by
    intro f hf
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    rw [hz2]
    exact ((show Commute f d from Subgroup.mem_centralizer_iff.mp (hDF hd) f hf).pow_right 2).eq.symm
  rw [Subgroup.mem_center_iff]
  intro g
  have hg := (sup_le hFcent hQcent) (show g ∈ F ⊔ Q by rw [hgen]; trivial)
  exact (Subgroup.mem_centralizer_iff.mp hg (z ^ 2) (by simp)).symm

private theorem center_exponent_two_of_central_squares
    {G : Type*} [Group G] [Finite G] (P : Sylow 2 G)
    (hP : ∀ K : Subgroup P, K.Characteristic → K ≠ ⊥ →
      ¬ (K.map (P : Subgroup G).subtype).Normal)
    (hsq : ∀ z : Subgroup.center P,
      ((z : P) : G) ^ 2 ∈ Subgroup.center G) :
    ∀ z : Subgroup.center P, z ^ 2 = 1 := by
  let C := Subgroup.center P
  let φ : C →* G := (P : Subgroup G).subtype.comp C.subtype
  let K : Subgroup P := (frattini C).map C.subtype
  let _ : Fact (IsPGroup 2 C) := ⟨P.isPGroup'.to_subgroup C⟩
  have hKchar : K.Characteristic := inferInstance
  have hKcent : K.map (P : Subgroup G).subtype ≤ Subgroup.center G := by
    rw [show K.map (P : Subgroup G).subtype = (frattini C).map φ by
      simp only [K, φ, Subgroup.map_map]]
    apply Subgroup.map_le_iff_le_comap.mpr
    rw [frattini_eq_closure_commutator_union_powers (p := 2)]
    apply (Subgroup.closure_le _).2
    rintro x (hx | ⟨y, rfl⟩)
    · have hx1 : x = 1 := by
        have hxcomm : x ∈ _root_.commutator C := hx
        have hcomm : _root_.commutator C = ⊥ := commutator_eq_bot C
        rw [hcomm] at hxcomm
        exact hxcomm
      rw [hx1]
      exact (Subgroup.center G).one_mem
    · exact hsq y
  have hKn : (K.map (P : Subgroup G).subtype).Normal := by
    refine ⟨fun x hx g => ?_⟩
    rw [Subgroup.mem_center_iff.mp (hKcent hx) g, mul_inv_cancel_right]
    exact hx
  have hKb : K = ⊥ := by
    by_contra hne
    exact hP K hKchar hne hKn
  have hPhi : frattini C = ⊥ := by
    apply Subgroup.map_injective C.subtype_injective
    simpa only [Subgroup.map_bot] using hKb
  intro z
  exact show z ^ 2 ∈ (⊥ : Subgroup C) from
    hPhi ▸ pth_power_mem_frattini_of_isPGroup (p := 2) z



open AmalgamGraph

set_option maxHeartbeats 800000 in
public theorem distanceFour_central_two_elements_le_U
    {M : Type*} [Group M] [Finite M]
    (S : Subgroup M) (T : Sylow 2 M) (hTS : (T : Subgroup M) = S)
    (hP : ∀ K : Subgroup T, K.Characteristic → K ≠ ⊥ →
      ¬ (K.map (T : Subgroup M).subtype).Normal)
    (hSne : S ≠ ⊥)
    (hA : IsSL2Two ((M ⧸ pCore 2 M) ⧸ frattini (M ⧸ pCore 2 M)))
    (a a' c u v : Vertex S) (hb4 : criticalDistance S = 4)
    (cfg : DistanceFour.Configuration S a a' c u v) :
    ∀ z ∈ Subgroup.center (stabilizer S a),
      IsPGroup 2 (Subgroup.zpowers z) →
        z ∈ (DistanceFour.U S a c u).subgroupOf (stabilizer S a) := by
  classical
  let G := stabilizer S a
  let Q : Subgroup G := pCore 2 G
  let D := DistanceFour.D S a a' c u v
  let U := DistanceFour.U S a c u
  let F := DistanceFour.F S a' v
  let DI := D.subgroupOf G
  let UI := U.subgroupOf G
  let FI := F.subgroupOf G
  have hi := distanceFour_initialRelations S T hTS hP hSne hA a a' c u v hb4 cfg
  have hn := distanceFour_normality S T hTS hP hSne hA a a' c u v hb4 cfg
  have hprod := distanceFour_core_product S T hTS hP hSne hA a a' c u v hb4 cfg
  have hcenter := (distanceFour_center_and_index S T hTS hP hSne hA
    a a' c u v hb4 cfg).1
  obtain ⟨_, _, hinp⟩ := criticalPair_actionInputs S T hTS hP hSne hA a a' cfg.critical
    (by omega)
  have hDGa : D ≤ G := (show D ≤ vertexTwoCore S a by rw [hprod]; exact le_sup_left).trans
    (Subgroup.map_subtype_le _)
  have hUGa : U ≤ G := hi.U_le_core.trans (Subgroup.map_subtype_le _)
  have hFGa : F ≤ G := by
    change F ≤ stabilizer S a
    rw [← hi.F_generates_modulo_core]
    exact le_sup_left
  have hQfact : Q = DI ⊔ UI := by
    apply Subgroup.map_injective G.subtype_injective
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hDGa,
      Subgroup.map_subgroupOf_eq_of_le hUGa]
    exact hprod
  have hgen : FI ⊔ Q = ⊤ := by
    apply Subgroup.map_injective G.subtype_injective
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hFGa,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    exact hi.F_generates_modulo_core
  let _ : DI.Normal := hn.D_normal
  have hDU : DI ≤ Subgroup.centralizer UI := by
    intro d hd
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    exact Subtype.ext (Subgroup.mem_centralizer_iff.mp (hn.D_centralizes_U hd) w hw)
  have hDF : DI ≤ Subgroup.centralizer FI := by
    intro d hd
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    exact Subtype.ext (Subgroup.mem_centralizer_iff.mp (hn.D_centralizes_F hd) w hw)
  have hUsq : ∀ w ∈ UI, (∀ t ∈ UI, t * w = w * t) → w ^ 2 = 1 := by
    intro w hw hcomm
    let wU : U := ⟨w, hw⟩
    have hwCent : wU ∈ Subgroup.center U := by
      rw [Subgroup.mem_center_iff]
      intro t
      apply Subtype.ext
      exact congrArg (fun x : G => (x : FreeAmalgam S))
        (hcomm ⟨t, hUGa t.property⟩ t.property)
    rw [hcenter] at hwCent
    have hwOmega := hinp.left_Z_le_coreOmega hwCent
    apply Subtype.ext
    exact (mem_omegaOneCenterAmbient_iff _ (w : FreeAmalgam S)).mp hwOmega |>.2.1
  let P : Sylow 2 G := Classical.arbitrary _
  have hQP : Q ≤ (P : Subgroup G) := (pCore_isPGroup (p := 2) (G := G)).le_sylow_of_normal P
  let CP : Subgroup G := (Subgroup.center P).map (P : Subgroup G).subtype
  have hCPtwo : IsPGroup 2 CP :=
    (P.isPGroup'.to_subgroup (Subgroup.center P)).map (P : Subgroup G).subtype
  have hCPcent : CP ≤ vertexCentralizerLocal S a := by
    rintro z ⟨zP, hzP, rfl⟩
    apply (mem_vertexCentralizerLocal_iff S a _).mpr
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    have hyQa := (mem_omegaOneCenterAmbient_iff _ y).mp
      (hinp.left_Z_le_coreOmega hy) |>.1
    obtain ⟨yG, hyQ, rfl⟩ := hyQa
    have hh := Subgroup.mem_center_iff.mp hzP ⟨yG, hQP hyQ⟩
    exact congrArg (fun x : P => ((x : G) : FreeAmalgam S)) hh
  have hCPQ : CP ≤ Q := hCPtwo.le_pCore_of_le_oddIndexOverCore
    hinp.critical.centralizer_odd.core_le_centralizer
    hinp.critical.centralizer_odd.centralizer_mod_core_odd hCPcent
  have hsq : ∀ z : Subgroup.center P,
      ((z : P) : G) ^ 2 ∈ Subgroup.center G := by
    intro z
    apply square_central_of_core_factorization Q DI UI FI hQfact hgen hDU hDF hUsq
      ((z : P) : G)
    · exact hCPQ ⟨(z : P), z.property, rfl⟩
    · intro q hq
      exact congrArg Subtype.val (Subgroup.mem_center_iff.mp z.property ⟨q, hQP hq⟩)
  have hexp := center_exponent_two_of_central_squares P
    (local_sylow_characteristic_obstruction S T hTS hP a cfg.critical.1 P) hsq
  intro z hz hzTwo
  have hcycCent : Subgroup.zpowers z ≤ Subgroup.center G := Subgroup.zpowers_le.mpr hz
  let _ : (Subgroup.zpowers z).Normal := ⟨fun x hx g => by
    rw [Subgroup.mem_center_iff.mp (hcycCent hx) g, mul_inv_cancel_right]
    exact hx⟩
  have hzP : z ∈ (P : Subgroup G) := hzTwo.le_sylow_of_normal P (Subgroup.mem_zpowers z)
  have hzCP : (⟨z, hzP⟩ : (P : Subgroup G)) ∈ Subgroup.center P := by
    apply Subgroup.mem_center_iff.mpr
    intro p
    exact Subtype.ext (Subgroup.mem_center_iff.mp hz p)
  have hz2 : z ^ 2 = 1 := congrArg (fun x : Subgroup.center P => ((x : P) : G))
    (hexp ⟨⟨z, hzP⟩, hzCP⟩)
  have hzO : (z : FreeAmalgam S) ∈ omegaOneCenterAmbient (sylowAt S a P) := by
    apply (mem_omegaOneCenterAmbient_iff _ _).mpr
    refine ⟨⟨z, hzP, rfl⟩, congrArg Subtype.val hz2, ?_⟩
    rintro q ⟨qG, hq, rfl⟩
    exact congrArg Subtype.val (Subgroup.mem_center_iff.mp hz qG)
  have hzZa : (z : FreeAmalgam S) ∈ vertexZ S a :=
    (le_sSup ⟨P, rfl⟩ : sylowOmegaAt S a P ≤ vertexZ S a) hzO
  exact (show vertexZ S a ≤ U from le_sup_left.trans le_sup_left) hzZa

end Stellmacher.PushingUp
