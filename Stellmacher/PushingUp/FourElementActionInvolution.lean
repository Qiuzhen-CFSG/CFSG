module

public import Stellmacher.PushingUp.FaithfulFourNaturalAction
public import Stellmacher.PushingUp.NaturalQuotientInvolution

/-!
# Four-element quotient actions and an outside involution

Let Z ≤ U be central in U and have exponent dividing two. An ambient
subgroup L acts by conjugation on the literal elementary abelian quotient
U/(Z.subgroupOf U), of order four. If two two-subgroups of L generate modulo
the action kernel, and the action image is not a two-group, an involution of U
outside Z forces U itself to be elementary abelian.

The image in the automorphism group acts faithfully by evaluation. Mapping the
generation equation to this image kills the kernel, so faithful four-element
recognition identifies its action with the natural SL₂(2) action. The imported
natural-quotient involution theorem then transports the outside involution
through all nonidentity quotient cosets. We retain the given quotient normality
and L-action instances throughout. The quotient cardinality makes its image
finite; neither the ambient group nor L needs a finiteness assumption.

Source: the final p = 2 contradiction in Stellmacher, *Pushing up*,
Arch. Math. 46 (1986), (3.3)(f), journal p.15. This generic bridge requires the
graph application to establish conjugation compatibility, generation modulo
the actual action kernel, and the non-two-group image separately.
-/

namespace Stellmacher.PushingUp
universe u

/-- A non-two-group image on the actual four-element central quotient,
generated by two two-subgroups, transports an outside involution to all cosets. -/
public theorem elementaryAbelian_of_four_element_action_involution
    {H : Type u} [Group H]
    (L U Z : Subgroup H) (hZU : Z ≤ U)
    (hZcentral : ∀ z : H, z ∈ Z → ∀ u : H, u ∈ U → z * u = u * z)
    (hZsq : ∀ z : H, z ∈ Z → z ^ 2 = 1)
    (hZnormal : (Z.subgroupOf U).Normal)
    [MulDistribMulAction L (U ⧸ Z.subgroupOf U)]
    [IsElementaryAbelian 2 (U ⧸ Z.subgroupOf U)]
    (hcard : Nat.card (U ⧸ Z.subgroupOf U) = 4)
    (P Q : Subgroup L) (hP : IsPGroup 2 P) (hQ : IsPGroup 2 Q)
    (hgen : (P ⊔ Q) ⊔ (MulDistribMulAction.toMulAut L (U ⧸ Z.subgroupOf U)).ker = ⊤)
    (hnp : ¬ IsPGroup 2 (MulDistribMulAction.toMulAut L (U ⧸ Z.subgroupOf U)).range)
    (hconjU : ∀ l : L, ∀ w : U,
      (l : H) * (w : H) * (l : H)⁻¹ ∈ U)
    (hact : ∀ (l : L) (w : U),
      l • (QuotientGroup.mk' (Z.subgroupOf U)) w =
        (QuotientGroup.mk' (Z.subgroupOf U))
          ⟨(l : H) * (w : H) * (l : H)⁻¹, hconjU l w⟩)
    (x : H) (hxU : x ∈ U) (hxZ : x ∉ Z) (hxsq : x ^ 2 = 1) :
    IsElementaryAbelian 2 U := by
  let W := U ⧸ Z.subgroupOf U
  let _ : Finite W := Nat.finite_of_card_ne_zero (by simp [W, hcard])
  let f := MulDistribMulAction.toMulAut L W
  let A := f.range
  have hfaithful : fixingSubgroup A (Set.univ : Set W) = ⊥ := by
    apply le_antisymm
    · intro a ha
      apply Subtype.ext
      apply MulEquiv.ext
      intro w
      exact (mem_fixingSubgroup_iff (M := A) (s := (Set.univ : Set W))).mp ha w
        (Set.mem_univ _)
    · exact bot_le
  let PA := P.map f.rangeRestrict
  let QA := Q.map f.rangeRestrict
  have hPA : IsPGroup 2 PA := hP.map f.rangeRestrict
  have hQA : IsPGroup 2 QA := hQ.map f.rangeRestrict
  have hgenA : PA ⊔ QA = ⊤ := by
    have hmap := congrArg (Subgroup.map f.rangeRestrict) hgen
    rw [Subgroup.map_sup, Subgroup.map_sup] at hmap
    have hker : f.ker.map f.rangeRestrict = ⊥ := by
      apply (Subgroup.map_eq_bot_iff _).mpr
      rw [MonoidHom.ker_rangeRestrict]
    rw [hker, sup_bot_eq, ← MonoidHom.range_eq_map,
      MonoidHom.range_eq_top.mpr f.rangeRestrict_surjective] at hmap
    exact hmap
  obtain ⟨eA, hNat⟩ := naturalSL2Two_of_faithful_card_four_two_generated
    hfaithful hcard PA QA hPA hQA hgenA hnp
  exact elementaryAbelian_of_natural_quotient_involution
    L U Z hZU hZcentral hZsq hZnormal f.rangeRestrict f.rangeRestrict_surjective
    eA hNat hconjU hact x hxU hxZ hxsq

end Stellmacher.PushingUp
