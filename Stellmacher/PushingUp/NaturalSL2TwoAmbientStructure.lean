module

public import Stellmacher.PushingUp.SL2TwoNaturalSylow

/-!
# Ambient structure from the natural `SL₂(2)` module

Suppose an ambient subgroup `L` acts by conjugation on a subgroup `W`, and
this action factors surjectively through a group `A` acting naturally on `W`
as `SL₂(2)` on its two-dimensional module.  Then `W` is elementary
abelian of order a power of two, is an irreducible nonzero `L`-section, and
is generated by its commutators with `L`.

The proof uses the transitivity of `SL₂(2)` on the three nonzero vectors
of its natural module to rule out proper nonzero invariant subgroups.  The
same calculation makes the action commutator the whole module.  Surjectivity
of the actor map and its compatibility with ambient conjugation then turn
these action statements into literal subgroup irreducibility and the
containment `W ≤ [W,L]`.

This is the graph-free natural-module tail of Stellmacher, *Pushing up*,
Arch. Math. 46 (1986), (3.2)(d) and its final commutator sentence,
specialized to `p = 2` and `n = 1`.
-/

open scoped commutatorElement

namespace Stellmacher.PushingUp

universe u v

private theorem sl2Two_mulVec_transitive_nonzero
    (x y : Fin 2 → ZMod 2) (hx : x ≠ 0) (hy : y ≠ 0) :
    ∃ A : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2),
      Matrix.mulVec A.1 x = y := by
  decide +revert +kernel

private theorem sl2Two_exists_mulVec_ne
    (x : Fin 2 → ZMod 2) (hx : x ≠ 0) :
    ∃ A : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2),
      Matrix.mulVec A.1 x ≠ x := by
  decide +revert +kernel

private theorem invariantSubgroup_eq_bot_or_top_of_naturalSL2TwoActionAlong
    {G : Type u} {W : Type v}
    [Group G] [Group W] [MulDistribMulAction G W]
    (eG : G ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))
    (hNat : IsNaturalSL2TwoActionAlong W eG)
    (U : Subgroup W) (hU : IsInvariant G W U) :
    U = ⊥ ∨ U = ⊤ := by
  by_cases hUbot : U = ⊥
  · exact Or.inl hUbot
  · right
    obtain ⟨u, hu_ne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hUbot
    obtain ⟨eW, heW⟩ := hNat
    apply top_unique
    intro w _hw
    by_cases hw_one : w = 1
    · simp [hw_one]
    · have hu_coord_ne : eW (Additive.ofMul (u : W)) ≠ 0 := by
        simpa using hu_ne
      have hw_coord_ne : eW (Additive.ofMul w) ≠ 0 := by
        simpa using hw_one
      obtain ⟨A, hA⟩ := sl2Two_mulVec_transitive_nonzero
        (eW (Additive.ofMul (u : W))) (eW (Additive.ofMul w))
        hu_coord_ne hw_coord_ne
      let g : G := eG.symm A
      have hgu_mem : g • (u : W) ∈ U :=
        (hU.invariant g (u : W)).mp u.property
      have hgu : g • (u : W) = w := by
        apply Additive.ofMul.injective
        apply eW.injective
        calc
          eW (Additive.ofMul (g • (u : W))) =
              Matrix.mulVec (eG g).1 (eW (Additive.ofMul (u : W))) :=
            heW g (u : W)
          _ = eW (Additive.ofMul w) := by simpa [g] using hA
      rwa [hgu] at hgu_mem

private theorem commutatorAction_eq_top_of_naturalSL2TwoActionAlong
    {G : Type u} {W : Type v}
    [Group G] [Group W] [MulDistribMulAction G W]
    (eG : G ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))
    (hNat : IsNaturalSL2TwoActionAlong W eG) :
    commutatorAction G W = ⊤ := by
  have hcases := invariantSubgroup_eq_bot_or_top_of_naturalSL2TwoActionAlong
    eG hNat (commutatorAction G W)
      (commutatorAction_isInvariant (A := G) (G := W))
  rcases hcases with hbot | htop
  · exfalso
    have htriv : ActsTrivially (A := G) (G := W) :=
      actsTrivially_of_commutatorAction_eq_bot hbot
    obtain ⟨eW, heW⟩ := hNat
    let x : Fin 2 → ZMod 2 := fun i => if i = 0 then 1 else 0
    have hx : x ≠ 0 := by
      intro hx0
      have hzero := congrFun hx0 0
      simp [x] at hzero
    obtain ⟨A, hA⟩ := sl2Two_exists_mulVec_ne x hx
    let g : G := eG.symm A
    let w : W := Additive.toMul (eW.symm x)
    have hcoord : eW (Additive.ofMul w) = x := by simp [w]
    have hgw_ne : g • w ≠ w := by
      intro hgw
      apply hA
      calc
        Matrix.mulVec A.1 x =
            Matrix.mulVec (eG g).1 (eW (Additive.ofMul w)) := by
          simp [g, hcoord]
        _ = eW (Additive.ofMul (g • w)) := (heW g w).symm
        _ = eW (Additive.ofMul w) := by rw [hgw]
        _ = x := hcoord
    exact hgw_ne (htriv g w)
  · exact htop

private theorem elementaryAbelian_of_naturalSL2TwoActionAlong
    {G : Type u} {W : Type v}
    [Group G] [Group W] [MulDistribMulAction G W]
    (eG : G ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))
    (hNat : IsNaturalSL2TwoActionAlong W eG) :
    IsElementaryAbelian 2 W := by
  obtain ⟨eW, _heW⟩ := hNat
  refine
    { toIsMulCommutative := ⟨⟨?_⟩⟩
      exponent_dvd_p := ?_ }
  · intro x y
    apply Additive.ofMul.injective
    apply eW.injective
    change eW (Additive.ofMul x + Additive.ofMul y) =
      eW (Additive.ofMul y + Additive.ofMul x)
    simp [add_comm]
  · rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
    intro w
    rw [pow_two]
    apply Additive.ofMul.injective
    apply eW.injective
    change eW (Additive.ofMul w + Additive.ofMul w) = eW 0
    rw [map_add, map_zero]
    ext i
    exact (by decide : ∀ z : ZMod 2, z + z = 0) _

/-- A natural `SL₂(2)` action realized as a surjective quotient of ambient
conjugation makes the underlying subgroup an elementary abelian irreducible
section and gives its full ambient action commutator. -/
public theorem naturalSL2Two_ambient_structure_of_surjective_actor
    {H : Type u} {A : Type v} [Group H] [Group A]
    (L W : Subgroup H) [MulDistribMulAction A W]
    (f : L →* A) (hf : Function.Surjective f)
    (eA : A ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))
    (hNat : IsNaturalSL2TwoActionAlong W eA)
    (hact : ∀ (l : L) (w : W),
      (((f l) • w : W) : H) =
        (l : H) * (w : H) * (l : H)⁻¹) :
    IsElementaryAbelian 2 W ∧
      IsIrreducibleSection L ⊥ W ∧ W ≤ ⁅W, L⁆ := by
  have hElem : IsElementaryAbelian 2 W :=
    elementaryAbelian_of_naturalSL2TwoActionAlong eA hNat
  have hIrred : IsIrreducibleSection L ⊥ W := by
    refine ⟨bot_le, ?_, ?_⟩
    · obtain ⟨eW, _heW⟩ := hNat
      have hnontrivialAdd : Nontrivial (Additive W) := eW.toEquiv.nontrivial
      have hnontrivialW : Nontrivial W := hnontrivialAdd
      exact ((Subgroup.nontrivial_iff_ne_bot W).mp hnontrivialW).symm
    · intro B _hbotB hBW hBinv
      let BW : Subgroup W := B.subgroupOf W
      have hBWinv : IsInvariant A W BW := by
        constructor
        intro a w
        obtain ⟨l, rfl⟩ := hf a
        change (w : H) ∈ B ↔ (((f l) • w : W) : H) ∈ B
        rw [hact]
        constructor
        · exact hBinv l (w : H)
        · intro hlw
          have hback := hBinv l⁻¹ ((l : H) * (w : H) * (l : H)⁻¹) hlw
          simpa [mul_assoc] using hback
      rcases invariantSubgroup_eq_bot_or_top_of_naturalSL2TwoActionAlong
          eA hNat BW hBWinv with hbot | htop
      · left
        have hmap := congrArg (Subgroup.map W.subtype) hbot
        rw [Subgroup.map_bot, Subgroup.map_subgroupOf_eq_of_le hBW] at hmap
        exact hmap
      · right
        have hmap := congrArg (Subgroup.map W.subtype) htop
        rw [Subgroup.map_subgroupOf_eq_of_le hBW] at hmap
        simpa [← MonoidHom.range_eq_map, Subgroup.range_subtype] using hmap
  have hcommTop : commutatorAction A W = ⊤ :=
    commutatorAction_eq_top_of_naturalSL2TwoActionAlong eA hNat
  have hcommMapLe : (commutatorAction A W).map W.subtype ≤ ⁅W, L⁆ := by
    rw [commutatorAction_eq_closure, MonoidHom.map_closure]
    apply (Subgroup.closure_le (K := ⁅W, L⁆)).mpr
    rintro z ⟨x, ⟨a, w, rfl⟩, rfl⟩
    obtain ⟨l, rfl⟩ := hf a
    have hmem : ⁅(w : H)⁻¹, (l : H)⁆ ∈ ⁅W, L⁆ :=
      Subgroup.commutator_mem_commutator (W.inv_mem w.property) l.property
    simpa [commutatorElement_def, hact, mul_assoc] using hmem
  have hWle : W ≤ ⁅W, L⁆ := by
    have hmapTop : (⊤ : Subgroup W).map W.subtype = W := by
      simp [← MonoidHom.range_eq_map, Subgroup.range_subtype]
    rw [hcommTop, hmapTop] at hcommMapLe
    exact hcommMapLe
  exact ⟨hElem, hIrred, hWle⟩

end Stellmacher.PushingUp
