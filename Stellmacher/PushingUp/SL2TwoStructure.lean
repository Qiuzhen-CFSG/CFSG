module
public import Stellmacher.PushingUp.CriticalDistanceZero
public import Stellmacher.PushingUp.CriticalDistanceTwoStructure
public import Stellmacher.PushingUp.CriticalDistanceBound
public import Stellmacher.PushingUp.CriticalDistanceFourImpossible

/-!
# The SL₂(2) pushing-up structural disjunction

For a finite group satisfying standing (P) and the exact nested-Frattini
condition (A), either its Sylow two-subgroup is elementary abelian or the
residual commutator [O₂(M),O²(M)] is elementary, irreducible under a suitable
subgroup, and generated by its commutators with that subgroup. This is the
structural input needed by the local commutator bound used in Stellmacher (2.4).

The trivial Sylow case is immediate. Otherwise the free-amalgam critical
distance is zero, two or four. The zero and two case theorems give the two
alternatives, and the proved distance-four contradiction excludes the last
case. No finiteness of the free amalgam or its vertex set is assumed.

Source: Stellmacher, *Pushing up*, Arch. Math. 46 (1986), Theorem 1 and
(2.4), (3.1)--(3.3), specialized to p = 2 and n = 1.
-/

namespace Stellmacher.PushingUp
universe u

private theorem elementaryAbelian_bot {G : Type*} [Group G] :
    IsElementaryAbelian 2 (⊥ : Subgroup G) := by
  refine { toIsMulCommutative := ⟨⟨fun _ _ => Subsingleton.elim _ _⟩⟩
           exponent_dvd_p := ?_ }
  rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
  exact fun _ => Subsingleton.elim _ _

/-- The structural disjunction assembled from the proved critical-distance cases. -/
public theorem sl2Two_structure
    {M : Type u} [Group M] [Finite M] (S : Sylow 2 M)
    (hP : ∀ K : Subgroup S, K.Characteristic → K ≠ ⊥ →
      ¬ (K.map (S : Subgroup M).subtype).Normal)
    (hA : IsSL2Two
      ((M ⧸ pCore 2 M) ⧸ frattini (M ⧸ pCore 2 M)))
    :
    let V := ⁅pCore 2 M, twoResidualAmbient (⊤ : Subgroup M)⁆
    IsElementaryAbelian 2 (S : Subgroup M) ∨
      ∃ L : Subgroup M,
        IsElementaryAbelian 2 V ∧
          IsIrreducibleSection L ⊥ V ∧ V ≤ ⁅V, L⁆ := by
  by_cases hS : (S : Subgroup M) = ⊥
  · left
    rw [hS]
    exact elementaryAbelian_bot
  · rcases criticalDistance_zero_two_or_four (S : Subgroup M) S rfl hP hS hA with hzero | htwo | hfourEq
    · exact Or.inl (criticalDistance_zero_isElementaryAbelian
        (S : Subgroup M) S rfl hP hS hA hzero)
    · exact Or.inr (criticalDistance_two_structure
        (S : Subgroup M) S rfl hP hS hA htwo)
    · exact False.elim (criticalDistance_four_impossible (S : Subgroup M) S rfl hP hS hA hfourEq)

end Stellmacher.PushingUp
