module

public import Stellmacher.PushingUp.SL2TwoNaturalSylow
public import Theory.Representation.FourGroupMatrixCoordinates

/-!
# Recognizing the faithful natural four-element action

A finite group acting faithfully on an elementary abelian group of order four
embeds into SL₂(2), and the embedding records the actual action in additive
coordinates. If the actor is generated by two two-subgroups and is not itself
a two-group, its order is six: the orders one and two are excluded directly,
and order three would make both generating subgroups trivial. Thus the same
coordinate embedding identifies the action with the natural SL₂(2) action.
The companion theorem handles an actor already known abstractly to be SL₂(2).

The shared lower-layer construction turns the supplied elementary abelian action into a linear
representation, chooses a two-element basis, and uses the trivial determinant
over F₂ to land in SL₂(2). Faithfulness makes the representation injective;
the cardinality calculation makes it bijective. Both public conclusions keep
the supplied action instance and use one group equivalence throughout.

This is the order-four natural-module recognition used in Stellmacher,
*Pushing up*, Arch. Math. 46 (1986), (3.3)(6), journal p.15, specialized to
p = 2 and n = 1. The shared coordinate construction also supplies the natural
action step of the module lemma (2.1). The graph application must separately
establish its faithful quotient action, generation, and non-two-group input.
-/

open scoped IsMulCommutative
namespace Stellmacher.PushingUp
universe u v

private theorem natural_of_embedding_card_six
    {G : Type u} {W : Type v} [Group G] [Finite G] [Group W]
    [MulDistribMulAction G W]
    (φ : G →* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))
    (hφ : Function.Injective φ) (hcard : Nat.card G = 6)
    (eW : Additive W ≃+ (Fin 2 → ZMod 2))
    (hW : ∀ (g : G) (w : W), eW (Additive.ofMul (g • w)) =
      Matrix.mulVec (φ g).1 (eW (Additive.ofMul w))) :
    ∃ eG : G ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2),
      IsNaturalSL2TwoActionAlong W eG := by
  have hcSL : Nat.card (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) = 6 :=
    SectionOne.RankOneThreeGroupAssembly.isSL2Two_card ⟨MulEquiv.refl _⟩
  have hbij : Function.Bijective φ :=
    (Nat.bijective_iff_injective_and_card φ).mpr ⟨hφ, hcard.trans hcSL.symm⟩
  exact ⟨MulEquiv.ofBijective φ hbij, eW, hW⟩

public theorem naturalSL2TwoActionAlong_of_faithful_card_four
    {G : Type u} {W : Type v}
    [Group G] [Finite G] [Group W] [Finite W]
    [IsElementaryAbelian 2 W] [MulDistribMulAction G W]
    (hG : IsSL2Two G)
    (hfaithful : fixingSubgroup G (Set.univ : Set W) = ⊥)
    (hWcard : Nat.card W = 4) :
    ∃ eG : G ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2),
      IsNaturalSL2TwoActionAlong W eG := by
  obtain ⟨φ, hφ, eW, heW⟩ :=
    FourGroupMatrixCoordinates.faithful_card_four_embedding hfaithful hWcard
  exact natural_of_embedding_card_six φ hφ
    (SectionOne.RankOneThreeGroupAssembly.isSL2Two_card hG) eW heW

public theorem naturalSL2Two_of_faithful_card_four_two_generated
    {A : Type u} {W : Type v}
    [Group A] [Finite A] [Group W] [Finite W]
    [IsElementaryAbelian 2 W] [MulDistribMulAction A W]
    (hfaithful : fixingSubgroup A (Set.univ : Set W) = ⊥)
    (hWcard : Nat.card W = 4)
    (P Q : Subgroup A) (hP : IsPGroup 2 P) (hQ : IsPGroup 2 Q)
    (hgen : P ⊔ Q = ⊤) (hnp : ¬ IsPGroup 2 A) :
    ∃ eA : A ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2),
      IsNaturalSL2TwoActionAlong W eA := by
  obtain ⟨φ, hφ, eW, heW⟩ :=
    FourGroupMatrixCoordinates.faithful_card_four_embedding hfaithful hWcard
  have hcSL : Nat.card (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) = 6 :=
    SectionOne.RankOneThreeGroupAssembly.isSL2Two_card ⟨MulEquiv.refl _⟩
  have hdiv : Nat.card A ∣ 6 := by
    rw [← hcSL]
    exact Subgroup.card_dvd_of_injective φ hφ
  have hc : Nat.card A = 1 ∨ Nat.card A = 2 ∨ Nat.card A = 3 ∨ Nat.card A = 6 := by
    have hle := Nat.le_of_dvd (by decide : 0 < 6) hdiv
    interval_cases h : Nat.card A <;> norm_num at *
  have hcard : Nat.card A = 6 := by
    rcases hc with h1 | h2 | h3 | h6
    · exact False.elim (hnp (IsPGroup.of_card (n := 0) (by simpa using h1)))
    · exact False.elim (hnp (IsPGroup.of_card (n := 1) (by simpa using h2)))
    · have hbot (R : Subgroup A) (hR : IsPGroup 2 R) : R = ⊥ := by
        rcases hR.card_eq_or_dvd with hR1 | hRd
        · exact Subgroup.card_eq_one.mp hR1
        · have hd := hRd.trans (Subgroup.card_subgroup_dvd_card R)
          rw [h3] at hd
          norm_num at hd
      have htop : (⊤ : Subgroup A) = ⊥ := by
        rw [← hgen, hbot P hP, hbot Q hQ, sup_idem]
      have h1 : Nat.card A = 1 := by
        rw [← Nat.card_congr (Subgroup.topEquiv : (⊤ : Subgroup A) ≃* A).toEquiv]
        exact Subgroup.card_eq_one.mpr htop
      omega
    · exact h6
  exact natural_of_embedding_card_six φ hφ hcard eW heW

end Stellmacher.PushingUp
