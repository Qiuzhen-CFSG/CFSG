module

public import Stellmacher.PushingUp.CriticalPairCoreIntersectionData

/-!
# Generating a vertex center by intersections with opposite cores

Suppose `(a,b)` and `(a,c)` are positive-distance critical pairs and
`Z_b Z_c Q_a = G_a`. Then `Z_a` is generated by `Z_a ∩ Q_b` and
`Z_a ∩ Q_c`. This is the core-intersection generation needed when combining
the normal-subgroup covers in the distance-four argument.

Source (2.2) makes `Z_b Q_a` and `Z_c Q_a` Sylow subgroups of `G_a`.
They generate `G_a`, and the quadratic source calculation gives generation
of `Z_a` by their omega centers. The imported exact core-intersection theorem
identifies each omega center with the intersection of `Z_a` and the opposite
two-core. Its proof uses endpoint containment and the odd-index centralizer
result (1.4)(a). Substitution gives the claimed generation.

Source: Stellmacher, *Pushing up*, Arch. Math. 46 (1986), (1.4), (2.2),
and the core-cover calculation in (3.3)(1). Only the finite vertex
stabilizers are used; the graph and free amalgam may be infinite.
-/

namespace Stellmacher.PushingUp

open scoped commutatorElement
open AmalgamGraph

universe u

variable {M : Type u} [Group M]

/-- Two opposite critical centers generating modulo the local core give
generation of the local center by its intersections with the opposite cores. -/
public theorem criticalPair_coreIntersections_generate [Finite M]
    (S : Subgroup M) (T : Sylow 2 M) (hTS : (T : Subgroup M) = S)
    (hP : ∀ K : Subgroup T, K.Characteristic → K ≠ ⊥ →
      ¬ (K.map (T : Subgroup M).subtype).Normal)
    (hSne : S ≠ ⊥)
    (hA : IsSL2Two
      ((M ⧸ pCore 2 M) ⧸ frattini (M ⧸ pCore 2 M)))
    (a b c : Vertex S) (hab : IsCriticalPair S a b)
    (hac : IsCriticalPair S a c) (hb : 0 < criticalDistance S)
    (hgen : (vertexZ S b ⊔ vertexZ S c) ⊔ vertexTwoCore S a = stabilizer S a) :
    vertexZ S a = (vertexZ S a ⊓ vertexTwoCore S b) ⊔
      (vertexZ S a ⊓ vertexTwoCore S c) := by
  obtain ⟨_, _, h22b⟩ := criticalPair_sl2Two S T hTS hP hSne hA a b hab hb
  obtain ⟨_, _, h22c⟩ := criticalPair_sl2Two S T hTS hP hSne hA a c hac hb
  let P := vertexZ S b ⊔ vertexTwoCore S a
  let Q := vertexZ S c ⊔ vertexTwoCore S a
  have hPQ : P ⊔ Q = stabilizer S a := by
    change (vertexZ S b ⊔ vertexTwoCore S a) ⊔
      (vertexZ S c ⊔ vertexTwoCore S a) = _
    rw [sup_sup_sup_comm, sup_idem]
    exact hgen
  have hcomm : ⁅vertexZ S a, P⁆ ≤ omegaOneCenterAmbient P :=
    criticalPair_sourceSylow_quadratic_ambient S T hTS hP hSne hA a b hab hb
  have hZeq := vertexZ_eq_sup_omega_of_generating_sylows S a P Q
    h22b.sourceSylow h22c.sourceSylow hPQ hcomm
  dsimp only [P, Q] at hZeq
  rwa [(criticalPair_coreIntersection_data S T hTS hP hSne hA a b hab hb).1,
    (criticalPair_coreIntersection_data S T hTS hP hSne hA a c hac hb).1] at hZeq

end Stellmacher.PushingUp
