module
public import Stellmacher.SectionsOneToFourDefs
/-!
# Residual centralization from a two-group supplement

Let the finite ambient subgroup P normalize N. If P is generated by a
subgroup A centralizing N and a two-subgroup T, then the two-residual of P
centralizes N. The original theorem, for N normal inside P, is retained
as an exact wrapper; the stronger theorem permits N outside P.

The ambient centralizer restricted to P, C_P(N), is normal in P: it is
the pullback of the normal centralizer in the normalizer of N. In its quotient the image
of A is trivial, so the image of T is the whole quotient and that quotient
is a two-group. The defining intersection for the two-residual is therefore
contained in this centralizer. Mapping back gives the ambient commutator
assertion. No inclusion N≤P is required by the stronger result; this
matters for the source subgroup D*, which may only be normalized by L.

This is the algebraic normal-commutator step in Stellmacher (8.4)(7),
Journal of Algebra 190 (1997), printed p.39: there N=[D*,Q] and A=L0.
-/

namespace Stellmacher
public theorem twoResidual_centralizes_of_normalizing_two_supplement
    {G : Type*} [Group G] [Finite G]
    (N A T P : Subgroup G) (hPN : P ≤ Subgroup.normalizer (N : Set G))
    (hgen : A ⊔ T = P) (hT : IsPGroup 2 T)
    (hAN : ⁅A,N⁆ = ⊥) : ⁅twoResidualAmbient P,N⁆ = ⊥ := by
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let C := (Subgroup.centralizer (N : Set G)).subgroupOf P
  let _ : C.Normal :=
    (Subgroup.normal_subgroupOf_centralizer_normalizer (N : Set G)).comap
      (Subgroup.inclusion hPN)
  let f := QuotientGroup.mk' C
  have hAP : A ≤ P := le_sup_left.trans_eq hgen
  have hTP : T ≤ P := le_sup_right.trans_eq hgen
  have hAC : A.subgroupOf P ≤ C := fun a ha =>
    Subgroup.commutator_eq_bot_iff_le_centralizer.mp hAN ha
  have hAT : A.subgroupOf P ⊔ T.subgroupOf P = ⊤ := by
    apply Subgroup.map_injective P.subtype_injective
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hAP,
      Subgroup.map_subgroupOf_eq_of_le hTP, hgen,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hAmap : (A.subgroupOf P).map f = ⊥ :=
    (Subgroup.map_eq_bot_iff _).mpr (by simpa only [f, QuotientGroup.ker_mk'] using hAC)
  have hTmap : (T.subgroupOf P).map f = ⊤ := by
    have hh := congrArg (Subgroup.map f) hAT
    rw [Subgroup.map_sup, hAmap, bot_sup_eq,
      Subgroup.map_top_of_surjective f (QuotientGroup.mk'_surjective C)] at hh
    exact hh
  have hquotp : IsPGroup 2 (P ⧸ C) := by
    have hp : IsPGroup 2 ((T.subgroupOf P).map f) := hT.comap_subtype.map f
    rw [hTmap] at hp
    exact hp.of_equiv Subgroup.topEquiv
  have hres : twoResidualSubgroup P ≤ C := by
    apply sInf_le
    refine ⟨inferInstance, ?_⟩
    obtain ⟨n,hn⟩ := hquotp.exists_card_eq
    exact ⟨n, by simpa only [Subgroup.index_eq_card] using hn⟩
  apply Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
  rintro r ⟨rP,hr,rfl⟩
  exact hres hr

public theorem twoResidual_centralizes_of_normal_two_supplement
    {G : Type*} [Group G] [Finite G]
    (N A T P : Subgroup G) (hNP : N ≤ P) (hN : (N.subgroupOf P).Normal)
    (hgen : A ⊔ T = P) (hT : IsPGroup 2 T)
    (hAN : ⁅A,N⁆ = ⊥) : ⁅twoResidualAmbient P,N⁆ = ⊥ := by
  exact twoResidual_centralizes_of_normalizing_two_supplement N A T P
    ((Subgroup.normal_subgroupOf_iff_le_normalizer hNP).mp hN) hgen hT hAN

end Stellmacher
