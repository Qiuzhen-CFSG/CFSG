module

public import Stellmacher.LaterDefs
public import Stellmacher.SectionFiveToSeven.HypothesisTwoToSectionSeven
public import Stellmacher.SectionFiveToSeven.Result6_3
public import Stellmacher.OmegaOneCenterMap

/-!
# Ambient-backed local data for Stellmacher (8.2)

Hypothesis Two is imposed on the ambient group H, whereas the Section Seven
graph lives in the group generated by P1 and P2. The supplemental local context
retains the genuine Section Seven hypotheses and precisely the two consequences
of (6.3) used by the noncentral (8.2) proof: ordinary dihedral core quotients and
native SL2(2) Frattini quotients, conditional on the nontrivial omega-center
action. It assumes neither a stabilizer classification nor critical distance one.

The generated context keeps Hypothesis Two on H and accepts the separately
proved restricted Section Seven hypotheses. Its local adapter maps the
omega-center commutator through the injective inclusion of the join and
transports both quotient conclusions along the restricted-subgroup isomorphisms.
The old same-ambient context has a definitionally graph-preserving adapter;
no old declaration changes, and no Sylow subgroup of the join is selected.

Source: Stellmacher, Hypothesis Two, (6.3), the opening of Section Seven,
and (8.2), refs/latex/stellmacher-n-group.tex.
-/

namespace Stellmacher.Later

open SectionsFiveToSeven

universe u

public structure SixThreeLocalData
    {G : Type u} [Group G] [Finite G] (S P1 P2 : Subgroup G) : Prop where
  dihedralCore : ⁅P2, omegaOneCenter S⁆ ≠ ⊥ →
    (∃ n : ℕ, Nonempty ((P1 ⧸ pCore 2 P1) ≃* DihedralGroup (3 ^ n))) ∧
    (∃ n : ℕ, Nonempty ((P2 ⧸ pCore 2 P2) ≃* DihedralGroup (3 ^ n)))
  nativeSL2 : ⁅P2, omegaOneCenter S⁆ ≠ ⊥ →
    IsSL2Two ((P1 ⧸ pCore 2 P1) ⧸ frattini (P1 ⧸ pCore 2 P1)) ∧
    IsSL2Two ((P2 ⧸ pCore 2 P2) ⧸ frattini (P2 ⧸ pCore 2 P2))

public structure SectionEightLocalContext
    (G : Type u) [Group G] [Finite G] (S P1 P2 : Subgroup G) where
  sectionSeven : SectionSevenHypotheses G S P1 P2
  sixThree : SixThreeLocalData S P1 P2
  Γ : CosetGraphContext G S P1 P2
  criticalPath : CriticalPath Γ
  commutator_ne : ⁅Γ.z criticalPath.a, Γ.z criticalPath.a'⁆ ≠ ⊥

public theorem SixThreeLocalData.ofHypothesisTwo
    {H : Type u} [Group H] [Finite H]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    (h : HypothesisTwo H S0 S P1 P2) : SixThreeLocalData S P1 P2 where
  dihedralCore := lemma_six_three S0 S P1 P2 h
  nativeSL2 hcomm := (sixThree_native_quotients S0 S P1 P2 h hcomm).2

@[expose] public def SectionEightContext.toLocalContext
    {H : Type u} [Group H] [Finite H]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    (ctx : SectionEightContext H S0 S P1 P2) : SectionEightLocalContext H S P1 P2 where
  sectionSeven := ctx.hypothesisTwo.sectionSevenHypotheses ctx.generated
  sixThree := SixThreeLocalData.ofHypothesisTwo ctx.hypothesisTwo
  Γ := ctx.Γ
  criticalPath := ctx.criticalPath
  commutator_ne := ctx.commutator_ne

private theorem dihedralCore_of_equiv
    {A B : Type u} [Group A] [Group B] [Finite A] [Finite B]
    (equiv : A ≃* B)
    (h : ∃ n : ℕ, Nonempty ((B ⧸ pCore 2 B) ≃* DihedralGroup (3 ^ n))) :
    ∃ n : ℕ, Nonempty ((A ⧸ pCore 2 A) ≃* DihedralGroup (3 ^ n)) := by
  obtain ⟨exponent, ⟨model⟩⟩ := h
  exact ⟨exponent, ⟨(QuotientGroup.congr _ _ equiv (pCore_map_iso 2 equiv)).trans model⟩⟩

private theorem nativeSL2_of_equiv
    {A B : Type u} [Group A] [Group B] [Finite A] [Finite B]
    (equiv : A ≃* B)
    (h : IsSL2Two ((B ⧸ pCore 2 B) ⧸ frattini (B ⧸ pCore 2 B))) :
    IsSL2Two ((A ⧸ pCore 2 A) ⧸ frattini (A ⧸ pCore 2 A)) := by
  let coreEquiv := QuotientGroup.congr _ _ equiv (pCore_map_iso 2 equiv)
  have hfrattini : (frattini (A ⧸ pCore 2 A)).map coreEquiv.toMonoidHom =
      frattini (B ⧸ pCore 2 B) := coreEquiv.mapSubgroup.map_radical
  obtain ⟨model⟩ := h
  exact ⟨(QuotientGroup.congr _ _ coreEquiv hfrattini).trans model⟩

public theorem SixThreeLocalData.subgroupOf
    {H : Type u} [Group H] [Finite H]
    {S P1 P2 : Subgroup H} (h : SixThreeLocalData S P1 P2)
    (J : Subgroup H) (hSJ : S ≤ J) (hP1J : P1 ≤ J) (hP2J : P2 ≤ J) :
    SixThreeLocalData (S.subgroupOf J) (P1.subgroupOf J) (P2.subgroupOf J) := by
  have hcomm : ⁅P2.subgroupOf J, omegaOneCenter (S.subgroupOf J)⁆ ≠ ⊥ →
      ⁅P2, omegaOneCenter S⁆ ≠ ⊥ := by
    intro hrestricted hambient
    apply hrestricted
    apply (Subgroup.map_eq_bot_iff_of_injective _ J.subtype_injective).mp
    rw [Subgroup.map_commutator, Subgroup.map_subgroupOf_eq_of_le hP2J]
    have homega : (omegaOneCenter (S.subgroupOf J)).map J.subtype =
        omegaOneCenter S := by
      change (omegaOneCenterAmbient (S.subgroupOf J)).map J.subtype =
        omegaOneCenterAmbient S
      rw [← omegaOneCenterAmbient_map_injective J.subtype J.subtype_injective,
        Subgroup.map_subgroupOf_eq_of_le hSJ]
    rw [homega, hambient]
  constructor
  · intro hrestricted
    obtain ⟨hleft, hright⟩ := h.dihedralCore (hcomm hrestricted)
    exact ⟨dihedralCore_of_equiv (Subgroup.subgroupOfEquivOfLe hP1J) hleft,
      dihedralCore_of_equiv (Subgroup.subgroupOfEquivOfLe hP2J) hright⟩
  · intro hrestricted
    obtain ⟨hleft, hright⟩ := h.nativeSL2 (hcomm hrestricted)
    exact ⟨nativeSL2_of_equiv (Subgroup.subgroupOfEquivOfLe hP1J) hleft,
      nativeSL2_of_equiv (Subgroup.subgroupOfEquivOfLe hP2J) hright⟩

public structure GeneratedSectionEightContext
    (H : Type u) [Group H] [Finite H]
    (S0 : Sylow 2 H) (S P1 P2 : Subgroup H) where
  hypothesisTwo : HypothesisTwo H S0 S P1 P2
  sectionSeven : SectionSevenHypotheses (P1 ⊔ P2 : Subgroup H)
    (S.subgroupOf (P1 ⊔ P2)) (P1.subgroupOf (P1 ⊔ P2)) (P2.subgroupOf (P1 ⊔ P2))
  Γ : CosetGraphContext (P1 ⊔ P2 : Subgroup H)
    (S.subgroupOf (P1 ⊔ P2)) (P1.subgroupOf (P1 ⊔ P2)) (P2.subgroupOf (P1 ⊔ P2))
  criticalPath : CriticalPath Γ
  commutator_ne : ⁅Γ.z criticalPath.a, Γ.z criticalPath.a'⁆ ≠ ⊥

@[expose] public def GeneratedSectionEightContext.toLocalContext
    {H : Type u} [Group H] [Finite H]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    (ctx : GeneratedSectionEightContext H S0 S P1 P2) :
    SectionEightLocalContext (P1 ⊔ P2 : Subgroup H)
      (S.subgroupOf (P1 ⊔ P2)) (P1.subgroupOf (P1 ⊔ P2)) (P2.subgroupOf (P1 ⊔ P2)) where
  sectionSeven := ctx.sectionSeven
  sixThree := (SixThreeLocalData.ofHypothesisTwo ctx.hypothesisTwo).subgroupOf (P1 ⊔ P2)
    (ctx.hypothesisTwo.fiveOne.P1_mem.1.2.1.1.trans le_sup_left) le_sup_left le_sup_right
  Γ := ctx.Γ
  criticalPath := ctx.criticalPath
  commutator_ne := ctx.commutator_ne

public theorem SectionEightContext.toLocalContext_Γ
    {H : Type u} [Group H] [Finite H]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    (ctx : SectionEightContext H S0 S P1 P2) : ctx.toLocalContext.Γ = ctx.Γ := rfl

public theorem GeneratedSectionEightContext.toLocalContext_Γ
    {H : Type u} [Group H] [Finite H]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    (ctx : GeneratedSectionEightContext H S0 S P1 P2) : ctx.toLocalContext.Γ = ctx.Γ := rfl

end Stellmacher.Later
