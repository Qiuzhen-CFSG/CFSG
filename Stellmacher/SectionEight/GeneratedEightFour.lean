module
public import Stellmacher.SectionEight.LemmaEightFour
/-!
# Fixed-center normality in the actual generated graph

The faithful initial-center witness lives on the subgroup generated by the
two local stabilizers. The proved local (8.4) theorem applies to that exact
graph, using the ambient-backed core noncontainment and vector-centralizer
criterion supplied by the generated context adapter. Hypothesis Two remains
on the ambient group. The original witness, action and fixed subgroup are
preserved. This supplies fixed normality for the generated (8.5) reductions.
Source: Stellmacher, Journal of Algebra 190 (1997), (8.4), printed pp.38–40.
-/
namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
universe u

public theorem generated_lemma_eight_four
    {H : Type u} [Group H] [Finite H]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    (ctx : GeneratedSectionEightContext H S0 S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (w : QuotientModuleWitness (GAt ctx.Γ ctx.criticalPath.a)
      (GAt ctx.Γ ctx.criticalPath.a ⊓
        Subgroup.centralizer (ZAt ctx.Γ ctx.criticalPath.a : Set (P1 ⊔ P2 : Subgroup H)))
      (ZAt ctx.Γ ctx.criticalPath.a)) :
    NormalIn (w.oneJFixedPoints (S.subgroupOf (P1 ⊔ P2)))
      (GAt ctx.Γ ctx.criticalPath.firstStep) := by
  exact lemma_eight_four_local ctx.toEightFourContext hcenter w

end Stellmacher.SectionEight
