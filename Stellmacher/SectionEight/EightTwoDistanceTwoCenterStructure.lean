/-!
# The central index-four subgroup in the distance-two case of (8.2)

For the actual two backward vertices m,n, assume critical length two,
first-step noncentrality, the source generating equalities, and the two
shifted critical pairs. The shared subgroup V0 = Va ∩ Qm ∩ Qfirst is
normal in Ga, central in Va, and has index four there; Va is generated by
Zm, Zfirst and V0. The index and generation statement is imported from its
independent two-intersection calculation.

The initial core Qa normalizes each factor defining V0 because it lies in
both neighboring stabilizers. In the edge at the terminal vertex, the
opposite critical center Za crosses the index-two core and therefore gives
the full edge commutator action; this bounds [V0,Za'] by [Za,Za']≤Za≤V0.
The same argument at n bounds [V0,Zn] by [Za,Zn]≤Za. Criticality puts Zn
outside Qa inside the backward edge, so Zn and Qa generate that edge.
Together with Za' they generate Ga, proving full normality of V0.

Initially V0 centralizes Zm since it lies in Qm. Its Ga-normality and
transitivity on neighbors then make it centralize every neighbor center,
hence Va. All subgroups remain in the actual local graph and use the
single exposed distanceTwoVZero definition. The second generating equality
is retained from the source tuple, although these bounds need only the first.
Source: Stellmacher (8.2), Journal of Algebra 190 (1997), pp.37–38,
`refs/latex/stellmacher-n-group.tex`, the V0 paragraph.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
universe u

private theorem core_le_vertex
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (Γ : CosetGraphContext G S P1 P2) (d : Γ.Vertex) :
    q Γ d ≤ stabilizer Γ d := by
  rw [q, Γ.twoCoreAt_def]
  exact Subgroup.map_subtype_le _

private theorem core_le_neighbor
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2) (Γ : CosetGraphContext G S P1 P2)
    (d m : Γ.Vertex) (hadj : Γ.adjacent d m) :
    q Γ d ≤ stabilizer Γ m := by
  have hm := (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr hadj
  exact ((lemma_seven_three h Γ).sylow_and_core d m hm default).2.2

private theorem center_centralizes_core
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2) (Γ : CosetGraphContext G S P1 P2)
    (d m : Γ.Vertex) (hadj : Γ.adjacent d m) :
    z Γ d ≤ Subgroup.centralizer (q Γ d : Set G) := by
  have hm := (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr hadj
  exact ((lemma_seven_three h Γ).center_core d m hm).trans
    ((SevenSix.omegaOneCenter_le_centerAmbient _).trans
      (SevenSix.centerAmbient_le_centralizer _))

private theorem center_le_neighbor_core
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (Γ : CosetGraphContext G S P1 P2) (cp : CriticalPath Γ)
    (hlen : 1 < cp.length) (d m : Γ.Vertex) (hadj : Γ.adjacent d m) :
    z Γ d ≤ q Γ m := by
  apply SevenSix.critical_minimality Γ cp
  have hdistance := (SevenSix.adjacent_iff_distance_eq_one Γ).mp hadj
  omega

private theorem critical_center_le_other_stabilizer
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (h : SectionSevenHypotheses G S P1 P2) (Γ : CosetGraphContext G S P1 P2)
    (base : CriticalPath Γ) (d e : Γ.Vertex) (hcritical : IsCriticalPair Γ d e) :
    z Γ d ≤ stabilizer Γ e := by
  obtain ⟨actor, cp, hleft, hright, _⟩ :=
    exists_criticalPath_of_critical_pair h Γ base d e hcritical
  have h74 := lemma_seven_four h Γ cp
  have hle := h74.first_containment.1.trans h74.first_containment.2
  rw [hleft, hright, z_act, stabilizer_act] at hle
  exact (Subgroup.map_le_map_iff_of_injective (MulAut.conj actor⁻¹).injective).mp hle

private theorem join_of_index_two
    {G : Type u} [Group G] (A Q T : Subgroup G)
    (hAT : A ≤ T) (hQT : Q ≤ T) (hindex : Q.relIndex T = 2)
    (hnot : ¬ A ≤ Q) : A ⊔ Q = T := by
  have hprod := Subgroup.relIndex_mul_relIndex Q (A ⊔ Q) T
    le_sup_right (sup_le hAT hQT)
  rw [hindex] at hprod
  have hnotone : Q.relIndex (A ⊔ Q) ≠ 1 := by
    intro hone
    exact hnot (le_sup_left.trans (Subgroup.relIndex_eq_one.mp hone))
  have hpositive : 0 < Q.relIndex (A ⊔ Q) := by
    apply Nat.pos_of_ne_zero
    intro hzero
    simp only [hzero, zero_mul] at hprod
    omega
  have hpositive' : 0 < (A ⊔ Q).relIndex T := by
    apply Nat.pos_of_ne_zero
    intro hzero
    simp only [hzero, mul_zero] at hprod
    omega
  have hone : (A ⊔ Q).relIndex T = 1 := by
    have htwo : 2 ≤ Q.relIndex (A ⊔ Q) := by omega
    nlinarith
  exact le_antisymm (sup_le hAT hQT) (Subgroup.relIndex_eq_one.mp hone)

private theorem core_commutator_le_center_pair
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ¬ ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hlen : 1 < ctx.criticalPath.length)
    (left middle right : ctx.Γ.Vertex)
    (hleft : ctx.Γ.adjacent left middle) (hright : ctx.Γ.adjacent middle right)
    (hnot : ¬ z ctx.Γ left ≤ q ctx.Γ right) :
    ⁅q ctx.Γ middle, z ctx.Γ right⁆ ≤ ⁅z ctx.Γ left, z ctx.Γ right⁆ := by
  let Γ := ctx.Γ
  let E := stabilizer Γ right ⊓ stabilizer Γ middle
  have hQmidE : q Γ middle ≤ E := le_inf
    (core_le_neighbor ctx.sectionSeven Γ middle right hright) (core_le_vertex Γ middle)
  have hQrightE : q Γ right ≤ E := le_inf (core_le_vertex Γ right)
    (core_le_neighbor ctx.sectionSeven Γ right middle (Γ.adjacent_symm hright))
  have hZleftE : z Γ left ≤ E :=
    (center_le_neighbor_core Γ ctx.criticalPath hlen left middle hleft).trans hQmidE
  have hindex : (q Γ right).relIndex E = 2 := by
    rw [q, Γ.twoCoreAt_def]
    exact eight_two_core_relIndex_two _ _
      (eight_two_adjacent_intersection_is_sylow_local ctx hcenter right middle
        (Γ.adjacent_symm hright)) (eight_two_dihedral_core_local ctx hcenter right)
  have hsat := Subgroup.commutator_eq_of_centralizing_index_two (z Γ right) (q Γ right) E (z Γ left)
    (inf_le_left.trans (stabilizer_le_normalizer_z Γ right)) hQrightE
    (Subgroup.le_centralizer_iff.mp
      (center_centralizes_core ctx.sectionSeven Γ right middle (Γ.adjacent_symm hright)))
    hindex hZleftE hnot
  exact (Subgroup.commutator_mono hQmidE le_rfl).trans_eq hsat

private theorem distance_two_vzero_normal
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ¬ ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hlen : ctx.criticalPath.length = 2)
    (m n : ctx.Γ.Vertex)
    (hm : m ∈ neighborhood ctx.Γ ctx.criticalPath.a)
    (hn : n ∈ neighborhood ctx.Γ m)
    (hgen : (GAt ctx.Γ ctx.criticalPath.a ⊓ GAt ctx.Γ m) ⊔
      ZAt ctx.Γ ctx.criticalPath.a' = GAt ctx.Γ ctx.criticalPath.a)
    (hcritical : IsCriticalPair ctx.Γ n ctx.criticalPath.a) :
    NormalIn (distanceTwoVZero ctx m) (GAt ctx.Γ ctx.criticalPath.a) := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let V := v Γ cp.a
  let V0 := distanceTwoVZero ctx m
  let Q := q Γ cp.a
  let E := stabilizer Γ cp.a ⊓ stabilizer Γ m
  change cp.length = 2 at hlen
  have hlong : 1 < cp.length := by omega
  have hma : Γ.adjacent cp.a m := (SevenSix.mem_neighborhood_iff_adjacent Γ).mp hm
  have hmn : Γ.adjacent m n := (SevenSix.mem_neighborhood_iff_adjacent Γ).mp hn
  have hVQ : V ≤ Q := SevenSix.neighbor_join_le_core_of_length_gt_one Γ cp hlong cp.a
  have hV0V : V0 ≤ V := inf_le_left.trans inf_le_left
  have hV0m : V0 ≤ q Γ m := inf_le_left.trans inf_le_right
  have hV0first : V0 ≤ q Γ cp.firstStep := inf_le_right
  have hV0P : V0 ≤ stabilizer Γ cp.a := (hV0V.trans hVQ).trans (core_le_vertex Γ cp.a)
  have hZaV0 : z Γ cp.a ≤ V0 := by
    apply le_inf
    · exact le_inf (vertex_center_le_neighbor_join ctx.sectionSeven Γ cp.a m hm)
        (center_le_neighbor_core Γ cp hlong cp.a m hma)
    · exact center_le_neighbor_core Γ cp hlong cp.a cp.firstStep cp.firstStep_adj
  have hQaNorm : Q ≤ Subgroup.normalizer (V0 : Set G) := by
    have hQV : Q ≤ Subgroup.normalizer (V : Set G) :=
      (core_le_vertex Γ cp.a).trans (stabilizer_le_normalizer_v Γ cp.a)
    have hQm : Q ≤ Subgroup.normalizer (q Γ m : Set G) :=
      (core_le_neighbor ctx.sectionSeven Γ cp.a m hma).trans
        (SevenSix.stabilizer_le_normalizer_q Γ m)
    have hQf : Q ≤ Subgroup.normalizer (q Γ cp.firstStep : Set G) :=
      (core_le_neighbor ctx.sectionSeven Γ cp.a cp.firstStep cp.firstStep_adj).trans
        (SevenSix.stabilizer_le_normalizer_q Γ cp.firstStep)
    exact (le_inf ((le_inf hQV hQm).trans Subgroup.inf_normalizer_le_normalizer_inf) hQf).trans
      Subgroup.inf_normalizer_le_normalizer_inf
  have hfirstEnd : Γ.adjacent cp.firstStep cp.a' := by
    have hp := cp.path_adj ⟨cp.length - 1, by omega⟩
    have hi : (⟨cp.length - 1, by omega⟩ : Fin cp.length).succ =
        ⟨cp.length, Nat.lt_succ_self _⟩ := by
      apply Fin.ext
      simp only [Fin.val_succ]
      omega
    rw [hi, cp.path_end] at hp
    have heq : cp.path ⟨cp.length - 1, by omega⟩ = cp.firstStep := by
      have hi' : (⟨cp.length - 1, by omega⟩ : Fin (cp.length + 1)) = ⟨1, by omega⟩ := by
        apply Fin.ext
        change cp.length - 1 = 1
        omega
      rw [hi']
      exact cp.path_first
    change Γ.adjacent (cp.path ⟨cp.length - 1, by omega⟩) cp.a' at hp
    rwa [heq] at hp
  have hV0End : ⁅V0,z Γ cp.a'⁆ ≤ V0 := by
    have hbound := core_commutator_le_center_pair ctx hcenter hlong
      cp.a cp.firstStep cp.a' cp.firstStep_adj hfirstEnd cp.critical.2
    have hR := critical_pair_commutator_le_inf ctx.sectionSeven Γ cp cp.a cp.a' cp.critical
    exact ((Subgroup.commutator_mono hV0first le_rfl).trans hbound).trans
      ((hR.trans inf_le_left).trans hZaV0)
  have hZna : ⁅z Γ n,z Γ cp.a⁆ ≠ ⊥ :=
    eight_two_critical_pair_commutator_ne_local ctx hcenter n cp.a hcritical
  have hZaNotQn : ¬ z Γ cp.a ≤ q Γ n := by
    intro hle
    exact hZna (Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
      ((center_centralizes_core ctx.sectionSeven Γ n m (Γ.adjacent_symm hmn)).trans
        (Subgroup.centralizer_le hle)))
  have hV0n : ⁅V0,z Γ n⁆ ≤ V0 := by
    have hbound := core_commutator_le_center_pair ctx hcenter hlong
      cp.a m n hma hmn hZaNotQn
    have hR := critical_pair_commutator_le_inf ctx.sectionSeven Γ cp n cp.a hcritical
    rw [Subgroup.commutator_comm] at hR
    exact ((Subgroup.commutator_mono hV0m le_rfl).trans hbound).trans
      ((hR.trans inf_le_right).trans hZaV0)
  have hZnE : z Γ n ≤ E := le_inf
    (critical_center_le_other_stabilizer ctx.sectionSeven Γ cp n cp.a hcritical)
    ((center_le_neighbor_core Γ cp hlong n m (Γ.adjacent_symm hmn)).trans (core_le_vertex Γ m))
  have hQE : Q ≤ E := le_inf (core_le_vertex Γ cp.a)
    (core_le_neighbor ctx.sectionSeven Γ cp.a m hma)
  have hindex : Q.relIndex E = 2 := by
    rw [show Q = q Γ cp.a from rfl, q, Γ.twoCoreAt_def]
    exact eight_two_core_relIndex_two _ _
      (eight_two_adjacent_intersection_is_sylow_local ctx hcenter cp.a m hma)
      (eight_two_dihedral_core_local ctx hcenter cp.a)
  have hjoin : z Γ n ⊔ Q = E := join_of_index_two _ _ _ hZnE hQE hindex hcritical.2
  have hEnorm : E ≤ Subgroup.normalizer (V0 : Set G) := by
    rw [← hjoin]
    exact sup_le (Subgroup.le_normalizer_iff_commutator_le_left.mpr hV0n) hQaNorm
  have hPnorm : stabilizer Γ cp.a ≤ Subgroup.normalizer (V0 : Set G) := by
    change E ⊔ z Γ cp.a' = stabilizer Γ cp.a at hgen
    rw [← hgen]
    exact sup_le hEnorm (Subgroup.le_normalizer_iff_commutator_le_left.mpr hV0End)
  exact ⟨hV0P, (Subgroup.normal_subgroupOf_iff_le_normalizer hV0P).mpr hPnorm⟩


private theorem distance_two_vzero_central
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (m : ctx.Γ.Vertex) (hm : m ∈ neighborhood ctx.Γ ctx.criticalPath.a)
    (hnormal : NormalIn (distanceTwoVZero ctx m) (GAt ctx.Γ ctx.criticalPath.a)) :
    distanceTwoVZero ctx m ≤ CenterAmbient (VAt ctx.Γ ctx.criticalPath.a) := by
  let Γ := ctx.Γ
  let a := ctx.criticalPath.a
  let V0 := distanceTwoVZero ctx m
  let C := Subgroup.centralizer (V0 : Set G)
  have hV0m : V0 ≤ q Γ m := inf_le_left.trans inf_le_right
  have hZmC : z Γ m ≤ C :=
    (center_centralizes_core ctx.sectionSeven Γ m a
      (Γ.adjacent_symm ((SevenSix.mem_neighborhood_iff_adjacent Γ).mp hm))).trans
      (Subgroup.centralizer_le hV0m)
  have hGaNorm : stabilizer Γ a ≤ Subgroup.normalizer (V0 : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hnormal.1).mp hnormal.2
  have hNormC : Subgroup.normalizer (V0 : Set G) ≤ Subgroup.normalizer (C : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer
      (Subgroup.centralizer_le_normalizer (V0 : Set G))).mp inferInstance
  have hGaC : stabilizer Γ a ≤ Subgroup.normalizer (C : Set G) := hGaNorm.trans hNormC
  have hVC : v Γ a ≤ C := by
    rw [v, Γ.vAt_def]
    apply sSup_le
    rintro Z ⟨neighbor, hneighbor, rfl⟩
    obtain ⟨actor, hactor⟩ := (lemma_seven_one ctx.sectionSeven Γ).local_transitivity a hm hneighbor
    change z Γ neighbor ≤ C
    rw [← hactor, z_act]
    rintro element ⟨original, horiginal, rfl⟩
    exact (Subgroup.mem_normalizer_iff.mp
      (hGaC ((stabilizer Γ a).inv_mem actor.property)) original).mp (hZmC horiginal)
  have hV0V : V0 ≤ v Γ a := inf_le_left.trans inf_le_left
  have hcentral : V0 ≤ Subgroup.centralizer (v Γ a : Set G) :=
    Subgroup.le_centralizer_iff.mp hVC
  intro element helement
  refine ⟨⟨element, hV0V helement⟩, ?_, rfl⟩
  change (⟨element, hV0V helement⟩ : v Γ a) ∈ Subgroup.center (v Γ a)
  rw [Subgroup.mem_center_iff]
  intro other
  apply Subtype.ext
  exact Subgroup.mem_centralizer_iff.mp (hcentral helement) other other.property

public theorem eight_two_distance_two_center_structure_local
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ¬ ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hlen : ctx.criticalPath.length = 2)
    (m n : ctx.Γ.Vertex)
    (hm : m ∈ neighborhood ctx.Γ ctx.criticalPath.a)
    (hn : n ∈ neighborhood ctx.Γ m)
    (hgen : (GAt ctx.Γ ctx.criticalPath.a ⊓ GAt ctx.Γ m) ⊔
      ZAt ctx.Γ ctx.criticalPath.a' = GAt ctx.Γ ctx.criticalPath.a)
    (_hgen2 : (GAt ctx.Γ m ⊓ GAt ctx.Γ n) ⊔
      ZAt ctx.Γ ctx.criticalPath.firstStep = GAt ctx.Γ m)
    (hcritical1 : IsCriticalPair ctx.Γ m ctx.criticalPath.firstStep)
    (hcritical2 : IsCriticalPair ctx.Γ n ctx.criticalPath.a) :
    NormalIn (distanceTwoVZero ctx m) (GAt ctx.Γ ctx.criticalPath.a) ∧
      distanceTwoVZero ctx m ≤ CenterAmbient (VAt ctx.Γ ctx.criticalPath.a) ∧
      VAt ctx.Γ ctx.criticalPath.a =
        ZAt ctx.Γ m ⊔ ZAt ctx.Γ ctx.criticalPath.firstStep ⊔ distanceTwoVZero ctx m ∧
      (distanceTwoVZero ctx m).relIndex (VAt ctx.Γ ctx.criticalPath.a) = 4 := by
  have hnormal := distance_two_vzero_normal ctx hcenter hlen m n hm hn hgen hcritical2
  exact ⟨hnormal, distance_two_vzero_central ctx m hm hnormal,
    eight_two_distance_two_index_structure_local ctx hcenter hlen m hm hcritical1⟩

end Stellmacher.SectionEight
