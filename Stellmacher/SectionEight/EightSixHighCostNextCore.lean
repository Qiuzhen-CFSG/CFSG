module
public import Stellmacher.SectionEight.EightSixSelectedFixedCoreCollapse
public import Stellmacher.SectionEight.EightSixSelectedResidualDecomposition

/-!
# The next core equals its neighbor module in the high-cost branch

For the actual selected configuration in (8.6), uniform actor cost at least
eight and the proved fixed-core containment imply Qnext=Vnext. Elementary D,
already supplied by the common structural theorem, remains an explicit input.
The actual subgroup definitions and geometric selector are retained.

Equation one gives Qnext=Vnext D and [Vnext,Qnext]=Znext. Hence the quotient
Qnext/Znext has exponent two: its Vnext image has exponent two, commutes
with the D image, and D is elementary. In particular the quotient is
abelian, so the next core acts trivially on it. The normalized residual
fixed decomposition therefore applies to the literal next-stabilizer action:
the residual image has odd order, and quotient fixed vectors lift through
the central line using residual perfection. Thus Qnext is generated by
[Qnext,O²(E)] and its residual centralizer V0. The high-cost fixed-core
collapse gives V0=Znext; both generating factors lie in Vnext. This proves
the subgroup equality without a cardinality inference or an assumption
that the ambient residual has odd order.

Source: Stellmacher, Journal of Algebra 190 (1997), Lemma (8.6), assertion
(18), printed p.45, `refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
open scoped commutatorElement Pointwise IsMulCommutative
universe u

public theorem eight_six_high_cost_next_core_eq_v
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hquot : QuotientIsModel (GAt ctx.Γ ctx.criticalPath.a)
      (QAt ctx.Γ ctx.criticalPath.a) SL2Two)
    (hlength : ctx.criticalPath.length = 2)
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4)
    (previous : ctx.Γ.Vertex) (D L Q : Subgroup G)
    (hprev : previous ∈ Neighborhood ctx.Γ ctx.criticalPath.a ∧
      previous ≠ ctx.criticalPath.firstStep)
    (data : EightSixEquationOneData ctx.Γ ctx.criticalPath previous D L Q)
    (E A0 : Subgroup G) (actor : G)
    (geom : SectionNine.NineThreeGeometricData ctx.Γ
      ctx.criticalPath.firstStep ctx.criticalPath.a
      (VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a) E A0 actor)
    (hcore : conjugateClosure (ZAt ctx.Γ ctx.criticalPath.a) E ≤
      QAt ctx.Γ ctx.criticalPath.a)
    (hedge : E ⊔ (GAt ctx.Γ ctx.criticalPath.a ⊓ GAt ctx.Γ ctx.criticalPath.firstStep) =
      GAt ctx.Γ ctx.criticalPath.firstStep)
    (hD : D = QAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.firstStep)
    (hL : L = conjugateClosure (QAt ctx.Γ previous) (GAt ctx.Γ ctx.criticalPath.a))
    (hhigh : ∀ mover : G, mover ∈ VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a →
      mover ∉ QAt ctx.Γ ctx.criticalPath.firstStep →
        8 ≤ eightSixCommutatorCost ctx.Γ ctx.criticalPath mover)
    (hV0Qa : QAt ctx.Γ ctx.criticalPath.firstStep ⊓
      Subgroup.centralizer (twoResidualIn E : Set G) ≤ QAt ctx.Γ ctx.criticalPath.a)
    (helementary : IsElementaryAbelianSubgroup 2 D) :
    QAt ctx.Γ ctx.criticalPath.firstStep = VAt ctx.Γ ctx.criticalPath.firstStep := by
  classical
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let P := GAt Γ cp.firstStep
  let R := QAt Γ cp.firstStep
  let V := VAt Γ cp.firstStep
  let Z := ZAt Γ cp.firstStep
  have hRP : R ≤ P := by
    change Γ.twoCoreAt _ ≤ _
    rw [Γ.twoCoreAt_def]
    exact Subgroup.map_subtype_le _
  have hVR : V ≤ R := SevenSix.neighbor_join_le_core_of_length_gt_one Γ cp
    (by exact hlength ▸ by decide) _
  have hDR : D ≤ R := hD ▸ inf_le_right
  have hZV : Z ≤ V := (eight_six_first_step_fixed_line_local ctx hcenter hcard).2.trans
    (lemma_seven_four ctx.sectionSeven Γ cp).first_containment.1
  have hPR : P ≤ Subgroup.normalizer (R : Set G) := SevenSix.stabilizer_le_normalizer_q Γ _
  have hPZ : P ≤ Subgroup.normalizer (Z : Set G) := stabilizer_le_normalizer_z Γ _
  have hN : (Z.subgroupOf R).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer (hRP.trans hPZ)
  let _ := hN
  let W := R ⧸ Z.subgroupOf R
  let projection := QuotientGroup.mk' (Z.subgroupOf R)
  have hgen : R = V ⊔ D := eight_six_next_core_eq_v_sup_intersection ctx hlength
    previous D L Q hprev.1 hD hL data
  obtain ⟨hNV,hWV,_⟩ := eight_six_next_quotient_module_data_local ctx hcenter hlength
    hcard data.first_commutator
  have hsquareV (v : G) (hv : v ∈ V) : v ^ 2 ∈ Z := by
    let _ := hNV
    let _ := hWV
    have hh := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 (V ⧸ Z.subgroupOf V))
      (QuotientGroup.mk' (Z.subgroupOf V) ⟨v,hv⟩)
    rw [← map_pow] at hh
    exact (QuotientGroup.eq_one_iff (N := Z.subgroupOf V) ((⟨v,hv⟩ : V) ^ 2)).mp hh
  let _ : IsElementaryAbelian 2 D := helementary
  have hDNV : D ≤ Subgroup.normalizer (V : Set G) :=
    (hDR.trans hRP).trans (stabilizer_le_normalizer_v Γ _)
  have hsquare (w : W) : w ^ 2 = 1 := by
    obtain ⟨r,rfl⟩ := QuotientGroup.mk'_surjective (Z.subgroupOf R) w
    have hr : (r:G) ∈ (V : Set G) * (D : Set G) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left V D hDNV,←hgen]
      exact r.property
    obtain ⟨v,hv,d,hd,hvd⟩ := hr
    let vR : R := ⟨v,hVR hv⟩
    let dR : R := ⟨d,hDR hd⟩
    have heq : r = vR * dR := Subtype.ext hvd.symm
    have hcomm : Commute (projection vR) (projection dR) := by
      apply commutatorElement_eq_one_iff_mul_comm.mp
      rw [←map_commutatorElement]
      apply (QuotientGroup.eq_one_iff _).mpr
      change ⁅v,d⁆ ∈ Z
      exact data.first_commutator.le (Subgroup.commutator_mem_commutator hv (hDR hd))
    rw [heq,map_mul,hcomm.mul_pow,←map_pow,←map_pow]
    have hv2 : projection (vR^2) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr (hsquareV v hv)
    have hd2 : dR^2 = 1 := Subtype.ext (elemPow_eq_one_of_isElementaryAbelian d hd)
    rw [hv2,hd2,map_one,mul_one]
  have hW : IsElementaryAbelian 2 W := {
    toIsMulCommutative := ⟨⟨fun a b => by
      have hinv (w : W) : w⁻¹ = w := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using hsquare w)
      calc a*b = (a*b)⁻¹ := (hinv _).symm
           _ = b*a := by rw [mul_inv_rev,hinv,hinv]⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hsquare }
  let _ := hW
  have hRR : ⁅R,R⁆ ≤ Z := by
    have hderived : _root_.commutator R ≤ Z.subgroupOf R :=
      (Subgroup.Normal.quotient_commutative_iff_commutator_le (N := Z.subgroupOf R)).mp inferInstance
    have hh := Subgroup.map_mono (f := R.subtype) hderived
    rw [_root_.commutator_def,Subgroup.map_commutator,
      ←MonoidHom.range_eq_map,Subgroup.range_subtype,
      Subgroup.map_subgroupOf_eq_of_le (hZV.trans hVR)] at hh
    exact hh
  obtain ⟨action,haction⟩ := Subgroup.exists_quotient_conjugation_action P R Z hPR hPZ hN
  have hkernel : pCore 2 P ≤ action.ker := by
    have hk := Subgroup.quotient_conjugation_action_kills_commutator_layer
      P R Z R hN hPR hRR action haction
    have hcoreEq : R.subgroupOf P = pCore 2 P := by
      change (Γ.twoCoreAt _).subgroupOf P = _
      rw [Γ.twoCoreAt_def]
      exact Subgroup.comap_map_eq_self_of_injective P.subtype_injective _
    exact hcoreEq ▸ hk
  have hsplit := (eight_six_normalized_residual_fixed_decomposition ctx hcenter hcard
    E geom.group_le R hPR (hZV.trans hVR) hN hW action haction hkernel).2.2.2
  have hfixed := eight_six_selected_fixed_core_eq_next_center ctx hcenter hquot hlength hcard
    previous D L Q hprev data E A0 actor geom hcore hedge hD hL hhigh hV0Qa
  have hVsplit := (eight_six_selected_residual_decomposition ctx hcenter hquot hlength hcard
    previous D L Q hprev data E A0 actor geom hcore hedge hD hL).2.2
  apply le_antisymm ?_ hVR
  rw [hsplit,hfixed]
  exact sup_le (le_sup_left.trans hVsplit.symm.le) hZV

end Stellmacher.SectionEight
