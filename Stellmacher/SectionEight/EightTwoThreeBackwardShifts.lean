module
public import Stellmacher.SectionEight.EightTwoTwoBackwardShifts
public import Stellmacher.SectionFiveToSeven.PrescribedCriticalPairNormalization

/-!
# A third backward critical pair through the same vertices

At critical length two in the noncentral case of (8.2), keep supplied
backward vertices m,n with n,m,a a critical path. There is a further
neighbor r of n such that (r,m) is critical and Gn is generated by its
intersection with Gr and Za. The neighbor module Vn is outside Qm.

Normalize the supplied critical pair (n,a) through the supplied neighbor m.
The length and prescribed first step retain all three vertices. Apply the
proved backward-shift theorem in this genuine local context and pull its
first new neighbor back by the inverse actor. Conjugation transports the
new generating equality and noncontainment. The actual path r,n,m and
critical minimality prove criticality in the original graph. Since Zr lies
in Vn, the critical noncontainment gives Vn not contained in Qm.

Source: Stellmacher (8.2), Journal of Algebra 190 (1997), printed p.38,
refs/latex/stellmacher-n-group.tex, the choice of a-3. The displayed
Gm=(Gm intersect Gn) join Zfirst there repeats the previous choice. The
new choice yields Gn=(Gn intersect Gr) join Za; these equalities are not
interchanged. The separate module-generation result uses the former.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
universe u

public theorem eight_two_exists_three_backward_shifts_local
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ¬ ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hlen : ctx.criticalPath.length = 2)
    (m n : ctx.Γ.Vertex)
    (hm : m ∈ neighborhood ctx.Γ ctx.criticalPath.a)
    (hn : n ∈ neighborhood ctx.Γ m)
    (hcrit : IsCriticalPair ctx.Γ n ctx.criticalPath.a) :
    ∃ r : ctx.Γ.Vertex, r ∈ neighborhood ctx.Γ n ∧
      (GAt ctx.Γ n ⊓ GAt ctx.Γ r) ⊔ ZAt ctx.Γ ctx.criticalPath.a = GAt ctx.Γ n ∧
      IsCriticalPair ctx.Γ r m ∧
      (¬ ZAt ctx.Γ r ≤ GAt ctx.Γ ctx.criticalPath.a) ∧
      (¬ VAt ctx.Γ n ≤ QAt ctx.Γ m) := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  change cp.length = 2 at hlen
  change m ∈ neighborhood Γ cp.a at hm
  change n ∈ neighborhood Γ m at hn
  have hma : Γ.distance m cp.a = 1 := by
    rw [Γ.distance_symm]
    exact (SevenSix.adjacent_iff_distance_eq_one Γ).mp
      ((SevenSix.mem_neighborhood_iff_adjacent Γ).mp hm)
  have hna : Γ.distance n cp.a = 2 :=
    hcrit.1.trans (cp.critical.1.symm.trans (cp.endpoint_distance.trans hlen))
  obtain ⟨actor, shifted, hstart, hend, hfirst, hlength⟩ :=
    exists_criticalPath_of_critical_pair_through_neighbor ctx.sectionSeven Γ cp n cp.a m
      hcrit (Γ.adjacent_symm ((SevenSix.mem_neighborhood_iff_adjacent Γ).mp hn))
      (by omega)
  have hshiftedLength : shifted.length = 2 := hlength.trans hlen
  let shiftedCtx : SectionEightLocalContext G S P1 P2 :=
    { sectionSeven := ctx.sectionSeven
      sixThree := ctx.sixThree
      Γ := Γ
      criticalPath := shifted
      commutator_ne := eight_two_critical_pair_commutator_ne_local ctx hcenter
        shifted.a shifted.a' shifted.critical }
  have hshiftedCenter : ¬ ZAt Γ shifted.firstStep ≤
      CenterAmbient (GAt Γ shifted.firstStep) :=
    eight_two_all_vertex_centers_noncentral_local ctx hcenter shifted.firstStep
  obtain ⟨back, _further, hback, _hfurther, hbackGen, _hfurtherGen,
      hbackCritical, _hfurtherCritical, hbackOut, _hfurtherOut⟩ :=
    eight_two_exists_two_backward_shifts_local shiftedCtx hshiftedCenter (by
      change 1 < shifted.length
      omega)
  let r := Γ.act actor⁻¹ back
  have hinverse (vertex : Γ.Vertex) : Γ.act actor⁻¹ (Γ.act actor vertex) = vertex := by
    rw [← Γ.act_mul, mul_inv_cancel, Γ.act_one]
  have hract : Γ.act actor r = back := by
    dsimp only [r]
    rw [← Γ.act_mul, inv_mul_cancel, Γ.act_one]
  have hr : r ∈ neighborhood Γ n := by
    apply (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr
    have hadj := adjacent_act Γ actor⁻¹
      ((SevenSix.mem_neighborhood_iff_adjacent Γ).mp hback)
    change Γ.adjacent (Γ.act actor⁻¹ shifted.a) r at hadj
    simpa only [hstart, hinverse] using hadj
  have hgen : (stabilizer Γ n ⊓ stabilizer Γ r) ⊔ z Γ cp.a = stabilizer Γ n := by
    apply Subgroup.map_injective (f := (MulAut.conj actor⁻¹).toMonoidHom)
      (MulAut.conj actor⁻¹).injective
    rw [Subgroup.map_sup, Subgroup.map_inf _ _ _ (MulAut.conj actor⁻¹).injective]
    change (stabilizer Γ shifted.a ⊓ stabilizer Γ back) ⊔ z Γ shifted.a' =
      stabilizer Γ shifted.a at hbackGen
    rw [hstart, hend, ← hract, stabilizer_act, stabilizer_act, z_act] at hbackGen
    exact hbackGen
  have hout : ¬ z Γ r ≤ stabilizer Γ cp.a := by
    intro hle
    apply hbackOut
    change z Γ back ≤ stabilizer Γ shifted.a'
    rw [hend, ← hract, z_act, stabilizer_act]
    exact Subgroup.map_mono hle
  have hpenult : shifted.path ⟨shifted.length - 1, by omega⟩ = Γ.act actor m := by
    rw [← hfirst, ← shifted.path_first]
    apply congrArg shifted.path
    apply Fin.ext
    dsimp
    omega
  have hnot : ¬ z Γ r ≤ q Γ m := by
    intro hle
    apply hbackCritical.2
    change z Γ back ≤ q Γ (shifted.path ⟨shifted.length - 1, by omega⟩)
    rw [hpenult, ← hract, z_act, SevenSix.q_act]
    exact Subgroup.map_mono hle
  have hdist : Γ.distance r m ≤ 2 := by
    let route : Fin 3 → Γ.Vertex := Fin.cases r (Fin.cases n (fun _ => m))
    have hadj : ∀ i : Fin 2, Γ.adjacent (route i.castSucc) (route i.succ) := by
      intro i
      fin_cases i
      · exact Γ.adjacent_symm ((SevenSix.mem_neighborhood_iff_adjacent Γ).mp hr)
      · exact Γ.adjacent_symm ((SevenSix.mem_neighborhood_iff_adjacent Γ).mp hn)
    exact Γ.distance_le_of_path 2 route hadj
  have hcritical : IsCriticalPair Γ r m := by
    have heq : Γ.distance r m = cp.length := by
      apply le_antisymm (by omega)
      by_contra hlt
      exact hnot (SevenSix.critical_minimality Γ cp (by omega))
    refine ⟨?_, hnot⟩
    rw [heq, ← cp.endpoint_distance]
    exact cp.critical.1
  have hZrVn : z Γ r ≤ v Γ n := by
    rw [v, Γ.vAt_def]
    exact le_sSup ⟨r, hr, rfl⟩
  exact ⟨r, hr, hgen, hcritical, hout, fun hV => hnot (hZrVn.trans hV)⟩

end Stellmacher.SectionEight
