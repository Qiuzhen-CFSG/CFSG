module
public import Stellmacher.SectionEight.GeneratedEightSixNextVGeometry
public import Stellmacher.SectionOne.LemmaOneTwo
public import Stellmacher.SectionEight.GeneratedEightSixCoreQuotientBounds
public import Theory.GroupAction.QuotientFixedGeneration

/-!
# The actual next quotient module in Stellmacher (8.6)

At critical distance two, the next neighbor-generated group modulo its vertex
center is elementary abelian. The next stabilizer acts on this literal quotient
by conjugation, its two-core lies in the kernel, and the translates of the
edge-Sylow fixed subgroup generate the quotient under the faithful action image.

The first commutator identity puts the derived subgroup in the denominator.
The neighbor-generated group is generated by involutions, so its abelian quotient
has exponent two. The initial order-four center contains the next order-two
center; both are normalized by the edge Sylow, so the initial center quotient
is fixed. Its conjugates generate the full quotient, proving fixed generation.
The ordinary next two-core acts trivially by the same commutator identity.

Source: Stellmacher (8.6), Journal of Algebra 190 (1997), printed pp.41–42,
the definition of V and source-(5). This supplies the exact module on which
the hereditary Section One fixed-hyperplane theorem is applied.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
open scoped commutatorElement
universe u

private theorem seed_commutator_le_line
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4) :
    ⁅ZAt ctx.Γ ctx.criticalPath.a, S⁆ ≤ ZAt ctx.Γ ctx.criticalPath.firstStep := by
  obtain ⟨hlineCard, hlineLe⟩ := eight_six_first_step_fixed_line_local ctx hcenter hcard
  have hindex : ((ZAt ctx.Γ ctx.criticalPath.firstStep).subgroupOf
      (ZAt ctx.Γ ctx.criticalPath.a)).index = 2 := by
    have hprod := ((ZAt ctx.Γ ctx.criticalPath.firstStep).subgroupOf
      (ZAt ctx.Γ ctx.criticalPath.a)).card_mul_index
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hlineLe).toEquiv,
      hlineCard, hcard] at hprod
    omega
  exact eight_six_commutator_le_of_line_index_two _ _ _ hindex
    ((SevenSix.edge_sylow_data ctx.sectionSeven ctx.Γ ctx.criticalPath).1.1.trans
      (stabilizer_le_normalizer_z ctx.Γ ctx.criticalPath.a))
    ((SevenSix.edge_sylow_data ctx.sectionSeven ctx.Γ ctx.criticalPath).2.1.trans
      (stabilizer_le_normalizer_z ctx.Γ ctx.criticalPath.firstStep))

public theorem eight_six_next_quotient_module_data_local
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hlength : ctx.criticalPath.length = 2)
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4)
    (hcomm : ⁅VAt ctx.Γ ctx.criticalPath.firstStep,
      QAt ctx.Γ ctx.criticalPath.firstStep⁆ = ZAt ctx.Γ ctx.criticalPath.firstStep) :
    let P := GAt ctx.Γ ctx.criticalPath.firstStep
    let V := VAt ctx.Γ ctx.criticalPath.firstStep
    let Z := ZAt ctx.Γ ctx.criticalPath.firstStep
    ∃ hN : (Z.subgroupOf V).Normal,
      let _ := hN
      IsElementaryAbelian 2 (V ⧸ Z.subgroupOf V) ∧
      ∃ action : P →* MulAut (V ⧸ Z.subgroupOf V),
        (∀ actor : P, ∀ point : V,
          action actor (QuotientGroup.mk' (Z.subgroupOf V) point) =
            QuotientGroup.mk' (Z.subgroupOf V)
              ⟨(actor : G) * (point : G) * (actor : G)⁻¹,
                (Subgroup.mem_normalizer_iff.mp
                  (stabilizer_le_normalizer_v ctx.Γ ctx.criticalPath.firstStep actor.property) point).mp
                    point.property⟩) ∧
        pCore 2 P ≤ action.ker ∧
        (⊤ : Subgroup (V ⧸ Z.subgroupOf V)) =
          SectionOne.actionClosure action.range (V ⧸ Z.subgroupOf V)
            (FixedPoints.subgroup ((S.subgroupOf P).map action.rangeRestrict)
              (V ⧸ Z.subgroupOf V)) := by
  let P := GAt ctx.Γ ctx.criticalPath.firstStep
  let V := VAt ctx.Γ ctx.criticalPath.firstStep
  let Z := ZAt ctx.Γ ctx.criticalPath.firstStep
  have hPV : P ≤ Subgroup.normalizer (V : Set G) :=
    stabilizer_le_normalizer_v ctx.Γ ctx.criticalPath.firstStep
  have hPZ : P ≤ Subgroup.normalizer (Z : Set G) :=
    stabilizer_le_normalizer_z ctx.Γ ctx.criticalPath.firstStep
  have hVQ : V ≤ QAt ctx.Γ ctx.criticalPath.firstStep :=
    SevenSix.neighbor_join_le_core_of_length_gt_one ctx.Γ ctx.criticalPath (by omega) _
  have hVP : V ≤ P := hVQ.trans (by
    change ctx.Γ.twoCoreAt _ ≤ _
    rw [ctx.Γ.twoCoreAt_def]
    exact Subgroup.map_subtype_le _)
  have hN : (Z.subgroupOf V).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer (hVP.trans hPZ)
  let _ := hN
  have hVV : ⁅V, V⁆ ≤ Z := (Subgroup.commutator_mono le_rfl hVQ).trans_eq hcomm
  have hderived : _root_.commutator V ≤ Z.subgroupOf V := by
    intro v hv
    apply hVV
    have hm : (_root_.commutator V).map V.subtype = ⁅V, V⁆ := by
      rw [_root_.commutator_def, Subgroup.map_commutator,
        ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    exact hm ▸ Subgroup.mem_map_of_mem V.subtype hv
  have habelian : IsMulCommutative (V ⧸ Z.subgroupOf V) :=
    (Subgroup.Normal.quotient_commutative_iff_commutator_le (N := Z.subgroupOf V)).mpr hderived
  have hsquares : ∀ v ∈ V, v ^ 2 ∈ Z := by
    apply eight_six_squares_of_involution_join
      {Z' | ∃ neighbor ∈ neighborhood ctx.Γ ctx.criticalPath.firstStep,
        Z' = z ctx.Γ neighbor} V Z (ctx.Γ.vAt_def _) (hVP.trans hPZ) hVV
    rintro subgroup ⟨neighbor, hneighbor, rfl⟩ v hv
    let _ := SevenSix.z_isElementaryAbelian_of_neighbor ctx.sectionSeven ctx.Γ
      ((SevenSix.mem_neighborhood_iff_adjacent ctx.Γ).mpr
        (ctx.Γ.adjacent_symm ((SevenSix.mem_neighborhood_iff_adjacent ctx.Γ).mp hneighbor)))
    rw [elemPow_eq_one_of_isElementaryAbelian v hv]
    exact Z.one_mem
  have hW : IsElementaryAbelian 2 (V ⧸ Z.subgroupOf V) := {
    toIsMulCommutative := habelian
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (by
      intro point
      obtain ⟨v, rfl⟩ := QuotientGroup.mk'_surjective (Z.subgroupOf V) point
      rw [← map_pow]
      exact (QuotientGroup.eq_one_iff _).mpr (hsquares v v.property)) }
  obtain ⟨action, haction⟩ := Subgroup.exists_quotient_conjugation_action P V Z hPV hPZ hN
  refine ⟨hN, hW, action, haction, ?_, ?_⟩
  · have hkill := Subgroup.quotient_conjugation_action_kills_commutator_layer
      P V Z (QAt ctx.Γ ctx.criticalPath.firstStep) hN hPV hcomm.le action haction
    have hcore : (QAt ctx.Γ ctx.criticalPath.firstStep).subgroupOf P = pCore 2 P := by
      change (ctx.Γ.twoCoreAt _).subgroupOf P = _
      rw [ctx.Γ.twoCoreAt_def]
      exact Subgroup.comap_map_eq_self_of_injective P.subtype_injective _
    exact hcore ▸ hkill
  · have hfirst := (lemma_seven_four ctx.sectionSeven ctx.Γ ctx.criticalPath).first_containment.1
    have hback : ctx.criticalPath.a ∈ neighborhood ctx.Γ ctx.criticalPath.firstStep :=
      (SevenSix.mem_neighborhood_iff_adjacent ctx.Γ).mpr (ctx.Γ.adjacent_symm ctx.criticalPath.firstStep_adj)
    have hclosure := eight_six_neighbor_join_eq_conjugate_closure ctx.sectionSeven ctx.Γ
      ctx.criticalPath.firstStep ctx.criticalPath.a hback
    exact Subgroup.quotient_fixed_generation_of_conjugate_closure P V Z (ZAt ctx.Γ ctx.criticalPath.a) S hPV
      (SevenSix.edge_sylow_data ctx.sectionSeven ctx.Γ ctx.criticalPath).2.1 hfirst hclosure
      (seed_commutator_le_line ctx hcenter hcard) hN action haction

end Stellmacher.SectionEight
