module

public import Stellmacher.SectionFiveToSeven.VertexLocalModule
public import Stellmacher.QuotientModuleWitness
public import Stellmacher.SectionOne.LemmaOneTwo

/-!
# Sylow fixed-space generation for a local quotient module

For any vertex and any supplied Sylow two-subgroup of its stabilizer, the
local centralizer quotient module is generated by the quotient translates
of the Sylow image's fixed space. The exact quotient-module witness supplies
the group and action instances throughout.

The graph vertex subgroup is the ambient image of the normal closure of
the supplied Sylow's omega center. That omega center is fixed by the Sylow.
Every conjugate generator of its normal closure is therefore a translate
of a Sylow-fixed vector, by the witness's conjugation compatibility. Taking
closures proves the generation statement. No critical path or classification
hypothesis is required.

This is the local fixed-space generation input for Stellmacher (1.2) in
(9.3), Journal of Algebra 190 (1997), p.49, relation (2); the identification
of the vertex center is the Section Seven notation on p.33.
Source: `refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
universe u

/-- The original vertex module is generated by the fixed space of the image
of any supplied local Sylow subgroup, under the supplied quotient action. -/
public theorem local_quotient_fixed_sylow_generation
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (Γ : CosetGraphContext G S P1 P2) (d : Γ.Vertex)
    (w : QuotientModuleWitness (GAt Γ d)
      (GAt Γ d ⊓ Subgroup.centralizer (ZAt Γ d : Set G)) (ZAt Γ d))
    (U : Sylow 2 (GAt Γ d)) :
    let _ := w.groupX
    let _ := MulDistribMulAction.compHom (ZAt Γ d) w.action
    (⊤ : Subgroup (ZAt Γ d)) = SectionOne.actionClosure w.X (ZAt Γ d)
      (FixedPoints.subgroup ((U : Subgroup (GAt Γ d)).map w.projection) (ZAt Γ d)) := by
  let := w.groupX
  let := MulDistribMulAction.compHom (ZAt Γ d) w.action
  let P := GAt Γ d
  let V := ZAt Γ d
  let F := FixedPoints.subgroup ((U : Subgroup P).map w.projection) V
  let C := SectionOne.actionClosure w.X V F
  change (⊤ : Subgroup V) = C
  have hV : (SectionTwo.vSubgroup U).map P.subtype = V :=
    vertexZ_eq_local_vSubgroup Γ d U
  have hlocal : SectionTwo.vSubgroup U ≤ (C.map V.subtype).comap P.subtype := by
    change Subgroup.normalClosure (omegaOneCenterAmbient (U : Subgroup P) : Set P) ≤ _
    rw [Subgroup.normalClosure]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    obtain ⟨y, hy, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨g, hg⟩ := isConj_iff.mp hconj
    have hyV : (y : G) ∈ V := by
      rw [← hV]
      exact Subgroup.mem_map_of_mem P.subtype (Subgroup.le_normalClosure hy)
    let v : V := ⟨y, hyV⟩
    have hvF : v ∈ F := by
      rw [FixedPoints.mem_subgroup]
      intro a
      obtain ⟨t, ht, hat⟩ := a.property
      apply Subtype.ext
      change ((w.action (a : w.X)) v : G) = (v : G)
      rw [← hat, w.action_compatible]
      have hcomm : t * y = y * t :=
        ((mem_omegaOneCenterAmbient_iff (U : Subgroup P) y).mp hy).2.2 t ht
      have hamb := congrArg Subtype.val hcomm
      change (t : G) * (y : G) = (y : G) * (t : G) at hamb
      change (t : G) * (y : G) * (t : G)⁻¹ = (y : G)
      rw [hamb, mul_inv_cancel_right]
    have htranslate : w.projection g • v ∈ C :=
      Subgroup.subset_closure ⟨w.projection g, v, hvF, rfl⟩
    refine ⟨w.projection g • v, htranslate, ?_⟩
    change ((w.action (w.projection g)) v : G) = (x : G)
    rw [w.action_compatible]
    exact congrArg Subtype.val hg
  have hVC : V ≤ C.map V.subtype :=
    hV.ge.trans (Subgroup.map_le_iff_le_comap.mpr hlocal)
  apply le_antisymm ?_ le_top
  intro v _
  obtain ⟨v', hv', heq⟩ := hVC v.property
  have hv : v' = v := Subtype.ext heq
  exact hv ▸ hv'

end Stellmacher.SectionEight
