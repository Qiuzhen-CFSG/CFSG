module
public import Stellmacher.SectionEight.LemmaEightOne

/-!
# A noncentral four-element factor of the initial center

In a noncommuting Section Eight critical pair, the initial center contains
a subgroup of order four that does not centralize the opposite center.
This is the choice of V1 immediately before source (5) in Stellmacher (8.4),
Journal of Algebra 190 (1997), printed pp.38–39,
`refs/files/stellmacher-n-group.pdf`.

Apply (8.1) with its own exact quotient-module witness. The initial center
is generated by its four-element factors and the fixed factor V0. The
opposite-center image lies in J. For each opposite-center element, lift
its image to the displayed J-lift; witness compatibility shows the two
elements induce exactly the same conjugation action on the initial center.
Since the J-lift centralizes V0, so does the opposite center. Hence some
four-element factor must fail to centralize the opposite center, or the
whole initial center would commute with it. Neither the central-first-step
hypothesis nor the later (8.4) normality conclusion is needed here.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
universe u

/-- A four-element factor of the initial center acts nontrivially on the opposite center. -/
public theorem eight_four_noncentral_four
    {H : Type u} [Group H] [Finite H]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    (ctx : SectionEightContext H S0 S P1 P2) :
    ∃ A : Subgroup H, A ≤ ZAt ctx.Γ ctx.criticalPath.a ∧ Nat.card A = 4 ∧
      ⁅A, ZAt ctx.Γ ctx.criticalPath.a'⁆ ≠ ⊥ := by
  classical
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let P := stabilizer Γ cp.a
  let Za := z Γ cp.a
  let Zb := z Γ cp.a'
  obtain ⟨w, hw⟩ := (lemma_eight_one ctx).barred_decomposition
  let := w.groupX
  let := w.finiteX
  let := MulDistribMulAction.compHom Za w.action
  obtain ⟨r, D, Dl, V, V0, J, Jl, hJlift, hJ, _hDlift,
    _hDgen, _hDprod, _hDmodel, hVgen, _hVprod, hV0, hVcard, _hRgen, _hRprod⟩ := hw
  have hZbP : Zb ≤ P :=
    (lemma_seven_four
      (ctx.hypothesisTwo.sectionSevenHypotheses ctx.generated) Γ cp).reverse_containment.1
  have hZbJ : (Zb.subgroupOf P).map w.projection ≤ J := by
    rw [hJ]
    exact le_sSup (lemma_eight_one_offender ctx w).1
  have hV0central : V0 ≤ Subgroup.centralizer (Zb : Set H) := by
    intro x hx
    have hx0 := hV0 ▸ hx
    let point : Za := ⟨x, hx0.1⟩
    rw [Subgroup.mem_centralizer_iff]
    intro b hb
    let actor : P := ⟨b, hZbP hb⟩
    have hJactor := hZbJ (Subgroup.mem_map_of_mem w.projection (show actor ∈ Zb.subgroupOf P from hb))
    rw [hJlift] at hJactor
    obtain ⟨j, hj, hjeq⟩ := hJactor
    have hcomm : (j : H) * x = x * (j : H) :=
      Subgroup.mem_centralizer_iff.mp hx0.2 (j : H)
        ((show Jl.map P.subtype ≤ EAt Γ cp.a ⊔ Jl.map P.subtype from le_sup_right)
          (Subgroup.mem_map_of_mem P.subtype hj))
    have heq := congrArg (fun a => ((w.action a) point : H)) hjeq
    rw [w.action_compatible, w.action_compatible] at heq
    have hjfix : (j : H) * x * (j : H)⁻¹ = x := by
      rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
    change (j : H) * x * (j : H)⁻¹ = b * x * b⁻¹ at heq
    rw [hjfix] at heq
    exact (mul_inv_eq_iff_eq_mul.mp heq.symm)
  have hnoncentral : ∃ i : Fin r, ⁅V i, Zb⁆ ≠ ⊥ := by
    by_contra hnone
    have hall : ∀ i : Fin r, V i ≤ Subgroup.centralizer (Zb : Set H) := by
      intro i
      apply Subgroup.commutator_eq_bot_iff_le_centralizer.mp
      by_contra hne
      exact hnone ⟨i, hne⟩
    apply ctx.commutator_ne
    apply Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
    change ZAt ctx.Γ ctx.criticalPath.a ≤ Subgroup.centralizer (Zb : Set H)
    rw [hVgen]
    exact sup_le hV0central (iSup_le hall)
  obtain ⟨i, hi⟩ := hnoncentral
  exact ⟨V i, (le_iSup V i).trans (le_sup_right.trans_eq hVgen.symm), hVcard i, hi⟩

end Stellmacher.SectionEight
