module

public import Stellmacher.SectionEight.GeneratedContext
public import Stellmacher.SectionEight.LemmaEightOneOffender
public import Stellmacher.SectionEight.LocalQuotientSylowActionSetup
public import Stellmacher.SectionOne.LemmaOneSeven
public import Stellmacher.DihedralThreePowerCoreQuotient
public import Theory.Representation.CardFourTwoGroupImage

/-!
# The four-element center action over a local Section Eight context

The order-four step of Stellmacher (8.5) determines the faithful action
quotient and the actual initial two-core quotient using only the local
Section Seven hypotheses and noncommuting critical endpoints. Hypothesis
Two is not imposed on the group generated by the two local subgroups.
The imported local offender endpoint remains re-exported under its original
name; its proof is now owned by `LemmaEightOneOffender` below this recognition
step.

The terminal center gives a nontrivial offender for each exact quotient
witness. The Section One decomposition therefore has an SL2(2) factor.
Faithfulness on a four-element center bounds the whole quotient's order
by six, so this factor is the whole quotient. The edge-centralizer formula
then transfers its Sylow order to the actual Sylow/core relative index,
and the local unique-maximal data give the ordinary dihedral core quotient.

This is the order-four recognition bridge in the first proof paragraph of
(8.5), printed p.40 of `refs/files/stellmacher-n-group.pdf`. It does not
prove the order-four premise, the equality of the two quotient kernels,
or the critical distance. Generated contexts use their graph-preserving
`toLocalContext` adapter. No ambient Sylow parameter is needed here.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
open scoped IsMulCommutative
universe u

private theorem faithful_four_card_bound
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [IsElementaryAbelian 2 V] [MulDistribMulAction G V]
    (hfaithful : Function.Injective (MulDistribMulAction.toMulAut G V))
    (hcard : Nat.card V = 4) : Nat.card G ≤ 6 := by
  classical
  let representation := Representation.ofElementaryAbelianAction (A := G) (G := V) (p := 2)
  have hinj : Function.Injective representation.asGroupHom := by
    rw [← MonoidHom.ker_eq_bot_iff]
    apply bot_unique
    intro actor hactor
    have heq : representation actor = 1 := congrArg Units.val (MonoidHom.mem_ker.mp hactor)
    apply hfaithful
    ext point
    change actor • point = (1 : G) • point
    rw [one_smul]
    apply Additive.ofMul.injective
    have hpoint := LinearMap.congr_fun heq (Additive.ofMul point)
    simpa only [representation, Representation.ofElementaryAbelianAction_apply_ofMul,
      Module.End.one_apply] using hpoint
  have hdim : Module.finrank (ZMod 2) (Additive V) = 2 := by
    have hc : Nat.card (Additive V) = 4 := (Nat.card_congr Additive.toMul).trans hcard
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2)] at hc
    norm_num at hc
    exact Nat.pow_right_injective (by omega : 1 < 2) hc
  let basis : Module.Basis (Fin 2) (ZMod 2) (Additive V) :=
    Module.finBasisOfFinrankEq (ZMod 2) (Additive V) hdim
  let linear : G →* Matrix.GeneralLinearGroup (Fin 2) (ZMod 2) :=
    (Matrix.GeneralLinearGroup.toLin' basis).symm.toMonoidHom.comp representation.asGroupHom
  have hlinear := (Matrix.GeneralLinearGroup.toLin' basis).symm.injective.comp hinj
  have hdiv := Subgroup.card_dvd_of_injective linear hlinear
  have hGL : Nat.card (Matrix.GeneralLinearGroup (Fin 2) (ZMod 2)) = 6 := by
    rw [Matrix.card_GL_field]
    norm_num [Fin.prod_univ_succ]
  rw [hGL] at hdiv
  exact Nat.le_of_dvd (by decide) hdiv

/-- Every exact faithful initial-center action is SL2(2) when that center
has four elements, without an ambient Hypothesis Two parameter. -/
public theorem eight_five_action_of_card_four_local
    {H : Type u} [Group H] [Finite H] {S P1 P2 : Subgroup H}
    (ctx : SectionEightLocalContext H S P1 P2)
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4)
    (w : QuotientModuleWitness (GAt ctx.Γ ctx.criticalPath.a)
      (GAt ctx.Γ ctx.criticalPath.a ⊓
        Subgroup.centralizer (ZAt ctx.Γ ctx.criticalPath.a : Set H))
      (ZAt ctx.Γ ctx.criticalPath.a)) :
    let _ := w.groupX
    let _ := w.finiteX
    IsSL2Two w.X := by
  classical
  let := w.groupX
  let := w.finiteX
  let := MulDistribMulAction.compHom (ZAt ctx.Γ ctx.criticalPath.a) w.action
  have hfirst : ctx.criticalPath.firstStep ∈ neighborhood ctx.Γ ctx.criticalPath.a :=
    (SevenSix.mem_neighborhood_iff_adjacent ctx.Γ).mpr ctx.criticalPath.firstStep_adj
  let := SevenSix.z_isElementaryAbelian_of_neighbor ctx.sectionSeven ctx.Γ hfirst
  have hlocal := (local_quotient_sylow_action_setup ctx.sectionSeven ctx.Γ
    ctx.criticalPath w).1
  obtain ⟨_, sylow, hsylow⟩ :=
    (SevenSix.edge_local_data ctx.sectionSeven ctx.Γ ctx.criticalPath).1.1.1.2.1
  have hSP : S ≤ GAt ctx.Γ ctx.criticalPath.a :=
    ctx.criticalPath.S_le_edge_stabilizers.trans inf_le_left
  have hnative : (sylow : Subgroup (GAt ctx.Γ ctx.criticalPath.a)) =
      S.subgroupOf (GAt ctx.Γ ctx.criticalPath.a) := by
    apply Subgroup.map_injective (GAt ctx.Γ ctx.criticalPath.a).subtype_injective
    rw [Subgroup.map_subgroupOf_eq_of_le hSP]
    exact hsylow
  let quotientSylow := sylow.mapSurjective w.surjective
  have hJne : SectionOne.oneJ (V := ZAt ctx.Γ ctx.criticalPath.a)
      (quotientSylow : Subgroup w.X) ≠ ⊥ := by
    change SectionOne.oneJ (V := ZAt ctx.Γ ctx.criticalPath.a)
      ((sylow : Subgroup (GAt ctx.Γ ctx.criticalPath.a)).map w.projection) ≠ ⊥
    rw [hnative]
    exact (eight_five_offender_local ctx w).2
  obtain ⟨rank, factors, modules, hproduct, hSL, _hmodules, _hmoduleProduct⟩ :=
    (SectionOne.lemma_one_seven hlocal quotientSylow hJne).part_c
  have hrank : 0 < rank := by
    by_contra hzero
    have hempty : (⨆ index : Fin rank, factors index) = ⊥ := by
      apply bot_unique
      refine iSup_le fun index => ?_
      have := index.isLt
      omega
    have hEbot := hproduct.1
    rw [hempty] at hEbot
    apply hJne
    apply bot_unique
    rw [← hEbot]
    exact Subgroup.le_normalClosure
  let first : Fin rank := ⟨0, hrank⟩
  have hfaithful : Function.Injective
      (MulDistribMulAction.toMulAut w.X (ZAt ctx.Γ ctx.criticalPath.a)) := by
    intro left right heq
    apply w.action_injective
    ext point
    exact congrArg Subtype.val (DFunLike.congr_fun heq point)
  have hbound : Nat.card w.X ≤ 6 := faithful_four_card_bound hfaithful hcard
  have hfactor : Nat.card (factors first) = 6 :=
    SectionOne.RankOneThreeGroupAssembly.isSL2Two_card (hSL first)
  have htop : factors first = ⊤ := by
    apply Subgroup.eq_top_of_card_eq
    exact le_antisymm (Subgroup.card_le_card_group _) (by omega)
  obtain ⟨equiv⟩ := hSL first
  rw [htop] at equiv
  exact ⟨Subgroup.topEquiv.symm.trans equiv⟩

/-- The local order-four center gives the actual dihedral two-core quotient
as well as SL2(2) for every exact faithful center-action witness. -/
public theorem eight_five_dihedral_action_of_card_four_local
    {H : Type u} [Group H] [Finite H] {S P1 P2 : Subgroup H}
    (ctx : SectionEightLocalContext H S P1 P2)
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4) :
    (∃ exponent : ℕ, Nonempty
      ((GAt ctx.Γ ctx.criticalPath.a ⧸ pCore 2 (GAt ctx.Γ ctx.criticalPath.a)) ≃*
        DihedralGroup (3 ^ exponent))) ∧
    (∀ w : QuotientModuleWitness (GAt ctx.Γ ctx.criticalPath.a)
      (GAt ctx.Γ ctx.criticalPath.a ⊓
        Subgroup.centralizer (ZAt ctx.Γ ctx.criticalPath.a : Set H))
      (ZAt ctx.Γ ctx.criticalPath.a),
      let _ := w.groupX
      let _ := w.finiteX
      IsSL2Two w.X) := by
  classical
  let hyp := ctx.sectionSeven
  let graph := ctx.Γ
  let path := ctx.criticalPath
  let initial := GAt graph path.a
  have hfirst : path.firstStep ∈ neighborhood graph path.a :=
    (SevenSix.mem_neighborhood_iff_adjacent graph).mpr path.firstStep_adj
  have hcenterCore : ZAt graph path.a ≤ QAt graph path.a :=
    ((lemma_seven_three hyp graph).center_core path.a path.firstStep hfirst).trans
      (Subgroup.map_subtype_le _)
  have hcoreInitial : QAt graph path.a ≤ initial := by
    change graph.twoCoreAt path.a ≤ _
    rw [graph.twoCoreAt_def]
    exact Subgroup.map_subtype_le _
  obtain ⟨w⟩ := exists_quotientModuleWitness initial (ZAt graph path.a)
    (hcenterCore.trans hcoreInitial) (stabilizer_le_normalizer_z graph path.a)
  let := w.groupX
  let := w.finiteX
  have haction := eight_five_action_of_card_four_local ctx hcard w
  have hinitial := (SevenSix.edge_local_data hyp graph path).1
  obtain ⟨_, sylow, hsylow⟩ := hinitial.1.1.2.1
  have hSP : S ≤ initial := path.S_le_edge_stabilizers.trans inf_le_left
  have hnative : (sylow : Subgroup initial) = S.subgroupOf initial := by
    apply Subgroup.map_injective initial.subtype_injective
    rw [Subgroup.map_subgroupOf_eq_of_le hSP]
    exact hsylow
  let imageSylow := sylow.mapSurjective w.surjective
  have himage : Nat.card imageSylow = 2 := by
    rw [imageSylow.card_eq_multiplicity,
      SectionOne.RankOneThreeGroupAssembly.isSL2Two_card haction]
    have hfactorization : Nat.factorization 6 2 = 1 := by
      change Nat.factorization (3 * 2) 2 = 1
      rw [Nat.factorization_mul (by decide) (by decide)]
      norm_num [Nat.prime_two.factorization, Nat.prime_three.factorization]
    simp [hfactorization]
  have hkernel : (sylow : Subgroup initial) ⊓ w.projection.ker = pCore 2 initial := by
    apply Subgroup.map_injective initial.subtype_injective
    rw [Subgroup.map_inf _ _ _ initial.subtype_injective, hsylow, w.kernel_eq,
      Subgroup.map_subgroupOf_eq_of_le inf_le_left]
    have hcentralizer := (lemma_seven_four hyp graph path).edge_centralizer
    change S ⊓ (initial ⊓ Subgroup.centralizer (ZAt graph path.a : Set H)) =
      twoCoreIn initial
    rw [← inf_assoc, inf_eq_left.mpr hSP]
    change S ⊓ Subgroup.centralizer (ZAt graph path.a : Set H) =
      (pCore 2 (graph.stabilizer path.a)).map (graph.stabilizer path.a).subtype
    change S ⊓ Subgroup.centralizer (ZAt graph path.a : Set H) =
      graph.twoCoreAt path.a at hcentralizer
    rw [graph.twoCoreAt_def] at hcentralizer
    exact hcentralizer
  have hindex : (pCore 2 initial).relIndex (sylow : Subgroup initial) = 2 := by
    rw [← hkernel, Subgroup.inf_relIndex_left, Subgroup.relIndex_ker]
    exact himage
  have hcore : pCore 2 initial ≠ ⊥ := by
    intro hbot
    apply hinitial.1.1.2.2.1
    change (pCore 2 initial).map initial.subtype = ⊥
    rw [hbot, Subgroup.map_bot]
  have hunique : IsUniqueMaximalContaining (sylow : Subgroup initial)
      (⊤ : Subgroup initial) := by
    obtain ⟨_, maximal, hmaximal, hcontains, hunique⟩ := hinitial.1.2
    let equiv := (Subgroup.topEquiv : (⊤ : Subgroup initial) ≃* initial)
    refine ⟨maximal.comap equiv.toMonoidHom, (Subgroup.isCoatom_comap equiv).mpr hmaximal,
      ?_, ?_⟩
    · intro element helement
      refine ⟨⟨element, Subgroup.mem_top _⟩, ?_, rfl⟩
      exact hcontains (hnative ▸ helement)
    · intro other hother hotherContains
      have heq : other.map equiv.toMonoidHom = maximal := by
        apply hunique _ ((OrderIso.isCoatom_iff equiv.mapSubgroup other).mpr hother)
        intro element helement
        exact hotherContains (hnative.symm ▸ helement)
      rw [← heq]
      exact (Subgroup.comap_map_eq_self_of_injective equiv.injective other).symm
  exact ⟨dihedral_three_power_core_quotient hinitial.2 sylow hcore hunique hindex
    w.projection w.surjective haction, eight_five_action_of_card_four_local ctx hcard⟩

end Stellmacher.SectionEight
