module
public import Stellmacher.SectionEight.EightSixSelectedSmallCompetitor
public import Stellmacher.SectionEight.EightSixSelectedOrbitFirstCommutator

/-!
# Minimal actor cost forbids a supported/fixed split in (8.6)

The actual minimizing actor in the large-index branch prevents the next
module from being generated by the selected center orbit and its
two-residual-fixed subgroup. The companion theorem identifies its active
commutator line, joined with the next center, with the initial center.

The selected coatom centralizes the orbit modulo the next line. Its index
two and the actor's escape give the same nonzero orbit action for the
selected actor as for all predecessor actors. A proposed split supplies a
coatom actor of cost at most two. Minimality then forces the full selected
commutator into the initial center. Its fixed-part commutator also lies in
V0, so V0∩D=Znext puts it in the next line. The fixed part must cross the
initial core; the source-(4) subgroup-forcing theorem consequently puts
the selected actor in D, contradicting its escape from the next core.

Source: Stellmacher (8.6), printed p.43, the minimality contradiction in
the paragraph proving assertion (13), `refs/files/stellmacher-n-group.pdf`.
The implication from a transvection to the forbidden split is a separate
module argument; no transvection or split is assumed in these conclusions.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
open scoped commutatorElement Pointwise
universe u

private theorem commutator_le_of_coatom_actor
    {G : Type*} [Group G] (U A A0 Z : Subgroup G)
    (hAZ : A ≤ Subgroup.normalizer (Z : Set G))
    (hindex : (A0.subgroupOf A).index = 2)
    (actor : G) (ha : actor ∈ A) (hout : actor ∉ A0)
    (hfirst : ⁅U,A0⁆ ≤ Z) (hsecond : ⁅U,Subgroup.zpowers actor⁆ ≤ Z) :
    ⁅U,A⁆ ≤ Z := by
  apply Subgroup.commutator_le.mpr
  intro point hpoint mover hmover
  by_cases hmover0 : mover ∈ A0
  · exact hfirst (Subgroup.commutator_mem_commutator hpoint hmover0)
  have hfactor : mover * actor⁻¹ ∈ A0 := by
    have hh := (A0.subgroupOf A).mul_mem_iff_of_index_two hindex
      (a := ⟨mover, hmover⟩) (b := ⟨actor⁻¹, A.inv_mem ha⟩)
    exact hh.mpr (by simp only [Subgroup.mem_subgroupOf, Subgroup.inv_mem_iff,
      hmover0, hout])
  have heq : mover = (mover * actor⁻¹) * actor := by group
  rw [heq, commutatorElement_mul_right_eq_mul_conj]
  have hleft := hfirst (Subgroup.commutator_mem_commutator hpoint hfactor)
  have hright := hsecond (Subgroup.commutator_mem_commutator hpoint
    (Subgroup.mem_zpowers actor))
  simpa only [mul_assoc] using Z.mul_mem hleft ((Subgroup.mem_normalizer_iff.mp
    (hAZ (A.mul_mem hmover (A.inv_mem ha))) _).mp hright)


public theorem eight_six_selected_actor_active_line
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hquot : QuotientIsModel (GAt ctx.Γ ctx.criticalPath.a)
      (QAt ctx.Γ ctx.criticalPath.a) SL2Two)
    (hlength : ctx.criticalPath.length = 2)
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4)
    (previous : ctx.Γ.Vertex) (D L Q : Subgroup G)
    (hprev : previous ∈ Neighborhood ctx.Γ ctx.criticalPath.a ∧
      previous ≠ ctx.criticalPath.firstStep)
    (data : EightSixEquationOneData ctx.Γ ctx.criticalPath previous D L Q)
    (E A0 : Subgroup G) (actor : G)
    (geom : SectionNine.NineThreeGeometricData ctx.Γ
      ctx.criticalPath.firstStep ctx.criticalPath.a
      (VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a) E A0 actor)
    (hcore : conjugateClosure (ZAt ctx.Γ ctx.criticalPath.a) E ≤
      QAt ctx.Γ ctx.criticalPath.a)
    (hedge : E ⊔ (GAt ctx.Γ ctx.criticalPath.a ⊓ GAt ctx.Γ ctx.criticalPath.firstStep) =
      GAt ctx.Γ ctx.criticalPath.firstStep)
    (hD : D = QAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.firstStep)
    (hL : L = conjugateClosure (QAt ctx.Γ previous) (GAt ctx.Γ ctx.criticalPath.a))
    (ha : actor ∈ VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a) :
    ⁅conjugateClosure (ZAt ctx.Γ ctx.criticalPath.a) E,
      Subgroup.zpowers actor⁆ ⊔ ZAt ctx.Γ ctx.criticalPath.firstStep =
        ZAt ctx.Γ ctx.criticalPath.a := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let A := VAt Γ previous ⊓ QAt Γ cp.a
  let U := conjugateClosure (ZAt Γ cp.a) E
  let Z := ZAt Γ cp.firstStep
  let R := ⁅U,Subgroup.zpowers actor⁆
  have hAE : A ≤ E := geom.generated ▸ le_sup_left
  have hA0A : A0 ≤ A := geom.coatom_eq ▸ inf_le_left
  have hAZ : A ≤ Subgroup.normalizer (Z : Set G) :=
    (hAE.trans geom.group_le).trans (stabilizer_le_normalizer_z Γ cp.firstStep)
  have hcoatom : (A0.subgroupOf A).index = 2 := by
    have hp := (A0.subgroupOf A).index_mul_card
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hA0A).toEquiv] at hp
    have hcount : Nat.card A = 2 * Nat.card A0 := geom.coatom_card
    have hpos : 0 < Nat.card A0 := Nat.card_pos
    nlinarith
  have hout0 : actor ∉ A0 := by
    intro hmem
    exact geom.actor_outside (show actor ∈ GAt Γ (Γ.act geom.x⁻¹ cp.a) from
      (geom.coatom_eq ▸ hmem).2)
  have hU0 : ⁅U,A0⁆ ≤ Z := eight_six_selected_orbit_commutator_le ctx hcenter hcard
    E A0 geom.group_le (hA0A.trans inf_le_right) geom.coatom_commutator
  have hspan := eight_six_selected_orbit_commutator_sup_line ctx hcenter hquot hlength hcard
    previous D L Q hprev data E A0 actor geom hcore hedge hD hL
  have hline := eight_six_first_step_fixed_line_local ctx hcenter hcard
  have hZcard : Nat.card Z = 2 := hline.1
  have hRZa : R ≤ ZAt Γ cp.a :=
    (Subgroup.commutator_mono le_rfl (Subgroup.zpowers_le.mpr ha)).trans
      (le_sup_left.trans_eq hspan)
  have hnot : ¬ R ≤ Z := by
    intro hRZ
    have hUAZ := commutator_le_of_coatom_actor U A A0 Z hAZ hcoatom actor ha hout0 hU0 hRZ
    have hZaZ : ZAt Γ cp.a = Z := hspan.symm.trans (sup_eq_right.mpr hUAZ)
    have hc : Nat.card (ZAt Γ cp.a) = 2 := hZaZ ▸ hline.1
    change Nat.card (ZAt Γ cp.a) = 4 at hcard
    omega
  have hle : R ⊔ Z ≤ ZAt Γ cp.a := sup_le hRZa hline.2
  have hmore : 2 < Nat.card (R ⊔ Z : Subgroup G) := by
    have hb := Subgroup.card_le_of_le (show Z ≤ R ⊔ Z from le_sup_right)
    rw [hZcard] at hb
    by_contra hn
    have heq : Z = R ⊔ Z := Subgroup.eq_of_le_of_card_ge le_sup_right (by omega)
    exact hnot (le_sup_left.trans_eq heq.symm)
  have hdvd : Nat.card (R ⊔ Z : Subgroup G) ∣ 4 := hcard ▸ Subgroup.card_dvd_of_le hle
  have hfour : Nat.card (R ⊔ Z : Subgroup G) = 4 := by
    have hbound := Nat.le_of_dvd (by decide : 0 < 4) hdvd
    interval_cases hh : Nat.card (R ⊔ Z : Subgroup G) <;> omega
  exact Subgroup.eq_of_le_of_card_ge hle (by rw [hfour, hcard])


public theorem eight_six_selected_no_fixed_support_split
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hquot : QuotientIsModel (GAt ctx.Γ ctx.criticalPath.a)
      (QAt ctx.Γ ctx.criticalPath.a) SL2Two)
    (hlength : ctx.criticalPath.length = 2)
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4)
    (previous : ctx.Γ.Vertex) (D L Q : Subgroup G)
    (hprev : previous ∈ Neighborhood ctx.Γ ctx.criticalPath.a ∧
      previous ≠ ctx.criticalPath.firstStep)
    (data : EightSixEquationOneData ctx.Γ ctx.criticalPath previous D L Q)
    (E A0 : Subgroup G) (actor : G)
    (geom : SectionNine.NineThreeGeometricData ctx.Γ
      ctx.criticalPath.firstStep ctx.criticalPath.a
      (VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a) E A0 actor)
    (hcore : conjugateClosure (ZAt ctx.Γ ctx.criticalPath.a) E ≤
      QAt ctx.Γ ctx.criticalPath.a)
    (hedge : E ⊔ (GAt ctx.Γ ctx.criticalPath.a ⊓ GAt ctx.Γ ctx.criticalPath.firstStep) =
      GAt ctx.Γ ctx.criticalPath.firstStep)
    (hD : D = QAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.firstStep)
    (hL : L = conjugateClosure (QAt ctx.Γ previous) (GAt ctx.Γ ctx.criticalPath.a))
    (ha : actor ∈ VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a)
    (hout : actor ∉ QAt ctx.Γ ctx.criticalPath.firstStep)
    (hlarge : 4 * Nat.card
      ((VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a) ⊓ D : Subgroup G) ≤
      Nat.card (VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a : Subgroup G))
    (hmin : ∀ other : G, other ∈ VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a →
      other ∉ QAt ctx.Γ ctx.criticalPath.firstStep →
        eightSixCommutatorCost ctx.Γ ctx.criticalPath actor ≤
          eightSixCommutatorCost ctx.Γ ctx.criticalPath other) :
    VAt ctx.Γ ctx.criticalPath.firstStep ≠
      conjugateClosure (ZAt ctx.Γ ctx.criticalPath.a) E ⊔
        (VAt ctx.Γ ctx.criticalPath.firstStep ⊓
          Subgroup.centralizer (twoResidualIn E : Set G)) := by
  intro hsplit
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let A := VAt Γ previous ⊓ QAt Γ cp.a
  let P := GAt Γ cp.firstStep
  let R := QAt Γ cp.firstStep
  let V := VAt Γ cp.firstStep
  let Z := ZAt Γ cp.firstStep
  let U := conjugateClosure (ZAt Γ cp.a) E
  let V0 := R ⊓ Subgroup.centralizer (twoResidualIn E : Set G)
  let C := V ⊓ Subgroup.centralizer (twoResidualIn E : Set G)
  let J := ⁅V,Subgroup.zpowers actor⁆ ⊔ Z
  have hA0A : A0 ≤ A := geom.coatom_eq ▸ inf_le_left
  obtain ⟨other,hother,hotherOut,hotherCost⟩ := eight_six_selected_small_competitor_of_split
    ctx hcenter hquot hlength hcard previous D L Q hprev data E A0 actor geom
      hcore hedge hD hL hlarge hsplit
  have hcost : Z.relIndex J ≤ 2 := (hmin other (hA0A hother) hotherOut).trans hotherCost
  have hline := eight_six_first_step_fixed_line_local ctx hcenter hcard
  have hZcard : Nat.card Z = 2 := hline.1
  have hcount := (Z.subgroupOf J).index_mul_card
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe
    (show Z ≤ J from le_sup_right)).toEquiv, hZcard] at hcount
  have hJcard : Nat.card J ≤ 4 := by
    change Z.relIndex J * 2 = Nat.card J at hcount
    omega
  have hAE : A ≤ E := geom.generated ▸ le_sup_left
  have hAP : A ≤ P := hAE.trans geom.group_le
  have hUV : U ≤ V := eight_six_conjugate_closure_le _ _ _
    (lemma_seven_four ctx.sectionSeven Γ cp).first_containment.1
    (geom.group_le.trans (stabilizer_le_normalizer_v Γ cp.firstStep))
  have hactive := eight_six_selected_actor_active_line ctx hcenter hquot hlength hcard
    previous D L Q hprev data E A0 actor geom hcore hedge hD hL ha
  have hZaJ : ZAt Γ cp.a ≤ J := by
    rw [← hactive]
    exact sup_le_sup (Subgroup.commutator_mono hUV le_rfl) le_rfl
  have hJeq : J = ZAt Γ cp.a :=
    (Subgroup.eq_of_le_of_card_ge hZaJ (by
      change Nat.card (ZAt Γ cp.a) = 4 at hcard
      omega)).symm
  have hZaD : ZAt Γ cp.a ≤ D := by
    rw [←data.residual_commutator]
    exact Subgroup.le_normalizer_iff_commutator_le_left.mp
      ((SevenSix.twoResidualIn_le L).trans (data.closure_le.trans
        ((Subgroup.normal_subgroupOf_iff_le_normalizer data.intersection_normal.1).mp
          data.intersection_normal.2)))
  have hZD : Z ≤ D := hline.2.trans hZaD
  have hVR : V ≤ R := SevenSix.neighbor_join_le_core_of_length_gt_one Γ cp
    (by exact hlength ▸ by decide) _
  have hCV0 : C ≤ V0 := inf_le_inf_right _ hVR
  have hEB : E ≤ Subgroup.normalizer (twoResidualIn E : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer (SevenSix.twoResidualIn_le E)).mp
      (SevenSix.twoResidualIn_normal E)
  have hBC : Subgroup.normalizer (twoResidualIn E : Set G) ≤
      Subgroup.normalizer (Subgroup.centralizer (twoResidualIn E : Set G) : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer
      (Subgroup.centralizer_le_normalizer _)).mp inferInstance
  have hAC : A ≤ Subgroup.normalizer (C : Set G) :=
    (le_inf (hAP.trans (stabilizer_le_normalizer_v Γ cp.firstStep))
      (hAE.trans (hEB.trans hBC))).trans Subgroup.inf_normalizer_le_normalizer_inf
  have hCactor : ⁅C,Subgroup.zpowers actor⁆ ≤ Z := by
    have hleC := Subgroup.le_normalizer_iff_commutator_le_left.mp
      ((Subgroup.zpowers_le.mpr ha).trans hAC)
    have hleD : ⁅C,Subgroup.zpowers actor⁆ ≤ D :=
      (Subgroup.commutator_mono inf_le_left le_rfl).trans
        ((le_sup_left.trans_eq hJeq).trans hZaD)
    exact (le_inf (hleC.trans hCV0) hleD).trans_eq
      (eight_six_selected_fixed_core_intersection ctx hcenter hquot hlength hcard
        previous D L Q hprev hD hL data E A0 actor geom hedge)
  have hVnot : ¬ V ≤ QAt Γ cp.a := by
    intro hVQa
    have hfirst := (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr cp.firstStep_adj
    have hZaC : ZAt Γ cp.a ≤ Subgroup.centralizer (QAt Γ cp.a : Set G) :=
      ((lemma_seven_three ctx.sectionSeven Γ).center_core _ _ hfirst).trans
        ((SevenSix.omegaOneCenter_le_centerAmbient _).trans
          (SevenSix.centerAmbient_le_centralizer _))
    exact ctx.commutator_ne (Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
      (hZaC.trans (Subgroup.centralizer_le
        ((eight_six_terminal_center_le_next_v Γ cp hlength).trans hVQa))))
  have hCnot : ¬ C ≤ QAt Γ cp.a := by
    intro hCQ
    exact hVnot (hsplit.le.trans (sup_le hcore hCQ))
  obtain ⟨mover,hmover,hmoverOut⟩ := SetLike.not_le_iff_exists.mp hCnot
  have hAprevious : A ≤ QAt Γ previous := inf_le_left.trans
    (SevenSix.neighbor_join_le_core_of_length_gt_one Γ cp
      (by exact hlength ▸ by decide) previous)
  have hforce := eight_six_cubic_subgroup_forcing ctx.sectionSeven Γ cp.a cp.firstStep
    previous hquot ((SevenSix.mem_neighborhood_iff_adjacent Γ).mpr cp.firstStep_adj)
      hprev.1 hprev.2 D hD data.intersection_normal mover (hVR hmover.1) hmoverOut
      (Subgroup.zpowers actor) ((Subgroup.zpowers_le.mpr ha).trans hAprevious) (by
        rw [Subgroup.commutator_comm]
        exact (Subgroup.commutator_mono (Subgroup.zpowers_le.mpr hmover) le_rfl).trans
          (hCactor.trans hZD))
  exact hout ((hD ▸ inf_le_right) (hforce (Subgroup.mem_zpowers actor)))


end Stellmacher.SectionEight

