module
public import Stellmacher.TwoResidualCommutatorSupplement
public import Stellmacher.ResidualCoreTripleCentralization
public import Stellmacher.SectionThree.PrimitiveDihedralExtraction.ResidualLift
public import Stellmacher.SectionFiveToSeven.Result7_6.CoreFacts
public import Theory.GroupTheory.Commutator.NormalizesSupplement
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Source (7)'s residual-core centralization argument

In a finite ambient group, let P be generated by A, its conjugate A^x,
and a two-subgroup T, with x in P. Let Z be ambient-normal and centralized
by T. Suppose M is normalized by T, [M,A] lies in Z, and A^x centralizes M.
If the two-core Q of O²(P) lies in T and O²(P)/Q has odd order, then M
centralizes Q. M is not required to lie in P. The original native theorem
is retained as the exact specialization P=top.

First P normalizes MZ. In the ambient quotient by Z its image is centralized
by A and A^x, so the two-group supplement T makes O²(P) centralize it.
Hence [M,O²(P)] lies in Z. Since Q centralizes Z, [M,Q]=[MZ,Q] is
P-normalized. It lies in M because Q lies in T, and therefore A^x centralizes
it. Normalization by x in P makes A centralize it too. Applying the external
normalizer form of the two-group supplement argument again makes O²(P)
centralize [M,Q]. The other triple commutator vanishes because Z centralizes
Q. The residual-core identity and three-subgroups lemma give [M,Q]=1.

The source consumer works inside G_a', with P=L0 Q_a', T=Q_a', Z=Z_a',
and M=D*. Ambient normality of Z holds there; neither D*≤L nor normality
of L in G_a' is imposed. The imported quotient-supplement lemma maps both P and the
externally normalized M into the actual quotient and transports residuals.
Both odd-quotient inputs required by the scan remain explicit.
Source: Stellmacher (8.4)(7), Journal of Algebra 190 (1997), printed p.39,
`refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionEight
open BenderSuzuki.External
open scoped commutatorElement
private theorem commutator_sup_le_normal_target
    {G : Type*} [Group G] (A B M Z : Subgroup G) [Z.Normal]
    (hA : ⁅A,M⁆ ≤ Z) (hB : ⁅B,M⁆ ≤ Z) : ⁅A ⊔ B,M⁆ ≤ Z := by
  let q := QuotientGroup.mk' Z
  have hAq : A.map q ≤ Subgroup.centralizer (M.map q : Set (G ⧸ Z)) := by
    apply Subgroup.commutator_eq_bot_iff_le_centralizer.mp
    rw [← Subgroup.map_commutator]
    exact (Subgroup.map_eq_bot_iff _).mpr (by simpa only [q,QuotientGroup.ker_mk'] using hA)
  have hBq : B.map q ≤ Subgroup.centralizer (M.map q : Set (G ⧸ Z)) := by
    apply Subgroup.commutator_eq_bot_iff_le_centralizer.mp
    rw [← Subgroup.map_commutator]
    exact (Subgroup.map_eq_bot_iff _).mpr (by simpa only [q,QuotientGroup.ker_mk'] using hB)
  have hkill : (⁅A ⊔ B,M⁆).map q = ⊥ := by
    rw [Subgroup.map_commutator,Subgroup.map_sup]
    exact Subgroup.commutator_eq_bot_iff_le_centralizer.mpr (sup_le hAq hBq)
  simpa only [q,QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp hkill

public theorem eight_four_source_seven_core_centralization_in
    {G : Type*} [Group G] [Finite G]
    (M Z A T P : Subgroup G) [Z.Normal] (x : G) (hxP : x ∈ P)
    (hgen : (A ⊔ A.conjBy x) ⊔ T = P) (hT : IsPGroup 2 T)
    (hTM : T ≤ Subgroup.normalizer (M : Set G))
    (hZT : ⁅Z,T⁆ = ⊥) (hMA : ⁅M,A⁆ ≤ Z) (hMAx : ⁅M,A.conjBy x⁆ = ⊥)
    (hQT : (pCore 2 (twoResidualAmbient P)).map
      (twoResidualAmbient P).subtype ≤ T)
    (hodd : Odd (Nat.card ((twoResidualAmbient P) ⧸
      pCore 2 (twoResidualAmbient P)))) :
    ⁅M,(pCore 2 (twoResidualAmbient P)).map
      (twoResidualAmbient P).subtype⁆ = ⊥ := by
  let R := twoResidualAmbient P
  let Q := (pCore 2 R).map R.subtype
  let B := M ⊔ Z
  let L0 := A ⊔ A.conjBy x
  have hZn : P ≤ Subgroup.normalizer (Z : Set G) :=
    Subgroup.le_normalizer_of_normal
  have hAB : A ≤ Subgroup.normalizer (B : Set G) :=
    Subgroup.le_normalizer_sup_of_commutator_le M A M Z le_rfl hMA
  have hAxB : A.conjBy x ≤ Subgroup.normalizer (B : Set G) :=
    Subgroup.le_normalizer_sup_of_commutator_le M (A.conjBy x) M Z le_rfl (by rw [hMAx]; exact bot_le)
  have hTB : T ≤ Subgroup.normalizer (B : Set G) := by
    intro t ht
    apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
    change (M ⊔ Z).map (MulAut.conj t).toMonoidHom = M ⊔ Z
    rw [Subgroup.map_sup]
    change M.conjBy t ⊔ Z.conjBy t = M ⊔ Z
    have hm : M.conjBy t = M := Subgroup.mem_normalizer_iff_map_conj_eq.mp (hTM ht)
    have hz : Z.conjBy t = Z := Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (Subgroup.le_normalizer_of_normal (show t ∈ (⊤ : Subgroup G) from trivial))
    rw [hm,hz]
  have hPB : P ≤ Subgroup.normalizer (B : Set G) :=
    hgen ▸ sup_le (sup_le hAB hAxB) hTB
  have hBA : ⁅B,A⁆ ≤ Z := commutator_sup_le_normal_target M Z A Z hMA (Subgroup.commutator_le_left _ _)
  have hBAx : ⁅B,A.conjBy x⁆ ≤ Z := commutator_sup_le_normal_target M Z (A.conjBy x) Z
    (by rw [hMAx]; exact bot_le) (Subgroup.commutator_le_left _ _)
  have hL0B : ⁅L0,B⁆ ≤ Z := commutator_sup_le_normal_target A (A.conjBy x) B Z
    (by simpa only [Subgroup.commutator_comm] using hBA)
    (by simpa only [Subgroup.commutator_comm] using hBAx)
  have hRB : ⁅R,B⁆ ≤ Z := twoResidual_commutator_le_of_normalizing_two_supplement B Z L0 T P hPB hgen hT hL0B
  have hMR : ⁅M,R⁆ ≤ Z := by
    rw [Subgroup.commutator_comm]
    exact (Subgroup.commutator_mono le_rfl le_sup_left).trans hRB
  have hZQ : ⁅Z,Q⁆ = ⊥ := le_bot_iff.mp ((Subgroup.commutator_mono le_rfl hQT).trans_eq hZT)
  have hBQ : ⁅B,Q⁆ = ⁅M,Q⁆ := by
    apply le_antisymm ?_ (Subgroup.commutator_mono le_sup_left le_rfl)
    apply Subgroup.commutator_le.mpr
    intro b hb q hq
    obtain ⟨m,hm,z,hz,rfl⟩ := Subgroup.mem_sup_of_normal_right.mp hb
    have hzc : ⁅z,q⁆ = 1 := by
      have hh := Subgroup.commutator_mem_commutator hz hq
      rw [hZQ] at hh
      exact hh
    rw [commutatorElement_mul_left_eq_conj_mul,hzc]
    simpa using Subgroup.commutator_mem_commutator hm hq
  have hRP : R ≤ P := Subgroup.map_subtype_le _
  have hQP : Q ≤ P := (Subgroup.map_subtype_le _).trans hRP
  have hPQ : P ≤ Subgroup.normalizer (Q : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hQP).mp
      (SectionsFiveToSeven.SevenSix.twoCoreIn_normal_of_normal R P hRP
        (SectionsFiveToSeven.SevenSix.twoResidualIn_normal P))
  let N := ⁅M,Q⁆
  have hPN : P ≤ Subgroup.normalizer (N : Set G) := by
    intro p hp
    have hBm : B.conjBy p = B := Subgroup.mem_normalizer_iff_map_conj_eq.mp (hPB hp)
    have hQm : Q.conjBy p = Q := Subgroup.mem_normalizer_iff_map_conj_eq.mp (hPQ hp)
    apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
    change (⁅M,Q⁆).map (MulAut.conj p).toMonoidHom = ⁅M,Q⁆
    rw [← hBQ,Subgroup.map_commutator]
    change ⁅B.conjBy p,Q.conjBy p⁆ = ⁅B,Q⁆
    rw [hBm,hQm]
  have hNM : N ≤ M := Subgroup.le_normalizer_iff_commutator_le_left.mp (hQT.trans hTM)
  have hNAx : ⁅N,A.conjBy x⁆ = ⊥ :=
    le_bot_iff.mp ((Subgroup.commutator_mono hNM le_rfl).trans_eq hMAx)
  have hAN : ⁅A,N⁆ = ⊥ := by
    have hn : N.conjBy x⁻¹ = N := Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (hPN (P.inv_mem hxP))
    have hh := congrArg (Subgroup.map (MulAut.conj x⁻¹).toMonoidHom) hNAx
    rw [Subgroup.map_commutator,Subgroup.map_bot] at hh
    change ⁅N.conjBy x⁻¹,(A.conjBy x).conjBy x⁻¹⁆ = ⊥ at hh
    simpa only [hn,Subgroup.conjBy_inv,Subgroup.commutator_comm] using hh
  have hL0N : ⁅L0,N⁆ = ⊥ := Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
    (sup_le (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hAN)
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mp (by simpa only [Subgroup.commutator_comm] using hNAx)))
  have hRN := twoResidual_centralizes_of_normalizing_two_supplement N L0 T P hPN hgen hT hL0N
  apply residual_core_centralizes_of_triple_commutators M R
    (twoResidualAmbient_has_top_twoResidual P) hodd
  · exact le_bot_iff.mp ((Subgroup.commutator_mono hMR le_rfl).trans_eq hZQ)
  · simpa only [Subgroup.commutator_comm] using hRN
public theorem eight_four_source_seven_core_centralization
    {G : Type*} [Group G] [Finite G]
    (M Z A T : Subgroup G) [Z.Normal] (x : G)
    (hgen : (A ⊔ A.conjBy x) ⊔ T = ⊤) (hT : IsPGroup 2 T)
    (hTM : T ≤ Subgroup.normalizer (M : Set G))
    (hZT : ⁅Z,T⁆ = ⊥) (hMA : ⁅M,A⁆ ≤ Z) (hMAx : ⁅M,A.conjBy x⁆ = ⊥)
    (hQT : (pCore 2 (twoResidualAmbient (⊤ : Subgroup G))).map
      (twoResidualAmbient (⊤ : Subgroup G)).subtype ≤ T)
    (hodd : Odd (Nat.card ((twoResidualAmbient (⊤ : Subgroup G)) ⧸
      pCore 2 (twoResidualAmbient (⊤ : Subgroup G))))) :
    ⁅M,(pCore 2 (twoResidualAmbient (⊤ : Subgroup G))).map
      (twoResidualAmbient (⊤ : Subgroup G)).subtype⁆ = ⊥ := by
  exact eight_four_source_seven_core_centralization_in M Z A T ⊤ x (by trivial)
    hgen hT hTM hZT hMA hMAx hQT hodd
end Stellmacher.SectionEight
