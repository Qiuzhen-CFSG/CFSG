module
public import Stellmacher.SectionEight.GeneratedEightSixSmallIndexOrders
public import Stellmacher.SectionEight.GeneratedEightSixNeighborGeneration
public import Stellmacher.SectionFiveToSeven.Result7_8.GeometricExtraction
public import Stellmacher.SectionFiveToSeven.NeighborCenterNormalizer
public import Theory.GroupTheory.NormalizedSupCard

/-!
# The selected fixed core meets D in the next center

In the distance-two setting of Stellmacher (8.6), let E be the actual group
generated by the predecessor core part A and one residual-conjugate of A.
Assume E and the initial-next edge stabilizer generate the next stabilizer.
Then the centralizer of O²(E) in the next two-core meets the opposite-core
intersection D precisely in the next center.

The predecessor and next centers are distinct lines spanning the initial
four-element center. If the predecessor line centralized O²(E), generation
of E would make E centralize that line; together with the central next line,
this would normalize the initial center under the next stabilizer, contradicting
the neighboring-center normalizer theorem. Thus the predecessor line meets
the fixed core trivially. The commutator of its intersection with D and A is
contained in both these subgroups and vanishes. The previously proved exact
predecessor core-part centralizer puts that intersection in the initial center;
its contained next line and excluded predecessor line identify it.

The companion commutator bounds used in assertion(11) follow by normalizing
the fixed core under A. The commutator of its intersection with the initial
core lies in D because the initial core normalizes the predecessor core.
The exact intersection then bounds this commutator by the next center; the
commutator of the intersection with D vanishes by next-center centrality.

This is assertion(10), printed p.43 of Stellmacher, Journal of Algebra190
(1997), `refs/files/stellmacher-n-group.pdf`. No large-case quotient model,
small next-core bound, or fixed-core equality is assumed.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
open scoped IsMulCommutative commutatorElement
universe u

private theorem disjoint_of_card_two_not_le
    {G : Type u} [Group G] [Finite G] (A B : Subgroup G)
    (hA : Nat.card A = 2) (hnot : ¬ A ≤ B) : Disjoint A B := by
  apply disjoint_iff.mpr
  have hdvd := Subgroup.card_dvd_of_le (show A ⊓ B ≤ A from inf_le_left)
  rw [hA] at hdvd
  rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with hone | htwo
  · exact Subgroup.card_eq_one.mp hone
  · exact (hnot ((Subgroup.eq_of_le_of_card_ge inf_le_left (by omega)).symm.le.trans
      (show A ⊓ B ≤ B from inf_le_right))).elim

/-- The two neighbor centers are disjoint order-two lines spanning the initial
center. This also supplies the vanishing center intersection used in (12). -/
public theorem eight_six_neighbor_center_lines
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hquot : QuotientIsModel (GAt ctx.Γ ctx.criticalPath.a)
      (QAt ctx.Γ ctx.criticalPath.a) SL2Two)
    (hlength : ctx.criticalPath.length = 2)
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4)
    (previous : ctx.Γ.Vertex)
    (hprev : previous ∈ Neighborhood ctx.Γ ctx.criticalPath.a ∧
      previous ≠ ctx.criticalPath.firstStep) :
    Nat.card (ZAt ctx.Γ previous) = 2 ∧
      ZAt ctx.Γ previous ≤ ZAt ctx.Γ ctx.criticalPath.a ∧
      ZAt ctx.Γ previous ⊔ ZAt ctx.Γ ctx.criticalPath.firstStep =
        ZAt ctx.Γ ctx.criticalPath.a ∧
      Disjoint (ZAt ctx.Γ previous) (ZAt ctx.Γ ctx.criticalPath.firstStep) := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  have hlen : cp.length = 2 := hlength
  have hZaCard : Nat.card (ZAt Γ cp.a) = 4 := hcard
  have hqself (vertex : Γ.Vertex) : QAt Γ vertex ≤ GAt Γ vertex := by
    change Γ.twoCoreAt vertex ≤ _
    rw [Γ.twoCoreAt_def]
    exact Subgroup.map_subtype_le _
  have hfirst : cp.firstStep ∈ Neighborhood Γ cp.a :=
    (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr cp.firstStep_adj
  have hback : cp.a ∈ Neighborhood Γ cp.firstStep :=
    (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr (Γ.adjacent_symm cp.firstStep_adj)
  have hprevBack : cp.a ∈ Neighborhood Γ previous :=
    (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr
      (Γ.adjacent_symm ((SevenSix.mem_neighborhood_iff_adjacent Γ).mp hprev.1))
  obtain ⟨hlineCard, hlineLe⟩ := eight_six_first_step_fixed_line_local ctx hcenter hcard
  change Nat.card (ZAt Γ cp.firstStep) = 2 at hlineCard
  change ZAt Γ cp.firstStep ≤ ZAt Γ cp.a at hlineLe
  obtain ⟨g, hg⟩ := (lemma_seven_one ctx.sectionSeven Γ).local_transitivity
    cp.a hfirst hprev.1
  let f := (MulAut.conj (g : G)⁻¹).toMonoidHom
  have hprevMap : (ZAt Γ cp.firstStep).map f = ZAt Γ previous := by
    rw [← hg]
    exact (z_act Γ g cp.firstStep).symm
  have hZaMap : (ZAt Γ cp.a).map f = ZAt Γ cp.a :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp
      ((Subgroup.normalizer (ZAt Γ cp.a : Set G)).inv_mem
        (stabilizer_le_normalizer_z Γ cp.a g.property))
  have hprevCard : Nat.card (ZAt Γ previous) = 2 := by
    rw [← hprevMap, Subgroup.card_map_of_injective (MulAut.conj (g : G)⁻¹).injective]
    exact hlineCard
  have hprevLe : ZAt Γ previous ≤ ZAt Γ cp.a := by
    rw [← hprevMap, ← hZaMap]
    exact Subgroup.map_mono hlineLe
  have hZaCore : ZAt Γ cp.a ≤ Subgroup.centralizer (QAt Γ cp.a : Set G) :=
    ((lemma_seven_three ctx.sectionSeven Γ).center_core cp.a cp.firstStep hfirst).trans
      ((SevenSix.omegaOneCenter_le_centerAmbient _).trans
        (SevenSix.centerAmbient_le_centralizer _))
  have hlineNot : ¬ ZAt Γ previous ≤ ZAt Γ cp.firstStep := by
    intro hle
    have heq : ZAt Γ previous = ZAt Γ cp.firstStep :=
      Subgroup.eq_of_le_of_card_ge hle (by omega)
    have hcommNext : ZAt Γ cp.firstStep ≤ Subgroup.centralizer (VAt Γ cp.firstStep : Set G) :=
      (hcenter.trans (SevenSix.centerAmbient_le_centralizer _)).trans
        (Subgroup.centralizer_le ((SevenSix.neighbor_join_le_core_of_length_gt_one Γ cp
          (by omega) _).trans (hqself _)))
    have hcommPrev : ZAt Γ previous ≤ Subgroup.centralizer (VAt Γ previous : Set G) :=
      (((lemma_seven_three ctx.sectionSeven Γ).center_core previous cp.a hprevBack).trans
        ((SevenSix.omegaOneCenter_le_centerAmbient _).trans
          (SevenSix.centerAmbient_le_centralizer _))).trans
            (Subgroup.centralizer_le (SevenSix.neighbor_join_le_core_of_length_gt_one Γ cp
              (by omega) previous))
    have hcent : ZAt Γ cp.firstStep ≤ Subgroup.centralizer (GAt Γ cp.a : Set G) := by
      apply Subgroup.le_centralizer_iff.mpr
      rw [← eight_six_neighbor_generation_local ctx hquot hlength previous hprev]
      exact sup_le (sup_le (Subgroup.le_centralizer_iff.mp (hlineLe.trans hZaCore))
        (Subgroup.le_centralizer_iff.mp hcommNext))
        (Subgroup.le_centralizer_iff.mp (heq ▸ hcommPrev))
    have hlineInitial : ZAt Γ cp.firstStep ≤ GAt Γ cp.a := hlineLe.trans
      ((((lemma_seven_three ctx.sectionSeven Γ).center_core cp.a cp.firstStep hfirst).trans
        (Subgroup.map_subtype_le _)).trans (hqself _))
    have hbot : ZAt Γ cp.firstStep = ⊥ := by
      apply bot_unique
      have hz := le_inf hlineInitial hcent
      rw [← eight_six_centerAmbient_eq_inf_centralizer,
        eight_six_initial_center_trivial_local ctx hcenter] at hz
      exact hz
    have hcone := Subgroup.card_eq_one.mpr hbot
    omega
  have hdisjoint := disjoint_of_card_two_not_le _ _ hprevCard hlineNot
  let _ := SevenSix.z_isElementaryAbelian_of_neighbor ctx.sectionSeven Γ hfirst
  have hnorm : ZAt Γ cp.firstStep ≤ Subgroup.normalizer (ZAt Γ previous : Set G) := by
    apply (Subgroup.centralizer_le_normalizer _).trans'
    intro x hx
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    exact congrArg Subtype.val (mul_comm
      (⟨y,hprevLe hy⟩ : ZAt Γ cp.a) (⟨x,hlineLe hx⟩ : ZAt Γ cp.a))
  have hjoinCard := Subgroup.card_sup_eq_mul_of_normalizes_of_disjoint
    (ZAt Γ previous) (ZAt Γ cp.firstStep) hnorm hdisjoint
  rw [hprevCard,hlineCard] at hjoinCard
  exact ⟨hprevCard, hprevLe,
    Subgroup.eq_of_le_of_card_ge (sup_le hprevLe hlineLe) (by
      change Nat.card (ZAt Γ cp.a) ≤ Nat.card (ZAt Γ previous ⊔ ZAt Γ cp.firstStep : Subgroup G)
      rw [hZaCard, hjoinCard]), hdisjoint⟩


public theorem eight_six_selected_fixed_core_intersection
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hquot : QuotientIsModel (GAt ctx.Γ ctx.criticalPath.a)
      (QAt ctx.Γ ctx.criticalPath.a) SL2Two)
    (hlength : ctx.criticalPath.length = 2)
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4)
    (previous : ctx.Γ.Vertex) (D L Q : Subgroup G)
    (hprev : previous ∈ Neighborhood ctx.Γ ctx.criticalPath.a ∧
      previous ≠ ctx.criticalPath.firstStep)
    (hD : D = QAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.firstStep)
    (hL : L = conjugateClosure (QAt ctx.Γ previous) (GAt ctx.Γ ctx.criticalPath.a))
    (data : EightSixEquationOneData ctx.Γ ctx.criticalPath previous D L Q)
    (E A0 : Subgroup G) (actor : G)
    (geom : SectionNine.NineThreeGeometricData ctx.Γ
      ctx.criticalPath.firstStep ctx.criticalPath.a
      (VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a) E A0 actor)
    (hedge : E ⊔ (GAt ctx.Γ ctx.criticalPath.a ⊓ GAt ctx.Γ ctx.criticalPath.firstStep) =
      GAt ctx.Γ ctx.criticalPath.firstStep) :
    (QAt ctx.Γ ctx.criticalPath.firstStep ⊓
      Subgroup.centralizer (twoResidualIn E : Set G)) ⊓ D =
        ZAt ctx.Γ ctx.criticalPath.firstStep := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let A := VAt Γ previous ⊓ QAt Γ cp.a
  let V0 := QAt Γ cp.firstStep ⊓ Subgroup.centralizer (twoResidualIn E : Set G)
  let U := V0 ⊓ D
  have hlen : cp.length = 2 := hlength
  have hZaCard : Nat.card (ZAt Γ cp.a) = 4 := hcard
  have hfirst : cp.firstStep ∈ Neighborhood Γ cp.a :=
    (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr cp.firstStep_adj
  have hback : cp.a ∈ Neighborhood Γ cp.firstStep :=
    (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr (Γ.adjacent_symm cp.firstStep_adj)
  have hprevBack : cp.a ∈ Neighborhood Γ previous :=
    (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr
      (Γ.adjacent_symm ((SevenSix.mem_neighborhood_iff_adjacent Γ).mp hprev.1))
  have hqself (vertex : Γ.Vertex) : QAt Γ vertex ≤ GAt Γ vertex := by
    change Γ.twoCoreAt vertex ≤ _
    rw [Γ.twoCoreAt_def]
    exact Subgroup.map_subtype_le _
  have hAE : A ≤ E := by rw [geom.generated]; exact le_sup_left
  have hAprev : A ≤ QAt Γ previous := inf_le_left.trans
    (SevenSix.neighbor_join_le_core_of_length_gt_one Γ cp (by omega) previous)
  have hZprevCentral : ZAt Γ previous ≤ Subgroup.centralizer (A : Set G) :=
    (((lemma_seven_three ctx.sectionSeven Γ).center_core previous cp.a hprevBack).trans
      ((SevenSix.omegaOneCenter_le_centerAmbient _).trans
        (SevenSix.centerAmbient_le_centralizer _))).trans (Subgroup.centralizer_le hAprev)
  obtain ⟨hprevCard,hprevLe,hspan,_⟩ := eight_six_neighbor_center_lines
    ctx hcenter hquot hlength hcard previous hprev
  change Nat.card (ZAt Γ previous) = 2 at hprevCard
  change ZAt Γ previous ≤ ZAt Γ cp.a at hprevLe
  change ZAt Γ previous ⊔ ZAt Γ cp.firstStep = ZAt Γ cp.a at hspan
  have hline := eight_six_first_step_fixed_line_local ctx hcenter hcard
  change Nat.card (ZAt Γ cp.firstStep) = 2 ∧ ZAt Γ cp.firstStep ≤ ZAt Γ cp.a at hline
  have hEcentralLine : ZAt Γ cp.firstStep ≤ Subgroup.centralizer (E : Set G) :=
    (hcenter.trans (SevenSix.centerAmbient_le_centralizer _)).trans
      (Subgroup.centralizer_le geom.group_le)
  have hnot : ¬ ZAt Γ previous ≤ V0 := by
    intro hle
    have hxC : geom.x ∈ Subgroup.centralizer (ZAt Γ previous : Set G) :=
      Subgroup.le_centralizer_iff.mp (hle.trans inf_le_right) geom.residual_mem
    have hAC : A ≤ Subgroup.centralizer (ZAt Γ previous : Set G) :=
      Subgroup.le_centralizer_iff.mp hZprevCentral
    have hEC : E ≤ Subgroup.centralizer (ZAt Γ previous : Set G) := by
      rw [geom.generated]
      apply sup_le hAC
      rintro x ⟨a,ha,rfl⟩
      exact (Subgroup.centralizer (ZAt Γ previous : Set G)).mul_mem
        ((Subgroup.centralizer (ZAt Γ previous : Set G)).mul_mem hxC (hAC ha))
        ((Subgroup.centralizer (ZAt Γ previous : Set G)).inv_mem hxC)
    have hECZa : E ≤ Subgroup.centralizer (ZAt Γ cp.a : Set G) := by
      apply Subgroup.le_centralizer_iff.mpr
      rw [← hspan]
      exact sup_le (Subgroup.le_centralizer_iff.mpr hEC) hEcentralLine
    have hnextNorm : GAt Γ cp.firstStep ≤ Subgroup.normalizer (ZAt Γ cp.a : Set G) := by
      rw [← hedge]
      exact sup_le (hECZa.trans (Subgroup.centralizer_le_normalizer _))
        (inf_le_left.trans (stabilizer_le_normalizer_z Γ cp.a))
    exact neighbor_center_not_normalized ctx.sectionSeven Γ cp.firstStep cp.a hback hnextNorm
  have hdisj := disjoint_of_card_two_not_le (ZAt Γ previous) V0 hprevCard hnot
  have hresnorm : E ≤ Subgroup.normalizer (twoResidualIn E : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer (SevenSix.twoResidualIn_le E)).mp
      (SevenSix.twoResidualIn_normal E)
  have hcentralNorm : Subgroup.normalizer (twoResidualIn E : Set G) ≤
      Subgroup.normalizer (Subgroup.centralizer (twoResidualIn E : Set G) : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer
      (Subgroup.centralizer_le_normalizer _)).mp inferInstance
  have hAV0 : A ≤ Subgroup.normalizer (V0 : Set G) :=
    (le_inf (hAE.trans (geom.group_le.trans (SevenSix.stabilizer_le_normalizer_q Γ cp.firstStep)))
      (hAE.trans (hresnorm.trans hcentralNorm))).trans Subgroup.inf_normalizer_le_normalizer_inf
  have hcommV0 : ⁅U,A⁆ ≤ V0 :=
    (Subgroup.commutator_mono inf_le_left le_rfl).trans
      (Subgroup.le_normalizer_iff_commutator_le_left.mp hAV0)
  have hcommPrev : ⁅U,A⁆ ≤ ZAt Γ previous :=
    (Subgroup.commutator_mono (inf_le_right.trans (hD ▸ inf_le_left)) inf_le_left).trans_eq
      (eight_six_predecessor_commutator_and_center_bound ctx.sectionSeven Γ cp hcenter hcard
        previous hprev.1 D L Q data).1
  have hcommZero : ⁅U,A⁆ = ⊥ := bot_unique ((le_inf hcommPrev hcommV0).trans_eq hdisj.eq_bot)
  have hfull := eight_six_intersection_centralizer_of_rigidity
    ctx.sectionSeven Γ cp hcenter previous D L Q hD data (by
      intro K hK hKS
      have hKZa := eight_six_rigidity_le_initial_center ctx.sectionSeven Γ cp hcenter hquot
        previous D L Q hD hL data K (hK.trans inf_le_left) hKS
      exact eight_six_rigidity_le_first_center_of_le_initial ctx hcenter hlength hcard
        previous D L Q data K hKZa (hK.trans inf_le_right))
  have hfirstCentralizer := eight_six_first_core_part_centralizer_of_intersection_centralizer
    ctx.sectionSeven Γ cp hcenter hquot hcard previous D L Q hD data hfull
  have hpreviousCentralizer := eight_six_predecessor_core_part_centralizer_of_first_core_part
    ctx.sectionSeven Γ cp previous hprev.1 D L Q data hfirstCentralizer
  have hUZa : U ≤ ZAt Γ cp.a :=
    (le_inf inf_le_right (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcommZero)).trans_eq
      hpreviousCentralizer
  have hlineU : ZAt Γ cp.firstStep ≤ U := by
    have hlineD : ZAt Γ cp.firstStep ≤ D :=
      hline.2.trans (eight_six_rigidity_core_containments ctx.sectionSeven Γ cp previous D L Q hD data).2.2.1
    exact le_inf (le_inf (hlineD.trans (hD ▸ inf_le_right))
      (hEcentralLine.trans (Subgroup.centralizer_le (SevenSix.twoResidualIn_le E)))) hlineD
  have hUne : U ≠ ZAt Γ cp.a := by
    intro heq
    exact hnot (hprevLe.trans (heq ▸ (show U ≤ V0 from inf_le_left)))
  have hlt : Nat.card U < 4 := by
    have hle := Subgroup.card_le_of_le hUZa
    have hne : Nat.card U ≠ Nat.card (ZAt Γ cp.a) :=
      fun heq => hUne (Subgroup.eq_of_le_of_card_ge hUZa heq.ge)
    exact (lt_of_le_of_ne hle hne).trans_eq hZaCard
  have hdvd : Nat.card U ∣ 2 ^ 2 := by
    simpa [hZaCard] using Subgroup.card_dvd_of_le hUZa
  have hsmall : Nat.card U ≤ 2 := by
    obtain ⟨n, hn, heq⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
    have hnsmall : n ≤ 1 := by
      by_contra hnot
      have hn2 : n = 2 := by omega
      subst n
      norm_num at heq
      omega
    rw [heq]
    exact (Nat.pow_le_pow_right (by decide : 1 ≤ 2) hnsmall).trans (by norm_num)
  exact (Subgroup.eq_of_le_of_card_ge hlineU (hsmall.trans_eq hline.1.symm)).symm



/-- Source assertion(11)'s selected fixed-core commutator bounds. The second
commutator vanishes, which strengthens the bound by the next center. -/
public theorem eight_six_selected_fixed_core_commutator_bounds
    {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}
    (ctx : SectionEightLocalContext G S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hquot : QuotientIsModel (GAt ctx.Γ ctx.criticalPath.a)
      (QAt ctx.Γ ctx.criticalPath.a) SL2Two)
    (hlength : ctx.criticalPath.length = 2)
    (hcard : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 4)
    (previous : ctx.Γ.Vertex) (D L Q : Subgroup G)
    (hprev : previous ∈ Neighborhood ctx.Γ ctx.criticalPath.a ∧
      previous ≠ ctx.criticalPath.firstStep)
    (hD : D = QAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.firstStep)
    (hL : L = conjugateClosure (QAt ctx.Γ previous) (GAt ctx.Γ ctx.criticalPath.a))
    (data : EightSixEquationOneData ctx.Γ ctx.criticalPath previous D L Q)
    (E A0 : Subgroup G) (actor : G)
    (geom : SectionNine.NineThreeGeometricData ctx.Γ
      ctx.criticalPath.firstStep ctx.criticalPath.a
      (VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a) E A0 actor)
    (hedge : E ⊔ (GAt ctx.Γ ctx.criticalPath.a ⊓ GAt ctx.Γ ctx.criticalPath.firstStep) =
      GAt ctx.Γ ctx.criticalPath.firstStep) :
    ⁅(QAt ctx.Γ ctx.criticalPath.firstStep ⊓
      Subgroup.centralizer (twoResidualIn E : Set G)) ⊓ QAt ctx.Γ ctx.criticalPath.a,
      VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a⁆ ≤
      ZAt ctx.Γ ctx.criticalPath.firstStep ∧
    ⁅(QAt ctx.Γ ctx.criticalPath.firstStep ⊓
      Subgroup.centralizer (twoResidualIn E : Set G)) ⊓ D,
      VAt ctx.Γ previous ⊓ QAt ctx.Γ ctx.criticalPath.a⁆ = ⊥ := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let V0 := QAt Γ cp.firstStep ⊓ Subgroup.centralizer (twoResidualIn E : Set G)
  let U := V0 ⊓ QAt Γ cp.a
  let A := VAt Γ previous ⊓ QAt Γ cp.a
  have hEq := eight_six_selected_fixed_core_intersection ctx hcenter hquot hlength hcard
    previous D L Q hprev hD hL data E A0 actor geom hedge
  have hAE : A ≤ E := by rw [geom.generated]; exact le_sup_left
  have hlen : cp.length = 2 := hlength
  have hresnorm : E ≤ Subgroup.normalizer (twoResidualIn E : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer (SevenSix.twoResidualIn_le E)).mp
      (SevenSix.twoResidualIn_normal E)
  have hcentralNorm : Subgroup.normalizer (twoResidualIn E : Set G) ≤
      Subgroup.normalizer (Subgroup.centralizer (twoResidualIn E : Set G) : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer
      (Subgroup.centralizer_le_normalizer _)).mp inferInstance
  have hV0norm : A ≤ Subgroup.normalizer (V0 : Set G) :=
    (le_inf (hAE.trans (geom.group_le.trans (SevenSix.stabilizer_le_normalizer_q Γ cp.firstStep)))
      (hAE.trans (hresnorm.trans hcentralNorm))).trans Subgroup.inf_normalizer_le_normalizer_inf
  have hcommV0 : ⁅U,A⁆ ≤ V0 :=
    (Subgroup.commutator_mono inf_le_left le_rfl).trans
      (Subgroup.le_normalizer_iff_commutator_le_left.mp hV0norm)
  have hAprev : A ≤ QAt Γ previous := inf_le_left.trans
    (SevenSix.neighbor_join_le_core_of_length_gt_one Γ cp (by omega) previous)
  have hQaPrev : QAt Γ cp.a ≤ GAt Γ previous :=
    ((lemma_seven_three ctx.sectionSeven Γ).sylow_and_core cp.a previous hprev.1 default).2.2
  have hcommPrev : ⁅U,A⁆ ≤ QAt Γ previous :=
    (Subgroup.commutator_mono le_rfl hAprev).trans
      (Subgroup.le_normalizer_iff_commutator_le_right.mp
        (inf_le_right.trans (hQaPrev.trans (SevenSix.stabilizer_le_normalizer_q Γ previous))))
  constructor
  · exact (le_inf hcommV0 (hD ▸ le_inf hcommPrev (hcommV0.trans inf_le_left))).trans_eq hEq
  · rw [hEq]
    exact Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
      ((hcenter.trans (SevenSix.centerAmbient_le_centralizer _)).trans
        (Subgroup.centralizer_le (hAE.trans geom.group_le)))


end Stellmacher.SectionEight
