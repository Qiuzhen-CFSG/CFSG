module
public import Stellmacher.SectionEight.EightFourFirstConfiguration
public import Stellmacher.SectionEight.EightFourTerminalCore
public import Stellmacher.TwoResidualConjugateSupplement
public import Stellmacher.SectionThree.ResidualCoreTransfer

/-!
# The selected residual core escapes the next vertex core

Take the actual first configuration in Stellmacher (8.4): an actor A in the
previous core but outside the terminal core, a subgroup L0 generated by A
and its x-conjugate, with x in L0, and generation of the terminal stabilizer
by L0 and the previous edge. Set L=L0 joined with the terminal core and
next=Γ.act x⁻¹ previous. Then O₂(O²(L)) lies outside the next core. This is
the noncontainment needed just before the second configuration, source (6),
Journal of Algebra 190 (1997), (8.4), p.39,
`refs/files/stellmacher-n-group.pdf`.

Conjugation by x transports the first configuration's edge generation to
the new edge and places the conjugate actor in its core. Suppose the selected
residual core were also in that core, and let N be the intersection of the
two vertex cores. Their edge stabilizer normalizes N. The commutator of the
terminal core with O²(L) is a normal two-subgroup of O²(L), hence lies in
the selected residual core and thus in N. Consequently O²(L) normalizes N.
The conjugate-generator residual supplement writes L as O²(L) joined with
the terminal core and the conjugate actor, both in the new edge. Thus L,
and then the full terminal stabilizer, normalizes N. Apply the solvable
residual-core transfer from (3.4) to the new vertex core: it puts the terminal
residual core in N, contradicting the transported (8.3).

This argument uses precisely the first configuration's stated data and avoids
the stronger edge-conjugate-closure equality in the scan. The next vertex uses
inverse graph action because `conjugateBy A x` denotes left conjugation.

The local version retains the exact graph and all chosen subgroups; the
canonical theorem is an exact wrapper. Only the two proved ambient callbacks
of EightFourLocalContext replace the canonical ambient assumptions.
-/

namespace Stellmacher.SectionEight
open Later SectionsFiveToSeven CosetGraphContext
universe u

private theorem normal_two_commutator_le_residual_core
    {G : Type u} [Group G] [Finite G]
    (Q L : Subgroup G) (hQL : NormalIn Q L) (hp : IsPGroup 2 Q) :
    ⁅Q, twoResidualIn L⁆ ≤ twoCoreIn (twoResidualIn L) := by
  let R := twoResidualIn L
  let C := ⁅Q, R⁆
  have hRL : R ≤ L := Subgroup.map_subtype_le _
  have hRn : (R.subgroupOf L).Normal := by
    change (((twoResidualSubgroup L).map L.subtype).comap L.subtype).Normal
    rw [Subgroup.comap_map_eq_self_of_injective L.subtype_injective]
    rw [SectionThree.twoResidualSubgroup_eq_hktPResidual']
    exact BenderSuzuki.External.hktPResidual_normal
  have hLR := (Subgroup.normal_subgroupOf_iff_le_normalizer hRL).mp hRn
  have hLQ := (Subgroup.normal_subgroupOf_iff_le_normalizer hQL.1).mp hQL.2
  have hCR : C ≤ R :=
    Subgroup.le_normalizer_iff_commutator_le_right.mp (hQL.1.trans hLR)
  have hCQ : C ≤ Q :=
    Subgroup.le_normalizer_iff_commutator_le_left.mp (hRL.trans hLQ)
  have hCn : (C.subgroupOf R).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer
      (Subgroup.normalizer_commutator_ge_right Q R)
  have hCp : IsPGroup 2 (C.subgroupOf R) := (hp.to_le hCQ).comap_subtype
  have hCcore : C.subgroupOf R ≤ pCore 2 R := le_sSup ⟨hCn, hCp⟩
  change C ≤ twoCoreIn R
  rw [← Subgroup.map_subgroupOf_eq_of_le hCR]
  exact Subgroup.map_mono hCcore

private theorem residual_sup_of_inside_conjugate_generation
    {G : Type u} [Group G] [Finite G]
    (A L : Subgroup G) (x : G) (hx : x ∈ L)
    (hgen : A ⊔ A.conjBy x = L) :
    twoResidualIn L ⊔ A = L := by
  have hAL : A ≤ L := le_sup_left.trans_eq hgen
  let AL := A.subgroupOf L
  let xL : L := ⟨x, hx⟩
  have hconj : (AL.conjBy xL).map L.subtype = A.conjBy x := by
    change (AL.map (MulAut.conj xL).toMonoidHom).map L.subtype = _
    rw [Subgroup.map_map]
    have hh : L.subtype.comp (MulAut.conj xL).toMonoidHom =
        (MulAut.conj x).toMonoidHom.comp L.subtype := by ext y; rfl
    rw [hh, ← Subgroup.map_map, Subgroup.map_subgroupOf_eq_of_le hAL]
    rfl
  have hgenL : AL ⊔ AL.conjBy xL = ⊤ := by
    apply Subgroup.map_injective L.subtype_injective
    rw [Subgroup.map_sup, hconj, Subgroup.map_subgroupOf_eq_of_le hAL,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    exact hgen
  have hs := twoResidualAmbient_top_sup_of_conjugate_generation AL xL hgenL
  have hmap := congrArg (Subgroup.map L.subtype) hs
  have hRmap : (twoResidualAmbient (⊤ : Subgroup L)).map L.subtype = twoResidualIn L :=
    map_twoResidualAmbient_of_subgroup_image ⊤ L.subtype L
      (by rw [← MonoidHom.range_eq_map, Subgroup.range_subtype])
  rw [Subgroup.map_sup, hRmap, Subgroup.map_subgroupOf_eq_of_le hAL,
    ← MonoidHom.range_eq_map, Subgroup.range_subtype] at hmap
  exact hmap

/-- The residual core selected from source (5) is outside the transported neighbor core. -/
public theorem eight_four_first_residual_core_noncontainment_local
    {G : Type u} [Group G] [Finite G]
    {S P1 P2 : Subgroup G}
    (ctx : EightFourLocalContext G S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (previous : ctx.Γ.Vertex) (hadj : ctx.Γ.adjacent ctx.criticalPath.a' previous)
    (A L0 : Subgroup G) (x : G)
    (hA : A ≤ QAt ctx.Γ previous)
    (hAnot : ¬ A ≤ QAt ctx.Γ ctx.criticalPath.a')
    (hL0 : L0 ≤ GAt ctx.Γ ctx.criticalPath.a')
    (hgen : L0 = A ⊔ conjugateBy A x) (hx : x ∈ L0)
    (hfull : L0 ⊔ (GAt ctx.Γ previous ⊓ GAt ctx.Γ ctx.criticalPath.a') =
      GAt ctx.Γ ctx.criticalPath.a') :
    ¬ twoCoreIn (twoResidualIn (L0 ⊔ QAt ctx.Γ ctx.criticalPath.a')) ≤
      QAt ctx.Γ (ctx.Γ.act x⁻¹ previous) := by
  classical
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let h := ctx.sectionSeven
  let P := stabilizer Γ cp.a'
  let next := Γ.act x⁻¹ previous
  let Pnext := stabilizer Γ next
  let Q := q Γ cp.a'
  let T := q Γ next
  let L := L0 ⊔ Q
  let R := twoResidualIn L
  let B := conjugateBy A x
  let D := Pnext ⊓ P
  let N := T ⊓ Q
  let f := (MulAut.conj x).toMonoidHom
  have hQeq : Q = twoCoreIn P := Γ.twoCoreAt_def cp.a'
  have hTeq : T = twoCoreIn Pnext := Γ.twoCoreAt_def next
  have hQP : Q ≤ P := by rw [hQeq]; exact Subgroup.map_subtype_le _
  have hLP : L ≤ P := sup_le hL0 hQP
  have hxP : x ∈ P := hL0 hx
  have hxL : x ∈ L := (show L0 ≤ L from le_sup_left) hx
  have hfix : Γ.act x⁻¹ cp.a' = cp.a' := by
    have hh := P.inv_mem hxP
    change x⁻¹ ∈ (Γ.vertexStabilizer cp.a' : Set G) at hh
    rw [Γ.stabilizer_def] at hh
    exact hh
  have hadjnext : Γ.adjacent cp.a' next := by
    have hh := adjacent_act Γ x⁻¹ hadj
    rwa [hfix] at hh
  have hnext := (SevenSix.mem_neighborhood_iff_adjacent Γ).mpr hadjnext
  have hPmap : P.map f = P :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp (P.le_normalizer hxP)
  have hLmap : L.map f = L :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp (L.le_normalizer hxL)
  have hL0map : L0.map f = L0 :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp (L0.le_normalizer hx)
  have hQnorm : P ≤ Subgroup.normalizer (Q : Set G) :=
    SevenSix.stabilizer_le_normalizer_q Γ cp.a'
  have hQmap : Q.map f = Q :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp (hQnorm hxP)
  have hprevmap : (stabilizer Γ previous).map f = Pnext := by
    simp only [Pnext, next, stabilizer_act, conjugateBy, inv_inv, f]
  have hTmap : (q Γ previous).map f = T := by
    simp only [T, next, SevenSix.q_act, inv_inv, f]
  have hBT : B ≤ T := (Subgroup.map_mono hA).trans_eq hTmap
  have hBL0 : B ≤ L0 := by rw [hgen]; exact le_sup_right
  have hBP : B ≤ P := hBL0.trans hL0
  have hBnot : ¬ B ≤ Q := by
    intro hBQ
    apply hAnot
    exact (Subgroup.map_le_map_iff_of_injective (MulAut.conj x).injective).mp
      (hBQ.trans_eq hQmap.symm)
  have hTnot : ¬ T ≤ Q := fun hh => hBnot (hBT.trans hh)
  have hnewgen : L0 ⊔ D = P := by
    have hm := congrArg (Subgroup.map f) hfull
    change (L0 ⊔ (stabilizer Γ previous ⊓ P)).map f = P.map f at hm
    rw [Subgroup.map_sup, Subgroup.map_inf _ _ _ (MulAut.conj x).injective,
      hL0map, hprevmap, hPmap] at hm
    exact hm
  have hDnorm : D ≤ Subgroup.normalizer (N : Set G) :=
    (le_inf (inf_le_left.trans (SevenSix.stabilizer_le_normalizer_q Γ next))
      (inf_le_right.trans hQnorm)).trans Subgroup.inf_normalizer_le_normalizer_inf
  have hQD : Q ≤ D := le_inf
    ((lemma_seven_three h Γ).sylow_and_core _ _ hnext default).2.2 hQP
  have hBD : B ≤ D := le_inf (hBT.trans (by
    rw [hTeq]; exact Subgroup.map_subtype_le _)) hBP
  have hQp : IsPGroup 2 Q := by
    rw [hQeq]
    exact (pCore_isPGroup (p := 2) (G := P)).map P.subtype
  have hQL : NormalIn Q L := ⟨le_sup_right,
    Subgroup.normal_subgroupOf_of_le_normalizer (hLP.trans hQnorm)⟩
  intro hcontained
  change twoCoreIn R ≤ T at hcontained
  have hcomm : ⁅Q, R⁆ ≤ N := le_inf
    ((normal_two_commutator_le_residual_core Q L hQL hQp).trans hcontained)
    (Subgroup.le_normalizer_iff_commutator_le_left.mp
      ((SevenSix.twoResidualIn_le L).trans (hLP.trans hQnorm)))
  have hRnorm : R ≤ Subgroup.normalizer (N : Set G) :=
    Subgroup.le_normalizer_iff_commutator_le_left.mpr
      ((Subgroup.commutator_mono inf_le_right le_rfl).trans hcomm)
  let U := Q ⊔ A
  have hUmap : U.map f = Q ⊔ B := by
    rw [Subgroup.map_sup, hQmap]
    rfl
  have hUgen : U ⊔ U.conjBy x = L := by
    change (Q ⊔ A) ⊔ U.map f = L0 ⊔ Q
    rw [hUmap, hgen]
    change (Q ⊔ A) ⊔ (Q ⊔ B) = (A ⊔ B) ⊔ Q
    ac_rfl
  have hsupp : R ⊔ U = L := residual_sup_of_inside_conjugate_generation U L x hxL hUgen
  have hRmap : R.map f = R :=
    map_twoResidualAmbient_of_subgroup_image L f L hLmap
  have hsuppB : R ⊔ (Q ⊔ B) = L := by
    have hm := congrArg (Subgroup.map f) hsupp
    rwa [Subgroup.map_sup, hRmap, hUmap, hLmap] at hm
  have hLnorm : L ≤ Subgroup.normalizer (N : Set G) := by
    rw [← hsuppB]
    exact sup_le hRnorm ((sup_le hQD hBD).trans hDnorm)
  have hPnorm : P ≤ Subgroup.normalizer (N : Set G) := by
    rw [← hnewgen]
    exact sup_le ((le_sup_left : L0 ≤ L).trans hLnorm) hDnorm
  let W0 : Sylow 2 ↥(P ⊓ Pnext) := default
  let W := sylowTwoAmbient (P ⊓ Pnext) W0
  have hWnext : IsSylowTwoIn W Pnext :=
    ((lemma_seven_three h Γ).sylow_and_core _ _ hnext W0).2.1
  have hTW : T ≤ W := by
    obtain ⟨_, Y, hY⟩ := hWnext
    rw [hTeq, ← hY]
    exact Subgroup.map_mono (pCore_isPGroup.le_sylow_of_normal Y)
  have hTn : (T.subgroupOf W).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer
      (hWnext.1.trans (SevenSix.stabilizer_le_normalizer_q Γ next))
  have hd := edge_sectionThree_data h Γ hnext W0
  have hNn : ((T ⊓ twoCoreAmbient P).subgroupOf P).Normal := by
    have hh : N.subgroupOf P |>.Normal := Subgroup.normal_subgroupOf_of_le_normalizer hPnorm
    change ((T ⊓ Q).subgroupOf P).Normal at hh
    rw [hQeq] at hh
    exact hh
  have htransfer := SectionThree.residual_core_transfer_of_solvable W hd.1 P hd.2.1 T
    ⟨hTW, hTn⟩ hd.2.2.2.1 hNn (by
      change ¬ T ≤ twoCoreIn P
      simpa only [hQeq] using hTnot)
  apply eight_four_terminal_core_noncontainment_local ctx hcenter next hadjnext
  change twoCoreIn (Γ.twoResidualAt cp.a') ≤ T
  rw [Γ.twoResidualAt_def]
  exact htransfer.trans inf_le_left


/-- Canonical specialization preserving all supplied local data. -/
public theorem eight_four_first_residual_core_noncontainment
    {G : Type u} [Group G] [Finite G]
    {S0 : Sylow 2 G} {S P1 P2 : Subgroup G}
    (ctx : SectionEightContext G S0 S P1 P2)
    (hcenter : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      CenterAmbient (GAt ctx.Γ ctx.criticalPath.firstStep))
    (previous : ctx.Γ.Vertex) (hadj : ctx.Γ.adjacent ctx.criticalPath.a' previous)
    (A L0 : Subgroup G) (x : G)
    (hA : A ≤ QAt ctx.Γ previous)
    (hAnot : ¬ A ≤ QAt ctx.Γ ctx.criticalPath.a')
    (hL0 : L0 ≤ GAt ctx.Γ ctx.criticalPath.a')
    (hgen : L0 = A ⊔ conjugateBy A x) (hx : x ∈ L0)
    (hfull : L0 ⊔ (GAt ctx.Γ previous ⊓ GAt ctx.Γ ctx.criticalPath.a') =
      GAt ctx.Γ ctx.criticalPath.a') :
    ¬ twoCoreIn (twoResidualIn (L0 ⊔ QAt ctx.Γ ctx.criticalPath.a')) ≤
      QAt ctx.Γ (ctx.Γ.act x⁻¹ previous) := by
  exact eight_four_first_residual_core_noncontainment_local ctx.toEightFourContext hcenter previous hadj A L0 x hA hAnot hL0 hgen hx hfull

end Stellmacher.SectionEight
