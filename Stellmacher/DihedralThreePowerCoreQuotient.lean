module

public import Stellmacher.SectionThree.PrimitiveDihedralExtraction
public import Stellmacher.TwoResidualSylowSupplement
public import Theory.GroupTheory.SpecificGroups.CyclicInvertedDihedral
public import Theory.Frattini.PGroup
public import Theory.GroupTheory.NormalCoreIntersection
public import BenderSuzuki.External.Huppert.V.FrattiniQuotient
public import Stellmacher.SectionOne.RankOneThreeGroupAssembly.Defs

/-!
# Recognizing the ordinary dihedral three-power core quotient

Let a finite solvable group have nontrivial two-core and a unique maximal
overgroup of the supplied Sylow two-subgroup. If that Sylow has relative
index two over the core and the group maps onto `SL₂(2)`, then the quotient
by the two-core is an ordinary dihedral group with rotation order `3^n`.
The index hypothesis refers to the actual Sylow subgroup of the core
quotient; no action-image index is substituted for it.

The core quotient's Sylow image has order two. Its kernel on the original
Sylow is maximal, so it contains the Sylow's Frattini subgroup. This gives
the hypotheses for the primitive dihedral extraction in (3.6), producing a
cyclic odd-prime-power rotation subgroup outside the residual's Frattini
subgroup and an involution inverting it.

To prove these generators fill the whole quotient, apply (3.3) in that
core-free quotient. The normal core of its unique maximal subgroup is the
Frattini subgroup of its odd-prime residual. The residual's commutator lies
there, which makes its intersection with the maximal subgroup lie in the
same normal core. Thus the extracted rotation lies outside the unique
maximal subgroup. It generates the whole quotient together with the Sylow
image, and that image is generated by the distinguished reflection.
The cyclic-inverted-subgroup presentation now gives the dihedral isomorphism.
Only afterward does the surjection onto `SL₂(2)` force the odd prime to be
three: three divides the group order, cannot divide the two-core order,
and hence divides the dihedral rotation order.

The native top-subgroup equivalence transfers the source interfaces back to
the literal quotient `G/O₂(G)`. Source: Stellmacher, Journal of Algebra 190
(1997), (3.3) and (3.6), pp.21–23, used in the one-factor case of (6.3),
p.31; `refs/latex/stellmacher-n-group.tex`.
-/

namespace Stellmacher
open SectionThree

private theorem rotation_generates
    {Q : Type*} [Group Q] [Finite Q]
    (T : Sylow 2 Q) (hTcard : Nat.card T = 2)
    (B : Subgroup Q) (hB : IsCoatom B) (hTB : (T : Subgroup Q) ≤ B)
    (huniq : ∀ M : Subgroup Q, IsCoatom M → (T : Subgroup Q) ≤ M → M = B)
    (hcore : pCore 2 Q = ⊥) (hsolv : Group.IsSolvable Q)
    (K : Subgroup Q) (hKcyclic : IsCyclic K)
    (hKR : K ≤ twoResidualAmbient (⊤ : Subgroup Q))
    (hKPhi : ¬ K ≤ frattiniAmbient (twoResidualAmbient (⊤ : Subgroup Q)))
    (s : Q) (hs : IsInvolution s) (hsT : s ∈ (T : Subgroup Q))
    (hinv : ∀ r : Q, r ∈ K → s * r * s⁻¹ = r⁻¹) :
    Nonempty (Q ≃* DihedralGroup (Nat.card K)) := by
  obtain ⟨p, hp, hpodd, hRp, hBcore, _⟩ :=
    solvable_primitive_two_local (T : Subgroup Q) B T rfl hB hTB huniq hcore hsolv
  let R := twoResidualAmbient (⊤ : Subgroup Q)
  let _ : Fact p.Prime := ⟨hp⟩
  let _ : Fact (IsPGroup p R) := ⟨hRp⟩
  let _ : R.Normal := by
    dsimp [R]
    rw [twoResidualAmbient_top_eq_hktPResidual]
    exact BenderSuzuki.External.hktPResidual_normal
  have hRgen : R ⊔ B = ⊤ := by
    apply top_unique
    rw [← twoResidualAmbient_top_sup_sylow T]
    exact sup_le le_sup_left (hTB.trans le_sup_right)
  have hcomm : ⁅R, R⁆ ≤ B.normalCore := by
    rw [hBcore, ← Subgroup.map_subtype_commutator]
    exact Subgroup.map_mono (commutator_le_frattini_of_isPGroup (R := R) (p := p))
  have hRB : R ⊓ B ≤ B.normalCore := Subgroup.inf_le_normalCore_of_commutator_le R B hRgen hcomm
  have hKnotB : ¬ K ≤ B := by
    intro hKB
    apply hKPhi
    rw [← hBcore]
    exact (le_inf hKR hKB).trans hRB
  have hKT : K ⊔ (T : Subgroup Q) = ⊤ := by
    rcases eq_top_or_exists_le_coatom (K ⊔ (T : Subgroup Q)) with htop | ⟨M, hM, hle⟩
    · exact htop
    · have hMB := huniq M hM (le_sup_right.trans hle)
      exact (hKnotB (hMB ▸ (le_sup_left.trans hle))).elim
  have hzp : Subgroup.zpowers s = (T : Subgroup Q) := by
    apply Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hsT)
    rw [Nat.card_zpowers, orderOf_eq_prime hs.2 hs.1, hTcard]
  have hsnotK : s ∉ K := by
    intro hsK
    have hord : orderOf (⟨s, hKR hsK⟩ : R) ∣ Nat.card R := orderOf_dvd_natCard _
    obtain ⟨n, hn⟩ := hRp.exists_card_eq
    change Nat.card R = p ^ n at hn
    have hdiv : 2 ∣ p ^ n := by
      rw [Subgroup.orderOf_mk, orderOf_eq_prime hs.2 hs.1, hn] at hord
      exact hord
    exact hpodd.pow.not_two_dvd_nat hdiv
  obtain ⟨e⟩ := K.nonempty_mulEquiv_dihedralGroup_of_cyclic_inverted s hKcyclic hs.2 hsnotK hinv
  have hgen : K ⊔ Subgroup.zpowers s = ⊤ := by rw [hzp, hKT]
  exact ⟨(Subgroup.topEquiv.symm.trans (MulEquiv.subgroupCongr hgen.symm)).trans e⟩

private theorem coatom_of_index_two {G : Type*} [Group G] [Finite G]
    (N : Subgroup G) (hindex : N.index = 2) : IsCoatom N := by
  refine ⟨?_, ?_⟩
  · intro htop
    rw [htop, Subgroup.index_top] at hindex
    omega
  · intro K hNK
    have hdvd := Subgroup.index_dvd_of_le hNK.le
    rw [hindex] at hdvd
    rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with h1 | h2
    · exact Subgroup.index_eq_one.mp h1
    · have := Subgroup.index_strictAnti hNK
      omega

private theorem dihedral_prime_power_of_pSet
    {G : Type*} [Group G] [Finite G]
    (S : Subgroup G) (h : SectionThree.Hypotheses G S)
    (P : Subgroup G) (hP : P ∈ SectionThree.PSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable P)
    (hindex : (pCore 2 P).relIndex (S.subgroupOf P) = 2) :
    ∃ p n : ℕ, p.Prime ∧ Odd p ∧ Nonempty ((P ⧸ pCore 2 P) ≃* DihedralGroup (p ^ n)) := by
  classical
  let _ : Group.IsSolvable P := hsolv
  have hSP : S ≤ P := SectionThree.sylow_le_of_mem_PSet hP
  obtain ⟨TP, hTPmap⟩ := hP.1.2.1
  have hTP : (TP : Subgroup P) = S.subgroupOf P := by
    apply Subgroup.map_injective P.subtype_injective
    rw [hTPmap, Subgroup.map_subgroupOf_eq_of_le hSP]
  let O := pCore 2 P
  let Q := P ⧸ O
  let q : P →* Q := QuotientGroup.mk' O
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective O
  have hker : q.ker = O := QuotientGroup.ker_mk' O
  have hO : O ≤ (TP : Subgroup P) := (pCore_isPGroup (p := 2) (G := P)).le_sylow_of_normal TP
  let Tbar := TP.mapSurjective hq
  have hTbarCard : Nat.card Tbar = 2 := by
    change Nat.card ((TP : Subgroup P).map q) = 2
    rw [← Subgroup.relIndex_ker, hker, hTP]
    exact hindex
  have hnot : ¬ S.subgroupOf P ≤ O := by
    intro hle
    have hi : O.relIndex (S.subgroupOf P) = 1 := Subgroup.relIndex_eq_one.mpr hle
    change (pCore 2 P).relIndex (S.subgroupOf P) = 1 at hi
    omega
  obtain ⟨aP, haS, haO⟩ := Set.not_subset.mp hnot
  let a : G := aP
  have haCore : a ∉ twoCoreAmbient P := by
    rintro ⟨b, hb, hba⟩
    have heq : b = aP := P.subtype_injective hba
    exact haO (heq ▸ hb)
  let f : S →* Q := q.comp (Subgroup.inclusion hSP)
  have hfrange : f.range = (S.subgroupOf P).map q := by
    ext y
    constructor
    · rintro ⟨s, rfl⟩
      exact ⟨⟨s, hSP s.property⟩, s.property, rfl⟩
    · rintro ⟨x, hx, rfl⟩
      exact ⟨⟨x, hx⟩, rfl⟩
  have hfindex : f.ker.index = 2 := by
    rw [Subgroup.index_ker, hfrange, ← hTP]
    exact hTbarCard
  have hPhi : frattiniAmbient S ≤ twoCoreAmbient P := by
    rintro x ⟨s, hs, rfl⟩
    have hsK : s ∈ f.ker := frattini_le_coatom (coatom_of_index_two f.ker hfindex) hs
    have hsO : (⟨s, hSP s.property⟩ : P) ∈ O :=
      (QuotientGroup.eq_one_iff (N := O) _).mp hsK
    exact Subgroup.mem_map_of_mem P.subtype hsO
  have hTnormal : (S.subgroupOf S).Normal := by rw [Subgroup.subgroupOf_self]; infer_instance
  let d := SectionThree.solvablePrimitive_dihedralExtraction S h P hP S
    ⟨le_rfl, hTnormal⟩ S le_rfl a haS haCore hPhi hsolv (fun hle => haCore (hle haS))
  let K := (d.F₀.subgroupOf P).map q
  let s : Q := q ⟨a, (SectionThree.sylow_le_of_mem_PSet hP) haS⟩
  have hs : IsInvolution s := d.reflection_involution
  have hsT : s ∈ (Tbar : Subgroup Q) := by
    change s ∈ (TP : Subgroup P).map q
    apply Subgroup.mem_map_of_mem
    rw [hTP]
    exact haS
  have hKcyclic : IsCyclic K := by
    change IsCyclic ((d.F₀.subgroupOf P).map q)
    rw [d.rotation_eq]
    infer_instance
  obtain ⟨B, hBmax, hSB, hBuniq⟩ := hP.2
  have hSPB : S.subgroupOf P ≤ B := by
    intro x hx
    obtain ⟨b, hb, hbx⟩ := hSB hx
    have heq : b = x := P.subtype_injective hbx
    simpa [heq] using hb
  have hOB : O ≤ B := hO.trans (hTP ▸ hSPB)
  let Bbar := B.map q
  have hBbarMax : IsCoatom Bbar :=
    BenderSuzuki.External.hkt_isCoatom_map_of_surjective_of_ker_le q hq
      (by simpa only [hker] using hOB) hBmax
  have hTBbar : (Tbar : Subgroup Q) ≤ Bbar := by
    change (TP : Subgroup P).map q ≤ B.map q
    exact Subgroup.map_mono (hTP ▸ hSPB)
  have hBbarUnique : ∀ M : Subgroup Q, IsCoatom M → (Tbar : Subgroup Q) ≤ M → M = Bbar := by
    intro M hM hTM
    have hMB : M.comap q = B := by
      apply hBuniq (M.comap q) (Subgroup.isCoatom_comap_of_surjective hq hM)
      rw [← Subgroup.map_subgroupOf_eq_of_le hSP]
      apply Subgroup.map_mono
      intro x hx
      exact hTM (Subgroup.mem_map_of_mem q (hTP ▸ hx))
    change M = B.map q
    rw [← hMB, Subgroup.map_comap_eq_self_of_surjective hq]
  have hcoreQ : pCore 2 Q = ⊥ := by
    have hm := pCore_map_mk'_eq_of_normal_isPGroup
      (G := P) (p := 2) O (pCore_isPGroup (p := 2) (G := P))
    have hbot : (pCore 2 P).map q = ⊥ := (Subgroup.map_eq_bot_iff _).mpr hker.ge
    exact hm.symm.trans hbot
  have he := rotation_generates Tbar hTbarCard Bbar hBbarMax hTBbar hBbarUnique hcoreQ
    (inferInstance : Group.IsSolvable Q) K hKcyclic d.rotation_le_residual
    d.rotation_not_residual_frattini s hs hsT d.reflected
  refine ⟨d.p, d.n, d.prime_p, d.odd_p, ?_⟩
  change Nonempty (Q ≃* DihedralGroup (d.p ^ d.n))
  have hcard : Nat.card K = d.p ^ d.n := d.rotation_card
  rwa [hcard] at he

public theorem dihedral_three_power_core_quotient
    {G : Type*} [Group G] [Finite G]
    (hsolv : Group.IsSolvable G) (S : Sylow 2 G)
    (hcore : pCore 2 G ≠ ⊥)
    (hunique : IsUniqueMaximalContaining (S : Subgroup G) (⊤ : Subgroup G))
    (hindex : (pCore 2 G).relIndex (S : Subgroup G) = 2)
    {X : Type*} [Group X] [Finite X]
    (q : G →* X) (hq : Function.Surjective q) (hX : IsSL2Two X) :
    ∃ n : ℕ, Nonempty ((G ⧸ pCore 2 G) ≃* DihedralGroup (3 ^ n)) := by
  let _ : Group.IsSolvable G := hsolv
  have hXcard := SectionOne.RankOneThreeGroupAssembly.isSL2Two_card hX
  have hXdiv : 6 ∣ Nat.card G := by
    rw [← hXcard]
    exact Subgroup.card_dvd_of_surjective q hq
  have heven : Even (Nat.card G) := even_iff_two_dvd.mpr
    ((show 2 ∣ 6 by decide).trans hXdiv)
  have hSne : (S : Subgroup G) ≠ ⊥ := S.ne_bot_of_dvd_card heven.two_dvd
  have hScore : (S : Subgroup G) ≠ pCore 2 G := by
    intro heq
    rw [heq, Subgroup.relIndex_self] at hindex
    omega
  have hcoreTop : twoCoreAmbient (⊤ : Subgroup G) = pCore 2 G :=
    pCore_map_iso 2 (Subgroup.topEquiv : (⊤ : Subgroup G) ≃* G)
  have hP : (⊤ : Subgroup G) ∈ SectionThree.PSet (⊤ : Subgroup G) (S : Subgroup G) := by
    refine ⟨⟨le_rfl, ⟨S.subtype le_top, ?_⟩, ?_, ?_⟩, hunique⟩
    · rw [Sylow.coe_subtype, Subgroup.map_subgroupOf_eq_of_le le_top]
    · rwa [hcoreTop]
    · rwa [hcoreTop]
  have hindexTop : (pCore 2 (⊤ : Subgroup G)).relIndex
      ((S : Subgroup G).subgroupOf ⊤) = 2 := by
    rw [← Subgroup.relIndex_map_map_of_injective
      (pCore 2 (⊤ : Subgroup G)) ((S : Subgroup G).subgroupOf ⊤)
      (⊤ : Subgroup G).subtype_injective,
      Subgroup.map_subgroupOf_eq_of_le le_top]
    change (twoCoreAmbient (⊤ : Subgroup G)).relIndex (S : Subgroup G) = 2
    rwa [hcoreTop]
  obtain ⟨p, n, hp, _hpodd, e⟩ := dihedral_prime_power_of_pSet (S : Subgroup G)
    ⟨heven, hSne, S.isPGroup'⟩ (⊤ : Subgroup G) hP (inferInstance : Group.IsSolvable (⊤ : Subgroup G))
    hindexTop
  let eQ : ((⊤ : Subgroup G) ⧸ pCore 2 (⊤ : Subgroup G)) ≃* (G ⧸ pCore 2 G) :=
    QuotientGroup.congr _ _ Subgroup.topEquiv (pCore_map_iso 2 Subgroup.topEquiv)
  obtain ⟨e⟩ := e
  let eD := eQ.symm.trans e
  have hDcard : Nat.card (G ⧸ pCore 2 G) = 2 * p ^ n := by
    rw [Nat.card_congr eD.toEquiv, DihedralGroup.nat_card]
  have hthree : 3 ∣ Nat.card G := (show 3 ∣ 6 by decide).trans hXdiv
  have hnotCore : ¬ 3 ∣ Nat.card (pCore 2 G) := by
    obtain ⟨m, hm⟩ := (pCore_isPGroup (p := 2) (G := G)).exists_card_eq
    rw [hm]
    intro hd
    have := Nat.prime_three.dvd_of_dvd_pow hd
    norm_num at this
  have hthreeQ : 3 ∣ Nat.card (G ⧸ pCore 2 G) := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (pCore 2 G)] at hthree
    exact (Nat.prime_three.dvd_mul.mp hthree).resolve_right hnotCore
  have hp3 : p = 3 := by
    rw [hDcard] at hthreeQ
    have hpow : 3 ∣ p ^ n := (Nat.prime_three.dvd_mul.mp hthreeQ).resolve_left (by decide)
    exact ((Nat.prime_dvd_prime_iff_eq Nat.prime_three hp).mp
      (Nat.prime_three.dvd_of_dvd_pow hpow)).symm
  subst p
  exact ⟨n, ⟨eD⟩⟩

end Stellmacher
