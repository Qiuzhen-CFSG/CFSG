module

public import Stellmacher.SectionOne
public import FeitThompson.PGroup.Omega
public import FeitThompson.PCore.PCore
public import Mathlib.GroupTheory.Frattini
public import Mathlib.GroupTheory.IsSubnormal
public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
open Theory.GroupAction
open Theory.ElementaryAbelian


/-!
Shared statement-level notation for Sections 1--4 of Stellmacher.

The paper uses a substantial amount of standard finite-group notation which is
not bundled in one Mathlib namespace (`O^2`, `\mathcal L`, `\mathcal P`, and
internal direct products).  This file gives explicit predicates for that
notation.  The numbered-result files import this interface and keep one source
result per file.
-/

open scoped BigOperators Pointwise

universe u v

namespace Stellmacher

/-! ## Generic finite-group helpers -/

/-- The `2`-residual `O^2(H)`, as an intersection of normal subgroups of
`2`-power index.  The subgroup is formed internally in `H`; use
`twoResidualAmbient` when an ambient subgroup of `G` is wanted. -/
@[expose] public noncomputable def twoResidualSubgroup
    {G : Type u} [Group G] (H : Subgroup G) : Subgroup H :=
  sInf {N : Subgroup H | N.Normal ∧ ∃ n : ℕ, N.index = 2 ^ n}

@[expose] public noncomputable def twoResidualAmbient
    {G : Type u} [Group G] (H : Subgroup G) : Subgroup G :=
  (twoResidualSubgroup H).map H.subtype

/- The paper writes `O^{2'}` for the subgroup generated by the Sylow
`2`-subgroups. -/
@[expose] public noncomputable def twoPrimeResidualSubgroup
    {G : Type u} [Group G] (H : Subgroup G) : Subgroup H :=
  ⨆ P : Sylow 2 H, (P : Subgroup H)

@[expose] public noncomputable def twoPrimeResidualAmbient
    {G : Type u} [Group G] (H : Subgroup G) : Subgroup G :=
  (twoPrimeResidualSubgroup H).map H.subtype

@[expose] public noncomputable def twoCoreAmbient
    {G : Type u} [Group G] (H : Subgroup G) : Subgroup G :=
  (pCore 2 H).map H.subtype

@[expose] public noncomputable def oddCoreAmbient
    {G : Type u} [Group G] (H : Subgroup G) : Subgroup G :=
  (pPrimeCore 2 H).map H.subtype

@[expose] public noncomputable def ambientCommutator
    {G : Type u} [Group G] (E V : Subgroup G) : Subgroup G :=
  ⁅E, V⁆

/-- The source's finite product of a family of subgroups.  Besides the
generated subgroup, we record the pairwise trivial intersections and
commutation which make the product internal. -/
@[expose] public def IsInternalDirectProduct
    {G : Type u} [Group G]
    (H : Subgroup G) (K : Finset (Subgroup G)) : Prop :=
  H = ⨆ K' : {K' // K' ∈ K}, (K' : Subgroup G) ∧
    (∀ A : Subgroup G, A ∈ K → (A.subgroupOf H).Normal) ∧
    (∀ A : Subgroup G, A ∈ K → ∀ B : Subgroup G, B ∈ K →
      A ≠ B → Disjoint A B) ∧
    (∀ A : Subgroup G, A ∈ K → ∀ B : Subgroup G, B ∈ K →
      A ≠ B → ∀ a : G, a ∈ A → ∀ b : G, b ∈ B → a * b = b * a)

@[expose] public def IsInternalDirectProductFamily
    {G : Type u} [Group G]
    (H : Subgroup G) {ι : Type v} (K : ι → Subgroup G) : Prop :=
  H = ⨆ i : ι, K i ∧
    (∀ i j : ι, i ≠ j → Disjoint (K i) (K j)) ∧
    (∀ i j : ι, i ≠ j → ∀ a : G, a ∈ K i → ∀ b : G, b ∈ K j → a * b = b * a)

@[expose] public def IsSylowSubgroupIn
    {G : Type u} [Group G] (S E : Subgroup G) : Prop :=
  ∃ P : Sylow 2 E, P.map E.subtype = S

/-! A few relative-subgroup predicates used repeatedly below.  We keep the
relative ambient group explicit: this avoids silently treating a subgroup of
`G` as a subgroup of an unrelated local subgroup. -/

@[expose] public def IsSubnormalIn
    {G : Type u} [Group G] (A L : Subgroup G) : Prop :=
  A ≤ L ∧ (A.subgroupOf L).IsSubnormal

@[expose] public def IsConjugateInvariantBy
    {G : Type u} [Group G] (A K : Subgroup G) : Prop :=
  ∀ k : K, ∀ a : G, a ∈ A →
    (k : G) * a * (k : G)⁻¹ ∈ A

@[expose] public def IsIrreducibleSection
    {G : Type u} [Group G] (S N K : Subgroup G) : Prop :=
  N ≤ K ∧ N ≠ K ∧
    ∀ A : Subgroup G, N ≤ A → A ≤ K →
      IsConjugateInvariantBy A S → A = N ∨ A = K

@[expose] public noncomputable def frattiniAmbient
    {G : Type u} [Group G] (H : Subgroup G) : Subgroup G :=
  (frattini (↥H)).map H.subtype

@[expose] public noncomputable def omegaOneCenterAmbient
    {G : Type u} [Group G] (H : Subgroup G) : Subgroup G :=
  let ZH : Subgroup G :=
    ((omega₁ (G := Subgroup.center H) (p := 2)).map
      (Subgroup.center H).subtype).map H.subtype
  ZH

@[expose] public noncomputable def sylowAmbient
    {G : Type u} [Group G] {H : Subgroup G} (T : Sylow 2 H) : Subgroup G :=
  (T : Subgroup H).map H.subtype

@[expose] public noncomputable def conjugateClosure
    {G : Type u} [Group G] (A K : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | ∃ k : K, ∃ a : A,
    x = (k : G) * (a : G) * (k : G)⁻¹}

@[expose] public def conjugateOrbitSet
    {G : Type u} [Group G] (A K : Subgroup G) : Set G :=
  {x : G | ∃ k : K, ∃ a : A,
    x = (k : G) * (a : G) * (k : G)⁻¹}

@[expose] public def IsUniqueMaximalContaining
    {G : Type u} [Group G] (S E : Subgroup G) : Prop :=
  ∃ M : Subgroup E,
    IsCoatom M ∧
      S ≤ M.map E.subtype ∧
      ∀ M' : Subgroup E, IsCoatom M' → S ≤ M'.map E.subtype → M' = M

@[expose] public def IsOddOrderSubgroup
    {G : Type u} [Group G] (H : Subgroup G) : Prop :=
  Odd (Nat.card H)

@[expose] public def IsSL2Two (H : Type u) [Group H] [Finite H] : Prop :=
  Nonempty (H ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))

@[expose] public def IsDih2pn (H : Type u) [Group H] : Prop :=
  ∃ p : ℕ, Nonempty (H ≃* DihedralGroup p)

/-! ## Section 1 notation -/

namespace SectionOne

@[expose] public noncomputable def m
    {G V : Type u} [Group G] [Group V] [Finite V]
    [MulDistribMulAction G V] (Y : Subgroup G) : ℚ :=
  (Nat.card V : ℚ) /
    ((Nat.card (FixedPoints.subgroup Y V) : ℚ) * (Nat.card Y : ℚ))

/- The source uses two different families in Section 1.  `𝒜(V,S)` is the
family defining `J(V,S)`, while `𝒜(S)` (used in (1.5)) has the additional
centralizer conditions below. -/
@[expose] public noncomputable def oneA
    {G V : Type u} [Group G] [Group V] [Finite V]
    [MulDistribMulAction G V] (S : Subgroup G) (Y : Subgroup G) : Prop :=
  Y ≤ S ∧ IsElementaryAbelian 2 Y ∧
    m (G := G) (V := V) Y ≤ 1

@[expose] public noncomputable def oneAmax
    {G V : Type u} [Group G] [Group V] [Finite V]
    [MulDistribMulAction G V] (S : Subgroup G) (Y : Subgroup G) : Prop :=
  let C : Subgroup G :=
    ⁅(oddCore G ⊓ Subgroup.centralizer (Y : Set G)),
      (S ⊓ Subgroup.normalizer (Y : Set G) : Subgroup G)⁆
  Y ≤ S ∧
    m (G := G) (V := V) Y ≤ m (G := G) (V := V) S ∧
    (S ⊓ Subgroup.centralizer (C : Set G)) = Y ∧
    (S ⊓ fixingSubgroup G (FixedPoints.subgroup Y V : Set V)) = Y

@[expose] public noncomputable def oneJ
    {G V : Type u} [Group G] [Group V] [Finite V]
    [MulDistribMulAction G V] (S : Subgroup G) : Subgroup G :=
  sSup {Y : Subgroup G | oneA (G := G) (V := V) S Y}

@[expose] public noncomputable def oneB
    {G V : Type u} [Group G] [Group V] [Finite V]
    [MulDistribMulAction G V] (S : Subgroup G) : Subgroup G :=
  S ⊓ fixingSubgroup G
    (FixedPoints.subgroup (oneJ (G := G) (V := V) S) V : Set V)

@[expose] public noncomputable def oneE
    {G V : Type u} [Group G] [Group V] [Finite V]
    [MulDistribMulAction G V] (S : Subgroup G) : Subgroup G :=
  Subgroup.normalClosure (oneJ (G := G) (V := V) S : Set G)

@[expose] public noncomputable def oneOmega
    {G V : Type u} [Group G] [Group V] [Finite V]
    [MulDistribMulAction G V] (F : Subgroup G) : Prop :=
  F ≤ oddCore G ∧ Nat.card F = 3 ∧ Nat.card (commutatorAction F V) = 4

@[expose] public noncomputable def fixedQuotientCard
    {G V : Type u} [Group G] [Group V] [Finite V]
    [MulDistribMulAction G V] (A : Subgroup G) (X : Subgroup V) : ℚ :=
  (Nat.card X : ℚ) /
    (Nat.card (↥(X ⊓ FixedPoints.subgroup A V)) : ℚ)

/-- The iterated action commutator `[V*,S,S]` from (1.6)(b), where
`V* = [V, O_{2'}(G)]`.  Writing the two restricted commutator subgroups
explicitly avoids requiring a separate action instance on the invariant
subgroup `V*`. -/
@[expose] public def vStarAction₂
    {G V : Type u} [Group G] [Group V] [MulDistribMulAction G V]
    (S : Subgroup G) : Subgroup V :=
  commutatorSubgroup (A := S) (G := V)
    (H := commutatorSubgroup (A := S) (G := V)
      (H := commutatorAction (A := oddCore G) (G := V)))

@[expose] public noncomputable def subgroupQuotientCard
    {V : Type u} [Group V] [Finite V]
    (A B : Subgroup V) : ℚ :=
  (Nat.card A : ℚ) / (Nat.card B : ℚ)

@[expose] public noncomputable def indexWithin
    {G : Type u} [Group G] (S U : Subgroup G) : ℕ :=
  (U.subgroupOf S).index

@[expose] public noncomputable def oneCentralizerIn
    {G : Type u} [Group G] (S A : Subgroup G) : Subgroup G :=
  S ⊓ Subgroup.centralizer (A : Set G)

@[expose] public noncomputable def oneDirectFactors
    {G V : Type u} [Group G] [Group V] [Finite V]
    [MulDistribMulAction G V]
    (W0 : Subgroup G) (F : Finset (Subgroup G)) : Prop :=
  IsInternalDirectProduct W0 F

/-- A compact record for the four alternatives in (1.6). -/
public inductive LemmaOneSixConclusion
    {G V : Type u} [Group G] [Group V] [Finite G] [Finite V]
    [MulDistribMulAction G V] (S : Subgroup G) : Prop
  | small (_ : Nat.card S = 2) (_ : m (G := G) (V := V) S > 1)
  | doubleSL2
      (_ : m (G := G) (V := V) S = 2)
      (_ : Nonempty (G ≃* (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2) ×
        Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))))
      (_ : Nat.card (commutatorAction (oddCore G) V) = 2 ^ 4)
      (_ : vStarAction₂ (G := G) (V := V) S ≠ ⊥)
  | omegaProduct
      (_ : ∃ F : Finset (Subgroup G),
        (∀ X : Subgroup G, X ∈ F → oneOmega (G := G) (V := V) X) ∧
        IsInternalDirectProduct (oddCore G) F)
      (_ : commutatorAction₂ S V = ⊥)
      (_ : fixedQuotientCard (G := G) (V := V) S
          (commutatorAction (oddCore G) V) = (2 * Nat.card S : ℚ))
  | sl2Product
      (_ : ∃ F : Finset (Subgroup G),
        (∀ E : Subgroup G, E ∈ F →
          IsSL2Two (↥E) ∧
            oneOmega (G := G) (V := V)
              ((commutator (↥E)).map E.subtype)) ∧
        IsInternalDirectProduct (oddCore G ⊔ S) F)
      (_ : commutatorAction₂ S V = ⊥)
      (_ : fixedQuotientCard (G := G) (V := V) S
          (commutatorAction (oddCore G) V) = (Nat.card S : ℚ))

end SectionOne

/-- The elementary abelian subgroups of maximal order in a 2-subgroup.  This
is the `\mathcal A(S)` family used for the Section 2/4 Thompson-style
subgroup; Mathlib's `thompsonSubgroup` instead ranges over all abelian
subgroups, so it is intentionally not used here. -/
@[expose] public noncomputable def elementaryAbelianMaxSubgroups
    {G : Type u} [Group G] (S : Subgroup G) : Set (Subgroup G) :=
  {A : Subgroup G |
    A ≤ S ∧ IsElementaryAbelian 2 A ∧
      ∀ B : Subgroup G, B ≤ S → IsElementaryAbelian 2 B →
        Nat.card B ≤ Nat.card A}

@[expose] public noncomputable def elementaryAbelianMaxJ
    {G : Type u} [Group G] (S : Subgroup G) : Subgroup G :=
  sSup (elementaryAbelianMaxSubgroups S)

/-! ## Section 2 notation and quotient setup -/

namespace SectionTwo

@[expose] public noncomputable def zSubgroup
    {G : Type u} [Group G] (S : Sylow 2 G) : Subgroup G :=
  omegaOneCenterAmbient (S : Subgroup G)

@[expose] public noncomputable def vSubgroup
    {G : Type u} [Group G] (S : Sylow 2 G) : Subgroup G :=
  Subgroup.normalClosure (zSubgroup S : Set G)

@[expose] public noncomputable def cSubgroup
    {G : Type u} [Group G] (S : Sylow 2 G) : Subgroup G :=
  Subgroup.centralizer (vSubgroup S : Set G)

/- The quotient `\bar G=G/C_G(V)` is represented in the numbered statements
by a surjective homomorphism with the indicated kernel. -/

end SectionTwo

/-! ## Section 3 notation -/

namespace SectionThree

public structure Hypotheses
    (G : Type u) [Group G] [Finite G] (S : Subgroup G) : Prop where
  even_order : Even (Nat.card G)
  nontrivial_two_subgroup : S ≠ ⊥ ∧ IsPGroup 2 S

@[expose] public def IsMinimalNormalOver
    {G : Type u} [Group G] (N H H₀ : Subgroup G) : Prop :=
  N ≤ H₀ ∧ H₀ ≤ H ∧ H₀ ≠ N ∧ (H₀.subgroupOf H).Normal ∧
    ∀ K : Subgroup G, N ≤ K → K ≤ H → (K.subgroupOf H).Normal →
      K ≤ H₀ → K = N ∨ K = H₀

@[expose] public def LSet
    {G : Type u} [Group G] (U S : Subgroup G) : Set (Subgroup G) :=
  {E | E ≤ U ∧ IsSylowSubgroupIn S E ∧ twoCoreAmbient E ≠ ⊥ ∧
    S ≠ twoCoreAmbient E}

@[expose] public def PSet
    {G : Type u} [Group G] (U S : Subgroup G) : Set (Subgroup G) :=
  {E | E ∈ LSet U S ∧ IsUniqueMaximalContaining S E}

@[expose] public def maxLSet
    {G : Type u} [Group G] (U S : Subgroup G) : Set (Subgroup G) :=
  {L | L ∈ LSet U S ∧ ∀ L' : Subgroup G, L' ∈ LSet U S → L ≤ L' → L' = L}

@[expose] public def PStarSet
    {G : Type u} [Group G] (U S : Subgroup G) : Set (Subgroup G) :=
  {E | E ∈ PSet U S ∧
    ∃ L : Subgroup G, L ∈ maxLSet U S ∧
      IsSubnormalIn (twoResidualAmbient E) L}

@[expose] public def phiTwo
    {G : Type u} [Group G] (U : Subgroup G) : Subgroup G := by
  let q : U →* (U ⧸ pCore 2 U) := QuotientGroup.mk' (pCore 2 U)
  exact (frattini (U ⧸ pCore 2 U)).comap q |>.map U.subtype

@[expose] public noncomputable def twoResidualImageInQuotient
    {G : Type u} [Group G] (L P : Subgroup G) :
    Subgroup (L ⧸ pCore 2 L) :=
  ((twoResidualAmbient P).subgroupOf L).map
    (QuotientGroup.mk' (pCore 2 L))

end SectionThree

/-! ## Section 4 notation -/

namespace SectionFour

public structure Hypotheses
    (G : Type u) [Group G] [Finite G] (S : Sylow 2 G) : Prop where
  even_order : Even (Nat.card G)
  local_solvable_characteristicTwo :
    ∀ U : Subgroup G, Theory.Quasithin.IsTwoLocal U →
      (S : Subgroup G) ≤ U →
      Group.IsSolvable U ∧ IsCharacteristicTwoType U
  two_distinct_maximal_twoLocal :
    ∃ M₁ M₂ : Subgroup G,
      M₁ ≠ M₂ ∧
      Theory.Quasithin.IsMaximalTwoLocal M₁ ∧
      Theory.Quasithin.IsMaximalTwoLocal M₂ ∧
      (S : Subgroup G) ≤ M₁ ∧ (S : Subgroup G) ≤ M₂

@[expose] public noncomputable def localD
    {G : Type u} [Group G] (L S : Subgroup G) : Subgroup G :=
  -- `sInf` is taken over the actual family of 2-cores (not its lower cone).
  sInf {D : Subgroup G |
    ∃ P : Subgroup G, P ∈ SectionThree.PSet L S ∧ D = twoCoreAmbient P}

@[expose] public noncomputable def localDStar
    {G : Type u} [Group G] (L S : Subgroup G) : Subgroup G :=
  sInf {D : Subgroup G |
    ∃ P : Subgroup G, P ∈ SectionThree.PStarSet L S ∧ D = twoCoreAmbient P}

@[expose] public noncomputable def zSubgroup
    {G : Type u} [Group G] (S : Sylow 2 G) : Subgroup G :=
  omegaOneCenterAmbient (S : Subgroup G)

@[expose] public noncomputable def cSubgroup
    {G : Type u} [Group G] (S : Sylow 2 G) : Subgroup G :=
  Subgroup.centralizer (zSubgroup S : Set G)

@[expose] public noncomputable def dSubgroup
    {G : Type u} [Group G] (S : Sylow 2 G) : Subgroup G :=
  -- This is the intersection `⋂ P∈𝒫(S), O₂(P)`.
  sInf {D : Subgroup G | ∃ P : Subgroup G,
    P ∈ SectionThree.PSet (⊤ : Subgroup G) (S : Subgroup G) ∧
      D = twoCoreAmbient P}

@[expose] public noncomputable def mSubgroup
    {G : Type u} [Group G] (S : Sylow 2 G) : Subgroup G :=
  Subgroup.normalizer (dSubgroup S : Set G)

@[expose] public noncomputable def bSubgroup
    {G : Type u} [Group G] (S : Sylow 2 G) : Subgroup G :=
  (S : Subgroup G) ⊓
    Subgroup.centralizer
      (omegaOneCenterAmbient
        (elementaryAbelianMaxJ (S : Subgroup G)) : Set G)

@[expose] public noncomputable def pZero
    {G : Type u} [Group G] (S : Sylow 2 G) : Set (Subgroup G) :=
  SectionThree.PStarSet (cSubgroup S) (S : Subgroup G) ∪
    (SectionThree.PStarSet (⊤ : Subgroup G) (S : Subgroup G) \
      SectionThree.PSet (cSubgroup S) (S : Subgroup G))

@[expose] public noncomputable def pOne
    {G : Type u} [Group G] (S : Sylow 2 G) : Set (Subgroup G) :=
  SectionThree.PStarSet (mSubgroup S) (S : Subgroup G) ∪
    (SectionThree.PStarSet (⊤ : Subgroup G) (S : Subgroup G) \
      SectionThree.PSet (mSubgroup S) (S : Subgroup G))

@[expose] public noncomputable def pAt
    {G : Type u} [Group G] (S : Sylow 2 G) (k : ℕ) : Set (Subgroup G) :=
  if k = 0 then pZero S else pOne S

@[expose] public noncomputable def Lambda
    {G : Type u} [Group G] (S : Sylow 2 G) : Set (Subgroup G × Subgroup G) :=
  {pq : Subgroup G × Subgroup G |
    pq.1 ∈ SectionThree.PSet (⊤ : Subgroup G) (S : Subgroup G) ∧
      pq.2 ∈ SectionThree.PSet (⊤ : Subgroup G) (S : Subgroup G) ∧
      twoCoreAmbient (pq.1 ⊔ pq.2) = ⊥}

end SectionFour

end Stellmacher
