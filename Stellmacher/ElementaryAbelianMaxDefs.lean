module

public import Theory.ElementaryAbelian.Basic

/-!
# The elementary Thompson subgroup used by Stellmacher

The family A(S) consists of the elementary abelian two-subgroups of largest
order in S, and J(S) is the subgroup they generate. These are the exact
existing Section 2 definitions, shared here so the main Baumann hypothesis
and later local analysis use the same subgroup without an import cycle.
The Thompson subgroup generated by all abelian subgroups is a different
construction and is not used in this definition.

Source: Stellmacher, Section 2 notation, Journal of Algebra 190 (1997),
printed p.19.
-/

universe u

namespace Stellmacher

/-- The elementary abelian subgroups of maximal order in a 2-subgroup.  This
is the `\mathcal A(S)` family used for the Section 2/4 Thompson-style
subgroup; Mathlib's `thompsonSubgroup` instead ranges over all abelian
subgroups, so it is intentionally not used here. -/
@[expose] public noncomputable def elementaryAbelianMaxSubgroups
    {G : Type u} [Group G] (S : Subgroup G) : Set (Subgroup G) :=
  {A : Subgroup G |
    A ≤ S ∧ IsElementaryAbelian 2 A ∧
      ∀ B : Subgroup G, B ≤ S → IsElementaryAbelian 2 B →
        Nat.card B ≤ Nat.card A}

@[expose] public noncomputable def elementaryAbelianMaxJ
    {G : Type u} [Group G] (S : Subgroup G) : Subgroup G :=
  sSup (elementaryAbelianMaxSubgroups S)

end Stellmacher
