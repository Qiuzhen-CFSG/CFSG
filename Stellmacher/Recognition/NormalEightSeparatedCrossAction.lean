module

public import Stellmacher.Recognition.NormalEightSeparatedFusion
public import Stellmacher.Recognition.NormalEightNormalImageTransport
public import Stellmacher.Recognition.NormalEightSeparatedReturning
public import Stellmacher.Recognition.NormalEightSeparatedActors

/-!
# Assembly of the separated cross-action configuration

The separated case produces a disjoint commuting returning conjugate of
the normal four. Normalizer growth constructs the two actors in the
normalizer of the elementary sixteen generated by these fours. This module
assembles those results, retaining the conditional assembly interface and
discharging its actor premise in `crossAction_of_separated`.

Source: Janko–Thompson, Math. Z. 113 (1970), first half of printed p.395,
referring to the normalizer construction of Lemma 5.1 on printed p.394.
-/

namespace Stellmacher.Recognition.NormalEightSeparatedCrossAction

open Subgroup NormalFourCentralOmegaTwo NormalEightSeparatedFusion

/-- Reduce the cross-action construction to the normalizer-growth actors
around a disjoint commuting returning four. -/
public theorem crossAction_of_returning_actors
    {G : Type*} [Group G] [Finite G] [IsSimpleGroup G]
    (hns : ¬ Group.IsSolvable G) (S : Sylow 2 G)
    (A : Subgroup S) [IsElementaryAbelian 2 A] (hA : 8 ≤ Nat.card A)
    (hno : ¬ ∃ B : Subgroup S, B.Normal ∧ IsElementaryAbelian 2 B ∧ 8 ≤ Nat.card B)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (W : Subgroup S) [W.Normal] [IsElementaryAbelian 2 W] (hW : Nat.card W = 4)
    (hunique : ∀ F : Subgroup S, F.Normal → IsElementaryAbelian 2 F →
      Nat.card F = 4 → F = W)
    [(fourImage S W).Normal]
    (z : S) (hzW : z ∈ W) (hzC : z ∈ center S) (hz : orderOf z = 2)
    (hsep : Separated S W z)
    (hfactor : CentralizerFactorization S W) (hcontrol : LocalCentralizerControl S W)
    (hactors : ∀ g : G,
      (W.map (S : Subgroup G).subtype).map (MulAut.conj g).toMonoidHom ≤
        (S : Subgroup G) →
      Disjoint (W.map (S : Subgroup G).subtype)
        ((W.map (S : Subgroup G).subtype).map (MulAut.conj g).toMonoidHom) →
      (W.map (S : Subgroup G).subtype).map (MulAut.conj g).toMonoidHom ≤
        centralizer (W.map (S : Subgroup G).subtype : Set G) →
      Nonempty (CrossAction (W.map (S : Subgroup G).subtype))) :
    Nonempty (CrossAction (W.map (S : Subgroup G).subtype)) := by
  obtain ⟨g, hg, hd, hc⟩ :=
    NormalEightSeparatedReturning.exists_disjoint_commuting_returning_conjugate_four
      hns S A hA hno hZ W hW hunique z hzW hzC hz hsep hfactor hcontrol
  exact hactors g hg hd hc

set_option linter.unusedVariables false in
/-- Under the explicit local centralizer hypotheses, separation produces the
two fixed-point-free cross actions. All returning-pair and actor premises are
discharged; the quotient image of the normal four retains its normality.
The ambient N₂ and noncommutativity hypotheses are retained for the caller's
interface; this assembly only needs their supplied local consequences. -/
public theorem crossAction_of_separated
    {G : Type*} [Group G] [Finite G] [IsSimpleGroup G]
    (hns : ¬ Group.IsSolvable G) (hN : Stellmacher.IsNTwoGroup G)
    (S : Sylow 2 G)
    (A : Subgroup S) [IsElementaryAbelian 2 A] (hA : 8 ≤ Nat.card A)
    (hnonab : ¬ IsMulCommutative S)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (hno : ¬ ∃ B : Subgroup S, B.Normal ∧ IsElementaryAbelian 2 B ∧ 8 ≤ Nat.card B)
    (W : Subgroup S) [W.Normal] [IsElementaryAbelian 2 W] (hW : Nat.card W = 4)
    (hunique : ∀ F : Subgroup S, F.Normal → IsElementaryAbelian 2 F →
      Nat.card F = 4 → F = W)
    [(fourImage S W).Normal]
    (z : S) (hzW : z ∈ W) (hzC : z ∈ center S) (hz : orderOf z = 2)
    (hsep : Separated S W z)
    (hfactor : CentralizerFactorization S W) (hcontrol : LocalCentralizerControl S W) :
    Nonempty (CrossAction (W.map (S : Subgroup G).subtype)) := by
  apply crossAction_of_returning_actors hns S A hA hno hZ W hW hunique
    z hzW hzC hz hsep hfactor hcontrol
  exact NormalEightSeparatedActors.crossAction_of_returning_pair
    S hno hZ W hW hunique z hzW hzC hz hsep hfactor hcontrol

end Stellmacher.Recognition.NormalEightSeparatedCrossAction
