module

public import Stellmacher.Recognition.GTwoAbelianBase
public import Stellmacher.SectionEight.GeneratedEightSixSmallIndexInitialReduction
public import Theory.GroupTheory.InvertedIndexTwo

/-!
# The order-64 branch of the local G₂ configuration

If the ambient Sylow intersection has order 64, both vertex two-cores have
order 32 and both vertices have order 192. Thus the second core is the
quaternion central product, while the first core is generated by its
characteristic C₄ × C₄ base and an element outside that base which inverts it.
The normal abelian base has index four in every ambient Sylow subgroup.
If the elementary neighboring-core intersection lies in the first core and
has more than four elements, it supplies an involutive inverter: elementary
subgroups of C₄ × C₄ have order at most four, and every element in the outside
coset has the same inversion action. The two intersection conditions are
explicit hypotheses of this selection lemma, not consequences claimed here.

The vertex order calculation uses its actual quotient onto SL₂(2) and the
ambient Sylow contained in the vertex. It does not identify a vertex with a
full centralizer. These are local consequences only: excluding this branch
in a simple N₂ group still requires an ambient fusion argument.

Source: Stellmacher, (8.6)(a1,a2) and the subsequent local-type definition,
`refs/latex/stellmacher-n-group.tex`, printed pp. 41 and 45.
-/

namespace Stellmacher.Recognition

open Later SectionsFiveToSeven SevenSix

private theorem vertex_card_of_sylow_card64
    {G K : Type*} [Group G] [Finite G] [Group K] [Finite K]
    (f : K →* G) (hf : Function.Injective f)
    (S : Sylow 2 G) (hS : Nat.card S = 64)
    (P Q : Subgroup K) (hQP : Q ≤ P) (hQ : IsPGroup 2 Q)
    (hmodel : QuotientIsModel P Q SL2Two)
    (hSP : (S : Subgroup G) ≤ P.map f) :
    Nat.card Q = 32 ∧ Nat.card P = 192 := by
  obtain ⟨projection, hsurj, hker⟩ := hmodel
  have hcount := projection.ker.index_mul_card
  rw [Subgroup.index_ker, projection.range_eq_top_of_surjective hsurj,
    Subgroup.card_top, hker,
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hQP).toEquiv] at hcount
  have hmodelCard : Nat.card SL2Two = 6 :=
    SectionOne.RankOneThreeGroupAssembly.isSL2Two_card ⟨MulEquiv.refl _⟩
  rw [hmodelCard] at hcount
  obtain ⟨n, hn⟩ := hQ.exists_card_eq
  let T : Sylow 2 (P.map f) := S.subtype hSP
  have hT : Nat.card T = 64 :=
    (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hSP).toEquiv).trans hS
  rw [T.card_eq_multiplicity, Subgroup.card_map_of_injective hf,
    ← hcount, hn] at hT
  rw [Nat.factorization_mul (by decide) (by positivity), Nat.factorization_pow] at hT
  have h6 : (6 : ℕ).factorization 2 = 1 := by
    change (3 * 2 : ℕ).factorization 2 = 1
    rw [Nat.factorization_mul (by decide) (by decide)]
    norm_num [Nat.prime_two.factorization, Nat.prime_three.factorization]
  norm_num [h6, Nat.prime_two.factorization, pow_add] at hT
  constructor
  · omega
  · omega

/-- In the order-64 branch both actual vertices have order 192 and two-core
order 32; the second core has the quaternion central-product model. -/
public theorem gTwo_card64_vertex_structure
    {G : Type*} [Group G] [Finite G]
    (data : GTwoTwoDerivedTypeData G)
    (hcard : Nat.card data.sylowIntersection = 64) :
    letI := data.groupK
    letI := data.finiteK
    Nat.card (QAt data.Γ data.criticalPath.a) = 32 ∧
    Nat.card (GAt data.Γ data.criticalPath.a) = 192 ∧
    Nat.card (QAt data.Γ data.criticalPath.firstStep) = 32 ∧
    Nat.card (GAt data.Γ data.criticalPath.firstStep) = 192 ∧
    IsCentralProductQ8Q8 (QAt data.Γ data.criticalPath.firstStep) := by
  let := data.groupK
  let := data.finiteK
  have hvertex (d : data.Γ.Vertex)
      (hle : (data.sylowIntersection : Subgroup G) ≤
        (GAt data.Γ d).map data.embedding) :
      Nat.card (QAt data.Γ d) = 32 ∧ Nat.card (GAt data.Γ d) = 192 := by
    have hQ : QAt data.Γ d = twoCoreIn (GAt data.Γ d) := data.Γ.twoCoreAt_def d
    apply vertex_card_of_sylow_card64 data.embedding data.embedding_injective
      data.sylowIntersection hcard (GAt data.Γ d) (QAt data.Γ d)
    · rw [hQ]
      exact twoCoreIn_le _
    · rw [hQ]
      exact pCore_isPGroup.map (GAt data.Γ d).subtype
    · exact data.caseA.local_quotients d
    · exact hle
  obtain ⟨hQa, hPa⟩ := hvertex data.criticalPath.a (by
    rw [← data.intersection_eq]
    exact inf_le_left)
  obtain ⟨hQb, hPb⟩ := hvertex data.criticalPath.firstStep (by
    rw [← data.intersection_eq]
    exact inf_le_right)
  refine ⟨hQa, hPa, hQb, hPb, ?_⟩
  rcases data.caseA.next_twoCore.1 with hsmall | hlarge
  · have h16 := SectionEight.eight_six_c4_quaternion_card hsmall
    omega
  · exact hlarge

/-- The first core in the order-64 branch has a genuine outside inverter. -/
public theorem gTwo_card64_outside_inverter
    {G : Type*} [Group G] [Finite G]
    (data : GTwoTwoDerivedTypeData G)
    (hcard : Nat.card data.sylowIntersection = 64) :
    letI := data.groupK
    letI := data.finiteK
    ∃ t : data.K,
      t ∈ QAt data.Γ data.criticalPath.a ∧
      t ∉ twoCoreIn (EAt data.Γ data.criticalPath.a) ∧
      IsInvertingOn t (twoCoreIn (EAt data.Γ data.criticalPath.a)) ∧
      QAt data.Γ data.criticalPath.a =
        GeneratedWith (twoCoreIn (EAt data.Γ data.criticalPath.a)) t := by
  let := data.groupK
  let := data.finiteK
  have hQcard := (gTwo_card64_vertex_structure data hcard).1
  have hBcard : Nat.card (twoCoreIn (EAt data.Γ data.criticalPath.a)) = 16 := by
    obtain ⟨e⟩ := data.caseA.twoCore_model
    rw [Nat.card_congr e.toEquiv, Nat.card_prod]
    norm_num [C4]
  obtain ⟨t, ht, hgen⟩ := data.caseA.generated
  rw [data.caseA.Q_eq] at hgen
  have hinv : IsInvertingOn t (twoCoreIn (EAt data.Γ data.criticalPath.a)) := by
    rcases ht with rfl | hinv
    · simp only [GeneratedWith, Subgroup.zpowers_one_eq_bot, sup_bot_eq] at hgen
      rw [hgen, hBcard] at hQcard
      contradiction
    · exact hinv
  refine ⟨t, ?_, SectionEight.eight_six_inverter_outside_c4_square
    data.caseA.twoCore_model hinv, hinv, hgen⟩
  rw [hgen]
  exact Subgroup.mem_sup_right (Subgroup.mem_zpowers t)

/-- The normal abelian base has index exactly four when the Sylow order is 64. -/
public theorem exists_normal_c4_prod_c4_index_four_of_gTwo_card64
    {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    (hType : IsOfGTwoTwoDerivedType G) (hcard : Nat.card S = 64) :
    ∃ A : Subgroup S, A.Normal ∧ Nonempty (A ≃* C4 × C4) ∧ A.index = 4 := by
  obtain ⟨A, hAN, ⟨e⟩, _⟩ := exists_normal_c4_prod_c4_of_gTwoTwoDerived_type S hType
  refine ⟨A, hAN, ⟨e⟩, ?_⟩
  have hAcard : Nat.card A = 16 := by
    rw [Nat.card_congr e.toEquiv, Nat.card_prod]
    norm_num [C4]
  have hcount := A.card_mul_index
  rw [hAcard, hcard] at hcount
  omega

/-- The elementary neighboring-core intersection supplies an involutive
inverter once its containment and lower cardinality bound are established. -/
public theorem gTwo_card64_involutive_inverter_of_elementary_intersection
    {G : Type*} [Group G] [Finite G] (data : GTwoTwoDerivedTypeData G)
    (hcard : Nat.card data.sylowIntersection = 64) :
    letI := data.groupK
    letI := data.finiteK
    data.D ≤ QAt data.Γ data.criticalPath.a →
    4 < Nat.card data.D →
    ∃ t : data.K,
      t ∈ data.D ∧
      t ∈ QAt data.Γ data.criticalPath.a ∧
      t ∈ QAt data.Γ data.criticalPath.firstStep ∧
      t ∉ twoCoreIn (EAt data.Γ data.criticalPath.a) ∧
      t ^ 2 = 1 ∧
      IsInvertingOn t (twoCoreIn (EAt data.Γ data.criticalPath.a)) ∧
      QAt data.Γ data.criticalPath.a =
        GeneratedWith (twoCoreIn (EAt data.Γ data.criticalPath.a)) t := by
  let := data.groupK
  let := data.finiteK
  intro hDle hDcard
  let A := twoCoreIn (EAt data.Γ data.criticalPath.a)
  let Q := QAt data.Γ data.criticalPath.a
  obtain ⟨e⟩ := data.caseA.twoCore_model
  have hAcard : Nat.card A = 16 := by
    rw [Nat.card_congr e.toEquiv, Nat.card_prod]
    norm_num [C4]
  have hQcard : Nat.card Q = 32 := (gTwo_card64_vertex_structure data hcard).1
  let _ : IsElementaryAbelian 2 data.D := data.caseA.base.2.2
  have hDtwo (d : data.D) : d ^ 2 = 1 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 data.D) d
  have hDnot : ¬ data.D ≤ A := by
    intro hle
    let f : data.D → {a : C4 × C4 // a ^ 2 = 1} := fun d =>
      ⟨e ⟨d, hle d.property⟩, by
        have hd : (⟨d, hle d.property⟩ : A) ^ 2 = 1 :=
          Subtype.ext (congrArg (fun x : data.D => (x : data.K)) (hDtwo d))
        rw [← map_pow, hd, map_one]⟩
    have hf : Function.Injective f := by
      intro d d' heq
      exact Subtype.ext (congrArg (fun x : A => (x : data.K))
        (e.injective (congrArg Subtype.val heq)))
    have hbound := Nat.card_le_card_of_injective f hf
    have hfour : Nat.card {a : C4 × C4 // a ^ 2 = 1} = 4 := by
      rw [Nat.card_eq_fintype_card]
      decide
    omega
  obtain ⟨d, hdD, hdA⟩ := SetLike.not_le_iff_exists.mp hDnot
  obtain ⟨t, htQ, htA, htinverts, htgen⟩ := gTwo_card64_outside_inverter data hcard
  have hAQ : A ≤ Q := by dsimp [Q]; rw [htgen]; exact le_sup_left
  have hindex : (A.subgroupOf Q).index = 2 := by
    have hcount := (A.subgroupOf Q).card_mul_index
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAQ).toEquiv,
      hAcard, hQcard] at hcount
    omega
  have hcomm : ∀ a ∈ A.subgroupOf Q, ∀ b ∈ A.subgroupOf Q, a * b = b * a := by
    intro a ha b hb
    apply Subtype.ext
    exact congrArg (fun x : A => (x : data.K)) (e.injective (show e (⟨a, ha⟩ * ⟨b, hb⟩ : A) =
      e (⟨b, hb⟩ * ⟨a, ha⟩ : A) by simp only [map_mul]; exact mul_comm _ _))
  have hdQ : d ∈ Q := hDle hdD
  have hinv : IsInvertingOn d A := by
    have h := Subgroup.inverts_of_inverted_index_two (A.subgroupOf Q) hindex hcomm
      (t := ⟨t, htQ⟩) (x := ⟨d, hdQ⟩) htA hdA
      (fun a ha => Subtype.ext (htinverts a ha))
    intro a ha
    exact congrArg Subtype.val (h ⟨a, hAQ ha⟩ ha)
  refine ⟨d, hdD, hdQ, ?_, hdA, ?_, hinv, ?_⟩
  · rw [data.caseA.definitions.1] at hdD
    exact hdD.2
  · exact congrArg Subtype.val (hDtwo ⟨d, hdD⟩)
  · exact SectionEight.eight_six_generated_with_of_index_two hAQ
      (by rw [hQcard, hAcard]) hdQ hdA

end Stellmacher.Recognition
