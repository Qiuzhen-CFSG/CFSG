module

public import Stellmacher.Recognition.NormalFourOddCoreSetup
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# The central-omega normalizer as an involution centralizer

When the central omega subgroup has order two, it is generated by the central
Sylow involution. Its normalizer therefore equals that involution's centralizer.
This common interface is used by both the quaternion-core and noncyclic-tail
fusion arguments.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, printed pp.390–393.
-/

namespace Stellmacher.Recognition.NormalEightNonnormalImage

open Subgroup NormalFourCentralOmegaTwo

variable {G : Type*} [Group G] [Finite G]

/-- The central-omega normalizer is the central involution centralizer. -/
public theorem omegaNormalizer_eq_centralizer_of_central_involution
    (S : Sylow 2 G) (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (z : S) (hz : orderOf z = 2) (hzc : z ∈ center S) :
    omegaNormalizer S = centralizer ({(z : G)} : Set G) := by
  have hz2 : z ^ 2 = 1 := by simpa only [hz] using pow_orderOf_eq_one z
  have hzZ : (z : G) ∈ centralOmega S := by
    apply mem_map_of_mem
    refine ⟨⟨z, hzc⟩, subset_closure ?_, rfl⟩
    exact (show (⟨z, hzc⟩ : center S) ^ (2 ^ 1) = 1 from
      Subtype.ext (by simpa using hz2))
  have hline : zpowers (z : G) = centralOmega S := by
    apply eq_of_le_of_card_ge (zpowers_le.mpr hzZ)
    rw [Nat.card_zpowers, Subgroup.orderOf_coe, hz, card_centralOmega, hZ]
  change normalizer (centralOmega S : Set G) = _
  rw [← hline]
  exact normalizer_zpowers_eq_centralizer_of_order_two (z : G)
    ((orderOf_coe z).trans hz)

end Stellmacher.Recognition.NormalEightNonnormalImage
