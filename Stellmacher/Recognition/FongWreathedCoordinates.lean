module

public import ABG.ChapterII.Section1.WreathedOuterCentralizers
public import ABG.ChapterII.Section1.WreathedBaseFour
public import ABG.ChapterII.Section1.WreathedBaseProduct

/-!
# Fong coordinates in a wreathed group of order 32

For an actual ABG presentation of height two, set `F = s*z`, `E = s`,
`X = s²`, and `J = (s*t)²`. These generators satisfy Fong's case IIb
relations with parameter zero. Their orders are respectively eight, four,
two, and two, and `F,E` generate the group. The center is generated by `F²`.
The centralizers inside this group of `F` and `F³` are cyclic of order eight;
that of `XF²` is the abelian base of order sixteen.

The proof uses the ABG normal-form results: `(s*z)² = s*t`, the diagonal
center, and the centralizer of an element outside the base. A noncentral
base element has centralizer equal to the base. These are Sylow-internal
statements; ambient fusion and ambient centralizer quotients require
additional arguments. The intrinsic coordinate API uses the namespace
`FongWreathedIntrinsic`; the separate `FongWreathed` API places these
generators in an ambient group.

Source: P. Fong, *Some Sylow subgroups of order 32 and a characterization
of U(3,3)*, J. Algebra 6 (1967), 65–76, pp. 68–69, case IIb and table (4).
-/

namespace Stellmacher.Recognition.FongWreathedIntrinsic
open ABG.Wreathed
variable {S : Type*} [Group S] (P : Presentation S 2)

@[expose] public def F : S := P.s * P.z
@[expose] public def E : S := P.s
@[expose] public def X : S := P.s ^ 2
@[expose] public def J : S := P.u ^ 2

public theorem F_sq : F P ^ 2 = P.u := P.sz_sq

public theorem F_four : F P ^ 4 = J P := by
  rw [show 4 = 2 * 2 from rfl, pow_mul, F_sq, J]

public theorem X_eq_x₂ : X P = P.x₂ := rfl

public theorem J_eq_x : J P = P.x := rfl

public theorem X_orderOf : orderOf (X P) = 2 := P.x₂_orderOf

public theorem J_orderOf : orderOf (J P) = 2 := P.x_orderOf

public theorem E_sq : E P ^ 2 = X P := rfl

public theorem E_orderOf : orderOf (E P) = 4 := by
  apply @orderOf_eq_prime_pow S _ (E P) 1 2 _
  · have h := X_orderOf P
    intro he
    change X P = 1 at he
    rw [he, orderOf_one] at h
    omega
  · exact P.s_pow

public theorem F_orderOf : orderOf (F P) = 8 := by
  apply @orderOf_eq_prime_pow S _ (F P) 2 2 _
  · have h := J_orderOf P
    intro he
    have : J P = 1 := (F_four P).symm.trans he
    rw [this, orderOf_one] at h
    omega
  · change F P ^ 8 = 1
    rw [show 8 = 4 * 2 from rfl, pow_mul, F_four]
    simpa only [J_orderOf] using pow_orderOf_eq_one (J P)

public theorem F_sq_orderOf : orderOf (F P ^ 2) = 4 := by
  rw [F_sq]
  exact P.orderOf_u

public theorem E_inv_conj_F : (E P)⁻¹ * F P * E P = X P * F P ^ 3 := by
  have hs : P.s ^ 4 = 1 := P.s_pow
  have hc : Commute P.s P.t := P.commute
  calc
    (E P)⁻¹ * F P * E P = P.t * P.z := by simp [E, F, P.z_mul_s]
    _ = P.s ^ 4 * P.t * P.z := by rw [hs, one_mul]
    _ = P.s ^ 2 * ((P.s * P.t) * (P.s * P.z)) := by
      calc
        _ = P.s ^ 2 * (P.s * (P.s * P.t) * P.z) := by group
        _ = _ := by
          rw [((Commute.refl P.s).mul_right hc).eq]
          group
    _ = X P * F P ^ 3 := by rw [show 3 = 2 + 1 from rfl, pow_add, pow_one, F_sq]; rfl

public theorem E_commute_X : Commute (E P) (X P) := Commute.self_pow P.s 2

public theorem F_sq_mem_center : F P ^ 2 ∈ Subgroup.center S := by
  rw [F_sq]
  exact P.u_mem_center

public theorem center_eq : Subgroup.center S = Subgroup.zpowers (F P ^ 2) := by
  rw [F_sq]
  exact P.center_eq_zpowers

public theorem generate : Subgroup.closure ({F P, E P} : Set S) = ⊤ := by
  let H := Subgroup.closure ({F P, E P} : Set S)
  have hf : F P ∈ H := Subgroup.subset_closure (by simp)
  have hs : P.s ∈ H := Subgroup.subset_closure (by simp [E])
  have hz : P.z ∈ H := by simpa [F] using H.mul_mem (H.inv_mem hs) hf
  have ht : P.t ∈ H := P.conj_s ▸ H.mul_mem (H.mul_mem (H.inv_mem hz) hs) hz
  apply top_unique
  rw [← P.generate]
  apply (Subgroup.closure_le _).mpr
  intro a ha
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
  rcases ha with rfl | rfl | rfl
  · exact hs
  · exact ht
  · exact hz

public theorem F_not_mem_base : F P ∉ P.U := by
  intro h
  have hs : P.s ∈ P.U := Subgroup.subset_closure (by simp)
  exact P.z_not_mem_U (by simpa [F] using P.U.mul_mem (P.U.inv_mem hs) h)

public theorem centralizer_F : Subgroup.centralizer ({F P} : Set S) =
    Subgroup.zpowers (F P) := by
  rw [P.outer_centralizer_eq (F_not_mem_base P), center_eq]
  exact sup_eq_right.mpr (Subgroup.zpowers_le.mpr
    ((Subgroup.zpowers (F P)).pow_mem (Subgroup.mem_zpowers _) 2))

public theorem card_centralizer_F : Nat.card (Subgroup.centralizer ({F P} : Set S)) = 8 := by
  rw [centralizer_F, Nat.card_zpowers, F_orderOf]

public theorem XF_sq_sq : (X P * F P ^ 2) ^ 2 = J P := by
  rw [F_sq, ((P.u_commute (X P)).symm).mul_pow]
  have hX : X P ^ 2 = 1 := P.x₂_sq
  rw [hX, one_mul]
  rfl

public theorem XF_sq_orderOf : orderOf (X P * F P ^ 2) = 4 := by
  apply @orderOf_eq_prime_pow S _ (X P * F P ^ 2) 1 2 _
  · rw [show 2 ^ 1 = 2 from rfl, XF_sq_sq]
    intro h
    have ho := J_orderOf P
    rw [h, orderOf_one] at ho
    omega
  · change (X P * F P ^ 2) ^ 4 = 1
    rw [show 4 = 2 * 2 from rfl, pow_mul, XF_sq_sq]
    simpa only [J_orderOf] using pow_orderOf_eq_one (J P)

private theorem X_mem_base : X P ∈ P.U :=
  P.U.pow_mem (Subgroup.subset_closure (by simp)) 2

private theorem X_not_mem_center : X P ∉ Subgroup.center S := by
  intro h
  have hc := (Subgroup.mem_center_iff.mp h) P.z
  have hz : P.z * X P = P.x₃ * P.z := P.z_mul_s_pow 2
  exact P.x₂_ne_x₃ (mul_right_cancel (hc.symm.trans hz))

public theorem centralizer_X : Subgroup.centralizer ({X P} : Set S) = P.U := by
  apply le_antisymm
  · intro g hg
    by_contra hn
    have hcomm := (Subgroup.mem_centralizer_singleton_iff.mp hg).symm
    exact X_not_mem_center P (P.base_commute_outer_mem_center (X_mem_base P) hn hcomm)
  · intro g hg
    exact Subgroup.mem_centralizer_singleton_iff.mpr
      (P.commute_of_mem_U hg (X_mem_base P))

public theorem centralizer_XF_sq : Subgroup.centralizer ({X P * F P ^ 2} : Set S) =
    P.U := by
  ext g
  rw [← centralizer_X P]
  constructor
  · intro hg
    have h : Commute g (X P * P.u) := by
      change g * (X P * P.u) = (X P * P.u) * g
      simpa only [F_sq] using Subgroup.mem_centralizer_singleton_iff.mp hg
    exact Subgroup.mem_centralizer_singleton_iff.mpr
      (by simpa using (h.mul_right (P.u_commute g).inv_left.symm).eq)
  · intro hg
    have h : Commute g (X P) := Subgroup.mem_centralizer_singleton_iff.mp hg
    exact Subgroup.mem_centralizer_singleton_iff.mpr
      (by simpa only [F_sq] using (h.mul_right (P.u_commute g).symm).eq)

/-- The base centralizer has the actual product model of type `(4,4)`. -/
public theorem centralizer_XF_sq_model :
    Nonempty (Subgroup.centralizer ({X P * F P ^ 2} : Set S) ≃*
      (Multiplicative (ZMod 4) × Multiplicative (ZMod 4))) :=
  ⟨(MulEquiv.subgroupCongr (centralizer_XF_sq P)).trans P.baseEquiv⟩

public theorem card_centralizer_XF_sq :
    Nat.card (Subgroup.centralizer ({X P * F P ^ 2} : Set S)) = 16 := by
  rw [centralizer_XF_sq]
  exact P.card_U

public theorem F_cube_orderOf : orderOf (F P ^ 3) = 8 := by
  have hcop : (orderOf (F P)).Coprime 3 := by rw [F_orderOf]; decide
  exact hcop.orderOf_pow.trans (F_orderOf P)

public theorem F_cube_cube : (F P ^ 3) ^ 3 = F P := by
  rw [← pow_mul, show 3 * 3 = 8 + 1 from rfl, pow_add, pow_one,
    ← F_orderOf P, pow_orderOf_eq_one, one_mul]

public theorem centralizer_F_cube : Subgroup.centralizer ({F P ^ 3} : Set S) =
    Subgroup.zpowers (F P) := by
  rw [← centralizer_F P]
  ext g
  constructor
  · intro hg
    have h : Commute g (F P ^ 3) := Subgroup.mem_centralizer_singleton_iff.mp hg
    exact Subgroup.mem_centralizer_singleton_iff.mpr
      (by simpa only [F_cube_cube] using (h.pow_right 3).eq)
  · intro hg
    have h : Commute g (F P) := Subgroup.mem_centralizer_singleton_iff.mp hg
    exact Subgroup.mem_centralizer_singleton_iff.mpr (h.pow_right 3).eq

public theorem card_centralizer_F_cube :
    Nat.card (Subgroup.centralizer ({F P ^ 3} : Set S)) = 8 := by
  rw [centralizer_F_cube, Nat.card_zpowers, F_orderOf]

public theorem X_conj_F : X P * F P * X P = F P ^ 5 := by
  have hc : Commute P.s P.t := P.commute
  have hJ : J P = P.s ^ 2 * P.t ^ 2 := hc.mul_pow 2
  calc
    X P * F P * X P = P.s ^ 3 * (P.z * P.s ^ 2) := by dsimp [X, F]; group
    _ = P.s ^ 3 * (P.t ^ 2 * P.z) := by rw [P.z_mul_s_pow]
    _ = P.s ^ 2 * (P.s * P.t ^ 2) * P.z := by group
    _ = P.s ^ 2 * (P.t ^ 2 * P.s) * P.z := by rw [(hc.pow_right 2).eq]
    _ = J P * F P := by rw [hJ, F]; group
    _ = F P ^ 5 := by rw [show 5 = 4 + 1 from rfl, pow_add, pow_one, F_four]

end Stellmacher.Recognition.FongWreathedIntrinsic
