module

public import Stellmacher.Recognition.LargeTerminalInversionNormalizer
public import Stellmacher.Recognition.LargeTerminalReeOrderEightExclusion
public import Theory.GroupTheory.SylowMarkedConjugacy

/-!
# Actual Sylow data for a hypothetical inverting extension

The quotient of the second parabolic by its two-core has order twenty.
Consequently the fourth power of a two-element belongs to that core. For a
squaring inverter this power lies in the cyclic fixed four, and inversion
forces it to be one or the square of the root. This excludes order sixteen,
without using the orientation theorem or a splitting assertion.

A Sylow subgroup containing the lift contains the whole normal two-core and
is generated by the core and the lift: squaring has order four modulo the core.
Separately, the second parabolic fixes the distinguished involution, so Sylow
conjugacy transfers any marked identification back to the original Sylow.

Source: Thompson VI, pp.629–630, through the local cardinality and inversion
reductions in `LargeTerminalInversionNormalizer`; standard Sylow conjugacy.
-/

namespace Stellmacher.Recognition
open Later SectionsFiveToSeven CosetGraphContext SevenSix SectionNine Subgroup

/-- Every Sylow subgroup of the second parabolic is isomorphic to the original
Sylow by an equivalence fixing the specified ambient central involution. -/
public theorem LargeTerminalContext.marked_equiv_local_sylow
    {G : Type*} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (T : Sylow 2 ctx.second)
    (z : G) (hz : orderOf z = 2)
    (hgen : zpowers z = omegaOneCenter (S : Subgroup G))
    (hzT : ∃ hzP : z ∈ ctx.second, (⟨z, hzP⟩ : ctx.second) ∈ T) :
    ∃ hzS : z ∈ S, ∃ e : S ≃* T, ((e ⟨z, hzS⟩ : ctx.second) : G) = z := by
  have hSP : (S : Subgroup G) ≤ ctx.second :=
    ctx.terminal.hypothesisTwo.fiveOne.P2_mem.1.2.1.1
  have hzS : z ∈ S := (map_subtype_le _) (hgen ▸ mem_zpowers z)
  have hPC : ctx.second ≤ centralizer ({z} : Set G) :=
    ctx.second_le_residual_normalizer.trans
      (normalizer_le_centralizer_of_characteristic_involution
        ctx.firstResidual (center ctx.firstResidual) z hz
        (ctx.first_residual_center_eq_omegaOneCenter.trans hgen.symm))
  let zP : ctx.second := ⟨z, hSP hzS⟩
  have hzC : zP ∈ center ctx.second := by
    apply mem_center_iff.mpr
    intro g
    apply Subtype.ext
    exact mem_centralizer_singleton_iff.mp (hPC g.property)
  obtain ⟨e, he⟩ := (S.subtype hSP).exists_equiv_fix_central T zP hzC hzS hzT.choose_spec
  let e0 : S ≃* S.subtype hSP := (subgroupOfEquivOfLe hSP).symm
  refine ⟨hzS, e0.trans e, ?_⟩
  change ((e ⟨zP, hzS⟩ : ctx.second) : G) = z
  rw [he]

/-- An inverting two-element squaring the five-subgroup has fourth power one
or the square of the fixed root. This does not assert splitting. -/
public theorem LargeTerminalContext.inverting_lift_fourth_power
    {G : Type*} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (hS : Nat.card S = 4096)
    (A : Subgroup G) (hA : Nat.card A = 5)
    (t s : G) (ht4 : orderOf t = 4)
    (htgen : zpowers t = twoCoreIn ctx.second ⊓ centralizer (A : Set G))
    (hsP : s ∈ ctx.second) (hs16 : s ^ 16 = 1)
    (hsA : ∀ c ∈ A, s * c * s⁻¹ = c ^ 2)
    (hst : s * t * s⁻¹ = t⁻¹) : s ^ 4 = 1 ∨ s ^ 4 = t ^ 2 := by
  classical
  let Q := pCore 2 ctx.second
  have hQcard : Nat.card Q = 1024 := by
    obtain ⟨z, _, _, hcore, hc⟩ := ctx.involution_centralizer_core_eq_of_large_card hS
    have hh : Nat.card (twoCoreIn ctx.second) = 1024 := by
      rw [← hcore]
      exact (card_map_of_injective (centralizer ({z} : Set G)).subtype_injective).trans hc
    exact (card_map_of_injective ctx.second.subtype_injective).symm.trans hh
  have hquot : Nat.card (ctx.second ⧸ Q) = 20 := by
    have hh := Q.card_eq_card_quotient_mul_card_subgroup
    rw [ctx.second_card_of_large_card hS, hQcard] at hh
    omega
  let sP : ctx.second := ⟨s, hsP⟩
  let x := QuotientGroup.mk' Q sP
  have hx16 : x ^ 16 = 1 := by
    rw [← map_pow, show sP ^ 16 = 1 from Subtype.ext hs16, map_one]
  have hd20 : orderOf x ∣ 20 := hquot ▸ orderOf_dvd_natCard x
  have hx4 : x ^ 4 = 1 := orderOf_dvd_iff_pow_eq_one.mp
    (show orderOf x ∣ 4 from Nat.dvd_gcd hd20 (orderOf_dvd_of_pow_eq_one hx16))
  have hs4Q : s ^ 4 ∈ twoCoreIn ctx.second := by
    exact mem_map_of_mem ctx.second.subtype
      ((QuotientGroup.eq_one_iff _).mp ((map_pow _ _ _).trans hx4))
  have hs4T : s ^ 4 ∈ zpowers t := htgen.ge
    ⟨hs4Q, fourth_power_centralizes_five A hA s hsA⟩
  rw [mem_zpowers_iff_mem_range_orderOf, ht4] at hs4T
  obtain ⟨n, hn, he⟩ := Finset.mem_image.mp hs4T
  have hn4 := Finset.mem_range.mp hn
  have hinv : (s ^ 4)⁻¹ = s ^ 4 := by
    calc
      (s ^ 4)⁻¹ = (t ^ n)⁻¹ := congrArg Inv.inv he.symm
      _ = s * t ^ n * s⁻¹ := by rw [← conj_pow, hst, inv_pow]
      _ = s * s ^ 4 * s⁻¹ := by rw [he]
      _ = s ^ 4 := by rw [(Commute.self_pow s 4).eq, mul_inv_cancel_right]
  have ht2 : t ^ 2 ≠ 1 := by
    intro hh
    have hd := orderOf_dvd_of_pow_eq_one hh
    rw [ht4] at hd
    norm_num at hd
  have hp : (t ^ n) ^ 2 = 1 := by
    rw [he, pow_two]
    nth_rw 1 [← hinv]
    exact inv_mul_cancel _
  have ht4' : t ^ 4 = 1 := ht4 ▸ pow_orderOf_eq_one t
  interval_cases n
  · exact Or.inl (by simpa using he.symm)
  · exact False.elim (ht2 (by simpa using hp))
  · exact Or.inr he.symm
  · rw [← pow_mul, show 3 * 2 = 4 + 2 from rfl, pow_add, ht4', one_mul] at hp
    exact False.elim (ht2 hp)

/-- Place an actual squaring inverter and the whole core in a Sylow subgroup
of the second parabolic. The lift has order four or eight, with its fourth
power explicitly controlled. No identification of the extension is assumed. -/
public theorem LargeTerminalContext.exists_local_sylow_inverting_lift
    {G : Type*} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (hS : Nat.card S = 4096)
    (A : Subgroup G) (hA : Nat.card A = 5) (hAP : A ≤ ctx.second)
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (t b : G) (htQ : t ∈ twoCoreIn ctx.second) (ht4 : orderOf t = 4)
    (hgen : zpowers t = twoCoreIn ctx.second ⊓ centralizer (A : Set G))
    (hbP : b ∈ ctx.second) (hinv : b * t * b⁻¹ = t⁻¹) :
    ∃ (s : G) (hsP : s ∈ ctx.second) (T : Sylow 2 ctx.second),
      (⟨s, hsP⟩ : ctx.second) ∈ T ∧
      s ∈ normalizer (A : Set G) ∧
      s ∈ normalizer (ctx.firstResidual : Set G) ∧
      s ∈ normalizer (twoCoreIn ctx.second : Set G) ∧
      (s ^ 4 = 1 ∨ s ^ 4 = t ^ 2) ∧ s ^ 8 = 1 ∧
      (orderOf s = 4 ∨ orderOf s = 8) ∧
      (∀ c ∈ A, s * c * s⁻¹ = c ^ 2) ∧ s * t * s⁻¹ = t⁻¹ ∧
      ∀ q : twoCoreIn ctx.second,
        (⟨(q : G), twoCoreIn_le ctx.second q.property⟩ : ctx.second) ∈ T := by
  obtain ⟨s, hsP, hsA, hsR, hsQ, hs16, hsa, hst⟩ :=
    ctx.exists_two_power_five_squaring_inverter hS A hA hAP hcard t b htQ ht4 hgen hbP hinv
  have hfour := ctx.inverting_lift_fourth_power hS A hA t s ht4 hgen hsP hs16 hsa hst
  have h8 : s ^ 8 = 1 := by
    rw [show 8 = 4 * 2 from rfl, pow_mul]
    rcases hfour with h | h
    · rw [h, one_pow]
    · rw [h, ← pow_mul]
      exact (show t ^ 4 = 1 from ht4 ▸ pow_orderOf_eq_one t)
  have hord : orderOf s = 4 ∨ orderOf s = 8 := by
    let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    by_cases h4 : s ^ 4 = 1
    · exact Or.inl (orderOf_eq_four_of_squares_five A hA s hsa h4)
    · exact Or.inr (orderOf_eq_prime_pow (p := 2) (n := 2) h4 h8)
  let sP : ctx.second := ⟨s, hsP⟩
  have hsP16 : sP ^ 16 = 1 := Subtype.ext hs16
  have hp : IsPGroup 2 (zpowers sP) := by
    apply (isPGroup_iff_card_dvd_pow).mpr
    exact ⟨4, by rw [Nat.card_zpowers]; exact orderOf_dvd_of_pow_eq_one hsP16⟩
  obtain ⟨T, hT⟩ := hp.exists_le_sylow
  refine ⟨s, hsP, T, hT (mem_zpowers sP), hsA, hsR, hsQ, hfour, h8, hord, hsa, hst, ?_⟩
  intro q
  obtain ⟨qP, hqP, he⟩ := q.property
  have hqT := (pCore_isPGroup (p := 2) (G := ctx.second)).le_sylow_of_normal T hqP
  have heq : (⟨(q : G), twoCoreIn_le ctx.second q.property⟩ : ctx.second) = qP :=
    Subtype.ext he.symm
  rw [heq]
  exact hqT

/-- Squaring the five-subgroup has order four modulo the second core, since
normalizing the five-subgroup inside the core means centralizing it. -/
public theorem LargeTerminalContext.squaring_square_not_mem_core
    {G : Type*} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S)
    (A : Subgroup G) (hA : Nat.card A = 5) (hAP : A ≤ ctx.second)
    (s : G) (hsN : s ∈ normalizer (A : Set G))
    (hs : ∀ c ∈ A, s * c * s⁻¹ = c ^ 2) : s ^ 2 ∉ twoCoreIn ctx.second := by
  intro hsQ
  have hsC := ctx.five_normalizer_inter_core_le_centralizer A hA hAP
    ⟨hsQ, pow_mem hsN 2⟩
  let _ : Fact (Nat.Prime 5) := ⟨by decide⟩
  let _ : IsCyclic A := isCyclic_of_prime_card hA
  obtain ⟨c, hc⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := A)
  have hc5 : orderOf (c : G) = 5 := by rw [orderOf_submonoid, hc, hA]
  have he : (c : G) ^ 4 = c := by
    calc
      (c : G) ^ 4 = s * (s * c * s⁻¹) * s⁻¹ := by
        rw [hs c c.property, ← conj_pow, hs c c.property, ← pow_mul]
      _ = s ^ 2 * c * (s ^ 2)⁻¹ := by simp only [pow_two]; group
      _ = c := mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_iff.mp hsC c c.property).symm
  have hp : (c : G) ^ 3 = 1 := by
    have hh := congrArg (fun x : G => x * (c : G)⁻¹) he
    simpa only [show (4 : ℕ) = 3 + 1 from rfl, pow_succ, mul_inv_cancel_right,
      mul_inv_cancel] using hh
  have hd := orderOf_dvd_of_pow_eq_one hp
  rw [hc5] at hd
  norm_num at hd

/-- A squaring lift with fourth power in the core generates its containing
local Sylow together with that core. This includes the nonsplit order-eight
case and uses the actual ambient subgroup, not an abstract group of its order. -/
public theorem LargeTerminalContext.local_sylow_generated_by_squaring_lift
    {G : Type*} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (hS : Nat.card S = 4096)
    (A : Subgroup G) (hA : Nat.card A = 5) (hAP : A ≤ ctx.second)
    (s : G) (hsP : s ∈ ctx.second) (hsN : s ∈ normalizer (A : Set G))
    (hs : ∀ c ∈ A, s * c * s⁻¹ = c ^ 2)
    (hs4 : s ^ 4 ∈ twoCoreIn ctx.second)
    (T : Sylow 2 ctx.second) (hsT : (⟨s, hsP⟩ : ctx.second) ∈ T) :
    twoCoreIn ctx.second ⊔ zpowers s = T.toSubgroup.map ctx.second.subtype := by
  let Q := pCore 2 ctx.second
  let sP : ctx.second := ⟨s, hsP⟩
  let f := QuotientGroup.mk' Q
  let x := f sP
  have hQcard : Nat.card Q = 1024 := by
    obtain ⟨z, _, _, hcore, hc⟩ := ctx.involution_centralizer_core_eq_of_large_card hS
    have hh : Nat.card (twoCoreIn ctx.second) = 1024 := by
      rw [← hcore]
      exact (card_map_of_injective (centralizer ({z} : Set G)).subtype_injective).trans hc
    exact (card_map_of_injective ctx.second.subtype_injective).symm.trans hh
  have hquot : Nat.card (ctx.second ⧸ Q) = 20 := by
    have hh := Q.card_eq_card_quotient_mul_card_subgroup
    rw [ctx.second_card_of_large_card hS, hQcard] at hh
    omega
  have hsP4 : sP ^ 4 ∈ Q := by
    obtain ⟨q, hq, he⟩ := hs4
    have heq : q = sP ^ 4 := Subtype.ext he
    exact heq ▸ hq
  have hx4 : x ^ 4 = 1 := by
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr hsP4
  have hx2 : x ^ 2 ≠ 1 := by
    intro hx2
    have hq : sP ^ 2 ∈ Q := (QuotientGroup.eq_one_iff _).mp ((map_pow _ _ _).trans hx2)
    exact ctx.squaring_square_not_mem_core A hA hAP s hsN hs
      (mem_map_of_mem ctx.second.subtype hq)
  have hxorder : orderOf x = 4 := by
    let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    exact orderOf_eq_prime_pow (p := 2) (n := 1) hx2 hx4
  let U := Q ⊔ zpowers sP
  have hmap : U.map f = zpowers x := by
    rw [Subgroup.map_sup, MonoidHom.map_zpowers]
    have hbot : Q.map f = ⊥ := by
      apply (Subgroup.map_eq_bot_iff Q).mpr
      exact le_of_eq (QuotientGroup.ker_mk' Q).symm
    rw [hbot, bot_sup_eq]
  have hindex : U.index = 5 := by
    have hh := (U.map f).card_mul_index
    rw [hmap, Nat.card_zpowers, hxorder, hquot] at hh
    have hi : (U.map f).index = U.index := U.index_map_eq
      (QuotientGroup.mk'_surjective Q) (by rw [QuotientGroup.ker_mk']; exact le_sup_left)
    rw [hmap] at hi
    rw [hi] at hh
    omega
  have hUcard : Nat.card U = 4096 := by
    have hh := U.card_mul_index
    rw [hindex, ctx.second_card_of_large_card hS] at hh
    omega
  have hSP : (S : Subgroup G) ≤ ctx.second :=
    ctx.terminal.hypothesisTwo.fiveOne.P2_mem.1.2.1.1
  have hTcard : Nat.card T = 4096 :=
    (Nat.card_congr ((T.equiv (S.subtype hSP)).trans
      (subgroupOfEquivOfLe hSP)).toEquiv).trans hS
  have hUT : U ≤ T.toSubgroup := sup_le
    (pCore_isPGroup.le_sylow_of_normal T) (zpowers_le.mpr hsT)
  have hUTeq : U = T.toSubgroup := eq_of_le_of_card_ge hUT (by rw [hUcard, hTcard])
  have hm := congrArg (fun V : Subgroup ctx.second => V.map ctx.second.subtype) hUTeq
  simpa only [U, Subgroup.map_sup, MonoidHom.map_zpowers, sP, Q, twoCoreIn, Subgroup.subtype_apply] using hm
end Stellmacher.Recognition
