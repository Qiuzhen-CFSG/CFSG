module

public import Stellmacher.Recognition.FongWreathedBorelConsequences
public import Theory.Character.PermutationActionCharacter
public import Theory.Character.ColumnSaturation
public import Theory.GroupAction.RegularComplement
public import BenderGlauberman.Lemma19

/-!
# Fong's degree-28 permutation character

The eight supplied irreducibles saturate the column at `F`. The cyclic
2-group generated by `F` fixes at least two of the 28 cosets. Taking real
parts in the character decomposition therefore forces the degree-27
constituent to occur, and the degree budget identifies the whole character.
Its norm gives double transitivity. Vanishing on the nonidentity elements
of `Q` makes their action free away from the base coset, hence regular.

Source: P. Fong, J. Algebra 6 (1967), equation (10), p.73, and p.75.
All conclusions here are conditional on the supplied Borel subgroups.
-/

namespace Stellmacher.Recognition.FongWreathed
open BenderGlauberman
open scoped BigOperators
noncomputable section
attribute [local instance] Fintype.ofFinite

variable {G : Type*} [Group G] [Finite G] {S : Sylow 2 G}
variable {P : ABG.Wreathed.Presentation S 2}

namespace CharacterData

/-- Every irreducible outside Fong's eight-character family vanishes at `F`. -/
public theorem other_vanishes_at_F (c : CharacterData P)
    (hCF : Nat.card (Subgroup.centralizer ({F P} : Set G)) = 8)
    {θ : ClassFunction G} (hθ : IsIrreducibleCharacter θ)
    (hne : ∀ i, θ ≠ c.chi i) : θ (F P) = 0 := by
  apply irreducible_eq_zero_of_column_saturated c.chi c.irreducible c.injective
    (F P) _ hθ hne
  rw [hCF]
  norm_num [c.at_F, fColumn, Fin.sum_univ_succ, Complex.normSq_neg]

private theorem identify_character (c : CharacterData P)
    (hCF : Nat.card (Subgroup.centralizer ({F P} : Set G)) = 8)
    {φ : ClassFunction G} (hφ : IsCharacter φ) (hd : φ 1 = 28)
    (hprincipal : scalarProduct G φ 1 = 1) (hF : 2 ≤ (φ (F P)).re) :
    φ = 1 + c.chi 1 := by
  classical
  let I := {θ : ClassFunction G // IsIrreducibleCharacter θ}
  let p : I := ⟨1, isLinearCharacter_one.1⟩
  let s : I := ⟨c.chi 1, c.irreducible 1⟩
  have hps : p ≠ s := by
    intro heq
    have h := congrArg (fun θ : I => θ.1 1) heq
    change 1 = c.chi 1 1 at h
    rw [c.degree] at h
    norm_num at h
  have hnat (θ : I) : ∃ n : ℕ, scalarProduct G φ θ.1 = (n : ℂ) := by
    obtain ⟨n, hn⟩ := scalarProduct_irr_char_nat θ.2 hφ
    refine ⟨n, ?_⟩
    rw [← scalarProduct_conj, ← hn]
    simp
  choose m hm using hnat
  have hmp : m p = 1 := by
    have h := (hm p).symm.trans hprincipal
    exact_mod_cast h
  have hgen : IsGeneralizedCharacter φ :=
    ⟨φ, 0, hφ, isCharacter_zero, (sub_zero φ).symm⟩
  have hexp (g : G) : φ g = ∑ θ : I, (m θ : ℂ) * θ.1 g := by
    simpa only [hm] using classFunction_eq_sum_irr_coeffs hgen g
  have hneg (θ : I) (hp : θ ≠ p) (hs : θ ≠ s) : (θ.1 (F P)).re ≤ 0 := by
    by_cases hmem : ∃ i, θ.1 = c.chi i
    · obtain ⟨i, hi⟩ := hmem
      have hi0 : i ≠ 0 := by
        intro h
        apply hp
        apply Subtype.ext
        simpa [h, c.principal, p] using hi
      have hi1 : i ≠ 1 := by
        intro h
        exact hs (Subtype.ext (by simpa [h, s] using hi))
      rw [hi, c.at_F]
      fin_cases i <;> simp_all [fColumn]
    · rw [c.other_vanishes_at_F hCF θ.2 (fun i hi => hmem ⟨i, hi⟩)]
      simp
  have hleF : (φ (F P)).re ≤ 1 + (m s : ℝ) := by
    rw [hexp, Complex.re_sum]
    calc
      _ ≤ ∑ θ : I, ((if θ = p then (1 : ℝ) else 0) +
          (if θ = s then (m s : ℝ) else 0)) := by
        apply Finset.sum_le_sum
        intro θ _
        by_cases hp : θ = p
        · subst θ
          simp [p, hmp, hps]
        · by_cases hs : θ = s
          · subst θ
            simp [hp, s, c.at_F, fColumn]
          · simp only [if_neg hp, if_neg hs, add_zero, Complex.mul_re,
              Complex.natCast_re, Complex.natCast_im, zero_mul, sub_zero]
            exact mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg _) (hneg θ hp hs)
      _ = _ := by
        rw [Finset.sum_add_distrib, Fintype.sum_ite_eq' p (fun _ : I => (1 : ℝ)),
          Fintype.sum_ite_eq' s (fun _ : I => (m s : ℝ))]
  have hmpos : 1 ≤ m s := by
    have : (1 : ℝ) ≤ m s := by linarith
    exact_mod_cast this
  let f : I → ℝ := fun θ => (m θ : ℝ) * (θ.1 1).re
  have hf (θ : I) : 0 ≤ f θ :=
    mul_nonneg (Nat.cast_nonneg _) (le_trans (by norm_num) (irreducible_degree_ge_one θ.2))
  have hsum : ∑ θ : I, f θ = 28 := by
    have h := congrArg Complex.re (hexp 1)
    rw [hd] at h
    simpa [f, Complex.mul_re] using h.symm
  have hfp : f p = 1 := by simp [f, hmp, p]
  have hfs : f s = (m s : ℝ) * 27 := by simp [f, s, c.degree]
  have hle : ∑ i ∈ ({p, s} : Finset I), f i ≤ ∑ i : I, f i :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun i _ _ => hf i)
  rw [Finset.sum_pair hps, hfp, hfs, hsum] at hle
  have hms : m s = 1 := by
    have : (m s : ℝ) ≤ 1 := by linarith
    have : m s ≤ 1 := by exact_mod_cast this
    omega
  have hzero (θ : I) (hp : θ ≠ p) (hs : θ ≠ s) : m θ = 0 := by
    have hnot : θ ∉ ({p, s} : Finset I) := by simp [hp, hs]
    have hl := Finset.sum_le_sum_of_subset_of_nonneg
      (Finset.subset_univ (insert θ {p, s})) (fun i _ _ => hf i)
    rw [Finset.sum_insert hnot, Finset.sum_pair hps, hfp, hfs, hsum, hms] at hl
    have hdeg := irreducible_degree_ge_one θ.2
    have hmnonneg : (0 : ℝ) ≤ m θ := Nat.cast_nonneg _
    have hz : (m θ : ℝ) = 0 := by dsimp [f] at hl; norm_num at hl; nlinarith
    exact_mod_cast hz
  funext g
  rw [hexp]
  have hreduce : (∑ θ : I, (m θ : ℂ) * θ.1 g) =
      ∑ θ ∈ ({p, s} : Finset I), (m θ : ℂ) * θ.1 g := by
    symm
    apply Finset.sum_subset (Finset.subset_univ _)
    intro θ _ hθ
    have hnot : θ ≠ p ∧ θ ≠ s := by simpa using hθ
    rw [hzero θ hnot.1 hnot.2]
    simp
  rw [hreduce, Finset.sum_pair hps]
  simp [hmp, hms, p, s]

end CharacterData

namespace BorelSubgroups
variable (b : BorelSubgroups P)

/-- The identity coset, fixed by `B`. -/
@[expose] public def baseCoset : G ⧸ b.B := (1 : G)

omit [Finite G] in
public theorem smul_baseCoset (g : G) (hg : g ∈ b.B) :
    g • b.baseCoset = b.baseCoset := by
  change ((g * 1 : G) : G ⧸ b.B) = ((1 : G) : G ⧸ b.B)
  apply QuotientGroup.eq.mpr
  simpa using b.B.inv_mem hg

/-- The cyclic 2-group generated by `F` fixes at least two cosets. -/
public theorem two_le_fixedBy_F (hG : Nat.card G = 6048) :
    2 ≤ Nat.card (MulAction.fixedBy (G ⧸ b.B) (F P)) := by
  let H := Subgroup.zpowers (F P)
  have hH : IsPGroup 2 H := IsPGroup.of_card (by
    change Nat.card (Subgroup.zpowers (F P)) = 2 ^ 3
    rw [Nat.card_zpowers, orderOf_F]; norm_num)
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have ha : b.baseCoset ∈ MulAction.fixedPoints H (G ⧸ b.B) := by
    intro g
    exact b.smul_baseCoset g (b.zpowers_F_le_B g.property)
  obtain ⟨y, hy, hay⟩ := hH.exists_fixed_point_of_prime_dvd_card_of_fixed_point (G ⧸ b.B)
    (by rw [b.card_cosets hG]; decide) ha
  have haF : b.baseCoset ∈ MulAction.fixedBy (G ⧸ b.B) (F P) :=
    b.smul_baseCoset _ b.F_mem_B
  have hyF : y ∈ MulAction.fixedBy (G ⧸ b.B) (F P) :=
    hy ⟨F P, Subgroup.mem_zpowers _⟩
  let : Nontrivial (MulAction.fixedBy (G ⧸ b.B) (F P)) :=
    ⟨⟨⟨b.baseCoset, haF⟩, ⟨y, hyF⟩, fun h => hay (congrArg Subtype.val h)⟩⟩
  exact Nat.succ_le_of_lt (Finite.one_lt_card_iff_nontrivial.mpr inferInstance)

/-- The genuine representation on complex-valued functions on the cosets. -/
public abbrev cosetRepresentation : Representation ℂ G ((G ⧸ b.B) → ℂ) :=
  Representation.permutationAction G (G ⧸ b.B)

/-- Fong's coset character is the principal character plus the supplied
irreducible of degree 27. -/
public theorem cosetRepresentation_character (c : CharacterData P)
    (hG : Nat.card G = 6048)
    (hCF : Nat.card (Subgroup.centralizer ({F P} : Set G)) = 8) :
    b.cosetRepresentation.character = 1 + c.chi 1 := by
  apply c.identify_character hCF
  · exact Representation.permutationAction_isCharacter G (G ⧸ b.B)
  · rw [Representation.char_one]
    simp only [Module.finrank_pi, ← Nat.card_eq_fintype_card,
      b.card_cosets hG, Nat.cast_ofNat]
  · exact Representation.permutationAction_scalarProduct_one_of_pretransitive G (G ⧸ b.B)
  · change 2 ≤ ((Representation.permutationAction G (G ⧸ b.B)).character (F P)).re
    rw [Representation.permutationAction_character, Complex.natCast_re]
    exact_mod_cast b.two_le_fixedBy_F hG

/-- Pointwise fixed-point counts for the actual coset action. -/
public theorem coset_fixedPoint_count (c : CharacterData P)
    (hG : Nat.card G = 6048)
    (hCF : Nat.card (Subgroup.centralizer ({F P} : Set G)) = 8) (g : G) :
    (Nat.card (MulAction.fixedBy (G ⧸ b.B) g) : ℂ) = 1 + c.chi 1 g := by
  rw [← Representation.permutationAction_character]
  exact congrFun (b.cosetRepresentation_character c hG hCF) g

/-- The degree-28 coset action is doubly transitive. -/
public theorem cosetAction_two_pretransitive (c : CharacterData P)
    (hG : Nat.card G = 6048)
    (hCF : Nat.card (Subgroup.centralizer ({F P} : Set G)) = 8) :
    MulAction.IsMultiplyPretransitive G (G ⧸ b.B) 2 := by
  apply Representation.permutationAction_two_pretransitive_of_norm_two
  change scalarProduct G b.cosetRepresentation.character b.cosetRepresentation.character = 2
  rw [b.cosetRepresentation_character c hG hCF]
  have hne : (1 : ClassFunction G) ≠ c.chi 1 := by
    intro h
    have h1 := congrFun h 1
    rw [c.degree] at h1
    norm_num at h1
  rw [scalarProduct_add_left, scalarProduct_add_right, scalarProduct_add_right,
    irreducible_scalarProduct_self isLinearCharacter_one.1,
    irreducible_scalarProduct_self (c.irreducible 1),
    irreducible_scalarProduct_of_ne isLinearCharacter_one.1 (c.irreducible 1) hne,
    irreducible_scalarProduct_of_ne (c.irreducible 1) isLinearCharacter_one.1 hne.symm]
  norm_num

/-- Every nonidentity element of `Q` fixes exactly one coset. -/
public theorem Q_fixedPoint_count (c : CharacterData P)
    (hG : Nat.card G = 6048)
    (hCF : Nat.card (Subgroup.centralizer ({F P} : Set G)) = 8)
    (q : b.Q) (hq : q ≠ 1) :
    Nat.card (MulAction.fixedBy (G ⧸ b.B) (q : G)) = 1 := by
  have h := b.coset_fixedPoint_count c hG hCF (q : G)
  rw [c.vanishes_on_subgroup27 b.Q b.card_Q q hq, add_zero] at h
  exact_mod_cast h

/-- No nonidentity element of `Q` fixes a coset other than the identity coset. -/
public theorem Q_free_off_base (c : CharacterData P)
    (hG : Nat.card G = 6048)
    (hCF : Nat.card (Subgroup.centralizer ({F P} : Set G)) = 8)
    (q : b.Q) (x : G ⧸ b.B) (hx : x ≠ b.baseCoset)
    (hqx : (q : G) • x = x) : q = 1 := by
  by_contra hq
  have hsub := (Nat.card_eq_one_iff_unique.mp (b.Q_fixedPoint_count c hG hCF q hq)).1
  let u : MulAction.fixedBy (G ⧸ b.B) (q : G) := ⟨x, hqx⟩
  let v : MulAction.fixedBy (G ⧸ b.B) (q : G) :=
    ⟨b.baseCoset, b.smul_baseCoset q (b.Q_le_B q.property)⟩
  exact hx (congrArg Subtype.val (hsub.elim u v))

/-- The subgroup of order 27 acts regularly on all cosets except the identity
coset, with the actual ambient action and a unique subgroup element. -/
public theorem Q_regular_off_base (c : CharacterData P)
    (hG : Nat.card G = 6048)
    (hCF : Nat.card (Subgroup.centralizer ({F P} : Set G)) = 8)
    (x y : G ⧸ b.B) (hx : x ≠ b.baseCoset) (hy : y ≠ b.baseCoset) :
    ∃! q : b.Q, (q : G) • x = y := by
  exact MulAction.existsUnique_smul_eq_of_free_complement (H := b.Q) b.baseCoset
    (fun q => b.smul_baseCoset q (b.Q_le_B q.property))
    (fun q z hz hqz => b.Q_free_off_base c hG hCF q z hz hqz)
    (by rw [b.card_cosets hG, b.card_Q]) hx hy

end BorelSubgroups
end
end Stellmacher.Recognition.FongWreathed
