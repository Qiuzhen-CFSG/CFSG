module

public import Stellmacher.Recognition.NormalEightNonnormalNoncyclicTransferSetup
public import Theory.GroupTheory.PGroup.LargeHallRotationStructure

/-!
# The intrinsic rotation product in the actual core

The subgroup generated by core elements with nontrivial fourth power is
characteristic in the core, hence normal in the Sylow group. In the large
Hall-tail case, `sup_eq_closure_nontrivial_fourth_powers` identifies it with
the product of the extraspecial factor and the cyclic rotations. Describing
it intrinsically makes the subgroup independent of choices of factors.

This is the subgroup used in Janko–Thompson, Math. Z. 113 (1970), §4,
Case 1, printed p.392. Its inside and outside involution fusion are separate
from this definition and transport step.
-/

namespace Stellmacher.Recognition.NormalEightNonnormalImage
open Subgroup NormalFourCentralOmegaTwo
variable {G : Type*} [Group G]

/-- The intrinsic rotation product, viewed in the original Sylow subgroup. -/
public abbrev noncyclicRotationPreimage (S : Sylow 2 G) : Subgroup S :=
  (closure {x : omegaCorePreimage S | x ^ 4 ≠ 1}).map (omegaCorePreimage S).subtype

public theorem noncyclicRotationPreimage_le (S : Sylow 2 G) :
    noncyclicRotationPreimage S ≤ omegaCorePreimage S :=
  map_subtype_le _

public instance noncyclicRotationPreimage_normal (S : Sylow 2 G) :
    (noncyclicRotationPreimage S).Normal := by
  let K := closure {x : omegaCorePreimage S | x ^ 4 ≠ 1}
  let : K.Characteristic := by
    apply characteristic_iff_le_comap.mpr
    intro f
    apply (closure_le _).mpr
    intro x hx
    apply Subgroup.subset_closure
    change (f x) ^ 4 ≠ 1
    intro he
    apply hx
    apply f.injective
    simpa only [map_pow, map_one] using he
  exact ConjAct.normal_of_characteristic_of_normal

variable [Finite G]

/-- The intrinsic description commutes with the actual core equivalence. -/
public theorem noncyclicRotationPreimage_eq_map_quotient_core (S : Sylow 2 G) :
    noncyclicRotationPreimage S =
      (closure {x : pCore 2 (OmegaQuotient S) | x ^ 4 ≠ 1}).map
        ((omegaCorePreimage S).subtype.comp (omegaCorePreimageEquiv S).symm.toMonoidHom) := by
  let e := omegaCorePreimageEquiv S
  have he : (closure {x : pCore 2 (OmegaQuotient S) | x ^ 4 ≠ 1}).map
      e.symm.toMonoidHom = closure {x : omegaCorePreimage S | x ^ 4 ≠ 1} := by
    rw [MonoidHom.map_closure]
    congr 1
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩ heq
      apply hy
      apply e.symm.injective
      change e.symm.toMonoidHom (y ^ 4) = e.symm.toMonoidHom 1
      rw [map_pow, map_one]
      exact heq
    · intro hx
      refine ⟨e x, ?_, e.symm_apply_apply x⟩
      intro heq
      apply hx
      apply e.injective
      simpa only [map_pow, map_one] using heq
  rw [← map_map, he]

private theorem mem_fourth_power_closure_of_commuting_root
    {P : Type*} [Group P] (t x : P) (ht : t ^ 4 = 1)
    (hx : x ^ 4 ≠ 1) (hxt : Commute x t) :
    t ∈ closure {y : P | y ^ 4 ≠ 1} := by
  have hxK : x ∈ closure {y : P | y ^ 4 ≠ 1} := Subgroup.subset_closure hx
  have htxK : t * x ∈ closure {y : P | y ^ 4 ≠ 1} := by
    apply Subgroup.subset_closure
    change (t * x) ^ 4 ≠ 1
    rwa [hxt.symm.mul_pow, ht, one_mul]
  simpa using (closure {y : P | y ^ 4 ≠ 1}).mul_mem htxK
    ((closure {y : P | y ^ 4 ≠ 1}).inv_mem hxK)

/-- Commuting fourth roots put the normal four inside the intrinsic rotation
product. Only the normal elementary rank bound is used. -/
public theorem four_le_noncyclicRotationPreimage_of_large_noncyclic_tail
    (hN : IsNTwoGroup G) (S : Sylow 2 G)
    (hno : ¬ ∃ U : Subgroup S, U.Normal ∧ IsElementaryAbelian 2 U ∧ 8 ≤ Nat.card U)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (W : Subgroup S) [W.Normal] [IsElementaryAbelian 2 W] (hW : Nat.card W = 4)
    (hunique : ∀ F : Subgroup S, F.Normal → IsElementaryAbelian 2 F →
      Nat.card F = 4 → F = W)
    (hnormal : ¬ (fourImage S W).Normal)
    (B D : Subgroup (pCore 2 (OmegaQuotient S))) [B.Normal] [D.Normal]
    [IsExtraspecial 2 B] (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ centralizer (B : Set (pCore 2 (OmegaQuotient S))))
    (hg : B ⊔ D = ⊤) (hlarge : 16 ≤ Nat.card D)
    (z : S) (hzc : z ∈ center S) (hz : orderOf z = 2) :
    W ≤ noncyclicRotationPreimage S := by
  let H := omegaCorePreimage S
  let e := omegaCorePreimageEquiv S
  let : IsCyclic (center (pCore 2 (OmegaQuotient S))) :=
    omegaQuotient_pCore_center_isCyclic S hno W hunique hnormal
  obtain ⟨r, hr8, hsq, hcenter, hcent, hhalf⟩ :=
    IsBinaryHallFactor.exists_large_rotation (pCore_isPGroup.to_subgroup D) hD hn hlarge
  obtain ⟨R, _, _, hroots⟩ :=
    cyclic_squares_and_fourth_roots_of_central_product pCore_isPGroup B D hc hg
      r hr8 hsq hcenter hcent hhalf
  have hWH : W ≤ H := four_le_omegaCorePreimage hN S hZ W hW hno
  have hzW : z ∈ W := by
    apply omega_one_center_le_normal_four_of_no_normal_eight hno W hW
    refine ⟨⟨z, hzc⟩, Subgroup.subset_closure ?_, rfl⟩
    apply Subtype.ext
    change z ^ (2 ^ 1) = 1
    simpa only [pow_one, hz] using pow_orderOf_eq_one z
  let zH : H := ⟨z, hWH hzW⟩
  let F := (W.subgroupOf H).map e.toMonoidHom
  let : IsElementaryAbelian 2 (W.subgroupOf H) := IsElementaryAbelian.subgroupOf hWH
  let : IsElementaryAbelian 2 F := IsElementaryAbelian.map _
  let : F.Normal := (inferInstance : (W.subgroupOf H).Normal).map _ e.surjective
  have hF : Nat.card F = 4 := by
    rw [card_map_of_injective e.injective]
    exact (Nat.card_congr (subgroupOfEquivOfLe hWH).toEquiv).trans hW
  have hzC : e zH ∈ center (pCore 2 (OmegaQuotient S)) := by
    apply mem_center_iff.mpr
    intro y
    obtain ⟨u, rfl⟩ := e.surjective y
    rw [← map_mul, ← map_mul]
    exact congrArg e (Subtype.ext (mem_center_iff.mp hzc (u : S)))
  have hzO : orderOf (e zH) = 2 := by
    rw [e.orderOf_eq, ← Subgroup.orderOf_coe]
    exact hz
  intro w hw
  let wH : H := ⟨w, hWH hw⟩
  have hwF : e wH ∈ F := mem_map_of_mem e.toMonoidHom hw
  obtain ⟨x, hx, hxt⟩ := hroots F inferInstance inferInstance hF
    (e zH) (e wH) hzC hzO hwF
  have hw4 : (e wH) ^ 4 = 1 := by
    have h : (⟨e wH, hwF⟩ : F) ^ 4 = 1 := by
      rw [← hF]
      exact pow_card_eq_one'
    exact congrArg Subtype.val h
  have hx4 : x ^ 4 ≠ 1 := by
    rw [hx]
    intro he
    rw [he, orderOf_one] at hzO
    contradiction
  have hwK := mem_fourth_power_closure_of_commuting_root (e wH) x hw4 hx4 hxt
  rw [noncyclicRotationPreimage_eq_map_quotient_core]
  refine ⟨e wH, hwK, ?_⟩
  change (e.symm (e wH) : S) = w
  rw [e.symm_apply_apply]

end Stellmacher.Recognition.NormalEightNonnormalImage
