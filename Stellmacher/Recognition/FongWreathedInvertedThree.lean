module

public import Stellmacher.Recognition.FongWreathedBorelCentralizers
public import ABG.ChapterII.Section3.SourceThreeWreathedQuotient
public import Theory.GroupTheory.SymmetricFourCentralInverter
public import Theory.GroupTheory.CyclicFourCentralizerSylow

/-!
# The inverted order-three element in Fong's construction

The centralizer of `J` is a central extension of S₄ by the actual cyclic
subgroup generated by `F²`. The image of `E` has order four. The image of
`F` is a transposition: a double-transposition image would force `F⁴=1`.
A three-cycle inverted by that transposition lifts uniquely to an element
of order three, retaining the inversion by the specified `F`.
The normalizer condition in a Sylow overgroup of `⟨F²⟩` then makes
this cyclic subgroup Sylow in the full centralizer of the lifted element.

Source: Fong, *Some Sylow subgroups of order 32 and a characterization of
U(3,3)*, J. Algebra 6 (1967), pp.70–71 and p.75.
-/

namespace Stellmacher.Recognition.FongWreathed

variable {G : Type*} [Group G] [Finite G] [IsSimpleGroup G] {S : Sylow 2 G}
variable (P : ABG.Wreathed.Presentation S 2)
variable (hS : ABG.IsWreathedOfHeight S 2) (x : G) (hx : orderOf x = 2)
variable [Group.IsSolvable (Subgroup.centralizer ({x} : Set G))]

include hS x hx

/-- The lifted three-cycle, with control of all two-elements of its local centralizer. -/
public theorem exists_inverted_three_local (hG : Nat.card G = 6048) (c : CharacterData P) :
    ∃ R : G, orderOf R = 3 ∧ (F P)⁻¹ * R * F P = R⁻¹ ∧
      Commute (F P ^ 2) R ∧
      ∀ t : G, t ∈ Subgroup.centralizer ({J P} : Set G) → Commute t R →
        (∃ n : ℕ, t ^ (2 ^ n) = 1) → t ∈ Subgroup.zpowers (F P ^ 2) := by
  let C := Subgroup.centralizer ({J P} : Set G)
  let T : Sylow 2 C := S.subtype (sylow_le_centralizer_J P)
  let e : T ≃* S := Subgroup.subgroupOfEquivOfLe (sylow_le_centralizer_J P)
  let a : C := ⟨F P, sylow_le_centralizer_J P (P.s * P.z).property⟩
  let b : C := ⟨E P, sylow_le_centralizer_J P P.s.property⟩
  have hT : ABG.IsWreathedOfHeight T 2 := ABG.wreathed_equiv e.symm hS
  obtain ⟨hQ, hq, _, _⟩ :=
    involutionCentralizer_data_of_simple_wreathed32 S hS x hx (J P) (orderOf_J P)
  obtain ⟨_, f, hf, hker⟩ := ABG.qGroup_wreathed32_sourceThree_projective hQ
    (oddCore_centralizer_J_eq_bot P hS x hx hG c) T hT hq
  have hcentral : f.ker ≤ Subgroup.center C := by
    rw [hker]
    have hh := ABG.qGroup_eq_oddCore_mul_sylowCenterCentralizer hQ T
    rw [oddCore_centralizer_J_eq_bot P hS x hx hG c, bot_sup_eq] at hh
    exact Subgroup.centralizer_eq_top_iff_subset.mp hh
  have ha : orderOf a = 8 := (Subgroup.orderOf_coe a).symm.trans (orderOf_F P)
  have haz : a ^ 2 ∈ ABG.subgroupCenter (T : Subgroup C) := by
    have hu : e.symm P.u ∈ Subgroup.center T := by
      apply Subgroup.mem_center_iff.mpr
      intro t
      apply e.injective
      simpa only [map_mul, e.apply_symm_apply] using
        Subgroup.mem_center_iff.mp P.u_mem_center (e t)
    refine ⟨e.symm P.u, hu, ?_⟩
    apply Subtype.ext
    exact (F_sq P).symm
  have hk : f.ker = Subgroup.zpowers (a ^ 2) := by
    rw [hker]
    symm
    apply Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr haz)
    obtain ⟨Q⟩ := ABG.Wreathed.nonempty_presentation hT
    rw [ABG.subgroupCenter, Subgroup.card_map_of_injective
      (T : Subgroup C).subtype_injective, Q.card_center, Nat.card_zpowers]
    have hh : orderOf (a ^ 2) = 4 :=
      (Subgroup.orderOf_coe (a ^ 2)).symm.trans (orderOf_F_sq P)
    rw [hh]
    decide
  have hb : b ^ 4 = 1 := by
    apply Subtype.ext
    exact congrArg (fun s : S => (s : G)) P.s_pow
  have hb2 : f (b ^ 2) ≠ 1 := by
    intro hh
    have hc := hcentral hh
    let z : C := ⟨(P.z : G), sylow_le_centralizer_J P P.z.property⟩
    have heq : P.z * P.s ^ 2 = P.s ^ 2 * P.z := by
      apply Subtype.ext
      exact congrArg (fun c : C => (c : G)) (Subgroup.mem_center_iff.mp hc z)
    have hz := P.z_mul_s_pow 2
    exact P.x₂_ne_x₃ (mul_right_cancel (heq.symm.trans hz))
  obtain ⟨r, hr, har, hbound⟩ :=
    f.exists_inverted_three_of_symmetric_four_central_cover hf a b ha hk hcentral hb hb2
  refine ⟨(r : G), (Subgroup.orderOf_coe r).trans hr,
    congrArg Subtype.val har, ?_, ?_⟩
  · have hh : a ^ 2 ∈ Subgroup.center C := hcentral (hk ▸ Subgroup.mem_zpowers _)
    exact (show Commute (a ^ 2) r from
      (Subgroup.mem_center_iff.mp hh r).symm).map C.subtype
  · intro t ht htr htp
    have hh := hbound ⟨t, ht⟩ (show Commute (⟨t, ht⟩ : C) r from Subtype.ext htr.eq)
      (by obtain ⟨n, hn⟩ := htp; exact ⟨n, Subtype.ext hn⟩)
    rw [hk] at hh
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hh
    exact Subgroup.mem_zpowers_iff.mpr ⟨n, congrArg Subtype.val hn⟩

/-- Fong's actual order-three seed, inverted by the fixed `F`, with the
specified cyclic Sylow two-subgroup in its ambient centralizer. -/
public theorem exists_inverted_three (hG : Nat.card G = 6048) (c : CharacterData P) :
    ∃ R : G, orderOf R = 3 ∧ (F P)⁻¹ * R * F P = R⁻¹ ∧
      ∃ T : Sylow 2 (Subgroup.centralizer ({R} : Set G)),
        (T : Subgroup (Subgroup.centralizer ({R} : Set G))).map
          (Subgroup.centralizer ({R} : Set G)).subtype = Subgroup.zpowers (F P ^ 2) := by
  obtain ⟨R, hR, hFR, hF2R, hbound⟩ := exists_inverted_three_local P hS x hx hG c
  refine ⟨R, hR, hFR, Subgroup.exists_sylow_centralizer_eq_zpowers_four
    (F P ^ 2) R (orderOf_F_sq P) hF2R ?_⟩
  intro t ht htr htp
  apply hbound t _ htr htp
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  simpa only [← pow_mul, J] using ht.eq

end Stellmacher.Recognition.FongWreathed
