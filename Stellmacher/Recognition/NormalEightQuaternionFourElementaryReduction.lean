module

public import Stellmacher.Recognition.NormalEightQuaternionFourElementarySetup
public import Stellmacher.Recognition.NormalEightQuaternionFourElementaryGeometry
public import Stellmacher.Recognition.NormalEightQuaternionFourSeparation
public import Theory.GroupTheory.ElementarySixteenCentralizer
public import Theory.GroupTheory.IndexFourInvolutionTransfer

/-!
# Transfer reduction for the elementary fixed quaternion core

Transitivity of the core on the outside involution coset forces the Sylow
centralizer to cover the quotient of order four. Identification of the fixed
core with the distinguished four then gives centralizer order sixteen.
Thompson transfer through the subgroup generated by the core and the outside
involution extends the core's involution class cover to the entire Sylow.

The local action geometry and elementary-centralizer calculation are discharged.
The separation module supplies the ambient distinction between the noncentral
involutions of the normal four and the central involution, so the final wrapper
has no remaining local premise. The subsequent exclusion of the elementary
sixteen is separate.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, case (b)(ii), printed p.391.
-/

open Subgroup
open Stellmacher.Recognition.NormalFourCentralOmegaTwo
namespace Stellmacher.Recognition.NormalEightNonnormalImage
variable {G : Type*} [Group G] [Finite G]

/-- The fixed four and the outside-coset orbit give the exact centralizer
order and its surjectivity onto the core quotient. -/
public theorem quaternion_four_centralizer_card_of_fixed_and_coset
    (S : Sylow 2 G) (W : Subgroup S) (hW : Nat.card W = 4)
    (t : S) (ht : orderOf t = 2)
    (hindex : (omegaCorePreimage S).index = 4)
    (hfixed : omegaCorePreimage S ⊓ centralizer ({t} : Set S) = W)
    (hcoset : ∀ u : S, orderOf u = 2 → u * t⁻¹ ∈ omegaCorePreimage S →
      ∃ h : S, h ∈ omegaCorePreimage S ∧ h * t * h⁻¹ = u) :
    Nat.card (centralizer ({t} : Set S)) = 16 ∧
      omegaCorePreimage S ⊔ centralizer ({t} : Set S) = ⊤ := by
  have hcard : Nat.card ((omegaCorePreimage S).subgroupOf
      (centralizer ({t} : Set S))) = 4 := by
    rw [← card_map_of_injective (centralizer ({t} : Set S)).subtype_injective,
      subgroupOf_map_subtype, hfixed, hW]
  refine ⟨?_, sup_centralizer_eq_top_of_index_four_coset_involutions
    (omegaCorePreimage S) hindex t ht hcoset⟩
  rw [card_centralizer_of_index_four_coset_involutions
    (omegaCorePreimage S) hindex t ht hcoset, hcard]

/-- Assemble the requested transfer conclusion from the local action
geometry and the elementary-centralizer calculation. -/
public theorem quaternion_four_elementary_reduction_of_geometry [IsSimpleGroup G]
    (S : Sylow 2 G) (W : Subgroup S) (hW : Nat.card W = 4)
    (z t : S) (hzW : z ∈ W) (ht : orderOf t = 2)
    (hout : t ∉ omegaCorePreimage S) (hzt : IsConj (z : G) (t : G))
    (hindex : (omegaCorePreimage S).index = 4)
    (hfixed : omegaCorePreimage S ⊓ centralizer ({t} : Set S) = W)
    (helementary : IsElementaryAbelian 2 (centralizer ({t} : Set S)))
    (hinside : ∀ u : S, u ∈ omegaCorePreimage S → orderOf u = 2 →
      ∃ w : S, w ∈ W ∧ IsConj (u : G) (w : G))
    (hcoset : ∀ u : S, orderOf u = 2 → u * t⁻¹ ∈ omegaCorePreimage S →
      ∃ h : S, h ∈ omegaCorePreimage S ∧ h * t * h⁻¹ = u) :
    omegaCorePreimage S ⊓ centralizer ({t} : Set S) = W ∧
      IsElementaryAbelian 2 (centralizer ({t} : Set S)) ∧
      Nat.card (centralizer ({t} : Set S)) = 16 ∧
      (∀ u : S, orderOf u = 2 → ∃ w : S, w ∈ W ∧ IsConj (u : G) (w : G)) := by
  have hno : ∀ K : Subgroup G, K.Normal → K.index ≠ 2 := by
    intro K hK hi
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal K hK with hb | htop
    · have hbound : 4 ≤ Nat.card G := hW ▸
        W.card_le_card_group.trans (S : Subgroup G).card_le_card_group
      rw [hb, index_bot] at hi
      omega
    · simp [htop] at hi
  refine ⟨hfixed, helementary,
    (quaternion_four_centralizer_card_of_fixed_and_coset S W hW t ht hindex hfixed hcoset).1,
    S.involution_cover_of_index_four_coset hno (omegaCorePreimage S) W hindex
      z t hzW ht hout hzt hinside ?_⟩
  intro u hu hcos
  obtain ⟨h, _, hh⟩ := hcoset u hu hcos
  exact isConj_iff.mpr ⟨(h : G), congrArg Subtype.val hh⟩

/-- All local geometry, counting, and transfer obligations are discharged;
the remaining ambient input separates the other involutions of the normal four
from the central involution. -/
public theorem quaternion_four_elementary_reduction_of_separation [IsSimpleGroup G]
    (hN : IsNTwoGroup G) (S : Sylow 2 G)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (hno : ¬ ∃ F : Subgroup S, F.Normal ∧ IsElementaryAbelian 2 F ∧ 8 ≤ Nat.card F)
    (W : Subgroup S) [W.Normal] [IsElementaryAbelian 2 W] (hW : Nat.card W = 4)
    (hunique : ∀ F : Subgroup S, F.Normal → IsElementaryAbelian 2 F → Nat.card F = 4 → F = W)
    [IsExtraspecial 2 (pCore 2 (OmegaQuotient S))]
    (hH : Nat.card (pCore 2 (OmegaQuotient S)) = 32)
    (B C : Subgroup (pCore 2 (OmegaQuotient S)))
    (hB : Nonempty (B ≃* QuaternionGroup 2)) (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hjoin : B ⊔ C = ⊤) (hinter : Nat.card (B ⊓ C : Subgroup _) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b*c=c*b)
    (z t : S) (hz : orderOf z = 2) (hzc : z ∈ center S)
    (ht : orderOf t = 2) (hout : t ∉ omegaCorePreimage S)
    (hconj : IsConj (z : G) (t : G))
    (hindex : (omegaCorePreimage S).index = 4)
    (hfixed : IsElementaryAbelian 2 ((omegaCorePreimage S).subgroupOf
      (centralizer ({t} : Set S))))
    (hfixed_card : Nat.card ((omegaCorePreimage S).subgroupOf
      (centralizer ({t} : Set S))) ≤ 4)
    (hsat : ∀ V : Subgroup G, IsPGroup 2 V →
      (centralizer ({t} : Set S)).map (S : Subgroup G).subtype ≤ V →
      V ≤ centralizer ({(z : G), (t : G)} : Set G) →
      V = (centralizer ({t} : Set S)).map (S : Subgroup G).subtype)
    (hsep : ∀ w : S, w ∈ W → w ≠ 1 → w ≠ z → ¬ IsConj (z : G) (w : G)) :
    omegaCorePreimage S ⊓ centralizer ({t} : Set S) = W ∧
      IsElementaryAbelian 2 (centralizer ({t} : Set S)) ∧
      Nat.card (centralizer ({t} : Set S)) = 16 ∧
      (∀ u : S, orderOf u = 2 → ∃ w : S, w ∈ W ∧ IsConj (u : G) (w : G)) := by
  obtain ⟨hfixedW, hcoset⟩ := quaternion_four_elementary_fixed_eq_and_coset
    hN S hZ W hunique B C hB hC hjoin hinter hcomm t ht hout hindex hfixed hfixed_card
  have hcard := (quaternion_four_centralizer_card_of_fixed_and_coset
    S W hW t ht hindex hfixedW hcoset).1
  have hWP : W ≤ omegaCorePreimage S := hfixedW ▸ inf_le_left
  have hWE : W ≤ centralizer ({t} : Set S) := hfixedW ▸ inf_le_right
  have hzW : z ∈ W := omega_one_center_le_normal_four_of_no_normal_eight hno W hW
    ⟨⟨z, hzc⟩, subset_closure (by
      apply Subtype.ext
      change z ^ (2 ^ 1) = 1
      simpa only [pow_one, hz] using pow_orderOf_eq_one z), rfl⟩
  have hproper : centralizer ({t} : Set S) ≠ ⊤ := by
    intro htop
    have hS := (omegaCorePreimage S).index_mul_card
    rw [hindex, card_omegaCorePreimage, hH] at hS
    rw [htop, Nat.card_congr Subgroup.topEquiv.toEquiv] at hcard
    omega
  have helem := S.isElementaryAbelian_centralizer_of_saturated_sixteen
    W hW z t hz hzc hzW ht (fun h => hout (hWP h)) hconj hWE hcard hproper hsep
    (fun u hu hcos => by
      obtain ⟨a, _, ha⟩ := hcoset u hu (hWP hcos)
      exact isConj_iff.mpr ⟨(a : G), congrArg Subtype.val ha⟩) hsat
  exact quaternion_four_elementary_reduction_of_geometry S W hW z t hzW ht hout hconj
    hindex hfixedW helem
    (quaternion_four_core_involution_cover hN S hZ hno W hW hH
      B C hB hC hjoin hinter hcomm z hz hzc hindex.ge) hcoset

/-- The quaternion index-four hypotheses supply the ambient separation needed
by the transfer reduction. -/
public theorem quaternion_four_elementary_reduction [IsSimpleGroup G]
    (_hns : ¬ Group.IsSolvable G)
    (hN : IsNTwoGroup G) (S : Sylow 2 G)
    (A : Subgroup S) [IsElementaryAbelian 2 A] (_hA : 8 ≤ Nat.card A)
    (_hnonab : ¬ IsMulCommutative S)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (hno : ¬ ∃ F : Subgroup S, F.Normal ∧ IsElementaryAbelian 2 F ∧
      8 ≤ Nat.card F)
    (W : Subgroup S) [W.Normal] [IsElementaryAbelian 2 W]
    (hW : Nat.card W = 4)
    (hunique : ∀ F : Subgroup S, F.Normal → IsElementaryAbelian 2 F →
      Nat.card F = 4 → F = W)
    (_hnormal : ¬ (fourImage S W).Normal)
    [IsExtraspecial 2 (pCore 2 (OmegaQuotient S))]
    (hH : Nat.card (pCore 2 (OmegaQuotient S)) = 32)
    (B C : Subgroup (pCore 2 (OmegaQuotient S)))
    (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hjoin : B ⊔ C = ⊤)
    (hinter : Nat.card (B ⊓ C : Subgroup _) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b * c = c * b)
    (z t : S) (hz : orderOf z = 2) (hzc : z ∈ center S)
    (ht : orderOf t = 2) (hout : t ∉ omegaCorePreimage S)
    (hconj : IsConj (z : G) (t : G))
    (hindex : (omegaCorePreimage S).index = 4)
    (hquot : IsElementaryAbelian 2 (S ⧸ omegaCorePreimage S))
    (hfixed : IsElementaryAbelian 2 ((omegaCorePreimage S).subgroupOf
      (centralizer ({t} : Set S))))
    (hfixed_card : Nat.card ((omegaCorePreimage S).subgroupOf
      (centralizer ({t} : Set S))) ≤ 4)
    (hsat : ∀ V : Subgroup G, IsPGroup 2 V →
      (centralizer ({t} : Set S)).map (S : Subgroup G).subtype ≤ V →
      V ≤ centralizer ({(z : G), (t : G)} : Set G) →
      V = (centralizer ({t} : Set S)).map (S : Subgroup G).subtype) :
    omegaCorePreimage S ⊓ centralizer ({t} : Set S) = W ∧
      IsElementaryAbelian 2 (centralizer ({t} : Set S)) ∧
      Nat.card (centralizer ({t} : Set S)) = 16 ∧
      (∀ u : S, orderOf u = 2 → ∃ w : S, w ∈ W ∧
        IsConj (u : G) (w : G)) := by
  have hsep := quaternion_four_normal_four_separation hN S hZ hno W hW
    hunique hH B C hB hC hjoin hinter hcomm z t hz hzc ht hout hindex hquot
    hfixed hfixed_card
  exact quaternion_four_elementary_reduction_of_separation hN S hZ hno W hW
    hunique hH B C hB hC hjoin hinter hcomm z t hz hzc ht hout hconj hindex
    hfixed hfixed_card hsat hsep

end Stellmacher.Recognition.NormalEightNonnormalImage
