module

public import Stellmacher.Recognition.LargeTerminalReeRootSeed
public import Stellmacher.Recognition.LargeTerminalFiveNormalizerData
public import Stellmacher.Recognition.LargeTerminalFiveFixedRootOrientation
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Compatibility of squaring elements with the fixed root

An order-four element of the actual five-fixed subgroup generates it.
Conjugation by its local normalizer therefore either fixes or inverts that
root. In particular the square of every local normalizer element fixes it.
Pointwise fixation follows by comparing a squaring element with the geometric
fixing witness; no fourth-power calculation or splitting assertion is used here.

These are reductions for the local calculation left implicit in Thompson VI,
pp.629–630, and specified by the Ree relations in Shinoda (1975), pp.81–83.
The local five-centralizer is generated by the five-subgroup and the fixed
root. Consequently two elements with the same action on the five-subgroup
have the same action on the root. It is enough to find one squaring element
that fixes the root, with no condition on its order. The terminal orientation
theorem supplies this witness and completes the compatibility calculation.
-/

namespace Stellmacher.Recognition
open Later SectionsFiveToSeven CosetGraphContext SevenSix SectionNine Subgroup
open scoped IsMulCommutative
universe u

private theorem conjugate_four_eq_self_or_inv
    {G : Type*} [Group G] [Finite G] (t b : G) (ht : orderOf t = 4)
    (hb : b ∈ normalizer (zpowers t : Set G)) :
    b * t * b⁻¹ = t ∨ b * t * b⁻¹ = t⁻¹ := by
  classical
  let f := MulAut.conj b
  have hm : f t ∈ zpowers t := (hb t).mp (mem_zpowers t)
  have ho : orderOf (f t) = 4 := (f.orderOf_eq t).trans ht
  have ht4 : t ^ 4 = 1 := ht ▸ pow_orderOf_eq_one t
  rw [(orderOf_pos_iff.mp (by omega : 0 < orderOf t)).mem_zpowers_iff_mem_range_orderOf,
    ht] at hm
  obtain ⟨n, hn, he⟩ := Finset.mem_image.mp hm
  have hn4 := Finset.mem_range.mp hn
  change f t = t ∨ f t = t⁻¹
  interval_cases n
  · simp only [pow_zero] at he
    rw [← he, orderOf_one] at ho
    contradiction
  · exact Or.inl (by simpa only [pow_one] using he.symm)
  · rw [← he, orderOf_pow, ht] at ho
    norm_num at ho
  · right
    rw [← he]
    apply eq_inv_of_mul_eq_one_left
    simpa only [← pow_succ] using ht4

/-- Any order-four fixed root generates the actual fixed subgroup in the core.
Cyclicity need not be supplied separately once the root has been chosen. -/
public theorem LargeTerminalContext.five_fixed_root_zpowers_eq
    {G : Type u} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (A : Subgroup G)
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (t : G) (htQ : t ∈ twoCoreIn ctx.second)
    (htA : t ∈ centralizer (A : Set G)) (ht4 : orderOf t = 4) :
    zpowers t = twoCoreIn ctx.second ⊓ centralizer (A : Set G) := by
  have hc : Nat.card (twoCoreIn ctx.second ⊓ centralizer (A : Set G) : Subgroup G) = 4 := by
    rw [← card_map_of_injective (twoCoreIn ctx.second).subtype_injective,
      subgroupOf_map_subtype, inf_comm] at hcard
    exact hcard
  have hle : zpowers t ≤ twoCoreIn ctx.second ⊓ centralizer (A : Set G) :=
    zpowers_le.mpr ⟨htQ, htA⟩
  apply eq_of_le_of_card_ge hle
  rw [Nat.card_zpowers, ht4, hc]

/-- The exact remaining alternatives for the action of a local normalizer on
an order-four fixed root. This applies in particular to a squaring lift. -/
public theorem LargeTerminalContext.five_fixed_root_conjugate_eq_self_or_inv
    {G : Type u} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (A : Subgroup G)
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (b t : G) (hbP : b ∈ ctx.second) (hbN : b ∈ normalizer (A : Set G))
    (htQ : t ∈ twoCoreIn ctx.second) (htA : t ∈ centralizer (A : Set G))
    (ht4 : orderOf t = 4) :
    b * t * b⁻¹ = t ∨ b * t * b⁻¹ = t⁻¹ := by
  have hQ : ctx.second ≤ normalizer (twoCoreIn ctx.second : Set G) :=
    (normal_subgroupOf_iff_le_normalizer (twoCoreIn_le ctx.second)).mp
      (twoCoreIn_normal ctx.second)
  have hbF := inf_normalizer_le_normalizer_inf
    ⟨hQ hbP, normalizer_le_normalizer_centralizer A hbN⟩
  rw [← ctx.five_fixed_root_zpowers_eq A hcard t htQ htA ht4] at hbF
  exact conjugate_four_eq_self_or_inv t b ht4 hbF

/-- Squaring any local normalizer element kills its action on the cyclic
fixed root, independently of the order of that normalizer element. -/
public theorem LargeTerminalContext.five_local_normalizer_square_commutes_fixed_root
    {G : Type u} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (A : Subgroup G)
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (b t : G) (hbP : b ∈ ctx.second) (hbN : b ∈ normalizer (A : Set G))
    (htQ : t ∈ twoCoreIn ctx.second) (htA : t ∈ centralizer (A : Set G))
    (ht4 : orderOf t = 4) : Commute (b ^ 2) t := by
  rcases ctx.five_fixed_root_conjugate_eq_self_or_inv A hcard b t hbP hbN htQ htA ht4
    with h | h
  · exact (show Commute b t from mul_inv_eq_iff_eq_mul.mp h).pow_left 2
  · have hi : b * t⁻¹ * b⁻¹ = t := by
      have hh := congrArg Inv.inv h
      simpa only [mul_inv_rev, inv_inv, mul_assoc] using hh
    have hh : b ^ 2 * t * (b ^ 2)⁻¹ = t := by
      calc
        _ = b * (b * t * b⁻¹) * b⁻¹ := by
          simp only [pow_two, mul_inv_rev, mul_assoc]
        _ = t := by rw [h, hi]
    exact mul_inv_eq_iff_eq_mul.mp hh

/-- Excluding inversion is sufficient for the required compatibility. The
noninversion input is the substantive local calculation still needed. -/
public theorem LargeTerminalContext.five_local_normalizer_commutes_fixed_root_of_not_inverts
    {G : Type u} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (A : Subgroup G)
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (b t : G) (hbP : b ∈ ctx.second) (hbN : b ∈ normalizer (A : Set G))
    (htQ : t ∈ twoCoreIn ctx.second) (htA : t ∈ centralizer (A : Set G))
    (ht4 : orderOf t = 4) (hnot : b * t * b⁻¹ ≠ t⁻¹) : Commute b t := by
  exact mul_inv_eq_iff_eq_mul.mp
    ((ctx.five_fixed_root_conjugate_eq_self_or_inv A hcard b t hbP hbN htQ htA ht4).resolve_right hnot)

/-- An order-four fixed root and the five-subgroup generate the full local
five-centralizer. In particular this centralizer is abelian. -/
public theorem LargeTerminalContext.five_local_centralizer_eq_sup_fixed_root
    {G : Type u} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (hS : Nat.card S = 4096)
    (A : Subgroup G) (hA : Nat.card A = 5) (hAP : A ≤ ctx.second)
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (t : G) (htQ : t ∈ twoCoreIn ctx.second)
    (htA : t ∈ centralizer (A : Set G)) (ht4 : orderOf t = 4) :
    ctx.second ⊓ centralizer (A : Set G) = A ⊔ zpowers t := by
  have hbound := ctx.five_local_centralizer_card_le_twenty hS A hA hAP hcard
  let _ : Fact (Nat.Prime 5) := ⟨by decide⟩
  let _ : IsCyclic A := isCyclic_of_prime_card hA
  have hTA : zpowers t ≤ centralizer (A : Set G) := zpowers_le.mpr htA
  have hAC : A ≤ ctx.second ⊓ centralizer (A : Set G) := le_inf hAP (le_centralizer A)
  have hTC : zpowers t ≤ ctx.second ⊓ centralizer (A : Set G) :=
    le_inf (zpowers_le.mpr (twoCoreIn_le ctx.second htQ)) hTA
  have hT : Nat.card (zpowers t) = 4 := (Nat.card_zpowers t).trans ht4
  have hd : Disjoint A (zpowers t) :=
    (IsPGroup.of_card (p := 5) (n := 1) (by simpa using hA)).disjoint_of_coprime
      (IsPGroup.of_card (p := 2) (n := 2) (by simpa using hT)) (by decide)
  have hprod : Nat.card (A ⊔ zpowers t : Subgroup G) = 20 := by
    rw [card_sup_eq_mul_of_normalizes_of_disjoint A (zpowers t)
      (hTA.trans (Subgroup.centralizer_le_normalizer _)) hd, hA, hT]
  exact (eq_of_le_of_card_ge (sup_le hAC hTC) (by omega)).symm

/-- Elements centralizing the five-subgroup in the second local group fix
the cyclic fixed root pointwise. -/
public theorem LargeTerminalContext.five_local_centralizer_commutes_fixed_root
    {G : Type u} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (hS : Nat.card S = 4096)
    (A : Subgroup G) (hA : Nat.card A = 5) (hAP : A ≤ ctx.second)
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (t : G) (htQ : t ∈ twoCoreIn ctx.second)
    (htA : t ∈ centralizer (A : Set G)) (ht4 : orderOf t = 4)
    (d : G) (hdP : d ∈ ctx.second) (hdA : d ∈ centralizer (A : Set G)) :
    Commute d t := by
  have hTA : zpowers t ≤ centralizer (A : Set G) := zpowers_le.mpr htA
  have hle : ctx.second ⊓ centralizer (A : Set G) ≤ centralizer (zpowers t : Set G) := by
    rw [ctx.five_local_centralizer_eq_sup_fixed_root hS A hA hAP hcard
      t htQ htA ht4]
    exact sup_le (le_centralizer_iff.mpr hTA) (le_centralizer _)
  exact (mem_centralizer_iff.mp (hle ⟨hdP, hdA⟩) t (mem_zpowers t)).symm

/-- Two local elements inducing the same conjugation on the five-subgroup
induce the same conjugation on its cyclic fixed root. No order assumptions
on either element are required. -/
public theorem LargeTerminalContext.five_fixed_root_conjugate_eq_of_same_action
    {G : Type u} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (hS : Nat.card S = 4096)
    (A : Subgroup G) (hA : Nat.card A = 5) (hAP : A ≤ ctx.second)
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (t : G) (htQ : t ∈ twoCoreIn ctx.second)
    (htA : t ∈ centralizer (A : Set G)) (ht4 : orderOf t = 4)
    (a b : G) (haP : a ∈ ctx.second) (hbP : b ∈ ctx.second)
    (hab : ∀ c ∈ A, a * c * a⁻¹ = b * c * b⁻¹) :
    a * t * a⁻¹ = b * t * b⁻¹ := by
  have hdA : b⁻¹ * a ∈ centralizer (A : Set G) := by
    apply mem_centralizer_iff.mpr
    intro c hc
    have hh : (b⁻¹ * a) * c * (b⁻¹ * a)⁻¹ = c := by
      calc
        _ = b⁻¹ * (a * c * a⁻¹) * b := by group
        _ = b⁻¹ * (b * c * b⁻¹) * b := by rw [hab c hc]
        _ = c := by group
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm
  have hd := ctx.five_local_centralizer_commutes_fixed_root hS A hA hAP hcard t htQ htA ht4 (b⁻¹ * a)
    (ctx.second.mul_mem (ctx.second.inv_mem hbP) haP) hdA
  calc
    a * t * a⁻¹ = b * ((b⁻¹ * a) * t * (b⁻¹ * a)⁻¹) * b⁻¹ := by group
    _ = b * t * b⁻¹ := by rw [mul_inv_eq_iff_eq_mul.mpr hd.eq]

/-- A single squaring element fixing the fixed subgroup forces every local
squaring element to fix each order-four root in it. The witness has no order
restriction; this reduction is independent of the fourth-power calculation. -/
public theorem LargeTerminalContext.five_squaring_commutes_fixed_root_of_witness
    {G : Type u} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (hS : Nat.card S = 4096)
    (A : Subgroup G) (hA : Nat.card A = 5) (hAP : A ≤ ctx.second)
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (hgood : ∃ a : G, a ∈ ctx.second ∧
      (∀ c ∈ A, a * c * a⁻¹ = c ^ 2) ∧
      a ∈ centralizer
        ((twoCoreIn ctx.second ⊓ centralizer (A : Set G) : Subgroup G) : Set G))
    (b t : G) (hbP : b ∈ ctx.second)
    (hb : ∀ c ∈ A, b * c * b⁻¹ = c ^ 2)
    (htQ : t ∈ twoCoreIn ctx.second) (htA : t ∈ centralizer (A : Set G))
    (ht4 : orderOf t = 4) : Commute b t := by
  obtain ⟨a, haP, ha, haF⟩ := hgood
  have he := ctx.five_fixed_root_conjugate_eq_of_same_action hS A hA hAP hcard
    t htQ htA ht4 b a hbP haP (fun c hc => (hb c hc).trans (ha c hc).symm)
  have hat : Commute a t := (mem_centralizer_iff.mp haF t ⟨htQ, htA⟩).symm
  exact mul_inv_eq_iff_eq_mul.mp (he.trans (mul_inv_eq_iff_eq_mul.mpr hat.eq))

/-- Every local element squaring the five-subgroup commutes with its fixed
root. The terminal geometry supplies one fixing witness, and the local
five-centralizer comparison transfers its action to the given element.
No order bound on the squaring element is needed. -/
public theorem LargeTerminalContext.five_squaring_commutes_fixed_root
    {G : Type u} [Group G] [Finite G] {S : Sylow 2 G}
    (ctx : LargeTerminalContext S) (hS : Nat.card S = 4096)
    (z : G) (hz : orderOf z = 2)
    (hgen : zpowers z = omegaOneCenter (S : Subgroup G))
    (A : Subgroup G) (hA : Nat.card A = 5) (hAP : A ≤ ctx.second)
    (hAN : A ≤ normalizer (ctx.firstResidual : Set G))
    (hcard : Nat.card ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)) = 4)
    (hcyc : IsCyclic ((centralizer (A : Set G)).subgroupOf
      (twoCoreIn ctx.second)))
    (hfixed : (centralizer (A : Set G)).subgroupOf ctx.firstResidual ≤
      center ctx.firstResidual)
    (b t : G) (hbP : b ∈ ctx.second)
    (hb : ∀ c ∈ A, b * c * b⁻¹ = c ^ 2)
    (htQ : t ∈ twoCoreIn ctx.second) (htA : t ∈ centralizer (A : Set G))
    (ht4 : orderOf t = 4) : Commute b t := by
  exact ctx.five_squaring_commutes_fixed_root_of_witness hS A hA hAP hcard
    (ctx.exists_five_squaring_fixed_root hS A hA hAP hAN hcard hcyc hfixed z hz hgen)
    b t hbP hb htQ htA ht4

end Stellmacher.Recognition
