module

public import Stellmacher.Recognition.Parrott.SecondNormalizer
public import Stellmacher.Recognition.Parrott.CoreCentralizerCounts
public import Stellmacher.Recognition.Parrott.OuterFourFixedSpace
public import Theory.GroupTheory.CentralizerIndexBound

/-!
# Centers in the normalizer of Parrott's second elementary subgroup

The center of the supplied Sylow subgroup has order two and its actual
ambient image is generated by the original involution. This follows from
the self-centralizing two-core of the original involution centralizer and
its center of order two, retaining the chosen Sylow subgroup throughout.

For the normalizer core K, put Z=Z(K) in the ambient group. Its intersection
with the derived core E has index at most two, since Z lies in F. If Z lies
in E, the central commutator pairing bounds its centralizer in the original
core. Otherwise any element of Z outside E has core centralizer of order at
most 64. The order-four fixed-space bound controls the remaining index in T.
Together these give |Z(K)|≤8 when |K|=256 and |Z(K)|≤4 when |K|≥512.

Source: Parrott, *A characterization of the Tits' simple group* (1972),
p.672 Lemma 1 and p.677, the center calculations preceding Lemma 6.
-/

open Subgroup

namespace Stellmacher.Recognition.ParrottSecondElementaryData

variable {G : Type*} [Group G] [Finite G] {z : G}

/-- The center of the supplied ambient Sylow subgroup is generated by z. -/
public theorem sylow_center_map (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) :
    (center d.sylow).map (d.sylow : Subgroup G).subtype = zpowers z := by
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let E := (commutator J).map (H.subtype.comp J.subtype)
  obtain ⟨hZmap, _, _, _, _, _, _, _⟩ := parrott_centralizer_structure z h
  have hZcard : Nat.card (center J) = 2 := by
    have hc := card_map_of_injective (K := center J) (f := H.subtype.comp J.subtype)
      (H.subtype_injective.comp J.subtype_injective)
    rw [hZmap, Nat.card_zpowers, h.involution] at hc
    exact hc.symm
  have hself : centralizer (J : Set H) ≤ J := by
    intro x hx
    have hxE : (x : G) ∈ E := by
      have hCE : centralizer (E : Set G) = E := parrott_derived_centralizer z h
      rw [← hCE]
      rintro e ⟨j, hj, rfl⟩
      exact congrArg H.subtype (hx j j.property)
    obtain ⟨j, _, hjx⟩ := hxE
    exact (H.subtype_injective hjx) ▸ j.property
  have hmap := mapped_sylow_center_of_center_two_core z h.involution hZcard hself d.localSylow
  rw [← d.sylow_map] at hmap
  exact hmap

/-- The actual Sylow subgroup selected with the second elementary subgroup
has center of order two. -/
public theorem sylow_center_card (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) : Nat.card (center d.sylow) = 2 := by
  have hc := card_map_of_injective (K := center d.sylow)
    (d.sylow : Subgroup G).subtype_injective
  rw [d.sylow_center_map h, Nat.card_zpowers, h.involution] at hc
  exact hc.symm

private theorem centralizing_center_bounds (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (X Z : Subgroup G)
    (hXT : X ≤ d.sylow) (hZF : Z ≤ d.F) (hzZ : z ∈ Z)
    (hXZ : X ≤ centralizer (Z : Set G)) :
    (16 ≤ Nat.card Z → Nat.card X ≤ 128) ∧
      (8 ≤ Nat.card Z → Nat.card X ≤ 256) := by
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let B := J.map H.subtype
  let E := (commutator J).map (H.subtype.comp J.subtype)
  let U := E ⊓ Z
  have hindex (V : Subgroup G) (hVE : V ≤ E) (hV : 8 ≤ Nat.card V)
      (hXV : X ≤ centralizer (V : Set G)) : B.relIndex X ≤ 2 := by
    apply parrott_sylow_centralizer_relIndex_le_two z h d.localSylow X V
      (d.sylow_map ▸ hXT) hVE hV hXV
  have hindexFour : B.relIndex X ≤ 4 := by
    have hBT : B ≤ (d.sylow : Subgroup G) := by
      rw [d.sylow_map]
      exact map_mono (pCore_isPGroup.le_sylow_of_normal d.localSylow)
    have hBcard : Nat.card B = 512 :=
      (card_map_of_injective H.subtype_injective).trans h.core_card
    have hc := relIndex_mul_relIndex (⊥ : Subgroup G) B
      (d.sylow : Subgroup G) bot_le hBT
    rw [relIndex_bot_left, relIndex_bot_left, hBcard, d.sylow_card h] at hc
    have hBTindex : B.relIndex (d.sylow : Subgroup G) = 4 := by omega
    exact (relIndex_le_of_le_right hXT
      (show B.relIndex (d.sylow : Subgroup G) ≠ 0 from by rw [hBTindex]; decide)).trans_eq hBTindex
  by_cases hZE : Z ≤ E
  · have hcount := parrott_core_subgroup_centralizer_card z h Z
      (zpowers_le.mpr hzZ) hZE
    have hbound (hZ : 8 ≤ Nat.card Z) :
        Nat.card X ≤ Nat.card ((centralizer (Z : Set G)).subgroupOf B) * 2 := by
      exact (card_le_centralizer_card_mul_relIndex X B (Z : Set G) hXZ).trans
        (Nat.mul_le_mul_left _ (hindex Z hZE hZ hXZ))
    constructor
    · intro hZ
      have hb := hbound (by omega)
      change Nat.card Z * Nat.card ((centralizer (Z : Set G)).subgroupOf B) = 1024 at hcount
      nlinarith
    · intro hZ
      have hb := hbound hZ
      change Nat.card Z * Nat.card ((centralizer (Z : Set G)).subgroupOf B) = 1024 at hcount
      nlinarith
  · obtain ⟨b, hbZ, hbE⟩ := SetLike.not_le_iff_exists.mp hZE
    have hcentral : X ≤ centralizer ({b} : Set G) := by
      intro x hx
      exact mem_centralizer_singleton_iff.mpr ((hXZ hx b hbZ).symm)
    have hbB : b ∈ B := d.le_core (hZF hbZ)
    have hsmall := parrott_core_element_centralizer_card_le_sixty_four z h b hbB hbE
    change Nat.card ((centralizer ({b} : Set G)).subgroupOf B) ≤ 64 at hsmall
    have hbound (n : ℕ) (hi : B.relIndex X ≤ n) : Nat.card X ≤ 64 * n :=
      (card_le_centralizer_card_mul_relIndex X B ({b} : Set G) hcentral).trans
        (Nat.mul_le_mul hsmall hi)
    have hZU : Nat.card Z ≤ Nat.card U * 2 := by
      have hFindex : E.relIndex d.F = 2 := by
        have hc := relIndex_mul_relIndex (⊥ : Subgroup G) (E ⊓ d.F) d.F
          bot_le inf_le_right
        rw [relIndex_bot_left, relIndex_bot_left, inf_relIndex_right,
          d.inf_card, d.card] at hc
        omega
      have hi : E.relIndex Z ≤ 2 :=
        (relIndex_le_of_le_right hZF
          (show E.relIndex d.F ≠ 0 from by rw [hFindex]; decide)).trans_eq hFindex
      have hc := relIndex_mul_relIndex (⊥ : Subgroup G) U Z bot_le inf_le_right
      rw [relIndex_bot_left, relIndex_bot_left, inf_relIndex_right] at hc
      rw [← hc]
      exact Nat.mul_le_mul_left _ hi
    constructor
    · intro hZ
      apply hbound 2
      exact hindex U inf_le_left (by omega)
        (hXZ.trans (centralizer_le (show (U : Set G) ⊆ Z from inf_le_right)))
    · intro _
      exact hbound 4 hindexFour

private theorem normalizer_core_center_bounds (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) :
    let N := normalizer (d.F : Set G)
    let K := pCore 2 N
    (Nat.card K = 256 → Nat.card (center K) ≤ 8) ∧
      (512 ≤ Nat.card K → Nat.card (center K) ≤ 4) := by
  intro N K
  let X := K.map N.subtype
  let Z := (center K).map (N.subtype.comp K.subtype)
  have hXcard : Nat.card X = Nat.card K := card_map_of_injective N.subtype_injective
  have hZcard : Nat.card Z = Nat.card (center K) :=
    card_map_of_injective (N.subtype_injective.comp K.subtype_injective)
  have hcentral : X ≤ centralizer (Z : Set G) := by
    rintro x ⟨xN, hxK, rfl⟩ c ⟨cK, hc, rfl⟩
    exact congrArg (N.subtype.comp K.subtype)
      (mem_center_iff.mp hc (⟨xN, hxK⟩ : K)).symm
  obtain ⟨h16, h8⟩ := d.centralizing_center_bounds h X Z
    d.normalizer_core_le_sylow d.normalizer_core_center_le
    d.z_mem_normalizer_core_center hcentral
  have hdiv : Nat.card Z ∣ 32 := d.card ▸ card_dvd_of_le d.normalizer_core_center_le
  have hcases := Nat.mem_divisors.mpr ⟨hdiv, by decide⟩
  rw [show (32 : ℕ).divisors = {1, 2, 4, 8, 16, 32} by decide] at hcases
  simp only [Finset.mem_insert, Finset.mem_singleton] at hcases
  rw [hXcard, hZcard] at h16 h8
  rw [hZcard] at hcases
  constructor
  · intro hK
    by_contra hn
    have hZ : 16 ≤ Nat.card (center K) := by omega
    have := h16 hZ
    omega
  · intro hK
    by_contra hn
    have hZ : 8 ≤ Nat.card (center K) := by omega
    have := h8 hZ
    omega

/-- A normalizer two-core of order 256 has center of order at most eight. -/
public theorem normalizer_core_center_card_le_eight (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z)
    (hK : Nat.card (pCore 2 (normalizer (d.F : Set G))) = 256) :
    Nat.card (center (pCore 2 (normalizer (d.F : Set G)))) ≤ 8 :=
  (d.normalizer_core_center_bounds h).1 hK

/-- A normalizer two-core of order at least 512 has center of order at most four. -/
public theorem normalizer_core_center_card_le_four (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z)
    (hK : 512 ≤ Nat.card (pCore 2 (normalizer (d.F : Set G)))) :
    Nat.card (center (pCore 2 (normalizer (d.F : Set G)))) ≤ 4 :=
  (d.normalizer_core_center_bounds h).2 hK

end Stellmacher.Recognition.ParrottSecondElementaryData
