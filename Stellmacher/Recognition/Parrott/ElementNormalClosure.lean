module

public import Stellmacher.Recognition.Parrott.CentralizerStructure

/-!
# Normal generation by noncentral elements of Parrott's derived subgroup

Under the original centralizer hypotheses, put `H = C_G(z)` and
`J = O₂(H)`, and let `E` be the actual ambient image of `J'`. Every
`t ∈ H` whose ambient value lies in `E` outside `⟨z⟩` has `H`-normal
closure with ambient image exactly `E`. The original element and all
subgroup inclusions are retained; no simplicity or N2 hypothesis is used.

Let `L` be the normal closure inside `H`. Since `J'` is characteristic in
`J`, its image in `H` is normal and contains `L`. The restriction of `L`
to `J` is a nontrivial normal subgroup of a finite two-group, so it meets
`Z(J)` nontrivially. The center has order two, hence lies in this
restriction. Under the supplied Sylow five-action, the fixed subgroup of
`L` is exactly this center: the original fixed-point hypothesis gives
one containment, and its equality with the mapped center of `H` gives
the other. Orbit counting makes `|L|` congruent to two modulo five.

As `|L|` divides `|J'| = 32`, it is two or thirty-two. The first case
would make `L` equal the central subgroup generated by `z`, contrary to
the chosen element. Equality of subgroup orders then gives the result.

Source: David Parrott, *A characterization of the Tits' simple group*
(1972), Lemma 2, p. 673. This expands the normal-closure step used there
in the fusion argument, from the structural conclusions of Lemma 1.
-/

open Subgroup

namespace Stellmacher.Recognition

/-- Every element of the derived subgroup outside the central involution
normally generates that derived subgroup inside the involution centralizer. -/
public theorem parrott_element_normalClosure {G : Type*} [Group G] [Finite G]
    (z : G) (h : ParrottCentralizerHypotheses z) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let E := (commutator J).map (H.subtype.comp J.subtype)
    ∀ t : H, (t : G) ∈ E → (t : G) ∉ zpowers z →
      (Subgroup.normalClosure ({t} : Set H)).map H.subtype = E := by
  classical
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let D := commutator J
  let DH := D.map J.subtype
  let E := D.map (H.subtype.comp J.subtype)
  let ZH := (center J).map J.subtype
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  let : Fact (IsPGroup 2 J) := ⟨pCore_isPGroup⟩
  obtain ⟨hZmap, hHcenterMap, _, _, _, _, hDcard, _⟩ := parrott_centralizer_structure z h
  change Nat.card D = 32 at hDcard
  have hZcard : Nat.card (center J) = 2 := by
    have hc : Nat.card ((center J).map (H.subtype.comp J.subtype)) = Nat.card (center J) :=
      card_map_of_injective (H.subtype_injective.comp J.subtype_injective)
    rw [hZmap, Nat.card_zpowers, h.involution] at hc
    exact hc.symm
  have hZHcard : Nat.card ZH = 2 :=
    (card_map_of_injective (K := center J) J.subtype_injective).trans hZcard
  have hZHmap : ZH.map H.subtype = zpowers z := by
    simpa only [ZH, map_map] using hZmap
  have hZHcenter : ZH = center H := by
    apply Subgroup.map_injective (f := H.subtype) H.subtype_injective
    exact hZHmap.trans hHcenterMap.symm
  have hDHcard : Nat.card DH = 32 :=
    (card_map_of_injective (K := D) J.subtype_injective).trans hDcard
  let : DH.Characteristic := inferInstance
  change ∀ t : H, (t : G) ∈ E → (t : G) ∉ zpowers z →
    (Subgroup.normalClosure ({t} : Set H)).map H.subtype = E
  intro t ht htz
  have htDH : t ∈ DH := by
    obtain ⟨d, hd, hdt⟩ := ht
    exact ⟨d, hd, Subtype.ext hdt⟩
  have htne : t ≠ 1 := by
    intro heq
    apply htz
    simp [heq]
  let L := Subgroup.normalClosure ({t} : Set H)
  have htL : t ∈ L := Subgroup.subset_normalClosure (Set.mem_singleton t)
  have hLDH : L ≤ DH := Subgroup.normalClosure_le_normal
    (by intro x hx; obtain rfl := Set.mem_singleton_iff.mp hx; exact htDH)
  have hLJ : L ≤ J := hLDH.trans (map_subtype_le D)
  let LJ := L.subgroupOf J
  let tJ : J := ⟨t, hLJ htL⟩
  have hLJne : LJ ≠ ⊥ := by
    intro hbot
    have htLJ : tJ ∈ LJ := htL
    have htone : tJ = 1 := by simpa only [hbot, mem_bot] using htLJ
    exact htne (congrArg Subtype.val htone)
  let : Nontrivial LJ := (Subgroup.nontrivial_iff_ne_bot LJ).mpr hLJne
  obtain ⟨x, hxne, hxcenter⟩ := exists_nontrivial_center_mem_normal LJ (p := 2)
  have hIne : LJ ⊓ center J ≠ ⊥ := by
    intro hbot
    have hxI : (x : J) ∈ LJ ⊓ center J := ⟨x.property, hxcenter⟩
    have hxone : (x : J) = 1 := by simpa only [hbot, mem_bot] using hxI
    exact hxne (Subtype.ext hxone)
  have hIcard : 2 ≤ Nat.card (LJ ⊓ center J : Subgroup J) := by
    exact Finite.one_lt_card_iff_nontrivial.mpr
      ((Subgroup.nontrivial_iff_ne_bot _).mpr hIne)
  have hIeq : LJ ⊓ center J = center J :=
    eq_of_le_of_card_ge inf_le_right (by rw [hZcard]; exact hIcard)
  have hcenterLJ : center J ≤ LJ := by
    rw [← hIeq]
    exact inf_le_left
  have hZHL : ZH ≤ L := by
    rintro y ⟨j, hj, rfl⟩
    exact hcenterLJ hj
  obtain ⟨hHcard, _⟩ := h.card_and_solvable z
  change Nat.card H = 10240 at hHcard
  obtain ⟨P, hP⟩ := h.five_centralizer
  have hPcard : Nat.card P = 5 := by
    rw [P.card_eq_multiplicity, hHcard]
    decide +kernel
  let : MulDistribMulAction P L :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer (P : Subgroup H) L
      (Subgroup.le_normalizer_of_normal (H := L))
  have hfixed : FixedPoints.subgroup P L = ZH.subgroupOf L := by
    apply le_antisymm
    · intro y hy
      let yJ : J := ⟨y, hLJ y.property⟩
      have hycenter : yJ ∈ center J := by
        apply hP
        change (y : H) ∈ centralizer (P : Set H)
        intro a ha
        have hfix := congrArg (fun w : L => (w : H)) (hy ⟨a, ha⟩)
        change a * (y : H) * a⁻¹ = y at hfix
        exact mul_inv_eq_iff_eq_mul.mp hfix
      exact ⟨yJ, hycenter, rfl⟩
    · intro y hy
      have hycenter : (y : H) ∈ center H := hZHcenter ▸ hy
      intro a
      apply Subtype.ext
      change (a : H) * (y : H) * (a : H)⁻¹ = y
      rw [mem_center_iff.mp hycenter a]
      simp only [mul_assoc, mul_inv_cancel, mul_one]
  have hfixedcard : Nat.card (FixedPoints.subgroup P L) = 2 := by
    rw [hfixed]
    exact (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hZHL).toEquiv).trans hZHcard
  have hfive : IsPGroup 5 P := IsPGroup.of_card (p := 5) (n := 1) (by simpa using hPcard)
  have hmod := hfive.card_modEq_card_fixedPoints L
  change Nat.ModEq 5 (Nat.card L) (Nat.card (FixedPoints.subgroup P L)) at hmod
  rw [hfixedcard] at hmod
  have hLdiv : Nat.card L ∣ 2 ^ 5 := by
    have hdiv := card_dvd_of_le hLDH
    simpa only [hDHcard, show 2 ^ 5 = 32 by norm_num] using hdiv
  obtain ⟨n, hn, hLcard⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hLdiv
  have hLcases : Nat.card L = 2 ∨ Nat.card L = 32 := by
    rw [hLcard] at hmod ⊢
    interval_cases n <;> norm_num [Nat.ModEq] at *
  have hL32 : Nat.card L = 32 := by
    rcases hLcases with hLtwo | hL32
    · have hZeq : ZH = L := eq_of_le_of_card_ge hZHL (by rw [hZHcard, hLtwo])
      have htZH : t ∈ ZH := hZeq.symm ▸ htL
      have htmap : (t : G) ∈ ZH.map H.subtype := mem_map_of_mem H.subtype htZH
      rw [hZHmap] at htmap
      exact (htz htmap).elim
    · exact hL32
  have hLeq : L = DH := eq_of_le_of_card_ge hLDH (by rw [hL32, hDHcard])
  change L.map H.subtype = E
  rw [hLeq]
  simp only [DH, E, map_map]

end Stellmacher.Recognition
