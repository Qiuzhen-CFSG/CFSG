module

public import Theory.GroupAction.Order512FiveStructure
public import Theory.GroupAction.SubgroupConjugation
public import Theory.GroupTheory.PrimeSylowActionCore
public import Theory.GroupTheory.CenterTwoCoreSylowPromotion
public import Mathlib.GroupTheory.SemidirectProduct

/-!
# Parrott’s involution-centralizer structure

For an involution z of a finite group G, put H=C_G(z) and J=O₂(H).
The public hypothesis record states Parrott’s original conditions: J has
order 512 and nilpotency class at least 3; H/J is a faithful C₅⋊C₄ model;
and a Sylow 5 subgroup P of H has C_J(P) contained in Z(J). All subgroup
constructions are the actual centralizer, core, and Sylow subgroups.

`ParrottCentralizerHypotheses.card_and_solvable` exposes the derived order
and solvability of this actual centralizer for subsequent local arguments.

Conjugation gives the actual P-action on J. The model gives |H|=10240,
solvability of H, and |P|=5. The intrinsic order 512 action theorem then
gives class 3, center of order 2, and J′=Φ(J)=Z₂(J), elementary of order 32.
The original fixed-centralizer condition and the class hypothesis ensure
that P does not centralize J. The odd core of H must therefore be trivial:
an odd core of order 5 would equal P and commute with the normal two-core.
Solvable Fitting self-centralization now gives C_H(J)≤J.

Finally z belongs to the normal two-core and exhausts its order-two center.
Thus the actual ambient images of Z(J) and Z(H) are both ⟨z⟩. The center of
each Sylow 2 subgroup of H also centralizes J and is generated by z, so
its normalizer is contained in C_G(z). Sylow promotion identifies each
chosen local Sylow’s actual image with an ambient Sylow subgroup.

Source: D. Parrott, *A characterization of the Tits’ simple group*,
Canadian Journal of Mathematics 24 (1972), Lemma 1, printed p.672. This
module proves that first lemma from the original centralizer hypotheses;
the global Tits recognition argument is a subsequent step.
-/

open Subgroup
namespace Stellmacher.Recognition

/-- The original centralizer hypotheses in Parrott’s 1972 characterization. -/
public structure ParrottCentralizerHypotheses {G : Type*} [Group G] (z : G) : Prop where
  involution : orderOf z = 2
  core_card : Nat.card (pCore 2 (centralizer ({z} : Set G))) = 512
  core_class : 3 ≤ Group.nilpotencyClass (pCore 2 (centralizer ({z} : Set G)))
  quotient_model :
    ∃ φ : Multiplicative (ZMod 4) →* MulAut (Multiplicative (ZMod 5)),
      Function.Injective φ ∧
      Nonempty ((centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))) ≃*
        SemidirectProduct (Multiplicative (ZMod 5)) (Multiplicative (ZMod 4)) φ)
  five_centralizer :
    ∃ P : Sylow 5 (centralizer ({z} : Set G)),
      (centralizer (P : Set (centralizer ({z} : Set G)))).subgroupOf
        (pCore 2 (centralizer ({z} : Set G))) ≤
          center (pCore 2 (centralizer ({z} : Set G)))

/-- The original core order and quotient model determine the order and
solvability of the actual involution centralizer. -/
public theorem ParrottCentralizerHypotheses.card_and_solvable {G : Type*} [Group G] [Finite G]
    (z : G) (h : ParrottCentralizerHypotheses z) :
    Nat.card (centralizer ({z} : Set G)) = 10240 ∧
      Group.IsSolvable (centralizer ({z} : Set G)) := by
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  obtain ⟨φ, _, ⟨e⟩⟩ := h.quotient_model
  let M := SemidirectProduct (Multiplicative (ZMod 5)) (Multiplicative (ZMod 4)) φ
  have hMcard : Nat.card M = 20 := by
    rw [SemidirectProduct.card]
    norm_num
  have hquot : Nat.card (H ⧸ J) = 20 := (Nat.card_congr e.toEquiv).trans hMcard
  have hH : Nat.card H = 10240 := by
    have hc := J.index_mul_card
    change Nat.card (H ⧸ J) * Nat.card J = Nat.card H at hc
    rw [hquot, h.core_card] at hc
    omega
  have hMsolv : Group.IsSolvable M := by
    apply Group.isSolvable_of_ker_le_range
      (SemidirectProduct.inl : Multiplicative (ZMod 5) →* M)
      (SemidirectProduct.rightHom : M →* Multiplicative (ZMod 4))
    exact SemidirectProduct.range_inl_eq_ker_rightHom.symm.le
  let : Group.IsSolvable M := hMsolv
  let : Group.IsSolvable (H ⧸ J) := Group.isSolvable_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective
  let : Group.IsNilpotent J := pCore_isPGroup.isNilpotent
  exact ⟨hH, (Group.isSolvable_iff_subgroup_quotient J).mpr ⟨inferInstance, inferInstance⟩⟩

private theorem five_sylow_card {H : Type*} [Group H] [Finite H]
    (hH : Nat.card H = 10240) (P : Sylow 5 H) : Nat.card P = 5 := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  rw [Sylow.card_eq_multiplicity, hH, show 10240 = 2 ^ 11 * 5 by decide,
    Nat.factorization_mul (by decide) (by decide), Nat.factorization_pow]
  norm_num [Nat.prime_two.factorization, (show Nat.Prime 5 by decide).factorization]


private theorem intrinsic_core_structure {G : Type*} [Group G] [Finite G]
    (z : G) (h : ParrottCentralizerHypotheses z) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    Group.nilpotencyClass J = 3 ∧ Nat.card (center J) = 2 ∧
      commutator J = frattini J ∧ commutator J = Subgroup.upperCentralSeries J 2 ∧
      IsElementaryAbelian 2 (commutator J) ∧ Nat.card (commutator J) = 32 := by
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  obtain ⟨P, hP⟩ := h.five_centralizer
  let : MulDistribMulAction P J :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer (P : Subgroup H) J
      (Subgroup.le_normalizer_of_normal (H := J))
  have hfixed : FixedPoints.subgroup P J ≤ center J := by
    intro x hx
    apply hP
    change (x : H) ∈ centralizer (P : Set H)
    rw [mem_centralizer_iff]
    intro a ha
    have hfix := congrArg (fun y : J => (y : H)) (hx ⟨a, ha⟩)
    change a * (x : H) * a⁻¹ = x at hfix
    exact mul_inv_eq_iff_eq_mul.mp hfix
  exact Theory.GroupAction.parrott_twoGroup_structure pCore_isPGroup h.core_card
    h.core_class (five_sylow_card (ParrottCentralizerHypotheses.card_and_solvable z h).1 P) hfixed

private theorem core_not_centralized_by_five {G : Type*} [Group G] [Finite G]
    (z : G) (h : ParrottCentralizerHypotheses z)
    (P : Sylow 5 (centralizer ({z} : Set G)))
    (hP : (centralizer (P : Set (centralizer ({z} : Set G)))).subgroupOf
      (pCore 2 (centralizer ({z} : Set G))) ≤ center (pCore 2 (centralizer ({z} : Set G)))) :
    ¬ pCore 2 (centralizer ({z} : Set G)) ≤ centralizer (P : Set (centralizer ({z} : Set G))) := by
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : Group.IsNilpotent J := pCore_isPGroup.isNilpotent
  intro hle
  have hcenter : center J = ⊤ := by
    apply top_unique
    intro x _
    apply hP
    exact hle x.property
  have hclass : Group.nilpotencyClass J ≤ 1 :=
    Group.IsNilpotent.nilpotencyClass_le_one_iff.mpr (Subgroup.center_eq_top_iff.mp hcenter)
  have hlarge := h.core_class
  change 3 ≤ Group.nilpotencyClass J at hlarge
  omega


/-- The actual centralizer and Sylow conclusions of Parrott’s first lemma. -/
public theorem parrott_centralizer_structure {G : Type*} [Group G] [Finite G]
    (z : G) (h : ParrottCentralizerHypotheses z) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    (center J).map (H.subtype.comp J.subtype) = zpowers z ∧
      (center H).map H.subtype = zpowers z ∧
      Group.nilpotencyClass J = 3 ∧ commutator J = frattini J ∧
      commutator J = Subgroup.upperCentralSeries J 2 ∧
      IsElementaryAbelian 2 (commutator J) ∧ Nat.card (commutator J) = 32 ∧
      ∀ T : Sylow 2 H, ∃ S : Sylow 2 G,
        (S : Subgroup G) = (T : Subgroup H).map H.subtype := by
  obtain ⟨hclass, hcenter, hPhi, hupper, helem, hDcard⟩ := intrinsic_core_structure z h
  obtain ⟨P, hP⟩ := h.five_centralizer
  obtain ⟨hHcard, hHsolv⟩ := ParrottCentralizerHypotheses.card_and_solvable z h
  have hself := Subgroup.centralizer_pCore_le_of_prime_sylow_action hHsolv hHcard P
    (core_not_centralized_by_five z h P hP)
  obtain ⟨hZJ, hZH, hSylow⟩ :=
    Subgroup.centralizer_structure_of_center_two_core z h.involution hcenter hself
  exact ⟨hZJ, hZH, hclass, hPhi, hupper, helem, hDcard, hSylow⟩

end Stellmacher.Recognition
