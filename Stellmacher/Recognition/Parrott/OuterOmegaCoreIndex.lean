module

public import Stellmacher.Recognition.Parrott.OuterFusionReduction
public import Theory.GroupTheory.PGroup.OmegaCyclicImage

/-!
# The core intersection of the actual outer omega

Retain the supplied Sylow T and let X be the ambient image of Ω₁(C_T(y)),
where y is an involution outside the two-core J of H=C_G(z). The intersection
of X with the mapped core has index two in X. Indeed the image of C_H(y)
in the faithful C₅⋊C₄ quotient lies in a cyclic centralizer. Its omega image
is generated by the nontrivial image of y. The already established equality
of the centralizers in H and T transports this calculation to the supplied T.

The elementary fixed join of order sixteen embeds in X independently of
core weak closure. In particular, sixteen divides the order of X.
For an order-thirty-two X with half-sized core intersection, a Sylow-normalizer
orbit outside the core has two-power order at most sixteen. Thus a lower bound
of eight gives precisely the two suborbit sizes used in the fusion reduction.

Source: Parrott, *A characterization of the Tits' simple group* (1972),
pp.674–675 and the first paragraph of p.676.
-/

open Subgroup MulAction

namespace Stellmacher.Recognition

private theorem outer_omega_core_index_local
    {G : Type*} [Group G] [Finite G] {z : G}
    (h : ParrottCentralizerHypotheses z)
    (y : centralizer ({z} : Set G)) (hy : orderOf y = 2)
    (hyJ : y ∉ pCore 2 (centralizer ({z} : Set G))) :
    let H := centralizer ({z} : Set G)
    let P := centralizer ({y} : Set H)
    let X := (omega₁ P (p := 2)).map (H.subtype.comp P.subtype)
    ((pCore 2 H).map H.subtype).relIndex X = 2 := by
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let P := centralizer ({y} : Set H)
  change y ∉ J at hyJ
  let embed := H.subtype.comp P.subtype
  obtain ⟨φ, hφ, ⟨e⟩⟩ := h.quotient_model
  let M := Multiplicative (ZMod 5) ⋊[φ] Multiplicative (ZMod 4)
  let : Finite M := Finite.of_equiv (Multiplicative (ZMod 5) × Multiplicative (ZMod 4))
    SemidirectProduct.equivProd.symm
  let f := e.toMonoidHom.comp (QuotientGroup.mk' J)
  have hker : f.ker = J := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective, QuotientGroup.ker_mk']
  have hy2 : y ^ 2 = 1 := hy ▸ pow_orderOf_eq_one y
  have hfy : orderOf (f y) = 2 := by
    apply orderOf_eq_prime
    · rw [← map_pow, hy2, map_one]
    · intro heq
      exact hyJ (hker ▸ (show y ∈ f.ker from heq))
  let C := centralizer ({f y} : Set M)
  let : IsCyclic C := (faithful_five_four_involution_centralizer φ hφ (f y) hfy).1
  let π : P →* C := (f.comp P.subtype).codRestrict C (by
    intro a
    apply mem_centralizer_singleton_iff.mpr
    change f (a : H) * f y = f y * f (a : H)
    simpa only [map_mul] using congrArg f (mem_centralizer_singleton_iff.mp a.property))
  let yP : P := ⟨y, mem_centralizer_singleton_iff.mpr rfl⟩
  have hyπ : orderOf (π yP) = 2 := (Subgroup.orderOf_coe (π yP)).symm.trans hfy
  have hπ := π.map_omega₁_eq_zpowers_of_isCyclic yP (Subtype.ext hy2) hyπ
  have hcomap : (J.map H.subtype).comap embed = π.ker := by
    ext a
    change (embed a ∈ J.map H.subtype) ↔ π a = 1
    constructor
    · rintro ⟨b, hb, hba⟩
      have hba' : b = (a : H) := H.subtype_injective hba
      have hfa : (a : H) ∈ f.ker := hker.symm ▸ (hba' ▸ hb)
      exact Subtype.ext hfa
    · intro ha
      have hfa : f (a : H) = 1 := congrArg Subtype.val ha
      exact mem_map_of_mem H.subtype (hker ▸ (show (a : H) ∈ f.ker from hfa))
  change (J.map H.subtype).relIndex ((omega₁ P (p := 2)).map embed) = 2
  rw [← relIndex_comap, hcomap, relIndex_ker, hπ, Nat.card_zpowers, hyπ]

namespace ParrottSecondElementaryData

/-- The original elementary fixed join of order sixteen lies in the actual omega. -/
public theorem outer_omega_fixed_join
    {G : Type*} [Group G] [Finite G] {z : G}
    (d : ParrottSecondElementaryData z) (h : ParrottCentralizerHypotheses z)
    (y : G) (hyT : y ∈ (d.sylow : Subgroup G))
    (hyJ : y ∉ (pCore 2 (centralizer ({z} : Set G))).map
      (centralizer ({z} : Set G)).subtype)
    (hy : orderOf y = 2) :
    let H := centralizer ({z} : Set G)
    let E := (commutator (pCore 2 H)).map (H.subtype.comp (pCore 2 H).subtype)
    let T : Subgroup G := d.sylow
    let yT : T := ⟨y, hyT⟩
    let Q := centralizer ({yT} : Set T)
    let X := (omega₁ Q (p := 2)).map (T.subtype.comp Q.subtype)
    let X₀ := zpowers y ⊔ (E ⊓ centralizer ({y} : Set G))
    IsElementaryAbelian 2 X₀ ∧ Nat.card X₀ = 16 ∧ X₀ ≤ X := by
  let H := centralizer ({z} : Set G)
  let yH : H := ⟨y, d.sylow_le_centralizer hyT⟩
  have hyH : orderOf yH = 2 := (Subgroup.orderOf_coe yH).symm.trans hy
  have hyHJ : yH ∉ pCore 2 H := fun hh => hyJ (mem_map_of_mem H.subtype hh)
  have hh := parrott_outer_fixed_join_data z h yH hyH hyHJ
  dsimp only at hh
  rw [d.outer_centralizer_omega_eq h y hyT hyJ hy] at hh
  exact hh

/-- Sixteen divides the order of the actual omega, independently of core fusion. -/
public theorem sixteen_dvd_outer_omega_card
    {G : Type*} [Group G] [Finite G] {z : G}
    (d : ParrottSecondElementaryData z) (h : ParrottCentralizerHypotheses z)
    (y : G) (hyT : y ∈ (d.sylow : Subgroup G))
    (hyJ : y ∉ (pCore 2 (centralizer ({z} : Set G))).map
      (centralizer ({z} : Set G)).subtype)
    (hy : orderOf y = 2) :
    let T : Subgroup G := d.sylow
    let yT : T := ⟨y, hyT⟩
    let Q := centralizer ({yT} : Set T)
    let X := (omega₁ Q (p := 2)).map (T.subtype.comp Q.subtype)
    16 ∣ Nat.card X := by
  obtain ⟨_, hc, hle⟩ := d.outer_omega_fixed_join h y hyT hyJ hy
  simpa only [hc] using card_dvd_of_le hle

/-- The core intersection has index two in the actual omega in the supplied Sylow. -/
public theorem outer_omega_core_index
    {G : Type*} [Group G] [Finite G] {z : G}
    (d : ParrottSecondElementaryData z) (h : ParrottCentralizerHypotheses z)
    (y : G) (hyT : y ∈ (d.sylow : Subgroup G))
    (hyJ : y ∉ (pCore 2 (centralizer ({z} : Set G))).map
      (centralizer ({z} : Set G)).subtype)
    (hy : orderOf y = 2) :
    let H := centralizer ({z} : Set G)
    let T : Subgroup G := d.sylow
    let yT : T := ⟨y, hyT⟩
    let Q := centralizer ({yT} : Set T)
    let X := (omega₁ Q (p := 2)).map (T.subtype.comp Q.subtype)
    (((pCore 2 H).map H.subtype).subgroupOf X).index = 2 := by
  let H := centralizer ({z} : Set G)
  let yH : H := ⟨y, d.sylow_le_centralizer hyT⟩
  have hyH : orderOf yH = 2 := (Subgroup.orderOf_coe yH).symm.trans hy
  have hyHJ : yH ∉ pCore 2 H := fun hh => hyJ (mem_map_of_mem H.subtype hh)
  have hh := outer_omega_core_index_local h yH hyH hyHJ
  dsimp only at hh
  rw [d.outer_centralizer_omega_eq h y hyT hyJ hy] at hh
  exact hh

/-- In the order-thirty-two case the actual core intersection has order sixteen. -/
public theorem outer_omega_core_card_of_card_thirtyTwo
    {G : Type*} [Group G] [Finite G] {z : G}
    (d : ParrottSecondElementaryData z) (h : ParrottCentralizerHypotheses z)
    (y : G) (hyT : y ∈ (d.sylow : Subgroup G))
    (hyJ : y ∉ (pCore 2 (centralizer ({z} : Set G))).map
      (centralizer ({z} : Set G)).subtype)
    (hy : orderOf y = 2) :
    let H := centralizer ({z} : Set G)
    let T : Subgroup G := d.sylow
    let yT : T := ⟨y, hyT⟩
    let Q := centralizer ({yT} : Set T)
    let X := (omega₁ Q (p := 2)).map (T.subtype.comp Q.subtype)
    let U := ((pCore 2 H).map H.subtype).subgroupOf X
    Nat.card X = 32 → Nat.card U = 16 := by
  let H := centralizer ({z} : Set G)
  let T : Subgroup G := d.sylow
  let yT : T := ⟨y, hyT⟩
  let Q := centralizer ({yT} : Set T)
  let X := (omega₁ Q (p := 2)).map (T.subtype.comp Q.subtype)
  let U := ((pCore 2 H).map H.subtype).subgroupOf X
  change Nat.card X = 32 → Nat.card U = 16
  intro hc
  have hi : U.index = 2 := d.outer_omega_core_index h y hyT hyJ hy
  have hm := U.index_mul_card
  rw [hi, hc] at hm
  omega

/-- For the actual Sylow-normalizer action, a lower bound of eight suffices:
an outer orbit stays outside the half-sized core intersection and has two-power order. -/
public theorem outer_suborbit_eq_eight_or_sixteen_of_eight_le
    {G : Type*} [Group G] [Finite G] {z : G}
    (d : ParrottSecondElementaryData z) (X : Subgroup G)
    (hX : Nat.card X = 32)
    (hU : Nat.card (((pCore 2 (centralizer ({z} : Set G))).map
      (centralizer ({z} : Set G)).subtype).subgroupOf X) = 16) :
    let N := normalizer (X : Set G)
    let U := ((pCore 2 (centralizer ({z} : Set G))).map
      (centralizer ({z} : Set G)).subtype).subgroupOf X
    let A := (d.sylow : Subgroup G).subgroupOf N
    ∀ x : X, x ∉ U → 8 ≤ Nat.card (orbit A x) →
      Nat.card (orbit A x) = 8 ∨ Nat.card (orbit A x) = 16 := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let K := J.map H.subtype
  let T : Subgroup G := d.sylow
  let N := normalizer (X : Set G)
  let U := K.subgroupOf X
  let A := T.subgroupOf N
  change ∀ x : X, x ∉ U → 8 ≤ Nat.card (orbit A x) →
    Nat.card (orbit A x) = 8 ∨ Nat.card (orbit A x) = 16
  intro x hxU hlower
  have hHK : H ≤ normalizer (K : Set G) := by
    intro a ha
    apply le_normalizer_map H.subtype
    exact mem_map_of_mem H.subtype (show (⟨a, ha⟩ : H) ∈ normalizer (J : Set H) by
      rw [normalizer_eq_top]; trivial)
  have hout : orbit A x ⊆ (U : Set X)ᶜ := by
    rintro _ ⟨a, rfl⟩ hh
    apply hxU
    have haK := hHK (d.sylow_le_centralizer a.property)
    exact (mem_normalizer_iff.mp haK (x : G)).mpr hh
  have hupper : Nat.card (orbit A x) ≤ 16 := by
    have hh := Set.ncard_le_ncard hout
    rw [Set.ncard_compl, show (U : Set X).ncard = 16 from hU, hX] at hh
    exact hh
  let f : A →* T := (N.subtype.comp A.subtype).codRestrict T (fun a => a.property)
  have hf : Function.Injective f := by
    intro a b hab
    exact Subtype.ext (Subtype.ext (congrArg (fun t : T => (t : G)) hab))
  have hAp : IsPGroup 2 A := d.sylow.isPGroup'.of_injective f hf
  obtain ⟨n, hn⟩ := hAp.card_orbit x
  have hnle : n ≤ 4 := (pow_le_pow_iff_right₀ (by decide : 1 < (2 : ℕ))).mp
    (by simpa only [hn, show (2 : ℕ) ^ 4 = 16 from rfl] using hupper)
  interval_cases n <;> simp_all

end ParrottSecondElementaryData
end Stellmacher.Recognition
