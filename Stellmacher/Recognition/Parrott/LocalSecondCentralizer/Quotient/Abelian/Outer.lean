module
public import Stellmacher.Recognition.Parrott.LocalSecondCentralizer.Quotient.Abelian.Descent
public import Stellmacher.Recognition.Parrott.LocalSecondCentralizer.Quotient.Sylow

/-!
# Outside quotient points from the elementary-point calculation

Suppose C_Y(f)≤F for every f in F outside Z(Y). For an outside lift k,
its pair normalizer P meets F inside Z(Y): a putative noncentral point
f in P∩F would commute with k, since its displacement lies both in Z(K)
and in ⟨v⟩. The elementary-point bound would then put k in F.

Now |P∩F|≤8 and |Y:F|=4 give |P|≤32. The literal quotient centralizer
has half that order. It contains a central subgroup of order eight,
generated by the central four-group and the specified quotient involution.
Its center therefore has index at most two, forcing it to be abelian.
This proves the whole outside case without the stronger source equality
P=⟨k⟩Z(Y). The final theorem retains just the elementary-point premise.

Source: Parrott (1972), Lemma 8, printed p.683, observation (ii).
-/

open Subgroup
open scoped commutatorElement
namespace Stellmacher.Recognition.ParrottSecondTransferData
variable {G : Type*} [Group G] [Finite G] {z : G}
  {d : ParrottSecondElementaryData z} {n : ParrottNormalizerFusionData d}
  (t : ParrottSecondTransferData n)

private theorem commute_of_quotient_commute_elementary
    (h : ParrottCentralizerHypotheses z) (hlocal : ParrottLocalInputs z)
    {a b : t.L} (ha : a ∈ (t.S : Subgroup t.L)) (hb : t.embedding b ∈ d.F)
    (hab : Commute (QuotientGroup.mk' (zpowers t.v) a)
      (QuotientGroup.mk' (zpowers t.v) b)) :
    Commute (t.embedding a) (t.embedding b) := by
  classical
  have hcV : ⁅t.embedding a, t.embedding b⁆ ∈ zpowers n.v := by
    have hc : ⁅a, b⁆ ∈ zpowers t.v := by
      apply (QuotientGroup.eq_one_iff _).mp
      change QuotientGroup.mk' (zpowers t.v) ⁅a, b⁆ = 1
      rw [map_commutatorElement]
      exact commutatorElement_eq_one_iff_mul_comm.mpr hab.eq
    simpa only [MonoidHom.map_zpowers, t.v_image, map_commutatorElement] using
      (mem_map_of_mem t.embedding hc)
  have hcZ := n.omega_elementary_commutator_le_coreCenter h hlocal
    (commutator_mem_commutator (t.sylow_image_le_omega (mem_map_of_mem t.embedding ha)) hb)
  apply commutatorElement_eq_one_iff_mul_comm.mp
  rw [mem_zpowers_iff_mem_range_orderOf, n.v_order] at hcV
  obtain ⟨j, hj, he⟩ := Finset.mem_image.mp hcV
  have hj2 : j < 2 := Finset.mem_range.mp hj
  interval_cases j
  · simpa only [pow_zero] using he.symm
  · have he' : ⁅t.embedding a, t.embedding b⁆ = n.v := by
      simpa only [pow_one] using he.symm
    exact (n.v_not_mem_core_center (he' ▸ hcZ)).elim

/-- The elementary intersection of an outside pair normalizer is central.
Only the ordinary elementary-point centralizer calculation is needed. -/
public theorem outer_pairNormalizer_inf_elementary_le_center
    (h : ParrottCentralizerHypotheses z) (hlocal : ParrottLocalInputs z)
    (helementary : ∀ k ∈ d.F, k ∉ t.sylowCenter →
      t.sylowImage ⊓ centralizer ({k} : Set G) ≤ d.F)
    {a : t.L} (ha : a ∈ (t.S : Subgroup t.L))
    (haF : t.embedding a ∉ d.F)
    (ha2 : orderOf (QuotientGroup.mk' (zpowers t.v) a) = 2) :
    t.pairNormalizer (t.embedding a) ⊓ d.F ≤ t.sylowCenter := by
  intro f hf
  by_contra hfZ
  have hfp : f ∈ ((t.quotientLocalCentralizer
      (QuotientGroup.mk' (zpowers t.v) a)).comap
      (QuotientGroup.mk' (zpowers t.v))).map t.embedding :=
    (t.localCentralizer_preimage_map ha2).symm ▸ hf.1
  obtain ⟨b, hb, rfl⟩ := hfp
  have hab : Commute (QuotientGroup.mk' (zpowers t.v) a)
      (QuotientGroup.mk' (zpowers t.v) b) :=
    (mem_centralizer_singleton_iff.mp hb.2).symm
  have habG := t.commute_of_quotient_commute_elementary h hlocal ha hf.2 hab
  exact haF (helementary _ hf.2 hfZ
    ⟨mem_map_of_mem t.embedding ha, mem_centralizer_singleton_iff.mpr habG.eq⟩)

/-- The outside pair normalizer has order at most 32, without a stronger
identification of its elements. Its intersection with F has order at most 8,
and F has index four in Y. -/
public theorem outer_pairNormalizer_card_le
    (h : ParrottCentralizerHypotheses z) (hlocal : ParrottLocalInputs z)
    (helementary : ∀ k ∈ d.F, k ∉ t.sylowCenter →
      t.sylowImage ⊓ centralizer ({k} : Set G) ≤ d.F)
    {a : t.L} (ha : a ∈ (t.S : Subgroup t.L))
    (haF : t.embedding a ∉ d.F)
    (ha2 : orderOf (QuotientGroup.mk' (zpowers t.v) a) = 2) :
    Nat.card (t.pairNormalizer (t.embedding a)) ≤ 32 := by
  let P := t.pairNormalizer (t.embedding a)
  have hPF : P ≤ normalizer (d.F : Set G) :=
    inf_le_left.trans (t.sylow_image_le_omega.trans
      (n.omega_le_core.trans (map_subtype_le _)))
  have hprod := card_mul_eq_card_inf_mul_card_sup_of_normalizes d.F P hPF
  have hi : Nat.card (d.F ⊓ P : Subgroup G) ≤ 8 := by
    rw [inf_comm]
    exact (card_le_of_le
      (t.outer_pairNormalizer_inf_elementary_le_center h hlocal helementary ha haF ha2)).trans_eq
        t.sylowCenter_card
  have hs : Nat.card (d.F ⊔ P : Subgroup G) ≤ 128 :=
    (card_le_of_le (sup_le t.elementary_le_sylow_image inf_le_left)).trans_eq t.sylowImage_card
  rw [d.card] at hprod
  have hm := Nat.mul_le_mul hi hs
  nlinarith

/-- The literal pair normalizer is twice as large as its local quotient
centralizer; its kernel is precisely the prescribed involution line. -/
public theorem two_mul_localCentralizer_card_eq_pairNormalizer_card
    {a : t.L} (ha2 : orderOf (QuotientGroup.mk' (zpowers t.v) a) = 2) :
    2 * Nat.card (t.quotientLocalCentralizer (QuotientGroup.mk' (zpowers t.v) a)) =
      Nat.card (t.pairNormalizer (t.embedding a)) := by
  let q := QuotientGroup.mk' (zpowers t.v)
  let D := t.quotientLocalCentralizer (q a)
  let C := D.comap q
  have hker : q.ker ≤ C := D.ker_le_comap q
  have hcard : Nat.card q.ker = 2 := by
    rw [QuotientGroup.ker_mk', Nat.card_zpowers,
      ← orderOf_injective t.embedding t.embedding_injective, t.v_image, n.v_order]
  have hc := relIndex_mul_relIndex (⊥ : Subgroup t.L) q.ker C bot_le hker
  rw [relIndex_bot_left, relIndex_bot_left, relIndex_ker, hcard] at hc
  have hmap : C.map q = D := map_comap_eq_self (by
    intro x _
    exact QuotientGroup.mk'_surjective (zpowers t.v) x)
  rw [hmap] at hc
  have hCcard : Nat.card C = Nat.card (t.pairNormalizer (t.embedding a)) := by
    rw [← card_map_of_injective (K := C) t.embedding_injective,
      t.localCentralizer_preimage_map ha2]
  exact hc.trans hCcard

/-- A local quotient involution centralizer of order at most 16 is abelian:
the central four-group and the given involution generate a central eight. -/
public theorem quotientLocalCentralizer_abelian_of_card_le_sixteen
    {x : t.Quotient} (hx : x ∈ t.quotientSylow) (hx2 : orderOf x = 2)
    (hxE : x ∉ t.quotientCoreCenter) (hcard : Nat.card (t.quotientLocalCentralizer x) ≤ 16) :
    IsMulCommutative (t.quotientLocalCentralizer x) := by
  let D := t.quotientLocalCentralizer x
  let E := t.quotientCoreCenter
  let B := E ⊔ zpowers x
  have hEC : E ≤ centralizer (D : Set t.Quotient) :=
    t.quotientCoreCenter_le_centralizer.trans (centralizer_le inf_le_left)
  have hxC : x ∈ centralizer (D : Set t.Quotient) := by
    intro a ha
    exact mem_centralizer_singleton_iff.mp ha.2
  have hBC : B ≤ centralizer (D : Set t.Quotient) := sup_le hEC (zpowers_le.mpr hxC)
  have hBD : B ≤ D := sup_le (t.quotientCoreCenter_le_localCentralizer hx)
    (zpowers_le.mpr ⟨hx, mem_centralizer_singleton_iff.mpr rfl⟩)
  have hxN : x ∈ normalizer (E : Set t.Quotient) :=
    Subgroup.centralizer_le_normalizer _ (centralizer_le
      (t.quotientCoreCenter_le_localCentralizer hx) hxC)
  have hBcard : Nat.card B = 8 := by
    rw [show B = E ⊔ zpowers x from rfl,
      card_sup_zpowers_of_normalizing_involution E x
        (hx2 ▸ pow_orderOf_eq_one x) hxE hxN,
      show Nat.card E = 4 from t.quotientCoreCenter_card]
  have hcenter : 8 ≤ Nat.card (center D) := by
    have hle : B.subgroupOf D ≤ center D := by
      intro b hb
      apply mem_center_iff.mpr
      intro a
      exact Subtype.ext (hBC hb a a.property)
    have hc := card_le_of_le hle
    rwa [Nat.card_congr (subgroupOfEquivOfLe hBD).toEquiv, hBcard] at hc
  have hidx : (center D).index ≤ 2 := by
    have hh := (center D).card_mul_index
    change Nat.card D ≤ 16 at hcard
    nlinarith
  have hpos : (center D).index ≠ 0 := index_ne_zero_of_finite
  have hcases : (center D).index = 1 ∨ (center D).index = 2 := by omega
  rcases hcases with h1 | h2
  · exact center_eq_top_iff.mp (index_eq_one.mp h1)
  · let : IsCyclic (D ⧸ center D) := isCyclic_of_prime_card h2
    exact isMulCommutative_of_isCyclic_quotient_center_self D

/-- The complete small-abelian calculation reduces to the ordinary
centralizers of points in F−Z(Y); no outside pair-normalizer premise remains. -/
public theorem quotientLocalCentralizer_small_of_elementary_centralizers
    (h : ParrottCentralizerHypotheses z) (hlocal : ParrottLocalInputs z)
    (helementary : ∀ k ∈ d.F, k ∉ t.sylowCenter →
      t.sylowImage ⊓ centralizer ({k} : Set G) ≤ d.F) :
    ∀ x ∈ t.quotientSylow, orderOf x = 2 → x ∉ t.quotientCoreCenter →
      IsMulCommutative (t.quotientLocalCentralizer x) ∧
        Nat.card (t.quotientLocalCentralizer x) ≤ 16 := by
  intro x hx hx2 hxE
  obtain ⟨a, ha, rfl⟩ := hx
  by_cases haF : t.embedding a ∈ d.F
  · let : IsElementaryAbelian 2 d.F := d.elementary
    apply t.quotientLocalCentralizer_small_of_pairNormalizer_le hx2 d.F n.v_mem_inf.2
      (by rw [d.card])
    rw [t.pairNormalizer_eq_sylow_centralizer_of_mem_elementary h hlocal haF
      (t.lift_not_mem_sylowCenter hxE)]
    exact helementary _ haF (t.lift_not_mem_sylowCenter hxE)
  · have hpair := t.outer_pairNormalizer_card_le h hlocal helementary ha haF hx2
    have hcount := t.two_mul_localCentralizer_card_eq_pairNormalizer_card hx2
    have hcard : Nat.card (t.quotientLocalCentralizer
        (QuotientGroup.mk' (zpowers t.v) a)) ≤ 16 := by omega
    exact ⟨t.quotientLocalCentralizer_abelian_of_card_le_sixteen
      (mem_map_of_mem _ ha) hx2 hxE hcard, hcard⟩

end Stellmacher.Recognition.ParrottSecondTransferData
