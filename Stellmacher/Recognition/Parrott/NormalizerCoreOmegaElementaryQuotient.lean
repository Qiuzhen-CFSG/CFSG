module

public import Stellmacher.Recognition.Parrott.NormalizerInvolutionCosets
public import Theory.GroupTheory.SmallTwoGroupCubicClassification

/-!
# The elementary quotient of the second core's omega subgroup

Write W for the ambient image of Ω₁(O₂(N_G(F))). Every square in W
belongs to F, so W/F is elementary abelian of order eight.

An involution outside E∨F is moved into E∨F by the supplied cubic group.
Thus the induced action on W/F contains a nonidentity cubic automorphism.
The small two-group cubic classification leaves the elementary and quaternion
alternatives. The quaternion alternative is impossible: W is generated by
involutions, whose images in Q₈ are all central.

Source: D. Parrott, *A characterization of the Tits' simple group* (1972),
pp.677–678 and §4, pp.682–683. The proof uses the established involution
transport instead of the source's explicit generators of W/F.
-/

open Subgroup
namespace Stellmacher.Recognition.ParrottSecondElementaryData
variable {G : Type*} [Group G] [Finite G] {z : G}

/-- Squares in the actual omega image lie in the supplied elementary subgroup.
Equivalently, its quotient by F has exponent two. -/
public theorem normalizer_omega_square_mem_elementary
    (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (hN : IsNTwoGroup G)
    (hproper : (d.sylow : Subgroup G) < normalizer (d.F : Set G))
    (Q : Sylow 3 (normalizer (d.F : Set G))) :
    let N := normalizer (d.F : Set G)
    let K := pCore 2 N
    let X := K.map N.subtype
    let D := (commutator X).map X.subtype
    let A := (Q : Subgroup N).map N.subtype
    let W := (omega₁ K (p := 2)).map (N.subtype.comp K.subtype)
    X ⊓ centralizer (A : Set G) ≤ D → ∀ w ∈ W, w ^ 2 ∈ d.F := by
  intro N K X D A W hCD
  let U := omega₁ K (p := 2)
  let i := N.subtype.comp K.subtype
  let F₀ := d.F.subgroupOf W
  have hWN : W ≤ N := by
    rintro x ⟨k, _, rfl⟩
    exact k.val.property
  let : F₀.Normal := normal_subgroupOf_of_le_normalizer hWN
  let V := W ⧸ F₀
  let f := QuotientGroup.mk' F₀
  have hNW : N ≤ normalizer (W : Set G) := by
    let B := U.map K.subtype
    let : U.Characteristic := omega₁_characteristic K
    let : B.Normal := ConjAct.normal_of_characteristic_of_normal
    have hh := le_normalizer_map (H := B) N.subtype
    rw [normalizer_eq_top] at hh
    simpa only [← MonoidHom.range_eq_map, range_subtype, B, W, map_map] using hh
  let action : Q →* MulAut W :=
    (W.normalizerMonoidHom.comp (inclusion hNW)).comp (Q : Subgroup N).subtype
  let : MulDistribMulAction Q W := MulDistribMulAction.compHom W action
  have hInv : IsInvariant Q W F₀ := by
    constructor
    intro q u
    change (u : G) ∈ d.F ↔ ((q : N) : G) * (u : G) * ((q : N) : G)⁻¹ ∈ d.F
    exact mem_normalizer_iff.mp (q : N).property u
  let : MulDistribMulAction Q V := quotientMulDistribMulAction F₀ hInv
  have hequiv (q : Q) (u : W) : f (q • u) = q • f u := by
    let : MulAction.QuotientAction Q F₀ := quotientAction_of_isInvariant F₀ hInv
    exact (MulAction.Quotient.smul_coe F₀ q u).symm
  have hWcard : Nat.card W = 256 :=
    (card_map_of_injective (f := N.subtype.comp K.subtype)
      (K := omega₁ K (p := 2)) (N.subtype_injective.comp K.subtype_injective)).trans
      (d.normalizer_core_omega_structure h hN hproper).1
  have hFcard : Nat.card F₀ = 32 :=
    (Nat.card_congr (subgroupOfEquivOfLe d.normalizer_core_omega_inclusions.1).toEquiv).trans d.card
  have hVcard : Nat.card V = 8 := by
    have hh := F₀.index_mul_card
    change Nat.card V * Nat.card F₀ = Nat.card W at hh
    rw [hFcard, hWcard] at hh
    omega
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let E := (commutator J).map (H.subtype.comp J.subtype)
  obtain ⟨y, hy, hy2, hyout⟩ :=
    d.exists_normalizer_core_involution_outside_elementary_join h hN hproper
  have hysq : y ^ 2 = 1 := hy2 ▸ pow_orderOf_eq_one y
  have hyW : y ∈ W := d.normalizer_core_square_one_mem_omega y hy hysq
  let yW : W := ⟨y, hyW⟩
  obtain ⟨q, hq⟩ := d.normalizer_core_involution_transport h hN hproper Q hCD y hy hysq
  let a : MulAut V := MulDistribMulAction.toMulAut Q V q
  have ha3 : a ^ 3 = 1 := by
    have hq3 : q ^ 3 = 1 := by
      have hQcard : Nat.card Q = 3 := d.normalizer_three_card h hN hproper Q
      have hp : q ^ Nat.card Q = 1 := pow_card_eq_one'
      exact (congrArg (fun n : ℕ => q ^ n) hQcard).symm.trans hp
    change (MulDistribMulAction.toMulAut Q V q) ^ 3 = 1
    rw [← map_pow, hq3, map_one]
  have hane : a ≠ 1 := by
    intro ha
    have he : f (q • yW) = f yW := (hequiv q yW).trans (DFunLike.congr_fun ha (f yW))
    have hd₀ : (q • yW) / yW ∈ F₀ := QuotientGroup.eq_iff_div_mem.mp he
    have hd : (((q : N) : G) * y * ((q : N) : G)⁻¹) / y ∈ d.F := hd₀
    have hm := (E ⊔ d.F).mul_mem ((E ⊔ d.F).inv_mem (mem_sup_right hd)) hq
    apply hyout
    convert hm using 1
    simp only [div_eq_mul_inv]
    group
  have hVp : IsPGroup 2 V := IsPGroup.of_card (n := 3) hVcard
  have hel : IsElementaryAbelian 2 V := by
    rcases elementary_or_quaternion_of_small_two_group_cubic hVp hVcard.le a ha3 hane with he | hquat
    · exact he
    · obtain ⟨e⟩ := hquat
      exfalso
      let r : U →* W := {
        toFun u := ⟨i (u : K), mem_map_of_mem i u.property⟩
        map_one' := Subtype.ext (map_one i)
        map_mul' x y := Subtype.ext (map_mul i (x : K) (y : K)) }
      have hr : Function.Surjective r := by
        rintro ⟨w, k, hk, he⟩
        exact ⟨⟨k, hk⟩, Subtype.ext he⟩
      let g := e.toMonoidHom.comp (f.comp r)
      have hg : Function.Surjective g := e.surjective.comp ((QuotientGroup.mk'_surjective F₀).comp hr)
      let B := (center (QuaternionGroup 2)).comap g
      have hUB : U ≤ B.map U.subtype := by
        apply (closure_le _).mpr
        intro k hk
        have hkU : k ∈ U := subset_closure hk
        refine ⟨⟨k, hkU⟩, ?_, rfl⟩
        change g ⟨k, hkU⟩ ∈ center (QuaternionGroup 2)
        have hpow : (g ⟨k, hkU⟩) ^ 2 = 1 := by
          rw [← map_pow, show (⟨k, hkU⟩ : U) ^ 2 = 1 from Subtype.ext hk, map_one]
        exact (show ∀ x : QuaternionGroup 2, x ^ 2 = 1 → x ∈ center (QuaternionGroup 2) by decide)
          _ hpow
      have hall (x : QuaternionGroup 2) : x ∈ center (QuaternionGroup 2) := by
        obtain ⟨u, rfl⟩ := hg x
        obtain ⟨u', hu', he⟩ := hUB u.property
        have he' : u' = u := U.subtype_injective he
        exact he' ▸ hu'
      exact (show (QuaternionGroup.a 1 : QuaternionGroup 2) ∉ center (QuaternionGroup 2) by decide)
        (hall _)
  let := hel
  intro w hw
  have he : (f ⟨w, hw⟩) ^ 2 = 1 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 V) _
  exact (QuotientGroup.eq_one_iff ((⟨w, hw⟩ : W) ^ 2)).mp (by
    change f ((⟨w, hw⟩ : W) ^ 2) = 1
    rw [map_pow]
    exact he)

end Stellmacher.Recognition.ParrottSecondElementaryData
