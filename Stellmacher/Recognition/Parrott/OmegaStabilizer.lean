module
public import Stellmacher.Recognition.Parrott.OmegaGeometry

/-!
# The two-group stabilizer of the fixed-join normalizer orbit

The intersection of H = C_G(z) with the normalizer of the fixed join
X = ⟨y⟩ ∨ C_E(y) is a two-group. In the faithful C₅⋊C₄ quotient model,
X has image generated by the involution represented by y. Every normalizer
of X therefore centralizes this image. Its centralizer has order four,
and the projection kernel is the original two-core. Taking its inverse
image and then a subgroup proves the assertion.

Source: Parrott, *A characterization of the Tits' simple group* (1972),
Lemma 3, printed p.675, the identification of the local stabilizer as a
two-group. No assumption about the ambient normalizer order is used.
The original omega interface is retained when the core-involution premise
identifies omega with this join.
-/

open Subgroup
namespace Stellmacher.Recognition

/-- The stabilizer of z in the outer fixed-join normalizer is a two-group. -/
public theorem parrott_outer_fixed_join_normalizer_stabilizer_isPGroup
    {G : Type*} [Group G] [Finite G]
    (z : G) (h : ParrottCentralizerHypotheses z) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let E := (commutator J).map (H.subtype.comp J.subtype)
    ∀ y : H, orderOf y = 2 → y ∉ J →
      let X := zpowers (y : G) ⊔ (E ⊓ centralizer ({(y : G)} : Set G))
      IsPGroup 2 (H.subgroupOf (normalizer (X : Set G))) := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let E := (commutator J).map (H.subtype.comp J.subtype)
  change ∀ y : H, orderOf y = 2 → y ∉ J → _
  intro y hy hyJ
  change y ∉ J at hyJ
  let Z := E ⊓ centralizer ({(y : G)} : Set G)
  let X := zpowers (y : G) ⊔ Z
  let N := normalizer (X : Set G)
  let T := H.subgroupOf N
  change IsPGroup 2 T
  have hXjoin : X = zpowers (y : G) ⊔ Z := rfl
  have hEH : E ≤ H := by
    rintro a ⟨d, _, rfl⟩
    exact (d : H).property
  have hZH : Z ≤ H := inf_le_left.trans hEH
  have hYH : zpowers (y : G) ≤ H := zpowers_le.mpr y.property
  have hYpull : (zpowers (y : G)).subgroupOf H = zpowers y := by
    have hm : (zpowers y).map H.subtype = zpowers (y : G) := MonoidHom.map_zpowers H.subtype y
    rw [← hm]
    exact comap_map_eq_self_of_injective H.subtype_injective _
  obtain ⟨φ, hφ, ⟨e⟩⟩ := h.quotient_model
  let M := Multiplicative (ZMod 5) ⋊[φ] Multiplicative (ZMod 4)
  let : Finite M := Finite.of_equiv (Multiplicative (ZMod 5) × Multiplicative (ZMod 4))
    SemidirectProduct.equivProd.symm
  let f := e.toMonoidHom.comp (QuotientGroup.mk' J)
  have hker : f.ker = J := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective, QuotientGroup.ker_mk']
  have hfy : orderOf (f y) = 2 := by
    apply orderOf_eq_prime
    · have hy2 : y ^ 2 = 1 := hy ▸ pow_orderOf_eq_one y
      rw [← map_pow, hy2, map_one]
    · intro heq
      exact hyJ (hker ▸ (show y ∈ f.ker from heq))
  have hZker : Z.subgroupOf H ≤ f.ker := by
    rw [hker]
    intro a ha
    obtain ⟨d, _, hd⟩ := ha.1
    have heq : (d : H) = a := H.subtype_injective hd
    exact heq ▸ d.property
  have himage : (X.subgroupOf H).map f = zpowers (f y) := by
    rw [hXjoin, subgroupOf_sup hYH hZH, hYpull, Subgroup.map_sup,
      MonoidHom.map_zpowers, (Subgroup.map_eq_bot_iff _).mpr hZker, sup_bot_eq]
  let C := centralizer ({f y} : Set M)
  have hCp : IsPGroup 2 C := IsPGroup.of_card (n := 2)
    (faithful_five_four_involution_centralizer φ hφ (f y) hfy).2
  have hpre : IsPGroup 2 (C.comap f) :=
    hCp.comap_of_ker_isPGroup f (by rw [hker]; exact pCore_isPGroup)
  have hcentral (a : T) : f (⟨((a : N) : G), a.property⟩ : H) ∈ C := by
    let aH : H := ⟨((a : N) : G), a.property⟩
    have hyX : (y : G) ∈ X := by
      rw [hXjoin]
      exact (le_sup_left : zpowers (y : G) ≤ zpowers (y : G) ⊔ Z) (mem_zpowers (y : G))
    have hconjX : ((a : N) : G) * (y : G) * ((a : N) : G)⁻¹ ∈ X :=
      ((a : N).property (y : G)).mp hyX
    have hmem : aH * y * aH⁻¹ ∈ X.subgroupOf H := hconjX
    have him : f (aH * y * aH⁻¹) ∈ zpowers (f y) :=
      himage ▸ mem_map_of_mem f hmem
    rw [mem_zpowers_iff_mem_range_orderOf, hfy] at him
    obtain ⟨k, hk, heq⟩ := Finset.mem_image.mp him
    have hk2 : k < 2 := Finset.mem_range.mp hk
    have hconj : f aH * f y * (f aH)⁻¹ = f y := by
      interval_cases k
      · have hbad : f y = 1 := by
          have hh : f aH * f y * (f aH)⁻¹ = 1 := by
            simpa only [pow_zero, map_mul, map_inv] using heq.symm
          have := congrArg (fun b => (f aH)⁻¹ * b * f aH) hh
          simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel_right, mul_one,
            inv_mul_cancel] using this
        rw [hbad, orderOf_one] at hfy
        omega
      · simpa only [pow_one, map_mul, map_inv] using heq.symm
    exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hconj)
  let i : T →* C.comap f :=
    { toFun := fun a => ⟨⟨((a : N) : G), a.property⟩, hcentral a⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  exact hpre.of_injective i (by
    intro a b hab
    exact Subtype.ext (Subtype.ext (congrArg (fun c : C.comap f => ((c : H) : G)) hab)))

/-- The stabilizer of z in the actual omega normalizer is a two-group. -/
public theorem parrott_omega_normalizer_stabilizer_isPGroup
    {G : Type*} [Group G] [Finite G]
    (z : G) (h : ParrottCentralizerHypotheses z) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let E := (commutator J).map (H.subtype.comp J.subtype)
    (∀ t : G, t ∈ J.map H.subtype → orderOf t = 2 → t ∈ E) →
    ∀ y : H, orderOf y = 2 → y ∉ J →
      let P := centralizer ({y} : Set H)
      let X := (omega₁ P (p := 2)).map (H.subtype.comp P.subtype)
      IsPGroup 2 (H.subgroupOf (normalizer (X : Set G))) := by
  dsimp only
  intro hcore y hy hyJ
  have hX := (parrott_outer_centralizer_omega z h hcore y hy hyJ).2.1
  rw [hX]
  exact parrott_outer_fixed_join_normalizer_stabilizer_isPGroup z h y hy hyJ

end Stellmacher.Recognition
