module

public import Stellmacher.Recognition.Parrott.SecondCentralizerOuterTransport
public import Theory.GroupTheory.SymmetricThreeQuotientInverter

/-!
# Selecting the outer involution for the second centralizer

The original core J is generated by the five-orbit of the supplied
involution. It cannot lie in K=O₂(N_G(F)), since the central four-group
of K contains a noncentral element of J. Consequently an involution of
J lies outside K. The S₃ quotient then supplies a three-subgroup inverted
by this involution.

The orders |N|=6144, |T|=2048 and |Q|=3 give N=QT, so the conjugator
aligning three-subgroups may be taken in T. The resulting involution
normalizes the prescribed fixed line and therefore centralizes its unique
involution v. This selects a point of P outside Ω₁(K) inverting Q.

Source: D. Parrott, *A characterization of the Tits' simple group* (1972),
pp.677–678 and §4, p.682.
-/

open Subgroup

namespace Stellmacher.Recognition.ParrottSecondElementaryData

variable {G : Type*} [Group G] [Finite G] {z : G}

/-- The original two-core is not contained in the second normalizer core. -/
public theorem original_core_not_le_normalizer_core
    (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (hN : IsNTwoGroup G)
    (hproper : (d.sylow : Subgroup G) < normalizer (d.F : Set G)) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let N := normalizer (d.F : Set G)
    ¬ J.map H.subtype ≤ (pCore 2 N).map N.subtype := by
  intro H J N hle
  let K := pCore 2 N
  obtain ⟨t, ht, htz, _, _, _, hcenter⟩ :=
    d.exists_normalizer_core_center_generator h hN hproper
  have htZ : t ∈ (center K).map (N.subtype.comp K.subtype) := by
    rw [hcenter]
    exact mem_sup_right (mem_zpowers t)
  obtain ⟨tK, htK, heq⟩ := htZ
  have htJ : t ∈ J.map H.subtype := d.le_core ht.2
  obtain ⟨tH, htHJ, htH⟩ := htJ
  change (tH : G) = t at htH
  change (tK : G) = t at heq
  let tJ : J := ⟨tH, htHJ⟩
  have htJC : tJ ∈ center J := by
    apply mem_center_iff.mpr
    intro x
    obtain ⟨xN, hxK, hx⟩ := hle (mem_map_of_mem H.subtype x.property)
    change (xN : G) = (x : G) at hx
    apply Subtype.ext
    apply Subtype.ext
    change (x : G) * (tH : G) = (tH : G) * (x : G)
    rw [htH, ← heq, ← hx]
    exact congrArg (N.subtype.comp K.subtype) (mem_center_iff.mp htK ⟨xN, hxK⟩)
  apply htz
  rw [← (parrott_centralizer_structure z h).1]
  exact ⟨tJ, htJC, htH⟩

/-- A five-conjugate of the supplied involution lies outside the second
normalizer core, while remaining in the original core and supplied Sylow. -/
public theorem exists_original_core_involution_outside_normalizer_core
    (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (hN : IsNTwoGroup G)
    (hproper : (d.sylow : Subgroup G) < normalizer (d.F : Set G)) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let N := normalizer (d.F : Set G)
    ∃ w : G, w ∈ J.map H.subtype ∧ w ∈ (d.sylow : Subgroup G) ∧
      orderOf w = 2 ∧ w ∉ (pCore 2 N).map N.subtype := by
  classical
  intro H J N
  let X := (pCore 2 N).map N.subtype
  let i := H.subtype.comp J.subtype
  obtain ⟨R, hR⟩ := h.five_centralizer
  let : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  let : MulDistribMulAction R J :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer (R : Subgroup H) J
      (Subgroup.le_normalizer_of_normal (H := J))
  have hfixed : FixedPoints.subgroup R J ≤ center J := by
    intro x hx
    apply hR
    change (x : H) ∈ centralizer (R : Set H)
    intro r hr
    have hh := congrArg J.subtype (hx ⟨r, hr⟩)
    change r * (x : H) * r⁻¹ = x at hh
    exact mul_inv_eq_iff_eq_mul.mp hh
  have hRcard : Nat.card R = 5 := by
    rw [R.card_eq_multiplicity, (h.card_and_solvable z).1]
    decide +kernel
  let a : J := ⟨d.a, d.a_mem_core⟩
  have ha : a ∉ commutator J := fun hh =>
    d.a_not_mem_derived (mem_map_of_mem J.subtype hh)
  have hgen := Theory.GroupAction.parrott_orbit_closure_eq_top
    pCore_isPGroup h.core_card h.core_class hRcard hfixed a ha
  have hout : ∃ r : R, i (r • a) ∉ X := by
    by_contra! hh
    apply d.original_core_not_le_normalizer_core h hN hproper
    have hle : (⊤ : Subgroup J) ≤ X.comap i := by
      rw [← hgen]
      apply (closure_le _).mpr
      rintro _ ⟨r, rfl⟩
      exact hh r
    rintro x ⟨xH, hxJ, rfl⟩
    exact hle (mem_top (⟨xH, hxJ⟩ : J))
  obtain ⟨r, hr⟩ := hout
  have hwJ : i (r • a) ∈ J.map H.subtype :=
    mem_map_of_mem H.subtype (r • a).property
  refine ⟨i (r • a), hwJ, d.core_le_sylow hwJ, ?_, hr⟩
  change orderOf ((r : G) * (d.a : G) * (r : G)⁻¹) = 2
  exact ((MulAut.conj (r : G)).orderOf_eq (d.a : G)).trans
    ((Subgroup.orderOf_coe d.a).trans d.a_order)

/-- The initial core involution inverts an actual subgroup of order three
in N. The three-subgroup is not yet required to be the supplied Sylow. -/
public theorem exists_original_core_involution_inverting_three
    (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (hN : IsNTwoGroup G)
    (hproper : (d.sylow : Subgroup G) < normalizer (d.F : Set G)) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let N := normalizer (d.F : Set G)
    ∃ (w : G) (R : Subgroup N),
      w ∈ J.map H.subtype ∧ w ∈ (d.sylow : Subgroup G) ∧
      orderOf w = 2 ∧ w ∉ (pCore 2 N).map N.subtype ∧
      Nat.card R = 3 ∧ ∀ r ∈ R, w * (r : G) * w⁻¹ = (r : G)⁻¹ := by
  intro H J N
  obtain ⟨w, hwJ, hwT, hw2, hwK⟩ :=
    d.exists_original_core_involution_outside_normalizer_core h hN hproper
  let wN : N := ⟨w, d.sylow_le_normalizer hwT⟩
  have hwN : orderOf wN = 2 := (Subgroup.orderOf_coe wN).symm.trans hw2
  obtain ⟨R, hR, hinv⟩ := exists_inverted_three_of_symmetric_three_quotient
    (pCore 2 N) pCore_isPGroup (d.normalizer_core_order h hN hproper).2.2.1
    wN hwN (fun hh => hwK (mem_map_of_mem N.subtype hh))
  exact ⟨w, R, hwJ, hwT, hw2, hwK, hR, fun r hr => congrArg N.subtype (hinv r hr)⟩

/-- The supplied Sylow two-subgroup suffices to conjugate every Sylow
three-subgroup of N to the prescribed one. -/
private theorem three_conjugate_by_supplied_sylow
    (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (hN : IsNTwoGroup G)
    (hproper : (d.sylow : Subgroup G) < normalizer (d.F : Set G))
    (Q : Sylow 3 (normalizer (d.F : Set G))) :
    let N := normalizer (d.F : Set G)
    ∀ R : Subgroup N, Nat.card R = 3 →
      ∃ t : N, (t : G) ∈ (d.sylow : Subgroup G) ∧
        R.map (MulAut.conj t).toMonoidHom = (Q : Subgroup N) := by
  intro N R hR
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hRp : IsPGroup 3 R := IsPGroup.of_card (n := 1) (by simpa using hR)
  obtain ⟨S, hRS⟩ := hRp.exists_le_sylow
  have hRS' : R = (S : Subgroup N) := eq_of_le_of_card_ge hRS (by
    rw [hR, d.normalizer_three_card h hN hproper S])
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq N S Q
  let T := (d.sylow : Subgroup G).subgroupOf N
  have hT : Nat.card T = 2048 :=
    (Nat.card_congr (subgroupOfEquivOfLe d.sylow_le_normalizer).toEquiv).trans
      (d.sylow_card h)
  have hc : (Q : Subgroup N).IsComplement' T := isComplement'_of_coprime
    (by rw [d.normalizer_three_card h hN hproper Q, hT,
      (d.normalizer_core_order h hN hproper).1])
    (by rw [d.normalizer_three_card h hN hproper Q, hT]; decide)
  obtain ⟨⟨q, t⟩, hqt⟩ := hc.2 g
  change (q : N) * (t : N) = g at hqt
  have hq : (q : N) • Q = Q := Sylow.smul_eq_iff_mem_normalizer.mpr
    ((Q : Subgroup N).le_normalizer q.property)
  have ht : (t : N) • S = Q := by
    apply (MulAction.injective (q : N))
    change (q : N) • ((t : N) • S) = (q : N) • Q
    rw [hq, ← mul_smul, hqt, hg]
  refine ⟨t, t.property, ?_⟩
  rw [hRS']
  exact congrArg Sylow.toSubgroup ht

/-- There is an involution of P outside omega which inverts the supplied
three-subgroup. Its membership in C_G(v) follows from normalization of the
fixed line, without a fusion assumption or a choice of cyclic generator. -/
public theorem exists_normalizer_fixed_outer_involution_inverting_three
    (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (hN : IsNTwoGroup G)
    (hproper : (d.sylow : Subgroup G) < normalizer (d.F : Set G))
    (Q : Sylow 3 (normalizer (d.F : Set G))) (v : G) (hv : orderOf v = 2)
    (hfix : d.F ⊓ centralizer ((Q : Subgroup (normalizer (d.F : Set G))).map
      (normalizer (d.F : Set G)).subtype : Set G) = zpowers v) :
    let N := normalizer (d.F : Set G)
    let K := pCore 2 N
    let W := (omega₁ K (p := 2)).map (N.subtype.comp K.subtype)
    let A := (Q : Subgroup N).map N.subtype
    let P := (d.sylow : Subgroup G) ⊓ centralizer ({v} : Set G)
    ∃ w : G, w ∈ P ∧ orderOf w = 2 ∧ w ∉ W ∧
      ∀ a ∈ A, w * a * w⁻¹ = a⁻¹ := by
  intro N K W A P
  obtain ⟨u, R, _, huT, hu2, huK, hR, hinv⟩ :=
    d.exists_original_core_involution_inverting_three h hN hproper
  obtain ⟨t, ht, hmap⟩ := d.three_conjugate_by_supplied_sylow h hN hproper Q R hR
  let f := MulAut.conj (t : G)
  let w := f u
  have hwT : w ∈ (d.sylow : Subgroup G) :=
    (d.sylow : Subgroup G).mul_mem ((d.sylow : Subgroup G).mul_mem ht huT)
      ((d.sylow : Subgroup G).inv_mem ht)
  have hw2 : orderOf w = 2 := (f.orderOf_eq u).trans hu2
  have hwK : w ∉ K.map N.subtype := by
    have htN : (t : G) ∈ normalizer (K.map N.subtype : Set G) := by
      apply le_normalizer_map N.subtype
      exact mem_map_of_mem N.subtype ((normalizer_eq_top K).symm ▸ mem_top t)
    exact fun hh => huK ((mem_normalizer_iff.mp htN u).mpr hh)
  have hwinv : ∀ a ∈ A, w * a * w⁻¹ = a⁻¹ := by
    rintro a ⟨aN, haQ, rfl⟩
    obtain ⟨r, hr, rfl⟩ := hmap.symm ▸ haQ
    have hh := congrArg f (hinv r hr)
    change f u * f (r : G) * (f u)⁻¹ = (f (r : G))⁻¹
    simpa only [map_mul, map_inv] using hh
  have hwA : w ∈ normalizer (A : Set G) := by
    apply mem_normalizer_iff.mpr
    intro a
    constructor
    · intro ha
      rw [hwinv a ha]
      exact A.inv_mem ha
    · intro ha
      have hh := A.inv_mem ha
      rw [← hwinv (w * a * w⁻¹) ha] at hh
      have hw : w * w = 1 := by
        have hp : w ^ 2 = 1 := hw2 ▸ pow_orderOf_eq_one w
        simpa only [pow_two] using hp
      have heq : w * (w * a * w⁻¹) * w⁻¹ = a := by
        calc
          _ = (w * w) * a * (w * w)⁻¹ := by group
          _ = a := by rw [hw]; simp
      rwa [heq] at hh
  have hwv : w ∈ centralizer ({v} : Set G) := by
    rw [← normalizer_zpowers_eq_centralizer_of_order_two v hv, ← hfix]
    exact inf_normalizer_le_normalizer_inf ⟨d.sylow_le_normalizer hwT,
      normalizer_le_normalizer_centralizer A hwA⟩
  refine ⟨w, ⟨hwT, hwv⟩, hw2, ?_, hwinv⟩
  rintro ⟨k, _, hk⟩
  exact hwK (hk ▸ mem_map_of_mem N.subtype k.property)

end Stellmacher.Recognition.ParrottSecondElementaryData
