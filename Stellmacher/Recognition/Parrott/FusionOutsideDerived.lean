module
public import Stellmacher.Recognition.Parrott.DerivedNormalizer
public import Stellmacher.Recognition.Parrott.ElementNormalClosure
public import Stellmacher.Recognition.SimpleInvolutionFusion
public import Theory.GroupTheory.AbelianClassClosureWeakClosure

/-!
# Parrott's involution fusion outside the derived subgroup

Let G be a finite nonsolvable simple N₂ group with Parrott's original
centralizer hypotheses at an involution z. Put H = C_G(z), J = O₂(H),
and let E be the actual ambient image of J'. Then z is conjugate in G
to an involution of H outside E. No fusion or normalizer conclusion is
assumed in the public statement.

The first centralizer lemma places z in an actual ambient Sylow two-group
contained in H. The simple-group consequence of Glauberman's Z-star theorem
gives a distinct conjugate t of z in that same Sylow. If the required
outside-E conjugate did not exist, every ambient conjugate of z in H
would lie in E, and this t would lie in E outside the subgroup generated
by z. Its normal closure in H is E by the preceding normal-generation
lemma. Thus E is exactly the subgroup generated by the ambient conjugates
of z in H.

The group E is abelian, and the proved N₂ normalizer theorem gives
N_G(E) = H. The imported conjugacy-class closure argument therefore forces
every conjugate of z in H to equal z, contradicting the chosen t. All
Sylow subgroups, subgroup maps, normal closures, and conjugates are actual
constructions in G.

Source: David Parrott, *A characterization of the Tits' simple group*
(1972), Lemma 2, p. 673, second assertion. This is its finite nonsolvable
simple N₂ specialization, using the original centralizer hypotheses.
-/

open Subgroup

namespace Stellmacher.Recognition

/-- The original involution has an ambient conjugate in its centralizer outside the derived two-core. -/
public theorem parrott_fusion_outside_derived
    {G : Type*} [Group G] [Finite G] [IsSimpleGroup G]
    (hns : ¬ Group.IsSolvable G) (hN : IsNTwoGroup G)
    (z : G) (h : ParrottCentralizerHypotheses z) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let E := (commutator J).map (H.subtype.comp J.subtype)
    ∃ t : G, orderOf t = 2 ∧ t ∈ H ∧ t ∉ E ∧ IsConj z t := by
  classical
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let D := commutator J
  let E := D.map (H.subtype.comp J.subtype)
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  change ∃ t : G, orderOf t = 2 ∧ t ∈ H ∧ t ∉ E ∧ IsConj z t
  have hclosure : ∀ t : H, (t : G) ∈ E → (t : G) ∉ zpowers z →
      (normalClosure ({t} : Set H)).map H.subtype = E := parrott_element_normalClosure z h
  by_contra hnone
  have horder (x : G) (hx : IsConj z x) : orderOf x = 2 := by
    obtain ⟨g, hg⟩ := isConj_iff.mp hx
    rw [← hg]
    exact ((MulAut.conj g).orderOf_eq z).trans h.involution
  have hclosed (x : G) (hxH : x ∈ H) (hx : IsConj z x) : x ∈ E := by
    by_contra hxE
    exact hnone ⟨x, horder x hx, hxH, hxE, hx⟩
  obtain ⟨hZmap, _, _, _, _, hElem, _, hSylow⟩ := parrott_centralizer_structure z h
  change IsElementaryAbelian 2 D at hElem
  let : IsElementaryAbelian 2 D := hElem
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.map (H.subtype.comp J.subtype)
  have hzJ : z ∈ J.map H.subtype := by
    have hzZ : z ∈ (center J).map (H.subtype.comp J.subtype) := by
      rw [hZmap]
      exact mem_zpowers z
    obtain ⟨c, _, hcz⟩ := hzZ
    exact ⟨(c : H), c.property, hcz⟩
  let T : Sylow 2 H := default
  obtain ⟨S, hS⟩ := hSylow T
  have hJT : J ≤ (T : Subgroup H) := pCore_isPGroup.le_sylow_of_normal T
  have hSH : (S : Subgroup G) ≤ H := by
    rw [hS]
    exact map_subtype_le _
  have hzS : z ∈ (S : Subgroup G) := by
    rw [hS]
    exact map_mono hJT hzJ
  let zS : S := ⟨z, hzS⟩
  have hzSorder : orderOf zS = 2 := by
    exact (Subgroup.orderOf_coe zS).symm.trans h.involution
  obtain ⟨t, htneS, hzt⟩ := exists_distinct_isConj_in_sylow hns S zS hzSorder
  have htne : (t : G) ≠ z := fun heq => htneS (Subtype.ext heq)
  have htH : (t : G) ∈ H := hSH t.property
  have htE : (t : G) ∈ E := hclosed t htH hzt
  have ht2 : orderOf (t : G) = 2 := horder t hzt
  have htcyc : (t : G) ∉ zpowers z := by
    intro htcyc
    rw [mem_zpowers_iff_mem_range_orderOf, h.involution] at htcyc
    obtain ⟨n, hn, hnt⟩ := Finset.mem_image.mp htcyc
    have hnlt : n < 2 := Finset.mem_range.mp hn
    interval_cases n
    · have ht1 : (t : G) = 1 := by simpa using hnt.symm
      simp [ht1] at ht2
    · exact htne (by simpa using hnt.symm)
  let C : Subgroup G := closure {x : G | x ∈ H ∧ IsConj z x}
  have hgen : E = C := by
    apply le_antisymm
    · let tH : H := ⟨t, htH⟩
      rw [← hclosure tH htE htcyc]
      apply map_le_iff_le_comap.mpr
      change closure (Group.conjugatesOfSet ({tH} : Set H)) ≤ C.comap H.subtype
      apply (Subgroup.closure_le _).mpr
      intro x hx
      obtain ⟨a, ha, hax⟩ := Group.mem_conjugatesOfSet_iff.mp hx
      have hat : a = tH := Set.mem_singleton_iff.mp ha
      subst a
      apply Subgroup.subset_closure
      exact ⟨x.property, hzt.trans (H.subtype.map_isConj hax)⟩
    · exact (Subgroup.closure_le _).mpr (fun x hx => hclosed x hx.1 hx.2)
  have hnorm : normalizer (E : Set G) ≤ H :=
    (parrott_derived_normalizer_of_nTwo hN z h).le
  exact htne (conjugate_eq_of_abelian_class_closure_normalizer z E hgen hnorm t htH hzt)

end Stellmacher.Recognition
