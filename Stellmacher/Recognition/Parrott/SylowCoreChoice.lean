module

public import Stellmacher.Recognition.Parrott.SylowCoreCosets
public import Stellmacher.Recognition.Parrott.SylowCoreAdjustment

/-!
# Choosing Parrott's core coordinates

Starting with the supplied initial frame through (10), the core coset theorem
selects a common case for the five relations. The coordinate adjustment then
removes the central errors by multiplying `a` by `t` if necessary and `c` by
elements of the subgroup generated by `w,v,t,u`.

The resulting initial frame retains the supplied `z,t,v,F,T`, its outer action,
all equations through (10), and the actual elementary and core generation
equalities. It satisfies the exact equations (11)–(15) in the selected case.

Source: D. Parrott, *A characterization of the Tits' simple group* (1972),
printed p.679, equations (11)–(15).
-/

namespace Stellmacher.Recognition.ParrottSylowInitialData

variable {G : Type*} [Group G] {z : G}
variable {e : ParrottSecondElementaryData z}
variable {n : ParrottNormalizerFusionData e}

/-- Choose either set of core relations from the original initial frame.
Only `a` and `c` are adjusted. The type of `g` preserves the supplied normalizer
data and all through-(10) fields, including the actual closure equalities. -/
public theorem exists_core_relations [Finite G] [IsSimpleGroup G]
    (f : ParrottSylowInitialData n) (hns : ¬ Group.IsSolvable G)
    (hN : IsNTwoGroup G) (h : ParrottCentralizerHypotheses z) :
    ∃ (caseTwo : Bool) (g : ParrottSylowInitialData n),
      g.CoreRelations caseTwo ∧
      g.u = f.u ∧ g.w = f.w ∧ g.x = f.x ∧ g.b = f.b ∧ g.d = f.d ∧
      (g.a = f.a ∨ g.a = f.a * n.t) ∧
      ∃ r ∈ Subgroup.closure ({f.w, n.v, n.t, f.u} : Set G), g.c = f.c * r := by
  obtain ⟨caseTwo, hc⟩ := f.exists_core_coset_alternatives hns hN h
  exact ⟨caseTwo, f.exists_core_relations_of_coset_alternatives h caseTwo hc⟩

end Stellmacher.Recognition.ParrottSylowInitialData
