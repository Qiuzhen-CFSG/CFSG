/-!
# Extending the normalized centralizer action

The ambient centralizer of J = O₂(C_G(z)) is precisely ⟨z⟩. Indeed, an
element centralizing J centralizes its derived subgroup E, hence belongs to
E by self-centralization. It therefore belongs to J and to its center.

For an action normalized through equation (23), the remaining word calculation
must show that ryrx⁻¹rx centralizes J. The core-centralizer identity places
this discrepancy in ⟨z⟩, and the dihedral power relations remove it, proving
equation (24). The resulting frame preserves all the supplied Sylow equations
and all actual subgroup-generation equalities.

The word calculation is supplied by CentralizerWordAction, so a normalized
action frame now gives the full generator frame with no additional premises.
The final construction obtains the involution stage from the original
hypotheses, classifies its compatible core action, and removes the central
signs by conjugating r. For the second a-image coset, the verified coordinate
change restores the unprimed action and every Sylow equation. Thus the full
centralizer frame exists for any supplied normalized Sylow frame, retaining
the original elementary and normalizer data.

Source: D. Parrott, *A characterization of the Tits' simple group* (1972),
printed pp.680–681, the alternatives preceding (23) and the centralizer
argument establishing equation (24).
-/

open Subgroup

namespace Stellmacher.Recognition

variable {G : Type*} [Group G] {z : G}

/-- The centralizer of the actual ambient two-core is generated by z. -/
public theorem parrott_core_centralizer [Finite G]
    (h : ParrottCentralizerHypotheses z) :
    centralizer (((pCore 2 (centralizer ({z} : Set G))).map
      (centralizer ({z} : Set G)).subtype : Subgroup G) : Set G) = zpowers z := by
  let H := centralizer ({z} : Set G)
  let J := pCore 2 H
  let K := J.map H.subtype
  let E := (commutator J).map (H.subtype.comp J.subtype)
  have hEK : E ≤ K := by
    change (commutator J).map (H.subtype.comp J.subtype) ≤ J.map H.subtype
    rw [← map_map]
    exact map_mono (map_subtype_le (commutator J))
  have hCE : centralizer (E : Set G) = E := parrott_derived_centralizer z h
  have hZ := (parrott_centralizer_structure z h).1
  change (center J).map (H.subtype.comp J.subtype) = zpowers z at hZ
  apply le_antisymm
  · intro g hg
    have hgE : g ∈ E := hCE ▸ centralizer_le hEK hg
    obtain ⟨gH, hgJ, rfl⟩ := hEK hgE
    rw [← hZ]
    refine ⟨⟨gH, hgJ⟩, ?_, rfl⟩
    apply mem_center_iff.mpr
    intro j
    apply Subtype.ext
    apply Subtype.ext
    exact hg (j : G) (mem_map_of_mem H.subtype j.property)
  · apply zpowers_le.mpr
    intro g hg
    exact mem_centralizer_singleton_iff.mp (map_subtype_le J hg)

variable {e : ParrottSecondElementaryData z} {n : ParrottNormalizerFusionData e}

namespace ParrottCentralizerActionData

variable (f : ParrottCentralizerActionData n)

/-- The four generator commutations are exactly the missing core-centralizer
calculation. This avoids requiring a statement about arbitrary elements of J. -/
public theorem discrepancy_mem_core_centralizer
    (ha : Commute f.a (f.r * f.y * f.r * (f.x⁻¹ * f.r * f.x)))
    (hb : Commute f.b (f.r * f.y * f.r * (f.x⁻¹ * f.r * f.x)))
    (hc : Commute f.c (f.r * f.y * f.r * (f.x⁻¹ * f.r * f.x)))
    (hd : Commute f.d (f.r * f.y * f.r * (f.x⁻¹ * f.r * f.x))) :
    f.r * f.y * f.r * (f.x⁻¹ * f.r * f.x) ∈
      centralizer (((pCore 2 (centralizer ({z} : Set G))).map
        (centralizer ({z} : Set G)).subtype : Subgroup G) : Set G) := by
  let q := f.r * f.y * f.r * (f.x⁻¹ * f.r * f.x)
  have hJ : (pCore 2 (centralizer ({z} : Set G))).map
      (centralizer ({z} : Set G)).subtype ≤ centralizer ({q} : Set G) := by
    rw [← f.core_generators]
    apply (closure_le _).mpr
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    apply mem_centralizer_singleton_iff.mpr
    rcases hg with rfl | rfl | rfl | rfl
    · exact ha.eq
    · exact hb.eq
    · exact hc.eq
    · exact hd.eq
  intro j hj
  exact mem_centralizer_singleton_iff.mp (hJ hj)

/-- Equation (24) follows once the discrepancy centralizes the original core.
No additional conjugacy assertion is needed to remove its central ambiguity. -/
public theorem eq24_of_centralizing_discrepancy [Finite G]
    (h : ParrottCentralizerHypotheses z)
    (hq : f.r * f.y * f.r * (f.x⁻¹ * f.r * f.x) ∈
      centralizer (((pCore 2 (centralizer ({z} : Set G))).map
        (centralizer ({z} : Set G)).subtype : Subgroup G) : Set G)) :
    f.r * f.x * f.r = (f.y * f.r) ^ 2 * f.x := by
  rw [parrott_core_centralizer h] at hq
  exact Theory.GroupTheory.dihedral_word_of_central_involution_discrepancy
    f.z_sq f.y_sq f.eq20_r f.eq20_ry f.eq04 f.comm_zx f.comm_zy f.comm_zr hq

/-- Assemble a centralizer frame from a normalized action and its verified
discrepancy calculation, retaining every original coordinate and generation field. -/
public def toGeneratorDataOfCentralizingDiscrepancy [Finite G]
    (h : ParrottCentralizerHypotheses z)
    (hq : f.r * f.y * f.r * (f.x⁻¹ * f.r * f.x) ∈
      centralizer (((pCore 2 (centralizer ({z} : Set G))).map
        (centralizer ({z} : Set G)).subtype : Subgroup G) : Set G)) :
    ParrottCentralizerGeneratorData n where
  toParrottSylowGeneratorData := f.toParrottSylowGeneratorData
  r := f.r
  centralizer_generators := f.centralizer_generators
  r_order := f.r_order
  r_conjugate := f.r_conjugate
  comm_zr := f.comm_zr
  eq20_r := f.eq20_r
  eq20_ry := f.eq20_ry
  eq20_tr := f.eq20_tr
  eq21_vr := f.eq21_vr
  eq22_ur := f.eq22_ur
  eq22_wr := f.eq22_wr
  eq23_ar := f.eq23_ar
  eq23_dr := f.eq23_dr
  eq23_cr := f.eq23_cr
  eq23_br := f.eq23_br
  eq24 := f.eq24_of_centralizing_discrepancy h hq

/-- The verified word calculation discharges the discrepancy premise in (24). -/
public theorem eq24 [Finite G] (h : ParrottCentralizerHypotheses z) :
    f.r * f.x * f.r = (f.y * f.r) ^ 2 * f.x := by
  obtain ⟨ha, hb, hc, hd⟩ := f.generator_commutes_discrepancy
  exact f.eq24_of_centralizing_discrepancy h
    (f.discrepancy_mem_core_centralizer ha hb hc hd)

/-- Extend a normalized action through (24), retaining all coordinates and
all actual generation, order and conjugacy fields. -/
public def toGeneratorData [Finite G] (h : ParrottCentralizerHypotheses z) :
    ParrottCentralizerGeneratorData n :=
  f.toGeneratorDataOfCentralizingDiscrepancy h
    (f.discrepancy_mem_core_centralizer f.generator_commutes_discrepancy.1
      f.generator_commutes_discrepancy.2.1 f.generator_commutes_discrepancy.2.2.1
      f.generator_commutes_discrepancy.2.2.2)

end ParrottCentralizerActionData

/-- The original existence problem reduces solely to normalization of the
core action. The actual involution is constructed from the supplied frame. -/
public theorem ParrottSylowGeneratorData.exists_centralizer_generators_of_action_normalization
    [Finite G] [IsSimpleGroup G] (f : ParrottSylowGeneratorData n)
    (hns : ¬ Group.IsSolvable G) (hN : IsNTwoGroup G)
    (h : ParrottCentralizerHypotheses z)
    (hnormalize : ∀ _g : ParrottCentralizerInvolutionData n,
      Nonempty (ParrottCentralizerActionData n)) :
    Nonempty (ParrottCentralizerGeneratorData n) := by
  obtain ⟨g⟩ := f.exists_centralizer_involution hns hN h
  obtain ⟨g'⟩ := hnormalize g
  exact ⟨g'.toGeneratorData h⟩

/-- Normalize the actual core action to the unprimed equations (23).
The second coset may change the Sylow coordinates, but retains e and n. -/
public theorem ParrottCentralizerInvolutionData.exists_normalized_action
    [Finite G] [IsSimpleGroup G] (g : ParrottCentralizerInvolutionData n)
    (hns : ¬ Group.IsSolvable G) (hN : IsNTwoGroup G)
    (h : ParrottCentralizerHypotheses z) :
    Nonempty (ParrottCentralizerActionData n) := by
  obtain ⟨β, δ, γ, hp⟩ := g.exists_true_compatible_action_parameters hns hN h
  obtain ⟨g', hp'⟩ := g.exists_compatible_action_parameters_normalized_signs β δ γ hp
  cases β with
  | false => exact ⟨g'.toActionDataOfCompatibleParameters hp'⟩
  | true => exact g'.nonempty_action_of_second_coset hp'

/-- Extend supplied normalized Sylow coordinates to generators of the actual
centralizer satisfying (20)–(24), including the unprimed equations (23).
The output may renormalize the Sylow coordinates while preserving e and n. -/
public theorem ParrottSylowGeneratorData.exists_centralizer_generators
    [Finite G] [IsSimpleGroup G] (f : ParrottSylowGeneratorData n)
    (hns : ¬ Group.IsSolvable G) (hN : IsNTwoGroup G)
    (h : ParrottCentralizerHypotheses z) :
    Nonempty (ParrottCentralizerGeneratorData n) := by
  exact f.exists_centralizer_generators_of_action_normalization hns hN h
    (fun g => g.exists_normalized_action hns hN h)

end Stellmacher.Recognition
