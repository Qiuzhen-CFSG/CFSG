module

public import Stellmacher.Recognition.Parrott.LocalFusionObstruction
public import Stellmacher.Recognition.Parrott.DerivedVCyclicLift
public import Theory.GroupTheory.CyclicElementaryDerived

/-!
# The derived subgroup of Parrott's second local centralizer

The computation on p.677 of Parrott (1972) gives a cyclic supplement to E
in the ambient image of V′, generated by an element of order four in J.
From such a lift we prove both subsequent computations: nonabelian V′ has
V″=⟨z⟩, while abelian V′ has square subgroup of order two. The characteristic
subgroup obstructions then exclude fusion of z and v.

The cyclic lift is supplied by `DerivedVCyclicLift`, using the quotient-action
calculation from pp.673–674. Thus the final exclusion uses only the local
centralizer premises, with no additional cyclic-lift assumption.
-/

open Subgroup

namespace Stellmacher.Recognition

variable {G : Type*} [Group G] [Finite G] {z : G}

/-- An order-four cyclic lift for V′ gives both characteristic subgroup
computations in the final paragraph of Parrott's Lemma 5. -/
public theorem parrott_derived_computations_of_cyclic_lift
    (h : ParrottCentralizerHypotheses z) (V : Subgroup G) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let i := H.subtype.comp J.subtype
    ∀ b : J, i b ∈ (commutator V).map V.subtype → orderOf b = 4 →
      (commutator V).map V.subtype ≤ (zpowers b ⊔ commutator J).map i →
      (¬ IsMulCommutative (commutator V) →
        (commutator (commutator V)).map (V.subtype.comp (commutator V).subtype) = zpowers z) ∧
      (IsMulCommutative (commutator V) →
        Nat.card (closure (Set.range (fun x : commutator V => x ^ 2))) = 2) := by
  classical
  intro H J i b hb hb4 hgen
  let D := commutator V
  let j : D →* G := V.subtype.comp D.subtype
  have hi : Function.Injective i := H.subtype_injective.comp J.subtype_injective
  have hj : Function.Injective j := V.subtype_injective.comp D.subtype_injective
  have hjrange (x : D) : j x ∈ i.range := by
    obtain ⟨a, _, ha⟩ := hgen (mem_map_of_mem V.subtype x.property)
    exact ⟨a, ha⟩
  let f : D →* J := (MonoidHom.ofInjective hi).symm.toMonoidHom.comp
    (j.codRestrict i.range hjrange)
  have hif (x : D) : i (f x) = j x :=
    MonoidHom.apply_ofInjective_symm hi ⟨j x, hjrange x⟩
  have hcomp : i.comp f = j := MonoidHom.ext hif
  have hf : Function.Injective f := by
    intro x y hxy
    apply hj
    rw [← hif x, ← hif y, hxy]
  have hfrange : f.range ≤ zpowers b ⊔ commutator J := by
    rintro _ ⟨x, rfl⟩
    obtain ⟨a, ha, heq⟩ := hgen (mem_map_of_mem V.subtype x.property)
    have haf : a = f x := hi (heq.trans (hif x).symm)
    exact haf ▸ ha
  obtain ⟨bV, hbV, hbval⟩ := hb
  let bD : D := ⟨bV, hbV⟩
  have hfb : f bD = b := hi ((hif bD).trans hbval)
  have hbD4 : orderOf bD = 4 := by
    rw [← orderOf_injective f hf, hfb, hb4]
  obtain ⟨hZ, _, _, _, hupper, helem, _, _⟩ := parrott_centralizer_structure z h
  have hZcard : Nat.card (center J) = 2 := by
    have hc := card_map_of_injective (K := center J) (f := i) hi
    rw [hZ, Nat.card_zpowers, h.involution] at hc
    exact hc.symm
  constructor
  · intro hnonabelian
    have hderived := derived_eq_center_of_injective_range_le_zpowers_sup
      f hf (commutator J) b hupper.le hfrange hZcard hnonabelian
    have hm := congrArg (fun K : Subgroup J => K.map i) hderived
    rw [map_map, hcomp, hZ] at hm
    exact hm
  · intro hab
    let : IsMulCommutative D := hab
    let : IsElementaryAbelian 2 (commutator J) := helem
    apply square_card_two_of_injective_range_le_zpowers_sup f hf (commutator J) bD hbD4
    rwa [hfb]

/-- The two derived-subgroup computations for the order-512 centralizer of an
element of E outside ⟨z⟩. Both hold before assuming fusion. -/
public theorem parrott_derived_computations
    (h : ParrottCentralizerHypotheses z) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let E := (commutator J).map (H.subtype.comp J.subtype)
    ∀ v : G, v ∈ E → v ∉ zpowers z →
      ∀ V : Subgroup G, H ⊓ centralizer ({v} : Set G) = V →
        Nat.card V = 512 →
        (¬ IsMulCommutative (commutator V) →
          (commutator (commutator V)).map
            (V.subtype.comp (commutator V).subtype) = zpowers z) ∧
        (IsMulCommutative (commutator V) →
          Nat.card (closure (Set.range (fun x : commutator V => x ^ 2))) = 2) := by
  intro H J E v hv hvz V hlocal hcard
  obtain ⟨b, hb, hb4, hgen⟩ := parrott_derived_cyclic_lift z h v hv hvz V hlocal hcard
  exact parrott_derived_computations_of_cyclic_lift h V b hb hb4 hgen

namespace ParrottSecondElementaryData

/-- The source's cyclic lift suffices for the second representative's fusion
exclusion, and may be constructed only under the fusion assumption. -/
public theorem derived_v_fusion_of_cyclic_lift (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (v : G) (hv : orderOf v = 2)
    (hzv : Commute z v)
    (hlocal : centralizer ({z} : Set G) ⊓ centralizer ({v} : Set G) =
      (d.sylow : Subgroup G) ⊓ centralizer ({v} : Set G)) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let i := H.subtype.comp J.subtype
    let V := (d.sylow : Subgroup G) ⊓ centralizer ({v} : Set G)
    Nat.card V = 512 → (center V).map V.subtype = closure ({z, v} : Set G) →
    (IsConj z v → ∃ b : J, i b ∈ (commutator V).map V.subtype ∧ orderOf b = 4 ∧
      (commutator V).map V.subtype ≤ (zpowers b ⊔ commutator J).map i) →
    ¬ IsConj z v := by
  classical
  intro H J i V hcard hcenter hlift hconj
  obtain ⟨b, hb, hb4, hgen⟩ := hlift hconj
  obtain ⟨hnonab, hab⟩ := parrott_derived_computations_of_cyclic_lift h V b hb hb4 hgen
  have hsmall : Nat.card V < 2048 := by omega
  by_cases hcomm : IsMulCommutative (commutator V)
  · exact d.local_fusion_derived_square_two h v hv hzv hlocal hsmall
      hcenter (hab hcomm) hconj
  · have himage := hnonab hcomm
    have htwo : Nat.card (commutator (commutator V)) = 2 := by
      have hc := card_map_of_injective (K := commutator (commutator V))
        (f := V.subtype.comp (commutator V).subtype)
        (V.subtype_injective.comp (commutator V).subtype_injective)
      rw [himage, Nat.card_zpowers, h.involution] at hc
      exact hc.symm
    exact d.local_fusion_derived_characteristic_two h v hv hzv hlocal hsmall
      hcenter (commutator (commutator V)) inferInstance htwo hconj

/-- Parrott's second representative cannot fuse with z: the characteristic
subgroup of order two in V′ is either V″ or the subgroup generated by squares
in V′. This proves the second branch in the first paragraph of p.677. -/
public theorem derived_v_fusion (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z)
    (_hself : normalizer (d.F : Set G) = (d.sylow : Subgroup G)) :
    let H := centralizer ({z} : Set G)
    let J := pCore 2 H
    let E := (commutator J).map (H.subtype.comp J.subtype)
    ∀ v : G, v ∈ E → v ∉ zpowers z → orderOf v = 2 → Commute z v →
      H ⊓ centralizer ({v} : Set G) =
        (d.sylow : Subgroup G) ⊓ centralizer ({v} : Set G) →
      let V := (d.sylow : Subgroup G) ⊓ centralizer ({v} : Set G)
      Nat.card V = 512 → (center V).map V.subtype = closure ({z, v} : Set G) →
      ¬ IsConj z v := by
  intro H J E v hvE hvz hv hzv hlocal V hcard hcenter
  apply d.derived_v_fusion_of_cyclic_lift h v hv hzv hlocal hcard hcenter
  intro _
  exact parrott_derived_cyclic_lift z h v hvE hvz V hlocal hcard

end ParrottSecondElementaryData
end Stellmacher.Recognition
