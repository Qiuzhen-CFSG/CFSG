module

public import Stellmacher.Recognition.Parrott.SecondCentralizerOuterGeometry
public import Stellmacher.Recognition.Parrott.SecondCentralizerSylowGeometry
public import Theory.GroupTheory.SaturatedInvolutionSquareFusion
public import Theory.GroupTheory.SaturatedCentralizerCard
public import Theory.GroupTheory.InvolutionClosedTransfer

/-!
# The first transfer in the second centralizer

Put C=C_G(v), V=C_N(v), W=Ω₁(O₂(N)), and P=T∩C. For every involution
w in P outside W, its local centralizer S is an elementary group of order 32.
The compatible fixed join controls N_C(S), so the two-group normalizer
condition makes S a Sylow subgroup of C_C(w). For an involution l in W,
|C_V(l)|≥128 and |C_V(l)| divides 1536, hence C_V(l) contains a subgroup
of order 64. Sylow comparison therefore excludes C-fusion from P−W into W.

The omega subgroup is generated by involutions. Binary transfer consequently
gives a normal subgroup M of index two in C with M∩P=W, and W is the actual
ambient image of a Sylow two-subgroup of M. No ambient containment is used.

Source: D. Parrott, *A characterization of the Tits' simple group* (1972),
§4, p.682, the first transfer in Lemma 8.
-/

open Subgroup
namespace Stellmacher.Recognition.ParrottSecondElementaryData
variable {G : Type*} [Group G] [Finite G] {z : G}

/-- Every outside-omega Sylow involution has an order-32 local centralizer
which is maximal among two-subgroups of its full centralizer in C_G(v). -/
public theorem normalizer_fixed_outer_saturation
    (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (hN : IsNTwoGroup G)
    (hproper : (d.sylow : Subgroup G) < normalizer (d.F : Set G))
    (Q : Sylow 3 (normalizer (d.F : Set G))) (v : G) (hv : orderOf v = 2)
    (hfix : d.F ⊓ centralizer ((Q : Subgroup (normalizer (d.F : Set G))).map
      (normalizer (d.F : Set G)).subtype : Set G) = zpowers v) :
    let N := normalizer (d.F : Set G)
    let K := pCore 2 N
    let W := (omega₁ K (p := 2)).map (N.subtype.comp K.subtype)
    let C := centralizer ({v} : Set G)
    let V := N ⊓ C
    let P := (d.sylow : Subgroup G) ⊓ C
    ∀ w : G, w ∈ P → orderOf w = 2 → w ∉ W →
      let S := V ⊓ centralizer ({w} : Set G)
      IsElementaryAbelian 2 S ∧ Nat.card S = 32 ∧
      (∀ R : Subgroup G, IsPGroup 2 R → S ≤ R →
        R ≤ C ⊓ centralizer ({w} : Set G) → R = S) := by
  intro N K W C V P w hw hw2 hwW S
  obtain ⟨e, hea, heF, _, hvE, heproper⟩ :=
    d.normalizer_fixed_join_of_centralizer_card_le h hN hproper Q v hv hfix w hw hw2 hwW
      (d.outside_omega_fixed_centralizer_card_le h hN hproper Q v hv hfix w hw hw2 hwW)
  have hout := d.normalizer_fixed_join_outside_omega_center h hN hproper Q v hv hfix
    w e hea heF heproper
  change e.F = S at heF
  have hcontrol : C ⊓ normalizer (S : Set G) ≤ V := by
    rw [← heF]
    exact d.fixed_join_normalizer_le_of_outside_omega_center e h hN heproper v hvE hout
  refine ⟨by rw [← heF]; exact e.elementary, by rw [← heF]; exact e.card, ?_⟩
  apply saturated_of_normalizer_control S V (C ⊓ centralizer ({w} : Set G))
  · intro R _ hSR hRV
    exact le_antisymm (le_inf (hRV.trans inf_le_left)
      (hRV.trans (inf_le_right.trans inf_le_right))) hSR
  · intro x hx
    exact hcontrol ⟨hx.2.1, hx.1⟩

set_option maxRecDepth 4096 in
private theorem sixtyfour_dvd_of_dvd_1536 (n : ℕ) (hd : n ∣ 1536) (hn : 128 ≤ n) :
    64 ∣ n := by
  have hm := Nat.mem_divisors.mpr ⟨hd, by decide⟩
  rw [show Nat.divisors 1536 =
    {1, 2, 3, 4, 6, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192, 256, 384, 512, 768, 1536}
    by decide] at hm
  simp only [Finset.mem_insert, Finset.mem_singleton] at hm
  rcases hm with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h <;>
    subst n <;> omega

/-- Involutions outside omega in the local Sylow do not fuse into omega
inside the full centralizer. -/
public theorem normalizer_fixed_outer_not_fused_into_omega
    (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (hN : IsNTwoGroup G)
    (hproper : (d.sylow : Subgroup G) < normalizer (d.F : Set G))
    (Q : Sylow 3 (normalizer (d.F : Set G))) :
    let N := normalizer (d.F : Set G)
    let K := pCore 2 N
    let X := K.map N.subtype
    let D := (commutator X).map X.subtype
    let A := (Q : Subgroup N).map N.subtype
    X ⊓ centralizer (A : Set G) ≤ D →
    ∀ v : G, orderOf v = 2 → d.F ⊓ centralizer (A : Set G) = zpowers v →
    let W := (omega₁ K (p := 2)).map (N.subtype.comp K.subtype)
    let C := centralizer ({v} : Set G)
    let P := (d.sylow : Subgroup G) ⊓ C
    ∀ w : G, w ∈ P → orderOf w = 2 → w ∉ W →
    ∀ l : G, l ∈ W → orderOf l = 2 →
      ¬ ∃ a : C, (a : G) * w * (a : G)⁻¹ = l := by
  intro N K X D A hCD v hv hfix W C P w hw hw2 hwW l hl hl2
  rintro ⟨a, ha⟩
  let V := N ⊓ C
  let S := V ⊓ centralizer ({w} : Set G)
  obtain ⟨hSe, hSc, hSat⟩ := d.normalizer_fixed_outer_saturation h hN hproper Q v hv hfix
    w hw hw2 hwW
  have hSC : S ≤ C := inf_le_left.trans inf_le_right
  let B := S.subgroupOf C
  have hSp : IsPGroup 2 S := IsPGroup.of_card (n := 5) (hSc.trans (by decide))
  have hBC : B ≤ centralizer ({(⟨w, hw.2⟩ : C)} : Set C) := by
    intro s hs
    exact mem_centralizer_singleton_iff.mpr (Subtype.ext
      (mem_centralizer_singleton_iff.mp hs.2))
  have hmax : ∀ R : Subgroup C, IsPGroup 2 R → B ≤ R →
      R ≤ centralizer ({(⟨w, hw.2⟩ : C)} : Set C) → R = B := by
    intro R hRp hBR hRC
    apply map_injective C.subtype_injective
    rw [map_subgroupOf_eq_of_le hSC]
    apply hSat _ (hRp.map C.subtype)
    · change S ≤ _
      rw [← map_subgroupOf_eq_of_le hSC]
      exact map_mono hBR
    · rintro x ⟨r, hr, rfl⟩
      exact ⟨r.property, mem_centralizer_singleton_iff.mpr
        (congrArg C.subtype (mem_centralizer_singleton_iff.mp (hRC hr)))⟩
  let L := V ⊓ centralizer ({l} : Set G)
  have hLc : 128 ≤ Nat.card L :=
    d.normalizer_fixed_omega_centralizer_lower_bound h hN hproper Q hCD v hv hfix l hl hl2
  have hLdiv : Nat.card L ∣ 1536 :=
    (card_dvd_of_le (show L ≤ V from inf_le_left)).trans
      (by rw [(d.normalizer_fixed_local_image_structure h hN hproper Q v hv hfix).1])
  obtain ⟨T, hTc⟩ := Sylow.exists_subgroup_card_pow_prime (G := L) 2
    (show 2 ^ 6 ∣ Nat.card L from sixtyfour_dvd_of_dvd_1536 _ hLdiv hLc)
  let f : L →* C := inclusion (show L ≤ C from inf_le_left.trans inf_le_right)
  let U := T.map f
  have hUc : Nat.card U = 64 := (card_map_of_injective (inclusion_injective _)).trans hTc
  have hlC : l ∈ C :=
    (d.normalizer_fixed_local_image_structure h hN hproper Q v hv hfix).2.1 hl |>.2
  have hUC : U ≤ centralizer ({(⟨l, hlC⟩ : C)} : Set C) := by
    rintro x ⟨t, ht, rfl⟩
    exact mem_centralizer_singleton_iff.mpr (Subtype.ext
      (mem_centralizer_singleton_iff.mp t.property.2))
  have hc := card_le_of_isConj_of_saturated_centralizer (⟨w, hw.2⟩ : C) (⟨l, hlC⟩ : C)
    (isConj_iff.mpr ⟨a, Subtype.ext ha⟩) B hSp.comap_subtype hBC hmax U
    (IsPGroup.of_card (n := 6) hUc) hUC
  have hBc : Nat.card B = 32 :=
    (Nat.card_congr (subgroupOfEquivOfLe hSC).toEquiv).trans hSc
  rw [hUc, hBc] at hc
  omega


/-- Thompson transfer gives an index-two normal subgroup of the ambient
centralizer whose intersection with the local Sylow subgroup is exactly omega. -/
public theorem second_centralizer_index_two
    (d : ParrottSecondElementaryData z)
    (h : ParrottCentralizerHypotheses z) (hN : IsNTwoGroup G)
    (hproper : (d.sylow : Subgroup G) < normalizer (d.F : Set G))
    (Q : Sylow 3 (normalizer (d.F : Set G))) :
    let N := normalizer (d.F : Set G)
    let K := pCore 2 N
    let X := K.map N.subtype
    let D := (commutator X).map X.subtype
    let A := (Q : Subgroup N).map N.subtype
    X ⊓ centralizer (A : Set G) ≤ D →
    ∀ v : G, orderOf v = 2 → d.F ⊓ centralizer (A : Set G) = zpowers v →
    let W := (omega₁ K (p := 2)).map (N.subtype.comp K.subtype)
    let C := centralizer ({v} : Set G)
    let P := (d.sylow : Subgroup G) ⊓ C
    ∃ M : Subgroup C, M.Normal ∧ M.index = 2 ∧
      M.map C.subtype ⊓ P = W ∧
      (∃ S : Sylow 2 M, (S : Subgroup M).map (C.subtype.comp M.subtype) = W) := by
  classical
  intro N K X D A hCD v hv hfix W C P
  obtain ⟨R, hR⟩ := d.normalizer_fixed_sylow_ambient_position h hN hproper Q v hv hfix
  change (R : Subgroup C).map C.subtype = P at hR
  have hWP : W ≤ P :=
    (d.normalizer_fixed_sylow_local_position h hN hproper Q v hv hfix).1
  let f : R →* G := C.subtype.comp (R : Subgroup C).subtype
  have hf : Function.Injective f := C.subtype_injective.comp (R : Subgroup C).subtype_injective
  let U : Subgroup R := W.comap f
  have hfRange : f.range = P := by
    rw [MonoidHom.range_comp, range_subtype]
    exact hR
  have hmapU : U.map f = W := by
    rw [map_comap_eq, hfRange, inf_eq_right.mpr hWP]
  have hUc : Nat.card U = 256 := by
    rw [← card_map_of_injective hf, hmapU]
    exact (card_map_of_injective (f := N.subtype.comp K.subtype)
      (N.subtype_injective.comp K.subtype_injective)).trans
      (d.normalizer_core_omega_structure h hN hproper).1
  have hRc : Nat.card R = 512 := by
    rw [← card_map_of_injective C.subtype_injective, hR]
    exact d.normalizer_fixed_sylow_card h hN hproper Q v hv hfix
  have hUi : U.index = 2 := by
    have hc := U.index_mul_card
    rw [hUc, hRc] at hc
    omega
  have hgen : U ≤ closure {x : R | x ∈ U ∧ x ^ 2 = 1} := by
    let B := closure {x : R | x ∈ U ∧ x ^ 2 = 1}
    have hWB : W ≤ B.map f := by
      apply map_le_iff_le_comap.mpr
      apply (closure_le _).mpr
      intro k hk
      have hkW : (N.subtype.comp K.subtype) k ∈ W :=
        mem_map_of_mem _ (subset_closure hk)
      have hkm : (N.subtype.comp K.subtype) k ∈ (R : Subgroup C).map C.subtype := by
        rw [hR]
        exact hWP hkW
      obtain ⟨r, hr, he⟩ := hkm
      let x : R := ⟨r, hr⟩
      have hx : f x = (N.subtype.comp K.subtype) k := he
      refine ⟨x, subset_closure ⟨?_, ?_⟩, hx⟩
      · change f x ∈ W
        rwa [hx]
      · apply hf
        rw [map_pow, map_one, hx, ← map_pow]
        have hk2 : k ^ 2 = 1 := by simpa using hk
        rw [hk2, map_one]
    intro x hx
    obtain ⟨y, hy, he⟩ := hWB hx
    exact hf he ▸ hy
  have hclosed : ∀ x y : R, orderOf x = 2 → IsConj (x : C) (y : C) →
      (x ∈ U ↔ y ∈ U) := by
    intro x y hx hxy
    have hx2 : orderOf (f x) = 2 := (orderOf_injective f hf x).trans hx
    have hy2 : orderOf (f y) = 2 := by
      have hy : orderOf y = 2 := by
        obtain ⟨a, ha⟩ := isConj_iff.mp hxy
        rw [← Subgroup.orderOf_coe, ← ha]
        exact ((MulAut.conj a).orderOf_eq (x : C)).trans ((Subgroup.orderOf_coe x).trans hx)
      exact (orderOf_injective f hf y).trans hy
    have hxP : f x ∈ P := hR ▸ mem_map_of_mem C.subtype x.property
    have hyP : f y ∈ P := hR ▸ mem_map_of_mem C.subtype y.property
    constructor
    · intro hxU
      by_contra hyU
      obtain ⟨a, ha⟩ := isConj_iff.mp hxy.symm
      exact d.normalizer_fixed_outer_not_fused_into_omega h hN hproper Q hCD v hv hfix
        (f y) hyP hy2 hyU (f x) hxU hx2 ⟨a, congrArg C.subtype ha⟩
    · intro hyU
      by_contra hxU
      obtain ⟨a, ha⟩ := isConj_iff.mp hxy
      exact d.normalizer_fixed_outer_not_fused_into_omega h hN hproper Q hCD v hv hfix
        (f x) hxP hx2 hxU (f y) hyU hy2 ⟨a, congrArg C.subtype ha⟩
  obtain ⟨w, hwP, hw2, hwW, _⟩ :=
    d.exists_normalizer_fixed_outer_involution_inverting_three h hN hproper Q v hv hfix
  change w ∈ P at hwP
  have hwm : w ∈ (R : Subgroup C).map C.subtype := by rwa [hR]
  obtain ⟨r, hr, he⟩ := hwm
  let wR : R := ⟨r, hr⟩
  have hwR : f wR = w := he
  obtain ⟨M, hMn, hMi, hMU⟩ := R.exists_normal_index_two_of_involution_fusion U hUi hgen hclosed
    wR ((orderOf_injective f hf wR).symm.trans ((congrArg orderOf hwR).trans hw2))
    (fun hh => hwW (hwR ▸ hh))
  have hinter : M.map C.subtype ⊓ P = W := by
    rw [← hmapU, ← hMU, show f = C.subtype.comp (R : Subgroup C).subtype from rfl,
      ← map_map, subgroupOf_map_subtype, Subgroup.map_inf _ _ _ C.subtype_injective, hR]
  let g : M →* G := C.subtype.comp M.subtype
  let B := W.comap g
  have hg : Function.Injective g := C.subtype_injective.comp M.subtype_injective
  have hWrange : W ≤ g.range := by
    rw [MonoidHom.range_comp, range_subtype, ← hinter]
    exact inf_le_left
  have hBg : B.map g = W := map_comap_eq_self hWrange
  have hBc : Nat.card B = 256 := by
    rw [← card_map_of_injective hg, hBg, ← hmapU, card_map_of_injective hf, hUc]
  have hBi : B.index = (R : Subgroup C).index := by
    have hMC := M.index_mul_card
    have hBC := B.index_mul_card
    have hRC := (R : Subgroup C).index_mul_card
    rw [hMi] at hMC
    rw [hBc] at hBC
    rw [hRc] at hRC
    omega
  have hBp : IsPGroup 2 B := IsPGroup.of_card (n := 8) hBc
  exact ⟨M, hMn, hMi, hinter, hBp.toSylow (by rw [hBi]; exact R.not_dvd_index), hBg⟩

end Stellmacher.Recognition.ParrottSecondElementaryData
