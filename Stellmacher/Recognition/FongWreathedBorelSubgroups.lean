module

public import Stellmacher.Recognition.FongWreathedBorelData
public import Stellmacher.Recognition.FongWreathedInvertedThree
public import Stellmacher.Recognition.FongWreathedThreeOddCore
public import Theory.GroupTheory.OrderThreeNormalizer
public import Theory.GroupTheory.CentralizerOddCore

/-!
# Assembly of Fong's Borel subgroup witnesses

For an order-three element inverted by the specified `F`, the normalizer
is generated by `F` and its centralizer. Its centralizer's odd core is
preserved by that normalizer, and contains the element centrally. Thus
the local order-three seed and the order-27 odd-core calculation assemble
into the exact `BorelSubgroups` contract. The final theorem constructs these
witnesses from the wreathed Sylow, involution-centralizer, group-order and
character hypotheses.

Source: Fong, J. Algebra 6 (1967), p.75, final paragraph.
-/

namespace Stellmacher.Recognition.FongWreathed

variable {G : Type*} [Group G] {S : Sylow 2 G}
variable (P : ABG.Wreathed.Presentation S 2)

/-- Assemble the subgroup witnesses from the canonical odd core of `C_G(R)`.
The order-three element and the two local centralizer facts remain inputs. -/
public theorem nonempty_borelSubgroups_of_oddCore
    (R : G) (hR : orderOf R = 3)
    (hFR : (F P)⁻¹ * R * F P = R⁻¹)
    (hQ : Nat.card (pPrimeCore 2 (Subgroup.centralizer ({R} : Set G))) = 27)
    (hC : Subgroup.centralizer ({R} : Set G) =
      Subgroup.zpowers (F P ^ 2) ⊔
        (pPrimeCore 2 (Subgroup.centralizer ({R} : Set G))).map
          (Subgroup.centralizer ({R} : Set G)).subtype) :
    Nonempty (BorelSubgroups P) := by
  let C := Subgroup.centralizer ({R} : Set G)
  let Q := (pPrimeCore 2 C).map C.subtype
  let B := Subgroup.normalizer (Subgroup.zpowers R : Set G)
  have hRQ : R ∈ Q := Subgroup.mem_pPrimeCore_centralizer 2 R (by rw [hR]; decide)
  have hQle : Q ≤ C := Subgroup.map_subtype_le _
  have hRZ : R ∈ (Subgroup.center Q).map Q.subtype := by
    refine ⟨⟨R, hRQ⟩, Subgroup.mem_center_iff.mpr (fun q => ?_), rfl⟩
    exact Subtype.ext (Subgroup.mem_centralizer_singleton_iff.mp (hQle q.property))
  have hB : B = Subgroup.zpowers (F P) ⊔ Q := by
    calc
      B = Subgroup.zpowers (F P) ⊔ C :=
        Subgroup.normalizer_zpowers_order_three R (F P) hR hFR
      _ = Subgroup.zpowers (F P) ⊔ (Subgroup.zpowers (F P ^ 2) ⊔ Q) :=
        congrArg (Subgroup.zpowers (F P) ⊔ ·) hC
      _ = Subgroup.zpowers (F P) ⊔ Q := by
        rw [← sup_assoc, sup_eq_left.mpr (Subgroup.zpowers_le.mpr
          ((Subgroup.zpowers (F P)).pow_mem (Subgroup.mem_zpowers _) 2))]
  exact ⟨{
    R := R
    Q := Q
    B := B
    order_R := hR
    card_Q := (Subgroup.card_map_of_injective C.subtype_injective).trans hQ
    R_mem_center := hRZ
    F_inverts_R := hFR
    centralizer_R := hC
    normalizer_R := rfl
    B_eq := hB
    Q_normalized := Subgroup.normalizer_le_normalizer_pPrimeCore_centralizer 2 R
  }⟩

/-- Fong's Borel subgroup witnesses under the full local and character hypotheses.
The element `R` is the lifted three-cycle inverted by the fixed `F`; `Q` is
the odd core of its centralizer, and `B` is the normalizer of `⟨R⟩`. -/
public theorem nonempty_borelSubgroups [Finite G] [IsSimpleGroup G]
    (hS : ABG.IsWreathedOfHeight S 2) (x : G) (hx : orderOf x = 2)
    [Group.IsSolvable (Subgroup.centralizer ({x} : Set G))]
    (hG : Nat.card G = 6048) (c : CharacterData P) :
    Nonempty (BorelSubgroups P) := by
  obtain ⟨R, hR, hFR, T, hT⟩ := exists_inverted_three P hS x hx hG c
  obtain ⟨hQ, hC⟩ := centralizer_three_oddCore_data P hS x hx hG c R hR hFR T hT
  exact nonempty_borelSubgroups_of_oddCore P R hR hFR hQ hC

end Stellmacher.Recognition.FongWreathed
