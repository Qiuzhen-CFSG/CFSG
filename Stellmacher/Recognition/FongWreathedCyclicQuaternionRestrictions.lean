module

public import Stellmacher.Recognition.FongWreathedFusion
public import Theory.Character.OrderEightRestriction

/-!
# Fong's cyclic and quaternion restriction numerators

The cyclic subgroup generated by `F` has order eight and `F⁴ = J`.
Its faithful linear pairing therefore gives `8 ∣ d - a`. The subgroup
`⟨EF, XF²⟩` is the ABG quaternion core. The full quaternion normalizer
action fuses its six order-four elements to `XF²`, and involution fusion
sends its unique involution to `J`. Its principal pairing gives
`8 ∣ d + a + 6b`.

The combined result takes the supplied orientation and an actual
integral-valued character. No exceptional-character existence assumption is
needed. In fact these two particular numerators are orientation independent.

Source: P. Fong, *Some Sylow subgroups of order 32 and a characterization
of U(3,3)*, J. Algebra 6 (1967), printed p. 73, the first two restriction
calculations. Quaternion fusion is ABG II.1's canonical normalizer action.
-/

noncomputable section
open scoped BigOperators
attribute [local instance] Fintype.ofFinite
namespace Stellmacher.Recognition.FongWreathedIntrinsic
open ABG
variable {G : Type*} [Group G] [Finite G] [IsSimpleGroup G]
  (S : Sylow 2 G) (P : Wreathed.Presentation S 2)

private theorem core_order_four_fusion (x : P.quaternionCore) (hx : orderOf x = 4) :
    IsConj ((x : S) : G) ((X P * F P ^ 2 : S) : G) := by
  let Q := P.quaternionCore.map (S : Subgroup G).subtype
  have hr : P.r ∈ P.quaternionCore := by
    apply Subgroup.subset_closure
    simp
  have hb : X P * F P ^ 2 ∈ P.quaternionCore := by
    rw [XF_sq_eq_r_inv]
    exact P.quaternionCore.inv_mem hr
  let a : Q := ⟨((x : S) : G), Subgroup.mem_map_of_mem _ x.property⟩
  let b : Q := ⟨((X P * F P ^ 2 : S) : G), Subgroup.mem_map_of_mem _ hb⟩
  obtain ⟨e₀⟩ := P.quaternion_core_model.1
  let e : Q ≃* QuaternionGroup 2 :=
    (P.quaternionCore.equivMapOfInjective (S : Subgroup G).subtype
      (S : Subgroup G).subtype_injective).symm.trans e₀
  have ha4 : orderOf a = 4 := by
    rw [← Subgroup.orderOf_coe]
    exact (Subgroup.orderOf_coe (x : S)).trans ((Subgroup.orderOf_coe x).trans hx)
  have hb4 : orderOf b = 4 := by
    rw [← Subgroup.orderOf_coe]
    exact (Subgroup.orderOf_coe (X P * F P ^ 2)).trans (XF_sq_orderOf P)
  obtain ⟨f, hf⟩ := QuaternionGroup.exists_mulAut_eq_of_orderOf_eq_four (e a) (e b)
    ((e.orderOf_eq a).trans ha4) ((e.orderOf_eq b).trans hb4)
  let alpha : MulAut Q := (MulAut.congr e.symm) f
  have hab : alpha a = b := by
    change e.symm (f (e a)) = b
    rw [hf, e.symm_apply_apply]
  obtain ⟨g, _, hg⟩ := Wreathed.canonical_v_restriction_surjective S P
    (qdPattern S P).2.2.2 alpha
  apply isConj_iff.mpr
  refine ⟨g, ?_⟩
  have hh := hg a
  rw [hab] at hh
  exact hh

omit [Finite G] [IsSimpleGroup G] in
private theorem character_eq_of_isConj {χ : ClassFunction G} (hχ : IsCharacter χ)
    {x y : G} (h : IsConj x y) : χ x = χ y := by
  obtain ⟨n, ρ, rfl⟩ := hχ
  obtain ⟨g, rfl⟩ := isConj_iff.mp h
  exact (ρ.char_conj x g).symm

/-- The quaternion principal restriction gives the second numerator on
Fong's p. 73. Its six order-four elements all fuse to `XF²`. -/
public theorem quaternion_restriction_numerator {χ : ClassFunction G} (hχ : IsCharacter χ)
    (d a b : ℤ) (hd : χ 1 = (d : ℂ)) (ha : χ (J P : S) = (a : ℂ))
    (hb : χ (X P * F P ^ 2 : S) = (b : ℂ)) :
    (8 : ℤ) ∣ d + a + 6 * b := by
  classical
  obtain ⟨e⟩ := P.quaternion_core_model.1
  let f : QuaternionGroup 2 →* G := (S : Subgroup G).subtype.comp
    (P.quaternionCore.subtype.comp e.symm.toMonoidHom)
  have hf : Function.Injective f := (S : Subgroup G).subtype_injective.comp
    (P.quaternionCore.subtype_injective.comp e.symm.injective)
  have htwo (x : QuaternionGroup 2) (hx : orderOf x = 2) : χ (f x) = (a : ℂ) := by
    apply (character_eq_of_isConj hχ (isConj_involution_J S P (f x) ?_)).trans ha
    exact (orderOf_injective f hf x).trans hx
  have hfour (x : QuaternionGroup 2) (hx : orderOf x = 4) : χ (f x) = (b : ℂ) := by
    apply (character_eq_of_isConj hχ (core_order_four_fusion S P (e.symm x) ?_)).trans hb
    exact (e.symm.orderOf_eq x).trans hx
  exact hχ.eight_dvd_quaternion_restriction_sum f d a b hd htwo hfour

/-- Fong's subgroup generated by `EF` and `XF²` is the ABG quaternion core. -/
public theorem quaternion_restriction_subgroup_eq_core
    {T : Type*} [Group T] (P : ABG.Wreathed.Presentation T 2) :
    Subgroup.closure ({E P * F P, X P * F P ^ 2} : Set T) = P.quaternionCore := by
  have hef : E P * F P = P.d := by
    change P.s * (P.s * P.z) = P.s ^ 2 * P.z
    simp only [pow_two, mul_assoc]
  have hx : X P * F P ^ 2 = P.r⁻¹ := by
    apply eq_inv_of_mul_eq_one_left
    rw [F_sq, mul_assoc, P.u_mul_r]
    change P.s ^ 2 * P.s ^ 2 = 1
    rw [← pow_add]
    exact P.s_pow
  rw [hef, hx]
  change Subgroup.closure ({P.d, P.r⁻¹} : Set T) =
    Subgroup.closure ({P.r ^ 1, P.d} : Set T)
  rw [pow_one]
  apply le_antisymm <;> apply (Subgroup.closure_le _).mpr
  · intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact Subgroup.subset_closure (by simp)
    · rw [Set.mem_singleton_iff] at hx
      subst x
      exact Subgroup.inv_mem _ (Subgroup.subset_closure (by simp))
  · intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · change P.r ∈ Subgroup.closure ({P.d, P.r⁻¹} : Set T)
      simpa only [inv_inv] using
        (Subgroup.closure ({P.d, P.r⁻¹} : Set T)).inv_mem
          (Subgroup.subset_closure (by simp : P.r⁻¹ ∈ ({P.d, P.r⁻¹} : Set T)))
    · rw [Set.mem_singleton_iff] at hx
      subst x
      exact Subgroup.subset_closure (by simp)

omit [Finite G] [IsSimpleGroup G] in
/-- The faithful cyclic restriction gives the first numerator on Fong's p. 73. -/
public theorem cyclic_restriction_numerator {χ : ClassFunction G}
    (hχ : IsCharacter χ) (hint : ∀ g, ∃ z : ℤ, χ g = (z : ℂ))
    (d a : ℤ) (hd : χ 1 = (d : ℂ)) (ha : χ (J P : S) = (a : ℂ)) :
    (8 : ℤ) ∣ d - a := by
  have hpow : ((F P : S) : G) ^ 8 = 1 := by
    rw [← Subgroup.coe_pow, ← F_orderOf P, pow_orderOf_eq_one, Subgroup.coe_one]
  exact hχ.eight_dvd_degree_sub_fourth_power ((F P : S) : G) hpow hint d a hd
    (by simpa only [← Subgroup.coe_pow, F_four] using ha)

/-- Both order-eight restriction numerators for an integral-valued actual
character, under the supplied oriented-presentation contract. -/
public theorem cyclic_quaternion_restriction_numerators (_ho : BaseOrientation S P)
    {χ : ClassFunction G} (hχ : IsCharacter χ)
    (hint : ∀ g, ∃ z : ℤ, χ g = (z : ℂ))
    (d a b : ℤ) (hd : χ 1 = (d : ℂ)) (ha : χ (J P : S) = (a : ℂ))
    (hb : χ (X P * F P ^ 2 : S) = (b : ℂ)) :
    (8 : ℤ) ∣ d - a ∧ (8 : ℤ) ∣ d + a + 6 * b := by
  exact ⟨cyclic_restriction_numerator S P hχ hint d a hd ha,
    quaternion_restriction_numerator S P hχ d a b hd ha hb⟩

end Stellmacher.Recognition.FongWreathedIntrinsic
