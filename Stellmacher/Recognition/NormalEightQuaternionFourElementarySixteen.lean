module
public import Stellmacher.Recognition.NormalEightQuaternionFourElementarySetup
public import Stellmacher.Recognition.NormalEightQuaternionFourNonElementary
public import Theory.GroupTheory.QuaternionElementarySixteenFixedEight
public import Stellmacher.Recognition.NormalEightQuaternionDihedralFusion
public import Theory.GroupTheory.SaturatedCentralizerNonfusion
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.GroupTheory.SaturatedCentralizerCard
public import Theory.GroupTheory.PGroup.ExtraspecialCentralProduct

/-!
# The final elementary-sixteen centralizer exclusion

An elementary centralizer of order sixteen contains an involution outside the
subgroup generated by the distinguished four and the original outside
involution. The quaternion action calculation shows that this second
involution fixes a nonabelian eight in the core. Local conjugacy preserves
its type and saturates its centralizer in the central-omega normalizer. The characteristic derived-center line promotes saturation to the
full element centralizer. Its order is at most thirty-two, whereas fusion into
the distinguished four forces order at least sixty-four.

For the fixed-eight calculation, an elementary fixed eight is normal and
violates the normal elementary rank bound. A second fixed four would give
commuting outer involutions on both quaternion factors, whose product acts
inner on the core; self-centrality then contradicts the choice of the second
outside coset.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, case (b)(ii), printed p.391.
-/

open Subgroup
open Stellmacher.Recognition.NormalFourCentralOmegaTwo
namespace Stellmacher.Recognition.NormalEightNonnormalImage
variable {G : Type*} [Group G] [Finite G]

/-- An elementary centralizer of order sixteen contains a second outside
involution beyond the subgroup generated by the normal four and the first one. -/
public theorem quaternion_four_elementary_sixteen_second_involution
    (S : Sylow 2 G) (W : Subgroup S) [W.Normal] (hW : Nat.card W = 4)
    (t : S) (ht : orderOf t = 2)
    (hE : IsElementaryAbelian 2 (centralizer ({t} : Set S)))
    (hcard : Nat.card (centralizer ({t} : Set S)) = 16)
    (hfixedW : omegaCorePreimage S ⊓ centralizer ({t} : Set S) = W) :
    ∃ j : S, orderOf j = 2 ∧ j ∈ centralizer ({t} : Set S) ∧
      j ∉ W ⊔ zpowers t ∧ j ∉ omegaCorePreimage S := by
  let E := centralizer ({t} : Set S)
  let : IsElementaryAbelian 2 E := hE
  have hsmall : Nat.card (W ⊔ zpowers t : Subgroup S) ≤ 8 := by
    have hh := card_mul_eq_card_inf_mul_card_sup_of_normalizes W (zpowers t)
      (by rw [W.normalizer_eq_top]; exact le_top)
    rw [hW, Nat.card_zpowers, ht] at hh
    have hp : 0 < Nat.card (W ⊓ zpowers t : Subgroup S) := Nat.card_pos
    nlinarith
  have hn : ¬ E ≤ W ⊔ zpowers t := by
    intro h
    have hh := card_le_of_le h
    change Nat.card E = 16 at hcard
    rw [hcard] at hh
    omega
  obtain ⟨j, hjE, hjout⟩ := SetLike.not_le_iff_exists.mp hn
  have hjne : j ≠ 1 := fun hh => hjout (hh ▸ one_mem _)
  have hj2 : j ^ 2 = 1 := by
    have hh := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 E) (⟨j, hjE⟩ : E)
    exact congrArg (fun x : E => (x : S)) hh
  refine ⟨j, orderOf_eq_prime hj2 hjne, hjE, hjout, ?_⟩
  intro hjP
  apply hjout
  apply (show W ≤ W ⊔ zpowers t from le_sup_left)
  rw [← hfixedW]
  exact ⟨hjP, hjE⟩

/-- A nonabelian fixed eight contradicts involution fusion into the normal four
when the core has index four. Local saturation is promoted using its derived
center, without assuming the whole common centralizer is a two-group. -/
public theorem quaternion_four_false_of_nonabelian_fixed_eight_and_cover
    (hN : IsNTwoGroup G) (S : Sylow 2 G)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (hno : ¬ ∃ F : Subgroup S, F.Normal ∧ IsElementaryAbelian 2 F ∧ 8 ≤ Nat.card F)
    (W : Subgroup S) [W.Normal] [IsElementaryAbelian 2 W] (hW : Nat.card W = 4)
    [IsExtraspecial 2 (pCore 2 (OmegaQuotient S))]
    (hH : Nat.card (pCore 2 (OmegaQuotient S)) = 32)
    [IsMulCommutative (S ⧸ omegaCorePreimage S)]
    (hindex : (omegaCorePreimage S).index = 4)
    (z : S) (hz : orderOf z = 2) (hzc : z ∈ center S)
    (hcover : ∀ u : S, orderOf u = 2 →
      ∃ w : S, w ∈ W ∧ IsConj (u : G) (w : G))
    (l : S) (hl : orderOf l = 2)
    (hlna : ¬ IsMulCommutative
      (omegaCorePreimage S ⊓ centralizer ({l} : Set S) : Subgroup S))
    (hlcard : Nat.card (omegaCorePreimage S ⊓ centralizer ({l} : Set S) : Subgroup S) = 8) :
    False := by
  obtain ⟨x, hx, hxna, hxcard, _, _, hlocal⟩ :=
    exists_fixed_eight_with_saturated_local_centralizer S hH l hl hlna hlcard
  let P := omegaCorePreimage S
  let E := centralizer ({x} : Set S)
  let F := P.subgroupOf E
  let e : F ≃* (P ⊓ E : Subgroup S) :=
    (F.equivMapOfInjective E.subtype E.subtype_injective).trans
      (MulEquiv.subgroupCongr (subgroupOf_map_subtype P E))
  have hFcard : Nat.card F = 8 := (Nat.card_congr e.toEquiv).trans hxcard
  let : IsExtraspecial 2 (P ⊓ E : Subgroup S) :=
    IsExtraspecial.of_noncommutative_card_eight hxcard hxna
  let : IsExtraspecial 2 F := IsExtraspecial.of_mulEquiv e.symm inferInstance
  have hline := omegaCorePreimage_centralizer_derived_inf_center_line
    hN S hZ hno W hW z x hz hzc
  let D := E.map (S : Subgroup G).subtype
  have hnorm : normalizer (D : Set G) ≤ centralizer ({(z : G)} : Set G) :=
    normalizer_image_le_centralizer_of_derived_center_line
      (S : Subgroup G).subtype (S : Subgroup G).subtype_injective E z hz hline
  have hmax : ∀ V : Subgroup G, IsPGroup 2 V → D ≤ V →
      V ≤ centralizer ({(x : G)} : Set G) → V = D := by
    apply saturated_of_normalizer_control D (omegaNormalizer S)
    · intro V hp hDV hVC
      exact hlocal V hp hDV (hVC.trans inf_le_left) (hVC.trans inf_le_right)
    · rw [omegaNormalizer_eq_centralizer_of_central_involution S hZ z hz hzc]
      exact inf_le_left.trans hnorm
  have hEcard : Nat.card E ≤ 32 := by
    have hrel : P.relIndex E ≤ 4 := Nat.le_of_dvd (by decide)
      (hindex ▸ relIndex_dvd_index_of_normal P E)
    have hm := F.card_mul_index
    change Nat.card F * P.relIndex E = Nat.card E at hm
    rw [hFcard] at hm
    omega
  have hCcard : Nat.card (centralizer (W : Set S)) = 64 := by
    have hi := centralizer_index_eq_two_of_normal_four_of_card_omega_one_center_eq_two
      S.isPGroup' hZ W hW
    have hh := (centralizer (W : Set S)).card_mul_index
    rw [hi, sylow_card_eq_one_twenty_eight_of_quaternion_core_index_four S hH hindex] at hh
    omega
  obtain ⟨w, hw, hxw⟩ := hcover x hx
  let U := (centralizer (W : Set S)).map (S : Subgroup G).subtype
  have hUC : U ≤ centralizer ({(w : G)} : Set G) := by
    rintro _ ⟨s, hs, rfl⟩
    exact mem_centralizer_singleton_iff.mpr
      (congrArg (fun a : S => (a : G)) (hs w hw).symm)
  have hDC : D ≤ centralizer ({(x : G)} : Set G) := by
    dsimp only [D, E]
    rw [map_subtype_centralizer_singleton]
    exact inf_le_right
  have hh := card_le_of_isConj_of_saturated_centralizer (x : G) (w : G) hxw
    D ((S.isPGroup'.to_subgroup E).map _) hDC hmax U
    ((S.isPGroup'.to_subgroup _).map _) hUC
  have hUcard : Nat.card U = 64 :=
    (card_map_of_injective (S : Subgroup G).subtype_injective).trans hCcard
  have hDcard : Nat.card D = Nat.card E :=
    card_map_of_injective (S : Subgroup G).subtype_injective
  rw [hUcard, hDcard] at hh
  omega

/-- An elementary centralizer of order sixteen is incompatible with involution
fusion into the distinguished normal four. The second outside involution has
nonabelian fixed eight, whose saturated centralizer is too small for this fusion. -/
public theorem quaternion_four_false_of_elementary_sixteen_and_cover
    (hN : IsNTwoGroup G) (S : Sylow 2 G)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (hno : ¬ ∃ F : Subgroup S, F.Normal ∧ IsElementaryAbelian 2 F ∧ 8 ≤ Nat.card F)
    (W : Subgroup S) [W.Normal] [IsElementaryAbelian 2 W] (hW : Nat.card W = 4)
    [IsExtraspecial 2 (pCore 2 (OmegaQuotient S))]
    (hH : Nat.card (pCore 2 (OmegaQuotient S)) = 32)
    (B C : Subgroup (pCore 2 (OmegaQuotient S)))
    (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hjoin : B ⊔ C = ⊤) (hinter : Nat.card (B ⊓ C : Subgroup _) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b * c = c * b)
    (z t : S) (hz : orderOf z = 2) (hzc : z ∈ center S)
    (ht : orderOf t = 2) (hout : t ∉ omegaCorePreimage S)
    (hindex : (omegaCorePreimage S).index = 4)
    (hquot : IsElementaryAbelian 2 (S ⧸ omegaCorePreimage S))
    (hfixedW : omegaCorePreimage S ⊓ centralizer ({t} : Set S) = W)
    (hEelem : IsElementaryAbelian 2 (centralizer ({t} : Set S)))
    (hEcard : Nat.card (centralizer ({t} : Set S)) = 16)
    (hcover : ∀ u : S, orderOf u = 2 →
      ∃ w : S, w ∈ W ∧ IsConj (u : G) (w : G)) : False := by
  let := hquot
  obtain ⟨j, hj, hjt, hjW, hjout⟩ :=
    quaternion_four_elementary_sixteen_second_involution S W hW t ht hEelem hEcard hfixedW
  let H := omegaCorePreimage S
  let e := omegaCorePreimageEquiv S
  let : IsExtraspecial 2 H := IsExtraspecial.of_mulEquiv e.symm inferInstance
  let B' := B.map e.symm.toMonoidHom
  let C' := C.map e.symm.toMonoidHom
  have hB' : Nonempty (B' ≃* QuaternionGroup 2) := by
    obtain ⟨f⟩ := hB
    exact ⟨(B.equivMapOfInjective e.symm.toMonoidHom e.symm.injective).symm.trans f⟩
  have hC' : Nonempty (C' ≃* QuaternionGroup 2) := by
    obtain ⟨f⟩ := hC
    exact ⟨(C.equivMapOfInjective e.symm.toMonoidHom e.symm.injective).symm.trans f⟩
  have hjoin' : B' ⊔ C' = ⊤ := by
    rw [← Subgroup.map_sup, hjoin, map_top_of_surjective _ e.symm.surjective]
  have hinter' : Nat.card (B' ⊓ C' : Subgroup H) = 2 := by
    rw [← map_inf B C e.symm.toMonoidHom e.symm.injective,
      card_map_of_injective e.symm.injective]
    exact hinter
  have hcomm' : ∀ b ∈ B', ∀ c ∈ C', b * c = c * b := by
    rintro _ ⟨b, hb, rfl⟩ _ ⟨c, hc, rfl⟩
    simpa only [map_mul] using congrArg e.symm.toMonoidHom (hcomm b hb c hc)
  obtain ⟨hjna, hjcard⟩ := quaternion_elementary_sixteen_second_fixed_eight
    S.isPGroup' H ((card_omegaCorePreimage S).trans hH)
    (omegaCorePreimage_centralizer_le hN S hZ) hindex hquot hno
    B' C' hB' hC' hjoin' hinter' hcomm' W hW t ht hout hEelem hEcard hfixedW
    j hj hjt hjW hjout
  exact quaternion_four_false_of_nonabelian_fixed_eight_and_cover
    hN S hZ hno W hW hH hindex z hz hzc hcover j hj hjna hjcard

end Stellmacher.Recognition.NormalEightNonnormalImage
