module

public import Stellmacher.Recognition.NormalEightQuaternionAbelianSetup
public import Theory.GroupTheory.SaturatedCentralizerNonfusion
public import Theory.GroupTheory.QuaternionOuterInvolutionFixed

/-!
# The non-elementary fixed-core quaternion branch

The core preimage is self-centralizing, since it maps isomorphically onto the
self-centralizing two-core of the local quotient. Once its involution fixed
subgroup is extraspecial, the full Sylow centralizer has characteristic
derived-center line generated by the original central involution. Saturation
in the common centralizer then excludes fusion with the outside involution.

The intrinsic quaternion action calculation identifies a non-elementary fixed
subgroup as extraspecial. Transporting the quaternion factors from the quotient
core therefore discharges the structural premise of the fusion reduction.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, case (b)(i), printed p.391.
-/

open Subgroup
open Stellmacher.Recognition.NormalFourCentralOmegaTwo

namespace Stellmacher.Recognition.NormalEightNonnormalImage

variable {G : Type*} [Group G] [Finite G]

/-- Self-centrality of the quotient core lifts to its Sylow preimage. -/
public theorem omegaCorePreimage_centralizer_le
    (hN : IsNTwoGroup G) (S : Sylow 2 G)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2) :
    centralizer (omegaCorePreimage S : Set S) ≤ omegaCorePreimage S := by
  intro s hs
  apply omegaQuotient_centralizer_pCore_le hN S hZ
  intro x hx
  rw [← omegaCorePreimage_map S] at hx
  obtain ⟨k, hk, rfl⟩ := hx
  simpa only [map_mul] using congrArg (omegaQuotientHom S) (hs k hk)

/-- The characteristic fixed-core line excludes a saturated outside conjugate. -/
public theorem quaternion_four_false_of_extraspecial_fixed_core
    (hN : IsNTwoGroup G) (S : Sylow 2 G)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (hno : ¬ ∃ F : Subgroup S, F.Normal ∧ IsElementaryAbelian 2 F ∧ 8 ≤ Nat.card F)
    (W : Subgroup S) [W.Normal] [IsElementaryAbelian 2 W] (hW : Nat.card W = 4)
    [IsMulCommutative (S ⧸ omegaCorePreimage S)]
    (z t : S) (hz : orderOf z = 2) (hzc : z ∈ center S)
    (ht : orderOf t = 2) (hout : t ∉ omegaCorePreimage S)
    (hconj : IsConj (z : G) (t : G))
    (hsat : ∀ V : Subgroup G, IsPGroup 2 V →
      (centralizer ({t} : Set S)).map (S : Subgroup G).subtype ≤ V →
      V ≤ centralizer ({(z : G), (t : G)} : Set G) →
      V = (centralizer ({t} : Set S)).map (S : Subgroup G).subtype)
    [IsExtraspecial 2 ((omegaCorePreimage S).subgroupOf
      (centralizer ({t} : Set S)))] : False := by
  have hproper : centralizer ({t} : Set S) ≠ ⊤ := by
    intro heq
    have htc : t ∈ center S := mem_center_iff.mpr (fun s =>
      mem_centralizer_singleton_iff.mp (heq ▸ (mem_top s)))
    have ht2 : t ^ 2 = 1 := by simpa only [ht] using pow_orderOf_eq_one t
    have htW : t ∈ W := omega_one_center_le_normal_four_of_no_normal_eight hno W hW
      (show t ∈ (omega₁ (center S) (p := 2)).map (center S).subtype from
        ⟨⟨t, htc⟩, subset_closure (show (⟨t, htc⟩ : center S) ^ (2 ^ 1) = 1 from
          Subtype.ext (by simpa using ht2)), rfl⟩)
    exact hout (four_le_omegaCorePreimage hN S hZ W hW hno htW)
  have hline := omegaCorePreimage_centralizer_derived_inf_center_line
    hN S hZ hno W hW z t hz hzc
  exact S.not_isConj_of_saturated_common_centralizer_normalizer z t hzc hproper hsat
    (normalizer_image_le_centralizer_of_derived_center_line
      (S : Subgroup G).subtype (S : Subgroup G).subtype_injective
      (centralizer ({t} : Set S)) z hz hline) hconj

/-- A non-elementary fixed core is extraspecial: transport the quaternion
factors to the self-centralizing Sylow core and apply the outer-action theorem. -/
public theorem omegaCorePreimage_non_elementary_fixed_extraspecial
    (hN : IsNTwoGroup G) (S : Sylow 2 G)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    [IsExtraspecial 2 (pCore 2 (OmegaQuotient S))]
    (hH : Nat.card (pCore 2 (OmegaQuotient S)) = 32)
    (B C : Subgroup (pCore 2 (OmegaQuotient S)))
    (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hjoin : B ⊔ C = ⊤) (hinter : Nat.card (B ⊓ C : Subgroup _) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b * c = c * b)
    (t : S) (ht : orderOf t = 2) (hout : t ∉ omegaCorePreimage S)
    (hfixed : ¬ IsElementaryAbelian 2 ((omegaCorePreimage S).subgroupOf
      (centralizer ({t} : Set S)))) :
    IsExtraspecial 2 ((omegaCorePreimage S).subgroupOf
      (centralizer ({t} : Set S))) := by
  let H := omegaCorePreimage S
  let e := omegaCorePreimageEquiv S
  let : IsExtraspecial 2 H := IsExtraspecial.of_mulEquiv e.symm inferInstance
  let B' := B.map e.symm.toMonoidHom
  let C' := C.map e.symm.toMonoidHom
  have hB' : Nonempty (B' ≃* QuaternionGroup 2) := by
    obtain ⟨f⟩ := hB
    exact ⟨(B.equivMapOfInjective e.symm.toMonoidHom e.symm.injective).symm.trans f⟩
  have hC' : Nonempty (C' ≃* QuaternionGroup 2) := by
    obtain ⟨f⟩ := hC
    exact ⟨(C.equivMapOfInjective e.symm.toMonoidHom e.symm.injective).symm.trans f⟩
  have hjoin' : B' ⊔ C' = ⊤ := by
    rw [← Subgroup.map_sup, hjoin, map_top_of_surjective _ e.symm.surjective]
  have hinter' : Nat.card (B' ⊓ C' : Subgroup H) = 2 := by
    rw [← map_inf B C e.symm.toMonoidHom e.symm.injective,
      card_map_of_injective e.symm.injective]
    exact hinter
  have hcomm' : ∀ b ∈ B', ∀ c ∈ C', b * c = c * b := by
    rintro _ ⟨b, hb, rfl⟩ _ ⟨c, hc, rfl⟩
    simpa only [map_mul] using congrArg e.symm.toMonoidHom (hcomm b hb c hc)
  exact extraspecial_fixed_of_quaternion_outer_involution H
    ((card_omegaCorePreimage S).trans hH) (omegaCorePreimage_centralizer_le hN S hZ)
    B' C' hB' hC' hjoin' hinter' hcomm' t ht hout hfixed

/-- The non-elementary branch excludes a saturated outside conjugate of the
central involution, with no additional fixed-core structural premise. -/
public theorem quaternion_four_false_of_non_elementary_fixed_core
    (hN : IsNTwoGroup G) (S : Sylow 2 G)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 2)
    (hno : ¬ ∃ F : Subgroup S, F.Normal ∧ IsElementaryAbelian 2 F ∧ 8 ≤ Nat.card F)
    (W : Subgroup S) [W.Normal] [IsElementaryAbelian 2 W] (hW : Nat.card W = 4)
    [IsExtraspecial 2 (pCore 2 (OmegaQuotient S))]
    (hH : Nat.card (pCore 2 (OmegaQuotient S)) = 32)
    (B C : Subgroup (pCore 2 (OmegaQuotient S)))
    (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hjoin : B ⊔ C = ⊤) (hinter : Nat.card (B ⊓ C : Subgroup _) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b * c = c * b)
    (z t : S) (hz : orderOf z = 2) (hzc : z ∈ center S)
    (ht : orderOf t = 2) (hout : t ∉ omegaCorePreimage S)
    (hconj : IsConj (z : G) (t : G))
    (hquot : IsElementaryAbelian 2 (S ⧸ omegaCorePreimage S))
    (hfixed : ¬ IsElementaryAbelian 2 ((omegaCorePreimage S).subgroupOf
      (centralizer ({t} : Set S))))
    (hsat : ∀ V : Subgroup G, IsPGroup 2 V →
      (centralizer ({t} : Set S)).map (S : Subgroup G).subtype ≤ V →
      V ≤ centralizer ({(z : G), (t : G)} : Set G) →
      V = (centralizer ({t} : Set S)).map (S : Subgroup G).subtype) : False := by
  let := hquot
  let := omegaCorePreimage_non_elementary_fixed_extraspecial
    hN S hZ hH B C hB hC hjoin hinter hcomm t ht hout hfixed
  exact quaternion_four_false_of_extraspecial_fixed_core
    hN S hZ hno W hW z t hz hzc ht hout hconj hsat

end Stellmacher.Recognition.NormalEightNonnormalImage
