module

public import Stellmacher.Recognition.NGroup

/-!
# Solvable centralizers in all-prime N-groups

In a finite N-group, every nonidentity element has a solvable centralizer.
Choose a prime divisor of the element's order and a power of prime order.
The original centralizer lies in the normalizer of the cyclic subgroup
generated by that power. The all-prime N condition makes this normalizer
solvable, and solvability passes to the centralizer.

This elementary consequence of Thompson's defining local-solvability
condition detects concrete nonsolvable local obstructions, including the
fixed-field SL₂ subgroup centralizing a unitary norm-one torus element.
The argument requires neither simplicity nor a restriction on the prime.
-/

namespace Stellmacher

/-- In a finite N-group, the centralizer of a nonidentity element is solvable. -/
public theorem IsNGroup.isSolvable_centralizer
    {G : Type*} [Group G] [Finite G] (hN : IsNGroup G)
    {x : G} (hx : x ≠ 1) :
    Group.IsSolvable (Subgroup.centralizer ({x} : Set G)) := by
  have ho : orderOf x ≠ 1 := fun h => hx (orderOf_eq_one_iff.mp h)
  obtain ⟨p, hp, hpdvd⟩ := Nat.exists_prime_and_dvd ho
  let : Fact p.Prime := ⟨hp⟩
  let y := x ^ (orderOf x / p)
  have hy : orderOf y = p := orderOf_pow_orderOf_div (orderOf_pos x).ne' hpdvd
  have hyne : y ≠ 1 := by
    intro hyone
    have hpone : p = 1 := by simpa [hyone] using hy.symm
    exact hp.ne_one hpone
  have hQne : Subgroup.zpowers y ≠ ⊥ := fun h => hyne (Subgroup.zpowers_eq_bot.mp h)
  have hQp : IsPGroup p (Subgroup.zpowers y) :=
    IsPGroup.of_card (n := 1) (by simpa only [Nat.card_zpowers, pow_one] using hy)
  let := hN p hp (Subgroup.zpowers y) hQne hQp
  have hC : Subgroup.centralizer ({x} : Set G) ≤
      Subgroup.normalizer (Subgroup.zpowers y : Set G) := by
    intro c hc
    apply Subgroup.centralizer_le_normalizer (Subgroup.zpowers y : Set G)
    rw [Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure,
      Subgroup.mem_centralizer_singleton_iff]
    exact (Commute.pow_right (Subgroup.mem_centralizer_singleton_iff.mp hc) _)
  exact Group.isSolvable_of_isSolvable_injective (Subgroup.inclusion_injective hC)

end Stellmacher
