module
public import Stellmacher.Recognition.FongWreathedNormalizer
public import Stellmacher.Recognition.FongWreathedInducingData
public import Theory.Character.ModularSixteen

/-!
# Actual inducing data for Fong's normalizer

The normalizer of the cyclic subgroup generated by the actual coordinate F
has odd core U, with unique normal forms FⁱXʲu for i < 8, j < 2 and u ∈ U.
Its two linear characters take the prescribed values (I,1) and (1,-1) on
(F,X), and both kill U. The witness satisfies InducingData.IsActual for the
original Sylow presentation.

The ambient normalizer theorem gives a quotient of order sixteen and the
relations f⁸ = x² = 1, xfx⁻¹ = f⁵, with f still of order eight. The modular
sixteen coordinate theorem constructs the quotient characters and lifts
its unique coordinates through U. No simplicity, solvability, or fusion
orientation is needed for this local construction.

Source: P. Fong, Some Sylow subgroups of order 32 and a characterization
of U(3,3), J. Algebra 6 (1967), printed p. 72, first two paragraphs.
-/

namespace Stellmacher.Recognition.FongWreathedInduction
open FongWreathedIntrinsic
variable {G : Type*} [Group G] [Finite G]
  (S : Sylow 2 G) (P : ABG.Wreathed.Presentation S 2)

/-- The local data on the actual ambient normalizer of the prescribed F. -/
public noncomputable def actualInducingData : InducingData G := by
  let H := actualNormalizer S P
  let U := pPrimeCore 2 H
  let q := QuotientGroup.mk' U
  let f := normalizerF S P
  let x := normalizerX S P
  have hf : orderOf (q f) = 8 := normalizer_quotientF_order S P
  have hx : (q x) ^ 2 = 1 := by
    rw [← map_pow, normalizerX_sq, map_one]
  have hxf : q x * q f * (q x)⁻¹ = (q f) ^ 5 := by
    rw [← map_inv, ← map_mul, ← map_mul, normalizerX_conjugate, map_pow]
  have hcard : Nat.card (H ⧸ U) = 16 := normalizer_quotient_card S P
  let a := ModularSixteen.character (q f) (q x) hf hx hxf hcard
    Complex.I 1 Complex.I_pow_four (by simp)
  let b := ModularSixteen.character (q f) (q x) hf hx hxf hcard
    1 (-1) (by simp) (by norm_num)
  exact {
    H := H
    f := f
    x := x
    U := U
    normal_U := inferInstance
    odd_U := normalizer_oddCore_odd S P
    order_f := normalizerF_order S P
    square_x := normalizerX_sq S P
    conjugate_f := normalizerX_conjugate S P
    commute_U := normalizerF_commute_oddCore S P
    normal_form := ModularSixteen.quotient_normalForm_lift U f x
      (ModularSixteen.normalForm_bijective (q f) (q x) hf hxf hcard)
    alpha := a.comp q
    beta := b.comp q
    alpha_f := ModularSixteen.character_f (q f) (q x) hf hx hxf hcard
      Complex.I 1 Complex.I_pow_four (by simp)
    alpha_x := ModularSixteen.character_x (q f) (q x) hf hx hxf hcard
      Complex.I 1 Complex.I_pow_four (by simp)
    beta_f := ModularSixteen.character_f (q f) (q x) hf hx hxf hcard
      1 (-1) (by simp) (by norm_num)
    beta_x := ModularSixteen.character_x (q f) (q x) hf hx hxf hcard
      1 (-1) (by simp) (by norm_num)
    alpha_U := fun u => by
      change a (q u.val) = 1
      have hu : q u.val = 1 := (QuotientGroup.eq_one_iff u.val).mpr u.property
      rw [hu, map_one]
    beta_U := fun u => by
      change b (q u.val) = 1
      have hu : q u.val = 1 := (QuotientGroup.eq_one_iff u.val).mpr u.property
      rw [hu, map_one] }

/-- The constructed witnesses use the original ambient Sylow coordinates. -/
public theorem actualInducingData_isActual :
    (actualInducingData S P).IsActual S P := ⟨rfl, rfl, rfl⟩

/-- The odd normal subgroup is the intrinsic odd core of the normalizer. -/
public theorem actualInducingData_oddCore :
    (actualInducingData S P).U = pPrimeCore 2 (actualInducingData S P).H := by
  rfl

/-- Every height-two wreathed Sylow presentation supplies actual inducing data. -/
public theorem exists_actualInducingData :
    ∃ d : InducingData G, d.IsActual S P :=
  ⟨actualInducingData S P, actualInducingData_isActual S P⟩

end Stellmacher.Recognition.FongWreathedInduction
