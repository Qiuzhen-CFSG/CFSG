module
public import Stellmacher.Recognition.OddCoreBalance
public import FeitThompson.GroupAction.NoncyclicAbelianPGroup
public import Theory.GroupAction.SubgroupConjugation

/-!
# Restricting the actual involution odd-core closure

In a finite N₂ group, attach to each involution a the ambient image of the
odd core of C_G(a), and let R(A) be the subgroup generated by these images
for all nonidentity elements of an elementary abelian two-subgroup A.
Whenever B≤A is elementary abelian and has order at least four, R(A)=R(B).
Consequently the entire normalizer of B normalizes R(A).

For each a∈A, B normalizes the odd group O₂′(C_G(a)). Coprime action by the
noncyclic abelian group B generates this odd group from the centralizers of
its nonidentity elements. The proved N₂ balance theorem puts each such
centralizer in O₂′(C_G(b)). This proves the reverse closure containment;
the other containment is monotonicity. Ambient isomorphisms preserve the
centralizer and its odd core, giving naturality and the normalizer consequence.
All actions use the actual subgroup conjugation action with the established
normalizer containment.

This is the k=1 restriction argument of GLS, *The Classification of the
Finite Simple Groups*, No. 2, Section 21, Proposition 21.8, and equation
(29.1) in the introductory volume (`refs/KGroup/GLS2/ChapterF.tex` and
`refs/KGroup/GLS1/Chapter002.tex`). The coprime fixed-point generation step
is also Kurzweil–Stellmacher 8.3.4. The result is independent of signalizer
completion: it does not assert that R(A) itself has odd order and uses no
additional Z condition. It supplies local normalizer control for the later
completion and connectivity arguments in global N₂ recognition.
-/

namespace Stellmacher.Recognition
open scoped IsMulCommutative

/-- The odd core of an element centralizer, mapped to the ambient group. -/
@[expose] public def involutionOddCore {G : Type*} [Group G] (a : G) : Subgroup G :=
  (pPrimeCore 2 (Subgroup.centralizer ({a} : Set G))).map
    (Subgroup.centralizer ({a} : Set G)).subtype

/-- The subgroup generated by the odd cores attached to nonidentity elements of A. -/
@[expose] public def involutionOddCoreClosure {G : Type*} [Group G]
    (A : Subgroup G) : Subgroup G :=
  ⨆ (a : A) (_ : a ≠ 1), involutionOddCore (a : G)

private theorem centralizer_singleton_map {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (a : G) :
    (Subgroup.centralizer ({a} : Set G)).map e.toMonoidHom =
      Subgroup.centralizer ({e a} : Set H) := by
  ext x
  rw [Subgroup.mem_map_equiv, Subgroup.mem_centralizer_singleton_iff,
    Subgroup.mem_centralizer_singleton_iff]
  constructor
  · intro h
    simpa only [map_mul, e.apply_symm_apply] using congrArg e h
  · intro h
    apply e.injective
    simpa only [map_mul, e.apply_symm_apply] using h

/-- An ambient isomorphism transports the actual centralizer odd core. -/
public theorem involutionOddCore_map {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (a : G) :
    (involutionOddCore a).map e.toMonoidHom = involutionOddCore (e a) := by
  let ce : Subgroup.centralizer ({a} : Set G) ≃*
      Subgroup.centralizer ({e a} : Set H) :=
    (e.subgroupMap _).trans (MulEquiv.subgroupCongr (centralizer_singleton_map e a))
  have hc := pPrimeCore_map_iso 2 ce
  unfold involutionOddCore
  rw [← hc, Subgroup.map_map, Subgroup.map_map]
  rfl

/-- The centralizer normalizes the ambient image of its odd core. -/
public theorem centralizer_le_normalizer_involutionOddCore {G : Type*} [Group G] (a : G) :
    Subgroup.centralizer ({a} : Set G) ≤ Subgroup.normalizer (involutionOddCore a : Set G) := by
  intro g hg
  apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
  change (involutionOddCore a).map (MulAut.conj g).toMonoidHom = _
  rw [involutionOddCore_map]
  have hcomm := Subgroup.mem_centralizer_singleton_iff.mp hg
  have ha : (MulAut.conj g) a = a := by
    change g * a * g⁻¹ = a
    rw [hcomm, mul_assoc, mul_inv_cancel, mul_one]
  rw [ha]

/-- Enlarging the actor subgroup enlarges its odd-core closure. -/
public theorem involutionOddCoreClosure_mono {G : Type*} [Group G]
    {A B : Subgroup G} (hAB : A ≤ B) :
    involutionOddCoreClosure A ≤ involutionOddCoreClosure B := by
  refine iSup₂_le fun a ha => ?_
  have hne : (⟨a, hAB a.property⟩ : B) ≠ 1 := by
    intro h
    apply ha
    exact Subtype.ext (congrArg (fun b : B => (b : G)) h)
  exact le_iSup_of_le (⟨a, hAB a.property⟩ : B) (le_iSup_of_le hne le_rfl)

/-- The generated odd-core closure is natural under ambient isomorphisms. -/
public theorem involutionOddCoreClosure_map {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (A : Subgroup G) :
    (involutionOddCoreClosure A).map e.toMonoidHom =
      involutionOddCoreClosure (A.map e.toMonoidHom) := by
  simp only [involutionOddCoreClosure, Subgroup.map_iSup, involutionOddCore_map]
  apply le_antisymm
  · refine iSup₂_le fun a ha => ?_
    let image : A.map e.toMonoidHom := ⟨e a, Subgroup.mem_map_of_mem e.toMonoidHom a.property⟩
    have himage : image ≠ 1 := by
      intro h
      apply ha
      apply Subtype.ext
      apply e.injective
      change e (a : G) = e 1
      rw [map_one]
      exact congrArg (fun x : A.map e.toMonoidHom => (x : H)) h
    exact le_iSup_of_le image (le_iSup_of_le himage le_rfl)
  · refine iSup₂_le fun image himage => ?_
    obtain ⟨a, ha, heq⟩ := image.property
    have hne : (⟨a, ha⟩ : A) ≠ 1 := by
      intro h
      apply himage
      apply Subtype.ext
      rw [← heq, show a = 1 from congrArg Subtype.val h, map_one]
      rfl
    rw [← heq]
    exact le_iSup_of_le (⟨a,ha⟩ : A) (le_iSup_of_le hne le_rfl)

/-- The normalizer of A normalizes its actual odd-core closure. -/
public theorem normalizer_le_normalizer_involutionOddCoreClosure
    {G : Type*} [Group G] (A : Subgroup G) :
    Subgroup.normalizer (A : Set G) ≤
      Subgroup.normalizer (involutionOddCoreClosure A : Set G) := by
  intro g hg
  apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
  change (involutionOddCoreClosure A).map (MulAut.conj g).toMonoidHom = _
  rw [involutionOddCoreClosure_map]
  exact congrArg involutionOddCoreClosure (Subgroup.mem_normalizer_iff_map_conj_eq.mp hg)

/-- Every elementary subgroup of rank at least two determines the same closure. -/
public theorem oddCoreClosure_eq_of_le
    {G : Type*} [Group G] [Finite G] (hN : IsNTwoGroup G)
    (A B : Subgroup G) [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 B]
    (hBA : B ≤ A) (hBcard : 4 ≤ Nat.card B) :
    involutionOddCoreClosure A = involutionOddCoreClosure B := by
  let _ : CommGroup A := IsMulCommutative.instCommGroup
  let _ : CommGroup B := IsMulCommutative.instCommGroup
  apply le_antisymm ?_ (involutionOddCoreClosure_mono hBA)
  refine iSup₂_le fun a ha => ?_
  have horderA : orderOf (a : G) = 2 := by
    rw [Subgroup.orderOf_coe]
    apply orderOf_eq_prime_iff.mpr
    exact ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 A) a, ha⟩
  have hBcentral : B ≤ Subgroup.centralizer ({(a : G)} : Set G) := by
    intro b hb
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    exact congrArg Subtype.val (mul_comm (⟨b, hBA hb⟩ : A) a)
  let R := involutionOddCore (a : G)
  have hBnorm : B ≤ Subgroup.normalizer (R : Set G) :=
    hBcentral.trans (centralizer_le_normalizer_involutionOddCore _)
  let _ : MulDistribMulAction B R := Subgroup.conjMulDistribMulActionOfLeNormalizer B R hBnorm
  let _ : Fact (IsPGroup 2 B) := ⟨IsElementaryAbelian.isPGroup 2 B⟩
  have hcop : Nat.Coprime 2 (Nat.card R) := by
    change Nat.Coprime 2 (Nat.card ((pPrimeCore 2 (Subgroup.centralizer ({(a:G)} : Set G))).map _))
    rw [Subgroup.card_map_of_injective Subtype.coe_injective]
    exact pPrimeCore_coprime_card
  have hncyc : ¬ IsCyclic B := by
    intro hcyc
    have hcard : Nat.card B ∣ 2 := by
      rw [← hcyc.exponent_eq_card]
      exact IsElementaryAbelian.exponent_dvd_p 2 B
    have := Nat.le_of_dvd (by decide : 0 < 2) hcard
    omega
  have hgen := iSup_fixedPointSubgroup_zpowers_eq_top_of_noncyclic_abelian_pGroup_action
    (G := R) (A := B) 2 hcop hncyc
  have hle : (⊤ : Subgroup R) ≤ (involutionOddCoreClosure B).comap R.subtype := by
    rw [← hgen]
    refine iSup₂_le fun b hb => ?_
    intro x hx
    have hfix := hx (⟨b, Subgroup.mem_zpowers b⟩ : Subgroup.zpowers b)
    have heq : (b:G) * (x:G) * (b:G)⁻¹ = (x:G) := congrArg Subtype.val hfix
    have hcent : (x:G) ∈ Subgroup.centralizer ({(b:G)} : Set G) := by
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      exact (mul_inv_eq_iff_eq_mul.mp heq).symm
    have horderB : orderOf (b:G) = 2 := by
      rw [Subgroup.orderOf_coe]
      apply orderOf_eq_prime_iff.mpr
      exact ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 B) b, hb⟩
    have hcomm : Commute (a:G) (b:G) :=
      (Subgroup.mem_centralizer_singleton_iff.mp (hBcentral b.property)).symm
    have hmem := involution_oddCore_balance hN horderA horderB hcomm
      ⟨x.property, hcent⟩
    exact (le_iSup_of_le b (le_iSup_of_le hb le_rfl) :
      involutionOddCore (b:G) ≤ involutionOddCoreClosure B) hmem
  intro x hx
  exact hle (show (⟨x,hx⟩ : R) ∈ (⊤ : Subgroup R) from trivial)

/-- The normalizer of an elementary subgroup of order at least four controls the larger closure. -/
public theorem normalizer_le_normalizer_oddCoreClosure_of_le
    {G : Type*} [Group G] [Finite G] (hN : IsNTwoGroup G)
    (A B : Subgroup G) [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 B]
    (hBA : B ≤ A) (hBcard : 4 ≤ Nat.card B) :
    Subgroup.normalizer (B : Set G) ≤
      Subgroup.normalizer (involutionOddCoreClosure A : Set G) := by
  rw [oddCoreClosure_eq_of_le hN A B hBA hBcard]
  exact normalizer_le_normalizer_involutionOddCoreClosure B

end Stellmacher.Recognition
