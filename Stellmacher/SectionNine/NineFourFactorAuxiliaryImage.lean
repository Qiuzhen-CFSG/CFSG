module
public import Stellmacher.SectionNine.NineFourActorClosure
public import Stellmacher.SectionNine.NineFourConjugatedActorImage
public import Stellmacher.SectionOne.SL2DistinctInvolutionsGenerate
public import Stellmacher.SectionOne.SL2DerivedInvolutionGenerate

/-!
# The canonical factor inside the literal auxiliary image

For the normalized actor and conjugator of (9.4), let a surjective local
quotient map have kernel equal to the next stabilizer's two-core. If the
actor image is an involution and its canonical odd-core commutator factor
is SL₂(2), that factor lies in the image of the literal auxiliary group F.
Moreover, the auxiliary image is generated by the factor's derived subgroup
and the image of the initial/remote core intersection. The quotient map and
factor are precisely those supplied by `nine_next_transvection_factor`;
this lemma preserves the caller's map rather than constructing another.

The residual has odd image, so the conjugator image lies in the canonical
factor. The conjugated actor belongs to the core intersection. Its image
is distinct from the actor image: otherwise their quotient would be in the
kernel, placing the actor in the initial edge and contradicting its edge
generation hypothesis. Two distinct involutions generate SL₂(2). Its
derived subgroup and the conjugated involution also generate it, giving
the auxiliary image's derived-subgroup supplement.

Source: Stellmacher (9.4)(1), printed p.51/PDF p.41, selecting the first
factor before the auxiliary residual's conjugate-generation formula, in
`refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext SevenSix
universe u

public theorem nine_four_factor_le_auxiliary_image
    {H G K : Type u} [Group H] [Finite H] [Group G] [Finite G] [Group K] [Finite K]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : AmbientSectionNineContext H S0 S P1 P2 embedding T A B)
    (hb : 1 < ctx.criticalPath.length)
    (remote : ctx.Γ.Vertex)
    (hdistance : ctx.Γ.distance remote ctx.criticalPath.firstStep = 2)
    (actor : G)
    (hactor : actor ∈ GAt ctx.Γ ctx.criticalPath.firstStep ∧
      actor ∈ Subgroup.centralizer (VAt ctx.Γ remote : Set G))
    (conjugator : G)
    (hconjugator : conjugator ∈ ⁅EAt ctx.Γ ctx.criticalPath.firstStep,
      Subgroup.zpowers actor⁆)
    (hremote : ctx.Γ.act conjugator remote ∈ Neighborhood ctx.Γ ctx.criticalPath.a)
    (hne : ctx.Γ.act conjugator remote ≠ ctx.criticalPath.firstStep)
    (hgenerate : (GAt ctx.Γ ctx.criticalPath.firstStep ⊓ GAt ctx.Γ ctx.criticalPath.a) ⊔
      Subgroup.zpowers actor = GAt ctx.Γ ctx.criticalPath.firstStep)
    (f : GAt ctx.Γ ctx.criticalPath.firstStep →* K) (hsurj : Function.Surjective f)
    (hkernel : f.ker = pCore 2 (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hinvolution : _root_.IsInvolution (f ⟨actor, hactor.1⟩))
    (hfactor : IsSL2Two (⁅SectionOne.oddCore K, Subgroup.zpowers (f ⟨actor, hactor.1⟩)⁆ ⊔
      Subgroup.zpowers (f ⟨actor, hactor.1⟩) : Subgroup K)) :
    let P := GAt ctx.Γ ctx.criticalPath.firstStep
    let R0 := QAt ctx.Γ ctx.criticalPath.a ⊓ QAt ctx.Γ (ctx.Γ.act conjugator remote)
    let F := R0 ⊔ Subgroup.zpowers actor
    let t := f ⟨actor,hactor.1⟩
    let D := ⁅SectionOne.oddCore K, Subgroup.zpowers t⁆ ⊔ Subgroup.zpowers t
    D ≤ (F.subgroupOf P).map f ∧
      (F.subgroupOf P).map f = (commutator D).map D.subtype ⊔ (R0.subgroupOf P).map f := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let P := GAt Γ cp.firstStep
  let Qa := QAt Γ cp.a
  let Qn := QAt Γ cp.firstStep
  let d := Γ.act conjugator remote
  let R0 := Qa ⊓ QAt Γ d
  let F := R0 ⊔ Subgroup.zpowers actor
  let t : P := ⟨actor, hactor.1⟩
  have hxP := nine_four_conjugator_mem_stabilizer Γ cp.firstStep actor conjugator
    hactor.1 hconjugator
  let x : P := ⟨conjugator,hxP⟩
  let u : P := x⁻¹*t*x
  let D := ⁅SectionOne.oddCore K,Subgroup.zpowers (f t)⁆ ⊔ Subgroup.zpowers (f t)
  have hconjugated := nine_four_conjugated_actor_image ctx.toLocalContext actor hactor.1
    conjugator hconjugator f hsurj hkernel hinvolution
  have htP : Subgroup.zpowers actor ≤ P := Subgroup.zpowers_le.mpr hactor.1
  have htD : f t ∈ D := Subgroup.mem_sup_right (Subgroup.mem_zpowers _)
  have huD : f u ∈ D := hconjugated.1
  have huInv : _root_.IsInvolution (f u) := hconjugated.2.1
  have huR0 : (u:G) ∈ R0 := by
    apply nine_four_actor_closure_le_core_intersection ctx hb remote hdistance actor
      hactor conjugator hconjugator hremote hne
    apply Subgroup.subset_closure
    refine ⟨1,⟨conjugator⁻¹*actor*conjugator,Subgroup.mem_zpowers _⟩,?_⟩
    simp [u,x,t]
  have hQn : Qn ≤ GAt Γ cp.a ⊓ P :=
    (local_cores_le_edge_sylow ctx.sectionSeven Γ cp).2.trans cp.S_le_edge_stabilizers
  have hQa : Qa ≤ GAt Γ cp.a ⊓ P :=
    (local_cores_le_edge_sylow ctx.sectionSeven Γ cp).1.trans cp.S_le_edge_stabilizers
  have hdifferent : f t ≠ f u := by
    intro heq
    have hker : t*u⁻¹ ∈ f.ker := by simp only [MonoidHom.mem_ker,map_mul,map_inv,heq,mul_inv_cancel]
    rw [hkernel] at hker
    have hq : ((t*u⁻¹ : P):G) ∈ Qn := by
      change ((t*u⁻¹ : P):G) ∈ Γ.twoCoreAt cp.firstStep
      rw [Γ.twoCoreAt_def]
      exact Subgroup.mem_map_of_mem P.subtype hker
    have htEdge : actor ∈ GAt Γ cp.firstStep ⊓ GAt Γ cp.a := by
      refine ⟨hactor.1,?_⟩
      change actor ∈ GAt Γ cp.a
      have hm := (GAt Γ cp.a).mul_mem (hQn hq).1 (hQa huR0.1).1
      change (t:G)*(u:G)⁻¹*(u:G) ∈ GAt Γ cp.a at hm
      simpa only [inv_mul_cancel_right,t] using hm
    have heqEdge : GAt Γ cp.firstStep ⊓ GAt Γ cp.a = GAt Γ cp.firstStep := by
      rwa [sup_eq_left.mpr (Subgroup.zpowers_le.mpr htEdge)] at hgenerate
    exact nine_four_neighbor_edge_proper ctx.sectionSeven Γ cp.firstStep cp.a
      ((mem_neighborhood_iff_adjacent Γ).mpr (Γ.adjacent_symm cp.firstStep_adj)) heqEdge
  have hDimage : D ≤ (F.subgroupOf P).map f := by
    rw [SectionOne.sl2_distinct_involutions_generate D hfactor (f t) (f u)
      htD huD hinvolution huInv hdifferent]
    apply sup_le
    · apply Subgroup.zpowers_le.mpr
      exact Subgroup.mem_map_of_mem f ((le_sup_right : Subgroup.zpowers actor ≤ F)
        (Subgroup.mem_zpowers actor))
    · apply Subgroup.zpowers_le.mpr
      exact Subgroup.mem_map_of_mem f ((le_sup_left : R0 ≤ F) huR0)
  have hR0P : R0 ≤ P := inf_le_left.trans (hQa.trans inf_le_right)
  have hFnative : F.subgroupOf P = R0.subgroupOf P ⊔ Subgroup.zpowers t := by
    apply Subgroup.map_injective P.subtype_injective
    rw [Subgroup.map_subgroupOf_eq_of_le (sup_le hR0P htP),Subgroup.map_sup,
      Subgroup.map_subgroupOf_eq_of_le hR0P,MonoidHom.map_zpowers]
    rfl
  have hFimage : (F.subgroupOf P).map f = (R0.subgroupOf P).map f ⊔
      Subgroup.zpowers (f t) := by rw [hFnative,Subgroup.map_sup,MonoidHom.map_zpowers]
  have hDR0 : D ≤ (commutator D).map D.subtype ⊔ (R0.subgroupOf P).map f := by
    calc
      D = (commutator D).map D.subtype ⊔ Subgroup.zpowers (f u) :=
        SectionOne.sl2_derived_involution_generate D hfactor (f u) huD huInv
      _ ≤ (commutator D).map D.subtype ⊔ (R0.subgroupOf P).map f :=
        sup_le le_sup_left
          ((Subgroup.zpowers_le.mpr (Subgroup.mem_map_of_mem f huR0)).trans le_sup_right)
  refine ⟨hDimage,le_antisymm ?_ ?_⟩
  · rw [hFimage]
    exact sup_le le_sup_right ((Subgroup.zpowers_le.mpr htD).trans hDR0)
  · exact sup_le ((Subgroup.map_subtype_le _).trans hDimage)
      (Subgroup.map_mono (Subgroup.subgroupOf_mono _ le_sup_left))

end Stellmacher.SectionNine
