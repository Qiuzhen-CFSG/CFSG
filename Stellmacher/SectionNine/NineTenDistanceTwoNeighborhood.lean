module

public import Stellmacher.SectionNine.NineEightNeighborhood
public import Stellmacher.SectionNine.NineSevenSourceOddW
public import Stellmacher.SectionFiveToSeven.PrescribedCriticalPairNormalization

/-!
# The literal distance-two neighborhood in (9.10)

At a first-step-orbit vertex, the source W is generated by V-groups at
exactly distance two. It lies in the two-step-walk enlargement SourceOddW;
this inclusion does not identify the two definitions. At the retained first
vertex, critical minimality puts it in its own core and the stabilizer at
path offset b-2. Each two-step summand belongs to an abelian one-step
neighborhood containing first V, so W centralizes first V. Six-edge walks
between center generators make W abelian when b>5, using odd critical length.
The stabilizer preserves distance and hence normalizes the exact-distance join.

These are the geometric inputs of Stellmacher (9.10)(7)--(8), printed p.58,
with the orbit-dependent W definition on printed p.50. No critical path or
extraction witness is replaced.
-/

namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext SevenSix
universe u

@[expose] public noncomputable def DistanceTwoNeighborhoodV
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (Γ : CosetGraphContext G T A B) (vertex : Γ.Vertex) : Subgroup G :=
  sSup {subgroup : Subgroup G | ∃ endpoint,
    Γ.distance vertex endpoint = 2 ∧ subgroup = VAt Γ endpoint}

public theorem v_le_distance_two_neighborhood
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (Γ : CosetGraphContext G T A B) {vertex endpoint : Γ.Vertex}
    (hdistance : Γ.distance vertex endpoint = 2) :
    VAt Γ endpoint ≤ DistanceTwoNeighborhoodV Γ vertex :=
  le_sSup ⟨endpoint, hdistance, rfl⟩

private theorem distance_two_common_neighbor
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (Γ : CosetGraphContext G T A B) {vertex endpoint : Γ.Vertex}
    (hdistance : Γ.distance vertex endpoint = 2) :
    ∃ middle, middle ∈ Neighborhood Γ vertex ∧ endpoint ∈ Neighborhood Γ middle := by
  obtain ⟨path, hstart, hend, hpath⟩ := Γ.distance_path vertex endpoint
  have hlength : 1 < Γ.distance vertex endpoint := by omega
  refine ⟨path ⟨1, by omega⟩, ?_, ?_⟩
  · apply (mem_neighborhood_iff_adjacent Γ).mpr
    have h := hpath ⟨0, by omega⟩
    change Γ.adjacent (path 0) (path ⟨1, by omega⟩) at h
    rwa [hstart] at h
  · apply (mem_neighborhood_iff_adjacent Γ).mpr
    have h := hpath ⟨1, by omega⟩
    have hlast : (⟨1, by omega⟩ : Fin (Γ.distance vertex endpoint)).succ =
        ⟨Γ.distance vertex endpoint, Nat.lt_succ_self _⟩ := by
      apply Fin.ext
      simpa using hdistance.symm
    rw [hlast, hend] at h
    exact h

public theorem distance_two_neighborhood_le_source_odd_w
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (Γ : CosetGraphContext G T A B) (vertex : Γ.Vertex) :
    DistanceTwoNeighborhoodV Γ vertex ≤ SourceOddW Γ vertex := by
  unfold DistanceTwoNeighborhoodV
  apply sSup_le
  rintro subgroup ⟨endpoint, hdistance, rfl⟩
  obtain ⟨middle, hmiddle, hendpoint⟩ := distance_two_common_neighbor Γ hdistance
  exact le_sSup ⟨middle, hmiddle, endpoint, hendpoint, rfl⟩

private theorem distance_two_neighborhood_act_le
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (Γ : CosetGraphContext G T A B) (actor : G) (vertex : Γ.Vertex) :
    (DistanceTwoNeighborhoodV Γ vertex).map (MulAut.conj actor⁻¹).toMonoidHom ≤
      DistanceTwoNeighborhoodV Γ (Γ.act actor vertex) := by
  rw [Subgroup.map_le_iff_le_comap, DistanceTwoNeighborhoodV]
  apply sSup_le
  rintro subgroup ⟨endpoint, hdistance, rfl⟩
  apply Subgroup.map_le_iff_le_comap.mp
  rw [← v_act]
  exact v_le_distance_two_neighborhood Γ ((distance_act Γ actor vertex endpoint).trans hdistance)

public theorem distance_two_neighborhood_act
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (Γ : CosetGraphContext G T A B) (actor : G) (vertex : Γ.Vertex) :
    DistanceTwoNeighborhoodV Γ (Γ.act actor vertex) =
      (DistanceTwoNeighborhoodV Γ vertex).map (MulAut.conj actor⁻¹).toMonoidHom := by
  apply le_antisymm ?_ (distance_two_neighborhood_act_le Γ actor vertex)
  have hback := Subgroup.map_mono (f := (MulAut.conj actor⁻¹).toMonoidHom)
    (distance_two_neighborhood_act_le Γ actor⁻¹ (Γ.act actor vertex))
  have hcomp : (MulAut.conj actor⁻¹).toMonoidHom.comp
      (MulAut.conj actor).toMonoidHom = MonoidHom.id G := by
    ext element
    simp [MulAut.conj_apply, mul_assoc]
  simpa only [← Γ.act_mul, mul_inv_cancel, Γ.act_one, inv_inv,
    Subgroup.map_map, hcomp, Subgroup.map_id] using hback

private theorem source_odd_w_le_of_neighborhood_le
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (Γ : CosetGraphContext G T A B) (vertex : Γ.Vertex) (target : Subgroup G)
    (h : ∀ middle ∈ Neighborhood Γ vertex, GeneratedNeighborhoodV Γ middle ≤ target) :
    SourceOddW Γ vertex ≤ target := by
  unfold SourceOddW
  apply sSup_le
  rintro subgroup ⟨middle, hmiddle, endpoint, hendpoint, rfl⟩
  exact (nine_eight_v_le_generated_neighborhood Γ hendpoint).trans (h middle hmiddle)

private theorem source_odd_w_abelian
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (ctx : SectionNineLocalContext G T A B) (hb : 6 < ctx.criticalPath.length)
    (vertex : ctx.Γ.Vertex) : IsMulCommutative (SourceOddW ctx.Γ vertex) := by
  apply Subgroup.le_centralizer_iff_isMulCommutative.mp
  apply source_odd_w_le_of_neighborhood_le
  intro leftFirst hleftFirst
  apply nine_eight_generated_neighborhood_le
  intro leftSecond hleftSecond leftThird hleftThird
  apply Subgroup.le_centralizer_iff.mpr
  apply source_odd_w_le_of_neighborhood_le
  intro rightFirst hrightFirst
  apply nine_eight_generated_neighborhood_le
  intro rightSecond hrightSecond rightThird hrightThird
  let vertices : Fin 7 → ctx.Γ.Vertex :=
    ![rightThird, rightSecond, rightFirst, vertex, leftFirst, leftSecond, leftThird]
  have hwalk : ∀ step : Fin 6,
      ctx.Γ.adjacent (vertices step.castSucc) (vertices step.succ) := by
    intro step
    fin_cases step
    · exact ctx.Γ.adjacent_symm ((mem_neighborhood_iff_adjacent ctx.Γ).mp hrightThird)
    · exact ctx.Γ.adjacent_symm ((mem_neighborhood_iff_adjacent ctx.Γ).mp hrightSecond)
    · exact ctx.Γ.adjacent_symm ((mem_neighborhood_iff_adjacent ctx.Γ).mp hrightFirst)
    · exact (mem_neighborhood_iff_adjacent ctx.Γ).mp hleftFirst
    · exact (mem_neighborhood_iff_adjacent ctx.Γ).mp hleftSecond
    · exact (mem_neighborhood_iff_adjacent ctx.Γ).mp hleftThird
  have hdist := ctx.Γ.distance_le_of_path 6 vertices hwalk
  change ctx.Γ.distance rightThird leftThird ≤ 6 at hdist
  have hcore := critical_minimality ctx.Γ ctx.criticalPath (hdist.trans_lt hb)
  have hneighbor : leftSecond ∈ Neighborhood ctx.Γ leftThird :=
    (mem_neighborhood_iff_adjacent ctx.Γ).mpr
      (ctx.Γ.adjacent_symm ((mem_neighborhood_iff_adjacent ctx.Γ).mp hleftThird))
  have hcenter := (lemma_seven_three ctx.sectionSeven ctx.Γ).center_core
    leftThird leftSecond hneighbor
  exact hcore.trans (Subgroup.le_centralizer_iff.mp
    (hcenter.trans ((omegaOneCenter_le_centerAmbient _).trans
      (centerAmbient_le_centralizer _))))

public theorem nine_ten_distance_two_neighborhood_geometry
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (ctx : SectionNineLocalContext G T A B) (hb : 4 < ctx.criticalPath.length) :
    let W := DistanceTwoNeighborhoodV ctx.Γ ctx.criticalPath.firstStep
    W ≤ QAt ctx.Γ ctx.criticalPath.firstStep ∧
      W ≤ GAt ctx.Γ (ctx.criticalPath.path ⟨ctx.criticalPath.length - 2,
        Nat.lt_succ_of_le (Nat.sub_le _ _)⟩) ∧
      W ≤ Subgroup.centralizer (VAt ctx.Γ ctx.criticalPath.firstStep : Set G) ∧
      GAt ctx.Γ ctx.criticalPath.firstStep ≤ Subgroup.normalizer (W : Set G) ∧
      (5 < ctx.criticalPath.length → IsMulCommutative W) := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let W := DistanceTwoNeighborhoodV Γ cp.firstStep
  have hW := distance_two_neighborhood_le_source_odd_w Γ cp.firstStep
  have hcore : SourceOddW Γ cp.firstStep ≤ QAt Γ cp.firstStep :=
    source_odd_w_le_core_of_distance Γ cp cp.firstStep cp.firstStep
      (by rw [Γ.distance_refl]; change 4 < cp.length at hb; omega)
  have hpreterminal : SourceOddW Γ cp.firstStep ≤
      GAt Γ (cp.path ⟨cp.length - 2, Nat.lt_succ_of_le (Nat.sub_le _ _)⟩) := by
    apply source_odd_w_le_of_neighborhood_le
    intro middle hmiddle
    exact nine_eight_neighborhood_le_preterminal ctx hb middle hmiddle
  have hcentral : SourceOddW Γ cp.firstStep ≤
      Subgroup.centralizer (VAt Γ cp.firstStep : Set G) := by
    apply source_odd_w_le_of_neighborhood_le
    intro middle hmiddle
    have hreverse : cp.firstStep ∈ Neighborhood Γ middle :=
      (mem_neighborhood_iff_adjacent Γ).mpr
        (Γ.adjacent_symm ((mem_neighborhood_iff_adjacent Γ).mp hmiddle))
    exact (Subgroup.le_centralizer_iff_isMulCommutative.mpr
      (nine_eight_neighborhood_abelian ctx hb middle)).trans
        (Subgroup.centralizer_le (nine_eight_v_le_generated_neighborhood Γ hreverse))
  refine ⟨hW.trans hcore, hW.trans hpreterminal, hW.trans hcentral, ?_, ?_⟩
  · apply Subgroup.le_normalizer_iff.mpr
    intro actor hactor element helement
    have hfix : Γ.act actor⁻¹ cp.firstStep = cp.firstStep :=
      (Set.ext_iff.mp (Γ.stabilizer_def cp.firstStep) actor⁻¹).mp
        ((GAt Γ cp.firstStep).inv_mem hactor)
    have hact := distance_two_neighborhood_act Γ actor⁻¹ cp.firstStep
    simp only [inv_inv, hfix] at hact
    exact hact.symm ▸ Subgroup.mem_map_of_mem (MulAut.conj actor).toMonoidHom helement
  · intro hlong
    have hodd := (lemma_seven_five ctx.sectionSeven Γ cp ctx.commutator_eq).odd_distance
    obtain ⟨half, hhalf⟩ := hodd
    have hlong' : 6 < cp.length := by change 5 < cp.length at hlong; omega
    exact Subgroup.le_centralizer_iff_isMulCommutative.mp
      (hW.trans ((Subgroup.le_centralizer_iff_isMulCommutative.mpr
        (source_odd_w_abelian ctx hlong' cp.firstStep)).trans (Subgroup.centralizer_le hW)))

end Stellmacher.SectionNine
