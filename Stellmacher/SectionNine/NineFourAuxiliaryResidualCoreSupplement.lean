module
public import Stellmacher.SectionNine.NineFourFactorResidualImage

/-!
# A literal auxiliary supplement including the quotient kernel

For the normalized (9.4) data and its exact canonical quotient factor,
the literal group F is generated by its two-residual, the initial/remote
core intersection, and its intersection with the next core. Retaining the
kernel term is essential: quotient generation alone does not remove it.
This equality feeds the all-central case's core-normalization argument.

The selected factor's derived subgroup lies in the residual image by its
proved conjugate-generation formula. The auxiliary-image decomposition
therefore places every image of an F-element in the image of the join of
its residual and the core intersection. Lift such an image representative;
the discrepancy from the original element lies in both F and the quotient
kernel, which is the next core. The reverse inclusion is immediate.

Source: Stellmacher (9.4), printed pp.51–52/PDF pp.41–42, the auxiliary
core calculation in the all-central case, with its quotient generation
made explicit, in `refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext SevenSix
universe u

public theorem nine_four_auxiliary_residual_core_supplement
    {H G K W : Type u} [Group H] [Finite H] [Group G] [Finite G]
    [Group K] [Finite K] [Group W] [Finite W] [MulDistribMulAction K W]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : AmbientSectionNineContext H S0 S P1 P2 embedding T A B)
    (hb : 1 < ctx.criticalPath.length)
    (remote : ctx.Γ.Vertex)
    (hdistance : ctx.Γ.distance remote ctx.criticalPath.firstStep = 2)
    (actor : G)
    (hactor : actor ∈ GAt ctx.Γ ctx.criticalPath.firstStep ∧
      actor ∈ Subgroup.centralizer (VAt ctx.Γ remote : Set G))
    (conjugator : G)
    (hconjugator : conjugator ∈ ⁅EAt ctx.Γ ctx.criticalPath.firstStep,
      Subgroup.zpowers actor⁆)
    (hremote : ctx.Γ.act conjugator remote ∈ Neighborhood ctx.Γ ctx.criticalPath.a)
    (hne : ctx.Γ.act conjugator remote ≠ ctx.criticalPath.firstStep)
    (hgenerate : (GAt ctx.Γ ctx.criticalPath.firstStep ⊓ GAt ctx.Γ ctx.criticalPath.a) ⊔
      Subgroup.zpowers actor = GAt ctx.Γ ctx.criticalPath.firstStep)
    (f : GAt ctx.Γ ctx.criticalPath.firstStep →* K) (hsurj : Function.Surjective f)
    (hkernel : f.ker = pCore 2 (GAt ctx.Γ ctx.criticalPath.firstStep))
    (hinvolution : _root_.IsInvolution (f ⟨actor, hactor.1⟩))
    (hfactor : SectionOne.IsOneSevenFactor (V := W)
      (⁅SectionOne.oddCore K, Subgroup.zpowers (f ⟨actor, hactor.1⟩)⁆ ⊔
        Subgroup.zpowers (f ⟨actor, hactor.1⟩))) :
    let R0 := QAt ctx.Γ ctx.criticalPath.a ⊓ QAt ctx.Γ (ctx.Γ.act conjugator remote)
    let F := R0 ⊔ Subgroup.zpowers actor
    F = (twoResidualIn F ⊔ R0) ⊔ (F ⊓ QAt ctx.Γ ctx.criticalPath.firstStep) := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let P := GAt Γ cp.firstStep
  let R0 := QAt Γ cp.a ⊓ QAt Γ (Γ.act conjugator remote)
  let F := R0 ⊔ Subgroup.zpowers actor
  let R := twoResidualIn F
  let J := R ⊔ R0
  let D := ⁅SectionOne.oddCore K, Subgroup.zpowers (f ⟨actor,hactor.1⟩)⁆ ⊔
    Subgroup.zpowers (f ⟨actor,hactor.1⟩)
  have hpacket := nine_four_factor_le_auxiliary_image ctx hb remote hdistance actor hactor
    conjugator hconjugator hremote hne hgenerate f hsurj hkernel hinvolution hfactor.1
  have hclosure := nine_four_factor_residual_image ctx hb remote hdistance actor hactor
    conjugator hconjugator hremote hne hgenerate f hsurj hkernel hinvolution hfactor
  have hderived : (commutator D).map D.subtype ≤ (R.subgroupOf P).map f := by
    rw [hclosure]
    intro d hd
    exact Subgroup.subset_closure ⟨1,⟨d,hd⟩,by simp⟩
  have himage : (F.subgroupOf P).map f ≤ (J.subgroupOf P).map f := by
    rw [hpacket.2]
    exact sup_le
      (hderived.trans (Subgroup.map_mono (Subgroup.subgroupOf_mono _ le_sup_left)))
      (Subgroup.map_mono (Subgroup.subgroupOf_mono _ le_sup_right))
  have hJF : J ≤ F := sup_le (twoResidualIn_le F) le_sup_left
  have hQaP : QAt Γ cp.a ≤ P :=
    ((local_cores_le_edge_sylow ctx.sectionSeven Γ cp).1.trans cp.S_le_edge_stabilizers).trans
      inf_le_right
  have hFP : F ≤ P := sup_le (inf_le_left.trans hQaP) (Subgroup.zpowers_le.mpr hactor.1)
  change F = J ⊔ (F ⊓ QAt Γ cp.firstStep)
  apply le_antisymm ?_ (sup_le hJF inf_le_left)
  intro z hz
  let zP : P := ⟨z,hFP hz⟩
  have hzimage : f zP ∈ (J.subgroupOf P).map f := himage (Subgroup.mem_map_of_mem f hz)
  obtain ⟨y,hy,heq⟩ := hzimage
  have hdelta : y⁻¹*zP ∈ f.ker := by
    simp only [MonoidHom.mem_ker,map_mul,map_inv,heq,inv_mul_cancel]
  rw [hkernel] at hdelta
  have hQ : ((y⁻¹*zP:P):G) ∈ QAt Γ cp.firstStep := by
    change ((y⁻¹*zP:P):G) ∈ Γ.twoCoreAt cp.firstStep
    rw [Γ.twoCoreAt_def]
    exact Subgroup.mem_map_of_mem P.subtype hdelta
  have hFdelta : ((y⁻¹*zP:P):G) ∈ F :=
    F.mul_mem (F.inv_mem (hJF hy)) hz
  have hproduct := (J ⊔ (F ⊓ QAt Γ cp.firstStep)).mul_mem
    (Subgroup.mem_sup_left hy) (Subgroup.mem_sup_right ⟨hFdelta,hQ⟩)
  change (y:G) * ((y:G)⁻¹*z) ∈ J ⊔ (F ⊓ QAt Γ cp.firstStep) at hproduct
  simpa only [mul_inv_cancel_left] using hproduct

end Stellmacher.SectionNine
