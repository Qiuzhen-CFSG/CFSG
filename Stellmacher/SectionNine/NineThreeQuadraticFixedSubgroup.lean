module
public import Stellmacher.SectionNine.GeneratedContext
public import Stellmacher.SectionFiveToSeven.Result7_6.LocalFacts
public import Stellmacher.SectionEight.LocalQuotientSylowActionSetup
public import Stellmacher.SectionEight.LocalQuotientFixedSylowGeneration
public import Stellmacher.SectionOne.QuadraticSubgroupFixedHyperplane
public import Stellmacher.QuotientModuleWitness
public import Stellmacher.QuotientModuleFixedPoints
public import Stellmacher.QuotientModuleCommutator

/-!
# A quadratic fixed subgroup in the original graph group

For the initial center of a genuine Section Nine context, let Y be any
two-subgroup of its stabilizer acting quadratically on the center. If an
ambient subgroup R does not contain that center, there is W≤Y of index at
most two whose fixed subgroup in the center is not contained in R.

Choose a Sylow of the local stabilizer containing Y and use the actual
faithful center quotient. The original vertex module is generated by its
Sylow-fixed points, and the odd core supplements the supplied Sylow image.
The hereditary form of (1.2) gives a subgroup of the image of Y with index
at most two and a fixed vector outside R. Pull it back inside Y: the
relative-index comap identity preserves the index bound, and the exact
witness action identifies its fixed vectors with the ambient centralizer.

This is the first application of (1.2) in the proof of (9.3), printed p.49 /
PDF p.39 of `refs/files/stellmacher-n-group.pdf`. No quotient presentation,
action instance, or ambient fixed-space containment is replaced.
-/

namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext SevenSix
universe u

private theorem cardinal_mul_relative_index
    {G : Type u} [Group G] [Finite G] (W Y : Subgroup G) (hWY : W ≤ Y) :
    Nat.card W * W.relIndex Y = Nat.card Y := by
  have h := Subgroup.relIndex_mul_relIndex (⊥ : Subgroup G) W Y bot_le hWY
  simpa only [Subgroup.relIndex_bot_left] using h

public theorem nine_three_quadratic_fixed_subgroup
    {G : Type u} [Group G] [Finite G] {T A B : Subgroup G}
    (ctx : SectionNineLocalContext G T A B)
    (Y : Subgroup G) (hYP : Y ≤ GAt ctx.Γ ctx.criticalPath.a)
    (hYp : IsPGroup 2 Y)
    (hquad : ⁅⁅ZAt ctx.Γ ctx.criticalPath.a,Y⁆,Y⁆ = ⊥)
    (R : Subgroup G) (hnot : ¬ ZAt ctx.Γ ctx.criticalPath.a ≤ R) :
    ∃ W : Subgroup G, W ≤ Y ∧ Nat.card Y ≤ 2 * Nat.card W ∧
      ¬ ZAt ctx.Γ ctx.criticalPath.a ⊓ Subgroup.centralizer (W : Set G) ≤ R := by
  classical
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let V := ZAt Γ cp.a
  let P := GAt Γ cp.a
  have hfirst : cp.firstStep ∈ neighborhood Γ cp.a :=
    (mem_neighborhood_iff_adjacent Γ).mpr cp.firstStep_adj
  let _ : IsElementaryAbelian 2 V := z_isElementaryAbelian_of_neighbor ctx.sectionSeven Γ hfirst
  have hVP : V ≤ P := ((lemma_seven_three ctx.sectionSeven Γ).center_core
    cp.a cp.firstStep hfirst).trans ((omegaOneCenter_le_centerAmbient _).trans
      ((Subgroup.map_subtype_le _).trans (by
        change QAt Γ cp.a ≤ P
        rw [QAt,q,Γ.twoCoreAt_def]
        exact Subgroup.map_subtype_le _)))
  obtain ⟨w⟩ := exists_quotientModuleWitness P V hVP (stabilizer_le_normalizer_z Γ cp.a)
  let _ := w.groupX
  let _ := w.finiteX
  let _ := MulDistribMulAction.compHom V w.action
  let Y1 := Y.subgroupOf P
  have hY1 : Y1.map P.subtype = Y := Subgroup.map_subgroupOf_eq_of_le hYP
  have hY1p : IsPGroup 2 Y1 := hYp.of_equiv (Subgroup.subgroupOfEquivOfLe hYP).symm
  obtain ⟨U,hYU⟩ := hY1p.exists_le_sylow
  let Ub := U.mapSurjective w.surjective
  let Yb := Y1.map w.projection
  have hYUb : Yb ≤ (Ub : Subgroup w.X) := Subgroup.map_mono hYU
  have hsetup := SectionEight.local_quotient_sylow_action_setup ctx.sectionSeven Γ cp w
  have hgen := SectionEight.local_quotient_fixed_sylow_generation Γ cp.a w U
  have hquadFixed : commutatorAction Yb V ≤ FixedPoints.subgroup Yb V := by
    apply (Subgroup.map_le_map_iff_of_injective V.subtype_injective).mp
    rw [w.fixedPoints_map_subtype Y hYP]
    apply le_inf (Subgroup.map_subtype_le _)
    rw [w.commutatorAction_image_map_subtype Y hYP]
    exact Subgroup.commutator_eq_bot_iff_le_centralizer.mp hquad
  have hquadAction : IsQuadraticAction Yb V := by
    apply bot_unique
    change Subgroup.closure {z : V | ∃ a : Yb, ∃ v : V,
      v ∈ commutatorAction Yb V ∧ z = v⁻¹ * a • v} ≤ ⊥
    apply (Subgroup.closure_le _).mpr
    rintro z ⟨a,v,hv,rfl⟩
    have hf := (FixedPoints.mem_subgroup (M := Yb) (a := v)).mp (hquadFixed hv) a
    simp [hf]
  let R1 := R.subgroupOf V
  have hR1 : R1 ≠ ⊤ := by
    intro he
    apply hnot
    intro v hv
    have hh : (⟨v,hv⟩ : V) ∈ R1 := he.ge (Subgroup.mem_top _)
    exact hh
  obtain ⟨Y0,hY0,hcard,hescape⟩ :=
    SectionOne.exists_fixed_hyperplane_of_quadratic_subgroup hsetup.1 Ub
      (hsetup.2 U).symm hgen Yb hYUb hquadAction R1 hR1
  let W1 := Y1 ⊓ Y0.comap w.projection
  let W := W1.map P.subtype
  have hWY : W ≤ Y := by
    rw [← hY1]
    exact Subgroup.map_mono inf_le_left
  have hWP : W ≤ P := Subgroup.map_subtype_le _
  have hWimage : (W.subgroupOf P).map w.projection = Y0 := by
    rw [show W = W1.map P.subtype from rfl,subgroupOf_map_subtype_eq]
    apply le_antisymm
    · rintro b ⟨a,ha,rfl⟩
      exact ha.2
    · intro b hb
      obtain ⟨a,ha,he⟩ := hY0 hb
      exact ⟨a,⟨ha,show w.projection a ∈ Y0 from he ▸ hb⟩,he⟩
  have hrelBound : Y0.relIndex Yb ≤ 2 := by
    have hh := cardinal_mul_relative_index Y0 Yb hY0
    have hp : 0 < Nat.card Y0 := Nat.card_pos
    nlinarith
  have hrelEq : W.relIndex Y = Y0.relIndex Yb := by
    rw [← hY1,show W = W1.map P.subtype from rfl,
      Subgroup.relIndex_map_map_of_injective W1 Y1 P.subtype_injective]
    change (Y1 ⊓ Y0.comap w.projection).relIndex Y1 = _
    rw [Subgroup.inf_relIndex_left,Subgroup.relIndex_comap]
  refine ⟨W,hWY,?_,?_⟩
  · have hh := cardinal_mul_relative_index W Y hWY
    rw [hrelEq] at hh
    nlinarith
  · intro hcontained
    apply hescape
    intro v hv
    have hvW : v ∈ FixedPoints.subgroup ((W.subgroupOf P).map w.projection) V := by
      rw [FixedPoints.mem_subgroup] at hv ⊢
      intro actor
      exact hv ⟨actor,hWimage.le actor.property⟩
    have hvAmbient : (v : G) ∈ V ⊓ Subgroup.centralizer (W : Set G) := by
      rw [← w.fixedPoints_map_subtype W hWP]
      exact Subgroup.mem_map_of_mem V.subtype hvW
    exact hcontained hvAmbient

end Stellmacher.SectionNine
