module

public import Stellmacher.SectionNine.NineInitialEdgeCoreProduct
public import Stellmacher.SectionFiveToSeven.LocalResidualCoreContainment

/-!
# The literal auxiliary residual core in (9.4)

For the source subgroup F generated by the intersection of the initial
and remote cores with a local actor, the two-core Q of its two-residual
lies in the next vertex core. It is normalized by F and has index at most
two over its intersection with the initial vertex core.

The local residual-core containment theorem applies to any subgroup of the
next stabilizer, so F needs no extra normality hypothesis. The two adjacent
cores generate the initial edge, which has index two over the initial core
by (9.3). Relative-index monotonicity then gives the bound on Q. Normality
of the residual and characteristicity of its two-core give F-invariance.

This supplies the actor-core geometry for source relation (3) in
Stellmacher (9.4), printed p.51/PDF p.41 of the full article. The graph
and ambient groups stay distinct; this is common input to both cases.
-/

namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext SevenSix
universe u

public theorem nine_four_auxiliary_core_geometry
    {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : AmbientSectionNineContext H S0 S P1 P2 embedding T A B)
    (hb : 1 < ctx.criticalPath.length)
    (remote : ctx.Γ.Vertex) (actor : G)
    (hactor : actor ∈ GAt ctx.Γ ctx.criticalPath.firstStep) :
    let F := (QAt ctx.Γ ctx.criticalPath.a ⊓ QAt ctx.Γ remote) ⊔
      Subgroup.zpowers actor
    let Q := twoCoreIn (twoResidualIn F)
    F ≤ GAt ctx.Γ ctx.criticalPath.firstStep ∧
      Q ≤ QAt ctx.Γ ctx.criticalPath.firstStep ∧
      (QAt ctx.Γ ctx.criticalPath.a).relIndex Q ≤ 2 ∧
      F ≤ Subgroup.normalizer (Q : Set G) := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let Qa := QAt Γ cp.a
  let Qn := QAt Γ cp.firstStep
  let edge := GAt Γ cp.a ⊓ GAt Γ cp.firstStep
  let F := (Qa ⊓ QAt Γ remote) ⊔ Subgroup.zpowers actor
  let Q := twoCoreIn (twoResidualIn F)
  have hQa : Qa ≤ edge :=
    (local_cores_le_edge_sylow ctx.sectionSeven Γ cp).1.trans cp.S_le_edge_stabilizers
  have hQn : Qn ≤ edge :=
    (local_cores_le_edge_sylow ctx.sectionSeven Γ cp).2.trans cp.S_le_edge_stabilizers
  have hF : F ≤ GAt Γ cp.firstStep :=
    sup_le (inf_le_left.trans (hQa.trans inf_le_right))
      (Subgroup.zpowers_le.mpr hactor)
  have hQ : Q ≤ Qn := local_residual_core_le_vertex_core ctx.sectionSeven Γ
    cp.firstStep cp.a
      ((mem_neighborhood_iff_adjacent Γ).mpr (Γ.adjacent_symm cp.firstStep_adj)) F hF
  have hcount := (Qa.subgroupOf edge).index_mul_card
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hQa).toEquiv] at hcount
  have hindex : Qa.relIndex edge = 2 :=
    Nat.eq_of_mul_eq_mul_right Nat.card_pos
      (hcount.trans (nine_initial_edge_core_product ctx hb).2)
  have hsmall : Qa.relIndex Q ≤ 2 := by
    rw [← hindex]
    exact Subgroup.relIndex_le_of_le_right (hQ.trans hQn)
      (Subgroup.index_ne_zero_of_finite)
  have hQF : Q ≤ F := (twoCoreIn_le _).trans (twoResidualIn_le _)
  have hnormal : (Q.subgroupOf F).Normal :=
    twoCoreIn_normal_of_normal (twoResidualIn F) F (twoResidualIn_le F)
      (twoResidualIn_normal F)
  exact ⟨hF, hQ, hsmall,
    (Subgroup.normal_subgroupOf_iff_le_normalizer hQF).mp hnormal⟩

end Stellmacher.SectionNine
