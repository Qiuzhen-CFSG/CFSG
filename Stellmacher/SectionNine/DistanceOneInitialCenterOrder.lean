module
public import Stellmacher.SectionNine.DistanceOneFixedComplement
public import Stellmacher.SectionNine.DistanceOneRelativeDoubleSL2
/-!
# The initial center has order sixteen at critical distance one

For the actual ambient Section Nine context, extraction data, and faithful
quotient witness at critical length one, the initial vertex center has
order sixteen. The relative double-SL2 theorem gives order sixteen for the
module generated by the odd commutator actor. The fixed-complement theorem
proves its fixed subgroup trivial. Since this actor lies in the odd core
and the center is elementary abelian of exponent two, coprime splitting
makes the commutator module the whole original center.

This is the first assertion of source (8) in Stellmacher (9.1), Journal of
Algebra 190 (1997), printed p.47, `refs/files/stellmacher-n-group.pdf`.
The proof keeps the supplied witness action throughout and does not assume
the subsequent faithful-quotient or core-equality conclusions.
-/
namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext SevenSix
universe u
public theorem distance_one_initial_center_card_sixteen
    {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : AmbientSectionNineContext H S0 S P1 P2 embedding T A B)
    (hb : ctx.criticalPath.length = 1) (data : DistanceOneActionData ctx)
    (w : QuotientModuleWitness (GAt ctx.Γ ctx.criticalPath.a)
      (GAt ctx.Γ ctx.criticalPath.a ⊓ Subgroup.centralizer
        (ZAt ctx.Γ ctx.criticalPath.a : Set G)) (ZAt ctx.Γ ctx.criticalPath.a)) : Nat.card (ZAt ctx.Γ ctx.criticalPath.a) = 16 := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let next := Γ.act data.x⁻¹ cp.a
  let P := GAt Γ cp.a
  let Za := ZAt Γ cp.a
  let V := (z Γ cp.a ⊓ stabilizer Γ next) ⊔ (z Γ next ⊓ stabilizer Γ cp.a)
  let _ := w.groupX
  let _ := w.finiteX
  let _ := MulDistribMulAction.compHom Za w.action
  let X := (V.subgroupOf P).map w.projection
  let F := ⁅SectionOne.oddCore w.X,X⁆
  have hfirst : cp.firstStep ∈ neighborhood Γ cp.a :=
    (mem_neighborhood_iff_adjacent Γ).mpr cp.firstStep_adj
  let _ : IsElementaryAbelian 2 Za := z_isElementaryAbelian_of_neighbor ctx.sectionSeven Γ hfirst
  let _ : (SectionOne.oddCore w.X).Normal := pPrimeCore_normal
  have hFW : F ≤ SectionOne.oddCore w.X := Subgroup.commutator_le_left _ _
  have hcop : Nat.Coprime (Nat.card F) (Nat.card Za) := by
    obtain ⟨n,hn⟩ := (IsElementaryAbelian.isPGroup 2 Za).exists_card_eq
    rw [hn]
    exact ((pPrimeCore_coprime_card (p := 2) (G := w.X)).of_dvd_right
      (Subgroup.card_dvd_of_le hFW)).symm.pow_right n
  have hsplit : IsCompl (FixedPoints.subgroup F Za) (commutatorAction F Za) :=
    isCompl_fixedPointSubgroup_commutatorAction_of_solvable_coprime_of_isMulCommutative
      (G := Za) (A := F)
      (Group.isSolvable_of_comm fun x y => IsMulCommutative.is_comm.comm x y)
      hcop inferInstance
  have hfixed : FixedPoints.subgroup F Za = ⊥ :=
    distance_one_relative_fixed_complement_trivial ctx hb data w
  have htop : commutatorAction F Za = ⊤ := by
    have hh := hsplit.sup_eq_top
    rwa [hfixed,bot_sup_eq] at hh
  have hcard : Nat.card (commutatorAction F Za) = 16 :=
    (distance_one_relative_double_sl2 ctx hb data w).2
  rw [htop,Nat.card_congr Subgroup.topEquiv.toEquiv] at hcard
  exact hcard
end Stellmacher.SectionNine
