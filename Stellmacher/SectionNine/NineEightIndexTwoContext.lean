module
public import Stellmacher.SectionNine.NineEightReverseCenter
public import Stellmacher.SectionNine.NineEightReverseExtraction
public import Stellmacher.SectionNine.NineEightCriticalExtractionConsequences

/-!
# The full (9.8) reduction to an actual index-two context

Assume the original terminal center lies in the first-step module and the
critical length exceeds three. Then some ambient Section Nine context of
the same length satisfies the exact index-two path hypothesis of (9.7).
This is an unconditional reduction: no distance conclusion from (9.7) or
(9.8) is assumed.

Suppose no such context exists. The initial W extraction cannot have its
new center in the initial stabilizer, because that branch produces the
required path index. The proper-normalizer and actual transvection
arguments then force reverse center containment. The symmetric extraction
gives a new initial neighbor; its center again escapes the opposite
stabilizer. A third extraction either gives the forbidden index-two
context or produces a replacement center crossing the second extracted
edge. This center lies in the earlier W, so its universal crossing-actor
generation makes the earlier local group generated by that edge and
center. The transported proper-normalizer conclusion says that exact
join is proper, a contradiction.

Every reorientation uses an actual commuting critical pair, exact distance,
and prescribed first neighbor. Source: the complete proof of Stellmacher
(9.8), printed pp.55–56/PDF pp.45–46 of `refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext SevenSix
universe u

private theorem critical_data_of_neighbor_core_escape
    {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : AmbientSectionNineContext H S0 S P1 P2 embedding T A B)
    {left right prescribed : ctx.Γ.Vertex}
    (hadj : ctx.Γ.adjacent left prescribed)
    (htail : ctx.Γ.distance prescribed right < ctx.criticalPath.length)
    (hnot : ¬ ZAt ctx.Γ left ≤ QAt ctx.Γ right)
    (hcontain : ZAt ctx.Γ right ≤ VAt ctx.Γ prescribed)
    (habelian : IsMulCommutative (VAt ctx.Γ prescribed)) :
    IsCriticalPair ctx.Γ left right ∧
      ctx.Γ.distance left right = ctx.Γ.distance prescribed right + 1 ∧
      ⁅ZAt ctx.Γ left,ZAt ctx.Γ right⁆ = ⊥ := by
  have hupper := nine_eight_adjacent_distance_le ctx.Γ hadj (target := right)
  have hlower : ctx.criticalPath.length ≤ ctx.Γ.distance left right := by
    by_contra hlt
    exact hnot (critical_minimality ctx.Γ ctx.criticalPath (by omega))
  have hdistance : ctx.Γ.distance left right = ctx.criticalPath.length := by omega
  refine ⟨⟨?_,hnot⟩,by omega,?_⟩
  · rw [hdistance,← ctx.criticalPath.endpoint_distance]
    exact ctx.criticalPath.critical.1
  · have hleftV := nine_seven_neighbor_center_le_module ctx.Γ (ctx.Γ.adjacent_symm hadj)
    exact Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
      (hleftV.trans ((Subgroup.le_centralizer_iff_isMulCommutative.mpr habelian).trans
        (Subgroup.centralizer_le hcontain)))

public theorem nine_eight_index_two_context
    {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : AmbientSectionNineContext H S0 S P1 P2 embedding T A B)
    (hb : 3 < ctx.criticalPath.length)
    (hcontain : ZAt ctx.Γ ctx.criticalPath.a' ≤ VAt ctx.Γ ctx.criticalPath.firstStep) :
    ∃ shifted : AmbientSectionNineContext H S0 S P1 P2 embedding T A B,
      shifted.criticalPath.length = ctx.criticalPath.length ∧
      ∃ third, IsCriticalPathOffset shifted.Γ shifted.criticalPath 3 third ∧
        QuotientCardEq (VAt shifted.Γ shifted.criticalPath.firstStep)
          (VAt shifted.Γ shifted.criticalPath.firstStep ⊓ VAt shifted.Γ third) 2 := by
  classical
  by_contra hnoIndex
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  have hlong : 1 < cp.length := by change 3 < cp.length at hb; omega
  obtain ⟨m,hm,hindexM,hnotM,hnoncommM,_⟩ := nine_eight_initial_center_extraction ctx hb hcontain
  have hMescape : ¬ ZAt Γ m ≤ GAt Γ cp.a := by
    intro hcontained
    exact hnoIndex ⟨ctx,rfl,nine_eight_contained_center_path_index ctx hb hcontain
      m hm hcontained hindexM hnotM hnoncommM⟩
  have hreverse := nine_eight_reverse_center_contained_of_extracted_escape ctx hb hcontain
    m hm hindexM hnotM hMescape
  have htail : Γ.distance cp.firstStep cp.a' < cp.length := by
    have hh := path_distance_le Γ cp 1 cp.length (by omega) le_rfl
    rw [cp.path_first,cp.path_end] at hh
    omega
  have htailReverse : Γ.distance cp.a' cp.firstStep < cp.length := by
    rwa [Γ.distance_symm]
  have hMnotCore : ¬ ZAt Γ m ≤ QAt Γ cp.firstStep := by
    intro hle
    exact hMescape (hle.trans (((lemma_seven_three ctx.sectionSeven Γ).sylow_and_core
      cp.firstStep cp.a ((mem_neighborhood_iff_adjacent Γ).mpr
        (Γ.adjacent_symm cp.firstStep_adj)) default).2.2))
  have hMadj : Γ.adjacent m cp.a' := Γ.adjacent_symm ((mem_neighborhood_iff_adjacent Γ).mp hm)
  have hterminalAbelian : IsMulCommutative (VAt Γ cp.a') := by
    let _ : IsElementaryAbelian 2 (VAt Γ cp.a') :=
      (nine_three_second_extraction_inputs ctx.toLocalContext hlong).2.2.1
    infer_instance
  obtain ⟨hMcritical,hMdistance,hMcomm⟩ := critical_data_of_neighbor_core_escape ctx
    hMadj htailReverse hMnotCore hreverse hterminalAbelian
  obtain ⟨l,hl,hindexL,hnotL,hnoncommL,hgenerateL⟩ :=
    nine_eight_reverse_crossing_extraction ctx hb hreverse m hm hMescape
  have hLescape : ¬ ZAt Γ l ≤ GAt Γ m := by
    intro hcontained
    exact hnoIndex ((nine_eight_critical_extraction_consequences ctx hb m cp.firstStep cp.a'
      hMcritical hMadj hMdistance hMcomm hreverse l hl hindexL hnotL hnoncommL).2 hcontained)
  have hLnotCore : ¬ ZAt Γ l ≤ QAt Γ cp.a' := by
    intro hle
    exact hLescape (hle.trans (((lemma_seven_three ctx.sectionSeven Γ).sylow_and_core
      cp.a' m hm default).2.2))
  have hLadj : Γ.adjacent l cp.firstStep := Γ.adjacent_symm
    ((mem_neighborhood_iff_adjacent Γ).mp hl)
  have hfirstAbelian : IsMulCommutative (VAt Γ cp.firstStep) := by
    let _ : IsElementaryAbelian 2 (VAt Γ cp.firstStep) :=
      ((lemma_seven_five ctx.sectionSeven Γ cp ctx.commutator_eq).longer_case hlong).1
    infer_instance
  obtain ⟨hLcritical,hLdistance,hLcomm⟩ := critical_data_of_neighbor_core_escape ctx
    hLadj htail hLnotCore hcontain hfirstAbelian
  obtain ⟨m',hm',hindexM',hnotM',hnoncommM',_⟩ :=
    nine_eight_crossing_extraction_of_critical_pair ctx hb l cp.a' cp.firstStep
      hLcritical hLadj hLdistance hLcomm hcontain
  have hM'consequences := nine_eight_critical_extraction_consequences ctx hb l cp.a' cp.firstStep
    hLcritical hLadj hLdistance hLcomm hcontain m' hm' hindexM' hnotM' hnoncommM'
  have hM'escape : ¬ ZAt Γ m' ≤ GAt Γ l := fun hle => hnoIndex (hM'consequences.2 hle)
  have hM'W : ZAt Γ m' ≤ GeneratedNeighborhoodV Γ m :=
    (nine_seven_neighbor_center_le_module Γ ((mem_neighborhood_iff_adjacent Γ).mp hm')).trans
      (nine_eight_v_le_generated_neighborhood Γ
        ((mem_neighborhood_iff_adjacent Γ).mpr hMadj))
  have hgenerate := hgenerateL (ZAt Γ m') hM'W hM'escape
  have hproper := hM'consequences.1
  rw [inf_comm] at hgenerate
  exact hproper.ne hgenerate

end Stellmacher.SectionNine
