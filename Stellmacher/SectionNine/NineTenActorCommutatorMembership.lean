module

public import Stellmacher.SectionNine.NineTenNormalizedExtraction
public import Stellmacher.SectionNine.DistanceOneCenterResidual

/-!
# The actual (9.10) conjugator satisfies the actor hypothesis of (9.4)

The strengthened prescribed extraction puts its two-residual inside the
commutator with the same actor. Residual monotonicity embeds that residual
in the first local two-residual, since the extracted group lies in the
first stabilizer. Apply the containment to the recorded residual conjugator
and then take its inverse, as required by the graph action convention.

This is the transfer needed when Stellmacher (9.10), printed p.57, applies
(9.4) at the third path vertex. The theorem uses the actual geometric data;
it does not identify the generic terminal-module extraction group with
the smaller group generated by two conjugate centers in the source.
-/

namespace Stellmacher.SectionNine

open Later SectionsFiveToSeven CosetGraphContext SevenSix

public theorem nine_ten_conjugator_mem_actor_commutator
    {G : Type*} [Group G] [Finite G] {T A B : Subgroup G}
    (Γ : CosetGraphContext G T A B) (vertex neighbor : Γ.Vertex)
    (V E A0 : Subgroup G) (actor : G)
    (data : NineThreeGeometricData Γ vertex neighbor V E A0 actor)
    (hactor : twoResidualIn E ≤ ⁅twoResidualIn E, Subgroup.zpowers actor⁆) :
    data.x⁻¹ ∈ ⁅EAt Γ vertex, Subgroup.zpowers actor⁆ := by
  have hresidual : twoResidualIn E ≤ EAt Γ vertex := by
    change twoResidualIn E ≤ Γ.twoResidualAt vertex
    rw [Γ.twoResidualAt_def]
    exact twoResidualIn_mono E (stabilizer Γ vertex) data.group_le
  exact (⁅EAt Γ vertex, Subgroup.zpowers actor⁆).inv_mem
    ((Subgroup.commutator_mono hresidual le_rfl) (hactor data.residual_mem))

end Stellmacher.SectionNine
