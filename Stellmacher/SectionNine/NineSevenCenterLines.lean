module

public import Stellmacher.SectionNine.NineSevenShiftedIntersections
public import Stellmacher.SectionNine.NineSevenCenterJoin

/-!
# Rank-two neighbor-center geometry

Adjacent nontrivial vertex centers cannot coincide: their common subgroup
would be a normal two-subgroup of the group generated by the edge stabilizers.
Consequently, nontrivial neighbor centers contained in a four-element middle
center have order two. If their join is the middle center, cubic two-arc
transitivity makes the three neighbor centers distinct. Their nonidentity
elements exhaust the three nonidentity elements of the middle center, giving
every order-two line and pairwise disjointness.

The exported local package takes the Sylow-center join identification as an
explicit upstream input; it does not assume line witnesses or disjointness.
The ambient identification and final ambient theorem are separate work.

Source: Stellmacher, printed p.53 / PDF p.43, (9.7), the sentence beginning
“Hence, there exist” and the ensuing order-four direct-product contradiction,
in `refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionNine

open Later SectionsFiveToSeven CosetGraphContext SevenSix

universe u v

variable {G : Type u} [Group G] [Finite G] {S P1 P2 : Subgroup G}

public theorem nine_seven_adjacent_centers_ne
    (h7 : SectionSevenHypotheses G S P1 P2)
    (Γ : CosetGraphContext G S P1 P2) {middle neighbor : Γ.Vertex}
    (hadj : Γ.adjacent middle neighbor) (hne : ZAt Γ middle ≠ ⊥) :
    ZAt Γ middle ≠ ZAt Γ neighbor := by
  intro heq
  have hgen := (edge_sectionThree_data h7 Γ
    ((mem_neighborhood_iff_adjacent Γ).mpr hadj) default).2.2.2.2.1
  have hnorm : (ZAt Γ middle).Normal := by
    apply Subgroup.normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hgen]
    refine sup_le (stabilizer_le_normalizer_z Γ middle) ?_
    rw [heq]
    exact stabilizer_le_normalizer_z Γ neighbor
  let _ := hnorm
  let _ := z_isElementaryAbelian_of_neighbor h7 Γ
    ((mem_neighborhood_iff_adjacent Γ).mpr hadj)
  have hcore : ZAt Γ middle ≤ pCore 2 G :=
    le_sSup ⟨hnorm, IsElementaryAbelian.isPGroup 2 (z Γ middle)⟩
  rw [h7.twoCore_eq_bot] at hcore
  exact hne (le_bot_iff.mp hcore)

public theorem nine_seven_neighbor_card_two_of_center_join
    (h7 : SectionSevenHypotheses G S P1 P2)
    (Γ : CosetGraphContext G S P1 P2) {middle neighbor : Γ.Vertex}
    (hadj : Γ.adjacent middle neighbor)
    (hcard : Nat.card (ZAt Γ middle) = 4)
    (hne : ZAt Γ neighbor ≠ ⊥) (hle : ZAt Γ neighbor ≤ ZAt Γ middle) :
    Nat.card (ZAt Γ neighbor) = 2 := by
  have hmiddleNe : ZAt Γ middle ≠ ⊥ := by
    intro hbot
    simp [hbot] at hcard
  have hproper := nine_seven_adjacent_centers_ne h7 Γ hadj hmiddleNe
  have hlt : Nat.card (ZAt Γ neighbor) < Nat.card (ZAt Γ middle) := by
    apply lt_of_le_of_ne (Subgroup.card_le_of_le hle)
    intro heq
    exact hproper (Subgroup.eq_of_le_of_card_ge hle heq.ge).symm
  have hpos := (Subgroup.one_lt_card_iff_ne_bot _).mpr hne
  have hdvd := Subgroup.card_dvd_of_le hle
  rw [hcard] at hlt hdvd
  have hcases : Nat.card (ZAt Γ neighbor) = 1 ∨
      Nat.card (ZAt Γ neighbor) = 2 ∨ Nat.card (ZAt Γ neighbor) = 4 := by
    have := (Nat.dvd_prime_pow Nat.prime_two).mp
      (show Nat.card (ZAt Γ neighbor) ∣ 2 ^ 2 from hdvd)
    obtain ⟨power, hpower, heq⟩ := this
    interval_cases power <;> simp_all
  omega

public theorem nine_seven_rank_two_neighbor_centers_distinct
    (h7 : SectionSevenHypotheses G S P1 P2)
    (Γ : CosetGraphContext G S P1 P2)
    {left middle right : Γ.Vertex}
    (hmodel : QuotientIsModel (GAt Γ middle) (QAt Γ middle) SL2Two)
    (hmoduleCard : Nat.card (VAt Γ middle) = 4)
    (hcenterCard : Nat.card (ZAt Γ left) = 2)
    (hleft : Γ.adjacent middle left) (hright : Γ.adjacent middle right)
    (hdistinct : left ≠ right) : ZAt Γ left ≠ ZAt Γ right := by
  intro hequal
  have hall (neighbor : Γ.Vertex) (hneighbor : Γ.adjacent middle neighbor) :
      ZAt Γ neighbor = ZAt Γ left := by
    by_cases heq : left = neighbor
    · rw [← heq]
    obtain ⟨actor, hactorLeft, _, hactorRight⟩ := nine_seven_two_arc_transport
      h7 Γ hleft hright hdistinct hleft hneighbor heq ⟨1, Γ.act_one middle⟩ hmodel
    have hmap := congrArg
      (fun subgroup : Subgroup G => subgroup.map (MulAut.conj actor⁻¹).toMonoidHom) hequal
    change (z Γ left).map _ = (z Γ right).map _ at hmap
    rw [← z_act, ← z_act, hactorLeft, hactorRight] at hmap
    exact hmap.symm
  have hmodule : VAt Γ middle = ZAt Γ left := by
    apply le_antisymm
    · change v Γ middle ≤ ZAt Γ left
      rw [v, Γ.vAt_def]
      apply sSup_le
      rintro subgroup ⟨neighbor, hneighbor, rfl⟩
      exact (hall neighbor ((mem_neighborhood_iff_adjacent Γ).mp hneighbor)).le
    · exact nine_seven_neighbor_center_le_module Γ hleft
  rw [hmodule, hcenterCard] at hmoduleCard
  omega

public theorem nine_seven_order_two_subgroups_disjoint
    {left right : Subgroup G} (hleft : Nat.card left = 2)
    (hright : Nat.card right = 2) (hne : left ≠ right) : Disjoint left right := by
  apply disjoint_iff.mpr
  have hdvd := Subgroup.card_dvd_of_le (show left ⊓ right ≤ left from inf_le_left)
  rw [hleft] at hdvd
  rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with hone | htwo
  · exact Subgroup.card_eq_one.mp hone
  · have hfirst := Subgroup.eq_of_le_of_card_ge
      (show left ⊓ right ≤ left from inf_le_left) (by omega)
    have hsecond := Subgroup.eq_of_le_of_card_ge
      (show left ⊓ right ≤ right from inf_le_right) (by omega)
    exact (hne (hfirst.symm.trans hsecond)).elim

public theorem nine_seven_order_two_eq_of_common
    {left right : Subgroup G} (hleft : Nat.card left = 2)
    (hright : Nat.card right = 2) {element : G}
    (hleftMem : element ∈ left) (hrightMem : element ∈ right)
    (hne : element ≠ 1) : left = right := by
  apply Subgroup.eq_of_le_of_card_ge ?_ (by omega)
  intro vector hvector
  by_cases hzero : vector = 1
  · simp [hzero]
  obtain ⟨generator, _, huniq⟩ := (Nat.card_eq_two_iff' (1 : left)).mp hleft
  have hvectorNe : (⟨vector, hvector⟩ : left) ≠ 1 := by
    intro heq
    exact hzero (congrArg Subtype.val heq)
  have helementNe : (⟨element, hleftMem⟩ : left) ≠ 1 := by
    intro heq
    exact hne (congrArg Subtype.val heq)
  have heq : vector = element := congrArg Subtype.val
    ((huniq _ hvectorNe).trans (huniq _ helementNe).symm)
  exact heq ▸ hrightMem

public theorem nine_seven_three_lines_exhaust
    {Index : Type v} [Finite Index] (plane : Subgroup G)
    (hplane : Nat.card plane = 4) (hindex : Nat.card Index = 3)
    (lines : Index → Subgroup G) (hcard : ∀ index, Nat.card (lines index) = 2)
    (hle : ∀ index, lines index ≤ plane) (hinj : Function.Injective lines)
    (line : Subgroup G) (hline : Nat.card line = 2) (hlineLe : line ≤ plane) :
    ∃ index, line = lines index := by
  classical
  have hexists (index : Index) : ∃ element : G, element ∈ lines index ∧ element ≠ 1 := by
    obtain ⟨element, hne, _⟩ := (Nat.card_eq_two_iff' (1 : lines index)).mp (hcard index)
    exact ⟨element, element.property, fun heq => hne (Subtype.ext heq)⟩
  choose point hpointMem hpointNe using hexists
  let mapping : Index → {element : plane // element ≠ 1} := fun index =>
    ⟨⟨point index, hle index (hpointMem index)⟩,
      fun heq => hpointNe index (congrArg Subtype.val heq)⟩
  have hmapping : Function.Injective mapping := by
    intro left right heq
    apply hinj
    have hpoint : point left = point right := congrArg (fun element => element.val.val) heq
    exact nine_seven_order_two_eq_of_common (hcard left) (hcard right)
      (hpointMem left) (hpoint ▸ hpointMem right) (hpointNe left)
  have htargetCard : Nat.card {element : plane // element ≠ 1} = 3 := by
    let _ := Fintype.ofFinite plane
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype_compl]
    simp only [Fintype.card_unique, ← Nat.card_eq_fintype_card, hplane]
  have hsurj := (hmapping.bijective_of_nat_card_le (by omega)).surjective
  obtain ⟨element, helementNe, _⟩ := (Nat.card_eq_two_iff' (1 : line)).mp hline
  let target : {element : plane // element ≠ 1} :=
    ⟨⟨element, hlineLe element.property⟩,
      fun heq => helementNe (Subtype.ext
        (congrArg (fun vector : plane => (vector : G)) heq))⟩
  obtain ⟨index, hindex⟩ := hsurj target
  refine ⟨index, nine_seven_order_two_eq_of_common hline (hcard index)
    element.property ?_ (fun heq => helementNe (Subtype.ext heq))⟩
  have heq : point index = (element : G) :=
    congrArg (fun element => element.val.val) hindex
  exact heq ▸ hpointMem index

public theorem nine_seven_center_lines_of_center_join
    (h7 : SectionSevenHypotheses G S P1 P2)
    (Γ : CosetGraphContext G S P1 P2) (middle : Γ.Vertex)
    (hmodel : QuotientIsModel (GAt Γ middle) (QAt Γ middle) SL2Two)
    (hcard : Nat.card (ZAt Γ middle) = 4)
    (hjoin : ZAt Γ middle = VAt Γ middle)
    (hcenters : ∀ neighbor, neighbor ∈ Neighborhood Γ middle →
      ZAt Γ neighbor ≠ ⊥ ∧ ZAt Γ neighbor ≤ ZAt Γ middle) :
    (∀ neighbor, neighbor ∈ Neighborhood Γ middle →
      Nat.card (ZAt Γ neighbor) = 2 ∧ ZAt Γ neighbor ≤ ZAt Γ middle) ∧
    (∀ line : Subgroup G, Nat.card line = 2 → line ≤ ZAt Γ middle →
      ∃ neighbor, neighbor ∈ Neighborhood Γ middle ∧ line = ZAt Γ neighbor) ∧
    (∀ left right, left ∈ Neighborhood Γ middle →
      right ∈ Neighborhood Γ middle → left ≠ right →
      Disjoint (ZAt Γ left) (ZAt Γ right)) := by
  have hcards (neighbor : Γ.Vertex) (hneighbor : neighbor ∈ Neighborhood Γ middle) :
      Nat.card (ZAt Γ neighbor) = 2 :=
    nine_seven_neighbor_card_two_of_center_join h7 Γ
      ((mem_neighborhood_iff_adjacent Γ).mp hneighbor) hcard
      (hcenters neighbor hneighbor).1 (hcenters neighbor hneighbor).2
  have hdistinct (left right : Γ.Vertex) (hleft : left ∈ Neighborhood Γ middle)
      (hright : right ∈ Neighborhood Γ middle) (hne : left ≠ right) :
      ZAt Γ left ≠ ZAt Γ right :=
    nine_seven_rank_two_neighbor_centers_distinct h7 Γ hmodel
      (hjoin ▸ hcard) (hcards left hleft)
      ((mem_neighborhood_iff_adjacent Γ).mp hleft)
      ((mem_neighborhood_iff_adjacent Γ).mp hright) hne
  refine ⟨fun neighbor hneighbor => ⟨hcards neighbor hneighbor,
    (hcenters neighbor hneighbor).2⟩, ?_, ?_⟩
  · intro line hline hlineLe
    have hdegree := (cubic_local_action_of_sl2Two_quotient Γ h7 middle hmodel).degree
    let _ : Finite {neighbor // Γ.adjacent middle neighbor} :=
      Nat.finite_of_card_ne_zero (by rw [hdegree]; decide)
    let lines : {neighbor // Γ.adjacent middle neighbor} → Subgroup G :=
      fun neighbor => ZAt Γ neighbor.val
    have hlineCards (neighbor : {neighbor // Γ.adjacent middle neighbor}) :
        Nat.card (lines neighbor) = 2 :=
      hcards neighbor.val ((mem_neighborhood_iff_adjacent Γ).mpr neighbor.property)
    have hlineContain (neighbor : {neighbor // Γ.adjacent middle neighbor}) :
        lines neighbor ≤ ZAt Γ middle :=
      (hcenters neighbor.val ((mem_neighborhood_iff_adjacent Γ).mpr neighbor.property)).2
    have hinjective : Function.Injective lines := by
      intro left right heq
      apply Subtype.ext
      by_contra hne
      exact hdistinct left.val right.val
        ((mem_neighborhood_iff_adjacent Γ).mpr left.property)
        ((mem_neighborhood_iff_adjacent Γ).mpr right.property) hne heq
    obtain ⟨neighbor, hneighbor⟩ := nine_seven_three_lines_exhaust (ZAt Γ middle)
      hcard hdegree
      lines hlineCards hlineContain hinjective line hline hlineLe
    exact ⟨neighbor.val, (mem_neighborhood_iff_adjacent Γ).mpr neighbor.property, hneighbor⟩
  · intro left right hleft hright hne
    exact nine_seven_order_two_subgroups_disjoint (hcards left hleft) (hcards right hright)
      (hdistinct left right hleft hright hne)

public theorem nine_seven_center_lines
    {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : Later.AmbientSectionNineContext H S0 S P1 P2 embedding T A B)
    (_hb : 1 < ctx.criticalPath.length)
    (_hfirstModel : QuotientIsModel (GAt ctx.Γ ctx.criticalPath.firstStep)
      (QAt ctx.Γ ctx.criticalPath.firstStep) SL2Two)
    (hstartData : ∀ vertex, IsConjugateVertex ctx.Γ ctx.criticalPath.a vertex →
      QuotientIsModel (GAt ctx.Γ vertex) (QAt ctx.Γ vertex) SL2Two ∧
        Nat.card (ZAt ctx.Γ vertex) = 4)
    (middle : ctx.Γ.Vertex)
    (hmiddle : IsConjugateVertex ctx.Γ ctx.criticalPath.a middle) :
    (∀ neighbor, neighbor ∈ Neighborhood ctx.Γ middle →
      Nat.card (ZAt ctx.Γ neighbor) = 2 ∧
        ZAt ctx.Γ neighbor ≤ ZAt ctx.Γ middle) ∧
    (∀ line : Subgroup G, Nat.card line = 2 → line ≤ ZAt ctx.Γ middle →
      ∃ neighbor, neighbor ∈ Neighborhood ctx.Γ middle ∧ line = ZAt ctx.Γ neighbor) ∧
    (∀ left right, left ∈ Neighborhood ctx.Γ middle →
      right ∈ Neighborhood ctx.Γ middle → left ≠ right →
      Disjoint (ZAt ctx.Γ left) (ZAt ctx.Γ right)) := by
  have hmodel := (hstartData middle hmiddle).1
  have hcenterCard := (hstartData middle hmiddle).2
  obtain ⟨hjoin, hcenters⟩ := nine_seven_center_join ctx middle hmiddle
  exact nine_seven_center_lines_of_center_join ctx.sectionSeven ctx.Γ middle
    hmodel hcenterCard hjoin hcenters

end Stellmacher.SectionNine
