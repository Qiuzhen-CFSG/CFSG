module
public import Stellmacher.SectionNine.NineInitialEdgeCoreProduct
public import Stellmacher.SectionNine.NineFivePenultimateResidualGeneration

/-!
# The initial residual generated by two distinct neighbor cores

At critical distance greater than one, choose a neighbor d of the initial
vertex distinct from the next vertex. The initial residual lies in the
join of the cores at those two neighbors and in the initial-stabilizer
conjugate closure of the core at d. These exact ambient containments feed
the normalization and centralizer arguments for (9.4)(6).

The residual-core clause of (7.6)(b) places the initial residual in the
closure of the next core and excludes its containment in the initial core.
Local transitivity moves the next core to the chosen neighbor core; its
closure is normalized by the initial stabilizer, so it contains the same
residual. The initial cubic quotient then places the original closure in
the two neighbor-core join. Only the generic cubic closure result from the
penultimate-residual module is used; no assertion of (9.5) is invoked.

Source: Stellmacher (9.4)(6), printed p.51/PDF p.41, using (7.6)(b) and the
cubic consequences of (9.3), in `refs/files/stellmacher-n-group.pdf`.
-/

namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext SevenSix
universe u

public theorem nine_four_initial_residual_neighbors
    {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : AmbientSectionNineContext H S0 S P1 P2 embedding T A B)
    (hb : 1 < ctx.criticalPath.length)
    (remote : ctx.Γ.Vertex)
    (hremote : remote ∈ Neighborhood ctx.Γ ctx.criticalPath.a)
    (hne : remote ≠ ctx.criticalPath.firstStep) :
    EAt ctx.Γ ctx.criticalPath.a ≤
      QAt ctx.Γ ctx.criticalPath.firstStep ⊔ QAt ctx.Γ remote ∧
    EAt ctx.Γ ctx.criticalPath.a ≤
      conjugateClosure (QAt ctx.Γ remote) (GAt ctx.Γ ctx.criticalPath.a) := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let P := GAt Γ cp.a
  let Qn := QAt Γ cp.firstStep
  let Qd := QAt Γ remote
  let C := conjugateClosure Qd P
  have hnMem : cp.firstStep ∈ Neighborhood Γ cp.a :=
    (mem_neighborhood_iff_adjacent Γ).mpr cp.firstStep_adj
  obtain ⟨mover,hmover⟩ := (lemma_seven_one ctx.sectionSeven Γ).local_transitivity cp.a
    hnMem hremote
  have hQdmap : Qd = Qn.map (MulAut.conj (mover:G)⁻¹).toMonoidHom := by
    change QAt Γ remote = (QAt Γ cp.firstStep).map _
    rw [← hmover,QAt,q_act]
  have hQnQa : ¬ Qn ≤ QAt Γ cp.a := by
    intro hh
    apply (lemma_seven_six ctx.sectionSeven Γ cp).next_residual_core.1
    refine le_trans ?_ hh
    change twoCoreIn (e Γ cp.firstStep) ≤ q Γ cp.firstStep
    rw [CosetGraphContext.e,Γ.twoResidualAt_def,q,Γ.twoCoreAt_def,residual_core_eq_inter_core]
    exact inf_le_right
  have hQdQa : ¬ Qd ≤ QAt Γ cp.a := by
    intro hh
    apply hQnQa
    have hQaMap := Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (stabilizer_le_normalizer_q Γ cp.a (P.inv_mem mover.property))
    change (QAt Γ cp.a).map (MulAut.conj (mover:G)⁻¹).toMonoidHom = QAt Γ cp.a at hQaMap
    apply (Subgroup.map_le_map_iff_of_injective
      (f := (MulAut.conj (mover:G)⁻¹).toMonoidHom) (MulAut.conj (mover:G)⁻¹).injective).mp
    rw [← hQdmap,hQaMap]
    exact hh
  have hPC : P ≤ Subgroup.normalizer (C : Set G) := by
    rw [show C = conjugateClosure Qd P from rfl,conjugateClosure,Subgroup.le_normalizer_closure_iff]
    intro g hg point hpoint
    obtain ⟨earlier,element,rfl⟩ := hpoint
    apply Subgroup.subset_closure
    refine ⟨⟨g*(earlier:G),P.mul_mem hg earlier.property⟩,element,?_⟩
    change g*((earlier:G)*(element:G)*(earlier:G)⁻¹)*g⁻¹ =
      (g*(earlier:G))*(element:G)*(g*(earlier:G))⁻¹
    group
  have hQnC : Qn ≤ C := by
    intro z hz
    have hmz : (mover:G)⁻¹*z*(mover:G) ∈ Qd := by
      rw [hQdmap]
      refine ⟨z,hz,?_⟩
      simp
    apply Subgroup.subset_closure
    refine ⟨mover,⟨(mover:G)⁻¹*z*(mover:G),hmz⟩,?_⟩
    change z = (mover:G)*((mover:G)⁻¹*z*(mover:G))*(mover:G)⁻¹
    group
  have hsmall : twoCoreIn (EAt Γ cp.firstStep) ≤ Qn := by
    change twoCoreIn (e Γ cp.firstStep) ≤ q Γ cp.firstStep
    rw [CosetGraphContext.e,Γ.twoResidualAt_def,q,Γ.twoCoreAt_def,residual_core_eq_inter_core]
    exact inf_le_right
  have hclosureC : conjugateClosure (twoCoreIn (EAt Γ cp.firstStep)) P ≤ C := by
    apply (Subgroup.closure_le _).mpr
    rintro z ⟨g,q,rfl⟩
    exact (Subgroup.mem_normalizer_iff.mp (hPC g.property) q).mp (hQnC (hsmall q.property))
  have hEaC : EAt Γ cp.a ≤ C :=
    (lemma_seven_six ctx.sectionSeven Γ cp).next_residual_core.2.trans hclosureC
  have hmodel := (lemma_nine_three_ambient ctx hb cp.a ⟨1,Γ.act_one _⟩).1
  have hclosedNext : conjugateClosure Qn P ≤ Qd ⊔ Qn :=
    nine_five_cubic_neighbor_closure_le_join ctx.sectionSeven Γ hmodel
      ((mem_neighborhood_iff_adjacent Γ).mp hremote) cp.firstStep_adj hne hQdQa
  have hsmallClosed : conjugateClosure (twoCoreIn (EAt Γ cp.firstStep)) P ≤
      conjugateClosure Qn P := by
    apply (Subgroup.closure_le _).mpr
    rintro z ⟨g,q,rfl⟩
    exact Subgroup.subset_closure ⟨g,⟨q,hsmall q.property⟩,rfl⟩
  refine ⟨?_,hEaC⟩
  rw [sup_comm]
  exact (lemma_seven_six ctx.sectionSeven Γ cp).next_residual_core.2.trans
    (hsmallClosed.trans hclosedNext)

end Stellmacher.SectionNine
