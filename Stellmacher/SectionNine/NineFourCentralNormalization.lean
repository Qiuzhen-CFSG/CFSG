module
public import Stellmacher.SectionNine.NineFourAuxiliaryCore
public import Stellmacher.SectionNine.NineNextFaithfulQuotient
public import Stellmacher.SectionNine.NineSevenCenterJoin
public import Stellmacher.SectionNine.NineSevenNormalityObstructions
public import Theory.GroupTheory.CommutatorPreimage

/-!
# Normalization by the literal auxiliary group in (9.4)

For a subgroup A of the remote neighbor module whose displacement under
an actor lies in the first-step module, the source group
F = (Q_a intersect Q_remote) joined with the actor normalizes A V_next.
Moreover [A V_next,F] lies in V_next. The remote vertex is an actual
neighbor of the initial critical vertex; no enlarged-intersection or
counterexample hypothesis is needed, so the theorem also applies to each
cyclic subgroup generated by an element of A.

The remote-core commutator identity puts [A,Q_a intersect Q_remote] in
the remote center, which lies in the initial center and hence V_next.
The original actor bound supplies the other generator. The commutator
preimage API combines these two bounds and then adjoins V_next.
Critical minimality places the remote module in Q_a, so this join
normalizes V_next. The resulting commutator containment proves
normalization by F.

This is the shared auxiliary-subgroup calculation before source relation
(3) and the normalization input for the all-central case after (7), in
Stellmacher (9.4), printed pp.50–52 of refs/files/stellmacher-n-group.pdf.
-/

namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext SevenSix
open scoped commutatorElement
universe u

private theorem sup_commutator_le {G : Type*} [Group G]
    (P U W D Z : Subgroup G) (hPZ : P ≤ Subgroup.normalizer Z)
    (hUP : U ≤ P) (hWP : W ≤ P)
    (hUD : ⁅U, D⁆ ≤ Z) (hWD : ⁅W, D⁆ ≤ Z) : ⁅U ⊔ W, D⁆ ≤ Z :=
  (Subgroup.commutator_mono (sup_le
    (Subgroup.le_commutatorPreimage hUP hUD)
    (Subgroup.le_commutatorPreimage hWP hWD)) le_rfl).trans
      (Subgroup.commutator_commutatorPreimage_le P D Z hPZ)

public theorem nine_four_auxiliary_normalization
    {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A0 B : Subgroup G}
    (ctx : AmbientSectionNineContext H S0 S P1 P2 embedding T A0 B)
    (hb : 1 < ctx.criticalPath.length)
    (remote : ctx.Γ.Vertex)
    (hremote : remote ∈ Neighborhood ctx.Γ ctx.criticalPath.a)
    (actor : G) (hactor : actor ∈ GAt ctx.Γ ctx.criticalPath.firstStep)
    (A : Subgroup G) (hA : A ≤ VAt ctx.Γ remote)
    (hcomm : ⁅A, Subgroup.zpowers actor⁆ ≤ VAt ctx.Γ ctx.criticalPath.firstStep) :
    let F := (QAt ctx.Γ ctx.criticalPath.a ⊓ QAt ctx.Γ remote) ⊔
      Subgroup.zpowers actor
    let U := A ⊔ VAt ctx.Γ ctx.criticalPath.firstStep
    F ≤ Subgroup.normalizer (U : Set G) ∧
      ⁅U, F⁆ ≤ VAt ctx.Γ ctx.criticalPath.firstStep := by
  let Γ := ctx.Γ
  let cp := ctx.criticalPath
  let P := GAt Γ cp.firstStep
  let V := VAt Γ cp.firstStep
  let D := QAt Γ cp.a ⊓ QAt Γ remote
  let C := Subgroup.zpowers actor
  let F := D ⊔ C
  let U := A ⊔ V
  have hFV : F ≤ P := (nine_four_auxiliary_core_geometry ctx hb remote actor hactor).1
  have hDP : D ≤ P := le_sup_left.trans hFV
  have hCP : C ≤ P := Subgroup.zpowers_le.mpr hactor
  have hPV : P ≤ Subgroup.normalizer V := stabilizer_le_normalizer_v Γ cp.firstStep
  obtain ⟨mover, hmover⟩ := (lemma_seven_one ctx.sectionSeven Γ).local_transitivity cp.a
    ((mem_neighborhood_iff_adjacent Γ).mpr cp.firstStep_adj) hremote
  have horbit : IsConjugateVertex Γ cp.firstStep remote := ⟨mover, hmover⟩
  have hVD : ⁅VAt Γ remote, QAt Γ remote⁆ = ZAt Γ remote :=
    (nine_next_center_commutator_and_kernel ctx hb remote horbit).2.1
  have hZaV : ZAt Γ cp.a ≤ V :=
    (lemma_seven_four ctx.sectionSeven Γ cp).first_containment.1
  have hZdZa : ZAt Γ remote ≤ ZAt Γ cp.a :=
    ((nine_seven_center_join ctx cp.a ⟨1, Γ.act_one _⟩).2 remote hremote).2
  have hAD : ⁅A, D⁆ ≤ V :=
    ((Subgroup.commutator_mono hA inf_le_right).trans_eq hVD).trans
      (hZdZa.trans hZaV)
  have hAF : ⁅A, F⁆ ≤ V := by
    rw [Subgroup.commutator_comm]
    exact sup_commutator_le P D C A V hPV hDP hCP
      (by simpa only [Subgroup.commutator_comm] using hAD)
      (by simpa only [Subgroup.commutator_comm] using hcomm)
  have hVF : ⁅V, F⁆ ≤ V :=
    Subgroup.le_normalizer_iff_commutator_le_left.mp (hFV.trans hPV)
  have hUV : U ≤ Subgroup.normalizer V := by
    apply sup_le ?_ V.le_normalizer
    have hAQa : A ≤ QAt Γ cp.a := by
      have hb2 : 2 < cp.length := by
        change 2 < ctx.criticalPath.length
        have hodd := (lemma_seven_five ctx.sectionSeven Γ cp ctx.commutator_eq).odd_distance
        change Odd ctx.criticalPath.length at hodd
        obtain ⟨k, hk⟩ := hodd
        omega
      exact hA.trans ((nine_seven_neighbor_module_le_neighborhood Γ
        ((mem_neighborhood_iff_adjacent Γ).mp hremote)).trans
          (nine_seven_neighborhood_le_own_core ctx.toLocalContext hb2 cp.a))
    exact hAQa.trans (((local_cores_le_edge_sylow ctx.sectionSeven Γ cp).1.trans
      cp.S_le_edge_stabilizers).trans (inf_le_right.trans hPV))
  have hUF : ⁅U, F⁆ ≤ V :=
    sup_commutator_le (Subgroup.normalizer V) A V F V le_rfl
      (le_sup_left.trans hUV) V.le_normalizer hAF hVF
  exact ⟨Subgroup.le_normalizer_iff_commutator_le_left.mpr (hUF.trans le_sup_right), hUF⟩


end Stellmacher.SectionNine
