module
public import Stellmacher.SectionNine.NineThreeMixedSylow
public import Stellmacher.SectionNine.NineThreeFinalCoreCardCases
public import Stellmacher.SectionNine.NineThreeFinalActorContradiction
public import Stellmacher.SectionNine.NineThreeFinalCoreHyperplaneSetup
public import Theory.GroupTheory.SylowCentralizerCore
public import Theory.GroupTheory.NormalCenterQuotient

/-!
# The final core-intersection bound in Stellmacher (9.3)

In the normalized order-sixteen configuration, the initial center meets
the actual mixed centralizer's two-core in at most four elements. Existing
cardinality and noncontainment results reduce a larger intersection to
order eight. Its quotient image then has order two and is normalized by
a Sylow, hence centralizes that Sylow. After quotienting again by the odd
core, solvable Fitting self-centralization puts that image in the two-core.

The prescribed first actor belongs to this initial center, and the actual
extraction is generated by that actor and one conjugate two-subgroup.
Its image modulo the odd core therefore lies in a product of a normal
two-core with a two-subgroup, so is a two-group. The extracted two-residual
must consequently lie in the odd-core layer, contradicting the geometric
first-residual exclusion. No global invariance of the core intersection
is needed; all quotients and embeddings remain those of the original C₀.

This supplies the bound in the final R₀,C₀ paragraph of Stellmacher (9.3),
printed p.50/PDF p.40 of `refs/files/stellmacher-n-group.pdf`. The proof makes
the implicit Sylow-center/solvable-layer argument explicit, using the exact
prescribed-actor generation retained by the geometric extraction.
-/

namespace Stellmacher.SectionNine
open Later SectionsFiveToSeven CosetGraphContext
universe u

private theorem normalizer_centralizer_of_card_two
    {X : Type*} [Group X] (Y : Subgroup X) (hcard : Nat.card Y = 2) :
    Subgroup.normalizer (Y : Set X) ≤ Subgroup.centralizer (Y : Set X) := by
  let N := Subgroup.normalizer (Y : Set X)
  let Z := Y.subgroupOf N
  have hnormal : Z.Normal := Subgroup.normal_subgroupOf_iff_le_normalizer Y.le_normalizer |>.mpr le_rfl
  let _ := hnormal
  have hZcard : Nat.card Z = 2 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe Y.le_normalizer).toEquiv]
    exact hcard
  have hcentral := Subgroup.central_of_normal_card_two Z hZcard
  intro actor hactor
  rw [Subgroup.mem_centralizer_iff]
  intro vector hvector
  exact (congrArg Subtype.val (Subgroup.mem_center_iff.mp
    (hcentral (show (⟨vector, Y.le_normalizer hvector⟩ : N) ∈ Z from hvector))
      (⟨actor,hactor⟩ : N))).symm

private theorem normalized_two_image_le_core
    {X : Type*} [Group X] [Finite X]
    (hsolvable : Group.IsSolvable X)
    (Y : Subgroup X) (hcard : Nat.card Y = 2)
    (sylow : Sylow 2 X)
    (hnormal : (sylow : Subgroup X) ≤ Subgroup.normalizer (Y : Set X)) :
    Y.map (QuotientGroup.mk' (pPrimeCore 2 X)) ≤ pCore 2 (X ⧸ pPrimeCore 2 X) := by
  let _ := hsolvable
  let q := QuotientGroup.mk' (pPrimeCore 2 X)
  let U := sylow.mapSurjective (QuotientGroup.mk'_surjective (pPrimeCore 2 X))
  have hcomm : ⁅Y,(sylow : Subgroup X)⁆ = ⊥ :=
    Subgroup.commutator_eq_bot_iff_le_centralizer.mpr
      (Subgroup.le_centralizer_iff.mp (hnormal.trans (normalizer_centralizer_of_card_two Y hcard)))
  have hcommMap := congrArg (Subgroup.map q) hcomm
  rw [Subgroup.map_commutator,Subgroup.map_bot] at hcommMap
  exact (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcommMap).trans
    (centralizer_sylow_le_pCore_of_pPrimeCore_eq_bot inferInstance (pPrimeCore_quotient_pPrimeCore_eq_bot 2) U)



public theorem nine_three_final_core_intersection_card_le_four
    {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : AmbientSectionNineContext H S0 S P1 P2 embedding T A B)
    (hb : 1 < ctx.criticalPath.length)
    (hlarge : 4 < Nat.card (ZAt ctx.Γ ctx.criticalPath.a))
    (first : NineThreeFirstConfigurationData ctx)
    (second : NineThreeSecondConfigurationData ctx first)
    (config : NineThreeNormalizedGeometry ctx first second)
    (rank : NineThreeNativeActionRankData ctx) :
    let vertex := ctx.Γ.act config.g (ctx.Γ.act first.extraction.x⁻¹ first.l)
    let mixed := (⁅ZAt ctx.Γ ctx.criticalPath.a ⊓ GAt ctx.Γ vertex,
      ZAt ctx.Γ vertex ⊓ GAt ctx.Γ ctx.criticalPath.a⁆ : Subgroup G)
    let centralizer := Subgroup.centralizer (mixed.map embedding : Set H)
    Nat.card ((ZAt ctx.Γ ctx.criticalPath.a).map embedding ⊓
      (pCore 2 centralizer).map centralizer.subtype : Subgroup H) ≤ 4 := by
  classical
  let vertex := ctx.Γ.act config.g (ctx.Γ.act first.extraction.x⁻¹ first.l)
  let mixed := (⁅ZAt ctx.Γ ctx.criticalPath.a ⊓ GAt ctx.Γ vertex,
    ZAt ctx.Γ vertex ⊓ GAt ctx.Γ ctx.criticalPath.a⁆ : Subgroup G)
  let C := Subgroup.centralizer (mixed.map embedding : Set H)
  let vectors := (ZAt ctx.Γ ctx.criticalPath.a).map embedding
  let internal := vectors.subgroupOf C
  let core := pCore 2 C
  let q := QuotientGroup.mk' core
  change Nat.card (vectors ⊓ core.map C.subtype : Subgroup H) ≤ 4
  by_contra hnot
  have hcard := nine_three_final_core_intersection_card_eq_eight_of_gt_four
    ctx hb hlarge first second config rank (Nat.lt_of_not_ge hnot)
  have hgeometry := nine_three_mixed_order_two_and_sylow ctx hb hlarge first second config rank
  have hdata := nine_three_final_centralizer_center_core ctx hb hlarge first second config
  have hsolvable := (nine_three_final_centralizer_setup_of_mixed_sylow
    ctx first second config hgeometry).1
  let _ := hsolvable
  have hYcard : Nat.card (internal.map q) = 2 :=
    quotient_image_card_two_of_core_intersection_card_eight C vectors hdata.1
      (by rw [Subgroup.card_map_of_injective ctx.embedding_injective]; exact rank.center_card) hcard
  obtain ⟨sylow, hsylow, _⟩ := nine_three_final_core_intersection_sylow_normalized
    ctx hb hlarge first second config hgeometry
  let U := sylow.subtype (hsylow.trans inf_le_left)
  let Ubar := U.mapSurjective (QuotientGroup.mk'_surjective core)
  have hnormalAmbient : (sylow : Subgroup H) ≤ Subgroup.normalizer (vectors : Set H) := by
    intro actor hactor
    obtain ⟨source, hsource, heq⟩ := (hsylow.trans inf_le_right) hactor
    rw [← heq]
    exact Subgroup.le_normalizer_map embedding (Subgroup.mem_map_of_mem embedding
      (stabilizer_le_normalizer_z_public ctx.Γ ctx.criticalPath.a hsource))
  have hnormal : (U : Subgroup C) ≤ Subgroup.normalizer (internal : Set C) := by
    intro actor hactor
    rw [Subgroup.mem_normalizer_iff]
    intro vector
    exact Subgroup.mem_normalizer_iff.mp (hnormalAmbient hactor) vector
  have hnormalBar : (Ubar : Subgroup (C ⧸ core)) ≤
      Subgroup.normalizer (internal.map q : Set (C ⧸ core)) := by
    rintro _ ⟨actor, hactor, rfl⟩
    exact Subgroup.le_normalizer_map q (Subgroup.mem_map_of_mem q (hnormal hactor))
  have hbound := normalized_two_image_le_core (inferInstance : Group.IsSolvable (C ⧸ core))
    (internal.map q) hYcard Ubar hnormalBar
  exact nine_three_final_contradiction_of_initial_center_oddCoreLayer
    ctx hb hlarge first second config hbound

end Stellmacher.SectionNine
