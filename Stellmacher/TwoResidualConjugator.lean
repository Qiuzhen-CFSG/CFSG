module
public import Stellmacher.SectionThree.PrimitiveDihedralExtraction.Quotient
public import Theory.GroupTheory.ConjugateGenerationPGroupQuotient

/-!
# Replacing an ambient conjugator by a two-residual element

Suppose a finite subgroup `E` is generated by `A` and its conjugate by an
element `x ∈ E`. Then an element of the ambient two-residual `O²(E)` induces
the same conjugate of `A` as `x`.

Work inside `E`, identify its two-residual with the standard finite-group
residual, and use that its quotient is a two-group. The normal conjugator
replacement theorem then supplies an element of this residual. Mapping both
the element and the conjugacy equality through the subgroup inclusion gives
the ambient statement. No normality of `A` is assumed.

This is the conjugator replacement used twice in Stellmacher (9.3)(i),
Journal of Algebra 190 (1997), after the generating subgroups have been
selected using (7.8)(a).
-/

namespace Stellmacher

private theorem map_conjBy_residual_lift
    {G Q : Type*} [Group G] [Group Q]
    (f : G →* Q) (A : Subgroup G) (x : G) :
    (A.conjBy x).map f = (A.map f).conjBy (f x) := by
  unfold Subgroup.conjBy
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1
  ext a
  simp [MulAut.conj_apply]

/-- Replace a conjugator in a subgroup generated by the two conjugates by
an element of that subgroup's ambient two-residual. -/
public theorem exists_twoResidual_conjugator
    {G : Type*} [Group G] [Finite G]
    (A E : Subgroup G) (x : G) (hxE : x ∈ E)
    (hgen : E = A ⊔ A.conjBy x) :
    ∃ y : G, y ∈ twoResidualAmbient E ∧ A.conjBy y = A.conjBy x := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hAE : A ≤ E := by rw [hgen]; exact le_sup_left
  let localA := A.subgroupOf E
  let localX : E := ⟨x, hxE⟩
  have hmap : localA.map E.subtype = A :=
    Subgroup.map_subgroupOf_eq_of_le hAE
  have hlocalgen : localA ⊔ localA.conjBy localX = ⊤ := by
    apply Subgroup.map_injective E.subtype_injective
    rw [Subgroup.map_sup, map_conjBy_residual_lift, hmap]
    change A ⊔ A.conjBy x = (⊤ : Subgroup E).map E.subtype
    rw [← hgen]
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  let N := BenderSuzuki.External.hktPResidual 2 E
  have : N.Normal := BenderSuzuki.External.hktPResidual_normal
  obtain ⟨localY, hyN, hconj⟩ :=
    Subgroup.exists_normal_conjugator_of_isPGroup_quotient localA N
      (BenderSuzuki.External.hktPResidual_quotient_isPGroup (q := 2) (Q := E))
      localX hlocalgen
  refine ⟨localY, ?_, ?_⟩
  · apply Subgroup.mem_map.mpr
    refine ⟨localY, ?_, rfl⟩
    rw [SectionThree.twoResidualSubgroup_eq_hktPResidual']
    exact hyN
  · have := congrArg (Subgroup.map E.subtype) hconj
    simpa only [map_conjBy_residual_lift, hmap, localX, Subgroup.coe_subtype] using this

end Stellmacher
