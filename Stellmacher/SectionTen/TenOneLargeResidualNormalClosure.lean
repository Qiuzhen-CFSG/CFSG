module
public import Stellmacher.SectionTen.TenOneLargeGeneratedResidualSaturation

/-!
# The terminal residual core is generated by the residual conjugates of W

In the actual large Section Ten case, the E-terminal conjugate closure
of the literal middle-generated subgroup W is precisely O₂(E-terminal).
The original context, middle vertex, path and no-transvection hypothesis
are retained; no later quotient cardinality or generation premise is used.

Source (15) puts W in the residual two-core U. Its E-closure C stays in U
because U is E-normal. By construction E normalizes C. The actual adjacent
edge normalizes both W and E, hence also C. The native edge Sylow subgroup
supplements E in the full terminal stabilizer P, so C is P-normal. The
proved generated-residual saturation theorem applied to C, which contains
W, yields U≤C and hence equality.

Source: Stellmacher (10.1), Journal of Algebra 190 (1997), printed p.64,
the identification immediately before equation (18). This isolates its
normal-closure argument from the independent source-(17)/(18) order bound.
-/

namespace Stellmacher.SectionTen
open Later SectionsFiveToSeven CosetGraphContext SevenSix SectionNine
universe u

private theorem actors_normalize_closure
    {G : Type u} [Group G] (X A : Subgroup G) :
    A≤Subgroup.normalizer (conjugateClosure X A:Set G) := by
  rw [conjugateClosure,Subgroup.le_normalizer_closure_iff]
  intro a ha point hpoint
  obtain ⟨b,x,rfl⟩ := hpoint
  apply Subgroup.subset_closure
  refine ⟨⟨a*(b:G),A.mul_mem ha b.property⟩,x,?_⟩
  change a*((b:G)*(x:G)*(b:G)⁻¹)*a⁻¹=(a*(b:G))*(x:G)*(a*(b:G))⁻¹
  group

private theorem normalize_closure_of_normalize_factors
    {G : Type u} [Group G] (X A N : Subgroup G)
    (hNX : N≤Subgroup.normalizer (X:Set G))
    (hNA : N≤Subgroup.normalizer (A:Set G)) :
    N≤Subgroup.normalizer (conjugateClosure X A:Set G) := by
  rw [conjugateClosure,Subgroup.le_normalizer_closure_iff]
  intro n hn point hpoint
  obtain ⟨a,x,rfl⟩ := hpoint
  have ha : n*(a:G)*n⁻¹∈A := (Subgroup.mem_normalizer_iff.mp (hNA hn) _).mp a.property
  have hx : n*(x:G)*n⁻¹∈X := (Subgroup.mem_normalizer_iff.mp (hNX hn) _).mp x.property
  apply Subgroup.subset_closure
  refine ⟨⟨n*(a:G)*n⁻¹,ha⟩,⟨n*(x:G)*n⁻¹,hx⟩,?_⟩
  change n*((a:G)*(x:G)*(a:G)⁻¹)*n⁻¹=
    (n*(a:G)*n⁻¹)*(n*(x:G)*n⁻¹)*(n*(a:G)*n⁻¹)⁻¹
  group

public theorem ten_one_large_residual_generated_by_neighborhood
    {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
    {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
    {embedding : G →* H} {T A B : Subgroup G}
    (ctx : AmbientSectionTenContext H S0 S P1 P2 embedding T A B)
    (middle : ctx.Γ.Vertex)
    (hpath : IsCriticalPathOffset ctx.Γ ctx.criticalPath 2 middle)
    (hno : ∀ actor : G, actor ∈ VAt ctx.Γ ctx.criticalPath.firstStep →
      actor ∉ QAt ctx.Γ ctx.criticalPath.a' → ¬ QuotientCardEq
        (⁅VAt ctx.Γ ctx.criticalPath.a', Subgroup.zpowers actor⁆ ⊔
          ZAt ctx.Γ ctx.criticalPath.a') (ZAt ctx.Γ ctx.criticalPath.a') 2) :
    conjugateClosure
      (conjugateClosure
        (VAt ctx.Γ ctx.criticalPath.firstStep ⊓ QAt ctx.Γ ctx.criticalPath.a')
        (GAt ctx.Γ middle))
      (EAt ctx.Γ ctx.criticalPath.a') = twoCoreIn (EAt ctx.Γ ctx.criticalPath.a') := by
  let P := GAt ctx.Γ ctx.criticalPath.a'
  let M := GAt ctx.Γ middle
  let E := EAt ctx.Γ ctx.criticalPath.a'
  let U := twoCoreIn E
  let seed := VAt ctx.Γ ctx.criticalPath.firstStep ⊓ QAt ctx.Γ ctx.criticalPath.a'
  let W := conjugateClosure seed M
  let C := conjugateClosure W E
  let edge := P⊓M
  change C=U
  have hWU : W≤U := (ten_one_large_first_residual_index ctx middle hpath hno).2
  have hEU : E≤Subgroup.normalizer (U:Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer (twoCoreIn_le E)).mp (twoCoreIn_normal E)
  have hCU : C≤U := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨e,w,rfl⟩
    exact (Subgroup.mem_normalizer_iff.mp (hEU e.property) _).mp (hWU w.property)
  have hEC : E≤Subgroup.normalizer (C:Set G) := actors_normalize_closure W E
  have hMW : M≤Subgroup.normalizer (W:Set G) := actors_normalize_closure seed M
  have hEdef : E=twoResidualIn P := ctx.Γ.twoResidualAt_def _
  have hEP : E≤P := hEdef ▸ twoResidualIn_le P
  have hPE : P≤Subgroup.normalizer (E:Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hEP).mp (hEdef ▸ twoResidualIn_normal P)
  have hedgeC : edge≤Subgroup.normalizer (C:Set G) :=
    normalize_closure_of_normalize_factors W E edge (inf_le_right.trans hMW)
      (inf_le_left.trans hPE)
  have hPC : P≤Subgroup.normalizer (C:Set G) := by
    obtain ⟨_,_,hterminal,_⟩ := sectionTenOpeningGeometry ctx middle hpath
    let edgeSylow : Sylow 2 edge := default
    have hdata := edge_sectionThree_data ctx.sectionSeven ctx.Γ
      ((mem_neighborhood_iff_adjacent ctx.Γ).mpr (ctx.Γ.adjacent_symm hterminal)) edgeSylow
    have hgen := SectionThree.twoResidual_sup_sylowImage hdata.2.1.1.2.1
    have hres : twoResidualAmbient P=E := by
      change twoResidualAmbient P=ctx.Γ.twoResidualAt ctx.criticalPath.a'
      rw [ctx.Γ.twoResidualAt_def]
      rfl
    rw [hres] at hgen
    change E⊔sylowTwoAmbient edge edgeSylow=P at hgen
    rw [←hgen]
    exact sup_le hEC ((Subgroup.map_subtype_le _).trans hedgeC)
  have hWC : W≤C := by
    intro w hw
    exact Subgroup.subset_closure ⟨1,⟨w,hw⟩,by simp⟩
  exact le_antisymm hCU (ten_one_large_generated_residual_saturation ctx middle hpath hno C hPC hWC)

end Stellmacher.SectionTen
