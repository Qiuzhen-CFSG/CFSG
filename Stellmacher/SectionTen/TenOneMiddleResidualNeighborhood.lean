module
public import Stellmacher.SectionTen.TenOneMiddleCoreResidualCommutator

/-!
# The middle residual core generated by the neighborhood commutator

In the actual small, SL2(2) branch of Section Ten, the middle residual
two-core equals the commutator of the generated middle neighborhood U
with the middle residual E. In particular the residual core lies in U.
This is the use of (7.6)(b) immediately before (10.1)(a1) in Stellmacher,
Journal of Algebra 190 (1997), printed p.60.

The middle stabilizer acts on the literal quotient Qmiddle/U. The previous
commutator bound places the first residual core in the action kernel.
Local transitivity fixes that core and transports the residual normal-closure
containment of (7.6)(b) to the middle edge. Since the action kernel is normal,
it therefore contains the middle residual E, proving [Qmiddle,E] lies in U.
Residual perfection gives R=[R,E], so R lies in U. The usual local residual
commutator bound gives the reverse containment for [U,E]. All normalization
and transport data are derived from the actual graph configuration.
-/
namespace Stellmacher.SectionTen
open Later SectionsFiveToSeven CosetGraphContext SevenSix SectionNine
open scoped commutatorElement
universe u
variable {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
  {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
  {embedding : G →* H} {T A B : Subgroup G}

public theorem ten_one_middle_residual_neighborhood
    (ctx : AmbientSectionTenContext H S0 S P1 P2 embedding T A B)
    (middle : ctx.Γ.Vertex)
    (hpath : IsCriticalPathOffset ctx.Γ ctx.criticalPath 2 middle)
    (hsmall : Nat.card (VAt ctx.Γ ctx.criticalPath.firstStep) = 8)
    (hmodel : QuotientIsModel (GAt ctx.Γ ctx.criticalPath.firstStep)
      (QAt ctx.Γ ctx.criticalPath.firstStep) SL2Two) :
    twoCoreIn (EAt ctx.Γ middle) =
      ⁅GeneratedNeighborhoodV ctx.Γ middle,EAt ctx.Γ middle⁆ := by
  let P := GAt ctx.Γ ctx.criticalPath.firstStep
  let M := GAt ctx.Γ middle
  let Q := QAt ctx.Γ middle
  let E := EAt ctx.Γ middle
  let R := twoCoreIn (EAt ctx.Γ ctx.criticalPath.firstStep)
  let D := twoCoreIn E
  let U := GeneratedNeighborhoodV ctx.Γ middle
  obtain ⟨_,hfirst,_,_⟩ := sectionTenOpeningGeometry ctx middle hpath
  have hb : 2 < ctx.criticalPath.length := by rw [ctx.critical_length]; decide
  have hUQ : U ≤ Q :=
    nine_seven_neighborhood_le_own_core ctx.toLocalContext.toSectionNineLocalContext hb middle
  have hMQ : M ≤ Subgroup.normalizer (Q : Set G) := stabilizer_le_normalizer_q ctx.Γ middle
  have hMU : M ≤ Subgroup.normalizer (U : Set G) :=
    nine_seven_stabilizer_normalizes_neighborhood ctx.Γ middle
  have hQM : Q ≤ M := by
    change ctx.Γ.twoCoreAt middle ≤ _
    rw [ctx.Γ.twoCoreAt_def]
    exact twoCoreIn_le _
  have hRQfirst : R ≤ QAt ctx.Γ ctx.criticalPath.firstStep := by
    change twoCoreIn (ctx.Γ.twoResidualAt ctx.criticalPath.firstStep) ≤
      ctx.Γ.twoCoreAt ctx.criticalPath.firstStep
    rw [ctx.Γ.twoResidualAt_def,ctx.Γ.twoCoreAt_def,residual_core_eq_inter_core]
    exact inf_le_right
  have hRP : R ≤ P := hRQfirst.trans (by
    change ctx.Γ.twoCoreAt ctx.criticalPath.firstStep ≤ _
    rw [ctx.Γ.twoCoreAt_def]
    exact twoCoreIn_le _)
  have hRM : R ≤ M := hRQfirst.trans
    (((lemma_seven_three ctx.sectionSeven ctx.Γ).sylow_and_core
      ctx.criticalPath.firstStep middle
      ((mem_neighborhood_iff_adjacent ctx.Γ).mpr (ctx.Γ.adjacent_symm hfirst)) default).2.2)
  have hN : (U.subgroupOf Q).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer (hQM.trans hMU)
  let _ := hN
  obtain ⟨action,hact⟩ := Subgroup.exists_quotient_conjugation_action M Q U hMQ hMU hN
  have hRker : R.subgroupOf M ≤ action.ker :=
    Subgroup.quotient_conjugation_action_kills_commutator_layer M Q U R hN hMQ
      (ten_one_middle_core_residual_commutator ctx middle hpath hsmall hmodel) action hact
  let K := action.ker.map M.subtype
  have hRK : R ≤ K := by
    intro r hr
    exact ⟨⟨r,hRM hr⟩,hRker hr,rfl⟩
  have hMK : M ≤ Subgroup.normalizer (K : Set G) := by
    apply Subgroup.le_normalizer_iff.mpr
    intro a ha k hk
    obtain ⟨x,hx,rfl⟩ := hk
    refine ⟨(⟨a,ha⟩ : M)*x*(⟨a,ha⟩ : M)⁻¹,?_,rfl⟩
    exact Subgroup.Normal.conj_mem (inferInstance : action.ker.Normal) x hx ⟨a,ha⟩
  have hEK : E ≤ K := by
    obtain ⟨mover,hmove⟩ := (lemma_seven_one ctx.sectionSeven ctx.Γ).local_transitivity
      ctx.criticalPath.firstStep
      ((mem_neighborhood_iff_adjacent ctx.Γ).mpr
        (ctx.Γ.adjacent_symm ctx.criticalPath.firstStep_adj))
      ((mem_neighborhood_iff_adjacent ctx.Γ).mpr (ctx.Γ.adjacent_symm hfirst))
    let f := (MulAut.conj (mover:G)⁻¹).toMonoidHom
    have hMmap : (GAt ctx.Γ ctx.criticalPath.a).map f = M := by
      exact (stabilizer_act ctx.Γ (mover:G) ctx.criticalPath.a).symm.trans
        (congrArg _ hmove)
    have hEfirst : EAt ctx.Γ ctx.criticalPath.firstStep = twoResidualIn P :=
      ctx.Γ.twoResidualAt_def _
    have hEfirstP : EAt ctx.Γ ctx.criticalPath.firstStep ≤ P :=
      hEfirst ▸ twoResidualIn_le P
    have hPR : P ≤ Subgroup.normalizer (R : Set G) :=
      (Subgroup.normal_subgroupOf_iff_le_normalizer hRP).mp
        (twoCoreIn_normal_of_normal _ P hEfirstP (hEfirst ▸ twoResidualIn_normal P))
    have hRmap : R.map f = R := by
      exact Subgroup.mem_normalizer_iff_map_conj_eq.mp
        (hPR (P.inv_mem mover.property))
    have hEmap : (EAt ctx.Γ ctx.criticalPath.a).map f = E := by
      change (ctx.Γ.twoResidualAt ctx.criticalPath.a).map f = ctx.Γ.twoResidualAt middle
      rw [ctx.Γ.twoResidualAt_def,ctx.Γ.twoResidualAt_def]
      exact map_twoResidualAmbient_of_subgroup_image (GAt ctx.Γ ctx.criticalPath.a) f M hMmap
    rw [← hEmap]
    apply (Subgroup.map_mono
      (lemma_seven_six ctx.sectionSeven ctx.Γ ctx.criticalPath).next_residual_core.2).trans
    apply Subgroup.map_le_iff_le_comap.mpr
    apply (Subgroup.closure_le _).mpr
    rintro x ⟨a,r,rfl⟩
    change f ((a:G)*(r:G)*(a:G)⁻¹) ∈ K
    rw [map_mul,map_mul,map_inv]
    have haM : f (a:G) ∈ M := hMmap ▸ Subgroup.mem_map_of_mem f a.property
    have hrR : f (r:G) ∈ R := hRmap ▸ Subgroup.mem_map_of_mem f r.property
    exact (Subgroup.mem_normalizer_iff.mp (hMK haM) _).mp (hRK hrR)
  have hE : E = twoResidualIn M := ctx.Γ.twoResidualAt_def _
  have hEM : E ≤ M := hE ▸ twoResidualIn_le M
  have hQE : ⁅Q,E⁆ ≤ U := by
    rw [Subgroup.commutator_comm]
    apply Subgroup.commutator_le.mpr
    intro a ha q hq
    obtain ⟨aM,haM,rfl⟩ := hEK ha
    let qQ : Q := ⟨q,hq⟩
    have hfix : action aM (QuotientGroup.mk' (U.subgroupOf Q) qQ) =
        QuotientGroup.mk' (U.subgroupOf Q) qQ := by
      rw [show action aM = 1 from haM]; rfl
    rw [hact] at hfix
    have hh := QuotientGroup.eq_iff_div_mem.mp hfix
    change (aM:G)*q*(aM:G)⁻¹/q ∈ U at hh
    change ⁅(aM:G),q⁆ ∈ U
    simpa only [commutatorElement_def,div_eq_mul_inv] using hh
  have hDQ : D ≤ Q := by
    change twoCoreIn (ctx.Γ.twoResidualAt middle) ≤ ctx.Γ.twoCoreAt middle
    rw [ctx.Γ.twoResidualAt_def,ctx.Γ.twoCoreAt_def,residual_core_eq_inter_core]
    exact inf_le_right
  have hperfect : BenderSuzuki.External.hktPResidual 2 E = ⊤ := by
    rw [hE]
    exact twoResidualAmbient_has_top_twoResidual M
  have hodd : Odd (Nat.card (E ⧸ pCore 2 E)) := by
    rw [hE]
    exact local_residual_core_quotient_odd ctx.sectionSeven ctx.Γ middle
      ctx.criticalPath.firstStep ((mem_neighborhood_iff_adjacent ctx.Γ).mpr hfirst) M le_rfl
  have hfull : D = ⁅D,E⁆ := by
    have hh := congrArg (Subgroup.map E.subtype)
      (twoCore_eq_commutator_of_residual_perfect hperfect hodd)
    rw [Subgroup.map_commutator,← MonoidHom.range_eq_map,Subgroup.range_subtype] at hh
    exact hh
  have hDU : D ≤ U := hfull.le.trans ((Subgroup.commutator_mono hDQ le_rfl).trans hQE)
  apply le_antisymm
  · exact hfull.le.trans (Subgroup.commutator_mono hDU le_rfl)
  · apply (Subgroup.commutator_mono hUQ le_rfl).trans
    rw [Subgroup.commutator_comm]
    change ⁅E,ctx.Γ.twoCoreAt middle⁆ ≤ twoCoreIn E
    rw [hE,ctx.Γ.twoCoreAt_def]
    exact residual_commutator_core_le M
public theorem ten_one_middle_residual_core_le_neighborhood
    (ctx : AmbientSectionTenContext H S0 S P1 P2 embedding T A B)
    (middle : ctx.Γ.Vertex)
    (hpath : IsCriticalPathOffset ctx.Γ ctx.criticalPath 2 middle)
    (hsmall : Nat.card (VAt ctx.Γ ctx.criticalPath.firstStep) = 8)
    (hmodel : QuotientIsModel (GAt ctx.Γ ctx.criticalPath.firstStep)
      (QAt ctx.Γ ctx.criticalPath.firstStep) SL2Two) :
    twoCoreIn (EAt ctx.Γ middle) ≤ GeneratedNeighborhoodV ctx.Γ middle := by
  rw [ten_one_middle_residual_neighborhood ctx middle hpath hsmall hmodel]
  apply Subgroup.le_normalizer_iff_commutator_le_left.mp
  have hE : EAt ctx.Γ middle ≤ GAt ctx.Γ middle := by
    change ctx.Γ.twoResidualAt middle ≤ _
    rw [ctx.Γ.twoResidualAt_def]
    exact twoResidualIn_le _
  exact hE.trans (nine_seven_stabilizer_normalizes_neighborhood ctx.Γ middle)
end Stellmacher.SectionTen
