module
public import Stellmacher.SectionTen.TenOneDihedralActorComparison
public import Stellmacher.SectionTen.TenOneDihedralFirstSupportExclusion

/-!
# Middle-core normalization of the selected actor image

In the actual length-three Section Ten context, choose a first-module actor
outside the terminal core with quotient displacement of order four containing
the first center. If no first-module actor outside that core is a quotient
transvection, the literal middle-core image normalizes the cyclic subgroup
generated by the selected actor image in the supplied action range. The
quotient action, its normality and elementary-module instances, and its exact
two-core kernel are retained throughout.

Construct the prescribed dihedral extraction for this same actor. The actor
comparison theorem says each middle-core conjugate induces the same action
unless the odd support has order four and contains the first-center image.
The first-support exclusion rules out that alternative using the local
odd-core action, center generation, and displacement-square bound. Thus each
middle-core image centralizes the selected actor, hence normalizes its line.
The subgroup-action transport merely identifies the full automorphism support
with the support under the literal action range.

This proves the actor normality step immediately before Stellmacher (10.1),
assertion (13), printed p.63. Residual generation and normalization of the
enlarged displacement are separate downstream consequences.
-/

namespace Stellmacher.SectionTen
open Later SectionsFiveToSeven CosetGraphContext SevenSix SectionNine SectionThree
universe u
variable {H G : Type u} [Group H] [Finite H] [Group G] [Finite G]
  {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
  {embedding : G →* H} {T A B : Subgroup G}

public theorem ten_one_large_actor_image_normal
    (ctx : AmbientSectionTenContext H S0 S P1 P2 embedding T A B)
    (middle : ctx.Γ.Vertex)
    (hpath : IsCriticalPathOffset ctx.Γ ctx.criticalPath 2 middle)
    (actor : GAt ctx.Γ ctx.criticalPath.a')
    (hactor : (actor : G) ∈ VAt ctx.Γ ctx.criticalPath.firstStep)
    [hN : ((ZAt ctx.Γ ctx.criticalPath.a').subgroupOf
      (VAt ctx.Γ ctx.criticalPath.a')).Normal]
    [_hW : IsElementaryAbelian 2 (VAt ctx.Γ ctx.criticalPath.a' ⧸
      (ZAt ctx.Γ ctx.criticalPath.a').subgroupOf (VAt ctx.Γ ctx.criticalPath.a'))]
    (action : GAt ctx.Γ ctx.criticalPath.a' →* MulAut
      (VAt ctx.Γ ctx.criticalPath.a' ⧸
        (ZAt ctx.Γ ctx.criticalPath.a').subgroupOf (VAt ctx.Γ ctx.criticalPath.a')))
    (hformula : ∀ mover : GAt ctx.Γ ctx.criticalPath.a',
      ∀ point : VAt ctx.Γ ctx.criticalPath.a',
      action mover (QuotientGroup.mk'
        ((ZAt ctx.Γ ctx.criticalPath.a').subgroupOf (VAt ctx.Γ ctx.criticalPath.a')) point) =
      QuotientGroup.mk'
        ((ZAt ctx.Γ ctx.criticalPath.a').subgroupOf (VAt ctx.Γ ctx.criticalPath.a'))
        ⟨(mover : G) * (point : G) * (mover : G)⁻¹,
          (Subgroup.mem_normalizer_iff.mp
            (stabilizer_le_normalizer_v ctx.Γ ctx.criticalPath.a' mover.property)
              point).mp point.property⟩)
    (hkernel : action.ker = pCore 2 (GAt ctx.Γ ctx.criticalPath.a'))

    (hout : (actor : G) ∉ QAt ctx.Γ ctx.criticalPath.a')
    (hcard : QuotientCardEq
      (⁅VAt ctx.Γ ctx.criticalPath.a', Subgroup.zpowers (actor : G)⁆ ⊔
        ZAt ctx.Γ ctx.criticalPath.a') (ZAt ctx.Γ ctx.criticalPath.a') 4)
    (hselected : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      ⁅VAt ctx.Γ ctx.criticalPath.a', Subgroup.zpowers (actor : G)⁆)
    (hno : ∀ element : G, element ∈ VAt ctx.Γ ctx.criticalPath.firstStep →
      element ∉ QAt ctx.Γ ctx.criticalPath.a' → ¬ QuotientCardEq
        (⁅VAt ctx.Γ ctx.criticalPath.a', Subgroup.zpowers element⁆ ⊔
          ZAt ctx.Γ ctx.criticalPath.a') (ZAt ctx.Γ ctx.criticalPath.a') 2) :
    ((QAt ctx.Γ middle).subgroupOf (GAt ctx.Γ ctx.criticalPath.a')).map
      action.rangeRestrict ≤ Subgroup.normalizer
        (Subgroup.zpowers (action.rangeRestrict actor) : Set action.range) := by
  classical
  let P := GAt ctx.Γ ctx.criticalPath.a'
  let V := VAt ctx.Γ ctx.criticalPath.a'
  let Z := ZAt ctx.Γ ctx.criticalPath.a'
  let W := V ⧸ Z.subgroupOf V
  obtain ⟨data⟩ := ten_one_dihedral_configuration ctx middle hpath (actor : G) hactor hout
  let R := (data.raw.F₀.subgroupOf P).map action.rangeRestrict
  have hsupport : commutatorAction ((data.raw.F₀.subgroupOf P).map action) W =
      commutatorAction R W := by
    rw [← commutatorAction_map_actor_subtype action.range R]
    rw [show R = (data.raw.F₀.subgroupOf P).map action.rangeRestrict from rfl,
      Subgroup.map_map]
    rfl
  rintro element ⟨mover, hmover, rfl⟩
  have heq : action actor = action (mover * actor * mover⁻¹) := by
    rcases ten_one_dihedral_actor_comparison ctx middle hpath actor hactor data
      action hformula hkernel hno hcard hselected mover hmover with heq | hsmall
    · exact heq
    · exact False.elim (ten_one_dihedral_first_support_excluded ctx middle hpath actor
        hactor data action hformula hkernel hout hcard
        (hsupport ▸ hsmall.1) (hsupport ▸ hsmall.2))
  apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
  rw [MonoidHom.map_zpowers]
  congr 1
  apply Subtype.ext
  change action mover * action actor * (action mover)⁻¹ = action actor
  rw [← map_inv, ← map_mul, ← map_mul]
  exact heq.symm

end Stellmacher.SectionTen
