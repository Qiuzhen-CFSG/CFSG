/-!
# The terminal residual and enlarged displacement in source (13)

In the nontransvection branch of the actual Section Ten configuration, retain
the selected first-module actor, the supplied terminal quotient action, and
its exact core kernel. The terminal residual image is the action group's odd
core and is generated by its commutators with this actor. The middle
stabilizer normalizes the actor displacement enlarged by the middle center.

The proved actor-image normality applies to the same selected actor. Actual
penultimate-core geometry identifies the middle-core image with the image of
an edge Sylow subgroup, so the primitive local normal-actor theorem, source
(3.4), gives residual commutator generation. The local residual-image theorem
identifies this image with the odd core. For the second clause, lift the
invariant quotient displacement and apply the common-intersection
normalization transfer under the actual middle stabilizer.

This is both clauses of Stellmacher (10.1), assertion (13), printed p.63.
It supplies the action-generation and geometric normalization inputs for the
subsequent terminal action classification, without either clause as an
additional hypothesis.
-/

namespace Stellmacher.SectionTen
open Later SectionsFiveToSeven CosetGraphContext SevenSix SectionNine
universe u
variable {H G K : Type u} [Group H] [Finite H] [Group G] [Finite G] [Group K] [Finite K]
  {S0 : Sylow 2 H} {S P1 P2 : Subgroup H}
  {embedding : G →* H} {T A B : Subgroup G}

private theorem residual_generation_of_normal_actor_image
    (ctx : AmbientSectionTenContext H S0 S P1 P2 embedding T A B)
    (middle : ctx.Γ.Vertex)
    (hpath : IsCriticalPathOffset ctx.Γ ctx.criticalPath 2 middle)
    (f : GAt ctx.Γ ctx.criticalPath.a' →* K) (hsurj : Function.Surjective f)
    (hkernel : f.ker = pCore 2 (GAt ctx.Γ ctx.criticalPath.a'))
    (actor : GAt ctx.Γ ctx.criticalPath.a')
    (hactor : (actor:G) ∈ VAt ctx.Γ ctx.criticalPath.firstStep)
    (hout : (actor:G) ∉ QAt ctx.Γ ctx.criticalPath.a')
    (hnorm : ((QAt ctx.Γ middle).subgroupOf (GAt ctx.Γ ctx.criticalPath.a')).map f ≤
      Subgroup.normalizer (Subgroup.zpowers (f actor) : Set K)) :
    ((EAt ctx.Γ ctx.criticalPath.a').subgroupOf
      (GAt ctx.Γ ctx.criticalPath.a')).map f =
      ⁅SectionOne.oddCore K,Subgroup.zpowers (f actor)⁆ := by
  let P := GAt ctx.Γ ctx.criticalPath.a'
  let V := VAt ctx.Γ ctx.criticalPath.firstStep
  let Q := QAt ctx.Γ ctx.criticalPath.a'
  let M := GAt ctx.Γ middle
  let edge := P ⊓ M
  let sylow : Sylow 2 edge := default
  let Sedge := sylowTwoAmbient edge sylow
  obtain ⟨_,hfirst,hterminal,_⟩ := sectionTenOpeningGeometry ctx middle hpath
  have hb : 2 < ctx.criticalPath.length := by rw [ctx.critical_length]; decide
  have hVQ : V ≤ QAt ctx.Γ middle :=
    (show V ≤ GeneratedNeighborhoodV ctx.Γ middle from
      le_sSup ⟨_, (mem_neighborhood_iff_adjacent ctx.Γ).mpr hfirst,rfl⟩).trans
      (nine_seven_neighborhood_le_own_core ctx.toLocalContext.toSectionNineLocalContext hb middle)
  let _ : IsElementaryAbelian 2 V :=
    ((lemma_seven_five ctx.sectionSeven ctx.Γ ctx.criticalPath ctx.commutator_eq).longer_case
      (by omega)).1
  let _ : Fact (IsPGroup 2 V) := ⟨IsElementaryAbelian.isPGroup 2 V⟩
  have hPhi : frattiniAmbient V ≤ Q := by
    rw [frattiniAmbient,frattini_eq_bot_of_isElementaryAbelian (R:=V) (p:=2),Subgroup.map_bot]
    exact bot_le
  have hi := sevenEight_local_inputs ctx.sectionSeven ctx.Γ ctx.criticalPath.a' middle
    ((mem_neighborhood_iff_adjacent ctx.Γ).mpr (ctx.Γ.adjacent_symm hterminal)) V hVQ
    (fun h => hout (h hactor)) hPhi sylow
  have hpen : ctx.criticalPath.path ⟨ctx.criticalPath.length-1,
      Nat.lt_succ_of_le (Nat.sub_le _ _)⟩ = middle := by
    obtain ⟨index,hindex,rfl⟩ := hpath
    apply congrArg ctx.criticalPath.path
    apply Fin.ext
    change ctx.criticalPath.length - 1 = index.val
    have hlength := ctx.critical_length
    omega
  obtain ⟨barSylow,hbarSylow⟩ := nine_nine_terminal_core_image_sylow
    ctx.toAmbientSectionNineContext (by omega) f hsurj hkernel
  change (barSylow:Subgroup K) = ((QAt ctx.Γ _).subgroupOf P).map f at hbarSylow
  rw [hpen] at hbarSylow
  have hQle : (barSylow:Subgroup K) ≤ (Sedge.subgroupOf P).map f := by
    rw [hbarSylow]
    exact Subgroup.map_mono (Subgroup.subgroupOf_mono P hi.neighbor_core_normal.1)
  have hS2 : IsPGroup 2 Sedge := sylow.isPGroup'.map edge.subtype
  have hSnative2 : IsPGroup 2 (Sedge.subgroupOf P) := hS2.comap_subtype
  have himageEq : (Sedge.subgroupOf P).map f = (barSylow:Subgroup K) :=
    barSylow.is_maximal' (hSnative2.map f) hQle
  have hSnormal : (Sedge.subgroupOf P).map f ≤
      Subgroup.normalizer (Subgroup.zpowers (f actor) : Set K) := by
    rw [himageEq,hbarSylow]
    exact hnorm
  have hne : f actor ≠ 1 := by
    intro hz
    have hk : actor ∈ pCore 2 P := hkernel ▸ (MonoidHom.mem_ker.mpr hz)
    apply hout
    change (actor:G) ∈ ctx.Γ.twoCoreAt ctx.criticalPath.a'
    rw [ctx.Γ.twoCoreAt_def]
    exact Subgroup.mem_map_of_mem P.subtype hk
  have hgen := SectionThree.residual_image_eq_commutator_of_normal_actor
    Sedge hi.sectionThree P hi.first_mem hi.solvable f hkernel actor
    (show actor ∈ Sedge.subgroupOf P from hi.actor_le hactor) hne hSnormal
  have hnative : (EAt ctx.Γ ctx.criticalPath.a').subgroupOf P = twoResidualSubgroup P := by
    rw [EAt,CosetGraphContext.e,ctx.Γ.twoResidualAt_def]
    exact Subgroup.comap_map_eq_self_of_injective P.subtype_injective _
  have hodd := nine_local_residual_image_eq_oddCore ctx.toLocalContext.toSectionNineLocalContext
    ctx.criticalPath.a' middle (ctx.Γ.adjacent_symm hterminal) f hsurj hkernel.ge
  change ((EAt ctx.Γ ctx.criticalPath.a').subgroupOf P).map f = SectionOne.oddCore K at hodd
  rw [← hnative] at hgen
  rw [hodd] at hgen
  exact hodd.trans hgen.symm

public theorem ten_one_large_residual_generation
    (ctx : AmbientSectionTenContext H S0 S P1 P2 embedding T A B)
    (middle : ctx.Γ.Vertex)
    (hpath : IsCriticalPathOffset ctx.Γ ctx.criticalPath 2 middle)
    (actor : GAt ctx.Γ ctx.criticalPath.a')
    (hactor : (actor : G) ∈ VAt ctx.Γ ctx.criticalPath.firstStep)
    [hN : ((ZAt ctx.Γ ctx.criticalPath.a').subgroupOf
      (VAt ctx.Γ ctx.criticalPath.a')).Normal]
    [_hW : IsElementaryAbelian 2 (VAt ctx.Γ ctx.criticalPath.a' ⧸
      (ZAt ctx.Γ ctx.criticalPath.a').subgroupOf (VAt ctx.Γ ctx.criticalPath.a'))]
    (action : GAt ctx.Γ ctx.criticalPath.a' →* MulAut
      (VAt ctx.Γ ctx.criticalPath.a' ⧸
        (ZAt ctx.Γ ctx.criticalPath.a').subgroupOf (VAt ctx.Γ ctx.criticalPath.a')))
    (hformula : ∀ mover : GAt ctx.Γ ctx.criticalPath.a',
      ∀ point : VAt ctx.Γ ctx.criticalPath.a',
      action mover (QuotientGroup.mk'
        ((ZAt ctx.Γ ctx.criticalPath.a').subgroupOf (VAt ctx.Γ ctx.criticalPath.a')) point) =
      QuotientGroup.mk'
        ((ZAt ctx.Γ ctx.criticalPath.a').subgroupOf (VAt ctx.Γ ctx.criticalPath.a'))
        ⟨(mover : G) * (point : G) * (mover : G)⁻¹,
          (Subgroup.mem_normalizer_iff.mp
            (stabilizer_le_normalizer_v ctx.Γ ctx.criticalPath.a' mover.property)
              point).mp point.property⟩)
    (hkernel : action.ker = pCore 2 (GAt ctx.Γ ctx.criticalPath.a'))
    (hout : (actor : G) ∉ QAt ctx.Γ ctx.criticalPath.a')
    (hcard : QuotientCardEq
      (⁅VAt ctx.Γ ctx.criticalPath.a', Subgroup.zpowers (actor : G)⁆ ⊔
        ZAt ctx.Γ ctx.criticalPath.a') (ZAt ctx.Γ ctx.criticalPath.a') 4)
    (hselected : ZAt ctx.Γ ctx.criticalPath.firstStep ≤
      ⁅VAt ctx.Γ ctx.criticalPath.a', Subgroup.zpowers (actor : G)⁆)
    (hno : ∀ element : G, element ∈ VAt ctx.Γ ctx.criticalPath.firstStep →
      element ∉ QAt ctx.Γ ctx.criticalPath.a' → ¬ QuotientCardEq
        (⁅VAt ctx.Γ ctx.criticalPath.a', Subgroup.zpowers element⁆ ⊔
          ZAt ctx.Γ ctx.criticalPath.a') (ZAt ctx.Γ ctx.criticalPath.a') 2) :
    let Ebar := ((EAt ctx.Γ ctx.criticalPath.a').subgroupOf
      (GAt ctx.Γ ctx.criticalPath.a')).map action.rangeRestrict
    Ebar = SectionOne.oddCore action.range ∧
      Ebar = ⁅Ebar,Subgroup.zpowers (action.rangeRestrict actor)⁆ ∧
      GAt ctx.Γ middle ≤ Subgroup.normalizer
        ((⁅VAt ctx.Γ ctx.criticalPath.a',Subgroup.zpowers (actor:G)⁆ ⊔
          ZAt ctx.Γ middle : Subgroup G) : Set G) := by
  let P := GAt ctx.Γ ctx.criticalPath.a'
  let Ebar := ((EAt ctx.Γ ctx.criticalPath.a').subgroupOf P).map action.rangeRestrict
  have hnorm := ten_one_large_actor_image_normal ctx middle hpath actor hactor
    action hformula hkernel hout hcard hselected hno
  have hcore : action.rangeRestrict.ker = pCore 2 P := by
    rw [MonoidHom.ker_rangeRestrict,hkernel]
  have hgen := residual_generation_of_normal_actor_image ctx middle hpath
    action.rangeRestrict action.rangeRestrict_surjective hcore actor hactor hout hnorm
  obtain ⟨_,_,hterminal,_⟩ := sectionTenOpeningGeometry ctx middle hpath
  have hodd := nine_local_residual_image_eq_oddCore ctx.toLocalContext.toSectionNineLocalContext
    ctx.criticalPath.a' middle (ctx.Γ.adjacent_symm hterminal)
    action.rangeRestrict action.rangeRestrict_surjective hcore.ge
  change Ebar = SectionOne.oddCore action.range at hodd
  refine ⟨hodd,?_,?_⟩
  · change Ebar = ⁅Ebar, Subgroup.zpowers (action.rangeRestrict actor)⁆
    rw [hodd]
    exact hodd.symm.trans hgen
  · exact ten_one_displacement_normalized_of_actor_image_normalized
      ctx middle hpath action hformula actor hactor hselected hnorm

end Stellmacher.SectionTen