module

public import Stellmacher.SectionsOneToFourDefs
public import Theory.GroupTheory.SylowNormalCoprimeSupplement

/-!
# Sylow 2-subgroups across an odd normal supplement

If `D` is a normal subgroup of odd order and `S` is a Sylow 2-subgroup of
`P`, then `S` remains Sylow in `D ⊔ P`.  This is the Section Three wrapper
used in Stellmacher (3.9), where the barred ambient group is generated by its
normal odd core and one of the local subgroups.

The proof applies the prime-generic normal coprime supplement theorem from
`Theory.GroupTheory.SylowNormalCoprimeSupplement` to the Sylow subgroup of
`P` witnessing `IsSylowSubgroupIn S P`; the resulting ambient image is `S`
by the same witness equation.  The underlying relative-index calculation is
kept in that lower, source-neutral module.

Source: B. Stellmacher, *An Application of the Amalgam Method: The 2-Local
Structure of N-Groups of Characteristic 2 Type*, Journal of Algebra 190
(1997), Lemma (3.9), p. 23; see `refs/latex/stellmacher-n-group.tex`.
-/

namespace Stellmacher.SectionThree

universe u

/-- Adjoining a normal subgroup of odd order preserves a specified ambient
Sylow 2-subgroup. -/
public theorem isSylowSubgroupIn_normal_odd_sup
    {G : Type u} [Group G] [Finite G]
    (D P S : Subgroup G) (hDnormal : D.Normal)
    (hDodd : ¬ 2 ∣ Nat.card D)
    (hSylow : IsSylowSubgroupIn S P) :
    IsSylowSubgroupIn S (D ⊔ P) := by
  let _ : D.Normal := hDnormal
  obtain ⟨T, hT⟩ := hSylow
  obtain ⟨U, hU⟩ :=
    Sylow.exists_map_eq_map_of_normal_coprime_sup D P hDodd T
  exact ⟨U, hU.trans hT⟩

end Stellmacher.SectionThree
