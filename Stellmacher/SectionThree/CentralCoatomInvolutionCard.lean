module
public import Stellmacher.SectionThree.CentralCoatomResidualGeneration
public import Stellmacher.SectionThree.PrimitiveDihedralExtraction.ResidualLift
public import Stellmacher.SectionOne.RankOneThreeGroupAssembly.Basic
public import Theory.GroupAction.InvolutionDisplacementCard
public import Theory.GroupTheory.NormalizedSupCard

/-!
# Exact cardinality for a central-coatom involution module

Let a finite actor group be generated by A and a conjugate A^x, with
A generated by a and a two-subgroup A0. For an explicit action on a finite
elementary abelian two-group, assume the image of A0 centralizes the full
action image and the residual image has trivial fixed subgroup. If the
image of a squares to one, the module order is the square of its cyclic
displacement order. The identity image is included.

The central-coatom residual generation theorem puts the residual image
inside the cyclic groups generated by a and its conjugate, so their fixed
subgroups intersect trivially. Conjugation preserves displacement order.
The shared elementary involution count gives n=f*r and r≤f for
the module, fixed and displacement orders. Counting the product of the
two disjoint conjugate fixed subgroups gives f²≤n, hence f=r and n=r².
No faithful-action or trivial-two-core hypothesis is imposed.

This is the finite-action count for the cost-four branch of Stellmacher
(8.6), printed p.44 of `refs/files/stellmacher-n-group.pdf`. It also retains
the original transvection bound as a specialization in its owning module.
-/

namespace Stellmacher.SectionThree
open scoped IsMulCommutative

private theorem cyclic_involution_card_data
    {V : Type*} [Group V] [Finite V] [IsElementaryAbelian 2 V]
    (a : MulAut V) (hsquare : a ^ 2 = 1) :
    Nat.card V = Nat.card (FixedPoints.subgroup (Subgroup.zpowers a) V) *
      Nat.card (commutatorAction (Subgroup.zpowers a) V) ∧
      commutatorAction (Subgroup.zpowers a) V ≤
        FixedPoints.subgroup (Subgroup.zpowers a) V :=
  MulAut.involution_fixed_displacement_card_data a hsquare

private theorem two_involution_fixed_card_square
    {V : Type*} [Group V] [Finite V] [IsElementaryAbelian 2 V]
    (a b : MulAut V) (ha : a ^ 2 = 1) (hb : b ^ 2 = 1)
    (hrank : Nat.card (commutatorAction (Subgroup.zpowers b) V) =
      Nat.card (commutatorAction (Subgroup.zpowers a) V))
    (hfixed : Disjoint (FixedPoints.subgroup (Subgroup.zpowers a) V)
      (FixedPoints.subgroup (Subgroup.zpowers b) V)) :
    Nat.card V = Nat.card (commutatorAction (Subgroup.zpowers a) V) ^ 2 := by
  let A := FixedPoints.subgroup (Subgroup.zpowers a) V
  let B := FixedPoints.subgroup (Subgroup.zpowers b) V
  let D := commutatorAction (Subgroup.zpowers a) V
  obtain ⟨hA, hDA⟩ := cyclic_involution_card_data a ha
  have hB := (cyclic_involution_card_data b hb).1
  rw [hrank] at hB
  let _ : A.Normal := Subgroup.normal_of_isMulCommutative A
  have hn : B ≤ Subgroup.normalizer (A : Set V) := by
    rw [Subgroup.normalizer_eq_top]
    exact le_top
  have hprod := Subgroup.card_sup_eq_mul_of_normalizes_of_disjoint A B hn hfixed
  have hbound := (A ⊔ B).card_le_card_group
  rw [hprod] at hbound
  change Nat.card V = Nat.card A * Nat.card D at hA
  change Nat.card V = Nat.card B * Nat.card D at hB
  have hle : Nat.card D ≤ Nat.card A := Subgroup.card_le_of_le hDA
  have hDpos : 0 < Nat.card D := Nat.card_pos
  have hApos : 0 < Nat.card A := Nat.card_pos
  have hAB : Nat.card A = Nat.card B := by nlinarith
  have hAD : Nat.card A ≤ Nat.card D := by nlinarith
  change Nat.card V = Nat.card D ^ 2
  rw [hA, le_antisymm hAD hle, pow_two]

public theorem central_coatom_involution_module_card_eq_square
    {K V : Type*} [Group K] [Finite K] [Group V] [Finite V]
    [IsElementaryAbelian 2 V]
    (action : K →* MulAut V) (A A0 : Subgroup K) (a x : K)
    (hgen : (⊤ : Subgroup K) = A ⊔ A.conjBy x)
    (hA : A = Subgroup.zpowers a ⊔ A0)
    (htwo : IsPGroup 2 A0)
    (hcentral : A0.map action ≤ Subgroup.centralizer (action.range : Set (MulAut V)))
    (hfixed : FixedPoints.subgroup ((twoResidualAmbient (⊤ : Subgroup K)).map action) V = ⊥)
    (hsquare : (action a) ^ 2 = 1) :
    Nat.card V = Nat.card (commutatorAction (Subgroup.zpowers (action a)) V) ^ 2 := by
  let α := action a
  let χ := action x
  let β := χ * α * χ⁻¹
  have hconj (B : Subgroup K) :
      (B.conjBy x).map action = (B.map action).conjBy χ := by
    change (B.map (MulAut.conj x).toMonoidHom).map action =
      (B.map action).map (MulAut.conj χ).toMonoidHom
    rw [Subgroup.map_map, Subgroup.map_map]
    congr 1
    apply MonoidHom.ext
    intro k
    change action (x * k * x⁻¹) = χ * action k * χ⁻¹
    simp only [map_mul, map_inv]
    rfl
  have hE : action.range = A.map action ⊔ (A.map action).conjBy χ := by
    have hm := congrArg (Subgroup.map action) hgen
    rw [Subgroup.map_sup, hconj, ← MonoidHom.range_eq_map] at hm
    exact hm
  have hAimage : A.map action = Subgroup.zpowers α ⊔ A0.map action := by
    rw [hA, Subgroup.map_sup, MonoidHom.map_zpowers]
  have hR := twoResidualAmbient_le_two_conjugates_of_central_coatom
    action.range (A.map action) (A0.map action) α χ ⟨x,rfl⟩ hE hAimage hcentral (htwo.map action)
  have hresidual : (twoResidualAmbient (⊤ : Subgroup K)).map action =
      twoResidualAmbient action.range :=
    map_twoResidualAmbient_of_subgroup_image ⊤ action action.range
      (by rw [← MonoidHom.range_eq_map])
  have hcyclic : (Subgroup.zpowers α).conjBy χ = Subgroup.zpowers β := by
    change (Subgroup.zpowers α).map (MulAut.conj χ).toMonoidHom = _
    rw [MonoidHom.map_zpowers]
    rfl
  rw [hcyclic, ← hresidual] at hR
  have hdisjoint : Disjoint (FixedPoints.subgroup (Subgroup.zpowers α) V)
      (FixedPoints.subgroup (Subgroup.zpowers β) V) := by
    apply disjoint_iff.mpr
    apply bot_unique
    intro point hpoint
    have hstab : Subgroup.zpowers α ⊔ Subgroup.zpowers β ≤
        MulAction.stabilizer (MulAut V) point := by
      apply sup_le
      · intro mover hmover
        exact hpoint.1 ⟨mover,hmover⟩
      · intro mover hmover
        exact hpoint.2 ⟨mover,hmover⟩
    rw [← hfixed]
    intro mover
    exact hstab (hR mover.property)
  have hβrank : Nat.card (commutatorAction (Subgroup.zpowers β) V) =
      Nat.card (commutatorAction (Subgroup.zpowers α) V) := by
    rw [← hcyclic, ← SectionOne.RankOneThreeGroupAssembly.commutatorAction_conjBy]
    rw [Subgroup.card_map_of_injective
      (f := (MulDistribMulAction.toMulAut (MulAut V) V χ).toMonoidHom)
      (MulDistribMulAction.toMulAut (MulAut V) V χ).injective]
  have hβsquare : β ^ 2 = 1 := by
    change (MulAut.conj χ α) ^ 2 = 1
    rw [← map_pow, hsquare, map_one]
  exact two_involution_fixed_card_square α β hsquare hβsquare hβrank hdisjoint

end Stellmacher.SectionThree

