module

public import Stellmacher.SectionsOneToFourDefs


/-!
# Normalization of the family join in Stellmacher (3.1)

For subgroups `S ≤ U`, this module proves that every element of
`U ∩ N_G(S)` normalizes the subgroup generated by those `P ≤ U` which contain
`S`, have `S ≠ O₂(P)`, and have a unique maximal subgroup containing `S`.
This is the conjugation-invariance assertion used in the proof of Stellmacher
(3.1), following `refs/latex/stellmacher-n-group.tex`.

The proof conjugates each member `P` of the family.  The induced equivalence
from `P` to its conjugate transports `O₂(P)` via `pCore_map_iso` and transports
the unique coatom above `S` through the subgroup order isomorphism.  Thus
conjugation permutes the family; applying the argument also to the inverse
conjugation gives equality of the generated subgroup and hence normalization.
-/

open scoped BigOperators Pointwise

namespace Stellmacher.SectionThree

universe u

private theorem map_internal_ambient
    {G : Type u} [Group G]
    (P : Subgroup G) (e : G ≃* G) (M : Subgroup P) :
    (M.map (e.subgroupMap P : P →* P.map (e : G →* G))).map
        (P.map (e : G →* G)).subtype =
      (M.map P.subtype).map (e : G →* G) := by
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1

private theorem map_internal_ambient_symm
    {G : Type u} [Group G]
    (P : Subgroup G) (e : G ≃* G)
    (M : Subgroup (P.map (e : G →* G))) :
    (M.map ((e.subgroupMap P).symm : _ →* P)).map P.subtype =
      (M.map (P.map (e : G →* G)).subtype).map (e.symm : G →* G) := by
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1

private theorem twoCoreAmbient_map
    {G : Type u} [Group G]
    (P : Subgroup G) (e : G ≃* G) :
    twoCoreAmbient (P.map (e : G →* G)) =
      (twoCoreAmbient P).map (e : G →* G) := by
  let eP : P ≃* P.map (e : G →* G) := e.subgroupMap P
  have hcore : (pCore 2 P).map (eP : P →* P.map (e : G →* G)) =
      pCore 2 (P.map (e : G →* G)) := pCore_map_iso 2 eP
  unfold twoCoreAmbient
  rw [← hcore, map_internal_ambient]

private theorem uniqueMaximal_map
    {G : Type u} [Group G]
    (S P : Subgroup G) (e : G ≃* G)
    (hS : S.map (e : G →* G) = S)
    (hP : IsUniqueMaximalContaining S P) :
    IsUniqueMaximalContaining S (P.map (e : G →* G)) := by
  rcases hP with ⟨M, hMcoatom, hSM, hMunique⟩
  let eP : P ≃* P.map (e : G →* G) := e.subgroupMap P
  refine ⟨M.map (eP : P →* P.map (e : G →* G)), ?_, ?_, ?_⟩
  · exact (OrderIso.isCoatom_iff eP.mapSubgroup M).2 hMcoatom
  · rw [map_internal_ambient, ← hS]
    exact Subgroup.map_mono hSM
  · intro M' hM'coatom hSM'
    let M0 : Subgroup P := M'.map (eP.symm : _ →* P)
    have hM0coatom : IsCoatom M0 := by
      exact (OrderIso.isCoatom_iff eP.symm.mapSubgroup M').2 hM'coatom
    have hSinv : S.map (e.symm : G →* G) = S := by
      calc
        S.map (e.symm : G →* G) =
            (S.map (e : G →* G)).map (e.symm : G →* G) := by rw [hS]
        _ = S := by rw [Subgroup.map_map]; simp
    have hSM0 : S ≤ M0.map P.subtype := by
      rw [map_internal_ambient_symm, ← hSinv]
      exact Subgroup.map_mono hSM'
    have hM0 : M0 = M := hMunique M0 hM0coatom hSM0
    have hback : M0.map (eP : P →* P.map (e : G →* G)) = M' := by
      dsimp [M0]
      rw [Subgroup.map_map]
      simp
    rw [← hback, hM0]

private theorem family_member_map
    {G : Type u} [Group G]
    (U S P : Subgroup G) (e : G ≃* G)
    (hS : S.map (e : G →* G) = S)
    (hU : U.map (e : G →* G) = U)
    (hP : S ≤ P ∧ P ≤ U ∧ S ≠ twoCoreAmbient P ∧
      IsUniqueMaximalContaining S P) :
    S ≤ P.map (e : G →* G) ∧
      P.map (e : G →* G) ≤ U ∧
      S ≠ twoCoreAmbient (P.map (e : G →* G)) ∧
      IsUniqueMaximalContaining S (P.map (e : G →* G)) := by
  refine ⟨?_, ?_, ?_, uniqueMaximal_map S P e hS hP.2.2.2⟩
  · rw [← hS]
    exact Subgroup.map_mono hP.1
  · rw [← hU]
    exact Subgroup.map_mono hP.2.1
  · rw [twoCoreAmbient_map, ← hS]
    exact (e.mapSubgroup.injective.ne_iff).2 hP.2.2.1

private theorem familyJoin_map_le
    {G : Type u} [Group G]
    (U S : Subgroup G) (e : G ≃* G)
    (hS : S.map (e : G →* G) = S)
    (hU : U.map (e : G →* G) = U) :
    (⨆ P : {P : Subgroup G //
        S ≤ P ∧ P ≤ U ∧ S ≠ twoCoreAmbient P ∧
          IsUniqueMaximalContaining S P},
      (P : Subgroup G)).map (e : G →* G) ≤
        ⨆ P : {P : Subgroup G //
          S ≤ P ∧ P ≤ U ∧ S ≠ twoCoreAmbient P ∧
            IsUniqueMaximalContaining S P},
          (P : Subgroup G) := by
  rw [Subgroup.map_iSup]
  refine iSup_le fun P ↦ ?_
  let Pe : {Q : Subgroup G //
      S ≤ Q ∧ Q ≤ U ∧ S ≠ twoCoreAmbient Q ∧
        IsUniqueMaximalContaining S Q} :=
    ⟨P.val.map (e : G →* G), family_member_map U S P.val e hS hU P.property⟩
  exact le_iSup (fun Q : {Q : Subgroup G //
    S ≤ Q ∧ Q ≤ U ∧ S ≠ twoCoreAmbient Q ∧
      IsUniqueMaximalContaining S Q} ↦ (Q : Subgroup G)) Pe

public theorem familyJoin_le_normalizer
    {G : Type u} [Group G] [Finite G]
    (U S : Subgroup G) (hSU : S ≤ U) :
    U ⊓ Subgroup.normalizer (S : Set G) ≤
      Subgroup.normalizer
        (((⨆ P : {P : Subgroup G //
            S ≤ P ∧ P ≤ U ∧
            S ≠ twoCoreAmbient P ∧
            IsUniqueMaximalContaining S P},
          (P : Subgroup G)) : Subgroup G) : Set G) := by
  have _hSU : S ≤ U := hSU
  intro g hg
  let e : G ≃* G := MulAut.conj g
  have hS : S.map (e : G →* G) = S := by
    exact Subgroup.mem_normalizer_iff_map_conj_eq.mp hg.2
  have hU : U.map (e : G →* G) = U := by
    exact Subgroup.mem_normalizer_iff_map_conj_eq.mp (U.le_normalizer hg.1)
  have hforward := familyJoin_map_le U S e hS hU
  have hSinv : S.map (e.symm : G →* G) = S := by
    calc
      S.map (e.symm : G →* G) =
          (S.map (e : G →* G)).map (e.symm : G →* G) := by rw [hS]
      _ = S := by rw [Subgroup.map_map]; simp
  have hUinv : U.map (e.symm : G →* G) = U := by
    calc
      U.map (e.symm : G →* G) =
          (U.map (e : G →* G)).map (e.symm : G →* G) := by rw [hU]
      _ = U := by rw [Subgroup.map_map]; simp
  have hback := familyJoin_map_le U S e.symm hSinv hUinv
  apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
  apply le_antisymm
  · simpa [e] using hforward
  · have hmapped := Subgroup.map_mono (f := (e : G →* G)) hback
    simpa [Subgroup.map_map, e] using hmapped

end Stellmacher.SectionThree
