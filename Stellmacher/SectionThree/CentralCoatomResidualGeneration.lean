module
public import Stellmacher.SectionThree.LemmaThreeSeven
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Residual generation across a central coatom

Suppose E is generated by A and A^x, where x lies in E, and A is generated
by a and a two-subgroup A0 which centralizes E. Then O²(E) is contained in
the subgroup generated by a and a^x. No assumption about the order of a,
faithfulness, or the quotient model is needed.

Centrality fixes A0 under x and makes it normalize the two-generator
subgroup K. Reassociating the original generators gives E=K A0, with K
normal and E/K a two-group. The residual bound for a normal subgroup with
a two-group supplement then gives O²(E)≤K.

This is the group-theoretic reduction for the two conjugate transvection
argument in Stellmacher (8.6)(13), printed p.43. In that application E and
A0 are literal action images; the original geometric coatom need not be
central before passage to the action image.
-/

namespace Stellmacher.SectionThree

public theorem twoResidualAmbient_le_two_conjugates_of_central_coatom
    {G : Type*} [Group G] [Finite G]
    (E A A0 : Subgroup G) (a x : G)
    (hx : x ∈ E) (hgen : E = A ⊔ A.conjBy x)
    (hA : A = Subgroup.zpowers a ⊔ A0)
    (hcentral : A0 ≤ Subgroup.centralizer (E : Set G))
    (htwo : IsPGroup 2 A0) :
    twoResidualAmbient E ≤ Subgroup.zpowers a ⊔ (Subgroup.zpowers a).conjBy x := by
  let K := Subgroup.zpowers a ⊔ (Subgroup.zpowers a).conjBy x
  have hA0x : A0.map (MulAut.conj x).toMonoidHom = A0 :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (Subgroup.centralizer_le_normalizer (A0 : Set G)
        (Subgroup.le_centralizer_iff.mp hcentral hx))
  have hEK : E = K ⊔ A0 := by
    rw [hgen,hA]
    change (Subgroup.zpowers a ⊔ A0) ⊔
      (Subgroup.zpowers a ⊔ A0).map (MulAut.conj x).toMonoidHom = K ⊔ A0
    rw [Subgroup.map_sup,hA0x]
    dsimp [K,Subgroup.conjBy]
    simp only [sup_assoc,sup_left_comm,sup_comm]
    rw [← sup_assoc,sup_idem]
  have hKE : K ≤ E := hEK ▸ le_sup_left
  have hnormalize : A0 ≤ Subgroup.normalizer (K : Set G) :=
    (hcentral.trans (Subgroup.centralizer_le hKE)).trans
      (Subgroup.centralizer_le_normalizer _)
  have hnormal : (K.subgroupOf (K ⊔ A0)).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer (sup_le K.le_normalizer hnormalize)
  exact twoResidualAmbient_le_left_of_le_sup K A0 E hnormal htwo hEK.le

end Stellmacher.SectionThree
