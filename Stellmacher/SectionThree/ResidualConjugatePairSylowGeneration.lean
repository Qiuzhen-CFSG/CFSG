module
public import Stellmacher.SectionThree.ResidualUniqueMaximal
public import Stellmacher.TwoResidualIdentification

/-!
# A residual conjugate pair supplements every Sylow subgroup

In a finite solvable group with a unique maximal overgroup of a Sylow
2-subgroup S, let E be generated by A ≤ S and its conjugate under an
E-element x in the ambient 2-residual. If E and S generate the whole group,
then E supplements every Sylow 2-subgroup. An ambient-subgroup version
uses the Section Three P-set and preserves the given subgroups and element.

If the second join were proper, put it inside a maximal subgroup L.
Sylow conjugacy and uniqueness identify a conjugate of L with the original
maximal M. The residual-intersection theorem puts x in the normal core
of L, hence in M. Both A and its x-conjugate then lie in M, contradicting
the original generation. No normality of E or equality between a full
edge stabilizer and a Sylow subgroup is assumed.

Source: the solvable primitive normal-core argument of Stellmacher (3.3),
Journal of Algebra 190 (1997), pp.21–22; used for the same-actor (9.4)
application in the proof of (9.10), printed p.57.
-/

namespace Stellmacher.SectionThree

public theorem residual_conjugate_pair_sup_sylow_eq_top
    {P : Type*} [Group P] [Finite P]
    (hsolv : Group.IsSolvable P) (S : Sylow 2 P)
    (M : Subgroup P) (hM : IsCoatom M) (hSM : (S : Subgroup P) ≤ M)
    (hunique : ∀ L : Subgroup P, IsCoatom L → (S : Subgroup P) ≤ L → L = M)
    (A E : Subgroup P) (hAS : A ≤ (S : Subgroup P)) (x : P)
    (hxE : x ∈ E) (hxR : x ∈ twoResidualAmbient (⊤ : Subgroup P))
    (hE : E = A ⊔ A.conjBy x) (hgen : E ⊔ (S : Subgroup P) = ⊤)
    (S' : Sylow 2 P) : E ⊔ (S' : Subgroup P) = ⊤ := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_contra hproper
  obtain ⟨L, hL, hEL⟩ :=
    (eq_top_or_exists_le_coatom (E ⊔ (S' : Subgroup P))).resolve_left hproper
  have hS'L : (S' : Subgroup P) ≤ L := le_sup_right.trans hEL
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq P S' S
  have hSconj : (S' : Subgroup P).conjBy g = (S : Subgroup P) := by
    exact congrArg (fun U : Sylow 2 P => (U : Subgroup P)) hg
  have hLconj : L.conjBy g = M := by
    apply hunique
    · exact (OrderIso.isCoatom_iff (MulAut.conj g).mapSubgroup L).2 hL
    · rw [← hSconj]
      exact Subgroup.map_mono hS'L
  have hLunique : ∀ L' : Subgroup P, IsCoatom L' →
      (S' : Subgroup P) ≤ L' → L' = L := by
    intro L' hL' hS'L'
    apply Subgroup.map_injective (f := (MulAut.conj g).toMonoidHom)
      (MulAut.conj g).injective
    change L'.conjBy g = L.conjBy g
    rw [hLconj]
    apply hunique
    · exact (OrderIso.isCoatom_iff (MulAut.conj g).mapSubgroup L').2 hL'
    · rw [← hSconj]
      exact Subgroup.map_mono hS'L'
  have hxcore : x ∈ L.normalCore :=
    residual_inf_unique_maximal_le_normalCore
      (S' : Subgroup P) L S' rfl hL hS'L hLunique hsolv
      ⟨hxR, (le_sup_left.trans hEL : E ≤ L) hxE⟩
  have hxM : x ∈ M := by
    rw [← hLconj]
    rw [Subgroup.normalCore_eq_iInf_map_conj] at hxcore
    exact (Subgroup.mem_iInf.mp hxcore) g
  have hAM : A ≤ M := hAS.trans hSM
  have hEM : E ≤ M := by
    rw [hE]
    refine sup_le hAM ?_
    rintro y ⟨a, ha, rfl⟩
    exact M.mul_mem (M.mul_mem hxM (hAM ha)) (M.inv_mem hxM)
  exact hM.ne_top (top_le_iff.mp (hgen ▸ sup_le hEM hSM))

private theorem map_conjugate
    {G K : Type*} [Group G] [Group K]
    (f : G →* K) (A : Subgroup G) (x : G) :
    (A.conjBy x).map f = (A.map f).conjBy (f x) := by
  simp only [Subgroup.conjBy, Subgroup.map_map]
  congr 1
  ext a
  simp [MulAut.conj_apply]

public theorem residual_conjugate_pair_sup_sylow_eq
    {G : Type*} [Group G] [Finite G]
    (P S A E : Subgroup G) (hP : P ∈ PSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable P) (hAS : A ≤ S) (hEP : E ≤ P)
    (x : G) (hxE : x ∈ E) (hxR : x ∈ twoResidualAmbient P)
    (hE : E = A ⊔ A.conjBy x) (hgen : E ⊔ S = P)
    (S' : Subgroup G) (hS' : IsSylowSubgroupIn S' P) : E ⊔ S' = P := by
  have hSP : S ≤ P := le_sup_right.trans_eq hgen
  have hAP : A ≤ P := hAS.trans hSP
  obtain ⟨sylow, hsylow⟩ := hP.1.2.1
  obtain ⟨sylow', hsylow'⟩ := hS'
  obtain ⟨M, hM, hSM, hunique⟩ := hP.2
  have hSM' : (sylow : Subgroup P) ≤ M := by
    apply (Subgroup.map_le_map_iff_of_injective P.subtype_injective).mp
    simpa only [hsylow] using hSM
  have hunique' : ∀ L : Subgroup P, IsCoatom L →
      (sylow : Subgroup P) ≤ L → L = M := by
    intro L hL hSL
    apply hunique L hL
    simpa only [hsylow] using Subgroup.map_mono (f := P.subtype) hSL
  let xp : P := ⟨x, hEP hxE⟩
  have hxres : xp ∈ twoResidualAmbient (⊤ : Subgroup P) := by
    rw [twoResidualAmbient_top_eq_hktPResidual,
      ← twoResidualSubgroup_eq_hktPResidual']
    obtain ⟨y, hy, hyx⟩ := hxR
    have heq : y = xp := Subtype.ext hyx
    exact heq ▸ hy
  have hAS' : A.subgroupOf P ≤ (sylow : Subgroup P) := by
    apply (Subgroup.map_le_map_iff_of_injective P.subtype_injective).mp
    simpa only [Subgroup.map_subgroupOf_eq_of_le hAP, hsylow] using hAS
  have hE' : E.subgroupOf P = A.subgroupOf P ⊔ (A.subgroupOf P).conjBy xp := by
    apply Subgroup.map_injective P.subtype_injective
    rw [Subgroup.map_sup, map_conjugate, Subgroup.map_subgroupOf_eq_of_le hAP,
      Subgroup.map_subgroupOf_eq_of_le hEP]
    exact hE
  have hgen' : E.subgroupOf P ⊔ (sylow : Subgroup P) = ⊤ := by
    apply Subgroup.map_injective P.subtype_injective
    rw [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hEP, hsylow,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    exact hgen
  have hresult := residual_conjugate_pair_sup_sylow_eq_top hsolv sylow M hM hSM'
    hunique' (A.subgroupOf P) (E.subgroupOf P) hAS' xp hxE hxres hE' hgen' sylow'
  have hmap := congrArg (Subgroup.map P.subtype) hresult
  simpa only [Subgroup.map_sup, Subgroup.map_subgroupOf_eq_of_le hEP, hsylow',
    ← MonoidHom.range_eq_map, Subgroup.range_subtype] using hmap

end Stellmacher.SectionThree
