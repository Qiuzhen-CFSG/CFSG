module

public import Stellmacher.SectionThree.LemmaThreeTwo
public import Stellmacher.SectionThree.NormalSubgroupCoreControl

/-!
# A generating local-family member in a normal supplement

Let `P ∈ PSet ⊤ S` be solvable. A normal subgroup `L` of `P` has a
supplied Sylow image `T ≤ S`, with `L ∈ LSet ⊤ T` and `T` outside `O₂(P)`.
Then some `F ∈ PSet L T` generates `P` together with `S`.

The Sylow-generated residual `R = O^{2′}(L)` is characteristic in `L`,
hence normal in `P`, and contains `T`. The normal-subgroup consequence
of (3.3) forces `R S = P`, since otherwise `T ≤ R ∩ S ≤ O₂(P)`.
By (3.2), `R` is generated by `PSet L T`. If every such member had a
proper join with `S`, uniqueness of the maximal subgroup of `P` containing
`S` would put all of `R` in that maximal subgroup, a contradiction.

Source: `refs/latex/stellmacher-n-group.tex`, proof of (8.3), journal page 38,
the application of (3.2) and (3.3) to `L = E_a Q_{a+1}`. The abstract
statement retains the actual smaller Sylow subgroup and normal supplement.
-/

open scoped BigOperators
namespace Stellmacher.SectionThree

private theorem primeResidual_characteristic
    {G : Type*} [Group G] [Finite G] (L : Subgroup G) :
    (twoPrimeResidualSubgroup L).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro e
  unfold twoPrimeResidualSubgroup
  rw [Subgroup.map_iSup]
  apply le_antisymm
  · exact iSup_le fun T =>
      le_iSup (fun U : Sylow 2 L => (U : Subgroup L))
        (T.mapSurjective e.surjective)
  · refine iSup_le fun U => ?_
    obtain ⟨T,hT⟩ := Sylow.mapSurjective_surjective
      (f := e.toMonoidHom) e.surjective 2 U
    rw [← hT]
    exact le_iSup (fun R : Sylow 2 L => (R : Subgroup L).map e.toMonoidHom) T

private theorem le_unique_maximal
    {G : Type*} [Group G] [Finite G]
    {S P L : Subgroup G} {B : Subgroup P}
    (huniq : ∀ B' : Subgroup P, IsCoatom B' → S ≤ B'.map P.subtype → B' = B)
    (hSL : S ≤ L) (hLP : L ≤ P) (hne : L ≠ P) : L ≤ B.map P.subtype := by
  have hproper : L.subgroupOf P ≠ ⊤ := by
    intro ht
    apply hne
    rw [← Subgroup.map_subgroupOf_eq_of_le hLP, ht,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  obtain ⟨B',hB',hLB'⟩ :=
    (eq_top_or_exists_le_coatom (L.subgroupOf P)).resolve_left hproper
  have hSB' : S ≤ B'.map P.subtype := by
    apply hSL.trans
    rw [← Subgroup.map_subgroupOf_eq_of_le hLP]
    exact Subgroup.map_mono hLB'
  rw [← huniq B' hB' hSB', ← Subgroup.map_subgroupOf_eq_of_le hLP]
  exact Subgroup.map_mono hLB'

/-- A local-family member of the normal supplement generates with the fixed Sylow. -/
public theorem exists_pSet_generating_of_normal_supplement
    {G : Type*} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (P : Subgroup G) (hP : P ∈ PSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable P)
    (T L : Subgroup G) (hTS : T ≤ S)
    (hL : L ∈ LSet (⊤ : Subgroup G) T)
    (hLP : L ≤ P) (hLN : (L.subgroupOf P).Normal)
    (hTnot : ¬ T ≤ twoCoreAmbient P) :
    ∃ F : Subgroup G, F ∈ PSet L T ∧ F ⊔ S = P := by
  classical
  let R := twoPrimeResidualAmbient L
  let _ : (twoPrimeResidualSubgroup L).Characteristic := primeResidual_characteristic L
  have hRL : R ≤ L := Subgroup.map_subtype_le _
  have hRP : R ≤ P := hRL.trans hLP
  have hRN : (R.subgroupOf P).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hRP).mpr
      (((Subgroup.normal_subgroupOf_iff_le_normalizer hLP).mp hLN).trans
        (BenderSuzuki.External.hkt_normalizer_le_normalizer_map_subtype_of_characteristic
          L (twoPrimeResidualSubgroup L)))
  have hTR : T ≤ R := by
    obtain ⟨TL,hTL⟩ := hL.2.1
    rw [← hTL]
    exact Subgroup.map_mono (le_iSup (fun U : Sylow 2 L => (U : Subgroup L)) TL)
  have hSP : S ≤ P := by
    obtain ⟨SP,hSP⟩ := hP.1.2.1
    exact hSP ▸ Subgroup.map_subtype_le _
  have hPRS : P ≤ R ⊔ S := by
    by_contra hnot
    have hcore := normal_inf_sylow_le_twoCore S h P R hP hsolv hRP hRN hnot
    exact hTnot ((le_inf hTR hTS).trans hcore)
  have hTne : T ≠ ⊥ := by
    intro ht
    exact hTnot (ht ▸ bot_le)
  have hTctx : Hypotheses G T :=
    ⟨h.even_order, hTne, h.nontrivial_two_subgroup.2.to_le hTS⟩
  obtain ⟨B,hB,hSB,huniq⟩ := hP.2
  by_contra! hnone
  have hRB : R ≤ B.map P.subtype := by
    rw [show R = twoPrimeResidualAmbient L from rfl, lemma_three_two T hTctx L hL]
    apply iSup_le
    intro F
    exact le_sup_left.trans (le_unique_maximal huniq le_sup_right
      (sup_le (F.property.1.1.trans hLP) hSP) (hnone F F.property))
  apply hB.1
  apply Subgroup.map_injective P.subtype_injective
  rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  exact le_antisymm (Subgroup.map_subtype_le _) (hPRS.trans (sup_le hRB hSB))

end Stellmacher.SectionThree
