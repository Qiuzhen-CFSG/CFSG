module

public import Stellmacher.SectionThree.LemmaThreeTwo
public import Stellmacher.SectionThree.LemmaThreeFour

/-!
# Stellmacher (3.7): the Fitting commutator is generated by local residuals

For a solvable local subgroup `L`, this module identifies
`[F(L / O₂(L)), S̄]` with the join of the images of `O²(P)` for
`P ∈ PStarSet L S`. This is the quotient-group form of Stellmacher (3.7).

The proof follows the source. Write `C = [F(L / O₂(L)), S̄]`, let `D`
be its inverse image in `L`, and put `E = D S`. Coprime action gives
`[C, S̄] = C`, while `C ∩ S̄ = 1`; these facts show that `E` is again
in `LSet ⊤ S` and is generated by its Sylow 2-subgroups. Stellmacher (3.2)
then generates `E` by `PSet E S`.

The two local families are identified in both directions. Result (3.4), with
`T = S`, puts every starred residual image in `C`. Conversely,
`(C S̄)/C` is a 2-group, so `O²(P)` lies in `D` for every
`P ∈ PSet E S`. Its quotient image lies in the nilpotent Fitting subgroup;
subnormality there, followed by lifting through `O₂(L)`, supplies the
`PStarSet` witness. Result (3.3)(a) is used for the complementary Fitting
containment of already-starred residuals. Mapping the generated-subgroup
equality to `L / O₂(L)` and cancelling the disjoint normalized Sylow factor
finishes the equality. The public `twoResidual_sup_sylowImage` supplies the
residual/Sylow factorization used again in Section 4's local action setup.
The kernel characterization of the residual and its containment under a
normal 2-group extension are public for the residual-stability argument in
(7.7).

Source: `refs/latex/stellmacher-n-group.tex`, statement and proof (3.7),
journal page 23.
-/

open scoped BigOperators Pointwise commutatorElement

namespace Stellmacher.SectionThree

open BenderSuzuki.External

universe u v

private theorem twoResidualAmbient_eq_map_hktPResidual
    {G : Type u} [Group G] [Finite G] (P : Subgroup G) :
    twoResidualAmbient P = (hktPResidual 2 P).map P.subtype := by
  have heq : twoResidualSubgroup P = hktPResidual 2 P := by
    apply le_antisymm
    · have hnormal : (hktPResidual 2 P).Normal := hktPResidual_normal
      let _ : (hktPResidual 2 P).Normal := hnormal
      obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := 2)).mp
        (hktPResidual_quotient_isPGroup (Q := P) (q := 2))
      apply sInf_le
      refine ⟨hnormal, n, ?_⟩
      simpa [Subgroup.index_eq_card] using hn
    · apply le_sInf
      intro N hN
      have hnormal : N.Normal := hN.1
      let _ : N.Normal := hnormal
      obtain ⟨n, hn⟩ := hN.2
      apply hktPResidual_le N hnormal
      rw [IsPGroup.iff_card]
      exact ⟨n, by simpa [Subgroup.index_eq_card] using hn⟩
  simp [twoResidualAmbient, heq]

private theorem hktPResidual_map_of_surjective
    {G : Type u} {H : Type v} [Group G] [Group H]
    [Finite G] [Finite H] {p : ℕ} [Fact p.Prime]
    (f : G →* H) (hf : Function.Surjective f) :
    (hktPResidual p G).map f = hktPResidual p H := by
  classical
  apply le_antisymm
  · let R : Subgroup H := hktPResidual p H
    have hRnormal : R.Normal := hktPResidual_normal
    let _ : R.Normal := hRnormal
    let N : Subgroup G := R.comap f
    have hNnormal : N.Normal := hRnormal.comap f
    let _ : N.Normal := hNnormal
    have hmapN : N.map f = R :=
      Subgroup.map_comap_eq_self_of_surjective hf R
    let qmap : G ⧸ N →* H ⧸ R :=
      QuotientGroup.map N R f (fun _ hx => hx)
    have hqmap_bij : Function.Bijective qmap := by
      constructor
      · intro x y hxy
        obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective N x
        obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective N y
        apply QuotientGroup.eq_iff_div_mem.mpr
        change f (a / b) ∈ R
        simpa using (QuotientGroup.eq_iff_div_mem.mp hxy)
      · intro y
        obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective R y
        obtain ⟨a, rfl⟩ := hf b
        exact ⟨QuotientGroup.mk' N a, rfl⟩
    let e : (G ⧸ N) ≃* (H ⧸ R) := MulEquiv.ofBijective qmap hqmap_bij
    have hquot : IsPGroup p (G ⧸ N) :=
      (hktPResidual_quotient_isPGroup (Q := H) (q := p)).of_equiv e.symm
    exact (Subgroup.map_mono (hktPResidual_le N hNnormal hquot)).trans
      (le_of_eq hmapN)
  · have hmapNormal : ((hktPResidual p G).map f).Normal :=
      (hktPResidual_normal (Q := G) (q := p)).map f hf
    let _ : ((hktPResidual p G).map f).Normal := hmapNormal
    let R : Subgroup G := hktPResidual p G
    let _ : R.Normal := hktPResidual_normal
    let qmap : G ⧸ R →* H ⧸ R.map f :=
      QuotientGroup.map R (R.map f) f (fun _ hx => Subgroup.mem_map_of_mem f hx)
    have hqmap_surj : Function.Surjective qmap := by
      intro y
      obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (R.map f) y
      obtain ⟨a, rfl⟩ := hf b
      exact ⟨QuotientGroup.mk' R a, rfl⟩
    have hquot : IsPGroup p (H ⧸ R.map f) :=
      IsPGroup.of_surjective
        (hG := hktPResidual_quotient_isPGroup (Q := G) (q := p))
        qmap hqmap_surj
    exact hktPResidual_le (R.map f) hmapNormal hquot

private theorem pSet_top_of_pSet
    {G : Type u} [Group G] [Finite G]
    {S U P : Subgroup G} (hP : P ∈ PSet U S) :
    P ∈ PSet (⊤ : Subgroup G) S :=
  ⟨⟨le_top, hP.1.2.1, hP.1.2.2.1, hP.1.2.2.2⟩, hP.2⟩

private theorem pstar_residual_subnormal_in_L
    {G : Type u} [Group G] [Finite G]
    {S L P : Subgroup G}
    (hL : L ∈ LSet (⊤ : Subgroup G) S)
    (hP : P ∈ PStarSet L S) :
    IsSubnormalIn (twoResidualAmbient P) L := by
  rcases hP.2 with ⟨M, hM, hsub⟩
  have hLlocal : L ∈ LSet L S :=
    ⟨le_rfl, hL.2.1, hL.2.2.1, hL.2.2.2⟩
  have hLM : L = M := hM.2 L hLlocal hM.1.1
  rwa [hLM]

private theorem pset_solvable_of_solvable_overgroup
    {G : Type u} [Group G] [Finite G]
    {S U P : Subgroup G}
    (hsolv : Group.IsSolvable U) (hP : P ∈ PSet U S) :
    Group.IsSolvable P := by
  let _ : Group.IsSolvable U := hsolv
  exact Group.isSolvable_of_isSolvable_injective
    (Subgroup.inclusion_injective hP.1.1)

private theorem three_three_part_a_of_pSet
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (P : Subgroup G) (hP : P ∈ PSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable P) :
    ∃ p : ℕ, p.Prime ∧ Odd p ∧
      IsPGroup p
        (twoResidualAmbient (⊤ : Subgroup (P ⧸ pCore 2 P))) := by
  rcases hP.2 with ⟨B, hBmax, hSB, hBuniq⟩
  have hSP : S ≤ P := by
    obtain ⟨T, hT⟩ := hP.1.2.1
    rw [← hT]
    exact Subgroup.map_subtype_le (T : Subgroup P)
  have hSsubB : S.subgroupOf P ≤ B := by
    intro s hs
    have hsS : (s : G) ∈ S := hs
    obtain ⟨b, hb, hbs⟩ := hSB hsS
    have hbeq : b = s := P.subtype_injective hbs
    simpa [← hbeq] using hb
  let P₀ : Subgroup P := B.normalCore
  have hP₀ : P₀ ≤ B ∧ P₀.Normal ∧
      ∀ N : Subgroup P, N.Normal → N ≤ B → N ≤ P₀ := by
    refine ⟨B.normalCore_le, inferInstance, ?_⟩
    intro N hN hNB
    exact (@Subgroup.normal_le_normalCore P _ B N hN).2 hNB
  have hc := lemma_three_three S h P hP B P₀
    ⟨hBmax, hSsubB, by
      intro B' hB'max hSB'
      apply hBuniq B' hB'max
      intro s hs
      exact Subgroup.mem_map.mpr
        ⟨⟨s, hSP hs⟩, hSB' (show (⟨s, hSP hs⟩ : P) ∈
          S.subgroupOf P from hs), rfl⟩⟩ hP₀ hsolv
  exact hc.part_a

private noncomputable def pCoreAmbientLocal
    {G : Type u} [Group G] (P : Subgroup G) (p : ℕ) : Subgroup G :=
  (pCore p P).map P.subtype

private theorem pCoreAmbientLocal_isPGroup
    {G : Type u} [Group G] [Finite G]
    (P : Subgroup G) (p : ℕ) : IsPGroup p (pCoreAmbientLocal P p) := by
  exact (pCore_isPGroup (G := P) (p := p)).map P.subtype

private def IsNormalInLocal
    {G : Type u} [Group G] (A B : Subgroup G) : Prop :=
  A ≤ B ∧ ∀ b : G, b ∈ B → ∀ a : G, a ∈ A → b * a * b⁻¹ ∈ A

private theorem map_characteristic_isNormalIn_local
    {G : Type u} [Group G] {H N : Subgroup G}
    (K : Subgroup H) (hKchar : K.Characteristic)
    (hHnormal : IsNormalInLocal H N) :
    IsNormalInLocal (K.map H.subtype) N := by
  refine ⟨(Subgroup.map_subtype_le K).trans hHnormal.1, ?_⟩
  intro n hn x hx
  rcases (Subgroup.mem_map).1 hx with ⟨k, hk, rfl⟩
  let e : H ≃* H :=
    { toFun := fun y => ⟨n * y.1 * n⁻¹, hHnormal.2 n hn y.1 y.2⟩
      invFun := fun y => ⟨n⁻¹ * y.1 * n, by
        have hy := hHnormal.2 n⁻¹ (N.inv_mem hn) y.1 y.2
        simpa using hy⟩
      left_inv := by intro y; ext; group
      right_inv := by intro y; ext; group
      map_mul' := by
        intro a b
        ext
        change n * ↑(a * b) * n⁻¹ =
          (n * ↑a * n⁻¹) * (n * ↑b * n⁻¹)
        rw [Subgroup.coe_mul]
        group }
  have hek : e k ∈ K := by
    rw [← (Subgroup.characteristic_iff_map_eq.mp hKchar) e]
    exact Subgroup.mem_map.mpr ⟨k, hk, rfl⟩
  exact Subgroup.mem_map.mpr ⟨e k, hek, rfl⟩

private theorem pCoreAmbientLocal_mono_of_isNormalIn
    {G : Type u} [Group G] [Finite G]
    (A B : Subgroup G) (p : ℕ) (hAB : IsNormalInLocal A B) :
    pCoreAmbientLocal A p ≤ pCoreAmbientLocal B p := by
  have hQnormal : IsNormalInLocal (pCoreAmbientLocal A p) B := by
    simpa [pCoreAmbientLocal] using
      map_characteristic_isNormalIn_local (pCore p A)
        (inferInstance : (pCore p A).Characteristic) hAB
  let Q : Subgroup B := (pCoreAmbientLocal A p).subgroupOf B
  have hQnormalB : Q.Normal := by
    rw [Subgroup.normal_subgroupOf_iff hQnormal.1]
    intro x b hx hb
    exact hQnormal.2 b hb x hx
  have hQp : IsPGroup p Q :=
    (pCoreAmbientLocal_isPGroup A p).of_equiv
      (Subgroup.subgroupOfEquivOfLe hQnormal.1).symm
  have hQle : Q ≤ pCore p B := le_sSup ⟨hQnormalB, hQp⟩
  have hmap := Subgroup.map_mono (f := B.subtype) hQle
  have hQmap : Q.map B.subtype = pCoreAmbientLocal A p :=
    Subgroup.map_subgroupOf_eq_of_le hQnormal.1
  rw [hQmap] at hmap
  exact hmap

private theorem le_pCoreAmbientLocal_of_isSubnormal_isPGroup
    {G : Type u} [Group G] [Finite G]
    (B A : Subgroup G) (p : ℕ)
    (hAB : A ≤ B) (hsub : (A.subgroupOf B).IsSubnormal)
    (hAp : IsPGroup p A) : A ≤ pCoreAmbientLocal B p := by
  rcases (Subgroup.IsSubnormal.isSubnormal_iff
      (G := B) (H := A.subgroupOf B)).1 hsub with
    ⟨n, f, hmono, hnormal, hf0, hfn⟩
  have hmain : ∀ i : ℕ, i ≤ n →
      A ≤ pCoreAmbientLocal ((f i).map B.subtype) p := by
    intro i hi
    induction i with
    | zero =>
        have hK0 : (f 0).map B.subtype = A := by
          rw [hf0]
          exact Subgroup.map_subgroupOf_eq_of_le hAB
        rw [hK0]
        intro a ha
        change a ∈ (pCore p A).map A.subtype
        have htop : (⊤ : Subgroup A) ≤ pCore p A :=
          le_sSup ⟨inferInstance, hAp.to_subgroup ⊤⟩
        exact ⟨⟨a, ha⟩, htop trivial, rfl⟩
    | succ i ih =>
        have hKi : IsNormalInLocal ((f i).map B.subtype)
            ((f (i + 1)).map B.subtype) := by
          refine ⟨Subgroup.map_mono (hmono (Nat.le_succ i)), ?_⟩
          intro b hb x hx
          rcases (Subgroup.mem_map).1 hx with ⟨x0, hx0, rfl⟩
          rcases (Subgroup.mem_map).1 hb with ⟨b0, hb0, rfl⟩
          have hc := (Subgroup.normal_subgroupOf_iff
            (hmono (Nat.le_succ i))).mp (hnormal i) x0 b0 hx0 hb0
          exact Subgroup.mem_map.mpr
            ⟨b0 * x0 * b0⁻¹, hc, by simp [mul_assoc]⟩
        exact (ih (Nat.le_of_succ_le hi)).trans
          (pCoreAmbientLocal_mono_of_isNormalIn _ _ p hKi)
  have hlast := hmain n le_rfl
  have htop : (⊤ : Subgroup B).map B.subtype = B := by
    simpa [MonoidHom.range_eq_map] using (Subgroup.range_subtype (H := B))
  rw [hfn, htop] at hlast
  exact hlast

private theorem isPGroup_range_of_ker_le
    {A : Type u} {B : Type v} {C : Type*}
    [Group A] [Group B] [Group C] [Finite A] [Finite B] [Finite C]
    {p : ℕ} (f : A →* B) (g : A →* C)
    (hker : f.ker ≤ g.ker) (hf : IsPGroup p f.range) :
    IsPGroup p g.range := by
  classical
  let fr : A →* f.range := f.rangeRestrict
  let gr : A →* g.range := g.rangeRestrict
  have hfr : Function.Surjective fr := by
    simpa [fr] using f.rangeRestrict_surjective
  have hgr : Function.Surjective gr := by
    simpa [gr] using g.rangeRestrict_surjective
  have hker' : fr.ker ≤ gr.ker := by
    simpa [fr, gr, MonoidHom.ker_rangeRestrict] using hker
  let e : f.range →* g.range :=
    fr.liftOfSurjective hfr ⟨gr, hker'⟩
  have he_surj : Function.Surjective e := by
    intro y
    obtain ⟨a, ha⟩ := hgr y
    refine ⟨fr a, ?_⟩
    rw [← ha]
    exact fr.liftOfRightInverse_comp_apply
      (Function.surjInv hfr)
      (Function.rightInverse_surjInv hfr) ⟨gr, hker'⟩ a
  exact IsPGroup.of_surjective (hG := hf) e he_surj

private theorem normal_subgroupOf_subgroupOf_local
    {G : Type u} [Group G] {H K L : Subgroup G}
    (hHK : H ≤ K) (_hKL : K ≤ L)
    (hN : (H.subgroupOf K).Normal) :
    ((H.subgroupOf L).subgroupOf (K.subgroupOf L)).Normal := by
  rw [Subgroup.normal_subgroupOf_iff (Subgroup.subgroupOf_mono L hHK)]
  intro h k hh hk
  exact (Subgroup.normal_subgroupOf_iff hHK).mp hN
    (h : G) (k : G) hh hk

private theorem residual_image_isPGroup_of_pstar
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (L : Subgroup G) (hL : L ∈ LSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable L)
    (P : Subgroup G) (hP : P ∈ PStarSet L S) :
    ∃ p : ℕ, p.Prime ∧ Odd p ∧
      IsPGroup p (twoResidualImageInQuotient L P) := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hPL : P ≤ L := hP.1.1.1
  have hPtop : P ∈ PSet (⊤ : Subgroup G) S :=
    pSet_top_of_pSet hP.1
  have hPsolv : Group.IsSolvable P :=
    pset_solvable_of_solvable_overgroup hsolv hP.1
  obtain ⟨p, hp, hpodd, hpquot⟩ :=
    three_three_part_a_of_pSet S h P hPtop hPsolv
  let R : Subgroup P := hktPResidual 2 P
  let O : Subgroup P := pCore 2 P
  let _ : R.Normal := hktPResidual_normal
  let qP : P →* P ⧸ O := QuotientGroup.mk' O
  let iPL : P →* L := Subgroup.inclusion hPL
  let qL : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let fP : R →* P ⧸ O := qP.comp R.subtype
  let fL : R →* L ⧸ pCore 2 L := (qL.comp iPL).comp R.subtype
  have hfPrange : fP.range =
      twoResidualAmbient (⊤ : Subgroup (P ⧸ O)) := by
    calc
      fP.range = R.map qP := by
        ext x
        simp [fP, R, qP, MonoidHom.mem_range]
      _ = hktPResidual 2 (P ⧸ O) := by
        simpa [R, qP] using
          hktPResidual_map_of_surjective qP
            (QuotientGroup.mk'_surjective O)
      _ = twoResidualAmbient (⊤ : Subgroup (P ⧸ O)) := by
        rw [twoResidualAmbient_top_eq_hktPResidual]
  have hfPgroup : IsPGroup p fP.range := by
    rw [hfPrange]
    simpa [O] using hpquot
  let A : Subgroup G := twoResidualAmbient P
  let K : Subgroup G := (R ⊓ O).map P.subtype
  have hAeq : A = R.map P.subtype := by
    simpa [A, R] using twoResidualAmbient_eq_map_hktPResidual P
  have hKA : K ≤ A := by
    rw [hAeq]
    exact Subgroup.map_mono inf_le_left
  have hKnormalA : (K.subgroupOf A).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hKA]
    intro k a hk ha
    rcases hk with ⟨k0, hk0, rfl⟩
    rcases ha with ⟨a0, ha0, rfl⟩
    refine Subgroup.mem_map.mpr ⟨a0 * k0 * a0⁻¹, ?_, by simp⟩
    exact (inferInstance : (R ⊓ O).Normal).conj_mem k0 hk0 a0
  have hALsub : (A.subgroupOf L).IsSubnormal :=
    (pstar_residual_subnormal_in_L hL hP).2
  have hKLsub : (K.subgroupOf L).IsSubnormal := by
    refine Subgroup.IsSubnormal.step _ (A.subgroupOf L)
      (Subgroup.subgroupOf_mono L hKA) hALsub ?_
    exact normal_subgroupOf_subgroupOf_local hKA
      (pstar_residual_subnormal_in_L hL hP).1 hKnormalA
  have hKp : IsPGroup 2 K := by
    have hROp : IsPGroup 2 (↥(R ⊓ O : Subgroup P)) :=
      ((pCore_isPGroup (G := P) (p := 2)).to_subgroup
        ((R ⊓ O).subgroupOf O)).of_equiv
          (Subgroup.subgroupOfEquivOfLe
            (G := P) (H := R ⊓ O) (K := O) inf_le_right)
    exact hROp.map P.subtype
  have hKcore : K ≤ (pCore 2 L).map L.subtype := by
    simpa [pCoreAmbientLocal] using
      le_pCoreAmbientLocal_of_isSubnormal_isPGroup L K 2
        (hKA.trans (pstar_residual_subnormal_in_L hL hP).1) hKLsub hKp
  have hker : fP.ker ≤ fL.ker := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx ⊢
    have hxO : (x : P) ∈ O :=
      (QuotientGroup.eq_one_iff (N := O) (x := (x : P))).mp hx
    have hxK : ((x : P) : G) ∈ K :=
      Subgroup.mem_map.mpr ⟨(x : P), ⟨x.property, hxO⟩, rfl⟩
    rcases hKcore hxK with ⟨y, hy, hyx⟩
    apply (QuotientGroup.eq_one_iff (N := pCore 2 L)
      (x := iPL (x : P))).mpr
    have hy_eq : y = iPL (x : P) := L.subtype_injective hyx
    simpa [hy_eq] using hy
  have hfLgroup : IsPGroup p fL.range :=
    isPGroup_range_of_ker_le fP fL hker hfPgroup
  refine ⟨p, hp, hpodd, ?_⟩
  have hfLrange : fL.range = twoResidualImageInQuotient L P := by
    have hRi : R.map iPL = A.subgroupOf L := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        change ((y : P) : G) ∈ A
        rw [hAeq]
        exact Subgroup.mem_map.mpr ⟨y, hy, rfl⟩
      · intro hx
        change (x : G) ∈ A at hx
        rw [hAeq] at hx
        rcases hx with ⟨y, hy, hyx⟩
        have hyeq : iPL y = x := L.subtype_injective hyx
        exact ⟨y, hy, hyeq⟩
    calc
      fL.range = R.map (qL.comp iPL) := by
        ext x
        simp [fL, MonoidHom.mem_range]
      _ = (R.map iPL).map qL := by rw [Subgroup.map_map]
      _ = (A.subgroupOf L).map qL := by rw [hRi]
      _ = twoResidualImageInQuotient L P := rfl
  rwa [← hfLrange]

private theorem le_fittingSubgroupOfLocal_of_isNormalIn_nilpotent
    {G : Type u} [Group G] [Finite G]
    {A N : Subgroup G} (hNA : N ≤ A)
    (hNnormal : IsNormalInLocal N A) (hNnil : Group.IsNilpotent N) :
    N ≤ fittingSubgroupOf A := by
  let N' : Subgroup A := N.subgroupOf A
  have hN'normal : N'.Normal := by
    rw [Subgroup.normal_subgroupOf_iff hNA]
    intro n a hn ha
    exact hNnormal.2 a ha n hn
  have hN'nil : Group.IsNilpotent N' := by
    exact Group.nilpotent_of_mulEquiv
      (Subgroup.subgroupOfEquivOfLe hNA).symm
  have hle : N' ≤ fittingSubgroup A := le_sSup ⟨hN'normal, hN'nil⟩
  have hmap := Subgroup.map_mono (f := A.subtype) hle
  have hN'map : N'.map A.subtype = N :=
    Subgroup.map_subgroupOf_eq_of_le hNA
  simpa [fittingSubgroupOf, hN'map] using hmap

private theorem fittingSubgroupOfLocal_mono_of_isNormalIn
    {G : Type u} [Group G] [Finite G]
    {A B : Subgroup G} (hAB : IsNormalInLocal A B) :
    fittingSubgroupOf A ≤ fittingSubgroupOf B := by
  have hFnormal : IsNormalInLocal (fittingSubgroupOf A) B := by
    simpa [fittingSubgroupOf] using
      map_characteristic_isNormalIn_local (fittingSubgroup A)
        (inferInstance : (fittingSubgroup A).Characteristic) hAB
  exact le_fittingSubgroupOfLocal_of_isNormalIn_nilpotent
    hFnormal.1 hFnormal (fittingSubgroupOf_isNilpotent A)

private theorem le_fittingSubgroup_of_isSubnormal_nilpotent
    {G : Type u} [Group G] [Finite G] {N : Subgroup G}
    (hNsub : N.IsSubnormal) (hNnil : Group.IsNilpotent N) :
    N ≤ fittingSubgroup G := by
  rcases (Subgroup.IsSubnormal.isSubnormal_iff (G := G) (H := N)).1 hNsub with
    ⟨n, f, hmono, hnormal, hf0, hfn⟩
  have hmain : ∀ i : ℕ, i ≤ n →
      N ≤ fittingSubgroupOf (f i) := by
    intro i hi
    induction i with
    | zero =>
        rw [hf0]
        have htop : fittingSubgroup N = ⊤ :=
          fitting_eq_top_of_nilpotent N
        have heq : fittingSubgroupOf N = N := by
          rw [fittingSubgroupOf, htop, ← MonoidHom.range_eq_map,
            Subgroup.range_subtype]
        rw [heq]
    | succ i ih =>
        have hFi : IsNormalInLocal (f i) (f (i + 1)) := by
          refine ⟨hmono (Nat.le_succ i), ?_⟩
          intro b hb a ha
          exact (Subgroup.normal_subgroupOf_iff
            (hmono (Nat.le_succ i))).mp (hnormal i) a b ha hb
        exact (ih (Nat.le_of_succ_le hi)).trans
          (fittingSubgroupOfLocal_mono_of_isNormalIn hFi)
  have hlast := hmain n le_rfl
  rw [hfn] at hlast
  let T : Subgroup G := fittingSubgroupOf (⊤ : Subgroup G)
  have hTnormal : T.Normal := by
    dsimp [T, fittingSubgroupOf]
    exact ConjAct.normal_of_characteristic_of_normal
  have hTnil : Group.IsNilpotent T :=
    fittingSubgroupOf_isNilpotent (⊤ : Subgroup G)
  exact hlast.trans (le_sSup ⟨hTnormal, hTnil⟩)

private theorem residual_image_le_fitting_of_pstar
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (L : Subgroup G) (hL : L ∈ LSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable L)
    (P : Subgroup G) (hP : P ∈ PStarSet L S) :
    twoResidualImageInQuotient L P ≤ fittingSubgroup (L ⧸ pCore 2 L) := by
  let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let A : Subgroup L := (twoResidualAmbient P).subgroupOf L
  have hAsub : A.IsSubnormal :=
    (pstar_residual_subnormal_in_L hL hP).2
  have hmapSub : (A.map q).IsSubnormal :=
    hAsub.map (QuotientGroup.mk'_surjective (pCore 2 L))
  obtain ⟨p, hp, _hpodd, hpgroup⟩ :=
    residual_image_isPGroup_of_pstar S h L hL hsolv P hP
  let _ : Fact p.Prime := ⟨hp⟩
  have hnil : Group.IsNilpotent (A.map q) := by
    apply IsPGroup.isNilpotent (p := p)
    rw [show A.map q = twoResidualImageInQuotient L P by rfl]
    exact hpgroup
  have hle := le_fittingSubgroup_of_isSubnormal_nilpotent hmapSub hnil
  simpa [A, q, twoResidualImageInQuotient] using hle

private theorem twoCoreAmbient_le_sylowImage
    {G : Type u} [Group G] [Finite G]
    {S P : Subgroup G} (hSylow : IsSylowSubgroupIn S P) :
    twoCoreAmbient P ≤ S := by
  obtain ⟨T, hT⟩ := hSylow
  rw [← hT]
  exact Subgroup.map_mono
    ((pCore_isPGroup (G := P) (p := 2)).le_sylow_of_normal T)

private theorem residual_commutator_eq_of_pSet
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (P : Subgroup G) (hP : P ∈ PSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable P) :
    ⁅twoResidualAmbient P, S⁆ = twoResidualAmbient P := by
  rcases lemma_three_four S h P hP S ⟨le_rfl, by
      rw [show S.subgroupOf S = ⊤ by ext; simp]
      infer_instance⟩ hsolv with hcore | hcomm
  · exfalso
    apply hP.1.2.2.2
    exact le_antisymm hcore (twoCoreAmbient_le_sylowImage hP.1.2.1)
  · exact hcomm

private theorem isSylowSubgroupIn_of_between_local
    {G : Type u} [Group G] [Finite G]
    (U S P : Subgroup G) (hSP : S ≤ P) (hPU : P ≤ U)
    (hSylow : IsSylowSubgroupIn S U) :
    IsSylowSubgroupIn S P := by
  obtain ⟨T, hTmap⟩ := hSylow
  let PU : Subgroup U := P.subgroupOf U
  have hTlePU : (T : Subgroup U) ≤ PU := by
    intro t ht
    have htS : (t : G) ∈ S := by
      rw [← hTmap]
      exact ⟨t, ht, rfl⟩
    exact hSP htS
  let TU : Sylow 2 PU := T.subtype hTlePU
  let e : PU ≃* P := Subgroup.subgroupOfEquivOfLe hPU
  let he : Function.Surjective e.toMonoidHom := e.surjective
  let TP : Sylow 2 P := TU.mapSurjective he
  refine ⟨TP, ?_⟩
  dsimp only [TP]
  rw [Sylow.coe_mapSurjective, Subgroup.map_map]
  have hcomp : P.subtype.comp e.toMonoidHom =
      U.subtype.comp PU.subtype := by ext x; rfl
  rw [hcomp, ← Subgroup.map_map,
    show (TU : Subgroup PU) = (T : Subgroup U).subgroupOf PU by
      exact Sylow.coe_subtype T hTlePU,
    Subgroup.map_subgroupOf_eq_of_le hTlePU, hTmap]

private theorem twoCoreAmbient_mono_of_normal_local
    {G : Type u} [Group G]
    (L E : Subgroup G) (hEL : E ≤ L)
    (hcoreE : twoCoreAmbient L ≤ E) :
    twoCoreAmbient L ≤ twoCoreAmbient E := by
  let K : Subgroup E := (twoCoreAmbient L).subgroupOf E
  have hcoreLleL : twoCoreAmbient L ≤ L :=
    Subgroup.map_subtype_le (pCore 2 L)
  have hcoreNormalL : ((twoCoreAmbient L).subgroupOf L).Normal := by
    unfold twoCoreAmbient
    rw [subgroupOf_map_subtype_eq]
    infer_instance
  have hLnorm : L ≤ Subgroup.normalizer (twoCoreAmbient L : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hcoreLleL).1 hcoreNormalL
  have hKnormal : K.Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hcoreE).2
      (hEL.trans hLnorm)
  have hcoreP : IsPGroup 2 (twoCoreAmbient L) :=
    (pCore_isPGroup (p := 2) (G := L)).map L.subtype
  have hKp : IsPGroup 2 K := hcoreP.of_equiv
    (Subgroup.subgroupOfEquivOfLe hcoreE).symm
  have hKle : K ≤ pCore 2 E := le_sSup ⟨hKnormal, hKp⟩
  calc
    twoCoreAmbient L = K.map E.subtype :=
      (Subgroup.map_subgroupOf_eq_of_le hcoreE).symm
    _ ≤ (pCore 2 E).map E.subtype := Subgroup.map_mono hKle
    _ = twoCoreAmbient E := rfl

/-- The two-residual together with a Sylow 2-subgroup generates its overgroup. -/
public theorem twoResidual_sup_sylowImage
    {G : Type u} [Group G] [Finite G]
    {S P : Subgroup G} (hSylow : IsSylowSubgroupIn S P) :
    twoResidualAmbient P ⊔ S = P := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨T, hT⟩ := hSylow
  let R : Subgroup P := hktPResidual 2 P
  let _ : R.Normal := hktPResidual_normal
  let q : P →* P ⧸ R := QuotientGroup.mk' R
  have hquot : IsPGroup 2 (P ⧸ R) :=
    hktPResidual_quotient_isPGroup
  let Tbar : Sylow 2 (P ⧸ R) :=
    T.mapSurjective (QuotientGroup.mk'_surjective R)
  have hTbarTop : (Tbar : Subgroup (P ⧸ R)) = ⊤ := by
    exact (Tbar.3 (hquot.to_subgroup ⊤) le_top).symm
  have hsup : R ⊔ (T : Subgroup P) = ⊤ := by
    calc
      R ⊔ (T : Subgroup P) = q.ker ⊔ (T : Subgroup P) := by
        simp [q, QuotientGroup.ker_mk']
      _ = (T : Subgroup P) ⊔ q.ker := by rw [sup_comm]
      _ = ((T : Subgroup P).map q).comap q :=
        (Subgroup.comap_map_eq (f := q) (H := (T : Subgroup P))).symm
      _ = ⊤ := by
        rw [show (T : Subgroup P).map q = ⊤ by
          simpa [Tbar] using hTbarTop, Subgroup.comap_top]
  have hmapped := congrArg (fun K : Subgroup P => K.map P.subtype) hsup
  rw [Subgroup.map_sup, ← MonoidHom.range_eq_map,
    Subgroup.range_subtype] at hmapped
  rw [twoResidualAmbient_eq_map_hktPResidual, ← hT]
  exact hmapped

private theorem pCore_quotient_pCore_eq_bot
    (Q : Type u) [Group Q] [Finite Q] :
    pCore 2 (Q ⧸ pCore 2 Q) = ⊥ := by
  let O : Subgroup Q := pCore 2 Q
  let q : Q →* Q ⧸ O := QuotientGroup.mk' O
  have hmap := pCore_map_mk'_eq_of_normal_isPGroup
    (G := Q) (p := 2) O (pCore_isPGroup (G := Q) (p := 2))
  have hmapbot : (pCore 2 Q).map q = ⊥ := by
    apply (Subgroup.map_eq_bot_iff (f := q) (H := pCore 2 Q)).2
    simp [q, O, QuotientGroup.ker_mk']
  dsimp [q, O] at hmapbot
  exact hmap.symm.trans hmapbot

private theorem fitting_odd_of_pCore_eq_bot
    {Q : Type u} [Group Q] [Finite Q]
    (hO : pCore 2 Q = ⊥) : Odd (Nat.card (fittingSubgroup Q)) := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let F : Subgroup Q := fittingSubgroup Q
  have hFnorm : F.Normal := inferInstance
  let OF : Subgroup F := pCore 2 F
  have hOFmapNormal : (OF.map F.subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  have hOFmapP : IsPGroup 2 (OF.map F.subtype) :=
    (pCore_isPGroup (G := F) (p := 2)).map F.subtype
  have hOFmapLe : OF.map F.subtype ≤ pCore 2 Q :=
    le_sSup ⟨hOFmapNormal, hOFmapP⟩
  have hOFbot : OF = ⊥ := by
    apply (Subgroup.map_injective F.subtype_injective)
    rw [Subgroup.map_bot]
    rw [hO] at hOFmapLe
    exact le_antisymm hOFmapLe bot_le
  apply Nat.not_even_iff_odd.mp
  intro heven
  let SF : Sylow 2 F := Classical.choice (Sylow.nonempty (p := 2) (G := F))
  have hSFne : (SF : Subgroup F) ≠ ⊥ :=
    SF.ne_bot_of_dvd_card heven.two_dvd
  have hSFnorm : (SF : Subgroup F).Normal :=
    Group.IsNilpotent.sylow_normal (by infer_instance) 2 SF
  have hSFle : (SF : Subgroup F) ≤ OF :=
    le_sSup ⟨hSFnorm, SF.isPGroup'⟩
  rw [hOFbot] at hSFle
  exact hSFne (le_antisymm hSFle bot_le)

private theorem commutator_double_eq_self_of_coprime_solvable
    {G : Type u} [Group G] [Finite G]
    (P K : Subgroup G) (hPK : P ≤ Subgroup.normalizer (K : Set G))
    (hcop : Nat.Coprime (Nat.card P) (Nat.card K))
    (hsolv : Group.IsSolvable K) :
    ⁅⁅K, P⁆, P⁆ = ⁅K, P⁆ := by
  classical
  let _ : Subgroup.Normalizes P K := ⟨hPK⟩
  let _ : MulDistribMulAction P K :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer P K hPK
  let C : Subgroup K := commutatorAction (A := P) (G := K)
  have hCmap : C.map K.subtype = ⁅K, P⁆ :=
    commutatorAction_subgroup_conj_map_eq_commutator K P hPK
  have hC2eq : commutatorAction₂ (A := P) (G := K) = C :=
    commutatorAction₂_eq_commutatorAction_of_solvable_coprime
      (G := K) (A := P) hsolv hcop
  have hXle : ⁅⁅K, P⁆, P⁆ ≤ ⁅K, P⁆ :=
    (Subgroup.le_normalizer_iff_commutator_le_left).mp
      (Subgroup.normalizer_commutator_ge_right K P)
  have hcomm₂_le :
      (commutatorAction₂ (A := P) (G := K)).map K.subtype ≤
        ⁅⁅K, P⁆, P⁆ := by
    let X : Set K := {x : K | ∃ a : P, ∃ k : K,
      k ∈ C ∧ x = k⁻¹ * (a • k)}
    calc
      (commutatorAction₂ (A := P) (G := K)).map K.subtype =
          (Subgroup.closure X).map K.subtype := by rfl
      _ = Subgroup.closure (K.subtype '' X) := by
        simpa using (MonoidHom.map_closure (f := K.subtype) X)
      _ ≤ ⁅⁅K, P⁆, P⁆ := by
        refine (Subgroup.closure_le (K := ⁅⁅K, P⁆, P⁆)).2 ?_
        rintro _ ⟨y, hy, rfl⟩
        rcases hy with ⟨a, k, hkC, rfl⟩
        have hkX : (k : G) ∈ ⁅K, P⁆ := by
          rw [← hCmap]
          exact Subgroup.mem_map.mpr ⟨k, hkC, rfl⟩
        have hgen : ⁅((k : K) : G)⁻¹, (a : G)⁆ ∈ ⁅⁅K, P⁆, P⁆ :=
          Subgroup.commutator_mem_commutator
            (Subgroup.inv_mem (H := ⁅K, P⁆) hkX) a.2
        simpa [commutatorElement_def,
          Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe,
          mul_assoc] using hgen
  have hreverse : ⁅K, P⁆ ≤ ⁅⁅K, P⁆, P⁆ := by
    calc
      ⁅K, P⁆ = C.map K.subtype := hCmap.symm
      _ = (commutatorAction₂ (A := P) (G := K)).map K.subtype := by
        rw [hC2eq]
      _ ≤ ⁅⁅K, P⁆, P⁆ := hcomm₂_le
  exact le_antisymm hXle hreverse

private theorem isSubnormal_of_normalizerCondition_local
    {G : Type u} [Group G] [Finite G]
    (hNC : NormalizerCondition G) (H : Subgroup G) : H.IsSubnormal := by
  classical
  let P : ℕ → Prop := fun n ↦ ∀ H : Subgroup G, H.index = n → H.IsSubnormal
  have hP : ∀ n, P n := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih H hn
    by_cases htop : H = ⊤
    · rw [htop]
      exact Subgroup.IsSubnormal.top (G := G)
    · let N := Subgroup.normalizer (H : Set G)
      have hHltN : H < N := hNC H (lt_top_iff_ne_top.mpr htop)
      have hle : H ≤ N := le_of_lt hHltN
      have hN : (H.subgroupOf N).Normal :=
        (Subgroup.normal_subgroupOf_iff_le_normalizer hle).2 le_rfl
      have hind : N.index < H.index := by
        have hrel : H.relIndex N * N.index = H.index :=
          Subgroup.relIndex_mul_index hle
        have hrel_ge : 2 ≤ H.relIndex N := by
          have hne_top : H.subgroupOf N ≠ ⊤ := by
            intro htopN
            have hNleH : N ≤ H :=
              (Subgroup.subgroupOf_eq_top (H := H) (K := N)).1 htopN
            exact (ne_of_lt hHltN) (le_antisymm hle hNleH)
          exact Subgroup.one_lt_index_of_ne_top hne_top
        have hindN : 1 ≤ N.index := Nat.succ_le_of_lt
          (Nat.pos_of_ne_zero (Subgroup.index_ne_zero_of_finite (H := N)))
        calc
          N.index < 2 * N.index := by omega
          _ ≤ H.relIndex N * N.index := Nat.mul_le_mul_right N.index hrel_ge
          _ = H.index := hrel
      exact Subgroup.IsSubnormal.step H N hle
        (ih N.index (by simpa [hn] using hind) N rfl) hN
  exact hP H.index H rfl

private theorem isSubnormal_of_isNilpotent_local
    {G : Type u} [Group G] [Finite G]
    (hG : Group.IsNilpotent G) (H : Subgroup G) : H.IsSubnormal := by
  let _ : Group.IsNilpotent G := hG
  exact isSubnormal_of_normalizerCondition_local
    Group.normalizerCondition_of_isNilpotent H

private theorem inf_eq_bot_of_isPGroup_two_of_odd_card
    {G : Type u} [Group G] [Finite G]
    (A B : Subgroup G) (hA : IsPGroup 2 A)
    (hB : Odd (Nat.card B)) : A ⊓ B = ⊥ := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hKsub2 : IsPGroup 2 ↑((A ⊓ B).subgroupOf A) :=
    hA.to_subgroup ((A ⊓ B).subgroupOf A)
  have hK2 : IsPGroup 2 ↑(A ⊓ B) :=
    hKsub2.of_equiv
      (Subgroup.subgroupOfEquivOfLe (H := A ⊓ B) (K := A) inf_le_left)
  have hdvd : Nat.card ↑(A ⊓ B) ∣ Nat.card B :=
    Subgroup.card_dvd_of_le inf_le_right
  have hcop : Nat.Coprime 2 (Nat.card ↑(A ⊓ B)) :=
    Nat.Coprime.of_dvd_right hdvd hB.coprime_two_left
  have hcard : Nat.card ↑(A ⊓ B) = 1 := by
    rcases hK2.card_eq_or_dvd with h1 | htwo
    · exact h1
    · exact False.elim
        ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).1 hcop htwo)
  exact Subgroup.card_eq_one.mp hcard

private theorem quotient_commutator_structure
    {G : Type u} [Group G] [Finite G]
    (S L : Subgroup G) (hS2 : IsPGroup 2 S) (hSL : S ≤ L) :
    let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
    let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
    let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
    let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
    C ≤ F ∧ C ⊓ Sbar = ⊥ ∧ ⁅C, Sbar⁆ = C := by
  classical
  dsimp only
  let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
  let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
  let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
  have hSint2 : IsPGroup 2 (S.subgroupOf L) :=
    hS2.of_equiv (Subgroup.subgroupOfEquivOfLe hSL).symm
  have hSbar2 : IsPGroup 2 Sbar := hSint2.map q
  have hO : pCore 2 (L ⧸ pCore 2 L) = ⊥ :=
    pCore_quotient_pCore_eq_bot L
  have hFodd : Odd (Nat.card F) := by
    simpa [F] using fitting_odd_of_pCore_eq_bot hO
  have hSFcop : Nat.Coprime (Nat.card Sbar) (Nat.card F) := by
    let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := 2)).mp hSbar2
    rw [hn]
    exact hFodd.coprime_two_left.pow_left n
  have hSnormalizesF : Sbar ≤ Subgroup.normalizer (F : Set _) :=
    Subgroup.le_normalizer_of_normal
  have hCF : C ≤ F := by
    exact (Subgroup.le_normalizer_iff_commutator_le_left).mp hSnormalizesF
  have hCSbot : C ⊓ Sbar = ⊥ := by
    rw [inf_comm]
    apply inf_eq_bot_of_isPGroup_two_of_odd_card Sbar C hSbar2
    exact Odd.of_dvd_nat hFodd (Subgroup.card_dvd_of_le hCF)
  have hFC : Group.IsSolvable F := by
    exact IsNilpotent.to_isSolvable
  have hCC : ⁅C, Sbar⁆ = C := by
    exact commutator_double_eq_self_of_coprime_solvable Sbar F
      hSnormalizesF hSFcop hFC
  exact ⟨hCF, hCSbot, hCC⟩

public theorem hktPResidual_le_ker_of_isPGroup
    {A : Type u} {B : Type v} [Group A] [Group B]
    [Finite A] [Finite B] (f : A →* B) (hB : IsPGroup 2 B) :
    hktPResidual 2 A ≤ f.ker := by
  have hrange2 : IsPGroup 2 f.range := hB.to_subgroup f.range
  have hquot2 : IsPGroup 2 (A ⧸ f.ker) :=
    hrange2.of_equiv (QuotientGroup.quotientKerEquivRange f).symm
  exact hktPResidual_le f.ker inferInstance hquot2

private theorem quotient_sup_isPGroup_of_right
    {G : Type u} [Group G] [Finite G]
    (C S : Subgroup G)
    [hN : (C.subgroupOf (C ⊔ S)).Normal]
    (hS2 : IsPGroup 2 S) :
    IsPGroup 2 (↑(C ⊔ S : Subgroup G) ⧸ C.subgroupOf (C ⊔ S)) := by
  classical
  let E : Subgroup G := C ⊔ S
  let N : Subgroup E := C.subgroupOf E
  let q : E →* E ⧸ N := QuotientGroup.mk' N
  let Sint : Subgroup E := S.subgroupOf E
  have hSint2 : IsPGroup 2 Sint :=
    hS2.of_equiv (Subgroup.subgroupOfEquivOfLe le_sup_right).symm
  have hsup : N ⊔ Sint = ⊤ := by
    rw [← Subgroup.subgroupOf_sup le_sup_left le_sup_right]
    exact Subgroup.subgroupOf_self E
  have hmapN : N.map q = ⊥ := by
    apply (Subgroup.map_eq_bot_iff (f := q) (H := N)).2
    simp [q, QuotientGroup.ker_mk']
  have hmapS : Sint.map q = ⊤ := by
    have hmapped := congrArg (fun K : Subgroup E ↦ K.map q) hsup
    rw [Subgroup.map_sup, hmapN] at hmapped
    have htop : (⊤ : Subgroup E).map q = ⊤ := by
      simpa [MonoidHom.range_eq_map] using
        (MonoidHom.range_eq_top.mpr
          (QuotientGroup.mk'_surjective N) : q.range = ⊤)
    simpa [htop] using hmapped
  have htop2 : IsPGroup 2 (⊤ : Subgroup (E ⧸ N)) := by
    rw [← hmapS]
    exact hSint2.map q
  exact htop2.of_equiv Subgroup.topEquiv

public theorem twoResidualAmbient_le_left_of_le_sup
    {G : Type u} [Group G] [Finite G]
    (D S P : Subgroup G)
    (hDnormal : (D.subgroupOf (D ⊔ S)).Normal)
    (hS2 : IsPGroup 2 S) (hP : P ≤ D ⊔ S) :
    twoResidualAmbient P ≤ D := by
  classical
  let _ : (D.subgroupOf (D ⊔ S)).Normal := hDnormal
  let q : ↑(D ⊔ S : Subgroup G) →*
      ↑(D ⊔ S : Subgroup G) ⧸ D.subgroupOf (D ⊔ S) :=
    QuotientGroup.mk' (D.subgroupOf (D ⊔ S))
  have hquot2 : IsPGroup 2
      (↑(D ⊔ S) ⧸ D.subgroupOf (D ⊔ S)) :=
    quotient_sup_isPGroup_of_right D S hS2
  let i : P →* ↑(D ⊔ S : Subgroup G) := Subgroup.inclusion hP
  let f := q.comp i
  have hRker : hktPResidual 2 P ≤ f.ker :=
    hktPResidual_le_ker_of_isPGroup f hquot2
  rw [twoResidualAmbient_eq_map_hktPResidual]
  rintro _ ⟨x, hx, rfl⟩
  have hfx : f x = 1 := MonoidHom.mem_ker.mp (hRker hx)
  have hxi : i x ∈ D.subgroupOf (D ⊔ S) :=
    (QuotientGroup.eq_one_iff (N := D.subgroupOf (D ⊔ S))
      (x := i x)).mp hfx
  exact hxi

private noncomputable def commutatorPreimage
    {G : Type u} [Group G] (S L : Subgroup G) : Subgroup G :=
  (⁅fittingSubgroup (L ⧸ pCore 2 L),
      (S.subgroupOf L).map (QuotientGroup.mk' (pCore 2 L))⁆.comap
        (QuotientGroup.mk' (pCore 2 L))).map L.subtype

private theorem commutator_preimage_sup_mem_LSet
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (L : Subgroup G) (hL : L ∈ LSet (⊤ : Subgroup G) S)
    (hCne :
      ⁅fittingSubgroup (L ⧸ pCore 2 L),
        (S.subgroupOf L).map (QuotientGroup.mk' (pCore 2 L))⁆ ≠ ⊥) :
    let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
    let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
    let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
    let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
    let D : Subgroup G := (C.comap q).map L.subtype
    D ⊔ S ∈ LSet (⊤ : Subgroup G) S := by
  classical
  dsimp only
  let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
  let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
  let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
  let D : Subgroup G := (C.comap q).map L.subtype
  let E : Subgroup G := D ⊔ S
  have hSL : S ≤ L := by
    obtain ⟨T, hT⟩ := hL.2.1
    rw [← hT]
    exact Subgroup.map_subtype_le (T : Subgroup L)
  obtain ⟨_hCF, hCSbot, hCC⟩ :=
    quotient_commutator_structure S L h.nontrivial_two_subgroup.2 hSL
  change C ⊓ Sbar = ⊥ at hCSbot
  change ⁅C, Sbar⁆ = C at hCC
  have hDL : D ≤ L := Subgroup.map_subtype_le (C.comap q)
  have hEL : E ≤ L := sup_le hDL hSL
  have hSE : S ≤ E := le_sup_right
  have hSylowE : IsSylowSubgroupIn S E :=
    isSylowSubgroupIn_of_between_local L S E hSE hEL hL.2.1
  have hcoreLD : twoCoreAmbient L ≤ D := by
    have hinter : pCore 2 L ≤ C.comap q := by
      intro x hx
      change q x ∈ C
      have hqx : q x = 1 := by
        exact (QuotientGroup.eq_one_iff (N := pCore 2 L) (x := x)).2 hx
      rw [hqx]
      exact C.one_mem
    exact Subgroup.map_mono hinter
  have hcoreLE : twoCoreAmbient L ≤ E := hcoreLD.trans le_sup_left
  have hcoreLEcore : twoCoreAmbient L ≤ twoCoreAmbient E :=
    twoCoreAmbient_mono_of_normal_local L E hEL hcoreLE
  have hcoreEne : twoCoreAmbient E ≠ ⊥ := by
    intro hbot
    apply hL.2.2.1
    exact le_antisymm (by simpa [hbot] using hcoreLEcore) bot_le
  have hSneCore : S ≠ twoCoreAmbient E := by
    intro hSeq
    have hcoreNormE : ((twoCoreAmbient E).subgroupOf E).Normal := by
      unfold twoCoreAmbient
      rw [subgroupOf_map_subtype_eq]
      infer_instance
    have hSnormE : (S.subgroupOf E).Normal := by
      rw [hSeq]
      exact hcoreNormE
    have hEbar : (E.subgroupOf L).map q = C ⊔ Sbar := by
      rw [show E.subgroupOf L = D.subgroupOf L ⊔ S.subgroupOf L by
        exact Subgroup.subgroupOf_sup hDL hSL,
        Subgroup.map_sup]
      have hDint : D.subgroupOf L = C.comap q := by
        apply Subgroup.map_injective L.subtype_injective
        rw [Subgroup.map_subgroupOf_eq_of_le hDL]
      rw [hDint, Subgroup.map_comap_eq_self_of_surjective
        (QuotientGroup.mk'_surjective (pCore 2 L))]
    have hSnormEbar : IsNormalInLocal Sbar (C ⊔ Sbar) := by
      refine ⟨le_sup_right, ?_⟩
      intro e he s hs
      rw [← hEbar] at he
      rcases (Subgroup.mem_map).1 he with ⟨e0, he0, rfl⟩
      rcases (Subgroup.mem_map).1 hs with ⟨s0, hs0, rfl⟩
      refine Subgroup.mem_map.mpr ⟨e0 * s0 * e0⁻¹, ?_, by simp⟩
      change ((e0 : L) : G) * ((s0 : L) : G) * ((e0 : L) : G)⁻¹ ∈ S
      exact (Subgroup.normal_subgroupOf_iff hSE).mp hSnormE
        (s0 : G) (e0 : G) hs0 he0
    have hSnormEbar' : (Sbar.subgroupOf (C ⊔ Sbar)).Normal := by
      rw [Subgroup.normal_subgroupOf_iff le_sup_right]
      intro s e hs he
      exact hSnormEbar.2 e he s hs
    have hCleNormS : C ≤ Subgroup.normalizer (Sbar : Set _) := by
      exact le_sup_left.trans
        ((Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_right).1
          hSnormEbar')
    have hCleS : C ≤ Sbar := by
      rw [← hCC, Subgroup.commutator_comm]
      exact (Subgroup.le_normalizer_iff_commutator_le_left).mp hCleNormS
    have hCbot : C = ⊥ := by
      apply le_antisymm
      · rw [← hCSbot]
        exact le_inf le_rfl hCleS
      · exact bot_le
    exact hCne hCbot
  exact ⟨le_top, hSylowE, hcoreEne, hSneCore⟩

private theorem pstar_mem_pSet_commutator_preimage_sup
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (L : Subgroup G) (hL : L ∈ LSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable L)
    (P : Subgroup G) (hP : P ∈ PStarSet L S) :
    let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
    let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
    let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
    let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
    let D : Subgroup G := (C.comap q).map L.subtype
    P ∈ PSet (D ⊔ S) S := by
  dsimp only
  let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
  let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
  let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
  let D : Subgroup G := (C.comap q).map L.subtype
  have hAL : twoResidualAmbient P ≤ L :=
    (pstar_residual_subnormal_in_L hL hP).1
  have hAimageC : twoResidualImageInQuotient L P ≤ C := by
    have hfit : twoResidualImageInQuotient L P ≤ F := by
      simpa [F] using residual_image_le_fitting_of_pstar
        S h L hL hsolv P hP
    have hPsolv : Group.IsSolvable P :=
      pset_solvable_of_solvable_overgroup hsolv hP.1
    have hcomm : ⁅twoResidualAmbient P, S⁆ = twoResidualAmbient P :=
      residual_commutator_eq_of_pSet S h P (pSet_top_of_pSet hP.1) hPsolv
    have hinternal :
        ⁅(twoResidualAmbient P).subgroupOf L, S.subgroupOf L⁆ =
          (twoResidualAmbient P).subgroupOf L := by
      apply Subgroup.map_injective L.subtype_injective
      rw [commutator_subgroupOf_map_eq L S (twoResidualAmbient P)
          (by
            obtain ⟨T, hT⟩ := hL.2.1
            rw [← hT]
            exact Subgroup.map_subtype_le (T : Subgroup L)) hAL,
        Subgroup.map_subgroupOf_eq_of_le hAL]
      exact hcomm
    have hmapped := congrArg (fun K : Subgroup L ↦ K.map q) hinternal
    rw [Subgroup.map_commutator] at hmapped
    change twoResidualImageInQuotient L P ≤ ⁅F, Sbar⁆
    calc
      twoResidualImageInQuotient L P =
          ⁅twoResidualImageInQuotient L P, Sbar⁆ := by
        simpa [twoResidualImageInQuotient, q, Sbar] using hmapped.symm
      _ ≤ ⁅F, Sbar⁆ := Subgroup.commutator_mono hfit le_rfl
  have hAD : twoResidualAmbient P ≤ D := by
    have hinter : (twoResidualAmbient P).subgroupOf L ≤ C.comap q := by
      rw [← Subgroup.map_le_iff_le_comap]
      exact hAimageC
    have hm := Subgroup.map_mono (f := L.subtype) hinter
    simpa [D, Subgroup.map_subgroupOf_eq_of_le hAL] using hm
  have hPE : P ≤ D ⊔ S := by
    rw [← twoResidual_sup_sylowImage hP.1.1.2.1]
    exact sup_le_sup hAD le_rfl
  exact ⟨⟨hPE, hP.1.1.2.1, hP.1.1.2.2.1, hP.1.1.2.2.2⟩, hP.1.2⟩

private theorem twoResidual_le_commutator_preimage_of_le
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (L : Subgroup G) (hL : L ∈ LSet (⊤ : Subgroup G) S)
    (P : Subgroup G)
    (hPE : P ≤ commutatorPreimage S L ⊔ S) :
    twoResidualAmbient P ≤ commutatorPreimage S L := by
  classical
  let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
  let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
  let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
  let D : Subgroup G := (C.comap q).map L.subtype
  let E : Subgroup G := D ⊔ S
  change P ≤ D ⊔ S at hPE
  change twoResidualAmbient P ≤ D
  have hSL : S ≤ L := by
    obtain ⟨T, hT⟩ := hL.2.1
    rw [← hT]
    exact Subgroup.map_subtype_le (T : Subgroup L)
  have hSnormalizesC : Sbar ≤ Subgroup.normalizer (C : Set _) := by
    exact Subgroup.normalizer_commutator_ge_right F Sbar
  have hSnormD : S ≤ Subgroup.normalizer (D : Set G) := by
    calc
      S = (S.subgroupOf L).map L.subtype :=
        (Subgroup.map_subgroupOf_eq_of_le hSL).symm
      _ ≤ (Subgroup.normalizer (C.comap q : Set L)).map L.subtype := by
        apply Subgroup.map_mono
        exact (show S.subgroupOf L ≤ (Subgroup.normalizer C).comap q by
          rw [← Subgroup.map_le_iff_le_comap]
          exact hSnormalizesC).trans (Subgroup.le_normalizer_comap q)
      _ ≤ Subgroup.normalizer (D : Set G) :=
        Subgroup.le_normalizer_map (H := C.comap q) L.subtype
  have hDnormal : (D.subgroupOf E).Normal := by
    rw [Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_left]
    exact sup_le Subgroup.le_normalizer hSnormD
  exact twoResidualAmbient_le_left_of_le_sup D S P hDnormal
    h.nontrivial_two_subgroup.2 hPE

private theorem pSet_commutator_preimage_sup_mem_pstar
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (L : Subgroup G) (hL : L ∈ LSet (⊤ : Subgroup G) S)
    (P : Subgroup G) (hP : P ∈ PSet (commutatorPreimage S L ⊔ S) S) :
    P ∈ PStarSet L S := by
  classical
  let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
  let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
  let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
  let D : Subgroup G := (C.comap q).map L.subtype
  let E : Subgroup G := D ⊔ S
  change P ∈ PSet E S at hP
  have hSL : S ≤ L := by
    obtain ⟨T, hT⟩ := hL.2.1
    rw [← hT]
    exact Subgroup.map_subtype_le (T : Subgroup L)
  have hDL : D ≤ L := Subgroup.map_subtype_le (C.comap q)
  have hEL : E ≤ L := sup_le hDL hSL
  have hPL : P ≤ L := hP.1.1.trans hEL
  have hSP : S ≤ P := by
    obtain ⟨T, hT⟩ := hP.1.2.1
    rw [← hT]
    exact Subgroup.map_subtype_le (T : Subgroup P)
  let A : Subgroup G := twoResidualAmbient P
  have hAP : A ≤ P := Subgroup.map_subtype_le (twoResidualSubgroup P)
  have hAL : A ≤ L := hAP.trans hPL
  have hAD : A ≤ D := by
    exact twoResidual_le_commutator_preimage_of_le S h L hL P hP.1.1
  let Aint : Subgroup L := A.subgroupOf L
  let Abar : Subgroup (L ⧸ pCore 2 L) := Aint.map q
  have hAbarC : Abar ≤ C := by
    rw [Subgroup.map_le_iff_le_comap]
    apply Subgroup.map_subtype_le_map_subtype.mp
    rw [Subgroup.map_subgroupOf_eq_of_le hAL]
    exact hAD
  obtain ⟨hCF, _hCSbot, _hCC⟩ :=
    quotient_commutator_structure S L h.nontrivial_two_subgroup.2 hSL
  change C ≤ F at hCF
  have hAbarF : Abar ≤ F := hAbarC.trans hCF
  have hAbarSubF : (Abar.subgroupOf F).IsSubnormal := by
    exact isSubnormal_of_isNilpotent_local
      (show Group.IsNilpotent F by infer_instance) (Abar.subgroupOf F)
  have hAbarSub : Abar.IsSubnormal :=
    Subgroup.IsSubnormal.trans hAbarF hAbarSubF
      (inferInstance : F.Normal).isSubnormal
  let K : Subgroup L := Abar.comap q
  have hKsub : K.IsSubnormal := hAbarSub.comap q
  have hAK : Aint ≤ K := by
    change Aint ≤ (Aint.map q).comap q
    rw [Subgroup.comap_map_eq]
    exact le_sup_left
  have hcoreLS : twoCoreAmbient L ≤ S :=
    twoCoreAmbient_le_sylowImage hL.2.1
  have hcoreLP : twoCoreAmbient L ≤ P := hcoreLS.trans hSP
  have hcoreIntP : pCore 2 L ≤ P.subgroupOf L := by
    apply Subgroup.map_subtype_le_map_subtype.mp
    rw [Subgroup.map_subgroupOf_eq_of_le hPL]
    exact hcoreLP
  have hAintP : Aint ≤ P.subgroupOf L :=
    Subgroup.subgroupOf_mono L hAP
  have hKleP : K ≤ P.subgroupOf L := by
    change (Aint.map q).comap q ≤ P.subgroupOf L
    rw [Subgroup.comap_map_eq]
    simpa [q, QuotientGroup.ker_mk'] using
      (sup_le hAintP hcoreIntP)
  have hAnormP : (A.subgroupOf P).Normal := by
    have hRnormal : (hktPResidual 2 P).Normal := hktPResidual_normal
    rw [show A = (hktPResidual 2 P).map P.subtype by
      exact twoResidualAmbient_eq_map_hktPResidual P,
      subgroupOf_map_subtype_eq]
    exact hRnormal
  have hAnormPint : (Aint.subgroupOf (P.subgroupOf L)).Normal := by
    exact normal_subgroupOf_subgroupOf_local hAP hPL hAnormP
  have hAnormK : (Aint.subgroupOf K).Normal := by
    rw [Subgroup.normal_subgroupOf_iff hAK]
    intro a k ha hk
    exact (Subgroup.normal_subgroupOf_iff hAintP).mp hAnormPint
      a k ha (hKleP hk)
  have hAsub : Aint.IsSubnormal :=
    Subgroup.IsSubnormal.step Aint K hAK hKsub hAnormK
  have hLlocal : L ∈ LSet L S :=
    ⟨le_rfl, hL.2.1, hL.2.2.1, hL.2.2.2⟩
  have hLmax : L ∈ maxLSet L S := by
    refine ⟨hLlocal, ?_⟩
    intro L' hL' hLL'
    exact le_antisymm hL'.1 hLL'
  exact ⟨⟨⟨hPL, hP.1.2.1, hP.1.2.2.1, hP.1.2.2.2⟩, hP.2⟩,
    L, hLmax, hAL, hAsub⟩

private theorem twoPrimeResidualSubgroup_characteristic_local
    {G : Type u} [Group G] [Finite G] (U : Subgroup G) :
    (twoPrimeResidualSubgroup U).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro e
  unfold twoPrimeResidualSubgroup
  rw [Subgroup.map_iSup]
  apply le_antisymm
  · exact iSup_le fun P ↦
      le_iSup (fun Q : Sylow 2 U ↦ (Q : Subgroup U))
        (P.mapSurjective e.surjective)
  · refine iSup_le fun Q ↦ ?_
    obtain ⟨P, hP⟩ := Sylow.mapSurjective_surjective
      (f := e.toMonoidHom) e.surjective 2 Q
    rw [← hP]
    exact le_iSup (fun R : Sylow 2 U ↦
      (R : Subgroup U).map e.toMonoidHom) P

private theorem twoPrimeResidualSubgroup_normal_local
    {G : Type u} [Group G] [Finite G] (U : Subgroup G) :
    (twoPrimeResidualSubgroup U).Normal := by
  let _ : (twoPrimeResidualSubgroup U).Characteristic :=
    twoPrimeResidualSubgroup_characteristic_local U
  exact Subgroup.normal_of_characteristic _

private theorem sylowImage_le_twoPrimeResidualAmbient
    {G : Type u} [Group G]
    (S U : Subgroup G) (hSylow : IsSylowSubgroupIn S U) :
    S ≤ twoPrimeResidualAmbient U := by
  obtain ⟨T, hT⟩ := hSylow
  rw [← hT]
  unfold twoPrimeResidualAmbient twoPrimeResidualSubgroup
  exact Subgroup.map_mono
    (le_iSup (fun R : Sylow 2 U ↦ (R : Subgroup U)) T)

private theorem twoPrimeResidual_commutator_preimage_sup_eq
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (L : Subgroup G) (hL : L ∈ LSet (⊤ : Subgroup G) S) :
    twoPrimeResidualAmbient (commutatorPreimage S L ⊔ S) =
      commutatorPreimage S L ⊔ S := by
  classical
  let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
  let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
  let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
  let D : Subgroup G := (C.comap q).map L.subtype
  let E : Subgroup G := D ⊔ S
  let J : Subgroup G := twoPrimeResidualAmbient E
  change J = E
  have hSL : S ≤ L := by
    obtain ⟨T, hT⟩ := hL.2.1
    rw [← hT]
    exact Subgroup.map_subtype_le (T : Subgroup L)
  have hDL : D ≤ L := Subgroup.map_subtype_le (C.comap q)
  have hEL : E ≤ L := sup_le hDL hSL
  have hJE : J ≤ E := Subgroup.map_subtype_le (twoPrimeResidualSubgroup E)
  have hSylowE : IsSylowSubgroupIn S E :=
    isSylowSubgroupIn_of_between_local L S E le_sup_right hEL hL.2.1
  have hSJ : S ≤ J := sylowImage_le_twoPrimeResidualAmbient S E hSylowE
  have hJnormalE : (J.subgroupOf E).Normal := by
    unfold J twoPrimeResidualAmbient
    rw [subgroupOf_map_subtype_eq]
    exact twoPrimeResidualSubgroup_normal_local E
  have hEnormJ : E ≤ Subgroup.normalizer (J : Set G) :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hJE).mp hJnormalE
  have hcommJE : ⁅J, E⁆ ≤ J :=
    (Subgroup.le_normalizer_iff_commutator_le_left).mp hEnormJ
  have hcommDS : ⁅D, S⁆ ≤ J := by
    rw [Subgroup.commutator_comm]
    exact (Subgroup.commutator_mono hSJ le_sup_left).trans hcommJE
  have hDint : D.subgroupOf L = C.comap q := by
    apply Subgroup.map_injective L.subtype_injective
    rw [Subgroup.map_subgroupOf_eq_of_le hDL]
  have hDmap : (D.subgroupOf L).map q = C := by
    rw [hDint, Subgroup.map_comap_eq_self_of_surjective
      (QuotientGroup.mk'_surjective (pCore 2 L))]
  have hJL : J ≤ L := hJE.trans hEL
  have hcommInt : ⁅D.subgroupOf L, S.subgroupOf L⁆ ≤ J.subgroupOf L := by
    apply Subgroup.map_subtype_le_map_subtype.mp
    rw [commutator_subgroupOf_map_eq L S D hSL hDL,
      Subgroup.map_subgroupOf_eq_of_le hJL]
    exact hcommDS
  obtain ⟨_hCF, _hCSbot, hCC⟩ :=
    quotient_commutator_structure S L h.nontrivial_two_subgroup.2 hSL
  change ⁅C, Sbar⁆ = C at hCC
  have hmapped := Subgroup.map_mono (f := q) hcommInt
  rw [Subgroup.map_commutator, hDmap, hCC] at hmapped
  have hDleJint : D.subgroupOf L ≤ J.subgroupOf L := by
    have hmaple : (D.subgroupOf L).map q ≤ (J.subgroupOf L).map q := by
      rwa [hDmap]
    have hpre : D.subgroupOf L ≤ ((J.subgroupOf L).map q).comap q := by
      rwa [← Subgroup.map_le_iff_le_comap]
    rw [Subgroup.comap_map_eq] at hpre
    have hcoreJ : pCore 2 L ≤ J.subgroupOf L := by
      apply Subgroup.map_subtype_le_map_subtype.mp
      rw [Subgroup.map_subgroupOf_eq_of_le hJL]
      exact (twoCoreAmbient_le_sylowImage hL.2.1).trans hSJ
    simpa [q, QuotientGroup.ker_mk', sup_eq_left.mpr hcoreJ] using hpre
  have hDJ : D ≤ J := by
    have hm := Subgroup.map_mono (f := L.subtype) hDleJint
    simpa [Subgroup.map_subgroupOf_eq_of_le hDL,
      Subgroup.map_subgroupOf_eq_of_le hJL] using hm
  exact le_antisymm hJE (sup_le hDJ hSJ)

private theorem rhs_le_lhs
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (L : Subgroup G) (hL : L ∈ LSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable L) :
    (⨆ P : {P : Subgroup G // P ∈ PStarSet L S},
        twoResidualImageInQuotient L P) ≤
      ⁅fittingSubgroup (L ⧸ pCore 2 L),
        (S.subgroupOf L).map (QuotientGroup.mk' (pCore 2 L))⁆ := by
  let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
  let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
  have hSL : S ≤ L := by
    obtain ⟨T, hT⟩ := hL.2.1
    rw [← hT]
    exact Subgroup.map_subtype_le (T : Subgroup L)
  refine iSup_le fun P => ?_
  let A : Subgroup G := twoResidualAmbient P
  have hAL : A ≤ L :=
    (pstar_residual_subnormal_in_L hL P.property).1
  have hfit : twoResidualImageInQuotient L P ≤ F := by
    simpa [F] using
      residual_image_le_fitting_of_pstar S h L hL hsolv P P.property
  have hPsolv : Group.IsSolvable P :=
    pset_solvable_of_solvable_overgroup hsolv P.property.1
  have hcomm : ⁅A, S⁆ = A := by
    exact residual_commutator_eq_of_pSet S h P
      (pSet_top_of_pSet P.property.1) hPsolv
  have hinternal : ⁅A.subgroupOf L, S.subgroupOf L⁆ = A.subgroupOf L := by
    apply (Subgroup.map_injective L.subtype_injective)
    rw [commutator_subgroupOf_map_eq L S A hSL hAL,
      Subgroup.map_subgroupOf_eq_of_le hAL]
    exact hcomm
  have hmapped := congrArg (fun K : Subgroup L => K.map q) hinternal
  rw [Subgroup.map_commutator] at hmapped
  change twoResidualImageInQuotient L P ≤ ⁅F, Sbar⁆
  calc
    twoResidualImageInQuotient L P =
        ⁅twoResidualImageInQuotient L P, Sbar⁆ := by
      simpa [twoResidualImageInQuotient, q, Sbar, A] using hmapped.symm
    _ ≤ ⁅F, Sbar⁆ := Subgroup.commutator_mono hfit le_rfl

public theorem lemma_three_seven
    {G : Type u} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (L : Subgroup G) (hL : L ∈ LSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable L) :
    ⁅fittingSubgroup (L ⧸ pCore 2 L),
        (S.subgroupOf L).map (QuotientGroup.mk' (pCore 2 L))⁆ =
      ⨆ P : {P : Subgroup G // P ∈ PStarSet L S},
        twoResidualImageInQuotient L P := by
  classical
  let q : L →* L ⧸ pCore 2 L := QuotientGroup.mk' (pCore 2 L)
  let Sbar : Subgroup (L ⧸ pCore 2 L) := (S.subgroupOf L).map q
  let F : Subgroup (L ⧸ pCore 2 L) := fittingSubgroup (L ⧸ pCore 2 L)
  let C : Subgroup (L ⧸ pCore 2 L) := ⁅F, Sbar⁆
  let R : Subgroup (L ⧸ pCore 2 L) :=
    ⨆ P : {P : Subgroup G // P ∈ PStarSet L S},
      twoResidualImageInQuotient L P
  change C = R
  have hSL : S ≤ L := by
    obtain ⟨T, hT⟩ := hL.2.1
    rw [← hT]
    exact Subgroup.map_subtype_le (T : Subgroup L)
  have hRC : R ≤ C := by
    simpa [R, C, F, Sbar, q] using rhs_le_lhs S h L hL hsolv
  by_cases hC : C = ⊥
  · exact le_antisymm (by rw [hC]; exact bot_le) (by simpa [hC] using hRC)
  let D : Subgroup G := (C.comap q).map L.subtype
  let E : Subgroup G := D ⊔ S
  have hEset : E ∈ LSet (⊤ : Subgroup G) S := by
    have hE := commutator_preimage_sup_mem_LSet S h L hL (by
      simpa [C, F, Sbar, q] using hC)
    change E ∈ LSet (⊤ : Subgroup G) S at hE
    exact hE
  have hFamily : ∀ P : Subgroup G,
      P ∈ PSet E S ↔ P ∈ PStarSet L S := by
    intro P
    constructor
    · intro hP
      apply pSet_commutator_preimage_sup_mem_pstar S h L hL P
      change P ∈ PSet E S
      exact hP
    · intro hP
      have hP' := pstar_mem_pSet_commutator_preimage_sup
        S h L hL hsolv P hP
      change P ∈ PSet E S at hP'
      exact hP'
  have hJoin :
      (⨆ P : {P : Subgroup G // P ∈ PSet E S}, (P : Subgroup G)) =
        ⨆ P : {P : Subgroup G // P ∈ PStarSet L S},
          (P : Subgroup G) := by
    apply le_antisymm
    · refine iSup_le fun P ↦ ?_
      exact le_iSup
        (fun Q : {Q : Subgroup G // Q ∈ PStarSet L S} ↦
          (Q : Subgroup G)) ⟨P, (hFamily P).mp P.property⟩
    · refine iSup_le fun P ↦ ?_
      exact le_iSup
        (fun Q : {Q : Subgroup G // Q ∈ PSet E S} ↦
          (Q : Subgroup G)) ⟨P, (hFamily P).mpr P.property⟩
  have hEjoin : E =
      ⨆ P : {P : Subgroup G // P ∈ PStarSet L S},
        (P : Subgroup G) := by
    calc
      E = twoPrimeResidualAmbient E :=
        (twoPrimeResidual_commutator_preimage_sup_eq S h L hL).symm
      _ = ⨆ P : {P : Subgroup G // P ∈ PSet E S},
          (P : Subgroup G) := lemma_three_two S h E hEset
      _ = _ := hJoin
  let Idx := {P : Subgroup G // P ∈ PStarSet L S}
  have hIdx : Nonempty Idx := by
    by_contra hn
    let _ : IsEmpty Idx := ⟨fun x ↦ hn ⟨x⟩⟩
    have hEbot : E = ⊥ := by
      simpa [Idx, iSup_of_empty] using hEjoin
    apply h.nontrivial_two_subgroup.1
    apply le_antisymm
    · exact (le_sup_right : S ≤ E).trans_eq hEbot
    · exact bot_le
  let _ : Nonempty Idx := hIdx
  have hDL : D ≤ L := Subgroup.map_subtype_le (C.comap q)
  have hEL : E ≤ L := sup_le hDL hSL
  have hEmap : (E.subgroupOf L).map q = C ⊔ Sbar := by
    rw [show E.subgroupOf L = D.subgroupOf L ⊔ S.subgroupOf L by
      exact Subgroup.subgroupOf_sup hDL hSL,
      Subgroup.map_sup]
    have hDint : D.subgroupOf L = C.comap q := by
      apply Subgroup.map_injective L.subtype_injective
      rw [Subgroup.map_subgroupOf_eq_of_le hDL]
    rw [hDint, Subgroup.map_comap_eq_self_of_surjective
      (QuotientGroup.mk'_surjective (pCore 2 L))]
  let J : Subgroup G := ⨆ P : Idx, (P : Subgroup G)
  have hJL : J ≤ L := by
    refine iSup_le fun P ↦ ?_
    exact P.property.1.1.1
  have hEJ : E = J := by simpa [J, Idx] using hEjoin
  have hJint : J.subgroupOf L = ⨆ P : Idx, P.val.subgroupOf L := by
    apply Subgroup.map_injective L.subtype_injective
    rw [Subgroup.map_subgroupOf_eq_of_le hJL, Subgroup.map_iSup]
    change J = ⨆ P : Idx, (P.val.subgroupOf L).map L.subtype
    apply le_antisymm
    · refine iSup_le fun P ↦ ?_
      calc
        (P : Subgroup G) = (P.val.subgroupOf L).map L.subtype :=
          (Subgroup.map_subgroupOf_eq_of_le P.property.1.1.1).symm
        _ ≤ ⨆ Q : Idx, (Q.val.subgroupOf L).map L.subtype :=
          le_iSup (fun Q : Idx ↦ (Q.val.subgroupOf L).map L.subtype) P
    · refine iSup_le fun P ↦ ?_
      calc
        (P.val.subgroupOf L).map L.subtype = (P : Subgroup G) :=
          Subgroup.map_subgroupOf_eq_of_le P.property.1.1.1
        _ ≤ ⨆ Q : Idx, (Q : Subgroup G) :=
          le_iSup (fun Q : Idx ↦ (Q : Subgroup G)) P
  have hPmap : ∀ P : Idx,
      (P.val.subgroupOf L).map q =
        twoResidualImageInQuotient L P ⊔ Sbar := by
    intro P
    have hPL : P.val ≤ L := P.property.1.1.1
    have hAL : twoResidualAmbient P.val ≤ L :=
      (Subgroup.map_subtype_le (twoResidualSubgroup P.val)).trans hPL
    have hPint : P.val.subgroupOf L =
        (twoResidualAmbient P.val).subgroupOf L ⊔ S.subgroupOf L := by
      apply Subgroup.map_injective L.subtype_injective
      rw [Subgroup.map_subgroupOf_eq_of_le hPL, Subgroup.map_sup,
        Subgroup.map_subgroupOf_eq_of_le hAL,
        Subgroup.map_subgroupOf_eq_of_le hSL]
      exact (twoResidual_sup_sylowImage P.property.1.1.2.1).symm
    rw [hPint, Subgroup.map_sup]
    rfl
  have hJmap : (J.subgroupOf L).map q = R ⊔ Sbar := by
    rw [hJint, Subgroup.map_iSup]
    simp_rw [hPmap]
    rw [iSup_sup]
  have hInternal : E.subgroupOf L = J.subgroupOf L := by
    apply Subgroup.map_injective L.subtype_injective
    rw [Subgroup.map_subgroupOf_eq_of_le hEL,
      Subgroup.map_subgroupOf_eq_of_le hJL, hEJ]
  have hSupEq : C ⊔ Sbar = R ⊔ Sbar := by
    have hmapped := congrArg (fun K : Subgroup L ↦ K.map q) hInternal
    rwa [hEmap, hJmap] at hmapped
  obtain ⟨_hCF, hCSbot, _hCC⟩ :=
    quotient_commutator_structure S L h.nontrivial_two_subgroup.2 hSL
  change C ⊓ Sbar = ⊥ at hCSbot
  have hSnormR : Sbar ≤ Subgroup.normalizer (R : Set _) := by
    apply (Subgroup.iInf_normalizer_le_normalizer_iSup
      (fun P : Idx ↦ twoResidualImageInQuotient L P)).trans'
    refine le_iInf fun P ↦ ?_
    let A : Subgroup G := twoResidualAmbient P.val
    have hAP : A ≤ P.val := Subgroup.map_subtype_le (twoResidualSubgroup P.val)
    have hPL : P.val ≤ L := P.property.1.1.1
    have hAL : A ≤ L := hAP.trans hPL
    have hSP : S ≤ P.val := by
      obtain ⟨T, hT⟩ := P.property.1.1.2.1
      calc
        S = (T : Subgroup P.val).map P.val.subtype := hT.symm
        _ ≤ P.val := Subgroup.map_subtype_le (T : Subgroup P.val)
    have hAnormP : (A.subgroupOf P.val).Normal := by
      rw [show A = (hktPResidual 2 P.val).map P.val.subtype by
        exact twoResidualAmbient_eq_map_hktPResidual P.val,
        subgroupOf_map_subtype_eq]
      exact hktPResidual_normal
    have hSnormA : S ≤ Subgroup.normalizer (A : Set G) :=
      hSP.trans ((Subgroup.normal_subgroupOf_iff_le_normalizer hAP).mp hAnormP)
    calc
      Sbar = (S.subgroupOf L).map q := rfl
      _ ≤ (Subgroup.normalizer (A.subgroupOf L : Set L)).map q := by
        apply Subgroup.map_mono
        exact (show S.subgroupOf L ≤ (Subgroup.normalizer A).comap L.subtype by
          intro s hs
          exact hSnormA hs).trans (Subgroup.le_normalizer_comap L.subtype)
      _ ≤ Subgroup.normalizer
          ((A.subgroupOf L).map q : Set (L ⧸ pCore 2 L)) :=
        Subgroup.le_normalizer_map (H := A.subgroupOf L) q
  have hRnormal : (R.subgroupOf (R ⊔ Sbar)).Normal := by
    rw [Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_left]
    exact sup_le Subgroup.le_normalizer hSnormR
  apply le_antisymm
  · intro c hc
    have hcSup : c ∈ R ⊔ Sbar := by
      rw [← hSupEq]
      exact (le_sup_left : C ≤ C ⊔ Sbar) hc
    let U : Subgroup (L ⧸ pCore 2 L) := R ⊔ Sbar
    let Rint : Subgroup U := R.subgroupOf U
    let Sint : Subgroup U := Sbar.subgroupOf U
    let _ : Rint.Normal := hRnormal
    have hIntSup : Rint ⊔ Sint = ⊤ := by
      rw [← Subgroup.subgroupOf_sup le_sup_left le_sup_right]
      exact Subgroup.subgroupOf_self U
    let x : U := ⟨c, hcSup⟩
    have hx : x ∈ Rint ⊔ Sint := by rw [hIntSup]; trivial
    rcases Subgroup.mem_sup_of_normal_left.mp hx with ⟨r, hr, s, hs, hrs⟩
    have hrsQ : (r : L ⧸ pCore 2 L) * (s : L ⧸ pCore 2 L) = c := by
      exact congrArg Subtype.val hrs
    have hsC : (s : L ⧸ pCore 2 L) ∈ C := by
      have hrC : (r : L ⧸ pCore 2 L) ∈ C := hRC hr
      have hseq : (s : L ⧸ pCore 2 L) =
          (r : L ⧸ pCore 2 L)⁻¹ * c := by
        rw [← hrsQ]
        group
      rw [hseq]
      exact C.mul_mem (C.inv_mem hrC) hc
    have hsbot : (s : L ⧸ pCore 2 L) ∈ (⊥ : Subgroup (L ⧸ pCore 2 L)) := by
      rw [← hCSbot]
      exact ⟨hsC, hs⟩
    have hsone : (s : L ⧸ pCore 2 L) = 1 := by simpa using hsbot
    have hcr : c = (r : L ⧸ pCore 2 L) := by
      rw [← hrsQ, hsone, mul_one]
    rw [hcr]
    exact hr
  · exact hRC


end Stellmacher.SectionThree
