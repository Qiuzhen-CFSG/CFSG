module

public import Stellmacher.SectionsOneToFourDefs
public import Theory.GroupTheory.SpecificGroups.CyclicInvertedDihedral

/-!
# The direct product in the generated dihedral image

An elementary abelian actor generated by a reflection and a subgroup `C`
centralizing an odd cyclic rotation group yields a direct product. The
rotation group together with the reflection is dihedral. Its center is
trivial because the rotation order is odd and greater than one. Since `C`
centralizes this entire dihedral factor, their intersection is trivial.

This is the image-level product in Stellmacher (3.6)(a), Journal of Algebra
190 (1997), p. 22. The barred group there is an image in `P/O₂(P)`; its
central actor factor is retained here.
-/

open scoped Pointwise IsMulCommutative

namespace Stellmacher.SectionThree

public theorem elementary_actor_dihedral_product
    {G : Type*} [Group G] [Finite G]
    (R A C : Subgroup G) (hRcyclic : IsCyclic R)
    (hRodd : Odd (Nat.card R)) (hRnontrivial : Nat.card R ≠ 1)
    (hA : IsElementaryAbelian 2 A) (hCA : C ≤ A)
    (a : G) (haA : a ∈ A) (ha : IsInvolution a)
    (hfactor : (A : Set G) = (Subgroup.zpowers a : Set G) * (C : Set G))
    (hinv : ∀ r : G, r ∈ R → a * r * a⁻¹ = r⁻¹)
    (hcentral : ∀ c : G, c ∈ C → ∀ r : G, r ∈ R → c * r = r * c) :
    let E := R ⊔ Subgroup.zpowers a
    Nonempty (E ≃* DihedralGroup (Nat.card R)) ∧
      IsInternalDirectProductFamily (R ⊔ A)
        (fun i : Bool => if i then E else C) := by
  classical
  let E := R ⊔ Subgroup.zpowers a
  have hanotR : a ∉ R := by
    intro haR
    have hdvd : orderOf (⟨a, haR⟩ : R) ∣ Nat.card R := orderOf_dvd_natCard _
    have horder : orderOf a = 2 := orderOf_eq_prime ha.2 ha.1
    apply hRodd.not_two_dvd_nat
    simpa [Subgroup.orderOf_mk, horder] using hdvd
  obtain ⟨e⟩ := R.nonempty_mulEquiv_dihedralGroup_of_cyclic_inverted
    a hRcyclic ha.2 hanotR hinv
  have hAcomm (x y : G) (hx : x ∈ A) (hy : y ∈ A) : x * y = y * x := by
    let _ : IsElementaryAbelian 2 A := hA
    exact congrArg Subtype.val (mul_comm (⟨x, hx⟩ : A) ⟨y, hy⟩)
  have hEcent : E ≤ Subgroup.centralizer (C : Set G) := by
    apply sup_le
    · intro r hr
      exact Subgroup.mem_centralizer_iff.mpr (fun c hc => hcentral c hc r hr)
    · apply Subgroup.zpowers_le.mpr
      exact Subgroup.mem_centralizer_iff.mpr (fun c hc => hAcomm c a (hCA hc) haA)
  have hECdisjoint : Disjoint E C := by
    rw [Subgroup.disjoint_def]
    intro x hxE hxC
    have hxcent : e ⟨x, hxE⟩ ∈ Subgroup.center (DihedralGroup (Nat.card R)) := by
      rw [Subgroup.mem_center_iff]
      intro y
      obtain ⟨yE, rfl⟩ := e.surjective y
      have hxy : (yE : G) * x = x * yE :=
        (Subgroup.mem_centralizer_iff.mp (hEcent yE.property) x hxC).symm
      have heq : yE * (⟨x, hxE⟩ : E) = (⟨x, hxE⟩ : E) * yE :=
        Subtype.ext hxy
      simpa only [map_mul] using congrArg e heq
    rw [DihedralGroup.center_eq_bot_of_odd_ne_one hRodd hRnontrivial] at hxcent
    have he1 : e ⟨x, hxE⟩ = 1 := hxcent
    have hx1 : (⟨x, hxE⟩ : E) = 1 := e.injective (he1.trans e.map_one.symm)
    exact congrArg Subtype.val hx1
  have hAsup : A = Subgroup.zpowers a ⊔ C := by
    apply le_antisymm
    · intro x hx
      have hxprod : x ∈ (Subgroup.zpowers a : Set G) * (C : Set G) :=
        hfactor ▸ hx
      obtain ⟨y, hy, z, hz, rfl⟩ := hxprod
      exact (Subgroup.zpowers a ⊔ C).mul_mem
        ((le_sup_left : Subgroup.zpowers a ≤ Subgroup.zpowers a ⊔ C) hy)
        ((le_sup_right : C ≤ Subgroup.zpowers a ⊔ C) hz)
    · exact sup_le (Subgroup.zpowers_le.mpr haA) hCA
  refine ⟨⟨e⟩, ?_, ?_, ?_⟩
  · simp only [iSup_bool_eq, Bool.false_eq_true, ite_false, ite_true]
    rw [hAsup]
    change R ⊔ (Subgroup.zpowers a ⊔ C) = (R ⊔ Subgroup.zpowers a) ⊔ C
    ac_rfl
  · intro i j hij
    cases i <;> cases j
    · exact (hij rfl).elim
    · exact hECdisjoint.symm
    · exact hECdisjoint
    · exact (hij rfl).elim
  · intro i j hij x hx y hy
    cases i <;> cases j
    · exact (hij rfl).elim
    · exact Subgroup.mem_centralizer_iff.mp (hEcent hy) x hx
    · exact (Subgroup.mem_centralizer_iff.mp (hEcent hx) y hy).symm
    · exact (hij rfl).elim

end Stellmacher.SectionThree

