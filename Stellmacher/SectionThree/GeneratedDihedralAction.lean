module

public import Stellmacher.SectionThree.GeneratedDihedralAction.Image
public import Stellmacher.SectionThree.GeneratedDihedralAction.Orbit
public import Stellmacher.SectionThree.GeneratedDihedralAction.Conjugator
public import Stellmacher.SectionThree.GeneratedDihedralAction.ActorCore
public import Stellmacher.SectionThree.GeneratedDihedralAction.Generation
public import Stellmacher.SectionThree.GeneratedDihedralAction.SylowGeneration

/-!
# A valid quotient-action version of Stellmacher (3.6)

For the full hypotheses of Stellmacher (3.6), the subgroup generated by
two conjugates of the actor has a dihedral-times-central-actor image in
`P/O₂(P)`. Its residual lies outside the specified Frattini preimage and
inside its commutator with `T`. Two conjugates of `Z` are swapped by an
element whose image in this quotient is an involution.

Primitive extraction supplies the cyclic odd rotation and residual clauses.
The actor's Frattini hypothesis makes its quotient image elementary abelian,
so the image-product theorem applies. The normal residual image and the
containment of `O₂(P)` in the given Sylow subgroup provide the inputs for
the subgroup-orbit quotient-reflection theorem.

Source: Journal of Algebra 190 (1997), (3.6), p. 22. This separate theorem
retains all original hypotheses and makes the involution assertion in the
quotient. It does not assert the false general lifting statement that the
interchanging element itself has order two, and it leaves the original
numbered public declaration untouched. A second theorem assumes explicitly
that the actor subgroup has exponent two. The orbit construction then uses
conjugates of the chosen nonidentity actor, giving actual involutions. This
specialization covers the elementary-actor applications without asserting
the extra premise in the unrestricted result.
-/

open scoped Pointwise

namespace Stellmacher.SectionThree

private theorem core_le_of_mem_PSet
    {G : Type*} [Group G] [Finite G]
    {S P : Subgroup G} (hP : P ∈ PSet (⊤ : Subgroup G) S) :
    twoCoreAmbient P ≤ S := by
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨SP, hSP⟩ := hP.1.2.1
  rw [← hSP]
  exact Subgroup.map_mono (pCore_isPGroup.le_sylow_of_normal SP)

public theorem generated_dihedral_action_variant
    {G : Type*} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (P : Subgroup G) (hP : P ∈ PSet (⊤ : Subgroup G) S)
    (Z T : Subgroup G)
    (hZ : Z ≤ S ∧ (Z.subgroupOf S).Normal)
    (hT : T ≤ S ∧ (T.subgroupOf S).Normal)
    (A : Subgroup G) (hA : A ≤ S)
    (a : G) (haA : a ∈ A) (haCore : a ∉ twoCoreAmbient P)
    (hPhi : frattiniAmbient A ≤ twoCoreAmbient P)
    (hsolv : Group.IsSolvable P)
    (hZcore : Z ≤ twoCoreAmbient P)
    (hTcore : ¬ T ≤ twoCoreAmbient P) :
    ∃ x : P, ∃ L A₀ : Subgroup G,
      L = A ⊔ A.conjBy (x : G) ∧ A₀ ≤ A ∧
      (A : Set G) = (Subgroup.zpowers a : Set G) * (A₀ : Set G) ∧
      ∃ hLP : L ≤ P, ∃ p n : ℕ, Nat.Prime p ∧ Odd p ∧ 0 < n ∧
        ∃ Ebar Abar : Subgroup (P ⧸ pCore 2 P),
          Nonempty (Ebar ≃* DihedralGroup (p ^ n)) ∧
          Abar = (A₀.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)) ∧
          IsInternalDirectProductFamily
            ((L.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)))
            (fun i : Bool => if i then Ebar else Abar) ∧
          ¬ twoResidualAmbient L ≤ phiTwo (twoResidualAmbient P) ∧
          (∀ Z₁ Z₂ : Subgroup G,
            Z₁ ∈ conjugateSubgroupOrbit Z L →
            Z₂ ∈ conjugateSubgroupOrbit Z L →
            ∃ t : L,
              IsInvolution (QuotientGroup.mk' (pCore 2 P) ⟨(t : G), hLP t.property⟩) ∧
              Z₁.conjBy (t : G) = Z₂ ∧ Z₂.conjBy (t : G) = Z₁) ∧
          twoResidualAmbient L ≤ ⁅twoResidualAmbient L, T⁆ := by
  classical
  let hSP : S ≤ P := sylow_le_of_mem_PSet hP
  let hAP : A ≤ P := hA.trans hSP
  let d := solvablePrimitive_dihedralExtraction S h P hP T hT A hA
    a haA haCore hPhi hsolv hTcore
  let AP := A.subgroupOf P
  let LP := AP ⊔ AP.conjBy d.x
  let L := LP.map P.subtype
  let q := QuotientGroup.mk' (pCore 2 P)
  let R := (d.F₀.subgroupOf P).map q
  let J := (L.subgroupOf P).map q
  have hLgen : L = A ⊔ A.conjBy (d.x : G) :=
    (generated_inside_and_quotient_image P A hAP d.x).1
  have hLP : L ≤ P := Subgroup.map_subtype_le LP
  have hAL : A ≤ L := by rw [hLgen]; exact le_sup_left
  have hF : d.F₀ = twoResidualAmbient L := by
    rw [hLgen]
    exact d.residual_generated
  have hAelem := elementary_actor_image P A hAP
    (IsPGroup.to_le h.nontrivial_two_subgroup.2 hA) hPhi
  obtain ⟨E, hE, hproduct⟩ :=
    extracted_generated_image_product P T A hAP a haA d hAelem
  have hJ : J = R ⊔ (A.subgroupOf P).map q := by
    have hLsub : L.subgroupOf P = LP := subgroupOf_map_subtype_eq LP
    change (L.subgroupOf P).map q = R ⊔ (A.subgroupOf P).map q
    rw [hLsub]
    exact extracted_generated_quotient_image P T A hAP a haA d hAelem
  have hRdata : R ≤ J ∧ (R.subgroupOf J).Normal := by
    simpa only [R, hF] using residual_image_normal P L hLP
  have hRcyclic : IsCyclic R := by
    rw [show R = Subgroup.zpowers (q d.x) from d.rotation_eq]
    infer_instance
  have hCoreS := core_le_of_mem_PSet hP
  have hZinS : Z ≤ S := hZcore.trans hCoreS
  have horbit := generated_subgroup_orbit_quotient_reflection P L S Z A
    hLP hAL hA hZinS hZ.2 hCoreS R hRdata.1 hRdata.2
    hRcyclic (IsPGroup.of_card d.rotation_card) d.odd_p hJ a haA
    d.reflection_involution d.reflected
  refine ⟨d.x, L, d.A₀, hLgen, d.A₀_le, d.A_factor, hLP,
    d.p, d.n, d.prime_p, d.odd_p, d.n_pos, E,
    (d.A₀.subgroupOf P).map q, hE, rfl, hproduct, ?_, horbit, ?_⟩
  · rw [← hF]
    exact d.residual_not_phi
  · rw [← hF]
    exact d.residual_commutator

public theorem generated_dihedral_involution_of_actor_exponent_two
    {G : Type*} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (P : Subgroup G) (hP : P ∈ PSet (⊤ : Subgroup G) S)
    (Z T : Subgroup G)
    (hZ : Z ≤ S ∧ (Z.subgroupOf S).Normal)
    (hT : T ≤ S ∧ (T.subgroupOf S).Normal)
    (A : Subgroup G) (hA : A ≤ S)
    (a : G) (haA : a ∈ A) (haCore : a ∉ twoCoreAmbient P)
    (hPhi : frattiniAmbient A ≤ twoCoreAmbient P)
    (hsolv : Group.IsSolvable P)
    (hZcore : Z ≤ twoCoreAmbient P)
    (hTcore : ¬ T ≤ twoCoreAmbient P)
    (hAexp : ∀ b : G, b ∈ A → b ^ 2 = 1) :
    ∃ x : P, ∃ L A₀ : Subgroup G,
      L = A ⊔ A.conjBy (x : G) ∧ A₀ ≤ A ∧
      (A : Set G) = (Subgroup.zpowers a : Set G) * (A₀ : Set G) ∧
      ∃ _hLP : L ≤ P, ∃ p n : ℕ, Nat.Prime p ∧ Odd p ∧ 0 < n ∧
        ∃ Ebar Abar : Subgroup (P ⧸ pCore 2 P),
          Nonempty (Ebar ≃* DihedralGroup (p ^ n)) ∧
          Abar = (A₀.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)) ∧
          IsInternalDirectProductFamily
            ((L.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)))
            (fun i : Bool => if i then Ebar else Abar) ∧
          ¬ twoResidualAmbient L ≤ phiTwo (twoResidualAmbient P) ∧
          (∀ Z₁ Z₂ : Subgroup G,
            Z₁ ∈ conjugateSubgroupOrbit Z L →
            Z₂ ∈ conjugateSubgroupOrbit Z L →
            ∃ t : L,
              IsInvolution (t : G) ∧
              Z₁.conjBy (t : G) = Z₂ ∧ Z₂.conjBy (t : G) = Z₁) ∧
          twoResidualAmbient L ≤ ⁅twoResidualAmbient L, T⁆ := by
  classical
  let hSP : S ≤ P := sylow_le_of_mem_PSet hP
  let hAP : A ≤ P := hA.trans hSP
  let d := solvablePrimitive_dihedralExtraction S h P hP T hT A hA
    a haA haCore hPhi hsolv hTcore
  let AP := A.subgroupOf P
  let LP := AP ⊔ AP.conjBy d.x
  let L := LP.map P.subtype
  let q := QuotientGroup.mk' (pCore 2 P)
  let R := (d.F₀.subgroupOf P).map q
  let J := (L.subgroupOf P).map q
  have hLgen : L = A ⊔ A.conjBy (d.x : G) :=
    (generated_inside_and_quotient_image P A hAP d.x).1
  have hLP : L ≤ P := Subgroup.map_subtype_le LP
  have hAL : A ≤ L := by rw [hLgen]; exact le_sup_left
  have hF : d.F₀ = twoResidualAmbient L := by
    rw [hLgen]
    exact d.residual_generated
  have hAelem := elementary_actor_image P A hAP
    (IsPGroup.to_le h.nontrivial_two_subgroup.2 hA) hPhi
  obtain ⟨E, hE, hproduct⟩ :=
    extracted_generated_image_product P T A hAP a haA d hAelem
  have hJ : J = R ⊔ (A.subgroupOf P).map q := by
    have hLsub : L.subgroupOf P = LP := subgroupOf_map_subtype_eq LP
    change (L.subgroupOf P).map q = R ⊔ (A.subgroupOf P).map q
    rw [hLsub]
    exact extracted_generated_quotient_image P T A hAP a haA d hAelem
  have hRdata : R ≤ J ∧ (R.subgroupOf J).Normal := by
    simpa only [R, hF] using residual_image_normal P L hLP
  have hRcyclic : IsCyclic R := by
    rw [show R = Subgroup.zpowers (q d.x) from d.rotation_eq]
    infer_instance
  have hCoreS := core_le_of_mem_PSet hP
  have hZinS : Z ≤ S := hZcore.trans hCoreS
  have hconj := generated_subgroup_orbit_conjugate_reflection P L S Z A
    hLP hAL hA hZinS hZ.2 hCoreS R hRdata.1 hRdata.2
    hRcyclic (IsPGroup.of_card d.rotation_card) d.odd_p hJ a haA
    d.reflected
  have ha : a ≠ 1 := by
    intro ha
    exact haCore (ha ▸ (twoCoreAmbient P).one_mem)
  have horbit :
      ∀ Z₁ Z₂ : Subgroup G,
        Z₁ ∈ conjugateSubgroupOrbit Z L →
        Z₂ ∈ conjugateSubgroupOrbit Z L →
        ∃ t : L, IsInvolution (t : G) ∧
          Z₁.conjBy (t : G) = Z₂ ∧ Z₂.conjBy (t : G) = Z₁ := by
    intro Z₁ Z₂ hZ₁ hZ₂
    obtain ⟨c, hswap₁, hswap₂⟩ := hconj Z₁ Z₂ hZ₁ hZ₂
    let t : L := c * ⟨a, hAL haA⟩ * c⁻¹
    refine ⟨t, ⟨?_, ?_⟩, hswap₁, hswap₂⟩
    · change (c : G) * a * (c : G)⁻¹ ≠ 1
      intro heq
      apply ha
      calc
        a = (c : G)⁻¹ * ((c : G) * a * (c : G)⁻¹) * c := by group
        _ = 1 := by rw [heq]; simp
    · change ((c : G) * a * (c : G)⁻¹) ^ 2 = 1
      calc
        ((c : G) * a * (c : G)⁻¹) ^ 2 = (c : G) * a ^ 2 * (c : G)⁻¹ := by
          simp [pow_two, mul_assoc]
        _ = 1 := by rw [hAexp a haA]; simp
  refine ⟨d.x, L, d.A₀, hLgen, d.A₀_le, d.A_factor, hLP,
    d.p, d.n, d.prime_p, d.odd_p, d.n_pos, E,
    (d.A₀.subgroupOf P).map q, hE, rfl, hproduct, ?_, horbit, ?_⟩
  · rw [← hF]
    exact d.residual_not_phi
  · rw [← hF]
    exact d.residual_commutator

end Stellmacher.SectionThree
