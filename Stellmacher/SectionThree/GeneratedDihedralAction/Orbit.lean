module

public import Stellmacher.SectionThree.PrimitiveDihedralExtraction
public import Theory.GroupAction.QuotientReflection

/-!
# Quotient reflections on conjugate subgroups

Let `Z` be normal in a `2`-subgroup `S`, and let `A≤L≤P` with `A≤S` and
`O₂(P)≤S`. Suppose the image of `L` in `P/O₂(P)` is generated by a normal
cyclic odd rotation subgroup and the image of `A`, with a selected actor
mapping to an inversion of the rotations. Then an `L`-conjugate of this
actor interchanges any two `L`-conjugates of `Z`. If the actor's image is an
involution, the interchanging element's image is an involution as well.

The kernel of `L`'s quotient map is normal in `L` and contained in `S`.
It therefore normalizes every conjugate of `Z`, allowing the subgroup-orbit
action to descend. The quotient-reflection lemma applies to this action.
This proves the valid quotient-action inference underlying Stellmacher
(3.6)(c), Journal of Algebra 190 (1997), p. 22. The involution assertion is
made in the quotient and does not require an order-two lift. The conjugacy
form also retains the actual actor's order when it is known.
-/

open scoped Pointwise

namespace Stellmacher.SectionThree

private theorem conjBy_eq_of_normalizer
    {G : Type*} [Group G] (Z : Subgroup G) (g : G)
    (hg : g ∈ Subgroup.normalizer (Z : Set G)) : Z.conjBy g = Z := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact (Subgroup.mem_normalizer_iff.mp hg y).mp hy
  · intro hx
    refine ⟨g⁻¹ * x * g, ?_, ?_⟩
    · simpa using (Subgroup.mem_normalizer_iff.mp
        ((Subgroup.normalizer (Z : Set G)).inv_mem hg) x).mp hx
    · simp [MulAut.conj_apply, mul_assoc]

private theorem normal_subgroup_normalizes_subgroup_orbit
    {G : Type*} [Group G]
    (K L S Z : Subgroup G) (hKL : K ≤ L) (hKS : K ≤ S)
    (hZ : Z ≤ S) (hKn : (K.subgroupOf L).Normal)
    (hZn : (Z.subgroupOf S).Normal) :
    ∀ Y : Subgroup G, Y ∈ conjugateSubgroupOrbit Z L →
      K ≤ Subgroup.normalizer (Y : Set G) := by
  intro Y hY
  obtain ⟨l, rfl⟩ := hY
  have hKconj := (Subgroup.normal_subgroupOf_iff hKL).mp hKn
  have hSnormalizes := (Subgroup.normal_subgroupOf_iff_le_normalizer hZ).mp hZn
  apply subgroup_le_normalizer_of_conj_mem
  intro k y hy
  obtain ⟨z, hz, rfl⟩ := hy
  let w : G := (l : G)⁻¹ * (k : G) * l
  have hw : w ∈ K := by
    simpa [w, mul_assoc] using
      hKconj (k : G) (l : G)⁻¹ k.property (L.inv_mem l.property)
  have hzw : w * z * w⁻¹ ∈ Z :=
    (Subgroup.mem_normalizer_iff.mp (hSnormalizes (hKS hw)) z).mp hz
  refine Subgroup.mem_map.mpr ⟨w * z * w⁻¹, hzw, ?_⟩
  dsimp [w, MulAut.conj_apply]
  group

public theorem generated_subgroup_orbit_conjugate_reflection
    {G : Type*} [Group G] [Finite G]
    (P L S Z A : Subgroup G) (hLP : L ≤ P) (hAL : A ≤ L)
    (hAS : A ≤ S) (hZ : Z ≤ S) (hZn : (Z.subgroupOf S).Normal)
    (hCoreS : twoCoreAmbient P ≤ S)
    (R : Subgroup (P ⧸ pCore 2 P))
    (hRJ : R ≤ (L.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)))
    (hRn : (R.subgroupOf ((L.subgroupOf P).map
      (QuotientGroup.mk' (pCore 2 P)))).Normal)
    (hRcyclic : IsCyclic R) {p : ℕ} (hRp : IsPGroup p R) (hp : Odd p)
    (hgen : (L.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)) =
      R ⊔ (A.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)))
    (a : G) (haA : a ∈ A)
    (hinv : ∀ r : P ⧸ pCore 2 P, r ∈ R →
      QuotientGroup.mk' (pCore 2 P) ⟨a, hLP (hAL haA)⟩ * r *
        (QuotientGroup.mk' (pCore 2 P) ⟨a, hLP (hAL haA)⟩)⁻¹ = r⁻¹) :
    ∀ Z₁ Z₂ : Subgroup G,
      Z₁ ∈ conjugateSubgroupOrbit Z L → Z₂ ∈ conjugateSubgroupOrbit Z L →
      ∃ c : L, Z₁.conjBy ((c : G) * a * (c : G)⁻¹) = Z₂ ∧
        Z₂.conjBy ((c : G) * a * (c : G)⁻¹) = Z₁ := by
  classical
  let q := QuotientGroup.mk' (pCore 2 P)
  let J := (L.subgroupOf P).map q
  let f₀ : L →* P ⧸ pCore 2 P := q.comp (Subgroup.inclusion hLP)
  let f : L →* J := f₀.codRestrict J (fun l =>
    Subgroup.mem_map_of_mem q l.property)
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨l, hl, hly⟩ := y.property
    exact ⟨⟨(l : G), hl⟩, Subtype.ext hly⟩
  let Rj := R.subgroupOf J
  let Aj := A.subgroupOf L
  have hRmap : Rj.map J.subtype = R := Subgroup.map_subgroupOf_eq_of_le hRJ
  have hAmap : (Aj.map f).map J.subtype = (A.subgroupOf P).map q := by
    rw [Subgroup.map_map]
    ext y
    constructor
    · rintro ⟨l, hl, rfl⟩
      exact ⟨⟨(l : G), hLP l.property⟩, hl, rfl⟩
    · rintro ⟨l, hl, rfl⟩
      exact ⟨⟨(l : G), hAL hl⟩, hl, rfl⟩
  have hgenj : Rj ⊔ Aj.map f = ⊤ := by
    apply Subgroup.map_injective J.subtype_injective
    rw [Subgroup.map_sup, hRmap, hAmap, ← hgen]
    change J = (⊤ : Subgroup J).map J.subtype
    exact J.range_subtype.symm.trans J.subtype.range_eq_map
  let _ : Rj.Normal := hRn
  let eR : Rj ≃* R := Subgroup.subgroupOfEquivOfLe hRJ
  let _ : IsCyclic Rj := (MulEquiv.isCyclic eR).mpr hRcyclic
  have hRjp : IsPGroup p Rj := hRp.of_equiv eR.symm
  let X := {Y : Subgroup G // Y ∈ conjugateSubgroupOrbit Z L}
  let action : MulAction L X :=
    { smul := fun l Y => ⟨Y.val.conjBy (l : G), by
        obtain ⟨k, hk⟩ := Y.property
        refine ⟨l * k, ?_⟩
        rw [hk, Subgroup.conjBy_conjBy]
        rfl⟩
      one_smul := by
        intro Y
        apply Subtype.ext
        exact Subgroup.conjBy_one Y.val
      mul_smul := by
        intro l k Y
        apply Subtype.ext
        exact Subgroup.conjBy_mul Y.val (l : G) (k : G) }
  let _ : MulAction L X := action
  let zX : X := ⟨Z, ⟨1, (Subgroup.conjBy_one Z).symm⟩⟩
  let K := f.ker.map L.subtype
  have hKn : (K.subgroupOf L).Normal := by
    dsimp [K]
    rw [subgroupOf_map_subtype_eq]
    infer_instance
  have hKS : K ≤ S := by
    rintro x ⟨k, hk, rfl⟩
    apply hCoreS
    have hkq : q (Subgroup.inclusion hLP k) = 1 :=
      congrArg Subtype.val (MonoidHom.mem_ker.mp hk)
    exact Subgroup.mem_map_of_mem P.subtype
      ((QuotientGroup.eq_one_iff (Subgroup.inclusion hLP k)).mp hkq)
  have hKfix := normal_subgroup_normalizes_subgroup_orbit K L S Z
    (Subgroup.map_subtype_le _) hKS hZ hKn hZn
  have hker : ∀ k : L, k ∈ f.ker → ∀ Y : X, k • Y = Y := by
    intro k hk Y
    apply Subtype.ext
    exact conjBy_eq_of_normalizer Y.val k
      (hKfix Y.val Y.property (Subgroup.mem_map_of_mem L.subtype hk))
  have hAfix : ∀ b : L, b ∈ Aj → b • zX = zX := by
    intro b hb
    apply Subtype.ext
    apply conjBy_eq_of_normalizer Z b
    exact ((Subgroup.normal_subgroupOf_iff_le_normalizer hZ).mp hZn) (hAS hb)
  let aL : L := ⟨a, hAL haA⟩
  have hinvj : ∀ r : Rj, f aL * (r : J) * (f aL)⁻¹ = (r : J)⁻¹ := by
    intro r
    apply Subtype.ext
    exact hinv (r : J) r.property
  intro Z₁ Z₂ hZ₁ hZ₂
  obtain ⟨l₁, rfl⟩ := hZ₁
  obtain ⟨l₂, rfl⟩ := hZ₂
  obtain ⟨c, hswap₁, hswap₂⟩ :=
    exists_conjugate_reflection_swapping_of_quotient f hf hker Rj hRjp hp Aj
      hgenj zX hAfix aL haA hinvj l₁ l₂
  exact ⟨c, congrArg Subtype.val hswap₁, congrArg Subtype.val hswap₂⟩

public theorem generated_subgroup_orbit_quotient_reflection
    {G : Type*} [Group G] [Finite G]
    (P L S Z A : Subgroup G) (hLP : L ≤ P) (hAL : A ≤ L)
    (hAS : A ≤ S) (hZ : Z ≤ S) (hZn : (Z.subgroupOf S).Normal)
    (hCoreS : twoCoreAmbient P ≤ S)
    (R : Subgroup (P ⧸ pCore 2 P))
    (hRJ : R ≤ (L.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)))
    (hRn : (R.subgroupOf ((L.subgroupOf P).map
      (QuotientGroup.mk' (pCore 2 P)))).Normal)
    (hRcyclic : IsCyclic R) {p : ℕ} (hRp : IsPGroup p R) (hp : Odd p)
    (hgen : (L.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)) =
      R ⊔ (A.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)))
    (a : G) (haA : a ∈ A)
    (ha : IsInvolution (QuotientGroup.mk' (pCore 2 P) ⟨a, hLP (hAL haA)⟩))
    (hinv : ∀ r : P ⧸ pCore 2 P, r ∈ R →
      QuotientGroup.mk' (pCore 2 P) ⟨a, hLP (hAL haA)⟩ * r *
        (QuotientGroup.mk' (pCore 2 P) ⟨a, hLP (hAL haA)⟩)⁻¹ = r⁻¹) :
    ∀ Z₁ Z₂ : Subgroup G,
      Z₁ ∈ conjugateSubgroupOrbit Z L → Z₂ ∈ conjugateSubgroupOrbit Z L →
      ∃ t : L, IsInvolution
        (QuotientGroup.mk' (pCore 2 P) ⟨(t : G), hLP t.property⟩) ∧
        Z₁.conjBy (t : G) = Z₂ ∧ Z₂.conjBy (t : G) = Z₁ := by
  intro Z₁ Z₂ hZ₁ hZ₂
  obtain ⟨c, hswap₁, hswap₂⟩ :=
    generated_subgroup_orbit_conjugate_reflection P L S Z A hLP hAL hAS hZ
      hZn hCoreS R hRJ hRn hRcyclic hRp hp hgen a haA hinv Z₁ Z₂ hZ₁ hZ₂
  let aL : L := ⟨a, hAL haA⟩
  let t : L := c * aL * c⁻¹
  let q := QuotientGroup.mk' (pCore 2 P)
  let f : L →* P ⧸ pCore 2 P := q.comp (Subgroup.inclusion hLP)
  have ht : f t = f c * f aL * (f c)⁻¹ := by
    simp only [t, map_mul, map_inv]
  refine ⟨t, ⟨?_, ?_⟩, hswap₁, hswap₂⟩
  · change f t ≠ 1
    rw [ht]
    intro heq
    apply ha.1
    change f aL = 1
    calc
      f aL = (f c)⁻¹ * (f c * f aL * (f c)⁻¹) * f c := by group
      _ = 1 := by rw [heq]; simp
  · change (f t) ^ 2 = 1
    rw [ht]
    calc
      (f c * f aL * (f c)⁻¹) ^ 2 = f c * (f aL) ^ 2 * (f c)⁻¹ := by
        simp [pow_two, mul_assoc]
      _ = 1 := by rw [show (f aL) ^ 2 = 1 from ha.2]; simp

end Stellmacher.SectionThree
