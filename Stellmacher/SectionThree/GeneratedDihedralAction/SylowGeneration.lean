module

public import Stellmacher.SectionThree.PrimitiveDihedralExtraction
public import Stellmacher.SectionThree.ResidualUniqueMaximal

/-!
# The extracted subgroup supplements the local Sylow subgroup

For a solvable member of the local P-set, the subgroup generated by the
extracted pair of actor conjugates, together with the distinguished Sylow
2-subgroup, is the entire local group. Otherwise their join lies in the
unique maximal subgroup above the Sylow subgroup. The residual intersection
criterion puts every residual lift of the quotient rotation in the maximal
subgroup's normal core. Lemma (3.3)(c) then places the rotation inside the
Frattini subgroup of the quotient residual, contrary to extraction.

Source: Stellmacher (3.3), (3.6), and (7.8)(b), Journal of Algebra 190 (1997),
pp. 21--23 and 36. This is the generation part of the valid local assembly;
it does not assert a lifting of quotient involutions to actual involutions.
-/

namespace Stellmacher.SectionThree

/-- The extracted subgroup and the distinguished Sylow subgroup generate P. -/
public theorem extracted_sup_sylow_eq
    {G : Type*} [Group G] [Finite G]
    (S : Subgroup G) (h : Hypotheses G S)
    (P : Subgroup G) (hP : P ∈ PSet (⊤ : Subgroup G) S)
    (hsolv : Group.IsSolvable P)
    (T A : Subgroup G) (hAP : A ≤ P) (a : G) (haA : a ∈ A)
    (d : PrimitiveDihedralExtractionData P T A hAP a haA) :
    (A ⊔ A.conjBy (d.x : G)) ⊔ S = P := by
  classical
  let L := A ⊔ A.conjBy (d.x : G)
  have hSP : S ≤ P := sylow_le_of_mem_PSet hP
  have hLP : L ≤ P := by
    change A ⊔ A.conjBy (d.x : G) ≤ P
    rw [← (generated_inside_and_quotient_image P A hAP d.x).1]
    exact Subgroup.map_subtype_le _
  have hLSP : L ⊔ S ≤ P := sup_le hLP hSP
  apply le_antisymm hLSP
  by_contra hproper
  obtain ⟨B, hB, hSB, hBuniq⟩ := hP.2
  have hSB' : S.subgroupOf P ≤ B := by
    intro s hs
    obtain ⟨b, hb, hbs⟩ := hSB hs
    have heq : b = s := P.subtype_injective hbs
    simpa [heq] using hb
  have hBuniq' : ∀ B' : Subgroup P, IsCoatom B' →
      S.subgroupOf P ≤ B' → B' = B := by
    intro B' hB' hSB'
    apply hBuniq B' hB'
    rw [← Subgroup.map_subgroupOf_eq_of_le hSP]
    exact Subgroup.map_mono hSB'
  have hJproper : (L ⊔ S).subgroupOf P ≠ ⊤ := by
    intro htop
    apply hproper
    have heq := congrArg (Subgroup.map P.subtype) htop
    rw [Subgroup.map_subgroupOf_eq_of_le hLSP,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype] at heq
    exact heq.ge
  obtain ⟨M, hM, hJM⟩ :=
    (eq_top_or_exists_le_coatom ((L ⊔ S).subgroupOf P)).resolve_left hJproper
  have hSM : S.subgroupOf P ≤ M :=
    (Subgroup.subgroupOf_mono P le_sup_right).trans hJM
  have hMB : M = B := hBuniq' M hM hSM
  have hLB : L.subgroupOf P ≤ B :=
    (Subgroup.subgroupOf_mono P le_sup_left).trans (hMB ▸ hJM)
  obtain ⟨U, hUmap⟩ := hP.1.2.1
  have hU : (U : Subgroup P) = S.subgroupOf P := by
    rw [← hUmap, subgroupOf_map_subtype_eq]
  have hOB : pCore 2 P ≤ B := by
    have hOU := (pCore_isPGroup (p := 2) (G := P)).le_sylow_of_normal U
    exact (hU ▸ hOU).trans hSB'
  have hRB := residual_inf_unique_maximal_le_normalCore
    (S.subgroupOf P) B U hU hB hSB' hBuniq' hsolv
  have h33 := lemma_three_three S h P hP B B.normalCore
    ⟨hB, hSB', hBuniq'⟩
    ⟨B.normalCore_le, inferInstance, fun N hN hNB =>
      @Subgroup.normal_le_normalCore P _ B N hN |>.mpr hNB⟩ hsolv
  let q : P →* P ⧸ pCore 2 P := QuotientGroup.mk' (pCore 2 P)
  have hRmap : (twoResidualAmbient (⊤ : Subgroup P)).map q =
      twoResidualAmbient (⊤ : Subgroup (P ⧸ pCore 2 P)) := by
    rw [twoResidualAmbient_top_eq_hktPResidual, map_hktPResidual_quotient,
      ← twoResidualAmbient_top_eq_hktPResidual]
  have hF₀L : d.F₀ ≤ L := by
    rw [d.residual_generated]
    exact Subgroup.map_subtype_le _
  apply d.rotation_not_residual_frattini
  rw [← h33.part_c]
  intro k hk
  have hkR : k ∈ (twoResidualAmbient (⊤ : Subgroup P)).map q := by
    rw [hRmap]
    exact d.rotation_le_residual hk
  obtain ⟨r, hr, hrk⟩ := hkR
  obtain ⟨b, hb, hbk⟩ := hk
  have hbB : b ∈ B := hLB (hF₀L hb)
  have hrdiv : r / b ∈ pCore 2 P :=
    QuotientGroup.eq_iff_div_mem.mp (hrk.trans hbk.symm)
  have hrB : r ∈ B := by
    simpa only [div_mul_cancel] using B.mul_mem (hOB hrdiv) hbB
  exact ⟨r, hRB ⟨hr, hrB⟩, hrk⟩

end Stellmacher.SectionThree

