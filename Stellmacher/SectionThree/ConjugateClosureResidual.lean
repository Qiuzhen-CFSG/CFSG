module
public import Stellmacher.SectionThree.PrimitiveDihedralExtraction.CyclicResidual
public import Theory.PGroupCore
public import Mathlib.Tactic.Group

/-!
# Residual generation by conjugates of an odd-core subgroup

Let D lie in the p-core of a finite group for an odd prime p, and let R
be a two-subgroup. Then the two-residual of D joined with R is precisely
the subgroup generated by the R-conjugates of D. This closure stays in
the ambient p-core, is normalized by R, and has the same join with R as
D does. The odd normal-subgroup residual theorem identifies the residual.

This is the group-theoretic normal-closure step in Stellmacher (9.4),
printed p.51/PDF p.41 of `refs/files/stellmacher-n-group.pdf`: its consumer
supplies D as the selected canonical factor's derived order-three group
and R as the actual image of the two-core intersection.
-/

namespace Stellmacher.SectionThree
universe u

public theorem twoResidualAmbient_sup_eq_conjugateClosure
    {G : Type u} [Group G] [Finite G]
    (D R : Subgroup G) {p : ℕ} (hp : p.Prime) (hpodd : Odd p)
    (hD : D ≤ pCore p G) (hR : IsPGroup 2 R) :
    twoResidualAmbient (D ⊔ R) = conjugateClosure D R := by
  let _ : Fact p.Prime := ⟨hp⟩
  let N := conjugateClosure D R
  have hDN : D ≤ N := by
    intro d hd
    exact Subgroup.subset_closure ⟨1, ⟨d,hd⟩, by simp⟩
  have hNP : N ≤ pCore p G := by
    apply (Subgroup.closure_le _).mpr
    rintro n ⟨r,d,rfl⟩
    exact Subgroup.Normal.conj_mem (inferInstance : (pCore p G).Normal) (d:G) (hD d.property) (r:G)
  have hRN : R ≤ Subgroup.normalizer N := by
    change R ≤ Subgroup.normalizer (conjugateClosure D R : Set G)
    rw [conjugateClosure,Subgroup.le_normalizer_closure_iff]
    intro r hr n hn
    obtain ⟨s,d,rfl⟩ := hn
    apply Subgroup.subset_closure
    refine ⟨⟨r*(s:G),R.mul_mem hr s.property⟩,d,?_⟩
    change r * ((s:G)*(d:G)*(s:G)⁻¹) * r⁻¹ =
      (r*(s:G))*(d:G)*(r*(s:G))⁻¹
    group
  have hNL : N ≤ D ⊔ R := by
    apply (Subgroup.closure_le _).mpr
    rintro n ⟨r,d,rfl⟩
    exact (D⊔R).mul_mem
      ((D⊔R).mul_mem (Subgroup.mem_sup_right r.property)
        (Subgroup.mem_sup_left d.property))
      (Subgroup.mem_sup_right (R.inv_mem r.property))
  have hgen : D ⊔ R = N ⊔ R :=
    le_antisymm (sup_le (hDN.trans le_sup_left) le_sup_right)
      (sup_le hNL le_sup_right)
  rw [hgen]
  exact twoResidualAmbient_sup_eq_odd_normal_subgroup N R hp hpodd
    ((pCore_isPGroup (p:=p) (G:=G)).to_le hNP) hR hRN

end Stellmacher.SectionThree
