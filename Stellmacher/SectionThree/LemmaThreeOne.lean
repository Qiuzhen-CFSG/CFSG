module

public import Stellmacher.SectionsOneToFourDefs

open scoped BigOperators Pointwise

namespace Stellmacher.SectionThree

universe u

/-! **Stellmacher (3.1).**  The set `𝓕` is retained as an explicit set of
subgroups.  The second alternative is the subgroup generated by its members;
`twoPrimeResidualAmbient` is the source's `O^{2'}` (the subgroup generated by
the Sylow 2-subgroups). -/
public theorem lemma_three_one
    {G : Type u} [Group G] [Finite G]
    (S : Sylow 2 G)
    (h : Hypotheses G (S : Subgroup G))
    (F : Set (Subgroup G))
    (hF : F = {U : Subgroup G |
      (S : Subgroup G) ≤ U ∧
      (S : Subgroup G) ≠ twoCoreAmbient U ∧
      IsUniqueMaximalContaining (S : Subgroup G) U}) :
    (F = ∅ ∧ (S : Subgroup G) = pCore 2 G) ∨
      twoPrimeResidualAmbient (⊤ : Subgroup G) =
        ⨆ P : {P : Subgroup G // P ∈ F}, (P : Subgroup G) := by
  sorry

end Stellmacher.SectionThree
