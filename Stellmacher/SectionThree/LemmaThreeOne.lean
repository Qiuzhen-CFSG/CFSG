module

public import Stellmacher.SectionThree.FamilyNormalizer


/-!
# Stellmacher (3.1): generation by the distinguished overgroups of a Sylow subgroup

Let `S` be a Sylow `2`-subgroup of the finite group `G`, and let `F` consist of
the overgroups `P` of `S` for which `S ≠ O₂(P)` and `S` lies in a unique
maximal subgroup of `P`.  This module proves Stellmacher's alternative: either
`F` is empty and `S = O₂(G)`, or the subgroup generated by `F` is the source's
`O^{2'}`—here `twoPrimeResidualAmbient`, the subgroup generated by the Sylow
`2`-subgroups.

Following `refs/latex/stellmacher-n-group.tex`, (3.1), the proof uses strong
induction on an intermediate overgroup `U` of `S`.  A Frattini factorization
handles each maximal subgroup of `U`; the induction hypothesis puts it inside
the join of the local family and `N_U(S)`.  The imported
`familyJoin_le_normalizer` shows that this join is normalized by `N_U(S)`.
If the join with `N_U(S)` were proper, it would be the unique maximal subgroup
of `U`, forcing `U` itself into the family and giving a contradiction.  When
the family join is nontrivial, its resulting normality and Sylow conjugacy
identify it with `O^{2'}(U)`; the empty case makes `S` normal and hence equal
to `O₂(U)`. The public `exists_normalizer_factor` also supplies the Frattini
factorization used in Section 4 to recover an overgroup from its local family.
-/

open scoped BigOperators Pointwise

namespace Stellmacher.SectionThree

universe u

variable {G : Type u} [Group G] [Finite G]

private theorem twoPrimeResidualSubgroup_characteristic
    (U : Subgroup G) : (twoPrimeResidualSubgroup U).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro e
  unfold twoPrimeResidualSubgroup
  rw [Subgroup.map_iSup]
  apply le_antisymm
  · exact iSup_le fun P =>
      le_iSup (fun Q : Sylow 2 U => (Q : Subgroup U))
        (P.mapSurjective e.surjective)
  · refine iSup_le fun Q => ?_
    obtain ⟨P, hP⟩ := Sylow.mapSurjective_surjective
      (f := e.toMonoidHom) e.surjective 2 Q
    rw [← hP]
    exact le_iSup (fun R : Sylow 2 U =>
      (R : Subgroup U).map e.toMonoidHom) P

private theorem twoPrimeResidualSubgroup_normal
    (U : Subgroup G) : (twoPrimeResidualSubgroup U).Normal := by
  let _ : (twoPrimeResidualSubgroup U).Characteristic :=
    twoPrimeResidualSubgroup_characteristic U
  exact Subgroup.normal_of_characteristic _

omit [Finite G] in
private theorem sylow_le_twoPrimeResidualSubgroup
    (U : Subgroup G) (S : Sylow 2 U) :
    (S : Subgroup U) ≤ twoPrimeResidualSubgroup U := by
  unfold twoPrimeResidualSubgroup
  exact le_iSup (fun T : Sylow 2 U => (T : Subgroup U)) S

omit [Finite G] in
private theorem pSubgroup_le_twoPrimeResidualAmbient
    (U Q : Subgroup G) (hQU : Q ≤ U) (hQp : IsPGroup 2 Q) :
    Q ≤ twoPrimeResidualAmbient U := by
  let QU : Subgroup U := Q.subgroupOf U
  have hQUp : IsPGroup 2 QU :=
    hQp.of_equiv (Subgroup.subgroupOfEquivOfLe hQU).symm
  obtain ⟨T, hQUT⟩ := hQUp.exists_le_sylow
  rw [twoPrimeResidualAmbient, ← Subgroup.map_subgroupOf_eq_of_le hQU]
  exact Subgroup.map_mono
    (hQUT.trans (sylow_le_twoPrimeResidualSubgroup U T))

/-- Frattini factorization by the 2-prime residual and a subgroup of the
normalizer of the given Sylow image. -/
public theorem exists_normalizer_factor
    (U S : Subgroup G) (hSylow : IsSylowSubgroupIn S U) :
    ∃ N : Subgroup G,
      S ≤ N ∧ N ≤ U ∧ N ≤ Subgroup.normalizer (S : Set G) ∧
        U ≤ twoPrimeResidualAmbient U ⊔ N := by
  obtain ⟨T, hTmap⟩ := hSylow
  let R : Subgroup U := twoPrimeResidualSubgroup U
  let _ : R.Normal := twoPrimeResidualSubgroup_normal U
  let N0 : Subgroup U := Subgroup.normalizer ((T : Subgroup U) : Set U)
  let N : Subgroup G := N0.map U.subtype
  have hTR : (T : Subgroup U) ≤ R := sylow_le_twoPrimeResidualSubgroup U T
  have hfrattini : N0 ⊔ R = ⊤ := Sylow.normalizer_sup_eq_top' T hTR
  have hmapped := congrArg (fun K : Subgroup U => K.map U.subtype) hfrattini
  rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, Subgroup.range_subtype] at hmapped
  refine ⟨N, ?_, Subgroup.map_subtype_le N0, ?_, ?_⟩
  · rw [← hTmap]
    exact Subgroup.map_mono (Subgroup.le_normalizer (H := (T : Subgroup U)))
  · apply (Subgroup.le_normalizer_map U.subtype).trans
    simp [hTmap]
  · calc
      U = N ⊔ R.map U.subtype := by simpa [N] using hmapped.symm
      _ ≤ twoPrimeResidualAmbient U ⊔ N := sup_le le_sup_right (by
        simp [R, twoPrimeResidualAmbient])

private theorem isSylowSubgroupIn_of_between
    (U S P : Subgroup G) (hSP : S ≤ P) (hPU : P ≤ U)
    (hSylow : IsSylowSubgroupIn S U) :
    IsSylowSubgroupIn S P := by
  obtain ⟨T, hTmap⟩ := hSylow
  let PU : Subgroup U := P.subgroupOf U
  have hTlePU : (T : Subgroup U) ≤ PU := by
    intro t ht
    have htS : (t : G) ∈ S := by
      rw [← hTmap]
      exact ⟨t, ht, rfl⟩
    exact hSP htS
  let TU : Sylow 2 PU := T.subtype hTlePU
  let e : PU ≃* P := Subgroup.subgroupOfEquivOfLe hPU
  let he : Function.Surjective e.toMonoidHom := e.surjective
  let TP : Sylow 2 P := TU.mapSurjective he
  refine ⟨TP, ?_⟩
  dsimp only [TP]
  rw [Sylow.coe_mapSurjective, Subgroup.map_map]
  have hcomp : P.subtype.comp e.toMonoidHom = U.subtype.comp PU.subtype := by
    ext x
    rfl
  rw [hcomp, ← Subgroup.map_map,
    show (TU : Subgroup PU) = (T : Subgroup U).subgroupOf PU by
      exact Sylow.coe_subtype T hTlePU,
    Subgroup.map_subgroupOf_eq_of_le hTlePU, hTmap]

private theorem le_unique_maximal_ambient
    {S P L : Subgroup G} {M : Subgroup P}
    (huniq : ∀ M' : Subgroup P, IsCoatom M' → S ≤ M'.map P.subtype → M' = M)
    (hSL : S ≤ L) (hLP : L ≤ P) (hLne : L ≠ P) : L ≤ M.map P.subtype := by
  have hLPne : L.subgroupOf P ≠ ⊤ := by
    intro htop
    apply hLne
    rw [← Subgroup.map_subgroupOf_eq_of_le hLP, htop,
      ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  obtain ⟨M', hM'max, hLPM'⟩ :=
    (eq_top_or_exists_le_coatom (L.subgroupOf P)).resolve_left hLPne
  have hSM' : S ≤ M'.map P.subtype := by
    apply hSL.trans
    rw [← Subgroup.map_subgroupOf_eq_of_le hLP]
    exact Subgroup.map_mono hLPM'
  rw [← huniq M' hM'max hSM']
  rw [← Subgroup.map_subgroupOf_eq_of_le hLP]
  exact Subgroup.map_mono hLPM'

private theorem twoPrimeResidualAmbient_eq_of_unique
    (S P : Subgroup G) (hSylow : IsSylowSubgroupIn S P)
    (hSneCore : S ≠ twoCoreAmbient P)
    (hUnique : IsUniqueMaximalContaining S P) :
    twoPrimeResidualAmbient P = P := by
  classical
  obtain ⟨T, hTmap⟩ := hSylow
  obtain ⟨M, hMmax, hSM, huniq⟩ := hUnique
  let R : Subgroup P := twoPrimeResidualSubgroup P
  let _ : R.Normal := twoPrimeResidualSubgroup_normal P
  let N : Subgroup P := Subgroup.normalizer ((T : Subgroup P) : Set P)
  have hTR : (T : Subgroup P) ≤ R := sylow_le_twoPrimeResidualSubgroup P T
  have hfrattini : N ⊔ R = ⊤ := Sylow.normalizer_sup_eq_top' T hTR
  have hmapped := congrArg (fun K : Subgroup P => K.map P.subtype) hfrattini
  rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, Subgroup.range_subtype] at hmapped
  by_contra hresNe
  have hSP : S ≤ P := by
    rw [← hTmap]
    exact Subgroup.map_subtype_le (T : Subgroup P)
  have hSleRmap : S ≤ R.map P.subtype := by
    rw [← hTmap]
    exact Subgroup.map_mono hTR
  have hRmapNe : R.map P.subtype ≠ P := by
    simpa [R, twoPrimeResidualAmbient] using hresNe
  have hRmap_le_M : R.map P.subtype ≤ M.map P.subtype :=
    le_unique_maximal_ambient huniq hSleRmap
      (Subgroup.map_subtype_le R) hRmapNe
  have hN_ne_top : N ≠ ⊤ := by
    intro hNtop
    have hTnormal : (T : Subgroup P).Normal := by
      apply Subgroup.normalizer_eq_top_iff.mp
      exact hNtop
    have hTleCore : (T : Subgroup P) ≤ pCore 2 P :=
      le_sSup ⟨hTnormal, T.isPGroup'⟩
    have hCoreLeT : pCore 2 P ≤ (T : Subgroup P) :=
      (pCore_isPGroup (p := 2) (G := P)).le_sylow_of_normal T
    apply hSneCore
    calc
      S = (T : Subgroup P).map P.subtype := hTmap.symm
      _ = (pCore 2 P).map P.subtype :=
        congrArg (fun K : Subgroup P => K.map P.subtype)
          (le_antisymm hTleCore hCoreLeT)
      _ = twoCoreAmbient P := rfl
  have hSleNmap : S ≤ N.map P.subtype := by
    rw [← hTmap]
    exact Subgroup.map_mono (Subgroup.le_normalizer (H := (T : Subgroup P)))
  have hNmapNe : N.map P.subtype ≠ P := by
    intro hEq
    apply hN_ne_top
    apply Subgroup.map_subtype_inj.mp
    rw [hEq, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hNmap_le_M : N.map P.subtype ≤ M.map P.subtype :=
    le_unique_maximal_ambient huniq hSleNmap
      (Subgroup.map_subtype_le N) hNmapNe
  have hP_le_Mmap : P ≤ M.map P.subtype := by
    intro x hx
    apply (sup_le hNmap_le_M hRmap_le_M)
    rw [hmapped]
    exact hx
  have hMtop : M = ⊤ := by
    apply Subgroup.map_subtype_inj.mp
    apply le_antisymm
    · exact Subgroup.map_mono le_top
    · simpa [← MonoidHom.range_eq_map, Subgroup.range_subtype] using hP_le_Mmap
  exact hMmax.1 hMtop

private noncomputable def localFamilyJoin
    (U S : Subgroup G) : Subgroup G :=
  ⨆ P : {P : Subgroup G //
    S ≤ P ∧ P ≤ U ∧ S ≠ twoCoreAmbient P ∧
      IsUniqueMaximalContaining S P},
    (P : Subgroup G)

omit [Finite G] in
private theorem localFamilyJoin_le
    (U S : Subgroup G) : localFamilyJoin U S ≤ U := by
  unfold localFamilyJoin
  exact iSup_le fun P ↦ P.property.2.1

omit [Finite G] in
private theorem localFamilyJoin_mono
    {U₁ U₂ S : Subgroup G} (hU : U₁ ≤ U₂) :
    localFamilyJoin U₁ S ≤ localFamilyJoin U₂ S := by
  unfold localFamilyJoin
  refine iSup_le fun P ↦ ?_
  exact le_iSup (fun Q : {Q : Subgroup G //
    S ≤ Q ∧ Q ≤ U₂ ∧ S ≠ twoCoreAmbient Q ∧
      IsUniqueMaximalContaining S Q} ↦ (Q : Subgroup G))
    ⟨P, P.property.1, P.property.2.1.trans hU,
      P.property.2.2.1, P.property.2.2.2⟩

omit [Finite G] in
private theorem twoPrimeResidualAmbient_mono
    {U₁ U₂ : Subgroup G} (hU : U₁ ≤ U₂) :
    twoPrimeResidualAmbient U₁ ≤ twoPrimeResidualAmbient U₂ := by
  unfold twoPrimeResidualAmbient twoPrimeResidualSubgroup
  rw [Subgroup.map_iSup]
  refine iSup_le fun T ↦ ?_
  apply pSubgroup_le_twoPrimeResidualAmbient U₂
  · exact (Subgroup.map_subtype_le (T : Subgroup U₁)).trans hU
  · exact T.isPGroup'.map U₁.subtype

private theorem localFamilyJoin_le_twoPrimeResidualAmbient
    (U S : Subgroup G) (hSylow : IsSylowSubgroupIn S U) :
    localFamilyJoin U S ≤ twoPrimeResidualAmbient U := by
  unfold localFamilyJoin
  refine iSup_le fun P ↦ ?_
  have hSylowP : IsSylowSubgroupIn S P :=
    isSylowSubgroupIn_of_between U S P P.property.1 P.property.2.1 hSylow
  rw [← twoPrimeResidualAmbient_eq_of_unique S P hSylowP
    P.property.2.2.1 P.property.2.2.2]
  exact twoPrimeResidualAmbient_mono P.property.2.1

omit [Finite G] in
private theorem twoCoreAmbient_eq_of_isSylow_of_le_normalizer
    (U S : Subgroup G) (hSU : S ≤ U)
    (hSylow : IsSylowSubgroupIn S U)
    (hnorm : U ≤ Subgroup.normalizer (S : Set G)) :
    S = twoCoreAmbient U := by
  obtain ⟨T, hTmap⟩ := hSylow
  have hT_eq : (T : Subgroup U) = S.subgroupOf U := by
    apply Subgroup.map_subtype_inj.mp
    rw [hTmap, Subgroup.map_subgroupOf_eq_of_le hSU]
  have hSnormal : (S.subgroupOf U).Normal :=
    (Subgroup.normal_subgroupOf_iff_le_normalizer hSU).2 hnorm
  have hTnormal : (T : Subgroup U).Normal := hT_eq ▸ hSnormal
  have hTleCore : (T : Subgroup U) ≤ pCore 2 U :=
    le_sSup ⟨hTnormal, T.isPGroup'⟩
  have hCoreLeT : pCore 2 U ≤ (T : Subgroup U) :=
    (pCore_isPGroup (p := 2) (G := U)).le_sylow_of_normal T
  calc
    S = (T : Subgroup U).map U.subtype := hTmap.symm
    _ = (pCore 2 U).map U.subtype :=
      congrArg (fun Q : Subgroup U ↦ Q.map U.subtype)
        (le_antisymm hTleCore hCoreLeT)
    _ = twoCoreAmbient U := rfl

omit [Finite G] in
private theorem le_normalizer_twoCoreAmbient (U : Subgroup G) :
    U ≤ Subgroup.normalizer (twoCoreAmbient U : Set G) := by
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer
    (Subgroup.map_subtype_le (pCore 2 U))).1
  rw [subgroupOf_map_subtype_eq]
  infer_instance

private theorem twoPrimeResidualAmbient_le_of_normalized_family
    (U S : Subgroup G) (_hSU : S ≤ U)
    (hSylow : IsSylowSubgroupIn S U)
    (hSJ : S ≤ localFamilyJoin U S)
    (hnorm : U ≤ Subgroup.normalizer (localFamilyJoin U S : Set G)) :
    twoPrimeResidualAmbient U ≤ localFamilyJoin U S := by
  let J : Subgroup U := (localFamilyJoin U S).subgroupOf U
  have hJnormal : J.Normal := by
    exact (Subgroup.normal_subgroupOf_iff_le_normalizer
      (localFamilyJoin_le U S)).2 hnorm
  let _ : J.Normal := hJnormal
  obtain ⟨T, hTmap⟩ := hSylow
  have hTJ : (T : Subgroup U) ≤ J := by
    rw [← Subgroup.map_le_map_iff_of_injective U.subtype_injective]
    rw [hTmap, Subgroup.map_subgroupOf_eq_of_le (localFamilyJoin_le U S)]
    exact hSJ
  unfold twoPrimeResidualAmbient twoPrimeResidualSubgroup
  rw [Subgroup.map_iSup]
  refine iSup_le fun Q ↦ ?_
  obtain ⟨u, hu⟩ := MulAction.exists_smul_eq U T Q
  have hQJ : (Q : Subgroup U) ≤ J := by
    rw [← hu]
    change (T : Subgroup U).map (MulAut.conj u) ≤ J
    calc
      (T : Subgroup U).map (MulAut.conj u) ≤
          J.map (MulAut.conj u) := Subgroup.map_mono hTJ
      _ = J := Subgroup.Normal.map_conj_eq J u
  calc
    (Q : Subgroup U).map U.subtype ≤ J.map U.subtype :=
      Subgroup.map_mono hQJ
    _ = localFamilyJoin U S :=
      Subgroup.map_subgroupOf_eq_of_le (localFamilyJoin_le U S)

private theorem local_family_alternative
    (S : Subgroup G) :
    ∀ U : Subgroup G, S ≤ U → IsSylowSubgroupIn S U →
      (localFamilyJoin U S = ⊥ ∧ S = twoCoreAmbient U) ∨
        twoPrimeResidualAmbient U = localFamilyJoin U S := by
  suffices ∀ n : ℕ, ∀ U : Subgroup G, Nat.card U = n →
      S ≤ U → IsSylowSubgroupIn S U →
        (localFamilyJoin U S = ⊥ ∧ S = twoCoreAmbient U) ∨
          twoPrimeResidualAmbient U = localFamilyJoin U S by
    intro U hSU hSylow
    exact this (Nat.card U) U rfl hSU hSylow
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
      intro U hn hSU hSylow
      let J : Subgroup G := localFamilyJoin U S
      let N : Subgroup G := U ⊓ Subgroup.normalizer (S : Set G)
      let K : Subgroup G := J ⊔ N
      have hJleU : J ≤ U := localFamilyJoin_le U S
      have hNleU : N ≤ U := inf_le_left
      have hKleU : K ≤ U := sup_le hJleU hNleU
      have hSleN : S ≤ N := le_inf hSU S.le_normalizer
      have hSleK : S ≤ K := hSleN.trans le_sup_right
      have hNnormJ : N ≤ Subgroup.normalizer (J : Set G) := by
        simpa only [N, J, localFamilyJoin] using
          familyJoin_le_normalizer U S hSU
      have hKnormJ : K ≤ Subgroup.normalizer (J : Set G) :=
        sup_le J.le_normalizer hNnormJ
      have hmax_le_K (M : Subgroup U) (hMcoatom : IsCoatom M)
          (hSM : S ≤ M.map U.subtype) : M.map U.subtype ≤ K := by
        let Mbar : Subgroup G := M.map U.subtype
        have hMbarU : Mbar ≤ U := Subgroup.map_subtype_le M
        have hMbar_ne_U : Mbar ≠ U := by
          intro hEq
          apply hMcoatom.1
          apply Subgroup.map_subtype_inj.mp
          dsimp only [Mbar] at hEq
          rw [hEq, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
        have hMcard_lt : Nat.card Mbar < Nat.card U := by
          have hcard_le : Nat.card Mbar ≤ Nat.card U :=
            Subgroup.card_le_of_le hMbarU
          apply Nat.lt_of_le_of_ne hcard_le
          intro hcard
          apply hMbar_ne_U
          exact Subgroup.eq_of_le_of_card_ge hMbarU hcard.symm.le
        have hSylowM : IsSylowSubgroupIn S Mbar :=
          isSylowSubgroupIn_of_between U S Mbar hSM hMbarU hSylow
        rcases ih (Nat.card Mbar) (by simpa only [hn] using hMcard_lt)
            Mbar rfl hSM hSylowM with hMcore | hMres
        · have hMnormS : Mbar ≤ Subgroup.normalizer (S : Set G) := by
            simpa only [hMcore.2] using le_normalizer_twoCoreAmbient Mbar
          exact (le_inf (hMbarU) hMnormS).trans le_sup_right
        · obtain ⟨NM, _hSNM, hNMM, hNMnorm, hMfactor⟩ :=
            exists_normalizer_factor Mbar S hSylowM
          have hNMleN : NM ≤ N :=
            le_inf (hNMM.trans hMbarU) hNMnorm
          have hlocalJleJ : localFamilyJoin Mbar S ≤ J :=
            (localFamilyJoin_mono hMbarU)
          apply hMfactor.trans
          exact sup_le
            ((le_of_eq hMres).trans (hlocalJleJ.trans le_sup_left))
            (hNMleN.trans le_sup_right)
      have hKeq : K = U := by
        by_contra hKne
        have hKsub_ne_top : K.subgroupOf U ≠ ⊤ := by
          intro htop
          apply hKne
          rw [← Subgroup.map_subgroupOf_eq_of_le hKleU, htop,
            ← MonoidHom.range_eq_map, Subgroup.range_subtype]
        obtain ⟨M, hMcoatom, hKM⟩ :=
          (eq_top_or_exists_le_coatom (K.subgroupOf U)).resolve_left hKsub_ne_top
        have hKleM : K ≤ M.map U.subtype := by
          rw [← Subgroup.map_subgroupOf_eq_of_le hKleU]
          exact Subgroup.map_mono hKM
        have hSM : S ≤ M.map U.subtype := hSleK.trans hKleM
        have hMleK : M.map U.subtype ≤ K := hmax_le_K M hMcoatom hSM
        have hMmap : M.map U.subtype = K := le_antisymm hMleK hKleM
        have hUnique : IsUniqueMaximalContaining S U := by
          refine ⟨M, hMcoatom, hSM, ?_⟩
          intro M' hM'coatom hSM'
          have hM'map_le : M'.map U.subtype ≤ M.map U.subtype := by
            calc
              M'.map U.subtype ≤ K := hmax_le_K M' hM'coatom hSM'
              _ = M.map U.subtype := hMmap.symm
          have hM'leM : M' ≤ M :=
            (Subgroup.map_le_map_iff_of_injective U.subtype_injective).1 hM'map_le
          exact ((IsCoatom.le_iff_eq hM'coatom hMcoatom.1).1 hM'leM).symm
        have hSneCore : S ≠ twoCoreAmbient U := by
          intro hScore
          have hUnormS : U ≤ Subgroup.normalizer (S : Set G) := by
            simpa only [hScore] using le_normalizer_twoCoreAmbient U
          have hUleK : U ≤ K :=
            (le_inf le_rfl hUnormS).trans le_sup_right
          exact hKne (le_antisymm hKleU hUleK)
        have hUleJ : U ≤ J := by
          exact le_iSup (fun P : {P : Subgroup G //
            S ≤ P ∧ P ≤ U ∧ S ≠ twoCoreAmbient P ∧
              IsUniqueMaximalContaining S P} ↦ (P : Subgroup G))
            ⟨U, hSU, le_rfl, hSneCore, hUnique⟩
        have hUleK : U ≤ K := hUleJ.trans le_sup_left
        exact hKne (le_antisymm hKleU hUleK)
      by_cases hJbot : J = ⊥
      · left
        refine ⟨hJbot, ?_⟩
        have hUnormS : U ≤ Subgroup.normalizer (S : Set G) := by
          calc
            U = K := hKeq.symm
            _ = N := by simp [K, hJbot]
            _ ≤ Subgroup.normalizer (S : Set G) := inf_le_right
        exact twoCoreAmbient_eq_of_isSylow_of_le_normalizer U S hSU hSylow hUnormS
      · right
        have hSJ : S ≤ J := by
          let I := {P : Subgroup G //
            S ≤ P ∧ P ≤ U ∧ S ≠ twoCoreAmbient P ∧
              IsUniqueMaximalContaining S P}
          rcases isEmpty_or_nonempty I with hI | hI
          · let _ : IsEmpty I := hI
            simp only [J, localFamilyJoin, iSup_of_empty] at hJbot
            exact (hJbot trivial).elim
          · let P : I := Classical.choice hI
            exact P.property.1.trans
              (le_iSup (fun Q : I ↦ (Q : Subgroup G)) P)
        have hUnormJ : U ≤ Subgroup.normalizer (J : Set G) := by
          calc
            U = K := hKeq.symm
            _ ≤ Subgroup.normalizer (J : Set G) := hKnormJ
        exact le_antisymm
          (twoPrimeResidualAmbient_le_of_normalized_family U S hSU hSylow hSJ hUnormJ)
          (localFamilyJoin_le_twoPrimeResidualAmbient U S hSylow)

private theorem isSylowSubgroupIn_top (S : Sylow 2 G) :
    IsSylowSubgroupIn (S : Subgroup G) (⊤ : Subgroup G) := by
  let e : G ≃* (⊤ : Subgroup G) := Subgroup.topEquiv.symm
  let he : Function.Surjective e.toMonoidHom := e.surjective
  let T : Sylow 2 (⊤ : Subgroup G) := S.mapSurjective he
  refine ⟨T, ?_⟩
  dsimp only [T]
  rw [Sylow.coe_mapSurjective, Subgroup.map_map]
  have hcomp : (⊤ : Subgroup G).subtype.comp e.toMonoidHom =
      MonoidHom.id G := by
    ext x
    rfl
  rw [hcomp, Subgroup.map_id]

omit [Finite G] in
private theorem twoCoreAmbient_top :
    twoCoreAmbient (⊤ : Subgroup G) = pCore 2 G := by
  unfold twoCoreAmbient
  have htop : (⊤ : Subgroup G).subtype =
      (Subgroup.topEquiv : (⊤ : Subgroup G) ≃* G).toMonoidHom := by
    ext x
    rfl
  rw [htop]
  exact pCore_map_iso 2 (Subgroup.topEquiv : (⊤ : Subgroup G) ≃* G)

public theorem lemma_three_one
    (S : Sylow 2 G)
    (h : Hypotheses G (S : Subgroup G))
    (F : Set (Subgroup G))
    (hF : F = {U : Subgroup G |
      (S : Subgroup G) ≤ U ∧
      (S : Subgroup G) ≠ twoCoreAmbient U ∧
      IsUniqueMaximalContaining (S : Subgroup G) U}) :
    (F = ∅ ∧ (S : Subgroup G) = pCore 2 G) ∨
      twoPrimeResidualAmbient (⊤ : Subgroup G) =
        ⨆ P : {P : Subgroup G // P ∈ F}, (P : Subgroup G) := by
  let S₀ : Subgroup G := (S : Subgroup G)
  have hSylowTop : IsSylowSubgroupIn S₀ (⊤ : Subgroup G) :=
    isSylowSubgroupIn_top S
  rcases local_family_alternative S₀ (⊤ : Subgroup G) le_top hSylowTop with
    hcore | hresidual
  · left
    refine ⟨?_, ?_⟩
    · apply Set.eq_empty_iff_forall_notMem.2
      intro P hPF
      have hPprop : S₀ ≤ P ∧ S₀ ≠ twoCoreAmbient P ∧
          IsUniqueMaximalContaining S₀ P := by
        rw [hF] at hPF
        exact hPF
      have hPle : P ≤ localFamilyJoin (⊤ : Subgroup G) S₀ :=
        le_iSup (fun Q : {Q : Subgroup G //
          S₀ ≤ Q ∧ Q ≤ (⊤ : Subgroup G) ∧
            S₀ ≠ twoCoreAmbient Q ∧
            IsUniqueMaximalContaining S₀ Q} ↦ (Q : Subgroup G))
          ⟨P, hPprop.1, le_top, hPprop.2.1, hPprop.2.2⟩
      have hPbot : P = ⊥ := by
        apply le_bot_iff.mp
        rw [← hcore.1]
        exact hPle
      apply h.nontrivial_two_subgroup.1
      exact le_bot_iff.mp (hPprop.1.trans_eq hPbot)
    · calc
        S₀ = twoCoreAmbient (⊤ : Subgroup G) := hcore.2
        _ = pCore 2 G := twoCoreAmbient_top
  · right
    calc
      twoPrimeResidualAmbient (⊤ : Subgroup G) =
          localFamilyJoin (⊤ : Subgroup G) S₀ := hresidual
      _ = ⨆ P : {P : Subgroup G // P ∈ F}, (P : Subgroup G) := by
        apply le_antisymm
        · unfold localFamilyJoin
          refine iSup_le fun P ↦ ?_
          exact le_iSup (fun Q : {Q : Subgroup G // Q ∈ F} ↦
            (Q : Subgroup G))
            ⟨P, by
              rw [hF]
              exact ⟨P.property.1, P.property.2.2.1,
                P.property.2.2.2⟩⟩
        · refine iSup_le fun P ↦ ?_
          have hPprop : S₀ ≤ P ∧ S₀ ≠ twoCoreAmbient P ∧
              IsUniqueMaximalContaining S₀ P := by
            exact (Set.ext_iff.mp hF (P : Subgroup G)).mp P.property
          exact le_iSup (fun Q : {Q : Subgroup G //
            S₀ ≤ Q ∧ Q ≤ (⊤ : Subgroup G) ∧
              S₀ ≠ twoCoreAmbient Q ∧
              IsUniqueMaximalContaining S₀ Q} ↦ (Q : Subgroup G))
            ⟨P, hPprop.1, le_top, hPprop.2.1, hPprop.2.2⟩

end Stellmacher.SectionThree
