module

public import Stellmacher.SectionThree.PrimitiveDihedralExtraction

/-!
# The extracted residual is generated by commutators with its actor

For the actual primitive dihedral extraction, the prescribed actor inverts
an odd cyclic image of the extracted two-residual. Every element of that
image is a square, and the square of a rotation is its commutator with the
actor. Thus the residual image lies in its actor commutator image.

The extracted two-residual is residual-perfect. The existing quotient-lift
lemma therefore removes the normal local two-core, after which mapping the
native subgroup of `P` back into the ambient group gives the result. No
identification of the extraction group with a smaller group generated by
center conjugates is made or needed.

This records a consequence of the same actor used in Stellmacher (3.6),
Journal of Algebra 190 (1997), pp.22--23, for the prescribed application of
(7.8) in (9.10), printed p.57. The later geometric conjugator may change
inside the residual while this group-level containment remains valid.

The stronger result applies to every actor outside the extracted coatom.
That coatom has index two. An outside actor differs from the prescribed
actor by a coatom element, which centralizes the rotation image; it therefore
inverts the same odd rotation. The same residual-perfect lift applies. This
uniformity selects the later transvection support without choosing a new
first-extraction conjugator.
-/

open BenderSuzuki.External
open scoped Pointwise commutatorElement

namespace Stellmacher.SectionThree

private theorem odd_reflected_le_commutator
    {H : Type*} [Group H] [Finite H]
    (R : Subgroup H) (a : H) (p n : ℕ) (hp : Nat.Prime p)
    (hodd : Odd p) (hcard : Nat.card R = p ^ n)
    (hreflect : ∀ r ∈ R, a * r * a⁻¹ = r⁻¹) :
    R ≤ ⁅R, Subgroup.zpowers a⁆ := by
  let _ : Fact p.Prime := ⟨hp⟩
  have hpR : IsPGroup p R := IsPGroup.of_card hcard
  intro r hr
  obtain ⟨s, hs⟩ := (hpR.powEquiv hodd.coprime_two_right).surjective ⟨r, hr⟩
  have hs2 : (s : H) ^ 2 = r := by
    have := congrArg Subtype.val hs
    simpa only [IsPGroup.powEquiv_apply, Subgroup.coe_pow] using this
  have hinv := hreflect (s : H)⁻¹ (R.inv_mem s.property)
  simp only [inv_inv] at hinv
  have hcomm : ⁅(s : H), a⁆ = (s : H) ^ 2 := by
    simpa only [commutatorElement_def, mul_assoc, pow_two] using
      congrArg (fun z : H => (s : H) * z) hinv
  rw [← hs2, ← hcomm]
  exact Subgroup.commutator_mem_commutator s.property (Subgroup.mem_zpowers a)

private theorem residual_le_commutator_of_reflected
    {G : Type*} [Group G] [Finite G]
    {P T A : Subgroup G} {hAP : A ≤ P} {a : G} {haA : a ∈ A}
    (e : PrimitiveDihedralExtractionData P T A hAP a haA)
    (b : G) (hbP : b ∈ P)
    (hreflect : ∀ r ∈ (e.F₀.subgroupOf P).map (QuotientGroup.mk' (pCore 2 P)),
      QuotientGroup.mk' (pCore 2 P) ⟨b, hbP⟩ * r *
        (QuotientGroup.mk' (pCore 2 P) ⟨b, hbP⟩)⁻¹ = r⁻¹) :
    e.F₀ ≤ ⁅e.F₀, Subgroup.zpowers b⁆ := by
  classical
  let O : Subgroup P := pCore 2 P
  let qO : P →* P ⧸ O := QuotientGroup.mk' O
  let F : Subgroup P := e.F₀.subgroupOf P
  let aP : P := ⟨b, hbP⟩
  let C : Subgroup P := Subgroup.zpowers aP
  have hmapF : F.map P.subtype = e.F₀ :=
    map_subgroupOf_subtype_eq e.F₀ P e.F₀_le_P
  have hmapC : C.map P.subtype = Subgroup.zpowers b :=
    MonoidHom.map_zpowers P.subtype aP
  have hFperfectG : hktPResidual 2 e.F₀ = ⊤ := by
    rw [e.residual_generated]
    exact twoResidualAmbient_has_top_twoResidual _
  let e₀ : F ≃* F.map P.subtype :=
    Subgroup.equivMapOfInjective F P.subtype P.subtype_injective
  let equiv : F ≃* e.F₀ := e₀.trans (MulEquiv.subgroupCongr hmapF)
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hresmap : (hktPResidual 2 F).map equiv.toMonoidHom =
      hktPResidual 2 e.F₀ :=
    hktPResidual_map_of_surjective' equiv.toMonoidHom equiv.surjective
  have hFperfect : hktPResidual 2 F = ⊤ := by
    apply Subgroup.map_injective (f := equiv.toMonoidHom) equiv.injective
    rw [hresmap, hFperfectG]
    exact (Subgroup.map_top_of_surjective equiv.toMonoidHom equiv.surjective).symm
  have hmap : F.map qO ≤ (⁅F, C⁆).map qO := by
    rw [Subgroup.map_commutator, MonoidHom.map_zpowers]
    exact odd_reflected_le_commutator (F.map qO) (qO aP)
      e.p e.n e.prime_p e.odd_p e.rotation_card hreflect
  have hcomm : F ≤ ⁅F, C⁆ :=
    residualPerfect_le_commutator_of_quotient O F C
      pCore_normal pCore_isPGroup hFperfect hmap
  calc
    e.F₀ = F.map P.subtype := hmapF.symm
    _ ≤ (⁅F, C⁆).map P.subtype := Subgroup.map_mono hcomm
    _ = ⁅e.F₀, Subgroup.zpowers b⁆ := by
      rw [Subgroup.map_commutator, hmapF, hmapC]

public theorem PrimitiveDihedralExtractionData.residual_le_actor_commutator
    {G : Type*} [Group G] [Finite G]
    {P T A : Subgroup G} {hAP : A ≤ P} {a : G} {haA : a ∈ A}
    (e : PrimitiveDihedralExtractionData P T A hAP a haA) :
    e.F₀ ≤ ⁅e.F₀, Subgroup.zpowers a⁆ :=
  residual_le_commutator_of_reflected e a (hAP haA) e.reflected

public theorem PrimitiveDihedralExtractionData.residual_le_outside_actor_commutator
    {G : Type*} [Group G] [Finite G]
    {P T A : Subgroup G} {hAP : A ≤ P} {a : G} {haA : a ∈ A}
    (e : PrimitiveDihedralExtractionData P T A hAP a haA)
    (b : G) (hbA : b ∈ A) (hb0 : b ∉ e.A₀) :
    e.F₀ ≤ ⁅e.F₀, Subgroup.zpowers b⁆ := by
  classical
  have ha0 : a ∉ e.A₀ := by
    intro ha
    have hle : A ≤ e.A₀ := by
      intro element helement
      have hprod : element ∈ (Subgroup.zpowers a : Set G) * (e.A₀ : Set G) :=
        e.A_factor ▸ helement
      obtain ⟨power, hpower, coatom, hcoatom, rfl⟩ := hprod
      exact e.A₀.mul_mem ((Subgroup.zpowers_le.mpr ha) hpower) hcoatom
    have heq : A = e.A₀ := le_antisymm hle e.A₀_le
    have hcard := e.A₀_index_two
    have hcardEq := congrArg (fun K : Subgroup G => Nat.card K) heq
    have hpositive : 0 < Nat.card e.A₀ := Nat.card_pos
    omega
  let K := e.A₀.subgroupOf A
  have hindex : K.index = 2 := by
    have hproduct := K.index_mul_card
    have hcardK : Nat.card K = Nat.card e.A₀ :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe e.A₀_le).toEquiv
    rw [hcardK, e.A₀_index_two] at hproduct
    exact Nat.eq_of_mul_eq_mul_right (Nat.card_pos (α := e.A₀)) hproduct
  have haInv : (⟨a, haA⟩ : A)⁻¹ ∉ K := by
    change a⁻¹ ∉ e.A₀
    simpa only [Subgroup.inv_mem_iff] using ha0
  have hbNot : (⟨b, hbA⟩ : A) ∉ K := hb0
  have hab : a⁻¹ * b ∈ e.A₀ :=
    (K.mul_mem_iff_of_index_two hindex).mpr (iff_of_false haInv hbNot)
  let cP : P := ⟨a⁻¹ * b, hAP (e.A₀_le hab)⟩
  let aP : P := ⟨a, hAP haA⟩
  let bP : P := ⟨b, hAP hbA⟩
  let qP := QuotientGroup.mk' (pCore 2 P)
  have hbEq : bP = aP * cP := by
    apply Subtype.ext
    exact (mul_inv_cancel_left a b).symm
  apply residual_le_commutator_of_reflected e b (hAP hbA)
  intro r hr
  have hc : qP cP * r * (qP cP)⁻¹ = r := by
    rw [e.A₀_centralizes_rotation (a⁻¹ * b) hab r hr, mul_inv_cancel_right]
  change qP bP * r * (qP bP)⁻¹ = r⁻¹
  rw [hbEq, map_mul]
  calc
    qP aP * qP cP * r * (qP aP * qP cP)⁻¹ =
        qP aP * (qP cP * r * (qP cP)⁻¹) * (qP aP)⁻¹ := by group
    _ = r⁻¹ := by rw [hc]; exact e.reflected r hr

end Stellmacher.SectionThree
