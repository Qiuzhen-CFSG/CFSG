module
public import Stellmacher.SectionThree.ResidualImageOddPGroup
public import Stellmacher.SectionThree.LemmaThreeSeven
public import Stellmacher.SectionOne.FixedHyperplaneActorCard
public import Theory.GroupAction.NormalizingFixedPoints
public import Theory.GroupAction.IrreducibleTwoCoreKernel
public import Theory.GroupAction.FixedHyperplaneQuadratic

/-!
# Actual actor images on irreducible local binary modules

The faithful range of a local representation is core-free: a normal two-subgroup
has a nonidentity fixed vector, and irreducibility makes its fixed subgroup the
whole module. Consequently the native two-core lies in the representation kernel.
The local residual image is then an odd prime-power group. Lifting any Sylow
subgroup through the range projection shows that the odd core supplements it.
The surjective odd-supplement theorem is exported separately for local quotient
actions generated by Sylow-fixed vectors, which need not be irreducible.

Orbit counting also gives a nonidentity Sylow-fixed vector, whose action closure
is the whole irreducible module. These are the actual Section One hypotheses for
the evaluation action, not assumptions on a replacement representation.

The source-neutral fixed-point and two-core kernel lemmas are re-exported
from `Theory.GroupAction.IrreducibleTwoCoreKernel`; this module retains the
local residual/supplement and actor-cardinality arguments.

Source: Stellmacher, Journal of Algebra 190 (1997), printed p.40 / PDF p.30,
the application of (1.2) to the fixed-index-two module in the proof of (8.4).
The final transfer from an irreducible constituent to the original actor requires
separate residual-kernel control and is not asserted by this module.
-/

open Stellmacher

namespace Stellmacher.SectionThree

private theorem irreducible_sylow_fixed_generation
    {G W : Type*} [Group G] [Group W] [Finite W]
    [IsElementaryAbelian 2 W] [MulDistribMulAction G W] [Nontrivial W]
    (hirr : ∀ D : Subgroup W, (∀ g : G, ∀ w : W, w ∈ D → g • w ∈ D) →
      D = ⊥ ∨ D = ⊤)
    (T : Sylow 2 G) :
    (⊤ : Subgroup W) = SectionOne.actionClosure G W (FixedPoints.subgroup T W) := by
  let C := SectionOne.actionClosure G W (FixedPoints.subgroup T W)
  have hstable : ∀ g : G, ∀ w : W, w ∈ C → g • w ∈ C := by
    intro g w hw
    induction hw using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨a, v, hv, rfl⟩ := hx
      exact Subgroup.subset_closure ⟨g * a, v, hv, (mul_smul g a v).symm⟩
    | one => simpa only [smul_one] using C.one_mem
    | mul x y _ _ hx hy => simpa only [smul_mul'] using C.mul_mem hx hy
    | inv x _ hx => simpa only [smul_inv'] using C.inv_mem hx
  have hfixed : FixedPoints.subgroup T W ≤ C := by
    intro w hw
    exact Subgroup.subset_closure ⟨1, w, hw, (one_smul G w).symm⟩
  exact ((hirr C hstable).resolve_left (fun heq =>
    irreducible_fixed_nontrivial (T : Subgroup G) T.isPGroup'
      (le_bot_iff.mp (heq ▸ hfixed)))).symm

public theorem pSet_surjective_odd_supplement
    {H X : Type*} [Group H] [Finite H] [Group X] [Finite X]
    (S P : Subgroup H) (h : Hypotheses H S)
    (hP : P ∈ PSet (⊤ : Subgroup H) S) (hsolv : Group.IsSolvable P)
    (f : P →* X) (hsurj : Function.Surjective f) (hker : pCore 2 P ≤ f.ker)
    (T : Sylow 2 X) :
    (⊤ : Subgroup X) = SectionOne.oddCore X ⊔ (T : Subgroup X) := by
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨prime, hprime, hodd, hRp⟩ :=
    pSet_residual_image_is_odd_pGroup S h P hP hsolv f hker
  let R := twoResidualSubgroup P
  have hRn : R.Normal := by
    rw [show R = BenderSuzuki.External.hktPResidual 2 P from
      twoResidualSubgroup_eq_hktPResidual' P]
    exact BenderSuzuki.External.hktPResidual_normal
  have himageN : (R.map f).Normal := hRn.map f hsurj
  have hoddcard : Nat.Coprime 2 (Nat.card (R.map f)) := by
    let _ : Fact prime.Prime := ⟨hprime⟩
    obtain ⟨exponent, hexponent⟩ := (IsPGroup.iff_card.mp hRp)
    rw [hexponent]
    exact (Nat.coprime_two_left.mpr hodd).pow_right _
  have hRcore : R.map f ≤ SectionOne.oddCore X := le_sSup ⟨himageN, hoddcard⟩
  obtain ⟨U, hUT⟩ := Sylow.mapSurjective_surjective hsurj 2 T
  have hnative : R ⊔ (U : Subgroup P) = ⊤ := by
    apply Subgroup.map_injective P.subtype_injective
    rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
    exact twoResidual_sup_sylowImage ⟨U, rfl⟩
  have hmap := congrArg (fun D : Subgroup P => D.map f) hnative
  rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, f.range_eq_top_of_surjective hsurj] at hmap
  have hTmap : (U : Subgroup P).map f = (T : Subgroup X) :=
    congrArg Sylow.toSubgroup hUT
  rw [hTmap] at hmap
  exact (top_unique (hmap ▸ sup_le_sup_right hRcore _)).symm

private theorem irreducible_range_actor_card_le_two
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W] [Nontrivial W]
    (G : Subgroup (MulAut W)) (hsolv : Group.IsSolvable G)
    (hirr : ∀ D : Subgroup W, (∀ g : G, ∀ w : W, w ∈ D → g • w ∈ D) →
      D = ⊥ ∨ D = ⊤)
    (hsup : ∀ T : Sylow 2 G, (⊤ : Subgroup G) = SectionOne.oddCore G ⊔ T)
    (Y : Subgroup G) (hYp : IsPGroup 2 Y)
    (hfixed : Nat.card W ≤ 2 * Nat.card (FixedPoints.subgroup Y W))
    (hquadratic : Nat.card W = 2 * Nat.card (FixedPoints.subgroup Y W) →
      IsQuadraticAction Y W) : Nat.card Y ≤ 2 := by
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  by_cases hY : Y = ⊥
  · simp [hY]
  have hfaithful : fixingSubgroup G (Set.univ : Set W) = ⊥ := by
    apply le_bot_iff.mp
    intro g hg
    rw [Subgroup.mem_bot]
    apply Subtype.ext
    apply MulEquiv.ext
    intro w
    rw [mem_fixingSubgroup_iff] at hg
    exact hg w (Set.mem_univ _)
  have hproper : FixedPoints.subgroup Y W ≠ ⊤ := by
    intro htop
    apply hY
    apply le_bot_iff.mp
    intro g hg
    have hgf : g ∈ fixingSubgroup G (Set.univ : Set W) := by
      rw [mem_fixingSubgroup_iff]
      intro w _
      have hw : w ∈ FixedPoints.subgroup Y W := by rw [htop]; trivial
      exact hw ⟨g, hg⟩
    rwa [hfaithful] at hgf
  have hindex : Nat.card W = 2 * Nat.card (FixedPoints.subgroup Y W) := by
    have hmul := (FixedPoints.subgroup Y W).card_mul_index
    have hpos : 0 < Nat.card (FixedPoints.subgroup Y W) := Nat.card_pos
    have hgt : 1 < (FixedPoints.subgroup Y W).index :=
      Subgroup.one_lt_index_of_ne_top hproper
    nlinarith
  have heven : Even (Nat.card G) := by
    apply even_iff_two_dvd.mpr
    exact ((hYp.card_eq_or_dvd.resolve_left (fun heq =>
      hY (Subgroup.card_eq_one.mp heq))).trans (Subgroup.card_subgroup_dvd_card Y))
  obtain ⟨T, hYT⟩ := hYp.exists_le_sylow
  exact SectionOne.quadratic_actor_card_le_two_of_fixed_index_two
    ⟨hsolv, heven, hfaithful, irreducible_range_two_core_eq_bot G hirr⟩
    T (hsup T) (irreducible_sylow_fixed_generation hirr T) Y hYT
    (hquadratic hindex) hindex

/-- The actual elementary actor image on an irreducible residual-nontrivial
local module has order at most two when its common fixed subgroup has index
at most two. All actions are the standard evaluation actions. -/
public theorem pSet_irreducible_fixed_hyperplane_actor_card_le_two
    {H W : Type*} [Group H] [Finite H] [Group W] [Finite W]
    [IsElementaryAbelian 2 W]
    (S P A : Subgroup H) (h : Hypotheses H S)
    (hP : P ∈ PSet (⊤ : Subgroup H) S) (hsolv : Group.IsSolvable P)
    (hA : IsElementaryAbelian 2 A) (hAP : A ≤ P)
    (f : P →* MulAut W)
    (hirr : ∀ D : Subgroup W, (∀ p : P, ∀ w : W, w ∈ D → f p w ∈ D) →
      D = ⊥ ∨ D = ⊤)
    (hres : ¬ twoResidualSubgroup P ≤ f.ker)
    (hfixed : Nat.card W ≤ 2 * Nat.card (FixedPoints.subgroup ((A.subgroupOf P).map f) W)) :
    Nat.card ((A.subgroupOf P).map f) ≤ 2 := by
  classical
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let _ := hA
  let _ := hsolv
  let _ : IsElementaryAbelian 2 (A.subgroupOf P) := IsElementaryAbelian.subgroupOf hAP
  rcases subsingleton_or_nontrivial W with hW | hW
  · let _ := hW
    exact (hres (fun p _ => by
      apply MulEquiv.ext
      intro w
      exact Subsingleton.elim _ _)).elim
  let _ := hW
  let G := f.range
  let K := (A.subgroupOf P).map f
  have hKG : K ≤ G := Subgroup.map_le_range f _
  let Y := K.subgroupOf G
  have hirrG : ∀ D : Subgroup W, (∀ g : G, ∀ w : W, w ∈ D → g • w ∈ D) →
      D = ⊥ ∨ D = ⊤ := by
    intro D hD
    apply hirr D
    intro p w hw
    exact hD (f.rangeRestrict p) w hw
  have hkernel : pCore 2 P ≤ f.rangeRestrict.ker := by
    rw [MonoidHom.ker_rangeRestrict]
    exact irreducible_range_core_le_ker f hirrG
  have hGsolv : Group.IsSolvable G :=
    Group.isSolvable_of_surjective f.rangeRestrict_surjective
  have hKp : IsPGroup 2 K :=
    (IsElementaryAbelian.isPGroup 2 (A.subgroupOf P)).map f
  have hYp : IsPGroup 2 Y := hKp.comap_subtype
  have hfixeq : FixedPoints.subgroup Y W = FixedPoints.subgroup K W := by
    ext w
    rw [FixedPoints.mem_subgroup, FixedPoints.mem_subgroup]
    constructor
    · intro hw actor
      exact hw ⟨⟨actor, hKG actor.property⟩, actor.property⟩
    · intro hw actor
      exact hw ⟨((actor : G) : MulAut W), actor.property⟩
  have hYfixed : Nat.card W ≤ 2 * Nat.card (FixedPoints.subgroup Y W) := by
    rw [hfixeq]
    exact hfixed
  have hbound := irreducible_range_actor_card_le_two G hGsolv hirrG
    (pSet_surjective_odd_supplement S P h hP hsolv f.rangeRestrict
      f.rangeRestrict_surjective hkernel) Y hYp hYfixed
      (fun hindex => fixed_hyperplane_isQuadraticAction hindex)
  have hcard : Nat.card Y = Nat.card K :=
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe hKG).toEquiv
  rwa [hcard] at hbound

end Stellmacher.SectionThree
