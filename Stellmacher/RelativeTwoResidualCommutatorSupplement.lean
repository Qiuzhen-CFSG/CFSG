module
public import Stellmacher.TwoResidualCommutatorSupplement
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Residual commutator bounds with a relatively normal target

Suppose M and P normalize Z, P normalizes M, and P is generated by a
subgroup A and a two-subgroup T. If [A,M] lies in Z, then [O²(P),M]
lies in Z. No ambient normality of Z or containment M≤P is required.

Restrict all subgroups to the normalizer of Z, where Z is normal. Apply
the normal-target two-group supplement theorem there, and map its result
back by the normalizer subtype. Functoriality identifies the residual
with the original O²(P).

This relative form is used in the final central paragraph of Stellmacher
(9.4), printed p.52, with Z=V_next and P generated by the initial core
and the actor. The proof is source-independent finite-group algebra.
-/

namespace Stellmacher
open SectionThree
public theorem twoResidual_commutator_le_of_relative_two_supplement
    {G : Type*} [Group G] [Finite G]
    (M Z A T P : Subgroup G)
    (hMZ : M ≤ Subgroup.normalizer (Z : Set G))
    (hPZ : P ≤ Subgroup.normalizer (Z : Set G))
    (hPM : P ≤ Subgroup.normalizer (M : Set G))
    (hgen : A ⊔ T = P) (hT : IsPGroup 2 T)
    (hAM : ⁅A,M⁆ ≤ Z) : ⁅twoResidualAmbient P,M⁆ ≤ Z := by
  let N := Subgroup.normalizer (Z : Set G)
  have hAP : A ≤ P := le_sup_left.trans_eq hgen
  have hTP : T ≤ P := le_sup_right.trans_eq hgen
  have hAZ : A ≤ N := hAP.trans hPZ
  have hTZ : T ≤ N := hTP.trans hPZ
  let _ : (Z.subgroupOf N).Normal := Subgroup.normal_in_normalizer
  have hnorm : P.subgroupOf N ≤ Subgroup.normalizer (M.subgroupOf N : Set N) := by
    apply Subgroup.le_normalizer_iff_commutator_le_right.mpr
    apply (Subgroup.map_le_map_iff_of_injective N.subtype_injective).mp
    rw [Subgroup.map_commutator,Subgroup.map_subgroupOf_eq_of_le hPZ,
      Subgroup.map_subgroupOf_eq_of_le hMZ]
    exact Subgroup.le_normalizer_iff_commutator_le_right.mp hPM
  have hgenN : A.subgroupOf N ⊔ T.subgroupOf N = P.subgroupOf N := by
    rw [← Subgroup.subgroupOf_sup hAZ hTZ,hgen]
  have hbound : ⁅A.subgroupOf N,M.subgroupOf N⁆ ≤ Z.subgroupOf N := by
    apply (Subgroup.map_le_map_iff_of_injective N.subtype_injective).mp
    rw [Subgroup.map_commutator,Subgroup.map_subgroupOf_eq_of_le hAZ,
      Subgroup.map_subgroupOf_eq_of_le hMZ,
      Subgroup.map_subgroupOf_eq_of_le Z.le_normalizer]
    exact hAM
  have hh := Subgroup.map_mono (f := N.subtype)
    (twoResidual_commutator_le_of_normalizing_two_supplement
      (M.subgroupOf N) (Z.subgroupOf N) (A.subgroupOf N) (T.subgroupOf N)
      (P.subgroupOf N) hnorm hgenN hT.comap_subtype hbound)
  rw [Subgroup.map_commutator,
    map_twoResidualAmbient_of_subgroup_image (P.subgroupOf N) N.subtype P
      (Subgroup.map_subgroupOf_eq_of_le hPZ),
    Subgroup.map_subgroupOf_eq_of_le hMZ,
    Subgroup.map_subgroupOf_eq_of_le Z.le_normalizer] at hh
  exact hh
end Stellmacher
