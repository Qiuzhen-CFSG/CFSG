module
public import Stellmacher.TwoResidualCentralizerSupplement
public import Stellmacher.SectionThree.PrimitiveDihedralExtraction.ResidualLift

/-!
# A residual commutator bound modulo a normal subgroup

If P normalizes an ambient subgroup M and is generated by A together with
a two-subgroup T, then a bound [A,M]≤Z modulo a normal subgroup Z extends
to [O²(P),M]≤Z. No containment M≤P or solvability is assumed.

Pass to G/Z. The normalizing action and generation survive in the quotient,
where A centralizes the image of M. The external normalizer form of the
residual centralizer-supplement theorem kills the residual action there.
Functoriality of O² identifies the residual image, and the quotient kernel
lifts its zero commutator back to the claimed bound.

This is the repeated quotient-supplement reduction in Stellmacher (8.4)(7)
and (8), Journal of Algebra 190 (1997), printed p.39. It preserves the exact
former private source-(7) argument for reuse in source (8).
-/

namespace Stellmacher
public theorem twoResidual_commutator_le_of_normalizing_two_supplement
    {G : Type*} [Group G] [Finite G]
    (M Z A T P : Subgroup G) [Z.Normal]
    (hPM : P ≤ Subgroup.normalizer (M : Set G))
    (hgen : A ⊔ T = P) (hT : IsPGroup 2 T)
    (hAM : ⁅A,M⁆ ≤ Z) : ⁅twoResidualAmbient P,M⁆ ≤ Z := by
  let q := QuotientGroup.mk' Z
  have hPMq : P.map q ≤ Subgroup.normalizer (M.map q : Set (G ⧸ Z)) := by
    apply Subgroup.le_normalizer_iff_commutator_le_right.mpr
    rw [← Subgroup.map_commutator]
    exact Subgroup.map_mono (Subgroup.le_normalizer_iff_commutator_le_right.mp hPM)
  have hgenq : A.map q ⊔ T.map q = P.map q := by rw [← Subgroup.map_sup,hgen]
  have hAMq : ⁅A.map q,M.map q⁆ = ⊥ := by
    rw [← Subgroup.map_commutator]
    exact (Subgroup.map_eq_bot_iff _).mpr (by simpa only [q,QuotientGroup.ker_mk'] using hAM)
  have hresq := twoResidual_centralizes_of_normalizing_two_supplement
    (M.map q) (A.map q) (T.map q) (P.map q) hPMq hgenq (hT.map q) hAMq
  have hmapR : (twoResidualAmbient P).map q = twoResidualAmbient (P.map q) :=
    map_twoResidualAmbient_of_subgroup_image P q (P.map q) rfl
  have hkill : (⁅twoResidualAmbient P,M⁆).map q = ⊥ := by
    rw [Subgroup.map_commutator,hmapR,hresq]
  simpa only [q,QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp hkill
end Stellmacher
