module

public import FeitThompson.PCore.PPrimeCore
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Prime cores generated by normal factors

This module gives a factorization criterion for a finite group's `p'`-core.
Suppose `O_{p'}(G)S` is generated by finitely many subgroups which are normal
inside that product.  If each factor's derived subgroup lies in `O_{p'}(G)`
and has `p`-power index in the factor, the restricted prime core is exactly
the join of those derived subgroups.  Consequently, if they are all
`q`-groups, then `O_{p'}(G)` itself is a `q`-group.

The proof collects the derived subgroups in a normal subgroup `D`.  Modulo
`D`, the normal factor images are `p`-groups and generate the quotient.  The
image of `O_{p'}(G)` there is therefore both a `p`-group and of order coprime
to `p`, so it is trivial and the restricted prime core equals `D`.  The
wrapper then uses the `q`-group hypotheses to make this join a `q`-group.

This generic result isolates the group-theoretic product argument used after
the recursive `SL₂(2)` decomposition in Stellmacher's Lemma (1.6), journal
page 17 (`refs/latex/stellmacher-n-group.tex`).
-/

@[expose] public section

open scoped BigOperators Pointwise

universe u

/-- If normal factors generate `O_{p'}(G)S`, their derived subgroups lie in
`O_{p'}(G)`, and their abelianizations are `p`-groups, then the restriction
of `O_{p'}(G)` to that product is exactly the join of the factor derived
subgroups. -/
public theorem pPrimeCore_subgroupOf_eq_iSup_commutator_of_generated_factors
    {G : Type u} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime]
    (S : Subgroup G) (F : Finset (Subgroup G))
    (hgen : pPrimeCore p G ⊔ S =
      ⨆ E : {E : Subgroup G // E ∈ F}, (E : Subgroup G))
    (hnorm : ∀ E : Subgroup G, E ∈ F →
      (E.subgroupOf (pPrimeCore p G ⊔ S)).Normal)
    (hderived_le : ∀ E : Subgroup G, E ∈ F →
      ⁅E, E⁆ ≤ pPrimeCore p G)
    (hindex : ∀ E : Subgroup G, E ∈ F →
      let H := pPrimeCore p G ⊔ S
      ∃ n : ℕ, ((commutator (E.subgroupOf H)).map
        (E.subgroupOf H).subtype).relIndex (E.subgroupOf H) = p ^ n) :
    (pPrimeCore p G).subgroupOf (pPrimeCore p G ⊔ S) =
      ⨆ E : {E : Subgroup G // E ∈ F},
        ⁅(E : Subgroup G).subgroupOf (pPrimeCore p G ⊔ S),
          (E : Subgroup G).subgroupOf (pPrimeCore p G ⊔ S)⁆ := by
  classical
  let H : Subgroup G := pPrimeCore p G ⊔ S
  have hEleH (E : Subgroup G) (hE_mem : E ∈ F) : E ≤ H := by
    change E ≤ pPrimeCore p G ⊔ S
    rw [hgen]
    exact le_iSup (fun E' : {E' : Subgroup G // E' ∈ F} => (E' : Subgroup G))
      ⟨E, hE_mem⟩
  let EH (E : Subgroup G) : Subgroup H := E.subgroupOf H
  let DE (E : Subgroup G) : Subgroup H := ⁅EH E, EH E⁆
  have hEHnormal (E : Subgroup G) (hE_mem : E ∈ F) : (EH E).Normal :=
    hnorm E hE_mem
  have hDEnormal (E : Subgroup G) (hE_mem : E ∈ F) : (DE E).Normal := by
    let : (EH E).Normal := hEHnormal E hE_mem
    exact inferInstance
  let D : Subgroup H := ⨆ E : {E : Subgroup G // E ∈ F}, DE E
  let : D.Normal := by
    let instDE (E : {E : Subgroup G // E ∈ F}) : (DE E).Normal :=
      hDEnormal E E.property
    exact Subgroup.iSup_normal (fun E : {E : Subgroup G // E ∈ F} => DE E)
  have hDEmap (E : Subgroup G) (hE_mem : E ∈ F) :
      (DE E).map H.subtype = ⁅E, E⁆ := by
    exact commutator_subgroupOf_map_eq H E E (hEleH E hE_mem) (hEleH E hE_mem)
  have hDEeq (E : Subgroup G) :
      DE E = (commutator (EH E)).map (EH E).subtype :=
    (Subgroup.map_subtype_commutator (EH E)).symm
  have hDEleCore (E : Subgroup G) (hE_mem : E ∈ F) :
      DE E ≤ (pPrimeCore p G).subgroupOf H := by
    intro x hx
    exact hderived_le E hE_mem (by
      rw [← hDEmap E hE_mem]
      exact ⟨x, hx, rfl⟩)
  have hDleCore : D ≤ (pPrimeCore p G).subgroupOf H := by
    dsimp [D]
    exact iSup_le fun E => hDEleCore E E.property
  let r : H →* H ⧸ D := QuotientGroup.mk' D
  have hDEleEH (E : Subgroup G) : DE E ≤ EH E :=
    Subgroup.commutator_le_self (EH E)
  have hfactorp (E : Subgroup G) (hE_mem : E ∈ F) :
      IsPGroup p ((EH E).map r) := by
    let f : EH E →* H ⧸ D := r.comp (EH E).subtype
    have hcommLe : (DE E).subgroupOf (EH E) ≤ f.ker := by
      intro x hx
      change r ((x : EH E) : H) = 1
      apply (QuotientGroup.eq_one_iff ((x : EH E) : H)).2
      exact le_iSup (fun E' : {E' : Subgroup G // E' ∈ F} => DE E')
        ⟨E, hE_mem⟩ hx
    obtain ⟨n, hn⟩ := hindex E hE_mem
    rw [← hDEeq E] at hn
    have hcardDvd : Nat.card f.range ∣ p ^ n := by
      rw [← Subgroup.index_ker f, ← hn]
      exact Subgroup.index_dvd_of_le hcommLe
    have hrangeP : IsPGroup p f.range :=
      isPGroup_iff_card_dvd_pow.2 ⟨n, hcardDvd⟩
    have hrange : f.range = (EH E).map r := by
      simp [f, MonoidHom.range_comp]
    rwa [hrange] at hrangeP
  have htop : (⊤ : Subgroup H) =
      ⨆ E : {E : Subgroup G // E ∈ F}, EH E := by
    have hmapEH (E : {E : Subgroup G // E ∈ F}) :
        (EH E).map H.subtype = (E : Subgroup G) :=
      Subgroup.map_subgroupOf_eq_of_le (hEleH E E.property)
    apply Subgroup.map_injective H.subtype_injective
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype, Subgroup.map_iSup]
    simp_rw [hmapEH]
    exact hgen
  have hquotTop : (⊤ : Subgroup (H ⧸ D)) =
      ⨆ E : {E : Subgroup G // E ∈ F}, (EH E).map r := by
    calc
      (⊤ : Subgroup (H ⧸ D)) = (⊤ : Subgroup H).map r := by
        rw [← MonoidHom.range_eq_map,
          MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective D)]
      _ = _ := by rw [htop, Subgroup.map_iSup]
  have hfactorNormal (E : Subgroup G) (hE_mem : E ∈ F) :
      ((EH E).map r).Normal := by
    let : (EH E).Normal := hEHnormal E hE_mem
    exact Subgroup.Normal.map (inferInstance : (EH E).Normal) r
      (QuotientGroup.mk'_surjective D)
  have hquotp : IsPGroup p (H ⧸ D) := by
    let : ∀ E : {E : Subgroup G // E ∈ F}, ((EH E).map r).Normal :=
      fun E => hfactorNormal E E.property
    have htopP : IsPGroup p (⊤ : Subgroup (H ⧸ D)) := by
      rw [hquotTop]
      exact Sylow.iSup_of_normal (p := p)
        (fun E : {E : Subgroup G // E ∈ F} => (EH E).map r)
        (fun E => hfactorp E E.property)
    exact htopP.of_equiv Subgroup.topEquiv
  let WH : Subgroup H := (pPrimeCore p G).subgroupOf H
  have hWHmapP : IsPGroup p (WH.map r) := hquotp.to_subgroup (WH.map r)
  have hWHcard : Nat.card WH = Nat.card (pPrimeCore p G) :=
    natCard_subgroupOf_eq (pPrimeCore p G) H le_sup_left
  have hWHmapCop : Nat.Coprime p (Nat.card (WH.map r)) := by
    apply Nat.Coprime.of_dvd_right (Subgroup.card_map_dvd (H := WH) r)
    rw [hWHcard]
    exact pPrimeCore_coprime_card (p := p) (G := G)
  have hWHmapCard : Nat.card (WH.map r) = 1 := by
    rcases hWHmapP.card_eq_or_dvd with hcard | hdvd
    · exact hcard
    · exact False.elim
        ((Fact.out : Nat.Prime p).coprime_iff_not_dvd.1 hWHmapCop hdvd)
  have hWHmapBot : WH.map r = ⊥ :=
    (Subgroup.card_eq_one (H := WH.map r)).1 hWHmapCard
  have hWHleD : WH ≤ D := by
    have hleker : WH ≤ r.ker :=
      (Subgroup.map_eq_bot_iff (f := r) (H := WH)).1 hWHmapBot
    simpa [r, QuotientGroup.ker_mk'] using hleker
  have hWHeq : WH = D := le_antisymm hWHleD hDleCore
  exact hWHeq

/-- A finite normal-factor decomposition whose factor abelianizations are
`p`-groups forces the `p'`-core to be generated by the factor derived
subgroups.  In particular, if those derived subgroups are `q`-groups, so is
the `p'`-core. -/
public theorem pPrimeCore_isPGroup_of_generated_factors
    {G : Type u} [Group G] [Finite G]
    {p q : ℕ} [Fact p.Prime] [Fact q.Prime]
    (S : Subgroup G) (F : Finset (Subgroup G))
    (hgen : pPrimeCore p G ⊔ S =
      ⨆ E : {E : Subgroup G // E ∈ F}, (E : Subgroup G))
    (hnorm : ∀ E : Subgroup G, E ∈ F →
      (E.subgroupOf (pPrimeCore p G ⊔ S)).Normal)
    (hderived_le : ∀ E : Subgroup G, E ∈ F →
      ⁅E, E⁆ ≤ pPrimeCore p G)
    (hderived_q : ∀ E : Subgroup G, E ∈ F →
      let H := pPrimeCore p G ⊔ S
      IsPGroup q ((commutator (E.subgroupOf H)).map
        (E.subgroupOf H).subtype))
    (hindex : ∀ E : Subgroup G, E ∈ F →
      let H := pPrimeCore p G ⊔ S
      ∃ n : ℕ, ((commutator (E.subgroupOf H)).map
        (E.subgroupOf H).subtype).relIndex (E.subgroupOf H) = p ^ n) :
    IsPGroup q (pPrimeCore p G) := by
  let H : Subgroup G := pPrimeCore p G ⊔ S
  let DE (E : Subgroup G) : Subgroup H :=
    ⁅E.subgroupOf H, E.subgroupOf H⁆
  have hcore : (pPrimeCore p G).subgroupOf H =
      ⨆ E : {E : Subgroup G // E ∈ F}, DE E :=
    pPrimeCore_subgroupOf_eq_iSup_commutator_of_generated_factors
      S F hgen hnorm hderived_le hindex
  have hDEnormal (E : Subgroup G) (hE_mem : E ∈ F) : (DE E).Normal := by
    let : (E.subgroupOf H).Normal := hnorm E hE_mem
    exact inferInstance
  have hDEq (E : Subgroup G) (hE_mem : E ∈ F) : IsPGroup q (DE E) := by
    have hq := hderived_q E hE_mem
    dsimp only at hq
    rw [Subgroup.map_subtype_commutator] at hq
    simpa only [H, DE] using hq
  have hcoreq : IsPGroup q ((pPrimeCore p G).subgroupOf H) := by
    rw [hcore]
    let instDE (E : {E : Subgroup G // E ∈ F}) : (DE E).Normal :=
      hDEnormal E E.property
    exact Sylow.iSup_of_normal (p := q)
      (fun E : {E : Subgroup G // E ∈ F} => DE E)
      (fun E => hDEq E E.property)
  exact hcoreq.of_equiv
    (Subgroup.subgroupOfEquivOfLe
      (H := pPrimeCore p G) (K := H) le_sup_left)
