/-! # Definitions from BG Section 4 -/

section Main

open scoped FixedPoints

/-- Compatibility form of `primeRank` for the Feit--Thompson development.
The canonical definition uses `Group.rank` directly. -/
public theorem primeRank_eq_sSup_generatorRank
    (q : ℕ) (G : Type*) [Group G] [Finite G] :
    primeRank q G =
      sSup {n : ℕ | ∃ A : Subgroup G,
        IsPGroup q A ∧ IsMulCommutative A ∧ n ≤ generatorRank A} := by
  unfold primeRank
  congr 1
  ext n
  simp only [Set.mem_ofPred_eq]
  constructor
  · rintro ⟨A, hAq, hAcomm, hAfg, hnA⟩
    exact ⟨A, hAq, hAcomm, by simpa [generatorRank_eq_group_rank] using hnA⟩
  · rintro ⟨A, hAq, hAcomm, hnA⟩
    exact ⟨A, hAq, hAcomm, inferInstance,
      by simpa [generatorRank_eq_group_rank] using hnA⟩

/-- The subgroup `mho^n(R)` generated by the `p^n`-th powers in `R`. -/
@[expose] public def mho (p n : ℕ) (R : Type*) [Group R] : Subgroup R :=
  Subgroup.closure (Set.range fun x : R => x ^ (p ^ n))

/-- The set `𝒜(R)` of normal self-centralizing subgroups of `R`. -/
@[expose] public def selfCentralizingAbelianSubgroups (R : Type*) [Group R] : Set (Subgroup R) :=
  { A : Subgroup R | A.Normal ∧ Subgroup.centralizer (A : Set R) = A }

/-- The set `𝒜_n(R)` of members of `𝒜(R)` with generator rank at least `n`. -/
@[expose] public def selfCentralizingAbelianSubgroupsAtLeast (R : Type*) [Group R]
    (n : ℕ) : Set (Subgroup R) :=
  { A : Subgroup R | A ∈ selfCentralizingAbelianSubgroups R ∧ n ≤ generatorRank A }


/-- An internal direct product decomposition of `G` into `H` and `K`. -/
@[expose] public def IsInternalDirectProduct {G : Type*} [Group G] (H K : Subgroup G) : Prop :=
  H.IsComplement' K ∧ ⁅H, K⁆ = ⊥

/-- An internal central product decomposition of `G` into `H` and `K`. -/
@[expose] public def IsCentralProduct {G : Type*} [Group G] (H K : Subgroup G) : Prop :=
  H.Normal ∧ K.Normal ∧ ⁅H, K⁆ = ⊥ ∧ H ⊔ K = ⊤

/-- `p` is the largest prime divisor of `n`. -/
@[expose] public def IsLargestPrimeDivisor (p n : ℕ) : Prop :=
  Nat.Prime p ∧ p ∣ n ∧ ∀ q : ℕ, Nat.Prime q → q ∣ n → q ≤ p

/-- `p` is the smallest prime divisor of `n`. -/
@[expose] public def IsSmallestPrimeDivisor (p n : ℕ) : Prop :=
  Nat.Prime p ∧ p ∣ n ∧ ∀ q : ℕ, Nat.Prime q → q ∣ n → p ≤ q

namespace ChiefFactor

/-- A chief factor is a `p`-factor if its quotient has `p`-power order. -/
@[expose] public def IsPFactor {G : Type*} [Group G] (p : ℕ) (cf : ChiefFactor G) : Prop := by
  letI : (cf.V.subgroupOf cf.U).Normal :=
    Subgroup.Normal.subgroupOf (G := G) (hH := cf.isChief.normal_K) cf.U
  exact IsPGroup p (cf.U ⧸ cf.V.subgroupOf cf.U)

end ChiefFactor

/- A characteristic series whose successive factors are isomorphic to Sylow subgroups of `G`
in increasing prime order. -/
@[expose] public def HasOrderedCharacteristicSylowSeries (G : Type*) [Group G] [Finite G] : Prop :=
  ∃ (n : ℕ) (series : Fin (n + 1) → Subgroup G) (primes : Fin n → ℕ),
    series 0 = ⊤ ∧ series (Fin.last n) = ⊥ ∧
    (∀ i, (series i).Characteristic) ∧
    StrictMono primes ∧
    (∀ i : Fin n,
      series i.succ ≤ series i.castSucc ∧
        ∃ (_ : Fact (primes i).Prime) (P : Sylow (primes i) G)
          (_ : ((series i.succ).subgroupOf (series i.castSucc)).Normal),
          Nonempty
            ((series i.castSucc ⧸ (series i.succ).subgroupOf (series i.castSucc)) ≃*
              ↥(P : Subgroup G)))

end Main
