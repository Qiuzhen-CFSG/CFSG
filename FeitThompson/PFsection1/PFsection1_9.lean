module

public import Theory.Character.GaloisAction

/-!
# Peterfalvi, Section 1, Proposition (1.9)

This file is the Lean target for `PFtest/Blueprint/section1/proposition_1_9.tex`.

The first part is formalized in the standard cyclotomic field
`CyclotomicField (a * b) ℚ`: the subfields generated by `ζ ^ b` and `ζ ^ a`
are the copies of `ℚ_a` and `ℚ_b`, and the desired extension automorphism is
constructed from the Chinese remainder theorem on `(ZMod (a * b))ˣ`.
-/

noncomputable section

open IsCyclotomicExtension
open scoped Cyclotomic

namespace Section1
universe u
universe v

/-! ## Cyclotomic fields and the CRT/Galois bridge -/

@[expose] public noncomputable def cyclotomicLeftSubfield (a b : ℕ) (hn : a * b ≠ 0) :
    IntermediateField ℚ (CyclotomicABField a b) :=
  IntermediateField.adjoin ℚ ({cyclotomicABRoot a b hn ^ b} : Set (CyclotomicABField a b))

@[expose] public noncomputable def cyclotomicRightSubfield (a b : ℕ) (hn : a * b ≠ 0) :
    IntermediateField ℚ (CyclotomicABField a b) :=
  IntermediateField.adjoin ℚ ({cyclotomicABRoot a b hn ^ a} : Set (CyclotomicABField a b))

public instance cyclotomicLeftSubfield_isCyclotomicExtension {a b : ℕ} (hn : a * b ≠ 0) :
    IsCyclotomicExtension {a} ℚ (cyclotomicLeftSubfield a b hn) := by
  have : NeZero (a * b) := ⟨hn⟩
  have : NeZero a := ⟨left_ne_zero_of_mul hn⟩
  have hζ : IsPrimitiveRoot (cyclotomicABRoot a b hn) (a * b) := by
    dsimp [cyclotomicABRoot]
    exact IsCyclotomicExtension.zeta_spec (a * b) ℚ (CyclotomicABField a b)
  have hpos : 0 < a * b := Nat.pos_of_ne_zero hn
  have hζa : IsPrimitiveRoot (cyclotomicABRoot a b hn ^ b) a :=
    hζ.pow hpos (a := b) (b := a) (by rw [mul_comm])
  change IsCyclotomicExtension {a} ℚ (cyclotomicLeftSubfield a b hn).toSubalgebra
  rw [cyclotomicLeftSubfield,
    IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (Algebra.IsAlgebraic.isAlgebraic (cyclotomicABRoot a b hn ^ b))]
  exact hζa.adjoin_isCyclotomicExtension ℚ

public instance cyclotomicRightSubfield_isCyclotomicExtension {a b : ℕ} (hn : a * b ≠ 0) :
    IsCyclotomicExtension {b} ℚ (cyclotomicRightSubfield a b hn) := by
  have : NeZero (a * b) := ⟨hn⟩
  have : NeZero b := ⟨right_ne_zero_of_mul hn⟩
  have hζ : IsPrimitiveRoot (cyclotomicABRoot a b hn) (a * b) := by
    dsimp [cyclotomicABRoot]
    exact IsCyclotomicExtension.zeta_spec (a * b) ℚ (CyclotomicABField a b)
  have hpos : 0 < a * b := Nat.pos_of_ne_zero hn
  have hζb : IsPrimitiveRoot (cyclotomicABRoot a b hn ^ a) b :=
    hζ.pow hpos (a := a) (b := b) rfl
  change IsCyclotomicExtension {b} ℚ (cyclotomicRightSubfield a b hn).toSubalgebra
  rw [cyclotomicRightSubfield,
    IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (Algebra.IsAlgebraic.isAlgebraic (cyclotomicABRoot a b hn ^ a))]
  exact hζb.adjoin_isCyclotomicExtension ℚ

public instance cyclotomicLeftSubfield_normal {a b : ℕ} (hn : a * b ≠ 0) :
    Normal ℚ (cyclotomicLeftSubfield a b hn) := by
  have : IsCyclotomicExtension {a} ℚ (cyclotomicLeftSubfield a b hn) :=
    cyclotomicLeftSubfield_isCyclotomicExtension hn
  have : IsGalois ℚ (cyclotomicLeftSubfield a b hn) :=
    IsCyclotomicExtension.isGalois {a} ℚ (cyclotomicLeftSubfield a b hn)
  infer_instance

public instance cyclotomicRightSubfield_normal {a b : ℕ} (hn : a * b ≠ 0) :
    Normal ℚ (cyclotomicRightSubfield a b hn) := by
  have : IsCyclotomicExtension {b} ℚ (cyclotomicRightSubfield a b hn) :=
    cyclotomicRightSubfield_isCyclotomicExtension hn
  have : IsGalois ℚ (cyclotomicRightSubfield a b hn) :=
    IsCyclotomicExtension.isGalois {b} ℚ (cyclotomicRightSubfield a b hn)
  infer_instance

/--
Peterfalvi (1.9)(a), in a concrete cyclotomic-field model.  If `(a,b)=1`,
then every automorphism of the `ℚ_a` subfield extends to an automorphism of
`ℚ_{ab}` that is trivial on the `ℚ_b` subfield.
-/
public theorem proposition_1_9_a {a b : ℕ} (hn : a * b ≠ 0)
    (hab : a.Coprime b) (u : Gal((cyclotomicLeftSubfield a b hn)/ℚ)) :
    ∃ v : Gal((CyclotomicABField a b)/ℚ),
      AlgEquiv.restrictNormalHom (cyclotomicLeftSubfield a b hn) v = u ∧
      AlgEquiv.restrictNormalHom (cyclotomicRightSubfield a b hn) v = 1 := by
  classical
  have : NeZero (a * b) := ⟨hn⟩
  have : NeZero a := ⟨left_ne_zero_of_mul hn⟩
  have : NeZero b := ⟨right_ne_zero_of_mul hn⟩
  let K := CyclotomicABField a b
  let Fa := cyclotomicLeftSubfield a b hn
  let Fb := cyclotomicRightSubfield a b hn
  have : IsCyclotomicExtension {a} ℚ Fa := cyclotomicLeftSubfield_isCyclotomicExtension hn
  have : IsCyclotomicExtension {b} ℚ Fb := cyclotomicRightSubfield_isCyclotomicExtension hn
  have : IsGalois ℚ Fa := IsCyclotomicExtension.isGalois {a} ℚ Fa
  have : IsGalois ℚ Fb := IsCyclotomicExtension.isGalois {b} ℚ Fb
  let ua : (ZMod a)ˣ := IsCyclotomicExtension.Rat.galEquivZMod a Fa u
  obtain ⟨w, hwa, hwb⟩ := zmod_units_crt_exists_of_coprime hab ua
  let v : Gal(K/ℚ) := (IsCyclotomicExtension.Rat.galEquivZMod (a * b) K).symm w
  have hvw : IsCyclotomicExtension.Rat.galEquivZMod (a * b) K v = w := by
    dsimp [v]
    exact MulEquiv.apply_symm_apply (IsCyclotomicExtension.Rat.galEquivZMod (a * b) K) w
  refine ⟨v, ?_, ?_⟩
  · apply (IsCyclotomicExtension.Rat.galEquivZMod a Fa).injective
    have hrest := IsCyclotomicExtension.Rat.galEquivZMod_restrictNormal_apply
      (n := a * b) (m := a) (K := K) (F := Fa) (Nat.dvd_mul_right a b) v
    have hrest' : IsCyclotomicExtension.Rat.galEquivZMod a Fa
        ((AlgEquiv.restrictNormalHom Fa) v) =
        ZMod.unitsMap (Nat.dvd_mul_right a b)
          (IsCyclotomicExtension.Rat.galEquivZMod (a * b) K v) := by
      simpa [AlgEquiv.restrictNormalHom] using hrest
    calc
      IsCyclotomicExtension.Rat.galEquivZMod a Fa ((AlgEquiv.restrictNormalHom Fa) v)
          = ZMod.unitsMap (Nat.dvd_mul_right a b)
              (IsCyclotomicExtension.Rat.galEquivZMod (a * b) K v) := hrest'
      _ = IsCyclotomicExtension.Rat.galEquivZMod a Fa u := by
          rw [hvw, hwa]
  · apply (IsCyclotomicExtension.Rat.galEquivZMod b Fb).injective
    have hrest := IsCyclotomicExtension.Rat.galEquivZMod_restrictNormal_apply
      (n := a * b) (m := b) (K := K) (F := Fb) (Nat.dvd_mul_left b a) v
    have hrest' : IsCyclotomicExtension.Rat.galEquivZMod b Fb
        ((AlgEquiv.restrictNormalHom Fb) v) =
        ZMod.unitsMap (Nat.dvd_mul_left b a)
          (IsCyclotomicExtension.Rat.galEquivZMod (a * b) K v) := by
      simpa [AlgEquiv.restrictNormalHom] using hrest
    calc
      IsCyclotomicExtension.Rat.galEquivZMod b Fb ((AlgEquiv.restrictNormalHom Fb) v)
          = ZMod.unitsMap (Nat.dvd_mul_left b a)
              (IsCyclotomicExtension.Rat.galEquivZMod (a * b) K v) := hrest'
      _ = 1 := by rw [hvw, hwb]
      _ = IsCyclotomicExtension.Rat.galEquivZMod b Fb (1 : Gal(Fb/ℚ)) := by simp


/--
The automorphism existence in Peterfalvi (1.9)(b), with the book's integer
exponent `k ∈ ℤ`.
-/
public theorem proposition_1_9_b_galois_automorphism_int {a b : ℕ} {k : ℤ}
    [NeZero a] (hn : a * b ≠ 0) (hab : a.Coprime b)
    (hk : IsCoprime k (a : ℤ)) :
    ∃ v : Gal((CyclotomicABField a b)/ℚ),
      IsCyclotomicExtension.Rat.galEquivZMod a (cyclotomicLeftSubfield a b hn)
        ((AlgEquiv.restrictNormalHom (cyclotomicLeftSubfield a b hn)) v) =
          ZMod.unitOfIsCoprime k hk ∧
      AlgEquiv.restrictNormalHom (cyclotomicRightSubfield a b hn) v = 1 := by
  classical
  have : IsCyclotomicExtension {a} ℚ (cyclotomicLeftSubfield a b hn) :=
    cyclotomicLeftSubfield_isCyclotomicExtension hn
  have : IsGalois ℚ (cyclotomicLeftSubfield a b hn) :=
    IsCyclotomicExtension.isGalois {a} ℚ (cyclotomicLeftSubfield a b hn)
  let u : Gal((cyclotomicLeftSubfield a b hn)/ℚ) :=
    (IsCyclotomicExtension.Rat.galEquivZMod a (cyclotomicLeftSubfield a b hn)).symm
      (ZMod.unitOfIsCoprime k hk)
  obtain ⟨v, hv_left, hv_right⟩ := proposition_1_9_a hn hab u
  refine ⟨v, ?_, hv_right⟩
  rw [hv_left]
  exact MulEquiv.apply_symm_apply
    (IsCyclotomicExtension.Rat.galEquivZMod a (cyclotomicLeftSubfield a b hn))
    (ZMod.unitOfIsCoprime k hk)

/--
Integer-exponent form of the character-value calculation in Peterfalvi
(1.9)(b).  The book states the exponent as `k ∈ ℤ`; this version keeps that
integer exponent in the displayed formula, while the cyclotomic automorphism is
still represented by a natural CRT exponent `e`.
-/
public theorem proposition_1_9_b_trace_zpow
    {G V : Type*} [Group G] [Finite G]
    [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    {a b e : ℕ} {k : ℤ} (hcard : Nat.card G = a * b)
    (hea : (e : ℤ) ≡ k [ZMOD a])
    (heb : (e : ℤ) ≡ (1 : ℤ) [ZMOD b])
    (ρ : Representation ℂ G V) :
    (∀ g : G, orderOf g ∣ a →
      characterGaloisConjugateByExponent ρ e g = ρ.character (g ^ k)) ∧
    (∀ g : G, (orderOf g).Coprime a →
      characterGaloisConjugateByExponent ρ e g = ρ.character g) := by
  constructor
  · intro g hg
    have hdvd : (orderOf g : ℤ) ∣ (a : ℤ) := by
      exact_mod_cast hg
    have hmod : (e : ℤ) ≡ k [ZMOD orderOf g] := Int.ModEq.of_dvd hdvd hea
    have hpow : g ^ e = g ^ k := by
      rw [← zpow_natCast, zpow_eq_zpow_iff_modEq]
      exact hmod
    simp [characterGaloisConjugateByExponent, hpow]
  · intro g hg
    have horder_card : orderOf g ∣ Nat.card G := orderOf_dvd_natCard g
    have horder_ab : orderOf g ∣ a * b := by
      simpa [hcard] using horder_card
    have horder_b : orderOf g ∣ b := by
      have horder_ba : orderOf g ∣ b * a := by
        simpa [mul_comm] using horder_ab
      exact hg.dvd_of_dvd_mul_right horder_ba
    have hdvd : (orderOf g : ℤ) ∣ (b : ℤ) := by
      exact_mod_cast horder_b
    have hmod : (e : ℤ) ≡ (1 : ℤ) [ZMOD orderOf g] := Int.ModEq.of_dvd hdvd heb
    have hpow : g ^ e = g := by
      calc
        g ^ e = g ^ (1 : ℤ) := by
          rw [← zpow_natCast, zpow_eq_zpow_iff_modEq]
          exact hmod
        _ = g := by simp
    simp [characterGaloisConjugateByExponent, hpow]


/-- If a finite group has order `a * b`, then this product is nonzero. -/
public theorem nat_card_factor_ne_zero
    {G : Type*} [Group G] [Finite G] {a b : ℕ} (hcard : Nat.card G = a * b) :
    a * b ≠ 0 := by
  have hpos : 0 < a * b := by
    simp [← hcard]
  exact hpos.ne'


@[expose] public def proposition_1_9_b_galoisCondition_int
    {G : Type*} [Group G] [Finite G] {a b : ℕ} {k : ℤ}
    (hcard : Nat.card G = a * b) (hk : IsCoprime k (a : ℤ))
    (v : Gal((CyclotomicABField a b)/ℚ)) : Prop :=
  let hn : a * b ≠ 0 := nat_card_factor_ne_zero (G := G) hcard
  let : NeZero a := ⟨left_ne_zero_of_mul hn⟩
  IsCyclotomicExtension.Rat.galEquivZMod a (cyclotomicLeftSubfield a b hn)
      ((AlgEquiv.restrictNormalHom (cyclotomicLeftSubfield a b hn)) v) =
        ZMod.unitOfIsCoprime k hk ∧
    AlgEquiv.restrictNormalHom (cyclotomicRightSubfield a b hn) v = 1


end Section1
