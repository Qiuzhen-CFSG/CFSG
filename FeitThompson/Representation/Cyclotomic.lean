/-!
# Elementary cyclotomic-order congruences

This file contains the small amount of cyclotomic-integer infrastructure used
by Peterfalvi, Proposition (1.10).  The order `ℤ[η]` is modeled as the subring
of `ℂ` generated by `η`, and congruence modulo `1 - ξ` is ideal membership in
that order.

The statements deliberately stay at the unbundled level: no `Rep`, no `FDRep`,
and no categorical representation theory is used here.
-/

noncomputable section

open scoped BigOperators
open Polynomial

namespace Representation

/-! ## The order `ℤ[η]` and congruence in it -/

/-- The order `ℤ[η]` inside `ℂ`, modeled as the subring generated by `η`. -/
@[expose] public def cyclotomicOrder (η : ℂ) : Subring ℂ :=
  Subring.closure ({η} : Set ℂ)

/-- A complex number belongs to `ℤ[η]`. -/
@[expose] public def IsInCyclotomicOrder (η z : ℂ) : Prop :=
  z ∈ cyclotomicOrder η

/-- The generator `η` belongs to `ℤ[η]`. -/
public lemma eta_mem_cyclotomicOrder (η : ℂ) :
    η ∈ cyclotomicOrder η :=
  Subring.subset_closure (by simp)

/-- Integers belong to every cyclotomic order. -/
public lemma intCast_mem_cyclotomicOrder (η : ℂ) (n : ℤ) :
    (n : ℂ) ∈ cyclotomicOrder η := by
  exact intCast_mem (cyclotomicOrder η) n

/-- Natural numbers belong to every cyclotomic order. -/
public lemma natCast_mem_cyclotomicOrder (η : ℂ) (n : ℕ) :
    (n : ℂ) ∈ cyclotomicOrder η := by
  exact natCast_mem (cyclotomicOrder η) n

/-- Powers of an element of `ℤ[η]` still belong to `ℤ[η]`. -/
public lemma pow_mem_cyclotomicOrder {η z : ℂ}
    (hz : z ∈ cyclotomicOrder η) (n : ℕ) :
    z ^ n ∈ cyclotomicOrder η :=
  (cyclotomicOrder η).pow_mem hz n

/--
If `η` is a primitive `m`-th root and `ξ` is an `n`-th root with `n ∣ m`,
then `ξ` belongs to `ℤ[η]`.
-/
public lemma root_mem_cyclotomicOrder_of_pow_eq_one_of_dvd
    {m n : ℕ} {η ξ : ℂ} (hη : IsPrimitiveRoot η m) (hm : m ≠ 0)
    (hξ : ξ ^ n = 1) (hnm : n ∣ m) :
    ξ ∈ cyclotomicOrder η := by
  have hξm : ξ ^ m = 1 := by
    rcases hnm with ⟨k, rfl⟩
    rw [pow_mul, hξ, one_pow]
  haveI : NeZero m := ⟨hm⟩
  obtain ⟨i, _hi_lt, hi⟩ := hη.eq_pow_of_pow_eq_one hξm
  rw [← hi]
  exact pow_mem_cyclotomicOrder (eta_mem_cyclotomicOrder η) i

/--
If the order of `ξ` divides the order of a primitive root `η`, then `ξ ∈ ℤ[η]`.
-/
public lemma primitive_root_mem_cyclotomicOrder_of_dvd
    {m n : ℕ} {η ξ : ℂ} (hη : IsPrimitiveRoot η m) (hm : m ≠ 0)
    (hξ : IsPrimitiveRoot ξ n) (hnm : n ∣ m) :
    ξ ∈ cyclotomicOrder η :=
  root_mem_cyclotomicOrder_of_pow_eq_one_of_dvd hη hm hξ.pow_eq_one hnm

/-- Elements of `ℤ[η]` are exactly values at `η` of integer polynomials. -/
public theorem mem_cyclotomicOrder_iff_exists_intPolynomial_eval {η z : ℂ} :
    z ∈ cyclotomicOrder η ↔
      ∃ P : ℤ[X], Polynomial.eval₂ (Int.castRingHom ℂ) η P = z := by
  constructor
  · intro hz
    induction hz using Subring.closure_induction with
    | mem x hx =>
        rw [Set.mem_singleton_iff] at hx
        refine ⟨X, ?_⟩
        simp [hx]
    | zero =>
        refine ⟨0, ?_⟩
        simp
    | one =>
        refine ⟨1, ?_⟩
        simp
    | add x y hx hy hxP hyP =>
        rcases hxP with ⟨P, rfl⟩
        rcases hyP with ⟨Q, rfl⟩
        refine ⟨P + Q, ?_⟩
        simp
    | neg x hx hxP =>
        rcases hxP with ⟨P, rfl⟩
        refine ⟨-P, ?_⟩
        simp
    | mul x y hx hy hxP hyP =>
        rcases hxP with ⟨P, rfl⟩
        rcases hyP with ⟨Q, rfl⟩
        refine ⟨P * Q, ?_⟩
        simp
  · rintro ⟨P, rfl⟩
    let A := cyclotomicOrder η
    let ηA : A := ⟨η, eta_mem_cyclotomicOrder η⟩
    have hmem : ((Polynomial.eval₂ (Int.castRingHom A) ηA P : A) : ℂ) ∈ A :=
      (Polynomial.eval₂ (Int.castRingHom A) ηA P).2
    convert hmem using 1
    exact (Polynomial.ringHom_eval₂_intCastRingHom P (cyclotomicOrder η).subtype ηA).symm

/-- Congruence modulo an element of a subring, expressed by a principal ideal. -/
@[expose] public def congruentModIn (A : Subring ℂ) (a z w : A) : Prop :=
  z - w ∈ Ideal.span ({a} : Set A)

/-- Divisibility form of congruence modulo one element. -/
public lemma congruentModIn_iff_dvd (A : Subring ℂ) (a z w : A) :
    congruentModIn A a z w ↔ a ∣ z - w := by
  exact Ideal.mem_span_singleton

/-- Reflexivity of congruence modulo one element. -/
public lemma congruentModIn_refl (A : Subring ℂ) (a z : A) :
    congruentModIn A a z z := by
  rw [congruentModIn, sub_self]
  exact Ideal.zero_mem _

/-- Congruence modulo one element is closed under addition. -/
public lemma congruentModIn_add {A : Subring ℂ} {a z₁ w₁ z₂ w₂ : A}
    (h₁ : congruentModIn A a z₁ w₁) (h₂ : congruentModIn A a z₂ w₂) :
    congruentModIn A a (z₁ + z₂) (w₁ + w₂) := by
  change (z₁ + z₂) - (w₁ + w₂) ∈ Ideal.span ({a} : Set A)
  convert Ideal.add_mem _ h₁ h₂ using 1
  abel

/-- Congruence modulo one element is closed under negation. -/
public lemma congruentModIn_neg {A : Subring ℂ} {a z w : A}
    (h : congruentModIn A a z w) :
    congruentModIn A a (-z) (-w) := by
  change (-z) - (-w) ∈ Ideal.span ({a} : Set A)
  convert neg_mem h using 1
  abel

/-- Congruence modulo one element is closed under subtraction. -/
public lemma congruentModIn_sub {A : Subring ℂ} {a z₁ w₁ z₂ w₂ : A}
    (h₁ : congruentModIn A a z₁ w₁) (h₂ : congruentModIn A a z₂ w₂) :
    congruentModIn A a (z₁ - z₂) (w₁ - w₂) := by
  simpa [sub_eq_add_neg] using congruentModIn_add h₁ (congruentModIn_neg h₂)

/-- Congruence modulo one element is closed under left multiplication. -/
public lemma congruentModIn_mul_left {A : Subring ℂ} {a z w : A}
    (h : congruentModIn A a z w) (t : A) :
    congruentModIn A a (t * z) (t * w) := by
  change t * z - t * w ∈ Ideal.span ({a} : Set A)
  convert Ideal.mul_mem_left _ t h using 1
  ring

/-- Congruence modulo one element is closed under right multiplication. -/
public lemma congruentModIn_mul_right {A : Subring ℂ} {a z w : A}
    (h : congruentModIn A a z w) (t : A) :
    congruentModIn A a (z * t) (w * t) := by
  change z * t - w * t ∈ Ideal.span ({a} : Set A)
  convert Ideal.mul_mem_right t _ h using 1
  ring

/-- The order-valued element represented by an integer. -/
@[expose] public def cyclotomicInt (η : ℂ) (n : ℤ) : cyclotomicOrder η :=
  ⟨(n : ℂ), intCast_mem_cyclotomicOrder η n⟩

/-- The order-valued element represented by a natural number. -/
@[expose] public def cyclotomicNat (η : ℂ) (n : ℕ) : cyclotomicOrder η :=
  ⟨(n : ℂ), natCast_mem_cyclotomicOrder η n⟩

/-- Congruence modulo `1 - ξ` in `ℤ[η]`, with all membership witnesses explicit. -/
@[expose] public def CongruentModOneSub
  (η ξ z w : ℂ) (hξ : ξ ∈ cyclotomicOrder η)
  (hz : z ∈ cyclotomicOrder η) (hw : w ∈ cyclotomicOrder η) : Prop :=
  congruentModIn (cyclotomicOrder η)
    (⟨1 - ξ, (cyclotomicOrder η).sub_mem ((cyclotomicOrder η).one_mem) hξ⟩)
    ⟨z, hz⟩ ⟨w, hw⟩

/-! ## The elementary congruence `ξ^k ≡ 1 (mod 1 - ξ)` -/

/-- If `ξ ∈ ℤ[η]`, then every power of `ξ` is congruent to `1` modulo `1 - ξ`. -/
public lemma pow_congruent_one_mod_one_sub
    {η ξ : ℂ} (hξ : ξ ∈ cyclotomicOrder η) (k : ℕ) :
    CongruentModOneSub η ξ (ξ ^ k) 1 hξ
      ((cyclotomicOrder η).pow_mem hξ k) ((cyclotomicOrder η).one_mem) := by
  let A := cyclotomicOrder η
  let ξA : A := ⟨ξ, hξ⟩
  change congruentModIn A (⟨1 - ξ, A.sub_mem A.one_mem hξ⟩ : A)
    (⟨ξ ^ k, A.pow_mem hξ k⟩ : A) (1 : A)
  rw [congruentModIn_iff_dvd]
  refine ⟨-((∑ i ∈ Finset.range k, ξA ^ i)), ?_⟩
  have hsum_coe :
      ((∑ i ∈ Finset.range k, ξA ^ i : A) : ℂ) =
        ∑ i ∈ Finset.range k, ξ ^ i := by
    simp [ξA]
  ext
  simp only [Subring.coe_mul, Subring.coe_neg]
  rw [hsum_coe]
  calc
    ξ ^ k - 1 = (∑ i ∈ Finset.range k, ξ ^ i) * (ξ - 1) := by
      exact (geom_sum_mul ξ k).symm
    _ = (1 - ξ) * -(∑ i ∈ Finset.range k, ξ ^ i) := by ring

/-- Multiplying a value in `ℤ[η]` preserves `ξ^k y ≡ y` modulo `1 - ξ`. -/
public lemma pow_mul_congruent_right_mod_one_sub
    {η ξ y : ℂ} (hξ : ξ ∈ cyclotomicOrder η) (hy : y ∈ cyclotomicOrder η) (k : ℕ) :
    CongruentModOneSub η ξ (ξ ^ k * y) y hξ
      ((cyclotomicOrder η).mul_mem ((cyclotomicOrder η).pow_mem hξ k) hy) hy := by
  let A := cyclotomicOrder η
  let yA : A := ⟨y, hy⟩
  have hpow := pow_congruent_one_mod_one_sub (η := η) hξ k
  change congruentModIn A (⟨1 - ξ, A.sub_mem A.one_mem hξ⟩ : A)
    (⟨ξ ^ k * y, A.mul_mem (A.pow_mem hξ k) hy⟩ : A) ⟨y, hy⟩
  have hmul := congruentModIn_mul_right hpow yA
  simpa [CongruentModOneSub, yA] using hmul

/-! ## Integer linear combinations of linear constituents -/

/-- A finite integer linear combination of functions. -/
@[expose] public noncomputable def integerLinearCombination
    {G ι : Type*} [Fintype ι] (m : ι → ℤ) (α : ι → G → ℂ) : G → ℂ :=
  fun g => ∑ i : ι, (m i : ℂ) * α i g

/--
The data used from a virtual character in the proof of Proposition (1.10)(a):
after restricting to the abelian subgroup generated by commuting `x` and `y`,
the virtual character is an integer linear combination of linear constituents,
each of whose value on `x` is a power of the fixed primitive root `ξ`.
-/
@[expose] public def IsCyclotomicVirtualCharacterAt
    {G ι : Type*} [Fintype ι] [Mul G]
    (η ξ : ℂ) (x y : G) (χ : G → ℂ) (m : ι → ℤ) (α : ι → G → ℂ) : Prop :=
  ∃ exponent : ι → ℕ,
    χ = integerLinearCombination m α ∧
    ξ ∈ cyclotomicOrder η ∧
    (∀ i, α i y ∈ cyclotomicOrder η) ∧
    (∀ i, α i x = ξ ^ exponent i) ∧
    (∀ i, α i (x * y) = α i x * α i y)

public theorem isCyclotomicVirtualCharacterAt_iff
    {G ι : Type*} [Fintype ι] [Mul G]
    {η ξ : ℂ} {x y : G} {χ : G → ℂ} {m : ι → ℤ} {α : ι → G → ℂ} :
    IsCyclotomicVirtualCharacterAt η ξ x y χ m α ↔
      ∃ exponent : ι → ℕ,
        χ = integerLinearCombination m α ∧
        ξ ∈ cyclotomicOrder η ∧
        (∀ i, α i y ∈ cyclotomicOrder η) ∧
        (∀ i, α i x = ξ ^ exponent i) ∧
        (∀ i, α i (x * y) = α i x * α i y) :=
  Iff.rfl

public lemma IsCyclotomicVirtualCharacterAt.xi_mem
    {G ι : Type*} [Fintype ι] [Mul G]
    {η ξ : ℂ} {x y : G} {χ : G → ℂ} {m : ι → ℤ} {α : ι → G → ℂ}
    (hχ : IsCyclotomicVirtualCharacterAt η ξ x y χ m α) :
    ξ ∈ cyclotomicOrder η := by
  rcases hχ with ⟨exponent, hχeq, hξ, hval, hxval, hmul⟩
  exact hξ

/-- Values of such a virtual character at `y` lie in `ℤ[η]`. -/
public lemma IsCyclotomicVirtualCharacterAt.value_y_mem
    {G ι : Type*} [Fintype ι] [Mul G]
    {η ξ : ℂ} {x y : G} {χ : G → ℂ} {m : ι → ℤ} {α : ι → G → ℂ}
    (hχ : IsCyclotomicVirtualCharacterAt η ξ x y χ m α) :
    χ y ∈ cyclotomicOrder η := by
  classical
  rcases hχ with ⟨exponent, hχeq, hξ, hval, hxval, hmul⟩
  rw [hχeq]
  exact (cyclotomicOrder η).sum_mem fun i _ =>
    (cyclotomicOrder η).mul_mem (intCast_mem_cyclotomicOrder η (m i)) (hval i)

/-- Values of such a virtual character at `xy` lie in `ℤ[η]`. -/
public lemma IsCyclotomicVirtualCharacterAt.value_xy_mem
    {G ι : Type*} [Fintype ι] [Mul G]
    {η ξ : ℂ} {x y : G} {χ : G → ℂ} {m : ι → ℤ} {α : ι → G → ℂ}
    (hχ : IsCyclotomicVirtualCharacterAt η ξ x y χ m α) :
    χ (x * y) ∈ cyclotomicOrder η := by
  classical
  rcases hχ with ⟨exponent, hχeq, hξ, hval, hxval, hmul⟩
  rw [hχeq]
  refine (cyclotomicOrder η).sum_mem fun i _ => ?_
  rw [hmul i, hxval i]
  exact (cyclotomicOrder η).mul_mem (intCast_mem_cyclotomicOrder η (m i))
    ((cyclotomicOrder η).mul_mem ((cyclotomicOrder η).pow_mem hξ (exponent i))
      (hval i))

/--
Virtual-character congruence from Proposition (1.10)(a), in the exact form
used by the proof: an integer linear combination of linear constituents
satisfying `αᵢ(xy)=αᵢ(x)αᵢ(y)` and `αᵢ(x)=ξ^k` has equal values at `xy` and
`y` modulo `1 - ξ` in `ℤ[η]`.
-/
public theorem virtual_character_congruent_at_mul
    {G ι : Type*} [Fintype ι] [Mul G]
    {η ξ : ℂ} {x y : G} {χ : G → ℂ} {m : ι → ℤ} {α : ι → G → ℂ}
    (hχ : IsCyclotomicVirtualCharacterAt η ξ x y χ m α) :
    CongruentModOneSub η ξ (χ (x * y)) (χ y) hχ.xi_mem
      hχ.value_xy_mem hχ.value_y_mem := by
  classical
  rcases hχ with ⟨exponent, hχeq, hξ, hval, hxval, hmul⟩
  let A := cyclotomicOrder η
  have hxy_mem :
      χ (x * y) ∈ A := by
    rw [hχeq]
    refine A.sum_mem fun i _ => ?_
    rw [hmul i, hxval i]
    exact A.mul_mem (intCast_mem_cyclotomicOrder η (m i))
      (A.mul_mem (A.pow_mem hξ (exponent i)) (hval i))
  have hy_mem :
      χ y ∈ A := by
    rw [hχeq]
    exact A.sum_mem fun i _ =>
      A.mul_mem (intCast_mem_cyclotomicOrder η (m i)) (hval i)
  change congruentModIn A (⟨1 - ξ, A.sub_mem A.one_mem hξ⟩ : A)
    (⟨χ (x * y), hxy_mem⟩ : A) (⟨χ y, hy_mem⟩ : A)
  let zterm : ι → A := fun i =>
    ⟨(m i : ℂ) * α i (x * y),
      A.mul_mem (intCast_mem_cyclotomicOrder η (m i)) (by
        rw [hmul i, hxval i]
        exact A.mul_mem (A.pow_mem hξ (exponent i)) (hval i))⟩
  let wterm : ι → A := fun i =>
    ⟨(m i : ℂ) * α i y,
      A.mul_mem (intCast_mem_cyclotomicOrder η (m i)) (hval i)⟩
  unfold congruentModIn
  have hdiff :
      (⟨χ (x * y), hxy_mem⟩ : A) - ⟨χ y, hy_mem⟩ =
        ∑ i : ι, (zterm i - wterm i) := by
    ext
    simp [zterm, wterm, hχeq, integerLinearCombination, Finset.sum_sub_distrib]
  rw [hdiff]
  refine Ideal.sum_mem _ fun i _ => ?_
  have hterm :
      congruentModIn A (⟨1 - ξ, A.sub_mem A.one_mem hξ⟩ : A)
        (zterm i) (wterm i) := by
    have hbase := pow_mul_congruent_right_mod_one_sub
      (η := η) (ξ := ξ) (y := α i y) hξ (hval i) (exponent i)
    change congruentModIn A (⟨1 - ξ, A.sub_mem A.one_mem hξ⟩ : A)
      (zterm i) (wterm i)
    have hmul_left := congruentModIn_mul_left hbase
      (⟨(m i : ℂ), intCast_mem_cyclotomicOrder η (m i)⟩ : A)
    simpa [zterm, wterm, hmul i, hxval i, mul_assoc] using hmul_left
  exact hterm

/-! ## Isaacs-style rational-integer descent -/

/--
Isaacs Lemma 3.2 core form: if a complex number is both rational and integral
over `ℤ`, then it is an integer.
-/
public theorem isaacs_lemma_3_2_core {z : ℂ}
    (hzint : IsIntegral ℤ z) (hzrat : ∃ q : ℚ, z = (q : ℂ)) :
    ∃ n : ℤ, z = (n : ℂ) := by
  exact hzint.exists_int_iff_exists_rat.mp hzrat

/--
If a rational quotient of integers is integral over `ℤ`, then the quotient is
an integer.  This is the divisibility-descent form used below.
-/
public theorem integer_division_of_integral_quotient
    {a b : ℤ} (hb : b ≠ 0) (h : IsIntegral ℤ ((a : ℂ) / (b : ℂ))) :
    b ∣ a := by
  have hrat : ∃ q : ℚ, ((a : ℂ) / (b : ℂ)) = (q : ℂ) := by
    refine ⟨(a : ℚ) / (b : ℚ), ?_⟩
    norm_num
  obtain ⟨k, hk⟩ := isaacs_lemma_3_2_core h hrat
  have hbℂ : (b : ℂ) ≠ 0 := by exact_mod_cast hb
  have hcast : (a : ℂ) = (b * k : ℤ) := by
    calc
      (a : ℂ) = ((a : ℂ) / (b : ℂ)) * (b : ℂ) := by field_simp [hbℂ]
      _ = (k : ℂ) * (b : ℂ) := by rw [hk]
      _ = (b * k : ℤ) := by norm_num [mul_comm]
  exact ⟨k, by exact_mod_cast hcast⟩

/--
Isaacs Corollary 3.5 core form: divisibility of rational integers detected by
an integral quotient in `ℂ` descends to ordinary divisibility in `ℤ`.
-/
public theorem isaacs_corollary_3_5_core
    {a b : ℤ} (hb : b ≠ 0) (h : IsIntegral ℤ ((a : ℂ) / (b : ℂ))) :
    b ∣ a :=
  integer_division_of_integral_quotient hb h

/-! ## Proposition (1.10)(b) core -/

private lemma int_dvd_of_nat_dvd_abs {p : ℕ} {n : ℤ} (h : p ∣ n.natAbs) :
    (p : ℤ) ∣ n := by
  obtain ⟨k, hk⟩ := h
  obtain ⟨m, rfl | rfl⟩ := n.eq_nat_or_neg
  · rw [Int.natAbs_natCast] at hk
    exact ⟨k, by exact_mod_cast hk⟩
  · rw [Int.natAbs_neg, Int.natAbs_natCast] at hk
    exact ⟨-(k : ℤ), by simp [hk]⟩

private lemma nat_dvd_abs_of_int_dvd {p : ℕ} {n : ℤ} (h : (p : ℤ) ∣ n) :
    p ∣ n.natAbs := by
  obtain ⟨k, hk⟩ := h
  refine ⟨k.natAbs, ?_⟩
  have := congrArg Int.natAbs hk
  simpa [Int.natAbs_mul, mul_comm] using this

/--
The part of Proposition (1.10)(b) that only uses the cyclotomic product
formula and rational-integer descent: if `n ^ (p - 1) / p` is integral, then
`p ∣ n`.
-/
public theorem prime_dvd_int_of_integral_power_quotient
    {p : ℕ} (hp : Nat.Prime p) (n : ℤ)
    (hquot : IsIntegral ℤ (((n ^ (p - 1) : ℤ) : ℂ) / (p : ℂ))) :
    (p : ℤ) ∣ n := by
  have hpz_ne : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have hpdvd_pow_int : (p : ℤ) ∣ (n ^ (p - 1) : ℤ) :=
    isaacs_corollary_3_5_core hpz_ne hquot
  have hpdvd_pow_nat : p ∣ n.natAbs ^ (p - 1) := by
    have hnat := nat_dvd_abs_of_int_dvd hpdvd_pow_int
    simpa [Int.natAbs_pow] using hnat
  have hpdvd_abs : p ∣ n.natAbs :=
    hp.dvd_of_dvd_pow hpdvd_pow_nat
  exact int_dvd_of_nat_dvd_abs hpdvd_abs

/--
Product formula in the order generated by a primitive `p`-th root: the rational
integer `p` equals the product of the elements `1 - ξ^k`, `1 ≤ k < p`.
-/
public theorem primitive_root_prod_one_sub_pow_eq_prime
    {p : ℕ} {ξ : ℂ} (hp : Nat.Prime p) (hξ : IsPrimitiveRoot ξ p) :
    (∏ k ∈ Finset.range (p - 1), (1 - ξ ^ (k + 1))) = (p : ℂ) := by
  have hp_pos : 0 < p := hp.pos
  have hp_pred : p - 1 + 1 = p := Nat.sub_one_add_one hp_pos.ne'
  have hmain := IsPrimitiveRoot.prod_one_sub_pow_eq_order
      (R := ℂ) (n := p - 1) (μ := ξ) (by simpa [hp_pred] using hξ)
  rw [Nat.cast_pred hp_pos] at hmain
  simpa using hmain

/-! ## Congruence modulo `1 - ξ` and rational-prime divisibility -/

private lemma polynomial_eval₂_intCast_subtype
    {η : ℂ} (P : ℤ[X]) :
    ((Polynomial.eval₂ (Int.castRingHom (cyclotomicOrder η))
        (⟨η, eta_mem_cyclotomicOrder η⟩ : cyclotomicOrder η) P : cyclotomicOrder η) : ℂ) =
      Polynomial.eval₂ (Int.castRingHom ℂ) η P := by
  exact Polynomial.ringHom_eval₂_intCastRingHom P (cyclotomicOrder η).subtype
    (⟨η, eta_mem_cyclotomicOrder η⟩ : cyclotomicOrder η)

private lemma exists_intPolynomial_eval_eq_of_mem_cyclotomicOrder
    {η z : ℂ} (hz : z ∈ cyclotomicOrder η) :
    ∃ P : ℤ[X], Polynomial.eval₂ (Int.castRingHom ℂ) η P = z :=
  mem_cyclotomicOrder_iff_exists_intPolynomial_eval.mp hz

private lemma eval₂_one_one_sub_X_mul (P : ℤ[X]) (n : ℤ) :
    Polynomial.eval₂ (Int.castRingHom ℤ) (1 : ℤ)
      (Polynomial.C n - (1 - Polynomial.X) * P) = n := by
  simp

private lemma eval₂_intCast_polynomial_intCast_complex (ξ : ℂ) (n : ℤ) :
    Polynomial.eval₂ (Int.castRingHom ℂ) ξ (n : ℤ[X]) = (n : ℂ) := by
  rw [show (n : ℤ[X]) = Polynomial.C n by
    exact (Polynomial.C_eq_intCast (R := ℤ) n).symm]
  rw [Polynomial.eval₂_C]
  rfl

private lemma eval₂_cyclotomic_prime_one_int (p : ℕ) [Fact p.Prime] :
    Polynomial.eval₂ (Int.castRingHom ℤ) (1 : ℤ) (cyclotomic p ℤ) = (p : ℤ) := by
  simp

private lemma int_dvd_of_cyclotomic_dvd_one_sub_X_polynomial
    {p : ℕ} [Fact p.Prime] {P : ℤ[X]} {n : ℤ}
    (hdiv : cyclotomic p ℤ ∣ Polynomial.C n - (1 - Polynomial.X) * P) :
    (p : ℤ) ∣ n := by
  obtain ⟨Q, hQ⟩ := hdiv
  refine ⟨Polynomial.eval₂ (Int.castRingHom ℤ) (1 : ℤ) Q, ?_⟩
  calc
    n = Polynomial.eval₂ (Int.castRingHom ℤ) (1 : ℤ)
        (Polynomial.C n - (1 - Polynomial.X) * P) := by
      rw [eval₂_one_one_sub_X_mul]
    _ = Polynomial.eval₂ (Int.castRingHom ℤ) (1 : ℤ) (cyclotomic p ℤ * Q) := by
      rw [hQ]
    _ = (p : ℤ) * Polynomial.eval₂ (Int.castRingHom ℤ) (1 : ℤ) Q := by
      rw [Polynomial.eval₂_mul, eval₂_cyclotomic_prime_one_int]

private lemma aeval_eq_eval₂_intCast_complex (ξ : ℂ) (P : ℤ[X]) :
    Polynomial.aeval ξ P = Polynomial.eval₂ (Int.castRingHom ℂ) ξ P := rfl

/--
Isaacs Corollary 3.5 in the cyclotomic form used by Proposition (1.10):
if a rational integer `n` is congruent to `0` modulo `1 - ξ` in `ℤ[ξ]`,
where `ξ` is a primitive `p`-th root for a rational prime `p`, then `p ∣ n`.
-/
public theorem prime_dvd_int_of_congruent_zero_mod_one_sub_self
    {p : ℕ} {ξ : ℂ} (hp : Nat.Prime p) (hξ : IsPrimitiveRoot ξ p) (n : ℤ)
    (hcong : CongruentModOneSub ξ ξ (n : ℂ) 0
      (eta_mem_cyclotomicOrder ξ)
      (intCast_mem_cyclotomicOrder ξ n)
      ((cyclotomicOrder ξ).zero_mem)) :
    (p : ℤ) ∣ n := by
  classical
  let A := cyclotomicOrder ξ
  let ξA : A := ⟨ξ, eta_mem_cyclotomicOrder ξ⟩
  let oneSubξA : A := ⟨1 - ξ, A.sub_mem A.one_mem (eta_mem_cyclotomicOrder ξ)⟩
  let nA : A := ⟨(n : ℂ), intCast_mem_cyclotomicOrder ξ n⟩
  let zeroA : A := 0
  have hcong' : congruentModIn A oneSubξA nA zeroA := by
    change congruentModIn A
      (⟨1 - ξ, A.sub_mem A.one_mem (eta_mem_cyclotomicOrder ξ)⟩ : A)
      (⟨(n : ℂ), intCast_mem_cyclotomicOrder ξ n⟩ : A) (0 : A)
    exact hcong
  rw [congruentModIn_iff_dvd] at hcong'
  obtain ⟨qA, hqA⟩ := hcong'
  have hq_mem : (qA : ℂ) ∈ cyclotomicOrder ξ := qA.2
  obtain ⟨Q, hQeval⟩ := exists_intPolynomial_eval_eq_of_mem_cyclotomicOrder hq_mem
  have hroot :
      Polynomial.aeval ξ (Polynomial.C n - (1 - Polynomial.X) * Q) = 0 := by
    rw [aeval_eq_eval₂_intCast_complex]
    have hq_coe : ((oneSubξA * qA : A) : ℂ) = (n : ℂ) := by
      calc
        ((oneSubξA * qA : A) : ℂ) = ((nA - zeroA : A) : ℂ) := by
          rw [← hqA]
        _ = (n : ℂ) := by simp [nA, zeroA]
    calc
      Polynomial.eval₂ (Int.castRingHom ℂ) ξ
          (Polynomial.C n - (1 - Polynomial.X) * Q)
        = (n : ℂ) - (1 - ξ) * Polynomial.eval₂ (Int.castRingHom ℂ) ξ Q := by
          simp [eval₂_intCast_polynomial_intCast_complex]
      _ = (n : ℂ) - (1 - ξ) * (qA : ℂ) := by rw [hQeval]
      _ = 0 := by
        rw [← hq_coe]
        simp [oneSubξA]
  have hξ_int : IsIntegral ℤ ξ := hξ.isIntegral hp.pos
  have hmin_dvd :
      minpoly ℤ ξ ∣ Polynomial.C n - (1 - Polynomial.X) * Q :=
    minpoly.isIntegrallyClosed_dvd hξ_int hroot
  have hcyclo_dvd :
      cyclotomic p ℤ ∣ Polynomial.C n - (1 - Polynomial.X) * Q := by
    simpa [Polynomial.cyclotomic_eq_minpoly hξ hp.pos] using hmin_dvd
  letI : Fact p.Prime := ⟨hp⟩
  exact int_dvd_of_cyclotomic_dvd_one_sub_X_polynomial hcyclo_dvd

private lemma exists_pow_eq_of_coprime_prime
    {p k : ℕ} (hp : Nat.Prime p) (hk0 : 1 ≤ k) (hkp : k < p) :
    ∃ r : ℕ, 1 ≤ r ∧ k * r % p = 1 := by
  have hcop : Nat.Coprime k p := by
    exact (hp.coprime_iff_not_dvd.mpr (Nat.not_dvd_of_pos_of_lt hk0 hkp)).symm
  obtain ⟨r, hrlt, hr⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hp.one_lt
  exact ⟨r, by
    by_contra hr0
    have : r = 0 := by omega
    simp [this] at hr, hr⟩

private lemma one_sub_pow_dvd_of_one_sub_pow_dvd
    {A : Subring ℂ} {ξ n : A} {k r : ℕ}
    (hkr : ξ ^ (k * r) = ξ) (hbase : (1 - ξ) ∣ n) :
    (1 - ξ ^ k) ∣ n := by
  obtain ⟨q, hq⟩ := hbase
  have hpow : (1 : A) - (ξ ^ k) ^ r = (1 - ξ ^ k) * ∑ i ∈ Finset.range r, (ξ ^ k) ^ i := by
    calc
      (1 : A) - (ξ ^ k) ^ r = -((∑ i ∈ Finset.range r, (ξ ^ k) ^ i) * (ξ ^ k - 1)) := by
        rw [geom_sum_mul]
        abel
      _ = (1 - ξ ^ k) * ∑ i ∈ Finset.range r, (ξ ^ k) ^ i := by ring
  have hpow_one : (1 : A) - ξ = (1 - ξ ^ k) * ∑ i ∈ Finset.range r, (ξ ^ k) ^ i := by
    calc
      (1 : A) - ξ = 1 - ξ ^ (k * r) := by rw [hkr]
      _ = 1 - (ξ ^ k) ^ r := by
        exact congrArg (fun z : A => (1 : A) - z) (pow_mul ξ k r)
      _ = (1 - ξ ^ k) * ∑ i ∈ Finset.range r, (ξ ^ k) ^ i := hpow
  refine ⟨(∑ i ∈ Finset.range r, (ξ ^ k) ^ i) * q, ?_⟩
  rw [hq]
  rw [hpow_one]
  ring

private lemma prod_one_sub_pow_dvd_power_of_congruent
    {p : ℕ} {A : Subring ℂ} {ξ n : A}
    (hp : Nat.Prime p) (hξ : IsPrimitiveRoot (ξ : ℂ) p)
    (hbase : (1 - ξ) ∣ n) :
    (∏ k ∈ Finset.range (p - 1), (1 - ξ ^ (k + 1))) ∣ n ^ (p - 1) := by
  classical
  have h_each :
      ∀ k ∈ Finset.range (p - 1), (1 - ξ ^ (k + 1)) ∣ n := by
    intro k hk
    have hklt : k < p - 1 := by simpa using hk
    have hkpos : 1 ≤ k + 1 := Nat.succ_le_succ (Nat.zero_le k)
    have hkltp : k + 1 < p := by
      omega
    obtain ⟨r, hrpos, hrmod⟩ := exists_pow_eq_of_coprime_prime hp hkpos hkltp
    have hpow_complex : (ξ : ℂ) ^ ((k + 1) * r) = (ξ : ℂ) := by
      have hmod : ((k + 1) * r) ≡ 1 [MOD p] := by
        simpa [hrmod] using (Nat.mod_modEq ((k + 1) * r) p).symm
      have hp_one : (ξ : ℂ) ^ 1 = (ξ : ℂ) := pow_one (ξ : ℂ)
      exact (pow_eq_pow_of_modEq hmod hξ.pow_eq_one).trans hp_one
    have hpow : ξ ^ ((k + 1) * r) = ξ := by
      ext
      exact hpow_complex
    exact one_sub_pow_dvd_of_one_sub_pow_dvd hpow hbase
  have h_prod : (∏ k ∈ Finset.range (p - 1), (1 - ξ ^ (k + 1))) ∣
      ∏ k ∈ Finset.range (p - 1), n := by
    exact Finset.prod_dvd_prod_of_dvd _ _ fun k hk => h_each k hk
  simpa [Finset.prod_const] using h_prod

private lemma isIntegral_polynomial_aeval_of_isIntegral
    {η : ℂ} (hη : IsIntegral ℤ η) (P : ℤ[X]) :
    IsIntegral ℤ (Polynomial.aeval η P) := by
  induction P using Polynomial.induction_on' with
  | add P Q hP hQ =>
      simpa using hP.add hQ
  | monomial n a =>
      rw [Polynomial.aeval_monomial]
      exact isIntegral_algebraMap.mul (hη.pow n)

private lemma isIntegral_cyclotomicOrder_element_of_isIntegral_generator
    {η : ℂ} (hη : IsIntegral ℤ η) (z : cyclotomicOrder η) :
    IsIntegral ℤ (z : ℂ) := by
  rcases mem_cyclotomicOrder_iff_exists_intPolynomial_eval.mp z.2 with ⟨P, hP⟩
  rw [← hP]
  rw [← aeval_eq_eval₂_intCast_complex]
  exact isIntegral_polynomial_aeval_of_isIntegral hη P

private lemma quotient_integral_of_dvd_in_cyclotomicOrder
    {η a b : ℂ} (hη : IsIntegral ℤ η)
    {ha : a ∈ cyclotomicOrder η} {hb : b ∈ cyclotomicOrder η}
    (hdiv : (⟨a, ha⟩ : cyclotomicOrder η) ∣ ⟨b, hb⟩) :
    IsIntegral ℤ (b / a : ℂ) := by
  obtain ⟨q, hq⟩ := hdiv
  have hq_int := isIntegral_cyclotomicOrder_element_of_isIntegral_generator hη q
  have hcoe : (b : ℂ) = a * (q : ℂ) := by
    exact congrArg Subtype.val hq
  by_cases ha0 : a = 0
  · have hb0 : b = 0 := by simpa [ha0] using hcoe
    simpa [hb0, ha0] using (isIntegral_zero : IsIntegral ℤ (0 : ℂ))
  · have hdiv_eq : b / a = (q : ℂ) := by
      rw [hcoe]
      field_simp [ha0]
    simpa [hdiv_eq] using hq_int

/--
Book-facing cyclotomic divisibility descent for Proposition (1.10)(b).
If `η` is integral over `ℤ`, `ξ ∈ ℤ[η]`, and a rational integer `n` is
congruent to `0` modulo `1 - ξ` in `ℤ[η]`, then a primitive `p`-th root
`ξ` forces `p ∣ n`.
-/
public theorem prime_dvd_int_of_congruent_zero_mod_one_sub
    {p : ℕ} {η ξ : ℂ} (hp : Nat.Prime p) (hξ : IsPrimitiveRoot ξ p)
    (hη : IsIntegral ℤ η) (hξη : ξ ∈ cyclotomicOrder η) (n : ℤ)
    (hcong : CongruentModOneSub η ξ (n : ℂ) 0 hξη
      (intCast_mem_cyclotomicOrder η n)
      ((cyclotomicOrder η).zero_mem)) :
    (p : ℤ) ∣ n := by
  classical
  let A := cyclotomicOrder η
  let ξA : A := ⟨ξ, hξη⟩
  let oneSubξA : A := ⟨1 - ξ, A.sub_mem A.one_mem hξη⟩
  let nA : A := ⟨(n : ℂ), intCast_mem_cyclotomicOrder η n⟩
  let zeroA : A := 0
  have hcong' : congruentModIn A oneSubξA nA zeroA := by
    change congruentModIn A
      (⟨1 - ξ, A.sub_mem A.one_mem hξη⟩ : A)
      (⟨(n : ℂ), intCast_mem_cyclotomicOrder η n⟩ : A) (0 : A)
    exact hcong
  rw [congruentModIn_iff_dvd] at hcong'
  have hbase : (1 - ξA) ∣ nA := by
    convert hcong' using 1
    · apply Subtype.ext
      simp [oneSubξA, ξA]
    · simp [nA, zeroA]
  have hprod_dvd :
      (∏ k ∈ Finset.range (p - 1), (1 - ξA ^ (k + 1))) ∣ nA ^ (p - 1) :=
    prod_one_sub_pow_dvd_power_of_congruent hp hξ hbase
  have hprod_coe :
      ((∏ k ∈ Finset.range (p - 1), (1 - ξA ^ (k + 1)) : A) : ℂ) = (p : ℂ) := by
    simpa [ξA] using primitive_root_prod_one_sub_pow_eq_prime hp hξ
  have hn_pow_mem :
      ((n ^ (p - 1) : ℤ) : ℂ) ∈ A := intCast_mem_cyclotomicOrder η (n ^ (p - 1))
  have hquot_int :
      IsIntegral ℤ (((n ^ (p - 1) : ℤ) : ℂ) / (p : ℂ)) := by
    have hdiv_complex :
        (⟨(p : ℂ), by
          rw [← hprod_coe]
          exact (∏ k ∈ Finset.range (p - 1), (1 - ξA ^ (k + 1)) : A).2⟩ : A) ∣
          ⟨((n ^ (p - 1) : ℤ) : ℂ), hn_pow_mem⟩ := by
      convert hprod_dvd using 1
      · ext
        exact hprod_coe.symm
      · ext
        simp [nA]
    exact quotient_integral_of_dvd_in_cyclotomicOrder hη hdiv_complex
  exact prime_dvd_int_of_integral_power_quotient hp n hquot_int

end Representation
