module

public import FeitThompson.PCore.PCore
public import FeitThompson.PCore.PPrimeCore

open scoped IsMulCommutative

/-!

# Fitting Subgroups

The Fitting subgroup is generated by all normal nilpotent subgroups. For finite groups, it is the
unique largest normal nilpotent subgroup.

- The Fitting subgroup is characteristic.
- The Fitting subgroup of a nilpotent group is the whole group.
- For a finite solvable group, its Fitting subgroup is trivial if and only if the group is trivial.
- If the `p'`-core is trivial, then the Fitting subgroup is equal to the `p`-core.

-/

/-- The set of normal nilpotent subgroups of `G`. -/
def normalNilpotentSubgroups (G : Type*) [Group G] : Set (Subgroup G) :=
  {N : Subgroup G | N.Normal ∧ Group.IsNilpotent N}

/-- The subgroup generated by all normal nilpotent subgroups of `G`. -/
-- Keep the predicate inline so this exposed definition does not depend on a private declaration.
@[expose]
public def fittingSubgroup (G : Type*) [Group G] : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ Group.IsNilpotent N}

/-- The subgroup generated by a family of normal subgroups is normal. -/
public theorem Subgroup.normal_sSup {G : Type*} [Group G] (S : Set (Subgroup G))
    (h : ∀ H ∈ S, H.Normal) : Subgroup.Normal (sSup S) :=
  Subgroup.sSup_normal S h

/-- The Fitting subgroup is normal. -/
public instance fittingSubgroup_normal {G : Type*} [Group G] :
    Subgroup.Normal (fittingSubgroup G) :=
  Subgroup.sSup_normal _ fun _ hN => hN.1

lemma nilpotent_comap_mulEquiv {G : Type*} [Group G] {N : Subgroup G}
    (hnil : Group.IsNilpotent N) (φ : G ≃* G) :
    Group.IsNilpotent (N.comap φ.toMonoidHom) := by
  rw [Subgroup.comap_equiv_eq_map_symm' φ N]
  exact Group.nilpotent_of_mulEquiv (_h := hnil) (φ.symm.subgroupMap N)

/-- The preimage map `comap φ` for an automorphism `φ` preserves suprema. -/
lemma comap_sSup {G : Type*} [Group G] (φ : G ≃* G) (S : Set (Subgroup G)) :
    (sSup S).comap φ.toMonoidHom =
      sSup ((fun H : Subgroup G => H.comap φ.toMonoidHom) '' S) := by
  simpa only [sSup_image, MulEquiv.coe_comapSubgroup] using φ.comapSubgroup.map_sSup S

lemma comap_mem_normalNilpotentSubgroups {G : Type*} [Group G] {N : Subgroup G}
    (hN : N ∈ normalNilpotentSubgroups G) (φ : G ≃* G) :
    N.comap φ.toMonoidHom ∈ normalNilpotentSubgroups G := by
  rcases hN with ⟨hN_normal, hN_nilp⟩
  exact ⟨hN_normal.comap φ.toMonoidHom, nilpotent_comap_mulEquiv hN_nilp φ⟩

lemma comap_image_normalNilpotentSubgroups {G : Type*} [Group G] (φ : G ≃* G) :
    (fun N : Subgroup G => N.comap φ.toMonoidHom) '' (normalNilpotentSubgroups G) =
      normalNilpotentSubgroups G := by
  ext N
  constructor
  · rintro ⟨K, hK, rfl⟩
    exact comap_mem_normalNilpotentSubgroups hK φ
  · intro hN
    refine ⟨N.comap φ.symm.toMonoidHom, comap_mem_normalNilpotentSubgroups hN φ.symm, ?_⟩
    simpa only [MulEquiv.symm_comapSubgroup, MulEquiv.coe_comapSubgroup,
      MulEquiv.symm_symm] using
      φ.symm.comapSubgroup.symm_apply_apply N

/-- The Fitting subgroup is characteristic. -/
public instance fittingSubgroup_characteristic {G : Type*} [Group G] :
    (fittingSubgroup G).Characteristic := by
  rw [Subgroup.characteristic_iff_comap_eq]
  intro φ
  change (sSup (normalNilpotentSubgroups G)).comap φ.toMonoidHom =
    sSup (normalNilpotentSubgroups G)
  rw [comap_sSup, comap_image_normalNilpotentSubgroups φ]

/-- The Fitting subgroup is the supremum of the `p`-cores. -/
public lemma fitting_eq_sup_pCore (G : Type*) [Group G] [Finite G] :
    fittingSubgroup G = ⨆ p : (Nat.card G).primeFactors.attach, pCore p.1.1 G := by
  refine le_antisymm ?_ ?_
  · refine sSup_le fun N ⟨hN_normal, hN_nil⟩ => ?_
    exact normal_nilpotent_le_sup_pCore hN_normal hN_nil
  · exact iSup_le fun _ => le_sSup ⟨pCore_normal, pCore_isNilpotent⟩

/-- The Fitting subgroup of a finite group is nilpotent. -/
public instance fittingSubgroup_nilpotent {G : Type*} [Group G] [Finite G] :
    Group.IsNilpotent (fittingSubgroup G) :=
  fitting_eq_sup_pCore G ▸ isNilpotent_iSup_pCore

/-- The Fitting subgroup of a nilpotent group is the whole group. -/
public theorem fitting_eq_top_of_nilpotent (G : Type*) [Group G] [Group.IsNilpotent G] :
    fittingSubgroup G = ⊤ :=
  le_antisymm le_top (le_sSup ⟨inferInstance, inferInstance⟩)

/-- A nontrivial solvable group has a nontrivial abelian normal subgroup. -/
lemma exists_nontrivial_abelian_normal (G : Type*) [Group G] [hs : IsSolvable G]
    (hnt : Nontrivial G) : ∃ (H : Subgroup G), H.Normal ∧ IsMulCommutative H ∧ H ≠ ⊥ := by
  classical
  letI : Nontrivial G := hnt
  let p : ℕ → Prop := fun n => derivedSeries G n = ⊥
  have hp : ∃ n, p n := hs.solvable
  let i := Nat.find hp
  have hi : i ≠ 0 := by
    have : ¬ p 0 := by
      simp [p, derivedSeries_zero]
    exact (Nat.find_eq_zero hp).not.mpr this
  use derivedSeries G (i - 1)
  refine ⟨derivedSeries_normal _ _, ?_, Nat.find_min hp (Nat.sub_one_lt hi)⟩
  refine Subgroup.le_centralizer_iff_isMulCommutative.mp ?_
  apply Subgroup.commutator_eq_bot_iff_le_centralizer.mp
  rw [← derivedSeries_succ, Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hi)]
  exact Nat.find_spec hp

/-- For a finite solvable group, the Fitting subgroup is trivial exactly when the group is
trivial. -/
public theorem fitting_eq_bot_iff_card_eq_one_of_solvable
    (G : Type*) [Group G] [Finite G] [IsSolvable G] :
    fittingSubgroup G = ⊥ ↔ Nat.card G = 1 := by
  constructor
  · intro hF
    by_contra!
    have hnt : Nontrivial G := by
      apply Finite.one_lt_card_iff_nontrivial.mp
      have := (Nat.card_pos (α := G)).ne'
      omega
    obtain ⟨H, hH_normal, hH_abelian, hH_ne_bot⟩ := exists_nontrivial_abelian_normal G hnt
    have hH_le : H ≤ fittingSubgroup G := by
      haveI : IsMulCommutative H := hH_abelian
      exact le_sSup ⟨hH_normal, (inferInstance : Group.IsNilpotent (↥H))⟩
    exact hH_ne_bot (le_bot_iff.mp (hH_le.trans (le_of_eq hF)))
  · intro hcard
    rw [← Subgroup.card_le_one_iff_eq_bot, ← hcard]
    exact Subgroup.card_le_card_group (H := fittingSubgroup G)

/-- The `p`-core is contained in the Fitting subgroup. -/
public theorem pCore_le_fitting (G : Type*) [Group G] [Finite G] (p : ℕ) [Fact p.Prime] :
    pCore p G ≤ fittingSubgroup G :=
  le_sSup ⟨pCore_normal, pCore_isNilpotent⟩

lemma fitting_le_pCore (G : Type*) [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (hcore : pPrimeCore p G = ⊥) : fittingSubgroup G ≤ pCore p G := by
  refine sSup_le_sSup fun N ⟨hN_normal, hN_nilpotent⟩ => ?_
  exact ⟨hN_normal, isPGroup_of_nilpotent_normal N hN_normal hN_nilpotent hcore⟩

/-- If the `p'`-core is trivial, the Fitting subgroup equals the `p`-core. -/
public theorem Fitting_eq_pcore (G : Type*) [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (h : pPrimeCore p G = ⊥) : fittingSubgroup G = pCore p G :=
  le_antisymm (fitting_le_pCore G p h) (pCore_le_fitting G p)
