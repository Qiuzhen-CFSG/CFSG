import Submission.ZStar.SubgroupBrauerMap

/-!
# The normalizer layer of a Brauer pair

This file records the group-theoretic part of the normalizer step in
Juhasz's proof of Brauer's Third Main Theorem.

For a `p`-subgroup `Q`, the subgroup generated by `Q` and `C_G(Q)` lies in
`N_G(Q)`.  If an ambient subgroup is admissible for `Q`, the same generated
subgroup lies in that ambient subgroup.  Finally, unless `Q` is Sylow, the
normalizer contains a strictly larger `p`-subgroup.  The latter is the strict
growth needed for induction on the defect/Sylow index.

No block correspondence statement is used here.
-/

namespace Submission.ZStar
namespace NormalizerBrauerPair

open Subgroup
open scoped Pointwise

universe u

/-- The subgroup denoted `Q C_G(Q)` in the block-theory literature. -/
def qcCentralizer
    {G : Type u} [Group G] (Q : Subgroup G) : Subgroup G :=
  Q ⊔ Subgroup.centralizer (Q : Set G)

/-- Under the admissibility condition `C_G(Q) ≤ H`, the centralizer of
`Q` computed inside `H` maps onto its ambient centralizer. -/
theorem centralizer_map_subtype_eq_of_ambientCentralizer_le
    {G : Type u} [Group G]
    (H : Subgroup G) (Q : Subgroup H)
    (hC : Subgroup.centralizer
        ((Q.map H.subtype : Subgroup G) : Set G) ≤ H) :
    (Subgroup.centralizer (Q : Set H)).map H.subtype =
      Subgroup.centralizer
        ((Q.map H.subtype : Subgroup G) : Set G) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨xH, hxH, rfl⟩ := Subgroup.mem_map.mp hx
    rw [Subgroup.mem_centralizer_iff]
    intro qG hqG
    obtain ⟨q, hq, rfl⟩ := Subgroup.mem_map.mp hqG
    exact congrArg Subtype.val
      (Subgroup.mem_centralizer_iff.mp hxH q hq)
  · intro x hx
    let xH : H := ⟨x, hC hx⟩
    have hxH : xH ∈ Subgroup.centralizer (Q : Set H) := by
      rw [Subgroup.mem_centralizer_iff]
      intro q hq
      apply Subtype.ext
      have hqG : (q : G) ∈ Q.map H.subtype :=
        Subgroup.mem_map.mpr ⟨q, hq, rfl⟩
      exact Subgroup.mem_centralizer_iff.mp hx (q : G) hqG
    exact Subgroup.mem_map.mpr ⟨xH, hxH, rfl⟩

/-- Consequently the internal subgroup `Q C_H(Q)` maps exactly onto the
ambient subgroup `Q C_G(Q)`. -/
theorem qcCentralizer_map_subtype_eq_of_ambientCentralizer_le
    {G : Type u} [Group G]
    (H : Subgroup G) (Q : Subgroup H)
    (hC : Subgroup.centralizer
        ((Q.map H.subtype : Subgroup G) : Set G) ≤ H) :
    (qcCentralizer Q).map H.subtype =
      qcCentralizer (Q.map H.subtype : Subgroup G) := by
  rw [qcCentralizer, qcCentralizer, Subgroup.map_sup,
    centralizer_map_subtype_eq_of_ambientCentralizer_le H Q hC]

/-- The canonical equivalence `Q C_H(Q) ≃ Q C_G(Q)` available for an
admissible subgroup. -/
noncomputable def qcCentralizerMapEquiv
    {G : Type u} [Group G]
    (H : Subgroup G) (Q : Subgroup H)
    (hC : Subgroup.centralizer
        ((Q.map H.subtype : Subgroup G) : Set G) ≤ H) :
    qcCentralizer Q ≃* qcCentralizer (Q.map H.subtype : Subgroup G) :=
  (Subgroup.equivMapOfInjective (qcCentralizer Q) H.subtype
      H.subtype_injective).trans
    (MulEquiv.subgroupCongr
      (qcCentralizer_map_subtype_eq_of_ambientCentralizer_le H Q hC))

@[simp] theorem qcCentralizerMapEquiv_apply_coe
    {G : Type u} [Group G]
    (H : Subgroup G) (Q : Subgroup H)
    (hC : Subgroup.centralizer
        ((Q.map H.subtype : Subgroup G) : Set G) ≤ H)
    (x : qcCentralizer Q) :
    ((qcCentralizerMapEquiv H Q hC x :
      qcCentralizer (Q.map H.subtype : Subgroup G)) : G) = (x : G) := rfl

/-- The preceding equivalence carries the canonical copy of `Q` to the
canonical copy of its ambient image. -/
theorem subgroupOf_qcCentralizer_map_qcCentralizerMapEquiv
    {G : Type u} [Group G]
    (H : Subgroup G) (Q : Subgroup H)
    (hC : Subgroup.centralizer
        ((Q.map H.subtype : Subgroup G) : Set G) ≤ H) :
    (Q.subgroupOf (qcCentralizer Q)).map
        (qcCentralizerMapEquiv H Q hC).toMonoidHom =
      (Q.map H.subtype).subgroupOf
        (qcCentralizer (Q.map H.subtype : Subgroup G)) := by
  ext x
  constructor
  · intro hx
    obtain ⟨p, hp, rfl⟩ := Subgroup.mem_map.mp hx
    change (p : H) ∈ Q at hp
    change ((qcCentralizerMapEquiv H Q hC p :
      qcCentralizer (Q.map H.subtype : Subgroup G)) : G) ∈
        Q.map H.subtype
    exact Subgroup.mem_map.mpr ⟨(p : H), hp, rfl⟩
  · intro hx
    change (x : G) ∈ Q.map H.subtype at hx
    obtain ⟨q, hq, hqx⟩ := Subgroup.mem_map.mp hx
    let p : qcCentralizer Q :=
      ⟨q, (le_sup_left : Q ≤
        Q ⊔ Subgroup.centralizer (Q : Set H)) hq⟩
    apply Subgroup.mem_map.mpr
    refine ⟨p, ?_, ?_⟩
    · exact hq
    · apply Subtype.ext
      exact hqx

/-- The canonical inclusion `C_G(Q) → Q C_G(Q)`. -/
def centralizerToQcCentralizer
    {G : Type u} [Group G] (Q : Subgroup G) :
    Subgroup.centralizer (Q : Set G) →* qcCentralizer Q :=
  Subgroup.inclusion le_sup_right

/-- Embed the centralizer group algebra into the group algebra of
`Q C_G(Q)`. -/
noncomputable def qcCentralizerAlgebraEmbedding
    (R : Type*) {G : Type u} [Semiring R] [Group G]
    (Q : Subgroup G) :
    MonoidAlgebra R (Subgroup.centralizer (Q : Set G)) →+*
      MonoidAlgebra R (qcCentralizer Q) :=
  MonoidAlgebra.mapDomainRingHom R (centralizerToQcCentralizer Q)

@[simp] theorem qcCentralizerAlgebraEmbedding_single
    {R : Type*} {G : Type u} [Semiring R] [Group G]
    (Q : Subgroup G)
    (c : Subgroup.centralizer (Q : Set G)) (r : R) :
    qcCentralizerAlgebraEmbedding R Q (MonoidAlgebra.single c r) =
      MonoidAlgebra.single (centralizerToQcCentralizer Q c) r := by
  simp [qcCentralizerAlgebraEmbedding]

theorem centralizerToQcCentralizer_injective
    {G : Type u} [Group G] (Q : Subgroup G) :
    Function.Injective (centralizerToQcCentralizer Q) := by
  intro x y hxy
  apply Subtype.ext
  exact congrArg (fun z : qcCentralizer Q => (z : G)) hxy

/-- The centralizer algebra embedding does not kill a nonzero element. -/
theorem qcCentralizerAlgebraEmbedding_ne_zero
    {R : Type*} {G : Type u} [Semiring R] [Group G]
    (Q : Subgroup G)
    (b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))
    (hb : b ≠ 0) :
    qcCentralizerAlgebraEmbedding R Q b ≠ 0 := by
  intro hzero
  apply hb
  apply Finsupp.mapDomain_injective
    (centralizerToQcCentralizer_injective Q)
  change Finsupp.mapDomain (centralizerToQcCentralizer Q) b = 0 at hzero
  exact hzero.trans
    (Finsupp.mapDomain_zero
      (f := centralizerToQcCentralizer Q)).symm

/-- Every nonzero coefficient of an embedded centralizer element is indexed
by an element of `C_G(Q)`. -/
theorem coeff_mem_centralizer_of_qcCentralizerAlgebraEmbedding_ne_zero
    {R : Type*} {G : Type u} [Semiring R] [Group G]
    (Q : Subgroup G)
    (b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))
    (x : qcCentralizer Q)
    (hx : qcCentralizerAlgebraEmbedding R Q b x ≠ 0) :
    (x : G) ∈ Subgroup.centralizer (Q : Set G) := by
  have hxrange : x ∈ Set.range (centralizerToQcCentralizer Q) := by
    by_contra hnot
    apply hx
    exact Finsupp.mapDomain_notin_range b x hnot
  obtain ⟨c, rfl⟩ := hxrange
  exact c.property

/-- Consequently every nonzero coefficient of the embedded element
centralizes the copy of `Q` inside `Q C_G(Q)`. -/
theorem coeff_centralizes_subgroupOf_qcCentralizer_of_embedding_ne_zero
    {R : Type*} {G : Type u} [Semiring R] [Group G]
    (Q : Subgroup G)
    (b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))
    (x : qcCentralizer Q)
    (hx : qcCentralizerAlgebraEmbedding R Q b x ≠ 0) :
    x ∈ Subgroup.centralizer
      ((Q.subgroupOf (qcCentralizer Q) : Subgroup (qcCentralizer Q)) :
        Set (qcCentralizer Q)) := by
  have hxC :=
    coeff_mem_centralizer_of_qcCentralizerAlgebraEmbedding_ne_zero Q b x hx
  rw [Subgroup.mem_centralizer_iff]
  intro q hq
  apply Subtype.ext
  exact Subgroup.mem_centralizer_iff.mp hxC (q : G) hq

/-- A central element of `K[C_G(Q)]` remains central after embedding into
`K[Q C_G(Q)]`: elements of `Q` commute pointwise with `C_G(Q)`, while the
centralizer factor commutes by the original centrality hypothesis. -/
theorem qcCentralizerAlgebraEmbedding_mem_center
    {R : Type*} {G : Type u} [CommRing R] [Group G]
    (Q : Subgroup G)
    (b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))
    (hb : b ∈ Set.center
      (MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))) :
    qcCentralizerAlgebraEmbedding R Q b ∈
      Set.center (MonoidAlgebra R (qcCentralizer Q)) := by
  rw [Semigroup.mem_center_iff]
  intro a
  induction a using MonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => rw [add_mul, mul_add, hx, hy]
  | single l r =>
      let C : Subgroup G := Subgroup.centralizer (Q : Set G)
      let L : Subgroup G := qcCentralizer Q
      have hlmem : (l : G) ∈ Q ⊔ C := l.property
      have hlprod : (l : G) ∈ (Q : Set G) * (C : Set G) := by
        rw [← Subgroup.coe_mul_of_right_le_normalizer_left Q C
          (Subgroup.centralizer_le_normalizer (Q : Set G))]
        exact hlmem
      obtain ⟨q, hq, c, hc, hqc⟩ := hlprod
      let qL : L := ⟨q, by
        exact (le_sup_left : Q ≤ Q ⊔ C) hq⟩
      let cC : C := ⟨c, hc⟩
      let cL : L := centralizerToQcCentralizer Q cC
      have hl : qL * cL = l := by
        apply Subtype.ext
        exact hqc
      have hqcomm_all
          (b' : MonoidAlgebra R (Subgroup.centralizer (Q : Set G))) :
          MonoidAlgebra.of R L qL * qcCentralizerAlgebraEmbedding R Q b' =
            qcCentralizerAlgebraEmbedding R Q b' *
              MonoidAlgebra.of R L qL := by
        induction b' using MonoidAlgebra.induction_linear with
        | zero => simp
        | add x y hx hy => rw [map_add, mul_add, add_mul, hx, hy]
        | single c' s =>
            rw [qcCentralizerAlgebraEmbedding_single]
            change MonoidAlgebra.single qL 1 *
                MonoidAlgebra.single (centralizerToQcCentralizer Q c') s =
              MonoidAlgebra.single (centralizerToQcCentralizer Q c') s *
                MonoidAlgebra.single qL 1
            rw [MonoidAlgebra.single_mul_single,
              MonoidAlgebra.single_mul_single]
            simp only [one_mul, mul_one]
            congr 1
            apply Subtype.ext
            exact Subgroup.mem_centralizer_iff.mp c'.property q hq
      have hqcomm :
          MonoidAlgebra.of R L qL * qcCentralizerAlgebraEmbedding R Q b =
            qcCentralizerAlgebraEmbedding R Q b *
              MonoidAlgebra.of R L qL := hqcomm_all b
      have hccommC := Semigroup.mem_center_iff.mp hb
        (MonoidAlgebra.of R C cC)
      have hccommMap := congrArg
        (qcCentralizerAlgebraEmbedding R Q) hccommC
      have hccomm :
          MonoidAlgebra.of R L cL * qcCentralizerAlgebraEmbedding R Q b =
            qcCentralizerAlgebraEmbedding R Q b *
              MonoidAlgebra.of R L cL := by
        simpa [C, L, cL, cC] using hccommMap
      have hprodcomm :
          (MonoidAlgebra.of R L qL * MonoidAlgebra.of R L cL) *
              qcCentralizerAlgebraEmbedding R Q b =
            qcCentralizerAlgebraEmbedding R Q b *
              (MonoidAlgebra.of R L qL * MonoidAlgebra.of R L cL) := by
        calc
          (MonoidAlgebra.of R L qL * MonoidAlgebra.of R L cL) *
                qcCentralizerAlgebraEmbedding R Q b =
              MonoidAlgebra.of R L qL *
                (MonoidAlgebra.of R L cL *
                  qcCentralizerAlgebraEmbedding R Q b) := by rw [mul_assoc]
          _ = MonoidAlgebra.of R L qL *
                (qcCentralizerAlgebraEmbedding R Q b *
                  MonoidAlgebra.of R L cL) := by rw [hccomm]
          _ = (MonoidAlgebra.of R L qL *
                qcCentralizerAlgebraEmbedding R Q b) *
                  MonoidAlgebra.of R L cL := by rw [mul_assoc]
          _ = (qcCentralizerAlgebraEmbedding R Q b *
                MonoidAlgebra.of R L qL) *
                  MonoidAlgebra.of R L cL := by rw [hqcomm]
          _ = qcCentralizerAlgebraEmbedding R Q b *
                (MonoidAlgebra.of R L qL *
                  MonoidAlgebra.of R L cL) := by rw [mul_assoc]
      have hlOf : MonoidAlgebra.of R L l =
          MonoidAlgebra.of R L qL * MonoidAlgebra.of R L cL := by
        rw [← map_mul, hl]
      rw [show MonoidAlgebra.single l r =
          r • MonoidAlgebra.of R L l by simp]
      simp only [Algebra.smul_mul_assoc, Algebra.mul_smul_comm]
      exact congrArg (fun x : MonoidAlgebra R L => r • x)
        (by simpa [hlOf] using hprodcomm)

theorem qcCentralizerAlgebraEmbedding_isIdempotent
    {R : Type*} {G : Type u} [Semiring R] [Group G]
    (Q : Subgroup G)
    (b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))
    (hb : IsIdempotentElem b) :
    IsIdempotentElem (qcCentralizerAlgebraEmbedding R Q b) := by
  exact hb.map (qcCentralizerAlgebraEmbedding R Q)

theorem qcCentralizerAlgebraEmbedding_mul_eq_self
    {R : Type*} {G : Type u} [Semiring R] [Group G]
    (Q : Subgroup G)
    (a b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))
    (hba : b * a = b) :
    qcCentralizerAlgebraEmbedding R Q b *
        qcCentralizerAlgebraEmbedding R Q a =
      qcCentralizerAlgebraEmbedding R Q b := by
  rw [← map_mul, hba]

/-- Embedding `K[C_G(Q)]` into `K[Q C_G(Q)]` preserves augmentation. -/
theorem augmentation_qcCentralizerAlgebraEmbedding
    {R : Type*} {G : Type u} [CommSemiring R] [Group G]
    (Q : Subgroup G)
    (b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G))) :
    AugmentationScratch.augmentation R (qcCentralizer Q)
        (qcCentralizerAlgebraEmbedding R Q b) =
      AugmentationScratch.augmentation R
        (Subgroup.centralizer (Q : Set G)) b := by
  induction b using MonoidAlgebra.induction_linear with
  | zero => simp
  | add a b ha hb => simp [ha, hb]
  | single c r =>
      simp [qcCentralizerAlgebraEmbedding_single,
        AugmentationScratch.augmentation_single]

/-- The canonical copy of `Q` supports every nonzero element embedded from
`K[C_G(Q)]`. -/
theorem subgroupOf_qcCentralizer_hasSupport_embedding
    {R : Type*} {G : Type u} [Semiring R] [Group G] [Finite G]
    (Q : Subgroup G) (hQ : IsPGroup 2 Q)
    (b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))
    (hb : b ≠ 0) :
    DefectSupport.HasTwoCoefficientSupport
      (qcCentralizerAlgebraEmbedding R Q b)
      (Q.subgroupOf (qcCentralizer Q)) := by
  have hQsub : IsPGroup 2 (Q.subgroupOf (qcCentralizer Q)) :=
    hQ.of_equiv (Subgroup.subgroupOfEquivOfLe
      (H := Q) (K := qcCentralizer Q) le_sup_left).symm
  have hcoeff : ∃ c : Subgroup.centralizer (Q : Set G), b c ≠ 0 := by
    by_contra h
    push Not at h
    apply hb
    ext c
    exact h c
  obtain ⟨c, hc⟩ := hcoeff
  let x : qcCentralizer Q := centralizerToQcCentralizer Q c
  have hx : qcCentralizerAlgebraEmbedding R Q b x ≠ 0 := by
    change Finsupp.mapDomain (centralizerToQcCentralizer Q) b x ≠ 0
    rw [Finsupp.mapDomain_apply
      (centralizerToQcCentralizer_injective Q)]
    exact hc
  exact ⟨hQsub, x,
    coeff_centralizes_subgroupOf_qcCentralizer_of_embedding_ne_zero
      Q b x hx,
    hx⟩

/-- The direct `Q`-coefficient restriction of an element whose maximal
support is `Q`, embedded into `Q C_G(Q)`, still has exactly the canonical
copy of `Q` as a maximal support subgroup.  This is coefficientwise
transitivity: a support subgroup upstairs maps back to a support subgroup of
the original element. -/
theorem subgroupOf_qcCentralizer_isMaximalSupport_of_embedding_restriction
    [Fact (Nat.Prime 2)]
    {R : Type*} {G : Type u} [Semiring R] [Group G] [Finite G]
    (e : MonoidAlgebra R G) (Q : Subgroup G)
    (hQmax : DefectSupport.IsMaximalTwoCoefficientSupport e Q) :
    DefectSupport.IsMaximalTwoCoefficientSupport
      (qcCentralizerAlgebraEmbedding R Q
        (DefectSupport.subgroupCentralizerRestriction R Q e))
      (Q.subgroupOf (qcCentralizer Q)) := by
  let L : Subgroup G := qcCentralizer Q
  let P : Subgroup L := Q.subgroupOf L
  let eQ := DefectSupport.subgroupCentralizerRestriction R Q e
  let eL := qcCentralizerAlgebraEmbedding R Q eQ
  have hPp : IsPGroup 2 P :=
    hQmax.1.1.of_equiv (Subgroup.subgroupOfEquivOfLe
      (H := Q) (K := L) le_sup_left).symm
  have hPnormal : P.Normal := by
    change (Q.subgroupOf
      (Q ⊔ Subgroup.centralizer (Q : Set G))).Normal
    rw [sup_comm]
    exact Subgroup.normal_subgroupOf_sup_of_le_normalizer
      (Subgroup.centralizer_le_normalizer (Q : Set G))
  refine ⟨?_, ?_⟩
  · rcases hQmax.1 with ⟨_hQp, x, hxC, hxe⟩
    let c : Subgroup.centralizer (Q : Set G) := ⟨x, hxC⟩
    let xL : L := centralizerToQcCentralizer Q c
    have hxcoeff : eL xL ≠ 0 := by
      change Finsupp.mapDomain (centralizerToQcCentralizer Q) eQ xL ≠ 0
      rw [Finsupp.mapDomain_apply
        (centralizerToQcCentralizer_injective Q)]
      exact hxe
    refine ⟨hPp, xL, ?_, hxcoeff⟩
    exact
      coeff_centralizes_subgroupOf_qcCentralizer_of_embedding_ne_zero
        Q eQ xL hxcoeff
  · intro D hD
    rcases hD with ⟨hDp, y, hyD, hycoeff⟩
    have hyP : y ∈ Subgroup.centralizer (P : Set L) :=
      coeff_centralizes_subgroupOf_qcCentralizer_of_embedding_ne_zero
        Q eQ y hycoeff
    have hPcy : P ≤ Subgroup.centralizer ({y} : Set L) := by
      intro p hp
      rw [Subgroup.mem_centralizer_singleton_iff]
      exact Subgroup.mem_centralizer_iff.mp hyP p hp
    have hDcy : D ≤ Subgroup.centralizer ({y} : Set L) := by
      intro d hd
      rw [Subgroup.mem_centralizer_singleton_iff]
      exact Subgroup.mem_centralizer_iff.mp hyD d hd
    letI : P.Normal := hPnormal
    let S : Subgroup L := P ⊔ D
    have hSp : IsPGroup 2 S := by
      exact IsPGroup.to_sup_of_normal_left hPp hDp
    have hyS : y ∈ Subgroup.centralizer (S : Set L) := by
      rw [Subgroup.mem_centralizer_iff]
      intro s hs
      exact Subgroup.mem_centralizer_singleton_iff.mp
        (sup_le hPcy hDcy hs)
    let SG : Subgroup G := S.map L.subtype
    have hSGp : IsPGroup 2 SG := hSp.map L.subtype
    have hySG : (y : G) ∈ Subgroup.centralizer (SG : Set G) := by
      rw [Subgroup.mem_centralizer_iff]
      intro s hs
      obtain ⟨sL, hsL, rfl⟩ := Subgroup.mem_map.mp hs
      exact congrArg Subtype.val
        (Subgroup.mem_centralizer_iff.mp hyS sL hsL)
    have hye : e (y : G) ≠ 0 := by
      have hyC :=
        coeff_mem_centralizer_of_qcCentralizerAlgebraEmbedding_ne_zero
          Q eQ y hycoeff
      let c : Subgroup.centralizer (Q : Set G) := ⟨(y : G), hyC⟩
      have hcy : centralizerToQcCentralizer Q c = y := by
        apply Subtype.ext
        rfl
      change Finsupp.mapDomain (centralizerToQcCentralizer Q) eQ y ≠ 0 at hycoeff
      rw [← hcy, Finsupp.mapDomain_apply
        (centralizerToQcCentralizer_injective Q)] at hycoeff
      exact hycoeff
    have hSGSupport : DefectSupport.HasTwoCoefficientSupport e SG :=
      ⟨hSGp, (y : G), hySG, hye⟩
    have hbound : Nat.card SG ≤ Nat.card Q :=
      hQmax.2 SG hSGSupport
    calc
      Nat.card D ≤ Nat.card S :=
        Subgroup.card_le_of_le le_sup_right
      _ = Nat.card SG := Nat.card_congr
        (Subgroup.equivMapOfInjective S L.subtype
          L.subtype_injective).toEquiv
      _ ≤ Nat.card Q := hbound
      _ = Nat.card P := (Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe
          (H := Q) (K := L) le_sup_left).toEquiv).symm

/-- A central factor of the embedded `Q`-Brauer restriction cannot have a
larger coefficient defect: its nonzero Brauer restrictions transfer back to
the original element by the characteristic-two subgroup Brauer product
calculation. -/
theorem subgroupOf_qcCentralizer_isMaximalSupport_of_embedding_factor
    [Fact (Nat.Prime 2)]
    {R : Type*} {G : Type u} [CommRing R] [CharP R 2]
    [Group G] [Finite G]
    (e : MonoidAlgebra R G) (hecenter : e ∈ Set.center (MonoidAlgebra R G))
    (Q : Subgroup G)
    (hQmax : DefectSupport.IsMaximalTwoCoefficientSupport e Q)
    (b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))
    (hbcenter : b ∈ Set.center
      (MonoidAlgebra R (Subgroup.centralizer (Q : Set G))))
    (hbfactor : b * DefectSupport.subgroupCentralizerRestriction R Q e = b)
    (hbne : b ≠ 0) :
    DefectSupport.IsMaximalTwoCoefficientSupport
      (qcCentralizerAlgebraEmbedding R Q b)
      (Q.subgroupOf (qcCentralizer Q)) := by
  let a := DefectSupport.subgroupCentralizerRestriction R Q e
  let eb := qcCentralizerAlgebraEmbedding R Q b
  let ea := qcCentralizerAlgebraEmbedding R Q a
  have hacenter : a ∈ Set.center
      (MonoidAlgebra R (Subgroup.centralizer (Q : Set G))) := by
    exact SubgroupBrauerMap.subgroupCentralizerRestriction_mem_center
      Q e hecenter
  have hebcenter : eb ∈ Set.center
      (MonoidAlgebra R (qcCentralizer Q)) := by
    simpa [eb] using qcCentralizerAlgebraEmbedding_mem_center Q b hbcenter
  have heacenter : ea ∈ Set.center
      (MonoidAlgebra R (qcCentralizer Q)) := by
    simpa [ea] using qcCentralizerAlgebraEmbedding_mem_center Q a hacenter
  have hebne : eb ≠ 0 := by
    simpa [eb] using qcCentralizerAlgebraEmbedding_ne_zero Q b hbne
  have hefactor : eb * ea = eb := by
    simpa [eb, ea, a] using
      qcCentralizerAlgebraEmbedding_mul_eq_self Q a b hbfactor
  have hbase := subgroupOf_qcCentralizer_hasSupport_embedding Q
    hQmax.1.1 b hbne
  refine ⟨hbase, ?_⟩
  intro D hD
  have hebRestrNe :
      DefectSupport.subgroupCentralizerRestriction R D eb ≠ 0 :=
    (DefectSupport.hasTwoCoefficientSupport_iff_restriction_ne_zero eb D).mp
      hD |>.2
  have heaRestrNe :
      DefectSupport.subgroupCentralizerRestriction R D ea ≠ 0 := by
    intro hzero
    apply hebRestrNe
    have hmul :=
      SubgroupBrauerMap.subgroupCentralizerRestriction_mul_of_mem_center
        D hD.1 eb ea hebcenter heacenter
    rw [hefactor, hzero, mul_zero] at hmul
    exact hmul
  have hEaSupport : DefectSupport.HasTwoCoefficientSupport ea D := by
    rw [DefectSupport.hasTwoCoefficientSupport_iff_restriction_ne_zero]
    exact ⟨hD.1, heaRestrNe⟩
  have hAmax := subgroupOf_qcCentralizer_isMaximalSupport_of_embedding_restriction
    e Q hQmax
  exact hAmax.2 D (by simpa [ea, a] using hEaSupport)

/-- A maximal coefficient-support subgroup of an embedded nonzero
centralizer element contains the canonical copy of `Q`.  This supplies the
first half of the defect statement for the intermediate block on
`Q C_G(Q)` without invoking First Main or Third Main. -/
theorem exists_maximalSupport_qcCentralizerEmbedding_containing
    [Fact (Nat.Prime 2)]
    {R : Type*} {G : Type u} [Semiring R] [Group G] [Finite G]
    (Q : Subgroup G) (hQ : IsPGroup 2 Q)
    (b : MonoidAlgebra R (Subgroup.centralizer (Q : Set G)))
    (hb : b ≠ 0) :
    ∃ D : Subgroup (qcCentralizer Q),
      DefectSupport.IsMaximalTwoCoefficientSupport
          (qcCentralizerAlgebraEmbedding R Q b) D ∧
        Q.subgroupOf (qcCentralizer Q) ≤ D := by
  let e := qcCentralizerAlgebraEmbedding R Q b
  have he : e ≠ 0 := qcCentralizerAlgebraEmbedding_ne_zero Q b hb
  obtain ⟨D, hD⟩ :=
    DefectSupport.exists_isMaximalTwoCoefficientSupport e he
  have hQsub : IsPGroup 2 (Q.subgroupOf (qcCentralizer Q)) :=
    hQ.of_equiv (Subgroup.subgroupOfEquivOfLe
      (H := Q) (K := qcCentralizer Q) le_sup_left).symm
  have hQnormal : (Q.subgroupOf (qcCentralizer Q)).Normal := by
    rw [qcCentralizer, sup_comm]
    exact Subgroup.normal_subgroupOf_sup_of_le_normalizer
      (Subgroup.centralizer_le_normalizer (Q : Set G))
  refine ⟨D, hD, ?_⟩
  exact
    DefectSupport.normalTwoSubgroup_le_of_isMaximalTwoCoefficientSupport_of_coeff_centralizes
      e D hD (Q.subgroupOf (qcCentralizer Q)) hQsub hQnormal
      (fun x hx =>
        coeff_centralizes_subgroupOf_qcCentralizer_of_embedding_ne_zero
          Q b x hx)

/-- `Q C_G(Q)` is contained in `N_G(Q)`. -/
theorem qcCentralizer_le_normalizer
    {G : Type u} [Group G] (Q : Subgroup G) :
    qcCentralizer Q ≤ Subgroup.normalizer Q := by
  exact sup_le Subgroup.le_normalizer
    (Subgroup.centralizer_le_normalizer (Q : Set G))

/-- The subgroup `Q C_G(Q)` is normal in `N_G(Q)`.  This is the subgroup
tower behind the intermediate block in the First Main/Nagao argument. -/
theorem qcCentralizer_subgroupOf_normalizer_isNormal
    {G : Type u} [Group G] (Q : Subgroup G) :
    (qcCentralizer Q).subgroupOf (Subgroup.normalizer Q) |>.Normal := by
  have hQ : Q ≤ Subgroup.normalizer Q := Subgroup.le_normalizer
  have hC : Subgroup.centralizer (Q : Set G) ≤
      Subgroup.normalizer Q :=
    Subgroup.centralizer_le_normalizer (Q : Set G)
  rw [qcCentralizer, Subgroup.subgroupOf_sup hQ hC]
  infer_instance

/-- The `Q` factor is normal in `Q C_G(Q)`. -/
theorem subgroupOf_qcCentralizer_isNormal
    {G : Type u} [Group G] (Q : Subgroup G) :
    (Q.subgroupOf (qcCentralizer Q)).Normal := by
  rw [qcCentralizer, sup_comm]
  exact Subgroup.normal_subgroupOf_sup_of_le_normalizer
    (Subgroup.centralizer_le_normalizer (Q : Set G))

/-- The centralizer factor is also normal in `Q C_G(Q)`. -/
theorem centralizer_subgroupOf_qcCentralizer_isNormal
    {G : Type u} [Group G] (Q : Subgroup G) :
    ((Subgroup.centralizer (Q : Set G)).subgroupOf
      (qcCentralizer Q)).Normal := by
  have hQ : Q ≤ Subgroup.normalizer
      (Subgroup.centralizer (Q : Set G)) := by
    letI :
        ((Subgroup.centralizer (Q : Set G)).subgroupOf
          (Subgroup.normalizer (Q : Set G))).Normal := inferInstance
    have hNle : Subgroup.normalizer (Q : Set G) ≤
        Subgroup.normalizer
          ((Subgroup.centralizer (Q : Set G)) : Set G) :=
      Subgroup.le_normalizer_of_normal_subgroupOf
        (H := Subgroup.centralizer (Q : Set G))
        (K := Subgroup.normalizer (Q : Set G))
        (Subgroup.centralizer_le_normalizer (Q : Set G))
    exact Subgroup.le_normalizer.trans hNle
  exact Subgroup.normal_subgroupOf_sup_of_le_normalizer hQ

/-- If `Q` is a subgroup of `H` and `C_G(Q) ≤ H`, then the whole subgroup
`Q C_G(Q)` lies in `H`.  Here `Q` is presented as a subgroup of `H`, as in
the admissible witness produced by `ThirdMainReduction`. -/
theorem qcCentralizer_le_of_ambientCentralizer_le
    {G : Type u} [Group G]
    (H : Subgroup G) (Q : Subgroup H)
    (hC : Subgroup.centralizer
        ((Q.map H.subtype : Subgroup G) : Set G) ≤ H) :
    qcCentralizer (Q.map H.subtype : Subgroup G) ≤ H := by
  exact sup_le (Subgroup.map_subtype_le Q) hC

/-- The exact subgroup tower used before applying First Main: an admissible
`Q C_G(Q)` lies simultaneously in `H` and in `N_G(Q)`. -/
theorem qcCentralizer_le_inf_of_ambientCentralizer_le
    {G : Type u} [Group G]
    (H : Subgroup G) (Q : Subgroup H)
    (hC : Subgroup.centralizer
        ((Q.map H.subtype : Subgroup G) : Set G) ≤ H) :
    qcCentralizer (Q.map H.subtype : Subgroup G) ≤
      H ⊓ Subgroup.normalizer (Q.map H.subtype : Subgroup G) := by
  exact le_inf
    (qcCentralizer_le_of_ambientCentralizer_le H Q hC)
    (qcCentralizer_le_normalizer (Q.map H.subtype : Subgroup G))

/-- If `Q` is properly contained in a Sylow `p`-subgroup `P`, then
`N_G(Q)` contains a strictly larger `p`-subgroup.

The proof applies the normalizer condition inside the finite `p`-group `P`
and maps the resulting subgroup back to `G`. -/
theorem exists_strict_supergroup_le_normalizer_of_lt_sylow
    {p : ℕ} [Fact (Nat.Prime p)]
    {G : Type u} [Group G] [Finite G]
    (Q : Subgroup G) (P : Sylow p G)
    (hQP : Q < (P : Subgroup G)) :
    ∃ R : Subgroup G,
      IsPGroup p R ∧
        Q < R ∧
        R ≤ Subgroup.normalizer Q ∧
        Nat.card Q < Nat.card R := by
  let QP : Subgroup P := Q.subgroupOf (P : Subgroup G)
  have hQPproper : QP < ⊤ := by
    rw [lt_top_iff_ne_top]
    intro htop
    exact (not_le_of_gt hQP) (Subgroup.subgroupOf_eq_top.mp htop)
  letI : Group.IsNilpotent P := P.isPGroup'.isNilpotent
  have hnormalizer : QP < Subgroup.normalizer QP :=
    Group.normalizerCondition_of_isNilpotent QP hQPproper
  let R : Subgroup G :=
    (Subgroup.normalizer QP).map (P : Subgroup G).subtype
  have hRp : IsPGroup p R := by
    exact (P.isPGroup'.to_subgroup (Subgroup.normalizer QP)).map
      (P : Subgroup G).subtype
  have hQR : Q < R := by
    have hmap : QP.map (P : Subgroup G).subtype < R := by
      exact (Subgroup.map_subtype_lt_map_subtype).2 hnormalizer
    simpa [QP, R, Subgroup.map_subgroupOf_eq_of_le hQP.le] using hmap
  have hRN : R ≤ Subgroup.normalizer Q := by
    have hmap := Subgroup.le_normalizer_map
      (H := QP) (P : Subgroup G).subtype
    simpa [QP, R, Subgroup.map_subgroupOf_eq_of_le hQP.le] using hmap
  have hcard : Nat.card Q < Nat.card R := by
    apply lt_of_le_of_ne (Subgroup.card_le_of_le hQR.le)
    intro heq
    apply hQR.ne
    exact Subgroup.eq_of_le_of_card_ge hQR.le (by rw [heq])
  exact ⟨R, hRp, hQR, hRN, hcard⟩

/-- Every finite `p`-subgroup is either Sylow or admits strict `p`-subgroup
growth inside its normalizer. -/
theorem exists_sylow_eq_or_exists_strict_supergroup_le_normalizer
    {p : ℕ} [Fact (Nat.Prime p)]
    {G : Type u} [Group G] [Finite G]
    (Q : Subgroup G) (hQ : IsPGroup p Q) :
    (∃ P : Sylow p G, (P : Subgroup G) = Q) ∨
      ∃ R : Subgroup G,
        IsPGroup p R ∧
          Q < R ∧
          R ≤ Subgroup.normalizer Q ∧
          Nat.card Q < Nat.card R := by
  obtain ⟨P, hQP⟩ := hQ.exists_le_sylow
  by_cases heq : (P : Subgroup G) = Q
  · exact Or.inl ⟨P, heq⟩
  · right
    exact exists_strict_supergroup_le_normalizer_of_lt_sylow Q P
      (lt_of_le_of_ne hQP (fun h => heq h.symm))

end NormalizerBrauerPair
