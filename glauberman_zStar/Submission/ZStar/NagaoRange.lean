import Submission.ZStar.HigmanRange
import Submission.ZStar.ExactRelativeTrace
import Submission.ZStar.LeftIdealHigman
import Submission.ZStar.CentralIdempotentSupport

/-!
# The characterwise Nagao range

This file transports the exact order-two relative-trace identity from the
group algebra through an arbitrary integral representation.  The resulting
idempotent range is projective over the cyclic subgroup generated by the
involution.  This is the representation-level Higman bridge needed after an
integral stable lattice has been chosen.
-/

noncomputable section

namespace Submission.ZStar
namespace NagaoRange

universe u v w

attribute [local instance] Fintype.ofFinite

/-- The representation obtained by restricting along a monoid homomorphism.
The named wrapper keeps Lean from resolving later projections on `rho.comp phi`
as projections on a bare `MonoidHom`. -/
def restrictedRepresentation
    {R : Type u} {P : Type v} {G : Type w} {V : Type*}
    [CommRing R] [Monoid P] [Monoid G]
    [AddCommGroup V] [Module R V]
    (rho : Representation R G V) (phi : P →* G) :
    Representation R P V :=
  rho.comp phi

/-- Regard an endomorphism of the representation space as an `R`-linear
endomorphism of the bundled module underlying a restricted representation. -/
def transportedEnd
    {R : Type u} {P : Type v} {V : Type w}
    [CommRing R] [Monoid P]
    [AddCommGroup V] [Module R V]
    (sigma : Representation R P V) (T : Module.End R V) :
    sigma.asModule →ₗ[R] sigma.asModule :=
  sigma.asModuleEquiv.symm.toLinearMap.comp
    (T.comp sigma.asModuleEquiv.toLinearMap)

@[simp] theorem transportedEnd_apply
    {R : Type u} {P : Type v} {V : Type w}
    [CommRing R] [Monoid P]
    [AddCommGroup V] [Module R V]
    (sigma : Representation R P V) (T : Module.End R V)
    (x : sigma.asModule) :
    sigma.asModuleEquiv (transportedEnd sigma T x) =
      T (sigma.asModuleEquiv x) :=
  rfl

/-- A group-algebra element commuting with the subgroup action gives an
endomorphism over the subgroup algebra. -/
def commutingGroupAlgebraEnd
    {R : Type u} {P : Type v} {G : Type w} {V : Type*}
    [CommRing R] [Group P] [Group G]
    [AddCommGroup V] [Module R V]
    (rho : Representation R G V) (phi : P →* G)
    (f : MonoidAlgebra R G)
    (hcomm : ∀ s : P, Commute f (MonoidAlgebra.of R G (phi s))) :
    Module.End (MonoidAlgebra R P)
      (restrictedRepresentation rho phi).asModule :=
  Representation.IntertwiningMap.equivAlgEnd
    (restrictedRepresentation rho phi)
    { toLinearMap := rho.asAlgebraHom f
      isIntertwining' := by
        intro s
        change rho.asAlgebraHom f * rho (phi s) =
          rho (phi s) * rho.asAlgebraHom f
        rw [← Representation.asAlgebraHom_single_one (ρ := rho) (phi s)]
        change rho.asAlgebraHom f *
              rho.asAlgebraHom (MonoidAlgebra.single (phi s) (1 : R)) =
            rho.asAlgebraHom (MonoidAlgebra.single (phi s) (1 : R)) *
              rho.asAlgebraHom f
        rw [← map_mul, ← map_mul]
        exact congrArg rho.asAlgebraHom (hcomm s).eq }

@[simp] theorem commutingGroupAlgebraEnd_apply
    {R : Type u} {P : Type v} {G : Type w} {V : Type*}
    [CommRing R] [Group P] [Group G]
    [AddCommGroup V] [Module R V]
    (rho : Representation R G V) (phi : P →* G)
    (f : MonoidAlgebra R G)
    (hcomm : ∀ s : P, Commute f (MonoidAlgebra.of R G (phi s)))
    (x : (restrictedRepresentation rho phi).asModule) :
    (restrictedRepresentation rho phi).asModuleEquiv
        (commutingGroupAlgebraEnd rho phi f hcomm x) =
      rho.asAlgebraHom f
        ((restrictedRepresentation rho phi).asModuleEquiv x) :=
  rfl

/-- The representation-level form of the order-two Brauer-kernel/Higman
argument. -/
theorem projective_range_of_fixed_coeff_mem_maximalIdeal
    {R : Type u} {G : Type v} {V : Type w}
    [CommRing R] [IsLocalRing R] [Group G] [Finite G]
    [AddCommGroup V] [Module R V] [Module.Free R V] [Module.Finite R V]
    (rho : Representation R G V)
    (z : G) (hzne : z ≠ 1) (hz : z * z = 1)
    (f : MonoidAlgebra R G) (hf : IsIdempotentElem f)
    (hfinv : BrauerKernelRelativeTrace.conjugation R z f = f)
    (hfixed : ∀ x : G, z⁻¹ * x * z = x →
      f x ∈ IsLocalRing.maximalIdeal R) :
    let P := Subgroup.zpowers z
    let hcomm := LeftIdealHigman.commute_zpowers_of_conjugation_fixed
      z hzne hz f hfinv
    let E := commutingGroupAlgebraEnd rho P.subtype f hcomm
    Module.Projective (MonoidAlgebra R P) (LinearMap.range E) := by
  classical
  dsimp only
  let P : Subgroup G := Subgroup.zpowers z
  letI : Fintype P := Fintype.ofFinite P
  let phi : P →* G := P.subtype
  let sigma : Representation R P V := restrictedRepresentation rho phi
  let hcomm : ∀ s : P,
      Commute f (MonoidAlgebra.of R G (phi s)) :=
    LeftIdealHigman.commute_zpowers_of_conjugation_fixed
      z hzne hz f hfinv
  let E : Module.End (MonoidAlgebra R P) sigma.asModule :=
    commutingGroupAlgebraEnd rho phi f hcomm
  have hE_apply (x : sigma.asModule) :
      sigma.asModuleEquiv (E x) =
        rho.asAlgebraHom f (sigma.asModuleEquiv x) := by
    simpa only [E, sigma] using
      commutingGroupAlgebraEnd_apply rho phi f hcomm x
  have hE_restrict_apply (x : sigma.asModule) :
      sigma.asModuleEquiv ((E.restrictScalars R) x) =
        rho.asAlgebraHom f (sigma.asModuleEquiv x) := by
    simpa only [LinearMap.restrictScalars_apply] using hE_apply x
  have hE : IsIdempotentElem E := by
    apply LinearMap.ext
    intro x
    apply sigma.asModuleEquiv.injective
    simp only [Module.End.mul_apply]
    rw [hE_apply, hE_apply]
    simpa only [map_mul, Module.End.mul_apply] using
      LinearMap.congr_fun (congrArg rho.asAlgebraHom hf)
        (sigma.asModuleEquiv x)
  obtain ⟨c, hcorner, htrace⟩ :=
    ExactRelativeTrace.exists_exact_relativeTrace_of_fixed_coeff_mem_maximalIdeal
      z hz f hf hfinv hfixed
  let a : sigma.asModule →ₗ[R] sigma.asModule :=
    transportedEnd sigma (rho.asAlgebraHom c)
  have ha_apply (x : sigma.asModule) :
      sigma.asModuleEquiv (a x) =
        rho.asAlgebraHom c (sigma.asModuleEquiv x) := by
    exact transportedEnd_apply sigma (rho.asAlgebraHom c) x
  have hcornerEnd :
      (E.restrictScalars R).comp (a.comp (E.restrictScalars R)) = a := by
    apply LinearMap.ext
    intro x
    apply sigma.asModuleEquiv.injective
    simp only [LinearMap.comp_apply]
    rw [hE_restrict_apply, ha_apply, hE_restrict_apply, ha_apply]
    simpa only [map_mul, Module.End.mul_apply] using
      LinearMap.congr_fun (congrArg rho.asAlgebraHom hcorner)
        (sigma.asModuleEquiv x)
  have hzord : orderOf z = 2 := by
    apply orderOf_eq_prime (p := 2)
    · rw [pow_two, hz]
    · exact hzne
  have hPcard : Nat.card P = 2 := by
    dsimp [P]
    rw [Nat.card_zpowers, hzord]
  let zP : P := ⟨z, Subgroup.mem_zpowers z⟩
  have hphizP : phi zP = z := rfl
  have hzPne : zP ≠ 1 := by
    intro h
    exact hzne (congrArg Subtype.val h)
  obtain ⟨q, hq, hunique⟩ := (Nat.card_eq_two_iff' (1 : P)).mp hPcard
  have hall (s : P) : s = 1 ∨ s = zP := by
    by_cases hs : s = 1
    · exact Or.inl hs
    · exact Or.inr ((hunique s hs).trans (hunique zP hzPne).symm)
  have huniv : (Finset.univ : Finset P) = {1, zP} := by
    ext s
    simp only [Finset.mem_univ, true_iff, Finset.mem_insert,
      Finset.mem_singleton]
    exact hall s
  have hzinv : z⁻¹ = z := inv_eq_of_mul_eq_one_right hz
  have ha_conjugate_apply (s : P) (x : sigma.asModule) :
      sigma.asModuleEquiv (a.conjugate s x) =
        rho.asAlgebraHom
          (MonoidAlgebra.of R G (phi s)⁻¹ * c *
            MonoidAlgebra.of R G (phi s))
          (sigma.asModuleEquiv x) := by
    rw [LinearMap.conjugate_apply]
    simp only [Representation.single_smul, one_smul]
    rw [ha_apply]
    change rho (phi s)⁻¹
        (rho.asAlgebraHom c (rho (phi s) (sigma.asModuleEquiv x))) = _
    simpa only [map_inv, Representation.asAlgebraHom_of, map_mul,
      Module.End.mul_apply]
  have htraceEnd : ∑ s : P, a.conjugate s = E.restrictScalars R := by
    apply LinearMap.ext
    intro x
    apply sigma.asModuleEquiv.injective
    rw [huniv, Finset.sum_pair hzPne.symm]
    simp only [LinearMap.add_apply, map_add]
    rw [ha_conjugate_apply, ha_conjugate_apply, hE_restrict_apply]
    simp only [map_one, inv_one, one_mul, mul_one]
    rw [hphizP, hzinv]
    have htrace' := htrace
    rw [LeftIdealHigman.conjugation_eq_group_elements_mul, hzinv] at htrace'
    simpa only [map_add, LinearMap.add_apply] using
      LinearMap.congr_fun (congrArg rho.asAlgebraHom htrace'.symm)
        (sigma.asModuleEquiv x)
  letI : Module.Free R sigma.asModule :=
    Module.Free.of_equiv sigma.asModuleEquiv.symm
  letI : Module.Finite R sigma.asModule :=
    Module.Finite.equiv sigma.asModuleEquiv.symm
  have hEres : IsIdempotentElem (E.restrictScalars R) := by
    apply LinearMap.ext
    intro x
    simpa only [Module.End.mul_apply, LinearMap.restrictScalars_apply] using
      LinearMap.congr_fun hE x
  letI : Module.Free R (LinearMap.range E) :=
    by
      change Module.Free R (LinearMap.range (E.restrictScalars R))
      exact
        CentralIdempotentSupport.free_range_of_isIdempotentElem_of_isLocalRing
          (E.restrictScalars R) hEres
  exact HigmanRange.projective_range_of_relative_trace
    E hE a hcornerEnd htraceEnd

end NagaoRange
end Submission.ZStar
