import Submission.ZStar.NagaoComplement
import Submission.ZStar.NagaoRange

/-!
# The projective range of the principal Nagao complement

This file specializes the representation-level Higman bridge to the concrete
complement between the ambient localized principal-block selector and the
compatible centralizer selector.  The remaining block-theoretic input is
displayed explicitly as the principal Brauer equality.
-/

noncomputable section

namespace Submission.ZStar
namespace NagaoPrincipalRange

open PrincipalBlockConstruction

universe u v w

attribute [local instance] Fintype.ofFinite

private instance principalPrime_isPrime
    {G : Type v} [Group G] [Finite G]
    (d : PrincipalCongruenceBlockData G) : d.primeIdeal.IsPrime :=
  d.primeIdeal_maximal.isPrime

/-- Once the principal Brauer selector is identified with the compatible
local principal selector, the represented Nagao complement has projective
image over the cyclic group algebra generated by the involution. -/
theorem projective_range_principalComplement_of_brauer_eq
    {G : Type v} {V : Type w} [Group G] [Finite G]
    (d : PrincipalCongruenceBlockData G)
    [AddCommGroup V]
    [Module (Localization.AtPrime d.primeIdeal) V]
    [Module.Free (Localization.AtPrime d.primeIdeal) V]
    [Module.Finite (Localization.AtPrime d.primeIdeal) V]
    (rho : Representation (Localization.AtPrime d.primeIdeal) G V)
    (z : G) (hzne : z ≠ 1) (hz : z * z = 1)
    (heq :
      BrauerBlockReduction.involutionBrauerPrincipalBlockElement d z =
        CompatibleBrauerBlock.localPrincipalBlockElementInAmbientResidue d
          (Subgroup.centralizer ({z} : Set G))) :
    let P := Subgroup.zpowers z
    let hcomm := LeftIdealHigman.commute_zpowers_of_conjugation_fixed
      z hzne hz (NagaoComplement.principalComplement d z)
        (NagaoComplement.conjugation_principalComplement d z)
    let E := NagaoRange.commutingGroupAlgebraEnd rho P.subtype
      (NagaoComplement.principalComplement d z) hcomm
    Module.Projective
      (MonoidAlgebra (Localization.AtPrime d.primeIdeal) P)
      (LinearMap.range E) := by
  have hfactor :
      CompatibleBrauerBlock.localPrincipalBlockElementInAmbientResidue d
            (Subgroup.centralizer ({z} : Set G)) *
          BrauerBlockReduction.involutionBrauerPrincipalBlockElement d z =
        CompatibleBrauerBlock.localPrincipalBlockElementInAmbientResidue d
          (Subgroup.centralizer ({z} : Set G)) := by
    rw [heq]
    exact
      (CompatibleBrauerBlock.localPrincipalBlockElementInAmbientResidue_isIdempotent
        d (Subgroup.centralizer ({z} : Set G))).eq
  have hfixed : ∀ x : G, z⁻¹ * x * z = x →
      NagaoComplement.principalComplement d z x ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime d.primeIdeal) :=
    (NagaoComplement.fixed_coeff_mem_maximalIdeal_principalComplement_iff
      d z hfactor).2 heq
  exact NagaoRange.projective_range_of_fixed_coeff_mem_maximalIdeal
    rho z hzne hz (NagaoComplement.principalComplement d z)
      (NagaoComplement.principalComplement_isIdempotent d z)
      (NagaoComplement.conjugation_principalComplement d z) hfixed

end NagaoPrincipalRange
end Submission.ZStar

