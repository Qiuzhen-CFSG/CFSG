import Submission.ZStar.LocalBlockSection

noncomputable section

namespace Submission.ZStar.CentralCase

open Submission.ZStar
open Submission.ZStar.LocalBlockSection
open Submission.ZStar.PrincipalBlockConstruction
open Submission.ZStar.BlockPreliminaries

universe u v

attribute [local instance] Fintype.ofFinite

variable {G : Type u} [Group G] [Finite G]

/-- When `z` is central, the singleton centralizer is equivalent to the
ambient group via the subtype inclusion. -/
noncomputable def centralizerSubtypeMulEquiv
    (z : G) (hz : z ∈ Subgroup.center G) :
    Subgroup.centralizer ({z} : Set G) ≃* G where
  toFun := (Subgroup.centralizer ({z} : Set G)).subtype
  invFun g := ⟨g, by
    rw [Subgroup.mem_centralizer_singleton_iff]
    exact (Subgroup.mem_center_iff.mp hz) g⟩
  left_inv x := rfl
  right_inv g := rfl
  map_mul' x y := rfl

omit [Finite G] in
private theorem center_apply_eq_smul_id
    {n : ℕ}
    (rho : Representation ℂ G (Fin n → ℂ))
    (hirr : Representation.IsIrreducible rho)
    {z : G} (hz : z ∈ Subgroup.center G) :
    ∃ a : ℂ, (rho z : Module.End ℂ (Fin n → ℂ)) = a • 1 := by
  letI : Representation.IsIrreducible rho := hirr
  let phi := Representation.IntertwiningMap.centralMul (ρ := rho) z (by
    rw [Submonoid.mem_center_iff]
    intro g
    exact (Subgroup.mem_center_iff.mp hz) g)
  obtain ⟨a, ha⟩ :=
    (Representation.IsIrreducible.algebraMap_intertwiningMap_bijective_of_isAlgClosed
      (ρ := rho)).surjective phi
  refine ⟨a, ?_⟩
  have hlin :
      ((algebraMap ℂ (Representation.IntertwiningMap rho rho) a :
          Representation.IntertwiningMap rho rho) : Module.End ℂ (Fin n → ℂ)) =
        (phi : Module.End ℂ (Fin n → ℂ)) := by
    simpa using congrArg
      (fun f : Representation.IntertwiningMap rho rho =>
        (f : Module.End ℂ (Fin n → ℂ))) ha
  calc
    (rho z : Module.End ℂ (Fin n → ℂ)) = (phi : Module.End ℂ (Fin n → ℂ)) := rfl
    _ = ((algebraMap ℂ (Representation.IntertwiningMap rho rho) a :
        Representation.IntertwiningMap rho rho) : Module.End ℂ (Fin n → ℂ)) := hlin.symm
    _ = a • (1 : Module.End ℂ (Fin n → ℂ)) := by
      ext v
      simp [Representation.IntertwiningMap.algebraMap_apply]

/-- Conjugacy classes are transported by a multiplicative equivalence. -/
noncomputable def conjClassesMulEquiv
    {H : Type v} [Group H] (f : H ≃* G) :
    ConjClasses H ≃ ConjClasses G where
  toFun := ConjClasses.map f.toMonoidHom
  invFun := ConjClasses.map f.symm.toMonoidHom
  left_inv c := by
    rcases ConjClasses.exists_rep c with ⟨x, rfl⟩
    change ConjClasses.mk (f.symm (f x)) = ConjClasses.mk x
    simp
  right_inv c := by
    rcases ConjClasses.exists_rep c with ⟨x, rfl⟩
    change ConjClasses.mk (f (f.symm x)) = ConjClasses.mk x
    simp

omit [Finite G] in
@[simp] theorem conjClassesMulEquiv_mk
    {H : Type v} [Group H] (f : H ≃* G) (x : H) :
    conjClassesMulEquiv f (ConjClasses.mk x) = ConjClasses.mk (f x) := rfl

omit [Finite G] in
/-- The class-carrier cardinal is preserved under group equivalence. -/
theorem natCard_conjClass_carrier_mulEquiv
    {H : Type v} [Group H] [Finite H]
    (f : H ≃* G) (c : ConjClasses H) :
    Nat.card c.carrier =
      Nat.card (conjClassesMulEquiv f c).carrier := by
  let ec : c.carrier ≃ (conjClassesMulEquiv f c).carrier :=
    f.toEquiv.subtypeEquiv (fun x => by
      rw [ConjClasses.mem_carrier_iff_mk_eq,
        ConjClasses.mem_carrier_iff_mk_eq]
      change ConjClasses.mk x = c ↔
        conjClassesMulEquiv f (ConjClasses.mk x) =
          conjClassesMulEquiv f c
      exact (conjClassesMulEquiv f).injective.eq_iff.symm)
  exact Nat.card_congr ec

/-- Primitive roots associated with equivalent finite groups generate the
same cyclotomic order inside `ℂ`. -/
theorem cyclotomicOrder_eq_of_mulEquiv
    {H : Type v} [Group H] [Finite H]
    (f : H ≃* G) {etaG etaH : ℂ}
    (hetaG : IsPrimitiveRoot etaG (Nat.card G))
    (hetaH : IsPrimitiveRoot etaH (Nat.card H)) :
    Representation.cyclotomicOrder etaG =
      Representation.cyclotomicOrder etaH := by
  have hcard : Nat.card H = Nat.card G := Nat.card_congr f.toEquiv
  have hGne : Nat.card G ≠ 0 := (Nat.card_pos (α := G)).ne'
  have hHne : Nat.card H ≠ 0 := (Nat.card_pos (α := H)).ne'
  apply le_antisymm
  · rw [Representation.cyclotomicOrder, Subring.closure_le]
    intro x hx
    simp only [Set.mem_singleton_iff] at hx
    subst x
    exact Representation.primitive_root_mem_cyclotomicOrder_of_dvd
      hetaH hHne hetaG (by rw [hcard])
  · rw [Representation.cyclotomicOrder, Subring.closure_le]
    intro x hx
    simp only [Set.mem_singleton_iff] at hx
    subst x
    exact Representation.primitive_root_mem_cyclotomicOrder_of_dvd
      hetaG hGne hetaH (by rw [hcard])

/-- The identity-on-complex-values ring equivalence between cyclotomic
orders generated by primitive roots for equivalent finite groups. -/
noncomputable def cyclotomicOrderMulEquiv
    {H : Type v} [Group H] [Finite H]
    (f : H ≃* G) {etaG etaH : ℂ}
    (hetaG : IsPrimitiveRoot etaG (Nat.card G))
    (hetaH : IsPrimitiveRoot etaH (Nat.card H)) :
    Representation.cyclotomicOrder etaG ≃+*
      Representation.cyclotomicOrder etaH :=
  RingEquiv.subringCongr
    (cyclotomicOrder_eq_of_mulEquiv f hetaG hetaH)

/-- Transport a class function across a group equivalence. -/
def transportClassFunction
    {H : Type v} [Group H]
    (f : H ≃* G) (χ : Representation.ClassFunction G) :
    Representation.ClassFunction H :=
  fun c => χ (conjClassesMulEquiv f c)

private theorem exists_localSection_eq_smul_transport
    (d : PrincipalCongruenceBlockData G) (i : d.I) (z : G)
    (hz : z ∈ Subgroup.center G) :
    ∃ a : ℂ,
      localSectionClassFunction d i z =
        a • transportClassFunction
          (centralizerSubtypeMulEquiv z hz) (d.chi i) := by
  classical
  rcases (d.complete.1 i).1 with ⟨n, rho, hchar⟩
  have hirr : Representation.IsIrreducible rho := by
    apply (Representation.irreducible_iff_character_norm_one (ρ := rho)).2
    simpa [hchar] using (d.complete.1 i).2
  obtain ⟨a, ha⟩ := center_apply_eq_smul_id rho hirr hz
  refine ⟨a, ?_⟩
  ext c
  rcases ConjClasses.exists_rep c with ⟨x, rfl⟩
  rw [localSectionClassFunction_mk]
  change d.chi i (ConjClasses.mk (z * (x : G))) =
    a * d.chi i (ConjClasses.mk ((centralizerSubtypeMulEquiv z hz) x))
  rw [hchar]
  change rho.character (z * (x : G)) =
    a * rho.character ((centralizerSubtypeMulEquiv z hz) x)
  simp only [Representation.character, map_mul, ha]
  rw [LinearMap.trace_mul_comm]
  simp [centralizerSubtypeMulEquiv]

theorem transportClassFunction_character
    {H : Type v} [Group H] [Finite H]
    (f : H ≃* G) {χ : Representation.ClassFunction G}
    (hχ : Representation.IsCharacter χ) :
    ∃ n : ℕ, ∃ ρ : Representation ℂ H (Fin n → ℂ),
      transportClassFunction f χ = ρ.characterClassFunction := by
  rcases hχ with ⟨n, ρ, hρ⟩
  let σ : Representation ℂ H (Fin n → ℂ) := ρ.comp f.toMonoidHom
  refine ⟨n, σ, ?_⟩
  ext c
  rcases ConjClasses.exists_rep c with ⟨x, rfl⟩
  change χ (ConjClasses.mk (f x)) = σ.character x
  rw [hρ]
  rfl

theorem transportClassFunction_isIrreducibleCharacter
    {H : Type v} [Group H] [Finite H]
    (f : H ≃* G) {χ : Representation.ClassFunction G}
    (hχ : Representation.IsIrreducibleCharacter χ) :
    Representation.IsIrreducibleCharacter (transportClassFunction f χ) := by
  rcases hχ.1 with ⟨n, ρ, hρ⟩
  have hirr : Representation.IsIrreducible ρ := by
    apply (Representation.irreducible_iff_character_norm_one (ρ := ρ)).2
    simpa [hρ] using hχ.2
  let σ : Representation ℂ H (Fin n → ℂ) := ρ.comp f.toMonoidHom
  have hirrσ : Representation.IsIrreducible σ := by
    exact Section6.representation_isIrreducible_comp_surjective
      ρ f.toMonoidHom f.surjective hirr
  have hcharσ := Representation.isIrreducibleCharacter_characterClassFunction σ hirrσ
  have heq : transportClassFunction f χ = σ.characterClassFunction := by
    ext c
    rcases ConjClasses.exists_rep c with ⟨x, rfl⟩
    change χ (ConjClasses.mk (f x)) = ρ.character (f x)
    rw [hρ]
    rfl
  rw [heq]
  exact hcharσ

theorem ordinaryCentralCharacterValue_transport
    {H : Type v} [Group H] [Finite H]
    (f : H ≃* G) {χ : Representation.ClassFunction G}
    (_hχ : Representation.IsIrreducibleCharacter χ)
    (c : ConjClasses H) :
    ordinaryCentralCharacterValue (transportClassFunction f χ) c =
      ordinaryCentralCharacterValue χ (conjClassesMulEquiv f c) := by
  unfold ordinaryCentralCharacterValue
  rw [natCard_conjClass_carrier_mulEquiv (f := f) (c := c)]
  change _ * χ (conjClassesMulEquiv f c) /
      χ (conjClassesMulEquiv f (ConjClasses.mk (1 : H))) = _
  rw [conjClassesMulEquiv_mk]
  simp

theorem cyclotomicOrderMulEquiv_centralCharacter
    {H : Type v} [Group H] [Finite H]
    (f : H ≃* G) {etaG etaH : ℂ}
    (hetaG : IsPrimitiveRoot etaG (Nat.card G))
    (hetaH : IsPrimitiveRoot etaH (Nat.card H))
    (χ : Representation.ClassFunction G)
    (hχ : Representation.IsIrreducibleCharacter χ)
    (c : ConjClasses H) :
    cyclotomicOrderMulEquiv f hetaG hetaH
        (centralCharacterInCyclotomicOrder hetaG χ hχ
          (conjClassesMulEquiv f c)) =
      centralCharacterInCyclotomicOrder hetaH
        (transportClassFunction f χ)
        (transportClassFunction_isIrreducibleCharacter f hχ) c := by
  apply Subtype.ext
  exact (ordinaryCentralCharacterValue_transport f hχ c).symm

/-- Full transport of `SameTwoBlock`: a group equivalence and a change of
primitive root are harmless provided the target prime is the image of the
source prime under the induced cyclotomic-order equivalence. -/
theorem sameTwoBlock_transport_mapPrime_iff
    {H : Type v} [Group H] [Finite H]
    (f : H ≃* G) {etaG etaH : ℂ}
    (hetaG : IsPrimitiveRoot etaG (Nat.card G))
    (hetaH : IsPrimitiveRoot etaH (Nat.card H))
    (P : Ideal (Representation.cyclotomicOrder etaG))
    (χ ψ : Representation.ClassFunction G)
    (hχ : Representation.IsIrreducibleCharacter χ)
    (hψ : Representation.IsIrreducibleCharacter ψ) :
    SameTwoBlock hetaG P χ ψ hχ hψ ↔
      SameTwoBlock hetaH
        (P.map (cyclotomicOrderMulEquiv f hetaG hetaH))
        (transportClassFunction f χ) (transportClassFunction f ψ)
        (transportClassFunction_isIrreducibleCharacter f hχ)
        (transportClassFunction_isIrreducibleCharacter f hψ) := by
  let e := cyclotomicOrderMulEquiv f hetaG hetaH
  let hχH := transportClassFunction_isIrreducibleCharacter f hχ
  let hψH := transportClassFunction_isIrreducibleCharacter f hψ
  rw [sameTwoBlock_iff, sameTwoBlock_iff]
  constructor
  · intro hsame c
    have hmem := Ideal.mem_map_of_mem e (hsame (conjClassesMulEquiv f c))
    rw [e.map_sub,
      cyclotomicOrderMulEquiv_centralCharacter f hetaG hetaH χ hχ c,
      cyclotomicOrderMulEquiv_centralCharacter f hetaG hetaH ψ hψ c] at hmem
    exact hmem
  · intro hsame c
    let cH := (conjClassesMulEquiv f).symm c
    apply (Ideal.apply_mem_of_equiv_iff (f := e)).mp
    have hmem := hsame cH
    have hc : conjClassesMulEquiv f cH = c := by
      simp [cH]
    rw [← hc]
    rw [e.map_sub,
      cyclotomicOrderMulEquiv_centralCharacter f hetaG hetaH χ hχ cH,
      cyclotomicOrderMulEquiv_centralCharacter f hetaG hetaH ψ hψ cH]
    exact hmem

/-- With the same cyclotomic order and prime ideal, `SameTwoBlock` is
preserved and reflected by a group equivalence. -/
theorem sameTwoBlock_transport_iff
    {H : Type v} [Group H] [Finite H]
    (f : H ≃* G) {eta : ℂ}
    (hetaG : IsPrimitiveRoot eta (Nat.card G))
    (hetaH : IsPrimitiveRoot eta (Nat.card H))
    (P : Ideal (Representation.cyclotomicOrder eta))
    (χ ψ : Representation.ClassFunction G)
    (hχ : Representation.IsIrreducibleCharacter χ)
    (hψ : Representation.IsIrreducibleCharacter ψ) :
    SameTwoBlock hetaG P χ ψ hχ hψ ↔
      SameTwoBlock hetaH P
        (transportClassFunction f χ) (transportClassFunction f ψ)
        (transportClassFunction_isIrreducibleCharacter f hχ)
        (transportClassFunction_isIrreducibleCharacter f hψ) := by
  let hχH := transportClassFunction_isIrreducibleCharacter f hχ
  let hψH := transportClassFunction_isIrreducibleCharacter f hψ
  rw [sameTwoBlock_iff, sameTwoBlock_iff]
  constructor
  · intro hsame c
    have hχval :
        centralCharacterInCyclotomicOrder hetaH
            (transportClassFunction f χ) hχH c =
          centralCharacterInCyclotomicOrder hetaG χ hχ
            (conjClassesMulEquiv f c) := by
      apply Subtype.ext
      exact ordinaryCentralCharacterValue_transport f hχ c
    have hψval :
        centralCharacterInCyclotomicOrder hetaH
            (transportClassFunction f ψ) hψH c =
          centralCharacterInCyclotomicOrder hetaG ψ hψ
            (conjClassesMulEquiv f c) := by
      apply Subtype.ext
      exact ordinaryCentralCharacterValue_transport f hψ c
    rw [hχval, hψval]
    exact hsame (conjClassesMulEquiv f c)
  · intro hsame c
    let cH := (conjClassesMulEquiv f).symm c
    have hlocal := hsame cH
    have hχval :
        centralCharacterInCyclotomicOrder hetaH
            (transportClassFunction f χ) hχH cH =
          centralCharacterInCyclotomicOrder hetaG χ hχ c := by
      apply Subtype.ext
      change ordinaryCentralCharacterValue (transportClassFunction f χ) cH =
        ordinaryCentralCharacterValue χ c
      simpa [cH] using ordinaryCentralCharacterValue_transport f hχ cH
    have hψval :
        centralCharacterInCyclotomicOrder hetaH
            (transportClassFunction f ψ) hψH cH =
          centralCharacterInCyclotomicOrder hetaG ψ hψ c := by
      apply Subtype.ext
      change ordinaryCentralCharacterValue (transportClassFunction f ψ) cH =
        ordinaryCentralCharacterValue ψ c
      simpa [cH] using ordinaryCentralCharacterValue_transport f hψ cH
    rwa [hχval, hψval] at hlocal

/-- Ordinary block membership transports across a group equivalence when the
same primitive root and prime ideal are used; the two indexing families may
be unrelated. -/
theorem mem_ordinaryTwoBlock_transport
    {H : Type v} [Group H] [Finite H]
    {I J : Type*} [Fintype I] [DecidableEq I]
    [Fintype J] [DecidableEq J]
    (f : H ≃* G) {eta : ℂ}
    (hetaG : IsPrimitiveRoot eta (Nat.card G))
    (hetaH : IsPrimitiveRoot eta (Nat.card H))
    (P : Ideal (Representation.cyclotomicOrder eta))
    (χ : I → Representation.ClassFunction G)
    (ψ : J → Representation.ClassFunction H)
    (hχ : ∀ i, Representation.IsIrreducibleCharacter (χ i))
    (hψ : ∀ j, Representation.IsIrreducibleCharacter (ψ j))
    (base i : I) (base' j : J)
    (hi : i ∈ ordinaryTwoBlock hetaG P χ hχ base)
    (hbase : ψ base' = transportClassFunction f (χ base))
    (hij : ψ j = transportClassFunction f (χ i)) :
    j ∈ ordinaryTwoBlock hetaH P ψ hψ base' := by
  rw [mem_ordinaryTwoBlock_iff] at hi ⊢
  have htransport := (sameTwoBlock_transport_iff
    f hetaG hetaH P (χ i) (χ base) (hχ i) (hχ base)).mp hi
  simpa [hbase, hij] using htransport

/-- Ordinary block membership transports across a group equivalence and a
change of primitive root when the target prime is the image of the source
prime under the induced cyclotomic-order equivalence. -/
theorem mem_ordinaryTwoBlock_transport_mapPrime
    {H : Type v} [Group H] [Finite H]
    {I J : Type*} [Fintype I] [DecidableEq I]
    [Fintype J] [DecidableEq J]
    (f : H ≃* G) {etaG etaH : ℂ}
    (hetaG : IsPrimitiveRoot etaG (Nat.card G))
    (hetaH : IsPrimitiveRoot etaH (Nat.card H))
    (P : Ideal (Representation.cyclotomicOrder etaG))
    (χ : I → Representation.ClassFunction G)
    (ψ : J → Representation.ClassFunction H)
    (hχ : ∀ i, Representation.IsIrreducibleCharacter (χ i))
    (hψ : ∀ j, Representation.IsIrreducibleCharacter (ψ j))
    (base i : I) (base' j : J)
    (hi : i ∈ ordinaryTwoBlock hetaG P χ hχ base)
    (hbase : ψ base' = transportClassFunction f (χ base))
    (hij : ψ j = transportClassFunction f (χ i)) :
    j ∈ ordinaryTwoBlock hetaH
      (P.map (cyclotomicOrderMulEquiv f hetaG hetaH)) ψ hψ base' := by
  rw [mem_ordinaryTwoBlock_iff] at hi ⊢
  have htransport := (sameTwoBlock_transport_mapPrime_iff
    f hetaG hetaH P (χ i) (χ base) (hχ i) (hχ base)).mp hi
  simpa [hbase, hij] using htransport

private theorem localCoreSupport_of_section_eq_smul_mem
    (d : PrincipalCongruenceBlockData G) (i : d.I) (z : G)
    (e : PrincipalCongruenceBlockData
      (Subgroup.centralizer ({z} : Set G)))
    (j : e.I) (hj : j ∈ e.block) (a : ℂ)
    (hsection : localSectionClassFunction d i z = a • e.chi j) :
    LocalPrincipalBlockCoreSupport d i z e := by
  classical
  rcases Representation.completeFamily_form_basis e.complete with ⟨b, hb⟩
  intro x _hx
  apply Finset.sum_eq_zero
  intro k hk
  have hk_not_block : k ∉ e.block := (Finset.mem_sdiff.mp hk).2
  have hjk : j ≠ k := by
    intro h
    apply hk_not_block
    simpa [h] using hj
  have hinner :
      Representation.classFunctionInner
          (localSectionClassFunction d i z) (e.chi k) = 0 := by
    rw [hsection]
    rw [← Representation.completeFamily_basis_repr_eq_inner
      e.complete b hb (a • e.chi j) k]
    rw [← hb j]
    simp [map_smul, hjk]
  simp [hinner]

/-- Central-element support holds when the local cyclotomic prime is the
transport of the ambient prime through the centralizer equivalence. -/
theorem localPrincipalBlockCoreSupport_of_mem_center_of_mapped_prime
    (d : PrincipalCongruenceBlockData G) {i : d.I} (hi : i ∈ d.block)
    (z : G) (hz : z ∈ Subgroup.center G)
    (e : PrincipalCongruenceBlockData
      (Subgroup.centralizer ({z} : Set G)))
    (hprime : e.primeIdeal =
      d.primeIdeal.map (cyclotomicOrderMulEquiv
        (centralizerSubtypeMulEquiv z hz) d.eta_spec e.eta_spec)) :
    LocalPrincipalBlockCoreSupport d i z e := by
  classical
  let C := Subgroup.centralizer ({z} : Set G)
  let f : C ≃* G := centralizerSubtypeMulEquiv z hz
  let χC : Representation.ClassFunction C :=
    transportClassFunction f (d.chi i)
  have hχC : Representation.IsIrreducibleCharacter χC :=
    transportClassFunction_isIrreducibleCharacter f (d.complete.1 i)
  obtain ⟨j, hjchar⟩ := e.complete.2.1 χC hχC
  have hprincipal :
      e.chi e.principal =
        transportClassFunction f (d.chi d.principal) := by
    rw [e.principal_eq, d.principal_eq]
    ext c
    rcases ConjClasses.exists_rep c with ⟨x, rfl⟩
    simp [transportClassFunction, CharacterArgument.ordinaryPrincipalCharacter]
  have hjraw :
      j ∈ ordinaryTwoBlock e.eta_spec
        (d.primeIdeal.map
          (cyclotomicOrderMulEquiv f d.eta_spec e.eta_spec))
        e.chi e.complete.1 e.principal := by
    exact mem_ordinaryTwoBlock_transport_mapPrime
      f d.eta_spec e.eta_spec d.primeIdeal d.chi e.chi
        d.complete.1 e.complete.1 d.principal i e.principal j hi
        hprincipal hjchar
  have hj : j ∈ e.block := by
    change j ∈ ordinaryTwoBlock e.eta_spec e.primeIdeal
      e.chi e.complete.1 e.principal
    rw [hprime]
    exact hjraw
  obtain ⟨a, hsection⟩ := exists_localSection_eq_smul_transport d i z hz
  have hsection' : localSectionClassFunction d i z = a • e.chi j := by
    rw [hsection]
    exact congrArg (fun φ : Representation.ClassFunction C => a • φ) hjchar.symm
  exact localCoreSupport_of_section_eq_smul_mem d i z e j hj a hsection'

private theorem ideal_comap_eq_map_of_ringEquiv
    {A B : Type*} [CommRing A] [CommRing B]
    (P : Ideal A) (f : B →+* A) (E : A ≃+* B)
    (hf : f = E.symm.toRingHom) :
    P.comap f = P.map E :=
  (congrArg P.comap hf).trans (Ideal.map_symm E.symm).symm

/-- The compatible local datum has exactly the mapped ambient prime when the
centralizer inclusion is a group equivalence. -/
theorem compatibleCentralizer_primeIdeal_eq_map_of_mem_center
    (d : PrincipalCongruenceBlockData G) (z : G)
    (hz : z ∈ Subgroup.center G) :
    let e := compatibleCentralizerPrincipalCongruenceBlockData d z
    e.primeIdeal =
      d.primeIdeal.map (cyclotomicOrderMulEquiv
        (centralizerSubtypeMulEquiv z hz) d.eta_spec e.eta_spec) := by
  let C := Subgroup.centralizer ({z} : Set G)
  let f : C ≃* G := centralizerSubtypeMulEquiv z hz
  let e := compatibleCentralizerPrincipalCongruenceBlockData d z
  let E := cyclotomicOrderMulEquiv f d.eta_spec e.eta_spec
  have hhom :
      CompatibleLocalBlock.cyclotomicOrderInclusion
          (CompatibleLocalBlock.subgroupRoot_mem d C) =
        E.symm.toRingHom := by
    ext a
    rfl
  exact ideal_comap_eq_map_of_ringEquiv d.primeIdeal
    (CompatibleLocalBlock.cyclotomicOrderInclusion
      (CompatibleLocalBlock.subgroupRoot_mem d C)) E hhom

/-- The canonical local principal-block support theorem in the central
involution case.  In fact only centrality is used here; the involution
hypothesis is needed later when this support statement is applied to the
Z-star section. -/
theorem canonicalLocalPrincipalBlockCoreSupport_of_mem_center
    (d : PrincipalCongruenceBlockData G) {i : d.I} (hi : i ∈ d.block)
    (z : G) (hz : z ∈ Subgroup.center G) :
    CanonicalLocalPrincipalBlockCoreSupport d i z := by
  let e := compatibleCentralizerPrincipalCongruenceBlockData d z
  exact localPrincipalBlockCoreSupport_of_mem_center_of_mapped_prime
    d hi z hz e
      (compatibleCentralizer_primeIdeal_eq_map_of_mem_center d z hz)

end Submission.ZStar.CentralCase
