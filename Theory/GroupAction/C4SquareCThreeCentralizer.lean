module

public import Theory.GroupTheory.PGroup.RankTwoHomocyclicFrattini
public import Theory.GroupTheory.PGroup.FrattiniAutomorphismKernel
public import Theory.GroupTheory.CardFourAutomorphismStabilizer
public import Mathlib.GroupTheory.GroupAction.SubMulAction
public import Mathlib.Tactic


/-!
# Automorphisms centralizing an order-three automorphism of C4 squared

Let B be a finite group equivalent to C4 x C4. An order-three automorphism
of B is nontrivial, and a supplied two-subgroup C of MulAut B
centralizes it. Then |C| <= 4. Moreover, every point fixed by a nonidentity
automorphism centralizing that three-action has square one. The literal
automorphisms and subgroup are retained; no basis, faithful restricted action,
or desired bound is assumed.

The Frattini quotient of B is a Klein four. A nontrivial order-three action
therefore moves every nonidentity quotient point. Any primitive v fixed by a
centralizing automorphism c forces c to fix both v and a(v), hence all four
quotient points; the Frattini nongenerating property then gives c=1. Thus C
acts freely on the twelve primitive elements B \ Phi(B). Its cardinal divides
12, and its two-group hypothesis gives the bound four. The same primitive
fixed-point argument places every fixed point of a nonidentity commuting
automorphism in Phi(B). Since B is abelian of exponent four, its Frattini
subgroup is generated by squares, all of which lie in the square kernel.
This gives the fixed-point conclusion without a two-group hypothesis on
the commuting automorphism.

These results supply the automorphism-centralizer estimate and fixed-point
control used in Stellmacher (10.1)(a), printed p.61 of
`refs/files/stellmacher-n-group.pdf`.
-/

private theorem three_automorphism_moves_nonidentity
    {W : Type*} [Group W] [Finite W] (hW : Nat.card W = 4)
    (a : MulAut W) (ha : a ^ 3 = 1) (hne : a ≠ 1)
    (w : W) (hw : w ≠ 1) : a w ≠ w := by
  intro hfix
  let R := Subgroup.zpowers a
  have hR : Nat.card R = 3 := by
    rw [Nat.card_zpowers,orderOf_eq_prime ha hne]
  have hbound := card_mulAut_subgroup_le_two_of_fixed_point hW w hw R
    (fun b hb => smul_eq_self_of_mem_zpowers hb hfix)
  omega

private theorem quotient_three_nontrivial
    {B : Type*} [Group B] [Finite B] (hB : IsPGroup 2 B)
    (a : MulAut B) (ha : a ^ 3 = 1) (hne : a ≠ 1) :
    Subgroup.quotientAut (frattini B) a ≠ 1 := by
  intro hzero
  let K := (Subgroup.quotientAut (frattini B)).ker
  let x : K := ⟨a,hzero⟩
  have hK := Subgroup.isPGroup_quotientAut_frattini_kernel hB
  have hcop := hK.orderOf_coprime (by decide : Nat.Coprime 2 3) x
  have hdiv : orderOf x ∣ 3 := orderOf_dvd_of_pow_eq_one (Subtype.ext ha)
  have hx : x = 1 := orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes hcop (dvd_refl _) hdiv)
  exact hne (congrArg Subtype.val hx)

private theorem commuting_automorphism_eq_one_of_primitive_fixed
    {B : Type*} [Group B] [Finite B] (hB : IsPGroup 2 B)
    [IsKleinFour (B ⧸ frattini B)]
    (a : MulAut B) (ha : a ^ 3 = 1) (hne : a ≠ 1)
    (c : MulAut B) (hcomm : Commute c a)
    (v : B) (hv : v ∉ frattini B) (hfix : c v = v) : c = 1 := by
  classical
  let q : B →* B ⧸ frattini B := QuotientGroup.mk' (frattini B)
  let abar := Subgroup.quotientAut (frattini B) a
  have hbar3 : abar ^ 3 = 1 := by rw [← map_pow,ha,map_one]
  have hbarNe : abar ≠ 1 := quotient_three_nontrivial hB a ha hne
  have hvone : q v ≠ 1 := fun heq => hv ((QuotientGroup.eq_one_iff v).mp heq)
  have havone : q (a v) ≠ 1 := by
    rw [← Subgroup.quotientAut_apply_mk]
    exact fun heq => hvone (abar.injective (heq.trans (map_one abar).symm))
  have hvav : q v ≠ q (a v) := by
    rw [← Subgroup.quotientAut_apply_mk]
    exact (three_automorphism_moves_nonidentity IsKleinFour.card_four abar hbar3 hbarNe (q v) hvone).symm
  let J := c.toMonoidHom.eqLocus (MonoidHom.id B)
  have hvJ : v ∈ J := hfix
  have havJ : a v ∈ J := by
    change c (a v) = a v
    have hh := DFunLike.congr_fun hcomm.eq v
    change c (a v) = a (c v) at hh
    rwa [hfix] at hh
  have hmap : J.map q = ⊤ := by
    apply top_unique
    intro w _
    by_cases hwone : w = 1
    · rw [hwone]
      exact (J.map q).one_mem
    by_cases hwv : w = q v
    · exact hwv ▸ Subgroup.mem_map_of_mem q hvJ
    by_cases hwav : w = q (a v)
    · exact hwav ▸ Subgroup.mem_map_of_mem q havJ
    have hwprod := IsKleinFour.eq_mul_of_ne_all hvone havone hvav hwone hwv hwav
    rw [hwprod]
    exact (J.map q).mul_mem (Subgroup.mem_map_of_mem q hvJ) (Subgroup.mem_map_of_mem q havJ)
  have hsup : J ⊔ frattini B = ⊤ := by
    have hh := congrArg (Subgroup.comap q) hmap
    rw [Subgroup.comap_map_eq,Subgroup.comap_top,QuotientGroup.ker_mk'] at hh
    exact hh
  have hJtop : J = ⊤ := frattini_nongenerating hsup
  apply MulEquiv.ext
  intro b
  exact (hJtop ▸ Subgroup.mem_top b : b ∈ J)

public theorem two_group_c4_square_automorphism_centralizer_card_le_four
    {B : Type*} [Group B] [Finite B]
    (model : Nonempty (B ≃* (Multiplicative (ZMod 4) × Multiplicative (ZMod 4))))
    (a : MulAut B) (ha : a ^ 3 = 1) (hne : a ≠ 1)
    (C : Subgroup (MulAut B)) (hC : IsPGroup 2 C)
    (hcomm : ∀ c ∈ C, Commute c a) : Nat.card C ≤ 4 := by
  classical
  obtain ⟨equiv⟩ := model
  have hBcard : Nat.card B = 16 := by
    rw [Nat.card_congr equiv.toEquiv]
    norm_num [Nat.card_prod,Nat.card_eq_fintype_card]
  have hB : IsPGroup 2 B := IsPGroup.of_card (n := 4) hBcard
  let _ : IsKleinFour (B ⧸ frattini B) :=
    isKleinFour_frattini_quotient_of_equiv_prod_zmod (n := 2) (by decide) equiv
  have hPhi : Nat.card (frattini B) = 4 := by
    have hcount := (frattini B).index_mul_card
    change Nat.card (B ⧸ frattini B) * Nat.card (frattini B) = Nat.card B at hcount
    rw [IsKleinFour.card_four,hBcard] at hcount
    omega
  let X : SubMulAction C B := {
    carrier := (frattini B : Set B)ᶜ
    smul_mem' := by
      intro c v hv hcv
      apply hv
      have hh := Subgroup.characteristic_iff_map_le.mp
        (inferInstance : (frattini B).Characteristic) (c : MulAut B)⁻¹
        (Subgroup.mem_map_of_mem ((c : MulAut B)⁻¹).toMonoidHom hcv)
      change (c : MulAut B).symm ((c : MulAut B) v) ∈ frattini B at hh
      rw [MulEquiv.symm_apply_apply] at hh
      exact hh }
  have hX : Nat.card X = 12 := by
    let _ := Fintype.ofFinite B
    change Nat.card ↥((frattini B : Set B)ᶜ) = 12
    rw [Nat.card_eq_fintype_card,Fintype.card_compl_set,
      ← Nat.card_eq_fintype_card,← Nat.card_eq_fintype_card,hBcard]
    change 16 - Nat.card (frattini B) = 12
    rw [hPhi]
  have hstab (v : X) : MulAction.stabilizer C v = ⊥ := by
    apply bot_unique
    intro c hc
    apply Subtype.ext
    exact commuting_automorphism_eq_one_of_primitive_fixed hB a ha hne c
      (hcomm c c.property) v v.property (congrArg Subtype.val hc)
  have hdiv : Nat.card C ∣ 12 := by
    have hequiv := MulAction.selfEquivOrbitsQuotientProd (G := C) (X := X) hstab
    rw [← hX,Nat.card_congr hequiv,Nat.card_prod]
    exact dvd_mul_left _ _
  obtain ⟨n,hn⟩ := hC.exists_card_eq
  have hnle : n ≤ 2 := by
    by_contra hnot
    have h8 : 8 ∣ 12 := by
      apply dvd_trans (show 2 ^ 3 ∣ 2 ^ n from Nat.pow_dvd_pow 2 (by omega))
      rwa [← hn]
    norm_num at h8
  rw [hn]
  exact le_trans (Nat.pow_le_pow_right (by decide : 0 < 2) hnle) (by norm_num)

open scoped IsMulCommutative in
/-- A nonidentity automorphism commuting with a nontrivial three-action on C4 squared
fixes only elements of square one. -/
public theorem c4_square_fixed_point_square_eq_one_of_commuting_three
    {B : Type*} [Group B] [Finite B]
    (model : Nonempty (B ≃* (Multiplicative (ZMod 4) × Multiplicative (ZMod 4))))
    (a : MulAut B) (ha : a ^ 3 = 1) (hne : a ≠ 1)
    (c : MulAut B) (hc : c ≠ 1) (hcomm : Commute c a)
    (b : B) (hfix : c b = b) : b ^ 2 = 1 := by
  classical
  obtain ⟨equiv⟩ := model
  have hBcard : Nat.card B = 16 := by
    rw [Nat.card_congr equiv.toEquiv]
    norm_num [Nat.card_prod, Nat.card_eq_fintype_card]
  have hB : IsPGroup 2 B := IsPGroup.of_card (n := 4) hBcard
  let _ : IsKleinFour (B ⧸ frattini B) :=
    isKleinFour_frattini_quotient_of_equiv_prod_zmod (n := 2) (by decide) equiv
  have hb : b ∈ frattini B := by
    by_contra hb
    exact hc (commuting_automorphism_eq_one_of_primitive_fixed hB a ha hne c hcomm b hb hfix)
  let _ : IsMulCommutative B := IsMulCommutative.of_comm fun x y =>
    equiv.injective (by simp only [map_mul]; exact mul_comm _ _)
  let _ : Fact (IsPGroup 2 B) := ⟨hB⟩
  have hfour (x : B) : x ^ 4 = 1 := by
    apply equiv.injective
    rw [map_pow, map_one]
    apply Prod.ext
    · simpa [Nat.card_eq_fintype_card] using pow_card_eq_one' (x := (equiv x).1)
    · simpa [Nat.card_eq_fintype_card] using pow_card_eq_one' (x := (equiv x).2)
  have hPhi : frattini B ≤ (powMonoidHom 2 : B →* B).ker := by
    rw [frattini_eq_closure_commutator_union_powers (p := 2)]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    rcases hx with hx | ⟨y, rfl⟩
    · rw [commutator_eq_bot] at hx
      have hxone : x = 1 := hx
      rw [hxone]
      exact (powMonoidHom 2 : B →* B).ker.one_mem
    · change (y ^ 2) ^ 2 = 1
      simpa only [← pow_mul] using hfour y
  exact hPhi hb
