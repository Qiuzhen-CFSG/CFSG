module
public import Theory.GroupAction.SubgroupQuotientFullAction


/-!
# Fixed subgroup generation in a literal subgroup quotient

Suppose the subgroup V is generated by the P-conjugates of a seed B.
If S lies in P and the commutators [B,S] lie in the normal denominator Z,
then the translates of the S-image fixed subgroup generate V/Z under the
range of any prescribed quotient-conjugation action.

Every seed image is fixed by S. Its translates lie in the action-generated
subgroup; pulling that subgroup back to V contains every conjugate generator,
and therefore all of V. Surjectivity of the quotient map finishes the proof.
The statement uses explicit closure sets so it is independent of campaign
notation and retains the exact supplied quotient normality and action.

This extracts the generic argument used by Stellmacher (8.6), printed
pp.41–42, for reuse with the actual quotient module in (9.8). No Sylow,
finiteness, commutativity, or elementary-abelian hypothesis is required here.
-/

namespace Subgroup
open scoped commutatorElement
universe u

public theorem quotient_fixed_generation_of_conjugate_closure
    {G : Type u} [Group G] (P V Z B S : Subgroup G)
    (hPV : P ≤ Subgroup.normalizer (V : Set G)) (_hSP : S ≤ P)
    (hBV : B ≤ V) (hV : V = Subgroup.closure {x : G | ∃ actor : P, ∃ point : B,
      x = (actor : G) * (point : G) * (actor : G)⁻¹})
    (hBS : ⁅B, S⁆ ≤ Z) (hN : (Z.subgroupOf V).Normal) :
    let _ := hN
    ∀ action : P →* MulAut (V ⧸ Z.subgroupOf V),
      (∀ actor : P, ∀ point : V,
        action actor (QuotientGroup.mk' (Z.subgroupOf V) point) =
          QuotientGroup.mk' (Z.subgroupOf V)
            ⟨(actor : G) * (point : G) * (actor : G)⁻¹,
              (Subgroup.mem_normalizer_iff.mp (hPV actor.property) point).mp point.property⟩) →
      (⊤ : Subgroup (V ⧸ Z.subgroupOf V)) =
        Subgroup.closure {x : V ⧸ Z.subgroupOf V | ∃ actor : action.range,
          ∃ point, point ∈ FixedPoints.subgroup ((S.subgroupOf P).map action.rangeRestrict)
            (V ⧸ Z.subgroupOf V) ∧ x = actor • point} := by
  let _ := hN
  dsimp only
  intro action haction
  let W := V ⧸ Z.subgroupOf V
  let q : V →* W := QuotientGroup.mk' (Z.subgroupOf V)
  let C := Subgroup.closure {x : W | ∃ actor : action.range, ∃ point,
    point ∈ FixedPoints.subgroup ((S.subgroupOf P).map action.rangeRestrict) W ∧
      x = actor • point}
  let K := (C.comap q).map V.subtype
  have hseed (b : G) (hb : b ∈ B) : q ⟨b, hBV hb⟩ ∈
      FixedPoints.subgroup ((S.subgroupOf P).map action.rangeRestrict) W := by
    intro image
    obtain ⟨s, hs, heq⟩ := image.property
    change (image : action.range).val (q ⟨b, hBV hb⟩) = q ⟨b, hBV hb⟩
    rw [← heq]
    change action s (q ⟨b, hBV hb⟩) = q ⟨b, hBV hb⟩
    rw [haction]
    apply QuotientGroup.eq_iff_div_mem.mpr
    change (s : G) * b * (s : G)⁻¹ / b ∈ Z
    have hh : ⁅(s : G), b⁆ ∈ Z := by
      rw [← commutatorElement_inv]
      exact Z.inv_mem (hBS (Subgroup.commutator_mem_commutator hb hs))
    simpa only [commutatorElement_def, div_eq_mul_inv] using hh
  have hVK : V ≤ K := by
    rw [hV]
    apply (Subgroup.closure_le K).mpr
    rintro point ⟨actor, b, rfl⟩
    have hmem : (action.rangeRestrict actor) • q ⟨b, hBV b.property⟩ ∈ C :=
      Subgroup.subset_closure ⟨action.rangeRestrict actor, q ⟨b, hBV b.property⟩,
        hseed b b.property, rfl⟩
    refine ⟨⟨(actor : G) * (b : G) * (actor : G)⁻¹,
      (Subgroup.mem_normalizer_iff.mp (hPV actor.property) b).mp (hBV b.property)⟩,
      ?_, rfl⟩
    change q _ ∈ C
    change action actor (q ⟨b, hBV b.property⟩) ∈ C at hmem
    rwa [haction] at hmem
  apply le_antisymm ?_ le_top
  intro point _
  obtain ⟨v, rfl⟩ := QuotientGroup.mk'_surjective (Z.subgroupOf V) point
  obtain ⟨v', hv', heq⟩ := hVK v.property
  have hv : v' = v := Subtype.ext heq
  exact hv ▸ hv'

end Subgroup
