module
public import Theory.GroupAction.Defs
public import Mathlib.Algebra.Group.Subgroup.Actions

/-!
# Action commutators through an actor subgroup embedding

Let G act on V, let E be a subgroup of G, and let Y be a subgroup of E.
The action commutator of any H≤V with the image of Y in G equals its action
commutator with Y under the inherited action. The same equality holds for
the first and the iterated action commutators of V.

Both subgroups are generated by h⁻¹*(y • h). An actor in the image of Y
lifts to Y, and the two inherited scalar actions have the same underlying
G element. Hence the generator sets are equal. The first and second action
identities follow by specializing H and applying the same transport twice.
Neither finiteness nor invariance of H is needed.

This source-neutral transport is used when applying the relative bounded
module theorem to an odd-core subgroup in Stellmacher (9.1), relation (7),
Journal of Algebra 190 (1997), printed p.47. It preserves the actual ambient
action rather than replacing it by an equivalent action instance.
-/

public theorem commutatorSubgroup_map_actor_subtype
    {G V : Type*} [Group G] [Group V] [MulDistribMulAction G V]
    (E : Subgroup G) (Y : Subgroup E) (H : Subgroup V) :
    commutatorSubgroup (Y.map E.subtype) V H = commutatorSubgroup Y V H := by
  unfold commutatorSubgroup
  congr 1
  ext v
  constructor
  · rintro ⟨a,h,hh,rfl⟩
    obtain ⟨y,hy,he⟩ := a.property
    refine ⟨⟨y,hy⟩,h,hh,?_⟩
    change h⁻¹ * ((a : G) • h) = h⁻¹ * ((y : G) • h)
    change (y : G) = (a : G) at he
    rw [he]
  · rintro ⟨a,h,hh,rfl⟩
    refine ⟨⟨((a : E) : G), Subgroup.mem_map_of_mem E.subtype a.property⟩,h,hh,rfl⟩

public theorem commutatorAction_map_actor_subtype
    {G V : Type*} [Group G] [Group V] [MulDistribMulAction G V]
    (E : Subgroup G) (Y : Subgroup E) :
    commutatorAction (Y.map E.subtype) V = commutatorAction Y V :=
  commutatorSubgroup_map_actor_subtype E Y ⊤

public theorem commutatorAction₂_map_actor_subtype
    {G V : Type*} [Group G] [Group V] [MulDistribMulAction G V]
    (E : Subgroup G) (Y : Subgroup E) :
    commutatorAction₂ (Y.map E.subtype) V = commutatorAction₂ Y V := by
  rw [commutatorAction₂, commutatorSubgroup_map_actor_subtype,
    commutatorAction_map_actor_subtype]
