module
public import Theory.GroupAction.KleinFourCardinality
public import Theory.GroupAction.HallProductFixedPoints
public import Theory.ElementaryAbelian.Basic
public import Theory.GroupTheory.SubgroupProductCard

/-!
# A product criterion from binary fixed subgroups

Let a finite elementary abelian two-group A of order at least four act on
a finite odd-order group G. If X and Y are invariant subgroups and each
nonidentity actor's fixed subgroup is the ordered product of the fixed
subgroups in X and Y, then the actual set product XY is all of G.

Choose distinct nonidentity actors a,b, so ab is also nonidentity. Apply
the Brauer–Wielandt order formula to G, X, Y, and their intersection I,
using the original restricted actions. The assumed three fixed-subgroup
products give three local cardinal identities. The common fixed subgroup
for the subgroup generated by a,b also factors: a common fixed point first
belongs to XY by the a-fixed hypothesis, and the odd-intersection fixed
factor theorem gives factors fixed by the whole generated actor subgroup.

Multiplying the four order formulas and cancelling the positive common
fixed orders gives |G||I|=|X||Y|. The general subgroup set-product formula
then implies |XY|=|G|, hence XY=G. No solvability or faithfulness is used.

This proves the binary case of Kurzweil–Stellmacher, *The Theory of Finite
Groups*, Lemma 11.2.1, printed pp.312–313. The source treats arbitrary prime
actors and additionally assumes X is normalized by C_G(A). That assumption
is unnecessary in this binary proof, because the Brauer–Wielandt identities
replace the source's normalized Sylow-transfer argument.
-/

open scoped Pointwise IsMulCommutative

private theorem cyclic_fixed_eq
    {A G : Type*} [Group A] [Group G] [MulDistribMulAction A G] (a : A) :
    (MulDistribMulAction.toMulAut A G a).fixedSubgroup =
      FixedPoints.subgroup (Subgroup.zpowers a) G := by
  ext x
  rw [MulAut.mem_fixedSubgroup]
  constructor
  · intro hx z
    have hle : Subgroup.zpowers a ≤ MulAction.stabilizer A x := Subgroup.zpowers_le.mpr hx
    exact hle z.property
  · intro hx
    exact hx ⟨a, Subgroup.mem_zpowers a⟩

private theorem common_fixed_eq
    {A G : Type*} [Group A] [Group G] [MulDistribMulAction A G] (a b : A) :
    (MulDistribMulAction.toMulAut A G a).fixedSubgroup ⊓
      (MulDistribMulAction.toMulAut A G b).fixedSubgroup =
      FixedPoints.subgroup (Subgroup.closure ({a, b} : Set A)) G := by
  ext x
  simp only [Subgroup.mem_inf, MulAut.mem_fixedSubgroup]
  constructor
  · intro hx z
    have hle : Subgroup.closure ({a, b} : Set A) ≤ MulAction.stabilizer A x := by
      apply (Subgroup.closure_le _).mpr
      intro y hy
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
      rcases hy with rfl | rfl
      · exact hx.1
      · exact hx.2
    exact hle z.property
  · intro hx
    exact ⟨hx ⟨a, Subgroup.subset_closure (by simp)⟩,
      hx ⟨b, Subgroup.subset_closure (by simp)⟩⟩

private theorem fixed_restrict_card
    {A G : Type*} [Group A] [Group G] [MulDistribMulAction A G]
    (W : Subgroup G) [IsInvariant A G W] (B : Subgroup A) :
    Nat.card (FixedPoints.subgroup B W) =
      Nat.card (W ⊓ FixedPoints.subgroup B G : Subgroup G) := by
  have heq : (FixedPoints.subgroup B W).map W.subtype = W ⊓ FixedPoints.subgroup B G := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨y.property, fun b => congrArg Subtype.val (hy b)⟩
    · intro hx
      exact ⟨⟨x, hx.1⟩, fun b => Subtype.ext (hx.2 b), rfl⟩
  rw [← Subgroup.card_subtype W (FixedPoints.subgroup B W), heq]

private theorem brauerWielandt_restricted_card
    {A G : Type*} [Group A] [IsElementaryAbelian 2 A] [Group G] [Finite G]
    [MulDistribMulAction A G] (hG : Odd (Nat.card G))
    (a b : A) (W : Subgroup G) [IsInvariant A G W] :
    Nat.card W * Nat.card (W ⊓ FixedPoints.subgroup
        (Subgroup.closure ({a, b} : Set A)) G : Subgroup G)^2 =
      Nat.card (W ⊓ FixedPoints.subgroup (Subgroup.zpowers a) G : Subgroup G) *
      Nat.card (W ⊓ FixedPoints.subgroup (Subgroup.zpowers b) G : Subgroup G) *
      Nat.card (W ⊓ FixedPoints.subgroup (Subgroup.zpowers (a * b)) G : Subgroup G) := by
  let aa := MulDistribMulAction.toMulAut A W a
  let bb := MulDistribMulAction.toMulAut A W b
  have hinv (x : A) : Function.Involutive (MulDistribMulAction.toMulAut A W x) := by
    intro w
    change x • (x • w) = w
    rw [← mul_smul, ← pow_two,
      Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 A) x,
      one_smul]
  have hcomm : Commute aa bb := by
    change MulDistribMulAction.toMulAut A W a * MulDistribMulAction.toMulAut A W b =
      MulDistribMulAction.toMulAut A W b * MulDistribMulAction.toMulAut A W a
    rw [← map_mul, ← map_mul, mul_comm a b]
  have h := Theory.GroupAction.brauerWielandt_fixedSubgroup_card
    (hG.of_dvd_nat (Subgroup.card_subgroup_dvd_card W)) aa bb (hinv a) (hinv b) hcomm
  change Nat.card W * Nat.card
    ((MulDistribMulAction.toMulAut A W a).fixedSubgroup ⊓
      (MulDistribMulAction.toMulAut A W b).fixedSubgroup : Subgroup W)^2 = _ at h
  rw [common_fixed_eq, cyclic_fixed_eq, cyclic_fixed_eq] at h
  have hmul : aa * bb = MulDistribMulAction.toMulAut A W (a * b) := (map_mul _ _ _).symm
  rw [hmul, cyclic_fixed_eq] at h
  simpa only [fixed_restrict_card] using h

private theorem exists_independent_pair
    {A : Type*} [Group A] [Finite A] (hA : 4 ≤ Nat.card A) :
    ∃ a b : A, a ≠ 1 ∧ b ≠ 1 ∧ a ≠ b := by
  classical
  have hnon : Nontrivial A := (Finite.one_lt_card_iff_nontrivial (α := A)).mp (by omega)
  let _ := hnon
  obtain ⟨a, ha⟩ := exists_ne (1 : A)
  have hout : ∃ b : A, b ∉ ({1, a} : Set A) := by
    by_contra h
    push Not at h
    have hsub : (Set.univ : Set A) ⊆ {1, a} := fun x _ => h x
    have hcard := Set.ncard_le_ncard hsub
    have hpair : ({1, a} : Set A).ncard ≤ 2 := (Set.ncard_pair (Ne.symm ha)).le
    simp only [Set.ncard_univ] at hcard
    omega
  obtain ⟨b, hb⟩ := hout
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or] at hb
  exact ⟨a, b, ha, hb.1, Ne.symm hb.2⟩

private theorem factorization_of_product_card
    {A G : Type*} [Group A] [Finite A] [IsElementaryAbelian 2 A]
    [Group G] [Finite G] [MulDistribMulAction A G]
    (hcard : ∀ X Y : Subgroup G,
      Nat.card ((X : Set G) * (Y : Set G)) * Nat.card (X ⊓ Y : Subgroup G) =
        Nat.card X * Nat.card Y)
    (hA : 4 ≤ Nat.card A) (hG : Odd (Nat.card G))
    (X Y : Subgroup G) [IsInvariant A G X] [IsInvariant A G Y]
    (hfixed : ∀ a : A, a ≠ 1 →
      (FixedPoints.subgroup (Subgroup.zpowers a) G : Set G) =
        ((X ⊓ FixedPoints.subgroup (Subgroup.zpowers a) G : Subgroup G) : Set G) *
        ((Y ⊓ FixedPoints.subgroup (Subgroup.zpowers a) G : Subgroup G) : Set G)) :
    (X : Set G) * (Y : Set G) = Set.univ := by
  classical
  obtain ⟨a, b, ha, hb, hab⟩ := exists_independent_pair hA
  have habone : a * b ≠ 1 := by
    intro h
    have hmul := congrArg (fun t : A => a * t) h
    rw [← mul_assoc, ← pow_two,
      Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 A) a,
      one_mul, mul_one] at hmul
    exact hab hmul.symm
  let B := Subgroup.closure ({a, b} : Set A)
  let C := FixedPoints.subgroup B G
  let F (t : A) := FixedPoints.subgroup (Subgroup.zpowers t) G
  let I := X ⊓ Y
  let _ : IsInvariant A G I := isInvariant_inf X Y
  let _ : IsInvariant A G (⊤ : Subgroup G) := ⟨fun _ _ => by simp⟩
  let _ : IsInvariant B G X := ⟨fun t x => IsInvariant.invariant (A := A) t.val x⟩
  let _ : IsInvariant B G Y := ⟨fun t x => IsInvariant.invariant (A := A) t.val x⟩
  have hCprod : (C : Set G) = ((X ⊓ C : Subgroup G) : Set G) *
      ((Y ⊓ C : Subgroup G) : Set G) := by
    apply Set.Subset.antisymm
    · intro x hx
      have hxa : x ∈ F a := by
        intro z
        exact hx ⟨z, (Subgroup.zpowers_le.mpr (Subgroup.subset_closure (by simp))) z.property⟩
      have hxa' : x ∈ ((X ⊓ F a : Subgroup G) : Set G) *
          ((Y ⊓ F a : Subgroup G) : Set G) := by
        change x ∈ ((X ⊓ FixedPoints.subgroup (Subgroup.zpowers a) G : Subgroup G) : Set G) *
          ((Y ⊓ FixedPoints.subgroup (Subgroup.zpowers a) G : Subgroup G) : Set G)
        rw [← hfixed a ha]
        exact hxa
      obtain ⟨u, hu, v, hv, huv⟩ := Set.mem_mul.mp hxa'
      exact fixed_mem_mul_of_odd_inf
        ((IsElementaryAbelian.isPGroup 2 A).to_subgroup B) X Y
        (hG.of_dvd_nat (Subgroup.card_subgroup_dvd_card I)) hx
        (Set.mem_mul.mpr ⟨u, hu.1, v, hv.1, huv⟩)
    · rintro x ⟨u, hu, v, hv, rfl⟩
      exact C.mul_mem hu.2 hv.2
  have hfactor_card (Z : Subgroup G)
      (hZ : (Z : Set G) = ((X ⊓ Z : Subgroup G) : Set G) *
        ((Y ⊓ Z : Subgroup G) : Set G)) :
      Nat.card Z * Nat.card (I ⊓ Z : Subgroup G) =
        Nat.card (X ⊓ Z : Subgroup G) * Nat.card (Y ⊓ Z : Subgroup G) := by
    have hh := hcard (X ⊓ Z) (Y ⊓ Z)
    have hinf : (X ⊓ Z) ⊓ (Y ⊓ Z) = I ⊓ Z := by
      ext x
      simp only [I, Subgroup.mem_inf]
      tauto
    rw [← hZ, hinf] at hh
    exact hh
  have hCcard := hfactor_card C hCprod
  have hacard := hfactor_card (F a) (hfixed a ha)
  have hbcard := hfactor_card (F b) (hfixed b hb)
  have habcard := hfactor_card (F (a * b)) (hfixed (a * b) habone)
  have hBWG : Nat.card G * Nat.card C^2 = Nat.card (F a) * Nat.card (F b) *
      Nat.card (F (a * b)) := by
    simpa only [Subgroup.card_top, top_inf_eq] using
      brauerWielandt_restricted_card hG a b (⊤ : Subgroup G)
  have hBWX := brauerWielandt_restricted_card hG a b X
  have hBWY := brauerWielandt_restricted_card hG a b Y
  have hBWI := brauerWielandt_restricted_card hG a b I
  have hnum : (Nat.card G * Nat.card I) *
      (Nat.card (X ⊓ C : Subgroup G) * Nat.card (Y ⊓ C : Subgroup G))^2 =
      (Nat.card X * Nat.card Y) *
      (Nat.card (X ⊓ C : Subgroup G) * Nat.card (Y ⊓ C : Subgroup G))^2 := by
    calc
      _ = (Nat.card G * Nat.card C^2) * (Nat.card I * Nat.card (I ⊓ C : Subgroup G)^2) := by
        rw [← hCcard]
        ring
      _ = (Nat.card (F a) * Nat.card (F b) * Nat.card (F (a * b))) *
          (Nat.card (I ⊓ F a : Subgroup G) * Nat.card (I ⊓ F b : Subgroup G) *
            Nat.card (I ⊓ F (a * b) : Subgroup G)) := by rw [hBWG, hBWI]
      _ = (Nat.card (F a) * Nat.card (I ⊓ F a : Subgroup G)) *
          (Nat.card (F b) * Nat.card (I ⊓ F b : Subgroup G)) *
          (Nat.card (F (a * b)) * Nat.card (I ⊓ F (a * b) : Subgroup G)) := by ring
      _ = (Nat.card (X ⊓ F a : Subgroup G) * Nat.card (Y ⊓ F a : Subgroup G)) *
          (Nat.card (X ⊓ F b : Subgroup G) * Nat.card (Y ⊓ F b : Subgroup G)) *
          (Nat.card (X ⊓ F (a * b) : Subgroup G) * Nat.card (Y ⊓ F (a * b) : Subgroup G)) := by
        rw [hacard, hbcard, habcard]
      _ = (Nat.card (X ⊓ F a : Subgroup G) * Nat.card (X ⊓ F b : Subgroup G) *
          Nat.card (X ⊓ F (a * b) : Subgroup G)) *
          (Nat.card (Y ⊓ F a : Subgroup G) * Nat.card (Y ⊓ F b : Subgroup G) *
          Nat.card (Y ⊓ F (a * b) : Subgroup G)) := by ring
      _ = (Nat.card X * Nat.card (X ⊓ C : Subgroup G)^2) *
          (Nat.card Y * Nat.card (Y ⊓ C : Subgroup G)^2) := by rw [← hBWX, ← hBWY]
      _ = _ := by ring
  have hcancel : 0 < (Nat.card (X ⊓ C : Subgroup G) * Nat.card (Y ⊓ C : Subgroup G))^2 :=
    pow_pos (Nat.mul_pos Nat.card_pos Nat.card_pos) _
  have hglobal : Nat.card G * Nat.card I = Nat.card X * Nat.card Y :=
    Nat.mul_right_cancel hcancel hnum
  have hXY : Nat.card ((X : Set G) * (Y : Set G)) = Nat.card G :=
    Nat.mul_right_cancel (show 0 < Nat.card I from Nat.card_pos)
      ((hcard X Y).trans hglobal.symm)
  apply Set.eq_of_subset_of_ncard_le (Set.subset_univ _)
  simpa only [Set.ncard_univ, Nat.card_coe_set_eq] using hXY.ge

/-- Ordered fixed-subgroup products determine the whole product for a noncyclic binary actor. -/
public theorem set_mul_eq_univ_of_binary_fixed_factorization
    {A G : Type*} [Group A] [Finite A] [IsElementaryAbelian 2 A]
    [Group G] [Finite G] [MulDistribMulAction A G]
    (hA : 4 ≤ Nat.card A) (hG : Odd (Nat.card G))
    (X Y : Subgroup G) [IsInvariant A G X] [IsInvariant A G Y]
    (hfixed : ∀ a : A, a ≠ 1 →
      (FixedPoints.subgroup (Subgroup.zpowers a) G : Set G) =
        ((X ⊓ FixedPoints.subgroup (Subgroup.zpowers a) G : Subgroup G) : Set G) *
        ((Y ⊓ FixedPoints.subgroup (Subgroup.zpowers a) G : Subgroup G) : Set G)) :
    (X : Set G) * (Y : Set G) = Set.univ :=
  factorization_of_product_card Subgroup.card_set_mul_mul_card_inf hA hG X Y hfixed
