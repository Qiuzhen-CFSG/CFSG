module
public import Theory.GroupAction.FullInvertedThreeRankOne
public import Theory.GroupTheory.SpecificGroups.SLTwoPermThree
public import Mathlib.GroupTheory.Perm.Fin

/-!
# A full derived SL2(2) action with a displacement line

Let SL₂(F₂) act through a specified homomorphism into the automorphism group
of a finite elementary abelian two-group W. If its derived subgroup has full
displacement, and an actual order-two subgroup has displacement of order two,
then W has order four. The action need not be faithful, and all subgroup
images use the original homomorphism.

Transport the action through the existing three-point permutation equivalence.
A concrete cubic commutator generates the derived subgroup of S3. The chosen
order-two subgroup is generated by its unique nonidentity element, which
inverts that cubic generator. These finite permutation identities are checked
by kernel reduction. Mapping the two operators through the action gives the
exact hypotheses of `card_four_of_full_inverted_three_rank_one`; transport
back preserves the original derived and order-two subgroup images.

This concrete-model wrapper supplies the cardinality step for the actual
residual-core quotient in Stellmacher (10.1), Journal of Algebra190 (1997).
Its consumer supplies the elementary quotient, full derived displacement,
and displacement line independently.
-/

open scoped commutatorElement

private theorem perm_three_derived_rank_one
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W]
    (action : Equiv.Perm (Fin 3) →* MulAut W)
    (hfull : commutatorAction ((commutator (Equiv.Perm (Fin 3))).map action) W = ⊤)
    (S : Subgroup (Equiv.Perm (Fin 3))) (hS : Nat.card S = 2)
    (hline : Nat.card (commutatorAction (S.map action) W) = 2) : Nat.card W = 4 := by
  let r : Equiv.Perm (Fin 3) := ⁅Equiv.swap (0 : Fin 3) 1, Equiv.swap (1 : Fin 3) 2⁆
  have hr : r ^ 3 = 1 := by decide +kernel
  have hderived : commutator (Equiv.Perm (Fin 3)) = Subgroup.zpowers r := by
    apply le_antisymm
    · rw [commutator_def]
      apply Subgroup.commutator_le.mpr
      intro a _ b _
      have hcases : ∀ a b : Equiv.Perm (Fin 3),
          ⁅a,b⁆ = 1 ∨ ⁅a,b⁆ = r ∨ ⁅a,b⁆ = r ^ 2 := by decide +kernel
      rcases hcases a b with hone | hr | hr2
      · rw [hone]; exact Subgroup.one_mem _
      · rw [hr]; exact Subgroup.mem_zpowers r
      · rw [hr2]; exact (Subgroup.zpowers r).pow_mem (Subgroup.mem_zpowers r) 2
    · apply Subgroup.zpowers_le.mpr
      change ⁅Equiv.swap (0 : Fin 3) 1, Equiv.swap (1 : Fin 3) 2⁆ ∈ ⁅⊤,⊤⁆
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  obtain ⟨s, hsne, _⟩ := (Nat.card_eq_two_iff' (1 : S)).mp hS
  have hsne' : (s : Equiv.Perm (Fin 3)) ≠ 1 := fun h => hsne (Subtype.ext h)
  have hs2 : (s : Equiv.Perm (Fin 3)) ^ 2 = 1 := by
    have hh := pow_card_eq_one' (x := s)
    rw [hS] at hh
    exact congrArg Subtype.val hh
  have hScyclic : S = Subgroup.zpowers (s : Equiv.Perm (Fin 3)) := by
    apply (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr s.property) ?_).symm
    rw [Nat.card_zpowers, orderOf_eq_prime hs2 hsne', hS]
  have hinv : (s : Equiv.Perm (Fin 3)) * r * (s : Equiv.Perm (Fin 3))⁻¹ = r⁻¹ := by
    have hsmall : ∀ t : Equiv.Perm (Fin 3), t ≠ 1 → t ^ 2 = 1 → t*r*t⁻¹ = r⁻¹ := by
      decide +kernel
    exact hsmall s hsne' hs2
  apply card_four_of_full_inverted_three_rank_one (action r) (action s)
    (by rw [← map_pow, hr, map_one])
    (by simpa only [map_mul,map_inv] using congrArg action hinv)
  · rw [← MonoidHom.map_zpowers, ← hderived]
    exact hfull
  · rw [← MonoidHom.map_zpowers, ← hScyclic]
    exact hline

public theorem card_four_of_sl2_derived_full_rank_one
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W]
    (action : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2) →* MulAut W)
    (hfull : commutatorAction
      ((commutator (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))).map action) W = ⊤)
    (S : Subgroup (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))) (hS : Nat.card S = 2)
    (hline : Nat.card (commutatorAction (S.map action) W) = 2) : Nat.card W = 4 := by
  obtain ⟨e⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
  let beta := action.comp e.symm.toMonoidHom
  have hcomp : beta.comp e.toMonoidHom = action := by
    ext x
    simp [beta]
  have hderived : (commutator (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))).map
      e.toMonoidHom = commutator (Equiv.Perm (Fin 3)) := by
    rw [map_commutator_eq, MonoidHom.range_eq_top.mpr e.surjective]
    rfl
  apply perm_three_derived_rank_one beta ?_ (S.map e.toMonoidHom) ?_ ?_
  · rw [← hderived, Subgroup.map_map, hcomp]
    exact hfull
  · rw [Subgroup.card_map_of_injective e.injective]
    exact hS
  · rw [Subgroup.map_map, hcomp]
    exact hline

