module
public import Theory.GroupTheory.PGroup.ClassTwoFixedFrattiniRank
public import Theory.GroupTheory.PGroup.FrattiniAutomorphismKernel
public import Theory.ElementaryAbelian.AutomorphismLinearEmbedding
public import Theory.SpecificGroups.GL2.OddCharacteristicTwoRank
public import Theory.ElementaryAbelian.PrimeRankCard
public import Theory.Quasithin.CoprimeRank

/-!
# Binary automorphism rank of small odd groups

A finite odd p-group generated by at most two elements has Frattini quotient
of dimension at most two. The actual automorphism action on that quotient
has p-group kernel; its embedding into GL₂(p) therefore bounds the two-rank
of the full automorphism group by two.

For an exponent-p group of class at most two and p-rank at most two, the
same generator bound holds for every subgroup. A kernel comparison then
transfers that bound to the actual image of a second homomorphism. This
avoids asserting prime-rank monotonicity for arbitrary quotients.

Source application: Aschbacher--Smith 13.1.9, printed pp.870--871, using
A.1.24 and the Frattini automorphism argument in A.1.25.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative

namespace Group
variable {X P Q : Type*} [Group X] [Group P] [Group Q]
  [Finite X] [Finite P] [Finite Q]

omit [Finite P] in
theorem rank_le_range_of_ker_le (f : X →* P) (g : X →* Q)
    (hg : Function.Surjective g) (hk : f.ker ≤ g.ker) :
    Group.rank Q ≤ Group.rank f.range := by
  have hr := Group.rank_le_of_surjective (QuotientGroup.lift f.ker g hk)
    (QuotientGroup.lift_surjective_of_surjective f.ker g hg hk)
  exact hr.trans_eq (Group.rank_congr (QuotientGroup.quotientKerEquivRange f))
end Group

namespace IsPGroup
variable {p : ℕ} [Fact p.Prime] {P : Type*} [Group P] [Finite P]

omit [Finite P] in
private theorem class_two_subgroup (hclass : _root_.commutator P ≤ center P)
    (C : Subgroup P) : _root_.commutator C ≤ center C := by
  apply Subgroup.commutator_le.mpr
  intro x _ y _
  apply Subgroup.mem_center_iff.mpr
  intro z
  apply Subtype.ext
  exact Subgroup.mem_center_iff.mp
    (hclass (Subgroup.commutator_mem_commutator (mem_top x.val) (mem_top y.val))) z.val

theorem subgroup_rank_le_two_of_exponent_prime_class_two
    (hP : IsPGroup p P) (hp : p ≠ 2) (hpow : ∀ x : P, x ^ p = 1)
    (hclass : _root_.commutator P ≤ center P) (hrank : primeRank p P ≤ 2)
    (C : Subgroup P) : Group.rank C ≤ 2 :=
  (hP.to_subgroup C).rank_le_two_of_exponent_prime_class_two hp
    (fun x => Subtype.ext (hpow x.val)) (class_two_subgroup hclass C)
    ((_root_.primeRank_subgroup_le p C).trans hrank)

theorem automorphism_twoRank_le_two_of_rank_le_two
    (hP : IsPGroup p P) (hp : p ≠ 2) (hrank : Group.rank P ≤ 2) :
    primeRank 2 (MulAut P) ≤ 2 := by
  let : Fact (IsPGroup p P) := ⟨hP⟩
  let : IsElementaryAbelian p (P ⧸ frattini P) := isElementaryAbelian_quotient_frattini
  have hc : Nat.card (P ⧸ frattini P) ≤ p ^ 2 := by
    have hpow (x : P ⧸ frattini P) : x ^ p = 1 :=
      Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p p (P ⧸ frattini P)) x
    exact (Nat.le_of_dvd (pow_pos (Fact.out : p.Prime).pos _)
      (card_dvd_exponent_pow_rank' _ hpow)).trans
      (pow_le_pow_right' (Fact.out : p.Prime).one_lt.le
        ((Group.rank_eq_rank_quotient_frattini P).symm ▸ hrank))
  obtain ⟨f,hf⟩ := IsElementaryAbelian.exists_injective_mulAut_generalLinear_of_card_le
    (P ⧸ frattini P) hc
  let a := f.comp (quotientAut (frattini P))
  have hk : IsPGroup p a.ker := by
    rw [show a.ker = (quotientAut (frattini P)).ker from
      MonoidHom.ker_comp_of_injective _ _ hf]
    exact isPGroup_quotientAut_frattini_kernel hP
  have hcop : Nat.Coprime 2 (Nat.card a.ker) := by
    obtain ⟨n,hn⟩ := hk.exists_card_eq
    rw [hn]
    exact (Nat.coprime_two_left.mpr ((Fact.out : p.Prime).odd_of_ne_two hp)).pow_right n
  apply (primeRank_le_of_coprime_ker 2 a hcop).trans
  apply Matrix.GeneralLinearGroup.twoRank_le_two_of_two_ne_zero
  intro hz
  exact hp (((Nat.dvd_prime Nat.prime_two).mp
    ((ZMod.natCast_eq_zero_iff 2 p).mp hz)).resolve_left (Fact.out : p.Prime).ne_one)
end IsPGroup
