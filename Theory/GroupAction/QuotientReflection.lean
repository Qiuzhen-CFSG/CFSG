module

public import Theory.GroupAction.OddCyclicReflection
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Algebra.Group.Action.End

/-!
# Lifting reflections of a quotient action

An action descends through a surjective homomorphism when its kernel fixes
every point. Suppose the quotient is generated by a normal cyclic odd-prime
rotation group and the image of an actor subgroup fixing a basepoint. If
one actor maps to an inverting involution, any two orbit points can be
interchanged by a lift of a quotient involution.

We descend the permutation representation, use the normal product to
represent orbit points by rotations, and apply the odd cyclic midpoint
reflection lemma. We lift the rotation midpoint and conjugate the actual
actor by that lift. The conjugacy form retains the actor's order; the
quotient-involution wrapper retains its original conclusion. In particular,
an actual involution actor supplies an actual involution interchanging the
points, without any general involution-lifting assertion.

This is the valid quotient-action step required in Stellmacher (3.6)(c),
Journal of Algebra 190 (1997), p. 22.
-/

open scoped Pointwise

universe u v w

public theorem exists_conjugate_reflection_swapping_of_quotient
    {G : Type u} [Group G] {Q : Type v} [Group Q]
    {X : Type w} [MulAction G X]
    (f : G →* Q) (hf : Function.Surjective f)
    (hker : ∀ k : G, k ∈ f.ker → ∀ x : X, k • x = x)
    (R : Subgroup Q) [Finite R] [IsCyclic R] [R.Normal]
    {p : ℕ} (hR : IsPGroup p R) (hp : Odd p)
    (A : Subgroup G) (hgen : R ⊔ A.map f = ⊤)
    (z : X) (hAfix : ∀ a : G, a ∈ A → a • z = z)
    (a : G) (haA : a ∈ A)
    (hinv : ∀ r : R, f a * (r : Q) * (f a)⁻¹ = (r : Q)⁻¹)
    (g₁ g₂ : G) :
    ∃ c : G,
      (c * a * c⁻¹) • (g₁ • z) = g₂ • z ∧
        (c * a * c⁻¹) • (g₂ • z) = g₁ • z := by
  classical
  let act : G →* Equiv.Perm X := MulAction.toPermHom G X
  have hkeract : f.ker ≤ act.ker := by
    intro k hk
    apply Equiv.ext
    exact hker k hk
  let rho : Q →* Equiv.Perm X := f.liftOfSurjective hf ⟨act, hkeract⟩
  let _ : MulAction Q X := MulAction.compHom X rho
  have hcompat (g : G) (x : X) : (f g) • x = g • x := by
    change (rho (f g)) x = _
    have hcomp : rho (f g) = act g :=
      MonoidHom.liftOfRightInverse_comp_apply f (Function.surjInv hf)
        (Function.rightInverse_surjInv hf) ⟨act, hkeract⟩ g
    rw [hcomp]
    rfl
  have hrot (g : G) : ∃ r : R, g • z = (r : Q) • z := by
    have hg : f g ∈ R ⊔ A.map f := by rw [hgen]; trivial
    have hprod : f g ∈ (R : Set Q) * (A.map f : Set Q) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left R (A.map f)
        (Subgroup.le_normalizer_of_normal : A.map f ≤ Subgroup.normalizer R)]
      exact hg
    obtain ⟨r, hr, b, hb, hrb⟩ := hprod
    obtain ⟨b, hb, rfl⟩ := hb
    refine ⟨⟨r, hr⟩, ?_⟩
    rw [← hcompat, ← hrb, mul_smul, hcompat, hAfix b hb]
  obtain ⟨r₁, hr₁⟩ := hrot g₁
  obtain ⟨r₂, hr₂⟩ := hrot g₂
  have haz : f a • z = z := by rw [hcompat]; exact hAfix a haA
  obtain ⟨r, hswap₁, hswap₂⟩ :=
    exists_conjugate_reflection_swapping R hR hp (f a) z haz hinv r₁ r₂
  obtain ⟨c, hc⟩ := hf (r : Q)
  have hcimage : f (c * a * c⁻¹) = (r : Q) * f a * (r : Q)⁻¹ := by
    simp only [map_mul, map_inv, hc]
  refine ⟨c, ?_, ?_⟩
  · rw [hr₁, hr₂, ← hcompat (c * a * c⁻¹), hcimage]
    exact hswap₁
  · rw [hr₁, hr₂, ← hcompat (c * a * c⁻¹), hcimage]
    exact hswap₂

public theorem exists_quotient_reflection_swapping
    {G : Type u} [Group G] {Q : Type v} [Group Q]
    {X : Type w} [MulAction G X]
    (f : G →* Q) (hf : Function.Surjective f)
    (hker : ∀ k : G, k ∈ f.ker → ∀ x : X, k • x = x)
    (R : Subgroup Q) [Finite R] [IsCyclic R] [R.Normal]
    {p : ℕ} (hR : IsPGroup p R) (hp : Odd p)
    (A : Subgroup G) (hgen : R ⊔ A.map f = ⊤)
    (z : X) (hAfix : ∀ a : G, a ∈ A → a • z = z)
    (a : G) (haA : a ∈ A) (ha : f a ≠ 1 ∧ (f a) ^ 2 = 1)
    (hinv : ∀ r : R, f a * (r : Q) * (f a)⁻¹ = (r : Q)⁻¹)
    (g₁ g₂ : G) :
    ∃ t : G, (f t ≠ 1 ∧ (f t) ^ 2 = 1) ∧
      t • (g₁ • z) = g₂ • z ∧ t • (g₂ • z) = g₁ • z := by
  obtain ⟨c, hswap₁, hswap₂⟩ :=
    exists_conjugate_reflection_swapping_of_quotient f hf hker R hR hp A hgen
      z hAfix a haA hinv g₁ g₂
  refine ⟨c * a * c⁻¹, ⟨?_, ?_⟩, hswap₁, hswap₂⟩
  · simp only [map_mul, map_inv]
    intro heq
    apply ha.1
    calc
      f a = (f c)⁻¹ * (f c * f a * (f c)⁻¹) * f c := by group
      _ = 1 := by rw [heq]; simp
  · simp only [map_mul, map_inv]
    calc
      (f c * f a * (f c)⁻¹) ^ 2 = f c * (f a) ^ 2 * (f c)⁻¹ := by
        simp [pow_two, mul_assoc]
      _ = 1 := by rw [ha.2]; simp
