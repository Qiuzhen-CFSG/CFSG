module

public import Theory.GroupAction.ComponentRankAction
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.GroupTheory.PPrimeCoreReduction
public import Theory.GroupTheory.PPrimeCoreSurjection

/-!
# Prime generators and the kernel of a component action

A finite quasisimple group with p-prime center is generated by its elements
of order p whenever p divides its order. Under an action with p-prime kernel,
prime generators whose images come from a normal subgroup already belong to
that subgroup. Finally every almost simple actor group has trivial p-prime
core when p divides the component order. These statements identify both
branches and the literal core quotient in the cubic case of A.3.18.

Source: Aschbacher–Smith, A.3.18, printed pp.51–53, as used in 2.5.7, p.556.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
namespace Theory.GroupAction.ComponentRankAction

variable {G T S : Type*} [Group G] [Group T] [Group S]
variable [Finite G] {p : ℕ} [Fact p.Prime]

/-- A quasisimple group with p-prime center is generated by its elements of order p. -/
theorem prime_closure_eq_top [IsQuasisimple G]
    (hz : Nat.Coprime p (Nat.card (center G))) (hd : p ∣ Nat.card G) :
    closure {x : G | orderOf x = p} = ⊤ := by
  let C : Subgroup G := closure {x : G | orderOf x = p}
  have hn : (⊤ : Subgroup G) ≤ normalizer (C : Set G) := by
    apply le_normalizer_closure_iff.mpr
    intro g _ x hx
    exact subset_closure ((MulAut.conj g).orderOf_eq x |>.trans hx)
  let : C.Normal := normalizer_eq_top_iff.mp (top_unique hn)
  rcases IsQuasisimple.normal_le_center_or_eq_top C with hc | ht
  · obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := G) p hd
    let z : center G := ⟨x, hc (subset_closure hx)⟩
    have hzorder : orderOf z = p := ((center G).orderOf_coe z).symm.trans hx
    exact ((Fact.out : p.Prime).coprime_iff_not_dvd.mp hz
      (hzorder ▸ orderOf_dvd_natCard z)).elim
  · exact ht

/-- Prime generation in the actual component remains prime generation in the ambient group. -/
theorem component_le_prime_closure (L : Subgroup G) [IsQuasisimple L]
    (hz : Nat.Coprime p (Nat.card (center L))) (hd : p ∣ Nat.card L) :
    L ≤ closure {x : G | orderOf x = p} := by
  have he := congrArg (map L.subtype) (prime_closure_eq_top hz hd)
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at he
  rw [← he]
  apply Subgroup.closure_mono
  rintro x ⟨y, hy, rfl⟩
  exact (L.orderOf_coe y).trans hy

omit [Finite G] [Fact p.Prime] in
/-- An order-p element whose action is realized by a normal subgroup belongs to it,
provided the action kernel has order prime to p. -/
theorem prime_element_mem_of_image_mem (f : G →* T)
    (hk : Nat.Coprime p (Nat.card f.ker)) (L : Subgroup G) [L.Normal]
    (x : G) (hx : orderOf x = p) (hi : f x ∈ L.map f) : x ∈ L := by
  obtain ⟨l, hl, he⟩ := hi
  have hc : l⁻¹ * x ∈ f.ker := by
    change f (l⁻¹ * x) = 1
    rw [map_mul, map_inv, he, inv_mul_cancel]
  let q := QuotientGroup.mk' L
  have hm : q x ∈ f.ker.map q := by
    refine ⟨l⁻¹ * x, hc, ?_⟩
    have hlq : q l = 1 := (QuotientGroup.eq_one_iff l).mpr hl
    rw [map_mul, map_inv, hlq, inv_one, one_mul]
  let y : f.ker.map q := ⟨q x, hm⟩
  have hc' : Nat.Coprime p (Nat.card (f.ker.map q)) :=
    hk.of_dvd_right (card_map_dvd _ _)
  have hp : y ^ p = 1 := by
    apply Subtype.ext
    change (q x) ^ p = 1
    rw [← map_pow, ← hx, pow_orderOf_eq_one, map_one]
  have hy : y = 1 := orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes hc' (orderOf_dvd_of_pow_eq_one hp) (orderOf_dvd_natCard y))
  exact (QuotientGroup.eq_one_iff x).mp (congrArg Subtype.val hy)

/-- Inner image absorbs the entire prime-generated subgroup, including all action-kernel elements. -/
theorem prime_closure_eq_component_of_image_le (f : G →* T)
    (hk : Nat.Coprime p (Nat.card f.ker)) (L : Subgroup G) [L.Normal]
    [IsQuasisimple L] (hz : Nat.Coprime p (Nat.card (center L)))
    (hd : p ∣ Nat.card L)
    (hi : (closure {x : G | orderOf x = p}).map f ≤ L.map f) :
    closure {x : G | orderOf x = p} = L := by
  apply le_antisymm
  · apply (closure_le _).mpr
    intro x hx
    exact prime_element_mem_of_image_mem f hk L x hx
      (hi (mem_map_of_mem _ (subset_closure hx)))
  · exact component_le_prime_closure L hz hd

variable [Finite S] [IsSimpleGroup S]

/-- A subgroup of the actual automorphism group containing all inner actors has
trivial p-prime core when p divides the simple component order. -/
theorem actor_pPrimeCore_eq_bot (A : Subgroup (MulAut S))
    (hA : MulAut.innerSubgroup S ≤ A) (hz : center S = ⊥)
    (hd : p ∣ Nat.card S) : pPrimeCore p A = ⊥ := by
  let I := (MulAut.innerSubgroup S).subgroupOf A
  let e : I ≃* S := (subgroupOfEquivOfLe hA).trans
    (MonoidHom.ofInjective (MulAut.conj_injective_of_center_eq_bot hz)).symm
  let : IsSimpleGroup I := e.isSimpleGroup
  have hI : pPrimeCore p I = ⊥ := by
    rcases (inferInstance : (pPrimeCore p I).Normal).eq_bot_or_eq_top with hb | ht
    · exact hb
    · have hc := pPrimeCore_coprime_card (p := p) (G := I)
      rw [ht, Nat.card_congr Subgroup.topEquiv.toEquiv, Nat.card_congr e.toEquiv] at hc
      exact ((Fact.out : p.Prime).coprime_iff_not_dvd.mp hc hd).elim
  apply pPrimeCore_eq_bot_of_selfCentralizing I hI
  intro a ha
  have hc : (a : MulAut S) ∈ centralizer (MulAut.innerSubgroup S : Set (MulAut S)) := by
    intro b hb
    exact congrArg Subtype.val (ha (⟨b, hA hb⟩ : A) hb)
  rw [MulAut.centralizer_innerSubgroup_eq_bot hz, mem_bot] at hc
  have he : a = 1 := Subtype.ext hc
  exact he ▸ I.one_mem

end Theory.GroupAction.ComponentRankAction
