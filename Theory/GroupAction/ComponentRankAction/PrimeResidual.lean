module

public import Theory.GroupAction.ComponentRankAction.PrimeClosure
public import Theory.GroupTheory.PResidual.PrimePowerGeneration

/-!
# Recovering the component from its prime-to-p residual action

If all p-elements act through a normal quasisimple component, the p-prime
kernel cannot contribute to the prime-to-p residual. Each p-element therefore
belongs to the component. Conversely the component is generated by its actual
order-p elements. The resulting equality uses O^{p′}, with no change to the
original group or action.

Source: Aschbacher–Smith, A.3.18, printed pp.51–53, in its rank-two linear
and symplectic applications in 2.5.7, p.556.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
namespace Theory.GroupAction.ComponentRankAction
variable {G T : Type*} [Group G] [Group T] {p : ℕ}

/-- An element of p-power order whose action comes from the normal component
belongs to that component when the action kernel is p-prime. -/
theorem primePower_element_mem_of_image_mem (f : G →* T)
    (hk : Nat.Coprime p (Nat.card f.ker)) (L : Subgroup G) [L.Normal]
    (x : G) (m : ℕ) (hx : x ^ (p ^ m) = 1) (hi : f x ∈ L.map f) : x ∈ L := by
  obtain ⟨l, hl, he⟩ := hi
  have hc : l⁻¹ * x ∈ f.ker := by
    change f (l⁻¹ * x) = 1
    rw [map_mul, map_inv, he, inv_mul_cancel]
  let q := QuotientGroup.mk' L
  have hm : q x ∈ f.ker.map q := by
    refine ⟨l⁻¹ * x, hc, ?_⟩
    have hlq : q l = 1 := (QuotientGroup.eq_one_iff l).mpr hl
    rw [map_mul, map_inv, hlq, inv_one, one_mul]
  let y : f.ker.map q := ⟨q x, hm⟩
  have hc' : Nat.Coprime (p ^ m) (Nat.card (f.ker.map q)) :=
    (hk.of_dvd_right (card_map_dvd _ _)).pow_left m
  have hp : y ^ (p ^ m) = 1 := by
    apply Subtype.ext
    change (q x) ^ (p ^ m) = 1
    rw [← map_pow, hx, map_one]
  have hy : y = 1 := orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes hc' (orderOf_dvd_of_pow_eq_one hp) (orderOf_dvd_natCard y))
  exact (QuotientGroup.eq_one_iff x).mp (congrArg Subtype.val hy)

/-- Inner action of the actual p-elements identifies the literal prime-to-p
residual with the normal component; no residual equality is assumed. -/
theorem primeToResidual_eq_component_of_primePower_action [Finite G] [Fact p.Prime]
    (f : G →* T) (hk : Nat.Coprime p (Nat.card f.ker))
    (L : Subgroup G) [L.Normal] [IsQuasisimple L]
    (hz : Nat.Coprime p (Nat.card (center L))) (hd : p ∣ Nat.card L)
    (hi : ∀ (x : G) (m : ℕ), x ^ (p ^ m) = 1 → f x ∈ L.map f) :
    primeToResidual p G = L := by
  apply le_antisymm
  · rw [primeToResidual_eq_closure_prime_power]
    apply (closure_le _).mpr
    rintro x ⟨m, hx⟩
    exact primePower_element_mem_of_image_mem f hk L x m hx (hi x m hx)
  · apply (component_le_prime_closure L hz hd).trans
    apply (closure_le _).mpr
    intro x hx
    change orderOf x = p at hx
    apply mem_primeToResidual_of_pow (n := 1)
    simpa only [pow_one, ← hx] using pow_orderOf_eq_one x

end Theory.GroupAction.ComponentRankAction
