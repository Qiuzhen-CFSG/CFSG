module

public import Theory.GroupAction.OddInvariantSylowConjugacy
public import Theory.GroupTheory.SubgroupConjugation
public import Theory.GroupAction.SubgroupConjugation
public import Theory.GroupTheory.Commutator.FixedConjugateContainment

/-!
# Ambient fixed Sylow conjugators and equivariant commutator embeddings

A two-group normalizing an odd subgroup has an invariant Sylow subgroup.
The fixed-conjugator theorem is transported along the literal subgroup map,
so its conjugator belongs to the ambient centralizer of the actor. If an
invariant subgroup Q is generated by its t-commutators and centralizes w,
that same conjugation embeds Q equivariantly into [C_P(w),t].
The map is x ↦ c*x*c⁻¹; in the source’s right-conjugation notation
the corresponding conjugator is c⁻¹.

Source: GLS, volume 4, Chapter 2, Proposition 16.5, the invariant Sylow
and R₀-embedding paragraphs. No solvability hypothesis is used.
-/

open Subgroup
namespace Theory.GroupAction
variable {G : Type*} [Group G] [Finite G]

/-- Invariant Sylow control using the actual ambient subgroup map and centralizer. -/
public theorem exists_invariant_sylow_ambient_fixed_control (H A : Subgroup G) (hodd : Odd (Nat.card H))
    (hA : IsPGroup 2 A) (hAH : A ≤ normalizer H) (p : ℕ) [Fact p.Prime] :
    ∃ P : Sylow p H,
      A ≤ normalizer ((P : Subgroup H).map H.subtype) ∧
      ∀ Q : Subgroup G, Q ≤ H → IsPGroup p Q → A ≤ normalizer Q →
        ∃ c : H, (c : G) ∈ centralizer (A : Set G) ∧
          Q.map (MulAut.conj (c : G)).toMonoidHom ≤ (P : Subgroup H).map H.subtype := by
  let : MulDistribMulAction A H := conjMulDistribMulActionOfLeNormalizer A H hAH
  obtain ⟨P, hPI, hc⟩ := exists_invariant_sylow_fixed_control hA hodd p
  have hAP : A ≤ normalizer ((P : Subgroup H).map H.subtype) := by
    apply subgroup_le_normalizer_of_conj_mem
    intro a x hx
    obtain ⟨y, hy, rfl⟩ := hx
    exact ⟨a • y, (hPI.invariant a y).mp hy, rfl⟩
  refine ⟨P, hAP, ?_⟩
  intro Q hQH hQp hAQ
  have hQI : IsInvariant A H (Q.subgroupOf H) := by
    refine ⟨fun a x => ?_⟩
    change (x : G) ∈ Q ↔ (a : G) * (x : G) * (a : G)⁻¹ ∈ Q
    exact mem_normalizer_iff.mp (hAQ a.property) _
  obtain ⟨c, hcf, hle⟩ := hc (Q.subgroupOf H)
    (hQp.of_equiv (subgroupOfEquivOfLe hQH).symm) hQI
  refine ⟨c, ?_, ?_⟩
  · intro a ha
    have he := congrArg Subtype.val (hcf ⟨a, ha⟩)
    change a * (c : G) * a⁻¹ = c at he
    exact mul_inv_eq_iff_eq_mul.mp he
  · rintro _ ⟨x, hx, rfl⟩
    exact ⟨c * (⟨x, hQH hx⟩ : H) * c⁻¹,
      hle (mem_map_of_mem _ (show (⟨x, hQH hx⟩ : H) ∈ Q.subgroupOf H from hx)), rfl⟩

omit [Finite G] in
/-- A fixed conjugator gives an injective homomorphism into the actual
fixed-centralizer commutator, preserving the conjugation action of every actor. -/
public theorem equivariant_embedding_fixed_commutator_of_conjugate_le
    (A P Q : Subgroup G) (hAQ : A ≤ normalizer Q)
    {t w c : G} (ht : t ∈ A) (hw : w ∈ A)
    (hc : c ∈ centralizer (A : Set G)) (hQP : Q.map (MulAut.conj c).toMonoidHom ≤ P)
    (hQw : Q ≤ centralizer ({w} : Set G)) (hQ : ⁅Q, zpowers t⁆ = Q)
    (hARw : A ≤ normalizer (⁅P ⊓ centralizer ({w} : Set G), zpowers t⁆ : Subgroup G)) :
    let Rw := ⁅P ⊓ centralizer ({w} : Set G), zpowers t⁆
    let : MulDistribMulAction A Q := conjMulDistribMulActionOfLeNormalizer A Q hAQ
    let : MulDistribMulAction A Rw := conjMulDistribMulActionOfLeNormalizer A Rw hARw
    ∃ f : Q →* Rw, Function.Injective f ∧
      (∀ x : Q, (f x : G) = c * x * c⁻¹) ∧
      ∀ (a : A) (x : Q), f (a • x) = a • f x := by
  dsimp only
  have hfix (a : G) (ha : a ∈ A) : (MulAut.conj c) a = a := by
    change c * a * c⁻¹ = a
    rw [← hc a ha, mul_inv_cancel_right]
  have hle := map_le_fixed_commutator_of_full_commutator P Q t w (MulAut.conj c)
    (hfix t ht) (hfix w hw) hQP hQw hQ
  let Rw := ⁅P ⊓ centralizer ({w} : Set G), zpowers t⁆
  let f : Q →* Rw := ((MulAut.conj c).toMonoidHom.comp Q.subtype).codRestrict Rw
    (fun x => hle (mem_map_of_mem _ x.property))
  refine ⟨f, ?_, fun _ => rfl, ?_⟩
  · intro x y he
    exact Subtype.ext ((MulAut.conj c).injective (congrArg Subtype.val he))
  · intro a x
    apply Subtype.ext
    change c * ((a : G) * x * (a : G)⁻¹) * c⁻¹ =
      (a : G) * (c * x * c⁻¹) * (a : G)⁻¹
    have hac := hc a a.property
    calc
      _ = (c * (a : G)) * x * (c * (a : G))⁻¹ := by group
      _ = ((a : G) * c) * x * ((a : G) * c)⁻¹ := by rw [hac]
      _ = _ := by group
end Theory.GroupAction
