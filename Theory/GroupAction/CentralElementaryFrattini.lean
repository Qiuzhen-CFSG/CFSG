module

public import Theory.Frattini.BinarySquares
public import Theory.GroupAction.Defs

/-!
# Frattini control from central elementary displacements

If every displacement of an action on a finite two-group lies in a central
elementary subgroup, then the action fixes every square.  Since the Frattini
subgroup is generated by squares, it is fixed pointwise.

Reference: Aschbacher--Smith, combined manuscript (1 March 2004), proof of
C.1.13(a), printed p.124.
-/

@[expose] public section

open scoped IsMulCommutative

/-- Central elementary displacements force the Frattini subgroup to be fixed. -/
public theorem frattini_le_fixed_of_central_elementary_displacement
    {A Q : Type*} [Group A] [Group Q] [Finite Q] [MulDistribMulAction A Q]
    (U : Subgroup Q) (hQ : IsPGroup 2 Q) (hcentral : U ≤ Subgroup.center Q)
    (hexp : ∀ u ∈ U, u ^ 2 = 1)
    (hdisp : ∀ (a : A) (q : Q), (a • q) / q ∈ U) :
    frattini Q ≤ FixedPoints.subgroup A Q := by
  rw [hQ.frattini_eq_closure_squares]
  apply (Subgroup.closure_le _).mpr
  rintro x ⟨q, rfl⟩
  change ∀ a : A, a • q ^ 2 = q ^ 2
  intro a
  let u : Q := (a • q) / q
  have hu : u ∈ U := hdisp a q
  have hcomm : Commute u q := (Subgroup.mem_center_iff.mp (hcentral hu) q).symm
  calc
    a • q ^ 2 = (a • q) ^ 2 := smul_pow' a q 2
    _ = (u * q) ^ 2 := by rw [div_mul_cancel]
    _ = u ^ 2 * q ^ 2 := hcomm.mul_pow 2
    _ = q ^ 2 := by rw [hexp u hu, one_mul]
