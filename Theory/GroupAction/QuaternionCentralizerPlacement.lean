module

public import Theory.GroupTheory.SolvableOuterQuotient
public import Mathlib.GroupTheory.SpecificGroups.Quaternion

/-!
# Quaternion placement under faithful automorphism transport

An actual group isomorphism transports automorphism order, the actual inner
image, element centralizers and the subgroup generated by the inner image
and a marked automorphism. Consequently quaternion placement transports in
both directions. Conjugation by any automorphism, in particular by an inner
automorphism, is such a transport.

These are transport lemmas for the quaternion-centralizer assertion used in
Aschbacher–Smith, proof of 16.4.9(2), printed p.1192. They do not assert a
centralizer calculation for a particular simple group.
-/

public section

open Subgroup
namespace MulAut
variable {G H : Type*} [Group G] [Group H]

/-- Transport preserves the order of the marked automorphism. -/
theorem orderOf_congr (e : G ≃* H) (a : MulAut G) :
    orderOf (MulAut.congr e a) = orderOf a :=
  (MulAut.congr e).orderOf_eq a

/-- Transport preserves membership in the actual conjugation image. -/
theorem congr_mem_inner_iff (e : G ≃* H) (a : MulAut G) :
    MulAut.congr e a ∈ (MulAut.conj : H →* MulAut H).range ↔
      a ∈ (MulAut.conj : G →* MulAut G).range := by
  change MulAut.congr e a ∈ innerSubgroup H ↔ a ∈ innerSubgroup G
  rw [← map_innerSubgroup_congr e]
  simpa only [MulEquiv.symm_apply_apply] using
    (mem_map_equiv (f := MulAut.congr e) (K := innerSubgroup G)
      (x := MulAut.congr e a))

/-- Transport identifies the full automorphism centralizers. -/
theorem map_centralizer_singleton_congr (e : G ≃* H) (a : MulAut G) :
    (centralizer ({a} : Set (MulAut G))).map (MulAut.congr e).toMonoidHom =
      centralizer ({MulAut.congr e a} : Set (MulAut H)) := by
  ext b
  constructor
  · rintro ⟨c, hc, rfl⟩
    apply mem_centralizer_singleton_iff.mpr
    simpa only [map_mul, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe] using
      congrArg (MulAut.congr e)
      (mem_centralizer_singleton_iff.mp hc)
  · intro hb
    refine ⟨(MulAut.congr e).symm b, ?_, (MulAut.congr e).apply_symm_apply b⟩
    apply mem_centralizer_singleton_iff.mpr
    apply (MulAut.congr e).injective
    simpa only [map_mul, MulEquiv.apply_symm_apply] using
      mem_centralizer_singleton_iff.mp hb

/-- Transport preserves the inner image together with the marked cyclic subgroup. -/
theorem map_inner_join_zpowers_congr (e : G ≃* H) (a : MulAut G) :
    ((MulAut.conj : G →* MulAut G).range ⊔ zpowers a).map
      (MulAut.congr e).toMonoidHom =
      (MulAut.conj : H →* MulAut H).range ⊔ zpowers (MulAut.congr e a) := by
  rw [Subgroup.map_sup, MonoidHom.map_zpowers]
  exact congrArg (· ⊔ zpowers (MulAut.congr e a)) (map_innerSubgroup_congr e)

/-- Pull quaternion placement back through a genuine group isomorphism. -/
theorem quaternion_centralizer_placement_transport (e : G ≃* H) (a : MulAut G)
    (h : ∀ P : Subgroup (MulAut H), Nonempty (P ≃* QuaternionGroup 2) →
      P ≤ centralizer ({MulAut.congr e a} : Set (MulAut H)) →
      P ≤ (MulAut.conj : H →* MulAut H).range ⊔ zpowers (MulAut.congr e a))
    (P : Subgroup (MulAut G)) (hP : Nonempty (P ≃* QuaternionGroup 2))
    (hC : P ≤ centralizer ({a} : Set (MulAut G))) :
    P ≤ (MulAut.conj : G →* MulAut G).range ⊔ zpowers a := by
  let f := (MulAut.congr e).toMonoidHom
  obtain ⟨q⟩ := hP
  have hq : Nonempty (P.map f ≃* QuaternionGroup 2) :=
    ⟨(P.equivMapOfInjective f (MulAut.congr e).injective).symm.trans q⟩
  have hc : P.map f ≤ centralizer ({MulAut.congr e a} : Set (MulAut H)) := by
    rw [← map_centralizer_singleton_congr e a]
    exact map_mono hC
  apply (map_le_map_iff_of_injective (f := (MulAut.congr e).toMonoidHom)
    (MulAut.congr e).injective).mp
  rw [map_inner_join_zpowers_congr]
  exact h _ hq hc

/-- Quaternion placement is preserved by automorphism conjugation. -/
theorem quaternion_centralizer_placement_conjugate (b a : MulAut G)
    (h : ∀ P : Subgroup (MulAut G), Nonempty (P ≃* QuaternionGroup 2) →
      P ≤ centralizer ({a} : Set (MulAut G)) →
      P ≤ (MulAut.conj : G →* MulAut G).range ⊔ zpowers a)
    (P : Subgroup (MulAut G)) (hP : Nonempty (P ≃* QuaternionGroup 2))
    (hC : P ≤ centralizer ({b * a * b⁻¹} : Set (MulAut G))) :
    P ≤ (MulAut.conj : G →* MulAut G).range ⊔ zpowers (b * a * b⁻¹) := by
  apply quaternion_centralizer_placement_transport b.symm (b * a * b⁻¹) _ P hP hC
  have he : MulAut.congr b.symm (b * a * b⁻¹) = a := by
    ext x
    simp [MulAut.congr]
  simpa only [he] using h

/-- Conjugation by an automorphism agrees with transport by that automorphism. -/
theorem congr_apply_eq_conjugate (b a : MulAut G) :
    MulAut.congr b a = b * a * b⁻¹ := by
  ext x
  rfl

/-- Conjugation preserves the marked automorphism's order. -/
theorem orderOf_conjugate (b a : MulAut G) :
    orderOf (b * a * b⁻¹) = orderOf a := by
  rw [← congr_apply_eq_conjugate]
  exact orderOf_congr b a

/-- Conjugation preserves outer status relative to the actual inner image. -/
theorem conjugate_not_mem_inner_iff (b a : MulAut G) :
    b * a * b⁻¹ ∉ (MulAut.conj : G →* MulAut G).range ↔
      a ∉ (MulAut.conj : G →* MulAut G).range := by
  rw [← congr_apply_eq_conjugate, congr_mem_inner_iff]

/-- Conjugation transports the full centralizer, including for inner conjugators. -/
theorem map_centralizer_singleton_conjugate (b a : MulAut G) :
    (centralizer ({a} : Set (MulAut G))).map (MulAut.congr b).toMonoidHom =
      centralizer ({b * a * b⁻¹} : Set (MulAut G)) := by
  rw [← congr_apply_eq_conjugate]
  exact map_centralizer_singleton_congr b a

/-- Conjugation preserves precisely the subgroup required by quaternion placement. -/
theorem map_inner_join_zpowers_conjugate (b a : MulAut G) :
    ((MulAut.conj : G →* MulAut G).range ⊔ zpowers a).map
      (MulAut.congr b).toMonoidHom =
      (MulAut.conj : G →* MulAut G).range ⊔ zpowers (b * a * b⁻¹) := by
  rw [← congr_apply_eq_conjugate]
  exact map_inner_join_zpowers_congr b a

end MulAut
