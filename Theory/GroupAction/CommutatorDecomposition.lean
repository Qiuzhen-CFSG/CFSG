module
public import Theory.GroupAction.Lemmas

/-!
# Splitting action commutators over invariant summands

For a commutative group module generated by a fixed subgroup and invariant
subgroups, its action commutator is generated by its intersections with the
invariant subgroups. This is the module-theoretic reduction used to split
Stellmacher's R in (8.1)(c), Journal of Algebra 190 (1997), p.37.

Induct over the generating family: fixed elements contribute the identity,
while commutators of elements in an invariant subgroup remain in it.
Commutativity makes the commutator of a product a product of commutators.
Neither finiteness nor directness of the generating family is required.
-/

open scoped IsMulCommutative

public theorem commutatorAction_eq_iSup_inf_of_fixed_sup
    {A V : Type*} [Group A] [Group V] [IsMulCommutative V]
    [MulDistribMulAction A V] {ι : Type*}
    (V0 : Subgroup V) (Vi : ι → Subgroup V)
    (hgen : V0 ⊔ ⨆ i, Vi i = ⊤)
    (hfixed : ∀ a : A, ∀ v : V, v ∈ V0 → a • v = v)
    (hinv : ∀ i, IsInvariant A V (Vi i)) :
    commutatorAction A V = ⨆ i, commutatorAction A V ⊓ Vi i := by
  let R := commutatorAction A V
  let K := ⨆ i, R ⊓ Vi i
  change R = K
  apply le_antisymm
  · change commutatorAction A V ≤ K
    rw [commutatorAction_eq_closure]
    apply (Subgroup.closure_le _).mpr
    rintro v ⟨a, x, rfl⟩
    let F : Option ι → Subgroup V := fun o ↦ o.elim V0 Vi
    have hFtop : ⨆ o, F o = ⊤ := by
      rw [iSup_option]
      exact hgen
    have hx : x ∈ ⨆ o, F o := by rw [hFtop]; trivial
    have hAll : ∀ b : A, x⁻¹ * b • x ∈ K := by
      apply Subgroup.iSup_induction F (C := fun v ↦ ∀ b : A, v⁻¹ * b • v ∈ K) hx
      · intro o v hv b
        cases o with
        | none =>
            change v ∈ V0 at hv
            simp only [hfixed b v hv, inv_mul_cancel]
            exact K.one_mem
        | some i =>
            have hR : v⁻¹ * b • v ∈ R := by
              change v⁻¹ * b • v ∈ commutatorAction A V
              rw [commutatorAction_eq_closure]
              exact Subgroup.subset_closure ⟨b, v, rfl⟩
            have hVi : v⁻¹ * b • v ∈ Vi i :=
              (Vi i).mul_mem ((Vi i).inv_mem hv) ((hinv i).invariant b v |>.mp hv)
            exact (le_iSup (fun j ↦ R ⊓ Vi j) i) ⟨hR, hVi⟩
      · intro b
        simp
      · intro v w hv hw b
        have hh := K.mul_mem (hv b) (hw b)
        simpa only [mul_inv_rev, smul_mul', mul_assoc, mul_left_comm, mul_comm] using hh
    exact hAll a
  · exact iSup_le fun _ ↦ inf_le_left

