private theorem certificate_15 (b c d : B) (hg : good (15,b,c,d))
    (hm : moves (15,b,c,d)) : ∃ k : Fin 53, perfect (15,b,c,d) k := by
  refine ⟨selected_15 b c d,perfect_of_check _ _ hg hm ?_⟩
  exact (List.all_eq_true.mp
    (List.all_eq_true.mp (List.all_eq_true.mp checked_15 b (List.mem_finRange b))
      c (List.mem_finRange c))) d (List.mem_finRange d)
/-- Every invertible plane-moving matrix with first column 12–15
has a selected perfect involution identity. -/
public theorem certificates_twelve_to_fifteen (g : Code) (hlo : 12 ≤ g.1.val)
    (hhi : g.1.val < 16) (hg : good g) (hm : moves g) :
    ∃ k : Fin 53, perfect g k := by
  rcases g with ⟨a,b,c,d⟩
  fin_cases a <;> norm_num at hlo <;> norm_num at hhi
  · exact certificate_12 b c d hg hm
  · exact certificate_13 b c d hg hm
  · exact certificate_14 b c d hg hm
  · exact certificate_15 b c d hg hm
end FixedFreeA4BinaryData
