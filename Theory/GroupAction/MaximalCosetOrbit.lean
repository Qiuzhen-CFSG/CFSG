module

public import Mathlib.GroupTheory.GroupAction.Quotient
public import Mathlib.GroupTheory.Index
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Algebra.Group.Subgroup.Finite
public import Mathlib.Algebra.Group.Pointwise.Set.Scalar
public import Mathlib.Order.Cover
public import Mathlib.Data.Nat.Prime.Basic

/-!
# A maximal subgroup in two coset stabilizers

If M is maximal in F, an element normalizing M but not F makes the two
F-coset stabilizers intersect in exactly M. When its square belongs to F,
it exchanges the two cosets, so their setwise stabilizer is generated by
M and this element. Orbit–stabilizer gives the corresponding F-suborbit.

This isolates the group-action argument in Aschbacher–Smith J.5.3,
printed p.445; the required source normalizer and parabolic geometry are
kept explicit.
-/

public section
noncomputable section
open Subgroup MulAction
open scoped Pointwise

namespace Subgroup
variable {G:Type*} [Group G] [Finite G]

/-- Maximality gives the exact intersection once the conjugator escapes the normalizer. -/
theorem inf_conjugate_eq_of_covBy {M F:Subgroup G} (hMF:M⋖F) {g:G}
    (hM:g∈normalizer (M:Set G)) (hF:g∉normalizer (F:Set G)) :
    F⊓F.map (MulAut.conj g).toMonoidHom=M := by
  have hMmap:M.map (MulAut.conj g).toMonoidHom=M:=mem_normalizer_iff_map_conj_eq.mp hM
  have hle:M≤F⊓F.map (MulAut.conj g).toMonoidHom:=
    le_inf hMF.le (hMmap ▸ map_mono hMF.le)
  rcases hMF.eq_or_eq hle inf_le_left with he | he
  · exact he
  · have hFF:F≤F.map (MulAut.conj g).toMonoidHom:=he.symm.le.trans inf_le_right
    have hc:Nat.card (F.map (MulAut.conj g).toMonoidHom)=Nat.card F:=
      (Nat.card_congr ((MulAut.conj g).subgroupMap F).toEquiv).symm
    have hf:F=F.map (MulAut.conj g).toMonoidHom:=eq_of_le_of_card_ge hFF (by rw [hc])
    exact False.elim (hF (mem_normalizer_iff_map_conj_eq.mpr hf.symm))

/-- The point stabilizer on the literal left-coset space is the original maximal subgroup. -/
theorem stabilizer_coset_eq_of_covBy {M F:Subgroup G} (hMF:M⋖F) {g:G}
    (hM:g∈normalizer (M:Set G)) (hF:g∉normalizer (F:Set G)) :
    stabilizer F (g • ((1:G):G⧸F))=M.subgroupOf F := by
  have he:=inf_conjugate_eq_of_covBy hMF hM hF
  have hs:=stabilizer_smul_eq_stabilizer_map_conj g ((1:G):G⧸F)
  rw [stabilizer_quotient] at hs
  ext x
  change (x:G)∈stabilizer G (g • ((1:G):G⧸F)) ↔ (x:G)∈M
  rw [hs,← he]
  exact (and_iff_right x.property).symm

/-- The exact source suborbit count before inserting the recognized parabolic orders. -/
theorem card_coset_orbit_mul_card_of_covBy {M F:Subgroup G} (hMF:M⋖F) {g:G}
    (hM:g∈normalizer (M:Set G)) (hF:g∉normalizer (F:Set G)) :
    Nat.card (orbit F (g • ((1:G):G⧸F)))*Nat.card M=Nat.card F := by
  have hc:=Nat.card_congr (orbitProdStabilizerEquivGroup F (g • ((1:G):G⧸F)))
  rw [Nat.card_prod,stabilizer_coset_eq_of_covBy hMF hM hF,
    Nat.card_congr (subgroupOfEquivOfLe hMF.le).toEquiv] at hc
  exact hc

omit [Finite G] in
/-- Every element outside a subgroup of relative prime index supplements it. -/
theorem sup_zpowers_eq_of_relIndex_prime {M J:Subgroup G} (hMJ:M≤J)
    {q:ℕ} (hq:q.Prime) (hi:M.relIndex J=q) {g:G} (hgJ:g∈J) (hgM:g∉M) :
    M⊔zpowers g=J := by
  let K:=M⊔zpowers g
  have hMK:M≤K:=le_sup_left
  have hKJ:K≤J:=sup_le hMJ (zpowers_le.mpr hgJ)
  have hn:M.relIndex K≠1:=by
    intro h
    exact hgM (relIndex_eq_one.mp h ((show zpowers g≤K from le_sup_right) (mem_zpowers g)))
  have hm: M.relIndex K*K.relIndex J=q:=(relIndex_mul_relIndex M K J hMK hKJ).trans hi
  have he:M.relIndex K=q:=((Nat.dvd_prime hq).mp ⟨K.relIndex J,hm.symm⟩).resolve_left hn
  rw [he] at hm
  have hk:K.relIndex J=1:=Nat.eq_of_mul_eq_mul_left hq.pos (by simpa only [mul_one] using hm)
  exact le_antisymm hKJ (relIndex_eq_one.mp hk)

end Subgroup

namespace MulAction
variable {G Ω:Type*} [Group G] [MulAction G Ω]

/-- The setwise stabilizer of two exchanged points is the pointwise stabilizer plus the swap. -/
theorem stabilizer_pair_eq_sup {x y:Ω} {g:G} (hxy:g•x=y) (hyx:g•y=x) :
    stabilizer G ({x,y}:Set Ω)=(stabilizer G x⊓stabilizer G y)⊔zpowers g := by
  have mem_iff (a:G) : a∈stabilizer G ({x,y}:Set Ω) ↔
      (a•x=x ∧ a•y=y) ∨ (a•x=y ∧ a•y=x) := by
    change a•({x,y}:Set Ω)={x,y} ↔ _
    rw [Set.smul_set_insert,Set.smul_set_singleton,Set.pair_eq_pair_iff]
  apply le_antisymm
  · intro a ha
    rcases (mem_iff a).mp ha with hf | hs
    · exact (show stabilizer G x⊓stabilizer G y≤_ from le_sup_left) hf
    · have hfix:g⁻¹*a∈stabilizer G x⊓stabilizer G y:=by
        constructor
        · change (g⁻¹*a)•x=x
          rw [mul_smul,hs.1,inv_smul_eq_iff,hxy]
        · change (g⁻¹*a)•y=y
          rw [mul_smul,hs.2,inv_smul_eq_iff,hyx]
      have hm:=((stabilizer G x⊓stabilizer G y)⊔zpowers g).mul_mem
        ((show zpowers g≤_ from le_sup_right) (mem_zpowers g))
        ((show stabilizer G x⊓stabilizer G y≤_ from le_sup_left) hfix)
      simpa only [mul_inv_cancel_left] using hm
  · apply sup_le
    · intro a ha
      exact (mem_iff a).mpr (Or.inl ha)
    · exact zpowers_le.mpr ((mem_iff g).mpr (Or.inr ⟨hxy,hyx⟩))

end MulAction
