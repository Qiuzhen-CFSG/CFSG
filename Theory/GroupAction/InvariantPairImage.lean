module
public import Mathlib.GroupTheory.Index

/-!
# Image order from two invariant subgroups

An action on a group generated by two invariant subgroups is detected by
its two restrictions. The action image is isomorphic to the joint restriction
image, so its order divides the product of the two restriction-image orders.
The subgroups may intersect. This is the product-image step used in the
endomorphism argument of Aschbacher--Smith, 10.2.3(2), printed p.745.
-/

public noncomputable section
namespace Theory.GroupTheory
open Subgroup

/-- Restriction to an invariant subgroup, with the original automorphisms. -/
def invariantSubgroupAction {A V : Type*} [Group A] [Group V]
    (f : A →* MulAut V) (W : Subgroup V)
    (hw : ∀ a : A, W.map (f a).toMonoidHom = W) : A →* MulAut W where
  toFun a := ((f a).subgroupMap W).trans (MulEquiv.subgroupCongr (hw a))
  map_one' := by
    apply MulEquiv.ext
    intro w
    apply Subtype.ext
    change f 1 (w : V) = (w : V)
    rw [map_one]
    rfl
  map_mul' := by
    intro a b
    apply MulEquiv.ext
    intro w
    apply Subtype.ext
    change f (a * b) (w : V) = f a (f b (w : V))
    rw [map_mul]
    rfl

/-- Restriction retains the original ambient action on every element. -/
theorem invariantSubgroupAction_apply {A V : Type*} [Group A] [Group V]
    (f : A →* MulAut V) (W : Subgroup V)
    (hw : ∀ a : A, W.map (f a).toMonoidHom = W) (a : A) (w : W) :
    (invariantSubgroupAction f W hw a w : V) = f a w := by rfl

/-- The image of an action on a generated pair embeds in the product of its
 two restriction images. No disjointness or irreducibility is needed. -/
theorem action_image_card_dvd_product {A V : Type*} [Group A] [Group V]
    [Finite A] [Finite V] (f : A →* MulAut V) (W U : Subgroup V)
    (hw : ∀ a : A, W.map (f a).toMonoidHom = W)
    (hu : ∀ a : A, U.map (f a).toMonoidHom = U) (hgen : W ⊔ U = ⊤) :
    Nat.card f.range ∣ Nat.card (invariantSubgroupAction f W hw).range *
      Nat.card (invariantSubgroupAction f U hu).range := by
  let r := invariantSubgroupAction f W hw
  let s := invariantSubgroupAction f U hu
  let g := r.rangeRestrict.prod s.rangeRestrict
  have hk : g.ker = f.ker := by
    ext a
    constructor
    · intro ha
      have hw' : ∀ w ∈ W, f a w = w := by
        intro w hw
        exact congrArg (fun p : r.range × s.range => ((p.1.val ⟨w,hw⟩ : W) : V)) ha
      have hu' : ∀ u ∈ U, f a u = u := by
        intro u hu
        exact congrArg (fun p : r.range × s.range => ((p.2.val ⟨u,hu⟩ : U) : V)) ha
      apply MulEquiv.ext
      intro v
      exact (show W ⊔ U ≤ (f a).toMonoidHom.eqLocus (MonoidHom.id V) from
        sup_le hw' hu') (hgen ▸ mem_top v)
    · intro ha
      apply Prod.ext <;> apply Subtype.ext <;> apply MulEquiv.ext <;> intro v <;>
        apply Subtype.ext
      · exact congrArg (fun e : MulAut V => e v) ha
      · exact congrArg (fun e : MulAut V => e v) ha
  let e : f.range ≃* g.range := (QuotientGroup.quotientKerEquivRange f).symm.trans
    ((QuotientGroup.quotientMulEquivOfEq hk.symm).trans
      (QuotientGroup.quotientKerEquivRange g))
  rw [Nat.card_congr e.toEquiv,← Nat.card_prod]
  exact card_subgroup_dvd_card _


end Theory.GroupTheory
