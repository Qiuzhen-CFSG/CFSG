module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Independent inversion and interchange of order-three factors

Let a group act by automorphisms on a commutative group generated by two
subgroups of order three. Suppose one actor inverts the first factor and
fixes the second, and another actor interchanges the factors. Every invariant
subgroup splits into its intersections with those factors and is therefore
trivial or the whole group. No particular coordinate signs are imposed on
the actor interchanging the factors.

For the splitting, if `x = x₁ * x₂` belongs to an invariant subgroup, then
`x⁻¹ * a(x) = x₁⁻² = x₁`, so both factors belong to that subgroup. Any
nonidentity element of a factor generates it, and the second actor supplies
the other factor. The commutator of the two actors inverts both factors;
this last assertion does not need the order-three or finiteness assumptions.

This is the elementary action step used in Aschbacher–Smith, *The
Classification of Quasithin Groups*, combined 1 March 2004 manuscript,
15.4.20, printed p.1164. Its commutator identity also supplies the inversion
witness in the order-nine instance of the argument in 1.3.2(4), p.509.
The source applications must construct the actual factor and actor witnesses.
-/

@[expose] public section

open scoped IsMulCommutative commutatorElement
open Subgroup

namespace OrderNineFactorExchange

variable {A U : Type*} [Group A] [IsMulCommutative A] [Group U]

private theorem inverse_square_of_card_three [Finite A]
    (L : Subgroup A) (hL : Nat.card L = 3) {x : A} (hx : x ∈ L) :
    x⁻¹ * x⁻¹ = x := by
  have hx3 : x ^ 3 = 1 := by
    have hh := pow_card_eq_one' (x := (⟨x, hx⟩ : L))
    rw [hL] at hh
    exact congrArg Subtype.val hh
  have hxx : x * x = x⁻¹ := by
    apply (eq_inv_iff_mul_eq_one).mpr
    simpa only [pow_succ, pow_zero, one_mul] using hx3
  rw [← mul_inv_rev, hxx, inv_inv]

private theorem mem_of_prime_factor_intersection
    (L D : Subgroup A) (hL : Nat.card L = 3) {x : A}
    (hxL : x ∈ L) (hxD : x ∈ D) (hx : x ≠ 1) : L ≤ D := by
  let : Fact (Nat.card L).Prime := ⟨hL ▸ by decide⟩
  rcases (D.subgroupOf L).eq_bot_or_eq_top_of_prime_card with hb | ht
  · exact False.elim (hx (by
      have hh : (⟨x, hxL⟩ : L) ∈ (⊥ : Subgroup L) := hb ▸ hxD
      exact congrArg Subtype.val (Subgroup.mem_bot.mp hh)))
  · intro y hy
    have hh : (⟨y, hy⟩ : L) ∈ D.subgroupOf L := ht ▸ mem_top _
    exact hh

/-- Invariance under inversion of the first order-three factor and fixation
of the second splits a subgroup along those factors. The factors need only
generate the ambient group; their disjointness is not required. -/
theorem invariant_subgroup_split [Finite A]
    (α : U →* MulAut A) (A1 A2 : Subgroup A) (hgen : A1 ⊔ A2 = ⊤)
    (hcard1 : Nat.card A1 = 3) (a : U)
    (hinvert : ∀ x ∈ A1, α a x = x⁻¹)
    (hfix : ∀ x ∈ A2, α a x = x)
    (D : Subgroup A) (hD : ∀ x ∈ D, α a x ∈ D) :
    D = (D ⊓ A1) ⊔ (D ⊓ A2) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨x1, hx1, x2, hx2, rfl⟩ :=
      Subgroup.mem_sup.mp (show x ∈ A1 ⊔ A2 from hgen ▸ mem_top x)
    have hproj : (x1 * x2)⁻¹ * α a (x1 * x2) = x1 := by
      rw [map_mul, hinvert x1 hx1, hfix x2 hx2]
      calc
        (x1 * x2)⁻¹ * (x1⁻¹ * x2) = (x2 * x1)⁻¹ * (x2 * x1⁻¹) := by
          rw [mul_comm x1 x2, mul_comm x1⁻¹ x2]
        _ = x1⁻¹ * x1⁻¹ := by simp only [mul_inv_rev, mul_assoc, inv_mul_cancel_left]
        _ = x1 := inverse_square_of_card_three A1 hcard1 hx1
    have hx1D : x1 ∈ D := hproj ▸ D.mul_mem (D.inv_mem hx) (hD _ hx)
    have hx2D : x2 ∈ D := by
      simpa only [inv_mul_cancel_left] using D.mul_mem (D.inv_mem hx1D) hx
    exact (Subgroup.mem_sup.mpr ⟨x1, ⟨hx1D, hx1⟩, x2, ⟨hx2D, hx2⟩, rfl⟩)
  · exact sup_le inf_le_left inf_le_left

/-- An independent inversion and an arbitrary interchange of two order-three
factors force irreducibility on actual subgroups. Neither actor is assumed
to be an involution in the acting group, and the action need not be faithful. -/
theorem irreducible_of_factor_exchange [Finite A]
    (α : U →* MulAut A) (A1 A2 : Subgroup A) (hgen : A1 ⊔ A2 = ⊤)
    (hcard1 : Nat.card A1 = 3) (hcard2 : Nat.card A2 = 3) (a b : U)
    (hinvert : ∀ x ∈ A1, α a x = x⁻¹)
    (hfix : ∀ x ∈ A2, α a x = x)
    (hexchange1 : A1.map (α b).toMonoidHom = A2)
    (hexchange2 : A2.map (α b).toMonoidHom = A1) :
    ∀ D : Subgroup A, (∀ u : U, ∀ x ∈ D, α u x ∈ D) → D = ⊥ ∨ D = ⊤ := by
  intro D hD
  by_cases hbot : D = ⊥
  · exact Or.inl hbot
  right
  have hsplit := invariant_subgroup_split α A1 A2 hgen hcard1 a hinvert hfix D (hD a)
  have hex : ∃ x ∈ D, x ≠ 1 := by
    by_contra h
    push Not at h
    exact hbot (eq_bot_iff.mpr h)
  obtain ⟨x, hxD, hx⟩ := hex
  obtain ⟨x1, ⟨hx1D, hx1⟩, x2, ⟨hx2D, hx2⟩, hprod⟩ :=
    Subgroup.mem_sup.mp (hsplit ▸ hxD)
  have hfactor : A1 ≤ D ∨ A2 ≤ D := by
    by_cases hx1ne : x1 = 1
    · have hx2ne : x2 ≠ 1 := by
        intro heq
        exact hx (by simpa only [hx1ne, heq, one_mul] using hprod.symm)
      exact Or.inr (mem_of_prime_factor_intersection A2 D hcard2 hx2 hx2D hx2ne)
    · exact Or.inl (mem_of_prime_factor_intersection A1 D hcard1 hx1 hx1D hx1ne)
  have hmap : D.map (α b).toMonoidHom ≤ D := by
    rintro _ ⟨y, hy, rfl⟩
    exact hD b y hy
  have hboth : A1 ≤ D ∧ A2 ≤ D := by
    rcases hfactor with h1 | h2
    · exact ⟨h1, hexchange1 ▸ (map_mono h1).trans hmap⟩
    · exact ⟨hexchange2 ▸ (map_mono h2).trans hmap, h2⟩
  exact top_unique (hgen ▸ sup_le hboth.1 hboth.2)

omit [IsMulCommutative A] in
private theorem inverse_mem_of_map_eq (f : MulAut A) {B C : Subgroup A}
    (h : B.map f.toMonoidHom = C) {x : A} (hx : x ∈ C) : f⁻¹ x ∈ B := by
  obtain ⟨y, hy, rfl⟩ := (show x ∈ B.map f.toMonoidHom from h ▸ hx)
  simpa using hy

/-- With the convention `⁅a,b⁆ = a * b * a⁻¹ * b⁻¹`, the commutator of an
independent inversion and a factor exchanger inverts the whole group.
No order, finiteness, or involution hypothesis on the actors is needed. -/
theorem commutator_inverts_of_factor_exchange
    (α : U →* MulAut A) (A1 A2 : Subgroup A) (hgen : A1 ⊔ A2 = ⊤)
    (a b : U) (hinvert : ∀ x ∈ A1, α a x = x⁻¹)
    (hfix : ∀ x ∈ A2, α a x = x)
    (hexchange1 : A1.map (α b).toMonoidHom = A2)
    (hexchange2 : A2.map (α b).toMonoidHom = A1) :
    ∀ x : A, α ⁅a, b⁆ x = x⁻¹ := by
  have haa : α a * α a = 1 := by
    ext x
    obtain ⟨x1, hx1, x2, hx2, rfl⟩ :=
      Subgroup.mem_sup.mp (show x ∈ A1 ⊔ A2 from hgen ▸ mem_top x)
    change α a (α a (x1 * x2)) = x1 * x2
    rw [map_mul, hinvert x1 hx1, hfix x2 hx2, map_mul, map_inv,
      hinvert x1 hx1, hfix x2 hx2, inv_inv]
  have hai : (α a)⁻¹ = α a := inv_eq_of_mul_eq_one_left haa
  have hfirst (x : A) (hx : x ∈ A1) : α ⁅a, b⁆ x = x⁻¹ := by
    rw [map_commutatorElement, commutatorElement_def, hai]
    change α a (α b (α a ((α b)⁻¹ x))) = x⁻¹
    rw [hfix _ (inverse_mem_of_map_eq (α b) hexchange2 hx)]
    simpa using hinvert x hx
  have hsecond (x : A) (hx : x ∈ A2) : α ⁅a, b⁆ x = x⁻¹ := by
    rw [map_commutatorElement, commutatorElement_def, hai]
    change α a (α b (α a ((α b)⁻¹ x))) = x⁻¹
    rw [hinvert _ (inverse_mem_of_map_eq (α b) hexchange1 hx), map_inv]
    simpa using hfix x⁻¹ (A2.inv_mem hx)
  intro x
  obtain ⟨x1, hx1, x2, hx2, rfl⟩ :=
    Subgroup.mem_sup.mp (show x ∈ A1 ⊔ A2 from hgen ▸ mem_top x)
  rw [map_mul, hfirst x1 hx1, hsecond x2 hx2, mul_inv_rev, mul_comm]

end OrderNineFactorExchange
