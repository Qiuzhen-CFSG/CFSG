module

public import Theory.GroupTheory.NormalizingInvolutionCard
public import Theory.ElementaryAbelian.Basic

/-!
# Completing elementary bases along a nilpotent chain

In an elementary abelian group of order thirty-two, a homomorphism carrying
w to u to v to t to 1 proves that u and w successively extend the subgroup
generated by z,t,v. Its iterated kernels separate each new element from the
preceding subgroup. Counting the successive index-two extensions identifies
the prescribed subgroup of order sixteen and then the whole group.

This elementary argument supplies the basis verification for the action in
Parrott, *A characterization of the Tits' simple group* (1972), p.678, (1).
-/

open Subgroup
open scoped IsMulCommutative

namespace Theory.GroupAction

private theorem append_closure {V : Type*} [Group V] (a b c d : V) :
    closure ({a, b, c, d} : Set V) = closure ({a, b, c} : Set V) ⊔ zpowers d := by
  rw [show ({a, b, c, d} : Set V) = {a, b, c} ∪ {d} by
    ext; simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_union]; tauto,
    Subgroup.closure_union, ← zpowers_eq_closure]

/-- Successive preimages in a length-four chain complete the prescribed
order-eight subgroup first to the supplied hyperplane, then to the group. -/
public theorem elementary_thirty_two_basis_of_chain
    {V : Type*} [Group V] [Finite V] [IsElementaryAbelian 2 V]
    (s : V →* V) (z t v u w : V) (U : Subgroup V)
    (hV : Nat.card V = 32) (hU : Nat.card U = 16)
    (hZ : Nat.card (closure ({z, t, v} : Set V)) = 8)
    (hzU : z ∈ U) (htU : t ∈ U) (hvU : v ∈ U) (huU : u ∈ U)
    (ht : t ≠ 1) (sz : s z = 1) (st : s t = 1)
    (sv : s v = t) (su : s u = v) (sw : s w = u) :
    closure ({z, t, v, u} : Set V) = U ∧
      closure ({z, t, v, u, w} : Set V) = ⊤ := by
  let A := closure ({z, t, v} : Set V)
  let B := closure ({z, t, v, u} : Set V)
  have hAker : A ≤ (s.comp s).ker := by
    apply (closure_le _).mpr
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl | rfl <;>
      simp [MonoidHom.mem_ker, MonoidHom.comp_apply, sz, st, sv]
  have huA : u ∉ A := by
    intro hu
    have hh := MonoidHom.mem_ker.mp (hAker hu)
    change s (s u) = 1 at hh
    rw [su, sv] at hh
    exact ht hh
  have hsq (a : V) : a ^ 2 = 1 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 V) a
  have hnorm (S : Subgroup V) (a : V) : a ∈ normalizer (S : Set V) := by
    apply centralizer_le_normalizer
    intro b _
    exact mul_comm _ _
  have hBcard : Nat.card B = 16 := by
    dsimp only [B]
    rw [append_closure, card_sup_zpowers_of_normalizing_involution _
      u (hsq u) huA (hnorm _ u), hZ]
  have hBU : B = U := by
    apply eq_of_le_of_card_ge ?_ (by rw [hBcard, hU])
    apply (closure_le _).mpr
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl | rfl | rfl <;> assumption
  have hBker : B ≤ (s.comp (s.comp s)).ker := by
    apply (closure_le _).mpr
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl | rfl | rfl <;>
      simp [MonoidHom.mem_ker, MonoidHom.comp_apply, sz, st, sv, su]
  have hwB : w ∉ B := by
    intro hw
    have hh := MonoidHom.mem_ker.mp (hBker hw)
    change s (s (s w)) = 1 at hh
    rw [sw, su, sv] at hh
    exact ht hh
  refine ⟨hBU, ?_⟩
  have heq : closure ({z, t, v, u, w} : Set V) = B ⊔ zpowers w := by
    rw [show ({z, t, v, u, w} : Set V) = {z, t, v, u} ∪ {w} by
      ext; simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_union]; tauto,
      Subgroup.closure_union, ← zpowers_eq_closure]
  rw [heq]
  apply eq_top_of_card_eq
  rw [card_sup_zpowers_of_normalizing_involution _ w (hsq w) hwB (hnorm _ w),
    hBcard, hV]

end Theory.GroupAction
