private theorem checked_7 :
    ((List.finRange 16).all fun b => (List.finRange 16).all fun c =>
      (List.finRange 16).all fun d => checks (7,b,c,d) (selected_7 b c d)) = true := by
  decide +kernel
private theorem certificate_7 (b c d : B) (hg : good (7,b,c,d))
    (hm : moves (7,b,c,d)) : ∃ k : Fin 53, perfect (7,b,c,d) k := by
  refine ⟨selected_7 b c d,perfect_of_check _ _ hg hm ?_⟩
  exact (List.all_eq_true.mp
    (List.all_eq_true.mp (List.all_eq_true.mp checked_7 b (List.mem_finRange b))
      c (List.mem_finRange c))) d (List.mem_finRange d)
/-- Every invertible plane-moving matrix with first column 4–7
has a selected perfect involution identity. -/
public theorem certificates_four_to_seven (g : Code) (hlo : 4 ≤ g.1.val)
    (hhi : g.1.val < 8) (hg : good g) (hm : moves g) :
    ∃ k : Fin 53, perfect g k := by
  rcases g with ⟨a,b,c,d⟩
  fin_cases a <;> norm_num at hlo <;> norm_num at hhi
  · exact certificate_4 b c d hg hm
  · exact certificate_5 b c d hg hm
  · exact certificate_6 b c d hg hm
  · exact certificate_7 b c d hg hm
end FixedFreeA4BinaryData
