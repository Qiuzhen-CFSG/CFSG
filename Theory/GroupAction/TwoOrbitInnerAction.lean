module
public import Theory.GroupTheory.NormalizerAction
public import Theory.GroupAction.IrreducibleInnerContainment
public import Theory.GroupTheory.GeneralizedFitting.SylowComponentOrbit

/-!
# Inner action on a two-component orbit

An odd p-subgroup normalizes a factor with normalizer of index two. The
Frattini subgroup of every actor also maps into that normalizer. If the
factor has abelian outer group, a subgroup generated by these commutators
therefore acts on the factor by inner automorphisms. A two-group outer
quotient gives the same conclusion directly by coprimality. The same holds on its
other conjugate. As the two components commute, their inner actions combine
to an inner action on the entire normal orbit.

This is the group-theoretic exchanged-component step in Aschbacher--Smith,
proof of Proposition 1.3.4, printed p.510. The component-model proof of
abelian outer automorphisms remains at the source classification layer.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
open scoped IsMulCommutative Pointwise
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
theorem frattini_le_of_index_dvd_two_source (N : Subgroup G) (h : N.index ∣ 2) :
    frattini G ≤ N := by
  rcases Nat.prime_two.eq_one_or_self_of_dvd _ h with h1 | h2
  · rw [index_eq_one.mp h1]; exact le_top
  · apply frattini_le_coatom
    apply (covBy_top_iff).mp
    refine ⟨Ne.lt_top (fun he => by simp [he] at h2), ?_⟩
    intro K hNK hKt
    have hp : (N.relIndex K * K.index).Prime := by rw [relIndex_mul_index hNK.le,h2]; exact Nat.prime_two
    rcases Nat.prime_mul_iff.mp hp with ⟨_,hK⟩ | ⟨_,hN⟩
    · exact hKt.ne (index_eq_one.mp hK)
    · exact hNK.not_ge (relIndex_eq_one.mp hN)

theorem odd_pGroup_le_index_two_source {p : ℕ} [Fact p.Prime]
    (P N : Subgroup G) (hP : IsPGroup p P) (ho : Odd p) (hN : N.index = 2) : P ≤ N := by
  have : N.Normal := N.normal_of_index_eq_two hN
  obtain ⟨n,hn⟩ := hP.exists_card_eq
  have hcop : N.index.Coprime (Nat.card P) := by
    rw [hN, hn]
    exact (Nat.coprime_two_left.mpr ho).pow_right n
  rw [← relIndex_eq_one]
  exact Nat.eq_one_of_dvd_coprimes hcop (N.relIndex_dvd_index_of_normal P)
    (N.relIndex_dvd_card P)

omit [Finite G] in
theorem commutator_inner_of_outer_abelian_source (L P D : Subgroup G)
    [IsMulCommutative (MulAut.Outer L)]
    (hP : P ≤ normalizer (L : Set G)) (hD : D ≤ normalizer (L : Set G))
    (hcomm : ⁅P,D⁆ = P) : P ≤ L ⊔ centralizer (L : Set G) := by
  let N := normalizer (L : Set G)
  have he : ⁅P.subgroupOf N,D.subgroupOf N⁆ = P.subgroupOf N := by
    apply map_injective N.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hP, map_subgroupOf_eq_of_le hD, hcomm]
  have hi := NormalizerAction.commutator_generated_image_le L (P.subgroupOf N) (D.subgroupOf N) he
  intro p hp
  obtain ⟨l,hl,heq⟩ := hi (mem_map_of_mem (NormalizerAction.quotient L) (show (⟨p,hP hp⟩ : N) ∈ P.subgroupOf N from hp))
  have heq' : NormalizerAction.quotient L (l⁻¹ * ⟨p,hP hp⟩) = 1 := by
    rw [map_mul,map_inv,heq,inv_mul_cancel]
  have hc : (l : G)⁻¹*p ∈ centralizer (L : Set G) :=
    (NormalizerAction.quotient_eq_one_iff L _).mp heq'
  have hh := (L ⊔ centralizer (L : Set G)).mul_mem (mem_sup_left hl) (mem_sup_right hc)
  change (l : G) * ((l : G)⁻¹*p) ∈ _ at hh
  simpa only [mul_inv_cancel_left] using hh


omit [Finite G] in
theorem frattini_map_le_index_two_source {A : Type*} [Group A]
    (f : A →* G) (N : Subgroup G) (hN : N.index = 2) :
    (frattini A).map f ≤ N := by
  have : N.Normal := N.normal_of_index_eq_two hN
  apply map_le_iff_le_comap.mpr
  apply frattini_le_of_index_dvd_two_source
  rw [index_comap]
  exact hN ▸ N.relIndex_dvd_index_of_normal f.range

omit [Finite G] in
private theorem inner_factorization (L : Subgroup G) {p : G}
    (hp : p ∈ L ⊔ centralizer (L : Set G)) :
    ∃ l ∈ L, l⁻¹*p ∈ centralizer (L : Set G) := by
  have hh : p ∈ (L : Set G) * (centralizer (L : Set G) : Set G) := by
    rw [← coe_mul_of_right_le_normalizer_left L (centralizer (L : Set G))
      (centralizer_le_normalizer _)]
    exact hp
  obtain ⟨l,hl,c,hc,rfl⟩ := hh
  refine ⟨l,hl,?_⟩
  rw [inv_mul_cancel_left]
  exact hc

omit [Finite G] in
theorem inner_sup_of_commuting_factors_source (L M : Subgroup G)
    (hLM : L ≤ centralizer (M : Set G)) :
    (L ⊔ centralizer (L : Set G)) ⊓ (M ⊔ centralizer (M : Set G)) ≤
      (L ⊔ M) ⊔ centralizer ((L ⊔ M : Subgroup G) : Set G) := by
  rintro p ⟨hpL,hpM⟩
  obtain ⟨l,hl,hcl⟩ := inner_factorization L hpL
  obtain ⟨m,hm,hcm⟩ := inner_factorization M hpM
  have hcL : (l*m)⁻¹*p ∈ centralizer (L : Set G) := by
    rw [mul_inv_rev, mul_assoc]
    exact mul_mem (inv_mem ((le_centralizer_iff.mp hLM) hm)) hcl
  have hcM : (l*m)⁻¹*p ∈ centralizer (M : Set G) := by
    have he : l*m=m*l := (hLM hl m hm).symm
    rw [he, mul_inv_rev, mul_assoc]
    exact mul_mem (inv_mem (hLM hl)) hcm
  have hc : (l*m)⁻¹*p ∈ centralizer ((L ⊔ M : Subgroup G) : Set G) := by
    apply le_centralizer_iff.mp ?_ (mem_zpowers ((l*m)⁻¹*p))
    apply sup_le
    · exact le_centralizer_iff.mpr (zpowers_le.mpr hcL)
    · exact le_centralizer_iff.mpr (zpowers_le.mpr hcM)
  have h := ((L ⊔ M) ⊔ centralizer ((L ⊔ M : Subgroup G) : Set G)).mul_mem
    (mem_sup_left (mul_mem (mem_sup_left hl) (mem_sup_right hm))) (mem_sup_right hc)
  simpa only [mul_inv_cancel_left] using h

end Subgroup

open scoped IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

theorem frattini_commutator_inner_source {p : ℕ} [Fact p.Prime]
    {A : Type*} [Group A] (f : A →* G) (B P : Subgroup G)
    (hP : IsPGroup p P) (ho : Odd p) (hB : (normalizer (B : Set G)).index = 2)
    [IsMulCommutative (MulAut.Outer B)]
    (hc : P = ⁅P,(frattini A).map f⁆) : P ≤ B ⊔ centralizer (B : Set G) :=
  commutator_inner_of_outer_abelian_source B P _
    (odd_pGroup_le_index_two_source P _ hP ho hB)
    (frattini_map_le_index_two_source f _ hB) hc.symm

omit [Finite G] in
theorem orbit_eq_pair_of_normal_index_two_source
    (B A : Subgroup G) (hi : (normalizer (B : Set G)).index = 2)
    [(componentOrbit B A).Normal] (g : G) (hg : g ∉ normalizer (B : Set G)) :
    componentOrbit B A = B ⊔ B.map (MulAut.conj g).toMonoidHom := by
  apply le_antisymm
  · apply iSup_le
    intro a
    by_cases ha : (a : G) ∈ normalizer (B : Set G)
    · have he : B.map (MulAut.conj (a : G)).toMonoidHom = B := mem_normalizer_iff_map_conj_eq.mp ha
      rw [he]; exact le_sup_left
    · have hga : g⁻¹*(a : G) ∈ normalizer (B : Set G) :=
        (mul_mem_iff_of_index_two hi).mpr (iff_of_false (by simpa using hg) ha)
      have he : B.map (MulAut.conj (a : G)).toMonoidHom = B.map (MulAut.conj g).toMonoidHom := by
        calc
          _ = (B.map (MulAut.conj (g⁻¹*(a : G))).toMonoidHom).map (MulAut.conj g).toMonoidHom := by
            rw [map_map]
            congr 1
            ext z
            simp [MulAut.conj_apply,mul_assoc]
          _ = _ := congrArg (map (MulAut.conj g).toMonoidHom)
            (mem_normalizer_iff_map_conj_eq.mp hga)
      rw [he]
      exact le_sup_right
  · apply sup_le (le_componentOrbit B A)
    have hh := map_mono (f := (MulAut.conj g).toMonoidHom) (le_componentOrbit B A)
    have he : (componentOrbit B A).map (MulAut.conj g).toMonoidHom = componentOrbit B A :=
      normal_iff_map_conj_eq.mp (inferInstance : (componentOrbit B A).Normal) g
    rwa [he] at hh

theorem frattini_commutator_inner_on_orbit_source {p : ℕ} [Fact p.Prime]
    {R : Type*} [Group R] (f : R →* G) (B P A : Subgroup G)
    (hP : IsPGroup p P) (ho : Odd p) (hB : IsComponent G B)
    (hi : (normalizer (B : Set G)).index = 2)
    [IsMulCommutative (MulAut.Outer B)] [(componentOrbit B A).Normal]
    (hc : P = ⁅P,(frattini R).map f⁆) :
    P ≤ componentOrbit B A ⊔ centralizer (componentOrbit B A : Set G) := by
  have hn : normalizer (B : Set G) ≠ ⊤ := by intro he; simp [he] at hi
  obtain ⟨g,hg⟩ := SetLike.exists_of_lt (lt_top_iff_ne_top.mpr hn)
  let C := B.map (MulAut.conj g).toMonoidHom
  have hBC : B ≠ C := by
    intro he
    exact hg.2 (mem_normalizer_iff_map_conj_eq.mpr he.symm)
  have hcomm : B ≤ centralizer (C : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp (hB.commutator_eq_bot_of_ne (hB.map_conj g) hBC)
  have hCi : (normalizer (C : Set G)).index = 2 := by
    dsimp only [C]
    rw [← map_equiv_normalizer_eq]
    rw [index_map_of_bijective (MulAut.conj g).bijective]
    exact hi
  let e : B ≃* C := B.equivMapOfInjective _ (MulAut.conj g).injective
  let eo := MulAut.outerCongr e
  have : IsMulCommutative (MulAut.Outer C) := ⟨⟨fun x y => by
    apply eo.symm.injective
    rw [map_mul,map_mul,mul_comm]⟩⟩
  have hleft := frattini_commutator_inner_source f B P hP ho hi hc
  have hright := frattini_commutator_inner_source f C P hP ho hCi hc
  have hpair := orbit_eq_pair_of_normal_index_two_source B A hi g hg.2
  rw [hpair]
  exact (le_inf hleft hright).trans (inner_sup_of_commuting_factors_source B C hcomm)


omit [Finite G] in
theorem inner_of_outer_two_group_source {p : ℕ} [Fact p.Prime]
    (B P : Subgroup G) (hP : IsPGroup p P) (ho : Odd p)
    (hN : P ≤ normalizer (B : Set G)) (hout : IsPGroup 2 (MulAut.Outer B)) :
    P ≤ B ⊔ centralizer (B : Set G) := by
  let N := normalizer (B : Set G)
  let f : N →* MulAut.Outer B :=
    (QuotientGroup.mk' (MulAut.innerSubgroup B)).comp B.normalizerMonoidHom
  let U := (P.subgroupOf N).map f
  have hUp : IsPGroup p U := hP.comap_subtype.map f
  have hU2 : IsPGroup 2 U := hout.to_subgroup U
  have hUb : U = ⊥ := disjoint_self.mp
    (hUp.disjoint_of_coprime hU2 (Nat.coprime_two_right.mpr ho))
  have hi : (P.subgroupOf N).map (NormalizerAction.quotient B) ≤
      NormalizerAction.componentImage B := by
    rintro _ ⟨a,ha,rfl⟩
    apply (NormalizerAction.action_mem_inner_iff B _).mp
    apply (QuotientGroup.eq_one_iff _).mp
    have hf : f a ∈ U := mem_map_of_mem f ha
    rw [hUb] at hf
    exact hf
  intro p hp
  obtain ⟨b,hb,heq⟩ := hi (mem_map_of_mem (NormalizerAction.quotient B)
    (show (⟨p,hN hp⟩ : N) ∈ P.subgroupOf N from hp))
  have heq' : NormalizerAction.quotient B (b⁻¹ * ⟨p,hN hp⟩) = 1 := by
    rw [map_mul,map_inv,heq,inv_mul_cancel]
  have hc : (b : G)⁻¹*p ∈ centralizer (B : Set G) :=
    (NormalizerAction.quotient_eq_one_iff B _).mp heq'
  have hh := (B ⊔ centralizer (B : Set G)).mul_mem (mem_sup_left hb) (mem_sup_right hc)
  change (b : G) * ((b : G)⁻¹*p) ∈ _ at hh
  simpa only [mul_inv_cancel_left] using hh

theorem frattini_commutator_inner_of_outer_tame_source {p : ℕ} [Fact p.Prime]
    {A : Type*} [Group A] (f : A →* G) (B P : Subgroup G)
    (hP : IsPGroup p P) (ho : Odd p) (hB : (normalizer (B : Set G)).index = 2)
    (hout : IsMulCommutative (MulAut.Outer B) ∨ IsPGroup 2 (MulAut.Outer B))
    (hc : P = ⁅P,(frattini A).map f⁆) : P ≤ B ⊔ centralizer (B : Set G) := by
  rcases hout with hab | htwo
  · let := hab
    exact frattini_commutator_inner_source f B P hP ho hB hc
  · exact inner_of_outer_two_group_source B P hP ho
      (odd_pGroup_le_index_two_source P _ hP ho hB) htwo

theorem frattini_commutator_inner_on_orbit_of_outer_tame_source {p : ℕ} [Fact p.Prime]
    {R : Type*} [Group R] (f : R →* G) (B P A : Subgroup G)
    (hP : IsPGroup p P) (ho : Odd p) (hB : IsComponent G B)
    (hi : (normalizer (B : Set G)).index = 2)
    (hout : IsMulCommutative (MulAut.Outer B) ∨ IsPGroup 2 (MulAut.Outer B))
    [(componentOrbit B A).Normal]
    (hc : P = ⁅P,(frattini R).map f⁆) :
    P ≤ componentOrbit B A ⊔ centralizer (componentOrbit B A : Set G) := by
  have hn : normalizer (B : Set G) ≠ ⊤ := by intro he; simp [he] at hi
  obtain ⟨g,hg⟩ := SetLike.exists_of_lt (lt_top_iff_ne_top.mpr hn)
  let C := B.map (MulAut.conj g).toMonoidHom
  have hBC : B ≠ C := by
    intro he
    exact hg.2 (mem_normalizer_iff_map_conj_eq.mpr he.symm)
  have hcomm : B ≤ centralizer (C : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp (hB.commutator_eq_bot_of_ne (hB.map_conj g) hBC)
  have hCi : (normalizer (C : Set G)).index = 2 := by
    dsimp only [C]
    rw [← map_equiv_normalizer_eq]
    rw [index_map_of_bijective (MulAut.conj g).bijective]
    exact hi
  let e : B ≃* C := B.equivMapOfInjective _ (MulAut.conj g).injective
  let eo := MulAut.outerCongr e
  have hCout : IsMulCommutative (MulAut.Outer C) ∨ IsPGroup 2 (MulAut.Outer C) := by
    rcases hout with hab | htwo
    · let := hab
      exact Or.inl ⟨⟨fun x y => by
        apply eo.symm.injective
        rw [map_mul,map_mul,mul_comm]⟩⟩
    · exact Or.inr (htwo.of_equiv eo)
  have hleft := frattini_commutator_inner_of_outer_tame_source f B P hP ho hi hout hc
  have hright := frattini_commutator_inner_of_outer_tame_source f C P hP ho hCi hCout hc
  have hpair := orbit_eq_pair_of_normal_index_two_source B A hi g hg.2
  rw [hpair]
  exact (le_inf hleft hright).trans (inner_sup_of_commuting_factors_source B C hcomm)


end Subgroup
