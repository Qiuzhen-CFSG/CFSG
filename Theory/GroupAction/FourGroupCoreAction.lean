module

public import Theory.GroupTheory.SylowKernelCore
public import Theory.GroupTheory.CardFourAutomorphismStabilizer
public import Theory.GroupTheory.SpecificGroups.KleinFourAut
public import Mathlib.Tactic

/-!
# Two point-centralizer cores acting on a four-group

Two nontrivial transvection groups with different centers generate the full
automorphism group of a four-group. When the actors are the two-cores of the
point centralizers, their join is normal in the four-group normalizer and is
the normal closure there of either actor. The conjugation maps throughout
are the literal maps `x ↦ g * x * g⁻¹`.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript of 1 March 2004, A.1.14, printed p.23.
-/

@[expose] public section
noncomputable section

namespace FourGroupCorePair
open Subgroup
variable {G : Type*} [Group G]

/-- The ambient image of the two-core of the point centralizer. -/
def core (v : G) : Subgroup G := (centralizer ({v} : Set G)).pCoreIn 2

/-- The subgroup generated by the two point cores in A.1.14. -/
def generated (v₁ v₂ : G) : Subgroup G := core v₁ ⊔ core v₂

/-- The fixed subgroup of one point core on the four-group. -/
def pointKernel (V : Subgroup G) (v : G) : Subgroup G :=
  core v ⊓ centralizer (V : Set G)

/-- The join of the two fixed subgroups; the kernel theorem identifies it
with their product and with the two-core of the generated group. -/
def kernelJoin (V : Subgroup G) (v₁ v₂ : G) : Subgroup G :=
  pointKernel V v₁ ⊔ pointKernel V v₂

end FourGroupCorePair

/-- Precisely the input conditions of A.1.14, with the point cores defined
intrinsically rather than supplied as arbitrary subgroups. -/
structure FourGroupCorePair {G : Type*} [Group G]
    (V : Subgroup G) (v₁ v₂ : G) : Prop where
  four : IsKleinFour V
  mem₁ : v₁ ∈ V
  mem₂ : v₂ ∈ V
  order₁ : orderOf v₁ = 2
  order₂ : orderOf v₂ = 2
  distinct : v₁ ≠ v₂
  commutator₁ : ⁅V, FourGroupCorePair.core v₁⁆ = Subgroup.zpowers v₁
  commutator₂ : ⁅V, FourGroupCorePair.core v₂⁆ = Subgroup.zpowers v₂

namespace FourGroupCorePair
open Subgroup
variable {G : Type*} [Group G]
variable {V : Subgroup G} {v₁ v₂ : G} (h : FourGroupCorePair V v₁ v₂)
include h

theorem ne_one₁ : v₁ ≠ 1 := by
  intro he
  have := h.order₁
  simp [he] at this

theorem ne_one₂ : v₂ ≠ 1 := by
  intro he
  have := h.order₂
  simp [he] at this

theorem core_le_normalizer₁ : core v₁ ≤ normalizer (V : Set G) :=
  le_normalizer_iff_commutator_le_left.mpr
    (h.commutator₁.le.trans (zpowers_le.mpr h.mem₁))

theorem core_le_normalizer₂ : core v₂ ≤ normalizer (V : Set G) :=
  le_normalizer_iff_commutator_le_left.mpr
    (h.commutator₂.le.trans (zpowers_le.mpr h.mem₂))

theorem generated_le_normalizer : generated v₁ v₂ ≤ normalizer (V : Set G) :=
  sup_le h.core_le_normalizer₁ h.core_le_normalizer₂

/-- The actual action of the generated group on V. -/
def action : generated v₁ v₂ →* MulAut V :=
  V.normalizerMonoidHom.comp (inclusion h.generated_le_normalizer)

theorem action_apply (y : generated v₁ v₂) (v : V) :
    (h.action y v : G) = (y : G) * v * (y : G)⁻¹ := rfl

theorem action_ker : h.action.ker = (centralizer (V : Set G)).subgroupOf
    (generated v₁ v₂) := by
  ext y
  change inclusion h.generated_le_normalizer y ∈ V.normalizerMonoidHom.ker ↔ _
  rw [normalizerMonoidHom_ker]
  rfl

omit h in
private theorem aut_eq_one_of_fixed_pair
    {W : Type*} [Group W] [Finite W] [IsKleinFour W]
    {x y : W} (hx : x ≠ 1) (hy : y ≠ 1) (hxy : x ≠ y)
    (a : MulAut W) (hax : a x = x) (hay : a y = y) : a = 1 := by
  ext z
  change a z = z
  by_cases hz : z = 1
  · simp [hz]
  by_cases hzx : z = x
  · simpa [hzx] using hax
  by_cases hzy : z = y
  · simpa [hzy] using hay
  rw [IsKleinFour.eq_mul_of_ne_all hx hy hxy hz hzx hzy, map_mul, hax, hay]

omit h in
private theorem core_action_ne_bot {v : G} (hv : v ≠ 1)
    (hc : ⁅V, core v⁆ = zpowers v)
    (hn : core v ≤ normalizer (V : Set G)) :
    (V.normalizerMonoidHom.comp (inclusion hn)).range ≠ ⊥ := by
  intro hb
  have hcentral : core v ≤ centralizer (V : Set G) := by
    intro q hq
    have hqker : (⟨q, hn hq⟩ : normalizer (V : Set G)) ∈
        V.normalizerMonoidHom.ker := by
      change (V.normalizerMonoidHom.comp (inclusion hn)) ⟨q, hq⟩ = 1
      have hm : (V.normalizerMonoidHom.comp (inclusion hn)) ⟨q, hq⟩ ∈
          (V.normalizerMonoidHom.comp (inclusion hn)).range := ⟨⟨q, hq⟩, rfl⟩
      rwa [hb, mem_bot] at hm
    rwa [normalizerMonoidHom_ker] at hqker
  have hz : zpowers v = ⊥ := hc.symm.trans (by
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr hcentral)
  exact hv (by simpa only [hz, mem_bot] using mem_zpowers v)

omit h in
private theorem core_action_fixes {v : G} (hv : v ∈ V)
    (hn : core v ≤ normalizer (V : Set G))
    (a : MulAut V) (ha : a ∈ (V.normalizerMonoidHom.comp (inclusion hn)).range) :
    a ⟨v, hv⟩ = ⟨v, hv⟩ := by
  obtain ⟨q, rfl⟩ := ha
  apply Subtype.ext
  change (q : G) * v * (q : G)⁻¹ = v
  have hc : (q : G) * v = v * q :=
    mem_centralizer_singleton_iff.mp (pCoreIn_le 2 _ q.property)
  rw [hc, mul_inv_cancel_right]

variable [Finite G]

/-- Each point core induces the entire order-two transvection subgroup
fixing its marked nonidentity point. -/
theorem core_action_card₁ :
    Nat.card (V.normalizerMonoidHom.comp (inclusion h.core_le_normalizer₁)).range = 2 := by
  let := h.four
  have hupper := card_mulAut_subgroup_le_two_of_fixed_point
    (IsKleinFour.card_four (G := V)) (⟨v₁, h.mem₁⟩ : V)
    (by simpa using h.ne_one₁) _ (core_action_fixes h.mem₁ h.core_le_normalizer₁)
  have hlower := (Subgroup.one_lt_card_iff_ne_bot _).mpr
    (core_action_ne_bot h.ne_one₁ h.commutator₁ h.core_le_normalizer₁)
  omega

theorem core_action_card₂ :
    Nat.card (V.normalizerMonoidHom.comp (inclusion h.core_le_normalizer₂)).range = 2 := by
  let := h.four
  have hupper := card_mulAut_subgroup_le_two_of_fixed_point
    (IsKleinFour.card_four (G := V)) (⟨v₂, h.mem₂⟩ : V)
    (by simpa using h.ne_one₂) _ (core_action_fixes h.mem₂ h.core_le_normalizer₂)
  have hlower := (Subgroup.one_lt_card_iff_ne_bot _).mpr
    (core_action_ne_bot h.ne_one₂ h.commutator₂ h.core_le_normalizer₂)
  omega

/-- The two distinct transvection groups generate all automorphisms of V. -/
theorem action_surjective : Function.Surjective h.action := by
  classical
  let := h.four
  let f₁ := V.normalizerMonoidHom.comp (inclusion h.core_le_normalizer₁)
  let f₂ := V.normalizerMonoidHom.comp (inclusion h.core_le_normalizer₂)
  have hi₁ : f₁.range ≤ h.action.range := by
    rintro a ⟨q, rfl⟩
    exact ⟨⟨q, mem_sup_left q.property⟩, rfl⟩
  have hi₂ : f₂.range ≤ h.action.range := by
    rintro a ⟨q, rfl⟩
    exact ⟨⟨q, mem_sup_right q.property⟩, rfl⟩
  obtain ⟨⟨a, ha⟩, hane'⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp
    (core_action_ne_bot h.ne_one₁ h.commutator₁ h.core_le_normalizer₁)
  have hane : a ≠ 1 := fun he => hane' (Subtype.ext he)
  obtain ⟨⟨b, hb⟩, hbne'⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp
    (core_action_ne_bot h.ne_one₂ h.commutator₂ h.core_le_normalizer₂)
  have hbne : b ≠ 1 := fun he => hbne' (Subtype.ext he)
  have hab : a ≠ b := by
    intro he
    apply hane
    apply aut_eq_one_of_fixed_pair
      (x := (⟨v₁, h.mem₁⟩ : V)) (y := (⟨v₂, h.mem₂⟩ : V))
      (by simpa using h.ne_one₁) (by simpa using h.ne_one₂)
      (by simpa using h.distinct)
    · exact core_action_fixes h.mem₁ h.core_le_normalizer₁ a ha
    · exact he ▸ core_action_fixes h.mem₂ h.core_le_normalizer₂ b hb
  let a' : h.action.range := ⟨a, hi₁ ha⟩
  let b' : h.action.range := ⟨b, hi₂ hb⟩
  have ha' : a' ≠ 1 := fun he => hane (congrArg Subtype.val he)
  have hb' : b' ≠ 1 := fun he => hbne (congrArg Subtype.val he)
  have hab' : a' ≠ b' := fun he => hab (congrArg Subtype.val he)
  let := Fintype.ofFinite h.action.range
  have hthree : 3 ≤ Nat.card h.action.range := by
    have hc := Finset.card_le_univ ({a', b', 1} : Finset h.action.range)
    rw [Nat.card_eq_fintype_card]
    have hsize : ({a', b', 1} : Finset h.action.range).card = 3 := by
      simp [ha', hb', hab']
    rwa [hsize] at hc
  have htwo : 2 ∣ Nat.card h.action.range := by
    rw [← h.core_action_card₁]
    exact Subgroup.card_dvd_of_le hi₁
  have hdiv : Nat.card h.action.range ∣ 6 := by
    rw [← IsKleinFour.card_mulAut V]
    exact h.action.range.card_subgroup_dvd_card
  have hle : Nat.card h.action.range ≤ 6 := Nat.le_of_dvd (by decide) hdiv
  have hcard : Nat.card h.action.range = 6 := by
    interval_cases hn : Nat.card h.action.range <;> norm_num at hdiv <;> omega
  apply MonoidHom.range_eq_top.mp
  apply Subgroup.eq_top_of_card_eq
  exact hcard.trans (IsKleinFour.card_mulAut V).symm

/-- Every nonidentity point can be carried to every other by an element
of the actual generated subgroup, with the conjugation direction displayed. -/
theorem exists_conjugator {x z : G} (hx : x ∈ V) (hz : z ∈ V)
    (hx1 : x ≠ 1) (hz1 : z ≠ 1) :
    ∃ y ∈ generated v₁ v₂, y * x * y⁻¹ = z := by
  classical
  let := h.four
  let xV : V := ⟨x, hx⟩
  let zV : V := ⟨z, hz⟩
  let a : MulAut V := IsKleinFour.mulEquiv (Equiv.swap xV zV)
    (Equiv.swap_apply_of_ne_of_ne
      (fun he => hx1 (congrArg Subtype.val he).symm)
      (fun he => hz1 (congrArg Subtype.val he).symm))
  obtain ⟨y, hy⟩ := h.action_surjective a
  refine ⟨y, y.property, ?_⟩
  have he := congrArg (fun f : MulAut V => (f xV : G)) hy
  simpa only [action_apply, a, IsKleinFour.mulEquiv, IsKleinFour.mulEquiv',
    MulEquiv.coe_mk, Equiv.swap_apply_left] using he

/-- The full normalizer is the setwise product of Y and the centralizer. -/
theorem normalizer_factorization (m : G) (hm : m ∈ normalizer (V : Set G)) :
    ∃ y ∈ generated v₁ v₂, ∃ c ∈ centralizer (V : Set G), y * c = m := by
  let mN : normalizer (V : Set G) := ⟨m, hm⟩
  obtain ⟨y, hy⟩ := h.action_surjective (V.normalizerMonoidHom mN)
  let yN := inclusion h.generated_le_normalizer y
  have hc : yN⁻¹ * mN ∈ V.normalizerMonoidHom.ker := by
    change V.normalizerMonoidHom (yN⁻¹ * mN) = 1
    rw [map_mul, map_inv]
    change (h.action y)⁻¹ * V.normalizerMonoidHom mN = 1
    rw [hy, inv_mul_cancel]
  rw [normalizerMonoidHom_ker] at hc
  refine ⟨y, y.property, (y : G)⁻¹ * m, hc, ?_⟩
  exact mul_inv_cancel_left _ _

theorem normalizer_eq_sup_centralizer :
    normalizer (V : Set G) = generated v₁ v₂ ⊔ centralizer (V : Set G) := by
  apply le_antisymm
  · intro m hm
    obtain ⟨y, hy, c, hc, rfl⟩ := h.normalizer_factorization m hm
    exact mul_mem (mem_sup_left hy) (mem_sup_right hc)
  · exact sup_le h.generated_le_normalizer (centralizer_le_normalizer _)

omit h [Finite G] in
private theorem centralizer_le_normalizer_core {v : G} (hv : v ∈ V) :
    centralizer (V : Set G) ≤ normalizer (core v : Set G) := by
  have hC : centralizer (V : Set G) ≤ centralizer ({v} : Set G) :=
    centralizer_le (Set.singleton_subset_iff.mpr hv)
  apply hC.trans
  simpa only [core, pCoreIn, normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype]
    using (pCore 2 (centralizer ({v} : Set G))).le_normalizer_map
      (centralizer ({v} : Set G)).subtype

/-- Normality is relative to the four-group normalizer, not the ambient G. -/
theorem normalizer_le_normalizer_generated :
    normalizer (V : Set G) ≤ normalizer (generated v₁ v₂ : Set G) := by
  rw [h.normalizer_eq_sup_centralizer]
  exact sup_le (generated v₁ v₂).le_normalizer
    ((le_inf (centralizer_le_normalizer_core h.mem₁)
      (centralizer_le_normalizer_core h.mem₂)).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _))

theorem generated_normal :
    ((generated v₁ v₂).subgroupOf (normalizer (V : Set G))).Normal :=
  (normal_subgroupOf_iff_le_normalizer h.generated_le_normalizer).mpr
    h.normalizer_le_normalizer_generated

omit h [Finite G] in
/-- Conjugation transports the intrinsic point cores. -/
theorem map_core_conj (v g : G) :
    (core v).map (MulAut.conj g).toMonoidHom = core (g * v * g⁻¹) := by
  rw [core, map_pCoreIn_of_injective 2 _ _ (MulAut.conj g).injective, core]
  congr 1
  let e := MulAut.conj g
  change (centralizer ({v} : Set G)).map e.toMonoidHom = centralizer ({e v} : Set G)
  ext x
  rw [mem_map_equiv, mem_centralizer_singleton_iff, mem_centralizer_singleton_iff]
  constructor
  · intro hx
    simpa only [map_mul, e.apply_symm_apply] using congrArg e hx
  · intro hx
    apply e.injective
    simpa only [map_mul, e.apply_symm_apply] using hx

/-- The source normal closure, computed inside N_G(V), and then embedded
back into G, is exactly the join of the two point cores. -/
theorem normalClosure_core₁ :
    (normalClosure ((core v₁).subgroupOf (normalizer (V : Set G)) :
      Set (normalizer (V : Set G)))).map (normalizer (V : Set G)).subtype =
        generated v₁ v₂ := by
  let M := normalizer (V : Set G)
  let K := normalClosure ((core v₁).subgroupOf M : Set M)
  let := h.generated_normal
  have hK : K ≤ (generated v₁ v₂).subgroupOf M :=
    normalClosure_le_normal (fun _ hx => mem_sup_left hx)
  have hKle : K.map M.subtype ≤ generated v₁ v₂ := by
    rintro _ ⟨x, hx, rfl⟩
    exact hK hx
  have hQ₁ : core v₁ ≤ K.map M.subtype := by
    intro x hx
    exact ⟨⟨x, h.core_le_normalizer₁ hx⟩, subset_normalClosure hx, rfl⟩
  have hMK : M ≤ normalizer (K.map M.subtype : Set G) := by
    simpa only [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype]
      using K.le_normalizer_map M.subtype
  obtain ⟨y, hy, hyv⟩ := h.exists_conjugator h.mem₁ h.mem₂ h.ne_one₁ h.ne_one₂
  have hQ₂ : core v₂ ≤ K.map M.subtype := by
    rw [← hyv, ← map_core_conj]
    have hn := mem_normalizer_iff_map_conj_eq.mp (hMK (h.generated_le_normalizer hy))
    exact (Subgroup.map_mono hQ₁).trans_eq hn
  exact le_antisymm hKle (sup_le hQ₁ hQ₂)

end FourGroupCorePair
