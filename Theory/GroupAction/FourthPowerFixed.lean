module
public import Theory.GroupAction.InvolutionDisplacementCard

/-!
# Fixed points of an automorphism whose fourth power is one

On an elementary abelian two-group a nonidentity automorphism of fourth
power one has strictly fewer fixed points than its square. If the two
fixed subgroups were equal, applying that equality to the displacements
x a²(x) and x a(x) would force a², and then a, to be the identity.

This elementary displacement argument supplies the order-four fixed-space
bound in Parrott, *A characterization of the Tits' simple group* (1972),
p.674, without any hypotheses on the ambient group.
-/

namespace MulAut
open Subgroup
open scoped IsMulCommutative

/-- Fixed points of the cyclic group generated by an automorphism are exactly
its fixed points. -/
public theorem mem_fixed_zpowers_iff {V : Type*} [Group V]
    (a : MulAut V) (v : V) :
    v ∈ FixedPoints.subgroup (zpowers a) V ↔ a v = v := by
  constructor
  · intro hv
    exact hv ⟨a, mem_zpowers a⟩
  · intro hv g
    exact smul_eq_self_of_mem_zpowers g.property hv

/-- Squaring a nonidentity automorphism of fourth power one strictly enlarges
its fixed subgroup on a finite elementary binary group. -/
public theorem fixed_card_lt_square_fixed_card_of_fourth_power_eq_one
    {V : Type*} [Group V] [Finite V] [IsElementaryAbelian 2 V]
    (a : MulAut V) (ha4 : a ^ 4 = 1) (ha : a ≠ 1) :
    Nat.card (FixedPoints.subgroup (zpowers a) V) <
      Nat.card (FixedPoints.subgroup (zpowers (a ^ 2)) V) := by
  let F := FixedPoints.subgroup (zpowers a) V
  let F₂ := FixedPoints.subgroup (zpowers (a ^ 2)) V
  have hle : F ≤ F₂ := by
    intro v hv
    apply (mem_fixed_zpowers_iff _ _).mpr
    have hv' := (mem_fixed_zpowers_iff _ _).mp hv
    change a (a v) = v
    rw [hv', hv']
  have hne : F ≠ F₂ := by
    intro heq
    have hcollapse (v : V) (hv : a (a v) = v) : a v = v := by
      apply (mem_fixed_zpowers_iff _ _).mp
      change v ∈ F
      rw [heq]
      exact (mem_fixed_zpowers_iff _ _).mpr hv
    have hfour (v : V) : a (a (a (a v))) = v := by
      have hh := congrArg (fun f : MulAut V => f v) ha4
      exact hh
    have htwo (v : V) : a (a v) = v := by
      have hw : a (v * a (a v)) = v * a (a v) := hcollapse _ (by
        simp only [map_mul, hfour]
        exact mul_comm _ _)
      have hu : a (a (v * a v)) = v * a v := by
        simp only [map_mul] at hw ⊢
        apply mul_left_cancel (a := a v)
        calc
          a v * (a (a v) * a (a (a v))) =
              (a v * a (a (a v))) * a (a v) := by ac_rfl
          _ = (v * a (a v)) * a (a v) := by rw [hw]
          _ = a v * (v * a v) := by
            have hs (x : V) : x * x = 1 := by
              simpa only [pow_two] using Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
                (IsElementaryAbelian.exponent_dvd_p 2 V) x
            simp only [mul_assoc, hs, mul_one]
            rw [mul_left_comm, hs, mul_one]
      have hh := hcollapse _ hu
      simp only [map_mul] at hh
      apply mul_left_cancel (a := a v)
      exact hh.trans (mul_comm _ _)
    apply ha
    ext v
    exact hcollapse v (htwo v)
  have hcard := card_le_of_le hle
  exact lt_of_le_of_ne hcard (fun heq => hne (eq_of_le_of_card_ge hle heq.ge))

end MulAut
