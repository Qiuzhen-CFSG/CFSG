module

public import Mathlib.GroupTheory.Index
public import Mathlib.Data.Nat.Prime.Basic

/-!
# Generating stabilizers of overlapping intervals

For a sequence of point stabilizers, the fixer of an interval is their
intersection. If every one-step inclusion has prime index, a backwards
induction shows that the fixers of a prefix and an overlapping suffix generate
the fixer of their overlap. This is the subgroup argument of Goldschmidt (2.13).
The actual cubic arc indices are supplied by the source application.
-/

@[expose] public section
namespace Theory.GroupAction.CubicTree
variable {G : Type*} [Group G]

/-- The pointwise fixer of a closed interval in a sequence of point stabilizers. -/
def intervalFixer (S : ℕ → Subgroup G) (a b : ℕ) : Subgroup G where
  carrier := {g | ∀ k, a ≤ k → k ≤ b → g ∈ S k}
  one_mem' := fun _ _ _ => (S _).one_mem
  mul_mem' := fun ha hb k hk hkb => (S k).mul_mem (ha k hk hkb) (hb k hk hkb)
  inv_mem' := fun ha k hk hkb => (S k).inv_mem (ha k hk hkb)

theorem intervalFixer_le (S : ℕ → Subgroup G) {a b c d : ℕ}
    (hac : a ≤ c) (hdb : d ≤ b) : intervalFixer S a b ≤ intervalFixer S c d :=
  fun _ hg k hk hkd => hg k (hac.trans hk) (hkd.trans hdb)

@[simp] theorem intervalFixer_singleton (S : ℕ → Subgroup G) (a : ℕ) :
    intervalFixer S a a = S a := by
  ext g
  exact ⟨fun hg => hg a le_rfl le_rfl, fun hg k hk hka => le_antisymm hk hka ▸ hg⟩

theorem intervalFixer_inf (S : ℕ → Subgroup G) {a b c : ℕ} (hab : a ≤ b + 1)
    (hbc : b ≤ c) :
    intervalFixer S 0 b ⊓ intervalFixer S a c = intervalFixer S 0 c := by
  ext g
  constructor
  · rintro ⟨h₁, h₂⟩ k hk hkc
    by_cases hkb : k ≤ b
    · exact h₁ k hk hkb
    · exact h₂ k (by omega) hkc
  · intro hg
    exact ⟨intervalFixer_le S le_rfl hbc hg, intervalFixer_le S (by omega) le_rfl hg⟩

private theorem eq_of_prime_relIndex {B H C : Subgroup G} (hBH : B ≤ H) (hHC : H ≤ C)
    (hp : (B.relIndex C).Prime) (hne : ¬ H ≤ B) : H = C := by
  have he := Subgroup.relIndex_mul_relIndex B H C hBH hHC
  have hp' : (B.relIndex H * H.relIndex C).Prime := he ▸ hp
  rcases Nat.prime_mul_iff.mp hp' with ⟨_, h₁⟩ | ⟨_, h₂⟩
  · exact le_antisymm hHC (Subgroup.relIndex_eq_one.mp h₁)
  · exact (hne (Subgroup.relIndex_eq_one.mp h₂)).elim

/-- The prefix and suffix fixers generate exactly the fixer of their overlap. -/
theorem prefix_sup_suffix_eq_interval (S : ℕ → Subgroup G) (n : ℕ)
    (hprime : ∀ j i, j ≤ i → i < n →
      ((intervalFixer S j (i + 1)).relIndex (intervalFixer S j i)).Prime)
    {i j : ℕ} (hji : j ≤ i) (hin : i ≤ n) :
    intervalFixer S 0 i ⊔ intervalFixer S j n = intervalFixer S j i := by
  induction hin using Nat.decreasingInduction with
  | self =>
    exact sup_eq_right.mpr (intervalFixer_le S (Nat.zero_le j) le_rfl)
  | of_succ i hin ih =>
    have hji' : j ≤ i + 1 := by omega
    have hi := ih hji'
    let P := intervalFixer S 0 i
    let Q := intervalFixer S j n
    let B := intervalFixer S j (i + 1)
    let C := intervalFixer S j i
    have hBH : B ≤ P ⊔ Q := by
      dsimp [B, P, Q]
      rw [← hi]
      exact sup_le_sup (intervalFixer_le S le_rfl (Nat.le_succ i)) le_rfl
    have hHC : P ⊔ Q ≤ C := sup_le
      (intervalFixer_le S (Nat.zero_le j) le_rfl)
      (intervalFixer_le S le_rfl (by omega))
    apply eq_of_prime_relIndex hBH hHC (hprime j i hji (by omega))
    intro hle
    have hP : P ≤ B := le_sup_left.trans hle
    have he : intervalFixer S 0 (i + 1) = P := by
      rw [← intervalFixer_inf S (by omega : j ≤ i + 1) (Nat.le_succ i)]
      exact inf_eq_left.mpr hP
    have hbad := (hprime 0 i (Nat.zero_le i) (by omega)).ne_one
    exact hbad (Subgroup.relIndex_eq_one.mpr (by rw [he]))

theorem prefix_sup_next_suffix_eq (S : ℕ → Subgroup G) (n : ℕ)
    (hprime : ∀ j i, j ≤ i → i < n →
      ((intervalFixer S j (i + 1)).relIndex (intervalFixer S j i)).Prime)
    {i : ℕ} (hi : i < n) :
    intervalFixer S 0 i ⊔ intervalFixer S (i + 1) n = S i ⊔ S (i + 1) := by
  have hleft := prefix_sup_suffix_eq_interval S n hprime (j := i) le_rfl hi.le
  have hright := prefix_sup_suffix_eq_interval S n hprime (j := i + 1) le_rfl
    (Nat.succ_le_of_lt hi)
  rw [intervalFixer_singleton] at hleft hright
  apply le_antisymm
  · exact sup_le_sup
      (by simpa only [intervalFixer_singleton] using
        intervalFixer_le S (Nat.zero_le i) (le_rfl : i ≤ i))
      (by simpa only [intervalFixer_singleton] using
        intervalFixer_le S (le_rfl : i + 1 ≤ i + 1) (Nat.succ_le_of_lt hi))
  · apply sup_le
    · rw [← hleft]
      exact sup_le_sup le_rfl (intervalFixer_le S (Nat.le_succ i) le_rfl)
    · rw [← hright]
      exact sup_le_sup (intervalFixer_le S le_rfl (Nat.le_succ i)) le_rfl

/-- In a group generated by each adjacent pair of point stabilizers, separated
prefix and suffix stabilizers also generate the whole group. -/
theorem prefix_sup_suffix_eq_top (S : ℕ → Subgroup G) (n : ℕ)
    (hprime : ∀ j i, j ≤ i → i < n →
      ((intervalFixer S j (i + 1)).relIndex (intervalFixer S j i)).Prime)
    (hgen : ∀ i < n, S i ⊔ S (i + 1) = ⊤)
    {i j : ℕ} (hij : i < j) (hj : j ≤ n) :
    intervalFixer S 0 i ⊔ intervalFixer S j n = ⊤ := by
  have hjpos : 0 < j := by omega
  have hcut := prefix_sup_next_suffix_eq S n hprime (i := j - 1) (by omega)
  rw [hgen (j - 1) (by omega), Nat.sub_add_cancel hjpos] at hcut
  apply top_unique
  rw [← hcut]
  exact sup_le_sup (intervalFixer_le S le_rfl (by omega)) le_rfl

end Theory.GroupAction.CubicTree
