module

public import Theory.GroupAction.QuotientConjugation
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.GroupTheory.FixedPointFree

/-!
# A self-centralizing normal subgroup from fixed generators

Suppose a faithful action is generated by conjugates of a subgroup fixed
pointwise by a supplement to an abelian normal subgroup P. An element of
the supplement centralizing P fixes every generator, so is trivial. Thus
P is self-centralizing. The quotient-conjugation application preserves
G/C_G(⟨Z^G⟩) and its literal subgroup images.

Source application: Aschbacher--Smith, 15.4.10, printed p. 1159.
-/

public section
open Subgroup
namespace Subgroup
variable {G V : Type*} [Group G] [Group V]

/-- Fixed generators detect the centralizer of an abelian normal subgroup. -/
theorem centralizer_and_disjoint_of_faithful_fixed_generators
    (ρ : G →* MulAut V) (hρ : Function.Injective ρ)
    (P B : Subgroup G) [P.Normal] [IsMulCommutative P]
    (hgen : P ⊔ B = ⊤) (Z : Subgroup V)
    (hfix : ∀ b : B, ∀ z : Z, ρ b z = z)
    (hspan : closure {v : V | ∃ g : G, ∃ z : Z, ρ g z = v} = ⊤) :
    centralizer (P : Set G) = P ∧ Disjoint P B := by
  have hB (b : G) (hb : b ∈ B) (hc : b ∈ centralizer (P : Set G)) : b = 1 := by
    have hfixall : MulAut.fixedSubgroup (ρ b) = ⊤ := by
      apply top_unique
      rw [← hspan]
      apply (closure_le _).mpr
      rintro v ⟨g, z, rfl⟩
      have hg : g ∈ P ⊔ B := by rw [hgen]; exact mem_top g
      obtain ⟨p, hp, s, hs, rfl⟩ := mem_sup_of_normal_left.mp hg
      apply (MulAut.mem_fixedSubgroup _ _).mpr
      have hc' : ρ b (ρ p z) = ρ p (ρ b z) := by
        simpa only [map_mul, MulAut.mul_apply] using
          congrArg (fun g : G => ρ g z) (hc p hp).symm
      simp only [map_mul, MulAut.mul_apply, hfix ⟨s, hs⟩ z]
      rw [hc', hfix ⟨b, hb⟩ z]
    have he : ρ b = 1 := by
      ext v
      have hv : v ∈ MulAut.fixedSubgroup (ρ b) := by rw [hfixall]; exact mem_top v
      exact (MulAut.mem_fixedSubgroup _ _).mp hv
    exact hρ (he.trans (map_one ρ).symm)
  constructor
  · apply le_antisymm ?_ (le_centralizer P)
    intro g hg
    have hgt : g ∈ P ⊔ B := by rw [hgen]; exact mem_top g
    obtain ⟨p, hp, b, hb, rfl⟩ := mem_sup_of_normal_left.mp hgt
    have hbC : b ∈ centralizer (P : Set G) := by
      have hh := (centralizer (P : Set G)).mul_mem
        ((centralizer (P : Set G)).inv_mem ((le_centralizer P) hp)) hg
      simpa only [inv_mul_cancel_left] using hh
    rw [hB b hb hbC, mul_one]
    exact hp

  · apply disjoint_iff.mpr
    apply eq_bot_iff.mpr
    intro g hg
    exact hB g hg.2 ((le_centralizer P) hg.1)

/-- Apply the fixed-generator criterion to the original faithful quotient
conjugation action on the normal closure of Z. -/
theorem centralizer_and_disjoint_quotient_images_of_fixed_normal_closure
    (Y S Z : Subgroup G) [Y.Normal] (hgen : Y ⊔ S = ⊤)
    (hSZ : S ≤ centralizer (Z : Set G))
    (habel : IsMulCommutative
      (Y.map (QuotientGroup.mk' (centralizer (normalClosure (Z : Set G) : Set G))))) :
    centralizer
        (Y.map (QuotientGroup.mk' (centralizer (normalClosure (Z : Set G) : Set G))) : Set _) =
      Y.map (QuotientGroup.mk' (centralizer (normalClosure (Z : Set G) : Set G))) ∧
    Disjoint (Y.map (QuotientGroup.mk' (centralizer (normalClosure (Z : Set G) : Set G))))
      (S.map (QuotientGroup.mk' (centralizer (normalClosure (Z : Set G) : Set G)))) := by
  let W := normalClosure (Z : Set G)
  let C := centralizer (W : Set G)
  let q := QuotientGroup.mk' C
  let ρ := MulAut.quotientConjNormal W C le_rfl
  have hρ : Function.Injective ρ := by
    apply (MonoidHom.ker_eq_bot_iff ρ).mp
    apply eq_bot_iff.mpr
    intro d hd
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective C d
    have hg : g ∈ C := by
      change g ∈ centralizer (W : Set G)
      rw [← MulAut.conjNormal_ker_eq_centralizer W]
      exact hd
    exact (QuotientGroup.eq_one_iff (N := C) g).mpr hg
  let P := Y.map q
  let B := S.map q
  let : P.Normal := Normal.map inferInstance q (QuotientGroup.mk'_surjective C)
  let : IsMulCommutative P := habel
  have hPB : P ⊔ B = ⊤ := by
    rw [← Subgroup.map_sup, hgen, map_top_of_surjective q (QuotientGroup.mk'_surjective C)]
  let ZW := Z.subgroupOf W
  have hfixed : ∀ b : B, ∀ z : ZW, ρ b z = z := by
    rintro ⟨b, s, hs, rfl⟩ z
    apply Subtype.ext
    change s * ((z : W) : G) * s⁻¹ = ((z : W) : G)
    rw [(hSZ hs ((z : W) : G) z.property).symm, mul_inv_cancel_right]
  have hsp : closure {v : W | ∃ d : G ⧸ C, ∃ z : ZW, ρ d z = v} = ⊤ := by
    let E := closure {v : W | ∃ d : G ⧸ C, ∃ z : ZW, ρ d z = v}
    apply top_unique
    intro w _
    have hmem : ∀ g : G, ∀ hg : g ∈ W, (⟨g, hg⟩ : W) ∈ E := by
      intro g hg
      induction hg using closure_induction with
      | mem g hg =>
        obtain ⟨z, hz, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hg
        obtain ⟨a, rfl⟩ := isConj_iff.mp hconj
        apply subset_closure
        exact ⟨q a, ⟨⟨z, le_normalClosure hz⟩, hz⟩, Subtype.ext rfl⟩
      | one => exact E.one_mem
      | mul a b ha hb iha ihb => exact E.mul_mem iha ihb
      | inv a ha iha => exact E.inv_mem iha
    exact hmem w w.property
  exact centralizer_and_disjoint_of_faithful_fixed_generators ρ hρ P B hPB ZW hfixed hsp

end Subgroup
