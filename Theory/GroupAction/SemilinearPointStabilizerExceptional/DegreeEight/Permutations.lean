module

public import Mathlib.GroupTheory.Perm.Cycle.Type
public import Mathlib.Data.Fin.VecNotation

/-!
# Marked permutations for the degree-eight endpoint

The seven-cycle fixes the point 7. The second generator is negative reciprocal
on the projective line over the field of seven elements, with 7 marking infinity.
Their generated subgroup is compared with the actual binary linear group in
`LinearModel`. These markings support the degree-eight endpoint of GLS,
Volume 4, Chapter 1, Theorem 3.2 and Lemma 3.9
(`refs/KGroup/GLS4/Chapter1.tex`, lines 305–468).
-/

@[expose] public section

namespace MulAction.SemilinearPointStabilizer.DegreeEight

abbrev Perm := Equiv.Perm (Fin 8)

/-- Translation on seven finite points, fixing infinity. -/
def cycle : Perm where
  toFun := ![1, 2, 3, 4, 5, 6, 0, 7]
  invFun := ![6, 0, 1, 2, 3, 4, 5, 7]
  left_inv := by decide
  right_inv := by decide

/-- The permutation induced by negative reciprocal. -/
def inversion : Perm where
  toFun := ![7, 6, 3, 2, 5, 4, 1, 0]
  invFun := ![7, 6, 3, 2, 5, 4, 1, 0]
  left_inv := by decide
  right_inv := by decide

/-- The literal subgroup generated by the projective translation and inversion. -/
def linearSeed : Subgroup Perm := Subgroup.closure {cycle, inversion}

/-- A word in the two displayed generators; `true` denotes the second. -/
def word {G : Type*} [Group G] (a b : G) (w : List Bool) : G :=
  (w.map (fun i => if i then b else a)).prod

theorem word_mem {G : Type*} [Group G] (H : Subgroup G) {a b : G}
    (ha : a ∈ H) (hb : b ∈ H) (w : List Bool) : word a b w ∈ H := by
  apply H.list_prod_mem
  intro x hx
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
  split <;> assumption

theorem cycle_order : orderOf cycle = 7 := by
  let : Fact (Nat.Prime 7) := ⟨by decide⟩
  exact orderOf_eq_prime (by decide) (by decide)

/-- Every element of order seven on eight points can be marked as `cycle`. -/
theorem normalize_seven (s : Perm) (hs : orderOf s = 7) :
    ∃ q : Perm, MulAut.conj q s = cycle := by
  have hsc : s.IsCycle := Equiv.Perm.isCycle_of_prime_order'
    (hs ▸ (by decide : Nat.Prime 7)) (by simp [hs])
  have hc : cycle.IsCycle := Equiv.Perm.isCycle_of_prime_order'
    (cycle_order ▸ (by decide : Nat.Prime 7)) (by simp [cycle_order])
  apply isConj_iff.mp
  apply hsc.isConj hc
  rw [← hsc.orderOf, ← hc.orderOf, hs, cycle_order]

end MulAction.SemilinearPointStabilizer.DegreeEight
