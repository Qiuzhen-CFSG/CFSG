module

public import Theory.GroupAction.SemilinearPointStabilizerExceptional.NormalClosure

/-!
# Reduction to groups normally generated by their scalar subgroup

Strong induction on the order of the acting group reduces the degree-three
assertion to actions whose scalars normally generate the group. The normal
closure inherits the same field, double transitivity, faithfulness and trivial
two-core. Its being proper is enough to use induction; no abstract group
recognition or order-168 assertion is used in this reduction.

This is the minimality step of GLS, Volume 4, Chapter 1, Lemma 3.8(c),
specialized to the degree assertion needed by Theorem 3.2.
-/

public section

namespace MulAction.SemilinearPointStabilizer

universe u v

/-- It suffices to establish the degree assertion for scalar-generated actors.
The supplied case is a separate mathematical input, not the source theorem. -/
theorem degree_three_of_scalar_generated
    {F : Type v} [Field F] [Finite F] {n : ℕ} (hn : 2 ≤ n)
    (hF : Nat.card F = 2 ^ n)
    (hcase : ∀ (Y : Type u) [Group Y] [Finite Y] [MulAction Y F]
      [FaithfulSMul Y F], ∀ c : Coordinates Y F,
      IsMultiplyPretransitive Y F 2 → pCore 2 Y = ⊥ →
      c.scalarClosure = ⊤ → n = 3)
    {X : Type u} [Group X] [Finite X] [MulAction X F] [FaithfulSMul X F]
    (c : Coordinates X F) (htwo : IsMultiplyPretransitive X F 2)
    (hcore : pCore 2 X = ⊥) : n = 3 := by
  have hFthree : 3 ≤ Nat.card F := by
    rw [hF]
    have hp : 2 ^ 2 ≤ 2 ^ n := Nat.pow_le_pow_right (by decide) hn
    omega
  suffices hind : ∀ k : ℕ, ∀ (Y : Type u) [Group Y] [Finite Y] [MulAction Y F]
      [FaithfulSMul Y F], Nat.card Y = k → ∀ cY : Coordinates Y F,
      IsMultiplyPretransitive Y F 2 → pCore 2 Y = ⊥ → n = 3 by
    exact hind (Nat.card X) X rfl c htwo hcore
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
    intro Y _ _ _ _ hY cY htwoY hcoreY
    by_cases hgen : cY.scalarClosure = ⊤
    · exact hcase Y cY htwoY hcoreY hgen
    · have hlt : Nat.card cY.scalarClosure < k := by
        rw [← hY]
        exact lt_of_not_ge (fun h => hgen (cY.scalarClosure.eq_top_of_le_card h))
      exact ih _ hlt cY.scalarClosure rfl
        (cY.restrict cY.scalarClosure cY.scalarSubgroup_le_scalarClosure)
        (cY.scalarClosure_two_pretransitive hFthree htwoY)
        (normal_subgroup_pCore_eq_bot 2 hcoreY cY.scalarClosure)

end MulAction.SemilinearPointStabilizer
