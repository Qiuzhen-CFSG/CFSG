module
public import Theory.GroupAction.SylowFixedElementaryDisplacement
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Sylow-fixed vectors in a commutator subgroup

Let U be elementary abelian and normal, and suppose G is generated by a
normal subgroup K and a Sylow two-subgroup S. A vector of U fixed by S
has constant image modulo [U,K] on its G-orbit. Multiplying its odd orbit
gives a G-fixed lift of that image. Dividing the original vector by this
lift produces an S-fixed vector in [U,K] with the same noncentral action
on K.

This is the odd-orbit argument of SylowFixedElementaryDisplacement, used
for the fixed-witness step of Aschbacher--Smith C.1.16(3), pp.125--126.
-/

public section

open Subgroup
open scoped IsMulCommutative commutatorElement
namespace Theory.GroupAction
variable {G : Type*} [Group G] [Finite G]

theorem exists_moved_sylow_fixed_of_seed
    (U K : Subgroup G) [U.Normal] [K.Normal] [IsElementaryAbelian 2 U]
    (S : Sylow 2 G) (hgen : K ⊔ (S : Subgroup G) = ⊤)
    (z : U) (hfix : ∀ s ∈ S, s * (z : G) = (z : G) * s)
    (hnc : (z : G) ∉ centralizer (K : Set G)) :
    ∃ w ∈ ⁅U,K⁆, w ∈ centralizer (S : Set G) ∧ w ∉ centralizer (K : Set G) := by
  let ρ : G →* MulAut U := U.normalizerMonoidHom.comp
    ((MonoidHom.id G).codRestrict (normalizer (U : Set G))
      (fun g => (normalizer_eq_top (H := U)).symm ▸ mem_top g))
  let : MulDistribMulAction G U := MulDistribMulAction.compHom U ρ
  let D := (⁅U,K⁆ : Subgroup G).subgroupOf U
  let f := QuotientGroup.mk' D
  have hf (g : G) : f (g • z) = f z := by
    obtain ⟨k,hk,s,hs,rfl⟩ := mem_sup_of_normal_left.mp (hgen.symm ▸ mem_top g)
    apply QuotientGroup.eq_iff_div_mem.mpr
    change (k*s*(z:G)*(k*s)⁻¹)/(z:G) ∈ ⁅U,K⁆
    have he : k*s*(z:G)*(k*s)⁻¹ = k*(z:G)*k⁻¹ := by
      rw [mul_inv_rev]
      calc
        k*s*(z:G)*(s⁻¹*k⁻¹) = k*(s*(z:G)*s⁻¹)*k⁻¹ := by group
        _ = k*(z:G)*k⁻¹ := by rw [hfix s hs,mul_inv_cancel_right]
    rw [he,commutator_comm]
    simpa only [div_eq_mul_inv,commutatorElement_def] using commutator_mem_commutator hk z.property
  obtain ⟨b,hb,he⟩ := exists_fixed_lift_of_sylow_fixed S z
    (Subtype.ext (elemPow_eq_one_of_isElementaryAbelian (z:G) z.property))
    (fun s hs => Subtype.ext (by
      change s*(z:G)*s⁻¹ = (z:G)
      rw [hfix s hs,mul_inv_cancel_right])) f hf
  let w : U := z/b
  have hw : (w:G) ∈ ⁅U,K⁆ := (QuotientGroup.eq_iff_div_mem (N:=D)).mp he.symm
  have hbfix (g : G) : g*(b:G) = (b:G)*g :=
    mul_inv_eq_iff_eq_mul.mp (congrArg Subtype.val (hb g))
  refine ⟨w,hw,?_,?_⟩
  · intro s hs
    change s*((z:G)/(b:G)) = ((z:G)/(b:G))*s
    rw [div_eq_mul_inv]
    exact ((show Commute s (z:G) from hfix s hs).mul_right
      (show Commute s (b:G) from hbfix s).inv_right).eq
  · intro hc
    apply hnc
    intro k hk
    have hwfix := hc k hk
    change k*((z:G)/(b:G)) = ((z:G)/(b:G))*k at hwfix
    have hh := (Commute.mul_right (show Commute k ((z:G)/(b:G)) from hwfix) (show Commute k (b:G) from hbfix k)).eq
    simpa only [div_mul_cancel] using hh
end Theory.GroupAction
