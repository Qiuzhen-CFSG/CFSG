module
public import Theory.ElementaryAbelian.Basic
public import Theory.GroupTheory.PGroup.CyclicInvolution
public import Mathlib.GroupTheory.GroupAction.Basic
public import Mathlib.Tactic

/-!
# Faithful cyclic binary actions on involution fixed points

For a faithful action of a finite cyclic two-group on an elementary abelian
binary group, the pointwise stabilizer of the fixed points of its unique
involution is precisely the subgroup generated by that involution.

An automorphism of fourth power one has fourth displacement zero. If it fixes
the fixed points of its square, successive displacement kernels collapse and
the automorphism is the identity. Every cyclic two-group element of order at
least four has a power of order four whose square is the unique involution,
so this excludes all larger elements from the pointwise stabilizer.

The result requires no module finiteness or field marking. It supplies the
fixed-center kernel step in the single linear case of Aschbacher–Smith,
Chapter 2, Section 4.
-/

public section
open scoped IsMulCommutative

namespace MulAut

theorem eq_one_of_fourth_power_of_fixes_square_fixed
    {V : Type*} [Group V] [IsElementaryAbelian 2 V]
    (a : MulAut V) (ha : a ^ 4 = 1)
    (hfix : ∀ v : V, (a ^ 2) v = v → a v = v) : a = 1 := by
  have hsquare (v : V) : v * v = 1 := by
    simpa only [pow_two] using Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 V) v
  have hinv (v : V) : v⁻¹ = v := inv_eq_of_mul_eq_one_left (hsquare v)
  let δ : V → V := fun v => a v * v
  have hδ₂ (v : V) : δ (δ v) = a (a v) * v := by
    dsimp [δ]
    rw [map_mul]
    calc
      a (a v) * a v * (a v * v) = a (a v) * ((a v * a v) * v) := by
        simp only [mul_assoc]
      _ = a (a v) * v := by rw [hsquare, one_mul]
  have hδ₄ (v : V) : δ (δ (δ (δ v))) = 1 := by
    rw [hδ₂, hδ₂]
    simp only [map_mul]
    have hfour : a (a (a (a v))) = v := by
      change (a ^ 4) v = v
      rw [ha]
      rfl
    rw [hfour]
    calc
      v * a (a v) * (a (a v) * v) = (v * v) * (a (a v) * a (a v)) := by
        simp only [mul_assoc, mul_comm, mul_left_comm]
      _ = 1 := by rw [hsquare, hsquare, one_mul]
  have hdrop (v : V) (hv : δ (δ v) = 1) : δ v = 1 := by
    have hfixed : (a ^ 2) v = v := by
      change a (a v) = v
      exact (mul_eq_one_iff_eq_inv.mp ((hδ₂ v).symm.trans hv)).trans (hinv v)
    change a v * v = 1
    rw [hfix v hfixed, hsquare]
  ext v
  have hv : δ v = 1 := hdrop v (hdrop (δ v) (hdrop (δ (δ v)) (hδ₄ v)))
  change a v = v
  exact (mul_eq_one_iff_eq_inv.mp hv).trans (hinv v)

end MulAut

namespace BinaryCyclicAction

theorem mem_zpowers_of_fixes_involution_fixed
    {A V : Type*} [Group A] [Finite A] [IsCyclic A]
    [Group V] [IsElementaryAbelian 2 V]
    (ρ : A →* MulAut V) (hρ : Function.Injective ρ) (hA : IsPGroup 2 A)
    (s : A) (hs : orderOf s = 2) (a : A)
    (hfix : ∀ v : V, ρ s v = v → ρ a v = v) : a ∈ Subgroup.zpowers s := by
  have hfixpow (m : ℕ) (v : V) (hv : ρ s v = v) : ρ (a ^ m) v = v := by
    induction m with
    | zero => rw [pow_zero, map_one]; rfl
    | succ m ih =>
      rw [pow_succ, map_mul, MulAut.mul_apply, hfix v hv, ih]
  obtain ⟨k, hk⟩ := hA.exists_orderOf_eq_pow a
  have hkone : k ≤ 1 := by
    by_contra hnot
    have hk2 : 2 ≤ k := by omega
    have hd : 4 ∣ orderOf a := by
      rw [hk]
      exact (show 4 = 2 ^ 2 by decide) ▸ pow_dvd_pow 2 hk2
    let g := a ^ (orderOf a / 4)
    have hg : orderOf g = 4 := orderOf_pow_orderOf_div (orderOf_pos a).ne' hd
    have hgs : g ^ 2 = s := IsCyclic.eq_of_orderOf_eq_two
      (by rw [orderOf_pow, hg]; decide) hs
    have hρg : ρ g = 1 := MulAut.eq_one_of_fourth_power_of_fixes_square_fixed (ρ g)
      (by rw [← map_pow, ← hg, pow_orderOf_eq_one, map_one]) (by
        intro v hv
        rw [← map_pow, hgs] at hv
        exact hfixpow _ v hv)
    have hg1 : g = 1 := hρ (hρg.trans (map_one ρ).symm)
    rw [hg1, orderOf_one] at hg
    omega
  have ho : orderOf a = 1 ∨ orderOf a = 2 := by
    interval_cases k <;> simp_all
  rcases ho with ho | ho
  · rw [orderOf_eq_one_iff.mp ho]
    exact (Subgroup.zpowers s).one_mem
  · rw [IsCyclic.eq_of_orderOf_eq_two ho hs]
    exact Subgroup.mem_zpowers s

end BinaryCyclicAction
