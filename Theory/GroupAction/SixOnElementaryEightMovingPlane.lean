module

public import Theory.GroupAction.ThreeOnElementaryEight
public import Theory.GroupAction.FourthPowerFixed
public import Theory.GroupAction.NormalizingActor
public import Theory.GroupTheory.Commutator.ActionTriviality
public import Mathlib.GroupTheory.IndexNormal

/-!
# An invariant moving plane for an order-six action on an elementary eight

An automorphism group of order six fixing an involution of an elementary
abelian group of order eight preserves a plane of order four. Every
nonidentity actor moves a point of this plane, and a supplied order-three
actor has no nonidentity fixed point on it. The full fixed subgroup of that
actor is the line generated by the supplied involution.

Take the displacement subgroup of the cyclic order-three actor. Coprime
splitting and the order-three fixed-point count give complementary subgroups
of orders two and four. The cyclic actor has index two in the order-six
group, so normalizing-actor invariance preserves its displacement subgroup.
An automorphism fixing the plane pointwise also fixes the complementary
line pointwise, and therefore is the identity.

Source: Janko–Thompson, Math. Z. 113 (1970), Lemma 3.1, printed p.388;
`refs/original/n-group-global/odd-core-rank-two-source/janko-thompson-1970-gdz.pdf`.
-/

open scoped IsMulCommutative

namespace MulAut

private theorem order_three_commutator_ne_bot
    {V : Type*} [Group V] (r : MulAut V) (hr : orderOf r = 3) :
    commutatorAction (Subgroup.zpowers r) V ≠ ⊥ := by
  intro hbot
  have hone : r = 1 := by
    ext v
    exact actsTrivially_of_commutatorAction_eq_bot hbot
      ⟨r, Subgroup.mem_zpowers r⟩ v
  simp [hone] at hr

/-- An order-three automorphism of an elementary eight fixing an involution
has exactly the line generated by that involution as its fixed subgroup. -/
public theorem fixed_zpowers_eq_line_of_order_three_on_eight
    {V : Type*} [Group V] [Finite V] [IsElementaryAbelian 2 V]
    (hV : Nat.card V = 8) (i : V) (hi : orderOf i = 2)
    (r : MulAut V) (hr : orderOf r = 3) (hri : r i = i) :
    FixedPoints.subgroup (Subgroup.zpowers r) V = Subgroup.zpowers i := by
  have hR : Nat.card (Subgroup.zpowers r) = 3 := by rw [Nat.card_zpowers, hr]
  have hcard := (card_three_action_on_eight_fixed_commutator_card hR hV
    (order_three_commutator_ne_bot r hr)).1
  apply Eq.symm
  apply Subgroup.eq_of_le_of_card_ge
    (Subgroup.zpowers_le.mpr ((mem_fixed_zpowers_iff r i).mpr hri))
  rw [hcard, Nat.card_zpowers, hi]

/-- An order-six automorphism group fixing an involution preserves a faithful
moving plane complementary to that involution's line. The supplied order-three
actor fixes exactly that line and acts without nonidentity fixed points on
the plane. The witness is `commutatorAction (Subgroup.zpowers r) V`. -/
public theorem exists_invariant_moving_plane_of_card_six
    {V : Type*} [Group V] [Finite V] [IsElementaryAbelian 2 V]
    (hV : Nat.card V = 8) (Q : Subgroup (MulAut V)) (hQ : Nat.card Q = 6)
    (i : V) (hi : orderOf i = 2) (hfix : ∀ q ∈ Q, q i = i)
    (r : MulAut V) (hrQ : r ∈ Q) (hr : orderOf r = 3) :
    ∃ A : Subgroup V,
      Nat.card A = 4 ∧
      (∀ q ∈ Q, ∀ a ∈ A, q a ∈ A) ∧
      (∀ a ∈ A, r a = a → a = 1) ∧
      (∀ q ∈ Q, q ≠ 1 → ∃ a ∈ A, q a ≠ a) ∧
      (∀ v : V, r v = v ↔ v ∈ Subgroup.zpowers i) ∧
      IsCompl (Subgroup.zpowers i) A := by
  classical
  let R := Subgroup.zpowers r
  let A := commutatorAction R V
  have hR : Nat.card R = 3 := by rw [Nat.card_zpowers, hr]
  have hRQ : R ≤ Q := Subgroup.zpowers_le.mpr hrQ
  have hRsub : Nat.card (R.subgroupOf Q) = 3 := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hRQ).toEquiv, hR]
  have hindex : (R.subgroupOf Q).index = 2 := by
    have hmul := (R.subgroupOf Q).index_mul_card
    rw [hRsub, hQ] at hmul
    omega
  have hnormal : (R.subgroupOf Q).Normal := Subgroup.normal_of_index_eq_two hindex
  have hinv : IsInvariant Q V A :=
    commutatorAction_isInvariant_of_normalizing_actor Q R
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hRQ).mp hnormal)
  have hcards := card_three_action_on_eight_fixed_commutator_card hR hV
    (order_three_commutator_ne_bot r hr)
  have hline : FixedPoints.subgroup R V = Subgroup.zpowers i :=
    fixed_zpowers_eq_line_of_order_three_on_eight hV i hi r hr (hfix r hrQ)
  have hcop : Nat.Coprime (Nat.card R) (Nat.card V) := by rw [hR, hV]; decide
  have hcompl :=
    isCompl_fixedPointSubgroup_commutatorAction_of_solvable_coprime_of_isMulCommutative
      (G := V) (A := R) (Group.isSolvable_of_comm fun x y => mul_comm x y)
      hcop inferInstance
  have hcomplLine : IsCompl (Subgroup.zpowers i) A := by
    simpa only [← hline] using hcompl
  refine ⟨A, hcards.2, ?_, ?_, ?_, ?_, hcomplLine⟩
  · intro q hq a ha
    exact (hinv.invariant ⟨q, hq⟩ a).mp ha
  · intro a ha hra
    exact Subgroup.disjoint_def.mp hcompl.disjoint
      ((mem_fixed_zpowers_iff r a).mpr hra) ha
  · intro q hq hne
    by_contra hnot
    have hAfix : ∀ a ∈ A, q a = a := by simpa only [not_exists, not_and, not_not] using hnot
    have hLfix : ∀ v ∈ Subgroup.zpowers i, q v = v := by
      intro v hv
      rcases hv with ⟨n, rfl⟩
      simp only [map_zpow, hfix q hq]
    apply hne
    ext v
    change q v = v
    have hv : v ∈ Subgroup.zpowers i ⊔ A := by rw [hcomplLine.sup_eq_top]; trivial
    let : (Subgroup.zpowers i).Normal := Subgroup.normal_of_isMulCommutative _
    obtain ⟨l, hl, a, ha, rfl⟩ := Subgroup.mem_sup_of_normal_left.mp hv
    rw [map_mul, hLfix l hl, hAfix a ha]
  · intro v
    rw [← hline]
    exact (mem_fixed_zpowers_iff r v).symm

end MulAut
