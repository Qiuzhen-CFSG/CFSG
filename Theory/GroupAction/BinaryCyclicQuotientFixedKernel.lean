module
public import Theory.GroupAction.BinaryCyclicFixedKernel
public import Theory.GroupTheory.ElementaryFixedQuotientLifting
public import Theory.ElementaryAbelian.Quotient
public import Theory.GroupTheory.PGroup.CyclicInvolution
/-!
# Cyclic binary actions on elementary subgroup quotients

If the displacement image of an involution is larger than its possible fixed
kernel, the action on the quotient is faithful. The square-root fixed count
on the elementary kernel gives fixed lifts. Consequently an actor whose
displacements on the original fixed subgroup lie in that kernel belongs to
the subgroup generated by the involution.

This supplies the original-coordinate fixed-plane kernel for the single
linear case of Aschbacher–Smith, Chapter 2, Section 4, printed pp.537–539.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace BinaryCyclicAction
variable {A V : Type*} [Group A] [Finite A] [IsCyclic A]
    [Group V] [Finite V] [IsElementaryAbelian 2 V]

theorem quotient_injective_of_fixed_displacement_bound
    (ρ : A →* MulAut V) (N : Subgroup V) [N.Normal]
    (hN : ∀ a : A, ∀ v ∈ N, ρ a v ∈ N)
    (β : A →* MulAut (V ⧸ N))
    (hβ : ∀ a : A, ∀ v : V, β a (QuotientGroup.mk' N v) = QuotientGroup.mk' N (ρ a v))
    (hA : IsPGroup 2 A) (s : A) (hs : orderOf s = 2)
    (hb : Nat.card V > Nat.card ((ρ s).toMonoidHom.eqLocus (MonoidHom.id V)) *
      Nat.card (((ρ s).toMonoidHom.restrict (hN s)).eqLocus (MonoidHom.id N))) :
    Function.Injective β := by
  apply β.ker_eq_bot_iff.mp
  by_contra hh
  have hsK : s ∈ β.ker := hA.involution_mem_subgroup_of_ne_bot hs β.ker hh
  have hsq : β s = 1 := hsK
  let α := (ρ s).toMonoidHom
  let δ : V →* V := MonoidHom.id V / α
  let CN := (α.restrict (hN s)).eqLocus (MonoidHom.id N)
  have hk : δ.ker = α.eqLocus (MonoidHom.id V) := by
    ext v
    change v / α v = 1 ↔ α v = v
    rw [div_eq_one, eq_comm]
  have hα : Function.Involutive α := by
    intro v
    change ρ s (ρ s v) = v
    rw [←MulAut.mul_apply, ←map_mul, ←pow_two,
      show s^2=1 by simpa only [hs] using pow_orderOf_eq_one s, map_one]
    rfl
  have hi (v : V) : v⁻¹ = v := by
    apply inv_eq_of_mul_eq_one_left
    simpa only [pow_two] using Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 V) v
  have hδN (v : V) : δ v ∈ N := by
    have he := hβ s v
    rw [hsq] at he
    apply QuotientGroup.eq_iff_div_mem.mp
    exact he
  have hδC (v : V) : α (δ v) = δ v := by
    change α (v / α v) = v / α v
    rw [map_div,hα]
    simp only [div_eq_mul_inv,hi,mul_comm]
  let e : δ.range → CN := fun x => ⟨⟨x.val,by
    obtain ⟨v,hv⟩ := x.property
    rw [←hv]
    exact hδN v⟩,by
      apply Subtype.ext
      obtain ⟨v,hv⟩ := x.property
      change α x.val=x.val
      rw [←hv]
      exact hδC v⟩
  have he : Function.Injective e := fun x y h => Subtype.ext (congrArg (fun z : CN => (z : V)) h)
  have hc := Nat.card_le_card_of_injective e he
  have hp := δ.ker.card_mul_index
  rw [index_ker,hk] at hp
  change Nat.card (α.eqLocus (MonoidHom.id V)) * Nat.card δ.range = Nat.card V at hp
  change Nat.card V > Nat.card (α.eqLocus (MonoidHom.id V)) * Nat.card CN at hb
  have hh' := Nat.mul_le_mul_left (Nat.card (α.eqLocus (MonoidHom.id V))) hc
  omega

theorem mem_zpowers_of_fixed_quotient_displacement
    (ρ : A →* MulAut V) (N : Subgroup V) [N.Normal]
    (hN : ∀ a : A, ∀ v ∈ N, ρ a v ∈ N)
    (β : A →* MulAut (V ⧸ N))
    (hβ : ∀ a : A, ∀ v : V, β a (QuotientGroup.mk' N v) = QuotientGroup.mk' N (ρ a v))
    (hA : IsPGroup 2 A) (s : A) (hs : orderOf s = 2)
    (hb : Nat.card V > Nat.card ((ρ s).toMonoidHom.eqLocus (MonoidHom.id V)) *
      Nat.card (((ρ s).toMonoidHom.restrict (hN s)).eqLocus (MonoidHom.id N)))
    (hcN : Nat.card (((ρ s).toMonoidHom.restrict (hN s)).eqLocus (MonoidHom.id N))^2 = Nat.card N)
    (a : A) (ha : ∀ v : V, ρ s v = v → ρ a v / v ∈ N) : a ∈ zpowers s := by
  let : IsElementaryAbelian 2 N :=
    { toIsMulCommutative := inferInstance
      exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr fun v =>
        Subtype.ext (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
          (IsElementaryAbelian.exponent_dvd_p 2 V) v.val) }
  let : IsElementaryAbelian 2 (V ⧸ N) := IsElementaryAbelian.quotient N
  apply mem_zpowers_of_fixes_involution_fixed β
    (quotient_injective_of_fixed_displacement_bound ρ N hN β hβ hA s hs hb) hA s hs a
  intro v hv
  have hα : Function.Involutive (ρ s).toMonoidHom := by
    intro w
    change ρ s (ρ s w) = w
    rw [←MulAut.mul_apply, ←map_mul, ←pow_two,
      show s^2=1 by simpa only [hs] using pow_orderOf_eq_one s, map_one]
    rfl
  have hv' : QuotientGroup.map N N (ρ s).toMonoidHom (hN s) v=v := by
    obtain ⟨w,rfl⟩ := QuotientGroup.mk'_surjective N v
    change QuotientGroup.mk' N (ρ s w)=QuotientGroup.mk' N w
    exact (hβ s w).symm.trans hv
  obtain ⟨w,hw,rfl⟩ := Theory.GroupTheory.exists_fixed_quotient_lift_of_elementary_kernel
    N (ρ s).toMonoidHom hα (hN s) hcN v hv'
  rw [hβ]
  exact QuotientGroup.eq_iff_div_mem.mpr (ha w hw)
end BinaryCyclicAction
