module
public import Theory.GroupAction.FixedQuotientCentralizer
public import Theory.Representation.BinaryGroupAction
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Tactic.Group
/-!
# Elementary abelian groups detected by their fixed quotient

Let U be abelian, normalized by K, and generated by [U,K]. If its literal
quotient U/C_U(K) is a binary representation, squares in U centralize K.
Each commutator [u,k] consequently has square one; the whole group U has
exponent at most two. Neither faithfulness nor irreducibility is required.

This supplies the elementary source layer for the center-commutator
endgame in Aschbacher–Smith 13.6.22, printed pp.932–933.
-/

public section
open Subgroup
open scoped IsMulCommutative commutatorElement
namespace Representation.ConjugationQuotientModel
variable {G A V : Type*} [Group G] [Group A]
  [AddCommGroup V] [Module (ZMod 2) V]
  {K U : Subgroup G} {ρ : Representation (ZMod 2) A V}

theorem elementary_of_commutator_eq [IsMulCommutative U]
    (m : ConjugationQuotientModel K U ρ) (hc : ⁅U,K⁆ = U) :
    IsElementaryAbelian 2 U := by
  let sq : U →* U := powMonoidHom 2
  let N := sq.ker.map U.subtype
  have hsq (u : U) : u ^ 2 ∈ (centralizer (K : Set G)).subgroupOf U := by
    rw [← m.kernel, MonoidHom.mem_ker, map_pow]
    exact Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (BinaryGroupAction.elementary (V := V)).exponent_dvd_p (m.quotient u)
  have hUN : U ≤ N := by
    rw [← hc]
    apply Subgroup.commutator_le.mpr
    intro u hu k hk
    let x : U := ⟨u,hu⟩
    let c := U.normalizerMonoidHom ⟨k,m.normalizes hk⟩
    have hfixed : c (x ^ 2) = x ^ 2 := by
      apply Subtype.ext
      change k * u ^ 2 * k⁻¹ = u ^ 2
      have he := hsq x k hk
      change k * u^2 = u^2 * k at he
      rw [he, mul_inv_cancel_right]
    refine ⟨x * (c x)⁻¹, ?_, ?_⟩
    · change (x * (c x)⁻¹)^2 = 1
      rw [mul_pow, inv_pow, ← map_pow, hfixed, mul_inv_cancel]
    · change u * (k*u*k⁻¹)⁻¹ = ⁅u,k⁆
      simp only [commutatorElement_def]
      group
  refine { toIsMulCommutative := inferInstance, exponent_dvd_p := ?_ }
  apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
  intro u
  obtain ⟨x,hx,he⟩ := hUN u.property
  change x ^ 2 = 1 at hx
  apply Subtype.ext
  change (u : G)^2 = 1
  have hh := congrArg U.subtype hx
  change (x : G)^2 = 1 at hh
  change (x : G) = (u : G) at he
  rwa [he] at hh
end Representation.ConjugationQuotientModel
