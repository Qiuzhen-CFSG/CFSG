module
public import Theory.GroupAction.ElementaryTwoInvertedPrimePower

/-!
# A moving prime-order subgroup under an elementary two-group

For an elementary two-group A acting on a finite odd-prime group K of
exponent d, hyperplane centralizer commutators generate [K,A]. If that
commutator is not contained in a specified subgroup N, one hyperplane
centralizer contains a commutator g outside N. An involution in A inverts
g, and its hyperplane fixes g. Thus the cyclic group generated by g has
order d, is A-invariant, and equals its own commutator with A.

The containment in [K,A] and the failure of containment in N are retained.
Taking N to be the kernel on a specified module detects actual movement,
rather than only nonidentity of the cyclic subgroup.
Source: Aschbacher--Smith 13.1.9, printed pp.870--871, using A.1.17.
The element calculation extends ElementaryTwoInvertedPrimePower.lean.
-/

public section
open Subgroup
open scoped IsMulCommutative commutatorElement
namespace Theory.GroupAction
variable {G : Type*} [Group G] [Finite G]

/-- Detect movement outside an arbitrary subgroup by an invariant order-p line.
The selected hyperplane fixes the line and the remaining actor coset inverts it. -/
theorem exists_inverted_prime_line_outside {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (R V N : Subgroup G) (hR : IsPGroup p R) [IsElementaryAbelian 2 V]
    (he : Monoid.exponent R = p) (hVR : V ≤ normalizer (R : Set G))
    (hne : ¬ ⁅R,V⁆ ≤ N) :
    ∃ (B : Subgroup V) (g v : G), B.index = 2 ∧
      g ∈ ⁅R,V⁆ ∧ g ∉ N ∧ v ∈ V ∧ orderOf g = p ∧
      v * g * v⁻¹ = g⁻¹ ∧
      (∀ b ∈ B.map V.subtype, b * g * b⁻¹ = g) ∧
      (∀ w ∈ V, w * g * w⁻¹ = g ∨ w * g * w⁻¹ = g⁻¹) := by
  classical
  have hex : ∃ B : Subgroup V, B.index = 2 ∧
      ¬ ⁅R ⊓ centralizer (B.map V.subtype : Set G), V⁆ ≤ N := by
    by_contra! h
    apply hne
    rw [← iSup_hyperplane_centralizer_commutator hp R V hR hVR]
    exact iSup₂_le h
  obtain ⟨B,hB,hmove⟩ := hex
  let C := R ⊓ centralizer (B.map V.subtype : Set G)
  have hex : ∃ x ∈ C, ∃ v ∈ V, ⁅v,x⁆ ∉ N := by
    by_contra! h
    apply hmove
    rw [commutator_comm]
    exact commutator_le.mpr fun v hv x hx => h x hx v hv
  obtain ⟨x,hx,v,hv,hm⟩ := hex
  let g := v*x*v⁻¹*x⁻¹
  have hv2 : v*v = 1 := by
    simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) v hv
  have hvi : v⁻¹ = v := inv_eq_of_mul_eq_one_right hv2
  have hgR : g ∈ R := R.mul_mem ((mem_normalizer_iff.mp (hVR hv) x).mp hx.1) (R.inv_mem hx.1)
  have hgN : g ∉ N := hm
  have hg1 : g ≠ 1 := fun hh => hgN (hh ▸ N.one_mem)
  have hgp : g ^ p = 1 := by
    rw [← he]
    exact Subgroup.pow_exponent_eq_one hgR
  have horder : orderOf g = p := orderOf_eq_prime hgp hg1
  have hinv : v*g*v⁻¹ = g⁻¹ := by
    dsimp only [g]
    simp only [mul_inv_rev, inv_inv, hvi]
    simp only [← mul_assoc, hv2, one_mul]
  have hBfix : ∀ w ∈ B.map V.subtype, w*g*w⁻¹ = g := by
    intro w hw
    have hwV : w ∈ V := map_subtype_le B hw
    have hwv : w*v = v*w := congrArg Subtype.val (mul_comm (⟨w,hwV⟩ : V) ⟨v,hv⟩)
    have hwx : w*x = x*w := hx.2 w hw
    have hwc : v ∈ centralizer ({w} : Set G) := mem_centralizer_singleton_iff.mpr hwv.symm
    have hxc : x ∈ centralizer ({w} : Set G) := mem_centralizer_singleton_iff.mpr hwx.symm
    have hgc : g ∈ centralizer ({w} : Set G) :=
      (centralizer ({w} : Set G)).mul_mem
        ((centralizer ({w} : Set G)).mul_mem
          ((centralizer ({w} : Set G)).mul_mem hwc hxc)
          ((centralizer ({w} : Set G)).inv_mem hwc))
        ((centralizer ({w} : Set G)).inv_mem hxc)
    exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp hgc).symm
  have hvB : (⟨v,hv⟩ : V) ∉ B := by
    intro hvB
    apply hm
    have hxv := hx.2 v (mem_map_of_mem V.subtype hvB)
    have heq : ⁅v,x⁆ = 1 := commutatorElement_eq_one_iff_mul_comm.mpr hxv
    rw [heq]
    exact N.one_mem
  have hgcomm : g ∈ ⁅R,V⁆ := by
    rw [commutator_comm]
    exact commutator_mem_commutator hv hx.1
  refine ⟨B,g,v,hB,hgcomm,hgN,hv,horder,hinv,hBfix,?_⟩
  intro w hw
  by_cases hwB : (⟨w,hw⟩ : V) ∈ B
  · exact Or.inl (hBfix w (mem_map_of_mem V.subtype hwB))
  · have hvw : (⟨v,hv⟩ : V) * ⟨w,hw⟩ ∈ B :=
      (B.mul_mem_iff_of_index_two hB).mpr (iff_of_false hvB hwB)
    have hfix := hBfix (v*w) (mem_map_of_mem V.subtype hvw)
    right
    have hh := congrArg (fun y : G => v*y*v⁻¹) hfix
    rw [hinv] at hh
    have heq : v * (v*w*g*(v*w)⁻¹) * v⁻¹ = w*g*w⁻¹ := by
      simp only [mul_inv_rev, hvi]
      simp only [← mul_assoc, hv2, one_mul]
      rw [mul_assoc, hv2, mul_one]
    exact heq.symm.trans hh

/-- An actual order-p subgroup with full actor commutator and a fixing hyperplane. -/
theorem exists_prime_subgroup_outside_of_elementary_action
    {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (R V N : Subgroup G) (hR : IsPGroup p R) [IsElementaryAbelian 2 V]
    (he : Monoid.exponent R = p) (hVR : V ≤ normalizer (R : Set G))
    (hne : ¬ ⁅R,V⁆ ≤ N) :
    ∃ (B : Subgroup V) (D : Subgroup G), B.index = 2 ∧ D ≤ ⁅R,V⁆ ∧ Nat.card D = p ∧
      V ≤ normalizer (D : Set G) ∧ ⁅D,V⁆ = D ∧
      D ≤ centralizer (B.map V.subtype : Set G) ∧ ¬ D ≤ N := by
  obtain ⟨B,g,v,hB,hgR,hgN,hv,horder,hinv,hfix,hall⟩ :=
    exists_inverted_prime_line_outside hp R V N hR he hVR hne
  let D := zpowers g
  have hcard : Nat.card D = p := (Nat.card_zpowers g).trans horder
  have hn : V ≤ normalizer (D : Set G) := by
    intro a ha
    rw [mem_normalizer_iff_map_conj_eq,MonoidHom.map_zpowers]
    change zpowers (a*g*a⁻¹) = zpowers g
    rcases hall a ha with h | h
    · rw [h]
    · rw [h,zpowers_inv]
  have hc : ⁅D,V⁆ ≤ D := le_normalizer_iff_commutator_le_left.mp hn
  have hmove : ⁅D,V⁆ ≠ ⊥ := by
    intro hz
    have hcomm := commutator_eq_bot_iff_le_centralizer.mp hz (mem_zpowers g) v hv
    have hgi : g = g⁻¹ := (mul_inv_eq_iff_eq_mul.mpr hcomm).symm.trans hinv
    have hg2 : g ^ 2 = 1 := by
      rw [pow_two]
      calc g * g = g * g⁻¹ := congrArg (g * ·) hgi
           _ = 1 := mul_inv_cancel g
    have hd : p ∣ 2 := horder ▸ orderOf_dvd_of_pow_eq_one hg2
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h | h
    · exact (Fact.out : p.Prime).ne_one h
    · exact hp h
  have hfull : ⁅D,V⁆ = D := by
    let : Fact (Nat.card D).Prime := ⟨hcard ▸ (Fact.out : p.Prime)⟩
    rcases (⁅D,V⁆.subgroupOf D).eq_bot_or_eq_top_of_prime_card with hb | ht
    · exfalso
      apply hmove
      have hh := congrArg (map D.subtype) hb
      rwa [map_subgroupOf_eq_of_le hc,Subgroup.map_bot] at hh
    · exact le_antisymm hc (subgroupOf_eq_top.mp ht)
  refine ⟨B,D,hB,zpowers_le.mpr hgR,hcard,hn,hfull,?_,fun hh => hgN (hh (mem_zpowers g))⟩
  apply zpowers_le.mpr
  intro b hb
  exact mul_inv_eq_iff_eq_mul.mp (hfix b hb)
end Theory.GroupAction
