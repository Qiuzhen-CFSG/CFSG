module

public import Theory.GroupAction.QuadraticFourCentralizerReduction

/-!
# Invariant quadratic displacement obstruction

Suppose an automorphism subgroup F acts fully on a commutative group W,
and [F,J] = F. If the common displacement [W,J] is F-invariant, its
invariance under J makes it invariant under the subgroup generated by F
and J. The induced quotient action of J is trivial, hence so is that of
F, and fullness forces the displacement to equal W. A quadratic J then
fixes all of W, so faithfulness makes J trivial.

The stabilizer of the displacement supplies the ambient action used by
the invariant-quotient argument. No finiteness, odd-order assumption, or
representation classification is required for this terminal step.
-/

@[expose] public section

open scoped IsMulCommutative

theorem quadratic_false_of_invariant_displacement
    {W : Type*} [Group W] [IsMulCommutative W]
    (F J : Subgroup (MulAut W))
    (hfull : commutatorAction F W = ⊤)
    (hgenerate : ⁅F, J⁆ = F)
    (hquadratic : commutatorAction₂ J W = ⊥)
    (hinvariant : IsInvariant F W (commutatorAction J W))
    (hJne : J ≠ ⊥) : False := by
  let displacement := commutatorAction J W
  let stabilizer : Subgroup (MulAut W) :=
    { carrier := {actor | ∀ point : W, point ∈ displacement ↔ actor point ∈ displacement}
      one_mem' := by simp
      mul_mem' := by
        intro first second hfirst hsecond point
        exact (hsecond point).trans (hfirst (second point))
      inv_mem' := by
        intro actor hactor point
        simpa using (hactor (actor⁻¹ point)).symm }
  have hFle : F ≤ stabilizer := by
    intro actor hactor point
    exact hinvariant.invariant ⟨actor, hactor⟩ point
  have hJinvariant : IsInvariant J W displacement := commutatorAction_isInvariant
  have hJle : J ≤ stabilizer := by
    intro actor hactor point
    exact hJinvariant.invariant ⟨actor, hactor⟩ point
  have hstable : IsInvariant stabilizer W displacement := ⟨fun actor => actor.property⟩
  have hcomm : ⁅F.subgroupOf stabilizer, J.subgroupOf stabilizer⁆ =
      F.subgroupOf stabilizer := by
    apply Subgroup.map_injective stabilizer.subtype_injective
    rw [Subgroup.map_commutator, Subgroup.map_subgroupOf_eq_of_le hFle,
      Subgroup.map_subgroupOf_eq_of_le hJle, hgenerate]
  have hfull' : commutatorAction (F.subgroupOf stabilizer) W = ⊤ := by
    rw [← commutatorAction_map_actor_subtype stabilizer,
      Subgroup.map_subgroupOf_eq_of_le hFle, hfull]
  have hJdisplacement : commutatorAction (J.subgroupOf stabilizer) W ≤ displacement := by
    rw [← commutatorAction_map_actor_subtype stabilizer,
      Subgroup.map_subgroupOf_eq_of_le hJle]
  have htop : displacement = ⊤ :=
    QuadraticFourCentralizer.invariant_subgroup_eq_top_of_commutator_relations
      (F.subgroupOf stabilizer) (J.subgroupOf stabilizer) displacement
      hstable hJdisplacement hcomm hfull'
  have hfixed : displacement ≤ FixedPoints.subgroup J W :=
    commutatorAction_le_fixedPoints_of_commutatorAction₂_eq_bot hquadratic
  apply hJne
  rw [Subgroup.eq_bot_iff_forall]
  intro actor hactor
  ext point
  have hpoint : point ∈ displacement := by rw [htop]; trivial
  exact (hfixed hpoint) ⟨actor, hactor⟩
