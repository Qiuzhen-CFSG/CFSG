@[expose] public def smallIndex : Fin 22 → Fin 50 := ![0, 1, 2, 3, 6, 7, 8, 9, 13, 14, 15, 18, 20, 21, 22, 23, 24, 27, 32, 34, 35, 36]

public theorem not_four_dvd_small_nodes (j : Fin 22) :
    ¬ 4 ∣ Nat.card (properNode (smallIndex j)) := by
  fin_cases j
  · have hz : properNode 0 = ⊥ := node_zero
    change ¬ 4 ∣ Nat.card (properNode 0)
    rw [hz, Subgroup.card_bot]
    decide
  · change ¬ 4 ∣ Nat.card (properNode 1)
    rw [(listing01.sound (by decide) all_listings_checked.1).1]
    decide
  · change ¬ 4 ∣ Nat.card (properNode 2)
    rw [(listing02.sound (by decide) all_listings_checked.2.1).1]
    decide
  · change ¬ 4 ∣ Nat.card (properNode 3)
    rw [(listing03.sound (by decide) all_listings_checked.2.2.1).1]
    decide
  · change ¬ 4 ∣ Nat.card (properNode 6)
    rw [(listing06.sound (by decide) all_listings_checked.2.2.2.1).1]
    decide
  · change ¬ 4 ∣ Nat.card (properNode 7)
    rw [(listing07.sound (by decide) all_listings_checked.2.2.2.2.1).1]
    decide
  · change ¬ 4 ∣ Nat.card (properNode 8)
    rw [(listing08.sound (by decide) all_listings_checked.2.2.2.2.2.1).1]
    decide
  · change ¬ 4 ∣ Nat.card (properNode 9)
