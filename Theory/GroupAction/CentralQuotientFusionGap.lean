module

public import Theory.GroupTheory.CentralCharacteristicAutomorphisms
public import Theory.GroupAction.AutomorphismFixedSubgroup
public import Mathlib.GroupTheory.Index

/-!
# A gap between fixed points and their image in a central quotient

For an automorphism fixing a central characteristic subgroup N pointwise,
the displacement on the inverse image of the quotient fixed subgroup is a
homomorphism into N. If its image is generated by an involution z, the image
of the upstairs fixed subgroup has index two downstairs.

A bound on all fixed displacements also restricts fusion: a displacement in
the image of the upstairs fixed subgroup must be trivial in the quotient.
Thus any nontrivial involutory fixed displacement downstairs lies outside
that image. No assertion about the size or exponent of N is needed.

These are the elementary central-quotient calculations used in
Aschbacher–Smith, proof of 16.4.9(2), printed p.1190. Pointwise fixation of N
is an explicit hypothesis; it must be established in each application.
-/

@[expose] public section

namespace MulAut.CentralQuotientFusionGap
open Subgroup
variable {G : Type*} [Group G] (N : Subgroup G) [N.Characteristic] (a : MulAut G)

/-- The upstairs inverse image of the full quotient fixed group. -/
def fixedPreimage : Subgroup G :=
  (N.quotientAut a).fixedSubgroup.comap (QuotientGroup.mk' N)

theorem mem_fixedPreimage (x : G) :
    x ∈ fixedPreimage N a ↔ a x * x⁻¹ ∈ N := by
  change QuotientGroup.mk' N x ∈ (N.quotientAut a).fixedSubgroup ↔ _
  rw [MulAut.mem_fixedSubgroup, quotientAut_apply_mk]
  simpa only [QuotientGroup.mk'_apply, div_eq_mul_inv] using
    (QuotientGroup.eq_iff_div_mem (N := N) (x := a x) (y := x))

/-- Centrality makes displacement multiplicative on this preimage. -/
def displacement (hN : N ≤ center G) : fixedPreimage N a →* G where
  toFun x := a x * (x : G)⁻¹
  map_one' := by simp
  map_mul' x y := by
    have hc := mem_center_iff.mp (hN ((mem_fixedPreimage N a y).mp y.property))
      (x : G)⁻¹
    simp only [Subgroup.coe_mul, map_mul, mul_inv_rev]
    calc
      a x * a y * ((y : G)⁻¹ * (x : G)⁻¹) =
          a x * (a y * (y : G)⁻¹) * (x : G)⁻¹ := by group
      _ = a x * (x : G)⁻¹ * (a y * (y : G)⁻¹) := by
        rw [mul_assoc, ← hc, ← mul_assoc]

theorem displacement_ker (hN : N ≤ center G) :
    (displacement N a hN).ker = a.fixedSubgroup.subgroupOf (fixedPreimage N a) := by
  ext x
  change a x * (x : G)⁻¹ = 1 ↔ (x : G) ∈ a.fixedSubgroup
  rw [MulAut.mem_fixedSubgroup]
  exact mul_inv_eq_one

/-- Pointwise fixation of the kernel makes fixedness detectable in its image. -/
theorem mem_fixedImage_iff (hfix : N ≤ a.fixedSubgroup) (x : G) :
    QuotientGroup.mk' N x ∈ a.fixedSubgroup.map (QuotientGroup.mk' N) ↔
      x ∈ a.fixedSubgroup := by
  change x ∈ (a.fixedSubgroup.map (QuotientGroup.mk' N)).comap (QuotientGroup.mk' N) ↔ _
  rw [comap_map_eq, QuotientGroup.ker_mk', sup_eq_left.mpr hfix]

/-- A two-valued, nonconstant central displacement gives the exact index. -/
theorem fixedImage_index_two (hN : N ≤ center G) (hfix : N ≤ a.fixedSubgroup)
    {z : G} (hz : z ∈ N) (hz2 : orderOf z = 2)
    (hbound : ∀ x : G, a x * x⁻¹ ∈ N → a x * x⁻¹ = 1 ∨ a x * x⁻¹ = z)
    (hw : ∃ x : G, a x * x⁻¹ = z) :
    ((a.fixedSubgroup.map (QuotientGroup.mk' N)).subgroupOf
      (N.quotientAut a).fixedSubgroup).index = 2 := by
  have hrange : (displacement N a hN).range = zpowers z := by
    apply le_antisymm
    · rintro _ ⟨x, rfl⟩
      change a x * (x : G)⁻¹ ∈ zpowers z
      rcases hbound x ((mem_fixedPreimage N a x).mp x.property) with he | he
      · exact he.symm ▸ (zpowers z).one_mem
      · exact he.symm ▸ mem_zpowers z
    · apply zpowers_le.mpr
      obtain ⟨x, hx⟩ := hw
      exact ⟨⟨x, (mem_fixedPreimage N a x).mpr (hx ▸ hz)⟩, hx⟩
  have hindex : a.fixedSubgroup.relIndex (fixedPreimage N a) = 2 := by
    change (a.fixedSubgroup.subgroupOf (fixedPreimage N a)).index = 2
    rw [← displacement_ker N a hN, index_ker, hrange, Nat.card_zpowers, hz2]
  have hmap : (fixedPreimage N a).map (QuotientGroup.mk' N) =
      (N.quotientAut a).fixedSubgroup :=
    map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective N) _
  have hNF : N ≤ fixedPreimage N a := by
    intro x hx
    change QuotientGroup.mk' N x ∈ (N.quotientAut a).fixedSubgroup
    have he : QuotientGroup.mk' N x = 1 := (QuotientGroup.eq_one_iff x).mpr hx
    rw [he]
    exact one_mem _
  change (a.fixedSubgroup.map (QuotientGroup.mk' N)).relIndex
    (N.quotientAut a).fixedSubgroup = 2
  rw [← hmap, relIndex_map_map, QuotientGroup.ker_mk',
    sup_eq_left.mpr hfix, sup_eq_left.mpr hNF]
  exact hindex

/-- A fixed displacement upstairs projects trivially if the only possibilities
are one and an element of the kernel. -/
theorem quotient_displacement_eq_one (hfix : N ≤ a.fixedSubgroup)
    {z : G} (hz : z ∈ N)
    (hbound : ∀ x : G, a (a x * x⁻¹) = a x * x⁻¹ →
      a x * x⁻¹ = 1 ∨ a x * x⁻¹ = z)
    (q : G ⧸ N)
    (hq : N.quotientAut a q * q⁻¹ ∈ a.fixedSubgroup.map (QuotientGroup.mk' N)) :
    N.quotientAut a q * q⁻¹ = 1 := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N q
  rw [quotientAut_apply_mk, ← map_inv, ← map_mul] at hq ⊢
  have hx := (MulAut.mem_fixedSubgroup a _).mp ((mem_fixedImage_iff N a hfix _).mp hq)
  rcases hbound x hx with he | he
  · rw [he, map_one]
  · rw [he]
    exact (QuotientGroup.eq_one_iff z).mpr hz

/-- A nontrivial fixed involutory displacement supplies an involution missing
from the image of the original fixed subgroup. -/
theorem exists_involution_outside_fixedImage (hfix : N ≤ a.fixedSubgroup)
    {z : G} (hz : z ∈ N)
    (hbound : ∀ x : G, a (a x * x⁻¹) = a x * x⁻¹ →
      a x * x⁻¹ = 1 ∨ a x * x⁻¹ = z)
    (q : G ⧸ N) (hq2 : orderOf (N.quotientAut a q * q⁻¹) = 2)
    (hqfix : N.quotientAut a (N.quotientAut a q * q⁻¹) = N.quotientAut a q * q⁻¹) :
    ∃ v : (N.quotientAut a).fixedSubgroup, orderOf v = 2 ∧
      v ∉ (a.fixedSubgroup.map (QuotientGroup.mk' N)).subgroupOf
        (N.quotientAut a).fixedSubgroup := by
  refine ⟨⟨_, (MulAut.mem_fixedSubgroup _ _).mpr hqfix⟩,
    (orderOf_coe _).symm.trans hq2, ?_⟩
  intro hv
  have he := quotient_displacement_eq_one N a hfix hz hbound q hv
  rw [he, orderOf_one] at hq2
  omega

/-- An elementary central kernel makes squares independent of the lift.
If every quotient involution lifts involutively, a nontrivial involutory
displacement contradicts the fixed-displacement bound. Kernel fixation is
not needed for this alternative. -/
theorem false_of_involution_lifting (hN : N ≤ center G)
    (hN2 : ∀ c ∈ N, c ^ 2 = 1) (ha : a ^ 2 = 1)
    {z : G} (hz : z ∈ N)
    (hbound : ∀ x : G, a (a x * x⁻¹) = a x * x⁻¹ →
      a x * x⁻¹ = 1 ∨ a x * x⁻¹ = z)
    (hlift : ∀ v : G ⧸ N, orderOf v = 2 →
      ∃ y : G, QuotientGroup.mk' N y = v ∧ y ^ 2 = 1)
    (q : G ⧸ N) (hq2 : orderOf (N.quotientAut a q * q⁻¹) = 2) : False := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N q
  rw [quotientAut_apply_mk, ← map_inv, ← map_mul] at hq2
  let d := a x * x⁻¹
  obtain ⟨y, hy, hy2⟩ := hlift (QuotientGroup.mk' N d) hq2
  have hdN : d * y⁻¹ ∈ N := by
    rw [← div_eq_mul_inv]
    apply (QuotientGroup.eq_iff_div_mem (N := N) (x := d) (y := y)).mp
    exact hy.symm
  have hc : Commute (d * y⁻¹) y := (mem_center_iff.mp (hN hdN) y).symm
  have hd2 : d ^ 2 = 1 := by
    have hh := hc.mul_pow 2
    rw [hN2 _ hdN, hy2, one_mul, inv_mul_cancel_right] at hh
    exact hh
  have hai : a (a x) = x := by
    have hh := DFunLike.congr_fun ha x
    simpa only [pow_two, MulAut.mul_apply, MulAut.one_apply] using hh
  have hdi : a d = d⁻¹ := by
    dsimp [d]
    rw [map_mul, map_inv, hai, mul_inv_rev, inv_inv]
  have hdself : d⁻¹ = d := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hd2)
  have hdq : QuotientGroup.mk' N d = 1 := by
    rcases hbound x (hdi.trans hdself) with he | he
    · rw [show d = 1 from he, map_one]
    · apply (QuotientGroup.eq_one_iff d).mpr
      change a x * x⁻¹ ∈ N
      rw [he]
      exact hz
  change orderOf (QuotientGroup.mk' N d) = 2 at hq2
  rw [hdq, orderOf_one] at hq2
  omega

end MulAut.CentralQuotientFusionGap
