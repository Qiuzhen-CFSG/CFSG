private theorem checked_11 :
    ((List.finRange 16).all fun b => (List.finRange 16).all fun c =>
      (List.finRange 16).all fun d => checks (11,b,c,d) (selected_11 b c d)) = true := by
  decide +kernel
private theorem certificate_11 (b c d : B) (hg : good (11,b,c,d))
    (hm : moves (11,b,c,d)) : ∃ k : Fin 53, perfect (11,b,c,d) k := by
  refine ⟨selected_11 b c d,perfect_of_check _ _ hg hm ?_⟩
  exact (List.all_eq_true.mp
    (List.all_eq_true.mp (List.all_eq_true.mp checked_11 b (List.mem_finRange b))
      c (List.mem_finRange c))) d (List.mem_finRange d)
/-- Every invertible plane-moving matrix with first column 8–11
has a selected perfect involution identity. -/
public theorem certificates_eight_to_eleven (g : Code) (hlo : 8 ≤ g.1.val)
    (hhi : g.1.val < 12) (hg : good g) (hm : moves g) :
    ∃ k : Fin 53, perfect g k := by
  rcases g with ⟨a,b,c,d⟩
  fin_cases a <;> norm_num at hlo <;> norm_num at hhi
  · exact certificate_8 b c d hg hm
  · exact certificate_9 b c d hg hm
  · exact certificate_10 b c d hg hm
  · exact certificate_11 b c d hg hm
end FixedFreeA4BinaryData
