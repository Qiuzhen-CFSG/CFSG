module

public import Mathlib.GroupTheory.GroupAction.Basic
public import Mathlib.GroupTheory.Index
public import Mathlib.Data.Nat.Prime.Basic

/-!
# Escaping a point stabilizer using normal-closure generation

Suppose a group is generated by the normal closure of A and a subgroup S fixing
x. If the whole group does not fix x, then A moves some point in the orbit of x.
Indeed, otherwise A lies in the normal core of the stabilizer of x.

If a normal subgroup N contained in S intersects A in index two, then the
stabilizer in A of such a moved point also has index two. Normality makes N fix
the entire orbit, and the nontrivial stabilizer index divides two.

These are the group-action steps in Aschbacher--Smith, *The Classification of
Quasithin Groups*, combined manuscript (1 March 2004), Lemma F.7.13(1), printed
p.314. The application uses the conjugation action on the orbit of V_beta;
Section E.1 supplies the generating subgroups and the index-two kernel.
-/

namespace MulAction

variable {G X : Type*} [Group G] [MulAction G X]

/-- Normal-closure generation forces A to move a point in a nontrivial orbit
whose base point is fixed by the other generating subgroup. -/
public theorem exists_not_le_stabilizer_smul_of_normalClosure_sup
    (A S : Subgroup G) (x : X) (hS : S ≤ stabilizer G x)
    (hgen : Subgroup.normalClosure (A : Set G) ⊔ S = ⊤)
    (hx : stabilizer G x ≠ ⊤) :
    ∃ g : G, ¬ A ≤ stabilizer G (g • x) := by
  classical
  by_contra h
  have hall : ∀ g : G, A ≤ stabilizer G (g • x) := by simpa using h
  have hcore : A ≤ (stabilizer G x).normalCore := by
    intro a ha g
    change (g * a * g⁻¹) • x = x
    simp only [mul_smul]
    rw [show a • (g⁻¹ • x) = g⁻¹ • x from hall g⁻¹ ha, smul_inv_smul]
  have hclosure : Subgroup.normalClosure (A : Set G) ≤ stabilizer G x :=
    (Subgroup.normalClosure_le_normal hcore).trans (Subgroup.normalCore_le _)
  exact hx (top_unique (hgen ▸ sup_le hclosure hS))

/-- An index-two intersection with a normal subgroup fixing the base point
produces a point whose stabilizer in A has index two. -/
public theorem exists_orbit_point_relIndex_eq_two
    (A S N : Subgroup G) [N.Normal] (x : X)
    (hNS : N ≤ S) (hS : S ≤ stabilizer G x)
    (hgen : Subgroup.normalClosure (A : Set G) ⊔ S = ⊤)
    (hx : stabilizer G x ≠ ⊤) (hindex : (A ⊓ N).relIndex A = 2) :
    ∃ g : G, (A ⊓ stabilizer G (g • x)).relIndex A = 2 := by
  obtain ⟨g, hg⟩ := exists_not_le_stabilizer_smul_of_normalClosure_sup A S x hS hgen hx
  have hfix : N ≤ stabilizer G (g • x) := by
    intro n hn
    have hconj := hS (hNS (Subgroup.Normal.conj_mem ‹N.Normal› n hn g⁻¹))
    change (g⁻¹ * n * (g⁻¹)⁻¹) • x = x at hconj
    rw [inv_inv, mul_smul, mul_smul, inv_smul_eq_iff] at hconj
    exact hconj
  have hle : A ⊓ N ≤ A ⊓ stabilizer G (g • x) := inf_le_inf_left A hfix
  have hdvd : (A ⊓ stabilizer G (g • x)).relIndex A ∣ 2 := by
    rw [← hindex]
    exact Subgroup.relIndex_dvd_of_le_left A hle
  have hne : (A ⊓ stabilizer G (g • x)).relIndex A ≠ 1 := by
    intro hone
    exact hg ((Subgroup.relIndex_eq_one.mp hone).trans inf_le_right)
  exact ⟨g, (Nat.dvd_prime Nat.prime_two).mp hdvd |>.resolve_left hne⟩

end MulAction
