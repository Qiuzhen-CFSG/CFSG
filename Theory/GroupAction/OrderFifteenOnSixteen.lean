module

public import Theory.GroupAction.FiveActionMinimalOrder
public import Theory.GroupAction.FiveOnSixteenIrreducible
public import Mathlib.Tactic

/-!
# An order-fifteen automorphism of a sixteen-element group

The cyclic group generated by an automorphism of order fifteen acts regularly
on the fifteen nonidentity elements. Its subgroup of order five has trivial
fixed subgroup, and every invariant subgroup is trivial or full. The fixed
subgroup of any commuting automorphism is invariant, so fixing one nonidentity
element forces that automorphism to be the identity. Counting then gives
transitivity, with an explicit integer power witness.

This finite-action argument is the quotient-action step in Lyons,
*A Characterization of the Group U₃(4)* (1972), Lemma 1, pp. 372–373.
-/

namespace MulAut

/-- An automorphism commuting with an order-five automorphism of a group of
order sixteen cannot fix a nonidentity element unless it is the identity. -/
public theorem eq_one_of_commute_five_of_fixed
    {V : Type*} [Group V] [Finite V] (hV : Nat.card V = 16)
    (a b : MulAut V) (ha : orderOf a = 5) (hab : Commute a b)
    (v : V) (hv : v ≠ 1) (hbv : b v = v) : b = 1 := by
  let A := Subgroup.zpowers a
  have hA : Nat.card A = 5 := (Nat.card_zpowers a).trans ha
  have hnot : FixedPoints.subgroup A V ≠ ⊤ := by
    intro htop
    have he : a = 1 := by
      ext x
      have hx : x ∈ FixedPoints.subgroup A V := htop ▸ Subgroup.mem_top x
      exact hx ⟨a, Subgroup.mem_zpowers a⟩
    simp [he] at ha
  have hfixed := Theory.GroupAction.fixed_eq_bot_of_five_action_card_sixteen hA hV hnot
  let D : Subgroup V := FixedPoints.subgroup (Subgroup.zpowers b) V
  have hD (x : V) : x ∈ D ↔ b x = x := by
    constructor
    · intro hx
      exact hx ⟨b, Subgroup.mem_zpowers b⟩
    · intro hx k
      exact smul_eq_self_of_mem_zpowers k.property hx
  have hcomm (k : A) (x : V) : b ((k : MulAut V) x) = (k : MulAut V) (b x) := by
    obtain ⟨n, hn⟩ := k.property
    change a ^ n = (k : MulAut V) at hn
    have he := congrArg (fun f : MulAut V => f x) (hab.zpow_left n).eq
    rw [hn] at he
    exact he.symm
  let _ : IsInvariant A V D := ⟨by
    intro k x
    rw [hD, hD]
    change b x = x ↔ b ((k : MulAut V) x) = (k : MulAut V) x
    rw [hcomm]
    exact (k : MulAut V).injective.eq_iff.symm⟩
  rcases invariant_eq_bot_or_top_of_five_actor hA hV hfixed D with hbot | htop
  · exact (hv (Subgroup.mem_bot.mp (hbot ▸ (hD v).mpr hbv))).elim
  · ext x
    exact (hD x).mp (htop ▸ Subgroup.mem_top x)

/-- Every nonidentity point can be carried to every other by an integer power
of an order-fifteen automorphism of a sixteen-element group. -/
public theorem exists_zpow_apply_eq_of_order_fifteen
    {V : Type*} [Group V] [Finite V] (hV : Nat.card V = 16)
    (a : MulAut V) (ha : orderOf a = 15)
    (x y : V) (hx : x ≠ 1) (hy : y ≠ 1) :
    ∃ n : ℤ, (a ^ n) x = y := by
  classical
  have hthree : orderOf (a ^ (3 : ℕ)) = 5 := by rw [orderOf_pow, ha]; decide
  let A := Subgroup.zpowers a
  let X := {v : V // v ≠ 1}
  let f : A → X := fun b => ⟨(b : MulAut V) x, by simpa using hx⟩
  have hfree (b : A) (hb : (b : MulAut V) x = x) : b = 1 := by
    apply Subtype.ext
    apply eq_one_of_commute_five_of_fixed hV (a ^ (3 : ℕ)) b hthree _ x hx hb
    obtain ⟨n, hn⟩ := b.property
    rw [← hn]
    exact (Commute.refl a).pow_left 3 |>.zpow_right n
  have hinj : Function.Injective f := by
    intro b c he
    have he' : (b : MulAut V) x = (c : MulAut V) x := congrArg Subtype.val he
    have hbc : c⁻¹ * b = 1 := hfree _ (by
      change (c : MulAut V)⁻¹ ((b : MulAut V) x) = x
      rw [he']
      exact (c : MulAut V).symm_apply_apply x)
    exact inv_mul_eq_one.mp hbc |>.symm
  have hX : Nat.card X = 15 := by
    let _ : Fintype V := Fintype.ofFinite V
    change Nat.card {v : V // ¬v = 1} = 15
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype_compl,
      ← Nat.card_eq_fintype_card, hV]
    simp
  have hsurj : Function.Surjective f := (hinj.bijective_of_nat_card_le (by
    rw [hX, Nat.card_zpowers, ha])).2
  obtain ⟨b, hb⟩ := hsurj ⟨y, hy⟩
  obtain ⟨n, hn⟩ := b.property
  refine ⟨n, ?_⟩
  change a ^ n = (b : MulAut V) at hn
  rw [hn]
  exact congrArg Subtype.val hb

/-- The order-fifteen automorphism itself fixes only the identity. -/
public theorem fixed_eq_one_of_order_fifteen
    {V : Type*} [Group V] [Finite V] (hV : Nat.card V = 16)
    (a : MulAut V) (ha : orderOf a = 15) (x : V) (hx : a x = x) : x = 1 := by
  by_contra hne
  have hthree : orderOf (a ^ (3 : ℕ)) = 5 := by rw [orderOf_pow, ha]; decide
  have he := eq_one_of_commute_five_of_fixed hV (a ^ (3 : ℕ)) a hthree
    ((Commute.refl a).pow_left 3) x hne hx
  simp [he] at ha

end MulAut
