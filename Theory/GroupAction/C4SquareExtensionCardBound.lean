module

public import Theory.GroupTheory.NormalizedSupCard
public import Theory.GroupAction.C4SquareCThreeCentralizer
import Mathlib.Tactic

/-!
# Extending a C4-squared core by a small centralizer

If a finite group is generated by a normal order-sixteen subgroup and a
normalizing subgroup of order at most four, its order is at most sixty-four.
The companion image theorem transfers the C4-squared automorphism-centralizer
estimate through an injective action homomorphism, preserving the supplied
two-subgroup rather than replacing it by an abstract copy.

The cardinal calculation is the normalized subgroup product formula. The
image estimate applies the Frattini centralizer theorem to the mapped
subgroup and transports cardinality across injectivity.

Source: Stellmacher (10.1)(a1), printed p.61/PDF p.51,
`refs/files/stellmacher-n-group.pdf`.
-/

public theorem card_le_sixtyfour_of_c4_square_centralizer
    {G : Type*} [Group G] [Finite G]
    (D C : Subgroup G)
    (hnorm : C ≤ Subgroup.normalizer (D : Set G))
    (hD : Nat.card D = 16)
    (hC : Nat.card C ≤ 4) :
    Nat.card (D ⊔ C : Subgroup G) ≤ 64 := by
  have hprod := Subgroup.card_mul_eq_card_inf_mul_card_sup_of_normalizes D C hnorm
  have hpos : 0 < Nat.card (D ⊓ C : Subgroup G) := Nat.card_pos
  have hinf1 : 1 ≤ Nat.card (D ⊓ C : Subgroup G) := by omega
  rw [hD] at hprod
  by_contra hnot
  have hgt : 64 < Nat.card (D ⊔ C : Subgroup G) := by omega
  have hmul := Nat.mul_lt_mul_of_pos_left hgt hpos
  have hlow : 64 ≤ Nat.card (D ⊓ C : Subgroup G) * 64 :=
    Nat.le_mul_of_pos_left 64 hpos
  have hbad : 64 < Nat.card (D ⊓ C : Subgroup G) * Nat.card (D ⊔ C : Subgroup G) :=
    lt_of_le_of_lt hlow hmul
  have hupper : Nat.card (D ⊓ C : Subgroup G) * Nat.card (D ⊔ C : Subgroup G) ≤ 64 := by
    rw [← hprod]
    exact le_trans (Nat.mul_le_mul_left 16 hC) (by norm_num)
  omega

public theorem card_le_four_of_c4_square_centralizer_image
    {G B : Type*} [Group G] [Finite G] [Group B] [Finite B]
    (model : Nonempty (B ≃* (Multiplicative (ZMod 4) × Multiplicative (ZMod 4))))
    (a : MulAut B) (ha : a ^ 3 = 1) (hne : a ≠ 1)
    (C : Subgroup G) (hC : IsPGroup 2 C)
    (α : G →* MulAut B) (hα : Function.Injective α)
    (hcomm : ∀ c ∈ C, Commute (α c) a) :
    Nat.card C ≤ 4 := by
  have himage : Nat.card (C.map α) ≤ 4 :=
    two_group_c4_square_automorphism_centralizer_card_le_four model a ha hne
      (C.map α) (hC.map α) (by
        rintro _ ⟨c, hc, rfl⟩
        exact hcomm c hc)
  rw [← Subgroup.card_map_of_injective hα]
  exact himage
