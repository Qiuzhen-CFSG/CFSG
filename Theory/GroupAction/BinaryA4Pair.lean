module
public import Theory.GroupAction.BinaryA4Pair.NormalForm
public import Theory.ElementaryAbelian.VectorSpace
public import Theory.GroupAction.PermutationFourFixedFreeThree
public import Theory.GroupAction.FixedFreeA4InvolutionConjugacy
public import Mathlib.FieldTheory.Finiteness
public import Mathlib.Algebra.Group.Equiv.TypeTags

/-!
# Recognition from two marked binary A₄ actors

Let W be elementary abelian of order sixteen. Two A₄ actors share a
nontrivial involution r. The first cubic t acts fixed-point-freely; the
second cubic c has a common fixed subgroup of order two with r. These
literal action hypotheses force the subgroup generated by r,t,c to be A₆.

A binary basis and the fixed-free cubic frame normalize t. The A₄ involution
frame then normalizes r while preserving t. The common fixed subgroup and
all group relations transport through the same equivalence. The normalized
recognition theorem gives A₆ and transports it back to the original actors.
The join wrapper retains their actual generation identities.

This supplies the local linear recognition in Aschbacher–Smith,
*The Classification of Quasithin Groups*, 14.3.19(4). Its source consumer
constructs the two residual actors and discharges the fixed-line mark;
abstract S₄ isomorphism types alone do not imply the conclusion.
-/

open scoped IsMulCommutative
namespace BinaryA4Pair
open Subgroup
private theorem exists_binary_equiv
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W]
    (hcard : Nat.card W = 16) : Nonempty (W ≃* V) := by
  classical
  have hpow : 2 ^ Module.finrank (ZMod 2) (Additive W) = 2 ^ 4 := by
    have hsize := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive W)
    change Nat.card W = _ at hsize
    simpa only [Nat.card_zmod, hcard, show (2 : ℕ) ^ 4 = 16 by decide] using hsize.symm
  have hdim : Module.finrank (ZMod 2) (Additive W) = 4 :=
    Nat.pow_right_injective (by decide : 1 < 2) hpow
  let basis := Module.finBasisOfFinrankEq (ZMod 2) (Additive W) hdim
  exact ⟨(AddEquiv.toMultiplicativeRight basis.equivFun.toAddEquiv).trans
    (MulEquiv.piMultiplicative fun _ : Fin 4 => ZMod 2)⟩

private theorem fixed_free_congr
    {W W' : Type*} [Group W] [Group W'] (e : W ≃* W') (t : MulAut W)
    (hfixed : ∀ w : W, t w = w → w = 1) :
    ∀ v : W', (MulAut.congr e) t v = v → v = 1 := by
  intro v hv
  change e (t (e.symm v)) = v at hv
  have htv := congrArg e.symm hv
  simp only [MulEquiv.symm_apply_apply] at htv
  have heq := congrArg e (hfixed (e.symm v) htv)
  simpa only [MulEquiv.apply_symm_apply,map_one] using heq

private theorem exists_normalized_binary_equiv
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W]
    (hcard : Nat.card W = 16) (t : MulAut W) (hthree : t ^ 3 = 1)
    (hfixed : ∀ w : W, t w = w → w = 1) :
    ∃ e : W ≃* V, ∀ v : V,
      (MulAut.congr e) t v = ![v 1,v 0*v 1,v 2*v 3,v 2] := by
  obtain ⟨e₀⟩ := exists_binary_equiv hcard
  have hthree₀ : ((MulAut.congr e₀) t)^3 = 1 := by rw [←map_pow,hthree,map_one]
  obtain ⟨a,ha⟩ := MulAut.exists_conjugacy_fixed_free_three_four
    ((MulAut.congr e₀) t) hthree₀ (fixed_free_congr e₀ t hfixed)
  refine ⟨e₀.trans a,?_⟩
  intro v
  have hh := ha (a.symm v)
  change a (e₀ (t (e₀.symm (a.symm v)))) = _ at hh ⊢
  simpa only [MulEquiv.apply_symm_apply] using hh


private theorem exists_pair_equiv
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W]
    (hcard : Nat.card W = 16) (r t : MulAut W)
    (hrne : r ≠ 1) (hr2 : r^2 = 1) (ht3 : t^3 = 1)
    (htfixed : ∀ w, t w = w → w = 1)
    (hcomm : Commute r (t*r*t⁻¹))
    (hnorm : r*(t*r*t⁻¹)*((t^2)*r*(t^2)⁻¹) = 1) :
    ∃ e : W ≃* V, (MulAut.congr e) r = reflectionAut ∧
      (MulAut.congr e) t = cubicAut := by
  obtain ⟨e₀,ht₀⟩ := exists_normalized_binary_equiv hcard t ht3 htfixed
  let f := (MulAut.congr e₀).toMonoidHom
  have ht' : f t = cubicAut := MulEquiv.ext ht₀
  have hrne' : f r ≠ 1 := by
    intro he
    apply hrne
    exact (MulAut.congr e₀).injective (he.trans (map_one f).symm)
  have hr2' : (f r)^2 = 1 := by rw [← map_pow,hr2,map_one]
  have hcomm' : Commute (f r) (f t*f r*(f t)⁻¹) := by
    simpa only [map_mul,map_inv] using hcomm.map f
  have hnorm' : f r*(f t*f r*(f t)⁻¹)*(((f t)^2)*f r*((f t)^2)⁻¹) = 1 := by
    simpa only [map_mul,map_inv,map_pow,map_one] using congrArg f hnorm
  obtain ⟨a,hat,har⟩ := MulAut.exists_conjugacy_fixed_free_a4_involution
    (f r) (f t) ht₀ hrne' hr2' hcomm' hnorm'
  refine ⟨e₀.trans a,?_,?_⟩
  · apply MulEquiv.ext
    intro v
    exact har v
  · have h := hat.trans ht'
    exact h

public theorem canonical_model
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W]
    (hcard : Nat.card W = 16) (r t c : MulAut W)
    (hrne : r ≠ 1) (hr2 : r^2 = 1) (ht3 : t^3 = 1)
    (htfixed : ∀ w, t w = w → w = 1)
    (hcomm : Commute r (t*r*t⁻¹))
    (hnorm : r*(t*r*t⁻¹)*((t^2)*r*(t^2)⁻¹) = 1)
    (hc3 : c^3 = 1) (hrc : (r*c)^3 = 1)
    (hfixed : Nat.card {w : W // r w = w ∧ c w = w} = 2) :
    HasCanonicalModel (closure ({r,t,c} : Set (MulAut W))) := by
  obtain ⟨e,her,het⟩ := exists_pair_equiv hcard r t hrne hr2 ht3 htfixed hcomm hnorm
  let f := MulAut.congr e
  have hfc3 : (f c)^3 = 1 := by rw [← map_pow,hc3,map_one]
  have hfrc : (reflectionAut*f c)^3 = 1 := by
    rw [← her,← map_mul,← map_pow,hrc,map_one]
  have hffixed : Nat.card {v : V // reflectionAut v = v ∧ f c v = v} = 2 := by
    refine (Nat.card_congr (e.toEquiv.subtypeEquiv (fun w => ?_))).symm.trans hfixed
    rw [← her]
    change (r w = w ∧ c w = w) ↔
      (e (r (e.symm (e w))) = e w ∧ e (c (e.symm (e w))) = e w)
    simp only [e.symm_apply_apply,e.injective.eq_iff]
  obtain ⟨a,ha⟩ := Normal.normalized_canonical_model (f c) hfc3 hfrc hffixed
  have hm : (closure ({r,t,c} : Set (MulAut W))).map f.toMonoidHom =
      closure (Set.range (Normal.pairGenerator (f c))) := by
    rw [MonoidHom.map_closure]
    congr 1
    ext g
    constructor
    · rintro ⟨x,hx,rfl⟩
      simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl
      · exact ⟨0,her.symm⟩
      · exact ⟨1,het.symm⟩
      · exact ⟨2,rfl⟩
    · rintro ⟨k,rfl⟩
      fin_cases k
      · exact ⟨r,by simp,her⟩
      · exact ⟨t,by simp,het⟩
      · exact ⟨c,by simp,rfl⟩
  refine ⟨e.trans a,?_⟩
  change (closure ({r,t,c} : Set (MulAut W))).map
    ((MulAut.congr a).toMonoidHom.comp f.toMonoidHom) = _
  rw [← map_map,hm]
  exact ha

public theorem recognition
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W]
    (hcard : Nat.card W = 16) (r t c : MulAut W)
    (hrne : r ≠ 1) (hr2 : r^2 = 1) (ht3 : t^3 = 1)
    (htfixed : ∀ w, t w = w → w = 1)
    (hcomm : Commute r (t*r*t⁻¹))
    (hnorm : r*(t*r*t⁻¹)*((t^2)*r*(t^2)⁻¹) = 1)
    (hc3 : c^3 = 1) (hrc : (r*c)^3 = 1)
    (hfixed : Nat.card {w : W // r w = w ∧ c w = w} = 2) :
    Nonempty (closure ({r,t,c} : Set (MulAut W)) ≃* alternatingGroup (Fin 6)) :=
  (canonical_model hcard r t c hrne hr2 ht3 htfixed hcomm hnorm hc3 hrc hfixed).recognition

/-- The two actual local actors generate A₆ when they carry the marked pair. -/
public theorem canonical_model_of_join
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W]
    (hcard : Nat.card W = 16) (P Q : Subgroup (MulAut W)) (r t c : MulAut W)
    (hP : P = closure ({r,t} : Set (MulAut W)))
    (hQ : Q = closure ({r,c} : Set (MulAut W)))
    (hrne : r ≠ 1) (hr2 : r^2 = 1) (ht3 : t^3 = 1)
    (htfixed : ∀ w, t w = w → w = 1)
    (hcomm : Commute r (t*r*t⁻¹))
    (hnorm : r*(t*r*t⁻¹)*((t^2)*r*(t^2)⁻¹) = 1)
    (hc3 : c^3 = 1) (hrc : (r*c)^3 = 1)
    (hfixed : Nat.card {w : W // r w = w ∧ c w = w} = 2) :
    HasCanonicalModel (P ⊔ Q) := by
  have hg : P ⊔ Q = closure ({r,t,c} : Set (MulAut W)) := by
    rw [hP,hQ,← Subgroup.closure_union]
    congr 1
    ext x
    simp only [Set.mem_union,Set.mem_insert_iff,Set.mem_singleton_iff]
    tauto
  rw [hg]
  exact canonical_model hcard r t c hrne hr2 ht3 htfixed hcomm hnorm hc3 hrc hfixed

public theorem recognition_of_join
    {W : Type*} [Group W] [Finite W] [IsElementaryAbelian 2 W]
    (hcard : Nat.card W = 16) (P Q : Subgroup (MulAut W)) (r t c : MulAut W)
    (hP : P = closure ({r,t} : Set (MulAut W)))
    (hQ : Q = closure ({r,c} : Set (MulAut W)))
    (hrne : r ≠ 1) (hr2 : r^2 = 1) (ht3 : t^3 = 1)
    (htfixed : ∀ w, t w = w → w = 1)
    (hcomm : Commute r (t*r*t⁻¹))
    (hnorm : r*(t*r*t⁻¹)*((t^2)*r*(t^2)⁻¹) = 1)
    (hc3 : c^3 = 1) (hrc : (r*c)^3 = 1)
    (hfixed : Nat.card {w : W // r w = w ∧ c w = w} = 2) :
    Nonempty ((P ⊔ Q : Subgroup (MulAut W)) ≃* alternatingGroup (Fin 6)) :=
  (canonical_model_of_join hcard P Q r t c hP hQ hrne hr2 ht3 htfixed hcomm hnorm
    hc3 hrc hfixed).recognition

end BinaryA4Pair
