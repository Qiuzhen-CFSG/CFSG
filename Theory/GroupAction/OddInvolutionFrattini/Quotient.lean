module

public import Theory.GroupAction.OddInvolutionFrattini

/-!
# An involutory actor on a quotient Frattini layer

If a normal subgroup K is generated by its commutators with an elementary
2-subgroup V, and the image of V modulo a normal subgroup N has order two,
a lift of its nonidentity element inverts K/(K ∩ N) modulo Frattini whenever
this quotient is a p-group. The commutator generators are inverted; the
Frattini quotient is abelian. The first isomorphism theorem then transports
the conclusion through the literal quotient of K by `N.subgroupOf K`.

This supplies the inversion step in Aschbacher--Smith, E.2.17, printed p.229,
without an additional irreducibility premise.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace OddInvolutionFrattini

/-- Full commutator generation makes an involution invert the Frattini quotient. -/
theorem inverts_frattini_of_full_commutator
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (R : Subgroup G) [R.Normal] (hR : IsPGroup p R)
    (t : G) (ht : t ≠ 1 ∧ t ^ 2 = 1) (hc : ⁅R, zpowers t⁆ = R) (r : R) :
    (MulAut.conjNormal t : MulAut R) r * r ∈ frattini R := by
  let C := OddInvolutionFrattini.R R t
  have hC : C = R := hc
  let e : C ≃* R := MulEquiv.subgroupCongr hC
  let x : C := e.symm r
  let A := zpowers t
  have hn : A ≤ normalizer (R : Set G) := le_normalizer_of_normal
  let f := OddInvolutionFrattini.conjugation A C
    (OddInvolutionFrattini.normalizes_R R A hn (mem_zpowers t)) ⟨t, mem_zpowers t⟩
  have hi := OddInvolutionFrattini.inverts_frattini_quotient R A hR hn
    (mem_zpowers t) ht (QuotientGroup.mk' (frattini C) x)
  rw [OddInvolutionFrattini.quotientConjugation_mk] at hi
  have hm : f x * x ∈ frattini C := by
    apply (QuotientGroup.eq_one_iff _).mp
    change QuotientGroup.mk' (frattini C) (f x * x) = 1
    rw [map_mul]
    rw [show QuotientGroup.mk' (frattini C) (f x) =
      (QuotientGroup.mk' (frattini C) x)⁻¹ from hi]
    exact inv_mul_cancel _
  have he := frattini_le_comap_frattini_of_surjective (φ := e.toMonoidHom) e.surjective hm
  change e (f x * x) ∈ frattini R at he
  convert he using 1
  apply Subtype.ext
  simp only [MulEquiv.map_mul, coe_mul, MulAut.conjNormal_apply]
  rfl

/-- A two-element actor image supplies inversion on the literal quotient of K. -/
theorem exists_frattini_inverter
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (K N V : Subgroup G) [K.Normal] [N.Normal] [IsElementaryAbelian 2 V]
    (hK : K = ⁅K,V⁆)
    (hV : Nat.card (V.map (QuotientGroup.mk' N)) = 2)
    (hP : IsPGroup p (K.map (QuotientGroup.mk' N))) :
    ∃ v ∈ V, ∀ k : K, (MulAut.conjNormal v : MulAut K) k * k ∈
      (frattini (K ⧸ N.subgroupOf K)).comap (QuotientGroup.mk' (N.subgroupOf K)) := by
  let q := QuotientGroup.mk' N
  let R := K.map q
  let : R.Normal := (inferInstance : K.Normal).map q (QuotientGroup.mk'_surjective N)
  obtain ⟨t, ht, hall⟩ := (Nat.card_eq_two_iff' (1 : V.map q)).mp hV
  obtain ⟨v, hv, he⟩ := t.property
  have hne : q v ≠ 1 := fun h => ht (Subtype.ext (he.symm.trans h))
  have hVgen : V.map q = zpowers (q v) := by
    apply le_antisymm
    · intro y hy
      by_cases hy1 : y = 1
      · exact hy1 ▸ one_mem _
      have hyt := congrArg Subtype.val (hall ⟨y,hy⟩ (fun h => hy1 (congrArg Subtype.val h)))
      change y = (t : G ⧸ N) at hyt
      rw [hyt, ← he]
      exact mem_zpowers _
    · exact zpowers_le.mpr (mem_map_of_mem q hv)
  have hcomm : ⁅R, zpowers (q v)⁆ = R := by
    rw [← hVgen, ← map_commutator, ← hK]
  have hv2 : (q v) ^ 2 = 1 := by
    rw [← map_pow, elemPow_eq_one_of_isElementaryAbelian v hv, map_one]
  let f : K →* R := q.subgroupMap K
  have hker : f.ker = N.subgroupOf K := by
    ext k
    change (f k = 1) ↔ (k : G) ∈ N
    rw [Subtype.ext_iff]
    exact QuotientGroup.eq_one_iff _
  let e : K ⧸ N.subgroupOf K ≃* R :=
    (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective f (q.subgroupMap_surjective K))
  have heq (k : K) : e (QuotientGroup.mk' (N.subgroupOf K) k) = f k := rfl
  refine ⟨v, hv, fun k => ?_⟩
  have hi := inverts_frattini_of_full_commutator R hP (q v) ⟨hne,hv2⟩ hcomm (f k)
  have hePhi := frattini_le_comap_frattini_of_surjective
    (φ := e.symm.toMonoidHom) e.symm.surjective hi
  change e.symm ((MulAut.conjNormal (q v) : MulAut R) (f k) * f k) ∈ frattini (K ⧸ N.subgroupOf K) at hePhi
  change QuotientGroup.mk' (N.subgroupOf K) ((MulAut.conjNormal v : MulAut K) k * k) ∈ frattini (K ⧸ N.subgroupOf K)
  convert hePhi using 1
  apply e.injective
  rw [heq, e.apply_symm_apply]
  apply Subtype.ext
  change q (v * (k : G) * v⁻¹ * k) = q v * q k * (q v)⁻¹ * q k
  simp only [map_mul, map_inv]

end OddInvolutionFrattini
