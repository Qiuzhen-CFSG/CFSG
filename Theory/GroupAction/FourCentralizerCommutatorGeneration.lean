module

public import Theory.GroupAction.KleinFourCardinality
public import Theory.GroupTheory.PResidualCommutator
public import Theory.ElementaryAbelian.Basic

/-!
# Four-centralizer generation of coprime commutators

Let H have odd order and let an involution t normalize H. Put K = [H,t].
If an elementary four-subgroup W normalizes K and centralizes t, then
K is generated by [C_K(w),t] for the three nonidentity elements w of W.
In particular, W need not normalize H. All commutators and centralizers
in the exports are taken in the original ambient group.

Write i(J,t) for the number of elements of J inverted by t. Applying the
Brauer–Wielandt formula to J and C_J(t), and cancelling their fixed factors,
gives

  i(J,t) * i(C_J(a) ∩ C_J(b),t)^2
    = i(C_J(a),t) * i(C_J(b),t) * i(C_J(ab),t).

The proposed generated subgroup L is invariant under W and t. An inverted
element x of an odd subgroup belongs to its t-commutator, since x² = [x,t]
and x is a power of x². Thus L and K have the same inverted elements in
each of the three fixed subgroups, including their common intersection.
The displayed formula forces i(L,t) = i(K,t), so L contains every inverted
element of K. These include the generators of [K,t]. Finally, coprime
commutator idempotence proves [K,t] = K for K = [H,t].

Source: GLS, Volume 4, Chapter 2, Lemma 16.1
(`refs/KGroup/GLS4/Chapter2.tex`). This counting proof avoids the extra
property (C_p) in the proper-D case of the cited GLS II Lemma 11.25
(`refs/KGroup/GLS2/ChapterC.tex`). Fixed-point generation alone does not
justify distributing commutators over a join. No solvability or odd-order
theorem is used, and t may belong to W: the actor generated by W and t
may have order four or eight.
-/

open Subgroup
open scoped commutatorElement
namespace Subgroup
variable {G : Type*} [Group G]

private abbrev centralizerIn (H : Subgroup G) (a : G) : Subgroup G :=
  H ⊓ centralizer ({a} : Set G)
private def invertedElements (H : Subgroup G) (t : G) : Set G :=
  {x | x ∈ H ∧ t * x * t⁻¹ = x⁻¹}
private noncomputable def invertedCard (H : Subgroup G) (t : G) : ℕ := Nat.card (invertedElements H t)

private theorem conj_fixed_iff (t x : G) :
    t * x * t⁻¹ = x ↔ x ∈ centralizer ({t} : Set G) := by
  rw [mem_centralizer_singleton_iff]
  rw [mul_inv_eq_iff_eq_mul]
  exact eq_comm

private def conjAut (H : Subgroup G) (a : G) (ha : a ∈ normalizer H) : MulAut H :=
  H.normalizerMonoidHom ⟨a, ha⟩

private theorem conjAut_coe (H : Subgroup G) (a : G) (ha : a ∈ normalizer H) (x : H) :
    (conjAut H a ha x : G) = a * x * a⁻¹ := rfl

private theorem mem_conjAut_fixed (H : Subgroup G) (a : G)
    (ha : a ∈ normalizer H) (x : H) :
    x ∈ (conjAut H a ha).fixedSubgroup ↔ (x : G) ∈ centralizer ({a} : Set G) := by
  rw [MulAut.mem_fixedSubgroup, Subtype.ext_iff]
  exact conj_fixed_iff a x

private theorem conjAut_involutive (H : Subgroup G) (a : G) (ha : a ∈ normalizer H)
    (ha2 : a^2=1) : Function.Involutive (conjAut H a ha) := by
  intro x
  apply Subtype.ext
  simp only [conjAut_coe]
  have haa : a*a=1 := by simpa only [pow_two] using ha2
  calc
    a * (a * (x:G) * a⁻¹) * a⁻¹ = (a*a) * (x:G) * (a*a)⁻¹ := by group
    _ = (x:G) := by rw [haa]; simp

private theorem conjAut_commute (H : Subgroup G) (a b : G)
    (ha : a ∈ normalizer H) (hb : b ∈ normalizer H) (hab : Commute a b) :
    Commute (conjAut H a ha) (conjAut H b hb) := by
  apply MulEquiv.ext
  intro x
  apply Subtype.ext
  change a*(b*(x:G)*b⁻¹)*a⁻¹=b*(a*(x:G)*a⁻¹)*b⁻¹
  calc
    _ = (a*b)*(x:G)*(a*b)⁻¹ := by group
    _ = (b*a)*(x:G)*(b*a)⁻¹ := by rw [hab.eq]
    _ = _ := by group

private theorem card_conjAut_fixed (H : Subgroup G) (a : G) (ha : a ∈ normalizer H) :
    Nat.card (conjAut H a ha).fixedSubgroup = Nat.card (centralizerIn H a) := by
  apply Nat.card_congr
  exact {
    toFun := fun x => ⟨x.val.val, x.val.property,
      (mem_conjAut_fixed H a ha x.val).mp x.property⟩
    invFun := fun x => ⟨⟨x.val,x.property.1⟩,
      (mem_conjAut_fixed H a ha _).mpr x.property.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }

private theorem card_conjAut_common_fixed (H : Subgroup G) (a b : G)
    (ha : a ∈ normalizer H) (hb : b ∈ normalizer H) :
    Nat.card ((conjAut H a ha).fixedSubgroup ⊓ (conjAut H b hb).fixedSubgroup : Subgroup H) =
      Nat.card (centralizerIn (centralizerIn H a) b) := by
  apply Nat.card_congr
  exact {
    toFun := fun x => ⟨x.val.val, ⟨x.val.property,
      (mem_conjAut_fixed H a ha x.val).mp x.property.1⟩,
      (mem_conjAut_fixed H b hb x.val).mp x.property.2⟩
    invFun := fun x => ⟨⟨x.val,x.property.1.1⟩,
      (mem_conjAut_fixed H a ha _).mpr x.property.1.2,
      (mem_conjAut_fixed H b hb _).mpr x.property.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }

private theorem centralizer_card_brauerWielandt [Finite G] (H : Subgroup G) (hodd : Odd (Nat.card H))
    (a b : G) (ha : a ∈ normalizer H) (hb : b ∈ normalizer H)
    (ha2 : a^2=1) (hb2 : b^2=1) (hab : Commute a b) :
    Nat.card H * Nat.card (centralizerIn (centralizerIn H a) b)^2 =
      Nat.card (centralizerIn H a) * Nat.card (centralizerIn H b) * Nat.card (centralizerIn H (a*b)) := by
  have he : conjAut H a ha * conjAut H b hb = conjAut H (a*b) ((normalizer (H : Set G)).mul_mem ha hb) := by
    exact (H.normalizerMonoidHom.map_mul ⟨a,ha⟩ ⟨b,hb⟩).symm
  have h := Theory.GroupAction.brauerWielandt_fixedSubgroup_card hodd
    (conjAut H a ha) (conjAut H b hb) (conjAut_involutive H a ha ha2)
    (conjAut_involutive H b hb hb2) (conjAut_commute H a b ha hb hab)
  rwa [he, card_conjAut_fixed, card_conjAut_fixed, card_conjAut_fixed, card_conjAut_common_fixed] at h

private theorem card_fixed_mul_inverted [Finite G] (H : Subgroup G) (hodd : Odd (Nat.card H))
    (t : G) (ht : t ∈ normalizer H) (ht2 : t^2=1) :
    Nat.card H = Nat.card (centralizerIn H t) * invertedCard H t := by
  let f : centralizerIn H t × invertedElements H t → H := fun p =>
    ⟨p.1.val*p.2.val, H.mul_mem p.1.property.1 p.2.property.1⟩
  have hf : Function.Bijective f := by
    constructor
    · rintro ⟨u,v⟩ ⟨u',v'⟩ he
      obtain ⟨p, _, hu⟩ := Theory.GroupTheory.existsUnique_fixed_inverted_mul_of_odd_card
        hodd (conjAut H t ht) (conjAut_involutive H t ht ht2) (f (u,v))
      have hp (c : centralizerIn H t) (i : invertedElements H t) :
          conjAut H t ht ⟨c.val,c.property.1⟩ = ⟨c.val,c.property.1⟩ ∧
          conjAut H t ht ⟨i.val,i.property.1⟩ = (⟨i.val,i.property.1⟩ : H)⁻¹ :=
        ⟨Subtype.ext ((conj_fixed_iff t c.val).mpr c.property.2), Subtype.ext i.property.2⟩
      have h1 := hu (⟨u.val,u.property.1⟩,⟨v.val,v.property.1⟩) ⟨(hp u v).1,(hp u v).2,rfl⟩
      have h2 := hu (⟨u'.val,u'.property.1⟩,⟨v'.val,v'.property.1⟩)
        ⟨(hp u' v').1,(hp u' v').2,he.symm⟩
      have hh := h1.trans h2.symm
      exact Prod.ext (Subtype.ext (congrArg (fun z : H × H => (z.1:G)) hh))
        (Subtype.ext (congrArg (fun z : H × H => (z.2:G)) hh))
    · intro x
      obtain ⟨⟨u,v⟩,⟨hu,hv,he⟩,_⟩ :=
        Theory.GroupTheory.existsUnique_fixed_inverted_mul_of_odd_card hodd
          (conjAut H t ht) (conjAut_involutive H t ht ht2) x
      exact ⟨(⟨u,u.property,(conj_fixed_iff t u).mp (congrArg Subtype.val hu)⟩,
        ⟨v,v.property,congrArg Subtype.val hv⟩),he⟩
  exact (Nat.card_eq_of_bijective f hf).symm.trans (Nat.card_prod _ _)

private theorem normalizes_centralizerIn (H : Subgroup G) (t a : G)
    (ht : t ∈ normalizer H) (hta : Commute t a) : t ∈ normalizer (centralizerIn H a) := by
  apply inf_normalizer_le_normalizer_inf
  exact ⟨ht, (centralizer ({a}:Set G)).le_normalizer
    (mem_centralizer_singleton_iff.mpr hta.eq)⟩

private theorem centralizerIn_swap (H : Subgroup G) (a b : G) : centralizerIn (centralizerIn H a) b = centralizerIn (centralizerIn H b) a := by
  exact inf_right_comm _ _ _

private theorem invertedCard_pos [Finite G] (H : Subgroup G) (t : G) : 0 < invertedCard H t := by
  let _ : Nonempty (invertedElements H t) := ⟨⟨1,H.one_mem,by simp⟩⟩
  exact Nat.card_pos

private theorem invertedCard_brauerWielandt [Finite G] (H : Subgroup G) (hodd : Odd (Nat.card H))
    (t a b : G) (ht : t ∈ normalizer H)
    (ha : a ∈ normalizer H) (hb : b ∈ normalizer H)
    (ht2 : t^2=1) (ha2 : a^2=1) (hb2 : b^2=1)
    (hta : Commute t a) (htb : Commute t b) (hab : Commute a b) :
    invertedCard H t * invertedCard (centralizerIn (centralizerIn H a) b) t ^ 2 =
      invertedCard (centralizerIn H a) t * invertedCard (centralizerIn H b) t * invertedCard (centralizerIn H (a*b)) t := by
  have hc := centralizer_card_brauerWielandt H hodd a b ha hb ha2 hb2 hab
  have hf := centralizer_card_brauerWielandt (centralizerIn H t) (hodd.of_dvd_nat (card_dvd_of_le inf_le_left))
    a b (normalizes_centralizerIn H a t ha hta.symm) (normalizes_centralizerIn H b t hb htb.symm) ha2 hb2 hab
  rw [centralizerIn_swap H t a, centralizerIn_swap H t b, centralizerIn_swap H t (a*b),
    centralizerIn_swap (centralizerIn H a) t b] at hf
  have hodd' (L : Subgroup G) (hL : L ≤ H) : Odd (Nat.card L) :=
    hodd.of_dvd_nat (card_dvd_of_le hL)
  rw [card_fixed_mul_inverted H hodd t ht ht2,
    card_fixed_mul_inverted (centralizerIn (centralizerIn H a) b) (hodd' _ (inf_le_left.trans inf_le_left)) t
      (normalizes_centralizerIn _ t b (normalizes_centralizerIn H t a ht hta) htb) ht2,
    card_fixed_mul_inverted (centralizerIn H a) (hodd' _ inf_le_left) t (normalizes_centralizerIn H t a ht hta) ht2,
    card_fixed_mul_inverted (centralizerIn H b) (hodd' _ inf_le_left) t (normalizes_centralizerIn H t b ht htb) ht2,
    card_fixed_mul_inverted (centralizerIn H (a*b)) (hodd' _ inf_le_left) t
      (normalizes_centralizerIn H t (a*b) ht (hta.mul_right htb)) ht2] at hc
  apply Nat.mul_left_cancel (n := Nat.card (centralizerIn H t) * Nat.card (centralizerIn (centralizerIn (centralizerIn H a) b) t)^2)
    (Nat.mul_pos Nat.card_pos (pow_pos Nat.card_pos 2))
  calc
    _ = (Nat.card (centralizerIn H t) * invertedCard H t) *
        (Nat.card (centralizerIn (centralizerIn (centralizerIn H a) b) t) * invertedCard (centralizerIn (centralizerIn H a) b) t)^2 := by ring
    _ = _ := hc
    _ = (Nat.card (centralizerIn (centralizerIn H a) t) * Nat.card (centralizerIn (centralizerIn H b) t) *
        Nat.card (centralizerIn (centralizerIn H (a*b)) t)) *
        (invertedCard (centralizerIn H a) t * invertedCard (centralizerIn H b) t * invertedCard (centralizerIn H (a*b)) t) := by ring
    _ = _ := by rw [hf]

private theorem inverted_mem_commutator [Finite G] (H : Subgroup G)
    (hodd : Odd (Nat.card H)) (t x : G) (hx : x ∈ invertedElements H t) :
    x ∈ ⁅H, zpowers t⁆ := by
  have hsq : x^2 ∈ ⁅H, zpowers t⁆ := by
    have he : ⁅x,t⁆ = x^2 := by
      calc
        ⁅x,t⁆ = x * (t*x*t⁻¹)⁻¹ := by
          simp [commutatorElement_def, mul_assoc]
        _ = x^2 := by rw [hx.2, inv_inv, pow_two]
    rw [← he]
    exact commutator_mem_commutator hx.1 (mem_zpowers t)
  have hxo : Odd (orderOf x) := hodd.of_dvd_nat (H.orderOf_dvd_natCard hx.1)
  obtain ⟨n, hn⟩ := exists_pow_eq_pow_two_mul (pow_orderOf_eq_one x) hxo 1
  rw [pow_one, pow_mul] at hn
  rw [hn]
  exact pow_mem hsq n

private theorem normalizes_commutator (H J : Subgroup G) (a : G)
    (hH : a ∈ normalizer H) (hJ : a ∈ normalizer J) :
    a ∈ normalizer (⁅H,J⁆ : Subgroup G) := by
  rw [mem_normalizer_iff_map_conj_eq, map_commutator,
    mem_normalizer_iff_map_conj_eq.mp hH, mem_normalizer_iff_map_conj_eq.mp hJ]

private theorem normalizes_zpowers_of_commute (a t : G) (ha : Commute a t) :
    a ∈ normalizer (zpowers t : Set G) := by
  apply centralizer_le_normalizer (zpowers t : Set G)
  rw [zpowers_eq_closure, centralizer_closure, mem_centralizer_singleton_iff]
  exact ha.eq

private theorem commutator_le_of_inverted_subset [Finite G]
    (H L : Subgroup G) (t : G) (ht : orderOf t = 2)
    (htH : t ∈ normalizer H) (hI : invertedElements H t ⊆ L) :
    ⁅H,zpowers t⁆ ≤ L := by
  classical
  rw [commutator_le]
  intro x hx s hs
  rw [mem_zpowers_iff_mem_range_orderOf, ht] at hs
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hs
  have hnlt := Finset.mem_range.mp hn
  interval_cases n
  · simp
  · simp only [pow_one]
    apply hI
    constructor
    · exact le_normalizer_iff_commutator_le_left.mp (zpowers_le.mpr htH)
        (commutator_mem_commutator hx (mem_zpowers t))
    · have htt : t * t = 1 := by simpa [pow_two, ht] using pow_orderOf_eq_one t
      have hti : t⁻¹ = t := inv_eq_of_mul_eq_one_right htt
      simp only [commutatorElement_def, mul_inv_rev, inv_inv, hti,
        mul_assoc, htt, mul_one]

/-- An odd subgroup generated by its commutators with t is generated by the
commutators with t of the three fixed subgroups of a commuting four-group. -/
public theorem eq_iSup_centralizer_commutators_of_four [Finite G]
    (K : Subgroup G) (hodd : Odd (Nat.card K))
    (t : G) (ht : orderOf t = 2) (htK : t ∈ normalizer K)
    (hgen : ⁅K,zpowers t⁆ = K)
    (W : Subgroup G) [IsElementaryAbelian 2 W] (hWcard : Nat.card W = 4)
    (hWK : W ≤ normalizer K) (hWt : W ≤ centralizer ({t} : Set G)) :
    K = ⨆ (w : W) (_ : (w:G) ≠ 1), ⁅K ⊓ centralizer ({(w:G)} : Set G), zpowers t⁆ := by
  classical
  let L : Subgroup G := ⨆ (w : W) (_ : (w:G) ≠ 1), ⁅centralizerIn K w, zpowers t⁆
  have hLK : L ≤ K := by
    refine iSup_le fun w => iSup_le fun _ => ?_
    exact (commutator_mono inf_le_left le_rfl).trans hgen.le
  have hLodd : Odd (Nat.card L) := hodd.of_dvd_nat (card_dvd_of_le hLK)
  have ht2 : t^2=1 := ht ▸ pow_orderOf_eq_one t
  have hcomm (w : W) : Commute t (w:G) :=
    (mem_centralizer_singleton_iff.mp (hWt w.property)).symm
  have hcommW (a b : W) : Commute (a:G) (b:G) := by
    exact congrArg Subtype.val (mul_comm' a b)
  have hpow (w : W) : (w:G)^2=1 := by
    exact congrArg Subtype.val (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 W) w)
  have htL : t ∈ normalizer L := by
    apply iInf_normalizer_le_normalizer_iSup
    rw [mem_iInf]
    intro w
    apply iInf_normalizer_le_normalizer_iSup
    rw [mem_iInf]
    intro _
    exact normalizer_commutator_ge_right _ _ (mem_zpowers t)
  have hWL : W ≤ normalizer L := by
    intro a ha
    apply iInf_normalizer_le_normalizer_iSup
    rw [mem_iInf]
    intro w
    apply iInf_normalizer_le_normalizer_iSup
    rw [mem_iInf]
    intro _
    apply normalizes_commutator
    · exact normalizes_centralizerIn K a w (hWK ha) (hcommW ⟨a,ha⟩ w)
    · exact normalizes_zpowers_of_commute a t (hcomm ⟨a,ha⟩).symm
  have hfixed (w : W) (hw : (w:G) ≠ 1) :
      invertedElements (centralizerIn L w) t = invertedElements (centralizerIn K w) t := by
    ext x
    constructor
    · rintro ⟨⟨hxL,hxc⟩,hxi⟩
      exact ⟨⟨hLK hxL,hxc⟩,hxi⟩
    · rintro ⟨⟨hxK,hxc⟩,hxi⟩
      refine ⟨⟨?_,hxc⟩,hxi⟩
      apply (show ⁅centralizerIn K w, zpowers t⁆ ≤ L from
        le_iSup_of_le w (le_iSup_of_le hw le_rfl))
      exact inverted_mem_commutator (centralizerIn K w)
        (hodd.of_dvd_nat (card_dvd_of_le inf_le_left)) t x ⟨⟨hxK,hxc⟩,hxi⟩
  let _ : Nontrivial W := Finite.one_lt_card_iff_nontrivial.mp (by rw [hWcard]; decide)
  obtain ⟨a, ha⟩ := exists_ne (1 : W)
  have hpair : ({1,a} : Set W).ncard < (Set.univ : Set W).ncard := by
    rw [Set.ncard_univ,hWcard,Set.ncard_pair (Ne.symm ha)]
    decide
  obtain ⟨b, _, hb⟩ := Set.exists_mem_notMem_of_ncard_lt_ncard hpair
  have hb1 : b ≠ 1 := by intro h; exact hb (by simp [h])
  have hba : b ≠ a := by intro h; exact hb (by simp [h])
  have hab1 : a*b ≠ 1 := by
    intro h
    apply hba
    exact (eq_inv_of_mul_eq_one_right h).trans (inv_eq_of_mul_eq_one_right
      (by apply Subtype.ext; simpa [pow_two] using hpow a))
  have hva : (a:G) ≠ 1 := fun h => ha (Subtype.ext h)
  have hvb : (b:G) ≠ 1 := fun h => hb1 (Subtype.ext h)
  have hvab : ((a*b:W):G) ≠ 1 := fun h => hab1 (Subtype.ext h)
  have hcommon : invertedElements (centralizerIn (centralizerIn L a) b) t =
      invertedElements (centralizerIn (centralizerIn K a) b) t := by
    ext x
    have he := Set.ext_iff.mp (hfixed a hva) x
    change ((x ∈ L ∧ x ∈ centralizer ({(a:G)} : Set G)) ∧
      x ∈ centralizer ({(b:G)} : Set G)) ∧ t*x*t⁻¹=x⁻¹ ↔
      ((x ∈ K ∧ x ∈ centralizer ({(a:G)} : Set G)) ∧
      x ∈ centralizer ({(b:G)} : Set G)) ∧ t*x*t⁻¹=x⁻¹
    change ((x ∈ L ∧ _) ∧ _) ↔ ((x ∈ K ∧ _) ∧ _) at he
    tauto
  have hnK := invertedCard_brauerWielandt K hodd t a b htK (hWK a.property) (hWK b.property)
    ht2 (hpow a) (hpow b) (hcomm a) (hcomm b) (hcommW a b)
  have hnL := invertedCard_brauerWielandt L hLodd t a b htL (hWL a.property) (hWL b.property)
    ht2 (hpow a) (hpow b) (hcomm a) (hcomm b) (hcommW a b)
  have hfixed_ab : invertedElements (centralizerIn L ((a:G)*(b:G))) t =
      invertedElements (centralizerIn K ((a:G)*(b:G))) t :=
    hfixed (a*b) hvab
  have hn : invertedCard L t = invertedCard K t := by
    apply Nat.eq_of_mul_eq_mul_right (pow_pos (invertedCard_pos (centralizerIn (centralizerIn K a) b) t) 2)
    dsimp only [invertedCard] at hnK hnL ⊢
    rw [hcommon, hfixed a hva, hfixed b hvb, hfixed_ab] at hnL
    exact hnL.trans hnK.symm
  have hI : invertedElements L t = invertedElements K t :=
    Set.Finite.eq_of_subset_of_card_le (Set.toFinite _)
      (fun _ hx => ⟨hLK hx.1,hx.2⟩) hn.symm.le
  have hIL : invertedElements K t ⊆ L := by
    rw [← hI]
    exact fun _ hx => hx.1
  exact le_antisymm (hgen.symm.le.trans (commutator_le_of_inverted_subset K L t ht htK hIL)) hLK

/-- Four-centralizer generation for K = [H,t], with W required to normalize
only K. Coprime idempotence discharges [K,t] = K from the odd-order input. -/
public theorem commutator_eq_iSup_centralizer_commutators_of_four [Finite G]
    (H : Subgroup G) (hodd : Odd (Nat.card H))
    (t : G) (ht : orderOf t = 2) (htH : t ∈ normalizer H)
    (W : Subgroup G) [IsElementaryAbelian 2 W] (hWcard : Nat.card W = 4)
    (hWK : W ≤ normalizer (⁅H,zpowers t⁆ : Subgroup G))
    (hWt : W ≤ centralizer ({t} : Set G)) :
    let K := ⁅H,zpowers t⁆
    K = ⨆ (w : W) (_ : (w:G) ≠ 1), ⁅K ⊓ centralizer ({(w:G)} : Set G), zpowers t⁆ := by
  let K := ⁅H,zpowers t⁆
  have hKH : K ≤ H := le_normalizer_iff_commutator_le_left.mp (zpowers_le.mpr htH)
  have hid : ⁅K,zpowers t⁆ = K := by
    dsimp only [K]
    rw [zpowers_eq_closure]
    apply commutator_closure_coprime_idempotent
    · rw [← zpowers_eq_closure]
      exact zpowers_le.mpr htH
    · intro a ha
      have he : a = t := Set.mem_singleton_iff.mp ha
      subst a
      rw [ht]
      exact hodd.coprime_two_left
  exact eq_iSup_centralizer_commutators_of_four K (hodd.of_dvd_nat (card_dvd_of_le hKH)) t ht
    (normalizer_commutator_ge_right H (zpowers t) (mem_zpowers t)) hid W hWcard hWK hWt

end Subgroup
