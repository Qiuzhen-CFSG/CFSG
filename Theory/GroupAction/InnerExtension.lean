module

public import Theory.GroupAction.AutomorphismFixedTransport

/-!
# Inner extensions of an automorphism action

For an action `ρ : A → Aut(G)`, the inner extension is the subgroup generated
by `Inn(G)` and the actual image of `ρ`. A group isomorphism transports this
whole extension by conjugating automorphisms. The resulting equivalence
preserves evaluation on every element of the component.

The proof maps the two generating subgroups separately, using compatibility
of automorphism transport with inner conjugation. This supplies the marked
extension used in Aschbacher–Smith 15.4.18, printed pp.1162–1163.
-/

@[expose] public section

namespace MulAut
variable {G H A : Type*} [Group G] [Group H] [Group A]

/-- The subgroup generated by inner automorphisms and an actual action. -/
def innerExtension (ρ : A →* MulAut G) : Subgroup (MulAut G) :=
  (MulAut.conj : G →* MulAut G).range ⊔ ρ.range

theorem conj_mem_innerExtension (ρ : A →* MulAut G) (g : G) :
    MulAut.conj g ∈ innerExtension ρ :=
  (show (MulAut.conj : G →* MulAut G).range ≤ innerExtension ρ from le_sup_left) ⟨g, rfl⟩

theorem action_mem_innerExtension (ρ : A →* MulAut G) (a : A) :
    ρ a ∈ innerExtension ρ :=
  (show ρ.range ≤ innerExtension ρ from le_sup_right) ⟨a, rfl⟩

theorem map_innerExtension (e : G ≃* H) (ρ : A →* MulAut G) :
    (innerExtension ρ).map (MulAut.congr e).toMonoidHom =
      innerExtension ((MulAut.congr e).toMonoidHom.comp ρ) := by
  simp only [innerExtension, Subgroup.map_sup, MonoidHom.map_range]
  congr 1
  ext β
  constructor
  · rintro ⟨g, rfl⟩
    exact ⟨e g, (congr_conj e g).symm⟩
  · rintro ⟨h, rfl⟩
    refine ⟨e.symm h, ?_⟩
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, congr_conj,
      e.apply_symm_apply]

/-- Transport the whole inner extension, retaining its literal automorphisms. -/
noncomputable def innerExtensionCongr (e : G ≃* H) (ρ : A →* MulAut G) :
    innerExtension ρ ≃* innerExtension ((MulAut.congr e).toMonoidHom.comp ρ) :=
  ((innerExtension ρ).equivMapOfInjective (MulAut.congr e).toMonoidHom
    (MulAut.congr e).injective).trans (MulEquiv.subgroupCongr (map_innerExtension e ρ))

theorem innerExtensionCongr_apply (e : G ≃* H) (ρ : A →* MulAut G)
    (g : innerExtension ρ) :
    (innerExtensionCongr e ρ g : MulAut H) = MulAut.congr e (g : MulAut G) := rfl

theorem innerExtensionCongr_apply_action (e : G ≃* H) (ρ : A →* MulAut G)
    (g : innerExtension ρ) (x : G) :
    (innerExtensionCongr e ρ g : MulAut H) (e x) = e (g.val x) := by
  change e (g.val (e.symm (e x))) = _
  rw [e.symm_apply_apply]

end MulAut
