module
public import Theory.GroupAction.AbelianCoprimeFixedGeneration
public import Theory.GroupTheory.NormalizedSupCard

/-!
# Elementary cubic structure from rank-three binary fixed groups

Let an elementary abelian group A of order eight act on a finite 3-group F.
If the fixed subgroup of every nonidentity actor is elementary abelian of
exponent three, then F is elementary abelian of exponent three. The theorem
uses the supplied action throughout and does not require it to be faithful.

Coprime abelian fixed-point generation expresses F as the group generated by
fixed subgroups for actor subgroups with cyclic quotient. Such actor subgroups
have order at least four, since their quotient is cyclic of exponent at most
two. Any two therefore intersect nontrivially. Their fixed groups lie in a
common assumed elementary cubic fixed subgroup, so all generators commute
and have exponent three. These properties pass to the generated group.

This is the source-neutral elementary conclusion in Stellmacher (8.6)(21),
Journal of Algebra 190 (1997), printed p.45. The graph application separately
supplies the rank-three actor, the 3-group, and the centralizer hypotheses
from (20). The further claim there that each nontrivial index-two fixed group
has order three is not part of this result.
-/

open scoped IsMulCommutative

private theorem cyclic_quotient_card_lower
    {A : Type*} [Group A] [Finite A] [IsElementaryAbelian 2 A]
    (hcard : Nat.card A = 8) (Y : Subgroup A) [Y.Normal]
    (hcyc : IsCyclic (A ⧸ Y)) : 4 ≤ Nat.card Y := by
  have hdiv : Nat.card (A ⧸ Y) ∣ 2 := by
    rw [← hcyc.exponent_eq_card]
    exact (Group.exponent_quotient_dvd Y).trans
      (IsElementaryAbelian.exponent_dvd_p 2 A)
  have hbound : Nat.card (A ⧸ Y) ≤ 2 := Nat.le_of_dvd (by decide) hdiv
  have hproduct := Subgroup.card_eq_card_quotient_mul_card_subgroup Y
  rw [hcard] at hproduct
  nlinarith

private theorem cyclic_quotient_intersection_ne_bot
    {A : Type*} [Group A] [Finite A] [IsElementaryAbelian 2 A]
    (hcard : Nat.card A = 8) (Y Z : Subgroup A)
    (hY : IsCyclic (A ⧸ Y)) (hZ : IsCyclic (A ⧸ Z)) : Y ⊓ Z ≠ ⊥ := by
  have hYcard := cyclic_quotient_card_lower hcard Y hY
  have hZcard := cyclic_quotient_card_lower hcard Z hZ
  have hprod := Subgroup.card_mul_eq_card_inf_mul_card_sup_of_normalizes Y Z
    (by rw [Subgroup.normalizer_eq_top]; exact le_top)
  have hsup : Nat.card (Y ⊔ Z : Subgroup A) ≤ 8 := by
    simpa only [hcard] using Nat.card_le_card_of_injective
      (Y ⊔ Z : Subgroup A).subtype (Y ⊔ Z : Subgroup A).subtype_injective
  intro heq
  rw [heq, Subgroup.card_bot, one_mul] at hprod
  nlinarith

private theorem fixed_subgroup_le_cyclic_fixed
    {A F : Type*} [Group A] [Group F] [MulDistribMulAction A F]
    (Y : Subgroup A) (a : A) (ha : a ∈ Y) :
    FixedPoints.subgroup Y F ≤ FixedPoints.subgroup (Subgroup.zpowers a) F := by
  intro x hx z
  exact hx ⟨z, (Subgroup.zpowers_le.mpr ha) z.property⟩

/-- Rank-three binary actors with elementary cubic fixed groups force the whole
3-group to be elementary abelian. -/
public theorem elementary_three_of_rank_three_binary_fixed
    {A F : Type*} [Group A] [Finite A] [Group F] [Finite F]
    [IsElementaryAbelian 2 A] [MulDistribMulAction A F]
    (hcard : Nat.card A = 8) (hF : IsPGroup 3 F)
    (hfixed : ∀ a : A, a ≠ 1 →
      IsElementaryAbelian 3 (FixedPoints.subgroup (Subgroup.zpowers a) F)) :
    IsElementaryAbelian 3 F := by
  classical
  let _ : CommGroup A := IsMulCommutative.instCommGroup
  let _ : Fact (IsPGroup 3 F) := ⟨hF⟩
  have hcop : Nat.Coprime (Nat.card A) 3 := by rw [hcard]; decide
  have hgen := iSup_fixedPoints_cyclicQuot_eq_top_of_coprime_abelian_pGroup
    (G := F) (A := A) (q := 3) hcop
  let s : Set F := {x | ∃ Y : Subgroup A,
    IsCyclic (A ⧸ Y) ∧ x ∈ FixedPoints.subgroup Y F}
  have hstop : Subgroup.closure s = ⊤ := by
    apply top_unique
    rw [← hgen]
    refine iSup₂_le fun Y hY x hx => ?_
    exact Subgroup.subset_closure ⟨Y, hY, hx⟩
  have hcomm : ∀ x ∈ s, ∀ y ∈ s, x * y = y * x := by
    rintro x ⟨Y, hY, hx⟩ y ⟨Z, hZ, hy⟩
    obtain ⟨a, ha⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp
      (cyclic_quotient_intersection_ne_bot hcard Y Z hY hZ)
    have haone : (a : A) ≠ 1 := fun h => ha (Subtype.ext h)
    let _ := hfixed a haone
    have hxfix := fixed_subgroup_le_cyclic_fixed Y a a.property.1 hx
    have hyfix := fixed_subgroup_le_cyclic_fixed Z a a.property.2 hy
    exact congrArg Subtype.val
      (mul_comm (⟨x, hxfix⟩ : FixedPoints.subgroup (Subgroup.zpowers (a : A)) F)
        ⟨y, hyfix⟩)
  have hcommF : IsMulCommutative F := by
    have hclosure := Subgroup.isMulCommutative_closure hcomm
    rw [hstop] at hclosure
    let _ := hclosure
    exact ⟨⟨fun x y => congrArg Subtype.val
      (mul_comm (⟨x, Subgroup.mem_top x⟩ : (⊤ : Subgroup F)) ⟨y, Subgroup.mem_top y⟩)⟩⟩
  let _ := hcommF
  refine { exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
  intro x
  have hx : x ∈ Subgroup.closure s := by rw [hstop]; exact Subgroup.mem_top x
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
    obtain ⟨Y, hY, hy⟩ := hy
    obtain ⟨a, ha⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp
      (cyclic_quotient_intersection_ne_bot hcard Y Y hY hY)
    have haone : (a : A) ≠ 1 := fun h => ha (Subtype.ext h)
    let _ := hfixed a haone
    exact elemPow_eq_one_of_isElementaryAbelian y
      (fixed_subgroup_le_cyclic_fixed Y a a.property.1 hy)
  | one => simp
  | mul y z _ _ hy hz => rw [mul_pow, hy, hz, one_mul]
  | inv y _ hy => rw [inv_pow, hy, inv_one]
