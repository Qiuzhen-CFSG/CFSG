module

public import Mathlib.GroupTheory.Perm.Finite
public import Mathlib.GroupTheory.PGroup
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Centralizer sections from the action on fixed points

A permutation representation restricts the centralizer of `t` to the points
fixed by `t`. If the only elements acting trivially there are `1` and `t`,
the restriction kernel is exactly the cyclic group generated by `t`.
Identifying the image with another group gives a surjective homomorphism;
when `t` is an involution its kernel is a 2-group.

This is the elementary restriction-action argument used for the Fischer
centralizers in GLS, *The Classification of the Finite Simple Groups*,
volume 3, Table 5.3u. The concrete image identification and pointwise
stabilizer calculation are separate hypotheses, not established here.
-/

@[expose] public section

namespace Theory.GroupAction.CentralizerFixedPointSection
variable {G α S : Type*} [Group G] [Group S]
variable (ρ : G →* Equiv.Perm α) (t : G)
/-- The centralizer in the original group, not in the symmetric group. -/
abbrev Centralizer := Subgroup.centralizer ({t} : Set G)
/-- Points fixed by the image of the marked group element. -/
abbrev FixedPoints := {x : α // ρ t x = x}

/-- Centralizing elements preserve the fixed-point set. -/
theorem preserves (g : Centralizer t) (x : α) :
    ρ t (ρ g.val x) = ρ g.val x ↔ ρ t x = x := by
  apply Equiv.Perm.apply_mem_fixedPoints_iff_mem_of_mem_centralizer
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  rw [← map_mul, ← map_mul]
  exact congrArg ρ (Subgroup.mem_centralizer_singleton_iff.mp g.property)

/-- Restriction of the centralizer action to the fixed-point set. -/
def action : Centralizer t →* Equiv.Perm (FixedPoints ρ t) where
  toFun g := (ρ g.val).subtypePerm (preserves ρ t g)
  map_one' := by
    ext x
    change ρ 1 x.val = x.val
    rw [map_one]
    rfl
  map_mul' g h := by
    ext x
    exact congrArg (fun p : Equiv.Perm α => p x.val) (ρ.map_mul g.val h.val)

/-- The kernel is the pointwise stabilizer of the fixed-point set. -/
theorem mem_action_ker_iff (g : Centralizer t) :
    g ∈ (action ρ t).ker ↔ ∀ x : α, ρ t x = x → ρ g.val x = x := by
  change action ρ t g = 1 ↔ _
  constructor
  · intro h x hx
    exact congrArg (fun p : Equiv.Perm (FixedPoints ρ t) => (p ⟨x, hx⟩).val) h
  · intro h
    ext x
    exact h x.val x.property

/-- The marked element viewed inside its own centralizer. -/
def marked : Centralizer t := ⟨t, Subgroup.mem_centralizer_singleton_iff.mpr rfl⟩

/-- The marked element acts trivially on its own fixed points. -/
theorem marked_mem_ker : marked t ∈ (action ρ t).ker := by
  rw [mem_action_ker_iff]
  exact fun _ hx => hx

/-- A two-element pointwise-stabilizer bound identifies the whole kernel. -/
theorem ker_eq_zpowers
    (hr : ∀ g : Centralizer t, (∀ x : α, ρ t x = x → ρ g.val x = x) →
      g.val = 1 ∨ g.val = t) :
    (action ρ t).ker = Subgroup.zpowers (marked t) := by
  apply le_antisymm
  · intro g hg
    rcases hr g ((mem_action_ker_iff ρ t g).mp hg) with h | h
    · have he : g = 1 := Subtype.ext h
      rw [he]
      exact Subgroup.one_mem _
    · have he : g = marked t := Subtype.ext h
      rw [he]
      exact Subgroup.mem_zpowers _
  · exact Subgroup.zpowers_le.mpr (marked_mem_ker ρ t)

/-- Map onto a group identified with the restriction image. -/
def quotientMap (e : (action ρ t).range ≃* S) : Centralizer t →* S :=
  e.toMonoidHom.comp (action ρ t).rangeRestrict

/-- The image identification makes the restriction map surjective. -/
theorem quotientMap_surjective (e : (action ρ t).range ≃* S) :
    Function.Surjective (quotientMap ρ t e) :=
  e.surjective.comp (action ρ t).rangeRestrict_surjective

/-- The image identification preserves the restriction kernel. -/
theorem quotientMap_ker (e : (action ρ t).range ≃* S) :
    (quotientMap ρ t e).ker = (action ρ t).ker := by
  rw [quotientMap, MonoidHom.ker_comp_of_injective _ _ e.injective,
    MonoidHom.ker_rangeRestrict]

/-- For an involution, the two-element kernel bound gives a 2-group. -/
theorem quotientMap_ker_isPGroup (ht : orderOf t = 2)
    (hr : ∀ g : Centralizer t, (∀ x : α, ρ t x = x → ρ g.val x = x) →
      g.val = 1 ∨ g.val = t) (e : (action ρ t).range ≃* S) :
    IsPGroup 2 (quotientMap ρ t e).ker := by
  rw [quotientMap_ker]
  intro g
  refine ⟨1, ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  change g.val.val ^ (2 ^ 1) = 1
  rcases hr g.val ((mem_action_ker_iff ρ t g.val).mp g.property) with h | h
  · simp [h]
  · simpa [h, ht] using pow_orderOf_eq_one t
end Theory.GroupAction.CentralizerFixedPointSection
