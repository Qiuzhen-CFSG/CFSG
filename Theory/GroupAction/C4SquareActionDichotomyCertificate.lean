def entryOK (e : Entry) : Prop :=
  GoodBasis e.a e.b ∧
    (if e.hall then HallWitness e.m e.n e.p e.a e.b e.i e.j e.k
     else SplitWitness e.m e.n e.p e.a e.b e.i e.j e.k)

instance (e : Entry) : Decidable (entryOK e) := by
  unfold entryOK
  infer_instance

@[reducible] def entriesOK : Bool :=
  entries.all (fun e => decide (entryOK e))

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 100000000 in
theorem entriesOK_true : entriesOK = true := by
  decide

theorem certificate : ∀ (m n : Code) (p : OuterCode), Valid m n p → Witness m n p := by
  intro m n p hv
  have hpairs : pairCovered m n = true := innerCoverage m n p hv
  obtain ⟨q, hq, hmatch⟩ := List.any_eq_true.mp hpairs
  have hfields : q.1 = m ∧ q.2 = n := by
    simpa [matchPair] using of_decide_eq_true hmatch
  have hvq : Valid q.1 q.2 p := by
    simpa [hfields.1, hfields.2] using hv
  have hc : covered q.1 q.2 p = true := outerCoverageFromPair q hq p hvq
  obtain ⟨e, he, hematch⟩ := List.any_eq_true.mp hc
  have hfields' : e.m = q.1 ∧ e.n = q.2 ∧ e.p = p := by
    simpa [matchEntry] using of_decide_eq_true hematch
  have hOKall : ∀ e ∈ entries, entryOK e := by
    intro e he
    have hall : entries.all (fun e => decide (entryOK e)) = true := entriesOK_true
    have hbool : decide (entryOK e) = true := (List.all_eq_true.mp hall) e he
    exact of_decide_eq_true hbool
  have hok : entryOK e := hOKall e he
  have hw : Witness e.m e.n e.p := by
    refine ⟨e.a, e.b, hok.1, ?_⟩
    by_cases hh : e.hall
    · left
      refine ⟨e.i, e.j, e.k, ?_⟩
      simpa [entryOK, hh] using hok.2
    · right
      refine ⟨e.i, e.j, e.k, ?_⟩
      simpa [entryOK, hh] using hok.2
  simpa [hfields'.1, hfields'.2.1, hfields'.2.2, hfields.1, hfields.2] using hw

end C4SquareExtension.ActionDichotomy
