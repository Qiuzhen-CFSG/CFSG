@[reducible] def matchPair (m n : Code) (q : Code × Code) : Bool :=
  decide (q.1 = m ∧ q.2 = n)

@[reducible] def pairCovered (m n : Code) : Bool :=
  pairs.any (matchPair m n)

@[reducible] def matchEntry (m n : Code) (p : OuterCode) (e : Entry) : Bool :=
  decide (e.m = m ∧ e.n = n ∧ e.p = p)

@[reducible] def covered (m n : Code) (p : OuterCode) : Bool :=
  entries.any (matchEntry m n p)

def InnerValid (m n : Code) : Prop :=
  m ≠ zeroCode ∧ n ≠ zeroCode ∧ m ≠ n ∧
  (∀ i : Fin 4, i ≠ 0 → ∃ a : Model, word m n i a = a⁻¹ ∧ a ^ 2 ≠ 1)


instance (m n : Code) : Decidable (InnerValid m n) := by
  unfold InnerValid
  infer_instance

