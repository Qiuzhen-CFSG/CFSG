theorem outerCoverageFromPair : ∀ q : Code × Code, q ∈ pairs →
    ∀ p : OuterCode, Valid q.1 q.2 p → covered q.1 q.2 p = true := by
  intro q hq
  simp [pairs] at hq
  rcases hq with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  all_goals intro p hp
  · exact outerCoverage_0 p hp
  · exact outerCoverage_1 p hp
  · exact False.elim (outerImpossible_2 p hp)
  · exact False.elim (outerImpossible_3 p hp)
  · exact False.elim (outerImpossible_4 p hp)
  · exact False.elim (outerImpossible_5 p hp)
