module

public import Mathlib.Algebra.Group.Subgroup.Ker
public import Mathlib.Logic.Equiv.Option
public import Mathlib.GroupTheory.Perm.Basic

/-!
# Comparing a permutation image after adjoining one fixed point

An equivalence `X ≃ Option Y` embeds permutations of `Y` into permutations of
`X`, fixing the point labelled `none`. If an action has image contained in the
transported group generated by two permutations, and both generators lift to
the action, its image is isomorphic to that generated group.

The proof establishes both subgroup inclusions and uses the injectivity of
permutation transport. It is the elementary image-comparison step for the
Fi23 fixed-point centralizer action (GLS3, Table 5.3u).
-/

@[expose] public section

namespace Theory.GroupAction.PermutationImageComparison
variable {G H K X Y : Type*} [Group G] [Group H] [Group K]

def withFixedPoint (e : X ≃ Option Y) : Equiv.Perm Y →* Equiv.Perm X where
  toFun p := (e.trans p.optionCongr).trans e.symm
  map_one' := by ext x; simp
  map_mul' p q := by
    ext x
    apply e.injective
    simp [Equiv.Perm.mul_apply, Equiv.optionCongr_apply, Option.map_map]

@[simp] theorem withFixedPoint_apply (e : X ≃ Option Y) (p : Equiv.Perm Y) (x : X) :
    e (withFixedPoint e p x) = Option.map p (e x) := by
  simp [withFixedPoint, Equiv.optionCongr_apply]

theorem withFixedPoint_injective (e : X ≃ Option Y) :
    Function.Injective (withFixedPoint e) := by
  intro p q h
  ext y
  have he := congrArg (fun f : Equiv.Perm X => e (f (e.symm (some y)))) h
  simpa using he

theorem eq_withFixedPoint_iff (e : X ≃ Option Y) (q : Equiv.Perm X)
    (p : Equiv.Perm Y) :
    q = withFixedPoint e p ↔ ∀ x, e (q x) = Option.map p (e x) := by
  constructor
  · rintro rfl
    exact withFixedPoint_apply e p
  · intro h
    ext x
    apply e.injective
    rw [withFixedPoint_apply]
    exact h x

theorem range_eq_map_closure_pair (f : G →* K) (i : H →* K) (a b : H)
    (upper : ∀ g, f g ∈ (Subgroup.closure {a, b}).map i)
    (ha : i a ∈ f.range) (hb : i b ∈ f.range) :
    f.range = (Subgroup.closure {a, b}).map i := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    exact upper g
  · rw [MonoidHom.map_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x, hx, rfl⟩
    rcases hx with rfl | hx
    · exact ha
    · have : x = b := Set.mem_singleton_iff.mp hx
      simpa [this] using hb

noncomputable def rangeEquivClosurePair (f : G →* K) (i : H →* K)
    (hi : Function.Injective i) (a b : H)
    (upper : ∀ g, f g ∈ (Subgroup.closure {a, b}).map i)
    (ha : i a ∈ f.range) (hb : i b ∈ f.range) :
    f.range ≃* Subgroup.closure {a, b} :=
  (MulEquiv.subgroupCongr (range_eq_map_closure_pair f i a b upper ha hb)).trans
    ((Subgroup.closure {a, b}).equivMapOfInjective i hi).symm
end Theory.GroupAction.PermutationImageComparison

