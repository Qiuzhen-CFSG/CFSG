module
public import Theory.GroupAction.InnerSylow
public import Theory.GroupAction.SylowPointwiseInner

/-!
# Sylow normalizers under inner two-group actions

Let a two-subgroup S normalize L and contain a Sylow subgroup P of L.
If S acts by inner automorphisms on L, every such action is induced by
an element of P. Thus S is generated by P and its centralizer of L, and
N_L(P) normalizes S. For perfect L, odd outer order of the actual central
quotient supplies the innerness, retaining any central two-cover.

Source application: Aschbacher--Smith 15.1.21(i), printed pp.1097--1098.
This lemma treats the component-normalizing branch; it does not assume
that arbitrary component orbits are singletons.
-/

public section

open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- Inner two-group actions are induced by the prescribed Sylow subgroup. -/
theorem exists_sylow_inner_of_inner_action
    (L S : Subgroup G) (hS : IsPGroup 2 S)
    (hSL : S ≤ normalizer (L : Set G)) (P : Sylow 2 L)
    (hPS : (P : Subgroup L).map L.subtype ≤ S)
    (hi : ∀ s : S, ∃ l : L,
      L.normalizerMonoidHom ⟨s, hSL s.property⟩ = MulAut.conj l) (s : S) :
    ∃ l ∈ (P : Subgroup L),
      L.normalizerMonoidHom ⟨s,hSL s.property⟩ = MulAut.conj l := by
  let f : S →* MulAut L := L.normalizerMonoidHom.comp (inclusion hSL)
  have hPf : (P : Subgroup L).map MulAut.conj ≤ f.range := by
    rintro _ ⟨l,hl,rfl⟩
    refine ⟨⟨l,hPS (mem_map_of_mem L.subtype hl)⟩, ?_⟩
    ext k
    rfl
  have hfin : IsPGroup 2 f.range := hS.of_surjective f.rangeRestrict f.rangeRestrict_surjective
  obtain ⟨l,hl⟩ := hi s
  have hin : f s ∈ MulAut.innerSubgroup L := ⟨l,hl.symm⟩
  obtain ⟨k,hk,hks⟩ := MulAut.mem_innerSylow_of_mem_inner P f.range hfin hPf
    (show f s ∈ f.range from ⟨s,rfl⟩) hin
  exact ⟨k,hk,hks.symm⟩

/-- The Borel normalizes the original two-subgroup when its action is inner. -/
theorem sylowNormalizer_le_normalizer_of_inner_action
    (L S : Subgroup G) (hS : IsPGroup 2 S)
    (hSL : S ≤ normalizer (L : Set G)) (P : Sylow 2 L)
    (hPS : (P : Subgroup L).map L.subtype ≤ S)
    (hi : ∀ s : S, ∃ l : L,
      L.normalizerMonoidHom ⟨s, hSL s.property⟩ = MulAut.conj l) :
    (normalizer (P : Set L)).map L.subtype ≤ normalizer (S : Set G) := by
  have factor := exists_sylow_inner_of_inner_action L S hS hSL P hPS hi
  have conjugates (b : L) (hb : b ∈ normalizer (P : Set L)) (s : G) (hs : s ∈ S) :
      (b : G) * s * (b : G)⁻¹ ∈ S := by
    obtain ⟨l,hl,he⟩ := factor ⟨s,hs⟩
    have hc : s * (b : G) * s⁻¹ = (l : G) * (b : G) * (l : G)⁻¹ :=
      congrArg Subtype.val (DFunLike.congr_fun he b)
    have hm : b * l * b⁻¹ ∈ (P : Subgroup L) :=
      (mem_normalizer_iff.mp hb l).mp hl
    have hsm : (b : G) * (l : G) * (b : G)⁻¹ ∈ S := hPS (mem_map_of_mem L.subtype hm)
    have hls : (l : G) ∈ S := hPS (mem_map_of_mem L.subtype hl)
    have hcomm : (l : G)⁻¹ * s * (b : G) = (b : G) * ((l : G)⁻¹ * s) := by
      calc
        (l : G)⁻¹ * s * (b : G) = (l : G)⁻¹ * (s * (b : G) * s⁻¹) * s := by group
        _ = (l : G)⁻¹ * ((l : G) * (b : G) * (l : G)⁻¹) * s := by rw [hc]
        _ = _ := by group
    have hex : (b : G) * s * (b : G)⁻¹ =
        ((b : G) * (l : G) * (b : G)⁻¹) * ((l : G)⁻¹ * s) := by
      calc
        (b : G) * s * (b : G)⁻¹ =
          (b : G) * (l : G) * (((l : G)⁻¹ * s) * (b : G)⁻¹) := by group
        _ = (b : G) * (l : G) * ((b : G)⁻¹ * ((l : G)⁻¹ * s)) := by
          rw [(show Commute ((l : G)⁻¹ * s) (b : G) from hcomm).inv_right.eq]
        _ = _ := by group
    rw [hex]
    exact S.mul_mem hsm (S.mul_mem (S.inv_mem hls) hs)
  rintro _ ⟨b,hb,rfl⟩
  rw [mem_normalizer_iff]
  intro s
  constructor
  · exact conjugates b hb s
  · intro hs
    have hh := conjugates b⁻¹ ((normalizer (P : Set L)).inv_mem hb)
      ((b : G) * s * (b : G)⁻¹) hs
    simpa only [coe_inv, inv_inv, inv_mul_cancel_left, mul_assoc, inv_mul_cancel_right, inv_mul_cancel, mul_one] using hh

/-- An inner two-group action centralizes the center of its prescribed Sylow. -/
theorem sylowCenter_le_centralizer_of_inner_action
    (L S : Subgroup G) (hS : IsPGroup 2 S)
    (hSL : S ≤ normalizer (L : Set G)) (P : Sylow 2 L)
    (hPS : (P : Subgroup L).map L.subtype ≤ S)
    (hi : ∀ s : S, ∃ l : L,
      L.normalizerMonoidHom ⟨s,hSL s.property⟩ = MulAut.conj l) :
    ((center P).map (P : Subgroup L).subtype).map L.subtype ≤ centralizer (S : Set G) := by
  rintro _ ⟨z,⟨z',hz',rfl⟩,rfl⟩ s hs
  obtain ⟨l,hl,he⟩ := exists_sylow_inner_of_inner_action L S hS hSL P hPS hi ⟨s,hs⟩
  have hz : l * (z' : L) = (z' : L) * l :=
    congrArg Subtype.val (mem_center_iff.mp hz' (⟨l,hl⟩ : P))
  have hh := congrArg Subtype.val (DFunLike.congr_fun he (z' : L))
  change s * ((z' : L) : G) * s⁻¹ = (↑l * (↑z' : G)) * (↑l)⁻¹ at hh
  rw [show (l : G) * ((z' : L) : G) = ((z' : L) : G) * (l : G) from congrArg Subtype.val hz,
    mul_inv_cancel_right] at hh
  exact mul_inv_eq_iff_eq_mul.mp hh

/-- Perfect central covers retain the normalizer conclusion when the model
has odd outer automorphism group. -/
theorem sylowNormalizer_le_normalizer_of_odd_outer
    {H : Type*} [Group H] [Finite H]
    (L S : Subgroup G) [Group.IsPerfect L] (hS : IsPGroup 2 S)
    (hSL : S ≤ normalizer (L : Set G)) (P : Sylow 2 L)
    (hPS : (P : Subgroup L).map L.subtype ≤ S)
    (e : (L ⧸ center L) ≃* H)
    (ho : Odd (MulAut.conj : H →* MulAut H).range.index) :
    (normalizer (P : Set L)).map L.subtype ≤ normalizer (S : Set G) := by
  apply sylowNormalizer_le_normalizer_of_inner_action L S hS hSL P hPS
  intro s
  let f : S →* MulAut H := (MulAut.centralQuotientAction e).comp
    (L.normalizerMonoidHom.comp (inclusion hSL))
  obtain ⟨k,hk⟩ := hS s
  have hp : f s ^ (2 ^ k) = 1 := by rw [← map_pow,hk,map_one]
  exact (MulAut.centralQuotientAction_inner_iff e _).mp
    (MulAut.inner_of_two_pow_eq_one_of_odd_index ho (f s) hp)

end Subgroup
