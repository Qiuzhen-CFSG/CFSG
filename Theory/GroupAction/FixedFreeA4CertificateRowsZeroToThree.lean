/-- Every invertible plane-moving matrix with first column 0–3
has a selected perfect involution identity. -/
public theorem certificates_zero_to_three (g : Code) (hlo : 0 ≤ g.1.val)
    (hhi : g.1.val < 4) (hg : good g) (hm : moves g) :
    ∃ k : Fin 53, perfect g k := by
  rcases g with ⟨a,b,c,d⟩
  fin_cases a <;> norm_num at hlo hhi
  · exact certificate_0 b c d hg hm
  · exact certificate_1 b c d hg hm
  · exact certificate_2 b c d hg hm
  · exact certificate_3 b c d hg hm
end FixedFreeA4BinaryData
