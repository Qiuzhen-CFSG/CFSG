module
public import Theory.GroupAction.FixedFreeA4CertificateData

/-!
# Kernel certificates for first columns 0 through 3

This computational shard checks the fixed-free A4 plane-mover identity for
all binary four-by-four matrices whose first column has value 0–3.
A table selects one of the shared53 short word patterns. Lean's kernel
checks the Boolean guard and the full selected matrix identity for every
remaining triple of columns. The shared guard theorem then yields the
literal perfect involution identity for every invertible plane mover.

The four disjoint shards cover all16 first-column values. Splitting them
bounds memory and permits parallel production validation. No table entry,
external computation, generated-group classification or compiler result is
assumed correct: every selected identity is reduced by the kernel.
This supports the source-neutral A4 argument for Stellmacher (8.6)(b3), p.44.
-/

noncomputable section
namespace FixedFreeA4BinaryData
private def selected_0 : B → B → B → Fin 53 :=
(fun _ => (fun _ => (fun _ => 0)))
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem checked_0 :
    ((List.finRange 16).all fun b => (List.finRange 16).all fun c =>
      (List.finRange 16).all fun d => checks (0,b,c,d) (selected_0 b c d)) = true := by
  decide +kernel
private theorem certificate_0 (b c d : B) (hg : good (0,b,c,d))
    (hm : moves (0,b,c,d)) : ∃ k : Fin 53, perfect (0,b,c,d) k := by
  refine ⟨selected_0 b c d,perfect_of_check _ _ hg hm ?_⟩
  exact (List.all_eq_true.mp
    (List.all_eq_true.mp (List.all_eq_true.mp checked_0 b (List.mem_finRange b))
      c (List.mem_finRange c))) d (List.mem_finRange d)
