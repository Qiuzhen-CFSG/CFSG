module

public import Theory.GroupAction.MarkedCubicClassTwo.Terminal
public import Theory.GroupAction.MarkedCubicClassTwo.LowerCentral
public import Theory.GroupAction.MarkedCubicClassTwo.ClassTwoQuotient
public import Theory.GroupAction.MarkedCubicClassTwo.InvariantLayer

/-!
# The class bound for two marked cubic generators

Two commuting opposite involutions act on a finite three-group generated by
two specified cubic subgroups, with Frattini quotient of order nine and
Frattini subgroup equal to the derived subgroup. If their induced actions
on every invariant quotient below Frattini have cyclic fixed subgroups,
then the group has nilpotency class at most two.

The marked class-two calculation inverts each Frattini join modulo the
third lower-central term. If that term is nontrivial, a common sign
character constructs an invariant quotient whose third term has order three.
Cyclicity of the two induced fixed subgroups gives a contradiction there.

All quotients are the literal quotients of the original group. The cubic
markings survive because they meet Frattini trivially. The common derived
subgroup centralizes the two abelian Frattini joins and therefore the whole
quotient, contradicting its separately proved class-three equality.

The final class bound discharges both the quotient inversion and invariant
subgroup premises of the intermediate contradiction. Constructing the marked
involutions and deriving the cyclic fixed-subgroup hypothesis from the ambient
SQTK cover remain with the source application.

Source: Aschbacher–Smith, The Classification of Quasithin Groups,
F.6.16, printed p.308 (1 March 2004 manuscript). In its final sentence,
centrality of the Frattini subgroup is needed; the third term is already
central in the class-three quotient.
-/

public section

open Subgroup
namespace MarkedCubicClassTwo
variable {P : Type*} [Group P]

private theorem derived_map {Q : Type*} [Group Q] (f : P →* Q)
    (hf : Function.Surjective f) :
    (_root_.commutator P).map f = _root_.commutator Q := by
  change (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P).map f = ⁅(⊤ : Subgroup Q), ⊤⁆
  rw [map_commutator, map_top_of_surjective f hf]

variable [Finite P]

/-- A genuine class-three quotient with cubic third layer contradicts the
cyclic fixed-subgroup hypothesis. The two quotient-inversion premises are
precisely the remaining marked class-two calculation. -/
theorem no_third_layer_quotient {A B : Subgroup P} {a b : MulAut P}
    (h : CubicMarking A B a b) (hP : IsPGroup 3 P)
    (hplane : Nat.card (P ⧸ frattini P) = 9)
    (hPhi : frattini P = _root_.commutator P)
    (hfixed : QuotientCyclicFixed a b)
    (hinva : ∀ x ∈ A ⊔ _root_.commutator P,
      a x * x ∈ (⊤ : Subgroup P).lowerCentralSeries 2)
    (hinvb : ∀ x ∈ B ⊔ _root_.commutator P,
      b x * x ∈ (⊤ : Subgroup P).lowerCentralSeries 2)
    (N : Subgroup P) [N.Normal]
    (hfour : (⊤ : Subgroup P).lowerCentralSeries 3 ≤ N)
    (hN : N ≤ (⊤ : Subgroup P).lowerCentralSeries 2)
    (hVcard : Nat.card (((⊤ : Subgroup P).lowerCentralSeries 2).map (QuotientGroup.mk' N)) = 3)
    (aN bN : MulAut (P ⧸ N))
    (haN : ∀ x, aN (QuotientGroup.mk' N x) = QuotientGroup.mk' N (a x))
    (hbN : ∀ x, bN (QuotientGroup.mk' N x) = QuotientGroup.mk' N (b x)) : False := by
  let q := QuotientGroup.mk' N
  let V := ((⊤ : Subgroup P).lowerCentralSeries 2).map q
  have hVnormal : V.Normal := Subgroup.Normal.map inferInstance q (QuotientGroup.mk'_surjective N)
  let := hVnormal
  have hL3D : (⊤ : Subgroup P).lowerCentralSeries 2 ≤ _root_.commutator P := by
    rw [← top_lowerCentralSeries_one]
    exact Subgroup.lowerCentralSeries_antitone ⊤ (by decide)
  have hL3F : (⊤ : Subgroup P).lowerCentralSeries 2 ≤ frattini P := hPhi ▸ hL3D
  have hAF := disjoint_frattini_of_cubic_generators A B h.card_left h.card_right h.generate hplane
  have hBF := disjoint_frattini_of_cubic_generators B A h.card_right h.card_left
    (sup_comm A B ▸ h.generate) hplane
  have hm := h.quotient N (hAF.mono_right (hN.trans hL3F))
    (hBF.mono_right (hN.trans hL3F)) aN bN haN hbN
  obtain ⟨hac, hbc⟩ := hfixed N inferInstance (hN.trans hL3F) aN bN haN hbN
  have hmapD : (_root_.commutator P).map q = _root_.commutator (P ⧸ N) :=
    derived_map q (QuotientGroup.mk'_surjective N)
  have hodd : Odd (Nat.card (P ⧸ N)) := by
    let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    obtain ⟨n, hn⟩ := (hP.to_quotient N).exists_card_eq
    rw [hn]
    exact (by decide : Odd 3).pow
  have hdisplace (X : Subgroup P) (c : MulAut P) (cN : MulAut (P ⧸ N))
      (hcN : ∀ x, cN (q x) = q (c x))
      (hc : ∀ x ∈ X ⊔ _root_.commutator P, c x * x ∈ (⊤ : Subgroup P).lowerCentralSeries 2) :
      ∀ x ∈ X.map q ⊔ _root_.commutator (P ⧸ N), cN x * x ∈ V := by
    rw [← hmapD, ← Subgroup.map_sup]
    rintro _ ⟨x, hx, rfl⟩
    rw [hcN, ← map_mul]
    exact mem_map_of_mem q (hc x hx)
  have hcenter := commutator_le_center_of_marked_quotient hodd (A.map q) (B.map q) V
    hm.card_left hm.card_right hm.generate hVcard
    ((map_mono hL3D).trans_eq hmapD)
    (quotient_marked_disjoint A _ N (hAF.mono_right hL3F) hN)
    (quotient_marked_disjoint B _ N (hBF.mono_right hL3F) hN)
    aN bN hm.left_sq hm.right_sq hm.left_fixes hm.right_fixes hac hbc
    (hdisplace A a aN haN hinva) (hdisplace B b bN hbN hinvb)
  have hclass := quotient_has_class_three N hfour hVcard
  have hbot : (⊤ : Subgroup (P ⧸ N)).lowerCentralSeries 2 = ⊥ :=
    commutator_top_right_eq_bot_iff_le_center.mpr hcenter
  let : Group.IsNilpotent (P ⧸ N) := Subgroup.nilpotent_iff_lowerCentralSeries.mpr ⟨2, hbot⟩
  have hle := Subgroup.lowerCentralSeries_eq_bot_iff_nilpotencyClass_le.mp hbot
  omega


/-- The exact invariant-quotient application: the induced maps are constructed,
so compatibility is not an additional assumption. -/
theorem no_invariant_third_layer_quotient {A B : Subgroup P} {a b : MulAut P}
    (h : CubicMarking A B a b) (hP : IsPGroup 3 P)
    (hplane : Nat.card (P ⧸ frattini P) = 9)
    (hPhi : frattini P = _root_.commutator P)
    (hfixed : QuotientCyclicFixed a b)
    (hinva : ∀ x ∈ A ⊔ _root_.commutator P,
      a x * x ∈ (⊤ : Subgroup P).lowerCentralSeries 2)
    (hinvb : ∀ x ∈ B ⊔ _root_.commutator P,
      b x * x ∈ (⊤ : Subgroup P).lowerCentralSeries 2)
    (N : Subgroup P) [N.Normal]
    (hfour : (⊤ : Subgroup P).lowerCentralSeries 3 ≤ N)
    (hN : N ≤ (⊤ : Subgroup P).lowerCentralSeries 2)
    (hVcard : Nat.card (((⊤ : Subgroup P).lowerCentralSeries 2).map (QuotientGroup.mk' N)) = 3)
    (haN : N.map a.toMonoidHom = N) (hbN : N.map b.toMonoidHom = N) : False := by
  exact no_third_layer_quotient h hP hplane hPhi hfixed hinva hinvb N hfour hN hVcard
    (QuotientGroup.congr N N a haN) (QuotientGroup.congr N N b hbN)
    (fun x => QuotientGroup.congr_mk' N N a haN x)
    (fun x => QuotientGroup.congr_mk' N N b hbN x)

/-- The third lower-central term vanishes under the marked quotient fixed-point
bound. The invariant subgroup and both marked inversion identities are proved
internally, so no class-bound or third-layer premise remains. -/
theorem CubicMarking.lowerCentralSeries_two_eq_bot {A B : Subgroup P} {a b : MulAut P}
    (h : CubicMarking A B a b) (hP : IsPGroup 3 P)
    (hplane : Nat.card (P ⧸ frattini P) = 9)
    (hPhi : frattini P = _root_.commutator P)
    (hfixed : QuotientCyclicFixed a b) :
    (⊤ : Subgroup P).lowerCentralSeries 2 = ⊥ := by
  by_contra hV
  obtain ⟨N, hnormal, hfour, hN, hVcard, haN, hbN⟩ :=
    exists_invariant_third_layer_quotient hP a b h.left_sq h.right_sq h.commute hV
  let := hnormal
  obtain ⟨hinva, hinvb⟩ := h.inverts_joins_mod_third
  exact no_invariant_third_layer_quotient h hP hplane hPhi hfixed
    hinva hinvb N hfour hN hVcard haN hbN

/-- The marked three-group has central derived subgroup, the class-at-most-two
conclusion needed in the three-group branch of F.6.16. -/
theorem CubicMarking.commutator_le_center {A B : Subgroup P} {a b : MulAut P}
    (h : CubicMarking A B a b) (hP : IsPGroup 3 P)
    (hplane : Nat.card (P ⧸ frattini P) = 9)
    (hPhi : frattini P = _root_.commutator P)
    (hfixed : QuotientCyclicFixed a b) :
    _root_.commutator P ≤ center P := by
  exact commutator_top_right_eq_bot_iff_le_center.mp
    (h.lowerCentralSeries_two_eq_bot hP hplane hPhi hfixed)

end MarkedCubicClassTwo
