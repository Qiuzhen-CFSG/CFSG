module

public import Theory.GroupAction.AutomorphismFixedSubgroup
public import Mathlib.GroupTheory.Index
public import Mathlib.GroupTheory.Subgroup.Center

/-!
# Fixed-subgroup index across a central kernel

When an automorphism fixes a subgroup modulo a central kernel, displacement
is a homomorphism from that subgroup into the kernel. Its kernel is the
actual fixed subgroup. The first isomorphism theorem therefore bounds the
fixed-subgroup index by the order of the original kernel.

This is the elementary central-extension calculation used in
Aschbacher–Smith, *The Classification of Quasithin Groups*, Lemma 13.6.17,
printed p.930, for the central subgroup generated by v.
-/

@[expose] public section

open Subgroup
namespace MulAut
variable {G D : Type*} [Group G] [Group D] [Finite G]

theorem fixedSubgroup_relIndex_le_card_kernel (f : G →* D) (a : MulAut G)
    (A : Subgroup G) (hc : f.ker ≤ center G)
    (ha : ∀ x ∈ A, f (a x) = f x) :
    a.fixedSubgroup.relIndex A ≤ Nat.card f.ker := by
  have hd (x : A) : x.val⁻¹ * a x.val ∈ f.ker := by
    change f (x.val⁻¹ * a x.val) = 1
    rw [map_mul, map_inv, ha x x.property, inv_mul_cancel]
  let δ : A →* f.ker := {
    toFun x := ⟨x.val⁻¹ * a x.val, hd x⟩
    map_one' := by apply Subtype.ext; simp
    map_mul' x y := by
      apply Subtype.ext
      change ((x : G) * y)⁻¹ * a ((x : G) * y) =
        (x.val⁻¹ * a x.val) * (y.val⁻¹ * a y.val)
      rw [mul_inv_rev, map_mul]
      have hxy := mem_center_iff.mp (hc (hd x)) y.val⁻¹
      calc
        y.val⁻¹ * x.val⁻¹ * (a x.val * a y.val) =
            (y.val⁻¹ * (x.val⁻¹ * a x.val)) * a y.val := by simp only [mul_assoc]
        _ = ((x.val⁻¹ * a x.val) * y.val⁻¹) * a y.val := by rw [hxy]
        _ = _ := by simp only [mul_assoc] }
  have hk : δ.ker = a.fixedSubgroup.subgroupOf A := by
    ext x
    rw [mem_subgroupOf, MulAut.mem_fixedSubgroup]
    change (⟨x.val⁻¹ * a x.val, hd x⟩ : f.ker) = 1 ↔ a x.val = x.val
    rw [Subtype.ext_iff]
    exact inv_mul_eq_one.trans eq_comm
  change (a.fixedSubgroup.subgroupOf A).index ≤ _
  rw [← hk, index_ker]
  exact Nat.card_le_card_of_injective δ.range.subtype δ.range.subtype_injective
end MulAut
