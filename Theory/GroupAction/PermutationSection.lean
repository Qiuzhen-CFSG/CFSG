module
public import Mathlib.Algebra.Group.Subgroup.Ker
public import Mathlib.GroupTheory.Perm.Basic
/-!
# A quotient from an embedded permutation action

Suppose generators of a faithfully acting group lift to an ambient group and
have the prescribed action on an injectively labelled set of points. The
subgroup of pairs generated by these lifts and the original generators
projects injectively to the ambient group and surjectively to the target.
This constructs the needed subgroup quotient without controlling the action
on points outside the labelled set. The application is the Fischer
involution-centralizer section in Aschbacher--Smith A.2.19, pp.40--41.
-/

@[expose] public noncomputable section
namespace Theory.GroupAction.PermutationSection
open Subgroup
variable {G H X Y : Type*} [Group G] [Group H]

def relation (ρ : G →* Equiv.Perm X) (τ : H →* Equiv.Perm Y)
    (point : Y → X) : Subgroup (G×H) where
  carrier := {z | ∀ y, ρ z.1 (point y) = point (τ z.2 y)}
  one_mem' := by intro y; simp
  mul_mem' := by
    intro a b ha hb y
    change ∀ y, ρ a.1 (point y)=point (τ a.2 y) at ha
    change ∀ y, ρ b.1 (point y)=point (τ b.2 y) at hb
    simp only [Prod.fst_mul, Prod.snd_mul, map_mul, Equiv.Perm.mul_apply, hb, ha]
  inv_mem' := by
    intro a ha y
    apply (ρ a.1).injective
    change ∀ y, ρ a.1 (point y)=point (τ a.2 y) at ha
    simp only [Prod.fst_inv, Prod.snd_inv, map_inv]
    change (ρ a.1) ((ρ a.1).symm (point y)) =
      (ρ a.1) (point ((τ a.2).symm y))
    rw [Equiv.apply_symm_apply, ha, Equiv.apply_symm_apply]

theorem exists_section_of_generators
    (ρ : G →* Equiv.Perm X) (τ : H →* Equiv.Perm Y) (hτ : Function.Injective τ)
    (point : Y → X) (hp : Function.Injective point)
    (u v : G) (a b : H) (hg : closure ({a,b} : Set H)=⊤)
    (hu : ∀ y, ρ u (point y)=point (τ a y))
    (hv : ∀ y, ρ v (point y)=point (τ b y))
    (C : Subgroup G) (huc : u∈C) (hvc : v∈C) :
    ∃ (L : Subgroup G) (f : L→*H), L ≤ C ∧ Function.Surjective f := by
  let R : Subgroup (G×H) := closure {(u,a),(v,b)}
  have hR : R ≤ relation ρ τ point := by
    apply (closure_le _).mpr
    intro z hz
    rcases hz with rfl | rfl
    · exact hu
    · exact hv
  let f : R→*G := (MonoidHom.fst G H).comp R.subtype
  let q : R→*H := (MonoidHom.snd G H).comp R.subtype
  have hf : Function.Injective f := by
    apply (MonoidHom.ker_eq_bot_iff f).mp
    apply bot_unique
    intro z hz
    apply mem_bot.mpr
    apply Subtype.ext
    change z.val=(1:G×H)
    apply Prod.ext
    · exact (MonoidHom.mem_ker.mp hz)
    · apply hτ
      ext y
      apply hp
      have hh := hR z.property y
      have hz1 : z.val.1=1 := MonoidHom.mem_ker.mp hz
      simpa only [hz1,Prod.snd_one,map_one,Equiv.Perm.one_apply] using hh.symm
  have hq : Function.Surjective q := by
    apply MonoidHom.range_eq_top.mp
    apply top_unique
    rw [← hg]
    apply (closure_le _).mpr
    intro z hz
    rcases hz with rfl | rfl
    · exact ⟨⟨(u,z),subset_closure (by simp)⟩,rfl⟩
    · exact ⟨⟨(v,z),subset_closure (by simp)⟩,rfl⟩
  have hC : R ≤ C.comap (MonoidHom.fst G H) := by
    apply (closure_le _).mpr
    intro z hz
    rcases hz with rfl | rfl
    · exact huc
    · exact hvc
  refine ⟨f.range,q.comp (MonoidHom.ofInjective hf).symm.toMonoidHom,?_,
    hq.comp (MonoidHom.ofInjective hf).symm.surjective⟩
  rintro x ⟨z,rfl⟩
  exact hC z.property
end Theory.GroupAction.PermutationSection
