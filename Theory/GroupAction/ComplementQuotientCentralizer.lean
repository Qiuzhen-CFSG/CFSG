module

public import Theory.GroupAction.SubgroupQuotientFullAction
public import Theory.GroupAction.CoprimeHall

/-!
# Centralizers in a quotient with full coprime complement support

Let E be generated by R and A in a finite group, with E normalizing U and Z.
Suppose the actual
quotient U/(Z subgroupOf U) is abelian, [U,E]=U, [U,R] lies in Z, and the
order of A is coprime to the quotient order. Then every element of U
centralizing A lies in Z. No trivial-intersection assumption on R and A,
or containment Z≤U, is required.

The exact quotient-conjugation action kills R. Hence the image of A equals
the image of E and has full action commutator. Abelian coprime splitting
makes its fixed subgroup trivial. The image of an A-centralizing point is
fixed, so the point belongs to the quotient kernel, namely Z∩U.

This standard coprime-action argument is used successively on the residual/
module and module/center layers in the large Stellmacher configuration.
The result is stated for general finite groups and has no campaign imports.
-/

namespace Subgroup
open scoped IsMulCommutative

public theorem centralizer_le_layer_of_coprime_generating_complement
    {G : Type*} [Group G] [Finite G] (E R A U Z : Subgroup G)
    [hN : (Z.subgroupOf U).Normal]
    [IsMulCommutative (U ⧸ Z.subgroupOf U)]
    (hgen : E = R ⊔ A) (hEU : E ≤ normalizer (U : Set G))
    (hEZ : E ≤ normalizer (Z : Set G)) (hfull : ⁅U, E⁆ = U)
    (hUR : ⁅U, R⁆ ≤ Z)
    (hcop : Nat.Coprime (Nat.card A) (Nat.card (U ⧸ Z.subgroupOf U))) :
    U ⊓ centralizer (A : Set G) ≤ Z := by
  let X := U ⧸ Z.subgroupOf U
  have hRE : R ≤ E := hgen ▸ le_sup_left
  have hAE : A ≤ E := hgen ▸ le_sup_right
  obtain ⟨action, hformula, hRker, hsupport⟩ :=
    exists_quotient_conjugation_full_action E U Z E R hEU hEZ hN le_rfl hfull hUR
  let image := (A.subgroupOf E).map action
  have himage : (E.subgroupOf E).map action = image := by
    have hjoin : E.subgroupOf E = R.subgroupOf E ⊔ A.subgroupOf E := by
      rw [← subgroupOf_sup hRE hAE, ← hgen]
    rw [hjoin, map_sup, ((map_eq_bot_iff _).mpr hRker), bot_sup_eq]
  have hfullImage : commutatorAction image X = ⊤ := by
    rw [← himage]
    exact hsupport
  have hdiv : Nat.card image ∣ Nat.card A := by
    have h : Nat.card image ∣ Nat.card (A.subgroupOf E) := card_map_dvd _ _
    rwa [Nat.card_congr (subgroupOfEquivOfLe hAE).toEquiv] at h
  have hfixed : FixedPoints.subgroup image X = ⊥ := by
    have h := (isCompl_fixedPointSubgroup_commutatorAction_of_solvable_coprime_of_isMulCommutative
      (G := X) (A := image) (Group.isSolvable_of_comm fun x y => mul_comm x y)
      (hcop.of_dvd_left hdiv) inferInstance).disjoint
    change Disjoint (FixedPoints.subgroup image X) (commutatorAction image X) at h
    rwa [hfullImage, disjoint_top] at h
  rintro point ⟨hpoint, hcentral⟩
  let native : U := ⟨point, hpoint⟩
  let projection := QuotientGroup.mk' (Z.subgroupOf U)
  have hqfixed : projection native ∈ FixedPoints.subgroup image X := by
    intro actor
    obtain ⟨a, ha, himageA⟩ := actor.property
    change (actor : MulAut X) (projection native) = projection native
    rw [← himageA, hformula]
    apply congrArg projection
    apply Subtype.ext
    change (a : G) * point * (a : G)⁻¹ = point
    exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_iff.mp hcentral a ha)
  have hqone : projection native = 1 := hfixed.le hqfixed
  exact (QuotientGroup.eq_one_iff (N := Z.subgroupOf U) native).mp hqone

end Subgroup
