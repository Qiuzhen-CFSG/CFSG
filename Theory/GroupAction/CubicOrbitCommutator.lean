module
public import Theory.ElementaryAbelian.Join
public import Theory.GroupAction.SubgroupConjugation
public import Mathlib.GroupTheory.Commutator.Basic
/-!
# Cubic orbit support equals commutator support

Let t have cube one and let W be generated by U and its t-conjugate.
If W is elementary abelian of exponent two, t normalizes it, and t fixes
only its identity, then W equals the subgroup [U,⟨t⟩]. No finiteness or
classification hypothesis is needed.

For u in U, the cubic norm u·uᵗ·uᵗ² belongs to W and is t-fixed, hence
is the identity. It follows that uᵗ=[u,t²], while u is a product of two
such commutators. This contains both orbit generators in [U,⟨t⟩].
The reverse containment follows from t-normalization of W.

This elementary calculation identifies the actual orbit construction with
the canonical W=[V1,Ea] in Stellmacher (8.6)(b3), printed p.44. The ambient
residual containment is supplied by the application.
-/

namespace Subgroup
open scoped IsMulCommutative commutatorElement

public theorem cubic_orbit_eq_commutator
    {G : Type*} [Group G] (U : Subgroup G) (t : G) (ht3 : t^3=1)
    (helem : IsElementaryAbelian 2 (U ⊔ U.conjBy t : Subgroup G))
    (hnorm : t ∈ normalizer ((U ⊔ U.conjBy t : Subgroup G) : Set G))
    (hfixed : (U ⊔ U.conjBy t) ⊓ centralizer ({t} : Set G) = ⊥) :
    U ⊔ U.conjBy t = ⁅U,zpowers t⁆ := by
  let W := U ⊔ U.conjBy t
  change W ⊓ centralizer ({t} : Set G) = ⊥ at hfixed
  let f : MulAut G := MulAut.conj t
  let _ : IsElementaryAbelian 2 W := helem
  have hUW : U ≤ W := le_sup_left
  have hfW (x:G) (hx:x∈W) : f x ∈ W := (mem_normalizer_iff.mp hnorm x).mp hx
  have hf3 (x:G) : f (f (f x)) = x := by
    change t*(t*(t*x*t⁻¹)*t⁻¹)*t⁻¹=x
    calc
      _ = t^3*x*(t^3)⁻¹ := by simp only [pow_succ,pow_zero]; group
      _ = x := by rw [ht3,one_mul,inv_one,mul_one]
  have hinv (x:G) (hx:x∈W) : x⁻¹=x := by
    apply inv_eq_iff_mul_eq_one.mpr
    simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) x hx
  have hnormOne (u:G) (hu:u∈U) : u*f u*f (f u)=1 := by
    have huW := hUW hu
    have hu1 := hfW u huW
    have hu2 := hfW (f u) hu1
    let n := u*f u*f (f u)
    have hn : n∈W := W.mul_mem (W.mul_mem huW hu1) hu2
    have hnf : f n=n := by
      dsimp [n]
      rw [map_mul,map_mul,hf3]
      calc
        f u*f (f u)*u = u*(f u*f (f u)) :=
          (setLike_mul_comm (s := W) huW (W.mul_mem hu1 hu2)).symm
        _ = u*f u*f (f u) := (mul_assoc _ _ _).symm
    have hnc : n ∈ centralizer ({t} : Set G) := by
      rw [mem_centralizer_singleton_iff]
      exact (mul_inv_eq_iff_eq_mul.mp hnf).symm
    have hh : n ∈ W ⊓ centralizer ({t} : Set G) := ⟨hn,hnc⟩
    change n=1
    simpa only [hfixed,mem_bot] using hh
  have hsecond (u:G) (hu:u∈U) : f u = ⁅u,t^2⁆ := by
    have huW := hUW hu
    have hu2 := hfW (f u) (hfW u huW)
    have hp : u*f u=f (f u) :=
      (mul_eq_one_iff_eq_inv.mp (hnormOne u hu)).trans (hinv _ hu2)
    have hm : f u=u*f (f u) := by
      rw [←hp,←mul_assoc]
      have hs : u*u=1 := by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) u huW
      rw [hs,one_mul]
    rw [hm,commutatorElement_def,hinv u huW]
    dsimp [f]
    simp only [pow_two]
    group
  have hUcomm : U ≤ ⁅U,zpowers t⁆ := by
    intro u hu
    have hc : ⁅u,t⁆ ∈ ⁅U,zpowers t⁆ := commutator_mem_commutator hu (mem_zpowers t)
    have hc2 : f u ∈ ⁅U,zpowers t⁆ := by
      rw [hsecond u hu]
      exact commutator_mem_commutator hu ((zpowers t).pow_mem (mem_zpowers t) 2)
    have hpair : ⁅u,t⁆ * f u=u := by
      rw [commutatorElement_def,hinv u (hUW hu)]
      change (u*t*u*t⁻¹)*(t*u*t⁻¹)=u
      have hs : u*u=1 := by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) u (hUW hu)
      calc
        _ = u*t*(u*u)*t⁻¹ := by group
        _ = u := by rw [hs,mul_one,mul_inv_cancel_right]
    exact hpair ▸ (⁅U,zpowers t⁆).mul_mem hc hc2
  apply le_antisymm
  · refine sup_le hUcomm ?_
    rintro x ⟨u,hu,rfl⟩
    change f u∈⁅U,zpowers t⁆
    rw [hsecond u hu]
    exact commutator_mem_commutator hu ((zpowers t).pow_mem (mem_zpowers t) 2)
  · have hTnorm : zpowers t ≤ normalizer (W : Set G) := zpowers_le.mpr hnorm
    exact (commutator_mono hUW le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp hTnorm)
end Subgroup
