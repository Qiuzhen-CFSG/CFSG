module
public import Theory.GroupTheory.SmallNonabelianTwoGroupAutomorphismOrderCoarse
public import Theory.GroupAction.CardFourCubic
public import Theory.Frattini.Intersection

/-!
# A moving cubic in the normalizer of a four-group

The action on an elementary four-group has order dividing six. A subgroup
containing its centralizer, a moving cubic and a Sylow two-subgroup therefore
has index one. The same cubic fixes only the identity on the four-group.
Consequently, if the Frattini image of a two-subgroup lies in that four-group,
its cubic-fixed subgroup has trivial Frattini subgroup and is elementary.

Source application: Aschbacher--Smith, combined manuscript, 1 March 2004,
11.1.2, printed p.763, the original H=G₁X₁T and centralizer span preceding G.2.5.
-/

open Subgroup
open scoped IsMulCommutative
public noncomputable section
namespace Theory.GroupAction
variable {G : Type*} [Group G] [Finite G]

private theorem top_of_six_action (T : Sylow 2 G) (H E : Subgroup G)
    (hTH : (T : Subgroup G) ≤ H) (hEH : E ≤ H) (hE : Nat.card E = 3)
    {A : Type*} [Group A] (f : G →* A) (hA : Nat.card A = 6)
    (hk : f.ker ≤ H) (hmove : ¬ E ≤ f.ker) : H = ⊤ := by
  have hEc : Nat.card (E.map f) = 3 :=
    ((Nat.dvd_prime Nat.prime_three).mp (hE ▸ E.card_map_dvd f)).resolve_left (by
      intro he
      exact hmove ((Subgroup.map_eq_bot_iff _).mp (card_eq_one.mp he)))
  have hdiv : f.ker.index ∣ 6 := by
    rw [index_ker]
    exact hA ▸ card_subgroup_dvd_card f.range
  have hHi : H.index ∣ 6 := (index_dvd_of_le hk).trans hdiv
  have h2 : ¬ 2 ∣ H.index := fun hd => T.not_dvd_index (hd.trans (index_dvd_of_le hTH))
  have hHi3 : H.index ∣ 3 :=
    (Nat.Coprime.dvd_mul_right (Nat.coprime_comm.mpr
      (Nat.prime_two.coprime_iff_not_dvd.mpr h2))).mp hHi
  rcases (Nat.dvd_prime Nat.prime_three).mp hHi3 with h1 | h3
  · exact index_eq_one.mp h1
  · have hc : 3 ∣ f.ker.relIndex H := by
      rw [relIndex_ker]
      exact hEc ▸ card_dvd_of_le (map_mono hEH)
    have hd : 9 ∣ 6 := (show 9 ∣ f.ker.index from by
      rw [←relIndex_mul_index hk,h3]
      exact Nat.mul_dvd_mul hc (dvd_refl 3)).trans hdiv
    norm_num at hd

/-- The full normalizer of a four-group is generated by its centralizer,
a moving cubic, and any ambient Sylow two-subgroup it contains. -/
theorem four_normalizer_eq_centralizer_sup_cubic_sup_sylow
    (W E : Subgroup G) [IsElementaryAbelian 2 W]
    (hW : Nat.card W = 4) (hE : Nat.card E = 3)
    (hEW : E ≤ normalizer (W : Set G))
    (hmove : ¬ E ≤ centralizer (W : Set G))
    (T : Sylow 2 G) (hTW : (T : Subgroup G) ≤ normalizer (W : Set G)) :
    normalizer (W : Set G) = (centralizer (W : Set G) ⊔ E) ⊔ (T : Subgroup G) := by
  let N := normalizer (W : Set G)
  let H := (centralizer (W : Set G) ⊔ E) ⊔ (T : Subgroup G)
  have hHN : H ≤ N := sup_le (sup_le (centralizer_le_normalizer _) hEW) hTW
  have hAut : Nat.card (MulAut W) = 6 := by
    rw [SmallNonabelianTwoGroup.card_mulAut_elementary_two_pow W 2 (by simpa using hW)]
    decide
  have hh : H.subgroupOf N = ⊤ := top_of_six_action (T.subtype hTW) (H.subgroupOf N)
    (E.subgroupOf N) (fun _ hx => (show (T : Subgroup G) ≤ H from le_sup_right) hx)
    (comap_mono (le_sup_right.trans le_sup_left))
    (by rw [Nat.card_congr (subgroupOfEquivOfLe hEW).toEquiv]; exact hE)
    W.normalizerMonoidHom hAut
    (by rw [normalizerMonoidHom_ker]; exact comap_mono (le_sup_left.trans le_sup_left))
    (by
      rw [normalizerMonoidHom_ker]
      intro he
      apply hmove
      intro e heE
      exact he (show (⟨e,hEW heE⟩ : N) ∈ E.subgroupOf N from heE))
  exact le_antisymm (fun n hn => hh.ge (mem_top (⟨n,hn⟩ : N))) hHN

/-- A moving cubic fixes no nonidentity element of the original four-group. -/
theorem four_inf_centralizer_eq_bot_of_moving_cubic
    (W E : Subgroup G) (hW : Nat.card W = 4) (hE : Nat.card E = 3)
    (hEW : E ≤ normalizer (W : Set G))
    (hmove : ¬ E ≤ centralizer (W : Set G)) :
    W ⊓ centralizer (E : Set G) = ⊥ := by
  classical
  obtain ⟨e,heE,heC⟩ := Set.not_subset.mp hmove
  let a : MulAut W := W.normalizerMonoidHom ⟨e,hEW heE⟩
  have ha : a^3 = 1 := by
    have he : (⟨e,heE⟩ : E)^3 = 1 := hE ▸ pow_card_eq_one' (x := (⟨e,heE⟩ : E))
    have he' : (⟨e,hEW heE⟩ : normalizer (W : Set G))^3 = 1 :=
      Subtype.ext (congrArg (fun x : E => (x : G)) he)
    rw [←map_pow,he',map_one]
  have hne : a ≠ 1 := by
    intro he
    apply heC
    exact (W.normalizerMonoidHom_ker.le (show (⟨e,hEW heE⟩ : normalizer (W : Set G)) ∈
      W.normalizerMonoidHom.ker from he))
  apply bot_unique
  rintro w ⟨hw,hc⟩
  apply mem_bot.mpr
  by_contra hn
  have hwne : (⟨w,hw⟩ : W) ≠ 1 := fun h => hn (congrArg Subtype.val h)
  apply CardFourCubic.moves_nonidentity hW a ha hne ⟨w,hw⟩ hwne
  apply Subtype.ext
  change e*w*e⁻¹ = w
  rw [mem_centralizer_iff.mp hc e heE,mul_inv_cancel_right]

/-- A subgroup fixed by the moving cubic is elementary when its Frattini
image is contained in the original four-group. -/
theorem cubic_fixed_elementary_of_frattini_le_four
    (W E U : Subgroup G) (hW : Nat.card W = 4) (hE : Nat.card E = 3)
    (hEW : E ≤ normalizer (W : Set G))
    (hmove : ¬ E ≤ centralizer (W : Set G))
    (hU : IsPGroup 2 U) (hΦ : (frattini U).map U.subtype ≤ W) :
    IsElementaryAbelian 2 (U ⊓ centralizer (E : Set G) : Subgroup G) := by
  let C := U ⊓ centralizer (E : Set G)
  let : Fact (IsPGroup 2 C) := ⟨hU.to_le inf_le_left⟩
  apply (frattini_eq_bot_iff_isElementaryAbelian (p := 2)).mp
  apply ((frattini C).map_eq_bot_iff_of_injective C.subtype_injective).mp
  apply bot_unique
  have hC : (frattini C).map C.subtype ≤ centralizer (E : Set G) :=
    (map_le_range _ _).trans ((range_subtype C).le.trans inf_le_right)
  exact (le_inf ((frattini_image_le_of_le (p := 2) (show C ≤ U from inf_le_left) hU).trans hΦ)
    hC).trans_eq (four_inf_centralizer_eq_bot_of_moving_cubic W E hW hE hEW hmove)
end Theory.GroupAction
