def cube (c : Code) := mulCode (mulCode c c) c
def fixedLine (c : Code) : Bool :=
  ((if c.1 == 1 then 1 else 0) + (if c.2.1 == 2 then 1 else 0) +
    (if xor c.1 c.2.1 == 3 then 1 else 0) : Nat) == 1
def admissible (c : Code) : Bool :=
  fixedLine c && cube c == identity && cube (mulCode reflection c) == identity
def check (c : Code) : Bool := !admissible c || (List.ofFn candidates).contains c

set_option maxHeartbeats 0 in
theorem all_rows (a : B) : (List.finRange 16).all (fun b => (List.finRange 16).all
    (fun c => (List.finRange 16).all (fun d => check (a,b,c,d)))) = true := by
  fin_cases a <;> decide +kernel

theorem classify (c : Code) (hc : admissible c = true) :
    ∃ k : Fin 48, candidates k = c := by
  obtain ⟨a,b,c,d⟩ := c
  have h := (List.all_eq_true.mp (List.all_eq_true.mp
    (List.all_eq_true.mp (all_rows a) b (List.mem_finRange b))
      c (List.mem_finRange c))) d (List.mem_finRange d)
  simpa only [check,hc,Bool.not_true,Bool.false_or,List.contains_iff_mem,List.mem_ofFn] using h
