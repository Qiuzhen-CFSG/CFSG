module

public import Theory.GroupAction.SemilinearPointStabilizerExceptional.DegreeReduction
public import Theory.GroupAction.SemilinearPointStabilizerExceptional.DegreeEight
public import Theory.GroupAction.SemilinearPointStabilizerExceptional.PrimeReduction
public import Theory.GroupAction.SemilinearPointStabilizerExceptional.PrimeExclusion
public import Theory.PGroupCore
public import Theory.SpecificGroups.PSL3Two.Parabolics.LinearModel

/-!
# The exceptional semilinear-stabilizer action

A regular subgroup has the same order as the set on which it acts. At
prime-power degree a regular normal subgroup therefore lies in the p-core.
This excludes the regular alternative in GLS, Volume 4, Chapter 1,
Theorem 3.2 when O₂(X) is trivial. The exceptional matrix model is transported
using the actual SL₃(2) inclusion and central quotient.

The scalar normal-closure induction reduces the degree assertion to actors
normally generated by their scalar subgroup. Transfer and the fixed-field
argument give an odd prime degree exponent and a dihedral coefficient
normalizer. The Sylow-center argument excludes exponents greater than three.
At degree eight the marked permutation action supplies an actual GL₃(2)
isomorphism. Thus the exceptional conclusion holds under the original
coordinate hypotheses and trivial two-core, with no extra reduction premises.
Source: `refs/KGroup/GLS4/Chapter1.tex`, lines 305–468.
-/

public section

namespace MulAction.SemilinearPointStabilizer

/-- A regular normal subgroup at prime-power degree belongs to the p-core. -/
theorem regular_normal_le_pCore
    {X Ω : Type*} [Group X] [Finite X] [MulAction X Ω]
    {p n : ℕ} [Fact p.Prime] (hΩ : Nat.card Ω = p ^ n) (a : Ω)
    (R : Subgroup X) (hR : R.Normal)
    (hreg : ∀ x y : Ω, ∃! r : R, (r : X) • x = y) : R ≤ pCore p X := by
  have hbij : Function.Bijective (fun r : R => (r : X) • a) := by
    constructor
    · intro r s hrs
      obtain ⟨t, _, ht⟩ := hreg a ((s : X) • a)
      exact (ht r hrs).trans (ht s rfl).symm
    · intro b
      obtain ⟨r, hr, _⟩ := hreg a b
      exact ⟨r, hr⟩
  have hcard : Nat.card R = p ^ n :=
    (Nat.card_eq_of_bijective _ hbij).trans hΩ
  exact le_sSup ⟨hR, (IsPGroup.iff_card).mpr ⟨n, hcard⟩⟩

/-- The regular alternative is impossible under the actual two-core hypothesis. -/
theorem no_regular_normal_of_twoCore_eq_bot
    {X Ω : Type*} [Group X] [Finite X] [MulAction X Ω]
    {n : ℕ} (hn : 0 < n) (hΩ : Nat.card Ω = 2 ^ n)
    (a : Ω) (hcore : pCore 2 X = ⊥) :
    ¬ ∃ R : Subgroup X, R.Normal ∧
      ∀ x y : Ω, ∃! r : R, (r : X) • x = y := by
  rintro ⟨R, hR, hreg⟩
  have hle := regular_normal_le_pCore hΩ a R hR hreg
  rw [hcore] at hle
  have htriv (r : R) : (r : X) = 1 := hle r.property
  have hsub : Subsingleton Ω := ⟨by
    intro x y
    obtain ⟨r, hr, _⟩ := hreg x y
    simpa [htriv r] using hr⟩
  have hcard : Nat.card Ω = 1 := Nat.card_eq_one_iff_unique.mpr ⟨hsub, ⟨a⟩⟩
  rw [hΩ] at hcard
  exact (not_lt_of_ge hcard.le) (Nat.one_lt_pow hn.ne' (by decide))

/-- The actual GL₃(2)–PSL₃(2) comparison, via SL₃(2). -/
noncomputable def binaryGeneralLinearEquivProjective :
    Matrix.GeneralLinearGroup (Fin 3) (ZMod 2) ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2) :=
  Matrix.PSL3Two.equivGL.symm.trans Matrix.PSL3Two.equiv

/-- Application of the source dichotomy: the p-core excludes its regular
branch and the genuine matrix equivalences transport its exceptional branch. -/
theorem exceptional_of_regular_or_linear
    {X Ω : Type*} [Group X] [Finite X] [MulAction X Ω]
    {n : ℕ} (hn : 2 ≤ n) (hΩ : Nat.card Ω = 2 ^ n)
    (a : Ω) (hcore : pCore 2 X = ⊥)
    (hdichotomy :
      (∃ R : Subgroup X, R.Normal ∧ ∀ x y : Ω, ∃! r : R, (r : X) • x = y) ∨
      (n = 3 ∧ Nonempty (X ≃* Matrix.GeneralLinearGroup (Fin 3) (ZMod 2)))) :
    n = 3 ∧ Nonempty (X ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) := by
  rcases hdichotomy with hregular | ⟨hn, ⟨e⟩⟩
  · exact (no_regular_normal_of_twoCore_eq_bot (by omega) hΩ a hcore hregular).elim
  · exact ⟨hn, ⟨e.trans binaryGeneralLinearEquivProjective⟩⟩

end MulAction.SemilinearPointStabilizer

namespace MulAction.SemilinearPointStabilizer

universe u v

/-- Conditional assembly along the degree-reduction route. The unconditional
theorems below discharge the degree and recognition inputs from the original
action hypotheses. -/
theorem exceptional_of_generated_degree_and_degree_eight
    {F : Type v} [Field F] [Finite F] {n : ℕ} (hn : 2 ≤ n)
    (hF : Nat.card F = 2 ^ n)
    (hdegree : ∀ (Y : Type u) [Group Y] [Finite Y] [MulAction Y F]
      [FaithfulSMul Y F], ∀ c : Coordinates Y F,
      IsMultiplyPretransitive Y F 2 → pCore 2 Y = ⊥ →
      c.scalarClosure = ⊤ → n = 3)
    {X : Type u} [Group X] [Finite X] [MulAction X F] [FaithfulSMul X F]
    (c : Coordinates X F) (htwo : IsMultiplyPretransitive X F 2)
    (hcore : pCore 2 X = ⊥)
    (hrecognition : Nat.card F = 8 →
      Nonempty (X ≃* Matrix.GeneralLinearGroup (Fin 3) (ZMod 2))) :
    n = 3 ∧ Nonempty (X ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) := by
  have hnthree := degree_three_of_scalar_generated hn hF hdegree c htwo hcore
  obtain ⟨e⟩ := hrecognition (by simpa [hnthree] using hF)
  exact ⟨hnthree, ⟨e.trans binaryGeneralLinearEquivProjective⟩⟩

/-- The binary degree exponent is three. Scalar normal generation is removed
by strong induction, and both the prime reduction and larger-prime exclusion
are applied with their actual two-point subgroup and normalizer. -/
theorem Coordinates.degree_eq_three
    {X F : Type*} [Group X] [Finite X] [Field F] [Finite F]
    [MulAction X F] [FaithfulSMul X F] (c : Coordinates X F)
    (htwo : IsMultiplyPretransitive X F 2) {n : ℕ} (hn : 2 ≤ n)
    (hF : Nat.card F = 2 ^ n) (hcore : pCore 2 X = ⊥) : n = 3 := by
  apply degree_three_of_scalar_generated hn hF ?_ c htwo hcore
  intro Y _ _ _ _ cY htwoY hcoreY hgen
  obtain ⟨hprime, hodd, hΓ, hdihedral⟩ :=
    cY.prime_degree_and_dihedral_normalizer htwoY hn hF hcoreY hgen
  have hnle : n ≤ 3 := by
    by_contra! hn3
    exact PrimeExclusion.false_of_prime_degree_gt_three cY htwoY hF hcoreY
      hgen hprime hodd hn3 hΓ hdihedral
  obtain ⟨k, hk⟩ := hodd
  omega

/-- The exceptional branch of GLS 4, Theorem 3.2 under trivial two-core,
with the genuine linear-group isomorphism constructed from the action. -/
theorem Coordinates.exceptional_generalLinear
    {X F : Type*} [Group X] [Finite X] [Field F] [Finite F]
    [MulAction X F] [FaithfulSMul X F] (c : Coordinates X F)
    (htwo : IsMultiplyPretransitive X F 2) {n : ℕ} (hn : 2 ≤ n)
    (hF : Nat.card F = 2 ^ n) (hcore : pCore 2 X = ⊥) :
    n = 3 ∧ Nonempty (X ≃* Matrix.GeneralLinearGroup (Fin 3) (ZMod 2)) := by
  have hnthree := c.degree_eq_three htwo hn hF hcore
  exact ⟨hnthree, DegreeEight.equiv_generalLinear c htwo
    (by simpa [hnthree] using hF) hcore⟩

/-- The exceptional actor in the projective model used by the consumers.
The comparison is the actual SL₃(2) inclusion followed by its central quotient. -/
theorem Coordinates.exceptional
    {X F : Type*} [Group X] [Finite X] [Field F] [Finite F]
    [MulAction X F] [FaithfulSMul X F] (c : Coordinates X F)
    (htwo : IsMultiplyPretransitive X F 2) {n : ℕ} (hn : 2 ≤ n)
    (hF : Nat.card F = 2 ^ n) (hcore : pCore 2 X = ⊥) :
    n = 3 ∧ Nonempty (X ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) := by
  obtain ⟨hnthree, ⟨e⟩⟩ := c.exceptional_generalLinear htwo hn hF hcore
  exact ⟨hnthree, ⟨e.trans binaryGeneralLinearEquivProjective⟩⟩

/-- Explicit action-coordinate formulation of the exceptional classification.
The ambient action is only a permutation action on the field; semilinearity
is required precisely for elements fixing zero. -/
theorem exceptional_of_semilinear_stabilizer
    {X F : Type*} [Group X] [Finite X] [Field F] [Finite F]
    [MulAction X F] [FaithfulSMul X F]
    (htwo : IsMultiplyPretransitive X F 2) {n : ℕ} (hn : 2 ≤ n)
    (hF : Nat.card F = 2 ^ n) (hcore : pCore 2 X = ⊥)
    (hscalars : ∀ a : Fˣ, ∃ g : X, ∀ x : F, g • x = (a : F) * x)
    (hsemilinear : ∀ g : X, g • (0 : F) = 0 →
      ∃ a : Fˣ, ∃ σ : F ≃+* F, ∀ x : F, g • x = (a : F) * σ x) :
    n = 3 ∧ Nonempty (X ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) :=
  Coordinates.exceptional ⟨hscalars, hsemilinear⟩ htwo hn hF hcore

end MulAction.SemilinearPointStabilizer
