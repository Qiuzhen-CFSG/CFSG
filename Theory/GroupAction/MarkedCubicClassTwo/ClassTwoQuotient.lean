module

public import Theory.GroupAction.MarkedCubicClassTwo.Defs

/-!
# Marked inversion in the class-two quotient

Let two cubic subgroups generate a group, with opposite marked automorphisms
inverting one generator subgroup and fixing the other. Modulo the third
lower-central term, each automorphism inverts its generator subgroup joined
with the derived subgroup.

In a class-two group the central elements inverted by an automorphism form
a subgroup. If the automorphism inverts one abelian generating subgroup
and fixes the other, every cross-commutator belongs to this central subgroup.
The quotient by it is generated by two commuting abelian images, so it is
abelian. Thus the entire derived subgroup is inverted, and centrality extends
inversion to the required join. We apply this calculation to the literal
quotient by `lowerCentralSeries 2`, with the actual marked images and the
automorphisms induced by characteristicity.

Source: Aschbacher–Smith, The Classification of Quasithin Groups, F.6.16,
printed p.308, combined manuscript of 1 March 2004. This proves the inversion
of `Xᵢ/V` used in the class-three contradiction. It needs neither recognition
of the quotient nor cyclicity of fixed subgroups.
-/

open Subgroup
open scoped commutatorElement

namespace MarkedCubicClassTwo

private theorem inverts_join_of_class_two
    {G : Type*} [Group G] (A B : Subgroup G)
    [IsMulCommutative A] [IsMulCommutative B]
    (hgen : A ⊔ B = ⊤) (hc : _root_.commutator G ≤ center G)
    (a : MulAut G) (ha : ∀ x ∈ A, a x = x⁻¹) (hb : ∀ x ∈ B, a x = x) :
    ∀ x ∈ A ⊔ _root_.commutator G, a x = x⁻¹ := by
  let K : Subgroup G :=
    { carrier := {x | x ∈ center G ∧ a x = x⁻¹}
      one_mem' := by simp
      mul_mem' := by
        rintro x y ⟨hx, hax⟩ ⟨hy, hay⟩
        refine ⟨(center G).mul_mem hx hy, ?_⟩
        rw [map_mul, hax, hay, mul_inv_rev]
        exact mem_center_iff.mp ((center G).inv_mem hy) x⁻¹
      inv_mem' := by
        rintro x ⟨hx, hax⟩
        exact ⟨(center G).inv_mem hx, by rw [map_inv, hax]⟩ }
  have hK : K ≤ center G := fun _ hx => hx.1
  let : K.Normal := ⟨fun k hk g => by
    rw [mem_center_iff.mp (hK hk) g, mul_inv_cancel_right]
    exact hk⟩
  have hcross : ⁅A, B⁆ ≤ K := by
    apply commutator_le.mpr
    intro x hx y hy
    have hxy := hc (commutator_mem_commutator (mem_top x) (mem_top y))
    refine ⟨hxy, ?_⟩
    rw [map_commutatorElement, ha x hx, hb y hy, commutatorElement_inv_left]
    rw [← commutatorElement_inv]
    rw [mem_center_iff.mp ((center G).inv_mem hxy) x⁻¹, inv_mul_cancel_right]
  have hD : _root_.commutator G ≤ K := by
    let q := QuotientGroup.mk' K
    have hcross' : ⁅A.map q, B.map q⁆ = ⊥ := by
      rw [← map_commutator]
      exact (Subgroup.map_eq_bot_iff _).mpr
        (by simpa only [q, QuotientGroup.ker_mk'] using hcross)
    let : IsMulCommutative (A.map q) := map_isMulCommutative A q
    let : IsMulCommutative (B.map q) := map_isMulCommutative B q
    have hAB : A.map q ≤ centralizer (B.map q : Set (G ⧸ K)) :=
      commutator_eq_bot_iff_le_centralizer.mp hcross'
    have hcomm : IsMulCommutative (A.map q ⊔ B.map q : Subgroup (G ⧸ K)) := by
      apply le_centralizer_iff_isMulCommutative.mp
      apply sup_le
      · exact le_centralizer_iff.mpr
          (sup_le (A.map q).le_centralizer (le_centralizer_iff.mp hAB))
      · exact le_centralizer_iff.mpr (sup_le hAB (B.map q).le_centralizer)
    have hmap : (⁅A ⊔ B, A ⊔ B⁆).map q = ⊥ := by
      rw [map_commutator, Subgroup.map_sup]
      exact commutator_self_eq_bot_iff.mpr hcomm
    rw [hgen] at hmap
    simpa only [_root_.commutator_def, q, QuotientGroup.ker_mk'] using
      (Subgroup.map_eq_bot_iff _).mp hmap
  intro x hx
  obtain ⟨u, hu, v, hv, rfl⟩ := mem_sup_of_normal_right.mp hx
  rw [map_mul, ha u hu, (hD hv).2, mul_inv_rev]
  exact mem_center_iff.mp ((center G).inv_mem (hc hv)) u⁻¹

variable {P : Type*} [Group P]

/-- Both marked joins are inverted modulo the third lower-central term.
These are exactly the two inversion premises of
`MarkedCubicClassTwo.no_invariant_third_layer_quotient`; in its source setting
`frattini P = commutator P` identifies the joins with `X₁` and `X₂`.
The calculation itself does not require finiteness or the Frattini-plane order. -/
public theorem CubicMarking.inverts_joins_mod_third
    {A B : Subgroup P} {a b : MulAut P} (h : CubicMarking A B a b) :
    (∀ x ∈ A ⊔ _root_.commutator P,
      a x * x ∈ (⊤ : Subgroup P).lowerCentralSeries 2) ∧
    (∀ x ∈ B ⊔ _root_.commutator P,
      b x * x ∈ (⊤ : Subgroup P).lowerCentralSeries 2) := by
  let V := (⊤ : Subgroup P).lowerCentralSeries 2
  let q := QuotientGroup.mk' V
  have hclass : _root_.commutator (P ⧸ V) ≤ center (P ⧸ V) := by
    apply commutator_top_right_eq_bot_iff_le_center.mp
    change (⊤ : Subgroup (P ⧸ V)).lowerCentralSeries 2 = ⊥
    rw [← map_top_of_surjective q (QuotientGroup.mk'_surjective V), ← map_lowerCentralSeries]
    exact QuotientGroup.map_mk'_self V
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let : IsCyclic A := isCyclic_of_prime_card h.card_left
  let : IsCyclic B := isCyclic_of_prime_card h.card_right
  let : IsMulCommutative (A.map q) := map_isMulCommutative A q
  let : IsMulCommutative (B.map q) := map_isMulCommutative B q
  have hgen : A.map q ⊔ B.map q = ⊤ := by
    rw [← Subgroup.map_sup, h.generate, map_top_of_surjective q (QuotientGroup.mk'_surjective V)]
  have hD : (_root_.commutator P).map q = _root_.commutator (P ⧸ V) := by
    change (⁅(⊤ : Subgroup P), ⊤⁆ : Subgroup P).map q = ⁅(⊤ : Subgroup (P ⧸ V)), ⊤⁆
    rw [map_commutator, map_top_of_surjective q (QuotientGroup.mk'_surjective V)]
  have hinv (X Y : Subgroup P) [IsMulCommutative (X.map q)] [IsMulCommutative (Y.map q)]
      (c : MulAut P) (hXY : X.map q ⊔ Y.map q = ⊤)
      (hX : ∀ x ∈ X, c x = x⁻¹) (hY : ∀ y ∈ Y, c y = y) :
      ∀ x ∈ X ⊔ _root_.commutator P, c x * x ∈ V := by
    have hcV : V.map c.toMonoidHom = V := characteristic_iff_map_eq.mp inferInstance c
    let cV := QuotientGroup.congr V V c hcV
    have hcVq (x : P) : cV (q x) = q (c x) := QuotientGroup.congr_mk' V V c hcV x
    have hci : ∀ x ∈ X.map q ⊔ _root_.commutator (P ⧸ V), cV x = x⁻¹ := by
      apply inverts_join_of_class_two (X.map q) (Y.map q) hXY hclass cV
      · rintro _ ⟨x, hx, rfl⟩
        rw [hcVq, hX x hx, map_inv]
      · rintro _ ⟨y, hy, rfl⟩
        rw [hcVq, hY y hy]
    intro x hx
    have hxq : q x ∈ X.map q ⊔ _root_.commutator (P ⧸ V) := by
      rw [← hD, ← Subgroup.map_sup]
      exact mem_map_of_mem q hx
    apply (QuotientGroup.eq_one_iff _).mp
    change q (c x * x) = 1
    rw [map_mul, ← hcVq, hci _ hxq, inv_mul_cancel]
  exact ⟨hinv A B a hgen h.left_inverts h.left_fixes,
    hinv B A b (by rw [sup_comm]; exact hgen) h.right_inverts h.right_fixes⟩

end MarkedCubicClassTwo
