module

public import Theory.GroupAction.MarkedCubicRecognition.Models
public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Theory.GroupTheory.NormalizedSupCard
import Mathlib.Tactic.Group

/-!
# No subnormal S₃ in the marked Heisenberg extension

A hypothetical subnormal S₃ meets the Heisenberg subgroup in order three.
Its product with that subgroup has order 54, so its relative index is odd.
Since S₃ is generated by involutions, the prime-to-two residual theorem
makes it normal in this product. The order-three intersection is normal
in the Heisenberg group and hence is its center: the quotient has order
nine, and the basic commutator generates the center.

Normality now makes every displacement by a Heisenberg element central.
The actor therefore fixes both coordinates of the central quotient. The
prescribed independent sign changes act faithfully there, forcing the
actor to be trivial. This puts the S₃ in the group of order 27, a contradiction.
Only the four possible actors and the six permutations are computed.

Source: Aschbacher–Smith, The Classification of Quasithin Groups,
Lemma 14.7.70, printed p.1075; the prescribed action is F.6.16,
printed pp.308–309 (combined manuscript, 1 March 2004).
-/

public section
open Subgroup
noncomputable section
namespace MarkedCubicRecognition.SubnormalObstruction
private abbrev E := HeisenbergExtension
private abbrev P := HeisenbergPrime 3
private abbrev V := Four

private theorem card_P : Nat.card P = 27 := by
  rw [HeisenbergPrime.card]
  norm_num

private theorem card_range : Nat.card (SemidirectProduct.inl.range : Subgroup E) = 27 := by
  rw [MonoidHom.range_eq_map (SemidirectProduct.inl : P →* E)]
  rw [Subgroup.card_map_of_injective SemidirectProduct.inl_injective]
  rw [Subgroup.card_top, HeisenbergPrime.card]
  norm_num

private theorem card_S3 (K : Subgroup E) (e : K ≃* Equiv.Perm (Fin 3)) : Nat.card K = 6 := by
  rw [Nat.card_congr e.toEquiv]
  norm_num [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]

private theorem inf_card (K : Subgroup E) (e : K ≃* Equiv.Perm (Fin 3)) :
    Nat.card (K ⊓ SemidirectProduct.inl.range : Subgroup E) = 3 := by
  let : Fintype E := Fintype.ofEquiv (P × V)
    (SemidirectProduct.equivProd (N := P) (G := V) (φ := heisenbergAction)).symm
  let π : E →* V := SemidirectProduct.rightHom
  let f : K →* V := π.comp K.subtype
  have hK : Nat.card K = 6 := card_S3 K e
  have hrdiv4 : Nat.card f.range ∣ 4 := by
    apply dvd_trans (Subgroup.card_dvd_of_le (show f.range ≤ (⊤ : Subgroup V) from le_top))
    rw [Subgroup.card_top]
    norm_num [V, C2]
  have hrdiv6 : Nat.card f.range ∣ 6 := by
    simpa [hK] using (Subgroup.card_range_dvd f)
  have hrpos : 0 < Nat.card f.range := Nat.card_pos
  have hr : Nat.card f.range = 2 := by
    have hrle : Nat.card f.range ≤ 4 := Nat.le_of_dvd (by norm_num) hrdiv4
    have hc : Nat.card f.range = 1 ∨ Nat.card f.range = 2 := by
      interval_cases hv : Nat.card f.range <;> simp_all
    rcases hc with hc | hc
    · have hf : f.ker = ⊤ := by
        apply Subgroup.eq_top_of_card_eq
        have hi : f.ker.index = 1 := by rw [Subgroup.index_ker f, hc]
        have hm := f.ker.card_mul_index
        rw [hi, mul_one] at hm
        exact hm
      have hle : K ≤ SemidirectProduct.inl.range := by
        intro x hx
        have hxk : (⟨x, hx⟩ : K) ∈ f.ker := hf ▸ Subgroup.mem_top _
        have hxp : x ∈ (SemidirectProduct.rightHom (N := P) (G := V)
            (φ := heisenbergAction)).ker := by
          change SemidirectProduct.rightHom x = 1
          exact (MonoidHom.mem_ker.mp (by simpa [f, π] using hxk))
        have heq : (SemidirectProduct.inl : P →* E).range =
            (SemidirectProduct.rightHom (N := P) (G := V) (φ := heisenbergAction)).ker :=
          SemidirectProduct.range_inl_eq_ker_rightHom
        rw [heq]
        exact hxp
      have hd := Subgroup.card_dvd_of_le hle
      rw [hK, card_range] at hd
      norm_num at hd
    · exact hc
  have hker : Nat.card f.ker = 3 := by
    have hm := f.ker.card_mul_index
    rw [Subgroup.index_ker, hr, hK] at hm
    omega
  have heq : f.ker = (SemidirectProduct.inl.range.subgroupOf K) := by
    ext x
    change π (x : E) = 1 ↔ (x : E) ∈ SemidirectProduct.inl.range
    change SemidirectProduct.rightHom (x : E) = 1 ↔ (x : E) ∈ SemidirectProduct.inl.range
    have heq : (SemidirectProduct.inl : P →* E).range =
        (SemidirectProduct.rightHom (N := P) (G := V) (φ := heisenbergAction)).ker :=
      SemidirectProduct.range_inl_eq_ker_rightHom
    rw [← MonoidHom.mem_ker, heq]
  have hsubcard : Nat.card (SemidirectProduct.inl.range.subgroupOf K) = 3 := by
    rw [← heq, hker]
  have hcardmap := Subgroup.card_map_of_injective (K := SemidirectProduct.inl.range.subgroupOf K)
    K.subtype_injective
  rw [Subgroup.subgroupOf_map_subtype] at hcardmap
  calc
    Nat.card (K ⊓ SemidirectProduct.inl.range : Subgroup E) =
        Nat.card (SemidirectProduct.inl.range.subgroupOf K) := by
      simpa [inf_comm] using hcardmap
    _ = 3 := hsubcard

private theorem symmetricThree_two_factors : ∀ x : Equiv.Perm (Fin 3),
    ∃ a b : Equiv.Perm (Fin 3), a ^ 2 = 1 ∧ b ^ 2 = 1 ∧ x = a * b := by
  decide +kernel

private theorem symmetricThree_primeToResidual {D : Type*} [Group D]
    (e : D ≃* Equiv.Perm (Fin 3)) : primeToResidual 2 D = ⊤ := by
  apply top_unique
  intro x _
  obtain ⟨a, b, ha, hb, he⟩ := symmetricThree_two_factors (e x)
  have hpow (a : Equiv.Perm (Fin 3)) (ha : a ^ 2 = 1) :
      e.symm a ∈ primeToResidual 2 D := by
    apply mem_primeToResidual_of_pow (n := 1)
    simpa only [pow_one, map_pow, map_one] using congrArg e.symm ha
  have hx := (primeToResidual 2 D).mul_mem (hpow a ha) (hpow b hb)
  simpa only [← map_mul, ← he, e.symm_apply_apply] using hx

private theorem normalized_by_base (K : Subgroup E) (hs : K.IsSubnormal)
    (e : K ≃* Equiv.Perm (Fin 3)) :
    (SemidirectProduct.inl : P →* E).range ≤ normalizer (K : Set E) := by
  let : Finite E := Finite.of_equiv (P × V) SemidirectProduct.equivProd.symm
  let B : Subgroup E := (SemidirectProduct.rightHom : E →* V).ker
  let H := B ⊔ K
  have hcB : Nat.card B = 27 := by
    dsimp [B]
    rw [← SemidirectProduct.range_inl_eq_ker_rightHom]
    exact card_range
  have hi : Nat.card (B ⊓ K : Subgroup E) = 3 := by
    dsimp [B]
    rw [← SemidirectProduct.range_inl_eq_ker_rightHom, inf_comm]
    exact inf_card K e
  have hcH : Nat.card H = 54 := by
    have hm := card_mul_eq_card_inf_mul_card_sup_of_normalizes B K
      (le_normalizer_of_normal (H := B))
    rw [hcB, card_S3 K e, hi] at hm
    dsimp [H]
    omega
  let J := K.subgroupOf H
  let eJ : J ≃* Equiv.Perm (Fin 3) := (subgroupOfEquivOfLe (show K ≤ H from le_sup_right)).trans e
  have hcJ : Nat.card J = 6 := by
    rw [Nat.card_congr eJ.toEquiv]
    norm_num [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  have hidx : J.index = 9 := by
    have hm := J.card_mul_index
    rw [hcJ, hcH] at hm
    omega
  have hr := primeToResidual_eq_of_subnormal_coprime_index 2 J hs.subgroupOf
    (symmetricThree_primeToResidual eJ) (by rw [hidx]; decide)
  have hn : J.Normal := hr ▸ inferInstance
  have hnorm := (normal_subgroupOf_iff_le_normalizer (show K ≤ H from le_sup_right)).mp hn
  rw [SemidirectProduct.range_inl_eq_ker_rightHom]
  exact (show B ≤ H from le_sup_left).trans hnorm

private theorem normal_three_central (N : Subgroup P) [N.Normal] (hc : Nat.card N = 3) :
    N ≤ center P := by
  have hq : Nat.card (P ⧸ N) = 3 ^ 2 := by
    have hm := card_eq_card_quotient_mul_card_subgroup N
    rw [card_P, hc] at hm
    omega
  let : IsMulCommutative (P ⧸ N) := IsPGroup.isMulCommutative_of_card_eq_prime_sq hq
  have hd : _root_.commutator P ≤ N := Normal.quotient_commutative_iff_commutator_le.mp inferInstance
  let z : P := ⟨0, 0, 1⟩
  have hz : z ∈ N := by
    have hm := hd (commutator_mem_commutator
      (mem_top (⟨1, 0, 0⟩ : P)) (mem_top (⟨0, 1, 0⟩ : P)))
    simpa [HeisenbergPrime.commutator_coordinates, z] using hm
  have ho : orderOf z = 3 := by
    apply orderOf_eq_prime_iff.mpr
    exact ⟨HeisenbergPrime.pow_prime (by decide) z, by
      intro he
      have hh := congrArg HeisenbergPrime.c he
      exact one_ne_zero hh⟩
  have he : zpowers z = N := eq_of_le_of_card_ge (zpowers_le.mpr hz)
    (by rw [Nat.card_zpowers, ho, hc])
  rw [← he]
  apply zpowers_le.mpr
  exact (HeisenbergPrime.mem_center_iff z).mpr ⟨rfl, rfl⟩

private theorem action_faithful_coordinates : ∀ v : V,
    (heisenbergAction v rightGenerator).a = 1 →
    (heisenbergAction v leftGenerator).b = 1 → v = 1 := by
  decide +kernel

private theorem base_comap_normal (K : Subgroup E)
    (hn : (SemidirectProduct.inl : P →* E).range ≤ normalizer (K : Set E)) :
    (K.comap (SemidirectProduct.inl : P →* E)).Normal where
  conj_mem n hnmem p := by
    change (SemidirectProduct.inl : P →* E) (p * n * p⁻¹) ∈ K
    rw [map_mul, map_mul, map_inv]
    exact (mem_normalizer_iff.mp (hn ⟨p, rfl⟩) _).mp hnmem

private theorem base_comap_card (K : Subgroup E) (e : K ≃* Equiv.Perm (Fin 3)) :
    Nat.card (K.comap (SemidirectProduct.inl : P →* E)) = 3 := by
  have hm := card_map_of_injective (K := K.comap (SemidirectProduct.inl : P →* E))
    (f := (SemidirectProduct.inl : P →* E)) SemidirectProduct.inl_injective
  rw [map_comap_eq] at hm
  exact hm.symm.trans (by simpa only [inf_comm] using inf_card K e)

private theorem element_coordinates (K : Subgroup E) (e : K ≃* Equiv.Perm (Fin 3))
    (hn : (SemidirectProduct.inl : P →* E).range ≤ normalizer (K : Set E))
    (t : E) (ht : t ∈ K) : t.right = 1 := by
  let i : P →* E := SemidirectProduct.inl
  let N := K.comap i
  let : N.Normal := base_comap_normal K hn
  have hc : N ≤ center P := normal_three_central N (base_comap_card K e)
  have hcoord (p : P) : (heisenbergAction t.right p).a = p.a ∧
      (heisenbergAction t.right p).b = p.b := by
    let r : E := i p * t * (i p)⁻¹ * t⁻¹
    have hrK : r ∈ K := K.mul_mem
      ((mem_normalizer_iff.mp (hn ⟨p, rfl⟩) t).mp ht) (K.inv_mem ht)
    have hrr : r.right = 1 := by simp [r, i, SemidirectProduct.mul_right]
    have hir : i r.left = r := by
      apply SemidirectProduct.ext
      · rfl
      · simpa [i] using hrr.symm
    have hrN : r.left ∈ N := by change i r.left ∈ K; rwa [hir]
    obtain ⟨hra, hrb⟩ := (HeisenbergPrime.mem_center_iff _).mp (hc hrN)
    have he : i p * t = r * t * i p := by dsimp [r]; group
    have ha := congrArg (fun x : E => x.left.a) he
    have hb := congrArg (fun x : E => x.left.b) he
    simp only [i, SemidirectProduct.mul_left, SemidirectProduct.mul_right,
      SemidirectProduct.left_inl, SemidirectProduct.right_inl, map_one, MulAut.one_apply,
      HeisenbergPrime.mul_a, HeisenbergPrime.mul_b, hrr, hra, hrb, zero_add, one_mul] at ha hb
    exact ⟨(add_right_cancel (ha.trans (add_comm _ _))).symm,
      (add_right_cancel (hb.trans (add_comm _ _))).symm⟩
  exact action_faithful_coordinates t.right (hcoord rightGenerator).1
    (hcoord leftGenerator).2

/-- The native marked Heisenberg extension has no subnormal symmetric-three subgroup. -/
theorem no_subnormal_symmetricThree (K : Subgroup HeisenbergExtension) (hs : K.IsSubnormal)
    (he : Nonempty (K ≃* Equiv.Perm (Fin 3))) : False := by
  obtain ⟨e⟩ := he
  have hn := normalized_by_base K hs e
  have hle : K ≤ (SemidirectProduct.inl : P →* E).range := by
    intro t ht
    refine ⟨t.left, ?_⟩
    apply SemidirectProduct.ext
    · rfl
    · simpa only [SemidirectProduct.right_inl] using (element_coordinates K e hn t ht).symm
  have hd := card_dvd_of_le hle
  rw [card_S3 K e, card_range] at hd
  norm_num at hd
end MarkedCubicRecognition.SubnormalObstruction
