module
public import Theory.GroupAction.ThirteenSmallTwoGroup
public import Theory.GroupTheory.PGroup.FrattiniAutomorphismKernel
public import Theory.GroupTheory.PPerfectHom
public import Theory.GroupTheory.PResidual.PrimeTo

/-!
# Detecting thirteen-generated actions on a Frattini quotient

A two-perfect group acting on a finite two-group acts trivially if its
action on the Frattini quotient is trivial: Burnside's automorphism kernel
is a two-group. If the actor is also generated by thirteen-elements, a
nontrivial action therefore requires at least 4096 elements in the actual
Frattini quotient, rather than merely in the original group.

This combines Burnside's basis theorem with coprime fixed-point counting.
The retained-kernel application in Aschbacher--Smith 5.1.13, printed
pp.635--638, is in LocalBinaryFrattini of the local Cartan development.
-/

public noncomputable section
open Subgroup
namespace MulAut
variable {J V : Type*} [Group J] [Group V] [Finite V]

/-- A two-perfect action on a finite two-group is detected on its literal
Frattini quotient. No faithfulness of the original action is required. -/
theorem action_eq_one_of_frattini
    (hJ : IsPPerfect 2 J) (hV : IsPGroup 2 V) (f : J →* MulAut V)
    (hf : (quotientAut (frattini V)).comp f = 1) : f = 1 := by
  let g := f.codRestrict (quotientAut (frattini V)).ker
    (fun j => DFunLike.congr_fun hf j)
  have hg := hJ.hom_eq_one_of_isPGroup (isPGroup_quotientAut_frattini_kernel hV) g
  apply MonoidHom.ext
  intro j
  exact congrArg Subtype.val (DFunLike.congr_fun hg j)

/-- A nontrivial two-perfect, thirteen-generated action forces at least
twelve binary dimensions in the genuine Frattini quotient. -/
theorem thirteen_frattini_card_ge
    (hJ : IsPPerfect 2 J) (hgen : primeToResidual 13 J = ⊤)
    (hV : IsPGroup 2 V) (f : J →* MulAut V) (hf : f ≠ 1) :
    4096 ≤ Nat.card (V ⧸ frattini V) := by
  let : Fact (Nat.Prime 13) := ⟨by decide⟩
  by_contra hc
  let a := (quotientAut (frattini V)).comp f
  have hq := hV.of_surjective (QuotientGroup.mk' (frattini V))
    (QuotientGroup.mk'_surjective (frattini V))
  have hk := primeToResidual_le_ker a
    (thirteen_coprime_of_twoGroup_card_lt hq (Nat.lt_of_not_ge hc))
  rw [hgen] at hk
  apply hf
  apply action_eq_one_of_frattini hJ hV f
  exact MonoidHom.ext (fun j => hk (mem_top j))

end MulAut
