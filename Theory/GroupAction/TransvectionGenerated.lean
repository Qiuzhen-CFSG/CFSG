module

public import Mathlib.GroupTheory.Index
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Algebra.Group.Conj
public import Mathlib.Tactic
open Subgroup

/-!
# The subgroup generated by binary transvections

For subgroups R and E, take the subgroup generated by elements of R whose
fixed subgroup in E has index at most two. When E is elementary abelian and
R acts on E this is the preimage of the subgroup generated by transvections,
including the action kernel. Conjugation preserving R and E preserves this
subgroup. It cannot exchange disjoint supports of order greater than two:
a moved support injects into the cosets of the element centralizer in E.

Source: Aschbacher–Smith, proof of C.5.6, printed p.157.
-/

@[expose] public section

namespace Subgroup
variable {G : Type*} [Group G]
noncomputable def transvectionGenerated (R E : Subgroup G) : Subgroup G :=
  closure {r | r ∈ R ∧ (centralizer ({r} : Set G)).relIndex E ≤ 2}

 theorem transvectionGenerated_le (R E : Subgroup G) : transvectionGenerated R E ≤ R :=
  (closure_le R).mpr fun _ h => h.1

 theorem mem_transvectionGenerated {R E : Subgroup G} {r : G} (hr : r ∈ R)
    (hi : (centralizer ({r} : Set G)).relIndex E ≤ 2) : r ∈ transvectionGenerated R E :=
  subset_closure ⟨hr, hi⟩

 theorem centralizer_le_transvectionGenerated (R E : Subgroup G) :
    R ⊓ centralizer (E : Set G) ≤ transvectionGenerated R E := by
  intro r hr
  apply mem_transvectionGenerated hr.1
  have he : E ≤ centralizer ({r} : Set G) := by
    intro e he
    rw [mem_centralizer_singleton_iff]
    exact (mem_centralizer_iff.mp hr.2 e he)
  rw [relIndex_eq_one.mpr he]
  decide

private theorem map_singleton_centralizer (e : G ≃* G) (r : G) :
    (centralizer ({r} : Set G)).map e.toMonoidHom = centralizer ({e r} : Set G) := by
  ext g
  constructor
  · rintro ⟨h, hh, rfl⟩
    apply mem_centralizer_singleton_iff.mpr
    simpa only [map_mul, MulEquiv.coe_toMonoidHom] using congrArg e (mem_centralizer_singleton_iff.mp hh)
  · intro hg
    refine ⟨e.symm g, ?_, e.apply_symm_apply g⟩
    apply mem_centralizer_singleton_iff.mpr
    apply e.injective
    simpa only [map_mul, e.apply_symm_apply] using (mem_centralizer_singleton_iff.mp hg)

 theorem map_transvectionGenerated (e : G ≃* G) (R E : Subgroup G) :
    (transvectionGenerated R E).map e.toMonoidHom =
      transvectionGenerated (R.map e.toMonoidHom) (E.map e.toMonoidHom) := by
  unfold transvectionGenerated
  rw [MonoidHom.map_closure]
  congr 1
  ext r
  constructor
  · rintro ⟨s, hs, rfl⟩
    refine ⟨mem_map_of_mem _ hs.1, ?_⟩
    have heq : centralizer ({e s} : Set G) = (centralizer ({s} : Set G)).map e.toMonoidHom := (map_singleton_centralizer e s).symm
    change (centralizer ({e s} : Set G)).relIndex (E.map e.toMonoidHom) ≤ 2
    rw [heq, relIndex_map_map_of_injective _ _ e.injective]
    exact hs.2
  · rintro ⟨⟨s, hs, rfl⟩, hi⟩
    refine ⟨s, ⟨hs, ?_⟩, rfl⟩
    have heq : centralizer ({e s} : Set G) = (centralizer ({s} : Set G)).map e.toMonoidHom := (map_singleton_centralizer e s).symm
    change (centralizer ({e s} : Set G)).relIndex (E.map e.toMonoidHom) ≤ 2 at hi
    rwa [heq, relIndex_map_map_of_injective _ _ e.injective] at hi

 theorem normalizer_transvectionGenerated (R E : Subgroup G) :
    normalizer (R : Set G) ⊓ normalizer (E : Set G) ≤
      normalizer (transvectionGenerated R E : Set G) := by
  intro x hx
  rw [mem_normalizer_iff_map_conj_eq]
  change (transvectionGenerated R E).map (MulAut.conj x).toMonoidHom = _
  rw [map_transvectionGenerated]
  have hR : R.map (MulAut.conj x).toMonoidHom = R := mem_normalizer_iff_map_conj_eq.mp hx.1
  have hE : E.map (MulAut.conj x).toMonoidHom = E := mem_normalizer_iff_map_conj_eq.mp hx.2
  rw [hR, hE]

 theorem card_le_centralizer_relIndex_of_disjoint_conjugate
    [Finite G] (E F : Subgroup G) (hFE : F ≤ E) (r : G)
    (hd : Disjoint F (F.map (MulAut.conj r).toMonoidHom)) :
    Nat.card F ≤ (centralizer ({r} : Set G)).relIndex E := by
  have hi : centralizer ({r} : Set G) ⊓ F = ⊥ := by
    apply (eq_bot_iff_forall _).mpr
    intro f hf
    have hfix : MulAut.conj r f = f := by
      change r * f * r⁻¹ = f
      rw [← mem_centralizer_singleton_iff.mp hf.1, mul_inv_cancel_right]
    exact hd.le_bot ⟨hf.2, hfix ▸ mem_map_of_mem (MulAut.conj r).toMonoidHom hf.2⟩
  have hindex : (centralizer ({r} : Set G)).relIndex F = Nat.card F := by
    rw [← inf_relIndex_right, hi, relIndex_bot_left]
  rw [← hindex]
  exact relIndex_le_of_le_right hFE index_ne_zero_of_finite

 theorem transvectionGenerated_le_normalizer_of_pair
    [Finite G] (R E F F' : Subgroup G) (hFE : F ≤ E)
    (hcard : 2 < Nat.card F) (hdisj : Disjoint F F')
    (hperm : ∀ r ∈ R, F.map (MulAut.conj r).toMonoidHom = F ∨
      F.map (MulAut.conj r).toMonoidHom = F') :
    transvectionGenerated R E ≤ normalizer (F : Set G) := by
  apply (closure_le _).mpr
  rintro r ⟨hr, hi⟩
  rcases hperm r hr with he | he
  · exact mem_normalizer_iff_map_conj_eq.mpr he
  · have hc := card_le_centralizer_relIndex_of_disjoint_conjugate E F hFE r
      (he ▸ hdisj)
    omega
end Subgroup

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- A transvection cannot move a subgroup onto a competing subgroup disjoint
from a support of order greater than two. This detects the source block
stabilizer, without requiring the support to determine the whole block. -/
theorem transvectionGenerated_le_normalizer_of_disjoint_support
    (R E K L F : Subgroup G) (hFE : F ≤ E) (hFK : F ≤ K)
    (hcard : 2 < Nat.card F) (hdisj : Disjoint F L)
    (hperm : ∀ r ∈ R, K.map (MulAut.conj r).toMonoidHom = K ∨
      K.map (MulAut.conj r).toMonoidHom = L) :
    transvectionGenerated R E ≤ normalizer (K : Set G) := by
  apply (closure_le _).mpr
  rintro r ⟨hr, hi⟩
  rcases hperm r hr with he | he
  · exact mem_normalizer_iff_map_conj_eq.mpr he
  · have hm : F.map (MulAut.conj r).toMonoidHom ≤ L :=
      (map_mono hFK).trans_eq he
    have hc := card_le_centralizer_relIndex_of_disjoint_conjugate E F hFE r
      (hdisj.mono_right hm)
    omega
end Subgroup

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- The fixed-index-at-most-two definition is exactly the action kernel
joined with the subgroup generated by genuine index-two transvections. -/
theorem transvectionGenerated_eq_kernel_sup (R E : Subgroup G) :
    transvectionGenerated R E = (R ⊓ centralizer (E : Set G)) ⊔
      closure {r | r ∈ R ∧ (centralizer ({r} : Set G)).relIndex E = 2} := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro r ⟨hr, hi⟩
    have hp : 0 < (centralizer ({r} : Set G)).relIndex E :=
      Nat.pos_of_ne_zero index_ne_zero_of_finite
    have hc : (centralizer ({r} : Set G)).relIndex E = 1 ∨
        (centralizer ({r} : Set G)).relIndex E = 2 := by omega
    rcases hc with hc | hc
    · apply mem_sup_left
      refine ⟨hr, ?_⟩
      intro e he
      exact mem_centralizer_singleton_iff.mp (relIndex_eq_one.mp hc he)
    · exact mem_sup_right (subset_closure ⟨hr, hc⟩)
  · apply sup_le (centralizer_le_transvectionGenerated R E)
    apply (closure_le _).mpr
    rintro r ⟨hr, hi⟩
    exact mem_transvectionGenerated hr hi.le
end Subgroup
