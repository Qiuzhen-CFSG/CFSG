module

public import Theory.Character.BrauerInductionSpan
public import Theory.Character.InductionTransitivity
public import Theory.Character.MinimalDegree
public import Theory.Character.NilpotentMonomial

/-!
# Monomial characters and the induced linear-character lattice

Induction carries the linear-character lattice of a subgroup into the ambient
linear-character lattice, by transitivity. Natural-multiplicity decomposition
then reduces membership for all ordinary characters to membership for
irreducibles. In particular, monomiality of the irreducibles of a subgroup
implies the required membership for every character induced from that subgroup.

These are the induction and decomposition steps in applying the monomiality
theorem for finite nilpotent groups. Source: Serre, *Linear Representations of
Finite Groups*, the treatment of induction and monomial representations.
The final theorems discharge monomiality for finite nilpotent groups.
-/

public section
noncomputable section
open scoped BigOperators
attribute [local instance] Fintype.ofFinite
attribute [local instance] Classical.propDecidable

namespace BrauerInduction
variable {G : Type*} [Group G] [Fintype G]

/-- Induction preserves the integer lattice generated by induced linear characters. -/
theorem inducedLinearSpan_le_comap (H : Subgroup G) :
    inducedLinearSpan H ≤
      (inducedLinearSpan G).comap (inducedClassFunctionIntLinear H) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨K, χ⟩, rfl⟩
  change inducedClassFunction H (inducedClassFunction K χ) ∈ inducedLinearSpan G
  rw [inducedClassFunction_trans]
  exact inducedLinear_mem (K.map H.subtype)
    (χ.comp (K.equivMapOfInjective H.subtype H.subtype_injective).symm.toMonoidHom)

/-- A subgroup's integral induction formula induces to an ambient formula. -/
theorem induced_mem_inducedLinearSpan (H : Subgroup G) {φ : ClassFunction H}
    (hφ : φ ∈ inducedLinearSpan H) :
    inducedClassFunction H φ ∈ inducedLinearSpan G :=
  inducedLinearSpan_le_comap H hφ

/-- It suffices to put irreducibles in the linear-character lattice: every ordinary
character is a sum of irreducibles with natural multiplicities. -/
theorem character_mem_inducedLinearSpan_of_irreducible
    (hirr : ∀ χ : ClassFunction G, IsIrreducibleCharacter χ → χ ∈ inducedLinearSpan G)
    {φ : ClassFunction G} (hφ : IsCharacter φ) : φ ∈ inducedLinearSpan G := by
  classical
  obtain ⟨n, ρ, rfl⟩ := hφ
  obtain ⟨ι, hι, χ, m, hχ, _, _, _, hsum⟩ :=
    Theory.Character.exists_natural_character_decomposition ρ
  let := hι
  have heq : ρ.character = ∑ i, (m i : ℤ) • χ i := by
    ext g
    simpa only [Finset.sum_apply, Pi.smul_apply, zsmul_eq_mul, Int.cast_natCast,
      Pi.mul_apply, Pi.intCast_apply, Pi.natCast_apply]
      using hsum g
  rw [heq]
  exact Submodule.sum_mem _ fun i _ =>
    Submodule.smul_mem _ (m i : ℤ) (hirr (χ i) (hχ i))

/-- Monomiality of irreducibles implies the integral induction formula for every
ordinary character of the group. -/
theorem character_mem_inducedLinearSpan_of_monomial
    (hmonomial : ∀ χ : ClassFunction G, IsIrreducibleCharacter χ →
      ∃ (K : Subgroup G) (linear : K →* ℂ), χ = inducedClassFunction K linear)
    {φ : ClassFunction G} (hφ : IsCharacter φ) : φ ∈ inducedLinearSpan G := by
  apply character_mem_inducedLinearSpan_of_irreducible (fun χ hχ => ?_) hφ
  obtain ⟨K, linear, rfl⟩ := hmonomial χ hχ
  exact inducedLinear_mem K linear

/-- The final induction step for a subgroup whose irreducibles are monomial. -/
theorem induced_character_mem_inducedLinearSpan_of_monomial (H : Subgroup G)
    (hmonomial : ∀ χ : ClassFunction H, IsIrreducibleCharacter χ →
      ∃ (K : Subgroup H) (linear : K →* ℂ), χ = inducedClassFunction K linear)
    {φ : ClassFunction H} (hφ : IsCharacter φ) :
    inducedClassFunction H φ ∈ inducedLinearSpan G :=
  induced_mem_inducedLinearSpan H
    (character_mem_inducedLinearSpan_of_monomial hmonomial hφ)

/-- Every ordinary character of a finite nilpotent group belongs to the integer
lattice generated by characters induced from linear characters of subgroups. -/
theorem character_mem_inducedLinearSpan_of_nilpotent (hG : Group.IsNilpotent G)
    {φ : ClassFunction G} (hφ : IsCharacter φ) : φ ∈ inducedLinearSpan G :=
  character_mem_inducedLinearSpan_of_monomial
    (fun _ hχ => Theory.Character.nilpotent_irreducible_monomial hG hχ) hφ

/-- Inducing an ordinary character of a finite nilpotent subgroup gives an
integer linear combination of characters induced from linear characters. -/
theorem induced_character_mem_inducedLinearSpan_of_nilpotent (H : Subgroup G)
    (hH : Group.IsNilpotent H) {φ : ClassFunction H} (hφ : IsCharacter φ) :
    inducedClassFunction H φ ∈ inducedLinearSpan G :=
  induced_mem_inducedLinearSpan H (character_mem_inducedLinearSpan_of_nilpotent hH hφ)

end BrauerInduction
