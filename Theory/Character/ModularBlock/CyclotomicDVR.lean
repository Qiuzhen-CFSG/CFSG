module

public import Theory.Character.ModularBlock.Congruence
public import Mathlib.RingTheory.DedekindDomain.Dvr

/-!
# The local cyclotomic coefficient ring is a DVR

The ordinary block construction localizes the cyclotomic integer order at a
maximal ideal above `2`.  This file records the number-theoretic fact that the
order is Dedekind, and hence that this localization is a discrete valuation
ring. The proof identifies the cyclotomic order with the integral closure
of the integers in its generated cyclotomic field, transfers the Dedekind
properties across this ring equivalence, and applies the localization theorem.
The chosen prime is nonzero because it contains two. Finite generation over
the integers also proves finiteness of quotients by nonzero ideals.

Ported from `public/lean-eval/glauberman_zStar`,
`Submission/ZStar/CyclotomicDVR.lean` (revision `c3503435`). These coefficient
ring facts support the integral-lattice and finite-residue-field block
arguments; no block-support statement is assumed.
-/

public section

noncomputable section

namespace ModularBlock

namespace CyclotomicDVR

open scoped IntermediateField

open PrincipalBlockConstruction

private noncomputable def intAdjoinToCyclotomicOrderRingHom
    {eta : ℂ}
    (K := IntermediateField.adjoin ℚ ({eta} : Set ℂ))
    (etaK : K) (hetaK : (etaK : ℂ) = eta) :
    Algebra.adjoin ℤ ({etaK} : Set K) →+*
      cyclotomicOrder eta where
  toFun z :=
    ⟨((z : K) : ℂ), BlockPreliminaries.intAdjoin_coe_mem_cyclotomicOrder K etaK hetaK z⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

private theorem intAdjoinToCyclotomicOrderRingHom_bijective
    {eta : ℂ}
    (K := IntermediateField.adjoin ℚ ({eta} : Set ℂ))
    (etaK : K) (hetaK : (etaK : ℂ) = eta) :
    Function.Bijective
      (intAdjoinToCyclotomicOrderRingHom K etaK hetaK) := by
  constructor
  · intro x y hxy
    apply Subtype.ext
    apply K.val.injective
    exact congrArg
      (fun q : cyclotomicOrder eta => (q : ℂ)) hxy
  · intro z
    let f := intAdjoinToCyclotomicOrderRingHom K etaK hetaK
    change ∃ x, f x = z
    refine Subring.closure_induction
      (p := fun x hx =>
        ∃ w, f w = (⟨x, hx⟩ : cyclotomicOrder eta))
      ?_ ?_ ?_ ?_ ?_ ?_ z.property
    · intro x hx
      simp only [Set.mem_singleton_iff] at hx
      subst x
      let w : Algebra.adjoin ℤ ({etaK} : Set K) :=
        ⟨etaK, Algebra.subset_adjoin (by simp)⟩
      refine ⟨w, ?_⟩
      apply Subtype.ext
      exact hetaK
    · exact ⟨0, map_zero f⟩
    · exact ⟨1, map_one f⟩
    · intro x y hx hy
      rintro ⟨wx, hwx⟩ ⟨wy, hwy⟩
      refine ⟨wx + wy, ?_⟩
      rw [map_add, hwx, hwy]
      rfl
    · intro x hx
      rintro ⟨wx, hwx⟩
      refine ⟨-wx, ?_⟩
      rw [map_neg, hwx]
      rfl
    · intro x y hx hy
      rintro ⟨wx, hwx⟩ ⟨wy, hwy⟩
      refine ⟨wx * wy, ?_⟩
      rw [map_mul, hwx, hwy]
      rfl

private noncomputable def intAdjoinCyclotomicOrderEquiv
    {eta : ℂ}
    (K := IntermediateField.adjoin ℚ ({eta} : Set ℂ))
    (etaK : K) (hetaK : (etaK : ℂ) = eta) :
    Algebra.adjoin ℤ ({etaK} : Set K) ≃+*
      cyclotomicOrder eta :=
  RingEquiv.ofBijective
    (intAdjoinToCyclotomicOrderRingHom K etaK hetaK)
    (intAdjoinToCyclotomicOrderRingHom_bijective K etaK hetaK)

/-- A cyclotomic order generated by a primitive root of positive order is a
Dedekind domain. -/
theorem cyclotomicOrder_isDedekindDomain
    {n : ℕ} (hn : n ≠ 0) {eta : ℂ} (heta : IsPrimitiveRoot eta n) :
    IsDedekindDomain (cyclotomicOrder eta) := by
  let K := IntermediateField.adjoin ℚ ({eta} : Set ℂ)
  let etaK : K :=
    ⟨eta, IntermediateField.subset_adjoin ℚ ({eta} : Set ℂ) (by simp)⟩
  have hetaKcoe : (etaK : ℂ) = eta := rfl
  have hetaK : IsPrimitiveRoot etaK n := by
    apply IsPrimitiveRoot.of_map_of_injective (f := K.val)
      (by simpa [K, etaK] using heta)
    exact K.val.injective
  let : NeZero n := ⟨hn⟩
  have htopIF : IntermediateField.adjoin ℚ ({etaK} : Set K) = ⊤ := by
    exact BlockPreliminaries.adjoin_generator_eq_top (η := eta)
  have hetaKalg : IsAlgebraic ℚ etaK := by
    apply IsAlgebraic.of_pow (Nat.pos_of_ne_zero hn)
    rw [hetaK.pow_eq_one]
    exact isAlgebraic_one
  have htopAlg : Algebra.adjoin ℚ ({etaK} : Set K) = ⊤ :=
    Algebra.adjoin_eq_top_of_intermediateField
      (by
        intro x hx
        simp only [Set.mem_singleton_iff] at hx
        subst x
        exact hetaKalg) htopIF
  let eK : (Algebra.adjoin ℚ ({etaK} : Set K)) ≃ₐ[ℚ] K :=
    (Subalgebra.equivOfEq _ _ htopAlg).trans Subalgebra.topEquiv
  let hcyclAdjoin : IsCyclotomicExtension {n} ℚ
      (Algebra.adjoin ℚ ({etaK} : Set K)) :=
    hetaK.adjoin_isCyclotomicExtension ℚ
  let : IsCyclotomicExtension {n} ℚ K :=
    IsCyclotomicExtension.equiv {n} ℚ _ eK
  let : IsGalois ℚ K := IsCyclotomicExtension.isGalois {n} ℚ K
  let : FiniteDimensional ℚ K :=
    IsCyclotomicExtension.finiteDimensional {n} ℚ K
  let : Algebra ℤ K := Ring.toIntAlgebra K
  let Aint := Algebra.adjoin ℤ ({etaK} : Set K)
  let : IsIntegralClosure Aint ℤ K := by
    simpa [Aint] using
      (IsCyclotomicExtension.Rat.isIntegralClosure_adjoin_singleton hetaK)
  let : IsDedekindDomain Aint :=
    IsIntegralClosure.isDedekindDomain ℤ ℚ K Aint
  let E : Aint ≃+* cyclotomicOrder eta :=
    intAdjoinCyclotomicOrderEquiv K etaK hetaKcoe
  let : IsDomain (cyclotomicOrder eta) :=
    E.symm.toMulEquiv.isDomain Aint
  let : IsNoetherianRing (cyclotomicOrder eta) :=
    isNoetherianRing_of_ringEquiv Aint E
  let : Ring.DimensionLEOne (cyclotomicOrder eta) :=
    Ring.DimensionLEOne.of_ringEquiv E.symm
  let : IsIntegrallyClosed (cyclotomicOrder eta) :=
    IsIntegrallyClosed.of_equiv E
  apply (isDedekindDomain_iff
    (cyclotomicOrder eta)
    (FractionRing (cyclotomicOrder eta))).2
  exact ⟨inferInstance, inferInstance, inferInstance,
    (isIntegrallyClosed_iff
      (FractionRing (cyclotomicOrder eta))).mp inferInstance⟩

/-! The finite-quotient consequence is useful when passing between the
cyclotomic residue fields attached to a group and to a subgroup. -/

theorem cyclotomicOrder_moduleFinite_int
    {n : ℕ} (hn : n ≠ 0) {eta : ℂ}
    (heta : IsPrimitiveRoot eta n) :
    Module.Finite ℤ (cyclotomicOrder eta) := by
  let K := IntermediateField.adjoin ℚ ({eta} : Set ℂ)
  let etaK : K :=
    ⟨eta, IntermediateField.subset_adjoin ℚ ({eta} : Set ℂ) (by simp)⟩
  have hetaKcoe : (etaK : ℂ) = eta := rfl
  have hetaKalg : IsIntegral ℤ etaK := by
    apply IsIntegral.of_pow (Nat.pos_of_ne_zero hn)
    rw [show etaK ^ n = 1 by
      apply Subtype.ext
      exact heta.pow_eq_one]
    exact isIntegral_one
  let Aint := Algebra.adjoin ℤ ({etaK} : Set K)
  let : Module.Finite ℤ Aint :=
    Algebra.finite_adjoin_simple_of_isIntegral hetaKalg
  let E : Aint ≃+* cyclotomicOrder eta :=
    intAdjoinCyclotomicOrderEquiv K etaK hetaKcoe
  let Ealg : Aint ≃ₐ[ℤ] cyclotomicOrder eta :=
    { E with
      commutes' := by intro z; rfl }
  exact Module.Finite.equiv Ealg.toLinearEquiv

theorem cyclotomicOrder_hasFiniteQuotients
    {n : ℕ} (hn : n ≠ 0) {eta : ℂ}
    (heta : IsPrimitiveRoot eta n) :
    Ring.HasFiniteQuotients (cyclotomicOrder eta) := by
  let : IsDedekindDomain (cyclotomicOrder eta) :=
    cyclotomicOrder_isDedekindDomain hn heta
  let : Module.Finite ℤ (cyclotomicOrder eta) :=
    cyclotomicOrder_moduleFinite_int hn heta
  let : AddGroup.FG (cyclotomicOrder eta) :=
    Module.Finite.iff_addGroup_fg.mp inferInstance
  infer_instance

theorem cyclotomicOrder_quotient_finite
    {n : ℕ} (hn : n ≠ 0) {eta : ℂ}
    (heta : IsPrimitiveRoot eta n)
    (P : Ideal (cyclotomicOrder eta)) (hP : P ≠ ⊥) :
    Finite (cyclotomicOrder eta ⧸ P) := by
  let : Ring.HasFiniteQuotients (cyclotomicOrder eta) :=
    cyclotomicOrder_hasFiniteQuotients hn heta
  exact Ring.HasFiniteQuotients.finiteQuotient hP

/-- The localization used by a principal congruence block is a DVR. -/
instance principalPrime_isPrime
    {G : Type*} [Group G] [Finite G]
    (d : PrincipalCongruenceBlockData G) : d.primeIdeal.IsPrime :=
  d.primeIdeal_maximal.isPrime

theorem cyclotomicOrderAtPrime_isDiscreteValuationRing
    {G : Type*} [Group G] [Finite G]
    (d : PrincipalCongruenceBlockData G) :
    IsDiscreteValuationRing (Localization.AtPrime d.primeIdeal) := by
  let : IsDedekindDomain (cyclotomicOrder d.eta) :=
    cyclotomicOrder_isDedekindDomain
      (Nat.card_pos (α := G)).ne' d.eta_spec
  have hprime_ne_bot : d.primeIdeal ≠ ⊥ := by
    intro hbot
    have htwo := BlockPreliminaries.two_mem_of_liesOver
      d.primeIdeal d.primeIdeal_liesOverTwo
    rw [hbot, Ideal.mem_bot] at htwo
    exact two_ne_zero htwo
  exact IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain
    (cyclotomicOrder d.eta)
    hprime_ne_bot
    (Localization.AtPrime d.primeIdeal)

end CyclotomicDVR

end ModularBlock

