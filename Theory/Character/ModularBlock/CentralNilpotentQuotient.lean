module

public import Theory.Character.ModularBlock.PrimitiveCentralIdempotent
public import Mathlib.RingTheory.Artinian.Ring
public import Mathlib.RingTheory.Idempotents
public import Mathlib.RingTheory.Nilpotent.Basic

/-!
# Primitive central idempotents modulo centrally generated nilpotent ideals

A surjection from a finite ring preserves centrally primitive idempotents if
its kernel is generated by central nilpotent elements. The generators lie in
the Jacobson radical, which is nilpotent in a finite ring. Idempotents lift by
`exists_isIdempotentElem_eq_of_ker_isNilpotent` from
`Mathlib.RingTheory.Idempotents`.

Centrality requires a separate argument in a noncommutative ring. If the
image of an idempotent `e` is central, every off-diagonal corner `e*a*(1-e)`
lies in the kernel. Central generation lets this containment iterate through
all powers of the kernel. Nilpotence kills both off-diagonal corners, proving
that `e` itself is central. Lifting central factors then proves primitivity.
-/

namespace ModularBlock

variable {A B : Type*} [Ring A] [Ring B]

private lemma central_nilpotent_mem_jacobson {z : A}
    (hz : z ∈ Set.center A) (hn : IsNilpotent z) :
    z ∈ Ideal.jacobson (⊥ : Ideal A) := by
  apply Ideal.mem_jacobson_iff.mpr
  intro a
  have hc : Commute a z := Semigroup.mem_center_iff.mp hz a
  obtain ⟨u, hu⟩ := (hc.isNilpotent_mul_left hn).isUnit_add_one
  refine ⟨↑u⁻¹, ?_⟩
  rw [Ideal.mem_bot, mul_assoc, ← mul_add_one, ← hu]
  simp

private lemma ker_pow_eq_bot_of_central_nilpotent_span [Finite A]
    (f : A →+* B) (s : Set A)
    (hker : RingHom.ker f = Ideal.span s)
    (hs : ∀ z ∈ s, z ∈ Set.center A ∧ IsNilpotent z) :
    ∃ n : ℕ, RingHom.ker f ^ n = ⊥ := by
  let : IsArtinianRing A := isArtinian_of_finite
  obtain ⟨n, hn⟩ := IsArtinianRing.isNilpotent_jacobson_bot (R := A)
  refine ⟨n, le_bot_iff.mp ?_⟩
  have hk : RingHom.ker f ≤ Ideal.jacobson (⊥ : Ideal A) := by
    rw [hker]
    exact Ideal.span_le.mpr fun z hz => central_nilpotent_mem_jacobson (hs z hz).1 (hs z hz).2
  exact (Ideal.pow_right_mono hk n).trans (le_of_eq hn)

private lemma offDiagonal_mem_ker_pow (f : A →+* B) (s : Set A)
    (hker : RingHom.ker f = Ideal.span s)
    (hs : ∀ z ∈ s, z ∈ Set.center A)
    {e : A} (he : IsIdempotentElem e) (hc : f e ∈ Set.center B)
    (n : ℕ) (a : A) : e * a * (1 - e) ∈ RingHom.ker f ^ n := by
  have hbase (b : A) : e * b * (1 - e) ∈ RingHom.ker f := by
    rw [RingHom.mem_ker, map_mul, map_mul, map_sub, map_one,
      ← Semigroup.mem_center_iff.mp hc (f b), mul_assoc, mul_sub,
      mul_one, ← map_mul, he.eq, sub_self, mul_zero]
  induction n generalizing a with
  | zero => simp [Submodule.pow_zero, Ideal.one_eq_top]
  | succ n ih =>
    have hspan : ∀ x ∈ Ideal.span s, ∀ b : A,
        e * (b * x) * (1 - e) ∈ RingHom.ker f ^ (n + 1) := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem z hz =>
        intro b
        have hcz := Semigroup.mem_center_iff.mp (hs z hz) (1 - e)
        rw [← mul_assoc, mul_assoc (e * b), ← hcz, ← mul_assoc,
          Submodule.pow_succ]
        exact Ideal.mul_mem_mul (ih b) (hker ▸ Ideal.subset_span hz)
      | zero => intro b; simp
      | add x y hx hy hix hiy =>
        intro b
        simpa only [mul_add, add_mul] using
          (RingHom.ker f ^ (n + 1)).add_mem (hix b) (hiy b)
      | smul c x hx hix =>
        intro b
        simpa only [smul_eq_mul, ← mul_assoc b c x] using hix (b * c)
    have ht := hspan (e * a * (1 - e)) (hker ▸ hbase a) 1
    have hp : e * (1 * (e * a * (1 - e))) * (1 - e) =
        e * a * (1 - e) := by
      rw [one_mul, ← mul_assoc, ← mul_assoc, he.eq,
        mul_assoc (e * a), he.one_sub.eq]
    rwa [hp] at ht

private lemma central_of_central_image_of_ker_central_span
    (f : A →+* B) (s : Set A)
    (hker : RingHom.ker f = Ideal.span s)
    (hs : ∀ z ∈ s, z ∈ Set.center A)
    (hn : ∃ n : ℕ, RingHom.ker f ^ n = ⊥)
    {e : A} (he : IsIdempotentElem e) (hc : f e ∈ Set.center B) :
    e ∈ Set.center A := by
  obtain ⟨n, hn⟩ := hn
  have hoff (d : A) (hd : IsIdempotentElem d) (hdc : f d ∈ Set.center B) (a : A) :
      d * a * (1 - d) = 0 := by
    have ht := offDiagonal_mem_ker_pow f s hker hs hd hdc n a
    rwa [hn, Ideal.mem_bot] at ht
  apply Semigroup.mem_center_iff.mpr
  intro a
  have h₁ := hoff e he hc a
  have hc' : f (1 - e) ∈ Set.center B := by
    rw [map_sub, map_one]
    exact (Subring.center B).sub_mem (Subring.center B).one_mem hc
  have h₂ := hoff (1 - e) he.one_sub hc' a
  simp only [sub_sub_cancel, sub_mul, one_mul] at h₂
  rw [mul_sub, mul_one] at h₁
  exact (sub_eq_zero.mp h₂).trans (sub_eq_zero.mp h₁).symm

private lemma isNilpotent_of_mem_ker_of_pow_eq_bot
    (f : A →+* B) (hn : ∃ n : ℕ, RingHom.ker f ^ n = ⊥)
    {x : A} (hx : x ∈ RingHom.ker f) : IsNilpotent x := by
  obtain ⟨n, hn⟩ := hn
  exact ⟨n, Ideal.mem_bot.mp (hn ▸ Ideal.pow_mem_pow hx n)⟩

private lemma exists_central_idempotent_lift
    (f : A →+* B) (hf : Function.Surjective f) (s : Set A)
    (hker : RingHom.ker f = Ideal.span s)
    (hs : ∀ z ∈ s, z ∈ Set.center A)
    (hn : ∃ n : ℕ, RingHom.ker f ^ n = ⊥)
    {e : B} (he : IsIdempotentElem e) (hc : e ∈ Set.center B) :
    ∃ d : A, d ∈ Set.center A ∧ IsIdempotentElem d ∧ f d = e := by
  obtain ⟨d, hd, hde⟩ := exists_isIdempotentElem_eq_of_ker_isNilpotent f
    (fun x hx => isNilpotent_of_mem_ker_of_pow_eq_bot f hn hx) e (hf e) he
  exact ⟨d, central_of_central_image_of_ker_central_span f s hker hs hn hd
    (hde ▸ hc), hd, hde⟩

/-- Surjective maps with centrally generated nilpotent kernels preserve
primitive central idempotents of finite rings. -/
public theorem IsCentrallyPrimitive.map_of_central_nilpotent_ker [Finite A]
    (f : A →+* B) (hf : Function.Surjective f) (s : Set A)
    (hker : RingHom.ker f = Ideal.span s)
    (hs : ∀ z ∈ s, z ∈ Set.center A ∧ IsNilpotent z)
    {e : A} (he : IsCentrallyPrimitive e) : IsCentrallyPrimitive (f e) := by
  have hn := ker_pow_eq_bot_of_central_nilpotent_span f s hker hs
  have hc : f e ∈ Set.center B := by
    apply Semigroup.mem_center_iff.mpr
    intro b
    obtain ⟨a, rfl⟩ := hf b
    simpa only [map_mul] using congrArg f (Semigroup.mem_center_iff.mp he.1 a)
  have hne : f e ≠ 0 := by
    intro hzero
    exact he.2.2.1 (he.2.1.eq_zero_of_isNilpotent
      (isNilpotent_of_mem_ker_of_pow_eq_bot f hn (RingHom.mem_ker.mpr hzero)))
  refine ⟨hc, he.2.1.map f, hne, ?_⟩
  intro b hb hbi hbe hbne
  obtain ⟨d, hd, hdi, hdb⟩ := exists_central_idempotent_lift f hf s hker
    (fun z hz => (hs z hz).1) hn hbi hb
  have hprod : f (d * e) = b := by rw [map_mul, hdb, hbe]
  have hdene : d * e ≠ 0 := by
    intro hz
    exact hbne (hprod.symm.trans (by rw [hz, map_zero]))
  have hde : d * e = e := he.2.2.2 (d * e) (Set.mul_mem_center hd he.1)
    (hdi.mul_of_commute (Semigroup.mem_center_iff.mp hd e).symm he.2.1)
    (by rw [mul_assoc, he.2.1.eq]) hdene
  exact hprod.symm.trans (congrArg f hde)

end ModularBlock
