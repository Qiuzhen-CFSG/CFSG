module

public import Theory.Character.ModularBlock.Congruence

/-!
# Principal congruence blocks compatible with a subgroup

For a subgroup `H ≤ G`, a primitive `|G|`-th root has a canonical power
which is primitive of order `|H|`.  The cyclotomic order generated by that
power embeds in the ambient cyclotomic order, and contraction of the ambient
prime above `2` is again maximal and lies above `2`.  This supplies local
principal congruence-block data using the same modular place as the ambient
data.

The root inclusion is integral because the ambient root has a positive power
in the smaller order. Contraction therefore preserves maximality, and the
scalar tower proves lying over two. The induced residue-field and localized
ring maps are canonical inclusions. The character family is chosen from the
already proved principal-block construction; the root and prime fields are
then replaced by their compatible values. Definitions are exposed so these
root and prime fields reduce to the canonical subgroup data.

Ported from `public/lean-eval/glauberman_zStar`,
`Submission/ZStar/CompatibleLocalBlock.lean` (revision `c3503435`).
-/

public section

noncomputable section

namespace ModularBlock

namespace CompatibleLocalBlock

open PrincipalBlockConstruction

universe u

attribute [local instance] Fintype.ofFinite

/-- Inclusion of the cyclotomic order generated by `xi` into the one
generated by `eta`, given membership of `xi` in the latter. -/
@[expose] def cyclotomicOrderInclusion
    {eta xi : ℂ} (hxi : xi ∈ cyclotomicOrder eta) :
    cyclotomicOrder xi →+*
      cyclotomicOrder eta :=
  Subring.inclusion (by
    rw [cyclotomicOrder, Subring.closure_le]
    intro x hx
    simp only [Set.mem_singleton_iff] at hx
    simpa [hx] using hxi)

/-- If `xi = eta ^ q` with `q > 0`, the induced inclusion of cyclotomic
orders is integral. -/
theorem cyclotomicOrderInclusion_isIntegral
    {eta xi : ℂ} (hxi : xi ∈ cyclotomicOrder eta)
    {q : ℕ} (hq : 0 < q) (hpow : eta ^ q = xi) :
    (cyclotomicOrderInclusion hxi).IsIntegral := by
  let A := cyclotomicOrder xi
  let B := cyclotomicOrder eta
  let f : A →+* B := cyclotomicOrderInclusion hxi
  let : Algebra A B := f.toAlgebra
  intro x
  change IsIntegral A x
  let etaB : B := ⟨eta, eta_mem_cyclotomicOrder eta⟩
  have hetaPow : etaB ^ q =
      algebraMap A B ⟨xi, eta_mem_cyclotomicOrder xi⟩ := by
    apply Subtype.ext
    exact hpow
  have hetaInt : IsIntegral A etaB := by
    apply IsIntegral.of_pow hq
    rw [hetaPow]
    exact isIntegral_algebraMap
  have hxclosure : x ∈ Subring.closure ({etaB} : Set B) := by
    let C : Subring B := Subring.closure ({etaB} : Set B)
    have himage : B.subtype '' ({etaB} : Set B) = ({eta} : Set ℂ) := by
      ext y
      simp [etaB]
    have hmap : C.map B.subtype = B := by
      dsimp [C]
      rw [RingHom.map_closure, himage]
      rfl
    have hxmap : x.1 ∈ C.map B.subtype := by
      rw [hmap]
      exact x.property
    rcases Subring.mem_map.mp hxmap with ⟨y, hy, hyx⟩
    have hyx' : y = x := Subtype.ext hyx
    simpa [C, hyx'] using hy
  exact IsIntegral.of_mem_closure' ({etaB} : Set B)
    (by
      intro y hy
      have hy' : y = etaB := by
        simpa only [Set.mem_singleton_iff] using hy
      subst y
      exact hetaInt)
    x hxclosure

/-- Contract an ambient cyclotomic prime to a compatible smaller
cyclotomic order. -/
@[expose] def contractedCyclotomicPrime
    {eta xi : ℂ} (hxi : xi ∈ cyclotomicOrder eta)
    (P : Ideal (cyclotomicOrder eta)) :
    Ideal (cyclotomicOrder xi) :=
  P.comap (cyclotomicOrderInclusion hxi)

theorem contractedCyclotomicPrime_isMaximal
    {eta xi : ℂ} (hxi : xi ∈ cyclotomicOrder eta)
    {q : ℕ} (hq : 0 < q) (hpow : eta ^ q = xi)
    (P : Ideal (cyclotomicOrder eta)) (hP : P.IsMaximal) :
    (contractedCyclotomicPrime hxi P).IsMaximal := by
  let f := cyclotomicOrderInclusion hxi
  have hf : f.IsIntegral :=
    cyclotomicOrderInclusion_isIntegral hxi hq hpow
  let : P.IsMaximal := hP
  exact Ideal.isMaximal_comap_of_isIntegral_of_isMaximal' f hf P

theorem contractedCyclotomicPrime_liesOverTwo
    {eta xi : ℂ} (hxi : xi ∈ cyclotomicOrder eta)
    (P : Ideal (cyclotomicOrder eta))
    (hP : P.LiesOver (Ideal.span ({(2 : ℤ)} : Set ℤ))) :
    (contractedCyclotomicPrime hxi P).LiesOver
      (Ideal.span ({(2 : ℤ)} : Set ℤ)) := by
  let A := cyclotomicOrder xi
  let B := cyclotomicOrder eta
  let f : A →+* B := cyclotomicOrderInclusion hxi
  let : Algebra A B := f.toAlgebra
  let : IsScalarTower ℤ A B := IsScalarTower.of_algebraMap_eq' rfl
  let Q : Ideal A := contractedCyclotomicPrime hxi P
  let : P.LiesOver (Ideal.span ({(2 : ℤ)} : Set ℤ)) := hP
  let : P.LiesOver Q := by
    constructor
    rfl
  exact Ideal.LiesOver.tower_bot P Q
    (Ideal.span ({(2 : ℤ)} : Set ℤ))

/-- The residue field of a contracted cyclotomic prime embeds canonically in
the residue field of the ambient prime. -/
@[expose] def contractedResidueFieldInclusion
    {eta xi : ℂ} (hxi : xi ∈ cyclotomicOrder eta)
    (P : Ideal (cyclotomicOrder eta)) :
    (cyclotomicOrder xi ⧸ contractedCyclotomicPrime hxi P) →+*
      (cyclotomicOrder eta ⧸ P) :=
  Ideal.quotientMap P (cyclotomicOrderInclusion hxi) le_rfl

@[simp] theorem contractedResidueFieldInclusion_mk
    {eta xi : ℂ} (hxi : xi ∈ cyclotomicOrder eta)
    (P : Ideal (cyclotomicOrder eta))
    (a : cyclotomicOrder xi) :
    contractedResidueFieldInclusion hxi P
        (Ideal.Quotient.mk (contractedCyclotomicPrime hxi P) a) =
      Ideal.Quotient.mk P (cyclotomicOrderInclusion hxi a) := by
  exact Ideal.quotientMap_mk

theorem contractedResidueFieldInclusion_injective
    {eta xi : ℂ} (hxi : xi ∈ cyclotomicOrder eta)
    (P : Ideal (cyclotomicOrder eta)) :
    Function.Injective (contractedResidueFieldInclusion hxi P) :=
  Ideal.quotientMap_injective

/-- The cyclotomic-order inclusion extends canonically to the localizations
at a prime and its contraction. -/
@[expose] noncomputable def contractedLocalizationInclusion
    {eta xi : ℂ}
    (hxi : xi ∈ cyclotomicOrder eta)
    (P : Ideal (cyclotomicOrder eta))
    [P.IsPrime]
    [(contractedCyclotomicPrime hxi P).IsPrime] :
    Localization.AtPrime (contractedCyclotomicPrime hxi P) →+*
      Localization.AtPrime P :=
  Localization.localRingHom
    (contractedCyclotomicPrime hxi P) P
    (cyclotomicOrderInclusion hxi) rfl

@[simp] theorem contractedLocalizationInclusion_algebraMap
    {eta xi : ℂ}
    (hxi : xi ∈ cyclotomicOrder eta)
    (P : Ideal (cyclotomicOrder eta))
    [P.IsPrime]
    [(contractedCyclotomicPrime hxi P).IsPrime]
    (a : cyclotomicOrder xi) :
    contractedLocalizationInclusion hxi P
        (algebraMap _
          (Localization.AtPrime (contractedCyclotomicPrime hxi P)) a) =
      algebraMap _ (Localization.AtPrime P)
        (cyclotomicOrderInclusion hxi a) := by
  exact Localization.localRingHom_to_map
    (contractedCyclotomicPrime hxi P) P
    (cyclotomicOrderInclusion hxi) rfl a

variable {G : Type u} [Group G] [Finite G]

instance ambientPrimeIdeal_isPrime
    (d : PrincipalCongruenceBlockData G) : d.primeIdeal.IsPrime :=
  d.primeIdeal_maximal.isPrime

/-- The canonical power of the ambient primitive root whose order is the
cardinality of a subgroup. -/
@[expose] def subgroupRoot (d : PrincipalCongruenceBlockData G) (H : Subgroup G) : ℂ :=
  d.eta ^ (Nat.card G / Nat.card H)

theorem subgroupRoot_spec
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    IsPrimitiveRoot (subgroupRoot d H) (Nat.card H) := by
  have hdiv : Nat.card H ∣ Nat.card G := H.card_subgroup_dvd_card
  have hGpos : 0 < Nat.card G := Nat.card_pos
  exact IsPrimitiveRoot.pow hGpos d.eta_spec
    (Nat.div_mul_cancel hdiv).symm

theorem subgroupRoot_mem
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    subgroupRoot d H ∈ cyclotomicOrder d.eta := by
  exact pow_mem_cyclotomicOrder
    (eta_mem_cyclotomicOrder d.eta)
    (Nat.card G / Nat.card H)

theorem subgroupIndex_pos (H : Subgroup G) :
    0 < Nat.card G / Nat.card H := by
  have hdiv : Nat.card H ∣ Nat.card G := H.card_subgroup_dvd_card
  have hHpos : 0 < Nat.card H := Nat.card_pos
  have hGpos : 0 < Nat.card G := Nat.card_pos
  exact Nat.div_pos (Nat.le_of_dvd hGpos hdiv) hHpos

/-- A chosen principal congruence-block datum for a subgroup whose root and
prime are definitionally the canonical power of the ambient root and the
contraction of the ambient prime. -/
@[expose] noncomputable def compatibleSubgroupPrincipalCongruenceBlockData
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    PrincipalCongruenceBlockData H := by
  let c := Classical.choice (exists_principalCongruenceBlockData H)
  let xi : ℂ := subgroupRoot d H
  let P : Ideal (cyclotomicOrder xi) :=
    contractedCyclotomicPrime (subgroupRoot_mem d H) d.primeIdeal
  exact {
    I := c.I
    fintypeI := c.fintypeI
    decidableEqI := c.decidableEqI
    chi := c.chi
    complete := c.complete
    eta := xi
    eta_spec := subgroupRoot_spec d H
    primeIdeal := P
    primeIdeal_maximal := contractedCyclotomicPrime_isMaximal
      (subgroupRoot_mem d H) (subgroupIndex_pos H) rfl
      d.primeIdeal d.primeIdeal_maximal
    primeIdeal_liesOverTwo := contractedCyclotomicPrime_liesOverTwo
      (subgroupRoot_mem d H) d.primeIdeal d.primeIdeal_liesOverTwo
    principal := c.principal
    principal_eq := c.principal_eq }

instance contractedSubgroupPrimeIdeal_isPrime
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    (contractedCyclotomicPrime
      (subgroupRoot_mem d H) d.primeIdeal).IsPrime := by
  change (compatibleSubgroupPrincipalCongruenceBlockData d H).primeIdeal.IsPrime
  infer_instance

/-- Principal congruence-block data for a subgroup exists with its cyclotomic
prime obtained by contraction from the ambient datum's prime. -/
theorem exists_compatibleSubgroupPrincipalCongruenceBlockData
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    Nonempty (PrincipalCongruenceBlockData H) :=
  ⟨compatibleSubgroupPrincipalCongruenceBlockData d H⟩

@[simp] theorem compatibleSubgroupPrincipalCongruenceBlockData_eta
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    (compatibleSubgroupPrincipalCongruenceBlockData d H).eta =
      subgroupRoot d H := rfl

@[simp] theorem compatibleSubgroupPrincipalCongruenceBlockData_primeIdeal
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    (compatibleSubgroupPrincipalCongruenceBlockData d H).primeIdeal =
      contractedCyclotomicPrime (subgroupRoot_mem d H) d.primeIdeal := rfl

/-- The compatible subgroup residue field, viewed inside the ambient residue
field through contraction of the prime. -/
@[expose] noncomputable def compatibleSubgroupResidueFieldInclusion
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    (cyclotomicOrder
          (compatibleSubgroupPrincipalCongruenceBlockData d H).eta ⧸
        (compatibleSubgroupPrincipalCongruenceBlockData d H).primeIdeal) →+*
      (cyclotomicOrder d.eta ⧸ d.primeIdeal) :=
  contractedResidueFieldInclusion (subgroupRoot_mem d H) d.primeIdeal

theorem compatibleSubgroupResidueFieldInclusion_injective
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    Function.Injective (compatibleSubgroupResidueFieldInclusion d H) :=
  contractedResidueFieldInclusion_injective (subgroupRoot_mem d H) d.primeIdeal

/-- The compatible local coefficient ring embedded in the ambient
localization at the fixed prime above `2`. -/
@[expose] noncomputable def compatibleSubgroupLocalizationInclusion
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G) :
    Localization.AtPrime
        (compatibleSubgroupPrincipalCongruenceBlockData d H).primeIdeal →+*
      Localization.AtPrime d.primeIdeal :=
  contractedLocalizationInclusion (subgroupRoot_mem d H) d.primeIdeal

@[simp] theorem compatibleSubgroupLocalizationInclusion_algebraMap
    (d : PrincipalCongruenceBlockData G) (H : Subgroup G)
    (a : cyclotomicOrder
      (compatibleSubgroupPrincipalCongruenceBlockData d H).eta) :
    compatibleSubgroupLocalizationInclusion d H
        (algebraMap _
          (Localization.AtPrime
            (compatibleSubgroupPrincipalCongruenceBlockData d H).primeIdeal) a) =
      algebraMap _ (Localization.AtPrime d.primeIdeal)
        (cyclotomicOrderInclusion (subgroupRoot_mem d H) a) := by
  exact contractedLocalizationInclusion_algebraMap
    (subgroupRoot_mem d H) d.primeIdeal a

end CompatibleLocalBlock

end ModularBlock

