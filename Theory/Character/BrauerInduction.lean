module

public import Theory.Character.NilpotentBrauerGeneration
public import Theory.Character.NilpotentMonomialInduction

/-!
# Integral Brauer induction

Every ordinary complex character of a finite group belongs to the integer
lattice generated by characters induced from linear characters of subgroups.
In particular, each irreducible character admits an explicit finite induction
formula with integer coefficients, expressing the character itself.

The proof combines integral generation by characters of nilpotent subgroups
with monomiality of their irreducibles and induction transitivity. The lattice
interface then converts membership into a sum indexed by `Fin r`.

Source: Serre, *Linear Representations of Finite Groups*, Chapter 10,
Brauer's induction theorem.
-/

public section
noncomputable section
open scoped BigOperators

namespace BrauerInduction
variable {G : Type*} [Group G] [Fintype G]

/-- Every ordinary character is an integer linear combination of characters
induced from one-dimensional characters of subgroups. -/
theorem character_mem_inducedLinearSpan {φ : ClassFunction G} (hφ : IsCharacter φ) :
    φ ∈ inducedLinearSpan G :=
  nilpotentInducedSpan_le
    (fun H hH _ hψ => induced_character_mem_inducedLinearSpan_of_nilpotent H hH hψ)
    (character_mem_nilpotentInducedSpan hφ)

/-- Every ordinary irreducible character belongs to the induced linear-character
integer lattice. -/
theorem irreducible_mem_inducedLinearSpan
    (χ : ConjClassFunction G) (hχ : IsIrreducibleConjCharacter χ) :
    ofConjClassFunction χ ∈ inducedLinearSpan G :=
  nilpotentInducedSpan_le
    (fun H hH _ hφ => induced_character_mem_inducedLinearSpan_of_nilpotent H hH hφ)
    (irreducible_mem_nilpotentInducedSpan χ hχ)

/-- Integral Brauer induction for ordinary irreducible complex characters.
The integer coefficients express `χ` itself, without a multiplier. -/
theorem exists_integral_induction
    (χ : ConjClassFunction G) (hχ : IsIrreducibleConjCharacter χ) :
    ∃ (r : ℕ) (H : Fin r → Subgroup G) (linear : ∀ j, H j →* ℂ)
      (a : Fin r → ℤ),
      ∀ g, χ (ConjClasses.mk g) =
        ∑ j, (a j : ℂ) * inducedClassFunction (H j) (linear j) g :=
  (mem_inducedLinearSpan_iff (ofConjClassFunction χ)).mp
    (irreducible_mem_inducedLinearSpan χ hχ)

end BrauerInduction
