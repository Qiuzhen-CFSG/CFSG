module

public import Theory.Character.BrauerInductionSpan
public import Theory.Character.Integrality
public import Theory.Character.Transport
public import Theory.Representation.Induction

/-!
# The ideal used in integral Brauer induction

The integer span of characters induced from nilpotent subgroups is stable
under multiplication by ordinary characters, by the projection formula.
It therefore defines an ideal in the ring generated by ordinary characters.
To prove integral generation it suffices to exclude containment of this ideal
in every maximal ideal. Character values are algebraic integers, so evaluation
lands in the integral closure of the integers in the complex numbers.

This module proves this reduction, not the maximal-ideal exclusion itself.
Source: Serre, *Linear Representations of Finite Groups*, Chapter 10
(Brauer induction and the character ring).
-/

noncomputable section
@[expose] public section

namespace BrauerInduction

private theorem representation_isCharacter {G V : Type*} [Group G]
    [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (ρ : Representation ℂ G V) : IsCharacter ρ.character := by
  let e := (Module.finBasis ℂ V).equivFun
  let σ : Representation ℂ G (Fin (Module.finrank ℂ V) → ℂ) :=
    (e.conjAlgEquiv ℂ).toMonoidHom.comp ρ
  refine ⟨_, σ, ?_⟩
  funext g
  exact (LinearMap.trace_conj' (ρ g) e).symm

private theorem character_mul {G : Type*} [Group G] {f h : ClassFunction G}
    (hf : IsCharacter f) (hh : IsCharacter h) : IsCharacter (f * h) := by
  obtain ⟨n, ρ, rfl⟩ := hf
  obtain ⟨m, σ, rfl⟩ := hh
  rw [← Representation.char_tensor]
  exact representation_isCharacter _

private theorem character_isClassFunction {G : Type*} [Group G] {f : ClassFunction G}
    (hf : IsCharacter f) : IsClassFunction f := by
  obtain ⟨n, ρ, rfl⟩ := hf
  exact fun x g => Representation.char_conj ρ x g

private theorem character_isIntegral {G : Type*} [Group G] [Fintype G]
    {f : ClassFunction G} (hf : IsCharacter f) (g : G) : IsIntegral ℤ (f g) := by
  obtain ⟨n, ρ, rfl⟩ := hf
  exact character_value_isIntegral ρ g

/-- Induction of an ordinary character is an ordinary character. -/
theorem inducedClassFunction_isCharacter {G : Type*} [Group G] [Fintype G]
    (H : Subgroup G) {f : ClassFunction H} (hf : IsCharacter f) :
    IsCharacter (inducedClassFunction H f) := by
  classical
  obtain ⟨n, ρ, rfl⟩ := hf
  have heq : inducedClassFunction H ρ.character =
      (Representation.ind H.subtype ρ).character := by
    ext g
    rw [Representation.induced_character_formula]
    unfold inducedClassFunction
    rw [Subsingleton.elim (Fintype.ofFinite G) (inferInstance : Fintype G)]
    congr 1
    exact Fintype.sum_equiv (Equiv.inv G) _ _ (fun x => by simp)
  rw [heq]
  exact representation_isCharacter _

variable {G : Type*} [Group G] [Fintype G]

/-- An induced character from a nilpotent subgroup is a generator of the span. -/
theorem nilpotentInduced_mem (H : Subgroup G) (hH : Group.IsNilpotent H)
    {f : ClassFunction H} (hf : IsCharacter f) :
    inducedClassFunction H f ∈ nilpotentInducedSpan G :=
  Submodule.subset_span ⟨H, hH, f, hf, rfl⟩

/-- The projection formula makes the span stable under character multiplication. -/
theorem nilpotentInducedSpan_mul_character {f h : ClassFunction G}
    (hf : f ∈ nilpotentInducedSpan G) (hh : IsCharacter h) :
    f * h ∈ nilpotentInducedSpan G := by
  induction hf using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨H, hH, φ, hφ, rfl⟩ := hf
    rw [← inducedClassFunction_mul_restrict H φ (character_isClassFunction hh)]
    exact nilpotentInduced_mem H hH (character_mul hφ (isCharacter_comp_hom H.subtype hh))
  | zero => simp
  | add f k hf hk ihf ihk =>
    simpa only [add_mul] using (nilpotentInducedSpan G).add_mem ihf ihk
  | smul a f hf ih =>
    simpa only [smul_mul_assoc] using (nilpotentInducedSpan G).smul_mem a ih

/-- The subring of complex functions generated by ordinary characters. -/
def characterRing (G : Type*) [Group G] : Subring (ClassFunction G) :=
  Subring.closure {f | IsCharacter f}

omit [Fintype G] in
/-- Every ordinary character belongs to the character ring. -/
theorem character_mem_characterRing {f : ClassFunction G} (hf : IsCharacter f) :
    f ∈ characterRing G := Subring.subset_closure hf

/-- Virtual character values are algebraic integers. -/
theorem characterRing_isIntegral {f : ClassFunction G} (hf : f ∈ characterRing G)
    (g : G) : IsIntegral ℤ (f g) := by
  induction hf using Subring.closure_induction with
  | mem f hf => exact character_isIntegral hf g
  | zero => exact isIntegral_zero
  | one => exact isIntegral_one
  | add f h hf hh ihf ihh => exact ihf.add ihh
  | neg f hf ih => exact ih.neg
  | mul f h hf hh ihf ihh => exact ihf.mul ihh

/-- The span is stable under multiplication by virtual characters. -/
theorem nilpotentInducedSpan_mul_characterRing {f h : ClassFunction G}
    (hf : f ∈ nilpotentInducedSpan G) (hh : h ∈ characterRing G) :
    f * h ∈ nilpotentInducedSpan G := by
  induction hh using Subring.closure_induction generalizing f with
  | mem h hh => exact nilpotentInducedSpan_mul_character hf hh
  | zero => simp
  | one => simpa using hf
  | add h k hh hk ihh ihk =>
    simpa only [mul_add] using (nilpotentInducedSpan G).add_mem (ihh hf) (ihk hf)
  | neg h hh ih => simpa using (nilpotentInducedSpan G).neg_mem (ih hf)
  | mul h k hh hk ihh ihk =>
    simpa only [mul_assoc] using ihk (ihh hf)

/-- The ideal in the character ring cut out by the nilpotent-induced span. -/
def nilpotentInducedIdeal : Ideal (characterRing G) where
  carrier := {f | f.val ∈ nilpotentInducedSpan G}
  zero_mem' := (nilpotentInducedSpan G).zero_mem
  add_mem' := fun hf hh => (nilpotentInducedSpan G).add_mem hf hh
  smul_mem' := by
    intro h f hf
    change h.val * f.val ∈ nilpotentInducedSpan G
    rw [mul_comm]
    exact nilpotentInducedSpan_mul_characterRing hf h.property

/-- Evaluation as an algebraic integer. -/
def characterEvaluation (g : G) : characterRing G →+* integralClosure ℤ ℂ where
  toFun f := ⟨f.val g, characterRing_isIntegral f.property g⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

/-- A formula for the trivial character gives one for every character. -/
theorem character_mem_nilpotentInducedSpan_of_one
    (h1 : (1 : ClassFunction G) ∈ nilpotentInducedSpan G)
    {f : ClassFunction G} (hf : IsCharacter f) : f ∈ nilpotentInducedSpan G := by
  simpa using nilpotentInducedSpan_mul_character h1 hf

/-- Excluding every maximal ideal proves integral generation. -/
theorem character_mem_nilpotentInducedSpan_of_maximal
    (hmax : ∀ (M : Ideal (characterRing G)), M.IsMaximal →
      ∃ f : characterRing G, f.val ∈ nilpotentInducedSpan G ∧ f ∉ M)
    {f : ClassFunction G} (hf : IsCharacter f) : f ∈ nilpotentInducedSpan G := by
  apply character_mem_nilpotentInducedSpan_of_one (G := G) _ hf
  have htop : nilpotentInducedIdeal (G := G) = ⊤ := by
    by_contra hne
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
    obtain ⟨f, hf, hnot⟩ := hmax M hM
    exact hnot (hle hf)
  have h1 : (1 : characterRing G) ∈ nilpotentInducedIdeal (G := G) := by
    rw [htop]
    exact Submodule.mem_top
  exact h1

end BrauerInduction
