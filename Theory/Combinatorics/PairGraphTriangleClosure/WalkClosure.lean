module

public import Mathlib.Combinatorics.SimpleGraph.Walk.Operations

/-!
# Normal closure of graph cycles

Cycles here are closed walks, with their base vertex retained. The closure is
expressed by the least equivalence relation on parallel walks compatible with
concatenation and reversal, cancelling backtracking, and killing specified
cycles. Thus this is normal, nonabelian cycle closure, not the binary cycle space.

The constructors are the path-invariant relation of Aschbacher, *Sporadic
Groups*, §33 (especially 33.1--33.3). They give an insertion/deletion interface
for the base condition in §37, p.200. Triangle closure is the corresponding
notion of triangulability in §34.
-/

@[expose] public section

namespace SimpleGraph.WalkClosure

universe u
variable {V : Type u} {Γ : SimpleGraph V}

/-- A family of cycles with specified origins. -/
abbrev Cycles (Γ : SimpleGraph V) := ∀ x, Set (Γ.Walk x x)

/-- The path congruence generated by a family of cycles and backtracking. -/
inductive Rel (S : Cycles Γ) : {x y : V} → Γ.Walk x y → Γ.Walk x y → Prop
  | refl {x y} (p : Γ.Walk x y) : Rel S p p
  | symm {x y} {p q : Γ.Walk x y} : Rel S p q → Rel S q p
  | trans {x y} {p q r : Γ.Walk x y} : Rel S p q → Rel S q r → Rel S p r
  | append {x y z} {p q : Γ.Walk x y} {r s : Γ.Walk y z} :
      Rel S p q → Rel S r s → Rel S (p.append r) (q.append s)
  | reverse {x y} {p q : Γ.Walk x y} : Rel S p q → Rel S p.reverse q.reverse
  | cancel {x y} (p : Γ.Walk x y) : Rel S (p.append p.reverse) .nil
  | cycle {x} (p : Γ.Walk x x) : p ∈ S x → Rel S p .nil

/-- Membership in the normal closure of the specified cycles. -/
def closure (S : Cycles Γ) : Cycles Γ := fun _ p => Rel S p .nil

/-- Replacing the generators by cycles already killed by another congruence. -/
theorem Rel.of_generators {S T : Cycles Γ}
    (h : ∀ x (p : Γ.Walk x x), p ∈ S x → p ∈ closure T x)
    {x y : V} {p q : Γ.Walk x y} (hpq : Rel S p q) : Rel T p q := by
  induction hpq with
  | refl p => exact .refl p
  | symm _ ih => exact .symm ih
  | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
  | append _ _ ih₁ ih₂ => exact .append ih₁ ih₂
  | reverse _ ih => exact .reverse ih
  | cancel p => exact .cancel p
  | cycle p hp => exact h _ p hp

/-- Every generator belongs to its closure. -/
theorem subset_closure (S : Cycles Γ) (x : V) : S x ⊆ closure S x :=
  fun p hp => .cycle p hp

/-- Cycle closure is monotone. -/
theorem closure_mono {S T : Cycles Γ} (h : ∀ x, S x ⊆ T x) (x : V) :
    closure S x ⊆ closure T x :=
  fun _ hp => hp.of_generators fun x p hp => .cycle p (h x hp)

/-- Closing a family twice does not add any cycles. -/
theorem closure_idempotent (S : Cycles Γ) : closure (closure S) = closure S := by
  funext x
  apply Set.ext
  intro p
  exact ⟨fun hp => hp.of_generators (fun _ _ h => h), fun hp => subset_closure (closure S) x hp⟩

/-- Closure is stable under moving a cycle along an arbitrary path. -/
theorem conjugate_mem_closure {S : Cycles Γ} {x y : V}
    (p : Γ.Walk x y) (q : Γ.Walk y y) (hq : q ∈ closure S y) :
    (p.append q).append p.reverse ∈ closure S x := by
  have h := Rel.append (Rel.append (.refl p) hq) (.refl p.reverse)
  simp only [Walk.append_nil] at h
  exact h.trans (.cancel p)

/-- Triangles, with either orientation and any base vertex. -/
def triangles (Γ : SimpleGraph V) : Cycles Γ := fun _ p => p.length = 3

/-- Every closed walk is generated by triangles and backtracking. -/
def Triangulable (Γ : SimpleGraph V) : Prop :=
  ∀ x (p : Γ.Walk x x), p ∈ closure (triangles Γ) x

/-- A family is a cycle base when its normal closure consists of all cycles. -/
def IsCycleBase (S : Cycles Γ) : Prop := ∀ x (p : Γ.Walk x x), p ∈ closure S x

/-- To prove a base in a triangulable graph, it suffices to kill triangles. -/
theorem isCycleBase_of_triangles {S : Cycles Γ} (hΓ : Triangulable Γ)
    (hS : ∀ x (p : Γ.Walk x x), p.length = 3 → p ∈ closure S x) :
    IsCycleBase S := by
  intro x p
  exact (hΓ x p).of_generators hS

/-- All edges of a walk satisfy a specified relation. -/
def Supported (R : V → V → Prop) : {x y : V} → Γ.Walk x y → Prop
  | _, _, .nil => True
  | x, _, @Walk.cons _ _ _ z _ _ p => R x z ∧ Supported R p

end SimpleGraph.WalkClosure
