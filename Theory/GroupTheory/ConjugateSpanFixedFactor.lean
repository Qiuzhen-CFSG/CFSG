module
public import Theory.GroupTheory.Commutator.RelativeGeneration
public import Theory.GroupTheory.ConjugateSpanSylow

/-!
# A fixed factor and normal generation

Suppose J is generated by its conjugates of A, J normalizes Q and U,
Q normalizes U, and U ≤ J. If Q = U C_Q(A), the seed A centralizes
Q modulo U. Conjugation by J extends that bound to [J,Q] ≤ U, hence
Q normalizes J. All normality is relative to the stated actors.

Source application: the last paragraph of Aschbacher--Smith 4.3.6,
printed p.615, with A = W, J = K₂, Q = Q_Z and U = O₂(K₂).
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

/-- Source last-line calculation: fixed-factor decomposition and normal
span generation make Q normalize the second local factor J. -/
theorem normalizes_of_fixed_factor_and_conjugate_generation
    (A J Q U : Subgroup G)
    (hJU : J ≤ normalizer (U : Set G))
    (hJQ : J ≤ normalizer (Q : Set G))
    (hQU : Q ≤ normalizer (U : Set G))
    (hUJ : U ≤ J)
    (hQ : Q = U ⊔ (Q ⊓ centralizer (A : Set G)))
    (hgen : conjugateSpanBy A J = J) :
    Q ≤ normalizer (J : Set G) := by
  have hAJ : A ≤ J := hgen ▸ le_conjugateSpanBy A J
  have hseed : ⁅A,Q⁆ ≤ U := by
    have hh : ⁅U ⊔ (Q ⊓ centralizer (A : Set G)),A⁆ ≤ U := by
      apply commutator_sup_le_of_relative_normal Q U
        (Q ⊓ centralizer (A : Set G)) A U hQU
      · exact le_sup_left.trans_eq hQ.symm
      · exact inf_le_left
      · exact le_normalizer_iff_commutator_le_left.mp (hAJ.trans hJU)
      · exact (commutator_eq_bot_iff_le_centralizer.mpr inf_le_right).le.trans bot_le
    rwa [←hQ,commutator_comm] at hh
  have hcomm : ⁅J,Q⁆ ≤ U := by
    rw [←hgen,conjugateSpanBy_eq_iSup_conj]
    apply commutator_iSup_le_of_relative_normal J Q U _ hJU
    · intro j
      exact (map_mono hAJ).trans_eq
        (mem_normalizer_iff_map_conj_eq.mp (J.le_normalizer j.property))
    · intro j
      have hh := map_mono (f := (MulAut.conj (j : G)).toMonoidHom) hseed
      have heQ : Q.map (MulAut.conj (j : G)).toMonoidHom = Q :=
        mem_normalizer_iff_map_conj_eq.mp (hJQ j.property)
      have heU : U.map (MulAut.conj (j : G)).toMonoidHom = U :=
        mem_normalizer_iff_map_conj_eq.mp (hJU j.property)
      rwa [map_commutator,heQ,heU] at hh
  exact le_normalizer_iff_commutator_le_left.mpr (hcomm.trans hUJ)

end Subgroup
