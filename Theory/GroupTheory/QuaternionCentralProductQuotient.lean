module

public import Theory.GroupTheory.QuaternionCentralProductIntrinsic
public import Theory.GroupAction.QuaternionEight
public import Mathlib.GroupTheory.NoncommCoprod

/-!
# The diagonal quotient of an intrinsic quaternion central product

Multiplication of two commuting quaternion factors gives a surjection from
Q₈×Q₈. Their common order-two subgroup identifies the two central
involutions. Its kernel is precisely ⟨(-1,-1)⟩, so the induced quotient
equivalence retains both original factor embeddings.

The kernel argument is adapted from the private `norm_product_map` in
QuaternionCentralProductInvolutionProducts. This extension exposes the
quotient comparison without changing that shared module or importing its
involution-action calculations.

Source application: Aschbacher–Smith, combined manuscript of 1 March 2004,
E.2.16 and G.2.4(8), printed pp.334–335; Q₈² means Q₈∘Q₈.
-/

@[expose] public section

namespace QuaternionCentralProduct
open Subgroup

abbrev Pair := QuaternionGroup 2 × QuaternionGroup 2

/-- The pair (-1,-1) in the two concrete quaternion factors. -/
def diagonalInvolution : Pair := (QuaternionGroup.a 2, QuaternionGroup.a 2)

/-- The actual diagonal central subgroup, with its two elements explicit. -/
def diagonalCenter : Subgroup Pair where
  carrier := {x | x = 1 ∨ x = diagonalInvolution}
  one_mem' := Or.inl rfl
  mul_mem' := by
    rintro x y (rfl | rfl) (rfl | rfl)
    · exact Or.inl (one_mul _)
    · exact Or.inr (one_mul _)
    · exact Or.inr (mul_one _)
    · exact Or.inl (by decide)
  inv_mem' := by
    rintro x (rfl | rfl)
    · exact Or.inl inv_one
    · exact Or.inr (by decide)

@[simp] theorem mem_diagonalCenter (x : Pair) :
    x ∈ diagonalCenter ↔ x = 1 ∨ x = diagonalInvolution := Iff.rfl

/-- Thus the denominator is literally the subgroup generated by (-1,-1). -/
theorem diagonalCenter_eq_zpowers : diagonalCenter = zpowers diagonalInvolution := by
  apply le_antisymm
  · rintro x (rfl | rfl)
    · exact one_mem _
    · exact mem_zpowers _
  · exact zpowers_le.mpr (Or.inr rfl)

instance diagonalCenter_normal : diagonalCenter.Normal where
  conj_mem := by
    rintro x (rfl | rfl) g
    · exact Or.inl (by simp)
    · apply Or.inr
      have hc : ∀ a : Pair, a * diagonalInvolution = diagonalInvolution * a := by decide
      rw [hc, mul_inv_cancel_right]

/-- Q₈∘Q₈, not the direct product Q₈×Q₈. -/
abbrev Model := Pair ⧸ diagonalCenter

end QuaternionCentralProduct

namespace Subgroup.QuaternionCentralProductData
open QuaternionCentralProduct

variable {Q : Type*} [Group Q] [Finite Q]

/-- Multiplication of the prescribed quaternion factors has the diagonal kernel. -/
theorem exists_productMap {G : Type*} [Group G] [Finite G]
    (d : QuaternionCentralProductData G)
    (eB : d.left ≃* QuaternionGroup 2) (eC : d.right ≃* QuaternionGroup 2) :
    ∃ f : Pair →* G, Function.Surjective f ∧
      (∀ x : Pair, f x=1 ↔ (x = 1 ∨ x = diagonalInvolution)) ∧
      ∀ x : Pair, f x = (eB.symm x.1 : G)*(eC.symm x.2 : G) := by
  let B := d.left
  let C := d.right
  have hjoin := d.span
  have hinter := d.intersection_card
  have hcomm := d.commute
  let fB : QuaternionGroup 2 →* G := B.subtype.comp eB.symm.toMonoidHom
  let fC : QuaternionGroup 2 →* G := C.subtype.comp eC.symm.toMonoidHom
  let f : Pair →* G := fB.noncommCoprod fC (fun a b =>
    show Commute (fB a) (fC b) from hcomm _ (eB.symm a).property _ (eC.symm b).property)
  have hfB : fB.range = B := by
    dsimp [fB]
    rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eB.symm.surjective,
      ← MonoidHom.range_eq_map, B.range_subtype]
  have hfC : fC.range = C := by
    dsimp [fC]
    rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eC.symm.surjective,
      ← MonoidHom.range_eq_map, C.range_subtype]
  have hfrange : f.range = B ⊔ C := by
    dsimp [f]
    rw [MonoidHom.noncommCoprod_range, hfB, hfC]
  have hf : Function.Surjective f := MonoidHom.range_eq_top.mp (hfrange.trans hjoin)
  have hGcard : Nat.card G = 32 := d.card
  obtain ⟨w, hwne, _⟩ :=
    (Nat.card_eq_two_iff' (1 : (B ⊓ C : Subgroup G))).mp hinter
  have hw2 : (w : G) ^ 2 = 1 := by
    have hh := pow_card_eq_one' (x := w)
    rw [hinter] at hh
    exact congrArg Subtype.val hh
  let wb : B := ⟨w, w.property.1⟩
  let wc : C := ⟨w, w.property.2⟩
  have hwb2 : wb ^ 2 = 1 := Subtype.ext hw2
  have hwc2 : wc ^ 2 = 1 := Subtype.ext hw2
  have hwbne : wb ≠ 1 := fun h => hwne (Subtype.ext
    (congrArg (fun b : B => (b : G)) h))
  have hwcne : wc ≠ 1 := fun h => hwne (Subtype.ext
    (congrArg (fun c : C => (c : G)) h))
  have heB : eB wb = QuaternionGroup.a 2 :=
    QuaternionGroup.eq_a_two_of_orderOf_eq_two _ (by
      rw [eB.orderOf_eq]
      exact orderOf_eq_prime hwb2 hwbne)
  have heC : eC wc = QuaternionGroup.a 2 :=
    QuaternionGroup.eq_a_two_of_orderOf_eq_two _ (by
      rw [eC.orderOf_eq]
      exact orderOf_eq_prime hwc2 hwcne)
  have hfb : fB (QuaternionGroup.a 2) = w := by
    change ((eB.symm (QuaternionGroup.a 2) : B) : G) = w
    rw [← heB, eB.symm_apply_apply]
  have hfc : fC (QuaternionGroup.a 2) = w := by
    change ((eC.symm (QuaternionGroup.a 2) : C) : G) = w
    rw [← heC, eC.symm_apply_apply]
  have hzz : f ((QuaternionGroup.a 2 : QuaternionGroup 2),(QuaternionGroup.a 2 : QuaternionGroup 2)) = 1 := by
    change fB (QuaternionGroup.a 2) * fC (QuaternionGroup.a 2) = 1
    rw [hfb, hfc, ← pow_two, hw2]
  have hkerCard : Nat.card f.ker = 2 := by
    have hh := f.ker.card_mul_index
    rw [Subgroup.index_ker, hfrange, hjoin, Nat.card_congr Subgroup.topEquiv.toEquiv, hGcard,
      show Nat.card Pair = 64 by rw [Nat.card_eq_fintype_card]; decide] at hh
    omega
  have hker : ∀ p : Pair, f p = 1 ↔ (p = 1 ∨ p = diagonalInvolution) := by
    obtain ⟨k, hk, huniq⟩ := (Nat.card_eq_two_iff' (1 : f.ker)).mp hkerCard
    have hzker : (⟨((QuaternionGroup.a 2 : QuaternionGroup 2),(QuaternionGroup.a 2 : QuaternionGroup 2)), hzz⟩ : f.ker) ≠ 1 := by
      intro he
      exact (by decide : ((QuaternionGroup.a 2 : QuaternionGroup 2),(QuaternionGroup.a 2 : QuaternionGroup 2)) ≠ 1) (congrArg Subtype.val he)
    have hkz := huniq ⟨((QuaternionGroup.a 2 : QuaternionGroup 2),(QuaternionGroup.a 2 : QuaternionGroup 2)), hzz⟩ hzker
    intro p
    constructor
    · intro hp
      by_cases hp1 : p = 1
      · exact Or.inl hp1
      · right
        have hpk : (⟨p, hp⟩ : f.ker) ≠ 1 := fun h => hp1 (congrArg Subtype.val h)
        exact congrArg Subtype.val ((huniq ⟨p,hp⟩ hpk).trans hkz.symm)
    · rintro (rfl | rfl)
      · exact map_one f
      · exact hzz

  exact ⟨f,hf,hker,fun _ => rfl⟩


/-- The first isomorphism theorem identifies the intrinsic group with the
literal diagonal quotient and preserves multiplication of the two factors. -/
theorem exists_quotientEquiv (d : QuaternionCentralProductData Q)
    (eL : d.left ≃* QuaternionGroup 2) (eR : d.right ≃* QuaternionGroup 2) :
    ∃ e : Model ≃* Q, ∀ x y : QuaternionGroup 2,
      e (QuotientGroup.mk' diagonalCenter (x, y)) =
        (eL.symm x : Q) * (eR.symm y : Q) := by
  obtain ⟨f, hf, hk, he⟩ := d.exists_productMap eL eR
  have hker : diagonalCenter = f.ker := by
    ext x
    exact (hk x).symm
  let e : Model ≃* Q := (QuotientGroup.quotientMulEquivOfEq hker).trans
    (QuotientGroup.quotientKerEquivOfSurjective f hf)
  exact ⟨e, fun x y => he (x, y)⟩

/-- Every intrinsic factor presentation gives the genuine central-product
model. This does not construct a factor presentation for an arbitrary group. -/
theorem nonempty_model_equiv (d : QuaternionCentralProductData Q) :
    Nonempty (Q ≃* Model) := by
  obtain ⟨eL⟩ := d.left_model
  obtain ⟨eR⟩ := d.right_model
  obtain ⟨e, _⟩ := d.exists_quotientEquiv eL eR
  exact ⟨e.symm⟩

end Subgroup.QuaternionCentralProductData
