module
public import Theory.GroupTheory.DihedralPresentation
public import Theory.GroupTheory.NormalizingInvolutionCard
public import Theory.Frattini.DihedralOmega

/-!
# Dihedral groups generated by a rotation and an external involution

An involution outside a finite cyclic subgroup which inverts its generator
doubles the subgroup order. The dihedral presentation then identifies the
join with the actual dihedral model. For a rotation of order at least four,
the model center has order two.

This supplies the intrinsic recognition and center count used in
Aschbacher–Smith 16.3.12, printed pp.1181–1182. The dihedral parameter here
is the rotation order, so the resulting group has order twice that parameter.
-/

open Subgroup

namespace DihedralGroup
variable {G : Type*} [Group G]

/-- An external inverting involution extends a cyclic subgroup to an actual
dihedral group of twice its order. -/
public theorem sup_zpowers_equiv_of_inversion {m : ℕ} (hm : 0 < m) (c d : G)
    (hc : orderOf c = m) (hd : d ^ 2 = 1)
    (hout : d ∉ zpowers c) (hinv : d * c * d⁻¹ = c⁻¹) :
    Nat.card (zpowers c ⊔ zpowers d : Subgroup G) = 2 * m ∧
      Nonempty ((zpowers c ⊔ zpowers d : Subgroup G) ≃* DihedralGroup m) := by
  have hnorm : d ∈ normalizer (zpowers c : Set G) := by
    rw [mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
    change zpowers (d * c * d⁻¹) = zpowers c
    rw [hinv, zpowers_inv]
  have hcard : Nat.card (zpowers c ⊔ zpowers d : Subgroup G) = 2 * m := by
    rw [card_sup_zpowers_of_normalizing_involution _ _ hd hout hnorm, Nat.card_zpowers, hc]
  let R := zpowers c ⊔ zpowers d
  let cr : R := ⟨c, mem_sup_left (mem_zpowers _)⟩
  let dr : R := ⟨d, mem_sup_right (mem_zpowers _)⟩
  have hgen : closure ({cr, dr} : Set R) = ⊤ := by
    apply map_injective R.subtype_injective
    rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, R.range_subtype]
    rw [Set.image_insert_eq, Set.image_singleton]
    change closure ({c, d} : Set G) = R
    rw [← Set.singleton_union, Subgroup.closure_union, ← zpowers_eq_closure, ← zpowers_eq_closure]
  exact ⟨hcard, dihedralGroup_equiv_of_presentation hm cr dr
    ((orderOf_coe cr).symm.trans hc) (Subtype.ext hd) (Subtype.ext hinv) hgen hcard⟩

/-- A dihedral two-group with rotation order at least four has center of order two. -/
public theorem center_card_of_equiv {n : ℕ} (hn : 2 ≤ n)
    (e : G ≃* DihedralGroup (2 ^ n)) : Nat.card (center G) = 2 := by
  rw [Nat.card_congr (centerCongr e).toEquiv, DihedralFrattini.center_eq_half hn,
    Nat.card_zpowers]
  have hh : 2 ^ n = 2 ^ (n - 1) * 2 := by
    rw [← pow_succ]
    congr 1
    omega
  rw [← DihedralGroup.r_one_pow, orderOf_pow_of_dvd (by positivity)
    (by rw [DihedralGroup.orderOf_r_one, hh]; exact dvd_mul_right _ _),
    DihedralGroup.orderOf_r_one, hh, Nat.mul_div_right _ (by positivity)]
end DihedralGroup
