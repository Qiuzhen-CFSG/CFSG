module

public import Theory.GroupTheory.PrimeRankElementary
public import Theory.Quasithin.Rank
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Prime rank of the subgroup generated by prime-order elements

Every elementary abelian p-subgroup lies in the subgroup generated by the
order-p elements. This subgroup consequently has the original p-rank.
Its ambient normalizer also contains the normalizer of the original group.
These statements apply to the literal cubic closure theta in13.7.5(4).
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G]

/-- The prime-order closure of a subgroup stays in that subgroup. -/
theorem primeOrderClosure_le (p : ℕ) (A : Subgroup G) :
    closure {x : G | x ∈ A ∧ orderOf x = p} ≤ A :=
  (closure_le _).mpr (fun _ hx => hx.1)

/-- Normalizing a subgroup also normalizes its prime-order closure. -/
theorem normalizer_le_primeOrderClosure_normalizer (p : ℕ) (A : Subgroup G) :
    normalizer (A : Set G) ≤
      normalizer (closure {x : G | x ∈ A ∧ orderOf x = p} : Set G) := by
  apply le_normalizer_closure_iff.mpr
  intro g hg x hx
  exact subset_closure ⟨(mem_normalizer_iff.mp hg x).mp hx.1,
    (MulAut.conj g).orderOf_eq x |>.trans hx.2⟩

/-- Passing to the subgroup generated by order-p elements preserves p-rank. -/
theorem primeRank_primeOrderClosure [Finite G] (p : ℕ) [Fact p.Prime]
    (A : Subgroup G) :
    primeRank p (closure {x : G | x ∈ A ∧ orderOf x = p}) = primeRank p A := by
  let C := closure {x : G | x ∈ A ∧ orderOf x = p}
  apply le_antisymm (primeRank_mono p (primeOrderClosure_le p A))
  apply (primeRank_le_iff_elementary_card_le A).mpr
  intro E hE
  let := hE
  let F := E.map A.subtype
  let : IsElementaryAbelian p F := IsElementaryAbelian.map A.subtype
  have hFC : F ≤ C := by
    rintro x ⟨y, hy, rfl⟩
    by_cases he : y.val = 1
    · simpa only [Subgroup.subtype_apply, he] using C.one_mem
    · apply subset_closure
      refine ⟨y.property, orderOf_eq_prime ?_ he⟩
      exact congrArg Subtype.val (elemPow_eq_one_of_isElementaryAbelian y hy)
  let : IsElementaryAbelian p (F.subgroupOf C) :=
    { toIsMulCommutative := Subgroup.subgroupOf_isMulCommutative C F
      exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun x =>
        Subtype.ext (Subtype.ext (elemPow_eq_one_of_isElementaryAbelian _ (show x.val.val ∈ F from x.property)))) }
  have hc := (primeRank_le_iff_elementary_card_le (p := p) (n := primeRank p C) C).mp le_rfl
    (F.subgroupOf C) inferInstance
  rw [Nat.card_congr (subgroupOfEquivOfLe hFC).toEquiv,
    card_map_of_injective A.subtype_injective] at hc
  exact hc

end Subgroup
