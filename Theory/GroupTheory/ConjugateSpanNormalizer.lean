module
public import Theory.GroupTheory.ConjugateSpanOrder

/-!
# Normalizing an orbit span

An actor preserving both the seed and the conjugating subgroup preserves the
subgroup generated by all those conjugates. No finiteness is needed.

Source application: Aschbacher--Smith 14.3.18(4), printed p.996.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

theorem normalizes_conjugateSpanBy (Z H A : Subgroup G)
    (hZ : A ≤ normalizer (Z : Set G)) (hH : A ≤ normalizer (H : Set G)) :
    A ≤ normalizer (conjugateSpanBy Z H : Set G) := by
  apply le_normalizer_closure_iff.mpr
  rintro a ha x ⟨h, hh, z, hz, rfl⟩
  apply Subgroup.subset_closure
  refine ⟨a * h * a⁻¹, (mem_normalizer_iff.mp (hH ha) h).mp hh,
    a * z * a⁻¹, (mem_normalizer_iff.mp (hZ ha) z).mp hz, ?_⟩
  group

end Subgroup

