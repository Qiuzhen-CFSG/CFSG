module
public import Theory.GroupTheory.SolvableResidual
public import Theory.GroupTheory.PerfectCenterFrattini
public import Theory.GroupTheory.CyclicNormalCentralizer
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# A marked involution normalizer over a perfect quotient

For a surjection onto a perfect group, take the preimage of the center
and a marked Sylow subgroup of that preimage. Frattini's argument makes
the Sylow normalizer surject modulo a central supplement; perfectness
removes that supplement. Its solvable residual therefore still surjects.

When the marked Sylow is generated by an involution and the kernel's
involution centralizer is cyclic, the residual's restricted kernel is
cyclic and normal. A perfect group centralizes every cyclic normal
subgroup, so the exact restricted map is a perfect central cover.

Source application: Aschbacher--Smith, Proposition 9.3.1, printed p.732,
the normalizer reduction in the nonquasisimple odd-core containing row.
-/

public noncomputable section
open Subgroup
namespace Theory.GroupTheory.NormalizerResidualCentralCover
variable {X H : Type*} [Group X] [Finite X] [Group H] [Group.IsPerfect H]

/-- The actual marked Sylow normalizer surjects onto the perfect target. -/
theorem normalizer_surjective_of_center_preimage_sylow
    (q : X →* H) (hq : Function.Surjective q)
    {p : ℕ} [Fact p.Prime]
    (S : Sylow p ((center H).comap q)) (Q : Subgroup X)
    (hS : (S : Subgroup ((center H).comap q)).map ((center H).comap q).subtype = Q) :
    Function.Surjective (q.comp (normalizer (Q : Set X)).subtype) := by
  let R := (center H).comap q
  have hf : normalizer (Q : Set X) ⊔ R = ⊤ := by
    simpa only [hS] using S.normalizer_sup_eq_top
  have hm := congrArg (Subgroup.map q) hf
  rw [Subgroup.map_sup,map_top_of_surjective q hq] at hm
  have hM : (normalizer (Q : Set X)).map q = ⊤ := by
    apply eq_top_of_sup_center_eq_top
    apply top_unique
    rw [←hm]
    exact sup_le_sup_left (map_comap_le _ _) _
  apply MonoidHom.range_eq_top.mp
  rwa [MonoidHom.range_comp,range_subtype]

/-- The literal embedded residual retains surjectivity onto a perfect target. -/
theorem normalizer_residual_surjective_of_surjective
    (q : X →* H) (Q : Subgroup X)
    (hN : Function.Surjective (q.comp (normalizer (Q : Set X)).subtype)) :
    Function.Surjective (q.comp
      ((solvableResidual (normalizer (Q : Set X))).map
        (normalizer (Q : Set X)).subtype).subtype) := by
  apply MonoidHom.range_eq_top.mp
  rw [MonoidHom.range_comp,range_subtype,map_map,
    map_solvableResidual_eq _ hN,solvableResidual_eq_top]

omit [Group.IsPerfect H] in
/-- A cyclic fixed kernel becomes central in the actual normalizer residual. -/
theorem normalizer_residual_kernel_central
    (q : X →* H) (t : X) (ht : orderOf t = 2)
    (hc : IsCyclic (q.ker ⊓ centralizer ({t} : Set X) : Subgroup X)) :
    let K := (solvableResidual (normalizer (zpowers t : Set X))).map
      (normalizer (zpowers t : Set X)).subtype
    (q.comp K.subtype).ker ≤ center K := by
  dsimp only
  let N := normalizer (zpowers t : Set X)
  let K := (solvableResidual N).map N.subtype
  let f := q.comp K.subtype
  let C := q.ker ⊓ centralizer ({t} : Set X)
  let : IsCyclic C := hc
  have hKC : ∀ x : f.ker, (x.val : X) ∈ C := by
    intro x
    refine ⟨x.property,?_⟩
    have hxN := map_subtype_le (solvableResidual N) x.val.property
    change (x.val : X) ∈ normalizer (zpowers t : Set X) at hxN
    rwa [normalizer_zpowers_eq_centralizer_of_order_two t ht] at hxN
  let i : f.ker →* C := (K.subtype.comp f.ker.subtype).codRestrict C hKC
  have hi : Function.Injective i := by
    intro x y hxy
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun z : C => (z : X)) hxy
  let : IsCyclic f.ker := isCyclic_of_injective i hi
  let : Group.IsPerfect K := Group.IsPerfect.map _
  have hcent := commutator_le_centralizer_of_isCyclic_normal f.ker
  rw [Group.IsPerfect.commutator_eq_top] at hcent
  intro x hx
  apply mem_center_iff.mpr
  intro y
  exact (hcent (mem_top y) x hx).symm

/-- Frattini and cyclic fixed-kernel control give a central cover through the
literal restriction of the original homomorphism to the embedded residual. -/
theorem normalizer_residual_central_cover_of_center_preimage_sylow
    (q : X →* H) (hq : Function.Surjective q)
    (t : X) (ht : orderOf t = 2)
    (hc : IsCyclic (q.ker ⊓ centralizer ({t} : Set X) : Subgroup X))
    (S : Sylow 2 ((center H).comap q))
    (hS : (S : Subgroup ((center H).comap q)).map ((center H).comap q).subtype = zpowers t) :
    let K := (solvableResidual (normalizer (zpowers t : Set X))).map
      (normalizer (zpowers t : Set X)).subtype
    Function.Surjective (q.comp K.subtype) ∧ (q.comp K.subtype).ker ≤ center K := by
  refine ⟨normalizer_residual_surjective_of_surjective q (zpowers t) ?_,
    normalizer_residual_kernel_central q t ht hc⟩
  exact normalizer_surjective_of_center_preimage_sylow q hq S (zpowers t) hS

end Theory.GroupTheory.NormalizerResidualCentralCover
