module

public import Theory.GroupTheory.CentralExtensionSwap
public import Theory.GroupTheory.PerfectCentralSupplement

/-!
# Perfect central covers of an abelian-by-cyclic local subgroup

Suppose a Sylow subgroup is generated by an abelian torus T and a cyclic
supplement, and the full preimage of T in a central cover is abelian.
An ambient element inverting T and fixing the supplement inverts the derived
subgroup of the full Sylow preimage. Central transfer puts every central
p-subgroup there. Such a subgroup is also fixed by ambient conjugation,
so it has exponent two and is trivial when p is odd.

A second theorem obtains the abelian preimage from an ambient element
exchanging two commuting torus generators. Their orders are arbitrary
p-powers; neither an exponent-three hypothesis nor a nilpotency-class-two
hypothesis is needed. The concrete consumer is the ordinary G₂ three-primary
calculation in `Theory.SpecificGroups.G2.MultiplierOrdinary.OddThreePrimary`.

Source: central transfer in Aschbacher–Smith I.1.1–I.1.2, printed p.407,
and the ordinary G₂ multiplier entry in GLS III §6.1.
-/

namespace PerfectCentralCovering

open Subgroup
open scoped commutatorElement IsMulCommutative Pointwise

private theorem abelian_commute {E : Type*} [Group E] (A : Subgroup E)
    (hA : IsMulCommutative A) {a b : E} (ha : a ∈ A) (hb : b ∈ A) : Commute a b := by
  let := hA
  exact congrArg Subtype.val (mul_comm (⟨a, ha⟩ : A) ⟨b, hb⟩)

private theorem derived_join_le {E : Type*} [Group E] (A B : Subgroup E)
    (hA : IsMulCommutative A) (hB : IsMulCommutative B)
    (hn : B ≤ normalizer (A : Set E)) : ⁅A ⊔ B, A ⊔ B⁆ ≤ ⁅A, B⁆ := by
  have hform {g : E} (hg : g ∈ A ⊔ B) : ∃ a ∈ A, ∃ b ∈ B, a * b = g := by
    have he := coe_mul_of_right_le_normalizer_left A B hn
    change g ∈ (↑(A ⊔ B) : Set E) at hg
    rw [he] at hg
    exact hg
  apply commutator_le.mpr
  intro x hx y hy
  obtain ⟨a, ha, b, hb, rfl⟩ := hform hx
  obtain ⟨c, hc, d, hd, rfl⟩ := hform hy
  rw [commutatorElement_mul_left_eq_conj_mul,
    commutatorElement_mul_right_eq_mul_conj,
    (abelian_commute B hB hb hd).commutator_eq, mul_one, mul_inv_cancel_right, commutatorElement_mul_right_eq_mul_conj,
    (abelian_commute A hA ha hc).commutator_eq, one_mul]
  apply mul_mem
  · exact (mem_normalizer_iff.mp (normalizer_commutator_ge_left A B ha) _).mp
      (by rw [commutator_comm]; exact commutator_mem_commutator hb hc)
  · exact (mem_normalizer_iff.mp (normalizer_commutator_ge_left A B hc) _).mp
      (commutator_mem_commutator ha hd)

private theorem inverted_commutators {E G : Type*} [Group E] [Group G]
    (f : E →* G) (hk : f.ker ≤ center E) (A B : Subgroup E)
    (hA : IsMulCommutative A) (hn : B ≤ normalizer (A : Set E))
    (s : E) (hsA : ∀ a ∈ A, f (s * a * s⁻¹) = f a⁻¹)
    (hsB : ∀ b ∈ B, f (s * b * s⁻¹) = f b) :
    ∀ d ∈ ⁅A, B⁆, s * d * s⁻¹ = d⁻¹ := by
  have hDA : ⁅A, B⁆ ≤ A := le_normalizer_iff_commutator_le_left.mp hn
  intro d hd
  change d ∈ closure {g | ∃ a ∈ A, ∃ b ∈ B, ⁅a,b⁆ = g} at hd
  induction hd using closure_induction with
  | mem d hd =>
    obtain ⟨a, ha, b, hb, rfl⟩ := hd
    rw [conjugate_commutatorElement,
      CentralExtension.commutator_eq_of_image_eq f hk (hsA a ha) (hsB b hb),
      commutatorElement_inv_left, ← commutatorElement_inv]
    have hc := abelian_commute A hA (A.inv_mem ha)
      (A.inv_mem (hDA (commutator_mem_commutator ha hb)))
    rw [hc.eq, inv_mul_cancel_right]
  | one => simp
  | mul a b ha hb iha ihb =>
    calc
      s * (a*b) * s⁻¹ = (s*a*s⁻¹)*(s*b*s⁻¹) := by group
      _ = a⁻¹*b⁻¹ := by rw [iha, ihb]
      _ = (a*b)⁻¹ := by rw [mul_inv_rev, (abelian_commute A hA (hDA ha) (hDA hb)).inv_inv.eq]
  | inv a ha ih =>
    calc
      s * a⁻¹ * s⁻¹ = (s*a*s⁻¹)⁻¹ := by group
      _ = (a⁻¹)⁻¹ := by rw [ih]

/-- An inverted abelian torus preimage with a fixed cyclic supplement
excludes the odd Sylow prime from a perfect central kernel. -/
public theorem not_dvd_card_kernel_of_torus_normalizer {E G : Type*} [Group E] [Finite E] [Group.IsPerfect E]
    [Group G] [Finite G] (f : E →* G) (hf : Function.Surjective f)
    (hk : f.ker ≤ center E) {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (Q : Sylow p G) (T : Subgroup G) (c r : G)
    (hQ : T ⊔ zpowers c = (Q : Subgroup G)) (hc : c ∈ normalizer (T : Set G))
    (hT : IsMulCommutative (T.comap f))
    (hrT : ∀ t ∈ T, r*t*r⁻¹ = t⁻¹) (hrc : Commute r c) :
    ¬ p ∣ Nat.card f.ker := by
  obtain ⟨b, hb⟩ := hf c
  obtain ⟨s, hs⟩ := hf r
  let A := T.comap f
  let B := zpowers b
  have hBA : B ≤ normalizer (A : Set E) := by
    apply zpowers_le.mpr
    apply mem_normalizer_iff.mpr
    intro a
    change f a ∈ T ↔ f (b*a*b⁻¹) ∈ T
    simpa only [map_mul, map_inv, hb] using mem_normalizer_iff.mp hc (f a)
  have hgen : A ⊔ B = (Q : Subgroup G).comap f := by
    have he : (A ⊔ B).map f = (Q : Subgroup G) := by
      rw [Subgroup.map_sup, map_comap_eq_self_of_surjective hf, MonoidHom.map_zpowers, hb, hQ]
    rw [← he, comap_map_eq_self]
    exact (T.ker_le_comap f).trans le_sup_left
  have hinv : ∀ d ∈ ⁅A,B⁆, s*d*s⁻¹ = d⁻¹ :=
    inverted_commutators f hk A B hT hBA s
      (fun a ha => by simpa only [map_mul, map_inv, hs] using hrT (f a) ha)
      (by
        intro d hd
        obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hd
        simp only [map_mul, map_inv, map_zpow, hs, hb]
        rw [(hrc.zpow_right k).eq, mul_inv_cancel_right])
  intro hd
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' p hd
  have hzE : orderOf (z : E) = p := (Subgroup.orderOf_coe z).trans hz
  let Z := zpowers (z : E)
  have hZker : Z ≤ f.ker := zpowers_le.mpr z.property
  have hZp : IsPGroup p Z := IsPGroup.of_card (n := 1)
    (by simpa only [Z, Nat.card_zpowers, pow_one] using hzE)
  have hzder : (z : E) ∈ ⁅A ⊔ B,A ⊔ B⁆ := by
    apply central_pSubgroup_le_commutator (A ⊔ B) Z
      (hZker.trans (by rw [hgen]; exact (Q : Subgroup G).ker_le_comap f))
      (hZker.trans hk) hZp _ (mem_zpowers _)
    rw [hgen, index_comap_of_surjective _ hf]
    exact Q.not_dvd_index
  have hzInv := hinv z (derived_join_le A B hT inferInstance hBA hzder)
  rw [mem_center_iff.mp (hk z.property) s, mul_inv_cancel_right] at hzInv
  have hzsq : (z : E)^2 = 1 := by rw [pow_two, hzInv, inv_mul_eq_one]; exact hzInv
  have hdiv : p ∣ 2 := hzE ▸ orderOf_dvd_of_pow_eq_one hzsq
  exact hp ((Nat.prime_dvd_prime_iff_eq (Fact.out : p.Prime) Nat.prime_two).mp hdiv)

/-- Two swapped commuting torus generators and a torus inverter fixing
the cyclic supplement exclude the odd Sylow prime, at every exponent. -/
public theorem not_dvd_card_kernel_of_swapped_torus_normalizer {E G : Type*} [Group E] [Finite E] [Group.IsPerfect E]
    [Group G] [Finite G] (f : E →* G) (hf : Function.Surjective f)
    (hk : f.ker ≤ center E) {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (Q : Sylow p G) (T : Subgroup G) (x y c r s : G)
    (hT : closure ({x,y} : Set G) = T) (hxy : Commute x y)
    (hsx : s*x*s⁻¹ = y) (hsy : s*y*s⁻¹ = x)
    (hQ : T ⊔ zpowers c = (Q : Subgroup G)) (hc : c ∈ normalizer (T : Set G))
    (hrT : ∀ t ∈ T, r*t*r⁻¹ = t⁻¹) (hrc : Commute r c) :
    ¬ p ∣ Nat.card f.ker := by
  have hxT : x ∈ T := hT ▸ subset_closure (by simp)
  have hxQ : x ∈ (Q : Subgroup G) := hQ ▸ mem_sup_left hxT
  obtain ⟨k, hkQ⟩ := Q.isPGroup'.exists_card_eq
  have hn : (Nat.card Q).Coprime 2 := by
    rw [hkQ]
    apply Nat.Coprime.pow_left
    apply (Nat.prime_two.coprime_iff_not_dvd.mpr _).symm
    intro hd
    exact hp ((Nat.prime_dvd_prime_iff_eq Nat.prime_two (Fact.out : p.Prime)).mp hd).symm
  have hx : x ^ Nat.card Q = 1 :=
    congrArg Subtype.val (pow_card_eq_one' (x := (⟨x, hxQ⟩ : Q)))
  obtain ⟨a, ha⟩ := hf x
  obtain ⟨b, hb⟩ := hf y
  have hab := CentralExtension.commute_lifts_of_swap f hf hk x y s hn hx hxy hsx hsy a b ha hb
  exact not_dvd_card_kernel_of_torus_normalizer f hf hk hp Q T c r hQ hc
    (CentralExtension.isMulCommutative_comap_of_pair_lifts f hk T a b hab
      (by simpa only [ha,hb] using hT)) hrT hrc

end PerfectCentralCovering
