module
public import Theory.ElementaryAbelian.Basic
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Tactic

/-!
# Normalizers of elementary subgroups above an involution

Let a homomorphism have elementary abelian two-kernel A, and let an elementary
two-subgroup U have image generated by an involution z. If A∩C(U)=A∩U, its
normalizer is exactly the inverse image of C(z). No prescribed group orders,
surjectivity, or additional normalization assumption is required.

Choose an involution u in U over z. Any other involution x over z is a*u
with a in A. The three square-one relations imply that a commutes with u.
It also commutes with the kernel part of U, so it centralizes U; the fixed
intersection condition puts a in U. Thus U contains every involution over z.
An element above C(z) conjugates those involutions among themselves. Products
of two such involutions also cover the kernel part of U, proving invariance.
Conversely a normalizer element induces an automorphism of the two-element
image and therefore centralizes its unique nonidentity element.

This reusable coset argument supports the initial-vertex normalizer lift in
Stellmacher (9.1), Journal of Algebra190 (1997), p.48.
-/

namespace Subgroup
open scoped Pointwise

private theorem mem_zpowers_two_iff {W : Type*} [Group W] [Finite W]
    {z w : W} (hz : orderOf z = 2) : w ∈ zpowers z ↔ w = 1 ∨ w = z := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, hz]
  constructor
  · intro hw
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hw
    have hnlt : n < 2 := Finset.mem_range.mp hn
    interval_cases n <;> simp
  · rintro (rfl | rfl)
    · exact Finset.mem_image.mpr ⟨0, by simp, by simp⟩
    · exact Finset.mem_image.mpr ⟨1, by simp, by simp⟩

/-- The normalizer of the elementary subgroup is the inverse image of the
centralizer of its involution image when the kernel fixed subgroup is exact. -/
public theorem normalizer_eq_comap_centralizer_of_elementary_kernel
    {G W : Type*} [Group G] [Finite G] [Group W] [Finite W]
    (f : G →* W) (U : Subgroup G)
    (hA : IsElementaryAbelian 2 f.ker) (hU : IsElementaryAbelian 2 U)
    (hfixed : f.ker ⊓ centralizer (U : Set G) = f.ker ⊓ U)
    (z : W) (hz : orderOf z = 2) (himage : U.map f = zpowers z) :
    normalizer (U : Set G) = (centralizer ({z} : Set W)).comap f := by
  classical
  let := hA
  let := hU
  have hzpow : z ^ 2 = 1 := by rw [← hz]; exact pow_orderOf_eq_one z
  have hzne : z ≠ 1 := by intro h; simp [h] at hz
  obtain ⟨u, hu, huf⟩ := (himage.symm ▸ mem_zpowers z : z ∈ U.map f)
  have hu2 : u ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian u hu
  have image_cases (v : G) (hv : v ∈ U) : f v = 1 ∨ f v = z :=
    (mem_zpowers_two_iff hz).mp (himage ▸ mem_map_of_mem f hv)
  have outside_mem (x : G) (hxf : f x = z) (hx2 : x ^ 2 = 1) : x ∈ U := by
    let a := x * u⁻¹
    have ha : a ∈ f.ker := by simp only [MonoidHom.mem_ker, a, map_mul, map_inv, hxf, huf, mul_inv_cancel]
    have ha2 : a ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian a ha
    have hxu : Commute a u := by
      have hinva : a⁻¹ = a := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using ha2)
      have hinvu : u⁻¹ = u := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hu2)
      have hinvx : x⁻¹ = x := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hx2)
      have hh : a * u = u * a := by
        calc
          a * u = x := by simp [a]
          _ = x⁻¹ := hinvx.symm
          _ = u * a := by rw [show x = a * u by simp [a], mul_inv_rev, hinva, hinvu]
      exact hh
    have haC : a ∈ centralizer (U : Set G) := by
      apply mem_centralizer_iff.mpr
      intro v hv
      rcases image_cases v hv with hv1 | hvz
      · have hvA : v ∈ f.ker := MonoidHom.mem_ker.mpr hv1
        exact setLike_mul_comm hvA ha
      · let b := v * u⁻¹
        have hb : b ∈ f.ker := by simp only [MonoidHom.mem_ker, b, map_mul, map_inv, hvz, huf, mul_inv_cancel]
        have hba : Commute b a := setLike_mul_comm hb ha
        have hh := hba.mul_left hxu.symm
        simpa [b] using hh.eq
    have haU : a ∈ U := (hfixed ▸ (show a ∈ f.ker ⊓ centralizer (U : Set G) from ⟨ha, haC⟩)).2
    have hh := U.mul_mem haU hu
    simpa [a] using hh
  apply le_antisymm
  · intro n hn
    change f n ∈ centralizer ({z} : Set W)
    apply mem_centralizer_singleton_iff.mpr
    have hnu := (mem_normalizer_iff.mp hn u).mp hu
    have hconj : f n * z * (f n)⁻¹ = 1 ∨ f n * z * (f n)⁻¹ = z := by
      simpa only [map_mul, map_inv, huf] using image_cases (n * u * n⁻¹) hnu
    rcases hconj with hbad | hgood
    · have hh := congrArg (fun x => (f n)⁻¹ * x * f n) hbad
      exact (hzne (by simpa [mul_assoc] using hh)).elim
    · exact mul_inv_eq_iff_eq_mul.mp hgood
  · intro n hn
    apply mem_normalizer_iff.mpr
    have hnf : Commute (f n) z := mem_centralizer_singleton_iff.mp hn
    have hforward (n : G) (hnf : Commute (f n) z) : ∀ v ∈ U, n * v * n⁻¹ ∈ U := by
      have hout (v : G) (hv : v ∈ U) (hf : f v = z) : n * v * n⁻¹ ∈ U := by
        refine outside_mem _ ?_ ?_
        · rw [map_mul, map_mul, map_inv, hf, hnf.eq, mul_inv_cancel_right]
        · change (MulAut.conj n v) ^ 2 = 1
          rw [← map_pow]
          have hv2 : v ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian v hv
          rw [hv2, map_one]
      intro v hv
      rcases image_cases v hv with hv1 | hvz
      · have hfu : f (v * u) = z := by rw [map_mul, hv1, one_mul, huf]
        have hprod := U.mul_mem (hout (v * u) (U.mul_mem hv hu) hfu) (U.inv_mem (hout u hu huf))
        have heq : (n * (v * u) * n⁻¹) * (n * u * n⁻¹)⁻¹ = n * v * n⁻¹ := by group
        rwa [heq] at hprod
      · exact hout v hv hvz
    intro v
    constructor
    · exact hforward n hnf v
    · intro hv
      have hninv : Commute (f n⁻¹) z := by simpa only [map_inv] using hnf.inv_left
      have hh := hforward n⁻¹ hninv _ hv
      simpa [mul_assoc] using hh

end Subgroup
