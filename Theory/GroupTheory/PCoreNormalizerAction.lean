module
public import Theory.GroupTheory.CentralCharacteristicAutomorphisms
public import Theory.GroupTheory.SolvableOuterQuotient
public import Theory.GroupTheory.PCoreLocalSetup

/-!
# Prime generators acting on an intrinsic core quotient

The normalizer of J acts on J/O_p(J) by the original conjugation and quotient
maps. Its inner-action preimage is J times the actual action kernel. Kernel
membership means that every commutator lies in O_p(J); it does not assert
ordinary centralization of J.

If J is generated by commutators with a prime-generated subgroup, some prime
generator acts nontrivially on this quotient. When the quotient has order
prime to that prime, this automorphism and its outer class have the same
prime order. The proof uses only commutator generation and order divisibility.

Source application: Aschbacher--Smith 14.6.15, printed p.1035, the five-rank-zero
branch of the escaping component in the second normalizer.
-/

@[expose] public section
open Subgroup
open scoped commutatorElement
namespace Subgroup
variable {G : Type*} [Group G] (p : ℕ) (J : Subgroup G)

/-- Conjugation on the literal intrinsic prime-core quotient. -/
def pCoreNormalizerAction : normalizer (J : Set G) →* MulAut (J ⧸ pCore p J) :=
  (quotientAut (pCore p J)).comp J.normalizerMonoidHom

/-- The quotient action on a representative retains the original conjugation. -/
theorem pCoreNormalizerAction_mk (x : normalizer (J : Set G)) (j : J) :
    pCoreNormalizerAction p J x (QuotientGroup.mk' (pCore p J) j) =
      QuotientGroup.mk' (pCore p J) (J.normalizerMonoidHom x j) :=
  quotientAut_apply_mk _ _ _

/-- The action kernel consists precisely of actors trivial modulo the local core. -/
theorem pCoreNormalizerAction_eq_one_iff (x : normalizer (J : Set G)) :
    pCoreNormalizerAction p J x = 1 ↔
      ∀ j : J, J.normalizerMonoidHom x j / j ∈ pCore p J := by
  constructor
  · intro hx j
    apply QuotientGroup.eq_iff_div_mem.mp
    exact (pCoreNormalizerAction_mk p J x j).symm.trans
      (DFunLike.congr_fun hx (QuotientGroup.mk' (pCore p J) j))
  · intro hx
    apply MulEquiv.ext
    intro y
    obtain ⟨j,rfl⟩ := QuotientGroup.mk'_surjective (pCore p J) y
    exact (pCoreNormalizerAction_mk p J x j).trans (QuotientGroup.eq_iff_div_mem.mpr (hx j))

/-- The original subgroup induces inner automorphisms through its quotient map. -/
theorem pCoreNormalizerAction_on_component (j : J) :
    pCoreNormalizerAction p J ⟨j,J.le_normalizer j.property⟩ =
      MulAut.conj (QuotientGroup.mk' (pCore p J) j) := by
  apply MulEquiv.ext
  intro y
  obtain ⟨k,rfl⟩ := QuotientGroup.mk'_surjective (pCore p J) y
  rw [pCoreNormalizerAction_mk]
  change QuotientGroup.mk' (pCore p J) (j * k * j⁻¹) = _
  simp only [map_mul,map_inv,MulAut.conj_apply]

/-- Every inner automorphism occurs, with no choice of model coordinates. -/
theorem pCoreNormalizerAction_component_image :
    (J.subgroupOf (normalizer (J : Set G))).map (pCoreNormalizerAction p J) =
      MulAut.innerSubgroup (J ⧸ pCore p J) := by
  apply le_antisymm
  · rintro α ⟨x,hx,rfl⟩
    exact ⟨QuotientGroup.mk' (pCore p J) ⟨x,hx⟩,
      (pCoreNormalizerAction_on_component p J ⟨x,hx⟩).symm⟩
  · rintro α ⟨y,rfl⟩
    obtain ⟨j,rfl⟩ := QuotientGroup.mk'_surjective (pCore p J) y
    exact ⟨⟨j,J.le_normalizer j.property⟩,j.property,pCoreNormalizerAction_on_component p J j⟩

/-- The outer class of this same quotient action. -/
def pCoreNormalizerOuterAction : normalizer (J : Set G) →* MulAut.Outer (J ⧸ pCore p J) :=
  (QuotientGroup.mk' (MulAut.innerSubgroup (J ⧸ pCore p J))).comp
    (pCoreNormalizerAction p J)

/-- Acting internally is membership in J times the actual quotient-action kernel. -/
theorem pCoreNormalizerOuterAction_ker :
    (pCoreNormalizerOuterAction p J).ker = J.subgroupOf (normalizer (J : Set G)) ⊔
      (pCoreNormalizerAction p J).ker := by
  have he : (pCoreNormalizerOuterAction p J).ker =
      (MulAut.innerSubgroup (J ⧸ pCore p J)).comap (pCoreNormalizerAction p J) := by
    ext x
    exact QuotientGroup.eq_one_iff _
  rw [he,←pCoreNormalizerAction_component_image,comap_map_eq]

/-- Trivial action places all commutators in the embedded core. -/
theorem commutator_le_core_of_pCoreNormalizerAction_eq_one (K : Subgroup G)
    (hK : K ≤ normalizer (J : Set G))
    (h : ∀ k : K, pCoreNormalizerAction p J (inclusion hK k) = 1) :
    ⁅J,K⁆ ≤ J.pCoreIn p := by
  rw [commutator_comm]
  apply commutator_le.mpr
  intro k hk j hj
  have hh := (pCoreNormalizerAction_eq_one_iff p J (inclusion hK ⟨k,hk⟩)).mp
    (h ⟨k,hk⟩) ⟨j,hj⟩
  exact ⟨J.normalizerMonoidHom (inclusion hK ⟨k,hk⟩) ⟨j,hj⟩ / ⟨j,hj⟩,hh,by
    change k * j * k⁻¹ / j = k * j * k⁻¹ * j⁻¹
    exact div_eq_mul_inv _ _⟩

/-- Commutator generation forces a prime generator to move the nontrivial quotient. -/
theorem exists_prime_generator_nontrivial_core_action {r : ℕ} (K : Subgroup G)
    (hK : K ≤ normalizer (J : Set G))
    (hgen : closure {k : G | k ∈ K ∧ orderOf k = r} = K)
    (hcomm : J = ⁅J,K⁆) (hproper : pCore p J ≠ ⊤) :
    ∃ k : K, orderOf k = r ∧ pCoreNormalizerAction p J (inclusion hK k) ≠ 1 := by
  by_contra! hn
  have hker : K ≤ ((pCoreNormalizerAction p J).ker).map (normalizer (J : Set G)).subtype := by
    rw [←hgen]
    apply (closure_le _).mpr
    rintro k ⟨hk,ho⟩
    exact ⟨inclusion hK ⟨k,hk⟩,hn ⟨k,hk⟩ ((K.orderOf_coe _).symm.trans ho),rfl⟩
  have hact (k : K) : pCoreNormalizerAction p J (inclusion hK k) = 1 := by
    obtain ⟨x,hx,he⟩ := hker k.property
    have he' : x = inclusion hK k := Subtype.ext he
    exact he' ▸ hx
  have hle : J ≤ J.pCoreIn p := hcomm.le.trans
    (commutator_le_core_of_pCoreNormalizerAction_eq_one p J K hK hact)
  apply hproper
  apply map_injective J.subtype_injective
  rw [←MonoidHom.range_eq_map,range_subtype]
  exact le_antisymm (map_subtype_le _) hle
end Subgroup

namespace MulAut
variable {G : Type*} [Group G] {p : ℕ} [Fact p.Prime]
omit [Fact p.Prime] in
/-- An inner automorphism of prime order would make that prime divide the group order. -/
theorem prime_order_not_inner_of_not_dvd_card (a : MulAut G)
    (ha : orderOf a = p) (hc : ¬p ∣ Nat.card G) : a ∉ innerSubgroup G := by
  rintro ⟨g,hg⟩
  apply hc
  rw [←ha,←hg]
  exact (orderOf_map_dvd MulAut.conj g).trans (orderOf_dvd_natCard g)

/-- A noninner prime-order automorphism retains its order in the outer quotient. -/
theorem outer_order_eq_prime_of_prime_order_not_inner (a : MulAut G)
    (ha : orderOf a = p) (hi : a ∉ innerSubgroup G) :
    orderOf (QuotientGroup.mk' (innerSubgroup G) a) = p := by
  apply orderOf_eq_prime
  · rw [←map_pow,←ha,pow_orderOf_eq_one,map_one]
  · exact fun h => hi ((QuotientGroup.eq_one_iff a).mp h)
end MulAut
