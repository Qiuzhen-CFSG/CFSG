module

public import Theory.GroupTheory.CentralizerConjugateGeneration

/-!
# Transport from controlled element fusion

Suppose the normalizer of `V` controls the fusion of one element `z` into `V`.
Every conjugate of `V` containing `z` is then a conjugate under `C_G(z)`.
Correct the given conjugator on the right by an element of `N_G(V)` which
carries `z` to its preimage. This also transports containment in a subgroup
normalized by `C_G(z)`, and gives commutation when the subgroup generated by
the centralizer conjugates is abelian.

Only the orbit of `z` matters. No transitivity on all nonidentity elements of
`V` is assumed. This distinction is needed when the acting group has more
than one orbit on `V`.

Source application: Aschbacher–Smith, *The Classification of Quasithin Groups*,
combined manuscript (1 March 2004), Lemma 12.5.9(4), printed p. 821, and the
last paragraph of the proof of Theorem 12.5.1, printed p. 822. These are the
general transport arguments; the module-specific fusion and local-core
hypotheses must be established separately. `MulAut.conj g` is left conjugation;
use `g⁻¹` for the source's right-conjugation convention.
-/

namespace Subgroup
variable {G : Type*} [Group G] {V Q : Subgroup G} {z g : G}

/-- Correct a conjugator using fusion control only on the orbit of `z`. -/
public theorem exists_centralizer_conjugator_of_element_fusion
    (hfusion : ∀ a : G, MulAut.conj a z ∈ V →
      ∃ n ∈ normalizer (V : Set G), MulAut.conj n z = MulAut.conj a z)
    (hg : z ∈ V.map (MulAut.conj g).toMonoidHom) :
    ∃ c : centralizer ({z} : Set G),
      V.map (MulAut.conj (c : G)).toMonoidHom =
        V.map (MulAut.conj g).toMonoidHom := by
  have hpre : MulAut.conj g⁻¹ z ∈ V := by
    obtain ⟨x, hx, rfl⟩ := hg
    simpa [MulAut.conj_apply, mul_assoc] using hx
  obtain ⟨n, hn, hnz⟩ := hfusion g⁻¹ hpre
  have hcz : MulAut.conj (g * n) z = z := by
    calc
      MulAut.conj (g * n) z = MulAut.conj g (MulAut.conj n z) := by
        simp [MulAut.conj_apply, mul_assoc]
      _ = z := by rw [hnz]; simp [MulAut.conj_apply, mul_assoc]
  have hc : g * n ∈ centralizer ({z} : Set G) :=
    mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hcz)
  refine ⟨⟨g * n, hc⟩, ?_⟩
  have hnV : V.map (MulAut.conj n).toMonoidHom = V :=
    mem_normalizer_iff_map_conj_eq.mp hn
  have hcomp : (MulAut.conj (g * n)).toMonoidHom =
      (MulAut.conj g).toMonoidHom.comp (MulAut.conj n).toMonoidHom := by
    ext a
    simp [MulAut.conj_apply, mul_assoc]
  change V.map (MulAut.conj (g * n)).toMonoidHom = _
  rw [hcomp, ← Subgroup.map_map, hnV]

/-- Controlled fusion puts every conjugate containing `z` in the centralizer-generated subgroup. -/
public theorem conjugate_le_centralizerConjugateClosure_of_element_fusion
    (hfusion : ∀ a : G, MulAut.conj a z ∈ V →
      ∃ n ∈ normalizer (V : Set G), MulAut.conj n z = MulAut.conj a z)
    (hg : z ∈ V.map (MulAut.conj g).toMonoidHom) :
    V.map (MulAut.conj g).toMonoidHom ≤ centralizerConjugateClosure V z := by
  obtain ⟨c, hc⟩ := exists_centralizer_conjugator_of_element_fusion hfusion hg
  rw [← hc]
  exact le_iSup (fun c : centralizer ({z} : Set G) =>
    V.map (MulAut.conj (c : G)).toMonoidHom) c

/-- Transport containment in `Q`, assuming only that `C_G(z)` normalizes `Q`. -/
public theorem conjugate_le_of_element_fusion_of_normalized
    (hfusion : ∀ a : G, MulAut.conj a z ∈ V →
      ∃ n ∈ normalizer (V : Set G), MulAut.conj n z = MulAut.conj a z)
    (hVQ : V ≤ Q) (hQ : centralizer ({z} : Set G) ≤ normalizer (Q : Set G))
    (hg : z ∈ V.map (MulAut.conj g).toMonoidHom) :
    V.map (MulAut.conj g).toMonoidHom ≤ Q := by
  obtain ⟨c, hc⟩ := exists_centralizer_conjugator_of_element_fusion hfusion hg
  rw [← hc]
  exact (map_mono hVQ).trans_eq (mem_normalizer_iff_map_conj_eq.mp (hQ c.property))

/-- Abelian centralizer generation forces a conjugate containing `z` to commute with `V`. -/
public theorem commutator_eq_bot_of_element_fusion_of_abelian_closure
    (hfusion : ∀ a : G, MulAut.conj a z ∈ V →
      ∃ n ∈ normalizer (V : Set G), MulAut.conj n z = MulAut.conj a z)
    [IsMulCommutative (centralizerConjugateClosure V z)]
    (hg : z ∈ V.map (MulAut.conj g).toMonoidHom) :
    ⁅V, V.map (MulAut.conj g).toMonoidHom⁆ = ⊥ := by
  apply le_bot_iff.mp
  exact (commutator_mono (le_centralizerConjugateClosure V z)
    (conjugate_le_centralizerConjugateClosure_of_element_fusion hfusion hg)).trans_eq (commutator_self_eq_bot_iff.mpr inferInstance)
end Subgroup
