module
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# Squares in an extension by a normalizing involution

If t normalizes N and t²=1, every element of N joined with the cyclic
subgroup generated by t has square in N. Normalization expresses each element
as n times a power of t; the square is then a product of two elements of N.
The representation-theoretic consumer uses this to descend traces from N
to the literal extension N⟨t⟩ in characteristic two.
-/

public section
open scoped Pointwise
namespace Subgroup
variable {G : Type*} [Group G]
/-- Adjoining a normalizing involution makes the quotient have exponent two. -/
theorem square_mem_of_mem_sup_zpowers_involution (N : Subgroup G) (t : G)
    (ht : t^2=1) (hn : t∈normalizer (N:Set G)) {x:G}
    (hx : x∈N⊔zpowers t) : x^2∈N := by
  have hnorm : zpowers t ≤ normalizer (N:Set G) := zpowers_le.mpr hn
  have hx' : x∈(N:Set G)*(zpowers t:Set G) := by
    rw [←coe_mul_of_right_le_normalizer_left N (zpowers t) hnorm]
    exact hx
  obtain ⟨n,hnN,z,hz,rfl⟩ := hx'
  have hz2 : z^2=1 := by
    obtain ⟨i,rfl⟩ := mem_zpowers_iff.mp hz
    rw [←zpow_natCast,←zpow_mul,Int.mul_comm,zpow_mul,zpow_natCast,ht,one_zpow]
  have hconj : z*n*z⁻¹∈N := (mem_normalizer_iff.mp (hnorm hz) n).mp hnN
  have he : (n*z)^2=n*(z*n*z⁻¹) := by
    calc
      (n*z)^2=n*(z*n*z⁻¹)*z^2 := by simp only [pow_two, mul_assoc, inv_mul_cancel_left]
      _ = n*(z*n*z⁻¹) := by rw [hz2,mul_one]
  rw [he]
  exact N.mul_mem hnN hconj
end Subgroup

