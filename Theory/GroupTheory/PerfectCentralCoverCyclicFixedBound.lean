module

public import Theory.GroupTheory.CentralExtensionSwap
public import Theory.GroupTheory.PerfectCentralSupplement

/-!
# A torus fixed-subgroup bound for perfect central kernels

Let a subgroup of index prime to `p` be generated by a torus `T` and a
cyclic supplement. If the full preimage of `T` in a central extension is
abelian, its commutator map with a lift of the cyclic generator is a
homomorphism. Centrality of the covering kernel makes this map factor
through `T`. Its range is the derived subgroup of the full local preimage;
the kernel of the covering on that range is an image of the fixed subgroup
of `T`. Central transfer therefore bounds every `p`-power divisor of the
perfect central kernel by the order of this fixed subgroup.

An ambient swap of two odd-order torus generators supplies the abelian
preimage condition. No bound on the exponent of the torus is assumed.
The concrete consumer is `PSU3.UniversalCover.EvenKernelBound.ThreePrimary`.

Source: the central transfer argument in Aschbacher–Smith I.1.1–I.1.3,
printed p.407 (PDF p.418), and GLS III §6.1.
-/

public section

open Subgroup
open scoped commutatorElement IsMulCommutative Pointwise

namespace PerfectCentralCovering

private theorem abelian_commute {E : Type*} [Group E] (A : Subgroup E)
    (hA : IsMulCommutative A) {a b : E} (ha : a ∈ A) (hb : b ∈ A) : Commute a b := by
  let := hA
  exact congrArg Subtype.val (mul_comm (⟨a, ha⟩ : A) ⟨b, hb⟩)

private theorem derived_join_le {E : Type*} [Group E] (A B : Subgroup E)
    (hA : IsMulCommutative A) (hB : IsMulCommutative B)
    (hn : B ≤ normalizer (A : Set E)) : ⁅A ⊔ B, A ⊔ B⁆ ≤ ⁅A, B⁆ := by
  have hform {g : E} (hg : g ∈ A ⊔ B) : ∃ a ∈ A, ∃ b ∈ B, a * b = g := by
    have he := coe_mul_of_right_le_normalizer_left A B hn
    change g ∈ (↑(A ⊔ B) : Set E) at hg
    rw [he] at hg
    exact hg
  apply commutator_le.mpr
  intro x hx y hy
  obtain ⟨a, ha, b, hb, rfl⟩ := hform hx
  obtain ⟨c, hc, d, hd, rfl⟩ := hform hy
  rw [commutatorElement_mul_left_eq_conj_mul,
    commutatorElement_mul_right_eq_mul_conj,
    (abelian_commute B hB hb hd).commutator_eq, mul_one, mul_inv_cancel_right,
    commutatorElement_mul_right_eq_mul_conj,
    (abelian_commute A hA ha hc).commutator_eq, one_mul]
  apply mul_mem
  · exact (mem_normalizer_iff.mp (normalizer_commutator_ge_left A B ha) _).mp
      (by rw [commutator_comm]; exact commutator_mem_commutator hb hc)
  · exact (mem_normalizer_iff.mp (normalizer_commutator_ge_left A B hc) _).mp
      (commutator_mem_commutator ha hd)

private theorem exists_commutator_hom {E : Type*} [Group E] [Finite E]
    (A : Subgroup E) (hA : IsMulCommutative A) (b : E)
    (hb : b ∈ normalizer (A : Set E)) :
    ∃ d : A →* E, (∀ a, d a = ⁅(a : E), b⁆) ∧
      d.range = ⁅A ⊔ zpowers b, A ⊔ zpowers b⁆ := by
  have hn : zpowers b ≤ normalizer (A : Set E) := zpowers_le.mpr hb
  have hDA : ⁅A, zpowers b⁆ ≤ A := le_normalizer_iff_commutator_le_left.mp hn
  let d : A →* E := {
    toFun a := ⁅(a : E), b⁆
    map_one' := by simp
    map_mul' a a' := by
      change ⁅(a : E) * a', b⁆ = ⁅(a : E), b⁆ * ⁅(a' : E), b⁆
      rw [commutatorElement_mul_left_eq_conj_mul,
        (abelian_commute A hA a.property
          (hDA (commutator_mem_commutator a'.property (mem_zpowers b)))).eq,
        mul_inv_cancel_right]
      exact (abelian_commute A hA
        (hDA (commutator_mem_commutator a'.property (mem_zpowers b)))
        (hDA (commutator_mem_commutator a.property (mem_zpowers b)))).eq }
  have hd (a : A) : d a = ⁅(a : E), b⁆ := rfl
  have hconj {z : E} (hz : z ∈ d.range) : b * z * b⁻¹ ∈ d.range := by
    obtain ⟨a, rfl⟩ := hz
    refine ⟨⟨b * a * b⁻¹, (mem_normalizer_iff.mp hb a).mp a.property⟩, ?_⟩
    simp only [hd]
    conv_rhs => rw [conjugate_commutatorElement]
    simp
  have hp (a : E) (ha : a ∈ A) (n : ℕ) : ⁅a, b ^ n⁆ ∈ d.range := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ', commutatorElement_mul_right_eq_mul_conj,
        mul_assoc, mul_assoc, ← mul_assoc b]
      exact d.range.mul_mem ⟨⟨a,ha⟩,rfl⟩ (hconj ih)
  refine ⟨d, hd, le_antisymm ?_ ?_⟩
  · rintro z ⟨a,rfl⟩
    exact commutator_mem_commutator (mem_sup_left a.property) (mem_sup_right (mem_zpowers b))
  · apply (derived_join_le A (zpowers b) hA inferInstance hn).trans
    apply commutator_le.mpr
    intro a ha y hy
    obtain ⟨n,rfl⟩ := (mem_powers_iff_mem_zpowers.mpr hy)
    exact hp a ha n

private theorem exists_base_commutator_hom
    {E G : Type*} [Group E] [Finite E] [Group G]
    (f : E →* G) (hf : Function.Surjective f) (hk : f.ker ≤ center E)
    (T : Subgroup G) (c : G) (hc : c ∈ normalizer (T : Set G))
    (hT : IsMulCommutative (T.comap f)) :
    ∃ d : T →* E,
      (∀ t, f (d t) = ⁅(t : G), c⁆) ∧
      d.range = ⁅(T ⊔ zpowers c).comap f, (T ⊔ zpowers c).comap f⁆ := by
  classical
  obtain ⟨b, hb⟩ := hf c
  let A := T.comap f
  have hbA : b ∈ normalizer (A : Set E) := by
    apply mem_normalizer_iff.mpr
    intro a
    change f a ∈ T ↔ f (b*a*b⁻¹) ∈ T
    simpa only [map_mul, map_inv, hb] using mem_normalizer_iff.mp hc (f a)
  have hgen : A ⊔ zpowers b = (T ⊔ zpowers c).comap f := by
    have he : (A ⊔ zpowers b).map f = T ⊔ zpowers c := by
      rw [Subgroup.map_sup, map_comap_eq_self_of_surjective hf, MonoidHom.map_zpowers, hb]
    rw [← he, comap_map_eq_self]
    exact (T.ker_le_comap f).trans le_sup_left
  obtain ⟨d, hd, hrange⟩ := exists_commutator_hom A hT b hbA
  have hlift (t : T) : ∃ a : A, f a = t := by
    obtain ⟨a, ha⟩ := hf t
    exact ⟨⟨a, by change f a ∈ T; rw [ha]; exact t.property⟩, ha⟩
  let s : T → A := fun t => (hlift t).choose
  have hs (t : T) : f (s t) = t := (hlift t).choose_spec
  let δ : T →* E := {
    toFun t := d (s t)
    map_one' := by
      rw [hd, CentralExtension.commutator_eq_of_image_eq f hk
        (show f (s 1) = f 1 by rw [hs]; simp) rfl]
      simp
    map_mul' t t' := by
      change d (s (t*t')) = d (s t) * d (s t')
      rw [hd, CentralExtension.commutator_eq_of_image_eq f hk
        (show f (s (t*t')) = f (s t * s t') by rw [map_mul, hs, hs, hs]; rfl) rfl]
      exact (hd (s t * s t')).symm.trans (d.map_mul _ _) }
  have hδ (t : T) : δ t = ⁅(s t : E), b⁆ := hd (s t)
  refine ⟨δ, ?_, ?_⟩
  · intro t
    rw [hδ, map_commutatorElement, hs, hb]
  · have he : δ.range = d.range := by
      apply le_antisymm
      · rintro z ⟨t,rfl⟩
        exact ⟨s t,rfl⟩
      · rintro z ⟨a,rfl⟩
        refine ⟨⟨f a,a.property⟩, ?_⟩
        rw [hδ, hd]
        exact CentralExtension.commutator_eq_of_image_eq f hk (hs _) rfl
    rw [he, hrange, hgen]

/-- In a central extension with abelian torus preimage, the kernel on the
derived subgroup of the torus-by-cyclic preimage is bounded by the fixed
subgroup of the base torus. The commutator map factors through the base
torus because changing a lift by a central element does not change it. -/
theorem derived_preimage_kernel_card_le_fixed
    {E G : Type*} [Group E] [Finite E] [Group G] [Finite G]
    (f : E →* G) (hf : Function.Surjective f) (hk : f.ker ≤ center E)
    (T : Subgroup G) (c : G) (hc : c ∈ normalizer (T : Set G))
    (hT : IsMulCommutative (T.comap f)) :
    Nat.card (⁅(T ⊔ zpowers c).comap f, (T ⊔ zpowers c).comap f⁆ ⊓ f.ker : Subgroup E) ≤
      Nat.card (T ⊓ centralizer ({c} : Set G) : Subgroup G) := by
  obtain ⟨d, hd, hrange⟩ := exists_base_commutator_hom f hf hk T c hc hT
  let D := ⁅(T ⊔ zpowers c).comap f, (T ⊔ zpowers c).comap f⁆
  let C := T ⊓ centralizer ({c} : Set G)
  change d.range = D at hrange
  have hCT : C ≤ T := inf_le_left
  have hCC : C ≤ centralizer ({c} : Set G) := inf_le_right
  let g : C → (D ⊓ f.ker : Subgroup E) := fun t => by
    refine ⟨d ⟨t.val,hCT t.property⟩, ?_⟩
    change d ⟨t.val,hCT t.property⟩ ∈ D ∧ d ⟨t.val,hCT t.property⟩ ∈ f.ker
    constructor
    · rw [← hrange]
      exact ⟨⟨t.val,hCT t.property⟩,rfl⟩
    · rw [MonoidHom.mem_ker, hd]
      exact commutatorElement_eq_one_iff_mul_comm.mpr
        (mem_centralizer_singleton_iff.mp (hCC t.property))
  apply Nat.card_le_card_of_surjective g
  intro z
  have hzD : (z : E) ∈ d.range := by
    rw [hrange]
    exact (show (z : E) ∈ D ∧ (z : E) ∈ f.ker from z.property).1
  obtain ⟨t,ht⟩ := MonoidHom.mem_range.mp hzD
  have htc : (t : G) ∈ centralizer ({c} : Set G) := by
    apply mem_centralizer_singleton_iff.mpr
    apply commutatorElement_eq_one_iff_mul_comm.mp
    rw [← hd, ht]
    exact z.property.2
  exact ⟨⟨t, t.property, htc⟩, Subtype.ext ht⟩

/-- Central transfer bounds every prime-power divisor of a perfect central
kernel by the fixed subgroup in an abelian torus with cyclic supplement. -/
theorem Cover.primePower_le_torus_fixed_card
    {E G : Type*} [Group E] [Finite E] [Group G] [Finite G]
    (f : Cover E G) {p : ℕ} [Fact p.Prime]
    (T : Subgroup G) (c : G) (hc : c ∈ normalizer (T : Set G))
    (hT : IsMulCommutative (T.comap f.toMonoidHom))
    (hi : ¬ p ∣ (T ⊔ zpowers c).index)
    {n : ℕ} (hd : p ^ n ∣ Nat.card f.toMonoidHom.ker) :
    p ^ n ≤ Nat.card (T ⊓ centralizer ({c} : Set G) : Subgroup G) := by
  let := f.isPerfect
  obtain ⟨Z,hZ⟩ := Sylow.exists_subgroup_card_pow_prime
    (G := f.toMonoidHom.ker) p hd
  let K := Z.map f.toMonoidHom.ker.subtype
  let P := (T ⊔ zpowers c).comap f.toMonoidHom
  have hK : K ≤ f.toMonoidHom.ker := by
    rintro z ⟨k,_,rfl⟩
    exact k.property
  have hKP : K ≤ P := hK.trans ((T ⊔ zpowers c).ker_le_comap _)
  have hKp : IsPGroup p K := (IsPGroup.of_card hZ).map f.toMonoidHom.ker.subtype
  have hKD : K ≤ ⁅P,P⁆ := central_pSubgroup_le_commutator P K hKP
    (hK.trans f.ker_le_center) hKp (by
      rwa [index_comap_of_surjective _ f.surjective])
  have hcard : Nat.card K = p ^ n := by
    rw [Subgroup.card_map_of_injective f.toMonoidHom.ker.subtype_injective]
    exact hZ
  calc
    p ^ n = Nat.card K := hcard.symm
    _ ≤ Nat.card (⁅P,P⁆ ⊓ f.toMonoidHom.ker : Subgroup E) := card_le_of_le (le_inf hKD hK)
    _ ≤ Nat.card (T ⊓ centralizer ({c} : Set G) : Subgroup G) :=
      derived_preimage_kernel_card_le_fixed f.toMonoidHom f.surjective f.ker_le_center T c hc hT

/-- An ambient swap of two odd-order torus generators supplies the abelian
preimage required by the fixed-subgroup bound, without any exponent restriction. -/
theorem Cover.not_primePower_dvd_kernel_of_swapped_torus_fixed
    {E G : Type*} [Group E] [Finite E] [Group G] [Finite G]
    (f : Cover E G) {p : ℕ} [Fact p.Prime]
    (T : Subgroup G) (x y c s : G)
    (hgen : closure ({x,y} : Set G) = T) (hxy : Commute x y)
    (hsx : s*x*s⁻¹ = y) (hsy : s*y*s⁻¹ = x)
    {m : ℕ} (hm : m.Coprime 2) (hx : x ^ m = 1)
    (hc : c ∈ normalizer (T : Set G)) (hi : ¬ p ∣ (T ⊔ zpowers c).index)
    {n : ℕ} (hfixed : Nat.card (T ⊓ centralizer ({c} : Set G) : Subgroup G) < p ^ n) :
    ¬ p ^ n ∣ Nat.card f.toMonoidHom.ker := by
  obtain ⟨a,ha⟩ := f.surjective x
  obtain ⟨b,hb⟩ := f.surjective y
  have hab := CentralExtension.commute_lifts_of_swap f.toMonoidHom f.surjective
    f.ker_le_center x y s hm hx hxy hsx hsy a b ha hb
  have hT := CentralExtension.isMulCommutative_comap_of_pair_lifts
    f.toMonoidHom f.ker_le_center T a b hab (by simpa only [ha,hb] using hgen)
  intro hd
  exact (Nat.not_le_of_gt hfixed) (f.primePower_le_torus_fixed_card T c hc hT hi hd)

end PerfectCentralCovering
