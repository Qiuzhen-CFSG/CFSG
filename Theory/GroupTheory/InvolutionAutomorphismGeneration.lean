module

public import Mathlib.GroupTheory.GroupAction.ConjAct
public import Mathlib.Algebra.Group.Subgroup.Map

/-!
# Generation by inner conjugates of an involutory automorphism

This condition records actual generation in Aut(S), with all conjugating
elements in S. Such conjugators lift through every specified central cover,
so the condition can be used in an arbitrary ambient group containing that
cover. It makes no assertion that a particular group satisfies the condition.

Source: Guralnick--Malle, *Classification of 2F-modules, I*, equations
(2.5)--(2.6) and Proposition 5.1. The HS application uses five conjugates.
-/

@[expose] public section
namespace Theory.GroupTheory
open Subgroup

/-- The inner automorphisms lie in the subgroup generated by `n` inner
conjugates of every nonidentity involutory automorphism. -/
def InvolutionInnerConjugateGenerationBound (S : Type*) [Group S] (n : ℕ) : Prop :=
  ∀ t : MulAut S, t ≠ 1 → t ^ 2 = 1 →
    ∃ c : Fin n → S, (MulAut.conj : S →* MulAut S).range ≤
      closure (Set.range fun i => MulAut.conj (c i) * t * (MulAut.conj (c i))⁻¹)

end Theory.GroupTheory
