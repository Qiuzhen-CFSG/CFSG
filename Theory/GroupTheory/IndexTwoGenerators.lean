module

public import Mathlib.GroupTheory.Schreier
public import Mathlib.GroupTheory.IndexNormal

/-!
# Word generators for every subgroup of index two

Given generators s and a generator t outside an index-two subgroup, {1,t}
is a right transversal. Schreier's lemma gives two words per generator,
determined only by the Boolean record of which generators lie outside.
Thus a finite generating tuple gives a finite, literal list covering every
index-two subgroup. No group order or classification of subgroups is used.

The relative version applies inside the closure of the generating tuple,
and homomorphisms carry these word-defined candidates to the same candidates
in the image. Source: Schreier's lemma, as formalized in Mathlib.GroupTheory.Schreier.
-/

@[expose] public section

open Subgroup
open scoped Pointwise

namespace Subgroup
variable {G : Type*} [Group G] {ι : Type*}

/-- A Schreier word for the transversal {1,s k}; true records the outside coset. -/
def indexTwoGenerator (s : ι → G) (k : ι) (mask : ι → Bool) (e : Bool) (j : ι) : G :=
  (if e then s k else 1) * s j * (if e != mask j then s k else 1)⁻¹

/-- The subgroup generated by the two Schreier words for each given generator. -/
def indexTwoClosure (s : ι → G) (k : ι) (mask : ι → Bool) : Subgroup G :=
  closure {x | ∃ e j, indexTwoGenerator s k mask e j = x}

private theorem pair_complement (H : Subgroup G) (hi : H.index = 2)
    (t : G) (ht : t ∉ H) : IsComplement (H : Set G) ({1, t} : Set G) := by
  apply isComplement_iff_existsUnique_mul_inv_mem.mpr
  intro x
  by_cases hx : x ∈ H
  · refine ⟨⟨1, by simp⟩, by simpa, ?_⟩
    rintro ⟨y, hy⟩ hxy
    apply Subtype.ext
    rcases (show y = 1 ∨ y = t by simpa using hy) with hy | hy
    · exact hy
    · change x * y⁻¹ ∈ H at hxy
      rw [hy] at hxy
      have : t⁻¹ ∈ H := (H.mul_mem_cancel_left hx).mp hxy
      exact (ht (H.inv_mem_iff.mp this)).elim
  · refine ⟨⟨t, by simp⟩, ?_, ?_⟩
    · exact (H.mul_mem_iff_of_index_two hi).mpr (by simp [hx, ht])
    · rintro ⟨y, hy⟩ hxy
      apply Subtype.ext
      rcases (show y = 1 ∨ y = t by simpa using hy) with rfl | rfl
      · exact (hx (by simpa using hxy)).elim
      · rfl

/-- If the mask records membership in H and s k is outside, the words generate H. -/
theorem indexTwoClosure_eq (s : ι → G) (hs : closure (Set.range s) = ⊤)
    (H : Subgroup G) (hi : H.index = 2) (k : ι) (hk : s k ∉ H)
    (mask : ι → Bool) (hmask : ∀ j, mask j = true ↔ s j ∉ H) :
    indexTwoClosure s k mask = H := by
  let R : Set G := {1, s k}
  have hR : IsComplement (H : Set G) R := pair_complement H hi (s k) hk
  have hword (e : Bool) (j : ι) : indexTwoGenerator s k mask e j ∈ H := by
    cases hm : mask j with
    | false =>
      have hj : s j ∈ H := by simpa [hm] using hmask j
      cases e
      · simpa [indexTwoGenerator, hm] using hj
      · simpa [indexTwoGenerator, hm] using (H.normal_of_index_eq_two hi).conj_mem (s j) hj (s k)
    | true =>
      have hj : s j ∉ H := (hmask j).mp hm
      cases e
      · simpa [indexTwoGenerator, hm] using
          (H.mul_mem_iff_of_index_two hi (a := s j) (b := (s k)⁻¹)).mpr (by simp [hj, hk])
      · simpa [indexTwoGenerator, hm] using
          (H.mul_mem_iff_of_index_two hi (a := s k) (b := s j)).mpr (by simp [hj, hk])
  have hrep (e : Bool) (j : ι) :
      (hR.toRightFun ((if e then s k else 1) * s j) : G) =
        (if e != mask j then s k else 1) := by
    let r : R := ⟨if e != mask j then s k else 1, by split <;> simp [R]⟩
    have hr : (if e then s k else 1) * s j * (r : G)⁻¹ ∈ H := hword e j
    have he := (isComplement_iff_existsUnique_mul_inv_mem.mp hR
      ((if e then s k else 1) * s j)).unique
      (hR.mul_inv_toRightFun_mem _) hr
    exact congrArg Subtype.val (show hR.toRightFun _ = r from he)
  rw [indexTwoClosure, ← closure_mul_image_eq hR (by simp [R]) hs]
  congr 1
  ext x
  constructor
  · rintro ⟨e, j, rfl⟩
    refine ⟨(if e then s k else 1) * s j, ?_, ?_⟩
    · exact Set.mul_mem_mul (by cases e <;> simp [R]) (Set.mem_range_self j)
    · change _ * _ * ((hR.toRightFun _ : R) : G)⁻¹ = _
      rw [hrep]
      rfl
  · rintro ⟨y, ⟨r, hr, z, ⟨j, rfl⟩, rfl⟩, rfl⟩
    rcases (show r = 1 ∨ r = s k by simpa [R] using hr) with rfl | rfl
    · refine ⟨false, j, ?_⟩
      exact congrArg (fun r : G => (1 * s j) * r⁻¹) (hrep false j).symm
    · refine ⟨true, j, ?_⟩
      exact congrArg (fun r : G => (s k * s j) * r⁻¹) (hrep true j).symm


/-- Every index-two subgroup occurs in the word-defined family. -/
theorem exists_indexTwoClosure (s : ι → G) (hs : closure (Set.range s) = ⊤)
    (H : Subgroup G) (hi : H.index = 2) :
    ∃ (k : ι) (mask : ι → Bool), mask k = true ∧ indexTwoClosure s k mask = H := by
  classical
  have hout : ∃ k, s k ∉ H := by
    by_contra! h
    have hle : closure (Set.range s) ≤ H := (closure_le _).mpr (by rintro x ⟨j, rfl⟩; exact h j)
    have : H = ⊤ := top_unique (hs ▸ hle)
    simp [this] at hi
  obtain ⟨k, hk⟩ := hout
  let mask : ι → Bool := fun j => decide (s j ∉ H)
  exact ⟨k, mask, by simp [mask, hk], indexTwoClosure_eq s hs H hi k hk mask
    (by simp [mask])⟩

/-- Evaluating the same words commutes with any group homomorphism. -/
theorem map_indexTwoClosure {K : Type*} [Group K] (f : G →* K)
    (s : ι → G) (k : ι) (mask : ι → Bool) :
    (indexTwoClosure s k mask).map f = indexTwoClosure (f ∘ s) k mask := by
  rw [indexTwoClosure, MonoidHom.map_closure, indexTwoClosure]
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨y, ⟨e, j, rfl⟩, rfl⟩
    refine ⟨e, j, ?_⟩
    cases e <;> cases hm : mask j <;> simp [indexTwoGenerator, hm]
  · rintro ⟨e, j, rfl⟩
    refine ⟨indexTwoGenerator s k mask e j, ⟨e, j, rfl⟩, ?_⟩
    cases e <;> cases hm : mask j <;> simp [indexTwoGenerator, hm]

/-- The same finite catalogue applies inside a subgroup generated by the tuple. -/
theorem exists_indexTwoClosure_of_relIndex (s : ι → G) (P U : Subgroup G)
    (hs : closure (Set.range s) = P) (hUP : U ≤ P) (hi : U.relIndex P = 2) :
    ∃ (k : ι) (mask : ι → Bool), mask k = true ∧ indexTwoClosure s k mask = U := by
  let t : ι → P := fun j => ⟨s j, hs ▸ subset_closure (Set.mem_range_self j)⟩
  have ht : closure (Set.range t) = ⊤ := by
    apply map_injective P.subtype_injective
    rw [MonoidHom.map_closure, ← Set.range_comp, ← MonoidHom.range_eq_map, range_subtype]
    exact hs
  obtain ⟨k, mask, hk, he⟩ := exists_indexTwoClosure t ht (U.subgroupOf P) hi
  refine ⟨k, mask, hk, ?_⟩
  have hm := congrArg (map P.subtype) he
  rw [map_indexTwoClosure, map_subgroupOf_eq_of_le hUP] at hm
  exact hm
end Subgroup
