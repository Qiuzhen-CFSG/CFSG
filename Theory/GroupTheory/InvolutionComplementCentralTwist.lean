module
public import Mathlib.GroupTheory.SemidirectProduct
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
/-!
# Central twists of an involution complement

Let G split over a normal subgroup N with a complement generated by an
element v of order two. For a central element z of N with z²=1, fixing N
and sending v to vz defines an involutive automorphism. On the other coset
it sends every x to xz. The proof constructs a homomorphism from the actual
semidirect decomposition and proves that its square fixes both generators.

The order-two hypothesis on v is essential: the degenerate complement
v=1 would force the identity map on the whole group. This reusable result
supplies the extra point-endpoint adjustment for the marked unitary amalgam
in Aschbacher--Smith 13.5.17, printed p.922.
-/

public section
open Subgroup
namespace Subgroup
private theorem cyclic_generator {G : Type*} [Group G] (v : G) :
    ∀ x : zpowers v, x∈zpowers (⟨v,mem_zpowers v⟩ : zpowers v) := by
  intro x
  obtain ⟨n,hn⟩ := x.property
  exact mem_zpowers_iff.mpr ⟨n,Subtype.ext hn⟩

private theorem involution_power_cases {G : Type*} [Group G] (v : G)
    (hv : orderOf v=2) (x : zpowers v) : x=1 ∨ x=⟨v,mem_zpowers v⟩ := by
  have hvg : (⟨v,mem_zpowers v⟩ : zpowers v)≠1 := by
    intro h
    have hh : v=1 := congrArg Subtype.val h
    rw [hh,orderOf_one] at hv
    contradiction
  have hc : Nat.card (zpowers v)=2 := (Nat.card_zpowers v).trans hv
  by_cases h : x=1
  · exact Or.inl h
  · obtain ⟨z,_,hz⟩ := (Nat.card_eq_two_iff' (1 : zpowers v)).mp hc
    exact Or.inr ((hz x h).trans (hz _ hvg).symm)

/-- Multiplying a nontrivial involution complement by a central involution
in the normal factor defines an involutive automorphism fixing that factor. -/
theorem exists_involution_complement_central_twist
    {G : Type*} [Group G] (N : Subgroup G) [N.Normal]
    (v z : G) (hv : orderOf v=2) (hzN : z∈N) (hzC : z∈center G) (hz2 : z^2=1)
    (hcomp : N.IsComplement' (zpowers v)) :
    ∃ α : MulAut G, (∀ n : N, α n=(n:G)) ∧ α v=v*z ∧
      Function.Involutive α ∧ ∀ x : G, x∉N → α x=x*z := by
  let vg : zpowers v := ⟨v,mem_zpowers v⟩
  have hv2 : v^2=1 := hv ▸ pow_orderOf_eq_one v
  have hc : Commute v z := (mem_center_iff.mp hzC v)
  have hvz : (v*z)^2=1 := by rw [hc.mul_pow,hv2,hz2,mul_one]
  have hd : orderOf (v*z)∣orderOf vg := by
    rw [←orderOf_coe vg]
    change orderOf (v*z)∣orderOf v
    rw [hv]
    exact orderOf_dvd_of_pow_eq_one hvz
  let k := monoidHomOfForallMemZpowers (cyclic_generator v) hd
  have hk : k vg=v*z := monoidHomOfForallMemZpowers_apply_gen _ _
  let s := SemidirectProduct.mulEquivSubgroup hcomp
  have hact (x : zpowers v) : N.subtype.comp
      (((N.normalizerMonoidHom).comp (inclusion (N.normalizer_eq_top ▸ le_top))) x).toMonoidHom =
      (MulAut.conj (k x)).toMonoidHom.comp N.subtype := by
    rcases involution_power_cases v hv x with rfl | rfl
    · ext n
      simp
    · rw [hk]
      ext n
      change v*(n:G)*v⁻¹=(v*z)*(n:G)*(v*z)⁻¹
      have hn := mem_center_iff.mp hzC (n:G)
      calc
        v*(n:G)*v⁻¹ = v*((n:G)*z)*z⁻¹*v⁻¹ := by group
        _ = v*(z*(n:G))*z⁻¹*v⁻¹ := by rw [hn]
        _ = (v*z)*(n:G)*(v*z)⁻¹ := by group
  let F : G →* G := (SemidirectProduct.lift N.subtype k hact).comp s.symm.toMonoidHom
  have hN (n : N) : F n=(n:G) := by
    have hh : s (SemidirectProduct.inl n)=(n:G) := by simp [s]
    rw [←hh]
    change SemidirectProduct.lift N.subtype k hact (s.symm (s _))= _
    rw [s.symm_apply_apply,SemidirectProduct.lift_inl,hh]
    rfl
  have hV : F v=v*z := by
    have hh : s (SemidirectProduct.inr vg)=v := by simp [s,vg]
    rw [←hh]
    change SemidirectProduct.lift N.subtype k hact (s.symm (s _))= _
    rw [s.symm_apply_apply,SemidirectProduct.lift_inr,hh]
    exact hk
  have hZ : F z=z := hN ⟨z,hzN⟩
  have hFF : F.comp F=MonoidHom.id G := by
    let D := (F.comp F).eqLocus (MonoidHom.id G)
    have hND : N≤D := by
      intro n hn
      change F (F n)=n
      rw [hN ⟨n,hn⟩,hN ⟨n,hn⟩]
    have hvD : v∈D := by
      change F (F v)=v
      rw [hV,map_mul,hV,hZ,mul_assoc,←pow_two,hz2,mul_one]
    have hall : ⊤≤D := hcomp.sup_eq_top ▸ sup_le hND (zpowers_le.mpr hvD)
    exact MonoidHom.ext fun x => hall (mem_top x)
  let α := F.toMulEquiv F hFF hFF
  refine ⟨α,hN,hV,?_,?_⟩
  · intro x
    exact DFunLike.congr_fun hFF x
  · intro x hx
    have hx' : x∈N⊔zpowers v := hcomp.sup_eq_top ▸ mem_top x
    obtain ⟨n,hn,a,ha,hna⟩ := mem_sup_of_normal_left.mp hx'
    rcases involution_power_cases v hv ⟨a,ha⟩ with he | he
    · have ha1 : a=1 := congrArg Subtype.val he
      exact (hx (by simpa only [←hna,ha1,mul_one] using hn)).elim
    · have hav : a=v := congrArg Subtype.val he
      change F x=x*z
      rw [←hna,hav,map_mul,hN ⟨n,hn⟩,hV,mul_assoc]
end Subgroup
