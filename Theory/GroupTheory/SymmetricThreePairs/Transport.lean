module

public import Mathlib.GroupTheory.PGroup

/-!
# Transporting the exact S₃ conjugate-pair condition

An injective homomorphism identifies the subgroup generated by two conjugates
with the corresponding subgroup of its image. This transports both the
non-two-group test and the actual S₃ isomorphism. An order-two subgroup in
an embedded model is also realized by an actual matrix-model generator.

Source application: Aschbacher–Smith, combined manuscript of 1 March 2004,
condition (iv) in 13.5.21, printed pp.923–924 (PDF pp.940–941).
-/

public section
open Subgroup
namespace Theory.GroupTheory.SymmetricThreePairs

/-- Restrict the exact two-conjugate condition through an injective model embedding. -/
theorem pairs_of_embedding {A B : Type*} [Group A] [Group B]
    (f : B →* A) (hf : Function.Injective f) (U : Subgroup A) (V : Subgroup B)
    (hV : V.map f = U)
    (hpair : ∀ x : A, ¬ IsPGroup 2 (U ⊔ U.map (MulAut.conj x).toMonoidHom : Subgroup A) →
      Nonempty ((U ⊔ U.map (MulAut.conj x).toMonoidHom : Subgroup A) ≃* Equiv.Perm (Fin 3))) :
    ∀ x : B, ¬ IsPGroup 2 (V ⊔ V.map (MulAut.conj x).toMonoidHom : Subgroup B) →
      Nonempty ((V ⊔ V.map (MulAut.conj x).toMonoidHom : Subgroup B) ≃* Equiv.Perm (Fin 3)) := by
  intro x hx
  let P := V ⊔ V.map (MulAut.conj x).toMonoidHom
  have hm : P.map f = U ⊔ U.map (MulAut.conj (f x)).toMonoidHom := by
    change (V ⊔ V.map (MulAut.conj x).toMonoidHom).map f = _
    rw [Subgroup.map_sup, hV, ← hV, map_map, map_map]
    congr 2
    ext y
    simp
  let e := (P.equivMapOfInjective f hf).trans (MulEquiv.subgroupCongr hm)
  obtain ⟨i⟩ := hpair (f x) (fun hp => hx (hp.of_injective e.toMonoidHom e.injective))
  exact ⟨e.trans i⟩

/-- An order-two subgroup contained in an embedded model has an actual generating model involution. -/
theorem exists_marked_involution {A B : Type*} [Group A] [Finite A] [Group B]
    (N U : Subgroup A) (e : N ≃* B) (hUN : U ≤ N) (hcard : Nat.card U = 2) :
    ∃ t : B, orderOf t = 2 ∧
      (zpowers t).map (N.subtype.comp e.symm.toMonoidHom) = U := by
  obtain ⟨v, hv⟩ := exists_prime_orderOf_dvd_card' (G := U) 2 (by rw [hcard])
  let vN : N := ⟨v, hUN v.property⟩
  have ho : orderOf vN = 2 := (Subgroup.orderOf_coe vN).symm.trans
    ((Subgroup.orderOf_coe v).trans hv)
  have hn : v ≠ 1 := by
    intro he
    rw [he, orderOf_one] at hv
    omega
  have hz : (zpowers (v : A)) = U := by
    have he := congrArg (fun P : Subgroup U => P.map U.subtype)
      (zpowers_eq_top_of_prime_card hcard hn)
    rw [MonoidHom.map_zpowers, ← MonoidHom.range_eq_map, range_subtype] at he
    exact he
  refine ⟨e vN, (e.orderOf_eq vN).trans ho, ?_⟩
  rw [MonoidHom.map_zpowers]
  change zpowers (N.subtype (e.symm (e vN))) = U
  rw [e.symm_apply_apply]
  exact hz

end Theory.GroupTheory.SymmetricThreePairs
