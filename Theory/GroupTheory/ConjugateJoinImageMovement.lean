module
public import Mathlib.GroupTheory.Index
public import Mathlib.Algebra.Group.Subgroup.Pointwise
/-!
# Movement in the image of two conjugate subgroups

If a subgroup is generated by U, one conjugate of U, and a killed central
factor, its image cannot have order four while the image of U has order two
unless the conjugating element fails to commute with an image of U. The
restricted version retains the common subgroup containing both elements.
This is the movement step in Aschbacher--Smith 2.4.29, printed p.545.
-/
public section
open Subgroup
namespace Subgroup
variable {G H : Type*} [Group G] [Group H]

theorem exists_noncommuting_image_of_conjugate_join
    (f : G →* H) (U D J : Subgroup G) (x : G)
    (hJ : J = (U ⊔ U.map (MulAut.conj x⁻¹).toMonoidHom) ⊔ D)
    (hD : D ≤ f.ker) (hU : Nat.card (U.map f)=2) (hfour : Nat.card (J.map f)=4) :
    ∃ u : U, f x * f u ≠ f u * f x := by
  by_contra! h
  have hconj : (U.map (MulAut.conj x⁻¹).toMonoidHom).map f=U.map f := by
    rw [map_map]
    have he : (f.comp (MulAut.conj x⁻¹).toMonoidHom).comp U.subtype = f.comp U.subtype := by
      ext u
      change f (x⁻¹*(u:G)*x⁻¹⁻¹)=f u
      rw [inv_inv,map_mul,map_mul,map_inv]
      calc
        (f x)⁻¹ * f u * f x = (f x)⁻¹ * (f u * f x) := mul_assoc _ _ _
        _ = (f x)⁻¹ * (f x * f u) := by rw [h u]
        _ = f u := inv_mul_cancel_left _ _
    have hr := congrArg MonoidHom.range he
    simpa only [MonoidHom.range_comp,range_subtype] using hr
  have hmap : J.map f=U.map f := by
    rw [hJ,map_sup,map_sup,hconj,sup_idem,(map_eq_bot_iff D).mpr hD,sup_bot_eq]
  rw [hmap,hU] at hfour
  omega

theorem exists_noncommuting_restricted_image_of_conjugate_join
    (T U D J : Subgroup G) (f : T →* H) (x : T)
    (hUT : U ≤ T) (hDT : D ≤ T)
    (hJ : J = (U ⊔ U.map (MulAut.conj (x:G)⁻¹).toMonoidHom) ⊔ D)
    (hD : D.subgroupOf T ≤ f.ker)
    (hU : Nat.card ((U.subgroupOf T).map f)=2)
    (hfour : Nat.card ((J.subgroupOf T).map f)=4) :
    ∃ u : U.subgroupOf T, f x * f u ≠ f u * f x := by
  have hconj : (U.map (MulAut.conj (x:G)⁻¹).toMonoidHom).subgroupOf T =
      (U.subgroupOf T).map (MulAut.conj x⁻¹).toMonoidHom := by
    apply map_injective (f:=T.subtype) T.subtype_injective
    have hVT : U.map (MulAut.conj (x:G)⁻¹).toMonoidHom ≤ T := by
      rintro y ⟨u,hu,rfl⟩
      exact T.mul_mem (T.mul_mem (T.inv_mem x.property) (hUT hu)) (T.inv_mem (T.inv_mem x.property))
    rw [map_subgroupOf_eq_of_le hVT,map_map]
    have he : T.subtype.comp (MulAut.conj x⁻¹).toMonoidHom =
        (MulAut.conj (x:G)⁻¹).toMonoidHom.comp T.subtype := by
      ext u
      rfl
    rw [he,←map_map,map_subgroupOf_eq_of_le hUT]
  have hVT : U.map (MulAut.conj (x:G)⁻¹).toMonoidHom ≤ T := by
    rintro y ⟨u,hu,rfl⟩
    exact T.mul_mem (T.mul_mem (T.inv_mem x.property) (hUT hu)) (T.inv_mem (T.inv_mem x.property))
  have hj : J.subgroupOf T =
      ((U.subgroupOf T) ⊔ (U.subgroupOf T).map (MulAut.conj x⁻¹).toMonoidHom) ⊔ D.subgroupOf T := by
    rw [hJ,subgroupOf_sup (sup_le hUT hVT) hDT,subgroupOf_sup hUT hVT,hconj]
  exact exists_noncommuting_image_of_conjugate_join f _ _ _ x hj hD hU hfour
end Subgroup
