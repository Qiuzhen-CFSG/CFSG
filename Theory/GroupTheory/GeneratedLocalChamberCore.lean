module

public import Theory.GroupTheory.PCoreLocalSetup
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# A generated local family has trivial chamber core

Let E be generated by three local subgroups M,H,K with H not contained in M.
Suppose M is the unique allowed overgroup of the normalizer of any nontrivial
two-subgroup of their common chamber. A nontrivial normal chamber core in E
would be normalized by both M and H, contradicting that uniqueness.

This is the D4 verification in Aschbacher–Smith 13.4.9, printed p.906. The
unique two-local overgroup condition is retained literally; M is not assumed
maximal among all proper subgroups of the ambient group.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

theorem chamber_core_free_of_unique_twoLocal
    (M H K T : Subgroup G) (hT : IsPGroup 2 T)
    (hH : ¬ H ≤ M)
    (hunique : ∀ N : Subgroup G, IsPGroup 2 N → N ≠ ⊥ → N ≤ T →
      M ≤ normalizer (N : Set G) → normalizer (N : Set G) ≤ M) :
    (T.subgroupOf (M ⊔ H ⊔ K)).normalCore = ⊥ := by
  let E := M ⊔ H ⊔ K
  let N := (T.subgroupOf E).normalCore
  let A : Subgroup G := N.map E.subtype
  have hAT : A ≤ T := by
    intro x hx
    obtain ⟨a, ha, rfl⟩ := hx
    exact (T.subgroupOf E).normalCore_le ha
  have hn : E ≤ normalizer (A : Set G) := by
    have h := N.le_normalizer_map E.subtype
    simpa only [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype] using h
  have hb : A = ⊥ := by
    by_contra hA
    have he := (hn.trans (hunique A (hT.to_le hAT) hA hAT
      ((le_sup_of_le_left le_sup_left).trans hn)))
    exact hH ((le_sup_of_le_left le_sup_right).trans he)
  exact (N.map_eq_bot_iff_of_injective E.subtype_injective).mp hb

end Subgroup
