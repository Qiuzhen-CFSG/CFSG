module

public import Mathlib.GroupTheory.Sylow

/-!
# Inverters of elements in a Sylow two-subgroup

If a Sylow two-subgroup contains all centralizers of its nonidentity elements,
it also contains their inverters. An inverter centralizes the unique involution
in the cyclic subgroup generated by the inverted element.

This is condition (1'') in Suzuki, *Finite groups with nilpotent centralizers*
(1961), Part I, Theorem 2 and its corollary, pp. 429 and 433. In particular,
a product of two involutions outside the Sylow subgroup cannot be a nonidentity
element of that subgroup, the starting point of the involution/coset count.
-/

namespace Sylow

/-- Centralizer containment also contains every inverter of a nonidentity Sylow element. -/
public theorem mem_of_inverts_of_centralizer_le
    {G : Type*} [Group G] [Finite G] (P : Sylow 2 G)
    (hcent : ∀ x ∈ (P : Subgroup G), x ≠ 1 →
      Subgroup.centralizer ({x} : Set G) ≤ (P : Subgroup G))
    {x g : G} (hx : x ∈ (P : Subgroup G)) (hne : x ≠ 1)
    (hinv : g * x * g⁻¹ = x⁻¹) : g ∈ (P : Subgroup G) := by
  have hdiv : 2 ∣ orderOf x := by
    have hd := P.isPGroup'.dvd_orderOf (show (⟨x, hx⟩ : P) ≠ 1 from
      fun h => hne (congrArg Subtype.val h))
    change 2 ∣ orderOf (⟨x, hx⟩ : (P : Subgroup G)) at hd
    rwa [← Subgroup.orderOf_coe] at hd
  let u := x ^ (orderOf x / 2)
  have hu : orderOf u = 2 := orderOf_pow_orderOf_div (orderOf_pos x).ne' hdiv
  have hune : u ≠ 1 := by intro he; simp [he] at hu
  have hui : u⁻¹ = u := inv_eq_of_mul_eq_one_left (by
    simpa only [hu, pow_two] using pow_orderOf_eq_one u)
  have hgu : (MulAut.conj g) u = u⁻¹ := by
    change (MulAut.conj g) (x ^ (orderOf x / 2)) = (x ^ (orderOf x / 2))⁻¹
    rw [map_pow]
    change (g * x * g⁻¹) ^ (orderOf x / 2) = _
    rw [hinv, inv_pow]
  apply hcent u ((P : Subgroup G).pow_mem hx _) hune
  exact Subgroup.mem_centralizer_singleton_iff.mpr
    (mul_inv_eq_iff_eq_mul.mp (hgu.trans hui))

/-- A coset outside the Sylow subgroup contains at most one involution. -/
public theorem eq_of_involutions_mul_inv_mem_of_centralizer_le
    {G : Type*} [Group G] [Finite G] (P : Sylow 2 G)
    (hcent : ∀ x ∈ (P : Subgroup G), x ≠ 1 →
      Subgroup.centralizer ({x} : Set G) ≤ (P : Subgroup G))
    {a b : G} (ha : a ∉ (P : Subgroup G)) (ha2 : a ^ 2 = 1) (hb2 : b ^ 2 = 1)
    (hab : a * b⁻¹ ∈ (P : Subgroup G)) : a = b := by
  by_contra hne
  have haa : a * a = 1 := by simpa only [pow_two] using ha2
  have hbi : b⁻¹ = b := inv_eq_of_mul_eq_one_left (by
    simpa only [pow_two] using hb2)
  apply ha (P.mem_of_inverts_of_centralizer_le hcent hab
    (fun he => hne (mul_inv_eq_one.mp he)) ?_)
  simp only [← mul_assoc, haa, one_mul, mul_inv_rev, hbi]

end Sylow
