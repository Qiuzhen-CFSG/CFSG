module
public import Theory.GroupTheory.SolvableResidual.Transport
public import Theory.GroupTheory.PResidual.PrimeToTransport

/-!
# Prime-to-p residuals of solvable residuals

The composite residual O^{p′}(H∞) is functorial in the actual embedded
subgroup H. Surjective transport follows by restricting the original map
to each residual in turn. A perfect subgroup generated by its p-elements
is fixed by this operation.

This is the canonical operation θ used in Aschbacher--Smith 10.2.10,
printed p.753; it is distinct from O^{p′}(H).
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G H : Type*} [Group G] [Group H] [Finite G]

/-- Homomorphisms preserve the embedded solvable residual of a finite subgroup. -/
theorem map_embedded_solvableResidual_of_hom (U : Subgroup G) (f : G →* H) :
    ((solvableResidual U).map U.subtype).map f =
      (solvableResidual (U.map f)).map (U.map f).subtype := by
  have he : f.comp U.subtype = (U.map f).subtype.comp (f.subgroupMap U) := rfl
  rw [map_map,he,←map_map,map_solvableResidual_eq _ (f.subgroupMap_surjective U)]

/-- The embedded prime-to-p residual of the solvable residual. -/
@[expose] def perfectPrimeResidual (p : ℕ) (U : Subgroup G) : Subgroup G :=
  (primeToResidual p ((solvableResidual U).map U.subtype)).map
    ((solvableResidual U).map U.subtype).subtype

variable (p : ℕ) [Fact p.Prime]

/-- Both intrinsic residual maps are retained by the composite operation. -/
theorem perfectPrimeResidual_eq (U : Subgroup G) :
    perfectPrimeResidual p U = ((primeToResidual p (solvableResidual U)).map
      (solvableResidual U).subtype).map U.subtype :=
  (map_embedded_primeToResidual_of_hom p _ _).symm

omit [Finite G] [Fact p.Prime] in
/-- The composite residual is monotone for literal subgroup inclusions. -/
theorem perfectPrimeResidual_mono {U V : Subgroup G} (h : U ≤ V) :
    perfectPrimeResidual p U ≤ perfectPrimeResidual p V :=
  embedded_primeToResidual_mono p (map_solvableResidual_mono h)

/-- The composite residual commutes with the original homomorphism. -/
theorem map_perfectPrimeResidual (U : Subgroup G) (f : G →* H) :
    (perfectPrimeResidual p U).map f = perfectPrimeResidual p (U.map f) := by
  unfold perfectPrimeResidual
  rw [map_embedded_primeToResidual_of_hom,map_embedded_solvableResidual_of_hom]

omit [Finite G] [Fact p.Prime] in
/-- A perfect p-generated subgroup is fixed by the composite residual. -/
theorem perfectPrimeResidual_eq_self (U : Subgroup G) [Group.IsPerfect U]
    (h : primeToResidual p U = ⊤) : perfectPrimeResidual p U = U := by
  unfold perfectPrimeResidual
  rw [solvableResidual_eq_top,←MonoidHom.range_eq_map,range_subtype,h,
    ←MonoidHom.range_eq_map,range_subtype]

end Theory.GroupTheory
