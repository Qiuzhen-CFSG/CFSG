module

public import Theory.GroupTheory.FrattiniNormalizerWitness
public import Theory.Frattini.BinarySquares
public import Theory.GroupTheory.SubgroupEnumeration

/-!
# Word certificates for Frattini normalizer witnesses

For a finite subgroup generated by a specified set, displacements of the
specified generators into its Frattini subgroup imply normalization and
trivial action on the Frattini quotient. In a two-group, explicit products
of squares of generator words certify these displacements. Nonmembership
of the proposed normalizer element is the only separate obligation.

Source: the generator extension property of group homomorphisms and the
binary Frattini theorem in `Theory.Frattini.BinarySquares`. The word evaluator
uses the convention `x⁻¹ * (g * x * g⁻¹)` for the displacement.
-/

open Theory.GroupTheory Theory.GroupTheory.SubgroupEnumeration

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- Generator displacements into the Frattini subgroup suffice: finite cardinality
upgrades conjugation containment to normalization, and equality on generators
extends to the quotient homomorphisms. -/
public theorem hasFrattiniNormalizerWitness_of_set_generator_displacements (s : Set G) (g : G)
    (hout : g ∉ closure s)
    (hdisp : ∀ x ∈ s, x⁻¹ * (g * x * g⁻¹) ∈
      (frattini (closure s)).map (closure s).subtype) :
    (closure s).HasFrattiniNormalizerWitness := by
  let U := closure s
  have hconj : U.map (MulAut.conj g).toMonoidHom ≤ U := by
    rw [MonoidHom.map_closure]
    apply (closure_le _).mpr
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨d, _, hd⟩ := hdisp x hx
    have hdU : x⁻¹ * (g * x * g⁻¹) ∈ U := hd ▸ d.property
    have hm := U.mul_mem (subset_closure hx) hdU
    change g * x * g⁻¹ ∈ U
    simpa only [mul_inv_cancel_left] using hm
  have hn : g ∈ normalizer (U : Set G) := by
    apply mem_normalizer_iff_map_conj_eq.mpr
    apply eq_of_le_of_card_ge hconj
    exact le_of_eq (Nat.card_congr
      (U.equivMapOfInjective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective).toEquiv)
  let a := U.normalizerMonoidHom ⟨g, hn⟩
  let q := QuotientGroup.mk' (frattini U)
  have heq : q.comp a.toMonoidHom = q := by
    apply MonoidHom.eq_of_eqOn_dense (closure_preimage_eq_top s)
    intro x hx
    symm
    apply QuotientGroup.eq.mpr
    obtain ⟨d, hd, he⟩ := hdisp x hx
    have he' : d = x⁻¹ * a x := by
      apply Subtype.ext
      exact he
    exact he' ▸ hd
  refine ⟨⟨g, hn⟩, hout, ?_⟩
  apply quotientAut_eq_one_of_displacements
  intro x
  exact QuotientGroup.eq.mp (DFunLike.congr_fun heq x).symm
/-- Evaluate a product of squares of positive generator words. -/
@[expose] public def evalSquareWord {n : ℕ} (gen : Fin n → G) (w : List (List (Fin n))) : G :=
  (w.map (fun v => evalWord gen v ^ 2)).prod

/-- Products of squares of subgroup words lie in its ambient Frattini image. -/
public theorem evalSquareWord_mem {n : ℕ} (U : Subgroup G) (hU : IsPGroup 2 U)
    (gen : Fin n → G) (hgen : ∀ i, gen i ∈ U) (w : List (List (Fin n))) :
    evalSquareWord gen w ∈ (frattini U).map U.subtype := by
  let : Fact (IsPGroup 2 U) := ⟨hU⟩
  apply list_prod_mem
  intro x hx
  obtain ⟨v, _, rfl⟩ := List.mem_map.mp hx
  let y : U := ⟨evalWord gen v, evalWord_mem gen U hgen v⟩
  exact ⟨y ^ 2, pth_power_mem_frattini_of_isPGroup y, rfl⟩

/-- A finite list of checked square-word identities certifies the Frattini
normalizer witness, once outside membership has been established. -/
public theorem hasFrattiniNormalizerWitness_of_squareWords {n : ℕ}
    (U : Subgroup G) (hU : IsPGroup 2 U) (gen : Fin n → G)
    (hgen : U = closure (Set.range gen)) (g : G) (hout : g ∉ U)
    (words : Fin n → List (List (Fin n)))
    (hwords : ∀ i, evalSquareWord gen (words i) = (gen i)⁻¹ * (g * gen i * g⁻¹)) :
    U.HasFrattiniNormalizerWitness := by
  subst U
  apply hasFrattiniNormalizerWitness_of_set_generator_displacements _ g hout
  rintro _ ⟨i, rfl⟩
  rw [← hwords i]
  exact evalSquareWord_mem _ hU gen
    (fun j => subset_closure (Set.mem_range_self j)) _

end Subgroup
