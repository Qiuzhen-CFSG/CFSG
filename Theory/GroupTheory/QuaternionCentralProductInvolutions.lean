module

public import Theory.GroupTheory.QuaternionCentralProductCenter
public import Theory.GroupTheory.C4SquareQuaternionIndexTwo
public import Theory.GroupTheory.SpecificGroups.QuaternionEightInvolution

/-!
# Involutions and squares in Q₈ ◦ Q₈

A central product of two quaternion groups of order eight is generated by
its square-one elements, and every square belongs to the shared subgroup of
order two. In particular it cannot contain a C₄ × C₄ subgroup.

For generation, pair a noncentral element r of the first factor with the
three quaternion generators i, j, ij of the second factor. The products ri,
rj, r(ij) square to one. Their products recover r, i and j. Doing this for
both generators of the first factor gives the whole central product.

These elementary facts supply the outside involution in the order-64 branch
of Stellmacher (8.6)(a), `refs/latex/stellmacher-n-group.tex`.
-/

namespace Subgroup

private abbrev Q8 := QuaternionGroup 2

private theorem quaternion_factor_generated {G : Type*} [Group G]
    (B H : Subgroup G) (e : B ≃* Q8)
    (ha : ((e.symm (QuaternionGroup.a 1) : B) : G) ∈ H)
    (hb : ((e.symm (QuaternionGroup.xa 0) : B) : G) ∈ H) : B ≤ H := by
  let f : Q8 →* G := B.subtype.comp e.symm.toMonoidHom
  intro x hx
  have heq : f (e ⟨x, hx⟩) = x := by simp [f]
  rw [← heq]
  cases e ⟨x, hx⟩ with
  | a n =>
    have hn : (QuaternionGroup.a n : Q8) = QuaternionGroup.a 1 ^ n.val := by simp
    rw [hn, map_pow]
    exact H.pow_mem ha _
  | xa n =>
    have hn : (QuaternionGroup.xa n : Q8) =
        QuaternionGroup.xa 0 * QuaternionGroup.a 1 ^ n.val := by simp
    rw [hn, map_mul, map_pow]
    exact H.mul_mem hb (H.pow_mem ha _)

private theorem quaternion_shared_square {G : Type*} [Group G] [Finite G]
    (B C : Subgroup G) (eB : B ≃* Q8) (eC : C ≃* Q8)
    (hinter : Nat.card (B ⊓ C : Subgroup G) = 2) :
    ((eB.symm (QuaternionGroup.a 2) : B) : G) =
      ((eC.symm (QuaternionGroup.a 2) : C) : G) := by
  obtain ⟨z, hz, _⟩ := (Nat.card_eq_two_iff' (1 : (B ⊓ C : Subgroup G))).mp hinter
  have hz2 : z ^ 2 = 1 := by simpa only [hinter] using pow_card_eq_one' (x := z)
  let zB : B := ⟨z, z.property.1⟩
  let zC : C := ⟨z, z.property.2⟩
  have hzB2 : zB ^ 2 = 1 := Subtype.ext (congrArg (fun w : (B ⊓ C : Subgroup G) => (w : G)) hz2)
  have hzC2 : zC ^ 2 = 1 := Subtype.ext (congrArg (fun w : (B ⊓ C : Subgroup G) => (w : G)) hz2)
  have hzB1 : zB ≠ 1 := fun h => hz (Subtype.ext (congrArg (fun w : B => (w : G)) h))
  have hzC1 : zC ≠ 1 := fun h => hz (Subtype.ext (congrArg (fun w : C => (w : G)) h))
  have heB : eB zB = QuaternionGroup.a 2 := QuaternionGroup.eq_a_two_of_orderOf_eq_two _
    (by rw [eB.orderOf_eq]; exact orderOf_eq_prime hzB2 hzB1)
  have heC : eC zC = QuaternionGroup.a 2 := QuaternionGroup.eq_a_two_of_orderOf_eq_two _
    (by rw [eC.orderOf_eq]; exact orderOf_eq_prime hzC2 hzC1)
  have hb := congrArg (fun x => ((eB.symm x : B) : G)) heB
  have hc := congrArg (fun x => ((eC.symm x : C) : G)) heC
  simp only [eB.symm_apply_apply] at hb
  simp only [eC.symm_apply_apply] at hc
  exact hb.symm.trans hc

private theorem quaternion_mixed_involutions {G : Type*} [Group G]
    (C W : Subgroup G) (eC : C ≃* Q8) (hCW : C ≤ W)
    (r : G) (hrW : r ∈ W)
    (hr2 : r ^ 2 = ((eC.symm (QuaternionGroup.a 2) : C) : G))
    (hcomm : ∀ c ∈ C, r * c = c * r) :
    r ∈ closure {x : G | x ∈ W ∧ x ^ 2 = 1} ∧
      C ≤ closure {x : G | x ∈ W ∧ x ^ 2 = 1} := by
  let g : Q8 →* G := C.subtype.comp eC.symm.toMonoidHom
  let i := g (QuaternionGroup.a 1)
  let j := g (QuaternionGroup.xa 0)
  let z := g (QuaternionGroup.a 2)
  let T := closure {x : G | x ∈ W ∧ x ^ 2 = 1}
  have hiC : i ∈ C := (eC.symm (QuaternionGroup.a 1)).property
  have hjC : j ∈ C := (eC.symm (QuaternionGroup.xa 0)).property
  have hz2 : z ^ 2 = 1 := by
    change g (QuaternionGroup.a 2) ^ 2 = 1
    rw [← map_pow, show (QuaternionGroup.a 2 : Q8) ^ 2 = 1 by decide, map_one]
  have hi2 : i ^ 2 = z := by
    change g (QuaternionGroup.a 1) ^ 2 = g (QuaternionGroup.a 2)
    rw [← map_pow]
    rfl
  have hj2 : j ^ 2 = z := by
    change g (QuaternionGroup.xa 0) ^ 2 = g (QuaternionGroup.a 2)
    rw [← map_pow, show (QuaternionGroup.xa 0 : Q8) ^ 2 = QuaternionGroup.a 2 by decide]
  have hij2 : (i * j) ^ 2 = z := by
    change (g (QuaternionGroup.a 1) * g (QuaternionGroup.xa 0)) ^ 2 = g (QuaternionGroup.a 2)
    rw [← map_mul, ← map_pow]
    exact congrArg g (by decide)
  have hmixed (q : G) (hq : q ∈ C) (hq2 : q ^ 2 = z) : r * q ∈ T := by
    apply subset_closure
    refine ⟨W.mul_mem hrW (hCW hq), ?_⟩
    rw [(show Commute r q from hcomm q hq).mul_pow, hr2, hq2]
    change z * z = 1
    simpa only [pow_two] using hz2
  have hri : r * i ∈ T := hmixed i hiC hi2
  have hrj : r * j ∈ T := hmixed j hjC hj2
  have hrk : r * (i * j) ∈ T := hmixed (i * j) (C.mul_mem hiC hjC) hij2
  have hprod : (r * i) * (r * j) = r * (r * (i * j)) := by
    calc
      _ = r * (i * r) * j := by group
      _ = r * (r * i) * j := by rw [hcomm i hiC]
      _ = _ := by group
  have hrT : r ∈ T := by
    have hh := T.mul_mem (T.mul_mem hri hrj) (T.inv_mem hrk)
    rw [hprod] at hh
    simpa only [mul_inv_cancel_right] using hh
  refine ⟨hrT, quaternion_factor_generated C T eC ?_ ?_⟩
  · exact (T.mul_mem_cancel_left hrT).mp hri
  · exact (T.mul_mem_cancel_left hrT).mp hrj

/-- A central product Q₈ ◦ Q₈ is generated by its square-one elements. -/
public theorem quaternion_central_product_involutions_generate
    {G : Type*} [Group G] [Finite G] (B C : Subgroup G)
    (hB : Nonempty (B ≃* QuaternionGroup 2)) (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hinter : Nat.card (B ⊓ C : Subgroup G) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b * c = c * b) :
    closure {x : G | x ∈ B ⊔ C ∧ x ^ 2 = 1} = B ⊔ C := by
  obtain ⟨eB⟩ := hB
  obtain ⟨eC⟩ := hC
  have hshared := quaternion_shared_square B C eB eC hinter
  let f : Q8 →* G := B.subtype.comp eB.symm.toMonoidHom
  have hfirst := quaternion_mixed_involutions C (B ⊔ C) eC le_sup_right
    (f (QuaternionGroup.a 1)) (mem_sup_left (eB.symm (QuaternionGroup.a 1)).property)
    (by rw [← map_pow]; exact hshared)
    (fun c hc => hcomm _ (eB.symm (QuaternionGroup.a 1)).property c hc)
  have hsecond := quaternion_mixed_involutions C (B ⊔ C) eC le_sup_right
    (f (QuaternionGroup.xa 0)) (mem_sup_left (eB.symm (QuaternionGroup.xa 0)).property)
    (by rw [← map_pow, show (QuaternionGroup.xa 0 : Q8) ^ 2 = QuaternionGroup.a 2 by decide]
        exact hshared)
    (fun c hc => hcomm _ (eB.symm (QuaternionGroup.xa 0)).property c hc)
  exact le_antisymm ((closure_le _).mpr (fun _ hx => hx.1))
    (sup_le (quaternion_factor_generated B _ eB hfirst.1 hsecond.1) hfirst.2)

/-- Every square of Q₈ ◦ Q₈ belongs to the shared subgroup of order two. -/
public theorem quaternion_central_product_square_mem_inf
    {G : Type*} [Group G] [Finite G] (B C : Subgroup G)
    (hB : Nonempty (B ≃* QuaternionGroup 2)) (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hinter : Nat.card (B ⊓ C : Subgroup G) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b * c = c * b)
    (x : G) (hx : x ∈ B ⊔ C) : x ^ 2 ∈ B ⊓ C := by
  have hsquare (D : Subgroup G) (hD : Nonempty (D ≃* QuaternionGroup 2))
      (d : G) (hd : d ∈ D) : d ^ 2 ∈ (center D).map D.subtype := by
    obtain ⟨e⟩ := hD
    have hs : ∀ a b : Q8, b * a ^ 2 = a ^ 2 * b := by decide
    refine ⟨(⟨d, hd⟩ : D) ^ 2, mem_center_iff.mpr ?_, rfl⟩
    intro y
    apply e.injective
    simpa only [map_mul, map_pow] using hs (e ⟨d, hd⟩) (e y)
  have hnorm : B ≤ normalizer (C : Set G) := by
    apply le_trans ?_ (centralizer_le_normalizer _)
    intro b hb c hc
    exact (hcomm b hb c hc).symm
  change x ∈ (↑(B ⊔ C) : Set G) at hx
  rw [coe_mul_of_left_le_normalizer_right B C hnorm] at hx
  obtain ⟨b, hb, c, hc, rfl⟩ := hx
  rw [(show Commute b c from hcomm b hb c hc).mul_pow]
  apply (B ⊓ C).mul_mem
  · rw [intersection_eq_factor_center B C hB hinter hcomm]
    exact hsquare B hB b hb
  · rw [inf_comm, intersection_eq_factor_center C B hC (by simpa [inf_comm] using hinter)
      (fun c hc b hb => (hcomm b hb c hc).symm)]
    exact hsquare C hC c hc

/-- A quaternion central product cannot contain a C₄ × C₄ subgroup. -/
public theorem c4_square_not_le_quaternion_central_product
    {G : Type*} [Group G] [Finite G] (A B C : Subgroup G)
    (hA : Nonempty (A ≃* Multiplicative (ZMod 4) × Multiplicative (ZMod 4)))
    (hB : Nonempty (B ≃* QuaternionGroup 2)) (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hinter : Nat.card (B ⊓ C : Subgroup G) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b * c = c * b) : ¬ A ≤ B ⊔ C := by
  intro hle
  obtain ⟨x, hx, y, hy, _, _, hx2, hy2, hxy⟩ := exists_distinct_squares_of_c4_square A hA
  let xx : (B ⊓ C : Subgroup G) := ⟨x ^ 2, quaternion_central_product_square_mem_inf
    B C hB hC hinter hcomm x (hle hx)⟩
  let yy : (B ⊓ C : Subgroup G) := ⟨y ^ 2, quaternion_central_product_square_mem_inf
    B C hB hC hinter hcomm y (hle hy)⟩
  obtain ⟨z, _, hz⟩ := (Nat.card_eq_two_iff' (1 : (B ⊓ C : Subgroup G))).mp hinter
  have hxx : xx = z := hz xx (fun h => hx2 (congrArg Subtype.val h))
  have hyy : yy = z := hz yy (fun h => hy2 (congrArg Subtype.val h))
  exact hxy (congrArg Subtype.val (hxx.trans hyy.symm))

end Subgroup
