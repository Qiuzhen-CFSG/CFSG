module

public import Mathlib.Algebra.Group.Subgroup.Order

/-!
# Maximality from double cosets and recovery of a generator

Suppose that adjoining `a` to a proper subgroup `H` generates `G`. To prove
maximality, it suffices to cover the complement of `H` by double cosets `H r H`
and recover `a` in each subgroup generated by `H` and an outside representative
`r`. Indeed, an overgroup containing `h * r * k` also contains `r`.

This elementary argument separates a double-coset enumeration from its word
certificates. Neither disjointness nor minimality of the representative family
is needed. One application is the concrete ATLAS Lyons involution subgroup.
-/

namespace Subgroup

variable {G : Type*} [Group G]

/-- A double-coset cover and recovery of one additional generator prove
maximality. The representative family may contain repetitions or members of
`H`; recovery is required only for representatives outside `H`. -/
public theorem isCoatom_of_doubleCoset_generator_recovery
    (H : Subgroup G) (a : G) (hproper : H ≠ ⊤)
    (hgen : ∀ K : Subgroup G, H ≤ K → a ∈ K → K = ⊤)
    {ι : Type*} (r : ι → G)
    (hcover : ∀ g : G, g ∉ H → ∃ i, ∃ h ∈ H, ∃ k ∈ H, g = h * r i * k)
    (hrecover : ∀ i, r i ∉ H → a ∈ closure (insert (r i) (H : Set G))) :
    IsCoatom H := by
  apply SetLike.isCoatom_iff.mpr
  refine ⟨hproper, ?_⟩
  intro K g hHK hg hgK
  obtain ⟨i, h, hh, k, hk, heq⟩ := hcover g hg
  have hrK : r i ∈ K := by
    have hm := K.mul_mem (K.mul_mem (K.inv_mem (hHK hh)) hgK) (K.inv_mem (hHK hk))
    rw [heq] at hm
    simpa only [← mul_assoc, mul_inv_cancel_right, inv_mul_cancel, one_mul] using hm
  have hrH : r i ∉ H := by
    intro hr
    exact hg (heq ▸ H.mul_mem (H.mul_mem hh hr) hk)
  apply hgen K hHK
  apply ((closure_le K).mpr ?_) (hrecover i hrH)
  intro x hx
  rcases hx with rfl | hx
  · exact hrK
  · exact hHK hx

end Subgroup
