module

public import Theory.GroupTheory.PGroup.ExtraspecialInvolutionCosetAction
public import Mathlib.GroupTheory.SpecificGroups.Quaternion
public import Mathlib.GroupTheory.SpecificGroups.Dihedral
public import Mathlib.GroupTheory.NoncommCoprod

/-!
# Five involution cosets in a quaternion–dihedral central product

An extraspecial group of order 32 generated by commuting quaternion and
dihedral factors of order eight has exactly five nonidentity central cosets
admitting square-one representatives. Its automorphism action on these five
points has the same kernel as its action on the full central quotient.

Multiplication gives a surjection from Q₈ × D₈. The two central involutions
have the same nonidentity image in the order-two center, so the kernel is the
diagonal subgroup of order two. Exactly 24 elements of the direct product
have square in this kernel, giving 12 square-one elements in the central
product. Squaring is constant on central cosets; dividing by the order-two
center and removing the identity coset leaves five points.

For the kernel equality, square-one elements generate the whole group:
dihedral reflections generate the dihedral factor, while multiplying each
quaternion element of order four by a dihedral rotation of order four gives
a square-one element. Fixing the five points therefore fixes the quotient.
The kernel theorem does not need the order-32 or intersection hypotheses.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, printed p.389,
`refs/original/n-group-global/odd-core-rank-two-source/janko-thompson-1970-gdz.pdf`.
-/

open Subgroup

private theorem card_preimage {G K : Type*} [Group G] [Group K]
    (f : G →* K) (hf : Function.Surjective f) (s : Set K) :
    Nat.card {x : G // f x ∈ s} = Nat.card f.ker * Nat.card s := by
  classical
  let lift : K → G := fun x => (hf x).choose
  have hl (x : K) : f (lift x) = x := (hf x).choose_spec
  let e : {x : G // f x ∈ s} ≃ f.ker × s :=
    { toFun := fun x => (⟨x.val * (lift (f x.val))⁻¹, by simp [hl]⟩, ⟨f x.val, x.property⟩)
      invFun := fun x => ⟨x.1.val * lift x.2.val, by simp [hl, MonoidHom.mem_ker.mp x.1.property]⟩
      left_inv := by intro x; apply Subtype.ext; simp
      right_inv := by
        rintro ⟨x,y⟩
        apply Prod.ext
        · apply Subtype.ext
          simp [hl, MonoidHom.mem_ker.mp x.property]
        · apply Subtype.ext
          simp [hl, MonoidHom.mem_ker.mp x.property] }
  rw [Nat.card_congr e, Nat.card_prod]

namespace Subgroup
variable {H : Type*} [Group H] [IsExtraspecial 2 H]

private theorem shared_square
    (f : QuaternionGroup 2 →* H) (g : DihedralGroup 4 →* H)
    (hf : Function.Injective f) (hg : Function.Injective g) :
    f (QuaternionGroup.a 2) = g (DihedralGroup.r 2) := by
  have hq : f (QuaternionGroup.a 2) ∈ center H := by
    have h := (IsExtraspecial.quotient_elementary_abelian 2 H).sq_mem_center_of_central_quotient (f (QuaternionGroup.a 1))
    rwa [← map_pow, show (QuaternionGroup.a 1 : QuaternionGroup 2) ^ 2 =
      QuaternionGroup.a 2 by decide] at h
  have hd : g (DihedralGroup.r 2) ∈ center H := by
    have h := (IsExtraspecial.quotient_elementary_abelian 2 H).sq_mem_center_of_central_quotient (g (DihedralGroup.r 1))
    rwa [← map_pow, show (DihedralGroup.r 1 : DihedralGroup 4) ^ 2 =
      DihedralGroup.r 2 by decide] at h
  have hq1 : f (QuaternionGroup.a 2) ≠ 1 := by
    rw [← map_one f]
    exact fun h => (by decide : (QuaternionGroup.a 2 : QuaternionGroup 2) ≠ 1) (hf h)
  have hd1 : g (DihedralGroup.r 2) ≠ 1 := by
    rw [← map_one g]
    exact fun h => (by decide : (DihedralGroup.r 2 : DihedralGroup 4) ≠ 1) (hg h)
  obtain ⟨z, _, hz⟩ := (Nat.card_eq_two_iff' (1 : center H)).mp
    (IsExtraspecial.center_order_p 2 H)
  exact congrArg Subtype.val ((hz ⟨_, hq⟩ (fun h => hq1 (congrArg Subtype.val h))).trans
    (hz ⟨_, hd⟩ (fun h => hd1 (congrArg Subtype.val h))).symm)

private theorem product_map
    (B C : Subgroup H) (eB : B ≃* QuaternionGroup 2) (eC : C ≃* DihedralGroup 4)
    (hcomm : C ≤ centralizer (B : Set H)) (hjoin : B ⊔ C = ⊤) :
    ∃ f : QuaternionGroup 2 × DihedralGroup 4 →* H, Function.Surjective f ∧
      f (QuaternionGroup.a 2, DihedralGroup.r 2) = 1 := by
  let b := B.subtype.comp eB.symm.toMonoidHom
  let c := C.subtype.comp eC.symm.toMonoidHom
  have hc (x : QuaternionGroup 2) (y : DihedralGroup 4) : Commute (b x) (c y) :=
    hcomm (eC.symm y).property _ (eB.symm x).property
  let f := b.noncommCoprod c hc
  refine ⟨f, ?_, ?_⟩
  · apply MonoidHom.range_eq_top.mp
    rw [MonoidHom.noncommCoprod_range]
    have hb : b.range = B := by
      rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eB.symm.surjective,
        ← MonoidHom.range_eq_map, B.range_subtype]
    have hc : c.range = C := by
      rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eC.symm.surjective,
        ← MonoidHom.range_eq_map, C.range_subtype]
    rwa [hb, hc]
  · change b (QuaternionGroup.a 2) * c (DihedralGroup.r 2) = 1
    rw [shared_square b c (B.subtype_injective.comp eB.symm.injective)
      (C.subtype_injective.comp eC.symm.injective), ← map_mul]
    exact (congrArg c (by decide : (DihedralGroup.r 2 : DihedralGroup 4) *
      DihedralGroup.r 2 = 1)).trans (map_one c)

private theorem card_square_one (hcard : Nat.card H = 32)
    (B C : Subgroup H) (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* DihedralGroup 4))
    (hcomm : C ≤ centralizer (B : Set H)) (hjoin : B ⊔ C = ⊤) :
    Nat.card {x : H // x ^ 2 = 1} = 12 := by
  obtain ⟨eB⟩ := hB
  obtain ⟨eC⟩ := hC
  obtain ⟨f, hf, hz⟩ := product_map B C eB eC hcomm hjoin
  have hk : Nat.card f.ker = 2 := by
    have h := card_eq_card_quotient_mul_card_subgroup f.ker
    rw [Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv,
      hcard] at h
    have hp : Nat.card (QuaternionGroup 2 × DihedralGroup 4) = 64 := by
      rw [Nat.card_eq_fintype_card]; decide
    rw [hp] at h
    omega
  have hker (p : QuaternionGroup 2 × DihedralGroup 4) :
      f p = 1 ↔ p = 1 ∨ p = (QuaternionGroup.a 2, DihedralGroup.r 2) := by
    constructor
    · intro hp
      by_cases hp1 : p = 1
      · exact Or.inl hp1
      · right
        obtain ⟨z, _, hu⟩ := (Nat.card_eq_two_iff' (1 : f.ker)).mp hk
        exact congrArg Subtype.val ((hu ⟨p, hp⟩ (fun h => hp1 (congrArg Subtype.val h))).trans
          (hu ⟨_, hz⟩ (by intro h; have hh := congrArg Subtype.val h; exact
            (by decide : (QuaternionGroup.a 2, DihedralGroup.r 2) ≠
              (1 : QuaternionGroup 2 × DihedralGroup 4)) hh)).symm)
    · rintro (rfl | rfl)
      · exact map_one f
      · exact hz
  have hc := card_preimage f hf {x : H | x ^ 2 = 1}
  rw [hk] at hc
  have he : Nat.card {p : QuaternionGroup 2 × DihedralGroup 4 // f p ∈ {x : H | x ^ 2 = 1}} = 24 := by
    rw [Nat.card_congr (Equiv.subtypeEquivRight (fun p => by
      change f p ^ 2 = 1 ↔ _
      rw [← map_pow, hker])), Nat.card_eq_fintype_card]
    decide
  rw [he] at hc
  change 24 = 2 * Nat.card {x : H // x ^ 2 = 1} at hc
  omega

private theorem square_eq_of_coset_eq {x y : H}
    (h : QuotientGroup.mk' (center H) x = QuotientGroup.mk' (center H) y) :
    x ^ 2 = y ^ 2 := by
  have hz : x⁻¹ * y ∈ center H := QuotientGroup.eq.mp h
  have hz2 : (x⁻¹ * y) ^ 2 = 1 := by
    have hh := pow_card_eq_one' (x := (⟨x⁻¹ * y, hz⟩ : center H))
    rw [IsExtraspecial.center_order_p 2 H] at hh
    exact congrArg Subtype.val hh
  have hc : Commute x (x⁻¹ * y) := mem_center_iff.mp hz x
  have hh := hc.mul_pow 2
  simpa only [mul_inv_cancel_left, hz2, mul_one] using hh.symm

private theorem coset_card_of_square_one_card [Finite H]
    (hc : Nat.card {x : H // x ^ 2 = 1} = 12) :
    Nat.card (CentralInvolutionCosets H) = 5 := by
  classical
  let q := QuotientGroup.mk' (center H)
  let s : Set (H ⧸ center H) := {v | ∃ x : H, x ^ 2 = 1 ∧ q x = v}
  have hs : Nat.card s = 6 := by
    have he := card_preimage q (QuotientGroup.mk'_surjective _) s
    have hker : q.ker = center H := QuotientGroup.ker_mk' _
    rw [hker, IsExtraspecial.center_order_p 2 H] at he
    have hpre : Nat.card {x : H // q x ∈ s} = 12 := by
      rw [Nat.card_congr (Equiv.subtypeEquivRight (fun x => ?_))]
      exact hc
      change (∃ y : H, y ^ 2 = 1 ∧ q y = q x) ↔ x ^ 2 = 1
      constructor
      · rintro ⟨y, hy, hyx⟩
        exact (square_eq_of_coset_eq hyx).symm.trans hy
      · exact fun hx => ⟨x, hx, rfl⟩
    rw [hpre] at he
    omega
  let oneS : s := ⟨1, 1, by simp, map_one q⟩
  let e : CentralInvolutionCosets H ≃ {v : s // v ≠ oneS} :=
    { toFun := fun v => ⟨⟨v.val, v.property.2⟩, fun h => v.property.1 (congrArg Subtype.val h)⟩
      invFun := fun v => ⟨v.val.val, (fun h => v.property (Subtype.ext h)), v.val.property⟩
      left_inv := by intro v; rfl
      right_inv := by intro v; rfl }
  let := Fintype.ofFinite s
  rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_subtype_compl,
    Fintype.card_subtype_eq, ← Nat.card_eq_fintype_card, hs]

/-- The quaternion–dihedral central product of order 32 has five nonidentity
central cosets admitting a square-one representative. -/
public theorem quaternion_dihedral_central_involution_cosets_card [Finite H]
    (hcard : Nat.card H = 32) (B C : Subgroup H)
    (hB : Nonempty (B ≃* QuaternionGroup 2)) (hC : Nonempty (C ≃* DihedralGroup 4))
    (hcomm : C ≤ centralizer (B : Set H)) (hjoin : B ⊔ C = ⊤) :
    Nat.card (CentralInvolutionCosets H) = 5 :=
  coset_card_of_square_one_card (card_square_one hcard B C hB hC hcomm hjoin)

/-- Square-one elements generate a quaternion–dihedral central product. -/
public theorem quaternion_dihedral_involutions_generate
    (B C : Subgroup H) (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* DihedralGroup 4))
    (hcomm : C ≤ centralizer (B : Set H)) (hjoin : B ⊔ C = ⊤) :
    closure {x : H | x ^ 2 = 1} = ⊤ := by
  obtain ⟨eB⟩ := hB
  obtain ⟨eC⟩ := hC
  let b := B.subtype.comp eB.symm.toMonoidHom
  let c := C.subtype.comp eC.symm.toMonoidHom
  let K := closure {x : H | x ^ 2 = 1}
  have hi (x : H) (hx : x ^ 2 = 1) : x ∈ K := subset_closure hx
  have hs : c (DihedralGroup.sr 0) ∈ K := hi _ (by
    rw [← map_pow, show (DihedralGroup.sr 0 : DihedralGroup 4) ^ 2 = 1 by decide, map_one])
  have hcK (x : DihedralGroup 4) : c x ∈ K := by
    have casesD : ∀ x : DihedralGroup 4, x ^ 2 = 1 ∨ (x * DihedralGroup.sr 0) ^ 2 = 1 := by decide
    rcases casesD x with hx | hx
    · exact hi _ (by rw [← map_pow, hx, map_one])
    · have hxK : c x * c (DihedralGroup.sr 0) ∈ K := hi _ (by
        rw [← map_mul, ← map_pow, hx, map_one])
      exact (K.mul_mem_cancel_right hs).mp hxK
  have hbK (x : QuaternionGroup 2) : b x ∈ K := by
    have casesQ : ∀ x : QuaternionGroup 2, x ^ 2 = 1 ∨ x ^ 2 = QuaternionGroup.a 2 := by decide
    rcases casesQ x with hx | hx
    · exact hi _ (by rw [← map_pow, hx, map_one])
    · have hc : Commute (b x) (c (DihedralGroup.r 1)) :=
        hcomm (eC.symm (DihedralGroup.r 1)).property _ (eB.symm x).property
      have hm : b x * c (DihedralGroup.r 1) ∈ K := hi _ (by
        rw [hc.mul_pow, ← map_pow, ← map_pow, hx,
          show (DihedralGroup.r 1 : DihedralGroup 4) ^ 2 = DihedralGroup.r 2 by decide,
          shared_square b c (B.subtype_injective.comp eB.symm.injective)
            (C.subtype_injective.comp eC.symm.injective), ← map_mul,
          show (DihedralGroup.r 2 : DihedralGroup 4) * DihedralGroup.r 2 = 1 by decide,
          map_one])
      exact (K.mul_mem_cancel_right (hcK _)).mp hm
  apply top_unique
  rw [← hjoin]
  apply sup_le
  · intro x hx
    simpa [b] using hbK (eB ⟨x, hx⟩)
  · intro x hx
    simpa [c] using hcK (eC ⟨x, hx⟩)

/-- On a quaternion–dihedral central product, the involution-coset action
has the same kernel as the action on the full central quotient. -/
public theorem quaternion_dihedral_central_involution_coset_kernel
    (B C : Subgroup H) (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* DihedralGroup 4))
    (hcomm : C ≤ centralizer (B : Set H)) (hjoin : B ⊔ C = ⊤) :
    (centralInvolutionCosetAction (H := H)).ker = (quotientAut (center H)).ker := by
  ext a
  change centralInvolutionCosetAction a = 1 ↔ quotientAut (center H) a = 1
  constructor
  · intro ha
    let q := QuotientGroup.mk' (center H)
    have hfix : (q.comp a.toMonoidHom) = q := by
      apply MonoidHom.eq_of_eqOn_dense (quaternion_dihedral_involutions_generate B C hB hC hcomm hjoin)
      intro x hx
      change q (a x) = q x
      rw [← quotientAut_apply_mk]
      by_cases hxZ : x ∈ center H
      · have hq : q x = 1 := (QuotientGroup.eq_one_iff x).mpr hxZ
        rw [hq, map_one]
      · have hpoint : centralInvolutionCosetAction a (centralInvolutionCoset x hx hxZ) =
            centralInvolutionCoset x hx hxZ := by rw [ha]; rfl
        have hh := congrArg Subtype.val hpoint
        rw [centralInvolutionCosetAction_val] at hh
        exact hh
    apply MulEquiv.ext
    intro v
    induction v using Quotient.inductionOn with
    | h x =>
      change quotientAut (center H) a (q x) = q x
      rw [quotientAut_apply_mk]
      exact DFunLike.congr_fun hfix x
  · intro ha
    apply Equiv.Perm.ext
    intro v
    apply Subtype.ext
    rw [centralInvolutionCosetAction_val, ha]
    rfl
end Subgroup
