module

public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Tactic

/-!
# Normalizers of subgroups of order three

An element normalizing a subgroup of order three either fixes or inverts
its generator. Once one inverting element is specified, the normalizer is
generated by it and the centralizer. This is the elementary normalizer
step in Fong, J. Algebra 6 (1967), p.75.
-/

namespace Subgroup

public theorem normalizer_zpowers_order_three
    {G : Type*} [Group G] (r f : G) (hr : orderOf r = 3)
    (hf : f⁻¹ * r * f = r⁻¹) :
    normalizer (zpowers r : Set G) = zpowers f ⊔ centralizer ({r} : Set G) := by
  classical
  have hfin : IsOfFinOrder r := orderOf_pos_iff.mp (by omega)
  have hrne : r ≠ 1 := by intro h; simp [h] at hr
  have hrpow : r ^ 3 = 1 := hr ▸ pow_orderOf_eq_one r
  have hrsq : r ^ 2 = r⁻¹ := by
    apply mul_right_cancel (b := r)
    simpa [pow_succ] using hrpow
  have hfr : f * r * f⁻¹ = r⁻¹ := by
    have hi := congrArg Inv.inv hf
    simp only [mul_inv_rev, inv_inv, ← mul_assoc] at hi
    calc
      f * r * f⁻¹ = f * (f⁻¹ * r⁻¹ * f) * f⁻¹ := by rw [hi]
      _ = r⁻¹ := by group
  have hfN : f ∈ normalizer (zpowers r : Set G) := by
    rw [mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
    change zpowers (f * r * f⁻¹) = zpowers r
    rw [hfr, zpowers_inv]
  have hCN : centralizer ({r} : Set G) ≤ normalizer (zpowers r : Set G) := by
    intro g hg
    rw [mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
    change zpowers (g * r * g⁻¹) = zpowers r
    rw [mem_centralizer_singleton_iff.mp hg, mul_inv_cancel_right]
  have hfB : zpowers f ≤ zpowers f ⊔ centralizer ({r} : Set G) := le_sup_left
  have hCB : centralizer ({r} : Set G) ≤ zpowers f ⊔ centralizer ({r} : Set G) :=
    le_sup_right
  apply le_antisymm
  · intro g hg
    have hmem : g * r * g⁻¹ ∈ zpowers r := (hg r).mp (mem_zpowers r)
    rw [hfin.mem_zpowers_iff_mem_range_orderOf, hr] at hmem
    obtain ⟨n, hn, heq⟩ := Finset.mem_image.mp hmem
    have hn3 := Finset.mem_range.mp hn
    have halt : g * r * g⁻¹ = r ∨ g * r * g⁻¹ = r⁻¹ := by
      interval_cases n
      · have he : (MulAut.conj g) r = (MulAut.conj g) 1 := by simpa using heq.symm
        exact (hrne ((MulAut.conj g).injective he)).elim
      · exact Or.inl (by simpa using heq.symm)
      · exact Or.inr (by simpa [hrsq] using heq.symm)
    rcases halt with hfix | hinv
    · exact hCB (mem_centralizer_singleton_iff.mpr
        (mul_inv_eq_iff_eq_mul.mp hfix))
    · have hfg : f⁻¹ * g ∈ centralizer ({r} : Set G) := by
        apply mem_centralizer_singleton_iff.mpr
        apply mul_inv_eq_iff_eq_mul.mp
        calc
          (f⁻¹ * g) * r * (f⁻¹ * g)⁻¹ = f⁻¹ * (g * r * g⁻¹) * f := by group
          _ = f⁻¹ * r⁻¹ * f := by rw [hinv]
          _ = r := by
            have hi := congrArg Inv.inv hf
            simpa only [mul_inv_rev, inv_inv, ← mul_assoc] using hi
      have hh := (zpowers f ⊔ centralizer ({r} : Set G)).mul_mem
        (hfB (mem_zpowers f)) (hCB hfg)
      simpa using hh
  · exact sup_le (zpowers_le.mpr hfN) hCN

end Subgroup
