module
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Commutator.Basic
public import Theory.ElementaryAbelian.Basic

/-!
# A displacement bound for a cyclic extension

If V maps to a cyclic subgroup of H/J generated by tJ, each element of
V is b tⁿ with b in V∩J. In the elementary abelian group J/J′, the
commutator of two such elements is a product of displacements. Thus any
subgroup containing the displacements of (V∩J)J′/J′ contains the image
of V′. No restriction on the order of the cyclic quotient is needed.

Source: the calculation (C/E)′=B/E in Parrott,
*A characterization of the Tits' simple group* (1972), p.676.
-/

open Subgroup
open scoped commutatorElement IsMulCommutative
namespace Theory.GroupTheory
/-- Bound the actual derived image by the displacements of the core intersection. -/
public theorem cyclic_extension_derived_le_of_displacement_le
    {H : Type*} [Group H] [Finite H]
    (J V : Subgroup H) [J.Normal]
    [IsElementaryAbelian 2 (J ⧸ commutator J)]
    (f : (H ⧸ J) →* MulAut (J ⧸ commutator J))
    (hf : ∀ (a : H) (b b' : J), (b' : H) = a * (b : H) * a⁻¹ →
      f (QuotientGroup.mk' J a) (QuotientGroup.mk' (commutator J) b) =
        QuotientGroup.mk' (commutator J) b')
    (t : H) (ht : t ∈ V)
    (hVmap : V.map (QuotientGroup.mk' J) = zpowers (QuotientGroup.mk' J t))
    (R : Subgroup (J ⧸ commutator J))
    (hstable : ∀ w ∈ (V.comap J.subtype).map (QuotientGroup.mk' (commutator J)),
      f (QuotientGroup.mk' J t) w ∈
        (V.comap J.subtype).map (QuotientGroup.mk' (commutator J)))
    (hdisp : ∀ w ∈ (V.comap J.subtype).map (QuotientGroup.mk' (commutator J)),
      f (QuotientGroup.mk' J t) w * w ∈ R) :
    (((commutator V).map V.subtype).comap J.subtype).map
      (QuotientGroup.mk' (commutator J)) ≤ R := by
  classical
  let π := QuotientGroup.mk' J
  let q := QuotientGroup.mk' (commutator J)
  let a := f (π t)
  let U := (V.comap J.subtype).map q
  have hinv (w : J ⧸ commutator J) : w⁻¹ = w := by
    apply inv_eq_of_mul_eq_one_left
    simpa only [pow_two] using Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 (J ⧸ commutator J)) w
  have hself (w : J ⧸ commutator J) : w * w = 1 := by
    simpa only [hinv] using inv_mul_cancel w
  have hstablePow (n : ℕ) (w : J ⧸ commutator J) (hw : w ∈ U) : (a ^ n) w ∈ U := by
    induction n with
    | zero => exact hw
    | succ n ih =>
      rw [pow_succ', MulAut.mul_apply]
      exact hstable _ ih
  have hdispPow (n : ℕ) (w : J ⧸ commutator J) (hw : w ∈ U) :
      (a ^ n) w * w ∈ R := by
    induction n with
    | zero => simpa only [pow_zero, MulAut.one_apply, hself] using R.one_mem
    | succ n ih =>
      have hh := R.mul_mem (hdisp _ (hstablePow n w hw)) ih
      convert hh using 1
      change (a ^ (n+1)) w * w =
        (a ((a ^ n) w) * (a ^ n) w) * ((a ^ n) w * w)
      rw [pow_succ', MulAut.mul_apply]
      simp only [mul_assoc, ← mul_assoc ((a ^ n) w) ((a ^ n) w), hself, one_mul]
  let c (n : ℕ) (b : J) : J :=
    ⟨t ^ n * b * (t ^ n)⁻¹, Subgroup.Normal.conj_mem inferInstance _ b.property _⟩
  have hc (n : ℕ) (b : J) : q (c n b) = (a ^ n) (q b) := by
    have hh := hf (t ^ n) b (c n b) rfl
    simpa only [map_pow] using hh.symm
  have hdecomp (x : H) (hx : x ∈ V) :
      ∃ b : J, (b : H) ∈ V ∧ ∃ n : ℕ, x = b * t ^ n := by
    have hp : π x ∈ zpowers (π t) := hVmap ▸ mem_map_of_mem π hx
    rw [mem_zpowers_iff_mem_range_orderOf] at hp
    obtain ⟨n, _, hn⟩ := Finset.mem_image.mp hp
    have heq : π x = π (t ^ n) := by simpa only [map_pow] using hn.symm
    have hbJ : x * (t ^ n)⁻¹ ∈ J := (QuotientGroup.eq_one_iff _).mp (by
      change π (x * (t ^ n)⁻¹) = 1
      rw [map_mul, map_inv, heq, mul_inv_cancel])
    exact ⟨⟨x * (t ^ n)⁻¹, hbJ⟩, V.mul_mem hx (V.inv_mem (V.pow_mem ht n)),
      n, by simp⟩
  let N := (R.comap q).map J.subtype
  have hbound : (commutator V).map V.subtype ≤ N := by
    rw [map_subtype_commutator]
    apply commutator_le.mpr
    intro x hx y hy
    obtain ⟨b, hb, n, rfl⟩ := hdecomp x hx
    obtain ⟨d, hd, m, rfl⟩ := hdecomp y hy
    refine ⟨b * c n d * (c m b)⁻¹ * d⁻¹, ?_, ?_⟩
    · change q (b * c n d * (c m b)⁻¹ * d⁻¹) ∈ R
      have heq : q (b * c n d * (c m b)⁻¹ * d⁻¹) =
          ((a ^ m) (q b) * q b) * ((a ^ n) (q d) * q d) := by
        simp only [map_mul, map_inv, hc, hinv]
        ac_rfl
      rw [heq]
      exact R.mul_mem (hdispPow m _ (mem_map_of_mem q hb))
        (hdispPow n _ (mem_map_of_mem q hd))
    · change (b : H) * (t ^ n * (d : H) * (t ^ n)⁻¹) *
          (t ^ m * (b : H) * (t ^ m)⁻¹)⁻¹ * (d : H)⁻¹ =
            ⁅(b : H) * t ^ n, (d : H) * t ^ m⁆
      simp only [commutatorElement_def]
      group
  rintro w ⟨b, hb, rfl⟩
  obtain ⟨b', hb', heq⟩ := hbound hb
  exact (show b' = b from Subtype.ext heq) ▸ hb'
end Theory.GroupTheory
