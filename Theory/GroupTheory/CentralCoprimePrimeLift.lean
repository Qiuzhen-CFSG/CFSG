module

public import Theory.GroupTheory.CoprimeQuotientSubgroups
public import Theory.GroupTheory.LocalNormalizerUniqueness

/-!
# Prime-subgroup lifts through central coprime kernels

A prime subgroup lifts isomorphically through a surjective homomorphism
with central coprime kernel. A Sylow subgroup of its inverse image maps
onto it; the inverse image is generated by that Sylow subgroup and the
central kernel. Thus the Sylow subgroup is normal and characteristic.
This proves exact normalizer transport, and injectivity then proves exact
centralizer transport. No ambient normality of the prime subgroup is used.

The application is the genuine SL₃-to-PSL₃ projection in Aschbacher–Smith,
A.3.21(c), printed pp.55–56, and the Cartan argument on pp.510–511.
-/

namespace Subgroup

/-- Lift a prime subgroup and its full normalizer and centralizer through
a central coprime kernel. -/
public theorem exists_prime_lift_of_central_coprime {G H : Type*} [Group G] [Finite G] [Group H]
    {p : ℕ} [Fact p.Prime] (f : G →* H) (hf : Function.Surjective f)
    (hcentral : f.ker ≤ center G) (hker : Nat.Coprime p (Nat.card f.ker))
    (B : Subgroup H) (hB : IsPGroup p B) :
    ∃ A : Subgroup G, IsPGroup p A ∧ A.map f = B ∧
      (normalizer (B : Set H)).comap f = normalizer (A : Set G) ∧
      (centralizer (B : Set H)).comap f = centralizer (A : Set G) ∧
      Function.Injective (f.comp A.subtype) := by
  let L := B.comap f
  let q : L →* B := f.subgroupComap B
  have hq : Function.Surjective q := f.subgroupComap_surjective_of_surjective B hf
  let P : Sylow p L := Sylow.nonempty.some
  have hPtop : (P : Subgroup L).map q = ⊤ := by
    change (P.mapSurjective hq : Subgroup B) = ⊤
    apply top_unique
    exact (hB.to_subgroup ⊤).le_sylow_of_normal _
  have hqcentral : q.ker ≤ center L := by
    intro x hx
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    exact mem_center_iff.mp (hcentral (show (x : G) ∈ f.ker from
      congrArg Subtype.val hx)) y
  have hgen : (P : Subgroup L) ⊔ q.ker = ⊤ := by
    rw [← comap_map_eq, hPtop, comap_top]
  have hPn : (P : Subgroup L).Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hgen]
    exact sup_le le_normalizer
      (hqcentral.trans ((center_le_centralizer _).trans (centralizer_le_normalizer _)))
  let _ : (P : Subgroup L).Characteristic := P.characteristic_of_normal hPn
  let A := (P : Subgroup L).map L.subtype
  have hA : IsPGroup p A := P.isPGroup'.map L.subtype
  have hmap : A.map f = B := by
    have hh := congrArg (Subgroup.map B.subtype) hPtop
    rw [map_map, ← MonoidHom.range_eq_map, range_subtype] at hh
    change (P : Subgroup L).map (f.comp L.subtype) = B at hh
    simpa only [A, map_map] using hh
  have hnorm : (normalizer (B : Set H)).comap f = normalizer (A : Set G) := by
    apply le_antisymm
    · have he : (normalizer (B : Set H)).comap f = normalizer (L : Set G) :=
        comap_normalizer_eq_of_le_range (by rw [MonoidHom.range_eq_top.mpr hf]; exact le_top)
      rw [he]
      exact normalizer_le_normalizer_characteristic_image L (P : Subgroup L)
    · rw [← map_le_iff_le_comap, ← hmap]
      exact A.le_normalizer_map f
  have hinj := injective_comp_subtype_of_coprime_ker f hker A hA
  refine ⟨A, hA, hmap, hnorm, ?_, hinj⟩
  apply le_antisymm
  · intro x hx
    have hxn : x ∈ normalizer (A : Set G) := by
      rw [← hnorm]
      exact centralizer_le_normalizer _ hx
    intro a ha
    have he : (⟨x * a * x⁻¹, (hxn a).mp ha⟩ : A) = ⟨a, ha⟩ := by
      apply hinj
      change f (x * a * x⁻¹) = f a
      rw [map_mul, map_mul, map_inv, ← hx (f a) (hmap ▸ mem_map_of_mem f ha)]
      simp only [mul_inv_cancel_right]
    exact ((mul_inv_eq_iff_eq_mul).mp (congrArg Subtype.val he)).symm
  · rw [← map_le_iff_le_comap, ← hmap]
    exact map_centralizer_le_centralizer_image _ f

end Subgroup
