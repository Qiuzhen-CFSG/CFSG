module
public import Theory.GroupTheory.PResidual.CentralSylowFrattini
public import Theory.GroupTheory.CommutatorPreimage
public import Theory.GroupTheory.ConjugationLocalGeometry

/-!
# The kernel generated by a conjugate pair

In a two-perfect group generated by U and a conjugate of U, suppose a
normal two-kernel normalizes U and the U-image is Sylow in the target.
The join of the two U-kernels makes the full kernel central modulo that
join. Transfer to a Sylow Frattini quotient then removes the remaining
central kernel. Thus the full kernel is generated by the two marked
intersections. This argument does not require a common Sylow overgroup.

Source: Aschbacher–Smith,G.2.4(3), via the proof of G.2.3(3), printed
pp.333–334; used on the actual pair in13.5.14–15.
-/

@[expose] public section
open Subgroup
namespace Subgroup
variable {G A : Type*} [Group G] [Finite G] [Group A]

theorem kernel_eq_intersection_pair_of_twoPerfect
    (hp : IsPPerfect 2 G) (f : G →* A) (hk : IsPGroup 2 f.ker)
    (U : Subgroup G) (hU : IsPGroup 2 U) (g : G)
    (hgen : U ⊔ U.map (MulAut.conj g).toMonoidHom = ⊤)
    (hn : f.ker ≤ normalizer (U : Set G))
    (P : Sylow 2 A) (hP : U.map f = P) :
    f.ker = (U ⊓ f.ker) ⊔ (U ⊓ f.ker).map (MulAut.conj g).toMonoidHom := by
  let S := f.ker
  let U' := U.map (MulAut.conj g).toMonoidHom
  let W := U ⊓ S
  let W' := W.map (MulAut.conj g).toMonoidHom
  let N := W ⊔ W'
  have hSg : S.map (MulAut.conj g).toMonoidHom = S :=
    mem_normalizer_iff_map_conj_eq.mp (S.normalizer_eq_top ▸ mem_top g)
  have hW' : W'=U'⊓S := by
    change (U⊓S).map (MulAut.conj g).toMonoidHom = _
    rw [map_inf _ _ _ (MulAut.conj g).injective,hSg]
  have hNS : N ≤ S := sup_le inf_le_right (hW' ▸ inf_le_right)
  have hn' : S ≤ normalizer (U' : Set G) := by
    have hh := (map_mono (f := (MulAut.conj g).toMonoidHom) hn).trans
      (U.le_normalizer_map (MulAut.conj g).toMonoidHom)
    rwa [hSg] at hh
  have hcU : ⁅U,S⁆ ≤ N := (le_inf (le_normalizer_iff_commutator_le_left.mp hn)
    (commutator_le_right U S)).trans le_sup_left
  have hcU' : ⁅U',S⁆ ≤ N := (le_inf (le_normalizer_iff_commutator_le_left.mp hn')
    (commutator_le_right U' S)).trans (hW'.symm ▸ le_sup_right)
  have hNn : (⊤:Subgroup G) ≤ normalizer (N : Set G) := by
    rw [←hgen]
    exact sup_le (le_normalizer_iff_commutator_le_right.mpr
      ((commutator_mono le_rfl hNS).trans hcU))
      (le_normalizer_iff_commutator_le_right.mpr ((commutator_mono le_rfl hNS).trans hcU'))
  let : N.Normal := normalizer_eq_top_iff.mp (top_unique hNn)
  have hc : ⁅S,(⊤:Subgroup G)⁆ ≤ N := by
    have hu := sup_le (le_commutatorPreimage (show U≤⊤ from le_top) hcU)
      (le_commutatorPreimage (show U'≤⊤ from le_top) hcU')
    have hh : (⊤:Subgroup G) ≤ commutatorPreimage ⊤ S N := hgen ▸ hu
    rw [commutator_comm]
    exact (commutator_mono hh le_rfl).trans (commutator_commutatorPreimage_le _ _ _ hNn)
  have hcentral : S ≤ (center (G ⧸ N)).comap (QuotientGroup.mk' N) := by
    apply map_le_iff_le_comap.mp
    apply commutator_top_right_eq_bot_iff_le_center.mp
    rw [←map_top_of_surjective (QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N),
      ←map_commutator]
    exact le_bot_iff.mp ((map_mono hc).trans_eq (QuotientGroup.map_mk'_self N))
  obtain ⟨R,hUR⟩ := hU.exists_le_sylow
  have hcover : (R:Subgroup G).map f ≤ U.map f := by
    rw [hP]
    exact (P.is_maximal' (R.isPGroup'.map f) (hP ▸ map_mono hUR)).le
  have hR : (R:Subgroup G) ≤ U ⊔ N :=
    sylow_le_sup_of_image_cover_of_central_kernel_mod hp R f N hNS hcentral U hUR hcover
  apply le_antisymm ?_ hNS
  intro s hs
  have hm : s ∈ U ⊔ N := hR (hk.le_sylow_of_normal R hs)
  obtain ⟨u,hu,n,hn,rfl⟩ := mem_sup_of_normal_right.mp hm
  have hus : u∈S := by
    have hh := S.mul_mem hs (S.inv_mem (hNS hn))
    simpa only [mul_inv_cancel_right] using hh
  exact N.mul_mem (mem_sup_left (show u∈W from ⟨hu,hus⟩)) hn

end Subgroup
end
