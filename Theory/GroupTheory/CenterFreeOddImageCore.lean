module

public import Theory.GroupTheory.PGroup.NormalSubgroups
public import Theory.GroupTheory.CoprimeCentralizerDecomposition
public import Mathlib.GroupTheory.SchurZassenhaus

/-!
# A central commutator bound in a center-free group

Let a finite center-free group be generated by a normal subgroup `E` and a
supplied Sylow two-subgroup. Suppose `Q` is a normal two-subgroup and the
image of `E` in the quotient by `Q` has odd order. If `[Q,E]` lies in a
subgroup `V` centralizing `Q`, then `Q ≤ V`. The subgroup `V` need not lie
in `Q`; neither the ambient group nor `E` is assumed solvable.

The reusable centralizer theorem first proves that `C_Q(E)` is trivial.
It is normal and lies in the supplied Sylow subgroup. If it
were nontrivial, the normal-subgroup center theorem for two-groups would
give an element centralizing both the Sylow subgroup and `E`, contradicting
center-freeness. The three-subgroups lemma then puts `[Q,Q]` in `C_Q(E)`,
so `Q` is abelian.

The index of `Q ∩ E` inside `E` is the cardinality of the exact supplied
quotient image. Schur–Zassenhaus gives an odd complement `R` inside `E`.
Abelianness of `Q` identifies `C_Q(R)` with `C_Q(E)`, hence with the trivial
subgroup. The existing coprime-action decomposition now gives
`Q = [Q,R] ≤ [Q,E] ≤ V`. All actions are the existing subgroup-conjugation
actions, and the quotient uses the original normality instance for `Q`.

This is the abstract core-collapse argument used twice in Stellmacher (8.3),
journal p.38. Its source-facing caller establishes the odd quotient image
from the local primitive structure. Source: refs/latex/stellmacher-n-group.tex.
-/

namespace Subgroup

/-- A normal two-subgroup has trivial centralizer of a normal Sylow supplement
in a center-free finite group. -/
public theorem inf_centralizer_eq_bot_of_centerfree_sylow_supplement
    {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    (E Q : Subgroup G) [E.Normal] [Q.Normal]
    (hcover : E ⊔ (S : Subgroup G) = ⊤) (hQ : IsPGroup 2 Q)
    (hcenter : center G = ⊥) : Q ⊓ centralizer (E : Set G) = ⊥ := by
  classical
  let C := Q ⊓ centralizer (E : Set G)
  change C = ⊥
  by_contra hCne
  have hCS : C ≤ (S : Subgroup G) := inf_le_left.trans (hQ.le_sylow_of_normal S)
  let _ : Nontrivial C := (nontrivial_iff_ne_bot C).mpr hCne
  let _ : Nontrivial (C.subgroupOf (S : Subgroup G)) :=
    (subgroupOfEquivOfLe hCS).toEquiv.nontrivial
  let _ : Fact (IsPGroup 2 S) := ⟨S.isPGroup'⟩
  obtain ⟨x, hxne, hxcenter⟩ :=
    exists_nontrivial_center_mem_normal (C.subgroupOf (S : Subgroup G)) (p := 2)
  have hxE : ((x : S) : G) ∈ centralizer (E : Set G) := x.property.2
  have hxS : ((x : S) : G) ∈ centralizer (S : Set G) := by
    rw [mem_centralizer_iff]
    intro s hs
    exact congrArg Subtype.val ((mem_center_iff.mp hxcenter) ⟨s, hs⟩)
  have htop : (⊤ : Subgroup G) ≤ centralizer ({((x : S) : G)} : Set G) := by
    rw [← hcover]
    apply sup_le
    · intro e he
      rw [mem_centralizer_singleton_iff]
      exact (mem_centralizer_iff.mp hxE) e he
    · intro s hs
      rw [mem_centralizer_singleton_iff]
      exact (mem_centralizer_iff.mp hxS) s hs
  have hxG : ((x : S) : G) ∈ center G := by
    rw [mem_center_iff]
    intro g
    exact mem_centralizer_singleton_iff.mp (htop (mem_top g))
  rw [hcenter] at hxG
  exact hxne (Subtype.ext (Subtype.ext hxG))

/-- An odd quotient-image commutator bound centralizing a normal two-subgroup
contains that subgroup in a center-free group with the supplied supplement. -/
public theorem le_of_centerfree_odd_image_commutator_le
    {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    (E Q V : Subgroup G) [E.Normal] [Q.Normal]
    (hcover : E ⊔ (S : Subgroup G) = ⊤) (hQ : IsPGroup 2 Q)
    (hodd : Odd (Nat.card (E.map (QuotientGroup.mk' Q))))
    (hcenter : center G = ⊥) (hV : V ≤ centralizer (Q : Set G))
    (hcomm : ⁅Q, E⁆ ≤ V) : Q ≤ V := by
  classical
  let C := Q ⊓ centralizer (E : Set G)
  have hCbot : C = ⊥ :=
    inf_centralizer_eq_bot_of_centerfree_sylow_supplement S E Q hcover hQ hcenter
  have hrotate : ⁅⁅Q, E⁆, Q⁆ = ⊥ :=
    commutator_eq_bot_iff_le_centralizer.mpr (hcomm.trans hV)
  have hQQE : ⁅⁅Q, Q⁆, E⁆ = ⊥ :=
    commutator_commutator_eq_bot_of_rotate hrotate (by rwa [commutator_comm E Q])
  have hQQ : ⁅Q, Q⁆ = ⊥ := by
    apply le_bot_iff.mp
    rw [← hCbot]
    exact le_inf (commutator_le_left Q Q)
      (commutator_eq_bot_iff_le_centralizer.mp hQQE)
  let _ : IsMulCommutative Q := commutator_self_eq_bot_iff.mp hQQ
  have hsolvQ : Group.IsSolvable Q :=
    Group.isSolvable_of_comm fun x y => (IsMulCommutative.is_comm (M := Q)).comm x y
  let K := Q.subgroupOf E
  have hKp : IsPGroup 2 K := hQ.comap_of_injective E.subtype E.subtype_injective
  have hKodd : Odd K.index := by
    change Odd (Q.subgroupOf E).index
    rw [index_eq_card, ← natCard_map_mk'_eq E Q]
    exact hodd
  have hKcop : Nat.Coprime (Nat.card K) K.index := by
    obtain ⟨n, hn⟩ := hKp.exists_card_eq
    rw [hn]
    exact hKodd.coprime_two_left.pow_left n
  obtain ⟨R0, hR0⟩ := exists_right_complement'_of_coprime hKcop
  let R := R0.map E.subtype
  have hRE : R ≤ E := map_subtype_le _
  have hRodd : Odd (Nat.card R) := by
    rw [card_map_of_injective E.subtype_injective, ← hR0.symm.index_eq_card]
    exact hKodd
  have hEfactor : E = (Q ⊓ E) ⊔ R := by
    have hm := congrArg (fun H : Subgroup E => H.map E.subtype) hR0.sup_eq_top
    change (Q.subgroupOf E ⊔ R0).map E.subtype = (⊤ : Subgroup E).map E.subtype at hm
    rw [map_sup, subgroupOf_map_subtype, ← MonoidHom.range_eq_map, range_subtype] at hm
    exact hm.symm
  have hRcop : Nat.Coprime (Nat.card R) (Nat.card Q) := by
    obtain ⟨n, hn⟩ := hQ.exists_card_eq
    rw [hn]
    exact hRodd.coprime_two_right.pow_right n
  have hRfix : Q ⊓ centralizer (R : Set G) = ⊥ := by
    apply bot_unique
    rw [← hCbot]
    refine le_inf inf_le_left ?_
    apply le_centralizer_iff.mp
    rw [hEfactor]
    exact sup_le
      ((inf_le_left.trans (le_centralizer (H := Q))).trans (centralizer_le inf_le_left))
      (le_centralizer_iff.mp inf_le_right)
  have hQdecomp := eq_commutator_sup_centralizer_of_solvable_coprime Q R
    le_normalizer_of_normal hsolvQ hRcop
  rw [hRfix, sup_bot_eq] at hQdecomp
  rw [hQdecomp]
  exact (commutator_mono le_rfl hRE).trans hcomm

end Subgroup
