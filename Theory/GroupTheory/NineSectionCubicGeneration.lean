module
public import Theory.Representation.CoprimeElementaryComplement
public import Theory.GroupTheory.CentralCharacteristicAutomorphisms
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.GroupTheory.NormalSylowQuotientAction.MarkedLift
public import Mathlib.GroupTheory.Complement
public import Theory.GroupTheory.PerfectSmallNormalizer

/-!
# Cubic overgroups from a reducible elementary nine-section

A Sylow two-group normalizing a two-closed subgroup acts coprimely on its
nine-element elementary quotient. An invariant cubic subgroup has an
invariant cubic complement. Their preimages, joined with the original
Sylow group, both have Sylow index three and generate the original subgroup.
-/

public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

def sylowCoreAction (S : Sylow 2 G) (B : Subgroup G)
    (hSB : (S : Subgroup G) ≤ normalizer (B : Set G)) :
    S →* MulAut (B ⧸ pCore 2 B) :=
  (quotientAut (pCore 2 B)).comp (B.normalizerMonoidHom.comp
    (inclusion hSB))

omit [Finite G] in
theorem sylowCoreAction_mk (S : Sylow 2 G) (B : Subgroup G)
    (hSB : (S : Subgroup G) ≤ normalizer (B : Set G)) (s : S) (b : B) :
    sylowCoreAction S B hSB s (QuotientGroup.mk' (pCore 2 B) b) =
      QuotientGroup.mk' (pCore 2 B) (B.normalizerMonoidHom ⟨s,hSB s.property⟩ b) := by
  exact quotientAut_apply_mk _ _ _

theorem cubic_preimage_join_index (S : Sylow 2 G) (B : Subgroup G)
    (hSB : (S : Subgroup G) ≤ normalizer (B : Set G))
    (hcore : pCore 2 B = (S : Subgroup G).subgroupOf B)
    (D : Subgroup (B ⧸ pCore 2 B)) (hD : Nat.card D = 3)
    (hinv : ∀ s : S, ∀ x ∈ D, sylowCoreAction S B hSB s x ∈ D) :
    (S : Subgroup G).relIndex
      ((D.comap (QuotientGroup.mk' (pCore 2 B))).map B.subtype ⊔ (S : Subgroup G)) = 3 := by
  let q := QuotientGroup.mk' (pCore 2 B)
  let C := D.comap q
  let A := C.map B.subtype
  have hnorm : (S : Subgroup G) ≤ normalizer (A : Set G) := by
    intro s hs
    apply mem_normalizer_iff.mpr
    intro x
    have hf (t : S) (y : G) (hy : y ∈ A) : (t:G)*y*(t:G)⁻¹ ∈ A := by
      obtain ⟨b,hb,rfl⟩ := hy
      let a := B.normalizerMonoidHom ⟨t,hSB t.property⟩
      refine ⟨a b,?_,?_⟩
      · have hh := hinv t (q b) hb
        change quotientAut (pCore 2 B) a (QuotientGroup.mk' (pCore 2 B) b) ∈ D at hh
        rwa [quotientAut_apply_mk] at hh
      · exact normalizerMonoidHom_apply_apply_coe B ⟨t,hSB t.property⟩ b
    constructor
    · exact hf ⟨s,hs⟩ x
    · intro hx
      have hh := hf ⟨s⁻¹,S.inv_mem hs⟩ (s*x*s⁻¹) hx
      simpa only [inv_inv,mul_assoc,inv_mul_cancel_left,mul_inv_cancel_right,inv_mul_cancel,mul_one] using hh
  rw [relIndex_sup_of_normalizes_left A (S : Subgroup G) hnorm]
  have hi := relIndex_comap (S : Subgroup G) B.subtype C
  change ((S : Subgroup G).subgroupOf B).relIndex C = _ at hi
  rw [← hcore] at hi
  rw [← hi]
  have hm := relIndex_map_map q (pCore 2 B) C
  have hk : q.ker = pCore 2 B := QuotientGroup.ker_mk' _
  have hkc : q.ker ≤ C := fun b hb => by change q b ∈ D; rw [hb]; exact D.one_mem
  rw [hk,sup_idem,sup_eq_left.mpr (hk ▸ hkc)] at hm
  rw [← hm]
  rw [show (pCore 2 B).map q = ⊥ from by simp [q],
    map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _),relIndex_bot_left]
  exact hD

/-- The original two-closed subgroup is generated by two Sylow-index-three
overgroups whenever its elementary nine-section has an invariant line. -/
theorem nine_section_cubic_generation (S : Sylow 2 G) (B : Subgroup G)
    (hSB : (S : Subgroup G) ≤ normalizer (B : Set G))
    (hcore : pCore 2 B = (S : Subgroup G).subgroupOf B)
    [IsElementaryAbelian 3 (B ⧸ pCore 2 B)]
    (hc : Nat.card (B ⧸ pCore 2 B) = 9)
    (D : Subgroup (B ⧸ pCore 2 B)) (hD : Nat.card D = 3)
    (hinv : ∀ s : S, ∀ x ∈ D, sylowCoreAction S B hSB s x ∈ D) :
    ∃ J₁ J₂ : Subgroup G,
      (S : Subgroup G) ≤ J₁ ∧ (S : Subgroup G) ≤ J₂ ∧
      J₁ ≤ B ⊔ (S : Subgroup G) ∧ J₂ ≤ B ⊔ (S : Subgroup G) ∧
      (S : Subgroup G).relIndex J₁ = 3 ∧ (S : Subgroup G).relIndex J₂ = 3 ∧
      B ≤ J₁ ⊔ J₂ := by
  have hcop : Nat.Coprime 3 (Nat.card S) := by
    obtain ⟨n,hn⟩ := S.isPGroup'.exists_card_eq
    rw [hn]
    exact (by decide : Nat.Coprime 3 2).pow_right n
  obtain ⟨E,hDE,hE⟩ := IsElementaryAbelian.exists_invariant_complement
    (sylowCoreAction S B hSB) hcop D hinv
  let : D.Normal := normal_of_isMulCommutative D
  have hcom : D.IsComplement' E := isComplement'_of_disjoint_and_mul_eq_univ
    hDE.disjoint (by rw [← normal_mul,hDE.sup_eq_top]; rfl)
  have hEc : Nat.card E = 3 := by
    have hh := hcom.card_mul_card
    rw [hD,hc] at hh
    omega
  let q := QuotientGroup.mk' (pCore 2 B)
  let C := (D.comap q).map B.subtype
  let C' := (E.comap q).map B.subtype
  refine ⟨C ⊔ (S : Subgroup G),C' ⊔ (S : Subgroup G),le_sup_right,le_sup_right,
    sup_le_sup (map_subtype_le _) le_rfl,sup_le_sup (map_subtype_le _) le_rfl,
    cubic_preimage_join_index S B hSB hcore D hD hinv,
    cubic_preimage_join_index S B hSB hcore E hEc hE,?_⟩
  have hgen : D.comap q ⊔ E.comap q = ⊤ := by
    apply map_injective_of_ker_le (f := q)
      (show q.ker ≤ D.comap q ⊔ E.comap q from (ker_le_comap q D).trans le_sup_left)
      (show q.ker ≤ ⊤ from le_top)
    rw [map_sup,map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _),
      map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _),hDE.sup_eq_top]
    exact (map_top_of_surjective q (QuotientGroup.mk'_surjective _)).symm
  have hBC : B = C ⊔ C' := by
    rw [← map_sup,hgen,← MonoidHom.range_eq_map,range_subtype]
  rw [hBC]
  exact sup_le (le_sup_left.trans le_sup_left) (le_sup_left.trans le_sup_right)
end Subgroup
