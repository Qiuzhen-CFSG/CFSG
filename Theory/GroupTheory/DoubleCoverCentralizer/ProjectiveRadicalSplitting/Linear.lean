module

public import Theory.Representation.ProjectiveCentralCover
public import Theory.Representation.BinaryAlternatingNaturalCohomology.Projective
public import Theory.Representation.BinaryPermutationNaturalStructure

/-!
# Projective sections and the A₅ displacement module

A projective quotient admits an equivariant section. When the kernel is fixed
and the quotient is generated by displacements, the section's image equals
the whole displacement subspace of the source. For the five-point binary
augmentation module, invariant-subspace structure and one explicit three-cycle
displacement prove the required generation assertion.

Source: Aschbacher–Smith I.1.6(1) and the projective splitting in I.2.2(5),
printed pp.408 and 411–412, combined manuscript of 1 March 2004.
-/

public section
open Representation
namespace ProjectiveRadicalSplitting

private lemma commutator_stable {k G W : Type*} [Field k] [Group G]
    [AddCommGroup W] [Module k W] (ρ : Representation k G W) (g : G) :
    Coinvariants.ker ρ ≤ (Coinvariants.ker ρ).comap (ρ g) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨h, v⟩, rfl⟩
  change ρ g (ρ h v - v) ∈ Coinvariants.ker ρ
  have he : ρ g (ρ h v - v) = (ρ (g * h) v - v) - (ρ g v - v) := by
    rw [map_sub, map_mul, Module.End.mul_apply]
    abel
  rw [he]
  exact (Coinvariants.ker ρ).sub_mem (Coinvariants.sub_mem_ker _ _)
    (Coinvariants.sub_mem_ker _ _)

/-- The binary augmentation module for A₅ is generated by displacements. -/
theorem alternatingFive_core_generated :
    Coinvariants.ker (BinaryPermutation.alternatingCoreRepresentation (Fin 5)) = ⊤ := by
  open BinaryPermutation Equiv in
  let ρ := alternatingCoreRepresentation (Fin 5)
  let C := Coinvariants.ker ρ
  let D := C.map (core (Fin 5)).subtype
  have hD : ∀ g : alternatingGroup (Fin 5), ∀ v ∈ D,
      representation (Fin 5) g.val v ∈ D := by
    intro g v hv
    obtain ⟨u, hu, rfl⟩ := hv
    exact ⟨ρ g u, commutator_stable ρ g hu, rfl⟩
  rcases invariant_le_constants_or_core_le (by decide : 5 ≤ Fintype.card (Fin 5)) D hD
      with h | h
  · let g : alternatingGroup (Fin 5) := ⟨swap 0 1 * swap 1 2, by
      simp [Perm.mem_alternatingGroup]⟩
    let v : core (Fin 5) := ⟨Pi.single 0 1 + Pi.single 3 1, by
      simp [mem_core, Finset.sum_add_distrib, CharTwo.add_self_eq_zero]⟩
    have hv : ρ g v - v ∈ C := Coinvariants.sub_mem_ker g v
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (h ⟨ρ g v - v, hv, rfl⟩)
    have hconst : (ρ g v - v).val 0 = (ρ g v - v).val 4 := by
      exact (congrFun hc.symm 0).trans (congrFun hc 4)
    have hne : (ρ g v - v).val 0 ≠ (ρ g v - v).val 4 := by decide
    exact (hne hconst).elim
  · apply top_unique
    intro v _
    obtain ⟨u, hu, he⟩ := h v.property
    have : u = v := Subtype.ext he
    exact this ▸ hu

/-- A projective, displacement-generated quotient with fixed kernel has an
equivariant section whose image is precisely the source displacement subspace. -/
theorem exists_section_range_eq_coinvariants
    {k G W U : Type*} [Field k] [Group G]
    [AddCommGroup W] [Module k W] [AddCommGroup U] [Module k U]
    {ρ : Representation k G W} {σ : Representation k G U}
    [Module.Projective (MonoidAlgebra k G) ρ.asModule]
    (f : σ.IntertwiningMap ρ) (hf : Function.Surjective f)
    (hk : ∀ u, f u = 0 → ∀ g, σ g u = u)
    (hc : Coinvariants.ker ρ = ⊤) :
    ∃ s : ρ.IntertwiningMap σ,
      (∀ w, f (s w) = w) ∧ s.toLinearMap.range = Coinvariants.ker σ := by
  let F := IntertwiningMap.equivLinearMapAsModule σ ρ f
  obtain ⟨S, hS⟩ := Module.projective_lifting_property F LinearMap.id hf
  let s := (IntertwiningMap.equivLinearMapAsModule ρ σ).symm S
  have hs (w : W) : f (s w) = w := LinearMap.congr_fun hS w
  refine ⟨s, hs, le_antisymm ?_ ?_⟩
  · have he : Coinvariants.ker ρ ≤ (Coinvariants.ker σ).comap s.toLinearMap := by
      apply Submodule.span_le.mpr
      rintro _ ⟨⟨g, w⟩, rfl⟩
      change s (ρ g w - w) ∈ Coinvariants.ker σ
      rw [map_sub, s.isIntertwining]
      exact Coinvariants.sub_mem_ker g (s w)
    rintro _ ⟨w, rfl⟩
    exact he (hc ▸ Submodule.mem_top)
  · let p : σ.IntertwiningMap σ := IntertwiningMap.id σ - s.comp f
    have hp (u : U) : f (p u) = 0 := by
      change f (u - s (f u)) = 0
      rw [map_sub, hs, sub_self]
    have hpc : Coinvariants.ker σ ≤ p.toLinearMap.ker := by
      apply Submodule.span_le.mpr
      rintro _ ⟨⟨g, u⟩, rfl⟩
      change p (σ g u - u) = 0
      rw [map_sub, p.isIntertwining, hk _ (hp u), sub_self]
    intro u hu
    have he : u - s (f u) = 0 := hpc hu
    exact ⟨f u, (sub_eq_zero.mp he).symm⟩


end ProjectiveRadicalSplitting
