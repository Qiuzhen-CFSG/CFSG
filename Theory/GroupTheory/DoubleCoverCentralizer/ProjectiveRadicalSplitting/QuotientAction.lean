module

public import Theory.Representation.ElementaryAbelianAction
public import Mathlib.RepresentationTheory.Coinvariants
public import Theory.GroupAction.Quotient
public import Mathlib.GroupTheory.GroupAction.ConjAct

/-!
# Conjugation on an elementary radical quotient

For a surjection `a : H → A` with kernel `R`, conjugation on an elementary
abelian quotient `R/V` factors through the actual map `a`. We preserve the
formula on quotient representatives. For any such action, the additive image
of the intrinsic subgroup `[R,H]` is precisely the displacement subspace.

These are the action and commutator conventions used in the projective
splitting argument of Aschbacher–Smith I.2.2(5), printed pp.411–412
(PDF pp.422–423), combined manuscript of 1 March 2004.
-/

public section
open Subgroup Representation
open scoped IsMulCommutative commutatorElement
namespace ProjectiveRadicalSplitting

section QuotientAction
variable {H A : Type*} [Group H] [Group A]
variable (R V : Subgroup H) [R.Normal] [(V.subgroupOf R).Normal]

/-- Conjugation on `R/V` descends through the specified quotient map `a`. -/
theorem exists_quotient_action (a : H →* A) (ha : Function.Surjective a)
    (hR : a.ker = R) (hV : V ≤ center H)
    [IsElementaryAbelian 2 (R ⧸ V.subgroupOf R)] :
    ∃ α : A →* MulAut (R ⧸ V.subgroupOf R), ∀ h : H, ∀ r : R,
      α (a h) (QuotientGroup.mk' (V.subgroupOf R) r) =
        QuotientGroup.mk' (V.subgroupOf R) (MulAut.conjNormal h r) := by
  let hInv : IsInvariant (ConjAct H) R (V.subgroupOf R) := ⟨by
    intro h r
    change (r : H) ∈ V ↔ h.ofConjAct * (r : H) * h.ofConjAct⁻¹ ∈ V
    constructor
    · intro hr
      simpa [← mul_assoc, mem_center_iff.mp (hV hr) h.ofConjAct] using hr
    · intro hr
      have hc := mem_center_iff.mp (hV hr) h.ofConjAct⁻¹
      have he : h.ofConjAct * (r : H) * h.ofConjAct⁻¹ = r := by
        have := congrArg (fun x : H => x * h.ofConjAct) hc
        simpa [mul_assoc] using this.symm
      rwa [he] at hr⟩
  let : MulDistribMulAction (ConjAct H) (R ⧸ V.subgroupOf R) :=
    quotientMulDistribMulAction (V.subgroupOf R) hInv
  let β : H →* MulAut (R ⧸ V.subgroupOf R) :=
    (MulDistribMulAction.toMulAut (ConjAct H) _).comp ConjAct.toConjAct.toMonoidHom
  have hβ (h : H) (r : R) :
      β h (QuotientGroup.mk' (V.subgroupOf R) r) =
      QuotientGroup.mk' (V.subgroupOf R) (MulAut.conjNormal h r) := rfl
  have hk : a.ker ≤ β.ker := by
    intro h hh
    rw [hR] at hh
    apply MonoidHom.mem_ker.mpr
    ext w
    obtain ⟨r, rfl⟩ := QuotientGroup.mk'_surjective (V.subgroupOf R) w
    rw [hβ]
    let t : R := ⟨h, hh⟩
    change QuotientGroup.mk' (V.subgroupOf R) (t * r * t⁻¹) = _
    simp [map_mul, mul_comm]
  refine ⟨a.liftOfSurjective ha ⟨β, hk⟩, ?_⟩
  intro h r
  rw [MonoidHom.liftOfRightInverse_comp_apply]
  exact hβ h r

end QuotientAction

/-- The binary representation of an action on an elementary abelian group. -/
@[expose] noncomputable def linearAction {A E : Type*} [Group A] [Group E]
    [IsElementaryAbelian 2 E] (α : A →* MulAut E) :
    Representation (ZMod 2) A (Additive E) :=
  let _ : MulDistribMulAction A E := MulDistribMulAction.compHom E α
  Representation.ofElementaryAbelianAction

/-- The additive action retains the multiplicative action on representatives. -/
theorem linearAction_apply {A E : Type*} [Group A] [Group E]
    [IsElementaryAbelian 2 E] (α : A →* MulAut E) (g : A) (w : Additive E) :
    linearAction α g w = Additive.ofMul (α g w.toMul) := rfl

/-- For an action induced by conjugation, the image of the intrinsic `[R,H]`
is exactly the subspace generated by displacements. -/
theorem commutatorImage_eq_coinvariants
    {H A E : Type*} [Group H] [Group A] [Group E] [IsElementaryAbelian 2 E]
    (R : Subgroup H) [R.Normal]
    (a : H →* A) (ha : Function.Surjective a)
    (q : R →* E) (hq : Function.Surjective q)
    (α : A →* MulAut E)
    (hα : ∀ h : H, ∀ r : R, α (a h) (q r) = q (MulAut.conjNormal h r)) :
    AddSubgroup.toZModSubmodule 2
      (((⁅R, (⊤ : Subgroup H)⁆.subgroupOf R).map q).toAddSubgroup) =
        Coinvariants.ker (linearAction α) := by
  let D : Subgroup H := ⁅R, (⊤ : Subgroup H)⁆
  let C := Coinvariants.ker (linearAction α)
  have hDR : D ≤ R := commutator_le_left _ _
  apply le_antisymm
  · let L := ((C.toAddSubgroup.toSubgroup).comap q).map R.subtype
    have hDL : D ≤ L := by
      apply commutator_le.mpr
      intro r hr h _
      let u : R := ⟨r, hr⟩
      have he : ⁅r,h⁆ ∈ R := hDR (commutator_mem_commutator hr (mem_top _))
      refine ⟨⟨⁅r,h⁆, he⟩, ?_, rfl⟩
      change Additive.ofMul (q ⟨⁅r,h⁆, he⟩) ∈ C
      have heq : (⟨⁅r,h⁆, he⟩ : R) = u * MulAut.conjNormal h u⁻¹ := by
        apply Subtype.ext
        simp [commutatorElement_def, u, mul_assoc]
      rw [heq, map_mul, ← hα]
      change Additive.ofMul (q u) +
        linearAction α (a h) (Additive.ofMul (q u⁻¹)) ∈ C
      have hh := Coinvariants.sub_mem_ker (ρ := linearAction α) (a h)
        (Additive.ofMul (q u⁻¹))
      convert hh using 1
      simp [map_inv, sub_eq_add_neg, add_comm]
    intro w hw
    obtain ⟨r, hr, he⟩ := (show w.toMul ∈ (D.subgroupOf R).map q from hw)
    obtain ⟨u, hu, hur⟩ := hDL hr
    have hur' : u = r := Subtype.ext hur
    subst u
    change Additive.ofMul (q r) ∈ C at hu
    simpa [C, he] using hu
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨g, w⟩, rfl⟩
    obtain ⟨h, rfl⟩ := ha g
    obtain ⟨r, hr⟩ := hq w.toMul
    have hwr : w = Additive.ofMul (q r) := congrArg Additive.ofMul hr.symm
    rw [hwr]
    have he : ⁅h,(r : H)⁆ ∈ D := by
      change ⁅h,(r : H)⁆ ∈ ⁅R, (⊤ : Subgroup H)⁆
      rw [commutator_comm]
      exact commutator_mem_commutator (mem_top h) r.property
    let u : R := ⟨⁅h,(r : H)⁆, hDR he⟩
    refine (show (linearAction α (a h) (Additive.ofMul (q r)) -
      Additive.ofMul (q r)).toMul ∈ (D.subgroupOf R).map q from ?_)
    refine ⟨u, he, ?_⟩
    have heu : u = MulAut.conjNormal h r * r⁻¹ := by
      apply Subtype.ext
      simp [u, commutatorElement_def, mul_assoc]
    rw [heu, map_mul, map_inv, ← hα]
    simp [linearAction_apply, sub_eq_add_neg]


end ProjectiveRadicalSplitting
