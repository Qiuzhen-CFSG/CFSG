module
public import Theory.GroupTheory.IndexTwoConjugateCore
public import Theory.GroupTheory.SubgroupConjugation

/-!
# A conjugate core determined by two conjugates

Let F be generated by D and an element t. Suppose [N,D] lies in the
intersection C of all F-conjugates of N, while t² normalizes N. Then
C=N intersect N^t. If F normalizes a finite group K containing N with
index two, and t does not normalize N, the index of C in K is four.

The subgroup N intersect N^t contains C and is normalized by D through
the commutator bound. The square condition makes t interchange its two
factors, hence normalize it. It is therefore F-invariant and lies in
every F-conjugate of N. The index bound follows from the intersection
inequality, and strict containment in N forces the exact index four.

This is the elementary hyperplane calculation for the actual central
quotient Q_next/Qstar in Stellmacher (9.4), printed pp.51–52. No action
faithfulness or quotient model is assumed.
-/

namespace Subgroup
open scoped commutatorElement
universe u

public theorem conjugate_core_eq_inf_of_centralizing_generators
    {G : Type u} [Group G] (D N : Subgroup G) (actor : G)
    (hactor2 : actor ^ 2 ∈ Subgroup.normalizer N)
    (hcomm : ⁅N,D⁆ ≤
      ⨅ mover : (D ⊔ Subgroup.zpowers actor : Subgroup G), N.conjBy (mover : G)) :
    (⨅ mover : (D ⊔ Subgroup.zpowers actor : Subgroup G), N.conjBy (mover : G)) =
      N ⊓ N.conjBy actor := by
  let F := D ⊔ Subgroup.zpowers actor
  let C := ⨅ mover : F, N.conjBy (mover : G)
  let J := N ⊓ N.conjBy actor
  have hCN : C ≤ N := by
    have h := iInf_le (fun mover : F => N.conjBy (mover : G)) (1 : F)
    simpa only [OneMemClass.coe_one, Subgroup.conjBy_one] using h
  have hCa : C ≤ N.conjBy actor :=
    iInf_le (fun mover : F => N.conjBy (mover : G))
      ⟨actor, Subgroup.mem_sup_right (Subgroup.mem_zpowers actor)⟩
  have hCJ : C ≤ J := le_inf hCN hCa
  have hDJ : D ≤ Subgroup.normalizer J := by
    apply Subgroup.le_normalizer_iff_commutator_le_left.mpr
    exact ((Subgroup.commutator_mono inf_le_left le_rfl).trans hcomm).trans hCJ
  have haJ : actor ∈ Subgroup.normalizer J := by
    apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
    change J.conjBy actor = J
    change (N ⊓ N.conjBy actor).map (MulAut.conj actor).toMonoidHom = _
    rw [Subgroup.map_inf _ _ _ (MulAut.conj actor).injective]
    change N.conjBy actor ⊓ (N.conjBy actor).conjBy actor = N ⊓ N.conjBy actor
    rw [Subgroup.conjBy_conjBy, ← pow_two]
    have hnorm := Subgroup.mem_normalizer_iff_map_conj_eq.mp hactor2
    change N.conjBy (actor ^ 2) = N at hnorm
    rw [hnorm, inf_comm]
  have hFJ : F ≤ Subgroup.normalizer J := sup_le hDJ (Subgroup.zpowers_le.mpr haJ)
  have hJC : J ≤ C := by
    apply le_iInf
    intro mover point hpoint
    apply Subgroup.mem_map_equiv.mpr
    have hp := (Subgroup.mem_normalizer_iff.mp (hFJ (F.inv_mem mover.property)) point).mp hpoint
    have hn : (mover : G)⁻¹ * point * ((mover : G)⁻¹)⁻¹ ∈ N := hp.1
    change (mover : G)⁻¹ * point * (mover : G) ∈ N
    simpa only [inv_inv] using hn
  exact le_antisymm hCJ hJC

public theorem conjugate_core_relIndex_four
    {G : Type u} [Group G] [Finite G] (D K N : Subgroup G) (actor : G)
    (hFK : D ⊔ Subgroup.zpowers actor ≤ Subgroup.normalizer K)
    (hNK : N ≤ K) (hindex : N.relIndex K = 2)
    (hactor2 : actor ^ 2 ∈ Subgroup.normalizer N)
    (hactorN : actor ∉ Subgroup.normalizer N)
    (hcomm : ⁅N,D⁆ ≤
      ⨅ mover : (D ⊔ Subgroup.zpowers actor : Subgroup G), N.conjBy (mover : G)) :
    (⨅ mover : (D ⊔ Subgroup.zpowers actor : Subgroup G), N.conjBy (mover : G)).relIndex K = 4 := by
  let C := ⨅ mover : (D ⊔ Subgroup.zpowers actor : Subgroup G), N.conjBy (mover : G)
  have hC : C = N ⊓ N.conjBy actor :=
    conjugate_core_eq_inf_of_centralizing_generators D N actor hactor2 hcomm
  have hnormK : K.conjBy actor = K :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp
      (hFK (Subgroup.mem_sup_right (Subgroup.mem_zpowers actor)))
  have hNK' : N.conjBy actor ≤ K := by
    have hh := Subgroup.map_mono (f := (MulAut.conj actor).toMonoidHom) hNK
    change N.conjBy actor ≤ K.conjBy actor at hh
    exact hh.trans_eq hnormK
  have hindex' : (N.conjBy actor).relIndex K = 2 := by
    rw [← hnormK]
    change (N.map (MulAut.conj actor).toMonoidHom).relIndex
      (K.map (MulAut.conj actor).toMonoidHom) = 2
    rw [Subgroup.relIndex_map_map_of_injective _ _ (MulAut.conj actor).injective]
    exact hindex
  have hbound : C.relIndex K ≤ 4 := by
    rw [hC]
    have hh := Subgroup.relIndex_inf_le (H := N) (K := N.conjBy actor) (L := K)
    simpa only [hindex,hindex',Nat.reduceMul] using hh
  have htower := Subgroup.relIndex_mul_relIndex C N K
    (hC.le.trans inf_le_left) hNK
  rw [hindex] at htower
  have hproper : C ≠ N := by
    intro heq
    have hle : N ≤ N.conjBy actor := heq.symm.le.trans (hC.le.trans inf_le_right)
    have hcard : Nat.card (N.conjBy actor) = Nat.card N :=
      Subgroup.card_map_of_injective (MulAut.conj actor).injective
    have hn : N.conjBy actor = N :=
      (Subgroup.eq_of_le_of_card_ge hle hcard.le).symm
    exact hactorN (Subgroup.mem_normalizer_iff_map_conj_eq.mpr hn)
  have hne : C.relIndex N ≠ 1 := by
    intro hone
    exact hproper (le_antisymm (hC.le.trans inf_le_left) (Subgroup.relIndex_eq_one.mp hone))
  have hpos : 0 < C.relIndex N := Nat.pos_of_ne_zero Subgroup.index_ne_zero_of_finite
  change C.relIndex K = 4
  omega

end Subgroup
