module

public import Theory.GroupTheory.ElementaryCommutingConjugation
public import Theory.GroupAction.AbelianCoprimeFixedGeneration
public import Theory.GroupAction.OddInvariantSylow
public import Theory.GroupAction.SubgroupConjugation

/-!
# Odd subgroups preserving binary commuting components

Let A be an elementary binary subgroup of order at least eight. Every
odd-order subgroup normalized by A preserves A's elementary commuting
component. No solvability assumption on the odd subgroup is needed.

Choose an A-invariant Sylow subgroup for each odd prime. Coprime fixed-point
generation expresses that Sylow subgroup as generated by fixed groups of
actor subgroups with cyclic quotient. These actor subgroups have order at
least four. Each fixed group therefore centralizes a vertex connected to A.
The component stabilizer contains all these Sylow subgroups and hence the
whole odd subgroup.

This combines the coprime fixed-generation argument of Feit--Thompson
background Proposition 1.16(b) with GLS2, Section 22, Lemma 22.2
(`refs/KGroup/GLS2/ChapterF.tex`). It supplies the odd-normal-subgroup step
in centralizer transport without assuming global graph connectivity.
-/

namespace Subgroup
open scoped IsMulCommutative

private theorem cyclic_quotient_card_lower
    {A : Type*} [Group A] [Finite A] [IsElementaryAbelian 2 A]
    (hA : 8 ≤ Nat.card A) (Y : Subgroup A) (hY : IsCyclic (A ⧸ Y)) :
    4 ≤ Nat.card Y := by
  have hdiv : Nat.card (A ⧸ Y) ∣ 2 := by
    rw [← hY.exponent_eq_card]
    exact (Group.exponent_quotient_dvd Y).trans
      (IsElementaryAbelian.exponent_dvd_p 2 A)
  have hbound : Nat.card (A ⧸ Y) ≤ 2 := Nat.le_of_dvd (by decide) hdiv
  have hprod := card_eq_card_quotient_mul_card_subgroup Y
  nlinarith

/-- Every odd subgroup normalized by a rank-three elementary binary actor
preserves its actual commuting component. -/
public theorem odd_le_elementaryCommutingStabilizer_of_normalized
    {G : Type*} [Group G] [Finite G]
    (A N : Subgroup G) [IsElementaryAbelian 2 A]
    (hA : 8 ≤ Nat.card A) (hN : Odd (Nat.card N))
    (hAN : A ≤ normalizer (N : Set G)) :
    N ≤ elementaryCommutingStabilizer 2 A (by omega) := by
  classical
  let : MulDistribMulAction A N := conjMulDistribMulActionOfLeNormalizer A N hAN
  let M := elementaryCommutingStabilizer 2 A (by omega)
  let J := M.subgroupOf N
  have hJ : J = ⊤ := by
    apply index_eq_one.mp
    by_contra hne
    obtain ⟨q, hq, hqJ⟩ := Nat.exists_prime_and_dvd hne
    let : Fact q.Prime := ⟨hq⟩
    obtain ⟨T, _, hTI⟩ := exists_invariant_sylow_le_of_isPGroup (p := q)
      (IsElementaryAbelian.isPGroup 2 A) hN (⊥ : Subgroup N) IsPGroup.of_bot
      (by
        constructor
        intro a x
        change x = 1 ↔ a • x = 1
        constructor
        · intro hx
          rw [hx, smul_one]
        · intro hx
          simpa only [inv_smul_smul, smul_one] using congrArg (a⁻¹ • ·) hx)
    let : IsInvariant A N (T : Subgroup N) := hTI
    let : Fact (IsPGroup q T) := ⟨T.isPGroup'⟩
    have hq2 : q ≠ 2 := by
      intro heq
      exact hN.not_two_dvd_nat (heq ▸ hqJ.trans (index_dvd_card J))
    have hcop : Nat.Coprime (Nat.card A) q := by
      obtain ⟨n, hn⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_card_eq
      rw [hn]
      exact ((Nat.coprime_primes Nat.prime_two hq).mpr hq2.symm).pow_left n
    have hgen := iSup_fixedPoints_cyclicQuot_eq_top_of_coprime_abelian_pGroup
      (G := T) (A := A) (q := q) hcop
    have htop : (⊤ : Subgroup T) ≤ J.subgroupOf (T : Subgroup N) := by
      rw [← hgen]
      refine iSup₂_le fun Y hY x hx => ?_
      let : IsElementaryAbelian 2 Y := {
        exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun y => by
          apply Subtype.ext
          exact Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
            (IsElementaryAbelian.exponent_dvd_p 2 A) y) }
      let B := Y.map A.subtype
      let : IsElementaryAbelian 2 B := IsElementaryAbelian.map_subtype
      have hBA : B ≤ A := map_subtype_le _
      have hB : 4 ≤ Nat.card B := by
        simpa only [B, card_map_of_injective A.subtype_injective] using
          cyclic_quotient_card_lower hA Y hY
      have hAB : ElementaryCommutingConnected 2 A B :=
        ElementaryCommutingAdjacent.connected ⟨inferInstance, by omega,
          inferInstance, hB, fun a ha b hb =>
            congrArg Subtype.val (mul_comm (⟨b, hBA hb⟩ : A) ⟨a, ha⟩)⟩
      have hxC : ((x : N) : G) ∈ centralizer (B : Set G) := by
        rintro b ⟨y, hy, rfl⟩
        have hfix := congrArg (fun t : T => ((t : N) : G)) (hx (⟨y, hy⟩ : Y))
        change (y : G) * (x : G) * (y : G)⁻¹ = (x : G) at hfix
        exact mul_inv_eq_iff_eq_mul.mp hfix
      exact normalizer_le_elementaryCommutingStabilizer A B (by omega) hAB
        (centralizer_le_normalizer _ hxC)
    have hTJ : (T : Subgroup N) ≤ J := fun x hx => htop (mem_top (⟨x, hx⟩ : T))
    exact T.not_dvd_index (hqJ.trans (index_dvd_of_le hTJ))
  intro x hx
  exact (show (⟨x, hx⟩ : N) ∈ J from hJ ▸ mem_top _)

/-- Elementwise form of odd-subgroup component control. -/
public theorem elementaryCommutingConnected_conj_of_mem_normalized_odd
    {G : Type*} [Group G] [Finite G]
    (A N : Subgroup G) [IsElementaryAbelian 2 A]
    (hA : 8 ≤ Nat.card A) (hN : Odd (Nat.card N))
    (hAN : A ≤ normalizer (N : Set G)) {g : G} (hg : g ∈ N) :
    ElementaryCommutingConnected 2 A (A.map (MulAut.conj g).toMonoidHom) :=
  odd_le_elementaryCommutingStabilizer_of_normalized A N hA hN hAN hg

end Subgroup
