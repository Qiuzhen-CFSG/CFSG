module

public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# Noncentrality of a subgroup generated by its commutators

If a nontrivial subgroup `V` satisfies `V = [V, M]`, it cannot centralize an
overgroup of `M`. Its image also remains nontrivial under any homomorphism whose
kernel centralizes `M`. The proofs reduce centrality to a trivial commutator.

These elementary observations are used in Aschbacher–Smith, *The Classification
of Quasithin Groups*, §C.3, especially C.3.4 and the quotient reduction on p. 151.
-/

namespace Subgroup

variable {G D : Type*} [Group G] [Group D] {V M K : Subgroup G}

/-- A nontrivial subgroup equal to its commutator with `M` cannot centralize an
overgroup of `M`. -/
public theorem not_le_centralizer_of_eq_commutator
    (hne : V ≠ ⊥) (hfull : V = ⁅V, M⁆) (hMK : M ≤ K) :
    ¬ V ≤ centralizer (K : Set G) := by
  intro hcentral
  apply hne
  calc
    V = ⁅V, M⁆ := hfull
    _ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr
      (hcentral.trans (centralizer_le hMK))

/-- Killing a nontrivial full commutator subgroup requires a kernel that does
not centralize its acting subgroup. -/
public theorem map_ne_bot_of_eq_commutator
    (hne : V ≠ ⊥) (hfull : V = ⁅V, M⁆)
    (f : G →* D) (hker : f.ker ≤ centralizer (M : Set G)) :
    V.map f ≠ ⊥ := by
  intro hmap
  exact not_le_centralizer_of_eq_commutator hne hfull le_rfl
    (((map_eq_bot_iff V).mp hmap).trans hker)

/-- A homomorphic image under a kernel centralizing the actors is still a
nontrivial subgroup equal to its full commutator with the image of the actors. -/
public theorem map_ne_bot_and_eq_commutator
    (hne : V ≠ ⊥) (hfull : V = ⁅V, M⁆)
    (f : G →* D) (hker : f.ker ≤ centralizer (M : Set G)) :
    V.map f ≠ ⊥ ∧ V.map f = ⁅V.map f, M.map f⁆ := by
  refine ⟨map_ne_bot_of_eq_commutator hne hfull f hker, ?_⟩
  calc
    V.map f = (⁅V, M⁆).map f := congrArg (fun S : Subgroup G => S.map f) hfull
    _ = ⁅V.map f, M.map f⁆ := map_commutator V M f

end Subgroup
