module

public import Theory.GroupTheory.Commutator.NormalClosure

/-!
# Fixed quotients and normal generation

Suppose `V` is normally generated by `W`, and the normal closure of `F`
together with `E` generates the ambient group. If `F` centralizes `V`
modulo a normal subgroup `U`, and `E` centralizes `W` modulo `U`, then
the whole group centralizes `V` modulo `U`.

First extend the commutator bound for `F` to its normal closure, using
normality of `V`. Write every ambient element as a product from that
closure and `E`. The commutator product formula gives the bound for
`W`, which then extends to its normal closure `V`.

Source application: Aschbacher–Smith, *The Classification of Quasithin
Groups*, combined manuscript (1 March 2004), Lemma 13.8.9(1), printed
p.949. There the ambient group for this lemma is the vertex stabilizer
`Gγ`, so normality is required only inside that stabilizer.
-/

namespace Subgroup

open scoped commutatorElement

/-- A normally generating seed fixed by a supplement makes the whole
normally generated section fixed, once the other generator acts trivially. -/
public theorem commutator_le_of_normal_generation
    {G : Type*} [Group G] (F E W V U : Subgroup G) [U.Normal]
    (hV : V = normalClosure (W : Set G))
    (hgen : normalClosure (F : Set G) ⊔ E = ⊤)
    (hFV : ⁅F, V⁆ ≤ U) (hEW : ⁅E, W⁆ ≤ U) :
    ⁅(⊤ : Subgroup G), V⁆ ≤ U := by
  have hWV : W ≤ V := hV ▸ le_normalClosure
  let : V.Normal := hV ▸ normalClosure_normal
  have hVN : ⁅V, normalClosure (F : Set G)⁆ ≤ U :=
    commutator_normalClosure_le_of_normal V F U (by rwa [commutator_comm])
  have hWT : ⁅W, (⊤ : Subgroup G)⁆ ≤ U := by
    apply commutator_le.mpr
    intro w hw g _
    have hg : g ∈ normalClosure (F : Set G) ⊔ E := hgen ▸ mem_top g
    obtain ⟨n, hn, e, he, rfl⟩ := mem_sup_of_normal_left.mp hg
    rw [commutatorElement_mul_right_eq_mul_conj]
    have hWE : ⁅W, E⁆ ≤ U := by rwa [commutator_comm]
    simpa only [mul_assoc] using
      U.mul_mem (hVN (commutator_mem_commutator (hWV hw) hn))
        ((inferInstance : U.Normal).conj_mem _
          (hWE (commutator_mem_commutator hw he)) n)
  rw [hV]
  exact commutator_normalClosure_le_of_normal ⊤ W U (by rwa [commutator_comm])

end Subgroup
