module
public import Theory.GroupTheory.InvolutionCentralizerControl

/-!
# Factoring a normalizer using transitivity on involution points

If K normalizes A and is transitive on A minus the identity, then the
normalizer of A is generated by K and the stabilizer of any subgroup of A
of order two. A transporter corrects an arbitrary normalizer element to
fix the unique nonidentity point. No normality of K is assumed.

Source application: Aschbacher–Smith 14.3.19(6)–(7), printed p.997.
-/

@[expose] public noncomputable section
namespace Subgroup
variable {G : Type*} [Group G]

/-- Transitivity corrects every normalizer element into the original point stabilizer. -/
theorem normalizer_eq_sup_point_normalizer_of_transitive
    (A K P : Subgroup G) (hKA : K ≤ normalizer (A:Set G))
    (hPA : P ≤ A) (hP : Nat.card P = 2)
    (ht : ∀ a b : A, a ≠ 1 → b ≠ 1 → ∃ k ∈ K, k*(a:G)*k⁻¹ = b) :
    normalizer (A:Set G) = K ⊔ (normalizer (P:Set G) ⊓ normalizer (A:Set G)) := by
  obtain ⟨z,hz,hu⟩ := (Nat.card_eq_two_iff' (1:P)).mp hP
  have hz1 : (z:G) ≠ 1 := fun hh => hz (Subtype.ext hh)
  apply le_antisymm _ (sup_le hKA inf_le_right)
  intro g hg
  let a : A := ⟨g*(z:G)*g⁻¹,(mem_normalizer_iff.mp hg _).mp (hPA z.property)⟩
  let b : A := ⟨z,hPA z.property⟩
  have ha : a ≠ 1 := by
    intro hh
    exact hz1 ((MulAut.conj g).injective ((congrArg Subtype.val hh).trans
      (map_one (MulAut.conj g)).symm))
  have hb : b ≠ 1 := fun hh => hz1 (congrArg Subtype.val hh)
  obtain ⟨k,hk,hfix⟩ := ht a b ha hb
  have hkg : k*g ∈ normalizer (P:Set G) := by
    apply centralizer_le_normalizer (P:Set G)
    intro x hx
    by_cases hx1 : x=1
    · simp [hx1]
    have hxz : x=(z:G) := congrArg Subtype.val (hu ⟨x,hx⟩ (fun hh => hx1 (congrArg Subtype.val hh)))
    rw [hxz]
    have hf : (k*g)*(z:G)*(k*g)⁻¹ = z := by
      simpa only [a,b,mul_inv_rev,mul_assoc] using hfix
    exact (mul_inv_eq_iff_eq_mul.mp hf).symm
  have hm : k*g ∈ K ⊔ (normalizer (P:Set G) ⊓ normalizer (A:Set G)) :=
    mem_sup_right ⟨hkg,(normalizer (A:Set G)).mul_mem (hKA hk) hg⟩
  have hi : k⁻¹∈K ⊔ (normalizer (P:Set G) ⊓ normalizer (A:Set G)) :=
    mem_sup_left (K.inv_mem hk)
  simpa only [inv_mul_cancel_left] using (K ⊔ (normalizer (P:Set G) ⊓ normalizer (A:Set G))).mul_mem hi hm
end Subgroup
