module

public import Theory.GroupTheory.GeneralizedFitting.RelativeComponent

/-!
# The normalizer of a commuting pair of quasisimple subgroups

Two commuting quasisimple subgroups are components of their join. Every
component of that join is one of the two factors, so its normalizer preserves
their union. A centerless factor meets the other trivially; in a simple ambient
group this forces the product normalizer to be proper.

The proof uses the relative component dichotomy, keeping all normality inside
the product. Source: the component calculus of GLS, volume 2, Chapter 1;
application in Aschbacher--Smith, combined manuscript of 1 March 2004,
proof of Lemma 2.5.21, printed pp.566--567.
-/

public section

open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G]

/-- A commuting quasisimple factor is a component of the actual join. -/
theorem componentIn_sup_of_commuting {K L : Subgroup G}
    [IsQuasisimple K] (hc : ⁅K, L⁆ = ⊥) : IsComponentIn K (K ⊔ L) := by
  have hn : K ⊔ L ≤ normalizer (K : Set G) := by
    apply sup_le K.le_normalizer
    apply le_trans _ (centralizer_le_normalizer (K : Set G))
    apply commutator_eq_bot_iff_le_centralizer.mp
    rwa [commutator_comm]
  exact ⟨le_sup_left,
    ((normal_subgroupOf_iff_le_normalizer le_sup_left).mpr hn).isSubnormal,
    IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe le_sup_left).symm⟩

/-- A group generated by two components has no third component. -/
theorem IsComponentIn.eq_left_or_right_of_pair {K L D : Subgroup G}
    (hK : IsComponentIn K (K ⊔ L)) (hL : IsComponentIn L (K ⊔ L))
    (hD : IsComponentIn D (K ⊔ L)) : D = K ∨ D = L := by
  by_cases hk : D = K
  · exact Or.inl hk
  by_cases hl : D = L
  · exact Or.inr hl
  have hkd := hK.commutator_eq_bot_of_ne hD (Ne.symm hk)
  have hld := hL.commutator_eq_bot_of_ne hD (Ne.symm hl)
  have hc : ⁅K ⊔ L, D⁆ = ⊥ := by
    rw [commutator_eq_bot_iff_le_centralizer] at hkd hld ⊢
    exact sup_le hkd hld
  let := hD.quasisimple
  exact (hD.ne_bot (le_bot_iff.mp (calc
    D = ⁅D, D⁆ := (commutator_eq_self (H := D)).symm
    _ ≤ ⁅K ⊔ L, D⁆ := commutator_mono hD.1 le_rfl
    _ = ⊥ := hc))).elim

/-- The product normalizer sends the first component to one of the two factors. -/
theorem conjugate_component_eq_of_mem_pair_normalizer {K L : Subgroup G}
    [IsQuasisimple K] [IsQuasisimple L] (hc : ⁅K, L⁆ = ⊥)
    {g : G} (hg : g ∈ normalizer ((K ⊔ L : Subgroup G) : Set G)) :
    K.map (MulAut.conj g).toMonoidHom = K ∨
      K.map (MulAut.conj g).toMonoidHom = L := by
  have hK := componentIn_sup_of_commuting hc
  have hL : IsComponentIn L (K ⊔ L) := by
    rw [sup_comm]
    apply componentIn_sup_of_commuting
    rwa [commutator_comm]
  have hD := hK.map (MulAut.conj g)
  have he : (K ⊔ L).map (MulAut.conj g).toMonoidHom = K ⊔ L :=
    mem_normalizer_iff_map_conj_eq.mp hg
  rw [he] at hD
  exact hK.eq_left_or_right_of_pair hL hD

/-- A centerless subgroup has trivial intersection with any commuting subgroup. -/
theorem disjoint_of_commuting_of_center_eq_bot {K L : Subgroup G}
    (hc : ⁅K, L⁆ = ⊥) (hz : center K = ⊥) : Disjoint K L := by
  apply disjoint_iff.mpr
  apply le_bot_iff.mp
  intro x hx
  have hxz : (⟨x, hx.1⟩ : K) ∈ center K := by
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    exact (mem_centralizer_iff.mp
      (commutator_eq_bot_iff_le_centralizer.mp hc y.property) x hx.2).symm
  rw [hz, mem_bot] at hxz
  exact congrArg Subtype.val hxz

/-- The product normalizer preserves the union of its two quasisimple factors. -/
theorem pair_normalizer_preserves_union {K L : Subgroup G}
    [IsQuasisimple K] [IsQuasisimple L] (hc : ⁅K, L⁆ = ⊥)
    {g a : G} (hg : g ∈ normalizer ((K ⊔ L : Subgroup G) : Set G))
    (ha : a ∈ (K : Set G) ∪ L) : g * a * g⁻¹ ∈ (K : Set G) ∪ L := by
  rcases ha with ha | ha
  · have hm := mem_map_of_mem (MulAut.conj g).toMonoidHom ha
    rcases conjugate_component_eq_of_mem_pair_normalizer hc hg with he | he
    · exact Or.inl (he ▸ hm)
    · exact Or.inr (he ▸ hm)
  · have hm := mem_map_of_mem (MulAut.conj g).toMonoidHom ha
    have hc' : ⁅L, K⁆ = ⊥ := by rwa [commutator_comm]
    have hg' : g ∈ normalizer ((L ⊔ K : Subgroup G) : Set G) := by
      rwa [sup_comm]
    rcases conjugate_component_eq_of_mem_pair_normalizer hc' hg' with he | he
    · exact Or.inr (he ▸ hm)
    · exact Or.inl (he ▸ hm)

/-- The commuting product has proper normalizer in a simple ambient group. -/
theorem pair_normalizer_ne_top [IsSimpleGroup G] {K L : Subgroup G}
    [IsQuasisimple K] [IsQuasisimple L]
    (hc : ⁅K, L⁆ = ⊥) (hz : center K = ⊥) :
    normalizer ((K ⊔ L : Subgroup G) : Set G) ≠ ⊤ := by
  intro ht
  have hK := componentIn_sup_of_commuting hc
  have hL : IsComponentIn L (L ⊔ K) :=
    componentIn_sup_of_commuting (by rwa [commutator_comm])
  have hn : (K ⊔ L).Normal := normalizer_eq_top_iff.mp ht
  have hsup : K ⊔ L = ⊤ := by
    rcases hn.eq_bot_or_eq_top with hb | ht
    · exact (hK.ne_bot (bot_unique (hb ▸ le_sup_left))).elim
    · exact ht
  have hnK : K.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hsup]
    apply sup_le K.le_normalizer
    apply le_trans _ (centralizer_le_normalizer (K : Set G))
    apply commutator_eq_bot_iff_le_centralizer.mp
    rwa [commutator_comm]
  rcases hnK.eq_bot_or_eq_top with hb | ht
  · exact hK.ne_bot hb
  · have hd := disjoint_of_commuting_of_center_eq_bot hc hz
    exact hL.ne_bot (by simpa only [ht, top_inf_eq] using disjoint_iff.mp hd)
end Theory.GroupTheory

end
