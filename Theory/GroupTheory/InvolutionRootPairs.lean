module
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Tactic.Group

/-!
# Involution factorizations of a root stay in its involution centralizer

Let t be an involution in a finite group and suppose t belongs to the cyclic
subgroup generated by a. Every ordered factorization a=xy into two involutions
lies in C_G(t). Consequently the ambient and centralizer pair counts are equal,
with exactly the same two elements and the same ambient product a.

Each factor x or y inverts a by conjugation. It therefore inverts every cyclic
power of a, including t; inversion fixes t because its order is two. Thus both
factors centralize t. The proof uses the inverse inclusion/restriction maps on
the actual pair subtypes to obtain the cardinality identity. It requires no
fusion, class table, or character hypothesis.

Source: W. J. Wong, On finite groups whose 2-Sylow subgroups have cyclic
subgroups of index2, J. Austral. Math. Soc.4 (1964),90–112, Lemma4(iii), article98.
This is the elementary support reduction behind the involution-pair character
formula used there; the character expansion is a separate result.
DOI:10.1017/S1446788700022771.
-/

private theorem centralizes_root_of_inverts
    {G : Type*} [Group G] (t a g : G) (ht : t ^ 2 = 1)
    (hroot : t ∈ Subgroup.zpowers a) (hga : g * a * g⁻¹ = a⁻¹) :
    g ∈ Subgroup.centralizer ({t} : Set G) := by
  have htinv : t⁻¹ = t := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using ht)
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hroot
  let e := MulAut.conj g
  have hea : e a = a⁻¹ := hga
  have het : e t = t⁻¹ := by
    rw [← hn, map_zpow, hea, inv_zpow]
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  have hfix : g * t * g⁻¹ = t := het.trans htinv
  exact (mul_inv_eq_iff_eq_mul).mp hfix

private theorem pair_mem_centralizer
    {G : Type*} [Group G] (t a x y : G) (ht : orderOf t = 2)
    (hroot : t ∈ Subgroup.zpowers a) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (hxy : x * y = a) :
    x ∈ Subgroup.centralizer ({t} : Set G) ∧
      y ∈ Subgroup.centralizer ({t} : Set G) := by
  have ht2 : t ^ 2 = 1 := ht ▸ pow_orderOf_eq_one t
  have hx2 : x * x = 1 := by simpa only [hx, pow_two] using pow_orderOf_eq_one x
  have hy2 : y * y = 1 := by simpa only [hy, pow_two] using pow_orderOf_eq_one y
  have hxi : x⁻¹ = x := inv_eq_of_mul_eq_one_left hx2
  have hyi : y⁻¹ = y := inv_eq_of_mul_eq_one_left hy2
  constructor
  · apply centralizes_root_of_inverts t a x ht2 hroot
    rw [← hxy, mul_inv_rev, hxi, hyi]
    simp only [← mul_assoc, hx2, one_mul]
  · apply centralizes_root_of_inverts t a y ht2 hroot
    rw [← hxy, mul_inv_rev, hxi, hyi]
    simp only [mul_assoc, hy2, mul_one]

/-- Restricting the two actual factors gives the same pair count in C_G(t). -/
public theorem involution_pair_card_eq_centralizer_of_root
    {G : Type*} [Group G] [Finite G] (t a : G) (ht : orderOf t = 2)
    (hroot : t ∈ Subgroup.zpowers a) :
    Nat.card {p : G × G // orderOf p.1 = 2 ∧ orderOf p.2 = 2 ∧ p.1 * p.2 = a} =
      Nat.card {p : Subgroup.centralizer ({t} : Set G) × Subgroup.centralizer ({t} : Set G) //
        orderOf p.1 = 2 ∧ orderOf p.2 = 2 ∧ (p.1 : G) * (p.2 : G) = a} := by
  apply Nat.card_congr
  exact {
    toFun := fun p => by
      have hm := pair_mem_centralizer t a p.val.1 p.val.2 ht hroot
        p.property.1 p.property.2.1 p.property.2.2
      exact ⟨(⟨p.val.1, hm.1⟩, ⟨p.val.2, hm.2⟩),
        (Subgroup.orderOf_coe _).symm.trans p.property.1,
        (Subgroup.orderOf_coe _).symm.trans p.property.2.1, p.property.2.2⟩
    invFun := fun p => ⟨(p.val.1.val, p.val.2.val),
      (Subgroup.orderOf_coe _).trans p.property.1,
      (Subgroup.orderOf_coe _).trans p.property.2.1, p.property.2.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }
