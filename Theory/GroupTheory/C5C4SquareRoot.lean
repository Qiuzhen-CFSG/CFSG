module

public import Theory.GroupTheory.C5C4ElementaryTwoSubgroup
public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.Index

/-!
# Order-two subgroups in C₅ ⋊ C₄ are generated by squares

Every subgroup of order two in C₅ ⋊ C₄ lies in a cyclic Sylow subgroup
of order four. A generator of that Sylow subgroup has its square in the
original subgroup, since the latter has index two. Comparing orders
identifies the original subgroup with the square's cyclic subgroup.
The action of C₄ on C₅ need not be faithful.
-/

namespace SemidirectProduct

/-- Every subgroup of order two is generated by the square of an element
of order four. -/
public theorem two_subgroup_eq_zpowers_square
    (φ : Multiplicative (ZMod 4) →* MulAut (Multiplicative (ZMod 5)))
    (A : Subgroup (SemidirectProduct (Multiplicative (ZMod 5))
      (Multiplicative (ZMod 4)) φ)) (hA : Nat.card A = 2) :
    ∃ g, orderOf g = 4 ∧ A = Subgroup.zpowers (g ^ 2) := by
  let M := SemidirectProduct (Multiplicative (ZMod 5)) (Multiplicative (ZMod 4)) φ
  let : Finite M := Finite.of_equiv
    (Multiplicative (ZMod 5) × Multiplicative (ZMod 4)) equivProd.symm
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hp : IsPGroup 2 A := IsPGroup.of_card (n := 1) (by simpa using hA)
  obtain ⟨P, hAP⟩ := hp.exists_le_sylow
  have hM : Nat.card M = 20 := by rw [SemidirectProduct.card]; norm_num
  have hP : Nat.card P = 4 := by rw [P.card_eq_multiplicity, hM]; decide +kernel
  let : IsCyclic P := (two_subgroup_isCyclic_card_dvd_four φ P P.isPGroup').1
  obtain ⟨g, hg⟩ := isCyclic_iff_exists_orderOf_eq_natCard.mp (inferInstance : IsCyclic P)
  have hg4 : orderOf (g : M) = 4 := by simpa only [orderOf_submonoid] using hg.trans hP
  have hAc : Nat.card (A.subgroupOf P) = 2 :=
    (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAP).toEquiv).trans hA
  have hAi : (A.subgroupOf P).index = 2 := by
    have hh := (A.subgroupOf P).card_mul_index
    rw [hAc, hP] at hh
    omega
  have hsq : (g : M) ^ 2 ∈ A := (A.subgroupOf P).sq_mem_of_index_two hAi g
  refine ⟨g, hg4, (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hsq) ?_).symm⟩
  rw [Nat.card_zpowers, orderOf_pow, hg4, hA]
  decide

end SemidirectProduct
