module

public import Theory.GroupTheory.FourCenterSylowPromotion
public import Theory.GroupTheory.PGroup.OmegaCenterIn

/-!
# Sylow promotion from the central omega four-group

If the central omega subgroup of P is generated by z and w, and w and zw
are conjugate but neither is conjugate to z, its normalizer fixes z.
Local Sylow maximality in C(z) ∩ C(w) then gives maximality in C(w).
The entire center of P need not be elementary abelian.

Source: Aschbacher--Smith, 14.3.22, printed p.999.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

/-- The marked point is the unique member of its ambient conjugacy class
in the four-group generated by the two involutions. -/
theorem eq_of_isConj_mem_four_of_product_fusion
    (z w a : G) (hz : orderOf z = 2) (hw : orderOf w = 2)
    (hzw : Commute z w) (hnf : ¬ IsConj z w) (hprod : IsConj w (z * w))
    (ha : a ∈ closure ({z, w} : Set G)) (hconj : IsConj z a) : a = z := by
  have hzsq : z * z = 1 := by simpa [pow_two, hz] using pow_orderOf_eq_one z
  have hwsq : w * w = 1 := by simpa [pow_two, hw] using pow_orderOf_eq_one w
  rcases (mem_closure_pair_iff z w hzsq hwsq hzw a).mp ha with h | h | h | h
  · subst a
    obtain ⟨b, hb⟩ := isConj_iff.mp hconj
    have hz1 : z = 1 := (MulAut.conj b).injective (hb.trans (map_one _).symm)
    simp [hz1] at hz
  · exact h
  · exact (hnf (h ▸ hconj)).elim
  · exact (hnf ((h ▸ hconj).trans hprod.symm)).elim

/-- Weak closure in the characteristic central omega four-group controls
the normalizer of the original two-subgroup. -/
theorem normalizer_le_centralizer_of_four_omega_center_fusion
    (P : Subgroup G) (z w : G) (hz : orderOf z = 2) (hw : orderOf w = 2)
    (hzw : Commute z w) (homega : omegaCenterIn P = closure ({z, w} : Set G))
    (hnf : ¬ IsConj z w) (hprod : IsConj w (z * w)) :
    normalizer (P : Set G) ≤ centralizer ({z} : Set G) := by
  have hzO : z ∈ omegaCenterIn P := by rw [homega]; exact subset_closure (by simp)
  intro a ha
  have hc : a * z * a⁻¹ ∈ omegaCenterIn P :=
    ((normalizer_le_normalizer_omegaCenterIn P ha) z).mp hzO
  have he := eq_of_isConj_mem_four_of_product_fusion z w (a * z * a⁻¹)
    hz hw hzw hnf hprod (homega ▸ hc) (isConj_iff.mpr ⟨a, rfl⟩)
  exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp he)

/-- Promote the literal local Sylow image to the global opposite centralizer. -/
theorem exists_sylow_centralizer_of_four_omega_center [Finite G]
    (P : Subgroup G) (z w : G) (hp : IsPGroup 2 P)
    (hPC : P ≤ centralizer ({w} : Set G))
    (hz : orderOf z = 2) (hw : orderOf w = 2) (hzw : Commute z w)
    (homega : omegaCenterIn P = closure ({z, w} : Set G))
    (hnf : ¬ IsConj z w) (hprod : IsConj w (z * w))
    (hlocal : ∃ S : Sylow 2 (centralizer ({z} : Set G) ⊓ centralizer ({w} : Set G) : Subgroup G),
      (S : Subgroup _).map (centralizer ({z} : Set G) ⊓ centralizer ({w} : Set G)).subtype = P) :
    ∃ S : Sylow 2 (centralizer ({w} : Set G)),
      (S : Subgroup _).map (centralizer ({w} : Set G)).subtype = P := by
  apply exists_sylow_map_eq_of_local_normalizer P
    (centralizer ({z} : Set G) ⊓ centralizer ({w} : Set G))
    (centralizer ({w} : Set G)) hp hPC hlocal
  exact le_inf (inf_le_left.trans
    (normalizer_le_centralizer_of_four_omega_center_fusion P z w hz hw hzw homega hnf hprod))
    inf_le_right

end Subgroup
