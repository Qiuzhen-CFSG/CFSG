module

public import Theory.GroupTheory.PGroup.RankTwoNormalFour
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators

/-!
# Fusion of a central involution with a commuting square root

Let `E` be a weakly closed normal four-group in a Sylow two-subgroup of a
finite group of elementary two-rank at most two. A conjugate `t` of a central
involution `z` belongs to `E` whenever `t` centralizes a square root of `z`.

Conjugate `t` to `z`, then move the transported square root into the original
Sylow inside `C_G(z)`. Every square in the Sylow centralizes `E`, since the
centralizer of a normal four has index at most two. The rank bound puts the
transported `z` in `E`. The four generated by `z` and `t` consequently maps
onto `E`, and weak closure finishes the argument.

Source: Janko–Thompson, Math. Z. 113 (1970), §6, printed p.395, the shared
centralizer step in the two fusion cases. The intrinsic existence of the
commuting square root is a separate two-group input.
-/

open Subgroup
open scoped Pointwise

namespace Sylow

/-- Weak closure confines a central-involution conjugate if it centralizes
 a square root of that central involution. -/
public theorem mem_four_of_isConj_of_commuting_square_root
    {G : Type*} [Group G] [Finite G]
    (hrank : ∀ A : Subgroup G, IsElementaryAbelian 2 A → Nat.card A < 8)
    (S : Sylow 2 G) (E : Subgroup S) [E.Normal] [IsElementaryAbelian 2 E]
    (hE : Nat.card E = 4)
    (hweak : ∀ g : G,
      (E.map (S : Subgroup G).subtype).map (MulAut.conj g).toMonoidHom ≤
        (S : Subgroup G) →
      (E.map (S : Subgroup G).subtype).map (MulAut.conj g).toMonoidHom =
        E.map (S : Subgroup G).subtype)
    (z t x : S) (hzC : z ∈ center S) (hz : orderOf z = 2)
    (hconj : IsConj (z : G) (t : G)) (hx : x ^ 2 = z) (hxt : Commute x t) :
    t ∈ E := by
  classical
  have hlocal := elementary_card_lt_eight_of_subgroup hrank (S : Subgroup G)
  have hz2 : z ^ 2 = 1 := by simpa only [hz] using pow_orderOf_eq_one z
  have hzE : z ∈ E := mem_four_of_square_eq_one_of_elementary_card_lt_eight
    hlocal E hE hz2 (center_le_centralizer _ hzC)
  by_contra htE
  have hzt : z ≠ t := fun h => htE (h ▸ hzE)
  obtain ⟨g, hg⟩ := isConj_iff.mp hconj.symm
  let f : G ≃* G := MulAut.conj g
  have hft : f (t : G) = z := hg
  have ht : orderOf t = 2 := by
    rw [← orderOf_coe t, ← f.orderOf_eq, hft, orderOf_coe z, hz]
  let H : Subgroup G := centralizer ({(z : G)} : Set G)
  have hSH : (S : Subgroup G) ≤ H := by
    intro s hs
    exact mem_centralizer_singleton_iff.mpr
      (congrArg Subtype.val (mem_center_iff.mp hzC ⟨s, hs⟩))
  let y : H := ⟨f (x : G), mem_centralizer_singleton_iff.mpr (by
    have hh := (hxt.map ((f : G →* G).comp (S : Subgroup G).subtype)).eq
    change f (x : G) * f (t : G) = f (t : G) * f (x : G) at hh
    rwa [hft] at hh)⟩
  have hy4 : y ^ 4 = 1 := by
    apply Subtype.ext
    change f (x : G) ^ 4 = 1
    rw [← map_pow]
    have hx4 : x ^ 4 = 1 := by rw [show 4 = 2 * 2 from rfl, pow_mul, hx, hz2]
    simpa using congrArg f (congrArg Subtype.val hx4)
  have hp : IsPGroup 2 (zpowers y) := by
    apply isPGroup_iff_orderOf_dvd_pow.mpr
    intro b
    refine ⟨2, ?_⟩
    rw [← orderOf_coe b]
    exact (orderOf_dvd_of_mem_zpowers b.property).trans
      (orderOf_dvd_of_pow_eq_one hy4)
  obtain ⟨T, hT⟩ := hp.exists_le_sylow
  obtain ⟨k, hk⟩ := MulAction.exists_smul_eq H T (S.subtype hSH)
  have hyS : (MulAut.conj k) y ∈ S.subtype hSH := by
    rw [← hk]
    change (MulAut.conj k) • y ∈ (MulAut.conj k) • (T : Set H)
    exact Set.smul_mem_smul_set (hT (mem_zpowers y))
  let v : S := ⟨((MulAut.conj k) y : H), hyS⟩
  let a : G := (k : G) * g
  let q : G ≃* G := MulAut.conj a
  have hqt : q (t : G) = z := by
    change (k : G) * g * (t : G) * ((k : G) * g)⁻¹ = z
    have hfix : (MulAut.conj (k : G)) (z : G) = z :=
      mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp k.property)
    calc
      _ = (MulAut.conj (k : G)) (f (t : G)) := by simp [f, mul_assoc]
      _ = z := by rw [hft]; exact hfix
  have hqz : q (z : G) = (v : G) ^ 2 := by
    rw [← hx, Subgroup.coe_pow, map_pow]
    congr 1
    simp [q, a, v, y, f, mul_assoc]
  have hv2C : v ^ 2 ∈ centralizer (E : Set S) := by
    have hb := centralizer_index_le_two_of_normal_four S.isPGroup' E hE
    have hn := (centralizer (E : Set S)).index_ne_zero_of_finite
    have hi : (centralizer (E : Set S)).index = 1 ∨
        (centralizer (E : Set S)).index = 2 := by omega
    rcases hi with hi | hi
    · rw [index_eq_one.mp hi]; trivial
    · exact sq_mem_of_index_two hi v
  have hv2E : v ^ 2 ∈ E := by
    apply mem_four_of_square_eq_one_of_elementary_card_lt_eight hlocal E hE _ hv2C
    apply Subtype.ext
    change ((v : G) ^ 2) ^ 2 = 1
    rw [← hqz, ← map_pow, ← Subgroup.coe_pow, hz2]
    exact q.map_one
  let W := E.map (S : Subgroup G).subtype
  let F := closure ({(z : G), (t : G)} : Set G)
  have hFS : F ≤ (S : Subgroup G) := by
    apply (closure_le _).mpr
    intro b hb
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
    rcases hb with rfl | rfl
    · exact z.property
    · exact t.property
  let : IsKleinFour F := isKleinFour_closure_pair_of_orderOf (z : G) (t : G)
    ((orderOf_coe z).trans hz) ((orderOf_coe t).trans ht)
    (fun h => hzt (Subtype.ext h))
    (congrArg Subtype.val (mem_center_iff.mp hzC t).symm)
  have hFW : F.map q.toMonoidHom = W := by
    apply eq_of_le_of_card_ge
    · apply map_le_iff_le_comap.mpr
      apply (closure_le _).mpr
      intro b hb
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
      rcases hb with rfl | rfl
      · change q (z : G) ∈ W
        rw [hqz]
        exact mem_map_of_mem (S : Subgroup G).subtype hv2E
      · change q (t : G) ∈ W
        rw [hqt]
        exact mem_map_of_mem (S : Subgroup G).subtype hzE
    · have hcF : Nat.card (F.map q.toMonoidHom) = 4 := by
        rw [card_map_of_injective q.injective, IsKleinFour.card_four]
      have hcW : Nat.card W = 4 := by
        rw [card_map_of_injective (S : Subgroup G).subtype_injective, hE]
      omega
  have hWF : W.map (MulAut.conj a⁻¹).toMonoidHom = F := by
    rw [← hFW, map_map]
    have hh : (MulAut.conj a⁻¹).toMonoidHom.comp q.toMonoidHom = MonoidHom.id G := by
      ext b
      simp [q, mul_assoc]
    rw [hh, map_id]
  have hWeq : F = W := hWF.symm.trans (hweak a⁻¹ (hWF ▸ hFS))
  have htW : (t : G) ∈ W := hWeq ▸ subset_closure (by simp : (t : G) ∈ {(z : G), (t : G)})
  rcases htW with ⟨b, hb, hbt⟩
  exact htE ((Subtype.ext hbt : b = t) ▸ hb)

end Sylow
