module

public import Theory.GroupTheory.CoprimeQuotientSubgroups
public import Mathlib.GroupTheory.Abelianization.Defs

/-!
# Odd kernels in groups generated by elements of square one

The abelianization of an involution-generated group has exponent at most two.
Consequently every odd-order subgroup lies in the derived subgroup. This
removes an odd kernel from a derived-subgroup supplement. Elements of square
one lift through odd kernels by lifting their elementary abelian cyclic group.

These elementary facts justify the odd-factor removal in GLS, Volume 4,
Chapter 2, Lemma 4.5, first paragraph (printed p. 34).
-/

namespace Subgroup

/-- Every odd-order subgroup of a group generated by elements of square one
lies in its derived subgroup. No normality assumption is needed. -/
public theorem le_commutator_of_odd_of_involution_generated
    {G : Type*} [Group G] {Z : Set G}
    (hgen : closure Z = ⊤) (hsq : ∀ z ∈ Z, z ^ 2 = 1)
    (N : Subgroup G) [Finite N] (hodd : Odd (Nat.card N)) : N ≤ _root_.commutator G := by
  let a : G →* Abelianization G := Abelianization.of
  let f : G →* Abelianization G := (powMonoidHom 2).comp a
  have hall : ∀ x : G, a x ^ 2 = 1 := by
    have hle : closure Z ≤ f.ker := (closure_le _).mpr (by
      intro z hz
      change a z ^ 2 = 1
      rw [← map_pow, hsq z hz, map_one])
    intro x
    exact hle (hgen ▸ mem_top x)
  intro n hn
  rw [← Abelianization.ker_of]
  change a n = 1
  apply orderOf_eq_one_iff.mp
  exact Nat.eq_one_of_dvd_coprimes hodd.coprime_two_left
    (orderOf_dvd_of_pow_eq_one (hall n))
    ((orderOf_map_dvd (a.comp N.subtype) (⟨n, hn⟩ : N)).trans
      (_root_.orderOf_dvd_natCard (⟨n, hn⟩ : N)))

/-- Elements of square one lift through an odd kernel, including the identity. -/
public theorem exists_sq_eq_one_lift_of_coprime_ker
    {G H : Type*} [Group G] [Finite G] [Group H]
    (f : G →* H) (hf : Function.Surjective f)
    (hker : Nat.Coprime 2 (Nat.card f.ker))
    (v : H) (hv : v ^ 2 = 1) : ∃ u : G, u ^ 2 = 1 ∧ f u = v := by
  let D := zpowers v
  let : IsElementaryAbelian 2 D := IsElementaryAbelian.zpowers_of_pow_eq_one hv
  obtain ⟨A, hA, hmap, _⟩ := exists_elementaryAbelian_map_eq_of_surjective_coprime
    f hf hker D
  have hvD : v ∈ A.map f := hmap.symm ▸ mem_zpowers v
  obtain ⟨u, hu, huv⟩ := hvD
  let := hA
  exact ⟨u, elemPow_eq_one_of_isElementaryAbelian u hu, huv⟩

/-- A derived-subgroup supplement lifts whenever the kernel lies in the
derived subgroup. This is the precise step removing the odd factor. -/
public theorem commutator_sup_zpowers_eq_top_of_surjective
    {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Surjective f)
    (hker : f.ker ≤ _root_.commutator G) (u : G)
    (hgen : _root_.commutator H ⊔ zpowers (f u) = ⊤) :
    _root_.commutator G ⊔ zpowers u = ⊤ := by
  apply map_injective_of_ker_le f (hker.trans le_sup_left) le_top
  simpa only [map_sup, _root_.commutator_def, map_commutator,
    map_top_of_surjective f hf, MonoidHom.map_zpowers] using hgen

end Subgroup
