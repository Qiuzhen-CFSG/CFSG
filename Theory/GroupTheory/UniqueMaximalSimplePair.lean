module
public import Theory.GroupTheory.UniqueMaximalNormalExtension
public import Mathlib.GroupTheory.Subgroup.Simple
public import Theory.GroupTheory.CentralProductProjection
public import Theory.GroupTheory.SylowSubnormalIntersection

/-!
# Unique maximal overgroups for an exchanged pair of simple factors

Suppose a finite group is generated by two commuting disjoint simple factors
and a subgroup which exchanges them. Each factor has a unique maximal overgroup
of its intersection with the exchanging subgroup. Every proper overgroup of the
exchanging subgroup lies in the product of those two factor maxima. To prove
this, its first-factor projection normalizes its nontrivial proper intersection
with that factor; simplicity makes that normalizer proper.

For a prime subgroup with a Sylow intersection in the first factor, the literal
intersection with the factor product splits, by projection and Sylow maximality.
The resulting theorem applies to the pair of alternating-five components in
Aschbacher--Smith, 10.1.2(6), printed p.742, after quotienting by the two-core.
-/

public section
open Subgroup
open scoped Pointwise
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem pair_product {A B : Subgroup G}
    (hn : B ≤ normalizer (A : Set G)) {x : G} (hx : x ∈ A ⊔ B) :
    ∃ a ∈ A, ∃ b ∈ B, a * b = x := by
  have hh : x ∈ (A : Set G) * (B : Set G) := by
    rw [← coe_mul_of_right_le_normalizer_left A B hn]
    exact hx
  exact hh

omit [Finite G] in
private theorem simple_normalizer_lt {A X : Subgroup G} [IsSimpleGroup A]
    (hXA : X ≤ A) (hX : X ≠ ⊥) (hlt : X < A) :
    A ⊓ normalizer (X : Set G) < A := by
  apply lt_of_le_of_ne inf_le_left
  intro he
  have hn : A ≤ normalizer (X : Set G) := he ▸ inf_le_right
  let : (X.subgroupOf A).Normal := (normal_subgroupOf_iff_le_normalizer hXA).mpr hn
  rcases (inferInstance : (X.subgroupOf A).Normal).eq_bot_or_eq_top with hbot | htop
  · have hdis := subgroupOf_eq_bot.mp hbot
    exact hX (bot_unique (by simpa only [inf_of_le_left hXA] using hdis.le_bot))
  · exact hlt.not_ge (subgroupOf_eq_top.mp htop)

private theorem pair_factor_bound {A B S V P : Subgroup G} [IsSimpleGroup A]
    (hc : B ≤ centralizer (A : Set G))
    (hu : Order.HasUniqueMaximalOver (A ⊓ S) A)
    (hP : A ⊓ S ≤ P ∧ P ⋖ A) (hne : A ⊓ S ≠ ⊥)
    (hSV : S ≤ V) (hVA : A ⊓ V < A)
    {a b : G} (ha : a ∈ A) (hb : b ∈ B) (hab : a * b ∈ V) : a ∈ P := by
  have hXA : A ⊓ V ≠ ⊥ := fun he => hne (bot_unique ((inf_le_inf_left A hSV).trans_eq he))
  have hN : A ⊓ normalizer ((A ⊓ V : Subgroup G) : Set G) ≤ P := by
    apply hu.le_maximal hP
    · refine le_inf inf_le_left ?_
      exact (le_inf (inf_le_left.trans A.le_normalizer)
        ((inf_le_right.trans hSV).trans V.le_normalizer)).trans inf_normalizer_le_normalizer_inf
    · exact simple_normalizer_lt inf_le_left hXA hVA
  apply hN
  refine ⟨ha, ?_⟩
  have hbN : b ∈ normalizer ((A ⊓ V : Subgroup G) : Set G) :=
    (centralizer_le_normalizer _) ((centralizer_le inf_le_left) (hc hb))
  have hABN : A ⊔ B ≤ normalizer (A : Set G) :=
    sup_le A.le_normalizer (hc.trans (centralizer_le_normalizer (A : Set G)))
  have habAB : a * b ∈ A ⊔ B := mul_mem_sup ha hb
  have habN : a * b ∈ normalizer ((A ⊓ V : Subgroup G) : Set G) :=
    inf_normalizer_le_normalizer_inf ⟨hABN habAB, V.le_normalizer hab⟩
  change a ∈ normalizer ((A ⊓ V : Subgroup G) : Set G)
  simpa only [mul_inv_cancel_right] using
    (normalizer ((A ⊓ V : Subgroup G) : Set G)).mul_mem habN ((normalizer ((A ⊓ V : Subgroup G) : Set G)).inv_mem hbN)

omit [Finite G] in
private theorem maximal_conj {A B S P Q : Subgroup G}
    (hB : Order.HasUniqueMaximalOver (B ⊓ S) B)
    (hP : A ⊓ S ≤ P ∧ P ⋖ A) (hQ : B ⊓ S ≤ Q ∧ Q ⋖ B)
    (s : G) (hs : s ∈ S) (hAB : A.map (MulAut.conj s).toMonoidHom = B) :
    P.map (MulAut.conj s).toMonoidHom = Q := by
  apply hB.2.unique _ hQ
  constructor
  · have hmap := map_mono (f := (MulAut.conj s).toMonoidHom) hP.1
    rw [map_inf _ _ _ (MulAut.conj s).injective, hAB] at hmap
    have hS : S.map (MulAut.conj s).toMonoidHom = S :=
      mem_normalizer_iff_map_conj_eq.mp (S.le_normalizer hs)
    simpa only [hS] using hmap
  · have hc := (apply_covBy_apply_iff (MulAut.conj s).mapSubgroup).mpr hP.2
    change P.map (MulAut.conj s).toMonoidHom ⋖ A.map (MulAut.conj s).toMonoidHom at hc
    rwa [hAB] at hc

/-- A transitive pair of commuting simple factors with unique Sylow maxima gives
one unique maximal overgroup in its extension. -/
theorem hasUniqueMaximalOver_of_simple_pair
    (A B S : Subgroup G) [IsSimpleGroup A] [IsSimpleGroup B]
    (hc : B ≤ centralizer (A : Set G)) (hd : Disjoint A B)
    (hA : Order.HasUniqueMaximalOver (A ⊓ S) A)
    (hB : Order.HasUniqueMaximalOver (B ⊓ S) B)
    (hneA : A ⊓ S ≠ ⊥) (hneB : B ⊓ S ≠ ⊥)
    (hperm : ∀ s ∈ S,
      (A.map (MulAut.conj s).toMonoidHom = A ∧ B.map (MulAut.conj s).toMonoidHom = B) ∨
      (A.map (MulAut.conj s).toMonoidHom = B ∧ B.map (MulAut.conj s).toMonoidHom = A))
    (hswap : ∃ s ∈ S, A.map (MulAut.conj s).toMonoidHom = B)
    (hsplit : (A ⊔ B) ⊓ S ≤ (A ⊓ S) ⊔ (B ⊓ S)) :
    Order.HasUniqueMaximalOver S ((A ⊔ B) ⊔ S) := by
  obtain ⟨P, hP, _⟩ := hA.2
  obtain ⟨Q, hQ, _⟩ := hB.2
  have hSPQ : S ≤ normalizer ((P ⊔ Q : Subgroup G) : Set G) := by
    intro s hs
    apply mem_normalizer_iff_map_conj_eq.mpr
    change (P ⊔ Q).map (MulAut.conj s).toMonoidHom = P ⊔ Q
    rw [map_sup]
    rcases hperm s hs with ⟨ha, hb⟩ | ⟨ha, hb⟩
    · rw [maximal_conj hA hP hP s hs ha, maximal_conj hB hQ hQ s hs hb]
    · rw [maximal_conj hB hP hQ s hs ha, maximal_conj hA hQ hP s hs hb, sup_comm]
  have hSAB : S ≤ normalizer ((A ⊔ B : Subgroup G) : Set G) := by
    intro s hs
    apply mem_normalizer_iff_map_conj_eq.mpr
    change (A ⊔ B).map (MulAut.conj s).toMonoidHom = A ⊔ B
    rw [map_sup]
    rcases hperm s hs with ⟨ha, hb⟩ | ⟨ha, hb⟩
    · rw [ha, hb]
    · rw [ha, hb, sup_comm]
  have hPQAB : P ⊔ Q ≤ A ⊔ B := sup_le_sup hP.2.le hQ.2.le
  have hQP : Q ≤ normalizer (P : Set G) :=
    ((hQ.2.le.trans hc).trans (centralizer_le hP.2.le)).trans (centralizer_le_normalizer _)
  have hproper : (P ⊔ Q) ⊔ S < (A ⊔ B) ⊔ S := by
    apply lt_of_le_of_ne (sup_le_sup hPQAB le_rfl)
    intro he
    apply hP.2.ne
    apply le_antisymm hP.2.le
    intro a ha
    have ham : a ∈ (P ⊔ Q) ⊔ S := he ▸ mem_sup_left (mem_sup_left ha)
    obtain ⟨p, hp, s, hs, hps⟩ := pair_product hSPQ ham
    have hsAB : s ∈ A ⊔ B := by
      have h := (A ⊔ B).mul_mem ((A ⊔ B).inv_mem (hPQAB hp)) (mem_sup_left ha)
      rwa [← hps, inv_mul_cancel_left] at h
    have hsPQ : s ∈ P ⊔ Q := (sup_le_sup hP.1 hQ.1) (hsplit ⟨hsAB, hs⟩)
    have haPQ : a ∈ P ⊔ Q := hps ▸ (P ⊔ Q).mul_mem hp hsPQ
    obtain ⟨p, hp, q, hq, hpq⟩ := pair_product hQP haPQ
    have hqA : q ∈ A := by
      have h := A.mul_mem (A.inv_mem (hP.2.le hp)) ha
      rwa [← hpq, inv_mul_cancel_left] at h
    have hq1 : q = 1 := disjoint_def.mp hd hqA (hQ.2.le hq)
    have heq : p = a := by simpa only [hq1, mul_one] using hpq
    exact heq ▸ hp
  have hbound (V : Subgroup G) (hSV : S ≤ V) (hV : V < (A ⊔ B) ⊔ S) :
      V ≤ (P ⊔ Q) ⊔ S := by
    obtain ⟨s, hs, hAB⟩ := hswap
    have hVN : V.map (MulAut.conj s).toMonoidHom = V :=
      mem_normalizer_iff_map_conj_eq.mp (V.le_normalizer (hSV hs))
    have hVA : A ⊓ V < A := by
      apply lt_of_le_of_ne inf_le_left
      intro he
      have hAV : A ≤ V := he ▸ inf_le_right
      have hBV : B ≤ V := by
        rw [← hAB, ← hVN]
        exact map_mono hAV
      exact hV.not_ge (sup_le (sup_le hAV hBV) hSV)
    have hVB : B ⊓ V < B := by
      apply lt_of_le_of_ne inf_le_left
      intro he
      have hBV : B ≤ V := he ▸ inf_le_right
      have hAV : A ≤ V := (MulAut.conj s).mapSubgroup.le_iff_le.mp (by
        change A.map (MulAut.conj s).toMonoidHom ≤ V.map (MulAut.conj s).toMonoidHom
        rwa [hAB, hVN])
      exact hV.not_ge (sup_le (sup_le hAV hBV) hSV)
    intro v hv
    obtain ⟨x, hx, t, ht, hxt⟩ := pair_product hSAB (hV.le hv)
    obtain ⟨a, ha, b, hb, hab⟩ := pair_product (hc.trans (centralizer_le_normalizer _)) hx
    have hxV : x ∈ V := by
      have h := V.mul_mem hv (V.inv_mem (hSV ht))
      rwa [← hxt, mul_inv_cancel_right] at h
    have habV : a * b ∈ V := hab ▸ hxV
    have haP := pair_factor_bound hc hA hP hneA hSV hVA ha hb habV
    have hbQ := pair_factor_bound (le_centralizer_iff.mp hc) hB hQ hneB hSV hVB hb ha (by
      have hc' : b * a = a * b := (hc hb a ha).symm
      rwa [hc'])
    rw [← hxt, ← hab]
    exact mul_mem_sup (mul_mem_sup haP hbQ) ht
  have hcov : (P ⊔ Q) ⊔ S ⋖ (A ⊔ B) ⊔ S :=
    ⟨hproper, fun V hMV hVH => (not_lt_of_ge (hbound V (le_sup_right.trans hMV.le) hVH)) hMV⟩
  refine ⟨le_sup_right.trans_lt hproper, (P ⊔ Q) ⊔ S, ⟨le_sup_right, hcov⟩, ?_⟩
  intro V hV
  exact ((hV.2.eq_or_eq (hbound V hV.1 hV.2.lt) hproper.le).resolve_right hproper.ne).symm
omit [Finite G] in
/-- A p-subgroup splits across commuting disjoint factors as soon as its first
intersection is Sylow in the first factor. -/
theorem inf_sup_eq_sup_inf_of_disjoint_centralizing {p : ℕ}
    (A B S : Subgroup G) (hc : A ≤ centralizer (B : Set G)) (hd : Disjoint A B)
    (hS : IsPGroup p S) (P : Sylow p A) (hP : (P : Subgroup A) = S.subgroupOf A) :
    (A ⊔ B) ⊓ S = (A ⊓ S) ⊔ (B ⊓ S) := by
  have hker : (MonoidHom.id A).ker = B.subgroupOf A := by
    rw [MonoidHom.ker_id, subgroupOf_eq_bot.mpr hd.symm]
  obtain ⟨π, hπA, hπker⟩ := exists_sup_projection A B hc (MonoidHom.id A) hker
  let D := S.subgroupOf (A ⊔ B)
  have hDP : (P : Subgroup A) ≤ D.map π := by
    intro a ha
    refine ⟨inclusion le_sup_left a, ?_, hπA a⟩
    change (a : G) ∈ S
    rw [hP] at ha
    exact ha
  have hmap : D.map π = (P : Subgroup A) :=
    P.is_maximal' ((hS.comap_subtype (K := A ⊔ B)).map π) hDP
  apply le_antisymm
  · rintro x ⟨hxAB, hxS⟩
    obtain ⟨a, ha, b, hb, hab⟩ : ∃ a ∈ A, ∃ b ∈ B, a * b = x := by
      have hx : x ∈ (A : Set G) * (B : Set G) := by
        rw [← coe_mul_of_left_le_normalizer_right A B (hc.trans (centralizer_le_normalizer _))]
        exact hxAB
      exact hx
    let aA : A := ⟨a, ha⟩
    let bAB : (A ⊔ B : Subgroup G) := ⟨b, mem_sup_right hb⟩
    let xAB : (A ⊔ B : Subgroup G) := ⟨x, hxAB⟩
    have hbker : π bAB = 1 := by
      apply MonoidHom.mem_ker.mp
      rw [hπker]
      exact hb
    have hxprod : xAB = inclusion le_sup_left aA * bAB := Subtype.ext hab.symm
    have hxa : π xAB = aA := by
      rw [hxprod, map_mul, hπA, hbker, mul_one]
      rfl
    have haP : aA ∈ (P : Subgroup A) := by
      rw [← hmap]
      exact hxa ▸ mem_map_of_mem π (show xAB ∈ D from hxS)
    have haS : a ∈ S := by
      rw [hP] at haP
      exact haP
    have hbS : b ∈ S := by
      have hh := S.mul_mem (S.inv_mem haS) hxS
      rwa [← hab, inv_mul_cancel_left] at hh
    rw [← hab]
    exact mul_mem_sup ⟨ha,haS⟩ ⟨hb,hbS⟩
  · exact sup_le (le_inf (inf_le_left.trans le_sup_left) inf_le_right)
      (le_inf (inf_le_left.trans le_sup_right) inf_le_right)

omit [Finite G] in
/-- A two-element conjugacy orbit is permuted as a pair. -/
theorem conjugate_pair_permutation
    (A B S : Subgroup G) (hne : A ≠ B)
    (horbit : ∀ s ∈ S, A.map (MulAut.conj s).toMonoidHom = A ∨
      A.map (MulAut.conj s).toMonoidHom = B)
    (t : G) (ht : t ∈ S) (hAB : A.map (MulAut.conj t).toMonoidHom = B) :
    ∀ s ∈ S,
      (A.map (MulAut.conj s).toMonoidHom = A ∧ B.map (MulAut.conj s).toMonoidHom = B) ∨
      (A.map (MulAut.conj s).toMonoidHom = B ∧ B.map (MulAut.conj s).toMonoidHom = A) := by
  intro s hs
  have hB : B.map (MulAut.conj s).toMonoidHom = A ∨
      B.map (MulAut.conj s).toMonoidHom = B := by
    have he : B.map (MulAut.conj s).toMonoidHom = A.map (MulAut.conj (s * t)).toMonoidHom := by
      rw [← hAB, map_map]
      congr 1
      ext x
      change s * (t * x * t⁻¹) * s⁻¹ = (s * t) * x * (s * t)⁻¹
      group
    rw [he]
    exact horbit (s * t) (S.mul_mem hs ht)
  have hinj := map_injective (f := (MulAut.conj s).toMonoidHom) (MulAut.conj s).injective
  rcases horbit s hs with ha | ha <;> rcases hB with hb | hb
  · exact (hne (hinj (ha.trans hb.symm))).elim
  · exact Or.inl ⟨ha, hb⟩
  · exact Or.inr ⟨ha, hb⟩
  · exact (hne (hinj (ha.trans hb.symm))).elim

/-- Prime-subgroup form of the simple exchanged-pair theorem, requiring only
one marked factor and its genuine Sylow intersection. -/
theorem hasUniqueMaximalOver_of_simple_pair_sylow {p : ℕ}
    (A B S : Subgroup G) [IsSimpleGroup A]
    (hc : B ≤ centralizer (A : Set G)) (hd : Disjoint A B)
    (hA : Order.HasUniqueMaximalOver (A ⊓ S) A)
    (hneA : A ⊓ S ≠ ⊥)
    (hS : IsPGroup p S) (P : Sylow p A) (hP : (P : Subgroup A) = S.subgroupOf A)
    (horbit : ∀ s ∈ S, A.map (MulAut.conj s).toMonoidHom = A ∨
      A.map (MulAut.conj s).toMonoidHom = B)
    (t : G) (ht : t ∈ S) (hAB : A.map (MulAut.conj t).toMonoidHom = B) :
    Order.HasUniqueMaximalOver S ((A ⊔ B) ⊔ S) := by
  let e : A ≃* B := (A.equivMapOfInjective (MulAut.conj t).toMonoidHom
    (MulAut.conj t).injective).trans (MulEquiv.subgroupCongr hAB)
  let : IsSimpleGroup B := e.symm.isSimpleGroup
  have hSmap : S.map (MulAut.conj t).toMonoidHom = S :=
    mem_normalizer_iff_map_conj_eq.mp (S.le_normalizer ht)
  have hASmap : (A ⊓ S).map (MulAut.conj t).toMonoidHom = B ⊓ S := by
    rw [map_inf _ _ _ (MulAut.conj t).injective, hAB, hSmap]
  have hB : Order.HasUniqueMaximalOver (B ⊓ S) B := by
    have h := hA.map (MulAut.conj t).mapSubgroup
    change Order.HasUniqueMaximalOver ((A ⊓ S).map (MulAut.conj t).toMonoidHom)
      (A.map (MulAut.conj t).toMonoidHom) at h
    rwa [hASmap, hAB] at h
  have hneB : B ⊓ S ≠ ⊥ := by
    intro he
    apply hneA
    apply map_injective (f := (MulAut.conj t).toMonoidHom) (MulAut.conj t).injective
    rw [hASmap, he, map_bot]
  have hne : A ≠ B := by
    intro he
    have hA0 : A = ⊥ := by
      simpa only [← he, disjoint_self] using hd
    apply hneA
    rw [hA0, bot_inf_eq]
  exact hasUniqueMaximalOver_of_simple_pair A B S hc hd hA hB hneA hneB
    (conjugate_pair_permutation A B S hne horbit t ht hAB) ⟨t,ht,hAB⟩
    (inf_sup_eq_sup_inf_of_disjoint_centralizing A B S
      (le_centralizer_iff.mp hc) hd hS P hP).le

end Subgroup
