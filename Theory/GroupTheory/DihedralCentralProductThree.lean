module
public import Theory.GroupTheory.DihedralCentralProductThree.Factors

/-!
# Recognition of the plus extraspecial group of order 128

A finite extraspecial two-group with an elementary subgroup of order sixteen
containing its center is the external central product of three dihedral
groups of order eight. The model is literally the quotient of `Fin 3 → D₈`
by the subgroup generated by the two central identifications `z₀z₁` and
`z₀z₂`. Intrinsic dihedral splitting constructs three faithful factor maps;
the resulting map out of the quotient is surjective between groups of
order 128, hence is a multiplicative equivalence.

This is the elementary-subgroup recognition used in Aschbacher–Smith
15.3.58(2), printed pp.1148–1149. The source application must supply the
stated elementary subgroup, obtained there from a totally singular summand.
-/

namespace DihedralCentralProductThree

/-- Intrinsic plus-type recognition, with the elementary-sixteen hypothesis explicit. -/
public theorem exists_mulEquiv_of_elementary_sixteen
    {P : Type*} [Group P] [Finite P] [IsExtraspecial 2 P]
    (hP : Nat.card P = 128) (A : Subgroup P) [IsElementaryAbelian 2 A]
    (hA : Nat.card A = 16) (hZA : Subgroup.center P ≤ A) :
    Nonempty (P ≃* Model) := by
  obtain ⟨f, _, hc, hz, hg⟩ := exists_dihedral_factor_maps hP A hA hZA
  exact ⟨(markedRecognition f hc hz hg hP).symm⟩

/-- A multiplicative equivalence with the actual external central-product model. -/
public noncomputable def equivOfElementarySixteen
    {P : Type*} [Group P] [Finite P] [IsExtraspecial 2 P]
    (hP : Nat.card P = 128) (A : Subgroup P) [IsElementaryAbelian 2 A]
    (hA : Nat.card A = 16) (hZA : Subgroup.center P ≤ A) : P ≃* Model :=
  Classical.choice (exists_mulEquiv_of_elementary_sixteen hP A hA hZA)

end DihedralCentralProductThree
