module

public import Theory.GroupTheory.ConjugationFamily

/-!
# Centric character fusion

A relation on a Sylow subgroup that is reflexive, transitive, and preserved
by the normalizers of its centric extremal subgroups is preserved by ambient
conjugacy. In particular, a character preserved by those normalizers is
constant on ambient conjugacy classes.

Apply Huppert X.4.7's centric conjugation decomposition to the cyclic subgroup
generated by the first element. Induct through the conjugating product:
centric steps preserve the relation by hypothesis and centralizer steps fix
the current element. Equality of character values supplies the relation.
The relation argument is promoted from
`ABG.ChapterII.Section1.CentricFusionRelation` (ABG Chapter II §1, pp.10–11).
The public criteria use only intrinsic subgroup hypotheses.
-/

noncomputable section

open BenderSuzuki.External BenderSuzuki.PFchapter1section1

universe u v

/-- A reflexive transitive relation preserved by every centric extremal
normalizer step contains every ambient conjugacy between Sylow elements. -/
public theorem Sylow.centric_fusion_relation
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) (R : P → P → Prop)
    (hrefl : ∀ x, R x x)
    (htrans : ∀ {x y z}, R x y → R y z → R x z)
    (hlocal : ∀ (U : Subgroup G), U ≤ (P : Subgroup G) →
      (Nat.card ↥((P : Subgroup G) ⊓ Subgroup.normalizer (U : Set G))).factorization p =
        (Nat.card (Subgroup.normalizer (U : Set G))).factorization p →
      ((P : Subgroup G) ⊓ Subgroup.centralizer (U : Set G)) ≤ U →
      ∀ g : G, g ∈ Subgroup.normalizer (U : Set G) →
      ∀ x y : P, (x : G) ∈ U → g⁻¹ * (x : G) * g = (y : G) → R x y)
    {x y : P} (hxy : IsConj (x : G) (y : G)) : R x y := by
  obtain ⟨c, hc⟩ := isConj_iff.mp hxy
  let A : Subgroup G := Subgroup.zpowers (x : G)
  have hxA : (x : G) ∈ A := Subgroup.mem_zpowers (x : G)
  have hAP : A ≤ (P : Subgroup G) := Subgroup.zpowers_le.mpr x.property
  have hcA : rightConjugate A c⁻¹ ≤ (P : Subgroup G) := by
    simp only [rightConjugate, inv_inv, Subgroup.conjBy]
    rw [Subgroup.map_le_iff_le_comap]
    apply Subgroup.zpowers_le.mpr
    change c * (x : G) * c⁻¹ ∈ (P : Subgroup G)
    rw [hc]
    exact y.property
  have hd := HuppertExtremal.centric_conjugation_decomposition P hAP hcA
  have hstep : ∀ {g : G},
      HuppertCentricConjugationDecomposition (P : Subgroup G)
        (HuppertExtremal P) A g →
      ∀ z : P, g⁻¹ * (x : G) * g = (z : G) → R x z := by
    intro g hd
    induction hd with
    | one =>
      intro z hz
      have hxz : x = z := Subtype.ext (by simpa using hz)
      rw [hxz]
      exact hrefl z
    | @tail g h U hd hU hUP hAU hh hcent ih =>
      intro z hz
      have hcurrent : g⁻¹ * (x : G) * g ∈ U := by
        apply hAU
        exact Subgroup.mem_map.mpr ⟨(x : G), hxA, by simp⟩
      let w : P := ⟨g⁻¹ * (x : G) * g, hUP hcurrent⟩
      have hxw : R x w := ih w rfl
      have hwz : h⁻¹ * (w : G) * h = (z : G) := by
        simpa [w, mul_inv_rev, mul_assoc] using hz
      apply htrans hxw
      rcases hcent with hcent | hcent
      · exact hlocal U hU.1 hU.2 hcent h hh w z hcurrent hwz
      · have hcomm := Subgroup.mem_centralizer_iff.mp hcent (w : G) hcurrent
        have heq : w = z := by
          apply Subtype.ext
          calc
            (w : G) = h⁻¹ * (w : G) * h := by
              rw [mul_assoc, hcomm]
              simp
            _ = (z : G) := hwz
        rw [heq]
        exact hrefl z
  apply hstep hd y
  simpa using hc


/-- A character preserved by centric extremal normalizers is constant on
ambient conjugacy classes meeting the Sylow subgroup. -/
public theorem Sylow.centric_character_fusion
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (S : Sylow p G) {A : Type v} [CommGroup A] (chi : S →* A)
    (hlocal : ∀ (U : Subgroup G), U ≤ (S : Subgroup G) →
      (Nat.card ↥((S : Subgroup G) ⊓ Subgroup.normalizer (U : Set G))).factorization p =
        (Nat.card (Subgroup.normalizer (U : Set G))).factorization p →
      ((S : Subgroup G) ⊓ Subgroup.centralizer (U : Set G)) ≤ U →
      ∀ g : G, g ∈ Subgroup.normalizer (U : Set G) →
      ∀ x y : S, (x : G) ∈ U →
        g⁻¹ * (x : G) * g = (y : G) → chi x = chi y)
    {x y : S} (hxy : IsConj (x : G) (y : G)) : chi x = chi y :=
  S.centric_fusion_relation (fun x y ↦ chi x = chi y)
    (fun _ ↦ rfl) (fun h₁ h₂ ↦ h₁.trans h₂) hlocal hxy
