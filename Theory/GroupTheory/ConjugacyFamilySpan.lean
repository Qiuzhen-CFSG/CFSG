module

public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Subgroups generated by a conjugacy-invariant family

For a conjugacy-invariant family of subgroups, take the subgroup generated by
its members lying in `X`. Its conjugates lying in `X` are equal to it, by
finiteness. Sylow conjugacy then identifies these generated subgroups in any
prime-power overgroup of the subgroup generated inside a Sylow subgroup.

This is the general group-theoretic argument behind Aschbacher–Smith,
*The Classification of Quasithin Groups*, combined manuscript (1 March 2004),
Remark E.3.14 and Lemma E.3.15, printed p. 233.
-/

@[expose] public section

namespace SubgroupFamily

open Subgroup

variable {G : Type*} [Group G]

/-- The subgroup generated by members of `family` contained in `X`. -/
def span (family : Set (Subgroup G)) (X : Subgroup G) : Subgroup G :=
  sSup {A | A ∈ family ∧ A ≤ X}

/-- Invariance under all ambient inner automorphisms. -/
def ConjugationInvariant (family : Set (Subgroup G)) : Prop :=
  ∀ A ∈ family, ∀ g : G, A.map (MulAut.conj g).toMonoidHom ∈ family

theorem span_le (family : Set (Subgroup G)) (X : Subgroup G) :
    span family X ≤ X :=
  sSup_le fun _ h => h.2

theorem le_span {family : Set (Subgroup G)} {A X : Subgroup G}
    (hA : A ∈ family) (hAX : A ≤ X) : A ≤ span family X :=
  le_sSup ⟨hA, hAX⟩

/-- It suffices that the generated subgroup, rather than all of `X`, lies in `Y`. -/
theorem span_le_span_of_span_le {family : Set (Subgroup G)} {X Y : Subgroup G}
    (h : span family X ≤ Y) : span family X ≤ span family Y :=
  sSup_le fun _ hA => le_span hA.1 ((le_span hA.1 hA.2).trans h)

theorem span_mono (family : Set (Subgroup G)) : Monotone (span family) :=
  fun X _ h => span_le_span_of_span_le ((span_le family X).trans h)

/-- Each conjugated generator belongs to the same family. -/
theorem map_span_le {family : Set (Subgroup G)}
    (hf : ConjugationInvariant family) {X Y : Subgroup G} (g : G)
    (h : (span family X).map (MulAut.conj g).toMonoidHom ≤ Y) :
    (span family X).map (MulAut.conj g).toMonoidHom ≤ span family Y := by
  apply Subgroup.map_le_iff_le_comap.mpr
  apply sSup_le
  intro A hA
  apply Subgroup.map_le_iff_le_comap.mp
  exact le_span (hf A hA.1 g)
    ((Subgroup.map_mono (le_span hA.1 hA.2)).trans h)

/-- A conjugate of the generated subgroup contained in `X` is equal to it. -/
theorem span_weakly_closed [Finite G] {family : Set (Subgroup G)}
    (hf : ConjugationInvariant family) (X : Subgroup G) (g : G)
    (h : (span family X).map (MulAut.conj g).toMonoidHom ≤ X) :
    (span family X).map (MulAut.conj g).toMonoidHom = span family X := by
  apply Subgroup.eq_of_le_of_card_ge (map_span_le hf g h)
  rw [Subgroup.card_map_of_injective (MulAut.conj g).injective]

theorem normalizer_le_span_normalizer [Finite G] {family : Set (Subgroup G)}
    (hf : ConjugationInvariant family) (X : Subgroup G) :
    normalizer (X : Set G) ≤ normalizer (span family X : Set G) := by
  intro g hg
  apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
  apply span_weakly_closed hf X g
  exact (Subgroup.map_mono (span_le family X)).trans
    (Subgroup.mem_normalizer_iff_map_conj_eq.mp hg).le

/-- Conjugating `Y` into `X` bounds the order of its generated subgroup. -/
theorem span_eq_of_conjugate_le [Finite G] {family : Set (Subgroup G)}
    (hf : ConjugationInvariant family) {X Y : Subgroup G}
    (hXY : span family X ≤ Y) (g : G)
    (hg : Y.map (MulAut.conj g).toMonoidHom ≤ X) :
    span family X = span family Y := by
  apply Subgroup.eq_of_le_of_card_ge (span_le_span_of_span_le hXY)
  have hmap := map_span_le hf g
    ((Subgroup.map_mono (span_le family Y)).trans hg)
  have hcard := Nat.card_le_card_of_injective (Subgroup.inclusion hmap)
    (Subgroup.inclusion_injective hmap)
  rwa [Subgroup.card_map_of_injective (MulAut.conj g).injective] at hcard

/-- Equality in any prime-power overgroup of the span in a Sylow subgroup. -/
theorem span_eq_in_p_overgroup [Finite G] {p : ℕ} [Fact p.Prime]
    {family : Set (Subgroup G)} (hf : ConjugationInvariant family)
    (S : Sylow p G) (Y : Subgroup G) (hY : IsPGroup p Y)
    (hSY : span family (S : Subgroup G) ≤ Y) :
    span family (S : Subgroup G) = span family Y := by
  obtain ⟨P, hYP⟩ := hY.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G P S
  apply span_eq_of_conjugate_le hf hSY g
  rw [← hg]
  exact Subgroup.map_mono hYP

/-- The Sylow subgroup may be Sylow only in a specified ambient subgroup `H`.
The family remains invariant under conjugation in the original group `G`. -/
theorem span_eq_in_relative_p_overgroup [Finite G] {p : ℕ} [Fact p.Prime]
    {family : Set (Subgroup G)} (hf : ConjugationInvariant family)
    (H : Subgroup G) (S : Sylow p H) (Y : Subgroup G)
    (hY : IsPGroup p Y) (hYH : Y ≤ H)
    (hSY : span family ((S : Subgroup H).map H.subtype) ≤ Y) :
    span family ((S : Subgroup H).map H.subtype) = span family Y := by
  have hYp : IsPGroup p (Y.subgroupOf H) := hY.comap_subtype
  obtain ⟨P, hYP⟩ := hYp.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq H P S
  have hmap : (Y.subgroupOf H).map (MulAut.conj g).toMonoidHom ≤
      (S : Subgroup H) := by
    rw [← hg]
    exact Subgroup.map_mono hYP
  have hcomp : H.subtype.comp (MulAut.conj g).toMonoidHom =
      (MulAut.conj (g : G)).toMonoidHom.comp H.subtype := by
    ext x
    rfl
  have hamb := Subgroup.map_mono (f := H.subtype) hmap
  rw [Subgroup.map_map, hcomp, ← Subgroup.map_map,
    Subgroup.map_subgroupOf_eq_of_le hYH] at hamb
  exact span_eq_of_conjugate_le hf hSY (g : G) hamb

end SubgroupFamily
