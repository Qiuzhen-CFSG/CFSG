module

public import Theory.Frattini.BinarySquares
public import Theory.GroupTheory.SubgroupConjugation

/-!
# A Frattini action on two conjugate factors

Let S be a finite two-group and P = A ∨ Aᵗ, with t in S. If squares in S
lie in D and S ∩ D centralizes A, then Φ(S) centralizes P. The Frattini
subgroup is generated by squares, so it centralizes A. Its normality in S
then makes it centralize the conjugate factor as well.

This is the elementary action reduction used in Aschbacher–Smith,
*The Classification of Quasithin Groups*, proof of Lemma 1.3.9(1),
combined manuscript of 1 March 2004, printed p.514.
-/

open Subgroup
open scoped Pointwise

/-- Squares fixing one factor pointwise force the Frattini subgroup to fix
both conjugate factors. The intermediate subgroup D need not be normal. -/
public theorem IsPGroup.frattini_map_le_centralizer_conjugate_sup
    {G : Type*} [Group G] {S D A P : Subgroup G} [Finite S]
    (hS : IsPGroup 2 S) {t : G} (ht : t ∈ S)
    (hgen : P = A ⊔ A.conjBy t)
    (hsq : ∀ s ∈ S, s ^ 2 ∈ D)
    (hcent : S ⊓ D ≤ centralizer (A : Set G)) :
    (frattini S).map S.subtype ≤ centralizer (P : Set G) := by
  have hD : frattini S ≤ D.comap S.subtype := by
    rw [hS.frattini_eq_closure_squares]
    apply (closure_le _).mpr
    rintro _ ⟨s, rfl⟩
    exact hsq s s.property
  have hc (x : S) (hx : x ∈ frattini S) : (x : G) ∈ centralizer (A : Set G) :=
    hcent ⟨x.property, hD hx⟩
  have hc' : (frattini S).map S.subtype ≤ centralizer (A.conjBy t : Set G) := by
    rintro _ ⟨x, hx, rfl⟩
    intro y hy
    obtain ⟨a, ha, rfl⟩ := hy
    let tS : S := ⟨t, ht⟩
    have hxc : tS⁻¹ * x * tS ∈ frattini S := by
      simpa only [inv_inv] using (inferInstance : (frattini S).Normal).conj_mem x hx tS⁻¹
    have he := hc (tS⁻¹ * x * tS) hxc a ha
    have hh := congrArg (MulAut.conj t) he
    change (t * a * t⁻¹) * (x : G) = (x : G) * (t * a * t⁻¹)
    simpa only [map_mul, MulAut.conj_apply, coe_mul, coe_inv, tS, mul_assoc,
      mul_inv_cancel, inv_mul_cancel, mul_one, one_mul,
      mul_inv_cancel_left, inv_mul_cancel_left, mul_inv_cancel_right,
      inv_mul_cancel_right] using hh
  apply le_centralizer_iff.mpr
  rw [hgen]
  apply sup_le
  · apply le_centralizer_iff.mp
    rintro _ ⟨x, hx, rfl⟩
    exact hc x hx
  · exact le_centralizer_iff.mp hc'
