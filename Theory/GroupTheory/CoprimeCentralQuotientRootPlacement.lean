module

public import Theory.GroupAction.SubgroupQuotientFullAction
public import Theory.GroupTheory.CComponent.OrdinaryProjection

/-!
# Lifting invariant root placement across a central quotient

A coprime fixed transporter modulo the center has a fixed representative
in the original normal subgroup. If the root is generated by its
commutators with the retained actor, its containment modulo the center
lifts to containment in the actual conjugate complement.
-/

public noncomputable section
open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

/-- A root moved entirely by the retained actor lies in the actual conjugate
subgroup, once its image has a coprime fixed transporter in a central quotient. -/
theorem root_le_centralizing_conjugate_of_central_quotient
    (N Z C R K : Subgroup G) [N.Normal] [Z.Normal]
    (hZ : Z≤center G) (hC : Group.IsSolvable N)
    (hcop : Nat.Coprime (Nat.card C) (Nat.card N))
    (hCK : C≤K) (hmoved : ⁅R,C⁆=R)
    (vbar : G ⧸ Z)
    (hv : vbar∈N.map (QuotientGroup.mk' Z) ⊓
      centralizer (C.map (QuotientGroup.mk' Z) : Set (G ⧸ Z)))
    (hR : R.map (QuotientGroup.mk' Z)≤
      (K.map (QuotientGroup.mk' Z)).map (MulAut.conj vbar).toMonoidHom) :
    ∃ v∈N⊓centralizer (C:Set G), R≤K.map (MulAut.conj v).toMonoidHom := by
  let π := QuotientGroup.mk' Z
  obtain ⟨x,hx,hxq⟩ := hv.1
  let _ : MulDistribMulAction C N :=
    conjMulDistribMulActionOfLeNormalizer C N le_normalizer_of_normal
  have hInv : IsInvariant C N (Z.subgroupOf N) :=
    ⟨fun c n => mem_normalizer_iff.mp (le_normalizer_of_normal c.property) n⟩
  let _ := quotientMulDistribMulAction (Z.subgroupOf N) hInv
  let xN : N := ⟨x,hx⟩
  have hfix : QuotientGroup.mk' (Z.subgroupOf N) xN ∈
      FixedPoints.subgroup C (N ⧸ Z.subgroupOf N) := by
    intro c
    change QuotientGroup.mk' _ (c • xN)=QuotientGroup.mk' _ xN
    apply QuotientGroup.eq_iff_div_mem.mpr
    change ((c:G)*x*(c:G)⁻¹)/x∈Z
    apply (QuotientGroup.eq_one_iff _).mp
    change π (((c:G)*x*(c:G)⁻¹)/x)=1
    rw [map_div,map_mul,map_mul,map_inv,hxq]
    have hh := hv.2 (π (c:G)) (mem_map_of_mem π c.property)
    rw [hh,mul_inv_cancel_right,div_self']
  rw [fixedPoints_subgroup_quotient_eq_map_of_solvable_coprime hC hcop _ hInv] at hfix
  obtain ⟨v,hvfix,he⟩ := hfix
  have hvC : (v:G)∈centralizer (C:Set G) := by
    intro c hc
    have hh := congrArg (fun z : N => (z:G)) (hvfix ⟨c,hc⟩)
    change c*(v:G)*c⁻¹=(v:G) at hh
    exact mul_inv_eq_iff_eq_mul.mp hh
  have hvq : π (v:G)=vbar := by
    have hmemN : v/xN∈Z.subgroupOf N := QuotientGroup.eq_iff_div_mem.mp he
    have hmem : (v:G)/x∈Z := hmemN
    exact (QuotientGroup.eq_iff_div_mem.mpr hmem).trans hxq
  let K' := K.map (MulAut.conj (v:G)).toMonoidHom
  have hCK' : C≤K' := by
    intro c hc
    refine ⟨c,hCK hc,?_⟩
    change (v:G)*c*(v:G)⁻¹=c
    rw [←hvC c hc,mul_inv_cancel_right]
  have hmap : K'.map π=(K.map π).map (MulAut.conj vbar).toMonoidHom := by
    rw [map_map,map_map]
    congr 1
    ext g
    change π ((v:G)*g*(v:G)⁻¹)=vbar*π g*vbar⁻¹
    rw [map_mul,map_mul,map_inv,hvq]
  have hR' : R≤Z⊔K' := by
    have hh : R.map π≤K'.map π := hmap.symm ▸ hR
    have h := map_le_map_iff.mp hh
    simpa only [π,QuotientGroup.ker_mk',sup_comm] using h
  refine ⟨v,⟨v.property,hvC⟩,?_⟩
  rw [←hmoved]
  exact commutator_le_of_le_sup_centralizing R C K' Z hR'
    (fun z hz k _ => (mem_center_iff.mp (hZ hz) k))
    (fun z hz c _ => (mem_center_iff.mp (hZ hz) c))
    (hCK'.trans K'.le_normalizer)

end Theory.GroupTheory
