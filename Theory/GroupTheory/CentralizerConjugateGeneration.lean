module

public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Algebra.Group.Conj

/-!
# Conjugate generation inside an element centralizer

If the normalizer of `V` is transitive on its nonidentity elements, the
centralizer of a nonidentity element `z` can carry `V` to every conjugate
containing `z`. Consequently, if the subgroup generated by the centralizer
conjugates of `V` is abelian, all conjugates of `V` containing `z` commute.

To construct the transporter, start with `g` carrying `V` to a subgroup
containing `z`, and correct `g` on the right by an element of the normalizer
carrying `z` to its preimage. The corrected transporter centralizes `z`.
The generated subgroup is an indexed supremum, with a set-closure bridge.
No finiteness or prime-order hypothesis is needed.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, A.1.7(1), used after 5.1.23 in the final paragraph
of the proof of Theorem 5.1.14 (printed p. 646).
-/

namespace Subgroup

open scoped IsMulCommutative

/-- Correct a conjugator by a normalizer element so that it fixes `z`. -/
public theorem exists_centralizer_conjugator_of_normalizer_transitive {G : Type*} [Group G] (V : Subgroup G) {z : G}
    (hz : z ≠ 1)
    (htrans : ∀ x ∈ V, x ≠ 1 → ∃ n ∈ normalizer (V : Set G),
      (MulAut.conj n) z = x)
    {g : G} (hg : z ∈ V.map (MulAut.conj g).toMonoidHom) :
    ∃ c : centralizer ({z} : Set G),
      V.map (MulAut.conj (c : G)).toMonoidHom =
        V.map (MulAut.conj g).toMonoidHom := by
  obtain ⟨x, hx, hxz⟩ := hg
  have hxne : x ≠ 1 := by
    intro hxone
    apply hz
    simpa [hxone] using hxz.symm
  obtain ⟨n, hn, hnz⟩ := htrans x hx hxne
  have hcz : (MulAut.conj (g * n)) z = z := by
    calc
      (MulAut.conj (g * n)) z = (MulAut.conj g) ((MulAut.conj n) z) := by
        simp [MulAut.conj_apply, mul_assoc]
      _ = z := by rw [hnz]; exact hxz
  have hc : g * n ∈ centralizer ({z} : Set G) := by
    apply mem_centralizer_singleton_iff.mpr
    exact mul_inv_eq_iff_eq_mul.mp hcz
  refine ⟨⟨g * n, hc⟩, ?_⟩
  have hnV : V.map (MulAut.conj n).toMonoidHom = V :=
    mem_normalizer_iff_map_conj_eq.mp hn
  have hcomp : (MulAut.conj (g * n)).toMonoidHom =
      (MulAut.conj g).toMonoidHom.comp (MulAut.conj n).toMonoidHom := by
    ext a
    simp [MulAut.conj_apply, mul_assoc]
  change V.map (MulAut.conj (g * n)).toMonoidHom = _
  rw [hcomp, ← Subgroup.map_map, hnV]


/-- The subgroup generated by all conjugates of `V` under `C_G(z)`. -/
@[expose] public def centralizerConjugateClosure {G : Type*} [Group G] (V : Subgroup G) (z : G) : Subgroup G :=
  ⨆ c : centralizer ({z} : Set G), V.map (MulAut.conj (c : G)).toMonoidHom

/-- The identity conjugator embeds the seed subgroup in its generated subgroup. -/
public theorem le_centralizerConjugateClosure {G : Type*} [Group G] (V : Subgroup G) (z : G) :
    V ≤ centralizerConjugateClosure V z := by
  have h := le_iSup (fun c : centralizer ({z} : Set G) =>
    V.map (MulAut.conj (c : G)).toMonoidHom) 1
  have heq : V.map (MulAut.conj (1 : G)).toMonoidHom = V := by
    ext x
    simp [Subgroup.mem_map]
  change V.map (MulAut.conj (1 : G)).toMonoidHom ≤ centralizerConjugateClosure V z at h
  rwa [heq] at h

/-- Every conjugate containing `z` lies in the centralizer-generated subgroup. -/
public theorem conjugate_le_centralizerConjugateClosure {G : Type*} [Group G] (V : Subgroup G) {z : G}
    (hz : z ≠ 1)
    (htrans : ∀ x ∈ V, x ≠ 1 → ∃ n ∈ normalizer (V : Set G),
      (MulAut.conj n) z = x)
    {g : G} (hg : z ∈ V.map (MulAut.conj g).toMonoidHom) :
    V.map (MulAut.conj g).toMonoidHom ≤ centralizerConjugateClosure V z := by
  obtain ⟨c, hc⟩ := exists_centralizer_conjugator_of_normalizer_transitive V hz htrans hg
  rw [← hc]
  exact le_iSup (fun c : centralizer ({z} : Set G) =>
    V.map (MulAut.conj (c : G)).toMonoidHom) c

/-- Abelian generation makes any two conjugates containing `z` commute. -/
public theorem commutator_eq_bot_of_abelian_centralizerConjugateClosure {G : Type*} [Group G] (V : Subgroup G) {z : G}
    (hz : z ≠ 1)
    (htrans : ∀ x ∈ V, x ≠ 1 → ∃ n ∈ normalizer (V : Set G),
      (MulAut.conj n) z = x)
    [IsMulCommutative (centralizerConjugateClosure V z)]
    {g h : G} (hg : z ∈ V.map (MulAut.conj g).toMonoidHom)
    (hh : z ∈ V.map (MulAut.conj h).toMonoidHom) :
    ⁅V.map (MulAut.conj g).toMonoidHom, V.map (MulAut.conj h).toMonoidHom⁆ = ⊥ := by
  apply commutator_eq_bot_iff_le_centralizer.mpr
  intro x hx
  rw [mem_centralizer_iff]
  intro y hy
  exact congrArg Subtype.val (mul_comm
    (⟨y, conjugate_le_centralizerConjugateClosure V hz htrans hh hy⟩ : centralizerConjugateClosure V z)
    (⟨x, conjugate_le_centralizerConjugateClosure V hz htrans hg hx⟩ : centralizerConjugateClosure V z))

/-- Express the indexed supremum as the closure of the conjugate elements. -/
public theorem centralizerConjugateClosure_eq_closure {G : Type*} [Group G] (V : Subgroup G) (z : G) :
    centralizerConjugateClosure V z = closure {x : G | ∃ c : centralizer ({z} : Set G),
      ∃ v ∈ V, (MulAut.conj (c : G)) v = x} := by
  apply le_antisymm
  · apply iSup_le
    intro c x hx
    obtain ⟨v, hv, rfl⟩ := hx
    exact subset_closure ⟨c, v, hv, rfl⟩
  · apply (Subgroup.closure_le _).mpr
    rintro x ⟨c, v, hv, rfl⟩
    exact (le_iSup (fun c : centralizer ({z} : Set G) =>
      V.map (MulAut.conj (c : G)).toMonoidHom) c) ⟨v, hv, rfl⟩

end Subgroup
