module

public import Theory.GroupTheory.GeneralizedFitting.ChiefComponents
public import Theory.GroupTheory.CComponent.QuotientLifting
public import FeitThompson.ChiefFactors.Core

/-!
# Primitive subgroups inside a nontrivial normal kernel

In a finite group with trivial two-core, every nontrivial normal subgroup
contains either a simple ordinary component or an elementary abelian
minimal normal subgroup of odd prime exponent. Choose a minimal normal
subgroup inside the prescribed kernel. Its abelian case is elementary;
its nonabelian case is generated by simple components, one of which gives
the required subgroup of the original ambient group.

This is the primitive selection in Aschbacher--Smith13.7.4(1), p.936.
The prescribed normal subgroup need not itself be solvable or semisimple.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

theorem exists_simple_component_or_odd_minimal_normal
    (C : Subgroup G) (hC : C.Normal) (hne : C ≠ ⊥) (hcore : pCore 2 G = ⊥) :
    (∃ K : Subgroup G, K ≤ C ∧ IsComponent G K ∧ IsSimpleGroup K) ∨
    (∃ (p : ℕ) (N : Subgroup G), p.Prime ∧ Odd p ∧
      N ≤ C ∧ ChiefFactor.IsChief N ⊥ ∧ IsElementaryAbelian p N) := by
  classical
  obtain ⟨N, hn, hNC, hNne, hmin⟩ := exists_minimal_normal_le C hC hne
  let := hn
  have hchief : ChiefFactor.IsChief N ⊥ := by
    refine ⟨hn, inferInstance, bot_lt_iff_ne_bot.mpr hNne, ?_⟩
    intro W hW _ hWN
    by_cases hz : W = ⊥
    · exact Or.inl hz
    · exact Or.inr (hmin W hW hWN hz)
  by_cases hab : IsMulCommutative N
  · right
    let := hab
    let : IsMinimalNormal N := ⟨fun W _ hWN => hchief.minimal W inferInstance bot_le hWN⟩
    obtain ⟨p, hp, hE⟩ := minimalNormal_solvable_exists_isElementaryAbelian N
    have hp2 : p ≠ 2 := by
      intro he
      subst p
      let := hE
      have hle : N ≤ pCore 2 G := le_sSup ⟨hn, IsElementaryAbelian.isPGroup 2 N⟩
      exact hNne (le_bot_iff.mp (hle.trans hcore.le))
    exact ⟨p, N, hp, hp.odd_of_ne_two hp2, hNC, hchief, hE⟩
  · left
    have hex : ∃ K : Subgroup G, IsComponentIn K N := by
      by_contra hno
      have hle : N ≤ ⊥ := hchief.le_of_components_le hab ⊥ (by
        intro K hK
        exact (hno ⟨K, hK⟩).elim)
      exact hNne (le_bot_iff.mp hle)
    obtain ⟨K, hK⟩ := hex
    exact ⟨K, hK.1.trans hNC,
      ⟨Subgroup.IsSubnormal.trans hK.1 hK.2.1 hn.isSubnormal, hK.quasisimple⟩,
      hchief.component_isSimple hab hK⟩

end Theory.GroupTheory
