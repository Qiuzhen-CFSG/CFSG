module

public import Theory.GroupTheory.GeneralizedFitting.SelfCentralizing
public import Theory.ElementaryAbelian.Extraspecial
public import Theory.GroupTheory.PGroup.CharacteristicCenterReduction
public import Theory.GroupTheory.CharacteristicCentralizerFusion
public import Theory.GroupTheory.PGroup.ClassTwoCyclicCenter
public import Mathlib.GroupTheory.FixedPointFree
public import Mathlib.GroupTheory.Subgroup.Simple
import Mathlib.Tactic

/-!
# An extraspecial involution-centralizer simplicity criterion

This module proves the local group-theoretic argument in Aschbacher,
*Sporadic Groups*, Exercise 2.4, printed pp. 32–33 (PDF page 22 of the
local two-page scan).

The weak closure of `z` in `H` means `⟨z^G ∩ H⟩`, where conjugacy is in
**the ambient group `G`**. It does not mean the subgroup generated by the
`H`-conjugates of its central element `z`. Irreducibility on `Q/⟨z⟩` is
expressed by the equivalent subgroup-lattice condition: the only
`H`-invariant subgroups between `⟨z⟩` and `Q` are the endpoints.

The theorem `isSimpleGroup_of_generalizedFitting` takes the source equality
`Q = F*(C_G(z))`, using the intrinsic generalized Fitting subgroup. The
subgroup equality is expressed inside `H = C_G(z)` and the simple quotient
is accordingly `H/F*(H)`. Its proof uses normality of `F*(H)` and
`Z(H) ≤ F(H) ≤ F*(H)` to obtain normality of `Q` and membership of `z`.
Self-centralization follows directly from the other local hypotheses:
otherwise simplicity of `H/Q` gives `H = Q C_H(Q)`. For a returning conjugate
`t ≠ z`, the subgroup `C_Q(t)` would then be `H`-invariant, contradicting
irreducibility on `Q/⟨z⟩`. Thus no general Fitting self-centralization theorem
is needed.

The theorem `isSimpleGroup_of_local` also exposes normality and
self-centralization as separate inputs. Both theorems need no additional
width bound, and therefore apply in particular to the source's
width-at-least-two case.

For a normal subgroup `N` omitting `z`, its intersection with `Q` is trivial,
so `C_N(z) = 1`. A distinct conjugate `t` in `Q` gives three conjugate
involutions `z`, `t`, and `zt`. Each acts on `N` by inversion; the third also
acts trivially, forcing `N = 1`. If `z ∈ N`, irreducibility and weak closure
force `Q ≤ N` and then `C_G(z) ≤ N`. A Sylow subgroup containing `Q` has
center `⟨z⟩`; the Frattini argument now gives `N = G`.
-/

open Subgroup
open scoped commutatorElement

namespace Theory.GroupTheory.ExtraspecialCentralizerSimplicity
variable {G : Type*} [Group G] [Finite G]

private theorem mem_line {z x : G} (hz : orderOf z = 2) (hx : x ∈ zpowers z) : x = 1 ∨ x = z := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, hz] at hx
  obtain ⟨n, hn, heq⟩ := Finset.mem_image.mp hx
  have hn2 := Finset.mem_range.mp hn
  interval_cases n <;> simp_all

private theorem center_image (z : G) (hz : orderOf z = 2) (Q : Subgroup G)
    [IsExtraspecial 2 Q] (hQH : Q ≤ centralizer ({z} : Set G))
    (hC : centralizer (Q : Set G) ≤ Q) :
    (center Q).map Q.subtype = zpowers z := by
  have hzC : z ∈ centralizer (Q : Set G) := by
    intro q hq
    exact mem_centralizer_singleton_iff.mp (hQH hq)
  have hzQ := hC hzC
  have hzZ : (⟨z, hzQ⟩ : Q) ∈ center Q :=
    mem_center_iff.mpr (fun q => Subtype.ext (hzC q q.property))
  apply (eq_of_le_of_card_ge (zpowers_le.mpr (mem_map_of_mem Q.subtype hzZ)) ?_).symm
  rw [card_map_of_injective Q.subtype_injective, IsExtraspecial.center_order_p 2 Q,
    Nat.card_zpowers]
  change 2 ≤ orderOf z
  omega

omit [Finite G] in
private theorem centralizer_eq_line (z : G) (Q : Subgroup G)
    (hZ : (center Q).map Q.subtype = zpowers z)
    (hC : centralizer (Q : Set G) ≤ Q) :
    centralizer (Q : Set G) = zpowers z := by
  rw [← hZ]
  apply le_antisymm
  · intro x hx
    exact ⟨⟨x, hC hx⟩, mem_center_iff.mpr (fun q => Subtype.ext (hx q q.property)), rfl⟩
  · rintro _ ⟨x, hx, rfl⟩ q hq
    exact congrArg Subtype.val (mem_center_iff.mp hx ⟨q, hq⟩)

private theorem normal_eq_top_of_centralizer_le (z : G) (hz : orderOf z = 2)
    (Q : Subgroup G) (hQ : IsPGroup 2 Q)
    (hZ : (center Q).map Q.subtype = zpowers z)
    (hC : centralizer (Q : Set G) ≤ Q)
    (N : Subgroup G) [N.Normal] (hHN : centralizer ({z} : Set G) ≤ N) : N = ⊤ := by
  have hzQ : z ∈ Q := by
    exact map_subtype_le (center Q) (hZ ▸ mem_zpowers z)
  obtain ⟨S, hQS⟩ := hQ.exists_le_sylow
  have hSnontriv : Nontrivial S := by
    apply (nontrivial_iff_ne_bot _).mpr
    intro heq
    have hz1 : z = 1 := by simpa [heq] using hQS hzQ
    simp [hz1] at hz
  let := hSnontriv
  have hZS : (center S).map (S : Subgroup G).subtype ≤ zpowers z := by
    rw [← centralizer_eq_line z Q hZ hC]
    rintro _ ⟨x, hx, rfl⟩ q hq
    exact congrArg Subtype.val (mem_center_iff.mp hx ⟨q, hQS hq⟩)
  have hZSeq : (center S).map (S : Subgroup G).subtype = zpowers z := by
    have : Nontrivial (center S) := S.isPGroup'.center_nontrivial
    apply eq_of_le_of_card_ge hZS
    rw [card_map_of_injective (S : Subgroup G).subtype_injective, Nat.card_zpowers, hz]
    exact Finite.one_lt_card
  have hSH : (S : Subgroup G) ≤ centralizer ({z} : Set G) := by
    obtain ⟨u, hu, he⟩ := mem_map.mp (hZSeq ▸ mem_zpowers z)
    change (u : G) = z at he
    intro s hs
    apply mem_centralizer_singleton_iff.mpr
    have hc := congrArg Subtype.val (mem_center_iff.mp hu (⟨s, hs⟩ : S))
    change s * (u : G) = (u : G) * s at hc
    simpa only [he] using hc
  have hnorm : normalizer (S : Set G) ≤ centralizer ({z} : Set G) :=
    normalizer_le_centralizer_of_characteristic_involution (S : Subgroup G)
      (center S) z hz hZSeq
  apply top_le_iff.mp
  rw [← S.normalizer_sup_eq_top' (hSH.trans hHN)]
  exact sup_le (hnorm.trans hHN) le_rfl

private theorem inf_eq_bot_of_not_mem (z : G) (hz : orderOf z = 2)
    (Q : Subgroup G) (hQ : IsPGroup 2 Q)
    (hZ : (center Q).map Q.subtype = zpowers z)
    (N : Subgroup G) [N.Normal] (hzN : z ∉ N) : N ⊓ Q = ⊥ := by
  have hD : N.subgroupOf Q = ⊥ := by
    by_contra hn
    have hc := center_inf_ne_bot_of_normal hQ (N.subgroupOf Q) hn
    apply hc
    apply (eq_bot_iff_forall _).mpr
    intro x hx
    have hxline : (x : G) ∈ zpowers z := hZ ▸ mem_map_of_mem Q.subtype hx.1
    rcases mem_line hz hxline with he | he
    · exact Subtype.ext he
    · exact (hzN (he ▸ hx.2)).elim
  apply (eq_bot_iff_forall _).mpr
  intro x hx
  have hm : (⟨x, hx.2⟩ : Q) ∈ N.subgroupOf Q := hx.1
  rw [hD, mem_bot] at hm
  exact congrArg Subtype.val hm

omit [Finite G] in
private theorem centralizer_inter_eq_one (z : G) (Q : Subgroup G)
    (hQnorm : centralizer ({z} : Set G) ≤ normalizer (Q : Set G))
    (hC : centralizer (Q : Set G) ≤ Q)
    (N : Subgroup G) [N.Normal] (hdis : N ⊓ Q = ⊥)
    (x : G) (hxN : x ∈ N) (hxH : x ∈ centralizer ({z} : Set G)) : x = 1 := by
  have hxC : x ∈ centralizer (Q : Set G) := by
    intro q hq
    have hcQ : ⁅x, q⁆ ∈ Q := Q.mul_mem
      ((mem_normalizer_iff.mp (hQnorm hxH) q).mp hq) (Q.inv_mem hq)
    have hcN : ⁅x, q⁆ ∈ N := by
      have := N.mul_mem hxN ((inferInstance : N.Normal).conj_mem x⁻¹ (N.inv_mem hxN) q)
      simpa only [commutatorElement_def, mul_assoc] using this
    have he : ⁅x, q⁆ = 1 := by
      have hm : ⁅x, q⁆ ∈ N ⊓ Q := ⟨hcN, hcQ⟩
      simpa only [hdis, mem_bot] using hm
    exact (commutatorElement_eq_one_iff_mul_comm.mp he).symm
  have hm : x ∈ N ⊓ Q := ⟨hxN, hC hxC⟩
  simpa only [hdis, mem_bot] using hm

private theorem normal_eq_bot_of_fused_triple (z t : G) (hz : orderOf z = 2)
    (ht : IsConj z t) (hzt : IsConj z (z * t))
    (N : Subgroup G) [N.Normal]
    (hfix : ∀ x ∈ N, x ∈ centralizer ({z} : Set G) → x = 1) : N = ⊥ := by
  have hfp (u : G) (hu : IsConj z u) : MonoidHom.FixedPointFree (MulAut.conjNormal u : MulAut N) := by
    obtain ⟨g, hg⟩ := isConj_iff.mp hu
    intro x hx
    have hx' : u * (x : G) * u⁻¹ = x := congrArg Subtype.val hx
    have hc : (g⁻¹ * (x : G) * g) ∈ centralizer ({z} : Set G) := by
      apply mem_centralizer_singleton_iff.mpr
      have he := mul_inv_eq_iff_eq_mul.mp hx'
      rw [← hg] at he
      have he' := congrArg (fun a => g⁻¹ * a * g) he
      group at he' ⊢
      exact he'.symm
    have hn : g⁻¹ * (x : G) * g ∈ N := by
      simpa using (inferInstance : N.Normal).conj_mem x x.property g⁻¹
    have he := hfix _ hn hc
    apply Subtype.ext
    change (x : G) = 1
    have := congrArg (fun a => g * a * g⁻¹) he
    simpa only [mul_assoc, mul_inv_cancel_left, inv_mul_cancel_left, mul_one,
      mul_inv_cancel] using this
  have hinv (u : G) (hu : IsConj z u) :
      ∀ x : N, (MulAut.conjNormal u : MulAut N) x = x⁻¹ := by
    apply congrFun
    apply (hfp u hu).coe_eq_inv_of_involutive
    have hu2 : u ^ 2 = 1 := by
      obtain ⟨g, rfl⟩ := isConj_iff.mp hu
      change (MulAut.conj g z) ^ 2 = 1
      rw [← map_pow, ← hz, pow_orderOf_eq_one, map_one]
    intro x
    apply Subtype.ext
    change u * (u * (x : G) * u⁻¹) * u⁻¹ = x
    calc
      _ = (u * u) * (x : G) * (u * u)⁻¹ := by group
      _ = x := by rw [← pow_two, hu2]; simp
  apply (eq_bot_iff_forall N).mpr
  intro x hx
  let a : N := ⟨x, hx⟩
  have ha : (MulAut.conjNormal (z * t) : MulAut N) a = a := by
    rw [map_mul, MulAut.mul_apply, hinv t ht, map_inv, hinv z (IsConj.refl z), inv_inv]
  exact congrArg Subtype.val (hfp (z * t) hzt a ha)

private theorem fused_triple_of_extraspecial (z : G) (hz : orderOf z = 2)
    (Q : Subgroup G) [IsExtraspecial 2 Q]
    (hZ : (center Q).map Q.subtype = zpowers z)
    (t : G) (htQ : t ∈ Q) (ht : IsConj z t) (htz : t ≠ z) : IsConj z (z * t) := by
  have ht1 : t ≠ 1 := by
    intro he
    obtain ⟨g, hg⟩ := isConj_iff.mp ht.symm
    have hz1 : z = 1 := by simpa only [he, mul_one, mul_inv_cancel] using hg.symm
    simp [hz1] at hz
  have htZ : (⟨t, htQ⟩ : Q) ∉ center Q := by
    intro hc
    have hm : t ∈ zpowers z := hZ ▸ mem_map_of_mem Q.subtype hc
    exact (mem_line hz hm).elim ht1 htz
  obtain ⟨q, hq⟩ : ∃ q : Q, q * ⟨t, htQ⟩ ≠ ⟨t, htQ⟩ * q := by
    simpa only [mem_center_iff, not_forall] using htZ
  have hcZ : ⁅q, (⟨t, htQ⟩ : Q)⁆ ∈ center Q :=
    (IsExtraspecial.quotient_elementary_abelian 2 Q).commutator_le_center_of_central_quotient
      (commutator_mem_commutator (mem_top _) (mem_top _))
  have hcne : ⁅q, (⟨t, htQ⟩ : Q)⁆ ≠ 1 :=
    fun he => hq (commutatorElement_eq_one_iff_mul_comm.mp he)
  have hcline : ((⁅q, (⟨t, htQ⟩ : Q)⁆ : Q) : G) ∈ zpowers z :=
    hZ ▸ mem_map_of_mem Q.subtype hcZ
  have hceq : ((⁅q, (⟨t, htQ⟩ : Q)⁆ : Q) : G) = z :=
    (mem_line hz hcline).resolve_left (fun he => hcne (Subtype.ext he))
  apply ht.trans
  apply isConj_iff.mpr
  refine ⟨q, ?_⟩
  rw [← hceq]
  simp only [commutatorElement_def, Subgroup.coe_mul, Subgroup.coe_inv, mul_assoc,
    inv_mul_cancel, mul_one]

/-- The subgroup generated by ambient `G`-conjugates of `z` lying in `H`. -/
@[expose] public def weakClosure (z : G) (H : Subgroup G) : Subgroup G :=
  closure {t : G | t ∈ H ∧ IsConj z t}

omit [Finite G] in
/-- Weak closure remains in its specified local subgroup. -/
public theorem weakClosure_le (z : G) (H : Subgroup G) : weakClosure z H ≤ H :=
  (closure_le _).mpr (fun _ ht => ht.1)

omit [Finite G] in
/-- Conjugation by `H` preserves the ambient weak closure in `H`. -/
public theorem le_normalizer_weakClosure (z : G) (H : Subgroup G) :
    H ≤ normalizer (weakClosure z H : Set G) := by
  apply le_normalizer_iff.mpr
  intro g hg
  change weakClosure z H ≤ (weakClosure z H).comap (MulAut.conj g).toMonoidHom
  apply (closure_le _).mpr
  intro t ht
  exact subset_closure ⟨H.mul_mem (H.mul_mem hg ht.1) (H.inv_mem hg),
    ht.2.trans (isConj_iff.mpr ⟨g, rfl⟩)⟩

omit [Finite G] in
/-- Every ambient normal subgroup containing `z` contains its local weak closure. -/
public theorem weakClosure_le_normal (z : G) (H N : Subgroup G) [N.Normal] (hz : z ∈ N) :
    weakClosure z H ≤ N := by
  apply (closure_le _).mpr
  intro t ht
  obtain ⟨g, rfl⟩ := isConj_iff.mp ht.2
  exact (inferInstance : N.Normal).conj_mem z hz g

/-- For an involution in `H`, weak closure as an element is equivalent to
its generated ambient weak closure being just the cyclic subgroup it generates. -/
public theorem weakClosure_eq_zpowers_iff (z : G) (hz : orderOf z = 2)
    (H : Subgroup G) (hzH : z ∈ H) :
    weakClosure z H = zpowers z ↔ ∀ t ∈ H, IsConj z t → t = z := by
  constructor
  · intro he t htH ht
    have htline : t ∈ zpowers z := he ▸ subset_closure ⟨htH, ht⟩
    rcases mem_line hz htline with ht1 | ht1
    · obtain ⟨g, hg⟩ := isConj_iff.mp ht.symm
      have hz1 : z = 1 := by simpa only [ht1, mul_one, mul_inv_cancel] using hg.symm
      simp [hz1] at hz
    · exact ht1
  · intro h
    apply le_antisymm
    · apply (closure_le _).mpr
      intro t ht
      rw [h t ht.1 ht.2]
      exact mem_zpowers z
    · exact zpowers_le.mpr (subset_closure ⟨hzH, IsConj.refl z⟩)

private theorem le_of_irreducible (z : G) (hz : orderOf z = 2) (H Q : Subgroup G)
    (hzQ : z ∈ Q) (hQnorm : H ≤ normalizer (Q : Set G))
    (hirr : ∀ R : Subgroup G, zpowers z ≤ R → R ≤ Q →
      H ≤ normalizer (R : Set G) → R = zpowers z ∨ R = Q)
    (t : G) (htQ : t ∈ Q) (ht : IsConj z t) (htz : t ≠ z)
    (R : Subgroup G) (hRnorm : H ≤ normalizer (R : Set G))
    (hzR : z ∈ R) (htR : t ∈ R) : Q ≤ R := by
  have hnorm : H ≤ normalizer ((R ⊓ Q : Subgroup G) : Set G) := by
    apply le_normalizer_iff.mpr
    intro g hg x hx
    exact ⟨(mem_normalizer_iff.mp (hRnorm hg) x).mp hx.1,
      (mem_normalizer_iff.mp (hQnorm hg) x).mp hx.2⟩
  rcases hirr (R ⊓ Q) (zpowers_le.mpr ⟨hzR, hzQ⟩) inf_le_right hnorm with he | he
  · have htline : t ∈ zpowers z := he ▸ (show t ∈ R ⊓ Q from ⟨htR, htQ⟩)
    rcases mem_line hz htline with ht1 | ht1
    · obtain ⟨g, hg⟩ := isConj_iff.mp ht.symm
      have hz1 : z = 1 := by simpa only [ht1, mul_one, mul_inv_cancel] using hg.symm
      simp [hz1] at hz
    · exact (htz ht1).elim
  · exact he ▸ inf_le_left

private theorem centralizer_le_normal_of_weakClosure (z : G) (hz : orderOf z = 2)
    (Q : Subgroup G) (hQH : Q ≤ centralizer ({z} : Set G))
    [hn : (Q.subgroupOf (centralizer ({z} : Set G))).Normal]
    [IsSimpleGroup ((centralizer ({z} : Set G)) ⧸ Q.subgroupOf (centralizer ({z} : Set G)))]
    (hzQ : z ∈ Q)
    (hirr : ∀ R : Subgroup G, zpowers z ≤ R → R ≤ Q →
      centralizer ({z} : Set G) ≤ normalizer (R : Set G) → R = zpowers z ∨ R = Q)
    (t : G) (htQ : t ∈ Q) (ht : IsConj z t) (htz : t ≠ z)
    (hweak : weakClosure z (centralizer ({z} : Set G)) ≠ Q)
    (N : Subgroup G) [N.Normal] (hzN : z ∈ N) : centralizer ({z} : Set G) ≤ N := by
  let H := centralizer ({z} : Set G)
  have hQnorm : H ≤ normalizer (Q : Set G) :=
    (normal_subgroupOf_iff_le_normalizer hQH).mp hn
  have hzH : z ∈ H := mem_centralizer_singleton_iff.mpr rfl
  have hQW : Q ≤ weakClosure z H := le_of_irreducible z hz H Q hzQ hQnorm hirr
    t htQ ht htz (weakClosure z H) (le_normalizer_weakClosure z H)
    (subset_closure ⟨hzH, IsConj.refl z⟩) (subset_closure ⟨hQH htQ, ht⟩)
  have hWN : weakClosure z H ≤ N := weakClosure_le_normal z H N hzN
  have hQN : Q ≤ N := hQW.trans hWN
  let K := Q.subgroupOf H
  let D := N.subgroupOf H
  let f := QuotientGroup.mk' K
  have hKD : K ≤ D := fun _ hx => hQN hx
  have hmapN : (D.map f).Normal := (inferInstance : D.Normal).map f (QuotientGroup.mk'_surjective K)
  rcases hmapN.eq_bot_or_eq_top with he | he
  · have hDK : D ≤ K := by
      have hd := (D.map_eq_bot_iff).mp he
      simpa only [f, QuotientGroup.ker_mk'] using hd
    apply False.elim
    apply hweak
    apply le_antisymm _ hQW
    intro w hw
    exact hDK (show (⟨w, weakClosure_le z H hw⟩ : H) ∈ D from hWN hw)
  · have hD : D = ⊤ := by
      have he' := congrArg (Subgroup.comap f) he
      rw [Subgroup.comap_map_eq, Subgroup.comap_top, QuotientGroup.ker_mk',
        sup_eq_left.mpr hKD] at he'
      exact he'
    intro x hx
    have hm : (⟨x, hx⟩ : H) ∈ D := by rw [hD]; trivial
    exact hm

/-- The local form of Aschbacher's Exercise 2.4.

Here `hfused` is precisely failure of weak closure of `z` in `Q` with
respect to the ambient group. The irreducibility hypothesis concerns only
subgroups of the extraspecial central quotient, not normal subgroups of `G`.
The hypotheses `hQH`, `hn`, and `hC` display the local containment, normality,
and self-centralization supplied by the source's generalized Fitting equality. -/
public theorem isSimpleGroup_of_local (z : G) (hz : orderOf z = 2)
    (Q : Subgroup G) [IsExtraspecial 2 Q]
    (hQH : Q ≤ centralizer ({z} : Set G))
    [hn : (Q.subgroupOf (centralizer ({z} : Set G))).Normal]
    [IsSimpleGroup ((centralizer ({z} : Set G)) ⧸ Q.subgroupOf (centralizer ({z} : Set G)))]
    (hC : centralizer (Q : Set G) ≤ Q)
    (hirr : ∀ R : Subgroup G, zpowers z ≤ R → R ≤ Q →
      centralizer ({z} : Set G) ≤ normalizer (R : Set G) → R = zpowers z ∨ R = Q)
    (hfused : ∃ t ∈ Q, IsConj z t ∧ t ≠ z)
    (hweak : weakClosure z (centralizer ({z} : Set G)) ≠ Q) : IsSimpleGroup G := by
  have hz1 : z ≠ 1 := by intro he; simp [he] at hz
  have : Nontrivial G := ⟨⟨z, 1, hz1⟩⟩
  have hZ := center_image z hz Q hQH hC
  have hzQ : z ∈ Q := map_subtype_le (center Q) (hZ ▸ mem_zpowers z)
  have hQ := IsExtraspecial.isPGroup 2 Q
  obtain ⟨t, htQ, ht, htz⟩ := hfused
  refine ⟨fun N hN => ?_⟩
  let := hN
  by_cases hzN : z ∈ N
  · right
    exact normal_eq_top_of_centralizer_le z hz Q hQ hZ hC N
      (centralizer_le_normal_of_weakClosure z hz Q hQH hzQ hirr t htQ ht htz hweak N hzN)
  · left
    have hdis := inf_eq_bot_of_not_mem z hz Q hQ hZ N hzN
    exact normal_eq_bot_of_fused_triple z t hz ht
      (fused_triple_of_extraspecial z hz Q hZ t htQ ht htz) N
      (centralizer_inter_eq_one z Q ((normal_subgroupOf_iff_le_normalizer hQH).mp hn) hC N hdis)


/-- The simple quotient and irreducibility force the normal extraspecial
subgroup to be self-centralizing once its central involution returns under fusion. -/
private theorem selfCentralizing_of_simple_quotient (z : G) (hz : orderOf z = 2)
    (Q : Subgroup G) [IsExtraspecial 2 Q]
    (hQH : Q ≤ centralizer ({z} : Set G)) (hzQ : z ∈ Q)
    [hn : (Q.subgroupOf (centralizer ({z} : Set G))).Normal]
    [IsSimpleGroup ((centralizer ({z} : Set G)) ⧸ Q.subgroupOf (centralizer ({z} : Set G)))]
    (hirr : ∀ R : Subgroup G, zpowers z ≤ R → R ≤ Q →
      centralizer ({z} : Set G) ≤ normalizer (R : Set G) → R = zpowers z ∨ R = Q)
    (hfused : ∃ t ∈ Q, IsConj z t ∧ t ≠ z) : centralizer (Q : Set G) ≤ Q := by
  let H := centralizer ({z} : Set G)
  let K := Q.subgroupOf H
  let C := centralizer (K : Set H)
  let f := QuotientGroup.mk' K
  have hZ : (center Q).map Q.subtype = zpowers z := by
    have hzZ : (⟨z, hzQ⟩ : Q) ∈ center Q := mem_center_iff.mpr fun q =>
      Subtype.ext (mem_centralizer_singleton_iff.mp (hQH q.property))
    apply (eq_of_le_of_card_ge (zpowers_le.mpr (mem_map_of_mem Q.subtype hzZ)) ?_).symm
    rw [card_map_of_injective Q.subtype_injective, IsExtraspecial.center_order_p 2 Q,
      Nat.card_zpowers]
    change 2 ≤ orderOf z
    omega
  have hmap : (C.map f).Normal := (inferInstance : C.Normal).map f (QuotientGroup.mk'_surjective K)
  rcases hmap.eq_bot_or_eq_top with he | he
  · have hCK : C ≤ K := by
      simpa only [f, QuotientGroup.ker_mk'] using (C.map_eq_bot_iff).mp he
    intro x hx
    have hxH : x ∈ H := mem_centralizer_singleton_iff.mpr (hx z hzQ).symm
    exact hCK (show (⟨x, hxH⟩ : H) ∈ C from fun q hq => Subtype.ext (hx q hq))
  · have hsup : C ⊔ K = ⊤ := by
      have hh := congrArg (Subgroup.comap f) he
      simpa only [Subgroup.comap_map_eq, Subgroup.comap_top, f, QuotientGroup.ker_mk'] using hh
    obtain ⟨t, htQ, ht, htz⟩ := hfused
    let R := Q ⊓ centralizer ({t} : Set G)
    have hzR : zpowers z ≤ R := zpowers_le.mpr
      ⟨hzQ, mem_centralizer_singleton_iff.mpr (mem_centralizer_singleton_iff.mp (hQH htQ)).symm⟩
    have hQR : Q ≤ normalizer (R : Set G) := by
      apply le_normalizer_iff_commutator_le_right.mpr
      apply commutator_le.mpr
      intro q hq r hr
      have hc : ⁅(⟨q, hq⟩ : Q), (⟨r, hr.1⟩ : Q)⁆ ∈ center Q :=
        (IsExtraspecial.quotient_elementary_abelian 2 Q).commutator_le_center_of_central_quotient
          (commutator_mem_commutator (mem_top _) (mem_top _))
      exact hzR (hZ ▸ mem_map_of_mem Q.subtype hc)
    have hHR : H ≤ normalizer (R : Set G) := by
      have hle : C ⊔ K ≤ (normalizer (R : Set G)).subgroupOf H := by
        apply sup_le
        · intro c hc
          apply centralizer_le_normalizer
          intro r hr
          exact congrArg Subtype.val (hc (⟨r, hQH hr.1⟩ : H) hr.1)
        · intro q hq
          exact hQR hq
      intro h hh
      exact hle (hsup ▸ (show (⟨h, hh⟩ : H) ∈ (⊤ : Subgroup H) from mem_top _))
    have htR : t ∈ R := ⟨htQ, mem_centralizer_singleton_iff.mpr rfl⟩
    have htline : t ∈ zpowers z := by
      rcases hirr R hzR inf_le_left hHR with hR | hR
      · exact hR ▸ htR
      · have htZ : (⟨t, htQ⟩ : Q) ∈ center Q := by
          apply mem_center_iff.mpr
          intro q
          have hqR : (q : G) ∈ R := by rw [hR]; exact q.property
          exact Subtype.ext (mem_centralizer_singleton_iff.mp hqR.2)
        exact hZ ▸ mem_map_of_mem Q.subtype htZ
    rcases mem_line hz htline with ht1 | ht1
    · obtain ⟨g, hg⟩ := isConj_iff.mp ht.symm
      have hz1 : z = 1 := by simpa only [ht1, mul_one, mul_inv_cancel] using hg.symm
      simp [hz1] at hz
    · exact (htz ht1).elim

/-- Aschbacher's Exercise 2.4, with `Q = F*(C_G(z))` expressed intrinsically.

The quotient simplicity hypothesis uses `F*(H)`; `hF` identifies it with `Q`
inside `H`. The subgroup-lattice condition `hirr` expresses irreducibility
on the elementary abelian quotient `Q/⟨z⟩`. Both fusion hypotheses use
ambient `G`-conjugacy, as encoded by `hfused` and `weakClosure`.
The source's width bound is unnecessary for this proof. -/
public theorem isSimpleGroup_of_generalizedFitting (z : G) (hz : orderOf z = 2)
    (Q : Subgroup G) [IsExtraspecial 2 Q]
    (hQH : Q ≤ centralizer ({z} : Set G))
    (hF : Q.subgroupOf (centralizer ({z} : Set G)) =
      Theory.GroupTheory.generalizedFitting (centralizer ({z} : Set G)))
    [IsSimpleGroup ((centralizer ({z} : Set G)) ⧸
      Theory.GroupTheory.generalizedFitting (centralizer ({z} : Set G)))]
    (hirr : ∀ R : Subgroup G, zpowers z ≤ R → R ≤ Q →
      centralizer ({z} : Set G) ≤ normalizer (R : Set G) → R = zpowers z ∨ R = Q)
    (hfused : ∃ t ∈ Q, IsConj z t ∧ t ≠ z)
    (hweak : weakClosure z (centralizer ({z} : Set G)) ≠ Q) : IsSimpleGroup G := by
  let H := centralizer ({z} : Set G)
  let : (Q.subgroupOf H).Normal := by rw [hF]; infer_instance
  let : IsSimpleGroup (H ⧸ Q.subgroupOf H) :=
    (MulEquiv.isSimpleGroup_congr (QuotientGroup.quotientMulEquivOfEq hF)).mpr inferInstance
  have hzH : z ∈ H := mem_centralizer_singleton_iff.mpr rfl
  have hzZ : (⟨z, hzH⟩ : H) ∈ center H := mem_center_iff.mpr fun h =>
    Subtype.ext (mem_centralizer_singleton_iff.mp h.property)
  have hnil : Group.IsNilpotent (center H) := by
    refine ⟨1, ?_⟩
    rw [Subgroup.upperCentralSeries_one_eq_top_iff]
    infer_instance
  have hZF : center H ≤ Theory.GroupTheory.generalizedFitting H :=
    (show center H ≤ fittingSubgroup H from le_sSup ⟨inferInstance, hnil⟩).trans
      (Theory.GroupTheory.fitting_le_generalizedFitting H)
  have hzQ : z ∈ Q := by
    have hm := hZF hzZ
    rw [← hF] at hm
    exact hm
  exact isSimpleGroup_of_local z hz Q hQH
    (selfCentralizing_of_simple_quotient z hz Q hQH hzQ hirr hfused) hirr hfused hweak
end Theory.GroupTheory.ExtraspecialCentralizerSimplicity
