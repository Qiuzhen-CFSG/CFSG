module
public import Theory.GroupAction.SmallQuotientCentralization
public import Mathlib.GroupTheory.Sylow

/-!
# Absorbing a projected commutator module

An abelian subgroup V normalized and generated by commutators with L lies
in L whenever its intersection with N(L) has index at most two: L acts
trivially on that small quotient, which first places V in N(L).
For a homomorphism faithful on a normal factor and on L, this argument
absorbs a projected module from the actual Sylow image back into that factor.

Source: the projection argument in Aschbacher–Smith 2.4.32, p.547.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {H : Type*} [Group H] [Finite H]

/-- The index-two normalizer condition absorbs the whole abelian commutator subgroup. -/
theorem commutator_subgroup_le_of_normalizer_index_le_two
    (V L : Subgroup H) [IsMulCommutative V]
    (hn : L ≤ normalizer (V : Set H)) (hc : ⁅V,L⁆ = V)
    (hi : (normalizer (L : Set H)).relIndex V ≤ 2) : V ≤ L := by
  have hnormal : ((normalizer (L : Set H)).subgroupOf V).Normal :=
    Subgroup.normal_of_isMulCommutative _
  have hL : L ≤ normalizer (normalizer (L : Set H) : Set H) :=
    L.le_normalizer.trans (normalizer (L : Set H)).le_normalizer
  have hh := commutator_le_of_normalized_quotient_card_le_two L V
    (normalizer (L : Set H)) hn hL hnormal
  have hcard : Nat.card (V ⧸ (normalizer (L : Set H)).subgroupOf V) ≤ 2 := by
    rw [←index_eq_card]
    exact hi
  have hv : V ≤ normalizer (L : Set H) := hc ▸ hh hcard
  rw [←hc]
  apply commutator_le.mpr
  intro v hvV l hl
  exact L.mul_mem ((mem_normalizer_iff.mp (hv hvV) l).mp hl) (L.inv_mem hl)

/-- A faithful abelian commutator module whose image lies in a normal
factor is absorbed when its actual Sylow normalizer has index at most two. -/
theorem module_le_normal_factor_of_image
    {A : Type*} [Group A] (K L U S : Subgroup H) [K.Normal]
    [IsMulCommutative U] (f : H →* A)
    (hfK : Function.Injective (f.comp K.subtype))
    (hfL : Function.Injective (f.comp L.subtype))
    (hUL : U ≤ L) (hUS : U ≤ S) (hS : IsPGroup 2 S)
    (P : Sylow 2 K) (hPS : (P : Subgroup K).map K.subtype ≤ S)
    (hc : ⁅U,L⁆ = U) (himage : U.map f ≤ K.map f)
    (hi : (normalizer (L : Set H)).relIndex S ≤ 2) : U ≤ K := by
  let fK := f.comp K.subtype
  let W := (U.map f).comap fK
  let V := W.map K.subtype
  have hVK : V ≤ K := map_subtype_le _
  have hm : V.map f = U.map f := by
    rw [show V = W.map K.subtype from rfl,map_map]
    exact map_comap_eq_self (by simpa only [MonoidHom.range_comp,range_subtype] using himage)
  have hWcomm : IsMulCommutative W := (U.map f).comap_injective_isMulCommutative hfK
  let := hWcomm
  let : IsMulCommutative V := inferInstanceAs (IsMulCommutative (W.map K.subtype))
  have map_inj {X Y : Subgroup H} (hX : X ≤ K) (hY : Y ≤ K)
      (he : X.map f = Y.map f) : X = Y := by
    have hle {X Y : Subgroup H} (hX : X ≤ K) (hY : Y ≤ K)
        (he : X.map f ≤ Y.map f) : X ≤ Y := by
      intro x hx
      obtain ⟨y,hy,hyx⟩ := he (mem_map_of_mem f hx)
      have hh : (⟨y,hY hy⟩ : K) = ⟨x,hX hx⟩ := hfK hyx
      have hyx' : y = x := congrArg Subtype.val hh
      exact hyx' ▸ hy
    exact le_antisymm (hle hX hY he.le) (hle hY hX he.ge)
  have hcV : ⁅V,L⁆ = V := by
    refine map_inj ?_ hVK ?_
    · exact (commutator_mono hVK le_top).trans
        (le_normalizer_iff_commutator_le_left.mp (by rw [normalizer_eq_top]))
    · rw [map_commutator,hm,←map_commutator,hc]
  have hVS : V ≤ S := by
    let D := (S.map f).comap fK
    have hpD : IsPGroup 2 D := (hS.map f).comap_of_injective fK hfK
    have hPD : (P : Subgroup K) ≤ D := by
      intro k hk
      exact mem_map_of_mem f (hPS (mem_map_of_mem K.subtype hk))
    have heD : D = (P : Subgroup K) := P.is_maximal' hpD hPD
    rintro v ⟨k,hk,rfl⟩
    have hkD : k ∈ D := map_mono hUS hk
    rw [heD] at hkD
    exact hPS (mem_map_of_mem K.subtype hkD)
  have hVL : V ≤ L := commutator_subgroup_le_of_normalizer_index_le_two V L
    (le_normalizer_iff_commutator_le_left.mpr hcV.le) hcV
    ((relIndex_le_of_le_right hVS index_ne_zero_of_finite).trans hi)
  intro u hu
  obtain ⟨v,hv,hvu⟩ := hm.symm ▸ mem_map_of_mem f hu
  have hh : (⟨v,hVL hv⟩ : L) = ⟨u,hUL hu⟩ := hfL hvu
  have hvu' : v = u := congrArg Subtype.val hh
  exact hvu' ▸ hVK hv
end Theory.GroupTheory
