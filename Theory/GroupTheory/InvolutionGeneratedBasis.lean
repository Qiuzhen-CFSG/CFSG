module

public import Theory.ElementaryAbelian.VectorSpace
public import Mathlib.LinearAlgebra.Basis.VectorSpace
public import Mathlib.LinearAlgebra.Dimension.Finite
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# Choosing a binary quotient basis with involutory lifts

If a group is generated by square-one elements, the images of those elements
span every binary vector quotient. A basis can therefore be chosen among
their images. This retains the given quotient map, and supplies the two
involutions used to select the elementary factors in source 14.3.18(4).
-/

public section
namespace MonoidHom
open Subgroup

theorem exists_basis_with_square_one_lifts
    {D I : Type*} [Group D] [AddCommGroup I] [Module (ZMod 2) I]
    [Finite I] (f : D →* Multiplicative I) (hf : Function.Surjective f)
    (hgen : closure {x : D | x ^ 2 = 1} = ⊤)
    (n : ℕ) (hdim : Module.finrank (ZMod 2) I = n) :
    ∃ b : Module.Basis (Fin n) (ZMod 2) I,
      ∀ i, ∃ x : D, x ^ 2 = 1 ∧ (f x).toAdd = b i := by
  classical
  let S : Set I := {v | ∃ x : D, x ^ 2 = 1 ∧ (f x).toAdd = v}
  have hspan : ⊤ ≤ Submodule.span (ZMod 2) S := by
    let P := (Submodule.span (ZMod 2) S).toAddSubgroup.toSubgroup
    have hP : closure {x : D | x ^ 2 = 1} ≤ P.comap f := by
      apply (Subgroup.closure_le _).mpr
      intro x hx
      exact Submodule.subset_span ⟨x,hx,rfl⟩
    rw [hgen] at hP
    intro v _
    obtain ⟨x,hx⟩ := hf (Multiplicative.ofAdd v)
    have hh := hP (mem_top x)
    change (f x).toAdd ∈ Submodule.span (ZMod 2) S at hh
    rwa [hx] at hh
  let b₀ := Module.Basis.ofSpan hspan
  let J := (linearIndepOn_empty (ZMod 2) (@_root_.id I)).extend (Set.empty_subset S)
  let : Fintype J := Fintype.ofFinite J
  have hcard : Fintype.card J = n := by
    rw [← Module.finrank_eq_card_basis b₀]
    exact hdim
  let e : J ≃ Fin n := Fintype.equivFinOfCardEq hcard
  refine ⟨b₀.reindex e, ?_⟩
  intro i
  have hi : b₀ (e.symm i) ∈ S := Module.Basis.ofSpan_subset hspan ⟨e.symm i,rfl⟩
  rw [Module.Basis.reindex_apply]
  exact hi

end MonoidHom
