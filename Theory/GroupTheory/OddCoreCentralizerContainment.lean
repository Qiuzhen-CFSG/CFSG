module

public import Theory.GroupTheory.Involution.Basic
public import Theory.PPrimeCore
public import Theory.GroupAction.AbelianCoprimeFullFixedGeneration
public import Mathlib.GroupTheory.Sylow
public import Theory.GroupTheory.PGroup.Omega

/-!
# Odd cores controlled by central involution centralizers

Let `S` be a Sylow two-subgroup with noncyclic `Ω₁(Z(S))`. If the ambient
centralizer of each central involution of `S` lies in `M`, then for every
`u ∈ S` the odd core of `C_G(u)`, mapped into `G`, also lies in `M`.

The elementary abelian group `Ω₁(Z(S))` acts by conjugation on that odd core.
Coprime fixed-point generation expresses the core as generated by fixed
subgroups of actor subgroups with cyclic quotient. Each such actor subgroup
is nontrivial and contains a central involution, whose centralizer lies in `M`.
The core is normal only in `C_G(u)`; no ambient normality is assumed.

Source: GLS, Volume 4, Chapter 2, the last paragraph of Proposition 4.3
(`refs/KGroup/GLS4/Chapter2.tex`, lines 711–719), citing [IG; 11.23].
-/

open Subgroup
open scoped IsMulCommutative
namespace Theory.GroupTheory
open BenderSuzuki.PFAppendixIII

universe u
variable {G : Type u} [Group G] [Finite G] {M : Subgroup G}

/-- Coprime generation puts the odd core of a Sylow element centralizer in `M`
when the central involution centralizers all lie in `M`. -/
public theorem centralizer_oddCore_le_of_noncyclic_omega_center
    (S : Sylow 2 G) (u : G) (hu : u ∈ (S : Subgroup G))
    (hncyc : ¬ IsCyclic (omega₁ (Subgroup.center S) (p := 2)))
    (hcentral : ∀ v : G, IsInvolution v → v ∈ (S : Subgroup G) →
      (∀ s : S, Commute v (s : G)) → Subgroup.centralizer ({v} : Set G) ≤ M) :
    (pPrimeCore 2 (Subgroup.centralizer ({u} : Set G))).map
      (Subgroup.centralizer ({u} : Set G)).subtype ≤ M := by
  let C := Subgroup.centralizer ({u} : Set G)
  let Y := pPrimeCore 2 C
  let A := omega₁ (Subgroup.center S) (p := 2)
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.omega₁_of_isMulCommutative _
  let f : A →* C :=
    { toFun := fun a => ⟨(((a : Subgroup.center S) : S) : G),
        mem_centralizer_singleton_iff.mpr
          (congrArg Subtype.val (mem_center_iff.mp (a : Subgroup.center S).property
            ⟨u, hu⟩)).symm⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  let act : A →* MulAut Y := (MulAut.conjNormal : C →* MulAut Y).comp f
  let : MulDistribMulAction A Y := MulDistribMulAction.compHom Y act
  let : Fact (IsPGroup 2 A) :=
    ⟨(S.isPGroup'.to_subgroup (Subgroup.center S)).to_subgroup A⟩
  have hgen := iSup_fixedPoints_cyclicQuot_eq_top_of_coprime_abelian_pGroup_action
    (G := Y) (A := A) 2 pPrimeCore_coprime_card
  have hle : (⊤ : Subgroup Y) ≤ (M.comap C.subtype).comap Y.subtype := by
    rw [← hgen]
    refine iSup₂_le fun B hB => ?_
    have hBne : B ≠ ⊥ := by
      intro he
      subst B
      let : IsCyclic (A ⧸ (⊥ : Subgroup A)) := hB
      exact hncyc (isCyclic_of_surjective
        (QuotientGroup.quotientBot (G := A)) QuotientGroup.quotientBot.surjective)
    obtain ⟨a, haB, ha⟩ := B.bot_or_exists_ne_one.resolve_left hBne
    intro y hy
    have hfix := (show ∀ b : B, b • y = y from hy) ⟨a, haB⟩
    let v : G := (((a : Subgroup.center S) : S) : G)
    have hv : IsInvolution v := by
      refine ⟨?_, ?_⟩
      · intro he
        exact ha (Subtype.ext (Subtype.ext (Subtype.ext he)))
      · have hp : a ^ 2 = 1 := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
          (IsElementaryAbelian.exponent_dvd_p 2 A) a
        exact congrArg (fun a : A => (((a : Subgroup.center S) : S) : G)) hp
    have hvc : ∀ s : S, Commute v (s : G) := by
      intro s
      exact (show Commute (s : G) v from
        congrArg Subtype.val (mem_center_iff.mp (a : Subgroup.center S).property s)).symm
    apply hcentral v hv ((a : Subgroup.center S) : S).property hvc
    apply mem_centralizer_singleton_iff.mpr
    have he : v * ((y : C) : G) * v⁻¹ = ((y : C) : G) :=
      congrArg (fun y : Y => ((y : C) : G)) hfix
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  rintro x ⟨y, hy, rfl⟩
  exact hle (mem_top (⟨y, hy⟩ : Y))

end Theory.GroupTheory
