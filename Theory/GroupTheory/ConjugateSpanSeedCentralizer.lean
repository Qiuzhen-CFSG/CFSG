module
public import Theory.GroupTheory.ConjugateSpanSylow
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Centralizing an axis from bounds on conjugate seeds

Suppose [C_G(V₃), V] lies in a line V₁, and H normalizes U and V₁ with
U generated by the H-conjugates of V₃. An axis D in U centralizing `U.conjBy y`
centralizes every seed conjugated by `y * h`, for h in H, whenever that
seed lies in H and U meets `V₁.conjBy y` trivially: the commutator lies
in both of these subgroups.
It therefore centralizes the entire conjugate of the H-span of V.
For a line of order two, noncontainment in U supplies the disjointness.

All subgroups and the conjugator remain in the original ambient group;
no ambient normality is assumed. Source application: Aschbacher–Smith,
The Classification of Quasithin Groups, 13.8.32(3), printed p.965, using
the seed centralizer bound from 13.5.4(4). Conjugation is left conjugation.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G]

private theorem centralizer_conj (V : Subgroup G) (z : G) :
    (centralizer (V:Set G)).conjBy z = centralizer (V.conjBy z : Set G) := by
  let e := MulAut.conj z
  apply le_antisymm (map_centralizer_le_centralizer_image _ _)
  intro x hx
  refine ⟨e.symm x,?_,e.apply_symm_apply x⟩
  intro v hv
  apply e.injective
  simpa only [map_mul,e.apply_symm_apply] using hx (e v) (mem_map_of_mem e.toMonoidHom hv)

/-- The seed centralizer bound propagates over the original conjugates:
their commutators with the axis lie in both U_H and the disjoint critical
line, hence vanish. -/
theorem conjugateSpanBy_centralizes_axis_of_seed
    (H UH V1 V3 V D : Subgroup G) (hD : D ≤ UH)
    (hnU : H ≤ normalizer (UH:Set G)) (hn1 : H ≤ normalizer (V1:Set G))
    (hspanU : UH = conjugateSpanBy V3 H)
    (hseed : ⁅centralizer (V3:Set G),V⁆ ≤ V1)
    (y : G) (hupper : (conjugateSpanBy V H).conjBy y ≤ H)
    (haxis : D ≤ centralizer (UH.conjBy y : Set G))
    (hdisjoint : UH ⊓ V1.conjBy y = ⊥) :
    (conjugateSpanBy V H).conjBy y ≤ centralizer (D:Set G) := by
  rw [conjBy,conjugateSpanBy_eq_iSup_conj,Subgroup.map_iSup]
  apply iSup_le
  intro h
  change (V.conjBy (h:G)).conjBy y ≤ _
  have hV3 : V3.conjBy (h:G) ≤ UH := by
    rw [hspanU]
    rintro _ ⟨v,hv,rfl⟩
    exact subset_closure ⟨h,h.property,v,hv,rfl⟩
  have hsmall : V3.conjBy (y*(h:G)) ≤ UH.conjBy y := by
    rw [←conjBy_conjBy]
    exact map_mono hV3
  have hline : V1.conjBy (y*(h:G)) = V1.conjBy y := by
    have he : V1.conjBy (h:G) = V1 := mem_normalizer_iff_map_conj_eq.mp (hn1 h.property)
    rw [←conjBy_conjBy,he]
  have hVH : V.conjBy (y*(h:G)) ≤ H := by
    apply le_trans ?_ hupper
    rw [←conjBy_conjBy]
    apply map_mono
    rintro _ ⟨v,hv,rfl⟩
    exact subset_closure ⟨h,h.property,v,hv,rfl⟩
  have hc : ⁅D,V.conjBy (y*(h:G))⁆ ≤ V1.conjBy y := by
    have hm := map_mono (f := (MulAut.conj (y*(h:G))).toMonoidHom) hseed
    rw [map_commutator] at hm
    change ⁅(centralizer (V3:Set G)).conjBy (y*(h:G)),V.conjBy (y*(h:G))⁆ ≤
      V1.conjBy (y*(h:G)) at hm
    rw [centralizer_conj,hline] at hm
    exact (commutator_mono (haxis.trans (centralizer_le hsmall)) le_rfl).trans hm
  have hu : ⁅D,V.conjBy (y*(h:G))⁆ ≤ UH :=
    (commutator_mono hD le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp (hVH.trans hnU))
  have hb : ⁅D,V.conjBy (y*(h:G))⁆ = ⊥ :=
    bot_unique ((le_inf hu hc).trans_eq hdisjoint)
  rw [conjBy_conjBy]
  exact le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hb)

/-- The excluded critical line supplies disjointness, so the earlier source
seed bound proves the required upper-group centralization of the axis. -/
theorem conjugateSpanBy_centralizes_axis_of_line_not_le [Finite G]
    (H UH V1 V3 V D : Subgroup G) (hD : D ≤ UH)
    (hnU : H ≤ normalizer (UH:Set G)) (hn1 : H ≤ normalizer (V1:Set G))
    (hspanU : UH = conjugateSpanBy V3 H)
    (hseed : ⁅centralizer (V3:Set G),V⁆ ≤ V1)
    (hV1 : Nat.card V1 = 2)
    (y : G) (hupper : (conjugateSpanBy V H).conjBy y ≤ H)
    (haxis : D ≤ centralizer (UH.conjBy y : Set G))
    (hline : ¬ V1.conjBy y ≤ UH) :
    (conjugateSpanBy V H).conjBy y ≤ centralizer (D:Set G) := by
  have hcard : Nat.card (V1.conjBy y) = 2 :=
    (card_map_of_injective (MulAut.conj y).injective).trans hV1
  have hd : Nat.card (UH ⊓ V1.conjBy y : Subgroup G) ∣ 2 :=
    hcard ▸ card_dvd_of_le (inf_le_right : UH ⊓ V1.conjBy y ≤ V1.conjBy y)
  have hb : UH ⊓ V1.conjBy y = ⊥ := by
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with hc | hc
    · exact card_eq_one.mp hc
    · have he : UH ⊓ V1.conjBy y = V1.conjBy y :=
        eq_of_le_of_card_ge inf_le_right (by rw [hc,hcard])
      exact False.elim (hline (he ▸ inf_le_left))
  exact conjugateSpanBy_centralizes_axis_of_seed H UH V1 V3 V D hD hnU hn1 hspanU hseed
    y hupper haxis hb
end Subgroup
