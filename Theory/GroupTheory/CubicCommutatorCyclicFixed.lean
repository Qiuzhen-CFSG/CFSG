module
public import Theory.GroupTheory.OddCyclicThreeNormalizer
public import Theory.GroupTheory.CoprimeCentralizerDirectProduct
public import Theory.GroupTheory.PrimeRankProduct
public import Theory.GroupTheory.PrimeRankCyclicSylow
public import Theory.GroupTheory.Commutator.NormalGeneration
public import Theory.ElementaryAbelian.CommutingFamily

/-!
# Cubic involution commutators and cyclic fixed subgroups

An involution with order-three commutator in a finite three-group gives a
coprime decomposition. The normal cubic commutator is centralized by the
three-group; if the fixed subgroup is cyclic, the whole group is abelian of
three-rank at most two. Once the actor is generated by such involutions,
its commutator with this abelian group is elementary abelian.

Source application: Aschbacher–Smith D.2.26–29, printed pp.191–192.
-/

public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- The literal displacement and fixed subgroups form a commuting direct product. -/
theorem threeGroup_structure_of_cubic_commutator_cyclic_fixed
    (P : Subgroup G) (hP : IsPGroup 3 P) (t : G) (ht : orderOf t = 2)
    (hn : t ∈ normalizer (P : Set G))
    (hcard : Nat.card (⁅P,zpowers t⁆ : Subgroup G) = 3)
    (hcyc : IsCyclic (P ⊓ centralizer ({t} : Set G) : Subgroup G)) :
    IsMulCommutative P ∧
    P = ⁅P,zpowers t⁆ ⊔ (P ⊓ centralizer ({t} : Set G)) ∧
    Disjoint ⁅P,zpowers t⁆ (P ⊓ centralizer ({t} : Set G)) ∧
    ⁅P,zpowers t⁆ ≤ centralizer (P : Set G) ∧
    primeRank 3 P ≤ 2 := by
  let F := ⁅P,zpowers t⁆
  let C := P ⊓ centralizer ({t} : Set G)
  let : IsCyclic F := isCyclic_of_prime_card hcard
  let : IsCyclic C := hcyc
  have hpodd : Nat.Coprime 2 (Nat.card P) := by
    obtain ⟨k,hk⟩ := hP.exists_card_eq
    rw [hk]
    exact Nat.Coprime.pow_right k (by decide)
  have hcop : Nat.Coprime (Nat.card (zpowers t)) (Nat.card P) := by
    rwa [Nat.card_zpowers,ht]
  have hnorm : zpowers t ≤ normalizer (P : Set G) := zpowers_le.mpr hn
  have hdec : P = F ⊔ C := by
    simpa only [F,C,zpowers_eq_closure,centralizer_closure] using
      eq_commutator_sup_centralizer_of_solvable_coprime P (zpowers t) hnorm
        (@IsNilpotent.to_isSolvable P _ hP.isNilpotent) hcop
  have hFP : F ≤ centralizer (P : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp
      (commutator_eq_bot_of_odd_normalizes_card_three F P hcard hpodd
        (normalizer_commutator_ge_left _ _))
  have hFC : F ≤ centralizer (C : Set G) := hFP.trans (centralizer_le inf_le_left)
  have hCP : C ≤ centralizer (P : Set G) := by
    apply le_centralizer_iff.mpr
    rw [hdec]
    exact sup_le hFC (le_centralizer C)
  have hab : IsMulCommutative P := le_centralizer_iff_isMulCommutative.mp
    (hdec.le.trans (sup_le hFP hCP))
  let := hab
  have hdis : Disjoint F C := by
    simpa only [F,C,zpowers_eq_closure,centralizer_closure] using
      commutator_disjoint_centralizer_of_coprime P (zpowers t) hnorm hcop
  have hF_rank : primeRank 3 F ≤ 1 := by
    let Q : Sylow 3 F := Classical.choice inferInstance
    exact Q.primeRank_le_one_of_isCyclic inferInstance
  have hC_rank : primeRank 3 C ≤ 1 := by
    let Q : Sylow 3 C := Classical.choice inferInstance
    exact Q.primeRank_le_one_of_isCyclic inferInstance
  refine ⟨hab,hdec,hdis,hFP,?_⟩
  rw [hdec,primeRank_sup_eq_add_of_disjoint_commuting F C hdis hFC]
  omega

omit [Finite G] in
/-- Cubic commutators of a generating family give an elementary global commutator. -/
theorem commutator_elementary_of_generated_cubic
    (P : Subgroup G) [P.Normal] [IsMulCommutative P]
    (s : Set G) (hgen : closure s = ⊤)
    (hcard : ∀ t ∈ s, Nat.card (⁅P,zpowers t⁆ : Subgroup G) = 3) :
    IsElementaryAbelian 3 (⁅P,⊤⁆ : Subgroup G) := by
  have hgen' : (⨆ t : s,zpowers (t : G)) = ⊤ := by
    apply top_unique
    rw [←hgen]
    apply (closure_le _).mpr
    intro t ht
    exact (le_iSup (fun t : s => zpowers (t : G)) ⟨t,ht⟩) (mem_zpowers t)
  rw [←hgen',commutator_iSup_of_normal_left]
  let F (t : s) := ⁅P,zpowers (t : G)⁆
  let : ∀ t : s, IsCyclic (F t) := fun t => isCyclic_of_prime_card (hcard t t.property)
  let : ∀ t : s, IsElementaryAbelian 3 (F t) := fun t => {
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr fun x => by
      rw [←hcard t t.property]
      exact pow_card_eq_one' }
  exact IsElementaryAbelian.iSup_of_le_centralizer F (fun _ _ =>
    (commutator_le_left _ _).trans ((le_centralizer P).trans
      (centralizer_le (commutator_le_left _ _))))

end Subgroup
