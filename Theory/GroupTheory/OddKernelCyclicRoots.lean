module

public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Cyclic roots of an involution modulo an odd kernel

Quotienting by an odd-order normal subgroup preserves the assertion that
the cyclic subgroup generated by an element contains a commuting involution.
If a power is equal to the involution modulo the kernel, raise this equation
to the odd order of the kernel. The kernel factor disappears while the
involution is unchanged.

This is the elementary support transfer for the inflated local characters
used in ABG III.2 and Wong's involution-root induction argument.
-/

namespace QuotientGroup

/-- Odd normal kernels preserve cyclic roots of a commuting element whose
square is one. Centrality in the whole group is unnecessary. -/
public theorem involution_mem_zpowers_iff
    {H : Type*} [Group H] (N : Subgroup H) [N.Normal]
    (hN : Odd (Nat.card N)) (z h : H) (hz : z ^ 2 = 1) (hzh : Commute z h) :
    mk' N z ∈ Subgroup.zpowers (mk' N h) ↔ z ∈ Subgroup.zpowers h := by
  constructor
  · rintro ⟨n, hn⟩
    change (mk' N h) ^ n = mk' N z at hn
    have hk : z⁻¹ * h ^ n ∈ N := by
      apply (eq_one_iff _).mp
      change (mk' N) (z⁻¹ * h ^ n) = 1
      rw [map_mul, map_inv, map_zpow, hn, inv_mul_cancel]
    let k : N := ⟨z⁻¹ * h ^ n, hk⟩
    have he : h ^ n = z * (k : H) := by simp [k]
    have hc : Commute z (k : H) :=
      (Commute.refl z).inv_right.mul_right (hzh.zpow_right n)
    have hkpow : (k : H) ^ Nat.card N = 1 :=
      congrArg Subtype.val (pow_card_eq_one' (x := k))
    have hzpow : z ^ Nat.card N = z := by
      obtain ⟨m, hm⟩ := hN
      rw [hm, pow_add, pow_mul, hz]
      simp
    refine ⟨n * (Nat.card N : ℤ), ?_⟩
    change h ^ (n * (Nat.card N : ℤ)) = z
    rw [zpow_mul, zpow_natCast, he, hc.mul_pow, hzpow, hkpow, mul_one]
  · rintro ⟨n, rfl⟩
    exact ⟨n, (map_zpow (mk' N) h n).symm⟩

end QuotientGroup
