module

public import Theory.GroupTheory.ConjugateSpanSylow
public import Theory.GroupTheory.AbelianConjugateSpan
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Stellmacher.ElementaryAbelianMaxGlobal

/-!
# Global Thompson generation and selection of a moved component

Sylow conjugacy identifies the global elementary Thompson subgroup with
the span of the conjugates of the Thompson subgroup of a fixed Sylow
2-subgroup. This retains the maximum-order elementary-subgroup convention.

If a nontrivial perfect normal span lies in the component layer, its seed
cannot centralize every component: normality would propagate centralization
to the full span, making it both perfect and abelian. If the seed normalizes
every component, the component commutator dichotomy consequently selects
a component generated by those commutators.

Source: the component-selection argument following Aschbacher–Smith
13.6.13, combined manuscript of 1 March 2004, printed p.929. The
classification and component-normalization assertions remain separate inputs.
-/

public section

open Subgroup
namespace Stellmacher
variable {G : Type*} [Group G] [Finite G]

/-- Sylow conjugacy generates exactly the global elementary Thompson subgroup. -/
theorem elementaryAbelianMaxJ_eq_conjugateSpan_sylow (S : Sylow 2 G) :
    elementaryAbelianMaxJ (⊤ : Subgroup G) =
      conjugateSpanBy (elementaryAbelianMaxJ (S : Subgroup G)) ⊤ := by
  let J := elementaryAbelianMaxJ (⊤ : Subgroup G)
  let X := conjugateSpanBy (elementaryAbelianMaxJ (S : Subgroup G)) ⊤
  let : J.Characteristic := elementaryAbelianMaxJ_top_characteristic
  have hn : X.Normal := normalizer_eq_top_iff.mp
    (top_unique (le_normalizer_conjugateSpanBy _ ⊤))
  apply le_antisymm
  · apply sSup_le
    intro A hA x hx
    obtain ⟨P, hAP⟩ := hA.2.1.isPGroup.exists_le_sylow
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G P S
    let e := MulAut.conj g
    have hPS : (P : Subgroup G).map e.toMonoidHom = (S : Subgroup G) := by
      change ((g • P : Sylow 2 G) : Subgroup G) = (S : Subgroup G)
      rw [hg]
    have hAg : A.map e.toMonoidHom ∈ elementaryAbelianMaxSubgroups (S : Subgroup G) := by
      refine ⟨(map_mono hAP).trans hPS.le, hA.2.1.map e.toMonoidHom, ?_⟩
      intro B _ hB
      rw [card_map_of_injective e.injective]
      exact hA.2.2 B le_top hB
    have hxg : g * x * g⁻¹ ∈ X :=
      le_conjugateSpanBy _ _ (le_sSup hAg (mem_map_of_mem e.toMonoidHom hx))
    have hback := hn.conj_mem _ hxg g⁻¹
    simpa only [inv_inv, mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using hback
  · apply conjugateSpanBy_le (elementaryAbelianMaxJ_sylow_le_top S)
    change (⊤ : Subgroup G) ≤ normalizer (J : Set G)
    rw [normalizer_eq_top]

end Stellmacher

namespace Theory.GroupTheory
variable {G : Type*} [Group G]

/-- Select a moved component from a nontrivial perfect normal span in the layer. -/
theorem exists_component_commutator_eq_self_of_perfect_span
    (A : Subgroup G)
    (hnorm : ∀ E : Subgroup G, IsComponent G E → A ≤ normalizer (E : Set G))
    (hle : conjugateSpanBy A ⊤ ≤ componentLayer G)
    [Group.IsPerfect (conjugateSpanBy A ⊤)]
    (hne : conjugateSpanBy A ⊤ ≠ ⊥) :
    ∃ E : Subgroup G, IsComponent G E ∧ ⁅E, A⁆ = E := by
  classical
  have hex : ∃ E : Subgroup G, IsComponent G E ∧ ⁅E, A⁆ ≠ ⊥ := by
    by_contra hf
    have hcent : componentLayer G ≤ centralizer (A : Set G) := by
      apply sSup_le
      intro E hE
      apply commutator_eq_bot_iff_le_centralizer.mp
      by_contra hc
      exact hf ⟨E, hE, hc⟩
    let X := conjugateSpanBy A ⊤
    have hXn : (⊤ : Subgroup G) ≤ normalizer (X : Set G) := le_normalizer_conjugateSpanBy _ _
    have hc : X ≤ centralizer (X : Set G) :=
      le_centralizer_conjugateSpanBy_of_normalizes X A ⊤ hXn (hle.trans hcent)
    have hb : ⁅X, X⁆ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr hc
    rw [commutator_eq_self] at hb
    exact hne hb
  obtain ⟨E, hE, hEA⟩ := hex
  rcases hE.commutator_dichotomy A with hb | he
  · exact (hEA hb).elim
  · refine ⟨E, hE, le_antisymm
      (le_normalizer_iff_commutator_le_left.mp (hnorm E hE)) ?_⟩
    exact (le_iSup_conjugates E A).trans he.symm.le

end Theory.GroupTheory
