module
public import Theory.GroupTheory.CentralExtensionSections
public import Mathlib.GroupTheory.PGroup

/-!
# Central kernels in groups generated by p-subgroups

If the derived covering kernel and the abelianization are p-groups, so is
the entire central kernel: raise a kernel element into the derived group,
then use its p-power order there. The abelianization hypothesis is supplied
by generation by two p-subgroups. This isolates the elementary extension
step in Aschbacher–Smith E.2.10(7), printed p.223.
-/
public section
open Subgroup
open scoped IsMulCommutative
namespace CentralExtension

theorem kernel_isPGroup_of_derived_kernel
    {E B : Type*} [Group E] [Group B] [Group.IsPerfect B]
    {p : ℕ} (f : E →* B) (hf : Function.Surjective f) (hc : f.ker ≤ center E)
    (hD : IsPGroup p (derivedCover f hf hc).toMonoidHom.ker)
    (hA : IsPGroup p (E ⧸ commutator E)) : IsPGroup p f.ker := by
  intro x
  let q := QuotientGroup.mk' (commutator E)
  obtain ⟨a, ha⟩ := hA (q x)
  have hxD : (x : E) ^ p ^ a ∈ commutator E := by
    apply (QuotientGroup.eq_one_iff _).mp
    change q ((x : E) ^ p ^ a) = 1
    rw [map_pow]
    exact ha
  let y : (derivedCover f hf hc).toMonoidHom.ker :=
    ⟨⟨(x : E) ^ p ^ a, hxD⟩, by
      change f ((x : E) ^ p ^ a) = 1
      rw [map_pow, x.property, one_pow]⟩
  obtain ⟨b, hb⟩ := hD y
  refine ⟨a+b, Subtype.ext ?_⟩
  have hb' := congrArg (fun z : (derivedCover f hf hc).toMonoidHom.ker => ((z : commutator E) : E)) hb
  simpa only [y, Subgroup.coe_pow, Subgroup.coe_one, pow_add, pow_mul] using hb'


theorem abelian_image_isPGroup_of_sup
    {E Q : Type*} [Group E] [Group Q] [IsMulCommutative Q] {p : ℕ}
    (V W : Subgroup E) (hV : IsPGroup p V) (hW : IsPGroup p W)
    (hgen : V ⊔ W = ⊤) (q : E →* Q) (hq : Function.Surjective q) :
    IsPGroup p Q := by
  have ht := (hV.map q).to_sup_of_normal_right (hW.map q)
  rw [← Subgroup.map_sup, hgen, ← MonoidHom.range_eq_map,
    MonoidHom.range_eq_top.mpr hq] at ht
  exact ht.of_equiv topEquiv

end CentralExtension

