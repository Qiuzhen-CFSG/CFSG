module
public import Theory.GroupTheory.ElementaryPairFixedPoints
public import Theory.GroupTheory.Commutator.ElementaryQuotientIndexTwoQuadratic
/-!
# Quadratic displacement in a group generated by an elementary pair

If two elementary abelian 2-subgroups generate R and one is normalized by R,
then every square lies in R′. Thus any quotient killing R′ is elementary
abelian. An involution normalizing R and a central subgroup Z containing R′
acts quadratically on R/Z, giving [[R,t],t] ≤ Z.

Source application: the stability of the coset tZ(R) in Aschbacher–Smith,
Lemma 2.4.14(1), printed p.533.
-/
public section
open scoped Pointwise IsMulCommutative commutatorElement
namespace Subgroup
variable {G : Type*} [Group G]
theorem elementary_pair_quotient
    (R U V Z : Subgroup G) [IsElementaryAbelian 2 U] [IsElementaryAbelian 2 V]
    (hgen : U ⊔ V = R) (hRU : R ≤ normalizer (U : Set G))
    (hder : ⁅R,R⁆ ≤ Z) (hN : (Z.subgroupOf R).Normal) :
    let _ := hN; IsElementaryAbelian 2 (R ⧸ Z.subgroupOf R) := by
  let _ := hN
  have hUR : U ≤ R := le_sup_left.trans_eq hgen
  have hVR : V ≤ R := le_sup_right.trans_eq hgen
  have hsquare : ∀ r ∈ R, r^2 ∈ Z := by
    intro r hr
    have hp : r ∈ (U : Set G) * (V : Set G) := by
      rw [←coe_mul_of_right_le_normalizer_left U V (hVR.trans hRU), hgen]
      exact hr
    obtain ⟨u, hu, v, hv, rfl⟩ := hp
    have hu2 : u*u=1 := by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p:=2) u hu
    have hv2 : v*v=1 := by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p:=2) v hv
    have hui : u⁻¹=u := inv_eq_of_mul_eq_one_left hu2
    have hvi : v⁻¹=v := inv_eq_of_mul_eq_one_left hv2
    have he : (u*v)^2=⁅u,v⁆ := by rw [commutatorElement_def,hui,hvi,pow_two]; group
    rw [he]
    exact hder (commutator_mem_commutator (hUR hu) (hVR hv))
  have hpow : ∀ q : R ⧸ Z.subgroupOf R, q^2=1 := by
    intro q
    obtain ⟨r,rfl⟩ := QuotientGroup.mk'_surjective (Z.subgroupOf R) q
    rw [←map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (hsquare r r.property)
  have hi (q : R ⧸ Z.subgroupOf R) : q⁻¹=q :=
    inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hpow q)
  exact {
    toIsMulCommutative := ⟨⟨fun x y => by
      calc x*y=(x*y)⁻¹ := (hi _).symm
           _=y*x := by rw [mul_inv_rev,hi,hi]⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hpow }

theorem elementary_pair_double_commutator_le
    (R U V Z : Subgroup G) [IsElementaryAbelian 2 U] [IsElementaryAbelian 2 V]
    (hgen : U ⊔ V = R) (hRU : R ≤ normalizer (U : Set G))
    (hder : ⁅R,R⁆ ≤ Z) (hZR : Z ≤ R) (hcent : Z ≤ centralizer (R : Set G))
    (t : G) (ht : t^2=1) (htR : t ∈ normalizer (R : Set G))
    (htZ : t ∈ normalizer (Z : Set G)) :
    ⁅⁅R,zpowers t⁆,zpowers t⁆ ≤ Z := by
  by_cases ht1 : t=1
  · subst t
    simp
  have hN : (Z.subgroupOf R).Normal :=
    normal_subgroupOf_of_le_normalizer ((le_centralizer_iff.mp hcent).trans (centralizer_le_normalizer _))
  have hidx : (⊥ : Subgroup G).relIndex (zpowers t) = 2 := by
    rw [relIndex_bot_left,Nat.card_zpowers]
    exact orderOf_eq_prime ht ht1
  exact commutator_commutator_le_of_elementary_quotient_index_two R Z ⊥ (zpowers t)
    hZR (zpowers_le.mpr htR) (zpowers_le.mpr htZ) hN
    (elementary_pair_quotient R U V Z hgen hRU hder hN) bot_le hidx (by simp)
end Subgroup
