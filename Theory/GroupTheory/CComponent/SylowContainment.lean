module

public import Theory.GroupTheory.CComponent.CommutatorDichotomy
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.GroupTheory.CComponent.SylowRadical

/-!
# Full-Sylow containment in a commuting component layer

A local C-component B already in the ambient component layer normalizes each
ambient component. If none contains B, the full commutator dichotomy in B sup T
makes every factor Sylow intersection commute with B modulo the local radical.
The exact Sylow intersection of the component layer is generated by these
factor intersections. Hence B's actual Sylow subgroup would act trivially
modulo that radical, contradicting the even order of its nonabelian simple
radical quotient. Pairwise commutation and perfectness then give uniqueness.

The full ambient Sylow, original local overgroup and literal subgroup maps are
retained. In particular, no trivial-two-core premise on B sup T is needed.

Source application: Aschbacher--Smith, A.3.12, first assertion, pp.47--48.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- A local component in a commuting component layer lies in a unique factor, for the full Sylow. -/
theorem existsUnique_cComponent_of_local_of_le_layer
    (T : Sylow 2 G) (B : Subgroup G)
    (hB : (B.subgroupOf (B ⊔ (T : Subgroup G))).IsCComponent)
    (hBH : B ≤ cComponentLayer G)
    (heven : Even (Nat.card ((B.subgroupOf (B ⊔ (T : Subgroup G))) ⧸
      solvableRadical (B.subgroupOf (B ⊔ (T : Subgroup G))))))
    (hcomm : ∀ C D : Subgroup G, C.IsCComponent → D.IsCComponent → C ≠ D → ⁅C, D⁆ = ⊥) :
    ∃! L : Subgroup G, L.IsCComponent ∧ B ≤ L := by
  classical
  let M := B ⊔ (T : Subgroup G)
  let B₀ := B.subgroupOf M
  have hB₀ : B₀.IsCComponent := hB
  have hBM : B ≤ M := le_sup_left
  have hTM : (T : Subgroup G) ≤ M := le_sup_right
  let : Group.IsPerfect B₀ := hB₀.perfect
  let : Group.IsPerfect B := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hBM).toMonoidHom) (subgroupOfEquivOfLe hBM).surjective
  have hBne : B ≠ ⊥ := by
    intro he
    apply hB₀.ne_bot
    simp only [B₀, he, bot_subgroupOf]
  have hex : ∃ L : Subgroup G, L.IsCComponent ∧ B ≤ L := by
    by_contra! hn
    let I := {L : Subgroup G // L.IsCComponent}
    let U : Subgroup G := (T : Subgroup G) ⊓ cComponentLayer G
    let D (i : I) : Subgroup G := (T : Subgroup G) ⊓ i.val
    have hDM (i : I) : D i ≤ M := inf_le_left.trans hTM
    have hUM : U ≤ M := inf_le_left.trans hTM
    have hsplit : U = ⨆ i, D i := by
      change (T : Subgroup G) ⊓ sSup {L : Subgroup G | L.IsCComponent} = _
      rw [sSup_eq_iSup']
      apply sylow_inf_iSup_of_commuting_subnormal T (fun i : I => i.val)
        (fun i => i.property.subnormal)
      intro i j hne x y hx hy
      exact ((commutator_eq_bot_iff_le_centralizer.mp
        (hcomm i.val j.val i.property j.property
          (fun he => hne (Subtype.ext he)))) hx y hy).symm
    have hrad (i : I) : ⁅B₀, (D i).subgroupOf M⁆ ≤ solvableRadical M := by
      rcases hB₀.commutator_le_radical_or_eq_iSup_conjugates ((D i).subgroupOf M)
        with hr | he
      · exact hr
      · have hbc : B₀ ≤ ⁅B₀, (D i).subgroupOf M⁆ :=
          (le_iSup_conjugates _ _).trans_eq he.symm
        have hmap := map_mono (f := M.subtype) hbc
        rw [map_commutator, map_subgroupOf_eq_of_le hBM,
          map_subgroupOf_eq_of_le (hDM i)] at hmap
        exact (hn i.val i.property (hmap.trans
          ((commutator_mono le_rfl inf_le_right).trans
            (le_normalizer_iff_commutator_le_right.mp
              (hBH.trans (cComponentLayer_le_normalizer i.property)))))).elim
    have hsplitM : U.subgroupOf M = ⨆ i, (D i).subgroupOf M := by
      apply map_injective M.subtype_injective
      rw [map_subgroupOf_eq_of_le hUM, map_iSup]
      simpa only [map_subgroupOf_eq_of_le (hDM _)] using hsplit
    let q := QuotientGroup.mk' (solvableRadical M)
    have hq (i : I) : ((D i).subgroupOf M).map q ≤ centralizer (B₀.map q : Set _) := by
      apply le_centralizer_iff.mp
      apply commutator_eq_bot_iff_le_centralizer.mp
      rw [← map_commutator, map_eq_bot_iff, QuotientGroup.ker_mk']
      exact hrad i
    have hu : (U.subgroupOf M).map q ≤ centralizer (B₀.map q : Set _) := by
      rw [hsplitM, map_iSup]
      exact iSup_le hq
    have hucomm : ⁅B₀, U.subgroupOf M⁆ ≤ solvableRadical M := by
      have hz : ⁅B₀, U.subgroupOf M⁆.map q = ⊥ := by
        rw [map_commutator]
        exact commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hu)
      simpa only [map_eq_bot_iff, QuotientGroup.ker_mk', q] using hz
    let TM := T.subtype hTM
    obtain ⟨S, hS⟩ := TM.exists_subgroupOf_eq_of_subnormal B₀ hB₀.subnormal
    have hSU : (S : Subgroup B₀).map B₀.subtype ≤ U.subgroupOf M := by
      rintro x ⟨s, hs, rfl⟩
      have hsT : (s : M) ∈ (TM : Subgroup M) := by
        change s ∈ (TM : Subgroup M).subgroupOf B₀
        rwa [← hS]
      exact ⟨hsT, hBH s.property⟩
    exact hB₀.not_sylow_commutator_le_solvableRadical heven S
      ((commutator_mono le_rfl hSU).trans hucomm)
  obtain ⟨L, hL, hBL⟩ := hex
  refine ⟨L, ⟨hL, hBL⟩, ?_⟩
  intro K hK
  by_contra hne
  apply hBne
  apply le_bot_iff.mp
  calc
    B = ⁅B, B⁆ := B.commutator_eq_self.symm
    _ ≤ ⁅K, L⁆ := commutator_mono hK.2 hBL
    _ = ⊥ := hcomm K L hK.1 hL hne

end Subgroup
