module

public import Theory.GroupTheory.CComponent.RadicalFree
public import Theory.GroupTheory.CComponent.SolvableQuotient
public import Theory.GroupTheory.Commutator.PerfectLocalReduction

/-!
# The full C-component commutator dichotomy

Modulo the solvable radical, a C-component is simple and the commutator
either vanishes or contains that component. In the latter case its preimage
contains the original component modulo a solvable subgroup. The commutator
is normalized by the component, so perfectness removes this solvable error.
Normalization by the other factor then gives the entire conjugate closure.

This lifts the radical-free result to the full assertion needed in the
index-two local-component argument.

Source: Aschbacher–Smith, combined manuscript, 1 March 2004,
Proposition A.3.3(7), pp.42–43, and Lemma 1.2.5, p.505.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

private theorem perfect_le_of_solvable_error (B C R : Subgroup G)
    [Group.IsPerfect B] [R.Normal] [Group.IsSolvable R]
    (hn : B ≤ normalizer (C : Set G)) (hle : B ≤ C ⊔ R) : B ≤ C := by
  let J := B ⊔ C
  have hBJ : B ≤ J := le_sup_left
  have hCJ : C ≤ J := le_sup_right
  let : (C.subgroupOf J).Normal := normal_subgroupOf_of_le_normalizer
    (sup_le hn C.le_normalizer)
  let q := QuotientGroup.mk' (C.subgroupOf J)
  let : Group.IsPerfect (B.subgroupOf J) := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hBJ).symm.toMonoidHom)
    (subgroupOfEquivOfLe hBJ).symm.surjective
  let : Group.IsSolvable (R.subgroupOf J) :=
    Group.isSolvable_of_isSolvable_injective
      (f := J.subtype.subgroupComap R)
      (fun a b h => Subtype.ext (Subtype.ext (congrArg (fun r : R => (r : G)) h)))
  let : Group.IsSolvable ((R.subgroupOf J).map q) :=
    Group.isSolvable_of_surjective (q.subgroupMap_surjective _)
  have himage : (B.subgroupOf J).map q ≤ (R.subgroupOf J).map q := by
    rintro x ⟨b, hb, rfl⟩
    obtain ⟨c, hc, r, hr, he⟩ := mem_sup_of_normal_right.mp (hle hb)
    change c * r = (b : G) at he
    have hrJ : r ∈ J := by
      have hh := J.mul_mem (J.inv_mem (hCJ hc)) b.property
      rwa [← he, inv_mul_cancel_left] at hh
    refine ⟨⟨r, hrJ⟩, hr, ?_⟩
    have heJ : (⟨c, hCJ hc⟩ : J) * ⟨r, hrJ⟩ = b := Subtype.ext he
    have hqc : q ⟨c, hCJ hc⟩ = 1 := (QuotientGroup.eq_one_iff _).mpr hc
    rw [← heJ, map_mul, hqc, one_mul]
  have hker : B.subgroupOf J ≤ q.ker := by
    by_contra hnot
    exact map_not_le_of_isPerfect_of_isSolvable (B.subgroupOf J) q hnot
      ((R.subgroupOf J).map q) himage
  rw [QuotientGroup.ker_mk'] at hker
  intro b hb
  exact hker (show (⟨b, hBJ hb⟩ : J) ∈ B.subgroupOf J from hb)

/-- A.3.3(7): either the commutator lies in the solvable radical, or it is
the subgroup generated by all conjugates under the second factor. -/
theorem IsCComponent.commutator_le_radical_or_eq_iSup_conjugates [Finite G]
    {B : Subgroup G} (hB : B.IsCComponent) (D : Subgroup G) :
    ⁅B, D⁆ ≤ solvableRadical G ∨
      ⁅B, D⁆ = ⨆ d : D, B.map (MulAut.conj (d : G)).toMonoidHom := by
  let q := QuotientGroup.mk' (solvableRadical G)
  rcases (hB.map_quotient (solvableRadical G)).commutator_eq_bot_or_eq_iSup_conjugates_of_solvableRadical_eq_bot
        (solvableRadical_quotient_solvableRadical (G := G)) (D.map q) with hz | he
  · left
    have hm : ⁅B, D⁆.map q = ⊥ := (map_commutator B D q).trans hz
    simpa only [map_eq_bot_iff, q, QuotientGroup.ker_mk'] using hm
  · right
    let := hB.perfect
    have hm : B.map q ≤ ⁅B, D⁆.map q := by
      rw [map_commutator, he]
      exact le_iSup_conjugates _ _
    have hsup : B ≤ ⁅B, D⁆ ⊔ solvableRadical G := by
      simpa only [comap_map_eq, q, QuotientGroup.ker_mk'] using map_le_iff_le_comap.mp hm
    have hBC : B ≤ ⁅B, D⁆ := perfect_le_of_solvable_error B ⁅B, D⁆ (solvableRadical G)
      (normalizer_commutator_ge_left B D) hsup
    exact le_antisymm (commutator_le_iSup_conjugates B D)
      (iSup_conjugates_le_of_le_normalizer B D ⁅B, D⁆ hBC
        (normalizer_commutator_ge_right B D))

end Subgroup
