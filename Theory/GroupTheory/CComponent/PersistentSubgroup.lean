module
public import Theory.GroupTheory.CComponent.PrimeGroupOvergroup
public import Theory.GroupTheory.CharacteristicCentralizerFusion
public import Theory.GroupTheory.PerfectCentralCoverQuasisimple
public import Theory.GroupTheory.GeneralizedFitting.SylowOvergroup
public import Theory.GroupTheory.GeneralizedFitting.CentralizerViaCComponents

/-! A C-component with quasisimple two-core quotient and trivial odd core
is ordinary if a faithful nonsolvable subgroup persists as a C-component
in every characteristic-two subgroup generated with a suitable Sylow group.
Adjoin the specified two-group, then use the subgroup generated by the seed
and a full Sylow subgroup. Persistence makes the seed centralize the original
two-core, and C-component minimality promotes this to centrality in the whole
component. Source: Aschbacher–Smith 2.4.25, printed p.542. -/

public section
open Subgroup Theory.GroupTheory
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

theorem IsCComponent.component_of_persistence_of_oddCore_eq_bot
    {K L R : Subgroup G} (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)] (ho : pPrimeCore 2 K = ⊥)
    (hLK : L ≤ K) (hLn : ¬ Group.IsSolvable L)
    (hd : Disjoint L (pCore 2 G)) (hR : IsPGroup 2 R)
    (hRK : R ≤ normalizer (K : Set G))
    (hpersist : ∀ (X : Subgroup G),
      centralizer (pCore 2 X : Set X) ≤ pCore 2 X → ∀ P : Sylow 2 X,
      R ≤ (P : Subgroup X).map X.subtype →
      X = L ⊔ (P : Subgroup X).map X.subtype → (L.subgroupOf X).IsCComponent) :
    IsComponent G K := by
  by_contra hn
  let J := K ⊔ R
  have hKJ : K ≤ J := le_sup_left
  have hLJ : L ≤ J := hLK.trans hKJ
  have hRJ : R ≤ J := le_sup_right
  let : (K.subgroupOf J).Normal := normal_subgroupOf_of_le_normalizer
    (sup_le K.le_normalizer hRK)
  have hoK : pPrimeCore 2 (K.subgroupOf J) = ⊥ := by
    apply (map_eq_bot_iff_of_injective _ (f := (subgroupOfEquivOfLe hKJ).toMonoidHom) (subgroupOfEquivOfLe hKJ).injective).mp
    rw [pPrimeCore_map_iso,ho]
  have hgen : K.subgroupOf J ⊔ R.subgroupOf J = ⊤ := codisjoint_subgroupOf_sup K R |>.eq_top
  have hoJ : pPrimeCore 2 J = ⊥ := pPrimeCore_eq_bot_of_isPGroup_quotient 2
    (K.subgroupOf J) hoK
    (isPGroup_quotient_of_sup_eq_top _ _ hR.comap_subtype hgen)
  have hno : ¬ IsComponent J (K.subgroupOf J) := by
    intro hh
    let := hh.2
    exact hn ⟨hK.subnormal,IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe hKJ)⟩
  have he : componentLayer J = ⊥ := componentLayer_eq_bot_of_cComponent_pGroup_generators
    (hK.subgroupOf hKJ) hR.comap_subtype hgen hno
  have hf : generalizedFitting J = pCore 2 J := by
    rw [generalizedFitting,he,sup_bot_eq,Fitting_eq_pcore J 2 hoJ]
  have hcJ : centralizer (pCore 2 J : Set J) ≤ pCore 2 J :=
    hf ▸ centralizer_generalizedFitting_le J
  have hRJp : IsPGroup 2 (R.subgroupOf J) := hR.comap_subtype
  obtain ⟨P,hRP⟩ := hRJp.exists_le_sylow
  let A := (P : Subgroup J).map J.subtype
  let X := L ⊔ A
  have hAX : A ≤ X := le_sup_right
  have hXJ : X ≤ J := sup_le hLJ (map_subtype_le _)
  have hRPA : R ≤ A := by
    intro r hr
    exact mem_map_of_mem J.subtype (hRP (show (⟨r,hRJ hr⟩:J)∈R.subgroupOf J from hr))
  have hPrange : (P : Subgroup J) ≤ (inclusion hXJ).range := by
    intro p hp
    exact ⟨⟨p,hAX (mem_map_of_mem J.subtype hp)⟩,rfl⟩
  let PX : Sylow 2 X := P.comapOfInjective (inclusion hXJ) (inclusion_injective _) hPrange
  have hPX : (PX : Subgroup X).map X.subtype = A := by
    ext g
    constructor
    · rintro ⟨x,hx,rfl⟩
      exact mem_map_of_mem J.subtype hx
    · rintro ⟨p,hp,rfl⟩
      exact ⟨⟨p,hAX (mem_map_of_mem J.subtype hp)⟩,hp,rfl⟩
  have hcX : centralizer (pCore 2 X : Set X) ≤ pCore 2 X := by
    apply (Theory.Quasithin.centralizer_pCore_le_iff 2 (subgroupOfEquivOfLe hXJ)).mp
    apply centralizer_pCore_le_of_pCore_le _ hcJ
    intro q hq
    exact hAX (mem_map_of_mem J.subtype ((pCore_isPGroup.le_sylow_of_normal P) hq))
  have hLX : (L.subgroupOf X).IsCComponent := hpersist X hcX PX
    (hPX.symm ▸ hRPA) (by rw [hPX])
  let Q := (pCore 2 K).map K.subtype
  have hQG : Q ≤ pCore 2 G := pCoreIn_le_of_subnormal 2 hK.subnormal
  have hQJ : Q ≤ (pCore 2 J).map J.subtype :=
    pCoreAmbient_mono_of_isSubnormalIn K J 2 hKJ (inferInstance : (K.subgroupOf J).Normal).isSubnormal
  have hQX : Q ≤ X := hQJ.trans ((map_mono (pCore_isPGroup.le_sylow_of_normal P)).trans hAX)
  have hNQ : X ≤ normalizer (Q : Set G) := hXJ.trans
    ((sup_le K.le_normalizer hRK).trans (normalizer_le_normalizer_characteristic_image K (pCore 2 K)))
  let : (Q.subgroupOf X).Normal := normal_subgroupOf_of_le_normalizer hNQ
  let : Group.IsNilpotent (Q.subgroupOf X) :=
    ((pCore_isPGroup (p:=2) (G:=K)).map K.subtype).comap_subtype.isNilpotent
  have hcomm : ⁅L.subgroupOf X,Q.subgroupOf X⁆ = ⊥ := by
    apply bot_unique
    intro x hx
    have hl := hLX.commutator_le_of_solvable (Q.subgroupOf X)
      (by rw [normalizer_eq_top]; exact le_top) hx
    have hq := commutator_le_right (L.subgroupOf X) (Q.subgroupOf X) hx
    exact mem_bot.mpr (Subtype.ext (disjoint_def.mp hd hl (hQG hq)))
  have hLC : L ≤ centralizer (Q : Set G) := by
    intro l hl q hq
    exact congrArg Subtype.val ((commutator_eq_bot_iff_le_centralizer.mp hcomm)
      (show (⟨l,mem_sup_left hl⟩:X)∈L.subgroupOf X from hl)
      ⟨q,hQX hq⟩ hq)
  let C := (centralizer (pCore 2 K : Set K))
  have hC : C = ⊤ := by
    by_contra hC
    let : Group.IsSolvable C := hK.isSolvable_of_subnormal_lt_top
      (inferInstance : C.Normal).isSubnormal hC
    let f : L →* C := {
      toFun l := ⟨⟨l,hLK l.property⟩,fun q hq =>
        Subtype.ext (hLC l.property q (mem_map_of_mem K.subtype hq))⟩
      map_one' := rfl
      map_mul' _ _ := rfl }
    exact hLn (Group.isSolvable_of_isSolvable_injective (f:=f)
      (fun x y he => Subtype.ext (congrArg (fun v:C => ((v:K):G)) he)))
  have hQc : pCore 2 K ≤ center K := by
    intro q hq
    apply mem_center_iff.mpr
    intro k
    exact ((show k ∈ C from hC ▸ mem_top k) q hq).symm
  have hquasi : IsQuasisimple K :=
    (show PerfectCentralCovering.Cover K (K ⧸ pCore 2 K) from {
      toMonoidHom := QuotientGroup.mk' (pCore 2 K)
      surjective := QuotientGroup.mk'_surjective _
      isPerfect := hK.perfect
      ker_le_center := by simpa only [QuotientGroup.ker_mk'] using hQc }).isQuasisimple
  exact hn ⟨hK.subnormal,hquasi⟩
end Subgroup
