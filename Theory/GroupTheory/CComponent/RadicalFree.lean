module

public import Theory.GroupTheory.CComponent.Radical
public import Theory.GroupTheory.SolvableRadical.Transport
public import Theory.GroupTheory.Covering
public import Theory.GroupTheory.Commutator.SimpleSubnormal

/-!
# C-components in groups with trivial solvable radical

Radical transport makes every subnormal subgroup radical-free. A C-component
is consequently simple. Conversely, a quasisimple subnormal subgroup has
trivial center, hence is simple and minimal among nontrivial subnormal
subgroups. Thus C-components are exactly the ordinary components in this case.

The simple-subnormal calculus shows that distinct components commute, that
each is normal in their generated subgroup, and that its commutator with an
arbitrary subgroup is trivial or the subgroup generated by its conjugates.
Perfectness and normalization of that conjugate-generated subgroup are
provided by `Commutator.SimpleSubnormal`.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Proposition A.3.3(5)–(7), printed pp. 42–43 (1 March 2004 manuscript).
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace Subgroup
variable {G : Type*} [Group G] [Finite G] {L : Subgroup G}

/-- A subnormal subgroup of a finite radical-free group is radical-free. -/
theorem solvableRadical_eq_bot_of_isSubnormal (hG : solvableRadical G = ⊥) (hL : L.IsSubnormal) :
    solvableRadical L = ⊥ := by
  apply (map_eq_bot_iff_of_injective _ L.subtype_injective).mp
  exact le_bot_iff.mp (hG ▸ map_solvableRadical_subtype_le_of_isSubnormal hL)

/-- A subnormal subgroup of a finite radical-free group has trivial center. -/
theorem center_eq_bot_of_isSubnormal_of_solvableRadical_eq_bot (hG : solvableRadical G = ⊥) (hL : L.IsSubnormal) :
    center L = ⊥ := by
  have h := le_solvableRadical (center L) inferInstance
    (Group.isSolvable_of_comm (fun a b => Subtype.ext (Subgroup.mem_center_iff.mp a.property b).symm))
  rw [solvableRadical_eq_bot_of_isSubnormal hG hL] at h
  exact le_bot_iff.mp h

/-- A C-component in a radical-free finite group is simple. -/
theorem IsCComponent.isSimpleGroup_of_solvableRadical_eq_bot (hL : L.IsCComponent)
    (hG : solvableRadical G = ⊥) : IsSimpleGroup L := by
  let := hL.isSimpleGroup_quotient_solvableRadical
  exact ((QuotientGroup.quotientMulEquivOfEq (solvableRadical_eq_bot_of_isSubnormal hG hL.subnormal)).trans
    QuotientGroup.quotientBot).symm.isSimpleGroup

/-- An ordinary component in a radical-free finite group is simple. -/
theorem isSimpleGroup_of_isQuasisimple_of_solvableRadical_eq_bot (hG : solvableRadical G = ⊥)
    (hL : L.IsSubnormal) [hq : IsQuasisimple L] : IsSimpleGroup L := by
  let := hq.simple
  exact ((QuotientGroup.quotientMulEquivOfEq (center_eq_bot_of_isSubnormal_of_solvableRadical_eq_bot hG hL)).trans
    QuotientGroup.quotientBot).symm.isSimpleGroup

omit [Finite G] in
/-- A simple perfect subnormal subgroup is a C-component, without a finiteness assumption. -/
theorem isCComponent_of_isSimpleGroup_of_isPerfect (hL : L.IsSubnormal)
    [IsSimpleGroup L] [Group.IsPerfect L] : L.IsCComponent := by
  refine ⟨(nontrivial_iff_ne_bot L).mp inferInstance, inferInstance, hL, ?_⟩
  intro K hKL hK _ hs
  rcases hs.subgroupOf.eq_bot_or_top_of_isSimpleGroup (inferInstance : IsSimpleGroup L) with hb | ht
  · have he := congrArg (Subgroup.map L.subtype) hb
    exact (hK (by simpa [map_subgroupOf_eq_of_le hKL] using he)).elim
  · have he := congrArg (Subgroup.map L.subtype) ht
    exact (show K = L by simpa [map_subgroupOf_eq_of_le hKL, ← MonoidHom.range_eq_map] using he).ge

/-- In a radical-free finite group, C-components are exactly quasisimple subnormal subgroups. -/
theorem isCComponent_iff_isSubnormal_and_isQuasisimple_of_solvableRadical_eq_bot (hG : solvableRadical G = ⊥) :
    L.IsCComponent ↔ L.IsSubnormal ∧ IsQuasisimple L := by
  constructor
  · intro hL
    let := hL.perfect
    let := hL.isSimpleGroup_of_solvableRadical_eq_bot hG
    refine ⟨hL.subnormal, { simple := ?_ }⟩
    exact ((QuotientGroup.quotientMulEquivOfEq (center_eq_bot_of_isSubnormal_of_solvableRadical_eq_bot hG hL.subnormal)).trans
      QuotientGroup.quotientBot).isSimpleGroup
  · rintro ⟨hs, hq⟩
    let := hq
    let := isSimpleGroup_of_isQuasisimple_of_solvableRadical_eq_bot hG hs
    exact isCComponent_of_isSimpleGroup_of_isPerfect hs

/-- The simple C-components of a radical-free finite group are nonabelian. -/
theorem IsCComponent.not_isMulCommutative_of_solvableRadical_eq_bot (hL : L.IsCComponent)
    (hG : solvableRadical G = ⊥) : ¬ IsMulCommutative L := by
  let := hL.isSimpleGroup_of_solvableRadical_eq_bot hG
  let := hL.perfect
  exact Group.IsPerfect.not_isMulCommutative L

/-- Distinct C-components of a radical-free finite group commute. -/
theorem IsCComponent.commutator_eq_bot_of_ne_of_solvableRadical_eq_bot (hL : L.IsCComponent)
    (hG : solvableRadical G = ⊥) {K : Subgroup G} (hK : K.IsCComponent) (hne : L ≠ K) :
    ⁅L, K⁆ = ⊥ := by
  let := hL.isSimpleGroup_of_solvableRadical_eq_bot hG
  let := hK.isSimpleGroup_of_solvableRadical_eq_bot hG
  let := hL.perfect
  exact simple_subnormal_commute_of_ne L K hL.subnormal hK.subnormal hne

/-- The subgroup generated by all C-components normalizes each C-component. -/
theorem IsCComponent.sSup_isCComponent_le_normalizer_of_solvableRadical_eq_bot (hL : L.IsCComponent)
    (hG : solvableRadical G = ⊥) :
    sSup {K : Subgroup G | K.IsCComponent} ≤ normalizer L := by
  apply sSup_le
  intro K hK
  by_cases he : K = L
  · subst K
    exact L.le_normalizer
  · exact (commutator_eq_bot_iff_le_centralizer.mp
      (hK.commutator_eq_bot_of_ne_of_solvableRadical_eq_bot hG hL he)).trans
      (centralizer_le_normalizer (L : Set G))

/-- Each C-component is normal in the subgroup generated by all C-components. -/
theorem IsCComponent.normal_subgroupOf_sSup_of_solvableRadical_eq_bot (hL : L.IsCComponent)
    (hG : solvableRadical G = ⊥) :
    (L.subgroupOf (sSup {K : Subgroup G | K.IsCComponent})).Normal :=
  normal_subgroupOf_of_le_normalizer (hL.sSup_isCComponent_le_normalizer_of_solvableRadical_eq_bot hG)

/-- The radical-free commutator dichotomy of A.3.3(7). -/
theorem IsCComponent.commutator_eq_bot_or_eq_iSup_conjugates_of_solvableRadical_eq_bot (hL : L.IsCComponent)
    (hG : solvableRadical G = ⊥) (X : Subgroup G) :
    ⁅L, X⁆ = ⊥ ∨ ⁅L, X⁆ = ⨆ x : X, L.map (MulAut.conj (x : G)).toMonoidHom := by
  let := hL.isSimpleGroup_of_solvableRadical_eq_bot hG
  let := hL.perfect
  exact simple_subnormal_commutator_dichotomy L X hL.subnormal

end Subgroup
