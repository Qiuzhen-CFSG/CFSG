module
public import Theory.GroupTheory.CComponent.RankTwoResidual
public import Theory.GroupTheory.PResidual.PrimeToTransport

/-!
# Cubic movement outside a component centralizer

A C-component in C_G(Z), with centerless two-core quotient of cubic rank two
and two-group outer automorphisms, cannot centralize a subgroup W containing
Z if a subgroup generated by its three-elements normalizes and moves W.
Indeed the component persists in C_G(W) and then N_G(W); the rank bound
identifies it with the latter's prime-to-three residual. The moving subgroup
would lie in the component and centralize W, a contradiction.

Source: Aschbacher--Smith 15.1.25(3), printed p.1102, using A.3.18.
The argument uses the moving residual directly, so needs no order-three lift.
-/

public section
open Subgroup Theory.GroupTheory
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- A component centralizing W persists in the full normalizer of W. -/
theorem IsCComponent.in_normalizer_of_centralizes
    {L H W : Subgroup G} (hL : (L.subgroupOf H).IsCComponent)
    (hLC : L ≤ centralizer (W : Set G))
    (hCH : centralizer (W : Set G) ≤ H) :
    (L.subgroupOf (normalizer (W : Set G))).IsCComponent := by
  let C := centralizer (W : Set G)
  let N := normalizer (W : Set G)
  have hCN : C ≤ N := Subgroup.centralizer_le_normalizer _
  have hLC' : (L.subgroupOf C).IsCComponent := hL.subgroupOf_of_le hLC hCH
  have hLCN : ((L.subgroupOf N).subgroupOf (C.subgroupOf N)).IsCComponent := by
    have hh := hLC'.map_equiv (subgroupOfEquivOfLe hCN).symm
    convert hh using 1
    ext x
    constructor
    · intro hx
      exact ⟨⟨(x.val : G),x.property⟩,hx,rfl⟩
    · rintro ⟨y,hy,rfl⟩
      exact hy
  have hh := hLCN.map_subtype
    (inferInstance : (C.subgroupOf N).Normal).isSubnormal
  rwa [map_subgroupOf_eq_of_le
    (show L.subgroupOf N ≤ C.subgroupOf N from comap_mono hLC)] at hh

/-- Cubic residual movement excludes centralization by a full-rank component. -/
theorem IsCComponent.not_centralizes_of_cubic_movement
    {L H W A : Subgroup G} (hL : (L.subgroupOf H).IsCComponent)
    [IsQuasisimple (L ⧸ pCore 2 L)]
    (hCH : centralizer (W : Set G) ≤ H)
    (hz : center (L ⧸ pCore 2 L) = ⊥)
    (hr : 2 ≤ primeRank 3 (L ⧸ pCore 2 L))
    (ho : IsPGroup 2 (MulAut.Outer (L ⧸ pCore 2 L)))
    (hN : primeRank 3 (normalizer (W : Set G)) ≤ 2)
    (hA : A ≤ normalizer (W : Set G))
    (hres : (primeToResidual 3 A).map A.subtype = A)
    (hmove : ⁅W,A⁆ ≠ ⊥) : ¬ L ≤ centralizer (W : Set G) := by
  intro hLC
  let N := normalizer (W : Set G)
  have hLN : L ≤ N := hLC.trans (Subgroup.centralizer_le_normalizer _)
  let K := L.subgroupOf N
  let e : K ≃* L := subgroupOfEquivOfLe hLN
  let eqv : (K ⧸ pCore 2 K) ≃* (L ⧸ pCore 2 L) :=
    QuotientGroup.congr _ _ e (pCore_map_iso 2 e)
  let : IsQuasisimple (K ⧸ pCore 2 K) := IsQuasisimple.of_mulEquiv eqv.symm
  have hK : K.IsCComponent := hL.in_normalizer_of_centralizes hLC hCH
  have hzK : center (K ⧸ pCore 2 K) = ⊥ := by
    apply le_bot_iff.mp
    intro x hx
    exact eqv.map_eq_one_iff.mp (hz.le ((centerCongr eqv) ⟨x,hx⟩).property)
  have hrK : 2 ≤ primeRank 3 (K ⧸ pCore 2 K) := by
    rwa [primeRank_congr 3 eqv]
  have hoK : IsPGroup 2 (MulAut.Outer (K ⧸ pCore 2 K)) :=
    ho.of_equiv (MulAut.outerCongr eqv).symm
  have he := hK.eq_primeToResidual_three_of_rank_outer_two hzK hrK hN hoK
  have hAL : A ≤ L := by
    have hh := embedded_primeToResidual_mono 3 hA
    rw [hres,←he,map_subgroupOf_eq_of_le hLN] at hh
    exact hh
  apply hmove
  rw [commutator_comm]
  exact commutator_eq_bot_iff_le_centralizer.mpr (hAL.trans hLC)
end Subgroup
