module
public import Theory.GroupTheory.CComponent.TwoComponent.ImageQuotient
public import Theory.GroupTheory.CComponent.RadicalFreeProduct

/-!
# The marked product quotient of two components

If two-components generate a finite group, its odd-core quotient is
generated by ordinary components. Its solvable radical centralizes both
components, hence is central; triviality of the odd core makes that
radical precisely the two-core. Pullback identifies the original radical
with the source O_{2',2}.

Distinct components stay distinct modulo the radical. There they are
commuting nonabelian simple groups with trivial intersection. The
multiplication equivalence gives the product quotient, and the simple-image
kernel theorem identifies each factor with its intrinsic source quotient.
Both coordinate embeddings are retained on the original representatives.
Odd-core solvability is explicit here and discharged in the source adapter.

Source: GLS II, Chapter B, Propositions 3.5 and 4.7 and Lemma 4.8;
Aschbacher–Smith I.3.2, printed p.415 (1 March 2004 manuscript).
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

private theorem component_le_centralizer_radical {L : Subgroup G}
    (hL : IsComponent G L) : L ≤ centralizer (solvableRadical G : Set G) := by
  rcases hL.normal_dichotomy (solvableRadical G) with h | h
  · exact (hL.isCComponent.not_isSolvable
      (Group.isSolvable_of_isSolvable_injective (inclusion_injective h))).elim
  · exact commutator_eq_bot_iff_le_centralizer.mp h

/-- A group generated by two-components has no radical beyond O_{2',2}. -/
theorem oddTwoCore_eq_solvableRadical_of_twoComponent_sup_eq_top
    {L K : Subgroup G} (hL : L.IsTwoComponent) (hK : K.IsTwoComponent)
    (hgen : L ⊔ K = ⊤) [Group.IsSolvable (pPrimeCore 2 G)] :
    oddTwoCore G = solvableRadical G := by
  let Q := G ⧸ pPrimeCore 2 G
  let q := QuotientGroup.mk' (pPrimeCore 2 G)
  have hg : L.map q ⊔ K.map q = ⊤ := by
    rw [← map_sup, hgen, map_top_of_surjective q (QuotientGroup.mk'_surjective _)]
  have hc : (⊤ : Subgroup Q) ≤ centralizer (solvableRadical Q : Set Q) := by
    rw [← hg]
    exact sup_le (component_le_centralizer_radical hL.map_oddCore_isComponent)
      (component_le_centralizer_radical hK.map_oddCore_isComponent)
  have hrz : solvableRadical Q ≤ center Q := by
    simpa only [coe_top, centralizer_univ] using le_centralizer_iff.mp hc
  have hzp : center Q ≤ pCore 2 Q := le_sSup ⟨inferInstance,
    isPGroup_of_nilpotent_normal (p := 2) (center Q) inferInstance inferInstance
      (pPrimeCore_quotient_pPrimeCore_eq_bot (p := 2))⟩
  let : Group.IsNilpotent (pCore 2 Q) := pCore_isPGroup.isNilpotent
  have hr : solvableRadical Q = pCore 2 Q := le_antisymm
    (hrz.trans hzp) (le_solvableRadical _ inferInstance inferInstance)
  let : Group.IsSolvable q.ker := by
    dsimp [q]
    rw [QuotientGroup.ker_mk']
    infer_instance
  change (pCore 2 Q).comap q = _
  rw [← hr]
  exact comap_solvableRadical_eq_of_solvable_ker q (QuotientGroup.mk'_surjective _)

/-- The product decomposition retains both given component embeddings. -/
theorem exists_oddTwoCore_quotient_prod_of_sup_eq_top
    {L K : Subgroup G} (hL : L.IsTwoComponent) (hK : K.IsTwoComponent)
    (hne : L ≠ K) (hgen : L ⊔ K = ⊤)
    [Group.IsSolvable (pPrimeCore 2 G)]
    [Group.IsSolvable (pPrimeCore 2 L)] [Group.IsSolvable (pPrimeCore 2 K)] :
    ∃ e : (G ⧸ oddTwoCore G) ≃* (L ⧸ oddTwoCore L) × (K ⧸ oddTwoCore K),
      (∀ l : L, e (QuotientGroup.mk' (oddTwoCore G) l.val) =
        (QuotientGroup.mk' (oddTwoCore L) l, 1)) ∧
      (∀ k : K, e (QuotientGroup.mk' (oddTwoCore G) k.val) =
        (1, QuotientGroup.mk' (oddTwoCore K) k)) := by
  let Q := G ⧸ solvableRadical G
  let q := QuotientGroup.mk' (solvableRadical G)
  let A := L.map q
  let B := K.map q
  have hA : A.IsCComponent := hL.1.map_quotient _
  have hB : B.IsCComponent := hK.1.map_quotient _
  have hR : solvableRadical Q = ⊥ := solvableRadical_quotient_solvableRadical
  have hne' : A ≠ B := fun h => hne (hL.1.eq_of_map_quotient_eq hK.1 _ h)
  have hg : A ⊔ B = ⊤ := by
    dsimp [A, B]
    rw [← map_sup, hgen, map_top_of_surjective q (QuotientGroup.mk'_surjective _)]
  obtain ⟨m₀, hm₀⟩ := hA.exists_mulEquiv_prod_sup_of_solvableRadical_eq_bot hR
    (hA.commutator_eq_bot_of_ne_of_solvableRadical_eq_bot hR hB hne')
  let m : A × B ≃* Q := m₀.trans ((MulEquiv.subgroupCongr hg).trans topEquiv)
  have hm (a : A) (b : B) : m (a, b) = (a : Q) * b := hm₀ a b
  let : IsSimpleGroup A := hA.isSimpleGroup_of_solvableRadical_eq_bot hR
  let : IsSimpleGroup B := hB.isSimpleGroup_of_solvableRadical_eq_bot hR
  let a := hL.quotientOddTwoCoreEquivOfSurjectiveSimple (q.subgroupMap L)
    (q.subgroupMap_surjective L)
  let b := hK.quotientOddTwoCoreEquivOfSurjectiveSimple (q.subgroupMap K)
    (q.subgroupMap_surjective K)
  let r : (G ⧸ oddTwoCore G) ≃* Q := QuotientGroup.quotientMulEquivOfEq
    (oddTwoCore_eq_solvableRadical_of_twoComponent_sup_eq_top hL hK hgen)
  refine ⟨r.trans (m.symm.trans (a.symm.prodCongr b.symm)), ?_, ?_⟩
  · intro l
    have he : m (a (QuotientGroup.mk' (oddTwoCore L) l), 1) = q l.val := by
      rw [hm, OneMemClass.coe_one, mul_one]
      rfl
    change (a.symm.prodCongr b.symm) (m.symm (q l.val)) = _
    rw [← he, m.symm_apply_apply]
    simp [MulEquiv.prodCongr]
  · intro k
    have he : m (1, b (QuotientGroup.mk' (oddTwoCore K) k)) = q k.val := by
      rw [hm, OneMemClass.coe_one, one_mul]
      rfl
    change (a.symm.prodCongr b.symm) (m.symm (q k.val)) = _
    rw [← he, m.symm_apply_apply]
    simp [MulEquiv.prodCongr]

end Subgroup
