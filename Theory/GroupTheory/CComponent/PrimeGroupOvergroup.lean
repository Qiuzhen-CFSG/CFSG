module

public import Theory.GroupTheory.CComponent.PrimeCoreDichotomy
public import Theory.GroupTheory.PPrimeCorePGroupQuotient

/-!
# Adjoining a p-subgroup to a C-component

The conjugates of a C-component are normal in the characteristic
C-component layer. Their join is therefore subnormal in the original
ambient group and normal in the generated overgroup. Its quotient has
p-power order, so trivial p-prime core passes to the overgroup.

If the original C-component is not ordinary, every ordinary component
of the generated overgroup centralizes all those conjugates. Perfectness
also puts it inside their join, a contradiction. Thus the layer vanishes
and the Fitting subgroup is the p-core.

This supplies the component-versus-characteristic-two step before the
application of E.6.7 in Aschbacher–Smith, combined manuscript of
1 March 2004, E.6.23, printed p.254, from A.3.3 and component calculus.
-/

public section

open Subgroup Theory.GroupTheory
namespace Subgroup
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

/-- The join of any conjugacy orbit of a C-component is subnormal.
All its factors are normal in the characteristic C-component layer. -/
theorem IsCComponent.orbit_subnormal {B S : Subgroup G} (hB : B.IsCComponent) :
    (componentOrbit B S).IsSubnormal := by
  let D := componentOrbit B S
  have hDL : D ≤ cComponentLayer G :=
    iSup_le fun s => le_cComponentLayer (hB.map_equiv (MulAut.conj (s : G)))
  have hLD : cComponentLayer G ≤ normalizer (D : Set G) :=
    (le_iInf fun s : S => cComponentLayer_le_normalizer
      (hB.map_equiv (MulAut.conj (s : G)))).trans (iInf_normalizer_le_normalizer_iSup _)
  let hn : (D.subgroupOf (cComponentLayer G)).Normal := normal_subgroupOf_of_le_normalizer hLD
  let := cComponentLayer_characteristic (G := G)
  exact hn.isSubnormal.trans hDL (inferInstance : (cComponentLayer G).Normal).isSubnormal

omit [Finite G] [Fact p.Prime] in
private theorem orbit_quotient_isPGroup {B S : Subgroup G} (hS : IsPGroup p S)
    (hg : B ⊔ S = ⊤) :
    ∃ hn : (componentOrbit B S).Normal,
      @IsPGroup p (G ⧸ componentOrbit B S) (@QuotientGroup.Quotient.group _ _ _ hn) := by
  have hn : (componentOrbit B S).Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hg]
    exact (normal_subgroupOf_iff_le_normalizer (componentOrbit_le_sup B S)).mp
      (componentOrbit_normal_subgroupOf_sup B S)
  let := hn
  exact ⟨hn, isPGroup_quotient_of_sup_eq_top _ S hS ((componentOrbit_sup B S).trans hg)⟩

/-- A nonordinary C-component and a p-subgroup cannot generate a group
with ordinary components: each such component would centralize the whole
conjugate closure, while perfectness puts it inside that closure. -/
theorem componentLayer_eq_bot_of_cComponent_pGroup_generators {B S : Subgroup G} (hB : B.IsCComponent)
    (hS : IsPGroup p S) (hg : B ⊔ S = ⊤) (hn : ¬ IsComponent G B) :
    componentLayer G = ⊥ := by
  obtain ⟨hDn, hquot⟩ := orbit_quotient_isPGroup hS hg
  let := hDn
  let : Group.IsNilpotent (G ⧸ componentOrbit B S) := hquot.isNilpotent
  apply sSup_eq_bot.mpr
  intro J hJ
  let := hJ.2
  have hJD : J ≤ componentOrbit B S :=
    (le_solvableResidual_of_isPerfect J).trans (solvableResidual_le_of_solvable_quotient _)
  have hDC : componentOrbit B S ≤ centralizer (J : Set G) := by
    apply iSup_le
    intro s
    have hBs := hB.map_equiv (MulAut.conj (s : G))
    rcases hJ.subnormal_dichotomy _ hBs.subnormal with hle | hc
    · have he := hJ.isCComponent.eq_of_le hBs hle
      exact (hn ((isComponent_map_equiv_iff B (MulAut.conj (s : G))).mp (he ▸ hJ))).elim
    · exact le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hc)
  have hc : ⁅J,J⁆ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr (hJD.trans hDC)
  simpa only [commutator_eq_self] using hc

/-- Trivial p-prime core passes to the overgroup generated by a
C-component and a p-subgroup, using its subnormal conjugate closure. -/
theorem IsCComponent.pPrimeCore_sup_eq_bot {B S : Subgroup G} (hB : B.IsCComponent)
    (hS : IsPGroup p S) (ho : pPrimeCore p G = ⊥) : pPrimeCore p ↥(B ⊔ S) = ⊥ := by
  let K := B ⊔ S
  let D := componentOrbit B S
  have hDK : D ≤ K := componentOrbit_le_sup B S
  let : (D.subgroupOf K).Normal := componentOrbit_normal_subgroupOf_sup B S
  have hgen : D.subgroupOf K ⊔ S.subgroupOf K = ⊤ := by
    apply (map_injective K.subtype_injective)
    rw [map_sup, map_subgroupOf_eq_of_le hDK,
      map_subgroupOf_eq_of_le (show S ≤ K from le_sup_right),
      ← MonoidHom.range_eq_map, range_subtype]
    exact componentOrbit_sup B S
  have hquot : IsPGroup p (K ⧸ D.subgroupOf K) :=
    isPGroup_quotient_of_sup_eq_top _ _ hS.comap_subtype hgen
  have hDo : pPrimeCore p D = ⊥ := hB.orbit_subnormal.pPrimeCore_eq_bot ho
  have hDo' : pPrimeCore p (D.subgroupOf K) = ⊥ := by
    let e := subgroupOfEquivOfLe hDK
    apply (map_eq_bot_iff_of_injective _ (f := e.toMonoidHom) e.injective).mp
    rw [pPrimeCore_map_iso, hDo]
  exact pPrimeCore_eq_bot_of_isPGroup_quotient p (D.subgroupOf K) hDo' hquot

/-- A C-component in a group with trivial p-prime core is ordinary, or
adjoining any p-subgroup gives generalized Fitting subgroup equal to
the p-core. Normality of the original C-component is not required. -/
theorem IsCComponent.component_or_generalizedFitting_sup_eq_pCore
    {B S : Subgroup G} (hB : B.IsCComponent) (hS : IsPGroup p S)
    (ho : pPrimeCore p G = ⊥) :
    IsComponent G B ∨ generalizedFitting ↥(B ⊔ S) = pCore p ↥(B ⊔ S) := by
  by_cases hc : IsComponent G B
  · exact Or.inl hc
  · right
    let K := B ⊔ S
    have hgen : B.subgroupOf K ⊔ S.subgroupOf K = ⊤ := by
      apply (map_injective K.subtype_injective)
      rw [map_sup, map_subgroupOf_eq_of_le (show B ≤ K from le_sup_left),
        map_subgroupOf_eq_of_le (show S ≤ K from le_sup_right),
        ← MonoidHom.range_eq_map, range_subtype]
    have hn : ¬ IsComponent K (B.subgroupOf K) := by
      intro hn
      let := hn.2
      exact hc ⟨hB.subnormal, IsQuasisimple.of_mulEquiv
        (subgroupOfEquivOfLe (show B ≤ K from le_sup_left))⟩
    have hE := componentLayer_eq_bot_of_cComponent_pGroup_generators
      (hB.subgroupOf (show B ≤ K from le_sup_left)) hS.comap_subtype hgen hn
    rw [generalizedFitting, hE, sup_bot_eq, Fitting_eq_pcore K p (hB.pPrimeCore_sup_eq_bot hS ho)]
end Subgroup
