module

public import Theory.GroupTheory.CComponent.OrbitExhaustion
public import Theory.GroupTheory.CComponent.QuotientLifting

/-!
# C-component orbits in a group generated by a component and a p-group

Modulo the solvable radical, distinct C-components commute. The component
orbit therefore exhausts all C-components when one component and a p-group
generate the whole group. The solvable-kernel correspondence lifts the
result to an equality of the original components, with a conjugating
element in the original p-subgroup.

Source: the component-orbit argument in Aschbacher–Smith, A.3.8(3),
printed p.45, using the A.3.3 correspondence, pp.42–43.
-/

public section
open Subgroup Theory.GroupTheory
namespace Subgroup
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

/-- The p-subgroup orbit contains every C-component of the generated group. -/
theorem IsCComponent.conjugate_of_pGroup_generated
    {X B S : Subgroup G} (hX : X.IsCComponent) (hB : B.IsCComponent)
    (hS : IsPGroup p S) (hgen : X ⊔ S = ⊤) :
    ∃ s : S, B = X.map (MulAut.conj (s : G)).toMonoidHom := by
  let R := solvableRadical G
  let q := QuotientGroup.mk' R
  have hXq := hX.map_quotient R
  have hBq := hB.map_quotient R
  have hgenq : X.map q ⊔ S.map q = ⊤ := by
    rw [← Subgroup.map_sup, hgen, map_top_of_surjective q (QuotientGroup.mk'_surjective R)]
  obtain ⟨s, hs⟩ := hXq.conjugate_of_pGroup_generated_of_commuting hBq
    (hS.map q) hgenq (fun C hC hne =>
      hBq.commutator_eq_bot_of_ne_of_solvableRadical_eq_bot
        (solvableRadical_quotient_solvableRadical (G := G)) hC hne)
  obtain ⟨t, ht, he⟩ := s.property
  refine ⟨⟨t, ht⟩, hB.eq_of_map_quotient_eq (hX.map_equiv (MulAut.conj t)) R ?_⟩
  have hc : q.comp (MulAut.conj t).toMonoidHom =
      (MulAut.conj (q t)).toMonoidHom.comp q := by ext; simp
  rw [map_map, hc, ← map_map, he]
  exact hs

end Subgroup
