module
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.GroupTheory.ComponentLocalPrimeFree
public import Theory.GroupTheory.PResidual.PrimeToTransport

/-!
# A component pair as a prime residual of the layer

Suppose two C-components are generated by their prime-to-p residuals and
all other C-components have order prime to p. Their join is normal in the
component layer. The quotient is generated by normal subgroups of order
prime to p, so the join is exactly the embedded prime-to-p residual.

This is the layer calculation used for the original component orbit in
Aschbacher--Smith 10.2.10, printed p.753. It does not identify the residual
of the whole ambient group or impose an outer-automorphism hypothesis.
-/

public section
open Subgroup Theory.GroupTheory
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

/-- Two p-generated components exhaust the p-residual when all other components are p-free. -/
theorem cComponent_pair_eq_layer_primeToResidual
    (A B : Subgroup G) (hA : A.IsCComponent) (hB : B.IsCComponent)
    (ha : primeToResidual p A = ⊤) (hb : primeToResidual p B = ⊤)
    (hother : ∀ D : Subgroup G, D.IsCComponent → D ≠ A → D ≠ B →
      Nat.Coprime p (Nat.card D)) :
    A ⊔ B = (primeToResidual p (cComponentLayer G)).map (cComponentLayer G).subtype := by
  classical
  let E := cComponentLayer G
  let C := A ⊔ B
  have hCE : C ≤ E := sup_le (le_cComponentLayer hA) (le_cComponentLayer hB)
  let C₀ := C.subgroupOf E
  have hEN : E ≤ normalizer (C : Set G) := by
    intro x hx
    apply mem_normalizer_iff_map_conj_eq.mpr
    rw [Subgroup.map_sup,
      mem_normalizer_iff_map_conj_eq.mp (cComponentLayer_le_normalizer hA hx),
      mem_normalizer_iff_map_conj_eq.mp (cComponentLayer_le_normalizer hB hx)]
  let : C₀.Normal := normal_subgroupOf_of_le_normalizer hEN
  let q := QuotientGroup.mk' C₀
  let F (D : {D : Subgroup G // D.IsCComponent}) : Subgroup (E ⧸ C₀) := (D.1.subgroupOf E).map q
  have hn (D : {D : Subgroup G // D.IsCComponent}) : (F D).Normal := by
    let : (D.1.subgroupOf E).Normal := normal_subgroupOf_of_le_normalizer
      (cComponentLayer_le_normalizer D.property)
    exact (inferInstance : (D.1.subgroupOf E).Normal).map q (QuotientGroup.mk'_surjective _)
  have hfree (D : {D : Subgroup G // D.IsCComponent}) : ¬p ∣ Nat.card (F D) := by
    by_cases he : D.1 = A ∨ D.1 = B
    · have hDC : D.1 ≤ C := he.elim (fun h => h ▸ le_sup_left) (fun h => h ▸ le_sup_right)
      have hzero : F D = ⊥ := by
        change (D.1.subgroupOf E).map q = ⊥
        apply (Subgroup.map_eq_bot_iff _).mpr
        rw [QuotientGroup.ker_mk']
        exact comap_mono hDC
      rw [hzero,card_bot]
      exact (Fact.out : p.Prime).not_dvd_one
    · apply (Fact.out : p.Prime).coprime_iff_not_dvd.mp
      apply (hother D.1 D.property (fun h => he (Or.inl h))
        (fun h => he (Or.inr h))).coprime_dvd_right
      have hd := card_map_dvd (D.1.subgroupOf E) q
      rw [Nat.card_congr (subgroupOfEquivOfLe (le_cComponentLayer D.property)).toEquiv] at hd
      exact hd
  have hgen : (⨆ D : {D : Subgroup G // D.IsCComponent}, D.1.subgroupOf E) = ⊤ := by
    apply map_injective E.subtype_injective
    rw [Subgroup.map_iSup,←MonoidHom.range_eq_map,range_subtype]
    exact (iSup_congr fun D : {D : Subgroup G // D.IsCComponent} =>
      map_subgroupOf_eq_of_le (le_cComponentLayer D.property)).trans (sSup_eq_iSup' _).symm
  have hgenF : (⨆ D, F D) = ⊤ := by
    change (⨆ D : {D : Subgroup G // D.IsCComponent}, (D.1.subgroupOf E).map q) = ⊤
    rw [←Subgroup.map_iSup,hgen,map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  have hfreeQ : Nat.Coprime p (Nat.card (E ⧸ C₀)) := by
    have hh := not_dvd_card_iSup_of_normalizes (Fact.out : p.Prime) F
      (fun D J => by let := hn J; rw [normalizer_eq_top]; exact le_top) hfree
    rw [hgenF,card_top] at hh
    exact (Fact.out : p.Prime).coprime_iff_not_dvd.mpr hh
  have hr : primeToResidual p E ≤ C₀ := primeToResidual_le C₀
    (by simpa only [index_eq_card] using hfreeQ)
  apply le_antisymm
  · apply sup_le
    · have hh := embedded_primeToResidual_mono p (le_cComponentLayer hA)
      rwa [ha,←MonoidHom.range_eq_map,range_subtype] at hh
    · have hh := embedded_primeToResidual_mono p (le_cComponentLayer hB)
      rwa [hb,←MonoidHom.range_eq_map,range_subtype] at hh
  · exact (map_mono hr).trans_eq (map_subgroupOf_eq_of_le hCE)
end Theory.GroupTheory
