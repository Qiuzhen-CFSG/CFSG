module
public import Theory.GroupTheory.CComponent.PerfectProjection
public import Theory.GroupTheory.CComponent.Structure

/-!
# Lifting a component residual through an arbitrary action kernel

Distinct C-components have solvable commutator. Consequently, two conjugate
C-components cannot have the same nonsolvable perfect image unless they
coincide. This detects relative normality without requiring a solvable kernel.
If C-components generate the source residual and the target residual is a
C-component, at least one source component maps nontrivially; minimality
identifies its image with the target residual and gives its normality.

Source: Aschbacher--Smith, A.3.3 and A.3.9(1), printed pp.42--43,46.
The application is the component selection in 14.3.25, printed p.1001.
-/

public section
namespace Subgroup
variable {G D : Type*} [Group G] [Finite G] [Group D]

/-- A nonsolvable normal image detects normality of the original C-component. -/
theorem IsCComponent.normal_of_normal_nonsolvable_image
    {K : Subgroup G} (hK : K.IsCComponent) (f : G →* D)
    (hn : (K.map f).Normal) (hs : ¬ Group.IsSolvable (K.map f)) : K.Normal := by
  let := hn
  let := hK.perfect
  apply normal_iff_map_conj_eq.mpr
  intro g
  by_contra hne
  let J := K.map (MulAut.conj g).toMonoidHom
  have hJ : J.IsCComponent := hK.map_equiv (MulAut.conj g)
  have hc : ⁅K,J⁆ ≤ solvableRadical G :=
    hK.commutator_le_solvableRadical_of_ne hJ (Ne.symm hne)
  let : Group.IsSolvable (⁅K,J⁆ : Subgroup G) :=
    Group.isSolvable_of_isSolvable_injective (inclusion_injective hc)
  have he : J.map f = K.map f := by
    have he : f.comp (MulAut.conj g).toMonoidHom =
        (MulAut.conj (f g)).toMonoidHom.comp f := by ext x; simp
    rw [show J = K.map (MulAut.conj g).toMonoidHom from rfl,map_map,he,←map_map]
    exact normal_iff_map_conj_eq.mp hn (f g)
  have hm : (⁅K,J⁆ : Subgroup G).map f = K.map f := by
    rw [map_commutator,he]
    let : Group.IsPerfect (K.map f) := Group.IsPerfect.map f
    exact commutator_eq_self
  have hsol : Group.IsSolvable ((⁅K,J⁆ : Subgroup G).map f) :=
    Group.isSolvable_of_surjective (f.subgroupMap_surjective _)
  exact hs (hm ▸ hsol)

/-- A component residual of a surjective image lifts to a normal C-component
when the source residual is generated by its C-components. -/
theorem exists_normal_cComponent_map_residual
    (hgen : cComponentLayer G = solvableResidual G)
    (f : G →* D) (hf : Function.Surjective f)
    (hD : (solvableResidual D).IsCComponent) :
    ∃ K : Subgroup G, K.IsCComponent ∧ K.Normal ∧ K.map f = solvableResidual D := by
  have hex : ∃ K : Subgroup G, K.IsCComponent ∧ K.map f ≠ ⊥ := by
    by_contra hn
    have hb : (cComponentLayer G).map f ≤ ⊥ := by
      apply map_le_iff_le_comap.mpr
      apply sSup_le
      intro K hK
      apply map_le_iff_le_comap.mp
      have hk : K.map f = ⊥ := by
        by_contra hk
        exact hn ⟨K,hK,hk⟩
      exact hk.le
    rw [hgen,map_solvableResidual_eq f hf] at hb
    exact hD.ne_bot (le_bot_iff.mp hb)
  obtain ⟨K,hK,hne⟩ := hex
  let := hK.perfect
  let : Group.IsPerfect (K.map f) := Group.IsPerfect.map f
  have hk : K.map f = solvableResidual D := by
    apply le_antisymm (le_solvableResidual_of_isPerfect (K.map f))
    exact hD.minimal (K.map f) (le_solvableResidual_of_isPerfect _)
      hne (Group.IsPerfect.map f) (hK.subnormal.map hf)
  have hn : (K.map f).Normal := hk ▸ inferInstance
  have hs : ¬ Group.IsSolvable (K.map f) := by
    rw [hk]
    exact hD.not_isSolvable
  exact ⟨K,hK,hK.normal_of_normal_nonsolvable_image f hn hs,hk⟩
end Subgroup
