module

public import Theory.GroupTheory.CComponent.SolvableQuotient
public import Theory.GroupTheory.CComponent.RadicalFree
public import Theory.GroupTheory.GeneralizedFitting.Defs

/-!
# Structure theory of C-components

This module collects the general C-component structure results.  The elementary
restriction and existence API is in `CComponent.Basic`; the radical quotient,
solvable supplements and quotient correspondence are proved in `Radical`,
`SolvableQuotient` and `SolvableResidual`; and the ordinary-component
comparison is proved in `RadicalFree`.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Proposition A.3.3, pp. 41–43 (1 March 2004 manuscript).
-/

@[expose] public section
open Subgroup

namespace Subgroup

variable {G : Type*} [Group G] [Finite G]

/-! The following definition is the C-component analogue of `E(G)`. -/

/-- The subgroup generated by all C-components of `G`. -/
def cComponentLayer (G : Type*) [Group G] : Subgroup G :=
  sSup {L : Subgroup G | L.IsCComponent}

/-- The subgroup usually denoted `O_{∞,E}(G)`: the solvable radical together
with the C-component layer. -/
def oInfELayer (G : Type*) [Group G] [Finite G] : Subgroup G :=
  solvableRadical G ⊔ cComponentLayer G

omit [Finite G] in
theorem le_cComponentLayer {L : Subgroup G} (hL : L.IsCComponent) :
    L ≤ cComponentLayer G :=
  le_sSup hL

/-! After factoring out the solvable radical, C-components are precisely the
ordinary components (`IsComponent`), and their generated subgroup is the
ordinary component layer.  We formulate this using the canonical quotient map
so that no large alternating-group import is needed. -/

theorem isComponent_iff_isCComponent_map_solvableRadical
    {K : Subgroup (G ⧸ solvableRadical G)} :
    Theory.GroupTheory.IsComponent (G ⧸ solvableRadical G) K ↔
      K.IsCComponent := by
  let hR : solvableRadical (G ⧸ solvableRadical G) = ⊥ :=
    solvableRadical_quotient_solvableRadical (G := G)
  rw [isCComponent_iff_isSubnormal_and_isQuasisimple_of_solvableRadical_eq_bot hR]
  rfl

theorem map_cComponent_isComponent_of_solvableRadical
    {L : Subgroup G} (hL : L.IsCComponent) :
    Theory.GroupTheory.IsComponent (G ⧸ solvableRadical G)
      (L.map (QuotientGroup.mk' (solvableRadical G))) := by
  rw [isComponent_iff_isCComponent_map_solvableRadical]
  exact hL.map_quotient (solvableRadical G)

theorem exists_cComponent_map_eq_of_isComponent_solvableRadical
    {K : Subgroup (G ⧸ solvableRadical G)}
    (hK : Theory.GroupTheory.IsComponent (G ⧸ solvableRadical G) K) :
    ∃ L : Subgroup G, L.IsCComponent ∧
      L.map (QuotientGroup.mk' (solvableRadical G)) = K := by
  rw [isComponent_iff_isCComponent_map_solvableRadical] at hK
  exact hK.exists_map_quotient_eq (solvableRadical G)

theorem setOf_map_cComponent_eq_setOf_isComponent_solvableRadical :
    {K : Subgroup (G ⧸ solvableRadical G) |
      ∃ L : Subgroup G, L.IsCComponent ∧
        L.map (QuotientGroup.mk' (solvableRadical G)) = K} =
      {K : Subgroup (G ⧸ solvableRadical G) |
        Theory.GroupTheory.IsComponent (G ⧸ solvableRadical G) K} := by
  ext K
  constructor
  · rintro ⟨L, hL, rfl⟩
    exact map_cComponent_isComponent_of_solvableRadical hL
  · intro hK
    exact exists_cComponent_map_eq_of_isComponent_solvableRadical hK

theorem map_cComponentLayer_eq_componentLayer_solvableRadical :
    (cComponentLayer G).map (QuotientGroup.mk' (solvableRadical G)) =
      Theory.GroupTheory.componentLayer (G ⧸ solvableRadical G) := by
  let q := QuotientGroup.mk' (solvableRadical G)
  rw [cComponentLayer, sSup_eq_iSup']
  rw [map_iSup]
  apply le_antisymm
  · refine iSup_le fun L => ?_
    exact le_sSup (map_cComponent_isComponent_of_solvableRadical L.property)
  · refine sSup_le fun K hK => ?_
    obtain ⟨L, hL, rfl⟩ := exists_cComponent_map_eq_of_isComponent_solvableRadical hK
    exact le_iSup (fun M : {L : Subgroup G // L.IsCComponent} => M.1.map q)
      ⟨L, hL⟩

theorem map_oInfELayer_eq_componentLayer_solvableRadical :
    (oInfELayer G).map (QuotientGroup.mk' (solvableRadical G)) =
      Theory.GroupTheory.componentLayer (G ⧸ solvableRadical G) := by
  rw [oInfELayer, map_sup, map_cComponentLayer_eq_componentLayer_solvableRadical]
  have hrad : (solvableRadical G).map (QuotientGroup.mk' (solvableRadical G)) = ⊥ := by
    rw [map_eq_bot_iff, QuotientGroup.ker_mk']
  rw [hrad, bot_sup_eq]

theorem cComponentLayer_eq_componentLayer_of_solvableRadical_eq_bot
    (hG : solvableRadical G = ⊥) :
    cComponentLayer G = Theory.GroupTheory.componentLayer G := by
  apply congrArg sSup
  ext L
  change L.IsCComponent ↔ Theory.GroupTheory.IsComponent G L
  rw [isCComponent_iff_isSubnormal_and_isQuasisimple_of_solvableRadical_eq_bot hG]
  rfl

theorem componentLayer_isPerfect_of_solvableRadical_eq_bot
    (hG : solvableRadical G = ⊥) :
    Group.IsPerfect (Theory.GroupTheory.componentLayer G) := by
  rw [isPerfect_iff]
  apply le_antisymm (Theory.GroupTheory.componentLayer G).commutator_le_self
  rw [Theory.GroupTheory.componentLayer]
  refine sSup_le fun K hK => ?_
  have hKC : K.IsCComponent := by
    rw [isCComponent_iff_isSubnormal_and_isQuasisimple_of_solvableRadical_eq_bot hG]
    exact hK
  have hp : ⁅K, K⁆ = K := Subgroup.isPerfect_iff.mp hKC.perfect
  exact (hp.symm.le).trans
    (commutator_mono (le_sSup hK) (le_sSup hK))

theorem solvableResidual_componentLayer_eq_top_of_solvableRadical_eq_bot
    (hG : solvableRadical G = ⊥) :
    Subgroup.solvableResidual (Theory.GroupTheory.componentLayer G) = ⊤ := by
  let _ := componentLayer_isPerfect_of_solvableRadical_eq_bot hG
  exact Subgroup.solvableResidual_eq_top

/-! The last two assertions of A.3.3 are most naturally used in the radical
quotient.  These wrappers expose the normality and commutator dichotomy in the
ambient notation while retaining the precise quotient hypotheses. -/

theorem cComponent_normal_in_layer_of_solvableRadical_eq_bot
    {L : Subgroup G} (hL : L.IsCComponent)
    (hG : solvableRadical G = ⊥) :
    (L.subgroupOf (cComponentLayer G)).Normal := by
  change (L.subgroupOf (sSup {K : Subgroup G | K.IsCComponent})).Normal
  exact hL.normal_subgroupOf_sSup_of_solvableRadical_eq_bot hG

theorem cComponent_commutator_dichotomy_of_solvableRadical_eq_bot
    {L : Subgroup G} (hL : L.IsCComponent)
    (hG : solvableRadical G = ⊥) (X : Subgroup G) :
    ⁅L, X⁆ = ⊥ ∨
      ⁅L, X⁆ = ⨆ x : X, L.map (MulAut.conj (x : G)).toMonoidHom :=
  hL.commutator_eq_bot_or_eq_iSup_conjugates_of_solvableRadical_eq_bot hG X

end Subgroup
