module
public import Theory.GroupTheory.CentralCoverTwoLocalPlacement
public import Theory.GroupTheory.PCoreLocalSetup

/-!
# Centered commutator subgroups through central covers

A finite central extension maps its prime core onto the target prime core:
use the invariant Sylow lift in the preimage of that core. Consequently a
subgroup centralized by the source core and generated by its own commutators
is trivial if the target core centralizer is central. This keeps the central
cover in the centered-module argument of Aschbacher--Smith 4.4.12,
printed pp.621--622 of `refs/quasithin.pdf`.
-/

public noncomputable section
open Subgroup
namespace MonoidHom
theorem map_pCore_of_central_kernel_centered {E Q : Type*} [Group E] [Finite E] [Group Q]
    {p : ℕ} [Fact p.Prime] (f : E →* Q) (hf : Function.Surjective f)
    (hc : f.ker ≤ center E) : (pCore p E).map f = pCore p Q := by
  apply le_antisymm
  · exact le_sSup ⟨Normal.map inferInstance f hf, pCore_isPGroup.map f⟩
  · obtain ⟨U,hU,he,hn⟩ := exists_prime_lift_of_central_kernel f hf hc
      (pCore p Q) pCore_isPGroup
    have hnt : normalizer (U : Set E) = ⊤ := top_unique (by
      simpa only [normalizer_eq_top, comap_top] using hn)
    let : U.Normal := normalizer_eq_top_iff.mp hnt
    rw [← he]
    exact map_mono (le_sSup ⟨inferInstance,hU⟩)
end MonoidHom

namespace Subgroup
theorem centered_commutator_eq_bot_of_central_cover
    {E Q : Type*} [Group E] [Finite E] [Group Q]
    {p : ℕ} [Fact p.Prime] (f : E →* Q) (hf : Function.Surjective f)
    (hc : f.ker ≤ center E)
    (hz : centralizer (pCore p Q : Set Q) ≤ center Q)
    (W : Subgroup E) (hW : W ≤ centralizer (pCore p E : Set E))
    (hcomm : W = ⁅W,⊤⁆) : W = ⊥ := by
  have hm : W.map f ≤ center Q := by
    apply le_trans ?_ hz
    rw [← f.map_pCore_of_central_kernel_centered hf hc]
    exact (map_mono hW).trans (map_centralizer_le_centralizer_image _ _)
  have hmap : W.map f = ⊥ := by
    calc
      W.map f = ⁅W.map f,(⊤ : Subgroup E).map f⁆ := by
        rw [← map_commutator]
        exact congrArg (map f) hcomm
      _ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr
        (hm.trans (center_le_centralizer _))
  have hWc : W ≤ center E := ((map_eq_bot_iff W).mp hmap).trans hc
  exact hcomm.trans (commutator_eq_bot_iff_le_centralizer.mpr
    (hWc.trans (center_le_centralizer _)))
end Subgroup
