module
public import Theory.ElementaryAbelian.Basic
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.GroupTheory.Subgroup.Simple
public import Mathlib.GroupTheory.FixedPointFree
/-!
# Excluding an irreducible core-free Klein-four complement

Let K be a normal subgroup of a finite group generated by K and an
order-four elementary abelian subgroup S. If S has trivial normal core
and every subgroup of K invariant under S is trivial or all of K, this
configuration is impossible. No odd-order or abelian assumption on K is
needed. The elementary primitive configuration obtained in Stellmacher
(3.3), used after (9.1)(11), supplies these hypotheses; this module depends
only on general group and action results.

The kernel of S acting on K is S intersected with the centralizer of K.
It is normalized by S and centralized by K, hence normal in the whole
group and trivial by core-freeness. For a nonidentity element s of S,
the fixed subgroup in K is invariant under S because S is abelian.
Irreducibility makes it trivial or all of K; faithfulness excludes the
latter. A fixed-point-free involution of a finite group acts by inversion.
Thus any two nonidentity elements of S act identically, and faithfulness
would give S order two, contradicting its order four.

Source: the solvable primitive complement argument underlying Stellmacher,
Journal of Algebra 190 (1997), (3.3), pp.21--22 and (9.1), p.48,
`refs/files/stellmacher-n-group.pdf`; the fixed-point-free inversion step
uses Mathlib's `MonoidHom.FixedPointFree.coe_eq_inv_of_involutive`.
-/

open scoped IsMulCommutative
namespace Theory.GroupTheory
universe u

private theorem coreFree_complement_action_injective
    {G : Type u} [Group G] (K S : Subgroup G) [K.Normal]
    (hgen : K ⊔ S = ⊤) (hcore : S.normalCore = ⊥) :
    Function.Injective ((MulAut.conjNormal : G →* MulAut K).comp S.subtype) := by
  let C := S ⊓ Subgroup.centralizer (K : Set G)
  have hn : C.Normal := by
    apply Subgroup.normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hgen]
    apply sup_le
    · apply Subgroup.le_normalizer_iff.mpr
      intro k hk c hc
      have hcomm := Subgroup.mem_centralizer_iff.mp hc.2 k hk
      rw [hcomm, mul_inv_cancel_right]
      exact hc
    · apply Subgroup.le_normalizer_iff.mpr
      intro s hs c hc
      exact ⟨S.mul_mem (S.mul_mem hs hc.1) (S.inv_mem hs),
        (inferInstance : (Subgroup.centralizer (K : Set G)).Normal).conj_mem c hc.2 s⟩
  have hC : C = ⊥ := by
    have hle : C ≤ S.normalCore := @Subgroup.normal_le_normalCore G _ S C hn |>.mpr inf_le_left
    exact bot_unique (hle.trans_eq hcore)
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply eq_bot_iff.mpr
  intro s hs
  have hsC : (s : G) ∈ C := by
    refine ⟨s.property, Subgroup.mem_centralizer_iff.mpr ?_⟩
    intro k hk
    have hpoint := DFunLike.congr_fun hs (⟨k, hk⟩ : K)
    have heq := congrArg Subtype.val hpoint
    change (s : G) * k * (s : G)⁻¹ = k at heq
    exact (mul_inv_eq_iff_eq_mul.mp heq).symm
  have hh : (s : G) ∈ (⊥ : Subgroup G) := hC ▸ hsC
  exact Subtype.ext hh

/-- A core-free irreducible complement cannot be an elementary group of order four. -/
public theorem not_elementary_four_corefree_irreducible_complement
    {G : Type u} [Group G] [Finite G]
    (K S : Subgroup G) [K.Normal] [IsElementaryAbelian 2 S]
    (hcard : Nat.card S = 4) (hgen : K ⊔ S = ⊤)
    (hcore : S.normalCore = ⊥)
    (hirr : ∀ A : Subgroup G, A ≤ K →
      (∀ t : S, ∀ a : G, a ∈ A → (t : G) * a * (t : G)⁻¹ ∈ A) →
      A = ⊥ ∨ A = K) : False := by
  classical
  let φ : S →* MulAut K := (MulAut.conjNormal : G →* MulAut K).comp S.subtype
  have hfaith : Function.Injective φ := coreFree_complement_action_injective K S hgen hcore
  have hfixed (s : S) (hs : s ≠ 1) : MonoidHom.FixedPointFree (φ s) := by
    let A := K ⊓ Subgroup.centralizer ({(s : G)} : Set G)
    have hAs : ∀ t : S, ∀ a : G, a ∈ A → (t : G) * a * (t : G)⁻¹ ∈ A := by
      intro t a ha
      refine ⟨(inferInstance : K.Normal).conj_mem a ha.1 t, ?_⟩
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      have hst : Commute (s : G) (t : G) := by
        exact congrArg Subtype.val (mul_comm s t)
      have hsa : Commute (s : G) a := (Subgroup.mem_centralizer_singleton_iff.mp ha.2).symm
      exact ((hst.mul_right hsa).mul_right hst.inv_right).eq.symm
    have hAbot : A = ⊥ := by
      rcases hirr A inf_le_left hAs with hb | heq
      · exact hb
      · apply (hs ?_).elim
        apply hfaith
        rw [map_one]
        apply MulEquiv.ext
        intro k
        apply Subtype.ext
        have hk : (k : G) ∈ A := by rw [heq]; exact k.property
        have hcomm := Subgroup.mem_centralizer_singleton_iff.mp hk.2
        change (s : G) * (k : G) * (s : G)⁻¹ = k
        rw [← hcomm, mul_inv_cancel_right]
    intro k hk
    apply Subtype.ext
    have heq := congrArg Subtype.val hk
    change (s : G) * (k : G) * (s : G)⁻¹ = k at heq
    have hkA : (k : G) ∈ A := by
      refine ⟨k.property, ?_⟩
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      exact (mul_inv_eq_iff_eq_mul.mp heq).symm
    have hh : (k : G) ∈ (⊥ : Subgroup G) := hAbot ▸ hkA
    exact hh
  have hinvert (s : S) (hs : s ≠ 1) : ∀ k : K, φ s k = k⁻¹ := by
    have hss : s * s = 1 := by
      have hh := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 S) s
      simpa only [pow_two] using hh
    have hinvol : Function.Involutive (φ s) := by
      intro k
      change (φ s * φ s) k = k
      rw [← map_mul, hss, map_one]
      rfl
    exact congrFun ((hfixed s hs).coe_eq_inv_of_involutive hinvol)
  let _ : Nontrivial S := (Subgroup.nontrivial_iff_ne_bot S).mpr (by
    intro hb
    have hh := Subgroup.card_eq_one.mpr hb
    omega)
  obtain ⟨s, hs⟩ := exists_ne (1 : S)
  have htwo : Nat.card S = 2 := by
    apply (Nat.card_eq_two_iff' (1 : S)).mpr
    refine ⟨s, hs, ?_⟩
    intro t ht
    apply hfaith
    apply MulEquiv.ext
    intro k
    exact (hinvert t ht k).trans (hinvert s hs k).symm
  omega
end Theory.GroupTheory
