module

public import Theory.GroupTheory.SylowPreimageNormalizer

/-!
# The odd kernel left after the actual normal Sylow subgroup

When a kernel Sylow p-subgroup maps onto the given normal subgroup Q,
its image modulo Q has order prime to p. If G is generated by a normal
subgroup L and a p-group, this remaining kernel lies in LQ. This preserves
the original quotient map and permits a nontrivial central odd cover in
the generation argument of Aschbacher–Smith C.1.24(c), pp.130–131.
-/

public section
open Subgroup
namespace Subgroup
variable {G H : Type*} [Group G] [Group H] [Finite G] {p : ℕ} [Fact p.Prime]

/-- The actual kernel image modulo its normal Sylow p-subgroup has p-free order. -/
theorem not_dvd_card_kernel_quotient_image (q : G →* H)
    (Q : Subgroup G) [Q.Normal] (P : Sylow p q.ker)
    (hP : (P : Subgroup q.ker).map q.ker.subtype = Q) :
    ¬p ∣ Nat.card (q.ker.map (QuotientGroup.mk' Q)) := by
  have hQ : Q ≤ q.ker := hP ▸ map_subtype_le (P : Subgroup q.ker)
  have hP' : (P : Subgroup q.ker) = Q.subgroupOf q.ker := by
    apply map_injective q.ker.subtype_injective
    rw [hP,map_subgroupOf_eq_of_le hQ]
  rw [←relIndex_ker,QuotientGroup.ker_mk']
  change ¬p ∣ (Q.subgroupOf q.ker).index
  rw [←hP']
  exact P.not_dvd_index

/-- The kernel is contained in LQ when the complementary quotient is a p-group. -/
theorem kernel_le_normal_sup_of_kernel_sylow (q : G →* H)
    (Q L T : Subgroup G) [Q.Normal] [L.Normal]
    (P : Sylow p q.ker) (hP : (P : Subgroup q.ker).map q.ker.subtype = Q)
    (hT : IsPGroup p T) (hgen : L ⊔ T = ⊤) : q.ker ≤ L ⊔ Q := by
  let U := L ⊔ Q
  let π := QuotientGroup.mk' Q
  let m := QuotientGroup.mk' U
  have hQm : Q ≤ m.ker := by
    rw [QuotientGroup.ker_mk']
    exact le_sup_right
  let f := QuotientGroup.lift Q m hQm
  have hf : (q.ker.map π).map f = q.ker.map m := by
    rw [map_map]
    rfl
  have hc : ¬p ∣ Nat.card (q.ker.map m) := by
    have hd := (q.ker.map π).card_map_dvd f
    rw [hf] at hd
    exact fun hp => not_dvd_card_kernel_quotient_image q Q P hP (hp.trans hd)
  have hsurj : Function.Surjective (m.comp T.subtype) := by
    have hmap : T.map m = ⊤ := by
      have hh := congrArg (Subgroup.map m) hgen
      have hL : L.map m = ⊥ := (map_eq_bot_iff L).mpr
        (by rw [QuotientGroup.ker_mk']; exact le_sup_left)
      rw [map_sup,hL,bot_sup_eq,map_top_of_surjective m (QuotientGroup.mk'_surjective U)] at hh
      exact hh
    intro x
    obtain ⟨t,ht,he⟩ := (show x ∈ T.map m by rw [hmap]; trivial)
    exact ⟨⟨t,ht⟩,he⟩
  have hp : IsPGroup p (G ⧸ U) := hT.of_surjective (m.comp T.subtype) hsurj
  have hb : q.ker.map m = ⊥ := card_eq_one.mp
    ((hp.to_subgroup _).card_eq_or_dvd.resolve_right hc)
  have hh := (map_eq_bot_iff _).mp hb
  rwa [QuotientGroup.ker_mk'] at hh

end Subgroup
