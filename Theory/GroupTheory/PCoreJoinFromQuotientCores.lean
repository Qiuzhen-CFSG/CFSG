module

public import Theory.GroupTheory.PCoreSurjective

/-!
# A two-core generated by two normal subgroups

Let Q and R be normal two-subgroups. If the two-core of G/Q has order four
and is a minimal normal subgroup, whereas the two-core of G/R has order
two, then O₂(G)=Q∨R. Indeed R cannot vanish modulo Q: the two core-order
formulas would contradict |R|≤|Q|. Its nonzero normal image must therefore
be the whole quotient core, whose preimage is O₂(G).

This is the common local argument for the linear and alternating branches
of Aschbacher–Smith I.5.7(1), printed p.420. The reducible S₆ branch is not
covered by the minimal-normal hypothesis and needs the separate source
argument using D5.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

theorem pCore_eq_sup_of_quotient_core_minimal
    (Q R : Subgroup G) [Q.Normal] [R.Normal]
    (hQ : IsPGroup 2 Q) (hR : IsPGroup 2 R)
    (hfour : Nat.card (pCore 2 (G ⧸ Q)) = 4)
    (htwo : Nat.card (pCore 2 (G ⧸ R)) = 2)
    (hmin : ∀ N : Subgroup (G ⧸ Q), N.Normal → N ≤ pCore 2 (G ⧸ Q) →
      N = ⊥ ∨ N = pCore 2 (G ⧸ Q)) : pCore 2 G = Q ⊔ R := by
  let q := QuotientGroup.mk' Q
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective Q
  have hqker : IsPGroup 2 q.ker := by rw [QuotientGroup.ker_mk']; exact hQ
  have hn : (R.map q).Normal := Normal.map inferInstance q hq
  have hle : R.map q ≤ pCore 2 (G ⧸ Q) := le_sSup ⟨hn, hR.map q⟩
  have hmap : R.map q = pCore 2 (G ⧸ Q) := by
    rcases hmin (R.map q) hn hle with hb | he
    · have hRQ : R ≤ Q := by
        have hh := (Subgroup.map_eq_bot_iff R).mp hb
        rwa [QuotientGroup.ker_mk'] at hh
      have hcQ := q.card_pCore_of_ker_isPGroup hq hqker
      have hcR := (QuotientGroup.mk' R).card_pCore_of_ker_isPGroup
        (QuotientGroup.mk'_surjective R)
        (by rw [QuotientGroup.ker_mk']; exact hR)
      rw [QuotientGroup.ker_mk', hfour] at hcQ
      rw [QuotientGroup.ker_mk', htwo] at hcR
      have hcard := card_le_of_le hRQ
      have hpos := Nat.card_pos (α := Q)
      omega
    · exact he
  have hpre := q.comap_pCore_of_ker_isPGroup hq hqker
  rw [← hmap, comap_map_eq, QuotientGroup.ker_mk'] at hpre
  exact hpre.symm.trans (sup_comm R Q)

end Subgroup

namespace MonoidHom
open Subgroup
variable {G K L : Type*} [Group G] [Group K] [Group L] [Finite G] [Finite K] [Finite L]

/-- The same core-join argument, retaining the two literal local quotient maps. -/
theorem pCore_eq_sup_kernels
    (f : G →* K) (g : G →* L) (hf : Function.Surjective f) (hg : Function.Surjective g)
    (hfk : IsPGroup 2 f.ker) (hgk : IsPGroup 2 g.ker)
    (hfour : Nat.card (pCore 2 K) = 4) (htwo : Nat.card (pCore 2 L) = 2)
    (hmin : ∀ N : Subgroup K, N.Normal → N ≤ pCore 2 K → N = ⊥ ∨ N = pCore 2 K) :
    pCore 2 G = f.ker ⊔ g.ker := by
  have hn : (g.ker.map f).Normal := Subgroup.Normal.map inferInstance f hf
  have hle : g.ker.map f ≤ pCore 2 K := le_sSup ⟨hn, hgk.map f⟩
  have hmap : g.ker.map f = pCore 2 K := by
    rcases hmin _ hn hle with hb | he
    · have hk : g.ker ≤ f.ker := (Subgroup.map_eq_bot_iff _).mp hb
      have hc1 := f.card_pCore_of_ker_isPGroup hf hfk
      have hc2 := g.card_pCore_of_ker_isPGroup hg hgk
      rw [hfour] at hc1
      rw [htwo] at hc2
      have hcard := Subgroup.card_le_of_le hk
      have hpos := Nat.card_pos (α := f.ker)
      omega
    · exact he
  have hpre := f.comap_pCore_of_ker_isPGroup hf hfk
  rw [← hmap, Subgroup.comap_map_eq] at hpre
  exact hpre.symm.trans (sup_comm _ _)

end MonoidHom
