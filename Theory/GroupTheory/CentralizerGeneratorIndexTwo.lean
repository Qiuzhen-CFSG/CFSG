module

public import Theory.GroupTheory.CentralizerGeneratorIndex
public import Theory.ElementaryAbelian.Basic
public import Mathlib.GroupTheory.IndexNormal

/-!
# The elementary quotient from index-two centralizers

If `U` is generated by a subgroup centralized by `Q` and elements whose
centralizers have index two in `Q`, then `C_Q(U)` is normal in `Q` and
`Q/C_Q(U)` is elementary abelian. Its kernel is the intersection of the
normal index-two centralizers, and every square lies in that intersection.
This does not require assuming in advance that `Q` normalizes `U`.

Together with `CentralizerGeneratorIndex`, this constructs the elementary
quotient of order at most 32 used in Aschbacher–Smith, Lemma 13.8.33,
printed pp.967–968 (1 March 2004 manuscript).
-/

public section

open Subgroup
namespace Subgroup
variable {G : Type*} [Group G]

private theorem centralizer_subgroupOf_generated {ι : Type*}
    (V Q U : Subgroup G) (x : ι → G)
    (hgen : U = V ⊔ closure (Set.range x)) (hQV : Q ≤ centralizer (V : Set G)) :
    (Q ⊓ centralizer (U : Set G)).subgroupOf Q =
      ⨅ i, (centralizer ({x i} : Set G)).subgroupOf Q := by
  rw [inf_centralizer_eq_of_generated V Q U x hgen hQV]
  ext q
  simp only [mem_subgroupOf, mem_inf, mem_iInf, q.property, true_and]

theorem centralizer_normal_of_generated_index_two {ι : Type*}
    (V Q U : Subgroup G) (x : ι → G)
    (hgen : U = V ⊔ closure (Set.range x)) (hQV : Q ≤ centralizer (V : Set G))
    (hi : ∀ i, (centralizer ({x i} : Set G)).relIndex Q = 2) :
    ((Q ⊓ centralizer (U : Set G)).subgroupOf Q).Normal := by
  rw [centralizer_subgroupOf_generated V Q U x hgen hQV]
  exact normal_iInf_normal fun i => normal_of_index_eq_two (hi i)

private theorem centralizer_quotient_square_eq_one_of_generated_index_two {ι : Type*}
    (V Q U : Subgroup G) (x : ι → G)
    (hgen : U = V ⊔ closure (Set.range x)) (hQV : Q ≤ centralizer (V : Set G))
    (hi : ∀ i, (centralizer ({x i} : Set G)).relIndex Q = 2)
    [((Q ⊓ centralizer (U : Set G)).subgroupOf Q).Normal]
    (q : Q ⧸ (Q ⊓ centralizer (U : Set G)).subgroupOf Q) : q ^ 2 = 1 := by
  induction q using QuotientGroup.induction_on with
  | H q =>
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff,
      centralizer_subgroupOf_generated V Q U x hgen hQV]
    exact mem_iInf.mpr fun i =>
      ((centralizer ({x i} : Set G)).subgroupOf Q).sq_mem_of_index_two (hi i) q

theorem elementary_centralizer_quotient_of_generated_index_two {ι : Type*}
    (V Q U : Subgroup G) (x : ι → G)
    (hgen : U = V ⊔ closure (Set.range x)) (hQV : Q ≤ centralizer (V : Set G))
    (hi : ∀ i, (centralizer ({x i} : Set G)).relIndex Q = 2)
    [((Q ⊓ centralizer (U : Set G)).subgroupOf Q).Normal] :
    IsElementaryAbelian 2 (Q ⧸ (Q ⊓ centralizer (U : Set G)).subgroupOf Q) := by
  have hpow := centralizer_quotient_square_eq_one_of_generated_index_two V Q U x hgen hQV hi
  exact {
    toIsMulCommutative := ⟨⟨fun a b =>
      (Commute.of_orderOf_dvd_two (fun q => orderOf_dvd_of_pow_eq_one (hpow q)) a b).eq⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hpow }

end Subgroup
