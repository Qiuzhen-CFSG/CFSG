module
public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Theory.GroupTheory.PGroup.FiveAutomorphismSmallCore
public import Theory.GroupTheory.PerfectSmallTwoAction
public import Theory.PGroupCore
public import Theory.GroupTheory.Commutator.PerfectLocalReduction

/-!
# Central small two-cores in perfect groups with a simple five-section

Orbit counting excludes automorphisms of order five on a group of order
dividing eight: distinct divisors of eight have distinct residues modulo
five, so all elements are fixed. A perfect group with a simple two-core
quotient of order divisible by five is generated by its five-elements.
Its action on a two-core of order dividing eight is therefore trivial.

Source application: Aschbacher–Smith, original 4.3.16(3), printed p.618.
The literal PSL₃(5) consumer is NonblockEndgameSieveExclusionsTernaryFive.
-/

public section
open Subgroup
namespace Theory.GroupTheory
local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

/-- Automorphisms of a group of order dividing eight have order prime to five. -/
theorem five_coprime_card_mulAut_of_card_dvd_eight
    {Q : Type*} [Group Q] [Finite Q] (hd : Nat.card Q ∣ 8) :
    Nat.Coprime 5 (Nat.card (MulAut Q)) := by
  apply Nat.prime_five.coprime_iff_not_dvd.mpr
  intro hfive
  obtain ⟨a,ha⟩ := exists_prime_orderOf_dvd_card' 5 hfive
  let A := zpowers a
  have hp : IsPGroup 5 A := IsPGroup.of_card (n := 1) (by
    simpa only [A,Nat.card_zpowers,pow_one] using ha)
  let F := FixedPoints.subgroup A Q
  have hm := hp.card_modEq_card_fixedPoints Q
  change Nat.card Q % 5 = Nat.card F % 5 at hm
  have hF : Nat.card F ∣ 8 := F.card_subgroup_dvd_card.trans hd
  have hqmem := Nat.mem_divisors.mpr ⟨hd,by decide⟩
  have hfmem := Nat.mem_divisors.mpr ⟨hF,by decide⟩
  rw [show (8 : ℕ).divisors = {1,2,4,8} by decide] at hqmem hfmem
  simp only [Finset.mem_insert,Finset.mem_singleton] at hqmem hfmem
  have he : Nat.card F = Nat.card Q := by omega
  have ht := F.eq_top_of_card_eq he
  have hone : a = 1 := by
    apply MulEquiv.ext
    intro x
    exact (show x ∈ F from ht ▸ mem_top x) ⟨a,mem_zpowers a⟩
  rw [hone,orderOf_one] at ha
  norm_num at ha

/-- A perfect simple-five section centralizes its two-core of order dividing eight. -/
theorem pCore_two_le_center_of_perfect_simple_five_section
    {H : Type*} [Group H] [Finite H] [Group.IsPerfect H]
    [IsSimpleGroup (H ⧸ pCore 2 H)]
    (hd : 5 ∣ Nat.card (H ⧸ pCore 2 H)) (hsmall : Nat.card (pCore 2 H) ∣ 8) :
    pCore 2 H ≤ center H := by
  have hp : IsPPerfect 2 H := by
    intro N hN hquot
    let := hN
    let : Group.IsNilpotent (H ⧸ N) := hquot.isNilpotent
    exact top_le_iff.mp (le_of_isPerfect_of_solvable_quotient ⊤ N)
  have hres := primeToResidual_eq_top_of_simple_quotient 5 2
    (pCore 2 H) pCore_isPGroup hp hd
  let f : H →* MulAut (pCore 2 H) := MulAut.conjNormal
  have hk := primeToResidual_le_ker f
    (five_coprime_card_mulAut_of_card_dvd_eight hsmall)
  rw [hres] at hk
  intro x hx
  apply mem_center_iff.mpr
  intro y
  have he := congrArg (fun a : MulAut (pCore 2 H) => (a ⟨x,hx⟩ : H)) (hk (mem_top y))
  change y * x * y⁻¹ = x at he
  exact mul_inv_eq_iff_eq_mul.mp he
end Theory.GroupTheory
