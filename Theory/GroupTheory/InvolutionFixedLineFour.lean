module

public import Theory.GroupTheory.PGroup.NormalIndexTwoStep
public import Theory.GroupTheory.CharacteristicCentralizerFusion
import Mathlib.Tactic

/-!
# An invariant subgroup of order four from a fixed involution line

Let `Q` be a finite two-group containing an involution `r`, and let `s` be a
commuting involution which normalizes `Q`.  If `Q` has order greater than two,
the normalizer condition applied to `⟨r⟩` gives a strict intermediate
normalizer.  The subgroup generated by that normalizer and `s` is again a
two-group; the normal index-two step theorem then produces a normal subgroup
of order four containing `r`, which is normalized by `s`.

The fixed-line equality and the exclusion of `s` from `Q` are retained in the
interface used by the quasithin argument.  The intrinsic construction below
only needs the displayed two-group, involution, commutation and normalizer
hypotheses.

Source: Aschbacher--Smith, combined manuscript of 1 March 2004, printed
p.1190, paragraph after `(+)`.
-/

namespace Subgroup

open scoped Pointwise

/-- Invariant order-four subgroup from a two-group and a commuting involution. -/
public theorem exists_invariant_order_four_subgroup
    {G : Type*} [Group G] [Finite G]
    (Q : Subgroup G) (hQ : IsPGroup 2 Q) (hQcard : 2 < Nat.card Q)
    {r s : G} (hrQ : r ∈ Q) (hr2 : orderOf r = 2) (hs2 : orderOf s = 2)
    (hcomm : Commute r s) (_hsnot : s ∉ Q) (hsQ : s ∈ normalizer (Q : Set G))
    (_hfixed : Q ⊓ centralizer ({s} : Set G) = zpowers r) :
    ∃ X : Subgroup G, X ≤ Q ∧ Nat.card X = 4 ∧ r ∈ X ∧
      s ∈ normalizer (X : Set G) := by
  let R : Subgroup G := zpowers r
  have hRcard : Nat.card R = 2 := by
    dsimp [R]
    rw [Nat.card_zpowers, hr2]
  have hRQ : R ≤ Q := by
    dsimp [R]
    exact zpowers_le.mpr hrQ
  have hRltQ : R < Q := by
    apply lt_of_le_of_ne hRQ
    intro heq
    have hc := congrArg (fun S : Subgroup G => Nat.card S) heq
    rw [hRcard] at hc
    omega
  let RQ : Subgroup Q := R.subgroupOf Q
  have hRQtop : RQ ≠ ⊤ := by
    intro heq
    have hle : Q ≤ R := subgroupOf_eq_top.mp heq
    exact (not_le_of_gt hRltQ) hle
  have hRQproper : RQ < (⊤ : Subgroup Q) := lt_top_iff_ne_top.mpr hRQtop
  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let _ : Group.IsNilpotent Q := hQ.isNilpotent
  obtain ⟨x, hxN, hxnot⟩ := SetLike.exists_of_lt
    ((Group.normalizerCondition_of_isNilpotent (G := Q)) RQ hRQproper)
  let B : Subgroup G := Q ⊓ normalizer (R : Set G)
  have hRB : R ≤ B := le_inf hRQ le_normalizer
  have hxN' : x ∈ (normalizer (R : Set G)).subgroupOf Q := by
    rw [subgroupOf_normalizer_eq hRQ]
    exact hxN
  have hxB : (x : G) ∈ B := ⟨x.property, hxN'⟩
  have hxnotR : (x : G) ∉ R := by exact hxnot
  have hRltB : R < B := by
    apply lt_of_le_of_ne hRB
    intro heq
    exact hxnotR (heq.symm ▸ hxB)
  have hsR : s ∈ normalizer (R : Set G) := by
    dsimp [R]
    apply centralizer_le_normalizer _
    rw [zpowers_eq_closure, centralizer_closure]
    exact mem_centralizer_singleton_iff.mpr hcomm.eq.symm
  have hmapR : R.map (MulAut.conj s).toMonoidHom = R :=
    mem_normalizer_iff_map_conj_eq.mp hsR
  have hmapQ : Q.map (MulAut.conj s).toMonoidHom = Q :=
    mem_normalizer_iff_map_conj_eq.mp hsQ
  have hmapNR : (normalizer (R : Set G)).map (MulAut.conj s).toMonoidHom =
      normalizer (R : Set G) := by
    rw [map_normalizer_eq_of_bijective R (MulAut.conj s).bijective]
    rw [hmapR]
  have hsB : s ∈ normalizer (B : Set G) := by
    apply mem_normalizer_iff_map_conj_eq.mpr
    dsimp [B]
    rw [Subgroup.map_inf _ _ _ (MulAut.conj s).injective]
    simpa only [MulEquiv.toMonoidHom_eq_coe] using congrArg₂ (· ⊓ ·) hmapQ hmapNR
  let H : Subgroup G := B ⊔ zpowers s
  have hBQ : B ≤ Q := inf_le_left
  have hBPG : IsPGroup 2 B :=
    (hQ.to_subgroup (B.subgroupOf Q)).of_equiv (subgroupOfEquivOfLe hBQ)
  have hSPG : IsPGroup 2 (zpowers s) := by
    exact IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hs2, pow_one])
  have hHPG : IsPGroup 2 H := by
    dsimp [H]
    exact hBPG.to_sup_of_normal_left' hSPG (zpowers_le.mpr hsB)
  have hBH : B ≤ H := by
    dsimp [H]
    exact le_sup_left
  have hRH : R ≤ H := hRB.trans hBH
  have hHnormB : H ≤ normalizer (B : Set G) := by
    dsimp [H]
    exact sup_le le_normalizer (zpowers_le.mpr hsB)
  have hHnormR : H ≤ normalizer (R : Set G) := by
    dsimp [H]
    exact sup_le inf_le_right (zpowers_le.mpr hsR)
  let _ : (B.subgroupOf H).Normal :=
    (normal_subgroupOf_iff_le_normalizer hBH).mpr hHnormB
  let _ : (R.subgroupOf H).Normal :=
    (normal_subgroupOf_iff_le_normalizer hRH).mpr hHnormR
  have hltSub : R.subgroupOf H < B.subgroupOf H := by
    apply lt_of_le_of_ne (subgroupOf_mono H hRB)
    intro heq
    have heq' := congrArg (fun K : Subgroup H => K.map H.subtype) heq
    rw [map_subgroupOf_eq_of_le hRH, map_subgroupOf_eq_of_le hBH] at heq'
    exact (ne_of_lt hRltB) heq'
  obtain ⟨Y, hYn, hRY, hYB, hrel⟩ :=
    exists_normal_index_two_step H hHPG (R.subgroupOf H) (B.subgroupOf H) hltSub
  let X : Subgroup G := Y.map H.subtype
  have hXQ : X ≤ Q := by
    change Y.map H.subtype ≤ Q
    calc
      Y.map H.subtype ≤ (B.subgroupOf H).map H.subtype := map_mono hYB
      _ = B := map_subgroupOf_eq_of_le hBH
      _ ≤ Q := hBQ
  have hrX : r ∈ X := by
    let rH : H := ⟨r, hRH (mem_zpowers r)⟩
    have hrY : rH ∈ Y := hRY (mem_subgroupOf.mpr (mem_zpowers r))
    exact mem_map_of_mem H.subtype hrY
  let _ : Y.Normal := hYn
  have hsHmem : s ∈ H := by
    dsimp [H]
    exact mem_sup_right (mem_zpowers s)
  let sH : H := ⟨s, hsHmem⟩
  have hsY : sH ∈ normalizer (Y : Set H) := by
    exact (le_normalizer_of_normal (H := Y) (K := (⊤ : Subgroup H))) (by simp)
  have hmapY : Y.map (MulAut.conj sH).toMonoidHom = Y :=
    mem_normalizer_iff_map_conj_eq.mp hsY
  have hconj :
      (MulAut.conj s).toMonoidHom.comp H.subtype =
        H.subtype.comp (MulAut.conj sH).toMonoidHom := by
    ext y
    rfl
  have hsX : s ∈ normalizer (X : Set G) := by
    apply mem_normalizer_iff_map_conj_eq.mpr
    change (Y.map H.subtype).map (MulAut.conj s).toMonoidHom = Y.map H.subtype
    rw [map_map, hconj, ← map_map, hmapY]
  have hRcardH : Nat.card (R.subgroupOf H) = 2 := by
    calc
      Nat.card (R.subgroupOf H) = Nat.card ((R.subgroupOf H).map H.subtype) :=
        (card_map_of_injective H.subtype_injective).symm
      _ = Nat.card R := by rw [map_subgroupOf_eq_of_le hRH]
      _ = 2 := hRcard
  have hidx : (R.subgroupOf H).relIndex Y * Y.index = (R.subgroupOf H).index :=
    relIndex_mul_index hRY
  have hidx' : 2 * Y.index = (R.subgroupOf H).index := by
    rw [hrel] at hidx
    exact hidx
  have hprod : 4 * Y.index = Nat.card Y * Y.index := by
    calc
      4 * Y.index = 2 * (2 * Y.index) := by ring
      _ = 2 * (R.subgroupOf H).index := by rw [hidx']
      _ = Nat.card (R.subgroupOf H) * (R.subgroupOf H).index := by rw [hRcardH]
      _ = Nat.card H := (R.subgroupOf H).card_mul_index
      _ = Nat.card Y * Y.index := Y.card_mul_index.symm
  have hYcard : Nat.card Y = 4 := by
    have hYindexpos : 0 < Y.index := by
      rw [index_eq_card]
      exact Nat.card_pos
    apply Nat.eq_of_mul_eq_mul_right hYindexpos
    exact hprod.symm
  have hXcard : Nat.card X = 4 := by
    calc
      Nat.card X = Nat.card Y := by
        dsimp [X]
        exact card_map_of_injective H.subtype_injective
      _ = 4 := hYcard
  exact ⟨X, hXQ, hXcard, hrX, hsX⟩

end Subgroup
