module
public import Mathlib.GroupTheory.OrderOfElement
/-!
# Separating elements from finitely generated subgroups by predicates

A Boolean predicate containing the identity and preserved by right multiplication
by the specified generators contains their generated subgroup. In a finite group,
the submonoid and subgroup generated by a set agree; thus positive transitions
suffice, without separate inverse transitions. A false value separates an element
from the subgroup.

This supports the coordinate certificates for `SmallEvenNodeWitnessesLower`.
Source: finite-order positive-word generation (`Subgroup.closure_toSubmonoid_of_finite`).
-/

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- A right-invariant finite predicate separates an element from a generated subgroup. -/
public theorem not_mem_closure_of_right_invariant_predicate {ι : Type*} (gen : ι → G) (g : G)
    (p : G → Bool)
    (hinv : ∀ x, p x = true → ∀ i, p (x * gen i) = true)
    (hbase : p 1 = true) (hout : p g = false) :
    g ∉ Subgroup.closure (Set.range gen) := by
  let H : Submonoid G :=
    { carrier := {y | ∀ x, p x = true → p (x * y) = true}
      one_mem' := by intro x hx; simpa only [mul_one] using hx
      mul_mem' := by
        intro a b ha hb x hx
        rw [← mul_assoc]
        exact hb (x*a) (ha x hx) }
  have hle : Submonoid.closure (Set.range gen) ≤ H := by
    rw [Submonoid.closure_le]
    rintro _ ⟨i, rfl⟩ x hx
    exact hinv x hx i
  intro hg
  have hg' : g ∈ Submonoid.closure (Set.range gen) := by
    rw [← Subgroup.closure_toSubmonoid_of_finite]
    exact hg
  have h := hle hg' 1 hbase
  change p (1 * g) = true at h
  rw [one_mul, hout] at h
  cases h
end Subgroup
