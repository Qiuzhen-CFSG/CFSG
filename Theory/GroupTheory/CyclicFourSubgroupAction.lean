module
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# The automorphism action on cyclic subgroups of order four

The type `CyclicFourSubgroups G` records subgroups generated by an element
of order four, without choosing a generator. Every group automorphism maps
such a subgroup to another one; functoriality of subgroup images gives a
permutation representation of the full automorphism group.

For a central product of two quaternion groups of order eight, these points
are the three axes in each factor. Their permutation action is the intrinsic
six-point realization used to construct the outer wreath-product embedding.
The application is the quaternion central-product argument in Janko–Thompson,
Math. Z. 113 (1970), §4, printed p.390; the construction itself uses only
functoriality of element order and cyclic subgroups.
-/

namespace Subgroup

/-- The intrinsic cyclic subgroups generated by an element of order four. -/
@[expose] public def CyclicFourSubgroups (G : Type*) [Group G] :=
  {D : Subgroup G // ∃ x : G, orderOf x = 4 ∧ D = zpowers x}

private theorem cyclicFour_map {G : Type*} [Group G]
    (a : MulAut G) (D : CyclicFourSubgroups G) :
    ∃ x : G, orderOf x = 4 ∧ D.val.map a.toMonoidHom = zpowers x := by
  obtain ⟨x, hx, hD⟩ := D.property
  refine ⟨a x, (a.orderOf_eq x).trans hx, ?_⟩
  rw [hD, MonoidHom.map_zpowers]
  rfl

/-- Automorphisms act on the cyclic subgroups of order four. -/
public def cyclicFourAction {G : Type*} [Group G] :
    MulAut G →* Equiv.Perm (CyclicFourSubgroups G) where
  toFun a :=
    { toFun := fun D => ⟨D.val.map a.toMonoidHom, cyclicFour_map a D⟩
      invFun := fun D => ⟨D.val.map a.symm.toMonoidHom, cyclicFour_map a.symm D⟩
      left_inv := by
        intro D
        apply Subtype.ext
        simp only [map_map]
        have h : a.symm.toMonoidHom.comp a.toMonoidHom = MonoidHom.id G := by
          ext x
          exact a.symm_apply_apply x
        rw [h, map_id]
      right_inv := by
        intro D
        apply Subtype.ext
        simp only [map_map]
        have h : a.toMonoidHom.comp a.symm.toMonoidHom = MonoidHom.id G := by
          ext x
          exact a.apply_symm_apply x
        rw [h, map_id] }
  map_one' := by
    ext D : 2
    apply Subtype.ext
    exact map_id D.val
  map_mul' := by
    intro a b
    ext D : 2
    apply Subtype.ext
    exact (map_map D.val a.toMonoidHom b.toMonoidHom).symm

@[simp] public theorem cyclicFourAction_apply_val {G : Type*} [Group G]
    (a : MulAut G) (D : CyclicFourSubgroups G) :
    (cyclicFourAction a D).val = D.val.map a.toMonoidHom := by rfl

/-- The axis-action kernel consists exactly of automorphisms preserving every
cyclic subgroup generated by an element of order four. -/
public theorem cyclicFourAction_eq_one_iff {G : Type*} [Group G] (a : MulAut G) :
    cyclicFourAction a = 1 ↔ ∀ x : G, orderOf x = 4 →
      (zpowers x).map a.toMonoidHom = zpowers x := by
  constructor
  · intro h x hx
    exact congrArg
      (fun p : Equiv.Perm (CyclicFourSubgroups G) =>
        (p ⟨zpowers x, x, hx, rfl⟩).val) h
  · intro h
    apply Equiv.ext
    rintro ⟨D, x, hx, rfl⟩
    apply Subtype.ext
    exact h x hx

end Subgroup
