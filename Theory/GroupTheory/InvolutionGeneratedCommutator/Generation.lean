module

public import Theory.GroupTheory.InvolutionGeneratedCommutator

/-!+# Involution generation from a normally generating actor

Let K be normal in G and suppose [K,B] = K. If B lies in the normal
closure of A and every element of [K,A] squares to one, then K is
generated by its involutions. Indeed the involution-generated subgroup
of K is normal in G. The commutator bound against A therefore extends
to its normal closure, and hence to B.

This is the normal-closure step in the critical-pair argument of
Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), (3.6), printed p.870. Using the commutators of K itself avoids
requiring all commutators of a larger two-group to lie in K.
-/

namespace Subgroup

/-- A normally generating actor whose commutators square to one generates
the moving normal subgroup by involutions. The ambient group need not be finite. -/
public theorem closure_involutions_eq_top_of_commutator_generation
    {G : Type*} [Group G] (K A B : Subgroup G) [K.Normal]
    (hB : B ≤ normalClosure (A : Set G)) (hK : ⁅K, B⁆ = K)
    (hpow : ∀ x ∈ ⁅K, A⁆, x ^ 2 = 1) :
    closure {x : K | x ^ 2 = 1} = ⊤ := by
  have hcomm : ⁅K, A⁆ ≤ involutionGenerated K := by
    intro x hx
    exact subset_closure ⟨commutator_le_left K A hx, hpow x hx⟩
  have hKI : K ≤ involutionGenerated K :=
    hK.symm.le.trans ((commutator_mono le_rfl hB).trans
      (commutator_normalClosure_le_of_normal K A (involutionGenerated K) hcomm))
  have hmap : involutionGenerated K ≤
      (closure {x : K | x ^ 2 = 1}).map K.subtype := by
    apply (closure_le _).mpr
    rintro x ⟨hx, hp⟩
    exact ⟨⟨x, hx⟩, subset_closure (Subtype.ext hp), rfl⟩
  apply top_unique
  intro x _
  obtain ⟨y, hy, he⟩ := hmap (hKI x.property)
  exact (Subtype.ext he : y = x) ▸ hy

end Subgroup
