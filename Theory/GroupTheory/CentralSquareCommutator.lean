module
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Algebra.Group.Hom.Basic
public import Mathlib.Tactic.Group
/-! # Commutator squares in an abelian normal subgroup
If squares of an abelian normal subgroup are central, its commutators have
exponent two. If the subgroup's image is generated by these commutators
and the kernel has exponent two, the original subgroup has exponent two.
Source application: Aschbacher--Smith I.2.2(3a), printed pp.410--411. -/
public section
open Subgroup
open scoped commutatorElement IsMulCommutative
namespace Theory.GroupTheory.CentralSquares
variable {A : Type*} [Group A]
theorem commutator_pow_two (R:Subgroup A) [R.Normal] [IsMulCommutative R]
    (hs:∀ r∈R,r^2∈center A) : ∀ x∈⁅R,(⊤:Subgroup A)⁆,x^2=1 := by
  let : CommGroup R := IsMulCommutative.instCommGroup
  let Q : Subgroup A := (powMonoidHom 2 : R→*R).ker.map R.subtype
  have hQ : ⁅R,(⊤:Subgroup A)⁆≤Q := by
    apply commutator_le.mpr
    intro r hr p _
    have hpr : p*r⁻¹*p⁻¹∈R := (inferInstance : R.Normal).conj_mem _ (R.inv_mem hr) p
    have he : Commute r (p*r⁻¹*p⁻¹) := by
      exact congrArg Subtype.val (mul_comm (⟨r,hr⟩:R) ⟨_,hpr⟩)
    have hsq : ⁅r,p⁆^2=1 := by
      rw [commutatorElement_def,show r*p*r⁻¹*p⁻¹=r*(p*r⁻¹*p⁻¹) by group,he.mul_pow]
      rw [show (p*r⁻¹*p⁻¹)^2=p*(r^2)⁻¹*p⁻¹ by simp only [pow_two, mul_inv_rev]; group]
      rw [mem_center_iff.mp ((center A).inv_mem (hs r hr)) p]
      group
    refine ⟨⟨⁅r,p⁆,commutator_le_left R ⊤ (commutator_mem_commutator hr (mem_top p))⟩,?_,rfl⟩
    exact Subtype.ext hsq
  intro x hx
  obtain ⟨v,hv,rfl⟩ := hQ hx
  exact congrArg Subtype.val hv

/-- A central elementary kernel and full commutator image force exponent two. -/
theorem pow_two_of_full_commutator_image {B:Type*} [Group B]
    (f:A→*B) (hf:Function.Surjective f) (hk:∀x∈f.ker,x^2=1)
    (R:Subgroup A) [R.Normal] [IsMulCommutative R]
    (hs:∀r∈R,r^2∈center A)
    (him:⁅R.map f,(⊤:Subgroup B)⁆=R.map f) : ∀r∈R,r^2=1 := by
  have hd : (⁅R,(⊤:Subgroup A)⁆).map f=R.map f := by
    rw [map_commutator, map_top_of_surjective f hf,him]
  intro r hr
  obtain ⟨u,hu,hur⟩ := hd.symm ▸ (mem_map_of_mem f hr)
  have huR : u∈R := commutator_le_left _ _ hu
  have hu2 : u^2=1 := commutator_pow_two R hs u hu
  have hvker : r*u⁻¹∈f.ker := by rw [MonoidHom.mem_ker,map_mul,map_inv,hur,mul_inv_cancel]
  have hv2 := hk _ hvker
  have hcomm : Commute (r*u⁻¹) u := by
    exact congrArg Subtype.val (mul_comm (⟨r*u⁻¹,R.mul_mem hr (R.inv_mem huR)⟩:R) ⟨u,huR⟩)
  have he := hcomm.mul_pow 2
  rw [inv_mul_cancel_right,hv2,hu2,one_mul] at he
  exact he
end Theory.GroupTheory.CentralSquares
