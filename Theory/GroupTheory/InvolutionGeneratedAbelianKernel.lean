module
public import Theory.GroupTheory.InvolutionGeneratedOddKernel
public import Theory.GroupTheory.Commutator.RelativeGeneration

/-!
# Odd abelian kernels generated by involution commutators

In an involution-generated group, every odd subgroup lies in the derived
subgroup. If an abelian odd normal subgroup and an abelian complement generate
the group, their mutual commutator contains the whole derived subgroup.
Consequently that mutual commutator is the original odd subgroup.

This supplies the full-commutator premise of the cyclic small-support
classification when the source has constructed the generating pair.
-/

@[expose] public section
namespace Subgroup
variable {G : Type*} [Group G]

theorem odd_abelian_kernel_eq_commutator_of_involution_generated
    {Z : Set G} (hZ : closure Z = ⊤) (hsq : ∀ z ∈ Z, z ^ 2 = 1)
    (P : Subgroup G) [P.Normal] [IsMulCommutative P] [Finite P]
    (hodd : Odd (Nat.card P)) (A : Subgroup G) [IsMulCommutative A]
    (hgen : P ⊔ A = ⊤) : ⁅P,A⁆ = P := by
  have hn : (⊤ : Subgroup G) ≤ normalizer ((⁅P,A⁆ : Subgroup G) : Set G) := by
    rw [← hgen]
    exact sup_le (normalizer_commutator_ge_left P A) (normalizer_commutator_ge_right P A)
  have hp : ⁅P,⊤⁆ ≤ ⁅P,A⁆ := by
    rw [commutator_comm,← hgen]
    apply commutator_sup_le_of_relative_normal ⊤ P A P ⁅P,A⁆ hn le_top le_top
    · rw [commutator_self_eq_bot_iff.mpr inferInstance]; exact bot_le
    · rw [commutator_comm]
  have ha : ⁅A,⊤⁆ ≤ ⁅P,A⁆ := by
    rw [commutator_comm,← hgen]
    apply commutator_sup_le_of_relative_normal ⊤ P A A ⁅P,A⁆ hn le_top le_top le_rfl
    rw [commutator_self_eq_bot_iff.mpr inferInstance]
    exact bot_le
  have hd : _root_.commutator G ≤ ⁅P,A⁆ := by
    rw [_root_.commutator_def]
    conv_lhs => lhs; rw [← hgen]
    exact commutator_sup_le_of_relative_normal ⊤ P A ⊤ ⁅P,A⁆ hn le_top le_top hp ha
  exact le_antisymm (commutator_le_left P A)
    ((le_commutator_of_odd_of_involution_generated hZ hsq P hodd).trans hd)
end Subgroup
