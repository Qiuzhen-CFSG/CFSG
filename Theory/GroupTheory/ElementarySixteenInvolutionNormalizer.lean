module
public import Theory.GroupAction.PTimesQ
public import Mathlib.GroupTheory.GroupAction.ConjAct
public import Mathlib.Algebra.Group.Action.End
public import Theory.GroupTheory.ElementaryKernelInvolutionNormalizer
public import Theory.GroupTheory.ElementaryEightPlaneOrder24
public import Theory.GroupTheory.NormalCenterQuotient
public import Mathlib.Tactic

/-!
# An S4 normalizer above an involution centralizer

Let a finite group map onto W with a self-centralizing elementary two-kernel
A of order16. Let U be elementary of order8, normalized by A, with A∩U of
order4 and C_A(U)=A∩U. Suppose the image of U is generated by an involution z,
and C_W(z)/⟨z⟩ is S3. Then C_G(U)=U and N_G(U)/U is S4. The quotient maps
and kernels are explicit; no splitting or normalizer model is assumed.

The elementary-kernel preimage theorem identifies N_G(U) with the inverse
image of C_W(z), giving order192. A cubic element centralizing U commutes
with the two-group U and fixes C_A(U). The existing P×Q lemma makes it fix
all of A, and self-centralization of A then makes it trivial. Thus the
normalizer's centralizer of U is a two-group. Its normal image in S3 is
trivial, so its elements lie over ⟨z⟩, hence in AU. The fixed-intersection
hypothesis and commutativity of U identify this centralizer with U.

Conjugation on U now has kernel U and image of order24. It preserves the
order4 plane A∩U because A is the original normal kernel. The elementary-eight
plane-stabilizer recognition theorem identifies the image with S4; composing
the actual conjugation map with this equivalence supplies the requested
surjection and exact kernel.

Source: the initial-vertex local normalizer in Stellmacher (9.1), Journal of
Algebra190 (1997), p.48. This reusable theorem has no campaign imports.
-/

namespace Subgroup

private theorem cubic_centralizer_eq_one
    {G : Type*} [Group G] [Finite G] (A U : Subgroup G) [A.Normal]
    (hA : IsElementaryAbelian 2 A) (hU : IsElementaryAbelian 2 U)
    (hself : centralizer (A : Set G) ≤ A)
    (hfixed : A ⊓ centralizer (U : Set G) = A ⊓ U)
    (t : G) (ht : t ∈ centralizer (U : Set G)) (ht3 : t ^ 3 = 1) : t = 1 := by
  classical
  let := hA
  let := hU
  let : MulDistribMulAction G A := MulDistribMulAction.compHom A (MulAut.conjNormal : G →* MulAut A)
  let Q := zpowers t
  have hQle : Q ≤ centralizer (U : Set G) := zpowers_le.mpr ht
  have hQcop : Nat.Coprime 2 (Nat.card Q) := by
    have hd : Nat.card Q ∣ 3 := by rw [Nat.card_zpowers]; exact orderOf_dvd_of_pow_eq_one ht3
    exact (by decide : Nat.Coprime 2 3).of_dvd_right hd
  have hcomm : ⁅U, Q⁆ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hQle)
  have hQfix : Q ≤ fixingSubgroup G (FixedPoints.subgroup U A : Set A) := by
    intro q hq
    apply (mem_fixingSubgroup_iff G).mpr
    intro a ha
    have haC : (a : G) ∈ centralizer (U : Set G) := by
      apply mem_centralizer_iff.mpr
      intro u hu
      have hh := congrArg Subtype.val (ha (⟨u, hu⟩ : U))
      change u * (a : G) * u⁻¹ = (a : G) at hh
      exact mul_inv_eq_iff_eq_mul.mp hh
    have haU : (a : G) ∈ U := (hfixed ▸ (show (a : G) ∈ A ⊓ centralizer (U : Set G) from ⟨a.property, haC⟩)).2
    apply Subtype.ext
    change q * (a : G) * q⁻¹ = (a : G)
    rw [← mem_centralizer_iff.mp (hQle hq) a haU, mul_inv_cancel_right]
  have hfix := p_times_q_lemma U Q (IsElementaryAbelian.isPGroup 2 U) hQcop hcomm hQfix
  have htA : t ∈ A := by
    apply hself
    apply mem_centralizer_iff.mpr
    intro a ha
    have hh := (mem_fixingSubgroup_iff G).mp (hfix (mem_zpowers t)) (⟨a, ha⟩ : A) trivial
    have hh' := congrArg Subtype.val hh
    change t * a * t⁻¹ = a at hh'
    exact (mul_inv_eq_iff_eq_mul.mp hh').symm
  have ht2 : t ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian t htA
  simpa only [pow_succ, ht2, one_mul] using ht3

private theorem normal_two_perm_three_eq_bot (P : Subgroup (Equiv.Perm (Fin 3))) [P.Normal]
    (hp : IsPGroup 2 P) : P = ⊥ := by
  have hcard : Nat.card (Equiv.Perm (Fin 3)) = 6 := by
    simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  have hd := P.card_subgroup_dvd_card
  rw [hcard] at hd
  have hcop : Nat.Coprime (Nat.card P) 3 := by
    obtain ⟨n, hn⟩ := hp.exists_card_eq
    rw [hn]
    exact (by decide : Nat.Coprime 2 3).pow_left n
  have hd2 : Nat.card P ∣ 2 := hcop.dvd_mul_right.mp hd
  rcases (Nat.dvd_prime Nat.prime_two).mp hd2 with hc | hc
  · exact Subgroup.card_eq_one.mp hc
  · apply le_antisymm _ bot_le
    intro p hp
    have hh := Subgroup.central_of_normal_card_two P hc hp
    have hsmall : ∀ x : Equiv.Perm (Fin 3), (∀ y, y*x=x*y) → x=1 := by decide +kernel
    exact hsmall p (Subgroup.mem_center_iff.mp hh)

/-- Lift an involution centralizer quotient through a faithful elementary
sixteen: the selected eight is self-centralizing and has normalizer quotient S4. -/
public theorem _root_.exists_symmetric_four_normalizer_of_faithful_elementary_sixteen
    {G W : Type*} [Group G] [Finite G] [Group W] [Finite W]
    (f : G →* W) (hfsur : Function.Surjective f) (U : Subgroup G)
    (hA : IsElementaryAbelian 2 f.ker) (hAcard : Nat.card f.ker = 16)
    (hself : centralizer (f.ker : Set G) ≤ f.ker)
    (hU : IsElementaryAbelian 2 U) (hUcard : Nat.card U = 8)
    (hAN : f.ker ≤ normalizer (U : Set G))
    (hIcard : Nat.card (f.ker ⊓ U : Subgroup G) = 4)
    (hfixed : f.ker ⊓ centralizer (U : Set G) = f.ker ⊓ U)
    (z : W) (hz : orderOf z = 2) (himage : U.map f = zpowers z)
    (ψ : centralizer ({z} : Set W) →* Equiv.Perm (Fin 3))
    (hψsur : Function.Surjective ψ)
    (hψker : ψ.ker = (zpowers z).subgroupOf (centralizer ({z} : Set W))) :
    centralizer (U : Set G) = U ∧
      ∃ F : normalizer (U : Set G) →* Equiv.Perm (Fin 4),
        Function.Surjective F ∧ F.ker = U.subgroupOf (normalizer (U : Set G)) := by
  classical
  let := hA
  let := hU
  let A := f.ker
  let N := normalizer (U : Set G)
  let C := centralizer ({z} : Set W)
  have hNC : N = C.comap f := normalizer_eq_comap_centralizer_of_elementary_kernel
    f U hA hU hfixed z hz himage
  let π : N →* C := (f.comp N.subtype).codRestrict C (fun x => hNC.le x.property)
  have hπsur : Function.Surjective π := by
    intro c
    obtain ⟨x, hx⟩ := hfsur c
    have hxN : x ∈ N := by rw [hNC]; change f x ∈ C; rw [hx]; exact c.property
    exact ⟨⟨x, hxN⟩, Subtype.ext hx⟩
  have hπker : π.ker = A.subgroupOf N := by
    ext x
    change π x = 1 ↔ f (x : G) = 1
    exact Subtype.ext_iff
  have hzC : zpowers z ≤ C := by
    apply zpowers_le.mpr
    exact mem_centralizer_singleton_iff.mpr (Commute.refl z)
  have hψcard : Nat.card ψ.ker = 2 := by
    rw [hψker, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hzC).toEquiv,
      Nat.card_zpowers, hz]
  have hCcard : Nat.card C = 12 := by
    have hh := ψ.ker.card_mul_index
    rw [hψcard, Subgroup.index_ker, ψ.range_eq_top_of_surjective hψsur, card_top] at hh
    have hs3 : Nat.card (Equiv.Perm (Fin 3)) = 6 := by simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
    rw [hs3] at hh
    exact hh.symm
  have hπcard : Nat.card π.ker = 16 := by
    rw [hπker, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hAN).toEquiv]
    exact hAcard
  have hNcard : Nat.card N = 192 := by
    have hh := π.ker.card_mul_index
    rw [hπcard, Subgroup.index_ker, π.range_eq_top_of_surjective hπsur, card_top, hCcard] at hh
    exact hh.symm
  let Un := U.subgroupOf N
  let : Un.Normal := (normal_subgroupOf_iff_le_normalizer U.le_normalizer).mpr le_rfl
  let K := centralizer (Un : Set N)
  have hKnormal : K.Normal := inferInstance
  have hKno3 : ¬ 3 ∣ Nat.card K := by
    intro hdiv
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := K) 3 hdiv
    have hxt : ((x : N) : G) ∈ centralizer (U : Set G) := by
      apply mem_centralizer_iff.mpr
      intro u hu
      exact congrArg Subtype.val (mem_centralizer_iff.mp x.property (⟨u, U.le_normalizer hu⟩ : N) hu)
    have hx3 : ((x : N) : G) ^ 3 = 1 := by
      have hh : x ^ 3 = 1 := by rw [← hx]; exact pow_orderOf_eq_one x
      exact congrArg (fun y : K => ((y : N) : G)) hh
    have hxone := cubic_centralizer_eq_one A U hA hU hself hfixed x hxt hx3
    have hxone' : x = 1 := Subtype.val_injective (Subtype.val_injective hxone)
    simp [hxone'] at hx
  have hKp : IsPGroup 2 K := by
    have hd : Nat.card K ∣ 192 := hNcard ▸ K.card_subgroup_dvd_card
    have hc : Nat.Coprime (Nat.card K) 3 := (Nat.prime_three.coprime_iff_not_dvd.mpr hKno3).symm
    exact IsPGroup.of_card_dvd_pow (n := 6) (hc.dvd_mul_right.mp hd)
  let κ := ψ.comp π
  have hκsur : Function.Surjective κ := hψsur.comp hπsur
  let : (K.map κ).Normal := hKnormal.map κ hκsur
  have hKmap : K.map κ = ⊥ := normal_two_perm_three_eq_bot _ (hKp.map κ)
  have hKker : K ≤ κ.ker := (map_eq_bot_iff K).mp hKmap
  have hcentral : centralizer (U : Set G) = U := by
    apply le_antisymm
    · intro x hx
      have hxN : x ∈ N := centralizer_le_normalizer _ hx
      have hxK : (⟨x, hxN⟩ : N) ∈ K := by
        apply mem_centralizer_iff.mpr
        intro u hu
        exact Subtype.ext (mem_centralizer_iff.mp hx u hu)
      have hxψ : π ⟨x, hxN⟩ ∈ ψ.ker := hKker hxK
      rw [hψker] at hxψ
      have hxf : f x ∈ U.map f := by rw [himage]; exact hxψ
      have hxAU : x ∈ A ⊔ U := by
        have hh : x ∈ (U.map f).comap f := hxf
        rw [comap_map_eq, sup_comm] at hh
        exact hh
      obtain ⟨a, ha, u, hu, hau⟩ := mem_sup_of_normal_left.mp hxAU
      have haC : a ∈ centralizer (U : Set G) := by
        have huC : u ∈ centralizer (U : Set G) := by
          intro v hv
          exact setLike_mul_comm hv hu
        have hh := (centralizer (U : Set G)).mul_mem hx ((centralizer (U : Set G)).inv_mem huC)
        rw [← hau] at hh
        simpa only [mul_inv_cancel_right] using hh
      have haU : a ∈ U := (hfixed ▸ (show a ∈ A ⊓ centralizer (U : Set G) from ⟨ha, haC⟩)).2
      exact hau ▸ U.mul_mem haU hu
    · intro u hu v hv
      exact setLike_mul_comm hv hu
  let action : N →* MulAut U := U.normalizerMonoidHom
  have haker : action.ker = U.subgroupOf N := by
    rw [normalizerMonoidHom_ker, hcentral]
  have hakercard : Nat.card action.ker = 8 := by
    rw [haker, Nat.card_congr (subgroupOfEquivOfLe U.le_normalizer).toEquiv, hUcard]
  have hactioncard : Nat.card action.range = 24 := by
    have hh := action.ker.card_mul_index
    rw [hakercard, index_ker, hNcard] at hh
    omega
  let I := A.subgroupOf U
  have hI : Nat.card I = 4 := by
    rw [← card_map_of_injective U.subtype_injective, subgroupOf_map_subtype]
    exact hIcard
  have hstable : ∀ a : action.range, ∀ x : U, (a : MulAut U) x ∈ I ↔ x ∈ I := by
    rintro ⟨a, n, rfl⟩ x
    change (n : G) * (x : G) * (n : G)⁻¹ ∈ A ↔ (x : G) ∈ A
    have hnorm : (n : G) ∈ normalizer (A : Set G) := by rw [normalizer_eq_top]; trivial
    exact (mem_normalizer_iff.mp hnorm (x : G)).symm
  obtain ⟨model⟩ := elementaryEight_plane_order24_equiv_S4 hUcard I hI action.range hactioncard hstable
  refine ⟨hcentral, model.toMonoidHom.comp action.rangeRestrict,
    model.surjective.comp action.rangeRestrict_surjective, ?_⟩
  ext x
  change model (action.rangeRestrict x) = 1 ↔ x ∈ U.subgroupOf N
  rw [← haker, MonoidHom.mem_ker, ← model.map_one, model.injective.eq_iff]
  exact Subtype.ext_iff

end Subgroup
