module

public import Theory.GroupTheory.BinaryWeakCoreCentralizerTransportReduction
public import Theory.GroupTheory.BinaryWeakCoreSolvableCentralizer
public import Theory.GroupTheory.BinaryWeakCoreLocalStructure

/-!
# Solvable envelopes in isolated binary centralizer fusion

Write `D = C_S(Q)`. A solvable subgroup `L` of `C_G(Q)` containing `D`
preserves the component of an elementary eight in `Q D`, even if the full
centralizer is nonsolvable. Indeed `Q L` is solvable, is generated by `Q`
and its internal centralizer, and the latter inherits elementary rank one
from the unique involution in `C_G(Q)`. Apply the solvable centralizer-product
transport theorem inside `Q L` and map the path to the ambient group.

In particular, a failed transport by `c` forces `D ⊔ zpowers c` to be
nonsolvable. This sharpens the remaining fusion problem; it does not claim
that arbitrary odd cyclic subgroups are normalized by `D`.

The final obstruction theorem makes this reduction explicit. Failed transport
forces a nonsolvable generated envelope and failure of local normalization;
in the isolated case it also supplies the semidihedral presentation of `Q`
and the generalized quaternion presentation of `D`. The remaining ambient
fusion argument must exclude this configuration in a finite simple group.

Already one isolated four-group identifies an involution central in `S`
whose centralizer contains `C_G(Q)`. Thus solvability of involution
centralizers suffices for transport of every centralizer element. Conversely,
failed transport in a simple group gives a proper nonsolvable involution
centralizer containing `S`. This obstruction does not require the
semidihedral classification, absence of normal four-groups, or a restriction
on the order of the transporting element.

Source: the binary fusion remark following GLS2, Proposition 22.4
(`refs/KGroup/GLS2/ChapterF.tex`), with the solvable product argument in
`BinaryWeakCoreSolvableCentralizer`.
-/

namespace Subgroup

/-- A solvable subgroup of the rank-one ambient centralizer containing the
local centralizer preserves the weak-rank commuting component. -/
public theorem elementaryCommutingConnected_conj_of_solvable_centralizer_envelope
    {G : Type*} [Group G] [Finite G] (S A Q B L : Subgroup G)
    (hS : IsPGroup 2 S)
    [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 B]
    (hA : 8 ≤ Nat.card A) (hB : 8 ≤ Nat.card B)
    (hAS : A ≤ S) (hQS : Q ≤ S)
    (hBQC : B ≤ Q ⊔ (S ⊓ centralizer (Q : Set G)))
    (hLC : L ≤ centralizer (Q : Set G))
    (hDL : S ⊓ centralizer (Q : Set G) ≤ L)
    (hsolv : Group.IsSolvable L)
    (hunique : ∃! t : centralizer (Q : Set G), orderOf t = 2)
    (c : G) (hc : c ∈ L) :
    ElementaryCommutingConnected 2 A (A.map (MulAut.conj c).toMonoidHom) := by
  let C := centralizer (Q : Set G)
  let H := Q ⊔ L
  let : Group.IsSolvable L := hsolv
  have hrank : ∀ F : Subgroup G, F ≤ C → IsElementaryAbelian 2 F →
      Nat.card F < 4 := by
    intro F hFC hF
    let := hF
    let : IsElementaryAbelian 2 (F.subgroupOf C) := IsElementaryAbelian.subgroupOf hFC
    have hcard := card_elementary_le_two_of_unique_involution hunique (F.subgroupOf C)
    rw [Nat.card_congr (subgroupOfEquivOfLe hFC).toEquiv] at hcard
    omega
  have hQ : IsPGroup 2 Q := hS.to_le hQS
  have hQH : Q ≤ H := le_sup_left
  have hLH : L ≤ H := le_sup_right
  let QH := Q.subgroupOf H
  have hcentralizer : centralizer (QH : Set H) = C.subgroupOf H := by
    ext x
    constructor
    · intro hx q hq
      exact congrArg Subtype.val (hx ⟨q, hQH hq⟩ hq)
    · intro hx q hq
      exact Subtype.ext (hx (q : G) hq)
  have hLHcent : L.subgroupOf H ≤ centralizer (QH : Set H) := by
    rw [hcentralizer]
    exact fun _ hx => hLC hx
  have hQL : QH ⊔ L.subgroupOf H = ⊤ := by
    rw [← subgroupOf_sup hQH hLH]
    exact subgroupOf_self H
  have hgen : QH ⊔ centralizer (QH : Set H) = ⊤ :=
    top_unique (hQL ▸ sup_le_sup_left hLHcent QH)
  have hQHtwo : IsPGroup 2 QH :=
    hQ.of_equiv (subgroupOfEquivOfLe hQH).symm
  let : QH.Normal := normal_of_centralizing_sup_eq_top QH _ hgen le_rfl
  let : Group.IsNilpotent QH := hQHtwo.isNilpotent
  let : Group.IsSolvable (L.subgroupOf H) :=
    Group.isSolvable_of_isSolvable_injective
      (f := (subgroupOfEquivOfLe hLH).toMonoidHom) (subgroupOfEquivOfLe hLH).injective
  let : Group.IsSolvable H := Group.isSolvable_of_normal_sup_eq_top QH _ hQL
  have hCrank : ∀ F : Subgroup (centralizer (QH : Set H)),
      IsElementaryAbelian 2 F → Nat.card F < 4 := by
    intro F hF
    let := hF
    let f : centralizer (QH : Set H) →* G :=
      H.subtype.comp (centralizer (QH : Set H)).subtype
    have hf : Function.Injective f :=
      H.subtype_injective.comp (centralizer (QH : Set H)).subtype_injective
    have hFC : F.map f ≤ C := by
      rintro x ⟨y, _, rfl⟩
      exact hcentralizer.le y.property
    have hh := hrank (F.map f) hFC (IsElementaryAbelian.map f)
    rwa [card_map_of_injective hf] at hh
  have hBH : B ≤ H := hBQC.trans (sup_le_sup_left hDL Q)
  let BH := B.subgroupOf H
  let : IsElementaryAbelian 2 BH := IsElementaryAbelian.subgroupOf hBH
  have hBHcard : 8 ≤ Nat.card BH := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hBH).toEquiv]
    exact hB
  let cH : H := ⟨c, hLH hc⟩
  have hpath := (elementaryCommutingConnected_conj_of_rank_one_centralizer_product
    QH BH hQHtwo hgen hCrank hBHcard cH).map_injective H.subtype H.subtype_injective
  have hBmap : BH.map H.subtype = B := map_subgroupOf_eq_of_le hBH
  have hconj : (BH.map (MulAut.conj cH).toMonoidHom).map H.subtype =
      B.map (MulAut.conj c).toMonoidHom := by
    have hhom : H.subtype.comp (MulAut.conj cH).toMonoidHom =
        (MulAut.conj c).toMonoidHom.comp H.subtype := by
      ext x
      rfl
    rw [map_map, hhom, ← map_map, hBmap]
  rw [hBmap, hconj] at hpath
  have hBS : B ≤ S := hBQC.trans (sup_le hQS inf_le_left)
  have hAB := elementaryCommutingConnected_of_le_twoGroup S A B hS hA hB hAS hBS
  exact hAB.trans (hpath.trans (hAB.symm.map (MulAut.conj c)))

/-- It is enough that the particular centralizer element and the local
centralizer generate a solvable subgroup; the ambient centralizer need not
be solvable. -/
public theorem elementaryCommutingConnected_conj_of_solvable_generated_centralizer
    {G : Type*} [Group G] [Finite G] (S A Q B : Subgroup G)
    (hS : IsPGroup 2 S)
    [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 B]
    (hA : 8 ≤ Nat.card A) (hB : 8 ≤ Nat.card B)
    (hAS : A ≤ S) (hQS : Q ≤ S)
    (hBweak : B ≤ Q ⊔ (S ⊓ centralizer (Q : Set G)))
    (hunique : ∃! t : centralizer (Q : Set G), orderOf t = 2)
    (c : G) (hc : c ∈ centralizer (Q : Set G))
    (hsolv : Group.IsSolvable
      ((S ⊓ centralizer (Q : Set G)) ⊔ zpowers c : Subgroup G)) :
    ElementaryCommutingConnected 2 A (A.map (MulAut.conj c).toMonoidHom) := by
  exact elementaryCommutingConnected_conj_of_solvable_centralizer_envelope
    S A Q B _ hS hA hB hAS hQS hBweak
    (sup_le inf_le_right (zpowers_le.mpr hc)) le_sup_left hsolv hunique c
    ((le_sup_right : zpowers c ≤
      (S ⊓ centralizer (Q : Set G)) ⊔ zpowers c) (mem_zpowers c))

/-- The explicit local configuration left by a failure of isolated binary
centralizer transport. This reduction requires neither simplicity nor a
restriction on the order of the transporting element. -/
public theorem isolated_centralizer_fusion_obstruction
    {G : Type*} [Group G] [Finite G] (S A Q B E : Subgroup G)
    (hS : IsPGroup 2 S)
    [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 B]
    [IsElementaryAbelian 2 E]
    (hA : 8 ≤ Nat.card A) (hB : 8 ≤ Nat.card B) (hE : Nat.card E = 4)
    (hAS : A ≤ S) (hQS : Q ≤ S) (hEQ : E ≤ Q)
    (hBweak : B ≤ Q ⊔ (S ⊓ centralizer (Q : Set G)))
    (hno : ¬ ∃ F : Subgroup G, IsElementaryAbelian 2 F ∧ Nat.card F = 4 ∧
      F ≤ Q ∧ Q ≤ normalizer (F : Set G))
    (hiso : ∀ V : Subgroup G, IsElementaryAbelian 2 V → Nat.card V = 4 →
      V ≤ Q → ∀ W : Subgroup G, IsElementaryAbelian 2 W → Nat.card W = 4 →
      W ≤ S → W ≤ centralizer (V : Set G) → W = V)
    (hunique : ∃! t : centralizer (Q : Set G), orderOf t = 2)
    (c : G) (hc : c ∈ centralizer (Q : Set G))
    (hfail : ¬ ElementaryCommutingConnected 2 A
      (A.map (MulAut.conj c).toMonoidHom)) :
    (¬ Group.IsSolvable ((S ⊓ centralizer (Q : Set G)) ⊔ zpowers c : Subgroup G)) ∧
    c ∉ normalizer ((S ⊓ centralizer (Q : Set G) : Subgroup G) : Set G) ∧
    (∃ n : ℕ, 4 ≤ n ∧ Nat.card Q = 2 ^ n ∧
      ∃ a b : Q, orderOf a = 2 ^ (n - 1) ∧ orderOf b = 2 ∧
        b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1) ∧
        closure ({a, b} : Set Q) = ⊤) ∧
    (∃ n : ℕ, 3 ≤ n ∧ Nonempty
      ((S ⊓ centralizer (Q : Set G) : Subgroup G) ≃* QuaternionGroup (2 ^ (n - 2)))) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact fun hsolv => hfail
      (elementaryCommutingConnected_conj_of_solvable_generated_centralizer
        S A Q B hS hA hB hAS hQS hBweak hunique c hc hsolv)
  · exact fun hn => hfail
      (elementaryCommutingConnected_conj_of_normalizes_local_centralizer
        S A Q B hS hA hB hAS hQS hBweak c hc hn)
  · exact exists_semidihedral_of_isolated_four_of_weak_rank S Q B E hS hB hE
      hQS hEQ hBweak (hiso E inferInstance hE hEQ) hunique hno
  · exact exists_quaternion_centralizer_of_unique_involution S Q hS hunique
      (not_isCyclic_centralizer_of_isolated_fours_of_weak_rank
        S Q B hB hQS hBweak hiso)

/-- Solvable involution centralizers suffice for isolated centralizer transport.
Only the specified four-group needs to be isolated, and the transporting
element can have arbitrary order. -/
public theorem elementaryCommutingConnected_conj_of_isolated_of_solvable_involution_centralizers
    {G : Type*} [Group G] [Finite G] (S A Q B E : Subgroup G)
    (hS : IsPGroup 2 S)
    [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 B]
    [IsElementaryAbelian 2 E]
    (hA : 8 ≤ Nat.card A) (hB : 8 ≤ Nat.card B) (hE : Nat.card E = 4)
    (hAS : A ≤ S) (hQS : Q ≤ S) (hEQ : E ≤ Q)
    (hBweak : B ≤ Q ⊔ (S ⊓ centralizer (Q : Set G)))
    (hiso : ∀ W : Subgroup G, IsElementaryAbelian 2 W → Nat.card W = 4 →
      W ≤ S → W ≤ centralizer (E : Set G) → W = E)
    (hunique : ∃! t : centralizer (Q : Set G), orderOf t = 2)
    (hlocal : ∀ z : G, orderOf z = 2 →
      Group.IsSolvable (centralizer ({z} : Set G)))
    (c : G) (hc : c ∈ centralizer (Q : Set G)) :
    ElementaryCommutingConnected 2 A (A.map (MulAut.conj c).toMonoidHom) := by
  obtain ⟨z, hz, -, -, -, hCz⟩ :=
    central_involution_of_isolated_four_of_unique_centralizer
      S A Q E hS hA hE hAS hQS hEQ hiso hunique
  let := hlocal z hz
  have hsolv : Group.IsSolvable (centralizer (Q : Set G)) :=
    Group.isSolvable_of_isSolvable_injective (inclusion_injective hCz)
  exact elementaryCommutingConnected_conj_of_solvable_centralizer_unique_involution
    S A Q B hS hA hB hAS hQS hBweak hsolv hunique c hc

/-- Failed isolated transport in a simple group forces a proper nonsolvable
involution centralizer containing the entire selected two-group. In particular,
the obstruction is present before using a semidihedral presentation. -/
public theorem exists_nonsolvable_involution_centralizer_of_failed_isolated_transport
    {G : Type*} [Group G] [Finite G] [IsSimpleGroup G]
    (S A Q B E : Subgroup G) (hS : IsPGroup 2 S)
    [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 B]
    [IsElementaryAbelian 2 E]
    (hA : 8 ≤ Nat.card A) (hB : 8 ≤ Nat.card B) (hE : Nat.card E = 4)
    (hAS : A ≤ S) (hQS : Q ≤ S) (hEQ : E ≤ Q)
    (hBweak : B ≤ Q ⊔ (S ⊓ centralizer (Q : Set G)))
    (hiso : ∀ W : Subgroup G, IsElementaryAbelian 2 W → Nat.card W = 4 →
      W ≤ S → W ≤ centralizer (E : Set G) → W = E)
    (hunique : ∃! t : centralizer (Q : Set G), orderOf t = 2)
    (c : G) (hc : c ∈ centralizer (Q : Set G))
    (hfail : ¬ ElementaryCommutingConnected 2 A
      (A.map (MulAut.conj c).toMonoidHom)) :
    ∃ z : G, orderOf z = 2 ∧ z ∈ E ∧ z ∈ Q ∧
      S ≤ centralizer ({z} : Set G) ∧
      centralizer (Q : Set G) ≤ centralizer ({z} : Set G) ∧
      centralizer ({z} : Set G) ≠ ⊤ ∧
      ¬ Group.IsSolvable (centralizer ({z} : Set G)) := by
  obtain ⟨z, hz, hzE, hzQ, hzS, hCz⟩ :=
    central_involution_of_isolated_four_of_unique_centralizer
      S A Q E hS hA hE hAS hQS hEQ hiso hunique
  have hnsolv : ¬ Group.IsSolvable (centralizer ({z} : Set G)) := by
    intro hs
    let := hs
    have hsolv : Group.IsSolvable (centralizer (Q : Set G)) :=
      Group.isSolvable_of_isSolvable_injective (inclusion_injective hCz)
    exact hfail (elementaryCommutingConnected_conj_of_solvable_centralizer_unique_involution
      S A Q B hS hA hB hAS hQS hBweak hsolv hunique c hc)
  refine ⟨z, hz, hzE, hzQ, ?_, hCz, ?_, hnsolv⟩
  · intro s hs
    exact mem_centralizer_singleton_iff.mpr (hzS s hs)
  · intro htop
    have hzZ : z ∈ center G := mem_center_iff.mpr fun g =>
      mem_centralizer_singleton_iff.mp (htop ▸ mem_top g)
    have hZ : center G = ⊤ :=
      (inferInstance : (center G).Normal).eq_bot_or_eq_top.resolve_left (by
        intro hbot
        have hz1 : z = 1 := mem_bot.mp (hbot ▸ hzZ)
        simp [hz1] at hz)
    let : Group.IsSolvable G := Group.isSolvable_of_comm fun x y =>
      mem_center_iff.mp (hZ ▸ mem_top y) x
    exact hnsolv (Group.isSolvable_of_isSolvable_injective
      (centralizer ({z} : Set G)).subtype_injective)

end Subgroup
