module

public import Theory.GroupTheory.PCoreQuotientJoinAction
public import Theory.GroupTheory.SylowNormalIntersection
public import Theory.GroupTheory.QuasithinBasic

/-!
# Generating covers from invariant local pairs

Suppose a finite model has a generating pair of subgroups, invariant under
automorphisms preserving a fixed Sylow two-subgroup. Assume their intrinsic
two-core quotients are centerless and have automorphism two-rank at most two.
Then every finite group generated by a normal copy of the model and a Sylow
two-subgroup has a generating cover by Sylow overgroups with two-core quotient
rank at most two.

Intersect the supplied Sylow with the normal copy, then use Sylow conjugacy
to align the model marking. Invariance makes the transported subgroups normal
in their joins with the ambient Sylow. The actual quotient action identifies
each join modulo its two-core with a subgroup of the local quotient's
automorphism group. Mapping the model generation equality proves coverage.

This is the extension step for the HS local family in Aschbacher–Smith,
E.1.14(5), printed p.214. The concrete family and all model hypotheses are
supplied by `HS.LocalGeneration` and its Chapter E consumer.
-/

public section
open Subgroup Theory.GroupTheory
namespace Theory.GroupTheory

private theorem center_eq_bot_of_equiv {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) (hc : center B = ⊥) : center A = ⊥ := by
  apply eq_bot_iff.mpr
  intro x hx
  apply mem_bot.mpr
  apply e.injective
  rw [map_one]
  apply mem_bot.mp
  rw [← hc]
  apply mem_center_iff.mpr
  intro y
  obtain ⟨z, rfl⟩ := e.surjective y
  simpa only [map_mul] using congrArg e (mem_center_iff.mp hx z)

private noncomputable def coreQuotientEquiv {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) : (A ⧸ pCore 2 A) ≃* (B ⧸ pCore 2 B) :=
  QuotientGroup.congr _ _ e (pCore_map_iso 2 e)

variable {G M : Type*} [Group G] [Finite G] [Group M] [Finite M]

/-- Transport a genuinely invariant generating pair through a normal embedding,
then adjoin the supplied Sylow subgroup and bound the literal two-core quotients. -/
theorem exists_rankTwo_cover_of_invariant_pair (L : Subgroup G) [L.Normal] (T : Sylow 2 G)
    (e : L ≃* M) (hLT : L ⊔ (T : Subgroup G) = ⊤)
    (S : Sylow 2 M) (P : Fin 2 → Subgroup M)
    (hgen : P 0 ⊔ P 1 = ⊤)
    (hinv : ∀ i (β : MulAut M), (S : Subgroup M).map β.toMonoidHom = S →
      (P i).map β.toMonoidHom = P i)
    (hcenter : ∀ i, center (P i ⧸ pCore 2 (P i)) = ⊥)
    (hrank : ∀ i, primeRank 2 (MulAut (P i ⧸ pCore 2 (P i))) ≤ 2) :
    ∃ Δ : Set (Subgroup G), sSup Δ = ⊤ ∧
      ∀ H ∈ Δ, (T : Subgroup G) ≤ H ∧ primeRank 2 (H ⧸ pCore 2 H) ≤ 2 := by
  classical
  obtain ⟨R, hR⟩ := T.exists_subgroupOf_eq_of_normal L
  let S' := S.mapSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq L S' R
  let f : M ≃* L := e.symm.trans (MulAut.conj g)
  have hf : (S : Subgroup M).map f.toMonoidHom = (R : Subgroup L) := by
    have hh := congrArg Sylow.toSubgroup hg
    change ((S : Subgroup M).map e.symm.toMonoidHom).map (MulAut.conj g).toMonoidHom = R at hh
    have he : f.toMonoidHom = (MulAut.conj g).toMonoidHom.comp e.symm.toMonoidHom := rfl
    rw [he, ← Subgroup.map_map]
    exact hh
  let ι : M →* G := L.subtype.comp f.toMonoidHom
  have hι : Function.Injective ι := L.subtype_injective.comp f.injective
  let K : Fin 2 → Subgroup G := fun i => (P i).map ι
  have hK : ∀ i, (T : Subgroup G) ≤ normalizer (K i : Set G) := by
    intro i t ht
    let α : MulAut L := MulAut.conjNormal t
    let β : MulAut M := MulAut.congr f.symm α
    have hα : (R : Subgroup L).map α.toMonoidHom = R := by
      rw [hR]
      apply Subgroup.eq_of_le_of_card_ge
      · rintro x ⟨y, hy, rfl⟩
        change t * (y : G) * t⁻¹ ∈ (T : Subgroup G)
        exact (T : Subgroup G).mul_mem ((T : Subgroup G).mul_mem ht hy)
          ((T : Subgroup G).inv_mem ht)
      · exact le_of_eq (Nat.card_congr (α.subgroupMap _).toEquiv)
    have hβ : (S : Subgroup M).map β.toMonoidHom = S := by
      apply map_injective (f := f.toMonoidHom) f.injective
      rw [Subgroup.map_map]
      have he : f.toMonoidHom.comp β.toMonoidHom = α.toMonoidHom.comp f.toMonoidHom := by
        apply MonoidHom.ext
        intro x
        change f (f.symm (α (f x))) = α (f x)
        exact f.apply_symm_apply _
      rw [he, ← Subgroup.map_map, hf, hα]
    apply mem_normalizer_iff_map_conj_eq.mpr
    change ((P i).map ι).map (MulAut.conj t).toMonoidHom = (P i).map ι
    rw [Subgroup.map_map]
    have he : (MulAut.conj t).toMonoidHom.comp ι = ι.comp β.toMonoidHom := by
      ext x
      exact congrArg Subtype.val (f.apply_symm_apply (α (f x))).symm
    rw [he, ← Subgroup.map_map, hinv i β hβ]
  have hq (i : Fin 2) : (K i ⧸ pCore 2 (K i)) ≃* (P i ⧸ pCore 2 (P i)) :=
    coreQuotientEquiv (Subgroup.equivMapOfInjective (P i) ι hι).symm
  have hc (i : Fin 2) : center (K i ⧸ pCore 2 (K i)) = ⊥ :=
    center_eq_bot_of_equiv (hq i) (hcenter i)
  have hr (i : Fin 2) : primeRank 2 (MulAut (K i ⧸ pCore 2 (K i))) ≤ 2 := by
    rw [primeRank_equiv 2 (MulAut.congr (hq i))]
    exact hrank i
  let H : Fin 2 → Subgroup G := fun i => K i ⊔ (T : Subgroup G)
  have hrH (i : Fin 2) : primeRank 2 (H i ⧸ pCore 2 (H i)) ≤ 2 := by
    let q := pCoreJoinQuotientEquivRange 2 (hK i) T.isPGroup' (hc i)
    exact (primeRank_equiv 2 q).le.trans
      ((Theory.GroupTheory.primeRank_le_of_injective 2 _
        (pCoreJoinAction 2 (hK i)).range.subtype_injective).trans (hr i))
  have hKgen : K 0 ⊔ K 1 = L := by
    change (P 0).map ι ⊔ (P 1).map ι = L
    rw [← Subgroup.map_sup, hgen]
    change (⊤ : Subgroup M).map (L.subtype.comp f.toMonoidHom) = L
    rw [← Subgroup.map_map, Subgroup.map_top_of_surjective _ f.surjective,
      ← MonoidHom.range_eq_map, range_subtype]
  refine ⟨{H 0, H 1}, ?_, ?_⟩
  · rw [sSup_pair]
    change (K 0 ⊔ (T : Subgroup G)) ⊔ (K 1 ⊔ (T : Subgroup G)) = ⊤
    rw [sup_sup_sup_comm, sup_idem, hKgen, hLT]
  · intro Q hQ
    rcases Set.mem_insert_iff.mp hQ with rfl | hQ
    · exact ⟨le_sup_right, hrH 0⟩
    · have he : Q = H 1 := Set.mem_singleton_iff.mp hQ
      subst Q
      exact ⟨le_sup_right, hrH 1⟩

end Theory.GroupTheory
