module
public import Theory.GroupTheory.SylowFixedNormalClosureSplitting
public import Theory.GroupTheory.ConjugateSpanOrder
public import Theory.GroupTheory.SylowNormalRestriction

/-!
# Splitting a Sylow-fixed span for a normal actor

Let U be elementary abelian and generated by the conjugates of a seed fixed
by a Sylow two-subgroup P. For a normal subgroup N, the intersection P ∩ N
is Sylow in N. Odd-index averaging makes each seed element central modulo
[U,N]. Both [U,N] and C_U(N) are normal in the ambient group, so their
product contains the full seed span. Thus U = [U,N] C_U(N).

The original Chapter 13 point-span consumer applies this to the preimage
of the normal offender subgroup and excludes the B.5 hyperplane alternative.
Source: the Sylow averaging argument of Aschbacher--Smith B.2.14, printed
p.78, used in 13.2.12, p.882.
-/

public section
open Subgroup
open scoped IsMulCommutative commutatorElement
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

/-- A Sylow-fixed seed spanning an elementary normal subgroup has a central
supplement for every normal actor, with its relative centralizer retained. -/
theorem conjugateSpan_split_normal_actor (P : Sylow 2 G) (Z U N : Subgroup G)
    [U.Normal] [N.Normal] [IsElementaryAbelian 2 U]
    (hgen : conjugateSpanBy Z ⊤ = U) (hZP : Z ≤ centralizer (P : Set G)) :
    U = ⁅U,N⁆ ⊔ (U ⊓ centralizer (N : Set G)) := by
  let V := ⁅U,N⁆
  have hVU : V ≤ U := commutator_le_left U N
  let : IsElementaryAbelian 2 V := IsElementaryAbelian.of_le hVU
  have hZU : Z ≤ U := (le_conjugateSpanBy Z ⊤).trans_eq hgen
  obtain ⟨R,hR⟩ := P.exists_sylow_map_eq_inf_of_normal N
  apply le_antisymm ?_ (sup_le hVU inf_le_left)
  apply hgen.ge.trans
  apply conjugateSpanBy_le ?_ le_normalizer_of_normal
  intro z hz
  obtain ⟨v,hv,hc⟩ := fixed_coset_of_sylow N V le_normalizer_of_normal
    (fun v hv => elemPow_eq_one_of_isElementaryAbelian v hv) R z
    (fun a ha => by
      change ⁅a,z⁆ ∈ ⁅U,N⁆
      rw [commutator_comm]
      exact commutator_mem_commutator ha (hZU hz))
    (fun a ha => hZP hz a ((hR ▸ mem_map_of_mem N.subtype ha).1))
  have hh : v⁻¹ * (v*z) ∈ V ⊔ (U ⊓ centralizer (N : Set G)) :=
    mul_mem_sup (V.inv_mem hv) ⟨U.mul_mem (hVU hv) (hZU hz),hc⟩
  simpa only [inv_mul_cancel_left] using hh
end Theory.GroupTheory

