module

public import Theory.GroupTheory.Commutator.NormalizedIndexTwo
public import Mathlib.GroupTheory.PGroup
public import Mathlib.Tactic

/-!
# Abelian bases determined by noninvolutions

An abelian subgroup containing a noninvolution is generated by its
noninvolutions: multiply an involution by one fixed noninvolution. If every
noninvolution of a normal overgroup lies in this base, the base is consequently
normal in the ambient group.

For a normal section `R/B` of order two in a finite two-group `V/B`, suppose
that no element of `R ∖ B` is a square in `V` and an ambient group is transitive
on the nonidentity cosets of `R` in `V`. Cauchy's theorem supplies a coset of
order two in `V/R`. Its lifts square into `B` by nonsquareness. The section
`R/B` is central of exponent two, so transitivity makes every square in `V`
lie in `B`. Thus `V/B` is abelian.

These are the algebraic steps in GLS, Volume 4, Chapter 2, Lemma 15.7,
`refs/KGroup/GLS4/Chapter2.tex`. They do not prove the local involution profile,
fusion, nonsquareness or transitivity used by that source argument.
-/

namespace Subgroup

/-- The noninvolution profile makes the abelian base normal. -/
public theorem normal_of_noninvolution_profile
    {H : Type*} [Group H] (R B : Subgroup H) [R.Normal]
    (hBR : B ≤ R) (hcomm : ∀ x ∈ B, ∀ y ∈ B, Commute x y)
    (hnon : ∃ b ∈ B, b ^ 2 ≠ 1)
    (hout : ∀ x ∈ R, x ∉ B → x ^ 2 = 1) : B.Normal := by
  let S : Set H := {x | x ∈ R ∧ x ^ 2 ≠ 1}
  have hSB : closure S ≤ B := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    by_contra hn
    exact hx.2 (hout x hx.1 hn)
  have hBS : B ≤ closure S := by
    obtain ⟨b, hb, hb2⟩ := hnon
    intro x hx
    by_cases hx2 : x ^ 2 = 1
    · have hxb : x * b ∈ closure S := by
        apply Subgroup.subset_closure
        refine ⟨R.mul_mem (hBR hx) (hBR hb), ?_⟩
        rw [(hcomm x hx b hb).mul_pow, hx2, one_mul]
        exact hb2
      have hbS : b ∈ closure S := Subgroup.subset_closure ⟨hBR hb, hb2⟩
      simpa using (closure S).mul_mem hxb ((closure S).inv_mem hbS)
    · exact Subgroup.subset_closure ⟨hBR hx, hx2⟩
  rw [le_antisymm hBS hSB]
  apply normalizer_eq_top_iff.mp
  apply top_le_iff.mp
  apply le_normalizer_closure_iff.mpr
  intro g _ x hx
  apply Subgroup.subset_closure
  refine ⟨(inferInstance : R.Normal).conj_mem x hx.1 g, ?_⟩
  intro he
  have he' : (MulAut.conj g) (x ^ 2) = (MulAut.conj g) 1 := by
    simpa only [map_pow, map_one, MulAut.conj_apply] using he
  exact hx.2 ((MulAut.conj g).injective he')

/-- A normal subgroup containing every square contains the commutator subgroup. -/
public theorem commutator_le_of_squares
    {H : Type*} [Group H] (V B : Subgroup H) [B.Normal]
    (hsq : ∀ v ∈ V, v ^ 2 ∈ B) : ⁅V,V⁆ ≤ B := by
  let q := QuotientGroup.mk' B
  have hs : ∀ v ∈ V, (q v)⁻¹ = q v := by
    intro v hv
    apply inv_eq_of_mul_eq_one_left
    rw [← pow_two, ← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (hsq v hv)
  apply commutator_le.mpr
  intro x hx y hy
  apply (QuotientGroup.eq_one_iff _).mp
  have hc : q x * q y = q y * q x := by
    have hi := hs (x * y) (V.mul_mem hx hy)
    simpa only [map_mul, mul_inv_rev, hs x hx, hs y hy] using hi.symm
  change q (x * y * x⁻¹ * y⁻¹) = 1
  simp only [map_mul, map_inv]
  rw [hc]
  group

private theorem exists_square_in_normal_of_two_group
    {H : Type*} [Group H] [Finite H] (V R : Subgroup H) [R.Normal]
    (hP : IsPGroup 2 V) (hRV : R < V) :
    ∃ v ∈ V, v ∉ R ∧ v ^ 2 ∈ R := by
  let Rv := R.subgroupOf V
  have hRt : Rv ≠ ⊤ := by
    intro ht
    apply (not_le_of_gt hRV)
    intro x hx
    have hm : (⟨x, hx⟩ : V) ∈ Rv := ht ▸ mem_top _
    exact hm
  let : Nontrivial (V ⧸ Rv) := QuotientGroup.nontrivial_iff.mpr hRt
  have hQ := hP.to_quotient Rv
  obtain ⟨m, hm⟩ := hQ.exists_card_eq
  have hm0 : m ≠ 0 := by
    intro h0
    have hc : 1 < Nat.card (V ⧸ Rv) := Finite.one_lt_card
    simp [hm, h0] at hc
  have hdiv : 2 ∣ Nat.card (V ⧸ Rv) := hm ▸ dvd_pow_self 2 hm0
  obtain ⟨a, ha⟩ := exists_prime_orderOf_dvd_card' (G := V ⧸ Rv) 2 hdiv
  obtain ⟨v, rfl⟩ := QuotientGroup.mk'_surjective Rv a
  refine ⟨v, v.property, ?_, ?_⟩
  · intro hv
    have he : QuotientGroup.mk' Rv v = 1 := (QuotientGroup.eq_one_iff _).mpr hv
    simp [he] at ha
  · have he : (QuotientGroup.mk' Rv v) ^ 2 = 1 := ha ▸ pow_orderOf_eq_one _
    have hh : v ^ 2 ∈ Rv := (QuotientGroup.eq_one_iff _).mp (by
      change (QuotientGroup.mk' Rv) (v ^ 2) = 1
      rw [map_pow]
      exact he)
    exact hh

/-- Transitivity above a central section of order two and nonsquareness
inside that section force an exponent-two quotient. -/
public theorem squares_le_of_transitive_cosets_of_no_squares
    {H : Type*} [Group H] [Finite H] (V R B K : Subgroup H)
    [R.Normal] [B.Normal] (hP : IsPGroup 2 V) (hRV : R < V)
    (hBR : B ≤ R) (hi : B.relIndex R = 2)
    (hno : ∀ v ∈ V, v ^ 2 ∈ R → v ^ 2 ∈ B)
    (htrans : ∀ v ∈ V, v ∉ R → ∀ w ∈ V, w ∉ R →
      ∃ k ∈ K, ∃ a ∈ R, w = k * v * k⁻¹ * a) :
    ∀ v ∈ V, v ^ 2 ∈ B := by
  obtain ⟨v, hv, hvR, hv2⟩ := exists_square_in_normal_of_two_group V R hP hRV
  have hvB := hno v hv hv2
  have hRsq : ∀ a ∈ R, a ^ 2 ∈ B := by
    intro a ha
    exact (B.subgroupOf R).sq_mem_of_index_two hi ⟨a, ha⟩
  have hcomm : ⁅R, (⊤ : Subgroup H)⁆ ≤ B :=
    commutator_le_of_normalized_index_two R B ⊤ hBR hi
      le_normalizer_of_normal le_normalizer_of_normal
  let q := QuotientGroup.mk' B
  intro w hw
  by_cases hwR : w ∈ R
  · exact hRsq w hwR
  obtain ⟨k, _, a, ha, rfl⟩ := htrans v hv hvR w hw hwR
  have hca : Commute (q (k * v * k⁻¹)) (q a) := by
    apply Commute.symm
    apply commutatorElement_eq_one_iff_commute.mp
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr
      (hcomm (commutator_mem_commutator ha (mem_top _)))
  apply (QuotientGroup.eq_one_iff _).mp
  change q ((k * v * k⁻¹ * a) ^ 2) = 1
  rw [map_pow, map_mul, hca.mul_pow]
  have hvq : q (k * v * k⁻¹) ^ 2 = 1 := by
    have hh : (k * v * k⁻¹) ^ 2 ∈ B := by
      have hh := (inferInstance : B.Normal).conj_mem (v ^ 2) hvB k
      simpa only [← MulAut.conj_apply, ← map_pow] using hh
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr hh
  rw [hvq, one_mul, ← map_pow]
  exact (QuotientGroup.eq_one_iff _).mpr (hRsq a ha)

end Subgroup
