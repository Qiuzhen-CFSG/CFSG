module

public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Simultaneous placement through an odd-index inner centralizer

Suppose G is generated by a normal subgroup N and an element a. If the
centralizer of a in N has odd index, then a two-subgroup A containing a
and centralized by a can be conjugated as a whole into any specified Sylow
two-subgroup, with a becoming Sylow-central. The conjugator lies in N.

This retains the whole elementary subgroup in the quadratic field fusion
step of Aschbacher--Smith 6.1.4, printed p.666. The index is taken in the
actual normal subgroup; no conjugacy-class selection is assumed.
-/

public section
open Subgroup
namespace Theory.GroupTheory

/-- Odd inner centralizer index places a whole commuting two-subgroup and
makes its marked element central in the supplied Sylow, by an inner conjugator. -/
theorem odd_centralizer_whole_subgroup_placement
    {G : Type*} [Group G] [Finite G]
    (N : Subgroup G) [N.Normal] (a : G) (hgen : N ⊔ zpowers a = ⊤)
    (hi : Odd ((centralizer ({a} : Set G)).subgroupOf N).index)
    (A : Subgroup G) (hA : IsPGroup 2 A) (haA : a ∈ A)
    (hAC : A ≤ centralizer ({a} : Set G)) (T : Sylow 2 G) :
    ∃ g ∈ N, A.map (MulAut.conj g).toMonoidHom ≤ (T : Subgroup G) ∧
      g * a * g⁻¹ ∈ centralizer (T : Set G) := by
  classical
  let C := centralizer ({a} : Set G)
  have hZC : zpowers a ≤ C := zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl)
  have hNC : N ⊔ C = ⊤ := top_unique (hgen ▸ sup_le_sup_left hZC N)
  have hNCindex : N.relIndex C = N.index := by
    rw [← relIndex_sup_left, hNC, relIndex_top_right]
  have hCi : C.index = C.relIndex N := by
    have h₁ := relIndex_mul_index (show C ⊓ N ≤ N from inf_le_right)
    have h₂ := relIndex_mul_index (show C ⊓ N ≤ C from inf_le_left)
    rw [inf_relIndex_right] at h₁
    rw [inf_relIndex_left, hNCindex] at h₂
    exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero N.index_ne_zero_of_finite) (by
      calc
        N.index * C.index = (C ⊓ N).index := h₂
        _ = N.index * C.relIndex N := by rw [← h₁, mul_comm])
  have hCo : Odd C.index := hCi ▸ hi
  have hAp : IsPGroup 2 (A.subgroupOf C) := hA.comap_subtype
  obtain ⟨P, hAP⟩ := hAp.exists_le_sylow
  let U := (P : Subgroup C).map C.subtype
  have hUi : ¬ 2 ∣ U.index := by
    rw [index_map_subtype]
    exact Nat.Prime.not_dvd_mul Nat.prime_two P.not_dvd_index hCo.not_two_dvd_nat
  let R : Sylow 2 G := (P.isPGroup'.map C.subtype).toSylow hUi
  have hAR : A ≤ (R : Subgroup G) := by
    intro x hx
    exact mem_map.mpr ⟨⟨x, hAC hx⟩, hAP hx, rfl⟩
  have hRC : (R : Subgroup G) ≤ C := map_subtype_le _
  obtain ⟨b, hb⟩ := MulAction.exists_smul_eq G R T
  have hmap : (R : Subgroup G).map (MulAut.conj b).toMonoidHom = (T : Subgroup G) :=
    congrArg Sylow.toSubgroup hb
  have hbA : A.map (MulAut.conj b).toMonoidHom ≤ (T : Subgroup G) :=
    (map_mono hAR).trans hmap.le
  have hba : b * a * b⁻¹ ∈ centralizer (T : Set G) := by
    intro t ht
    change t ∈ (T : Subgroup G) at ht
    rw [← hmap] at ht
    obtain ⟨r, hr, rfl⟩ := ht
    change MulAut.conj b r * MulAut.conj b a = MulAut.conj b a * MulAut.conj b r
    simpa only [map_mul] using congrArg (MulAut.conj b)
      (mem_centralizer_singleton_iff.mp (hRC hr))
  obtain ⟨g, hg, c, hc, rfl⟩ := mem_sup_of_normal_left.mp (hgen ▸ mem_top b)
  have hZA : zpowers a ≤ centralizer (A : Set G) := by
    apply zpowers_le.mpr
    intro x hx
    exact mem_centralizer_singleton_iff.mp (hAC hx)
  have he (x : G) (hx : x ∈ A) :
      (g * c) * x * (g * c)⁻¹ = g * x * g⁻¹ := by
    have hcX : c * x * c⁻¹ = x := mul_inv_eq_iff_eq_mul.mpr ((hZA hc) x hx).symm
    calc
      _ = g * (c * x * c⁻¹) * g⁻¹ := by group
      _ = g * x * g⁻¹ := by rw [hcX]
  refine ⟨g, hg, ?_, ?_⟩
  · rintro _ ⟨x, hx, rfl⟩
    have hh := hbA (mem_map_of_mem (MulAut.conj (g * c)).toMonoidHom hx)
    change (g * c) * x * (g * c)⁻¹ ∈ (T : Subgroup G) at hh
    rwa [he x hx] at hh
  · rwa [he a haA] at hba

end Theory.GroupTheory
