module
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Noncentral action in an intersection of normalizing subgroups

Let B and I be normal subgroups, and let B normalize R. If E lies in the
normal closure of R, B is generated by [B,E] and its centralizer of I,
and B acts nontrivially on I, then R intersect B acts nontrivially on I.
No finite-group or prime-group hypotheses are required.

Modulo C_B(I), trivial action of the intersection makes R centralize the
image of B. The latter centralizer is normal, so it contains the image of
E as well. The commutator supplement would then make all of B centralize
I, a contradiction.

This is the normal-generation transfer used with Stellmacher (7.6)(b)
immediately before (9.10)(10), printed p.58. Its graph and residual-core
specialization belongs to the Section Nine consumer.
-/

namespace Subgroup

public theorem commutator_intersection_ne_bot_of_normalClosure_supplement
    {G : Type*} [Group G]
    (B R I E : Subgroup G) [B.Normal] [I.Normal]
    (hBR : B ≤ normalizer (R : Set G))
    (hE : E ≤ normalClosure (R : Set G))
    (hgen : B = ⁅B,E⁆ ⊔ (B ⊓ centralizer (I : Set G)))
    (hB : ¬ B ≤ centralizer (I : Set G)) :
    ⁅R ⊓ B,I⁆ ≠ ⊥ := by
  intro hcomm
  let C := B ⊓ centralizer (I : Set G)
  let q := QuotientGroup.mk' C
  have hintersection : R ⊓ B ≤ centralizer (I : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp hcomm
  have hBRle : ⁅B,R⁆ ≤ C := by
    have hRle : ⁅B,R⁆ ≤ R :=
      le_normalizer_iff_commutator_le_right.mp hBR
    have hBle : ⁅B,R⁆ ≤ B := commutator_le_left B R
    exact le_inf hBle ((le_inf hRle hBle).trans hintersection)
  have hbar : ⁅B.map q,R.map q⁆ = ⊥ := by
    rw [← map_commutator]
    exact (map_eq_bot_iff _).mpr (by simpa only [q, QuotientGroup.ker_mk'] using hBRle)
  have hRbar : R.map q ≤ centralizer (B.map q : Set (G ⧸ C)) :=
    le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hbar)
  have hEbar : E.map q ≤ centralizer (B.map q : Set (G ⧸ C)) := by
    apply map_le_iff_le_comap.mpr
    exact hE.trans (normalClosure_le_normal (map_le_iff_le_comap.mp hRbar))
  have hBE : ⁅B,E⁆ ≤ C := by
    have hzero : (⁅B,E⁆).map q = ⊥ := by
      rw [map_commutator]
      exact commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hEbar)
    simpa only [q, QuotientGroup.ker_mk'] using (map_eq_bot_iff _).mp hzero
  apply hB
  rw [hgen]
  exact sup_le (hBE.trans inf_le_right) inf_le_right

end Subgroup
