module

public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Escaping a subgroup by conjugation

Suppose `U ≤ R` is nontrivial, `K` normalizes `R`, and `[L,Q] ≤ U`.
If `L` and `K` normalize no common nontrivial subgroup of `R`, some
`K`-conjugate of `U` escapes `Q`.

Indeed, the subgroup generated by all these conjugates is normalized by `K`.
If it lies in `Q`, the commutator bound makes it normalized by `L` as well.
This is the normal-closure argument in Aschbacher–Smith, *The Classification
of Quasithin Groups*, combined manuscript (1 March 2004), Lemma C.6.3(1),
printed p. 166.
-/

namespace Subgroup

/-- A commutator bound and the absence of a common invariant subgroup force
one of the conjugates of `U` to leave `Q`. Conjugation here is `u ↦ x*u*x⁻¹`. -/
public theorem exists_conjugate_not_le_of_no_common_normal
    {G : Type*} [Group G] (U R Q L K : Subgroup G)
    (hU : U ≠ ⊥) (hUR : U ≤ R) (hKR : K ≤ normalizer (R : Set G))
    (hLQ : ⁅L, Q⁆ ≤ U)
    (hno : ∀ W : Subgroup G, W ≠ ⊥ → W ≤ R →
      L ≤ normalizer (W : Set G) → ¬ K ≤ normalizer (W : Set G)) :
    ∃ x ∈ K, ¬ U.map (MulAut.conj x) ≤ Q := by
  classical
  by_contra! hall
  let S : Set G := {y | ∃ x ∈ K, ∃ u ∈ U, x * u * x⁻¹ = y}
  let W : Subgroup G := closure S
  have hUW : U ≤ W := by
    intro u hu
    apply subset_closure
    exact ⟨1, K.one_mem, u, hu, by simp⟩
  have hWR : W ≤ R := by
    apply (R.closure_le).mpr
    rintro y ⟨x, hx, u, hu, rfl⟩
    exact le_normalizer_iff.mp hKR x hx u (hUR hu)
  have hWQ : W ≤ Q := by
    apply (Q.closure_le).mpr
    rintro y ⟨x, hx, u, hu, rfl⟩
    exact hall x hx (mem_map.mpr ⟨u, hu, rfl⟩)
  have hKW : K ≤ normalizer (W : Set G) := by
    apply le_normalizer_closure_iff.mpr
    rintro k hk y ⟨x, hx, u, hu, rfl⟩
    apply subset_closure
    exact ⟨k * x, K.mul_mem hk hx, u, hu, by simp [mul_assoc]⟩
  have hLW : L ≤ normalizer (W : Set G) := by
    apply le_normalizer_iff_commutator_le_right.mpr
    exact (commutator_mono le_rfl hWQ).trans (hLQ.trans hUW)
  have hW : W ≠ ⊥ := fun hw => hU (eq_bot_iff.mpr (hw ▸ hUW))
  exact hno W hW hWR hLW hKW

end Subgroup
