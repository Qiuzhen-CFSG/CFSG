module
public import Theory.GroupTheory.NormalClosureCentralizerCover

/-!
# Commutators of a normal closure under a normal supplement

If V is normally generated by Z, Z centralizes S, and a normal subgroup E
supplements S, the full ambient commutator [V,G] equals [V,E]. No finiteness
or Sylow hypotheses are needed.

Modulo the normal subgroup [V,E], the image of Z centralizes both the image
of E and the image of S, so it is central. Its normal closure, the image
of V, is therefore central. The quotient kernel gives the required reverse
containment of commutators.

This standard normal-closure reduction supplies the fixed-summand argument
in Stellmacher (6.4), Journal of Algebra 190 (1997), p.32, following the
barred residual-product equality on p.31. Source:
`refs/latex/stellmacher-n-group.tex`.
-/

namespace Subgroup

public theorem commutator_normalClosure_eq_of_normal_supplement
    {G : Type*} [Group G] (Z V E S : Subgroup G) [V.Normal] [E.Normal]
    (hZV : Z ≤ V) (hV : V = normalClosure (Z : Set G))
    (hZS : Z ≤ centralizer (S : Set G)) (hES : E ⊔ S = ⊤) :
    ⁅V, (⊤ : Subgroup G)⁆ = ⁅V, E⁆ := by
  let U := ⁅V, E⁆
  let q := QuotientGroup.mk' U
  have hVE : ⁅V.map q, E.map q⁆ = ⊥ := by
    rw [← map_commutator]
    exact (map_eq_bot_iff U).mpr (by rw [QuotientGroup.ker_mk'])
  have hZSbar : Z.map q ≤ centralizer (S.map q : Set (G ⧸ U)) :=
    (map_mono hZS).trans (map_centralizer_le_centralizer_image (S : Set G) q)
  have hZcentral : Z.map q ≤ center (G ⧸ U) := by
    apply centralizer_eq_top_iff_subset.mp
    apply top_unique
    have hgen : E.map q ⊔ S.map q = ⊤ := by
      rw [← map_sup, hES, map_top_of_surjective q (QuotientGroup.mk'_surjective U)]
    rw [← hgen]
    refine sup_le ?_ (le_centralizer_iff.mp hZSbar)
    exact (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hVE)).trans
      (centralizer_le (map_mono hZV))
  have hVcentral : V.map q ≤ center (G ⧸ U) := by
    apply map_le_iff_le_comap.mpr
    exact hV.le.trans (normalClosure_le_normal (map_le_iff_le_comap.mp hZcentral))
  have hkill : (⁅V, (⊤ : Subgroup G)⁆).map q = ⊥ := by
    rw [map_commutator, map_top_of_surjective q (QuotientGroup.mk'_surjective U)]
    exact commutator_top_right_eq_bot_iff_le_center.mpr hVcentral
  apply le_antisymm ?_ (commutator_mono le_rfl le_top)
  simpa only [q, QuotientGroup.ker_mk'] using (map_eq_bot_iff _).mp hkill

end Subgroup
