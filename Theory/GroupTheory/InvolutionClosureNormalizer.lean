module
public import Mathlib.GroupTheory.Sylow

/-!
# Normalizers of involution-generated intersections

If involutions of R are strongly closed inside T, the normalizer of any
Q ≤ T preserves R ∩ Q whenever that intersection is generated by its
involutions. Conjugation preserves both the order and the ambient class.

This is the normalizer step in Aschbacher–Smith 2.4.23(4), printed p.537.
-/
public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G]

theorem normalizer_le_normalizer_inf_of_involution_closure
    (R Q T : Subgroup G) (hQT : Q ≤ T)
    (hclosed : ∀ r t : G, orderOf r = 2 → r ∈ R → r ∈ T → t ∈ T →
      IsConj r t → t ∈ R)
    (hgen : closure {r : G | r ∈ R ⊓ Q ∧ orderOf r = 2} = R ⊓ Q) :
    normalizer (Q : Set G) ≤ normalizer (R ⊓ Q : Set G) := by
  intro g hg
  change g ∈ normalizer ((R ⊓ Q : Subgroup G) : Set G)
  rw [←hgen]
  apply normalizer_le_normalizer_closure
  intro r
  have ho : orderOf (g*r*g⁻¹) = orderOf r := (MulAut.conj g).orderOf_eq r
  have hc : IsConj r (g*r*g⁻¹) := isConj_iff.mpr ⟨g,rfl⟩
  constructor
  · intro hr
    have hq : g*r*g⁻¹ ∈ Q := (hg r).mp hr.1.2
    exact ⟨⟨hclosed r (g*r*g⁻¹) hr.2 hr.1.1 (hQT hr.1.2) (hQT hq) hc,hq⟩,ho.trans hr.2⟩
  · intro hr
    have hq : r ∈ Q := (hg r).mpr hr.1.2
    exact ⟨⟨hclosed (g*r*g⁻¹) r hr.2 hr.1.1 (hQT hr.1.2) (hQT hq) hc.symm,hq⟩,ho.symm.trans hr.2⟩
end Subgroup
