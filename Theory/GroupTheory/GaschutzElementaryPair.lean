module
public import Theory.GroupTheory.Gaschutz
public import Theory.ElementaryAbelian.VectorSpace
/-!
# Splitting an elementary Sylow pair

A group generated by a normal subgroup and an elementary abelian subgroup
splits over the normal subgroup: choose a vector-space complement to their
intersection in the elementary factor. Gaschütz then promotes such a
splitting inside a Sylow subgroup to a splitting of the whole group.
Source: Aschbacher–Smith, Lemma 2.4.8(4), printed p.530; A.1.39.
-/
public section
open scoped IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G]
theorem exists_complement_of_sup_elementary {p : ℕ} [Fact p.Prime]
    (V A : Subgroup G) [V.Normal] [IsElementaryAbelian p A]
    (hgen : V ⊔ A = ⊤) : ∃ K : Subgroup G, V.IsComplement' K := by
  obtain ⟨C,hC⟩ := IsElementaryAbelian.exists_isCompl p A (V.subgroupOf A)
  let K := C.map A.subtype
  have hdis : Disjoint V K := by
    apply disjoint_def.mpr
    rintro x hx ⟨y,hy,rfl⟩
    exact congrArg Subtype.val (disjoint_def.mp hC.disjoint hx hy)
  have hAK : A ≤ V ⊔ K := by
    have he := congrArg (Subgroup.map A.subtype) hC.sup_eq_top
    rw [Subgroup.map_sup, subgroupOf_map_subtype, ←MonoidHom.range_eq_map, range_subtype] at he
    rw [←he]
    exact sup_le (inf_le_left.trans le_sup_left) le_sup_right
  have hsup : V ⊔ K = ⊤ := top_unique (hgen ▸ sup_le le_sup_left hAK)
  refine ⟨K,isComplement'_of_disjoint_and_mul_eq_univ hdis ?_⟩
  rw [←coe_mul_of_right_le_normalizer_left _ _ le_normalizer_of_normal,hsup]
  rfl

/-- The actual Sylow factorization by an elementary supplement splits the group. -/
theorem exists_complement_of_sylow_elementary [Finite G] {p : ℕ} [Fact p.Prime]
    (V : Subgroup G) [V.Normal] [IsMulCommutative V] (hV : IsPGroup p V)
    (P : Sylow p G) (A : Subgroup G) [IsElementaryAbelian p A]
    (hgen : V ⊔ A = (P : Subgroup G)) : ∃ K : Subgroup G, V.IsComplement' K := by
  apply (exists_complement_iff_sylow V hV P).mpr
  let : IsElementaryAbelian p (A.subgroupOf (P : Subgroup G)) := IsElementaryAbelian.subgroupOf (le_sup_right.trans_eq hgen)
  apply exists_complement_of_sup_elementary (p := p) (V.subgroupOf (P : Subgroup G))
    (A.subgroupOf (P : Subgroup G))
  apply map_injective (P : Subgroup G).subtype_injective
  rw [Subgroup.map_sup, map_subgroupOf_eq_of_le (le_sup_left.trans_eq hgen),
    map_subgroupOf_eq_of_le (le_sup_right.trans_eq hgen), hgen,
    ←MonoidHom.range_eq_map, range_subtype]
end Subgroup
