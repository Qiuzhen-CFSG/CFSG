module

public import BenderSuzuki.External.Huppert.IV.theorem_6_2
public import FeitThompson.BGsection6.Defs
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Sylow normalization and centralizers of the two Thompson subgroups

The subgroups generated by abelian subgroups of maximum order, or maximum
generator rank, are normalized by the containing group. Both contain their
centralizer inside a finite prime group. For the rank version, enlarging a
maximal-rank abelian subgroup by a commuting element preserves maximal rank;
the enlarged subgroup is another defining generator.

Generator-rank monotonicity here is used only between abelian prime groups,
where it follows by counting their first omega subgroups. No generator-rank
bound for an arbitrary prime group is asserted.
-/

public noncomputable section
open Subgroup BenderSuzuki.External
open scoped IsMulCommutative
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

private def maximalAbelianBy (S : Subgroup G) (μ : Subgroup G → ℕ) : Set (Subgroup G) :=
  {A | A ≤ S ∧ IsMulCommutative A ∧
    ∀ B : Subgroup G, B ≤ S → IsMulCommutative B → μ B ≤ μ A}

private theorem maximalAbelianBy_nonempty (S : Subgroup G) (μ : Subgroup G → ℕ) :
    (maximalAbelianBy S μ).Nonempty := by
  let C : Set (Subgroup G) := {A | A ≤ S ∧ IsMulCommutative A}
  obtain ⟨A,hA,hm⟩ := (Set.toFinite C).exists_maximalFor (f := μ) C
    (show C.Nonempty from ⟨⊥,bot_le,inferInstance⟩)
  exact ⟨A,hA.1,hA.2,fun B hB hc => le_of_not_gt (fun h =>
    (not_le_of_gt h) (hm ⟨hB,hc⟩ h.le))⟩

private theorem centralizer_maximalAbelianBy_le (S : Subgroup G) (μ : Subgroup G → ℕ)
    (hmono : ∀ A B : Subgroup G, A ≤ B → B ≤ S →
      IsMulCommutative A → IsMulCommutative B → μ A ≤ μ B) :
    S ⊓ centralizer ((sSup (maximalAbelianBy S μ) : Subgroup G) : Set G) ≤ sSup (maximalAbelianBy S μ) := by
  obtain ⟨A,hA⟩ := maximalAbelianBy_nonempty S μ
  intro x hx
  let B := closure ((A : Set G) ∪ {x})
  have hAB : A ≤ B := fun a ha => subset_closure (Or.inl ha)
  have hBS : B ≤ S := (closure_le _).mpr (by
    rintro a (ha | rfl)
    · exact hA.1 ha
    · exact hx.1)
  have hcomm : IsMulCommutative B := by
    let : IsMulCommutative A := hA.2.1
    apply isMulCommutative_closure
    rintro a (ha | rfl) b (hb | rfl)
    · exact setLike_mul_comm (s := A) ha hb
    · exact hx.2 a (le_sSup hA ha)
    · exact (hx.2 b (le_sSup hA hb)).symm
    · rfl
  have hB : B ∈ maximalAbelianBy S μ :=
    ⟨hBS,hcomm,fun C hC hc => (hA.2.2 C hC hc).trans (hmono A B hAB hBS hA.2.1 hcomm)⟩
  exact le_sSup hB (subset_closure (Or.inr rfl))

omit [Finite G] in
private theorem normalizes_maximalAbelianBy (S : Subgroup G) (μ : Subgroup G → ℕ)
    (hinv : ∀ (e : G ≃* G) (A : Subgroup G), μ (A.map e.toMonoidHom) = μ A) :
    S ≤ normalizer ((sSup (maximalAbelianBy S μ) : Subgroup G) : Set G) := by
  apply le_normalizer_iff.mpr
  intro g hg x hx
  let e : G ≃* G := MulAut.conj g
  have hES : S.map e.toMonoidHom = S := mem_normalizer_iff_map_conj_eq.mp (S.le_normalizer hg)
  have hEIS : S.map e.symm.toMonoidHom = S := by
    have hh := congrArg (Subgroup.map e.symm.toMonoidHom) hES
    have he : e.symm.toMonoidHom.comp e.toMonoidHom = MonoidHom.id G := by
      ext a
      exact e.symm_apply_apply a
    simpa only [map_map,he,map_id] using hh.symm
  have hmap : (sSup (maximalAbelianBy S μ)).map e.toMonoidHom ≤ sSup (maximalAbelianBy S μ) := by
    rw [map_le_iff_le_comap]
    apply sSup_le
    intro A hA
    let : IsMulCommutative A := hA.2.1
    rw [←map_le_iff_le_comap]
    apply le_sSup
    refine ⟨?_,Subgroup.map_isMulCommutative A e.toMonoidHom,?_⟩
    · exact (map_mono hA.1).trans_eq hES
    · intro B hB hc
      let : IsMulCommutative B := hc
      have hh := hA.2.2 (B.map e.symm.toMonoidHom)
        ((map_mono hB).trans_eq hEIS) (Subgroup.map_isMulCommutative _ _)
      simpa only [hinv] using hh
  exact hmap (mem_map_of_mem e.toMonoidHom hx)

private theorem generatorRank_mono_abelian_prime {p : ℕ} [Fact p.Prime]
    (S : Subgroup G) (hS : IsPGroup p S) (A B : Subgroup G)
    (hAB : A ≤ B) (hBS : B ≤ S) (hA : IsMulCommutative A) (hB : IsMulCommutative B) :
    generatorRank A ≤ generatorRank B := by
  let : IsMulCommutative A := hA
  let : IsMulCommutative B := hB
  let : Fact (IsPGroup p A) := ⟨hS.to_le (hAB.trans hBS)⟩
  let : Fact (IsPGroup p B) := ⟨hS.to_le hBS⟩
  let OA := (omega₁ A (p := p)).map A.subtype
  let OB := (omega₁ B (p := p)).map B.subtype
  have hle : OA ≤ OB := by
    rw [map_le_iff_le_comap]
    apply (closure_le _).mpr
    intro x hx
    let y : B := ⟨x,hAB x.property⟩
    have hy : y ∈ omega₁ B (p := p) := subset_closure (by
      apply Subtype.ext
      exact congrArg (fun z : A => (z : G)) hx)
    exact mem_map_of_mem B.subtype hy
  have hh := card_le_of_le hle
  dsimp only [OA,OB] at hh
  rw [card_map_of_injective A.subtype_injective,card_map_of_injective B.subtype_injective,
    omega₁_card_eq_pow_generatorRank_of_commutative_pgroup,
    omega₁_card_eq_pow_generatorRank_of_commutative_pgroup] at hh
  exact (Nat.pow_le_pow_iff_right (Fact.out : p.Prime).one_lt).mp hh

/-- The order Thompson subgroup contains its centralizer inside S. -/
theorem inf_centralizer_thompsonSubgroup_le (S : Subgroup G) :
    S ⊓ centralizer (thompsonSubgroup S : Set G) ≤ thompsonSubgroup S := by
  exact centralizer_maximalAbelianBy_le S (fun A => Nat.card A)
    (fun A B hAB _ _ _ => card_le_of_le hAB)

/-- The rank Thompson subgroup contains its centralizer inside a prime group. -/
theorem inf_centralizer_rankThompsonSubgroup_le {p : ℕ} [Fact p.Prime]
    (S : Subgroup G) (hS : IsPGroup p S) :
    S ⊓ centralizer (huppertRankThompsonSubgroup S : Set G) ≤ huppertRankThompsonSubgroup S := by
  exact centralizer_maximalAbelianBy_le S (fun A => generatorRank A)
    (generatorRank_mono_abelian_prime S hS)

omit [Finite G] in
/-- S normalizes its order Thompson subgroup. -/
theorem le_normalizer_thompsonSubgroup (S : Subgroup G) :
    S ≤ normalizer (thompsonSubgroup S : Set G) := by
  exact normalizes_maximalAbelianBy S (fun A => Nat.card A)
    (fun e A => card_map_of_injective e.injective)

/-- S normalizes its rank Thompson subgroup. -/
theorem le_normalizer_rankThompsonSubgroup (S : Subgroup G) :
    S ≤ normalizer (huppertRankThompsonSubgroup S : Set G) := by
  apply normalizes_maximalAbelianBy S (fun A => generatorRank A)
  intro e A
  rw [generatorRank_eq_group_rank,generatorRank_eq_group_rank]
  exact (Group.rank_congr (A.equivMapOfInjective e.toMonoidHom e.injective)).symm

end Theory.GroupTheory
