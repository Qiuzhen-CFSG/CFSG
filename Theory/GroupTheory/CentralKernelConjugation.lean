module
public import Theory.GroupTheory.CentralPGroupHomRigidity
public import Mathlib.GroupTheory.GroupAction.ConjAct

/-!
# Conjugation comparison through central kernels

Let two homomorphisms have central kernels, with the second kernel a finite
p-group. Suppose an equivalence of subgroups preserves their projections,
and the normal source subgroup is generated by the first kernel and a
subgroup having no normal subgroup of index p. Elements with matching
projections then induce conjugation actions intertwined by that equivalence.

The two homomorphisms expressing these actions on the normal subgroup
have equal projections. On the specified generating subgroup, the proved
central-p-group discrepancy theorem makes them equal. On the first
kernel they agree by centrality in both ambient groups. Their equalizer
therefore contains the two generating subgroups, hence the whole domain.

This is the reusable action-comparison step in the central index-two model
comparison for ABG II.3 Proposition 3, article pages 26–27. It uses no
perfectness assumption and applies at characteristic parameter three.
-/

namespace MonoidHom

public theorem conjugation_eq_of_central_pgroup_kernel
    {G H Q : Type*} [Group G] [Group H] [Group Q] {p : ℕ} [Fact p.Prime]
    (f : G →* Q) (g : H →* Q) [Finite g.ker]
    (hfcentral : f.ker ≤ Subgroup.center G) (hgcentral : g.ker ≤ Subgroup.center H)
    (hgprime : IsPGroup p g.ker) (N : Subgroup G) (N' : Subgroup H) [N.Normal]
    (eN : N ≃* N') (heN : ∀ n : N, g (eN n) = f n)
    (L0 : Subgroup G) (hno : ∀ M : Subgroup L0, M.Normal → M.index ≠ p)
    (hjoin : f.ker ⊔ L0 = N) (a : G) (b : H) (hab : f a = g b) :
    ∀ n : N,
      (eN ⟨a * (n : G) * a⁻¹, (inferInstance : N.Normal).conj_mem n n.property a⟩ : H) =
        b * (eN n : H) * b⁻¹ := by
  let u : N →* H := N'.subtype.comp
    (eN.toMonoidHom.comp (MulAut.conjNormal a).toMonoidHom)
  let v : N →* H := (MulAut.conj b).toMonoidHom.comp (N'.subtype.comp eN.toMonoidHom)
  have hproject (n : N) : g (u n) = g (v n) := by
    change g (eN (MulAut.conjNormal a n)) = g (b * (eN n : H) * b⁻¹)
    rw [heN]
    simp only [MulAut.conjNormal_apply, map_mul, map_inv, heN, hab]
  have hkN : f.ker ≤ N := by rw [← hjoin]; exact le_sup_left
  have hLN : L0 ≤ N := by rw [← hjoin]; exact le_sup_right
  have hL : u.comp (Subgroup.inclusion hLN) = v.comp (Subgroup.inclusion hLN) := by
    apply eq_of_central_pgroup_discrepancy hno g.ker hgcentral hgprime
    intro x
    change g (u ⟨x, hLN x.property⟩ * (v ⟨x, hLN x.property⟩)⁻¹) = 1
    rw [map_mul, map_inv, hproject, mul_inv_cancel]
  have hk : f.ker.subgroupOf N ≤ u.eqLocus v := by
    intro n hn
    have hnker : (n : G) ∈ f.ker := hn
    have hconj : MulAut.conjNormal a n = n := by
      apply Subtype.ext
      change a * (n : G) * a⁻¹ = n
      rw [Subgroup.mem_center_iff.mp (hfcentral hnker) a, mul_inv_cancel_right]
    have hn' : (eN n : H) ∈ g.ker := by
      change g (eN n) = 1
      rw [heN]
      exact hn
    change (eN (MulAut.conjNormal a n) : H) = b * (eN n : H) * b⁻¹
    rw [hconj, Subgroup.mem_center_iff.mp (hgcentral hn') b, mul_inv_cancel_right]
  have hL' : L0.subgroupOf N ≤ u.eqLocus v := by
    intro n hn
    exact congrArg (fun w : L0 →* H => w ⟨n.val, hn⟩) hL
  have htop : (⊤ : Subgroup N) ≤ u.eqLocus v := by
    have hsup : f.ker.subgroupOf N ⊔ L0.subgroupOf N = ⊤ := by
      rw [← Subgroup.subgroupOf_sup hkN hLN, hjoin, Subgroup.subgroupOf_self]
    rw [← hsup]
    exact sup_le hk hL'
  intro n
  exact htop (Subgroup.mem_top n)

end MonoidHom
