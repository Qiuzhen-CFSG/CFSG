module
public import Theory.GroupTheory.CentralProductCenter
public import Theory.GroupTheory.SpecificGroups.QuaternionEightInvolution
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Algebra.Group.Subgroup.Finite
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.Tactic.Group

/-!
# The central product of a cyclic four-group and a quaternion eight-group

Let B and C be actual commuting subgroups isomorphic to C₄ and Q₈, with
intersection of order two. The center of their join, mapped into the ambient
group, is exactly B. Their join is also generated by its square-one elements.
The ambient group need not be finite and the join need not be the whole group.

The nonidentity intersection element is the unique involution of each factor,
so it identifies the square of a cyclic generator r with the central quaternion
involution. The quaternion center therefore lies in B. Since B centralizes
the join, the general central-product center theorem computes its center.
For generation, choose quaternion generators i and j. Their squares and the
square of ij all equal the shared involution, making ri, rj, and r(ij)
involutions. Their products recover r, then i and j. The cyclic and quaternion
normal forms recover both factors and hence the entire join. Small finite
calculations use the actual ZMod and QuaternionGroup models.

This is the elementary C₄ ◦ Q₈ geometry in Stellmacher, Journal of Algebra 190
(1997), (8.6)(a₂), printed p.41; see `refs/latex/stellmacher-n-group.tex`.
It supplies center and involution-generation properties for the small Sylow
recognition argument. The module uses only lower-layer group theory.
-/

namespace Subgroup

private abbrev C4 := Multiplicative (ZMod 4)
private abbrev Q8 := QuaternionGroup 2

private theorem c4_involution (x : C4) (hx : x ^ 2 = 1) (hne : x ≠ 1) :
    x = Multiplicative.ofAdd 2 := by
  have h : ∀ x : C4, x ^ 2 = 1 → x ≠ 1 → x = Multiplicative.ofAdd 2 := by decide
  exact h x hx hne

private theorem shared_square {G : Type*} [Group G] (B C : Subgroup G)
    (eB : B ≃* C4) (eC : C ≃* Q8)
    (hinter : Nat.card (B ⊓ C : Subgroup G) = 2) :
    ((eB.symm (Multiplicative.ofAdd 2) : B) : G) =
      ((eC.symm (QuaternionGroup.a 2) : C) : G) := by
  let : Finite (B ⊓ C : Subgroup G) := Nat.finite_of_card_ne_zero (by omega)
  obtain ⟨z, hz, _⟩ := (Nat.card_eq_two_iff' (1 : (B ⊓ C : Subgroup G))).mp hinter
  have hz2 : z ^ 2 = 1 := by
    simpa only [hinter] using pow_card_eq_one' (x := z)
  let zB : B := ⟨z, z.property.1⟩
  let zC : C := ⟨z, z.property.2⟩
  have hzB2 : zB ^ 2 = 1 := Subtype.ext (congrArg (fun y : (B ⊓ C : Subgroup G) => (y : G)) hz2)
  have hzC2 : zC ^ 2 = 1 := Subtype.ext (congrArg (fun y : (B ⊓ C : Subgroup G) => (y : G)) hz2)
  have hzB1 : zB ≠ 1 := fun h => hz (Subtype.ext (congrArg (fun y : B => (y : G)) h))
  have hzC1 : zC ≠ 1 := fun h => hz (Subtype.ext (congrArg (fun y : C => (y : G)) h))
  have heB : eB zB = Multiplicative.ofAdd 2 := c4_involution _
    (by simpa only [map_pow, map_one] using congrArg eB hzB2)
    (fun h => hzB1 (eB.injective (by simpa using h)))
  have heC : eC zC = QuaternionGroup.a 2 :=
    QuaternionGroup.eq_a_two_of_orderOf_eq_two _
      (by rw [eC.orderOf_eq]; exact orderOf_eq_prime hzC2 hzC1)
  have hb := congrArg (fun x => ((eB.symm x : B) : G)) heB
  have hc := congrArg (fun x => ((eC.symm x : C) : G)) heC
  simp only [eB.symm_apply_apply] at hb
  simp only [eC.symm_apply_apply] at hc
  exact hb.symm.trans hc

private theorem quaternion_center_cases (q : Q8) (hq : q ∈ center Q8) :
    q = 1 ∨ q = QuaternionGroup.a 2 := by
  have h : ∀ q : Q8, (∀ r : Q8, r * q = q * r) →
      q = 1 ∨ q = QuaternionGroup.a 2 := by decide
  exact h q (mem_center_iff.mp hq)

private theorem product_center {G : Type*} [Group G] (B C : Subgroup G)
    (eB : B ≃* C4) (eC : C ≃* Q8)
    (hshared : ((eB.symm (Multiplicative.ofAdd 2) : B) : G) =
      ((eC.symm (QuaternionGroup.a 2) : C) : G))
    (hcomm : ∀ b : G, b ∈ B → ∀ c : G, c ∈ C → b * c = c * b) :
    (center (B ⊔ C : Subgroup G)).map (B ⊔ C).subtype = B := by
  let J := B ⊔ C
  have hBcomm (b : G) (hb : b ∈ B) (b' : G) (hb' : b' ∈ B) : b * b' = b' * b := by
    have hh : (⟨b, hb⟩ : B) * ⟨b', hb'⟩ = ⟨b', hb'⟩ * ⟨b, hb⟩ := by
      apply eB.injective
      simpa only [map_mul] using mul_comm (eB ⟨b, hb⟩) (eB ⟨b', hb'⟩)
    exact congrArg Subtype.val hh
  have hJC : J ≤ centralizer (B : Set G) := by
    apply sup_le
    · intro b hb
      exact mem_centralizer_iff.mpr (fun b' hb' => hBcomm b' hb' b hb)
    · intro c hc
      exact mem_centralizer_iff.mpr (fun b hb => hcomm b hb c hc)
  have hBZ : B.subgroupOf J ≤ center J := by
    intro b hb
    apply mem_center_iff.mpr
    intro j
    apply Subtype.ext
    exact (mem_centralizer_iff.mp (hJC j.property) b hb).symm
  have hCZ : (center C).map C.subtype ≤ B := by
    rintro c ⟨c, hc, rfl⟩
    have hec : eC c ∈ center Q8 := (centerCongr eC ⟨c, hc⟩).property
    rcases quaternion_center_cases (eC c) hec with he | he
    · have hc1 : c = 1 := eC.injective (by simpa using he)
      simp [hc1]
    · have hc2 : c = eC.symm (QuaternionGroup.a 2) := by
        apply eC.injective
        simpa using he
      rw [hc2]
      change ((eC.symm (QuaternionGroup.a 2) : C) : G) ∈ B
      rw [← hshared]
      exact (eB.symm (Multiplicative.ofAdd 2)).property
  have hgen : B.subgroupOf J ⊔ C.subgroupOf J = ⊤ := by
    rw [← subgroupOf_sup (show B ≤ J from le_sup_left) (show C ≤ J from le_sup_right)]
    exact subgroupOf_self J
  have hCZ' : (center (C.subgroupOf J)).map (C.subgroupOf J).subtype ≤ B.subgroupOf J := by
    rintro c ⟨c, hc, rfl⟩
    let e := subgroupOfEquivOfLe (show C ≤ J from le_sup_right)
    exact hCZ ⟨e c, (centerCongr e ⟨c, hc⟩).property, rfl⟩
  have heq := center_eq_of_central_product (B.subgroupOf J) (C.subgroupOf J) hBZ hgen hCZ'
  rw [heq]
  exact map_subgroupOf_eq_of_le (show B ≤ J from le_sup_left)

private theorem product_involutions_generate {G : Type*} [Group G] (B C : Subgroup G)
    (eB : B ≃* C4) (eC : C ≃* Q8)
    (hshared : ((eB.symm (Multiplicative.ofAdd 2) : B) : G) =
      ((eC.symm (QuaternionGroup.a 2) : C) : G))
    (hcomm : ∀ b : G, b ∈ B → ∀ c : G, c ∈ C → b * c = c * b) :
    closure {x : G | x ∈ B ⊔ C ∧ x ^ 2 = 1} = B ⊔ C := by
  let f : C4 →* G := B.subtype.comp eB.symm.toMonoidHom
  let g : Q8 →* G := C.subtype.comp eC.symm.toMonoidHom
  let r := f (Multiplicative.ofAdd 1)
  let i := g (QuaternionGroup.a 1)
  let j := g (QuaternionGroup.xa 0)
  let z := g (QuaternionGroup.a 2)
  let T := closure {x : G | x ∈ B ⊔ C ∧ x ^ 2 = 1}
  have hrB : r ∈ B := (eB.symm (Multiplicative.ofAdd 1)).property
  have hiC : i ∈ C := (eC.symm (QuaternionGroup.a 1)).property
  have hjC : j ∈ C := (eC.symm (QuaternionGroup.xa 0)).property
  have hr2 : r ^ 2 = z := by
    change f (Multiplicative.ofAdd 1) ^ 2 = g (QuaternionGroup.a 2)
    rw [← map_pow, show (Multiplicative.ofAdd 1 : C4) ^ 2 = Multiplicative.ofAdd 2 by decide]
    exact hshared
  have hz2 : z ^ 2 = 1 := by
    change g (QuaternionGroup.a 2) ^ 2 = 1
    rw [← map_pow, show (QuaternionGroup.a 2 : Q8) ^ 2 = 1 by decide, map_one]
  have hi2 : i ^ 2 = z := by
    change g (QuaternionGroup.a 1) ^ 2 = g (QuaternionGroup.a 2)
    rw [← map_pow]
    rfl
  have hj2 : j ^ 2 = z := by
    change g (QuaternionGroup.xa 0) ^ 2 = g (QuaternionGroup.a 2)
    rw [← map_pow, show (QuaternionGroup.xa 0 : Q8) ^ 2 = QuaternionGroup.a 2 by decide]
  have hij2 : (i * j) ^ 2 = z := by
    change (g (QuaternionGroup.a 1) * g (QuaternionGroup.xa 0)) ^ 2 = g (QuaternionGroup.a 2)
    rw [← map_mul, ← map_pow]
    exact congrArg g (by decide)
  have hmixed (q : G) (hq : q ∈ C) (hq2 : q ^ 2 = z) : r * q ∈ T := by
    apply subset_closure
    refine ⟨(B ⊔ C).mul_mem (mem_sup_left hrB) (mem_sup_right hq), ?_⟩
    rw [(show Commute r q from hcomm r hrB q hq).mul_pow, hr2, hq2, ← pow_two, hz2]
  have hri : r * i ∈ T := hmixed i hiC hi2
  have hrj : r * j ∈ T := hmixed j hjC hj2
  have hrk : r * (i * j) ∈ T := hmixed (i * j) (C.mul_mem hiC hjC) hij2
  have hprod : (r * i) * (r * j) = r * (r * (i * j)) := by
    calc
      _ = r * (i * r) * j := by group
      _ = r * (r * i) * j := by rw [hcomm r hrB i hiC]
      _ = _ := by group
  have hrT : r ∈ T := by
    have hh := T.mul_mem (T.mul_mem hri hrj) (T.inv_mem hrk)
    rw [hprod] at hh
    simpa only [mul_inv_cancel_right] using hh
  have hiT : i ∈ T := (T.mul_mem_cancel_left hrT).mp hri
  have hjT : j ∈ T := (T.mul_mem_cancel_left hrT).mp hrj
  apply le_antisymm ((closure_le _).mpr (fun _ hx => hx.1))
  apply sup_le
  · intro b hb
    let bb : B := ⟨b, hb⟩
    have hb' : f (eB bb) = b := by simp [f, bb]
    rw [← hb']
    have hpower : ∀ x : C4, x = (Multiplicative.ofAdd 1) ^ x.toAdd.val := by decide
    rw [hpower (eB bb), map_pow]
    exact T.pow_mem hrT _
  · intro c hc
    let cc : C := ⟨c, hc⟩
    have hc' : g (eC cc) = c := by simp [g, cc]
    rw [← hc']
    cases eC cc with
    | a n =>
      have hn : (QuaternionGroup.a n : Q8) = QuaternionGroup.a 1 ^ n.val := by simp
      rw [hn, map_pow]
      exact T.pow_mem hiT _
    | xa n =>
      have hn : (QuaternionGroup.xa n : Q8) = QuaternionGroup.xa 0 * QuaternionGroup.a 1 ^ n.val := by simp
      rw [hn, map_mul, map_pow]
      exact T.mul_mem hjT (T.pow_mem hiT _)

/-- Commuting cyclic-four and quaternion-eight factors with intersection two
have the cyclic factor as center and generate their join by involutions. -/
public theorem cyclicFour_quaternion_product_geometry
    {G : Type*} [Group G] (B C : Subgroup G)
    (hB : Nonempty (B ≃* Multiplicative (ZMod 4)))
    (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hinter : Nat.card (B ⊓ C : Subgroup G) = 2)
    (hcomm : ∀ b : G, b ∈ B → ∀ c : G, c ∈ C → b * c = c * b) :
    (center (B ⊔ C : Subgroup G)).map (B ⊔ C).subtype = B ∧
      closure {x : G | x ∈ B ⊔ C ∧ x ^ 2 = 1} = B ⊔ C := by
  obtain ⟨eB⟩ := hB
  obtain ⟨eC⟩ := hC
  have hshared := shared_square B C eB eC hinter
  exact ⟨product_center B C eB eC hshared hcomm,
    product_involutions_generate B C eB eC hshared hcomm⟩

end Subgroup
