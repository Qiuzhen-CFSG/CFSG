module

public import Theory.GroupTheory.TwoCosetExtension
public import Mathlib.Data.List.OfFn

/-!
# Binary collection in a group

A sequence is triangular when each generator's square and its inverse
conjugates of later generators lie in the subgroup generated by the tail.
Inductively adjoining the two cosets of each tail shows that every element
of the generated subgroup is an ascending product with binary exponents.
No uniqueness, finiteness of the ambient group, or index equality is needed.

This iterates `Subgroup.twoCosetExtension`, the elementary collection step
for a polycyclic sequence with relative orders dividing two.
-/

@[expose] public section

set_option autoImplicit false
namespace Theory.GroupTheory.BinaryCollection
variable {G : Type*} [Group G]

/-- Each square and inverse conjugate collects into the later generators. -/
def triangular : List G → Prop
  | [] => True
  | a :: l => a * a ∈ Subgroup.closure {x | x ∈ l} ∧
      (∀ b ∈ l, a⁻¹ * b * a ∈ Subgroup.closure {x | x ∈ l}) ∧ triangular l

/-- Ascending binary product, with the first generator selected by bit zero. -/
def product : List G → ℕ → G
  | [], _ => 1
  | a :: l, n => a ^ (n % 2) * product l (n / 2)

/-- Triangular sequences cover their generated subgroup by binary products. -/
theorem cover (l : List G) (ht : triangular l) :
    ∀ x ∈ Subgroup.closure {x | x ∈ l}, ∃ n < 2 ^ l.length, product l n = x := by
  induction l with
  | nil =>
    intro x hx
    have hx1 : x = 1 := by simpa using hx
    exact ⟨0, by simp, hx1.symm⟩
  | cons a l ih =>
    obtain ⟨hs, hc, ht⟩ := ht
    let K := Subgroup.closure {x | x ∈ l}
    have hconj : ∀ x ∈ K, a⁻¹ * x * a ∈ K := by
      have hle : K ≤ K.comap (MulAut.conj a⁻¹).toMonoidHom := by
        apply (Subgroup.closure_le _).mpr
        intro x hx
        change a⁻¹ * x * (a⁻¹)⁻¹ ∈ K
        simpa only [inv_inv] using hc x hx
      intro x hx
      simpa only [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
        inv_inv] using hle hx
    let E := Subgroup.twoCosetExtension K a hs hconj
    have hle : Subgroup.closure {x | x ∈ a :: l} ≤ E := by
      apply (Subgroup.closure_le _).mpr
      intro x hx
      rcases List.mem_cons.mp hx with rfl | hx
      · exact Or.inr ⟨1, K.one_mem, (mul_one x).symm⟩
      · exact Or.inl (Subgroup.subset_closure hx)
    intro x hx
    rcases hle hx with hx | ⟨y, hy, rfl⟩
    · obtain ⟨n, hn, he⟩ := ih ht x hx
      refine ⟨2 * n, ?_, ?_⟩
      · simp only [List.length_cons, pow_succ]
        omega
      · simpa [product] using he
    · obtain ⟨n, hn, he⟩ := ih ht y hy
      refine ⟨2 * n + 1, ?_, ?_⟩
      · simp only [List.length_cons, pow_succ]
        omega
      · have hd : (2 * n + 1) / 2 = n := by omega
        simpa [product, hd] using congrArg (a * ·) he

/-- Recursive binary collection agrees with the usual indexed product. -/
theorem product_ofFn {m : ℕ} (g : Fin m → G) (n : ℕ) :
    product (List.ofFn g) n =
      (List.ofFn (fun i : Fin m => g i ^ (n / 2 ^ i.val % 2))).prod := by
  induction m generalizing n with
  | zero => simp [product]
  | succ m ih =>
    rw [List.ofFn_succ, product, ih, List.ofFn_succ, List.prod_cons]
    simp only [Fin.val_zero, pow_zero, Nat.div_one, Fin.val_succ]
    congr 1
    congr 1
    congr 1
    funext i
    rw [Nat.pow_succ, Nat.div_div_eq_div_mul, Nat.mul_comm 2]

/-- Indexed binary products cover the subgroup generated by a triangular sequence. -/
theorem cover_ofFn {m : ℕ} (g : Fin m → G) (ht : triangular (List.ofFn g)) :
    ∀ x ∈ Subgroup.closure (Set.range g), ∃ n : Fin (2 ^ m),
      (List.ofFn (fun i : Fin m => g i ^ (n.val / 2 ^ i.val % 2))).prod = x := by
  intro x hx
  obtain ⟨n, hn, he⟩ := cover (List.ofFn g) ht x (by
    simpa only [List.mem_ofFn', Set.ofPred_mem_eq] using hx)
  exact ⟨⟨n, by simpa using hn⟩, (product_ofFn g n).symm.trans he⟩

end Theory.GroupTheory.BinaryCollection

namespace Theory.GroupTheory.BinaryCollection
variable {G : Type*} [Group G] {I : Type*}
/-- Explicit words supported on the tail certify a triangular extension. -/
theorem triangular_cons_of_words (g : I → G) (a : I) (l sw : List I)
    (cw : I → List I)
    (hs : g a * g a = (sw.map g).prod)
    (hc : ∀ b ∈ l, (g a)⁻¹ * g b * g a = ((cw b).map g).prod)
    (hsupp : ∀ i ∈ sw, i ∈ l)
    (csupp : ∀ b ∈ l, ∀ i ∈ cw b, i ∈ l)
    (ht : triangular (l.map g)) : triangular ((a :: l).map g) := by
  have hm (w : List I) (hw : ∀ i ∈ w, i ∈ l) :
      (w.map g).prod ∈ Subgroup.closure {x | x ∈ l.map g} := by
    apply Subgroup.list_prod_mem
    intro x hx
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hx
    exact Subgroup.subset_closure (List.mem_map.mpr ⟨i, hw i hi, rfl⟩)
  refine ⟨?_, ?_, ht⟩
  · rw [hs]
    exact hm sw hsupp
  · intro x hx
    obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hx
    rw [hc b hb]
    exact hm (cw b) (csupp b hb)
end Theory.GroupTheory.BinaryCollection
