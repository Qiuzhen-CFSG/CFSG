module

public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.Algebra.Group.Pointwise.Set.Basic

/-!
# Normalizing a conjugate closure through permuting subgroups

If `H` normalizes `V` and `HL ⊆ LH`, then `H` normalizes the subgroup
generated by the `L`-conjugates of `V`. Indeed, write `hl = l'h'`; conjugation
by `h` then takes an `L`-conjugate of `V` into another such conjugate.

This is the group-theoretic step used twice in Aschbacher–Smith,
*The Classification of Quasithin Groups*, Lemma 14.3.8 (combined manuscript,
1 March 2004, printed p. 992). The explicit closure expression also matches
the conjugate-closure definitions used elsewhere in the project.
-/

open scoped Pointwise

namespace Subgroup

variable {G : Type*} [Group G]

/-- A normalizer of the seed normalizes its conjugate closure whenever the
normalizing subgroup can be moved past the conjugating subgroup. -/
public theorem le_normalizer_conjugate_closure_of_mul_subset
    (H L V : Subgroup G) (hV : H ≤ normalizer (V : Set G))
    (hperm : (H : Set G) * (L : Set G) ⊆ (L : Set G) * (H : Set G)) :
    H ≤ normalizer (closure {x : G | ∃ l : L, ∃ v : V,
      x = (l : G) * (v : G) * (l : G)⁻¹} : Set G) := by
  rw [le_normalizer_closure_iff]
  rintro h hh _ ⟨l, v, rfl⟩
  obtain ⟨l', hl', h', hh', heq⟩ := hperm (Set.mul_mem_mul hh l.property)
  have hv' : h' * (v : G) * h'⁻¹ ∈ V :=
    (mem_normalizer_iff.mp (hV hh') (v : G)).mp v.property
  apply subset_closure
  refine ⟨⟨l', hl'⟩, ⟨h' * (v : G) * h'⁻¹, hv'⟩, ?_⟩
  change h * ((l : G) * (v : G) * (l : G)⁻¹) * h⁻¹ =
    l' * (h' * (v : G) * h'⁻¹) * l'⁻¹
  calc
    _ = (h * l) * (v : G) * (h * l)⁻¹ := by simp [mul_assoc]
    _ = (l' * h') * (v : G) * (l' * h')⁻¹ := by rw [← heq]
    _ = _ := by simp [mul_assoc]

end Subgroup
