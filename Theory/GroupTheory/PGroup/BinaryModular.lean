module

public import Theory.GroupTheory.PGroup.CentralProductCore
public import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The modular alternative for a cyclic self-centralizer

The nonabelian modular two-group of order `2^(n+1)`, for `n ≥ 3`, has a
cyclic subgroup generated by `a` and an involution `b` acting on it by
`a ↦ a^(1 + 2^(n-1))`. We retain the generating presentation and exact order,
without choosing an external model.

The elementary central-product lemmas below identify the ambient centralizer
of the squares of a characteristic cyclic subgroup. This is the subgroup
`EM` in Gorenstein, *Finite Groups*, Section 5.4, Lemma 4.8 and the proof of
Theorem 4.9. Characteristicity is proved in the ambient group; it is not
inferred from characteristicity in a possibly noncharacteristic factor.
-/

open Subgroup

/-- The modular two-group presentation, with its exact order. The parameter
starts at three; the order-eight presentation belongs to the dihedral case. -/
@[expose] public def IsBinaryModularGroup (G : Type*) [Group G] : Prop :=
  ∃ n : ℕ, 3 ≤ n ∧ Nat.card G = 2 ^ (n + 1) ∧
    ∃ a b : G, orderOf a = 2 ^ n ∧ orderOf b = 2 ∧
      b * a * b⁻¹ = a ^ (1 + 2 ^ (n - 1)) ∧
      closure ({a, b} : Set G) = ⊤

/-- Changing the model of a modular group preserves its presentation. -/
public theorem IsBinaryModularGroup.of_mulEquiv
    {G K : Type*} [Group G] [Group K] (e : G ≃* K)
    (h : IsBinaryModularGroup G) : IsBinaryModularGroup K := by
  obtain ⟨n, hn, hcard, a, b, ha, hb, hrel, hgen⟩ := h
  refine ⟨n, hn, ?_, e a, e b, ?_, ?_, ?_, ?_⟩
  · rw [← Nat.card_congr e.toEquiv, hcard]
  · simpa using ha
  · simpa using hb
  · simpa using congrArg e hrel
  · have hm := congrArg (fun H : Subgroup G => H.map e.toMonoidHom) hgen
    simpa [MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton] using hm

namespace Subgroup

/-- Every power subgroup of a characteristic cyclic subgroup is characteristic
in the original ambient group. -/
public theorem characteristic_zpowers_pow_of_characteristic
    {G : Type*} [Group G] (a : G) [(zpowers a).Characteristic] (k : ℕ) :
    (zpowers (a ^ k)).Characteristic := by
  apply characteristic_iff_le_comap.mpr
  intro f x hx
  obtain ⟨j, rfl⟩ := mem_zpowers_iff.mp hx
  have hfa : f a ∈ zpowers a :=
    characteristic_iff_le_comap.mp inferInstance f (mem_zpowers a)
  obtain ⟨i, hi⟩ := mem_zpowers_iff.mp hfa
  change f ((a ^ k) ^ j) ∈ zpowers (a ^ k)
  rw [map_zpow, map_pow, ← hi]
  have hpow : (a ^ i) ^ k = (a ^ k) ^ i := by
    simp only [← zpow_natCast, ← zpow_mul, mul_comm]
  rw [hpow]
  exact zpow_mem (zpow_mem (mem_zpowers _) _) _

/-- Centralizers split over a commuting product when the tested subgroup lies
in the second factor. -/
public theorem centralizer_eq_sup_inf_of_centralizing_sup_eq_top
    {G : Type*} [Group G] (E D W : Subgroup G)
    (hgen : E ⊔ D = ⊤) (hc : D ≤ centralizer (E : Set G)) (hWD : W ≤ D) :
    centralizer (W : Set G) = E ⊔ (D ⊓ centralizer (W : Set G)) := by
  let : D.Normal := normal_of_centralizing_sup_eq_top D E
    (sup_comm E D ▸ hgen) (le_centralizer_iff.mp hc)
  have hEC : E ≤ centralizer (W : Set G) :=
    (le_centralizer_iff.mp hc).trans (centralizer_le hWD)
  apply le_antisymm
  · intro x hx
    obtain ⟨e, he, d, hd, rfl⟩ := mem_sup_of_normal_right.mp
      (show x ∈ E ⊔ D by rw [hgen]; trivial)
    have hdC : d ∈ centralizer (W : Set G) := by
      have hh := (centralizer (W : Set G)).mul_mem
        ((centralizer (W : Set G)).inv_mem (hEC he)) hx
      simpa using hh
    exact mul_mem_sup he ⟨hd, hdC⟩
  · exact sup_le hEC inf_le_right

/-- The ambient `EM` appearing in Hall's modular case is characteristic. -/
public theorem characteristic_sup_inf_centralizer_zpowers_sq
    {G : Type*} [Group G] (E D : Subgroup G) (a : G)
    [(zpowers a).Characteristic] (haD : a ∈ D)
    (hgen : E ⊔ D = ⊤) (hc : D ≤ centralizer (E : Set G)) :
    (E ⊔ (D ⊓ centralizer (zpowers (a ^ 2) : Set G))).Characteristic := by
  let : (zpowers (a ^ 2)).Characteristic :=
    characteristic_zpowers_pow_of_characteristic a 2
  rw [← centralizer_eq_sup_inf_of_centralizing_sup_eq_top E D _ hgen hc
    (zpowers_le.mpr (D.pow_mem haD 2))]
  infer_instance

end Subgroup
