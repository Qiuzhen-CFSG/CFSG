module
public import Theory.GroupTheory.PGroup.ExtraspecialInvolution
public import Theory.GroupTheory.CentralCharacteristicAutomorphisms
public import Mathlib.GroupTheory.IndexNormal

/-!
# Involutive automorphisms fixing an index-two subgroup

If an involutive automorphism fixes an index-two subgroup pointwise and
fixes all squares, its discrepancy on an outside representative is a fixed
involution. The square equation makes this discrepancy commute with that
representative, so it is central. The action on the central quotient is trivial.
For an extraspecial two-group, comparison of the two possible commutators
also identifies the double centralizer of an element whose centralizer has
index two as its cyclic group joined with the center.

Source application: the omega-center calculation in Aschbacher--Smith
14.3.22, printed p.999. The index-two argument extends the involution-only
calculation in `ExtraspecialInvolutionDoubleCentralizer` to order-four elements.
-/

public section
open Subgroup
open scoped commutatorElement
namespace Subgroup
variable {P : Type*} [Group P]

/-- Centralizing an index-two subgroup and one outside element is centrality. -/
theorem mem_center_of_centralizes_index_two
    (C : Subgroup P) (hi : C.index = 2) (v : P) (hv : v ∉ C)
    (d : P) (hd : d ∈ centralizer (C : Set P)) (hdv : Commute d v) :
    d ∈ center P := by
  apply mem_center_iff.mpr
  intro w
  by_cases hw : w ∈ C
  · exact hd w hw
  · have hwv : w * v⁻¹ ∈ C :=
      (C.mul_mem_iff_of_index_two hi).mpr (by simp only [inv_mem_iff, hw, hv])
    have hc : Commute (w * v⁻¹) d := hd _ hwv
    have h := hc.mul_left hdv.symm
    simpa only [inv_mul_cancel_right] using h.eq

/-- An involutive automorphism fixing an index-two subgroup and all squares
acts trivially on the central quotient. -/
theorem quotientAut_eq_one_of_involutive_fixed_index_two
    (C : Subgroup P) (hi : C.index = 2) (e : MulAut P) (he : e ^ 2 = 1)
    (hfix : ∀ c ∈ C, e c = c) (hsq : ∀ v : P, e (v ^ 2) = v ^ 2) :
    quotientAut (center P) e = 1 := by
  let : C.Normal := normal_of_index_eq_two hi
  have hdiff (v : P) : v⁻¹ * e v ∈ center P := by
    by_cases hv : v ∈ C
    · simp only [hfix v hv, inv_mul_cancel, one_mem]
    let d := v⁻¹ * e v
    have hev : e v ∉ C := by
      intro hh
      have hvv : e v = v := e.injective (hfix (e v) hh)
      exact hv (hvv ▸ hh)
    have hdC : d ∈ C := (C.mul_mem_iff_of_index_two hi).mpr
      (by simp only [inv_mem_iff, hv, hev])
    have hd : d ∈ centralizer (C : Set P) := by
      intro c hc
      have hconj := hfix (v*c*v⁻¹) ((inferInstance : C.Normal).conj_mem c hc v)
      rw [map_mul, map_mul, map_inv, hfix c hc] at hconj
      have hh := congrArg (fun t : P => v⁻¹*t*e v) hconj
      have heq : d*c=c*d := by
        simpa only [d, mul_assoc, inv_mul_cancel, mul_inv_cancel, inv_mul_cancel_left,
          mul_one, one_mul] using hh
      exact heq.symm
    have hstep : e v = v*d := by simp [d]
    have hee : e (e v) = v := by
      simpa only [pow_two, MulAut.mul_apply, MulAut.one_apply] using DFunLike.congr_fun he v
    have hd2 : d*d=1 := by
      have hh : v*(d*d)=v := by
        calc
          v*(d*d) = e (e v) := by
            calc
              v*(d*d) = (v*d)*d := (mul_assoc _ _ _).symm
              _ = e v * e d := by rw [hfix d hdC, hstep]
              _ = e (v*d) := (map_mul e v d).symm
              _ = e (e v) := congrArg e hstep.symm
          _ = v := hee
      exact mul_left_cancel (hh.trans (mul_one v).symm)
    have hs : (v*d)^2=v^2 := by rw [← hstep, ← map_pow, hsq]
    have hdv : Commute d v := by
      change d*v=v*d
      have hh := congrArg (fun t : P => v⁻¹*t*d) hs
      simpa only [pow_two, mul_assoc, inv_mul_cancel_left, hd2, mul_one] using hh
    exact mem_center_of_centralizes_index_two C hi v hv d hd hdv
  apply MulEquiv.ext
  intro q
  obtain ⟨v,rfl⟩ := QuotientGroup.mk'_surjective (center P) q
  rw [quotientAut_apply_mk, MulAut.one_apply]
  apply (eq_comm).mp
  exact QuotientGroup.eq.mpr (hdiff v)

variable [IsExtraspecial 2 P]
/-- The double centralizer of a noncentral element in an extraspecial two-group
is generated by that element and the center. The index is kept explicit for
applications that already computed the centralizer's order. -/
theorem extraspecial_double_centralizer_le
    (t : P) (hi : (centralizer ({t} : Set P)).index = 2) :
    centralizer (centralizer ({t} : Set P) : Set P) ≤ center P ⊔ zpowers t := by
  let C := centralizer ({t} : Set P)
  obtain ⟨v,hv,_⟩ := C.index_eq_two_iff_exists_notMem_and.mp hi
  have hcomm (x y : P) : ⁅x,y⁆ ∈ center P :=
    (IsExtraspecial.quotient_elementary_abelian 2 P).commutator_le_center_of_central_quotient
      (commutator_mem_commutator (mem_top x) (mem_top y))
  have hvt : ⁅v,t⁆ ≠ 1 := by
    intro hh
    exact hv (mem_centralizer_singleton_iff.mpr (commutatorElement_eq_one_iff_mul_comm.mp hh))
  intro x hx
  by_cases hxv : Commute x v
  · exact mem_sup_left (mem_center_of_centralizes_index_two C hi v hv x hx hxv)
  have hvx : ⁅v,x⁆ ≠ 1 := fun hh => hxv
    (show Commute v x from commutatorElement_eq_one_iff_mul_comm.mp hh).symm
  have he : ⁅v,x⁆ = ⁅v,t⁆ := by
    obtain ⟨z,_,hall⟩ := (Nat.card_eq_two_iff' (1 : center P)).mp
      (IsExtraspecial.center_order_p 2 P)
    exact congrArg Subtype.val
      ((hall ⟨_,hcomm v x⟩ (fun h => hvx (congrArg Subtype.val h))).trans
        (hall ⟨_,hcomm v t⟩ (fun h => hvt (congrArg Subtype.val h))).symm)
  have hxtC : x*t⁻¹ ∈ centralizer (C : Set P) :=
    (centralizer (C : Set P)).mul_mem hx
      ((centralizer (C : Set P)).inv_mem (fun c hc => mem_centralizer_singleton_iff.mp hc))
  have hxtv : Commute (x*t⁻¹) v := by
    have hh := congrArg (fun q : P => v⁻¹*q) he
    have hxx : x*v⁻¹*x⁻¹=t*v⁻¹*t⁻¹ := by
      simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel_left] using hh
    have hh' := congrArg (fun q : P => t⁻¹*q*x) hxx
    have htv : t⁻¹*x*v⁻¹=v⁻¹*t⁻¹*x := by
      simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using hh'
    have hxt : Commute x t := (hx t (mem_centralizer_singleton_iff.mpr rfl)).symm
    have hh'' : Commute (x*t⁻¹) v⁻¹ := by
      change x*t⁻¹*v⁻¹=v⁻¹*(x*t⁻¹)
      simpa only [hxt.inv_right.eq, mul_assoc] using htv
    exact Commute.inv_right_iff.mp hh''
  have hz := mem_center_of_centralizes_index_two C hi v hv (x*t⁻¹) hxtC hxtv
  have hh := (center P ⊔ zpowers t).mul_mem (mem_sup_left hz) (mem_sup_right (mem_zpowers t))
  simpa only [inv_mul_cancel_right] using hh
end Subgroup
