module

public import Theory.GroupTheory.PGroup.CentralFourTorsionSquares
public import Theory.GroupTheory.PGroup.ExponentFourSquareRange

/-!
# Powerfulness and two generators with central fourth roots

Suppose a finite two-group has central fourth roots of one and exactly four
square roots of one. Its squares and fourth powers form the first and second
Frattini subgroups, respectively, and it has two generators.

In the nonabelian case, a central element outside Frattini would extend to a
pair of generators and force commutativity. Thus all square roots of one lie in
Frattini. Both successive Frattini indices are four. The resulting quotient by
fourth powers has order sixteen, exponent dividing four, and four squares
forming its Frattini subgroup. The order-sixteen square-range theorem makes
this quotient abelian, so the commutator subgroup lies in the subgroup generated
by fourth powers. Thus the group is powerful and generated by two elements.

Source context: MacWilliams, *On 2-groups with no normal abelian subgroups of
rank 3*, Trans. AMS 150 (1970), printed p.377, assertion (xvii), citing Alperin
(J. Algebra 1 (1964), pp.110–113). The reductions here are direct counting and
Frattini arguments.
-/

open Subgroup

namespace IsPGroup
private theorem exists_second_generator_of_card_frattini_quotient_eq_four
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hc : Nat.card (Q ⧸ frattini Q) = 4) (a : Q) (ha : a ∉ frattini Q) :
    ∃ b : Q, zpowers a ⊔ zpowers b = ⊤ := by
  let : Fact (IsPGroup 2 Q) := ⟨hQ⟩
  let q := QuotientGroup.mk' (frattini Q)
  have hqa : q a ≠ 1 := fun h => ha ((QuotientGroup.eq_one_iff a).mp h)
  have hasq : q a ^ 2 = 1 := by
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (pth_power_mem_frattini_of_isPGroup (p := 2) a)
  have ho : orderOf (q a) = 2 :=
    (Nat.dvd_prime Nat.prime_two).mp (orderOf_dvd_of_pow_eq_one hasq) |>.resolve_left
      (fun h => hqa (orderOf_eq_one_iff.mp h))
  let L := zpowers (q a)
  have hi : L.index = 2 := by
    have := L.card_mul_index
    rw [show Nat.card L = 2 by simpa [L] using ho, hc] at this
    omega
  have hL : L ≠ ⊤ := by intro h; simp [h] at hi
  obtain ⟨bq, -, hbq⟩ := SetLike.exists_of_lt (lt_top_iff_ne_top.mpr hL)
  have hlt : L < L ⊔ zpowers bq := lt_of_le_of_ne le_sup_left (by
    intro h
    have hb : bq ∈ L ⊔ zpowers bq :=
      (show zpowers bq ≤ L ⊔ zpowers bq from le_sup_right) (mem_zpowers bq)
    exact hbq (h ▸ hb))
  have hgen : L ⊔ zpowers bq = ⊤ := by
    have hltindex := index_strictAnti hlt
    have hpos := (L ⊔ zpowers bq).index_ne_zero_of_finite
    rw [hi] at hltindex
    exact index_eq_one.mp (by omega)
  obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (frattini Q) bq
  refine ⟨b, frattini_nongenerating ?_⟩
  have hm : (zpowers a ⊔ zpowers b).map q = ⊤ := by
    simpa [L, q, Subgroup.map_sup, MonoidHom.map_zpowers] using hgen
  simpa only [q, Subgroup.comap_map_eq, QuotientGroup.ker_mk', Subgroup.comap_top] using
    congrArg (Subgroup.comap q) hm

private theorem commutative_of_central_nonfrattini_of_card_quotient_eq_four
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hc : Nat.card (Q ⧸ frattini Q) = 4)
    (a : Q) (hac : a ∈ center Q) (ha : a ∉ frattini Q) : IsMulCommutative Q := by
  obtain ⟨b, hab⟩ := exists_second_generator_of_card_frattini_quotient_eq_four hQ hc a ha
  have hcb : centralizer ({b} : Set Q) = ⊤ := by
    apply top_unique
    rw [← hab]
    apply sup_le <;> apply zpowers_le.mpr
    · exact mem_centralizer_singleton_iff.mpr (mem_center_iff.mp hac b).symm
    · exact mem_centralizer_singleton_iff.mpr rfl
  have hbc : b ∈ center Q := by
    apply mem_center_iff.mpr
    intro x
    have hx : x ∈ centralizer ({b} : Set Q) := by rw [hcb]; trivial
    exact (mem_centralizer_singleton_iff.mp hx)
  apply center_eq_top_iff.mp
  apply top_unique
  rw [← hab]
  exact sup_le (zpowers_le.mpr hac) (zpowers_le.mpr hbc)
/-- In the nonabelian case, every square root of one lies in Frattini. -/
public theorem square_roots_mem_frattini_of_central_fourth_roots_of_nonabelian
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} = 4)
    (hn : ¬ IsMulCommutative Q) (x : Q) (hx : x ^ 2 = 1) : x ∈ frattini Q := by
  by_contra hnot
  apply hn
  apply commutative_of_central_nonfrattini_of_card_quotient_eq_four hQ
    (hQ.card_frattini_quotient_eq_four_of_central_fourth_roots hfour hcount) x _ hnot
  exact hfour x (by rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hx, one_pow])

/-- The nonabelian case retains all four square roots inside Frattini. -/
public theorem card_square_roots_frattini_of_central_fourth_roots_of_nonabelian
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} = 4)
    (hn : ¬ IsMulCommutative Q) :
    Nat.card {x : frattini Q // x ^ 2 = 1} = 4 := by
  let e : {x : Q // x ^ 2 = 1} ≃ {x : frattini Q // x ^ 2 = 1} :=
    { toFun x := ⟨⟨x, hQ.square_roots_mem_frattini_of_central_fourth_roots_of_nonabelian
        hfour hcount hn x x.property⟩, Subtype.ext x.property⟩
      invFun x := ⟨x.val, congrArg Subtype.val x.property⟩
      left_inv _ := rfl
      right_inv _ := rfl }
  exact (Nat.card_congr e).symm.trans hcount

/-- The second Frattini subgroup has index sixteen in the nonabelian case. -/
public theorem index_second_frattini_eq_sixteen_of_central_fourth_roots_of_nonabelian
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} = 4)
    (hn : ¬ IsMulCommutative Q) :
    ((frattini (frattini Q)).map (frattini Q).subtype).index = 16 := by
  rw [index_map_subtype, index_eq_card, index_eq_card,
    hQ.card_frattini_quotient_eq_four_of_central_fourth_roots hfour hcount,
    (hQ.to_subgroup _).card_frattini_quotient_eq_four_of_central_fourth_roots
      (central_fourth_roots_subgroup hfour _)
      (hQ.card_square_roots_frattini_of_central_fourth_roots_of_nonabelian hfour hcount hn)]

/-- The quotient by fourth powers has order sixteen, exponent dividing four,
and four squares forming its Frattini subgroup. -/
public theorem fourth_power_quotient_data_of_central_fourth_roots_of_nonabelian
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} = 4)
    (hn : ¬ IsMulCommutative Q) :
    let N := (frattini (frattini Q)).map (frattini Q).subtype
    Nat.card (Q ⧸ N) = 16 ∧
      (∀ x : Q ⧸ N, x ^ 4 = 1) ∧
      Set.range (fun x : Q ⧸ N => x ^ 2) = (frattini (Q ⧸ N) : Set (Q ⧸ N)) ∧
      Nat.card (frattini (Q ⧸ N)) = 4 := by
  let N := (frattini (frattini Q)).map (frattini Q).subtype
  let q := QuotientGroup.mk' N
  have hH := hQ.to_quotient N
  have hcard : Nat.card (Q ⧸ N) = 16 :=
    hQ.index_second_frattini_eq_sixteen_of_central_fourth_roots_of_nonabelian hfour hcount hn
  have hsq := hQ.square_range_eq_frattini_of_central_fourth_roots hfour hcount.le
  have hfourN := hQ.fourth_power_range_eq_second_frattini_of_central_fourth_roots
    hfour hcount.le
  have hsqmap : Set.range (fun x : Q ⧸ N => x ^ 2) =
      ((frattini Q).map q : Set (Q ⧸ N)) := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      obtain ⟨z, rfl⟩ := QuotientGroup.mk'_surjective N y
      refine ⟨z ^ 2, ?_, map_pow q z 2⟩
      rw [← hsq]
      exact ⟨z, rfl⟩
    · rintro ⟨y, hy, rfl⟩
      change y ∈ (frattini Q : Set Q) at hy
      rw [← hsq] at hy
      obtain ⟨z, rfl⟩ := hy
      exact ⟨q z, (map_pow q z 2).symm⟩
  have hphi : frattini (Q ⧸ N) = (frattini Q).map q := by
    rw [hH.frattini_eq_closure_squares, hsqmap, Subgroup.closure_eq]
  refine ⟨hcard, ?_, hsqmap.trans (congrArg SetLike.coe hphi.symm), ?_⟩
  · intro x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N x
    rw [← map_pow]
    apply (QuotientGroup.eq_one_iff _).mpr
    change y ^ 4 ∈ ((frattini (frattini Q)).map (frattini Q).subtype : Set Q)
    rw [← hfourN]
    exact ⟨y, rfl⟩
  · have hi : ((frattini Q).map q).index = 4 := by
      rw [Subgroup.index_map_eq _ (QuotientGroup.mk'_surjective N) (by
        simpa only [q, QuotientGroup.ker_mk'] using
          (map_subtype_le (frattini (frattini Q))))]
      exact hQ.card_frattini_quotient_eq_four_of_central_fourth_roots hfour hcount
    have hp := ((frattini Q).map q).card_mul_index
    rw [hi, hcard] at hp
    rw [hphi]
    exact Nat.eq_of_mul_eq_mul_right (by decide : 0 < 4) hp
/-- A finite two-group with central fourth roots and exactly four square roots
of one is powerful: its commutator subgroup is contained in its fourth powers. -/
public theorem commutator_le_closure_fourth_powers_of_central_fourth_roots
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} = 4) :
    _root_.commutator Q ≤ Subgroup.closure (Set.range (fun x : Q => x ^ (4 : ℕ))) := by
  by_cases hc : IsMulCommutative Q
  · rw [(commutator_eq_bot_iff Q).mpr hc]
    exact bot_le
  · let N := (frattini (frattini Q)).map (frattini Q).subtype
    obtain ⟨hcard, hexp, hsquares, hphi⟩ :=
      hQ.fourth_power_quotient_data_of_central_fourth_roots_of_nonabelian hfour hcount hc
    have habel : IsMulCommutative (Q ⧸ N) :=
      (hQ.to_quotient N).isMulCommutative_of_card_sixteen_of_exponent_four_of_square_range
        hcard hexp hsquares hphi
    have hle : _root_.commutator Q ≤ N :=
      Normal.quotient_commutative_iff_commutator_le.mp habel
    rw [hQ.fourth_power_range_eq_second_frattini_of_central_fourth_roots hfour hcount.le,
      Subgroup.closure_eq]
    exact hle

/-- Central fourth roots and exactly four square roots of one imply both
powerfulness and generation by two elements. -/
public theorem powerful_and_two_generated_of_central_fourth_roots
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} = 4) :
    _root_.commutator Q ≤ Subgroup.closure (Set.range (fun x : Q => x ^ (4 : ℕ))) ∧
      ∃ a b : Q, zpowers a ⊔ zpowers b = ⊤ :=
  ⟨hQ.commutator_le_closure_fourth_powers_of_central_fourth_roots hfour hcount,
    hQ.exists_two_generators_of_central_fourth_roots hfour hcount.le⟩

end IsPGroup
