module

public import Theory.GroupTheory.PGroup.NormalEightCriticalSubgroup
public import Theory.GroupTheory.PGroup.NormalEightInvolutionLift
public import Theory.GroupTheory.PGroup.ClassTwoThreeInvolutionExponent
public import Theory.GroupTheory.PGroup.TransitiveInvolutions

/-!
# Extensions of critical subgroups with elementary center

Suppose a finite group has central first omega of order four and no normal
elementary binary subgroup of order at least eight. If a critical subgroup
has elementary center, its center maps into the ambient central four. The
three-subgroups lemma then puts every ambient commutator in that same four.
The normal elementary subgroup generated by this four and an involution
forces the involution to be central.

For a nonabelian critical subgroup, transitivity on its three involutions
supplies the elementary-center premise: its class-two condition gives
exponent four by the three-involution theorem, and then the special-group
calculation identifies its center with first omega. Transitivity is an
explicit hypothesis, not a consequence asserted of the local data.

Finally, ambient fusion of central Sylow involutions induces transitive
automorphisms of the critical subgroup, by Burnside fusion in the Sylow
normalizer and restriction to a characteristic subgroup.

Sources: Thompson's critical subgroup theorem, Gorenstein, *Finite Groups*,
Theorem 5.3.11; the three-subgroups lemma; Janko–Thompson, Math. Z. 113 (1970),
Theorem 1.3, p.386, quoting MacWilliams, Trans. AMS 150 (1970),
DOI 10.1090/S0002-9947-1970-0276324-3.
-/

open Subgroup
open scoped commutatorElement

namespace IsCriticalPSubgroup

/-- If the center of a critical subgroup is ambient-central, it contains the ambient derived subgroup. -/
public theorem ambient_commutator_le_center_image
    {P : Type*} [Group P] {p : ℕ} {C : Subgroup P}
    (hC : IsCriticalPSubgroup p C)
    (hZ : (center C).map C.subtype ≤ center P) :
    commutator P ≤ (center C).map C.subtype := by
  have hrotate : ⁅⁅(⊤ : Subgroup P), C⁆, ⊤⁆ = ⊥ :=
    commutator_top_right_eq_bot_iff_le_center.mpr (hC.commutator_le.trans hZ)
  have hcomm : ⁅⁅(⊤ : Subgroup P), ⊤⁆, C⁆ = ⊥ :=
    commutator_commutator_eq_bot_of_rotate hrotate (by
      rwa [commutator_comm C ⊤])
  rw [← hC.centralizer_eq]
  exact commutator_eq_bot_iff_le_centralizer.mp hcomm

/-- An elementary critical center forces all ambient involutions to be central when normal elementary eights are absent. -/
public theorem involutions_central_of_elementary_center
    {P : Type*} [Group P] [Finite P] {C : Subgroup P}
    (hC : IsCriticalPSubgroup 2 C)
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    [IsElementaryAbelian 2 (center C)] :
    ∀ x : P, x ^ 2 = 1 → x ∈ center P := by
  let : C.Characteristic := hC.characteristic
  let Z := (center C).map C.subtype
  let : Z.Normal := inferInstance
  let : IsElementaryAbelian 2 Z := IsElementaryAbelian.map_subtype
  have hZO := normal_elementary_le_omega_center_of_no_normal_eight hno hZ Z
  have hcomm := hC.ambient_commutator_le_center_image (hZO.trans (map_subtype_le _))
  intro x hx
  apply mem_center_of_square_eq_one_of_displacement_in_omega_center hno hZ x hx
  intro g
  exact hZO (hcomm (commutator_mem_commutator (mem_top g) (mem_top x)))

/-- Transitivity on the three involutions of a nonabelian critical subgroup forces all ambient involutions to be central. -/
public theorem involutions_central_of_transitive_involutions
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P) {C : Subgroup P}
    (hC : IsCriticalPSubgroup 2 C)
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (hnonab : ¬ IsMulCommutative C)
    (htrans : ∀ x y : C, orderOf x = 2 → orderOf y = 2 →
      ∃ a : MulAut C, a x = y) :
    ∀ x : P, x ^ 2 = 1 → x ∈ center P := by
  have hclass : commutator C ≤ center C := by
    apply Subgroup.commutator_le.mpr
    intro x _ y _
    have hh := hC.commutator_le
      (commutator_mem_commutator (mem_top (x : P)) y.property)
    obtain ⟨z, hz, he⟩ := hh
    exact (Subtype.ext he : z = ⁅x, y⁆) ▸ hz
  have hcentral := hC.square_one_mem_center hno hZ
  have hexp := (hP.to_subgroup C).exponent_four_of_class_two_of_transitive_three_involutions
    hnonab hcentral (hC.card_involutions_eq_three hno hZ) htrans hclass
  obtain ⟨_, _, helem, _⟩ :=
    (hP.to_subgroup C).special_of_exponent_four_of_transitive_involutions
      hnonab hcentral htrans hexp
  let : IsElementaryAbelian 2 (center C) := helem
  exact hC.involutions_central_of_elementary_center hno hZ

end IsCriticalPSubgroup

namespace Sylow

/-- Fusion of central Sylow involutions supplies transitive automorphisms of every critical subgroup. -/
public theorem critical_involutions_transitive_of_central_fusion
    {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    (hno : ¬ ∃ E : Subgroup S, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center S) (p := 2)) = 4)
    {C : Subgroup S} (hC : IsCriticalPSubgroup 2 C)
    (hfuse : ∀ x y : S, x ∈ center S → y ∈ center S →
      orderOf x = 2 → orderOf y = 2 → IsConj (x : G) (y : G)) :
    ∀ x y : C, orderOf x = 2 → orderOf y = 2 →
      ∃ a : MulAut C, a x = y := by
  let : C.Characteristic := hC.characteristic
  intro x y hx hy
  have hcentral (z : C) (hz : orderOf z = 2) : (z : S) ∈ center S :=
    map_subtype_le _ (hC.mem_omega_center_of_square_eq_one hno hZ z.property
      (congrArg Subtype.val (by simpa only [hz] using pow_orderOf_eq_one z)))
  have hxc := hcentral x hx
  have hyc := hcentral y hy
  obtain ⟨g, hg⟩ := isConj_iff.mp
    (hfuse x y hxc hyc ((orderOf_coe x).trans hx) ((orderOf_coe y).trans hy))
  have hxC : ((x : S) : G) ∈ centralizer (S : Set G) := by
    intro z hz
    exact congrArg Subtype.val (mem_center_iff.mp hxc (⟨z, hz⟩ : S))
  have hyC : ((y : S) : G) ∈ centralizer (S : Set G) := by
    intro z hz
    exact congrArg Subtype.val (mem_center_iff.mp hyc (⟨z, hz⟩ : S))
  obtain ⟨n, hn, he⟩ := S.conj_eq_normalizer_conj_of_mem_centralizer
    ((x : S) : G) g⁻¹ hxC (by simpa only [inv_inv, hg] using hyC)
  let a : MulAut S := normalizerMonoidHom (S : Subgroup G) ⟨n⁻¹, inv_mem hn⟩
  have haxy : a (x : S) = y := by
    apply Subtype.ext
    change n⁻¹ * ((x : S) : G) * (n⁻¹)⁻¹ = y
    simpa only [inv_inv, hg] using he.symm
  refine ⟨MulAut.characteristic C a, ?_⟩
  exact Subtype.ext haxy

end Sylow
