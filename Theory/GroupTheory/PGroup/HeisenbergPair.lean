module
public import Theory.SpecificGroups.HeisenbergPrime.Recognition
public import Theory.GroupTheory.PGroup.ExtraspecialPrimeCube

/-!
# Prime-cube groups from a noncommuting Heisenberg pair

If x,y and their central commutator have p-th power one, evaluation from the
prime Heisenberg group maps onto their generated subgroup. Its order divides
p³. Noncommutation excludes orders 1, p and p², proving exact order p³.
This structural argument avoids enumerating a concrete multiplication table.

Source application: Aschbacher–Smith G.7.2(6), printed pp.347–348, through the
actual Rudvalis words in `Theory.SpecificGroups.Rudvalis.Model.ExtraspecialFive`.
-/

open scoped commutatorElement
open Subgroup

namespace PrimeCubePair
variable {G : Type*} [Group G] {p : ℕ} [Fact p.Prime]

/-- A group generated by a noncommuting Heisenberg pair has order p³. -/
public theorem card_eq_of_pair (x y : G)
    (hgen : closure ({x, y} : Set G) = ⊤)
    (hx : x ^ p = 1) (hy : y ^ p = 1) (hc : ⁅x, y⁆ ^ p = 1)
    (hcx : Commute ⁅x, y⁆ x) (hcy : Commute ⁅x, y⁆ y)
    (hxy : x * y ≠ y * x) : Nat.card G = p ^ 3 := by
  have hz : ⁅x, y⁆ ∈ center G := by
    have hle : closure ({x, y} : Set G) ≤ centralizer ({⁅x, y⁆} : Set G) := by
      rw [closure_le]
      rintro z (rfl | hz)
      · exact mem_centralizer_singleton_iff.mpr hcx.eq.symm
      · obtain rfl := hz
        exact mem_centralizer_singleton_iff.mpr hcy.eq.symm
    rw [hgen] at hle
    exact mem_center_iff.mpr fun z =>
      mem_centralizer_singleton_iff.mp (hle (mem_top z))
  let f := HeisenbergPrime.evaluateHom y x ⁅x, y⁆ hz
    (by simp [commutatorElement_def, mul_assoc]) hy hx hc
  have hxmem : x ∈ f.range := by
    refine ⟨⟨1, 0, 0⟩, ?_⟩
    simp [f, HeisenbergPrime.evaluateHom, ZMod.val_one]
  have hymem : y ∈ f.range := by
    refine ⟨⟨0, 1, 0⟩, ?_⟩
    simp [f, HeisenbergPrime.evaluateHom, ZMod.val_one]
  have hsurj : Function.Surjective f := MonoidHom.range_eq_top.mp <| top_unique <| by
    rw [← hgen, closure_le]
    rintro z (rfl | hz)
    · exact hxmem
    · obtain rfl := hz
      exact hymem
  have hd : Nat.card G ∣ p ^ 3 := by
    simpa only [HeisenbergPrime.card] using card_dvd_of_surjective f hsurj
  obtain ⟨k, hk, he⟩ := (Nat.dvd_prime_pow (Fact.out : p.Prime)).mp hd
  rcases (show k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 by omega) with rfl | rfl | rfl | rfl
  · let : IsCyclic G := isCyclic_of_card_dvd_prime (p := p) (by simp [he])
    exact (hxy (IsMulCommutative.is_comm.comm x y)).elim
  · let : IsCyclic G := isCyclic_of_card_dvd_prime (p := p) (by simp [he])
    exact (hxy (IsMulCommutative.is_comm.comm x y)).elim
  · let : IsMulCommutative G := IsPGroup.isMulCommutative_of_card_eq_prime_sq he
    exact (hxy (IsMulCommutative.is_comm.comm x y)).elim
  · exact he

/-- The subgroup of a noncommuting pair with the Heisenberg relations has order p³. -/
public theorem card_closure_pair (x y : G)
    (hx : x ^ p = 1) (hy : y ^ p = 1) (hc : ⁅x, y⁆ ^ p = 1)
    (hcx : Commute ⁅x, y⁆ x) (hcy : Commute ⁅x, y⁆ y)
    (hxy : x * y ≠ y * x) : Nat.card (closure ({x, y} : Set G)) = p ^ 3 := by
  let P := closure ({x, y} : Set G)
  let a : P := ⟨x, subset_closure (by simp)⟩
  let b : P := ⟨y, subset_closure (by simp)⟩
  have hgen : closure ({a, b} : Set P) = ⊤ := by
    apply Subgroup.map_injective P.subtype_injective
    rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype]
    simp only [Set.image_insert_eq, Set.image_singleton, coe_subtype, a, b, P]

  exact card_eq_of_pair a b hgen (Subtype.ext hx) (Subtype.ext hy)
    (Subtype.ext hc) (Subtype.ext hcx.eq) (Subtype.ext hcy.eq)
    (fun h => hxy (congrArg Subtype.val h))
end PrimeCubePair
