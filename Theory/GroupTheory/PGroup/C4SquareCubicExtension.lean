module

public import Theory.GroupTheory.PGroup.AbelianCriticalSixteenSetup
public import Theory.GroupTheory.NormalizingInvolutionCard

/-!
# A cubic index-four core with an inverting overgroup

This algebraic interface describes the order-128 extension left after the
index-four core reduction for a self-centralizing C₄-square. It specifies
conjugation and cubic-action identities, without assuming any centralizer or
normalizer classification. The core may be split or of G. Higman type.

The cubic automorphism is fixed-point-free on the core modulo the base.
Each nontrivial core coset fixes only square-one base elements. The outside
involution inverts the base, and its commutators with the nontrivial core
cosets have nontrivial squares. These are the inputs to the ensuing local
centralizer calculation.

Source: MacWilliams, Trans. AMS 150 (1970), Case 1.2, Lemma 3 and the
paragraphs following (xxii), printed pp.380–383,
DOI 10.1090/S0002-9947-1970-0276324-3.
-/

open Subgroup

/-- Algebraic extension data before classifying elementary-eight normalizers.
The base's critical, C₄-square, and central-omega properties and the order-three
and fixed-point-free hypotheses on `a` are supplied by the consumer. -/
public structure C4SquareCubicInvertingExtension
    {P : Type*} [Group P] (C R : Subgroup P) (a : MulAut P) (t : P) : Prop where
  base_le : C ≤ R
  core_card : Nat.card R = 64
  core_index : R.index = 2
  core_invariant : ∀ r ∈ R, a r ∈ R
  core_quotient_fixed_free : ∀ r ∈ R, a r * r⁻¹ ∈ C → r ∈ C
  outside_order : orderOf t = 2
  outside_not_mem : t ∉ R
  outside_fixed : a t = t
  outside_inverts : ∀ c ∈ C, t * c * t⁻¹ = c⁻¹
  core_fixed_elements : ∀ r ∈ R, r ∉ C → ∀ c ∈ C, Commute c r → c ^ 2 = 1
  mixed_commutator : ∀ r ∈ R, r ∉ C → (r * t * r⁻¹ * t⁻¹) ^ 2 ≠ 1

namespace C4SquareCubicInvertingExtension

/-- The ambient extension has order 128. -/
public theorem card_eq_128 {P : Type*} [Group P]
    {C R : Subgroup P} {a : MulAut P} {t : P}
    (h : C4SquareCubicInvertingExtension C R a t) : Nat.card P = 128 := by
  have hc := R.card_mul_index
  rw [h.core_card, h.core_index] at hc
  exact hc.symm

variable {P : Type*} [Group P] [Finite P]
  {C R : Subgroup P} {a : MulAut P} {t : P}

/-- The outside involution centralizes exactly the central omega inside the
core. Nontrivial core cosets are excluded by the mixed-commutator condition. -/
public theorem centralizer_inf_core
    (h : C4SquareCubicInvertingExtension C R a t)
    (hC : IsCriticalPSubgroup 2 C)
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4) :
    centralizer ({t} : Set P) ⊓ R =
      (omega₁ (center P) (p := 2)).map (center P).subtype := by
  apply le_antisymm
  · intro r hr
    have hc := mem_centralizer_singleton_iff.mp hr.1
    have hrC : r ∈ C := by
      by_contra hn
      apply h.mixed_commutator r hr.2 hn
      rw [hc, mul_inv_cancel_right, mul_inv_cancel, one_pow]
    have hinv : r⁻¹ = r := by
      rw [← h.outside_inverts r hrC, ← hc, mul_inv_cancel_right]
    exact hC.mem_omega_center_of_square_eq_one hno hZ hrC
      (by calc
        r ^ 2 = r⁻¹ * r := by rw [hinv, pow_two]
        _ = 1 := inv_mul_cancel r)
  · intro w hw
    refine ⟨center_le_centralizer _ (map_subtype_le _ hw), ?_⟩
    apply h.base_le
    rw [← hC.omega_one_map_eq_center hno hZ] at hw
    exact map_subtype_le _ hw

/-- The outside involution has centralizer generated by itself and the
central omega four. This precedes either split/nonsplit classification. -/
public theorem centralizer_eq_omega_sup
    (h : C4SquareCubicInvertingExtension C R a t)
    (hC : IsCriticalPSubgroup 2 C)
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4) :
    centralizer ({t} : Set P) =
      (omega₁ (center P) (p := 2)).map (center P).subtype ⊔ zpowers t := by
  let W := (omega₁ (center P) (p := 2)).map (center P).subtype
  have hinf : centralizer ({t} : Set P) ⊓ R = W := h.centralizer_inf_core hC hno hZ
  have ht : t ∈ centralizer ({t} : Set P) := mem_centralizer_singleton_iff.mpr rfl
  apply le_antisymm
  · intro x hx
    by_cases hxR : x ∈ R
    · exact (show W ≤ W ⊔ zpowers t from le_sup_left)
        (hinf ▸ (show x ∈ centralizer ({t} : Set P) ⊓ R from ⟨hx, hxR⟩))
    · have hr : t⁻¹ * x ∈ R := by
        rw [mul_mem_iff_of_index_two h.core_index, inv_mem_iff]
        exact iff_of_false h.outside_not_mem hxR
      have hw : t⁻¹ * x ∈ W := hinf ▸
        (show t⁻¹ * x ∈ centralizer ({t} : Set P) ⊓ R from
          ⟨(centralizer ({t} : Set P)).mul_mem
            ((centralizer ({t} : Set P)).inv_mem ht) hx, hr⟩)
      have hm := (W ⊔ zpowers t).mul_mem
        ((show zpowers t ≤ W ⊔ zpowers t from le_sup_right) (mem_zpowers t))
        ((show W ≤ W ⊔ zpowers t from le_sup_left) hw)
      simpa only [mul_inv_cancel_left] using hm
  · exact sup_le ((map_subtype_le _).trans (center_le_centralizer _))
      (zpowers_le.mpr ht)

/-- The distinguished outside centralizer is elementary of order eight. -/
public theorem centralizer_elementary_and_card
    (h : C4SquareCubicInvertingExtension C R a t)
    (hC : IsCriticalPSubgroup 2 C)
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4) :
    IsElementaryAbelian 2 (centralizer ({t} : Set P)) ∧
      Nat.card (centralizer ({t} : Set P)) = 8 := by
  let W := (omega₁ (center P) (p := 2)).map (center P).subtype
  let : IsElementaryAbelian 2 (omega₁ (center P) (p := 2)) :=
    IsElementaryAbelian.omega₁_of_isMulCommutative _
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.map_subtype
  have ht2 : t ^ 2 = 1 := h.outside_order ▸ pow_orderOf_eq_one t
  let : IsElementaryAbelian 2 (zpowers t) := IsElementaryAbelian.zpowers_of_pow_eq_one ht2
  have htW : t ∈ centralizer (W : Set P) := by
    intro w hw
    exact (mem_center_iff.mp (map_subtype_le _ hw) t).symm
  rw [h.centralizer_eq_omega_sup hC hno hZ]
  refine ⟨IsElementaryAbelian.sup_of_le_centralizer (zpowers_le.mpr htW), ?_⟩
  have hout : t ∉ W := by
    intro ht
    have hinf := h.centralizer_inf_core hC hno hZ
    change t ∈ (omega₁ (center P) (p := 2)).map (center P).subtype at ht
    exact h.outside_not_mem ((hinf.symm ▸ ht).2)
  rw [card_sup_zpowers_of_normalizing_involution W t ht2 hout
    (centralizer_le_normalizer _ htW)]
  change 2 * Nat.card W = 8
  rw [card_map_of_injective (center P).subtype_injective, hZ]

end C4SquareCubicInvertingExtension
