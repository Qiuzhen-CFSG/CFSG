module
public import Theory.GroupTheory.PGroup.ElementaryDihedralPlanes
public import Theory.GroupTheory.DisjointConjugateCenter
public import Theory.GroupTheory.DisjointCommutingProduct.Center

/-!
# Enlarging an elementary-by-dihedral group

Let M be an elementary-by-dihedral subgroup of N, and suppose that the
N-normalizer of every maximum elementary subgroup of M lies in M.
An involution y outside M which normalizes M and centralizes Z(M)
extends M to another elementary-by-dihedral group, with twice the
rotation order.

The normalizer condition makes y interchange the two reflection classes.
Thus (uy)² has full rotation order and uy has twice that order. The group
generated by u and y is dihedral. The old elementary central factor
commutes with it and misses its central involution, giving the actual
internal direct product by an order count.

Source: Aschbacher–Smith C.6.4, printed p.169, final paragraph. The
dihedral parameter here is the rotation order, half the group order.
-/

public noncomputable section
open Subgroup DihedralGroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
namespace Theory.GroupTheory.ElementaryDihedral
/-- The product of a central elementary coordinate and an odd rotation
has the full rotation order. -/
private theorem odd_rotation_order {E : Type*} [Group E] [IsElementaryAbelian 2 E]
    {n : ℕ} (hn : 1 ≤ n) (a : E) (j : ZMod (2 ^ n)) (hj : Odd j.val) :
    orderOf (a,r j) = 2 ^ n := by
  have hc : Nat.Coprime (2 ^ n) j.val := (Nat.coprime_two_left.mpr hj).pow_left n
  have hr : orderOf (r j) = 2 ^ n := by rw [orderOf_r,hc.gcd_eq_one,Nat.div_one]
  apply Nat.dvd_antisymm
  · apply orderOf_dvd_of_pow_eq_one
    apply Prod.ext
    · have ha : a ^ 2 = 1 := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 E) a
      have hp : 2 ^ n = 2 * 2 ^ (n - 1) := by rw [mul_comm,← pow_succ,Nat.sub_add_cancel hn]
      change a ^ (2 ^ n) = 1
      rw [hp,pow_mul,ha,one_pow]
    · change (r j) ^ (2 ^ n) = 1
      simpa only [hr] using pow_orderOf_eq_one (r j)
  · have hh := orderOf_dvd_of_pow_eq_one (congrArg Prod.snd (pow_orderOf_eq_one (a,r j)))
    simpa only [hr] using hh

/-- Taking the square root of a full even-order rotation doubles the
order. No ambient two-group hypothesis is required. -/
private theorem orderOf_eq_twice_of_square_order {G : Type*} [Group G] [Finite G]
    {n : ℕ} (hn : 1 ≤ n) (x : G) (hx : orderOf (x ^ 2) = 2 ^ n) :
    orderOf x = 2 ^ (n + 1) := by
  have hd : 2 ^ n ∣ orderOf x := hx ▸ orderOf_pow_dvd (x := x) 2
  have htwo : 2 ∣ orderOf x := (dvd_pow_self 2 (by omega : n ≠ 0)).trans hd
  have he := orderOf_pow_of_dvd (x := x) (by decide : 2 ≠ 0) htwo
  rw [hx] at he
  have h := Nat.div_mul_cancel htwo
  rw [← he] at h
  simpa only [pow_succ] using h.symm

/-- Two involutions whose product has order at least four generate the
actual dihedral group with that rotation order. -/
private theorem involution_pair_dihedral {G : Type*} [Group G]
    {n : ℕ} (hn : 2 ≤ n) (u y : G) (hu : u ^ 2 = 1) (hy : y ^ 2 = 1)
    (horder : orderOf (u*y) = 2 ^ n) :
    Nonempty ((zpowers (u*y) ⊔ zpowers y : Subgroup G) ≃* DihedralGroup (2 ^ n)) := by
  have hui : u⁻¹ = u := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hu)
  have hyi : y⁻¹ = y := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hy)
  have hi : y*(u*y)*y⁻¹ = (u*y)⁻¹ := by
    simp only [mul_inv_rev,hui,hyi,mul_assoc,← pow_two,hy,mul_one]
  have hout : y ∉ zpowers (u*y) := by
    intro h
    have hc : Commute y (u*y) := by
      obtain ⟨k,hk⟩ := h
      have hh := Commute.zpow_self (u*y) k
      exact (congrArg (fun z : G => Commute z (u*y)) hk).mp hh
    have hsq : (u*y)^2=1 := by
      have hinv : (u*y)=(u*y)⁻¹ := by
        rw [← hi,hc.eq,mul_inv_cancel_right]
      calc (u*y)^2 = (u*y) * (u*y) := pow_two _
        _ = (u*y) * (u*y)⁻¹ := congrArg (fun z => (u*y)*z) hinv
        _ = 1 := mul_inv_cancel _
    have hd := orderOf_dvd_of_pow_eq_one hsq
    rw [horder] at hd
    have hh := Nat.le_of_dvd (by decide : 0 < 2) hd
    have hp := Nat.pow_le_pow_right (by decide : 0 < (2:ℕ)) hn
    norm_num at hp
    omega
  exact (DihedralGroup.sup_zpowers_equiv_of_inversion (by positivity) (u*y) y horder hy hout hi).2

variable {G E : Type*} [Group G] [Finite G] [Group E] [Finite E]
  [IsElementaryAbelian 2 E]

omit [Finite G] [Finite E] [IsElementaryAbelian 2 E] in
private theorem model_center_iff (M : Subgroup G) {n : ℕ}
    (e : M ≃* E × DihedralGroup (2 ^ n)) (b : E × DihedralGroup (2 ^ n)) :
    (e.symm b : G) ∈ centerIn M ↔ b ∈ center (E × DihedralGroup (2 ^ n)) := by
  constructor
  · intro h
    apply mem_center_iff.mpr
    intro c
    have hh := h.2 (e.symm c) (e.symm c).property
    have hh' : e.symm c * e.symm b = e.symm b * e.symm c := Subtype.ext hh
    simpa only [map_mul,e.apply_symm_apply] using congrArg e hh'
  · intro h
    refine ⟨(e.symm b).property,?_⟩
    intro z hz
    exact congrArg Subtype.val (show (⟨z,hz⟩ : M) * e.symm b = e.symm b * ⟨z,hz⟩ from
      e.injective (by simpa only [map_mul,e.apply_symm_apply] using
        mem_center_iff.mp h (e ⟨z,hz⟩)))

private theorem reflection_zero_not_center {n : ℕ} (hn : 2 ≤ n) :
    (sr (0 : ZMod (2 ^ n))) ∉ center (DihedralGroup (2 ^ n)) := by
  rw [DihedralFrattini.center_eq_half hn]
  rintro ⟨k,hk⟩
  simp only [r_zpow] at hk
  cases hk

private theorem odd_reflection_of_normalizer_control (M N : Subgroup G) (hMN : M ≤ N)
    (hcontrol : ∀ A ∈ elementaryAbelianMaxSubgroups M,
      N ⊓ normalizer (A : Set G) ≤ M)
    {n : ℕ} (hn : 2 ≤ n) (e : M ≃* E × DihedralGroup (2 ^ n))
    (y : G) (hyN : y ∈ N) (hyn : y ∈ normalizer (M : Set G)) (hyM : y ∉ M) :
    ∃ a : E, ∃ j : ZMod (2 ^ n), Odd j.val ∧
      y * (e.symm (1,sr 0) : G) * y⁻¹ = (e.symm (a,sr j) : G) := by
  let f : E × DihedralGroup (2 ^ n) →* G := M.subtype.comp e.symm.toMonoidHom
  have hf : Function.Injective f := M.subtype_injective.comp e.symm.injective
  let u := f (1,sr 0)
  have huM : u ∈ M := (e.symm (1,sr 0)).property
  have hu2 : u ^ 2 = 1 := by
    dsimp [u]
    rw [← map_pow,show ((1 : E),sr (0 : ZMod (2^n))) ^ 2 = 1 by simp [pow_two],map_one]
  have huZ : u ∉ centerIn M := by
    intro h
    have hc := (model_center_iff M e (1,sr 0)).mp h
    rw [Subgroup.center_prod] at hc
    exact reflection_zero_not_center hn hc.2
  let vM : M := ⟨y*u*y⁻¹,(mem_normalizer_iff.mp hyn u).mp huM⟩
  have hv2 : vM ^ 2 = 1 := Subtype.ext (by
    change (MulAut.conj y u) ^ 2 = 1
    rw [← map_pow,hu2,map_one])
  have hvZ : (vM : G) ∉ centerIn M := by
    intro h
    apply huZ
    exact (mem_normalizer_iff.mp
      (normalizes_centerIn (S := M) (A := normalizer (M : Set G)) le_rfl hyn) u).mpr h
  generalize hab : e vM = ab
  obtain ⟨a,b⟩ := ab
  have he : y*u*y⁻¹ = f (a,b) := by
    exact congrArg (fun z : M => (z : G)) (by simpa only [e.symm_apply_apply] using congrArg e.symm hab)
  have hb2 : b ^ 2 = 1 := by
    have hh := congrArg (fun z : M => (e z).2) hv2
    simpa [hab] using hh
  cases b with
  | r j =>
    apply (hvZ ?_).elim
    change y*u*y⁻¹ ∈ centerIn M
    rw [he]
    apply (model_center_iff M e (a,r j)).mpr
    rw [Subgroup.center_prod,mem_prod,center_eq_top]
    refine ⟨mem_top _,mem_center_iff.mpr ?_⟩
    have hj : j + j = 0 := r.inj (by simpa only [pow_two,r_mul_r,one_def] using hb2)
    have hneg : -j = j := neg_eq_iff_add_eq_zero.mpr hj
    rintro (k | k)
    · simp only [r_mul_r,add_comm]
    · simp only [sr_mul_r,r_mul_sr,sub_eq_add_neg,hneg]
  | sr j =>
    refine ⟨a,j,?_,he⟩
    apply Nat.not_even_iff_odd.mp
    rintro ⟨k,hk⟩
    have hj : j = (k : ZMod (2^n)) + k := by
      rw [← Nat.cast_add,← hk,ZMod.natCast_zmod_val]
    let t := f (1,r (k : ZMod (2^n)))
    have htM : t ∈ M := (e.symm (1,r k)).property
    let g := t*y
    have hgN : g ∈ N := N.mul_mem (hMN htM) hyN
    have hgn : g ∈ normalizer (M : Set G) := (normalizer (M : Set G)).mul_mem
      (M.le_normalizer htM) hyn
    have hgM : g ∉ M := fun h => hyM ((M.mul_mem_cancel_left htM).mp h)
    have hgu : g*u*g⁻¹ = f (a,sr 0) := by
      calc g*u*g⁻¹ = t*(y*u*y⁻¹)*t⁻¹ := by simp only [g,mul_inv_rev,mul_assoc]
        _ = f (1,r k) * f (a,sr j) * (f (1,r k))⁻¹ := by rw [he]
        _ = f (a,sr 0) := by
          rw [← map_inv,← map_mul,← map_mul]
          congr 1
          apply Prod.ext
          · simp
          · change r (k : ZMod (2^n)) * sr j * (r k)⁻¹ = sr 0
            simp only [r_mul_sr,inv_r,sr_mul_r]
            congr 1
            rw [hj]
            ring
    let A := M ⊓ centralizer ({u} : Set G)
    have hA : A ∈ elementaryAbelianMaxSubgroups M :=
      involution_centralizer_max_ambient M hn e u huM hu2 huZ
    apply hgM
    apply hcontrol A hA
    refine ⟨hgN,mem_normalizer_iff_map_conj_eq.mpr ?_⟩
    apply eq_of_le_of_card_ge ?_ (by rw [card_map_of_injective (MulAut.conj g).injective])
    rintro z ⟨w,hw,rfl⟩
    have hzM : MulAut.conj g w ∈ M := (mem_normalizer_iff.mp hgn w).mp hw.1
    refine ⟨hzM,mem_centralizer_singleton_iff.mpr ?_⟩
    have hh := congrArg (MulAut.conj g) (mem_centralizer_singleton_iff.mp hw.2)
    have hcent : f (a,1) ∈ centerIn M := by
      apply (model_center_iff M e (a,1)).mpr
      rw [Subgroup.center_prod,mem_prod,center_eq_top]
      exact ⟨mem_top _,one_mem _⟩
    have hprod : f (a,sr 0) = f (a,1)*u := by
      rw [← map_mul]
      congr 1
      simp
    change (MulAut.conj g w) * u = u * (MulAut.conj g w)
    have hcc := hcent.2 (MulAut.conj g w) hzM
    have hhh : (MulAut.conj g w) * (f (a,1)*u) = (f (a,1)*u) * (MulAut.conj g w) := by
      simpa only [map_mul,MulAut.conj_apply,hgu,hprod] using hh
    rw [← mul_assoc,hcc,mul_assoc,mul_assoc] at hhh
    exact mul_left_cancel hhh

omit [Finite E] in
private theorem enlarge_of_odd_reflection (M : Subgroup G) {n : ℕ} (hn : 2 ≤ n)
    (e : M ≃* E × DihedralGroup (2 ^ n))
    (y : G) (hyn : y ∈ normalizer (M : Set G)) (hyM : y ∉ M) (hy2 : y ^ 2 = 1)
    (hyZ : y ∈ centralizer (centerIn M : Set G))
    (a : E) (j : ZMod (2 ^ n)) (hj : Odd j.val)
    (he : y * (e.symm (1,sr 0) : G) * y⁻¹ = (e.symm (a,sr j) : G)) :
    ∃ F : Subgroup G, IsElementaryAbelian 2 F ∧
      Nonempty ((M ⊔ zpowers y : Subgroup G) ≃* F × DihedralGroup (2 ^ (n+1))) := by
  let f : E × DihedralGroup (2 ^ n) →* G := M.subtype.comp e.symm.toMonoidHom
  have hf : Function.Injective f := M.subtype_injective.comp e.symm.injective
  let F : Subgroup G := ((⊤ : Subgroup E).prod ⊥).map f
  have hFM : F ≤ M := by
    rintro z ⟨b,hb,rfl⟩
    exact (e.symm b).property
  have hFZ : F ≤ centerIn M := by
    rintro z ⟨⟨b,c⟩,⟨_,hc⟩,rfl⟩
    have hc : c = 1 := hc
    subst c
    refine ⟨(e.symm (b,1)).property,?_⟩
    intro w hw
    have hh : Commute (e ⟨w,hw⟩) (b,1) := by
      exact Prod.ext (mul_comm _ _) (by simp)
    exact congrArg Subtype.val (show (⟨w,hw⟩ : M) * e.symm (b,1) = e.symm (b,1) * ⟨w,hw⟩ from
      e.injective (by simpa only [map_mul,e.apply_symm_apply] using hh.eq))
  have hFe : IsElementaryAbelian 2 F := by
    let : IsElementaryAbelian 2 ((⊤ : Subgroup E).prod (⊥ : Subgroup (DihedralGroup (2 ^ n)))) :=
      IsElementaryAbelian.of_injective (MonoidHom.fst E (DihedralGroup (2 ^ n)) |>.comp
        ((⊤ : Subgroup E).prod ⊥).subtype) (by
          rintro ⟨⟨a,b⟩,ha,hb⟩ ⟨⟨c,d⟩,hc,hd⟩ h
          apply Subtype.ext
          exact Prod.ext h ((show b = 1 from hb).trans (show d = 1 from hd).symm))
    exact IsElementaryAbelian.map f
  have hFc : Nat.card F = Nat.card E := by
    rw [card_map_of_injective hf,Nat.card_congr (prodEquiv _ _).toEquiv,Nat.card_prod,
      Nat.card_congr (topEquiv : (⊤ : Subgroup E) ≃* E).toEquiv]
    simp
  let u := f (1,sr 0)
  have huM : u ∈ M := (e.symm (1,sr 0)).property
  have hu2 : u ^ 2 = 1 := by
    dsimp [u]
    rw [← map_pow,show ((1 : E),sr (0 : ZMod (2^n))) ^ 2 = 1 by simp [pow_two],map_one]
  let x := u*y
  have hx2 : x ^ 2 = f (a,r j) := by
    have hyi : y⁻¹ = y := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hy2)
    change y*u*y⁻¹ = f (a,sr j) at he
    have he' : y*u*y = f (a,sr j) := by simpa only [hyi] using he
    calc x ^ 2 = u * (y*u*y) := by simp only [x,pow_two,mul_assoc]
      _ = f (1,sr 0) * f (a,sr j) := by rw [he']
      _ = f (a,r j) := by rw [← map_mul]; congr 1; simp [sr_mul_sr]
  have hrorder : orderOf (r j) = 2 ^ n := by
    rw [orderOf_r,((Nat.coprime_two_left.mpr hj).pow_left n).gcd_eq_one,Nat.div_one]
  have hxorder : orderOf x = 2 ^ (n+1) := by
    apply orderOf_eq_twice_of_square_order (by omega)
    rw [hx2,orderOf_injective f hf]
    exact odd_rotation_order (by omega) a j hj
  let D := zpowers x ⊔ zpowers y
  obtain ⟨eD⟩ := involution_pair_dihedral (by omega : 2 ≤ n+1) u y hu2 hy2 hxorder
  have hFD : F ≤ centralizer (D : Set G) := by
    apply le_centralizer_iff.mpr
    have hyF : y ∈ centralizer (F : Set G) := centralizer_le hFZ hyZ
    have huF : u ∈ centralizer (F : Set G) := (le_centralizer_iff.mp (hFZ.trans inf_le_right)) huM
    exact sup_le (zpowers_le.mpr ((centralizer (F : Set G)).mul_mem huF hyF))
      (zpowers_le.mpr hyF)
  let v := x ^ (2 ^ n)
  have hv2 : v ^ 2 = 1 := by
    dsimp [v]
    rw [← pow_mul,← pow_succ,← hxorder,pow_orderOf_eq_one]
  have hvorder : orderOf v = 2 := by
    dsimp [v]
    rw [orderOf_pow_of_dvd (by positivity) (by rw [hxorder,pow_succ]; exact dvd_mul_right _ _),
      hxorder,pow_succ,Nat.mul_div_right _ (by positivity)]
  have hvF : v ∉ F := by
    have hv : v = f ((a,r j) ^ (2 ^ (n-1))) := by
      dsimp [v]
      calc x ^ (2 ^ n) = x ^ (2 * 2 ^ (n-1)) := congrArg (x ^ ·) (by
        rw [mul_comm,← pow_succ,Nat.sub_add_cancel (by omega)])
           _ = f ((a,r j) ^ (2 ^ (n-1))) := by rw [pow_mul,hx2,← map_pow]
    rw [hv]
    rintro ⟨b,hb,hbval⟩
    have hb2 := congrArg Prod.snd (hf hbval)
    have hh : (r j) ^ (2 ^ (n-1)) = 1 := hb2.symm.trans hb.2
    have hd := orderOf_dvd_of_pow_eq_one hh
    rw [hrorder] at hd
    have hle := Nat.le_of_dvd (by positivity : 0 < 2 ^ (n-1)) hd
    have heq : 2 ^ n = 2 ^ (n-1) * 2 := by rw [← pow_succ,Nat.sub_add_cancel (by omega)]
    have hp : 0 < 2 ^ (n-1) := by positivity
    omega
  have hvZ : v ∈ D ⊓ centralizer (D : Set G) := by
    refine ⟨mem_sup_left (pow_mem (mem_zpowers x) _),?_⟩
    suffices h : D ≤ centralizer ({v} : Set G) from fun z hz =>
      mem_centralizer_singleton_iff.mp (h hz)
    apply sup_le
    · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr (Commute.self_pow x _).eq)
    · apply zpowers_le.mpr
      apply mem_centralizer_singleton_iff.mpr
      have hui : u⁻¹ = u := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hu2)
      have hyi : y⁻¹ = y := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hy2)
      have hi : y*x*y⁻¹ = x⁻¹ := by
        dsimp [x]
        simp only [mul_inv_rev,hui,hyi,mul_assoc,← pow_two,hy2,mul_one]
      have hvi : v⁻¹ = v := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hv2)
      have hh : y*v*y⁻¹ = v := by
        change MulAut.conj y (x ^ (2 ^ n)) = v
        rw [map_pow,MulAut.conj_apply,hi,inv_pow]
        exact hvi
      exact mul_inv_eq_iff_eq_mul.mp hh
  have hZ : D ⊓ centralizer (D : Set G) = zpowers v := by
    apply (eq_of_le_of_card_ge (zpowers_le.mpr hvZ) ?_).symm
    rw [show D ⊓ centralizer (D : Set G) = centerIn D from rfl,
      centerIn_eq_map_center,card_map_of_injective D.subtype_injective,
      DihedralGroup.center_card_of_equiv (by omega) eD,Nat.card_zpowers,hvorder]
  have hdis : Disjoint F D := by
    have hd := disjoint_zpowers_of_prime_order_not_mem F v hvorder hvF
    apply disjoint_def.mpr
    intro z hzF hzD
    apply disjoint_def.mp hd hzF
    rw [← hZ]
    exact ⟨hzD,hFD hzF⟩
  let N := M ⊔ zpowers y
  have hDN : D ≤ N := sup_le
    (zpowers_le.mpr (N.mul_mem (mem_sup_left huM) (mem_sup_right (mem_zpowers y)))) le_sup_right
  have hN : F ⊔ D = N := by
    apply eq_of_le_of_card_ge (sup_le (hFM.trans le_sup_left) hDN)
    rw [card_sup_eq_mul_of_normalizes_of_disjoint _ _
      ((le_centralizer_iff.mp hFD).trans (Subgroup.centralizer_le_normalizer _)) hdis,
      hFc,Nat.card_congr eD.toEquiv,DihedralGroup.nat_card]
    rw [card_sup_zpowers_of_normalizing_involution M y hy2 hyM hyn,
      Nat.card_congr e.toEquiv,Nat.card_prod,DihedralGroup.nat_card,pow_succ]
    exact le_of_eq (by ring)
  obtain ⟨eprod,_⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting F D hdis hFD
  exact ⟨F,hFe,⟨(MulEquiv.subgroupCongr hN.symm).trans
    (eprod.symm.trans (MulEquiv.prodCongr (MulEquiv.refl F) eD))⟩⟩

/-- An external involution fixing the center doubles the dihedral factor,
provided all maximum elementary normalizers are confined to the old group. -/
theorem enlarge_of_normalizer_control (M N : Subgroup G) (hMN : M ≤ N)
    (hcontrol : ∀ A ∈ elementaryAbelianMaxSubgroups M,
      N ⊓ normalizer (A : Set G) ≤ M)
    {n : ℕ} (hn : 2 ≤ n) (e : M ≃* E × DihedralGroup (2 ^ n))
    (y : G) (hyN : y ∈ N) (hyn : y ∈ normalizer (M : Set G))
    (hyM : y ∉ M) (hy2 : y ^ 2 = 1)
    (hyZ : y ∈ centralizer (centerIn M : Set G)) :
    ∃ F : Subgroup G, IsElementaryAbelian 2 F ∧
      Nonempty ((M ⊔ zpowers y : Subgroup G) ≃* F × DihedralGroup (2 ^ (n+1))) := by
  obtain ⟨a,j,hj,he⟩ := odd_reflection_of_normalizer_control M N hMN hcontrol hn e y hyN hyn hyM
  exact enlarge_of_odd_reflection M hn e y hyn hyM hy2 hyZ a j hj he

end Theory.GroupTheory.ElementaryDihedral
