module

public import Theory.GroupTheory.PGroup.ExtraspecialInvolution
public import Theory.GroupTheory.PGroup.BinaryModular
public import Theory.GroupTheory.PGroup.OmegaImage
public import Theory.GroupTheory.PGroup.BinaryHallFactorAutomorphisms
public import Theory.GroupTheory.SpecificGroups.QuaternionCentralSquareEmbedding

/-!
# Characteristic products with large rotation subgroups

An exponent-four factor commuting with a cyclic subgroup of order at least
eight lies in the subgroup generated by elements with nontrivial fourth
power: multiply each element of the factor by a rotation generator. If the
remaining elements of the tail have fourth power one, this identifies the
rotation product intrinsically and proves characteristicity in the whole
ambient group.

The tail's centralizer bound for its order-four rotation subgroup also lifts
through the commuting product. These lemmas separate ambient characteristicity
from the rotation calculations in quaternion, dihedral, and semidihedral groups.
In each family the rotations are characteristic of index two, and central
elements square to one. A rotation commuting with an outside element is central;
this proves that outside elements have fourth power one and cannot centralize
an order-four rotation. No ambient rank or extraspecial order bound is needed.

Source motivation: Janko–Thompson, Math. Z. 113 (1970), §4, p.392, Case 1.
The intrinsic fourth-power generation argument supplies the characteristicity
step without assuming that the tail factor is characteristic.
-/

namespace Subgroup

/-- A commuting product with an exponent-four factor is generated by the
elements with nontrivial fourth powers when its cyclic rotation subgroup has
order at least eight and all elements outside the rotations have fourth power one. -/
public theorem sup_eq_closure_nontrivial_fourth_powers
    {P : Type*} [Group P] [Finite P]
    (A D B : Subgroup P) [D.Normal] [IsCyclic B]
    (hA : ∀ a ∈ A, a ^ 4 = (1 : P))
    (hc : D ≤ centralizer (A : Set P)) (hg : A ⊔ D = ⊤)
    (hBD : B ≤ D) (hB : 8 ≤ Nat.card B)
    (hout : ∀ d ∈ D, d ∉ B → d ^ 4 = (1 : P)) :
    A ⊔ B = closure {x : P | x ^ 4 ≠ 1} := by
  let H := closure {x : P | x ^ 4 ≠ 1}
  obtain ⟨b, hb⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top B).mp inferInstance
  have hbB : b ∈ B := hb ▸ mem_zpowers b
  have hb4 : b ^ 4 ≠ 1 := by
    intro he
    have hord : 8 ≤ orderOf b := by simpa only [← hb, Nat.card_zpowers] using hB
    have := Nat.le_of_dvd (by decide : 0 < 4) (orderOf_dvd_of_pow_eq_one he)
    omega
  have hbH : b ∈ H := subset_closure hb4
  have hBH : B ≤ H := by rw [← hb]; exact zpowers_le.mpr hbH
  apply le_antisymm
  · apply sup_le _ hBH
    intro a ha
    have hab : Commute a b := hc (hBD hbB) a ha
    have habH : a * b ∈ H := subset_closure (by
      change (a * b) ^ 4 ≠ 1
      rw [hab.mul_pow, hA a ha, one_mul]
      exact hb4)
    simpa using H.mul_mem habH (H.inv_mem hbH)
  · apply (closure_le _).mpr
    intro x hx
    obtain ⟨a, ha, d, hd, rfl⟩ := mem_sup_of_normal_right.mp
      (show x ∈ A ⊔ D by rw [hg]; trivial)
    have had : Commute a d := hc hd a ha
    have hdB : d ∈ B := by
      by_contra hn
      exact hx (by rw [had.mul_pow, hA a ha, hout d hd hn, one_mul])
    exact mul_mem_sup ha hdB

/-- The rotation product is characteristic in the full ambient group. -/
public theorem characteristic_sup_of_fourth_power_rotation
    {P : Type*} [Group P] [Finite P]
    (A D B : Subgroup P) [D.Normal] [IsCyclic B]
    (hA : ∀ a ∈ A, a ^ 4 = (1 : P))
    (hc : D ≤ centralizer (A : Set P)) (hg : A ⊔ D = ⊤)
    (hBD : B ≤ D) (hB : 8 ≤ Nat.card B)
    (hout : ∀ d ∈ D, d ∉ B → d ^ 4 = (1 : P)) :
    (A ⊔ B).Characteristic := by
  rw [sup_eq_closure_nontrivial_fourth_powers A D B hA hc hg hBD hB hout]
  apply characteristic_iff_le_comap.mpr
  intro f
  apply (closure_le _).mpr
  intro x hx
  apply Subgroup.subset_closure
  change (f x) ^ 4 ≠ 1
  intro he
  apply hx
  apply f.injective
  simpa only [map_pow, map_one] using he


-- Transport a rotation subgroup from the tail into the full central product.
private theorem lift_rotation
    {P : Type*} [Group P] [Finite P]
    (A D : Subgroup P) [D.Normal] [IsExtraspecial 2 A]
    (hc : D ≤ centralizer (A : Set P)) (hg : A ⊔ D = ⊤)
    (R : Subgroup D) [R.Characteristic] [IsCyclic R]
    (hR : 8 ≤ Nat.card R)
    (hout : ∀ d : D, d ∉ R → d ^ 4 = 1)
    (hcent : centralizer (((omega R (p := 2) 2).map R.subtype : Subgroup D) : Set D) ≤ R) :
    ∃ B : Subgroup P, B.Normal ∧ IsCyclic B ∧ 8 ≤ Nat.card B ∧ B ≤ D ∧
      (∀ d ∈ D, d ∉ B → d ^ 4 = (1 : P)) ∧
      centralizer (((omega B (p := 2) 2).map B.subtype : Subgroup P) : Set P) ≤ A ⊔ B := by
  let B := R.map D.subtype
  let e : R ≃* B := R.equivMapOfInjective D.subtype D.subtype_injective
  let : IsCyclic B := e.isCyclic.mp inferInstance
  have hBD : B ≤ D := map_subtype_le R
  refine ⟨B, inferInstance, inferInstance, ?_, hBD, ?_, ?_⟩
  · rw [← Nat.card_congr e.toEquiv]
    exact hR
  · intro d hd hn
    exact congrArg Subtype.val (hout ⟨d, hd⟩ (fun hh => hn ⟨⟨d, hd⟩, hh, rfl⟩))
  · let W := (omega B (p := 2) 2).map B.subtype
    have hW : W = ((omega R (p := 2) 2).map R.subtype).map D.subtype := by
      rw [map_map]
      apply (map_omega_eq_of_injective_of_range_eq
        (D.subtype.comp R.subtype) B.subtype
        (D.subtype_injective.comp R.subtype_injective) B.subtype_injective ?_ 2 2).symm
      rw [MonoidHom.range_comp, R.range_subtype, B.range_subtype]
    have hDC : D ⊓ centralizer (W : Set P) ≤ B := by
      intro x hx
      refine ⟨⟨x, hx.1⟩, hcent ?_, rfl⟩
      intro y hy
      apply Subtype.ext
      exact hx.2 y (hW.symm ▸ mem_map_of_mem D.subtype hy)
    rw [centralizer_eq_sup_inf_of_centralizing_sup_eq_top A D W hg hc
      ((map_subtype_le _).trans hBD)]
    exact sup_le_sup_left hDC A

/-- If every square lies in the rotation squares, and the centralizer of a
generator of those squares is the rotations, then the rotations are characteristic. -/
public theorem characteristic_zpowers_of_squares_and_centralizer
    {D : Type*} [Group D] (r : D)
    (hsq : ∀ d : D, d ^ 2 ∈ zpowers (r ^ 2))
    (hcent : centralizer ({r ^ 2} : Set D) ≤ zpowers r) :
    (zpowers r).Characteristic := by
  let : (zpowers (r ^ 2)).Characteristic := by
    apply characteristic_iff_le_comap.mpr
    intro f
    apply zpowers_le.mpr
    change f (r ^ 2) ∈ zpowers (r ^ 2)
    rw [map_pow]
    exact hsq (f r)
  have heq : centralizer (zpowers (r ^ 2) : Set D) = zpowers r := by
    apply le_antisymm
    · intro x hx
      apply hcent
      exact mem_centralizer_singleton_iff.mpr (hx (r ^ 2) (mem_zpowers _)).symm
    · exact (zpowers r).le_centralizer.trans
        (centralizer_le (zpowers_le.mpr (pow_mem (mem_zpowers r) 2)))
  rw [← heq]
  infer_instance

/-- A large characteristic cyclic rotation subgroup in a normal Hall tail gives
an ambient normal cyclic subgroup whose product with an extraspecial factor is
characteristic. Its order-four centralizer bound lifts to the ambient group. -/
public theorem exists_characteristic_rotation_product_of_tail_rotation
    {P : Type*} [Group P] [Finite P]
    (A D : Subgroup P) [D.Normal] [IsExtraspecial 2 A]
    (hc : D ≤ centralizer (A : Set P)) (hg : A ⊔ D = ⊤)
    (R : Subgroup D) [R.Characteristic] [IsCyclic R]
    (hR : 8 ≤ Nat.card R)
    (hout : ∀ d : D, d ∉ R → d ^ 4 = 1)
    (hcent : centralizer (((omega R (p := 2) 2).map R.subtype : Subgroup D) : Set D) ≤ R) :
    ∃ B : Subgroup P, B.Normal ∧ IsCyclic B ∧ 8 ≤ Nat.card B ∧ B ≤ D ∧
      (A ⊔ B).Characteristic ∧
      centralizer (((omega B (p := 2) 2).map B.subtype : Subgroup P) : Set P) ≤ A ⊔ B := by
  obtain ⟨B, hBn, hBc, hB, hBD, houtB, hcentB⟩ :=
    lift_rotation A D hc hg R hR hout hcent
  let : IsCyclic B := hBc
  refine ⟨B, hBn, hBc, hB, hBD, ?_, hcentB⟩
  apply characteristic_sup_of_fourth_power_rotation A D B _ hc hg hBD hB houtB
  intro a ha
  exact congrArg Subtype.val (IsExtraspecial.pow_four_eq_one (⟨a, ha⟩ : A))

end Subgroup

open Subgroup

private theorem central_of_commute_outside {G : Type*} [Group G]
    (R : Subgroup G) [IsCyclic R] (hi : R.index = 2)
    {d z : G} (hd : d ∉ R) (hz : z ∈ R) (hc : Commute z d) :
    z ∈ center G := by
  apply mem_center_iff.mpr
  intro x
  by_cases hx : x ∈ R
  · exact R.le_centralizer hz x hx
  · have hy : x * d⁻¹ ∈ R := (R.mul_mem_iff_of_index_two hi).mpr (by simpa using iff_of_false hx hd)
    have hh : Commute z (x * d⁻¹) := R.le_centralizer hy z hz
    have he := hh.mul_right hc
    simpa using he.symm.eq

private theorem tail_bounds {G : Type*} [Group G] [Finite G]
    (hP : IsPGroup 2 G) (R : Subgroup G) [IsCyclic R]
    (hi : R.index = 2) (hR : 8 ≤ Nat.card R)
    (hZ : ∀ z ∈ center G, z ^ 2 = (1 : G)) :
    (∀ d : G, d ∉ R → d ^ 4 = 1) ∧
    centralizer (((omega R (p := 2) 2).map R.subtype : Subgroup G) : Set G) ≤ R := by
  constructor
  · intro d hd
    have hs := central_of_commute_outside R hi hd (R.sq_mem_of_index_two hi d)
      (Commute.self_pow d 2).symm
    simpa only [← pow_mul] using hZ (d ^ 2) hs
  · obtain ⟨r, hr⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := R)
    obtain ⟨k, hk⟩ := (hP.to_subgroup R).exists_card_eq
    have hk3 : 3 ≤ k := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp (hk ▸ hR)
    have hdiv : 4 ∣ orderOf r := by rw [hr, hk]; exact Nat.pow_dvd_pow 2 (by omega : 2 ≤ k)
    let w : R := r ^ (orderOf r / 4)
    have hw : orderOf w = 4 := orderOf_pow_orderOf_div (orderOf_pos r).ne' hdiv
    have hwO : w ∈ omega R (p := 2) 2 := by
      apply Subgroup.subset_closure
      change w ^ (2 ^ 2) = 1
      norm_num
      rw [← hw]
      exact pow_orderOf_eq_one w
    have hwW : (w : G) ∈ (omega R (p := 2) 2).map R.subtype :=
      mem_map_of_mem R.subtype hwO
    intro d hd
    by_contra hn
    have hwZ : (w : G) ∈ center G :=
      central_of_commute_outside R hi hn w.property (hd w hwW)
    have hs : w ^ 2 = 1 := Subtype.ext (hZ w hwZ)
    have := orderOf_dvd_of_pow_eq_one hs
    rw [hw] at this
    norm_num at this

private theorem index_two_rotation_map {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (R : Subgroup G) [R.Characteristic] [IsCyclic R]
    (hi : R.index = 2) (hR : 8 ≤ Nat.card R)
    (hZ : ∀ z ∈ center G, z ^ 2 = (1 : G)) :
    ∃ S : Subgroup H, S.Characteristic ∧ IsCyclic S ∧ S.index = 2 ∧
      8 ≤ Nat.card S ∧ ∀ z ∈ center H, z ^ 2 = (1 : H) := by
  let S := R.map (e : G →* H)
  have he := e.subgroupMap R
  refine ⟨S, ?_, he.isCyclic.mp inferInstance, ?_, ?_, ?_⟩
  · apply characteristic_iff_le_comap.mpr
    intro f x hx
    obtain ⟨y, hy, rfl⟩ := hx
    refine ⟨e.symm (f (e y)), ?_, by simp⟩
    exact characteristic_iff_le_comap.mp inferInstance
      ((e.trans f).trans e.symm) hy
  · simpa [S] using hi
  · change 8 ≤ Nat.card (R.map (e : G →* H))
    rw [← Nat.card_congr he.toEquiv]
    exact hR
  · intro z hz
    obtain ⟨z, rfl⟩ := e.surjective z
    have hz' : z ∈ center G := mem_center_iff.mpr (by
      intro x
      apply e.injective
      simpa only [map_mul] using mem_center_iff.mp hz (e x))
    simpa only [map_pow, map_one] using congrArg e (hZ z hz')

private theorem quaternion_rotation_data {m : ℕ} (hm : 4 ≤ m) :
    ∃ R : Subgroup (QuaternionGroup m), R.Characteristic ∧ IsCyclic R ∧
      R.index = 2 ∧ 8 ≤ Nat.card R ∧
      ∀ z ∈ center (QuaternionGroup m), z ^ 2 = (1 : QuaternionGroup m) := by
  let : NeZero m := ⟨by omega⟩
  let R := zpowers (QuaternionGroup.a 1 : QuaternionGroup m)
  have hcard : Nat.card R = 2 * m := by rw [Nat.card_zpowers, QuaternionGroup.orderOf_a_one]
  refine ⟨R, ?_, inferInstance, ?_, by omega, ?_⟩
  · apply characteristic_iff_le_comap.mpr
    intro f
    apply zpowers_le.mpr
    change f (QuaternionGroup.a 1) ∈ R
    have hord := f.orderOf_eq (QuaternionGroup.a 1)
    cases he : f (QuaternionGroup.a 1) with
    | a i =>
      have h := pow_mem (mem_zpowers (QuaternionGroup.a 1 : QuaternionGroup m)) i.val
      simpa only [QuaternionGroup.a_one_pow, ZMod.natCast_zmod_val] using h
    | xa i =>
      rw [he, QuaternionGroup.orderOf_xa, QuaternionGroup.orderOf_a_one] at hord
      omega
  · have h := R.index_mul_card
    rw [hcard, Nat.card_eq_fintype_card, QuaternionGroup.card] at h
    nlinarith
  · exact QuaternionGroup.sq_eq_one_of_mem_center (by omega)

private theorem dihedral_rotation_data {m : ℕ} (hm : 8 ≤ m) :
    ∃ R : Subgroup (DihedralGroup m), R.Characteristic ∧ IsCyclic R ∧
      R.index = 2 ∧ 8 ≤ Nat.card R ∧
      ∀ z ∈ center (DihedralGroup m), z ^ 2 = (1 : DihedralGroup m) := by
  let : NeZero m := ⟨by omega⟩
  let R := zpowers (DihedralGroup.r 1 : DihedralGroup m)
  have hcard : Nat.card R = m := by rw [Nat.card_zpowers, DihedralGroup.orderOf_r_one]
  refine ⟨R, DihedralGroup.rotations_characteristic (by omega), inferInstance,
    ?_, by omega, ?_⟩
  · have h := R.index_mul_card
    rw [hcard, DihedralGroup.nat_card] at h
    exact Nat.eq_of_mul_eq_mul_right (by omega : 0 < m) h
  · intro z hz
    cases z with
    | r i =>
      have hi : i = -i := by simpa using mem_center_iff.mp hz (DihedralGroup.sr 0)
      simp only [pow_two, DihedralGroup.r_mul_r, DihedralGroup.one_def]
      congr 1
      linear_combination hi
    | sr i => simp only [pow_two, DihedralGroup.sr_mul_self]

private theorem semidihedral_rotation_data {G : Type*} [Group G] [Finite G]
    {n : ℕ} (hn : 4 ≤ n) (hcard : Nat.card G = 2 ^ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : closure ({a, b} : Set G) = ⊤) :
    ∃ R : Subgroup G, R.Characteristic ∧ IsCyclic R ∧ R.index = 2 ∧
      8 ≤ Nat.card R ∧ ∀ z ∈ center G, z ^ 2 = (1 : G) := by
  let R := zpowers a
  have hR : Nat.card R = 2 ^ (n - 1) := by rw [Nat.card_zpowers, ha]
  refine ⟨R, Semidihedral.rotations_characteristic hn a b ha hb hconj hgen,
    inferInstance, ?_, ?_, ?_⟩
  · have h := R.index_mul_card
    have hp : 2 ^ n = 2 * 2 ^ (n - 1) := by
      conv_lhs => rw [show n = (n - 1) + 1 by omega, pow_succ]
      omega
    rw [hR, hcard, hp] at h
    exact Nat.eq_of_mul_eq_mul_right (by positivity : 0 < 2 ^ (n - 1)) h
  · rw [hR]
    exact Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : 3 ≤ n - 1)
  · intro z hz
    rw [Semidihedral.center_eq hn a b ha hb hconj hgen] at hz
    obtain ⟨i, rfl⟩ := hz
    have hs : (a ^ (2 ^ (n - 2))) ^ 2 = 1 := by
      rw [← pow_mul, ← pow_succ, show n - 2 + 1 = n - 1 by omega, ← ha]
      exact pow_orderOf_eq_one a
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hs, one_zpow]

/-- Every large noncyclic binary Hall factor has a characteristic cyclic subgroup
of index two and order at least eight. Its central elements square to one.
This follows from the quaternion, dihedral, and semidihedral rotation models;
no separate two-group hypothesis is needed. -/
public theorem IsBinaryHallFactor.exists_characteristic_cyclic_index_two
    {D : Type*} [Group D] [Finite D]
    (hD : IsBinaryHallFactor D) (hnc : ¬ IsCyclic D) (hlarge : 16 ≤ Nat.card D) :
    ∃ R : Subgroup D, R.Characteristic ∧ IsCyclic R ∧ R.index = 2 ∧
      8 ≤ Nat.card R ∧ ∀ z ∈ center D, z ^ 2 = (1 : D) := by
  rcases hD with hcyc | ⟨n, hn, ⟨e⟩⟩ | ⟨m, ⟨e⟩⟩ | ⟨n, hn, hc, a, b, ha, hb, hr, hg⟩
  · exact (hnc hcyc).elim
  · have hc : Nat.card D = 4 * 2 ^ (n - 2) := by
      rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
    obtain ⟨R, hRc, hRcyc, hi, hR, hZ⟩ := quaternion_rotation_data (by omega : 4 ≤ 2 ^ (n - 2))
    let : R.Characteristic := hRc
    let : IsCyclic R := hRcyc
    exact index_two_rotation_map e.symm R hi hR hZ
  · have hc : Nat.card D = 2 * m := (Nat.card_congr e.toEquiv).trans DihedralGroup.nat_card
    obtain ⟨R, hRc, hRcyc, hi, hR, hZ⟩ := dihedral_rotation_data (by omega : 8 ≤ m)
    let : R.Characteristic := hRc
    let : IsCyclic R := hRcyc
    exact index_two_rotation_map e.symm R hi hR hZ
  · exact semidihedral_rotation_data hn hc a b ha hb hr hg

/-- A large noncyclic binary Hall two-group has characteristic cyclic rotations
of index two and order at least eight. The same rotations contain the centralizer
of their order-four subgroup, and every outside element has fourth power one. -/
public theorem IsBinaryHallFactor.exists_characteristic_large_rotation_index_two
    {D : Type*} [Group D] [Finite D]
    (hP : IsPGroup 2 D) (hD : IsBinaryHallFactor D) (hnc : ¬ IsCyclic D)
    (hlarge : 16 ≤ Nat.card D) :
    ∃ R : Subgroup D, R.Characteristic ∧ IsCyclic R ∧ R.index = 2 ∧ 8 ≤ Nat.card R ∧
      (∀ d : D, d ∉ R → d ^ 4 = 1) ∧
      centralizer (((omega R (p := 2) 2).map R.subtype : Subgroup D) : Set D) ≤ R := by
  obtain ⟨R, hRc, hRcyc, hi, hR, hZ⟩ := hD.exists_characteristic_cyclic_index_two hnc hlarge
  let : IsCyclic R := hRcyc
  obtain ⟨hout, hcent⟩ := tail_bounds hP R hi hR hZ
  exact ⟨R, hRc, hRcyc, hi, hR, hout, hcent⟩

/-- A large noncyclic binary Hall two-group has characteristic cyclic rotations
of order at least eight. Outside elements have fourth power one, and the
centralizer of the order-four rotation subgroup is contained in the rotations. -/
public theorem IsBinaryHallFactor.exists_characteristic_large_rotation {D : Type*} [Group D] [Finite D]
    (hP : IsPGroup 2 D) (hD : IsBinaryHallFactor D) (hnc : ¬ IsCyclic D)
    (hlarge : 16 ≤ Nat.card D) :
    ∃ R : Subgroup D, R.Characteristic ∧ IsCyclic R ∧ 8 ≤ Nat.card R ∧
      (∀ d : D, d ∉ R → d ^ 4 = 1) ∧
      centralizer (((omega R (p := 2) 2).map R.subtype : Subgroup D) : Set D) ≤ R := by
  obtain ⟨R, hRc, hRcyc, _, hR, hout, hcent⟩ :=
    exists_characteristic_large_rotation_index_two hP hD hnc hlarge
  exact ⟨R, hRc, hRcyc, hR, hout, hcent⟩

/-- In a central product with an extraspecial two-group, a large noncyclic Hall
factor supplies normal cyclic rotations whose product with the extraspecial
factor is characteristic in the whole group. The centralizer of the order-four
rotations is contained in this characteristic product. -/
public theorem Subgroup.exists_characteristic_rotation_product_of_large_hall
    {P : Type*} [Group P] [Finite P]
    (hP : IsPGroup 2 P) (A D : Subgroup P) [D.Normal] [IsExtraspecial 2 A]
    (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ Subgroup.centralizer (A : Set P)) (hg : A ⊔ D = ⊤)
    (hlarge : 16 ≤ Nat.card D) :
    ∃ B : Subgroup P, B.Normal ∧ IsCyclic B ∧ 8 ≤ Nat.card B ∧ B ≤ D ∧
      (A ⊔ B).Characteristic ∧
      Subgroup.centralizer (((omega B (p := 2) 2).map B.subtype : Subgroup P) : Set P) ≤ A ⊔ B := by
  obtain ⟨R, hRc, hRcyc, hR, hout, hcent⟩ :=
    IsBinaryHallFactor.exists_characteristic_large_rotation (hP.to_subgroup D) hD hn hlarge
  let : R.Characteristic := hRc
  let : IsCyclic R := hRcyc
  exact Subgroup.exists_characteristic_rotation_product_of_tail_rotation
    A D hc hg R hR hout hcent
