module
public import Mathlib.GroupTheory.Commutator.Basic
public import Theory.GroupTheory.PGroup.NormalSubgroups

/-!
# Centralization in a center-free group generated by three subgroups

Let A be center-free and generated by X, Y and a finite two-subgroup Q.
A subgroup W of Q, normal in Q and centralizing X and Y, is trivial: a
nontrivial W would meet the center of Q and hence the center of A.

Apply this to W = [H,Q]. If H centralizes a defect subgroup N containing
[Q,X] and [Q,Y], while [H,X] and [H,Y] centralize Q, the three-subgroups
lemma shows that W centralizes X and Y. Thus H centralizes Q.

This is the group-theoretic step used to eliminate the bad middle-core seed
in Delgado--Goldschmidt--Stellmacher, Groups and Graphs (1985), Part II,
(12.1)(d--f) and (12.3), printed pp.178--180.
-/

public noncomputable section
open scoped commutatorElement

namespace Subgroup
variable {G : Type*} [Group G]

/-- A normal subgroup of the finite two-subgroup that centralizes the other
generators of a center-free group is trivial. -/
theorem normal_core_subgroup_eq_bot
    (A Q W X Y : Subgroup G) [Finite Q]
    (hp : IsPGroup 2 Q) (hWQ : W ≤ Q) (hQA : Q ≤ A)
    (hn : Q ≤ normalizer (W : Set G))
    (hgen : A = (X ⊔ Y) ⊔ Q) (hz : center A = ⊥)
    (hWX : W ≤ centralizer (X : Set G))
    (hWY : W ≤ centralizer (Y : Set G)) : W = ⊥ := by
  classical
  by_contra hne
  let : (W.subgroupOf Q).Normal := normal_subgroupOf_of_le_normalizer hn
  let : Nontrivial W := (nontrivial_iff_ne_bot W).mpr hne
  let : Nontrivial (W.subgroupOf Q) := (subgroupOfEquivOfLe hWQ).toEquiv.nontrivial
  let : Fact (IsPGroup 2 Q) := ⟨hp⟩
  obtain ⟨w, hwne, hwc⟩ := exists_nontrivial_center_mem_normal (W.subgroupOf Q) (p := 2)
  have hwW : ((w : Q) : G) ∈ W := w.property
  have hwQ : ((w : Q) : G) ∈ Q := (w : Q).property
  have hwcent : ((w : Q) : G) ∈ centralizer (Q : Set G) := by
    intro q hq
    exact congrArg Subtype.val ((mem_center_iff.mp hwc) ⟨q,hq⟩)
  have hAc : A ≤ centralizer ({((w : Q) : G)} : Set G) := by
    rw [hgen]
    apply sup_le (sup_le ?_ ?_) ?_
    · intro a ha
      exact mem_centralizer_singleton_iff.mpr ((hWX hwW) a ha)
    · intro a ha
      exact mem_centralizer_singleton_iff.mpr ((hWY hwW) a ha)
    · intro a ha
      exact mem_centralizer_singleton_iff.mpr (hwcent a ha)
  have hwcA : (⟨((w : Q) : G), hQA hwQ⟩ : A) ∈ center A := by
    apply mem_center_iff.mpr
    intro a
    exact Subtype.ext (mem_centralizer_singleton_iff.mp (hAc a.property))
  have hwoneA : (⟨((w : Q) : G), hQA hwQ⟩ : A) = 1 := by
    apply mem_bot.mp
    rwa [← hz]
  have hwone : ((w : Q) : G) = 1 := congrArg Subtype.val hwoneA
  exact hwne (Subtype.ext (Subtype.ext hwone))

/-- Centralization of the defect subgroup forces centralization of the whole
two-core, when the other generators act through a core-central layer. -/
theorem centralizes_core_of_centralizing_defect
    (A Q H N X Y Z : Subgroup G) [Finite Q]
    (hp : IsPGroup 2 Q) (hHQ : H ≤ Q) (hQA : Q ≤ A)
    (hgen : A = (X ⊔ Y) ⊔ Q) (hz : center A = ⊥)
    (hZQ : Z ≤ centralizer (Q : Set G))
    (hHX : ⁅H,X⁆ ≤ Z) (hHY : ⁅H,Y⁆ ≤ Z)
    (hQX : ⁅Q,X⁆ ≤ N) (hQY : ⁅Q,Y⁆ ≤ N)
    (hHN : ⁅H,N⁆ = ⊥) : H ≤ centralizer (Q : Set G) := by
  have hNcentral : N ≤ centralizer (H : Set G) :=
    le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hHN)
  have hx : ⁅⁅H,Q⁆,X⁆ = ⊥ :=
    commutator_commutator_eq_bot_of_rotate
      (commutator_eq_bot_iff_le_centralizer.mpr (hQX.trans hNcentral))
      (commutator_eq_bot_iff_le_centralizer.mpr
        ((by rwa [commutator_comm] : ⁅X,H⁆ ≤ Z).trans hZQ))
  have hy : ⁅⁅H,Q⁆,Y⁆ = ⊥ :=
    commutator_commutator_eq_bot_of_rotate
      (commutator_eq_bot_iff_le_centralizer.mpr (hQY.trans hNcentral))
      (commutator_eq_bot_iff_le_centralizer.mpr
        ((by rwa [commutator_comm] : ⁅Y,H⁆ ≤ Z).trans hZQ))
  apply commutator_eq_bot_iff_le_centralizer.mp
  exact normal_core_subgroup_eq_bot A Q ⁅H,Q⁆ X Y hp
    ((commutator_mono hHQ le_rfl).trans (commutator_le_self Q)) hQA
    (normalizer_commutator_ge_right H Q) hgen hz
    (commutator_eq_bot_iff_le_centralizer.mp hx)
    (commutator_eq_bot_iff_le_centralizer.mp hy)

end Subgroup
