module

public import Theory.Frattini.BinarySquares

/-!
# Square fibers and generators with central fourth roots

In a two-group with central fourth roots of one, an inverted element has square
one: repeatedly square it until the fourth-root condition applies. Consequently
two elements have the same square precisely when their quotient has square one.
Each nonempty square fiber therefore has the size of the square roots of one.

This bounds the Frattini quotient. If there are at most four square roots of one,
the group is generated by two elements and its squares form the Frattini
subgroup. Applying the same result inside Frattini identifies the fourth powers
with the second Frattini subgroup.

These are power-and-generator reductions for MacWilliams, *On 2-groups with no
normal abelian subgroups of rank 3*, Trans. AMS 150 (1970), printed p.377,
assertion (xvii). The inverted-element induction is adapted from the local proof
in `Theory.GroupTheory.PGroup.NormalEightInvolutionLift`; no classification or
metacyclicity theorem is used here.
-/

open Subgroup

namespace IsPGroup

private theorem square_eq_one_of_inverted_of_central_fourth_roots
    {Q : Type*} [Group Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (x y : Q) (hi : y * x * y⁻¹ = x⁻¹) : x ^ 2 = 1 := by
  let f := MulAut.conj y
  have hfix (z : Q) (hz : z ^ 4 = 1) : f z = z := by
    change y * z * y⁻¹ = z
    rw [mem_center_iff.mp (hfour z hz) y, mul_inv_cancel_right]
  have aux : ∀ k (z : Q), z ^ (2 ^ k) = 1 → f z = z⁻¹ → z ^ 2 = 1 := by
    intro k
    induction k with
    | zero =>
      intro z hz _
      simp only [pow_zero, pow_one] at hz
      simp [hz]
    | succ k ih =>
      intro z hz hinv
      have hzfour : z ^ 4 = 1 := by
        have hsq : (z ^ 2) ^ (2 ^ k) = 1 := by
          rw [← pow_mul, Nat.mul_comm 2, ← pow_succ]
          exact hz
        simpa only [← pow_mul, Nat.reduceMul] using
          ih (z ^ 2) hsq (by rw [map_pow, hinv, inv_pow])
      have hzi : z = z⁻¹ := (hfix z hzfour).symm.trans hinv
      calc
        z ^ 2 = z * z := pow_two z
        _ = z * z⁻¹ := congrArg (z * ·) hzi
        _ = 1 := mul_inv_cancel z
  obtain ⟨k, hk⟩ := hQ x
  exact aux k x hk hi

/-- Equal squares differ by a square root of one when fourth roots are central. -/
public theorem square_eq_square_iff_of_central_fourth_roots
    {Q : Type*} [Group Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q) (x y : Q) :
    x ^ 2 = y ^ 2 ↔ (y⁻¹ * x) ^ 2 = 1 := by
  constructor
  · intro h
    apply hQ.square_eq_one_of_inverted_of_central_fourth_roots hfour (y⁻¹ * x) y
    have hid : x * y⁻¹ = x⁻¹ * y := by
      have := congrArg (fun z => x⁻¹ * z * y⁻¹) h
      simpa [pow_two, mul_assoc] using this
    simpa [mul_assoc] using hid
  · intro h
    have hc : y⁻¹ * x ∈ center Q := hfour _ (by
      rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, h, one_pow])
    have hcomm : Commute y (y⁻¹ * x) := (mem_center_iff.mp hc y)
    have := hcomm.mul_pow 2
    simpa [h] using this

/-- Every nonempty square fiber has the same cardinality as the square roots of one. -/
public theorem card_square_range_mul_card_square_roots
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q) :
    Nat.card (Set.range (fun x : Q => x ^ 2)) *
      Nat.card {x : Q // x ^ 2 = 1} = Nat.card Q := by
  classical
  let R := Set.range (fun x : Q => x ^ 2)
  let r (s : R) : Q := Classical.choose s.property
  have hr (s : R) : (r s) ^ 2 = s := Classical.choose_spec s.property
  let f : Q → R × {x : Q // x ^ 2 = 1} := fun x =>
    let s : R := ⟨x ^ 2, ⟨x, rfl⟩⟩
    (s, ⟨(r s)⁻¹ * x, (hQ.square_eq_square_iff_of_central_fourth_roots
      hfour x (r s)).mp (hr s).symm⟩)
  let g : R × {x : Q // x ^ 2 = 1} → Q := fun z => r z.1 * z.2
  have hgf (x : Q) : g (f x) = x := by simp [g, f]
  have hfg (z : R × {x : Q // x ^ 2 = 1}) : f (g z) = z := by
    have hc : (z.2 : Q) ∈ center Q := hfour _ (by
      rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, z.2.property, one_pow])
    have hs : (g z) ^ 2 = z.1 := by
      have hcomm : Commute (r z.1) (z.2 : Q) := (mem_center_iff.mp hc _)
      dsimp [g]
      rw [hcomm.mul_pow, z.2.property, mul_one, hr]
    have hfst : (f (g z)).1 = z.1 := Subtype.ext hs
    apply Prod.ext hfst
    apply Subtype.ext
    change (r (f (g z)).1)⁻¹ * g z = z.2
    rw [hfst]
    simp [g]
  let e : Q ≃ R × {x : Q // x ^ 2 = 1} :=
    ⟨f, g, hgf, hfg⟩
  simpa [Nat.card_prod, R] using (Nat.card_congr e).symm

/-- The square-fiber count bounds the order of the Frattini quotient. -/
public theorem card_frattini_quotient_le_square_roots_of_central_fourth_roots
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q) :
    Nat.card (Q ⧸ frattini Q) ≤ Nat.card {x : Q // x ^ 2 = 1} := by
  let : Fact (IsPGroup 2 Q) := ⟨hQ⟩
  let f : Set.range (fun x : Q => x ^ 2) → frattini Q := fun x =>
    ⟨x, by obtain ⟨y, hy⟩ := x.property; rw [← hy];
           exact pth_power_mem_frattini_of_isPGroup (p := 2) y⟩
  have hcard := Nat.card_le_card_of_injective f (by
    intro x y h; apply Subtype.ext; exact congrArg (fun z : frattini Q => (z : Q)) h)
  have hcount := hQ.card_square_range_mul_card_square_roots hfour
  have hindex := (frattini Q).card_mul_index
  rw [index_eq_card] at hindex
  apply Nat.le_of_mul_le_mul_left _ (Nat.card_pos (α := frattini Q))
  calc
    Nat.card (frattini Q) * Nat.card (Q ⧸ frattini Q) = Nat.card Q := hindex
    _ = Nat.card (Set.range (fun x : Q => x ^ 2)) *
      Nat.card {x : Q // x ^ 2 = 1} := hcount.symm
    _ ≤ _ := Nat.mul_le_mul_right _ hcard

private theorem exists_two_generators_of_card_le_four
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hc : Nat.card Q ≤ 4) : ∃ a b : Q, zpowers a ⊔ zpowers b = ⊤ := by
  classical
  by_cases hcyc : IsCyclic Q
  · obtain ⟨a, ha⟩ := isCyclic_iff_exists_zpowers_eq_top.mp hcyc
    exact ⟨a, 1, by simp [ha]⟩
  have hnon : Nontrivial Q := by
    by_contra hn
    have : Subsingleton Q := not_nontrivial_iff_subsingleton.mp hn
    exact hcyc inferInstance
  let := hnon
  obtain ⟨a, ha⟩ := exists_ne (1 : Q)
  have hproper : zpowers a ≠ (⊤ : Subgroup Q) := fun h =>
    hcyc (isCyclic_iff_exists_zpowers_eq_top.mpr ⟨a, h⟩)
  obtain ⟨b, -, hb⟩ := SetLike.exists_of_lt (lt_top_iff_ne_top.mpr hproper)
  let K := zpowers a ⊔ zpowers b
  have haK : a ∈ K := (show zpowers a ≤ K from le_sup_left) (mem_zpowers a)
  have hbK : b ∈ K := (show zpowers b ≤ K from le_sup_right) (mem_zpowers b)
  have hb1 : b ≠ 1 := fun h => hb (h ▸ (zpowers a).one_mem)
  have hba : b ≠ a := fun h => hb (h ▸ mem_zpowers a)
  let f : Fin 3 → K := ![1, ⟨a, haK⟩, ⟨b, hbK⟩]
  have hinj : Function.Injective f := by
    intro i j hij
    have hv := congrArg (fun x : K => (x : Q)) hij
    clear hij
    fin_cases i <;> fin_cases j <;> simp_all [f, eq_comm]
  have hthree : 3 ≤ Nat.card K := by
    simpa using Nat.card_le_card_of_injective f hinj
  obtain ⟨n, hn⟩ := hQ.exists_card_eq
  have hnle : n ≤ 2 := by
    have : 2 ^ n ≤ 2 ^ 2 := by omega
    exact (pow_le_pow_iff_right₀ (by decide : 1 < 2)).mp this
  have hd : Nat.card Q ∣ 4 := by
    rw [hn]
    exact pow_dvd_pow 2 hnle
  have hkd : Nat.card K ∣ 4 := dvd_trans (card_subgroup_dvd_card K) hd
  have hk4 : Nat.card K = 4 := by
    have hle := Nat.le_of_dvd (by decide : 0 < 4) hkd
    have hne : Nat.card K ≠ 3 := by intro h; norm_num [h] at hkd
    omega
  refine ⟨a, b, (K.card_eq_iff_eq_top).mp ?_⟩
  have hle := card_le_card_group K
  omega

/-- At most four square roots and central fourth roots give two generators. -/
public theorem exists_two_generators_of_central_fourth_roots
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} ≤ 4) :
    ∃ a b : Q, zpowers a ⊔ zpowers b = ⊤ := by
  have hcard : Nat.card (Q ⧸ frattini Q) ≤ 4 :=
    (hQ.card_frattini_quotient_le_square_roots_of_central_fourth_roots hfour).trans hcount
  obtain ⟨x, y, hxy⟩ :=
    (hQ.to_quotient (frattini Q)).exists_two_generators_of_card_le_four hcard
  let q := QuotientGroup.mk' (frattini Q)
  obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (frattini Q) x
  obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (frattini Q) y
  refine ⟨a, b, frattini_nongenerating ?_⟩
  have hm : (zpowers a ⊔ zpowers b).map q = ⊤ := by
    simpa [q, Subgroup.map_sup, MonoidHom.map_zpowers] using hxy
  simpa only [q, Subgroup.comap_map_eq, QuotientGroup.ker_mk', Subgroup.comap_top] using
    congrArg (Subgroup.comap q) hm

private theorem cyclic_of_cyclic_frattini_quotient
    {Q : Type*} [Group Q] [Finite Q] [IsCyclic (Q ⧸ frattini Q)] : IsCyclic Q := by
  obtain ⟨x, hx⟩ := isCyclic_iff_exists_zpowers_eq_top.mp
    (inferInstance : IsCyclic (Q ⧸ frattini Q))
  obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (frattini Q) x
  have hm : (zpowers a).map (QuotientGroup.mk' (frattini Q)) = ⊤ := by
    simpa only [MonoidHom.map_zpowers] using hx
  apply isCyclic_iff_exists_zpowers_eq_top.mpr
  refine ⟨a, frattini_nongenerating ?_⟩
  simpa only [Subgroup.comap_map_eq, QuotientGroup.ker_mk', Subgroup.comap_top] using
    congrArg (Subgroup.comap (QuotientGroup.mk' (frattini Q))) hm

private theorem four_le_card_frattini_quotient_of_not_isCyclic
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q) (hn : ¬ IsCyclic Q) :
    4 ≤ Nat.card (Q ⧸ frattini Q) := by
  by_contra h
  obtain ⟨n, hncard⟩ := (hQ.to_quotient (frattini Q)).exists_card_eq
  have hnlt : n < 2 := by
    apply (Nat.pow_lt_pow_iff_right (by decide : 1 < 2)).mp
    simpa only [← hncard] using (show Nat.card (Q ⧸ frattini Q) < 4 by omega)
  have hd : Nat.card (Q ⧸ frattini Q) ∣ 2 := by
    rw [hncard]
    exact (pow_dvd_pow 2 (show n ≤ 1 by omega)).trans (by simp)
  have : IsCyclic (Q ⧸ frattini Q) := isCyclic_of_card_dvd_prime hd
  exact hn cyclic_of_cyclic_frattini_quotient

/-- With at most four square roots, the squares themselves form the Frattini subgroup. -/
public theorem square_range_eq_frattini_of_central_fourth_roots
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} ≤ 4) :
    Set.range (fun x : Q => x ^ 2) = (frattini Q : Set Q) := by
  let : Fact (IsPGroup 2 Q) := ⟨hQ⟩
  have hsub : Set.range (fun x : Q => x ^ 2) ⊆ (frattini Q : Set Q) := by
    rintro x ⟨y, rfl⟩
    exact pth_power_mem_frattini_of_isPGroup (p := 2) y
  by_cases hc : IsCyclic Q
  · let := hc
    let : CommGroup Q := IsMulCommutative.instCommGroup
    have hr : Set.range (fun x : Q => x ^ 2) =
        ((powMonoidHom 2 : Q →* Q).range : Set Q) := rfl
    rw [hQ.frattini_eq_closure_squares, hr, Subgroup.closure_eq]
  · apply Set.eq_of_subset_of_ncard_le hsub
    change Nat.card (frattini Q) ≤ Nat.card (Set.range (fun x : Q => x ^ 2))
    have hcount' := hQ.card_square_range_mul_card_square_roots hfour
    have hi := hQ.four_le_card_frattini_quotient_of_not_isCyclic hc
    have hprod := (frattini Q).card_mul_index
    rw [index_eq_card] at hprod
    apply Nat.le_of_mul_le_mul_right (c := 4) _ (by decide)
    calc
      Nat.card (frattini Q) * 4 ≤
          Nat.card (frattini Q) * Nat.card (Q ⧸ frattini Q) := Nat.mul_le_mul_left _ hi
      _ = Nat.card Q := hprod
      _ = Nat.card (Set.range (fun x : Q => x ^ 2)) *
          Nat.card {x : Q // x ^ 2 = 1} := hcount'.symm
      _ ≤ _ := Nat.mul_le_mul_left _ hcount

/-- Exactly four square roots give a Frattini quotient of order four. -/
public theorem card_frattini_quotient_eq_four_of_central_fourth_roots
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} = 4) :
    Nat.card (Q ⧸ frattini Q) = 4 := by
  have hc := hQ.card_square_range_mul_card_square_roots hfour
  rw [hQ.square_range_eq_frattini_of_central_fourth_roots hfour hcount.le, hcount] at hc
  have hi := (frattini Q).card_mul_index
  rw [index_eq_card] at hi
  exact Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := frattini Q)) (hi.trans hc.symm)

/-- Centrality of fourth roots passes to every subgroup. -/
public theorem central_fourth_roots_subgroup
    {Q : Type*} [Group Q]
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q) (H : Subgroup Q) :
    ∀ x : H, x ^ 4 = 1 → x ∈ center H := by
  intro x hx
  apply mem_center_iff.mpr
  intro y
  apply Subtype.ext
  exact mem_center_iff.mp (hfour x (congrArg Subtype.val hx)) y

/-- A subgroup has no more square roots of one than its ambient finite group. -/
public theorem card_square_roots_subgroup_le
    {Q : Type*} [Group Q] [Finite Q] (H : Subgroup Q) :
    Nat.card {x : H // x ^ 2 = 1} ≤ Nat.card {x : Q // x ^ 2 = 1} := by
  let f : {x : H // x ^ 2 = 1} → {x : Q // x ^ 2 = 1} :=
    fun x => ⟨x.val, congrArg Subtype.val x.property⟩
  apply Nat.card_le_card_of_injective f
  intro x y h
  apply Subtype.ext
  apply Subtype.ext
  exact congrArg (fun z : {x : Q // x ^ 2 = 1} => (z : Q)) h

/-- Fourth powers themselves form the second Frattini subgroup. -/
public theorem fourth_power_range_eq_second_frattini_of_central_fourth_roots
    {Q : Type*} [Group Q] [Finite Q] (hQ : IsPGroup 2 Q)
    (hfour : ∀ x : Q, x ^ 4 = 1 → x ∈ center Q)
    (hcount : Nat.card {x : Q // x ^ 2 = 1} ≤ 4) :
    Set.range (fun x : Q => x ^ 4) =
      ((frattini (frattini Q)).map (frattini Q).subtype : Set Q) := by
  have hsq := hQ.square_range_eq_frattini_of_central_fourth_roots hfour hcount
  have hsqF := (hQ.to_subgroup (frattini Q)).square_range_eq_frattini_of_central_fourth_roots
    (central_fourth_roots_subgroup hfour _) ((card_square_roots_subgroup_le _).trans hcount)
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    have hy : y ^ 2 ∈ frattini Q := by change y ^ 2 ∈ (frattini Q : Set Q); rw [← hsq]; exact ⟨y, rfl⟩
    refine ⟨(⟨y ^ 2, hy⟩ : frattini Q) ^ 2, ?_, ?_⟩
    · rw [← hsqF]
      exact ⟨⟨y ^ 2, hy⟩, rfl⟩
    · simp [← pow_mul]
  · rintro ⟨y, hy, rfl⟩
    rw [← hsqF] at hy
    obtain ⟨z, rfl⟩ := hy
    have hz := z.property
    rw [← SetLike.mem_coe, ← hsq] at hz
    obtain ⟨w, hw⟩ := hz
    exact ⟨w, by simp [← hw, ← pow_mul]⟩


end IsPGroup
