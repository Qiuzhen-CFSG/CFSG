module

public import Theory.PGroupCore
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Prime cores in commuting products

If two commuting subgroups generate the ambient group, both are normal.
Consequently a prime-group factor and the embedded prime core of the other
factor lie in the ambient prime core. If both factors are prime-groups,
the ambient prime core is the whole group.

The proof uses the normalizer criterion and characteristic normality of the
prime core. These are the elementary central-product reductions used in the
binary case of GLS, Number 2, the remark following Proposition 22.4.
-/

namespace Subgroup

/-- A factor in a commuting product is normal. -/
public theorem normal_of_centralizing_sup_eq_top
    {G : Type*} [Group G] (A C : Subgroup G)
    (hgen : A ⊔ C = ⊤) (hc : C ≤ centralizer (A : Set G)) : A.Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← hgen]
  exact sup_le A.le_normalizer (hc.trans (centralizer_le_normalizer _))

/-- A normal prime-group factor and the prime core of its commuting supplement
are contained in the ambient prime core. -/
public theorem sup_map_pCore_le_of_centralizing_sup_eq_top
    {G : Type*} [Group G] (p : ℕ) (A C : Subgroup G)
    (hA : IsPGroup p A) (hgen : A ⊔ C = ⊤)
    (hc : C ≤ centralizer (A : Set G)) :
    A ⊔ (pCore p C).map C.subtype ≤ pCore p G := by
  let : A.Normal := normal_of_centralizing_sup_eq_top A C hgen hc
  let : C.Normal := normal_of_centralizing_sup_eq_top C A
    (sup_comm A C ▸ hgen) (le_centralizer_iff.mp hc)
  apply sup_le
  · exact le_sSup ⟨inferInstance, hA⟩
  · exact le_sSup ⟨inferInstance, pCore_isPGroup.map C.subtype⟩

/-- A group generated by two commuting prime-group factors is its own prime core. -/
public theorem pCore_eq_top_of_centralizing_sup_eq_top
    {G : Type*} [Group G] (p : ℕ) (A C : Subgroup G)
    (hA : IsPGroup p A) (hC : IsPGroup p C) (hgen : A ⊔ C = ⊤)
    (hc : C ≤ centralizer (A : Set G)) : pCore p G = ⊤ := by
  let : A.Normal := normal_of_centralizing_sup_eq_top A C hgen hc
  let : C.Normal := normal_of_centralizing_sup_eq_top C A
    (sup_comm A C ▸ hgen) (le_centralizer_iff.mp hc)
  apply top_unique
  rw [← hgen]
  exact sup_le (le_sSup ⟨inferInstance, hA⟩) (le_sSup ⟨inferInstance, hC⟩)

end Subgroup
