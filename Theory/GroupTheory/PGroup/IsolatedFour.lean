module
public import Theory.GroupTheory.InvolutionCentralizerFourCyclicComplement
public import Theory.GroupTheory.CyclicIndexTwoElementary
public import Theory.GroupTheory.NormalFourCentralizer
public import Theory.GroupTheory.PGroup.NormalFour
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators

/-!
# Local obstructions for maximal elementary four-groups

In a finite two-group of elementary rank at least three, a maximal elementary
four-group containing a central involution has centralizer larger than itself.
Moreover, its square involutions lie in the line generated by that central
involution. These are the local ingredients in the centralizer argument of
GLS, volume 4, Chapter 2, Lemma 18.1. The first assertion follows from the
cyclic-index-two theorem for an involution centralizer of order four; the
second uses a normal four-group and its centralizer of index two.
-/

namespace Subgroup
open scoped IsMulCommutative

private theorem four_pair_generates
    {P : Type*} [Group P] [Finite P]
    (V : Subgroup P) [IsElementaryAbelian 2 V] (hV : Nat.card V = 4)
    (x y : P) (hx : x ∈ V) (hy : y ∈ V)
    (hx1 : x ≠ 1) (hy1 : y ≠ 1) (hxy : x ≠ y) :
    closure ({x, y} : Set P) = V := by
  have hcomm : Commute x y :=
    congrArg Subtype.val (mul_comm (⟨x, hx⟩ : V) ⟨y, hy⟩)
  let : IsKleinFour (closure ({x, y} : Set P)) :=
    isKleinFour_closure_pair x y
      (by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) x hx)
      (by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) y hy)
      hx1 hy1 hxy hcomm
  apply eq_of_le_of_card_ge
  · exact (closure_le _).mpr (by intro a ha; simp only [Set.mem_insert_iff,
      Set.mem_singleton_iff] at ha; rcases ha with rfl | rfl <;> assumption)
  · rw [hV, IsKleinFour.card_four]

/-- An involution centralizing a maximal elementary four-group belongs to it. -/
public theorem involution_mem_of_maximal_elementary_four
    {G : Type*} [Group G]
    (V : Subgroup G) [IsElementaryAbelian 2 V]
    (hmax : ∀ B : Subgroup G, IsElementaryAbelian 2 B → V ≤ B → B ≤ V)
    (t : G) (ht : t ^ 2 = 1) (htC : t ∈ centralizer (V : Set G)) : t ∈ V := by
  let : IsElementaryAbelian 2 (zpowers t) := IsElementaryAbelian.zpowers_of_pow_eq_one ht
  let : IsElementaryAbelian 2 (V ⊔ zpowers t : Subgroup G) :=
    IsElementaryAbelian.sup_of_le_centralizer (zpowers_le.mpr htC)
  exact hmax _ inferInstance le_sup_left
    ((le_sup_right : zpowers t ≤ V ⊔ zpowers t) (mem_zpowers t))

/-- A four-group with a central involution cannot be self-centralizing in a
finite two-group of elementary rank at least three. -/
public theorem centralizer_ne_self_of_four_of_central_involution
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (A V : Subgroup P) [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 V]
    (hA : 8 ≤ Nat.card A) (hV : Nat.card V = 4)
    (x : P) (hx : x ∈ V) (hx1 : x ≠ 1) (hxZ : x ∈ center P) :
    centralizer (V : Set P) ≠ V := by
  intro hCV
  have hxorder : orderOf x = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian (p := 2) x hx) hx1
  have hnot : ¬ V ≤ zpowers x := by
    intro h
    have hc := card_le_of_le h
    rw [Nat.card_zpowers, hxorder, hV] at hc
    omega
  obtain ⟨y, hy, hyout⟩ := SetLike.not_le_iff_exists.mp hnot
  have hy1 : y ≠ 1 := fun h => hyout (h ▸ one_mem _)
  have hxy : x ≠ y := fun h => hyout (h ▸ mem_zpowers x)
  have hgen := four_pair_generates V hV x y hx hy hx1 hy1 hxy
  have hCy : centralizer ({y} : Set P) = V := by
    apply le_antisymm
    · intro t ht
      rw [← hCV]
      have hVt : V ≤ centralizer ({t} : Set P) := by
        rw [← hgen]
        apply (closure_le _).mpr
        intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with rfl | rfl
        · exact mem_centralizer_singleton_iff.mpr (mem_center_iff.mp hxZ t).symm
        · exact mem_centralizer_singleton_iff.mpr
            (mem_centralizer_singleton_iff.mp ht).symm
      intro v hv
      exact mem_centralizer_singleton_iff.mp (hVt hv)
    · intro v hv
      exact mem_centralizer_singleton_iff.mpr
        (congrArg Subtype.val (mul_comm (⟨v, hv⟩ : V) ⟨y, hy⟩))
  have hyZ : y ∉ center P := by
    intro hyZ
    have htop : centralizer ({y} : Set P) = ⊤ := by
      apply top_unique
      intro t _
      exact mem_centralizer_singleton_iff.mpr (mem_center_iff.mp hyZ t)
    have hc := A.card_le_card_group
    have hcard : Nat.card P = 4 := by
      have heq : V = ⊤ := hCy.symm.trans htop
      simpa only [heq, card_top] using hV
    omega
  obtain ⟨a, ha, -⟩ := exists_zpowers_index_two_of_involution_centralizer_card_four
    hP y (orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian (p := 2) y hy) hy1)
    hyZ (hCy ▸ hV)
  have hbound := card_le_four_of_pow_two_of_cyclic_index_two (zpowers a) ha A
    (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 A))
  omega

/-- In a maximal elementary four-group containing a central involution `x`,
every square that belongs to the four-group is either one or `x`. -/
public theorem square_eq_one_or_central_involution_of_maximal_four
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (A V : Subgroup P) [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 V]
    (hA : 8 ≤ Nat.card A) (hV : Nat.card V = 4)
    (hmax : ∀ B : Subgroup P, IsElementaryAbelian 2 B → V ≤ B → B ≤ V)
    (x : P) (hx : x ∈ V) (hx1 : x ≠ 1) (hxZ : x ∈ center P)
    (t : P) (ht : t ^ 2 ∈ V) : t ^ 2 = 1 ∨ t ^ 2 = x := by
  obtain ⟨U, hUn, hUe, hU⟩ := hP.exists_normal_four_of_elementary_rank_three A hA
  let : U.Normal := hUn
  let : IsElementaryAbelian 2 U := hUe
  let C := centralizer (U : Set P)
  have hVC : ¬ V ≤ C := by
    intro h
    let : IsElementaryAbelian 2 (U ⊔ V : Subgroup P) :=
      IsElementaryAbelian.sup_of_le_centralizer h
    have hUV : U ≤ V := le_sup_left.trans (hmax _ inferInstance le_sup_right)
    have heq : U = V := eq_of_le_of_card_ge hUV (by omega)
    obtain ⟨B, hBe, hBc, hUB, -⟩ := exists_elementary_eight_above_normal_four hP U hU A hA
    have hBV := hmax B hBe (heq ▸ hUB)
    have hc := card_le_of_le hBV
    omega
  have hCtwo : C.index = 2 := by
    have hb := centralizer_index_le_two_of_normal_four hP U hU
    have hz := C.index_ne_zero_of_finite
    have ho : C.index ≠ 1 := fun h => hVC (index_eq_one.mp h ▸ le_top)
    change C.index ≤ 2 at hb
    omega
  by_cases ht1 : t ^ 2 = 1
  · exact Or.inl ht1
  right
  by_contra htx
  have hgen := four_pair_generates V hV x (t ^ 2) hx ht hx1 ht1 (Ne.symm htx)
  apply hVC
  rw [← hgen]
  apply (closure_le _).mpr
  intro z hz
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
  rcases hz with rfl | rfl
  · exact fun u _ => mem_center_iff.mp hxZ u
  · exact C.sq_mem_of_index_two hCtwo t

end Subgroup
