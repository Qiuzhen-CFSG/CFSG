module

public import Theory.GroupTheory.PGroup.ClassTwoCyclicDerived
public import Theory.GroupTheory.NormalSixteenC4SquareRecognition

open Subgroup

/-!
# The center in the class-two order-sixty-four case

An elementary derived four forces the central quotient to have order greater
than four: a class-two group with a central quotient generated by two elements
has cyclic derived group. Thus the center has order less than sixteen.
The absence of characteristic lines and elementary eights excludes a center
of order eight by its square kernel and image. The center is consequently an
elementary four. In particular all squares lie in that four.

Source context: Janko–Thompson, Math. Z. 113 (1970), results 1.3–1.5,
printed p.386, and the minus-core extension on printed p.389. This counting
argument replaces recognition for the specialized class-two case.
-/

namespace OrderSixtyFourClassTwo

private theorem divisor_cases {n : ℕ} (hn : n ∣ 64) :
    n = 1 ∨ n = 2 ∨ n = 4 ∨ n = 8 ∨ 16 ≤ n := by
  obtain ⟨k, hk, heq⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp
    (show n ∣ 2 ^ 6 from hn)
  interval_cases k <;> simp_all

/-- The center is elementary of order four when the derived group is an
 elementary four and characteristic elementary eights and lines are absent. -/
public theorem center_elementary_four
    {P : Type*} [Group P] [Finite P]
    (hcard : Nat.card P = 64)
    (hclass : commutator P ≤ center P)
    [IsElementaryAbelian 2 (commutator P)]
    (hder : Nat.card (commutator P) = 4)
    (hcenter : 4 ≤ Nat.card (center P))
    (hchar : ∀ K : Subgroup P, K.Characteristic → Nat.card K ≠ 2)
    (helem : ∀ K : Subgroup P, K.Characteristic →
      IsElementaryAbelian 2 K → Nat.card K < 8) :
    Nat.card (center P) = 4 ∧ IsElementaryAbelian 2 (center P) := by
  have hP : IsPGroup 2 P := IsPGroup.iff_card.mpr ⟨6, hcard⟩
  have hsmall : Nat.card (center P) < 16 := by
    by_contra! hh
    have hp := (center P).card_mul_index
    rw [hcard] at hp
    have hi : (center P).index ≤ 4 := by nlinarith
    have hbound : Nat.card (omega₁ (P ⧸ center P) (p := 2)) ≤ 4 :=
      (card_le_card_group _).trans (by rwa [← index_eq_card])
    let : IsCyclic (commutator P) :=
      hP.isCyclic_commutator_of_card_omega_center_quotient_le_four hclass hbound
    have hd := IsElementaryAbelian.exponent_dvd_p 2 (commutator P)
    rw [IsCyclic.exponent_eq_card, hder] at hd
    norm_num at hd
  let : CommGroup (center P) := IsMulCommutative.instCommGroup
  let f : center P →* center P := powMonoidHom 2
  let : f.ker.Characteristic := NormalSixteenC4Square.pow_ker_characteristic 2
  let : f.range.Characteristic := NormalSixteenC4Square.pow_range_characteristic 2
  let K := f.ker.map (center P).subtype
  let : IsElementaryAbelian 2 f.ker :=
    ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun x => Subtype.ext x.property)⟩
  let : IsElementaryAbelian 2 K := IsElementaryAbelian.map_subtype
  have hklt : Nat.card f.ker < 8 := by
    rw [← card_map_of_injective (center P).subtype_injective (K := f.ker)]
    exact helem K inferInstance inferInstance
  have hdk : commutator P ≤ K := by
    intro x hx
    refine ⟨⟨x, hclass hx⟩, ?_, rfl⟩
    exact Subtype.ext (elemPow_eq_one_of_isElementaryAbelian x hx)
  have hkle : 4 ≤ Nat.card f.ker := by
    have hh := card_le_of_le hdk
    rwa [hder, card_map_of_injective (center P).subtype_injective] at hh
  have hk : Nat.card f.ker = 4 := by
    have hd := f.ker.card_subgroup_dvd_card.trans (center P).card_subgroup_dvd_card
    rw [hcard] at hd
    rcases divisor_cases hd with h | h | h | h | h <;> omega
  have hc : Nat.card (center P) = 4 := by
    have hd := (center P).card_subgroup_dvd_card
    rw [hcard] at hd
    rcases divisor_cases hd with h | h | h | h | h
    · omega
    · omega
    · exact h
    · have hp := f.ker.card_mul_index
      rw [index_ker, hk, h] at hp
      have hr : Nat.card f.range = 2 := by omega
      have hn := hchar (f.range.map (center P).subtype) inferInstance
      rw [card_map_of_injective (center P).subtype_injective, hr] at hn
      exact (hn rfl).elim
    · omega
  refine ⟨hc, ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_⟩⟩
  have htop : f.ker = ⊤ := f.ker.eq_top_of_card_eq (hk.trans hc.symm)
  intro x
  have hx : x ∈ f.ker := by rw [htop]; trivial
  exact hx

end OrderSixtyFourClassTwo
