module

public import Theory.GroupTheory.PGroup.ExtraspecialInvolution
public import Mathlib.GroupTheory.IndexNormal

/-!
# Double centralizers of involutions in normal extraspecial two-subgroups

Let `P` be a self-centralizing normal extraspecial two-subgroup of a finite
ambient group. The ambient centralizer of `C_P(u)`, for an involution `u` in
`P`, lies in the subgroup generated by `u` and the central involution. No
restriction on the order of `P` or on elementary abelian ranks is needed.

The central commutator homomorphism shows that a noncentral element has
centralizer of index two. Comparing commutators on an outside representative
then gives `C_P(C_P(u)) = Z(P)⟨u⟩`. In particular this double centralizer has
exponent two when `u` is an involution. An automorphism fixing `C_P(u)` has its
discrepancy there; preservation of squares forces the discrepancy into `Z(P)`.
The automorphism is consequently either the identity or conjugation by `u`.
An ambient element inducing either automorphism belongs to `P` by the
self-centralizing hypothesis, and the intrinsic calculation finishes the proof.

Source motivation: Janko–Thompson, Math. Z. 113 (1970), §4, case (c),
printed p.392.
-/

open Subgroup
open scoped commutatorElement

private def commHom {P : Type*} [Group P] [IsExtraspecial 2 P] (v : P) :
    P →* center P where
  toFun x := ⟨⁅v,x⁆,
    (IsExtraspecial.quotient_elementary_abelian 2 P).commutator_le_center_of_central_quotient
      (commutator_mem_commutator (mem_top v) (mem_top x))⟩
  map_one' := by apply Subtype.ext; simp
  map_mul' x y := by
    apply Subtype.ext
    change ⁅v,x*y⁆ = ⁅v,x⁆ * ⁅v,y⁆
    have hc : ⁅v,y⁆ ∈ center P :=
      (IsExtraspecial.quotient_elementary_abelian 2 P).commutator_le_center_of_central_quotient
        (commutator_mem_commutator (mem_top v) (mem_top y))
    rw [commutatorElement_mul_right_eq_mul_conj, mul_assoc ⁅v,x⁆ x ⁅v,y⁆,
      mem_center_iff.mp hc x]
    simp only [← mul_assoc, mul_inv_cancel_right]

private theorem commHom_eq_one {P : Type*} [Group P] [IsExtraspecial 2 P] (v x : P) :
    commHom v x = 1 ↔ Commute v x := by
  rw [Subtype.ext_iff]
  exact commutatorElement_eq_one_iff_mul_comm

private theorem centralizer_index_two {P : Type*} [Group P] [Finite P]
    [IsExtraspecial 2 P] (u : P) (hu : u ∉ center P) :
    (centralizer ({u} : Set P)).index = 2 := by
  have hk : (commHom u).ker = centralizer ({u} : Set P) := by
    ext x
    rw [MonoidHom.mem_ker, commHom_eq_one, mem_centralizer_singleton_iff]
    exact ⟨fun h => h.symm.eq, fun h => (show Commute x u from h).symm⟩
  have hi : (centralizer ({u} : Set P)).index ≤ 2 := by
    rw [← hk, index_ker, ← IsExtraspecial.center_order_p 2 P]
    exact Nat.card_le_card_of_injective _ (commHom u).range.subtype_injective
  have hn : (centralizer ({u} : Set P)).index ≠ 1 := by
    intro he
    apply hu
    apply mem_center_iff.mpr
    intro x
    exact mem_centralizer_singleton_iff.mp ((index_eq_one.mp he).symm ▸ mem_top x)
  have hp := (centralizer ({u} : Set P)).index_ne_zero_of_finite
  omega

private theorem central_of_commute_index_two {P : Type*} [Group P]
    (C : Subgroup P) (hi : C.index = 2) (v : P) (hv : v ∉ C)
    (d : P) (hd : d ∈ centralizer (C : Set P)) (hdv : Commute d v) :
    d ∈ center P := by
  apply mem_center_iff.mpr
  intro w
  by_cases hw : w ∈ C
  · exact hd w hw
  · have hwv : w * v⁻¹ ∈ C :=
      (C.mul_mem_iff_of_index_two hi).mpr (by simp only [inv_mem_iff, hw, hv])
    have hc : Commute (w * v⁻¹) d := hd _ hwv
    have h := hc.mul_left hdv.symm
    simpa only [inv_mul_cancel_right] using h.eq

/-- The intrinsic double centralizer consists of the center and its `u`-coset. -/
private theorem centralizer_dichotomy {P : Type*} [Group P] [Finite P]
    [IsExtraspecial 2 P] (u : P) (hu : u ∉ center P)
    (d : P) (hd : d ∈ centralizer (centralizer ({u} : Set P) : Set P)) :
    d ∈ center P ∨ d * u⁻¹ ∈ center P := by
  let C := centralizer ({u} : Set P)
  have hi := centralizer_index_two u hu
  obtain ⟨v, hv, _⟩ := C.index_eq_two_iff_exists_notMem_and.mp hi
  have hune : commHom v u ≠ 1 := by
    intro h
    exact hv (mem_centralizer_singleton_iff.mpr ((commHom_eq_one v u).mp h))
  by_cases he : commHom v d = 1
  · exact Or.inl (central_of_commute_index_two C hi v hv d hd
      ((commHom_eq_one v d).mp he).symm)
  · have hde : commHom v d = commHom v u := by
      obtain ⟨z, _, hall⟩ := (Nat.card_eq_two_iff' (1 : center P)).mp
        (IsExtraspecial.center_order_p 2 P)
      exact (hall _ he).trans (hall _ hune).symm
    apply Or.inr
    apply central_of_commute_index_two C hi v hv (d * u⁻¹)
    · exact (centralizer (C : Set P)).mul_mem hd
        ((centralizer (C : Set P)).inv_mem (fun c hc =>
          mem_centralizer_singleton_iff.mp hc))
    · apply Commute.symm
      apply (commHom_eq_one v _).mp
      rw [map_mul, map_inv, hde, mul_inv_cancel]

private theorem center_square {P : Type*} [Group P] [IsExtraspecial 2 P]
    {c : P} (hc : c ∈ center P) : c ^ 2 = 1 := by
  have h := congrArg Subtype.val (pow_card_eq_one' (x := (⟨c, hc⟩ : center P)))
  simpa only [IsExtraspecial.center_order_p 2 P, SubmonoidClass.coe_pow,
    OneMemClass.coe_one] using h

private theorem double_centralizer_square {P : Type*} [Group P] [Finite P]
    [IsExtraspecial 2 P] (u : P) (hu : u ∉ center P) (hu2 : u ^ 2 = 1)
    (d : P) (hd : d ∈ centralizer (centralizer ({u} : Set P) : Set P)) :
    d ^ 2 = 1 := by
  rcases centralizer_dichotomy u hu d hd with hdZ | hdZ
  · exact center_square hdZ
  · have hc : Commute (d * u⁻¹) u := (mem_center_iff.mp hdZ u).symm
    have he : d = (d * u⁻¹) * u := by simp
    calc
      d ^ 2 = ((d * u⁻¹) * u) ^ 2 := congrArg (· ^ 2) he
      _ = (d * u⁻¹) ^ 2 * u ^ 2 := hc.mul_pow 2
      _ = 1 := by rw [center_square hdZ, hu2, mul_one]

private theorem hom_ext_index_two {P R : Type*} [Group P] [Group R]
    (C : Subgroup P) (hi : C.index = 2) (v : P) (hv : v ∉ C)
    (f g : P →* R) (hC : ∀ c ∈ C, f c = g c) (hvfg : f v = g v) : f = g := by
  apply MonoidHom.ext
  intro w
  by_cases hw : w ∈ C
  · exact hC w hw
  · have hwv : w * v⁻¹ ∈ C :=
      (C.mul_mem_iff_of_index_two hi).mpr (by simp only [inv_mem_iff, hw, hv])
    calc
      f w = f (w * v⁻¹) * f v := by rw [← map_mul]; simp
      _ = g (w * v⁻¹) * g v := by rw [hC _ hwv, hvfg]
      _ = g w := by rw [← map_mul]; simp

/-- Fixing the involution centralizer pointwise allows only the two inner actions. -/
private theorem automorphism_fixed_centralizer {P : Type*} [Group P] [Finite P]
    [IsExtraspecial 2 P] (u : P) (hu : u ∉ center P) (hu2 : u ^ 2 = 1)
    (e : MulAut P) (hfix : ∀ c ∈ centralizer ({u} : Set P), e c = c) :
    e = 1 ∨ e = MulAut.conj u := by
  let C := centralizer ({u} : Set P)
  have hi := centralizer_index_two u hu
  let : C.Normal := normal_of_index_eq_two hi
  obtain ⟨v, hv, _⟩ := C.index_eq_two_iff_exists_notMem_and.mp hi
  let d := v⁻¹ * e v
  have hd : d ∈ centralizer (C : Set P) := by
    intro c hc
    have hconj := hfix (v * c * v⁻¹) ((inferInstance : C.Normal).conj_mem c hc v)
    rw [map_mul, map_mul, map_inv, hfix c hc] at hconj
    have hh := congrArg (fun t : P => v⁻¹ * t * e v) hconj
    have heq : d * c = c * d := by
      simpa only [d, mul_assoc, inv_mul_cancel, mul_inv_cancel, inv_mul_cancel_left,
        mul_one, one_mul] using hh
    exact heq.symm
  have hd2 := double_centralizer_square u hu hu2 d hd
  have hd2' : d * d = 1 := by simpa only [pow_two] using hd2
  have hstep : e v = v * d := by simp [d]
  have hs : (v * d) ^ 2 = v ^ 2 := by
    rw [← hstep, ← map_pow]
    exact hfix _ (center_le_centralizer _ (IsExtraspecial.square_mem_center v))
  have hdv : Commute d v := by
    change d * v = v * d
    have hh := congrArg (fun t : P => v⁻¹ * t * d) hs
    simpa only [pow_two, mul_assoc, inv_mul_cancel_left, hd2', mul_one] using hh
  have hdZ := central_of_commute_index_two C hi v hv d hd hdv
  have hext (f : MulAut P) (hfC : ∀ c ∈ C, f c = c) (hfv : e v = f v) : e = f := by
    apply MulEquiv.toMonoidHom_injective
    exact hom_ext_index_two C hi v hv e.toMonoidHom f.toMonoidHom
      (fun c hc => (hfix c hc).trans (hfC c hc).symm) hfv
  by_cases hd1 : d = 1
  · left
    apply hext 1 (fun _ _ => rfl)
    change e v = v
    simpa only [hd1, mul_one] using hstep
  · right
    have hcomm : ⁅u,v⁆ ∈ center P := (commHom u v).property
    have hcomm1 : ⁅u,v⁆ ≠ 1 := by
      intro h
      apply hv
      exact mem_centralizer_singleton_iff.mpr
        (commutatorElement_eq_one_iff_mul_comm.mp h).symm
    have hdcomm : d = ⁅u,v⁆ := by
      obtain ⟨z, _, hall⟩ := (Nat.card_eq_two_iff' (1 : center P)).mp
        (IsExtraspecial.center_order_p 2 P)
      exact congrArg Subtype.val
        ((hall ⟨d, hdZ⟩ (fun h => hd1 (congrArg Subtype.val h))).trans
          (hall ⟨⁅u,v⁆, hcomm⟩ (fun h => hcomm1 (congrArg Subtype.val h))).symm)
    apply hext (MulAut.conj u)
    · intro c hc
      change u * c * u⁻¹ = c
      rw [← mem_centralizer_singleton_iff.mp hc, mul_inv_cancel_right]
    · rw [hstep, hdcomm, mem_center_iff.mp hcomm v]
      exact conj_eq_commutatorElement_mul.symm

/-- The ambient double centralizer of an involution in a self-centralizing
normal extraspecial two-subgroup lies in the subgroup generated by that
involution and a central involution. There is no order or elementary-rank bound. -/
public theorem IsExtraspecial.ambient_involution_double_centralizer_le
    {Q : Type*} [Group Q] [Finite Q]
    (P : Subgroup Q) [P.Normal] [IsExtraspecial 2 P]
    (hself : centralizer (P : Set Q) ≤ P)
    (z u : Q) (hz : orderOf z = 2) (hzcentral : z ∈ center Q)
    (huP : u ∈ P) (hu : orderOf u = 2) :
    centralizer (P ⊓ centralizer ({u} : Set Q) : Set Q) ≤
      closure ({z, u} : Set Q) := by
  let U : P := ⟨u, huP⟩
  let C := centralizer ({U} : Set P)
  let K := closure ({z, u} : Set Q)
  have hzK : z ∈ K := subset_closure (by simp)
  have huK : u ∈ K := subset_closure (by simp)
  have hzP : z ∈ P := hself (center_le_centralizer _ hzcentral)
  have hzZ : (⟨z, hzP⟩ : P) ∈ center P :=
    mem_center_iff.mpr (fun c => Subtype.ext (mem_center_iff.mp hzcentral c))
  have hz1 : z ≠ 1 := by intro h; simp [h] at hz
  have hZK (c : P) (hc : c ∈ center P) : (c : Q) ∈ K := by
    by_cases hc1 : c = 1
    · simpa only [hc1, OneMemClass.coe_one] using K.one_mem
    · obtain ⟨w, _, hall⟩ := (Nat.card_eq_two_iff' (1 : center P)).mp
        (IsExtraspecial.center_order_p 2 P)
      have heq : c = ⟨z, hzP⟩ := congrArg Subtype.val
        ((hall ⟨c, hc⟩ (fun h => hc1 (congrArg Subtype.val h))).trans
          (hall ⟨⟨z, hzP⟩, hzZ⟩
            (fun h => hz1 (congrArg (fun t : center P => ((t : P) : Q)) h))).symm)
      simpa only [heq] using hzK
  intro x hx
  let e : MulAut P := MulAut.conjNormal x
  have hfix (c : P) (hc : c ∈ C) : e c = c := by
    apply Subtype.ext
    change x * (c : Q) * x⁻¹ = c
    have hcu : (c : Q) ∈ centralizer ({u} : Set Q) :=
      mem_centralizer_singleton_iff.mpr (congrArg Subtype.val
        (mem_centralizer_singleton_iff.mp hc))
    rw [← hx c ⟨c.property, hcu⟩, mul_inv_cancel_right]
  have hinner : ∃ r : P, e = MulAut.conj r := by
    by_cases hUZ : U ∈ center P
    · refine ⟨1, ?_⟩
      apply MulEquiv.ext
      intro c
      simpa only [map_one, MulAut.one_apply] using
        hfix c (mem_centralizer_singleton_iff.mpr (mem_center_iff.mp hUZ c))
    · have hU2 : U ^ 2 = 1 := by
        apply Subtype.ext
        exact hu ▸ pow_orderOf_eq_one u
      rcases automorphism_fixed_centralizer U hUZ hU2 e hfix with he | he
      · exact ⟨1, by simpa only [map_one] using he⟩
      · exact ⟨U, he⟩
  obtain ⟨r, hr⟩ := hinner
  have hcentral : (r : Q)⁻¹ * x ∈ centralizer (P : Set Q) := by
    intro c hc
    have he := congrArg (fun a : MulAut P => (a ⟨c, hc⟩ : Q)) hr
    change x * c * x⁻¹ = (r : Q) * c * (r : Q)⁻¹ at he
    have hh := congrArg (fun t : Q => (r : Q)⁻¹ * t * x) he
    have heq : (r : Q)⁻¹ * x * c = c * ((r : Q)⁻¹ * x) := by
      simpa only [mul_assoc, inv_mul_cancel, mul_inv_cancel, inv_mul_cancel_left,
        mul_one, one_mul] using hh
    exact heq.symm
  have hxP : x ∈ P := by
    have hh := P.mul_mem r.property (hself hcentral)
    simpa only [mul_inv_cancel_left] using hh
  let X : P := ⟨x, hxP⟩
  have hXC : X ∈ centralizer (C : Set P) := by
    intro c hc
    apply Subtype.ext
    exact hx c ⟨c.property, mem_centralizer_singleton_iff.mpr
      (congrArg Subtype.val (mem_centralizer_singleton_iff.mp hc))⟩
  by_cases hUZ : U ∈ center P
  · apply hZK X
    apply mem_center_iff.mpr
    intro c
    exact hXC c (mem_centralizer_singleton_iff.mpr (mem_center_iff.mp hUZ c))
  · rcases centralizer_dichotomy U hUZ X hXC with hXZ | hXZ
    · exact hZK X hXZ
    · have hh := K.mul_mem (hZK (X * U⁻¹) hXZ) huK
      simpa only [Subgroup.coe_mul, Subgroup.coe_inv, U, X, inv_mul_cancel_right] using hh
