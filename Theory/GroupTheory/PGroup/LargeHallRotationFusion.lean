module

public import Theory.GroupTheory.PGroup.LargeHallRotationStructure
public import Theory.GroupTheory.PGroup.LargeBinaryHallRotations
public import Theory.GroupTheory.PGroup.ExtraspecialCentralProductPowers

/-!
# Fourth roots in the intrinsic rotation product

In a two-group with cyclic center, every large normal cyclic subgroup contains
a fourth root of the central involution. For a central product of an
extraspecial factor and a large noncyclic binary Hall factor, the rotations
commute with their product with the extraspecial factor. That product is
intrinsically the subgroup generated by elements with nontrivial fourth power.
Thus each of its elements commutes with a fourth root of the central involution.
All squares of the full central product lie in a cyclic subgroup.

This is the rotation-product branch of Janko–Thompson, Math. Z. 113 (1970),
§4, Case 1, printed p.392. The statements use no elementary-rank bound.
-/

namespace Subgroup

/-- A large normal cyclic subgroup contains a fourth root of the involution
in the cyclic ambient center. -/
public theorem exists_fourth_root_mem_of_large_normal_cyclic
    {P : Type*} [Group P] [Finite P] [IsCyclic (center P)]
    (hP : IsPGroup 2 P) (R : Subgroup P) [R.Normal] [IsCyclic R]
    (hR : 8 ≤ Nat.card R) (z : P) (hzC : z ∈ center P) (hz : orderOf z = 2) :
    ∃ x : P, x ∈ R ∧ x ^ 4 = z := by
  obtain ⟨r, hr⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := R)
  obtain ⟨n, hn⟩ := (hP.to_subgroup R).exists_card_eq
  have hn3 : 3 ≤ n := by
    apply (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp
    simpa only [hn] using hR
  have hd : 8 ∣ orderOf r := by
    rw [hr, hn]
    exact pow_dvd_pow 2 hn3
  let x : R := r ^ (orderOf r / 8)
  have hx : orderOf x = 8 := orderOf_pow_orderOf_div (orderOf_pos r).ne' hd
  have hy : orderOf (x ^ 4) = 2 := by rw [orderOf_pow, hx]; decide
  have hyP : orderOf ((x : P) ^ 4) = 2 := by
    rw [← coe_pow, orderOf_coe]
    exact hy
  have hyC : (x : P) ^ 4 ∈ center P := by
    apply mem_center_iff.mpr
    intro g
    have hm : g * (x : P) ^ 4 * g⁻¹ ∈ R :=
      (inferInstance : R.Normal).conj_mem _ (R.pow_mem x.property 4) g
    have ho : orderOf (⟨g * (x : P) ^ 4 * g⁻¹, hm⟩ : R) = 2 := by
      rw [← orderOf_coe]
      change orderOf ((MulAut.conj g) ((x : P) ^ 4)) = 2
      rw [MulEquiv.orderOf_eq, hyP]
    have he := congrArg Subtype.val (IsCyclic.eq_of_orderOf_eq_two ho hy)
    exact mul_inv_eq_iff_eq_mul.mp he
  have he : (x : P) ^ 4 = z := congrArg Subtype.val
    (IsCyclic.eq_of_orderOf_eq_two (x := (⟨_, hyC⟩ : center P))
      (y := (⟨z, hzC⟩ : center P))
      (by rwa [← orderOf_coe]) (by rwa [← orderOf_coe]))
  exact ⟨x, x.property, he⟩

/-- The intrinsic rotation product is characteristic, all ambient squares lie
in a cyclic subgroup, and every element of the product commutes with a fourth
root of the central involution. -/
public theorem cyclic_squares_and_intrinsic_rotation_roots_of_large_hall
    {P : Type*} [Group P] [Finite P] [IsCyclic (center P)]
    (hP : IsPGroup 2 P) (A D : Subgroup P) [A.Normal] [D.Normal]
    [IsExtraspecial 2 A] (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ centralizer (A : Set P)) (hg : A ⊔ D = ⊤)
    (hlarge : 16 ≤ Nat.card D) :
    (closure {x : P | x ^ 4 ≠ 1}).Characteristic ∧
      ∃ Q : Subgroup P, IsCyclic Q ∧ (∀ x : P, x ^ 2 ∈ Q) ∧
        ∀ z t : P, z ∈ center P → orderOf z = 2 →
          t ∈ closure {x : P | x ^ 4 ≠ 1} →
            ∃ x : P, x ^ 4 = z ∧ Commute x t := by
  obtain ⟨R, hRc, hRcyc, hR, hout, _⟩ :=
    IsBinaryHallFactor.exists_characteristic_large_rotation
      (hP.to_subgroup D) hD hn hlarge
  let : R.Characteristic := hRc
  let : IsCyclic R := hRcyc
  let B := R.map D.subtype
  let : B.Normal := inferInstance
  let : IsCyclic B := (R.equivMapOfInjective D.subtype D.subtype_injective).isCyclic.mp
    inferInstance
  have hB : 8 ≤ Nat.card B := by
    rw [show Nat.card B = Nat.card R from card_map_of_injective D.subtype_injective]
    exact hR
  have hBD : B ≤ D := map_subtype_le R
  have houtB (d : P) (hd : d ∈ D) (hnB : d ∉ B) : d ^ 4 = 1 := by
    exact congrArg Subtype.val (hout ⟨d, hd⟩ (fun h => hnB ⟨⟨d, hd⟩, h, rfl⟩))
  have hA (a : P) (ha : a ∈ A) : a ^ 4 = 1 :=
    congrArg Subtype.val (IsExtraspecial.pow_four_eq_one (⟨a, ha⟩ : A))
  have hM : A ⊔ B = closure {x : P | x ^ 4 ≠ 1} :=
    sup_eq_closure_nontrivial_fourth_powers A D B hA hc hg hBD hB houtB
  refine ⟨hM ▸ characteristic_sup_of_fourth_power_rotation A D B hA hc hg hBD hB houtB, ?_⟩
  obtain ⟨r, hr8, hsq, hZ, hcent', hhalf⟩ :=
    IsBinaryHallFactor.exists_large_rotation (hP.to_subgroup D) hD hn hlarge
  obtain ⟨Q, hQ, hQs, _⟩ := cyclic_squares_and_fourth_roots_of_central_product
    hP A D hc hg r hr8 hsq hZ hcent' hhalf
  refine ⟨Q, hQ, hQs, ?_⟩
  intro z t hzC hz ht
  obtain ⟨x, hxB, hx⟩ := exists_fourth_root_mem_of_large_normal_cyclic hP B hB z hzC hz
  refine ⟨x, hx, ?_⟩
  have hle : A ⊔ B ≤ centralizer ({x} : Set P) := by
    apply sup_le
    · intro a ha
      exact mem_centralizer_singleton_iff.mpr (hc (hBD hxB) a ha)
    · intro b hb
      exact mem_centralizer_singleton_iff.mpr (B.le_centralizer hxB b hb)
  exact (mem_centralizer_singleton_iff.mp (hle (hM.symm ▸ ht))).symm

end Subgroup
