module

public import Theory.GroupTheory.PGroup.LargeHallRotationStructure
public import Theory.GroupTheory.PGroup.CyclicInvolution
public import Theory.GroupTheory.NormalCenterQuotient

/-!
# An involution outside the large Hall rotation product

In a finite two-group with cyclic center, let an extraspecial factor and a
large noncyclic binary Hall factor be commuting normal supplements. There is
an involution outside the subgroup generated by elements with nontrivial
fourth power. No restriction on the order of the extraspecial factor is needed.

The cyclic index-two rotations of the Hall factor identify the fourth-power
closure as the product of the extraspecial factor with the rotations. The
intersection of the two factors lies in the Hall center and thus in the
rotations. An element outside the rotations therefore remains outside their
product with the extraspecial factor. Its square is central. If this square
is nontrivial, it equals the square of a suitable extraspecial element, since
the ambient cyclic center has a unique involution. Multiplying these two
elements cancels their squares and preserves nonmembership in the product.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, Case 1, final paragraph,
printed pp.392–393 (PDF pp.8–9 of
`refs/original/n-group-global/odd-core-rank-two-source/janko-thompson-1970-gdz.pdf`).
-/

open Subgroup

private theorem exists_nontrivial_square
    {G : Type*} [Group G] [IsExtraspecial 2 G] : ∃ a : G, a ^ 2 ≠ 1 := by
  by_contra h
  have hs : ∀ a : G, a ^ 2 = 1 := by simpa using h
  have hi (a : G) : a⁻¹ = a :=
    inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hs a)
  have hZ : center G = ⊤ := by
    apply top_unique
    intro a _
    apply mem_center_iff.mpr
    intro b
    have hh := hi (a * b)
    simpa only [mul_inv_rev, hi a, hi b] using hh
  let : Nontrivial (G ⧸ center G) := IsExtraspecial.quotient_nontrivial 2 G
  exact (QuotientGroup.nontrivial_iff.mp inferInstance) hZ

private theorem outside_square_central
    {G : Type*} [Group G] (R : Subgroup G) [IsCyclic R]
    (hi : R.index = 2) (d : G) (hd : d ∉ R) : d ^ 2 ∈ center G := by
  apply mem_center_iff.mpr
  intro x
  have hs : d ^ 2 ∈ R := R.sq_mem_of_index_two hi d
  by_cases hx : x ∈ R
  · exact R.le_centralizer hs x hx
  · have hy : x * d⁻¹ ∈ R :=
      (R.mul_mem_iff_of_index_two hi).mpr (by simpa using iff_of_false hx hd)
    have hh : Commute (d ^ 2) (x * d⁻¹) := R.le_centralizer hy _ hs
    have he := hh.mul_right (Commute.self_pow d 2).symm
    simpa using he.symm.eq

/-- A large noncyclic Hall tail in an extraspecial central product supplies an
involution outside the subgroup generated by elements with nontrivial fourth
power. The extraspecial factor may have any order. -/
public theorem Subgroup.exists_involution_outside_fourth_power_closure_of_large_hall
    {P : Type*} [Group P] [Finite P] [IsCyclic (center P)]
    (hP : IsPGroup 2 P) (B D : Subgroup P) [B.Normal] [D.Normal]
    [IsExtraspecial 2 B]
    (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ centralizer (B : Set P)) (hg : B ⊔ D = ⊤)
    (hlarge : 16 ≤ Nat.card D) :
    ∃ x : P, x ∉ closure {u : P | u ^ 4 ≠ 1} ∧ orderOf x = 2 := by
  obtain ⟨R, hRc, hRcyc, hi, hRcard, hout, hcent⟩ :=
    hD.exists_characteristic_large_rotation_index_two (hP.to_subgroup D) hn hlarge
  let : R.Characteristic := hRc
  let : IsCyclic R := hRcyc
  let S := R.map D.subtype
  let : IsCyclic S := (R.equivMapOfInjective D.subtype D.subtype_injective).isCyclic.mp
    inferInstance
  have hS : 8 ≤ Nat.card S := by
    rwa [card_map_of_injective D.subtype_injective]
  have hclosure : B ⊔ S = closure {u : P | u ^ 4 ≠ 1} := by
    refine sup_eq_closure_nontrivial_fourth_powers B D S ?_ hc hg (map_subtype_le R) hS ?_
    · intro b hb
      exact congrArg Subtype.val (IsExtraspecial.pow_four_eq_one (⟨b, hb⟩ : B))
    · intro d hd hnS
      exact congrArg Subtype.val (hout ⟨d, hd⟩ (fun hh => hnS ⟨⟨d, hd⟩, hh, rfl⟩))
  have hZR : center D ≤ R := (center_le_centralizer _).trans hcent
  have hinf : B ⊓ D ≤ S := by
    intro b hb
    refine ⟨⟨b, hb.2⟩, hZR (mem_center_iff.mpr ?_), rfl⟩
    intro d
    exact Subtype.ext (hc d.property b hb.1).symm
  obtain ⟨d, hd, _⟩ := R.index_eq_two_iff_exists_notMem_and.mp hi
  have hdout : (d : P) ∉ B ⊔ S := by
    intro hh
    obtain ⟨b, hb, s, hs, he⟩ := mem_sup_of_normal_right.mp hh
    have hbD : b ∈ D := by
      have hh := D.mul_mem d.property (D.inv_mem (map_subtype_le R hs))
      simpa only [← he, mul_inv_cancel_right] using hh
    have hdS : (d : P) ∈ S := he ▸ S.mul_mem (hinf ⟨hb, hbD⟩) hs
    obtain ⟨r, hr, he⟩ := hdS
    exact hd ((Subtype.ext he : r = d) ▸ hr)
  have hne (x : P) (hx : x ∉ B ⊔ S) : x ≠ 1 := by
    intro he
    exact hx (he ▸ (B ⊔ S).one_mem)
  by_cases hd2 : d ^ 2 = 1
  · refine ⟨d, hclosure ▸ hdout, orderOf_eq_prime ?_ (hne d hdout)⟩
    exact congrArg Subtype.val hd2
  obtain ⟨a, ha⟩ := exists_nontrivial_square (G := B)
  have haZ : (a : P) ^ 2 ∈ center P := by
    let Z := (center B).map B.subtype
    have hZcard : Nat.card Z = 2 := (card_map_of_injective B.subtype_injective).trans
      (IsExtraspecial.center_order_p 2 B)
    exact central_of_normal_card_two Z hZcard
      (mem_map_of_mem B.subtype (IsExtraspecial.square_mem_center a))
  have hdZ : (d : P) ^ 2 ∈ center P := by
    have hdZ' := outside_square_central R hi d hd
    apply mem_center_iff.mpr
    intro x
    obtain ⟨b, hb, e, he, rfl⟩ := mem_sup_of_normal_right.mp
      (show x ∈ B ⊔ D by rw [hg]; trivial)
    have hbcomm : Commute b ((d : P) ^ 2) := hc (D.pow_mem d.property 2) b hb
    have hecomm : Commute e ((d : P) ^ 2) :=
      congrArg Subtype.val (mem_center_iff.mp hdZ' ⟨e, he⟩)
    exact (hbcomm.mul_left hecomm).eq
  have heq : (a : P) ^ 2 = (d : P) ^ 2 := by
    apply congrArg (fun z : center P => (z : P))
      (IsCyclic.eq_of_orderOf_eq_two (x := ⟨_, haZ⟩) (y := ⟨_, hdZ⟩) ?_ ?_)
    · apply orderOf_eq_prime
      · apply Subtype.ext
        change ((a : P) ^ 2) ^ 2 = 1
        simpa only [Subgroup.coe_pow, OneMemClass.coe_one, ← pow_mul] using congrArg Subtype.val (IsExtraspecial.pow_four_eq_one a)
      · intro hh
        exact ha (Subtype.ext (congrArg (fun z : center P => (z : P)) hh))
    · apply orderOf_eq_prime
      · apply Subtype.ext
        change ((d : P) ^ 2) ^ 2 = 1
        simpa only [Subgroup.coe_pow, OneMemClass.coe_one, ← pow_mul] using congrArg Subtype.val (hout d hd)
      · intro hh
        exact hd2 (Subtype.ext (congrArg (fun z : center P => (z : P)) hh))
  have hadout : (a : P) * d ∉ B ⊔ S := by
    intro hh
    have hh' := (B ⊔ S).mul_mem
      ((B ⊔ S).inv_mem (mem_sup_left a.property)) hh
    exact hdout (by simpa using hh')
  refine ⟨(a : P) * d, hclosure ▸ hadout, orderOf_eq_prime ?_ (hne _ hadout)⟩
  rw [(show Commute (a : P) d from hc d.property a a.property).mul_pow, heq,
    ← pow_two, ← pow_mul]
  exact congrArg Subtype.val (hout d hd)
