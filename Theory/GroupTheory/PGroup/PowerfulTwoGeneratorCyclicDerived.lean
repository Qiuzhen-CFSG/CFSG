module

public import Theory.GroupTheory.PGroup.PowerfulDerivedFrattini

/-!
# Cyclic derived subgroups of powerful two-generator two-groups

A finite powerful two-group generated by `a` and `b` has derived subgroup
exactly `⟨[a,b]⟩`. The powerful embedding consequence proved in
`PowerfulDerivedFrattini` says that conjugation acts trivially on `G′ / Φ(G′)`.
Consequently `⟨[a,b]⟩ Φ(G′)` is normal in `G`. Its quotient is generated by
two commuting elements, so this subgroup is all of `G′`. Frattini
nongeneration then removes `Φ(G′)`.

The intermediate Frattini argument applies to any finite two-generated group
whose ambient conjugation action on the derived Frattini quotient is trivial.

Source: G. Traustason and J. Williams, *Powerfully nilpotent groups of rank 2
or small order*, Section 2, https://arxiv.org/abs/2002.02694.
-/

open Subgroup
open scoped commutatorElement IsMulCommutative
variable {G : Type*} [Group G]

private theorem derived_le_of_pair (a b : G)
    (hgen : zpowers a ⊔ zpowers b = ⊤)
    (N : Subgroup G) [N.Normal] (hab : ⁅a,b⁆ ∈ N) :
    _root_.commutator G ≤ N := by
  let q := QuotientGroup.mk' N
  have hgenq : zpowers (q a) ⊔ zpowers (q b) = ⊤ := by
    rw [← MonoidHom.map_zpowers, ← MonoidHom.map_zpowers, ← Subgroup.map_sup, hgen]
    exact map_top_of_surjective q (QuotientGroup.mk'_surjective N)
  have habq : q a * q b = q b * q a := by
    apply commutatorElement_eq_one_iff_mul_comm.mp
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr hab
  have hcl : closure ({q a, q b} : Set (G ⧸ N)) = ⊤ := by
    rw [Set.insert_eq, closure_union, ← zpowers_eq_closure, ← zpowers_eq_closure]
    exact hgenq
  have hcomm : IsMulCommutative (closure ({q a, q b} : Set (G ⧸ N))) := by
    apply isMulCommutative_closure
    intro x hx y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy
    rcases hx with rfl | rfl <;> rcases hy with rfl | rfl
    · rfl
    · exact habq
    · exact habq.symm
    · rfl
  rw [hcl] at hcomm
  let := hcomm
  apply Subgroup.Normal.quotient_commutative_iff_commutator_le.mp
  exact ⟨⟨fun x y => congrArg Subtype.val
    (mul_comm' (⟨x, mem_top x⟩ : (⊤ : Subgroup (G ⧸ N))) ⟨y, mem_top y⟩)⟩⟩

/-- If ambient conjugation acts trivially on the derived Frattini quotient,
the commutator of a generating pair generates the derived subgroup. -/
public theorem commutator_eq_zpowers_of_two_generators_of_derived_frattini [Finite G] (a b : G)
    (hgen : zpowers a ⊔ zpowers b = ⊤)
    (hc : ⁅_root_.commutator G, (⊤ : Subgroup G)⁆ ≤
      (frattini (_root_.commutator G)).map (_root_.commutator G).subtype) :
    _root_.commutator G = zpowers ⁅a,b⁆ := by
  let D := _root_.commutator G
  let c : D := ⟨⁅a,b⁆, commutator_mem_commutator (mem_top a) (mem_top b)⟩
  let F := (frattini D).map D.subtype
  let N := zpowers ⁅a,b⁆ ⊔ F
  have hND : N ≤ D := sup_le (zpowers_le.mpr c.property) (map_subtype_le _)
  let : N.Normal := commutator_top_right_le_iff.mp
    ((commutator_mono hND le_rfl).trans (hc.trans le_sup_right))
  have hDN : D ≤ N := derived_le_of_pair a b hgen N ((le_sup_left : zpowers ⁅a,b⁆ ≤ N) (mem_zpowers _))
  have hNF : (zpowers c ⊔ frattini D).map D.subtype = D := by
    rw [Subgroup.map_sup, MonoidHom.map_zpowers]
    exact le_antisymm hND hDN
  have htop : zpowers c ⊔ frattini D = ⊤ := by
    apply map_subtype_inj.mp
    simpa only [← MonoidHom.range_eq_map, D.range_subtype] using hNF
  have hcgen := frattini_nongenerating htop
  have hmap := congrArg (Subgroup.map D.subtype) hcgen
  simpa only [MonoidHom.map_zpowers, ← MonoidHom.range_eq_map, D.range_subtype, c, D, Subgroup.coe_subtype] using hmap.symm

/-- The derived subgroup of a powerful finite two-group generated by `a,b`
is generated by their commutator. -/
public theorem IsPGroup.commutator_eq_zpowers_of_le_fourthPowers
    [Finite G] (hG : IsPGroup 2 G)
    (hpower : _root_.commutator G ≤ closure (Set.range (fun x : G => x ^ (4 : ℕ))))
    (a b : G) (hgen : zpowers a ⊔ zpowers b = ⊤) :
    _root_.commutator G = zpowers ⁅a,b⁆ :=
  commutator_eq_zpowers_of_two_generators_of_derived_frattini a b hgen
    (hG.commutator_derived_le_map_frattini_of_le_fourthPowers hpower)

/-- A powerful finite two-group generated by two elements has cyclic derived subgroup. -/
public theorem IsPGroup.isCyclic_commutator_of_le_fourthPowers
    [Finite G] (hG : IsPGroup 2 G)
    (hpower : _root_.commutator G ≤ closure (Set.range (fun x : G => x ^ (4 : ℕ))))
    (a b : G) (hgen : zpowers a ⊔ zpowers b = ⊤) :
    IsCyclic (_root_.commutator G) := by
  rw [hG.commutator_eq_zpowers_of_le_fourthPowers hpower a b hgen]
  infer_instance
