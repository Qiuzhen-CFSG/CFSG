module

public import Theory.GroupTheory.PGroup.CyclicFourSectionDerived

/-!
# Centralizing sections from a missing derived involution

For a normal four containing a central involution `z`, all commutators with
that four lie in the line generated by `z`. A subgroup containing the four
therefore centralizes it if its derived subgroup misses `z`.

A cyclic-four section with central kernel is abelian, and each of its
involutions centralizes the normal four. Apply the preceding observation
inside the involution centralizer to centralize the whole section.

Source: Janko–Thompson (1970), §4, printed p.390.
-/

open Subgroup
namespace Subgroup
/-- Missing the central involution in the derived subgroup forces centralization. -/
public theorem centralizes_four_of_central_involution_not_mem_derived
    {P : Type*} [Group P] [Finite P]
    (W C : Subgroup P) [W.Normal] (hW : Nat.card W = 4)
    (z : P) (hz : orderOf z = 2) (hzc : z ∈ center P) (hzW : z ∈ W)
    (hWC : W ≤ C) (hzD : z ∉ ⁅C, C⁆) : C ≤ centralizer (W : Set P) := by
  apply commutator_eq_bot_iff_le_centralizer.mp
  by_contra hne
  have hle : ⁅C, W⁆ ≤ zpowers z :=
    (commutator_mono le_top le_rfl).trans
      (normal_four_commutator_le_central_involution W hW z hz hzc hzW)
  have heq : ⁅C, W⁆ = zpowers z := by
    apply eq_of_le_of_card_ge hle
    have hc : Nat.card (⁅C, W⁆ : Subgroup P) ≠ 1 := fun hh => hne (card_eq_one.mp hh)
    have hp : 0 < Nat.card (⁅C, W⁆ : Subgroup P) := Nat.card_pos
    rw [Nat.card_zpowers, hz]
    omega
  exact hzD ((commutator_mono le_rfl hWC) (heq ▸ mem_zpowers z))

/-- A cyclic-four section centralizes the normal four when its involution
centralizer has no central involution in its derived subgroup. -/
public theorem cyclic_four_section_centralizes_of_not_mem_derived
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (W : Subgroup P) [W.Normal] [IsElementaryAbelian 2 W] (hW : Nat.card W = 4)
    (z : P) (hz : orderOf z = 2) (hzc : z ∈ center P) (hzW : z ∈ W)
    (K : Subgroup P) (Z : Subgroup K) [Z.Normal] [IsCyclic (K ⧸ Z)]
    (hquot : Nat.card (K ⧸ Z) = 4) (hZ : Z ≤ (center P).comap K.subtype)
    (t : K) (ht : t ^ 2 = 1)
    (hzD : z ∉ ⁅centralizer ({(t : P)} : Set P), centralizer ({(t : P)} : Set P)⁆) :
    K ≤ centralizer (W : Set P) := by
  let : IsMulCommutative K :=
    (QuotientGroup.mk' Z).isMulCommutative_of_isCyclic_of_ker_le_center (by
      rw [QuotientGroup.ker_mk']
      intro a ha
      exact mem_center_iff.mpr (fun k => Subtype.ext (mem_center_iff.mp (hZ ha) k)))
  have htW : (t : P) ∈ centralizer (W : Set P) :=
    involution_centralizes_normal_four_of_cyclic_four_section hP W hW K Z hquot
      (hZ.trans (comap_mono (center_le_centralizer _))) t ht
  have hWC : W ≤ centralizer ({(t : P)} : Set P) := by
    intro w hw
    exact mem_centralizer_singleton_iff.mpr (htW w hw)
  have hKC : K ≤ centralizer ({(t : P)} : Set P) := by
    intro k hk
    exact mem_centralizer_singleton_iff.mpr (setLike_mul_comm hk t.property)
  exact hKC.trans (centralizes_four_of_central_involution_not_mem_derived W _ hW
    z hz hzc hzW hWC hzD)
end Subgroup
