module
public import Theory.GroupTheory.PGroup.DihedralCentralFactor
public import Theory.GroupTheory.SpecificGroups.QuaternionCentralSquareEmbedding
public import Theory.GroupTheory.InvolutionSquareFusion
public import Theory.GroupTheory.WeaklyClosedInvolutionSimple

/-!
# Excluding a dihedral-quaternion central factor in a simple group

Let a Sylow two-subgroup be generated by a dihedral subgroup of order eight
and its generalized quaternion centralizer. Their common involution is the
only square of an element of order four, and every element centralizes an
element of order four. Sylow conjugacy in an involution centralizer then
shows that the common involution is weakly closed in the ambient group.

The intrinsic argument decomposes each element into commuting factor
elements. Dihedral squares lie in the common center of order two, while
the quaternion factor has a unique involution. A power of a quaternion
element of order greater than two has order four; an element of order at
most two is central and commutes with a fixed element of order four.

In a finite simple group, the Z-star theorem makes this involution central
in the whole group. Simplicity then makes the whole group abelian,
contradicting the embedded nonabelian dihedral subgroup.
Source: MacWilliams [12], as quoted in Janko–Thompson, Math. Z. 113 (1970),
1.2, printed pp.385–386, with the reference on p.397.
-/

open Subgroup

private theorem commuting_four_of_unique_involution
    {C : Type*} [Group C] [Finite C] (hC : IsPGroup 2 C)
    (z : C) (hz : z ≠ 1) (hz2 : z ^ 2 = 1)
    (hunique : ∀ x : C, x ^ 2 = 1 → x = 1 ∨ x = z)
    (q : C) (hq : orderOf q = 4) (c : C) :
    ∃ x : C, orderOf x = 4 ∧ Commute x c := by
  have hzcentral : z ∈ center C := by
    apply mem_center_iff.mpr
    intro a
    have hsq : (a * z * a⁻¹) ^ 2 = 1 := by
      simpa using congrArg (MulAut.conj a) hz2
    have hne : a * z * a⁻¹ ≠ 1 := by
      intro h
      exact hz ((MulAut.conj a).injective (h.trans (map_one _).symm))
    exact mul_inv_eq_iff_eq_mul.mp ((hunique _ hsq).resolve_left hne)
  by_cases hc : c ^ 2 = 1
  · rcases hunique c hc with rfl | rfl
    · exact ⟨q, hq, Commute.one_right q⟩
    · exact ⟨q, hq, mem_center_iff.mp hzcentral q⟩
  · obtain ⟨k, hk⟩ := hC.exists_orderOf_eq_pow c
    have hk2 : 2 ≤ k := by
      by_contra! h
      have hle : k = 0 ∨ k = 1 := by omega
      rcases hle with rfl | rfl
      · exact hc (by rw [orderOf_eq_one_iff.mp hk]; simp)
      · exact hc (by simpa only [hk, pow_one] using pow_orderOf_eq_one c)
    have hd : 4 ∣ orderOf c := by
      rw [hk]
      exact pow_dvd_pow 2 hk2
    refine ⟨c ^ (orderOf c / 4), orderOf_pow_orderOf_div (orderOf_pos c).ne' hd, ?_⟩
    exact (Commute.refl c).pow_left _

namespace Subgroup

/-- The dihedral-quaternion central product has a unique involution square,
and each element centralizes an element of order four. -/
public theorem dihedral_quaternion_factor_square_data
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (D : Subgroup P) (e : D ≃* DihedralGroup 4)
    (hgen : D ⊔ centralizer (D : Set P) = ⊤)
    (m : ℕ) (hm : 0 < m)
    (f : centralizer (D : Set P) ≃* QuaternionGroup m) :
    ∃ z : P, orderOf z = 2 ∧ z ∈ center P ∧
      (∀ x : P, orderOf x = 4 → x ^ 2 = z) ∧
      (∀ t : P, ∃ x : P, orderOf x = 4 ∧ Commute x t) := by
  let C := centralizer (D : Set P)
  let I : Subgroup P := D ⊓ C
  have hI : Nat.card I = 2 := card_inf_centralizer_of_dihedral D e
  obtain ⟨zI, hzI, hIz⟩ := (Nat.card_eq_two_iff' (1 : I)).mp hI
  let z : P := zI
  have hz : z ≠ 1 := fun h => hzI (Subtype.ext h)
  have hz2 : z ^ 2 = 1 := by
    exact congrArg Subtype.val (hI ▸ pow_card_eq_one' (x := zI))
  have hzin : z ∈ I := zI.property
  have hIcases (x : P) (hx : x ∈ I) : x = 1 ∨ x = z := by
    by_cases h : x = 1
    · exact Or.inl h
    · exact Or.inr (congrArg Subtype.val (hIz ⟨x, hx⟩ (fun he => h (congrArg Subtype.val he))))
  have hzcentral : z ∈ center P := by
    have hD : D ≤ centralizer ({z} : Set P) := by
      intro d hd
      exact mem_centralizer_singleton_iff.mpr (hzin.2 d hd)
    have hC : C ≤ centralizer ({z} : Set P) := by
      intro c hc
      exact mem_centralizer_singleton_iff.mpr (hc z hzin.1).symm
    have hall : (⊤ : Subgroup P) ≤ centralizer ({z} : Set P) := by
      rw [← hgen]
      exact sup_le hD hC
    exact mem_center_iff.mpr (fun p => mem_centralizer_singleton_iff.mp (hall (mem_top p)))
  let zC : C := ⟨z, hzin.2⟩
  have hzC : zC ≠ 1 := fun h => hz (congrArg Subtype.val h)
  have hzC2 : zC ^ 2 = 1 := Subtype.ext hz2
  have hCcases (x : C) (hx : x ^ 2 = 1) : x = 1 ∨ x = zC := by
    have hfz : f zC = QuaternionGroup.a m :=
      (QuaternionGroup.eq_one_or_eq_a_of_sq_eq_one hm (f zC)
        (by rw [← map_pow, hzC2, map_one])).resolve_left
        (fun h => hzC (f.injective (h.trans (map_one f).symm)))
    rcases QuaternionGroup.eq_one_or_eq_a_of_sq_eq_one hm (f x)
      (by rw [← map_pow, hx, map_one]) with hx1 | hxz
    · exact Or.inl (f.injective (hx1.trans (map_one f).symm))
    · exact Or.inr (f.injective (hxz.trans hfz.symm))
  have hd4 (d : D) : d ^ 4 = 1 := by
    apply e.injective
    simpa only [map_pow, map_one] using
      (show ∀ y : DihedralGroup 4, y ^ 4 = 1 from by decide) (e d)
  have hd2 (d : D) : (d : P) ^ 2 ∈ I := by
    refine ⟨D.pow_mem d.property 2, ?_⟩
    intro a ha
    have he : e ⟨a, ha⟩ * (e d) ^ 2 = (e d) ^ 2 * e ⟨a, ha⟩ :=
      (show ∀ a b : DihedralGroup 4, a * b ^ 2 = b ^ 2 * a from by decide) _ _
    have hh : (⟨a, ha⟩ : D) * d ^ 2 = d ^ 2 * ⟨a, ha⟩ := e.injective (by simpa using he)
    exact congrArg Subtype.val hh
  have hdecomp (x : P) : ∃ d : D, ∃ c : C, (d : P) * c = x := by
    have hx : x ∈ D ⊔ C := hgen ▸ mem_top x
    rw [← SetLike.mem_coe, coe_mul_of_right_le_normalizer_left D C
      (centralizer_le_normalizer (D : Set P))] at hx
    obtain ⟨d, hd, c, hc, he⟩ := hx
    exact ⟨⟨d, hd⟩, ⟨c, hc⟩, he⟩
  have hcomm (d : D) (c : C) : Commute (d : P) (c : P) := c.property d d.property
  refine ⟨z, orderOf_eq_prime hz2 hz, hzcentral, ?_, ?_⟩
  · intro x hx
    obtain ⟨d, c, rfl⟩ := hdecomp x
    have h4 : ((d : P) * c) ^ 4 = 1 := by
      rw [← hx]
      exact pow_orderOf_eq_one _
    have hc4 : c ^ 4 = 1 := by
      apply Subtype.ext
      change (c : P) ^ 4 = 1
      simpa only [(hcomm d c).mul_pow, show (d : P) ^ 4 = 1 from
        congrArg Subtype.val (hd4 d), one_mul] using h4
    have hc2 : (c : P) ^ 2 ∈ I := by
      rcases hCcases (c ^ 2) (by simpa only [← pow_mul] using hc4) with h | h
      · rw [show (c : P) ^ 2 = 1 from congrArg Subtype.val h]
        exact I.one_mem
      · rw [show (c : P) ^ 2 = z from congrArg Subtype.val h]
        exact hzin
    apply (hIcases _ (by rw [(hcomm d c).mul_pow]; exact I.mul_mem (hd2 d) hc2)).resolve_left
    intro h
    have hdvd := orderOf_dvd_of_pow_eq_one h
    rw [hx] at hdvd
    norm_num at hdvd
  · intro t
    obtain ⟨d, c, rfl⟩ := hdecomp t
    let : NeZero m := ⟨hm.ne'⟩
    let q : C := f.symm (QuaternionGroup.xa 0)
    have hq : orderOf q = 4 := by
      rw [MulEquiv.orderOf_eq, QuaternionGroup.orderOf_xa]
    obtain ⟨x, hx, hxc⟩ := commuting_four_of_unique_involution (hP.to_subgroup C)
      zC hzC hzC2 hCcases q hq c
    exact ⟨x, (Subgroup.orderOf_coe x).trans hx,
      (hcomm d x).symm.mul_right (hxc.map C.subtype)⟩

end Subgroup

namespace Sylow

/-- A dihedral factor with generalized quaternion centralizer supplies an
ambient weakly closed central involution. -/
public theorem exists_weakly_closed_involution_of_dihedral_quaternion_factor
    {G : Type*} [Group G] [Finite G]
    (S : Sylow 2 G) (D : Subgroup S) (e : D ≃* DihedralGroup 4)
    (hgen : D ⊔ centralizer (D : Set S) = ⊤)
    (m : ℕ) (hm : 0 < m)
    (f : centralizer (D : Set S) ≃* QuaternionGroup m) :
    ∃ z : S, orderOf z = 2 ∧ z ∈ center S ∧
      ∀ t : S, IsConj (z : G) (t : G) → t = z := by
  obtain ⟨z, hz, hzC, hsquare, hroot⟩ :=
    dihedral_quaternion_factor_square_data S.isPGroup' D e hgen m hm f
  refine ⟨z, hz, hzC, ?_⟩
  intro t ht
  have horder : orderOf t = 2 := by
    obtain ⟨g, hg⟩ := ht
    rw [← Subgroup.orderOf_coe, ← hg.orderOf_eq (g : G), Subgroup.orderOf_coe, hz]
  exact S.eq_of_isConj_of_unique_involution_square z hzC hsquare
    (fun t _ => hroot t) t horder ht.symm

set_option linter.unusedVariables false in
/-- A Sylow two-subgroup of a finite simple group cannot be generated by a
dihedral subgroup of order eight and its generalized quaternion centralizer.
The rank and normality hypotheses retain the central-factor exclusion interface;
the weak-closure argument proves the exclusion without using them. -/
public theorem dihedral_quaternion_central_factor_false
    {G : Type*} [Group G] [Finite G] [IsSimpleGroup G]
    (S : Sylow 2 G)
    (hrank : ∀ A : Subgroup S, IsElementaryAbelian 2 A → Nat.card A < 8)
    (D : Subgroup S) [D.Normal] (e : D ≃* DihedralGroup 4)
    (hgen : D ⊔ centralizer (D : Set S) = ⊤)
    (n : ℕ) (hn : 3 ≤ n)
    (hf : Nonempty (centralizer (D : Set S) ≃* QuaternionGroup (2 ^ (n - 2)))) :
    False := by
  obtain ⟨f⟩ := hf
  obtain ⟨z, hz, hzC, hweak⟩ :=
    S.exists_weakly_closed_involution_of_dihedral_quaternion_factor D e hgen
      (2 ^ (n - 2)) (by positivity) f
  have hzG := S.weakly_closed_involution_mem_center_of_simple z hz hzC hweak
  have hcenter : center G = ⊤ := by
    apply (inferInstance : (center G).Normal).eq_bot_or_eq_top.resolve_left
    intro hb
    have hzone : z = 1 := Subtype.ext (by
      change (z : G) = 1
      simpa only [hb, mem_bot] using hzG)
    simp [hzone] at hz
  let : IsMulCommutative G := center_eq_top_iff.mp hcenter
  let a := e.symm (DihedralGroup.r 1)
  let b := e.symm (DihedralGroup.sr 0)
  have hab : a * b = b * a := by
    apply Subtype.ext
    apply Subtype.ext
    exact mul_comm' _ _
  have he := congrArg e hab
  simp only [map_mul, a, b, e.apply_symm_apply] at he
  exact (by decide : (DihedralGroup.r 1 : DihedralGroup 4) * DihedralGroup.sr 0 ≠
    DihedralGroup.sr 0 * DihedralGroup.r 1) he

end Sylow
