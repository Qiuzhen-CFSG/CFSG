module

public import Theory.GroupTheory.PGroup.NormalEightQuaternionFactorReduction
public import Theory.GroupTheory.PGroup.NormalEightQuaternionFactorCentralizer

/-!
# Involution squares in quaternion central products

Every square centralizes a quaternion factor of order eight, and also the
second omega of every normal abelian subgroup. Thus a normal abelian base
whose second omega has no larger centralizer inside the commuting factor
contains all squares. Its involutions are central under the no-normal-eight
and central-omega-four hypotheses.

Such a base exists in every finite two-group under these hypotheses, and
the second-omega centralizer theorem supplies the required bound. Hence every
element whose fourth power is one has central square.

This establishes the square-bound consequence of the centralizer equality
in MacWilliams, Trans. AMS 150 (1970), §3(iv), 1.2.2, printed pp.368–369,
`refs/original/n-group-global/odd-core-rank-two-source/macwilliams-1970-ams-wayback.pdf`.
-/

open Subgroup

namespace Subgroup

/-- The second-omega centralizer bound places every involution square in the
center. No fusion or ambient simple-group hypothesis is needed. -/
public theorem quaternion_factor_squares_central_of_omega_two_centralizer
    {P : Type*} [Group P] [Finite P]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (Q : Subgroup P) (e : Q ≃* QuaternionGroup 2)
    (hgen : Q ⊔ centralizer (Q : Set P) = ⊤)
    (B : Subgroup P) [B.Normal] [IsMulCommutative B]
    (hcut : centralizer (Q : Set P) ⊓
      centralizer (((omega B (p := 2) 2).map B.subtype : Subgroup P) : Set P) ≤ B) :
    ∀ v : P, v ^ 4 = 1 → v ^ 2 ∈ center P := by
  intro v hv
  have hb : v ^ 2 ∈ B := hcut ⟨quaternion_factor_square_centralizes Q e hgen v,
    square_centralizes_omega_two_normal_abelian hno hZ B v⟩
  exact normal_abelian_involution_central hno hZ B _ hb
    (by simpa only [← pow_mul] using hv)

/-- If the abelian base has exponent at most four, its second omega is the
whole base, so the square bound needs no additional centralizer argument. -/
public theorem quaternion_factor_squares_central_of_base_exponent_four
    {P : Type*} [Group P] [Finite P]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (Q : Subgroup P) (e : Q ≃* QuaternionGroup 2)
    (hgen : Q ⊔ centralizer (Q : Set P) = ⊤)
    (B : Subgroup P) [B.Normal] [IsMulCommutative B]
    (hCB : centralizer (Q : Set P) ⊓ centralizer (B : Set P) ≤ B)
    (hfour : ∀ b : B, b ^ 4 = 1) :
    ∀ v : P, v ^ 4 = 1 → v ^ 2 ∈ center P := by
  apply quaternion_factor_squares_central_of_omega_two_centralizer hno hZ Q e hgen B
  have hO : omega B (p := 2) 2 = ⊤ := by
    apply top_unique
    intro b _
    exact subset_closure (hfour b)
  simpa only [hO, ← MonoidHom.range_eq_map, range_subtype] using hCB

/-- In a finite two-group generated by a quaternion subgroup of order eight
and its centralizer, the absence of normal elementary eights and central
first omega of order four force every involution square to be central. -/
public theorem quaternion_factor_squares_central
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (Q : Subgroup P) (e : Q ≃* QuaternionGroup 2)
    (hgen : Q ⊔ centralizer (Q : Set P) = ⊤) :
    ∀ v : P, v ^ 4 = 1 → v ^ 2 ∈ center P := by
  obtain ⟨B, hBn, hBa, hBD, -, hCB, -, -⟩ :=
    exists_quaternion_factor_abelian_base hP hno hZ Q hgen
  let : B.Normal := hBn
  let : IsMulCommutative B := hBa
  exact quaternion_factor_squares_central_of_omega_two_centralizer hno hZ Q e hgen B
    (quaternion_factor_omega_two_centralizer_le hP hno hZ Q e hgen B hBD hCB)

end Subgroup
