module

public import Theory.GroupTheory.PGroup.NormalEightAbelianReduction
public import Theory.GroupTheory.PGroup.RelativeNormalAbelian
public import Theory.GroupTheory.PGroup.CentralProductCore
public import Theory.GroupTheory.PGroup.OmegaAction
public import Theory.GroupTheory.QuaternionCentralFactorRoots

/-!
# Abelian bases in quaternion central products without normal eights

Suppose a finite two-group is generated by a quaternion subgroup `Q` of
order eight and its centralizer `D`, has no normal elementary subgroup of
order at least eight, and has central first omega of order four.

There is an ambient-normal abelian subgroup `B` of `D`, containing the
center and self-centralizing in `D`. Its first omega is the central four.
The quaternion involution cannot be a square in any ambient-normal abelian
subgroup of `D`: adjoining a quaternion square root would give a normal
abelian subgroup with a noncentral involution.

Every ambient square centralizes `Q` and the second omega of every normal
abelian subgroup. The latter follows because conjugation fixes involutions:
the displacement of a fourth root is then a fixed involution.

Source: MacWilliams, *On 2-groups and Sylow 2-subgroups of finite groups*,
Trans. AMS 150 (1970), §3(iv), printed pp.368–369, especially 1.2.1,
`refs/original/n-group-global/odd-core-rank-two-source/macwilliams-1970-ams-wayback.pdf`.
-/

open Subgroup
open scoped IsMulCommutative

namespace Subgroup

/-- Every involution in a normal abelian subgroup is central. -/
public theorem normal_abelian_involution_central {P : Type*} [Group P] [Finite P]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (B : Subgroup P) [B.Normal] [IsMulCommutative B]
    (b : P) (hb : b ∈ B) (hb2 : b ^ 2 = 1) : b ∈ center P := by
  let O := omega₁ B (p := 2)
  let : O.Characteristic := omega₁_characteristic _
  let : IsElementaryAbelian 2 O := IsElementaryAbelian.omega₁_of_isMulCommutative _
  let E := O.map B.subtype
  let : E.Normal := ConjAct.normal_of_characteristic_of_normal
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.map_subtype
  apply map_subtype_le _ (normal_elementary_le_omega_center_of_no_normal_eight hno hZ E ?_)
  exact ⟨⟨b, hb⟩, subset_closure (Subtype.ext hb2), rfl⟩

/-- A squared action fixes fourth roots if the action fixes involutions. -/
private theorem aut_square_fixed_fourth_roots {A : Type*} [Group A] [IsMulCommutative A]
    (f : MulAut A) (hfix : ∀ a : A, a ^ 2 = 1 → f a = a)
    (a : A) (ha : a ^ 4 = 1) : (f ^ 2) a = a := by
  have ha2 : (a ^ 2) ^ 2 = 1 := by simpa only [← pow_mul] using ha
  have hd : (a⁻¹ * f a) ^ 2 = 1 := by
    rw [mul_pow, inv_pow, ← map_pow, hfix _ ha2, inv_mul_cancel]
  have hf := hfix _ hd
  rw [map_mul, map_inv] at hf
  change f (f a) = a
  calc
    f (f a) = f a * (a⁻¹ * f a) := by rw [← hf]; simp
    _ = a * (a⁻¹ * f a) ^ 2 := by simp only [pow_two]; group
    _ = a := by rw [hd, mul_one]

/-- Ambient squares centralize fourth roots in a normal abelian subgroup. -/
public theorem square_centralizes_omega_two_normal_abelian
    {P : Type*} [Group P] [Finite P]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (B : Subgroup P) [B.Normal] [IsMulCommutative B] (g : P) :
    g ^ 2 ∈ centralizer (((omega B (p := 2) 2).map B.subtype : Subgroup P) : Set P) := by
  rintro _ ⟨b, hb, rfl⟩
  have hb4 : b ^ 4 = 1 := by
    rw [OmegaAction.omega_eq_pow_ker] at hb
    exact hb
  have hfix (b : B) (hb : b ^ 2 = 1) : MulAut.conjNormal g b = b := by
    apply Subtype.ext
    change g * (b : P) * g⁻¹ = b
    have hc := normal_abelian_involution_central hno hZ B b b.property
      (congrArg Subtype.val hb)
    rw [mem_center_iff.mp hc g, mul_inv_cancel_right]
  have hf := aut_square_fixed_fourth_roots (MulAut.conjNormal g) hfix b hb4
  rw [← map_pow] at hf
  have he := congrArg Subtype.val hf
  change g ^ 2 * (b : P) * (g ^ 2)⁻¹ = b at he
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

/-- Every ambient square centralizes a quaternion factor of order eight. -/
public theorem quaternion_factor_square_centralizes
    {P : Type*} [Group P] (Q : Subgroup P) (e : Q ≃* QuaternionGroup 2)
    (hgen : Q ⊔ centralizer (Q : Set P) = ⊤) (g : P) :
    g ^ 2 ∈ centralizer (Q : Set P) := by
  let : Q.Normal := normal_of_centralizing_sup_eq_top Q (centralizer (Q : Set P)) hgen le_rfl
  obtain ⟨q, hq, c, hc, rfl⟩ := mem_sup_of_normal_right.mp
    (show g ∈ Q ⊔ centralizer (Q : Set P) by rw [hgen]; trivial)
  have hqc : Commute q c := hc q hq
  rw [hqc.mul_pow]
  apply (centralizer (Q : Set P)).mul_mem _ ((centralizer (Q : Set P)).pow_mem hc 2)
  intro t ht
  have he : Commute (e (⟨t, ht⟩ : Q)) ((e (⟨q, hq⟩ : Q)) ^ 2) :=
    (show ∀ a b : QuaternionGroup 2, a * b ^ 2 = b ^ 2 * a from by decide) _ _
  have he' : (⟨t, ht⟩ : Q) * (⟨q, hq⟩ : Q) ^ 2 = (⟨q, hq⟩ : Q) ^ 2 * (⟨t, ht⟩ : Q) :=
    e.injective (by simpa only [map_mul, map_pow] using he.eq)
  exact congrArg Subtype.val he'

/-- A commuting factor has an ambient-normal abelian self-centralizer
containing the center, with first omega equal to the central four. -/
public theorem exists_quaternion_factor_abelian_base
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (Q : Subgroup P) (hgen : Q ⊔ centralizer (Q : Set P) = ⊤) :
    ∃ B : Subgroup P, B.Normal ∧ IsMulCommutative B ∧
      B ≤ centralizer (Q : Set P) ∧ center P ≤ B ∧
      centralizer (Q : Set P) ⊓ centralizer (B : Set P) ≤ B ∧
      (omega₁ B (p := 2)).map B.subtype =
        (omega₁ (center P) (p := 2)).map (center P).subtype ∧
      Nat.card (omega₁ B (p := 2)) = 4 := by
  let : Q.Normal := normal_of_centralizing_sup_eq_top Q (centralizer (Q : Set P)) hgen le_rfl
  obtain ⟨B, hZB, hBD, hBn, hBa, -, hCB⟩ :=
    exists_ambient_normal_abelian_selfCentralizing_containing hP (centralizer (Q : Set P))
      (center P) (center_le_centralizer _) inferInstance inferInstance
  let : B.Normal := hBn
  let : IsMulCommutative B := hBa
  have hEq : (omega₁ B (p := 2)).map B.subtype =
      (omega₁ (center P) (p := 2)).map (center P).subtype := by
    apply le_antisymm
    · let : (omega₁ B (p := 2)).Characteristic := omega₁_characteristic _
      let : IsElementaryAbelian 2 (omega₁ B (p := 2)) :=
        IsElementaryAbelian.omega₁_of_isMulCommutative _
      let : ((omega₁ B (p := 2)).map B.subtype).Normal :=
        ConjAct.normal_of_characteristic_of_normal
      let : IsElementaryAbelian 2 ((omega₁ B (p := 2)).map B.subtype) :=
        IsElementaryAbelian.map_subtype
      exact normal_elementary_le_omega_center_of_no_normal_eight hno hZ _
    · rintro x ⟨z, hz, rfl⟩
      let : IsElementaryAbelian 2 (omega₁ (center P) (p := 2)) :=
        IsElementaryAbelian.omega₁_of_isMulCommutative _
      refine ⟨⟨z, hZB z.property⟩, subset_closure ?_, rfl⟩
      apply Subtype.ext
      exact congrArg (fun t : center P => (t : P))
        (elemPow_eq_one_of_isElementaryAbelian (p := 2) z hz)
  refine ⟨B, hBn, hBa, hBD, hZB, hCB, hEq, ?_⟩
  have hc := congrArg (fun H : Subgroup P => Nat.card H) hEq
  simpa only [card_map_of_injective B.subtype_injective,
    card_map_of_injective (center P).subtype_injective, hZ] using hc

/-- The quaternion involution is not a square in any ambient-normal abelian
subgroup of the quaternion centralizer. -/
public theorem quaternion_factor_involution_not_square_in_normal_abelian
    {P : Type*} [Group P] [Finite P]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (Q : Subgroup P) (e : Q ≃* QuaternionGroup 2)
    (hgen : Q ⊔ centralizer (Q : Set P) = ⊤)
    (z : Q) (hz : orderOf z = 2)
    (B : Subgroup P) [B.Normal] [IsMulCommutative B]
    (hBD : B ≤ centralizer (Q : Set P)) :
    ¬ ∃ b : B, (b : P) ^ 2 = z := by
  obtain ⟨-, hroot⟩ := quaternion_central_factor_involution_roots Q e hgen z hz
  obtain ⟨y, hy, -⟩ := hroot 1
  have hez : e z = QuaternionGroup.a 2 :=
    QuaternionGroup.eq_a_two_of_orderOf_eq_two _ ((e.orderOf_eq z).trans hz)
  have hey : (e y) ^ 2 = QuaternionGroup.a 2 := by
    rw [← map_pow, show y ^ 2 = z from Subtype.ext hy, hez]
  let : Q.Normal := normal_of_centralizing_sup_eq_top Q (centralizer (Q : Set P)) hgen le_rfl
  have hconj (g : P) : g * (y : P) * g⁻¹ = y ∨ g * (y : P) * g⁻¹ = (y : P)⁻¹ := by
    obtain ⟨q, hq, c, hc, rfl⟩ := mem_sup_of_normal_right.mp
      (show g ∈ Q ⊔ centralizer (Q : Set P) by rw [hgen]; trivial)
    have hcy : Commute (y : P) c := hc y y.property
    have hh : (q * c) * (y : P) * (q * c)⁻¹ = q * (y : P) * q⁻¹ := by
      simp only [mul_inv_rev]
      calc
        q * c * (y : P) * (c⁻¹ * q⁻¹) = q * (c * (y : P)) * c⁻¹ * q⁻¹ := by group
        _ = _ := by rw [← hcy.eq]; group
    rw [hh]
    have he := (show ∀ a b : QuaternionGroup 2,
      a * b * a⁻¹ = b ∨ a * b * a⁻¹ = b⁻¹ from by decide) (e ⟨q, hq⟩) (e y)
    rcases he with he | he
    · left
      have ht : (⟨q, hq⟩ : Q) * y * (⟨q, hq⟩ : Q)⁻¹ = y :=
        e.injective (by simpa only [map_mul, map_inv] using he)
      exact congrArg Subtype.val ht
    · right
      have ht : (⟨q, hq⟩ : Q) * y * (⟨q, hq⟩ : Q)⁻¹ = y⁻¹ :=
        e.injective (by simpa only [map_mul, map_inv] using he)
      exact congrArg Subtype.val ht
  let Y := zpowers (y : P)
  let : Y.Normal := normal_iff_map_conj_eq.mpr (by
    intro g
    change (zpowers (y : P)).map (MulAut.conj g).toMonoidHom = zpowers (y : P)
    rw [MonoidHom.map_zpowers]
    change zpowers (g * (y : P) * g⁻¹) = zpowers (y : P)
    rcases hconj g with h | h <;> rw [h]
    exact zpowers_inv)
  let A := Y ⊔ B
  have hBY : B ≤ centralizer (Y : Set P) :=
    hBD.trans (centralizer_le (zpowers_le.mpr y.property))
  let : IsMulCommutative A := le_centralizer_iff_isMulCommutative.mp (by
    apply sup_le
    · exact le_centralizer_iff.mpr (sup_le Y.le_centralizer hBY)
    · exact le_centralizer_iff.mpr (sup_le (le_centralizer_iff.mp hBY) B.le_centralizer))
  rintro ⟨b, hb⟩
  have hbi : Commute (y : P) (b : P)⁻¹ := (show Commute (y : P) (b : P) from hBD b.property y y.property).inv_right
  have htA : (y : P) * (b : P)⁻¹ ∈ A :=
    A.mul_mem ((le_sup_left : Y ≤ A) (mem_zpowers _))
      ((le_sup_right : B ≤ A) (B.inv_mem b.property))
  have ht2 : ((y : P) * (b : P)⁻¹) ^ 2 = 1 := by
    rw [hbi.mul_pow, inv_pow, hy, hb, mul_inv_cancel]
  have htZ := normal_abelian_involution_central hno hZ A _ htA ht2
  have hyD : (y : P) ∈ centralizer (Q : Set P) := by
    have hh := (centralizer (Q : Set P)).mul_mem (center_le_centralizer _ htZ) (hBD b.property)
    simpa only [inv_mul_cancel_right] using hh
  obtain ⟨t, ht⟩ := (show ∀ a : QuaternionGroup 2, a ^ 2 = QuaternionGroup.a 2 →
    ∃ t : QuaternionGroup 2, t * a ≠ a * t from by decide) (e y) hey
  apply ht
  have hh : e.symm t * y = y * e.symm t :=
    Subtype.ext (hyD (e.symm t) (e.symm t).property)
  simpa only [map_mul, e.apply_symm_apply] using congrArg e hh

end Subgroup
