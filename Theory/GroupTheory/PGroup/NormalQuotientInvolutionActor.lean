module
public import Theory.Comparator.Defs
public import Theory.ElementaryAbelian.Basic
public import Theory.GroupTheory.PGroup.NormalSubgroups

/-!
# An involution with a normal extension of a prescribed two-subgroup

Let `A` and `Q` be normal subgroups of a finite two-group `S`, with `A`
elementary abelian and not contained in `Q`. There is an involution `x`
in `A` outside `Q` such that `Q⟨x⟩` is normal in `S`.

The nontrivial normal image of `A` in `S/Q` meets the center nontrivially.
Lift such a central element to `A`; its lift has order two since `A` is
elementary abelian. The subgroup `Q⟨x⟩` is the preimage of the central
cyclic subgroup generated by its image, and hence is normal.

This is the single-actor selection used between Stellmacher (3.4) and
(1.3) in the proof of (9.1), Journal of Algebra 190 (1997), p.47. The
normal subgroup to which (3.4) applies is `Q⟨x⟩`.
-/

namespace Subgroup
public theorem exists_involution_normal_sup_of_elementary_not_le
    {S : Type*} [Group S] [Finite S] (hS : IsPGroup 2 S)
    (A Q : Subgroup S) [A.Normal] [Q.Normal] [IsElementaryAbelian 2 A]
    (hAQ : ¬ A ≤ Q) :
    ∃ x ∈ A, IsInvolution x ∧ x ∉ Q ∧ (Q ⊔ zpowers x).Normal := by
  classical
  let q := QuotientGroup.mk' Q
  let B := A.map q
  let _ : B.Normal := inferInstance
  have hBne : B ≠ ⊥ := by
    intro h
    apply hAQ
    simpa [q] using (map_eq_bot_iff (f := q) A).mp h
  let _ : Nontrivial B := (nontrivial_iff_ne_bot B).mpr hBne
  let _ : Fact (IsPGroup 2 (S ⧸ Q)) := ⟨hS.to_quotient Q⟩
  obtain ⟨b, hbne, hbcenter⟩ := exists_nontrivial_center_mem_normal B (p := 2)
  obtain ⟨x, hx, hxb⟩ := b.property
  have hxQ : x ∉ Q := by
    intro hxQ
    apply hbne
    apply Subtype.ext
    exact hxb.symm.trans ((QuotientGroup.eq_one_iff x).mpr hxQ)
  have hxne : x ≠ 1 := by
    intro h
    exact hxQ (h ▸ Q.one_mem)
  have hxinv : IsInvolution x := ⟨hxne, elemPow_eq_one_of_isElementaryAbelian x hx⟩
  have hcenter : zpowers (q x) ≤ center (S ⧸ Q) :=
    zpowers_le.mpr (hxb ▸ hbcenter)
  have hnormal : (zpowers (q x)).Normal := by
    constructor
    intro z hz g
    have hc := mem_center_iff.mp (hcenter hz) g
    simpa [hc, mul_assoc] using hz
  have hpre : (zpowers (q x)).comap q = Q ⊔ zpowers x := by
    rw [← MonoidHom.map_zpowers, comap_map_eq]
    simp only [q, QuotientGroup.ker_mk', sup_comm]
  exact ⟨x, hx, hxinv, hxQ, hpre ▸ hnormal.comap q⟩
end Subgroup
