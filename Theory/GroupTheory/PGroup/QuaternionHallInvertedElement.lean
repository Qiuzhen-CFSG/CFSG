module

public import Theory.GroupTheory.PGroup.SymplecticType
public import Theory.GroupTheory.PGroup.CyclicInvolution
public import Theory.GroupTheory.SemidihedralCenter
public import Theory.GroupTheory.SpecificGroups.QuaternionCentralSquareEmbedding
public import Mathlib.GroupTheory.GroupAction.ConjAct

/-!
# Inverted elements in quaternion–Hall products

Let H be a normal subgroup with cyclic center, generated by commuting factors
B and D, where B is quaternion of order eight and D is a noncyclic binary Hall
factor of order at least sixteen. An involution normalizing the embedded D,
whose ambient centralizer is elementary abelian, inverts an order-four element
of B. Its square is central in H.

The Hall models show that every element of Z(D) squares to one. Both factor
centers lie in the cyclic center of H, so Z(D) lies in the quaternion factor.
Decomposing elements of H then gives C_H(D) = B. Thus conjugation by the
involution preserves B. A kernel-checked table of the sixty-four possible
pairs of quaternion generator images proves that an involutory quaternion
automorphism with no fixed order-four element inverts an order-four element.
Centrality of its square follows from the commuting product.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, p.392, Case 1
(`refs/original/n-group-global/odd-core-rank-two-source/janko-thompson-1970-gdz.pdf`).
The quaternion normal-form encoding follows `SpecificGroups/QuaternionEightAut`;
the Hall center calculations follow `PGroup/LargeHallRotationStructure`.
-/

open Subgroup

/-- Central elements of a large noncyclic binary Hall factor square to one. -/
public theorem IsBinaryHallFactor.sq_eq_one_of_mem_center_of_large {G : Type*} [Group G] [Finite G]
    (hG : IsBinaryHallFactor G) (hnc : ¬ IsCyclic G) (hlarge : 16 ≤ Nat.card G) :
    ∀ z ∈ center G, z ^ 2 = (1 : G) := by
  have transport {K : Type} [Group K] (e : G ≃* K)
      (hK : ∀ z ∈ center K, z ^ 2 = (1 : K)) : ∀ z ∈ center G, z ^ 2 = (1 : G) := by
    intro z hz
    apply e.injective
    rw [map_pow, map_one]
    apply hK
    apply mem_center_iff.mpr
    intro k
    obtain ⟨g, rfl⟩ := e.surjective k
    simpa only [map_mul] using congrArg e (mem_center_iff.mp hz g)
  rcases hG with hcyc | ⟨n, hn, ⟨e⟩⟩ | ⟨m, ⟨e⟩⟩ | ⟨n, hn, _, a, b, ha, hb, hc, hg⟩
  · exact (hnc hcyc).elim
  · apply transport e
    apply QuaternionGroup.sq_eq_one_of_mem_center
    have hcard : Nat.card G = 4 * 2 ^ (n - 2) := by
      rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
    omega
  · apply transport e
    intro z hz
    cases z with
    | r i =>
      have hi : i = -i := by simpa using mem_center_iff.mp hz (DihedralGroup.sr 0)
      simp only [pow_two, DihedralGroup.r_mul_r, DihedralGroup.one_def]
      congr 1
      linear_combination hi
    | sr i => simp only [pow_two, DihedralGroup.sr_mul_self]
  · intro z hz
    rw [Semidihedral.center_eq hn a b ha hb hc hg] at hz
    obtain ⟨i, rfl⟩ := hz
    have hs : (a ^ (2 ^ (n - 2))) ^ 2 = 1 := by
      rw [← pow_mul, ← pow_succ, show n - 2 + 1 = n - 1 by omega, ← ha]
      exact pow_orderOf_eq_one a
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hs, one_zpow]

private abbrev Q := QuaternionGroup 2
private def pairMap (p : Q × Q) : Q → Q
  | .a i => p.1 ^ i.val
  | .xa i => p.2 * p.1 ^ i.val

set_option maxRecDepth 10000 in
set_option maxHeartbeats 800000 in
private theorem pair_inverted : ∀ p : Q × Q,
    (∀ x : Q, pairMap p (pairMap p x) = x) →
    (∀ x : Q, pairMap p x = x → x ^ 2 = 1) →
    ∃ x : Q, x ^ 2 ≠ 1 ∧ x ^ 4 = 1 ∧ pairMap p x = x⁻¹ := by
  decide

private theorem quaternion_inverted (e : MulAut Q)
    (he : ∀ x, e (e x) = x) (hf : ∀ x, e x = x → x ^ 2 = 1) :
    ∃ x : Q, orderOf x = 4 ∧ e x = x⁻¹ := by
  have hp : ∀ x, pairMap (e (.a 1), e (.xa 0)) x = e x := by
    intro x
    cases x with
    | a i =>
      change (e (.a 1)) ^ i.val = e (.a i)
      rw [← map_pow, QuaternionGroup.a_one_pow, ZMod.natCast_zmod_val]
    | xa i =>
      change e (.xa 0) * (e (.a 1)) ^ i.val = e (.xa i)
      rw [← map_pow, ← map_mul, QuaternionGroup.a_one_pow, ZMod.natCast_zmod_val,
        QuaternionGroup.xa_mul_a, zero_add]
  obtain ⟨x, hx2, hx4, hx⟩ := pair_inverted (e (.a 1), e (.xa 0))
    (by simpa only [hp] using he) (by simpa only [hp] using hf)
  refine ⟨x, ?_, by simpa only [hp] using hx⟩
  exact orderOf_eq_prime_pow (p := 2) (n := 1) hx2 hx4

private theorem factor_center_mem {G : Type*} [Group G]
    (A D : Subgroup G) (hc : D ≤ centralizer (A : Set G)) (hg : A ⊔ D = ⊤)
    (z : A) (hz : z ∈ center A) : (z : G) ∈ center G := by
  have ht : (⊤ : Subgroup G) ≤ centralizer ({(z : G)} : Set G) := by
    rw [← hg]
    apply sup_le
    · intro a ha
      apply mem_centralizer_singleton_iff.mpr
      exact congrArg Subtype.val (mem_center_iff.mp hz (⟨a, ha⟩ : A))
    · intro d hd
      exact mem_centralizer_singleton_iff.mpr (hc hd z z.property).symm
  exact mem_center_iff.mpr (fun g => mem_centralizer_singleton_iff.mp (ht (mem_top g)))

private theorem quaternion_square_center (b : Q) : b ^ 2 ∈ center Q := by
  have h : ∀ b c : Q, c * b ^ 2 = b ^ 2 * c := by decide
  exact mem_center_iff.mpr (h b)

private theorem quaternion_factor_square_center {G : Type*} [Group G]
    (B D : Subgroup G) (e : B ≃* Q)
    (hc : D ≤ centralizer (B : Set G)) (hg : B ⊔ D = ⊤) (b : B) :
    (b : G) ^ 2 ∈ center G := by
  rw [← Subgroup.coe_pow]
  apply factor_center_mem B D hc hg (b ^ 2)
  apply mem_center_iff.mpr
  intro c
  apply e.injective
  simpa only [map_mul, map_pow] using mem_center_iff.mp (quaternion_square_center (e b)) (e c)

private theorem quaternion_centralizer_eq {G : Type*} [Group G] [Finite G]
    [IsCyclic (center G)] (B D : Subgroup G) [D.Normal] (e : B ≃* Q)
    (hD : ∀ z ∈ center D, z ^ 2 = (1 : D))
    (hc : D ≤ centralizer (B : Set G)) (hg : B ⊔ D = ⊤) :
    centralizer (D : Set G) = B := by
  let b : B := e.symm (.a 1)
  have hb : orderOf b = 4 := by
    dsimp [b]
    rw [e.symm.orderOf_eq, QuaternionGroup.orderOf_a_one]
  have hbZ := quaternion_factor_square_center B D e hc hg b
  have hZB : ∀ d : D, d ∈ center D → (d : G) ∈ B := by
    intro d hd
    by_cases h1 : d = 1
    · simp [h1]
    have hdZ : (d : G) ∈ center G :=
      factor_center_mem D B (le_centralizer_iff.mp hc) (sup_comm B D ▸ hg) d hd
    have heq : (d : G) = (b : G) ^ 2 := by
      apply congrArg Subtype.val (IsCyclic.eq_of_orderOf_eq_two
        (x := (⟨(d : G), hdZ⟩ : center G))
        (y := (⟨(b : G) ^ 2, hbZ⟩ : center G)) ?_ ?_)
      · apply orderOf_eq_prime
        · apply Subtype.ext
          simpa only [coe_pow, coe_one] using congrArg Subtype.val (hD d hd)
        · intro he
          apply h1
          have he' : (d : G) = 1 := congrArg (fun z : center G => (z : G)) he
          exact Subtype.ext he'
      · rw [← orderOf_coe, orderOf_pow, orderOf_coe, hb]
        decide
    rw [heq]
    exact B.pow_mem b.property 2
  apply le_antisymm _ (le_centralizer_iff.mp hc)
  intro x hx
  obtain ⟨a, ha, d, hd, rfl⟩ := mem_sup_of_normal_right.mp
    (show x ∈ B ⊔ D by rw [hg]; trivial)
  apply B.mul_mem ha
  apply hZB ⟨d, hd⟩
  apply mem_center_iff.mpr
  intro y
  apply Subtype.ext
  apply mul_left_cancel (a := a)
  calc
    a * ((y : G) * d) = (y : G) * (a * d) := by
      rw [← mul_assoc, hc y.property a ha, mul_assoc]
    _ = (a * d) * y := hx y y.property
    _ = a * (d * y) := mul_assoc _ _ _

private theorem quaternion_inverted_of_equiv {G : Type*} [Group G]
    (model : G ≃* Q) (f : MulAut G) (hf : ∀ x, f (f x) = x)
    (hfixed : ∀ x, f x = x → x ^ 2 = 1) :
    ∃ x : G, orderOf x = 4 ∧ f x = x⁻¹ := by
  let e := MulAut.congr model f
  have he (x : Q) : e x = model (f (model.symm x)) := rfl
  obtain ⟨q, hq, hi⟩ := quaternion_inverted e
    (by intro x; simp only [he, model.symm_apply_apply, hf, model.apply_symm_apply])
    (by
      intro x hx
      have hx' : f (model.symm x) = model.symm x := by
        apply model.injective
        simpa only [he, model.apply_symm_apply] using hx
      have hs := congrArg model (hfixed _ hx')
      simpa only [map_pow, map_one, model.apply_symm_apply] using hs)
  refine ⟨model.symm q, by simpa only [model.symm.orderOf_eq] using hq, ?_⟩
  apply model.injective
  simpa only [he, map_inv, model.apply_symm_apply] using hi

/-- In a commuting product with cyclic center, the centralizer of a large
noncyclic Hall factor is its quaternion-eight supplement. -/
public theorem Subgroup.centralizer_eq_quaternion_factor_of_large_hall
    {G : Type*} [Group G] [Finite G] [IsCyclic (center G)]
    (B D : Subgroup G) [D.Normal] (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hD : IsBinaryHallFactor D) (hnc : ¬ IsCyclic D) (hlarge : 16 ≤ Nat.card D)
    (hc : D ≤ centralizer (B : Set G)) (hg : B ⊔ D = ⊤) :
    centralizer (D : Set G) = B := by
  obtain ⟨model⟩ := hB
  exact quaternion_centralizer_eq B D model
    (hD.sq_eq_one_of_mem_center_of_large hnc hlarge) hc hg

/-- An involution normalizing the Hall tail in a normal quaternion–Hall product
inverts an order-four element of the quaternion factor, with square central in
the product, provided its ambient centralizer is elementary abelian.

The ambient two-group assumption, normality of the quaternion factor, and the
condition that the involution lies outside the product are unnecessary. -/
public theorem Subgroup.exists_inverted_quaternion_element_of_large_hall {P : Type*} [Group P] [Finite P]
    (H : Subgroup P) [H.Normal] [IsCyclic (center H)]
    (B D : Subgroup H) [D.Normal]
    (hB : Nonempty (B ≃* QuaternionGroup 2)) (hD : IsBinaryHallFactor D)
    (hnc : ¬ IsCyclic D) (hlarge : 16 ≤ Nat.card D)
    (hc : D ≤ centralizer (B : Set H)) (hg : B ⊔ D = ⊤)
    (v : P) (hv : orderOf v = 2)
    (hn : v ∈ normalizer (D.map H.subtype : Set P))
    [IsElementaryAbelian 2 (centralizer ({v} : Set P))] :
    ∃ b : B, orderOf b = 4 ∧ (b : H) ^ 2 ∈ center H ∧
      v * ((b : H) : P) * v⁻¹ = (((b : H) : P))⁻¹ := by
  obtain ⟨model⟩ := hB
  have hCB := quaternion_centralizer_eq B D model (hD.sq_eq_one_of_mem_center_of_large hnc hlarge) hc hg
  let f : MulAut H := MulAut.conjNormal v
  have hfcoe (x : H) : (f x : P) = v * (x : P) * v⁻¹ := MulAut.conjNormal_apply v x
  have hf2 : ∀ x : H, f (f x) = x := by
    have he : f ^ 2 = 1 := by
      change (MulAut.conjNormal v : MulAut H) ^ 2 = 1
      have hv2 : v ^ 2 = 1 := hv ▸ pow_orderOf_eq_one v
      rw [← map_pow, hv2, map_one]
    intro x
    have h := DFunLike.congr_fun he x
    simpa only [pow_two, MulAut.mul_apply, MulAut.one_apply] using h
  have hfD : ∀ d : H, d ∈ D → f d ∈ D := by
    intro d hd
    have hh := (mem_normalizer_iff.mp hn (d : P)).mp (mem_map_of_mem H.subtype hd)
    rw [← hfcoe] at hh
    obtain ⟨d', hd', he⟩ := hh
    have he' : d' = f d := Subtype.ext (by simpa only [subtype_apply] using he)
    exact he' ▸ hd'
  have hfB : ∀ b : H, b ∈ B → f b ∈ B := by
    intro b hb
    rw [← hCB]
    intro d hd
    have he : f d * b = b * f d := (le_centralizer_iff.mp hc) hb (f d) (hfD d hd)
    have hh := congrArg f he
    simpa only [map_mul, hf2] using hh
  let g : B →* B :=
    { toFun := fun b => ⟨f b, hfB b b.property⟩
      map_one' := Subtype.ext (map_one f)
      map_mul' := fun x y => Subtype.ext (map_mul f (x : H) (y : H)) }
  have hg2 : Function.Involutive g := fun b => Subtype.ext (hf2 b)
  let e : MulAut B := MulEquiv.ofBijective g hg2.bijective
  have hecoe (b : B) : (e b : H) = f b := rfl
  have he2 : ∀ b, e (e b) = b := hg2
  have hefixed : ∀ b, e b = b → b ^ 2 = 1 := by
    intro b hb
    have he : v * ((b : H) : P) * v⁻¹ = ((b : H) : P) := by
      rw [← hfcoe, ← hecoe, hb]
    have hbC : ((b : H) : P) ∈ centralizer ({v} : Set P) :=
      mem_centralizer_singleton_iff.mpr ((mul_inv_eq_iff_eq_mul.mp he).symm)
    have hs := elemPow_eq_one_of_isElementaryAbelian (p := 2) _ hbC
    apply B.subtype_injective
    apply H.subtype_injective
    simpa only [map_pow, map_one, subtype_apply] using hs
  obtain ⟨b, hb, hi⟩ := quaternion_inverted_of_equiv model e he2 hefixed
  refine ⟨b, hb, quaternion_factor_square_center B D model hc hg b, ?_⟩
  rw [← hfcoe, ← hecoe, hi]
  simp only [Subgroup.coe_inv]
