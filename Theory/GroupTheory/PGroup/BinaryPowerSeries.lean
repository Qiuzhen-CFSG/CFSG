module

public import Theory.Frattini.BinarySquares

/-!
# Iterated square subgroups and square-root lifting

Starting with `S₀ = G`, let `Sₙ₊₁` be the subgroup generated by the squares
of elements of `Sₙ`. In a finite two-group this series reaches the identity:
a stationary term equals its own Frattini subgroup and is therefore trivial.

If `[Sₙ,G] ≤ Sₙ₊₂`, every element of `S₁` is a square. Modulo `Sₙ₊₂`,
elements of `Sₙ` are central, so their square map is a homomorphism. Its image
provides successive corrections to a square root, and termination makes the
last approximation exact.

This isolates the elementary lifting argument used in the powerful-group
root property underlying Section 2 of Traustason–Williams, *Powerfully
nilpotent groups of rank 2 or small order*, arXiv:2002.02694. The commutator
estimate is an explicit hypothesis here; it is not assumed to follow from
powerfulness in this module.
-/

open scoped commutatorElement
namespace Subgroup
variable {G : Type*} [Group G]

/-- The ambient subgroup generated by the squares of elements of `H`. -/
@[expose] public def squareClosure (H : Subgroup G) : Subgroup G :=
  closure (Set.range (fun x : H => (x : G) ^ (2 : ℕ)))

/-- Squaring and taking products stay inside the original subgroup. -/
public theorem squareClosure_le (H : Subgroup G) : H.squareClosure ≤ H := by
  apply (closure_le _).mpr
  rintro _ ⟨x, rfl⟩
  exact H.pow_mem x.property 2

/-- Each square is in the subgroup generated by squares. -/
public theorem square_mem_squareClosure {H : Subgroup G} {x : G} (hx : x ∈ H) :
    x ^ 2 ∈ H.squareClosure := subset_closure ⟨⟨x, hx⟩, rfl⟩

/-- Compute the square subgroup internally and then map it to the ambient group. -/
public theorem squareClosure_eq_map (H : Subgroup G) :
    H.squareClosure = (closure (Set.range (fun x : H => x ^ (2 : ℕ)))).map H.subtype := by
  rw [MonoidHom.map_closure, ← Set.range_comp]
  rfl

public instance squareClosure_normal (H : Subgroup G) [H.Normal] : H.squareClosure.Normal := by
  refine ⟨fun n hn g => ?_⟩
  induction hn using closure_induction with
  | mem x hx =>
      obtain ⟨x, rfl⟩ := hx
      exact subset_closure ⟨⟨g * (x : G) * g⁻¹, (inferInstance : H.Normal).conj_mem x x.property g⟩,
        conj_pow (a := g) (b := (x : G)) (i := 2)⟩
  | one => simpa only [mul_one, mul_inv_cancel] using H.squareClosure.one_mem
  | mul x y hx hy ihx ihy =>
      rw [← conj_mul]
      exact H.squareClosure.mul_mem ihx ihy
  | inv x hx ihx =>
      rw [← conj_inv]
      exact H.squareClosure.inv_mem ihx

/-- A finite two-subgroup is generated by its own squares only if it is trivial. -/
public theorem squareClosure_eq_self_iff [Finite G] (hG : IsPGroup 2 G) (H : Subgroup G) :
    H.squareClosure = H ↔ H = ⊥ := by
  constructor
  · intro heq
    have hφ : frattini H = ⊤ := by
      apply Subgroup.map_injective H.subtype_injective
      rw [(hG.to_subgroup H).frattini_eq_closure_squares, ← squareClosure_eq_map]
      simpa only [← MonoidHom.range_eq_map, range_subtype] using heq
    have hbot : (⊥ : Subgroup H) = ⊤ := frattini_nongenerating (by simpa using hφ)
    apply eq_bot_iff.mpr
    intro x hx
    have : (⟨x, hx⟩ : H) ∈ (⊥ : Subgroup H) := by rw [hbot]; trivial
    exact congrArg Subtype.val (show (⟨x, hx⟩ : H) = 1 from this)
  · rintro rfl
    exact le_antisymm (squareClosure_le _) bot_le

/-- The descending series obtained by repeatedly taking the subgroup of squares. -/
@[expose] public def iteratedSquares (G : Type*) [Group G] : ℕ → Subgroup G
  | 0 => ⊤
  | n + 1 => (iteratedSquares G n).squareClosure

@[simp] public theorem iteratedSquares_zero : iteratedSquares G 0 = ⊤ := rfl
@[simp] public theorem iteratedSquares_succ (n : ℕ) :
    iteratedSquares G (n + 1) = (iteratedSquares G n).squareClosure := rfl

/-- Each term of the square series is contained in its predecessor. -/
public theorem iteratedSquares_succ_le (n : ℕ) :
    iteratedSquares G (n + 1) ≤ iteratedSquares G n := squareClosure_le _

public instance iteratedSquares_normal (n : ℕ) : (iteratedSquares G n).Normal := by
  induction n with
  | zero => change (⊤ : Subgroup G).Normal; infer_instance
  | succ n ih =>
      let := ih
      change (iteratedSquares G n).squareClosure.Normal
      infer_instance

/-- The first term is the subgroup generated by all ambient squares. -/
public theorem iteratedSquares_one :
    iteratedSquares G 1 = closure (Set.range (fun x : G => x ^ (2 : ℕ))) := by
  change closure _ = closure _
  congr 1
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨y, rfl⟩
  · rintro ⟨y, rfl⟩
    exact ⟨⟨y, mem_top y⟩, rfl⟩

/-- The iterated square series terminates in every finite two-group. -/
public theorem iteratedSquares_exists_eq_bot [Finite G] (hG : IsPGroup 2 G) :
    ∃ n, iteratedSquares G n = ⊥ := by
  let n := Function.argmin (iteratedSquares G)
  have hn : ¬ iteratedSquares G (n + 1) < iteratedSquares G n :=
    Function.not_lt_argmin (iteratedSquares G) (n + 1)
  have heq : iteratedSquares G (n + 1) = iteratedSquares G n := by
    by_contra hne
    exact hn (lt_of_le_of_ne (iteratedSquares_succ_le n) hne)
  exact ⟨n, (squareClosure_eq_self_iff hG _).mp heq⟩

private theorem quotient_commute_of_commutator_le (H K : Subgroup G) [K.Normal]
    (hcomm : ⁅H, (⊤ : Subgroup G)⁆ ≤ K) {x : G} (hx : x ∈ H) (y : G) :
    Commute (QuotientGroup.mk' K x) (QuotientGroup.mk' K y) := by
  apply commutatorElement_eq_one_iff_commute.mp
  rw [← map_commutatorElement]
  exact (QuotientGroup.eq_one_iff _).mpr
    (hcomm (commutator_mem_commutator hx (mem_top y)))

private theorem exists_square_mod_of_mem_squareClosure (H K : Subgroup G) [K.Normal]
    (hcomm : ⁅H, (⊤ : Subgroup G)⁆ ≤ K) {x : G} (hx : x ∈ H.squareClosure) :
    ∃ y ∈ H, QuotientGroup.mk' K (y ^ 2) = QuotientGroup.mk' K x := by
  let q := QuotientGroup.mk' K
  let f : H →* G ⧸ K := {
    toFun := fun y => q ((y : G) ^ 2)
    map_one' := by simp [q]
    map_mul' := by
      intro a b
      simp only [coe_mul, map_pow, map_mul]
      exact (quotient_commute_of_commutator_le H K hcomm a.property b).mul_pow 2 }
  have hle : H.squareClosure ≤ f.range.comap q := by
    apply (closure_le _).mpr
    rintro _ ⟨y, rfl⟩
    exact ⟨y, rfl⟩
  obtain ⟨y, hy⟩ := hle hx
  exact ⟨y, y.property, hy⟩

/-- Successive central square corrections extract a root of every element of `S₁`. -/
public theorem exists_square_of_iteratedSquares_commutator_le [Finite G] (hG : IsPGroup 2 G)
    (hcomm : ∀ n, ⁅iteratedSquares G n, (⊤ : Subgroup G)⁆ ≤ iteratedSquares G (n + 2))
    {x : G} (hx : x ∈ iteratedSquares G 1) : ∃ y : G, y ^ 2 = x := by
  have happ (n : ℕ) : ∃ y : G, (y ^ 2)⁻¹ * x ∈ iteratedSquares G (n + 1) := by
    induction n with
    | zero => exact ⟨1, by simpa using hx⟩
    | succ n ih =>
      obtain ⟨y, hy⟩ := ih
      obtain ⟨z, hz, heq⟩ := exists_square_mod_of_mem_squareClosure
        (iteratedSquares G n) (iteratedSquares G (n + 2)) (hcomm n) hy
      let q := QuotientGroup.mk' (iteratedSquares G (n + 2))
      have hzy : Commute (q z) (q y) :=
        quotient_commute_of_commutator_le _ _ (hcomm n) hz y
      have hzq : q z ^ 2 = (q y ^ 2)⁻¹ * q x := by
        simpa only [map_pow, map_mul, map_inv] using heq
      refine ⟨y * z, (QuotientGroup.eq_one_iff _).mp ?_⟩
      change q (((y * z) ^ 2)⁻¹ * x) = 1
      rw [map_mul, map_inv, map_pow, map_mul, hzy.symm.mul_pow, hzq]
      rw [mul_inv_cancel_left, inv_mul_cancel]
  obtain ⟨n, hn⟩ := iteratedSquares_exists_eq_bot hG
  obtain ⟨y, hy⟩ := happ n
  have hy1 : (y ^ 2)⁻¹ * x = 1 :=
    (show (y ^ 2)⁻¹ * x ∈ (⊥ : Subgroup G) from hn ▸ iteratedSquares_succ_le n hy)
  exact ⟨y, inv_mul_eq_one.mp hy1⟩

/-- Fourth powers lie in the second iterated square subgroup, without any
powerfulness hypothesis. -/
public theorem closure_fourthPowers_le_iteratedSquares_two :
    closure (Set.range (fun x : G => x ^ (4 : ℕ))) ≤ iteratedSquares G 2 := by
  apply (closure_le _).mpr
  rintro _ ⟨x, rfl⟩
  have hx : x ^ 2 ∈ iteratedSquares G 1 :=
    square_mem_squareClosure (H := ⊤) (mem_top x)
  change x ^ (4 : ℕ) ∈ (iteratedSquares G 1).squareClosure
  rw [show x ^ (4 : ℕ) = (x ^ 2) ^ 2 from pow_mul x 2 2]
  exact square_mem_squareClosure hx

end Subgroup
