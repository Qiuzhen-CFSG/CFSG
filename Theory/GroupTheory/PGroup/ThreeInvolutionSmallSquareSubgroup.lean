module

public import Theory.GroupTheory.PGroup.ThreeInvolutionExponent
public import Theory.GroupTheory.PGroup.ThreeInvolutionOrder
public import Theory.GroupTheory.BilinearRangeUnion
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.GroupTheory.Commutator.CentralFourSurjectivity
public import Mathlib.GroupTheory.SpecificGroups.KleinFour

/-!
# Excluding an order-sixteen subgroup with only two square values

A nonabelian finite two-group with three central, automorphism-transitive
involutions cannot contain an order-sixteen subgroup containing all involutions
and having only two square values.

The structural results give order 64, an elementary center of order four, and
20 square roots for each involution. If the subgroup's nontrivial square value
is `z`, an automorphism supplies another subgroup with square value `w ≠ z`.
Their intersection is the center, so their product is the whole group.
Cross-commutators cannot equal `z * w`: that would make a product an involution
and force its two factors into the first subgroup. Thus the bilinear
commutator pairing takes values in the union of the lines generated by `z`
and `w`. The subgroup-union argument puts its entire image in one line.
All square roots of that line's involution then lie in the corresponding
order-sixteen subgroup, contradicting the square-fiber count of 20.

Source: the intrinsic square-map obstruction associated with Janko–Thompson,
Math. Z. 113 (1970), Theorem 1.3 and §4, pp.389–390. The argument here uses
transitivity to replace scalar quadratic-form zero counting by two applications
of the elementary subgroup-union lemma.
-/

open Subgroup
open scoped commutatorElement

private theorem square_mul
    {P : Type*} [Group P] (hD : commutator P ≤ center P)
    (hsq : ∀ x : P, x ^ 2 ∈ center P) (x y : P) :
    (x * y) ^ 2 = x ^ 2 * y ^ 2 * ⁅x,y⁆ := by
  have hx : ∀ z : P, z * x ^ 2 = x ^ 2 * z := mem_center_iff.mp (hsq x)
  have hc : ∀ z : P, z * ⁅x,y⁆ = ⁅x,y⁆ * z :=
    mem_center_iff.mp (hD (commutator_mem_commutator (mem_top x) (mem_top y)))
  symm
  calc
    x ^ 2 * y ^ 2 * ⁅x,y⁆ = ⁅x,y⁆ * (x ^ 2 * y ^ 2) := hc _
    _ = x * y * x⁻¹ * (y⁻¹ * x ^ 2) * y ^ 2 := by
      simp only [commutatorElement_def, mul_assoc]
    _ = x * y * x⁻¹ * (x ^ 2 * y⁻¹) * y ^ 2 := by rw [hx]
    _ = (x * y) ^ 2 := by simp only [pow_two]; group

private theorem commutator_mul_left
    {P : Type*} [Group P] (hD : commutator P ≤ center P) (x y z : P) :
    ⁅x * y,z⁆ = ⁅x,z⁆ * ⁅y,z⁆ := by
  rw [commutatorElement_mul_left_eq_conj_mul]
  have hc := mem_center_iff.mp
    (hD (commutator_mem_commutator (mem_top y) (mem_top z)))
  rw [hc x]
  simp only [mul_assoc, mul_inv_cancel, mul_one]
  exact (hc ⁅x,z⁆).symm

private theorem mem_zpowers_two_iff
    {P : Type*} [Group P] [Finite P] {z x : P} (hz : orderOf z = 2) :
    x ∈ zpowers z ↔ x = 1 ∨ x = z := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, hz]
  constructor
  · intro hw
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hw
    have hnlt : n < 2 := Finset.mem_range.mp hn
    interval_cases n <;> simp
  · rintro (rfl | rfl)
    · exact Finset.mem_image.mpr ⟨0, by simp, by simp⟩
    · exact Finset.mem_image.mpr ⟨1, by simp, by simp⟩

private theorem square_roots_mem_left
    {P : Type*} [Group P] (hD : commutator P ≤ center P)
    (hsq : ∀ x : P, x ^ 2 ∈ center P)
    (A B L : Subgroup P) (z w : P) (hz : z ∈ L) (hw : w ∉ L)
    (hfactor : ∀ x : P, ∃ a ∈ A, ∃ b ∈ B, a * b = x)
    (hA : ∀ a ∈ A, a ^ 2 ∈ L)
    (hB : ∀ b ∈ B, b ^ 2 = 1 ∨ b ^ 2 = w)
    (hAI : ∀ x : P, x ^ 2 = 1 → x ∈ A)
    (hcomm : ∀ a ∈ A, ∀ b ∈ B, ⁅a,b⁆ ∈ L) :
    ∀ x : P, x ^ 2 = z → x ∈ A := by
  intro x hx
  obtain ⟨a, ha, b, hb, rfl⟩ := hfactor x
  have hbL : b ^ 2 ∈ L := by
    have hh := L.mul_mem (L.inv_mem (hA a ha))
      (L.mul_mem (hx ▸ hz) (L.inv_mem (hcomm a ha b hb)))
    have he : (a ^ 2)⁻¹ * ((a * b) ^ 2 * ⁅a,b⁆⁻¹) = b ^ 2 := by
      rw [square_mul hD hsq]
      group
    rwa [he] at hh
  have hb1 : b ^ 2 = 1 := (hB b hb).resolve_right (fun he => hw (he ▸ hbL))
  exact A.mul_mem ha (hAI b hb1)

private theorem cross_commutator_ne
    {P : Type*} [Group P] (hD : commutator P ≤ center P)
    (hsq : ∀ x : P, x ^ 2 ∈ center P)
    (hcentral : ∀ x : P, x ^ 2 = 1 → x ∈ center P)
    (A B : Subgroup P) (z w : P) (hw1 : w ≠ 1) (hzw : z ≠ w)
    (hzw2 : (z * w) ^ 2 = 1)
    (hA : ∀ a ∈ A, a ^ 2 = 1 ∨ a ^ 2 = z)
    (hB : ∀ b ∈ B, b ^ 2 = 1 ∨ b ^ 2 = w)
    (hAI : ∀ x : P, x ^ 2 = 1 → x ∈ A)
    (hzw1 : z * w ≠ 1) :
    ∀ a ∈ A, ∀ b ∈ B, ⁅a,b⁆ ≠ z * w := by
  intro a ha b hb he
  have hc1 : ⁅a,b⁆ ≠ 1 := by rwa [he]
  have ha2 : a ^ 2 = z := (hA a ha).resolve_left (fun hh =>
    hc1 ((show Commute a b from (mem_center_iff.mp (hcentral a hh) b).symm).commutator_eq))
  have hb2 : b ^ 2 = w := (hB b hb).resolve_left (fun hh =>
    hc1 ((show Commute a b from mem_center_iff.mp (hcentral b hh) a).commutator_eq))
  have hab : (a * b) ^ 2 = 1 := by
    rw [square_mul hD hsq, ha2, hb2, he, ← pow_two, hzw2]
  have hbA : b ∈ A := (A.mul_mem_cancel_left ha).mp (hAI (a * b) hab)
  rcases hA b hbA with hh | hh
  · exact hw1 (hb2.symm.trans hh)
  · exact hzw (hh.symm.trans hb2)

namespace IsPGroup

/-- Three central automorphism-transitive involutions in a finite nonabelian
two-group exclude an order-sixteen subgroup containing all involutions whose
squares have at most two values. -/
public theorem no_small_square_subgroup_of_transitive_three_involutions
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (hnonab : ¬ IsMulCommutative P)
    (hcentral : ∀ x : P, x ^ 2 = 1 → x ∈ center P)
    (hthree : Nat.card {x : P // orderOf x = 2} = 3)
    (htrans : ∀ x y : P, orderOf x = 2 → orderOf y = 2 →
      ∃ a : MulAut P, a x = y)
    (A : Subgroup P) (hA : Nat.card A = 16)
    (hAI : ∀ x : P, x ^ 2 = 1 → x ∈ A)
    (hsq : ∃ z : P, ∀ a : A, (a : P) ^ 2 = 1 ∨ (a : P) ^ 2 = z) : False := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hexp := hP.exponent_four_of_transitive_three_involutions hnonab hcentral hthree htrans
  obtain ⟨hD', _, hE, _⟩ :=
    hP.special_of_exponent_four_of_transitive_involutions hnonab hcentral htrans hexp
  let : IsElementaryAbelian 2 (center P) := hE
  have hD : commutator P ≤ center P := hD'.symm.le
  have hZ := card_center_of_three_central_involutions hcentral hthree
  have h64 := hP.card_eq_sixty_four_of_exponent_four_of_transitive_three_involutions
    hnonab hcentral hthree htrans hexp
  have hZsq (x : P) (hx : x ∈ center P) : x ^ 2 = 1 :=
    elemPow_eq_one_of_isElementaryAbelian x hx
  have hsquare (x : P) : x ^ 2 ∈ center P :=
    hcentral _ (by simpa only [← pow_mul] using hexp x)
  have hZA : center P ≤ A := fun x hx => hAI x (hZsq x hx)
  obtain ⟨z, hzA⟩ := hsq
  have hAsq (a : P) (ha : a ∈ A) : a ^ 2 = 1 ∨ a ^ 2 = z := hzA ⟨a, ha⟩
  obtain ⟨a, ha, haZ⟩ : ∃ a ∈ A, a ∉ center P := by
    by_contra! hh
    have hle := card_le_of_le hh
    rw [hA, hZ] at hle
    omega
  have ha2 : a ^ 2 = z := (hAsq a ha).resolve_left (fun he => haZ (hcentral a he))
  have hz1 : z ≠ 1 := fun he => haZ (hcentral a (ha2.trans he))
  have hzZ : z ∈ center P := ha2 ▸ hsquare a
  have hz : orderOf z = 2 := orderOf_eq_prime (hZsq z hzZ) hz1
  let : Nontrivial {x : P // orderOf x = 2} :=
    Finite.one_lt_card_iff_nontrivial.mp (by omega)
  obtain ⟨w', hw'⟩ := exists_ne (⟨z, hz⟩ : {x : P // orderOf x = 2})
  let w : P := w'
  have hw : orderOf w = 2 := w'.property
  have hw1 : w ≠ 1 := (orderOf_eq_prime_iff.mp hw).2
  have hzw : z ≠ w := fun he => hw' (Subtype.ext he.symm)
  have hwZ : w ∈ center P := hcentral w (orderOf_eq_prime_iff.mp hw).1
  obtain ⟨α, hα⟩ := htrans z w hz hw
  let B : Subgroup P := A.map α.toMonoidHom
  have hB : Nat.card B = 16 := (card_map_of_injective α.injective).trans hA
  have hBsq (b : P) (hb : b ∈ B) : b ^ 2 = 1 ∨ b ^ 2 = w := by
    obtain ⟨a, ha, rfl⟩ := hb
    rcases hAsq a ha with hh | hh
    · left
      rw [← map_pow, hh, map_one]
    · right
      rw [← map_pow, hh]
      exact hα
  have hBI (x : P) (hx : x ^ 2 = 1) : x ∈ B := by
    refine ⟨α.symm x, hAI _ ?_, α.apply_symm_apply x⟩
    rw [← map_pow, hx, map_one]
  have hZB : center P ≤ B := fun x hx => hBI x (hZsq x hx)
  let : A.Normal := commutator_top_left_le_iff.mp
    ((commutator_mono le_rfl le_top).trans (hD.trans hZA))
  let : B.Normal := commutator_top_left_le_iff.mp
    ((commutator_mono le_rfl le_top).trans (hD.trans hZB))
  have hAB : A ⊓ B = center P := by
    apply le_antisymm ?_ (le_inf hZA hZB)
    intro x hx
    apply hcentral x
    rcases hAsq x hx.1 with hh | hh
    · exact hh
    rcases hBsq x hx.2 with hh' | hh'
    · exact hh'
    exact (hzw (hh.symm.trans hh')).elim
  have hsup : A ⊔ B = ⊤ := by
    apply eq_top_of_card_eq
    have hc := card_mul_eq_card_inf_mul_card_sup_of_normalizes A B le_normalizer_of_normal
    rw [hA, hB, hAB, hZ] at hc
    omega
  have hfactor (x : P) : ∃ a ∈ A, ∃ b ∈ B, a * b = x :=
    mem_sup_of_normal_left.mp (hsup ▸ mem_top x)
  have hfactor' (x : P) : ∃ b ∈ B, ∃ a ∈ A, b * a = x :=
    mem_sup_of_normal_left.mp ((sup_comm A B ▸ hsup) ▸ mem_top x)
  have hzw1 : z * w ≠ 1 := by
    intro hh
    have hw2 := hZsq w hwZ
    rw [pow_two] at hw2
    have he : z = w := by
      calc
        z = z * (w * w) := by rw [hw2, mul_one]
        _ = w := by rw [← mul_assoc, hh, one_mul]
    exact hzw he
  have havoid := cross_commutator_ne hD hsquare hcentral A B z w hw1 hzw
    (hZsq _ ((center P).mul_mem hzZ hwZ)) hAsq hBsq hAI hzw1
  let : Nontrivial (center P) := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  let : IsKleinFour (center P) := ⟨hZ, IsElementaryAbelian.exponent_eq_prime⟩
  have hcover (a : A) (b : B) :
      ⁅(a : P),(b : P)⁆ ∈ zpowers z ∨ ⁅(a : P),(b : P)⁆ ∈ zpowers w := by
    rw [mem_zpowers_two_iff hz, mem_zpowers_two_iff hw]
    by_cases hc1 : ⁅(a : P),(b : P)⁆ = 1
    · exact Or.inl (Or.inl hc1)
    by_cases hcz : ⁅(a : P),(b : P)⁆ = z
    · exact Or.inl (Or.inr hcz)
    by_cases hcw : ⁅(a : P),(b : P)⁆ = w
    · exact Or.inr (Or.inr hcw)
    have he := IsKleinFour.eq_mul_of_ne_all
      (x := (⟨z, hzZ⟩ : center P)) (y := (⟨w, hwZ⟩ : center P))
      (z := (⟨⁅(a : P),(b : P)⁆,
        hD (commutator_mem_commutator (mem_top _) (mem_top _))⟩ : center P))
      (fun he => hz1 (congrArg Subtype.val he))
      (fun he => hw1 (congrArg Subtype.val he))
      (fun he => hzw (congrArg Subtype.val he))
      (fun he => hc1 (congrArg Subtype.val he))
      (fun he => hcz (congrArg Subtype.val he))
      (fun he => hcw (congrArg Subtype.val he))
    exact (havoid a a.property b b.property (congrArg Subtype.val he)).elim
  have hlines := bilinear_range_subset_union (fun (a : A) (b : B) => ⁅(a : P),(b : P)⁆)
    (fun a a' b => commutator_mul_left hD a a' b)
    (fun a b b' => congrArg Subtype.val ((centerCommutatorHom hD a).map_mul b b'))
    (zpowers z) (zpowers w) hcover
  have hbad (C : Subgroup P) (hC : Nat.card C = 16) (t : P) (ht : orderOf t = 2)
      (hroots : ∀ x : P, x ^ 2 = t → x ∈ C) : False := by
    have hc := card_eq_four_add_three_mul_square_fiber hcentral hthree htrans hexp t ht
    have hle := Nat.card_le_card_of_injective
      (fun x : {x : P // x ^ 2 = t} => (⟨x, hroots x x.property⟩ : C))
      (fun x y he => Subtype.ext (congrArg (fun x : C => (x : P)) he))
    rw [h64] at hc
    rw [hC] at hle
    omega
  rcases hlines with hline | hline
  · apply hbad A hA z hz
    apply square_roots_mem_left hD hsquare A B (zpowers z) z w (mem_zpowers z)
      (by rw [mem_zpowers_two_iff hz]; exact not_or.mpr ⟨hw1, hzw.symm⟩)
      hfactor (fun a ha => (mem_zpowers_two_iff hz).mpr (hAsq a ha)) hBsq hAI
    exact fun a ha b hb => hline ⟨a, ha⟩ ⟨b, hb⟩
  · apply hbad B hB w hw
    apply square_roots_mem_left hD hsquare B A (zpowers w) w z (mem_zpowers w)
      (by rw [mem_zpowers_two_iff hw]; exact not_or.mpr ⟨hz1, hzw⟩)
      hfactor' (fun b hb => (mem_zpowers_two_iff hw).mpr (hBsq b hb)) hAsq hBI
    intro b hb a ha
    rw [← commutatorElement_inv]
    exact (zpowers w).inv_mem (hline ⟨a, ha⟩ ⟨b, hb⟩)

end IsPGroup
