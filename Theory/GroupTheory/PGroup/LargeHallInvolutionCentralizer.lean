module

public import Theory.GroupTheory.PGroup.NormalExtraspecialDerivedCenter
public import Theory.GroupTheory.PGroup.LargeHallRotationFusion
public import Theory.GroupTheory.PGroup.LargeHallInternalInvolutionCentralizer

/-!
# The central derived line of an outside-rotation involution centralizer

The subgroup generated by elements with nontrivial fourth power is
characteristic. In an extraspecial central product with a large noncyclic
binary Hall factor, it contains the central involution. Thus an involution
outside it has proper centralizer whenever the central product has cyclic
center.

The extension step uses the internal centralizer intersection: if that
intersection is extraspecial of order eight, and the internal centralizer
has order at most sixteen, its normal extension in an index-two overgroup
has abelian quotient of order at most four. Its derived-center intersection
is therefore precisely the common central involution line. The transport
lemma retains the actual subgroup identity in the overgroup.

The Hall-factor adapter combines the internal order-eight calculation with
these extension and transport steps, giving the actual subgroup identity for
every outside-rotation involution in the index-two subgroup.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, Case 1, printed p.392.
-/

open Subgroup

private theorem commutative_of_card_le_four
    {G : Type*} [Group G] [Finite G] (h : Nat.card G ≤ 4) : IsMulCommutative G := by
  have hp : 0 < Nat.card G := Nat.card_pos
  have hh : Nat.card G = 1 ∨ Nat.card G = 2 ∨ Nat.card G = 3 ∨ Nat.card G = 4 := by omega
  rcases hh with h1 | h2 | h3 | h4
  · let : Subsingleton G := (Nat.card_eq_one_iff_unique.mp h1).1
    exact ⟨⟨fun _ _ => Subsingleton.elim _ _⟩⟩
  · let : IsCyclic G := isCyclic_of_prime_card h2
    infer_instance
  · let : IsCyclic G := isCyclic_of_prime_card h3
    infer_instance
  · exact IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) h4

namespace Subgroup

/-- The subgroup generated by elements with nontrivial fourth power is characteristic. -/
public theorem fourth_power_closure_characteristic {G : Type*} [Group G] :
    (closure {x : G | x ^ 4 ≠ 1}).Characteristic := by
  apply characteristic_iff_le_comap.mpr
  intro f
  apply (closure_le _).mpr
  intro x hx
  apply subset_closure
  change (f x) ^ 4 ≠ 1
  intro he
  apply hx
  apply f.injective
  simpa only [map_pow, map_one] using he

/-- The index-two extension step for the central derived line. -/
public theorem derived_center_line_of_index_two_extraspecial_intersection
    {T : Type*} [Group T] [Finite T]
    (H M : Subgroup T) [H.Normal] [M.Normal] (hi : H.index = 2)
    (t z : T) (hzC : z ∈ center T) (hz : orderOf z = 2) (hzM : z ∈ M)
    [IsExtraspecial 2 (M.subgroupOf (centralizer ({t} : Set T)))]
    (hJ : Nat.card (M.subgroupOf (centralizer ({t} : Set T))) = 8)
    (hHC : Nat.card (H ⊓ centralizer ({t} : Set T) : Subgroup T) ≤ 16) :
    (_root_.commutator (centralizer ({t} : Set T)) ⊓
      center (centralizer ({t} : Set T))).map (centralizer ({t} : Set T)).subtype =
        zpowers z := by
  let C := centralizer ({t} : Set T)
  let J := M.subgroupOf C
  have hHCcard : Nat.card (H.subgroupOf C) ≤ 16 := by
    rw [← card_map_of_injective C.subtype_injective, subgroupOf_map_subtype]
    exact hHC
  have hindex : (H.subgroupOf C).index ≤ 2 := by
    apply Nat.le_of_dvd (by decide : 0 < 2)
    rw [← hi]
    exact H.relIndex_dvd_index_of_normal C
  have hCcard : Nat.card C ≤ 32 := by
    have hmul := (H.subgroupOf C).card_mul_index
    nlinarith
  have hquot : Nat.card (C ⧸ J) ≤ 4 := by
    have hmul := J.card_mul_index
    change Nat.card J * Nat.card (C ⧸ J) = Nat.card C at hmul
    change Nat.card J = 8 at hJ
    rw [hJ] at hmul
    omega
  let : IsMulCommutative (C ⧸ J) := commutative_of_card_le_four hquot
  rw [derived_inf_center_eq_of_normal_extraspecial J]
  apply (eq_of_le_of_card_ge ?_ ?_).symm
  · apply zpowers_le.mpr
    have hzC' : z ∈ C := mem_centralizer_singleton_iff.mpr
      (mem_center_iff.mp hzC t).symm
    let zC : C := ⟨z, hzC'⟩
    let zJ : J := ⟨zC, hzM⟩
    exact ⟨zC, ⟨zJ, mem_center_iff.mpr (fun j =>
      Subtype.ext (Subtype.ext (mem_center_iff.mp hzC ((j : C) : T)))), rfl⟩, rfl⟩
  · rw [card_map_of_injective C.subtype_injective,
      card_map_of_injective J.subtype_injective, IsExtraspecial.center_order_p 2 J,
      Nat.card_zpowers, hz]

end Subgroup

namespace Subgroup

/-- A central involution is in the intrinsic rotation subgroup. -/
public theorem central_involution_mem_fourth_power_closure_of_large_hall
    {P : Type*} [Group P] [Finite P] [IsCyclic (center P)]
    (hP : IsPGroup 2 P) (A D : Subgroup P) [A.Normal] [D.Normal]
    [IsExtraspecial 2 A] (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ centralizer (A : Set P)) (hg : A ⊔ D = ⊤)
    (hlarge : 16 ≤ Nat.card D) (z : P) (hzC : z ∈ center P)
    (hz : orderOf z = 2) : z ∈ closure {x : P | x ^ 4 ≠ 1} := by
  obtain ⟨_, Q, _, _, hroot⟩ :=
    cyclic_squares_and_intrinsic_rotation_roots_of_large_hall hP A D hD hn hc hg hlarge
  obtain ⟨x, hx, _⟩ := hroot z 1 hzC hz (one_mem _)
  have hz1 : z ≠ 1 := by intro he; simp [he] at hz
  rw [← hx]
  exact pow_mem (subset_closure (by change x ^ 4 ≠ 1; rwa [hx])) 4

/-- An involution outside a subgroup containing the unique central involution
cannot centralize an overgroup of the cyclic-center group. -/
public theorem centralizer_ne_top_of_involution_outside_cyclic_center
    {T : Type*} [Group T] [Finite T] (H M : Subgroup T) [IsCyclic (center H)]
    (t z : H) (hzC : z ∈ center H) (hz : orderOf z = 2)
    (hzM : (z : T) ∈ M) (ht : orderOf t = 2) (htM : (t : T) ∉ M) :
    centralizer ({(t : T)} : Set T) ≠ ⊤ := by
  intro htop
  have htC : t ∈ center H := by
    apply mem_center_iff.mpr
    intro x
    apply Subtype.ext
    have hx : (x : T) ∈ centralizer ({(t : T)} : Set T) := htop ▸ mem_top _
    exact mem_centralizer_singleton_iff.mp hx
  have he : t = z := congrArg Subtype.val
    (IsCyclic.eq_of_orderOf_eq_two (x := (⟨t, htC⟩ : center H))
      (y := (⟨z, hzC⟩ : center H))
      (by rwa [← orderOf_coe]) (by rwa [← orderOf_coe]))
  exact htM (he ▸ hzM)

/-- Transport the internal extraspecial centralizer calculation to an
index-two overgroup and identify the actual central derived subgroup. -/
public theorem involution_centralizer_line_of_intrinsic_extraspecial
    {T : Type*} [Group T] [Finite T]
    (H : Subgroup T) [H.Normal] [IsCyclic (center H)] (hi : H.index = 2)
    (t z : H) (hzC : (z : T) ∈ center T) (hz : orderOf z = 2)
    (ht : orderOf t = 2)
    (hzR : z ∈ closure {x : H | x ^ 4 ≠ 1})
    (htR : t ∉ closure {x : H | x ^ 4 ≠ 1})
    (hJextra : IsExtraspecial 2
      (closure {x : H | x ^ 4 ≠ 1} ⊓ centralizer ({t} : Set H) : Subgroup H))
    (hJcard : Nat.card
      (closure {x : H | x ^ 4 ≠ 1} ⊓ centralizer ({t} : Set H) : Subgroup H) = 8)
    (hCHcard : Nat.card (centralizer ({t} : Set H)) ≤ 16) :
    centralizer ({(t : T)} : Set T) ≠ ⊤ ∧
      (_root_.commutator (centralizer ({(t : T)} : Set T)) ⊓
        center (centralizer ({(t : T)} : Set T))).map
          (centralizer ({(t : T)} : Set T)).subtype = zpowers (z : T) := by
  let R := closure {x : H | x ^ 4 ≠ 1}
  let M := R.map H.subtype
  let C := centralizer ({(t : T)} : Set T)
  let K := R ⊓ centralizer ({t} : Set H)
  let : R.Characteristic := fourth_power_closure_characteristic
  let : M.Normal := inferInstance
  have hzM : (z : T) ∈ M := mem_map_of_mem H.subtype hzR
  have htM : (t : T) ∉ M := by
    intro he
    obtain ⟨u, hu, he⟩ := he
    exact htR ((H.subtype_injective he) ▸ hu)
  have hzCH : z ∈ center H := mem_center_iff.mpr
    (fun x => Subtype.ext (mem_center_iff.mp hzC x))
  refine ⟨centralizer_ne_top_of_involution_outside_cyclic_center
    H M t z hzCH hz hzM ht htM, ?_⟩
  have hCH : (centralizer ({t} : Set H)).map H.subtype = H ⊓ C := by
    ext x
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact ⟨u.property, mem_centralizer_singleton_iff.mpr
        (congrArg Subtype.val (mem_centralizer_singleton_iff.mp hu))⟩
    · rintro ⟨hxH, hxC⟩
      exact ⟨⟨x, hxH⟩, mem_centralizer_singleton_iff.mpr
        (Subtype.ext (mem_centralizer_singleton_iff.mp hxC)), rfl⟩
  have hKM : K.map H.subtype = M ⊓ C := by
    change (R ⊓ centralizer ({t} : Set H)).map H.subtype = M ⊓ C
    rw [map_inf R (centralizer ({t} : Set H)) H.subtype H.subtype_injective, hCH]
    change M ⊓ (H ⊓ C) = M ⊓ C
    rw [← inf_assoc, inf_eq_left.mpr (map_subtype_le R)]
  have hKle : K.map H.subtype ≤ C := hKM ▸ inf_le_right
  let e := (K.equivMapOfInjective H.subtype H.subtype_injective).trans
    (subgroupOfEquivOfLe hKle).symm
  have hJ : (K.map H.subtype).subgroupOf C = M.subgroupOf C := by
    rw [hKM, inf_subgroupOf_right]
  let : IsExtraspecial 2 (M.subgroupOf C) :=
    hJ ▸ IsExtraspecial.of_mulEquiv e hJextra
  have hJC : Nat.card (M.subgroupOf C) = 8 := by
    rw [← hJ, ← Nat.card_congr e.toEquiv]
    exact hJcard
  have hHC : Nat.card (H ⊓ C : Subgroup T) ≤ 16 := by
    rw [← hCH, card_map_of_injective H.subtype_injective]
    exact hCHcard
  exact derived_center_line_of_index_two_extraspecial_intersection H M hi
    (t : T) (z : T) hzC (by rwa [orderOf_coe]) hzM hJC hHC

end Subgroup

namespace Subgroup

/-- For a large Hall tail, outside-rotation involutions have proper centralizer. -/
public theorem centralizer_ne_top_of_large_hall_outside_rotation
    {T : Type*} [Group T] [Finite T]
    (H : Subgroup T) [IsCyclic (center H)] (hH : IsPGroup 2 H)
    (A D : Subgroup H) [A.Normal] [D.Normal] [IsExtraspecial 2 A]
    (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ centralizer (A : Set H)) (hg : A ⊔ D = ⊤)
    (hlarge : 16 ≤ Nat.card D) (z t : H) (hzC : z ∈ center H)
    (hz : orderOf z = 2) (ht : orderOf t = 2)
    (hout : t ∉ closure {x : H | x ^ 4 ≠ 1}) :
    centralizer ({(t : T)} : Set T) ≠ ⊤ := by
  have hzR := central_involution_mem_fourth_power_closure_of_large_hall
    hH A D hD hn hc hg hlarge z hzC hz
  let M := (closure {x : H | x ^ 4 ≠ 1}).map H.subtype
  apply centralizer_ne_top_of_involution_outside_cyclic_center H M t z hzC hz
    (mem_map_of_mem H.subtype hzR) ht
  rintro ⟨u, hu, he⟩
  exact hout ((H.subtype_injective he) ▸ hu)

/-- The Hall-factor adapter for the internal centralizer calculation. The
remaining hypotheses concern only the group `H`, independently of its overgroup. -/
public theorem large_hall_involution_centralizer_line_of_internal_calculation
    {T : Type*} [Group T] [Finite T]
    (H : Subgroup T) [H.Normal] [IsCyclic (center H)]
    (hi : H.index = 2) (hH : IsPGroup 2 H)
    (A D : Subgroup H) [A.Normal] [D.Normal] [IsExtraspecial 2 A]
    (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ centralizer (A : Set H)) (hg : A ⊔ D = ⊤)
    (hlarge : 16 ≤ Nat.card D) (z t : H) (hzC : (z : T) ∈ center T)
    (hz : orderOf z = 2) (ht : orderOf t = 2)
    (hout : t ∉ closure {x : H | x ^ 4 ≠ 1})
    (hJextra : IsExtraspecial 2
      (closure {x : H | x ^ 4 ≠ 1} ⊓ centralizer ({t} : Set H) : Subgroup H))
    (hJcard : Nat.card
      (closure {x : H | x ^ 4 ≠ 1} ⊓ centralizer ({t} : Set H) : Subgroup H) = 8)
    (hCHcard : Nat.card (centralizer ({t} : Set H)) ≤ 16) :
    centralizer ({(t : T)} : Set T) ≠ ⊤ ∧
      (_root_.commutator (centralizer ({(t : T)} : Set T)) ⊓
        center (centralizer ({(t : T)} : Set T))).map
          (centralizer ({(t : T)} : Set T)).subtype = zpowers (z : T) := by
  have hzCH : z ∈ center H := mem_center_iff.mpr
    (fun x => Subtype.ext (mem_center_iff.mp hzC x))
  exact involution_centralizer_line_of_intrinsic_extraspecial H hi t z hzC hz ht
    (central_involution_mem_fourth_power_closure_of_large_hall
      hH A D hD hn hc hg hlarge z hzCH hz)
    hout hJextra hJcard hCHcard

/-- In an index-two overgroup of a large Hall central product, an involution
outside the intrinsic rotations has proper centralizer, whose derived-center
intersection is exactly the ambient central involution line. -/
public theorem large_hall_involution_centralizer_line
    {T : Type*} [Group T] [Finite T]
    (H : Subgroup T) [H.Normal] [IsCyclic (center H)]
    (hi : H.index = 2) (hH : IsPGroup 2 H)
    (A D : Subgroup H) [A.Normal] [D.Normal] [IsExtraspecial 2 A]
    (hA : Nat.card A = 8) (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ centralizer (A : Set H)) (hg : A ⊔ D = ⊤)
    (hlarge : 16 ≤ Nat.card D) (z t : H) (hzC : (z : T) ∈ center T)
    (hz : orderOf z = 2) (ht : orderOf t = 2)
    (hout : t ∉ closure {x : H | x ^ 4 ≠ 1}) :
    centralizer ({(t : T)} : Set T) ≠ ⊤ ∧
      (_root_.commutator (centralizer ({(t : T)} : Set T)) ⊓
        center (centralizer ({(t : T)} : Set T))).map
          (centralizer ({(t : T)} : Set T)).subtype = zpowers (z : T) := by
  obtain ⟨hJextra, hJcard, hCHcard⟩ :=
    internal_involution_centralizer_of_large_hall hH A D hA hD hn hc hg hlarge t ht hout
  exact large_hall_involution_centralizer_line_of_internal_calculation
    H hi hH A D hD hn hc hg hlarge z t hzC hz ht hout
    hJextra hJcard hCHcard.le

/-- Ambient-element form of the large Hall involution-centralizer calculation.
Here the intrinsic rotation subgroup is mapped into the overgroup. -/
public theorem large_hall_involution_centralizer_line_of_mem
    {T : Type*} [Group T] [Finite T] (hT : IsPGroup 2 T)
    (H : Subgroup T) [H.Normal] [IsCyclic (center H)] (hi : H.index = 2)
    (A D : Subgroup H) [A.Normal] [D.Normal] [IsExtraspecial 2 A]
    (hA : Nat.card A = 8) (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ centralizer (A : Set H)) (hg : A ⊔ D = ⊤)
    (hlarge : 16 ≤ Nat.card D) (z t : T) (hzC : z ∈ center T)
    (hz : orderOf z = 2) (hzH : z ∈ H) (htH : t ∈ H) (ht : orderOf t = 2)
    (hout : t ∉ (closure {x : H | x ^ 4 ≠ 1}).map H.subtype) :
    centralizer ({t} : Set T) ≠ ⊤ ∧
      (_root_.commutator (centralizer ({t} : Set T)) ⊓
        center (centralizer ({t} : Set T))).map
          (centralizer ({t} : Set T)).subtype = zpowers z := by
  exact large_hall_involution_centralizer_line H hi (hT.to_subgroup H)
    A D hA hD hn hc hg hlarge ⟨z, hzH⟩ ⟨t, htH⟩ hzC
    (by rwa [← orderOf_coe]) (by rwa [← orderOf_coe])
    (fun htR => hout (mem_map_of_mem H.subtype htR))

end Subgroup
