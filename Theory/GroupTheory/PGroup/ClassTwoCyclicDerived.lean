module

public import Theory.GroupTheory.PGroup.AbelianRankTwoHomocyclic
public import Theory.GroupTheory.PGroup.AbelianOmega

/-!
# Cyclic derived subgroups from two central-quotient generators

A class-two group whose quotient by a central subgroup is a product of two
cyclic groups has cyclic derived subgroup. Lift generators of the two
factors and quotient by the cyclic group generated by their commutator.
The two lifts then commute, and together with the center they generate the
whole group, so this second quotient is abelian.

For a finite two-group, first omega of its abelian central quotient having
order at most four suffices: omega order at most two gives a cyclic quotient;
otherwise the abelian decomposition gives exactly two cyclic factors.
This supplies the two-generator step in the elementary three-involution
reduction associated with Janko–Thompson, Math. Z. 113 (1970), Theorem 1.3
and Lemma 5.1.
-/

open Subgroup
open scoped commutatorElement IsMulCommutative

private theorem cyclic_derived_of_central_generators
    {G : Type*} [Group G] (hclass : commutator G ≤ center G)
    (x y : G)
    (hgen : ∀ H : Subgroup G, center G ≤ H → x ∈ H → y ∈ H → H = ⊤) :
    IsCyclic (commutator G) := by
  let K := zpowers ⁅x,y⁆
  have hK : K ≤ center G := zpowers_le.mpr
    (hclass (commutator_mem_commutator (mem_top x) (mem_top y)))
  let : K.Normal := ⟨fun k hk g => by
    rw [mem_center_iff.mp (hK hk) g, mul_inv_cancel_right]
    exact hk⟩
  let q := QuotientGroup.mk' K
  have hxy : Commute (q x) (q y) := by
    apply commutatorElement_eq_one_iff_mul_comm.mp
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr (mem_zpowers _)
  have hqZ (z : G) (hz : z ∈ center G) : q z ∈ center (G ⧸ K) := by
    apply mem_center_iff.mpr
    intro w
    obtain ⟨v, rfl⟩ := QuotientGroup.mk'_surjective K w
    simpa only [map_mul] using congrArg q (mem_center_iff.mp hz v)
  have hcentral (a : G) (hax : Commute (q a) (q x))
      (hay : Commute (q a) (q y)) : q a ∈ center (G ⧸ K) := by
    have hH : (centralizer ({q a} : Set (G ⧸ K))).comap q = ⊤ := by
      apply hgen
      · intro z hz
        exact mem_centralizer_singleton_iff.mpr (mem_center_iff.mp (hqZ z hz) (q a)).symm
      · exact mem_centralizer_singleton_iff.mpr hax.eq.symm
      · exact mem_centralizer_singleton_iff.mpr hay.eq.symm
    apply mem_center_iff.mpr
    intro w
    obtain ⟨v, rfl⟩ := QuotientGroup.mk'_surjective K w
    have hv : q v ∈ centralizer ({q a} : Set (G ⧸ K)) := by
      change v ∈ (centralizer ({q a} : Set (G ⧸ K))).comap q
      rw [hH]
      trivial
    exact mem_centralizer_singleton_iff.mp hv
  have htop : (center (G ⧸ K)).comap q = ⊤ :=
    hgen _ hqZ (hcentral x (Commute.refl _) hxy)
      (hcentral y hxy.symm (Commute.refl _))
  have habel : IsMulCommutative (G ⧸ K) := by
    apply center_eq_top_iff.mp
    apply top_unique
    intro w _
    obtain ⟨v, rfl⟩ := QuotientGroup.mk'_surjective K w
    change v ∈ (center (G ⧸ K)).comap q
    rw [htop]
    trivial
  exact isCyclic_of_le (Normal.quotient_commutative_iff_commutator_le.mp habel)

/-- A class-two central extension of a product of two cyclic groups has cyclic
derived subgroup. -/
public theorem isCyclic_commutator_of_class_two_of_cyclic_product_quotient
    {G A B : Type*} [Group G] [Group A] [Group B] [IsCyclic A] [IsCyclic B]
    (hclass : commutator G ≤ center G)
    (f : G →* A × B) (hf : Function.Surjective f) (hker : f.ker ≤ center G) :
    IsCyclic (commutator G) := by
  obtain ⟨a, ha⟩ := isCyclic_iff_exists_zpowers_eq_top.mp (inferInstance : IsCyclic A)
  obtain ⟨b, hb⟩ := isCyclic_iff_exists_zpowers_eq_top.mp (inferInstance : IsCyclic B)
  obtain ⟨x, hx⟩ := hf (a, 1)
  obtain ⟨y, hy⟩ := hf (1, b)
  apply cyclic_derived_of_central_generators hclass x y
  intro H hZ hxH hyH
  apply top_unique
  intro g _
  obtain ⟨i, hi⟩ := mem_zpowers_iff.mp (show (f g).1 ∈ zpowers a by rw [ha]; trivial)
  obtain ⟨j, hj⟩ := mem_zpowers_iff.mp (show (f g).2 ∈ zpowers b by rw [hb]; trivial)
  have hd : f (x ^ i * y ^ j) = f g := by
    rw [map_mul, map_zpow, map_zpow, hx, hy]
    ext <;> simp [hi, hj]
  have hk : g * (x ^ i * y ^ j)⁻¹ ∈ f.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hd, mul_inv_cancel]
  have hh := H.mul_mem (hZ (hker hk)) (H.mul_mem (H.zpow_mem hxH i) (H.zpow_mem hyH j))
  simpa only [inv_mul_cancel_right] using hh

namespace IsPGroup

/-- In a class-two finite two-group, rank at most two of the central quotient
forces the derived subgroup to be cyclic. -/
public theorem isCyclic_commutator_of_card_omega_center_quotient_le_four
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (hclass : commutator P ≤ center P)
    (hbound : Nat.card (omega₁ (P ⧸ center P) (p := 2)) ≤ 4) :
    IsCyclic (commutator P) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : IsMulCommutative (P ⧸ center P) :=
    Normal.quotient_commutative_iff_commutator_le.mpr hclass
  let Q := P ⧸ center P
  have hQ : IsPGroup 2 Q := hP.to_quotient (center P)
  by_cases hsmall : Nat.card (omega₁ Q (p := 2)) ≤ 2
  · let : IsCyclic Q := hQ.isCyclic_of_card_omega_one_le_two hsmall
    have habel : IsMulCommutative P := isMulCommutative_of_isCyclic_quotient_center_self P
    have he : commutator P = ⊥ := (commutator_eq_bot_iff P).mpr habel
    rw [he]
    infer_instance
  have hfour : Nat.card (omega₁ Q (p := 2)) = 4 := by
    obtain ⟨n, hn⟩ := (hQ.to_subgroup (omega₁ Q (p := 2))).exists_card_eq
    have hnle : n ≤ 2 := by
      apply (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp
      simpa only [← hn] using hbound
    interval_cases n <;> norm_num only [pow_zero, pow_one, Nat.reducePow] at hn <;> omega
  obtain ⟨n, m, _, _, ⟨e⟩⟩ :=
    hQ.equiv_two_cyclic_factors_of_card_omega_one_eq_four hfour
  let q := QuotientGroup.mk' (center P)
  let f := e.toMonoidHom.comp q
  apply isCyclic_commutator_of_class_two_of_cyclic_product_quotient hclass f
    (e.surjective.comp (QuotientGroup.mk'_surjective _))
  rw [MonoidHom.ker_comp_of_injective _ _ e.injective, QuotientGroup.ker_mk']

end IsPGroup
