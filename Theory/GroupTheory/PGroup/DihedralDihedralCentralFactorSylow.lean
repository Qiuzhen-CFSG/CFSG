module

public import Theory.GroupTheory.PGroup.DihedralCentralFactor
public import Theory.GroupTheory.PGroup.CyclicInvolution

/-!
# Square data for a dihedral-dihedral central product

Suppose a finite two-group is generated by a dihedral subgroup of order eight
and its centralizer, and that the centralizer is dihedral with rotation order
divisible by four. Their common involution is the square of every element of
order four. Moreover, every element of the group centralizes an element of
order four.

The intersection of the two factors has order two. Every ambient element is
a product of commuting factor elements. The square of an element whose fourth
power is one in either factor is trivial or the common involution: in the
larger dihedral factor this follows from uniqueness of the involution in its
cyclic rotation subgroup. For the commuting root, a commuting rotation in
either factor suffices. In the remaining reflection case, a dihedral-eight
reflection and an order-four rotation in the other factor acquire the same
central involution on interchange with the respective components; their
product therefore commutes with the given element and has order four.

This is the intrinsic central-product calculation toward MacWilliams [12],
as quoted in Janko–Thompson, Math. Z. 113 (1970), 1.2, printed pp.385–386,
with the reference on p.397. The ambient simple-group exclusion is separate.
-/

open Subgroup DihedralGroup

private theorem rotation_mem {m : ℕ} [NeZero m] (i : ZMod m) :
    r i ∈ zpowers (r 1 : DihedralGroup m) := by
  have h := pow_mem (mem_zpowers (r 1 : DihedralGroup m)) i.val
  simpa only [r_one_pow, ZMod.natCast_zmod_val] using h

private theorem center_rotation {m : ℕ} (hm : 2 < m)
    (z : DihedralGroup m) (hz : z ∈ center (DihedralGroup m)) :
    z ∈ zpowers (r 1 : DihedralGroup m) := by
  let : NeZero m := ⟨by omega⟩
  cases z with
  | r i => exact rotation_mem i
  | sr i =>
    have hi : i - 1 = i + 1 := sr.inj (mem_center_iff.mp hz (r 1))
    have htwo : (2 : ZMod m) = 0 := by linear_combination -hi
    have hv := congrArg ZMod.val htwo
    have hval : ZMod.val (2 : ZMod m) = 2 := ZMod.val_natCast_of_lt hm
    rw [hval, ZMod.val_zero] at hv
    omega

private theorem square_rotation {m : ℕ} [NeZero m] (x : DihedralGroup m) :
    x ^ 2 ∈ zpowers (r 1 : DihedralGroup m) := by
  cases x with
  | r i => exact pow_mem (rotation_mem i) 2
  | sr i => simp only [pow_two, sr_mul_self, one_mem]

private theorem square_cases {m : ℕ} (hm : 2 < m)
    (z : DihedralGroup m) (hz : orderOf z = 2) (hzC : z ∈ center (DihedralGroup m))
    (x : DihedralGroup m) (hx : x ^ 4 = 1) : x ^ 2 = 1 ∨ x ^ 2 = z := by
  let : NeZero m := ⟨by omega⟩
  by_cases h : x ^ 2 = 1
  · exact Or.inl h
  · right
    let R := zpowers (r 1 : DihedralGroup m)
    let a : R := ⟨x ^ 2, square_rotation x⟩
    let b : R := ⟨z, center_rotation hm z hzC⟩
    have ha : orderOf a = 2 := orderOf_eq_prime
      (Subtype.ext (show (x ^ 2) ^ 2 = 1 by simpa only [← pow_mul] using hx))
      (fun he => h (congrArg Subtype.val he))
    have hb : orderOf b = 2 := (Subgroup.orderOf_coe b).symm.trans hz
    exact congrArg Subtype.val (IsCyclic.eq_of_orderOf_eq_two ha hb)

private theorem eight_cases (d : DihedralGroup 4) :
    (∃ a : DihedralGroup 4, a ^ 4 = 1 ∧ a ^ 2 ≠ 1 ∧ a * d = d * a) ∨
    ∃ u : DihedralGroup 4, u ^ 2 = 1 ∧ u * d = d * u * r 2 := by
  exact (show ∀ d : DihedralGroup 4,
    (∃ a : DihedralGroup 4, a ^ 4 = 1 ∧ a ^ 2 ≠ 1 ∧ a * d = d * a) ∨
    ∃ u : DihedralGroup 4, u ^ 2 = 1 ∧ u * d = d * u * r 2 from by decide) d


private theorem rotation_four {m : ℕ} (hm : 0 < m) (hdiv : 4 ∣ m) :
    ∃ q : DihedralGroup m, orderOf q = 4 ∧
      ∀ c : DihedralGroup m, q * c = c * q ∨ q * c = c * q * q ^ 2 := by
  let : NeZero m := ⟨hm.ne'⟩
  let q : DihedralGroup m := (r 1) ^ (m / 4)
  have hq : orderOf q = 4 := by
    simpa only [orderOf_r_one] using
      (orderOf_pow_orderOf_div (x := (r 1 : DihedralGroup m))
        (by simpa only [orderOf_r_one] using hm.ne')
        (by simpa only [orderOf_r_one] using hdiv))
  refine ⟨q, hq, ?_⟩
  have hq4 : q ^ 4 = 1 := hq ▸ pow_orderOf_eq_one q
  have hqi : q⁻¹ = q * q ^ 2 := by
    apply inv_eq_of_mul_eq_one_right
    simpa only [← pow_succ', ← pow_add] using hq4
  intro c
  cases c with
  | r i =>
    left
    dsimp [q]
    simp only [r_one_pow, r_mul_r, add_comm]
  | sr i =>
    right
    have h : q * sr i = sr i * q⁻¹ := by simp [q, sub_eq_add_neg]
    rw [h, hqi, mul_assoc]

private theorem twisted_commute {P : Type*} [Group P] (u q d c z : P)
    (hqd : Commute q d) (huc : Commute u c)
    (hz : z ∈ center P) (hz2 : z ^ 2 = 1)
    (hu : u * d = d * u * z) (hq : q * c = c * q * z) :
    Commute (u * q) (d * c) := by
  change (u * q) * (d * c) = (d * c) * (u * q)
  calc
    (u * q) * (d * c) = (u * d) * (q * c) := hqd.mul_mul_mul_comm _ _
    _ = (d * u * z) * (c * q * z) := by rw [hu, hq]
    _ = (d * u) * (c * q) * (z * z) := by
      simpa only [mul_assoc] using
        (show Commute z (c * q) from (mem_center_iff.mp hz _).symm).mul_mul_mul_comm (d * u) z
    _ = (d * u) * (c * q) := by rw [← pow_two, hz2, mul_one]
    _ = (d * c) * (u * q) := huc.mul_mul_mul_comm _ _

namespace Subgroup

set_option linter.unusedVariables false in
/-- A dihedral-eight factor with a dihedral centralizer of rotation order
multiple of four has a unique involution square, and every element centralizes
an element of order four. The two-group hypothesis is retained in the central
factor interface; the intrinsic calculation proves the result without it. -/
public theorem dihedral_dihedral_factor_square_data
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (D : Subgroup P) (e : D ≃* DihedralGroup 4)
    (hgen : D ⊔ centralizer (D : Set P) = ⊤)
    (m : ℕ) (hm : 0 < m) (hdiv : 4 ∣ m)
    (f : centralizer (D : Set P) ≃* DihedralGroup m) :
    ∃ z : P, orderOf z = 2 ∧ z ∈ center P ∧
      (∀ x : P, orderOf x = 4 → x ^ 2 = z) ∧
      (∀ t : P, ∃ x : P, orderOf x = 4 ∧ Commute x t) := by
  let C := centralizer (D : Set P)
  let I : Subgroup P := D ⊓ C
  have hI : Nat.card I = 2 := card_inf_centralizer_of_dihedral D e
  obtain ⟨zI, hzI, hIz⟩ := (Nat.card_eq_two_iff' (1 : I)).mp hI
  let z : P := zI
  have hz : z ≠ 1 := fun h => hzI (Subtype.ext h)
  have hz2 : z ^ 2 = 1 := by
    exact congrArg Subtype.val (hI ▸ pow_card_eq_one' (x := zI))
  have hzin : z ∈ I := zI.property
  have hIcases (x : P) (hx : x ∈ I) : x = 1 ∨ x = z := by
    by_cases h : x = 1
    · exact Or.inl h
    · exact Or.inr (congrArg Subtype.val (hIz ⟨x, hx⟩ (fun he => h (congrArg Subtype.val he))))
  have hzcentral : z ∈ center P := by
    have hD : D ≤ centralizer ({z} : Set P) := by
      intro d hd
      exact mem_centralizer_singleton_iff.mpr (hzin.2 d hd)
    have hC : C ≤ centralizer ({z} : Set P) := by
      intro c hc
      exact mem_centralizer_singleton_iff.mpr (hc z hzin.1).symm
    have hall : (⊤ : Subgroup P) ≤ centralizer ({z} : Set P) := by
      rw [← hgen]
      exact sup_le hD hC
    exact mem_center_iff.mpr (fun p => mem_centralizer_singleton_iff.mp (hall (mem_top p)))
  let zC : C := ⟨z, hzin.2⟩
  have hzorder : orderOf z = 2 := orderOf_eq_prime hz2 hz
  have hfzorder : orderOf (f zC) = 2 := by
    rw [f.orderOf_eq, ← Subgroup.orderOf_coe]
    exact hzorder
  have hfzcenter : f zC ∈ center (DihedralGroup m) := by
    apply mem_center_iff.mpr
    intro a
    obtain ⟨b, rfl⟩ := f.surjective a
    simpa only [map_mul] using congrArg f
      (show b * zC = zC * b from Subtype.ext (mem_center_iff.mp hzcentral b))
  have hCcases (c : C) (hc : c ^ 4 = 1) : c ^ 2 = 1 ∨ c ^ 2 = zC := by
    have hm4 : 4 ≤ m := Nat.le_of_dvd hm hdiv
    rcases square_cases (by omega) (f zC) hfzorder hfzcenter (f c)
      (by rw [← map_pow, hc, map_one]) with h | h
    · exact Or.inl (f.injective (by simpa only [map_pow, map_one] using h))
    · exact Or.inr (f.injective (by simpa only [map_pow] using h))
  have hd4 (d : D) : d ^ 4 = 1 := by
    apply e.injective
    simpa only [map_pow, map_one] using
      (show ∀ y : DihedralGroup 4, y ^ 4 = 1 from by decide) (e d)
  have hd2 (d : D) : (d : P) ^ 2 ∈ I := by
    refine ⟨D.pow_mem d.property 2, ?_⟩
    intro a ha
    have he : e ⟨a, ha⟩ * (e d) ^ 2 = (e d) ^ 2 * e ⟨a, ha⟩ :=
      (show ∀ a b : DihedralGroup 4, a * b ^ 2 = b ^ 2 * a from by decide) _ _
    have hh : (⟨a, ha⟩ : D) * d ^ 2 = d ^ 2 * ⟨a, ha⟩ := e.injective (by simpa using he)
    exact congrArg Subtype.val hh
  have hdecomp (x : P) : ∃ d : D, ∃ c : C, (d : P) * c = x := by
    have hx : x ∈ D ⊔ C := hgen ▸ mem_top x
    rw [← SetLike.mem_coe, coe_mul_of_right_le_normalizer_left D C
      (centralizer_le_normalizer (D : Set P))] at hx
    obtain ⟨d, hd, c, hc, he⟩ := hx
    exact ⟨⟨d, hd⟩, ⟨c, hc⟩, he⟩
  have hcomm (d : D) (c : C) : Commute (d : P) (c : P) := c.property d d.property
  have hsquare (x : P) (hx : orderOf x = 4) : x ^ 2 = z := by
    obtain ⟨d, c, rfl⟩ := hdecomp x
    have h4 : ((d : P) * c) ^ 4 = 1 := by
      rw [← hx]
      exact pow_orderOf_eq_one _
    have hc4 : c ^ 4 = 1 := by
      apply Subtype.ext
      change (c : P) ^ 4 = 1
      simpa only [(hcomm d c).mul_pow, show (d : P) ^ 4 = 1 from
        congrArg Subtype.val (hd4 d), one_mul] using h4
    have hc2 : (c : P) ^ 2 ∈ I := by
      rcases hCcases c hc4 with h | h
      · rw [show (c : P) ^ 2 = 1 from congrArg Subtype.val h]
        exact I.one_mem
      · rw [show (c : P) ^ 2 = z from congrArg Subtype.val h]
        exact hzin
    apply (hIcases _ (by rw [(hcomm d c).mul_pow]; exact I.mul_mem (hd2 d) hc2)).resolve_left
    intro h
    have hdvd := orderOf_dvd_of_pow_eq_one h
    rw [hx] at hdvd
    norm_num at hdvd
  refine ⟨z, hzorder, hzcentral, hsquare, ?_⟩
  intro t
  obtain ⟨d, c, rfl⟩ := hdecomp t
  rcases eight_cases (e d) with ⟨a, ha4, ha2, had⟩ | ⟨v, hv2, hvd⟩
  · let aD := e.symm a
    have haorder : orderOf aD = 4 := by
      rw [MulEquiv.orderOf_eq]
      exact orderOf_eq_prime_pow (p := 2) (n := 1) ha2 ha4
    have had' : Commute aD d := by
      apply e.injective
      simpa only [map_mul, aD, e.apply_symm_apply] using had
    exact ⟨aD, (Subgroup.orderOf_coe aD).trans haorder,
      (had'.map D.subtype).mul_right (hcomm aD c)⟩
  · obtain ⟨qM, hqM, hqMc⟩ := rotation_four hm hdiv
    let q := f.symm qM
    have hqorder : orderOf (q : P) = 4 := by
      rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq]
      exact hqM
    have hq2 : (q : P) ^ 2 = z := hsquare q hqorder
    rcases hqMc (f c) with hqc | hqc
    · have hqc' : Commute q c := by
        apply f.injective
        simpa only [map_mul, q, f.apply_symm_apply] using hqc
      exact ⟨q, hqorder, (hcomm d q).symm.mul_right (hqc'.map C.subtype)⟩
    · let u := e.symm v
      have hu2 : (u : P) ^ 2 = 1 := by
        have h : u ^ 2 = 1 := e.injective (by
          simpa only [map_pow, map_one, u, e.apply_symm_apply] using hv2)
        exact congrArg Subtype.val h
      let zD : D := ⟨z, hzin.1⟩
      have hzD : e zD = r 2 := by
        apply (show ∀ b : DihedralGroup 4, b ≠ 1 →
          (∀ a : DihedralGroup 4, a * b = b * a) → b = r 2 from by decide)
        · intro h
          exact hz (congrArg Subtype.val (e.injective (h.trans (map_one e).symm)))
        · intro a
          obtain ⟨b, rfl⟩ := e.surjective a
          simpa only [map_mul] using congrArg e
            (show b * zD = zD * b from Subtype.ext (mem_center_iff.mp hzcentral b))
      have hud : (u : P) * d = (d : P) * u * z := by
        have h : u * d = d * u * zD := e.injective (by
          simpa only [map_mul, u, e.apply_symm_apply, hzD] using hvd)
        exact congrArg Subtype.val h
      have hqc' : (q : P) * c = (c : P) * q * z := by
        have h : q * c = c * q * q ^ 2 := f.injective (by
          simpa only [map_mul, map_pow, q, f.apply_symm_apply] using hqc)
        simpa only [coe_mul, coe_pow, hq2] using congrArg Subtype.val h
      have huq2 : ((u : P) * q) ^ 2 = z := by
        rw [(hcomm u q).mul_pow, hu2, one_mul, hq2]
      have huq4 : ((u : P) * q) ^ 4 = 1 := by
        calc
          ((u : P) * q) ^ 4 = (((u : P) * q) ^ 2) ^ 2 := by rw [← pow_mul]
          _ = 1 := by rw [huq2, hz2]
      refine ⟨(u : P) * q, ?_, ?_⟩
      · exact orderOf_eq_prime_pow (p := 2) (n := 1) (by simpa only [pow_one, huq2] using hz) huq4
      · exact twisted_commute (u : P) (q : P) (d : P) (c : P) z (hcomm d q).symm (hcomm u c)
          hzcentral hz2 hud hqc'

end Subgroup
