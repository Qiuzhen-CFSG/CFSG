module

public import Theory.GroupTheory.PGroup.CyclicFourSectionDerived
public import Theory.GroupTheory.InvolutionOrbitCentralizerSupplement

/-!
# Derived lines from cyclic-four fixed cores

Suppose an involution centralizer covers a cyclic-four quotient by a normal
subgroup H, and its fixed core is a normal elementary four W. The centralizer
is generated by W and one cyclic subgroup, so its derived subgroup lies in
the central involution line of W.

It cannot be abelian when H has order greater than eight. Otherwise take a
normal step of order two above W inside H intersected with C(W). Squares in
the centralizer fix that step, and its kernel W does too. The cyclic-four
quotient forces the involution to fix the step, contradicting its fixed core.
Thus the derived subgroup is precisely the central line.

This is a direct version of the normal-chain argument of Janko–Thompson
(1970), §4, case (a), printed p.391. It avoids a normalized odd-order actor.
-/

open Subgroup
open scoped commutatorElement
namespace Subgroup

private theorem normal_step_in
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (W D : Subgroup P) [W.Normal] [D.Normal] (hWD : W < D) :
    ∃ X : Subgroup P, X.Normal ∧ W ≤ X ∧ X ≤ D ∧ W.relIndex X = 2 := by
  let q := QuotientGroup.mk' W
  let Q := P ⧸ W
  let B := D.map q
  let : B.Normal := (inferInstance : D.Normal).map q (QuotientGroup.mk'_surjective W)
  have hB : B ≠ ⊥ := by
    intro hb
    have hh := (map_eq_bot_iff D).mp hb
    rw [QuotientGroup.ker_mk'] at hh
    exact (not_le_of_gt hWD) hh
  let : Nontrivial B := (Subgroup.nontrivial_iff_ne_bot B).mpr hB
  have hQ : IsPGroup 2 Q := hP.to_quotient W
  let : Fact (IsPGroup 2 Q) := ⟨hQ⟩
  obtain ⟨n, hn⟩ := (hQ.to_subgroup B).exists_card_eq
  have hnpos : 1 ≤ n := by
    have hp : 1 < Nat.card B := Finite.one_lt_card
    by_contra hh
    have : n = 0 := by omega
    rw [hn, this] at hp
    norm_num at hp
  obtain ⟨Y, hYn, hYB, hYc⟩ :=
    exists_normal_subgroup_card_pow_of_normal B inferInstance hn 1 hnpos
  let : Y.Normal := hYn
  let X := Y.comap q
  have hWX : W ≤ X := by
    intro w hw
    change q w ∈ Y
    rw [show q w = 1 from (QuotientGroup.eq_one_iff _).mpr hw]
    exact Y.one_mem
  refine ⟨X, inferInstance, hWX, ?_, ?_⟩
  · calc
      X ≤ B.comap q := comap_mono hYB
      _ = D := comap_map_eq_self (by simpa only [q, QuotientGroup.ker_mk'] using hWD.le)
  · have hc : Nat.card (X.map q) = 2 := by
      rw [map_comap_eq_self (by rw [MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective W)]; exact le_top)]
      simpa using hYc
    rwa [← relIndex_ker, QuotientGroup.ker_mk'] at hc

private theorem square_centralizes_step'
    {P : Type*} [Group P]
    (W X E : Subgroup P) [W.Normal] [X.Normal] [IsElementaryAbelian 2 W]
    (hWX : W ≤ X) (hi : W.relIndex X = 2)
    (hE : E ≤ centralizer (W : Set P)) (k : E) :
    (k : P) ^ 2 ∈ centralizer (X : Set P) := by
  have hcomm : ⁅X, E⁆ ≤ W := commutator_le_of_normalized_index_two X W E hWX hi
    le_normalizer_of_normal le_normalizer_of_normal
  intro x hx
  let c : P := ⁅x, (k : P)⁆
  have hc : c ∈ W := hcomm (commutator_mem_commutator hx k.property)
  have hck : c * (k : P) = (k : P) * c := hE k.property c hc
  have hcc : c * c = 1 := by
    simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) c hc
  have hconj : (k : P) * x * (k : P)⁻¹ = c⁻¹ * x := by
    dsimp [c]
    simp only [commutatorElement_def]
    group
  have hfix : (k : P) ^ 2 * x * ((k : P) ^ 2)⁻¹ = x := by
    calc
      (k : P) ^ 2 * x * ((k : P) ^ 2)⁻¹ =
          (k : P) * ((k : P) * x * (k : P)⁻¹) * (k : P)⁻¹ := by simp [pow_two, mul_assoc]
      _ = (k : P) * (c⁻¹ * x) * (k : P)⁻¹ := by rw [hconj]
      _ = c⁻¹ * ((k : P) * x * (k : P)⁻¹) := by
        rw [← mul_assoc, ← (Commute.inv_left hck).eq]
        group
      _ = c⁻¹ * (c⁻¹ * x) := by rw [hconj]
      _ = x := by rw [← mul_assoc, ← mul_inv_rev, hcc, inv_one, one_mul]
  exact (mul_inv_eq_iff_eq_mul.mp hfix).symm

/-- A cyclic-four centralizer with elementary fixed four is nonabelian above a large core. -/
public theorem centralizer_noncommutative_of_cyclic_four_fixed_four
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (H W : Subgroup P) [H.Normal] [W.Normal] [IsElementaryAbelian 2 W]
    [IsCyclic (P ⧸ H)] (hindex : H.index = 4)
    (hH : 8 < Nat.card H) (hW : Nat.card W = 4)
    (t : P) (ht : t ^ 2 = 1)
    (hfixed : H ⊓ centralizer ({t} : Set P) = W)
    (hsurj : Function.Surjective ((QuotientGroup.mk' H).comp
      (centralizer ({t} : Set P)).subtype)) :
    ¬ IsMulCommutative (centralizer ({t} : Set P)) := by
  intro hab
  let E := centralizer ({t} : Set P)
  let : IsMulCommutative E := hab
  have hWE : W ≤ E := hfixed ▸ inf_le_right
  have hWH : W ≤ H := hfixed ▸ inf_le_left
  have hEC : E ≤ centralizer (W : Set P) := E.le_centralizer.trans (centralizer_le hWE)
  let D := H ⊓ centralizer (W : Set P)
  have hWD : W ≤ D := le_inf hWH W.le_centralizer
  have hlarge : 4 < Nat.card D := by
    have hi := centralizer_index_le_two_of_normal_four hP W hW
    have hd := relIndex_dvd_index_of_normal (H := centralizer (W : Set P)) (K := H)
    have hile : (centralizer (W : Set P)).relIndex H ≤ 2 :=
      (Nat.le_of_dvd (Nat.pos_of_ne_zero (centralizer (W : Set P)).index_ne_zero_of_finite) hd).trans hi
    have hc := ((centralizer (W : Set P)).subgroupOf H).card_mul_index
    have he : ((centralizer (W : Set P)).subgroupOf H) ≃ D :=
      { toFun x := ⟨x.1, x.1.property, x.property⟩
        invFun x := ⟨⟨x, x.property.1⟩, x.property.2⟩
        left_inv _ := rfl
        right_inv _ := rfl }
    rw [Nat.card_congr he] at hc
    change Nat.card D * (centralizer (W : Set P)).relIndex H = Nat.card H at hc
    nlinarith
  have hWD' : W < D := lt_of_le_of_ne hWD (by
    intro he
    have hh := congrArg (fun K : Subgroup P => Nat.card K) he
    omega)
  obtain ⟨X, hXn, hWX, hXD, hi⟩ := normal_step_in hP W D hWD'
  let : X.Normal := hXn
  let f := (QuotientGroup.mk' H).comp E.subtype
  let Z := f.ker
  have hZ : Z ≤ (centralizer (X : Set P)).comap E.subtype := by
    intro a ha
    have haH : (a : P) ∈ H := (QuotientGroup.eq_one_iff _).mp ha
    have haW : (a : P) ∈ W := hfixed ▸ ⟨haH, a.property⟩
    intro x hx
    exact ((hXD hx).2 a haW).symm
  let e := QuotientGroup.quotientKerEquivOfSurjective f hsurj
  let : IsCyclic (E ⧸ Z) := isCyclic_of_surjective e.symm e.symm.surjective
  have hcard : Nat.card (E ⧸ Z) = 4 := (Nat.card_congr e.toEquiv).trans hindex
  have htE : t ∈ E := mem_centralizer_singleton_iff.mpr rfl
  have htX : t ∈ centralizer (X : Set P) :=
    mem_of_square_eq_one_of_cyclic_four_quotient Z
      ((centralizer (X : Set P)).comap E.subtype) hcard hZ
      (square_centralizes_step' W X E hWX hi hEC) ⟨t, htE⟩ (Subtype.ext ht)
  have hXW : X ≤ W := by
    intro x hx
    rw [← hfixed]
    exact ⟨(hXD hx).1, mem_centralizer_singleton_iff.mpr (htX x hx)⟩
  have hh := relIndex_eq_one.mpr hXW
  omega

private theorem commutative_join_of_commuting
    {P : Type*} [Group P] (K W : Subgroup P)
    [IsMulCommutative K] [IsMulCommutative W]
    (hcomm : K ≤ centralizer (W : Set P)) : IsMulCommutative (K ⊔ W : Subgroup P) := by
  apply le_centralizer_iff_isMulCommutative.mp
  apply sup_le
  · exact le_centralizer_iff.mpr (sup_le K.le_centralizer (le_centralizer_iff.mp hcomm))
  · exact le_centralizer_iff.mpr (sup_le hcomm W.le_centralizer)

private theorem commutator_join_le_of_abelian_factors
    {P : Type*} [Group P] (K W Z : Subgroup P)
    [IsMulCommutative K] [IsMulCommutative W] [Z.Normal]
    (hcomm : ⁅K, W⁆ ≤ Z) : ⁅K ⊔ W, K ⊔ W⁆ ≤ Z := by
  let q := QuotientGroup.mk' Z
  have hcomm' : ⁅K.map q, W.map q⁆ = ⊥ := by
    rw [← map_commutator]
    exact (map_eq_bot_iff _).mpr (by simpa only [q, QuotientGroup.ker_mk'] using hcomm)
  let : IsMulCommutative (K.map q) := map_isMulCommutative K q
  let : IsMulCommutative (W.map q) := map_isMulCommutative W q
  let : IsMulCommutative (K.map q ⊔ W.map q : Subgroup (P ⧸ Z)) :=
    commutative_join_of_commuting _ _ (commutator_eq_bot_iff_le_centralizer.mp hcomm')
  have hmap : (⁅K ⊔ W, K ⊔ W⁆).map q = ⊥ := by
    rw [map_commutator, map_sup]
    exact commutator_self_eq_bot_iff.mpr inferInstance
  have hle := (map_eq_bot_iff _).mp hmap
  simpa only [q, QuotientGroup.ker_mk'] using hle


/-- The derived subgroup of the centralizer is the central involution line. -/
public theorem centralizer_derived_eq_of_cyclic_four_fixed_four
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (H W : Subgroup P) [H.Normal] [W.Normal] [IsElementaryAbelian 2 W]
    [IsCyclic (P ⧸ H)] (hindex : H.index = 4)
    (hH : 8 < Nat.card H) (hW : Nat.card W = 4)
    (z t : P) (hz : orderOf z = 2) (hzc : z ∈ center P) (hzW : z ∈ W)
    (ht : t ^ 2 = 1)
    (hfixed : H ⊓ centralizer ({t} : Set P) = W)
    (hsurj : Function.Surjective ((QuotientGroup.mk' H).comp
      (centralizer ({t} : Set P)).subtype)) :
    (_root_.commutator (centralizer ({t} : Set P))).map
      (centralizer ({t} : Set P)).subtype = zpowers z := by
  let E := centralizer ({t} : Set P)
  let q := QuotientGroup.mk' H
  obtain ⟨b, hb⟩ := IsCyclic.exists_generator (α := P ⧸ H)
  obtain ⟨k, hk⟩ := hsurj b
  have hkq : q (k : P) = b := hk
  let K := zpowers (k : P)
  have hKE : K ≤ E := zpowers_le.mpr k.property
  have hWE : W ≤ E := hfixed ▸ inf_le_right
  have hgen : K ⊔ W = E := by
    apply le_antisymm (sup_le hKE hWE)
    intro x hx
    have hqx : q x ∈ K.map q := by
      rw [show K = zpowers (k : P) from rfl, q.map_zpowers, hkq]
      exact hb (q x)
    obtain ⟨y, hy, hyx⟩ := hqx
    have hdH : y⁻¹ * x ∈ H := by
      apply (QuotientGroup.eq_one_iff _).mp
      change q (y⁻¹ * x) = 1
      rw [map_mul, map_inv, hyx, inv_mul_cancel]
    have hdE : y⁻¹ * x ∈ E := E.mul_mem (E.inv_mem (hKE hy)) hx
    have hdW : y⁻¹ * x ∈ W := hfixed ▸ ⟨hdH, hdE⟩
    have hh := (K ⊔ W).mul_mem (mem_sup_left hy) (mem_sup_right hdW)
    simpa only [mul_inv_cancel_left] using hh
  have hZc : zpowers z ≤ center P := zpowers_le.mpr hzc
  let : (zpowers z).Normal := ⟨fun n hn g => by
    rw [(mem_center_iff.mp (hZc hn) g), mul_inv_cancel_right]
    exact hn⟩
  have hbound : ⁅E, E⁆ ≤ zpowers z := by
    rw [← hgen]
    exact commutator_join_le_of_abelian_factors K W (zpowers z)
      ((commutator_mono le_top le_rfl).trans
        (normal_four_commutator_le_central_involution W hW z hz hzc hzW))
  have hnonab := centralizer_noncommutative_of_cyclic_four_fixed_four
    hP H W hindex hH hW t ht hfixed hsurj
  rw [map_subtype_commutator]
  apply eq_of_le_of_card_ge hbound
  have hne : ⁅E, E⁆ ≠ ⊥ := fun hh => hnonab (commutator_self_eq_bot_iff.mp hh)
  have hc : Nat.card (⁅E, E⁆ : Subgroup P) ≠ 1 := fun hh => hne (card_eq_one.mp hh)
  have hp : 0 < Nat.card (⁅E, E⁆ : Subgroup P) := Nat.card_pos
  rw [Nat.card_zpowers, hz]
  omega

/-- A centralizer supplement makes its fixed core normal when the core has central commutators. -/
public theorem fixed_core_normal_of_centralizer_supplement
    {P : Type*} [Group P] (H : Subgroup P) [H.Normal]
    (t : P) (hsup : centralizer ({t} : Set P) ⊔ H = ⊤)
    (hclass : ⁅H,H⁆ ≤ center P) :
    (H ⊓ centralizer ({t} : Set P)).Normal := by
  let E := centralizer ({t} : Set P)
  let F := H ⊓ E
  have hHF : H ≤ normalizer (F : Set P) :=
    le_normalizer_iff_commutator_le_right.mpr
      ((commutator_mono le_rfl inf_le_left).trans
        (le_inf (commutator_le_left H H) (hclass.trans (center_le_centralizer _))))
  have hEF : E ≤ normalizer (F : Set P) := by
    apply le_normalizer_iff.mpr
    intro e he x hx
    exact ⟨(inferInstance : H.Normal).conj_mem x hx.1 e,
      E.mul_mem (E.mul_mem he hx.2) (E.inv_mem he)⟩
  exact normalizer_eq_top_iff.mp (top_unique (by
    rw [← hsup]
    exact sup_le hEF hHF))
end Subgroup
