module

public import Theory.GroupTheory.PGroup.NormalEightQuaternionFactorReduction
public import Theory.GroupTheory.PGroup.NormalIndexTwoStep
public import Theory.GroupTheory.PGroup.AbelianNonsquareInvolution
public import Theory.GroupTheory.PGroup.CyclicTimesTwoNormalExtension

/-!
# Second-omega centralizers in a quaternion commuting factor

Let `P` be a finite two-group generated by a quaternion subgroup `Q` and its
centralizer `D`. An ambient-normal abelian subgroup `B ≤ D` self-centralizing
in `D` contains the center. If the central first omega has order four and
there is no normal elementary eight, the first omega of `B` is exactly that
central four.

The centralizer bound is immediate when `B` has exponent at most four.
In general, failure of the bound supplies an ambient-normal subgroup `R`
with `|R:B| = 2`, centralizing the second omega of `B`, and still
self-centralizing over `B`. The quaternion involution is not a square in
`B`, so `B` splits as a cyclic group times that involution. The normal
index-two extension obstruction then gives either a forbidden normal
elementary eight or a normal abelian subgroup in which the quaternion
involution is a square. This proves the second-omega centralizer bound.

Source: MacWilliams, *On 2-groups and Sylow 2-subgroups of finite groups*,
Trans. AMS 150 (1970), §3(iv), 1.2.1–1.2.2, printed p.368,
`refs/original/n-group-global/odd-core-rank-two-source/macwilliams-1970-ams-wayback.pdf`.
-/

open scoped IsMulCommutative

namespace Subgroup

/-- A relative abelian self-centralizer in the quaternion commuting factor
contains the center and has precisely the central four as its first omega. -/
public theorem quaternion_factor_abelian_base_omega
    {P : Type*} [Group P] [Finite P]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (Q B : Subgroup P) [B.Normal] [IsMulCommutative B]
    (hCB : centralizer (Q : Set P) ⊓ centralizer (B : Set P) ≤ B) :
    center P ≤ B ∧
      (omega₁ B (p := 2)).map B.subtype =
        (omega₁ (center P) (p := 2)).map (center P).subtype ∧
      Nat.card (omega₁ B (p := 2)) = 4 := by
  have hZB : center P ≤ B :=
    (le_inf (center_le_centralizer _) (center_le_centralizer _)).trans hCB
  have hEq : (omega₁ B (p := 2)).map B.subtype =
      (omega₁ (center P) (p := 2)).map (center P).subtype := by
    apply le_antisymm
    · let : (omega₁ B (p := 2)).Characteristic := omega₁_characteristic _
      let : IsElementaryAbelian 2 (omega₁ B (p := 2)) :=
        IsElementaryAbelian.omega₁_of_isMulCommutative _
      let : ((omega₁ B (p := 2)).map B.subtype).Normal :=
        ConjAct.normal_of_characteristic_of_normal
      let : IsElementaryAbelian 2 ((omega₁ B (p := 2)).map B.subtype) :=
        IsElementaryAbelian.map_subtype
      exact normal_elementary_le_omega_center_of_no_normal_eight hno hZ _
    · rintro x ⟨z, hz, rfl⟩
      let : IsElementaryAbelian 2 (omega₁ (center P) (p := 2)) :=
        IsElementaryAbelian.omega₁_of_isMulCommutative _
      refine ⟨⟨z, hZB z.property⟩, subset_closure ?_, rfl⟩
      apply Subtype.ext
      exact congrArg (fun t : center P => (t : P))
        (elemPow_eq_one_of_isElementaryAbelian (p := 2) z hz)
  refine ⟨hZB, hEq, ?_⟩
  have hc := congrArg (fun H : Subgroup P => Nat.card H) hEq
  simpa only [card_map_of_injective B.subtype_injective,
    card_map_of_injective (center P).subtype_injective, hZ] using hc

/-- For a base of exponent dividing four, the second-omega centralizer
bound is the given self-centralizer bound. -/
public theorem quaternion_factor_omega_two_centralizer_le_of_exponent_four
    {P : Type*} [Group P] (Q B : Subgroup P)
    (hCB : centralizer (Q : Set P) ⊓ centralizer (B : Set P) ≤ B)
    (hfour : ∀ b : B, b ^ 4 = 1) :
    centralizer (Q : Set P) ⊓
      centralizer (((omega B (p := 2) 2).map B.subtype : Subgroup P) : Set P) ≤ B := by
  have hB : B ≤ (omega B (p := 2) 2).map B.subtype := by
    intro b hb
    exact ⟨⟨b, hb⟩, subset_closure (hfour ⟨b, hb⟩), rfl⟩
  exact (inf_le_inf_left _ (centralizer_le hB)).trans hCB

/-- Failure of the centralizer bound gives an ambient-normal step of index
two, with `B` self-centralizing in that step. -/
public theorem quaternion_factor_exists_normal_index_two_step
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (Q : Subgroup P) (hgen : Q ⊔ centralizer (Q : Set P) = ⊤)
    (B : Subgroup P) [B.Normal] [IsMulCommutative B]
    (hBD : B ≤ centralizer (Q : Set P))
    (hCB : centralizer (Q : Set P) ⊓ centralizer (B : Set P) ≤ B)
    (hfail : ¬ centralizer (Q : Set P) ⊓
      centralizer (((omega B (p := 2) 2).map B.subtype : Subgroup P) : Set P) ≤ B) :
    ∃ R : Subgroup P, R.Normal ∧ B ≤ R ∧
      R ≤ centralizer (Q : Set P) ∧
      R ≤ centralizer (((omega B (p := 2) 2).map B.subtype : Subgroup P) : Set P) ∧
      B.relIndex R = 2 ∧ R ⊓ centralizer (B : Set P) ≤ B := by
  let : Q.Normal := normal_of_centralizing_sup_eq_top Q (centralizer (Q : Set P))
    hgen le_rfl
  let O := (omega B (p := 2) 2).map B.subtype
  let : (omega B (p := 2) 2).Characteristic := omega_characteristic B 2
  let : O.Normal := ConjAct.normal_of_characteristic_of_normal
  let C := centralizer (Q : Set P) ⊓ centralizer (O : Set P)
  let : C.Normal := inferInstance
  have hBC : B ≤ C := le_inf hBD
    (B.le_centralizer.trans (centralizer_le (map_subtype_le _)))
  have hlt : B < C := lt_of_le_not_ge hBC hfail
  obtain ⟨R, hRn, hBR, hRC, hi⟩ := exists_normal_index_two_step P hP B C hlt
  exact ⟨R, hRn, hBR, hRC.trans inf_le_left, hRC.trans inf_le_right, hi,
    (inf_le_inf_right _ (hRC.trans inf_le_left)).trans hCB⟩

/-- In a quaternion central product without normal elementary eights and with
central first omega of order four, a normal abelian self-centralizer in the
commuting factor also controls the centralizer of its second omega. -/
public theorem quaternion_factor_omega_two_centralizer_le
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (Q : Subgroup P) (e : Q ≃* QuaternionGroup 2)
    (hgen : Q ⊔ centralizer (Q : Set P) = ⊤)
    (B : Subgroup P) [B.Normal] [IsMulCommutative B]
    (hBD : B ≤ centralizer (Q : Set P))
    (hCB : centralizer (Q : Set P) ⊓ centralizer (B : Set P) ≤ B) :
    centralizer (Q : Set P) ⊓
      centralizer (((omega B (p := 2) 2).map B.subtype : Subgroup P) : Set P) ≤ B := by
  classical
  obtain ⟨hZB, hW, hWcard⟩ := quaternion_factor_abelian_base_omega hno hZ Q B hCB
  have hWcentral : (omega₁ B (p := 2)).map B.subtype ≤ center P := by
    rw [hW]
    exact map_subtype_le _
  let z : Q := e.symm (QuaternionGroup.a 2)
  have hz : orderOf z = 2 := (e.symm.orderOf_eq _).trans (by rw [QuaternionGroup.orderOf_a]; decide)
  have hzP : orderOf (z : P) = 2 := (orderOf_injective Q.subtype Q.subtype_injective z).trans hz
  have hzB : (z : P) ∈ B := hZB (quaternion_central_factor_involution_roots Q e hgen z hz).1
  let zB : B := ⟨z, hzB⟩
  have hzBord : orderOf zB = 2 :=
    (orderOf_injective B.subtype B.subtype_injective zB).symm.trans hzP
  have hns : ¬ ∃ a : B, a ^ 2 = zB := by
    rintro ⟨a, ha⟩
    exact quaternion_factor_involution_not_square_in_normal_abelian hno hZ Q e hgen z hz B hBD
      ⟨a, congrArg Subtype.val ha⟩
  obtain ⟨b, hgenB, -⟩ :=
    (hP.to_subgroup B).exists_cyclic_complement_of_nonsquare_involution hWcard zB hzBord hns
  by_cases hb4 : (b : P) ^ 4 = 1
  · apply quaternion_factor_omega_two_centralizer_le_of_exponent_four Q B hCB
    let : CommGroup B := IsMulCommutative.instCommGroup
    have hz4 : zB ^ 4 = 1 := by
      rw [show 4 = 2 * 2 by decide, pow_mul, ← hzBord, pow_orderOf_eq_one, one_pow]
    have hle : zpowers b ⊔ zpowers zB ≤ (powMonoidHom 4 : B →* B).ker := by
      apply sup_le <;> apply zpowers_le.mpr
      · exact Subtype.ext hb4
      · exact hz4
    intro a
    exact hle (hgenB ▸ mem_top a)
  · by_contra hfail
    obtain ⟨R, hRn, hBR, hRD, hcent, hi, hself⟩ :=
      quaternion_factor_exists_normal_index_two_step hP Q hgen B hBD hCB hfail
    let : R.Normal := hRn
    have hgenP : zpowers (b : P) ⊔ zpowers (z : P) = B := by
      have hh := congrArg (fun H : Subgroup B => H.map B.subtype) hgenB
      simpa only [map_sup, MonoidHom.map_zpowers, ← MonoidHom.range_eq_map,
        range_subtype, zB, coe_subtype] using hh
    rcases normal_cyclic_times_two_extension_obstruction hP B R b z hzP hgenP hb4
      hBR hi hcent hself hWcentral hWcard with hE | ⟨H, hHn, hHa, hHR, hroot⟩
    · exact hno hE
    · let : H.Normal := hHn
      let : IsMulCommutative H := hHa
      exact quaternion_factor_involution_not_square_in_normal_abelian hno hZ Q e hgen z hz H
        (hHR.trans hRD) hroot

end Subgroup
