module

public import Theory.GroupAction.C4SquareHallJankoActions
public import Theory.GroupTheory.ElementaryIndexTwoOrbit
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators
import Mathlib.Tactic

/-!
# Split inversions force a normal elementary sixteen

Suppose an elementary supplement acts on a normal abelian C₄-square by
partial inversions, and an outer action exchanges those inversions and the
two square lines. If the centralizer of the normal omega four has index two
and is generated by the base and supplement, the ambient group contains a
normal elementary abelian subgroup of order sixteen.

Lift one partial inversion to an involution `x` in the supplement. Together
with the corresponding square `a²`, it generates an elementary four `E`
normalized by the centralizer. The exchanged action and the distinct square
lines make `E` disjoint from its outer conjugate. The index-two orbit theorem
then gives the required normal elementary sixteen.

Source: Janko–Thompson, Math. Z. 113 (1970), Theorem 1.3(a), printed p.386;
MacWilliams, Trans. AMS 150 (1970), DOI 10.1090/S0002-9947-1970-0276324-3.
-/

open Subgroup
open scoped IsMulCommutative
namespace C4SquareExtension

private theorem commute_mem {P : Type*} [Group P] (D : Subgroup P)
    [IsMulCommutative D] {a b : P} (ha : a ∈ D) (hb : b ∈ D) : Commute a b := by
  exact congrArg Subtype.val (mul_comm (⟨a, ha⟩ : D) ⟨b, hb⟩)

/-- Actual split-inversion actions in an elementary supplement force a normal
 elementary abelian subgroup of order sixteen. -/
public theorem SplitInversionAutActions.exists_normal_elementary_sixteen
    {P : Type*} [Group P] [Finite P]
    (W D B : Subgroup P) [W.Normal] [IsElementaryAbelian 2 W]
    [D.Normal] [IsMulCommutative D] [IsElementaryAbelian 2 B]
    (_hW : Nat.card W = 4) (hO : (omega₁ D (p := 2)).map D.subtype = W)
    (hWB : W ≤ B) (hC : centralizer (W : Set P) = B ⊔ D)
    (hindex : (centralizer (W : Set P)).index = 2)
    (f : SplitInversionAutActions
      ((MulAut.conjNormal : P →* MulAut D).comp B.subtype).range
      (MulAut.conjNormal : P →* MulAut D).range) :
    ∃ N : Subgroup P, N.Normal ∧ IsElementaryAbelian 2 N ∧ Nat.card N = 16 := by
  let q : P →* MulAut D := MulAut.conjNormal
  obtain ⟨xB, hx⟩ := f.u_mem
  obtain ⟨s, hs⟩ := f.t_mem
  let x : P := xB
  have hqx : q x = f.u := hx
  have hqs : q s = f.t := hs
  let a : P := f.a
  let b : P := f.b
  let z : P := a ^ 2
  let w : P := b ^ 2
  have ha4 : a ^ 4 = 1 := congrArg Subtype.val f.a_four
  have hz2 : z * z = 1 := by simpa [z, ← pow_add] using ha4
  have hz1 : z ≠ 1 := fun h => f.a_two_ne (Subtype.ext h)
  have hzw : z ≠ w := fun h => f.squares_ne (Subtype.ext h)
  have hzW : z ∈ W := by
    rw [← hO]
    refine ⟨f.a ^ 2, ?_, rfl⟩
    apply Subgroup.subset_closure
    change (f.a ^ 2) ^ (2 ^ 1) = 1
    simpa [← pow_mul] using f.a_four
  have hxB : x ∈ B := xB.property
  have hx2 : x * x = 1 := by
    simpa [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) x hxB
  have hzx : Commute z x := commute_mem B (hWB hzW) hxB
  have hqD : ∀ d : P, d ∈ D → q d = 1 := by
    intro d hd
    ext e
    exact (commute_mem D hd e.property).mul_inv_cancel
  have hqz : q z = 1 := hqD z (D.pow_mem f.a.property 2)
  have hqw : q w = 1 := hqD w (D.pow_mem f.b.property 2)
  have hu1 : f.u ≠ 1 := by
    intro h
    have hh : f.a = f.a⁻¹ := by simpa [h] using f.ua
    apply f.a_two_ne
    calc f.a ^ 2 = f.a * f.a := pow_two _
         _ = 1 := by nth_rw 1 [hh]; exact inv_mul_cancel _
  have hv1 : f.v ≠ 1 := by
    intro h
    have hh : f.b = f.b⁻¹ := by simpa [h] using f.vb
    apply f.b_two_ne
    calc f.b ^ 2 = f.b * f.b := pow_two _
         _ = 1 := by nth_rw 1 [hh]; exact inv_mul_cancel _
  have huv : f.u ≠ f.v := by
    intro h
    have hh : f.a⁻¹ = f.a := by rw [← f.ua, h, f.va]
    apply f.a_two_ne
    calc f.a ^ 2 = f.a * f.a := pow_two _
         _ = 1 := by nth_rw 2 [← hh]; exact mul_inv_cancel _
  have hx1 : x ≠ 1 := by
    intro h
    exact hu1 (by simpa [h] using hqx.symm)
  have hzxne : z ≠ x := by
    intro h
    exact hu1 (by rw [← hqx, ← h, hqz])
  let E := closure ({z, x} : Set P)
  let : IsKleinFour E := isKleinFour_closure_pair z x hz2 hx2 hz1 hx1 hzxne hzx
  let : IsElementaryAbelian 2 E :=
    { toIsMulCommutative := IsKleinFour.isMulCommutative
      exponent_dvd_p := by simp }
  have hzE : z ∈ E := subset_closure (by simp)
  have hxE : x ∈ E := subset_closure (by simp)
  have hEB : E ≤ B := (closure_le _).mpr (by
    intro e he
    rcases (by simpa using he : e = z ∨ e = x) with rfl | rfl
    · exact hWB hzW
    · exact hxB)
  have hEC : E ≤ centralizer (W : Set P) := by
    rw [hC]
    exact hEB.trans le_sup_left
  have hBN : B ≤ normalizer (E : Set P) := by
    apply le_trans _ (centralizer_le_normalizer _)
    intro c hc e he
    exact (commute_mem B (hEB he) hc).eq
  have hxa : x * a * x⁻¹ = a⁻¹ := by
    have hh := congrArg (fun k : MulAut D => (k f.a : P)) hqx
    exact hh.trans (congrArg Subtype.val f.ua)
  have hxb : x * b * x⁻¹ = b := by
    have hh := congrArg (fun k : MulAut D => (k f.b : P)) hqx
    exact hh.trans (congrArg Subtype.val f.ub)
  have hax : a * x * a⁻¹ = z * x := by
    have hxa' : x * a = a⁻¹ * x := (mul_inv_eq_iff_eq_mul).mp hxa
    have hax' : a * x = x * a⁻¹ := by
      apply (eq_mul_inv_iff_mul_eq).mpr
      calc a * x * a = a * (x * a) := mul_assoc _ _ _
           _ = x := by rw [hxa']; group
    calc a * x * a⁻¹ = x * a⁻¹ * a⁻¹ := by rw [hax']
         _ = x * (a ^ 2)⁻¹ := by group
         _ = x * z := by rw [show (a ^ 2)⁻¹ = z from inv_eq_of_mul_eq_one_right hz2]
         _ = z * x := hzx.eq.symm
  have hbx : b * x * b⁻¹ = x := by
    have hh : Commute x b := (mul_inv_eq_iff_eq_mul).mp hxb
    exact hh.symm.mul_inv_cancel
  have hgenN : ∀ d : P, d ∈ D → d ∈ normalizer (E : Set P) := by
    have hpair : ∀ d ∈ ({a,b} : Set P), d ∈ normalizer (E : Set P) := by
      intro d hd
      apply mem_normalizer_iff_map_conj_eq.mpr
      apply eq_of_le_of_card_ge
      · apply map_le_iff_le_comap.mpr
        apply (closure_le _).mpr
        intro e he
        change d * e * d⁻¹ ∈ E
        rcases (by simpa using he : e = z ∨ e = x) with rfl | rfl
        · have hdD : d ∈ D := by
            rcases (by simpa using hd : d = a ∨ d = b) with rfl | rfl
            · exact f.a.property
            · exact f.b.property
          rw [(commute_mem D hdD (D.pow_mem f.a.property 2)).mul_inv_cancel]
          exact hzE
        · rcases (by simpa using hd : d = a ∨ d = b) with rfl | rfl
          · rw [hax]; exact E.mul_mem hzE hxE
          · rw [hbx]; exact hxE
      · rw [card_map_of_injective (MulAut.conj d).injective]
    have hbase : D = closure ({a,b} : Set P) := by
      have hh := congrArg (Subgroup.map D.subtype) f.base
      rw [← MonoidHom.range_eq_map, D.range_subtype] at hh
      simpa [MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton,
        a, b] using hh.symm
    rw [hbase]
    exact (closure_le _).mpr hpair
  have hCN : centralizer (W : Set P) ≤ normalizer (E : Set P) := by
    rw [hC]
    exact sup_le hBN hgenN
  have hsz : (MulAut.conj s) z = w := by
    have hh := congrArg (fun k : MulAut D => (k (f.a ^ 2) : P)) hqs
    exact hh.trans (congrArg Subtype.val f.ta_two)
  have hsC : s ∉ centralizer (W : Set P) := by
    intro hh
    have hh' : Commute s z := ((mem_centralizer_iff.mp hh) z hzW).symm
    exact hzw (hh'.mul_inv_cancel.symm.trans hsz)
  have hforms : ∀ e ∈ E, e = 1 ∨ e = z ∨ e = x ∨ e = z * x := by
    intro e he
    exact (mem_closure_pair_iff z x hz2 hx2 hzx e).mp he
  have hqforms : ∀ e ∈ E, q e = 1 ∨ q e = f.u := by
    intro e he
    rcases hforms e he with rfl | rfl | rfl | rfl <;> simp [hqz, hqx]
  have hker : ∀ e ∈ E, q e = 1 → e = 1 ∨ e = z := by
    intro e he hqe
    rcases hforms e he with rfl | rfl | rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact (hu1 (hqx.symm.trans hqe)).elim
    · exact (hu1 (by simpa [map_mul, hqz, hqx] using hqe)).elim
  have hdis : Disjoint E (E.map (MulAut.conj s).toMonoidHom) := by
    apply disjoint_def.mpr
    intro e he he'
    obtain ⟨d, hd, rfl⟩ := he'
    have hqd : q d = 1 := by
      rcases hqforms d hd with hh | hh
      · exact hh
      · have hv : q ((MulAut.conj s) d) = f.v := by
          simpa only [MulAut.conj_apply, map_mul, map_inv, hqs, hh] using f.tut
        rcases hqforms _ he with h1 | hu
        · exact (hv1 (hv.symm.trans h1)).elim
        · exact (huv (hu.symm.trans hv)).elim
    rcases hker d hd hqd with rfl | rfl
    · simp
    · change (MulAut.conj s) z ∈ E at he
      change (MulAut.conj s) z = 1
      rw [hsz] at he ⊢
      rcases hker w he hqw with hh | hh
      · exact hh
      · exact (hzw hh.symm).elim
  exact exists_normal_elementary_sixteen_of_disjoint_conjugate_four
    (centralizer (W : Set P)) E hindex hEC hCN
    (IsKleinFour.card_four (G := E)) s hsC hdis
end C4SquareExtension
