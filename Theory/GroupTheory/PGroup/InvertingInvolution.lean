module

public import Mathlib.GroupTheory.Sylow

/-!
# Inverting involutions and central Sylow involutions

If every element of square one in a Sylow two-subgroup is central, an
element of two-power order inverted by an involution has square one.
The cyclic groups generated by the two elements generate a two-group;
conjugating it into the chosen Sylow makes the inverting element central.

This is the elementary obstruction to strong reality used in Lyons,
*A Characterization of the Group U₃(4)*, Lemma 1(b), pp. 372–373.
-/

namespace Sylow

/-- Central Sylow involutions cannot invert an element of two-power order
unless that element already has square one. -/
public theorem square_eq_one_of_inverted_by_square_one
    {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    (hcentral : ∀ s : S, s ^ 2 = 1 → s ∈ Subgroup.center S)
    {x u : G} {n : ℕ} (hx : x ^ (2 ^ n) = 1) (hu : u ^ 2 = 1)
    (hinv : u * x * u⁻¹ = x⁻¹) : x ^ 2 = 1 := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hxp : IsPGroup 2 (Subgroup.zpowers x) :=
    IsPGroup.of_card_dvd_pow (n := n) (by
      simpa only [Nat.card_zpowers] using orderOf_dvd_of_pow_eq_one hx)
  have hup : IsPGroup 2 (Subgroup.zpowers u) :=
    IsPGroup.of_card_dvd_pow (n := 1) (by
      simpa only [Nat.card_zpowers, pow_one] using orderOf_dvd_of_pow_eq_one hu)
  have hnorm : Subgroup.zpowers u ≤ Subgroup.normalizer (Subgroup.zpowers x) := by
    rw [Subgroup.zpowers_le, Subgroup.mem_normalizer_iff_map_conj_eq,
      MonoidHom.map_zpowers]
    change Subgroup.zpowers (u * x * u⁻¹) = Subgroup.zpowers x
    rw [hinv, Subgroup.zpowers_inv]
  obtain ⟨P, hP⟩ := (hxp.to_sup_of_normal_left' hup hnorm).exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G P S
  have hxP : x ∈ (P : Subgroup G) :=
    (le_sup_left.trans hP) (Subgroup.mem_zpowers x)
  have huP : u ∈ (P : Subgroup G) :=
    (le_sup_right.trans hP) (Subgroup.mem_zpowers u)
  have hmem {a : G} (ha : a ∈ (P : Subgroup G)) :
      (MulAut.conj g) a ∈ (S : Subgroup G) := by
    rw [← hg]
    exact Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom ha
  let xS : S := ⟨(MulAut.conj g) x, hmem hxP⟩
  let uS : S := ⟨(MulAut.conj g) u, hmem huP⟩
  have huS : uS ^ 2 = 1 := by
    apply Subtype.ext
    change ((MulAut.conj g) u) ^ 2 = 1
    exact (map_pow (MulAut.conj g) u 2).symm.trans (by rw [hu, map_one])
  have hcomm := congrArg Subtype.val (Subgroup.mem_center_iff.mp (hcentral uS huS) xS)
  change (MulAut.conj g) x * (MulAut.conj g) u =
    (MulAut.conj g) u * (MulAut.conj g) x at hcomm
  have hux : u * x = x * u := by
    apply (MulAut.conj g).injective
    simpa only [map_mul] using hcomm.symm
  have hself : x = x⁻¹ := by
    calc
      x = u * x * u⁻¹ := by rw [hux, mul_assoc, mul_inv_cancel, mul_one]
      _ = x⁻¹ := hinv
  rw [pow_two]
  calc
    x * x = x⁻¹ * x := congrArg (· * x) hself
    _ = 1 := inv_mul_cancel x

end Sylow
