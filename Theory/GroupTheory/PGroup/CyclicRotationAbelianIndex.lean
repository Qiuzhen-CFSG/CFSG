module

public import Theory.GroupTheory.PGroup.BinaryCommutatorIndex
public import Theory.Frattini.BinarySquares
public import Theory.GroupTheory.PGroup.OmegaImage

/-!
# Abelian self-centralizers controlled by a cyclic rotation subgroup

Let a finite group have a normal cyclic subgroup generated by an even-order
rotation. Suppose its rotation centralizer has index at most two, all squares
lie in the subgroup generated by the rotation square, and centralizing that
square forces centralizing the rotation. Then a normal abelian self-centralizer
has index at most the order of its first omega subgroup.

The normal-abelian commutator calculation places the abelian subgroup inside
the rotation centralizer, so self-centralization puts the rotation in it.
Inside this centralizer the commutators are involutions in the cyclic rotation
subgroup. The binary commutator pairing bounds the internal index by the
abelian subgroup modulo rotations. The square homomorphism shows that this
quotient has half the order of first omega, canceling the ambient index two.

This is the elementary rotation calculation accompanying the commutator
estimate in `BinaryCommutatorIndex`, used in the specialization of
MacWilliams–Sah quoted by Janko–Thompson, Math. Z. 113 (1970), result 1.1,
p.385. No classification, cyclic-center, or p-group assumption is used.
-/

open Subgroup
open scoped IsMulCommutative commutatorElement

private theorem rotation_square_count
    {B : Type*} [CommGroup B] [Finite B] (r : B)
    (hr : 2 ∣ orderOf r) (hsq : ∀ b : B, b ^ 2 ∈ zpowers (r ^ 2)) :
    2 * Nat.card (B ⧸ zpowers r) = Nat.card (omega₁ B (p := 2)) := by
  have hS : (powMonoidHom 2 : B →* B).range = zpowers (r ^ 2) := by
    apply le_antisymm
    · rintro x ⟨b, rfl⟩
      exact hsq b
    · exact zpowers_le.mpr ⟨r, rfl⟩
  have hindex : (zpowers (r ^ 2)).index = Nat.card (omega₁ B (p := 2)) := by
    rw [← hS, index_range, IsPGroup.square_ker_eq_omega_one]
  have hdouble : Nat.card (zpowers r) = 2 * Nat.card (zpowers (r ^ 2)) := by
    rw [Nat.card_zpowers, Nat.card_zpowers, orderOf_pow_of_dvd (by decide) hr]
    exact (Nat.mul_div_cancel' hr).symm
  have hB := card_eq_card_quotient_mul_card_subgroup (zpowers r)
  have hB' := (zpowers (r ^ 2)).card_mul_index
  rw [hindex] at hB'
  rw [hdouble] at hB
  have hpos := Nat.card_pos (α := zpowers (r ^ 2))
  nlinarith

private theorem central_rotation_index
    {G : Type*} [Group G] [Finite G] (r : G)
    (hr : 2 ∣ orderOf r) (hrc : r ∈ center G)
    (hsq : ∀ x : G, x ^ 2 ∈ zpowers (r ^ 2))
    (A : Subgroup G) [IsMulCommutative A] (hrA : r ∈ A)
    (hC : centralizer (A : Set G) ≤ A) :
    2 * A.index ≤ Nat.card (omega₁ A (p := 2)) := by
  let : CommGroup A := IsMulCommutative.instCommGroup
  let R := zpowers r
  let : CommGroup R := IsMulCommutative.instCommGroup
  have hRc : R ≤ center G := zpowers_le.mpr hrc
  have hsR : zpowers (r ^ 2) ≤ R := zpowers_le.mpr (R.pow_mem (mem_zpowers r) 2)
  have hD : _root_.commutator G ≤ R := by
    apply commutator_le_closure_squares.trans
    apply (closure_le R).mpr
    rintro x ⟨y, rfl⟩
    exact hsR (hsq y)
  have hcc (x y : G) : ⁅x, y⁆ ∈ R :=
    hD (commutator_mem_commutator (mem_top x) (mem_top y))
  have hc2 (x y : G) : ⁅x, y⁆ ^ 2 = 1 := by
    have hs : ⁅x ^ 2, y⁆ = 1 := commutatorElement_eq_one_iff_mul_comm.mpr
      (mem_center_iff.mp (hRc (hsR (hsq x))) y).symm
    rw [pow_two, commutatorElement_mul_left_eq_conj_mul,
      mem_center_iff.mp (hRc (hcc x y)) x, mul_inv_cancel_right, ← pow_two] at hs
    exact hs
  let Z := (powMonoidHom 2 : R →* R).ker.map R.subtype
  have hZc : Z ≤ center G := (map_subtype_le _).trans hRc
  have hZ : Nat.card Z = 2 := by
    rw [show Nat.card Z = Nat.card (powMonoidHom 2 : R →* R).ker from
      card_map_of_injective R.subtype_injective,
      IsCyclic.card_powMonoidHom_ker, show Nat.card R = orderOf r from Nat.card_zpowers r,
      Nat.gcd_eq_right hr]
  have hc : ⁅(⊤ : Subgroup G), A⁆ ≤ Z := by
    apply commutator_le.mpr
    intro g _ a _
    refine ⟨⟨⁅g, a⁆, hcc g a⟩, ?_, rfl⟩
    change (⟨⁅g, a⁆, hcc g a⟩ : R) ^ 2 = 1
    exact Subtype.ext (hc2 g a)
  let rA : A := ⟨r, hrA⟩
  let K := zpowers rA
  have hsqA (a : A) : a ^ 2 ∈ zpowers (rA ^ 2) := by
    obtain ⟨n, hn⟩ := mem_zpowers_iff.mp (hsq a)
    apply mem_zpowers_iff.mpr
    exact ⟨n, Subtype.ext hn⟩
  let : IsElementaryAbelian 2 (A ⧸ K) := {
    toIsMulCommutative := inferInstance
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr fun q => by
      obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective K q
      rw [← map_pow]
      exact (QuotientGroup.eq_one_iff (N := K) _).mpr
        ((zpowers_le.mpr (K.pow_mem (mem_zpowers rA) 2)) (hsqA a)) }
  have hK (a : A) (ha : a ∈ K) (g : G) : Commute g (a : G) := by
    obtain ⟨n, rfl⟩ := mem_zpowers_iff.mp ha
    exact (show Commute g r from mem_center_iff.mp hrc g).zpow_right n
  have hi := (index_antitone hC).trans
    (centralizer_index_le_card_quotient_of_binary_commutators A Z K hZc hZ hc hK)
  have hcount := rotation_square_count rA (by simpa only [← orderOf_coe rA] using hr) hsqA
  exact (Nat.mul_le_mul_left 2 hi).trans_eq hcount

namespace Subgroup

/-- A normal abelian self-centralizer controlled by a cyclic rotation subgroup
has index at most its first omega order. Even rotation order suffices. -/
public theorem index_le_omega_one_of_cyclic_rotation
    {Q : Type*} [Group Q] [Finite Q] (r : Q) (hr : 2 ∣ orderOf r)
    (hrn : (zpowers r).Normal)
    (hi : (centralizer ({r} : Set Q)).index ≤ 2)
    (hsq : ∀ x : Q, x ^ 2 ∈ zpowers (r ^ 2))
    (hcent : centralizer ({r ^ 2} : Set Q) ≤ centralizer ({r} : Set Q))
    (A : Subgroup Q) [A.Normal] [IsMulCommutative A]
    (hC : centralizer (A : Set Q) ≤ A) :
    A.index ≤ Nat.card (omega₁ A (p := 2)) := by
  let R := zpowers r
  let : R.Normal := hrn
  let H := centralizer ({r} : Set Q)
  have hsR : zpowers (r ^ 2) ≤ R := zpowers_le.mpr (R.pow_mem (mem_zpowers r) 2)
  have hAH : A ≤ H := (normal_abelian_centralizes_squares_of_squares_mem
    A R (fun a _ => hsR (hsq a)) (mem_zpowers r)).trans hcent
  have hrA : r ∈ A := hC (by
    intro a ha
    exact mem_centralizer_singleton_iff.mp (hAH ha))
  let rH : H := ⟨r, mem_centralizer_singleton_iff.mpr rfl⟩
  have hrc : rH ∈ center H := by
    apply mem_center_iff.mpr
    intro x
    exact Subtype.ext (mem_centralizer_singleton_iff.mp x.property)
  have hsqH (x : H) : x ^ 2 ∈ zpowers (rH ^ 2) := by
    obtain ⟨n, hn⟩ := mem_zpowers_iff.mp (hsq x)
    exact mem_zpowers_iff.mpr ⟨n, Subtype.ext hn⟩
  let B := A.subgroupOf H
  have hCB : centralizer (B : Set H) ≤ B := by
    intro x hx
    apply hC
    intro a ha
    exact congrArg Subtype.val (hx ⟨a, hAH ha⟩ ha)
  have hb := central_rotation_index rH
    (by simpa only [← orderOf_coe rH] using hr) hrc hsqH B hrA hCB
  have hO := Nat.card_congr ((subgroupOfEquivOfLe hAH).omega 2 1).toEquiv
  change Nat.card (omega₁ B (p := 2)) = Nat.card (omega₁ A (p := 2)) at hO
  rw [hO] at hb
  have hidx := relIndex_mul_index hAH
  change B.index * H.index = A.index at hidx
  calc
    A.index = B.index * H.index := hidx.symm
    _ ≤ B.index * 2 := Nat.mul_le_mul_left _ hi
    _ = 2 * B.index := Nat.mul_comm _ _
    _ ≤ Nat.card (omega₁ A (p := 2)) := hb

/-- The index-four specialization for rotations of order divisible by eight. -/
public theorem index_le_four_of_cyclic_rotation
    {Q : Type*} [Group Q] [Finite Q] (r : Q) (hr : 8 ∣ orderOf r)
    (hrn : (zpowers r).Normal)
    (hi : (centralizer ({r} : Set Q)).index ≤ 2)
    (hsq : ∀ x : Q, x ^ 2 ∈ zpowers (r ^ 2))
    (hcent : centralizer ({r ^ 2} : Set Q) ≤ centralizer ({r} : Set Q))
    (A : Subgroup Q) [A.Normal] [IsMulCommutative A]
    (hC : centralizer (A : Set Q) ≤ A)
    (hO : Nat.card (omega₁ A (p := 2)) ≤ 4) : A.index ≤ 4 :=
  (index_le_omega_one_of_cyclic_rotation r ((by decide : 2 ∣ 8).trans hr)
    hrn hi hsq hcent A hC).trans hO

end Subgroup
