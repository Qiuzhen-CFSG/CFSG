module
public import Theory.GroupTheory.PGroup.SupercriticalExistence.ClassTwoOmega

/-!
# Odd class-two groups generated by elements of prime order

When an odd-prime first omega subgroup is the whole group and commutators
are central, the group has exponent dividing that prime. For a nontrivial
group its exponent is exactly the prime. This applies the collection
formula for first omega to the actual ambient elements.

Source: Aschbacher–Smith, the first step of Lemma A.1.24, printed p.25,
citing Aschbacher, *Finite Group Theory*, (23.11).
-/

open Subgroup

/-- The exponent consequence of generation by first omega in odd class two. -/
public theorem exponent_dvd_prime_of_omega_one_eq_top
    {G : Type*} [Group G] {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (hclass : _root_.commutator G ≤ center G) (homega : omega₁ G (p := p) = ⊤) :
    Monoid.exponent G ∣ p := by
  apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
  intro x
  have hx : x ∈ omega₁ G (p := p) := homega ▸ mem_top x
  exact congrArg Subtype.val
    (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (exponent_omega_one_dvd_of_class_two hp hclass) (⟨x, hx⟩ : omega₁ G (p := p)))

/-- In the nontrivial case the exponent is exactly the odd prime. -/
public theorem exponent_eq_prime_of_omega_one_eq_top
    {G : Type*} [Group G] [Nontrivial G] {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (hclass : _root_.commutator G ≤ center G) (homega : omega₁ G (p := p) = ⊤) :
    Monoid.exponent G = p := by
  rcases (Nat.dvd_prime (Fact.out : p.Prime)).mp
    (exponent_dvd_prime_of_omega_one_eq_top hp hclass homega) with h | h
  · exact (not_subsingleton G (Monoid.exp_eq_one_iff.mp h)).elim
  · exact h
