module

public import Theory.GroupTheory.PGroup.AbelianCriticalSixteenFixedAction
public import Theory.GroupTheory.PGroup.AbelianCriticalSixteenCore
public import Theory.GroupTheory.PGroup.C4SquareCubicExtension
public import Theory.GroupAction.CubicOrbitElementarySixteen

/-!
# From a cubic congruence core to its inverting extension

Let C be an abelian critical C₄-square with central omega four and no normal
elementary eight. An invariant order-sixty-four core R with cubic-fixed-free
quotient R/C supplies the complete inverting-extension interface when [P:R]=2.
Orbit counting produces a fixed outside involution; the fixed-action theorem
makes it invert C. Every nonzero core coset and its cubic translate generate
R/C. A square-one mixed commutator would therefore make the elementary eight
generated by the outside involution and central omega normal in P.

If R=P, the same base fixed-point condition puts all squares in central omega.
The cubic orbit of an outside involution then generates a normal elementary
sixteen. Thus this case has only central involutions. The final assembly
uses the invariant core supplied by the congruence-action calculation to
construct the extension whenever there is a noncentral involution.

Source: MacWilliams, Trans. AMS 150 (1970), Case 1.2, (xxi), Lemma 3 and the
argument after (xxii), printed pp.380–383,
DOI 10.1090/S0002-9947-1970-0276324-3. The elementary-orbit argument avoids a
presentation classification or a generator-rank hypothesis.
-/

open Subgroup

namespace IsCriticalPSubgroup
variable {P : Type*} [Group P] [Finite P] {C R : Subgroup P}

private theorem normalizes_central_sup_zpowers
    (W : Subgroup P) (hW : W ≤ center P) (t g : P)
    (hg : g * t * g⁻¹ * t⁻¹ ∈ W) : g ∈ normalizer (W ⊔ zpowers t : Subgroup P) := by
  apply mem_normalizer_iff_map_conj_eq.mpr
  apply eq_of_le_of_card_ge
  · rw [Subgroup.map_sup, MonoidHom.map_zpowers]
    apply sup_le
    · rintro _ ⟨w, hw, rfl⟩
      have he : MulAut.conj g w = w := by
        change g * w * g⁻¹ = w
        rw [mem_center_iff.mp (hW hw) g, mul_inv_cancel_right]
      change MulAut.conj g w ∈ W ⊔ zpowers t
      rw [he]
      exact (le_sup_left : W ≤ W ⊔ zpowers t) hw
    · apply zpowers_le.mpr
      have he : MulAut.conj g t = (g * t * g⁻¹ * t⁻¹) * t := by
        simp [MulAut.conj_apply]
      change MulAut.conj g t ∈ W ⊔ zpowers t
      rw [he]
      exact mul_mem_sup hg (mem_zpowers t)
  · rw [card_map_of_injective (MulAut.conj g).injective]

/-- A cubic orbit generating the core forces every mixed commutator with a
fixed outside inverter to have nontrivial square. -/
public theorem mixed_commutator_of_cubic_orbit
    (hC : IsCriticalPSubgroup 2 C) [IsMulCommutative C]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (e : C ≃* C4SquareExtension.Model)
    (a : MulAut P) (t : P) (ht : t ^ 2 = 1) (hfix : a t = t)
    (hinv : ∀ c ∈ C, t * c * t⁻¹ = c⁻¹)
    (hCR : C ≤ R) (hi : R.index = 2) (htR : t ∉ R)
    (hgen : ∀ r ∈ R, r ∉ C → C ⊔ zpowers r ⊔ zpowers (a r) = R)
    (r : P) (hr : r ∈ R) (hrC : r ∉ C) :
    (r * t * r⁻¹ * t⁻¹) ^ 2 ≠ 1 := by
  let : C.Characteristic := hC.characteristic
  let W := (omega₁ (center P) (p := 2)).map (center P).subtype
  have hW : W ≤ center P := map_subtype_le _
  have hWC : W ≤ C := by
    dsimp [W]
    rw [← hC.omega_one_map_eq_center hno hZ]
    exact map_subtype_le _
  have hs (c : P) (hc : c ∈ C) (hc2 : c ^ 2 = 1) : c ∈ W :=
    hC.mem_omega_center_of_square_eq_one hno hZ hc hc2
  have hfour (c : P) (hc : c ∈ C) : c ^ 4 = 1 := by
    have hh : (⟨c, hc⟩ : C) ^ 4 = 1 := e.injective (by
      rw [map_pow, map_one]
      exact (by decide : ∀ x : C4SquareExtension.Model, x ^ 4 = 1) _)
    exact congrArg Subtype.val hh
  have hdiff (g : P) : g * t * g⁻¹ * t⁻¹ ∈ C := by
    rw [← conjNormal_ker_eq_of_selfCentralizing_abelian C hC.centralizer_eq_self_of_abelian.le]
    apply MonoidHom.mem_ker.mpr
    simp only [map_mul, map_inv]
    rw [(hC.c4_square_conjugations_commute hno hZ e g t).eq]
    group
  let E := W ⊔ zpowers t
  let N := normalizer (E : Set P)
  have hCN : C ≤ N := by
    intro c hc
    apply normalizes_central_sup_zpowers W hW t c
    have he : c * t * c⁻¹ * t⁻¹ = c ^ 2 := by
      have hh := hinv c⁻¹ (C.inv_mem hc)
      rw [inv_inv] at hh
      calc
        c * t * c⁻¹ * t⁻¹ = c * (t * c⁻¹ * t⁻¹) := by group
        _ = c ^ 2 := by rw [hh, pow_two]
    rw [he]
    exact hs _ (C.pow_mem hc 2) (by simpa only [← pow_mul] using hfour c hc)
  intro hbad
  have hdW := hs _ (hdiff r) hbad
  have hrN : r ∈ N := normalizes_central_sup_zpowers W hW t r hdW
  have harN : a r ∈ N := by
    apply normalizes_central_sup_zpowers W hW t (a r)
    apply hs _ (hdiff (a r))
    have hh := congrArg a hbad
    simpa only [map_pow, map_mul, map_inv, map_one, hfix] using hh
  have hRN : R ≤ N := by
    rw [← hgen r hr hrC]
    exact sup_le (sup_le hCN (zpowers_le.mpr hrN)) (zpowers_le.mpr harN)
  have htN : t ∈ N := le_normalizer (show t ∈ E from
    (le_sup_right : zpowers t ≤ E) (mem_zpowers t))
  have hNtop : N = ⊤ := by
    apply top_unique
    intro x _
    by_cases hxR : x ∈ R
    · exact hRN hxR
    · have hd : t⁻¹ * x ∈ R := by
        rw [mul_mem_iff_of_index_two hi, inv_mem_iff]
        exact iff_of_false htR hxR
      simpa only [mul_inv_cancel_left] using N.mul_mem htN (hRN hd)
  let : E.Normal := normalizer_eq_top_iff.mp hNtop
  let : IsElementaryAbelian 2 (omega₁ (center P) (p := 2)) :=
    IsElementaryAbelian.omega₁_of_isMulCommutative _
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.map_subtype
  let : IsElementaryAbelian 2 (zpowers t) := IsElementaryAbelian.zpowers_of_pow_eq_one ht
  have htW : t ∈ centralizer (W : Set P) := by
    intro w hw
    exact (mem_center_iff.mp (hW hw) t).symm
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.sup_of_le_centralizer (zpowers_le.mpr htW)
  have hEW := normal_elementary_le_omega_center_of_no_normal_eight hno hZ E
  exact htR (hCR (hWC (hEW ((le_sup_right : zpowers t ≤ E) (mem_zpowers t)))))

/-- Every nonzero core coset and its cubic translate generate the four-element
quotient, hence generate the core together with its base. -/
public theorem cubic_orbit_generates_core
    (hC : IsCriticalPSubgroup 2 C) [IsMulCommutative C]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (e : C ≃* C4SquareExtension.Model)
    (a : MulAut P) (hCR : C ≤ R) (hcard : Nat.card R = 64)
    (hRi : ∀ r ∈ R, a r ∈ R)
    (hfree : ∀ r ∈ R, a r * r⁻¹ ∈ C → r ∈ C)
    (r : P) (hr : r ∈ R) (hrC : r ∉ C) :
    C ⊔ zpowers r ⊔ zpowers (a r) = R := by
  let : C.Characteristic := hC.characteristic
  let D := C.subgroupOf R
  let q := QuotientGroup.mk' D
  have hDcard : Nat.card D = 16 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hCR).toEquiv,
      Nat.card_congr e.toEquiv]
    norm_num [C4SquareExtension.Model, Nat.card_prod, Nat.card_eq_fintype_card]
  have hQcard : Nat.card (R ⧸ D) = 4 := by
    have hh := D.card_mul_index
    rw [hDcard, hcard] at hh
    change 16 * Nat.card (R ⧸ D) = 64 at hh
    omega
  let u : R := ⟨r, hr⟩
  let v : R := ⟨a r, hRi r hr⟩
  have hu : q u ≠ 1 := fun hh => hrC ((QuotientGroup.eq_one_iff u).mp hh)
  have hv : q v ≠ 1 := by
    intro hh
    have harC : a r ∈ C := (QuotientGroup.eq_one_iff v).mp hh
    exact hrC ((characteristic_iff_comap_eq.mp hC.characteristic a) ▸ harC)
  have huv : q u ≠ q v := by
    intro hh
    apply hrC (hfree r hr ?_)
    have he : q (v * u⁻¹) = 1 := by rw [map_mul, map_inv, hh, mul_inv_cancel]
    exact (QuotientGroup.eq_one_iff (N := D) (v * u⁻¹)).mp he
  let : Nontrivial (R ⧸ D) := nontrivial_of_ne (q u) 1 hu
  have hs (x : R ⧸ D) : x ^ 2 = 1 := by
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective D x
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (hC.square_mem_of_c4_square hno hZ e y)
  let : IsKleinFour (R ⧸ D) := ⟨hQcard,
    (Monoid.exponent_eq_prime_iff Nat.prime_two).mpr
      (fun x hx => orderOf_eq_prime (hs x) hx)⟩
  let J := C ⊔ zpowers r ⊔ zpowers (a r)
  have hCJ : C ≤ J := le_sup_left.trans le_sup_left
  have huJ : (u : P) ∈ J :=
    (le_sup_left : C ⊔ zpowers r ≤ J) ((le_sup_right : zpowers r ≤ C ⊔ zpowers r) (mem_zpowers r))
  have hvJ : (v : P) ∈ J := (le_sup_right : zpowers (a r) ≤ J) (mem_zpowers (a r))
  apply le_antisymm
  · exact sup_le (sup_le hCR (zpowers_le.mpr hr)) (zpowers_le.mpr (hRi r hr))
  · intro x hx
    let y : R := ⟨x, hx⟩
    have lift (z : R) (hz : (z : P) ∈ J) (he : q y = q z) : x ∈ J := by
      have hd : q (y * z⁻¹) = 1 := by rw [map_mul, map_inv, he, mul_inv_cancel]
      have hm : x * (z : P)⁻¹ ∈ C := (QuotientGroup.eq_one_iff (N := D) (y * z⁻¹)).mp hd
      simpa only [inv_mul_cancel_right] using J.mul_mem (hCJ hm) hz
    by_cases hy : q y = 1
    · exact hCJ ((QuotientGroup.eq_one_iff y).mp hy)
    by_cases hyu : q y = q u
    · exact lift u huJ hyu
    by_cases hyv : q y = q v
    · exact lift v hvJ hyv
    apply lift (u * v) (J.mul_mem huJ hvJ)
    rw [map_mul]
    exact IsKleinFour.eq_mul_of_ne_all hu hv huv hy hyu hyv


/-- Orbit counting supplies a nonidentity cubic-fixed element when the
order-sixty-four core has index two. -/
public theorem exists_fixed_outside_cubic_core
    (hC : IsCriticalPSubgroup 2 C) [IsMulCommutative C]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (e : C ≃* C4SquareExtension.Model)
    (a : MulAut P) (ha : orderOf a = 3)
    (hfree : ∀ c ∈ C, a c = c → c = 1)
    (hcard : Nat.card R = 64) (hi : R.index = 2)
    (hRf : ∀ r ∈ R, a r * r⁻¹ ∈ C → r ∈ C) :
    ∃ t : P, orderOf t = 2 ∧ t ∉ R ∧ a t = t ∧
      ∀ c ∈ C, t * c * t⁻¹ = c⁻¹ := by
  have hPcard : Nat.card P = 128 := by
    have hh := R.card_mul_index
    rw [hcard, hi] at hh
    exact hh.symm
  have hex : ∃ t : P, a t = t ∧ t ≠ 1 := by
    by_contra! hn
    let _ : Fact (Nat.Prime 3) := ⟨by decide⟩
    let A := zpowers a
    have hp : IsPGroup 3 A := IsPGroup.of_card (n := 1) (by
      simpa only [A, Nat.card_zpowers, pow_one] using ha)
    let F := FixedPoints.subgroup A P
    have hbot : F = ⊥ := by
      apply bot_unique
      intro x hx
      exact hn x (((FixedPoints.mem_subgroup (M := A) (α := P) (a := x)).mp hx)
        ⟨a, mem_zpowers a⟩)
    have hm := hp.card_modEq_card_fixedPoints P
    change Nat.card P % 3 = Nat.card F % 3 at hm
    rw [hPcard, hbot, Subgroup.card_bot] at hm
    norm_num at hm
  obtain ⟨t, hfix, hne⟩ := hex
  have ht2 : t ^ 2 = 1 := by
    let : IsElementaryAbelian 2 a.fixedSubgroup :=
      hC.fixedSubgroup_elementary_of_c4_square hno hZ e a hfree
    exact elemPow_eq_one_of_isElementaryAbelian t ((MulAut.mem_fixedSubgroup a t).mpr hfix)
  refine ⟨t, orderOf_eq_prime ht2 hne, ?_, hfix,
    hC.fixed_element_inverts_c4_square hno hZ e a ha hfree t hfix hne⟩
  intro htR
  have htC := hRf t htR (by rw [hfix, mul_inv_cancel]; exact C.one_mem)
  exact hne (hfree t htC hfix)

/-- Assembly of the inverting extension from its invariant core. The outside
involution and all mixed commutator conditions follow from the local hypotheses. -/
public theorem cubicInvertingExtension_of_core
    (hC : IsCriticalPSubgroup 2 C) [IsMulCommutative C]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (e : C ≃* C4SquareExtension.Model)
    (a : MulAut P) (ha : orderOf a = 3)
    (hfree : ∀ c ∈ C, a c = c → c = 1)
    (hCR : C ≤ R) (hcard : Nat.card R = 64) (hi : R.index = 2)
    (hRi : ∀ r ∈ R, a r ∈ R)
    (hRf : ∀ r ∈ R, a r * r⁻¹ ∈ C → r ∈ C)
    (hfixed : ∀ r ∈ R, r ∉ C → ∀ c ∈ C, Commute c r → c ^ 2 = 1) :
    ∃ t : P, C4SquareCubicInvertingExtension C R a t := by
  obtain ⟨t, ht, htR, hfix, hinv⟩ :=
    hC.exists_fixed_outside_cubic_core hno hZ e a ha hfree hcard hi hRf
  refine ⟨t, ⟨hCR, hcard, hi, hRi, hRf, ht, htR, hfix, hinv, hfixed, ?_⟩⟩
  exact hC.mixed_commutator_of_cubic_orbit hno hZ e a t
    (ht ▸ pow_orderOf_eq_one t) hfix hinv hCR hi htR
    (hC.cubic_orbit_generates_core hno hZ e a hCR hcard hRi hRf)


open scoped commutatorElement in
/-- If the whole quotient by the base is cubic-fixed-free and nontrivial
conjugation fixes only square-one base elements, then every involution is central.
An outside involution would have an elementary cubic orbit of order sixteen;
the central square subgroup makes that orbit normal. -/
public theorem involutions_central_of_cubic_core
    (hC : IsCriticalPSubgroup 2 C) [IsMulCommutative C]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (e : C ≃* C4SquareExtension.Model)
    (a : MulAut P) (ha : orderOf a = 3)
    (hfree : ∀ c ∈ C, a c = c → c = 1)
    (hQfree : ∀ x : P, a x * x⁻¹ ∈ C → x ∈ C)
    (hfixed : ∀ x : P, x ∉ C → ∀ c ∈ C, Commute c x → c ^ 2 = 1) :
    ∀ t : P, orderOf t = 2 → t ∈ center P := by
  let W := (omega₁ (center P) (p := 2)).map (center P).subtype
  have hW : W ≤ center P := map_subtype_le _
  let : W.Normal := ⟨fun w hw g => by
    rw [mem_center_iff.mp (hW hw) g, mul_inv_cancel_right]
    exact hw⟩
  let : IsElementaryAbelian 2 (omega₁ (center P) (p := 2)) :=
    IsElementaryAbelian.omega₁_of_isMulCommutative _
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.map_subtype
  have hWC : W ≤ C := by
    dsimp [W]
    rw [← hC.omega_one_map_eq_center hno hZ]
    exact map_subtype_le _
  have hWcard : Nat.card W = 4 := by
    dsimp [W]
    rw [card_map_of_injective (center P).subtype_injective, hZ]
  have hs (x : P) : x ^ 2 ∈ W := by
    apply hC.mem_omega_center_of_square_eq_one hno hZ
      (hC.square_mem_of_c4_square hno hZ e x)
    by_cases hx : x ∈ C
    · have hh : (⟨x, hx⟩ : C) ^ 4 = 1 := e.injective (by
        rw [map_pow, map_one]
        exact (by decide : ∀ z : C4SquareExtension.Model, z ^ 4 = 1) _)
      have hh' : x ^ 4 = 1 := congrArg Subtype.val hh
      simpa only [← pow_mul] using hh'
    · exact hfixed x hx (x ^ 2) (hC.square_mem_of_c4_square hno hZ e x)
        ((Commute.refl x).pow_left 2)
  have hQs (x : P ⧸ W) : x ^ 2 = 1 := by
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective W x
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (hs y)
  have hQcomm (x y : P ⧸ W) : x * y = y * x := by
    have hi (z : P ⧸ W) : z⁻¹ = z :=
      inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hQs z)
    calc
      x * y = (x * y)⁻¹ := (hi _).symm
      _ = y * x := by rw [mul_inv_rev, hi, hi]
  have hcomm (x y : P) : ⁅x, y⁆ ∈ W := by
    apply (QuotientGroup.eq_one_iff _).mp
    change (QuotientGroup.mk' W) ⁅x, y⁆ = 1
    rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
    exact hQcomm _ _
  have hafree (x : P) (hx : a x = x) : x = 1 := by
    apply hfree x (hQfree x ?_) hx
    rw [hx, mul_inv_cancel]
    exact C.one_mem
  have hWa : W.map a.toMonoidHom = W := by
    apply eq_of_le_of_card_ge
    · rintro _ ⟨w, hw, rfl⟩
      have hwC := hWC hw
      have hw2 : w ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian w hw
      let : C.Characteristic := hC.characteristic
      apply hC.mem_omega_center_of_square_eq_one hno hZ
        ((characteristic_iff_map_le.mp hC.characteristic a) (mem_map_of_mem a.toMonoidHom hwC))
      rw [← map_pow, hw2, map_one]
    · exact (card_map_of_injective a.injective).symm.le
  intro t ht
  by_cases htC : t ∈ C
  · exact hC.involution_mem_ambient_center hno hZ htC ht
  exfalso
  have ht2 : t ^ 2 = 1 := ht ▸ pow_orderOf_eq_one t
  let U := W ⊔ zpowers t
  let : IsElementaryAbelian 2 (zpowers t) := IsElementaryAbelian.zpowers_of_pow_eq_one ht2
  have htW : t ∈ centralizer (W : Set P) := by
    intro w hw
    exact (mem_center_iff.mp (hW hw) t).symm
  let : IsElementaryAbelian 2 U :=
    IsElementaryAbelian.sup_of_le_centralizer (zpowers_le.mpr htW)
  have hUcard : Nat.card U = 8 := by
    rw [card_sup_zpowers_of_normalizing_involution W t ht2
      (fun hh => htC (hWC hh)) (centralizer_le_normalizer _ htW), hWcard]
  obtain ⟨hE, hEcard, _⟩ := a.elementary_sixteen_of_cubic_orbit_eight W U
    le_sup_left hW hWcard hUcard inferInstance (ha ▸ pow_orderOf_eq_one a) hafree hWa
    (Subgroup.commutator_le.mpr (fun x _ y _ => hcomm x y))
  let E := U ⊔ U.map a.toMonoidHom
  have hWE : W ≤ E := le_sup_left.trans le_sup_left
  have hEnormal : E.Normal := Subgroup.commutator_top_left_le_iff.mp
    (Subgroup.commutator_le.mpr (fun x _ y _ => hWE (hcomm x y)))
  exact hno ⟨E, hEnormal, hE, by change Nat.card E = 16 at hEcard; omega⟩


/-- The full extension conclusion follows once the congruence action supplies
an invariant core of order sixty-four and index at most two. The index-one
case is excluded by the given noncentral involution. -/
public theorem exists_cubicInvertingExtension_of_core_reduction
    (hC : IsCriticalPSubgroup 2 C) [IsMulCommutative C]
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (e : C ≃* C4SquareExtension.Model)
    (a : MulAut P) (ha : orderOf a = 3)
    (hfree : ∀ c ∈ C, a c = c → c = 1)
    (hnc : ¬ ∀ x : P, orderOf x = 2 → x ∈ center P)
    (hcore : ∃ R : Subgroup P, C ≤ R ∧ Nat.card R = 64 ∧
      (R.index = 1 ∨ R.index = 2) ∧
      (∀ r ∈ R, a r ∈ R) ∧
      (∀ r ∈ R, a r * r⁻¹ ∈ C → r ∈ C) ∧
      (∀ r ∈ R, r ∉ C → ∀ c ∈ C, Commute c r → c ^ 2 = 1)) :
    ∃ (R : Subgroup P) (t : P), C4SquareCubicInvertingExtension C R a t := by
  obtain ⟨R, hCR, hcard, hi, hRi, hRf, hfixed⟩ := hcore
  rcases hi with hi | hi
  · have hR : R = ⊤ := Subgroup.index_eq_one.mp hi
    exact (hnc (hC.involutions_central_of_cubic_core hno hZ e a ha hfree
      (fun x => hRf x (hR ▸ mem_top x))
      (fun x => hfixed x (hR ▸ mem_top x)))).elim
  · obtain ⟨t, ht⟩ := hC.cubicInvertingExtension_of_core hno hZ e a ha hfree
      hCR hcard hi hRi hRf hfixed
    exact ⟨R, t, ht⟩

/-- An abelian critical C₄-square with a free cubic action and a noncentral
ambient involution lies in a cubic inverting extension. The congruence moved
plane supplies the core; the noncentral involution excludes index one. -/
public theorem exists_cubicInvertingExtension_of_c4_square
    (hC : IsCriticalPSubgroup 2 C) [IsMulCommutative C]
    (_hP : IsPGroup 2 P) (hnonab : ¬ IsMulCommutative P)
    (hno : ¬ ∃ E : Subgroup P, E.Normal ∧ IsElementaryAbelian 2 E ∧ 8 ≤ Nat.card E)
    (hZ : Nat.card (omega₁ (center P) (p := 2)) = 4)
    (e : C ≃* C4SquareExtension.Model)
    (a : MulAut P) (ha : orderOf a = 3)
    (hfree : ∀ c ∈ C, a c = c → c = 1)
    (hnc : ¬ ∀ x : P, orderOf x = 2 → x ∈ center P) :
    ∃ (R : Subgroup P) (t : P), C4SquareCubicInvertingExtension C R a t := by
  exact hC.exists_cubicInvertingExtension_of_core_reduction hno hZ e a ha hfree hnc
    (hC.exists_cubic_core_of_c4_square hnonab hno hZ e a ha hfree)

end IsCriticalPSubgroup
