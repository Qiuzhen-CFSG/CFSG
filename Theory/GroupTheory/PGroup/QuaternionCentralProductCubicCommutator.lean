/-!
# Cubic commutators of quaternion central products

A cubic action on a finite two-group with central quotient of order four,
fixing the center pointwise and moving a central coset, has quaternion-eight
action commutator. In particular this applies to a group generated by a
quaternion-eight subgroup and its center.

The proof constructs the quaternion generators directly. For a moved element
`x` and cubic actor `f`, put `c = x⁻¹ * f x` and `d = f c`. The orbit product
`c * d * f d` is one. Their central cosets are distinct and nonidentity, so
`c,d` supplement the center and do not commute. All squares are central and
fixed. The class-two square identity gives `(c²)³ = ⁅c,d⁆`; commutators have
square one, and the two-group hypothesis gives `c⁴ = 1`. Thus the pair
satisfies the quaternion relations. Its generated subgroup is invariant under
the cubic actor. Since the center is fixed, every action difference belongs
to it, proving equality with the action commutator.

This intrinsic argument needs no normality in a larger two-group and no
classification of groups of order eight. The central-quotient cardinal proof
is adapted from the private calculation in `CriticalQuaternionCubicAction`.
Source motivation: MacWilliams, Trans. AMS 150 (1970), §3(ii)–(iv),
pp.366–367, DOI 10.1090/S0002-9947-1970-0276324-3.
-/

open Subgroup
open scoped commutatorElement IsMulCommutative

private theorem card_central_quotient {G : Type*} [Group G] [Finite G]
    (R : Subgroup G) (eR : R ≃* QuaternionGroup 2)
    (hgen : R ⊔ center G = ⊤) : Nat.card (G ⧸ center G) = 4 := by
  let f : R →* G ⧸ center G := (QuotientGroup.mk' (center G)).comp R.subtype
  have hsurj : Function.Surjective f := by
    intro q
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (center G) q
    obtain ⟨r, hr, z, hz, rfl⟩ := mem_sup_of_normal_right.mp (hgen ▸ mem_top g)
    refine ⟨⟨r, hr⟩, ?_⟩
    change QuotientGroup.mk' (center G) r = QuotientGroup.mk' (center G) (r * z)
    have hzq : QuotientGroup.mk' (center G) z = 1 :=
      (QuotientGroup.eq_one_iff (N := center G) z).mpr hz
    rw [map_mul, hzq, mul_one]
  have hker : f.ker = center R := by
    ext r
    change QuotientGroup.mk' (center G) (r : G) = 1 ↔ r ∈ center R
    simp only [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    constructor
    · intro hr
      exact mem_center_iff.mpr fun s => Subtype.ext (mem_center_iff.mp hr s)
    · intro hr
      apply mem_center_iff.mpr
      intro g
      obtain ⟨s, hs, z, hz, rfl⟩ := mem_sup_of_normal_right.mp (hgen ▸ mem_top g)
      have hscomm := congrArg Subtype.val (mem_center_iff.mp hr (⟨s, hs⟩ : R))
      change s * (r : G) = (r : G) * s at hscomm
      have hzcomm := (mem_center_iff.mp hz (r : G)).symm
      calc
        (s * z) * r = s * ((r : G) * z) := by rw [mul_assoc, hzcomm]
        _ = (r : G) * (s * z) := by rw [← mul_assoc, hscomm, mul_assoc]
  have hcardR : Nat.card R = 8 := by
    rw [Nat.card_congr eR.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
  have hcenter : Nat.card (center R) = 2 := by
    rw [Nat.card_congr (centerCongr eR).toEquiv]
    let predicate : QuaternionGroup 2 → Prop := fun x => ∀ y, y * x = x * y
    have hc : Fintype.card {x // predicate x} = 2 := by decide
    rw [Nat.card_congr (Equiv.subtypeEquivRight (fun _ => mem_center_iff)), Nat.card_eq_fintype_card]
    exact hc
  have hcard := f.ker.card_eq_card_quotient_mul_card_subgroup
  rw [Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hsurj).toEquiv,
    hker, hcenter, hcardR] at hcard
  omega


private theorem elementary_of_card_center_quotient_four {G : Type*} [Group G] [Finite G]
    (hc : Nat.card (G ⧸ center G) = 4) : IsElementaryAbelian 2 (G ⧸ center G) := by
  have hd (x : G ⧸ center G) : orderOf x ∣ 2 := by
    have hd := orderOf_dvd_natCard x
    rw [hc] at hd
    have hn : orderOf x ≠ 4 := by
      intro he
      let : IsCyclic (G ⧸ center G) := isCyclic_of_orderOf_eq_card x (he.trans hc.symm)
      have hh := isMulCommutative_of_isCyclic_quotient_center_self G
      have hz : center G = ⊤ := center_eq_top_iff.mpr hh
      simp [hz] at hc
    have hp := Nat.le_of_dvd (by decide : 0 < 4) hd
    interval_cases orderOf x <;> norm_num at *
  exact {
    toIsMulCommutative := ⟨⟨fun x y => (Commute.of_orderOf_dvd_two hd x y).eq⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
      (fun x => orderOf_dvd_iff_pow_eq_one.mp (hd x)) }

private theorem four_cases {W : Type*} [Group W] [Finite W] [IsKleinFour W]
    {x y : W} (hx : x ≠ 1) (hy : y ≠ 1) (hxy : x ≠ y) (w : W) :
    w = x*y ∨ w = x ∨ w = y ∨ w = 1 := by
  classical
  let _ := Fintype.ofFinite W
  have hm : w ∈ ({x*y,x,y,1} : Finset W) :=
    (IsKleinFour.eq_finset_univ hx hy hxy).symm ▸ Finset.mem_univ w
  simpa only [Finset.mem_insert, Finset.mem_singleton] using hm

private theorem pair_sup_center {G : Type*} [Group G] [Finite G]
    [IsKleinFour (G ⧸ center G)]
    (c d : G) (hc : QuotientGroup.mk' (center G) c ≠ 1)
    (hd : QuotientGroup.mk' (center G) d ≠ 1)
    (hne : QuotientGroup.mk' (center G) c ≠ QuotientGroup.mk' (center G) d) :
    closure ({c,d} : Set G) ⊔ center G = ⊤ := by
  let π := QuotientGroup.mk' (center G)
  let U := closure ({c,d} : Set G) ⊔ center G
  have hcU : c ∈ U := mem_sup_left (subset_closure (by simp))
  have hdU : d ∈ U := mem_sup_left (subset_closure (by simp))
  have transfer (g a : G) (ha : a ∈ U) (h : π g = π a) : g ∈ U := by
    have hm := U.mul_mem ha (mem_sup_right (QuotientGroup.eq.mp h.symm))
    simpa only [mul_inv_cancel_left] using hm
  apply top_unique
  intro g _
  rcases four_cases hc hd hne (π g) with h | h | h | h
  · exact transfer g (c*d) (U.mul_mem hcU hdU) (by simpa only [map_mul] using h)
  · exact transfer g c hcU h
  · exact transfer g d hdU h
  · exact transfer g 1 U.one_mem (by simpa only [map_one] using h)

private theorem noncommuting_of_pair_sup_center {G : Type*} [Group G]
    (c d : G) (hc : c ∉ center G)
    (hgen : closure ({c,d} : Set G) ⊔ center G = ⊤) : ¬ Commute c d := by
  intro hcd
  have hle : closure ({c,d} : Set G) ≤ centralizer ({c} : Set G) := by
    apply (closure_le _).mpr
    intro x hx
    rcases hx with rfl | hx
    · exact mem_centralizer_singleton_iff.mpr (Commute.refl _)
    · have he : x = d := hx
      subst x
      exact mem_centralizer_singleton_iff.mpr hcd.symm
  apply hc
  apply mem_center_iff.mpr
  intro g
  obtain ⟨u, hu, z, hz, rfl⟩ := mem_sup_of_normal_right.mp (hgen ▸ mem_top g)
  have hu' := mem_centralizer_singleton_iff.mp (hle hu)
  have hz' := (mem_center_iff.mp hz c).symm
  exact ((show Commute u c from hu').mul_left (show Commute z c from hz')).eq

private theorem square_mul {P : Type*} [Group P]
    (hquot : IsElementaryAbelian 2 (P ⧸ center P)) (x y : P) :
    (x * y) ^ 2 = x ^ 2 * y ^ 2 * ⁅x,y⁆ := by
  have hc : ⁅x,y⁆ ∈ center P := hquot.commutator_le_center_of_central_quotient
    (commutator_mem_commutator (mem_top x) (mem_top y))
  symm
  calc
    x ^ 2 * y ^ 2 * ⁅x,y⁆ = ⁅x,y⁆ * (x ^ 2 * y ^ 2) := mem_center_iff.mp hc _
    _ = x * y * x⁻¹ * (y⁻¹ * x ^ 2) * y ^ 2 := by
      simp only [commutatorElement_def, mul_assoc]
    _ = x * y * x⁻¹ * (x ^ 2 * y⁻¹) * y ^ 2 := by
      rw [mem_center_iff.mp (hquot.sq_mem_center_of_central_quotient x)]
    _ = (x * y) ^ 2 := by simp only [pow_two]; group


private theorem cubic_difference_relations {G : Type*} [Group G] [Finite G]
    (hG : IsPGroup 2 G) (hq : IsElementaryAbelian 2 (G ⧸ center G))
    [IsKleinFour (G ⧸ center G)]
    (f : MulAut G) (hf : f ^ 3 = 1)
    (hfix : ∀ z : center G, f z = z)
    (x : G) (hx : x⁻¹ * f x ∉ center G) :
    let c := x⁻¹ * f x
    let d := f c
    orderOf c = 4 ∧ d ^ 2 = c ^ 2 ∧ d * c * d⁻¹ = c⁻¹ ∧
      closure ({c,d} : Set G) ⊔ center G = ⊤ := by
  let c := x⁻¹ * f x
  let d := f c
  change orderOf c = 4 ∧ d ^ 2 = c ^ 2 ∧ d*c*d⁻¹=c⁻¹ ∧ _
  have hf3 (t : G) : f (f (f t)) = t := by
    have h := DFunLike.congr_fun hf t
    simpa [pow_succ, MulAut.mul_apply] using h
  have htel : c * d * f d = 1 := by
    dsimp [c, d]
    simp only [map_mul, map_inv, hf3]
    group
  have hs (t : G) : (f t)^2 = t^2 := by
    rw [← map_pow]
    exact hfix ⟨t^2, hq.sq_mem_center_of_central_quotient t⟩
  let π := QuotientGroup.mk' (center G)
  let b := quotientAut (center G) f
  have hb (t : G) : b (π t) = π (f t) := quotientAut_apply_mk _ _ _
  have hc1 : π c ≠ 1 := fun h => hx ((QuotientGroup.eq_one_iff _).mp h)
  have hd1 : π d ≠ 1 := by
    change π (f c) ≠ 1
    rw [← hb, map_ne_one_iff _ b.injective]
    exact hc1
  have hne : π c ≠ π d := by
    intro he
    have he' : π (f d) = π c := by rw [← hb, ← he, hb]; exact he.symm
    have ht := congrArg π htel
    rw [map_mul, map_mul, map_one, ← he, he', IsKleinFour.mul_self, one_mul] at ht
    exact hc1 ht
  have hgen := pair_sup_center c d hc1 hd1 hne
  have hnc : ¬ Commute c d := noncommuting_of_pair_sup_center c d hx hgen
  let k := ⁅c,d⁆
  have hk2 : k^2=1 := hq.commutatorElement_sq_eq_one_of_central_quotient c d
  have hprod : c*d=(f d)⁻¹ := eq_inv_of_mul_eq_one_left htel
  have hsq : (c*d)^2 = (c^2)⁻¹ := by rw [hprod, inv_pow, hs, hs]
  have hs3 : (c^2)^3 = k := by
    have he : c^2*c^2*k = (c^2)⁻¹ := by
      simpa only [square_mul hq, hs, d] using hsq
    have hi : k⁻¹=k := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hk2)
    calc
      (c^2)^3 = (c^2) * (c^2*c^2*k) * k⁻¹ := by group
      _ = k := by rw [he, mul_inv_cancel, one_mul, hi]
  have hc12 : c^12=1 := by
    have he := congrArg (fun t : G => t^2) hs3
    simpa only [← pow_mul, hk2] using he
  have hc4 : c^4=1 := by
    apply orderOf_dvd_iff_pow_eq_one.mp
    exact (hG.orderOf_coprime (by decide : Nat.Coprime 2 3) c).dvd_of_dvd_mul_left
      (show orderOf c ∣ 3*4 from orderOf_dvd_of_pow_eq_one hc12)
  have hc2k : c^2=k := by
    calc
      c^2 = (c^2)^3 := by rw [show (c^2)^3 = c^4*c^2 by group, hc4, one_mul]
      _ = k := hs3
  have hc2ne : c^2≠1 := fun h => hnc
    (commutatorElement_eq_one_iff_commute.mp (hc2k.symm.trans h))
  have horder : orderOf c=4 := by
    apply orderOf_eq_prime_pow (p:=2) (n:=1)
    · simpa using hc2ne
    · simpa using hc4
  have he : (c*d)*(c*d)=d*d := by
    rw [← pow_two, ← pow_two, hsq, hs]
    exact inv_eq_of_mul_eq_one_right (by rw [← pow_two, ← pow_mul]; exact hc4)
  have he' : c*d*c=d := mul_right_cancel (by simpa only [mul_assoc] using he)
  refine ⟨horder, hs c, ?_, hgen⟩
  calc
    d*c*d⁻¹ = c⁻¹*(c*d*c)*d⁻¹ := by group
    _ = c⁻¹ := by rw [he']; group

namespace IsPGroup

/-- A nontrivial cubic action on a central quotient of order four, fixing the
center pointwise, has quaternion-eight action commutator. -/
public theorem nonempty_commutatorAction_equiv_quaternion_of_center_quotient_four
    {H : Type*} [Group H] [Finite H] (hH : IsPGroup 2 H)
    (hfour : Nat.card (H ⧸ center H) = 4)
    {A : Type*} [Group A] [Finite A] [MulDistribMulAction A H]
    (hA : Nat.card A = 3)
    (hfix : ∀ a : A, ∀ z : center H, a • (z : H) = (z : H))
    (hmove : ∃ a : A, ∃ x : H, (a • x) * x⁻¹ ∉ center H) :
    Nonempty (commutatorAction A H ≃* QuaternionGroup 2) := by
  classical
  let hquot := elementary_of_card_center_quotient_four hfour
  let : IsElementaryAbelian 2 (H ⧸ center H) := hquot
  let : Nontrivial (H ⧸ center H) := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  let : IsKleinFour (H ⧸ center H) := ⟨hfour, IsElementaryAbelian.exponent_eq_prime⟩
  obtain ⟨a, x, hx⟩ := hmove
  have ha : a ≠ 1 := by rintro rfl; simp at hx
  let f := MulDistribMulAction.toMulAut A H a
  have hf3 : f ^ 3 = 1 := by
    change (MulDistribMulAction.toMulAut A H a)^3=1
    rw [← map_pow, ← hA, pow_card_eq_one', map_one]
  have hx' : x⁻¹ * f x ∉ center H := by
    intro hh
    have he := (inferInstance : (center H).Normal).conj_mem _ hh x
    apply hx
    change f x * x⁻¹ ∈ center H
    simpa only [mul_inv_cancel_left] using he
  let c := x⁻¹ * f x
  let d := f c
  obtain ⟨hc, hsq, hinv, hUgen⟩ := cubic_difference_relations hH hquot f hf3 (hfix a) x hx'
  change orderOf c=4 at hc
  change d^2=c^2 at hsq
  change d*c*d⁻¹=c⁻¹ at hinv
  change closure ({c,d} : Set H) ⊔ center H=⊤ at hUgen
  let U := closure ({c,d} : Set H)
  have hnc : ¬ Commute c d := noncommuting_of_pair_sup_center c d hx' hUgen
  have hout : d ∉ zpowers c := by
    rintro ⟨i, hi⟩
    exact hnc (hi ▸ Commute.self_zpow c i)
  obtain ⟨_, ⟨eU⟩⟩ := QuaternionGroup.closure_equiv_of_relations
    (by decide : 0 < 2) c d hc hsq hinv hout
  have hcU : c ∈ U := subset_closure (by simp)
  have hdU : d ∈ U := subset_closure (by simp)
  have hfU : ∀ u ∈ U, f u ∈ U := by
    have hfd : f d = (c*d)⁻¹ := by
      have hf3x : f (f (f x))=x := by
        have he := DFunLike.congr_fun hf3 x
        simpa [pow_succ, MulAut.mul_apply] using he
      apply eq_inv_of_mul_eq_one_right
      dsimp [c,d]
      simp only [map_mul, map_inv, hf3x]
      group
    intro u hu
    induction hu using closure_induction with
    | mem u hu =>
      rcases hu with rfl | hu
      · exact hdU
      · have he : u=d := hu
        rw [he, hfd]
        exact U.inv_mem (U.mul_mem hcU hdU)
    | one => simpa only [map_one] using U.one_mem
    | mul u v _ _ hu hv => simpa only [map_mul] using U.mul_mem hu hv
    | inv u _ hu => simpa only [map_inv] using U.inv_mem hu
  have hAU : ∀ b : A, ∀ u ∈ U, b • u ∈ U := by
    intro b u hu
    let : Fact (Nat.Prime 3) := ⟨by decide⟩
    obtain ⟨n, rfl⟩ := mem_powers_of_prime_card hA ha (g' := b)
    induction n with
    | zero => simpa using hu
    | succ n ih =>
      change a ^ (n+1) • u ∈ U
      rw [pow_succ', mul_smul]
      exact hfU _ ih
  have hCU : commutatorAction A H ≤ U := by
    rw [commutatorAction_eq_closure]
    apply (closure_le _).mpr
    rintro y ⟨b, g, rfl⟩
    obtain ⟨u, hu, z, hz, rfl⟩ := mem_sup_of_normal_right.mp (hUgen ▸ mem_top g)
    have hzfix := hfix b ⟨z,hz⟩
    have he : (u*z)⁻¹ * (b • (u*z)) = u⁻¹ * (b • u) := by
      rw [smul_mul', hzfix, mul_inv_rev]
      have hcomm := mem_center_iff.mp hz (u⁻¹ * (b • u))
      calc
        z⁻¹ * u⁻¹ * ((b • u) * z) = z⁻¹ * ((u⁻¹ * (b • u))*z) := by group
        _ = u⁻¹ * (b • u) := by rw [hcomm, inv_mul_cancel_left]
    rw [he]
    exact U.mul_mem (U.inv_mem hu) (hAU b u hu)
  have hUC : U ≤ commutatorAction A H := by
    apply (closure_le _).mpr
    intro u hu
    have hcC : c ∈ commutatorAction A H := by
      rw [commutatorAction_eq_closure]
      exact subset_closure ⟨a,x,rfl⟩
    have hdC : d ∈ commutatorAction A H :=
      ((commutatorAction_isInvariant (G:=H) (A:=A)).invariant a c).mp hcC
    rcases hu with rfl | hu
    · exact hcC
    · exact (show u=d from hu) ▸ hdC
  exact ⟨(MulEquiv.subgroupCongr (le_antisymm hCU hUC)).trans eU⟩

/-- The intrinsic cubic action commutator of a quaternion central product is
quaternion of order eight when the action fixes the center and moves a coset. -/
public theorem nonempty_commutatorAction_equiv_quaternion_of_quaternion_supplement
    {H : Type*} [Group H] [Finite H] (hH : IsPGroup 2 H)
    (R : Subgroup H) (eR : R ≃* QuaternionGroup 2)
    (hgen : R ⊔ center H = ⊤)
    {A : Type*} [Group A] [Finite A] [MulDistribMulAction A H]
    (hA : Nat.card A = 3)
    (hfix : ∀ a : A, ∀ z : center H, a • (z : H) = (z : H))
    (hmove : ∃ a : A, ∃ x : H, (a • x) * x⁻¹ ∉ center H) :
    Nonempty (commutatorAction A H ≃* QuaternionGroup 2) :=
  hH.nonempty_commutatorAction_equiv_quaternion_of_center_quotient_four
    (card_central_quotient R eR hgen) hA hfix hmove

end IsPGroup
