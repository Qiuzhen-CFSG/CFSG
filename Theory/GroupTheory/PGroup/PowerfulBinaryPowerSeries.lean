module

public import Theory.GroupTheory.PGroup.BinaryPowerSeries
public import Theory.GroupTheory.Commutator.NilpotentSaturation

/-!
# Commutator estimates for powerful two-groups

Write `H²` for the subgroup generated by the squares of elements of `H`.
In a nilpotent group, the bound `[H,G] ≤ (H²)²` propagates to
`[H²,G] ≤ ((H²)²)²`. Consequently, if the derived subgroup of a finite
two-group is contained in the subgroup generated by fourth powers, its
iterated square subgroups satisfy `[Sₙ,G] ≤ Sₙ₊₂`.

The propagation uses the identity `[x²,y] = [x,[x,y]] [x,y]²` twice.
For `C = [H²,G]` and `N = ((H²)²)²`, it gives `C ≤ N ⊔ [C,G]`:
the first application leaves `[ (H²)²,H ]`, and the second bounds this
by `C² ⊔ [C,G]`. Since `C ≤ (H²)²`, its squares already lie in `N`.
Nilpotent commutator saturation removes the remaining `[C,G]` term.
No assertion that products of squares are single squares is used.

This proves the powerful-group estimate needed by the root-lifting argument
in `BinaryPowerSeries`. Source motivation: Traustason–Williams, *Powerfully
nilpotent groups of rank 2 or small order*, Section 2, arXiv:2002.02694.
-/

open scoped commutatorElement

namespace Subgroup
variable {G : Type*} [Group G]

/-- Taking the subgroup generated by squares preserves containment. -/
public theorem squareClosure_mono {H K : Subgroup G} (h : H ≤ K) :
    H.squareClosure ≤ K.squareClosure := by
  apply (closure_le _).mpr
  rintro _ ⟨x, rfl⟩
  exact square_mem_squareClosure (h x.property)

/-- To bound commutators of squares modulo a normal subgroup, it suffices to
bound squares of commutators and the corresponding triple commutators. -/
public theorem commutator_squareClosure_le (H K N : Subgroup G) [N.Normal]
    (hsq : ⁅H, K⁆.squareClosure ≤ N) (hc : ⁅⁅H, K⁆, H⁆ ≤ N) :
    ⁅H.squareClosure, K⁆ ≤ N := by
  apply commutator_le.mpr
  intro x hx y hy
  induction hx using closure_induction with
  | mem x hx =>
      obtain ⟨x, rfl⟩ := hx
      have hxy := commutator_mem_commutator x.property hy
      have hcx : ⁅(x : G), ⁅(x : G), y⁆⁆ ∈ N := by
        rw [← commutatorElement_inv]
        exact N.inv_mem (hc (commutator_mem_commutator hxy x.property))
      have hid : ⁅(x : G) ^ 2, y⁆ =
          ⁅(x : G), ⁅(x : G), y⁆⁆ * ⁅(x : G), y⁆ ^ 2 := by
        simp [commutatorElement_def, pow_two, mul_assoc]
      rw [hid]
      exact N.mul_mem hcx (hsq (square_mem_squareClosure hxy))
  | one => simp
  | mul a b ha hb iha ihb =>
      rw [commutatorElement_mul_left_eq_conj_mul]
      exact N.mul_mem ((inferInstance : N.Normal).conj_mem _ ihb a) iha
  | inv a ha iha =>
      rw [commutatorElement_inv_left]
      have hya : ⁅y, a⁆ ∈ N := by
        rw [← commutatorElement_inv]
        exact N.inv_mem iha
      simpa only [inv_inv] using (inferInstance : N.Normal).conj_mem _ hya a⁻¹

/-- The powerful commutator bound propagates through squaring a normal subgroup
of a nilpotent group. The powers here are iterated square subgroups. -/
public theorem commutator_squareClosure_le_of_isNilpotent [Group.IsNilpotent G]
    (H : Subgroup G) [H.Normal]
    (hH : ⁅H, (⊤ : Subgroup G)⁆ ≤ H.squareClosure.squareClosure) :
    ⁅H.squareClosure, (⊤ : Subgroup G)⁆ ≤ H.squareClosure.squareClosure.squareClosure := by
  let C := ⁅H.squareClosure, (⊤ : Subgroup G)⁆
  let N := H.squareClosure.squareClosure.squareClosure
  have hC : C ≤ H.squareClosure.squareClosure :=
    (commutator_mono (squareClosure_le H) le_rfl).trans hH
  have hCsq : C.squareClosure ≤ N := squareClosure_mono hC
  have hinner : ⁅H.squareClosure.squareClosure, H⁆ ≤ N ⊔ ⁅C, ⊤⁆ := by
    apply commutator_squareClosure_le
    · exact (squareClosure_mono (commutator_mono le_rfl le_top)).trans
        (hCsq.trans le_sup_left)
    · exact (commutator_mono (commutator_mono le_rfl le_top) le_top).trans le_sup_right
  have hcover : C ≤ N ⊔ ⁅C, ⊤⁆ := by
    apply commutator_squareClosure_le
    · exact (squareClosure_mono hH).trans le_sup_left
    · exact (commutator_mono hH le_rfl).trans hinner
  exact le_of_le_sup_commutator_of_isNilpotent ⊤ C N ⊤ inferInstance
    le_top le_top le_rfl (by rw [normalizer_eq_top]) hcover

end Subgroup

/-- In a powerful finite two-group, the commutators of the `n`-th iterated
square subgroup lie two steps further down the square series. -/
public theorem IsPGroup.iteratedSquares_commutator_le_of_commutator_le_fourthPowers
    {G : Type*} [Group G] [Finite G] (hG : IsPGroup 2 G)
    (hpower : _root_.commutator G ≤
      Subgroup.closure (Set.range (fun x : G => x ^ (4 : ℕ)))) :
    ∀ n, ⁅Subgroup.iteratedSquares G n, (⊤ : Subgroup G)⁆ ≤
      Subgroup.iteratedSquares G (n + 2) := by
  let : Group.IsNilpotent G := hG.isNilpotent
  intro n
  induction n with
  | zero => exact hpower.trans Subgroup.closure_fourthPowers_le_iteratedSquares_two
  | succ n ih =>
      exact Subgroup.commutator_squareClosure_le_of_isNilpotent
        (Subgroup.iteratedSquares G n) ih
