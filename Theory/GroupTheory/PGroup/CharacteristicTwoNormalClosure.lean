module

public import Theory.ElementaryAbelian.Basic
public import Theory.PGroupCore
public import Theory.ThreeSubgroups

/-!
# Normal closures generated by involutions in characteristic two

Let `T` be normal in a finite group `G`, and let `Z` be elementary abelian of
order a power of two.  If `[O₂(G),Z] ≤ T` and `[T,Z]=1`, then the normal
closure `W` of `Z` is a 2-group whenever `C_G(O₂(G)) ≤ O₂(G)`.

The proof first passes to `G/T`, where the image of `Z` centralizes the image
of `O₂(G)`; normality extends this to all of `W`.  Together with `[T,W]=1`,
the three-subgroups lemma shows that `W'` centralizes `O₂(G)`, so the
characteristic-two hypothesis puts `W'` inside `O₂(G)`.  Finally `W/W'` is
generated by conjugates of involutions and is therefore a 2-group.  The
extension of the 2-groups `W'` and `W/W'` proves the claim.

This is the abstract group-theoretic step behind the source-corrected
`[O²(W),O₂(N)]=1` argument in the journal proof of Stellmacher (5.4), p. 30.
-/

open scoped Pointwise

/-- In a characteristic-two group, a normal closure generated by involutions
is a 2-group under the two-step commutator hypotheses used in Stellmacher
(5.4). -/
public theorem normalClosure_isPGroup_of_characteristicTwo
    {G : Type*} [Group G] [Finite G]
    (T Z : Subgroup G)
    (hchar : Subgroup.centralizer (pCore 2 G : Set G) ≤ pCore 2 G)
    (hTnormal : T.Normal)
    (hQZ : ⁅pCore 2 G, Z⁆ ≤ T) (hTZ : ⁅T, Z⁆ = ⊥)
    (hZelem : IsElementaryAbelian 2 Z) :
    IsPGroup 2 (Subgroup.normalClosure (Z : Set G)) := by
  classical
  let _ : T.Normal := hTnormal
  let _ : IsElementaryAbelian 2 Z := hZelem
  let Q : Subgroup G := pCore 2 G
  let W : Subgroup G := Subgroup.normalClosure (Z : Set G)
  let qT : G →* G ⧸ T := QuotientGroup.mk' T
  let Qbar : Subgroup (G ⧸ T) := Q.map qT
  have hQbarNormal : Qbar.Normal := by
    exact Subgroup.Normal.map (inferInstance : Q.Normal) qT
      (QuotientGroup.mk'_surjective T)
  let _ : Qbar.Normal := hQbarNormal
  have hmapQZ : ⁅Qbar, Z.map qT⁆ = ⊥ := by
    rw [← Subgroup.map_commutator]
    apply (Subgroup.map_eq_bot_iff (⁅Q, Z⁆)).mpr
    simpa [qT, Q, QuotientGroup.ker_mk'] using hQZ
  have hZmapCentral : Z.map qT ≤
      Subgroup.centralizer (Qbar : Set (G ⧸ T)) := by
    rw [← Subgroup.commutator_eq_bot_iff_le_centralizer,
      Subgroup.commutator_comm]
    exact hmapQZ
  let Cbar : Subgroup (G ⧸ T) :=
    Subgroup.centralizer (Qbar : Set (G ⧸ T))
  have hCbarNormal : Cbar.Normal := inferInstance
  let Cpre : Subgroup G := Cbar.comap qT
  have hCpreNormal : Cpre.Normal := hCbarNormal.comap qT
  let _ : Cpre.Normal := hCpreNormal
  have hZCpre : Z ≤ Cpre := by
    rw [← Subgroup.map_le_iff_le_comap]
    exact hZmapCentral
  have hWCpre : W ≤ Cpre :=
    Subgroup.normalClosure_le_normal hZCpre
  have hWmapCentral : W.map qT ≤ Cbar := by
    rw [Subgroup.map_le_iff_le_comap]
    exact hWCpre
  have hQW : ⁅Q, W⁆ ≤ T := by
    have hmapbot : (⁅Q, W⁆).map qT = ⊥ := by
      rw [Subgroup.map_commutator]
      have hcomm : ⁅W.map qT, Qbar⁆ = ⊥ :=
        Subgroup.commutator_eq_bot_iff_le_centralizer.mpr hWmapCentral
      simpa [Qbar, Subgroup.commutator_comm] using hcomm
    have hker := (Subgroup.map_eq_bot_iff (⁅Q, W⁆)).mp hmapbot
    simpa [qT, QuotientGroup.ker_mk'] using hker
  have hZcentralT : Z ≤ Subgroup.centralizer (T : Set G) := by
    rw [← Subgroup.commutator_eq_bot_iff_le_centralizer,
      Subgroup.commutator_comm]
    exact hTZ
  have hCentralTNormal : (Subgroup.centralizer (T : Set G)).Normal :=
    inferInstance
  let _ : (Subgroup.centralizer (T : Set G)).Normal := hCentralTNormal
  have hWcentralT : W ≤ Subgroup.centralizer (T : Set G) :=
    Subgroup.normalClosure_le_normal hZcentralT
  have hTW : ⁅T, W⁆ = ⊥ := by
    rw [Subgroup.commutator_comm,
      Subgroup.commutator_eq_bot_iff_le_centralizer]
    exact hWcentralT
  have hWQ : ⁅W, Q⁆ ≤ T := by
    rw [Subgroup.commutator_comm]
    exact hQW
  have hWQW : ⁅⁅W, Q⁆, W⁆ = ⊥ := by
    apply le_bot_iff.mp
    exact (Subgroup.commutator_mono hWQ le_rfl).trans (le_of_eq hTW)
  have hQWW : ⁅⁅Q, W⁆, W⁆ = ⊥ := by
    apply le_bot_iff.mp
    exact (Subgroup.commutator_mono hQW le_rfl).trans (le_of_eq hTW)
  have hDerivedCentral : ⁅⁅W, W⁆, Q⁆ = ⊥ :=
    Subgroup.commutator_commutator_eq_bot_of_rotate hWQW hQWW
  have hDerivedLeQ : ⁅W, W⁆ ≤ Q :=
    (Subgroup.commutator_eq_bot_iff_le_centralizer.mp
      hDerivedCentral).trans hchar
  have hDerivedP : IsPGroup 2 (↥(⁅W, W⁆ : Subgroup G)) :=
    (pCore_isPGroup (p := 2) (G := G)).to_le hDerivedLeQ
  let D : Subgroup W := commutator W
  have hDmap : D.map W.subtype = ⁅W, W⁆ :=
    Subgroup.map_subtype_commutator W
  have hDp : IsPGroup 2 D := by
    have hmapP : IsPGroup 2 (D.map W.subtype) := by
      rw [hDmap]
      exact hDerivedP
    exact hmapP.of_equiv
      (D.equivMapOfInjective W.subtype W.subtype_injective).symm
  let _ : D.Normal := inferInstance
  let qD : W →* W ⧸ D := QuotientGroup.mk' D
  let _ : IsMulCommutative (W ⧸ D) :=
    (Subgroup.Normal.quotient_commutative_iff_commutator_le (N := D)).2 le_rfl
  let _ : CommGroup (W ⧸ D) := IsMulCommutative.instCommGroup
  have hquotP : IsPGroup 2 (W ⧸ D) := by
    rw [isPGroup_iff_pow_pow_eq_one]
    intro y
    obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective D y
    refine ⟨1, ?_⟩
    simp only [pow_one]
    change qD w ^ 2 = 1
    let motive : ∀ x : G, x ∈ W → Prop :=
      fun x hx => qD ⟨x, hx⟩ ^ 2 = 1
    have hwclosure : (w : G) ∈
        Subgroup.closure (Group.conjugatesOfSet (Z : Set G)) := w.property
    have hw : motive (w : G) w.property :=
      Subgroup.closure_induction (p := motive)
        (fun x hx => by
          rcases Group.mem_conjugatesOfSet_iff.mp hx with ⟨z, hz, hzx⟩
          have hzpow : z ^ 2 = 1 :=
            elemPow_eq_one_of_isElementaryAbelian z hz
          have hxpow : x ^ 2 = 1 :=
            isConj_one_right.mp (by simpa [hzpow] using hzx.pow 2)
          exact congrArg qD (Subtype.ext hxpow))
        (by
          change qD (1 : W) ^ 2 = 1
          simp)
        (fun x y hx hy ihx ihy => by
          let xW : W := ⟨x, show x ∈ W from hx⟩
          let yW : W := ⟨y, show y ∈ W from hy⟩
          have ihx' : qD xW ^ 2 = 1 := by simpa [xW, motive] using ihx
          have ihy' : qD yW ^ 2 = 1 := by simpa [yW, motive] using ihy
          change qD (xW * yW) ^ 2 = 1
          rw [map_mul, mul_pow, ihx', ihy', one_mul])
        (fun x hx ihx => by
          change qD ⟨x⁻¹, _⟩ ^ 2 = 1
          change qD ⟨x, hx⟩ ^ 2 = 1 at ihx
          have hinv : (⟨x⁻¹, _⟩ : W) = (⟨x, hx⟩ : W)⁻¹ := rfl
          rw [hinv, map_inv, inv_pow, ihx, inv_one])
        hwclosure
    exact hw
  have hkerP : IsPGroup 2 qD.ker := by
    rw [QuotientGroup.ker_mk']
    exact hDp
  have hcomapP : IsPGroup 2 ((⊤ : Subgroup (W ⧸ D)).comap qD) :=
    (hquotP.to_subgroup (⊤ : Subgroup (W ⧸ D))).comap_of_ker_isPGroup
      qD hkerP
  have htopP : IsPGroup 2 (⊤ : Subgroup W) := by
    have hcomapEq : (⊤ : Subgroup (W ⧸ D)).comap qD =
        (⊤ : Subgroup W) := by
      ext x
      simp
    rw [← hcomapEq]
    exact hcomapP
  exact htopP.of_equiv (Subgroup.topEquiv : (⊤ : Subgroup W) ≃* W)
