module

public import Theory.GroupTheory.PGroup.Omega

/-!
# First omega subgroups in a common ambient group

The first omega subgroup of a subgroup is the subgroup generated by its
involutions, viewed in the ambient group. Its universal property immediately
gives monotonicity. This interface supports centralizer comparisons in
Aschbacher–Smith, B.2.3.
-/

variable {G : Type*} [Group G]

/-- The first omega subgroup at two, mapped into the ambient group. -/
@[expose] public def omegaOneAmbient (H : Subgroup G) : Subgroup G :=
  (omega₁ H (p := 2)).map H.subtype

/-- To bound the first omega subgroup, it suffices to bound each involution. -/
public theorem omegaOneAmbient_le_iff (H K : Subgroup G) :
    omegaOneAmbient H ≤ K ↔ ∀ x ∈ H, x ^ 2 = 1 → x ∈ K := by
  rw [omegaOneAmbient, Subgroup.map_le_iff_le_comap, omega₁, omega,
    Subgroup.closure_le]
  constructor
  · intro h x hx hp
    apply h (show (⟨x, hx⟩ : H) ∈ {y : H | y ^ (2 ^ 1) = 1} from ?_)
    simpa only [Set.mem_ofPred_eq, pow_one, Subtype.ext_iff, Subgroup.coe_pow, Subgroup.coe_one] using hp
  · intro h x hx
    exact h x.val x.property (by
      simpa only [Set.mem_ofPred_eq, pow_one, Subtype.ext_iff,
        Subgroup.coe_pow, Subgroup.coe_one] using hx)

/-- First omega subgroups are monotone on the subgroup lattice. -/
public theorem omegaOneAmbient_mono {H K : Subgroup G} (h : H ≤ K) :
    omegaOneAmbient H ≤ omegaOneAmbient K := by
  apply (omegaOneAmbient_le_iff _ _).mpr
  intro x hx hp
  exact (omegaOneAmbient_le_iff K (omegaOneAmbient K)).mp le_rfl x (h hx) hp

/-- The first omega subgroup lies in the original subgroup. -/
public theorem omegaOneAmbient_le (H : Subgroup G) : omegaOneAmbient H ≤ H :=
  (omegaOneAmbient_le_iff _ _).mpr fun _ hx _ => hx

/-- An elementary abelian subgroup is generated by its involutions. -/
public theorem omegaOneAmbient_eq_self (H : Subgroup G) [IsElementaryAbelian 2 H] :
    omegaOneAmbient H = H := by
  apply le_antisymm (omegaOneAmbient_le H)
  intro x hx
  exact (omegaOneAmbient_le_iff H (omegaOneAmbient H)).mp le_rfl x hx
    (elemPow_eq_one_of_isElementaryAbelian x hx)
