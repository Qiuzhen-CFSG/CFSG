module

public import Mathlib.GroupTheory.PGroup
public import Mathlib.Algebra.Group.Subgroup.Finite

/-!
# Prime-power generators normalizing an ascending series

An ordered finite generating family generates a two-group if each generator
has two-power order and normalizes the subgroup generated by its predecessors.
Induction adjoins one cyclic two-group at a time; the normalizing condition
makes the join a two-group. A finite closure can be normalized by checking
only forward conjugates of its generators.

This is the elementary cyclic-extension argument for polycyclic two-groups,
used by the explicit Held local calculations (GLS3, Table 5.3p).
-/

@[expose] public section

namespace Subgroup
variable {G : Type*} [Group G] {n : ℕ}

def generatorPrefix (g : Fin n → G) (k : ℕ) : Subgroup G :=
  closure (g '' {j | j.val < k})

theorem generatorPrefix_le (g : Fin n → G) (k : ℕ) (H : Subgroup G) :
    generatorPrefix g k ≤ H ↔ ∀ j, j.val < k → g j ∈ H := by
  rw [generatorPrefix, closure_le]
  constructor
  · intro h j hj
    exact h ⟨j, hj, rfl⟩
  · rintro h _ ⟨j, hj, rfl⟩
    exact h j hj

theorem isPGroup_closure_of_normalizing_generators (g : Fin n → G)
    (hp : ∀ j, ∃ k, g j ^ 2 ^ k = 1)
    (hn : ∀ j, g j ∈ normalizer (generatorPrefix g j.val : Set G)) :
    IsPGroup 2 (closure (Set.range g)) := by
  have hstep (k : ℕ) (hk : k < n) :
      generatorPrefix g (k+1) = zpowers (g ⟨k, hk⟩) ⊔ generatorPrefix g k := by
    apply le_antisymm
    · apply (generatorPrefix_le _ _ _).mpr
      intro j hj
      by_cases hlt : j.val < k
      · exact mem_sup_right ((generatorPrefix_le g k _).mp le_rfl j hlt)
      · have he : j = ⟨k, hk⟩ := Fin.ext (by dsimp; omega)
        subst j
        exact mem_sup_left (mem_zpowers _)
    · apply sup_le
      · apply zpowers_le.mpr
        exact (generatorPrefix_le g (k+1) _).mp le_rfl ⟨k, hk⟩ (Nat.lt_succ_self k)
      · apply (generatorPrefix_le _ _ _).mpr
        intro j hj
        exact (generatorPrefix_le _ _ _).mp le_rfl j (by omega)
  have hprefix (k : ℕ) (hk : k ≤ n) : IsPGroup 2 (generatorPrefix g k) := by
    induction k with
    | zero =>
      have he : generatorPrefix g 0 = ⊥ := by simp [generatorPrefix]
      rw [he]
      exact IsPGroup.of_bot
    | succ k ih =>
      rw [hstep k (by omega)]
      have hkn : k < n := by omega
      have hg : IsPGroup 2 (zpowers (g ⟨k, hkn⟩)) := by
        obtain ⟨r, hr⟩ := hp ⟨k, hkn⟩
        apply IsPGroup.of_card_dvd_pow (n := r)
        rw [Nat.card_zpowers]
        exact orderOf_dvd_of_pow_eq_one hr
      exact hg.to_sup_of_normal_right' (ih (by omega)) (zpowers_le.mpr (hn ⟨k, hkn⟩))
  have he : generatorPrefix g n = closure (Set.range g) := by
    unfold generatorPrefix
    congr 1
    ext x
    simp only [Set.mem_image, Set.mem_ofPred_eq, Set.mem_range]
    exact ⟨fun ⟨j, _, h⟩ => ⟨j, h⟩, fun ⟨j, h⟩ => ⟨j, j.isLt, h⟩⟩
  exact he ▸ hprefix n le_rfl
end Subgroup

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

theorem mem_normalizer_closure_of_conjugates (s : Set G) (x : G)
    (h : ∀ y ∈ s, x * y * x⁻¹ ∈ closure s) :
    x ∈ normalizer (closure s : Set G) := by
  have hle : closure s ≤ (closure s).comap (MulAut.conj x).toMonoidHom :=
    (closure_le _).mpr h
  exact mem_normalizer_fintype (fun y hy => hle hy)
end Subgroup

