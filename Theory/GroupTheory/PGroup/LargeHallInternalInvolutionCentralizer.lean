module

public import Theory.GroupTheory.PGroup.LargeHallIndexedRotations
public import Theory.GroupTheory.PGroup.LargeHallRotationAction
public import Theory.GroupTheory.PGroup.ExtraspecialCyclicRotationCentralizer

/-!
# Internal involution centralizers in large Hall central products

Let a finite two-group with cyclic center be the commuting product of an
extraspecial eight and a noncyclic binary Hall factor of order at least sixteen.
For an involution outside the subgroup generated by elements with nontrivial
fourth powers, the centralizer meets that subgroup in an extraspecial eight.
Its full centralizer has order sixteen.

The tail has characteristic cyclic rotations of index two. Their product with
the extraspecial factor is the intrinsic fourth-power subgroup, also of index
two. An outside element fixes exactly two rotations and inverts an order-four
rotation whose square is the shared central involution. The abstract correction
and product-order calculation then gives the two centralizer orders.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, Case 1, printed p.392
(PDF page 8 of the source scan). No ambient fusion or elementary-rank bound
is used.
-/

open Subgroup

namespace Subgroup

/-- Internal centralizers of involutions outside the intrinsic large Hall rotations. -/
public theorem internal_involution_centralizer_of_large_hall
    {P : Type*} [Group P] [Finite P] [IsCyclic (center P)]
    (hP : IsPGroup 2 P) (A D : Subgroup P) [A.Normal] [D.Normal]
    [IsExtraspecial 2 A] (hA : Nat.card A = 8)
    (hD : IsBinaryHallFactor D) (hn : ¬ IsCyclic D)
    (hc : D ≤ centralizer (A : Set P)) (hg : A ⊔ D = ⊤)
    (hlarge : 16 ≤ Nat.card D)
    (t : P) (ht : orderOf t = 2)
    (hout : t ∉ closure {x : P | x ^ 4 ≠ 1}) :
    IsExtraspecial 2 (closure {x : P | x ^ 4 ≠ 1} ⊓ centralizer ({t} : Set P) : Subgroup P) ∧
      Nat.card (closure {x : P | x ^ 4 ≠ 1} ⊓ centralizer ({t} : Set P) : Subgroup P) = 8 ∧
      Nat.card (centralizer ({t} : Set P)) = 16 := by
  obtain ⟨R, hRn, hRc, hiR, hR, hZ⟩ :=
    hD.exists_index_two_large_rotation hn hlarge
  let : R.Characteristic := hRn
  let : IsCyclic R := hRc
  let B := R.map D.subtype
  let : B.Normal := inferInstance
  let : IsCyclic B := (R.equivMapOfInjective D.subtype D.subtype_injective).isCyclic.mp
    inferInstance
  have hBD : B ≤ D := map_subtype_le R
  have hBcard : Nat.card B = Nat.card R := card_map_of_injective D.subtype_injective
  have hB : 8 ≤ Nat.card B := hBcard ▸ hR
  have hBc : B ≤ centralizer (A : Set P) := hBD.trans hc
  have hBne : B ≠ ⊥ := by
    intro h
    rw [h, card_bot] at hB
    omega
  have hDne : D ≠ ⊥ := by
    intro h
    rw [h, card_bot] at hlarge
    omega
  have hIB : Nat.card (A ⊓ B : Subgroup P) = 2 :=
    card_inf_eq_two_of_extraspecial_of_cyclic_center hP A B hBne hBc
  have hMcard : Nat.card (A ⊔ B : Subgroup P) = 4 * Nat.card B := by
    have h := card_mul_eq_card_inf_mul_card_sup_of_normalizes A B
      (hBc.trans (centralizer_le_normalizer _))
    rw [hA, hIB] at h
    omega
  have hDcard : Nat.card D = 2 * Nat.card B := by
    simpa only [hiR, ← hBcard] using R.index_mul_card.symm
  have hPcard : Nat.card P = 8 * Nat.card B := by
    have h := card_mul_two_eq_of_extraspecial_of_cyclic_center hP A D hDne hc hg
    rw [hA, hDcard] at h
    omega
  have hi : (A ⊔ B).index = 2 := by
    apply Nat.eq_of_mul_eq_mul_right (by omega : 0 < 4 * Nat.card B)
    have h := (A ⊔ B).index_mul_card
    rw [hMcard, hPcard] at h
    convert h using 1
    ring
  have hpow (d : P) (hd : d ∈ D) (hdB : d ∉ B) : d ^ 4 = 1 := by
    let dD : D := ⟨d, hd⟩
    have hdR : dD ∉ R := fun h => hdB ⟨dD, h, rfl⟩
    have hsq : dD ^ 2 ∈ center D :=
      central_of_commute_outside_cyclic_index_two R hiR hdR
        (R.sq_mem_of_index_two hiR dD) (Commute.self_pow dD 2).symm
    have h := congrArg Subtype.val (hZ (dD ^ 2) hsq)
    simpa only [coe_pow, coe_one, ← pow_mul] using h
  have hM : A ⊔ B = closure {x : P | x ^ 4 ≠ 1} :=
    sup_eq_closure_nontrivial_fourth_powers A D B
      (fun a ha => congrArg Subtype.val (IsExtraspecial.pow_four_eq_one (⟨a, ha⟩ : A)))
      hc hg hBD hB hpow
  have htM : t ∉ A ⊔ B := hM ▸ hout
  obtain ⟨a, ha, d, hd, htd⟩ := mem_sup_of_normal_right.mp
    (show t ∈ A ⊔ D by rw [hg]; trivial)
  have hinner : ∃ a ∈ A, ∀ b ∈ A, t * b * t⁻¹ = a * b * a⁻¹ := by
    refine ⟨a, ha, ?_⟩
    intro b hb
    rw [← htd]
    calc
      (a * d) * b * (a * d)⁻¹ = a * (d * b * d⁻¹) * a⁻¹ := by group
      _ = a * b * a⁻¹ := by rw [(show Commute d b from (hc hd b hb).symm).mul_inv_cancel]
  let dD : D := ⟨d, hd⟩
  have hdR : dD ∉ R := by
    intro h
    apply htM
    rw [← htd]
    exact mul_mem_sup ha (mem_map_of_mem D.subtype h)
  obtain ⟨r, hr⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := R)
  obtain ⟨k, hk⟩ := ((hP.to_subgroup D).to_subgroup R).exists_card_eq
  have hk3 : 3 ≤ k := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp (hk ▸ hR)
  have hdiv : 4 ∣ orderOf r := by rw [hr, hk]; exact pow_dvd_pow 2 (by omega : 2 ≤ k)
  let wR : R := r ^ (orderOf r / 4)
  let wD : D := wR
  let w : P := wD
  have hwR : orderOf wR = 4 := orderOf_pow_orderOf_div (orderOf_pos r).ne' hdiv
  have hwD : orderOf wD = 4 := (orderOf_coe wR).trans hwR
  have hw : orderOf w = 4 := (orderOf_coe wD).trans hwD
  have hwB : w ∈ B := mem_map_of_mem D.subtype wR.property
  have hwiD : dD * wD * dD⁻¹ = wD⁻¹ :=
    conj_eq_inv_of_outside_cyclic_index_two R hiR hZ hdR wR.property hwD
  have hwi : t * w * t⁻¹ = w⁻¹ := by
    rw [← htd]
    calc
      (a * d) * w * (a * d)⁻¹ = a * (d * w * d⁻¹) * a⁻¹ := by group
      _ = a * w⁻¹ * a⁻¹ := by rw [show d * w * d⁻¹ = w⁻¹ from congrArg Subtype.val hwiD]
      _ = w⁻¹ := (show Commute a w from hc wD.property a ha).inv_right.mul_inv_cancel
  have hwA : w ^ 2 ∈ A := by
    obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := (A ⊓ B : Subgroup P)) 2 (by rw [hIB])
    have hzB : orderOf (⟨z, z.property.2⟩ : B) = 2 := by
      rw [← orderOf_coe]
      exact (orderOf_coe z).trans hz
    have hwB2 : orderOf (⟨w ^ 2, B.pow_mem hwB 2⟩ : B) = 2 := by
      rw [← orderOf_coe, orderOf_pow, hw]
      decide
    have he : w ^ 2 = (z : P) := congrArg Subtype.val (IsCyclic.eq_of_orderOf_eq_two hwB2 hzB)
    exact he.symm ▸ z.property.1
  have hcomm (x : D) : Commute (x : P) t ↔ Commute x dD := by
    have hxa : Commute (x : P) a := (hc x.property a ha).symm
    constructor
    · intro hxt
      have h := hxa.inv_right.mul_right hxt
      rw [← htd] at h
      have hxd : Commute (x : P) d := by simpa only [inv_mul_cancel_left] using h
      exact Subtype.ext hxd.eq
    · intro hxd
      have hxdP : Commute (x : P) d := congrArg Subtype.val hxd.eq
      rw [← htd]
      exact hxa.mul_right hxdP
  have hfixmap : (R ⊓ centralizer ({dD} : Set D)).map D.subtype =
      B ⊓ centralizer ({t} : Set P) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨mem_map_of_mem D.subtype hy.1, mem_centralizer_singleton_iff.mpr
        ((hcomm y).mpr (mem_centralizer_singleton_iff.mp hy.2))⟩
    · rintro ⟨⟨y, hy, rfl⟩, hyt⟩
      exact ⟨y, ⟨hy, mem_centralizer_singleton_iff.mpr
        ((hcomm y).mp (mem_centralizer_singleton_iff.mp hyt))⟩, rfl⟩
  have hfix : Nat.card (B ⊓ centralizer ({t} : Set P) : Subgroup P) = 2 := by
    rw [← hfixmap, card_map_of_injective D.subtype_injective]
    exact card_inf_centralizer_of_outside_cyclic_index_two R hiR hZ hdR wR.property hwD
  have h := extraspecial_eight_centralizer_of_rotation_data A B hA hBc hMcard hi
    t (ht ▸ pow_orderOf_eq_one t) htM hinner hfix w hwB hw hwA hwi
  rwa [hM] at h

end Subgroup
