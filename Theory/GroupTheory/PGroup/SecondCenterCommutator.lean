module
public import Theory.GroupTheory.PGroup.SecondCenterFrattiniPairing
public import Theory.Frattini.PGroup

/-!
# The canonical second-center commutator and its exact right kernel

The subgroup [Z₂(P),P] is characteristic, central, and nontrivial for a
nonabelian finite two-group. It lies in both P′ and Φ(P). When the whole
center is elementary, it is exactly the subgroup generated by the values
of the literal pairing Z₂(P)/Z(P) × P/Φ(P) → Z(P).

The right kernel is C_P(Z₂(P)), so the actual quotient by this centralizer
embeds in Hom(Z₂(P)/Z(P),Z(P)) and is elementary. Automorphisms transport
both quotient representatives and the central values. These are faithful
maps in each variable after taking its own kernel, not perfect dualities.

The source application in LinearThreeMS.NonbinarySource.SecondCenterImage
uses the canonical image to refine the central layer in C.1.34; no selected
natural flag is declared characteristic in the original radical.
Source: elementary commutator identities in the second upper central term;
Aschbacher–Smith C.1.34, printed pp.136–137.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped commutatorElement IsMulCommutative
namespace Theory.GroupTheory.SecondCenterFrattini
variable {P : Type*} [Group P]
local notation "T₂" => Subgroup.upperCentralSeries P 2
local notation "V₂" => (T₂ ⧸ Subgroup.subgroupOf (center P) T₂)

/-- The image generated by all second-center commutators with the whole group. -/
@[expose] def upperImage : Subgroup P := ⁅T₂,⊤⁆

instance upperImage_characteristic : (upperImage (P := P)).Characteristic :=
  inferInstanceAs (⁅T₂,(⊤ : Subgroup P)⁆.Characteristic)

/-- Every such commutator belongs to the whole center. -/
theorem upperImage_le_center : upperImage (P := P) ≤ center P := by
  apply commutator_le.mpr
  intro x hx y _
  simpa only [Subgroup.upperCentralSeries_one] using
    (Subgroup.mem_upperCentralSeries_succ_iff.mp hx y)

/-- The canonical commutator image is nontrivial in a nonabelian finite two-group. -/
theorem upperImage_ne_bot [Finite P] (hP : IsPGroup 2 P) (hna : ¬IsMulCommutative P) :
    upperImage (P := P) ≠ ⊥ := by
  intro he
  have hle := commutator_eq_bot_iff_le_centralizer.mp he
  rw [coe_top,centralizer_univ] at hle
  exact (center_lt_second hP hna).not_ge hle

/-- The canonical image is contained in the actual derived and Frattini subgroups. -/
theorem upperImage_le_derived_frattini [Finite P] (hP : IsPGroup 2 P) :
    upperImage (P := P) ≤ _root_.commutator P ∧ upperImage (P := P) ≤ frattini P := by
  have hd : upperImage (P := P) ≤ _root_.commutator P :=
    commutator_mono le_top le_rfl
  let : Fact (IsPGroup 2 P) := ⟨hP⟩
  exact ⟨hd,hd.trans (commutator_le_frattini_of_isPGroup (p := 2))⟩

variable [Finite P] [IsElementaryAbelian 2 (center P)]

/-- The literal commutator image is generated by all values of the existing
pairing on its two original quotient maps. -/
theorem upperImage_eq_pairing_span :
    upperImage (P := P) = closure (Set.range (fun z : V₂ × (P ⧸ frattini P) =>
      (pairing z.1 z.2:P))) := by
  apply le_antisymm
  · apply commutator_le.mpr
    intro x hx y _
    apply subset_closure
    exact ⟨(QuotientGroup.mk' _ ⟨x,hx⟩,QuotientGroup.mk' (frattini P) y),pairing_apply _ _⟩
  · apply (closure_le _).mpr
    rintro z ⟨⟨v,w⟩,rfl⟩
    obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective ((center P).subgroupOf T₂) v
    obtain ⟨y,rfl⟩ := QuotientGroup.mk'_surjective (frattini P) w
    change (pairing (QuotientGroup.mk' _ x) (QuotientGroup.mk' (frattini P) y):P) ∈ upperImage
    rw [pairing_apply]
    exact commutator_mem_commutator x.property (mem_top y)

private def rightRow : P →* (V₂ →* center P) :=
  pairing.flip.comp (QuotientGroup.mk' (frattini P))

private theorem rightRow_kernel : (rightRow (P := P)).ker = centralizer (T₂ : Set P) := by
  ext y
  change rightRow y=1 ↔ ∀ x∈T₂, x*y=y*x
  constructor
  · intro hy x hx
    have he := congrArg (fun f : V₂ →* center P => (f (QuotientGroup.mk' _ ⟨x,hx⟩):P)) hy
    change (pairing (QuotientGroup.mk' _ ⟨x,hx⟩) (QuotientGroup.mk' (frattini P) y):P)=1 at he
    rw [pairing_apply] at he
    exact commutatorElement_eq_one_iff_mul_comm.mp he
  · intro hy
    apply MonoidHom.ext
    intro v
    obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective ((center P).subgroupOf T₂) v
    apply Subtype.ext
    change (pairing (QuotientGroup.mk' _ x) (QuotientGroup.mk' (frattini P) y):P)=1
    rw [pairing_apply]
    exact commutatorElement_eq_one_iff_mul_comm.mpr (hy x x.property)

/-- Quotienting the second variable by its exact centralizer makes it faithful. -/
def rightPairing : (P ⧸ centralizer (T₂ : Set P)) →* (V₂ →* center P) :=
  QuotientGroup.lift _ rightRow rightRow_kernel.ge

theorem rightPairing_apply (x : T₂) (y : P) :
    (rightPairing (QuotientGroup.mk' (centralizer (T₂ : Set P)) y)
      (QuotientGroup.mk' _ x):P)=⁅(x:P),y⁆ := pairing_apply x y

theorem rightPairing_injective : Function.Injective (rightPairing (P := P)) :=
  (QuotientGroup.injective_lift_iff _ _ _).mpr rightRow_kernel.symm

/-- This is the exact right kernel; no perfect-pairing assertion is made. -/
theorem pairing_right_kernel (y : P) :
    (∀ v : V₂, pairing v (QuotientGroup.mk' (frattini P) y)=1) ↔
      y∈centralizer (T₂ : Set P) := by
  rw [←rightRow_kernel]
  change (∀ v : V₂, rightRow y v=1) ↔ rightRow y=1
  exact ⟨fun h => MonoidHom.ext h,fun h v => DFunLike.congr_fun h v⟩

/-- The effective second variable is elementary, although the original group
need not have class two. -/
theorem right_quotient_elementary :
    IsElementaryAbelian 2 (P ⧸ centralizer (T₂ : Set P)) := by
  let E := V₂ →* center P
  let : IsElementaryAbelian 2 E := {
    toIsMulCommutative := inferInstance
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (by
      intro f
      apply MonoidHom.ext
      intro v
      exact Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 (center P)) (f v)) }
  exact IsElementaryAbelian.of_injective rightPairing rightPairing_injective

/-- Both original quotient variables and the central value transform together. -/
theorem rightPairing_automorphism (a : MulAut P) (x : T₂) (y : P) :
    rightPairing (QuotientGroup.mk' (centralizer (T₂ : Set P)) (a y))
      (QuotientGroup.mk' _ (MulAut.characteristic T₂ a x)) =
    centerCongr a (rightPairing (QuotientGroup.mk' (centralizer (T₂ : Set P)) y)
      (QuotientGroup.mk' _ x)) := pairing_automorphism a x y

end Theory.GroupTheory.SecondCenterFrattini
