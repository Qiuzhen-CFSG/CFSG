module

public import Theory.GroupAction.SubgroupConjugation
public import Theory.GroupAction.FourthPowerFixed
public import Theory.GroupAction.InvolutionDisplacementCard

/-!
# A small fixed subgroup forces a third commutator

Let a finite two-group S normalize an elementary subgroup U of order
sixteen inside S. Suppose U meets Z(S) in the line generated by z.
If an element of S fixes at most two elements of U, then z belongs to
[S,S′]. Indeed, [S,[S,U]] is nontrivial: otherwise that element acts as
an involution on U, whose fixed subgroup has order at least four.
A nontrivial normal two-subgroup has a nonidentity central fixed point;
here that point must be z.

This elementary action argument is used in the center calculation of
Parrott (1972), p.676. It needs no bound on the order of the actor.
-/

open Subgroup
open scoped commutatorElement IsMulCommutative

namespace Subgroup

/-- A single small fixed subgroup forces the central line into the third commutator. -/
public theorem mem_third_commutator_of_small_fixed
    {G : Type*} [Group G] [Finite G]
    (S U : Subgroup G) [IsElementaryAbelian 2 U]
    (hS : IsPGroup 2 S) (hUS : U ≤ S) (hSU : S ≤ normalizer (U : Set G))
    (hUcard : Nat.card U = 16) (z : G) (hzorder : orderOf z = 2)
    (hz : z ∈ U ⊓ (center S).map S.subtype)
    (hsmall : Nat.card (U ⊓ (center S).map S.subtype : Subgroup G) = 2)
    (y : G) (hyS : y ∈ S)
    (hyFixed : Nat.card (U ⊓ centralizer ({y} : Set G) : Subgroup G) ≤ 2) :
    z ∈ (⁅(⊤ : Subgroup S), _root_.commutator S⁆).map S.subtype := by
  classical
  let Z := (center S).map S.subtype
  let R := ⁅S, ⁅S, U⁆⁆
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hcommU : ⁅S, U⁆ ≤ U := le_normalizer_iff_commutator_le_right.mp hSU
  have hRU : R ≤ U := (commutator_mono le_rfl hcommU).trans hcommU
  have hRne : R ≠ ⊥ := by
    intro hRbot
    let f : MulAut U := U.normalizerMonoidHom ⟨y, hSU hyS⟩
    have hfsquare : f ^ 2 = 1 := by
      apply MulEquiv.ext
      intro u
      have hmem : ⁅y, ⁅y, (u : G)⁆⁆ ∈ R :=
        commutator_mem_commutator hyS (commutator_mem_commutator hyS u.property)
      rw [hRbot] at hmem
      have hh : y * ⁅y, (u : G)⁆ * y⁻¹ = ⁅y, (u : G)⁆ :=
        mul_inv_eq_iff_eq_mul.mpr (commutatorElement_eq_one_iff_mul_comm.mp hmem)
      have hd : f (f u * u⁻¹) = f u * u⁻¹ := Subtype.ext hh
      rw [map_mul, map_inv] at hd
      have huinv : u⁻¹ = u := inv_eq_of_mul_eq_one_left (by
        simpa only [pow_two] using
          Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
            (IsElementaryAbelian.exponent_dvd_p 2 U) u)
      simp only [← map_inv, huinv] at hd
      have hff : f (f u) = u := by
        apply mul_right_cancel (b := f u)
        calc
          f (f u) * f u = f u * u := hd
          _ = u * f u := mul_comm _ _
      exact hff
    let C := FixedPoints.subgroup (zpowers f) U
    have hCbound : Nat.card C ≤ 2 := by
      have hmap : C.map U.subtype ≤ U ⊓ centralizer ({y} : Set G) := by
        rintro x ⟨u, hu, rfl⟩
        refine ⟨u.property, mem_centralizer_singleton_iff.mpr ?_⟩
        have hh := congrArg U.subtype ((MulAut.mem_fixed_zpowers_iff f u).mp hu)
        change y * (u : G) * y⁻¹ = (u : G) at hh
        exact (mul_inv_eq_iff_eq_mul.mp hh).symm
      have hc := card_le_of_le hmap
      rw [card_map_of_injective U.subtype_injective] at hc
      exact hc.trans hyFixed
    obtain ⟨hc, hle⟩ := MulAut.involution_fixed_displacement_card_data f hfsquare
    have hb := card_le_of_le hle
    change Nat.card U = Nat.card C * Nat.card (commutatorAction (zpowers f) U) at hc
    change Nat.card (commutatorAction (zpowers f) U) ≤ Nat.card C at hb
    rw [hUcard] at hc
    nlinarith
  have hRS : R ≤ S := hRU.trans hUS
  let : MulDistribMulAction S R :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer S R (normalizer_commutator_ge_left S ⁅S, U⁆)
  have hRp : IsPGroup 2 R := hS.to_le hRS
  have hdiv : 2 ∣ Nat.card R := hRp.card_eq_or_dvd.resolve_left
    (fun hc => hRne (Subgroup.card_eq_one.mp hc))
  obtain ⟨r, hr, hrne⟩ := hS.exists_fixed_point_of_prime_dvd_card_of_fixed_point (α := R) hdiv
      (show (1 : R) ∈ MulAction.fixedPoints S R by simp [MulAction.mem_fixedPoints])
  have hrZ : (r : G) ∈ Z := by
    refine ⟨⟨r, hRS r.property⟩, mem_center_iff.mpr ?_, rfl⟩
    intro s
    apply Subtype.ext
    have hh := congrArg R.subtype ((MulAction.mem_fixedPoints.mp hr) s)
    change (s : G) * (r : G) * (s : G)⁻¹ = (r : G) at hh
    exact mul_inv_eq_iff_eq_mul.mp hh
  have hrEZ : (r : G) ∈ U ⊓ Z := ⟨hRU r.property, hrZ⟩
  have hline : zpowers z = U ⊓ Z := eq_of_le_of_card_ge
    (zpowers_le.mpr hz)
      (by rw [Nat.card_zpowers, hzorder, hsmall])
  have hrz : (r : G) = z := by
    have hzpow : (r : G) ∈ zpowers z := hline.symm ▸ hrEZ
    rw [mem_zpowers_iff_mem_range_orderOf] at hzpow
    obtain ⟨n, hn, heq⟩ := Finset.mem_image.mp hzpow
    have hn := Finset.mem_range.mp hn
    rw [hzorder] at hn
    interval_cases n
    · exact (hrne (Subtype.ext (by simpa using heq))).elim
    · simpa using heq.symm
  have hzR : z ∈ R := hrz ▸ r.property
  have hRthird : R ≤ (⁅(⊤ : Subgroup S), _root_.commutator S⁆).map S.subtype := by
    rw [map_commutator, ← MonoidHom.range_eq_map, S.range_subtype, map_subtype_commutator]
    exact commutator_mono le_rfl (commutator_mono le_rfl hUS)
  exact hRthird hzR

end Subgroup
