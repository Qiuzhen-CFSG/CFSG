module
public import Theory.GroupTheory.PGroup.ExtraspecialInvolutionDoubleCentralizer
public import Theory.GroupTheory.PGroup.ExtraspecialIndexTwoFusion
public import Theory.ElementaryAbelian.ExtraspecialEquiv

/-!
# A four-group normalized by an extraspecial involution centralizer

If the central involution were absent from a subgroup of order four normalized
by the involution centralizer, all their commutators would vanish. The intrinsic
double-centralizer bound then puts that subgroup in the four generated by the
two marked involutions, a contradiction. This supplies mutual core containment
from the literal order-four intersection in the U₄(3) recognition argument.

The companion centralizer count is the extraspecial index-two calculation at
order thirty-two. Source: Aschbacher, *Sporadic Groups* (1994), 8.15 and 45.3,
printed pp.29–30 and 242–243.
-/

open Subgroup
open scoped commutatorElement

namespace IsExtraspecial
variable {P : Type*} [Group P] [Finite P] [IsExtraspecial 2 P]

public theorem involution_mem_normalized_four (z u : P) (hz : orderOf z = 2)
    (hzZ : z ∈ center P) (hu : orderOf u = 2) (huz : u ≠ z)
    (V : Subgroup P) (hV : Nat.card V = 4)
    (hn : centralizer ({u} : Set P) ≤ normalizer (V : Set P)) : z ∈ V := by
  by_contra hzV
  have hz1 : z ≠ 1 := by intro h; simp [h] at hz
  have htriv (a : P) (haZ : a ∈ center P) (haV : a ∈ V) : a = 1 := by
    by_contra ha
    obtain ⟨w, _, hall⟩ := (Nat.card_eq_two_iff' (1 : center P)).mp
      (IsExtraspecial.center_order_p 2 P)
    have he : a = z := congrArg Subtype.val
      ((hall ⟨a,haZ⟩ (fun h => ha (congrArg Subtype.val h))).trans
        (hall ⟨z,hzZ⟩ (fun h => hz1 (congrArg Subtype.val h))).symm)
    exact hzV (he ▸ haV)
  have hcomm : ⁅centralizer ({u} : Set P), V⁆ = ⊥ := by
    apply bot_unique
    apply commutator_le.mpr
    intro c hc v hv
    apply (mem_bot).mpr
    exact htriv _
      ((IsExtraspecial.quotient_elementary_abelian 2 P).commutator_le_center_of_central_quotient
        (commutator_mem_commutator (mem_top c) (mem_top v)))
      (le_normalizer_iff_commutator_le_right.mp hn (commutator_mem_commutator hc hv))
  have hVC : V ≤ centralizer (centralizer ({u} : Set P) : Set P) := by
    intro v hv c hc
    exact commutatorElement_eq_one_iff_mul_comm.mp
      (mem_bot.mp (hcomm ▸ commutator_mem_commutator hc hv))
  let : IsExtraspecial 2 (⊤ : Subgroup P) :=
    IsExtraspecial.of_mulEquiv topEquiv.symm inferInstance
  have hdouble := IsExtraspecial.ambient_involution_double_centralizer_le
    (⊤ : Subgroup P) le_top z u hz hzZ (mem_top u) hu
  have hi : ((⊤ : Subgroup P) ⊓ centralizer ({u} : Set P) : Set P) =
      (centralizer ({u} : Set P) : Set P) := by ext x; simp
  rw [hi] at hdouble
  let E := closure ({z,u} : Set P)
  have hVE : V ≤ E := hVC.trans hdouble
  let : IsKleinFour E := isKleinFour_closure_pair_of_orderOf z u hz hu huz.symm
    (mem_center_iff.mp hzZ u).symm
  have heq : V = E := eq_of_le_of_card_ge hVE (by rw [hV,IsKleinFour.card_four])
  exact hzV (heq ▸ subset_closure (by simp))

public theorem centralizer_card_sixteen_of_card_thirty_two (hP : Nat.card P = 32)
    (u : P) (hu : u ∉ center P) : Nat.card (centralizer ({u} : Set P)) = 16 := by
  let C := centralizer ({u} : Set P)
  have hlo := centralizer_card_ge_sixteen_of_card_thirty_two hP u
  have hi := C.card_mul_index
  rw [hP] at hi
  have hine : C.index ≠ 1 := by
    intro he
    apply hu
    apply mem_center_iff.mpr
    intro x
    exact mem_centralizer_singleton_iff.mp (show x ∈ C from (index_eq_one.mp he).symm ▸ mem_top x)
  have hip := C.index_ne_zero_of_finite
  have hitwo : 2 ≤ C.index := by omega
  nlinarith
end IsExtraspecial
