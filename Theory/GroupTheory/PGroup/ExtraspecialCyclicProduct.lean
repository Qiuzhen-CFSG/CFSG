module

public import Theory.GroupTheory.PGroup.ExtraspecialCentralProductOrder
public import Theory.GroupTheory.PGroup.ExtraspecialInvolution
public import Theory.Frattini.PGroup

/-!
# Powers and generators of an extraspecial–cyclic product

A two-group generated by a normal extraspecial eight and a normal cyclic
subgroup has Frattini quotient of order at most eight: their images have
orders at most four and two. If the factors centralize one another, every
square is central. Consequently, embedding this product with index at most
two puts fourth powers of the larger group in its center.

These are the intrinsic power and generator calculations behind the cyclic
case of Janko–Thompson, Math. Z. 113 (1970), §4, pp.392–393.
-/

open Subgroup
open scoped IsMulCommutative

namespace Subgroup

/-- An extraspecial eight and a cyclic normal factor generate a two-group
with at most three generators modulo its Frattini subgroup. -/
public theorem card_frattini_quotient_le_eight_of_extraspecial_eight_cyclic
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P)
    (A D : Subgroup P) [A.Normal] [D.Normal]
    [IsExtraspecial 2 A] [IsCyclic D]
    (hA : Nat.card A = 8) (hgen : A ⊔ D = ⊤) :
    Nat.card (P ⧸ frattini P) ≤ 8 := by
  let : Fact (IsPGroup 2 P) := ⟨hP⟩
  let V := P ⧸ frattini P
  let : IsElementaryAbelian 2 V := isElementaryAbelian_quotient_frattini (p := 2)
  let q := QuotientGroup.mk' (frattini P)
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  have hAc : Nat.card (A.map q) ≤ 4 := by
    have hdiv := A.card_map_dvd q
    rw [hA] at hdiv
    change Nat.card (A.map q) ∣ 2 ^ 3 at hdiv
    obtain ⟨k, hk, hcard⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdiv
    change k ≤ 3 at hk
    interval_cases k
    · omega
    · omega
    · omega
    · have hcard8 : Nat.card (A.map q) = 8 := hcard
      have hi : Function.Injective (q.subgroupMap A) :=
        ((Nat.bijective_iff_surjective_and_card _).mpr
          ⟨q.subgroupMap_surjective A, hA.trans hcard8.symm⟩).1
      have hcomm : IsMulCommutative A := isMulCommutative_iff.mpr (fun a b => hi (by
        rw [map_mul, map_mul, mul_comm]))
      have hc : center A = ⊤ := center_eq_top_iff.mpr hcomm
      have hh := IsExtraspecial.center_order_p 2 A
      rw [hc, Nat.card_congr Subgroup.topEquiv.toEquiv, hA] at hh
      omega
  let : IsCyclic (D.map q) := isCyclic_of_surjective (q.subgroupMap D) (q.subgroupMap_surjective D)
  let : IsElementaryAbelian 2 (D.map q) := {
    toIsMulCommutative := inferInstance
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun x =>
      Subtype.ext (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 V) (x : V))) }
  have hDc : Nat.card (D.map q) ≤ 2 := by
    have hd := IsElementaryAbelian.exponent_dvd_p 2 (D.map q)
    rw [IsCyclic.exponent_eq_card] at hd
    exact Nat.le_of_dvd (by decide) hd
  have hgenq : A.map q ⊔ D.map q = ⊤ := by
    rw [← map_sup, hgen, map_top_of_surjective q hq]
  let : (A.map q).Normal := (inferInstance : A.Normal).map q hq
  have hcount := card_mul_eq_card_inf_mul_card_sup_of_normalizes (A.map q) (D.map q)
    le_normalizer_of_normal
  rw [hgenq, Nat.card_congr Subgroup.topEquiv.toEquiv] at hcount
  have hpos : 0 < Nat.card (A.map q ⊓ D.map q : Subgroup V) := Nat.card_pos
  have hmul := Nat.mul_le_mul hAc hDc
  nlinarith


/-- Squares in a central product of an extraspecial two-group and a cyclic
group are central. -/
public theorem square_mem_center_of_extraspecial_cyclic_product
    {P : Type*} [Group P]
    (A D : Subgroup P) [A.Normal] [D.Normal]
    [IsExtraspecial 2 A] [IsCyclic D]
    (hc : D ≤ centralizer (A : Set P)) (hgen : A ⊔ D = ⊤) (x : P) :
    x ^ 2 ∈ center P := by
  have hDc : D ≤ center P := by
    have ht : (⊤ : Subgroup P) ≤ centralizer (D : Set P) := by
      rw [← hgen]
      exact sup_le (le_centralizer_iff.mp hc)
        (le_centralizer_iff_isMulCommutative.mpr inferInstance)
    simpa only [coe_top, centralizer_univ] using le_centralizer_iff.mp ht
  have hAc : (center A).map A.subtype ≤ center P := by
    rintro a ⟨a, ha, rfl⟩
    apply mem_center_iff.mpr
    intro y
    obtain ⟨b, hb, d, hd, rfl⟩ := mem_sup_of_normal_right.mp (hgen.symm ▸ mem_top y)
    have hab : Commute b (a : P) := congrArg A.subtype (mem_center_iff.mp ha ⟨b, hb⟩)
    have had : Commute d (a : P) := (hc hd a a.property).symm
    exact (hab.mul_left had).eq
  obtain ⟨a, ha, d, hd, rfl⟩ := mem_sup_of_normal_right.mp (hgen.symm ▸ mem_top x)
  rw [(show Commute a d from hc hd a ha).mul_pow]
  exact (center P).mul_mem
    (hAc (mem_map_of_mem A.subtype (IsExtraspecial.square_mem_center (⟨a, ha⟩ : A))))
    ((center P).pow_mem (hDc hd) 2)

/-- Central squares in a subgroup of index at most two put all ambient
fourth powers in the mapped center. -/
public theorem fourth_power_mem_mapped_center_of_index_le_two
    {P : Type*} [Group P] [Finite P]
    (R : Subgroup P) (hi : R.index ≤ 2)
    (hsq : ∀ r : R, r ^ 2 ∈ center R) (x : P) :
    x ^ 4 ∈ (center R).map R.subtype := by
  have hi0 : R.index ≠ 0 := index_ne_zero_of_finite
  have hx : x ^ 2 ∈ R := by
    rcases (show R.index = 1 ∨ R.index = 2 by omega) with h | h
    · rw [index_eq_one.mp h]
      trivial
    · exact sq_mem_of_index_two h x
  refine ⟨(⟨x ^ 2, hx⟩ : R) ^ 2, hsq _, ?_⟩
  change (x ^ 2) ^ 2 = x ^ 4
  rw [← pow_mul]

end Subgroup

open Subgroup

