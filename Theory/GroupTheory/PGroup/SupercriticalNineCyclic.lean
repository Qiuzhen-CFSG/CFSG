module
public import Theory.GroupTheory.PGroup.NormalNineInvariantActor
public import Theory.GroupTheory.PGroup.NormalNineFixedLine
public import Theory.GroupTheory.PGroup.SupercriticalCubic

/-!
# Higher-order actors on a supercritical elementary nine

Let X be a supercritical elementary abelian subgroup of order nine in a
finite three-group P. An element y acting nontrivially on X has cube in
C_P(X), since the three-part of Aut(X) has order three. If y has order
larger than three, its last nontrivial power therefore belongs to X by
supercriticality. It spans the fixed line of y on X. Consequently the
P-fixed line of X lies in the cyclic subgroup generated by y.

This retains arbitrary three-power order; no cubic lift is assumed.
The original-group application is the cyclic enlargement in
SourceConstruction.LocalReduction.SolvableNineEnlargement.
Source: Aschbacher–Smith, 14.5.20, printed p.1019, refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup
namespace Subgroup
variable {P : Type*} [Group P] [Finite P]

theorem supercritical_nine_fixed_line_le_zpowers
    (hP : IsPGroup 3 P) (X : Subgroup P) (hX : IsSupercriticalPSubgroup 3 X)
    [IsElementaryAbelian 3 X] (h9 : Nat.card X = 9)
    (y : P) (hy : y ∉ centralizer (X : Set P)) (ho : orderOf y ≠ 3) :
    X ⊓ centralizer (⊤ : Set P) ≤ zpowers y := by
  classical
  let := hX.characteristic
  let a : P →* MulAut X := MulAut.conjNormal
  obtain ⟨c,e,he⟩ := Matrix.GeneralLinearGroup.PrimeThreeFiveResidual.exists_plane_coordinates
    (show Nat.card X = 3 ^ 2 by simpa using h9)
  have hAut : Nat.card (MulAut X) = 48 := by
    rw [Nat.card_congr e.toEquiv,Matrix.card_GL_field]
    decide
  have hcube : y ^ 3 ∈ centralizer (X : Set P) := by
    have hpa := hP.of_surjective a.rangeRestrict a.rangeRestrict_surjective
    obtain ⟨k,hk⟩ := hpa.exists_orderOf_eq_pow (a.rangeRestrict y)
    have hk : orderOf (a y) = 3 ^ k :=
      (orderOf_injective a.range.subtype a.range.subtype_injective (a.rangeRestrict y)).trans hk
    have hd : 3 ^ k ∣ 48 := hk ▸ (hAut ▸ _root_.orderOf_dvd_natCard (a y))
    have hklt : k < 2 := by
      by_contra! hh
      have hh := (Nat.pow_dvd_pow 3 hh).trans hd
      norm_num at hh
    have hpow : (a y) ^ 3 = 1 := orderOf_dvd_iff_pow_eq_one.mp (by
      rw [hk]
      exact Nat.pow_dvd_pow 3 (by omega : k ≤ 1))
    have hm : y ^ 3 ∈ a.ker := by
      change a (y ^ 3) = 1
      rw [map_pow,hpow]
    exact (show a.ker = centralizer (X : Set P) from
      MulAut.conjNormal_ker_eq_centralizer X) ▸ hm
  obtain ⟨n,hn⟩ := hP.exists_orderOf_eq_pow y
  have hn2 : 2 ≤ n := by
    have hn0 : n ≠ 0 := by
      intro hz
      have hy1 : y = 1 := orderOf_eq_one_iff.mp (by simpa [hz] using hn)
      exact hy (hy1 ▸ (centralizer (X : Set P)).one_mem)
    have hn1 : n ≠ 1 := fun h1 => ho (by simpa [h1] using hn)
    omega
  let b := y ^ (orderOf y / 3)
  have hb : orderOf b = 3 := orderOf_pow_orderOf_div (orderOf_pos y).ne'
    (hn ▸ dvd_pow_self 3 (by omega : n ≠ 0))
  have hbc : b ∈ centralizer (X : Set P) := by
    have he : orderOf y / 3 = 3 * 3 ^ (n - 2) := by
      have he0 : 3 ^ n = (3 * 3 ^ (n-2)) * 3 := by
        calc
          3 ^ n = 3 ^ ((n-2)+2) := congrArg (3 ^ ·) (by omega)
          _ = (3 * 3 ^ (n-2)) * 3 := by rw [pow_add]; ring
      rw [hn,he0,Nat.mul_div_cancel _ (by decide)]
    rw [show b = (y ^ 3) ^ (3 ^ (n-2)) by dsimp only [b]; rw [he,pow_mul]]
    exact pow_mem hcube _
  have hbX : b ∈ X := hX.order_p_mem b hbc hb
  let C := X ⊓ centralizer (zpowers y : Set P)
  have hCy : ¬ zpowers y ≤ centralizer (X : Set P) := fun hh => hy (hh (mem_zpowers y))
  have h3C : Nat.card C = 3 := normal_nine_fixed_line_card (zpowers y) X
    (hP.to_subgroup _) (hP.to_subgroup _) h9 hCy
  have hbC : b ∈ C := by
    refine ⟨hbX,?_⟩
    exact (zpowers y).le_centralizer (pow_mem (mem_zpowers y) _)
  have hCb : C = zpowers b := by
    symm
    apply eq_of_le_of_card_ge (zpowers_le.mpr hbC)
    rw [Nat.card_zpowers,hb,h3C]
  have hh : X ⊓ centralizer (⊤ : Set P) ≤ C :=
    inf_le_inf le_rfl (centralizer_le le_top)
  rw [hCb] at hh
  exact hh.trans (zpowers_le.mpr (pow_mem (mem_zpowers y) _))

end Subgroup
