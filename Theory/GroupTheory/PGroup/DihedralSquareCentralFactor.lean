module
public import Theory.GroupTheory.PGroup.DihedralCentralFactor
public import Theory.GroupTheory.InvolutionSquareFusion

/-!
# Unique involution squares in a dihedral central product

Let a finite group be generated by a dihedral-eight subgroup `D` and its
centralizer `C`. Suppose the center of `C` has order two, every fourth root
of one in `C` has central square, and `C` normalizes a cyclic subgroup of
order four. Then all elements of order four in the product have the same
square, and every element centralizes an element of order four.

The common central involution is the only possible nontrivial square.
For the commuting root, a rotation of `D` suffices unless the dihedral
component is a reflection. A fixed order-four element of `C` then works
unless it is inverted. In that case a second dihedral reflection compensates
for the inversion; their product still has order four. In a Sylow subgroup,
`InvolutionSquareFusion` consequently makes the common involution weakly closed.

This extends the square argument in `DihedralQuaternionCentralFactorSylow`
to dihedral and semidihedral centralizers. It supplies the central-product
exclusion in the reduction toward Janko–Thompson, Math. Z. 113 (1970),
result 1.2, printed pp.385–386, using the explicit dihedral-eight calculation.
-/

open Subgroup

namespace Subgroup

/-- An order-two center, central fourth-root squares, and a normal cyclic four
in the centralizer give unique involution squares and commuting fourth roots. -/
public theorem dihedral_factor_square_data
    {P : Type*} [Group P] [Finite P]
    (D : Subgroup P) (e : D ≃* DihedralGroup 4)
    (hgen : D ⊔ centralizer (D : Set P) = ⊤)
    (hcenter : Nat.card (center (centralizer (D : Set P))) = 2)
    (hsq : ∀ c : centralizer (D : Set P), c ^ 4 = 1 →
      c ^ 2 ∈ center (centralizer (D : Set P)))
    (q : centralizer (D : Set P)) (hq : orderOf q = 4)
    (hqconj : ∀ c : centralizer (D : Set P),
      c * q * c⁻¹ = q ∨ c * q * c⁻¹ = q⁻¹) :
    ∃ z : P, orderOf z = 2 ∧ z ∈ center P ∧
      (∀ x : P, orderOf x = 4 → x ^ 2 = z) ∧
      (∀ t : P, ∃ x : P, orderOf x = 4 ∧ Commute x t) := by
  let C := centralizer (D : Set P)
  let I : Subgroup P := D ⊓ C
  have hI : Nat.card I = 2 := card_inf_centralizer_of_dihedral D e
  obtain ⟨zI, hzI, hIz⟩ := (Nat.card_eq_two_iff' (1 : I)).mp hI
  let z : P := zI
  have hz : z ≠ 1 := fun h => hzI (Subtype.ext h)
  have hz2 : z ^ 2 = 1 := by
    exact congrArg Subtype.val (hI ▸ pow_card_eq_one' (x := zI))
  have hzin : z ∈ I := zI.property
  have hIcases (x : P) (hx : x ∈ I) : x = 1 ∨ x = z := by
    by_cases h : x = 1
    · exact Or.inl h
    · exact Or.inr (congrArg Subtype.val (hIz ⟨x, hx⟩ (fun he => h (congrArg Subtype.val he))))
  have hzcentral : z ∈ center P := by
    have hD : D ≤ centralizer ({z} : Set P) := by
      intro d hd
      exact mem_centralizer_singleton_iff.mpr (hzin.2 d hd)
    have hC : C ≤ centralizer ({z} : Set P) := by
      intro c hc
      exact mem_centralizer_singleton_iff.mpr (hc z hzin.1).symm
    have hall : (⊤ : Subgroup P) ≤ centralizer ({z} : Set P) := by
      rw [← hgen]
      exact sup_le hD hC
    exact mem_center_iff.mpr (fun p => mem_centralizer_singleton_iff.mp (hall (mem_top p)))
  let zC : C := ⟨z, hzin.2⟩
  have hzC : zC ≠ 1 := fun h => hz (congrArg Subtype.val h)
  have hzCcenter : zC ∈ center C := by
    apply mem_center_iff.mpr
    intro c
    exact Subtype.ext (mem_center_iff.mp hzcentral c)
  have hCsq (c : C) (hc : c ^ 4 = 1) : c ^ 2 = 1 ∨ c ^ 2 = zC := by
    obtain ⟨w, hw, hall⟩ := (Nat.card_eq_two_iff' (1 : center C)).mp hcenter
    have hzeq : (⟨zC, hzCcenter⟩ : center C) = w :=
      hall _ (fun h => hzC (congrArg Subtype.val h))
    by_cases h : c ^ 2 = 1
    · exact Or.inl h
    · right
      have he := hall (⟨c ^ 2, hsq c hc⟩ : center C)
        (fun he => h (congrArg Subtype.val he))
      exact congrArg Subtype.val (he.trans hzeq.symm)
  have hq2 : (q : P) ^ 2 = z := by
    apply (congrArg Subtype.val : q ^ 2 = zC → (q : P) ^ 2 = z)
    exact (hCsq q (by rw [← hq]; exact pow_orderOf_eq_one _)).resolve_left (by
      intro h
      have hd := orderOf_dvd_of_pow_eq_one h
      rw [hq] at hd
      norm_num at hd)
  have hd4 (d : D) : d ^ 4 = 1 := by
    apply e.injective
    simpa only [map_pow, map_one] using
      (show ∀ y : DihedralGroup 4, y ^ 4 = 1 from by decide) (e d)
  have hd2 (d : D) : (d : P) ^ 2 ∈ I := by
    refine ⟨D.pow_mem d.property 2, ?_⟩
    intro a ha
    have he : e ⟨a, ha⟩ * (e d) ^ 2 = (e d) ^ 2 * e ⟨a, ha⟩ :=
      (show ∀ a b : DihedralGroup 4, a * b ^ 2 = b ^ 2 * a from by decide) _ _
    have hh : (⟨a, ha⟩ : D) * d ^ 2 = d ^ 2 * ⟨a, ha⟩ := e.injective (by simpa using he)
    exact congrArg Subtype.val hh
  have hdecomp (x : P) : ∃ d : D, ∃ c : C, (d : P) * c = x := by
    have hx : x ∈ D ⊔ C := hgen ▸ mem_top x
    rw [← SetLike.mem_coe, coe_mul_of_right_le_normalizer_left D C
      (centralizer_le_normalizer (D : Set P))] at hx
    obtain ⟨d, hd, c, hc, he⟩ := hx
    exact ⟨⟨d, hd⟩, ⟨c, hc⟩, he⟩
  have hcomm (d : D) (c : C) : Commute (d : P) (c : P) := c.property d d.property
  refine ⟨z, orderOf_eq_prime hz2 hz, hzcentral, ?_, ?_⟩
  · intro x hx
    obtain ⟨d, c, rfl⟩ := hdecomp x
    have h4 : ((d : P) * c) ^ 4 = 1 := by
      rw [← hx]
      exact pow_orderOf_eq_one _
    have hc4 : c ^ 4 = 1 := by
      apply Subtype.ext
      change (c : P) ^ 4 = 1
      simpa only [(hcomm d c).mul_pow, show (d : P) ^ 4 = 1 from
        congrArg Subtype.val (hd4 d), one_mul] using h4
    have hc2 : (c : P) ^ 2 ∈ I := by
      rcases hCsq c hc4 with h | h
      · rw [show (c : P) ^ 2 = 1 from congrArg Subtype.val h]
        exact I.one_mem
      · rw [show (c : P) ^ 2 = z from congrArg Subtype.val h]
        exact hzin
    apply (hIcases _ (by rw [(hcomm d c).mul_pow]; exact I.mul_mem (hd2 d) hc2)).resolve_left
    intro h
    have hdvd := orderOf_dvd_of_pow_eq_one h
    rw [hx] at hdvd
    norm_num at hdvd
  · intro t
    obtain ⟨d, c, rfl⟩ := hdecomp t
    have hzmodel : e ⟨z, hzin.1⟩ = DihedralGroup.r 2 := by
      have hzDcenter : (⟨z, hzin.1⟩ : D) ∈ center D := by
        apply mem_center_iff.mpr
        intro y
        exact Subtype.ext (hzin.2 y y.property)
      have hecenter : e ⟨z, hzin.1⟩ ∈ center (DihedralGroup 4) := by
        apply mem_center_iff.mpr
        intro y
        simpa only [map_mul, e.apply_symm_apply] using
          congrArg e (mem_center_iff.mp hzDcenter (e.symm y))
      have hene : e ⟨z, hzin.1⟩ ≠ 1 := by
        intro he
        exact hz (congrArg Subtype.val (e.injective (he.trans (map_one e).symm)))
      exact (show ∀ x : DihedralGroup 4, x ∈ center (DihedralGroup 4) → x ≠ 1 →
        x = DihedralGroup.r 2 from by decide) _ hecenter hene
    have hcases := (show ∀ d : DihedralGroup 4,
      DihedralGroup.r 1 * d = d * DihedralGroup.r 1 ∨
      ∃ v : DihedralGroup 4, v ^ 2 = 1 ∧ d * v = v * d * DihedralGroup.r 2
      from by decide) (e d)
    rcases hcases with hd | ⟨v, hv2, hdv⟩
    · let r : D := e.symm (DihedralGroup.r 1)
      have hr : orderOf r = 4 := by
        rw [MulEquiv.orderOf_eq, DihedralGroup.orderOf_r_one]
      have hrd : Commute (r : P) d := by
        apply (congrArg Subtype.val : r * d = d * r → (r : P) * d = (d : P) * r)
        apply e.injective
        simpa only [map_mul, r, e.apply_symm_apply] using hd
      exact ⟨r, (Subgroup.orderOf_coe r).trans hr, hrd.mul_right (hcomm r c)⟩
    · rcases hqconj c with hcq | hcq
      · have hqc : Commute (q : P) c := by
          exact (Commute.map (show Commute c q from mul_inv_eq_iff_eq_mul.mp hcq)
            C.subtype).symm
        exact ⟨q, (Subgroup.orderOf_coe q).trans hq, (hcomm d q).symm.mul_right hqc⟩
      · let vD : D := e.symm v
        have hvD : (vD : P) ^ 2 = 1 := by
          apply (congrArg Subtype.val : vD ^ 2 = 1 → (vD : P) ^ 2 = 1)
          apply e.injective
          simpa only [map_pow, map_one, vD, e.apply_symm_apply] using hv2
        have hdvD : (d : P) * vD = (vD : P) * d * z := by
          have he : d * vD = vD * d * ⟨z, hzin.1⟩ := by
            apply e.injective
            simpa only [map_mul, vD, e.apply_symm_apply, hzmodel] using hdv
          exact congrArg Subtype.val he
        have hqinv : (q : P)⁻¹ = (q : P) * z := by
          apply inv_eq_of_mul_eq_one_right
          calc
            (q : P) * ((q : P) * z) = (q : P) ^ 2 * z := by simp only [pow_two, mul_assoc]
            _ = 1 := by rw [hq2, ← pow_two, hz2]
        have hcqP : (c : P) * q = (q : P) * c * z := by
          have hh := congrArg Subtype.val (mul_inv_eq_iff_eq_mul.mp hcq)
          change (c : P) * q = (q : P)⁻¹ * c at hh
          rw [hh, hqinv, mul_assoc, (mem_center_iff.mp hzcentral c).symm, ← mul_assoc]
        have horder : orderOf ((vD : P) * q) = 4 := by
          have hh : ((vD : P) * q) ^ 2 = z := by
            rw [(hcomm vD q).mul_pow, hvD, one_mul, hq2]
          apply @orderOf_eq_prime_pow P _ _ 1 2 ⟨Nat.prime_two⟩
          · simpa only [pow_one, hh] using hz
          · change ((vD : P) * q) ^ 4 = 1
            rw [show (4 : ℕ) = 2 * 2 by rfl, pow_mul, hh, hz2]
        refine ⟨(vD : P) * q, horder, Commute.symm ?_⟩
        change ((d : P) * c) * ((vD : P) * q) = ((vD : P) * q) * ((d : P) * c)
        calc
          ((d : P) * c) * ((vD : P) * q) = ((d : P) * vD) * ((c : P) * q) :=
            (hcomm vD c).symm.mul_mul_mul_comm _ _
          _ = ((vD : P) * d * z) * ((q : P) * c * z) := by rw [hdvD, hcqP]
          _ = ((vD : P) * d) * ((q : P) * c) * (z * z) := by
            rw [(show Commute z ((q : P) * c) from
              (mem_center_iff.mp hzcentral _).symm).mul_mul_mul_comm]
          _ = ((vD : P) * d) * ((q : P) * c) := by rw [← pow_two, hz2, mul_one]
          _ = ((vD : P) * q) * ((d : P) * c) :=
            (hcomm d q).mul_mul_mul_comm _ _

end Subgroup

namespace Sylow

/-- The unique involution square of this dihedral central product is weakly
closed in any finite group in which the product is a Sylow two-subgroup. -/
public theorem exists_weakly_closed_involution_of_dihedral_square_factor
    {G : Type*} [Group G] [Finite G]
    (S : Sylow 2 G) (D : Subgroup S) (e : D ≃* DihedralGroup 4)
    (hgen : D ⊔ centralizer (D : Set S) = ⊤)
    (hcenter : Nat.card (center (centralizer (D : Set S))) = 2)
    (hsq : ∀ c : centralizer (D : Set S), c ^ 4 = 1 →
      c ^ 2 ∈ center (centralizer (D : Set S)))
    (q : centralizer (D : Set S)) (hq : orderOf q = 4)
    (hqconj : ∀ c : centralizer (D : Set S),
      c * q * c⁻¹ = q ∨ c * q * c⁻¹ = q⁻¹) :
    ∃ z : S, orderOf z = 2 ∧ z ∈ center S ∧
      ∀ t : S, IsConj (z : G) (t : G) → t = z := by
  obtain ⟨z, hz, hzC, hsquare, hroot⟩ :=
    dihedral_factor_square_data D e hgen hcenter hsq q hq hqconj
  refine ⟨z, hz, hzC, ?_⟩
  intro t ht
  have horder : orderOf t = 2 := by
    obtain ⟨g, hg⟩ := ht
    rw [← Subgroup.orderOf_coe, ← hg.orderOf_eq (g : G), Subgroup.orderOf_coe, hz]
  exact S.eq_of_isConj_of_unique_involution_square z hzC hsquare
    (fun t _ => hroot t) t horder ht.symm

end Sylow
