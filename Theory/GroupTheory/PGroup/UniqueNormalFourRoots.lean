module

public import Theory.GroupTheory.PGroup.RankTwoNormalFour
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators
public import Theory.GroupTheory.InvolutionCentralizerFourCyclicComplement
public import Mathlib.GroupTheory.IndexNormal

/-!
# Commuting square roots for a unique normal four-group

In a finite two-group of elementary rank at most two with a unique normal
four-group `E`, every involution outside `E` centralizes a square root of
each central involution.

First exclude an outside involution `t` with centralizer of order four.
The involution-centralizer theorem gives a cyclic subgroup `A` of index two.
An element of `E` outside `A` acts on `A` just as `t` does. Thus the
intersection of `A` with `C(E)` has order at most two and index at most four,
forcing the whole group to have order eight. The four generated by `t` and
the central involution is then normal, contradicting uniqueness.

Next, a square involution in `C(t)` belongs to `E`, since every square
centralizes a normal four. The intersection `E ∩ C(t)` has just one
involution, the given central involution `z`. If `z` has no square root in
`C(t)`, that centralizer has exponent two; the rank bound forces its order
to be four, which was excluded.

This supplies the intrinsic square-root step in Janko–Thompson,
Math. Z. 113 (1970), §6, printed p.395, by the involution-centralizer theorem
instead of the source's maximal-normal-abelian-subgroup calculation.
-/

open Subgroup
open scoped IsMulCommutative

private theorem centralizer_card_ne_four_of_unique_normal_four {P : Type*} [Group P] [Finite P]
    (hP : IsPGroup 2 P)
    (hrank : ∀ A : Subgroup P, IsElementaryAbelian 2 A → Nat.card A < 8)
    (E : Subgroup P) [E.Normal] [IsElementaryAbelian 2 E] (hE : Nat.card E = 4)
    (hunique : ∀ F : Subgroup P, F.Normal → IsElementaryAbelian 2 F →
      Nat.card F = 4 → F = E)
    (z t : P) (hzC : z ∈ center P) (hz : orderOf z = 2)
    (ht : orderOf t = 2) (htE : t ∉ E) :
    Nat.card (centralizer ({t} : Set P)) ≠ 4 := by
  intro hCt
  have hzE : z ∈ E := mem_four_of_square_eq_one_of_elementary_card_lt_eight
    hrank E hE (by simpa only [hz] using pow_orderOf_eq_one z)
      (center_le_centralizer _ hzC)
  have htZ : t ∉ center P := fun h => htE
    (mem_four_of_square_eq_one_of_elementary_card_lt_eight hrank E hE
      (by simpa only [ht] using pow_orderOf_eq_one t) (center_le_centralizer _ h))
  obtain ⟨a, ha, htA⟩ :=
    exists_zpowers_index_two_of_involution_centralizer_card_four hP t ht htZ hCt
  let A := zpowers a
  have hEA : ¬ E ≤ A := by
    intro h
    let : IsCyclic E := isCyclic_of_le h
    have hd : Nat.card E ∣ 2 := by
      rw [← IsCyclic.exponent_eq_card]
      exact IsElementaryAbelian.exponent_dvd_p 2 E
    norm_num [hE] at hd
  obtain ⟨e, heE, heA⟩ := SetLike.not_le_iff_exists.mp hEA
  let B := A ⊓ centralizer (E : Set P)
  let C := A ⊓ centralizer ({t} : Set P)
  have hBC : B ≤ C := by
    intro b hb
    refine ⟨hb.1, mem_centralizer_singleton_iff.mpr ?_⟩
    have hd : t * e⁻¹ ∈ A := (mul_mem_iff_of_index_two ha).mpr
      (by simp only [inv_mem_iff]; exact iff_of_false htA heA)
    have hbd : Commute b (t * e⁻¹) := (A.le_centralizer hb.1 _ hd).symm
    have hbe : Commute b e := (hb.2 e heE).symm
    have hh := hbd.mul_right hbe
    simpa only [inv_mul_cancel_right] using hh.eq
  have hCproper : C < centralizer ({t} : Set P) := by
    apply lt_of_le_of_ne inf_le_right
    intro heq
    have htC : t ∈ C := by
      change t ∈ A ⊓ centralizer ({t} : Set P)
      rw [heq]
      exact mem_centralizer_singleton_iff.mpr rfl
    exact htA htC.1
  have hCsmall : Nat.card C ≤ 2 := by
    have hle := card_le_of_le hCproper.le
    have hne : Nat.card C ≠ Nat.card (centralizer ({t} : Set P)) := by
      intro h
      exact hCproper.ne (eq_of_le_of_card_ge hCproper.le h.ge)
    have hlt := lt_of_le_of_ne hle hne
    have hd := card_dvd_of_le (show C ≤ centralizer ({t} : Set P) from inf_le_right)
    rw [hCt] at hlt hd
    interval_cases hh : Nat.card C <;> norm_num at *
  have hBsmall : Nat.card B ≤ 2 := (card_le_of_le hBC).trans hCsmall
  have hBi : B.index ≤ 4 := by
    have hh := index_inf_le (H := A) (K := centralizer (E : Set P))
    have hb := centralizer_index_le_two_of_normal_four hP E hE
    change A.index = 2 at ha
    change B.index ≤ A.index * (centralizer (E : Set P)).index at hh
    rw [ha] at hh
    omega
  have hcard : Nat.card P ≤ 8 := by
    have hh := B.card_mul_index
    nlinarith
  have hEi : 2 ≤ E.index := by
    have hp := E.index_ne_zero_of_finite
    have hn : E.index ≠ 1 := fun h => htE (index_eq_one.mp h ▸ mem_top t)
    omega
  have hcard8 : Nat.card P = 8 := by
    have hh := E.card_mul_index
    rw [hE] at hh
    omega
  let F := closure ({z, t} : Set P)
  let : IsKleinFour F := isKleinFour_closure_pair_of_orderOf z t hz ht
    (fun h => htE (h ▸ hzE)) (mem_center_iff.mp hzC t).symm
  have hF : Nat.card F = 4 := IsKleinFour.card_four
  have hFi : F.index = 2 := by
    have hh := F.card_mul_index
    rw [hF, hcard8] at hh
    omega
  have hFE : F = E := hunique F (F.normal_of_index_eq_two hFi)
    { toIsMulCommutative := IsKleinFour.isMulCommutative
      exponent_dvd_p := by rw [IsKleinFour.exponent_two] } hF
  exact htE (hFE ▸ subset_closure (by simp : t ∈ ({z,t} : Set P)))

/-- An involution outside the unique normal four centralizes a square root
of every central involution, under the elementary rank bound. -/
public theorem IsPGroup.exists_commuting_square_root_of_unique_normal_four
    {P : Type*} [Group P] [Finite P]
    (hP : IsPGroup 2 P)
    (hrank : ∀ A : Subgroup P, IsElementaryAbelian 2 A → Nat.card A < 8)
    (E : Subgroup P) [E.Normal] [IsElementaryAbelian 2 E] (hE : Nat.card E = 4)
    (hunique : ∀ F : Subgroup P, F.Normal → IsElementaryAbelian 2 F →
      Nat.card F = 4 → F = E)
    (z t : P) (hzC : z ∈ center P) (hz : orderOf z = 2)
    (ht : orderOf t = 2) (htE : t ∉ E) :
    ∃ x : P, x ^ 2 = z ∧ Commute x t := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hz2 : z ^ 2 = 1 := by simpa only [hz] using pow_orderOf_eq_one z
  have ht2 : t ^ 2 = 1 := by simpa only [ht] using pow_orderOf_eq_one t
  have hzE : z ∈ E := mem_four_of_square_eq_one_of_elementary_card_lt_eight
    hrank E hE hz2 (center_le_centralizer _ hzC)
  let C := centralizer ({t} : Set P)
  let I := E ⊓ C
  have hIproper : I < E := by
    apply lt_of_le_of_ne inf_le_left
    intro heq
    apply htE
    apply mem_four_of_square_eq_one_of_elementary_card_lt_eight hrank E hE ht2
    intro e he
    have heI : e ∈ I := by change e ∈ E ⊓ C; rw [heq]; exact he
    exact mem_centralizer_singleton_iff.mp heI.2
  have hIsmall : Nat.card I ≤ 2 := by
    have hle := card_le_of_le hIproper.le
    have hne : Nat.card I ≠ Nat.card E := by
      intro h
      exact hIproper.ne (eq_of_le_of_card_ge hIproper.le h.ge)
    have hlt := lt_of_le_of_ne hle hne
    have hd := card_dvd_of_le hIproper.le
    rw [hE] at hlt hd
    interval_cases hh : Nat.card I <;> norm_num at *
  let : IsCyclic I := isCyclic_of_card_dvd_prime (p := 2) (by
    have hp := Nat.card_pos (α := I)
    interval_cases hh : Nat.card I <;> norm_num at *)
  have hzI : z ∈ I := ⟨hzE, mem_centralizer_singleton_iff.mpr
    (mem_center_iff.mp hzC t).symm⟩
  have hsquare (x : P) : x ^ 2 ∈ centralizer (E : Set P) := by
    have hb := centralizer_index_le_two_of_normal_four hP E hE
    have hn := (centralizer (E : Set P)).index_ne_zero_of_finite
    have hi : (centralizer (E : Set P)).index = 1 ∨
        (centralizer (E : Set P)).index = 2 := by omega
    rcases hi with hi | hi
    · rw [index_eq_one.mp hi]; trivial
    · exact sq_mem_of_index_two hi x
  by_contra hroot
  have hCexp : ∀ x : C, x ^ 2 = 1 := by
    intro x
    by_contra hx2
    obtain ⟨n, hn⟩ := (hP.to_subgroup C).exists_orderOf_eq_pow x
    have hn2 : 2 ≤ n := by
      by_contra h
      have hsmall : n = 0 ∨ n = 1 := by omega
      rcases hsmall with rfl | rfl
      · exact hx2 (by have hx1 : x = 1 := orderOf_eq_one_iff.mp (by simpa using hn); rw [hx1]; simp)
      · exact hx2 (by simpa only [hn, pow_one] using pow_orderOf_eq_one x)
    have hd : 4 ∣ orderOf x := by
      rw [hn]
      exact Nat.pow_dvd_pow 2 hn2
    let y : C := x ^ (orderOf x / 4)
    have hy : orderOf y = 4 := orderOf_pow_orderOf_div (orderOf_pos x).ne' hd
    have hy2 : orderOf (y ^ 2) = 2 := by
      rw [orderOf_pow, hy]
      norm_num
    have hs2 : ((y : P) ^ 2) ^ 2 = 1 := by
      have hh := pow_orderOf_eq_one (y ^ 2)
      rw [hy2] at hh
      exact congrArg Subtype.val hh
    have hsE : (y : P) ^ 2 ∈ E :=
      mem_four_of_square_eq_one_of_elementary_card_lt_eight hrank E hE hs2 (hsquare y)
    have hsI : (y : P) ^ 2 ∈ I := ⟨hsE, C.pow_mem y.property 2⟩
    have hsz : (y : P) ^ 2 = z := by
      have hh := IsCyclic.eq_of_orderOf_eq_two
        (x := (⟨(y : P) ^ 2, hsI⟩ : I)) (y := (⟨z, hzI⟩ : I))
        (by rw [← orderOf_coe]; exact (orderOf_coe (y ^ 2)).trans hy2)
        (by simpa using hz)
      exact congrArg Subtype.val hh
    exact hroot ⟨y, hsz, mem_centralizer_singleton_iff.mp y.property⟩
  let : IsElementaryAbelian 2 C :=
    { toIsMulCommutative := ⟨⟨fun a b =>
        (Commute.of_orderOf_dvd_two (fun c => orderOf_dvd_of_pow_eq_one (hCexp c)) a b).eq⟩⟩
      exponent_dvd_p := Monoid.exponent_dvd_of_forall_pow_eq_one hCexp }
  have hClt := hrank C inferInstance
  let F := closure ({z,t} : Set P)
  let : IsKleinFour F := isKleinFour_closure_pair_of_orderOf z t hz ht
    (fun h => htE (h ▸ hzE)) (mem_center_iff.mp hzC t).symm
  have hFC : F ≤ C := by
    apply (closure_le _).mpr
    intro b hb
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
    rcases hb with rfl | rfl
    · exact hzI.2
    · exact mem_centralizer_singleton_iff.mpr rfl
  have hdiv : 4 ∣ Nat.card C := by
    rw [← IsKleinFour.card_four (G := F)]
    exact card_dvd_of_le hFC
  have hge : 4 ≤ Nat.card C := by
    simpa only [IsKleinFour.card_four] using card_le_of_le hFC
  exact centralizer_card_ne_four_of_unique_normal_four hP hrank E hE hunique z t
    hzC hz ht htE (by change Nat.card C = 4; omega)
