module

public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Intersecting abelian supplements

Inside an abelian subgroup `W`, suppose `Z ≤ Y ⊔ V` and `V` is generated
by its intersections with `Z` and `Y`. Then `Z` is generated by its own
intersections with `Y` and `V`. No finiteness or ambient normality is needed.

The proof absorbs `V ⊓ Y` into `Y`, then factors each element of `Z` in
the abelian group `W` as a product from `Y` and `V ⊓ Z`. The first factor
must also lie in `Z`. This is the subgroup-modularity step used in
Stellmacher (2.3), Journal of Algebra 190 (1997), p. 20, with `Y = Zˣ`.
-/

namespace Subgroup

public theorem eq_inf_sup_inf_of_abelian_supplement
    {G : Type*} [Group G] (W Z Y V : Subgroup G) [IsMulCommutative W]
    (hZW : Z ≤ W) (hYW : Y ≤ W) (hVW : V ≤ W)
    (hZYV : Z ≤ Y ⊔ V) (hV : V ≤ (V ⊓ Z) ⊔ (V ⊓ Y)) :
    Z = (Z ⊓ Y) ⊔ (Z ⊓ V) := by
  have hZYD : Z ≤ Y ⊔ (V ⊓ Z) := calc
    Z ≤ Y ⊔ V := hZYV
    _ ≤ Y ⊔ ((V ⊓ Z) ⊔ (V ⊓ Y)) := sup_le_sup_left hV Y
    _ = Y ⊔ (V ⊓ Z) := by
      rw [← sup_assoc]
      exact sup_eq_left.mpr (inf_le_right.trans le_sup_left)
  let Yw := Y.subgroupOf W
  let Dw := (V ⊓ Z).subgroupOf W
  have hYw : Yw.map W.subtype = Y := map_subgroupOf_eq_of_le hYW
  have hDw : Dw.map W.subtype = V ⊓ Z :=
    map_subgroupOf_eq_of_le (inf_le_left.trans hVW)
  have hZw : Z.subgroupOf W ≤ Yw ⊔ Dw := by
    apply (map_le_map_iff_of_injective W.subtype_injective).mp
    rw [map_subgroupOf_eq_of_le hZW, map_sup, hYw, hDw]
    exact hZYD
  let _ : Yw.Normal := normal_of_isMulCommutative Yw
  apply le_antisymm _ (sup_le inf_le_left inf_le_left)
  intro z hz
  obtain ⟨y, hy, d, hd, heq⟩ := mem_sup_of_normal_left.mp
    (hZw (show (⟨z, hZW hz⟩ : W) ∈ Z.subgroupOf W from hz))
  have heqG : (y : G) * (d : G) = z := congrArg Subtype.val heq
  have hyY : (y : G) ∈ Y := hy
  have hdVZ : (d : G) ∈ V ⊓ Z := hd
  have hyZ : (y : G) ∈ Z := by
    have hyEq : (y : G) = z * (d : G)⁻¹ := by rw [← heqG]; simp
    rw [hyEq]
    exact Z.mul_mem hz (Z.inv_mem hdVZ.2)
  rw [← heqG]
  exact ((Z ⊓ Y) ⊔ (Z ⊓ V)).mul_mem
    ((show Z ⊓ Y ≤ (Z ⊓ Y) ⊔ (Z ⊓ V) from le_sup_left) ⟨hyZ, hyY⟩)
    ((show Z ⊓ V ≤ (Z ⊓ Y) ⊔ (Z ⊓ V) from le_sup_right) ⟨hdVZ.2, hdVZ.1⟩)

end Subgroup
