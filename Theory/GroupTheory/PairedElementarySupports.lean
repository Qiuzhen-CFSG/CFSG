module

public import Theory.GroupTheory.CommutatorPreimage
public import Theory.GroupTheory.Commutator.RelativeGeneration
public import Theory.GroupTheory.NormalizedSupCard
public import Mathlib.GroupTheory.Index
public import Mathlib.Algebra.Group.Subgroup.Finite

/-!
# The central intersection forced by two paired supports

Two abelian subgroups normalize one another. If the first is generated by
two invariant supports, and each support meets a distinguished central plane
in only the same line, their commutator cannot equal that plane. An order-eight
centralizer bound therefore makes the commutator equal the full intersection.

No invariance under an external automorphism is assumed or concluded.
-/

namespace Subgroup
open scoped commutatorElement IsMulCommutative

/-- The support decomposition forces an order-eight central intersection
and an order-128 join of the actual elementary subgroups. -/
public theorem paired_supports_commutator_eq_intersection
    {G : Type*} [Group G] [Finite G]
    (U V A Z : Subgroup G) (W : Fin 2 → Subgroup G)
    [IsMulCommutative U] [IsMulCommutative V]
    (hUV : U ≤ normalizer (V : Set G))
    (hVU : V ≤ normalizer (U : Set G))
    (hW : ∀ k, W k ≤ U) (hgen : W 0 ⊔ W 1 = U)
    (hVW : ∀ k, V ≤ normalizer (W k : Set G))
    (hWA : ∀ k, W k ⊓ A ≤ Z)
    (hA : A ≤ ⁅U,V⁆) (hAc : Nat.card A = 4) (hZc : Nat.card Z = 2)
    (hC : Nat.card (U ⊓ centralizer (V : Set G) : Subgroup G) = 8)
    (hUc : Nat.card U = 32) (hVc : Nat.card V = 32) :
    ⁅U,V⁆ = U ⊓ V ∧ Nat.card (⁅U,V⁆ : Subgroup G) = 8 ∧
      U ⊓ centralizer (V : Set G) = U ⊓ V ∧
      Nat.card (U ⊔ V : Subgroup G) = 128 := by
  let K := ⁅U,V⁆
  have hKU : K ≤ U := le_normalizer_iff_commutator_le_left.mp hVU
  have hKV : K ≤ V := by
    rw [show K = ⁅U,V⁆ from rfl, commutator_comm]
    exact le_normalizer_iff_commutator_le_left.mp hUV
  have hIC : U ⊓ V ≤ U ⊓ centralizer (V : Set G) :=
    inf_le_inf_left U (le_centralizer_iff_isMulCommutative.mpr inferInstance)
  have hKC : K ≤ U ⊓ centralizer (V : Set G) := (le_inf hKU hKV).trans hIC
  have hKc : Nat.card K ≤ 8 := hC ▸ card_le_of_le hKC
  have hAK : A ≤ K := hA
  have hnot : ¬ K ≤ A := by
    intro hKA
    have hcomm (k : Fin 2) : ⁅W k,V⁆ ≤ Z :=
      (le_inf (le_normalizer_iff_commutator_le_left.mp (hVW k))
        ((commutator_mono (hW k) le_rfl).trans hKA)).trans (hWA k)
    have hZnormal : U ⊔ V ≤ normalizer ((Z ⊓ K : Subgroup G) : Set G) := by
      apply sup_le
      · apply le_trans ((le_centralizer_iff_isMulCommutative.mpr inferInstance).trans
          (centralizer_le (inf_le_right.trans hKU)))
        exact centralizer_le_normalizer _
      · apply le_trans ((le_centralizer_iff_isMulCommutative.mpr inferInstance).trans
          (centralizer_le (inf_le_right.trans hKV)))
        exact centralizer_le_normalizer _
    have hKZ : K ≤ Z := by
      have hh : ⁅W 0 ⊔ W 1,V⁆ ≤ Z ⊓ K :=
        commutator_sup_le_of_relative_normal (U ⊔ V) (W 0) (W 1) V (Z ⊓ K)
          hZnormal ((hW 0).trans le_sup_left) ((hW 1).trans le_sup_left)
          (le_inf (hcomm 0) (commutator_mono (hW 0) le_rfl))
          (le_inf (hcomm 1) (commutator_mono (hW 1) le_rfl))
      rw [hgen] at hh
      exact hh.trans inf_le_left
    have hh := card_le_of_le (hAK.trans hKZ)
    rw [hAc,hZc] at hh
    omega
  have hfour : 4 ∣ Nat.card K := hAc ▸ card_dvd_of_le hAK
  have hneq : Nat.card K ≠ 4 := by
    intro he
    exact hnot (eq_of_le_of_card_ge hAK (by rw [he,hAc])).ge
  have hKeight : Nat.card K = 8 := by
    have hp : 0 < Nat.card K := Nat.card_pos
    obtain ⟨n,hn⟩ := hfour
    omega
  have hKCeq : K = U ⊓ centralizer (V : Set G) :=
    eq_of_le_of_card_ge hKC (by rw [hKeight,hC])
  have hKI : K = U ⊓ V := le_antisymm (le_inf hKU hKV) (hIC.trans hKCeq.ge)
  refine ⟨hKI,hKeight,hKCeq.symm.trans hKI,?_⟩
  have hh := card_mul_eq_card_inf_mul_card_sup_of_normalizes U V hVU
  rw [hUc,hVc,←hKI,hKeight] at hh
  omega

end Subgroup
