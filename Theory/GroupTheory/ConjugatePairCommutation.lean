module
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Commutation from conjugate-factor centralization

Suppose a subgroup V is generated by W and a conjugate W^t, where t lies
in M and normalizes V. A universal placement and centralization assertion
for W^g propagates to the whole V^g: first use g and g*t, then t⁻¹*g and
t⁻¹*g*t. The latter full conjugates lie in M, so any admissibility condition
which holds for subgroups of M can be reused. The conclusion is [V,V^g]=1.

Source application: Aschbacher--Smith, quasithin 10.2.12, printed pp.754–755.
The proof keeps the literal convention X^g = g X g⁻¹.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G]

/-- If a conjugation-stable pair generates V, placing and centralizing one
factor of each relevant conjugate implies commutation with the whole V. -/
theorem conjugate_commutator_eq_bot_of_pair_factor
    (M V W : Subgroup G) (t : G) (ht : t ∈ M)
    (htV : t ∈ normalizer (V : Set G))
    (hpair : V = W ⊔ W.map (MulAut.conj t).toMonoidHom)
    (P : Subgroup G → Prop) (hP : ∀ X : Subgroup G, X ≤ M → P X)
    (hfactor : ∀ h : G, h ∉ M → P (V.map (MulAut.conj h).toMonoidHom) →
      W.map (MulAut.conj h).toMonoidHom ≤ M ∧
      W.map (MulAut.conj h).toMonoidHom ≤ centralizer (W : Set G))
    (g : G) (hg : g ∉ M) (hPg : P (V.map (MulAut.conj g).toMonoidHom)) :
    ⁅V,V.map (MulAut.conj g).toMonoidHom⁆ = ⊥ := by
  have hmul (X : Subgroup G) (a b : G) :
      X.map (MulAut.conj (a*b)).toMonoidHom =
        (X.map (MulAut.conj b).toMonoidHom).map (MulAut.conj a).toMonoidHom :=
    conjBy_mul X a b
  have htV' : V.map (MulAut.conj t).toMonoidHom = V :=
    mem_normalizer_iff_map_conj_eq.mp htV
  have hright (h : G) :
      V.map (MulAut.conj (h*t)).toMonoidHom = V.map (MulAut.conj h).toMonoidHom := by
    rw [hmul,htV']
  have hfull (h : G) (hh : h ∉ M) (hPh : P (V.map (MulAut.conj h).toMonoidHom)) :
      V.map (MulAut.conj h).toMonoidHom ≤ M ∧
      V.map (MulAut.conj h).toMonoidHom ≤ centralizer (W : Set G) := by
    have hht : h*t ∉ M := by
      intro hm
      exact hh ((M.mul_mem_cancel_right ht).mp hm)
    have h₁ := hfactor h hh hPh
    have h₂ := hfactor (h*t) hht (by rw [hright]; exact hPh)
    have hsplit : V.map (MulAut.conj h).toMonoidHom =
        W.map (MulAut.conj h).toMonoidHom ⊔ W.map (MulAut.conj (h*t)).toMonoidHom := by
      rw [hpair,map_sup,hmul]
    rw [hsplit]
    exact ⟨sup_le h₁.1 h₂.1,sup_le h₁.2 h₂.2⟩
  have h₁ := hfull g hg hPg
  have hleft : t⁻¹*g ∉ M := by
    intro hm
    exact hg ((M.mul_mem_cancel_left (M.inv_mem ht)).mp hm)
  have hleftM : V.map (MulAut.conj (t⁻¹*g)).toMonoidHom ≤ M := by
    rw [hmul]
    exact (map_mono h₁.1).trans_eq
      (mem_normalizer_iff_map_conj_eq.mp (M.le_normalizer (M.inv_mem ht)))
  have h₂ := (hfull (t⁻¹*g) hleft (hP _ hleftM)).2
  have h₂comm : ⁅W,V.map (MulAut.conj (t⁻¹*g)).toMonoidHom⁆ = ⊥ :=
    commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp h₂)
  have hmap := congrArg (Subgroup.map (MulAut.conj t).toMonoidHom) h₂comm
  have hcancel : (V.map (MulAut.conj (t⁻¹*g)).toMonoidHom).map
      (MulAut.conj t).toMonoidHom = V.map (MulAut.conj g).toMonoidHom := by
    rw [←hmul,mul_inv_cancel_left]
  rw [map_commutator,hcancel,map_bot] at hmap
  apply commutator_eq_bot_iff_le_centralizer.mpr
  apply hpair.le.trans
  exact sup_le (le_centralizer_iff.mp h₁.2)
    (commutator_eq_bot_iff_le_centralizer.mp hmap)

end Subgroup
