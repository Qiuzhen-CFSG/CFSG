module

public import Theory.GroupTheory.CentralCoprimeLiftUnique
public import Mathlib.GroupTheory.Perm.Fin
public import Mathlib.GroupTheory.Perm.Sign
import Mathlib.Tactic

/-!
# Order-three elements in a central four-cover of the symmetric group

Suppose a central extension of S₄ has kernel generated by the square of
an element `a` of order eight. If an element `b` of exponent four has
image of order four, then `a` inverts an element of order three.

The image of `a` is an involution. It cannot be a double transposition:
those are conjugate to the square of the image of `b`, whose lifts all
have exponent four. Thus it is a transposition and inverts a three-cycle.
Lift that three-cycle through the central two-group kernel; uniqueness of
coprime torsion lifts gives the required inversion. The centralizer of a
three-cycle in S₄ has exponent three, giving the local two-element bound.

This is an alternative central-quotient proof of the local construction
in Fong, J. Algebra 6 (1967), p.75.
-/

namespace MonoidHom

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem perm_four_inverter :
    ∀ a b : Equiv.Perm (Fin 4), a ^ 2 = 1 → b ^ 4 = 1 → b ^ 2 ≠ 1 →
    a = 1 ∨ (∃ v : Equiv.Perm (Fin 4), v * a * v⁻¹ = b ^ 2) ∨
      ∃ r : Equiv.Perm (Fin 4), r ^ 3 = 1 ∧ r ≠ 1 ∧ a⁻¹ * r * a = r⁻¹ := by
  decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem perm_four_three_centralizer :
    ∀ r a : Equiv.Perm (Fin 4), r ^ 3 = 1 → r ≠ 1 →
    a * r = r * a → a ^ 3 = 1 := by
  decide +kernel

public theorem exists_inverted_three_of_symmetric_four_central_cover
    {H : Type*} [Group H] (f : H →* Equiv.Perm (Fin 4))
    (hf : Function.Surjective f) (a b : H) (ha : orderOf a = 8)
    (hker : f.ker = Subgroup.zpowers (a ^ 2))
    (hcentral : f.ker ≤ Subgroup.center H)
    (hb : b ^ 4 = 1) (hb2 : f (b ^ 2) ≠ 1) :
    ∃ r : H, orderOf r = 3 ∧ a⁻¹ * r * a = r⁻¹ ∧
      ∀ t : H, Commute t r → (∃ n : ℕ, t ^ (2 ^ n) = 1) → t ∈ f.ker := by
  have ha8 : a ^ 8 = 1 := ha ▸ pow_orderOf_eq_one a
  have ha4 : a ^ 4 ≠ 1 := by
    intro h
    have hd := orderOf_dvd_of_pow_eq_one h
    rw [ha] at hd
    norm_num at hd
  have hk4 : ∀ k ∈ f.ker, k ^ 4 = 1 := by
    intro k hk
    rw [hker] at hk
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hk
    rw [← zpow_natCast, ← zpow_mul, mul_comm n, zpow_mul, zpow_natCast,
      ← pow_mul, ha8, one_zpow]
  have hp : IsPGroup 2 f.ker := by
    apply isPGroup_iff_pow_pow_eq_one.mpr
    intro k
    exact ⟨2, Subtype.ext (hk4 k k.property)⟩
  have hfa2 : (f a) ^ 2 = 1 := by
    rw [← map_pow]
    exact (show a ^ 2 ∈ f.ker from hker ▸ Subgroup.mem_zpowers _)
  have hfane : f a ≠ 1 := fun h => ha4 (hk4 a h)
  obtain he | he | ⟨r₀, hr₀3, hr₀ne, har₀⟩ := perm_four_inverter (f a) (f b)
    hfa2 (by rw [← map_pow, hb, map_one]) (by simpa only [map_pow] using hb2)
  · exact (hfane he).elim
  · obtain ⟨v, hv⟩ := he
    obtain ⟨g, rfl⟩ := hf v
    let y := g * a * g⁻¹
    have hk : y * (b ^ 2)⁻¹ ∈ f.ker := by
      simp only [mem_ker, y, map_mul, map_inv, map_pow]
      change (f g * f a * (f g)⁻¹) * ((f b) ^ 2)⁻¹ = 1
      rw [hv, mul_inv_cancel]
    have hcomm : Commute (y * (b ^ 2)⁻¹) (b ^ 2) :=
      (Subgroup.mem_center_iff.mp (hcentral hk) (b ^ 2)).symm
    have hy4 : y ^ 4 = 1 := by
      have hh := hcomm.mul_pow 4
      rw [inv_mul_cancel_right, hk4 _ hk, ← pow_mul] at hh
      rw [show (2 * 4 : ℕ) = 4 * 2 from rfl, pow_mul, hb, one_pow, one_mul] at hh
      exact hh
    have hh : (MulAut.conj g) (a ^ 4) = (MulAut.conj g) 1 := by
      rw [map_pow, map_one]
      exact hy4
    exact (ha4 ((MulAut.conj g).injective hh)).elim
  · obtain ⟨r, hfr, hr3⟩ := f.exists_pow_eq_one_lift_of_central_pgroup_ker hf
      hcentral hp (by decide : Nat.Coprime 2 3) r₀ hr₀3
    have hr : orderOf r = 3 := orderOf_eq_prime hr3 (fun h => hr₀ne (by
      rw [← hfr, h, map_one]))
    refine ⟨r, hr, ?_, ?_⟩
    · apply f.eq_of_map_eq_of_pow_eq_one_of_central_pgroup_ker hcentral hp
        (by decide : Nat.Coprime 2 3)
      · simpa only [map_mul, map_inv, hfr] using har₀
      · have hh : ((MulAut.conj a⁻¹) r) ^ 3 = 1 := by
          rw [← map_pow, hr3, map_one]
        simpa only [MulAut.conj_apply, inv_inv] using hh
      · rw [inv_pow, hr3, inv_one]
    · intro t ht ⟨n, hn⟩
      have hft3 : (f t) ^ 3 = 1 := perm_four_three_centralizer r₀ (f t)
        hr₀3 hr₀ne (by simpa only [map_mul, hfr] using congrArg f ht.eq)
      have hft2 : (f t) ^ (2 ^ n) = 1 := by rw [← map_pow, hn, map_one]
      apply orderOf_eq_one_iff.mp
      exact Nat.eq_one_of_dvd_coprimes ((by decide : Nat.Coprime 3 2).pow_right n)
        (orderOf_dvd_of_pow_eq_one hft3) (orderOf_dvd_of_pow_eq_one hft2)

end MonoidHom
