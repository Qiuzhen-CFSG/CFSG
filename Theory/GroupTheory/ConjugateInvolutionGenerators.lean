module
public import Mathlib.GroupTheory.Complement
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Algebra.Group.Conj
public import Mathlib.GroupTheory.Subgroup.Center
public import Mathlib.Tactic

/-!
# Trivial center for two conjugate involution generators

A finite group generated by two conjugate subgroups of order two has trivial
center whenever its order is greater than two. Write the generators as `a`,
`b` and the rotation as `r = b * a`. Every element has the form `r^k` or
`r^k * a`. Conjugacy of `a` and `b` yields `r = r^(2n)` for an integer `n`,
so the rotation subgroup has no nonidentity involution. A central rotation
is inverted and fixed by `a`; a central reflection would force `r` to be an
involution. Both possibilities give the required triviality.

This source-neutral argument supplies the dihedral step in Aschbacher–Smith,
*The Classification of Quasithin Groups*, combined manuscript (1 March 2004),
A.1.14(1), printed p.23.
-/

open Subgroup
open scoped Pointwise

private theorem center_aux {G : Type*} [Group G] [Finite G]
    (a b : G) (ha : a ^ 2 = 1) (hb : b ^ 2 = 1) (hane : a ≠ 1)
    (hab : a ≠ b) (hgen : zpowers a ⊔ zpowers b = ⊤)
    (hconj : ∃ g : G, g * a * g⁻¹ = b) : center G = ⊥ := by
  classical
  have haa : a * a = 1 := by simpa only [pow_two] using ha
  have hbb : b * b = 1 := by simpa only [pow_two] using hb
  have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right haa
  have hbi : b⁻¹ = b := inv_eq_of_mul_eq_one_right hbb
  let r := b * a
  have hrconj : a * r * a⁻¹ = r⁻¹ := by
    dsimp [r]
    simp only [mul_inv_rev, hai, hbi, mul_assoc, haa, mul_one]
  have hrinv (k : ℤ) : a * r ^ k * a⁻¹ = (r ^ k)⁻¹ := by
    rw [← conj_zpow, hrconj, inv_zpow]
  have hnorm : zpowers a ≤ normalizer (zpowers r : Set G) := by
    apply zpowers_le.mpr
    rw [mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
    change zpowers (a * r * a⁻¹) = zpowers r
    rw [hrconj, zpowers_inv]
  have hgen' : zpowers r ⊔ zpowers a = ⊤ := by
    apply top_unique
    rw [← hgen]
    apply sup_le
    · exact le_sup_right
    · apply zpowers_le.mpr
      have hh := (zpowers r ⊔ zpowers a).mul_mem
        (mem_sup_left (mem_zpowers r)) (mem_sup_right (mem_zpowers a))
      simpa only [r, mul_assoc, haa, mul_one] using hh
  have hcases (g : G) : ∃ k : ℤ, g = r ^ k ∨ g = r ^ k * a := by
    have hm : g ∈ (zpowers r : Set G) * (zpowers a : Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left _ _ hnorm, hgen']
      trivial
    obtain ⟨x, hx, y, hy, rfl⟩ := hm
    obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hx
    have hay : y = 1 ∨ y = a := by
      change y ∈ zpowers a at hy
      rw [mem_zpowers_iff_mem_range_orderOf, orderOf_eq_prime ha hane] at hy
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hy
      have hi2 : i < 2 := Finset.mem_range.mp hi
      interval_cases i <;> simp
    refine ⟨k, ?_⟩
    rcases hay with rfl | rfl
    · exact Or.inl (mul_one _)
    · exact Or.inr rfl
  obtain ⟨g, hg⟩ := hconj
  obtain ⟨n, hn⟩ := hcases g
  have hswap : a * ((r ^ n)⁻¹ * a) = r ^ n := by
    simpa only [mul_inv_rev, inv_inv, hai, mul_assoc] using congrArg Inv.inv (hrinv n)
  have hrotation : r = r ^ (2 * n) := by
    calc
      r = b * a := rfl
      _ = (g * a * g⁻¹) * a := congrArg (fun x : G => x * a) hg.symm
      _ = (r ^ n) ^ 2 := by
        rcases hn with hn | hn <;> rw [hn] <;>
          simp only [pow_two, mul_inv_rev, hai, mul_assoc, haa, mul_one] <;> rw [hswap]
      _ = r ^ (2 * n) := by rw [← zpow_ofNat, ← zpow_mul, Int.mul_comm]
  have hno_two (x : G) (hx : x ∈ zpowers r) (hx2 : x ^ 2 = 1) : x = 1 := by
    obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hx
    calc
      r ^ k = (r ^ (2 * n)) ^ k := congrArg (fun y : G => y ^ k) hrotation
      _ = ((r ^ k) ^ (2 : ℤ)) ^ n := by
        simp only [← zpow_mul]
        congr 1
        ring
      _ = 1 := by rw [zpow_ofNat, hx2, one_zpow]
  apply (eq_bot_iff_forall (center G)).mpr
  intro z hz
  have hcomm (y : G) : y * z = z * y := mem_center_iff.mp hz y
  obtain ⟨k, rfl | rfl⟩ := hcases z
  · apply hno_two _ (zpow_mem (mem_zpowers _) _)
    have heq : r ^ k = (r ^ k)⁻¹ := by
      rw [← hrinv, hcomm a, mul_assoc, mul_inv_cancel, mul_one]
    rw [pow_two]
    nth_rw 1 [heq]
    exact inv_mul_cancel _
  · have heq : r = r⁻¹ := by
      have hh := hcomm r
      have hpow := (Commute.refl r).zpow_right k
      have hc : r ^ k * r * a = r ^ k * a * r := by
        rw [← hpow.eq]
        simpa only [mul_assoc] using hh
      have har : r * a = a * r := mul_left_cancel (by simpa only [mul_assoc] using hc)
      rw [← hrconj, ← har, mul_assoc, mul_inv_cancel, mul_one]
    have hr2 : r ^ 2 = 1 := by
      rw [pow_two]
      nth_rw 1 [heq]
      exact inv_mul_cancel _
    have hr1 := hno_two r (mem_zpowers _) hr2
    have hba : b = a := by
      have := congrArg (fun x : G => x * a) hr1
      simpa only [r, mul_assoc, haa, mul_one, one_mul] using this
    exact (hab hba.symm).elim

/-- A finite group of order greater than two generated by two conjugate
subgroups of order two has trivial center. -/
public theorem Subgroup.center_eq_bot_of_conjugate_order_two_generators
    {G : Type*} [Group G] [Finite G] (A B : Subgroup G)
    (hAcard : Nat.card A = 2) (_hBcard : Nat.card B = 2)
    (hgen : A ⊔ B = ⊤)
    (hconj : ∃ g : G, A.map (MulAut.conj g).toMonoidHom = B)
    (hcard : 2 < Nat.card G) : center G = ⊥ := by
  obtain ⟨a₀, ha₀, huniq⟩ := (Nat.card_eq_two_iff' (1 : A)).mp hAcard
  let a : G := a₀
  have hane : a ≠ 1 := fun he => ha₀ (Subtype.ext he)
  have ha : a ^ 2 = 1 := by
    have hh : a₀ ^ 2 = 1 := by rw [← hAcard]; exact pow_card_eq_one'
    exact congrArg (fun x : A => (x : G)) hh
  have hA : zpowers a = A := by
    apply le_antisymm (zpowers_le.mpr a₀.property)
    intro x hx
    by_cases he : x = 1
    · simp [he]
    · have hu : (⟨x, hx⟩ : A) = a₀ := huniq _ (fun h => he (congrArg Subtype.val h))
      have heq : x = a := congrArg Subtype.val hu
      exact heq ▸ mem_zpowers a
  obtain ⟨g, hg⟩ := hconj
  let b := MulAut.conj g a
  have hb : b ^ 2 = 1 := by
    change (MulAut.conj g a) ^ 2 = 1
    rw [← map_pow, ha, map_one]
  have hB : zpowers b = B := by
    change zpowers ((MulAut.conj g).toMonoidHom a) = B
    rw [← MonoidHom.map_zpowers, hA, hg]
  have hab : a ≠ b := by
    intro he
    have hAB : A = B := by rw [← hA, ← hB, he]
    have htop : A = ⊤ := by simpa [← hAB] using hgen
    rw [htop, card_top] at hAcard
    omega
  exact center_aux a b ha hb hane hab (by rw [hA, hB]; exact hgen) ⟨g, rfl⟩
