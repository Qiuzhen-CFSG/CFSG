module

public import Theory.GroupTheory.SpecificGroups.QuaternionEightInvolution
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Commuting roots in a quaternion central factor

If a group is generated by a quaternion subgroup of order eight and its
centralizer, the quaternion involution is central in the whole group.
Every element commutes with a square root of that involution: write it as
a product from the two commuting factors, and choose a commuting root in
the quaternion factor.

This is the root construction in MacWilliams, Trans. AMS 150 (1970), §3(iv),
printed p.368, DOI 10.1090/S0002-9947-1970-0276324-3. No finiteness or
elementary-rank hypothesis on the ambient group is required.
-/

open Subgroup
open scoped Pointwise

namespace Subgroup

/-- The quaternion involution is central, and has a square root commuting
with every prescribed element of the ambient central product. -/
public theorem quaternion_central_factor_involution_roots
    {P : Type*} [Group P] (Q : Subgroup P) (e : Q ≃* QuaternionGroup 2)
    (hgen : Q ⊔ centralizer (Q : Set P) = ⊤)
    (z : Q) (hz : orderOf z = 2) :
    (z : P) ∈ center P ∧
      ∀ t : P, ∃ x : Q, (x : P) ^ 2 = z ∧ Commute (x : P) t := by
  have hez : e z = QuaternionGroup.a 2 :=
    QuaternionGroup.eq_a_two_of_orderOf_eq_two _ ((e.orderOf_eq z).trans hz)
  have hdecomp (t : P) : ∃ q : Q, ∃ c : centralizer (Q : Set P), (q : P) * c = t := by
    have ht : t ∈ Q ⊔ centralizer (Q : Set P) := hgen ▸ mem_top t
    rw [← SetLike.mem_coe, coe_mul_of_right_le_normalizer_left Q
      (centralizer (Q : Set P)) (centralizer_le_normalizer (Q : Set P))] at ht
    obtain ⟨q, hq, c, hc, he⟩ := ht
    exact ⟨⟨q, hq⟩, ⟨c, hc⟩, he⟩
  constructor
  · apply mem_center_iff.mpr
    intro t
    obtain ⟨q, c, rfl⟩ := hdecomp t
    have hzq : Commute z q := by
      apply e.injective
      simpa only [map_mul, hez] using
        (show ∀ v : QuaternionGroup 2, QuaternionGroup.a 2 * v = v * QuaternionGroup.a 2
          from by decide) (e q)
    exact ((hzq.map Q.subtype).mul_right (c.property z z.property)).symm.eq
  · intro t
    obtain ⟨q, c, rfl⟩ := hdecomp t
    obtain ⟨r, hr, hrq⟩ := (show ∀ v : QuaternionGroup 2,
      ∃ r : QuaternionGroup 2, r ^ 2 = QuaternionGroup.a 2 ∧ r * v = v * r
      from by decide) (e q)
    let x := e.symm r
    have hx : x ^ 2 = z := e.injective (by
      simpa only [x, map_pow, e.apply_symm_apply, hez] using hr)
    have hxq : Commute x q := e.injective (by
      simpa only [x, map_mul, e.apply_symm_apply] using hrq)
    exact ⟨x, congrArg Subtype.val hx,
      (hxq.map Q.subtype).mul_right (c.property x x.property)⟩

end Subgroup
