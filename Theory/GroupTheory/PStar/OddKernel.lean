module

public import Theory.GroupTheory.PStar.RadicalActionReduction
public import Theory.GroupTheory.PStar.Chief
public import Theory.GroupTheory.GeneralizedFitting.ComponentLayerStructure

/-!
# Two-star cores and odd kernels

The inverse image of the quotient two-star core is two-star by the
prime-to-two kernel implication of GLS II, B.5.3. Maximality therefore
gives equality of the two cores under an odd-kernel surjection. The ordinary
layer is two-star because it is generated by its intrinsic components.
These are the radical transfer and lower inclusion used in B.5.16.
-/

public section
open Subgroup Theory.GroupTheory
namespace Subgroup
variable {G H : Type*} [Group G] [Group H] [Finite G] [Finite H]

theorem comap_twoStarCore_of_surjective_odd_kernel
    (f : G →* H) (hf : Function.Surjective f)
    (hk : Odd (Nat.card f.ker)) :
    (pStarCore 2 H).comap f = pStarCore 2 G := by
  let R := (pStarCore 2 H).comap f
  let g := f.subgroupComap (pStarCore 2 H)
  have hker : Nat.Coprime 2 (Nat.card g.ker) := by
    let i : g.ker →* f.ker :=
      (R.subtype.comp g.ker.subtype).codRestrict _ (fun x => by
        change f (x.val.val : G) = 1
        exact congrArg Subtype.val (MonoidHom.mem_ker.mp x.property))
    have hi : Function.Injective i := by
      intro x y h
      have hv : ((x : R) : G) = ((y : R) : G) :=
        congrArg (fun z : f.ker => (z : G)) h
      exact Subtype.ext (Subtype.ext hv)
    exact hk.coprime_two_left.of_dvd_right (card_dvd_of_injective i hi)
  have hR : IsPStar 2 R := isPStar_of_surjective_coprime_kernel g
    (f.subgroupComap_surjective_of_surjective _ hf) hker isPStar_twoStarCore
  exact le_antisymm (le_pStarCore R hR)
    (map_le_iff_le_comap.mp (map_pStarCore_le_of_surjective f hf))

theorem map_twoStarCore_of_surjective_odd_kernel
    (f : G →* H) (hf : Function.Surjective f)
    (hk : Odd (Nat.card f.ker)) :
    (pStarCore 2 G).map f = pStarCore 2 H := by
  rw [← comap_twoStarCore_of_surjective_odd_kernel f hf hk,
    map_comap_eq_self_of_surjective hf]

theorem isPStar_componentLayer : IsPStar 2 (componentLayer G) :=
  isPStar_of_componentLayer_eq_top componentLayer_idempotent

theorem componentLayer_le_twoStarCore : componentLayer G ≤ pStarCore 2 G :=
  le_pStarCore _ isPStar_componentLayer

end Subgroup
