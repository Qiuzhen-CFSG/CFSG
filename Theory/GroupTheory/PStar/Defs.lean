module

public import Theory.GroupTheory.PResidual.Defs
public import Theory.PGroupCore
public import Mathlib.GroupTheory.Sylow

/-!
# Bender's p-star groups and their normal join

A p-star group is p-perfect and is generated by each normal subgroup N
together with the centralizer of a Sylow p-subgroup of N. The normal join
below is the candidate p-star radical. Closure under normal products, and
hence the assertion that this join is itself p-star, are separate theorems.

Source: GLS II, Definitions 5.1 and 5.7. All residuals in this definition
are O^p, not O^{p'}. The p-core extension is the subgroup denoted O_{p*p}.
-/

@[expose] public section
open Subgroup
namespace Theory.GroupTheory
/-- Bender's definition, GLS II 5.1; the residual is O^p, not O^{p'}. -/
def IsPStar (p : ℕ) (G : Type*) [Group G] : Prop :=
  pResidual p G = ⊤ ∧ ∀ (N : Subgroup G) [N.Normal] (P : Sylow p N),
    N ⊔ centralizer ((P : Subgroup N).map N.subtype : Set G) = ⊤
end Theory.GroupTheory

namespace Subgroup
open Theory.GroupTheory

/-- The join of the normal p-star subgroups. -/
def pStarCore (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ IsPStar p N}

instance pStarCore_normal {G : Type*} [Group G] (p : ℕ) : (pStarCore p G).Normal :=
  sSup_normal _ (fun _ h => h.1)

/-- The full preimage of the p-core modulo the p-star core. -/
def pStarPCore (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  (pCore p (G ⧸ pStarCore p G)).comap (QuotientGroup.mk' (pStarCore p G))

instance pStarPCore_normal {G : Type*} [Group G] (p : ℕ) : (pStarPCore p G).Normal :=
  inferInstanceAs ((pCore p (G ⧸ pStarCore p G)).comap
    (QuotientGroup.mk' (pStarCore p G))).Normal

end Subgroup
