module

public import Theory.GroupTheory.PStar.Basic
public import Theory.GroupTheory.GeneralizedFitting.ChiefComponents
public import Theory.GroupTheory.PResidual.AbelianCoprimeKernel

/-!
# Components and minimal normal subgroups are p-star

Quasisimple groups satisfy the definition because every proper normal
subgroup is central. A group generated by components is p-star: each
component lies in or centralizes a given normal subgroup. The existing
chief-factor theorem then handles nonabelian minimal normal subgroups;
abelian residuals have order prime to p.

Source: GLS II, Chapter B, Lemma 5.2(i),(iii), using the component normal
subgroup dichotomy and the finite chief-factor theorem.
-/

public section

open Subgroup
namespace Theory.GroupTheory
variable {p : ℕ} {G : Type*} [Group G] [Finite G] [Fact p.Prime]

private theorem perfect_isPPerfect [Group.IsPerfect G] : IsPPerfect p G := by
  intro N hN hq
  let : N.Normal := hN
  by_contra hne
  let : Nontrivial (G ⧸ N) := QuotientGroup.nontrivial_iff.mpr hne
  let : Group.IsPerfect (G ⧸ N) :=
    Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective N)
  let : Group.IsNilpotent (G ⧸ N) := hq.isNilpotent
  exact Group.IsPerfect.not_isSolvable (G ⧸ N) inferInstance

/-- Quasisimple groups are p-star (GLS II 5.2(i)). -/
theorem isPStar_of_isQuasisimple [IsQuasisimple G] : IsPStar p G := by
  refine ⟨(pResidual_eq_top_iff p G).mpr perfect_isPPerfect, ?_⟩
  intro N _ P
  rcases IsQuasisimple.normal_le_center_or_eq_top N with hc | ht
  · have hz : (P : Subgroup N).map N.subtype ≤ center G := (map_subtype_le _).trans hc
    rw [centralizer_eq_top_iff_subset.mpr hz, sup_top_eq]
  · apply top_unique
    intro x _
    exact (le_sup_left : N ≤ N ⊔ centralizer
      ((P : Subgroup N).map N.subtype : Set G)) (show x ∈ N by rw [ht]; trivial)

/-- A group generated by its ordinary components is p-star. -/
theorem isPStar_of_componentLayer_eq_top (hE : componentLayer G = ⊤) : IsPStar p G := by
  constructor
  · apply top_unique
    rw [← hE]
    apply sSup_le
    intro L hL
    let : IsQuasisimple L := hL.2
    exact le_pResidual_of_isPPerfect L
      ((pResidual_eq_top_iff p L).mp (isPStar_of_isQuasisimple (p := p) (G := L)).1)
  · intro N _ P
    apply top_unique
    rw [← hE]
    apply sSup_le
    intro L hL
    rcases hL.normal_dichotomy N with hLN | hc
    · exact hLN.trans le_sup_left
    · exact ((commutator_eq_bot_iff_le_centralizer.mp hc).trans
        (centralizer_le (map_subtype_le (P : Subgroup N)))).trans le_sup_right

/-- The p-residual of an actual minimal normal subgroup is p-star,
as in GLS II 5.2(iii). -/
theorem isPStar_pResidual_of_isChief (N : Subgroup G) (hN : ChiefFactor.IsChief N ⊥) :
    IsPStar p (pResidual p N) := by
  classical
  by_cases hab : IsMulCommutative N
  · let : IsMulCommutative N := hab
    let : CommGroup N := IsMulCommutative.instCommGroup
    exact isPStar_of_coprime_card (coprime_card_pResidual_of_commGroup (A := N) p)
  · let : N.Normal := hN.normal_upper
    have hstar : IsPStar p N := isPStar_of_componentLayer_eq_top (hN.componentLayer_eq_top hab)
    exact hstar.of_equiv ((MulEquiv.subgroupCongr hstar.1).trans Subgroup.topEquiv).symm
end Theory.GroupTheory
