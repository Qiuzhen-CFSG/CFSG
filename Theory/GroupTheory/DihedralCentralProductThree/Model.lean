module
public import Theory.GroupTheory.DihedralCentralProductSix.Presentation
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.Coset.Card
public import Mathlib.Algebra.BigOperators.Pi

/-!
# The explicit central product of three dihedral groups of order eight

The relation subgroup is generated by the two products of the first central
involution with each remaining central involution. Its elements have two free
binary coordinates; coordinate zero is their parity. Thus its order is 2² and
the quotient has order 2⁷. This concrete model is independent of any group to
be recognized. It supplies the D₈³ notation in Aschbacher–Smith 15.3.58(2), printed pp.1148–1149.
-/

namespace DihedralCentralProductThree
open DihedralGroup DihedralCentralProductSix
open scoped BigOperators

public abbrev D := Fin 3 → DihedralGroup 4
public abbrev Bit := Multiplicative (ZMod 2)

@[expose] public def c (i : Fin 3) : D := Pi.mulSingle i (r 2)
@[expose] public def relation (i : Fin 2) : D := c 0 * c i.succ
@[expose] public def Delta : Subgroup D := Subgroup.closure (Set.range relation)

public theorem r_two_square : (r 2 : DihedralGroup 4) ^ 2 = 1 := by decide
public theorem r_two_central : (r 2 : DihedralGroup 4) ∈ Subgroup.center _ := by
  rw [Subgroup.mem_center_iff]
  decide

public theorem c_central (i : Fin 3) : c i ∈ Subgroup.center D := by
  rw [Subgroup.mem_center_iff]
  intro x
  funext j
  by_cases h : j = i
  · subst j
    simpa [c] using Subgroup.mem_center_iff.mp r_two_central (x i)
  · simp [c, Pi.mulSingle_eq_of_ne h]

public theorem Delta_central : Delta ≤ Subgroup.center D := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  exact (Subgroup.center D).mul_mem (c_central 0) (c_central i.succ)

public instance Delta_normal : Delta.Normal := by
  constructor
  intro x hx y
  have h := Subgroup.mem_center_iff.mp (Delta_central hx) y
  simpa [h, mul_assoc] using hx

public abbrev Model := D ⧸ Delta

public noncomputable def bit : Bit →* DihedralGroup 4 := involutionMap (r 2) r_two_square

@[simp] public theorem bit_generator : bit (.ofAdd 1) = r 2 :=
  involutionMap_generator _ _

public theorem bit_injective : Function.Injective bit := by
  intro x y h
  simp only [bit, involutionMap_apply] at h
  exact (show Function.Injective (fun b : Bit => (r 2 : DihedralGroup 4) ^ b.toAdd.val) by decide) h

private theorem bit_cases (b : Bit) : b = 1 ∨ b = .ofAdd 1 := by
  exact (show ∀ b : Bit, b = 1 ∨ b = .ofAdd 1 by decide) b

/-- Two independent bits, with their parity in coordinate zero. -/
public noncomputable def deltaParam : (Fin 2 → Bit) →* D where
  toFun v := Fin.cases (bit (∏ i, v i)) (fun i => bit (v i))
  map_one' := by ext i; refine Fin.cases ?_ (fun j => ?_) i <;> simp
  map_mul' v w := by
    ext i
    refine Fin.cases ?_ (fun j => ?_) i <;> simp [Finset.prod_mul_distrib]

@[simp] public theorem deltaParam_zero (v : Fin 2 → Bit) :
    deltaParam v 0 = bit (∏ i, v i) := by rfl
@[simp] public theorem deltaParam_succ (v : Fin 2 → Bit) (i : Fin 2) :
    deltaParam v i.succ = bit (v i) := by rfl

public theorem deltaParam_injective : Function.Injective deltaParam := by
  intro v w h
  funext i
  apply bit_injective
  exact congrFun h i.succ

public theorem deltaParam_single (i : Fin 2) :
    deltaParam (Pi.mulSingle i (.ofAdd 1)) = relation i := by
  ext j
  refine Fin.cases ?_ (fun k => ?_) j
  · simp [relation, c, deltaParam_zero]
  · by_cases h : k = i
    · subst k; simp [relation, c]
    · simp [relation, c, h]

public theorem deltaParam_range : deltaParam.range = Delta := by
  apply le_antisymm
  · rintro _ ⟨v, rfl⟩
    apply Pi.mulSingle_induction (fun v => deltaParam v ∈ Delta) v
    · simp
    · intro v w hv hw
      simpa only [map_mul] using Delta.mul_mem hv hw
    · intro i b
      rcases bit_cases b with rfl | rfl
      · simp
      · rw [deltaParam_single]
        exact Subgroup.subset_closure ⟨i, rfl⟩
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨Pi.mulSingle i (.ofAdd 1), deltaParam_single i⟩

/-- Exact central-overlap coordinates: the two trailing bits determine the
first bit by parity. -/
public theorem mem_Delta_iff (x : D) : x ∈ Delta ↔
    ∃ v : Fin 2 → Bit, x 0 = bit (∏ i, v i) ∧ ∀ i, x i.succ = bit (v i) := by
  rw [← deltaParam_range]
  constructor
  · rintro ⟨v, rfl⟩
    exact ⟨v, rfl, fun _ => rfl⟩
  · rintro ⟨v, h0, hs⟩
    refine ⟨v, ?_⟩
    funext i
    exact Fin.cases h0.symm (fun j => (hs j).symm) i

public theorem Delta_card : Nat.card Delta = 2 ^ 2 := by
  rw [← deltaParam_range]
  rw [← Nat.card_congr (Equiv.ofBijective deltaParam.rangeRestrict
    ⟨fun _ _ h => deltaParam_injective (congrArg Subtype.val h),
      deltaParam.rangeRestrict_surjective⟩)]
  simp [Nat.card_eq_fintype_card, Bit]

public theorem D_card : Nat.card D = 2 ^ 9 := by
  simp [D, Nat.card_eq_fintype_card, DihedralGroup.card]

public theorem Model_card : Nat.card Model = 2 ^ 7 := by
  have h := Subgroup.card_eq_card_quotient_mul_card_subgroup Delta
  rw [D_card, Delta_card] at h
  change Nat.card (D ⧸ Delta) = 2 ^ 7
  omega

end DihedralCentralProductThree
