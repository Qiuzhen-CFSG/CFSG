module

public import Theory.GroupTheory.OddSubgroupLift
public import Theory.PGroupCore
public import Mathlib.GroupTheory.NoncommPiCoprod
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# Independent odd images and simultaneous splitting

If a finite group is generated by subgroups whose images are independent
and faithful, commutation modulo a normal subgroup in the action kernel
forces the kernel into that subgroup. In particular, if all the generators
have odd order and commute modulo the two-core, the kernel is a two-group.
Schur–Zassenhaus then gives one section of the entire odd image. Using one
section is what makes lifts of commuting image subgroups commute.

This is the extension argument underlying the direct-product step in
Aschbacher–Smith, *The Classification of Quasithin Groups*, E.6.25,
printed p.255. The local commutator calculation is a separate hypothesis.
-/

@[expose] public section

open Subgroup
open scoped IsMulCommutative commutatorElement

set_option backward.isDefEq.respectTransparency false

namespace MonoidHom

/-- An odd image splits through a two-group kernel. -/
theorem exists_section_of_two_kernel_odd_range
    {G H : Type*} [Group G] [Finite G] [Group H]
    (f : G →* H) (hk : IsPGroup 2 f.ker) (ho : Odd (Nat.card f.range)) :
    ∃ s : f.range →* G, f.rangeRestrict.comp s = MonoidHom.id _ := by
  let _ : Finite f.range := Finite.of_surjective f.rangeRestrict f.rangeRestrict_surjective
  let g := f.rangeRestrict
  have hgk : IsPGroup 2 g.ker := by
    have he : g.ker = f.ker := by ext x; exact Subtype.ext_iff
    exact he ▸ hk
  obtain ⟨D, hD, hi, _, _⟩ := g.exists_odd_subgroup_lift
    f.rangeRestrict_surjective hgk ⊤ (by simpa only [card_top] using ho)
  let d : D →* f.range := g.comp D.subtype
  have hd : Function.Surjective d := by
    intro b
    obtain ⟨a, ha, he⟩ := hD.symm ▸ (show b ∈ (⊤ : Subgroup f.range) from trivial)
    exact ⟨⟨a, ha⟩, he⟩
  let e := MulEquiv.ofBijective d ⟨hi, hd⟩
  refine ⟨D.subtype.comp e.symm.toMonoidHom, ?_⟩
  ext b
  exact congrArg Subtype.val (e.apply_symm_apply b)

/-- The image of a group generated by commuting odd images has odd order. -/
theorem odd_range_of_commuting_generators
    {G H ι : Type*} [Group G] [Finite G] [Group H] [Fintype ι]
    (f : G →* H) (A : ι → Subgroup G) (hgen : iSup A = ⊤)
    (ho : ∀ i, Odd (Nat.card (A i)))
    (hc : Pairwise fun i j => ∀ a : A i, ∀ b : A j, Commute (f a) (f b)) :
    Odd (Nat.card f.range) := by
  classical
  let φ (i) : A i →* H := f.comp (A i).subtype
  let t := MonoidHom.noncommPiCoprod φ hc
  have ht : t.range = f.range := by
    dsimp only [t]
    rw [MonoidHom.noncommPiCoprod_range]
    have hi (i) : (φ i).range = (A i).map f := by
      dsimp only [φ]
      rw [MonoidHom.range_comp, range_subtype]
    simp_rw [hi]
    rw [← map_iSup, hgen, ← MonoidHom.range_eq_map]
  have hodd : Odd (Nat.card (∀ i, A i)) := by
    rw [Nat.card_pi]
    exact Finset.prod_induction _ _ (fun _ _ ha hb => ha.mul hb) odd_one (fun i _ => ho i)
  rw [← ht]
  exact hodd.of_dvd_nat (Subgroup.card_range_dvd t)

end MonoidHom

namespace MonoidHom

/-- Independence makes the action kernel equal to a normal subgroup killing
all cross commutators. -/
theorem ker_le_of_independent_images
    {G H ι : Type*} [Group G] [Group H] [Fintype ι]
    (f : G →* H) (A : ι → Subgroup G) (hgen : iSup A = ⊤)
    (hind : iSupIndep fun i => (A i).map f)
    (hfaith : ∀ i, Function.Injective (f.comp (A i).subtype))
    (hc : Pairwise fun i j => ∀ a : A i, ∀ b : A j, Commute (f a) (f b))
    (N : Subgroup G) [N.Normal] (hN : N ≤ f.ker)
    (hcomm : Pairwise fun i j => ⁅A i, A j⁆ ≤ N) : f.ker ≤ N := by
  classical
  let φ (i) : A i →* H := f.comp (A i).subtype
  let q := QuotientGroup.mk' N
  let ψ (i) : A i →* (G ⧸ N) := q.comp (A i).subtype
  have hψ : Pairwise fun i j => ∀ a : A i, ∀ b : A j, Commute (ψ i a) (ψ j b) := by
    intro i j hij a b
    apply commutatorElement_eq_one_iff_mul_comm.mp
    change ⁅q (a : G), q (b : G)⁆ = 1
    rw [← map_commutatorElement]
    exact show ⁅(a : G), (b : G)⁆ ∈ q.ker from
      (QuotientGroup.ker_mk' N).symm ▸
        (hcomm hij (commutator_mem_commutator a.property b.property))
  let t := MonoidHom.noncommPiCoprod ψ hψ
  have ht : Function.Surjective t := by
    apply MonoidHom.range_eq_top.mp
    dsimp only [t]
    rw [MonoidHom.noncommPiCoprod_range]
    have hi (i) : (ψ i).range = (A i).map q := by
      dsimp only [φ, ψ]
      rw [MonoidHom.range_comp, range_subtype]
    simp_rw [hi]
    rw [← map_iSup, hgen, ← MonoidHom.range_eq_map]
    exact MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective N)
  let u := MonoidHom.noncommPiCoprod φ hc
  have hu : Function.Injective u := by
    apply MonoidHom.injective_noncommPiCoprod_of_iSupIndep φ _ hfaith
    have hi (i) : (φ i).range = (A i).map f := by
      dsimp only [φ, ψ]
      rw [MonoidHom.range_comp, range_subtype]
    simpa only [hi] using hind
  let fbar := QuotientGroup.lift N f hN
  have he : fbar.comp t = u := by
    apply MonoidHom.pi_ext
    intro i a
    change fbar (t (Pi.mulSingle i a)) = u (Pi.mulSingle i a)
    simp only [t, u, MonoidHom.noncommPiCoprod_mulSingle]
    rfl
  intro x hx
  obtain ⟨a, ha⟩ := ht (q x)
  have hua : u a = 1 := by
    rw [← he]
    change fbar (t a) = 1
    rw [ha]
    exact hx
  have ha1 : a = 1 := hu (by simpa only [map_one] using hua)
  have hqx : q x = 1 := by rw [← ha, ha1, map_one]
  exact (QuotientGroup.ker_mk' N) ▸ (show x ∈ q.ker from hqx)

end MonoidHom

namespace MonoidHom

/-- Independent odd images and commutation modulo the two-core force the
entire action kernel to be a two-group. -/
theorem isPGroup_ker_of_independent_images_commutators
    {G H ι : Type*} [Group G] [Finite G] [Group H] [Fintype ι]
    (f : G →* H) (A : ι → Subgroup G) (hgen : iSup A = ⊤)
    (hind : iSupIndep fun i => (A i).map f)
    (hfaith : ∀ i, Function.Injective (f.comp (A i).subtype))
    (hc : Pairwise fun i j => ∀ a : A i, ∀ b : A j, Commute (f a) (f b))
    (ho : ∀ i, Odd (Nat.card (A i)))
    (hcomm : Pairwise fun i j => ⁅A i, A j⁆ ≤ pCore 2 G) : IsPGroup 2 f.ker := by
  have hodd := f.odd_range_of_commuting_generators A hgen ho hc
  have hcore : pCore 2 G ≤ f.ker := by
    intro x hx
    obtain ⟨k, hk⟩ := (pCore_isPGroup (p := 2) (G := G)) ⟨x, hx⟩
    have hp : (f.rangeRestrict x) ^ (2 ^ k) = 1 := by
      have hxpow : x ^ (2 ^ k) = 1 := congrArg Subtype.val hk
      rw [← map_pow, hxpow, map_one]
    have he : f.rangeRestrict x = 1 := orderOf_eq_one_iff.mp
      (Nat.eq_one_of_dvd_coprimes (hodd.coprime_two_left.pow_left k)
        (orderOf_dvd_of_pow_eq_one hp) (orderOf_dvd_natCard _))
    exact congrArg Subtype.val he
  exact pCore_isPGroup.to_le
    (f.ker_le_of_independent_images A hgen hind hfaith hc (pCore 2 G) hcore hcomm)

end MonoidHom
