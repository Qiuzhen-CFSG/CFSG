module

public import Theory.ElementaryAbelian.Join
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.Index

/-!
# A quotient generated by two commuting factors of order two

Let `Z` be normal in a finite group generated by `Z`, `B`, and `C`. If `B`
and `C` are elementary abelian two-groups, their commutators lie in `Z`, and
their intersections with `Z` have relative index two, then the quotient by
`Z` is elementary abelian of order at most four. Centrality of `Z`, although
common in applications, is not needed beyond its normality.

The quotient images of `B` and `C` commute and generate the quotient. The
join theorem for elementary abelian groups therefore supplies exponent two
and commutativity. The kernel-relative-index formula gives each image order
two, and multiplication from their product onto the quotient gives the bound.

This is a source-neutral finite-group lemma used in the distance-four
central quotient calculation in Stellmacher, *Pushing up* (1986),
(3.3)(6) to (f), journal p.15.
-/

open scoped IsMulCommutative
namespace Subgroup

public theorem central_two_factor_quotient {G : Type*} [Group G] [Finite G]
    (Z B C : Subgroup G) [Z.Normal]
    [IsElementaryAbelian 2 B] [IsElementaryAbelian 2 C]
    (hgen : Z ⊔ B ⊔ C = ⊤) (hcomm : ⁅B, C⁆ ≤ Z)
    (hB : (B ⊓ Z).relIndex B = 2) (hC : (C ⊓ Z).relIndex C = 2) :
    Z.index ≤ 4 ∧ IsElementaryAbelian 2 (G ⧸ Z) := by
  let π := QuotientGroup.mk' Z
  let E := B.map π
  let F := C.map π
  have hπker : π.ker = Z := QuotientGroup.ker_mk' Z
  have hZmap : Z.map π = ⊥ := (map_eq_bot_iff Z).mpr hπker.ge
  have hEF : E ⊔ F = ⊤ := by
    have hm := congrArg (fun H : Subgroup G => H.map π) hgen
    simpa only [map_sup, hZmap, bot_sup_eq,
      map_top_of_surjective π (QuotientGroup.mk'_surjective Z)] using hm
  have hEFcomm : ⁅E, F⁆ = ⊥ := by
    rw [← map_commutator]
    exact (map_eq_bot_iff _).mpr (by simpa only [hπker] using hcomm)
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.map π
  let : IsElementaryAbelian 2 F := IsElementaryAbelian.map π
  have hel : IsElementaryAbelian 2 (E ⊔ F : Subgroup (G ⧸ Z)) :=
    by
      rw [sup_comm]
      exact IsElementaryAbelian.sup_of_le_centralizer
        (commutator_eq_bot_iff_le_centralizer.mp hEFcomm)
  let : IsElementaryAbelian 2 (⊤ : Subgroup (G ⧸ Z)) := hEF ▸ hel
  have hquot : IsElementaryAbelian 2 (G ⧸ Z) := {
    toIsMulCommutative := ⟨⟨fun x y => congrArg Subtype.val
      (mul_comm (⟨x, mem_top x⟩ : (⊤ : Subgroup (G ⧸ Z))) ⟨y, mem_top y⟩)⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr fun x =>
      elemPow_eq_one_of_isElementaryAbelian (A := (⊤ : Subgroup (G ⧸ Z))) x (mem_top x) }
  let := hquot
  have hEcard : Nat.card E = 2 := by
    rw [← relIndex_ker B π, hπker, ← inf_relIndex_left]
    exact hB
  have hFcard : Nat.card F = 2 := by
    rw [← relIndex_ker C π, hπker, ← inf_relIndex_left]
    exact hC
  have hsurj : Function.Surjective (fun t : E × F => (t.1 : G ⧸ Z) * t.2) := by
    intro x
    have hx : x ∈ E ⊔ F := hEF ▸ mem_top x
    obtain ⟨e, he, f, hf, hef⟩ := mem_sup_of_normal_left.mp hx
    exact ⟨(⟨e, he⟩, ⟨f, hf⟩), hef⟩
  refine ⟨?_, hquot⟩
  have hcard := Nat.card_le_card_of_surjective _ hsurj
  simpa only [Subgroup.index_eq_card, Nat.card_prod, hEcard, hFcard] using hcard
end Subgroup
