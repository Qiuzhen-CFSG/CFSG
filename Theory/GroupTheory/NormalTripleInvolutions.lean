module

public import Theory.GroupTheory.TwoInvolutionsSymmetricThree
public import Mathlib.Tactic

/-!
# A normal triple of pairwise noncommuting involutions

Three pairwise noncommuting involutions whose set is normalized by the ambient
finite group generate a copy of `S₃`.  This is the small normal configuration
used in the centered radius-one Goldschmidt argument. Conjugation by either
of the first two involutions sends the other to the third, giving the braid
relation and a product of order three. The third generator already lies in
the subgroup generated by the first two, so the existing dihedral recognition
applies.

Source: Goldschmidt, *Automorphisms of trivalent graphs* (1980), §6.8.
-/

open Subgroup

/-- A finite group generated by a normal set of three pairwise noncommuting
involutions has order six. -/
public theorem Subgroup.card_eq_six_of_normal_triple_involutions
    {Q : Type*} [Group Q] [Finite Q]
    (x : Fin 3 → Q)
    (hpow : ∀ i, x i ^ 2 = 1)
    (hgen : Subgroup.closure (Set.range x) = ⊤)
    (hnormal : ∀ (g : Q) (i : Fin 3), ∃ j : Fin 3, g * x i * g⁻¹ = x j)
    (hnc : ∀ i j : Fin 3, i ≠ j → ¬Commute (x i) (x j)) :
    Nat.card Q = 6 := by
  have hinv (i : Fin 3) : (x i)⁻¹ = x i := by
    exact inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hpow i)
  have hne (i j : Fin 3) (hij : i ≠ j) : x i ≠ x j := by
    intro h
    apply hnc i j hij
    simp [h]
  let a := x 0
  let b := x 1
  have ha : a ^ 2 = 1 := hpow 0
  have hb : b ^ 2 = 1 := hpow 1
  have hab_ne_comm : ¬Commute a b := by
    simpa [a, b] using hnc 0 1 (by decide)
  have hconj_injective (g u v : Q) (h : g * u * g⁻¹ = g * v * g⁻¹) : u = v := by
    simpa [mul_assoc] using congrArg (fun z => g⁻¹ * z * g) h
  have hconj_ne_left (i j : Fin 3) (hij : i ≠ j) :
      x i * x j * (x i)⁻¹ ≠ x i := by
    intro h
    apply hne j i hij.symm
    apply hconj_injective (x i)
    simpa using h
  have hconj_ne_right (i j : Fin 3) (hij : i ≠ j) :
      x i * x j * (x i)⁻¹ ≠ x j := by
    intro h
    apply hnc i j hij
    exact mul_inv_eq_iff_eq_mul.mp h
  have hconj_a_b : a * b * a⁻¹ = x 2 := by
    obtain ⟨j, hj⟩ := hnormal a 1
    fin_cases j
    · exact False.elim (hconj_ne_left 0 1 (by decide) hj)
    · exact False.elim (hconj_ne_right 0 1 (by decide) hj)
    · exact hj
  have hconj_b_a : b * a * b⁻¹ = x 2 := by
    obtain ⟨j, hj⟩ := hnormal b 0
    fin_cases j
    · exact False.elim (hconj_ne_right 1 0 (by decide) hj)
    · exact False.elim (hconj_ne_left 1 0 (by decide) hj)
    · exact hj
  have hbraid : a * b * a = b * a * b := by
    simpa only [a, b, hinv] using hconj_a_b.trans hconj_b_a.symm
  have haa : a * a = 1 := by simpa only [pow_two] using ha
  have hbb : b * b = 1 := by simpa only [pow_two] using hb
  have habpow : (a * b) ^ 3 = 1 := by
    calc
      (a * b) ^ 3 = (a * b * a) * (b * a * b) := by simp only [pow_succ, pow_zero, one_mul, mul_assoc]
      _ = (b * a * b) * (b * a * b) := by rw [hbraid]
      _ = b * a * (b * b) * a * b := by simp only [mul_assoc]
      _ = b * (a * a) * b := by rw [hbb, mul_one]; simp only [mul_assoc]
      _ = 1 := by rw [haa, mul_one, hbb]
  have hab_order : orderOf (a * b) = 3 := by
    apply orderOf_eq_prime habpow
    intro hab_one
    apply hab_ne_comm
    have he : a = b⁻¹ := mul_eq_one_iff_eq_inv.mp hab_one
    have : a = b := by simpa only [b, hinv] using he
    simp [this]
  let P : Subgroup Q := zpowers a ⊔ zpowers b
  have haP : a ∈ P := mem_sup_left (mem_zpowers a)
  have hbP : b ∈ P := mem_sup_right (mem_zpowers b)
  have hcP : x 2 ∈ P := by
    rw [← hconj_a_b]
    exact P.mul_mem (P.mul_mem haP hbP) (P.inv_mem haP)
  have hcl : Subgroup.closure (Set.range x) ≤ P := by
    apply (Subgroup.closure_le P).2
    rintro y ⟨i, rfl⟩
    fin_cases i
    · exact haP
    · exact hbP
    · exact hcP
  have htop : (⊤ : Subgroup Q) ≤ P := by simpa [hgen] using hcl
  have hPtop : P = ⊤ := top_unique htop
  obtain ⟨e⟩ := Subgroup.symmetricThree_of_involutions_product_three a b ha hb hab_order
  have hPcard : Nat.card P = 6 := by
    have heq := Nat.card_congr e.toEquiv
    simpa [P, Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial] using heq
  rw [hPtop] at hPcard
  simpa using hPcard
