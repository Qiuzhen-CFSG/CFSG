module

public import Theory.GroupTheory.MarkedInternalProduct
public import Theory.GroupTheory.DisjointCommutingProduct
public import Mathlib.GroupTheory.Commutator.Basic
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Splitting a pair of quotient-coordinate subgroups

If a homomorphism to a direct product has kernel generated by two disjoint
kernel layers, and two subgroups lift the two quotient coordinates with the
opposite kernel intersections, then the two lifted subgroups generate the
ambient group.  Commuting lifts therefore give an actual internal direct
product.  This is the quotient-level assembly used for the two Baumann
factors in the paired S₅ source.
-/

public section
open Subgroup
namespace Theory.GroupTheory

open Subgroup

variable {R X Y : Type*} [Group R] [Group X] [Group Y]

/-- Quotient-coordinate lifts form an internal direct product. -/
theorem exists_quotient_pair_directProduct
    (q : R →* X × Y) (C₁ C₂ K₁ K₂ : Subgroup R)
    (hker : q.ker = K₁ ⊔ K₂)
    (himg₁ : C₁.map q = (⊤ : Subgroup X).prod ⊥)
    (himg₂ : C₂.map q = (⊥ : Subgroup X).prod ⊤)
    (hint₁ : C₁ ⊓ q.ker = K₂)
    (hint₂ : C₂ ⊓ q.ker = K₁)
    (hKdisj : Disjoint K₁ K₂)
    (hcomm : C₁ ≤ centralizer (C₂ : Set R)) :
    Nonempty (R ≃* C₁ × C₂) := by
  have hK₁C₂ : K₁ ≤ C₂ := by
    rw [← hint₂]
    exact inf_le_left
  have hK₂C₁ : K₂ ≤ C₁ := by
    rw [← hint₁]
    exact inf_le_left
  have hKsup : K₁ ⊔ K₂ ≤ C₁ ⊔ C₂ :=
    sup_le (hK₁C₂.trans le_sup_right) (hK₂C₁.trans le_sup_left)
  have hkerJoin : q.ker ≤ C₁ ⊔ C₂ := hker ▸ hKsup
  have hgen : C₁ ⊔ C₂ = ⊤ := by
    apply top_unique
    intro r hr
    have hm₁ : ((q r).1, 1) ∈ C₁.map q := by
      rw [himg₁]
      rw [mem_prod]
      exact ⟨by simp, by simp⟩
    have hm₂ : (1, (q r).2) ∈ C₂.map q := by
      rw [himg₂]
      rw [mem_prod]
      exact ⟨by simp, by simp⟩
    obtain ⟨c₁, hc₁, hqc₁⟩ := (mem_map.mp hm₁)
    obtain ⟨c₂, hc₂, hqc₂⟩ := (mem_map.mp hm₂)
    have hqprod : q (c₁ * c₂) = q r := by
      rw [map_mul, hqc₁, hqc₂]
      ext <;> simp
    let z := r * (c₁ * c₂)⁻¹
    have hzker : z ∈ q.ker := by
      rw [MonoidHom.mem_ker]
      dsimp [z]
      rw [map_mul, map_inv, hqprod]
      simp
    have hz : z ∈ C₁ ⊔ C₂ := hkerJoin hzker
    have hc₁' : c₁ ∈ C₁ ⊔ C₂ := (show C₁ ≤ C₁ ⊔ C₂ from le_sup_left) hc₁
    have hc₂' : c₂ ∈ C₁ ⊔ C₂ := (show C₂ ≤ C₁ ⊔ C₂ from le_sup_right) hc₂
    have hc : c₁ * c₂ ∈ C₁ ⊔ C₂ := (C₁ ⊔ C₂).mul_mem hc₁' hc₂'
    have hr' : r = z * (c₁ * c₂) := by
      dsimp [z]
      simp [mul_assoc]
    rw [hr']
    exact (C₁ ⊔ C₂).mul_mem hz hc
  have hCdisj : Disjoint C₁ C₂ := by
    apply Subgroup.disjoint_def.mpr
    intro x hx₁ hx₂
    have hm₁ : q x ∈ (⊤ : Subgroup X).prod (⊥ : Subgroup Y) := by
      rw [← himg₁]
      exact mem_map_of_mem q hx₁
    have hm₂ : q x ∈ (⊥ : Subgroup X).prod (⊤ : Subgroup Y) := by
      rw [← himg₂]
      exact mem_map_of_mem q hx₂
    have hx₂q : (q x).2 = 1 := (mem_prod.mp hm₁).2
    have hx₁q : (q x).1 = 1 := (mem_prod.mp hm₂).1
    have hxker : x ∈ q.ker := MonoidHom.mem_ker.mpr (Prod.ext hx₁q hx₂q)
    have hxK₂ : x ∈ K₂ := by
      rw [← hint₁]
      exact ⟨hx₁, hxker⟩
    have hxK₁ : x ∈ K₁ := by
      rw [← hint₂]
      exact ⟨hx₂, hxker⟩
    exact Subgroup.disjoint_def.mp hKdisj hxK₁ hxK₂
  obtain ⟨f, hf⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting C₁ C₂ hCdisj hcomm
  let g : C₁ × C₂ ≃* R :=
    f.trans ((MulEquiv.subgroupCongr hgen).trans Subgroup.topEquiv)
  exact ⟨g.symm⟩

end Theory.GroupTheory

namespace Theory.GroupTheory

open Subgroup

variable {G H K : Type*} [Group G] [Group H] [Group K]

/-- Mapping a subgroup through a homomorphism cod-restricted to a containing
subgroup is the corresponding ambient image viewed inside that subgroup. -/
theorem map_codRestrict_subgroupOf_map
    (q : G →* H) (Y : Subgroup H) (P : Subgroup G)
    (hP : P.map q ≤ Y) :
    (⊤ : Subgroup P).map ((q.comp P.subtype).codRestrict Y
      (fun p => hP (mem_map_of_mem q p.property))) =
      (P.map q).subgroupOf Y := by
  ext y
  constructor
  · rintro ⟨p, hp, rfl⟩
    rw [Subgroup.mem_subgroupOf]
    exact mem_map_of_mem q p.property
  · intro hy
    rw [Subgroup.mem_subgroupOf] at hy
    obtain ⟨p, hp, hqp⟩ := hy
    refine ⟨⟨p, hp⟩, mem_top _, ?_⟩
    exact Subtype.ext hqp

end Theory.GroupTheory

namespace Theory.GroupTheory

open Subgroup

variable {G H : Type*} [Group G] [Group H]

/-- The image of a subgroup-of through a cod-restricted quotient map is the
corresponding ambient image viewed inside the codomain subgroup. -/
theorem map_subgroupOf_comp_codRestrict
    (q : G →* H) (Y : Subgroup H) (P R : Subgroup G)
    (hPR : P ≤ R) (hR : R.map q ≤ Y) :
    (P.subgroupOf R).map ((q.comp R.subtype).codRestrict Y
      (fun r => hR (mem_map_of_mem q (show (r : G) ∈ R from r.property)))) =
      (P.map q).subgroupOf Y := by
  ext y
  constructor
  · rintro ⟨r, hr, rfl⟩
    rw [Subgroup.mem_subgroupOf]
    exact mem_map_of_mem q (show (r : G) ∈ P from Subgroup.mem_subgroupOf.mp hr)
  · intro hy
    rw [Subgroup.mem_subgroupOf] at hy
    obtain ⟨x, hx, hqx⟩ := hy
    let xr : R := ⟨x, hPR hx⟩
    refine ⟨xr, ?_, ?_⟩
    · exact (Subgroup.mem_subgroupOf).mpr hx
    · exact Subtype.ext hqx

end Theory.GroupTheory


namespace Theory.GroupTheory

open Subgroup

variable {Q X : Type*} [Group Q] [Group X]

/-- A subgroup transported into a subgroup domain and then through the marked
equivalence maps back to the original coordinate subgroup. -/
theorem map_subgroupOf_equiv_of_map_subtype
    (Y : Subgroup Q) (e : Y ≃* X) (K : Subgroup X) :
    ((K.map (Y.subtype.comp e.symm.toMonoidHom)).subgroupOf Y).map e.toMonoidHom = K := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    have hy' : (y : Q) ∈ K.map (Y.subtype.comp e.symm.toMonoidHom) := hy
    obtain ⟨k, hk, hky⟩ := mem_map.mp hy'
    have heq := congrArg e.toMonoidHom (Subtype.ext hky)
    rw [← heq]
    simpa using hk
  · intro hx
    refine ⟨e.symm x, ?_, ?_⟩
    · change (e.symm x : Q) ∈ K.map (Y.subtype.comp e.symm.toMonoidHom)
      exact mem_map_of_mem (Y.subtype.comp e.symm.toMonoidHom) hx
    · simp

end Theory.GroupTheory


namespace Theory.GroupTheory

open Subgroup

variable {R X Y : Type*} [Group R] [Group X] [Group Y]

/-- Variant for a quotient whose image is contained in prescribed factor
subgroups.  This is useful when the ambient quotient is a larger symmetric
group but the subgroup under consideration has only the two transposition
four-group coordinates. -/
theorem exists_quotient_pair_directProduct_of_factors
    (q : R →* X × Y) (C₁ C₂ K₁ K₂ : Subgroup R)
    (F₁ : Subgroup X) (F₂ : Subgroup Y)
    (himage : ∀ r : R, q r ∈ F₁.prod F₂)
    (hker : q.ker = K₁ ⊔ K₂)
    (himg₁ : C₁.map q = F₁.prod ⊥)
    (himg₂ : C₂.map q = (⊥ : Subgroup X).prod F₂)
    (hint₁ : C₁ ⊓ q.ker = K₂)
    (hint₂ : C₂ ⊓ q.ker = K₁)
    (hKdisj : Disjoint K₁ K₂)
    (hcomm : C₁ ≤ centralizer (C₂ : Set R)) :
    Nonempty (R ≃* C₁ × C₂) := by
  have hK₁C₂ : K₁ ≤ C₂ := by
    rw [← hint₂]
    exact inf_le_left
  have hK₂C₁ : K₂ ≤ C₁ := by
    rw [← hint₁]
    exact inf_le_left
  have hKsup : K₁ ⊔ K₂ ≤ C₁ ⊔ C₂ :=
    sup_le (hK₁C₂.trans le_sup_right) (hK₂C₁.trans le_sup_left)
  have hkerJoin : q.ker ≤ C₁ ⊔ C₂ := hker ▸ hKsup
  have hgen : C₁ ⊔ C₂ = ⊤ := by
    apply top_unique
    intro r hr
    obtain ⟨hr₁, hr₂⟩ := mem_prod.mp (himage r)
    have hm₁ : ((q r).1, 1) ∈ C₁.map q := by
      rw [himg₁]
      rw [mem_prod]
      exact ⟨hr₁, by simp⟩
    have hm₂ : (1, (q r).2) ∈ C₂.map q := by
      rw [himg₂]
      rw [mem_prod]
      exact ⟨by simp, hr₂⟩
    obtain ⟨c₁, hc₁, hqc₁⟩ := mem_map.mp hm₁
    obtain ⟨c₂, hc₂, hqc₂⟩ := mem_map.mp hm₂
    have hqprod : q (c₁ * c₂) = q r := by
      rw [map_mul, hqc₁, hqc₂]
      ext <;> simp
    let z := r * (c₁ * c₂)⁻¹
    have hzker : z ∈ q.ker := by
      rw [MonoidHom.mem_ker]
      dsimp [z]
      rw [map_mul, map_inv, hqprod]
      simp
    have hz : z ∈ C₁ ⊔ C₂ := hkerJoin hzker
    have hc₁' : c₁ ∈ C₁ ⊔ C₂ :=
      (show C₁ ≤ C₁ ⊔ C₂ from le_sup_left) hc₁
    have hc₂' : c₂ ∈ C₁ ⊔ C₂ :=
      (show C₂ ≤ C₁ ⊔ C₂ from le_sup_right) hc₂
    have hc : c₁ * c₂ ∈ C₁ ⊔ C₂ := (C₁ ⊔ C₂).mul_mem hc₁' hc₂'
    have hr' : r = z * (c₁ * c₂) := by
      dsimp [z]
      simp [mul_assoc]
    rw [hr']
    exact (C₁ ⊔ C₂).mul_mem hz hc
  have hCdisj : Disjoint C₁ C₂ := by
    apply Subgroup.disjoint_def.mpr
    intro x hx₁ hx₂
    have hm₁ : q x ∈ F₁.prod (⊥ : Subgroup Y) := by
      rw [← himg₁]
      exact mem_map_of_mem q hx₁
    have hm₂ : q x ∈ (⊥ : Subgroup X).prod F₂ := by
      rw [← himg₂]
      exact mem_map_of_mem q hx₂
    have hx₂q : (q x).2 = 1 := (mem_prod.mp hm₁).2
    have hx₁q : (q x).1 = 1 := (mem_prod.mp hm₂).1
    have hxker : x ∈ q.ker := MonoidHom.mem_ker.mpr (Prod.ext hx₁q hx₂q)
    have hxK₂ : x ∈ K₂ := by
      rw [← hint₁]
      exact ⟨hx₁, hxker⟩
    have hxK₁ : x ∈ K₁ := by
      rw [← hint₂]
      exact ⟨hx₂, hxker⟩
    exact Subgroup.disjoint_def.mp hKdisj hxK₁ hxK₂
  obtain ⟨f, hf⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting C₁ C₂ hCdisj hcomm
  let g : C₁ × C₂ ≃* R :=
    f.trans ((MulEquiv.subgroupCongr hgen).trans Subgroup.topEquiv)
  exact ⟨g.symm⟩

end Theory.GroupTheory



namespace Theory.GroupTheory

open Subgroup
open scoped commutatorElement

variable {G : Type*} [Group G]

/-- Two restricted centralizers commute when each normalizes the opposite pair
and the pair has trivial joint centralizer. -/
theorem inf_centralizer_pair_commutes
    (R A B : Subgroup G)
    (hRA : R ≤ normalizer (A : Set G))
    (hRB : R ≤ normalizer (B : Set G))
    (hjoint : centralizer ((A ⊔ B : Subgroup G) : Set G) = ⊥) :
    R ⊓ centralizer (B : Set G) ≤
      centralizer ((R ⊓ centralizer (A : Set G) : Subgroup G) : Set G) := by
  intro x hx
  rw [mem_centralizer_iff]
  intro y hy
  rcases hx with ⟨hxR, hxB⟩
  rcases hy with ⟨hyR, hyA⟩
  have hxyA : ⁅x,y⁆ ∈ centralizer (A : Set G) := by
    rw [mem_centralizer_iff]
    intro a ha
    have hxa : x⁻¹ * a * x ∈ A := by
      have hiff := (mem_normalizer_iff.mp ((normalizer (A : Set G)).inv_mem (hRA hxR))) a
      simpa only [inv_inv] using hiff.mp ha
    have hya := (mem_centralizer_iff.mp hyA) (x⁻¹ * a * x) hxa
    have hya0 := (mem_centralizer_iff.mp hyA) a ha
    have hya0i := (mem_centralizer_iff.mp ((centralizer (A : Set G)).inv_mem hyA)) a ha
    rw [commutatorElement_def]
    calc
      a * (x * y * x⁻¹ * y⁻¹) =
          x * (x⁻¹ * a * x) * y * x⁻¹ * y⁻¹ := by group
      _ = x * ((x⁻¹ * a * x) * y) * x⁻¹ * y⁻¹ := by simp [mul_assoc]
      _ = x * (y * (x⁻¹ * a * x)) * x⁻¹ * y⁻¹ := by rw [hya]
      _ = x * y * (x⁻¹ * a * x) * x⁻¹ * y⁻¹ := by simp [mul_assoc]
      _ = x * y * x⁻¹ * a * y⁻¹ := by group
      _ = x * y * x⁻¹ * (a * y⁻¹) := by simp [mul_assoc]
      _ = x * y * x⁻¹ * (y⁻¹ * a) := by rw [hya0i]
      _ = (x * y * x⁻¹ * y⁻¹) * a := by group
  have hxyB : ⁅x,y⁆ ∈ centralizer (B : Set G) := by
    rw [mem_centralizer_iff]
    intro b hb
    have hyb : y⁻¹ * b * y ∈ B := by
      have hiff := (mem_normalizer_iff.mp ((normalizer (B : Set G)).inv_mem (hRB hyR))) b
      simpa only [inv_inv] using hiff.mp hb
    have hxb0 := (mem_centralizer_iff.mp hxB) b hb
    rw [commutatorElement_def]
    symm
    calc
      (x * y * x⁻¹ * y⁻¹) * b =
          x * y * x⁻¹ * (y⁻¹ * b * y) * y⁻¹ := by group
      _ = x * y * (x⁻¹ * (y⁻¹ * b * y)) * y⁻¹ := by simp [mul_assoc]
      _ = x * y * ((y⁻¹ * b * y) * x⁻¹) * y⁻¹ := by
        have hi : x⁻¹ * (y⁻¹ * b * y) = (y⁻¹ * b * y) * x⁻¹ := by
          have hxi := (mem_centralizer_iff.mp ((centralizer (B : Set G)).inv_mem hxB))
            (y⁻¹ * b * y) hyb
          exact hxi.symm
        rw [hi]
      _ = x * y * (y⁻¹ * b * y) * x⁻¹ * y⁻¹ := by simp [mul_assoc]
      _ = x * b * y * x⁻¹ * y⁻¹ := by group
      _ = b * (x * y * x⁻¹ * y⁻¹) := by
        rw [← hxb0]
        group
  have hxyC : ⁅x,y⁆ ∈ centralizer ((A ⊔ B : Subgroup G) : Set G) := by
    have hcent : centralizer (A : Set G) ⊓ centralizer (B : Set G) ≤
        centralizer ((A ⊔ B : Subgroup G) : Set G) := by
      apply le_centralizer_iff.mpr
      exact sup_le (le_centralizer_iff.mp inf_le_left)
        (le_centralizer_iff.mp inf_le_right)
    exact hcent ⟨hxyA,hxyB⟩
  have hxy1 : ⁅x,y⁆ = 1 := by
    have : ⁅x,y⁆ ∈ (⊥ : Subgroup G) := by rw [← hjoint]; exact hxyC
    exact mem_bot.mp this
  have hxy_eq : x * y * x⁻¹ * y⁻¹ = 1 := by
    simpa only [commutatorElement_def] using hxy1
  calc
    y * x = 1 * (y * x) := by simp
    _ = (x * y * x⁻¹ * y⁻¹) * (y * x) := by rw [hxy_eq]
    _ = x * y := by group

end Theory.GroupTheory

namespace Theory.GroupTheory

open Subgroup

variable {G : Type*} [Group G]

/-- The two kernel layers are disjoint when each lies in its marked factor and
the opposite centralizer, while the marked pair has trivial joint centralizer. -/
theorem disjoint_of_pair_centralizer_layers
    (A B K₁ K₂ : Subgroup G)
    (hK₁B : K₁ ≤ centralizer (B : Set G))
    (hK₂A : K₂ ≤ centralizer (A : Set G))
    (hjoint : centralizer ((A ⊔ B : Subgroup G) : Set G) = ⊥) :
    Disjoint K₁ K₂ := by
  apply Subgroup.disjoint_def.mpr
  intro x hx₁ hx₂
  have hA : A ≤ centralizer ({x} : Set G) := by
    intro a ha
    rw [mem_centralizer_singleton_iff]
    exact (mem_centralizer_iff.mp (hK₂A hx₂)) a ha
  have hB : B ≤ centralizer ({x} : Set G) := by
    intro b hb
    rw [mem_centralizer_singleton_iff]
    exact (mem_centralizer_iff.mp (hK₁B hx₁)) b hb
  have hsup : A ⊔ B ≤ centralizer ({x} : Set G) := sup_le hA hB
  have hxcent : x ∈ centralizer ((A ⊔ B : Subgroup G) : Set G) := by
    rw [mem_centralizer_iff]
    intro y hy
    exact mem_centralizer_singleton_iff.mp (hsup hy)
  have : x ∈ (⊥ : Subgroup G) := by rw [← hjoint]; exact hxcent
  exact mem_bot.mp this

end Theory.GroupTheory
