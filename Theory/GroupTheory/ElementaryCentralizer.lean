module

public import Mathlib.GroupTheory.Nilpotent

/-!
# An elementary subgroup of an element centralizer

For a p-regular element s of a finite group, its centralizer contains a
nilpotent subgroup H of index prime to p, with a homomorphism to the cyclic
subgroup generated by s that fixes every p-regular element of H.

Take a Sylow p-subgroup S of the centralizer. Multiplication embeds the direct
product of S and the cyclic subgroup generated by s: its kernel is trivial
because the factors have coprime element orders. Projection to the cyclic
factor gives the required homomorphism. The product is nilpotent, and its
index in the centralizer divides the Sylow index.

Source: Serre, *Linear Representations of Finite Groups*, Chapter 10,
the local proof of Brauer induction.
-/

open scoped IsMulCommutative

namespace Subgroup

/-- A p-regular element lies in a nilpotent subgroup of its centralizer whose
relative index is prime to p and whose cyclic projection fixes p-regular elements. -/
public theorem exists_nilpotent_centralizer_retraction
    {G : Type*} [Group G] [Fintype G]
    (p : ℕ) (hp : p.Prime) (s : G) (hs : ¬ p ∣ orderOf s) :
    ∃ (H : Subgroup G) (r : H →* Subgroup.zpowers s),
      Group.IsNilpotent H ∧ H ≤ Subgroup.centralizer ({s} : Set G) ∧ s ∈ H ∧
      (∀ x : H, ¬ p ∣ orderOf (x : G) → (r x : G) = (x : G)) ∧
      ¬ p ∣ H.relIndex (Subgroup.centralizer ({s} : Set G)) := by
  classical
  let : Fact p.Prime := ⟨hp⟩
  let C := centralizer ({s} : Set G)
  let S : Sylow p C := Classical.choice inferInstance
  let A := zpowers s
  have hAC : A ≤ C := zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl)
  have hcomm (a : S) (b : A) : Commute ((a : C) : G) (b : G) := by
    obtain ⟨n, hn⟩ := b.property
    rw [← hn]
    exact (show Commute ((a : C) : G) s from
      mem_centralizer_singleton_iff.mp (a : C).property).zpow_right n
  let f : S × A →* G := {
    toFun := fun x => ((x.1 : C) : G) * (x.2 : G)
    map_one' := by simp
    map_mul' := by
      intro x y
      change ((x.1 : G) * (y.1 : G)) * ((x.2 : G) * (y.2 : G)) =
        ((x.1 : G) * (x.2 : G)) * ((y.1 : G) * (y.2 : G))
      simpa only [mul_assoc] using
        congrArg (fun z : G => (x.1 : G) * z * (y.2 : G)) (hcomm y.1 x.2).eq
  }
  have hf : Function.Injective f := by
    apply (injective_iff_map_eq_one f).mpr
    rintro ⟨a, b⟩ hab
    have heq : ((a : C) : G) = (b : G)⁻¹ := mul_eq_one_iff_eq_inv.mp hab
    have ha : a = 1 := by
      by_contra hne
      have hpa : p ∣ orderOf ((a : C) : G) := by
        simpa only [orderOf_coe] using S.isPGroup'.dvd_orderOf hne
      rw [heq, orderOf_inv] at hpa
      exact hs (hpa.trans (orderOf_dvd_of_mem_zpowers b.property))
    have hb : b = 1 := by
      apply Subtype.ext
      simpa only [f, MonoidHom.coe_mk, OneHom.coe_mk, ha,
        OneMemClass.coe_one, one_mul] using hab
    exact Prod.ext ha hb
  let e : S × A ≃* f.range := MonoidHom.ofInjective hf
  let r : f.range →* A := (MonoidHom.snd S A).comp e.symm.toMonoidHom
  have : Group.IsNilpotent S := S.isPGroup'.isNilpotent
  have : Group.IsNilpotent A := inferInstance
  refine ⟨f.range, r, Group.nilpotent_of_mulEquiv e, ?_, ?_, ?_, ?_⟩
  · rintro x ⟨⟨a, b⟩, rfl⟩
    exact C.mul_mem (a : C).property (hAC b.property)
  · exact ⟨(1, ⟨s, mem_zpowers s⟩), by simp [f]⟩
  · intro x hx
    let k : f.range →* S := (MonoidHom.fst S A).comp e.symm.toMonoidHom
    have hk : k x = 1 := by
      by_contra hne
      apply hx
      have hd := (S.isPGroup'.dvd_orderOf hne).trans (orderOf_map_dvd k x)
      simpa only [orderOf_coe] using hd
    have he := MonoidHom.apply_ofInjective_symm hf x
    change ((k x : C) : G) * (r x : G) = (x : G) at he
    simpa only [hk, OneMemClass.coe_one, one_mul] using he
  · let P : Subgroup G := (S : Subgroup C).map C.subtype
    have hP : P ≤ f.range := by
      rintro x ⟨a, ha, rfl⟩
      exact ⟨(⟨a, ha⟩, 1), by simp [f]⟩
    have hi : P.relIndex C = (S : Subgroup C).index := by
      have he := relIndex_map_map_of_injective (S : Subgroup C) (⊤ : Subgroup C)
        C.subtype_injective
      simpa only [← MonoidHom.range_eq_map, C.range_subtype, relIndex_top_right] using he
    intro hd
    apply S.not_dvd_index
    rw [← hi]
    exact hd.trans (relIndex_dvd_of_le_left C hP)
end Subgroup
