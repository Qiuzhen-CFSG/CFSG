/-!
# Point centralizers from a fixed supplement

Let an elementary abelian two-group V be the product QU. If x fixes U and
x² fixes V, absence of a nonidentity Q-point fixed by x forces every
x-displacement on V to lie in U. This is the elementary algebra used in
Aschbacher–Smith 10.2.12, printed p.754, before applying the faithful action
of the original A₅ quotient on the moved factor modulo its fixed part.
No invariance of Q is required.

A finite perfect group normalizing a nontrivial finite two-group is also
generated by its point centralizers on that group: their generated subgroup
is normal in the actor and contains a Sylow two-subgroup, by the p-group
fixed-point theorem. The perfect odd-index normalizer theorem then applies.
-/

public section
open Subgroup
open scoped commutatorElement IsMulCommutative
namespace Theory.GroupTheory
variable {G : Type*} [Group G]

/-- With a fixed supplement, a quadratic actor either fixes a nonidentity
point in Q or has all its displacements in the fixed supplement. -/
theorem displacement_mem_of_no_fixed_supplement
    (V Q U : Subgroup G) [IsElementaryAbelian 2 V]
    (hdecomp : ∀ v ∈ V, ∃ q ∈ Q, ∃ u ∈ U, q * u = v)
    (x : G) (hxV : x ∈ normalizer (V : Set G))
    (hUfix : ∀ u ∈ U, x * u = u * x)
    (hsq : ∀ v ∈ V, (x * x) * v = v * (x * x))
    (hno : ∀ q ∈ Q, x * q = q * x → q = 1) :
    ∀ v ∈ V, ⁅x,v⁆ ∈ U := by
  intro v hv
  let d := ⁅x,v⁆
  have hfv : x * v * x⁻¹ ∈ V := (mem_normalizer_iff.mp hxV v).mp hv
  have hd : d ∈ V := V.mul_mem hfv (V.inv_mem hv)
  have hinv : ∀ z ∈ V, z⁻¹ = z := by
    intro z hz
    have he' : z * z = 1 := by
      simpa only [pow_two] using (elemPow_eq_one_of_isElementaryAbelian (p := 2) z hz)
    exact inv_eq_of_mul_eq_one_right he'
  have hdouble : x * (x * v * x⁻¹) * x⁻¹ = v := by
    calc
      _ = (x*x)*v*(x*x)⁻¹ := by group
      _ = v := by rw [hsq v hv]; group
  have hdfix : x * d = d * x := by
    have he : x * d * x⁻¹ = d := by
      dsimp [d]
      change x * (x*v*x⁻¹*v⁻¹) * x⁻¹ = x*v*x⁻¹*v⁻¹
      calc
        _ = (x*(x*v*x⁻¹)*x⁻¹) * (x*v*x⁻¹)⁻¹ := by group
        _ = v * (x*v*x⁻¹) := by rw [hdouble, hinv _ hfv]
        _ = (x*v*x⁻¹) * v := by exact (setLike_mul_comm hv hfv)
        _ = _ := by rw [hinv v hv]
    exact mul_inv_eq_iff_eq_mul.mp he
  obtain ⟨q,hq,u,hu,he⟩ := hdecomp d hd
  have hqfix : x*q=q*x := by
    apply mul_right_cancel (b := u)
    calc
      x*q*u = x*(q*u) := by group
      _ = x*d := by rw [he]
      _ = d*x := hdfix
      _ = (q*u)*x := by rw [he]
      _ = q*x*u := by rw [mul_assoc, ←hUfix u hu, ←mul_assoc]
  have hq1 := hno q hq hqfix
  rw [hq1,one_mul] at he
  change d ∈ U
  exact he ▸ hu


/-- In a group surjecting onto a finite simple even-order group, all lifts
whose image squares to one generate the whole group. -/
theorem eq_top_of_square_one_lifts
    {A B : Type*} [Group A] [Group B] [Finite B] [IsSimpleGroup B]
    (f : A →* B) (hf : Function.Surjective f) (heven : 2 ∣ Nat.card B)
    (N : Subgroup A) (hN : ∀ x : A, f x ^ 2 = 1 → x ∈ N) : N = ⊤ := by
  classical
  let I : Subgroup B := closure {b : B | b ^ 2 = 1}
  have hInorm : I.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    apply le_normalizer_closure_iff.mpr
    intro b _ a ha
    apply Subgroup.subset_closure
    change (b*a*b⁻¹)^2=1
    calc
      (b*a*b⁻¹)^2 = b*(a^2)*b⁻¹ := by simp only [pow_two]; group
      _ = 1 := by rw [ha]; simp
  let := hInorm
  have hItop : I = ⊤ := by
    apply hInorm.eq_bot_or_eq_top.resolve_left
    intro hbot
    obtain ⟨b,hb⟩ := exists_prime_orderOf_dvd_card' (G := B) 2 heven
    have hbI : b ∈ I := Subgroup.subset_closure (by
      change b^2=1
      rw [←hb]
      exact pow_orderOf_eq_one b)
    have hb1 : b=1 := by simpa only [hbot,mem_bot] using hbI
    rw [hb1, orderOf_one] at hb
    omega
  have hImap : I ≤ N.map f := by
    apply (closure_le _).mpr
    intro b hb
    obtain ⟨x,rfl⟩ := hf b
    exact mem_map.mpr ⟨x,hN x hb,rfl⟩
  have hmap : N.map f = ⊤ := top_unique (hItop ▸ hImap)
  have hker : f.ker ≤ N := by
    intro x hx
    exact hN x (by rw [MonoidHom.mem_ker.mp hx]; simp)
  have hs : N ⊔ f.ker = ⊤ := by
    rw [←comap_map_eq,hmap,comap_top]
  rwa [sup_eq_left.mpr hker] at hs

variable [Finite G]

private def pointCentralizerGenerators (L W : Subgroup G) : Set G :=
  {x | ∃ w : W, (w : G) ≠ 1 ∧ x ∈ L ⊓ centralizer ({(w : G)} : Set G)}

/-- A perfect finite actor is generated modulo any target by its point
centralizers on a nontrivial normalized finite two-group. -/
theorem le_of_point_centralizers
    (L W N : Subgroup G) [Group.IsPerfect L]
    (hLW : L ≤ normalizer (W : Set G))
    (hW : IsPGroup 2 W) (hWne : W ≠ ⊥)
    (hcent : ∀ w ∈ W, w ≠ 1 → centralizer ({w} : Set G) ≤ N) :
    L ≤ N := by
  classical
  let S : Set G := pointCentralizerGenerators L W
  let K : Subgroup G := closure S
  have hKN : K ≤ N := by
    change closure S ≤ N
    apply (closure_le N).2
    rintro x ⟨w, hwne, hx⟩
    exact hcent (w : G) w.property hwne hx.2
  have hKnorm : L ≤ normalizer (K : Set G) := by
    apply le_normalizer_closure_iff.mpr
    rintro l hl x ⟨w, hwne, hx⟩
    let w' : W :=
      ⟨(l : G) * (w : G) * (l : G)⁻¹,
        (mem_normalizer_iff.mp (hLW hl) (w : G)).mp w.property⟩
    have hw'ne : (w' : G) ≠ 1 := by
      intro hz
      apply hwne
      calc
        (w : G) = (l : G)⁻¹ * ((w' : G)) * (l : G) := by
          dsimp [w']
          group
        _ = 1 := by rw [hz]; simp
    have hxl : (l : G) * x * (l : G)⁻¹ ∈ L := by
      exact L.mul_mem (L.mul_mem hl hx.1) (L.inv_mem hl)
    have hxc : (l : G) * x * (l : G)⁻¹ ∈ centralizer ({(w' : G)} : Set G) := by
      apply mem_centralizer_singleton_iff.mpr
      have hcomm := mem_centralizer_singleton_iff.mp hx.2
      calc
        ((l : G) * x * (l : G)⁻¹) * (w' : G) =
            (l : G) * (x * (w : G)) * (l : G)⁻¹ := by
              dsimp [w']
              group
        _ = (l : G) * ((w : G) * x) * (l : G)⁻¹ := by rw [hcomm]
        _ = (w' : G) * ((l : G) * x * (l : G)⁻¹) := by
              dsimp [w']
              group
    exact subset_closure ⟨w', hw'ne, ⟨hxl, hxc⟩⟩
  let P : Sylow 2 L := Classical.choice (Sylow.nonempty (p := 2) (G := L))
  let R : Subgroup G := (P : Subgroup L).map L.subtype
  have hRL : R ≤ L := by
    rintro x hx
    rcases mem_map.mp hx with ⟨p, hp, rfl⟩
    exact p.property
  have hRP : R.subgroupOf L = (P : Subgroup L) := by
    ext x
    constructor
    · intro hx
      change (x : G) ∈ R at hx
      rcases mem_map.mp hx with ⟨p, hp, heq⟩
      have heq' : (p : G) = (x : G) := by simpa using heq
      have : p = x := Subtype.ext heq'
      simpa [this] using hp
    · intro hx
      exact mem_map.mpr ⟨x, hx, rfl⟩
  have hRW : R ≤ normalizer (W : Set G) := hRL.trans hLW
  have hpR : IsPGroup 2 R := P.isPGroup'.map L.subtype
  let : MulDistribMulAction R W :=
    conjMulDistribMulActionOfLeNormalizer R W hRW
  let : Nontrivial W := (nontrivial_iff_ne_bot W).mpr hWne
  have hcard : 2 ∣ Nat.card W := by
    obtain ⟨n, hn⟩ := hW.exists_card_eq
    have hc : 1 < Nat.card W := (Finite.one_lt_card_iff_nontrivial).mpr inferInstance
    have hnne : n ≠ 0 := by
      intro hn0
      subst n
      simp only [pow_zero] at hn
      omega
    rw [hn]
    exact dvd_pow_self 2 hnne
  have hone : (1 : W) ∈ MulAction.fixedPoints R W := by
    apply MulAction.mem_fixedPoints.mpr
    intro r
    simp
  obtain ⟨w, hwfix, hwne⟩ :=
    hpR.exists_fixed_point_of_prime_dvd_card_of_fixed_point (α := W) hcard hone
  have hwne' : (w : G) ≠ 1 := by
    intro hw
    apply hwne
    exact Subtype.ext hw.symm
  have hRK : R ≤ K := by
    intro r hr
    have hcomm : (r : G) * (w : G) = (w : G) * (r : G) := by
      have hh := congrArg Subtype.val (MulAction.mem_fixedPoints.mp hwfix (⟨r,hr⟩ : R))
      change r * (w:G) * r⁻¹ = (w:G) at hh
      have hh' := congrArg (fun z : G => z * (r : G)) hh
      simpa [mul_assoc] using hh'
    apply Subgroup.subset_closure
    refine ⟨w, hwne', ⟨hRL hr, mem_centralizer_singleton_iff.mpr hcomm⟩⟩
  have hodd : Odd (R.subgroupOf L).index := by
    apply Nat.coprime_two_left.mp
    apply Nat.prime_two.coprime_iff_not_dvd.mpr
    intro hd
    apply P.not_dvd_index
    rw [← hRP]
    exact hd
  exact (perfect_le_of_normalizes_of_odd_relIndex L K R hKnorm hRK hodd).trans hKN


end Theory.GroupTheory
