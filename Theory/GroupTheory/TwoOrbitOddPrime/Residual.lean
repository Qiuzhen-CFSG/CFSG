module
public import Theory.GroupTheory.TwoOrbitOddPrime.Outer
public import Theory.GroupTheory.ConjugateSpanOrder

/-!
# Prime-to-p residual of a two-component orbit

The simple component quotient, divisible by p, is generated by its p-elements.
Perfectness lifts this generation through the two-core. The odd-prime outer
index bound then identifies the actual orbit product with O^{p′}.

Source: Aschbacher--Smith 1.2.2(a), p.504, used at p.206 in D.3.21.
-/

public section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace Theory.GroupTheory.TwoOrbitOddPrime
variable {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]

/-- The nonnormal component orbit is the prime-to-p residual when its simple
quotient and outer group satisfy the literal p-divisibility conditions. -/
theorem nonnormal_component_primeToResidual (hp : p ≠ 2)
    {K : Subgroup G} (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)] [IsSimpleGroup (K ⧸ pCore 2 K)]
    (hi : (normalizer (K : Set G)).index = 2)
    (hz : center (K ⧸ pCore 2 K) = ⊥)
    (hd : p ∣ Nat.card (K ⧸ pCore 2 K)) (hr : primeRank p G ≤ 2)
    (ho : Nat.Coprime p (Nat.card (MulAut.Outer (K ⧸ pCore 2 K)))) :
    primeToResidual p G = conjugateSpanBy K ⊤ := by
  classical
  have hex : ∃ t : G, t ∉ normalizer (K : Set G) := by
    by_contra! h
    have hn : normalizer (K : Set G) = ⊤ := eq_top_iff.mpr (fun t _ => h t)
    rw [hn,index_top] at hi
    omega
  obtain ⟨t,ht⟩ := hex
  let hnorm := TwoOrbitThree.pair_normal_of_index_two K hi t ht
  let : (K ⊔ K.conjBy t).Normal := hnorm
  let : Group.IsPerfect K := hK.perfect
  have hperfect : IsPPerfect 2 K := by
    intro N hN hquot
    let := hN
    have hs : Subsingleton (K ⧸ N) := by
      by_contra! hn
      exact Group.IsPerfect.not_isNilpotent (K ⧸ N) hquot.isNilpotent
    apply eq_top_iff.mpr
    intro x _
    exact (QuotientGroup.eq_one_iff x).mp (Subsingleton.elim _ _)
  have hKR : K ≤ primeToResidual p G := le_primeToResidual_of_eq_top p K
    (primeToResidual_eq_top_of_simple_quotient p 2 (pCore 2 K) pCore_isPGroup hperfect hd)
  have he : K ⊔ K.conjBy t = primeToResidual p G := by
    refine le_antisymm (sup_le hKR ?_) (primeToResidual_le _
      (outer_cComponent_pair_index_coprime p hp hK hi t ht hz hd hr ho))
    rintro x ⟨k,hk,rfl⟩
    exact (inferInstance : (primeToResidual p G).Normal).conj_mem k (hKR hk) t
  rw [←he]
  apply le_antisymm
  · refine sup_le (le_conjugateSpanBy K ⊤) ?_
    rintro x ⟨k,hk,rfl⟩
    exact subset_closure ⟨t,mem_top t,k,hk,rfl⟩
  · apply conjugateSpanBy_le le_sup_left
    rw [normalizer_eq_top]

end Theory.GroupTheory.TwoOrbitOddPrime
