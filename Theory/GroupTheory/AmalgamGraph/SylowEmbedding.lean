module
public import Theory.GroupTheory.AmalgamGraph.SylowGenerated
/-!
# Sylow generation under an embedding

An injective homomorphism identifies the Sylows of a finite subgroup with
those of its image. Thus the intrinsic group generated by its Sylows has
the same literal image. This transports the DGS local actor from the
reduced completion into the original completion, without assuming either
completion finite. Source application: DGS, Groups and Graphs (1985),
Part II, 6.0--6.1, pp.118--119.
-/
public noncomputable section
open Subgroup
namespace Theory.GroupTheory.AmalgamGraph
variable {G H : Type*} [Group G] [Group H]

/-- Injective maps preserve the literal subgroup generated by all local Sylows. -/
theorem sylowGenerated_map_of_injective (f : G →* H) (hf : Function.Injective f)
    (P : Subgroup G) [Finite P] :
    sylowGenerated (P.map f) = (sylowGenerated P).map f := by
  let e := P.equivMapOfInjective f hf
  have himage (T : Sylow 2 P) :
      ((T.mapSurjective (f := e.toMonoidHom) e.surjective : Subgroup (P.map f)).map
        (P.map f).subtype) = ((T : Subgroup P).map P.subtype).map f := by
    change ((T : Subgroup P).map _).map _ = _
    rw [map_map, map_map]
    rfl
  apply le_antisymm
  · apply iSup_le
    intro R
    obtain ⟨T, rfl⟩ := Sylow.mapSurjective_surjective (f := e.toMonoidHom) e.surjective 2 R
    rw [himage]
    exact map_mono (sylow_le_sylowGenerated P T)
  · rw [sylowGenerated, Subgroup.map_iSup]
    apply iSup_le
    intro T
    rw [← himage]
    exact sylow_le_sylowGenerated _ _
end Theory.GroupTheory.AmalgamGraph
