module
public import Theory.GroupTheory.RankOneInvariantKernelOrbit
public import Theory.GroupTheory.PCoreRestriction
public import Theory.GroupTheory.PGroup.CharacteristicPairReduction
public import Mathlib.GroupTheory.Sylow

/-!
# Sylow-center spans at finite local groups

The span is generated by the actual images of Ω₁(Z(T)) for all Sylow
2-subgroups T. Transport moves each Sylow, its center and its inclusion by
the same group isomorphism. Self-centralization of the two-core places the
whole span in Ω₁(Z(O₂(P))). A nontrivial Sylow supplies a nonzero generator.

Source: Delgado--Goldschmidt--Stellmacher, *Groups and Graphs* (1985),
Part II, notation on p.81 and 3.8(a), pp.82--83.
-/

@[expose] public noncomputable section
open Subgroup
namespace Theory.GroupTheory.AmalgamGraph
variable {G H : Type*} [Group G] [Group H]

/-- Join of the actual omega-centers of all Sylow two-subgroups of P. -/
def sylowCenterSpan (P : Subgroup G) : Subgroup G :=
  ⨆ T : Sylow 2 P, omegaCenterIn ((T : Subgroup P).map P.subtype)

theorem sylowCenterSpan_le (P : Subgroup G) : sylowCenterSpan P ≤ P := by
  apply iSup_le
  intro T
  exact (show omegaCenterIn ((T : Subgroup P).map P.subtype) ≤
    (T : Subgroup P).map P.subtype from map_subtype_le _).trans (map_subtype_le _)

private theorem sylow_image (f : G ≃* H) (P : Subgroup G) [Finite P]
    (T : Sylow 2 P) :
    let e := P.equivMapOfInjective f.toMonoidHom f.injective
    ((T.mapSurjective (f := e.toMonoidHom) e.surjective :
      Subgroup (P.map f.toMonoidHom)).map (P.map f.toMonoidHom).subtype) =
        ((T : Subgroup P).map P.subtype).map f.toMonoidHom := by
  dsimp only
  change ((T : Subgroup P).map _).map _ = _
  rw [map_map, map_map]
  rfl

/-- Every Sylow and its actual center embedding are transported by the same map. -/
theorem sylowCenterSpan_map (f : G ≃* H) (P : Subgroup G) [Finite P] :
    sylowCenterSpan (P.map f.toMonoidHom) = (sylowCenterSpan P).map f.toMonoidHom := by
  let e := P.equivMapOfInjective f.toMonoidHom f.injective
  apply le_antisymm
  · apply iSup_le
    intro T'
    obtain ⟨T, rfl⟩ := Sylow.mapSurjective_surjective
      (f := e.toMonoidHom) e.surjective 2 T'
    rw [sylow_image f P T, ← NilesRankOneKernel.omegaCenterIn_map_injective _ f.injective]
    exact map_mono (le_iSup (fun T : Sylow 2 P =>
      omegaCenterIn ((T : Subgroup P).map P.subtype)) T)
  · rw [sylowCenterSpan, Subgroup.map_iSup]
    apply iSup_le
    intro T
    rw [NilesRankOneKernel.omegaCenterIn_map_injective _ f.injective,
      ← sylow_image f P T]
    exact le_iSup (fun T' : Sylow 2 (P.map f.toMonoidHom) =>
      omegaCenterIn ((T' : Subgroup (P.map f.toMonoidHom)).map
        (P.map f.toMonoidHom).subtype)) _

/-- The span is normal relative to P; no ambient normality is asserted. -/
theorem sylowCenterSpan_normal (P : Subgroup G) [Finite P] :
    ((sylowCenterSpan P).subgroupOf P).Normal := by
  apply (normal_subgroupOf_iff_le_normalizer (sylowCenterSpan_le P)).mpr
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq]
  change (sylowCenterSpan P).map (MulAut.conj g).toMonoidHom = _
  rw [← sylowCenterSpan_map]
  congr 1
  exact (mem_normalizer_iff_map_conj_eq.mp (P.le_normalizer hg))

/-- Characteristic two places each Sylow omega-center in the central omega
of the actual two-core, with its central summands retained. -/
theorem sylowCenterSpan_le_coreOmega (P : Subgroup G)
    (hc : centralizer (pCore 2 P : Set P) ≤ pCore 2 P) :
    sylowCenterSpan P ≤ omegaCenterIn (P.pCoreIn 2) := by
  apply iSup_le
  intro T
  rw [← NilesRankOneKernel.omegaCenterIn_map_injective _ P.subtype_injective,
    pCoreIn, ← NilesRankOneKernel.omegaCenterIn_map_injective _ P.subtype_injective]
  apply map_mono
  intro z hz
  obtain ⟨hzT, hzC, hzs⟩ := (mem_omegaCenterIn_iff _ _).mp hz
  have hzc := centralizer_le (pCore_isPGroup.le_sylow_of_normal T) hzC
  exact (mem_omegaCenterIn_iff _ _).mpr ⟨hc hzc, hzc, hzs⟩

/-- A nontrivial actual Sylow supplies a nontrivial center generator. -/
theorem sylowCenterSpan_ne_bot (P : Subgroup G) [Finite P]
    (T : Sylow 2 P) (hT : (T : Subgroup P) ≠ ⊥) : sylowCenterSpan P ≠ ⊥ := by
  let : Nontrivial T := (nontrivial_iff_ne_bot _).mpr hT
  have hc : omegaCenterIn (T : Subgroup P) ≠ ⊥ := by
    apply fun h => omega_center_ne_bot T.isPGroup' ?_
    exact (map_eq_bot_iff_of_injective _ (T : Subgroup P).subtype_injective).mp h
  have hm : omegaCenterIn ((T : Subgroup P).map P.subtype) ≠ ⊥ := by
    rw [← NilesRankOneKernel.omegaCenterIn_map_injective _ P.subtype_injective]
    exact fun h => hc ((map_eq_bot_iff_of_injective _ P.subtype_injective).mp h)
  intro h
  apply hm
  exact eq_bot_iff.mpr ((le_iSup (fun R : Sylow 2 P =>
    omegaCenterIn ((R : Subgroup P).map P.subtype)) T).trans h.le)

end Theory.GroupTheory.AmalgamGraph
