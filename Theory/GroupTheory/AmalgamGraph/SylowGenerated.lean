module
public import Theory.GroupTheory.AmalgamGraph.SylowCenterSpan
public import Theory.GroupTheory.ConjugateSpanSylow

/-!
# The subgroup generated by all local Sylow two-subgroups

The join of the actual embedded Sylows is intrinsic and preserved by every
group isomorphism. Sylow conjugacy identifies it with the conjugate span of
any one Sylow. Consequently, if the Sylow-center span collapses to one seed,
it equals the central omega of this generated group in characteristic two.

This supplies a choice-independent equivariant local group for the DGS
coset graph. Source: DGS, *Groups and Graphs* (1985), 6.0--6.2, pp.118--119.
-/

@[expose] public noncomputable section
open Subgroup
namespace Theory.GroupTheory.AmalgamGraph
variable {G H : Type*} [Group G] [Group H]

def sylowGenerated (P : Subgroup G) : Subgroup G :=
  ⨆ T : Sylow 2 P, (T : Subgroup P).map P.subtype

theorem sylowGenerated_le (P : Subgroup G) : sylowGenerated P ≤ P :=
  iSup_le (fun _ => map_subtype_le _)

theorem sylow_le_sylowGenerated (P : Subgroup G) (T : Sylow 2 P) :
    (T : Subgroup P).map P.subtype ≤ sylowGenerated P :=
  le_iSup (fun R : Sylow 2 P => (R : Subgroup P).map P.subtype) T

theorem sylowGenerated_map (e : G ≃* H) (P : Subgroup G) [Finite P] :
    sylowGenerated (P.map e.toMonoidHom) = (sylowGenerated P).map e.toMonoidHom := by
  let f := P.equivMapOfInjective e.toMonoidHom e.injective
  have himage (T : Sylow 2 P) :
      ((T.mapSurjective (f := f.toMonoidHom) f.surjective : Subgroup (P.map e.toMonoidHom)).map
        (P.map e.toMonoidHom).subtype) = ((T : Subgroup P).map P.subtype).map e.toMonoidHom := by
    change ((T : Subgroup P).map _).map _ = _
    rw [map_map, map_map]
    rfl
  apply le_antisymm
  · apply iSup_le
    intro R
    obtain ⟨T, rfl⟩ := Sylow.mapSurjective_surjective (f := f.toMonoidHom) f.surjective 2 R
    rw [himage]
    exact map_mono (sylow_le_sylowGenerated P T)
  · rw [sylowGenerated, Subgroup.map_iSup]
    apply iSup_le
    intro T
    rw [← himage]
    exact sylow_le_sylowGenerated _ _

theorem sylowGenerated_normalized (P : Subgroup G) [Finite P] :
    P ≤ normalizer (sylowGenerated P : Set G) := by
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq]
  change (sylowGenerated P).map (MulAut.conj g).toMonoidHom = _
  rw [← sylowGenerated_map]
  congr 1
  exact mem_normalizer_iff_map_conj_eq.mp (P.le_normalizer hg)

theorem sylowGenerated_eq_span (P : Subgroup G) [Finite P] (T : Sylow 2 P) :
    sylowGenerated P = conjugateSpanBy ((T : Subgroup P).map P.subtype) P := by
  apply le_antisymm _ (conjugateSpanBy_le (sylow_le_sylowGenerated P T) (sylowGenerated_normalized P))
  apply iSup_le
  intro R
  obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq P T R
  rw [Sylow.smul_def, Sylow.pointwise_smul_def, Subgroup.pointwise_smul_def]
  rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
  exact subset_closure ⟨g, g.property, x, mem_map_of_mem P.subtype hx, rfl⟩

theorem sylowCenterSpan_eq_generated_omega_of_seed (P : Subgroup G) [Finite P]
    (hc : centralizer (pCore 2 P : Set P) ≤ pCore 2 P) (T : Sylow 2 P)
    (he : sylowCenterSpan P = omegaCenterIn ((T : Subgroup P).map P.subtype)) :
    sylowCenterSpan P = omegaCenterIn (sylowGenerated P) := by
  have hZL : sylowCenterSpan P ≤ sylowGenerated P := by
    rw [he]
    exact (map_subtype_le _).trans (sylow_le_sylowGenerated P T)
  have hZC : sylowCenterSpan P ≤ centralizer (sylowGenerated P : Set G) := by
    apply le_centralizer_iff.mpr
    rw [sylowGenerated_eq_span P T]
    apply conjugateSpanBy_le _
      (((normal_subgroupOf_iff_le_normalizer (sylowCenterSpan_le P)).mp
        (sylowCenterSpan_normal P)).trans (normalizer_le_normalizer_centralizer _))
    rw [le_centralizer_iff, he]
    exact fun _ hz => ((mem_omegaCenterIn_iff _ _).mp hz).2.1
  apply le_antisymm
  · intro z hz
    exact (mem_omegaCenterIn_iff _ _).mpr ⟨hZL hz, hZC hz,
      ((mem_omegaCenterIn_iff _ _).mp (he ▸ hz)).2.2⟩
  · intro z hz
    obtain ⟨hzL, hzC, hzs⟩ := (mem_omegaCenterIn_iff _ _).mp hz
    have hQ : P.pCoreIn 2 ≤ sylowGenerated P := (pCoreIn_le_sylow P T).trans
      (sylow_le_sylowGenerated P T)
    have hzQ : z ∈ P.pCoreIn 2 := by
      have hzP : z ∈ P := sylowGenerated_le P hzL
      have hzc : (⟨z, hzP⟩ : P) ∈ centralizer (pCore 2 P : Set P) := by
        intro a ha
        apply Subtype.ext
        exact hzC a (hQ (mem_map_of_mem P.subtype ha))
      exact mem_map_of_mem P.subtype (hc hzc)
    rw [he]
    exact (mem_omegaCenterIn_iff _ _).mpr ⟨pCoreIn_le_sylow P T hzQ,
      centralizer_le (sylow_le_sylowGenerated P T) hzC, hzs⟩
end Theory.GroupTheory.AmalgamGraph
