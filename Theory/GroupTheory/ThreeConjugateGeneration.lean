module

public import Mathlib.GroupTheory.Subgroup.Simple
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import Mathlib.Data.Fin.VecNotation
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Group

/-!
# Three conjugates from a maximal subgroup generated by two conjugates

In a simple group every nonidentity conjugacy class escapes every proper
subgroup. Thus a maximal subgroup generated by two members of a class can
be enlarged to the whole group by one further member. A cyclic subgroup
with an involutory inverter outside it supplies the required pair of
involutions: if z generates the cyclic subgroup, use w and z*w.

This is the group-theoretic step in Guralnick--Malle, Classification of
2F-modules I, (2.6) and Proposition 4.1, manuscript pp.4,8--9. Its concrete
PSL2 application is in Theory.SpecificGroups.PSL2.ThreeInvolutionGeneration.
-/

public section

open Subgroup

namespace Theory.GroupTheory.ThreeConjugateGeneration

/-- A nonidentity conjugacy class in a simple group escapes every proper subgroup. -/
theorem exists_conjugate_outside {G : Type*} [Group G] [IsSimpleGroup G]
    {t : G} (ht : t ≠ 1) (H : Subgroup G) (hH : H ≠ ⊤) :
    ∃ g : G, g * t * g⁻¹ ∉ H := by
  classical
  by_contra! hall
  have hnormal : normalClosure ({t} : Set G) = ⊤ := by
    rcases (inferInstance : (normalClosure ({t} : Set G)).Normal).eq_bot_or_eq_top with h | h
    · have hmem := subset_normalClosure (Set.mem_singleton t)
      rw [h] at hmem
      exact (ht hmem).elim
    · exact h
  have hle : normalClosure ({t} : Set G) ≤ H := by
    apply (closure_le _).mpr
    intro x hx
    obtain ⟨a, ha, hax⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain rfl := Set.mem_singleton_iff.mp ha
    obtain ⟨g, rfl⟩ := isConj_iff.mp hax
    exact hall g
  exact hH (top_unique (hnormal ▸ hle))

/-- Two conjugates generating a maximal subgroup extend to three generating conjugates. -/
theorem of_maximal_pair {G : Type*} [Group G] [IsSimpleGroup G]
    {t a b : G} (ht : t ≠ 1) (ha : IsConj t a) (hb : IsConj t b)
    (hm : IsCoatom (closure ({a, b} : Set G))) :
    ∃ g : Fin 3 → G, closure (Set.range fun i => g i * t * (g i)⁻¹) = ⊤ := by
  obtain ⟨g₀, hg₀⟩ := isConj_iff.mp ha
  obtain ⟨g₁, hg₁⟩ := isConj_iff.mp hb
  obtain ⟨g₂, hg₂⟩ := exists_conjugate_outside ht _ hm.ne_top
  let g : Fin 3 → G := ![g₀, g₁, g₂]
  let H := closure (Set.range fun i => g i * t * (g i)⁻¹)
  have hgen (i : Fin 3) : g i * t * (g i)⁻¹ ∈ H := subset_closure ⟨i, rfl⟩
  have haH : a ∈ H := by simpa [g, hg₀] using hgen 0
  have hbH : b ∈ H := by simpa [g, hg₁] using hgen 1
  have hpair : closure ({a, b} : Set G) ≤ H :=
    (closure_le _).mpr (by
      simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨haH, hbH⟩)
  refine ⟨g, hm.lt_iff.mp (lt_of_le_of_ne hpair ?_)⟩
  intro heq
  apply hg₂
  rw [heq]
  simpa [g] using hgen 2

/-- A cyclic subgroup and an involutory inverter outside it are generated by two involutions. -/
theorem pair_of_cyclic_inverter {G : Type*} [Group G]
    (C : Subgroup G) [IsCyclic C] (w : G) (hw : w ∉ C)
    (hw2 : w ^ 2 = 1) (hinv : ∀ z ∈ C, w * z * w⁻¹ = z⁻¹) :
    ∃ a b : G, a ≠ 1 ∧ a ^ 2 = 1 ∧ b ≠ 1 ∧ b ^ 2 = 1 ∧
      closure ({a, b} : Set G) = C ⊔ zpowers w := by
  obtain ⟨z, hz⟩ := C.isCyclic_iff_exists_zpowers_eq_top.mp inferInstance
  have hzC : z ∈ C := hz ▸ mem_zpowers z
  have hw1 : w ≠ 1 := by rintro rfl; exact hw C.one_mem
  have hzw1 : z * w ≠ 1 := by
    intro heq
    have hwz : w = z⁻¹ := eq_inv_of_mul_eq_one_right heq
    exact hw (hwz ▸ C.inv_mem hzC)
  have hw_inv : w⁻¹ = w := inv_eq_of_mul_eq_one_left (by simpa [pow_two] using hw2)
  have hzw2 : (z * w) ^ 2 = 1 := by
    have hi := hinv z hzC
    rw [hw_inv] at hi
    calc
      (z * w) ^ 2 = z * (w * z * w) := by simp only [pow_two, mul_assoc]
      _ = 1 := by rw [hi]; simp
  refine ⟨w, z * w, hw1, hw2, hzw1, hzw2, le_antisymm ?_ ?_⟩
  · apply (closure_le _).mpr
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    have hwH : w ∈ C ⊔ zpowers w := (le_sup_right : zpowers w ≤ C ⊔ zpowers w) (mem_zpowers w)
    exact ⟨hwH, mul_mem ((le_sup_left : C ≤ C ⊔ zpowers w) hzC) hwH⟩
  · have hwH : w ∈ closure ({w, z * w} : Set G) := subset_closure (by simp)
    have hzwH : z * w ∈ closure ({w, z * w} : Set G) := subset_closure (by simp)
    have hzH : z ∈ closure ({w, z * w} : Set G) := by
      simpa using mul_mem hzwH (inv_mem hwH)
    rw [← hz]
    exact sup_le (zpowers_le.mpr hzH) (zpowers_le.mpr hwH)

end Theory.GroupTheory.ThreeConjugateGeneration
