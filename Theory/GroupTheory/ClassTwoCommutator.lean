module

public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.Index
public import Mathlib.Tactic.Group

/-!
# Commutator homomorphisms in groups of class at most two

When the derived group is central, the map x ↦ [t,x] is a homomorphism.
Its kernel is C_G(t), and its range is the literal subgroup [⟨t⟩,G].
The first isomorphism theorem therefore computes the centralizer index.

This is the calculation (*) in Aschbacher–Smith, J.2.3, printed p.433
(1 March 2004 manuscript). The range argument also appears privately in
`ClassThreeCentralizerBound`; this module exposes the class-two interface
without importing that separate application.
-/

@[expose] public section
namespace Subgroup.ClassTwo
open scoped commutatorElement
variable {G : Type*} [Group G]

/-- The central commutator row associated to t. -/
def commutatorHom (hc : _root_.commutator G ≤ center G) (t : G) : G →* G where
  toFun x := ⁅t, x⁆
  map_one' := by simp
  map_mul' x y := by
    rw [commutatorElement_mul_right_eq_mul_conj]
    have hcent := mem_center_iff.mp
      (hc (commutator_mem_commutator (mem_top t) (mem_top y))) x
    calc
      _ = ⁅t,x⁆ * (x * ⁅t,y⁆) * x⁻¹ := by group
      _ = ⁅t,x⁆ * ⁅t,y⁆ := by rw [hcent]; group

theorem commutatorHom_ker (hc : _root_.commutator G ≤ center G) (t : G) :
    (commutatorHom hc t).ker = centralizer ({t} : Set G) := by
  ext x
  change ⁅t,x⁆ = 1 ↔ _
  rw [commutatorElement_eq_one_iff_mul_comm, mem_centralizer_singleton_iff, eq_comm]

theorem commutatorHom_range (hc : _root_.commutator G ≤ center G) (t : G) :
    (commutatorHom hc t).range = ⁅zpowers t, (⊤ : Subgroup G)⁆ := by
  let f := commutatorHom hc t
  have hcentral : f.range ≤ center G := by
    rintro _ ⟨x, rfl⟩
    exact hc (commutator_mem_commutator (mem_top t) (mem_top x))
  let : f.range.Normal := ⟨fun x hx g => by
    rw [mem_center_iff.mp (hcentral hx) g, mul_inv_cancel_right]
    exact hx⟩
  let π := QuotientGroup.mk' f.range
  have ht (x : G) : Commute (π t) (π x) := by
    apply commutatorElement_eq_one_iff_mul_comm.mp
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr ⟨x, rfl⟩
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact commutator_mem_commutator (mem_zpowers t) (mem_top x)
  · apply commutator_le.mpr
    intro y hy x _
    obtain ⟨n, rfl⟩ := mem_zpowers_iff.mp hy
    apply (QuotientGroup.eq_one_iff _).mp
    change π ⁅t ^ n, x⁆ = 1
    rw [map_commutatorElement, map_zpow]
    exact commutatorElement_eq_one_iff_mul_comm.mpr ((ht x).zpow_left n).eq

theorem centralizer_normal (hc : _root_.commutator G ≤ center G) (t : G) :
    (centralizer ({t} : Set G)).Normal := by
  rw [← commutatorHom_ker hc t]
  infer_instance

/-- The quotient in the centralizer-index calculation is a genuine group
quotient, isomorphic to the subgroup generated by the commutators. -/
noncomputable def centralizerQuotientEquiv
    (hc : _root_.commutator G ≤ center G) (t : G)
    [(centralizer ({t} : Set G)).Normal] :
    (G ⧸ centralizer ({t} : Set G)) ≃* (⁅zpowers t, ⊤⁆ : Subgroup G) :=
  (QuotientGroup.quotientMulEquivOfEq (commutatorHom_ker hc t).symm).trans
    ((QuotientGroup.quotientKerEquivRange (commutatorHom hc t)).trans
      (MulEquiv.subgroupCongr (commutatorHom_range hc t)))

/-- The exact index identity, including groups that are not finite. -/
theorem centralizer_index (hc : _root_.commutator G ≤ center G) (t : G) :
    (centralizer ({t} : Set G)).index = Nat.card (⁅zpowers t, ⊤⁆ : Subgroup G) := by
  rw [← commutatorHom_ker hc t, index_ker, commutatorHom_range]

theorem card_commutator_mul_card_centralizer
    (hc : _root_.commutator G ≤ center G) (t : G) :
    Nat.card (⁅zpowers t, ⊤⁆ : Subgroup G) *
      Nat.card (centralizer ({t} : Set G)) = Nat.card G := by
  rw [← centralizer_index hc t]
  exact (centralizer ({t} : Set G)).index_mul_card

end Subgroup.ClassTwo
