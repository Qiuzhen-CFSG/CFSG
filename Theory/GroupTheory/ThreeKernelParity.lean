module
public import Mathlib.GroupTheory.Index
public import Mathlib.Tactic.Tauto

/-!
# Parity for three index-two kernels

If a group is generated by a specified family and every generator satisfies
the even membership relation for three index-two kernels, membership in the
first two kernels implies membership in the third. The supporting theorem
computes the intersection index of two distinct index-two subgroups as four.

Membership in an index-two subgroup is a multiplicative binary character.
The three-character parity relation therefore defines a subgroup, and the
generator hypothesis makes that subgroup contain the whole group. The index
calculation uses relative-index multiplication. These are source-independent
finite-group facts used for the common neighborhood-core intersection in
Stellmacher (10.1), Journal of Algebra 190 (1997), printed pp.60 and65.
-/

namespace Subgroup
universe u

public theorem three_index_two_kernels_parity
    {G : Type u} [Group G] (W K₀ K₁ K₂ : Subgroup G)
    (family : Set (Subgroup G)) (hW : W = sSup family)
    (hzero : (K₀.subgroupOf W).index = 2)
    (hone : (K₁.subgroupOf W).index = 2)
    (htwo : (K₂.subgroupOf W).index = 2)
    (hgenerator : ∀ subgroup ∈ family, ∀ element ∈ subgroup,
      ((element ∈ K₀ ↔ element ∈ K₁) ↔ element ∈ K₂)) :
    W ⊓ K₀ ⊓ K₁ ≤ K₂ := by
  have hmul (K : Subgroup G) (hindex : (K.subgroupOf W).index = 2)
      {left right : G} (hleft : left ∈ W) (hright : right ∈ W) :
      left * right ∈ K ↔ (left ∈ K ↔ right ∈ K) :=
    @Subgroup.mul_mem_iff_of_index_two W _ (K.subgroupOf W) hindex
      ⟨left, hleft⟩ ⟨right, hright⟩
  let even : Subgroup G := {
    carrier := {element | element ∈ W ∧
      ((element ∈ K₀ ↔ element ∈ K₁) ↔ element ∈ K₂)}
    one_mem' := by simp
    mul_mem' := by
      rintro left right ⟨hleft, hleftParity⟩ ⟨hright, hrightParity⟩
      refine ⟨W.mul_mem hleft hright, ?_⟩
      rw [hmul K₀ hzero hleft hright, hmul K₁ hone hleft hright,
        hmul K₂ htwo hleft hright]
      tauto
    inv_mem' := by
      rintro element ⟨helement, hparity⟩
      exact ⟨W.inv_mem helement, by simpa only [Subgroup.inv_mem_iff] using hparity⟩ }
  have hWeven : W ≤ even := by
    rw [hW]
    apply sSup_le
    intro subgroup hsubgroup element helement
    exact ⟨(hW ▸ le_sSup hsubgroup) helement,
      hgenerator subgroup hsubgroup element helement⟩
  rintro element ⟨⟨hWmem, hzeroMem⟩, honeMem⟩
  exact (hWeven hWmem).2.mp (by tauto)

public theorem index_inf_eq_four_of_distinct_index_two
    {G : Type u} [Group G] [Finite G] (K L : Subgroup G)
    (hK : K.index = 2) (hL : L.index = 2) (hout : ¬ K ≤ L) :
    (K ⊓ L).index = 4 := by
  have hbound : L.relIndex K ≤ 2 := by
    have h := Subgroup.relIndex_le_of_le_right
      (H := L) (show K ≤ ⊤ from le_top) (by simp [hL])
    simpa only [Subgroup.relIndex_top_right, hL] using h
  have hpositive : L.relIndex K ≠ 0 := (L.subgroupOf K).index_ne_zero_of_finite
  have hnotone : L.relIndex K ≠ 1 := fun h => hout (Subgroup.relIndex_eq_one.mp h)
  have hindex : L.relIndex K = 2 := by omega
  have h := Subgroup.relIndex_mul_index (show K ⊓ L ≤ K from inf_le_left)
  rw [Subgroup.inf_relIndex_left, hindex, hK] at h
  exact h.symm

end Subgroup


