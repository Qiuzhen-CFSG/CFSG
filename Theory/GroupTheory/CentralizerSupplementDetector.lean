module
public import Theory.GroupTheory.CommutingCentralizerFactors

/-!
# Transferring a centralizer detector through a supplement

If Q is generated by U and C_Q(B), an element of B detecting C_U(B)
also detects C_Q(B). A commutative cover then permits replacing B by that
cover. The proof splits an element into its U and centralizing coordinates.

Source application: Aschbacher--Smith 3.3.28, printed p.601, where
Q=O₂(LT), U=U(L), and B=Uᵈ.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G]

/-- A detector on a normal subgroup extends across its centralizing supplement. -/
theorem inf_centralizer_singleton_of_centralizing_supplement
    (Q U B : Subgroup G) (hn : Q ≤ normalizer (U : Set G))
    (hfactor : Q = U ⊔ (Q ⊓ centralizer (B : Set G)))
    (a : G) (ha : a ∈ B)
    (hfix : U ⊓ centralizer (B : Set G) = U ⊓ centralizer ({a} : Set G)) :
    Q ⊓ centralizer (B : Set G) = Q ⊓ centralizer ({a} : Set G) := by
  have hUQ : U ≤ Q := hfactor.symm ▸ le_sup_left
  have hc : Q ⊓ centralizer (B : Set G) ≤ centralizer ({a} : Set G) :=
    inf_le_right.trans (centralizer_le (Set.singleton_subset_iff.mpr ha))
  have he := sup_inf_centralizer_singleton_of_centralizing_supplement U
    (Q ⊓ centralizer (B : Set G)) a (inf_le_left.trans hn) hc
  rw [← hfactor, ← hfix] at he
  exact (he.trans (sup_eq_right.mpr (inf_le_inf_right _ hUQ))).symm

/-- A commutative cover of the smaller centralizer has the same centralizer in Q. -/
theorem inf_centralizer_eq_of_commutative_cover
    (Q B W : Subgroup G) [IsMulCommutative W]
    (hBW : B ≤ W) (hcover : Q ⊓ centralizer (B : Set G) ≤ W) :
    Q ⊓ centralizer (W : Set G) = Q ⊓ centralizer (B : Set G) := by
  apply le_antisymm
  · exact inf_le_inf_left _ (centralizer_le hBW)
  · exact le_inf inf_le_left
      (hcover.trans (le_centralizer_iff_isMulCommutative.mpr inferInstance))

/-- An ambient detector restricts to a subgroup containing all its actors. -/
theorem subgroupOf_inf_centralizer_singleton_of_eq
    (Q W R : Subgroup G) (hWR : W ≤ R) (a : R)
    (hfix : Q ⊓ centralizer (W : Set G) = Q ⊓ centralizer ({(a : G)} : Set G)) :
    Q.subgroupOf R ⊓ centralizer (W.subgroupOf R : Set R) =
      Q.subgroupOf R ⊓ centralizer ({a} : Set R) := by
  have hcentral (x : R) :
      x ∈ centralizer (W.subgroupOf R : Set R) ↔ (x : G) ∈ centralizer (W : Set G) := by
    constructor
    · intro hx w hw
      exact congrArg Subtype.val (hx (⟨w,hWR hw⟩ : R) hw)
    · intro hx w hw
      exact Subtype.ext (hx (w : G) hw)
  ext x
  change (x : G) ∈ Q ∧ x ∈ centralizer (W.subgroupOf R : Set R) ↔
    (x : G) ∈ Q ∧ x ∈ centralizer ({a} : Set R)
  rw [hcentral]
  have hx := SetLike.ext_iff.mp hfix (x : G)
  simpa only [mem_inf, mem_centralizer_singleton_iff, Subtype.ext_iff, coe_mul] using hx

end Subgroup
