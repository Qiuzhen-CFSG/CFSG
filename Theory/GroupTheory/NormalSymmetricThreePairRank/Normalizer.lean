module
public import Theory.GroupTheory.NormalSymmetricThreePairRank.Quotient

/-!
# Two-perfect actors normalizing a symmetric-three pair

Pass to the subgroup generated by the actor and the pair. The pair is
normal there, and transport through its intrinsic two-core quotient
allows the normal-pair rank theorem to place the actor in the pair.
Only the three-rank of this actual join is needed.

Application: the solvable closure branch of Aschbacher--Smith 14.6.16,
printed p.1035, using the rank placement argument of 13.8.5, p.947.
-/

public section
open Subgroup Theory.GroupTheory
namespace Theory.GroupTheory.NormalSymmetricThreePairRank
variable {G : Type*} [Group G] [Finite G]

/-- A two-perfect {2,3}-actor normalizing a symmetric-three pair modulo
its two-core lies in that pair, under the rank bound on their actual join. -/
theorem le_of_normalizes_quotient_pair
    (D B : Subgroup G)
    (e : (D ⧸ pCore 2 D) ≃* (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))
    (hB : IsPPerfect 2 B) (hn : B ≤ normalizer (D : Set G))
    (hr : primeRank 3 (D ⊔ B : Subgroup G) ≤ 2)
    (ho : ∃ m n : ℕ, Nat.card B ∣ 2^m * 3^n) : B ≤ D := by
  let J := D ⊔ B
  let eD := subgroupOfEquivOfLe (show D ≤ J from le_sup_left)
  let eB := subgroupOfEquivOfLe (show B ≤ J from le_sup_right)
  let : (D.subgroupOf J).Normal :=
    normal_subgroupOf_of_le_normalizer (sup_le D.le_normalizer hn)
  let eq := QuotientGroup.congr (pCore 2 (D.subgroupOf J)) (pCore 2 D) eD
    (pCore_map_iso 2 eD)
  have hb : IsPPerfect 2 (B.subgroupOf J) :=
    hB.of_surjective eB.symm.toMonoidHom eB.symm.surjective
  have ho' : ∃ m n : ℕ, Nat.card (B.subgroupOf J) ∣ 2^m * 3^n := by
    simpa only [Nat.card_congr eB.toEquiv] using ho
  have h := le_normal_of_quotient_pair (D.subgroupOf J) (eq.trans e)
    (B.subgroupOf J) hb hr ho'
  intro b hb
  exact h (show (⟨b,(show B ≤ J from le_sup_right) hb⟩ : J) ∈ B.subgroupOf J from hb)
end Theory.GroupTheory.NormalSymmetricThreePairRank
