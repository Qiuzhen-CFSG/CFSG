module

public import Theory.GroupTheory.PrimeOrderClosure
public import Theory.GroupTheory.QuaternionCentralProductResidualRecognition.Residual

/-!
# Perfectness of a prime-order closure away from its defining prime

If p and q are coprime, each order-q generator belongs to the p-residual
of its generated subgroup. Hence the entire prime-order closure is
p-perfect. No finiteness or simplicity assumption is needed.

Source application: the cubic closure in Aschbacher–Smith,13.7.5, p.938.
-/

public section
open Subgroup

namespace Subgroup
variable {G : Type*} [Group G]
/-- The subgroup generated by order-q elements is p-perfect when p and q are coprime. -/
theorem primeOrderClosure_isPPerfect {p q : ℕ} [Fact p.Prime]
    (hpq : Nat.Coprime p q) (A : Subgroup G) :
    IsPPerfect p (closure {x : G | x ∈ A ∧ orderOf x = q}) := by
  let Y := closure {x : G | x ∈ A ∧ orderOf x = q}
  have hY : Y ≤ (pResidual p Y).map Y.subtype := by
    apply (closure_le _).mpr
    intro x hx
    let y : Y := ⟨x, subset_closure hx⟩
    refine ⟨y, mem_pResidual_of_orderOf_coprime ?_, rfl⟩
    rw [(Y.orderOf_coe y).symm.trans hx.2]
    exact hpq
  apply (pResidual_eq_top_iff p Y).mp
  apply top_unique
  intro y _
  obtain ⟨z, hz, he⟩ := hY y.property
  have he' : z = y := Subtype.ext he
  exact he' ▸ hz
end Subgroup
