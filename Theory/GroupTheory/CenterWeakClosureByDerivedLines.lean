module

public import Theory.GroupTheory.SaturatedInvolutionSquareFusion
public import Theory.GroupTheory.CharacteristicCentralizerFusion
public import Theory.ElementaryAbelian.Basic

/-!
# Weak closure from derived lines of involution centralizers

Let W be a two-subgroup of M with elementary abelian center. Suppose every
noncentral involution l in W has a derived centralizer line generated by an
involution u whose centralizer in M is contained in W. Then Z(W) is strongly,
and hence weakly, closed in W with respect to M.

The characteristic line forces the normalizer of C_W(l) in M into W.
The normalizer condition in two-groups makes C_W(l) a Sylow subgroup of
C_M(l). Its order is smaller than |W|, which excludes fusion of l with a
central involution of W. The interfaces retain the ambient embeddings.

Source: D. Parrott, *A characterization of the Tits' simple group* (1972),
§4, Lemma 8, p.682, the weak-closure argument preceding Grün transfer.
-/

open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- A maximal p-subgroup of C bounds all p-subgroups of C. -/
public theorem card_le_of_saturated_subgroup {p : ℕ} [Fact p.Prime]
    (E C : Subgroup G) (hE : IsPGroup p E) (hEC : E ≤ C)
    (hmax : ∀ R : Subgroup G, IsPGroup p R → E ≤ R → R ≤ C → R = E)
    (U : Subgroup G) (hU : IsPGroup p U) (hUC : U ≤ C) :
    Nat.card U ≤ Nat.card E := by
  obtain ⟨S, hS⟩ := (hE.comap_subtype (K := C)).exists_le_sylow
  have hSE : (S : Subgroup C).map C.subtype = E :=
    hmax _ (S.isPGroup'.map _) (by
      rw [← map_subgroupOf_eq_of_le hEC]
      exact map_mono hS) (map_subtype_le _)
  obtain ⟨T, hT⟩ := (hU.comap_subtype (K := C)).exists_le_sylow
  calc
    Nat.card U = Nat.card (U.subgroupOf C) :=
      (Nat.card_congr (subgroupOfEquivOfLe hUC).toEquiv).symm
    _ ≤ Nat.card T := card_le_of_le hT
    _ = Nat.card S := Nat.card_congr (T.equiv S).toEquiv
    _ = Nat.card ((S : Subgroup C).map C.subtype) :=
      (card_map_of_injective C.subtype_injective).symm
    _ = Nat.card E := by rw [hSE]

/-- Local normalizer control prevents fusion of central involutions to noncentral ones. -/
public theorem conj_mem_center_of_involution_centralizer_normalizer
    (M W : Subgroup G) (hW : IsPGroup 2 W) (hWM : W ≤ M)
    (hcontrol : ∀ l ∈ W, orderOf l = 2 → l ∉ (center W).map W.subtype →
      M ⊓ normalizer (W ⊓ centralizer ({l} : Set G) : Set G) ≤ W)
    (x : G) (hx : x ∈ (center W).map W.subtype) (hx2 : orderOf x = 2)
    (m : M) (hl : (MulAut.conj (m : G)) x ∈ W) :
    (MulAut.conj (m : G)) x ∈ (center W).map W.subtype := by
  let f := MulAut.conj (m : G)
  let l := f x
  let E := W ⊓ centralizer ({l} : Set G)
  have hl2 : orderOf l = 2 := (f.orderOf_eq x).trans hx2
  by_contra hn
  have hmax : ∀ R : Subgroup G, IsPGroup 2 R → E ≤ R →
      R ≤ M ⊓ centralizer ({l} : Set G) → R = E := by
    apply saturated_of_normalizer_control E W (M ⊓ centralizer ({l} : Set G))
    · intro R _ hER hR
      exact le_antisymm (le_inf (hR.trans inf_le_left)
        (hR.trans (inf_le_right.trans inf_le_right))) hER
    · intro a ha
      exact hcontrol l hl hl2 hn ⟨ha.2.1, ha.1⟩
  have himage : W.map f.toMonoidHom ≤ M ⊓ centralizer ({l} : Set G) := by
    obtain ⟨xW, hxW, rfl⟩ := hx
    rintro y ⟨w, hw, rfl⟩
    refine ⟨M.mul_mem (M.mul_mem m.property (hWM hw)) (M.inv_mem m.property), ?_⟩
    apply mem_centralizer_singleton_iff.mpr
    exact (map_mul f w (xW : G)).symm.trans
      ((congrArg f (congrArg W.subtype (mem_center_iff.mp hxW ⟨w, hw⟩))).trans
        (map_mul f (xW : G) w))
  have hc := card_le_of_saturated_subgroup E (M ⊓ centralizer ({l} : Set G))
    hW.to_inf_left (le_inf (inf_le_left.trans hWM) inf_le_right) hmax
    (W.map f.toMonoidHom) (hW.map _) himage
  rw [card_map_of_injective f.injective] at hc
  have he : E = W := eq_of_le_of_card_ge inf_le_left hc
  apply hn
  refine ⟨⟨l, hl⟩, mem_center_iff.mpr ?_, rfl⟩
  intro w
  apply Subtype.ext
  exact mem_centralizer_singleton_iff.mp ((he.symm ▸ w.property : (w : G) ∈ E).2)

/-- An elementary center is strongly closed under this local normalizer condition. -/
public theorem conj_mem_center_of_centralizer_normalizer
    (M W : Subgroup G) (hW : IsPGroup 2 W) (hWM : W ≤ M)
    [IsElementaryAbelian 2 (center W)]
    (hcontrol : ∀ l ∈ W, orderOf l = 2 → l ∉ (center W).map W.subtype →
      M ⊓ normalizer (W ⊓ centralizer ({l} : Set G) : Set G) ≤ W)
    (x : G) (hx : x ∈ (center W).map W.subtype)
    (m : M) (hl : (MulAut.conj (m : G)) x ∈ W) :
    (MulAut.conj (m : G)) x ∈ (center W).map W.subtype := by
  by_cases hx1 : x = 1
  · simp [hx1]
  apply conj_mem_center_of_involution_centralizer_normalizer M W hW hWM hcontrol x hx ?_ m hl
  apply orderOf_eq_prime _ hx1
  obtain ⟨xW, hxW, rfl⟩ := hx
  exact congrArg W.subtype (elemPow_eq_one_of_isElementaryAbelian xW hxW)

/-- The center is weakly closed, with the subgroup equality kept explicit. -/
public theorem center_weakly_closed_of_centralizer_normalizer
    (M W : Subgroup G) (hW : IsPGroup 2 W) (hWM : W ≤ M)
    [IsElementaryAbelian 2 (center W)]
    (hcontrol : ∀ l ∈ W, orderOf l = 2 → l ∉ (center W).map W.subtype →
      M ⊓ normalizer (W ⊓ centralizer ({l} : Set G) : Set G) ≤ W) :
    ∀ m : M, ((center W).map W.subtype).map (MulAut.conj (m : G)).toMonoidHom ≤ W →
      ((center W).map W.subtype).map (MulAut.conj (m : G)).toMonoidHom =
        (center W).map W.subtype := by
  intro m hm
  apply eq_of_le_of_card_ge
  · rintro y ⟨x, hx, rfl⟩
    exact conj_mem_center_of_centralizer_normalizer M W hW hWM hcontrol x hx m
      (hm (mem_map_of_mem _ hx))
  · exact (card_map_of_injective (MulAut.conj (m : G)).injective).ge

/-- A derived involution line gives the local normalizer condition. -/
public theorem center_weakly_closed_of_centralizer_derived_lines
    (M W : Subgroup G) (hW : IsPGroup 2 W) (hWM : W ≤ M)
    [IsElementaryAbelian 2 (center W)]
    (hlines : ∀ l ∈ W, orderOf l = 2 → l ∉ (center W).map W.subtype →
      let E := W ⊓ centralizer ({l} : Set G)
      ∃ u : G, orderOf u = 2 ∧ (_root_.commutator E).map E.subtype = zpowers u ∧
        M ⊓ centralizer ({u} : Set G) ≤ W) :
    ∀ m : M, ((center W).map W.subtype).map (MulAut.conj (m : G)).toMonoidHom ≤ W →
      ((center W).map W.subtype).map (MulAut.conj (m : G)).toMonoidHom =
        (center W).map W.subtype := by
  apply center_weakly_closed_of_centralizer_normalizer M W hW hWM
  intro l hl hl2 hlZ
  obtain ⟨u, hu, hline, hC⟩ := hlines l hl hl2 hlZ
  exact (inf_le_inf_left M (normalizer_le_centralizer_of_characteristic_involution
    _ (_root_.commutator _) u hu hline)).trans hC
end Subgroup

namespace Subgroup
variable {G H : Type*} [Group G] [Group H]
/-- The ambient center of an injective subgroup image is the image of its center. -/
public theorem map_center_image_of_injective (U : Subgroup H) (f : H →* G)
    (hf : Function.Injective f) :
    (center (U.map f)).map (U.map f).subtype = (center U).map (f.comp U.subtype) := by
  ext x
  constructor
  · rintro ⟨w, hw, rfl⟩
    obtain ⟨u, hu, he⟩ := w.property
    refine ⟨⟨u, hu⟩, mem_center_iff.mpr ?_, he⟩
    intro y
    apply Subtype.ext
    apply hf
    have hh := congrArg (U.map f).subtype
      (mem_center_iff.mp hw ⟨f y, mem_map_of_mem f y.property⟩)
    change f (y : H) * (w : G) = (w : G) * f (y : H) at hh
    change f ((y : H) * u) = f (u * (y : H))
    simpa only [map_mul, he] using hh
  · rintro ⟨u, hu, rfl⟩
    refine ⟨⟨f u, mem_map_of_mem f u.property⟩, mem_center_iff.mpr ?_, rfl⟩
    intro w
    obtain ⟨y, hy, he⟩ := w.property
    apply Subtype.ext
    have hh := congrArg (f.comp U.subtype) (mem_center_iff.mp hu ⟨y, hy⟩)
    simp only [map_mul, MonoidHom.comp_apply] at hh
    change f y * f (u : H) = f (u : H) * f y at hh
    change (w : G) * f (u : H) = f (u : H) * (w : G)
    rwa [he] at hh
end Subgroup
namespace Subgroup
variable {G H : Type*} [Group G] [Group H]
/-- Weak closure transports to an injectively embedded ambient group. -/
public theorem weakly_closed_comap_of_injective (f : H →* G) (hf : Function.Injective f)
    (Z W : Subgroup G) (hZ : Z ≤ f.range) (hW : W ≤ f.range)
    (hweak : ∀ m : H, Z.map (MulAut.conj (f m)).toMonoidHom ≤ W →
      Z.map (MulAut.conj (f m)).toMonoidHom = Z) :
    ∀ m : H, (Z.comap f).map (MulAut.conj m).toMonoidHom ≤ W.comap f →
      (Z.comap f).map (MulAut.conj m).toMonoidHom = Z.comap f := by
  intro m hm
  have he : f.comp (MulAut.conj m).toMonoidHom =
      (MulAut.conj (f m)).toMonoidHom.comp f := by
    ext x
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
      map_mul, map_inv]
  have hmap : ((Z.comap f).map (MulAut.conj m).toMonoidHom).map f =
      Z.map (MulAut.conj (f m)).toMonoidHom := by
    rw [map_map, he, ← map_map, map_comap_eq_self hZ]
  apply map_injective hf
  rw [hmap, map_comap_eq_self hZ]
  apply hweak m
  rw [← hmap, ← map_comap_eq_self hW]
  exact map_mono hm
end Subgroup
