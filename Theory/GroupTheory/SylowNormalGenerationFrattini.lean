module

public import Theory.GroupTheory.SylowNormalClosure
public import Theory.ElementaryAbelian.Basic
public import Mathlib.GroupTheory.Frattini
public import Mathlib.GroupTheory.Perm.Sign

/-!
# Normal generation by Sylow subgroups through Frattini sections

In a finite group generated by involutions, each Sylow two-subgroup
normally generates the group: every involution lies in its normal closure.
Symmetric groups and their products satisfy this condition by transposition
generation. Normal generation lifts through a kernel lying in the Frattini
preimage above a normal subgroup already contained in the Sylow subgroup.

Source application: Aschbacher–Smith, combined manuscript (1 March 2004),
the S₃ and S₃ × S₃ sections in 15.3.11(5),(10), printed pp.1123–1124.
-/

public section
namespace Subgroup
variable {G D : Type*} [Group G] [Group D] [Finite G] [Finite D]

/-- Involution generation implies normal generation by any Sylow two-subgroup. -/
theorem normalClosure_sylow_eq_top_of_involutions (S : Sylow 2 G)
    (hgen : closure {g : G | g ^ 2 = 1} = ⊤) :
    normalClosure (S : Set G) = ⊤ := by
  apply top_unique
  rw [← hgen, closure_le]
  intro x hx
  exact ((IsElementaryAbelian.zpowers_of_pow_eq_one hx).isPGroup 2 _).le_normalClosure_sylow
    S (mem_zpowers x)

/-- Symmetric groups are generated by involutions, since transpositions suffice. -/
theorem symmetric_involutions_generate (α : Type*) [Finite α] :
    closure {g : Equiv.Perm α | g ^ 2 = 1} = ⊤ := by
  classical
  apply top_unique
  rw [← Equiv.Perm.closure_isSwap]
  apply closure_mono
  rintro g ⟨a, b, _, rfl⟩
  simp [pow_two]

/-- The involutions in the two factors generate their product. -/
theorem symmetric_product_involutions_generate (α β : Type*) [Finite α] [Finite β] :
    closure {g : Equiv.Perm α × Equiv.Perm β | g ^ 2 = 1} = ⊤ := by
  classical
  let C := closure {g : Equiv.Perm α × Equiv.Perm β | g ^ 2 = 1}
  have hl : ∀ g : Equiv.Perm α, (g, 1) ∈ C := by
    have hh : (⊤ : Subgroup (Equiv.Perm α)) ≤
        C.comap (MonoidHom.inl (Equiv.Perm α) (Equiv.Perm β)) := by
      rw [← symmetric_involutions_generate α, closure_le]
      intro g hg
      change g ^ 2 = 1 at hg
      exact subset_closure (show (g, (1 : Equiv.Perm β)) ^ 2 = 1 from Prod.ext hg (one_pow 2))
    exact fun g => hh (mem_top g)
  have hr : ∀ g : Equiv.Perm β, (1, g) ∈ C := by
    have hh : (⊤ : Subgroup (Equiv.Perm β)) ≤
        C.comap (MonoidHom.inr (Equiv.Perm α) (Equiv.Perm β)) := by
      rw [← symmetric_involutions_generate β, closure_le]
      intro g hg
      change g ^ 2 = 1 at hg
      exact subset_closure (show ((1 : Equiv.Perm α), g) ^ 2 = 1 from Prod.ext (one_pow 2) hg)
    exact fun g => hh (mem_top g)
  apply top_unique
  rintro ⟨g, h⟩ _
  simpa using C.mul_mem (hl g) (hr h)

/-- Normal generation lifts through a Frattini preimage once its lower
normal subgroup already lies in the chosen Sylow subgroup. -/
theorem normalClosure_sylow_eq_top_of_frattini_image (S : Sylow 2 G)
    (R : Subgroup G) [R.Normal] (hRS : R ≤ (S : Subgroup G))
    (f : G →* D) (hf : Function.Surjective f)
    (hker : f.ker ≤ (frattini (G ⧸ R)).comap (QuotientGroup.mk' R))
    (hD : closure {g : D | g ^ 2 = 1} = ⊤) :
    normalClosure (S : Set G) = ⊤ := by
  let N := normalClosure (S : Set G)
  let q := QuotientGroup.mk' R
  let F := (frattini (G ⧸ R)).comap q
  let : (N.map f).Normal := Normal.map inferInstance f hf
  have hNf : N.map f = ⊤ := by
    apply top_unique
    rw [← normalClosure_sylow_eq_top_of_involutions (S.mapSurjective hf) hD]
    apply normalClosure_le_normal
    exact map_mono le_normalClosure
  have hNF : N ⊔ F = ⊤ := by
    have hh := congrArg (comap f) hNf
    rw [comap_map_eq, comap_top] at hh
    exact top_unique (hh.symm.le.trans (sup_le_sup_left hker N))
  have hNq : N.map q = ⊤ := by
    apply frattini_nongenerating
    have hh := congrArg (map q) hNF
    rw [map_sup, map_top_of_surjective q (QuotientGroup.mk'_surjective R)] at hh
    have hF : F.map q = frattini (G ⧸ R) := by
      rw [map_comap_eq, MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective R), top_inf_eq]
    rwa [hF] at hh
  have hh := congrArg (comap q) hNq
  rw [comap_map_eq, comap_top, QuotientGroup.ker_mk'] at hh
  rw [sup_eq_left.mpr (show R ≤ N from hRS.trans le_normalClosure)] at hh
  exact hh

end Subgroup
end
