module
public import Theory.GroupTheory.SylowCentralizerComplement
public import Theory.GroupTheory.ConjugateSpanNormalizer
public import Theory.GroupTheory.Commutator.RelativeGeneration
public import Stellmacher.OmegaOneCenterMap
public import Theory.ElementaryAbelian.Injective
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Generating a moved module from its intersection with the Sylow omega-center

Let Z = Ω₁Z(S), with S Sylow in XS and normalizing X. If W = ⟨Z^X⟩
is elementary and lies in S, then U = [W,X] is generated by the X-conjugates
of U∩Z. Sylow averaging writes each seed vector as a moved vector times
an XS-fixed vector. Both factors lie in Z. Normal generation and the
centrality of the second factor then give the claimed generation of U.

Source: the B.2.14 step in Aschbacher--Smith 15.2.23, printed pp.1116--1117.
-/

public section
open Subgroup Stellmacher
open scoped IsMulCommutative commutatorElement
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- The moved group is generated by its original Sylow-fixed seed. -/
theorem conjugateSpanBy_moved_inf_omegaCenter
    (X S Z : Subgroup G) (hZ : Z = omegaOneCenterAmbient S)
    (hSX : S ≤ normalizer (X : Set G))
    [IsElementaryAbelian 2 (conjugateSpanBy Z X)]
    (hWS : conjugateSpanBy Z X ≤ S)
    (P : Sylow 2 (X ⊔ S : Subgroup G))
    (hP : (P : Subgroup (X ⊔ S : Subgroup G)).map (X ⊔ S).subtype = S) :
    conjugateSpanBy (⁅conjugateSpanBy Z X, X⁆ ⊓ Z) X =
      ⁅conjugateSpanBy Z X, X⁆ := by
  let W := conjugateSpanBy Z X
  let U := ⁅W,X⁆
  let E := X ⊔ S
  have hZW : Z ≤ W := le_conjugateSpanBy Z X
  have hSZ : S ≤ centralizer (Z : Set G) := by
    intro s hs z hz
    have hh := ((mem_omegaOneCenterAmbient_iff S z).mp (hZ ▸ hz)).2.2 s hs
    exact hh.symm
  have hXW : X ≤ normalizer (W : Set G) := le_normalizer_conjugateSpanBy Z X
  have hSW : S ≤ normalizer (W : Set G) :=
    normalizes_conjugateSpanBy Z X S
      (hSZ.trans (centralizer_le_normalizer _)) hSX
  have hEW : E ≤ normalizer (W : Set G) := sup_le hXW hSW
  have hEX : E ≤ normalizer (X : Set G) := sup_le X.le_normalizer hSX
  have hEU : E ≤ normalizer (U : Set G) := by
    intro e he
    apply mem_normalizer_iff_map_conj_eq.mpr
    change (⁅W,X⁆).map (MulAut.conj e).toMonoidHom = _
    have hw : W.map (MulAut.conj e).toMonoidHom = W :=
      mem_normalizer_iff_map_conj_eq.mp (hEW he)
    have hx : X.map (MulAut.conj e).toMonoidHom = X :=
      mem_normalizer_iff_map_conj_eq.mp (hEX he)
    rw [map_commutator, hw, hx]
  have hUW : U ≤ W := le_normalizer_iff_commutator_le_left.mp hXW
  have hEZ : ⁅E,Z⁆ ≤ U := by
    apply commutator_sup_le_of_relative_normal E X S Z U hEU le_sup_left le_sup_right
    · simpa only [commutator_comm X W] using commutator_mono (le_rfl : X ≤ X) hZW
    · exact (commutator_eq_bot_iff_le_centralizer.mpr hSZ).le.trans bot_le
  have hsplit (z : G) (hz : z ∈ Z) :
      ∃ u ∈ U ⊓ Z, u * z ∈ W ⊓ centralizer (X : Set G) := by
    let : IsElementaryAbelian 2 U :=
      IsElementaryAbelian.of_injective (inclusion hUW) (inclusion_injective hUW)
    obtain ⟨u,hu,hc⟩ := fixed_coset_of_sylow E U hEU
      (fun u hu => elemPow_eq_one_of_isElementaryAbelian u hu) P z
      (fun e he => hEZ (commutator_mem_commutator he hz))
      (fun e he => (hSZ (hP ▸ mem_map_of_mem E.subtype he) z hz).symm)
    have hcW : u*z ∈ W := W.mul_mem (hUW hu) (hZW hz)
    have hcZ : u*z ∈ Z := by
      rw [hZ]
      apply (mem_omegaOneCenterAmbient_iff S _).mpr
      exact ⟨hWS hcW, elemPow_eq_one_of_isElementaryAbelian _ hcW,
        fun s hs => hc s (mem_sup_right hs)⟩
    have huZ : u ∈ Z := by
      simpa only [mul_inv_cancel_right] using Z.mul_mem hcZ (Z.inv_mem hz)
    exact ⟨u, ⟨hu,huZ⟩, hcW, centralizer_le (show X ≤ E from le_sup_left) hc⟩
  let D := conjugateSpanBy (U ⊓ Z) X
  let C := W ⊓ centralizer (X : Set G)
  have hDU : D ≤ U := conjugateSpanBy_le inf_le_left (le_sup_left.trans hEU)
  have hXD : X ≤ normalizer (D : Set G) := le_normalizer_conjugateSpanBy _ _
  have hXC : X ≤ normalizer (C : Set G) :=
    (le_inf hXW (X.le_normalizer.trans (normalizer_le_normalizer_centralizer X))).trans
      inf_normalizer_le_normalizer_inf
  have hWDC : W ≤ D ⊔ C := by
    apply conjugateSpanBy_le ?_
      ((le_inf hXD hXC).trans (normalizer_inf_normalizer_le_normalizer_sup D C))
    intro z hz
    obtain ⟨u,hu,hc⟩ := hsplit z hz
    have hprod := mul_mem_sup
      (D.inv_mem (le_conjugateSpanBy (U ⊓ Z) X hu)) hc
    simpa only [inv_mul_cancel_left] using hprod
  have hWD : W ≤ normalizer (D : Set G) :=
    ((le_centralizer_iff_isMulCommutative.mpr inferInstance).trans
      (centralizer_le (hDU.trans hUW))).trans (centralizer_le_normalizer _)
  have hDX : ⁅D ⊔ C,X⁆ ≤ D :=
    commutator_sup_le_of_relative_normal W D C X D hWD
      (hDU.trans hUW) inf_le_left
      (le_normalizer_iff_commutator_le_left.mp hXD)
      ((commutator_eq_bot_iff_le_centralizer.mpr inf_le_right).le.trans bot_le)
  exact le_antisymm hDU ((commutator_mono hWDC le_rfl).trans hDX)

end Subgroup
