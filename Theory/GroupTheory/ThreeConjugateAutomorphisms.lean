module

public import Mathlib.GroupTheory.Subgroup.Simple
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.GroupTheory.GroupAction.ConjAct

/-!
# Three-conjugate generation by involutory automorphisms

The condition below says that a nonidentity involutory automorphism, together
with two conjugates by inner automorphisms, generates a subgroup containing
the whole inner automorphism group. It records actual subgroup containment,
with conjugators in the original group, rather than an almost-simple group tag.

It is only a definition; no assertion is made for an arbitrary group. It is the
condition α_S(t) ≤ 3 used in Revin–Zavarnitsine, *Conjugate generation of sporadic
almost simple groups*, arXiv:2505.05173v2, Theorems 1–2. Concrete producers and
lifting to perfect central covers are separate obligations.
-/

@[expose] public section
namespace Theory.GroupTheory
open Subgroup

/-- The inner automorphism group is contained in the subgroup generated by
three specified inner conjugates of any nonidentity involutory automorphism. -/
def ThreeConjugateAutomorphisms (S : Type*) [Group S] : Prop :=
  ∀ t : MulAut S, t ≠ 1 → t ^ 2 = 1 →
    ∃ g h : S, (MulAut.conj : S →* MulAut S).range ≤
      zpowers t ⊔ zpowers (MulAut.conj g * t * (MulAut.conj g)⁻¹) ⊔
        zpowers (MulAut.conj h * t * (MulAut.conj h)⁻¹)

end Theory.GroupTheory
