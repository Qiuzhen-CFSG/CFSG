module

public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Detecting nontrivial action on a generated subgroup

A subgroup centralizes a supremum precisely when it centralizes every generating
subgroup. Negating this gives the equivalence between nontrivial action on
`R₂(H)` and on some member of its defining family in Aschbacher–Smith,
*The Classification of Quasithin Groups*, Lemma 1.2.10(2–3), printed p. 507.
No closure property of the generating family is needed for this implication.
-/

namespace Theory.GroupTheory

/-- A subgroup acts nontrivially on the subgroup generated by a family precisely
when it acts nontrivially on one of the members. -/
public theorem commutator_sSup_ne_bot_iff {G : Type*} [Group G]
    (F : Set (Subgroup G)) (L : Subgroup G) :
    ⁅sSup F, L⁆ ≠ ⊥ ↔ ∃ V ∈ F, ⁅V, L⁆ ≠ ⊥ := by
  classical
  simp only [ne_eq, Subgroup.commutator_eq_bot_iff_le_centralizer, sSup_le_iff,
    not_forall, exists_prop]

end Theory.GroupTheory
