module

public import Theory.GroupTheory.Commutator.CentralExtensionPairing
public import Theory.GroupTheory.PerfectCentralCoverAbelianSylow

/-!
# Partial inversion in a central extension

Suppose two commuting elements generate a Sylow subgroup of odd order. An
ambient element inverting the first generator and fixing the second forces
the commutator of any two lifts to be its own inverse. The odd order of the
first generator also annihilates that commutator, so the lifts commute.
The full Sylow preimage is therefore abelian, and central Sylow transfer
excludes the Sylow prime from the kernel of any finite perfect central cover.

This is the elementary local calculation used for the five-primary part of
the G₂(4) multiplier (Aschbacher–Smith I.1.3(1), GLS III §6.1).
-/

open scoped commutatorElement IsMulCommutative
open Subgroup

namespace CentralExtension

variable {E G : Type*} [Group E] [Group G]

/-- Partial inversion of a commuting pair of odd order forces arbitrary
lifts of that pair to commute in every central extension. -/
public theorem commute_lifts_of_partial_inversion
    (f : E →* G) (hf : Function.Surjective f)
    (hk : f.ker ≤ center E) (x y r : G) {n : ℕ}
    (hn : n.Coprime 2) (hx : x ^ n = 1) (hxy : Commute x y)
    (hrx : r * x * r⁻¹ = x⁻¹) (hry : Commute r y)
    (a b : E) (ha : f a = x) (hb : f b = y) : Commute a b := by
  have hc : ⁅a, b⁆ ∈ center E := hk (by
    rw [MonoidHom.mem_ker, map_commutatorElement, ha, hb]
    exact hxy.commutator_eq)
  have hconj (t : E) : t * ⁅a, b⁆ * t⁻¹ = ⁅a, b⁆ := by
    rw [mem_center_iff.mp hc t, mul_inv_cancel_right]
  obtain ⟨s, hs⟩ := hf r
  have he : ⁅a, b⁆ = ⁅a⁻¹, b⁆ := by
    rw [← hconj s, conjugate_commutatorElement]
    apply commutator_eq_of_image_eq f hk
    · simp only [map_mul, map_inv, hs, ha, hrx]
    · simp only [map_mul, map_inv, hs, hb]
      rw [hry.eq, mul_inv_cancel_right]
  have hinv : ⁅a⁻¹, b⁆ = ⁅a, b⁆⁻¹ := by
    rw [commutatorElement_inv_left, ← commutatorElement_inv]
    have hc' := mem_center_iff.mp ((center E).inv_mem hc) a⁻¹
    rw [hc', inv_mul_cancel_right]
  have htwo : ⁅a, b⁆ ^ 2 = 1 := by
    rw [pow_two, he.trans hinv, inv_mul_eq_one]
    exact he.trans hinv
  have hpow (k : ℕ) : ⁅a ^ k, b⁆ = ⁅a, b⁆ ^ k := by
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, commutatorElement_mul_left_eq_conj_mul, hconj, ih, pow_succ']
  have hncomm : ⁅a, b⁆ ^ n = 1 := by
    rw [← hpow]
    apply Commute.commutator_eq
    exact (mem_center_iff.mp (hk (by
      rw [MonoidHom.mem_ker, map_pow, ha, hx])) b).symm
  apply commutatorElement_eq_one_iff_mul_comm.mp
  exact orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes hn
    (orderOf_dvd_of_pow_eq_one hncomm) (orderOf_dvd_of_pow_eq_one htwo))

/-- A subgroup generated by two elements with commuting lifts has abelian
full preimage under a central extension. -/
public theorem isMulCommutative_comap_of_pair_lifts
    (f : E →* G) (hk : f.ker ≤ center E) (Q : Subgroup G)
    (a b : E) (hab : Commute a b)
    (hQ : closure ({f a, f b} : Set G) = Q) :
    IsMulCommutative (Q.comap f) := by
  let L : Subgroup E := closure ({a, b} : Set E)
  have hL : IsMulCommutative L := by
    apply isMulCommutative_closure
    intro u hu v hv
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hu hv
    rcases hu with rfl | rfl <;> rcases hv with rfl | rfl
    · rfl
    · exact hab.eq
    · exact hab.eq.symm
    · rfl
  have hmap : L.map f = Q := by
    simpa only [L, MonoidHom.map_closure, Set.image_insert_eq,
      Set.image_singleton] using hQ
  have hle : Q.comap f ≤ center E ⊔ L := by
    rw [← hmap, comap_map_eq]
    exact sup_le le_sup_right (hk.trans le_sup_left)
  have hcomm : IsMulCommutative (center E ⊔ L : Subgroup E) := by
    apply le_centralizer_iff_isMulCommutative.mp
    apply sup_le (center_le_centralizer _)
    apply le_centralizer_iff.mpr
    exact sup_le (center_le_centralizer _)
      (le_centralizer_iff_isMulCommutative.mpr hL)
  exact le_centralizer_iff_isMulCommutative.mp
    (hle.trans ((le_centralizer_iff_isMulCommutative.mpr hcomm).trans
      (centralizer_le hle)))

/-- Transfer excludes an odd Sylow prime when the base Sylow subgroup has
two generators with a partial inverter. -/
public theorem not_dvd_card_kernel_of_partial_inversion
    [Finite E] [Group.IsPerfect E] [Finite G]
    (f : E →* G) (hf : Function.Surjective f) (hk : f.ker ≤ center E)
    {p : ℕ} [Fact p.Prime] (Q : Sylow p G) (x y r : G)
    (hQ : closure ({x, y} : Set G) = (Q : Subgroup G))
    {n : ℕ} (hn : n.Coprime 2) (hx : x ^ n = 1) (hxy : Commute x y)
    (hrx : r * x * r⁻¹ = x⁻¹) (hry : Commute r y) :
    ¬ p ∣ Nat.card f.ker := by
  obtain ⟨a, ha⟩ := hf x
  obtain ⟨b, hb⟩ := hf y
  have hab := commute_lifts_of_partial_inversion f hf hk x y r hn hx hxy hrx hry a b ha hb
  exact PerfectCentralCovering.not_dvd_card_kernel_of_abelian_sylow_preimage f hf hk Q
    (isMulCommutative_comap_of_pair_lifts f hk Q a b hab (by simpa [ha, hb] using hQ))

end CentralExtension
