module
public import Theory.GroupTheory.ConjugateSpanOrder
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Closure generated by whole conjugate subgroups

The closure in P is generated by the ambient conjugates of Z wholly
contained in P. The normalizer of P preserves this construction. These
lemmas retain whole subgroup containment, as needed in Aschbacher–Smith
2.4.16(3), 2.4.19 and 2.4.20(6), printed pp.533–535.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

/-- The subgroup generated by those whole ambient conjugates of Z that
are contained in P. -/
@[expose] def conjugateSubgroupClosure (Z P : Subgroup G) : Subgroup G :=
  closure {a | ∃ g : G, Z.map (MulAut.conj g).toMonoidHom ≤ P ∧
    a ∈ Z.map (MulAut.conj g).toMonoidHom}

theorem conjugateSubgroupClosure_le {Z P R : Subgroup G}
    (h : ∀ g : G, Z.map (MulAut.conj g).toMonoidHom ≤ P →
      Z.map (MulAut.conj g).toMonoidHom ≤ R) : conjugateSubgroupClosure Z P ≤ R := by
  apply (closure_le _).mpr
  rintro a ⟨g,hg,ha⟩
  exact h g hg ha

theorem conjugateSubgroupClosure_le_self (Z P : Subgroup G) :
    conjugateSubgroupClosure Z P ≤ P := conjugateSubgroupClosure_le fun _ h => h

theorem map_conj_le_conjugateSubgroupClosure (Z : Subgroup G) {P : Subgroup G}
    (g : G) (hg : Z.map (MulAut.conj g).toMonoidHom ≤ P) :
    Z.map (MulAut.conj g).toMonoidHom ≤ conjugateSubgroupClosure Z P :=
  fun _ ha => subset_closure ⟨g,hg,ha⟩

theorem conjugateSubgroupClosure_mono {Z P Q : Subgroup G} (h : P ≤ Q) :
    conjugateSubgroupClosure Z P ≤ conjugateSubgroupClosure Z Q :=
  conjugateSubgroupClosure_le fun g hg => map_conj_le_conjugateSubgroupClosure Z g (hg.trans h)

theorem normalizer_le_normalizer_conjugateSubgroupClosure (Z P : Subgroup G) :
    normalizer (P : Set G) ≤ normalizer (conjugateSubgroupClosure Z P : Set G) := by
  apply le_normalizer_closure_iff.mpr
  rintro x hx a ⟨g,hg,ha⟩
  have he : Z.map (MulAut.conj (x*g)).toMonoidHom =
      (Z.map (MulAut.conj g).toMonoidHom).map (MulAut.conj x).toMonoidHom :=
    conjBy_mul Z x g
  apply subset_closure
  refine ⟨x*g,?_,?_⟩
  · rw [he]
    exact (map_mono hg).trans_eq (mem_normalizer_iff_map_conj_eq.mp hx)
  · rw [he]
    exact mem_map_of_mem (MulAut.conj x).toMonoidHom ha

theorem le_normalizer_conjugateSubgroupClosure (Z P : Subgroup G) :
    P ≤ normalizer (conjugateSubgroupClosure Z P : Set G) :=
  P.le_normalizer.trans (normalizer_le_normalizer_conjugateSubgroupClosure Z P)

/-- A seed conjugate and an actor preserving P generate inside the closure. -/
theorem conjugateSpanBy_le_conjugateSubgroupClosure (Z : Subgroup G) {P H : Subgroup G}
    (g : G) (hg : Z.map (MulAut.conj g).toMonoidHom ≤ P)
    (hH : H ≤ normalizer (P : Set G)) :
    conjugateSpanBy (Z.map (MulAut.conj g).toMonoidHom) H ≤ conjugateSubgroupClosure Z P :=
  conjugateSpanBy_le (map_conj_le_conjugateSubgroupClosure Z g hg)
    (hH.trans (normalizer_le_normalizer_conjugateSubgroupClosure Z P))
end Subgroup
