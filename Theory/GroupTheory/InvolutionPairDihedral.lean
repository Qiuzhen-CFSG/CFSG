module
public import Theory.GroupTheory.DihedralGeneratedFactor

/-!
# The dihedral group of two involutions

For involutions a and b with product order m > 2, a lies outside the
cyclic group generated by ab: otherwise commuting and inversion force
(ab)² = 1. The cyclic subgroup and a therefore give the dihedral model
of order 2m. The resulting isomorphism concerns the actual generated join.
Source application: Aschbacher--Smith F.9.5(6.ii) and 12.6.26.
-/

public section
namespace Theory.GroupTheory
open Subgroup
variable {G : Type*} [Group G]

/-- Two involutions whose product has order greater than two generate the
literal dihedral model with that rotation order. -/
theorem involution_pair_dihedral (a b : G) (ha : a^2=1) (hb : b^2=1)
    {m : ℕ} (hm : 2<m) (hab : orderOf (a*b)=m) :
    Nonempty ((zpowers a ⊔ zpowers b : Subgroup G) ≃* DihedralGroup m) := by
  have haa : a*a=1 := by simpa only [pow_two] using ha
  have hbb : b*b=1 := by simpa only [pow_two] using hb
  have hai : a⁻¹=a := inv_eq_of_mul_eq_one_right haa
  have hbi : b⁻¹=b := inv_eq_of_mul_eq_one_right hbb
  have hinv : a*(a*b)*a⁻¹=(a*b)⁻¹ := by
    rw [_root_.mul_inv_rev,hai,hbi]
    simp only [←mul_assoc,haa,one_mul]
  have hout : a ∉ zpowers (a*b) := by
    intro h
    have hc : Commute a (a*b) := by
      obtain ⟨k,hk⟩ := mem_zpowers_iff.mp h
      exact Eq.mp (congrArg (fun x => Commute x (a*b)) hk) ((Commute.refl (a*b)).zpow_left k)
    have hi : a*(a*b)*a⁻¹=a*b := by rw [hc.eq,mul_assoc,mul_inv_cancel,mul_one]
    have hsq : (a*b)^2=1 := by
      have he := hi.symm.trans hinv
      rw [pow_two]
      calc
        (a*b)*(a*b) = (a*b)*(a*b)⁻¹ := congrArg ((a*b)*·) he
        _ = 1 := mul_inv_cancel _
    have hd : m ∣ 2 := hab ▸ orderOf_dvd_of_pow_eq_one hsq
    have := Nat.le_of_dvd (by decide : 0<2) hd
    omega
  have hgen : zpowers (a*b) ⊔ zpowers a = zpowers a ⊔ zpowers b := by
    apply le_antisymm
    · refine sup_le (zpowers_le.mpr ?_) le_sup_left
      exact mul_mem_sup (mem_zpowers _) (mem_zpowers _)
    · refine sup_le le_sup_right (zpowers_le.mpr ?_)
      have he : a*(a*b)=b := by rw [←mul_assoc,haa,one_mul]
      have hh := (zpowers (a*b) ⊔ zpowers a).mul_mem
        (mem_sup_right (mem_zpowers a)) (mem_sup_left (mem_zpowers (a*b)))
      exact Eq.mp (congrArg (fun x => x ∈ zpowers (a*b) ⊔ zpowers a) he) hh
  rw [←hgen]
  exact (DihedralGroup.sup_zpowers_equiv_of_inversion (by omega) (a*b) a hab ha hout hinv).2
end Theory.GroupTheory
