module
public import Theory.GroupTheory.SolvableOuterQuotient
public import Theory.GroupTheory.AutomorphismOvergroupCore
public import Theory.GroupTheory.PPerfectHom
public import Theory.GroupTheory.Commutator.SmallNormalizedImage
public import Theory.ElementaryAbelian.Injective
public import Mathlib.GroupTheory.Sylow

/-!
# Elementary displacement with cyclic normal Sylow subgroups

Suppose K is centerless, Out(K) is a two-group, and every normal elementary
subgroup of a specified Sylow two-subgroup has order at most two. A binary
elementary subgroup of Aut(K), normalized by that Sylow's inner action,
cannot be generated by commutators with a two-perfect automorphism group.
The latter acts inner; the elementary displacement therefore lies in K,
is normal in its Sylow subgroup, and has trivial automorphism group.

Source application: Aschbacher--Smith 15.1.20(3), odd-characteristic row,
printed p.1097. The statement retains the actual automorphism subgroups.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {K : Type*} [Group K] [Finite K]

theorem elementary_moved_eq_bot_of_normal_elementary_bound
    (hz : center K = ⊥) (ho : IsPGroup 2 (MulAut.Outer K))
    (P : Sylow 2 K)
    (hsmall : ∀ E : Subgroup P, E.Normal → IsElementaryAbelian 2 E → Nat.card E ≤ 2)
    (A B : Subgroup (MulAut K)) [IsElementaryAbelian 2 A]
    (hB : IsPPerfect 2 B)
    (hPA : (P : Subgroup K).map (MulAut.conj : K →* MulAut K) ≤ normalizer (A : Set (MulAut K)))
    (hmove : ⁅A,B⁆ = A) : A = ⊥ := by
  let c : K →* MulAut K := MulAut.conj
  have hci : Function.Injective c := conj_injective_of_center_eq_bot hz
  have hBI : B ≤ MulAut.innerSubgroup K := by
    let q := QuotientGroup.mk' (MulAut.innerSubgroup K)
    have hf := hB.hom_eq_one_of_isPGroup ho (q.comp B.subtype)
    intro b hb
    exact (QuotientGroup.eq_one_iff _).mp (DFunLike.congr_fun hf ⟨b,hb⟩)
  have hAI : A ≤ c.range := by
    rw [←hmove]
    exact (commutator_mono le_rfl hBI).trans (commutator_le_right _ _)
  let E := A.comap c
  have hEA : E.map c = A := map_comap_eq_self hAI
  let f : E →* A := c.restrict (fun x hx => hx)
  have hfi : Function.Injective f := by
    intro x y he
    exact Subtype.ext (hci (congrArg Subtype.val he))
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.of_injective f hfi
  have hPE : (P : Subgroup K) ≤ normalizer (E : Set K) := by
    intro x hx
    apply mem_normalizer_iff.mpr
    intro y
    change c y ∈ A ↔ c (x*y*x⁻¹) ∈ A
    rw [map_mul,map_mul,map_inv]
    exact (hPA (mem_map_of_mem c hx)) (c y)
  have hEP : E ≤ (P : Subgroup K) := by
    let N := normalizer (E : Set K)
    have hh := ((IsElementaryAbelian.isPGroup 2 E).of_equiv
      (subgroupOfEquivOfLe E.le_normalizer).symm).le_sylow_of_normal (P.subtype hPE)
    have hm := map_mono (f := N.subtype) hh
    change (E.subgroupOf N).map N.subtype ≤
      ((P : Subgroup K).subgroupOf N).map N.subtype at hm
    rw [map_subgroupOf_eq_of_le E.le_normalizer, map_subgroupOf_eq_of_le hPE] at hm
    exact hm
  have hn : (E.subgroupOf (P : Subgroup K)).Normal := normal_subgroupOf_of_le_normalizer hPE
  have he : IsElementaryAbelian 2 (E.subgroupOf (P : Subgroup K)) :=
    IsElementaryAbelian.subgroupOf hEP
  have hcard : Nat.card A ≤ 2 := by
    rw [←hEA,card_map_of_injective hci,
      ← Nat.card_congr (subgroupOfEquivOfLe hEP).toEquiv]
    exact hsmall _ hn he
  have hnB : B ≤ normalizer (A : Set (MulAut K)) :=
    le_normalizer_iff_commutator_le_left.mpr hmove.le
  have hh := commutator_le_ker_of_normalized_image_card_le_two
    (MonoidHom.id (MulAut K)) B A hnB (by simpa only [map_id] using hcard)
  rw [commutator_comm,hmove,MonoidHom.ker_id] at hh
  exact bot_unique hh
end Theory.GroupTheory
