module
public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# A point-centralizer Sylow supplement from orbit control

Let T be a Sylow p-subgroup normalizing L. If every T-conjugate of v is
L-conjugate to v, then LT is generated by L and its point centralizer.
The quotient LT/L is a p-group. A supplied Sylow subgroup of C_G(v) whose
ambient image is C_T(v) therefore maps onto that quotient, proving
T ≤ L ∨ C_T(v).

The proof restricts the supplied Sylow along the literal inclusion of
C_LT(v) into C_G(v); it does not replace it by an unspecified conjugate.

Source: Aschbacher--Smith, 12.2.16, printed p.800. The marked A₈ application
is in FusionEightGeometryModuleSupplement.
-/

public noncomputable section
open Subgroup
namespace Sylow
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

/-- Orbit control by a normalized subgroup makes the supplied point Sylow a
supplement in its join with the ambient Sylow. -/
theorem le_sup_pointCentralizer_of_orbit_control
    (T : Sylow p G) (L : Subgroup G)
    (hn : (T : Subgroup G) ≤ normalizer (L : Set G)) (v : G)
    (P : Sylow p (centralizer ({v} : Set G)))
    (hP : (P : Subgroup (centralizer ({v} : Set G))).map
      (centralizer ({v} : Set G)).subtype =
        (T : Subgroup G) ⊓ centralizer ({v} : Set G))
    (ho : ∀ t ∈ (T : Subgroup G), ∃ l ∈ L, t * v * t⁻¹ = l * v * l⁻¹) :
    (T : Subgroup G) ≤ L ⊔ ((T : Subgroup G) ⊓ centralizer ({v} : Set G)) := by
  let H := L ⊔ (T : Subgroup G)
  let N := L.subgroupOf H
  let Z := centralizer ({v} : Set G)
  let B := H ⊓ Z
  let K := B.subgroupOf H
  let : N.Normal := normal_subgroupOf_of_le_normalizer (sup_le L.le_normalizer hn)
  have hcover : L ⊔ B = H := by
    apply le_antisymm (sup_le le_sup_left inf_le_left)
    apply sup_le le_sup_left
    intro t ht
    obtain ⟨l,hl,he⟩ := ho t ht
    have hc : l⁻¹ * t ∈ Z := by
      apply mem_centralizer_singleton_iff.mpr
      have hh := congrArg (fun x : G => l⁻¹ * x * t) he
      simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using hh
    have hB : l⁻¹ * t ∈ B := ⟨H.mul_mem (H.inv_mem ((le_sup_left : L ≤ H) hl))
      ((le_sup_right : (T : Subgroup G) ≤ H) ht), hc⟩
    have hh := (L ⊔ B).mul_mem ((le_sup_left : L ≤ L ⊔ B) hl)
      ((le_sup_right : B ≤ L ⊔ B) hB)
    simpa only [mul_inv_cancel_left] using hh
  have hNK : N ⊔ K = ⊤ := by
    rw [← subgroupOf_sup (show L ≤ H from le_sup_left) (show B ≤ H from inf_le_left),
      hcover, subgroupOf_self]
  have hNT : N ⊔ (T : Subgroup G).subgroupOf H = ⊤ := by
    rw [← subgroupOf_sup (show L ≤ H from le_sup_left) le_sup_right, subgroupOf_self]
  have hquot : IsPGroup p (H ⧸ N) := isPGroup_quotient_of_sup_eq_top N _
    T.isPGroup'.comap_subtype hNT
  let q := QuotientGroup.mk' N
  let f : K →* H ⧸ N := q.comp K.subtype
  have hf : Function.Surjective f := by
    apply MonoidHom.range_eq_top.mp
    have hh := congrArg (Subgroup.map q) hNK
    simpa only [f, MonoidHom.range_comp, range_subtype, Subgroup.map_sup, q,
      QuotientGroup.map_mk'_self, bot_sup_eq,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective N)] using hh
  let j : K →* Z := (H.subtype.comp K.subtype).codRestrict Z (fun x => x.property.2)
  have hj : Function.Injective j := by
    intro x y he
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun z : Z => (z : G)) he
  have hPr : (P : Subgroup Z) ≤ j.range := by
    intro x hx
    have hxT : (x : G) ∈ (T : Subgroup G) :=
      (hP ▸ mem_map_of_mem Z.subtype hx).1
    refine ⟨⟨⟨x, (le_sup_right : (T : Subgroup G) ≤ H) hxT⟩,
      ⟨(le_sup_right : (T : Subgroup G) ≤ H) hxT, x.property⟩⟩, ?_⟩
    rfl
  let S : Sylow p K := P.comapOfInjective j hj hPr
  have hStop : ((S.mapSurjective hf : Sylow p (H ⧸ N)) : Subgroup (H ⧸ N)) = ⊤ :=
    (Sylow.is_maximal' _ (hquot.to_subgroup ⊤) le_top).symm
  intro t ht
  let t' : H := ⟨t,(le_sup_right : (T : Subgroup G) ≤ H) ht⟩
  obtain ⟨s, hs, he⟩ := (show q t' ∈ (S : Subgroup K).map f by
    rw [← Sylow.coe_mapSurjective hf S, hStop]; trivial)
  have hsP : j s ∈ (P : Subgroup Z) := hs
  have hsT : (s : H).val ∈ (T : Subgroup G) ⊓ Z :=
    hP ▸ mem_map_of_mem Z.subtype hsP
  have hker : t' * (s : H)⁻¹ ∈ N := by
    apply (QuotientGroup.eq_one_iff _).mp
    change q (t' * (s : H)⁻¹) = 1
    rw [map_mul, map_inv, show q (s : H) = q t' from he, mul_inv_cancel]
  have hm := (L ⊔ ((T : Subgroup G) ⊓ Z)).mul_mem
    ((le_sup_left : L ≤ L ⊔ ((T : Subgroup G) ⊓ Z)) hker)
    ((le_sup_right : (T : Subgroup G) ⊓ Z ≤ L ⊔ ((T : Subgroup G) ⊓ Z)) hsT)
  change (t * ((s : H) : G)⁻¹) * ((s : H) : G) ∈
    L ⊔ ((T : Subgroup G) ⊓ Z) at hm
  simpa only [inv_mul_cancel_right] using hm
end Sylow
