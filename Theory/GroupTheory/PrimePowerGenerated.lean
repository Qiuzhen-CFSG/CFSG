module

public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.GroupTheory.OrderOfElement

/-!
# The subgroup generated by prime-power elements

For a prime `p`, the subgroup `primePowerGenerated p G` is the subgroup
usually denoted `O^{p'}(G)`: it is generated by elements killed by some power
of `p`. This is the subgroup used to pass from rational fixed points to a
finite group of Lie type in GLS3, §§2.1–2.2
(`refs/KGroup/GLS3/chapter2.tex`, especially Theorem 2.1.8).

The construction is functorial under group homomorphisms and characteristic.
It is idempotent, and a surjective image of a group generated by its
`p`-elements is again generated by its `p`-elements. These elementary facts
apply before or after the central quotient in the twisted constructions.
-/

@[expose] public section

namespace Subgroup

variable {G H : Type*} [Group G] [Group H]

/-- The subgroup generated by elements killed by powers of `p`. For prime `p`
this is the prime-to-`p` residual `O^{p'}(G)`. -/
def primePowerGenerated (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  closure {g : G | ∃ n : ℕ, g ^ (p ^ n) = 1}

theorem mem_primePowerGenerated_of_pow {p n : ℕ} {g : G}
    (hg : g ^ (p ^ n) = 1) : g ∈ primePowerGenerated p G :=
  subset_closure ⟨n, hg⟩

theorem primePowerGenerated_le_iff (p : ℕ) (K : Subgroup G) :
    primePowerGenerated p G ≤ K ↔
      ∀ (g : G) (n : ℕ), g ^ (p ^ n) = 1 → g ∈ K := by
  simp only [primePowerGenerated, closure_le, Set.subset_def, Set.mem_ofPred_eq]
  exact ⟨fun h g n hn => h g ⟨n, hn⟩, fun h g ⟨n, hn⟩ => h g n hn⟩

/-- For prime `p`, the power-torsion definition is exactly generation by
prime-power-order elements, including the identity. -/
theorem primePowerGenerated_eq_closure_orderOf (p : ℕ) [Fact p.Prime] :
    primePowerGenerated p G = closure {g : G | ∃ n : ℕ, orderOf g = p ^ n} := by
  unfold primePowerGenerated
  congr 1
  ext g
  constructor
  · rintro ⟨n, hn⟩
    obtain ⟨k, _, hk⟩ := (Nat.dvd_prime_pow (Fact.out : p.Prime)).mp
      (orderOf_dvd_of_pow_eq_one hn)
    exact ⟨k, hk⟩
  · rintro ⟨n, hn⟩
    exact ⟨n, hn ▸ pow_orderOf_eq_one g⟩

/-- Every homomorphism preserves the prime-power-generated subgroup. -/
theorem map_primePowerGenerated_le (p : ℕ) (f : G →* H) :
    (primePowerGenerated p G).map f ≤ primePowerGenerated p H := by
  rw [map_le_iff_le_comap, primePowerGenerated_le_iff]
  intro g n hn
  apply mem_primePowerGenerated_of_pow (n := n)
  rw [← map_pow, hn, map_one]

/-- Internal generation in a subgroup agrees with the corresponding ambient
closure. This allows fixed-point constructions to be expressed without
nested subtype equations. -/
theorem map_primePowerGenerated_subtype (p : ℕ) (K : Subgroup G) :
    (primePowerGenerated p K).map K.subtype =
      closure {g : G | g ∈ K ∧ ∃ n : ℕ, g ^ (p ^ n) = 1} := by
  rw [primePowerGenerated, MonoidHom.map_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨x, ⟨n, hn⟩, rfl⟩
    exact ⟨x.property, n, congrArg Subtype.val hn⟩
  · rintro ⟨hg, n, hn⟩
    exact ⟨⟨g, hg⟩, ⟨n, Subtype.ext hn⟩, rfl⟩

theorem map_primePowerGenerated_equiv (p : ℕ) (e : G ≃* H) :
    (primePowerGenerated p G).map e.toMonoidHom = primePowerGenerated p H := by
  apply le_antisymm (map_primePowerGenerated_le p e.toMonoidHom)
  have h := map_mono (f := e.toMonoidHom)
    (map_primePowerGenerated_le p e.symm.toMonoidHom)
  simpa [map_map] using h

instance primePowerGenerated_characteristic (p : ℕ) :
    (primePowerGenerated p G).Characteristic :=
  characteristic_iff_map_le.mpr (fun e => map_primePowerGenerated_le p e.toMonoidHom)

/-- No additional prime-power elements need to be adjoined on repeating the
construction inside its own output. -/
theorem primePowerGenerated_self (p : ℕ) :
    primePowerGenerated p (primePowerGenerated p G) = ⊤ := by
  let K := primePowerGenerated p G
  have hmap : (primePowerGenerated p K).map K.subtype = K := by
    apply le_antisymm (map_primePowerGenerated_le p K.subtype)
    rw [primePowerGenerated_le_iff]
    intro g n hn
    let x : K := ⟨g, mem_primePowerGenerated_of_pow hn⟩
    refine ⟨x, mem_primePowerGenerated_of_pow (n := n) ?_, rfl⟩
    exact Subtype.ext hn
  apply top_unique
  intro x _
  have hx : (x : G) ∈ (primePowerGenerated p K).map K.subtype := by
    rw [hmap]
    exact x.property
  obtain ⟨y, hy, he⟩ := hx
  have : y = x := Subtype.ext he
  exact this ▸ hy

/-- Generation by prime-power elements passes to every surjective image,
in particular to a central quotient. -/
theorem primePowerGenerated_eq_top_of_surjective (p : ℕ) (f : G →* H)
    (hf : Function.Surjective f) (hG : primePowerGenerated p G = ⊤) :
    primePowerGenerated p H = ⊤ := by
  apply top_unique
  have h := map_primePowerGenerated_le p f
  rw [hG, map_top_of_surjective f hf] at h
  exact h

end Subgroup
