module
public import Theory.GroupTheory.CentralExtensionSwap
public import Theory.GroupTheory.PrimeRankWitness
public import Theory.GroupTheory.TwoLocalSurjective
public import Theory.GroupTheory.QuasithinBasic
public import Mathlib.GroupTheory.NoncommCoprod
/-!
# Rank-three tori with pairwise swapping normalizers in central covers

If three independent odd-prime directions can be exchanged in pairs by
inner automorphisms, arbitrary lifts through a central extension commute.
The abelian subgroup generated by those lifts maps onto the original torus.
Its Sylow subgroup therefore has generator rank at least three. Applying
this to a genuine two-local subgroup of a quotient gives the same rank
obstruction in a two-local subgroup of the original finite covering group.

The kernel need not be odd, and no quotient rank monotonicity is assumed.
The actual unitary matrix tori supply the swaps in the A.2.18 source consumer.
Source: Aschbacher--Smith A.2.18, printed p.40.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CentralExtension.SwappedRankThree
variable (p : ℕ)
/-- The standard cyclic axis in the three-dimensional elementary parameter group. -/
@[expose] def basis (i : Fin 3) : Fin 3 → Multiplicative (ZMod p) := Pi.mulSingle i (Multiplicative.ofAdd 1)

/-- The standard axis retains its literal parameter-group marking across imports. -/
theorem basis_eq_mulSingle (i : Fin 3) :
    basis p i = Pi.mulSingle i (Multiplicative.ofAdd 1) := rfl

private theorem basis_decomposition [NeZero p] (a : Fin 3 → Multiplicative (ZMod p)) :
    basis p 0 ^ (a 0).toAdd.val * (basis p 1 ^ (a 1).toAdd.val *
      basis p 2 ^ (a 2).toAdd.val) = a := by
  have hg (b : Multiplicative (ZMod p)) : Multiplicative.ofAdd (1 : ZMod p) ^ b.toAdd.val = b := by
    change Multiplicative.ofAdd (b.toAdd.val • (1 : ZMod p)) = b
    have hb : (b.toAdd.val • (1 : ZMod p)) = b.toAdd := by simp [nsmul_eq_mul]
    exact congrArg Multiplicative.ofAdd hb
  funext i
  fin_cases i <;> simp [basis,hg]

variable {p} [Fact p.Prime]
variable {G H : Type*} [Group G] [Finite G] [Group H]

/-- Three independent cyclic directions with commuting lifts force prime rank three. -/
theorem three_le_primeRank_of_commuting_lifts (f : G →* H)
    (e : (Fin 3 → Multiplicative (ZMod p)) →* H) (he : Function.Injective e)
    (a : Fin 3 → G) (ha : ∀ i, f (a i) = e (basis p i))
    (hcomm : ∀ i j, Commute (a i) (a j)) : 3 ≤ primeRank p G := by
  classical
  let : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  let A := Fin 3 → Multiplicative (ZMod p)
  have hpow (a : A) : a ^ p = 1 := by
    funext i
    change Multiplicative.ofAdd (p • (a i).toAdd) = Multiplicative.ofAdd 0
    exact congrArg Multiplicative.ofAdd (ZModModule.char_nsmul_eq_zero p (a i).toAdd)
  let B := closure (Set.range a)
  have hB : IsMulCommutative B := by
    apply isMulCommutative_closure
    rintro x ⟨i,rfl⟩ y ⟨j,rfl⟩
    exact (hcomm i j).eq
  let : IsMulCommutative B := hB
  have hBa (i : Fin 3) : a i ∈ B := subset_closure ⟨i,rfl⟩
  have hBmap : B ≤ e.range.comap f := by
    apply (closure_le _).mpr
    rintro x ⟨i,rfl⟩
    exact ⟨basis p i,(ha i).symm⟩
  let fB : B →* e.range := (f.comp B.subtype).codRestrict _ (fun x => hBmap x.property)
  let eA : A ≃* e.range := MonoidHom.ofInjective he
  let q : B →* A := eA.symm.toMonoidHom.comp fB
  have hq : Function.Surjective q := by
    intro v
    let b := a 0 ^ (v 0).toAdd.val * (a 1 ^ (v 1).toAdd.val * a 2 ^ (v 2).toAdd.val)
    have hb : b ∈ B := B.mul_mem (B.pow_mem (hBa 0) _)
      (B.mul_mem (B.pow_mem (hBa 1) _) (B.pow_mem (hBa 2) _))
    have hfb : f b = e v := by
      simp only [b,map_mul,map_pow,ha]
      rw [← map_pow,← map_pow,← map_pow,← map_mul,← map_mul,basis_decomposition]
    refine ⟨⟨b,hb⟩,?_⟩
    apply eA.injective
    change eA (eA.symm (fB ⟨b,hb⟩)) = eA v
    rw [eA.apply_symm_apply]
    exact Subtype.ext hfb
  have hAp : IsPGroup p A := fun a => ⟨1,by simpa using hpow a⟩
  let P : Sylow p B := Sylow.nonempty.some
  have hPmap : (P : Subgroup B).map q = ⊤ := by
    let R := P.mapSurjective hq
    exact (R.is_maximal' (hAp.to_subgroup ⊤) le_top).symm
  let qP : P →* A := q.comp (P : Subgroup B).subtype
  have hqP : Function.Surjective qP := by
    apply MonoidHom.range_eq_top.mp
    change (q.comp (P : Subgroup B).subtype).range = ⊤
    rw [MonoidHom.range_comp,range_subtype,hPmap]
  have hrA : 3 ≤ Group.rank A := by
    apply (Nat.pow_dvd_pow_iff_le_right (Fact.out : p.Prime).one_lt).mp
    have hc : Nat.card A = p ^ 3 := by simp [A,Nat.card_eq_fintype_card]
    rw [← hc]
    exact card_dvd_exponent_pow_rank' A hpow
  have hrB : Group.rank P ≤ primeRank p B :=
    (P : Subgroup B).rank_le_primeRank p P.isPGroup'
  exact hrA.trans ((Group.rank_le_of_surjective qP hqP).trans
    (hrB.trans (primeRank_le_of_injective p B.subtype B.subtype_injective)))


/-- Pairwise swapping normalizers preserve the rank-three obstruction through central covers. -/
theorem three_le_primeRank (f : G →* H) (hf : Function.Surjective f)
    (hk : f.ker ≤ center G) (hp : Odd p)
    (e : (Fin 3 → Multiplicative (ZMod p)) →* H) (he : Function.Injective e)
    (hs : ∀ i j : Fin 3, ∃ r : H,
      r * e (basis p i) * r⁻¹ = e (basis p j) ∧
      r * e (basis p j) * r⁻¹ = e (basis p i)) : 3 ≤ primeRank p G := by
  classical
  let : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  let A := Fin 3 → Multiplicative (ZMod p)
  have hpow (a : A) : a ^ p = 1 := by
    funext i
    change Multiplicative.ofAdd (p • (a i).toAdd) = Multiplicative.ofAdd 0
    exact congrArg Multiplicative.ofAdd (ZModModule.char_nsmul_eq_zero p (a i).toAdd)
  let a : Fin 3 → G := fun i => Classical.choose (hf (e (basis p i)))
  have ha (i : Fin 3) : f (a i) = e (basis p i) := Classical.choose_spec (hf (e (basis p i)))
  have hcomm (i j : Fin 3) : Commute (a i) (a j) := by
    obtain ⟨r,hr1,hr2⟩ := hs i j
    apply CentralExtension.commute_lifts_of_swap f hf hk
      (e (basis p i)) (e (basis p j)) r hp.coprime_two_right
      _ ((Commute.all _ _).map e) hr1 hr2 _ _ (ha i) (ha j)
    rw [← map_pow,hpow,map_one]
  exact three_le_primeRank_of_commuting_lifts f e he a ha hcomm


/-- A swapped torus in an actual quotient two-local forces rank three in a lifted two-local. -/
theorem exists_twoLocal_rank_three (f : G →* H) (hf : Function.Surjective f)
    (hk : f.ker ≤ center G) (hp : Odd p)
    (P : Subgroup H) (hP : IsTwoLocal P)
    (e : (Fin 3 → Multiplicative (ZMod p)) →* P) (he : Function.Injective e)
    (hs : ∀ i j : Fin 3, ∃ r : P,
      r * e (basis p i) * r⁻¹ = e (basis p j) ∧
      r * e (basis p j) * r⁻¹ = e (basis p i)) :
    ∃ L : Subgroup G, IsTwoLocal L ∧ 3 ≤ primeRank p L := by
  obtain ⟨L,hL,_,q,hq,hmark⟩ := hP.exists_surjective_of_surjective f hf
  have hqk : q.ker ≤ center L := by
    intro x hx
    have hc : (x : G) ∈ center G := hk (by
      change f x = 1
      rw [← hmark x, show q x = 1 from hx]
      rfl)
    apply mem_center_iff.mpr
    intro y
    exact Subtype.ext (mem_center_iff.mp hc y)
  exact ⟨L,hL,three_le_primeRank q hq hqk hp e he hs⟩

/-- An actual swapped torus excludes quasithinness of every finite central cover. -/
theorem not_quasithin (f : G →* H) (hf : Function.Surjective f)
    (hk : f.ker ≤ center G) (hp : Odd p)
    (P : Subgroup H) (hP : IsTwoLocal P)
    (e : (Fin 3 → Multiplicative (ZMod p)) →* P) (he : Function.Injective e)
    (hs : ∀ i j : Fin 3, ∃ r : P,
      r * e (basis p i) * r⁻¹ = e (basis p j) ∧
      r * e (basis p j) * r⁻¹ = e (basis p i)) : ¬ IsQuasithin G := by
  intro hG
  obtain ⟨L,hL,hr⟩ := exists_twoLocal_rank_three f hf hk hp P hP e he hs
  have hh := isQuasithin_iff_twoLocal.mp hG L hL p (Fact.out : p.Prime) hp
  omega

end CentralExtension.SwappedRankThree
