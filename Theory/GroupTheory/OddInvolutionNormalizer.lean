module

public import Theory.GroupTheory.NormalizingInvolutionCard
public import Mathlib.GroupTheory.Index

/-!
# Odd abelian overgroups and involution normalizers

An odd abelian overgroup F of H lies in N(H). If N(H) is contained in the
subgroup generated by H and a normalizing involution, then |F| divides
2|H|. Oddness cancels the factor two, forcing F = H. Also, inversion on an
odd subgroup has trivial fixed subgroup, so the relative centralizer index
is the subgroup order.

These are the group-theoretic steps used after torus containment in GLS,
Volume 4, Chapter 2, Lemmas 17.3 and 17.5. They do not assert the existence
of a torus in any concrete group.
-/

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- An odd abelian overgroup is exhausted by a subgroup whose normalizer
is generated by that subgroup and a normalizing involution. -/
public theorem eq_odd_abelian_overgroup_of_normalizer_le (H F : Subgroup G) [IsMulCommutative F]
    (hHF : H ≤ F) (hodd : Odd (Nat.card F)) {t : G}
    (ht : orderOf t = 2) (htN : t ∈ normalizer H)
    (hN : normalizer H ≤ H ⊔ zpowers t) : H = F := by
  have htF : t ∉ F := by
    intro htF
    have hd := _root_.orderOf_dvd_natCard (⟨t, htF⟩ : F)
    rw [Subgroup.orderOf_mk, ht] at hd
    exact hodd.not_two_dvd_nat hd
  have hFN : F ≤ normalizer H := by
    apply (le_centralizer F).trans
    exact (centralizer_le hHF).trans (centralizer_le_normalizer (H : Set G))
  have hd : Nat.card F ∣ 2 * Nat.card H := by
    rw [← card_sup_zpowers_of_normalizing_involution H t
      (ht ▸ pow_orderOf_eq_one t) (fun h => htF (hHF h)) htN]
    exact card_dvd_of_le (hFN.trans hN)
  exact eq_of_le_of_card_ge hHF
    (Nat.le_of_dvd Nat.card_pos (hodd.coprime_two_right.dvd_of_dvd_mul_left hd))

omit [Finite G] in
/-- Inversion on an odd subgroup fixes only the identity. -/
public theorem inf_centralizer_eq_bot_of_odd_inverted (H : Subgroup G) (hodd : Odd (Nat.card H)) (t : G)
    (hinv : ∀ x ∈ H, t * x * t⁻¹ = x⁻¹) :
    H ⊓ centralizer ({t} : Set G) = ⊥ := by
  apply eq_bot_iff.mpr
  intro x hx
  have hc := mem_centralizer_singleton_iff.mp hx.2
  have hi : x = x⁻¹ := by
    calc
      x = t * x * t⁻¹ := by rw [← hc]; group
      _ = x⁻¹ := hinv x hx.1
  have hp : (⟨x, hx.1⟩ : H) ^ 2 = 1 := by
    apply Subtype.ext
    change x ^ 2 = 1
    rw [pow_two]
    calc
      x * x = x⁻¹ * x := congrArg (fun y => y * x) hi
      _ = 1 := inv_mul_cancel x
  have he : (⟨x, hx.1⟩ : H) = 1 :=
    hodd.coprime_two_right.pow_left_bijective.injective (hp.trans (one_pow 2).symm)
  exact congrArg Subtype.val he

omit [Finite G] in
/-- The index is relative to H; ambient centralizer index is not intended. -/
public theorem centralizer_relIndex_eq_card_of_odd_inverted (H : Subgroup G) (hodd : Odd (Nat.card H)) (t : G)
    (hinv : ∀ x ∈ H, t * x * t⁻¹ = x⁻¹) :
    (centralizer ({t} : Set G)).relIndex H = Nat.card H := by
  rw [← inf_relIndex_left, inf_centralizer_eq_bot_of_odd_inverted H hodd t hinv]
  simp

end Subgroup
