module
public import Theory.GroupTheory.QuaternionCentralProductTransport
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.Index

/-!
# Descending a quaternion extension through a central quotient

A surjective homomorphism that is injective on an embedded quaternion central
product preserves that product. If an action has kernel generated by this
product and the quotient kernel, it descends to an action whose kernel is the
preserved product. Pulling back a subgroup of the action image constructs an
actual extension, with the same index and the prescribed quotient isomorphism.

The consumer is the marked quotient centralizer in Aschbacher--Smith 14.3.20,
printed pp.997--998. No splitting of the extension is asserted.
-/

public section
open Subgroup
namespace Subgroup

/-- Descend an actual quaternion extension through a quotient that is injective
on its quaternion subgroup, then pull back the chosen subgroup of its action image. -/
theorem quaternion_extension_of_quotient_action
    {H G D K : Type*} [Group H] [Group G] [Group D] [Group K]
    (f : H →* G) (hf : Function.Surjective f) (a : H →* D)
    (U : Subgroup H) (dU : QuaternionCentralProductData U)
    (hi : Function.Injective (f.comp U.subtype))
    (hk : a.ker = U ⊔ f.ker)
    (S : Subgroup D) (hS : S ≤ a.range) (hindex : S.relIndex a.range ≤ 2)
    (eS : S ≃* K) :
    ∃ W : Subgroup G, W.index ≤ 2 ∧ ∃ (Q : Subgroup W) (_ : Q.Normal),
      Nonempty (QuaternionCentralProductData Q) ∧ Nonempty ((W ⧸ Q) ≃* K) := by
  classical
  have hka : f.ker ≤ a.ker := hk ▸ le_sup_right
  let b : G →* D := f.liftOfSurjective hf ⟨a,hka⟩
  have hbf (x : H) : b (f x) = a x :=
    f.liftOfRightInverse_comp_apply _ _ ⟨a,hka⟩ x
  have hrange : b.range = a.range := by
    ext x
    constructor
    · rintro ⟨y,rfl⟩
      obtain ⟨y,rfl⟩ := hf y
      exact ⟨y,(hbf y).symm⟩
    · rintro ⟨y,rfl⟩
      exact ⟨f y,hbf y⟩
  have hker : b.ker = U.map f := by
    have hcomap : b.ker.comap f = a.ker := by
      ext x
      exact (hbf x).congr_left
    apply Subgroup.comap_injective hf
    rw [hcomap,Subgroup.comap_map_eq,hk]
  let W := S.comap b
  let c : W →* S := (b.comp W.subtype).codRestrict S (fun x => x.property)
  have hcs : Function.Surjective c := by
    intro s
    obtain ⟨g,hg⟩ := (hrange.symm ▸ hS s.property)
    exact ⟨⟨g,show b g ∈ S from hg.symm ▸ s.property⟩,Subtype.ext hg⟩
  let j : U →* W := {
    toFun := fun u => ⟨f u,by
      change b (f u) ∈ S
      rw [hbf]
      have hu : a u = 1 := by
        change (u : H) ∈ a.ker
        rw [hk]
        exact (show U ≤ U ⊔ f.ker from le_sup_left) u.property
      rw [hu]
      exact S.one_mem⟩
    map_one' := Subtype.ext f.map_one
    map_mul' := fun x y => Subtype.ext (f.map_mul x y) }
  have hji : Function.Injective j := fun x y h => hi (congrArg Subtype.val h)
  have hjker : j.range = c.ker := by
    ext x
    constructor
    · rintro ⟨u,rfl⟩
      apply Subtype.ext
      change b (f u) = 1
      rw [hbf]
      change (u : H) ∈ a.ker
      rw [hk]
      exact (show U ≤ U ⊔ f.ker from le_sup_left) u.property
    · intro hx
      have hb : (x:G) ∈ b.ker := congrArg Subtype.val hx
      rw [hker] at hb
      obtain ⟨u,hu,he⟩ := hb
      exact ⟨⟨u,hu⟩,Subtype.ext he⟩
  let eU : U ≃* c.ker :=
    (MonoidHom.ofInjective hji).trans (MulEquiv.subgroupCongr hjker)
  refine ⟨W,?_,c.ker,inferInstance,⟨dU.map eU⟩,
    ⟨(QuotientGroup.quotientKerEquivOfSurjective c hcs).trans eS⟩⟩
  change (S.comap b).index ≤ 2
  rw [S.index_comap,hrange]
  exact hindex
end Subgroup
