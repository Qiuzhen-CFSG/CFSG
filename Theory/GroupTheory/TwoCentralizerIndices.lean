module

public import Theory.PGroupCore
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Two centralizer indices bound a two-subgroup

Suppose a finite group has trivial two-core and is generated by subgroups
`E₁` and `E₂`. If each centralizer `C_A(Eᵢ)` has index two in a two-subgroup
`A`, then `A` has order at most four, and `C_A(E₁)` has order at most two.
There is no normality assumption on `A`, nor any containment in the factors.

The intersection of the two centralizers inside `A` centralizes the group
generated by the factors. It is therefore central, hence normal; as a
subgroup of `A`, it is a two-group and lies in the trivial two-core.
The relative-index inequality for intersections bounds the index of this
trivial subgroup by four. Multiplicativity along `1 ≤ C_A(E₁) ≤ A` gives
the second cardinality bound.

This source-neutral finite-group argument is used in the core-free subgroup
paragraph of Stellmacher's (6.3), source scan p.31. All group and
subgroup hypotheses needed by that step are explicit here.
-/

namespace Subgroup

public theorem card_le_four_of_two_centralizer_indices
    {G : Type*} [Group G] [Finite G] (A E₁ E₂ : Subgroup G)
    (hcore : pCore 2 G = ⊥) (hA : IsPGroup 2 A) (hgen : E₁ ⊔ E₂ = ⊤)
    (h₁ : (A ⊓ centralizer (E₁ : Set G)).relIndex A = 2)
    (h₂ : (A ⊓ centralizer (E₂ : Set G)).relIndex A = 2) :
    Nat.card A ≤ 4 ∧ Nat.card ↥(A ⊓ centralizer (E₁ : Set G)) ≤ 2 := by
  let C₁ := A ⊓ centralizer (E₁ : Set G)
  let C₂ := A ⊓ centralizer (E₂ : Set G)
  let D := C₁ ⊓ C₂
  have hDA : D ≤ A := inf_le_left.trans inf_le_left
  have hDZ : D ≤ center G := by
    intro d hd
    rw [← centralizer_univ, ← coe_top, ← hgen, sup_eq_closure, centralizer_closure]
    rw [mem_centralizer_iff]
    intro e he
    rcases he with he₁ | he₂
    · exact mem_centralizer_iff.mp hd.1.2 e he₁
    · exact mem_centralizer_iff.mp hd.2.2 e he₂
  have hDnormal : D.Normal := ⟨fun d hd g => by
    rw [(mem_center_iff.mp (hDZ hd)) g, mul_inv_cancel_right]
    exact hd⟩
  have hDtwo : IsPGroup 2 D :=
    hA.of_injective (inclusion hDA) (inclusion_injective hDA)
  have hDcore : D ≤ pCore 2 G := le_sSup ⟨hDnormal, hDtwo⟩
  have hD : D = ⊥ := le_bot_iff.mp (hcore ▸ hDcore)
  have hcard : Nat.card A ≤ 4 := by
    have hi : D.relIndex A ≤ C₁.relIndex A * C₂.relIndex A := relIndex_inf_le
    simpa only [hD, relIndex_bot_left, C₁, C₂, h₁, h₂] using hi
  refine ⟨hcard, ?_⟩
  have hm := relIndex_mul_relIndex (⊥ : Subgroup G) C₁ A bot_le inf_le_left
  rw [relIndex_bot_left, relIndex_bot_left, h₁] at hm
  change Nat.card C₁ ≤ 2
  omega
end Subgroup
