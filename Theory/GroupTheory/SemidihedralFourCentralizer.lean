module
public import Theory.GroupTheory.SemidihedralFourSubgroup

/-!
# The centralizer of the canonical semidihedral four-group

The four-group generated by the central involution and the involutory
generator is self-centralizing. In the two normal forms, commutation with
the involutory generator forces the cyclic exponent to be divisible by
the half-order. This is the same exponent calculation as the center formula.

Source: the semidihedral presentation in Alperin–Brauer–Gorenstein,
Chapter II, §1 (`refs/latex/alperin-brauer-gorenstein.tex`).
-/

namespace Semidihedral

/-- The canonical four-group in a semidihedral presentation is self-centralizing. -/
public theorem centralizer_canonical_four
    {H : Type*} [Group H] {n : ℕ} (hn : 4 ≤ n) (a b : H)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set H) = ⊤) :
    Subgroup.centralizer
      (Subgroup.closure ({a ^ (2 ^ (n - 2)), b} : Set H) : Set H) =
      Subgroup.closure ({a ^ (2 ^ (n - 2)), b} : Set H) := by
  let E := Subgroup.closure ({a ^ (2 ^ (n - 2)), b} : Set H)
  let : IsElementaryAbelian 2 E := (canonical_four hn a b ha hb hconj hgen).1
  have hbE : b ∈ E := Subgroup.subset_closure (by simp)
  have hzE : a ^ (2 ^ (n - 2)) ∈ E := Subgroup.subset_closure (by simp)
  have hlow : 2 ≤ 2 ^ (n - 2) := by
    calc
      2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (n - 2) := Nat.pow_le_pow_right (by omega) (by omega)
  have hpower (i : ℕ) (hi : b * a ^ i = a ^ i * b) : a ^ i ∈ E := by
    have heq : a ^ ((2 ^ (n - 2) - 1) * i) = a ^ i := by
      apply mul_right_cancel (b := b)
      rw [← move_pow a b _ hconj i]
      exact hi
    have hd : 2 ^ (n - 1) ∣ (2 ^ (n - 2) - 2) * i := by
      have h := (pow_eq_pow_iff_modEq.mp heq).symm.dvd'
      rw [ha] at h
      convert h using 1
      simp only [show 2 ^ (n - 2) - 2 = 2 ^ (n - 2) - 1 - 1 by omega,
        Nat.sub_mul, one_mul]
    obtain ⟨j, hj⟩ := half_order_dvd hn hd
    rw [hj, pow_mul]
    exact E.pow_mem hzE j
  apply le_antisymm
  · intro x hx
    have hxb := hx b hbE
    have hb2 : b ^ 2 = 1 := by rw [← hb]; exact pow_orderOf_eq_one b
    obtain ⟨i, -, rfl | rfl⟩ := normal_form a b _ _ (by positivity)
      ha hb2 hconj hgen x
    · exact hpower i hxb
    · apply E.mul_mem _ hbE
      apply hpower i
      apply mul_right_cancel (b := b)
      simpa only [mul_assoc] using hxb
  · exact E.le_centralizer

end Semidihedral
