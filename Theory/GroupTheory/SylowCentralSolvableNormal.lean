module

public import Theory.GroupTheory.Fitting.Core
public import Theory.GroupTheory.Involution.Basic

/-!
# Solvable normal subgroups with Sylow-central generators

If a group is generated by elements centralizing Sylow p-subgroups, every
normal p-subgroup is central: it lies in each of those Sylow subgroups.
For a finite group with trivial odd core, a nontrivial solvable normal subgroup
therefore contains a central involution when p = 2. Indeed its Fitting subgroup
is a nontrivial two-core, characteristic in the normal subgroup.

This is the elementary normal-subgroup reduction in GLS, Volume 4,
Chapter 2, Lemma 4.5, printed pp. 34–35. It does not use the classification
of central extensions that completes that lemma.
-/

open Subgroup BenderSuzuki.PFAppendixIII

namespace Theory.GroupTheory

/-- Sylow-central generators centralize every normal p-subgroup. -/
public theorem normal_pSubgroup_le_center_of_sylowCentral_generation
    {G : Type*} [Group G] {p : ℕ} {Z : Set G}
    (hgen : Subgroup.closure Z = ⊤)
    (hcentral : ∀ z ∈ Z, ∃ S : Sylow p G, ∀ s : S, Commute z (s : G))
    (N : Subgroup G) [N.Normal] (hNp : IsPGroup p N) : N ≤ Subgroup.center G := by
  have hle : Subgroup.closure Z ≤ Subgroup.centralizer (N : Set G) := by
    apply (Subgroup.closure_le _).mpr
    intro z hz
    obtain ⟨S, hS⟩ := hcentral z hz
    intro n hn
    exact (hS ⟨n, hNp.le_sylow_of_normal S hn⟩).eq.symm
  intro n hn
  apply Subgroup.mem_center_iff.mpr
  intro g
  have hg := hle (hgen ▸ Subgroup.mem_top g)
  exact (Subgroup.mem_centralizer_iff.mp hg n hn).symm

/-- With trivial odd core, a nontrivial solvable normal subgroup contains a
central involution if the group has Sylow-central generators. -/
public theorem exists_central_involution_of_solvable_normal_of_sylowCentral_generation
    {G : Type*} [Group G] [Finite G] {Z : Set G}
    (hgen : Subgroup.closure Z = ⊤)
    (hcentral : ∀ z ∈ Z, ∃ S : Sylow 2 G, ∀ s : S, Commute z (s : G))
    (hodd : pPrimeCore 2 G = ⊥)
    (N : Subgroup G) [N.Normal] [Group.IsSolvable N] (hne : N ≠ ⊥) :
    ∃ v : G, v ∈ N ∧ v ∈ Subgroup.center G ∧ IsInvolution v := by
  have hNodd : pPrimeCore 2 N = ⊥ := by
    apply (Subgroup.map_eq_bot_iff_of_injective _ N.subtype_injective).mp
    apply le_bot_iff.mp
    simpa only [hodd] using pPrimeCore_map_subtype_le_pPrimeCore_of_normal 2 N
  have hPne : pCore 2 N ≠ ⊥ := by
    intro hP
    have hfit : fittingSubgroup N = ⊥ := (Fitting_eq_pcore N 2 hNodd).trans hP
    have hcard := (fitting_eq_bot_iff_card_eq_one_of_solvable N).mp hfit
    exact hne ((Subgroup.card_le_one_iff_eq_bot N).mp hcard.le)
  let P := (pCore 2 N).map N.subtype
  have hPcentral : P ≤ Subgroup.center G :=
    normal_pSubgroup_le_center_of_sylowCentral_generation hgen hcentral P
      (pCore_isPGroup.map N.subtype)
  let : Nontrivial (pCore 2 N) := (Subgroup.nontrivial_iff_ne_bot _).mpr hPne
  have hdvd : 2 ∣ Nat.card (pCore 2 N) :=
    pCore_isPGroup.card_eq_or_dvd.resolve_left (Nat.ne_of_gt Finite.one_lt_card)
  obtain ⟨v, hv⟩ := exists_prime_orderOf_dvd_card' (G := pCore 2 N) 2 hdvd
  have hinv : IsInvolution v := ((orderOf_eq_prime_iff).mp hv).symm
  refine ⟨((v : N) : G), (v : N).property, ?_, ?_⟩
  · exact hPcentral (Subgroup.mem_map_of_mem N.subtype v.property)
  · exact ⟨fun he => hinv.ne_one (Subtype.ext (Subtype.ext he)),
      congrArg (fun x : pCore 2 N => ((x : N) : G)) hinv.sq_eq_one⟩

end Theory.GroupTheory
