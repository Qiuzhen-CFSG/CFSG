module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Data.Nat.Factorization.Basic

/-!
# Lifting p-regular elements through finite quotients

Every prime-to-`p` order element in a quotient of a finite group has a
prime-to-`p` order preimage. Write the order of any preimage as `p^k * m`,
with `p` not dividing `m`. Its `p^k`-th power has order `m`, while powering
by `p^k` is invertible on the cyclic subgroup generated by the target.
A further power therefore supplies the desired preimage.

This is the elementary group-theoretic lifting step in Brauer-character
inflation: restriction to p-regular conjugacy classes remains surjective.
It is independent of the kernel's order or centrality.
-/

public section
namespace MonoidHom
variable {G Q : Type*} [Group G] [Finite G] [Group Q]

/-- Surjective homomorphisms from finite groups lift p-regular elements. -/
theorem exists_pRegular_lift (π : G →* Q) (hπ : Function.Surjective π)
    (p : ℕ) (hp : p.Prime) (q : Q) (hq : ¬ p ∣ orderOf q) :
    ∃ g : G, ¬ p ∣ orderOf g ∧ π g = q := by
  obtain ⟨g, rfl⟩ := hπ q
  obtain ⟨k, m, hm, hn⟩ :=
    Nat.exists_eq_pow_mul_and_not_dvd (orderOf_pos g).ne' p hp.ne_one
  have horder : orderOf (g ^ p ^ k) = m := by
    rw [orderOf_pow_of_dvd (pow_ne_zero _ hp.ne_zero)
      (by rw [hn]; exact dvd_mul_right _ _), hn]
    exact Nat.mul_div_cancel_left m (pow_pos hp.pos _)
  obtain ⟨b, hb⟩ := exists_pow_eq_self_of_coprime
    ((hp.coprime_iff_not_dvd.mpr hq).pow_left k)
  refine ⟨(g ^ p ^ k) ^ b, ?_, ?_⟩
  · intro hdiv
    apply hm
    exact hdiv.trans ((orderOf_pow_dvd b).trans (horder ▸ dvd_refl _))
  · simpa only [map_pow] using hb

end MonoidHom
