module
public import Theory.ElementaryAbelian.Basic
public import Theory.GroupTheory.ClassTwoCommutator
/-! # Central covers generated by two elementary planes
Elementary full preimages identify involution centralizers and force class
at most two. The literal commutator row has unchanged order and meets the
covering kernel trivially.
Source: Aschbacher--Smith 2.5.7, printed pp.555--556.
-/
public section
open Subgroup
open scoped commutatorElement IsMulCommutative
namespace Subgroup.TwoPlaneCover
variable {E Q:Type*} [Group E] [Group Q]
theorem centralizer_eq_comap (f:E→*Q) (v:E)
    [IsMulCommutative ((centralizer ({f v}:Set Q)).comap f)] :
    centralizer ({v}:Set E)=(centralizer ({f v}:Set Q)).comap f := by
  ext x
  simp only [mem_centralizer_singleton_iff,mem_comap]
  constructor
  · intro h
    simpa only [map_mul] using congrArg f h
  · intro h
    let P:Subgroup E:=(centralizer ({f v}:Set Q)).comap f
    have hv:v∈P:=by simp only [P,mem_comap,mem_centralizer_singleton_iff]
    have hx:x∈P:=mem_centralizer_singleton_iff.mpr h
    let : CommGroup P:=IsMulCommutative.instCommGroup
    exact congrArg Subtype.val (mul_comm (⟨x,hx⟩:P) ⟨v,hv⟩)

theorem preimage_center_le_center (f:E→*Q) (hf:Function.Surjective f)
    (V W:Subgroup Q) (hgen:V⊔W=⊤) (hZ:center Q≤V⊓W)
    [IsMulCommutative (V.comap f)] [IsMulCommutative (W.comap f)] :
    (center Q).comap f≤center E := by
  have hker:f.ker≤(V.comap f)⊔(W.comap f):=by
    intro x hx
    apply mem_sup_left
    change f x∈V
    rw [show f x=1 from hx]
    exact V.one_mem
  have hgen':V.comap f⊔W.comap f=⊤:=by
    have hm:((V.comap f)⊔(W.comap f)).map f=⊤:=by
      rw [Subgroup.map_sup,map_comap_eq_self_of_surjective hf,
        map_comap_eq_self_of_surjective hf,hgen]
    have he:=congrArg (Subgroup.comap f) hm
    simpa only [comap_map_eq_self hker,comap_top] using he
  intro z hz
  apply mem_center_iff.mpr
  intro x
  have hcentral (A:Subgroup Q) [IsMulCommutative (A.comap f)] (hZA:center Q≤A):
      A.comap f≤centralizer ({z}:Set E):=by
    intro a ha
    let : CommGroup (A.comap f):=IsMulCommutative.instCommGroup
    apply mem_centralizer_singleton_iff.mpr
    exact congrArg Subtype.val (mul_comm (⟨a,ha⟩:A.comap f) ⟨z,hZA hz⟩)
  have hx:x∈V.comap f⊔W.comap f:=by rw [hgen'];exact mem_top _
  exact mem_centralizer_singleton_iff.mp ((sup_le (hcentral V (hZ.trans inf_le_left))
    (hcentral W (hZ.trans inf_le_right))) hx)

theorem center_eq_comap (f:E→*Q) (hf:Function.Surjective f)
    (V W:Subgroup Q) (hgen:V⊔W=⊤) (hZ:center Q≤V⊓W)
    [IsMulCommutative (V.comap f)] [IsMulCommutative (W.comap f)] :
    center E=(center Q).comap f := by
  apply le_antisymm
  · intro a ha
    apply mem_center_iff.mpr
    intro b
    obtain ⟨x,rfl⟩:=hf b
    simpa only [map_mul] using congrArg f (mem_center_iff.mp ha x)
  · exact preimage_center_le_center f hf V W hgen hZ

theorem class_two (f:E→*Q) (hf:Function.Surjective f)
    (V W:Subgroup Q) (hgen:V⊔W=⊤) (hZ:center Q≤V⊓W)
    [IsMulCommutative (V.comap f)] [IsMulCommutative (W.comap f)]
    (hclass:_root_.commutator Q≤center Q) : _root_.commutator E≤center E := by
  apply (show _root_.commutator E≤(center Q).comap f from ?_).trans
    (preimage_center_le_center f hf V W hgen hZ)
  apply map_le_iff_le_comap.mp
  rw [map_commutator_eq,MonoidHom.range_eq_top.mpr hf]
  exact hclass

theorem commutator_disjoint_kernel (f:E→*Q)
    (hc:_root_.commutator E≤center E) (v:E)
    (hv:centralizer ({v}:Set E)=(centralizer ({f v}:Set Q)).comap f) :
    Disjoint (⁅zpowers v,⊤⁆:Subgroup E) f.ker := by
  rw [←ClassTwo.commutatorHom_range hc v]
  apply disjoint_def.mpr
  rintro a ⟨x,rfl⟩ hq
  change ⁅v,x⁆=1
  have hfv:f ⁅v,x⁆=1:=hq
  rw [map_commutatorElement,commutatorElement_eq_one_iff_mul_comm] at hfv
  have hx:x∈(centralizer ({f v}:Set Q)).comap f:=by
    exact mem_centralizer_singleton_iff.mpr hfv.symm
  rw [←hv] at hx
  exact commutatorElement_eq_one_iff_mul_comm.mpr (mem_centralizer_singleton_iff.mp hx).symm
theorem commutator_card (f:E→*Q) (hf:Function.Surjective f)
    [Finite E] [Finite Q] (hc:_root_.commutator E≤center E) (v:E)
    (hv:centralizer ({v}:Set E)=(centralizer ({f v}:Set Q)).comap f) :
    Nat.card (⁅zpowers v,⊤⁆:Subgroup E)=(centralizer ({f v}:Set Q)).index := by
  rw [←ClassTwo.centralizer_index hc v,hv]
  exact (centralizer ({f v}:Set Q)).index_comap_of_surjective hf
end Subgroup.TwoPlaneCover

