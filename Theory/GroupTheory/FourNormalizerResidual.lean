module
public import Theory.GroupTheory.PResidual.Restriction
public import Theory.GroupTheory.PResidual.NormalClosureCover
public import Theory.GroupTheory.SymmetricFourNormalFour

/-!
# Residual structure of a four-normalizer in a normal supplement

Suppose H is generated by its normal subgroup K and a two-subgroup Y.
If a four-group E in K has N_K(E) isomorphic to S₄, the residual of N_H(E)
lies in N_K(E). Residual restriction identifies it with the A₄ residual
of that S₄. Its embedded two-core is E, which is also C_K(E).
Source: Aschbacher--Smith 2.5.12(2), printed pp.557--558.
-/

public section
namespace Theory.GroupTheory
open Subgroup
variable {G : Type*} [Group G] [Finite G]

theorem residual_four_normalizer_of_normal_supplement
    (H K Y E : Subgroup G) (hKH : K ≤ H) [(K.subgroupOf H).Normal]
    (hgen : H = K ⊔ Y) (hY : IsPGroup 2 Y) (hEK : E ≤ K)
    [IsKleinFour E]
    (e : (K ⊓ normalizer (E : Set G) : Subgroup G) ≃* Equiv.Perm (Fin 4)) :
    Nonempty (pResidual 2 (H ⊓ normalizer (E : Set G) : Subgroup G) ≃*
      alternatingGroup (Fin 4)) ∧
    ((pResidual 2 (H ⊓ normalizer (E : Set G) : Subgroup G)).map
      (H ⊓ normalizer (E : Set G)).subtype).pCoreIn 2 = E ∧
    K ⊓ centralizer (E : Set G) = E := by
  let N := H ⊓ normalizer (E : Set G)
  let D := K ⊓ normalizer (E : Set G)
  have hDN : D ≤ N := inf_le_inf_right _ hKH
  have hEN : E ≤ N := le_inf (hEK.trans hKH) E.le_normalizer
  have hED : E ≤ D := le_inf hEK E.le_normalizer
  have hYH : Y ≤ H := hgen ▸ le_sup_right
  have hg : K.subgroupOf H ⊔ Y.subgroupOf H = ⊤ := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hKH, map_subgroupOf_eq_of_le hYH,
      ← hgen, ← MonoidHom.range_eq_map, range_subtype]
  have hRH : (pResidual 2 N).map N.subtype ≤ K := by
    have hr := embedded_pResidual_le_of_normal_sup_pGroup (K.subgroupOf H)
      (Y.subgroupOf H) (N.subgroupOf H) hY.comap_subtype (hg ▸ le_top)
    intro x hx
    obtain ⟨n,hn,rfl⟩ := hx
    let j := subgroupOfEquivOfLe (show N ≤ H from inf_le_left)
    have hnj : j.symm n ∈ pResidual 2 (N.subgroupOf H) := by
      rw [← map_pResidual 2 j.symm]
      exact mem_map_of_mem _ hn
    exact hr (mem_map_of_mem (N.subgroupOf H).subtype hnj)
  have hRD : (pResidual 2 N).map N.subtype ≤ D := le_inf hRH
    ((map_subtype_le _).trans inf_le_right)
  have heq := embedded_pResidual_eq_of_le_of_residual_le 2 hDN hRD
  let ER := E.subgroupOf D
  let : ER.Normal := (normal_subgroupOf_iff_le_normalizer hED).mpr inf_le_right
  let eE := subgroupOfEquivOfLe hED
  let : IsKleinFour ER := {
    card_four := (Nat.card_congr eE.toEquiv).trans IsKleinFour.card_four
    exponent_two := (Monoid.exponent_eq_of_mulEquiv eE).trans IsKleinFour.exponent_two }
  have hcore : D.pCoreIn 2 = E := by
    change (pCore 2 D).map D.subtype = E
    rw [← normal_four_eq_twoCore_of_equiv e ER, map_subgroupOf_eq_of_le hED]
  have hCe : centralizer (ER : Set D) = ER := normal_four_selfCentralizing_of_equiv e ER
  refine ⟨?_, ?_, ?_⟩
  · obtain ⟨a⟩ := twoResidual_equiv_alternatingFour_of_equiv e
    exact ⟨((pResidual 2 N).equivMapOfInjective N.subtype N.subtype_injective).trans
      ((MulEquiv.subgroupCongr heq.symm).trans
        (((pResidual 2 D).equivMapOfInjective D.subtype D.subtype_injective).symm.trans a))⟩
  · rw [← heq, Theory.SpecificGroups.SymmetricFour.embedded_residual_twoCore D e, hcore]
  · apply le_antisymm
    · intro x hx
      have hxD : x ∈ D := ⟨hx.1,centralizer_le_normalizer _ hx.2⟩
      have hh : (⟨x,hxD⟩ : D) ∈ centralizer (ER : Set D) := by
        intro y hy
        exact Subtype.ext (hx.2 y hy)
      rw [hCe] at hh
      exact hh
    · let : IsMulCommutative E := IsKleinFour.isMulCommutative
      exact le_inf hEK (le_centralizer_iff_isMulCommutative.mpr inferInstance)
end Theory.GroupTheory
