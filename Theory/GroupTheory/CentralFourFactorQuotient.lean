module

public import Theory.ElementaryAbelian.Basic
public import Theory.GroupTheory.CardFourAutomorphismStabilizer
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# The actual quotient from a central factor of order four

Let Q be an abelian normal self-centralizing subgroup of a finite group G.
If Q is generated by a normal subgroup U of order four and the ambient
center, and G/Q has order at least six, then G/Q is the symmetric group
on three letters. Neither a direct-product hypothesis nor a bound on the
ambient center is needed.

Conjugation permutes the three nonidentity elements of U. Its kernel is
C_G(U), which equals C_G(Q)=Q since adjoining the ambient center does not
change a centralizer. The induced injection of G/Q into S3 is surjective
by the assumed order lower bound. In particular, this identifies the
actual quotient by Q, not an unrelated faithful action quotient.

This is the quotient step in the final paragraph of Stellmacher (8.2),
Journal of Algebra 190 (1997), p.38, `refs/latex/stellmacher-n-group.tex`.
-/

open scoped IsMulCommutative

public theorem quotient_perm_three_of_central_four_factor
    {G : Type*} [Group G] [Finite G] (Q U : Subgroup G) [Q.Normal] [U.Normal]
    [IsMulCommutative Q]
    (hQ : Q = U ⊔ Subgroup.center G)
    (hcent : Subgroup.centralizer (Q : Set G) ≤ Q)
    (hU : Nat.card U = 4) (hlower : 6 ≤ Nat.card (G ⧸ Q)) :
    Nonempty ((G ⧸ Q) ≃* Equiv.Perm (Fin 3)) := by
  classical
  let _ := Fintype.ofFinite U
  let conjugation : G →* MulAut U := MulAut.conjNormal
  let _ := MulDistribMulAction.compHom U conjugation
  let points : SubMulAction G U := {
    carrier := ({1} : Set U)ᶜ
    smul_mem' := by
      intro g point hpoint
      change conjugation g point ≠ 1
      exact fun heq => hpoint ((conjugation g).injective
        (heq.trans (map_one (conjugation g)).symm)) }
  let action : G →* Equiv.Perm points := MulAction.toPermHom G points
  have hkernel : action.ker = Subgroup.centralizer (U : Set G) := by
    ext g
    rw [MonoidHom.mem_ker, Subgroup.mem_centralizer_iff]
    constructor
    · intro hfix point hpoint
      by_cases hone : point = 1
      · simp [hone]
      have hpoint' : (⟨point, hpoint⟩ : U) ∈ points := by
        change (⟨point, hpoint⟩ : U) ≠ 1
        exact fun heq => hone (congrArg Subtype.val heq)
      have heq := congrArg (fun element : points => ((element : U) : G))
        (Equiv.congr_fun hfix ⟨⟨point, hpoint⟩, hpoint'⟩)
      change g * point * g⁻¹ = point at heq
      exact (mul_inv_eq_iff_eq_mul.mp heq).symm
    · intro hfix
      ext point
      change g * ((point : U) : G) * g⁻¹ = ((point : U) : G)
      rw [← hfix _ (point : U).property, mul_inv_cancel_right]
  have hUQ : U ≤ Q := hQ ▸ le_sup_left
  have hCQ : Subgroup.centralizer (U : Set G) = Q := by
    apply le_antisymm
    · intro g hg
      apply hcent
      rw [Subgroup.mem_centralizer_iff]
      intro point hpoint
      rw [hQ] at hpoint
      obtain ⟨element, helement, central, hcentral, rfl⟩ :=
        Subgroup.mem_sup_of_normal_left.mp hpoint
      calc
        element * central * g = element * (central * g) := mul_assoc _ _ _
        _ = element * (g * central) := by rw [Subgroup.mem_center_iff.mp hcentral g]
        _ = (element * g) * central := (mul_assoc _ _ _).symm
        _ = (g * element) * central := by
          rw [Subgroup.mem_centralizer_iff.mp hg element helement]
        _ = g * (element * central) := mul_assoc _ _ _
    · exact (Subgroup.le_centralizer_iff_isMulCommutative.mpr inferInstance).trans
        (Subgroup.centralizer_le hUQ)
  have hpoints : Nat.card points = 3 := by
    change Nat.card ↥(({1} : Set U)ᶜ) = 3
    rw [Nat.card_eq_fintype_card, Fintype.card_compl_set]
    have hcard : Fintype.card U = 4 := by
      simpa only [Nat.card_eq_fintype_card] using hU
    simp [hcard]
  have hperm : Nat.card (Equiv.Perm points) = 6 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_perm, ← Nat.card_eq_fintype_card, hpoints]
    decide
  have hQker : Q = action.ker := (hkernel.trans hCQ).symm
  let quotientAction := QuotientGroup.lift Q action hQker.le
  have hinjective : Function.Injective quotientAction :=
    (QuotientGroup.injective_lift_iff Q action hQker.le).mpr hQker
  have hcard : Nat.card (G ⧸ Q) = Nat.card (Equiv.Perm points) := by
    have hupper := Nat.card_le_card_of_injective quotientAction hinjective
    omega
  let pointEquiv : points ≃ Fin 3 :=
    (Finite.equivFin points).trans (finCongr hpoints)
  exact ⟨(MulEquiv.ofBijective quotientAction
    ((Nat.bijective_iff_injective_and_card quotientAction).mpr ⟨hinjective, hcard⟩)).trans
      (Equiv.permCongrHom pointEquiv)⟩
