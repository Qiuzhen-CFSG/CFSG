module

public import Theory.GroupTheory.PResidual.PrimeSection

/-!
# Generation by prime-order elements of a prime section

A finite p-perfect group whose p-core quotient has prime order q, coprime
to p, is generated by its elements of order q. A q-element supplements
the p-core. Its conjugates belong to the characteristic subgroup generated
by all q-elements, so the quotient by that subgroup is a p-group and is
trivial by p-perfectness.

Source application: Aschbacher–Smith, combined 1 March 2004 manuscript,
13.6.20, printed p.931: the local two-residual L_v lies in θ(KL_v).
-/

public section
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- Prime-order generation for a p-perfect group with prime p-core quotient. -/
theorem closure_prime_order_eq_top_of_isPPerfect {p q : ℕ}
    [Fact p.Prime] [Fact q.Prime] (hperf : IsPPerfect p G)
    (hcop : p.Coprime q) (hc : Nat.card (G ⧸ pCore p G) = q) :
    closure {x : G | orderOf x = q} = ⊤ := by
  let C : Subgroup G := closure {x : G | orderOf x = q}
  have hN : (⊤ : Subgroup G) ≤ normalizer (C : Set G) := by
    apply le_normalizer_closure_iff.mpr
    intro g _ x hx
    exact subset_closure ((MulAut.conj g).orderOf_eq x |>.trans hx)
  let : C.Normal := normalizer_eq_top_iff.mp (top_unique hN)
  obtain ⟨x, hx, hgen⟩ := exists_prime_order_sup_pCore_eq_top (G := G) hcop hc
  have htop : IsPPerfect p (⊤ : Subgroup G) :=
    hperf.of_surjective topEquiv.symm.toMonoidHom topEquiv.symm.surjective
  apply top_unique
  apply le_normal_of_isPPerfect_of_le_sup_pGroup ⊤ C (pCore p G) htop pCore_isPGroup
  rw [← hgen]
  exact sup_le_sup (zpowers_le.mpr (subset_closure hx)) le_rfl

end Subgroup
end
