module

public import Theory.GroupTheory.PResidual.AbelianCoprimeKernel
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.PCoreLocalSetup
/-!
# Odd quotients and a two-residual supplement

A finite two-perfect group with abelian quotient by its two-core has odd
quotient order. For a normal subgroup with prime-to-p quotient, every
subgroup containing the kernel is generated by its p-residual and that
kernel. Applying this to O³(B) gives O³(B) = O²(O³(B)) O₂(B).

The oddness hypothesis is essential to the supplement argument; abelianness
alone does not provide it. In the source application two-perfectness comes
from B = O²(B₀).

Source: the two-kernel calculation used in the sufficient replacement for
Aschbacher–Smith 13.8.20, printed p.954/PDF p.971.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- A finite abelian p-perfect group has order prime to p. -/
theorem coprime_card_of_isPPerfect_commGroup {A : Type*} [CommGroup A] [Finite A]
    {p : ℕ} [Fact p.Prime] (hp : IsPPerfect p A) : Nat.Coprime p (Nat.card A) := by
  have h := coprime_card_pResidual_of_commGroup (A := A) p
  rw [(pResidual_eq_top_iff p A).mpr hp, Nat.card_congr (topEquiv : (⊤ : Subgroup A) ≃* A).toEquiv] at h
  exact h

/-- Residuals supplement a normal kernel when the quotient has coprime order. -/
theorem residual_sup_eq_of_quotient_coprime (p : ℕ) (N S : Subgroup G) [N.Normal]
    (hNS : N ≤ S) (hcop : Nat.Coprime p (Nat.card (G ⧸ N))) :
    (pResidual p S).map S.subtype ⊔ N = S := by
  let q := QuotientGroup.mk' N
  have hr : pResidual p (S.map q) = ⊤ := by
    apply top_unique
    intro x hx
    exact mem_pResidual_of_orderOf_coprime
      ((hcop.of_dvd_right (S.map q).card_subgroup_dvd_card).of_dvd_right
        (_root_.orderOf_dvd_natCard x))
  have hm : ((pResidual p S).map S.subtype).map q = S.map q := by
    rw [map_embedded_pResidual, hr, ← MonoidHom.range_eq_map, range_subtype]
  apply le_antisymm (sup_le (map_subtype_le _) hNS)
  intro s hs
  obtain ⟨r, hr, he⟩ := mem_map.mp (show q s ∈ ((pResidual p S).map S.subtype).map q by
    rw [hm]; exact mem_map_of_mem q hs)
  have hn : r⁻¹ * s ∈ N := QuotientGroup.eq.mp he
  have hh := ( (pResidual p S).map S.subtype ⊔ N).mul_mem
    (mem_sup_left hr) (mem_sup_right hn)
  simpa only [mul_inv_cancel_left] using hh

omit [Finite G] in
/-- The intrinsic two-core is contained in the embedded three-residual. -/
theorem twoCore_le_threeResidual (B : Subgroup G) :
    B.pCoreIn 2 ≤ (pResidual 3 B).map B.subtype := by
  rintro _ ⟨b, hb, rfl⟩
  refine ⟨b, mem_pResidual_of_orderOf_coprime ?_, rfl⟩
  have hc := (pCore_isPGroup (p := 2) (G := B)).orderOf_coprime
    (by decide : Nat.Coprime 2 3) (⟨b, hb⟩ : pCore 2 B)
  rw [← Subgroup.orderOf_coe] at hc
  exact hc.symm

/-- The three-residual is its two-residual supplemented by the original two-core. -/
theorem threeResidual_twoResidual_sup_twoCore (B : Subgroup G)
    (hodd : Odd (Nat.card (B ⧸ pCore 2 B))) :
    (pResidual 3 B).map B.subtype =
      (pResidual 2 ((pResidual 3 B).map B.subtype)).map
        ((pResidual 3 B).map B.subtype).subtype ⊔ B.pCoreIn 2 := by
  have hQS : pCore 2 B ≤ pResidual 3 B := by
    intro b hb
    exact mem_pResidual_of_orderOf_coprime (by
      have hc := (pCore_isPGroup (p := 2) (G := B)).orderOf_coprime
        (by decide : Nat.Coprime 2 3) (⟨b, hb⟩ : pCore 2 B)
      rw [← Subgroup.orderOf_coe] at hc
      exact hc.symm)
  have h := congrArg (fun A : Subgroup B => A.map B.subtype)
    (residual_sup_eq_of_quotient_coprime 2 (pCore 2 B) (pResidual 3 B)
      hQS (Nat.coprime_two_left.mpr hodd))
  rw [map_sup, map_embedded_pResidual] at h
  exact h.symm

/-- Two-perfectness supplies the missing oddness in an abelian two-core quotient. -/
theorem odd_card_quotient_twoCore_of_isPPerfect (B : Subgroup G)
    (hp : IsPPerfect 2 B) (hab : ⁅B, B⁆ ≤ B.pCoreIn 2) :
    Odd (Nat.card (B ⧸ pCore 2 B)) := by
  have hder : _root_.commutator B ≤ pCore 2 B := by
    intro x hx
    have hm : (_root_.commutator B).map B.subtype = ⁅B, B⁆ := by
      rw [_root_.commutator_def, map_commutator, ← MonoidHom.range_eq_map, range_subtype]
    obtain ⟨y, hy, he⟩ := hab (hm ▸ mem_map_of_mem B.subtype hx)
    exact (Subtype.ext he : y = x) ▸ hy
  let _ : IsMulCommutative (B ⧸ pCore 2 B) :=
    Normal.quotient_commutative_iff_commutator_le.mpr hder
  let _ : CommGroup (B ⧸ pCore 2 B) := IsMulCommutative.instCommGroup
  apply Nat.coprime_two_left.mp
  exact coprime_card_of_isPPerfect_commGroup
    (hp.of_surjective (QuotientGroup.mk' (pCore 2 B)) (QuotientGroup.mk'_surjective _))
end Subgroup
