module
public import Theory.GroupTheory.PResidual.PrimeToTransport
public import Theory.GroupTheory.PCoreFrattiniTransport

/-!
# Prime-to-p residuals above q-group kernels

A surjection onto a group generated by its p-elements remains surjective
when restricted to O^{p′}. Its restricted kernel is a q-group whenever
the original kernel is, so the two intrinsic q-core quotients agree.

This is the residual transport used on the literal centralizer M₁ in
Aschbacher--Smith, 15.2.23(a), printed p.1117.
-/

public section
open Subgroup
namespace MonoidHom
variable {A B : Type*} [Group A] [Group B] [Finite A] [Finite B]

/-- A prime-to-p residual surjects onto a p-generated quotient, preserving
the quotient by q-cores when the original kernel is a q-group. -/
noncomputable def primeToResidualCoreQuotientEquiv
    (p q : ℕ) [Fact p.Prime] [Fact q.Prime]
    (f : A →* B) (hf : Function.Surjective f) (hk : IsPGroup q f.ker)
    (hB : primeToResidual p B = ⊤) :
    (primeToResidual p A ⧸ pCore q (primeToResidual p A)) ≃* B ⧸ pCore q B := by
  let g := f.comp (primeToResidual p A).subtype
  have hg : Function.Surjective g := by
    intro b
    have hb : b ∈ (primeToResidual p A).map f := by
      rw [map_primeToResidual_of_surjective p f hf, hB]
      exact mem_top b
    obtain ⟨a,ha,he⟩ := hb
    exact ⟨⟨a,ha⟩,he⟩
  have hkg : IsPGroup q g.ker := hk.comap_subtype
  exact g.pCoreQuotientEquiv hg hkg

end MonoidHom
