module

public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Residual containment from a normalizing cover

A normal subgroup W and a p-subgroup R generate a group whose p-residual
lies in W. If the ambient group is generated by W, a subgroup centralizing
R, and a subgroup normalizing R, then W R is normal. Consequently the
p-residual of the normal closure of R lies in W as well.

This isolates the normal-generation step in Aschbacher–Smith, Lemma 15.3.7,
printed p.1122. It does not assume anything about the prime divisors of W
or of the centralizing subgroup.
-/

namespace Subgroup

/-- A normal subgroup absorbs the residual after adjoining a p-subgroup. -/
public theorem embedded_pResidual_le_of_normal_sup_pGroup
    {G : Type*} [Group G] {p : ℕ} (W R N : Subgroup G) [W.Normal]
    (hR : IsPGroup p R) (hN : N ≤ W ⊔ R) :
    (pResidual p N).map N.subtype ≤ W := by
  let L := W ⊔ R
  let q := QuotientGroup.mk' (W.subgroupOf L)
  have hsup : W.subgroupOf L ⊔ R.subgroupOf L = ⊤ := by
    apply (map_injective L.subtype_injective)
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le (show W ≤ L from le_sup_left),
      map_subgroupOf_eq_of_le (show R ≤ L from le_sup_right),
      ← MonoidHom.range_eq_map, range_subtype]
  have hq := isPGroup_quotient_of_sup_eq_top (W.subgroupOf L) (R.subgroupOf L)
    hR.comap_subtype hsup
  let f := q.comp (inclusion hN)
  have hk : IsPGroup p (N ⧸ f.ker) :=
    (hq.to_subgroup f.range).of_equiv (QuotientGroup.quotientKerEquivRange f).symm
  have hle : pResidual p N ≤ f.ker := sInf_le ⟨inferInstance, hk⟩
  rintro _ ⟨x, hx, rfl⟩
  exact (QuotientGroup.eq_one_iff (N := W.subgroupOf L) (inclusion hN x)).mp
    (MonoidHom.mem_ker.mp (hle hx))

/-- A centralizing and normalizing cover controls the normal closure. -/
public theorem normalClosure_le_sup_of_normalizing_cover
    {G : Type*} [Group G] (W R C T : Subgroup G) [W.Normal]
    (hc : C ≤ centralizer (R : Set G)) (ht : T ≤ normalizer (R : Set G))
    (hcover : W ⊔ C ⊔ T = ⊤) : normalClosure (R : Set G) ≤ W ⊔ R := by
  have hn : normalizer (R : Set G) ≤ normalizer ((W ⊔ R : Subgroup G) : Set G) := by
    rw [sup_comm]
    exact normalizer_le_normalizer_sup_normal
  have : (W ⊔ R).Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hcover]
    exact sup_le (sup_le (le_sup_left.trans (W ⊔ R).le_normalizer)
      (hc.trans ((Subgroup.centralizer_le_normalizer _).trans hn))) (ht.trans hn)
  exact normalClosure_le_normal (show R ≤ W ⊔ R from le_sup_right)

end Subgroup
