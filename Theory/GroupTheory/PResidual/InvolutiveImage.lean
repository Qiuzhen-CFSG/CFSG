module

public import Theory.GroupTheory.PResidual.NormalClosureCover
public import Theory.GroupTheory.InvolutiveCubicLift
public import Theory.GroupTheory.PGroup.ClassTwoOmegaGenerated
public import Theory.GroupTheory.PCoreLocalSetup

/-!
# Cubic generation above an inverted image

Let P be the two-residual of the normal closure of a two-subgroup R.
Suppose a kernel C centralizes P and R, while a subgroup S normalizes R,
and P C S generates the ambient group. Then R∩C lies in the two-core.
When that core is trivial, an involution in the image of R lifts to an
involution. If it inverts the exponent-three image of P, cubic lifts cover
that image. The normalizing cover then forces the whole residual P to be
generated by cubic elements. An abelian image gives class two and hence
exponent three.

Source application: Aschbacher--Smith, 15.2.3(1) and 15.3.7,
printed pp.1105 and 1122.
-/

namespace Subgroup

/-- The intersection with a centralizing kernel is absorbed by the two-core. -/
public theorem inf_le_twoCore_of_centralizing_cover
    {H : Type*} [Group H] (P R C S : Subgroup H) [C.Normal]
    (hR : IsPGroup 2 R) (hc : C ≤ centralizer ((P ⊔ R : Subgroup H) : Set H))
    (hs : S ≤ normalizer (R : Set H)) (hcover : P ⊔ C ⊔ S = ⊤) :
    R ⊓ C ≤ pCore 2 H := by
  have hPC : P ≤ centralizer (C : Set H) :=
    le_centralizer_iff.mp (hc.trans (centralizer_le (show P ≤ P ⊔ R from le_sup_left)))
  have hCR : C ≤ centralizer (R : Set H) :=
    hc.trans (centralizer_le (show R ≤ P ⊔ R from le_sup_right))
  have hn : (R ⊓ C).Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hcover]
    refine sup_le (sup_le ?_ ?_) ?_
    · exact (hPC.trans (centralizer_le inf_le_right)).trans (centralizer_le_normalizer _)
    · exact (hCR.trans (centralizer_le inf_le_left)).trans (centralizer_le_normalizer _)
    · exact (le_inf hs le_normalizer_of_normal).trans inf_normalizer_le_normalizer_inf
  exact le_sSup ⟨hn, hR.to_le inf_le_left⟩

/-- An inverted cubic image generates the literal two-residual by cubic lifts. -/
public theorem omega_one_eq_top_of_inverted_residual_image
    {H K : Type*} [Group H] [Group K]
    (f : H →* K) (P R S : Subgroup H) [P.Normal]
    (hP : P = (pResidual 2 (normalClosure (R : Set H))).map
      (normalClosure (R : Set H)).subtype)
    (hR : IsPGroup 2 R) (hcore : pCore 2 H = ⊥)
    (hc : f.ker ≤ centralizer ((P ⊔ R : Subgroup H) : Set H))
    (hs : S ≤ normalizer (R : Set H)) (hcover : P ⊔ f.ker ⊔ S = ⊤)
    (hinv : ∃ w ∈ R, (f w) ^ 2 = 1 ∧
      ∀ y ∈ P, f (w * y * w⁻¹) = (f y)⁻¹)
    (hexp : ∀ y ∈ P, (f y) ^ 3 = 1) : omega₁ P (p := 3) = ⊤ := by
  let W := (omega₁ P (p := 3)).map P.subtype
  let : (omega₁ P (p := 3)).Characteristic := omega₁_characteristic P
  let : W.Normal := ConjAct.normal_of_characteristic_of_normal
  obtain ⟨w, hw, hwi, hi⟩ := hinv
  have hmeet : R ⊓ f.ker ≤ (⊥ : Subgroup H) := by
    rw [← hcore]
    exact inf_le_twoCore_of_centralizing_cover P R f.ker S hR hc hs hcover
  have hw2 : w ^ 2 = 1 := mem_bot.mp (hmeet ⟨R.pow_mem hw _, by
    change f (w ^ 2) = 1
    rwa [map_pow]⟩)
  have hwC : ∀ k ∈ f.ker, w * k = k * w := by
    intro k hk
    exact mem_centralizer_iff.mp (hc hk) w ((show R ≤ P ⊔ R from le_sup_right) hw)
  have hWimage : W.map f = P.map f := by
    apply le_antisymm (map_mono (map_subtype_le _))
    rintro _ ⟨y, hy, rfl⟩
    obtain ⟨z, hz, hz3, hfz⟩ :=
      exists_cubic_lift_of_involutive_inverter f P w hw2 hwC hi hexp y hy
    have hzO : (⟨z, hz⟩ : P) ∈ omega₁ P (p := 3) := subset_closure (by
      simpa only [Set.mem_ofPred_eq, pow_one] using
        (Subtype.ext hz3 : (⟨z, hz⟩ : P) ^ 3 = 1))
    exact mem_map.mpr ⟨z, mem_map_of_mem P.subtype hzO, hfz⟩
  have hWC : W ⊔ f.ker = P ⊔ f.ker := by
    simpa only [comap_map_eq] using congrArg (comap f) hWimage
  have hWcover : W ⊔ f.ker ⊔ S = ⊤ := by rwa [hWC]
  have hPW : P ≤ W := by
    rw [hP]
    exact embedded_pResidual_le_of_normal_sup_pGroup W R _ hR
      (normalClosure_le_sup_of_normalizing_cover W R f.ker S
        (hc.trans (centralizer_le (show R ≤ P ⊔ R from le_sup_right))) hs hWcover)
  apply map_injective P.subtype_injective
  rw [← MonoidHom.range_eq_map, range_subtype]
  exact le_antisymm (map_subtype_le _) hPW

/-- An abelian image with central kernel gives class at most two. -/
public theorem commutator_le_center_of_abelian_image_central_kernel
    {H K : Type*} [Group H] [Group K] (f : H →* K) (P : Subgroup H)
    (hab : IsMulCommutative (P.map f))
    (hc : f.ker ≤ centralizer (P : Set H)) :
    _root_.commutator P ≤ center P := by
  have hder : ⁅P, P⁆ ≤ f.ker := by
    rw [← map_eq_bot_iff, map_commutator]
    exact commutator_self_eq_bot_iff.mpr hab
  intro x hx
  have hxder : (x : H) ∈ ⁅P, P⁆ := by
    rw [← P.map_subtype_commutator]
    exact mem_map_of_mem _ hx
  apply mem_center_iff.mpr
  intro y
  exact Subtype.ext (mem_centralizer_iff.mp (hc (hder hxder)) y y.property)

end Subgroup
