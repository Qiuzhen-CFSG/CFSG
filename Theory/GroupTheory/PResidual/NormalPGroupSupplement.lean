module
public import Theory.GroupTheory.PResidual.Restriction

/-!
# The residual of a normal subgroup with a p-group supplement

If a finite group is generated by a normal subgroup N and a p-subgroup,
its quotient by N is a p-group. Thus N contains the ambient p-residual;
p-perfectness and functoriality identify this with the embedded residual
of N. No part of the kernel is factored out.

Source application: the Baumann normal closure in MS93 (5.1), printed
p.913, preserves the original rank-one envelope's residual action.
-/
public section
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- A normal subgroup with a p-group supplement has the same embedded
whole p-residual. -/
theorem pResidual_of_normal_pGroup_supplement (p : ℕ) (N T : Subgroup G) [N.Normal]
    (hT : IsPGroup p T) (hgen : N ⊔ T = ⊤) :
    (pResidual p N).map N.subtype = pResidual p G := by
  have hr : pResidual p G ≤ N :=
    sInf_le ⟨inferInstance,isPGroup_quotient_of_sup_eq_top N T hT hgen⟩
  have hh := embedded_pResidual_eq_of_le_of_residual_le p (show N ≤ ⊤ from le_top)
    (show (pResidual p (⊤ : Subgroup G)).map (⊤ : Subgroup G).subtype ≤ N by
      change (pResidual p (⊤ : Subgroup G)).map Subgroup.topEquiv.toMonoidHom ≤ N
      rw [map_pResidual]
      exact hr)
  change (pResidual p N).map N.subtype =
    (pResidual p (⊤ : Subgroup G)).map Subgroup.topEquiv.toMonoidHom at hh
  rwa [map_pResidual] at hh

end Subgroup
