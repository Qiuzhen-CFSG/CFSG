module
public import Theory.GroupTheory.CoprimeCentralizerImageDecomposition
public import Theory.GroupTheory.PResidual.CenterlessSylow
public import Theory.GroupTheory.PResidual.Quotient
public import Theory.PGroupCore

/-!
# Residual generation in a centerless core centralizer

Let A be an abelian normal subgroup of O₂(G) centralizing O₂(G).
If G is centerless and O²(G/O₂(G)) has odd order, then A = [A,O²(G)].
The actual conjugation image of O²(G) has odd order, even though O²(G)
itself need not. Coprime action splits A into its moving and fixed parts;
the fixed part vanishes by the centerless Sylow-centralizer theorem.

Application: the binary-field, distance-three subcase of DGS 9.8,
Groups and Graphs (1985), printed p.145. This is ordinary finite-group
mathematics and makes no graph or natural-module assumption.
-/

@[expose] public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- In a centerless group, an abelian normal subgroup centralizing the
actual two-core is generated by residual commutators when the residual
image modulo that core has odd order. -/
theorem core_central_subgroup_eq_residual_commutator
    (A : Subgroup G) [A.Normal] [IsMulCommutative A]
    (hA : A ≤ pCore 2 G) (hAC : A ≤ centralizer (pCore 2 G : Set G))
    (hz : center G = ⊥)
    (ho : Odd (Nat.card (pResidual 2 (G ⧸ pCore 2 G)))) :
    A = ⁅A,pResidual 2 G⁆ := by
  let R := pResidual 2 G
  have hn : R ≤ normalizer (A : Set G) := le_normalizer_of_normal
  let f := A.normalizerMonoidHom.comp (inclusion hn)
  have hk : f.ker = (centralizer (A : Set G)).subgroupOf R := by
    ext r
    change inclusion hn r ∈ A.normalizerMonoidHom.ker ↔ _
    rw [normalizerMonoidHom_ker]
    rfl
  have hc : Nat.card f.range = (centralizer (A : Set G)).relIndex R := by
    rw [←index_ker,hk]
    rfl
  have hi : Odd ((pCore 2 G).relIndex R) := by
    have hh := relIndex_ker R (QuotientGroup.mk' (pCore 2 G))
    rw [QuotientGroup.ker_mk',map_pResidual_of_surjective 2 _ (QuotientGroup.mk'_surjective _)] at hh
    exact hh.symm ▸ ho
  have hfodd : Odd (Nat.card f.range) := by
    rw [hc]
    exact hi.of_dvd_nat (relIndex_dvd_of_le_left R (le_centralizer_iff.mp hAC))
  have hp : IsPGroup 2 A := pCore_isPGroup.to_le hA
  obtain ⟨n,hcard⟩ := hp.exists_card_eq
  have hcop : Nat.Coprime (Nat.card f.range) (Nat.card A) := by
    rw [hcard]
    exact hfodd.coprime_two_right.pow_right n
  have hsplit := eq_commutator_sup_centralizer_of_actionRange_coprime A R hn hcop
  let T : Sylow 2 G := Classical.choice inferInstance
  have hfix : A ⊓ centralizer (R : Set G) = ⊥ := by
    apply bot_unique
    rw [←sylow_inf_centralizer_pResidual_eq_bot_of_center_eq_bot T hz]
    exact inf_le_inf (hp.le_sylow_of_normal T) le_rfl
  simpa only [hfix,sup_bot_eq] using hsplit

end Subgroup
