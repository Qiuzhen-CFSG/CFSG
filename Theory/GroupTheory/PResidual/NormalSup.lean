module
public import Theory.GroupTheory.PResidual.PerfectCover
public import Mathlib.GroupTheory.PGroup
/-!
# Prime residuals of a normal generating pair

The residual of a product of two normal subgroups is generated by their
embedded residuals. The quotient by this generated subgroup is a product
of normal p-groups. Applying the identity inside the join also covers
relatively normal subgroups, and containment of the ambient residual then
identifies their residual join with the original ambient residual.

Source application: the two original component preimages in E.2.3.
-/
public section
namespace Subgroup
variable {G D : Type*} [Group G] [Finite G] [Group D]

private theorem image_isPGroup_of_embedded_residual_le_ker (p : ℕ)
    (A : Subgroup G) (f : G →* D)
    (h : (pResidual p A).map A.subtype ≤ f.ker) : IsPGroup p (A.map f) := by
  intro x
  obtain ⟨a,ha,he⟩ := x.property
  obtain ⟨n,hn⟩ := isPGroup_quotient_pResidual (G := A) p
    (QuotientGroup.mk' (pResidual p A) ⟨a,ha⟩)
  have hn' : (⟨a,ha⟩ : A) ^ p ^ n ∈ pResidual p A := by
    exact (QuotientGroup.eq_one_iff _).mp hn
  refine ⟨n,Subtype.ext ?_⟩
  change (x:D) ^ p ^ n = 1
  rw [← he,← map_pow]
  exact h (mem_map_of_mem A.subtype hn')

theorem embedded_pResidual_sup_eq_of_normal_sup_top (p : ℕ)
    (A B : Subgroup G) [A.Normal] [B.Normal] (hAB : A ⊔ B = ⊤) :
    (pResidual p A).map A.subtype ⊔ (pResidual p B).map B.subtype = pResidual p G := by
  let R := (pResidual p A).map A.subtype ⊔ (pResidual p B).map B.subtype
  have hRG : R ≤ pResidual p G := sup_le (map_pResidual_le p A.subtype)
    (map_pResidual_le p B.subtype)
  let π := QuotientGroup.mk' R
  have hA := image_isPGroup_of_embedded_residual_le_ker p A π
    (by rw [QuotientGroup.ker_mk']; exact le_sup_left)
  have hB := image_isPGroup_of_embedded_residual_le_ker p B π
    (by rw [QuotientGroup.ker_mk']; exact le_sup_right)
  let : (B.map π).Normal := Normal.map (inferInstance : B.Normal) π
    (QuotientGroup.mk'_surjective R)
  have hp := hA.to_sup_of_normal_right hB
  have htop : A.map π ⊔ B.map π = ⊤ := by
    rw [← map_sup,hAB,map_top_of_surjective _ (QuotientGroup.mk'_surjective R)]
  have hq : IsPGroup p (G ⧸ R) :=
    (htop ▸ hp).of_equiv (Subgroup.topEquiv : (⊤ : Subgroup (G ⧸ R)) ≃* G ⧸ R)
  exact le_antisymm hRG (sInf_le ⟨inferInstance,hq⟩)

theorem embedded_pResidual_sup_of_relative_normal (p : ℕ)
    (A B : Subgroup G) [(A.subgroupOf (A ⊔ B)).Normal] [(B.subgroupOf (A ⊔ B)).Normal] :
    (pResidual p A).map A.subtype ⊔ (pResidual p B).map B.subtype =
      (pResidual p (A ⊔ B : Subgroup G)).map (A ⊔ B).subtype := by
  have h := embedded_pResidual_sup_eq_of_normal_sup_top p
    (A.subgroupOf (A ⊔ B)) (B.subgroupOf (A ⊔ B))
    (by rw [← subgroupOf_sup le_sup_left le_sup_right,subgroupOf_self])
  have hm := congrArg (map (A ⊔ B).subtype) h
  rw [map_sup,map_embedded_pResidual,map_embedded_pResidual,
    map_subgroupOf_eq_of_le le_sup_left,map_subgroupOf_eq_of_le le_sup_right] at hm
  exact hm

theorem embedded_pResidual_sup_eq_of_contains_residual (p : ℕ)
    (A B : Subgroup G) [(A.subgroupOf (A ⊔ B)).Normal] [(B.subgroupOf (A ⊔ B)).Normal]
    (hR : pResidual p G ≤ A ⊔ B) :
    (pResidual p A).map A.subtype ⊔ (pResidual p B).map B.subtype = pResidual p G := by
  rw [embedded_pResidual_sup_of_relative_normal]
  apply le_antisymm (map_pResidual_le p (A ⊔ B).subtype)
  have h := embedded_pResidual_mono p hR
  intro x hx
  apply h
  exact mem_map.mpr ⟨⟨x, hx⟩, by
    rw [(pResidual_eq_top_iff p _).mpr (isPPerfect_pResidual p)]
    trivial, rfl⟩
end Subgroup
