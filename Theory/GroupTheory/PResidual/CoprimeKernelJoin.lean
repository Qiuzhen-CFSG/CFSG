module
public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Theory.GroupTheory.Commutator.NormalizesSupplement

/-!
# Removing a coprime kernel from a generated residual

Suppose G=QP, V is normal and contained in Q, and [P,Q]≤V. Then VP is
normal. If Q has order prime to p and VP is generated by p-elements,
O^{p′}(G)=VP. The index divides |Q|. In the short-block application Q
is the possible two-kernel above the natural module; it is not discarded
or assumed equal to that module.

Source: the central-cover lift in Aschbacher–Smith 13.5.6, printed p.917.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G]

theorem primeToResidual_eq_sup_of_coprime_kernel
    (p : ℕ) (Q V P : Subgroup G) [V.Normal]
    (hVQ : V ≤ Q) (hcomm : ⁅P,Q⁆ ≤ V) (hgen : Q⊔P=⊤)
    (hcop : Nat.Coprime p (Nat.card Q))
    (hX : primeToResidual p (V⊔P : Subgroup G)=⊤) :
    primeToResidual p G = V⊔P := by
  let X := V⊔P
  have hQ : Q ≤ normalizer (X : Set G) := by
    simpa only [X,sup_comm V P] using
      le_normalizer_sup_of_commutator_le P Q P V le_rfl hcomm
  have hN : (⊤ : Subgroup G) ≤ normalizer (X : Set G) := by
    rw [←hgen]
    exact sup_le hQ (le_sup_right.trans X.le_normalizer)
  let : X.Normal := normalizer_eq_top_iff.mp (top_unique hN)
  have htop : Q⊔X=⊤ := by simpa only [X,←sup_assoc,sup_of_le_left hVQ] using hgen
  have hidx : X.index ∣ Nat.card Q := by
    have he := relIndex_sup_right Q X
    rw [htop,relIndex_top_right] at he
    rw [he]
    exact relIndex_dvd_card _ _
  exact le_antisymm (primeToResidual_le X (hcop.of_dvd_right hidx))
    (le_primeToResidual_of_eq_top p X hX)
end Subgroup
