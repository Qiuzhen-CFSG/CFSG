module

public import Theory.GroupTheory.PResidual.CubicGeneration
public import Theory.GroupTheory.OddSubgroupLift
public import Theory.GroupTheory.PResidual.PrimeSection

/-!
# Cubic generation above a two-group kernel

A finite two-perfect group whose quotient by its two-core has exponent
three is generated by elements of order three. Lift the whole odd
quotient through the two-group kernel; injectivity makes every nonidentity
element of the lift cubic. Its normal closure has two-group quotient,
which two-perfectness makes trivial. This includes an elementary quotient
of order nine and does not assume that nine fails to divide the group order.

Source application: Aschbacher–Smith, 13.7.3(9) and 13.7.5, pp.936–938.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- The exponent-three quotient may have arbitrary order. -/
theorem cubic_closure_eq_top_of_twoPerfect_of_quotient_cube
    (hperfect : IsPPerfect 2 G)
    (hcube : ∀ x : G ⧸ pCore 2 G, x ^ 3 = 1) :
    closure {x : G | orderOf x = 3} = ⊤ := by
  let C : Subgroup G := closure {x : G | orderOf x = 3}
  let q := QuotientGroup.mk' (pCore 2 G)
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  have hker : IsPGroup 2 q.ker := by
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hp : IsPGroup 3 (G ⧸ pCore 2 G) := fun x => ⟨1, by simpa using hcube x⟩
  obtain ⟨n, hn⟩ := hp.exists_card_eq
  have hodd : Odd (Nat.card (⊤ : Subgroup (G ⧸ pCore 2 G))) := by
    rw [card_top, hn]
    exact (by decide : Odd 3).pow
  obtain ⟨D, hD, hi, _, _⟩ := q.exists_odd_subgroup_lift hq hker ⊤ hodd
  have hDC : D ≤ C := by
    intro x hx
    by_cases he : x = 1
    · exact he ▸ C.one_mem
    · apply subset_closure
      apply orderOf_eq_prime _ he
      have hh : (⟨x, hx⟩ : D) ^ 3 = 1 := by
        apply hi
        change q (x ^ 3) = q 1
        rw [map_pow, map_one]
        exact hcube (q x)
      exact congrArg Subtype.val hh
  have hnormal : (⊤ : Subgroup G) ≤ normalizer (C : Set G) := by
    apply le_normalizer_closure_iff.mpr
    intro g _ x hx
    exact subset_closure ((MulAut.conj g).orderOf_eq x |>.trans hx)
  let : C.Normal := normalizer_eq_top_iff.mp (top_unique hnormal)
  have hmap : C.map q = ⊤ := top_unique (hD ▸ map_mono hDC)
  have hsup : C ⊔ pCore 2 G = ⊤ := by
    have hh := congrArg (comap q) hmap
    simpa only [comap_map_eq, q, QuotientGroup.ker_mk', comap_top] using hh
  let r := QuotientGroup.mk' C
  have hr : (pCore 2 G).map r = ⊤ := by
    have hh := congrArg (map r) hsup
    simpa only [map_sup, r, QuotientGroup.map_mk'_self, bot_sup_eq,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] using hh
  have hquot : IsPGroup 2 (G ⧸ C) :=
    (hr ▸ (pCore_isPGroup (p := 2) (G := G)).map r).of_equiv topEquiv
  have hres : pResidual 2 G ≤ C := sInf_le ⟨inferInstance, hquot⟩
  rw [(pResidual_eq_top_iff 2 G).mpr hperfect] at hres
  exact top_unique hres

end Subgroup
