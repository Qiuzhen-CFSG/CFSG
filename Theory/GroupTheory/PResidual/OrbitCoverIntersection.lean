module
public import Theory.GroupTheory.ConjugateSpanSylow
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.PCoreImage

/-!
# Residuals generated by covering conjugate spans

Suppose the I-conjugates of L generate X, while U contains I and
normalizes X. If the perfect subgroup A lies in X ∩ U and covers L
modulo O_p(X), then its U-conjugate span is exactly O^p(X ∩ U).
The orbit cover expresses X ∩ U as that normal perfect span times
a p-subgroup; normal-subgroup residual recognition completes the proof.

This is the orbit-generation step in Aschbacher–Smith, 4.2.4, combined
manuscript of 1 March 2004, printed p.608.
-/

public section
open scoped Pointwise
namespace Subgroup
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

/-- A perfect covering subgroup generates the residual of the literal
intersection under the larger normalizing actor. -/
theorem conjugateSpanBy_eq_pResidual_intersection_of_core_cover {A L X U I : Subgroup G} [Group.IsPerfect A]
    (hAX : A ≤ X) (hAU : A ≤ U) (hUX : U ≤ normalizer (X : Set G))
    (hIU : I ≤ U) (horbit : conjugateSpanBy L I = X)
    (hcover : L ≤ A ⊔ X.pCoreIn p) :
    conjugateSpanBy A U = (pResidual p (X ⊓ U : Subgroup G)).map (X ⊓ U).subtype := by
  let Y := conjugateSpanBy A U
  let N := X.pCoreIn p
  let Q := X ⊓ U
  have hYX : Y ≤ X := conjugateSpanBy_le hAX hUX
  have hYU : Y ≤ U := conjugateSpanBy_le_self hAU
  have hYQ : Y ≤ Q := le_inf hYX hYU
  have hUY : U ≤ normalizer (Y : Set G) := le_normalizer_conjugateSpanBy A U
  have hUN : U ≤ normalizer (N : Set G) :=
    hUX.trans (normalizer_le_normalizer_characteristic_image X (pCore p X))
  have hYN : Y ≤ normalizer (N : Set G) := hYU.trans hUN
  have hXN : X ≤ Y ⊔ N := by
    rw [← horbit]
    apply conjugateSpanBy_le
    · exact hcover.trans (sup_le_sup (le_conjugateSpanBy A U) le_rfl)
    · exact (le_inf (hIU.trans hUY) (hIU.trans hUN)).trans
        (normalizer_inf_normalizer_le_normalizer_sup Y N)
  have hNQ : N ⊓ U ≤ Q := inf_le_inf (pCoreIn_le p X) le_rfl
  have hgen : Y ⊔ (N ⊓ U) = Q := by
    apply le_antisymm (sup_le hYQ hNQ)
    intro x hx
    have hx' : x ∈ (Y : Set G) * (N : Set G) := by
      rw [← coe_mul_of_left_le_normalizer_right Y N hYN]
      exact hXN hx.1
    obtain ⟨y, hy, n, hn, he⟩ := hx'
    have hnU : n ∈ U := by
      have hh := U.mul_mem (U.inv_mem (hYU hy)) hx.2
      rw [← he] at hh
      simpa only [inv_mul_cancel_left] using hh
    rw [← he]
    exact mul_mem_sup hy ⟨hn, hnU⟩
  let Y' := Y.subgroupOf Q
  let N' := (N ⊓ U).subgroupOf Q
  let : Y'.Normal := normal_subgroupOf_of_le_normalizer (inf_le_right.trans hUY)
  let : Group.IsPerfect Y := conjugateSpanBy_isPerfect A U
  let : Group.IsPerfect Y' := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hYQ).symm.toMonoidHom)
      (subgroupOfEquivOfLe hYQ).symm.surjective
  have hpY : IsPPerfect p Y' := by
    intro K hK hp
    let : K.Normal := hK
    by_contra hne
    let : Nontrivial (Y' ⧸ K) := QuotientGroup.nontrivial_iff.mpr hne
    let : Group.IsPerfect (Y' ⧸ K) :=
      Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective K)
    let : Group.IsNilpotent (Y' ⧸ K) := hp.isNilpotent
    exact Group.IsPerfect.not_isSolvable (Y' ⧸ K) inferInstance
  have hpN : IsPGroup p N' := ((isPGroup_pCoreIn p X).to_le inf_le_left).comap_subtype
  have hgen' : Y' ⊔ N' = ⊤ := by
    rw [← subgroupOf_sup hYQ hNQ, hgen, subgroupOf_self]
  have he := pResidual_eq_of_isPPerfect_sup Y' N' hpY hpN hgen'
  have hm := congrArg (map Q.subtype) he
  rw [map_subgroupOf_eq_of_le hYQ] at hm
  exact hm.symm
end Subgroup
