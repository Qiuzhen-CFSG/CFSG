module
public import Theory.GroupTheory.PResidual.CubicClosureTwoKernel
public import Theory.GroupTheory.SpecificGroups.SymmetricThreeProductResidual
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# Cubic generation above S₃ × S₃

A finite group mapping to S₃ × S₃ with a two-group kernel has its
entire two-residual generated by elements of order three. The image
of the residual lies in A₃ × A₃ and therefore has exponent three.
Cubic lifting and two-perfectness give generation of the full residual,
including its intersection with the original kernel.

The map need not be surjective. The seed-normalizer application in
Aschbacher--Smith 13.8.32 uses the two diagonal actions of the binary
plane stabilizer. Source: The Classification of Quasithin Groups,
combined manuscript of 1 March 2004, printed p.965.
-/

public section
open Subgroup
namespace SymmetricThreeProductResidual
variable {G : Type*} [Group G] [Finite G]

/-- Cubics generate the literal two-residual, including the two-group kernel. -/
theorem cubic_closure_eq_twoResidual
    (f : G →* Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3))
    (hk : IsPGroup 2 f.ker) :
    closure {x : G | orderOf x = 3} = pResidual 2 G := by
  let R := pResidual 2 G
  let q := f.comp R.subtype
  have hq : IsPGroup 2 q.ker := by
    rw [←MonoidHom.comap_ker]
    exact hk.comap_of_injective R.subtype R.subtype_injective
  have hcube (x : R) : (q x)^3 = 1 := by
    have hx := map_pResidual_le 2 f (mem_map_of_mem f x.property)
    rw [residual_eq] at hx
    have hp (a : Equiv.Perm (Fin 3)) (ha : a ∈ alternatingGroup (Fin 3)) : a^3=1 := by
      have hc : Nat.card (alternatingGroup (Fin 3)) = 3 := by
        rw [nat_card_alternatingGroup, Nat.card_fin]
        rfl
      have hh := pow_card_eq_one' (x := (⟨a,ha⟩ : alternatingGroup (Fin 3)))
      rw [hc] at hh
      exact congrArg Subtype.val hh
    exact Prod.ext (hp _ hx.1) (hp _ hx.2)
  have hc := cubic_closure_eq_twoResidual_of_cube_image q hq hcube
  rw [(pResidual_eq_top_iff 2 R).mpr (isPPerfect_pResidual 2)] at hc
  have hm := congrArg (map R.subtype) hc
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at hm
  apply le_antisymm
  · apply (closure_le _).mpr
    intro x hx
    exact mem_pResidual_of_orderOf_coprime (by rw [hx]; decide)
  · change R ≤ _
    rw [←hm]
    apply closure_mono
    rintro _ ⟨x,hx,rfl⟩
    exact (R.orderOf_coe x).trans hx

end SymmetricThreeProductResidual
