module

public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.PRegularLift
public import Theory.GroupTheory.PrimeOrderLift

/-!
# Cubic generation above a two-group kernel

If a finite group maps with two-group kernel to an exponent-three image,
its two-residual is exactly the subgroup generated by its cubic elements.
Prime-regular lifting gives cubic representatives of every image element;
the quotient by their normal closure is consequently a two-group. The
reverse containment follows because cubic elements lie in the two-residual.

This is the lifting step for the central preimage in Aschbacher--Smith
15.2.3(1)(ii), printed p.1105. The map is retained explicitly and need not
be surjective onto its codomain.
-/

public section
open Subgroup
namespace Subgroup
variable {G H : Type*} [Group G] [Finite G] [Group H]

/-- A two-group kernel and exponent-three image identify the cubic closure. -/
theorem cubic_closure_eq_twoResidual_of_cube_image
    (f : G →* H) (hk : IsPGroup 2 f.ker) (hcube : ∀ x : G, (f x) ^ 3 = 1) :
    closure {x : G | orderOf x = 3} = pResidual 2 G := by
  let C : Subgroup G := closure {x : G | orderOf x = 3}
  let q := f.rangeRestrict
  have hqk : IsPGroup 2 q.ker := by
    change IsPGroup 2 f.rangeRestrict.ker
    rw [MonoidHom.ker_rangeRestrict]
    exact hk
  have hnormal : (⊤ : Subgroup G) ≤ normalizer (C : Set G) := by
    apply le_normalizer_closure_iff.mpr
    intro g _ x hx
    exact subset_closure ((MulAut.conj g).orderOf_eq x |>.trans hx)
  let : C.Normal := normalizer_eq_top_iff.mp (top_unique hnormal)
  have hm : C.map q = ⊤ := by
    apply top_unique
    intro z _
    by_cases hz : z = 1
    · exact hz ▸ one_mem _
    have hz3 : z ^ 3 = 1 := by
      obtain ⟨x, rfl⟩ := f.rangeRestrict_surjective z
      exact Subtype.ext (hcube x)
    have hzo : orderOf z = 3 := orderOf_eq_prime hz3 hz
    obtain ⟨a, haodd, haz⟩ := q.exists_pRegular_lift f.rangeRestrict_surjective
      2 Nat.prime_two z (by rw [hzo]; decide)
    have hao : orderOf a = 3 := by
      rw [← q.orderOf_map_eq_of_coprime_of_isPGroup_ker hqk a
        (Nat.prime_two.coprime_iff_not_dvd.mpr haodd), haz, hzo]
    exact ⟨a, subset_closure hao, haz⟩
  have hs : C ⊔ q.ker = ⊤ := by
    have hh := congrArg (comap q) hm
    simpa only [comap_map_eq, comap_top] using hh
  apply le_antisymm
  · apply (closure_le _).mpr
    intro x hx
    exact mem_pResidual_of_orderOf_coprime (by rw [hx]; decide)
  · exact sInf_le ⟨inferInstance, isPGroup_quotient_of_sup_eq_top C q.ker hqk hs⟩

end Subgroup
