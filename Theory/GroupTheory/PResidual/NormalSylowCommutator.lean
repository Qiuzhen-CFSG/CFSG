module

public import Theory.GroupTheory.PResidual.CentralSylowFrattini
public import Theory.PGroupCore
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.PResidual.FiniteImage
public import Theory.GroupTheory.NormalizedSupConsequences

/-!
# Normal Sylow subgroups in a prime residual

A normal Sylow p-subgroup of a finite p-perfect group is generated by its
commutators with that group. Modulo those commutators it is central, so the
existing transfer/Frattini theorem places it in the trivial subgroup.

When the p-residual above O_p(G) has order prime to p, the intersection
O_p(G) ∩ O^p(G) is consequently [O_p(G),O^p(G)]. A p-subgroup R containing
this commutator is Sylow in O^p(G)R, by the normal-product index formula.
No characteristic-p hypothesis or block classification enters the proof.

Source: Aschbacher–Smith, D.1.4, final Sylow argument on printed p.176,
used in 15.4.2(4), printed pp.1155–1156, refs/quasithin.pdf.
-/

noncomputable section
namespace Subgroup
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

/-- A normal Sylow subgroup of a p-perfect group is generated by its
commutators with the whole group. -/
public theorem normalSylow_eq_commutator_of_isPPerfect
    (hp : IsPPerfect p G) (S : Sylow p G) [(S : Subgroup G).Normal] :
    (S : Subgroup G) = ⁅(S : Subgroup G), ⊤⁆ := by
  let N : Subgroup G := ⁅(S : Subgroup G), ⊤⁆
  let q : G →* G ⧸ (S : Subgroup G) := QuotientGroup.mk' (S : Subgroup G)
  let qN : G →* G ⧸ N := QuotientGroup.mk' N
  have hNS : N ≤ q.ker := by
    rw [QuotientGroup.ker_mk']
    exact commutator_le_left _ _
  have hc : q.ker ≤ (center (G ⧸ N)).comap qN := by
    rw [QuotientGroup.ker_mk']
    apply map_le_iff_le_comap.mp
    apply commutator_top_right_eq_bot_iff_le_center.mp
    rw [← map_top_of_surjective qN (QuotientGroup.mk'_surjective N), ← map_commutator]
    apply (map_eq_bot_iff N).mpr
    rw [QuotientGroup.ker_mk']
  have hcover : (S : Subgroup G).map q ≤ (⊥ : Subgroup G).map q := by
    rw [map_bot]
    apply ((map_eq_bot_iff (S : Subgroup G)).mpr ?_).le
    rw [QuotientGroup.ker_mk']
  have h := sylow_le_sup_of_image_cover_of_central_kernel_mod
    hp S q N hNS hc ⊥ bot_le hcover
  exact le_antisymm (by simpa only [bot_sup_eq] using h) (commutator_le_left _ _)

omit [Fact p.Prime] in
private theorem core_relIndex_residual_coprime
    (hodd : Nat.Coprime p (Nat.card (pResidual p (G ⧸ pCore p G)))) :
    Nat.Coprime p ((pCore p G).relIndex (pResidual p G)) := by
  let L : Subgroup G := pResidual p G
  let q : G →* G ⧸ pCore p G := QuotientGroup.mk' (pCore p G)
  let f : L →* G ⧸ pCore p G := q.comp L.subtype
  have hk : f.ker = (pCore p G).subgroupOf L := by
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
    rfl
  have hr : f.range = pResidual p (G ⧸ pCore p G) := by
    rw [MonoidHom.range_comp, range_subtype]
    exact map_pResidual_of_surjective p q (QuotientGroup.mk'_surjective _)
  have hi : (pCore p G).relIndex L = Nat.card f.range := by
    rw [relIndex, index_eq_card, ← hk]
    exact Nat.card_congr (QuotientGroup.quotientKerEquivRange f).toEquiv
  rw [hi, hr]
  exact hodd

/-- The normal Sylow subgroup in the residual is its commutator with the
ambient p-core, once the residual above that core has order prime to p. -/
public theorem core_inf_residual_eq_commutator_of_quotient_coprime
    (hodd : Nat.Coprime p (Nat.card (pResidual p (G ⧸ pCore p G)))) :
    pCore p G ⊓ pResidual p G = ⁅pCore p G, pResidual p G⁆ := by
  let L : Subgroup G := pResidual p G
  let P : Subgroup L := (pCore p G).subgroupOf L
  have hP : IsPGroup p P := pCore_isPGroup.comap_subtype
  have hind : ¬ p ∣ P.index := (Fact.out : p.Prime).coprime_iff_not_dvd.mp
    (core_relIndex_residual_coprime hodd)
  let S : Sylow p L := hP.toSylow hind
  have hS : (S : Subgroup L) = P := hP.toSylow_coe hind
  let : (S : Subgroup L).Normal := by rw [hS]; infer_instance
  have he : P = ⁅P, ⊤⁆ := by
    simpa only [hS] using normalSylow_eq_commutator_of_isPPerfect
      (isPPerfect_pResidual p) S
  have hm := congrArg (map L.subtype) he
  have hmapP : P.map L.subtype = pCore p G ⊓ L :=
    subgroupOf_map_subtype (pCore p G) L
  rw [map_commutator, hmapP, ← MonoidHom.range_eq_map, range_subtype] at hm
  apply le_antisymm
  · exact hm.le.trans (commutator_mono inf_le_left le_rfl)
  · exact le_inf (commutator_le_left _ _) (commutator_le_right _ _)

/-- The commutator containment alone places a p-subgroup as Sylow in its
join with the p-residual. No block classification or characteristic-p
assumption is used. -/
public theorem exists_sylow_residual_sup_of_core_commutator
    (R : Subgroup G) (hR : IsPGroup p R)
    (hodd : Nat.Coprime p (Nat.card (pResidual p (G ⧸ pCore p G))))
    (hc : ⁅pCore p G, pResidual p G⁆ ≤ R) :
    ∃ S : Sylow p (pResidual p G ⊔ R : Subgroup G),
      (S : Subgroup (pResidual p G ⊔ R : Subgroup G)).map
        (pResidual p G ⊔ R : Subgroup G).subtype = R := by
  let L : Subgroup G := pResidual p G
  let H : Subgroup G := L ⊔ R
  have hPR : pCore p G ⊓ L ≤ R :=
    (core_inf_residual_eq_commutator_of_quotient_coprime hodd).le.trans hc
  have hd : R.relIndex L ∣ (pCore p G).relIndex L := by
    simpa only [inf_relIndex_left, inf_relIndex_right] using
      relIndex_dvd_of_le_left L hPR
  have hcop : Nat.Coprime p (R.relIndex L) :=
    (core_relIndex_residual_coprime hodd).of_dvd_right hd
  have hi : R.relIndex H = R.relIndex L :=
    relIndex_sup_of_normalizes L R le_normalizer_of_normal
  have hindex : ¬ p ∣ (R.subgroupOf H).index := by
    change ¬ p ∣ R.relIndex H
    rw [hi]
    exact (Fact.out : p.Prime).coprime_iff_not_dvd.mp hcop
  let S : Sylow p H := (hR.comap_subtype (K := H)).toSylow hindex
  refine ⟨S, ?_⟩
  exact map_subgroupOf_eq_of_le (show R ≤ H from le_sup_right)

end Subgroup
