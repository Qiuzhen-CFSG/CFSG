module

public import Theory.GroupTheory.PResidual.PrimeSection
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# Absorbing a normalized prime-group supplement

A p-perfect subgroup contained in B R lies in B whenever the p-group R
normalizes B. Passing to the group generated by B and R supplies the
normality needed by the quotient argument. No ambient normality of B or
normality of R is required.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

theorem le_of_isPPerfect_of_le_sup_of_normalizes {p : ℕ} [Fact p.Prime]
    (A B R : Subgroup G) (hA : IsPPerfect p A) (hR : IsPGroup p R)
    (hRB : R ≤ normalizer (B : Set G)) (hABR : A ≤ B ⊔ R) : A ≤ B := by
  let J := B ⊔ R
  let N := B.subgroupOf J
  let : N.Normal := normal_subgroupOf_of_le_normalizer
    (sup_le B.le_normalizer hRB)
  have hsup : N ⊔ R.subgroupOf J = ⊤ := by
    exact (codisjoint_subgroupOf_sup B R).eq_top
  have hquot := isPGroup_quotient_of_sup_eq_top N (R.subgroupOf J)
    hR.comap_subtype hsup
  let f : A →* J ⧸ N := (QuotientGroup.mk' N).comp (inclusion hABR)
  have hf := hA.hom_eq_one_of_isPGroup hquot f
  intro x hx
  change inclusion hABR ⟨x, hx⟩ ∈ N
  apply (QuotientGroup.eq_one_iff (N := N) (inclusion hABR ⟨x, hx⟩)).mp
  exact congrArg (fun a : A →* J ⧸ N => a ⟨x, hx⟩) hf

end Subgroup
