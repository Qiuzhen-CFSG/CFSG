module
public import Theory.GroupTheory.CentralPChiefCore
public import Theory.GroupTheory.PResidual.PerfectCover
/-!
# Cubic generation from odd-order generators

A finite two-perfect group is generated by elements of odd order. If all
of these have cube one, its elements of order three therefore generate the
whole group. This permits a direct generation argument without first
identifying the quotient by the two-core.

Source application: Aschbacher--Smith, 12.3.12, printed p.811.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- A two-perfect finite group whose odd-order elements have cube one is
 generated by its elements of order three. -/
theorem cubic_closure_eq_top_of_twoPerfect_of_odd_cube
    (hp : IsPPerfect 2 G) (hcube : ∀ x : G, Odd (orderOf x) → x ^ 3 = 1) :
    closure {x : G | orderOf x = 3} = ⊤ := by
  apply top_unique
  rw [← closure_coprime_order_eq_top_of_pResidual_eq_top 2
    ((pResidual_eq_top_iff 2 G).mpr hp)]
  apply (closure_le _).mpr
  intro x hx
  by_cases he : x = 1
  · exact he ▸ one_mem _
  · exact subset_closure (orderOf_eq_prime (hcube x (Nat.coprime_two_left.mp hx)) he)
end Subgroup
