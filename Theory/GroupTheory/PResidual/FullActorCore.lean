module
public import Theory.GroupTheory.Commutator.FullActorNormalLayer
public import Theory.GroupTheory.PResidual.NormalSylowCommutator
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# A normal two-Hall subgroup under a full actor

A normal Sylow two-subgroup of a two-perfect subgroup is generated by its
commutators with that subgroup. If the subgroup is itself generated by
commutators with an actor, centralization modulo a normal layer transfers
along this identity. The relative version works inside a specified overgroup
and bounds the actor commutators using a small fixed subgroup.

This is the group-theoretic last step in Aschbacher–Smith 15.3.52,
printed p.1145.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

theorem normal_two_hall_le_of_full_actor
    (Q Y U V : Subgroup G) [Q.Normal] [V.Normal]
    (hQY : Q ≤ Y) (hQ : IsPGroup 2 Q) (hodd : Odd (Q.subgroupOf Y).index)
    (hY : IsPPerfect 2 Y) (hfull : ⁅Y, U⁆ = Y) (hQU : ⁅Q, U⁆ ≤ V) : Q ≤ V := by
  let P := Q.subgroupOf Y
  have hp : IsPGroup 2 P := hQ.comap_subtype
  have hi : ¬ 2 ∣ P.index := Nat.prime_two.coprime_iff_not_dvd.mp hodd.coprime_two_left
  let S := hp.toSylow hi
  have hS : (S : Subgroup Y) = P := hp.toSylow_coe hi
  let : (S : Subgroup Y).Normal := by rw [hS]; infer_instance
  have he : P = ⁅P, ⊤⁆ := by
    simpa only [hS] using normalSylow_eq_commutator_of_isPPerfect hY S
  have hm := congrArg (map Y.subtype) he
  rw [map_commutator, map_subgroupOf_eq_of_le hQY,
    ← MonoidHom.range_eq_map, range_subtype] at hm
  rw [hm]
  exact commutator_le_of_full_actor Q Y U V hQU hfull


theorem normal_two_hall_le_of_small_fixed
    (M Q Y U V : Subgroup G) (hQM : Q ≤ M) (hYM : Y ≤ M)
    (hUM : U ≤ M) (hVM : V ≤ M)
    (hMQ : M ≤ normalizer (Q : Set G)) (hMV : M ≤ normalizer (V : Set G))
    (hQY : Q ≤ Y) (hQ : IsPGroup 2 Q) (hodd : Odd (Q.subgroupOf Y).index)
    (hY : IsPPerfect 2 Y) (hfull : ⁅Y, U⁆ = Y)
    (hQU : Q ≤ normalizer (U : Set G)) (hQV : Q ≤ centralizer (V : Set G))
    (hsmall : U ⊓ centralizer (V : Set G) ≤ V) : Q ≤ V := by
  let Q' := Q.subgroupOf M
  let Y' := Y.subgroupOf M
  let U' := U.subgroupOf M
  let V' := V.subgroupOf M
  let : Q'.Normal := normal_subgroupOf_of_le_normalizer hMQ
  let : V'.Normal := normal_subgroupOf_of_le_normalizer hMV
  have hbound : ⁅Q, U⁆ ≤ V := by
    apply le_trans (le_inf (le_normalizer_iff_commutator_le_right.mp hQU) ?_) hsmall
    exact (commutator_mono hQV le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp
        ((hUM.trans hMV).trans (normalizer_le_normalizer_centralizer V)))
  have hfull' : ⁅Y', U'⁆ = Y' := by
    apply map_injective M.subtype_injective
    simpa only [Y', U', map_commutator, map_subgroupOf_eq_of_le hYM,
      map_subgroupOf_eq_of_le hUM] using hfull
  have hbound' : ⁅Q', U'⁆ ≤ V' := by
    apply (map_le_map_iff_of_injective M.subtype_injective).mp
    simpa only [Q', U', V', map_commutator, map_subgroupOf_eq_of_le hQM,
      map_subgroupOf_eq_of_le hUM, map_subgroupOf_eq_of_le hVM] using hbound
  have hodd' : Odd (Q'.subgroupOf Y').index := by
    have hi := relIndex_map_map_of_injective Q' Y' M.subtype_injective
    rw [map_subgroupOf_eq_of_le hQM, map_subgroupOf_eq_of_le hYM] at hi
    change Odd (Q'.relIndex Y')
    rwa [← hi]
  have hY' : IsPPerfect 2 Y' := hY.of_surjective
    (subgroupOfEquivOfLe hYM).symm.toMonoidHom (subgroupOfEquivOfLe hYM).symm.surjective
  have hle := normal_two_hall_le_of_full_actor Q' Y' U' V'
    (subgroupOf_mono M hQY) hQ.comap_subtype hodd' hY' hfull' hbound'
  have hm := map_mono (f := M.subtype) hle
  simpa only [Q', V', map_subgroupOf_eq_of_le hQM, map_subgroupOf_eq_of_le hVM] using hm


end Subgroup
