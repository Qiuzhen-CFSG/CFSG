module

public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Theory.GroupTheory.PResidual.PrimeToMonotone
public import Theory.GroupTheory.SolvableOuterQuotient
public import Theory.GroupTheory.NormalClosureCentralizerCore

/-!
# Residuals of paired centralizers

A subnormal subgroup generated by its p-elements equals the ambient
prime-to-p residual when its normalizer residual is contained in it.
Induction along a subnormal chain proves this without assuming normality.
Coprime centralizer and outer-automorphism orders give a practical criterion.

For commuting subgroups K and L, fix an element i of K whose intrinsic
centralizer and both outer automorphism groups have order prime to p.
The automorphisms fixing i have order prime to p. Thus a prime-to-p
centralizer of KL identifies L as the residual of C(i) intersected with
N(K), provided L is subnormal there and generated by p-elements.
If automorphisms preserve the K-class of i and the two normalizers have
equal order, a Frattini argument identifies their normalizers and gives
the residual of the full C(i).

Source: Aschbacher--Smith, combined manuscript (1 March 2004),
the paired residual calculation in 2.5.20, printed p.564. The final theorem
keeps component persistence as its precise subnormality hypothesis.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

theorem primeToResidual_eq_of_subnormal_normalizer (p : ℕ) (X : Subgroup G)
    (hsub : X.IsSubnormal) (hX : primeToResidual p X = ⊤)
    (hN : (primeToResidual p (normalizer (X : Set G))).map
      (normalizer (X : Set G)).subtype ≤ X) : primeToResidual p G = X := by
  obtain ⟨n, F, hmono, hnorm, hzero, hn⟩ := hsub.exists_chain
  have hXF (i : ℕ) : X ≤ F i := hzero ▸ hmono (Nat.zero_le i)
  have hmain (i : ℕ) : (primeToResidual p (F i)).map (F i).subtype = X := by
    induction i with
    | zero => rw [hzero, hX, ← MonoidHom.range_eq_map, range_subtype]
    | succ i ih =>
      have hFN : F (i + 1) ≤ normalizer (X : Set G) := by
        rw [← ih]
        exact ((normal_subgroupOf_iff_le_normalizer (hmono (Nat.le_succ i))).mp
          (hnorm i)).trans
          (normalizer_le_normalizer_characteristic_image (F i) (primeToResidual p (F i)))
      apply le_antisymm ((embedded_primeToResidual_mono p hFN).trans hN)
      have hh := embedded_primeToResidual_mono p (hXF (i + 1))
      rwa [hX, ← MonoidHom.range_eq_map, range_subtype] at hh
  have hh := hmain n
  rw [hn] at hh
  change (primeToResidual p (⊤ : Subgroup G)).map topEquiv.toMonoidHom = X at hh
  rwa [map_primeToResidual] at hh

private theorem index_coprime_of_centralizer_outer (p : ℕ) (X : Subgroup G) [X.Normal]
    (hC : Nat.Coprime p (Nat.card (centralizer (X : Set G))))
    (hO : Nat.Coprime p (Nat.card (MulAut.Outer X))) : Nat.Coprime p X.index := by
  let f : G →* MulAut.Outer X :=
    (QuotientGroup.mk' (MulAut.innerSubgroup X)).comp MulAut.conjNormal
  have hk : f.ker = X ⊔ centralizer (X : Set G) := by
    change ((QuotientGroup.mk' (MulAut.innerSubgroup X)).comp
      (MulAut.conjNormal : G →* MulAut X)).ker = _
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk', MulAut.conjNormal_comap_innerSubgroup]
  have hf : Nat.Coprime p f.ker.index := by
    rw [index_ker]
    exact hO.coprime_dvd_right f.range.card_subgroup_dvd_card
  rw [hk] at hf
  rw [← relIndex_mul_index (show X ≤ X ⊔ centralizer (X : Set G) from le_sup_left)]
  apply Nat.Coprime.mul_right _ hf
  rw [relIndex_sup_left]
  exact hC.coprime_dvd_right (relIndex_dvd_card _ _)

theorem primeToResidual_eq_of_subnormal_centralizer_outer (p : ℕ) (X : Subgroup G)
    (hsub : X.IsSubnormal) (hX : primeToResidual p X = ⊤)
    (hC : Nat.Coprime p (Nat.card (centralizer (X : Set G))))
    (hO : Nat.Coprime p (Nat.card (MulAut.Outer X))) : primeToResidual p G = X := by
  apply primeToResidual_eq_of_subnormal_normalizer p X hsub hX
  let N := normalizer (X : Set G)
  let A := X.subgroupOf N
  let : A.Normal := normal_subgroupOf_of_le_normalizer le_rfl
  have hAC : Nat.Coprime p (Nat.card (centralizer (A : Set N))) := by
    have hm : (centralizer (A : Set N)).map N.subtype ≤ centralizer (X : Set G) := by
      rw [map_centralizer_subtype, map_subgroupOf_eq_of_le X.le_normalizer]
      exact inf_le_right
    have hh := hC.coprime_dvd_right (card_dvd_of_le hm)
    rwa [card_map_of_injective N.subtype_injective] at hh
  have hAO : Nat.Coprime p (Nat.card (MulAut.Outer A)) := by
    rwa [Nat.card_congr (MulAut.outerCongr (subgroupOfEquivOfLe X.le_normalizer)).toEquiv]
  have hh := map_mono (f := N.subtype)
    (primeToResidual_le A (index_coprime_of_centralizer_outer p A hAC hAO))
  rwa [map_subgroupOf_eq_of_le X.le_normalizer] at hh
end Subgroup

namespace Subgroup
variable {G : Type*} [Group G]
theorem embedded_primeToResidual_eq_of_subnormal_normalizer (p : ℕ) (L J : Subgroup G) (hLJ : L ≤ J)
    (hsub : (L.subgroupOf J).IsSubnormal) (hL : primeToResidual p L = ⊤)
    (hN : (primeToResidual p (J ⊓ normalizer (L : Set G) : Subgroup G)).map
      (J ⊓ normalizer (L : Set G)).subtype ≤ L) :
    (primeToResidual p J).map J.subtype = L := by
  let A := L.subgroupOf J
  have hA : primeToResidual p A = ⊤ := by
    have hh := map_primeToResidual (p := p) (subgroupOfEquivOfLe hLJ).symm
    rw [hL, map_top_of_surjective _ (subgroupOfEquivOfLe hLJ).symm.surjective] at hh
    exact hh.symm
  have hh : primeToResidual p J = A := by
    apply primeToResidual_eq_of_subnormal_normalizer p A hsub hA
    let B := normalizer (A : Set J)
    let I := J ⊓ normalizer (L : Set G)
    let f : B →* I :=
      (J.subtype.comp B.subtype).codRestrict I (fun b => ⟨b.val.property, by
        have hb := b.property
        change (b : J) ∈ normalizer (L.subgroupOf J : Set J) at hb
        rw [← subgroupOf_normalizer_eq hLJ] at hb
        exact hb⟩)
    rintro x ⟨b, hb, rfl⟩
    exact hN ⟨f b, map_primeToResidual_le_of_hom p f (mem_map_of_mem f hb), rfl⟩
  rw [hh, map_subgroupOf_eq_of_le hLJ]
end Subgroup


namespace MulAut
open Subgroup
variable {G : Type*} [Group G]
theorem stabilizer_card_coprime_of_centralizer_outer (p : ℕ) (i : G)
    (hC : Nat.Coprime p (Nat.card (centralizer ({i} : Set G))))
    (hO : Nat.Coprime p (Nat.card (Outer G))) :
    Nat.Coprime p (Nat.card (MulAction.stabilizer (MulAut G) i)) := by
  let A := MulAction.stabilizer (MulAut G) i
  let q : A →* Outer G := (QuotientGroup.mk' (innerSubgroup G)).comp A.subtype
  let f : centralizer ({i} : Set G) →* A :=
    { toFun := fun g => ⟨conj (g : G), by
        change (g : G) * i * (g : G)⁻¹ = i
        rw [mem_centralizer_singleton_iff.mp g.property, mul_inv_cancel_right]⟩
      map_one' := by apply Subtype.ext; exact map_one conj
      map_mul' := fun g h => by apply Subtype.ext; exact map_mul conj (g : G) (h : G) }
  have hf : ∀ g, q (f g) = 1 := fun g =>
    (QuotientGroup.eq_one_iff _).mpr ⟨(g : G), rfl⟩
  let f' : centralizer ({i} : Set G) →* q.ker := f.codRestrict _ hf
  have hsur : Function.Surjective f' := by
    intro a
    obtain ⟨g, hg⟩ := (QuotientGroup.eq_one_iff (a.val : MulAut G)).mp a.property
    have hi : g ∈ centralizer ({i} : Set G) := by
      have hh : (a.val : MulAut G) i = i := a.val.property
      rw [← hg] at hh
      change g * i * g⁻¹ = i at hh
      exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hh)
    refine ⟨⟨g, hi⟩, ?_⟩
    apply Subtype.ext
    exact Subtype.ext hg
  have hk : Nat.Coprime p (Nat.card q.ker) :=
    hC.coprime_dvd_right (card_dvd_of_surjective f' hsur)
  have hr : Nat.Coprime p q.ker.index := by
    rw [index_ker]
    exact hO.coprime_dvd_right q.range.card_subgroup_dvd_card
  rw [← q.ker.card_mul_index]
  exact hk.mul_right hr
end MulAut

namespace Subgroup
variable {G : Type*} [Group G]
theorem card_coprime_of_normalizing_fixed_element (p : ℕ) (K D : Subgroup G) (i : K)
    (hDN : D ≤ normalizer (K : Set G))
    (hDi : D ≤ centralizer ({(i : G)} : Set G))
    (hC : Nat.Coprime p (Nat.card (centralizer ({i} : Set K))))
    (hO : Nat.Coprime p (Nat.card (MulAut.Outer K)))
    (hker : Nat.Coprime p (Nat.card (D ⊓ centralizer (K : Set G) : Subgroup G))) :
    Nat.Coprime p (Nat.card D) := by
  let A := MulAction.stabilizer (MulAut K) i
  let f : D →* A :=
    { toFun := fun d => ⟨K.normalizerMonoidHom (inclusion hDN d), by
        apply Subtype.ext
        change (d : G) * (i : G) * (d : G)⁻¹ = (i : G)
        rw [mem_centralizer_singleton_iff.mp (hDi d.property), mul_inv_cancel_right]⟩
      map_one' := by apply Subtype.ext; exact map_one (K.normalizerMonoidHom.comp (inclusion hDN))
      map_mul' := fun d e => by
        apply Subtype.ext
        exact map_mul (K.normalizerMonoidHom.comp (inclusion hDN)) d e }
  have hk : f.ker.map D.subtype = D ⊓ centralizer (K : Set G) := by
    ext x
    constructor
    · rintro ⟨d, hd, rfl⟩
      refine ⟨d.property, ?_⟩
      have he : K.normalizerMonoidHom (inclusion hDN d) = 1 := congrArg Subtype.val hd
      have hm : inclusion hDN d ∈ K.normalizerMonoidHom.ker := he
      rwa [normalizerMonoidHom_ker] at hm
    · rintro ⟨hxD, hxC⟩
      refine ⟨⟨x, hxD⟩, ?_, rfl⟩
      apply Subtype.ext
      have hm : inclusion hDN (⟨x, hxD⟩ : D) ∈ K.normalizerMonoidHom.ker := by
        rw [normalizerMonoidHom_ker]
        exact hxC
      exact hm
  have hc : Nat.Coprime p (Nat.card f.ker) := by
    rw [← hk, card_map_of_injective D.subtype_injective] at hker
    exact hker
  have hi : Nat.Coprime p f.ker.index := by
    rw [index_ker]
    exact (MulAut.stabilizer_card_coprime_of_centralizer_outer p i hC hO).coprime_dvd_right f.range.card_subgroup_dvd_card
  rw [← f.ker.card_mul_index]
  exact hc.mul_right hi
end Subgroup

namespace Subgroup
variable {G : Type*} [Group G]
private theorem paired_centralizer_normalizer_primeToResidual (p : ℕ) (K L : Subgroup G) (i : K)
    (hcomm : K ≤ centralizer (L : Set G))
    (hsub : (L.subgroupOf (centralizer ({(i : G)} : Set G) ⊓
      normalizer (K : Set G))).IsSubnormal)
    (hL : primeToResidual p L = ⊤)
    (hC : Nat.Coprime p (Nat.card (centralizer ({i} : Set K))))
    (hOK : Nat.Coprime p (Nat.card (MulAut.Outer K)))
    (hOL : Nat.Coprime p (Nat.card (MulAut.Outer L)))
    (hpair : Nat.Coprime p (Nat.card (centralizer ((K ⊔ L : Subgroup G) : Set G)))) :
    (primeToResidual p (centralizer ({(i : G)} : Set G) ⊓ normalizer (K : Set G) :
      Subgroup G)).map (centralizer ({(i : G)} : Set G) ⊓ normalizer (K : Set G)).subtype = L := by
  let I := centralizer ({(i : G)} : Set G) ⊓ normalizer (K : Set G)
  let A := L.subgroupOf I
  let D := I ⊓ centralizer (L : Set G)
  have hLC : L ≤ centralizer (K : Set G) := le_centralizer_iff.mp hcomm
  have hLI : L ≤ I := le_inf
    (fun l hl => mem_centralizer_singleton_iff.mpr (hLC hl i i.property).symm)
    (hLC.trans (centralizer_le_normalizer _))
  have hDC : Nat.Coprime p (Nat.card D) := by
    apply card_coprime_of_normalizing_fixed_element p K D i (inf_le_left.trans inf_le_right)
      (inf_le_left.trans inf_le_left) hC hOK
    apply hpair.coprime_dvd_right
    apply card_dvd_of_le
    intro d hd
    have hh : K ⊔ L ≤ centralizer ({d} : Set G) := sup_le
      (fun k hk => mem_centralizer_singleton_iff.mpr (hd.2 k hk))
      (fun l hl => mem_centralizer_singleton_iff.mpr (hd.1.2 l hl))
    exact fun x hx => mem_centralizer_singleton_iff.mp (hh hx)
  have hAC : Nat.Coprime p (Nat.card (centralizer (A : Set I))) := by
    rw [← card_map_of_injective I.subtype_injective,
      map_centralizer_subtype, map_subgroupOf_eq_of_le hLI]
    exact hDC
  have hAO : Nat.Coprime p (Nat.card (MulAut.Outer A)) := by
    rwa [Nat.card_congr (MulAut.outerCongr (subgroupOfEquivOfLe hLI)).toEquiv]
  have hAL : primeToResidual p A = ⊤ := by
    have hh := map_primeToResidual (p := p) (subgroupOfEquivOfLe hLI).symm
    rw [hL, map_top_of_surjective _ (subgroupOfEquivOfLe hLI).symm.surjective] at hh
    exact hh.symm
  have hh := primeToResidual_eq_of_subnormal_centralizer_outer p A hsub hAL hAC hAO
  change (primeToResidual p I).map I.subtype = L
  rw [hh, map_subgroupOf_eq_of_le hLI]
end Subgroup

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]
theorem paired_involution_centralizer_primeToResidual (p : ℕ) (K L : Subgroup G) (i : K)
    (hcomm : K ≤ centralizer (L : Set G))
    (hsub : (L.subgroupOf (centralizer ({(i : G)} : Set G))).IsSubnormal)
    (hL : primeToResidual p L = ⊤)
    (hC : Nat.Coprime p (Nat.card (centralizer ({i} : Set K))))
    (hOK : Nat.Coprime p (Nat.card (MulAut.Outer K)))
    (hOL : Nat.Coprime p (Nat.card (MulAut.Outer L)))
    (hpair : Nat.Coprime p (Nat.card (centralizer ((K ⊔ L : Subgroup G) : Set G))))
    (hclass : ∀ a : MulAut K, IsConj (a i) i)
    (hcard : Nat.card (normalizer (K : Set G)) = Nat.card (normalizer (L : Set G))) :
    (primeToResidual p (centralizer ({(i : G)} : Set G))).map
      (centralizer ({(i : G)} : Set G)).subtype = L := by
  let J := centralizer ({(i : G)} : Set G)
  let I := J ⊓ normalizer (K : Set G)
  have hLC : L ≤ centralizer (K : Set G) := le_centralizer_iff.mp hcomm
  have hLJ : L ≤ J :=
    fun l hl => mem_centralizer_singleton_iff.mpr (hLC hl i i.property).symm
  have hres : (primeToResidual p I).map I.subtype = L :=
    paired_centralizer_normalizer_primeToResidual p K L i hcomm (hsub.comap (inclusion (inf_le_left : I ≤ J)))
      hL hC hOK hOL hpair
  have hIN : I ≤ normalizer (L : Set G) := by
    rw [← hres]
    exact I.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image I (primeToResidual p I))
  have hcover : normalizer (K : Set G) ≤ K ⊔ I := by
    intro x hx
    let xN : normalizer (K : Set G) := ⟨x, hx⟩
    obtain ⟨k, hk⟩ := isConj_iff.mp (hclass (K.normalizerMonoidHom xN))
    have hi : (k : G) * x ∈ J := by
      have hh := congrArg Subtype.val hk
      change (k : G) * (x * (i : G) * x⁻¹) * (k : G)⁻¹ = (i : G) at hh
      apply mem_centralizer_singleton_iff.mpr
      apply mul_inv_eq_iff_eq_mul.mp
      simpa only [mul_inv_rev, mul_assoc] using hh
    have hkn : (k : G) * x ∈ normalizer (K : Set G) :=
      (normalizer (K : Set G)).mul_mem (K.le_normalizer k.property) hx
    have hm : (k : G)⁻¹ * ((k : G) * x) ∈ K ⊔ I :=
      (K ⊔ I).mul_mem (mem_sup_left (K.inv_mem k.property)) (mem_sup_right ⟨hi, hkn⟩)
    simpa only [inv_mul_cancel_left] using hm
  have hn : normalizer (K : Set G) = normalizer (L : Set G) :=
    eq_of_le_of_card_ge (hcover.trans (sup_le (hcomm.trans (centralizer_le_normalizer _)) hIN))
      hcard.ge
  apply embedded_primeToResidual_eq_of_subnormal_normalizer p L J hLJ hsub hL
  rw [← hn]
  exact hres.le
end Subgroup
