module
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.GroupTheory.CComponent.ThreeCore
public import Theory.GroupTheory.PResidual.PrimeSection

/-!
# Cubic generation above a quasisimple two-core quotient

Let G be perfect, let G/O₂(G) be quasisimple, and suppose m₃(G) ≥ 2
while the center of that quotient has three-rank at most one. An elementary
abelian nine in G survives modulo O₂(G). Consequently the image of the
normal subgroup generated by elements of order three cannot lie in the
center of the quasisimple quotient, so it is the whole quotient. The
remaining quotient of G is a two-group, and perfectness makes it trivial.

In a subgroup that is an ambient prime-to-three residual, this generation
identity identifies the ambient cubic closure with that subgroup. The
source application is the ordinary residual case of A.3.18 in 13.6.20.
No classification or local theta equality is assumed here.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
A.3.18, printed pp.51–53, and 13.6.20, printed p.931.
-/

public section
open Subgroup Theory.GroupTheory
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- Rank two supplies a noncentral cubic generator modulo the two-core. -/
theorem cubic_closure_eq_top_of_twoCore_quasisimple [Group.IsPerfect G]
    [IsQuasisimple (G ⧸ pCore 2 G)]
    (hr : 2 ≤ primeRank 3 G)
    (hz : primeRank 3 (center (G ⧸ pCore 2 G)) ≤ 1) :
    closure {x : G | orderOf x = 3} = ⊤ := by
  let C : Subgroup G := closure {x : G | orderOf x = 3}
  have hnormal : (⊤ : Subgroup G) ≤ normalizer (C : Set G) := by
    apply le_normalizer_closure_iff.mpr
    intro g _ x hx
    exact subset_closure ((MulAut.conj g).orderOf_eq x |>.trans hx)
  let : C.Normal := normalizer_eq_top_iff.mp (top_unique hnormal)
  let q := QuotientGroup.mk' (pCore 2 G)
  let : (C.map q).Normal := (inferInstance : C.Normal).map q (QuotientGroup.mk'_surjective _)
  have himage : C.map q = ⊤ := by
    rcases IsQuasisimple.normal_le_center_or_eq_top (C.map q) with hc | ht
    · obtain ⟨E, hE, hcard⟩ := exists_elementary_nine_of_three_rank hr
      let := hE
      have hEC : E ≤ C := by
        intro x hx
        by_cases h1 : x = 1
        · exact h1 ▸ C.one_mem
        · apply subset_closure
          exact orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian (A := E) x hx) h1
      have hcop : Nat.Coprime 3 (Nat.card q.ker) := by
        rw [QuotientGroup.ker_mk']
        obtain ⟨n, hn⟩ := (pCore_isPGroup (p := 2) (G := G)).exists_card_eq
        rw [hn]
        exact (by decide : Nat.Coprime 3 2).pow_right n
      let f : E →* center (G ⧸ pCore 2 G) :=
        (q.comp E.subtype).codRestrict _ (fun x => hc ⟨x, hEC x.property, rfl⟩)
      have hf : Function.Injective f := by
        intro x y he
        exact injective_comp_subtype_of_coprime_ker q hcop E
          (IsElementaryAbelian.isPGroup 3 E) (congrArg Subtype.val he)
      have hElower : 2 ≤ primeRank 3 E := by
        let : IsElementaryAbelian 3 (⊤ : Subgroup E) :=
          { toIsMulCommutative := inferInstance
            exponent_dvd_p := by
              rw [Monoid.exponent_eq_of_mulEquiv (topEquiv : (⊤ : Subgroup E) ≃* E)]
              exact IsElementaryAbelian.exponent_dvd_p 3 E }
        have hh := IsElementaryAbelian.primeRank_ge_of_card (⊤ : Subgroup E)
          (show Nat.card (⊤ : Subgroup E) = 3 ^ 2 by simpa using hcard)
        exact hh
      have hh := hElower.trans (primeRank_le_of_injective 3 f hf)
      omega
    · exact ht
  have hsup : C ⊔ pCore 2 G = ⊤ := by
    have hh := congrArg (comap q) himage
    simpa only [comap_map_eq, q, QuotientGroup.ker_mk', comap_top] using hh
  let r := QuotientGroup.mk' C
  have hmap : (pCore 2 G).map r = ⊤ := by
    have hh := congrArg (map r) hsup
    simpa only [map_sup, r, QuotientGroup.map_mk'_self, bot_sup_eq,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] using hh
  have hp : IsPGroup 2 (⊤ : Subgroup (G ⧸ C)) := hmap ▸ pCore_isPGroup.map r
  let : Group.IsNilpotent (G ⧸ C) := (hp.of_equiv topEquiv).isNilpotent
  by_contra hne
  let : Nontrivial (G ⧸ C) := QuotientGroup.nontrivial_iff.mpr hne
  exact Group.IsPerfect.not_isSolvable (G ⧸ C) inferInstance

/-- The ordinary residual outcome gives the cubic theta equality after
intrinsic cubic generation; the residual is O^{3′}, not O³ or O_{3′}. -/
theorem cubic_closure_eq_of_primeToResidual (K D : Subgroup G)
    [Group.IsPerfect K] [IsQuasisimple (K ⧸ pCore 2 K)]
    (hKD : K ≤ D) (hr : 2 ≤ primeRank 3 K)
    (hz : primeRank 3 (center (K ⧸ pCore 2 K)) ≤ 1)
    (hres : K.subgroupOf D = primeToResidual 3 D) :
    closure {x : G | x ∈ D ∧ orderOf x = 3} = K := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro x ⟨hxD, hx⟩
    have hm : (⟨x, hxD⟩ : D) ∈ primeToResidual 3 D := by
      apply mem_primeToResidual_of_pow (n := 1)
      apply Subtype.ext
      simpa only [coe_pow, coe_one, pow_one, hx] using pow_orderOf_eq_one x
    rwa [← hres] at hm
  · have hg := cubic_closure_eq_top_of_twoCore_quasisimple hr hz
    have hm := congrArg (map K.subtype) hg
    rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at hm
    rw [← hm]
    apply closure_mono
    rintro x ⟨y, hy, rfl⟩
    exact ⟨hKD y.property, (K.orderOf_coe y).trans hy⟩
end Subgroup
