module

public import Theory.GroupTheory.PResidual.PrimeTo
public import Mathlib.GroupTheory.Sylow

/-!
# Generation of the prime-to-p residual by p-elements

For a finite group, the subgroup generated by elements of p-power order is
characteristic. It contains a Sylow p-subgroup and therefore has prime-to-p
index. These two facts identify it with the literal prime-to-p residual.

This criterion allows a concrete centralizer calculation to prove normality
and prime-to-p index together by controlling its p-elements. Its triality
application is in `OddFundamentalCentralizer/Centralizer/ElementaryIndex`.
Source: the residual convention in GLS3 §2.2 and the p-element argument used
in Aschbacher–Smith A.2.17, printed p.39.
-/

public section
noncomputable section
namespace Subgroup
variable {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]

/-- The literal prime-to-p residual is generated by all p-elements. -/
theorem primeToResidual_eq_closure_prime_power :
    primeToResidual p G = closure {x : G | ∃ n : ℕ, x ^ (p ^ n) = 1} := by
  let E := closure {x : G | ∃ n : ℕ, x ^ (p ^ n) = 1}
  have hc : E.Characteristic := by
    apply characteristic_iff_map_le.mpr
    intro e
    rw [MonoidHom.map_closure, closure_le]
    rintro _ ⟨x, ⟨n, hn⟩, rfl⟩
    exact subset_closure ⟨n, (map_pow e.toMonoidHom x (p ^ n)).symm.trans
      ((congrArg e.toMonoidHom hn).trans (map_one e.toMonoidHom))⟩
  let := hc
  let S : Sylow p G := Classical.choice inferInstance
  have hS : (S : Subgroup G) ≤ E := by
    intro x hx
    obtain ⟨n, hn⟩ := S.isPGroup' ⟨x, hx⟩
    exact subset_closure ⟨n, congrArg Subtype.val hn⟩
  have hi : Nat.Coprime p E.index :=
    ((Fact.out : p.Prime).coprime_iff_not_dvd.mpr S.not_dvd_index).coprime_dvd_right
      (index_dvd_of_le hS)
  exact primeToResidual_eq_of_generated E hi _ rfl (fun _ h => h)
end Subgroup
