module

public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.Commutator.SimpleSubnormal

/-!
# A prime residual generated by conjugates

If a p-perfect subgroup L and a p-subgroup S generate G, the S-conjugates
of L generate exactly Oᵖ(G). Their join is normal in G, with p-group
quotient; conversely p-perfection puts L and all its conjugates in Oᵖ(G).

This identifies the block closure L₀ = ⟨L^S⟩ with the two-residual in the
minimal-parabolic reduction of Aschbacher–Smith §2.4, printed p.528.
-/

namespace Subgroup

/-- A p-perfect generator and a p-subgroup determine the actual p-residual. -/
public theorem pResidual_eq_iSup_conjugates {G : Type*} [Group G] {p : ℕ}
    (L S : Subgroup G) (hL : IsPPerfect p L) (hS : IsPGroup p S)
    (hgen : L ⊔ S = ⊤) :
    pResidual p G = ⨆ s : S, L.map (MulAut.conj (s : G)).toMonoidHom := by
  let N := ⨆ s : S, L.map (MulAut.conj (s : G)).toMonoidHom
  have hNS : N ⊔ S = ⊤ := top_unique (by
    rw [← hgen]
    exact sup_le_sup (le_iSup_conjugates L S) le_rfl)
  have hn : N.Normal := normalizer_eq_top_iff.mp (top_unique (by
    rw [← hNS]
    exact sup_le N.le_normalizer (le_normalizer_iSup_conjugates L S)))
  let := hn
  apply le_antisymm
  · exact sInf_le ⟨hn, isPGroup_quotient_of_sup_eq_top N S hS hNS⟩
  · exact iSup_conjugates_le_of_le_normalizer L S (pResidual p G)
      (le_pResidual_of_isPPerfect L hL) (by rw [normalizer_eq_top]; exact le_top)

end Subgroup
