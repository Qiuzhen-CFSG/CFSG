module

public import Mathlib.GroupTheory.Index
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Residuals with prime-to-p quotient

The subgroup O^{p′}(G) is the intersection of normal subgroups whose index
is coprime to p. An element killed by a power of p lies in every such subgroup:
its image in the quotient has order dividing both that power and the index.
Consequently a normal subgroup generated by these elements is the residual
as soon as its index is coprime to p. Isomorphisms transport this construction.

This criterion includes groups generated by p-elements that are not perfect,
such as SL₂(3). It is intended for the centralizer calculations in
Aschbacher–Smith, *The Classification of Quasithin Groups*, A.3.21(a), p. 55.
-/

public section

namespace Subgroup

/-- The prime-to-p residual O^{p′}(G), not the prime-to-p core. -/
@[expose] def primeToResidual (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  sInf {N : Subgroup G | N.Normal ∧ Nat.Coprime p N.index}

variable {G H : Type*} [Group G] [Group H] {p : ℕ}

/-- Any normal subgroup of index coprime to p contains the residual. -/
theorem primeToResidual_le (N : Subgroup G) [N.Normal]
    (hN : Nat.Coprime p N.index) : primeToResidual p G ≤ N :=
  sInf_le ⟨inferInstance, hN⟩

/-- A homomorphism into a group of order coprime to p kills the residual. -/
theorem primeToResidual_le_ker (f : G →* H) (hH : Nat.Coprime p (Nat.card H)) :
    primeToResidual p G ≤ f.ker := by
  apply primeToResidual_le
  rw [index_ker]
  exact hH.coprime_dvd_right f.range.card_subgroup_dvd_card

/-- Elements of p-power order lie in the prime-to-p residual. -/
theorem mem_primeToResidual_of_pow {x : G} {n : ℕ} (hx : x ^ (p ^ n) = 1) :
    x ∈ primeToResidual p G := by
  change x ∈ sInf _
  rw [mem_sInf]
  rintro N ⟨hN, hc⟩
  let := hN
  apply (QuotientGroup.eq_one_iff x).mp
  apply orderOf_eq_one_iff.mp
  apply Nat.eq_one_of_dvd_coprimes (hc.pow_left n)
  · exact orderOf_dvd_of_pow_eq_one (by simpa using congrArg (QuotientGroup.mk' N) hx)
  · exact _root_.orderOf_dvd_natCard _

/-- Identify the residual using generators of p-power order. -/
theorem primeToResidual_eq_of_generated (N : Subgroup G) [N.Normal]
    (hN : Nat.Coprime p N.index) (S : Set G)
    (hgen : closure S = N) (hS : ∀ x ∈ S, ∃ n : ℕ, x ^ (p ^ n) = 1) :
    primeToResidual p G = N := by
  apply le_antisymm (primeToResidual_le N hN)
  rw [← hgen]
  rw [closure_le]
  intro x hx
  obtain ⟨n, hn⟩ := hS x hx
  exact mem_primeToResidual_of_pow hn

/-- A surjection maps the residual into the residual of the target. -/
theorem map_primeToResidual_le (f : G →* H) (hf : Function.Surjective f) :
    (primeToResidual p G).map f ≤ primeToResidual p H := by
  apply le_sInf
  rintro N ⟨hN, hc⟩
  let := hN
  rw [map_le_iff_le_comap]
  apply primeToResidual_le
  rwa [N.index_comap_of_surjective hf]

/-- The prime-to-p residual is preserved by group isomorphisms. -/
theorem map_primeToResidual (e : G ≃* H) :
    (primeToResidual p G).map e.toMonoidHom = primeToResidual p H := by
  apply le_antisymm (map_primeToResidual_le e.toMonoidHom e.surjective)
  have h := map_mono (f := e.toMonoidHom)
    (map_primeToResidual_le (p := p) e.symm.toMonoidHom e.symm.surjective)
  simpa [map_map] using h

/-- Restrict an isomorphism to the prime-to-p residuals. -/
noncomputable def primeToResidualEquiv (p : ℕ) (e : G ≃* H) :
    primeToResidual p G ≃* primeToResidual p H :=
  (e.subgroupMap _).trans (MulEquiv.subgroupCongr (map_primeToResidual e))

instance primeToResidual_characteristic : (primeToResidual p G).Characteristic := by
  apply characteristic_iff_map_le.mpr
  intro e
  exact (map_primeToResidual e).le

instance primeToResidual_normal : (primeToResidual p G).Normal := inferInstance

end Subgroup

end
