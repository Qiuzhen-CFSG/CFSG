module

public import Theory.GroupTheory.PResidual.PrimeTo
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.LocalNormalizerUniqueness
public import Mathlib.GroupTheory.IsSubnormal

/-!
# Subnormal subgroups and prime-to-p residuals

A subnormal subgroup which is its own prime-to-p residual and has index
prime to p is the ambient prime-to-p residual. Induction along a subnormal
chain proves normality rather than assuming it: the residual at each step
is characteristic, so it is normal in the next step.

We also give a criterion for a q-perfect group with normal q-subgroup and
simple quotient to be its own prime-to-p residual. The quotient must have
order divisible by p. These are elementary residual arguments used in
Aschbacher–Smith, proof of E.6.14, printed p.251.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

/-- A Sylow p-subgroup lies in the prime-to-p residual, whose index is
therefore prime to p. -/
theorem primeToResidual_index_coprime [Finite G] (p : ℕ) [Fact p.Prime] :
    Nat.Coprime p (primeToResidual p G).index := by
  let P : Sylow p G := Classical.choice inferInstance
  have hP : (P : Subgroup G) ≤ primeToResidual p G := by
    intro x hx
    obtain ⟨n, hn⟩ := P.isPGroup' ⟨x, hx⟩
    exact mem_primeToResidual_of_pow (congrArg Subtype.val hn)
  exact ((Fact.out : p.Prime).coprime_iff_not_dvd.mpr P.not_dvd_index).coprime_dvd_right
    (index_dvd_of_le hP)

/-- A subgroup which is its own prime-to-p residual lies in the ambient
residual; no normality of the subgroup is required. -/
theorem le_primeToResidual_of_eq_top (p : ℕ) (X : Subgroup G)
    (hX : primeToResidual p X = ⊤) : X ≤ primeToResidual p G := by
  apply le_sInf
  rintro N ⟨hN, hcop⟩
  let := hN
  have hk := primeToResidual_le_ker ((QuotientGroup.mk' N).comp X.subtype)
    (p := p) (by rwa [← N.index_eq_card])
  rw [hX] at hk
  intro x hx
  exact (QuotientGroup.eq_one_iff x).mp
    (hk (show (⟨x, hx⟩ : X) ∈ ⊤ from trivial))

/-- A q-perfect group over a simple quotient of order divisible by p is
generated by its p-elements when the kernel is a q-group. -/
theorem primeToResidual_eq_top_of_simple_quotient [Finite G]
    (p q : ℕ) [Fact p.Prime] (Q : Subgroup G) [Q.Normal]
    [IsSimpleGroup (G ⧸ Q)] (hQ : IsPGroup q Q) (hG : IsPPerfect q G)
    (hd : p ∣ Nat.card (G ⧸ Q)) : primeToResidual p G = ⊤ := by
  let N := primeToResidual p G
  let f := QuotientGroup.mk' Q
  have hn : (N.map f).Normal :=
    (inferInstance : N.Normal).map f (QuotientGroup.mk'_surjective Q)
  rcases hn.eq_bot_or_eq_top with hz | ht
  · have hNQ : N ≤ Q := by
      simpa only [f, QuotientGroup.ker_mk'] using (map_eq_bot_iff N).mp hz
    have hc := (primeToResidual_index_coprime (G := G) p).coprime_dvd_right
      (index_dvd_of_le hNQ)
    rw [index_eq_card] at hc
    exact ((Fact.out : p.Prime).coprime_iff_not_dvd.mp hc hd).elim
  · have hs : N ⊔ Q = ⊤ := by
      have he := congrArg (fun A : Subgroup (G ⧸ Q) => A.comap f) ht
      simpa only [comap_map_eq, f, QuotientGroup.ker_mk', comap_top] using he
    exact hG N inferInstance (isPGroup_quotient_of_sup_eq_top N Q hQ hs)

/-- Subnormality and prime-to-p index identify a subgroup with the
prime-to-p residual, provided it is intrinsically generated by p-elements.
In particular its normality is a consequence of these hypotheses. -/
theorem primeToResidual_eq_of_subnormal_coprime_index (p : ℕ) (X : Subgroup G)
    (hsub : X.IsSubnormal) (hX : primeToResidual p X = ⊤)
    (hcop : Nat.Coprime p X.index) : primeToResidual p G = X := by
  obtain ⟨n, F, hmono, hnorm, hzero, hn⟩ := hsub.exists_chain
  have hXF (i : ℕ) : X ≤ F i := hzero ▸ hmono (Nat.zero_le i)
  have hmain (i : ℕ) : (primeToResidual p (F i)).map (F i).subtype = X := by
    induction i with
    | zero =>
      rw [hzero, hX, ← MonoidHom.range_eq_map, range_subtype]
    | succ i ih =>
      have hNX : F (i + 1) ≤ normalizer (X : Set G) := by
        rw [← ih]
        exact ((normal_subgroupOf_iff_le_normalizer (hmono (Nat.le_succ i))).mp
          (hnorm i)).trans
          (normalizer_le_normalizer_characteristic_image (F i) (primeToResidual p (F i)))
      let Y := X.subgroupOf (F (i + 1))
      let : Y.Normal := normal_subgroupOf_of_le_normalizer hNX
      have hY : primeToResidual p Y = ⊤ := by
        let e := (subgroupOfEquivOfLe (hXF (i + 1))).symm
        have he := map_primeToResidual (p := p) e
        rw [hX, map_top_of_surjective _ e.surjective] at he
        exact he.symm
      have hc : Nat.Coprime p Y.index :=
        hcop.coprime_dvd_right (relIndex_dvd_index_of_le (hXF (i + 1)))
      have he : primeToResidual p (F (i + 1)) = Y :=
        le_antisymm (primeToResidual_le Y hc) (le_primeToResidual_of_eq_top p Y hY)
      rw [he, map_subgroupOf_eq_of_le (hXF _)]
  have he := hmain n
  rw [hn] at he
  change (primeToResidual p (⊤ : Subgroup G)).map topEquiv.toMonoidHom = X at he
  rwa [map_primeToResidual] at he

end Subgroup
