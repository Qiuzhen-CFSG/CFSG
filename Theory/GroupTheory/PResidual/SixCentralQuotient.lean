module
public import Theory.Alternating.TripleSevenLocalRank.CentralSix
public import Theory.GroupTheory.PResidual.PrimePowerGeneration
public import Theory.GroupTheory.PrimeOrderLift
public import Theory.GroupTheory.PerfectCentralCoverCyclicOddSylow

/-!
# Cubic generation in subgroups above the A₆ central quotient

The ordinary and triple-cover A₆ models have no elements of order nine.
Induction on the exponent reduces every three-element in either cover to
an element of order at most three. A two-group kernel preserves its order.
Consequently every subgroup above these covers has its literal
prime-to-three residual generated by elements of order three. This includes
point residuals with elementary abelian quotients of order nine.

Source: Aschbacher–Smith 12.2.8 and 13.4.10(2), printed pp.797,908;
the cover exponent is the actual GLS3 5.2.3 triple-cover calculation.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace Theory.GroupTheory.SixCComponentTheta
variable {G : Type*} [Group G] [Finite G]

private theorem cube_of_prime_power {A : Type*} [Group A]
    (h : ∀ x : A, x ^ 9 = 1 → x ^ 3 = 1) (x : A) (n : ℕ)
    (hx : x ^ (3 ^ n) = 1) : x ^ 3 = 1 := by
  induction n using Nat.twoStepInduction with
  | zero =>
    have he : x = 1 := by simpa only [pow_zero,pow_one] using hx
    rw [he,one_pow]
  | one => simpa using hx
  | more n ih ih' =>
    apply ih'
    have hh : (x ^ (3 ^ n)) ^ 9 = 1 := by
      simpa only [pow_add,show (3 : ℕ)^2 = 9 from rfl,pow_mul] using hx
    have hh' := h (x ^ (3 ^ n)) hh
    simpa only [←pow_mul,←pow_succ] using hh'

private theorem quotient_no_nine
    [IsQuasisimple (G ⧸ pCore 2 G)]
    (e : ((G ⧸ pCore 2 G) ⧸ center (G ⧸ pCore 2 G)) ≃* alternatingGroup (Fin 6)) :
    ∀ x : G ⧸ pCore 2 G, x ^ 9 = 1 → x ^ 3 = 1 := by
  let Q := G ⧸ pCore 2 G
  have hn : ¬ 2 ∣ Nat.card (center Q) :=
    PerfectCentralCovering.not_dvd_card_central_of_pCore_eq_bot
      (pCore_quotient_pCore_eq_bot 2) (center Q) le_rfl
  have ho : Odd (Nat.card (center Q)) :=
    Nat.not_even_iff_odd.mp (fun he => hn (even_iff_two_dvd.mp he))
  rcases GLS3.Chapter5.OddCentralCovers.odd_center_alternatives 6 (by decide) e ho with
      hc | ⟨_,hc⟩
  · let f := GLS3.Chapter5.OddCentralCovers.alternatingEquivOfCenterCardOne 6 e hc
    intro x hx
    apply f.injective
    rw [map_pow,map_one]
    exact GLS3.Chapter5.OddCentralCovers.six_cube_eq_one_of_ninth (f x)
      (by rw [←map_pow,hx,map_one])
  · exact GLS3.Chapter5.OddCentralCovers.triple_six_cube_eq_one_of_ninth e hc

/-- Three-elements above either genuine A₆ central cover have exponent three. -/
theorem cube_eq_one_of_three_power
    [IsQuasisimple (G ⧸ pCore 2 G)]
    (e : ((G ⧸ pCore 2 G) ⧸ center (G ⧸ pCore 2 G)) ≃* alternatingGroup (Fin 6))
    (x : G) (n : ℕ) (hx : x ^ (3 ^ n) = 1) : x ^ 3 = 1 := by
  let q := QuotientGroup.mk' (pCore 2 G)
  have hk : IsPGroup 2 q.ker := by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup
  have ho : Nat.Coprime (orderOf x) 2 :=
    ((by decide : Nat.Coprime 3 2).pow_left n).of_dvd_left
      (orderOf_dvd_of_pow_eq_one hx)
  have he := q.orderOf_map_eq_of_coprime_of_isPGroup_ker hk x ho.symm
  apply orderOf_dvd_iff_pow_eq_one.mp
  rw [←he]
  apply orderOf_dvd_of_pow_eq_one
  exact cube_of_prime_power (quotient_no_nine e) (q x) n
    (by rw [←map_pow,hx,map_one])

/-- Every subgroup of an A₆ central-cover extension has cubic-generated
prime-to-three residual, including the rank-two covered point residuals. -/
theorem primeToResidual_eq_cubic_closure_of_injective
    {A : Type*} [Group A] [Finite A]
    [IsQuasisimple (G ⧸ pCore 2 G)]
    (e : ((G ⧸ pCore 2 G) ⧸ center (G ⧸ pCore 2 G)) ≃* alternatingGroup (Fin 6))
    (f : A →* G) (hf : Function.Injective f) :
    primeToResidual 3 A = closure {x : A | orderOf x = 3} := by
  rw [primeToResidual_eq_closure_prime_power]
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro x ⟨n,hx⟩
    by_cases he : x = 1
    · exact he ▸ one_mem _
    · apply Subgroup.subset_closure
      apply orderOf_eq_prime _ he
      apply hf
      rw [map_pow,map_one]
      exact cube_eq_one_of_three_power e (f x) n (by rw [←map_pow,hx,map_one])
  · apply Subgroup.closure_mono
    intro x hx
    change orderOf x = 3 at hx
    exact ⟨1,by simpa only [pow_one,hx] using pow_orderOf_eq_one x⟩
end Theory.GroupTheory.SixCComponentTheta
