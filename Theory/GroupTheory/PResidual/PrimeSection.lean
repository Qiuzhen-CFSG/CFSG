module

public import Theory.GroupTheory.PPerfectHom
public import Theory.GroupTheory.PrimeOrderLift
public import Theory.GroupTheory.PCoreLocalSetup
public import Theory.GroupTheory.LocalNormalizerUniqueness
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# Prime sections normalized by a Sylow subgroup

Let L be a p-perfect subgroup normalized by a Sylow p-subgroup S, with
L/O_p(L) of prime order q coprime to p. The local core O_p(L) lies in S:
its join with S is a p-group, so Sylow maximality applies. Cauchy's theorem
supplies an element x of order q, whose image generates L/O_p(L). Thus
L = ⟨x⟩O_p(L), and LS = ⟨x⟩S is a subgroup.

If L is outside a normal subgroup K, then x is outside K as well. Otherwise
L lies in K O_p(L), and p-perfectness kills its p-group image modulo K.
This argument uses only local normality of O_p(L), not normality in G.

Source application: Aschbacher–Smith, *The Classification of Quasithin
Groups*, combined manuscript of 1 March 2004, proof of 13.8.20, printed
p.955 (PDF p.972), using the marked sections in 13.2.1–2, printed p.877.
-/

public section
open scoped Pointwise
namespace Subgroup
variable {G : Type*} [Group G]

/-- A p-perfect subgroup cannot acquire containment in a normal subgroup
merely by adjoining a p-group. The p-group need not be ambient normal. -/
theorem le_normal_of_isPPerfect_of_le_sup_pGroup {p : ℕ} [Fact p.Prime]
    (L K R : Subgroup G) [K.Normal]
    (hL : IsPPerfect p L) (hR : IsPGroup p R) (h : L ≤ K ⊔ R) : L ≤ K := by
  let q := QuotientGroup.mk' K
  have hi : L.map q ≤ R.map q := by
    have hm := map_mono (f := q) h
    simpa only [Subgroup.map_sup, q, QuotientGroup.map_mk'_self, bot_sup_eq] using hm
  let f : L →* R.map q := (q.comp L.subtype).codRestrict (R.map q)
    (fun x => hi (mem_map.mpr ⟨x, x.property, rfl⟩))
  have hf := hL.hom_eq_one_of_isPGroup (hR.map q) f
  intro x hx
  apply (QuotientGroup.eq_one_iff x).mp
  exact congrArg (fun g : L →* R.map q => (g ⟨x, hx⟩ : G ⧸ K)) hf

variable [Finite G]

/-- A prime quotient by the p-core has a complement generated by an element
of that prime order, provided the prime is coprime to p. -/
theorem exists_prime_order_sup_pCore_eq_top {p q : ℕ} [Fact q.Prime]
    (hcop : p.Coprime q) (hc : Nat.card (G ⧸ pCore p G) = q) :
    ∃ x : G, orderOf x = q ∧ zpowers x ⊔ pCore p G = ⊤ := by
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' q
    (hc ▸ card_quotient_dvd_card (pCore p G))
  let f := QuotientGroup.mk' (pCore p G)
  have hk : IsPGroup p f.ker := by
    dsimp [f]
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have ho : orderOf (f x) = q :=
    (f.orderOf_map_eq_of_coprime_of_isPGroup_ker hk x (hx ▸ hcop)).trans hx
  have hn : f x ≠ 1 := by
    intro he
    rw [he, orderOf_one] at ho
    exact (Nat.Prime.ne_one (Fact.out : q.Prime)) ho.symm
  have ht : (zpowers x).map f = ⊤ := by
    rw [MonoidHom.map_zpowers]
    exact zpowers_eq_top_of_prime_card hc hn
  have ht' := congrArg (fun A : Subgroup (G ⧸ pCore p G) => A.comap f) ht
  exact ⟨x, hx, by simpa only [comap_map_eq, f, QuotientGroup.ker_mk', comap_top] using ht'⟩

/-- A p-perfect prime section normalized by a Sylow p-subgroup supplies
an outside prime-order element whose cyclic subgroup permutes with that Sylow.
The equality is with the generated subgroup, not merely a set product. -/
theorem exists_outside_prime_order_permuting_sylow {p q : ℕ}
    [Fact p.Prime] [Fact q.Prime] (hcop : p.Coprime q)
    (K L : Subgroup G) [K.Normal] (S : Sylow p G)
    (hL : IsPPerfect p L) (hc : Nat.card (L ⧸ pCore p L) = q)
    (hn : (S : Subgroup G) ≤ normalizer (L : Set G)) (hout : ¬ L ≤ K) :
    ∃ x : G, x ∈ L ∧ orderOf x = q ∧ x ∉ K ∧
      (↑(zpowers x ⊔ (S : Subgroup G)) : Set G) =
        (zpowers x : Set G) * (S : Set G) := by
  let Q := L.pCoreIn p
  have hSQ : (S : Subgroup G) ≤ normalizer (Q : Set G) :=
    hn.trans (normalizer_le_normalizer_characteristic_image L (pCore p L))
  have hQS : Q ≤ (S : Subgroup G) :=
    sup_eq_right.mp (S.is_maximal'
      ((isPGroup_pCoreIn p L).to_sup_of_normal_left' S.isPGroup' hSQ) le_sup_right)
  obtain ⟨y, hy, hgen⟩ := exists_prime_order_sup_pCore_eq_top (G := L) hcop hc
  let x : G := y
  have hxL : x ∈ L := y.property
  have hx : orderOf x = q := (L.orderOf_coe y).trans hy
  have hg : zpowers x ⊔ Q = L := by
    have hm := congrArg (fun A : Subgroup L => A.map L.subtype) hgen
    simpa only [x, Q, pCoreIn, Subgroup.map_sup, MonoidHom.map_zpowers, Subgroup.subtype_apply,
      ← MonoidHom.range_eq_map, range_subtype] using hm
  have hxK : x ∉ K := by
    intro h
    apply hout
    apply le_normal_of_isPPerfect_of_le_sup_pGroup L K Q hL (isPGroup_pCoreIn p L)
    rw [← hg]
    exact sup_le_sup (zpowers_le.mpr h) le_rfl
  have hxn : zpowers x ≤ normalizer (Q : Set G) :=
    (zpowers_le.mpr hxL).trans
      (L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (pCore p L)))
  have hQSset : (Q : Set G) * (S : Set G) = (S : Set G) := by
    apply Set.Subset.antisymm
    · rintro _ ⟨a, ha, b, hb, rfl⟩
      exact S.mul_mem (hQS ha) hb
    · intro a ha
      exact ⟨1, Q.one_mem, a, ha, one_mul a⟩
  refine ⟨x, hxL, hx, hxK, ?_⟩
  calc
    (↑(zpowers x ⊔ (S : Subgroup G)) : Set G) = ↑(L ⊔ (S : Subgroup G)) := by
      rw [← hg, sup_assoc, sup_of_le_right hQS]
    _ = (L : Set G) * (S : Set G) := coe_mul_of_right_le_normalizer_left L S hn
    _ = ((zpowers x : Set G) * (Q : Set G)) * (S : Set G) := by
      rw [← coe_mul_of_left_le_normalizer_right (zpowers x) Q hxn, hg]
    _ = (zpowers x : Set G) * (S : Set G) := by rw [mul_assoc, hQSset]
end Subgroup

end
