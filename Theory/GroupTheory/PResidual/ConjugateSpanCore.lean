module

public import Theory.GroupTheory.PResidual.CentralCore
public import Theory.GroupTheory.PResidual.NormalSylowCommutator
public import Theory.GroupTheory.ConjugateSpanOrder

/-!
# A core intersection generated by a marked conjugate span

For K=O²(G) and Q=O₂(G), assume K=[K,V], [Q,V]≤Q∩V≤K, and
K's image modulo Q has odd order. Then L=⟨(Q∩V)ᴳ⟩ is Q∩K and
[L,K]=L. The seed centralizes Q/L; residual generation propagates this
to K. The normal Sylow subgroup of a two-perfect group is generated by
its commutators, giving both the reverse inclusion and full movement.

Source application: Aschbacher--Smith, E.2.17, printed p.229.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

theorem core_intersection_residual_commutator_eq_self
    (hodd : Nat.Coprime 2 (Nat.card (pResidual 2 (G ⧸ pCore 2 G)))) :
    ⁅pCore 2 G ⊓ pResidual 2 G,pResidual 2 G⁆ = pCore 2 G ⊓ pResidual 2 G := by
  let K := pResidual 2 G
  let P := (pCore 2 G).subgroupOf K
  let q := QuotientGroup.mk' (pCore 2 G)
  let f := q.comp K.subtype
  have hk : f.ker = P := by
    rw [← MonoidHom.comap_ker,QuotientGroup.ker_mk']
    rfl
  have hr : f.range = pResidual 2 (G ⧸ pCore 2 G) := by
    rw [MonoidHom.range_comp,range_subtype]
    exact map_pResidual_of_surjective 2 q (QuotientGroup.mk'_surjective _)
  have hi : Nat.Coprime 2 P.index := by
    rw [←hk,index_ker,hr]
    exact hodd
  have hP : IsPGroup 2 P := pCore_isPGroup.comap_subtype
  let S := hP.toSylow (Nat.prime_two.coprime_iff_not_dvd.mp hi)
  have hS : (S : Subgroup K) = P := hP.toSylow_coe _
  let : (S : Subgroup K).Normal := by rw [hS]; infer_instance
  have he : P = ⁅P,⊤⁆ := by
    simpa only [hS] using normalSylow_eq_commutator_of_isPPerfect (isPPerfect_pResidual 2) S
  have hm := congrArg (map K.subtype) he
  rw [map_commutator,subgroupOf_map_subtype,←MonoidHom.range_eq_map,range_subtype] at hm
  exact hm.symm

theorem conjugateSpan_core_eq_core_inf_residual
    (V : Subgroup G) (hQV : ⁅pCore 2 G,V⁆ ≤ pCore 2 G ⊓ V)
    (hBK : pCore 2 G ⊓ V ≤ pResidual 2 G)
    (hKV : pResidual 2 G = ⁅pResidual 2 G,V⁆)
    (hodd : Nat.Coprime 2 (Nat.card (pResidual 2 (G ⧸ pCore 2 G)))) :
    conjugateSpanBy (pCore 2 G ⊓ V) ⊤ = pCore 2 G ⊓ pResidual 2 G ∧
      ⁅conjugateSpanBy (pCore 2 G ⊓ V) ⊤,pResidual 2 G⁆ =
        conjugateSpanBy (pCore 2 G ⊓ V) ⊤ := by
  let L := conjugateSpanBy (pCore 2 G ⊓ V) ⊤
  let : L.Normal := normalizer_eq_top_iff.mp (top_unique (le_normalizer_conjugateSpanBy _ _))
  have hLQ : L ≤ pCore 2 G := conjugateSpanBy_le inf_le_left le_normalizer_of_normal
  have hLK : L ≤ pResidual 2 G := conjugateSpanBy_le hBK le_normalizer_of_normal
  have hcover : pResidual 2 G ≤ normalClosure (V : Set G) :=
    hKV.le.trans ((commutator_mono le_rfl (show V ≤ normalClosure (V : Set G) from
      fun _ hx => le_normalClosure hx)).trans (commutator_le_right _ _))
  have hKL : ⁅pResidual 2 G,pCore 2 G⁆ ≤ L :=
    commutator_pResidual_core_le_of_normalClosure_cover L V
      (hQV.trans (le_conjugateSpanBy _ _)) (map_mono hcover)
  have he : L = pCore 2 G ⊓ pResidual 2 G := by
    apply le_antisymm (le_inf hLQ hLK)
    rw [core_inf_residual_eq_commutator_of_quotient_coprime hodd,commutator_comm]
    exact hKL
  exact ⟨he,by change ⁅L,pResidual 2 G⁆ = L; rw [he]; exact core_intersection_residual_commutator_eq_self hodd⟩
end Subgroup
