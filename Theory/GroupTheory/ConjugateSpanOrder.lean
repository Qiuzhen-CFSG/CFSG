module

public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Algebra.Group.Pointwise.Set.Basic
public import Mathlib.Tactic.Group

/-!
# Ordering subgroups by their action on a conjugate span

Fix a subgroup `Z` and write `V(H) = ⟨Zᴴ⟩`. The relation
`H = (H ∩ K) C_H(V(H))` increases `V(H)`. On the subgroups satisfying
`H = N_G(V(H))` it is a partial order. The proof uses actual product
factorizations: the centralizing factor fixes every generator, and in a
composite factorization its centralizer is absorbed into the first one.

This is the group-theoretic content of Aschbacher–Smith, *The Classification
of Quasithin Groups*, combined manuscript (1 March 2004), A.5.2–5 and A.5.9,
printed pp. 61–63. Neither finiteness nor local characteristic assumptions
are needed for these statements.
-/

@[expose] public section

namespace Subgroup

variable {G : Type*} [Group G]

/-- The subgroup generated by the `H`-conjugates of `Z`. -/
def conjugateSpanBy (Z H : Subgroup G) : Subgroup G :=
  closure {x | ∃ h ∈ H, ∃ z ∈ Z, h * z * h⁻¹ = x}

theorem le_conjugateSpanBy (Z H : Subgroup G) : Z ≤ conjugateSpanBy Z H := by
  intro z hz
  exact subset_closure ⟨1, H.one_mem, z, hz, by simp⟩

theorem conjugateSpanBy_mono {Z W H K : Subgroup G} (hZW : Z ≤ W) (hHK : H ≤ K) :
    conjugateSpanBy Z H ≤ conjugateSpanBy W K := by
  apply closure_mono
  rintro x ⟨h, hh, z, hz, rfl⟩
  exact ⟨h, hHK hh, z, hZW hz, rfl⟩

theorem conjugateSpanBy_le {Z H K : Subgroup G} (hZK : Z ≤ K)
    (hHK : H ≤ normalizer (K : Set G)) : conjugateSpanBy Z H ≤ K := by
  apply (closure_le _).mpr
  rintro x ⟨h, hh, z, hz, rfl⟩
  exact le_normalizer_iff.mp hHK h hh z (hZK hz)

theorem conjugateSpanBy_le_self {Z H : Subgroup G} (hZH : Z ≤ H) :
    conjugateSpanBy Z H ≤ H :=
  conjugateSpanBy_le hZH H.le_normalizer

theorem le_normalizer_conjugateSpanBy (Z H : Subgroup G) :
    H ≤ normalizer (conjugateSpanBy Z H : Set G) := by
  apply le_normalizer_closure_iff.mpr
  rintro h hh x ⟨k, hk, z, hz, rfl⟩
  apply subset_closure
  exact ⟨h * k, H.mul_mem hh hk, z, hz, by simp [mul_assoc]⟩

/-- Source A.5.2, expressed by elementwise product factorization. -/
def ConjugateSpanLE (Z H K : Subgroup G) : Prop :=
  ∀ x ∈ H, ∃ a ∈ H ⊓ K, ∃ c ∈ H ⊓ centralizer (conjugateSpanBy Z H : Set G),
    a * c = x

open scoped Pointwise in
theorem conjugateSpanLE_iff_product (Z H K : Subgroup G) :
    ConjugateSpanLE Z H K ↔
      (H : Set G) = (H ⊓ K : Subgroup G) *
        (H ⊓ centralizer (conjugateSpanBy Z H : Set G) : Subgroup G) := by
  constructor
  · intro h
    apply Set.Subset.antisymm h
    rintro x ⟨a, ha, c, hc, rfl⟩
    exact H.mul_mem ha.1 hc.1
  · intro h x hx
    change x ∈ ((H ⊓ K : Subgroup G) : Set G) *
      ((H ⊓ centralizer (conjugateSpanBy Z H : Set G) : Subgroup G) : Set G)
    exact h ▸ hx

theorem conjugateSpanLE_of_le (Z : Subgroup G) {H K : Subgroup G} (hHK : H ≤ K) :
    ConjugateSpanLE Z H K := by
  intro x hx
  exact ⟨x, ⟨hx, hHK hx⟩, 1, one_mem _, mul_one x⟩

theorem conjugateSpanLE_refl (Z H : Subgroup G) : ConjugateSpanLE Z H H :=
  conjugateSpanLE_of_le Z le_rfl

/-- A.5.3(1): a centralizing supplement does not enlarge the conjugate span. -/
theorem ConjugateSpanLE.span_le {Z H K : Subgroup G} (h : ConjugateSpanLE Z H K) :
    conjugateSpanBy Z H ≤ conjugateSpanBy Z K := by
  apply (closure_le _).mpr
  rintro x ⟨g, hg, z, hz, rfl⟩
  obtain ⟨a, ha, c, hc, rfl⟩ := h g hg
  have hcZ := mem_centralizer_iff.mp hc.2 z (le_conjugateSpanBy Z H hz)
  have heq : (a * c) * z * (a * c)⁻¹ = a * z * a⁻¹ := by
    calc
      _ = a * (c * z) * c⁻¹ * a⁻¹ := by group
      _ = a * (z * c) * c⁻¹ * a⁻¹ := by rw [hcZ]
      _ = _ := by group
  rw [heq]
  exact subset_closure ⟨a, ha.2, z, hz, rfl⟩

/-- A.5.3(2), with both centralizers taken inside the second group. -/
theorem ConjugateSpanLE.centralizer_le {Z H K : Subgroup G}
    (h : ConjugateSpanLE Z H K) :
    K ⊓ centralizer (conjugateSpanBy Z K : Set G) ≤
      K ⊓ centralizer (conjugateSpanBy Z H : Set G) :=
  inf_le_inf_left K (Subgroup.centralizer_le h.span_le)

/-- A.5.3(3): the normalizer identity puts the smaller centralizer inside `H`. -/
theorem ConjugateSpanLE.centralizer_le_of_normalizer {Z H K : Subgroup G}
    (h : ConjugateSpanLE Z H K)
    (hH : H = normalizer (conjugateSpanBy Z H : Set G)) :
    K ⊓ centralizer (conjugateSpanBy Z K : Set G) ≤
      H ⊓ centralizer (conjugateSpanBy Z H : Set G) := by
  intro c hc
  have hc' := (h.centralizer_le hc).2
  exact ⟨hH.symm ▸ centralizer_le_normalizer _ hc', hc'⟩

/-- A.5.9(2), without requiring either group to be a full normalizer. -/
theorem conjugateSpanBy_eq_of_mutual {Z H K : Subgroup G}
    (hHK : ConjugateSpanLE Z H K) (hKH : ConjugateSpanLE Z K H) :
    conjugateSpanBy Z H = conjugateSpanBy Z K :=
  le_antisymm hHK.span_le hKH.span_le

theorem conjugateSpanLE_antisymm {Z H K : Subgroup G}
    (hH : H = normalizer (conjugateSpanBy Z H : Set G))
    (hK : K = normalizer (conjugateSpanBy Z K : Set G))
    (hHK : ConjugateSpanLE Z H K) (hKH : ConjugateSpanLE Z K H) : H = K := by
  rw [hH, conjugateSpanBy_eq_of_mutual hHK hKH, ← hK]

theorem conjugateSpanLE_trans {Z H K L : Subgroup G}
    (hH : H = normalizer (conjugateSpanBy Z H : Set G))
    (hHK : ConjugateSpanLE Z H K) (hKL : ConjugateSpanLE Z K L) :
    ConjugateSpanLE Z H L := by
  intro x hx
  obtain ⟨a, ha, c, hc, rfl⟩ := hHK x hx
  obtain ⟨b, hb, d, hd, hbd⟩ := hKL a ha.2
  have hd' := hHK.centralizer_le_of_normalizer hH hd
  have hbH : b ∈ H := by
    have heq : b = a * d⁻¹ := by rw [← hbd]; group
    rw [heq]
    exact H.mul_mem ha.1 (H.inv_mem hd'.1)
  refine ⟨b, ⟨hbH, hb.2⟩, d * c, mul_mem hd' hc, ?_⟩
  rw [← mul_assoc, hbd]

/-- Normalizers of their own conjugate spans, ordered as in A.5.5.
The structure is explicit so it does not change the ordinary inclusion order. -/
@[instance_reducible] def conjugateSpanPartialOrder (Z : Subgroup G) :
    PartialOrder {H : Subgroup G // H = normalizer (conjugateSpanBy Z H : Set G)} where
  le H K := ConjugateSpanLE Z H.1 K.1
  lt H K := ConjugateSpanLE Z H.1 K.1 ∧ ¬ ConjugateSpanLE Z K.1 H.1
  le_refl H := conjugateSpanLE_refl Z H.1
  le_trans H K L := conjugateSpanLE_trans H.2
  le_antisymm H K hHK hKH := Subtype.ext (conjugateSpanLE_antisymm H.2 K.2 hHK hKH)

/-- The normalizer argument in A.5.6, separated from the local-group input
which supplies `M = N_G(V)`. -/
theorem le_of_conjugateSpanLE_of_generated_intersection {Z H M V : Subgroup G}
    (h : ConjugateSpanLE Z H M)
    (hV : V = conjugateSpanBy (V ⊓ Z) (H ⊓ M))
    (hM : M = normalizer (V : Set G)) : H ≤ M := by
  have hVspan : V ≤ conjugateSpanBy Z H := by
    rw [hV]
    exact conjugateSpanBy_mono inf_le_right inf_le_left
  intro x hx
  obtain ⟨a, ha, c, hc, rfl⟩ := h x hx
  apply M.mul_mem ha.2
  rw [hM]
  exact centralizer_le_normalizer _ (Subgroup.centralizer_le hVspan hc.2)

end Subgroup

end
