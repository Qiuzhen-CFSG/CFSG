module

public import Theory.GroupTheory.PerfectCentralCoverAbelianSylow
public import Mathlib.GroupTheory.PGroup

/-!
# Generation of a normal p-subgroup under a perfect group

Let P be a normal p-subgroup of a finite perfect group, U≤P normal, and
let a Sylow p-subgroup be generated by P and a subgroup S with S'≤U.
Modulo D=[P,G]U, the image of P is central and the image of the Sylow
subgroup is abelian. The perfect central-cover theorem excludes p-torsion
in the central kernel, so P=D. This does not assume that P/U is a module.

Source application: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 14.7.73(3), printed pp.1076–1077. This supplies the generation
required before recognizing the six-dimensional natural cover.
-/

public section

open Subgroup
open scoped IsMulCommutative
namespace Subgroup

/-- A normal p-subgroup is generated modulo U by its perfect-group commutators. -/
theorem normal_pGroup_commutator_generation
    {G : Type*} [Group G] [Finite G] [Group.IsPerfect G]
    {p : ℕ} [Fact p.Prime]
    (P U S : Subgroup G) [P.Normal] [U.Normal]
    (hUP : U ≤ P) (hP : IsPGroup p P)
    (R : Sylow p G) (hR : (R : Subgroup G) = S ⊔ P)
    (hS : ⁅S, S⁆ ≤ U) : ⁅P, (⊤ : Subgroup G)⁆ ⊔ U = P := by
  let D := ⁅P, (⊤ : Subgroup G)⁆ ⊔ U
  have hDP : D ≤ P := sup_le (commutator_le_left P ⊤) hUP
  let q := QuotientGroup.mk' D
  let PB := P.map q
  have hPBcentral : PB ≤ center (G ⧸ D) := by
    apply commutator_top_right_eq_bot_iff_le_center.mp
    have htop : (⊤ : Subgroup G).map q = ⊤ :=
      (MonoidHom.range_eq_map q).symm.trans (MonoidHom.range_eq_top.mpr
        (QuotientGroup.mk'_surjective D))
    rw [← htop, ← map_commutator, map_eq_bot_iff]
    simpa only [q, QuotientGroup.ker_mk'] using
      (le_sup_left : ⁅P, (⊤ : Subgroup G)⁆ ≤ D)
  have hSabel : IsMulCommutative (S.map q) := by
    apply commutator_self_eq_bot_iff.mp
    rw [← map_commutator, map_eq_bot_iff]
    simpa only [q, QuotientGroup.ker_mk'] using hS.trans
      (le_sup_right : U ≤ D)
  let : IsMulCommutative (S.map q) := hSabel
  have hPBcomm : IsMulCommutative PB := by
    apply le_centralizer_iff_isMulCommutative.mp
    exact hPBcentral.trans (center_le_centralizer (PB : Set (G ⧸ D)))
  let : IsMulCommutative PB := hPBcomm
  have hPB_S : PB ≤ centralizer (S.map q : Set (G ⧸ D)) :=
    hPBcentral.trans (center_le_centralizer _)
  have hjoin : IsMulCommutative (S.map q ⊔ PB : Subgroup (G ⧸ D)) := by
    apply le_centralizer_iff_isMulCommutative.mp
    exact sup_le
      (le_centralizer_iff.mpr (sup_le (S.map q).le_centralizer hPB_S))
      (le_centralizer_iff.mpr (sup_le (le_centralizer_iff.mp hPB_S) PB.le_centralizer))
  let RB := R.mapSurjective (QuotientGroup.mk'_surjective D)
  have hRB : (RB : Subgroup (G ⧸ D)) = S.map q ⊔ PB := by
    rw [Sylow.coe_mapSurjective, hR, map_sup]
  have hRcomm : IsMulCommutative RB := by
    rw [hRB]
    exact hjoin
  let f := QuotientGroup.mk' PB
  have hnot := PerfectCentralCovering.not_dvd_card_kernel_of_abelian_sylow
    f (by simpa only [f, QuotientGroup.ker_mk'] using hPBcentral) RB hRcomm
  have hPBp : IsPGroup p PB := hP.map q
  have hcard : Nat.card PB = 1 := by
    obtain ⟨n, hn⟩ := hPBp.exists_card_eq
    have hzero : n = 0 := by
      by_contra hne
      apply hnot
      rw [QuotientGroup.ker_mk', hn]
      exact dvd_pow_self p hne
    simpa only [hzero, pow_zero] using hn
  have hbot : PB = ⊥ := (Subgroup.card_eq_one).mp hcard
  have hPD : P ≤ D := by
    have hh := (map_eq_bot_iff (f := q) P).mp hbot
    simpa only [q, QuotientGroup.ker_mk'] using hh
  exact le_antisymm hDP hPD

end Subgroup
