module
public import Theory.GroupTheory.WreathTwoSylowModel
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Theory.GroupTheory.SpecificGroups.SLTwoPermThree

/-!
# Centralizers of noncentral Sylow involutions in the SL₂(2) wreath product

Let `P` be an actual Sylow two-subgroup of `SL₂(2) ≀ᵣ C₂`, and let `z` be an
involution in `P` outside the ambient image of its center. Then `C_W(z)` has
order twelve and admits a surjective homomorphism to `Perm (Fin 3)` whose
kernel is the actual cyclic subgroup generated by `z`, restricted to its
centralizer.

In the standard dihedral Sylow model, the four noncentral involutions are
single-coordinate transvections and the two swapping involutions. For a
single-coordinate involution, projection to the other base coordinate gives
the centralizer map to `SL₂(2)`. For a swapping involution, a twisted first
coordinate gives the same map. Kernel-checked finite calculations verify
multiplicativity, surjectivity, centralizer order, and kernel `{1,z}` for
these four cases. The cyclic-subgroup API identifies this kernel with the
specified restricted subgroup.

Sylow conjugacy supplies an actual ambient conjugator from the standard model
to `P`. Transporting centralizers along its automorphism preserves their order
and carries the cyclic kernel to the subgroup generated by the supplied `z`.
Finally, the projective-line equivalence `SL₂(2) ≃ S₃` gives the requested
permutation quotient.

This is the noncentral-involution wreath calculation used in Stellmacher
(9.1), Journal of Algebra 190 (1997), journal pp.47–48. The Sylow
noncentrality hypothesis is essential: the central Sylow involution has a
different ambient centralizer.
-/

private abbrev SL2 := Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)
private abbrev C2 := Multiplicative (ZMod 2)
private abbrev W := RegularWreathProduct SL2 C2
private instance : DecidableEq W := fun x y => decidable_of_iff
  (x.left=y.left ∧ x.right=y.right) RegularWreathProduct.ext_iff.symm
private instance : Fintype W := Fintype.ofEquiv ((C2 → SL2) × C2)
  (RegularWreathProduct.equivProd SL2 C2).symm

private def centralizerProjection (d : DihedralGroup 4) (x : W) : SL2 :=
  let z := wreathTwoDihedralHom d
  if z.right = 1 then
    x.left (if z.left 1 = 1 then 1 else Multiplicative.ofAdd 1)
  else x.left 1 * (if x.right = 1 then 1 else z.left 1)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
set_option synthInstance.maxSize 100000 in
private theorem projection_spec : ∀ d : DihedralGroup 4,
    d^2=1 → d ∉ Subgroup.center (DihedralGroup 4) →
    (Fintype.card {x : W // x*wreathTwoDihedralHom d=wreathTwoDihedralHom d*x}=12) ∧
    (∀ x y : W, x*wreathTwoDihedralHom d=wreathTwoDihedralHom d*x →
      y*wreathTwoDihedralHom d=wreathTwoDihedralHom d*y →
      centralizerProjection d (x*y)=centralizerProjection d x*centralizerProjection d y) ∧
    (∀ a : SL2, ∃ x : W, x*wreathTwoDihedralHom d=wreathTwoDihedralHom d*x ∧
      centralizerProjection d x=a) ∧
    (∀ x : W, x*wreathTwoDihedralHom d=wreathTwoDihedralHom d*x →
      (centralizerProjection d x=1 ↔ x=1 ∨ x=wreathTwoDihedralHom d)) := by
  decide +kernel

private theorem centralizer_standard (d : DihedralGroup 4)
    (hd2 : d^2=1) (hdnc : d ∉ Subgroup.center (DihedralGroup 4)) :
    Nat.card (Subgroup.centralizer ({wreathTwoDihedralHom d} : Set W)) = 12 ∧
      ∃ φ : Subgroup.centralizer ({wreathTwoDihedralHom d} : Set W) →* SL2,
        Function.Surjective φ ∧ φ.ker = (Subgroup.zpowers (wreathTwoDihedralHom d)).subgroupOf
          (Subgroup.centralizer ({wreathTwoDihedralHom d} : Set W)) := by
  obtain ⟨hcard,hmul,hsurj,hker⟩ := projection_spec d hd2 hdnc
  let z := wreathTwoDihedralHom d
  let C := Subgroup.centralizer ({z} : Set W)
  have hxcomm (x : C) : (x:W)*z=z*(x:W) := Subgroup.mem_centralizer_singleton_iff.mp x.property
  let φ : C →* SL2 := {
    toFun := fun x => centralizerProjection d x
    map_one' := (hker 1 (by simp)).mpr (Or.inl rfl)
    map_mul' := fun x y => hmul x y (hxcomm x) (hxcomm y) }
  have hequiv : C ≃ {x:W // x*z=z*x} :=
    Equiv.subtypeEquivRight (fun x => Subgroup.mem_centralizer_singleton_iff)
  have hcardC : Nat.card C=12 := by
    rw [Nat.card_congr hequiv, Nat.card_eq_fintype_card]
    exact hcard
  refine ⟨hcardC,φ,?_,?_⟩
  · intro a
    obtain ⟨x,hx,hxa⟩ := hsurj a
    exact ⟨⟨x,Subgroup.mem_centralizer_singleton_iff.mpr hx⟩,hxa⟩
  let zC : C := ⟨z, Subgroup.mem_centralizer_singleton_iff.mpr rfl⟩
  have hkerEq : φ.ker = Subgroup.zpowers zC := by
    apply le_antisymm
    · intro x hx
      rcases (hker x (hxcomm x)).mp (show centralizerProjection d x=1 from hx) with hx1 | hxz
      · have hx' : x=1 := Subtype.ext hx1
        rw [hx']; exact Subgroup.one_mem _
      · have hx' : x=zC := Subtype.ext hxz
        rw [hx']; exact Subgroup.mem_zpowers _
    · apply Subgroup.zpowers_le.mpr
      exact (hker z (by rfl)).mpr (Or.inr rfl)
  rw [hkerEq]
  apply Subgroup.map_injective C.subtype_injective
  rw [C.subtype.map_zpowers, Subgroup.map_subgroupOf_eq_of_le]
  · rfl
  · exact Subgroup.zpowers_le.mpr zC.property

private theorem centralizer_quotient_transport
    {G H : Type*} [Group G] [Group H] (e : G ≃* G) (z : G)
    (hcard : Nat.card (Subgroup.centralizer ({z} : Set G)) = 12)
    (φ : Subgroup.centralizer ({z} : Set G) →* H)
    (hsurj : Function.Surjective φ)
    (hker : φ.ker = (Subgroup.zpowers z).subgroupOf (Subgroup.centralizer ({z} : Set G))) :
    Nat.card (Subgroup.centralizer ({e z} : Set G)) = 12 ∧
      ∃ ψ : Subgroup.centralizer ({e z} : Set G) →* H,
        Function.Surjective ψ ∧
        ψ.ker = (Subgroup.zpowers (e z)).subgroupOf (Subgroup.centralizer ({e z} : Set G)) := by
  let C := Subgroup.centralizer ({z} : Set G)
  let D := Subgroup.centralizer ({e z} : Set G)
  have hmap : C.map e.toMonoidHom = D := by
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      have hh := Subgroup.mem_centralizer_singleton_iff.mp hy
      change e y * e z = e z * e y
      simpa only [map_mul] using congrArg e hh
    · intro hx
      refine ⟨e.symm x, ?_, e.apply_symm_apply x⟩
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      apply e.injective
      simpa only [map_mul, MulEquiv.apply_symm_apply] using
        Subgroup.mem_centralizer_singleton_iff.mp hx
  let F : C ≃* D := (C.equivMapOfInjective e.toMonoidHom e.injective).trans
    (MulEquiv.subgroupCongr hmap)
  have hF (x : C) : (F x : G) = e x := rfl
  have hFi (x : D) : e (F.symm x : G) = (x : G) := by
    rw [← hF, F.apply_symm_apply]
  let ψ : D →* H := φ.comp F.symm.toMonoidHom
  refine ⟨(Nat.card_congr F.toEquiv).symm.trans hcard, ψ, hsurj.comp F.symm.surjective, ?_⟩
  ext x
  change φ (F.symm x) = 1 ↔ (x : G) ∈ Subgroup.zpowers (e z)
  change F.symm x ∈ φ.ker ↔ _
  rw [hker]
  change (F.symm x : G) ∈ Subgroup.zpowers z ↔ _
  change (F.symm x : G) ∈ Subgroup.zpowers z ↔ (x : G) ∈ Subgroup.zpowers (e.toMonoidHom z)
  rw [← e.toMonoidHom.map_zpowers z, ← hFi x]
  exact (Subgroup.mem_map_iff_mem (f := e.toMonoidHom) e.injective).symm

private theorem wreath_centralizer_to_SL2 (P : Sylow 2 W) (z : W)
    (hzP : z ∈ (P : Subgroup W)) (hz2 : z^2=1)
    (hznc : z ∉ (Subgroup.center P).map (P : Subgroup W).subtype) :
    Nat.card (Subgroup.centralizer ({z} : Set W)) = 12 ∧
      ∃ φ : Subgroup.centralizer ({z} : Set W) →* SL2,
        Function.Surjective φ ∧
        φ.ker = (Subgroup.zpowers z).subgroupOf (Subgroup.centralizer ({z} : Set W)) := by
  obtain ⟨u,hu⟩ := MulAction.exists_smul_eq W wreathTwoSylow P
  let e := MulAut.conj u
  have hmap : wreathTwoDihedralHom.range.map e.toMonoidHom = (P : Subgroup W) := by
    have hh := congrArg (fun S : Sylow 2 W => (S : Subgroup W)) hu
    change (wreathTwoSylow : Subgroup W).map e.toMonoidHom = (P : Subgroup W) at hh
    rwa [wreathTwoSylow_coe] at hh
  let j : DihedralGroup 4 →* W := e.toMonoidHom.comp wreathTwoDihedralHom
  have hjinj : Function.Injective j := e.injective.comp wreathTwoDihedralHom_injective
  have hjrange : j.range = (P : Subgroup W) := by
    rw [MonoidHom.range_comp]
    exact hmap
  obtain ⟨d,hd⟩ := (show z ∈ j.range from hjrange.symm ▸ hzP)
  have hd2 : d^2=1 := by
    apply hjinj
    rw [map_pow, map_one, hd]
    exact hz2
  have hdnc : d ∉ Subgroup.center (DihedralGroup 4) := by
    intro hdc
    apply hznc
    refine ⟨⟨z,hzP⟩,?_,rfl⟩
    apply Subgroup.mem_center_iff.mpr
    intro p
    apply Subtype.ext
    obtain ⟨k,hk⟩ := (show (p:W) ∈ j.range from hjrange.symm ▸ p.property)
    change (p:W)*z=z*(p:W)
    rw [← hk, ← hd, ← map_mul, ← map_mul]
    exact congrArg j (Subgroup.mem_center_iff.mp hdc k)
  obtain ⟨hcard,φ,hsurj,hker⟩ := centralizer_standard d hd2 hdnc
  have hh := centralizer_quotient_transport e (wreathTwoDihedralHom d) hcard φ hsurj hker
  change e (wreathTwoDihedralHom d) = z at hd
  rwa [hd] at hh

/-- A noncentral involution in a wreath Sylow has centralizer of order twelve
and quotient `S₃` by the involution it generates. -/
public theorem wreath_two_noncentral_involution_centralizer
    (P : Sylow 2 (RegularWreathProduct (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))
      (Multiplicative (ZMod 2))))
    (z : RegularWreathProduct (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2))
      (Multiplicative (ZMod 2)))
    (hzP : z ∈ (P : Subgroup _)) (hz2 : z^2=1)
    (hznc : z ∉ (Subgroup.center P).map (P : Subgroup _).subtype) :
    Nat.card (Subgroup.centralizer ({z} : Set _)) = 12 ∧
      ∃ φ : Subgroup.centralizer ({z} : Set _) →* Equiv.Perm (Fin 3),
        Function.Surjective φ ∧
        φ.ker = (Subgroup.zpowers z).subgroupOf (Subgroup.centralizer ({z} : Set _)) := by
  obtain ⟨eSL⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
  obtain ⟨hcard,φ,hsurj,hker⟩ := wreath_centralizer_to_SL2 P z hzP hz2 hznc
  let ψ := eSL.toMonoidHom.comp φ
  refine ⟨hcard,ψ,eSL.surjective.comp hsurj,?_⟩
  have hkeq : ψ.ker=φ.ker := by
    ext x
    change eSL (φ x)=1 ↔ φ x=1
    rw [← eSL.map_one]
    exact eSL.injective.eq_iff
  exact hkeq.trans hker
