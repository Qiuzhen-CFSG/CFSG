module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Commutator.Basic
public import Theory.ElementaryAbelian.Basic

/-!
# The derived image of an index-two extension

Let `J` be normal in `H`, with elementary abelian abelianization of exponent two.
If the image of `V` in `H / J` is generated by the involution represented by
`t ∈ V`, the image of `V'` in `J / J'` is exactly the displacement of the image
of `V ∩ J` under conjugation by `t`.

Write each element of `V` as `a` or `a * t`, with `a ∈ V ∩ J`. The four
commutator calculations give one inclusion; the commutators `[t, a]` give the
reverse inclusion. The action is supplied by its representative formula, so
this result does not depend on a particular construction of the quotient action.

Source: Parrott (1972), pp. 673–674 and the first paragraph of p. 677.
-/

open scoped commutatorElement

namespace Theory.GroupTheory

/-- In an index-two extension, the derived subgroup maps onto the displacement
image of the intersection with the normal subgroup, in its elementary abelian
abelianization. -/
public theorem cyclic_extension_derived_image
    {H : Type*} [Group H] [Finite H]
    (J V : Subgroup H) [J.Normal]
    [IsElementaryAbelian 2 (J ⧸ commutator J)]
    (f : (H ⧸ J) →* MulAut (J ⧸ commutator J))
    (hf : ∀ (a : H) (b b' : J), (b' : H) = a * (b : H) * a⁻¹ →
      f (QuotientGroup.mk' J a) (QuotientGroup.mk' (commutator J) b) =
        QuotientGroup.mk' (commutator J) b')
    (t : H) (ht : t ∈ V) (horder : orderOf (QuotientGroup.mk' J t) = 2)
    (hVmap : V.map (QuotientGroup.mk' J) =
      Subgroup.zpowers (QuotientGroup.mk' J t)) :
    ∀ s : (J ⧸ commutator J) →* (J ⧸ commutator J),
      (∀ w, s w = f (QuotientGroup.mk' J t) w * w) →
      (((commutator V).map V.subtype).comap J.subtype).map
          (QuotientGroup.mk' (commutator J)) =
        ((V.comap J.subtype).map (QuotientGroup.mk' (commutator J))).map s := by
  classical
  let π : H →* (H ⧸ J) := QuotientGroup.mk' J
  let q : J →* (J ⧸ commutator J) := QuotientGroup.mk' (commutator J)
  intro s hs
  let R := ((V.comap J.subtype).map q).map s
  let N := (R.comap q).map J.subtype
  have hinv (w : J ⧸ commutator J) : w⁻¹ = w := by
    apply inv_eq_of_mul_eq_one_right
    simpa [pow_two] using
      Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 (J ⧸ commutator J)) w
  have hself (w : J ⧸ commutator J) : w * w = 1 := by
    simpa only [hinv w] using inv_mul_cancel w
  have hs_mem (b : J) (hb : (b : H) ∈ V) : s (q b) ∈ R :=
    Subgroup.mem_map_of_mem s (Subgroup.mem_map_of_mem q hb)
  let c (b : J) : J := ⟨t * b * t⁻¹, Subgroup.Normal.conj_mem inferInstance _ b.property t⟩
  have hc (b : J) : q (c b) = f (π t) (q b) := (hf t b (c b) rfl).symm
  -- The cyclic image has just the two cosets represented by `1` and `t`.
  have hdecomp (x : H) (hx : x ∈ V) :
      ∃ a : J, (a : H) ∈ V ∧ (x = a ∨ x = a * t) := by
    have hp : π x ∈ Subgroup.zpowers (π t) := by
      rw [← hVmap]
      exact Subgroup.mem_map_of_mem π hx
    rw [mem_zpowers_iff_mem_range_orderOf, horder] at hp
    obtain ⟨i, hi, heq⟩ := Finset.mem_image.mp hp
    have hi' : i = 0 ∨ i = 1 := by
      have := Finset.mem_range.mp hi
      omega
    rcases hi' with rfl | rfl
    · have hxJ : x ∈ J := (QuotientGroup.eq_one_iff x).mp (by simpa [π] using heq.symm)
      exact ⟨⟨x, hxJ⟩, hx, Or.inl rfl⟩
    · have heq' : π x = π t := by simpa using heq.symm
      have haJ : x * t⁻¹ ∈ J := (QuotientGroup.eq_one_iff _).mp (by
        change π (x * t⁻¹) = 1
        simp [heq'])
      exact ⟨⟨x * t⁻¹, haJ⟩, V.mul_mem hx (V.inv_mem ht), Or.inr (by simp)⟩
  -- Each of the four commutator types maps into the displacement image.
  have hD : (commutator V).map V.subtype ≤ N := by
    rw [V.map_subtype_commutator]
    apply Subgroup.commutator_le.mpr
    intro x hx y hy
    obtain ⟨a, ha, rfl | rfl⟩ := hdecomp x hx <;>
      obtain ⟨b, hb, rfl | rfl⟩ := hdecomp y hy
    · refine Subgroup.mem_map.mpr ⟨⁅a, b⁆, ?_, rfl⟩
      change q ⁅a, b⁆ ∈ R
      have heq : q ⁅a, b⁆ = 1 := (QuotientGroup.eq_one_iff _).mpr
        (Subgroup.commutator_mem_commutator (Subgroup.mem_top a) (Subgroup.mem_top b))
      rw [heq]
      exact R.one_mem
    · refine Subgroup.mem_map.mpr ⟨a * b * (c a)⁻¹ * b⁻¹, ?_, ?_⟩
      · change q (a * b * (c a)⁻¹ * b⁻¹) ∈ R
        have heq : q (a * b * (c a)⁻¹ * b⁻¹) = s (q a) := by
          simp only [map_mul, map_inv, hc, hinv, hs]
          calc
            _ = (f (π t) (q a) * q a) * (q b * q b) := by ac_rfl
            _ = _ := by rw [hself, mul_one]
        rw [heq]
        exact hs_mem a ha
      · simp [c, commutatorElement_def, mul_assoc]
    · refine Subgroup.mem_map.mpr ⟨a * c b * a⁻¹ * b⁻¹, ?_, ?_⟩
      · change q (a * c b * a⁻¹ * b⁻¹) ∈ R
        have heq : q (a * c b * a⁻¹ * b⁻¹) = s (q b) := by
          simp only [map_mul, map_inv, hc, hinv, hs]
          calc
            _ = (f (π t) (q b) * q b) * (q a * q a) := by ac_rfl
            _ = _ := by rw [hself, mul_one]
        rw [heq]
        exact hs_mem b hb
      · simp [c, commutatorElement_def, mul_assoc]
    · refine Subgroup.mem_map.mpr ⟨a * c b * (c a)⁻¹ * b⁻¹, ?_, ?_⟩
      · change q (a * c b * (c a)⁻¹ * b⁻¹) ∈ R
        have heq : q (a * c b * (c a)⁻¹ * b⁻¹) = s (q a) * s (q b) := by
          simp only [map_mul, map_inv, hc, hinv, hs]
          ac_rfl
        rw [heq]
        exact R.mul_mem (hs_mem a ha) (hs_mem b hb)
      · simp [c, commutatorElement_def, mul_assoc]
  apply le_antisymm
  · rintro z hz
    obtain ⟨b, hb, rfl⟩ := Subgroup.mem_map.mp hz
    obtain ⟨a, ha, hab⟩ := Subgroup.mem_map.mp (hD hb)
    have : a = b := Subtype.ext hab
    subst a
    exact ha
  · -- Every displacement is represented by the commutator `[t, b]`.
    rintro z hz
    obtain ⟨w, hw, rfl⟩ := Subgroup.mem_map.mp hz
    obtain ⟨b, hb, rfl⟩ := Subgroup.mem_map.mp hw
    refine Subgroup.mem_map.mpr ⟨c b * b⁻¹, ?_, ?_⟩
    · change (↑(c b * b⁻¹) : H) ∈ (commutator V).map V.subtype
      rw [V.map_subtype_commutator]
      exact Subgroup.commutator_mem_commutator ht hb
    · change q (c b * b⁻¹) = s (q b)
      simp only [map_mul, map_inv, hc, hinv, hs]
      rfl

end Theory.GroupTheory
