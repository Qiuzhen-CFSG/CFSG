module

public import Theory.GroupTheory.ComponentLocalTwelveExclusion.CentralOrbit
public import Theory.GroupTheory.PResidual.AbelianSquareObstruction
public import Theory.Quasithin.EvenCharacteristic

/-!
# Full local-factor covers of component-orbit overgroups

A central quotient of a local seed which kills the component center induces a
surjection from the component orbit onto a finite direct power of the full
quotient seed. Characteristic p of the seed puts the central kernel inside the
p-group generated by the conjugate seed cores. Adjoining a p-subgroup gives a
p-group quotient above this orbit, hence a normal power cover.

The relative version applies inside H and transports the resulting cover into
G; it assumes neither ambient normality nor that the actor fixes the component.
In particular the full local factors are retained, rather than replaced by
quotients by their own p-cores.

Source application: Aschbacher–Smith, 2.3.9(7), printed p.526.
-/

public section

open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

/-- A characteristic-p local seed gives a cover by full local factors, with
p-group kernels below and above its normal component-orbit base. -/
theorem IsComponent.local_adjoin_normalPowerCover
    {p : ℕ} {L K A : Subgroup G} {B : Type*} [Group B]
    (hL : IsComponent G L) (hKL : K ≤ L)
    (hinv : A ⊓ normalizer (L : Set G) ≤ normalizer (K : Set G))
    (hself : centralizer (pCore p K : Set K) ≤ pCore p K)
    (hA : IsPGroup p A) (f : K →* B) (hf : Function.Surjective f)
    (hcentral : f.ker ≤ center K)
    (hkill : ∀ k : K, inclusion hKL k ∈ center L → f k = 1) :
    Nonempty (NormalPowerCover p (K ⊔ A : Subgroup G) B) := by
  obtain ⟨n, q, hq, hqc⟩ :=
    ComponentLocalTwelveExclusion.central_power_of_component_orbit hL hKL hinv f hf hcentral hkill
  let D := componentOrbit K A
  let Q := componentOrbit (K.pCoreIn p) A
  obtain ⟨hQp, hQD, _⟩ := hL.local_core_orbit (p := p) hKL hinv
  have hbound := hL.local_orbit_centralizer hKL hinv
    ((inf_centralizer_pCoreIn_le_iff p K).mpr hself)
  have hker : q.ker.map D.subtype ≤ Q := by
    rintro x ⟨y, hy, rfl⟩
    apply hbound
    refine ⟨y.property, ?_⟩
    intro t ht
    exact congrArg (fun w : D => (w : G))
      (mem_center_iff.mp (hqc hy) ⟨t, hQD ht⟩)
  have hqp : IsPGroup p q.ker :=
    (hQp.to_le hker).of_equiv
      (q.ker.equivMapOfInjective D.subtype D.subtype_injective).symm
  let N := D.subgroupOf (K ⊔ A)
  let := componentOrbit_normal_subgroupOf_sup K A
  let eN : N ≃* D := subgroupOfEquivOfLe (componentOrbit_le_sup K A)
  exact ⟨{
    base := N
    normal := inferInstance
    quotient_isPGroup := local_orbit_quotient_isPGroup K A hA
    copies := n
    projection := q.comp eN.toMonoidHom
    surjective := hq.comp eN.surjective
    kernel_isPGroup := hqp.comap_of_injective eN.toMonoidHom eN.injective }⟩

end Theory.GroupTheory

namespace Theory.GroupTheory.NormalPowerCover
variable {X Y B : Type*} [Group X] [Group Y] [Group B] {p : ℕ}

/-- Transport the normal base, its full-factor projection and both p-group
conditions along an actual equivalence of the overgroups. -/
def of_mulEquiv (d : NormalPowerCover p X B) (e : X ≃* Y) :
    NormalPowerCover p Y B := by
  letI := d.normal
  let N := d.base.map e.toMonoidHom
  letI : N.Normal := Subgroup.Normal.map d.normal e.toMonoidHom e.surjective
  let eb := e.subgroupMap d.base
  exact {
    base := N
    normal := inferInstance
    quotient_isPGroup := d.quotient_isPGroup.of_equiv (QuotientGroup.congr d.base N e rfl)
    copies := d.copies
    projection := d.projection.comp eb.symm.toMonoidHom
    surjective := d.surjective.comp eb.symm.surjective
    kernel_isPGroup := d.kernel_isPGroup.comap_of_injective
      eb.symm.toMonoidHom eb.symm.injective }

end Theory.GroupTheory.NormalPowerCover

namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

/-- The full-factor cover only requires component subnormality inside H.
The normalizer hypothesis is imposed on the component stabilizer in A. -/
theorem IsComponent.relative_local_adjoin_normalPowerCover
    {p : ℕ} {H L K A : Subgroup G} {B : Type*} [Group B]
    (hL : IsComponent H (L.subgroupOf H)) (hLH : L ≤ H) (hKL : K ≤ L)
    (hAH : A ≤ H) (hA : IsPGroup p A)
    (hinv : A ⊓ normalizer (L : Set G) ≤ normalizer (K : Set G))
    (hself : centralizer (pCore p K : Set K) ≤ pCore p K)
    (f : K →* B) (hf : Function.Surjective f)
    (hcentral : f.ker ≤ center K)
    (hkill : ∀ k : K, inclusion hKL k ∈ center L → f k = 1) :
    Nonempty (NormalPowerCover p (K ⊔ A : Subgroup G) B) := by
  let F := K.subgroupOf H
  let D := A.subgroupOf H
  have hKH : K ≤ H := hKL.trans hLH
  have hFL : F ≤ L.subgroupOf H := subgroupOf_mono H hKL
  have hinvH : D ⊓ normalizer (L.subgroupOf H : Set H) ≤ normalizer (F : Set H) := by
    rw [← subgroupOf_normalizer_eq hLH, ← subgroupOf_normalizer_eq hKH]
    intro x hx
    exact hinv hx
  let eF : F ≃* K := subgroupOfEquivOfLe hKH
  let eL : L.subgroupOf H ≃* L := subgroupOfEquivOfLe hLH
  have hselfF : centralizer (pCore p F : Set F) ≤ pCore p F :=
    (Theory.Quasithin.centralizer_pCore_le_iff p eF).mpr hself
  let fH := f.comp eF.toMonoidHom
  have hcentralH : fH.ker ≤ center F := by
    intro x hx
    apply mem_center_iff.mpr
    intro y
    apply eF.injective
    simpa only [map_mul, MulEquiv.coe_toMonoidHom] using
      mem_center_iff.mp (hcentral hx) (eF y)
  have hkillH (x : F) (hx : inclusion hFL x ∈ center (L.subgroupOf H)) : fH x = 1 := by
    have hxL : eL (inclusion hFL x) ∈ center L := (centerCongr eL ⟨_, hx⟩).property
    exact hkill (eF x) hxL
  obtain ⟨d⟩ := hL.local_adjoin_normalPowerCover hFL hinvH hselfF hA.comap_subtype
    fH (hf.comp eF.surjective) hcentralH hkillH
  let eX : (F ⊔ D : Subgroup H) ≃* (K ⊔ A : Subgroup G) :=
    (MulEquiv.subgroupCongr (subgroupOf_sup hKH hAH).symm).trans
      (subgroupOfEquivOfLe (sup_le hKH hAH))
  exact ⟨d.of_mulEquiv eX⟩

end Theory.GroupTheory
