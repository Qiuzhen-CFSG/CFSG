module
public import Theory.GroupTheory.CentralExtensionPartialInversion
public import Theory.GroupTheory.PerfectCentralCoverSylowNine
import all Theory.GroupTheory.PerfectCentralCoverSylowNine

/-!
# Simultaneous inversion and odd-primary perfect central kernels

Let a Sylow p-subgroup, for odd p, be generated by elements x,y of order p
with nontrivial central commutator. An ambient element inverting x,y and
fixing their commutator makes the commutator of lifts central upstairs.
Frattini generation and central Sylow transfer then exclude p from the
kernel of every finite perfect central cover.

This extends the existing three-primary argument in
`PerfectCentralCoverSylowNine.PartialInversion`; the intentional `import all`
reuses its internal, prime-independent two-generator derived-subgroup lemma
without changing the shared module's public boundary. The Rudvalis
five-local family supplies every premise on the literal carrier.

Source: the Ru multiplier entry and five-local action in GLS III,
Table 5.3r, printed p.279; Aschbacher–Smith I.1.3.
-/

open scoped commutatorElement
open Subgroup
namespace PerfectCentralCovering

private theorem pair_lifts_generate
    {E G : Type*} [Group E] [Group G] [Finite E] [Group.IsPerfect E]
    (f : E →* G) (hker : f.ker ≤ center E)
    {p : ℕ} [Fact p.Prime] (P : Sylow p E) (x y : P)
    (himage : closure ({f x, f y} : Set G) = (P : Subgroup E).map f) :
    closure ({x, y} : Set P) = ⊤ := by
  let g : P →* G := f.comp (P : Subgroup E).subtype
  have hmap : (closure ({x, y} : Set P)).map g = g.range := by
    rw [MonoidHom.map_closure]
    simpa only [Set.image_insert_eq, Set.image_singleton, g, MonoidHom.comp_apply,
      Subgroup.coe_subtype, MonoidHom.range_comp, range_subtype] using himage
  have hs : closure ({x, y} : Set P) ⊔ g.ker = ⊤ := by
    have h := congrArg (Subgroup.comap g) hmap
    simpa only [comap_map_eq, MonoidHom.comap_range_self] using h
  have hF : g.ker ≤ frattini P := ker_comap_le_frattini_sylow P f hker
  apply frattini_nongenerating
  exact top_unique (hs ▸ sup_le_sup_left hF _)

private theorem pow_commutator {G : Type*} [Group G] (x y : G)
    (hx : Commute ⁅x, y⁆ x) {p : ℕ} (hpower : Commute (x ^ p) y) :
    ⁅x, y⁆ ^ p = 1 := by
  have hpow (n : ℕ) : ⁅x ^ n, y⁆ = ⁅x, y⁆ ^ n := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, commutatorElement_mul_left_eq_conj_mul,
        hx.symm.pow_left n |>.eq, mul_inv_cancel_right, ih, ← pow_succ']
  rw [← hpow p]
  exact hpower.commutator_eq

/-- Simultaneous inversion of a nonabelian Sylow pair kills the odd-primary kernel. -/
public theorem not_dvd_card_kernel_of_simultaneous_inversion
    {E G : Type*} [Group E] [Finite E] [Group.IsPerfect E] [Group G] [Finite G]
    (f : E →* G) (hf : Function.Surjective f) (hk : f.ker ≤ center E)
    {p : ℕ} [Fact p.Prime] (hp : p.Coprime 2) (Q : Sylow p G) (x y r : G)
    (hQ : closure ({x, y} : Set G) = (Q : Subgroup G))
    (hx : x ^ p = 1) (hy : y ^ p = 1) (hz : ⁅x, y⁆ ≠ 1)
    (hxz : Commute x ⁅x, y⁆) (hyz : Commute y ⁅x, y⁆)
    (hrx : r * x * r⁻¹ = x⁻¹) (hry : r * y * r⁻¹ = y⁻¹)
    (hrz : Commute r ⁅x, y⁆) : ¬ p ∣ Nat.card f.ker := by
  obtain ⟨P, hPQ⟩ := Sylow.mapSurjective_surjective hf p Q
  have hmap : (P : Subgroup E).map f = (Q : Subgroup G) := by
    rw [← Sylow.coe_mapSurjective hf, hPQ]
  have hxmem : x ∈ (P : Subgroup E).map f := by
    rw [hmap, ← hQ]
    exact subset_closure (by simp)
  have hymem : y ∈ (P : Subgroup E).map f := by
    rw [hmap, ← hQ]
    exact subset_closure (by simp)
  obtain ⟨aE, haP, ha⟩ := hxmem
  obtain ⟨bE, hbP, hb⟩ := hymem
  let a : P := ⟨aE, haP⟩
  let b : P := ⟨bE, hbP⟩
  let c : P := ⁅a, b⁆
  have hfc : f (c : E) = ⁅x, y⁆ := by
    change f ⁅aE, bE⁆ = _
    rw [map_commutatorElement, ha, hb]
  have hgen : closure ({a, b} : Set P) = ⊤ :=
    pair_lifts_generate f hk P a b (by
      change closure ({f aE, f bE} : Set G) = _
      rw [ha, hb, hQ, hmap])
  have hca : Commute c a := by
    apply Subtype.ext
    exact (CentralExtension.commute_lifts_of_partial_inversion f hf hk
      x ⁅x, y⁆ r hp hx hxz hrx hrz aE c ha hfc).symm.eq
  have hcb : Commute c b := by
    apply Subtype.ext
    exact (CentralExtension.commute_lifts_of_partial_inversion f hf hk
      y ⁅x, y⁆ r hp hy hyz hry hrz bE c hb hfc).symm.eq
  have hder : _root_.commutator P ≤ zpowers c :=
    SylowNine.commutator_le_zpowers_of_pair a b hgen hca hcb
  have hcp : c ^ p = 1 := by
    apply pow_commutator a b hca
    apply Subtype.ext
    exact (mem_center_iff.mp (hk (by
      change f (aE ^ p) = 1
      rw [map_pow, ha, hx])) bE).symm
  have hcorder : orderOf c = p := orderOf_eq_prime hcp (by
    intro hc
    apply hz
    rw [← hfc, hc, Subgroup.coe_one, map_one])
  have hzorder : orderOf ⁅x, y⁆ = p := orderOf_eq_prime (by
    rw [← hfc, ← map_pow]
    exact (congrArg f (congrArg Subtype.val hcp)).trans (map_one f)) hz
  intro hd
  obtain ⟨w, hw⟩ := exists_prime_orderOf_dvd_card' p hd
  have hwE : orderOf (w : E) = p := (Subgroup.orderOf_coe w).trans hw
  let W := zpowers (w : E)
  have hW : W ≤ center E := zpowers_le.mpr (hk w.property)
  let : W.Normal := ⟨fun v hv g => by
    rw [mem_center_iff.mp (hW hv) g, mul_inv_cancel_right]
    exact hv⟩
  have hWp : IsPGroup p W := IsPGroup.of_card (n := 1) (by
    simpa only [W, Nat.card_zpowers, pow_one] using hwE)
  have hwP : (w : E) ∈ (P : Subgroup E) := hWp.le_sylow_of_normal P (mem_zpowers _)
  have hwder := center_inf_commutator_inf_sylow_le_commutator P
    ⟨⟨hk w.property, Group.IsPerfect.mem_commutator⟩, hwP⟩
  rw [← map_subtype_commutator] at hwder
  obtain ⟨v, hv, hvw⟩ := hwder
  obtain ⟨k, hkpow⟩ := mem_zpowers_iff.mp (hder hv)
  have hpowimage : ⁅x, y⁆ ^ k = 1 := by
    rw [← hfc, ← map_zpow]
    exact (congrArg f ((congrArg Subtype.val hkpow).trans hvw)).trans w.property
  have hcpow : c ^ k = 1 := orderOf_dvd_iff_zpow_eq_one.mp (by
    rw [hcorder, ← hzorder]
    exact orderOf_dvd_iff_zpow_eq_one.mpr hpowimage)
  have hwone : (w : E) = 1 := by
    rw [← hvw, ← hkpow, hcpow, map_one]
  rw [hwone, orderOf_one] at hwE
  exact (Fact.out : p.Prime).ne_one hwE.symm

end PerfectCentralCovering
