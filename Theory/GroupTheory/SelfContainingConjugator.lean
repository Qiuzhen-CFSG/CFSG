module

public import Theory.GroupAction.SubgroupConjugation
public import Mathlib.Algebra.Group.Subgroup.Finite
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Self-containing conjugator lifts

If a quotient element lies in the subgroup generated by the image of `A`
and its conjugate, some lift lies in the subgroup generated by `A` and its
own conjugate. Minimize the finite cardinality of that generated subgroup
over all lifts. A second lift inside it yields a smaller candidate, hence
the same subgroup. This is the finite replacement step used for the
conjugator in Stellmacher (7.8)(a), Journal of Algebra 190 (1997), p. 36.
The homomorphism need not be surjective, but the chosen element must lift.
-/

namespace Subgroup

private theorem map_conjBy_lift
    {G Q : Type*} [Group G] [Group Q]
    (f : G →* Q) (A : Subgroup G) (x : G) :
    (A.conjBy x).map f = (A.map f).conjBy (f x) := by
  unfold conjBy
  rw [map_map, map_map]
  congr 1
  ext a
  simp [MulAut.conj_apply]

public theorem exists_lift_mem_sup_conjBy
    {G Q : Type*} [Group G] [Finite G] [Group Q]
    (f : G →* Q) (A : Subgroup G) (z : Q) (hzlift : z ∈ f.range)
    (hz : z ∈ A.map f ⊔ (A.map f).conjBy z) :
    ∃ x : G, f x = z ∧ x ∈ A ⊔ A.conjBy x := by
  classical
  let L (x : G) := A ⊔ A.conjBy x
  have hex : ∃ n : ℕ, ∃ x : G, f x = z ∧ Nat.card (L x) = n := by
    obtain ⟨x, hx⟩ := hzlift
    exact ⟨Nat.card (L x), x, hx, rfl⟩
  obtain ⟨x, hx, hcard⟩ := Nat.find_spec hex
  have hmin (y : G) (hy : f y = z) : Nat.card (L x) ≤ Nat.card (L y) := by
    rw [hcard]
    exact Nat.find_min' hex ⟨y, hy, rfl⟩
  have hzL : z ∈ (L x).map f := by
    dsimp only [L]
    rw [map_sup, map_conjBy_lift, hx]
    exact hz
  obtain ⟨y, hyL, hy⟩ := hzL
  have hLy : L y ≤ L x := by
    apply sup_le le_sup_left
    rintro t ⟨a, ha, rfl⟩
    exact (L x).mul_mem
      ((L x).mul_mem hyL ((show A ≤ L x from le_sup_left) ha)) ((L x).inv_mem hyL)
  have hEq : L y = L x := eq_of_le_of_card_ge hLy (hmin y hy)
  refine ⟨y, hy, ?_⟩
  change y ∈ L y
  rw [hEq]
  exact hyL

end Subgroup
