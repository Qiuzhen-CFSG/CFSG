module
public import Theory.Representation.BinaryPermutation.FivePairFixedSpaces
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.ElementaryAbelian.EightQuotientRank
import Mathlib.Tactic

/-!
# Generation by conjugate cores in the five-point action

Let the image of a finite group on its marked binary five-point core be
the four-group generated by two disjoint transpositions. Suppose its kernel
is the product of that core and a disjoint subgroup. An abelian subgroup
of the same order as the kernel contains the second factor and has nontrivial
image. Either it supplements the kernel, or it and an automorphic image
generate the group whenever that automorphism preserves the core and exchanges
the two quotient transpositions.

In the proper-image case, the kernel-image order formula makes the intersection
with the core have order eight. It cannot be fixed by the double transposition,
whose fixed group has order four. Thus it is one of the two transposition fixed
hyperplanes; the exchanged hyperplane spans the whole core with it.

Source: Aschbacher–Smith, Quasithin Groups, Lemma 5.1.7(1), printed p.633,
the replacement of the original conjugator when QQ^g is smaller than S.
-/
open Subgroup BinaryPermutation
namespace FiveCoreConjugateGeneration
private theorem intersection_kernel {S : Type*} [Group S]
    (V C W : Subgroup S) [V.Normal] (hCW : C ≤ W) :
    W ⊓ (V ⊔ C) = (W ⊓ V) ⊔ C := by
  apply le_antisymm
  · intro x hx
    obtain ⟨v, hv, c, hc, rfl⟩ := mem_sup_of_normal_left.mp hx.2
    have hvW : v ∈ W := by
      have hh := W.mul_mem hx.1 (W.inv_mem (hCW hc))
      simpa only [mul_inv_cancel_right] using hh
    exact mul_mem (mem_sup_left ⟨hvW, hv⟩) (mem_sup_right hc)
  · exact sup_le (inf_le_inf_left W le_sup_left) (le_inf hCW le_sup_right)

private theorem card_intersection {S : Type*} [Group S] [Finite S]
    (V C W : Subgroup S) [V.Normal] [IsMulCommutative W]
    (hd : Disjoint V C) (hCW : C ≤ W)
    (q : S →* Equiv.Perm (Fin 5)) (hk : q.ker = V ⊔ C)
    (hV : Nat.card V = 16) (hW : Nat.card W = Nat.card (V ⊔ C : Subgroup S))
    (hi : Nat.card (W.map q) = 2) : Nat.card (W ⊓ V : Subgroup S) = 8 := by
  have hp := IsElementaryAbelian.card_inf_ker_mul_card_map W q
  rw [hk, intersection_kernel V C W hCW, hi, hW,
    card_sup_eq_mul_of_normalizes_of_disjoint V C le_normalizer_of_normal hd, hV] at hp
  have hn : C ≤ normalizer ((W ⊓ V : Subgroup S) : Set S) := by
    apply le_trans _ (centralizer_le_normalizer _)
    intro c hc
    exact mem_centralizer_iff.mpr fun x hx => setLike_mul_comm hx.1 (hCW hc)
  rw [card_sup_eq_mul_of_normalizes_of_disjoint _ C hn (hd.mono_left inf_le_right)] at hp
  have hc : 0 < Nat.card C := Nat.card_pos
  nlinarith

open BinaryPermutation.FivePairFixedSpaces
private theorem core_normal {S : Type*} [Group S]
    (V : Subgroup S) (q : S →* Perm) (m : U ≃* V)
    (he : ∀ (s : S) (x : Space),
      (m (.ofAdd (coreRepresentation (Fin 5) (q s) x)) : S) =
        s * (m (.ofAdd x) : S) * s⁻¹) : V.Normal := by
  constructor
  intro x hx s
  obtain ⟨u, hu⟩ := m.surjective ⟨x,hx⟩
  have hh := he s u.toAdd
  rw [show (m (.ofAdd u.toAdd) : S) = x from congrArg Subtype.val hu] at hh
  rw [← hh]
  exact (m _).property

private theorem intersection_fixed {S : Type*} [Group S]
    (V W : Subgroup S) [IsMulCommutative W]
    (q : S →* Perm) (m : U ≃* V)
    (he : ∀ (s : S) (x : Space),
      (m (.ofAdd (coreRepresentation (Fin 5) (q s) x)) : S) =
        s * (m (.ofAdd x) : S) * s⁻¹)
    (p : Perm) (hp : p ∈ W.map q) :
    (W.comap (V.subtype.comp m.toMonoidHom)) ≤ fixedSubgroup p := by
  obtain ⟨s, hs, rfl⟩ := hp
  intro x hx
  apply m.injective
  apply Subtype.ext
  change (m (.ofAdd (coreRepresentation (Fin 5) (q s) x.toAdd)) : S) = (m x : S)
  rw [he]
  change s * (m x : S) * s⁻¹ = (m x : S)
  rw [show s * (m x : S) = (m x : S) * s from setLike_mul_comm hs hx,
    mul_inv_cancel_right]

private theorem core_card : Nat.card U = 16 := by
  change Nat.card Space = 16
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod,
    FiveGeometry.finrank_core]
  norm_num

private theorem card_pullback {S : Type*} [Group S] (V W : Subgroup S) (m : U ≃* V) :
    Nat.card (W.comap (V.subtype.comp m.toMonoidHom)) = Nat.card (W ⊓ V : Subgroup S) := by
  let e : W.comap (V.subtype.comp m.toMonoidHom) ≃ (W ⊓ V : Subgroup S) := {
    toFun x := ⟨m x, x.property, (m x).property⟩
    invFun x := ⟨m.symm ⟨x,x.property.2⟩, by
      change (m (m.symm ⟨x,x.property.2⟩) : S) ∈ W
      rw [m.apply_symm_apply]
      exact x.property.1⟩
    left_inv x := by apply Subtype.ext; exact m.symm_apply_apply x
    right_inv x := by
      apply Subtype.ext
      change (m (m.symm ⟨(x : S),x.property.2⟩) : S) = (x : S)
      exact congrArg Subtype.val (m.apply_symm_apply _) }
  exact Nat.card_congr e


private theorem eq_top_of_kernel_image {S H : Type*} [Group S] [Group H]
    (q : S →* H) (J : Subgroup S) (hk : q.ker ≤ J)
    (hi : J.map q = q.range) : J = ⊤ := by
  apply top_unique
  intro s _
  obtain ⟨w,hw,hew⟩ : q s ∈ J.map q := by rw [hi]; exact ⟨s,rfl⟩
  have hsw : s * w⁻¹ ∈ q.ker := by
    change q (s * w⁻¹) = 1
    rw [map_mul,map_inv,hew,mul_inv_cancel]
  simpa only [inv_mul_cancel_right] using J.mul_mem (hk hsw) hw

private theorem core_le_join_of_fixed_pair {S : Type*} [Group S]
    (V W W' : Subgroup S) (m : U ≃* V) (p r : Perm)
    (hA : W.comap (V.subtype.comp m.toMonoidHom) = fixedSubgroup p)
    (hB : W'.comap (V.subtype.comp m.toMonoidHom) = fixedSubgroup r)
    (hspan : fixedSubgroup p ⊔ fixedSubgroup r = ⊤) : V ≤ W ⊔ W' := by
  let v := V.subtype.comp m.toMonoidHom
  have ht : (⊤ : Subgroup U) ≤ (W ⊔ W').comap v := by
    rw [← hspan, ← hA, ← hB]
    exact sup_le (comap_mono le_sup_left) (comap_mono le_sup_right)
  intro x hx
  obtain ⟨u,hu⟩ := m.surjective ⟨x,hx⟩
  have hh := ht (mem_top u)
  change (m u : S) ∈ W ⊔ W' at hh
  simpa only [hu] using hh

private theorem fixed_pair_generation {S : Type*} [Group S] [Finite S]
    (V C W : Subgroup S) [IsMulCommutative W]
    (q : S →* Perm)
    (hr : q.range = closure ({first,second} : Set Perm))
    (hk : q.ker = V ⊔ C) (hCW : C ≤ W)
    (m : U ≃* V)
    (he : ∀ (s : S) (x : Space),
      (m (.ofAdd (coreRepresentation (Fin 5) (q s) x)) : S) =
        s * (m (.ofAdd x) : S) * s⁻¹)
    (e : S ≃* S) (heV : V.map e.toMonoidHom = V)
    (k : Perm) (heq : ∀ s, q (e s) = k * q s * k⁻¹)
    (hcard : Nat.card (W ⊓ V : Subgroup S) = 8)
    (p r : Perm) (hp : p ∈ W.map q)
    (hpr : k * p * k⁻¹ = r)
    (hcp : Nat.card (fixedSubgroup p) = 8)
    (hcr : Nat.card (fixedSubgroup r) = 8)
    (hspan : fixedSubgroup p ⊔ fixedSubgroup r = ⊤)
    (hgen : closure ({p,r} : Set Perm) = closure ({first,second} : Set Perm)) :
    W ⊔ W.map e.toMonoidHom = ⊤ := by
  let W' := W.map e.toMonoidHom
  let : IsMulCommutative W' := inferInstanceAs (IsMulCommutative (W.map e.toMonoidHom))
  have hrmem : r ∈ W'.map q := by
    obtain ⟨s, hs, hsp⟩ := hp
    exact ⟨e s,mem_map_of_mem e.toMonoidHom hs,by rw [heq,hsp,hpr]⟩
  have hcard' : Nat.card (W' ⊓ V : Subgroup S) = 8 := by
    rw [show W' ⊓ V = (W ⊓ V).map e.toMonoidHom by
      rw [map_inf _ _ _ e.injective,heV],
      card_map_of_injective e.injective,hcard]
  have hA : W.comap (V.subtype.comp m.toMonoidHom) = fixedSubgroup p := by
    apply eq_of_le_of_card_ge (intersection_fixed V W q m he p hp)
    rw [card_pullback,hcard,hcp]
  have hB : W'.comap (V.subtype.comp m.toMonoidHom) = fixedSubgroup r := by
    apply eq_of_le_of_card_ge (intersection_fixed V W' q m he r hrmem)
    rw [card_pullback,hcard',hcr]
  apply eq_top_of_kernel_image q (W ⊔ W')
  · rw [hk]
    exact sup_le (core_le_join_of_fixed_pair V W W' m p r hA hB hspan)
      (hCW.trans le_sup_left)
  · apply le_antisymm (map_le_range _ _)
    rw [hr, ← hgen]
    apply (closure_le _).mpr
    intro x hx
    rcases hx with rfl | hx
    · exact (map_mono (show W ≤ W ⊔ W' from le_sup_left)) hp
    · have hx : x = r := hx
      rw [hx]
      exact (map_mono (show W' ≤ W ⊔ W' from le_sup_right)) hrmem


private theorem proper_image_card (A : Subgroup Perm) (hle : A ≤ pairClosure)
    (hne : A ≠ ⊥) (hproper : A ≠ pairClosure) : Nat.card A = 2 := by
  have hd : Nat.card A ∣ 4 := card_pairClosure ▸ card_dvd_of_le hle
  have hp : 0 < Nat.card A := Nat.card_pos
  have hbound : Nat.card A ≤ 4 := Nat.le_of_dvd (by decide) hd
  have hne1 : Nat.card A ≠ 1 := fun h => hne (card_eq_one.mp h)
  have hne4 : Nat.card A ≠ 4 := by
    intro h
    exact hproper (eq_of_le_of_card_ge hle (by rw [card_pairClosure,h]))
  interval_cases hc : Nat.card A <;> norm_num at *

/-- Either the core and its abelian partner generate, or exchanging the two
transposition images makes two conjugate partners generate. -/
public theorem generation {S : Type*} [Group S] [Finite S]
    (V C W : Subgroup S) [IsMulCommutative W]
    (hd : Disjoint V C) (hCW : C ≤ W)
    (hW : Nat.card W = Nat.card (V ⊔ C : Subgroup S))
    (q : S →* Perm) (hr : q.range = pairClosure)
    (hk : q.ker = V ⊔ C) (hWq : W.map q ≠ ⊥)
    (m : U ≃* V)
    (he : ∀ (s : S) (x : Space),
      (m (.ofAdd (coreRepresentation (Fin 5) (q s) x)) : S) =
        s * (m (.ofAdd x) : S) * s⁻¹)
    (e : S ≃* S) (heV : V.map e.toMonoidHom = V)
    (k : Perm) (heq : ∀ s, q (e s) = k * q s * k⁻¹)
    (hkN : k ∈ normalizer (pairClosure : Set Perm)) (hkout : k ∉ pairClosure) :
    V ⊔ C ⊔ W = ⊤ ∨ W ⊔ W.map e.toMonoidHom = ⊤ := by
  classical
  obtain ⟨hka,hkb⟩ := pairNormalizer_outside_exchanges k hkN hkout
  by_cases hfull : W.map q = pairClosure
  · left
    apply eq_top_of_kernel_image q (V ⊔ C ⊔ W)
    · rw [hk]
      exact le_sup_left
    · rw [Subgroup.map_sup, ← hk, map_ker_self, bot_sup_eq, hfull,hr]
  · right
    let : V.Normal := core_normal V q m he
    have hcard : Nat.card (W ⊓ V : Subgroup S) = 8 :=
      card_intersection V C W hd hCW q hk
        ((Nat.card_congr m.toEquiv).symm.trans core_card) hW
        (proper_image_card (W.map q) (hr ▸ map_le_range q W) hWq hfull)
    obtain ⟨⟨p,hp⟩,hpne'⟩ := (Subgroup.ne_bot_iff_exists_ne_one).mp hWq
    have hpne : p ≠ 1 := fun h => hpne' (Subtype.ext h)
    have hpin : p ∈ pairClosure := hr ▸ (map_le_range q W hp)
    rcases (mem_pairClosure p).mp hpin with hid | ha | hb | hab
    · exact (hpne hid).elim
    · subst p
      exact fixed_pair_generation V C W q hr hk hCW m he e heV k heq hcard
        first second hp hka card_fixed_first card_fixed_second
        fixed_first_sup_fixed_second rfl
    · subst p
      exact fixed_pair_generation V C W q hr hk hCW m he e heV k heq hcard
        second first hp hkb card_fixed_second card_fixed_first
        (by rw [sup_comm]; exact fixed_first_sup_fixed_second)
        (by rw [Set.pair_comm])
    · subst p
      have hb := card_le_of_le (intersection_fixed V W q m he (first*second) hp)
      rw [card_pullback,hcard,card_fixed_product] at hb
      omega

end FiveCoreConjugateGeneration
