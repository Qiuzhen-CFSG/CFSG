module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# Cubic automorphisms and their invariant lines

An automorphism of a group of order three is the identity or inversion.
If a finite abelian group is generated by two cubic subgroups, an
automorphism fixing the first and inverting the second has no other
invariant cubic subgroup. Multiplying an element by its image isolates
the square of its first component; cubing recovers that component.

Source application: Aschbacher–Smith, combined manuscript of 1 March 2004,
13.8.21(1), printed p.957, distinguishing the two marked residual directions.
-/

@[expose] public section
open Subgroup
namespace Theory.GroupTheory.CubicAutomorphismLines
private theorem three_maps :
    ∀ f : Multiplicative (ZMod 3) → Multiplicative (ZMod 3),
      Function.Injective f → f 1 = 1 →
      (∀ x, f x = x) ∨ (∀ x, f x = x⁻¹) := by decide

/-- Every cubic automorphism is the identity or inversion. -/
theorem automorphism_eq_one_or_inv {Q : Type*} [Group Q]
    (hQ : Nat.card Q = 3) (a : MulAut Q) : a = 1 ∨ ∀ x, a x = x⁻¹ := by
  let e : Q ≃* Multiplicative (ZMod 3) := mulEquivOfPrimeCardEq hQ (Nat.card_zmod 3)
  let f : Multiplicative (ZMod 3) → Multiplicative (ZMod 3) := fun x => e (a (e.symm x))
  have hi : Function.Injective f := e.injective.comp (a.injective.comp e.symm.injective)
  have h1 : f 1 = 1 := by simp [f]
  rcases three_maps f hi h1 with hf | hf
  · left
    ext x
    apply e.injective
    simpa [f] using hf (e x)
  · right
    intro x
    apply e.injective
    simpa [f] using hf (e x)
variable {Q : Type*} [CommGroup Q] [Finite Q]

/-- A fixed cubic direction and an inverted cubic direction exhaust invariant lines. -/
theorem invariant_line_eq (Z X C : Subgroup Q)
    (hZ : Nat.card Z = 3) (hX : Nat.card X = 3) (hC : Nat.card C = 3)
    (hgen : Z ⊔ X = ⊤) (a : MulAut Q)
    (hfix : ∀ z ∈ Z, a z = z) (hinv : ∀ x ∈ X, a x = x⁻¹)
    (hstable : ∀ c ∈ C, a c ∈ C) : C = Z ∨ C = X := by
  have project (c : Q) (hc : c ∈ C) :
      ∃ z ∈ Z, ∃ x ∈ X, z ∈ C ∧ x ∈ C ∧ z * x = c := by
    have hg : c ∈ Z ⊔ X := hgen.symm ▸ mem_top c
    obtain ⟨z, hz, x, hx, he⟩ := mem_sup_of_normal_right.mp hg
    have he' : a c = z * x⁻¹ := by rw [← he, map_mul, hfix z hz, hinv x hx]
    have hzz : z ^ 2 ∈ C := by
      have hh := C.mul_mem hc (hstable c hc)
      rw [he', ← he] at hh
      simpa only [mul_mul_mul_comm z x z x⁻¹, mul_inv_cancel, mul_one, ← pow_two] using hh
    have hz3 : z ^ 3 = 1 := by
      have hh := pow_card_eq_one' (x := (⟨z, hz⟩ : Z))
      rw [hZ] at hh
      exact congrArg Subtype.val hh
    have hzC : z ∈ C := by
      have hh := C.pow_mem hzz 2
      have heq : (z ^ 2) ^ 2 = z := by
        rw [← pow_mul]
        change z ^ (3 + 1) = z
        rw [pow_succ, hz3, one_mul]
      rwa [heq] at hh
    have hxC : x ∈ C := by
      have hh := C.mul_mem (C.inv_mem hzC) hc
      rwa [← he, inv_mul_cancel_left] at hh
    exact ⟨z, hz, x, hx, hzC, hxC, he⟩
  have primeC : Fact (Nat.card C).Prime := ⟨hC ▸ Nat.prime_three⟩
  let := primeC
  rcases ((C ⊓ Z).subgroupOf C).eq_bot_or_eq_top_of_prime_card with hb | ht
  · right
    apply eq_of_le_of_card_ge
    · intro c hc
      obtain ⟨z, hz, x, hx, hzC, _, he⟩ := project c hc
      have hzbot : (⟨z, hzC⟩ : C) ∈ ((C ⊓ Z).subgroupOf C) := ⟨hzC, hz⟩
      rw [hb, mem_bot] at hzbot
      have hz1 : z = 1 := congrArg Subtype.val hzbot
      rw [hz1, one_mul] at he
      exact he ▸ hx
    · omega
  · left
    apply eq_of_le_of_card_ge
    · intro c hc
      have : (⟨c, hc⟩ : C) ∈ ((C ⊓ Z).subgroupOf C) := ht.symm ▸ mem_top _
      exact this.2
    · omega
end Theory.GroupTheory.CubicAutomorphismLines
