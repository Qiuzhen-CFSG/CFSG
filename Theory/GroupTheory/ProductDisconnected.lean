module

public import Theory.GroupTheory.Involution.Basic
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Product-disconnected sets of involutions

An invariant set of involutions is product-disconnected relative to a proper
subgroup when its involutions in that subgroup have unique conjugate membership,
and centralizers of involutions which are products from the set stay in the
subgroup. The two factors in the product condition need not lie in the subgroup.

This is Definition ZD in Gorenstein--Lyons--Solomon, *The Classification of the
Finite Simple Groups*, Volume 4, Chapter 2, p. 20. Conjugation uses `g * z * g⁻¹`;
replacing every conjugator by its inverse gives the source convention.
-/

namespace Theory.GroupTheory

open BenderSuzuki.PFAppendixIII

variable {G : Type*} [Group G]

/-- Definition ZD of GLS, Volume 4, Chapter 2. -/
public structure IsProductDisconnected (Z : Set G) (M : Subgroup G) : Prop where
  involutions : ∀ z ∈ Z, IsInvolution z
  invariant : ∀ g z : G, z ∈ Z → MulAut.conj g z ∈ Z
  proper : M ≠ ⊤
  nonempty : (Z ∩ (M : Set G)).Nonempty
  conjugate_mem_iff : ∀ z ∈ Z, z ∈ M → ∀ g : G,
    MulAut.conj g z ∈ M ↔ g ∈ M
  product_centralizer : ∀ x ∈ Z, ∀ z ∈ Z,
    IsInvolution (x * z) → x * z ∈ M →
      Subgroup.centralizer ({x * z} : Set G) ≤ M

/-- A member of the distinguished set in `M` has its centralizer in `M`. -/
public theorem IsProductDisconnected.centralizer_le {Z : Set G} {M : Subgroup G}
    (h : IsProductDisconnected Z M) {z : G} (hz : z ∈ Z) (hzM : z ∈ M) :
    Subgroup.centralizer ({z} : Set G) ≤ M := by
  intro g hg
  apply (h.conjugate_mem_iff z hz hzM g).mp
  have hc := Subgroup.mem_centralizer_singleton_iff.mp hg
  simpa only [MulAut.conj_apply, hc, mul_assoc, mul_inv_cancel, mul_one] using hzM

/-- The subgroup generated by a product-disconnected set is not contained in
its distinguished proper subgroup. -/
public theorem IsProductDisconnected.closure_not_le {Z : Set G} {M : Subgroup G}
    (h : IsProductDisconnected Z M) : ¬ Subgroup.closure Z ≤ M := by
  intro hle
  obtain ⟨z, hz, hzM⟩ := h.nonempty
  apply h.proper
  apply top_unique
  intro g _
  exact (h.conjugate_mem_iff z hz hzM g).mp
    (hle (Subgroup.subset_closure (h.invariant g z hz)))

/-- Invariance makes the generated subgroup normal in the ambient group. -/
public theorem IsProductDisconnected.closure_normal {Z : Set G} {M : Subgroup G}
    (h : IsProductDisconnected Z M) : (Subgroup.closure Z).Normal := by
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_unique
  apply Subgroup.le_normalizer_closure_iff.mpr
  intro g _ z hz
  exact Subgroup.subset_closure (h.invariant g z hz)

end Theory.GroupTheory
