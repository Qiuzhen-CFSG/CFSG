module
public import Theory.GroupTheory.SelfCentralizingFourSymmetricFour
public import Theory.GroupTheory.PResidual.Quotient
public import Theory.PGroupCore

/-! A normal elementary four in an order-twenty-four group is self-centralizing
when it contains the two-core and is generated by commutators with the
two-residual. This identifies the actual parabolic automizer as S₄.
Source: Aschbacher–Smith 14.3.19. -/

public section
open Subgroup
open scoped IsMulCommutative
theorem symmetricFour_of_residual_generated_four {X:Type*} [Group X] [Finite X] (U:Subgroup X) [U.Normal]
    [IsElementaryAbelian 2 U] (hU:Nat.card U=4) (hX:Nat.card X=24)
    (hcore:pCore 2 X≤U) (hcomm:⁅U,pResidual 2 X⁆=U) :
    Nonempty (X≃*Equiv.Perm (Fin 4)) := by
  apply mulEquiv_perm_four_of_selfCentralizing_four_card_twentyfour U hU _ hX
  let C:=centralizer (U:Set X)
  have hUC:U≤C := U.le_centralizer
  have hd:Nat.card C∣24 := hX ▸ C.card_subgroup_dvd_card
  have h4:4∣Nat.card C := hU ▸ card_dvd_of_le hUC
  have hcases:Nat.card C=4 ∨ Nat.card C=8 ∨ Nat.card C=12 ∨ Nat.card C=24 := by
    have hh:=Nat.mem_divisors.mpr ⟨hd,by decide⟩
    have he:(24:ℕ).divisors={1,2,3,4,6,8,12,24} := by decide
    rw [he] at hh
    simp only [Finset.mem_insert,Finset.mem_singleton] at hh
    omega
  rcases hcases with hc|hc|hc|hc
  · exact (eq_of_le_of_card_ge hUC (by omega)).ge
  · have hp:IsPGroup 2 C := IsPGroup.of_card (n:=3) hc
    exact (show C≤pCore 2 X from le_sSup ⟨inferInstance,hp⟩).trans hcore
  all_goals
    have hind:C.index=2 ∨ C.index=1 := by
      have hh:=C.index_mul_card
      rw [hX,hc] at hh
      omega
    have hquot:IsPGroup 2 (X⧸C) := by
      rcases hind with hi|hi
      · exact IsPGroup.of_card (n:=1) (by simpa only [C.index_eq_card,pow_one,pow_zero] using hi)
      · exact IsPGroup.of_card (n:=0) (by simpa only [C.index_eq_card,pow_one,pow_zero] using hi)
    have hres:pResidual 2 X≤C := (pResidual_le_iff_isPGroup_quotient 2 C).mpr hquot
    have hb:U≤⊥ := by
      rw [←hcomm]
      have hzero:⁅U,C⁆=⊥ := by
        rw [commutator_comm]
        exact commutator_eq_bot_iff_le_centralizer.mpr le_rfl
      exact (commutator_mono le_rfl hres).trans hzero.le
    have hu1:Nat.card U=1 := by rw [le_antisymm hb bot_le];simp
    omega
