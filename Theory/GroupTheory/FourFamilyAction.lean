module
public import Theory.GroupTheory.DihedralRelations
public import Theory.ElementaryAbelian.Basic
public import Mathlib.GroupTheory.PGroup
public import Mathlib.GroupTheory.Perm.Fin
/-!
# Explicit four-point two-subgroup alternatives

The subgroup generated by two disjoint pair swaps is a nonregular Klein four.
A two-subgroup of the four-point permutation group containing these swaps
is either this Klein four or the full dihedral group of order eight. The proof
uses small finite permutation certificates and the odd-order power obstruction.

Source application: Aschbacher--Smith C.6.1, printed p.165, case (beta).
-/

public section
open Subgroup
namespace Theory.GroupTheory.FourFamilyAction
abbrev Perm := Equiv.Perm (Fin 4)
@[expose] def leftSwap : Perm := Equiv.swap 0 1
@[expose] def rightSwap : Perm := Equiv.swap 2 3
@[expose] def crossSwap : Perm := Equiv.swap 0 2 * Equiv.swap 1 3
@[expose] def word (i : Fin 4) : Perm := ![1,leftSwap,rightSwap,leftSwap*rightSwap] i
@[expose] def doubleWord (i : Fin 8) : Perm :=
  ![1,leftSwap,rightSwap,leftSwap*rightSwap,crossSwap,leftSwap*crossSwap,
    rightSwap*crossSwap,(leftSwap*rightSwap)*crossSwap] i

@[expose] def pairGroup : Subgroup Perm where
  carrier := {p | ∃ i, word i = p}
  one_mem' := ⟨0,rfl⟩
  mul_mem' := by
    rintro p q ⟨i,rfl⟩ ⟨j,rfl⟩
    exact (by decide +kernel : ∀ i j, ∃ k, word k = word i * word j) i j
  inv_mem' := by
    rintro p ⟨i,rfl⟩
    exact (by decide +kernel : ∀ i, ∃ j, word j = (word i)⁻¹) i

@[expose] def fullGroup : Subgroup Perm where
  carrier := {p | ∃ i, doubleWord i = p}
  one_mem' := ⟨0,rfl⟩
  mul_mem' := by
    rintro p q ⟨i,rfl⟩ ⟨j,rfl⟩
    exact (by decide +kernel : ∀ i j, ∃ k, doubleWord k = doubleWord i * doubleWord j) i j
  inv_mem' := by
    rintro p ⟨i,rfl⟩
    exact (by decide +kernel : ∀ i, ∃ j, doubleWord j = (doubleWord i)⁻¹) i

@[expose] def model : DihedralGroup 4 →* Perm :=
  DihedralRelations.ofRelations (leftSwap*crossSwap) leftSwap
    (by decide +kernel) (by decide +kernel) (by decide +kernel)

theorem model_injective : Function.Injective model := by decide +kernel

theorem model_range : model.range = fullGroup := by
  ext p
  exact (by decide +kernel : ∀ p, (∃ d, model d = p) ↔ ∃ i, doubleWord i = p) p

theorem fullGroup_dihedral : Nonempty (fullGroup ≃* DihedralGroup 4) := by
  exact ⟨(MulEquiv.subgroupCongr model_range.symm).trans (MonoidHom.ofInjective model_injective).symm⟩

theorem twoGroup_le_fullGroup (P : Subgroup Perm) (hP : IsPGroup 2 P)
    (ha : leftSwap ∈ P) (hb : rightSwap ∈ P) : P ≤ fullGroup := by
  intro p hp
  have hf : ∀ p : Perm, (∃ i, doubleWord i = p) ∨
      ((leftSwap*(p*leftSwap*p⁻¹))^3 = 1 ∧ leftSwap*(p*leftSwap*p⁻¹) ≠ 1) ∨
      ((leftSwap*(p*rightSwap*p⁻¹))^3 = 1 ∧ leftSwap*(p*rightSwap*p⁻¹) ≠ 1) := by
    decide +kernel
  have hodd (g : Perm) (hg : g ∈ P) (h3 : g^3 = 1) : g = 1 := by
    have hh : (⟨g,hg⟩ : P)^3 = 1 := Subtype.ext h3
    have he := (hP.powEquiv (by decide : Nat.Coprime 2 3)).injective
      (show ((⟨g,hg⟩ : P)^3) = (1 : P)^3 by simpa using hh)
    exact congrArg Subtype.val he
  rcases hf p with hm | ⟨h3,hne⟩ | ⟨h3,hne⟩
  · exact hm
  · exact (hne (hodd _ (P.mul_mem ha (P.mul_mem (P.mul_mem hp ha) (P.inv_mem hp))) h3)).elim
  · exact (hne (hodd _ (P.mul_mem ha (P.mul_mem (P.mul_mem hp hb) (P.inv_mem hp))) h3)).elim

theorem pair_or_full (P : Subgroup Perm) (hP : IsPGroup 2 P)
    (ha : leftSwap ∈ P) (hb : rightSwap ∈ P) : P = pairGroup ∨ P = fullGroup := by
  have hle := twoGroup_le_fullGroup P hP ha hb
  have hpair : pairGroup ≤ P := by
    rintro p ⟨i,rfl⟩
    fin_cases i
    · exact P.one_mem
    · exact ha
    · exact hb
    · exact P.mul_mem ha hb
  by_cases he : P ≤ pairGroup
  · exact Or.inl (le_antisymm he hpair)
  · obtain ⟨p,hp,hout⟩ := SetLike.not_le_iff_exists.mp he
    have hc : crossSwap ∈ P := by
      obtain ⟨i,hi⟩ := hle hp
      have hx : ∀ i : Fin 8,
          (∃ j, word j = doubleWord i) ∨ ∃ j, word j * doubleWord i = crossSwap := by decide +kernel
      rcases hx i with ⟨j,hj⟩ | ⟨j,hj⟩
      · exact (hout (show p ∈ pairGroup from ⟨j,hj.trans hi⟩)).elim
      · rw [hi] at hj
        exact hj ▸ P.mul_mem (hpair ⟨j,rfl⟩) hp
    right
    apply le_antisymm hle
    rintro p ⟨i,rfl⟩
    fin_cases i
    · exact P.one_mem
    · exact ha
    · exact hb
    · exact P.mul_mem ha hb
    · exact hc
    · exact P.mul_mem ha hc
    · exact P.mul_mem hb hc
    · exact P.mul_mem (P.mul_mem ha hb) hc

end Theory.GroupTheory.FourFamilyAction
