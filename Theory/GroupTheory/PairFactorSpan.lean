module
public import Theory.GroupTheory.PairFactorAction
public import Mathlib.Data.Fintype.EquivFin
/-!
# Products off the coordinate axes generate the product

For two disjoint commuting factors of order greater than two, every
single-factor element is a product of two elements with both coordinates
nonidentity. Hence any subgroup containing all such products contains
both factors. This gives the Δ-generation step in Aschbacher–Smith
2.4.20(4), printed p.535.
-/
public section
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

private theorem exists_other_of_card_gt_two (Z : Subgroup G) (hZ : 2 < Nat.card Z) (z : Z) :
    ∃ a : Z, a ≠ 1 ∧ a ≠ z := by
  classical
  let := Fintype.ofFinite Z
  have hh : ({1,z} : Finset Z).card < (Finset.univ : Finset Z).card := by
    have hp : ({1,z} : Finset Z).card ≤ 2 := by
      by_cases hz : (1 : Z)=z <;> simp [hz]
    simpa only [Finset.card_univ,←Nat.card_eq_fintype_card] using lt_of_le_of_lt hp hZ
  obtain ⟨a,_,ha⟩ := Finset.exists_mem_notMem_of_card_lt_card hh
  exact ⟨a,by simpa only [Finset.mem_insert,Finset.mem_singleton,not_or] using ha⟩

/-- A product of two groups of order greater than two is generated by
those products with both coordinates nonidentity. -/
theorem sup_le_of_complement_of_axes_le (Z W K : Subgroup G)
    (hZW : Disjoint Z W) (hWZ : W ≤ centralizer (Z : Set G))
    (hZ : 2 < Nat.card Z) (hW : 2 < Nat.card W)
    (hK : ∀ u ∈ Z ⊔ W, u ∉ Z → u ∉ W → u ∈ K) : Z ⊔ W ≤ K := by
  have hm (a b : G) (ha : a ∈ Z) (ha1 : a ≠ 1) (hb : b ∈ W) (hb1 : b ≠ 1) : a*b ∈ K := by
    apply hK _ ((Z ⊔ W).mul_mem ((show Z ≤ Z ⊔ W from le_sup_left) ha)
      ((show W ≤ Z ⊔ W from le_sup_right) hb))
    · intro hab
      have hbZ : b ∈ Z := by simpa only [inv_mul_cancel_left] using Z.mul_mem (Z.inv_mem ha) hab
      exact hb1 (disjoint_def.mp hZW hbZ hb)
    · intro hab
      have haW : a ∈ W := by simpa only [mul_inv_cancel_right] using W.mul_mem hab (W.inv_mem hb)
      exact ha1 (disjoint_def.mp hZW ha haW)
  have side (A B : Subgroup G) (hA : 2 < Nat.card A) (hB : 2 < Nat.card B)
      (hBA : B ≤ centralizer (A : Set G))
      (hmul : ∀ a ∈ A, a ≠ 1 → ∀ b ∈ B, b ≠ 1 → a*b ∈ K) : A ≤ K := by
    intro z hz
    obtain ⟨a,ha1,haz⟩ := exists_other_of_card_gt_two A hA ⟨z,hz⟩
    obtain ⟨b,hb1,_⟩ := exists_other_of_card_gt_two B hB 1
    have ha1' : (a:G) ≠ 1 := fun he => ha1 (Subtype.ext he)
    have hb1' : (b:G) ≠ 1 := fun he => hb1 (Subtype.ext he)
    have hc1 : (a:G)⁻¹*z ≠ 1 := by
      intro he
      exact haz (Subtype.ext (inv_mul_eq_one.mp he))
    have h1 := hmul a a.property ha1' b b.property hb1'
    have h2 := hmul ((a:G)⁻¹*z) (A.mul_mem (A.inv_mem a.property) hz) hc1
      (b:G)⁻¹ (B.inv_mem b.property) (inv_ne_one.mpr hb1')
    have hc : (b:G)*((a:G)⁻¹*z)=((a:G)⁻¹*z)*(b:G) :=
      ((mem_centralizer_iff.mp (hBA b.property)) _ (A.mul_mem (A.inv_mem a.property) hz)).symm
    have he : ((a:G)*(b:G))*(((a:G)⁻¹*z)*(b:G)⁻¹)=z := by
      calc
        ((a:G)*(b:G))*(((a:G)⁻¹*z)*(b:G)⁻¹) = (a:G)*((b:G)*((a:G)⁻¹*z))*(b:G)⁻¹ := by group
        _ = z := by rw [hc]; group
    exact he ▸ K.mul_mem h1 h2
  refine sup_le (side Z W hZ hW hWZ (fun a ha ha1 b hb hb1 => hm a b ha ha1 hb hb1)) ?_
  apply side W Z hW hZ (le_centralizer_iff.mp hWZ)
  intro a ha ha1 b hb hb1
  have hh := hm b a hb hb1 ha ha1
  rwa [(mem_centralizer_iff.mp (hWZ ha)) b hb] at hh
end Subgroup
