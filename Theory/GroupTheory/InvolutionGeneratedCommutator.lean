module

public import Theory.GroupTheory.Commutator.NormalClosure

/-!
# Commutator bounds for the subgroup generated by involutions

Write `involutionGenerated Q` for the subgroup generated by the elements of
`Q` whose square is one. Including the identity does not change the subgroup
generated by the involutions. This construction is monotone and preserved by
normalizers. If `Q` and `Z` are normal, a bound on `[V, S]`, where `S` contains
the involutions of an overgroup of `Q`, extends to `[V^G, involutionGenerated Q]`.

The proof uses the universal property of subgroup closure and the existing
normal-closure commutator lemma. Applied inside `H`, this is the group-theoretic
argument in Aschbacher--Smith, *The Classification of Quasithin Groups*,
combined manuscript (1 March 2004), Lemma 15.2.28, printed p. 1119.
-/

namespace Subgroup

variable {G : Type*} [Group G]

/-- The subgroup generated by the involutions of `Q`. -/
@[expose] public def involutionGenerated (Q : Subgroup G) : Subgroup G :=
  closure {x : G | x ∈ Q ∧ x ^ 2 = 1}

/-- The involution-generated subgroup is contained in its original subgroup. -/
public theorem involutionGenerated_le (Q : Subgroup G) : involutionGenerated Q ≤ Q :=
  (closure_le _).mpr fun _ hx => hx.1

/-- Inclusion of subgroups preserves their involution-generated subgroups. -/
public theorem involutionGenerated_mono {Q T : Subgroup G} (hQT : Q ≤ T) :
    involutionGenerated Q ≤ involutionGenerated T :=
  closure_mono fun _ hx => ⟨hQT hx.1, hx.2⟩

/-- It suffices to contain all square-one elements to contain their generated subgroup. -/
public theorem involutionGenerated_le_iff (Q S : Subgroup G) :
    involutionGenerated Q ≤ S ↔ ∀ x ∈ Q, x ^ 2 = 1 → x ∈ S := by
  rw [involutionGenerated, closure_le]
  exact ⟨fun h x hx hx2 => h ⟨hx, hx2⟩, fun h x hx => h x hx.1 hx.2⟩

/-- Every normalizer of `Q` preserves the subgroup generated by its involutions. -/
public theorem normalizer_le_normalizer_involutionGenerated (Q : Subgroup G) :
    normalizer (Q : Set G) ≤ normalizer (involutionGenerated Q : Set G) := by
  apply le_normalizer_closure_iff.mpr
  intro g hg x hx
  apply subset_closure
  refine ⟨(mem_normalizer_iff.mp hg x).mp hx.1, ?_⟩
  simpa only [map_pow, map_one, MulAut.conj_apply] using
    congrArg (MulAut.conj g) hx.2

public instance involutionGenerated_normal (Q : Subgroup G) [Q.Normal] :
    (involutionGenerated Q).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_le_iff.mp
  exact (show (⊤ : Subgroup G) ≤ normalizer (Q : Set G) by
    rw [normalizer_eq_top]).trans
      (normalizer_le_normalizer_involutionGenerated Q)

/-- A commutator bound against an involution-containing subgroup extends to
the normal closure of `V`. The ambient group may in particular be a local
subgroup `H`, with `Q = O₂(H)` and `Z` an `H`-normal subgroup. -/
public theorem normalClosure_commutator_involutionGenerated_le
    (V Q T S Z : Subgroup G) [Q.Normal] [Z.Normal]
    (hQT : Q ≤ T) (hTS : ∀ x ∈ T, x ^ 2 = 1 → x ∈ S)
    (hcomm : ⁅V, S⁆ ≤ Z) :
    ⁅normalClosure (V : Set G), involutionGenerated Q⁆ ≤ Z := by
  have hQS : involutionGenerated Q ≤ S :=
    (involutionGenerated_mono hQT).trans ((involutionGenerated_le_iff T S).mpr hTS)
  rw [commutator_comm]
  apply commutator_normalClosure_le_of_normal
  rw [commutator_comm]
  exact (commutator_mono le_rfl hQS).trans hcomm

end Subgroup
