module

public import Mathlib.Algebra.Group.Subgroup.Map
public import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.Tactic.Group

/-!
# Lifting generation by a conjugate pair through its actual kernel

If a homomorphism kernel normalizes A, every conjugate of A already lies
in any subgroup containing A with the full image. Thus a conjugate pair
that generates the original group also lifts generation by any such image.

Source application: the single-element generation argument after
Aschbacher--Smith12.7.18, printed p.845.
-/

public section
namespace Subgroup
variable {G H : Type*} [Group G] [Group H]

/-- Full image plus normalization of the seed by the actual kernel lifts
single-element generation in a group generated by two conjugate seeds. -/
theorem eq_top_of_conjugate_pair_image (f : G →* H) (A J : Subgroup G) (g : G)
    (hgen : A ⊔ A.map (MulAut.conj g).toMonoidHom = ⊤)
    (hAJ : A ≤ J) (hker : f.ker ≤ normalizer (A : Set G))
    (himage : J.map f = f.range) : J = ⊤ := by
  apply top_unique
  rw [← hgen]
  apply sup_le hAJ
  rintro _ ⟨x,hx,rfl⟩
  have hg : f g ∈ J.map f := himage.symm ▸ ⟨g,rfl⟩
  obtain ⟨j,hj,hjg⟩ := hg
  have hk : j⁻¹ * g ∈ f.ker := by
    change f (j⁻¹ * g) = 1
    rw [map_mul,map_inv,hjg,inv_mul_cancel]
  have hx' := (mem_normalizer_iff.mp (hker hk) x).mp hx
  have hh := J.mul_mem (J.mul_mem hj (hAJ hx')) (J.inv_mem hj)
  change g * x * g⁻¹ ∈ J
  convert hh using 1
  group

end Subgroup
