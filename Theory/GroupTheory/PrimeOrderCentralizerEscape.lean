module
public import Theory.GroupTheory.PrimeOrderClosure

/-!
# A normalizer detected by two prime-order centralizers

Let K be generated by its elements of order p. If K centralizes Z and
its conjugate Z^g, the two prime-order centralizer identities place K in
K^g. Finiteness turns this inclusion into equality. Thus an element g
outside M witnesses that N_G(K) is not contained in M.

The application is the second normalizer in Aschbacher--Smith 14.6.15,
printed p.1034. The centralizer identities are genuine premises here;
their construction uses the source module decomposition.
-/

public section
namespace Subgroup
variable {G H : Type*} [Group G] [Group H]

/-- The subgroup generated by elements of a specified order transports
through the same isomorphism as the original subgroup. -/
theorem map_primeOrderClosure_equiv (p : ℕ) (A : Subgroup G) (e : G ≃* H) :
    (closure {x : G | x ∈ A ∧ orderOf x = p}).map e.toMonoidHom =
      closure {x : H | x ∈ A.map e.toMonoidHom ∧ orderOf x = p} := by
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y,⟨hy,ho⟩,rfl⟩
    exact ⟨mem_map_of_mem _ hy,(e.orderOf_eq y).trans ho⟩
  · rintro ⟨⟨y,hy,rfl⟩,ho⟩
    exact ⟨y,⟨hy,(e.orderOf_eq y).symm.trans ho⟩,rfl⟩

private theorem map_centralizer_equiv (A : Subgroup G) (e : G ≃* H) :
    (centralizer (A : Set G)).map e.toMonoidHom =
      centralizer (A.map e.toMonoidHom : Set H) := by
  apply le_antisymm
  · rintro _ ⟨x,hx,rfl⟩ _ ⟨y,hy,rfl⟩
    exact (map_mul e y x).symm.trans ((congrArg e (hx y hy)).trans (map_mul e x y))
  · intro x hx
    refine ⟨e.symm x,?_,e.apply_symm_apply x⟩
    intro y hy
    apply e.injective
    simpa only [map_mul,e.apply_symm_apply] using hx (e y) (mem_map_of_mem _ hy)

/-- Two literal centralizer identities force the original element to
normalize K. No independent conjugator is chosen in this argument. -/
theorem mem_normalizer_of_primeOrder_centralizers [Finite G]
    (p : ℕ) (Z Kz K W : Subgroup G) (g : G)
    (hgen : closure {x : G | x ∈ K ∧ orderOf x = p} = K)
    (hKZ : K ≤ centralizer (Z : Set G))
    (hpoint : Z.map (MulAut.conj g).toMonoidHom ≤ W)
    (hWC : W ≤ centralizer (K : Set G))
    (hwhole : closure {x : G | x ∈ centralizer (Z : Set G) ∧ orderOf x = p} = Kz)
    (hsection : closure {x : G |
      x ∈ Kz.map (MulAut.conj g).toMonoidHom ⊓ centralizer (Z : Set G) ∧
        orderOf x = p} = K.map (MulAut.conj g).toMonoidHom) :
    g ∈ normalizer (K : Set G) := by
  have hc : K ≤ centralizer (Z.map (MulAut.conj g).toMonoidHom : Set G) :=
    le_centralizer_iff.mp (hpoint.trans hWC)
  have htransport : closure {x : G |
      x ∈ centralizer (Z.map (MulAut.conj g).toMonoidHom : Set G) ∧ orderOf x = p} =
        Kz.map (MulAut.conj g).toMonoidHom := by
    rw [←map_centralizer_equiv Z (MulAut.conj g),
      ←map_primeOrderClosure_equiv,hwhole]
  have hKKz : K ≤ Kz.map (MulAut.conj g).toMonoidHom := by
    rw [←hgen,←htransport]
    exact closure_mono (fun _ hx => ⟨hc hx.1,hx.2⟩)
  have hKKg : K ≤ K.map (MulAut.conj g).toMonoidHom := by
    calc
      K = closure {x : G | x ∈ K ∧ orderOf x = p} := hgen.symm
      _ ≤ closure {x : G |
          x ∈ Kz.map (MulAut.conj g).toMonoidHom ⊓ centralizer (Z : Set G) ∧
            orderOf x = p} :=
        closure_mono (fun _ hx => ⟨⟨hKKz hx.1,hKZ hx.1⟩,hx.2⟩)
      _ = K.map (MulAut.conj g).toMonoidHom := hsection
  apply mem_normalizer_iff_map_conj_eq.mpr
  apply (eq_of_le_of_card_ge hKKg ?_).symm
  rw [card_map_of_injective (MulAut.conj g).injective]

end Subgroup
