module
public import Theory.GroupTheory.Hall.TwoClosedNormal
public import Mathlib.Algebra.Group.PUnit
public import Mathlib.GroupTheory.IndexNormal
/-!
# A joint odd Hall subgroup for conjugate normalized products

Let S have index two in T, let R≤S be a T-invariant two-group, and let an
odd solvable D normalize R. Assume S normalizes RD and each outside
conjugate Dˣ normalizes RD. Then RDDˣ is solvable, normal under T and has
Sylow subgroup R. Hall existence supplies a Hall subgroup B containing D;
Hall conjugacy gives T=R N_T(B), so x can be chosen outside S in N_T(B).
The resulting B is generated by D and Dˣ, both normal in B.

The proofs keep all subgroups and normalizers in the original ambient
group. The actual source application is the single natural-block branch
of Aschbacher–Smith 2.4.8(5), printed p.530. Abelianity and the common
fixed subgroup are separate subsequent steps.
-/

public section
open Subgroup
open scoped Pointwise
namespace Subgroup.OddHall
variable {G : Type*} [Group G] [Finite G]

theorem exists_hall_containing_odd (K D : Subgroup G)
    (hsolv : Group.IsSolvable K) (hDK : D ≤ K) (ho : Odd (Nat.card D)) :
    ∃ B : Subgroup G, D ≤ B ∧ B ≤ K ∧ IsHallSubgroup oddPrimes (B.subgroupOf K) := by
  let _ : MulDistribMulAction Unit K := {
    smul _ x := x
    one_smul _ := rfl
    mul_smul _ _ _ := rfl
    smul_one _ := rfl
    smul_mul _ _ _ := rfl }
  have hp : IsPiSubgroup oddPrimes (D.subgroupOf K) := by
    intro p hp he
    have hc := Nat.card_congr (subgroupOfEquivOfLe hDK).toEquiv
    have hd : 2 ∣ Nat.card D := by rwa [hc,show p.val = 2 from he] at hp
    exact (Nat.not_even_iff_odd.mpr ho) (even_iff_two_dvd.mpr hd)
  obtain ⟨B,hB,_,hDB⟩ := exists_isHallSubgroup_isInvariant_of_isPiSubgroup
    (A := Unit) hsolv (by simp) oddPrimes (D.subgroupOf K) hp
    (⟨fun _ _ => Iff.rfl⟩ : IsInvariant Unit K (D.subgroupOf K))
  refine ⟨B.map K.subtype,?_,map_subtype_le _,?_⟩
  · have hh := map_mono (f := K.subtype) hDB
    rwa [map_subgroupOf_eq_of_le hDK] at hh
  · simpa only [subgroupOf,comap_map_eq_self_of_injective K.subtype_injective] using hB

theorem normal_sylow_frattini (K R T B : Subgroup G)
    (hsolv : Group.IsSolvable K) (hRT : R ≤ T)
    (hTK : T ≤ normalizer (K : Set G))
    (P : Sylow 2 K) (hP : (P : Subgroup K).map K.subtype = R)
    (hBK : B ≤ K) (hHall : IsHallSubgroup oddPrimes (B.subgroupOf K)) :
    (T : Set G) = (R : Set G) * ((T ⊓ normalizer (B : Set G) : Subgroup G) : Set G) := by
  have hcomp := sylow_complement_of_hall P hHall
  apply Set.Subset.antisymm
  · intro t ht
    have heK : K.map (MulAut.conj t).toMonoidHom = K := mem_normalizer_iff_map_conj_eq.mp (hTK ht)
    let a : MulAut K := ((MulAut.conj t).subgroupMap K).trans (MulEquiv.subgroupCongr heK)
    obtain ⟨b,hb⟩ := exists_conj_eq_of_isHallSubgroup_of_solvable hsolv hHall (hHall.map_mulAut a)
    obtain ⟨⟨r,y⟩,hry⟩ := hcomp.2 b
    have hmap : B.map (MulAut.conj t).toMonoidHom = B.map (MulAut.conj (b : G)).toMonoidHom := by
      have he := congrArg (Subgroup.map K.subtype) hb
      rw [map_map,map_map] at he
      have hl : K.subtype.comp a.toMonoidHom = (MulAut.conj t).toMonoidHom.comp K.subtype := rfl
      have hr : K.subtype.comp (MulAut.conj b).toMonoidHom =
          (MulAut.conj (b : G)).toMonoidHom.comp K.subtype := rfl
      rw [hl,hr,←map_map,←map_map,map_subgroupOf_eq_of_le hBK] at he
      exact he
    have hn : (b : G)⁻¹*t ∈ normalizer (B : Set G) := by
      rw [mem_normalizer_iff_map_conj_eq]
      change B.map (MulAut.conj ((b : G)⁻¹*t)).toMonoidHom = B
      have he := congrArg (Subgroup.map (MulAut.conj (b : G)⁻¹).toMonoidHom) hmap
      simp only [map_map] at he
      have hl : (MulAut.conj (b : G)⁻¹).toMonoidHom.comp (MulAut.conj t).toMonoidHom =
          (MulAut.conj ((b : G)⁻¹*t)).toMonoidHom := by ext z; simp [mul_assoc]
      have hr : (MulAut.conj (b : G)⁻¹).toMonoidHom.comp (MulAut.conj (b : G)).toMonoidHom =
          MonoidHom.id G := by ext z; simp [mul_assoc]
      simpa only [hl,hr,map_id] using he
    have hrR : (r.val : G) ∈ R := hP ▸ mem_map_of_mem K.subtype r.property
    have hn' : (r.val : G)⁻¹*t ∈ normalizer (B : Set G) := by
      have he : (b : G) = (r.val : G)*(y.val : G) := congrArg Subtype.val hry.symm
      have hh := (normalizer (B : Set G)).mul_mem (B.le_normalizer y.property) hn
      change (y.val : G)*((b : G)⁻¹*t) ∈ normalizer (B : Set G) at hh
      simpa only [he,mul_inv_rev,mul_assoc,mul_inv_cancel_left] using hh
    refine ⟨r.val,hrR,(r.val : G)⁻¹*t,⟨T.mul_mem (T.inv_mem (hRT hrR)) ht,hn'⟩,?_⟩
    exact mul_inv_cancel_left _ _
  · rintro _ ⟨r,hr,t,ht,rfl⟩
    exact T.mul_mem (hRT hr) ht.1

end Subgroup.OddHall

namespace Subgroup
variable {G : Type*} [Group G]

theorem index_two_normalizes_conjugate_join
    (S T A : Subgroup G) (hST : S ≤ T) (hi : S.relIndex T = 2)
    (hSA : S ≤ normalizer (A : Set G))
    (x : G) (hx : x ∈ T) (hxS : x ∉ S) :
    T ≤ normalizer ((A ⊔ A.map (MulAut.conj x).toMonoidHom : Subgroup G) : Set G) := by
  let SN := S.subgroupOf T
  let : SN.Normal := normal_of_index_eq_two hi
  have hxN : x ∈ normalizer (S : Set G) :=
    (normal_subgroupOf_iff_le_normalizer hST).mp inferInstance hx
  have hSconj : S ≤ normalizer (A.map (MulAut.conj x).toMonoidHom : Set G) := by
    have hm := (map_mono (f := (MulAut.conj x).toMonoidHom) hSA).trans (A.le_normalizer_map _)
    rwa [show S.map (MulAut.conj x).toMonoidHom = S from mem_normalizer_iff_map_conj_eq.mp hxN] at hm
  let K := A ⊔ A.map (MulAut.conj x).toMonoidHom
  have hSK : S ≤ normalizer (K : Set G) :=
    (le_inf hSA hSconj).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hxx : x^2 ∈ S := SN.sq_mem_of_index_two hi ⟨x,hx⟩
  have hxK : x ∈ normalizer (K : Set G) := by
    apply mem_normalizer_iff_map_conj_eq.mpr
    change K.map (MulAut.conj x).toMonoidHom = K
    dsimp only [K]
    rw [Subgroup.map_sup,Subgroup.map_map]
    have he : (MulAut.conj x).toMonoidHom.comp (MulAut.conj x).toMonoidHom =
        (MulAut.conj (x^2)).toMonoidHom := by
      ext y
      simp [pow_two,mul_assoc]
    rw [he,show A.map (MulAut.conj (x^2)).toMonoidHom = A from
      mem_normalizer_iff_map_conj_eq.mp (hSA hxx),sup_comm]
  intro t ht
  by_cases hs : t ∈ S
  · exact hSK hs
  · have htx : t*x⁻¹ ∈ S := by
      change (⟨t,ht⟩ : T) * (⟨x,hx⟩ : T)⁻¹ ∈ SN
      rw [SN.mul_mem_iff_of_index_two hi,SN.inv_mem_iff]
      exact iff_of_false hs hxS
    have hh := (normalizer (K : Set G)).mul_mem (hSK htx) hxK
    simpa only [inv_mul_cancel_right] using hh

end Subgroup

namespace Subgroup.OddHall
variable {G : Type*} [Group G] [Finite G]

theorem conjugate_product_two_sylow
    (R D : Subgroup G) (hR : IsPGroup 2 R) (hD : Group.IsSolvable D)
    (ho : Odd (Nat.card D)) (hDR : D ≤ normalizer (R : Set G))
    (x : G) (hxR : x ∈ normalizer (R : Set G))
    (hxD : D.map (MulAut.conj x).toMonoidHom ≤ normalizer ((R ⊔ D : Subgroup G) : Set G)) :
    let K := (R ⊔ D) ⊔ D.map (MulAut.conj x).toMonoidHom
    Group.IsSolvable K ∧ R ≤ K ∧ K ≤ normalizer (R : Set G) ∧
      ∃ P : Sylow 2 K, (P : Subgroup K).map K.subtype = R := by
  let E := D.map (MulAut.conj x).toMonoidHom
  let A := R ⊔ D
  let K := A ⊔ E
  let := hD
  let : Group.IsNilpotent R := hR.isNilpotent
  let : Group.IsSolvable A := Group.isSolvable_sup_of_normalizes R D hDR
  let : Group.IsSolvable E := Group.isSolvable_of_surjective
    (f := (equivMapOfInjective D (MulAut.conj x).toMonoidHom (MulAut.conj x).injective).toMonoidHom)
    (equivMapOfInjective D (MulAut.conj x).toMonoidHom (MulAut.conj x).injective).surjective
  have hsolv : Group.IsSolvable K := Group.isSolvable_sup_of_normalizes A E hxD
  have hER : E ≤ normalizer (R : Set G) := by
    have hm := (map_mono (f := (MulAut.conj x).toMonoidHom) hDR).trans (R.le_normalizer_map _)
    rwa [show R.map (MulAut.conj x).toMonoidHom = R from mem_normalizer_iff_map_conj_eq.mp hxR] at hm
  have hRK : R ≤ K := le_sup_left.trans le_sup_left
  have hKN : K ≤ normalizer (R : Set G) := sup_le (sup_le R.le_normalizer hDR) hER
  have hoE : Odd (Nat.card E) := by rwa [card_map_of_injective (MulAut.conj x).injective]
  have hoRA : Odd (R.relIndex A) := by
    rw [show A = R ⊔ D from rfl,relIndex_normalized_sup R D hDR]
    exact ho.of_dvd_nat (relIndex_dvd_card _ _)
  have hoAK : Odd (A.relIndex K) := by
    rw [show K = A ⊔ E from rfl,relIndex_normalized_sup A E hxD]
    exact hoE.of_dvd_nat (relIndex_dvd_card _ _)
  have hoRK : Odd (R.relIndex K) := by
    rw [←relIndex_mul_relIndex R A K le_sup_left le_sup_left]
    exact hoRA.mul hoAK
  let P := hR.comap_subtype.toSylow (show ¬ 2 ∣ (R.subgroupOf K).index from
    fun hd => (Nat.not_even_iff_odd.mpr hoRK) (even_iff_two_dvd.mpr hd))
  refine ⟨hsolv,hRK,hKN,P,?_⟩
  change (R.subgroupOf K).map K.subtype = R
  exact map_subgroupOf_eq_of_le hRK

end Subgroup.OddHall

namespace Subgroup
variable {G : Type*} [Group G]

theorem index_two_conjugate_join_eq
    (S T A : Subgroup G) (hST : S ≤ T) (hi : S.relIndex T = 2)
    (hSA : S ≤ normalizer (A : Set G))
    (x y : G) (hx : x ∈ T) (hxS : x ∉ S) (hy : y ∈ T) (hyS : y ∉ S) :
    A ⊔ A.map (MulAut.conj x).toMonoidHom = A ⊔ A.map (MulAut.conj y).toMonoidHom := by
  have hnX := index_two_normalizes_conjugate_join S T A hST hi hSA x hx hxS
  have hnY := index_two_normalizes_conjugate_join S T A hST hi hSA y hy hyS
  apply le_antisymm
  · apply sup_le le_sup_left
    exact (map_mono (f := (MulAut.conj x).toMonoidHom) (show A ≤ A ⊔ A.map (MulAut.conj y).toMonoidHom from le_sup_left)).trans_eq
      (mem_normalizer_iff_map_conj_eq.mp (hnY hx))
  · apply sup_le le_sup_left
    exact (map_mono (f := (MulAut.conj y).toMonoidHom) (show A ≤ A ⊔ A.map (MulAut.conj x).toMonoidHom from le_sup_left)).trans_eq
      (mem_normalizer_iff_map_conj_eq.mp (hnX hy))

end Subgroup
namespace Subgroup.OddHall
variable {G : Type*} [Group G] [Finite G]

theorem exists_joint_hall_of_index_two
    (S T R D : Subgroup G) (hST : S < T) (hi : S.relIndex T = 2)
    (hR : IsPGroup 2 R) (hRS : R ≤ S) (hTR : T ≤ normalizer (R : Set G))
    (hDsolv : Group.IsSolvable D) (ho : Odd (Nat.card D))
    (hDR : D ≤ normalizer (R : Set G))
    (hSA : S ≤ normalizer ((R ⊔ D : Subgroup G) : Set G))
    (hconj : ∀ x ∈ T, x ∉ S → D.map (MulAut.conj x).toMonoidHom ≤
      normalizer ((R ⊔ D : Subgroup G) : Set G)) :
    ∃ K B : Subgroup G, D ≤ B ∧ B ≤ K ∧ Odd (Nat.card B) ∧
      IsHallSubgroup oddPrimes (B.subgroupOf K) ∧ R ⊔ B = K ∧
      T ≤ normalizer (K : Set G) ∧ K ≤ normalizer (R : Set G) ∧
      K ≤ normalizer ((R ⊔ D : Subgroup G) : Set G) ∧
      (T : Set G) = (R : Set G) * ((T ⊓ normalizer (B : Set G) : Subgroup G) : Set G) ∧
      ∃ x ∈ T, x ∉ S ∧ x ∈ normalizer (B : Set G) ∧
        K = (R ⊔ D) ⊔ D.map (MulAut.conj x).toMonoidHom := by
  obtain ⟨u,huT,huS⟩ := SetLike.exists_of_lt hST
  let A := R ⊔ D
  let E := D.map (MulAut.conj u).toMonoidHom
  let K := A ⊔ E
  have hEu := hconj u huT huS
  obtain ⟨hsolv,hRK,hKR,P,hP⟩ := conjugate_product_two_sylow R D hR hDsolv ho hDR u (hTR huT) hEu
  change (P : Subgroup K).map K.subtype = R at hP
  have pair_eq (v : G) (hv : v ∈ T) :
      A ⊔ A.map (MulAut.conj v).toMonoidHom = A ⊔ D.map (MulAut.conj v).toMonoidHom := by
    have hRv : R.map (MulAut.conj v).toMonoidHom = R := mem_normalizer_iff_map_conj_eq.mp (hTR hv)
    change A ⊔ (R ⊔ D).map (MulAut.conj v).toMonoidHom = _
    rw [Subgroup.map_sup,hRv,←sup_assoc,sup_eq_left.mpr (show R ≤ A from le_sup_left)]
  have hTK : T ≤ normalizer (K : Set G) := by
    have hn := index_two_normalizes_conjugate_join S T A hST.le hi hSA u huT huS
    rwa [pair_eq u huT] at hn
  have hKA : K ≤ normalizer (A : Set G) := sup_le A.le_normalizer hEu
  have hDK : D ≤ K := le_sup_right.trans le_sup_left
  obtain ⟨B,hDB,hBK,hHall⟩ := exists_hall_containing_odd K D hsolv hDK ho
  have hBodd : Odd (Nat.card B) := by
    have hh := odd_hall_odd hHall
    rwa [Nat.card_congr (subgroupOfEquivOfLe hBK).toEquiv] at hh
  have hRB : R ⊔ B = K := by
    have he := congrArg (Subgroup.map K.subtype) (sylow_complement_of_hall P hHall).sup_eq_top
    simpa only [Subgroup.map_sup,hP,map_subgroupOf_eq_of_le hBK,
      ←MonoidHom.range_eq_map,range_subtype] using he
  have hfrat := normal_sylow_frattini K R T B hsolv (hRS.trans hST.le) hTK P hP hBK hHall
  have hu : u ∈ (R : Set G) * ((T ⊓ normalizer (B : Set G) : Subgroup G) : Set G) := hfrat ▸ huT
  obtain ⟨r,hr,x,hx,hux⟩ := hu
  have hxS : x ∉ S := by
    intro hs
    exact huS (hux ▸ S.mul_mem (hRS hr) hs)
  have heK : K = (R ⊔ D) ⊔ D.map (MulAut.conj x).toMonoidHom := by
    have hh := index_two_conjugate_join_eq S T A hST.le hi hSA u x huT huS hx.1 hxS
    rwa [pair_eq u huT,pair_eq x hx.1] at hh
  exact ⟨K,B,hDB,hBK,hBodd,hHall,hRB,hTK,hKR,hKA,hfrat,x,hx.1,hxS,hx.2,heK⟩

end Subgroup.OddHall
namespace Subgroup.OddHall
variable {G : Type*} [Group G]

private theorem normal_product_intersection (R D B : Subgroup G)
    (hDR : D ≤ normalizer (R : Set G)) (hDB : D ≤ B) (hdis : Disjoint R B) :
    (R ⊔ D) ⊓ B = D := by
  apply le_antisymm _ (le_inf le_sup_right hDB)
  rintro z ⟨hz,hzB⟩
  have hz' : z ∈ (R : Set G)*(D : Set G) :=
    (coe_mul_of_right_le_normalizer_left R D hDR) ▸ hz
  obtain ⟨r,hr,d,hd,he⟩ := hz'
  have hrB : r ∈ B := by
    have hrd := B.mul_mem hzB (B.inv_mem (hDB hd))
    rw [←he,mul_inv_cancel_right] at hrd
    exact hrd
  have hr1 := disjoint_def.mp hdis hr hrB
  have hdZ : d = z := by simpa only [hr1,one_mul] using he
  exact hdZ ▸ hd

variable [Finite G]

theorem hall_pair_generation (R D K B : Subgroup G)
    (hR : IsPGroup 2 R) (hBodd : Odd (Nat.card B)) (hDB : D ≤ B) (hBK : B ≤ K)
    (hKR : K ≤ normalizer (R : Set G))
    (x : G) (hxB : x ∈ normalizer (B : Set G))
    (hxD : D.map (MulAut.conj x).toMonoidHom ≤ normalizer ((R ⊔ D : Subgroup G) : Set G))
    (hK : K = (R ⊔ D) ⊔ D.map (MulAut.conj x).toMonoidHom) :
    B = D ⊔ D.map (MulAut.conj x).toMonoidHom ∧
      B ≤ normalizer (D : Set G) ∧
      B ≤ normalizer (D.map (MulAut.conj x).toMonoidHom : Set G) := by
  let E := D.map (MulAut.conj x).toMonoidHom
  have hEB : E ≤ B := (map_mono hDB).trans_eq (mem_normalizer_iff_map_conj_eq.mp hxB)
  have hDR : D ≤ normalizer (R : Set G) := hDB.trans (hBK.trans hKR)
  have hdis : Disjoint R B := by
    obtain ⟨n,hn⟩ := hR.exists_card_eq
    apply disjoint_of_coprime_natCard
    rw [hn]
    exact (Nat.coprime_two_left.mpr hBodd).pow_left n
  have hDC : (R ⊔ D) ⊓ B = D := normal_product_intersection R D B hDR hDB hdis
  have hEN : E ≤ normalizer (D : Set G) := by
    rw [←hDC]
    exact (le_inf hxD (hEB.trans B.le_normalizer)).trans inf_normalizer_le_normalizer_inf
  have hCB : D ⊔ E ≤ B := sup_le hDB hEB
  have hBC : B = D ⊔ E := by
    have he := normal_product_intersection R (D ⊔ E) B (hCB.trans (hBK.trans hKR)) hCB hdis
    rw [←sup_assoc,←hK,inf_eq_right.mpr hBK] at he
    exact he
  have hBD : B ≤ normalizer (D : Set G) := by
    rw [hBC]
    exact sup_le D.le_normalizer hEN
  have hBE : B ≤ normalizer (E : Set G) := by
    have hm := (map_mono (f := (MulAut.conj x).toMonoidHom) hBD).trans (D.le_normalizer_map _)
    rwa [show B.map (MulAut.conj x).toMonoidHom = B from mem_normalizer_iff_map_conj_eq.mp hxB] at hm
  exact ⟨hBC,hBD,hBE⟩

end Subgroup.OddHall

namespace Subgroup.OddHall
variable {G : Type*} [Group G] [Finite G]

theorem hall_in_two_extension (K T B : Subgroup G)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G))
    (hBK : B ≤ K) (hHall : IsHallSubgroup oddPrimes (B.subgroupOf K)) :
    IsHallSubgroup oddPrimes (B.subgroupOf (K ⊔ T)) := by
  have hBJ : B ≤ K ⊔ T := hBK.trans le_sup_left
  refine ⟨?_,?_⟩
  · intro p hp
    have hc : Nat.card (B.subgroupOf K) = Nat.card (B.subgroupOf (K ⊔ T)) :=
      (Nat.card_congr (subgroupOfEquivOfLe hBK).toEquiv).trans
        (Nat.card_congr (subgroupOfEquivOfLe hBJ).toEquiv).symm
    exact hHall.p_in_pi_of_p_dvd_card p (hc.symm ▸ hp)
  · intro p hp hodd
    change p.val ∣ B.relIndex (K ⊔ T) at hp
    rw [←relIndex_mul_relIndex B K (K ⊔ T) hBK le_sup_left,
      relIndex_normalized_sup K T hTK] at hp
    rcases p.property.dvd_mul.mp hp with h | h
    · exact hHall.p_in_pi_of_p_dvd_index p h hodd
    · obtain ⟨n,hn⟩ := hT.exists_card_eq
      have hd := h.trans (relIndex_dvd_card K T)
      rw [hn] at hd
      exact hodd (Nat.prime_eq_prime_of_dvd_pow p.property Nat.prime_two hd)

end Subgroup.OddHall
