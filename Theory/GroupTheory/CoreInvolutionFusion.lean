module
public import Theory.GroupTheory.SaturatedCentralizer
public import Theory.GroupTheory.CharacteristicCentralizerFusion
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Outside conjugates from core involution geometry

If all conjugates of a central Sylow involution stay in a core whose
noncentral involutions form one ambient orbit, every core involution belongs
to that conjugacy class. If each noncentral involution centralizer in the
core is generated by involutions and has derived subgroup generated by the
central involution, its ambient normalizer fixes that central involution.

Choose a distinct conjugate with saturated common centralizer. The normalizer
condition in a larger two-subgroup of its full centralizer contradicts this
normalizer control. This proves existence of an outside conjugate without
assuming that fusion into the core is individually impossible.

Source: Janko–Thompson (1970), §4, printed p.390, the paragraph beginning
“We show that T−H contains a conjugate of z.”
-/

open Subgroup

namespace Subgroup

/-- Normalizing a subgroup preserves the subgroup generated by the part
of any ambient conjugacy class that it contains. -/
public theorem normalizer_le_normalizer_conjugacy_generated
    {G : Type*} [Group G] (E : Subgroup G) (z : G) :
    normalizer (E : Set G) ≤ normalizer
      (closure {x : G | x ∈ E ∧ IsConj z x} : Set G) := by
  intro g hg
  apply normalizer_le_normalizer_closure
  intro x
  have hc : IsConj x (g * x * g⁻¹) := isConj_iff.mpr ⟨g, rfl⟩
  exact ⟨fun hx => ⟨(hg x).mp hx.1, hx.2.trans hc⟩,
    fun hx => ⟨(hg x).mpr hx.1, hx.2.trans hc.symm⟩⟩

/-- Normalizer control contradicts fusion for a proper Sylow centralizer
maximal in the simultaneous ambient centralizer. -/
public theorem not_isConj_of_saturated_centralizer_normalizer
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (S : Sylow p G) (z t : S) (hzC : z ∈ center S)
    (hproper : centralizer ({t} : Set S) ≠ ⊤)
    (hmax : ∀ V : Subgroup G, IsPGroup p V →
      (centralizer ({t} : Set S)).map (S : Subgroup G).subtype ≤ V →
      V ≤ centralizer ({(z : G), (t : G)} : Set G) →
      V = (centralizer ({t} : Set S)).map (S : Subgroup G).subtype)
    (hN : normalizer
      ((centralizer ({t} : Set S)).map (S : Subgroup G).subtype : Set G) ≤
        centralizer ({(z : G)} : Set G)) : ¬ IsConj (z : G) (t : G) := by
  classical
  intro hconj
  let H := centralizer ({(z : G)} : Set G)
  let D := centralizer ({(t : G)} : Set G)
  let E := (centralizer ({t} : Set S)).map (S : Subgroup G).subtype
  have hSH : (S : Subgroup G) ≤ H := by
    intro s hs
    exact mem_centralizer_singleton_iff.mpr
      (congrArg Subtype.val (mem_center_iff.mp hzC ⟨s, hs⟩))
  have hHD : Nat.card D = Nat.card H := by
    obtain ⟨g, hg⟩ := isConj_iff.mp hconj
    let f := MulAut.conj g
    have hfz : f (z : G) = t := hg
    apply (Nat.card_congr (Equiv.subtypeEquiv f.toEquiv ?_)).symm
    intro a
    change a ∈ H ↔ f a ∈ D
    simp only [H, D, mem_centralizer_singleton_iff]
    constructor
    · intro ha
      simpa only [map_mul, hfz] using congrArg f ha
    · intro ha
      apply f.injective
      simpa only [map_mul, hfz] using ha
  have hED : E ≤ D := by
    dsimp only [E]
    rw [map_subtype_centralizer_singleton]
    exact inf_le_right
  have hEp : IsPGroup p E := (S.isPGroup'.to_subgroup _).map _
  obtain ⟨T, hET⟩ := (hEp.comap_subtype (K := D)).exists_le_sylow
  change E.subgroupOf D ≤ (T : Subgroup D) at hET
  have hTcard : Nat.card T = Nat.card S := by
    calc
      Nat.card T = Nat.card (S.subtype hSH) := by
        rw [T.card_eq_multiplicity, (S.subtype hSH).card_eq_multiplicity, hHD]
      _ = Nat.card S := Nat.card_congr (subgroupOfEquivOfLe hSH).toEquiv
  have hsmall : Nat.card E < Nat.card S := by
    rw [card_map_of_injective (S : Subgroup G).subtype_injective]
    have hle := card_le_card_group (centralizer ({t} : Set S))
    refine lt_of_le_of_ne hle ?_
    intro heq
    exact hproper (eq_top_of_card_eq _ heq)
  have hKcard : Nat.card (E.subgroupOf D) = Nat.card E :=
    Nat.card_congr (subgroupOfEquivOfLe hED).toEquiv
  have hKproper : (E.subgroupOf D).subgroupOf (T : Subgroup D) < ⊤ := by
    rw [lt_top_iff_ne_top, Ne, subgroupOf_eq_top]
    intro hle
    have h := card_le_of_le hle
    rw [hKcard, hTcard] at h
    omega
  let : Group.IsNilpotent T := T.isPGroup'.isNilpotent
  obtain ⟨u, huN, huE⟩ := SetLike.exists_of_lt
    (Group.normalizerCondition_of_isNilpotent _ hKproper)
  let V : Subgroup G := (normalizer ((E.subgroupOf D).subgroupOf T : Set T)).map
    (D.subtype.comp (T : Subgroup D).subtype)
  have hEV : E ≤ V := by
    intro x hx
    let xD : D := ⟨x, hED hx⟩
    let xT : T := ⟨xD, hET hx⟩
    exact ⟨xT, le_normalizer hx, rfl⟩
  have hVC : V ≤ centralizer ({(z : G), (t : G)} : Set G) := by
    rintro x ⟨v, hv, rfl⟩
    have hvNE : (v : D) ∈ normalizer (E.subgroupOf D : Set D) := by
      rw [← subgroupOf_normalizer_eq hET] at hv
      exact hv
    have hvNG : ((v : D) : G) ∈ normalizer (E : Set G) := by
      rw [← map_subgroupOf_eq_of_le hED]
      exact (E.subgroupOf D).le_normalizer_map D.subtype (mem_map_of_mem D.subtype hvNE)
    intro a ha
    rcases Set.mem_insert_iff.mp ha with rfl | ha
    · exact (mem_centralizer_singleton_iff.mp (hN hvNG)).symm
    · have : a = (t : G) := Set.mem_singleton_iff.mp ha
      subst a
      exact (mem_centralizer_singleton_iff.mp (v : D).property).symm
  have hVE : V = E := hmax V ((T.isPGroup'.to_subgroup _).map _) hEV hVC
  apply huE
  change ((u : D) : G) ∈ E
  rw [← hVE]
  exact ⟨u, huN, rfl⟩

end Subgroup

namespace Sylow

/-- If a conjugacy class confined to a core generates an involution
centralizer with characteristic involution line, saturation forces a
conjugate outside the core. -/
public theorem exists_conjugate_outside_of_core_involution_geometry
    {G : Type*} [Group G] [Finite G]
    (S : Sylow 2 G) (H : Subgroup S) (z : S)
    (hz : orderOf z = 2) (hzC : z ∈ center S)
    (hunique : ∀ t ∈ H, t ∈ center S → orderOf t = 2 → t = z)
    (hstart : ∃ x : S, x ≠ z ∧ IsConj (z : G) (x : G))
    (horbit : ∀ x ∈ H, orderOf x = 2 → x ≠ z →
      ∀ y ∈ H, orderOf y = 2 → y ≠ z → IsConj (x : G) (y : G))
    (hgeometry : ∀ t ∈ H, orderOf t = 2 → t ≠ z →
      let D := H ⊓ centralizer ({t} : Set S)
      closure {x : S | x ∈ D ∧ orderOf x = 2} = D ∧
      (_root_.commutator D).map D.subtype = zpowers z) :
    ∃ t : S, orderOf t = 2 ∧ t ∉ H ∧ IsConj (z : G) (t : G) := by
  classical
  have horder (t : S) (hzt : IsConj (z : G) (t : G)) : orderOf t = 2 := by
    obtain ⟨g, hg⟩ := isConj_iff.mp hzt
    rw [← orderOf_coe t, ← hg, ← MulAut.conj_apply]
    simpa using ((MulAut.conj g).orderOf_eq (z : G)).trans ((orderOf_coe z).trans hz)
  by_contra hnone
  have hclosed (t : S) (hzt : IsConj (z : G) (t : G)) : t ∈ H := by
    by_contra ht
    exact hnone ⟨t, horder t hzt, ht, hzt⟩
  obtain ⟨x, hxz, hzx⟩ := hstart
  obtain ⟨t, htz, hzt, hmax⟩ :=
    S.exists_distinct_conjugate_with_saturated_common_centralizer z hzC x hxz hzx
  have htH := hclosed t hzt
  have ht := horder t hzt
  have hall (u : S) (hu : u ∈ H) (hu2 : orderOf u = 2) :
      IsConj (z : G) (u : G) := by
    by_cases huz : u = z
    · subst u
      exact IsConj.refl _
    · exact hzt.trans (horbit t htH ht htz u hu hu2 huz)
  let D := H ⊓ centralizer ({t} : Set S)
  let E := (centralizer ({t} : Set S)).map (S : Subgroup G).subtype
  let Dg := D.map (S : Subgroup G).subtype
  have hgen := (hgeometry t htH ht htz).1
  have hline := (hgeometry t htH ht htz).2
  change closure {x : S | x ∈ D ∧ orderOf x = 2} = D at hgen
  change (_root_.commutator D).map D.subtype = zpowers z at hline
  have hclass : Dg = closure {u : G | u ∈ E ∧ IsConj (z : G) u} := by
    change D.map (S : Subgroup G).subtype = _
    rw [← hgen, MonoidHom.map_closure]
    congr 1
    ext u
    constructor
    · rintro ⟨v, hv, rfl⟩
      exact ⟨mem_map_of_mem (S : Subgroup G).subtype hv.1.2, hall v hv.1.1 hv.2⟩
    · rintro ⟨⟨v, hv, rfl⟩, hzu⟩
      exact ⟨v, ⟨⟨hclosed v hzu, hv⟩, horder v hzu⟩, rfl⟩
  have hNE : normalizer (E : Set G) ≤ normalizer (Dg : Set G) := by
    rw [hclass]
    exact normalizer_le_normalizer_conjugacy_generated E (z : G)
  have hderived : (_root_.commutator Dg).map Dg.subtype = zpowers (z : G) := by
    rw [map_subtype_commutator]
    change ⁅D.map (S : Subgroup G).subtype, D.map (S : Subgroup G).subtype⁆ = _
    rw [← map_commutator, ← map_subtype_commutator, hline, MonoidHom.map_zpowers]
    rfl
  have hN : normalizer (E : Set G) ≤ centralizer ({(z : G)} : Set G) :=
    hNE.trans (normalizer_le_centralizer_of_characteristic_involution Dg
      (_root_.commutator Dg) (z : G) ((orderOf_coe z).trans hz) hderived)
  have hproper : centralizer ({t} : Set S) ≠ ⊤ := by
    intro heq
    apply htz
    apply hunique t htH _ ht
    exact mem_center_iff.mpr fun s =>
      mem_centralizer_singleton_iff.mp (show s ∈ centralizer ({t} : Set S) by rw [heq]; trivial)
  exact not_isConj_of_saturated_centralizer_normalizer S z t hzC hproper hmax hN hzt

end Sylow
