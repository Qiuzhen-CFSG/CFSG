module
public import Theory.GroupTheory.InvertingComplementNormalizer
public import Theory.GroupTheory.SylowSubnormalIntersection
public import Theory.GroupTheory.PerfectSmallNormalizer
public import Theory.GroupTheory.PrimeRankCoprimeIndex

/-!
# The index of a complement determined by its inverting involution

Suppose a normal subgroup K is generated by an odd normal subgroup X and
a subgroup B. The quotient K/X and B have a unique involution, and the
involution of B inverts X. A full ambient Sylow normalizing B fixes that
involution. Its intersection with K has the same unique involution, so
the Frattini argument gives G = X N_G(B). Thus the normalizer index
divides |X| and preserves every prime rank away from |X|.

The source application is the noncentral-Fitting containing component in
Aschbacher--Smith 15.3.23, printed pp.1128--1129, using A.3.6.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace Subgroup
variable {G Q : Type*} [Group G] [Finite G] [Group Q]

/-- A normal odd supplement bounds the index of the original complement's
normalizer when its unique involution inverts the supplement. -/
theorem normalizer_index_dvd_of_unique_inverting_complement
    (K X B : Subgroup G) [K.Normal] [X.Normal]
    (_hXK : X ≤ K) (hBK : B ≤ K) (hgen : X ⊔ B = K)
    (hX : Odd (Nat.card X))
    (q : K →* Q) (hq : q.ker = X.subgroupOf K)
    (e : B ≃* Q) (huniq : ∃! z : Q, orderOf z = 2)
    (hinv : ∀ z : B, orderOf z = 2 → ∀ x ∈ X, (z : G) * x * (z : G)⁻¹ = x⁻¹)
    (R : Sylow 2 G) (hRB : (R : Subgroup G) ≤ normalizer (B : Set G)) :
    (normalizer (B : Set G)).index ∣ Nat.card X := by
  obtain ⟨u,hu,huuniq⟩ := huniq
  let z : B := e.symm u
  have hz : orderOf z = 2 := (e.symm.orderOf_eq u).trans hu
  have hzg : orderOf (z : G) = 2 := (orderOf_coe z).trans hz
  have uniqueB (b : B) (hb : orderOf b = 2) : b = z := by
    apply e.injective
    exact (huuniq (e b) ((e.orderOf_eq b).trans hb)).trans (e.apply_symm_apply u).symm
  have hRz : (R : Subgroup G) ≤ normalizer (zpowers (z : G) : Set G) := by
    apply le_normalizer_iff.mpr
    intro r hr a ha
    have hzB := (mem_normalizer_iff.mp (hRB hr) (z : G)).mp z.property
    have hzfix : r * (z : G) * r⁻¹ = z := by
      apply congrArg Subtype.val (uniqueB ⟨_,hzB⟩ ?_)
      exact (orderOf_coe (⟨_,hzB⟩ : B)).symm.trans
        (((MulAut.conj r).orderOf_eq (z : G)).trans hzg)
    have hh : (zpowers (z : G)).map (MulAut.conj r).toMonoidHom = zpowers (z : G) := by
      rw [MonoidHom.map_zpowers]
      exact congrArg zpowers hzfix
    exact hh ▸ mem_map_of_mem (MulAut.conj r).toMonoidHom ha
  have hzR : (z : G) ∈ R := by
    have hp : IsPGroup 2 (zpowers (z : G)) := IsPGroup.of_card (n := 1) (by
      simp only [Nat.card_zpowers,hzg,pow_one])
    exact hp.le_sylow_of_normalized R hRz (mem_zpowers _)
  have hx2 (x : G) (hx : x ∈ X) (hh : x ^ 2 = 1) : x = 1 := by
    have hd := orderOf_dvd_of_pow_eq_one hh
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
    · exact orderOf_eq_one_iff.mp h1
    · have ho := hX.of_dvd_nat (orderOf_dvd_natCard X hx)
      rw [h2] at ho
      exact (by decide : ¬ Odd 2) ho |>.elim
  have image (t : K) (ht : orderOf t = 2) : q t = u := by
    apply huuniq
    have hd : orderOf (q t) ∣ 2 := ht ▸ orderOf_map_dvd q t
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h1 | h2
    · have htX : (t : G) ∈ X := by
        have hk : t ∈ q.ker := orderOf_eq_one_iff.mp h1
        rw [hq] at hk
        exact hk
      have ht1 : t = 1 := Subtype.ext (hx2 t htX (by
        have hh := congrArg (fun k : K => (k : G)) (pow_orderOf_eq_one t)
        simpa only [ht,Subgroup.coe_pow,Subgroup.coe_one] using hh))
      simp [ht1] at ht
    · exact h2
  have hzK : (z : G) ∈ K := hBK z.property
  have central (k : G) (hk : k ∈ K) (hc : k * z = z * k) : k ∈ B := by
    have hprod : (↑(X ⊔ B) : Set G) = (X : Set G) * (B : Set G) :=
      coe_mul_of_right_le_normalizer_left X B le_normalizer_of_normal
    have hk' : k ∈ (X : Set G) * (B : Set G) := by rw [←hprod,hgen]; exact hk
    obtain ⟨x,hx,b,hb,rfl⟩ := hk'
    have hzb : b * (z : G) * b⁻¹ = z := by
      have hh := uniqueB ((MulAut.conj (⟨b,hb⟩ : B)) z)
        (((MulAut.conj (⟨b,hb⟩ : B)).orderOf_eq z).trans hz)
      exact congrArg Subtype.val hh
    have hbc : b * (z : G) = z * b := mul_inv_eq_iff_eq_mul.mp hzb
    have hxc : x * (z : G) = z * x := by
      apply mul_right_cancel (b := b)
      calc
        x * (z : G) * b = (x * b) * z := by rw [mul_assoc,←hbc,←mul_assoc]
        _ = z * (x * b) := hc
        _ = _ := (mul_assoc _ _ _).symm
    have hxx : x = x⁻¹ := by
      calc
        x = (z : G) * x * (z : G)⁻¹ := by rw [←hxc,mul_inv_cancel_right]
        _ = x⁻¹ := hinv z hz x hx
    have hx1 : x = 1 := hx2 x hx (by
      calc
        x ^ 2 = x * x := pow_two x
        _ = x * x⁻¹ := congrArg (x * ·) hxx
        _ = 1 := mul_inv_cancel x)
    change x * b ∈ B
    rw [hx1,one_mul]
    exact hb
  obtain ⟨P,hP⟩ := R.exists_subgroupOf_eq_of_subnormal K
    (inferInstance : K.Normal).isSubnormal
  let D := (P : Subgroup K).map K.subtype
  have hDR : D ≤ (R : Subgroup G) := by
    rw [show D = (P : Subgroup K).map K.subtype from rfl,hP,subgroupOf_map_subtype]
    exact inf_le_left
  have hzD : (z : G) ∈ D := by
    have hzP : (⟨z,hzK⟩ : K) ∈ (P : Subgroup K) := by
      rw [hP]
      exact hzR
    exact mem_map_of_mem K.subtype hzP
  have hXR : Disjoint X (R : Subgroup G) := by
    obtain ⟨n,hn⟩ := R.isPGroup'.exists_card_eq
    exact disjoint_of_coprime_natCard (by rw [hn]; exact hX.coprime_two_right.pow_right n)
  have uniqueD (t : G) (ht : t ∈ D) (ht2 : orderOf t = 2) : t = z := by
    have htK : t ∈ K := map_subtype_le _ ht
    have he : q (⟨t,htK⟩ : K) = q (⟨z,hzK⟩ : K) :=
      (image _ ((orderOf_coe _).symm.trans ht2)).trans
        (image _ ((orderOf_coe _).symm.trans hzg)).symm
    have hx : t * (z : G)⁻¹ ∈ X := by
      have hk : (⟨t,htK⟩ : K) * (⟨z,hzK⟩ : K)⁻¹ ∈ q.ker := by
        change q (_ * _) = 1
        rw [map_mul,map_inv,he,mul_inv_cancel]
      rwa [hq] at hk
    exact mul_inv_eq_one.mp (disjoint_def.mp hXR hx (R.mul_mem (hDR ht) (R.inv_mem hzR)))
  have hDN : normalizer (D : Set G) ≤ normalizer (B : Set G) := by
    apply le_normalizer_iff.mpr
    intro a ha b hb
    have haD : a * (z : G) * a⁻¹ ∈ D := (mem_normalizer_iff.mp ha _).mp hzD
    have hafix : a * (z : G) * a⁻¹ = z :=
      uniqueD _ haD (((MulAut.conj a).orderOf_eq (z : G)).trans hzg)
    have hbc : b * (z : G) = z * b := by
      have hh := uniqueB ((MulAut.conj (⟨b,hb⟩ : B)) z)
        (((MulAut.conj (⟨b,hb⟩ : B)).orderOf_eq z).trans hz)
      exact mul_inv_eq_iff_eq_mul.mp (congrArg Subtype.val hh)
    apply central _ ((inferInstance : K.Normal).conj_mem b (hBK hb) a)
    have hc := congrArg (MulAut.conj a) hbc
    simpa only [map_mul,MulAut.conj_apply,hafix] using hc
  have hcover : X ⊔ normalizer (B : Set G) = ⊤ := by
    apply top_unique
    rw [←P.normalizer_sup_eq_top]
    apply sup_le (hDN.trans le_sup_right)
    rw [←hgen]
    exact sup_le le_sup_left (B.le_normalizer.trans le_sup_right)
  rw [←relIndex_top_right,←hcover,relIndex_sup_of_normal_left]
  exact relIndex_dvd_card _ _

/-- Prime rank is unchanged in the normalizer away from the odd supplement. -/
theorem normalizer_primeRank_eq_of_unique_inverting_complement
    (K X B : Subgroup G) [K.Normal] [X.Normal]
    (hXK : X ≤ K) (hBK : B ≤ K) (hgen : X ⊔ B = K)
    (hX : Odd (Nat.card X))
    (q : K →* Q) (hq : q.ker = X.subgroupOf K)
    (e : B ≃* Q) (huniq : ∃! z : Q, orderOf z = 2)
    (hinv : ∀ z : B, orderOf z = 2 → ∀ x ∈ X, (z : G) * x * (z : G)⁻¹ = x⁻¹)
    (R : Sylow 2 G) (hRB : (R : Subgroup G) ≤ normalizer (B : Set G))
    (p : ℕ) [Fact p.Prime] (hp : ¬ p ∣ Nat.card X) :
    primeRank p (normalizer (B : Set G)) = primeRank p G := by
  apply primeRank_eq_of_not_dvd_index
  exact fun hd => hp (hd.trans (normalizer_index_dvd_of_unique_inverting_complement
    K X B hXK hBK hgen hX q hq e huniq hinv R hRB))

end Subgroup
