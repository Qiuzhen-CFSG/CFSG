module

public import Theory.GroupTheory.CentralExtensionSwap
public import Theory.GroupTheory.PerfectCentralSupplement
public import Theory.GroupTheory.CyclicNormRetraction

/-!
# Cubic norms and kernels of perfect central covers

Let a subgroup of prime-to-r index be generated by an abelian torus T and
an element c of order dividing three. If the full preimage of T in a
central cover is abelian and every c-fixed element of T is a cubic orbit
norm, the covering kernel has order prime to r, including when r = 3.

The lifted norm commutes with a lift of c: its three factors are cyclically
permuted, since the cube of the lift is central. The commutator map on the
abelian torus preimage has image equal to the derived local preimage, so
that derived group meets the covering kernel trivially. Central transfer
then excludes r. The local commutator-range calculation follows the one
in `PerfectCentralCoverCyclicFixedBound`, with its public boundary preserved.

The concrete consumer is the three-coordinate split torus of PSL₄ in
`HigherClassicalCovers.Nondefining.LinearQuadratic.SplitNorm`.
Source: Aschbacher–Smith, covering conventions and central transfer I.1.1–I.1.2,
printed p.407, used in the degree-four branch of A.2.17, printed p.39.
-/

open Subgroup
open scoped commutatorElement IsMulCommutative Pointwise

namespace PerfectCentralCovering

private theorem abelian_commute {E : Type*} [Group E] (A : Subgroup E)
    (hA : IsMulCommutative A) {a b : E} (ha : a ∈ A) (hb : b ∈ A) : Commute a b := by
  let := hA
  exact congrArg Subtype.val (mul_comm (⟨a, ha⟩ : A) ⟨b, hb⟩)

private theorem derived_join_le {E : Type*} [Group E] (A B : Subgroup E)
    (hA : IsMulCommutative A) (hB : IsMulCommutative B)
    (hn : B ≤ normalizer (A : Set E)) : ⁅A ⊔ B, A ⊔ B⁆ ≤ ⁅A, B⁆ := by
  have hform {g : E} (hg : g ∈ A ⊔ B) : ∃ a ∈ A, ∃ b ∈ B, a * b = g := by
    have he := coe_mul_of_right_le_normalizer_left A B hn
    change g ∈ (↑(A ⊔ B) : Set E) at hg
    rw [he] at hg
    exact hg
  apply commutator_le.mpr
  intro x hx y hy
  obtain ⟨a, ha, b, hb, rfl⟩ := hform hx
  obtain ⟨c, hc, d, hd, rfl⟩ := hform hy
  rw [commutatorElement_mul_left_eq_conj_mul,
    commutatorElement_mul_right_eq_mul_conj,
    (abelian_commute B hB hb hd).commutator_eq, mul_one, mul_inv_cancel_right,
    commutatorElement_mul_right_eq_mul_conj,
    (abelian_commute A hA ha hc).commutator_eq, one_mul]
  apply mul_mem
  · exact (mem_normalizer_iff.mp (normalizer_commutator_ge_left A B ha) _).mp
      (by rw [commutator_comm]; exact commutator_mem_commutator hb hc)
  · exact (mem_normalizer_iff.mp (normalizer_commutator_ge_left A B hc) _).mp
      (commutator_mem_commutator ha hd)

private theorem exists_commutator_hom {E : Type*} [Group E] [Finite E]
    (A : Subgroup E) (hA : IsMulCommutative A) (b : E)
    (hb : b ∈ normalizer (A : Set E)) :
    ∃ d : A →* E, (∀ a, d a = ⁅(a : E), b⁆) ∧
      d.range = ⁅A ⊔ zpowers b, A ⊔ zpowers b⁆ := by
  have hn : zpowers b ≤ normalizer (A : Set E) := zpowers_le.mpr hb
  have hDA : ⁅A, zpowers b⁆ ≤ A := le_normalizer_iff_commutator_le_left.mp hn
  let d : A →* E := {
    toFun a := ⁅(a : E), b⁆
    map_one' := by simp
    map_mul' a a' := by
      change ⁅(a : E) * a', b⁆ = ⁅(a : E), b⁆ * ⁅(a' : E), b⁆
      rw [commutatorElement_mul_left_eq_conj_mul,
        (abelian_commute A hA a.property
          (hDA (commutator_mem_commutator a'.property (mem_zpowers b)))).eq,
        mul_inv_cancel_right]
      exact (abelian_commute A hA
        (hDA (commutator_mem_commutator a'.property (mem_zpowers b)))
        (hDA (commutator_mem_commutator a.property (mem_zpowers b)))).eq }
  have hd (a : A) : d a = ⁅(a : E), b⁆ := rfl
  have hconj {z : E} (hz : z ∈ d.range) : b * z * b⁻¹ ∈ d.range := by
    obtain ⟨a, rfl⟩ := hz
    refine ⟨⟨b * a * b⁻¹, (mem_normalizer_iff.mp hb a).mp a.property⟩, ?_⟩
    simp only [hd]
    conv_rhs => rw [conjugate_commutatorElement]
    simp
  have hp (a : E) (ha : a ∈ A) (n : ℕ) : ⁅a, b ^ n⁆ ∈ d.range := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ', commutatorElement_mul_right_eq_mul_conj,
        mul_assoc, mul_assoc, ← mul_assoc b]
      exact d.range.mul_mem ⟨⟨a,ha⟩,rfl⟩ (hconj ih)
  refine ⟨d, hd, le_antisymm ?_ ?_⟩
  · rintro z ⟨a,rfl⟩
    exact commutator_mem_commutator (mem_sup_left a.property) (mem_sup_right (mem_zpowers b))
  · apply (derived_join_le A (zpowers b) hA inferInstance hn).trans
    apply commutator_le.mpr
    intro a ha y hy
    obtain ⟨n,rfl⟩ := (mem_powers_iff_mem_zpowers.mpr hy)
    exact hp a ha n

private theorem commute_lifts_of_cubic_norm
    {E G : Type*} [Group E] [Group G]
    (f : E →* G) (hk : f.ker ≤ center E)
    (T : Subgroup G) (c : G) (hc : c ∈ normalizer (T : Set G))
    (hT : IsMulCommutative (T.comap f)) (hcube : c ^ 3 = 1)
    (a b u : E) (hu : f u ∈ T) (hb : f b = c)
    (ha : f a = f u * (c * f u * c⁻¹) * (c ^ 2 * f u * (c ^ 2)⁻¹)) :
    Commute a b := by
  let A := T.comap f
  let : IsMulCommutative A := hT
  let : CommGroup A := IsMulCommutative.instCommGroup
  have hbA : b ∈ normalizer (A : Set E) := by
    apply mem_normalizer_iff.mpr
    intro x
    change f x ∈ T ↔ f (b*x*b⁻¹) ∈ T
    simpa only [map_mul, map_inv, hb] using mem_normalizer_iff.mp hc (f x)
  let s : MulAut A := A.normalizerMonoidHom ⟨b,hbA⟩
  have hs_apply (k : ℕ) (x : A) : ((s ^ k) x : E) = b ^ k * x * (b ^ k)⁻¹ := by
    change ((A.normalizerMonoidHom ⟨b,hbA⟩ ^ k) x : E) = _
    rw [← map_pow]
    rfl
  have hs : s ^ 3 = 1 := by
    ext x
    rw [hs_apply]
    have hz : b ^ 3 ∈ center E := hk (by rw [MonoidHom.mem_ker, map_pow, hb, hcube])
    rw [(mem_center_iff.mp hz x).symm, mul_inv_cancel_right]
    rfl
  let n : A := MulAut.cyclicNorm s 3 ⟨u,hu⟩
  have hn : b * (n : E) * b⁻¹ = n := by
    exact congrArg Subtype.val (MulAut.cyclicNorm_fixed s hs ⟨u,hu⟩)
  have hnv : (n : E) = u * (b*u*b⁻¹) * (b^2*u*(b^2)⁻¹) := by
    simp only [n, MulAut.cyclicNorm_apply, Finset.prod_range_succ, Finset.range_zero,
      Finset.prod_empty, one_mul]
    change ((s ^ 0) ⟨u,hu⟩ : E) * ((s ^ 1) ⟨u,hu⟩ : E) *
      ((s ^ 2) ⟨u,hu⟩ : E) = _
    rw [hs_apply 0, hs_apply 1, hs_apply 2]
    simp
  have hfn : f a = f n := by
    rw [hnv]
    simpa only [map_mul, map_inv, map_pow, hb] using ha
  apply commutatorElement_eq_one_iff_commute.mp
  rw [CentralExtension.commutator_eq_of_image_eq f hk hfn rfl]
  exact (show Commute (n : E) b from (mul_inv_eq_iff_eq_mul.mp hn).symm).commutator_eq

/-- If every torus element fixed by a cubic supplement is an orbit norm,
the derived subgroup of the full local preimage meets the covering kernel
trivially. The full torus preimage, rather than only the torus, must be abelian. -/
public theorem derived_preimage_inf_kernel_eq_bot_of_cubic_norm
    {E G : Type*} [Group E] [Finite E] [Group G]
    (f : E →* G) (hf : Function.Surjective f) (hk : f.ker ≤ center E)
    (T : Subgroup G) (c : G) (hc : c ∈ normalizer (T : Set G))
    (hT : IsMulCommutative (T.comap f)) (hcube : c ^ 3 = 1)
    (hnorm : ∀ t ∈ T, Commute t c → ∃ u ∈ T,
      t = u * (c*u*c⁻¹) * (c^2*u*(c^2)⁻¹)) :
    ⁅(T ⊔ zpowers c).comap f, (T ⊔ zpowers c).comap f⁆ ⊓ f.ker = ⊥ := by
  obtain ⟨b,hb⟩ := hf c
  let A := T.comap f
  have hbA : b ∈ normalizer (A : Set E) := by
    apply mem_normalizer_iff.mpr
    intro a
    change f a ∈ T ↔ f (b*a*b⁻¹) ∈ T
    simpa only [map_mul, map_inv, hb] using mem_normalizer_iff.mp hc (f a)
  have hgen : A ⊔ zpowers b = (T ⊔ zpowers c).comap f := by
    have he : (A ⊔ zpowers b).map f = T ⊔ zpowers c := by
      rw [Subgroup.map_sup, map_comap_eq_self_of_surjective hf, MonoidHom.map_zpowers, hb]
    rw [← he, comap_map_eq_self]
    exact (T.ker_le_comap f).trans le_sup_left
  obtain ⟨d,hd,hrange⟩ := exists_commutator_hom A hT b hbA
  rw [← hgen, ← hrange]
  apply eq_bot_iff.mpr
  rintro z ⟨hz,hzk⟩
  obtain ⟨a,rfl⟩ := hz
  have hac : Commute (f a) c := by
    apply commutatorElement_eq_one_iff_commute.mp
    simpa only [hd, map_commutatorElement, hb] using (show f (d a) = 1 from hzk)
  obtain ⟨u,hu,he⟩ := hnorm (f a) a.property hac
  obtain ⟨v,hv⟩ := hf u
  have hab : Commute (a : E) b := commute_lifts_of_cubic_norm f hk T c hc hT hcube
    a b v (hv ▸ hu) hb (by simpa only [hv] using he)
  exact mem_bot.mpr ((hd a).trans hab.commutator_eq)

/-- Central transfer excludes a kernel prime when a subgroup of prime-to-prime
index has an abelian torus preimage and a cubic supplement with surjective norm
onto its fixed torus. The prime may itself be three. -/
public theorem Cover.not_dvd_card_kernel_of_cubic_norm
    {E G : Type*} [Group E] [Finite E] [Group G] [Finite G]
    (f : Cover E G) {r : ℕ} [Fact r.Prime]
    (T : Subgroup G) (c : G) (hc : c ∈ normalizer (T : Set G))
    (hT : IsMulCommutative (T.comap f.toMonoidHom)) (hcube : c ^ 3 = 1)
    (hnorm : ∀ t ∈ T, Commute t c → ∃ u ∈ T,
      t = u * (c*u*c⁻¹) * (c^2*u*(c^2)⁻¹))
    (hi : ¬ r ∣ (T ⊔ zpowers c).index) :
    ¬ r ∣ Nat.card f.toMonoidHom.ker := by
  let := f.isPerfect
  intro hr
  obtain ⟨z,hz⟩ := exists_prime_orderOf_dvd_card' r hr
  let Z := zpowers (z : E)
  have hZker : Z ≤ f.toMonoidHom.ker := zpowers_le.mpr z.property
  have hzE : orderOf (z : E) = r := (Subgroup.orderOf_coe z).trans hz
  have hZp : IsPGroup r Z := IsPGroup.of_card (n := 1)
    (by simpa only [Z, Nat.card_zpowers, pow_one] using hzE)
  let P := (T ⊔ zpowers c).comap f.toMonoidHom
  have hZD : Z ≤ ⁅P,P⁆ := central_pSubgroup_le_commutator P Z
    (hZker.trans ((T ⊔ zpowers c).ker_le_comap _)) (hZker.trans f.ker_le_center) hZp
    (by rwa [index_comap_of_surjective _ f.surjective])
  have hzbot : (z : E) ∈ (⊥ : Subgroup E) := by
    rw [← derived_preimage_inf_kernel_eq_bot_of_cubic_norm f.toMonoidHom f.surjective
      f.ker_le_center T c hc hT hcube hnorm]
    exact ⟨hZD (mem_zpowers _), z.property⟩
  exact (Fact.out : r.Prime).ne_one
    (hzE.symm.trans (orderOf_eq_one_iff.mpr (mem_bot.mp hzbot)))

end PerfectCentralCovering
