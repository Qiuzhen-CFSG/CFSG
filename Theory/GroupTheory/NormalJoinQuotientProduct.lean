module

public import Theory.GroupTheory.DisjointCommutingProduct
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Two normal factors modulo their intersection

For two normal subgroups `A` and `B`, any homomorphism with kernel
`A ∩ B` maps their join to the internal direct product of their images.
The two images commute because their commutators lie in the kernel;
lifting an element of their intersection proves disjointness.

This is the quotient-product argument used for the two action centralizers
in Aschbacher–Smith 15.3.32(6), printed p.1133. The theorem does not
assert that an arbitrary two-core is generated by those centralizers.
-/

public section

namespace Subgroup

variable {G H : Type*} [Group G] [Group H]

/-- Killing exactly the intersection makes the images disjoint. -/
theorem disjoint_map_of_ker_eq_inf (f : G →* H) (A B : Subgroup G)
    (hker : f.ker = A ⊓ B) : Disjoint (A.map f) (B.map f) := by
  apply disjoint_def.mpr
  rintro x ⟨a, ha, rfl⟩ ⟨b, hb, he⟩
  have hab : a * b⁻¹ ∈ f.ker := by
    change f (a * b⁻¹) = 1
    rw [map_mul, map_inv, he, mul_inv_cancel]
  have haB : a ∈ B := by
    have h := B.mul_mem (show a * b⁻¹ ∈ B from (hker ▸ hab).2) hb
    simpa only [inv_mul_cancel_right] using h
  exact show f a = 1 from (show a ∈ f.ker from hker.symm ▸ ⟨ha, haB⟩)

/-- The product isomorphism is multiplication of the actual quotient images. -/
theorem normal_join_image_direct_product (f : G →* H) (A B : Subgroup G)
    [A.Normal] [B.Normal] (hker : f.ker = A ⊓ B) :
    Disjoint (A.map f) (B.map f) ∧
      ∃ e : A.map f × B.map f ≃* (A ⊔ B).map f,
        ∀ a b, (e (a, b) : H) = (a : H) * (b : H) := by
  have hd := disjoint_map_of_ker_eq_inf f A B hker
  have hc : A.map f ≤ centralizer (B.map f : Set H) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    rw [← map_commutator]
    exact (map_eq_bot_iff _).mpr ((commutator_le_inf A B).trans hker.ge)
  obtain ⟨e, he⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting
    (A.map f) (B.map f) hd hc
  refine ⟨hd, e.trans (MulEquiv.subgroupCongr (map_sup A B f).symm), ?_⟩
  exact he

end Subgroup

end
