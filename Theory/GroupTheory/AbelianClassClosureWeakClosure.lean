module

public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Algebra.Group.Subgroup.Finite
public import Mathlib.Algebra.Group.Conj
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# Weak closure from an abelian conjugacy-class closure

Let `E` be the subgroup of a finite group generated by the conjugates of
an element `z` that lie in `C_G(z)`. If `E` is abelian and its normalizer
is contained in `C_G(z)`, every such conjugate equals `z`.

Suppose `g` sends `z` to a conjugate `t` in its centralizer. Then `t` lies
in `E`. Every generator `x` of `E` commutes with `t`, so its conjugate by
`g⁻¹` centralizes `z`. That conjugate is still conjugate to `z`, hence lies
in `E`. Thus `E` is contained in its image under conjugation by `g`.
Finiteness makes this containment an equality; the normalizer hypothesis
then forces `g` to centralize `z` and consequently `t = z`.

This source-neutral closure argument supplies the final conjugacy transfer
in David Parrott, *A characterization of the Tits' simple group* (1972),
Lemma 2, p. 673. The application must establish the displayed closure
equality from its actual local subgroups.
-/

open Subgroup
open scoped IsMulCommutative

/-- An abelian conjugacy-class closure with this normalizer admits no distinct local conjugate. -/
public theorem conjugate_eq_of_abelian_class_closure_normalizer
    {G : Type*} [Group G] [Finite G] (z : G) (E : Subgroup G)
    [IsMulCommutative E]
    (hgen : E = closure {t : G | t ∈ centralizer ({z} : Set G) ∧ IsConj z t})
    (hN : normalizer (E : Set G) ≤ centralizer ({z} : Set G))
    (t : G) (htH : t ∈ centralizer ({z} : Set G)) (ht : IsConj z t) : t = z := by
  have hmem : ∀ x : G, x ∈ centralizer ({z} : Set G) → IsConj z x → x ∈ E := by
    intro x hxH hx
    rw [hgen]
    exact subset_closure ⟨hxH, hx⟩
  have htE : t ∈ E := hmem t htH ht
  obtain ⟨g, hgt⟩ := isConj_iff.mp ht
  let f : G ≃* G := MulAut.conj g
  have hfz : f z = t := hgt
  have hle : E ≤ E.map f.toMonoidHom := by
    rw [hgen]
    refine (Subgroup.closure_le _).mpr ?_
    intro x hx
    have hxE : x ∈ E := hmem x hx.1 hx.2
    have hxt : x * t = t * x := congrArg Subtype.val
      (mul_comm (⟨x, hxE⟩ : E) (⟨t, htE⟩ : E))
    have hyH : f.symm x ∈ centralizer ({z} : Set G) := by
      apply mem_centralizer_singleton_iff.mpr
      apply f.injective
      simpa only [map_mul, f.apply_symm_apply, hfz] using hxt
    have hyconj : IsConj z (f.symm x) :=
      hx.2.trans (isConj_iff.mpr ⟨g, f.apply_symm_apply x⟩).symm
    exact ⟨f.symm x, by rw [← hgen]; exact hmem _ hyH hyconj, f.apply_symm_apply x⟩
  have heq : E = E.map f.toMonoidHom :=
    eq_of_le_of_card_ge hle (by rw [card_map_of_injective f.injective])
  have hgN : g ∈ normalizer (E : Set G) := mem_normalizer_iff_map_conj_eq.mpr heq.symm
  have hgz : g * z * g⁻¹ = z :=
    mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp (hN hgN))
  exact hgt.symm.trans hgz
