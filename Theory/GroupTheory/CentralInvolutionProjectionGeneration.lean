module
public import Theory.GroupTheory.CentralInvolutionProjection

/-!
# Generation after removing a central factor

Suppose `Z` centralizes `R`, the two factors intersect trivially, and
`t = z * u` with `z ∈ Z` and `u ∈ R`. If `P ≤ R` and `R` is contained in
the group generated by `P` and `t`, then `P` and `u` generate exactly `R`.
The proof writes an element of `R` as a central element times a word in
`P` and `u`; disjointness removes its central coordinate.

This is the generation step in the central reflection change of DGS,
*Groups and Graphs* (1985), (14.17), printed p.222.
-/

public section
open Subgroup
open scoped Pointwise
namespace Theory.GroupTheory
variable {G : Type*} [Group G]

/-- Removing a disjoint central coordinate from a generator recovers the
whole complementary factor, under the original generation containment. -/
theorem sup_zpowers_eq_of_central_factor
    (Z R P : Subgroup G) (hZR : Z ≤ centralizer (R : Set G))
    (hdis : Z ⊓ R = ⊥) (hPR : P ≤ R)
    (t z u : G) (hz : z ∈ Z) (hu : u ∈ R) (htu : t = z * u)
    (hgen : R ≤ P ⊔ zpowers t) : P ⊔ zpowers u = R := by
  let H := P ⊔ zpowers u
  have hHR : H ≤ R := sup_le hPR (zpowers_le.mpr hu)
  apply le_antisymm hHR
  have hZH : Z ≤ centralizer (H : Set G) := by
    intro w hw v hv
    exact hZR hw v (hHR hv)
  have hRZH : R ≤ Z ⊔ H := hgen.trans (sup_le
    (le_sup_left.trans le_sup_right) (zpowers_le.mpr (by
      rw [htu]
      exact (Z ⊔ H).mul_mem (mem_sup_left hz)
        (mem_sup_right (mem_sup_right (mem_zpowers u))))) )
  intro r hr
  have hm : r ∈ (Z : Set G) * (H : Set G) := by
    rw [← coe_mul_of_left_le_normalizer_right Z H
      (hZH.trans (centralizer_le_normalizer _))]
    exact hRZH hr
  obtain ⟨w,hw,v,hv,hprod⟩ := hm
  change w*v=r at hprod
  have hwR : w ∈ R := by
    have he : w = r * v⁻¹ := by
      calc
        w = (w*v)*v⁻¹ := by simp only [mul_assoc, mul_inv_cancel, mul_one]
        _ = r*v⁻¹ := by simp only [hprod]
    rw [he]
    exact R.mul_mem hr (R.inv_mem (hHR hv))
  have hw1 : w = 1 := hdis.le ⟨hw,hwR⟩
  have hrv : r = v := by simpa only [hw1,one_mul] using hprod.symm
  rw [hrv]
  exact hv

end Theory.GroupTheory
