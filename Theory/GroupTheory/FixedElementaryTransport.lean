module

public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.Subgroup.Center

/-!
# Transport of elementary fixed-point central quotients

An isomorphism intertwining two group automorphisms restricts to their fixed
subgroups. It carries elements killed by a power of `p` to exactly such elements,
so it restricts further to the subgroups they generate. Quotienting those
subgroups by their own centers gives an induced isomorphism, compatible with
the canonical quotient maps.

This is the group-theoretic transport used in graph-field constructions. It
keeps the p-generated convention distinct from the p-core and the residual
with p-group quotient. No assertion identifying two split algebraic groups is
made: the intertwining isomorphism must be constructed by the caller. The
embedding variant only requires surjectivity on fixed points, allowing an
infinite ambient group over an algebraic closure. It does not assert that
the whole fixed subgroup is p-generated.

Source: GLS3 §§2.1–2.2, especially the version convention in Theorem 2.2.6
(`refs/KGroup/GLS3/chapter2.tex`).
-/

@[expose] public section

namespace Theory.GroupTheory.FixedElementary

variable {G H : Type*} [Group G] [Group H]

/-- The elements fixed by the specified automorphism. -/
def fixedSubgroup (σ : G ≃* G) : Subgroup G :=
  MonoidHom.eqLocus σ.toMonoidHom (MonoidHom.id G)

/-- The subgroup of fixed points generated by elements of p-power order. -/
def elementarySubgroup (p : ℕ) (σ : G ≃* G) : Subgroup (fixedSubgroup σ) :=
  Subgroup.closure {g | ∃ n : ℕ, g ^ (p ^ n) = 1}

/-- The central quotient of the elementary fixed subgroup. -/
abbrev Carrier (p : ℕ) (σ : G ≃* G) :=
  elementarySubgroup p σ ⧸ Subgroup.center (elementarySubgroup p σ)

/-- Restrict an intertwining isomorphism to the fixed points. -/
def fixedEquiv (σ : G ≃* G) (τ : H ≃* H) (e : G ≃* H)
    (he : ∀ g, e (σ g) = τ (e g)) : fixedSubgroup σ ≃* fixedSubgroup τ where
  toFun g := ⟨e g, by
    change τ (e g) = e g
    rw [← he, show σ g = g from g.property]⟩
  invFun h := ⟨e.symm h, by
    change σ (e.symm h) = e.symm h
    apply e.injective
    rw [he, e.apply_symm_apply]
    exact h.property⟩
  left_inv g := Subtype.ext (e.symm_apply_apply g)
  right_inv h := Subtype.ext (e.apply_symm_apply h)
  map_mul' g g' := Subtype.ext (e.map_mul g g')

/-- An equivariant embedding gives a fixed-point isomorphism when every target
fixed point lies in its image. No ambient surjectivity is required. -/
noncomputable def fixedEquivOfEmbedding (σ : G ≃* G) (τ : H ≃* H)
    (f : G →* H) (hf : Function.Injective f)
    (he : ∀ g, f (σ g) = τ (f g))
    (hfixed : ∀ h, τ h = h → ∃ g, f g = h) :
    fixedSubgroup σ ≃* fixedSubgroup τ := by
  let φ : fixedSubgroup σ →* fixedSubgroup τ :=
    { toFun := fun g => ⟨f g, by
        change τ (f g) = f g
        rw [← he, show σ g = g from g.property]⟩
      map_one' := Subtype.ext f.map_one
      map_mul' := fun g g' => Subtype.ext (f.map_mul g g') }
  apply MulEquiv.ofBijective φ
  constructor
  · intro g g' h
    exact Subtype.ext (hf (congrArg Subtype.val h))
  · intro h
    obtain ⟨g, hg⟩ := hfixed h h.property
    have hfix : σ g = g := hf (by rw [he, hg]; exact h.property)
    exact ⟨⟨g, hfix⟩, Subtype.ext hg⟩

@[simp] theorem fixedEquiv_apply_val (σ : G ≃* G) (τ : H ≃* H) (e : G ≃* H)
    (he : ∀ g, e (σ g) = τ (e g)) (g : fixedSubgroup σ) :
    (fixedEquiv σ τ e he g : H) = e g := rfl

/-- Isomorphisms carry the subgroup generated by p-elements onto its counterpart. -/
theorem map_powClosure (p : ℕ) (e : G ≃* H) :
    (Subgroup.closure {g : G | ∃ n : ℕ, g ^ (p ^ n) = 1}).map e.toMonoidHom =
      Subgroup.closure {h : H | ∃ n : ℕ, h ^ (p ^ n) = 1} := by
  rw [MonoidHom.map_closure]
  congr 1
  ext h
  constructor
  · rintro ⟨g, ⟨n, hn⟩, rfl⟩
    exact ⟨n, by simpa only [map_pow, map_one, MulEquiv.coe_toMonoidHom] using congrArg e hn⟩
  · rintro ⟨n, hn⟩
    refine ⟨e.symm h, ⟨n, ?_⟩, e.apply_symm_apply h⟩
    simpa only [map_pow, map_one] using congrArg e.symm hn

/-- An isomorphism of fixed groups preserves their p-generated subgroups. -/
def elementaryEquivOfFixedEquiv (p : ℕ) (σ : G ≃* G) (τ : H ≃* H)
    (e : fixedSubgroup σ ≃* fixedSubgroup τ) :
    elementarySubgroup p σ ≃* elementarySubgroup p τ :=
  (e.subgroupMap (elementarySubgroup p σ)).trans
    (MulEquiv.subgroupCongr (map_powClosure p e))

/-- Restrict further to the p-generated fixed subgroups. -/
def elementaryEquiv (p : ℕ) (σ : G ≃* G) (τ : H ≃* H) (e : G ≃* H)
    (he : ∀ g, e (σ g) = τ (e g)) :
    elementarySubgroup p σ ≃* elementarySubgroup p τ :=
  elementaryEquivOfFixedEquiv p σ τ (fixedEquiv σ τ e he)

@[simp] theorem elementaryEquiv_apply_val (p : ℕ)
    (σ : G ≃* G) (τ : H ≃* H) (e : G ≃* H)
    (he : ∀ g, e (σ g) = τ (e g)) (g : elementarySubgroup p σ) :
    ((elementaryEquiv p σ τ e he g).val : H) = e g.val := rfl

/-- An isomorphism maps the whole center onto the whole center. -/
theorem map_center (e : G ≃* H) : (Subgroup.center G).map e.toMonoidHom =
    Subgroup.center H := by
  ext h
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact (Subgroup.centerCongr e ⟨g, hg⟩).property
  · intro hh
    refine ⟨e.symm h, ?_, e.apply_symm_apply h⟩
    exact (Subgroup.centerCongr e.symm ⟨h, hh⟩).property

/-- An isomorphism of fixed groups induces one of their elementary central quotients. -/
def carrierEquivOfFixedEquiv (p : ℕ) (σ : G ≃* G) (τ : H ≃* H)
    (e : fixedSubgroup σ ≃* fixedSubgroup τ) : Carrier p σ ≃* Carrier p τ :=
  QuotientGroup.congr _ _ (elementaryEquivOfFixedEquiv p σ τ e)
    (map_center (elementaryEquivOfFixedEquiv p σ τ e))

/-- The elementary central-quotient comparison for an equivariant embedding
whose image contains every fixed point. -/
noncomputable def carrierEquivOfEmbedding (p : ℕ) (σ : G ≃* G) (τ : H ≃* H)
    (f : G →* H) (hf : Function.Injective f)
    (he : ∀ g, f (σ g) = τ (f g))
    (hfixed : ∀ h, τ h = h → ∃ g, f g = h) : Carrier p σ ≃* Carrier p τ :=
  carrierEquivOfFixedEquiv p σ τ (fixedEquivOfEmbedding σ τ f hf he hfixed)

/-- The induced isomorphism of elementary fixed-point central quotients. -/
def carrierEquiv (p : ℕ) (σ : G ≃* G) (τ : H ≃* H) (e : G ≃* H)
    (he : ∀ g, e (σ g) = τ (e g)) : Carrier p σ ≃* Carrier p τ :=
  QuotientGroup.congr _ _ (elementaryEquiv p σ τ e he)
    (map_center (elementaryEquiv p σ τ e he))

@[simp] theorem carrierEquiv_mk (p : ℕ) (σ : G ≃* G) (τ : H ≃* H)
    (e : G ≃* H) (he : ∀ g, e (σ g) = τ (e g)) (g : elementarySubgroup p σ) :
    carrierEquiv p σ τ e he (QuotientGroup.mk g) =
      QuotientGroup.mk (elementaryEquiv p σ τ e he g) := rfl

end Theory.GroupTheory.FixedElementary
