module
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Tactic.Group

/-!
# Combining inner restrictions on commuting subgroups

Suppose an ambient element acts by inner conjugation on each of two commuting
subgroups. There is an element of their join inducing the same conjugation,
so the original actor differs from that element by a centralizer element.
Neither finiteness nor trivial intersection of the factors is needed.

Choose inner conjugators b and c in the respective factors and take w=b*c.
Factor commutation identifies conjugation by w with the prescribed action
on each factor. Consequently w⁻¹*actor centralizes both factors, and hence
the subgroup generated by them.

This elementary product-conjugation argument supports the factor-swap
exclusions in Stellmacher (9.1), Journal of Algebra190 (1997), p.48.
It is extracted from the initial-center factor-swap proof for reuse in the
terminal-core factor-swap proof, without any quaternion-specific assumptions.
-/

namespace Subgroup

/-- Inner conjugation on two commuting factors is induced by an element of
their join, up to an ambient element centralizing that join. -/
public theorem exists_mul_inv_mem_centralizer_of_inner_restrictions
    {G : Type*} [Group G] (left right : Subgroup G)
    (hcomm : ∀ b ∈ left, ∀ c ∈ right, b * c = c * b)
    (actor : G)
    (hleft : ∃ b : G, b ∈ left ∧ ∀ x ∈ left,
      actor * x * actor⁻¹ = b * x * b⁻¹)
    (hright : ∃ c : G, c ∈ right ∧ ∀ x ∈ right,
      actor * x * actor⁻¹ = c * x * c⁻¹) :
    ∃ w : G, w ∈ left ⊔ right ∧
      w⁻¹ * actor ∈ Subgroup.centralizer ((left ⊔ right : Subgroup G) : Set G) := by
  obtain ⟨b, hb, hactB⟩ := hleft
  obtain ⟨c, hc, hactC⟩ := hright
  let w := b * c
  let k := w⁻¹ * actor
  have hwV : w ∈ left ⊔ right := Subgroup.mul_mem_sup hb hc
  have hconj : ∀ x ∈ left, actor * x * actor⁻¹ = w * x * w⁻¹ := by
    intro x hx
    rw [hactB x hx]
    have hcx : c * x * c⁻¹ = x := by rw [(hcomm x hx c hc).symm, mul_inv_cancel_right]
    calc
      b * x * b⁻¹ = b * (c * x * c⁻¹) * b⁻¹ := by rw [hcx]
      _ = w * x * w⁻¹ := by dsimp [w]; group
  have hconj' : ∀ x ∈ right, actor * x * actor⁻¹ = w * x * w⁻¹ := by
    intro x hx
    rw [hactC x hx]
    have hccx : c * x * c⁻¹ ∈ right := right.mul_mem (right.mul_mem hc hx) (right.inv_mem hc)
    have hbx : b * (c * x * c⁻¹) * b⁻¹ = c * x * c⁻¹ := by
      rw [hcomm b hb _ hccx, mul_inv_cancel_right]
    calc
      c * x * c⁻¹ = b * (c * x * c⁻¹) * b⁻¹ := hbx.symm
      _ = w * x * w⁻¹ := by dsimp [w]; group
  have hcentral (D : Subgroup G)
      (hd : ∀ x ∈ D, actor * x * actor⁻¹ = w * x * w⁻¹) :
      k ∈ Subgroup.centralizer (D : Set G) := by
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    have hk : k * x * k⁻¹ = x := by
      calc
        k * x * k⁻¹ = w⁻¹ * (actor * x * actor⁻¹) * w := by dsimp [k]; group
        _ = x := by rw [hd x hx]; group
    exact (mul_inv_eq_iff_eq_mul.mp hk).symm
  have hkV : k ∈ Subgroup.centralizer ((left ⊔ right : Subgroup G) : Set G) := by
    rw [Subgroup.sup_eq_closure, Subgroup.centralizer_closure, Subgroup.mem_centralizer_iff]
    intro x hx
    rcases hx with hx | hx
    · exact Subgroup.mem_centralizer_iff.mp (hcentral left hconj) x hx
    · exact Subgroup.mem_centralizer_iff.mp (hcentral right hconj') x hx
  exact ⟨w, hwV, hkV⟩

end Subgroup
