module

public import Theory.GroupTheory.NormalFourCentralizerSeparation
public import Theory.GroupTheory.SaturatedCentralizer

/-!
# A derived line in a saturated Sylow centralizer excludes fusion

Let `z` be a central involution of a Sylow two-subgroup `S`, and let `E`
be the proper centralizer in `S` of an element `t`. Suppose `E` is maximal
among two-subgroups in the common ambient centralizer of `z` and `t`.
If the derived subgroup of `E` is generated by `z`, then `z` and `t`
are not conjugate.

The derived line makes the ambient normalizer of `E` centralize `z`.
The relative-index promotion theorem then promotes local Sylow maximality
to Sylow maximality in the full centralizer of `t`. Conjugacy would force
`E` to have the same order as `S`. No assumption is made that the common
ambient centralizer is a two-group.

Source: Janko–Thompson, Math. Z. 113 (1970), §4, case (a), printed p.391.
-/

open Subgroup
namespace Sylow

public theorem not_isConj_of_saturated_centralizer_derived_line
    {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    (z t : S) (hz : orderOf z = 2) (hzc : z ∈ center S)
    (hproper : centralizer ({t} : Set S) ≠ ⊤)
    (hline : (_root_.commutator (centralizer ({t} : Set S))).map
      (centralizer ({t} : Set S)).subtype = zpowers z)
    (hsat : ∀ V : Subgroup G, IsPGroup 2 V →
      (centralizer ({t} : Set S)).map (S : Subgroup G).subtype ≤ V →
      V ≤ centralizer ({(z : G), (t : G)} : Set G) →
      V = (centralizer ({t} : Set S)).map (S : Subgroup G).subtype) :
    ¬ IsConj (z : G) (t : G) := by
  let E := centralizer ({t} : Set S)
  let Q := E.map (S : Subgroup G).subtype
  let L := centralizer ({(z : G), (t : G)} : Set G)
  let C := centralizer ({(t : G)} : Set G)
  have hQS : Q ≤ (S : Subgroup G) := map_subtype_le _
  have hQC : Q ≤ C := by
    rw [show Q = (S : Subgroup G) ⊓ C from map_subtype_centralizer_singleton (S : Subgroup G) t]
    exact inf_le_right
  have hSC : (S : Subgroup G) ≤ centralizer ({(z : G)} : Set G) := by
    intro s hs
    exact mem_centralizer_singleton_iff.mpr
      (congrArg Subtype.val (mem_center_iff.mp hzc ⟨s, hs⟩))
  have hQL : Q ≤ L := by
    intro q hq a ha
    rcases Set.mem_insert_iff.mp ha with rfl | ha
    · exact (mem_centralizer_singleton_iff.mp (hSC (hQS hq))).symm
    · have : a = (t : G) := Set.mem_singleton_iff.mp ha
      subst a
      exact (mem_centralizer_singleton_iff.mp (hQC hq)).symm
  have hpQ : IsPGroup 2 Q := (S.isPGroup'.to_subgroup E).map _
  let T : Sylow 2 L := {
    toSubgroup := Q.subgroupOf L
    isPGroup' := hpQ.comap_subtype
    is_maximal' := by
      intro V hpV hQV
      apply map_injective L.subtype_injective
      rw [map_subgroupOf_eq_of_le hQL]
      apply hsat _ (hpV.map _)
      · change Q ≤ V.map L.subtype
        rw [← map_subgroupOf_eq_of_le hQL]
        exact map_mono hQV
      · exact map_subtype_le _ }
  have hlocal : ¬ 2 ∣ Q.relIndex L := T.not_dvd_index
  have hlineG : (_root_.commutator Q).map Q.subtype = zpowers (z : G) := by
    have hh := congrArg (fun D : Subgroup S => D.map (S : Subgroup G).subtype) hline
    rwa [map_subtype_commutator, map_commutator, MonoidHom.map_zpowers,
      ← map_subtype_commutator] at hh
  have hcontrol : normalizer (Q : Set G) ≤ centralizer ({(z : G)} : Set G) :=
    normalizer_le_centralizer_of_characteristic_involution Q (_root_.commutator Q)
      (z : G) ((orderOf_coe z).trans hz) hlineG
  have hmax : ¬ 2 ∣ Q.relIndex C :=
    not_dvd_relIndex_of_normalizer_inf_le Q L C hpQ hQC hlocal (by
      intro q hq a ha
      rcases Set.mem_insert_iff.mp ha with rfl | ha
      · exact (mem_centralizer_singleton_iff.mp (hcontrol hq.1)).symm
      · have : a = (t : G) := Set.mem_singleton_iff.mp ha
        subst a
        exact (mem_centralizer_singleton_iff.mp hq.2).symm)
  have hsmall : Nat.card Q < Nat.card S := by
    rw [card_map_of_injective (S : Subgroup G).subtype_injective]
    have hle := card_le_of_le (show E ≤ ⊤ from le_top)
    rw [card_top] at hle
    apply lt_of_le_of_ne hle
    intro heq
    apply hproper
    apply eq_of_le_of_card_ge le_top
    rw [card_top]
    exact heq.ge
  intro hconj
  exact not_isConj_of_sylow_centralizer_card_lt (t : G) (z : G) Q (S : Subgroup G)
    hpQ S.isPGroup' hQC hSC hmax hsmall hconj.symm

end Sylow
