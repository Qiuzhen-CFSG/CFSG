module

public import Theory.GroupTheory.SpecificGroups.QuaternionPairInvolutionCentralizer
public import Theory.GroupTheory.QuaternionCentralProductCenter
public import Theory.GroupTheory.SpecificGroups.QuaternionEightInvolution
public import Theory.GroupTheory.SylowCentralizerConjugacy
public import Mathlib.GroupTheory.NoncommCoprod

/-!
# Centralizers of noncentral involutions in quaternion central products

Two commuting quaternion eights with intersection of order two form a central
product of order 32. The multiplication map from Q₈ × Q₈ has precisely the
diagonal central involution as kernel. The finite model calculation then shows
that each noncentral involution centralizer is generated by its involutions
and has derived subgroup equal to the shared central involution line.

This is the intrinsic C₂ × D₈ calculation in Janko–Thompson §4, printed
p.390, PDF p.6 of
`refs/original/n-group-global/odd-core-rank-two-source/janko-thompson-1970-gdz.pdf`.
-/

open QuaternionPair

/-- The intrinsic noncentral involution centralizer geometry of Q₈ ◦ Q₈. -/
public theorem Subgroup.quaternion_central_product_involution_centralizer_geometry
    {G : Type*} [Group G] [Finite G]
    (B C : Subgroup G)
    (eB : B ≃* Q) (eC : C ≃* Q)
    (hjoin : B ⊔ C = ⊤)
    (hinter : Nat.card (B ⊓ C : Subgroup G) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b*c=c*b)
    (z t : G) (hz : orderOf z = 2) (hzC : z ∈ Subgroup.center G)
    (ht : orderOf t = 2) (htz : t ≠ z) :
    let D := Subgroup.centralizer ({t} : Set G)
    Subgroup.closure {x : G | x ∈ D ∧ orderOf x = 2} = D ∧
      (_root_.commutator D).map D.subtype = Subgroup.zpowers z := by
  classical
  let fB : Q →* G := B.subtype.comp eB.symm.toMonoidHom
  let fC : Q →* G := C.subtype.comp eC.symm.toMonoidHom
  let f : M →* G := fB.noncommCoprod fC (fun a b =>
    show Commute (fB a) (fC b) from hcomm _ (eB.symm a).property _ (eC.symm b).property)
  have hfB : fB.range = B := by
    dsimp [fB]
    rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eB.symm.surjective,
      ← MonoidHom.range_eq_map, B.range_subtype]
  have hfC : fC.range = C := by
    dsimp [fC]
    rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eC.symm.surjective,
      ← MonoidHom.range_eq_map, C.range_subtype]
  have hfrange : f.range = B ⊔ C := by
    dsimp [f]
    rw [MonoidHom.noncommCoprod_range, hfB, hfC]
  have hf : Function.Surjective f := MonoidHom.range_eq_top.mp (hfrange.trans hjoin)
  have hBn : C ≤ Subgroup.normalizer (B : Set G) := by
    apply le_trans ?_ (Subgroup.centralizer_le_normalizer _)
    intro c hc b hb
    exact hcomm b hb c hc
  have hBcard : Nat.card B = 8 := by
    rw [Nat.card_congr eB.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
  have hCcard : Nat.card C = 8 := by
    rw [Nat.card_congr eC.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
  have hGcard : Nat.card G = 32 := by
    have hh := Subgroup.card_mul_eq_card_inf_mul_card_sup_of_normalizes B C hBn
    rw [hBcard, hCcard, hinter, hjoin,
      Nat.card_congr Subgroup.topEquiv.toEquiv] at hh
    omega
  obtain ⟨w, hwne, _⟩ :=
    (Nat.card_eq_two_iff' (1 : (B ⊓ C : Subgroup G))).mp hinter
  have hw2 : (w : G) ^ 2 = 1 := by
    have hh := pow_card_eq_one' (x := w)
    rw [hinter] at hh
    exact congrArg Subtype.val hh
  let wb : B := ⟨w, w.property.1⟩
  let wc : C := ⟨w, w.property.2⟩
  have hwb2 : wb ^ 2 = 1 := Subtype.ext hw2
  have hwc2 : wc ^ 2 = 1 := Subtype.ext hw2
  have hwbne : wb ≠ 1 := fun h => hwne (Subtype.ext
    (congrArg (fun b : B => (b : G)) h))
  have hwcne : wc ≠ 1 := fun h => hwne (Subtype.ext
    (congrArg (fun c : C => (c : G)) h))
  have heB : eB wb = QuaternionGroup.a 2 :=
    QuaternionGroup.eq_a_two_of_orderOf_eq_two _ (by
      rw [eB.orderOf_eq]
      exact orderOf_eq_prime hwb2 hwbne)
  have heC : eC wc = QuaternionGroup.a 2 :=
    QuaternionGroup.eq_a_two_of_orderOf_eq_two _ (by
      rw [eC.orderOf_eq]
      exact orderOf_eq_prime hwc2 hwcne)
  have hfb : fB (QuaternionGroup.a 2) = w := by
    change ((eB.symm (QuaternionGroup.a 2) : B) : G) = w
    rw [← heB, eB.symm_apply_apply]
  have hfc : fC (QuaternionGroup.a 2) = w := by
    change ((eC.symm (QuaternionGroup.a 2) : C) : G) = w
    rw [← heC, eC.symm_apply_apply]
  have hzz : f zz = 1 := by
    change fB (QuaternionGroup.a 2) * fC (QuaternionGroup.a 2) = 1
    rw [hfb, hfc, ← pow_two, hw2]
  have hkerCard : Nat.card f.ker = 2 := by
    have hh := f.ker.card_mul_index
    rw [Subgroup.index_ker, hfrange, hjoin, Nat.card_congr Subgroup.topEquiv.toEquiv, hGcard,
      show Nat.card M = 64 by rw [Nat.card_eq_fintype_card]; decide] at hh
    omega
  have hker : ∀ p : M, f p = 1 ↔ ker p := by
    obtain ⟨k, hk, huniq⟩ := (Nat.card_eq_two_iff' (1 : f.ker)).mp hkerCard
    have hzker : (⟨zz, hzz⟩ : f.ker) ≠ 1 := by
      intro he
      exact (by decide : zz ≠ 1) (congrArg Subtype.val he)
    have hkz := huniq ⟨zz, hzz⟩ hzker
    intro p
    constructor
    · intro hp
      by_cases hp1 : p = 1
      · exact Or.inl hp1
      · right
        have hpk : (⟨p, hp⟩ : f.ker) ≠ 1 := fun h => hp1 (congrArg Subtype.val h)
        exact congrArg Subtype.val ((huniq ⟨p,hp⟩ hpk).trans hkz.symm)
    · rintro (rfl | rfl)
      · exact map_one f
      · exact hzz
  have hzmap : f zb = z := by
    have hcenterCard : Nat.card (Subgroup.center G) = 2 := by
      have hh := Subgroup.quaternion_central_product_center_card B C
        ⟨eB⟩ ⟨eC⟩ hinter hcomm
      rw [hjoin] at hh
      exact (Nat.card_congr
        (Subgroup.centerCongr Subgroup.topEquiv.symm).toEquiv).trans hh
    let K := Subgroup.centralizer ({(w : G)} : Set G)
    have hBK : B ≤ K := by
      intro b hb
      exact Subgroup.mem_centralizer_singleton_iff.mpr (hcomm b hb w w.property.2)
    have hCK : C ≤ K := by
      intro c hc
      exact Subgroup.mem_centralizer_singleton_iff.mpr (hcomm w w.property.1 c hc).symm
    have hwcenter : (w : G) ∈ Subgroup.center G := by
      apply Subgroup.mem_center_iff.mpr
      intro x
      have hx : x ∈ K := by
        have htop : (⊤ : Subgroup G) ≤ K := by rw [← hjoin]; exact sup_le hBK hCK
        exact htop (Subgroup.mem_top x)
      exact (Subgroup.mem_centralizer_singleton_iff.mp hx)
    have hz1 : z ≠ 1 := by intro he; simp [he] at hz
    obtain ⟨u, _, huniq⟩ :=
      (Nat.card_eq_two_iff' (1 : Subgroup.center G)).mp hcenterCard
    have hwcenterNe : (⟨w, hwcenter⟩ : Subgroup.center G) ≠ 1 := by
      intro he
      exact hwne (Subtype.ext (congrArg
        (fun v : Subgroup.center G => (v : G)) he))
    have hzcenterNe : (⟨z, hzC⟩ : Subgroup.center G) ≠ 1 := by
      intro he
      exact hz1 (congrArg Subtype.val he)
    have hwz : (w : G) = z := congrArg Subtype.val
      ((huniq ⟨w, hwcenter⟩ hwcenterNe).trans
        (huniq ⟨z, hzC⟩ hzcenterNe).symm)
    change fB (QuaternionGroup.a 2) * fC 1 = z
    rw [hfb, map_one, mul_one, hwz]
  have hresult := quaternion_pair_centralizer_geometry f hf hker t ht (by rw [hzmap]; exact htz)
  simpa only [hzmap] using hresult

/-- The intrinsic centralizer geometry inside an actual ambient subgroup. -/
public theorem Subgroup.quaternion_central_product_involution_centralizer_geometry_in_ambient
    {P : Type*} [Group P] [Finite P]
    (H : Subgroup P) (B C : Subgroup H)
    (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hjoin : B ⊔ C = ⊤)
    (hinter : Nat.card (B ⊓ C : Subgroup H) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b*c=c*b)
    (z t : P) (hz : orderOf z = 2) (hzC : z ∈ Subgroup.center P)
    (hzH : z ∈ H) (ht : orderOf t = 2) (htH : t ∈ H) (htz : t ≠ z) :
    let D := H ⊓ Subgroup.centralizer ({t} : Set P)
    Subgroup.closure {x : P | x ∈ D ∧ orderOf x = 2} = D ∧
      (_root_.commutator D).map D.subtype = Subgroup.zpowers z := by
  classical
  intro D
  let zH : H := ⟨z, hzH⟩
  let tH : H := ⟨t, htH⟩
  let J := Subgroup.centralizer ({tH} : Set H)
  have hzHord : orderOf zH = 2 := (Subgroup.orderOf_coe zH).symm.trans hz
  have htHord : orderOf tH = 2 := (Subgroup.orderOf_coe tH).symm.trans ht
  have hzHcenter : zH ∈ Subgroup.center H := by
    apply Subgroup.mem_center_iff.mpr
    intro x
    exact Subtype.ext (Subgroup.mem_center_iff.mp hzC x)
  have htzH : tH ≠ zH := fun h => htz (congrArg Subtype.val h)
  obtain ⟨eB⟩ := hB
  obtain ⟨eC⟩ := hC
  obtain ⟨hgen, hline⟩ :=
    Subgroup.quaternion_central_product_involution_centralizer_geometry
      B C eB eC hjoin hinter hcomm zH tH hzHord hzHcenter htHord htzH
  have hmap : J.map H.subtype = D := by
    exact Subgroup.map_subtype_centralizer_singleton H tH
  have hset : H.subtype '' {x : H | x ∈ J ∧ orderOf x = 2} =
      {x : P | x ∈ D ∧ orderOf x = 2} := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨hmap ▸ Subgroup.mem_map_of_mem H.subtype hy.1,
        (Subgroup.orderOf_coe y).trans hy.2⟩
    · rintro ⟨hxD, hx2⟩
      have hxH : x ∈ H := hxD.1
      refine ⟨⟨x, hxH⟩, ?_, rfl⟩
      constructor
      · have hxmap : x ∈ J.map H.subtype := hmap.symm ▸ hxD
        obtain ⟨y, hy, he⟩ := hxmap
        have hyeq : y = (⟨x, hxH⟩ : H) := Subtype.ext he
        exact hyeq ▸ hy
      · exact (Subgroup.orderOf_coe (⟨x, hxH⟩ : H)).symm.trans hx2
  have hgenP : Subgroup.closure {x : P | x ∈ D ∧ orderOf x = 2} = D := by
    calc
      Subgroup.closure {x : P | x ∈ D ∧ orderOf x = 2} =
          Subgroup.closure (H.subtype '' {x : H | x ∈ J ∧ orderOf x = 2}) := by rw [hset]
      _ = (Subgroup.closure {x : H | x ∈ J ∧ orderOf x = 2}).map H.subtype :=
        (MonoidHom.map_closure H.subtype _).symm
      _ = J.map H.subtype := by rw [hgen]
      _ = D := hmap
  have hlineP : (_root_.commutator D).map D.subtype = Subgroup.zpowers z := by
    have hlineJ : ⁅J,J⁆ = Subgroup.zpowers zH := by
      simpa only [Subgroup.map_subtype_commutator] using hline
    calc
      (_root_.commutator D).map D.subtype = ⁅D,D⁆ := Subgroup.map_subtype_commutator D
      _ = ⁅J.map H.subtype,J.map H.subtype⁆ := by rw [hmap]
      _ = (⁅J,J⁆).map H.subtype := (Subgroup.map_commutator J J H.subtype).symm
      _ = (Subgroup.zpowers zH).map H.subtype := by rw [hlineJ]
      _ = Subgroup.zpowers z := by rw [MonoidHom.map_zpowers]; rfl
  exact ⟨hgenP, hlineP⟩
