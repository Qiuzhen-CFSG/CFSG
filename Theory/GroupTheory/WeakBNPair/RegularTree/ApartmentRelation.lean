module
public import Theory.GroupTheory.WeakBNPair.RegularTree.QuotientAction
public import Theory.GroupTheory.WeakBNPair.RegularTree.FiniteClasses
public import Mathlib.Combinatorics.SimpleGraph.Acyclic

/-!
# The apartment relation and its finite class set

The elementary relation identifies endpoints of a path of length `2n` contained
in one translate of the chosen apartment. On a tree this is precisely the
source distance-and-unique-path definition. Reversing and translating paths
proves symmetry and invariance, including after taking the equivalence closure.

Extending every `(n+1)`-path to an apartment `2n`-path gives a strictly closer
equivalent vertex outside the radius-`n` ball. Finite valences then prove that
the actual class set is finite. The separation of different equivalent vertices
is a separate obligation; it is not implied by this finiteness argument.

Source: Delgado--Goldschmidt--Stellmacher, *Groups and Graphs* (1985),
Part II, (3.6), printed pp.77--78, with `n = s - 1`.
-/

@[expose] public section
namespace Theory.GroupTheory.WeakBNPair.RegularTree
universe u v
variable {X : Type u} {V : Type v} [Group X] [MulAction X V]
variable (Γ : SimpleGraph V) (T : Set V) (n : ℕ)

/-- Every vertex of the walk lies in one translate of the chosen apartment. -/
def InApartment {a b : V} (p : Γ.Walk a b) : Prop :=
  ∃ g : X, ∀ z ∈ p.support, ∃ t ∈ T, g • t = z

/-- The elementary identification in DGS (3.6): endpoints of an apartment
path of length `2 * (s - 1)`. Its equivalence closure is taken below. -/
def ApartmentStep (a b : V) : Prop :=
  ∃ p : Γ.Walk a b, p.IsPath ∧ p.length = 2 * n ∧ InApartment (X := X) Γ T p

/-- The actual equivalence relation generated by the apartment identifications. -/
def apartmentSetoid : Setoid V := Relation.EqvGen.setoid (ApartmentStep (X := X) Γ T n)

variable {Γ T n}

theorem apartmentStep_symm {a b : V} (h : ApartmentStep (X := X) Γ T n a b) :
    ApartmentStep (X := X) Γ T n b a := by
  obtain ⟨p, hp, hlen, g, hT⟩ := h
  refine ⟨p.reverse, hp.reverse, ?_, g, ?_⟩
  · simpa only [SimpleGraph.Walk.length_reverse] using hlen
  · intro z hz
    exact hT z (by simpa only [SimpleGraph.Walk.support_reverse, List.mem_reverse] using hz)

/-- On a tree the path definition is literally the source's distance `2n`
and containment of its unique path in an apartment. -/
theorem apartmentStep_distance (htree : Γ.IsTree) {a b : V}
    (h : ApartmentStep (X := X) Γ T n a b) : Γ.dist a b = 2 * n := by
  obtain ⟨p, hp, hlen, _⟩ := h
  obtain ⟨q, hq, hqdist⟩ := htree.connected.exists_path_of_dist a b
  have he : (⟨p, hp⟩ : Γ.Path a b) = ⟨q, hq⟩ :=
    (htree.isAcyclic.subsingleton_path a b).elim _ _
  have hpq : p = q := congrArg Subtype.val he
  rw [← hqdist, ← hpq, hlen]

theorem apartmentStep_smul
    (hact : ∀ (g : X) {a b : V}, Γ.Adj a b → Γ.Adj (g • a) (g • b))
    (g : X) {a b : V} (h : ApartmentStep (X := X) Γ T n a b) :
    ApartmentStep (X := X) Γ T n (g • a) (g • b) := by
  obtain ⟨p, hp, hlen, k, hT⟩ := h
  let f : Γ →g Γ := ⟨(g • ·), hact g⟩
  refine ⟨p.map f, hp.map (MulAction.toPerm g).injective, ?_, g * k, ?_⟩
  · simpa only [SimpleGraph.Walk.length_map] using hlen
  · intro z hz
    rw [SimpleGraph.Walk.support_map, List.mem_map] at hz
    obtain ⟨w, hw, rfl⟩ := hz
    obtain ⟨t, ht, he⟩ := hT w hw
    exact ⟨t, ht, by change (g * k) • t = g • w; rw [mul_smul, he]⟩

/-- Invariance survives taking the equivalence closure, so the group action
on this particular source quotient is well-defined. -/
theorem apartmentSetoid_invariant
    (hact : ∀ (g : X) {a b : V}, Γ.Adj a b → Γ.Adj (g • a) (g • b)) :
    Invariant (X := X) (apartmentSetoid (X := X) Γ T n) := by
  intro g a b h
  induction h with
  | rel a b hab => exact Relation.EqvGen.rel _ _ (apartmentStep_smul hact g hab)
  | refl a => exact Relation.EqvGen.refl _
  | symm a b _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans a b c _ _ hab hbc => exact Relation.EqvGen.trans _ _ _ hab hbc

/-- The local extension used for finiteness. Each path of length `s = n+1`
extends inside an apartment to length `2n`, with its original endpoint retained
at position `n+1`. On a tree the initial path is then forced to be the same. -/
def ApartmentExtension (Γ : SimpleGraph V) (T : Set V) (n : ℕ) : Prop :=
  ∀ {x z : V} (p : Γ.Walk x z), p.IsPath → p.length = n + 1 →
    ∃ y, ∃ q : Γ.Walk x y, q.IsPath ∧ q.length = 2 * n ∧
      InApartment (X := X) Γ T q ∧ q.getVert (n + 1) = z

/-- The apartment extension supplies the shortening operation; no quotient
finiteness or diameter bound is a premise. -/
theorem apartment_shortening (hconn : Γ.Connected)
    (hext : ApartmentExtension (X := X) Γ T n) (a x : V) (hx : n < Γ.dist a x) :
    ∃ y, (apartmentSetoid (X := X) Γ T n) x y ∧ Γ.dist a y < Γ.dist a x := by
  obtain ⟨p, hp, hlen⟩ := hconn.exists_path_of_dist x a
  have hle : n + 1 ≤ p.length := by rw [hlen, SimpleGraph.dist_comm]; omega
  obtain ⟨y, q, hq, hqlen, hqT, hprefix⟩ :=
    hext (p.take (n + 1)) (hp.take _) (by
      rw [SimpleGraph.Walk.take_length, min_eq_left hle])
  refine ⟨y, Relation.EqvGen.rel _ _ ⟨q, hq, hqlen, hqT⟩, ?_⟩
  apply closer_of_long_prefix Γ hconn q hqlen
  rw [hprefix]
  have htail := SimpleGraph.dist_le (p.drop (n + 1))
  have hhead := SimpleGraph.dist_le (p.take (n + 1))
  rw [SimpleGraph.Walk.drop_length] at htail
  rw [SimpleGraph.Walk.take_length, min_eq_left hle] at hhead
  have htri := hconn.dist_triangle (u := x) (v := p.getVert (n + 1)) (w := a)
  rw [SimpleGraph.dist_comm (u := p.getVert (n + 1)) (v := a)] at htail htri
  rw [SimpleGraph.dist_comm (u := x) (v := a)] at hlen htri
  omega

/-- The quotient vertices constructed from the source apartment paths are
finite, including when the original tree and its acting group are infinite. -/
theorem finite_apartment_classes (hconn : Γ.Connected)
    (hfinite : ∀ a, (Γ.neighborSet a).Finite)
    (hext : ApartmentExtension (X := X) Γ T n) (a : V) :
    Finite (Quotient (apartmentSetoid (X := X) Γ T n)) :=
  finite_classes_of_shortening Γ hconn hfinite _ a n (apartment_shortening hconn hext a)

end Theory.GroupTheory.WeakBNPair.RegularTree
