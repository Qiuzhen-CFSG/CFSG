module
public import Theory.GroupTheory.WeakBNPair.RegularTree.RootExchange
public import Theory.AlgebraicGroup.BNPair.StandardParabolicCore
public import Mathlib.Data.Set.Card

/-!
# A marked rank-two Tits system from root and endpoint data

The two actual endpoint groups have two Borel double cosets and at least three
Borel cosets. The normalizer is generated by its Borel intersection and the two
chosen reflections. Root factorization and the positive/opposite containment
alternative give exchange by the calculation of `RootExchange`.

We construct the existing `TitsSystem`, with exactly the two marked simple
reflections, and identify each endpoint with its singleton standard parabolic.
No finite-group recognition, Weyl-group classification, or exchange axiom
is assumed in the input. The geometric root-sign input must still be proved
from apartments in the source application.

Source: DGS, *Groups and Graphs* (1985), Part II, (3.7), pp.79–80.
-/

@[expose] public section
namespace Theory.GroupTheory.WeakBNPair.RegularTree
open Theory.AlgebraicGroup
open Theory.AlgebraicGroup.TitsSystem
open scoped Pointwise
variable {X : Type*} [Group X]

/-- Structural input to the algebraic part of (3.7). `thick` says that the
endpoint has a coset besides `B` and `B t`; it is a local degree condition. -/
structure RootPairData where
  B : Subgroup X
  N : Subgroup X
  endpoint : Bool → Subgroup X
  lift : Bool → N
  root : Bool → Subgroup X
  fixed : Bool → Subgroup X
  borel_le : ∀ i, B ≤ endpoint i
  lift_mem : ∀ i, (lift i : X) ∈ endpoint i
  lift_not_mem : ∀ i, (lift i : X) ∉ B
  overlap : endpoint false ⊓ endpoint true = B
  generated : endpoint false ⊔ endpoint true = ⊤
  cells : ∀ i x, x ∈ endpoint i → x ∈ B ∨
    ∃ a c, a ∈ B ∧ c ∈ B ∧ x = a * (lift i : X) * c
  thick : ∀ i, ∃ x ∈ endpoint i, x ∉ B ∧ x * (lift i : X)⁻¹ ∉ B
  square : ∀ i, (lift i : X) * (lift i : X) ∈ B
  normal : ((B ⊓ N).subgroupOf N).Normal
  normalizer_generated : N ≤ Subgroup.closure
    ((B ⊓ N : Subgroup X) ∪ Set.range fun i => (lift i : X))
  factor : ∀ i b, b ∈ B → ∃ b₀ ∈ fixed i, ∃ r ∈ root i, b = b₀ * r
  conjugate_fixed : ∀ i b₀, b₀ ∈ fixed i → (lift i : X) * b₀ * (lift i : X)⁻¹ ∈ B
  root_sign : ∀ i n, n ∈ N →
    (∀ r ∈ root i, n⁻¹ * r * n ∈ B) ∨
    (∀ r ∈ root i, ((lift i : X) * n)⁻¹ * r * ((lift i : X) * n) ∈ B)

namespace RootPairData
variable (d : RootPairData (X := X))

instance intersectionNormal : ((d.B ⊓ d.N).subgroupOf d.N).Normal := d.normal

/-- The marked simple classes use the literal reflection lifts. -/
def simple (i : Bool) : d.N ⧸ (d.B ⊓ d.N).subgroupOf d.N :=
  QuotientGroup.mk' ((d.B ⊓ d.N).subgroupOf d.N) (d.lift i)

/-- Endpoint generation and their two-cell decompositions give BN generation. -/
theorem generate : Subgroup.closure ((d.B : Set X) ∪ (d.N : Set X)) = ⊤ := by
  apply top_unique
  rw [← d.generated]
  apply sup_le
  all_goals
    intro x hx
    rcases d.cells _ x hx with hb | ⟨a, c, ha, hc, rfl⟩
    · exact Subgroup.subset_closure (Or.inl hb)
    · exact Subgroup.mul_mem _ (Subgroup.mul_mem _
        (Subgroup.subset_closure (Or.inl ha))
        (Subgroup.subset_closure (Or.inr (d.lift _).property)))
        (Subgroup.subset_closure (Or.inl hc))

theorem simple_ne_one (i : Bool) : d.simple i ≠ 1 := by
  intro he
  have hm : d.lift i ∈ (d.B ⊓ d.N).subgroupOf d.N := (QuotientGroup.eq_one_iff _).mp he
  exact d.lift_not_mem i hm.1

theorem simple_square (i : Bool) : d.simple i ^ 2 = 1 := by
  change (QuotientGroup.mk' ((d.B ⊓ d.N).subgroupOf d.N) (d.lift i)) ^ 2 = 1
  rw [← map_pow]
  apply (QuotientGroup.eq_one_iff _).mpr
  change (d.lift i : X) ^ 2 ∈ d.B ⊓ d.N
  constructor
  · change (d.lift i : X) ^ 2 ∈ d.B
    rw [pow_two]
    exact d.square i
  · exact d.N.pow_mem (d.lift i).property 2

/-- The two simple classes are distinct because the original endpoints meet
in the Borel. No dihedral classification is needed. -/
theorem simple_injective : Function.Injective d.simple := by
  have hne : d.simple false ≠ d.simple true := by
    intro he
    have hk : (d.lift false)⁻¹ * d.lift true ∈ (d.B ⊓ d.N).subgroupOf d.N :=
      QuotientGroup.eq.mp he
    change ((d.lift false : X)⁻¹ * (d.lift true : X)) ∈ d.B ⊓ d.N at hk
    have hleft : (d.lift true : X) ∈ d.endpoint false := by
      have hh := (d.endpoint false).mul_mem (d.lift_mem false) (d.borel_le false hk.1)
      simpa only [Subgroup.coe_mul, Subgroup.coe_inv, mul_inv_cancel_left] using hh
    apply d.lift_not_mem true
    rw [← d.overlap]
    exact ⟨hleft, d.lift_mem true⟩
  intro i j hij
  cases i <;> cases j
  · rfl
  · exact (hne hij).elim
  · exact (hne hij.symm).elim
  · rfl

/-- The Cartan part vanishes in the Weyl quotient, leaving the two lifts as
generators of the actual quotient. -/
theorem quotient_generate : Subgroup.closure (Set.range d.simple) = ⊤ := by
  let q := QuotientGroup.mk' ((d.B ⊓ d.N).subgroupOf d.N)
  let H := (Subgroup.closure (Set.range d.simple)).comap q
  have hle : Subgroup.closure
      ((d.B ⊓ d.N : Subgroup X) ∪ Set.range fun i => (d.lift i : X)) ≤ H.map d.N.subtype := by
    apply (Subgroup.closure_le _).mpr
    rintro x (hx | ⟨i, rfl⟩)
    · refine ⟨⟨x, hx.2⟩, ?_, rfl⟩
      change q ⟨x, hx.2⟩ ∈ Subgroup.closure (Set.range d.simple)
      have he : q ⟨x, hx.2⟩ = 1 := (QuotientGroup.eq_one_iff _).mpr hx
      rw [he]
      exact Subgroup.one_mem _
    · exact ⟨d.lift i, Subgroup.subset_closure ⟨i, rfl⟩, rfl⟩
  apply top_unique
  intro w _
  obtain ⟨n, rfl⟩ := QuotientGroup.mk'_surjective ((d.B ⊓ d.N).subgroupOf d.N) w
  obtain ⟨m, hm, he⟩ := hle (d.normalizer_generated n.property)
  have hmn : m = n := Subtype.ext he
  subst m
  exact hm

/-- The algebraic root calculation supplies the selected-representative
exchange law. -/
theorem lift_exchange : Theory.AlgebraicGroup.BruhatGeneration.SimpleLiftExchange
    d.B d.N (Set.range fun i => (d.lift i : X)) :=
  simpleLiftExchange_of_roots d.B d.N d.endpoint d.fixed d.root (fun i => (d.lift i : X))
    d.borel_le d.lift_mem d.square d.cells d.factor d.conjugate_fixed d.root_sign

/-- Exchange holds for all representatives of the two quotient classes,
as required by the repository's `TitsSystem` interface. -/
theorem exchange (s : d.N ⧸ (d.B ⊓ d.N).subgroupOf d.N) (hs : s ∈ Set.range d.simple)
    (w : d.N ⧸ (d.B ⊓ d.N).subgroupOf d.N) :
    representativeSet d.B d.N s * (d.B : Set X) * representativeSet d.B d.N w ⊆
      ((d.B : Set X) * representativeSet d.B d.N (s * w) * (d.B : Set X)) ∪
        ((d.B : Set X) * representativeSet d.B d.N w * (d.B : Set X)) := by
  obtain ⟨i, rfl⟩ := hs
  obtain ⟨n, hn⟩ := QuotientGroup.mk'_surjective ((d.B ⊓ d.N).subgroupOf d.N) w
  rw [mul_assoc, B_mul_representativeSet d.B d.N w n hn, ← mul_assoc,
    representativeSet_mul_B d.B d.N (d.simple i) (d.lift i) rfl]
  intro x hx
  obtain ⟨y, ⟨t, ht, b, hb, rfl⟩, n', hn', rfl⟩ := hx
  have ht' : t = (d.lift i : X) := ht
  have hn' : n' = (n : X) := hn'
  subst t
  subst n'
  obtain ⟨a, c, ha, hc, he | he⟩ := d.lift_exchange (d.lift i) ⟨i, rfl⟩ b hb n n.property
  · left
    change (d.lift i : X) * b * (n : X) ∈ _
    rw [he, B_mul_representativeSet_mul_B d.B d.N (d.simple i * w) (d.lift i * n)
      (by rw [map_mul, hn]; rfl)]
    exact DoubleCoset.mem_doubleCoset.mpr ⟨a, ha, c, hc, rfl⟩
  · right
    change (d.lift i : X) * b * (n : X) ∈ _
    rw [he]
    exact DoubleCoset.mem_doubleCoset.mpr ⟨a, ha, c, hc, rfl⟩

/-- Thickness excludes a normal rank-one Borel and gives BN nontriviality. -/
theorem nontrivial (s : d.N ⧸ (d.B ⊓ d.N).subgroupOf d.N) (hs : s ∈ Set.range d.simple) :
    representativeSet d.B d.N s * (d.B : Set X) * representativeSet d.B d.N s ≠ (d.B : Set X) := by
  obtain ⟨i, rfl⟩ := hs
  intro he
  obtain ⟨x, hx, hxB, hxcoset⟩ := d.thick i
  obtain hb | ⟨a, c, ha, hc, rfl⟩ := d.cells i x hx
  · exact hxB hb
  · have htc : (d.lift i : X) * c * (d.lift i : X) ∈ d.B := by
      change (d.lift i : X) * c * (d.lift i : X) ∈ (d.B : Set X)
      rw [← he]
      exact ⟨(d.lift i : X) * c, ⟨d.lift i, ⟨d.lift i, rfl, rfl⟩, c, hc, rfl⟩,
        d.lift i, ⟨d.lift i, rfl, rfl⟩, rfl⟩
    apply hxcoset
    have hh := d.B.mul_mem (d.B.mul_mem ha htc) (d.B.inv_mem (d.square i))
    convert hh using 1
    group

/-- The actual Tits system produced by root factorization and the local
endpoint structure. -/
abbrev titsSystem : TitsSystem (X := X) where
  B := d.B
  N := d.N
  generate := d.generate
  intersection_normal := d.normal
  S := Set.range d.simple
  finite_S := Set.finite_range _
  involutions := by rintro s ⟨i, rfl⟩; exact ⟨d.simple_ne_one i, d.simple_square i⟩
  quotient_generate := d.quotient_generate
  exchange := d.exchange
  nontrivial := d.nontrivial

/-- Exactly two distinguished reflections, with their original labels. -/
theorem rank_two : d.titsSystem.S.ncard = 2 := by
  have hr : Set.range d.simple = {d.simple false, d.simple true} := by
    ext s
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩; cases i <;> simp
    · rintro (rfl | rfl)
      · exact ⟨false, rfl⟩
      · exact ⟨true, rfl⟩
  change (Set.range d.simple).ncard = 2
  rw [hr]
  exact Set.ncard_pair (fun he => Bool.false_ne_true (d.simple_injective he))

private theorem mem_closure_singleton {W : Type*} [Group W] (s : W) (hs : s * s = 1)
    {w : W} (hw : w ∈ Subgroup.closure ({s} : Set W)) : w = 1 ∨ w = s := by
  induction hw using Subgroup.closure_induction with
  | mem x hx => exact Or.inr hx
  | one => exact Or.inl rfl
  | mul a b _ _ ha hb =>
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl <;> simp_all
  | inv a _ ha =>
    rcases ha with rfl | rfl
    · simp
    · right; exact mul_eq_one_iff_inv_eq.mp hs

/-- Both literal endpoint subgroups are the corresponding singleton standard
parabolics of this same constructed Tits system. -/
theorem endpoint_eq_standardParabolic (i : Bool) :
    d.endpoint i = d.titsSystem.standardParabolic {d.simple i} := by
  let T := d.titsSystem
  have hs : d.simple i ∈ T.S := ⟨i, rfl⟩
  have hcell : T.bruhatCell (d.simple i) =
      DoubleCoset.doubleCoset (d.lift i : X) d.B d.B :=
    B_mul_representativeSet_mul_B d.B d.N (d.simple i) (d.lift i) rfl
  apply le_antisymm
  · intro x hx
    rcases d.cells i x hx with hb | ⟨a, c, ha, hc, he⟩
    · exact T.B_le_standardParabolic _ hb
    · apply T.bruhatCell_subset_standardParabolic_of_mem (s := d.simple i) (Set.mem_singleton _)
      rw [hcell]
      exact DoubleCoset.mem_doubleCoset.mpr ⟨a, ha, c, hc, he⟩
  · intro x hx
    obtain ⟨w, hw, hxw⟩ := (T.mem_standardParabolic_iff (Set.singleton_subset_iff.mpr hs) x).mp hx
    rcases mem_closure_singleton (d.simple i) (by simpa only [pow_two] using d.simple_square i) hw with
      rfl | rfl
    · rw [T.bruhatCell_one] at hxw
      exact d.borel_le i hxw
    · rw [hcell] at hxw
      obtain ⟨a, ha, c, hc, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hxw
      exact (d.endpoint i).mul_mem ((d.endpoint i).mul_mem (d.borel_le i ha)
        (d.lift_mem i)) (d.borel_le i hc)

end RootPairData
end Theory.GroupTheory.WeakBNPair.RegularTree
