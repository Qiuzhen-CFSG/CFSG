module
public import Theory.GroupTheory.WeakBNPair.RegularTree.OppositeRootCore
public import Theory.SpecificGroups.SL2.OppositeTwoSubgroups

/-!
# The linear quotient generated by opposite path radicals

Odd extension fixers make the two radicals act regularly on the opposite
exits. Their orders are the field size. A linear map whose kernel fixes
the midpoint star is therefore injective on both radicals, and their
images are distinct: equality would make a nonidentity root fix an exit.
The two resulting Sylows generate SL₂.

Source: DGS, *Groups and Graphs* (1985), (14.1), (14.3)(a), pp.210--212.
-/

public noncomputable section
open Subgroup SimpleGraph SimpleGraph.Walk
open scoped Pointwise MatrixGroups
namespace Theory.GroupTheory.WeakBNPair.RegularTree
variable {X V F : Type*} [Group X] [MulAction X V] {Γ : SimpleGraph V}
variable [Field F] [Finite F] [CharP F 2]

/-- The same local quotient is onto when restricted to the two genuine path roots. -/
theorem opposite_pathRoots_linear_surjective (htree : Γ.IsAcyclic)
    (hact : ∀ (g : X) {a b : V}, Γ.Adj a b → Γ.Adj (g • a) (g • b))
    {a b v : V} [Finite (Γ.neighborSet v)] (p : Γ.Walk a v) (q : Γ.Walk b v)
    (hp : p.IsPath) (hq : q.IsPath) (hpnil : ¬p.Nil) (hqnil : ¬q.Nil)
    (hdiff : p.penultimate ≠ q.penultimate)
    (hval : Nat.card (Γ.neighborSet v) = Nat.card F + 1)
    (htransp : BasedPathTransitive (X := X) Γ (p.length+1))
    (htransq : BasedPathTransitive (X := X) Γ (q.length+1))
    (K : Subgroup X)
    (hKp : ∀ k∈K, k • p.penultimate=p.penultimate)
    (hKq : ∀ k∈K, k • q.penultimate=q.penultimate)
    (hfactorp : (pathFixer (X := X) p : Set X)=(pathRoot (X := X) p : Set X)*(K : Set X))
    (hfactorq : (pathFixer (X := X) q : Set X)=(pathRoot (X := X) q : Set X)*(K : Set X))
    (hoddp : Odd (Nat.card (pathFixer (X := X) (p.concat (q.adj_penultimate hqnil).symm))))
    (hoddq : Odd (Nat.card (pathFixer (X := X) (q.concat (p.adj_penultimate hpnil).symm))))
    (f : ↥(pathRoot (X := X) p ⊔ pathRoot (X := X) q : Subgroup X) →* SL(2,F))
    (hk : ∀ x∈f.ker, ∀ w, Γ.Adj v w → (x:X) • w=w) :
    Function.Surjective f := by
  let A := pathRoot (X := X) p ⊔ pathRoot (X := X) q
  let R := (pathRoot (X := X) p).subgroupOf A
  let S := (pathRoot (X := X) q).subgroupOf A
  have hcR : Nat.card R = Nat.card F := by
    rw [Nat.card_congr (subgroupOfEquivOfLe (show pathRoot (X := X) p ≤ A from le_sup_left)).toEquiv]
    have hh := card_pathRoot_add_one htree hact p hp hpnil htransp K
      ⟨q.penultimate,(q.adj_penultimate hqnil).symm,hdiff.symm⟩ hKq hfactorp hoddp
    omega
  have hcS : Nat.card S = Nat.card F := by
    rw [Nat.card_congr (subgroupOfEquivOfLe (show pathRoot (X := X) q ≤ A from le_sup_right)).toEquiv]
    have hh := card_pathRoot_add_one htree hact q hq hqnil htransq K
      ⟨p.penultimate,(p.adj_penultimate hpnil).symm,hdiff⟩ hKp hfactorq hoddq
    omega
  have hrk : R ⊓ f.ker=⊥ := by
    apply le_bot_iff.mp
    intro x hx
    apply Subtype.ext
    have hh : (x:X)∈pathRoot (X := X) p ⊓ MulAction.stabilizer X q.penultimate :=
      ⟨hx.1,hk x hx.2 _ (q.adj_penultimate hqnil).symm⟩
    rwa [pathRoot_inf_stabilizer_eq_bot p _ hoddp] at hh
  have hsk : S ⊓ f.ker=⊥ := by
    apply le_bot_iff.mp
    intro x hx
    apply Subtype.ext
    have hh : (x:X)∈pathRoot (X := X) q ⊓ MulAction.stabilizer X p.penultimate :=
      ⟨hx.1,hk x hx.2 _ (p.adj_penultimate hpnil).symm⟩
    rwa [pathRoot_inf_stabilizer_eq_bot q _ hoddq] at hh
  let : Fintype F := Fintype.ofFinite F
  have hne : R.map f ≠ S.map f := by
    intro he
    have hc : 1 < Nat.card R := by
      rw [hcR, Nat.card_eq_fintype_card]
      exact Fintype.one_lt_card
    have hrne : R ≠ ⊥ := by intro hr; rw [hr,card_bot] at hc; omega
    obtain ⟨x,hx,hxne⟩ := R.bot_or_exists_ne_one.resolve_left hrne
    obtain ⟨y,hy,hxy⟩ := he ▸ mem_map_of_mem f hx
    have hxk : y⁻¹*x ∈ f.ker := (f.eq_iff).mp hxy.symm
    have hyfix : (y:X) • q.penultimate=q.penultimate := (pathRoot_fixes q hy).2
    have hxfix : (x:X) • q.penultimate=q.penultimate := by
      have hh := hk (y⁻¹*x) hxk _ (q.adj_penultimate hqnil).symm
      have hh' := congrArg (fun z => (y:X) • z) hh
      simpa only [coe_mul,coe_inv,mul_smul,smul_inv_smul,hyfix] using hh'
    have hh : (x:X)∈pathRoot (X := X) p ⊓ MulAction.stabilizer X q.penultimate := ⟨hx,hxfix⟩
    rw [pathRoot_inf_stabilizer_eq_bot p _ hoddp] at hh
    exact hxne (Subtype.ext hh)
  apply Matrix.SpecialLinearGroup.surjective_of_opposite_two_subgroups f R S
    (pathRoot_isTwo p).comap_subtype (pathRoot_isTwo q).comap_subtype hcR hcS hrk hsk hne
  rw [←subgroupOf_sup (show pathRoot (X := X) p ≤ A from le_sup_left)
    (show pathRoot (X := X) q ≤ A from le_sup_right),subgroupOf_self]

end Theory.GroupTheory.WeakBNPair.RegularTree
