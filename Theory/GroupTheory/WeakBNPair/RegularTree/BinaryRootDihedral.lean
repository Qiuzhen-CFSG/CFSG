module
public import Theory.GroupTheory.WeakBNPair.RegularTree.NaturalCubic
public import Theory.GroupTheory.DihedralGeneratedFactor
public import BenderSuzuki.External.Huppert.II.theorem_6_14

/-!
# The exact finite actor generated by two binary root lifts

Two injective opposite roots over a field of order two are generated by
involutions. Their product has image of order three, while the whole
quotient kernel is a two-group. Their literal join is therefore dihedral
of order six times a power of two. The canonical kernel is exactly the
cyclic subgroup generated by the cube of the chosen rotation. No bound
on the two-part, central splitting, or path exchange is assumed.
-/

public noncomputable section
open Subgroup Matrix.SpecialLinearGroup
open scoped MatrixGroups
namespace Theory.GroupTheory.WeakBNPair.RegularTree
open NaturalCubic
variable {E k : Type*} [Group E] [Field k]

private theorem binary_scalar (hk : Nat.card k=2) (a : k) : a=0 ∨ a=1 := by
  obtain ⟨u,hu,huniq⟩ := (Nat.card_eq_two_iff' (0:k)).mp hk
  by_cases ha : a=0
  · exact Or.inl ha
  · exact Or.inr ((huniq a ha).trans (huniq 1 one_ne_zero).symm)

private theorem root_generated (f : E →* SL(2,k)) (R : Subgroup E)
    (hR : R ⊓ f.ker=⊥) (x : E) (hx : x∈R)
    (himage : ∀ y∈R, f y=1 ∨ f y=f x) : R=zpowers x := by
  apply le_antisymm ?_ (zpowers_le.mpr hx)
  intro y hy
  rcases himage y hy with he | he
  · rw [eq_one_of_root_kernel f R hR y hy he]
    exact one_mem _
  · have hyx : y*x⁻¹=1 := eq_one_of_root_kernel f R hR _
      (R.mul_mem hy (R.inv_mem hx)) (by rw [map_mul,map_inv,he,mul_inv_cancel])
    rw [mul_inv_eq_one.mp hyx]
    exact mem_zpowers _

/-- The two actual binary roots identify their generated group and its
entire canonical two-kernel, including the literal rotation and its cube. -/
theorem binary_opposite_root_dihedral [Finite E] [Finite k] [CharP k 2] (hk : Nat.card k=2)
    (f : E →* SL(2,k)) (hs : Function.Surjective f) (hker : IsPGroup 2 f.ker)
    (R V : Subgroup E) (hgen : R ⊔ V=⊤)
    (hRk : R ⊓ f.ker=⊥) (hVk : V ⊓ f.ker=⊥)
    (hR : R.map f=upperUnipotent k)
    (hV : ∀ z, z∈V.map f ↔ ∃ a : k, lower a=z) :
    ∃ (r : ℕ) (x y : E), x∈R ∧ y∈V ∧
      f x=upper 1 ∧ f y=lower 1 ∧ x*x=1 ∧ y*y=1 ∧
      R=zpowers x ∧ V=zpowers y ∧ orderOf (x*y)=3*2^r ∧
      f.ker=zpowers ((x*y)^3) ∧ Nat.card f.ker=2^r ∧ Nat.card E=6*2^r ∧
      Nonempty (E ≃* DihedralGroup (3*2^r)) := by
  have hu : upper (1:k)∈R.map f := by
    rw [hR]
    exact (mem_upperUnipotent k _).mpr ⟨1,rfl⟩
  obtain ⟨x,hx,hfx⟩ := hu
  obtain ⟨y,hy,hfy⟩ := (hV (lower 1)).mpr ⟨1,rfl⟩
  have hx2 := square_of_image_upper f R hRk x hx 1 hfx
  have hy2 := square_of_image_lower f V hVk y hy 1 hfy
  have hRx : R=zpowers x := root_generated f R hRk x hx (by
    intro z hz
    obtain ⟨a,ha⟩ := (mem_upperUnipotent k (f z)).mp (hR ▸ mem_map_of_mem f hz)
    rcases binary_scalar hk a with rfl | rfl
    · left; simpa only [upper,transvection_coeff_zero] using ha.symm
    · exact Or.inr (ha.symm.trans hfx.symm))
  have hVy : V=zpowers y := root_generated f V hVk y hy (by
    intro z hz
    obtain ⟨a,ha⟩ := (hV (f z)).mp (mem_map_of_mem f hz)
    rcases binary_scalar hk a with rfl | rfl
    · left; simpa only [lower,transvection_coeff_zero] using ha.symm
    · exact Or.inr (ha.symm.trans hfy.symm))
  let c := x*y
  have hfc : f c=upper 1*lower 1 := by rw [map_mul,hfx,hfy]
  have hfc3 : orderOf (f c)=3 := by
    apply orderOf_eq_prime
    · rw [hfc]
      simpa only [inv_one] using cubic_cube (1:k) one_ne_zero
    · intro he
      have hh := congrArg (fun z : SL(2,k) => z.val 0 0) he
      rw [hfc,show upper (1:k)*lower 1=upper 1*lower (1:k)⁻¹ from by rw [inv_one],
        cubic_matrix 1 one_ne_zero] at hh
      exact zero_ne_one hh
  have hfx2 : orderOf (f x)=2 := by
    apply orderOf_eq_prime (by rw [←map_pow,pow_two,hx2,map_one])
    intro he
    have hh := congrArg (fun z : SL(2,k) => z.val 0 1) he
    rw [hfx] at hh
    simp [upper,transvection_coe] at hh
  have hxout : x∉zpowers c := by
    intro hm
    have him : f x∈zpowers (f c) := by
      rw [←MonoidHom.map_zpowers]
      exact mem_map_of_mem f hm
    have hd := orderOf_dvd_of_mem_zpowers him
    rw [hfx2,hfc3] at hd
    norm_num at hd
  have hxi : x⁻¹=x := inv_eq_of_mul_eq_one_left hx2
  have hyi : y⁻¹=y := inv_eq_of_mul_eq_one_left hy2
  have hinv : x*c*x⁻¹=c⁻¹ := by
    dsimp only [c]
    simp only [mul_inv_rev,hxi,hyi,←mul_assoc,hx2,one_mul]
  have hjoin : zpowers c ⊔ zpowers x=⊤ := by
    rw [←hgen,hRx,hVy]
    apply le_antisymm
    · exact sup_le (zpowers_le.mpr (mul_mem (mem_sup_left (mem_zpowers x))
        (mem_sup_right (mem_zpowers y)))) le_sup_left
    · refine sup_le le_sup_right (zpowers_le.mpr ?_)
      have hh := (zpowers c ⊔ zpowers x).mul_mem
        (mem_sup_right (mem_zpowers x)) (mem_sup_left (mem_zpowers c))
      simpa only [c,←mul_assoc,hx2,one_mul] using hh
  obtain ⟨horder,⟨ed⟩⟩ := DihedralGroup.sup_zpowers_equiv_of_inversion (orderOf_pos c)
    c x rfl (by simpa only [pow_two] using hx2) hxout hinv
  rw [hjoin,card_top] at horder
  let ed' : E ≃* DihedralGroup (orderOf c) :=
    (Subgroup.topEquiv (G := E)).symm.trans ((MulEquiv.subgroupCongr hjoin).symm.trans ed)
  obtain ⟨r,hr⟩ := hker.exists_card_eq
  have hE : Nat.card E=6*2^r := by
    rw [card_eq_card_quotient_mul_card_subgroup f.ker,
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hs).toEquiv,
      BenderSuzuki.External.huppert614_card_specialLinearGroup,hk,hr]
    norm_num
  have hc : orderOf c=3*2^r := by omega
  have hcube : c^3∈f.ker := by
    rw [MonoidHom.mem_ker,map_pow,←hfc3,pow_orderOf_eq_one]
  have hcubeorder : orderOf (c^3)=2^r := by
    rw [orderOf_pow_of_dvd (by decide : 3≠0) (by rw [hc]; exact dvd_mul_right _ _),hc,
      Nat.mul_div_right _ (by decide : 0<3)]
  have hkerEq : f.ker=zpowers (c^3) := by
    symm
    apply eq_of_le_of_card_ge (zpowers_le.mpr hcube)
    rw [Nat.card_zpowers,hcubeorder,hr]
  exact ⟨r,x,y,hx,hy,hfx,hfy,hx2,hy2,hRx,hVy,hc,hkerEq,hr,hE,hc ▸ ⟨ed'⟩⟩

end Theory.GroupTheory.WeakBNPair.RegularTree
