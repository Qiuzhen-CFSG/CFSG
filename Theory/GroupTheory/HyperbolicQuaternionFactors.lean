module
public import Theory.GroupTheory.QuaternionGenerated
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Tactic.Group

/-!
# Quaternion factors from two hyperbolic involution pairs

Four involutions generate the ambient group, the commutator within either
pair is the same nontrivial central involution, and every cross-pair commutes.
Then the group is generated by two commuting quaternion subgroups whose
intersection has order two. No ambient finiteness assumption is needed.

Writing `a = x1*y1` and `b = x2*y2`, the quaternion factors are generated by
`a, x1*b` and `b, a*x2`. Every designated generator squares to the common
central involution; each pair satisfies the inversion relation. The quaternion
presentation theorem therefore supplies the two models. The two commutator
contributions cancel in the cross commutation of `x1*b` and `a*x2`. The original
four involutions can be recovered from the new generators. Finally, the
intersection is central in either quaternion factor and contains the common
involution, so its order is exactly two.

This is the elementary presentation calculation identifying the central
product of two dihedral groups of order eight with a central product of two
quaternion groups of order eight. It supplies the generic group-theoretic
recognition step used for the elementary-abelian order-eight configuration
in Stellmacher (9.1), Journal of Algebra 190 (1997), p.48.
-/

variable {G : Type*} [Group G]

private theorem quaternion_model_of_common_square (a c z : G) (hz : z ≠ 1) (hz2 : z ^ 2 = 1)
    (ha : a ^ 2 = z) (hc : c ^ 2 = z) (hca : c * a * c⁻¹ = a⁻¹) :
    Nonempty (Subgroup.closure ({a,c} : Set G) ≃* QuaternionGroup 2) := by
  have ha4 : orderOf a = 4 := by
    have hn : a ^ 2 ≠ 1 := by rwa [ha]
    have h4 : a ^ 4 = 1 := by rw [show 4 = 2 * 2 from rfl, pow_mul, ha, hz2]
    exact orderOf_eq_prime_pow (p := 2) (n := 1) (by simpa using hn) (by simpa using h4)
  refine (QuaternionGroup.closure_equiv_of_relations (m := 2) (by decide)
    a c ha4 (hc.trans ha.symm) hca ?_).2
  intro hh
  obtain ⟨i, rfl⟩ := hh
  have hcomm : a ^ i * a * (a ^ i)⁻¹ = a := by group
  have hai : a = a⁻¹ := hcomm.symm.trans hca
  apply hz
  rw [← ha, pow_two]
  exact (congrArg (· * a) hai).trans (inv_mul_cancel a)

public theorem exists_quaternion_factors_of_hyperbolic_involutions
    (x1 y1 x2 y2 z : G)
    (hx1 : x1 ^ 2 = 1) (hy1 : y1 ^ 2 = 1)
    (hx2 : x2 ^ 2 = 1) (hy2 : y2 ^ 2 = 1)
    (hz : z ≠ 1) (hz2 : z ^ 2 = 1) (hzc : z ∈ Subgroup.center G)
    (hxy1 : x1 * y1 * x1⁻¹ * y1⁻¹ = z)
    (hxy2 : x2 * y2 * x2⁻¹ * y2⁻¹ = z)
    (hxx : Commute x1 x2) (hxy : Commute x1 y2)
    (hyx : Commute y1 x2) (hyy : Commute y1 y2)
    (hgen : Subgroup.closure ({x1, y1, x2, y2} : Set G) = ⊤) :
    ∃ L R : Subgroup G,
      Nonempty (L ≃* QuaternionGroup 2) ∧ Nonempty (R ≃* QuaternionGroup 2) ∧
      L ⊔ R = ⊤ ∧ Nat.card (L ⊓ R : Subgroup G) = 2 ∧
      (∀ l ∈ L, ∀ r ∈ R, l * r = r * l) := by
  have hx1i : x1⁻¹ = x1 := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using hx1)
  have hy1i : y1⁻¹ = y1 := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using hy1)
  have hx2i : x2⁻¹ = x2 := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using hx2)
  have hy2i : y2⁻¹ = y2 := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using hy2)
  let a := x1 * y1
  let b := x2 * y2
  let c := x1 * b
  let d := a * x2
  have ha : a ^ 2 = z := by simpa [a, pow_two, mul_assoc, hx1i, hy1i] using hxy1
  have hb : b ^ 2 = z := by simpa [b, pow_two, mul_assoc, hx2i, hy2i] using hxy2
  have hx1b : Commute x1 b := hxx.mul_right hxy
  have hx2a : Commute x2 a := hxx.symm.mul_right hyx.symm
  have hab : Commute a b := hx1b.mul_left (hyx.mul_right hyy)
  have hc : c ^ 2 = z := by rw [hx1b.mul_pow, hx1, hb, one_mul]
  have hd : d ^ 2 = z := by rw [hx2a.symm.mul_pow, ha, hx2, mul_one]
  have hxa : x1 * a * x1⁻¹ = a⁻¹ := by
    simp only [a, mul_inv_rev, hx1i, hy1i, ← mul_assoc]
    rw [← pow_two, hx1, one_mul]
  have hxb : x2 * b * x2⁻¹ = b⁻¹ := by
    simp only [b, mul_inv_rev, hx2i, hy2i, ← mul_assoc]
    rw [← pow_two, hx2, one_mul]
  have hca : c * a * c⁻¹ = a⁻¹ := by
    calc
      c * a * c⁻¹ = x1 * (b * a * b⁻¹) * x1⁻¹ := by dsimp [c]; group
      _ = x1 * a * x1⁻¹ := by rw [hab.symm.eq]; group
      _ = a⁻¹ := hxa
  have hdb : d * b * d⁻¹ = b⁻¹ := by
    calc
      d * b * d⁻¹ = a * (x2 * b * x2⁻¹) * a⁻¹ := by dsimp [d]; group
      _ = a * b⁻¹ * a⁻¹ := by rw [hxb]
      _ = b⁻¹ := by rw [hab.inv_right.eq]; group
  have had : Commute a d := (Commute.refl a).mul_right hx2a.symm
  have hcb : Commute c b := hx1b.mul_left (Commute.refl b)
  have hai : a⁻¹ = z * a := by
    apply inv_eq_of_mul_eq_one_left
    rw [mul_assoc, ← pow_two, ha, ← pow_two, hz2]
  have hbi : b⁻¹ = z * b := by
    apply inv_eq_of_mul_eq_one_left
    rw [mul_assoc, ← pow_two, hb, ← pow_two, hz2]
  have hxa' : x1 * a = a⁻¹ * x1 := mul_inv_eq_iff_eq_mul.mp hxa
  have hbx' : b * x2 = x2 * b⁻¹ := by
    calc
      b * x2 = x2⁻¹ * (x2 * b * x2⁻¹) := by
        rw [← mul_assoc, ← mul_assoc, inv_mul_cancel, one_mul, hx2i]
      _ = x2 * b⁻¹ := by rw [hxb, hx2i]
  have hcd : Commute c d := by
    change (x1 * b) * (a * x2) = (a * x2) * (x1 * b)
    calc
      (x1 * b) * (a * x2) = (x1 * a) * (b * x2) := by
        rw [mul_assoc, ← mul_assoc b, hab.symm.eq]; group
      _ = (a⁻¹ * x1) * (x2 * b⁻¹) := by rw [hxa', hbx']
      _ = (z * a * x1) * (x2 * (z * b)) := by rw [hai, hbi]
      _ = z * ((a * x1 * x2) * z) * b := by group
      _ = z * (z * (a * x1 * x2)) * b := by
        rw [Subgroup.mem_center_iff.mp hzc (a * x1 * x2)]
      _ = (z * z) * (a * x1 * x2 * b) := by group
      _ = (a * x2) * (x1 * b) := by
        rw [← pow_two, hz2, one_mul]
        rw [mul_assoc a, hxx.eq]
        group
  let L := Subgroup.closure ({a,c} : Set G)
  let R := Subgroup.closure ({b,d} : Set G)
  have hL := quaternion_model_of_common_square a c z hz hz2 ha hc hca
  have hR := quaternion_model_of_common_square b d z hz hz2 hb hd hdb
  have hcomm : ∀ l ∈ L, ∀ r ∈ R, l * r = r * l := by
    have hle : L ≤ Subgroup.centralizer (R : Set G) := by
      rw [Subgroup.centralizer_closure]
      apply (Subgroup.closure_le _).mpr
      intro l hl
      rcases (show l = a ∨ l = c by simpa using hl) with rfl | rfl
      · intro r hr
        rcases (show r = b ∨ r = d by simpa using hr) with rfl | rfl
        · exact hab.symm.eq
        · exact had.symm.eq
      · intro r hr
        rcases (show r = b ∨ r = d by simpa using hr) with rfl | rfl
        · exact hcb.symm.eq
        · exact hcd.symm.eq
    intro l hl r hr
    exact (hle hl r hr).symm
  have haL : a ∈ L := Subgroup.subset_closure (by simp)
  have hcL : c ∈ L := Subgroup.subset_closure (by simp)
  have hbR : b ∈ R := Subgroup.subset_closure (by simp)
  have hdR : d ∈ R := Subgroup.subset_closure (by simp)
  have hzL : z ∈ L := ha ▸ L.pow_mem haL 2
  have hzR : z ∈ R := hb ▸ R.pow_mem hbR 2
  refine ⟨L, R, hL, hR, ?_, ?_, hcomm⟩
  · have haJ : a ∈ L ⊔ R := Subgroup.mem_sup_left haL
    have hbJ : b ∈ L ⊔ R := Subgroup.mem_sup_right hbR
    have hcJ : c ∈ L ⊔ R := Subgroup.mem_sup_left hcL
    have hdJ : d ∈ L ⊔ R := Subgroup.mem_sup_right hdR
    have hx1J : x1 ∈ L ⊔ R := by
      have hh := (L ⊔ R).mul_mem hcJ ((L ⊔ R).inv_mem hbJ)
      simpa [c] using hh
    have hx2J : x2 ∈ L ⊔ R := by
      have hh := (L ⊔ R).mul_mem ((L ⊔ R).inv_mem haJ) hdJ
      simpa [d, mul_assoc] using hh
    have hy1J : y1 ∈ L ⊔ R := by
      have hh := (L ⊔ R).mul_mem ((L ⊔ R).inv_mem hx1J) haJ
      simpa [a, mul_assoc] using hh
    have hy2J : y2 ∈ L ⊔ R := by
      have hh := (L ⊔ R).mul_mem ((L ⊔ R).inv_mem hx2J) hbJ
      simpa [b, mul_assoc] using hh
    apply top_unique
    rw [← hgen]
    apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases (show g = x1 ∨ g = y1 ∨ g = x2 ∨ g = y2 by simpa using hg) with
      rfl | rfl | rfl | rfl
    · exact hx1J
    · exact hy1J
    · exact hx2J
    · exact hy2J
  · obtain ⟨eL⟩ := hL
    have hfinite : ∀ z t : QuaternionGroup 2, z ≠ 1 → z ^ 2 = 1 →
        (∀ u, u * t = t * u) → t = 1 ∨ t = z := by decide
    let zL : L := ⟨z, hzL⟩
    have hzL1 : eL zL ≠ 1 := by
      intro hh
      apply hz
      exact congrArg Subtype.val (eL.injective (hh.trans eL.map_one.symm))
    have hzL2 : (eL zL) ^ 2 = 1 := by
      rw [← map_pow]
      have hh : zL ^ 2 = 1 := Subtype.ext hz2
      rw [hh, map_one]
    let zz : (L ⊓ R : Subgroup G) := ⟨z, hzL, hzR⟩
    apply (Nat.card_eq_two_iff' (1 : (L ⊓ R : Subgroup G))).mpr
    refine ⟨zz, ?_, ?_⟩
    · intro hh
      exact hz (congrArg Subtype.val hh)
    · intro t htne
      let tL : L := ⟨t, t.property.1⟩
      have htcenter : ∀ u, u * eL tL = eL tL * u := by
        intro u
        obtain ⟨u, rfl⟩ := eL.surjective u
        simp only [← map_mul]
        congr 1
        exact Subtype.ext (hcomm u u.property t t.property.2)
      rcases hfinite (eL zL) (eL tL) hzL1 hzL2 htcenter with ht | ht
      · exact (htne (Subtype.ext (congrArg (fun x : L => (x : G))
          (eL.injective (ht.trans eL.map_one.symm))))).elim
      · apply Subtype.ext
        exact congrArg (fun x : L => (x : G)) (eL.injective ht)
