/-!
# Splitting an elementary nine in a rank-two section

A three-subgroup centralizing an embedded S₃ in a quotient of a group of
three-rank at most two is cyclic. Restrict the original surjection to the
inverse image of their commuting product, and apply the involution-centralizer
form of A.1.31. This keeps the rank hypothesis on the cover.

For a centerless factor with two-group outer automorphism group, a normalizing
elementary nine acts internally. Its coordinate in the factor has order at
most three when nine does not divide the factor order. Its centralizer
coordinate is cyclic by the preceding section argument, hence also has order
at most three. The injective coordinate map is therefore surjective, proving
that the original nine is the product of its two cubic intersections.
If this nine fails to normalize a two-perfect subgroup generated by a cubic
and a two-group, that cubic must project faithfully onto both factors.
The final lemma constructs those actual projections from multiplication.

The general two-perfect inner-action lemma also retains the actual ambient
centralizer. The source application is the S₃/A₅/L₃(2) step in
Aschbacher–Smith, proof of 14.7.32, printed pp.1058–1059, using A.1.31(1).
-/

public noncomputable section

open Subgroup
open scoped IsMulCommutative
namespace Theory.GroupTheory
local notation "S3" => Equiv.Perm (Fin 3)

private theorem symmetric_product_cyclic
    {D R : Type*} [Group D] [Finite D] [Group R] [Finite R]
    (f : D →* S3 × R) (hf : Function.Surjective f)
    (hr : primeRank 3 D ≤ 2) (hR : IsPGroup 3 R) : IsCyclic R := by
  let P : Subgroup (S3 × R) := (alternatingGroup (Fin 3)).prod ⊥
  let : P.Normal := inferInstanceAs ((alternatingGroup (Fin 3)).prod (⊥ : Subgroup R)).Normal
  have hp : IsPGroup 3 P := by
    intro a
    refine ⟨1,Subtype.ext ?_⟩
    apply Prod.ext
    · have he : (⟨a.val.1,a.property.1⟩ : alternatingGroup (Fin 3)) ^ 3 = 1 := by
        have hc : Nat.card (alternatingGroup (Fin 3)) = 3 := by
          rw [nat_card_alternatingGroup, Nat.card_fin]; decide
        simpa only [hc] using pow_card_eq_one' (x := (⟨a.val.1,a.property.1⟩ : alternatingGroup (Fin 3)))
      exact congrArg Subtype.val he
    · change a.val.2 ^ 3 = 1
      rw [mem_bot.mp a.property.2,one_pow]
  let t : S3 × R := (Equiv.swap 0 1,1)
  have ht : orderOf t = 2 := by
    apply orderOf_eq_prime
    · apply Prod.ext
      · exact (by decide : (Equiv.swap (0 : Fin 3) 1) ^ 2 = 1)
      · simp [t]
    · intro he
      exact (by decide : (Equiv.swap (0 : Fin 3) 1) ≠ 1) (congrArg Prod.fst he)
  have hm : t ∉ centralizer (P : Set (S3 × R)) := by
    intro hc
    let a : S3 := Equiv.swap 0 1 * Equiv.swap 1 2
    have ha : a ∈ alternatingGroup (Fin 3) := by
      simp [a,Equiv.Perm.mem_alternatingGroup]
    have hh := congrArg Prod.fst (hc (a,1) ⟨ha,by simp⟩)
    exact (by decide : a * Equiv.swap 0 1 ≠ Equiv.swap 0 1 * a) hh
  let j : R →* S3 × R := MonoidHom.inr S3 R
  let : IsCyclic j.range :=
    cyclic_pSubgroup_in_involution_centralizer_of_surjective_rank_two
      (by decide) f hf hr P hp t ht hm j.range
      (hR.of_surjective j.rangeRestrict j.rangeRestrict_surjective) (by
        rintro _ ⟨r,rfl⟩
        apply mem_centralizer_singleton_iff.mpr
        simp [j,t])
  exact isCyclic_of_injective j.rangeRestrict (by
    intro r s h
    exact congrArg (fun a : j.range => a.val.2) h)

/-- A three-subgroup centralizing an actual S₃ in a rank-two section is cyclic.
The rank bound is on the source of the displayed surjection. -/
theorem cyclic_three_subgroup_centralizing_symmetric_section
    {D Q : Type*} [Group D] [Finite D] [Group Q] [Finite Q]
    (q : D →* Q) (hq : Function.Surjective q) (hr : primeRank 3 D ≤ 2)
    (j : S3 →* Q) (hj : Function.Injective j)
    (R : Subgroup Q) (hR : IsPGroup 3 R)
    (hc : R ≤ centralizer (j.range : Set Q)) : IsCyclic R := by
  let S := j.range
  let ej : S3 ≃* S := MonoidHom.ofInjective hj
  have hd : Disjoint S R := (NormalSymmetricThree.centralizer_disjoint S ej.symm).mono_right hc
  obtain ⟨e,he⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting S R hd
    (le_centralizer_iff.mpr hc)
  let H := S ⊔ R
  let eH : H ≃* S3 × R := e.symm.trans (MulEquiv.prodCongr ej.symm (MulEquiv.refl R))
  let f : H.comap q →* S3 × R := eH.toMonoidHom.comp (q.subgroupComap H)
  exact symmetric_product_cyclic f
    (eH.surjective.comp (q.subgroupComap_surjective_of_surjective H hq))
    ((primeRank_subgroup_le 3 _).trans hr) hR
end Theory.GroupTheory

namespace Theory.GroupTheory
open Subgroup

/-- An elementary nine contained in two disjoint commuting factors splits
when both coordinate images have order at most three. -/
theorem elementary_nine_split_of_coordinate_bounds
    {Q : Type*} [Group Q] [Finite Q]
    (P A C : Subgroup Q) [IsElementaryAbelian 3 P]
    (hP : Nat.card P = 9) (hAC : Disjoint A C)
    (hcomm : A ≤ centralizer (C : Set Q)) (hPAC : P ≤ A ⊔ C)
    (hA : ∀ B : Subgroup A, IsElementaryAbelian 3 B → Nat.card B ≤ 3)
    (hC : ∀ B : Subgroup C, IsElementaryAbelian 3 B → Nat.card B ≤ 3) :
    P = (P ⊓ A) ⊔ (P ⊓ C) ∧ Nat.card (P ⊓ A : Subgroup Q) = 3 ∧
      Nat.card (P ⊓ C : Subgroup Q) = 3 ∧ Disjoint (P ⊓ A) (P ⊓ C) := by
  obtain ⟨e,he⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting A C hAC hcomm
  let f : P →* A × C := e.symm.toMonoidHom.comp (inclusion hPAC)
  have hf : Function.Injective f := e.symm.injective.comp (inclusion_injective hPAC)
  let f₁ : P →* A := (MonoidHom.fst A C).comp f
  let f₂ : P →* C := (MonoidHom.snd A C).comp f
  let : IsElementaryAbelian 3 f₁.range :=
    IsElementaryAbelian.of_surjective f₁.rangeRestrict f₁.rangeRestrict_surjective
  let : IsElementaryAbelian 3 f₂.range :=
    IsElementaryAbelian.of_surjective f₂.rangeRestrict f₂.rangeRestrict_surjective
  have hc₁ := hA f₁.range inferInstance
  have hc₂ := hC f₂.range inferInstance
  let g : P →* f₁.range × f₂.range := f₁.rangeRestrict.prod f₂.rangeRestrict
  have hg : Function.Injective g := by
    intro x y hxy
    apply hf
    exact Prod.ext (congrArg (fun z : f₁.range × f₂.range => z.1.val) hxy)
      (congrArg (fun z : f₁.range × f₂.range => z.2.val) hxy)
  have hcard : 9 ≤ Nat.card f₁.range * Nat.card f₂.range := by
    rw [←Nat.card_prod,←hP]
    exact Nat.card_le_card_of_injective g hg
  have hc₁eq : Nat.card f₁.range = 3 := by nlinarith
  have hc₂eq : Nat.card f₂.range = 3 := by nlinarith
  have hgs : Function.Surjective g := (Nat.bijective_iff_injective_and_card g).mpr
    ⟨hg,by rw [Nat.card_prod,hP,hc₁eq,hc₂eq]⟩ |>.surjective
  have hval (x : P) : (x : Q) = (f₁ x : Q) * (f₂ x : Q) := by
    have hh := he (f x).1 (f x).2
    change (e (e.symm (inclusion hPAC x)) : Q) = _ at hh
    rwa [e.apply_symm_apply] at hh
  have h₁P : f₁.range.map A.subtype ≤ P := by
    rintro _ ⟨a,ha,rfl⟩
    obtain ⟨x,hx⟩ := hgs (⟨a,ha⟩,1)
    have hx₁ : f₁ x = a := congrArg (fun z : f₁.range × f₂.range => z.1.val) hx
    have hx₂ : f₂ x = 1 := congrArg (fun z : f₁.range × f₂.range => z.2.val) hx
    have hh := hval x
    rw [hx₁,hx₂,coe_one,mul_one] at hh
    change (a : Q) ∈ P
    rw [←hh]
    exact x.property
  have h₂P : f₂.range.map C.subtype ≤ P := by
    rintro _ ⟨a,ha,rfl⟩
    obtain ⟨x,hx⟩ := hgs (1,⟨a,ha⟩)
    have hx₁ : f₁ x = 1 := congrArg (fun z : f₁.range × f₂.range => z.1.val) hx
    have hx₂ : f₂ x = a := congrArg (fun z : f₁.range × f₂.range => z.2.val) hx
    have hh := hval x
    rw [hx₁,hx₂,coe_one,one_mul] at hh
    change (a : Q) ∈ P
    rw [←hh]
    exact x.property
  have h₁eq : f₁.range.map A.subtype = P ⊓ A := by
    apply le_antisymm (le_inf h₁P (map_subtype_le _))
    intro x hx
    let a : A := ⟨x,hx.2⟩
    let p : P := ⟨x,hx.1⟩
    have hh : f p = (a,1) := by
      apply e.injective
      rw [show e (f p) = inclusion hPAC p from e.apply_symm_apply _]
      apply Subtype.ext
      rw [he,coe_one,mul_one]
      rfl
    exact ⟨a,⟨p,congrArg Prod.fst hh⟩,rfl⟩
  have h₂eq : f₂.range.map C.subtype = P ⊓ C := by
    apply le_antisymm (le_inf h₂P (map_subtype_le _))
    intro x hx
    let a : C := ⟨x,hx.2⟩
    let p : P := ⟨x,hx.1⟩
    have hh : f p = (1,a) := by
      apply e.injective
      rw [show e (f p) = inclusion hPAC p from e.apply_symm_apply _]
      apply Subtype.ext
      rw [he,coe_one,one_mul]
      rfl
    exact ⟨a,⟨p,congrArg Prod.snd hh⟩,rfl⟩
  refine ⟨le_antisymm ?_ (sup_le inf_le_left inf_le_left),?_,?_,hAC.mono inf_le_right inf_le_right⟩
  · intro x hx
    change ((⟨x,hx⟩ : P) : Q) ∈ _
    rw [hval]
    apply mul_mem_sup
    · rw [←h₁eq]
      exact mem_map_of_mem A.subtype (show f₁ ⟨x,hx⟩ ∈ f₁.range from ⟨_,rfl⟩)
    · rw [←h₂eq]
      exact mem_map_of_mem C.subtype (show f₂ ⟨x,hx⟩ ∈ f₂.range from ⟨_,rfl⟩)
  · rw [←h₁eq,card_map_of_injective A.subtype_injective,hc₁eq]
  · rw [←h₂eq,card_map_of_injective C.subtype_injective,hc₂eq]
end Theory.GroupTheory


namespace Subgroup
variable {Q : Type*} [Group Q]

/-- A p-perfect normalizing actor has inner action when the outer group is a p-group. -/
theorem pPerfect_le_sup_centralizer_of_pGroup_outer
    {p : ℕ} [Fact p.Prime] (A B : Subgroup Q)
    (hp : IsPPerfect p B) (ho : IsPGroup p (MulAut.Outer A))
    (hn : B ≤ normalizer (A : Set Q)) : B ≤ A ⊔ centralizer (A : Set Q) := by
  let a : B →* MulAut A := A.normalizerMonoidHom.comp (inclusion hn)
  let f : B →* MulAut.Outer A := (QuotientGroup.mk' (MulAut.innerSubgroup A)).comp a
  have hf := hp.hom_eq_one_of_isPGroup ho f
  intro x hx
  obtain ⟨k,hk⟩ := (QuotientGroup.eq_one_iff _).mp (DFunLike.congr_fun hf ⟨x,hx⟩)
  let kN : normalizer (A : Set Q) := ⟨k,A.le_normalizer k.property⟩
  have hkN : A.normalizerMonoidHom kN = MulAut.conj k := by ext y; rfl
  have hker : kN⁻¹ * ⟨x,hn hx⟩ ∈ A.normalizerMonoidHom.ker := by
    rw [MonoidHom.mem_ker,map_mul,map_inv,hkN,hk]
    exact inv_mul_cancel _
  rw [normalizerMonoidHom_ker] at hker
  have hm := (A ⊔ centralizer (A : Set Q)).mul_mem
    (mem_sup_left k.property)
    (mem_sup_right (show (k : Q)⁻¹ * x ∈ centralizer (A : Set Q) from hker))
  simpa only [mul_inv_cancel_left] using hm
end Subgroup

namespace Theory.GroupTheory
open Subgroup

/-- The actual centralizer and component intersections of an elementary nine
are both cubic. The section-rank premise stays on the source of q. -/
theorem elementary_nine_split_at_small_factor
    {D Q : Type*} [Group D] [Finite D] [Group Q] [Finite Q]
    (q : D →* Q) (hq : Function.Surjective q) (hr : primeRank 3 D ≤ 2)
    (P A : Subgroup Q) [IsElementaryAbelian 3 P]
    (hP : Nat.card P = 9) (hn : P ≤ normalizer (A : Set Q))
    (hz : center A = ⊥) (hcard : ¬ 9 ∣ Nat.card A)
    (ho : IsPGroup 2 (MulAut.Outer A))
    (j : Equiv.Perm (Fin 3) →* A) (hj : Function.Injective j) :
    P = (P ⊓ A) ⊔ (P ⊓ centralizer (A : Set Q)) ∧
      Nat.card (P ⊓ A : Subgroup Q) = 3 ∧
      Nat.card (P ⊓ centralizer (A : Set Q) : Subgroup Q) = 3 ∧
      Disjoint (P ⊓ A) (P ⊓ centralizer (A : Set Q)) := by
  have hp : IsPPerfect 2 P := by
    intro N hn htwo
    let := hn
    apply index_eq_one.mp
    change Nat.card (P ⧸ N) = 1
    apply htwo.card_eq_or_dvd.resolve_right
    intro hd
    have hh := hd.trans N.card_quotient_dvd_card
    rw [hP] at hh
    norm_num at hh
  have hd : Disjoint A (centralizer (A : Set Q)) := by
    apply disjoint_def.mpr
    intro x hx hc
    have hzmem : (⟨x,hx⟩ : A) ∈ center A := by
      apply mem_center_iff.mpr
      intro a
      exact Subtype.ext (hc a a.property)
    have he : (⟨x,hx⟩ : A) = 1 := mem_bot.mp (hz ▸ hzmem)
    exact congrArg Subtype.val he
  apply elementary_nine_split_of_coordinate_bounds P A (centralizer (A : Set Q)) hP hd
    (le_centralizer_iff.mpr le_rfl)
    (pPerfect_le_sup_centralizer_of_pGroup_outer A P hp ho hn)
  · intro B hB
    obtain ⟨n,hn⟩ := (IsElementaryAbelian.isPGroup 3 B).exists_card_eq
    have hb := card_subgroup_dvd_card B
    by_contra hle
    have htwo : 2 ≤ n := by
      by_contra hlt
      apply hle
      rw [hn]
      exact (show 3^n ≤ 3^1 from Nat.pow_le_pow_right (by decide) (by omega))
    exact hcard ((by rw [hn]; exact pow_dvd_pow 3 htwo : 9 ∣ Nat.card B).trans hb)
  · intro B hB
    let C := centralizer (A : Set Q)
    let R := B.map C.subtype
    let jQ := A.subtype.comp j
    have hjQ : Function.Injective jQ := A.subtype_injective.comp hj
    have hc : R ≤ centralizer (jQ.range : Set Q) := by
      rintro _ ⟨b,hb,rfl⟩ _ ⟨s,rfl⟩
      exact b.property (j s) (j s).property
    let : IsCyclic R := cyclic_three_subgroup_centralizing_symmetric_section q hq hr
      jQ hjQ R ((IsElementaryAbelian.isPGroup 3 B).map C.subtype) hc
    have hcycB : IsCyclic B := isCyclic_of_injective
      (B.equivMapOfInjective C.subtype C.subtype_injective).toMonoidHom
      (B.equivMapOfInjective C.subtype C.subtype_injective).injective
    let := hcycB
    apply Nat.le_of_dvd (by decide : 0 < 3)
    rw [←IsCyclic.exponent_eq_card]
    exact IsElementaryAbelian.exponent_dvd_p 3 B
end Theory.GroupTheory

namespace Theory.GroupTheory
variable {Q : Type*} [Group Q] [Finite Q]

private theorem disjoint_of_prime_card_not_le (B A : Subgroup Q)
    (hc : Nat.card B = 3) (hn : ¬ B ≤ A) : Disjoint B A := by
  have hd : Nat.card (B ⊓ A : Subgroup Q) ∣ 3 := by
    simpa only [hc] using card_dvd_of_le (show B ⊓ A ≤ B from inf_le_left)
  rcases (Nat.dvd_prime (by decide : Nat.Prime 3)).mp hd with he | he
  · exact disjoint_iff.mpr (card_eq_one.mp he)
  · have hh : B ⊓ A = B := eq_of_le_of_card_ge inf_le_left (by rw [hc,he])
    exact (hn (hh.symm.le.trans inf_le_right)).elim

/-- If a split nine does not normalize a two-perfect cubic supplement,
its cubic projects faithfully on both actual factors. This excludes the
containment and centralization cases without a quotient-rank assumption. -/
theorem cubic_disjoint_factors_of_nine_not_normalizing
    (P A L B R : Subgroup Q)
    (hs : P = (P ⊓ A) ⊔ (P ⊓ centralizer (A : Set Q)))
    (hcA : Nat.card (P ⊓ A : Subgroup Q) = 3)
    (hcC : Nat.card (P ⊓ centralizer (A : Set Q) : Subgroup Q) = 3)
    (hcB : Nat.card B = 3) (hBP : B ≤ P) (hg : B ⊔ R = L)
    (hp : IsPPerfect 2 L) (hR : IsPGroup 2 R)
    (hLA : L ≤ normalizer (A : Set Q))
    (hnot : ¬ P ≤ normalizer (L : Set Q)) :
    ¬ L ≤ A ∧ ¬ L ≤ centralizer (A : Set Q) ∧
      Disjoint B A ∧ Disjoint B (centralizer (A : Set Q)) := by
  have hBL : B ≤ L := le_sup_left.trans_eq hg
  have hRL : R ≤ L := le_sup_right.trans_eq hg
  have hnA : ¬ L ≤ A := by
    intro hL
    have he : B = P ⊓ A := eq_of_le_of_card_ge (le_inf hBP (hBL.trans hL))
      (by rw [hcA,hcB])
    apply hnot
    rw [hs]
    apply sup_le
    · rw [←he]
      exact hBL.trans L.le_normalizer
    · exact inf_le_right.trans ((centralizer_le hL).trans (Subgroup.centralizer_le_normalizer _))
  have hnC : ¬ L ≤ centralizer (A : Set Q) := by
    intro hL
    have he : B = P ⊓ centralizer (A : Set Q) :=
      eq_of_le_of_card_ge (le_inf hBP (hBL.trans hL)) (by rw [hcC,hcB])
    apply hnot
    rw [hs]
    apply sup_le
    · exact inf_le_right.trans ((le_centralizer_iff.mpr hL).trans
        (Subgroup.centralizer_le_normalizer _))
    · rw [←he]
      exact hBL.trans L.le_normalizer
  refine ⟨hnA,hnC,disjoint_of_prime_card_not_le B A hcB ?_,
    disjoint_of_prime_card_not_le B (centralizer (A : Set Q)) hcB ?_⟩
  · intro hB
    apply hnA
    exact le_of_isPPerfect_of_le_sup_of_normalizes L A R hp hR
      (hRL.trans hLA) (hg ▸ sup_le_sup hB le_rfl)
  · intro hB
    apply hnC
    exact le_of_isPPerfect_of_le_sup_of_normalizes L (centralizer (A : Set Q)) R hp hR
      (hRL.trans (hLA.trans (normalizer_le_normalizer_centralizer A)))
      (hg ▸ sup_le_sup hB le_rfl)

omit [Finite Q] in
/-- Multiplication supplies the literal two projections, both faithful on
any subgroup disjoint from the two factors. -/
theorem exists_faithful_projections_of_split_disjoint
    (P A C B : Subgroup Q) (hs : P = A ⊔ C) (hd : Disjoint A C)
    (hc : A ≤ centralizer (C : Set Q)) (hBP : B ≤ P)
    (hBA : Disjoint B A) (hBC : Disjoint B C) :
    ∃ e : A × C ≃* P,
      (∀ a c, (e (a,c) : Q) = (a : Q) * (c : Q)) ∧
      Function.Injective ((MonoidHom.fst A C).comp
        (e.symm.toMonoidHom.comp (inclusion hBP))) ∧
      Function.Injective ((MonoidHom.snd A C).comp
        (e.symm.toMonoidHom.comp (inclusion hBP))) := by
  obtain ⟨k,hk⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting A C hd hc
  let e : A × C ≃* P := k.trans (MulEquiv.subgroupCongr hs.symm)
  have he (a : A) (c : C) : (e (a,c) : Q) = (a : Q) * (c : Q) := hk a c
  let f := e.symm.toMonoidHom.comp (inclusion hBP)
  have hf (b : B) : (b : Q) = ((f b).1 : Q) * ((f b).2 : Q) := by
    have hh := he (f b).1 (f b).2
    change (e (e.symm (inclusion hBP b)) : Q) = _ at hh
    rwa [e.apply_symm_apply] at hh
  refine ⟨e,he,?_,?_⟩
  · apply (MonoidHom.ker_eq_bot_iff _).mp
    apply bot_unique
    intro b hb
    have hfirst : (f b).1 = 1 := hb
    have hm : (b : Q) ∈ C := by
      rw [hf,hfirst,coe_one,one_mul]
      exact (f b).2.property
    exact Subtype.ext (disjoint_def.mp hBC b.property hm)
  · apply (MonoidHom.ker_eq_bot_iff _).mp
    apply bot_unique
    intro b hb
    have hsecond : (f b).2 = 1 := hb
    have hm : (b : Q) ∈ A := by
      rw [hf,hsecond,coe_one,mul_one]
      exact (f b).1.property
    exact Subtype.ext (disjoint_def.mp hBA b.property hm)
end Theory.GroupTheory
