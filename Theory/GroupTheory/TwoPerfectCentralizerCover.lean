module
public import Theory.GroupTheory.PPerfectHom
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.Commutator.RelativeGeneration
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Two-perfect displacement through a two-group cover

Suppose a two-perfect subgroup Y is generated by its commutators with J.
If Y normalizes a two-subgroup P and a subgroup U, P normalizes U, and
J lies in P C_G(U), then Y centralizes U. Commutator generation places Y
in P C_G(U), whose quotient by C_G(U) is a two-group. Two-perfectness
kills that quotient image.

This is the action-kernel step in Aschbacher--Smith 6.1.5, printed p.666,
specialized to the actual full omega centralizer. The source consumer is
`SourceHStarTwoPerfectOmega` and supplies the literal Thompson cover.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

theorem twoPerfect_centralizes_of_commutator_two_cover
    (Y J P U : Subgroup G)
    (hY : IsPPerfect 2 Y) (hP : IsPGroup 2 P)
    (hYP : Y ≤ normalizer (P : Set G))
    (hYU : Y ≤ normalizer (U : Set G))
    (hPU : P ≤ normalizer (U : Set G))
    (hJ : J ≤ P ⊔ centralizer (U : Set G))
    (hcomm : Y = ⁅Y,J⁆) : Y ≤ centralizer (U : Set G) := by
  let C := centralizer (U : Set G)
  let D := C ⊔ P
  have hYC : Y ≤ normalizer (C : Set G) :=
    hYU.trans (normalizer_le_normalizer_centralizer U)
  have hPC : P ≤ normalizer (C : Set G) :=
    hPU.trans (normalizer_le_normalizer_centralizer U)
  have hYD : Y ≤ D := by
    rw [hcomm,commutator_comm]
    apply (commutator_mono (hJ.trans_eq (sup_comm P C)) le_rfl).trans
    exact commutator_sup_le_of_relative_normal D C P Y D D.le_normalizer
      le_sup_left le_sup_right
      ((le_normalizer_iff_commutator_le_left.mp hYC).trans le_sup_left)
      ((le_normalizer_iff_commutator_le_left.mp hYP).trans le_sup_right)
  let : (C.subgroupOf D).Normal := normal_subgroupOf_of_le_normalizer
    (sup_le C.le_normalizer hPC)
  have hgen : C.subgroupOf D ⊔ P.subgroupOf D = ⊤ := by
    rw [←subgroupOf_sup (show C ≤ D from le_sup_left)
      (show P ≤ D from le_sup_right)]
    exact subgroupOf_self D
  have hquot := isPGroup_quotient_of_sup_eq_top (C.subgroupOf D) (P.subgroupOf D)
    hP.comap_subtype hgen
  let q := QuotientGroup.mk' (C.subgroupOf D)
  let f := q.comp (inclusion hYD)
  have hf := hY.hom_eq_one_of_isPGroup hquot f
  intro y hy
  have he := congrArg (fun k : Y →* (D ⧸ C.subgroupOf D) => k ⟨y,hy⟩) hf
  exact (QuotientGroup.eq_one_iff (inclusion hYD (⟨y,hy⟩ : Y))).mp he
end Subgroup
