module

public import Theory.GroupTheory.NormalizedSupCard
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators
public import Theory.GroupTheory.SpecificGroups.DihedralEightRecognition
public import Theory.GroupTheory.SpecificGroups.CyclicInvertedDihedral
public import Theory.ElementaryAbelian.Basic
public import Mathlib.Tactic

set_option linter.unnecessarySimpa false
set_option linter.style.haveILetI false

/-!
# An order-four fixed line and its dihedral extension

Let `X` be a subgroup of order four normalized by an involution `s`.  If the
fixed part of the conjugation action on `X` is the involution line generated by
`r`, the action interchanges the two cosets of that line.  An index-two coset
representative `x` therefore gives the marked identity
`conj x s = r * s`, and `X` is generated by `x` and `r`.  The join with
`⟨s⟩` has order eight; the Klein four subgroup generated by `r,s` is
noncentral, so the intrinsic order-eight recognition theorem identifies the
join with `D₈`.

This is the intrinsic geometry used in the paragraph after (+) on printed
page 1190 of Aschbacher--Smith, `refs/quasithin.pdf`.  No construction of the
order-four subgroup is included here.
-/

open scoped Pointwise

private theorem mem_zpowers_involution_eq_one_or_self
    {G : Type*} [Group G] [Finite G] {s y : G}
    (hs : s ≠ 1 ∧ s ^ 2 = 1) (hy : y ∈ Subgroup.zpowers s) :
    y = 1 ∨ y = s := by
  classical
  have hsOrder : orderOf s = 2 := orderOf_eq_prime hs.2 hs.1
  have hcard : Nat.card (Subgroup.zpowers s) = 2 := by
    rw [Nat.card_zpowers, hsOrder]
  obtain ⟨z, hz1, hzunique⟩ :=
    (Nat.card_eq_two_iff' (1 : Subgroup.zpowers s)).mp hcard
  by_cases hy1 : y = 1
  · exact Or.inl hy1
  · right
    let ys : Subgroup.zpowers s := ⟨y, hy⟩
    let ss : Subgroup.zpowers s := ⟨s, Subgroup.mem_zpowers s⟩
    have hys1 : ys ≠ 1 := by
      intro heq
      apply hy1
      exact congrArg Subtype.val heq
    have hss1 : ss ≠ 1 := by
      intro heq
      apply hs.1
      exact congrArg Subtype.val heq
    exact congrArg Subtype.val ((hzunique ys hys1).trans (hzunique ss hss1).symm)

private theorem subgroupOf_card_eq
    {G : Type*} [Group G] {H K : Subgroup G} (hHK : H ≤ K)
    [Finite K] : Nat.card (H.subgroupOf K) = Nat.card H := by
  exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hHK).toEquiv

/-- The order-four fixed-line configuration has a marked dihedral model. -/
public theorem exists_marked_dihedral_extension_of_involution_fixed_line
    {G : Type*} [Group G] [Finite G]
    (X : Subgroup G) (hXcard : Nat.card X = 4)
    (r s : G) (hrX : r ∈ X) (hrorder : orderOf r = 2)
    (hsorder : orderOf s = 2) (hsnotX : s ∉ X)
    (hsnormal : s ∈ Subgroup.normalizer (X : Set G))
    (hfixed : X ⊓ Subgroup.centralizer ({s} : Set G) = Subgroup.zpowers r) :
    ∃ (_e : (X ⊔ Subgroup.zpowers s : Subgroup G) ≃* DihedralGroup 4) (x : G),
      x ∈ X ∧ MulAut.conj x s = r * s ∧
        X = Subgroup.zpowers x ⊔ Subgroup.zpowers r := by
  classical
  have hsne : s ≠ 1 := by
    intro hs1
    apply hsnotX
    simpa [hs1] using (X.one_mem)
  have hs_sq : s * s = 1 := by
    simpa [hsorder, pow_two] using pow_orderOf_eq_one s
  have hs_inv : s⁻¹ = s := inv_eq_of_mul_eq_one_right hs_sq
  have hrne : r ≠ 1 := by
    intro hr1
    have : orderOf r = 1 := by simp [hr1]
    omega
  have hr_sq : r * r = 1 := by
    simpa [hrorder, pow_two] using pow_orderOf_eq_one r
  have hrzp : Subgroup.zpowers r ≤ X := Subgroup.zpowers_le.mpr hrX
  have hlineC : Subgroup.zpowers r ≤ Subgroup.centralizer ({s} : Set G) := by
    rw [← hfixed]
    exact inf_le_right
  have hXcomm : IsMulCommutative X := by
    letI : Fact (Nat.Prime 2) := ⟨by decide⟩
    have hcard : Nat.card X = 2 ^ 2 := by norm_num [hXcard]
    exact IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hcard
  have hcommX (a b : G) (ha : a ∈ X) (hb : b ∈ X) : a * b = b * a := by
    exact congrArg Subtype.val (hXcomm.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hfix_iff (y : G) :
      MulAut.conj s y = y ↔ y ∈ Subgroup.centralizer ({s} : Set G) := by
    rw [Subgroup.mem_centralizer_singleton_iff, MulAut.conj_apply, hs_inv]
    constructor
    · intro h
      have hh := congrArg (fun z : G => z * s) h
      simpa [mul_assoc, hs_sq] using hh.symm
    · intro h
      have hh := congrArg (fun z : G => s * z) h
      calc
        s * y * s = s * (y * s) := by rw [mul_assoc]
        _ = s * (s * y) := by rw [h]
        _ = y := by rw [← mul_assoc, hs_sq, one_mul]
  have hnormalizer (y : G) (hy : y ∈ X) : MulAut.conj s y ∈ X :=
    (Subgroup.mem_normalizer_iff.mp hsnormal y).mp hy
  have hconj_invol (y : G) : MulAut.conj s (MulAut.conj s y) = y := by
    rw [MulAut.conj_apply, MulAut.conj_apply, hs_inv]
    calc
      s * (s * y * s) * s = (s * s) * y * (s * s) := by group
      _ = y := by rw [hs_sq]; simp
  have hline_fix (y : G) (hy : y ∈ Subgroup.zpowers r) : MulAut.conj s y = y := by
    apply (hfix_iff y).mpr
    exact hlineC hy
  have hfixed_mem_line {y : G} (hy : y ∈ X)
      (hfy : MulAut.conj s y = y) : y ∈ Subgroup.zpowers r := by
    have hyC : y ∈ Subgroup.centralizer ({s} : Set G) := (hfix_iff y).mp hfy
    have hyI : y ∈ X ⊓ Subgroup.centralizer ({s} : Set G) := ⟨hy, hyC⟩
    rw [hfixed] at hyI
    exact hyI

  let R : Subgroup X := (Subgroup.zpowers r).subgroupOf X
  have hRcard : Nat.card R = 2 := by
    calc
      Nat.card R = Nat.card (Subgroup.zpowers r) := subgroupOf_card_eq hrzp
      _ = orderOf r := Nat.card_zpowers r
      _ = 2 := hrorder
  have hRindex : R.index = 2 := by
    have hh := R.card_mul_index
    rw [hRcard, hXcard] at hh
    omega
  obtain ⟨xsub, hxnotR, hcosets⟩ :=
    (Subgroup.index_eq_two_iff_exists_notMem_and').mp hRindex
  let x : G := xsub
  have hxX : x ∈ X := xsub.property
  have hxnot : x ∉ Subgroup.zpowers r := by
    intro hx
    apply hxnotR
    exact hx
  have hphiX : MulAut.conj s x ∈ X := hnormalizer x hxX
  have hphi_not_line : MulAut.conj s x ∉ Subgroup.zpowers r := by
    intro hφR
    have hφfix : MulAut.conj s (MulAut.conj s x) = MulAut.conj s x :=
      hline_fix _ hφR
    have hxeq : x = MulAut.conj s x := (hconj_invol x).symm.trans hφfix
    apply hxnot
    exact hfixed_mem_line hxX hxeq.symm
  have hqR : x * x ∈ Subgroup.zpowers r := by
    have hc := hcosets xsub
    rcases hc with h | h
    · exact Subgroup.mem_subgroupOf.mp h
    · exact (hxnot h).elim
  have hdR : x * MulAut.conj s x ∈ Subgroup.zpowers r := by
    let ysub : X := ⟨MulAut.conj s x, hphiX⟩
    have hc := hcosets ysub
    rcases hc with h | h
    · simpa [ysub, x] using (Subgroup.mem_subgroupOf.mp h)
    · exact (hphi_not_line h).elim
  have hq_cases : x * x = 1 ∨ x * x = r :=
    mem_zpowers_involution_eq_one_or_self ⟨hrne, by simpa [pow_two] using hr_sq⟩ hqR
  have hd_cases : x * MulAut.conj s x = 1 ∨ x * MulAut.conj s x = r :=
    mem_zpowers_involution_eq_one_or_self ⟨hrne, by simpa [pow_two] using hr_sq⟩ hdR
  have hxd_ne : x * x ≠ x * MulAut.conj s x := by
    intro heq
    have hxeq : x = MulAut.conj s x := by
      exact mul_left_cancel heq
    apply hxnot
    exact hfixed_mem_line hxX hxeq.symm
  have hkey : x * (MulAut.conj s x)⁻¹ = r := by
    let d : G := x * MulAut.conj s x
    have hd_inv : d⁻¹ = d := by
      rcases hd_cases with h | h
      · simpa [d, h]
      · simp [d, h, inv_eq_of_mul_eq_one_right hr_sq]
    have hqhd : (x * x) * (x * MulAut.conj s x) = r := by
      rcases hq_cases with hq | hq <;> rcases hd_cases with hd | hd
      · exact (hxd_ne (hq.trans hd.symm)).elim
      · simpa [hq, hd]
      · simpa [hq, hd]
      · exact (hxd_ne (hq.trans hd.symm)).elim
    have hd_mem : d ∈ X := by
      exact X.mul_mem hxX hphiX
    have hphi_eq : MulAut.conj s x = x⁻¹ * d := by
      calc
        MulAut.conj s x = 1 * MulAut.conj s x := by simp
        _ = x⁻¹ * x * MulAut.conj s x := by simp
        _ = x⁻¹ * (x * MulAut.conj s x) := by rw [mul_assoc]
        _ = x⁻¹ * d := by rfl
    calc
      x * (MulAut.conj s x)⁻¹ = x * (x⁻¹ * d)⁻¹ := by rw [hphi_eq]
      _ = x * (d⁻¹ * (x⁻¹)⁻¹) := by rw [mul_inv_rev]
      _ = x * (d * x) := by rw [hd_inv]; simp
      _ = (x * x) * d := by
        calc
          x * (d * x) = (x * d) * x := (mul_assoc x d x).symm
          _ = (d * x) * x := by rw [hcommX x d hxX hd_mem]
          _ = d * (x * x) := mul_assoc d x x
          _ = (x * x) * d := hcommX d (x * x) hd_mem (X.mul_mem hxX hxX)
      _ = r := by
        simpa [d] using hqhd
  have hconj : MulAut.conj x s = r * s := by
    rw [MulAut.conj_apply]
    calc
      x * s * x⁻¹ = x * s * x⁻¹ * (s * s) := by rw [hs_sq, mul_one]
      _ = x * (s * x⁻¹ * s) * s := by group
      _ = x * (s * x⁻¹ * s⁻¹) * s := by rw [hs_inv]
      _ = x * (MulAut.conj s x)⁻¹ * s := by
        have hh : (MulAut.conj s x)⁻¹ = s * x⁻¹ * s⁻¹ := by
          simp only [MulAut.conj_apply, mul_inv_rev, inv_inv]
          exact (mul_assoc s x⁻¹ s⁻¹).symm
        rw [hh]
      _ = r * s := by rw [hkey]
  have hXgen : X = Subgroup.zpowers x ⊔ Subgroup.zpowers r := by
    apply le_antisymm
    · intro y hy
      let ysub : X := ⟨y, hy⟩
      rcases hcosets ysub with hxy | hyR
      · have hxyG : x * y ∈ Subgroup.zpowers r := by
          simpa [x, ysub] using (Subgroup.mem_subgroupOf.mp hxy)
        have hprod : x⁻¹ * (x * y) ∈
            Subgroup.zpowers x ⊔ Subgroup.zpowers r :=
          (Subgroup.mul_mem _
            ((le_sup_left : Subgroup.zpowers x ≤ _)
              ((Subgroup.zpowers x).inv_mem (Subgroup.mem_zpowers x)))
            ((le_sup_right : Subgroup.zpowers r ≤ _) hxyG))
        simpa only [inv_mul_cancel_left] using hprod
      · exact (le_sup_right : Subgroup.zpowers r ≤ _) (Subgroup.mem_subgroupOf.mp hyR)
    · exact sup_le (Subgroup.zpowers_le.mpr hxX) (Subgroup.zpowers_le.mpr hrX)

  let E : Subgroup G := X ⊔ Subgroup.zpowers s
  have hnorm : Subgroup.zpowers s ≤ Subgroup.normalizer (X : Set G) :=
    Subgroup.zpowers_le.mpr hsnormal
  have hdisj : Disjoint X (Subgroup.zpowers s) := by
    apply Subgroup.disjoint_def.mpr
    intro y hyX hyS
    rcases mem_zpowers_involution_eq_one_or_self
      ⟨hsne, by simpa [pow_two] using hs_sq⟩ hyS with hy1 | hys
    · exact hy1
    · exact (hsnotX (hys ▸ hyX)).elim
  have hEcard : Nat.card E = 8 := by
    dsimp [E]
    rw [Subgroup.card_sup_eq_mul_of_normalizes_of_disjoint X
      (Subgroup.zpowers s) hnorm hdisj]
    rw [hXcard, Nat.card_zpowers, hsorder]
  let K : Subgroup G := Subgroup.closure ({r, s} : Set G)
  have hrscomm : Commute r s := by
    exact (Subgroup.mem_centralizer_singleton_iff.mp (hlineC (Subgroup.mem_zpowers r)))
  have hrsne : r ≠ s := by
    intro hrs
    apply hsnotX
    simpa [hrs] using hrX
  have hKfour : IsKleinFour K :=
    Subgroup.isKleinFour_closure_pair_of_orderOf r s hrorder hsorder hrsne hrscomm
  have hKE : K ≤ E := by
    apply (Subgroup.closure_le _).mpr
    intro y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
    rcases hy with hy | hy
    · exact (le_sup_left : X ≤ E) (by simpa [hy] using hrX)
    · subst y
      exact (le_sup_right : Subgroup.zpowers s ≤ E) (Subgroup.mem_zpowers s)
  letI : IsElementaryAbelian 2 K := {
    toIsMulCommutative := @IsKleinFour.isMulCommutative K _ hKfour
    exponent_dvd_p := by
      rw [hKfour.exponent_two] }
  let Ksub : Subgroup E := K.subgroupOf E
  letI : IsElementaryAbelian 2 Ksub := IsElementaryAbelian.subgroupOf hKE
  have hKcard : Nat.card Ksub = 4 := by
    calc
      Nat.card Ksub = Nat.card K := subgroupOf_card_eq hKE
      _ = 4 := hKfour.card_four
  have hKnoncentral : ¬ Ksub ≤ Subgroup.center E := by
    intro hKc
    have hsK : (⟨s, (le_sup_right : Subgroup.zpowers s ≤ E)
        (Subgroup.mem_zpowers s)⟩ : E) ∈ Ksub := by
      apply Subgroup.mem_subgroupOf.mpr
      exact Subgroup.subset_closure (by simp)
    let hxE : E := ⟨x, (le_sup_left : X ≤ E) hxX⟩
    have hc := Subgroup.mem_center_iff.mp (hKc hsK) hxE
    have hcG : x * s = s * x := congrArg Subtype.val hc
    have hxf : MulAut.conj s x = x := (hfix_iff x).mpr
      (Subgroup.mem_centralizer_singleton_iff.mpr hcG)
    exact hxnot (hfixed_mem_line hxX hxf)
  obtain ⟨e⟩ := dihedral_eight_of_noncentral_elementary_four hEcard Ksub hKcard hKnoncentral
  refine ⟨e, x, hxX, hconj, hXgen⟩
