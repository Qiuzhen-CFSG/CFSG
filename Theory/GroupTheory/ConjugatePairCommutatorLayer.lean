module

public import Theory.GroupTheory.AbelianGeneratorCore
public import Theory.GroupTheory.Commutator.RelativeGeneration

/-!
# The commutator layer of a normalized generating pair

If a normal subgroup Q normalizes two generators U,W of G, then [Q,G]
is the product of its intersections with U and W. There is no perfectness
hypothesis on G and no Sylow hypothesis on either generator.

This is the elementary product argument after Aschbacher--Smith (12.7.18),
printed p.845. Applying it also to a normal bottom layer V=[V,G] supplies
that layer's compatible product, needed before quotienting the pair.
-/

public section
open scoped Pointwise
namespace Subgroup
variable {G : Type*} [Group G]

/-- The commutator layer is generated by its two literal intersections. -/
theorem commutator_eq_sup_intersections_of_normalizes_generators
    (U W Q : Subgroup G) [Q.Normal] (hgen : U ⊔ W = ⊤)
    (hQU : Q ≤ normalizer (U : Set G)) (hQW : Q ≤ normalizer (W : Set G)) :
    ⁅Q, (⊤ : Subgroup G)⁆ =
      (⁅Q, (⊤ : Subgroup G)⁆ ⊓ U) ⊔ (⁅Q, (⊤ : Subgroup G)⁆ ⊓ W) := by
  let P := ⁅Q, (⊤ : Subgroup G)⁆
  let D := (P ⊓ U) ⊔ (P ⊓ W)
  have hPQ : P ≤ Q := commutator_le_left Q ⊤
  let : D.Normal := normal_sup_inf_of_normal_normalizes_generators U W P hgen
    (hPQ.trans hQU) (hPQ.trans hQW)
  apply le_antisymm ?_ (sup_le inf_le_left inf_le_left)
  have hU : ⁅U, Q⁆ ≤ D :=
    (le_inf ((commutator_mono le_top le_rfl).trans_eq (commutator_comm ⊤ Q))
      (le_normalizer_iff_commutator_le_left.mp hQU)).trans le_sup_left
  have hW : ⁅W, Q⁆ ≤ D :=
    (le_inf ((commutator_mono le_top le_rfl).trans_eq (commutator_comm ⊤ Q))
      (le_normalizer_iff_commutator_le_left.mp hQW)).trans le_sup_right
  change P ≤ D
  calc
    P = ⁅U ⊔ W, Q⁆ := by rw [hgen, commutator_comm]
    _ ≤ D := commutator_sup_le_of_relative_normal ⊤ U W Q D
      le_normalizer_of_normal le_top le_top hU hW

/-- The same equality is the ordered setwise product. -/
theorem commutator_eq_product_intersections_of_normalizes_generators
    (U W Q : Subgroup G) [Q.Normal] (hgen : U ⊔ W = ⊤)
    (hQU : Q ≤ normalizer (U : Set G)) (hQW : Q ≤ normalizer (W : Set G)) :
    ((⁅Q, (⊤ : Subgroup G)⁆ : Subgroup G) : Set G) =
      (⁅Q, (⊤ : Subgroup G)⁆ ⊓ U : Subgroup G) *
        (⁅Q, (⊤ : Subgroup G)⁆ ⊓ W : Subgroup G) := by
  have he := commutator_eq_sup_intersections_of_normalizes_generators U W Q hgen hQU hQW
  calc
    ((⁅Q, (⊤ : Subgroup G)⁆ : Subgroup G) : Set G) =
        ((⁅Q, (⊤ : Subgroup G)⁆ ⊓ U) ⊔ (⁅Q, (⊤ : Subgroup G)⁆ ⊓ W) : Subgroup G) :=
      congrArg (fun K : Subgroup G => (K : Set G)) he
    _ = _ := coe_sup_inf_eq_mul_of_normal_normalizes U W ⁅Q, (⊤ : Subgroup G)⁆
      ((commutator_le_left Q ⊤).trans hQU)

/-- A normal layer generated by its commutators has the same compatible
intersection product. -/
theorem self_commutator_eq_product_intersections
    (U W V : Subgroup G) [V.Normal] (hgen : U ⊔ W = ⊤)
    (hVU : V ≤ normalizer (U : Set G)) (hVW : V ≤ normalizer (W : Set G))
    (hV : ⁅V, (⊤ : Subgroup G)⁆ = V) :
    (V : Set G) = (V ⊓ U : Subgroup G) * (V ⊓ W : Subgroup G) := by
  simpa only [hV] using
    commutator_eq_product_intersections_of_normalizes_generators U W V hgen hVU hVW

end Subgroup
