module
public import Theory.GroupTheory.PCorePrimeToIndex
public import Theory.GroupTheory.PerfectSmallNormalizer
public import Theory.GroupTheory.GeneralizedFitting.QuasisimpleCore
public import Theory.GroupTheory.CComponent.SolvableSupplement
public import Theory.GroupTheory.CComponent.QuasisimpleFactors
public import Theory.GroupTheory.CComponent.Radical
/-!
# Conjugate pairs across an odd nilpotent normal subgroup

Let B be quasisimple with center of order two, and let N be an odd nilpotent
normal subgroup, disjoint from B and containing its own centralizer. Some
N-conjugate moves the central involution of B. The group generated by that
pair of conjugates has trivial two-core, is perfect and is a C-component,
but its Fitting subgroup is noncentral.

Both copies of B have odd index in the pair. Its two-core therefore lies in
both distinct central involution subgroups. The quotient modulo the odd
kernel is the original B; a central Fitting subgroup would make its marked
involution central in the pair, contradicting the trivial two-core.

Source: the noncentral-Fitting pair in Aschbacher--Smith C.5.12, printed p.163.
-/
public section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace Theory.GroupTheory.OddRadicalConjugatePair
variable {G : Type*} [Group G] [Finite G]

/-- An intermediate subgroup of BN containing B has odd relative index over B. -/
theorem odd_relative_index (N B E : Subgroup G) [N.Normal]
    (hn : Odd (Nat.card N)) (hBE : B ≤ E) (hE : E ≤ B ⊔ N) : Odd (B.relIndex E) := by
  have hd : B.relIndex E ∣ B.relIndex (B ⊔ N) :=
    ⟨E.relIndex (B ⊔ N),(relIndex_mul_relIndex B E (B ⊔ N) hBE hE).symm⟩
  have hd' : B.relIndex (B ⊔ N) ∣ Nat.card N := by
    rw [sup_comm,relIndex_sup_of_normal_left]
    exact relIndex_dvd_card B N
  exact hn.of_dvd_nat (hd.trans hd')

/-- An odd-index quasisimple subgroup contains the ambient two-core in its center. -/
theorem core_le_component_center (B E : Subgroup G) [IsQuasisimple B]
    (hBE : B ≤ E) (hodd : Odd (B.relIndex E)) :
    (pCore 2 E).map E.subtype ≤ (center B).map B.subtype := by
  let B' := B.subgroupOf E
  let e : B' ≃* B := subgroupOfEquivOfLe hBE
  let : IsQuasisimple B' := IsQuasisimple.of_mulEquiv e.symm
  have hidx : ¬ 2 ∣ B'.index := by
    exact hodd.not_two_dvd_nat
  have hcore := pCore_le_map_pCore_of_prime_not_dvd_index B' hidx
  rintro _ ⟨x,hx,rfl⟩
  obtain ⟨b,hb,he⟩ := hcore hx
  have hb' : e b ∈ center B := by
    rw [mem_center_iff]
    intro y
    obtain ⟨w,rfl⟩ := e.surjective y
    exact congrArg e (mem_center_iff.mp (IsQuasisimple.pCore_le_center 2 hb) w)
  refine ⟨e b,hb',?_⟩
  exact congrArg Subtype.val he

/-- Moving the unique nonidentity central element makes the conjugate pair two-core-free. -/
theorem twoCore_pair_eq_bot
    (N B : Subgroup G) [N.Normal] [IsQuasisimple B]
    (hn : Odd (Nat.card N)) (z : B)
    (hunique : ∀ b ∈ center B, b ≠ 1 → b=z)
    (g : G) (hg : g ∈ N) (hmove : g*(z : G)*g⁻¹ ≠ z) :
    pCore 2 (B ⊔ B.map (MulAut.conj g).toMonoidHom : Subgroup G) = ⊥ := by
  let C := B.map (MulAut.conj g).toMonoidHom
  let E := B ⊔ C
  let eC : B ≃* C := B.equivMapOfInjective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective
  let : IsQuasisimple C := IsQuasisimple.of_mulEquiv eC
  have hC : C ≤ B ⊔ N := by
    rintro _ ⟨b,hb,rfl⟩
    exact (B ⊔ N).mul_mem ((B ⊔ N).mul_mem ((le_sup_right : N ≤ B ⊔ N) hg)
      ((le_sup_left : B ≤ B ⊔ N) hb)) ((B ⊔ N).inv_mem ((le_sup_right : N ≤ B ⊔ N) hg))
  have hE : E ≤ B ⊔ N := sup_le le_sup_left hC
  have hBN : B ≤ C ⊔ N := by
    intro b hb
    have hc : g*b*g⁻¹ ∈ C := mem_map_of_mem (MulAut.conj g).toMonoidHom hb
    have hh := (C ⊔ N).mul_mem ((C ⊔ N).mul_mem ((C ⊔ N).inv_mem ((le_sup_right : N ≤ C ⊔ N) hg))
      ((le_sup_left : C ≤ C ⊔ N) hc)) ((le_sup_right : N ≤ C ⊔ N) hg)
    simpa only [inv_mul_cancel_left,mul_assoc,inv_mul_cancel_right,inv_mul_cancel,mul_one] using hh
  have hE' : E ≤ C ⊔ N := sup_le hBN le_sup_left
  have hleft := core_le_component_center B E le_sup_left (odd_relative_index N B E hn le_sup_left hE)
  have hright := core_le_component_center C E le_sup_right (odd_relative_index N C E hn le_sup_right hE')
  apply le_bot_iff.mp
  intro x hx
  by_contra hxn
  have hxne : x ≠ 1 := hxn
  obtain ⟨b,hb,he⟩ := hleft (mem_map_of_mem E.subtype hx)
  have hb1 : b ≠ 1 := by intro hh; subst b; exact hxne (Subtype.ext he.symm)
  have hbz := hunique b hb hb1
  have hxz : (x : G) = z := he.symm.trans (congrArg Subtype.val hbz)
  obtain ⟨c,hc,hce⟩ := hright (mem_map_of_mem E.subtype hx)
  have hc1 : c ≠ 1 := by intro hh; subst c; exact hxne (Subtype.ext hce.symm)
  have hcB : eC.symm c ∈ center B := by
    rw [mem_center_iff]
    intro y
    apply eC.injective
    simpa only [map_mul,eC.apply_symm_apply] using mem_center_iff.mp hc (eC y)
  have hcB1 : eC.symm c ≠ 1 := by intro hh; apply hc1; exact eC.symm.injective (hh.trans eC.symm.map_one.symm)
  have hcz := hunique _ hcB hcB1
  apply hmove
  have hh := congrArg (fun b : B => (eC b : G)) hcz
  rw [eC.apply_symm_apply] at hh
  change (c : G) = g * (z : G) * g⁻¹ at hh
  exact hh.symm.trans (hce.trans hxz)


omit [Finite G] in
/-- The literal pair maps onto B with kernel its intersection with N. -/
theorem pair_quotient
    (N B : Subgroup G) [N.Normal] (hBN : B ⊓ N = ⊥)
    (g : G) (hg : g ∈ N) :
    let E := B ⊔ B.map (MulAut.conj g).toMonoidHom
    ∃ f : E →* B, Function.Surjective f ∧ f.ker = N.subgroupOf E := by
  let E := B ⊔ B.map (MulAut.conj g).toMonoidHom
  let q := QuotientGroup.mk' N
  have hqg : q g = 1 := (QuotientGroup.eq_one_iff g).mpr hg
  have hconj : q.comp (MulAut.conj g).toMonoidHom = q := by
    ext x
    simp only [MonoidHom.comp_apply,MulEquiv.coe_toMonoidHom,MulAut.conj_apply,map_mul,map_inv,hqg,one_mul,mul_one,inv_one]
  have hmap : E.map q = B.map q := by
    change (B ⊔ B.map (MulAut.conj g).toMonoidHom).map q = _
    rw [Subgroup.map_sup,map_map,hconj,sup_idem]
  have hbi : Function.Injective (q.subgroupMap B) := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    apply le_bot_iff.mp
    intro b hb
    have hq : q (b : G) = 1 := congrArg Subtype.val hb
    have hn : (b : G) ∈ N := (QuotientGroup.eq_one_iff _).mp hq
    have hb1 : (b : G) ∈ (⊥ : Subgroup G) := hBN ▸ (show (b : G) ∈ B ⊓ N from ⟨b.property,hn⟩)
    exact Subtype.ext hb1
  let eB : B ≃* B.map q := MulEquiv.ofBijective (q.subgroupMap B) ⟨hbi,q.subgroupMap_surjective B⟩
  let a : E.map q ≃* B := (MulEquiv.subgroupCongr hmap).trans eB.symm
  let f := a.toMonoidHom.comp (q.subgroupMap E)
  refine ⟨f,a.surjective.comp (q.subgroupMap_surjective E),?_⟩
  ext x
  change a (q.subgroupMap E x) = 1 ↔ (x : G) ∈ N
  rw [a.map_eq_one_iff]
  constructor
  · intro hx
    exact (QuotientGroup.eq_one_iff _).mp (congrArg Subtype.val hx)
  · intro hx
    exact Subtype.ext ((QuotientGroup.eq_one_iff _).mpr hx)

omit [Finite G] in
/-- The subgroup generated by two conjugates of a perfect subgroup is perfect. -/
theorem pair_perfect (B : Subgroup G) [Group.IsPerfect B] (g : G) :
    Group.IsPerfect (B ⊔ B.map (MulAut.conj g).toMonoidHom : Subgroup G) := by
  let C := B.map (MulAut.conj g).toMonoidHom
  let : Group.IsPerfect C := Group.IsPerfect.map _
  rw [Subgroup.isPerfect_iff]
  apply le_antisymm (commutator_le_self _)
  apply sup_le
  · exact (commutator_eq_self (H := B)).symm.le.trans (commutator_mono le_sup_left le_sup_left)
  · exact (commutator_eq_self (H := C)).symm.le.trans (commutator_mono le_sup_right le_sup_right)

/-- The whole pair is a C-component, through its actual solvable-kernel quotient. -/
theorem pair_isCComponent
    (N B : Subgroup G) [N.Normal] [Group.IsNilpotent N] [IsQuasisimple B]
    (hBN : B ⊓ N = ⊥) (g : G) (hg : g ∈ N) :
    (⊤ : Subgroup (B ⊔ B.map (MulAut.conj g).toMonoidHom : Subgroup G)).IsCComponent := by
  let E := B ⊔ B.map (MulAut.conj g).toMonoidHom
  let : Group.IsPerfect E := pair_perfect B g
  obtain ⟨f,hf,hker⟩ := pair_quotient N B hBN g hg
  let j : f.ker →* N := (E.subtype.comp f.ker.subtype).codRestrict N (by
    intro x
    exact (show x.val ∈ N.subgroupOf E from hker ▸ x.property))
  have hj : Function.Injective j := by
    intro a b he
    exact Subtype.ext (Subtype.ext (congrArg (fun x : N => (x : G)) he))
  let : Group.IsSolvable f.ker := Group.isSolvable_of_isSolvable_injective hj
  have ht : (⊤ : Subgroup B).IsCComponent :=
    (show IsComponent B ⊤ from ⟨.top,IsQuasisimple.of_mulEquiv topEquiv.symm⟩).isCComponent
  have hres := residual_isCComponent_of_surjective f hf (by simpa only [solvableResidual_eq_top] using ht)
  simpa only [solvableResidual_eq_top] using hres

omit [Finite G] in
/-- A two-core-free pair containing a central involution of B has noncentral Fitting subgroup. -/
theorem noncentral_fitting_of_pair
    (N B : Subgroup G) [N.Normal] [Group.IsNilpotent N]
    (g : G) (hg : g∈N) (z : B) (hz : z∈center B) (hz2 : orderOf z=2)
    (hcore : pCore 2 (B ⊔ B.map (MulAut.conj g).toMonoidHom : Subgroup G)=⊥) :
    ¬ fittingSubgroup (B ⊔ B.map (MulAut.conj g).toMonoidHom : Subgroup G) ≤
      center (B ⊔ B.map (MulAut.conj g).toMonoidHom : Subgroup G) := by
  let E := B ⊔ B.map (MulAut.conj g).toMonoidHom
  let K := N.subgroupOf E
  let j : K →* N := E.subtype.subgroupComap N
  have hj : Function.Injective j := by
    intro a b he
    exact Subtype.ext (Subtype.ext (congrArg (fun n : N => (n : G)) he))
  let : Group.IsNilpotent K := Subgroup.isNilpotent_of_ker_le_center j
    (by rw [(MonoidHom.ker_eq_bot_iff j).mpr hj]; exact bot_le)
  have hKF : K ≤ fittingSubgroup E := le_sSup ⟨inferInstance,inferInstance⟩
  intro hFC
  have hKC : K ≤ center E := hKF.trans hFC
  let t : E := inclusion le_sup_left z
  have hE : E ≤ B ⊔ N := by
    apply sup_le le_sup_left
    rintro _ ⟨b,hb,rfl⟩
    exact (B ⊔ N).mul_mem ((B ⊔ N).mul_mem ((le_sup_right : N ≤ B ⊔ N) hg)
      ((le_sup_left : B ≤ B ⊔ N) hb)) ((B ⊔ N).inv_mem ((le_sup_right : N ≤ B ⊔ N) hg))
  have ht : t ∈ center E := by
    rw [mem_center_iff]
    intro x
    obtain ⟨b,hb,n,hn,hprod⟩ := mem_sup_of_normal_right.mp (hE x.property)
    have hnE : n ∈ E := by
      have hh := E.mul_mem (E.inv_mem ((le_sup_left : B ≤ E) hb)) x.property
      rw [← hprod,inv_mul_cancel_left] at hh
      exact hh
    have hnc : (⟨n,hnE⟩ : E) ∈ center E := hKC hn
    have hnz : n*(z : G) = (z : G)*n :=
      (congrArg Subtype.val (mem_center_iff.mp hnc t)).symm
    have hbz : b*(z : G) = (z : G)*b :=
      congrArg Subtype.val (mem_center_iff.mp hz ⟨b,hb⟩)
    apply Subtype.ext
    change (x : G)*(z : G) = (z : G)*(x : G)
    rw [← hprod,mul_assoc,hnz,← mul_assoc,hbz,mul_assoc]
  have htz : orderOf t=2 := by
    exact (orderOf_injective (inclusion le_sup_left) (inclusion_injective le_sup_left) z).trans hz2
  let C := zpowers t
  let : C.Normal := ⟨fun c hc x => by
    have hcc : c ∈ center E := (zpowers_le.mpr ht) hc
    change x*c*x⁻¹∈C
    rw [mem_center_iff.mp hcc x,mul_inv_cancel_right]
    exact hc⟩
  have hCp : IsPGroup 2 C := IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers,htz]; norm_num)
  have hCcore : C ≤ pCore 2 E := le_sSup ⟨inferInstance,hCp⟩
  have htmem := hCcore (mem_zpowers t)
  rw [hcore] at htmem
  have ht1 : t=1 := htmem
  have hh : orderOf t=1 := by rw [ht1,orderOf_one]
  omega

/-- Choose an odd-radical conjugate yielding the required noncentral C-component. -/
theorem exists_pair_of_quasisimple_center_two
    (N B : Subgroup G) [N.Normal] [Group.IsNilpotent N] [IsQuasisimple B]
    (hn : Odd (Nat.card N)) (hself : centralizer (N : Set G) ≤ N)
    (hBN : B ⊓ N=⊥) (hZ : Nat.card (center B)=2) :
    ∃ g∈N,
      let E := B ⊔ B.map (MulAut.conj g).toMonoidHom
      pCore 2 E=⊥ ∧ Group.IsPerfect E ∧ (⊤ : Subgroup E).IsCComponent ∧
        ¬ fittingSubgroup E ≤ center E := by
  obtain ⟨t,ht2⟩ := exists_prime_orderOf_dvd_card' (G := center B) 2 (by rw [hZ])
  let z : B := t.val
  have hz : z∈center B := t.property
  have hz2 : orderOf z=2 := (Subgroup.orderOf_coe t).trans ht2
  have hz1 : z≠1 := by intro hh; rw [hh,orderOf_one] at hz2; contradiction
  have ht1 : t≠1 := by intro hh; exact hz1 (congrArg Subtype.val hh)
  have huniq : ∀ b∈center B, b≠1 → b=z := by
    obtain ⟨w,_,hw⟩ := (Nat.card_eq_two_iff' (1 : center B)).mp hZ
    intro b hb hb1
    have hh : (⟨b,hb⟩ : center B)≠1 := fun he => hb1 (congrArg Subtype.val he)
    exact congrArg Subtype.val ((hw ⟨b,hb⟩ hh).trans (hw t ht1).symm)
  have hzG2 : orderOf (z : G)=2 := (Subgroup.orderOf_coe z).trans hz2
  have hzN : (z : G)∉N := by
    intro hh
    have hd := orderOf_dvd_natCard N hh
    rw [hzG2] at hd
    exact hn.not_two_dvd_nat hd
  have hmove : ∃ g∈N, g*(z : G)*g⁻¹ ≠ z := by
    by_contra! hh
    apply hzN
    apply hself
    intro g hg
    exact mul_inv_eq_iff_eq_mul.mp (hh g hg)
  obtain ⟨g,hg,hmove⟩ := hmove
  have hcore := twoCore_pair_eq_bot N B hn z huniq g hg hmove
  exact ⟨g,hg,hcore,pair_perfect B g,pair_isCComponent N B hBN g hg,
    noncentral_fitting_of_pair N B g hg z hz hz2 hcore⟩

end Theory.GroupTheory.OddRadicalConjugatePair
