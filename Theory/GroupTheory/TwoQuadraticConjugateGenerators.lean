module

public import Theory.GroupTheory.Commutator.NormalGeneration
public import Mathlib.GroupTheory.GroupAction.ConjAct

/-!
# Fixed subgroups from two quadratic conjugate generators

Let V be normal abelian and generated by its commutators with G. If two
conjugate subgroups S and Sᵍ generate G and act quadratically on V, then
C_V(S)=[S,V]. Indeed V=[S,V][Sᵍ,V]. A vector fixed by S decomposes into
one S-fixed displacement and one displacement fixed by both generators.
The latter is central in G, so conjugating it back places it in [S,V] too.

This is the group form of Campbell, *Pushing up in Finite Groups* (1979),
II.1 and II.4.3(iv), printed pp.21–25. No classification or rank assumption
is used in this finite-generation argument.
-/

public section
namespace Subgroup
open Subgroup
open scoped commutatorElement IsMulCommutative

private theorem commutator_sup_normal {G : Type*} [Group G] (V A B : Subgroup G) [V.Normal] :
    ⁅V,A ⊔ B⁆ = ⁅V,A⁆ ⊔ ⁅V,B⁆ := by
  simpa [iSup_bool_eq] using
    commutator_iSup_of_normal_left V (fun b : Bool => if b then A else B)

theorem fixed_eq_commutator_of_two_quadratic_conjugates {G : Type*} [Group G]
    (V S : Subgroup G) [V.Normal] [IsMulCommutative V] (g : G)
    (hgen : S ⊔ S.map (MulAut.conj g).toMonoidHom = ⊤)
    (hfull : ⁅V,(⊤ : Subgroup G)⁆ = V)
    (hquad : ⁅S,V⁆ ≤ centralizer (S : Set G))
    (hquad' : ⁅S.map (MulAut.conj g).toMonoidHom,V⁆ ≤
      centralizer (S.map (MulAut.conj g).toMonoidHom : Set G)) :
    V ⊓ centralizer (S : Set G) = ⁅S,V⁆ := by
  let S' := S.map (MulAut.conj g).toMonoidHom
  let W := ⁅S,V⁆
  let W' := ⁅S',V⁆
  have hVm : V.map (MulAut.conj g).toMonoidHom = V :=
    mem_normalizer_iff_map_conj_eq.mp (le_normalizer_of_normal (mem_top g))
  have hWm : W.map (MulAut.conj g).toMonoidHom = W' := by
    rw [map_commutator,hVm]
  have hVV : V = W ⊔ W' := by
    rw [←hfull,←hgen,commutator_sup_normal]
    rw [commutator_comm V S,commutator_comm V S']

  have hj : W.subgroupOf V ⊔ W'.subgroupOf V = ⊤ := by
    apply map_injective V.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le (commutator_le_right S V),
      map_subgroupOf_eq_of_le (commutator_le_right S' V),
      ←MonoidHom.range_eq_map,range_subtype,←hVV]
  apply le_antisymm ?_ (le_inf (commutator_le_right S V) hquad)
  intro x hx
  have hx' : (⟨x,hx.1⟩ : V) ∈ W.subgroupOf V ⊔ W'.subgroupOf V := by rw [hj]; trivial
  obtain ⟨u,hu,v,hv,he⟩ := mem_sup_of_normal_left.mp hx'
  have he' : (u:G)*(v:G)=x := congrArg Subtype.val he
  have hvS : (v:G) ∈ centralizer (S : Set G) := by
    have hh := (centralizer (S : Set G)).mul_mem
      ((centralizer (S : Set G)).inv_mem (hquad hu)) hx.2
    change (u:G)⁻¹*x ∈ centralizer (S : Set G) at hh
    rw [←he',inv_mul_cancel_left] at hh
    exact hh
  have hvC : (v:G) ∈ center G := by
    apply mem_center_iff.mpr
    intro y
    have hl : S ⊔ S' ≤ centralizer ({(v:G)} : Set G) := by
      apply sup_le
      · intro a ha
        exact mem_centralizer_singleton_iff.mpr (hvS a ha)
      · intro a ha
        exact mem_centralizer_singleton_iff.mpr (hquad' hv a ha)
    exact mem_centralizer_singleton_iff.mp (hl (hgen ▸ mem_top y))
  have hvW' : (v:G) ∈ W.map (MulAut.conj g).toMonoidHom := hWm.symm ▸ hv
  obtain ⟨t,ht,htv⟩ := hvW'
  have hvg : (MulAut.conj g) (v:G) = v := by
    change g*(v:G)*g⁻¹=v
    rw [mem_center_iff.mp hvC g,mul_inv_cancel_right]
  have htv' : t = (v:G) := (MulAut.conj g).injective (htv.trans hvg.symm)
  have hvW : (v:G) ∈ W := htv' ▸ ht
  rw [←he']
  exact W.mul_mem hu hvW

end Subgroup
