module
public import Theory.GroupTheory.DihedralPresentation
public import Theory.GroupTheory.NormalizingInvolutionCard
public import Mathlib.GroupTheory.SpecificGroups.KleinFour
public import Mathlib.GroupTheory.PGroup
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Dihedral recognition from an exchanged pair of four-groups

Let a noncommutative group of order eight be generated by two distinct Klein
four subgroups. An external involution interchanging the subgroups extends it
to a dihedral group of order sixteen.

Choose an involution in the first four-group outside the second. Its conjugate
lies in the second outside the first; the two do not commute and therefore
generate the order-eight group. Their product with the swapping involution
gives the rotation in the dihedral presentation. Normalization doubles the
cardinality, and the existing presentation theorem completes recognition.

Source: Aschbacher--Smith, combined manuscript of 1 March 2004, printed p.539,
last paragraph, where `R_s = U_s U_s^x` has order eight and `R_s⟨x⟩` is dihedral
of order sixteen, with the involution `x` supplied by 2.4.24.3. The source's
maximal elementary subgroup condition supplies noncommutativity; that condition
is necessary to exclude an elementary abelian order-eight group.
-/

open Subgroup
open scoped IsMulCommutative

namespace DihedralGroup

private theorem index_two_sup_zpowers {K : Type*} [Group K]
    (A : Subgroup K) (hi : A.index = 2) (y : K) (hy : y ∉ A) :
    A ⊔ zpowers y = ⊤ := by
  apply top_unique
  intro z _
  by_cases hz : z ∈ A
  · exact (show A ≤ A ⊔ zpowers y from le_sup_left) hz
  · have hzy : z * y⁻¹ ∈ A := by
      rw [A.mul_mem_iff_of_index_two hi, A.inv_mem_iff]
      exact iff_of_false hz hy
    simpa using (A ⊔ zpowers y).mul_mem ((show A ≤ A ⊔ zpowers y from le_sup_left) hzy) ((show zpowers y ≤ A ⊔ zpowers y from le_sup_right) (mem_zpowers y))

private theorem commutative_sup {K : Type*} [Group K]
    (A B : Subgroup K) [IsMulCommutative A] [IsMulCommutative B]
    (hBA : B ≤ centralizer (A : Set K)) : IsMulCommutative (A ⊔ B : Subgroup K) := by
  apply le_centralizer_iff_isMulCommutative.mp
  apply sup_le
  · exact le_centralizer_iff.mpr (sup_le A.le_centralizer hBA)
  · exact le_centralizer_iff.mpr (sup_le (le_centralizer_iff.mp hBA) B.le_centralizer)

private theorem commutative_of_top {K : Type*} [Group K]
    (A : Subgroup K) (hA : A = ⊤) (hcomm : IsMulCommutative A) : IsMulCommutative K := by
  refine ⟨⟨fun a b => ?_⟩⟩
  exact congrArg Subtype.val (hcomm.is_comm.comm
    (⟨a, by rw [hA]; trivial⟩ : A) ⟨b, by rw [hA]; trivial⟩)

private theorem crossing_noncomm {K : Type*} [Group K]
    (hn : ¬ IsMulCommutative K) (A B : Subgroup K)
    [IsMulCommutative A] [IsMulCommutative B]
    (hiA : A.index = 2) (hiB : B.index = 2)
    (a y : K) (haA : a ∈ A) (haB : a ∉ B) (hyA : y ∉ A)
    (hcomm : a * y = y * a) : False := by
  let C := centralizer ({a} : Set K)
  have hAC : A ≤ C := by
    intro z hz
    exact mem_centralizer_singleton_iff.mpr (congrArg Subtype.val (mul_comm (⟨z, hz⟩ : A) ⟨a, haA⟩))
  have hyC : y ∈ C := mem_centralizer_singleton_iff.mpr hcomm.symm
  have hC : C = ⊤ := top_unique (by
    rw [← index_two_sup_zpowers A hiA y hyA]
    exact sup_le hAC (zpowers_le.mpr hyC))
  have haC : a ∈ centralizer (B : Set K) := by
    intro b _
    have hbC : b ∈ C := by rw [hC]; trivial
    exact mem_centralizer_singleton_iff.mp hbC
  apply hn
  exact commutative_of_top (B ⊔ zpowers a) (index_two_sup_zpowers B hiB a haB)
    (commutative_sup B (zpowers a) (zpowers_le.mpr haC))

private theorem pair_generates_of_noncomm_card_eight {K : Type*} [Group K] [Finite K]
    (hK : Nat.card K = 8) (a b : K) (hn : a * b ≠ b * a) :
    closure ({a,b} : Set K) = ⊤ := by
  let D := closure ({a,b} : Set K)
  have hd : Nat.card D ∣ 8 := by simpa [hK] using D.card_subgroup_dvd_card
  obtain ⟨k, hk, hc⟩ := (Nat.dvd_prime_pow (by decide : Nat.Prime 2)).mp
    (show Nat.card D ∣ 2 ^ 3 from hd)
  have ha : a ∈ D := subset_closure (by simp)
  have hb : b ∈ D := subset_closure (by simp)
  have hex (hc : IsMulCommutative D) : False :=
    hn (congrArg Subtype.val (hc.is_comm.comm (⟨a,ha⟩ : D) ⟨b,hb⟩))
  interval_cases k
  · have hs : Nat.card D = 1 := by simpa using hc
    let : Subsingleton D := Finite.card_le_one_iff_subsingleton.mp hs.le
    exact (hex inferInstance).elim
  · have hs : Nat.card D = 2 := by simpa using hc
    let : IsCyclic D := isCyclic_of_prime_card (p := 2) hs
    exact (hex inferInstance).elim
  · exact (hex (IsPGroup.isMulCommutative_of_card_eq_prime_sq (p := 2) hc)).elim
  · exact D.eq_top_of_card_eq (hc.trans hK.symm)

private theorem pow_four_of_noncomm_card_eight {K : Type*} [Group K] [Finite K]
    (hK : Nat.card K = 8) (hn : ¬ IsMulCommutative K) (a : K) : a ^ 4 = 1 := by
  have hd : orderOf a ∣ 8 := by simpa [hK] using orderOf_dvd_natCard a
  obtain ⟨k, hk, hc⟩ := (Nat.dvd_prime_pow (by decide : Nat.Prime 2)).mp
    (show orderOf a ∣ 2 ^ 3 from hd)
  have hne : orderOf a ≠ 8 := by
    intro h
    let : IsCyclic K := isCyclic_of_orderOf_eq_card a (h.trans hK.symm)
    exact hn inferInstance
  apply orderOf_dvd_iff_pow_eq_one.mp
  interval_cases k <;> norm_num at hc ⊢ <;> simp_all

/-- Swapping two generating Klein four subgroups in a noncommutative group of
order eight by an external involution produces a dihedral group of order sixteen. -/
public theorem equiv_of_exchanged_klein_pair
    {G : Type*} [Group G] [Finite G]
    (P J A B : Subgroup G) (hP : Nat.card P = 8)
    (hn : ¬ IsMulCommutative P) [IsKleinFour A] [IsKleinFour B]
    (hAP : A ≤ P) (hBP : B ≤ P) (hAB : A ≠ B) (hgen : A ⊔ B = P)
    (x : G) (hx : x ^ 2 = 1) (hxP : x ∉ P)
    (hswap : A.map (MulAut.conj x).toMonoidHom = B)
    (hJ : J = P ⊔ zpowers x) : Nonempty (J ≃* DihedralGroup 8) := by
  let f := (MulAut.conj x).toMonoidHom
  have hxx : x * x = 1 := by simpa only [pow_two] using hx
  have hxi : x⁻¹ = x := inv_eq_of_mul_eq_one_right hxx
  have hff : f.comp f = MonoidHom.id G := by
    ext z
    change x * (x * z * x⁻¹) * x⁻¹ = z
    rw [hxi]
    simp only [← mul_assoc, hxx, one_mul]
    simp only [mul_assoc, hxx, mul_one]
  have hswapB : B.map f = A := by
    rw [← hswap, map_map, hff, map_id]
  have hnorm : x ∈ normalizer (P : Set G) := by
    apply mem_normalizer_iff_map_conj_eq.mpr
    change P.map f = P
    rw [← hgen, Subgroup.map_sup, hswap, hswapB, sup_comm]
  have hJcard : Nat.card J = 16 := by
    rw [hJ, card_sup_zpowers_of_normalizing_involution P x hx hxP hnorm, hP]
  have hPJ : P ≤ J := by rw [hJ]; exact le_sup_left
  have hxJ : x ∈ J := by rw [hJ]; exact mem_sup_right (mem_zpowers x)
  have hnle : ¬ A ≤ B := fun h => hAB (eq_of_le_of_card_ge h (by simp))
  obtain ⟨a, haA, haB⟩ := SetLike.not_le_iff_exists.mp hnle
  have haP : a ∈ P := hAP haA
  have hasq : a ^ 2 = 1 := by
    rw [pow_two]
    exact congrArg Subtype.val (IsKleinFour.mul_self (⟨a,haA⟩ : A))
  let y := f a
  have hyB : y ∈ B := hswap ▸ mem_map_of_mem f haA
  have hyP : y ∈ P := hBP hyB
  have hya : f y = a := by change (f.comp f) a = a; rw [hff]; rfl
  have hyA : y ∉ A := fun h => haB (hya ▸ (hswap ▸ mem_map_of_mem f h))
  let AP := A.subgroupOf P
  let BP := B.subgroupOf P
  let : IsMulCommutative A := IsKleinFour.isMulCommutative
  let : IsMulCommutative B := IsKleinFour.isMulCommutative
  have hAPcard : Nat.card AP = 4 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hAP).toEquiv]; simp
  have hBPcard : Nat.card BP = 4 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hBP).toEquiv]; simp
  have hiA : AP.index = 2 := by
    have hc := AP.card_mul_index
    rw [hAPcard, hP] at hc
    omega
  have hiB : BP.index = 2 := by
    have hc := BP.card_mul_index
    rw [hBPcard, hP] at hc
    omega
  let ap : P := ⟨a,haP⟩
  let yp : P := ⟨y,hyP⟩
  have hnc : ap * yp ≠ yp * ap := by
    intro hc
    exact crossing_noncomm hn AP BP hiA hiB ap yp haA haB hyA hc
  have hay : closure ({a,y} : Set G) = P := by
    have hpgen := pair_generates_of_noncomm_card_eight hP ap yp hnc
    have hm := congrArg (fun K : Subgroup P => K.map P.subtype) hpgen
    simpa only [MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton,
      ← MonoidHom.range_eq_map, P.range_subtype, ap, yp, Subgroup.subtype_apply] using hm
  let D := closure ({a,x} : Set G)
  have haD : a ∈ D := subset_closure (by simp)
  have hxD : x ∈ D := subset_closure (by simp)
  have hyD : y ∈ D := D.mul_mem (D.mul_mem hxD haD) (D.inv_mem hxD)
  have hPD : P ≤ D := by
    rw [← hay]
    apply (closure_le _).mpr
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl <;> assumption
  have hDJ : D = J := by
    apply le_antisymm
    · apply (closure_le _).mpr
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact hPJ haP
      · exact hxJ
    · rw [hJ]
      exact sup_le hPD (zpowers_le.mpr hxD)
  let c : G := a * x
  have hc2 : c ^ 2 = a * y := by
    change (a * x) ^ 2 = a * (x * a * x⁻¹)
    rw [pow_two, hxi]
    simp only [mul_assoc]
  have hc8 : c ^ 8 = 1 := by
    have hfour := pow_four_of_noncomm_card_eight hP hn (ap * yp)
    have hfour' : (a * y) ^ 4 = 1 := congrArg Subtype.val hfour
    rw [show 8 = 2 * 4 from rfl, pow_mul, hc2, hfour']
  have hcinv : x * c * x⁻¹ = c⁻¹ := by
    change x * (a * x) * x⁻¹ = (a * x)⁻¹
    have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using hasq)
    simp only [mul_inv_rev, hai, hxi, mul_assoc, hxx, mul_one]
  have hcJ : c ∈ J := J.mul_mem (hPJ haP) hxJ
  let cj : J := ⟨c,hcJ⟩
  let xj : J := ⟨x,hxJ⟩
  have hcx : closure ({c,x} : Set G) = J := by
    have haCx : a ∈ closure ({c,x} : Set G) := by
      have h := (closure ({c,x} : Set G)).mul_mem
        (subset_closure (by simp : c ∈ ({c,x} : Set G)))
        (subset_closure (by simp : x ∈ ({c,x} : Set G)))
      simpa only [c, mul_assoc, hxx, mul_one] using h
    apply le_antisymm
    · apply (closure_le _).mpr
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl <;> assumption
    · rw [← hDJ]
      apply (closure_le _).mpr
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact haCx
      · exact subset_closure (by simp)
  have hjgen : closure ({cj,xj} : Set J) = ⊤ := by
    apply map_injective J.subtype_injective
    rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, J.range_subtype,
      Set.image_insert_eq, Set.image_singleton]
    exact hcx
  exact dihedralGroup_equiv_of_relations (by decide : 0 < 8) cj xj
    (Subtype.ext hc8) (Subtype.ext hx) (Subtype.ext hcinv) hjgen hJcard

end DihedralGroup
