module
public import Theory.GroupTheory.SymmetricThreeTwoCoreResidual
public import Theory.GroupTheory.PResidual.CubicGeneration

/-!
# Cubic generation in an S₃-over-two-core group

The order is six times a power of two, so its two-residual is a
{2,3}-group with no factor of nine in its order. Two-perfectness then
makes that residual generated by its elements of order three. Conversely,
every cubic element belongs to the two-residual.

The fixed-line amalgam uses this equality to place a parabolic residual
inside the cubic closure of its containing normalizer.
Source: Aschbacher--Smith, Proposition 13.4.7, printed p.900.
-/

public section
open Subgroup Theory.GroupTheory
namespace SymmetricThreeTwoCore
variable {A : Type*} [Group A] [Finite A]

/-- Cubic elements generate the literal two-residual above an S₃ quotient. -/
theorem twoResidual_eq_cubic_closure
    (e : (A ⧸ pCore 2 A) ≃* Equiv.Perm (Fin 3)) :
    pResidual 2 A = closure {a : A | orderOf a = 3} := by
  let R := pResidual 2 A
  have h9 : ¬ 9 ∣ Nat.card A := by
    obtain ⟨n,hn⟩ := (pCore_isPGroup (p := 2) (G := A)).exists_card_eq
    rw [card_eq e,hn]
    intro hd
    have hc : Nat.Coprime 9 (2 ^ n) := (by decide : Nat.Coprime 9 2).pow_right n
    have hh := hc.dvd_mul_right.mp hd
    norm_num at hh
  have hc : closure {r : R | orderOf r = 3} = ⊤ :=
    cubic_closure_eq_top_of_twoPerfect
      ((twoThree_of_quotient e).of_injective R.subtype R.subtype_injective)
      (isPPerfect_pResidual (G := A) 2)
      (fun hd => h9 (hd.trans (card_subgroup_dvd_card R)))
  apply le_antisymm
  · have hm := congrArg (map R.subtype) hc
    rw [←MonoidHom.range_eq_map,range_subtype] at hm
    change R ≤ _
    rw [←hm,MonoidHom.map_closure]
    apply Subgroup.closure_mono
    rintro a ⟨r,hr,rfl⟩
    exact (R.orderOf_coe r).trans hr
  · apply (closure_le _).mpr
    intro a ha
    apply mem_pResidual_of_orderOf_coprime
    rw [ha]
    decide
end SymmetricThreeTwoCore
