module

public import Mathlib.GroupTheory.Index
import Mathlib.Algebra.Order.BigOperators.Group.Finset

/-!+# Centralizer indices from conjugate generators

Suppose `U` is generated by a subgroup centralized by `Q` and a finite
family of elements. Its centralizer in `Q` is the intersection of the
element centralizers, so its index is bounded by the product of their
indices. If the elements are conjugate by normalizers of `Q`, all these
indices are equal. No normality of the element centralizers is required.

This is the counting step in Aschbacher–Smith, *The Classification of
Quasithin Groups*, Lemma 13.8.33, printed pp.967–968 (1 March 2004
manuscript), where five conjugates have centralizer index two.
-/

public section

namespace Subgroup

variable {G : Type*} [Group G]

theorem inf_centralizer_eq_of_generated {ι : Type*}
    (V Q U : Subgroup G) (x : ι → G)
    (hgen : U = V ⊔ closure (Set.range x))
    (hQV : Q ≤ centralizer (V : Set G)) :
    Q ⊓ centralizer (U : Set G) = Q ⊓ ⨅ i, centralizer ({x i} : Set G) := by
  apply le_antisymm
  · refine le_inf inf_le_left ?_
    refine le_iInf fun i => ?_
    apply (inf_le_right : Q ⊓ centralizer (U : Set G) ≤ centralizer (U : Set G)).trans
    apply centralizer_le
    intro y hy
    have hyx : y = x i := Set.mem_singleton_iff.mp hy
    rw [hyx, hgen]
    exact (le_sup_right : closure (Set.range x) ≤ V ⊔ closure (Set.range x))
      (subset_closure ⟨i, rfl⟩)
  · refine le_inf inf_le_left ?_
    apply le_centralizer_iff.mpr
    rw [hgen]
    apply sup_le
    · exact le_centralizer_iff.mp (inf_le_left.trans hQV)
    · rw [← le_centralizer_iff, centralizer_closure]
      intro q hq y hy
      obtain ⟨i, rfl⟩ := hy
      exact (mem_iInf.mp hq.2 i) _ (Set.mem_singleton _)

theorem centralizer_relIndex_le_of_generated {ι : Type*} [Fintype ι]
    (V Q U : Subgroup G) (x : ι → G) (d : ℕ)
    (hgen : U = V ⊔ closure (Set.range x))
    (hQV : Q ≤ centralizer (V : Set G))
    (hindex : ∀ i, (centralizer ({x i} : Set G)).relIndex Q ≤ d) :
    (Q ⊓ centralizer (U : Set G)).relIndex Q ≤ d ^ Fintype.card ι := by
  rw [inf_centralizer_eq_of_generated V Q U x hgen hQV, inf_relIndex_left]
  apply (relIndex_iInf_le _).trans
  calc
    _ ≤ ∏ _i : ι, d := Finset.prod_le_prod' fun i _hi => hindex i
    _ = _ := by simp

/-- Automorphisms preserving the containing subgroup preserve the relative
centralizer index of an element. -/
theorem centralizer_relIndex_equiv (Q : Subgroup G) (e : G ≃* G) (x : G)
    (hQ : Q.map e.toMonoidHom = Q) :
    (centralizer ({e x} : Set G)).relIndex Q =
      (centralizer ({x} : Set G)).relIndex Q := by
  have hC : (centralizer ({e x} : Set G)).comap e.toMonoidHom =
      centralizer ({x} : Set G) := by
    ext y
    simp only [mem_comap, mem_centralizer_singleton_iff, MulEquiv.coe_toMonoidHom,
      ← map_mul, e.injective.eq_iff]
  have hi := relIndex_comap (H := centralizer ({e x} : Set G)) e.toMonoidHom Q
  rw [hC, hQ] at hi
  exact hi.symm

theorem centralizer_relIndex_le_of_conjugate_generators {ι : Type*} [Fintype ι]
    (V Q U : Subgroup G) (u : G) (g : ι → G) (d : ℕ)
    (hgen : U = V ⊔ closure (Set.range fun i => MulAut.conj (g i) u))
    (hQV : Q ≤ centralizer (V : Set G))
    (hg : ∀ i, g i ∈ normalizer (Q : Set G))
    (hindex : (centralizer ({u} : Set G)).relIndex Q ≤ d) :
    (Q ⊓ centralizer (U : Set G)).relIndex Q ≤ d ^ Fintype.card ι := by
  apply centralizer_relIndex_le_of_generated V Q U _ d hgen hQV
  intro i
  rw [centralizer_relIndex_equiv Q (MulAut.conj (g i)) u
    (mem_normalizer_iff_map_conj_eq.mp (hg i))]
  exact hindex

end Subgroup
