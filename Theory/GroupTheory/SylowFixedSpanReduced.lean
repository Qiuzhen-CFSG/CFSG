module
public import Theory.GroupTheory.ConjugateSpanOrder
public import Theory.PGroupCore
public import Mathlib.GroupTheory.Sylow

/-!
# Reduced action on a span generated by Sylow-fixed elements

The p-core of the faithful conjugation quotient lies in the image of a
Sylow p-subgroup, so it fixes the seed. Normality makes it fix every
conjugate of the seed, hence all of V; faithfulness makes it trivial.
No elementary or characteristic-p hypothesis is needed for this action
step itself. This supplies B.2.14's reducedness input to the actual
C.5.12 action quotient in Aschbacher–Smith, printed pp.78,163.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
/-- A normal subgroup generated by conjugates of Sylow-fixed elements has
p-reduced conjugation action. -/
theorem centralizer_quotient_pCore_eq_bot_of_sylow_fixed_span
    (V Z : Subgroup G) [V.Normal] (S : Sylow p G)
    (hZV : Z ≤ V) (hZS : Z ≤ centralizer (S : Set G))
    (hspan : V ≤ conjugateSpanBy Z ⊤) :
    pCore p (G ⧸ centralizer (V : Set G)) = ⊥ := by
  let C := centralizer (V : Set G)
  let q := QuotientGroup.mk' C
  let P := pCore p (G ⧸ C)
  let Q := P.comap q
  let : Q.Normal := inferInstance
  have hPS : P ≤ (S : Subgroup G).map q :=
    pCore_isPGroup.le_sylow_of_normal (S.mapSurjective (QuotientGroup.mk'_surjective C))
  have hZQ : Z ≤ centralizer (Q : Set G) := by
    intro z hz g hg
    obtain ⟨s,hs,he⟩ := hPS hg
    have hh : s⁻¹*g ∈ C := by
      apply (QuotientGroup.eq_one_iff _).mp
      change q (s⁻¹*g)=1
      rw [map_mul,map_inv,he,inv_mul_cancel]
    have hc : z*(s⁻¹*g)=(s⁻¹*g)*z := hh z (hZV hz)
    have hsz : s*z=z*s := (hZS hz s hs)
    calc
      g*z = s*((s⁻¹*g)*z) := by group
      _ = s*(z*(s⁻¹*g)) := by rw [hc]
      _ = z*g := by rw [← mul_assoc,hsz]; group
  have hVQ : V ≤ centralizer (Q : Set G) := hspan.trans
    (conjugateSpanBy_le hZQ (by rw [normalizer_eq_top]))
  have hQC : Q ≤ C := le_centralizer_iff.mp hVQ
  apply bot_unique
  intro y hy
  obtain ⟨g,rfl⟩ := QuotientGroup.mk'_surjective C y
  exact (QuotientGroup.eq_one_iff _).mpr (hQC hy)
end Subgroup
