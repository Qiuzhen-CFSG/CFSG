module
public import Mathlib.GroupTheory.PresentedGroup
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.SetTheory.Cardinal.Finite
public import Mathlib.Data.List.Nodup

/-!
# Presentations collected by normalization of ordered root tails

A finite ordered family of groups supplies the root parameters. The only mixed
relators express conjugation of a later root letter by an earlier letter as an
ordered word in the later tail. They imply relative normalization of every tail.
Repeated normalized subgroup products collect every abstract word, including
inverses, and give a finite coordinate bound when the parameter groups are finite.
Evaluation into any realization is constructed from these same local equations.

The application is the angular positive-root order in GLS3 2.4.5--6 and the
positive collection step in Steinberg, *Lectures on Chevalley Groups*, §11.
No map to a model, finiteness of the presented group, or kernel hypothesis is
assumed in the collection proof.
-/

@[expose] public noncomputable section
namespace Theory.GroupTheory.OrderedRootPresentation
open Subgroup
open scoped Pointwise
universe u v
variable {I : Type u} (R : I → Type v)

/-- A tuple has one parameter in each of the listed root groups. -/
def Tuple : List I → Type v
  | [] => PUnit
  | i :: l => R i × Tuple l

instance tupleFinite [∀ i, Finite (R i)] (l : List I) : Finite (Tuple R l) := by
  induction l with
  | nil => exact inferInstanceAs (Finite PUnit)
  | cons i l ih => exact inferInstanceAs (Finite (R i × Tuple R l))

/-- Ordered multiplication, without a commutativity assumption. -/
def word {G : Type*} [Monoid G] (x : ∀ i, R i → G) : (l : List I) → Tuple R l → G
  | [], _ => 1
  | i :: l, a => x i a.1 * word x l a.2

theorem map_word {G H : Type*} [Monoid G] [Monoid H] (f : G →* H)
    (x : ∀ i, R i → G) (l : List I) (a : Tuple R l) :
    f (word R x l a) = word R (fun i b => f (x i b)) l a := by
  induction l with
  | nil => exact map_one f
  | cons i l ih => exact (map_mul f _ _).trans (congrArg (f (x i a.1) * ·) (ih a.2))

variable [∀ i, Group (R i)]

/-- The subgroup generated by the listed whole root groups. -/
def join {G : Type*} [Group G] (x : ∀ i, R i →* G) : List I → Subgroup G
  | [] => ⊥
  | i :: l => (x i).range ⊔ join x l

theorem range_le_join {G : Type*} [Group G] (x : ∀ i, R i →* G)
    (l : List I) {i : I} (hi : i ∈ l) : (x i).range ≤ join R x l := by
  induction l with
  | nil => simp at hi
  | cons j l ih =>
    rcases List.mem_cons.mp hi with rfl | hi
    · exact le_sup_left
    · exact (ih hi).trans le_sup_right

theorem join_le {G : Type*} [Group G] (x : ∀ i, R i →* G)
    (l : List I) (H : Subgroup G) (h : ∀ i ∈ l, (x i).range ≤ H) : join R x l ≤ H := by
  induction l with
  | nil => exact bot_le
  | cons i l ih => exact sup_le (h i (by simp)) (ih (fun j hj => h j (by simp [hj])))

theorem word_mem_join {G : Type*} [Group G] (x : ∀ i, R i →* G)
    (l : List I) (a : Tuple R l) : word R (fun i => x i) l a ∈ join R x l := by
  induction l with
  | nil => exact one_mem _
  | cons i l ih => exact mul_mem_sup (show x i a.1 ∈ (x i).range from ⟨_, rfl⟩) (ih a.2)

/-- Relative normality of each whole tail gives existence of ordered coordinates. -/
theorem exists_word {G : Type*} [Group G] (x : ∀ i, R i →* G) (l : List I)
    (hn : ∀ before i after, l = before ++ i :: after →
      (x i).range ≤ normalizer (join R x after))
    (g : G) (hg : g ∈ join R x l) : ∃ a : Tuple R l, word R (fun i => x i) l a = g := by
  induction l generalizing g with
  | nil => exact ⟨PUnit.unit, (mem_bot.mp hg).symm⟩
  | cons i l ih =>
    have he : (↑((x i).range ⊔ join R x l) : Set G) =
        (↑(x i).range : Set G) * ↑(join R x l) :=
      coe_mul_of_left_le_normalizer_right _ _ (hn [] i l rfl)
    change g ∈ (x i).range ⊔ join R x l at hg
    rw [← SetLike.mem_coe, he] at hg
    obtain ⟨u, ⟨a, rfl⟩, v, hv, rfl⟩ := Set.mem_mul.mp hg
    obtain ⟨b, rfl⟩ := ih (by
      intro before j after hj
      apply hn (i :: before) j after
      simp only [List.cons_append, hj]) v hv
    exact ⟨(a,b), rfl⟩

variable [DecidableEq I]

/-- The finite tail of the chosen root order after i. -/
def tail (order : List I) (i : I) : List I := order.drop (order.idxOf i + 1)

theorem tail_eq {order before after : List I} {i : I} (hn : order.Nodup)
    (he : order = before ++ i :: after) : tail order i = after := by
  have hi : i ∉ before := by
    have h := hn
    rw [he, List.nodup_append] at h
    exact fun hi => h.2.2 i hi i (by simp) rfl
  simp [tail, he, List.idxOf_append_of_notMem hi]

/-- A finite conjugation table: a root parameter conjugates each later root
into its prescribed ordered tail. There are no ambient-group parameters. -/
structure Table (order : List I) where
  conjugate : ∀ (i j : I), j ∈ tail order i → R i → R j → Tuple R (tail order i)

variable {R} {order : List I} (d : Table R order)

/-- Equations on root homomorphisms in any group. -/
def Equations {G : Type*} [Group G] (x : ∀ i, R i →* G) : Prop :=
  ∀ (i j : I) (hj : j ∈ tail order i) (a : R i) (b : R j),
    x i a * x j b * (x i a)⁻¹ =
      word R (fun k => x k) (tail order i) (d.conjugate i j hj a b)

theorem Equations.normalizes {G : Type*} [Group G] {x : ∀ i, R i →* G}
    (E : Equations d x) (i : I) : (x i).range ≤ normalizer (join R x (tail order i)) := by
  rw [le_normalizer_iff]
  rintro _ ⟨a,rfl⟩ g hg
  have hle : join R x (tail order i) ≤
      (join R x (tail order i)).comap (MulAut.conj (x i a)).toMonoidHom := by
    apply join_le
    intro j hj
    rintro _ ⟨b,rfl⟩
    change x i a * x j b * (x i a)⁻¹ ∈ join R x (tail order i)
    rw [E i j hj a b]
    exact word_mem_join R x _ _
  exact hle hg

/-- Collection follows from the finite table equations, with no finiteness
or faithfulness premise on the realization. -/
theorem Equations.exists_word {G : Type*} [Group G] {x : ∀ i, R i →* G}
    (E : Equations d x) (hn : order.Nodup) (g : G) (hg : g ∈ join R x order) :
    ∃ a : Tuple R order, word R (fun i => x i) order a = g := by
  apply OrderedRootPresentation.exists_word R x order _ g hg
  intro before i after he
  have h := E.normalizes d i
  rwa [tail_eq hn he] at h

/-- The alphabet contains local root parameters only. -/
abbrev Letter := (i : I) × R i

def freeRoot (i : I) (a : R i) : FreeGroup (Letter (R := R)) := FreeGroup.of ⟨i,a⟩

inductive Relator : FreeGroup (Letter (R := R)) → Prop
  | one (i : I) : Relator (freeRoot i (1 : R i))
  | mul (i : I) (a b : R i) : Relator
      (freeRoot i a * freeRoot i b * (freeRoot i (a*b))⁻¹)
  | conjugate (i j : I) (hj : j ∈ tail order i) (a : R i) (b : R j) : Relator
      (freeRoot i a * freeRoot j b * (freeRoot i a)⁻¹ *
        (word R freeRoot (tail order i) (d.conjugate i j hj a b))⁻¹)

abbrev Presentation := PresentedGroup {w | Relator d w}

def root (i : I) (a : R i) : Presentation d := PresentedGroup.of ⟨i,a⟩

@[simp] theorem root_one (i : I) : root d i 1 = 1 :=
  PresentedGroup.one_of_mem (Relator.one i)

theorem root_mul (i : I) (a b : R i) : root d i a * root d i b = root d i (a*b) := by
  exact mul_inv_eq_one.mp (PresentedGroup.one_of_mem (Relator.mul i a b))

def rootHom (i : I) : R i →* Presentation d where
  toFun := root d i
  map_one' := root_one d i
  map_mul' a b := (root_mul d i a b).symm

theorem generator_equations : Equations d (rootHom d) := by
  intro i j hj a b
  have h := PresentedGroup.one_of_mem (rels := {w | Relator d w})
    (Relator.conjugate i j hj a b)
  rw [map_mul, map_mul, map_mul, map_inv, map_inv, map_word] at h
  exact mul_inv_eq_one.mp h

theorem normalForm (hn : order.Nodup) (hc : ∀ i, i ∈ order) (g : Presentation d) :
    ∃ a : Tuple R order, word R (fun i => root d i) order a = g := by
  apply (generator_equations d).exists_word d hn g
  apply PresentedGroup.generated_by _ _ _ g
  rintro ⟨i,a⟩
  exact range_le_join R (rootHom d) order (hc i) ⟨a,rfl⟩

/-- Finiteness is a consequence of abstract collection, not an input on the presented group. -/
theorem finite [∀ i, Finite (R i)] (hn : order.Nodup) (hc : ∀ i, i ∈ order) :
    Finite (Presentation d) := Finite.of_surjective _ (normalForm d hn hc)

variable {G : Type*} [Group G] {x : ∀ i, R i →* G}

theorem relator_eval (E : Equations d x) {w : FreeGroup (Letter (R := R))}
    (hw : Relator d w) : FreeGroup.lift (fun z : Letter (R := R) => x z.1 z.2) w = 1 := by
  cases hw with
  | one i => simp [freeRoot]
  | mul i a b => simp [freeRoot]
  | conjugate i j hj a b =>
    simpa only [map_mul, map_inv, map_word, freeRoot, FreeGroup.lift_apply_of,
      mul_inv_eq_one] using E i j hj a b

/-- The local relators construct the evaluation map. -/
def eval (E : Equations d x) : Presentation d →* G :=
  PresentedGroup.toGroup (fun _ hw => relator_eval d E hw)

@[simp] theorem eval_root (E : Equations d x) (i : I) (a : R i) :
    eval d E (root d i a) = x i a := PresentedGroup.toGroup.of _

theorem eval_word (E : Equations d x) (l : List I) (a : Tuple R l) :
    eval d E (word R (fun i => root d i) l a) = word R (fun i => x i) l a := by
  rw [map_word]
  simp only [eval_root]

/-- Every collected source word occurs in the range of the constructed evaluation. -/
theorem eval_range (E : Equations d x) (hn : order.Nodup) (hc : ∀ i, i ∈ order) :
    (eval d E).range = join R x order := by
  apply le_antisymm
  · rintro g ⟨a,rfl⟩
    obtain ⟨p,rfl⟩ := normalForm d hn hc a
    rw [eval_word]
    exact word_mem_join R x order p
  · intro g hg
    obtain ⟨p,rfl⟩ := E.exists_word d hn g hg
    exact ⟨word R (fun i => root d i) order p, eval_word d E order p⟩

/-- A derived coordinate bound, useful when native coordinates use a different order. -/
theorem card_le [∀ i, Finite (R i)] (hn : order.Nodup) (hc : ∀ i, i ∈ order) :
    Nat.card (Presentation d) ≤ Nat.card (Tuple R order) :=
  Nat.card_le_card_of_surjective _ (normalForm d hn hc)

omit [∀ i, Group (R i)] [DecidableEq I] in
/-- The coordinate bound counts each whole root group once. -/
theorem card_tuple (l : List I) :
    Nat.card (Tuple R l) = (l.map (fun i => Nat.card (R i))).prod := by
  induction l with
  | nil => simp [Tuple]
  | cons i l ih => change Nat.card (R i × Tuple R l) = _; simp [Nat.card_prod, ih]

end Theory.GroupTheory.OrderedRootPresentation

namespace Theory.GroupTheory.OrderedRootPresentation
universe u v
variable {I : Type u} (R : I → Type v) [∀ i, Group (R i)]

def ones : (l : List I) → Tuple R l
  | [] => PUnit.unit
  | _ :: l => (1, ones l)

def appendTuple : {l k : List I} → Tuple R l → Tuple R k → Tuple R (l ++ k)
  | [], _, _, b => b
  | _ :: _, _, a, b => (a.1, appendTuple a.2 b)

omit [∀ i, Group (R i)] in
theorem appendTuple_right_injective {l k : List I} (a : Tuple R l) :
    Function.Injective (appendTuple R (k := k) a) := by
  induction l with
  | nil => exact Function.injective_id
  | cons i l ih =>
    intro b c he
    exact ih a.2 (congrArg Prod.snd he)

variable {G : Type*} [Group G] (x : ∀ i, R i →* G)

theorem word_ones (l : List I) : word R (fun i => x i) l (ones R l) = 1 := by
  induction l with
  | nil => rfl
  | cons i l ih => simpa only [word, ones, map_one, one_mul] using ih

theorem word_append {l k : List I} (a : Tuple R l) (b : Tuple R k) :
    word R (fun i => x i) (l ++ k) (appendTuple R a b) =
      word R (fun i => x i) l a * word R (fun i => x i) k b := by
  induction l with
  | nil => exact (one_mul _).symm
  | cons i l ih =>
    change x i a.1 * word R (fun i => x i) (l ++ k) (appendTuple R a.2 b) = _
    rw [ih]
    exact (mul_assoc _ _ _).symm

theorem word_injective_suffix {before after order : List I}
    (he : order = before ++ after) (hinj : Function.Injective (word R (fun i => x i) order)) :
    Function.Injective (word R (fun i => x i) after) := by
  subst order
  intro a b hab
  apply appendTuple_right_injective R (ones R before)
  apply hinj
  rw [word_append, word_append, hab]

end Theory.GroupTheory.OrderedRootPresentation
