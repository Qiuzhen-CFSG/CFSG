module

public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Mathlib.Tactic.Group

/-!
# Centralizing an orbit from a commutator bound

If B centralizes U and [A,B] centralizes the subgroup generated by the
A-conjugates of U, then B centralizes that whole orbit. A direct commutator
identity gives the assertion on each conjugate, after which generation
finishes the proof. No normality of U or B is required.

Source application: Aschbacher–Smith, combined manuscript of 1 March 2004,
9.3.5(2), printed p.733; applied in SourceA5TensorExclusion.OvergroupComponent.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G]

theorem conjugateOrbit_centralizes_of_commutator_centralizes
    (A B U Q : Subgroup G) (hcomm : ⁅A, B⁆ ≤ Q)
    (hQ : Q ≤ centralizer (componentOrbit U A : Set G))
    (hB : B ≤ centralizer (U : Set G)) :
    B ≤ centralizer (componentOrbit U A : Set G) := by
  apply le_centralizer_iff.mp
  change (⨆ a : A, U.map (MulAut.conj (a : G)).toMonoidHom) ≤ centralizer (B : Set G)
  apply iSup_le
  intro a
  rintro v ⟨u, hu, rfl⟩ b hb
  change b * ((a : G) * u * (a : G)⁻¹) = ((a : G) * u * (a : G)⁻¹) * b
  let c := b * (a : G) * b⁻¹ * (a : G)⁻¹
  have hcQ : c ∈ Q := hcomm (by
    rw [commutator_comm A B]
    exact commutator_mem_commutator hb a.property)
  have hv : (a : G) * u * (a : G)⁻¹ ∈ componentOrbit U A := by
    exact (le_iSup (fun a : A => U.map (MulAut.conj (a : G)).toMonoidHom) a)
      (mem_map_of_mem (MulAut.conj (a : G)).toMonoidHom hu)
  have hcv := (hQ hcQ) _ hv
  have hbu := (hB hb) u hu
  have hbla : b * (a : G) = c * (a : G) * b := by dsimp [c]; group
  have hblinv : b * (a : G)⁻¹ = (a : G)⁻¹ * c⁻¹ * b := by dsimp [c]; group
  calc
    b * ((a : G) * u * (a : G)⁻¹) = (b * (a : G)) * u * (a : G)⁻¹ := by group
    _ = c * (a : G) * (b * u) * (a : G)⁻¹ := by rw [hbla]; group
    _ = c * (a : G) * (u * b) * (a : G)⁻¹ := by rw [hbu.symm]
    _ = (c * (a : G) * u) * (b * (a : G)⁻¹) := by group
    _ = (c * (a : G) * u) * ((a : G)⁻¹ * c⁻¹ * b) := by rw [hblinv]
    _ = c * ((a : G) * u * (a : G)⁻¹) * c⁻¹ * b := by group
    _ = ((a : G) * u * (a : G)⁻¹) * b := by rw [hcv.symm]; group


end Theory.GroupTheory
