module

public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Commutators of a normal subgroup with generated actors

For normal N, [N,⟨Aᵢ⟩] is generated by the [N,Aᵢ]. Their join lies in N,
and each Aᵢ normalizes this join because its commutators with every element
of N already belong to the join. The commutator product identity then proves
the assertion by subgroup generation.

This supplies the passage from individual minimal offenders to J* in
Aschbacher–Smith, *The Classification of Quasithin Groups*, B.1.9,
printed p.71. Normality of N is essential; it is not required of the Aᵢ.
-/

@[expose] public section

namespace Subgroup
variable {G : Type*} [Group G]

theorem commutator_iSup_of_normal_left {ι : Sort*}
    (N : Subgroup G) [N.Normal] (A : ι → Subgroup G) :
    ⁅N, ⨆ i, A i⁆ = ⨆ i, ⁅N, A i⁆ := by
  let D := ⨆ i, ⁅N, A i⁆
  have hDN : D ≤ N := iSup_le fun i => commutator_le_left N (A i)
  have hAD : ∀ i, A i ≤ normalizer D := by
    intro i
    apply le_normalizer_iff_commutator_le_right.mpr
    calc
      ⁅A i, D⁆ ≤ ⁅A i, N⁆ := commutator_mono le_rfl hDN
      _ = ⁅N, A i⁆ := commutator_comm _ _
      _ ≤ D := le_iSup (fun i => ⁅N, A i⁆) i
  have hJD : (⨆ i, A i) ≤ normalizer D := iSup_le hAD
  apply le_antisymm
  · apply commutator_le.mpr
    intro n hn a ha
    induction ha using iSup_induction' with
    | hp i a ha =>
        exact (le_iSup (fun i => ⁅N, A i⁆) i) (commutator_mem_commutator hn ha)
    | h1 => simpa only [commutatorElement_one_right] using D.one_mem
    | hmul a b ha _ iha ihb =>
        rw [commutatorElement_mul_right_eq_mul_conj]
        simpa only [mul_assoc] using
          D.mul_mem iha ((mem_normalizer_iff.mp (hJD ha) _).mp ihb)
  · exact iSup_le fun i => commutator_mono le_rfl (le_iSup A i)

end Subgroup
