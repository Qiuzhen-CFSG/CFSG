module
public import Theory.GroupTheory.Commutator.NormalClosure
public import Theory.GroupTheory.Commutator.NormalizesSupplement
public import Theory.GroupTheory.Commutator.NilpotentSaturation

/-!
# Centrality from an abelian edge and a residual dichotomy

Let a normal subgroup V be normally generated by an abelian edge subgroup E,
and let the ambient group be generated by L and a subgroup normalizing E.
If [[V,P],L] lies in a normal subgroup Z of E, then [E,P]Z is normal in the
whole group. It contains [V,P], so normal generation makes [V,P] central in V.

In the other residual branch, V is covered by E and [V,P]. Nilpotent
commutator saturation puts V in E and again proves centrality. These two
arguments close MS93 (5.2)(ii) after its unique-chief-factor step. They do not
assume that V or its quotient by Z is elementary abelian.

Source: Meierfrankenfeld--Stellmacher (1993), (5.2), printed pp.914--915.
-/

@[expose] public section
namespace Subgroup
variable {G : Type*} [Group G]

theorem edge_commutator_central_of_residual_fixed
    (V P E Z L S : Subgroup G) [V.Normal] [P.Normal] [Z.Normal]
    (hV : V = normalClosure (E : Set G)) (hEV : E ≤ V) (hZE : Z ≤ E)
    (hSE : S ≤ normalizer (E : Set G)) (hPS : P ≤ S)
    (hgen : L ⊔ S = ⊤) (hE : E ≤ centralizer (E : Set G))
    (hfixed : ⁅⁅V,P⁆,L⁆ ≤ Z) :
    ⁅V,P⁆ ≤ centralizer (V : Set G) := by
  let D := ⁅E,P⁆ ⊔ Z
  have hDE : D ≤ E :=
    sup_le (le_normalizer_iff_commutator_le_left.mp (hPS.trans hSE)) hZE
  have hLD : L ≤ normalizer (D : Set G) :=
    le_normalizer_sup_of_commutator_le ⁅V,P⁆ L ⁅E,P⁆ Z
      (commutator_mono hEV le_rfl) hfixed
  have hSD : S ≤ normalizer (D : Set G) := by
    intro g hg
    change g ∈ normalizer (⁅E,P⁆ ⊔ Z : Subgroup G)
    rw [mem_normalizer_iff_map_conj_eq,Subgroup.map_sup,map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hSE hg),Normal.map_conj_eq P g,
      Normal.map_conj_eq Z g]
  have hDn : D.Normal := normalizer_eq_top_iff.mp
    (top_unique (hgen ▸ sup_le hLD hSD))
  let := hDn
  have hCD : ⁅V,P⁆ ≤ D := by
    rw [hV,commutator_comm]
    exact commutator_normalClosure_le_of_normal P E D
      (by rw [commutator_comm]; exact le_sup_left)
  have hCE : ⁅V,P⁆ ≤ centralizer (E : Set G) := (hCD.trans hDE).trans hE
  apply commutator_eq_bot_iff_le_centralizer.mp
  have hz := commutator_normalClosure_le_of_normal ⁅V,P⁆ E ⊥
    (commutator_eq_bot_iff_le_centralizer.mpr hCE).le
  rwa [←hV,le_bot_iff] at hz

theorem edge_commutator_central_of_residual_cover
    (V P E L : Subgroup G) (hVP : V ≤ P) (hEP : E ≤ P)
    (hP : Group.IsNilpotent P) (hPE : P ≤ normalizer (E : Set G))
    (hE : E ≤ centralizer (E : Set G))
    (hgen : V ≤ E ⊔ ⁅V,L⁆) (hcover : ⁅V,L⁆ ≤ E ⊔ ⁅V,P⁆) :
    ⁅V,P⁆ ≤ centralizer (V : Set G) := by
  have hVE : V ≤ E := le_of_le_sup_commutator_of_isNilpotent P V E P
    hP hVP hEP le_rfl hPE (hgen.trans (sup_le le_sup_left hcover))
  exact ((commutator_mono hVE le_rfl).trans
    (le_normalizer_iff_commutator_le_left.mp hPE)).trans
      (hE.trans (centralizer_le hVE))

end Subgroup
