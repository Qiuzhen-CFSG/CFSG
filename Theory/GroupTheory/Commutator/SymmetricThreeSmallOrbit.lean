module
public import Theory.GroupTheory.Commutator.SymmetricThreePlaneSplitting
public import Theory.GroupTheory.ConjugateSpanSylow
public import Theory.GroupTheory.AbelianConjugateSpan

/-!
# A small orbit under a normal symmetric-three action

Let a normal subgroup act on an abelian two-group with faithful image S₃.
If an invariant subgroup of order at most four generates the module under
the whole ambient group, the action has no nontrivial fixed points. Its
cubic residual has coprime action; the small subgroup must be its full
commutator, and normality propagates this to the whole module.

This gives the opposing orbit bound in Aschbacher--Smith 14.3.31,
printed p.1003, after taking the literal quotient by the marked point.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

private theorem small_orbit_coprime_fixed (Z R W : Subgroup G)
    [Z.Normal] [R.Normal] [IsMulCommutative Z]
    (hp : IsPGroup 2 Z) (hr : IsPPerfect 2 R)
    (hWZ : W ≤ Z) (hRW : R ≤ normalizer (W : Set G))
    (hW : Nat.card W ≤ 4) (hgen : conjugateSpanBy W ⊤ = Z)
    (hne : ⁅Z,R⁆ ≠ ⊥)
    (hcop : Nat.Coprime (Nat.card (Z.normalizerMonoidHom.comp
      (inclusion (show R ≤ normalizer (Z : Set G) from le_normalizer_of_normal))).range)
      (Nat.card Z)) : Z ⊓ centralizer (R : Set G) = ⊥ := by
  let D := ⁅W,R⁆
  have hDW : D ≤ W := le_normalizer_iff_commutator_le_left.mp hRW
  have hDne : D ≠ ⊥ := by
    intro hb
    apply hne
    rw [commutator_eq_bot_iff_le_centralizer,←hgen]
    apply le_centralizer_iff.mp
    exact le_centralizer_conjugateSpanBy_of_normalizes R W ⊤ le_normalizer_of_normal
      (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hb))
  have hDD : ⁅D,R⁆ = D :=
    commutator_isPPerfect_idempotent R W hr (hp.to_le hWZ) hRW
  have hDfour : Nat.card D = 4 := by
    have hdle := (Nat.card_le_card_of_injective (inclusion hDW) (inclusion_injective hDW)).trans hW
    have hdpos := Nat.card_pos (α := D)
    have hd1 : Nat.card D ≠ 1 := fun hh => hDne (D.eq_bot_of_card_eq hh)
    have hd2 : Nat.card D ≠ 2 := by
      intro hh
      have hn : R ≤ normalizer (D : Set G) :=
        by
          intro x hx
          rw [mem_normalizer_iff_map_conj_eq,map_commutator,
            mem_normalizer_iff_map_conj_eq.mp (hRW hx),
            mem_normalizer_iff_map_conj_eq.mp (R.le_normalizer hx)]
      have hc : R ≤ centralizer (D : Set G) := hn.trans (normalizer_le_centralizer_of_card_two D hh)
      exact hDne (hDD.symm.trans (commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hc)))
    obtain ⟨n,hn⟩ := (hp.to_le (hDW.trans hWZ)).exists_card_eq
    have hnle : n ≤ 2 := by
      have hh : 2^n ≤ 2^2 := by simpa [hn] using hdle
      exact (Nat.pow_le_pow_iff_right (by decide)).mp hh
    interval_cases n <;> simp_all
  have hWD : W = D := (eq_of_le_of_card_ge hDW (by omega)).symm
  have hZR : ⁅Z,R⁆ = Z := by
    rw [←hgen]
    exact commutator_conjugateSpanBy_eq_self W ⊤ R le_top le_normalizer_of_normal hWD.symm
  have hs := (commutator_centralizer_decomposition_of_coprime_image Z R
    le_normalizer_of_normal hcop).2
  rwa [hZR,inf_eq_right.mpr inf_le_left] at hs

/-- A normal symmetric-three action on an abelian two-group generated by
conjugates of an invariant subgroup of order at most four has no fixed point. -/
theorem fixed_eq_bot_of_symmetricThree_small_orbit
    (Z K W : Subgroup G) [Z.Normal] [K.Normal] [IsMulCommutative Z]
    (hZ : IsPGroup 2 Z) (hWZ : W ≤ Z)
    (hKW : K ≤ normalizer (W : Set G)) (hW : Nat.card W ≤ 4)
    (hgen : conjugateSpanBy W ⊤ = Z)
    (model : Nonempty ((K ⧸ (centralizer (Z : Set G)).comap K.subtype) ≃*
      Equiv.Perm (Fin 3))) : Z ⊓ centralizer (K : Set G) = ⊥ := by
  let ρ : G →* MulAut Z := MulAut.conjNormal
  let f := ρ.comp K.subtype
  let R := (pResidual 2 K).map K.subtype
  let s := Z.normalizerMonoidHom.comp
    (inclusion (show R ≤ normalizer (Z : Set G) from le_normalizer_of_normal))
  have hk : f.ker = (centralizer (Z : Set G)).comap K.subtype := by
    ext k
    constructor
    · intro hk z hz
      have hh := congrArg (fun a : MulAut Z => (a ⟨z,hz⟩ : G)) hk
      change (k:G) * z * (k:G)⁻¹ = z at hh
      exact (mul_inv_eq_iff_eq_mul.mp hh).symm
    · intro hk
      apply MulEquiv.ext
      intro z
      apply Subtype.ext
      change (k:G) * (z:G) * (k:G)⁻¹ = (z:G)
      have hh : (k:G) * (z:G) = (z:G) * (k:G) := (hk z z.property).symm
      rw [hh,mul_inv_cancel_right]
  obtain ⟨e₀⟩ := model
  let e : f.range ≃* Equiv.Perm (Fin 3) :=
    (QuotientGroup.quotientKerEquivRange f).symm.trans
      ((QuotientGroup.quotientMulEquivOfEq hk).trans e₀)
  have hs : s.range = (pResidual 2 f.range).map f.range.subtype := by
    have hsρ : s = ρ.comp R.subtype := by
      ext a z
      rfl
    rw [hsρ,MonoidHom.range_comp,range_subtype]
    change ((pResidual 2 K).map K.subtype).map ρ = _
    rw [map_map]
    change (pResidual 2 K).map (f.range.subtype.comp f.rangeRestrict) = _
    rw [←map_map,map_pResidual_of_surjective 2 f.rangeRestrict f.rangeRestrict_surjective]
  have hc : Nat.card s.range = 3 := by
    rw [hs,card_map_of_injective f.range.subtype_injective]
    have hh := congrArg (fun A : Subgroup (Equiv.Perm (Fin 3)) => Nat.card A) (map_pResidual 2 e)
    rw [card_map_of_injective e.injective] at hh
    exact hh.trans Theory.SpecificGroups.SymmetricThree.CubicSelection.residual_card
  have hfixed : Z ⊓ centralizer (R : Set G) = ⊥ := by
    apply small_orbit_coprime_fixed Z R W hZ (isPPerfect_embedded_pResidual 2 K)
      hWZ ((map_subtype_le _).trans hKW) hW hgen
    · intro hbot
      have hcentral := commutator_eq_bot_iff_le_centralizer.mp hbot
      have htriv : s = 1 := by
        ext a z
        change (a : G) * (z : G) * (a : G)⁻¹ = (z : G)
        rw [hcentral z.property a a.property,mul_inv_cancel_right]
      have hcard : Nat.card s.range = 1 := by rw [htriv]; simp
      omega
    · change Nat.Coprime (Nat.card s.range) (Nat.card Z)
      obtain ⟨n,hn⟩ := hZ.exists_card_eq
      rw [hc,hn]
      exact (by decide : Nat.Coprime 3 2).pow_right n
  exact bot_unique ((inf_le_inf_left Z (centralizer_le (map_subtype_le _))).trans hfixed.le)
end Subgroup
