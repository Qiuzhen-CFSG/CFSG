module
public import Theory.GroupTheory.CommutatorPreimage
public import Mathlib.Algebra.Group.Subgroup.MulOpposite

/-!
# Quadratic conjugate generators determine the full fixed subgroup

Let an abelian group U be generated by its K-commutators. If K lies in
the join of A and a K-conjugate of A and A acts quadratically on U, then
C_U(A)=[U,A]. Indeed U is the join of the two conjugate displacement
subgroups. A fixed element decomposes across them; its second factor is
fixed by both actors and hence by K, so conjugating back places it in
the first displacement subgroup as well. No central kernel is removed.

This supplies the full-cover step of Aschbacher–Smith C.5.6, printed p.156.
-/

public section
open Subgroup
open scoped Pointwise IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G]

private theorem map_centralizer (U : Subgroup G) (e : G ≃* G) :
    (centralizer (U : Set G)).map e.toMonoidHom = centralizer (U.map e.toMonoidHom : Set G) := by
  apply le_antisymm
  · exact map_centralizer_le_centralizer_image _ _
  · intro g hg
    refine ⟨e.symm g, ?_, e.apply_symm_apply g⟩
    intro u hu
    apply e.injective
    simpa only [map_mul, e.apply_symm_apply] using hg (e u) (mem_map_of_mem _ hu)

/-- Two K-conjugate quadratic actors generating K force equality between
the fixed subgroup and the displacement subgroup on a K-generated module. -/
theorem commutator_eq_fixed_of_quadratic_conjugate_pair
    (U K A : Subgroup G) [IsMulCommutative U]
    (hKU : K ≤ normalizer (U : Set G)) (hAU : A ≤ normalizer (U : Set G))
    (hUK : ⁅U, K⁆ = U) (hquad : ⁅U, A⁆ ≤ centralizer (A : Set G))
    (y : G) (hy : y ∈ K)
    (hgen : K ≤ A ⊔ A.map (MulAut.conj y).toMonoidHom) :
    ⁅U, A⁆ = U ⊓ centralizer (A : Set G) := by
  let e := MulAut.conj y
  let B := A.map e.toMonoidHom
  let E := ⁅U, A⁆
  let E' := E.map e.toMonoidHom
  let W := E ⊔ E'
  let J := A ⊔ B
  have hUm : U.map e.toMonoidHom = U := mem_normalizer_iff_map_conj_eq.mp (hKU hy)
  have hEU : E ≤ U := le_normalizer_iff_commutator_le_left.mp hAU
  have hE'U : E' ≤ U := (map_mono hEU).trans_eq hUm
  have hWU : W ≤ U := sup_le hEU hE'U
  have hE' : ⁅U, B⁆ = E' := by
    change ⁅U, A.map e.toMonoidHom⁆ = (⁅U, A⁆ : Subgroup G).map e.toMonoidHom
    rw [map_commutator, hUm]
  have hAW : A ≤ normalizer (W : Set G) :=
    le_normalizer_iff_commutator_le_left.mpr
      ((commutator_mono hWU le_rfl).trans le_sup_left)
  have hBW : B ≤ normalizer (W : Set G) :=
    le_normalizer_iff_commutator_le_left.mpr
      ((commutator_mono hWU le_rfl).trans (hE'.le.trans le_sup_right))
  have hJW : J ≤ normalizer (W : Set G) := sup_le hAW hBW
  have hpre : J ≤ commutatorPreimage J U W := by
    apply sup_le
    · apply le_commutatorPreimage le_sup_left
      rw [commutator_comm]
      exact le_sup_left
    · apply le_commutatorPreimage le_sup_right
      rw [commutator_comm, hE']
      exact le_sup_right
  have hUW : U ≤ W := by
    rw [← hUK, commutator_comm]
    exact (commutator_mono (hgen.trans hpre) le_rfl).trans
      (commutator_commutatorPreimage_le J U W hJW)
  have hE'fixed : E' ≤ centralizer (B : Set G) := by
    rw [← map_centralizer]
    exact map_mono hquad
  apply le_antisymm (le_inf hEU hquad)
  rintro u ⟨hu, huf⟩
  have hm : u ∈ (E : Set G) * (E' : Set G) := by
    rw [← coe_mul_of_left_le_normalizer_right E E'
      ((hEU.trans (le_centralizer U)).trans
        ((centralizer_le hE'U).trans (centralizer_le_normalizer _)))]
    exact hUW hu
  obtain ⟨a, ha, b, hb, hab⟩ := hm
  have hbf : b ∈ centralizer (A : Set G) := by
    have hh := (centralizer (A : Set G)).mul_mem
      ((centralizer (A : Set G)).inv_mem (hquad ha)) huf
    simpa only [← hab, inv_mul_cancel_left] using hh
  have hbK : b ∈ centralizer (K : Set G) := by
    have hJ : J ≤ centralizer ({b} : Set G) := by
      apply sup_le
      · intro a ha
        exact mem_centralizer_singleton_iff.mpr (hbf a ha)
      · intro a ha
        exact mem_centralizer_singleton_iff.mpr (hE'fixed hb a ha)
    intro k hk
    exact (mem_centralizer_singleton_iff.mp (hJ (hgen hk)))
  have heb : e b = b := by
    change y * b * y⁻¹ = b
    rw [mem_centralizer_iff.mp hbK y hy, mul_inv_cancel_right]
  obtain ⟨b₀, hb₀, heq⟩ := hb
  have hbe : b ∈ E := (e.injective (heq.trans heb.symm)) ▸ hb₀
  rw [← hab]
  exact mul_mem ha hbe
end Subgroup
end
