module
public import Theory.GroupTheory.PResidual.PrimeSection
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Commutators over a prime image

A two-perfect subgroup with a prime image is either generated by its
commutators with a normalizing actor, or normalizes that actor, provided
the two-group action kernel lies in the actor. The commutator image has
order one or the full prime order; two-perfectness removes the kernel
in the latter case.

Source application: Aschbacher--Smith 14.2.14, printed p.984.
-/

public section
open Subgroup
namespace Subgroup
variable {G F : Type*} [Group G] [Group F] [Finite F]

theorem eq_commutator_or_normalizes_of_prime_image
    (Y R : Subgroup G) (f : G →* F) (hY : IsPPerfect 2 Y)
    (hn : R ≤ normalizer (Y : Set G))
    (hk : IsPGroup 2 (Y ⊓ f.ker : Subgroup G))
    (hker : Y ⊓ f.ker ≤ R) (hp : (Nat.card (Y.map f)).Prime) :
    Y = ⁅Y,R⁆ ∨ Y ≤ normalizer (R : Set G) := by
  let C := ⁅Y,R⁆
  have hCY : C ≤ Y := le_normalizer_iff_commutator_le_left.mp hn
  have hc : Nat.card (C.map f) ∣ Nat.card (Y.map f) := card_dvd_of_le (map_mono hCY)
  rcases (Nat.dvd_prime hp).mp hc with hc | hc
  · apply Or.inr
    have hz : C.map f = ⊥ := card_eq_one.mp hc
    have hCker : C ≤ f.ker := (map_eq_bot_iff C).mp hz
    exact le_normalizer_iff_commutator_le_right.mpr ((le_inf hCY hCker).trans hker)
  · apply Or.inl
    have hm : C.map f = Y.map f := eq_of_le_of_card_ge (map_mono hCY) hc.symm.le
    have hcover : Y ≤ C ⊔ f.ker := by
      have hh := (le_comap_map f Y).trans (comap_mono (f := f) hm.symm.le)
      simpa only [comap_map_eq] using hh
    let N := C.subgroupOf Y
    let Q := f.ker.subgroupOf Y
    let : N.Normal := (normal_subgroupOf_iff_le_normalizer hCY).mpr
      (normalizer_commutator_ge_left Y R)
    have hgen : N ⊔ Q = ⊤ := by
      apply top_unique
      intro y _
      obtain ⟨c,hc,q,hq,he⟩ := mem_sup_of_normal_right.mp (hcover y.property)
      have hqy : q ∈ Y := by
        have hqe : q = c⁻¹*(y:G) := by rw [←he]; group
        rw [hqe]
        exact Y.mul_mem (Y.inv_mem (hCY hc)) y.property
      have he' : (⟨c,hCY hc⟩ : Y)*⟨q,hqy⟩=y := Subtype.ext he
      rw [←he']
      exact mul_mem (mem_sup_left hc) (mem_sup_right hq)
    have hQ : IsPGroup 2 Q := by
      have he : Q = (Y ⊓ f.ker).subgroupOf Y := by ext x; exact (and_iff_right x.property).symm
      rw [he]
      exact hk.comap_subtype
    have hNtop : N = ⊤ := hY N inferInstance (isPGroup_quotient_of_sup_eq_top N Q hQ hgen)
    apply le_antisymm ?_ hCY
    intro y hy
    exact show (⟨y,hy⟩ : Y) ∈ N from hNtop.symm ▸ mem_top _
end Subgroup
