module
public import Theory.GroupTheory.Commutator.RelativeGeneration

/-!
# Generation by intersections under a fully moved action

Suppose A is generated by X, W and N, and Y = [Y,A]. If Y and each
of X,W normalize one another, their pairwise commutators lie in the
corresponding intersections. When [Y,N] lies in the join of those
intersections, this join is A-invariant and contains [Y,A]. It therefore
is all of Y. All normality is relative; no ambient normality is required.

The source application uses the actual two neighboring Suzuki spans
in the six-path argument of Delgado--Goldschmidt--Stellmacher,
Groups and Graphs (1985), (12.8), printed p.185.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

/-- Two intersections generate a fully moved subgroup when the remaining generator acts into them. -/
theorem sup_intersections_eq_of_generated_movement
    (A Y X W N : Subgroup G)
    (hgen : (X ⊔ W) ⊔ N = A) (hfull : Y = ⁅Y,A⁆)
    (hXY : X ≤ normalizer (Y : Set G)) (hYX : Y ≤ normalizer (X : Set G))
    (hWY : W ≤ normalizer (Y : Set G)) (hYW : Y ≤ normalizer (W : Set G))
    (hN : ⁅Y,N⁆ ≤ (X ⊓ Y) ⊔ (W ⊓ Y)) :
    (X ⊓ Y) ⊔ (W ⊓ Y) = Y := by
  let H := (X ⊓ Y) ⊔ (W ⊓ Y)
  have hHY : H ≤ Y := sup_le inf_le_right inf_le_right
  have hX : ⁅Y,X⁆ ≤ H := (le_inf
    (by rw [commutator_comm]; exact le_normalizer_iff_commutator_le_left.mp hYX)
    (le_normalizer_iff_commutator_le_left.mp hXY)).trans le_sup_left
  have hW : ⁅Y,W⁆ ≤ H := (le_inf
    (by rw [commutator_comm]; exact le_normalizer_iff_commutator_le_left.mp hYW)
    (le_normalizer_iff_commutator_le_left.mp hWY)).trans le_sup_right
  have hnorm : A ≤ normalizer (H : Set G) := by
    rw [←hgen]
    exact sup_le (sup_le
      (le_normalizer_iff_commutator_le_left.mpr ((commutator_mono hHY le_rfl).trans hX))
      (le_normalizer_iff_commutator_le_left.mpr ((commutator_mono hHY le_rfl).trans hW)))
      (le_normalizer_iff_commutator_le_left.mpr ((commutator_mono hHY le_rfl).trans hN))
  apply le_antisymm hHY
  rw [hfull,commutator_comm,←hgen]
  exact commutator_sup_le_of_relative_normal A (X ⊔ W) N Y H hnorm
    (le_sup_left.trans hgen.le) (le_sup_right.trans hgen.le)
    (commutator_sup_le_of_relative_normal A X W Y H hnorm
      ((le_sup_left.trans le_sup_left).trans hgen.le)
      ((le_sup_right.trans le_sup_left).trans hgen.le)
      (by rwa [commutator_comm]) (by rwa [commutator_comm]))
    (by rwa [commutator_comm])
end Subgroup
