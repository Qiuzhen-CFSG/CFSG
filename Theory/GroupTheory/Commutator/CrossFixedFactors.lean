module
public import Theory.ThreeSubgroups
public import Theory.GroupTheory.CommutatorPreimage

/-!
# Cross commutators controlled by the opposite full-action factor

Suppose Q1, Q2, and A normalize W, [Q1,Q2] lies in V, [V,A] lies in W,
and A centralizes Q1. If Q2 is generated by [Q2,A] and Z, with [Z,Q1]≤W,
then [Q1,Q2]≤W. These are ambient subgroup conditions; no finiteness or
global normality of Q1, Q2, or W is required.

The relative three-subgroups lemma gives [[Q2,A],Q1]≤W from the two
rotated bounds. Both [Q2,A] and Z then lie in the subgroup of Q2 whose
commutators with Q1 lie in W. The supplied generation identifies its
join with Q2, and the commutator-preimage theorem gives the conclusion.
The explicit Q2-normalization of W is used when closing this join.

Source: Stellmacher (10.1), Journal of Algebra190 (1997), printed p.64,
the paragraph between (18) and (19). The actual fixed-factor consumer
applies this in both directions and intersects the two resulting bounds.
-/

namespace Subgroup

public theorem commutator_le_of_opposite_full_factor
    {G : Type*} [Group G] (Q1 Q2 A Z V W : Subgroup G)
    (hQ1N : Q1≤normalizer (W:Set G)) (hQ2N : Q2≤normalizer (W:Set G))
    (hAN : A≤normalizer (W:Set G))
    (hcross : ⁅Q1,Q2⁆≤V) (hVA : ⁅V,A⁆≤W)
    (hcentral : ⁅A,Q1⁆=⊥) (hgen : Q2=⁅Q2,A⁆⊔Z) (hZcomm : ⁅Z,Q1⁆≤W) :
    ⁅Q1,Q2⁆≤W := by
  have htriple : ⁅⁅Q2,A⁆,Q1⁆≤W :=
    commutator_commutator_le_of_rotate_of_le_normalizer hQ2N hAN hQ1N
      (by simp only [hcentral,commutator_bot_left,bot_le])
      ((commutator_mono hcross le_rfl).trans hVA)
  have hfactor : ⁅Q2,A⁆≤commutatorPreimage Q2 Q1 W :=
    le_commutatorPreimage (le_sup_left.trans hgen.ge) htriple
  have hZ : Z≤commutatorPreimage Q2 Q1 W :=
    le_commutatorPreimage (le_sup_right.trans hgen.ge) hZcomm
  have hQ2 : Q2≤commutatorPreimage Q2 Q1 W := hgen.le.trans (sup_le hfactor hZ)
  rw [commutator_comm Q1 Q2]
  exact (commutator_mono hQ2 le_rfl).trans
    (commutator_commutatorPreimage_le Q2 Q1 W hQ2N)
end Subgroup
