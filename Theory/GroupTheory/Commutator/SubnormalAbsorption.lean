module
public import Mathlib.GroupTheory.IsSubnormal
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Subnormal subgroups absorb stable commutators

If a subgroup M is generated by commutators with a subnormal subgroup I,
then M lies in I. The proof inducts on the subnormal chain: first M lies
in the next larger subgroup K, and normality of I inside K places [M,I]
in I. No finiteness assumption is needed.

This general fact was previously proved inside the alternating-group
chapter as GLS3.Chapter5.le_of_isSubnormal_of_le_commutator. That public
name remains a compatibility wrapper. The shared result also supplies the
commutator transfer for Stellmacher (6.4), journal p32.
-/

namespace Subgroup
/-- If `M` is generated by its commutators with a subnormal subgroup `I`,
then `M` is contained in `I`. -/
public theorem le_of_isSubnormal_of_le_commutator
    {G : Type*} [Group G] (M I : Subgroup G)
    (hI : I.IsSubnormal) (hstable : M ≤ ⁅M, I⁆) :
    M ≤ I := by
  induction hI generalizing M with
  | top => exact le_top
  | step I K hIK hK hInormal ih =>
      have hstableK : M ≤ ⁅M, K⁆ :=
        hstable.trans (Subgroup.commutator_mono le_rfl hIK)
      have hMK : M ≤ K := ih M hstableK
      have hKnormalizer : K ≤ Subgroup.normalizer I := by
        rw [← Subgroup.normal_subgroupOf_iff_le_normalizer hIK]
        exact hInormal
      exact hstable.trans
        ((Subgroup.commutator_mono hMK le_rfl).trans
          (Subgroup.le_normalizer_iff_commutator_le_right.mp hKnormalizer))

end Subgroup
