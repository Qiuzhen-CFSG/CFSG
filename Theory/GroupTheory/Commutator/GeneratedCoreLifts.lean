module
public import Theory.GroupTheory.LocalNormalizerUniqueness
public import Theory.ThreeSubgroups
public import Theory.GroupTheory.Commutator.RelativeGeneration
public import Theory.Frattini.PGroup
public import Theory.GroupTheory.PPerfectHom

/-!
Generated finite two-cores lift central-quotient displacement through their
actual derived subgroup. Relative three-subgroups lowers trivial displacement;
Frattini saturation lifts full displacement when the actor preserves it.
A two-perfect actor fixing the derived subgroup then fixes the entire core.
These lemmas supply the weak-center form of Aschbacher--Smith15.3.23.
-/

public section
open Subgroup
open scoped commutatorElement
namespace Subgroup
variable {G : Type*} [Group G]

/-- A central quotient displacement drops to the derived subgroup when the
core is generated by its component commutators. -/
theorem commutator_le_derived_of_generated_core
    (Q L C Z : Subgroup G)
    (hQL : ⁅Q,L⁆ = Q)
    (hLQ : L ≤ normalizer (Q : Set G))
    (hCQ : C ≤ normalizer (Q : Set G))
    (hCL : ⁅C,L⁆ ≤ Q)
    (hZL : ⁅Z,L⁆ ≤ ⁅Q,Q⁆)
    (hCZ : ⁅C,Q⁆ ≤ Z) : ⁅C,Q⁆ ≤ ⁅Q,Q⁆ := by
  have hn : normalizer (Q : Set G) ≤ normalizer ((⁅Q,Q⁆ : Subgroup G) : Set G) := by
    rw [← Q.map_subtype_commutator]
    exact normalizer_le_normalizer_characteristic_image Q (_root_.commutator Q)
  have h := commutator_commutator_le_of_rotate_of_le_normalizer
    (Q.le_normalizer.trans hn) (hLQ.trans hn) (hCQ.trans hn)
    ((commutator_mono ((commutator_comm L C).le.trans hCL) le_rfl))
    ((commutator_mono hCZ le_rfl).trans hZL)
  rwa [hQL,commutator_comm Q C] at h

/-- In a generated finite two-core, surjectivity modulo a center whose
component commutator lies in the derived subgroup already gives equality. -/
theorem eq_of_sup_center_of_generated_core [Finite G]
    (Q L Z H : Subgroup G) (hQ : IsPGroup 2 Q)
    (hQL : ⁅Q,L⁆ = Q) (hZQ : Z ≤ Q)
    (hZL : ⁅Z,L⁆ ≤ ⁅Q,Q⁆) (hHQ : H ≤ Q)
    (hLH : L ≤ normalizer (H : Set G)) (hsup : H ⊔ Z = Q) : H = Q := by
  have hDQ : ⁅Q,Q⁆ ≤ Q := commutator_le_self Q
  have hHDQ : H ⊔ ⁅Q,Q⁆ ≤ Q := sup_le hHQ hDQ
  have hn : Q ≤ normalizer ((H ⊔ ⁅Q,Q⁆ : Subgroup G) : Set G) :=
    le_normalizer_iff_commutator_le_right.mpr
      ((commutator_mono le_rfl hHDQ).trans le_sup_right)
  have hfull : Q ≤ H ⊔ ⁅Q,Q⁆ := by
    conv_lhs => rw [← hQL,← hsup]
    exact commutator_sup_le_of_relative_normal Q H Z L (H ⊔ ⁅Q,Q⁆)
      hn hHQ hZQ
      ((le_normalizer_iff_commutator_le_left.mp hLH).trans le_sup_left)
      (hZL.trans le_sup_right)
  let _ : Fact (IsPGroup 2 Q) := ⟨hQ⟩
  have hD : ⁅Q,Q⁆ ≤ (frattini Q).map Q.subtype := by
    rw [← Q.map_subtype_commutator]
    exact map_mono (commutator_le_frattini_of_isPGroup (p := 2))
  have ht : H.subgroupOf Q ⊔ frattini Q = ⊤ := by
    apply map_injective Q.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hHQ,
      ← MonoidHom.range_eq_map,range_subtype]
    exact le_antisymm (sup_le hHQ (map_subtype_le _))
      (hfull.trans (sup_le_sup_left hD H))
  have hh := congrArg (map Q.subtype) (frattini_nongenerating ht)
  rwa [map_subgroupOf_eq_of_le hHQ,←MonoidHom.range_eq_map,range_subtype] at hh

/-- A two-perfect actor fixing the derived subgroup acts trivially once its
whole core displacement has landed there. -/
theorem centralizes_of_derived_displacement [Finite G]
    (Q C : Subgroup G) (hQ : IsPGroup 2 Q) (hC : IsPPerfect 2 C)
    (hfix : C ≤ centralizer ((⁅Q,Q⁆ : Subgroup G) : Set G))
    (hdisp : ⁅C,Q⁆ ≤ ⁅Q,Q⁆) : C ≤ centralizer (Q : Set G) := by
  have hD : IsPGroup 2 (⁅Q,Q⁆ : Subgroup G) := hQ.to_le (commutator_le_self Q)
  intro c hc q hq
  let f : C →* (⁅Q,Q⁆ : Subgroup G) := {
    toFun x := ⟨⁅(x : G),q⁆⁻¹,
      (⁅Q,Q⁆ : Subgroup G).inv_mem (hdisp (commutator_mem_commutator x.property hq))⟩
    map_one' := by apply Subtype.ext; simp
    map_mul' x y := by
      apply Subtype.ext
      change ⁅(x : G)*(y : G),q⁆⁻¹ = ⁅(x : G),q⁆⁻¹ * ⁅(y : G),q⁆⁻¹
      have hh := hfix x.property _ (hdisp (commutator_mem_commutator y.property hq))
      rw [commutatorElement_mul_left_eq_conj_mul,←hh,mul_inv_cancel_right,mul_inv_rev] }
  have hh := hC.hom_eq_one_of_isPGroup hD f
  have he := congrArg (fun f : C →* (⁅Q,Q⁆ : Subgroup G) => (f ⟨c,hc⟩ : G)) hh
  change ⁅c,q⁆⁻¹ = 1 at he
  exact (commutatorElement_eq_one_iff_mul_comm.mp (inv_eq_one.mp he)).symm
end Subgroup
