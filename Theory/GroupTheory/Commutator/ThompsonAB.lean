module

public import Theory.GroupTheory.Commutator.PTimesQ
public import Theory.GroupTheory.CentralPChiefCore

/-!
# Thompson's residual A × B centralizer lemma

Let A and B normalize a finite p-subgroup G, with B a p-group and [A,B] = 1.
If A = O^p(A), then centralizing C_G(B) forces A to centralize G. The residual
hypothesis is weaker than requiring A to have order prime to p.

Prime-to-p elements generate A. Apply the general P × Q theorem to the cyclic
subgroup generated by each such element, then extend centrality to A.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Lemma A.1.18(1), printed p.24 (citing Aschbacher, *Finite Group Theory*, 24.2).
-/

namespace Subgroup

/-- The residual form of Thompson's A × B lemma. Normalization is relative
to the target subgroup; no actor is assumed normal in the ambient group. -/
public theorem thompson_a_times_b_centralizer
    {H : Type*} [Group H] [Finite H] {p : ℕ} [Fact p.Prime]
    (A B G : Subgroup H) (hB : IsPGroup p B) (hG : IsPGroup p G)
    (hA : pResidual p A = ⊤)
    (hBG : B ≤ normalizer G) (hAG : A ≤ normalizer G)
    (hBA : ⁅B, A⁆ = ⊥)
    (hfix : G ⊓ centralizer (B : Set H) ≤ centralizer (A : Set H)) :
    ⁅G, A⁆ = ⊥ := by
  have hgen := closure_coprime_order_eq_top_of_pResidual_eq_top p hA
  have hcent : (⊤ : Subgroup A) ≤ (centralizer (G : Set H)).comap A.subtype := by
    rw [← hgen, closure_le]
    intro a ha
    change Nat.Coprime p (orderOf a) at ha
    have hQA : zpowers (a : H) ≤ A := zpowers_le.mpr a.property
    have hcop : Nat.Coprime p (Nat.card (zpowers (a : H))) := by
      simpa only [Nat.card_zpowers, Subgroup.orderOf_coe] using ha
    have hBQ : ⁅B, zpowers (a : H)⁆ = ⊥ := by
      apply bot_unique
      exact (commutator_mono le_rfl hQA).trans_eq hBA
    have hQ := p_times_q_centralizer B (zpowers (a : H)) G hB hG hcop
      hBG (hQA.trans hAG) hBQ (hfix.trans (centralizer_le hQA))
    have hc : zpowers (a : H) ≤ centralizer (G : Set H) := by
      apply commutator_eq_bot_iff_le_centralizer.mp
      rwa [commutator_comm]
    exact hc (mem_zpowers _)
  rw [commutator_comm]
  apply commutator_eq_bot_iff_le_centralizer.mpr
  intro a ha
  exact hcent (show (⟨a, ha⟩ : A) ∈ (⊤ : Subgroup A) from mem_top _)

end Subgroup
