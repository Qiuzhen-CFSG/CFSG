module
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# Recovering a moved subgroup from its central quotient

Suppose W is generated by its commutators with H. An H-invariant subgroup
U of W which surjects onto a quotient of W with H-central kernel equals W.
Each element of W differs from an element of U by a centralizing element,
so all the generating commutators already lie in U.

Source application: the final central-cover lift in Aschbacher--Smith
D.3.9, printed pp.199--201.
-/

public section
open scoped commutatorElement
namespace Subgroup
variable {G Q : Type*} [Group G] [Group Q]

/-- Exhausting a central quotient exhausts the original fully moved subgroup. -/
theorem eq_of_central_quotient_surjective
    (H W U : Subgroup G) (hUW : U ≤ W)
    (hHU : H ≤ normalizer (U : Set G)) (hW : ⁅W,H⁆ = W)
    (q : W →* Q) (hk : q.ker ≤ (centralizer (H : Set G)).subgroupOf W)
    (hs : Function.Surjective (q.comp (inclusion hUW))) : U = W := by
  apply le_antisymm hUW
  rw [← hW]
  apply commutator_le.mpr
  intro w hw h hh
  obtain ⟨u, hu⟩ := hs (q ⟨w,hw⟩)
  have hu' : q (inclusion hUW u) = q ⟨w,hw⟩ := hu
  have hker : (inclusion hUW u)⁻¹ * ⟨w,hw⟩ ∈ q.ker := by
    change q ((inclusion hUW u)⁻¹ * ⟨w,hw⟩) = 1
    rw [map_mul, map_inv, hu', inv_mul_cancel]
  have hc : (u : G)⁻¹ * w ∈ centralizer (H : Set G) := hk hker
  have he : ⁅(u : G)⁻¹ * w,h⁆ = 1 :=
    commutatorElement_eq_one_iff_mul_comm.mpr ((mem_centralizer_iff.mp hc h hh).symm)
  have hmem : ⁅(u : G),h⁆ ∈ U :=
    commutator_le.mp (le_normalizer_iff_commutator_le_left.mp hHU) u u.property h hh
  have heq : ⁅w,h⁆ = ⁅(u : G),h⁆ := by
    conv_lhs => rw [← mul_inv_cancel_left (u : G) w]
    rw [commutatorElement_mul_left_eq_conj_mul, he]
    simp
  exact heq ▸ hmem

end Subgroup
