module
public import Theory.GroupAction.SubgroupQuotientFullAction
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.GroupTheory.InvolutionCentralizerControl
/-!
# A commutator section generated by two conjugate lines

Let U be abelian and generated by its commutators with R. If U is the
join of B and an R-conjugate of B, and B has image of order two modulo
an R-invariant denominator N, then U has image of order four. The two
conjugate lines bound the image by four; an image of order two would
have trivial automorphism group and contradict commutator generation.

All normality is relative to U and the actual quotient action is used.
The source application in OriginalCoverPlane supplies the second plane
of Aschbacher--Smith 13.8.33, printed p.967.
-/

public section
open Subgroup
open scoped IsMulCommutative commutatorElement
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]
private theorem automorphism_of_card_two {X : Type*} [Group X]
    (hc : Nat.card X = 2) (a : MulAut X) (x : X) : a x = x := by
  obtain ⟨w,hw,he⟩ := (Nat.card_eq_two_iff' (1 : X)).mp hc
  by_cases hx : x = 1
  · rw [hx,map_one]
  · have hax : a x ≠ 1 := fun hh => hx ((map_eq_one_iff a a.injective).mp hh)
    exact (he (a x) hax).trans (he x hx).symm

/-- A full commutator quotient generated by two conjugate lines is a four-group. -/
theorem quotient_card_four_of_conjugate_lines (U B N R : Subgroup G)
    [IsMulCommutative U] (hRU : R ≤ normalizer (U : Set G))
    (hRN : R ≤ normalizer (N : Set G)) (hfull : ⁅U,R⁆ = U)
    (r : R) (hgen : U = B ⊔ B.map (MulAut.conj (r : G)).toMonoidHom)
    (hline : N.relIndex B = 2) : N.relIndex U = 4 := by
  let Q := U ⧸ N.subgroupOf U
  let q : U →* Q := QuotientGroup.mk' _
  let D := (B.subgroupOf U).map q
  have hBU : B ≤ U := hgen ▸ le_sup_left
  obtain ⟨σ,hσ,_,hfullQ⟩ := exists_quotient_conjugation_full_action R U N R ⊥ hRU hRN
    inferInstance le_rfl hfull (by simp)
  let D' := D.map (σ r).toMonoidHom
  have hd : Nat.card D = 2 := by
    rw [← relIndex_ker,QuotientGroup.ker_mk',relIndex_subgroupOf hBU]
    exact hline
  have hd' : Nat.card D' = 2 := by
    rw [card_map_of_injective (σ r).injective,hd]
  have hpair : D ⊔ D' = ⊤ := by
    apply top_unique
    intro x _
    obtain ⟨u,rfl⟩ := QuotientGroup.mk'_surjective (N.subgroupOf U) x
    have hmem : (u : G) ∈ B ⊔ B.map (MulAut.conj (r : G)).toMonoidHom := hgen ▸ u.property
    have hconj : B.map (MulAut.conj (r : G)).toMonoidHom ≤ U := hgen ▸ le_sup_right
    have hn : B.map (MulAut.conj (r : G)).toMonoidHom ≤ normalizer (B : Set G) := by
      apply (le_centralizer_iff.mpr ?_).trans (centralizer_le_normalizer _)
      intro b hb y hy
      exact setLike_mul_comm (hconj hy) (hBU hb)
    change (u : G) ∈ (↑(B ⊔ B.map (MulAut.conj (r : G)).toMonoidHom) : Set G) at hmem
    rw [coe_mul_of_right_le_normalizer_left B _ hn] at hmem
    obtain ⟨b,hb,c,hc,he⟩ := hmem
    obtain ⟨v,hv,rfl⟩ := hc
    have he' : u = ⟨b,hBU hb⟩ *
        ⟨(r : G) * v * (r : G)⁻¹,(mem_normalizer_iff.mp (hRU r.property) v).mp (hBU hv)⟩ :=
      Subtype.ext he.symm
    rw [he',map_mul]
    apply mul_mem_sup (mem_map_of_mem q hb)
    rw [← hσ r ⟨v,hBU hv⟩]
    exact mem_map_of_mem (σ r).toMonoidHom (mem_map_of_mem q hv)
  have hcount := card_mul_eq_card_inf_mul_card_sup_of_normalizes D D'
    (by rw [normalizer_eq_top]; exact le_top)
  rw [hd,hd',hpair,card_top] at hcount
  have hpos : 0 < Nat.card (D ⊓ D' : Subgroup Q) := Nat.card_pos
  have hbound : Nat.card Q ≤ 4 := by nlinarith
  have hdiv : 2 ∣ Nat.card Q := hd ▸ card_subgroup_dvd_card D
  have hposQ : 0 < Nat.card Q := Nat.card_pos
  have hQ : Nat.card Q = 2 ∨ Nat.card Q = 4 := by omega
  rcases hQ with hQ | hQ
  · have hz : commutatorAction ((R.subgroupOf R).map σ) Q = ⊥ := by
      apply eq_bot_iff.mpr
      rw [commutatorAction_eq_closure]
      apply (closure_le _).mpr
      rintro x ⟨g,v,rfl⟩
      change v⁻¹ * g.val v = 1
      rw [automorphism_of_card_two hQ,inv_mul_cancel]
    have he : (⊥ : Subgroup Q) = ⊤ := hz.symm.trans hfullQ
    have hc := congrArg (fun D : Subgroup Q => Nat.card D) he
    rw [card_bot,card_top,hQ] at hc
    omega
  · exact hQ
end Subgroup
