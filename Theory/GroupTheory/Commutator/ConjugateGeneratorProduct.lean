module
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Product containment from two conjugate generators

Let Z be normal, and let D lie in Y. If [D,A] lies in Z and D centralizes
A^x, where x belongs to the group generated by A and A^x, then D lies in
Y^(x⁻¹) Z. No finiteness or containment of D in that generated group is
required.

In the quotient by Z both generator subgroups centralize the image of D.
Thus x and x⁻¹ do too. Conjugating each member of D by x⁻¹ produces a member
of Y^(x⁻¹) with the same quotient image. The preimage-of-image formula gives
the asserted product with the normal kernel.

This is the elementary product-containment inference following source (5)
in Stellmacher (8.4)(7), Journal of Algebra190 (1997), printed p39.
The statement is intrinsic group theory, independent of the graph setting.
-/

namespace Subgroup

/-- Commutator control on two conjugate generators gives inverse-conjugate product containment. -/
public theorem le_conjBy_inv_sup_of_commutator_conjugate_generators
    {G : Type*} [Group G] (D Y A Z : Subgroup G) [Z.Normal]
    (x : G) (hDY : D ≤ Y) (hDA : ⁅D,A⁆ ≤ Z)
    (hDAx : ⁅D,A.conjBy x⁆ = ⊥) (hx : x ∈ A ⊔ A.conjBy x) :
    D ≤ Y.conjBy x⁻¹ ⊔ Z := by
  let q := QuotientGroup.mk' Z
  have hA : A.map q ≤ centralizer (D.map q : Set (G ⧸ Z)) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    rw [← map_commutator, commutator_comm]
    exact (map_eq_bot_iff _).mpr (by simpa only [q, QuotientGroup.ker_mk'] using hDA)
  have hAx : (A.conjBy x).map q ≤ centralizer (D.map q : Set (G ⧸ Z)) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    rw [← map_commutator, commutator_comm, hDAx, map_bot]
  have hgen : (A ⊔ A.conjBy x).map q ≤ centralizer (D.map q : Set (G ⧸ Z)) := by
    rw [map_sup]
    exact sup_le hA hAx
  have hxc := hgen (mem_map_of_mem q hx)
  have hmap : D.map q ≤ (Y.conjBy x⁻¹).map q := by
    rintro _ ⟨d, hd, rfl⟩
    refine mem_map.mpr ⟨x⁻¹ * d * x, ?_, ?_⟩
    · exact mem_map.mpr ⟨d, hDY hd, by simp⟩
    · have hcomm : q d * q x = q x * q d :=
        mem_centralizer_iff.mp hxc (q d) (mem_map_of_mem q hd)
      simp only [map_mul, map_inv]
      calc
        (q x)⁻¹ * q d * q x = (q x)⁻¹ * (q d * q x) := mul_assoc _ _ _
        _ = (q x)⁻¹ * (q x * q d) := by rw [hcomm]
        _ = q d := inv_mul_cancel_left _ _
  have hpre := map_le_iff_le_comap.mp hmap
  simpa only [comap_map_eq, q, QuotientGroup.ker_mk'] using hpre

end Subgroup
