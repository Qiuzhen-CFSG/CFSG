module
public import Theory.Representation.ResidualMovedGeneration
public import Theory.Representation.BinaryConjugationSection.CommutatorImage
public import Theory.Representation.BinaryConjugationSection.ConjugateSpan
public import Theory.Representation.FrattiniAction
public import Theory.GroupTheory.PResidual.FiniteImage
/-!
# Full elementary displacement survives on the residual

For an elementary abelian two-subgroup Y normalized by a finite actor A,
[Y,A] = Y implies [Y,O²(A)] = Y. We use the literal conjugation coordinates
and the binary residual-generation theorem: absence of dual fixed vectors
persists under restriction to a normal subgroup with two-group quotient.
The ambient group need not be finite.

Source application: DGS, Groups and Graphs (1985), (12.9), printed p.188,
the Suzuki action on its second kernel. The module argument is the same
as Aschbacher--Smith G.6.2(2), printed p.345.
-/
public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G]
/-- A finite elementary subgroup generated by full-actor commutators is
already generated by commutators with the actual embedded two-residual. -/
theorem elementary_commutator_pResidual_eq_self
    (A Y : Subgroup G) [Finite A] [Finite Y] [IsElementaryAbelian 2 Y]
    (hYA : Y ≤ A) (hn : A ≤ normalizer (Y : Set G)) (hfull : ⁅Y,A⁆ = Y) :
    ⁅Y,(pResidual 2 A).map A.subtype⁆ = Y := by
  let α := Y.normalizerMonoidHom.comp (inclusion hn)
  let ρ := FrattiniAction.ofAutomorphismHom α
  let c : BinaryConjugationSection A Y ⊥ ρ := {
    section_le := hYA
    kernel_le := bot_le
    normalized := hn
    coordinates := {
      toFun y := Multiplicative.ofAdd (Additive.ofMul y)
      map_one' := rfl
      map_mul' _ _ := rfl }
    onto := fun y => ⟨y.toAdd.toMul,rfl⟩
    kernel_eq := by
      ext y
      change y = 1 ↔ (y : G) = 1
      exact Subtype.ext_iff
    equivariant := fun _ _ => rfl }
  have hM : subspaceCommutator ρ ⊤ (⊤ : Subgroup A) = ⊤ := by
    have hh := c.imageSpace_commutator A Y le_rfl le_rfl
    rw [commutator_comm,hfull,c.imageSpace_self,subgroupOf_self] at hh
    exact hh.symm
  have hres := commutator_pResidual_eq_top ρ ⊤ hM
  have hsurj : Function.Surjective (⊤ : Subgroup A).subtype := fun a => ⟨⟨a,mem_top _⟩,rfl⟩
  rw [map_pResidual_of_surjective 2 _ hsurj] at hres
  let D := (pResidual 2 A).map A.subtype
  have hD : D.subgroupOf A = pResidual 2 A :=
    comap_map_eq_self_of_injective A.subtype_injective _
  have hspace : c.imageSpace ⁅D,Y⁆ = ⊤ := by
    rw [c.imageSpace_commutator D Y (map_subtype_le _) le_rfl,c.imageSpace_self,hD]
    exact hres
  have hle : Y ≤ ⁅D,Y⁆ := by
    intro y hy
    have hm : Additive.ofMul (⟨y,hy⟩ : Y) ∈ c.imageSpace ⁅D,Y⁆ := by
      rw [hspace]; trivial
    obtain ⟨z,hz,he⟩ := (c.mem_imageSpace_iff _ _).mp hm
    have he' : z = ⟨y,hy⟩ := Additive.ofMul.injective he
    change (z : G) ∈ ⁅D,Y⁆ at hz
    simpa only [he'] using hz
  exact le_antisymm
    (le_normalizer_iff_commutator_le_left.mp ((map_subtype_le _).trans hn))
    (by rwa [commutator_comm] at hle)
end Subgroup
