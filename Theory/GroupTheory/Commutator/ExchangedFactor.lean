module
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Generation by displacement of an exchanged factor

If V is generated by W and U, and an element of A sends W into U, then
V is generated by [A,W] and U. Write each w in W as the product of the
inverse commutator with the conjugated w. No disjointness, involution,
commutativity or ambient normality is required.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 10.2.12, printed p.754, the two factor-exchange generation steps.
-/

public section
open Subgroup
namespace Subgroup
open scoped commutatorElement
variable {G : Type*} [Group G]

/-- Exchanging one generating factor into the other makes its displacement
supplement the other factor. -/
theorem eq_commutator_sup_of_conjugate_factor_le
    (A V W U : Subgroup G) (hV : W ⊔ U = V)
    (hAV : A ≤ normalizer (V : Set G))
    {a : G} (ha : a ∈ A) (hs : W.map (MulAut.conj a).toMonoidHom ≤ U) :
    V = ⁅A,W⁆ ⊔ U := by
  apply le_antisymm
  · rw [←hV]
    apply sup_le ?_ le_sup_right
    intro w hw
    have hc : ⁅a,w⁆ ∈ ⁅A,W⁆ := commutator_mem_commutator ha hw
    have hu : (MulAut.conj a) w ∈ U := hs (mem_map_of_mem _ hw)
    have he : w = ⁅a,w⁆⁻¹ * (MulAut.conj a) w := by
      rw [conj_eq_commutatorElement_mul]
      simp only [inv_mul_cancel_left]
    rw [he]
    exact mul_mem_sup ((⁅A,W⁆).inv_mem hc) hu
  · have hWV : W ≤ V := hV ▸ le_sup_left
    have hUV : U ≤ V := hV ▸ le_sup_right
    exact sup_le ((commutator_mono le_rfl hWV).trans
      (le_normalizer_iff_commutator_le_right.mp hAV)) hUV

end Subgroup
