module

public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Centralizers of conjugate-generated subgroups

If `A` is abelian and `C ≤ A`, an element of `C` centralizes all the
`A`-conjugates of `L` exactly when it centralizes `L`. The proof transports
commutation through conjugation and then through the subgroup supremum.
This is the orbit argument in Step 3 of GLS vol. 2, Theorem 26.24.
Neither normality of `L` nor any component theorem is assumed.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

/-- An element commuting with the actors and with `L` commutes with the
subgroup generated by all actor conjugates of `L`. -/
theorem mem_centralizer_iSup_conjugates {A L : Subgroup G} {c : G}
    (hcA : c ∈ centralizer (A : Set G)) (hcL : c ∈ centralizer (L : Set G)) :
    c ∈ centralizer ((⨆ a : A, L.map (MulAut.conj (a : G)).toMonoidHom :
      Subgroup G) : Set G) := by
  have hle : (⨆ a : A, L.map (MulAut.conj (a : G)).toMonoidHom : Subgroup G) ≤
      centralizer ({c} : Set G) := by
    refine iSup_le fun a => ?_
    rintro _ ⟨l, hl, rfl⟩
    apply mem_centralizer_singleton_iff.mpr
    change ((a : G) * l * (a : G)⁻¹) * c = c * ((a : G) * l * (a : G)⁻¹)
    have ha := hcA (a : G) a.property
    have hai := hcA ((a : G)⁻¹) (A.inv_mem a.property)
    have hlc := hcL l hl
    calc
      ((a : G) * l * (a : G)⁻¹) * c = (a : G) * l * (c * (a : G)⁻¹) := by
        rw [mul_assoc, hai]
      _ = (a : G) * (l * c) * (a : G)⁻¹ := by simp only [mul_assoc]
      _ = c * ((a : G) * l * (a : G)⁻¹) := by rw [hlc, ← mul_assoc, ← mul_assoc, ha]; simp only [mul_assoc]
  intro x hx
  exact mem_centralizer_singleton_iff.mp (hle hx)

/-- Inside an abelian actor, centralizing one subgroup is equivalent to
centralizing the subgroup generated by its entire orbit. -/
theorem inf_centralizer_iSup_conjugates_of_abelian
    (A C L : Subgroup G) [IsMulCommutative A] (hCA : C ≤ A) :
    C ⊓ centralizer ((⨆ a : A, L.map (MulAut.conj (a : G)).toMonoidHom :
      Subgroup G) : Set G) = C ⊓ centralizer (L : Set G) := by
  have hL : L ≤ ⨆ a : A, L.map (MulAut.conj (a : G)).toMonoidHom := by
    intro l hl
    apply (le_iSup (fun a : A => L.map (MulAut.conj (a : G)).toMonoidHom) 1)
    exact ⟨l, hl, by simp⟩
  apply le_antisymm
  · exact inf_le_inf_left C (centralizer_le hL)
  · intro c hc
    exact ⟨hc.1, mem_centralizer_iSup_conjugates
      (A.le_centralizer (hCA hc.1)) hc.2⟩

end Subgroup
