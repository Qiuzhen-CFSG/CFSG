module

public import Theory.GroupTheory.Commutator.NormalizesSupplement
public import Mathlib.GroupTheory.IsPerfect
public import Mathlib.GroupTheory.Complement

/-!
# Solvable kernels in perfect split extensions

If a perfect group is a split extension of a solvable normal subgroup N by H,
then N = [N,H]. The subgroup H[N,H] is normal and its quotient is both solvable
and perfect, hence trivial. Complementarity then removes H.

This applies to the nonabelian quartic hexad radical in Aschbacher–Smith I.2.2(6),
printed p.412; elementary abelianity of the radical is unnecessary.
-/

namespace Subgroup

/-- Perfectness forces a solvable complemented kernel to be generated by
its commutators with the complement. -/
public theorem commutator_eq_left_of_perfect_complement {G : Type*} [Group G] [Group.IsPerfect G]
    (N H : Subgroup G) [N.Normal] [Group.IsSolvable N]
    (hc : N.IsComplement' H) : ⁅N, H⁆ = N := by
  let D := ⁅N, H⁆
  have hD : D ≤ N := commutator_le_left _ _
  have hnD : D.Normal := normalizer_eq_top_iff.mp (top_unique (by
    rw [← hc.sup_eq_top]
    exact sup_le (normalizer_commutator_ge_left N H) (normalizer_commutator_ge_right N H)))
  let V := H ⊔ D
  have hnV : V.Normal := normalizer_eq_top_iff.mp (top_unique (by
    rw [← hc.sup_eq_top]
    exact sup_le
      (le_normalizer_sup_of_commutator_le H N H D le_rfl (commutator_comm H N).le)
      (le_sup_left.trans V.le_normalizer)))
  let q := QuotientGroup.mk' V
  have hsur : Function.Surjective (q.comp N.subtype) := by
    intro y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective V y
    obtain ⟨⟨n, h⟩, rfl⟩ := hc.2 x
    refine ⟨n, ?_⟩
    change q n = q ((n : G) * h)
    have hqh : q (h : G) = 1 := (QuotientGroup.eq_one_iff (N := V) (h : G)).mpr
      ((show H ≤ V from le_sup_left) h.property)
    rw [map_mul, hqh, mul_one]
  let : Group.IsSolvable (G ⧸ V) := Group.isSolvable_of_surjective hsur
  have hsub : Subsingleton (G ⧸ V) := by
    by_contra h
    let : Nontrivial (G ⧸ V) := not_subsingleton_iff_nontrivial.mp h
    exact Group.IsPerfect.not_isSolvable (G ⧸ V) inferInstance
  apply le_antisymm hD
  intro n hn
  have hnV' : n ∈ V := (QuotientGroup.eq_one_iff n).mp (hsub.elim (q n) 1)
  obtain ⟨h, hh, d, hd, he⟩ := mem_sup_of_normal_right.mp hnV'
  have hhN : h ∈ N := by
    have hnd := N.mul_mem hn (N.inv_mem (hD hd))
    simpa only [← he, mul_inv_cancel_right] using hnd
  have hh1 : h = 1 := disjoint_def.mp hc.disjoint hhN hh
  have hd_eq : d = n := by simpa only [hh1, one_mul] using he
  exact hd_eq ▸ hd

end Subgroup
