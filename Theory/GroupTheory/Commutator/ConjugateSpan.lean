module

public import Theory.GroupTheory.ConjugateSpanOrder
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# A commutator-generated seed generates a commutator module

Let `U = ⟨A^H⟩`, where `K ≤ H` is normal in `H`. If `A = [A,L]` for
`L ≤ K`, then `U = [U,K]`. The latter commutator is normalized by `H`
and contains the seed, so contains its whole conjugate span.

This is the generation argument used in Aschbacher–Smith,
*The Classification of Quasithin Groups*, 13.8.20–21, printed pp.954–957
(combined manuscript, 1 March 2004). All normality is relative to `H`.
-/

public section

namespace Subgroup
variable {G : Type*} [Group G]

/-- A seed generated by its commutators with `L ≤ K` has its whole
`H`-conjugate span generated by commutators with the `H`-normal subgroup `K`. -/
theorem conjugateSpanBy_eq_commutator_of_seed
    (A H K L : Subgroup G) (hKH : K ≤ H)
    (hHK : H ≤ normalizer (K : Set G)) (hLK : L ≤ K)
    (hA : A = ⁅A, L⁆) :
    conjugateSpanBy A H = ⁅conjugateSpanBy A H, K⁆ := by
  let U := conjugateSpanBy A H
  have hHU : H ≤ normalizer (U : Set G) := le_normalizer_conjugateSpanBy A H
  have hHC : H ≤ normalizer (⁅U, K⁆ : Subgroup G) := by
    intro h hh
    rw [mem_normalizer_iff_map_conj_eq, map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hHU hh),
      mem_normalizer_iff_map_conj_eq.mp (hHK hh)]
  apply le_antisymm
  · apply conjugateSpanBy_le _ hHC
    calc
      A = ⁅A, L⁆ := hA
      _ ≤ ⁅U, K⁆ := commutator_mono (le_conjugateSpanBy A H) hLK
  · exact le_normalizer_iff_commutator_le_left.mp (hKH.trans hHU)

end Subgroup
