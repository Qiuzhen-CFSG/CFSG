module
public import Theory.GroupTheory.Commutator.TwoSubgroupNormalizer

/-!
# Removing a centralizing normal supplement from a full p-group action

Let Q and B be p-subgroups of a finite group G, with Q, E, and N normal.
Suppose E together with Q and B generates G. If Q is generated by its
commutators with G modulo N, while its commutators with E already lie in N,
then Q itself lies in N. No containment between Q and N is required.

In G/N the image of E centralizes the normal image of Q. Normality of E
writes every actor as e*s, with s in the join of the images of Q and B.
The image of E centralizes both q and [q,s], so [q,e*s]=[q,s]. Thus the
Q-image equals its commutator with this join. The join is a finite p-group
because the Q-image is normal. Pulling to the join's native subgroup and
applying the proved nilpotent full-commutator collapse makes the Q-image
trivial.

This standard finite p-group argument supplies the normal-supplement transfer
needed for the fixed-core splitting in Stellmacher (8.6)(c), specifically
C_Q(T)≤D in the high-cost branch. It has no campaign imports or hypotheses.
The nilpotence step reuses
`Subgroup.le_normal_of_quotient_isPGroup_of_eq_commutator`.
-/

namespace Subgroup
open scoped commutatorElement
universe u

public theorem le_normal_of_full_commutator_normal_supplement
    {G : Type u} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (Q B E N : Subgroup G) [Q.Normal] [E.Normal] [N.Normal]
    (hQ : IsPGroup p Q) (hB : IsPGroup p B)
    (hgen : E ⊔ (Q ⊔ B) = ⊤)
    (hfull : Q ≤ ⁅Q, (⊤ : Subgroup G)⁆ ⊔ N)
    (hcentral : ⁅Q,E⁆ ≤ N) : Q ≤ N := by
  classical
  let proj : G →* G ⧸ N := QuotientGroup.mk' N
  let Qbar := Q.map proj
  let Bbar := B.map proj
  let Ebar := E.map proj
  let S := Qbar ⊔ Bbar
  let _ : Qbar.Normal := (inferInstance : Q.Normal).map proj (QuotientGroup.mk'_surjective N)
  let _ : Ebar.Normal := (inferInstance : E.Normal).map proj (QuotientGroup.mk'_surjective N)
  have hgenbar : Ebar ⊔ S = ⊤ := by
    have hh := congrArg (Subgroup.map proj) hgen
    rw [Subgroup.map_sup,Subgroup.map_sup,
      Subgroup.map_top_of_surjective proj (QuotientGroup.mk'_surjective N)] at hh
    exact hh
  have hfullbar : Qbar ≤ ⁅Qbar,(⊤ : Subgroup (G ⧸ N))⁆ := by
    have hh := Subgroup.map_mono (f := proj) hfull
    rw [Subgroup.map_sup,Subgroup.map_commutator,
      Subgroup.map_top_of_surjective proj (QuotientGroup.mk'_surjective N),
      QuotientGroup.map_mk'_self, sup_bot_eq] at hh
    exact hh
  have hcommbar : ⁅Qbar,Ebar⁆ = ⊥ := by
    apply bot_unique
    have hh := Subgroup.map_mono (f := proj) hcentral
    rw [Subgroup.map_commutator,QuotientGroup.map_mk'_self] at hh
    exact hh
  have hEC : Ebar ≤ Subgroup.centralizer (Qbar : Set (G ⧸ N)) :=
    Subgroup.le_centralizer_iff.mp (Subgroup.commutator_eq_bot_iff_le_centralizer.mp hcommbar)
  have hcommS : ⁅Qbar,S⁆ = Qbar := by
    apply le_antisymm (Subgroup.commutator_le_left _ _)
    apply hfullbar.trans
    apply Subgroup.commutator_le.mpr
    intro q hq g _
    have hg : g ∈ Ebar ⊔ S := hgenbar ▸ Subgroup.mem_top g
    obtain ⟨e,he,s,hs,rfl⟩ := Subgroup.mem_sup_of_normal_left.mp hg
    have hqs : ⁅q,s⁆ ∈ ⁅Qbar,S⁆ := Subgroup.commutator_mem_commutator hq hs
    have hqsQ : ⁅q,s⁆ ∈ Qbar := Subgroup.commutator_le_left Qbar S hqs
    have heq : Commute q e := Subgroup.mem_centralizer_iff.mp (hEC he) q hq
    have hecomm : e * ⁅q,s⁆ * e⁻¹ = ⁅q,s⁆ := by
      exact mul_inv_eq_iff_eq_mul.mpr
        (Subgroup.mem_centralizer_iff.mp (hEC he) _ hqsQ).symm
    rw [commutatorElement_mul_right_eq_mul_conj,heq.commutator_eq,one_mul,hecomm]
    exact hqs
  have hSp : IsPGroup p S := (hQ.map proj).to_sup_of_normal_left (hB.map proj)
  let A := Qbar.subgroupOf S
  have hAS : A.map S.subtype = Qbar := Subgroup.map_subgroupOf_eq_of_le le_sup_left
  have hAtop : ⁅A,(⊤ : Subgroup S)⁆ = A := by
    apply Subgroup.map_injective S.subtype_injective
    rw [Subgroup.map_commutator,hAS,← MonoidHom.range_eq_map]
    rw [Subgroup.range_subtype,hcommS]
  have hquot : IsPGroup p (S ⧸ (⊥ : Subgroup S)) :=
    hSp.of_equiv QuotientGroup.quotientBot.symm
  have hAbot : A ≤ ⊥ := le_normal_of_quotient_isPGroup_of_eq_commutator
    A (⊤ : Subgroup S) ⊥ hquot hAtop
  have hQbot : Qbar = ⊥ := by
    rw [←hAS,show A=⊥ from le_bot_iff.mp hAbot,Subgroup.map_bot]
  have hle : Q ≤ proj.ker := (Subgroup.map_eq_bot_iff Q).mp hQbot
  simpa only [proj,QuotientGroup.ker_mk'] using hle

end Subgroup
