module
public import Theory.GroupTheory.Commutator.LinePermutation
public import Mathlib.Algebra.Group.Subgroup.Actions

/-!
# Ambient normalizers permute native commutator lines

Let a subgroup B be generated by V and coordinate subgroups Ti, and let
V be generated by Mi. Suppose the centralizer of V in B lies in V,
each [Mi,B] has order two, and [V,Ti] lies in [Mi,B]. Then every ambient
element normalizing B permutes the literal subgroups [Mi,B].

Restrict all subgroups to B and use its normalizer's conjugation
homomorphism into MulAut B. The intrinsic commutator-line permutation
theorem applies after transporting generation, the centralizer condition,
and cardinality through the injective subtype map. Mapping the conclusion
back gives the desired ambient conjugation images.

This wrapper connects the general automorphism theorem with the native
factor lines in Stellmacher (4.6), Journal of Algebra 190 (1997), p26.
Source: refs/latex/stellmacher-n-group.tex.
-/

namespace Subgroup

/-- Every ambient normalizer element permutes the supplied native order-two commutator lines. -/
public theorem normalizer_maps_commutator_line
    {G I : Type*} [Group G] [Finite G]
    (B V : Subgroup G) (M T : I → Subgroup G)
    (hVB : V ≤ B) (hMB : ∀ i, M i ≤ B) (hTB : ∀ i, T i ≤ B)
    (hV : V = ⨆ i, M i)
    (hcentral : B ⊓ centralizer (V : Set G) ≤ V)
    (hgen : B = V ⊔ ⨆ i, T i)
    (hline : ∀ i, Nat.card (⁅M i, B⁆ : Subgroup G) = 2)
    (hlocal : ∀ i, ⁅V, T i⁆ ≤ ⁅M i, B⁆) :
    ∀ g ∈ normalizer (B : Set G), ∀ i,
      ∃ j, (⁅M i, B⁆).map (MulAut.conj g).toMonoidHom = ⁅M j, B⁆ := by
  let VB := V.subgroupOf B
  let MB := fun i => (M i).subgroupOf B
  let TB := fun i => (T i).subgroupOf B
  have hVBmap : VB.map B.subtype = V := map_subgroupOf_eq_of_le hVB
  have hMBmap (i : I) : (MB i).map B.subtype = M i := map_subgroupOf_eq_of_le (hMB i)
  have hTBmap (i : I) : (TB i).map B.subtype = T i := map_subgroupOf_eq_of_le (hTB i)
  have hV' : VB = ⨆ i, MB i := by
    apply map_injective B.subtype_injective
    rw [hVBmap, map_iSup]
    simp only [hMBmap, hV]
  have hcentral' : centralizer (VB : Set B) ≤ VB := by
    intro b hb
    apply hcentral
    refine ⟨b.property, mem_centralizer_iff.mpr ?_⟩
    intro v hv
    exact congrArg Subtype.val (mem_centralizer_iff.mp hb ⟨v, hVB hv⟩ hv)
  have hgen' : VB ⊔ ⨆ i, TB i = ⊤ := by
    apply map_injective B.subtype_injective
    rw [map_sup, hVBmap, map_iSup, ← MonoidHom.range_eq_map, range_subtype]
    simpa only [hTBmap] using hgen.symm
  have hcommmap (i : I) : (⁅MB i, (⊤ : Subgroup B)⁆).map B.subtype = ⁅M i, B⁆ := by
    rw [map_commutator, hMBmap, ← MonoidHom.range_eq_map, range_subtype]
  have hline' (i : I) : Nat.card (⁅MB i, (⊤ : Subgroup B)⁆ : Subgroup B) = 2 := by
    have hc := hline i
    rw [← hcommmap i, card_map_of_injective B.subtype_injective] at hc
    exact hc
  have hlocal' (i : I) : ⁅VB, TB i⁆ ≤ ⁅MB i, (⊤ : Subgroup B)⁆ := by
    apply (map_le_map_iff_of_injective B.subtype_injective).mp
    rw [map_commutator, hVBmap, hTBmap, hcommmap]
    exact hlocal i
  intro g hg i
  let α : MulAut B := B.normalizerMonoidHom ⟨g, hg⟩
  obtain ⟨j, hj⟩ := automorphism_maps_commutator_line VB MB TB hV' hcentral' hgen' hline' hlocal' α i
  refine ⟨j, ?_⟩
  have hm := congrArg (fun W : Subgroup B => W.map B.subtype) hj
  rw [map_map, hcommmap] at hm
  rw [← hcommmap i, map_map]
  have hcomp : (MulAut.conj g).toMonoidHom.comp B.subtype = B.subtype.comp α.toMonoidHom := by
    ext b
    rfl
  rw [hcomp]
  exact hm

end Subgroup

