module

public import Theory.GroupTheory.CommutatorPreimage

/-!
# Displacement under a centralizing supplement

If B is generated by C and X, C centralizes V, and X normalizes V, then
[V,B] = [V,X]. The latter commutator is normalized by X and centralized
by C, so the subgroup of elements of B centralizing V modulo [V,X]
contains both generators of B.

This is the elementary commutator calculation used in Aschbacher–Smith,
E.6.11, printed p.250. It does not require a splitting or finiteness.
-/

namespace Subgroup

variable {G : Type*} [Group G] {V B C X : Subgroup G}

public theorem commutator_eq_of_centralizing_sup
    (hgen : C ⊔ X = B) (hC : C ≤ centralizer (V : Set G))
    (hX : X ≤ normalizer (V : Set G)) : ⁅V, X⁆ = ⁅V, B⁆ := by
  have hWV : ⁅V, X⁆ ≤ V := le_normalizer_iff_commutator_le_left.mp hX
  have hCW : C ≤ centralizer ((⁅V, X⁆ : Subgroup G) : Set G) :=
    hC.trans (centralizer_le hWV)
  have hBW : B ≤ normalizer ((⁅V, X⁆ : Subgroup G) : Set G) := by
    rw [← hgen]
    exact sup_le (hCW.trans (centralizer_le_normalizer _))
      (normalizer_commutator_ge_right V X)
  have hpre : B ≤ commutatorPreimage B V ⁅V, X⁆ := by
    rw [← hgen]
    refine sup_le (le_commutatorPreimage le_sup_left ?_)
      (le_commutatorPreimage le_sup_right ?_)
    · rw [commutator_eq_bot_iff_le_centralizer.mpr hC]
      exact bot_le
    · rw [commutator_comm]
  apply le_antisymm (commutator_mono le_rfl (hgen ▸ le_sup_right))
  rw [commutator_comm]
  exact (commutator_mono hpre le_rfl).trans
    (commutator_commutatorPreimage_le B V ⁅V, X⁆ hBW)

end Subgroup
