module
public import Theory.PGroupCore
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Automorphisms of a family of commutator lines

Suppose a finite group is generated by a self-centralizing subgroup `Q`
and coordinate subgroups `T i`, while `Q` is generated by subgroups `V i`.
If each `[V i, G]` has order two and `[Q, T i]` lies in that line, every
automorphism sends each of these lines to another line in the family.

For the image `A` of `V i`, a nontrivial commutator with some `V j` lies in
both order-two lines, forcing equality. If all these commutators vanish,
`A` centralizes `Q` and thus lies in `Q`. Generation then forces a nontrivial
commutator with some `T j`, giving the same equality. This abstracts the
automorphism argument in Stellmacher's pushing-up paper, proof of (4.6).
-/

namespace Subgroup

private theorem line_eq_of_nontrivial_subgroup
    {G : Type*} [Group G] [Finite G] (C R : Subgroup G)
    (hCR : C ≤ R) (hR : Nat.card R = 2) (hC : C ≠ ⊥) : C = R := by
  apply eq_of_le_of_card_ge hCR
  rw [hR]
  by_contra hn
  exact hC (eq_bot_of_card_le _ (by omega))

public theorem automorphism_maps_commutator_line
    {G I : Type*} [Group G] [Finite G]
    (Q : Subgroup G) (V T : I → Subgroup G)
    (hV : Q = ⨆ i, V i)
    (hCQ : centralizer (Q : Set G) ≤ Q)
    (hgen : Q ⊔ ⨆ i, T i = ⊤)
    (hline : ∀ i, Nat.card ↥(⁅V i, (⊤ : Subgroup G)⁆) = 2)
    (hlocal : ∀ i, ⁅Q, T i⁆ ≤ ⁅V i, (⊤ : Subgroup G)⁆)
    (α : MulAut G) (i : I) :
    ∃ j, (⁅V i, (⊤ : Subgroup G)⁆).map α.toMonoidHom = ⁅V j, (⊤ : Subgroup G)⁆ := by
  classical
  let A := (V i).map α.toMonoidHom
  let R := ⁅A, (⊤ : Subgroup G)⁆
  have hmap : (⁅V i, (⊤ : Subgroup G)⁆).map α.toMonoidHom = R := by
    rw [map_commutator, map_top_of_surjective α.toMonoidHom α.surjective]
  have hRcard : Nat.card R = 2 := by
    rw [← hmap, card_map_of_injective α.injective]
    exact hline i
  have hRne : R ≠ ⊥ := by
    intro hb
    have hc := card_eq_one.mpr hb
    omega
  have hsame (C : Subgroup G) (j : I) (hC : C ≠ ⊥)
      (hCR : C ≤ R) (hCj : C ≤ ⁅V j, (⊤ : Subgroup G)⁆) :
      R = ⁅V j, (⊤ : Subgroup G)⁆ :=
    (line_eq_of_nontrivial_subgroup C R hCR hRcard hC).symm.trans
      (line_eq_of_nontrivial_subgroup C _ hCj (hline j) hC)
  by_cases hv : ∃ j, ⁅A, V j⁆ ≠ ⊥
  · obtain ⟨j, hj⟩ := hv
    refine ⟨j, hmap.trans (hsame _ j hj (commutator_mono le_rfl le_top) ?_)⟩
    rw [commutator_comm A (V j)]
    exact commutator_mono le_rfl le_top
  have hVCA : ∀ j, V j ≤ centralizer (A : Set G) := by
    intro j
    apply le_centralizer_iff.mp
    apply commutator_eq_bot_iff_le_centralizer.mp
    by_contra hn
    exact hv ⟨j, hn⟩
  have hQCA : Q ≤ centralizer (A : Set G) := by
    rw [hV]
    exact iSup_le hVCA
  have hAQ : A ≤ Q := (le_centralizer_iff.mp hQCA).trans hCQ
  have hT : ∃ j, ⁅A, T j⁆ ≠ ⊥ := by
    by_contra ht
    have hTCA : (⨆ j, T j) ≤ centralizer (A : Set G) := by
      refine iSup_le fun j => ?_
      apply le_centralizer_iff.mp
      apply commutator_eq_bot_iff_le_centralizer.mp
      by_contra hn
      exact ht ⟨j, hn⟩
    have htop : (⊤ : Subgroup G) ≤ centralizer (A : Set G) := by
      rw [← hgen]
      exact sup_le hQCA hTCA
    exact hRne (commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp htop))
  obtain ⟨j, hj⟩ := hT
  refine ⟨j, hmap.trans (hsame _ j hj (commutator_mono le_rfl le_top) ?_)⟩
  exact (commutator_mono hAQ le_rfl).trans (hlocal j)

end Subgroup
