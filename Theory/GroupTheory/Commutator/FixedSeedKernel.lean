module
public import Theory.GroupTheory.CommutatorPreimage
public import Theory.GroupTheory.ConjugateSpanOrder

/-!
# Recovering a moved group from a fixed generating seed

Equal actor images modulo a kernel centralizing U have equal commutators
on every subgroup of U. If U is generated by conjugates of Z, the chosen
complement fixes Z, and a commuting factor fixes [U,B], then [U,B]=[Z,B].
Normality of the image of B suffices; B itself need not be normal.

The proof normalizes [Z,B] using the full inverse image of the actor, then
uses the centralizer modulo [Z,B] to propagate from Z to its conjugate span.
Source application: Aschbacher--Smith, completion of 12.3.1, printed p.812.
-/

public section
open Subgroup
open scoped commutatorElement IsMulCommutative
namespace Subgroup
variable {G Q : Type*} [Group G] [Group Q]

/-- Equal actor images modulo a kernel fixing U give equal commutators on every seed in U. -/
theorem commutator_eq_of_centralizing_kernel (U A B C : Subgroup G)
    (q : G →* Q) (hker : q.ker ≤ centralizer (U : Set G))
    (hAU : A ≤ U) (he : B.map q = C.map q) : ⁅A,B⁆ = ⁅A,C⁆ := by
  have hle (B C : Subgroup G) (h : B.map q ≤ C.map q) : ⁅A,B⁆ ≤ ⁅A,C⁆ := by
    apply commutator_le.mpr
    intro a ha b hb
    obtain ⟨c,hc,heq⟩ := h (mem_map_of_mem q hb)
    have hk : c⁻¹ * b ∈ q.ker := by
      change q (c⁻¹ * b) = 1
      rw [map_mul,map_inv,heq,inv_mul_cancel]
    have hfix := hker hk a (hAU ha)
    have helem : ⁅a,b⁆ = ⁅a,c⁆ := by
      have hh : b * a * b⁻¹ = c * a * c⁻¹ := by
        have hh' := congrArg (fun x : G => c * x * b⁻¹) hfix
        convert hh'.symm using 1 <;> group
      calc
        ⁅a,b⁆ = a * (b * a * b⁻¹)⁻¹ := by group
        _ = a * (c * a * c⁻¹)⁻¹ := by rw [hh]
        _ = ⁅a,c⁆ := by group
    rw [helem]
    exact commutator_mem_commutator ha hc
  exact le_antisymm (hle B C he.le) (hle C B he.ge)

/-- Crossed fixedness and a fixed generating seed recover the literal second seed commutator. -/
theorem conjugateSpan_commutator_eq_seed
    (Z U K B T : Subgroup G) [U.Normal]
    (q : G →* Q) (hker : q.ker ≤ centralizer (U : Set G)) [(B.map q).Normal]
    (hZU : Z ≤ U) (hspan : U = conjugateSpanBy Z ⊤)
    (hgen : K ⊔ B ⊔ T = ⊤) (hTZ : T ≤ centralizer (Z : Set G))
    (hKW : K ≤ centralizer (⁅U,B⁆ : Subgroup G)) : ⁅U,B⁆ = ⁅Z,B⁆ := by
  let W := ⁅Z,B⁆
  let N := (B.map q).comap q
  have he : B.map q = N.map q := by
    apply le_antisymm
    · exact map_mono (le_comap_map q B)
    · exact map_comap_le _ _
  have hZN : ⁅Z,N⁆ = W :=
    (commutator_eq_of_centralizing_kernel U Z B N q hker hZU he).symm
  have hTW : T ≤ normalizer (W : Set G) := by
    intro t ht
    rw [mem_normalizer_iff_map_conj_eq]
    change W.map (MulAut.conj t).toMonoidHom = W
    rw [←hZN,map_commutator]
    have hZ : Z.map (MulAut.conj t).toMonoidHom = Z :=
      mem_normalizer_iff_map_conj_eq.mp ((centralizer_le_normalizer _ :
        centralizer (Z : Set G) ≤ normalizer (Z : Set G)) (hTZ ht))
    have hN : N.map (MulAut.conj t).toMonoidHom = N :=
      mem_normalizer_iff_map_conj_eq.mp (show t ∈ normalizer (N : Set G) from
        (le_normalizer_of_normal : (⊤ : Subgroup G) ≤ normalizer (N : Set G)) (mem_top t))
    rw [hZ,hN]
  have hNW : (⊤ : Subgroup G) ≤ normalizer (W : Set G) := by
    rw [←hgen]
    exact sup_le (sup_le
      ((hKW.trans (centralizer_le (commutator_mono hZU le_rfl))).trans
        (centralizer_le_normalizer _)) (normalizer_commutator_ge_right Z B)) hTW
  have hpre : Z ≤ commutatorPreimage ⊤ N W :=
    le_commutatorPreimage le_top (by rw [hZN])
  have hUpre : U ≤ commutatorPreimage ⊤ N W := by
    rw [hspan]
    exact conjugateSpanBy_le hpre (commutatorPreimage_normalized ⊤ N W ⊤
      hNW le_normalizer_of_normal le_normalizer_of_normal hNW)
  have hUN : ⁅U,N⁆ ≤ W :=
    (commutator_mono hUpre le_rfl).trans (commutator_commutatorPreimage_le ⊤ N W hNW)
  exact le_antisymm ((commutator_mono le_rfl (le_comap_map q B)).trans hUN)
    (commutator_mono hZU le_rfl)
end Subgroup
