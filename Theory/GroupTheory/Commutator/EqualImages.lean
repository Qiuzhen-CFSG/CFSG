module

public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Centralizing and generating actions with the same image

Two subgroups with the same homomorphic image induce the same commutators
on every image subgroup. Thus a subgroup generated by its commutators with
one actor has trivial image if the other actor centralizes it.

This is the incompatible-diagonal-projections step in Aschbacher--Smith,
*The Classification of Quasithin Groups*, 15.3.39, printed pp.1137--1138.
-/

namespace Subgroup

variable {G D : Type*} [Group G] [Group D]

/-- Equal actor images cannot both centralize and generate a nontrivial image. -/
public theorem map_eq_bot_of_equal_actor_images (f : G →* D)
    (V A B : Subgroup G) (hA : A ≤ centralizer (V : Set G))
    (hAB : A.map f = B.map f) (hV : ⁅V, B⁆ = V) : V.map f = ⊥ := by
  have hc : ⁅V, A⁆ = ⊥ := by
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr hA
  calc
    V.map f = (⁅V, B⁆).map f := congrArg (map f) hV.symm
    _ = ⁅V.map f, B.map f⁆ := map_commutator _ _ _
    _ = ⁅V.map f, A.map f⁆ := by rw [hAB]
    _ = (⁅V, A⁆).map f := (map_commutator _ _ _).symm
    _ = ⊥ := by rw [hc, map_bot]

end Subgroup
