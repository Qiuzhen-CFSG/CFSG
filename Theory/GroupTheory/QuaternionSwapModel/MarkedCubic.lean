module
public import Theory.GroupTheory.QuaternionSwapModel
public import Theory.SpecificGroups.SL2.BinaryTetrahedral

/-!
# A diagonal cubic on the marked quaternion-swap geometry

The diagonal binary-tetrahedral cubic preserves the explicit elementary
sixteen and moves its marked plane generated by the central involution and
the diagonal quaternion generator. All calculations retain the quotient map.
This concerns the swap subgroup, without identifying it with a first
parabolic's two-core or with the whole Sylow subgroup.

Source: Aschbacher--Smith, Lemma 14.2.21, printed p.988 (PDF p.1005),
final marked-normalizer argument.
-/

@[expose] public section
namespace QuaternionSwapModel.MarkedCubic
open GLS3.Chapter5.SchurPresentation

abbrev BinaryTetrahedral := QuaternionGroup 2 ⋊[q8C3Action] Multiplicative (ZMod 3)
def quaternion : QuaternionGroup 2 →* BinaryTetrahedral := SemidirectProduct.inl
def cubic : BinaryTetrahedral := SemidirectProduct.inr (Multiplicative.ofAdd 1)

theorem cubic_quaternion (q : QuaternionGroup 2) :
    cubic * quaternion q * cubic⁻¹ = quaternion (q8Cycle q) := by
  have h : ∀ q : QuaternionGroup 2,
      cubic * quaternion q * cubic⁻¹ = quaternion (q8Cycle q) := by decide +kernel
  exact h q

def rawCycle : Raw →* Raw where
  toFun w := ⟨fun t => q8Cycle (w.left t), w.right⟩
  map_one' := by ext <;> simp
  map_mul' x y := by ext <;> simp

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
def cycle : QH →* QH := QuotientGroup.lift diagonalCenter (projection.comp rawCycle) (by
  rintro x (rfl | rfl)
  · exact map_one _
  · change projection (rawCycle killed) = projection 1
    rw [projection_eq_iff]
    decide +kernel)

@[simp] theorem cycle_projection (x : Raw) :
    cycle (projection x) = projection (rawCycle x) := rfl

theorem cycle_cube (x : QH) : cycle (cycle (cycle x)) = x := by
  obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective diagonalCenter x
  change projection (rawCycle (rawCycle (rawCycle w))) = projection w
  apply congrArg projection
  have h : ∀ w : Raw, rawCycle (rawCycle (rawCycle w)) = w := by decide +kernel
  exact h w

theorem cycle_injective : Function.Injective cycle := by
  intro x y h
  simpa only [cycle_cube] using congrArg (fun w => cycle (cycle w)) h

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem cycle_preserves_A : A.map cycle = A := by
  apply Subgroup.eq_of_le_of_card_ge
  · rintro x ⟨w, hw, rfl⟩
    obtain ⟨r, rfl⟩ := QuotientGroup.mk'_surjective diagonalCenter w
    change (rawWreathMap r).left 1 = (rawWreathMap r).left turn at hw
    change (rawWreathMap (rawCycle r)).left 1 =
      (rawWreathMap (rawCycle r)).left turn
    have h : ∀ r : Raw,
        (rawWreathMap r).left 1 = (rawWreathMap r).left turn →
        (rawWreathMap (rawCycle r)).left 1 = (rawWreathMap (rawCycle r)).left turn := by
      decide +kernel
    exact h r hw
  · exact (Subgroup.card_map_of_injective cycle_injective).ge

/-- The two coordinate directions of the marked natural four. -/
def planeCoordinates : Subgroup E16 where
  carrier := {v | v.toAdd 0 = 0 ∧ v.toAdd 3 = 0}
  one_mem' := by decide
  mul_mem' := by
    intro v w hv hw
    change v.toAdd 0 + w.toAdd 0 = 0 ∧ v.toAdd 3 + w.toAdd 3 = 0
    simp only [hv.1, hv.2, hw.1, hw.2, add_zero, and_self]
  inv_mem' := by
    intro v hv
    change -v.toAdd 0 = 0 ∧ -v.toAdd 3 = 0
    simp only [hv.1, hv.2, neg_zero, and_self]

instance (v : E16) : Decidable (v ∈ planeCoordinates) :=
  inferInstanceAs (Decidable (v.toAdd 0 = 0 ∧ v.toAdd 3 = 0))

def markedPlane : Subgroup QH := planeCoordinates.map sixteenEmbedding

theorem markedPlane_le_A : markedPlane ≤ A := by
  rw [← sixteenEmbedding_range]
  exact Subgroup.map_le_range _ _

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem markedPlane_eq_closure : markedPlane =
    Subgroup.closure ({z, projection (diagonalRaw (QuaternionGroup.xa 0))} : Set QH) := by
  apply le_antisymm
  · rintro x ⟨v, hv, rfl⟩
    have h : ∀ v : E16, v ∈ planeCoordinates →
        sixteenRaw v = 1 ∨ sixteenRaw v = leftRaw (QuaternionGroup.a 2) ∨
        sixteenRaw v = diagonalRaw (QuaternionGroup.xa 0) ∨
        sixteenRaw v = diagonalRaw (QuaternionGroup.xa 0) * leftRaw (QuaternionGroup.a 2) := by
      decide +kernel
    rcases h v hv with h | h | h | h
    · change projection (sixteenRaw v) ∈ _
      rw [h, map_one]
      exact Subgroup.one_mem _
    · change projection (sixteenRaw v) ∈ _
      rw [h]
      exact Subgroup.subset_closure (Set.mem_insert _ _)
    · change projection (sixteenRaw v) ∈ _
      rw [h]
      exact Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
    · change projection (sixteenRaw v) ∈ _
      rw [h, map_mul]
      exact Subgroup.mul_mem _ (Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl))
        (Subgroup.subset_closure (Set.mem_insert _ _))
  · apply (Subgroup.closure_le _).mpr
    rintro x (rfl | rfl)
    · exact ⟨basisBit 2, (show basisBit 2 ∈ planeCoordinates from by decide +kernel), sixteenEmbedding_basis_two⟩
    · refine ⟨basisBit 1, (show basisBit 1 ∈ planeCoordinates from by decide +kernel), ?_⟩
      apply congrArg projection
      decide +kernel

/-- The diagonal quaternion is the product of the two specified embeddings. -/
theorem diagonal_eq_product (q : QuaternionGroup 2) :
    projection (diagonalRaw q) = leftEmbedding q * rightEmbedding q := by
  change projection (diagonalRaw q) = projection (leftRaw q) * projection (rightRaw q)
  rw [← map_mul]
  apply congrArg projection
  have h : ∀ q : QuaternionGroup 2, diagonalRaw q = leftRaw q * rightRaw q := by
    decide +kernel
  exact h q

/-- The marked plane lies in the actual embedded quaternion product. -/
theorem markedPlane_le_QK : markedPlane ≤ QK := by
  rw [markedPlane_eq_closure]
  apply (Subgroup.closure_le _).mpr
  rintro x (rfl | rfl)
  · exact Z_le_QK ((mem_Z z).mpr (Or.inr rfl))
  · rw [diagonal_eq_product]
    exact QK.mul_mem
      ((show leftFactor ≤ QK from le_sup_left) ⟨_, rfl⟩)
      ((show rightFactor ≤ QK from le_sup_right) ⟨_, rfl⟩)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem cycle_moves_markedPlane : markedPlane.map cycle ≠ markedPlane := by
  intro he
  have hj : projection (diagonalRaw (QuaternionGroup.xa 0)) ∈ markedPlane := by
    rw [markedPlane_eq_closure]
    exact Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
  have h := Subgroup.mem_map_of_mem cycle hj
  rw [he] at h
  obtain ⟨v, hv, hvx⟩ := h
  change projection (sixteenRaw v) =
    projection (rawCycle (diagonalRaw (QuaternionGroup.xa 0))) at hvx
  rw [projection_eq_iff] at hvx
  have hn : ∀ v : E16, v ∈ planeCoordinates →
      ¬ ((sixteenRaw v)⁻¹ * rawCycle (diagonalRaw (QuaternionGroup.xa 0)) = 1 ∨
         (sixteenRaw v)⁻¹ * rawCycle (diagonalRaw (QuaternionGroup.xa 0)) = killed) := by
    decide +kernel
  exact hn v hv hvx

end QuaternionSwapModel.MarkedCubic
