module
public import Theory.GroupTheory.QuaternionSwapModel.MarkedSylow.Coordinates

/-!
# Marked generators in the whole-overlap coordinates

The four displayed binary generators span the elementary sixteen. Its
marked plane is generated by the central involution and paired quaternion
`j`. Both the swap subgroup and the extra twisted Sylow involution preserve
this plane. All equations descend through the literal central quotient.

Source: Aschbacher--Smith, proof of 14.2.21, printed p.988 (PDF p.1005).
-/

@[expose] public section
open QuaternionSwapModel
namespace QuaternionSwapModel.MarkedCubic

def bit (i : Fin 4) : QH := sixteenEmbedding (basisBit i)

theorem bit_mem_A (i : Fin 4) : bit i ∈ A := by
  rw [← sixteenEmbedding_range]
  exact ⟨basisBit i,rfl⟩

theorem bit_one : bit 1 = projection (diagonalRaw (QuaternionGroup.xa 0)) := by
  apply congrArg projection
  decide +kernel

theorem bit_two : bit 2 = z := sixteenEmbedding_basis_two

theorem A_eq_closure_bits : A = Subgroup.closure (Set.range bit) := by
  apply le_antisymm
  · intro x hx
    rw [← sixteenEmbedding_range] at hx
    obtain ⟨v,rfl⟩ := hx
    have hv : v = basisBit 0 ^ (v.toAdd 0).val * basisBit 1 ^ (v.toAdd 1).val *
        basisBit 2 ^ (v.toAdd 2).val * basisBit 3 ^ (v.toAdd 3).val := by
      have h : ∀ v : E16, v = basisBit 0 ^ (v.toAdd 0).val * basisBit 1 ^ (v.toAdd 1).val *
          basisBit 2 ^ (v.toAdd 2).val * basisBit 3 ^ (v.toAdd 3).val := by decide +kernel
      exact h v
    rw [hv]
    simp only [map_mul,map_pow]
    have hb (i : Fin 4) : bit i ∈ Subgroup.closure (Set.range bit) :=
      Subgroup.subset_closure ⟨i,rfl⟩
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _
        (Subgroup.mul_mem _
          (Subgroup.pow_mem _ (hb 0) _)
          (Subgroup.pow_mem _ (hb 1) _))
        (Subgroup.pow_mem _ (hb 2) _))
      (Subgroup.pow_mem _ (hb 3) _)
  · exact (Subgroup.closure_le _).mpr (by rintro _ ⟨i,rfl⟩; exact bit_mem_A i)

theorem markedPlane_eq_bits : markedPlane = Subgroup.closure ({bit 2,bit 1} : Set QH) := by
  rw [bit_one,bit_two]
  exact markedPlane_eq_closure

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem conjugate_plane (g : QH) : g ∈ Subgroup.normalizer (markedPlane : Set QH) := by
  apply Subgroup.mem_normalizer_fintype
  have hc : markedPlane ≤ markedPlane.comap (MulAut.conj g).toMonoidHom := by
    conv_lhs => rw [markedPlane_eq_closure]
    apply (Subgroup.closure_le _).mpr
    obtain ⟨w,rfl⟩ := QuotientGroup.mk'_surjective diagonalCenter g
    rintro x (rfl | rfl)
    · have h : ∀ w : Raw,
          (w * leftRaw (QuaternionGroup.a 2) * w⁻¹)⁻¹ * leftRaw (QuaternionGroup.a 2) = 1 ∨
          (w * leftRaw (QuaternionGroup.a 2) * w⁻¹)⁻¹ * leftRaw (QuaternionGroup.a 2) = killed := by
        decide +kernel
      change projection w * z * (projection w)⁻¹ ∈ markedPlane
      have hz : projection w * z * (projection w)⁻¹ = z := by
        change projection w * projection (leftRaw (QuaternionGroup.a 2)) * (projection w)⁻¹ = projection (leftRaw (QuaternionGroup.a 2))
        rw [← map_inv,← map_mul,← map_mul,projection_eq_iff]
        exact h w
      rw [hz,markedPlane_eq_closure]
      exact Subgroup.subset_closure (Set.mem_insert _ _)
    · have h : ∀ w : Raw, ∃ v : E16, v ∈ planeCoordinates ∧
          ((sixteenRaw v)⁻¹ * (w * diagonalRaw (QuaternionGroup.xa 0) * w⁻¹) = 1 ∨
          (sixteenRaw v)⁻¹ * (w * diagonalRaw (QuaternionGroup.xa 0) * w⁻¹) = killed) := by
        decide +kernel
      change projection w * projection (diagonalRaw (QuaternionGroup.xa 0)) *
        (projection w)⁻¹ ∈ markedPlane
      rw [← map_inv,← map_mul,← map_mul]
      obtain ⟨v,hv,he⟩ := h w
      exact ⟨v,hv,(projection_eq_iff _ _).mpr he⟩
  exact hc

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem twist_plane (v : E16) (hv : v ∈ planeCoordinates) :
    projection (MarkedSylow.twist (sixteenRaw v)) ∈ markedPlane := by
  have h : ∀ v : E16, v ∈ planeCoordinates → ∃ u : E16, u ∈ planeCoordinates ∧
      ((sixteenRaw u)⁻¹ * MarkedSylow.twist (sixteenRaw v) = 1 ∨
       (sixteenRaw u)⁻¹ * MarkedSylow.twist (sixteenRaw v) = killed) := by
    decide +kernel
  obtain ⟨u,hu,he⟩ := h v hv
  exact ⟨u,hu,(projection_eq_iff _ _).mpr he⟩
end QuaternionSwapModel.MarkedCubic
