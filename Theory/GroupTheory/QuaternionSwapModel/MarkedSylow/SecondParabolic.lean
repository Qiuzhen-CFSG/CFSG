module
public import Theory.GroupTheory.QuaternionSwapModel.MarkedSylow.Thompson
public import Theory.GroupTheory.QuaternionSwapModel.MarkedSylow.Marks

/-!
# The second parabolic and its conjugate-generated marked plane

The whole overlap has the normal forms in `Geometry`. A further generator
acts on the ordered generators `(diagonal i, diagonal j, z, swap)` as
`(diagonal i, diagonal j * z, diagonal j, diagonal j * swap)`. These four
structural equations imply normality of the actual Thompson sixteen in the
second parabolic. They also identify the subgroup generated by conjugates
of the marked center with the marked plane; that identification is not an
input. Containment in the overgroup accompanies relative normality.

Source: Aschbacher--Smith, final paragraph of the proof of 14.2.21,
printed p.988 (PDF p.1005). The compatible-pair owner must construct the
maps, normal forms, generator and displayed four equations in its model.
-/

@[expose] public section
namespace QuaternionSwapModel.MarkedSylow
open MarkedCubic
variable {G : Type*} [Group G] [Finite G] {f : QH →* G} {T : Subgroup G}
namespace Geometry
variable (d : Geometry f T)

include d in
theorem T_normalizes_A : T ≤ Subgroup.normalizer (A.map f : Set G) := by
  intro g hg
  have hn : g ∈ Subgroup.normalizer (T : Set G) := Subgroup.le_normalizer hg
  rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hn ⊢
  change T.map (MulAut.conj g).toMonoidHom = T at hn
  change (A.map f).map (MulAut.conj g).toMonoidHom = A.map f
  rw [← d.thompson_eq, ← Stellmacher.elementaryAbelianMaxJ_map_equiv, hn]

include d in
theorem T_normalizes_plane : T ≤ Subgroup.normalizer (markedPlane.map f : Set G) := by
  have ht : d.t ∈ Subgroup.normalizer (markedPlane.map f : Set G) := by
    apply Subgroup.mem_normalizer_fintype
    rintro _ ⟨_,⟨v,hv,rfl⟩,rfl⟩
    change d.t * f (projection (sixteenRaw v)) * d.t⁻¹ ∈ markedPlane.map f
    rw [d.conjugation]
    exact Subgroup.mem_map_of_mem f (twist_plane v hv)
  intro g hg
  obtain ⟨q,b,rfl⟩ := (d.cover g).mp hg
  have hq : f q ∈ Subgroup.normalizer (markedPlane.map f : Set G) :=
    Subgroup.le_normalizer_map f ⟨q,conjugate_plane q,rfl⟩
  cases b
  · simpa only [Bool.false_eq_true,↓reduceIte,mul_one] using hq
  · exact Subgroup.mul_mem _ hq ht

end Geometry

/-- A second parabolic generated by the whole overlap and one further
actor. Its four equations refer to fixed marked quaternion/swap generators.
Neither normality of the sixteen nor invariance of a Thompson subgroup is
an input. -/
structure SecondGeometry (f : QH →* G) (T YT : Subgroup G) extends Geometry f T where
  y : G
  span : YT = T ⊔ Subgroup.zpowers y
  action_zero : y * f (bit 0) * y⁻¹ = f (bit 0)
  action_one : y * f (bit 1) * y⁻¹ = f (bit 1 * bit 2)
  action_two : y * f (bit 2) * y⁻¹ = f (bit 1)
  action_three : y * f (bit 3) * y⁻¹ = f (bit 1 * bit 3)

namespace SecondGeometry
variable {YT : Subgroup G} (d : SecondGeometry f T YT)

include d in
theorem YT_normalizes_A : YT ≤ Subgroup.normalizer (A.map f : Set G) := by
  rw [d.span]
  apply sup_le d.toGeometry.T_normalizes_A
  apply Subgroup.zpowers_le.mpr
  apply Subgroup.mem_normalizer_fintype
  have h : A.map f ≤ (A.map f).comap (MulAut.conj d.y).toMonoidHom := by
    conv_lhs => rw [A_eq_closure_bits,MonoidHom.map_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨_,⟨i,rfl⟩,rfl⟩
    change d.y * f (bit i) * d.y⁻¹ ∈ A.map f
    fin_cases i
    · change d.y * f (bit 0) * d.y⁻¹ ∈ A.map f
      rw [d.action_zero]; exact Subgroup.mem_map_of_mem f (bit_mem_A 0)
    · change d.y * f (bit 1) * d.y⁻¹ ∈ A.map f
      rw [d.action_one]; exact Subgroup.mem_map_of_mem f (A.mul_mem (bit_mem_A 1) (bit_mem_A 2))
    · change d.y * f (bit 2) * d.y⁻¹ ∈ A.map f
      rw [d.action_two]; exact Subgroup.mem_map_of_mem f (bit_mem_A 1)
    · change d.y * f (bit 3) * d.y⁻¹ ∈ A.map f
      rw [d.action_three]; exact Subgroup.mem_map_of_mem f (A.mul_mem (bit_mem_A 1) (bit_mem_A 3))
  exact h

include d in
theorem A_normal : ((A.map f).subgroupOf YT).Normal := by
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer
    (d.toGeometry.A_le.trans (d.span ▸ le_sup_left))).mpr
  exact d.YT_normalizes_A

include d in
theorem YT_normalizes_plane : YT ≤ Subgroup.normalizer (markedPlane.map f : Set G) := by
  rw [d.span]
  apply sup_le d.toGeometry.T_normalizes_plane
  apply Subgroup.zpowers_le.mpr
  apply Subgroup.mem_normalizer_fintype
  have h : markedPlane.map f ≤
      (markedPlane.map f).comap (MulAut.conj d.y).toMonoidHom := by
    conv_lhs => rw [markedPlane_eq_bits,MonoidHom.map_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨_,(rfl | rfl),rfl⟩
    · change d.y * f (bit 2) * d.y⁻¹ ∈
        markedPlane.map f
      rw [d.action_two,markedPlane_eq_bits]
      exact Subgroup.mem_map_of_mem f (Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl))
    · change d.y * f (bit 1) * d.y⁻¹ ∈
        markedPlane.map f
      rw [d.action_one,markedPlane_eq_bits]
      exact Subgroup.mem_map_of_mem f (Subgroup.mul_mem _
        (Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl))
        (Subgroup.subset_closure (Set.mem_insert _ _)))
  exact h

include d in
theorem conjugateClosure_eq_plane :
    Subgroup.closure {w : G | ∃ a ∈ YT, ∃ x ∈ Z.map f, a*x*a⁻¹ = w} =
      markedPlane.map f := by
  have hzplane : Z ≤ markedPlane := by
    intro x hx
    rcases (mem_Z x).mp hx with rfl | rfl
    · exact markedPlane.one_mem
    · rw [markedPlane_eq_closure]
      exact Subgroup.subset_closure (Set.mem_insert _ _)
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨a,ha,x,hx,rfl⟩
    exact (Subgroup.mem_normalizer_iff.mp (d.YT_normalizes_plane ha) x).mp
      (Subgroup.map_mono hzplane hx)
  · rw [markedPlane_eq_bits,MonoidHom.map_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨_,(rfl | rfl),rfl⟩
    · apply Subgroup.subset_closure
      refine ⟨1,YT.one_mem,f (bit 2),?_,by simp⟩
      rw [bit_two]
      exact Subgroup.mem_map_of_mem f ((mem_Z z).mpr (Or.inr rfl))
    · apply Subgroup.subset_closure
      refine ⟨d.y,?_,f (bit 2),?_,d.action_two⟩
      · exact d.span.ge ((show Subgroup.zpowers d.y ≤ T ⊔ Subgroup.zpowers d.y from le_sup_right) (Subgroup.mem_zpowers _))
      · rw [bit_two]
        exact Subgroup.mem_map_of_mem f ((mem_Z z).mpr (Or.inr rfl))

end SecondGeometry
end QuaternionSwapModel.MarkedSylow
