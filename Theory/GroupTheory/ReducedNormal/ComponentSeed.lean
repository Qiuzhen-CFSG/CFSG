module
public import Theory.GroupTheory.GeneralizedFitting.QuasisimpleKernel
public import Theory.GroupTheory.ReducedNormal.Basic
public import Theory.ElementaryAbelian.AbelianNormalClosure

/-!
# Reduced closure of a seed moved by a quasisimple component

Suppose a finite group is generated by a normal C-component and a two-group.
An elementary seed in a normal elementary subgroup, centralized by the
two-core and moved by that component, has reduced normal closure. The
centralizer of the closure contains the two-core and does not contain the
component. The normal-kernel theorem for a quasisimple two-group extension
therefore makes the literal centralizer quotient two-core-free.

Source: the reduction to R₂(J) in Aschbacher--Smith 13.3.14(g), printed p.893.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

/-- A moved seed centralized by the core generates a reduced normal module
in a quasisimple-by-two extension. -/
theorem reduced_normalClosure_of_component_seed
    (K S E U : Subgroup G) [K.Normal] [E.Normal] [IsElementaryAbelian 2 E]
    (hK : K.IsCComponent) [IsQuasisimple (K ⧸ pCore 2 K)]
    (hS : IsPGroup 2 S) (hgen : K ⊔ S = ⊤) (hUE : U ≤ E)
    (hc : pCore 2 G ≤ centralizer (U : Set G)) (hm : ⁅U,K⁆ ≠ ⊥) :
    IsPReduced 2 (normalClosure (U : Set G)) := by
  let W := normalClosure (U : Set G)
  let C := centralizer (W : Set G)
  have hWE : W ≤ E := normalClosure_le_normal hUE
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.of_le hWE
  have hQC : pCore 2 G ≤ C := le_centralizer_iff.mp
    (normalClosure_le_normal (le_centralizer_iff.mp hc))
  have hKC : ¬ K ≤ C := by
    intro h
    apply hm
    exact commutator_eq_bot_iff_le_centralizer.mpr
      (le_centralizer_iff.mp (h.trans (centralizer_le le_normalClosure)))
  exact ⟨inferInstance, inferInstance,
    (QuasisimpleKernel.normal_kernel_structure K S C hK hS hgen hQC hKC).2⟩

/-- The original seed itself therefore lies in R₂ of the given group. -/
theorem seed_le_reduced_of_component_supplement
    (K S E U : Subgroup G) [K.Normal] [E.Normal] [IsElementaryAbelian 2 E]
    (hK : K.IsCComponent) [IsQuasisimple (K ⧸ pCore 2 K)]
    (hS : IsPGroup 2 S) (hgen : K ⊔ S = ⊤) (hUE : U ≤ E)
    (hc : pCore 2 G ≤ centralizer (U : Set G)) (hm : ⁅U,K⁆ ≠ ⊥) :
    U ≤ reducedTwoSubgroup G :=
  le_normalClosure.trans
    (reduced_normalClosure_of_component_seed K S E U hK hS hgen hUE hc hm).le_reducedPSubgroup

end Theory.GroupTheory
