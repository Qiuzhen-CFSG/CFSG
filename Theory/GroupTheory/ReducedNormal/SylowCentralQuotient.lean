module

public import Theory.GroupTheory.ReducedNormal.SylowCenterClosure
public import Theory.GroupTheory.CentralizerModulo.ConjugateSpan

/-!
# Reduced normal spans modulo Sylow displacement

Let the normal closure of a subgroup be elementary abelian. If a Sylow
p-subgroup centralizes the seed modulo a normal denominator, the image
of the whole normal closure in that quotient is p-reduced. The original
denominator and quotient map are retained; centrality of the denominator
is not required.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

/-- An elementary normal span generated by a Sylow-central seed modulo E
is reduced in the literal quotient by E. -/
theorem isPReduced_normalClosure_quotient_of_sylow_displacement
    (P : Sylow p G) (E V : Subgroup G) [E.Normal]
    [IsElementaryAbelian p (normalClosure (V : Set G))]
    (hdisp : ⁅V,(P : Subgroup G)⁆ ≤ E) :
    IsPReduced p ((normalClosure (V : Set G)).map (QuotientGroup.mk' E)) := by
  let q := QuotientGroup.mk' E
  let S := P.mapSurjective (QuotientGroup.mk'_surjective E)
  have hVH : V ≤ normalClosure (V : Set G) := le_normalClosure
  let : IsElementaryAbelian p V := IsElementaryAbelian.of_le hVH
  let : IsElementaryAbelian p (V.map q) := IsElementaryAbelian.map q
  have hVP : V ≤ (P : Subgroup G) := hVH.trans
    ((IsElementaryAbelian.isPGroup p (normalClosure (V : Set G))).le_sylow_of_normal P)
  have hVS : V.map q ≤ (S : Subgroup (G ⧸ E)) := map_mono hVP
  have hcomm : ⁅V.map q,(S : Subgroup (G ⧸ E))⁆ = ⊥ := by
    change ⁅V.map q,(P : Subgroup G).map q⁆ = ⊥
    rw [←map_commutator,Subgroup.map_eq_bot_iff,QuotientGroup.ker_mk']
    exact hdisp
  have hspan : (normalClosure (V : Set G)).map q =
      normalClosure (V.map q : Set (G ⧸ E)) :=
    map_normalClosure _ q (QuotientGroup.mk'_surjective E)
  let : IsElementaryAbelian p ((normalClosure (V : Set G)).map q) :=
    IsElementaryAbelian.map q
  let : IsMulCommutative (normalClosure (V.map q : Set (G ⧸ E))) :=
    hspan ▸ inferInstance
  rw [hspan]
  exact isPReduced_normalClosure_of_sylow_central S (V.map q) hVS
    (commutator_eq_bot_iff_le_centralizer.mp hcomm)

end Theory.GroupTheory
