module

public import Theory.PGroupCore
public import Theory.ElementaryAbelian.Basic

/-!
# Reduced normal elementary abelian subgroups

A normal elementary abelian p-subgroup V is p-reduced when the literal
conjugation quotient G/C_G(V) has trivial p-core. The subgroup R_p(G) is
the join of all such V. In particular this defines the source R₂(G) without
identifying it with a rank-two subgroup or assuming its maximality.

Each member lies in O_p(G). The image of O_p(G) in its conjugation quotient
is a normal p-subgroup, hence trivial; thus every member centralizes O_p(G).
The same containments hold for their join. Closure of the family under joins,
and therefore reducedness of R_p(G) itself, is a separate theorem.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Definition B.2.11 and the observation preceding B.2.12, printed pp.77–78.
-/

@[expose] public section
namespace Theory.GroupTheory
open Subgroup

variable {G : Type*} [Group G]

/-- The source family R_p(G), with its actual centralizer quotient. -/
structure IsPReduced (p : ℕ) (V : Subgroup G) : Prop where
  normal : V.Normal
  elementary : IsElementaryAbelian p V
  quotient_pCore_eq_bot :
    letI := normal
    pCore p (G ⧸ centralizer (V : Set G)) = ⊥

/-- The subgroup R_p(G) generated by all p-reduced normal elementary
abelian p-subgroups. -/
def reducedPSubgroup (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  sSup {V : Subgroup G | IsPReduced p V}

/-- The literal subgroup R₂(G) of Aschbacher–Smith B.2.12. -/
abbrev reducedTwoSubgroup (G : Type*) [Group G] : Subgroup G :=
  reducedPSubgroup 2 G

variable {p : ℕ} {V : Subgroup G}

theorem IsPReduced.le_reducedPSubgroup (h : IsPReduced p V) :
    V ≤ reducedPSubgroup p G := le_sSup h

/-- A reduced normal elementary subgroup lies in the p-core. -/
theorem IsPReduced.le_pCore (h : IsPReduced p V) : V ≤ pCore p G := by
  let := h.elementary
  exact le_sSup ⟨h.normal, IsElementaryAbelian.isPGroup p V⟩

/-- A reduced subgroup centralizes the ambient p-core. -/
theorem IsPReduced.le_centralizer_pCore (h : IsPReduced p V) :
    V ≤ centralizer (pCore p G : Set G) := by
  let := h.normal
  let C := centralizer (V : Set G)
  let q := QuotientGroup.mk' C
  have him : (pCore p G).map q ≤ pCore p (G ⧸ C) :=
    le_sSup ⟨Normal.map inferInstance q (QuotientGroup.mk'_surjective C),
      pCore_isPGroup.map q⟩
  have hc : pCore p G ≤ C := by
    intro x hx
    have hh := him (mem_map_of_mem q hx)
    rw [h.quotient_pCore_eq_bot] at hh
    exact (QuotientGroup.eq_one_iff x).mp (mem_bot.mp hh)
  exact le_centralizer_iff.mp hc

/-- The join R_p(G) lies in the p-core. -/
theorem reducedPSubgroup_le_pCore (p : ℕ) (G : Type*) [Group G] :
    reducedPSubgroup p G ≤ pCore p G :=
  sSup_le fun _ h => h.le_pCore

/-- The join R_p(G) centralizes the p-core. -/
theorem reducedPSubgroup_le_centralizer_pCore (p : ℕ) (G : Type*) [Group G] :
    reducedPSubgroup p G ≤ centralizer (pCore p G : Set G) :=
  sSup_le fun _ h => h.le_centralizer_pCore

/-- A normal subgroup's p-core centralizes R_p(G). This is the immediate
containment in the centralizer equality of A.1.19. -/
theorem normal_pCore_le_centralizer_reducedPSubgroup
    (p : ℕ) (K : Subgroup G) [K.Normal] :
    (pCore p K).map K.subtype ≤ centralizer (reducedPSubgroup p G : Set G) := by
  have hK : (pCore p K).map K.subtype ≤ pCore p G :=
    le_sSup ⟨inferInstance, pCore_isPGroup.map K.subtype⟩
  exact hK.trans (le_centralizer_iff.mp (reducedPSubgroup_le_centralizer_pCore p G))

end Theory.GroupTheory
