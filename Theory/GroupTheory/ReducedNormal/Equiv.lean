module
public import Theory.GroupTheory.ReducedNormal.Defs
public import Theory.GroupTheory.GeneralizedFitting.StandardComponent

/-!
# Isomorphism invariance of reduced elementary subgroups

Transport the actual centralizer quotient along a group isomorphism.
The first application is the F.8 seed inside the subgroup generated by LT and H.
-/
@[expose] public section
open Subgroup
namespace Theory.GroupTheory
variable {G K : Type*} [Group G] [Group K] {p : ℕ} [Fact p.Prime] {V : Subgroup G}

theorem IsPReduced.map_equiv (h : IsPReduced p V) (e : G ≃* K) :
    IsPReduced p (V.map e.toMonoidHom) := by
  let := h.normal
  let := h.elementary
  let : (V.map e.toMonoidHom).Normal := h.normal.map _ e.surjective
  refine ⟨inferInstance, IsElementaryAbelian.map e.toMonoidHom, ?_⟩
  let q := QuotientGroup.congr (centralizer (V : Set G))
    (centralizer (V.map e.toMonoidHom : Set K)) e
    (by simpa only [coe_map, ← MulEquiv.toMonoidHom_eq_coe, MulEquiv.coe_toMonoidHom] using
      map_centralizer_equiv (V : Set G) e)
  rw [← pCore_map_iso p q, h.quotient_pCore_eq_bot, Subgroup.map_bot]
end Theory.GroupTheory
