module
public import Theory.GroupTheory.ReducedNormal.Defs
public import Theory.GroupTheory.AbelianConjugateSpan
public import Mathlib.GroupTheory.Sylow

/-!
# Reduced modules generated by a Sylow-central seed

A normal elementary abelian subgroup generated by conjugates of a seed
centralized by a Sylow p-subgroup is p-reduced. Lift the p-core of the
centralizer quotient: modulo the centralizer each lift lies in the Sylow
subgroup, so it fixes the seed. Normality then makes it fix the entire span.

Source: Aschbacher–Smith, B.2.13–14, printed pp.78–79; the relative seed
form is used in A.5.7(2b), printed p.62.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

/-- Sylow-central generation makes the literal centralizer quotient p-reduced. -/
theorem reduced_of_sylow_central_seed
    (T : Sylow p G) (M V W : Subgroup G) [IsElementaryAbelian p V]
    (hTM : (T : Subgroup G) ≤ M) (hVM : V ≤ M)
    (hMV : M ≤ normalizer (V : Set G))
    (hWV : W ≤ V) (hWT : W ≤ centralizer (T : Set G))
    (hspan : V = conjugateSpanBy W M) : IsPReduced p (V.subgroupOf M) := by
  let U := V.subgroupOf M
  let : U.Normal := normal_subgroupOf_of_le_normalizer hMV
  refine ⟨inferInstance, IsElementaryAbelian.subgroupOf hVM, ?_⟩
  let C := centralizer (U : Set M)
  let q := QuotientGroup.mk' C
  let Q := (pCore p (M ⧸ C)).comap q
  let S := T.subtype hTM
  have hQS : pCore p (M ⧸ C) ≤ (S : Subgroup M).map q :=
    pCore_isPGroup.le_sylow_of_normal (S.mapSurjective (QuotientGroup.mk'_surjective C))
  have hQW : Q.map M.subtype ≤ centralizer (W : Set G) := by
    rintro x ⟨a, ha, rfl⟩ z hz
    obtain ⟨s, hs, hsa⟩ := hQS ha
    have hasC : a / s ∈ C := by
      apply (QuotientGroup.eq_one_iff _).mp
      change q (a / s) = 1
      rw [map_div, hsa, div_self']
    have hzM : z ∈ M := hVM (hWV hz)
    have hzc : (⟨z,hzM⟩ : M) ∈ U := hWV hz
    have hsZ : (s : G) * z = z * s := hWT hz s hs
    have he : (a / s : M) * s = a := div_mul_cancel _ _
    have hd : (a / s : M) ∈ centralizer ({(⟨z,hzM⟩ : M)} : Set M) :=
      mem_centralizer_singleton_iff.mpr (hasC ⟨z,hzM⟩ hzc).symm
    have hsC : s ∈ centralizer ({(⟨z,hzM⟩ : M)} : Set M) :=
      mem_centralizer_singleton_iff.mpr (Subtype.ext hsZ)
    have hh := (centralizer ({(⟨z,hzM⟩ : M)} : Set M)).mul_mem hd hsC
    rw [he] at hh
    exact congrArg M.subtype (mem_centralizer_singleton_iff.mp hh).symm
  have hMQ : M ≤ normalizer (Q.map M.subtype : Set G) := by
    simpa only [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype] using
      Q.le_normalizer_map M.subtype
  have hQV := le_centralizer_conjugateSpanBy_of_normalizes _ _ _ hMQ hQW
  rw [← hspan] at hQV
  apply bot_unique
  intro x hx
  obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective C x
  apply (QuotientGroup.eq_one_iff a).mpr
  intro v hv
  exact Subtype.ext (hQV (mem_map_of_mem M.subtype hx) v hv)
end Theory.GroupTheory
