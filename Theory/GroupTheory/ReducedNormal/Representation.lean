module

public import Theory.GroupTheory.ReducedNormal.Basic
public import Theory.GroupTheory.PCoreLocalSetup
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.Representation.BinaryOffender.Homogeneous.Basic
public import Theory.Representation.ElementaryPerfectSplit
public import Theory.ElementaryAbelian.AbelianNormalClosure

/-!
# The conjugation representation on the reduced-two subgroup

R₂(H) is the actual largest reduced normal elementary abelian subgroup of H.
Its binary conjugation representation and the inclusion of its subspaces
into an ambient group retain both subgroup inclusions. Invariant subspaces
are normalized by their original actors, and orbit spans map to the actual
subgroups generated by conjugates. These constructions support the internal
modules of Aschbacher–Smith, Hypothesis 3.2.1, printed p.579.
-/

@[expose] public section
open Subgroup
open scoped IsMulCommutative
open Representation.BinaryOffender Representation.BinaryOffender.Homogeneous
namespace Theory.GroupTheory.ReducedNormal
variable {G : Type*} [Group G]

abbrev ModuleGroup (H : Subgroup G) := reducedTwoSubgroup H

instance moduleGroup_elementary (H : Subgroup G) :
    IsElementaryAbelian 2 (ModuleGroup H) := isPReduced_reducedPSubgroup.elementary

/-- The original conjugation homomorphism, before passing to any image. -/
def conjugation (H : Subgroup G) : H →* MulAut (ModuleGroup H) :=
  (ModuleGroup H).normalizerMonoidHom.comp
    ((MonoidHom.id H).codRestrict _ fun h => by
      rw [Subgroup.normalizer_eq_top]
      exact mem_top h)

/-- R₂(H) regarded as its canonical binary representation. -/
noncomputable def representation (H : Subgroup G) :
    Representation (ZMod 2) H (Additive (ModuleGroup H)) :=
  Representation.elementaryRepresentation (conjugation H)

/-- A binary subspace of R₂(H), with both original inclusions into G. -/
def subspaceImage (H : Subgroup G)
    (I : Submodule (ZMod 2) (Additive (ModuleGroup H))) : Subgroup G :=
  (I.toAddSubgroup.toSubgroup'.map (ModuleGroup H).subtype).map H.subtype

theorem subspaceImage_le_reduced (H : Subgroup G)
    (I : Submodule (ZMod 2) (Additive (ModuleGroup H))) :
    subspaceImage H I ≤ (ModuleGroup H).map H.subtype :=
  map_mono (map_subtype_le _)

theorem subspaceImage_le_core (H : Subgroup G)
    (I : Submodule (ZMod 2) (Additive (ModuleGroup H))) :
    subspaceImage H I ≤ H.pCoreIn 2 :=
  (subspaceImage_le_reduced H I).trans (map_mono (reducedPSubgroup_le_pCore 2 H))

theorem subspaceImage_elementary (H : Subgroup G)
    (I : Submodule (ZMod 2) (Additive (ModuleGroup H))) :
    IsElementaryAbelian 2 (subspaceImage H I) := by
  let : IsElementaryAbelian 2 ((ModuleGroup H).map H.subtype) := IsElementaryAbelian.map _
  exact IsElementaryAbelian.of_le (subspaceImage_le_reduced H I)

theorem subspaceImage_ne_bot (H : Subgroup G)
    (I : Submodule (ZMod 2) (Additive (ModuleGroup H))) (hI : I ≠ ⊥) :
    subspaceImage H I ≠ ⊥ := by
  intro he
  apply hI
  apply bot_unique
  intro v hv
  have h : (v.toMul.val : G) ∈ subspaceImage H I :=
    mem_map_of_mem _ (mem_map_of_mem _ hv)
  have hv1 : v.toMul = 1 := Subtype.ext (Subtype.ext (mem_bot.mp (he ▸ h)))
  exact congrArg Additive.ofMul hv1

theorem subspaceImage_normalizes (H X : Subgroup G)
    (hX : X ≤ H) (I : Submodule (ZMod 2) (Additive (ModuleGroup H)))
    (hI : X.subgroupOf H ≤ subspaceStabilizer (representation H) I) :
    X ≤ normalizer (subspaceImage H I : Set G) := by
  apply le_normalizer_iff.mpr
  intro x hx v hv
  obtain ⟨w, ⟨a, ha, rfl⟩, rfl⟩ := hv
  let x' : H := ⟨x, hX hx⟩
  have hh := (hI (show x' ∈ X.subgroupOf H from hx) (Additive.ofMul a)).mpr ha
  exact ⟨_, ⟨(conjugation H x') a, hh, rfl⟩, rfl⟩

theorem subspaceImage_core_centralizes (H : Subgroup G)
    (I : Submodule (ZMod 2) (Additive (ModuleGroup H))) :
    H.pCoreIn 2 ≤ centralizer (subspaceImage H I : Set G) := by
  apply le_centralizer_iff.mp
  apply (subspaceImage_le_reduced H I).trans
  exact (map_mono (reducedPSubgroup_le_centralizer_pCore 2 H)).trans
    (map_centralizer_le_centralizer_image _ _)

theorem subspaceImage_mono (H : Subgroup G)
    {I J : Submodule (ZMod 2) (Additive (ModuleGroup H))} (hIJ : I ≤ J) :
    subspaceImage H I ≤ subspaceImage H J :=
  map_mono (map_mono hIJ)

theorem subspaceImage_iSup (H : Subgroup G) {ι : Sort*}
    (I : ι → Submodule (ZMod 2) (Additive (ModuleGroup H))) :
    subspaceImage H (⨆ i, I i) = ⨆ i, subspaceImage H (I i) := by
  let E : Submodule (ZMod 2) (Additive (ModuleGroup H)) ≃o Subgroup (ModuleGroup H) :=
    (AddSubgroup.toZModSubmodule 2).symm.trans AddSubgroup.toSubgroup'
  change ((E (⨆ i, I i)).map _).map _ = ⨆ i, ((E (I i)).map _).map _
  rw [E.map_iSup, Subgroup.map_iSup, Subgroup.map_iSup]

theorem subspaceImage_map (H : Subgroup G)
    (I : Submodule (ZMod 2) (Additive (ModuleGroup H))) (h : H) :
    subspaceImage H (I.map (representation H h)) =
      (subspaceImage H I).map (MulAut.conj (h : G)).toMonoidHom := by
  ext x
  constructor
  · rintro ⟨_, ⟨_, ⟨v, hv, rfl⟩, rfl⟩, rfl⟩
    exact ⟨v.toMul.val, ⟨v.toMul.val, ⟨v.toMul, hv, rfl⟩, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨_, ⟨v, hv, rfl⟩, rfl⟩, rfl⟩
    exact ⟨_, ⟨_, ⟨Additive.ofMul v, hv, rfl⟩, rfl⟩, rfl⟩

/-- The linear orbit span is the literal ambient conjugate-generated subgroup. -/
theorem subspaceImage_orbitSpan (H A : Subgroup G) (hAH : A ≤ H)
    (I : Submodule (ZMod 2) (Additive (ModuleGroup H))) :
    subspaceImage H (orbitSpan (representation H) (A.subgroupOf H) I) =
      componentOrbit (subspaceImage H I) A := by
  simp only [orbitSpan, subspaceImage_iSup, subspaceImage_map, componentOrbit]
  apply le_antisymm
  · exact iSup_le fun a => le_iSup_of_le (⟨a.val.val, a.property⟩ : A) le_rfl
  · exact iSup_le fun a => le_iSup_of_le
      (⟨⟨a.val, hAH a.property⟩, a.property⟩ : A.subgroupOf H) le_rfl

/-- A constituent generated by a normal actor's commutators is contained
in that actor, as an actual subgroup of the original ambient group. -/
theorem subspaceImage_le_of_full_commutator (H X : Subgroup G)
    (hHX : H ≤ normalizer (X : Set G))
    (I : Submodule (ZMod 2) (Additive (ModuleGroup H)))
    (hI : subspaceCommutator (representation H) I (X.subgroupOf H) = I) :
    subspaceImage H I ≤ X := by
  let C : Submodule (ZMod 2) (Additive (ModuleGroup H)) :=
    AddSubgroup.toZModSubmodule 2
      (((X.subgroupOf H).comap (ModuleGroup H).subtype).toAddSubgroup)
  have hIC : I ≤ C := by
    rw [← hI]
    apply Submodule.span_le.mpr
    rintro _ ⟨x, hx, v, _, rfl⟩
    have hconj := le_normalizer_iff.mp hHX
      v.toMul.val.val v.toMul.val.property x.val⁻¹ (X.inv_mem hx)
    have hmul := X.mul_mem hx hconj
    change x.val * v.toMul.val.val * x.val⁻¹ / v.toMul.val.val ∈ X
    simpa only [Subgroup.subtype_apply, div_eq_mul_inv, mul_assoc] using hmul
  rintro _ ⟨_, ⟨v, hv, rfl⟩, rfl⟩
  exact hIC hv

end Theory.GroupTheory.ReducedNormal
