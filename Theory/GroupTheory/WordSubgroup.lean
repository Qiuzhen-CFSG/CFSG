module

public import Mathlib.Data.Fintype.CardEmbedding
public import Mathlib.Data.Set.Card
public import Mathlib.GroupTheory.Perm.Finite
public import Mathlib.Logic.Equiv.Fin.Basic
public import Mathlib.Tactic.NormNum
import Mathlib.Tactic.FinCases

/-!
# Word evaluation and word-subgroup scaffolding

This module collects the generic word-evaluation and `wordSubgroup`
infrastructure used by the Sporadic Schreier--Sims order certificates.
`evalWord` evaluates a list of generator indices in any group, `wordSubgroup`
is the subgroup generated by those words, and the `wordSubgroup_*` lemmas are
the reusable chain-decomposition tools used to compute subgroup cardinalities.
`rightInverse_of_leftInverse_fin` and `tablePerm` are the small finite
permutation helpers used to build reflected GAP table permutations.

The declarations intentionally live in `Theory.GroupTheory`; the existing
Sporadic certificate modules open that namespace and continue to use the
same unqualified names.
-/

namespace Theory.GroupTheory

set_option maxHeartbeats 800000
set_option maxRecDepth 100000

@[reducible, expose] public def evalWord {G : Type*} [Group G] {n : Nat} (gen : Fin n -> G) :
    List (Fin n) -> G
  | [] => 1
  | i :: w => gen i * evalWord gen w

public theorem evalWord_append {G : Type*} [Group G] {n : Nat} (gen : Fin n -> G)
    (u v : List (Fin n)) :
    evalWord gen (u ++ v) = evalWord gen u * evalWord gen v := by
  induction u with
  | nil => simp [evalWord]
  | cons i u ih => simp [evalWord, ih, mul_assoc]

public theorem evalWord_reverse_map_inv {G : Type*} [Group G] {n : Nat}
    (gen : Fin n -> G) (invOf : Fin n -> Fin n)
    (hInv : forall i, gen (invOf i) = (gen i)⁻¹) (w : List (Fin n)) :
    evalWord gen (w.reverse.map invOf) = (evalWord gen w)⁻¹ := by
  induction w with
  | nil => simp [evalWord]
  | cons i w ih =>
      calc
        evalWord gen ((i :: w).reverse.map invOf) =
            evalWord gen (w.reverse.map invOf) * gen (invOf i) := by
          simp [List.reverse_cons, List.map_append, evalWord_append, evalWord]
        _ = (evalWord gen w)⁻¹ * (gen i)⁻¹ := by rw [ih, hInv]
        _ = (evalWord gen (i :: w))⁻¹ := by simp [evalWord]

@[expose] public def wordSubgroup {G : Type*} [Group G] {n : Nat} (gen : Fin n -> G)
    (invOf : Fin n -> Fin n) (hInv : forall i, gen (invOf i) = (gen i)⁻¹) :
    Subgroup G where
  carrier := {g | exists w : List (Fin n), evalWord gen w = g}
  one_mem' := ⟨[], rfl⟩
  mul_mem' := by
    intro a b ha hb
    rcases ha with ⟨wa, rfl⟩
    rcases hb with ⟨wb, rfl⟩
    exact ⟨wa ++ wb, evalWord_append gen wa wb⟩
  inv_mem' := by
    intro a ha
    rcases ha with ⟨w, rfl⟩
    exact ⟨w.reverse.map invOf, evalWord_reverse_map_inv gen invOf hInv w⟩

public theorem evalWord_mem_wordSubgroup {G : Type*} [Group G] {n : Nat}
    (gen : Fin n -> G) (invOf : Fin n -> Fin n)
    (hInv : forall i, gen (invOf i) = (gen i)⁻¹) (w : List (Fin n)) :
    evalWord gen w ∈ wordSubgroup gen invOf hInv :=
  ⟨w, rfl⟩

public theorem wordSubgroup_le_of_gen_mem {G : Type*} [Group G] {n m : Nat}
    {gen : Fin n -> G} {invOf : Fin n -> Fin n}
    {hInv : forall i, gen (invOf i) = (gen i)⁻¹}
    {nextGen : Fin m -> G} {nextInvOf : Fin m -> Fin m}
    {hNextInv : forall i, nextGen (nextInvOf i) = (nextGen i)⁻¹}
    (hgen : forall i, nextGen i ∈ wordSubgroup gen invOf hInv) :
    wordSubgroup nextGen nextInvOf hNextInv ≤ wordSubgroup gen invOf hInv := by
  intro g hg
  rcases hg with ⟨w, rfl⟩
  induction w with
  | nil => exact (wordSubgroup gen invOf hInv).one_mem
  | cons i w ih => exact (wordSubgroup gen invOf hInv).mul_mem (hgen i) ih

public theorem wordSubgroup_fix_of_gen_fix {V : Type*} {n : Nat}
    (gen : Fin n -> Equiv.Perm V) (invOf : Fin n -> Fin n)
    (hInv : forall i, gen (invOf i) = (gen i)⁻¹) {base : V}
    (hfix : forall i, gen i base = base) :
    forall k : wordSubgroup gen invOf hInv, (k : Equiv.Perm V) base = base := by
  have hword : forall w : List (Fin n), (evalWord gen w) base = base := by
    intro w
    induction w with
    | nil => simp [evalWord]
    | cons i w ih => simp [evalWord, Equiv.Perm.mul_apply, hfix i, ih]
  intro k
  rcases k.property with ⟨w, hw⟩
  rw [← hw]
  exact hword w

public theorem wordSubgroup_card_eq_mul_next {V : Type*} [Fintype V] [DecidableEq V]
    {n m p : Nat}
    (gen : Fin n -> Equiv.Perm V) (invOf : Fin n -> Fin n)
    (hInv : forall i, gen (invOf i) = (gen i)⁻¹)
    (nextGen : Fin p -> Equiv.Perm V) (nextInvOf : Fin p -> Fin p)
    (hNextInv : forall i, nextGen (nextInvOf i) = (nextGen i)⁻¹)
    (rep : Fin m -> Equiv.Perm V) (act : Fin n -> Fin m -> Fin m)
    (factor : Fin n -> Fin m -> List (Fin p)) (base : V) (point : Fin m -> V)
    (baseRep : Fin m)
    (hRepMem : forall r, rep r ∈ wordSubgroup gen invOf hInv)
    (hNextLe : wordSubgroup nextGen nextInvOf hNextInv ≤ wordSubgroup gen invOf hInv)
    (hRepBase : rep baseRep = 1)
    (hRepPoint : forall r, rep r base = point r)
    (hPointInj : Function.Injective point)
    (hNextFix : forall k : wordSubgroup nextGen nextInvOf hNextInv,
      (k : Equiv.Perm V) base = base)
    (hStep : forall i r,
      gen i * rep r = rep (act i r) * evalWord nextGen (factor i r)) :
    Nat.card (wordSubgroup gen invOf hInv) =
      m * Nat.card (wordSubgroup nextGen nextInvOf hNextInv) := by
  classical
  let H := wordSubgroup gen invOf hInv
  let K := wordSubgroup nextGen nextInvOf hNextInv
  have hFactorMem : forall i r, evalWord nextGen (factor i r) ∈ K := by
    intro i r
    exact evalWord_mem_wordSubgroup nextGen nextInvOf hNextInv (factor i r)
  have hDecomp : forall w : List (Fin n), exists r : Fin m, exists k : K,
      evalWord gen w = rep r * (k : Equiv.Perm V) := by
    intro w
    induction w with
    | nil =>
        refine ⟨baseRep, ⟨1, K.one_mem⟩, ?_⟩
        simp [evalWord, hRepBase]
    | cons i w ih =>
        rcases ih with ⟨r, k, hk⟩
        refine ⟨act i r, ⟨evalWord nextGen (factor i r) * (k : Equiv.Perm V),
          K.mul_mem (hFactorMem i r) k.property⟩, ?_⟩
        calc
          evalWord gen (i :: w) = gen i * evalWord gen w := rfl
          _ = gen i * (rep r * (k : Equiv.Perm V)) := by rw [hk]
          _ = (gen i * rep r) * (k : Equiv.Perm V) := by rw [mul_assoc]
          _ = (rep (act i r) * evalWord nextGen (factor i r)) * (k : Equiv.Perm V) := by rw [hStep]
          _ = rep (act i r) * (evalWord nextGen (factor i r) * (k : Equiv.Perm V)) := by rw [mul_assoc]
  let coverMap : Fin m × K -> H := fun x =>
    ⟨rep x.1 * (x.2 : Equiv.Perm V), H.mul_mem (hRepMem x.1) (hNextLe x.2.property)⟩
  have hsurj : Function.Surjective coverMap := by
    intro h
    rcases h.property with ⟨w, hw⟩
    rcases hDecomp w with ⟨r, k, hk⟩
    refine ⟨(r, k), Subtype.ext ?_⟩
    exact hk.symm.trans hw
  have hinj : Function.Injective coverMap := by
    intro x y hxy
    rcases x with ⟨rx, kx⟩
    rcases y with ⟨ry, ky⟩
    have hidx : rx = ry := by
      apply hPointInj
      have happ := congrArg (fun g : Equiv.Perm V => g base) (Subtype.ext_iff.mp hxy)
      change (rep rx * (kx : Equiv.Perm V)) base =
        (rep ry * (ky : Equiv.Perm V)) base at happ
      simpa [Equiv.Perm.mul_apply, hRepPoint, hNextFix] using happ
    subst ry
    apply Prod.ext
    · rfl
    · apply Subtype.ext
      have hperm := Subtype.ext_iff.mp hxy
      exact mul_left_cancel hperm
  let e : Fin m × K ≃ H := Equiv.ofBijective coverMap ⟨hinj, hsurj⟩
  calc
    Nat.card H = Nat.card (Fin m × K) := Nat.card_congr e.symm
    _ = m * Nat.card K := by simp

public theorem wordSubgroup_fin_zero_eq_bot {G : Type*} [Group G]
    (gen : Fin 0 -> G) (invOf : Fin 0 -> Fin 0)
    (hInv : forall i, gen (invOf i) = (gen i)⁻¹) :
    wordSubgroup gen invOf hInv = (⊥ : Subgroup G) := by
  ext g
  constructor
  · intro hg
    rcases hg with ⟨w, hw⟩
    have hwone : evalWord gen w = 1 := by
      induction w with
      | nil => rfl
      | cons i w _ => exact Fin.elim0 i
    exact hw ▸ hwone
  · intro hg
    rw [Subgroup.mem_bot] at hg
    exact ⟨[], by simp [evalWord, hg]⟩

public theorem wordSubgroup_fin_zero_card {G : Type*} [Group G] [Finite G]
    (gen : Fin 0 -> G) (invOf : Fin 0 -> Fin 0)
    (hInv : forall i, gen (invOf i) = (gen i)⁻¹) :
    Nat.card (wordSubgroup gen invOf hInv) = 1 := by
  rw [wordSubgroup_fin_zero_eq_bot gen invOf hInv]
  simp

public theorem rightInverse_of_leftInverse_fin {n : Nat} {f g : Fin n -> Fin n}
    (left : forall x, g (f x) = x) :
    forall x, f (g x) = x := by
  exact Function.LeftInverse.rightInverse_of_surjective left
    (Finite.surjective_of_injective (Function.LeftInverse.injective left))

@[reducible, expose] public def tablePerm {n : Nat} (f g : Fin n -> Fin n)
    (left : ∀ x, g (f x) = x) (right : ∀ x, f (g x) = x) : Equiv.Perm (Fin n) where
  toFun := f
  invFun := g
  left_inv := left
  right_inv := right

end Theory.GroupTheory
