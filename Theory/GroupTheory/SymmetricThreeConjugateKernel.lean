module

public import Theory.GroupTheory.InvertedThreeLift
public import Theory.GroupTheory.NormalizingInvolutionCard
public import Theory.GroupAction.SubgroupConjugation
public import Theory.GroupTheory.CommutatorPreimage
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.Index

/-!+# A central two-extension generated by one involution class

An involution above a transposition in S₃ inverts a lifted subgroup of order
three. These subgroups generate an S₃ complement containing the involution.
The central kernel makes the complement normal, so a generating conjugacy
class forces the kernel to be trivial.

This supplies the binary-field case of Aschbacher–Smith G.2.3(3), printed
pp.333–334. Internal conjugacy is essential: the two reflection classes of
D₁₂ give a counterexample if the conjugating element is only ambient.
-/

namespace Subgroup

private theorem normal_of_central_kernel_and_surjective_restriction
    {G D : Type*} [Group G] [Group D]
    (f : G →* D) (hc : f.ker ≤ center G) (B : Subgroup G)
    (hs : Function.Surjective (f.domRestrict B)) : B.Normal := by
  constructor
  intro b hb g
  obtain ⟨h, hh⟩ := hs (f g)
  have hk : g * (h : G)⁻¹ ∈ f.ker := by
    change f (g * (h : G)⁻¹) = 1
    change f (h : G) = f g at hh
    rw [map_mul, map_inv, hh, mul_inv_cancel]
  have he : g * b * g⁻¹ = (h : G) * b * (h : G)⁻¹ := by
    have hcomm := mem_center_iff.mp (hc hk) ((h : G) * b * (h : G)⁻¹)
    calc
      g * b * g⁻¹ = (g * (h : G)⁻¹) *
          ((h : G) * b * (h : G)⁻¹) * (g * (h : G)⁻¹)⁻¹ := by group
      _ = (h : G) * b * (h : G)⁻¹ := by rw [← hcomm, mul_inv_cancel_right]
  rw [he]
  exact B.mul_mem (B.mul_mem h.property hb) (B.inv_mem h.property)

/-- A central two-extension of S₃ has trivial kernel if it is generated by
the conjugacy class of an involution above a transposition. -/
public theorem ker_eq_bot_of_central_symmetric_three_involution_class
    {G : Type*} [Group G] [Finite G]
    (f : G →* Equiv.Perm (Fin 3)) (hf : Function.Surjective f)
    (hker : IsPGroup 2 f.ker) (hc : f.ker ≤ center G)
    (t : G) (ht : t ^ 2 = 1) (hft : f t ≠ 1)
    (hgen : normalClosure ({t} : Set G) = ⊤) : f.ker = ⊥ := by
  classical
  obtain ⟨Q, hQ, _, hQimage, htQ, _⟩ :=
    exists_inverted_three_lift_of_two_kernel f hf hker t ht hft
  have htne : t ≠ 1 := fun he => hft (by rw [he, map_one])
  have hto : orderOf t = 2 := orderOf_eq_prime ht htne
  have htout : t ∉ Q := by
    intro htmem
    have hd := Q.orderOf_dvd_natCard htmem
    rw [hto, hQ] at hd
    norm_num at hd
  let B : Subgroup G := Q ⊔ zpowers t
  have hB : Nat.card B = 6 := by
    rw [card_sup_zpowers_of_normalizing_involution Q t ht htout htQ, hQ]
  have hTimage : Nat.card ((zpowers t).map f) = 2 := by
    rw [MonoidHom.map_zpowers, Nat.card_zpowers]
    exact orderOf_eq_prime (by rw [← map_pow, ht, map_one]) hft
  have hQdiv : 3 ∣ Nat.card (B.map f) := by
    have hd := card_dvd_of_le (map_mono (f := f) (show Q ≤ B from le_sup_left))
    rwa [hQimage] at hd
  have hTdiv : 2 ∣ Nat.card (B.map f) := by
    have hd := card_dvd_of_le
      (map_mono (f := f) (show zpowers t ≤ B from le_sup_right))
    rwa [hTimage] at hd
  have hS3 : Nat.card (Equiv.Perm (Fin 3)) = 6 := by
    norm_num [Nat.card_eq_fintype_card, Fintype.card_perm]
  have hBimage : B.map f = ⊤ := by
    apply eq_of_le_of_card_ge le_top
    rw [card_top, hS3]
    exact Nat.le_of_dvd Nat.card_pos
      ((by decide : Nat.Coprime 3 2).mul_dvd_of_dvd_of_dvd hQdiv hTdiv)
  have hs : Function.Surjective (f.domRestrict B) := by
    apply MonoidHom.range_eq_top.mp
    rwa [MonoidHom.domRestrict_range]
  have hi : Function.Injective (f.domRestrict B) :=
    (hs.bijective_of_nat_card_le (by rw [hB, hS3])).injective
  let : B.Normal := normal_of_central_kernel_and_surjective_restriction f hc B hs
  have hle : normalClosure ({t} : Set G) ≤ B :=
    normalClosure_le_normal (by simpa using
      (show t ∈ B from mem_sup_right (mem_zpowers t)))
  have hBtop : B = ⊤ := top_le_iff.mp (hgen ▸ hle)
  apply le_antisymm _ bot_le
  intro x hx
  have hxB : x ∈ B := hBtop ▸ mem_top x
  have he : f.domRestrict B (⟨x, hxB⟩ : B) = f.domRestrict B 1 := by
    simpa only [MonoidHom.domRestrict_apply, map_one] using (MonoidHom.mem_ker.mp hx)
  exact congrArg Subtype.val (hi he)

/-- The conjugating element belongs to the group whose central extension
is being tested. Two conjugate order-two subgroups then kill the kernel. -/
public theorem ker_eq_bot_of_central_symmetric_three_conjugate_pair
    {G : Type*} [Group G] [Finite G]
    (f : G →* Equiv.Perm (Fin 3)) (hf : Function.Surjective f)
    (hker : IsPGroup 2 f.ker) (hc : f.ker ≤ center G)
    (U : Subgroup G) (hU : Nat.card U = 2) (hUf : Nat.card (U.map f) = 2)
    (g : G) (hgen : U ⊔ U.conjBy g = ⊤) : f.ker = ⊥ := by
  classical
  obtain ⟨y, hy, _⟩ := (Nat.card_eq_two_iff' (1 : U.map f)).mp hUf
  obtain ⟨t, htU, hty⟩ := y.property
  have hft : f t ≠ 1 := by
    intro he
    apply hy
    exact Subtype.ext (hty.symm.trans he)
  have ht : t ^ 2 = 1 := by
    have hh := pow_card_eq_one' (x := (⟨t, htU⟩ : U))
    rw [hU] at hh
    exact congrArg Subtype.val hh
  have hZ : zpowers t = U := by
    apply eq_of_le_of_card_ge (zpowers_le.mpr htU)
    rw [Nat.card_zpowers, hU]
    exact le_of_eq (orderOf_eq_prime ht (fun he => hft (by rw [he, map_one]))).symm
  let N := normalClosure ({t} : Set G)
  have hUN : U ≤ N := by
    rw [← hZ]
    exact zpowers_le.mpr (subset_normalClosure (by simp))
  have hgUN : U.conjBy g ≤ N := by
    rintro x ⟨u, hu, rfl⟩
    exact (inferInstance : N.Normal).conj_mem u (hUN hu) g
  have hN : N = ⊤ := top_le_iff.mp (hgen ▸ sup_le hUN hgUN)
  exact ker_eq_bot_of_central_symmetric_three_involution_class f hf hker hc t ht hft hN

/-- The literal quotient by a proposed kernel factor kills the remaining
central two-extension. The only generation input is internal conjugacy. -/
public theorem ker_eq_of_symmetric_three_conjugate_pair
    {G : Type*} [Group G] [Finite G]
    (f : G →* Equiv.Perm (Fin 3)) (hf : Function.Surjective f)
    (hker : IsPGroup 2 f.ker) (U P : Subgroup G)
    (hP : P ≤ f.ker) (hUP : U ⊓ f.ker ≤ P)
    (hc : ⁅f.ker, (⊤ : Subgroup G)⁆ ≤ P)
    (hUf : Nat.card (U.map f) = 2)
    (g : G) (hgen : U ⊔ U.conjBy g = ⊤) : f.ker = P := by
  let : P.Normal := normalizer_eq_top_iff.mp (top_le_iff.mp
    (le_normalizer_iff_commutator_le_left.mpr
      ((commutator_mono hP le_rfl).trans hc)))
  let q := QuotientGroup.mk' P
  let fbar := QuotientGroup.lift P f hP
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective P
  have hfbar : Function.Surjective fbar :=
    QuotientGroup.lift_surjective_of_surjective P f hf hP
  have hkbar : fbar.ker = f.ker.map q := QuotientGroup.ker_lift P f hP
  have hbarp : IsPGroup 2 fbar.ker := hkbar ▸ hker.map q
  have hbarc : fbar.ker ≤ center (G ⧸ P) := by
    apply commutator_top_right_eq_bot_iff_le_center.mp
    rw [hkbar, ← map_top_of_surjective q hq, ← map_commutator]
    exact (map_eq_bot_iff _).mpr (by simpa only [q, QuotientGroup.ker_mk'] using hc)
  have hUPeq : U ⊓ P = U ⊓ f.ker :=
    le_antisymm (inf_le_inf_left _ hP) (le_inf inf_le_left hUP)
  have hUbar : Nat.card (U.map q) = 2 := by
    rw [← relIndex_ker U q, QuotientGroup.ker_mk', ← inf_relIndex_left,
      hUPeq, inf_relIndex_left, relIndex_ker]
    exact hUf
  have hUfbar : Nat.card ((U.map q).map fbar) = 2 := by
    rw [map_map, QuotientGroup.lift_comp_mk']
    exact hUf
  have hconj : (U.conjBy g).map q = (U.map q).conjBy (q g) := by
    change (U.map (MulAut.conj g).toMonoidHom).map q =
      (U.map q).map (MulAut.conj (q g)).toMonoidHom
    rw [map_map, map_map]
    congr 1
  have hgenbar : U.map q ⊔ (U.map q).conjBy (q g) = ⊤ := by
    have hh := congrArg (fun K : Subgroup G => K.map q) hgen
    simpa only [map_sup, hconj, map_top_of_surjective q hq] using hh
  have hb := ker_eq_bot_of_central_symmetric_three_conjugate_pair
    fbar hfbar hbarp hbarc (U.map q) hUbar hUfbar (q g) hgenbar
  exact ((QuotientGroup.injective_lift_iff P f hP).mp
    ((MonoidHom.ker_eq_bot_iff fbar).mp hb)).symm

/-- In the binary almost-special calculation the two-core normalizes U.
Its intersections with two internally conjugate generators generate the
entire kernel. No central-extension or commutator premise remains. -/
public theorem symmetric_three_kernel_eq_conjugate_intersections
    {G : Type*} [Group G] [Finite G]
    (f : G →* Equiv.Perm (Fin 3)) (hf : Function.Surjective f)
    (hker : IsPGroup 2 f.ker) (U : Subgroup G)
    (hSU : f.ker ≤ normalizer (U : Set G))
    (hUf : Nat.card (U.map f) = 2)
    (g : G) (hgen : U ⊔ U.conjBy g = ⊤) :
    f.ker = (U ⊓ f.ker) ⊔ (U ⊓ f.ker).conjBy g := by
  let V := U.conjBy g
  let P := (U ⊓ f.ker) ⊔ (V ⊓ f.ker)
  have hSg : f.ker.map (MulAut.conj g).toMonoidHom = f.ker :=
    Subgroup.Normal.map_conj_eq f.ker g
  have hSV : f.ker ≤ normalizer (V : Set G) := by
    have hh := map_mono (f := (MulAut.conj g).toMonoidHom) hSU
    rwa [hSg, map_normalizer_eq_of_bijective U (MulAut.conj g).bijective] at hh
  have hP : P ≤ f.ker := sup_le inf_le_right inf_le_right
  have hUcomm : ⁅U, f.ker⁆ ≤ U ⊓ f.ker :=
    le_inf (le_normalizer_iff_commutator_le_left.mp hSU) (commutator_le_right _ _)
  have hVcomm : ⁅V, f.ker⁆ ≤ V ⊓ f.ker :=
    le_inf (le_normalizer_iff_commutator_le_left.mp hSV) (commutator_le_right _ _)
  have hUP : U ≤ normalizer (P : Set G) :=
    le_normalizer_iff_commutator_le_right.mpr
      (((commutator_mono le_rfl hP).trans hUcomm).trans le_sup_left)
  have hVP : V ≤ normalizer (P : Set G) :=
    le_normalizer_iff_commutator_le_right.mpr
      (((commutator_mono le_rfl hP).trans hVcomm).trans le_sup_right)
  have htopP : (⊤ : Subgroup G) ≤ normalizer (P : Set G) :=
    hgen ▸ sup_le hUP hVP
  have hpreU : U ≤ commutatorPreimage ⊤ f.ker P :=
    le_commutatorPreimage le_top (hUcomm.trans le_sup_left)
  have hpreV : V ≤ commutatorPreimage ⊤ f.ker P :=
    le_commutatorPreimage le_top (hVcomm.trans le_sup_right)
  have hc : ⁅f.ker, (⊤ : Subgroup G)⁆ ≤ P := by
    rw [commutator_comm]
    exact (commutator_mono (hgen.ge.trans (sup_le hpreU hpreV)) le_rfl).trans
      (commutator_commutatorPreimage_le ⊤ f.ker P htopP)
  have he : (U ⊓ f.ker).conjBy g = V ⊓ f.ker := by
    change (U ⊓ f.ker).map (MulAut.conj g).toMonoidHom = V ⊓ f.ker
    rw [map_inf _ _ _ (MulAut.conj g).injective, hSg]
    rfl
  rw [he]
  exact ker_eq_of_symmetric_three_conjugate_pair f hf hker U P hP le_sup_left
    hc hUf g hgen

end Subgroup
