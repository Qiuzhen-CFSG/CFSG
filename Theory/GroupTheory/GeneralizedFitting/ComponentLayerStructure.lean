module

public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus

/-!
# Intrinsic closure of the ordinary layer

Conjugation preserves the components. Restriction and subnormal transitivity
identify the layer of a subnormal overgroup of the layer with the original
layer. In particular the layer is generated by its own components and is
perfect. These are the elementary layer facts used in GLS II, B.5.16.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G]

instance componentLayer_characteristic : (componentLayer G).Characteristic := by
  apply characteristic_iff_map_le.mpr
  intro e
  apply map_le_iff_le_comap.mpr
  exact sSup_le fun K hK => map_le_iff_le_comap.mp (le_sSup (hK.map_equiv e))

theorem map_componentLayer_subtype_le (N : Subgroup G) (hN : N.IsSubnormal) :
    (componentLayer N).map N.subtype ≤ componentLayer G := by
  apply map_le_iff_le_comap.mpr
  apply sSup_le
  intro K hK
  let := hK.2
  have h : IsComponent G (K.map N.subtype) :=
    ⟨hK.1.trans' hN, IsQuasisimple.of_mulEquiv
      (K.equivMapOfInjective N.subtype N.subtype_injective)⟩
  exact map_le_iff_le_comap.mp (le_sSup h)

theorem map_componentLayer_subtype_eq_of_le (N : Subgroup G) (hN : N.IsSubnormal)
    (hle : componentLayer G ≤ N) :
    (componentLayer N).map N.subtype = componentLayer G := by
  apply le_antisymm (map_componentLayer_subtype_le N hN)
  apply sSup_le
  intro K hK
  have hKN : K ≤ N := (le_sSup hK : K ≤ componentLayer G).trans hle
  have h := map_mono (f := N.subtype)
    (show K.subgroupOf N ≤ componentLayer N from le_sSup (hK.subgroupOf hKN))
  simpa only [map_subgroupOf_eq_of_le hKN] using h

theorem componentLayer_idempotent : componentLayer (componentLayer G) = ⊤ := by
  apply map_injective (componentLayer G).subtype_injective
  rw [map_componentLayer_subtype_eq_of_le _
    (inferInstance : (componentLayer G).Normal).isSubnormal le_rfl,
    ← MonoidHom.range_eq_map, range_subtype]

theorem componentLayer_isPerfect : Group.IsPerfect (componentLayer G) := by
  rw [isPerfect_iff]
  apply le_antisymm (commutator_le_self _)
  apply sSup_le
  intro K hK
  let := hK.2
  rw [← commutator_eq_self (H := K)]
  exact commutator_mono (le_sSup hK) (le_sSup hK)

end Theory.GroupTheory
