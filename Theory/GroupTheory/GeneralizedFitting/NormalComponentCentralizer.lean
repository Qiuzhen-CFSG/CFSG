module
public import Theory.GroupTheory.GeneralizedFitting.InternalModuleResidual
public import Theory.GroupTheory.GeneralizedFitting.MovedComponent

/-!
# A normal component and its centralizer

A normal quasisimple subgroup K centralizes the Fitting subgroup. Every
other component commutes with K. Consequently F(G) is the embedded Fitting
subgroup of C_G(K), and F*(G) is generated by K and the embedded F*(C_G(K)).
A nontrivial p-subgroup centralizing F(C_G(K)), in a group with trivial
p-core, must therefore move K or an actual component of its centralizer.

The final selection below is stated for p = 2, as used after D.2.13 in
Aschbacher--Smith 5.1.23, printed p.645 of `refs/quasithin.pdf`.
-/

public noncomputable section

open Subgroup
open scoped IsMulCommutative
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

theorem fitting_eq_map_centralizer_of_normal_component
    (K : Subgroup G) [K.Normal] [IsQuasisimple K] :
    fittingSubgroup G =
      (fittingSubgroup (centralizer (K : Set G))).map (centralizer (K : Set G)).subtype := by
  let : IsSimpleGroup (K ⧸ center K) := IsQuasisimple.simple
  let : Nontrivial K := (QuotientGroup.mk'_surjective (center K)).nontrivial
  have hK : IsComponent G K := ⟨(inferInstance : K.Normal).isSubnormal,inferInstance⟩
  have hFC : fittingSubgroup G ≤ centralizer (K : Set G) := by
    rcases hK.normal_dichotomy (fittingSubgroup G) with hh | hh
    · let : Group.IsSolvable K := Group.isSolvable_of_isSolvable_injective
        (f := inclusion hh) (inclusion_injective hh)
      exact (Group.IsPerfect.not_isSolvable K inferInstance).elim
    · rw [commutator_comm] at hh
      exact commutator_eq_bot_iff_le_centralizer.mp hh
  let C := centralizer (K : Set G)
  apply le_antisymm
  · have hn : Group.IsNilpotent ((fittingSubgroup G).subgroupOf C) :=
      Group.nilpotent_of_mulEquiv (subgroupOfEquivOfLe hFC).symm
    have hh : (fittingSubgroup G).subgroupOf C ≤ fittingSubgroup C :=
      le_sSup ⟨inferInstance,hn⟩
    have hm := map_mono (f := C.subtype) hh
    rwa [map_subgroupOf_eq_of_le hFC] at hm
  · exact fittingSubgroup_map_subtype_le_of_isSubnormal C
      (inferInstance : C.Normal).isSubnormal

theorem generalizedFitting_eq_normal_component_sup_centralizer
    (K : Subgroup G) [K.Normal] [IsQuasisimple K] :
    generalizedFitting G = K ⊔
      (generalizedFitting (centralizer (K : Set G))).map (centralizer (K : Set G)).subtype := by
  have hK : IsComponent G K := ⟨(inferInstance : K.Normal).isSubnormal,inferInstance⟩
  let C := centralizer (K : Set G)
  apply le_antisymm
  · apply sup_le
    · rw [fitting_eq_map_centralizer_of_normal_component K]
      exact (map_mono (fitting_le_generalizedFitting C)).trans le_sup_right
    · apply sSup_le
      intro J hJ
      by_cases he : J = K
      · exact he ▸ le_sup_left
      · have hJC : J ≤ C := commutator_eq_bot_iff_le_centralizer.mp
          (hJ.commutator_eq_bot_of_ne hK he)
        have hh := map_mono (f := C.subtype)
          (component_le_generalizedFitting C (J.subgroupOf C) (hJ.subgroupOf hJC))
        rw [map_subgroupOf_eq_of_le hJC] at hh
        exact hh.trans le_sup_right
  · exact sup_le (component_le_generalizedFitting G K hK)
      (generalizedFitting_map_subtype_le_of_isSubnormal C
        (inferInstance : C.Normal).isSubnormal)

theorem moves_normal_component_or_centralizer_component
    (K : Subgroup G) [K.Normal] [IsQuasisimple K]
    (A : Subgroup G) (hA : IsPGroup 2 A) (hne : A ≠ ⊥) (hcore : pCore 2 G = ⊥)
    (hF : (fittingSubgroup (centralizer (K : Set G))).map
      (centralizer (K : Set G)).subtype ≤ centralizer (A : Set G)) :
    ⁅K,A⁆ ≠ ⊥ ∨ ∃ J : Subgroup (centralizer (K : Set G)),
      IsComponent (centralizer (K : Set G)) J ∧
      IsComponent G (J.map (centralizer (K : Set G)).subtype) ∧
      ⁅J.map (centralizer (K : Set G)).subtype,A⁆ ≠ ⊥ := by
  have hfit : fittingSubgroup G ≤ centralizer (A : Set G) := by
    rwa [fitting_eq_map_centralizer_of_normal_component K]
  obtain ⟨J,hJ,hm⟩ := exists_component_moved_of_centralizes_fitting 2 A hA hne hcore
    (le_centralizer_iff.mp hfit)
  by_cases he : J = K
  · exact Or.inl (he ▸ hm)
  · have hK : IsComponent G K := ⟨(inferInstance : K.Normal).isSubnormal,inferInstance⟩
    have hJC := commutator_eq_bot_iff_le_centralizer.mp (hJ.commutator_eq_bot_of_ne hK he)
    refine Or.inr ⟨J.subgroupOf (centralizer (K : Set G)),hJ.subgroupOf hJC,?_,?_⟩
    · rwa [map_subgroupOf_eq_of_le hJC]
    · rwa [map_subgroupOf_eq_of_le hJC]

end Theory.GroupTheory
