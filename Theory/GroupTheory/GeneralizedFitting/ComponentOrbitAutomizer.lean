module

public import Theory.GroupTheory.ComponentLocalOrbitCore
public import Theory.GroupTheory.SylowSubnormalIntersection
public import Theory.GroupTheory.PGroup.NormalChain
public import Theory.GroupTheory.NormalizerAction
public import Theory.GroupTheory.PResidual.SylowSupplement

/-!
# Actual automizers of a transitive component orbit

Distinct components commute. A subgroup of one component invariant under
its Sylow stabilizer therefore has its orbit inside that subgroup times the
component centralizer. If a proper nontrivial seed and the Sylow generated
the whole group, this would make the seed normal in the simple component.

When the full component orbit is the two-residual, its normalizer is
subnormal, so the original Sylow intersection is Sylow there. Its literal
normalizer/centralizer quotient is generated by the component image and
that Sylow image; the latter is not normal for an even simple component.

Source: Aschbacher–Smith, B.6.8(3), printed pp.114–115 (1 March 2004).
These statements concern the automizer, not the entire normalizer.
-/

public section
open Subgroup
open scoped Pointwise
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- A stabilizer-invariant seed remains in its own component plus the centralizer. -/
theorem componentOrbit_le_seed_sup_centralizer
    {L A D : Subgroup G} (hL : IsComponent G L) (hAL : A ≤ L)
    (hinv : D ⊓ normalizer (L : Set G) ≤ normalizer (A : Set G)) :
    componentOrbit A D ≤ A ⊔ centralizer (L : Set G) := by
  apply iSup_le
  intro d
  by_cases he : L.map (MulAut.conj (d : G)).toMonoidHom = L
  · have ha : A.map (MulAut.conj (d : G)).toMonoidHom = A :=
      mem_normalizer_iff_map_conj_eq.mp
        (hinv ⟨d.property, mem_normalizer_iff_map_conj_eq.mpr he⟩)
    rw [ha]
    exact le_sup_left
  · exact (map_mono hAL).trans ((commutator_eq_bot_iff_le_centralizer.mp
      ((hL.map_conj (d : G)).commutator_eq_bot_of_ne hL he)).trans le_sup_right)

omit [Finite G] in
/-- A proper nontrivial local seed cannot generate the ambient group with its Sylow. -/
theorem component_seed_sup_sylow_ne_top
    (T : Sylow 2 G) {L A : Subgroup G} (hL : IsComponent G L) [IsSimpleGroup L]
    (hAL : A ≤ L) (ha : A ≠ ⊥) (haL : A ≠ L)
    (hinv : (T : Subgroup G) ⊓ normalizer (L : Set G) ≤ normalizer (A : Set G)) :
    A ⊔ (T : Subgroup G) ≠ ⊤ := by
  intro he
  let P := componentOrbit A (T : Subgroup G)
  have hpt : P ⊔ (T : Subgroup G) = ⊤ := by
    rw [show P = componentOrbit A (T : Subgroup G) from rfl, componentOrbit_sup, he]
  have ho : P ≤ A ⊔ centralizer (L : Set G) :=
    componentOrbit_le_seed_sup_centralizer hL hAL hinv
  have hpL : P ≤ normalizer (L : Set G) :=
    ho.trans (sup_le (hAL.trans L.le_normalizer) (Subgroup.centralizer_le_normalizer _))
  have hpA : P ≤ normalizer (A : Set G) :=
    ho.trans (sup_le A.le_normalizer ((centralizer_le hAL).trans (Subgroup.centralizer_le_normalizer _)))
  have hn : L ≤ normalizer (A : Set G) := by
    intro l hl
    have hm : l ∈ (P : Set G) * ((T : Subgroup G) : Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left P (T : Subgroup G)
        (le_normalizer_componentOrbit A (T : Subgroup G)), hpt]
      trivial
    obtain ⟨p,hp,t,ht,hpt⟩ := hm
    have htN : t ∈ normalizer (L : Set G) := by
      have hh := (normalizer (L : Set G)).mul_mem
        ((normalizer (L : Set G)).inv_mem (hpL hp)) (L.le_normalizer hl)
      simpa only [← hpt, inv_mul_cancel_left] using hh
    exact hpt ▸ (normalizer (A : Set G)).mul_mem (hpA hp) (hinv ⟨ht,htN⟩)
  let : (A.subgroupOf L).Normal := (normal_subgroupOf_iff_le_normalizer hAL).mpr hn
  obtain hb | ht := IsSimpleGroup.eq_bot_or_eq_top_of_normal (A.subgroupOf L) inferInstance
  · apply ha
    have hh := congrArg (map L.subtype) hb
    simpa only [map_subgroupOf_eq_of_le hAL, Subgroup.map_bot] using hh
  · apply haL
    have hh := congrArg (map L.subtype) ht
    simpa only [map_subgroupOf_eq_of_le hAL, ← MonoidHom.range_eq_map, range_subtype] using hh

omit [Finite G] in
/-- The residual normalizes each of its actual simple factors. -/
theorem residual_le_component_normalizer
    (T : Sylow 2 G) {L : Subgroup G} (hL : IsComponent G L)
    (ho : componentOrbit L (T : Subgroup G) = pResidual 2 G) :
    pResidual 2 G ≤ normalizer (L : Set G) := by
  rw [← ho]
  exact (componentOrbit_le_seed_sup_centralizer hL le_rfl inf_le_right).trans
    (sup_le L.le_normalizer (Subgroup.centralizer_le_normalizer _))

/-- The actual normalizer is subnormal because its image is in a two-group. -/
theorem component_normalizer_subnormal
    (T : Sylow 2 G) {L : Subgroup G} (hL : IsComponent G L)
    (ho : componentOrbit L (T : Subgroup G) = pResidual 2 G) :
    (normalizer (L : Set G)).IsSubnormal := by
  let q := QuotientGroup.mk' (pResidual 2 G)
  have hn := (isPGroup_quotient_pResidual 2 (G := G)).subgroup_isSubnormal
    ((normalizer (L : Set G)).map q)
  have hh := hn.comap q
  rwa [comap_map_eq_self (by
    rw [show q.ker = pResidual 2 G from QuotientGroup.ker_mk' _]
    exact residual_le_component_normalizer T hL ho)] at hh

/-- The normalizer has the prescribed Sylow intersection, before passing to its automizer. -/
theorem component_normalizer_sylow
    (T : Sylow 2 G) {L : Subgroup G} (hL : IsComponent G L)
    (ho : componentOrbit L (T : Subgroup G) = pResidual 2 G) :
    ∃ S : Sylow 2 (normalizer (L : Set G)),
      (S : Subgroup (normalizer (L : Set G))) =
        (T : Subgroup G).subgroupOf (normalizer (L : Set G)) :=
  T.exists_subgroupOf_eq_of_subnormal _ (component_normalizer_subnormal T hL ho)

/-- The actual component image and normalizer-Sylow image generate the automizer. -/
theorem component_automizer_sylow_supplement
    (T : Sylow 2 G) {L : Subgroup G} (hL : IsComponent G L)
    (ho : componentOrbit L (T : Subgroup G) = pResidual 2 G) :
    NormalizerAction.componentImage L ⊔
      ((T : Subgroup G).subgroupOf (normalizer (L : Set G))).map
        (NormalizerAction.quotient L) = ⊤ := by
  let N := normalizer (L : Set G)
  let q := NormalizerAction.quotient L
  let R := pResidual 2 G
  have hRN : R ≤ N := residual_le_component_normalizer T hL ho
  have hRC : R ≤ L ⊔ centralizer (L : Set G) := by
    change pResidual 2 G ≤ _
    rw [← ho]
    exact componentOrbit_le_seed_sup_centralizer hL le_rfl inf_le_right
  apply top_unique
  intro x _
  obtain ⟨n,rfl⟩ := QuotientGroup.mk'_surjective (NormalizerAction.C L) x
  have hm : (n : G) ∈ R ⊔ (T : Subgroup G) := by
    rw [pResidual_sup_sylow_eq_top T]
    trivial
  obtain ⟨r,hr,t,ht,hrt⟩ := mem_sup_of_normal_left.mp hm
  have htN : t ∈ N := by
    have hh := N.mul_mem (N.inv_mem (hRN hr)) n.property
    simpa only [← hrt, inv_mul_cancel_left] using hh
  have hrq : q ⟨r,hRN hr⟩ ∈ NormalizerAction.componentImage L := by
    apply NormalizerAction.quotient_mem_componentImage_of_central_supplement L
      (centralizer (L : Set G)) L le_rfl L.le_normalizer le_rfl
    simpa only [sup_comm] using hRC hr
  have he : n = (⟨r,hRN hr⟩ : N) * ⟨t,htN⟩ := Subtype.ext hrt.symm
  change q n ∈ _
  rw [he, map_mul]
  exact mul_mem (mem_sup_left hrq) (mem_sup_right (mem_map_of_mem q ht))

/-- The original Sylow meets an even simple component nontrivially. -/
theorem component_sylow_intersection_ne_bot
    (T : Sylow 2 G) {L : Subgroup G} (hL : IsComponent G L)
    (heven : 2 ∣ Nat.card L) : (T : Subgroup G).subgroupOf L ≠ ⊥ := by
  obtain ⟨S,hS⟩ := T.exists_subgroupOf_eq_of_subnormal L hL.1
  rw [← hS]
  exact S.ne_bot_of_dvd_card heven

/-- The actual Sylow image of a simple component automizer is not normal. -/
theorem component_automizer_sylow_not_normal
    (T : Sylow 2 G) {L : Subgroup G}
    (hL : IsComponent G L) [IsSimpleGroup L] (heven : 2 ∣ Nat.card L)
    (S : Sylow 2 (NormalizerAction.Star L))
    (hS : (S : Subgroup (NormalizerAction.Star L)) = ((T : Subgroup G).subgroupOf (normalizer (L : Set G))).map
      (NormalizerAction.quotient L)) : ¬ (S : Subgroup (NormalizerAction.Star L)).Normal := by
  intro hn
  let := hn
  let := hL.2
  let c := NormalizerAction.componentMap L
  have hcent : center L = ⊥ := by
    obtain hb | ht := IsSimpleGroup.eq_bot_or_eq_top_of_normal (center L) inferInstance
    · exact hb
    · exact (Group.IsPerfect.not_isMulCommutative L (center_eq_top_iff.mp ht)).elim
  have hc : Function.Injective c := by
    apply (MonoidHom.ker_eq_bot_iff c).mp
    exact (NormalizerAction.componentMap_ker L).trans hcent
  let A := (S : Subgroup (NormalizerAction.Star L)).comap c
  let : A.Normal := hn.comap c
  obtain hb | ht := IsSimpleGroup.eq_bot_or_eq_top_of_normal A inferInstance
  · apply component_sylow_intersection_ne_bot T hL heven
    apply le_bot_iff.mp
    intro l hl
    have hm : l ∈ A := by
      change c l ∈ (S : Subgroup (NormalizerAction.Star L))
      rw [hS]
      exact mem_map_of_mem (NormalizerAction.quotient L) hl
    rw [hb] at hm
    exact hm
  · have hall (l : L) : c l ∈ (S : Subgroup (NormalizerAction.Star L)) := by
      change l ∈ A
      rw [ht]
      trivial
    let f : L →* (S : Subgroup (NormalizerAction.Star L)) := c.codRestrict _ hall
    have hf : Function.Injective f := by
      intro x y hxy
      exact hc (congrArg Subtype.val hxy)
    have hp : IsPGroup 2 L := S.isPGroup'.of_injective f hf
    let := hp.isNilpotent
    exact Group.IsPerfect.not_isSolvable L inferInstance

end Theory.GroupTheory
