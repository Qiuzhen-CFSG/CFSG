module

public import Theory.GroupTheory.GeneralizedFitting.SimpleSocleStructure

/-!
# Intermediate groups over a simple generalized Fitting subgroup

If F*(G) is nonabelian simple and G = F*(G)T for a Sylow two-subgroup,
every intermediate H is generated by F*(G) and H intersect T. The restricted
simple subgroup acts faithfully inside H, so the radical and two-core of H
vanish. Its two-group quotient then identifies it with the actual F*(H).

The Chapter E symplectic diagram-kernel reduction uses both identities with
the literal inclusion and quotient maps. No automorphism classification or
model recognition enters these finite-group arguments.

Source: Aschbacher--Smith, E.1.14 hypotheses, printed p.214, together with
the standard generalized Fitting calculus in A.3.3.
-/

public section
open Subgroup
namespace Theory.GroupTheory.SimpleSocle
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- Every intermediate group is supplemented by the intersection with T. -/
theorem intermediate_sylow_supplement (L : Subgroup G) [L.Normal]
    (T : Sylow 2 G) (hLT : L ⊔ (T : Subgroup G) = ⊤)
    (H : Subgroup G) (hLH : L ≤ H) :
    L.subgroupOf H ⊔ (T : Subgroup G).subgroupOf H = ⊤ := by
  apply top_unique
  intro x _
  have hx : (x : G) ∈ L ⊔ (T : Subgroup G) := hLT.symm ▸ mem_top _
  obtain ⟨l, hl, t, ht, he⟩ := Subgroup.mem_sup_of_normal_left.mp hx
  have htH : t ∈ H := by
    have hh : l⁻¹ * (x : G) ∈ H := H.mul_mem (H.inv_mem (hLH hl)) x.property
    rwa [← he, inv_mul_cancel_left] at hh
  have hx' : x = (⟨l, hLH hl⟩ : H) * ⟨t, htH⟩ := Subtype.ext he.symm
  rw [hx']
  exact (L.subgroupOf H ⊔ (T : Subgroup G).subgroupOf H).mul_mem
    ((show L.subgroupOf H ≤ L.subgroupOf H ⊔ (T : Subgroup G).subgroupOf H from le_sup_left) hl)
    ((show (T : Subgroup G).subgroupOf H ≤ L.subgroupOf H ⊔ (T : Subgroup G).subgroupOf H from le_sup_right) ht)

/-- The same simple socle is the intrinsic generalized Fitting subgroup. -/
theorem intermediate_fitting [IsSimpleGroup (generalizedFitting G)]
    (ha : ¬ IsMulCommutative (generalizedFitting G))
    (T : Sylow 2 G) (hLT : generalizedFitting G ⊔ (T : Subgroup G) = ⊤)
    (H : Subgroup G) (hLH : generalizedFitting G ≤ H) :
    generalizedFitting H = (generalizedFitting G).subgroupOf H := by
  let L := generalizedFitting G
  let D := L.subgroupOf H
  let e : D ≃* L := subgroupOfEquivOfLe hLH
  let : IsSimpleGroup D := (MulEquiv.isSimpleGroup_congr e).mpr inferInstance
  let := (SimpleSocle.isComponent ha).2
  let : IsQuasisimple D := IsQuasisimple.of_mulEquiv e.symm
  have hc : centralizer (D : Set H) = ⊥ := by
    apply le_bot_iff.mp
    intro x hx
    have hh : (x : G) ∈ centralizer (L : Set G) := by
      rw [mem_centralizer_iff]
      intro l hl
      exact congrArg Subtype.val (mem_centralizer_iff.mp hx ⟨l, hLH hl⟩ hl)
    rw [SimpleSocle.centralizer_eq_bot ha, mem_bot] at hh
    exact Subtype.ext hh
  have hR := SimpleSocle.radical_eq_bot D hc
  have hQ : IsPGroup 2 (H ⧸ D) := by
    apply Subgroup.quotient_isPGroup_of_sup_eq_top
      ((T : Subgroup G).subgroupOf H) D
      (T.isPGroup'.comap_of_injective H.subtype H.subtype_injective)
    exact (sup_comm _ _).trans (intermediate_sylow_supplement L T hLT H hLH)
  exact generalizedFitting_eq_of_quasisimple_two_quotient D hQ (SimpleSocle.pCore_eq_bot hR 2)

end Theory.GroupTheory.SimpleSocle
