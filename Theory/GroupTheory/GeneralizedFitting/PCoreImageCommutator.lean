module

public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.GroupTheory.PCoreImage
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# Full commutators above a quasisimple prime-core image

Let a finite group G be generated by a normal subgroup K and a supplement E,
with Oᵖ(K) = K. If the actual image of K in G/Oₚ(G) is quasisimple, then
[K,F] = K for every F ≤ Oₚ(E) outside Oₚ(G). No containment Oₚ(G) ≤ E
or simplicity of G is required.

In the quotient, Oₚ(E*) ∩ C(K*) is normalized by E* and centralized by K*,
so it is a normal p-subgroup of G*. Thus an actor outside Oₚ(G) cannot
centralize K*. The component commutator dichotomy gives [K*,F*] = K*.
Lifting makes K/[K,F] a p-group; Oᵖ(K) = K kills that remaining quotient.
Normality of [K,F] is needed only inside K.

Source application: Aschbacher–Smith, *The Classification of Quasithin
Groups*, combined manuscript (1 March 2004), proof of Lemma 13.8.18(1),
printed p.953 (PDF p.970). The argument works for every prime p.
-/

namespace Theory.GroupTheory
open Subgroup

variable {G : Type*} [Group G]

private theorem core_inf_centralizer_le (p : ℕ) (K E : Subgroup G) [K.Normal]
    (hgen : K ⊔ E = ⊤) :
    E.pCoreIn p ⊓ centralizer (K : Set G) ≤ pCore p G := by
  let C := E.pCoreIn p ⊓ centralizer (K : Set G)
  have hKC : K ≤ centralizer (C : Set G) := le_centralizer_iff.mp inf_le_right
  have hEC : E ≤ normalizer (C : Set G) := by
    apply le_trans _ inf_normalizer_le_normalizer_inf
    exact le_inf
      (E.le_normalizer.trans (normalizer_le_normalizer_characteristic_image E (pCore p E)))
      (le_normalizer_of_normal (H := centralizer (K : Set G)))
  have hn : C.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hgen]
    exact sup_le (hKC.trans (centralizer_le_normalizer _)) hEC
  exact le_sSup ⟨hn, (isPGroup_pCoreIn p E).to_le inf_le_left⟩

private theorem quasisimple_commutator (K F : Subgroup G) [K.Normal]
    [IsQuasisimple K] (hne : ⁅K, F⁆ ≠ ⊥) : ⁅K, F⁆ = K := by
  have hK : IsComponent G K := ⟨(inferInstance : K.Normal).isSubnormal, inferInstance⟩
  rcases hK.commutator_dichotomy F with hb | he
  · exact (hne hb).elim
  · exact le_antisymm (commutator_le_left K F)
      ((le_iSup_conjugates K F).trans he.symm.le)

private theorem eq_of_pPerfect_image {p : ℕ} (K C Q : Subgroup G) [Q.Normal]
    (hCK : C ≤ K) (hn : K ≤ normalizer (C : Set G))
    (hQ : IsPGroup p Q) (hK : pResidual p K = ⊤)
    (hmap : C.map (QuotientGroup.mk' Q) = K.map (QuotientGroup.mk' Q)) : C = K := by
  let N := C.subgroupOf K
  let R := Q.subgroupOf K
  let : N.Normal := normal_subgroupOf_of_le_normalizer hn
  have hs : N ⊔ R = ⊤ := by
    apply top_unique
    intro k _
    have hk : QuotientGroup.mk' Q (k : G) ∈ C.map (QuotientGroup.mk' Q) := by
      rw [hmap]
      exact mem_map_of_mem _ k.property
    obtain ⟨c, hc, he⟩ := hk
    have hu : c⁻¹ * (k : G) ∈ Q := by
      apply (QuotientGroup.eq_one_iff _).mp
      change QuotientGroup.mk' Q (c⁻¹ * (k : G)) = 1
      rw [map_mul, map_inv, he, inv_mul_cancel]
    have hprod : (⟨c, hCK hc⟩ : K) *
        ⟨c⁻¹ * (k : G), K.mul_mem (K.inv_mem (hCK hc)) k.property⟩ = k := by
      ext
      simp
    rw [← hprod]
    exact (N ⊔ R).mul_mem ((show N ≤ N ⊔ R from le_sup_left) hc)
      ((show R ≤ N ⊔ R from le_sup_right) hu)
  have he : N = ⊤ := (pResidual_eq_top_iff p K).mp hK N inferInstance
    (isPGroup_quotient_of_sup_eq_top N R hQ.comap_subtype hs)
  exact le_antisymm hCK (subgroupOf_eq_top.mp he)

/-- A subgroup of the supplement's prime core which escapes the ambient prime
core generates the entire p-perfect component preimage by commutators. The
quasisimple group is the actual image under the ambient prime-core quotient. -/
public theorem commutator_eq_left_of_quasisimple_pCore_image [Finite G] (p : ℕ) [Fact p.Prime]
    (K E F : Subgroup G) [K.Normal]
    (hgen : K ⊔ E = ⊤) (hK : pResidual p K = ⊤)
    [IsQuasisimple (K.map (QuotientGroup.mk' (pCore p G)))]
    (hFE : F ≤ E.pCoreIn p) (hF : ¬ F ≤ pCore p G) : ⁅K, F⁆ = K := by
  let q := QuotientGroup.mk' (pCore p G)
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  have hk : IsPGroup p q.ker := by
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hgen' : K.map q ⊔ E.map q = ⊤ := by
    rw [← Subgroup.map_sup, hgen, map_top_of_surjective q hq]
  have hFE' : F.map q ≤ (E.map q).pCoreIn p := by
    rw [← map_pCoreIn_of_ker_isPGroup q hk E]
    exact map_mono hFE
  have hne : ⁅K.map q, F.map q⁆ ≠ ⊥ := by
    intro he
    have hc : F.map q ≤ centralizer (K.map q : Set (G ⧸ pCore p G)) := by
      rw [commutator_comm] at he
      exact commutator_eq_bot_iff_le_centralizer.mp he
    have hle := (le_inf hFE' hc).trans (core_inf_centralizer_le p (K.map q) (E.map q) hgen')
    have hp := map_le_iff_le_comap.mp hle
    rw [q.comap_pCore_of_ker_isPGroup hq hk] at hp
    exact hF hp
  have he : ⁅K, F⁆.map q = K.map q := by
    rw [map_commutator]
    exact quasisimple_commutator (K.map q) (F.map q) hne
  exact eq_of_pPerfect_image K ⁅K, F⁆ (pCore p G)
    (commutator_le_left K F) (normalizer_commutator_ge_left K F) pCore_isPGroup hK he

end Theory.GroupTheory
