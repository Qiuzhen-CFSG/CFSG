module

public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus

/-!
# The layer in a surjective image

Each component maps either trivially or onto a component. Taking the generated
subgroups shows that E(G) maps into E(H). In particular every quotient of a
group generated by its components is again generated by its components.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, A.2.10,
printed p.35, using the standard component image theorem.
-/

public section
namespace Theory.GroupTheory
open Subgroup
variable {G H : Type*} [Group G] [Group H]

/-- A surjection carries the layer into the layer. -/
theorem map_componentLayer_le (f : G →* H) (hf : Function.Surjective f) :
    (componentLayer G).map f ≤ componentLayer H := by
  apply map_le_iff_le_comap.mpr
  apply sSup_le
  intro L hL
  apply map_le_iff_le_comap.mp
  rcases hL.map_surjective f hf with h | h
  · exact h ▸ bot_le
  · exact le_sSup h

/-- A surjective image of a group generated by components has the same property. -/
theorem componentLayer_eq_top_of_surjective (f : G →* H) (hf : Function.Surjective f)
    (hG : componentLayer G = ⊤) : componentLayer H = ⊤ := by
  apply top_unique
  simpa only [hG, ← MonoidHom.range_eq_map, MonoidHom.range_eq_top_of_surjective f hf]
    using map_componentLayer_le f hf

end Theory.GroupTheory
