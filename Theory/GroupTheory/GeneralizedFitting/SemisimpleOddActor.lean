module
public import Theory.GroupTheory.GeneralizedFitting.ComponentLayerStructure
public import Theory.GroupTheory.GeneralizedFitting.TwoQuotient

/-!
# A normal semisimple or odd-prime actor

A normal group generated by components lies in the ambient layer; a
normal odd-prime group lies in the Fitting subgroup. In both cases the
two-core centralizes it, by the component normal-subgroup dichotomy
or the commutator bound for distinct normal prime groups.

Source application: Aschbacher–Smith, D.3.4(5), printed p.194.
-/

public section
open Subgroup
namespace Theory.GroupTheory
theorem twoCore_centralizes_of_normal_layer_or_odd
    {G : Type*} [Group G] [Finite G] (X : Subgroup G) [X.Normal]
    (hshape : componentLayer X = ⊤ ∨ ∃ p : ℕ, p.Prime ∧ Odd p ∧ IsPGroup p X) :
    pCore 2 G ≤ centralizer (X : Set G) := by
  rcases hshape with he | ⟨p, hp, ho, hP⟩
  · apply le_centralizer_iff.mpr
    have hmap : (componentLayer X).map X.subtype = X := by
      rw [he, ← MonoidHom.range_eq_map, range_subtype]
    rw [← hmap]
    apply map_le_iff_le_comap.mpr
    apply sSup_le
    intro C hC
    let := hC.2
    apply map_le_iff_le_comap.mp
    have hc : IsComponent G (C.map X.subtype) :=
      ⟨hC.1.trans' (inferInstance : X.Normal).isSubnormal,
        IsQuasisimple.of_mulEquiv (C.equivMapOfInjective X.subtype X.subtype_injective)⟩
    rcases hc.normal_dichotomy (pCore 2 G) with hle | hn
    · let := hc.2
      let : IsSimpleGroup ((C.map X.subtype) ⧸ center (C.map X.subtype)) := IsQuasisimple.simple
      let : Nontrivial (C.map X.subtype) :=
        (QuotientGroup.mk'_surjective (center (C.map X.subtype))).nontrivial
      let : Group.IsNilpotent (C.map X.subtype) := (pCore_isPGroup.to_le hle).isNilpotent
      exact (Group.IsPerfect.not_isSolvable (C.map X.subtype) inferInstance).elim
    · exact commutator_eq_bot_iff_le_centralizer.mp hn
  · have hd := IsPGroup.disjoint_of_coprime
      (show IsPGroup 2 (pCore 2 G) from pCore_isPGroup) hP ho.coprime_two_left
    exact commutator_eq_bot_iff_le_centralizer.mp
      (le_bot_iff.mp ((commutator_le_inf (pCore 2 G) X).trans_eq hd.eq_bot))

theorem normal_layer_or_odd_le_generalizedFitting
    {G : Type*} [Group G] [Finite G] (X : Subgroup G) [X.Normal]
    (hshape : componentLayer X = ⊤ ∨ ∃ p : ℕ, p.Prime ∧ Odd p ∧ IsPGroup p X) :
    X ≤ generalizedFitting G := by
  rcases hshape with he | ⟨p, hp, _, hP⟩
  · have h := map_componentLayer_subtype_le X (inferInstance : X.Normal).isSubnormal
    rw [he, ← MonoidHom.range_eq_map, range_subtype] at h
    exact h.trans le_sup_right
  · let : Fact p.Prime := ⟨hp⟩
    exact (show X ≤ fittingSubgroup G from le_sSup ⟨inferInstance, hP.isNilpotent⟩).trans
      (fitting_le_generalizedFitting G)


end Theory.GroupTheory
