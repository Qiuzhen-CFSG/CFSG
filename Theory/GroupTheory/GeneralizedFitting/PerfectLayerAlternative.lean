module
public import Theory.GroupTheory.GeneralizedFitting.ComponentLayerStructure
public import Theory.GroupTheory.GeneralizedFitting.CentralizerViaCComponents
public import Theory.GroupTheory.GeneralizedFitting.NilpotentComponentPreimage
/-!
# The layer with trivial Fitting subgroup

A finite nontrivial group with Fitting subgroup one has a nontrivial layer,
by self-centralization of the generalized Fitting subgroup. Every component
is then simple. Either the layer is one such simple component, or it splits
as the product of two commuting nontrivial perfect subgroups: one component
and the subgroup generated by all the others.

This elementary component alternative feeds the actual tensor-form argument
in Aschbacher--Smith G.4.9, printed pp.341--342.
-/

public noncomputable section
open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

/-- A trivial Fitting subgroup forces a nontrivial layer. -/
theorem componentLayer_ne_bot_of_fitting_eq_bot [Nontrivial G] (hfit : fittingSubgroup G=⊥) :
    componentLayer G≠⊥ := by
  intro he
  have hf : generalizedFitting G=⊥ := by simp [generalizedFitting,hfit,he]
  have hc := centralizer_generalizedFitting_le G
  rw [hf] at hc
  have ht : (⊤ : Subgroup G)≤⊥ := by
    intro g _
    apply hc
    intro x hx
    have hx1 : x=1 := hx
    simp [hx1]
  exact top_ne_bot (le_antisymm ht bot_le)

omit [Finite G] in
/-- All components other than a proper chosen component form a nontrivial
perfect commuting supplement in the layer. -/
theorem IsComponent.exists_perfect_complement_in_layer {K : Subgroup G} (hK : IsComponent G K)
    (hk : K ≠ componentLayer G) :
    ∃ B : Subgroup G, Group.IsPerfect B ∧ B≠⊥ ∧
      K⊔B=componentLayer G ∧ K≤centralizer (B:Set G) := by
  classical
  let B : Subgroup G := sSup {D : Subgroup G | IsComponent G D ∧ D≠K}
  have hBE : B≤componentLayer G := sSup_le fun D hD => le_sSup hD.1
  have hgen : K⊔B=componentLayer G := by
    apply le_antisymm (sup_le (show K≤componentLayer G from le_sSup hK) hBE)
    apply sSup_le
    intro D hD
    by_cases he : D=K
    · exact he ▸ le_sup_left
    · exact (show D≤B from le_sSup ⟨hD,he⟩).trans le_sup_right
  have hB : B≠⊥ := by
    intro hb
    exact hk (by simpa [hb] using hgen)
  have hperfect : Group.IsPerfect B := by
    rw [isPerfect_iff]
    apply le_antisymm (commutator_le_self _)
    apply sSup_le
    intro D hD
    let := hD.1.2
    rw [←commutator_eq_self (H:=D)]
    exact commutator_mono (le_sSup hD) (le_sSup hD)
  have hc : K≤centralizer (B:Set G) := by
    apply le_centralizer_iff.mpr
    apply sSup_le
    intro D hD
    exact commutator_eq_bot_iff_le_centralizer.mp (hD.1.commutator_eq_bot_of_ne hK hD.2)
  exact ⟨B,hperfect,hB,hgen,hc⟩
end Theory.GroupTheory
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]
/-- The ambient Fitting subgroup absorbs the center of every component. -/
theorem IsComponent.simple_of_fitting_eq_bot {K : Subgroup G} (hK : IsComponent G K)
    (hfit : fittingSubgroup G=⊥) : IsSimpleGroup K := by
  have hz : center K=⊥ := by
    apply (map_eq_bot_iff_of_injective _ K.subtype_injective).mp
    exact le_bot_iff.mp (hfit ▸ hK.center_map_le_fitting)
  let : IsQuasisimple K := hK.2
  let : IsSimpleGroup (K ⧸ center K) := IsQuasisimple.simple
  exact ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).symm.isSimpleGroup

/-- A Fitting-free layer is simple, or is generated by two commuting
nontrivial perfect subgroups. -/
theorem componentLayer_simple_or_commuting_perfect [Nontrivial G] (hfit : fittingSubgroup G=⊥) :
    (IsComponent G (componentLayer G) ∧ IsSimpleGroup (componentLayer G)) ∨
    ∃ A B : Subgroup G, Group.IsPerfect A ∧ Group.IsPerfect B ∧ A≠⊥ ∧ B≠⊥ ∧
      A⊔B=componentLayer G ∧ A≤centralizer (B:Set G) := by
  classical
  have hE := componentLayer_ne_bot_of_fitting_eq_bot hfit
  have hex : ∃ K : Subgroup G, IsComponent G K := by
    by_contra! hh
    exact hE (sSup_eq_bot.mpr fun K hK => (hh K hK).elim)
  obtain ⟨K,hK⟩ := hex
  by_cases he : K=componentLayer G
  · left
    exact ⟨he ▸ hK,he ▸ IsComponent.simple_of_fitting_eq_bot hK hfit⟩
  · right
    obtain ⟨B,hB,hbn,hgen,hc⟩ := IsComponent.exists_perfect_complement_in_layer hK he
    let : IsQuasisimple K := hK.2
    have hkn : K≠⊥ := by
      intro hk
      have : Nontrivial K := by
        let : IsSimpleGroup (K ⧸ center K) := IsQuasisimple.simple
        exact (QuotientGroup.mk'_surjective (center K)).nontrivial
      exact (nontrivial_iff_ne_bot K).mp this hk
    exact ⟨K,B,inferInstance,hB,hkn,hbn,hgen,hc⟩
end Theory.GroupTheory
