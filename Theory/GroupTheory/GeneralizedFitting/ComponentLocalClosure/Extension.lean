module

public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.PGroupCore
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Characteristic p in extensions by p-groups

Suppose N is normal in G, its p-core is self-centralizing in N, and G/N is
a p-group. The image R of the p-core of N is normal in G. Its centralizer C
has C ∩ N contained in R and p-group image in G/N. Thus C is a normal
p-subgroup, proving that the p-core of G is self-centralizing.

For the subgroup generated by K and A, the join of the A-conjugates of K
is normal, and the quotient is an image of A. These two facts provide the
extension step in the component-orbit construction used for
Aschbacher–Smith 2.3.9(7), printed pp.525–526.
-/

public section

open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G]

/-- Characteristic p is preserved by extensions with a p-group upper quotient. -/
theorem centralizer_pCore_le_of_normal_pGroup_quotient
    {p : ℕ} (N : Subgroup G) [N.Normal]
    (hN : centralizer (pCore p N : Set N) ≤ pCore p N)
    (hq : IsPGroup p (G ⧸ N)) :
    centralizer (pCore p G : Set G) ≤ pCore p G := by
  let R := (pCore p N).map N.subtype
  have hRp : IsPGroup p R := pCore_isPGroup.map N.subtype
  have hRcore : R ≤ pCore p G := le_sSup ⟨inferInstance, hRp⟩
  let C := centralizer (R : Set G)
  have hCN : C ⊓ N ≤ R := by
    rintro x ⟨hc, hn⟩
    have hx : (⟨x, hn⟩ : N) ∈ pCore p N := by
      apply hN
      rw [mem_centralizer_iff]
      intro y hy
      apply Subtype.ext
      exact mem_centralizer_iff.mp hc y (mem_map_of_mem N.subtype hy)
    exact ⟨⟨x, hn⟩, hx, rfl⟩
  have hCp : IsPGroup p C := by
    intro c
    obtain ⟨n, hn⟩ := hq (QuotientGroup.mk' N (c : G))
    have hcN : (c : G) ^ p ^ n ∈ N := by
      apply (QuotientGroup.eq_one_iff _).mp
      change QuotientGroup.mk' N ((c : G) ^ p ^ n) = 1
      rw [map_pow]
      exact hn
    have hcR : (c : G) ^ p ^ n ∈ R :=
      hCN ⟨C.pow_mem c.property _, hcN⟩
    obtain ⟨m, hm⟩ := hRp ⟨_, hcR⟩
    refine ⟨n + m, ?_⟩
    apply Subtype.ext
    change (c : G) ^ p ^ (n + m) = 1
    rw [pow_add, pow_mul]
    exact congrArg Subtype.val hm
  exact (centralizer_le hRcore).trans (le_sSup ⟨inferInstance, hCp⟩)

/-- The quotient by the conjugate orbit is generated by the image of the actor. -/
theorem componentOrbit_quotient_isPGroup {p : ℕ} (K A : Subgroup G)
    (hA : IsPGroup p A) :
    let N := (componentOrbit K A).subgroupOf (K ⊔ A)
    letI := componentOrbit_normal_subgroupOf_sup K A
    IsPGroup p ((K ⊔ A : Subgroup G) ⧸ N) := by
  let X := K ⊔ A
  let N := (componentOrbit K A).subgroupOf X
  let : N.Normal := componentOrbit_normal_subgroupOf_sup K A
  let B := A.subgroupOf X
  let q := QuotientGroup.mk' N
  have htop : K.subgroupOf X ⊔ B = ⊤ := by
    apply (Subgroup.map_injective X.subtype_injective)
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le (show K ≤ X from le_sup_left),
      map_subgroupOf_eq_of_le (show A ≤ X from le_sup_right),
      ← MonoidHom.range_eq_map, range_subtype]
  have hKN : K.subgroupOf X ≤ N := by
    intro x hx
    exact le_componentOrbit K A hx
  have hNB : N ⊔ B = ⊤ := top_unique (htop.symm.le.trans (sup_le_sup_right hKN B))
  have hNq : N.map q = ⊥ := by
    apply (map_eq_bot_iff N).mpr
    exact (QuotientGroup.ker_mk' N).symm.le
  have hBq : B.map q = ⊤ := by
    have he := congrArg (Subgroup.map q) hNB
    rw [Subgroup.map_sup, hNq, bot_sup_eq,
      map_top_of_surjective q (QuotientGroup.mk'_surjective N)] at he
    exact he
  have hp : IsPGroup p (B.map q) := hA.comap_subtype.map q
  rw [hBq] at hp
  exact hp.of_equiv topEquiv

end Theory.GroupTheory

end
