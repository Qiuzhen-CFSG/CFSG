module

public import Theory.GroupTheory.Fitting.Core
public import Theory.GroupTheory.Covering

/-!
# Components and the generalized Fitting subgroup

A component is a subnormal quasisimple subgroup. The layer is generated by
the components, and F*(G) is the join of the layer with F(G). These are
intrinsic definitions; no commutation or classification theorem is assumed.

Source: standard finite-group notation, as used in Aschbacher–Smith C.1.7.
-/

@[expose] public section

namespace Theory.GroupTheory

variable (G : Type*) [Group G]

/-- A component of G. -/
def IsComponent (K : Subgroup G) : Prop := K.IsSubnormal ∧ IsQuasisimple K

/-- E(G), generated by all components. -/
def componentLayer : Subgroup G := sSup {K : Subgroup G | IsComponent G K}

/-- The generalized Fitting subgroup F*(G) = F(G)E(G). -/
def generalizedFitting : Subgroup G := fittingSubgroup G ⊔ componentLayer G

theorem fitting_le_generalizedFitting : fittingSubgroup G ≤ generalizedFitting G :=
  le_sup_left

theorem component_le_generalizedFitting (K : Subgroup G) (hK : IsComponent G K) :
    K ≤ generalizedFitting G :=
  (show K ≤ componentLayer G from le_sSup hK).trans le_sup_right

end Theory.GroupTheory

end
