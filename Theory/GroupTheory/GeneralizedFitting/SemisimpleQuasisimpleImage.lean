module

public import Theory.GroupTheory.GeneralizedFitting.ComponentProductCenters
public import Theory.GroupTheory.PerfectCentralCoverQuasisimple

/-!
# Quasisimple images of a semisimple group

A surjection from a group generated by components onto a quasisimple group
is already surjective on one component. Its center therefore maps onto the
target center. In particular an odd source center forces an odd target center.
This avoids choosing direct-product coordinates for the source layer.

Source: the component-image calculus, used in the noncentral-core reduction
of Aschbacher–Smith A.2.12, printed pp.35–36.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G H : Type*} [Group G] [Group H] [Finite G] [Finite H]

omit [Finite G] [Finite H] in
theorem exists_component_surjective_of_semisimple [IsQuasisimple H]
    (hG : componentLayer G = ⊤) (f : G →* H) (hf : Function.Surjective f) :
    ∃ C : Subgroup G, IsComponent G C ∧ Function.Surjective (f.comp C.subtype) := by
  let : IsSimpleGroup (H ⧸ center H) := IsQuasisimple.simple
  let : Nontrivial H := (QuotientGroup.mk'_surjective (center H)).nontrivial
  have hex : ∃ C : Subgroup G, IsComponent G C ∧ C.map f ≠ ⊥ := by
    by_contra! hh
    have hker : componentLayer G ≤ f.ker :=
      sSup_le fun C hC => (map_eq_bot_iff C).mp (hh C hC)
    have htop : f.ker = ⊤ := top_unique (hG ▸ hker)
    obtain ⟨y, hy⟩ := exists_ne (1 : H)
    obtain ⟨x, rfl⟩ := hf y
    exact hy (MonoidHom.mem_ker.mp (htop ▸ mem_top x))
  obtain ⟨C, hC, hn⟩ := hex
  have hCmap := (hC.map_surjective f hf).resolve_left hn
  have htop : IsComponent H (⊤ : Subgroup H) :=
    ⟨(inferInstance : (⊤ : Subgroup H).Normal).isSubnormal,
      IsQuasisimple.of_mulEquiv (topEquiv : (⊤ : Subgroup H) ≃* H).symm⟩
  have hm : C.map f = ⊤ := hCmap.eq_of_le htop le_top
  refine ⟨C, hC, ?_⟩
  rw [← MonoidHom.range_eq_top]
  simpa only [MonoidHom.range_comp, range_subtype] using hm

theorem odd_center_of_quasisimple_image_of_semisimple [IsQuasisimple H]
    (hG : componentLayer G = ⊤) (ho : Odd (Nat.card (center G)))
    (f : G →* H) (hf : Function.Surjective f) : Odd (Nat.card (center H)) := by
  obtain ⟨C, hC, hc⟩ := exists_component_surjective_of_semisimple hG f hf
  let := hC.2
  let c : Covering C H := { toMonoidHom := f.comp C.subtype, surjective := hc }
  let c' := PerfectCentralCovering.ofCovering c
  have hm : (center C).map c'.toMonoidHom = center H := by
    rw [← c'.comap_center]
    exact map_comap_eq_self_of_surjective c'.surjective _
  have hd : Nat.card (center C) ∣ Nat.card (center G) := by
    have hh := card_dvd_of_le (hC.center_map_le_center_of_semisimple hG)
    rwa [card_map_of_injective C.subtype_injective] at hh
  have hd' : Nat.card (center H) ∣ Nat.card (center C) := by
    rw [← hm]
    exact (center C).card_map_dvd c'.toMonoidHom
  exact ho.of_dvd_nat (hd'.trans hd)

end Theory.GroupTheory
