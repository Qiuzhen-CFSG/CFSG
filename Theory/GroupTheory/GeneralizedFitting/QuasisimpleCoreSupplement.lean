module

public import Theory.GroupTheory.GeneralizedFitting.QuasisimpleTwoQuotient
public import Theory.GroupTheory.NormalSubgroupCoreQuotient
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.GroupTheory.GeneralizedFitting.SelfCentralizing

/-!
# The generalized Fitting subgroup of a two-group supplement

Let K be normal in a finite group generated by K and a two-subgroup S.
If K/O₂(K) is quasisimple, its image in G/O₂(G) is the full generalized
Fitting subgroup. The quotient above that subgroup is a two-group.
The image identification uses restriction of the ambient two-core to K;
it does not assume that K is normal in any larger ambient group.

This is the quotient calculation needed to apply the outer-two-group
version of Aschbacher--Smith E.5.4 in the group KS in 5.1.20 (p.644).
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

/-- The literal normal image is F* after quotienting by the ambient two-core. -/
theorem generalizedFitting_coreQuotient_eq_of_two_supplement
    (K S : Subgroup G) [K.Normal] [IsQuasisimple (K ⧸ pCore 2 K)]
    (hS : IsPGroup 2 S) (hgen : K ⊔ S = ⊤) :
    generalizedFitting (G ⧸ pCore 2 G) =
      K.map (QuotientGroup.mk' (pCore 2 G)) := by
  let q := QuotientGroup.mk' (pCore 2 G)
  have hq := QuotientGroup.mk'_surjective (pCore 2 G)
  let B := K.map q
  let : B.Normal := Subgroup.Normal.map inferInstance q hq
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv (coreQuotientEquivImage 2 K)
  have hquot : IsPGroup 2 ((G ⧸ pCore 2 G) ⧸ B) :=
    isPGroup_quotient_of_sup_eq_top B (S.map q) (hS.map q) (by
      rw [← Subgroup.map_sup, hgen, map_top_of_surjective q hq])
  exact generalizedFitting_eq_of_quasisimple_two_quotient B hquot
    (pCore_quotient_pCore_eq_bot 2)

/-- Quasisimplicity and the outer two-group condition follow from generation;
neither is an additional assumption on the ambient core quotient. -/
theorem quasisimple_and_outer_two_group_of_two_supplement
    (K S : Subgroup G) [K.Normal] [IsQuasisimple (K ⧸ pCore 2 K)]
    (hS : IsPGroup 2 S) (hgen : K ⊔ S = ⊤) :
    IsQuasisimple (generalizedFitting (G ⧸ pCore 2 G)) ∧
      IsPGroup 2 ((G ⧸ pCore 2 G) ⧸ generalizedFitting (G ⧸ pCore 2 G)) := by
  have he := generalizedFitting_coreQuotient_eq_of_two_supplement K S hS hgen
  let q := QuotientGroup.mk' (pCore 2 G)
  have hq := QuotientGroup.mk'_surjective (pCore 2 G)
  let : (K.map q).Normal := Subgroup.Normal.map inferInstance q hq
  have hquot := isPGroup_quotient_of_sup_eq_top (K.map q) (S.map q) (hS.map q) (by
    rw [← Subgroup.map_sup, hgen, map_top_of_surjective q hq])
  exact ⟨IsQuasisimple.of_mulEquiv ((coreQuotientEquivImage 2 K).trans
    (MulEquiv.subgroupCongr he.symm)),
    hquot.of_equiv (QuotientGroup.quotientMulEquivOfEq he.symm)⟩

end Theory.GroupTheory
