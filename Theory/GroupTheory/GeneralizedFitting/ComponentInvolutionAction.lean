module

public import Theory.GroupTheory.GeneralizedFitting.ComponentExclusion
public import Theory.GroupTheory.Commutator.CentralizingComplement

/-!
# Components moved by an element with a characteristic-two centralizer

A component cannot centralize an element whose centralizer has a
self-centralizing two-core. If the element normalizes the component,
the full component is generated by the commutators. A central supplement
then transfers this generation to any subgroup containing the element
modulo that supplement.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 13.6.6, printed pp.926–927. The normalizer hypotheses are
explicit; they require separate Sylow or component-structure arguments.
-/

public section
namespace Theory.GroupTheory
open Subgroup
variable {H : Type*} [Group H] [Finite H] {K : Subgroup H}

omit [Finite H] in
/-- An element centralizing modulo a central subgroup a noncentral
element of K must normalize K: distinct components commute. This is
the precise witness needed when using a Sylow center modulo a central line. -/
theorem IsComponent.normalizes_of_noncentral_element
    (hK : IsComponent H K) (Z : Subgroup H) [Z.Normal] (hZ : Z ≤ center H)
    (a b : H) (hbK : b ∈ K) (hb : b ∉ centralizer (K : Set H))
    (hab : Commute (QuotientGroup.mk' Z a) (QuotientGroup.mk' Z b)) :
    a ∈ normalizer (K : Set H) := by
  by_contra ha
  have hne : K.map (MulAut.conj a).toMonoidHom ≠ K :=
    fun he => ha (mem_normalizer_iff_map_conj_eq.mpr he)
  have hKC : K.map (MulAut.conj a).toMonoidHom ≤ centralizer (K : Set H) :=
    commutator_eq_bot_iff_le_centralizer.mp ((hK.map_conj a).commutator_eq_bot_of_ne hK hne)
  have hy : a * b * a⁻¹ ∈ centralizer (K : Set H) := hKC (mem_map_of_mem _ hbK)
  have hd : a * b * a⁻¹ / b ∈ Z := by
    apply QuotientGroup.eq_iff_div_mem.mp
    change QuotientGroup.mk' Z (a * b * a⁻¹) = QuotientGroup.mk' Z b
    rw [map_mul, map_mul, map_inv, hab.eq, mul_inv_cancel_right]
  have hdC := (hZ.trans (center_le_centralizer (K : Set H))) hd
  have hm := (centralizer (K : Set H)).mul_mem
    ((centralizer (K : Set H)).inv_mem hdC) hy
  apply hb
  simpa only [div_eq_mul_inv, mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel_left,
    mul_inv_cancel, mul_one] using hm

theorem IsComponent.not_centralizes_of_twoCore_centralizer
    (hK : IsComponent H K) (a : H)
    (hC : centralizer (pCore 2 (centralizer ({a} : Set H)) :
      Set (centralizer ({a} : Set H))) ≤ pCore 2 (centralizer ({a} : Set H))) :
    a ∉ centralizer (K : Set H) := by
  intro ha
  have hKC : K ≤ centralizer ({a} : Set H) := by
    intro k hk
    exact mem_centralizer_singleton_iff.mpr (mem_centralizer_iff.mp ha k hk)
  exact not_isComponent_of_twoCore hC _ (hK.subgroupOf hKC)

theorem IsComponent.commutator_eq_self_of_twoCore_centralizer
    (hK : IsComponent H K) (a : H) (ha : a ∈ normalizer (K : Set H))
    (hC : centralizer (pCore 2 (centralizer ({a} : Set H)) :
      Set (centralizer ({a} : Set H))) ≤ pCore 2 (centralizer ({a} : Set H))) :
    ⁅K, zpowers a⁆ = K := by
  rcases hK.commutator_dichotomy (zpowers a) with he | he
  · have hh : a ∈ centralizer (K : Set H) :=
      (commutator_eq_bot_iff_le_centralizer.mp
        ((commutator_comm _ _).trans he)) (mem_zpowers _)
    exact (hK.not_centralizes_of_twoCore_centralizer a hC hh).elim
  · exact le_antisymm
      (le_normalizer_iff_commutator_le_left.mp (zpowers_le.mpr ha))
      ((le_iSup_conjugates K (zpowers a)).trans he.symm.le)

omit [Finite H] in
/-- The central supplement is removed from the actor, while keeping the
literal commutator subgroup. -/
theorem commutator_eq_self_of_central_supplement (D Z : Subgroup H) (z : H)
    (hD : D ≤ normalizer (K : Set H))
    (hZ : Z ≤ centralizer (K : Set H)) (hz : z ∈ Z ⊔ D)
    (hKz : ⁅K, zpowers z⁆ = K) : ⁅K, D⁆ = K := by
  apply le_antisymm (le_normalizer_iff_commutator_le_left.mp hD)
  calc
    K = ⁅K, zpowers z⁆ := hKz.symm
    _ ≤ ⁅K, Z ⊔ D⁆ := commutator_mono le_rfl (zpowers_le.mpr hz)
    _ = ⁅K, D⁆ := (commutator_eq_of_centralizing_sup rfl hZ hD).symm

end Theory.GroupTheory
