module

public import Theory.GroupTheory.GeneralizedFitting.DirectPowerComponents
public import Theory.GroupTheory.GeneralizedFitting.RelativeComponent
public import Theory.GroupTheory.ChiefFactorDirectPower

/-!
# Components of a nonabelian minimal normal subgroup

A finite nonabelian minimal normal subgroup is a power of a nonabelian simple
group. The coordinate projection theorem for components identifies each actual
component with the simple factor, so its center is trivial. A coordinate factor
also gives a nontrivial component. The layer is characteristic, hence chief
minimality makes it the whole subgroup. Consequently ambient containment can be
checked on the actual components.

Source: the chief-factor direct-power theorem, Aschbacher (1986), 8.2, as used
in Aschbacher--Smith, *The Classification of Quasithin Groups*, combined manuscript
of 1 March 2004, E.1.10(5) and E.1.11, printed pp.211--213.
-/

public section

open Subgroup Theory.GroupTheory
open scoped IsMulCommutative

namespace ChiefFactor
variable {G : Type*} [Group G] [Finite G] {X : Subgroup G}

private theorem exists_nonabelian_simple_power (hX : IsChief X ⊥)
    (hna : ¬ IsMulCommutative X) :
    ∃ S : Subgroup X, IsSimpleGroup S ∧ ¬ IsMulCommutative S ∧
      ∃ m : ℕ, 0 < m ∧ Nonempty (X ≃* (Fin m → S)) := by
  let _ := hX.normal_upper
  let _ : Nontrivial X := X.nontrivial_iff_ne_bot.mpr (ne_of_gt hX.lt)
  have hchar := characteristic_eq_bot_or_top_of_minimal_normal X
    (fun N hn hNX => hX.minimal N hn bot_le hNX)
  obtain ⟨S, hS, m, hm, ⟨e⟩⟩ := CharacteristicallySimple.exists_simple_subgroup_power hchar
  refine ⟨S, hS, ?_, m, hm, ⟨e⟩⟩
  intro h
  let _ := h
  apply hna
  apply isMulCommutative_iff.mpr
  intro x y
  apply e.injective
  simp only [map_mul, mul_comm]

private theorem simple_center {S : Type*} [Group S] [IsSimpleGroup S]
    (hna : ¬ IsMulCommutative S) : center S = ⊥ :=
  (IsSimpleGroup.eq_bot_or_eq_top_of_normal (center S) inferInstance).resolve_right
    (fun ht => hna (center_eq_top_iff.mp ht))

/-- An actual component of a nonabelian minimal normal subgroup is centerless. -/
theorem IsChief.component_center_eq_bot (hX : IsChief X ⊥)
    (hna : ¬ IsMulCommutative X) {J : Subgroup G} (hJ : IsComponentIn J X) :
    center J = ⊥ := by
  obtain ⟨S, hS, hSnc, m, hm, ⟨e⟩⟩ := exists_nonabelian_simple_power hX hna
  let _ := hS
  obtain ⟨eB⟩ := (hJ.2.map_equiv e).equiv_factor_of_directPower (simple_center hSnc)
  let eJ := (subgroupOfEquivOfLe hJ.1).symm.trans
    ((e.subgroupMap (J.subgroupOf X)).trans eB)
  apply eq_bot_iff.mpr
  intro j hj
  have hz : eJ j ∈ center S := (centerCongr eJ ⟨j, hj⟩).property
  rw [simple_center hSnc, mem_bot] at hz
  exact mem_bot.mpr (eJ.injective (hz.trans eJ.map_one.symm))

/-- The ordinary components of a nonabelian chief subgroup are genuinely simple. -/
theorem IsChief.component_isSimple (hX : IsChief X ⊥)
    (hna : ¬ IsMulCommutative X) {J : Subgroup G} (hJ : IsComponentIn J X) :
    IsSimpleGroup J := by
  let _ := hJ.quasisimple
  let _ : IsSimpleGroup (J ⧸ center J) := IsQuasisimple.simple
  exact (MulEquiv.isSimpleGroup_congr
    ((QuotientGroup.quotientMulEquivOfEq (hX.component_center_eq_bot hna hJ)).trans
      QuotientGroup.quotientBot)).mp inferInstance

private theorem layer_characteristic (H : Type*) [Group H] :
    (componentLayer H).Characteristic := by
  apply characteristic_iff_map_le.mpr
  intro e
  apply map_le_iff_le_comap.mpr
  apply sSup_le
  intro K hK
  exact map_le_iff_le_comap.mp (le_sSup (hK.map_equiv e))

/-- A nonabelian minimal normal subgroup is generated by its ordinary components. -/
theorem IsChief.componentLayer_eq_top (hX : IsChief X ⊥)
    (hna : ¬ IsMulCommutative X) : componentLayer X = ⊤ := by
  let _ := hX.normal_upper
  obtain ⟨S, hS, hSnc, m, hm, ⟨e⟩⟩ := exists_nonabelian_simple_power hX hna
  let _ := hS
  let _ : Group.IsPerfect S := ⟨
    (IsSimpleGroup.eq_bot_or_eq_top_of_normal (_root_.commutator S) inferInstance).resolve_left
      (fun h => hSnc ((commutator_eq_bot_iff S).mp h))⟩
  let _ : IsQuasisimple S := ⟨
    ((QuotientGroup.quotientMulEquivOfEq (simple_center hSnc)).trans
      QuotientGroup.quotientBot).isSimpleGroup⟩
  let i : Fin m := ⟨0, hm⟩
  let f : S →* (Fin m → S) := MonoidHom.mulSingle (fun _ : Fin m => S) i
  have hf : Function.Injective f := by
    intro a b hab
    simpa [f] using congrFun hab i
  have hn : f.range.Normal := by
    constructor
    rintro x ⟨a, rfl⟩ g
    refine ⟨g i * a * (g i)⁻¹, ?_⟩
    ext j
    by_cases hj : j = i
    · subst j
      simp [f]
    · simp [f, Pi.mulSingle_eq_of_ne hj]
  have hcomp : IsComponent (Fin m → S) f.range :=
    ⟨hn.isSubnormal, IsQuasisimple.of_mulEquiv (MonoidHom.ofInjective hf)⟩
  have hK := hcomp.map_equiv e.symm
  have hKne : f.range.map e.symm.toMonoidHom ≠ ⊥ := by
    intro h
    have hr : f.range = ⊥ := (map_eq_bot_iff_of_injective _ e.symm.injective).mp h
    have hs : Subsingleton f.range := hr ▸ inferInstanceAs (Subsingleton (⊥ : Subgroup (Fin m → S)))
    have : Subsingleton S := (MonoidHom.ofInjective hf).injective.subsingleton
    exact not_subsingleton S this
  have hchar := characteristic_eq_bot_or_top_of_minimal_normal X
    (fun N hn hNX => hX.minimal N hn bot_le hNX) _ (layer_characteristic X)
  apply hchar.resolve_left
  intro hbot
  exact hKne (bot_unique ((show f.range.map e.symm.toMonoidHom ≤ componentLayer X from
    le_sSup hK).trans hbot.le))

/-- Ambient containment can be checked on each component of a nonabelian chief subgroup. -/
theorem IsChief.le_of_components_le (hX : IsChief X ⊥) (hna : ¬ IsMulCommutative X)
    (M : Subgroup G) (hM : ∀ J : Subgroup G, IsComponentIn J X → J ≤ M) : X ≤ M := by
  have h : componentLayer X ≤ M.subgroupOf X := by
    apply sSup_le
    intro K hK
    have hK' : IsComponentIn (K.map X.subtype) X := by
      refine ⟨map_subtype_le K, ?_⟩
      have he : (K.map X.subtype).subgroupOf X = K :=
        comap_map_eq_self (by rw [X.ker_subtype]; exact bot_le)
      rw [he]
      exact hK
    exact map_le_iff_le_comap.mp (hM _ hK')
  rw [hX.componentLayer_eq_top hna] at h
  exact subgroupOf_eq_top.mp (top_unique h)
end ChiefFactor
