module

public import Theory.GroupTheory.GeneralizedFitting.SylowCentralizerSchreier
public import Theory.GroupTheory.CComponent.QuasisimpleFactors
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.GroupTheory.PrimeCyclicCentralizer

/-!
# Selecting a component moved by a prime subgroup

If a nontrivial p-subgroup centralizes the Fitting subgroup of a finite
group with trivial p-core, it must move an ordinary component. Otherwise
it centralizes F*, whose centralizer is normal abelian and lies in F.
A p-subgroup of F lies in O_p, giving a contradiction.

For p = 2, centralizing a Sylow subgroup forces normalization of each
component with even simple quotient. The component commutator dichotomy
then gives the full component. We also lift the selected component through
the actual two-core quotient, retaining its exact image.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), the opening
component reduction in the proof of 12.6.26, printed p.832; the general
component and generalized-Fitting calculus of A.3.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

/-- The centralizer of F* lies in F, not merely in F*. -/
theorem centralizer_generalizedFitting_le_fitting :
    centralizer (generalizedFitting G : Set G) ≤ fittingSubgroup G := by
  let C := centralizer (generalizedFitting G : Set G)
  have hc : C ≤ centralizer (C : Set G) := by
    intro x hx y hy
    exact hx y (centralizer_generalizedFitting_le G hy)
  let : IsMulCommutative C := le_centralizer_iff_isMulCommutative.mp hc
  let : CommGroup C := IsMulCommutative.instCommGroup
  exact le_sSup ⟨inferInstance, inferInstance⟩

/-- A nontrivial p-subgroup centralizing F moves some component if O_p is trivial. -/
theorem exists_component_moved_of_centralizes_fitting (p : ℕ) [Fact p.Prime]
    (A : Subgroup G) (hA : IsPGroup p A) (hne : A ≠ ⊥)
    (hcore : pCore p G = ⊥)
    (hF : A ≤ centralizer (fittingSubgroup G : Set G)) :
    ∃ K : Subgroup G, IsComponent G K ∧ ⁅K, A⁆ ≠ ⊥ := by
  by_contra! hn
  have hE : componentLayer G ≤ centralizer (A : Set G) := by
    apply sSup_le
    intro K hK
    exact commutator_eq_bot_iff_le_centralizer.mp (hn K hK)
  have hAF : A ≤ centralizer (generalizedFitting G : Set G) := by
    apply le_centralizer_iff.mpr
    exact sup_le (le_centralizer_iff.mp hF) hE
  have hAC := le_pCore_of_le_fitting A hA
    (hAF.trans centralizer_generalizedFitting_le_fitting)
  exact hne (le_bot_iff.mp (hAC.trans hcore.le))

/-- Centralizing an ambient Sylow two-subgroup normalizes a component with
even simple quotient. The component itself need not be centerless. -/
theorem IsComponent.centralizes_sylow_normalizes {K A : Subgroup G}
    (hK : IsComponent G K) (S : Sylow 2 G)
    (heven : 2 ∣ Nat.card (K ⧸ center K))
    (hA : A ≤ centralizer (S : Set G)) : A ≤ normalizer (K : Set G) := by
  obtain ⟨T, hT⟩ := S.exists_subgroupOf_eq_of_subnormal K hK.1
  have hTS : (T : Subgroup K).map K.subtype ≤ (S : Subgroup G) := by
    rintro _ ⟨t, ht, rfl⟩
    rw [hT] at ht
    exact ht
  exact (hA.trans (centralizer_le hTS)).trans
    (hK.centralizer_sylow_le_normalizer T heven)

omit [Finite G] in
/-- A normalized component which is moved is generated by the commutators. -/
theorem IsComponent.commutator_eq_self_of_normalizes {K A : Subgroup G}
    (hK : IsComponent G K) (hn : A ≤ normalizer (K : Set G))
    (hm : ⁅K, A⁆ ≠ ⊥) : ⁅K, A⁆ = K := by
  rcases hK.commutator_dichotomy A with hb | he
  · exact (hm hb).elim
  · exact le_antisymm (le_normalizer_iff_commutator_le_left.mp hn)
      ((le_iSup_conjugates K A).trans he.symm.le)

/-- Select in G/O₂(G), then lift to a C-component of G without changing
the quotient map or the selected component image. -/
theorem exists_cComponent_moved_in_twoCore_quotient (A : Subgroup G)
    (hA : IsPGroup 2 A)
    (hne : A.map (QuotientGroup.mk' (pCore 2 G)) ≠ ⊥)
    (hF : A.map (QuotientGroup.mk' (pCore 2 G)) ≤
      centralizer (fittingSubgroup (G ⧸ pCore 2 G) : Set (G ⧸ pCore 2 G))) :
    ∃ K : Subgroup G, K.IsCComponent ∧
      IsComponent (G ⧸ pCore 2 G) (K.map (QuotientGroup.mk' (pCore 2 G))) ∧
      ⁅K.map (QuotientGroup.mk' (pCore 2 G)),
        A.map (QuotientGroup.mk' (pCore 2 G))⁆ ≠ ⊥ := by
  let : Group.IsNilpotent (pCore 2 G) := pCore_isNilpotent
  obtain ⟨J, hJ, hm⟩ := exists_component_moved_of_centralizes_fitting 2
    (A.map (QuotientGroup.mk' (pCore 2 G))) (hA.map _) hne
    (pCore_quotient_pCore_eq_bot 2) hF
  obtain ⟨K, hK, he⟩ := hJ.isCComponent.exists_map_quotient_eq (pCore 2 G)
  exact ⟨K, hK, he.symm ▸ hJ, he.symm ▸ hm⟩

end Theory.GroupTheory
