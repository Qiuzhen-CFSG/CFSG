module

public import Theory.GroupTheory.GeneralizedFitting.SemisimpleCenter
public import Theory.GroupTheory.GeneralizedFitting.NilpotentComponentPreimage
public import Theory.GroupTheory.PerfectNormalizerLift

/-!
# Lifting semisimple groups through perfect central covers

In a perfect central cover of a group generated by components, the source
Fitting subgroup is central. The solvable residual of each literal component
preimage is then quasisimple and subnormal. These lifted components map onto
the target layer; perfect lifting across the central kernel shows that they
generate the whole source group.

Source: the central-cover step of Aschbacher–Smith A.2.11, printed p.35,
using the ordinary component and solvable-residual calculus.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace PerfectCentralCovering
variable {G H : Type*} [Group G] [Group H] [Finite G] [Finite H]

theorem Cover.fitting_le_center_of_semisimple (f : Cover G H)
    (hH : componentLayer H = ⊤) : fittingSubgroup G ≤ center G := by
  rw [← f.comap_center]
  apply map_le_iff_le_comap.mp
  rw [← fittingSubgroup_eq_center_of_componentLayer_eq_top hH]
  exact le_sSup ⟨Normal.map inferInstance f.toMonoidHom f.surjective,
    Group.nilpotent_of_surjective (f.toMonoidHom.subgroupMap _)
      (f.toMonoidHom.subgroupMap_surjective _)⟩

theorem Cover.exists_component_lift_of_semisimple (f : Cover G H)
    (hH : componentLayer H = ⊤) {L : Subgroup H} (hL : IsComponent H L) :
    ∃ C : Subgroup G, IsComponent G C ∧ C.map f.toMonoidHom = L := by
  let : IsMulCommutative f.toMonoidHom.ker := ⟨⟨fun a b =>
    Subtype.ext ((mem_center_iff.mp (f.ker_le_center a.property) b).symm)⟩⟩
  obtain ⟨hC, hm⟩ := cComponent_residual_preimage f.toMonoidHom f.surjective hL.isCComponent
  refine ⟨_, ⟨hC.subnormal, hC.isQuasisimple_of_fitting_centralizes ?_⟩, hm⟩
  exact (f.fitting_le_center_of_semisimple hH).trans (center_le_centralizer _)

theorem Cover.semisimple (f : Cover G H) (hH : componentLayer H = ⊤) :
    componentLayer G = ⊤ := by
  let := f.isPerfect
  have hmap : (componentLayer G).map f.toMonoidHom = ⊤ := by
    apply top_unique
    rw [← hH]
    apply sSup_le
    intro L hL
    obtain ⟨C, hC, hCL⟩ := f.exists_component_lift_of_semisimple hH hL
    rw [← hCL]
    exact map_mono (le_sSup hC)
  apply top_unique
  apply Subgroup.le_of_map_le_of_perfect f.toMonoidHom f.ker_le_center ⊤
    (componentLayer G)
  rw [hmap]
  exact le_top
end PerfectCentralCovering
