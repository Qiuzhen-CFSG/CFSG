module

public import Theory.GroupTheory.GeneralizedFitting.ComponentLayerStructure
public import Theory.GroupTheory.SolvableRadical

/-!
# Normal solvable subgroups of a group generated by components

A component centralizes each solvable normal subgroup: the component
normal-subgroup dichotomy would otherwise embed a nontrivial perfect
group in a solvable group. Hence, when the layer is the whole group,
both the Fitting subgroup and the solvable radical equal the center.

Source: the ordinary component calculus, used in Aschbacher–Smith
A.2.11–12, printed pp.35–36.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace Theory.GroupTheory
variable {G : Type*} [Group G]

theorem IsComponent.le_centralizer_of_solvable_normal
    {L : Subgroup G} (hL : IsComponent G L) (N : Subgroup G) [N.Normal]
    [Group.IsSolvable N] : L ≤ centralizer (N : Set G) := by
  rcases hL.normal_dichotomy N with hn | hc
  · let := hL.2
    let : IsSimpleGroup (L ⧸ center L) := IsQuasisimple.simple
    let : Nontrivial L := (QuotientGroup.mk'_surjective (center L)).nontrivial
    let : Group.IsSolvable L := Group.isSolvable_of_isSolvable_injective
      (inclusion_injective hn)
    exact (Group.IsPerfect.not_isSolvable L inferInstance).elim
  · exact commutator_eq_bot_iff_le_centralizer.mp hc

theorem componentLayer_le_centralizer_solvable_normal
    (N : Subgroup G) [N.Normal] [Group.IsSolvable N] :
    componentLayer G ≤ centralizer (N : Set G) :=
  sSup_le (fun _ hL => hL.le_centralizer_of_solvable_normal N)

theorem solvable_normal_le_center_of_componentLayer_eq_top
    (hG : componentLayer G = ⊤) (N : Subgroup G) [N.Normal] [Group.IsSolvable N] :
    N ≤ center G := by
  have hc := componentLayer_le_centralizer_solvable_normal N
  rw [hG] at hc
  simpa only [coe_top, centralizer_univ] using le_centralizer_iff.mp hc

theorem fittingSubgroup_eq_center_of_componentLayer_eq_top [Finite G]
    (hG : componentLayer G = ⊤) : fittingSubgroup G = center G := by
  exact le_antisymm (solvable_normal_le_center_of_componentLayer_eq_top hG _)
    (le_sSup ⟨inferInstance, inferInstance⟩)

theorem solvableRadical_eq_center_of_componentLayer_eq_top [Finite G]
    (hG : componentLayer G = ⊤) : solvableRadical G = center G := by
  exact le_antisymm (solvable_normal_le_center_of_componentLayer_eq_top hG _)
    (le_solvableRadical _ inferInstance inferInstance)
end Theory.GroupTheory
