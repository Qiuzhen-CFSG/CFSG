module

public import Theory.GroupTheory.ComponentLocalPrimeFree
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# Prime cores of overgroups generated by a component and a two-subgroup

Let K be a component of a finite group G, let T be a two-subgroup, and
assume G = ⟨K,T⟩. For an odd prime p not dividing |Z(K)|, Oₚ(G) is trivial.
No normality of K in G is required.

The T-conjugates of K are components and distinct ones commute. Their join D
is normal with two-group quotient, so Oₚ(G) lies in D. Component calculus
makes Oₚ(G) centralize D. The center of this finite central product lies in
the product of the factor centers, which has order prime to p.

Source application: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of Proposition 1.3.8, printed pp.513–514. The required source bound on
the center of the quasisimple quotient is a separate classification input.
-/

public section

open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem center_image (K : Subgroup G) :
    (center K).map K.subtype = K ⊓ centralizer (K : Set G) := by
  ext x
  constructor
  · rintro ⟨z, hz, rfl⟩
    refine ⟨z.property, ?_⟩
    intro k hk
    exact congrArg Subtype.val (mem_center_iff.mp hz ⟨k, hk⟩)
  · rintro ⟨hx, hc⟩
    refine ⟨⟨x, hx⟩, ?_, rfl⟩
    exact mem_center_iff.mpr fun k => Subtype.ext (hc k k.property)

omit [Finite G] in
private theorem center_product_le {ι : Type*} [Finite ι]
    (K : ι → Subgroup G)
    (hc : ∀ i j, i ≠ j → K i ≤ centralizer (K j : Set G)) :
    (⨆ i, K i) ⊓ centralizer (⨆ i, K i : Subgroup G) ≤
      ⨆ i, (center (K i)).map (K i).subtype := by
  classical
  let := Fintype.ofFinite ι
  have hs (s : Finset ι) :
      s.sup K ⊓ centralizer ((s.sup K : Subgroup G) : Set G) ≤
        s.sup (fun i => (center (K i)).map (K i).subtype) := by
    induction s using Finset.induction_on with
    | empty => simp
    | @insert i s hi ih =>
      rw [Finset.sup_insert, Finset.sup_insert]
      have hcomm : s.sup K ≤ centralizer (K i : Set G) :=
        Finset.sup_le fun j hj => hc j i (ne_of_mem_of_not_mem hj hi)
      have hother : K i ≤ centralizer ((s.sup K : Subgroup G) : Set G) :=
        le_centralizer_iff.mp hcomm
      rintro x ⟨hx, hcx⟩
      have hxprod : x ∈ (K i : Set G) * (s.sup K : Subgroup G) := by
        rw [← coe_mul_of_right_le_normalizer_left (K i) (s.sup K)
          (hcomm.trans (centralizer_le_normalizer _))]
        exact hx
      obtain ⟨a, ha, b, hb, rfl⟩ := hxprod
      have hca : a ∈ centralizer (K i : Set G) :=
        (centralizer (K i : Set G)).mul_mem_cancel_right (hcomm hb) |>.mp
          ((centralizer_le (show K i ≤ K i ⊔ s.sup K from le_sup_left)) hcx)
      have hcb : b ∈ centralizer ((s.sup K : Subgroup G) : Set G) :=
        (centralizer ((s.sup K : Subgroup G) : Set G)).mul_mem_cancel_left (hother ha) |>.mp
          ((centralizer_le (show s.sup K ≤ K i ⊔ s.sup K from le_sup_right)) hcx)
      apply mul_mem
      · apply mem_sup_left
        rw [center_image]
        exact ⟨ha, hca⟩
      · exact mem_sup_right (ih ⟨hb, hcb⟩)
  simpa only [Finset.sup_univ_eq_iSup] using hs Finset.univ

/-- A component whose center has order prime to p, together with a two-subgroup, generates
an overgroup with trivial p-core. The component need not be normal. -/
theorem pCore_eq_bot_of_component_two_supplement
    {p : ℕ} [Fact p.Prime] (hp : Odd p) {K T : Subgroup G}
    (hK : IsComponent G K) (hT : IsPGroup 2 T) (hgen : K ⊔ T = ⊤)
    (hz : ¬ p ∣ Nat.card (center K)) : pCore p G = ⊥ := by
  classical
  let D := componentOrbit K T
  have hDn : D.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hgen]
    exact (normal_subgroupOf_iff_le_normalizer (componentOrbit_le_sup K T)).mp
      (componentOrbit_normal_subgroupOf_sup K T)
  let _ := hDn
  have hquot : IsPGroup 2 (G ⧸ D) :=
    isPGroup_quotient_of_sup_eq_top D T hT ((componentOrbit_sup K T).trans hgen)
  have hOD : pCore p G ≤ D := by
    let q := QuotientGroup.mk' D
    have hdis := (pCore_isPGroup.map q : IsPGroup p ((pCore p G).map q)).disjoint_of_coprime
      (hquot.to_subgroup ((pCore p G).map q)) (Nat.coprime_two_right.mpr hp)
    have he : (pCore p G).map q = ⊥ := by simpa using hdis.eq_bot
    simpa only [Subgroup.map_eq_bot_iff, q, QuotientGroup.ker_mk'] using he
  let I := {J : Subgroup G // ∃ t : T, K.map (MulAut.conj (t : G)).toMonoidHom = J}
  let F : I → Subgroup G := fun i => i.val
  have hi (i : I) : IsComponent G (F i) := by
    obtain ⟨t, ht⟩ := i.property
    change IsComponent G i.val
    rw [← ht]
    exact hK.map_conj t
  have hcomm (i j : I) (hne : i ≠ j) : F i ≤ centralizer (F j : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp
      ((hi i).commutator_eq_bot_of_ne (hi j) (fun he => hne (Subtype.ext he)))
  have hD : D = ⨆ i, F i := by
    apply le_antisymm
    · exact iSup_le fun t => le_iSup F ⟨_, t, rfl⟩
    · apply iSup_le
      rintro ⟨J, t, rfl⟩
      exact le_iSup (fun t : T => K.map (MulAut.conj (t : G)).toMonoidHom) t
  have hOC : pCore p G ≤ centralizer (D : Set G) := by
    apply le_centralizer_iff.mp
    rw [hD]
    apply iSup_le
    intro i
    rcases (hi i).normal_dichotomy (pCore p G) with hle | hc
    · let _ := (hi i).2
      let _ : IsSimpleGroup (F i ⧸ center (F i)) := IsQuasisimple.simple
      let _ : Nontrivial (F i) := (QuotientGroup.mk'_surjective (center (F i))).nontrivial
      let _ : Group.IsNilpotent (F i) := (pCore_isPGroup.to_le hle).isNilpotent
      exact (Group.IsPerfect.not_isSolvable (F i) inferInstance).elim
    · exact commutator_eq_bot_iff_le_centralizer.mp hc
  let Z : I → Subgroup G := fun i => (center (F i)).map (F i).subtype
  have hOZ : pCore p G ≤ ⨆ i, Z i := by
    have hh := center_product_le F hcomm
    rw [← hD] at hh
    exact (le_inf hOD hOC).trans hh
  have hZfree : ¬ p ∣ Nat.card (⨆ i, Z i : Subgroup G) := by
    apply not_dvd_card_iSup_of_normalizes (Fact.out : p.Prime)
    · intro i j
      apply le_trans _ (centralizer_le_normalizer _)
      by_cases he : i = j
      · subst j
        dsimp only [Z]
        rw [center_image]
        exact inf_le_right.trans (centralizer_le inf_le_left)
      · exact (map_subtype_le _).trans ((hcomm i j he).trans
          (centralizer_le (map_subtype_le _)))
    · intro i
      dsimp [Z]
      rw [card_map_of_injective (F i).subtype_injective]
      obtain ⟨t, ht⟩ := i.property
      have he : K ≃* F i := ((MulAut.conj (t : G)).subgroupMap K).trans
        (MulEquiv.subgroupCongr ht)
      rw [← Nat.card_congr (centerCongr he).toEquiv]
      exact hz
  rcases (pCore_isPGroup : IsPGroup p (pCore p G)).card_eq_or_dvd with h | h
  · exact Subgroup.card_eq_one.mp h
  · exact (hZfree (h.trans (card_dvd_of_le hOZ))).elim
end Theory.GroupTheory
