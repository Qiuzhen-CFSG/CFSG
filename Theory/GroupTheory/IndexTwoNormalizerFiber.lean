module

public import Mathlib.GroupTheory.IndexNormal

/-!
# Normalizers across a subgroup of index two

Suppose `F` crosses an index-two subgroup `R` and `R ⊓ F = W` is normal.
For any `t ∈ F ∖ R`, the subgroup `F` is generated by `W` and `t`.
Consequently, an element `x ∈ R` normalizes `F` exactly when
`x⁻¹ * t * x * t⁻¹ ∈ W`. This identifies the cardinality of the core
intersection of the normalizer with a conjugation fiber in `R`.

The proof uses the two cosets of `R` to obtain the generators. Normality of
`W` reduces preservation of `F` to preservation of `t`, and finiteness turns
containment of the conjugate into equality. No elementary-rank assumption is
needed. This is the normalizer-to-fixed-coset reduction used for quaternion–cyclic
cores in Janko–Thompson (1970), §4, Case 2, printed p.393.
-/

namespace Subgroup

/-- Normalizing a subgroup across a normal intersection is equivalent to
fixing the outside generator modulo that intersection. -/
public theorem mem_normalizer_iff_conjugation_difference_mem {P : Type*} [Group P] [Finite P]
    (R F W : Subgroup P) (hi : R.index = 2) [W.Normal]
    (hRF : R ⊓ F = W) (t : P) (ht : t ∈ F) (hout : t ∉ R)
    (x : R) :
    (x : P) ∈ normalizer (F : Set P) ↔
      (x : P)⁻¹ * t * x * t⁻¹ ∈ W := by
  let : R.Normal := R.normal_of_index_eq_two hi
  have hWF : W ≤ F := hRF ▸ inf_le_right
  have hgen : F = W ⊔ zpowers t := by
    apply le_antisymm
    · intro y hy
      by_cases hyr : y ∈ R
      · exact (show W ≤ W ⊔ zpowers t from le_sup_left) (hRF ▸ (show y ∈ R ⊓ F from ⟨hyr, hy⟩))
      · have hytR : y * t⁻¹ ∈ R := by
          rw [R.mul_mem_iff_of_index_two hi, R.inv_mem_iff]
          exact iff_of_false hyr hout
        have hytW : y * t⁻¹ ∈ W :=
          hRF ▸ (show y * t⁻¹ ∈ R ⊓ F from ⟨hytR, F.mul_mem hy (F.inv_mem ht)⟩)
        have hprod := (W ⊔ zpowers t).mul_mem
          ((show W ≤ W ⊔ zpowers t from le_sup_left) hytW)
          ((show zpowers t ≤ W ⊔ zpowers t from le_sup_right) (mem_zpowers t))
        simpa using hprod
    · exact sup_le hWF (zpowers_le.mpr ht)
  constructor
  · intro hx
    have hconj : (x : P)⁻¹ * t * x ∈ F :=
      (mem_normalizer_iff''.mp hx t).mp ht
    have hR : (x : P)⁻¹ * t * x * t⁻¹ ∈ R := by
      have h := R.mul_mem (R.inv_mem x.property)
        ((inferInstance : R.Normal).conj_mem (x : P) x.property t)
      simpa only [mul_assoc] using h
    exact hRF ▸ (show (x : P)⁻¹ * t * x * t⁻¹ ∈ R ⊓ F from
      ⟨hR, F.mul_mem hconj (F.inv_mem ht)⟩)
  · intro hx
    have hconj : (x : P)⁻¹ * t * x ∈ F := by
      have h := F.mul_mem (hWF hx) ht
      simpa using h
    have hle : F.map (MulAut.conj (x : P)⁻¹).toMonoidHom ≤ F := by
      rw [hgen, Subgroup.map_sup]
      apply sup_le
      · rintro _ ⟨w, hw, rfl⟩
        exact (show W ≤ W ⊔ zpowers t from le_sup_left) ((inferInstance : W.Normal).conj_mem w hw (x : P)⁻¹)
      · rw [MonoidHom.map_zpowers]
        apply zpowers_le.mpr
        change (x : P)⁻¹ * t * ((x : P)⁻¹)⁻¹ ∈ W ⊔ zpowers t
        simpa only [inv_inv, ← hgen] using hconj
    have heq : F.map (MulAut.conj (x : P)⁻¹).toMonoidHom = F := by
      apply eq_of_le_of_card_ge hle
      rw [card_map_of_injective (MulAut.conj (x : P)⁻¹).injective]
    have hxinv : (x : P)⁻¹ ∈ normalizer (F : Set P) :=
      mem_normalizer_iff_map_conj_eq.mpr heq
    exact (normalizer (F : Set P)).inv_mem_iff.mp hxinv

/-- The core intersection of the normalizer is counted by the conjugation
fiber of an outside generator modulo the normal intersection. -/
public theorem card_core_normalizer_eq_card_conjugation_fiber {P : Type*} [Group P] [Finite P]
    (R F W : Subgroup P) (hi : R.index = 2) [W.Normal]
    (hRF : R ⊓ F = W) (t : P) (ht : t ∈ F) (hout : t ∉ R) :
    Nat.card (R.subgroupOf (normalizer (F : Set P))) =
      Nat.card {x : R // (x : P)⁻¹ * t * x * t⁻¹ ∈ W} := by
  apply Nat.card_congr
  exact {
    toFun := fun x => ⟨⟨x.1.1, x.2⟩,
      (mem_normalizer_iff_conjugation_difference_mem R F W hi hRF t ht hout ⟨x.1.1, x.2⟩).mp x.1.2⟩
    invFun := fun x => ⟨⟨x.1.1,
      (mem_normalizer_iff_conjugation_difference_mem R F W hi hRF t ht hout x.1).mpr x.2⟩, x.1.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }

end Subgroup
