module
public import Theory.GroupTheory.NormalFourCentralizerSeparation
/-!
# Sylow promotion from a four-element center

Suppose Z(P) is generated by commuting involutions z and d, with z not
conjugate to d and d conjugate to zd. Every element of N(P) fixes z:
conjugation preserves Z(P), and z is its only member in the class of z.
A local Sylow subgroup P then remains Sylow in an overgroup whenever its
normalizer there stays in the local group. The conclusion uses literal
ambient subgroup images.

Source: the weak-closure argument in Aschbacher–Smith 14.3.20, p.997.
-/
public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
theorem normalizer_le_centralizer_of_four_center_fusion
    (P : Subgroup G) (z d : G) (hz : orderOf z = 2) (hd : orderOf d = 2)
    (hzd : Commute z d)
    (hcenter : (center P).map P.subtype = closure ({z,d} : Set G))
    (hnf : ¬IsConj z d) (hprod : IsConj d (z*d)) :
    normalizer (P : Set G) ≤ centralizer ({z} : Set G) := by
  intro a ha
  have hzZ : z ∈ (center P).map P.subtype := by
    rw [hcenter]
    exact subset_closure (by simp)
  have hzconj : a*z*a⁻¹ ∈ (center P).map P.subtype :=
    ((normalizer_le_normalizer_characteristic_image P (center P) ha) z).mp hzZ
  rw [hcenter] at hzconj
  have hzsq : z*z=1 := by simpa [pow_two, hz] using pow_orderOf_eq_one z
  have hdsq : d*d=1 := by simpa [pow_two, hd] using pow_orderOf_eq_one d
  have hconj : IsConj z (a*z*a⁻¹) := isConj_iff.mpr ⟨a,rfl⟩
  have hfix : a*z*a⁻¹=z := by
    rcases (mem_closure_pair_iff z d hzsq hdsq hzd _).mp hzconj with h1|he|he|he
    · have hz1 : z=1 := (MulAut.conj a).injective (h1.trans (map_one (MulAut.conj a)).symm)
      simp [hz1] at hz
    · exact he
    · exact (hnf (he ▸ hconj)).elim
    · exact (hnf ((he ▸ hconj).trans hprod.symm)).elim
  exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hfix)

theorem exists_sylow_map_eq_of_local_normalizer
    {p : ℕ} [Fact p.Prime] (P L C : Subgroup G) (hp : IsPGroup p P)
    (hPC : P ≤ C)
    (hlocal : ∃ S : Sylow p L, (S : Subgroup L).map L.subtype=P)
    (hcontrol : normalizer (P : Set G) ⊓ C ≤ L) :
    ∃ S : Sylow p C, (S : Subgroup C).map C.subtype=P := by
  obtain ⟨S,hS⟩ := hlocal
  have hPL : P≤L := hS ▸ map_subtype_le (S : Subgroup L)
  have hSP : (S : Subgroup L)=P.subgroupOf L := by
    apply map_injective L.subtype_injective
    rw [hS,map_subgroupOf_eq_of_le hPL]
  have hindex : ¬p ∣ P.relIndex L := by
    change ¬p ∣ (P.subgroupOf L).index
    rw [←hSP]
    exact S.not_dvd_index
  have hglobal := not_dvd_relIndex_of_normalizer_inf_le P L C hp hPC hindex hcontrol
  let R : Sylow p C := (hp.comap_subtype : IsPGroup p (P.subgroupOf C)).toSylow hglobal
  exact ⟨R,map_subgroupOf_eq_of_le hPC⟩
end Subgroup
