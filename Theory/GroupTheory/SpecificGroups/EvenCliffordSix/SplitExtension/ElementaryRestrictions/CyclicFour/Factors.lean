module

public import Theory.Frattini.BinarySquares
public import Theory.GroupTheory.QuaternionGenerated
public import Theory.GroupTheory.PGroup.ExtraspecialCentralizer
public import Theory.GroupTheory.NormalizedSupCard

/-!
# Quaternion factors from a cyclic-four center and binary squares

An order-64 group whose center is generated by an element z of order four,
and whose squares lie in ⟨z²⟩, contains two commuting quaternion-eight
subgroups with intersection ⟨z²⟩. Together with z they generate the group.

Choose a noncommuting pair and multiply either lift by z when its square
is trivial. The corrected pair satisfies the quaternion presentation.
The extraspecial centralizer supplement splits off this factor. Its
centralizer has order 16 and the same cyclic-four center, so the construction
repeats; the last centralizer has order four and is exactly that center.

This is the finite-group recognition step for Aschbacher–Smith I.2.2(6a),
printed pp.410 and 412 (combined manuscript, 1 March 2004). It assumes neither
quaternion factors nor a model isomorphism. The companion CyclicFour module
uses these actual factors to construct the Clifford-model equivalence.
-/

@[expose] public section

open Subgroup
open scoped commutatorElement
namespace EvenCliffordSix.CyclicFourRecognition
variable {G : Type*} [Group G] [Finite G]

private theorem square_order (z : G) (hz : orderOf z = 4) : orderOf (z ^ 2) = 2 := by
  rw [orderOf_pow, hz]
  decide

private theorem sign_cases (z : G) (hz : orderOf z = 4) (x : G)
    (hx : x ∈ zpowers (z ^ 2)) : x = 1 ∨ x = z ^ 2 := by
  classical
  have hh := (mem_zpowers_iff_mem_range_orderOf).mp hx
  simp only [Finset.mem_image, Finset.mem_range] at hh
  obtain ⟨k, hk, he⟩ := hh
  rw [square_order z hz] at hk
  have hk' : k = 0 ∨ k = 1 := by omega
  rcases hk' with rfl | rfl
  · exact Or.inl (by simpa using he.symm)
  · exact Or.inr (by simpa using he.symm)

omit [Finite G] in
private theorem commutator_le_sign (z : G)
    (hsq : ∀ x : G, x ^ 2 ∈ zpowers (z ^ 2)) :
    _root_.commutator G ≤ zpowers (z ^ 2) := by
  apply commutator_le_closure_squares.trans
  apply (closure_le _).mpr
  rintro _ ⟨x, rfl⟩
  exact hsq x

private theorem adjusted (z : G) (hz : z ∈ center G) (horder : orderOf z = 4)
    (hsq : ∀ x : G, x ^ 2 ∈ zpowers (z ^ 2)) (x : G) :
    ∃ a : G, a ^ 2 = z ^ 2 ∧ ∀ y, Commute a y ↔ Commute x y := by
  rcases sign_cases z horder (x ^ 2) (hsq x) with hx | hx
  · refine ⟨x * z, ?_, ?_⟩
    · rw [(show Commute x z from mem_center_iff.mp hz x).mul_pow, hx, one_mul]
    · intro y
      constructor
      · intro h
        have hh := h.mul_left ((show Commute z y from (mem_center_iff.mp hz y).symm).inv_left)
        simpa only [mul_inv_cancel_right] using hh
      · intro h
        exact h.mul_left (mem_center_iff.mp hz y).symm
  · exact ⟨x, hx, fun _ => Iff.rfl⟩

/-- Adjusting a noncommuting pair by a central fourth root of the sign
constructs an actual quaternion subgroup containing that sign. -/
private theorem exists_quaternion (z : G) (hz : z ∈ center G) (horder : orderOf z = 4)
    (hsq : ∀ x : G, x ^ 2 ∈ zpowers (z ^ 2)) (hnonab : center G ≠ ⊤) :
    ∃ Q : Subgroup G, Nonempty (Q ≃* QuaternionGroup 2) ∧ z ^ 2 ∈ Q := by
  obtain ⟨x, y, hxy⟩ : ∃ x y : G, ¬ Commute x y := by
    by_contra! h
    apply hnonab
    apply top_unique
    intro x _
    exact mem_center_iff.mpr fun y => (h y x).eq
  obtain ⟨a, ha, hac⟩ := adjusted z hz horder hsq x
  obtain ⟨b, hb, hbc⟩ := adjusted z hz horder hsq y
  have hab : ¬ Commute a b := by
    intro h
    exact hxy (((hbc x).mp ((hac b).mp h).symm).symm)
  have hcomm : ⁅b, a⁆ = z ^ 2 := by
    rcases sign_cases z horder ⁅b, a⁆
      (commutator_le_sign z hsq (commutator_mem_commutator (mem_top b) (mem_top a))) with h | h
    · exact (hab (commutatorElement_eq_one_iff_commute.mp h).symm).elim
    · exact h
  have hzsq : (z ^ 2) ^ 2 = 1 := by
    rw [← pow_mul, show 2 * 2 = 4 from rfl, ← horder, pow_orderOf_eq_one]
  have hzsqne : z ^ 2 ≠ 1 := by
    intro h
    have hh := square_order z horder
    rw [h, orderOf_one] at hh
    omega
  have ha4 : orderOf a = 4 := by
    apply orderOf_eq_prime_pow (p := 2) (n := 1)
    · simpa only [pow_one, ha] using hzsqne
    · simpa only [show 2^(1+1) = 2*2 from rfl, pow_mul, ha] using hzsq
  have hinv : b * a * b⁻¹ = a⁻¹ := by
    have h : b * a * b⁻¹ = a ^ 2 * a := by
      simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel, mul_one, ← ha]
        using congrArg (· * a) hcomm
    rw [h]
    apply eq_inv_of_mul_eq_one_left
    simpa only [← pow_succ, ← pow_succ, ha4] using pow_orderOf_eq_one a
  have hout : b ∉ zpowers a := by
    rintro ⟨k, rfl⟩
    exact hab ((Commute.refl a).zpow_right k)
  obtain ⟨_, he⟩ := QuaternionGroup.closure_equiv_of_relations (m := 2) (by decide)
    a b ha4 (hb.trans ha.symm) hinv hout
  refine ⟨closure ({a, b} : Set G), he, ?_⟩
  rw [← ha]
  exact Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) 2

omit [Finite G] in
private theorem quaternion_center_card (Q : Subgroup G)
    (e : Q ≃* QuaternionGroup 2) : Nat.card (center Q) = 2 := by
  rw [Nat.card_congr (centerCongr e).toEquiv]
  let predicate : QuaternionGroup 2 → Prop := fun x => ∀ y, y * x = x * y
  have hcard : Fintype.card {x // predicate x} = 2 := by decide
  rw [Nat.card_congr (Equiv.subtypeEquivRight (fun _ => mem_center_iff)),
    Nat.card_eq_fintype_card]
  exact hcard

private theorem center_factor (z : G) (hz : z ∈ center G) (horder : orderOf z = 4)
    (Q : Subgroup G) (e : Q ≃* QuaternionGroup 2) (hzQ : z ^ 2 ∈ Q) :
    (center Q).map Q.subtype = zpowers (z ^ 2) := by
  symm
  apply eq_of_le_of_card_ge
  · apply zpowers_le.mpr
    refine ⟨⟨z ^ 2, hzQ⟩, mem_center_iff.mpr ?_, rfl⟩
    intro q
    exact Subtype.ext (mem_center_iff.mp ((center G).pow_mem hz 2) q)
  · rw [card_subtype, quaternion_center_card Q e, Nat.card_zpowers, square_order z horder]

omit [Finite G] in
private theorem quotient_elementary (z : G) (hz : z ∈ center G)
    (hsq : ∀ x : G, x ^ 2 ∈ zpowers (z ^ 2)) (Q : Subgroup G) :
    IsElementaryAbelian 2 (Q ⧸ center Q) := by
  have hs (q : Q) : q ^ 2 ∈ center Q := by
    apply mem_center_iff.mpr
    intro r
    exact Subtype.ext (mem_center_iff.mp
      ((zpowers_le.mpr ((center G).pow_mem hz 2)) (hsq q)) r)
  have hc : _root_.commutator Q ≤ center Q := by
    apply commutator_le_closure_squares.trans
    exact (closure_le _).mpr (by rintro _ ⟨x, rfl⟩; exact hs x)
  refine { toIsMulCommutative := Normal.quotient_commutative_iff_commutator_le.mpr hc
           exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
  intro x
  obtain ⟨q, rfl⟩ := QuotientGroup.mk'_surjective (center Q) x
  rw [← map_pow]
  exact (QuotientGroup.eq_one_iff _).mpr (hs q)

omit [Finite G] in
private theorem center_centralizer (Q : Subgroup G)
    (hgen : Q ⊔ centralizer (Q : Set G) = ⊤) :
    center (centralizer (Q : Set G)) = (center G).subgroupOf (centralizer (Q : Set G)) := by
  apply le_antisymm
  · intro x hx
    change (x : G) ∈ center G
    have h : Q ⊔ centralizer (Q : Set G) ≤ centralizer ({(x : G)} : Set G) := by
      apply sup_le
      · intro q hq
        exact mem_centralizer_singleton_iff.mpr (x.property q hq)
      · intro c hc
        exact mem_centralizer_singleton_iff.mpr
          (congrArg Subtype.val (mem_center_iff.mp hx ⟨c, hc⟩))
    apply mem_center_iff.mpr
    intro g
    exact mem_centralizer_singleton_iff.mp (h (hgen ▸ mem_top g))
  · intro x hx
    exact mem_center_iff.mpr fun y => Subtype.ext (mem_center_iff.mp hx y)

/-- A quaternion factor and its full centralizer generate the group, with
exactly the binary sign as intersection. The centralizer inherits the full
ambient center. -/
private theorem exists_quaternion_split (z : G) (hz : z ∈ center G) (horder : orderOf z = 4)
    (hsq : ∀ x : G, x ^ 2 ∈ zpowers (z ^ 2)) (hnonab : center G ≠ ⊤) :
    ∃ Q : Subgroup G, Nonempty (Q ≃* QuaternionGroup 2) ∧
      z ^ 2 ∈ Q ∧
      Q ⊔ centralizer (Q : Set G) = ⊤ ∧
      Q ⊓ centralizer (Q : Set G) = zpowers (z ^ 2) ∧
      center (centralizer (Q : Set G)) =
        (center G).subgroupOf (centralizer (Q : Set G)) := by
  obtain ⟨Q, ⟨e⟩, hzQ⟩ := exists_quaternion z hz horder hsq hnonab
  have hQcard : Nat.card Q = 8 := by
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
  have hcenter : (center Q).map Q.subtype = zpowers (z ^ 2) :=
    center_factor z hz horder Q e hzQ
  let : IsExtraspecial 2 Q := {
    center_order_p := quaternion_center_card Q e
    quotient_elementary_abelian := quotient_elementary z hz hsq Q
    quotient_nontrivial := by
      apply Finite.one_lt_card_iff_nontrivial.mp
      have h := (center Q).card_mul_index
      rw [quaternion_center_card Q e, hQcard, index_eq_card] at h
      omega }
  have hcomm : ⁅(⊤ : Subgroup G), Q⁆ ≤ (center Q).map Q.subtype := by
    rw [hcenter]
    exact (commutator_mono le_rfl le_top).trans (commutator_le_sign z hsq)
  have hgen := sup_centralizer_eq_top_of_extraspecial_two Q hcomm
  refine ⟨Q, ⟨e⟩, hzQ, hgen, ?_, center_centralizer Q hgen⟩
  rw [← hcenter]
  ext x
  constructor
  · intro hx
    exact ⟨⟨x, hx.1⟩, mem_center_iff.mpr (fun y => Subtype.ext (hx.2 y y.property)), rfl⟩
  · rintro ⟨x, hx, rfl⟩
    refine ⟨x.property, ?_⟩
    intro y hy
    exact congrArg Subtype.val (mem_center_iff.mp hx ⟨y, hy⟩)


omit [Finite G] in
private theorem nonabelian_of_center_order (z : G) (horder : orderOf z = 4)
    (hcenter : center G = zpowers z) (hcard : Nat.card G ≠ 4) : center G ≠ ⊤ := by
  intro ht
  have h : Nat.card (center G) = 4 := by rw [hcenter, Nat.card_zpowers, horder]
  rw [ht, Nat.card_congr topEquiv.toEquiv] at h
  exact hcard h

omit [Finite G] in
private theorem zpowers_restrict (C : Subgroup G) (z : G) (hz : z ∈ C) :
    (zpowers z).subgroupOf C = zpowers (⟨z, hz⟩ : C) := by
  ext x
  constructor
  · rintro ⟨k, hk⟩
    exact ⟨k, Subtype.ext hk⟩
  · rintro ⟨k, hk⟩
    exact ⟨k, congrArg Subtype.val hk⟩

/-- Two commuting quaternion subgroups together with the given cyclic-four
center generate the entire order-64 group. No factor is assumed. -/
theorem exists_factors (z : G) (horder : orderOf z = 4)
    (hcenter : center G = zpowers z) (hcard : Nat.card G = 64)
    (hsq : ∀ x : G, x ^ 2 ∈ zpowers (z ^ 2)) :
    ∃ Q R : Subgroup G, Nonempty (Q ≃* QuaternionGroup 2) ∧
      Nonempty (R ≃* QuaternionGroup 2) ∧
      Q ⊓ R = zpowers (z ^ 2) ∧
      (∀ q ∈ Q, ∀ r ∈ R, q * r = r * q) ∧
      zpowers z ⊔ (Q ⊔ R) = ⊤ := by
  have hz : z ∈ center G := hcenter ▸ mem_zpowers z
  obtain ⟨Q, ⟨eQ⟩, hzQ, hgen, hinter, hCcenter⟩ :=
    exists_quaternion_split z hz horder hsq
      (nonabelian_of_center_order z horder hcenter (by omega))
  let C := centralizer (Q : Set G)
  have hZC : zpowers z ≤ C := hcenter ▸ center_le_centralizer (Q : Set G)
  let zC : C := ⟨z, hZC (mem_zpowers z)⟩
  have hzCorder : orderOf zC = 4 := (orderOf_coe zC).symm.trans horder
  have hCcenter' : center C = zpowers zC := by
    rw [hCcenter, hcenter, zpowers_restrict]
  have hCcard : Nat.card C = 16 := by
    have h := card_mul_eq_card_inf_mul_card_sup_of_normalizes Q C
      (centralizer_le_normalizer (Q : Set G))
    have hcQ : Nat.card Q = 8 := by
      rw [Nat.card_congr eQ.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
    rw [hcQ, hinter, Nat.card_zpowers, square_order z horder, hgen,
      Nat.card_congr topEquiv.toEquiv, hcard] at h
    omega
  have hCsq (c : C) : c ^ 2 ∈ zpowers (zC ^ 2) := by
    obtain ⟨k, hk⟩ := hsq c
    exact ⟨k, Subtype.ext hk⟩
  obtain ⟨R', ⟨eR⟩, hzR', hgenR, hinterR, hDcenter⟩ :=
    exists_quaternion_split zC (hCcenter' ▸ mem_zpowers zC) hzCorder hCsq
      (nonabelian_of_center_order zC hzCorder hCcenter' (by omega))
  let D := centralizer (R' : Set C)
  have hZD : zpowers zC ≤ D := hCcenter' ▸ center_le_centralizer (R' : Set C)
  have hDcard : Nat.card D = 4 := by
    have h := card_mul_eq_card_inf_mul_card_sup_of_normalizes R' D
      (centralizer_le_normalizer (R' : Set C))
    have hcR : Nat.card R' = 8 := by
      rw [Nat.card_congr eR.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
    rw [hcR, hinterR, Nat.card_zpowers, square_order zC hzCorder, hgenR,
      Nat.card_congr topEquiv.toEquiv, hCcard] at h
    omega
  have hDeq : D = zpowers zC := (eq_of_le_of_card_ge hZD (by
    rw [hDcard, Nat.card_zpowers, hzCorder])).symm
  have hCgen : R' ⊔ zpowers zC = ⊤ := by simpa only [← hDeq] using hgenR
  let R := R'.map C.subtype
  have hRC : R ≤ C := map_subtype_le _
  have hRmodel : Nonempty (R ≃* QuaternionGroup 2) :=
    ⟨(R'.equivMapOfInjective C.subtype C.subtype_injective).symm.trans eR⟩
  have hzR : z ^ 2 ∈ R := mem_map_of_mem C.subtype hzR'
  have hQR : Q ⊓ R = zpowers (z ^ 2) := by
    apply le_antisymm
    · exact (inf_le_inf_left Q hRC).trans (le_of_eq hinter)
    · exact zpowers_le.mpr ⟨hzQ, hzR⟩
  refine ⟨Q, R, ⟨eQ⟩, hRmodel, hQR, ?_, ?_⟩
  · intro q hq r hr
    exact hRC hr q hq
  · have hmap := congrArg (fun S : Subgroup C => S.map C.subtype) hCgen
    rw [Subgroup.map_sup, MonoidHom.map_zpowers, ← MonoidHom.range_eq_map, range_subtype] at hmap
    change R ⊔ zpowers z = C at hmap
    change Q ⊔ C = ⊤ at hgen
    rw [← hmap] at hgen
    simpa only [sup_assoc, sup_comm, sup_left_comm] using hgen

end EvenCliffordSix.CyclicFourRecognition
