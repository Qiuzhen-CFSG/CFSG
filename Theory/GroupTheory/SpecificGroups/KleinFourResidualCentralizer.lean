module

public import Theory.GroupTheory.SpecificGroups.KleinFourResidualAction
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# A fully moved Klein four has no residual-fixed point

A two-perfect normalizing actor that generates a Klein four by
commutators fixes none of its nonidentity elements. A fixed point would
force its complete action to be trivial by the two-point stabilizer
calculation, contradicting commutator generation.

Source application: Aschbacher--Smith12.7.18, printed p.845.
-/

public section
namespace Subgroup
variable {G : Type*} [Group G]

/-- The literal four-group has trivial intersection with its residual
actor's centralizer when it is generated by their commutators. -/
theorem kleinFour_inf_centralizer_eq_bot_of_twoPerfect
    (A J : Subgroup G) [IsKleinFour A] (hJ : IsPPerfect 2 J)
    (hn : J ≤ normalizer (A : Set G)) (hm : A = ⁅A,J⁆) :
    A ⊓ centralizer (J : Set G) = ⊥ := by
  apply bot_unique
  rintro a ⟨ha,hac⟩
  by_contra hane
  have ha1 : a ≠ 1 := hane
  let α : J →* MulAut A := A.normalizerMonoidHom.comp (inclusion hn)
  have ha0 : (⟨a,ha⟩ : A) ≠ 1 := fun he => ha1 (congrArg Subtype.val he)
  have hfix (j : J) : α j ⟨a,ha⟩ = ⟨a,ha⟩ := by
    apply Subtype.ext
    change (j:G)*a*(j:G)⁻¹ = a
    rw [(mem_centralizer_iff.mp hac) j j.property,mul_inv_cancel_right]
  have hα := IsKleinFour.action_eq_one_of_twoPerfect_of_fixed_ne_one α hJ ha0 hfix
  have hcentral : J ≤ centralizer (A : Set G) := by
    intro j hj
    apply mem_centralizer_iff.mpr
    intro b hb
    have he := congrArg (fun f : J →* MulAut A => (f ⟨j,hj⟩ ⟨b,hb⟩ : G)) hα
    change j*b*j⁻¹ = b at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  have hz : ⁅A,J⁆ = ⊥ := by
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr hcentral
  have hA : A = ⊥ := hm.trans hz
  rw [hA] at ha
  exact ha1 ha

end Subgroup
