module
public import Mathlib.GroupTheory.SpecificGroups.KleinFour

/-!
# Klein four subgroups from commuting involutions

Two distinct nonidentity involutions which commute generate a Klein four
group. The proof identifies their generated subgroup with the four elements
`a*b, a, b, 1`, verifies closure and exponent two, and counts the distinct
elements. The finite carrier is private; callers use the actual subgroup
closure and need no finiteness assumption on the ambient group. The membership
characterization does not require the generators to be distinct or nonidentity.

This elementary construction is used for the four subgroups in ABG Chapter
II, §1, Lemmas 1(ii) and 2(iii–iv), article page 9 of
`refs/latex/alperin-brauer-gorenstein.tex`.
-/

namespace Subgroup
private def kleinFourOfGenerators
    {G : Type*} [Group G]
    (a b : G) (ha : a * a = 1) (hb : b * b = 1) (hab : Commute a b) :
    Subgroup G where
  carrier := {a * b, a, b, 1}
  one_mem' := by simp
  mul_mem' := by
    have hba : b * a = a * b := hab.eq.symm
    have ha_ab : a * (a * b) = b := by
      rw [← mul_assoc, ha, one_mul]
    have hb_ab : b * (a * b) = a := by
      rw [← mul_assoc, hba, mul_assoc, hb, mul_one]
    have hab_a : (a * b) * a = b := by
      rw [mul_assoc, hba, ha_ab]
    have hab_b : (a * b) * b = a := by
      rw [mul_assoc, hb, mul_one]
    have hab_sq : (a * b) * (a * b) = 1 := by
      rw [← mul_assoc, hab_a, hb]
    intro x y hx hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy ⊢
    rcases hx with (rfl | rfl | rfl | rfl) <;>
      rcases hy with (rfl | rfl | rfl | rfl) <;>
      simp [ha, hb, hba, ha_ab, hb_ab, hab_a, hab_b, hab_sq]
  inv_mem' := by
    have ha_inv : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha
    have hb_inv : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb
    have hab_sq : (a * b) * (a * b) = 1 := by
      calc
        (a * b) * (a * b) = a * (b * a) * b := by group
        _ = a * (a * b) * b := by rw [hab.eq.symm]
        _ = 1 := by rw [← mul_assoc, ha, one_mul, hb]
    have hab_inv : (a * b)⁻¹ = a * b :=
      inv_eq_of_mul_eq_one_right hab_sq
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
    rcases hx with (rfl | rfl | rfl | rfl) <;>
      simp [ha_inv, hb_inv, hab_inv]

private theorem isKleinFour_kleinFourOfGenerators
    {G : Type*} [Group G]
    (a b : G) (ha : a * a = 1) (hb : b * b = 1)
    (ha1 : a ≠ 1) (hb1 : b ≠ 1) (habne : a ≠ b) (hab : Commute a b) :
    IsKleinFour (kleinFourOfGenerators a b ha hb hab) := by
  let V := kleinFourOfGenerators a b ha hb hab
  have hoa : orderOf a = 2 :=
    orderOf_eq_prime (by simpa [pow_two] using ha) ha1
  have hob : orderOf b = 2 :=
    orderOf_eq_prime (by simpa [pow_two] using hb) hb1
  have habnot : a * b ∉ ({a, b, 1} : Set G) :=
    mul_notMem_of_orderOf_eq_two hoa hob habne
  constructor
  · change Nat.card V = 4
    rw [← SetLike.coe_sort_coe, Nat.card_coe_set_eq]
    change ({a * b, a, b, 1} : Set G).ncard = 4
    simp [habnot, ha1, hb1, habne]
  · apply Nat.dvd_antisymm
    · apply Monoid.exponent_dvd_of_forall_pow_eq_one
      intro x
      rcases x with ⟨x, hx⟩
      apply Subtype.ext
      change x ^ 2 = 1
      change x ∈ ({a * b, a, b, 1} : Set G) at hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with (rfl | rfl | rfl | rfl)
      · calc
          (a * b) ^ 2 = a * (b * a) * b := by rw [pow_two]; group
          _ = a * (a * b) * b := by rw [hab.eq.symm]
          _ = 1 := by rw [← mul_assoc, ha, one_mul, hb]
      · simpa [pow_two] using ha
      · simpa [pow_two] using hb
      · simp
    · have haV : a ∈ V := by
        change a ∈ ({a * b, a, b, 1} : Set G)
        simp
      have hordV : orderOf (⟨a, haV⟩ : V) = 2 := by
        simpa [Subgroup.orderOf_mk] using hoa
      simpa [hordV] using
        (Monoid.order_dvd_exponent (⟨a, haV⟩ : V))

private theorem closure_pair_eq {G : Type*} [Group G]
    (a b : G) (ha : a * a = 1) (hb : b * b = 1) (hab : Commute a b) :
    Subgroup.closure ({a, b} : Set G) = kleinFourOfGenerators a b ha hb hab := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro x hx
    change x ∈ ({a * b, a, b, 1} : Set G)
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
    tauto
  · intro x hx
    change x ∈ ({a * b, a, b, 1} : Set G) at hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    have haU : a ∈ Subgroup.closure ({a, b} : Set G) := Subgroup.subset_closure (by simp)
    have hbU : b ∈ Subgroup.closure ({a, b} : Set G) := Subgroup.subset_closure (by simp)
    rcases hx with rfl | rfl | rfl | rfl
    · exact Subgroup.mul_mem _ haU hbU
    · exact haU
    · exact hbU
    · exact Subgroup.one_mem _

/-- The subgroup generated by two commuting elements whose squares are one has these four forms. -/
public theorem mem_closure_pair_iff {G : Type*} [Group G]
    (a b : G) (ha : a * a = 1) (hb : b * b = 1) (hab : Commute a b) (g : G) :
    g ∈ Subgroup.closure ({a, b} : Set G) ↔ g = 1 ∨ g = a ∨ g = b ∨ g = a * b := by
  rw [closure_pair_eq a b ha hb hab]
  change g ∈ ({a * b, a, b, 1} : Set G) ↔ _
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  tauto

/-- Two distinct commuting nonidentity involutions generate a Klein four subgroup. -/
public theorem isKleinFour_closure_pair {G : Type*} [Group G]
    (a b : G) (ha : a * a = 1) (hb : b * b = 1)
    (ha1 : a ≠ 1) (hb1 : b ≠ 1) (habne : a ≠ b) (hab : Commute a b) :
    IsKleinFour (Subgroup.closure ({a, b} : Set G)) := by
  rw [closure_pair_eq a b ha hb hab]
  exact isKleinFour_kleinFourOfGenerators a b ha hb ha1 hb1 habne hab

/-- Order-two form of the commuting-involution construction of a Klein four subgroup. -/
public theorem isKleinFour_closure_pair_of_orderOf {G : Type*} [Group G]
    (a b : G) (ha : orderOf a = 2) (hb : orderOf b = 2)
    (habne : a ≠ b) (hab : Commute a b) :
    IsKleinFour (Subgroup.closure ({a, b} : Set G)) := by
  apply isKleinFour_closure_pair a b
  · simpa [pow_two, ha] using pow_orderOf_eq_one a
  · simpa [pow_two, hb] using pow_orderOf_eq_one b
  · intro h
    simp [h] at ha
  · intro h
    simp [h] at hb
  · exact habne
  · exact hab
end Subgroup
