module

public import Theory.GroupTheory.QuaternionCentralProductInvolutions
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# The diagonal quotient of Q₈ × Q₈

The centralizer of a noncentral involution in the diagonal quotient of
Q₈ × Q₈ is generated by involutions and has derived subgroup equal to its
central line. The finite calculation is the intrinsic C₂ × D₈ calculation of
Janko–Thompson §4, printed p.390, PDF p.6 of
`refs/original/n-group-global/odd-core-rank-two-source/janko-thompson-1970-gdz.pdf`.
-/

set_option maxRecDepth 4096
set_option maxHeartbeats 0
set_option synthInstance.maxSize 4096

open scoped commutatorElement

namespace QuaternionPair

public abbrev Q := QuaternionGroup 2
public abbrev M := Q × Q
public abbrev zz : M := (QuaternionGroup.a 2, QuaternionGroup.a 2)
public abbrev zb : M := (QuaternionGroup.a 2, 1)
public abbrev ker (x : M) : Prop := x = 1 ∨ x = zz
private abbrev centralMod (x y : M) : Prop := ker (x * y * (y * x)⁻¹)
private abbrev involMod (x : M) : Prop := ker (x ^ 2)


private theorem model_geometry :
    ∀ p : M, p ^ 2 = zz →
      ∃ q r : M, involMod q ∧ involMod r ∧ ¬ker q ∧ ¬ker r ∧
        centralMod q p ∧ centralMod r p ∧
        (⁅q,r⁆ = zb ∨ ⁅q,r⁆ = zb * zz) ∧
        ∀ x : M, centralMod x p →
          ∃ i : Fin 4, ∃ j k : Fin 2,
            ker (x * (((q*r)^i.val * q^j.val * p^k.val)⁻¹)) := by
  decide

private theorem sq_one_finite :
    ∀ p : M, p ^ 2 = 1 → p = 1 ∨ p = zz ∨ p = zb ∨ p = (1, QuaternionGroup.a 2) := by
  decide

private theorem commutator_finite :
    ∀ x y : M, ⁅x,y⁆ = 1 ∨ ⁅x,y⁆ = zz ∨ ⁅x,y⁆ = zb ∨
      ⁅x,y⁆ = (1, QuaternionGroup.a 2) := by
  decide

/-- The finite-model centralizer calculation under the diagonal-kernel contract. -/
public theorem quaternion_pair_centralizer_geometry {G : Type*} [Group G]
    (f : M →* G) (hf : Function.Surjective f)
    (hker : ∀ x : M, f x = 1 ↔ ker x)
    (t : G) (ht : orderOf t = 2) (htz : t ≠ f zb) :
    let D := Subgroup.centralizer ({t} : Set G)
    Subgroup.closure {x : G | x ∈ D ∧ orderOf x = 2} = D ∧
      (_root_.commutator D).map D.subtype = Subgroup.zpowers (f zb) := by
  classical
  intro D
  obtain ⟨p, hp⟩ := hf t
  have hzz : f zz = 1 := (hker zz).mpr (Or.inr rfl)
  have hsq : p ^ 2 = zz := by
    have hp2 : (f p) ^ 2 = 1 := by rw [hp, ← ht]; exact pow_orderOf_eq_one t
    have hk : ker (p ^ 2) := (hker _).mp (by rw [map_pow]; exact hp2)
    rcases hk with h1 | hzz'
    · rcases sq_one_finite p h1 with hp1 | hpzz | hpzb | hpc
      · have : t = 1 := by rw [← hp, hp1, map_one]
        have ht1 : t ≠ 1 := by intro h; simp [h] at ht
        exact (ht1 this).elim
      · have : t = 1 := by rw [← hp, hpzz, hzz]
        have ht1 : t ≠ 1 := by intro h; simp [h] at ht
        exact (ht1 this).elim
      · exact (htz (by rw [← hp, hpzb])).elim
      · have hc : (1, QuaternionGroup.a 2) = zb * zz := by decide
        have : t = f zb := by rw [← hp, hpc, hc, map_mul, hzz, mul_one]
        exact (htz this).elim
    · exact hzz'
  obtain ⟨q, r, hq2, hr2, hqne, hrne, hqp, hrp, hqr, hword⟩ := model_geometry p hsq
  have hrel (a b : M) : f a = f b ↔ ker (a * b⁻¹) := by
    rw [← hker, map_mul, map_inv, mul_inv_eq_one]
  have hcomm (a b : M) (hab : centralMod a b) : f a * f b = f b * f a := by
    have hh := (hrel (a*b) (b*a)).mpr hab
    simpa only [map_mul] using hh
  have hinvol (a : M) (ha : involMod a) (hne : ¬ ker a) : orderOf (f a) = 2 := by
    apply orderOf_eq_prime
    · rw [← map_pow]
      exact (hker _).mpr ha
    · intro he
      exact hne ((hker _).mp he)
  let T := Subgroup.closure {x : G | x ∈ D ∧ orderOf x = 2}
  have hmem (a : M) (ha : centralMod a p) (ha2 : involMod a) (hane : ¬ ker a) :
      f a ∈ T := by
    apply Subgroup.subset_closure
    refine ⟨Subgroup.mem_centralizer_singleton_iff.mpr ?_, hinvol a ha2 hane⟩
    simpa only [hp] using hcomm a p ha
  have hqT : f q ∈ T := hmem q hqp hq2 hqne
  have hrT : f r ∈ T := hmem r hrp hr2 hrne
  have htD : t ∈ D := Subgroup.mem_centralizer_singleton_iff.mpr rfl
  have htT : t ∈ T := Subgroup.subset_closure ⟨htD, ht⟩
  have hgen : T = D := by
    apply le_antisymm
    · exact (Subgroup.closure_le _).mpr (fun _ hx => hx.1)
    · intro x hx
      obtain ⟨a, ha⟩ := hf x
      have hap : centralMod a p := by
        apply (hrel (a*p) (p*a)).mp
        have hax := Subgroup.mem_centralizer_singleton_iff.mp hx
        simpa only [map_mul, ha, hp] using hax
      obtain ⟨i,j,k,hak⟩ := hword a hap
      have heq : f a = f ((q*r)^i.val * q^j.val * p^k.val) :=
        (hrel _ _).mpr hak
      rw [← ha, heq, map_mul, map_mul, map_pow, map_pow, map_pow, hp, map_mul]
      exact T.mul_mem (T.mul_mem (T.pow_mem (T.mul_mem hqT hrT) _)
        (T.pow_mem hqT _)) (T.pow_mem htT _)
  have hother : f (1, QuaternionGroup.a 2) = f zb := by
    have hc : (1, QuaternionGroup.a 2) = zb * zz := by decide
    rw [hc, map_mul, hzz, mul_one]
  have hupper : ⁅D, D⁆ ≤ Subgroup.zpowers (f zb) := by
    apply Subgroup.commutator_le.mpr
    intro x hx y hy
    obtain ⟨a, ha⟩ := hf x
    obtain ⟨b, hb⟩ := hf y
    have hc : ⁅x,y⁆ = f ⁅a,b⁆ := by rw [← ha, ← hb, map_commutatorElement]
    rw [hc]
    rcases commutator_finite a b with h | h | h | h
    · rw [h, map_one]; exact Subgroup.one_mem _
    · rw [h, hzz]; exact Subgroup.one_mem _
    · rw [h]; exact Subgroup.mem_zpowers _
    · rw [h, hother]; exact Subgroup.mem_zpowers _
  have hlower : Subgroup.zpowers (f zb) ≤ ⁅D,D⁆ := by
    apply Subgroup.zpowers_le.mpr
    have hqD : f q ∈ D := hgen.symm ▸ hqT
    have hrD : f r ∈ D := hgen.symm ▸ hrT
    have hc := Subgroup.commutator_mem_commutator hqD hrD
    have hqr' : ⁅f q,f r⁆ = f zb := by
      rw [← map_commutatorElement]
      rcases hqr with h | h
      · rw [h]
      · rw [h, map_mul, hzz, mul_one]
    rwa [hqr'] at hc
  exact ⟨hgen, by rw [Subgroup.map_subtype_commutator]; exact le_antisymm hupper hlower⟩

end QuaternionPair
