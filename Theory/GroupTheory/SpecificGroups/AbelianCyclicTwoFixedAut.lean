module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Theory.GroupTheory.PGroup.Omega

/-!
# Automorphisms of a cyclic two-group times C₂ fixing all involutions

An action on `C_(2^n) × C₂`, for `n ≥ 2`, which fixes every element whose
square is one has commuting automorphisms. Its restriction to second omega
has image of order at most four. Both conclusions are transported along a
specified group equivalence, without requiring an ambient group.

For a generator `x` of the long factor, write its image as `x^a c`, with `c`
in the short factor. Fixing the long factor's involution forces `a` to be odd.
Since the short factor is fixed pointwise, composition of these expressions
commutes. For the image bound, choose a generator `z` of the fourth-power
kernel in the long factor. Second omega is generated by `z` and the short
factor, so the restricted action is determined by its value on `z`. The
square of that value is fixed. Thus displacement at `z` embeds the action
image into the square kernel, which has order four.

Source context: the unequal abelian factors in Janko–Thompson,
*Math. Z.* 113 (1970), §6, p.394. The proofs here are direct generator and
power-kernel calculations.
-/

namespace AbelianCyclicTwoFixedAut
private abbrev A (n : ℕ) := Multiplicative (ZMod (2 ^ n))
private abbrev B := Multiplicative (ZMod 2)
private abbrev G (n : ℕ) := A n × B

private theorem B_sq (b : B) : b ^ 2 = 1 := by
  simpa [B] using pow_card_eq_one' (x := b)

private theorem B_odd (b : B) {a : ℕ} (ha : Odd a) : b ^ a = b := by
  obtain ⟨k, rfl⟩ := ha
  rw [pow_add, pow_mul, B_sq, one_pow, one_mul, pow_one]

private theorem exists_power {C : Type*} [Group C] [Finite C] {x : C}
    (hx : ∀ y, y ∈ Subgroup.zpowers x) (y : C) : ∃ a : ℕ, x ^ a = y := by
  exact mem_powers_iff_mem_zpowers.mpr (hx y)

private theorem fixes_B {n : ℕ} (f : MulAut (G n))
    (hf : ∀ z, z ^ 2 = 1 → f z = z) (b : B) : f (1, b) = (1, b) := by
  apply hf
  exact Prod.ext (by simp) (B_sq b)

private theorem odd_coordinate {n : ℕ} (hn : 1 ≤ n) (x : A n)
    (hx : ∀ y, y ∈ Subgroup.zpowers x) (f : MulAut (G n))
    (hf : ∀ z, z ^ 2 = 1 → f z = z)
    {a : ℕ} {b : B} (hcoord : f (x, 1) = (x ^ a, b)) : Odd a := by
  let t := 2 ^ (n - 1)
  have ht : t * 2 = 2 ^ n := by dsimp [t]; rw [← pow_succ]; congr 1; omega
  have hxord : orderOf x = 2 ^ n := by
    simpa [A] using orderOf_eq_card_of_forall_mem_zpowers hx
  have hu2 : (x ^ t) ^ 2 = 1 := by
    rw [← pow_mul, ht]
    simpa only [hxord] using pow_orderOf_eq_one x
  have hu : x ^ t ≠ 1 := pow_ne_one_of_lt_orderOf (by dsimp [t]; positivity) (by
    rw [hxord, ← ht]
    have : 0 < t := by dsimp [t]; positivity
    omega)
  have he : (x ^ a) ^ t = x ^ t := by
    have h := hf ((x, (1 : B)) ^ t) (Prod.ext hu2 (by simp))
    rw [map_pow, hcoord] at h
    exact congrArg Prod.fst h
  rcases Nat.even_or_odd a with ha | ha
  · obtain ⟨k, hk⟩ := ha
    exfalso
    apply hu
    rw [← he, hk, show k + k = 2 * k by omega]
    rw [← pow_mul, show 2 * k * t = t * 2 * k by ring, pow_mul, pow_mul, hu2, one_pow]
  · exact ha

private theorem model_commute {n : ℕ} (hn : 1 ≤ n) (f g : MulAut (G n))
    (hf : ∀ z, z ^ 2 = 1 → f z = z)
    (hg : ∀ z, z ^ 2 = 1 → g z = z) : Commute f g := by
  obtain ⟨x, hx⟩ := IsCyclic.exists_generator (α := A n)
  obtain ⟨a, ha⟩ := exists_power hx (f (x, 1)).1
  obtain ⟨b, hb⟩ := exists_power hx (g (x, 1)).1
  let c := (f (x, 1)).2
  let d := (g (x, 1)).2
  have hfc : f (x, 1) = (x ^ a, c) := Prod.ext ha.symm rfl
  have hgc : g (x, 1) = (x ^ b, d) := Prod.ext hb.symm rfl
  have hoa := odd_coordinate hn x hx f hf hfc
  have hob := odd_coordinate hn x hx g hg hgc
  have hgen : f (g (x, 1)) = g (f (x, 1)) := by
    have he (k : ℕ) (y : B) : (x ^ k, y) = (x, (1 : B)) ^ k * (1, y) := by simp
    rw [hgc, he b d, map_mul, map_pow, fixes_B f hf, hfc,
      he a c, map_mul, map_pow, fixes_B g hg, hgc]
    apply Prod.ext
    · simp [← pow_mul, Nat.mul_comm]
    · simpa using (show c ^ b * d = d ^ a * c by
        rw [B_odd c hob, B_odd d hoa, mul_comm])
  apply MulEquiv.ext
  rintro ⟨u, v⟩
  obtain ⟨k, rfl⟩ := exists_power hx u
  have he : (x ^ k, v) = (x, (1 : B)) ^ k * (1, v) := by simp
  change f (g (x ^ k, v)) = g (f (x ^ k, v))
  rw [he, map_mul, map_pow, fixes_B g hg, map_mul, map_pow, fixes_B f hf,
    map_mul, map_pow, fixes_B f hf, map_mul, map_pow, fixes_B g hg, hgen]

private theorem card_square_kernel (n : ℕ) (hn : 1 ≤ n) :
    Nat.card (powMonoidHom 2 : G n →* G n).ker = 4 := by
  have he : (powMonoidHom 2 : G n →* G n).ker =
      (powMonoidHom 2 : A n →* A n).ker.prod (powMonoidHom 2 : B →* B).ker := by
    ext x
    exact Prod.ext_iff
  rw [he, Nat.card_congr (Subgroup.prodEquiv _ _).toEquiv, Nat.card_prod,
    IsCyclic.card_powMonoidHom_ker, IsCyclic.card_powMonoidHom_ker]
  have hd : 2 ∣ 2 ^ n := dvd_pow_self 2 (by omega)
  simp [A, B, Nat.gcd_eq_right hd]

private theorem omega_four {H : Type*} [Group H] {n : ℕ} (e : H ≃* G n)
    {w : H} (hw : w ∈ omega H (p := 2) 2) : w ^ 4 = 1 := by
  have hle : omega H (p := 2) 2 ≤
      ((powMonoidHom 4 : G n →* G n).comp e.toMonoidHom).ker := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    change e x ^ 4 = 1
    rw [← map_pow, show x ^ 4 = 1 from hx, map_one]
  apply e.injective
  have he : e w ^ 4 = 1 := hle hw
  simpa only [map_pow, map_one] using he

private theorem card_restriction {H K : Type*} [Group H] [Group K]
    {n : ℕ} (hn : 1 ≤ n) (e : H ≃* G n) (f : K →* MulAut H)
    (hfix : ∀ k : K, ∀ x : H, x ^ 2 = 1 → f k x = x) :
    let := omega_characteristic H (p := 2) 2
    Nat.card (((MulAut.characteristic (omega H (p := 2) 2)).comp f).range) ≤ 4 := by
  let := omega_characteristic H (p := 2) 2
  let O := omega H (p := 2) 2
  let r := (MulAut.characteristic O).comp f
  let C := (powMonoidHom 4 : A n →* A n).ker
  obtain ⟨x, hx⟩ := IsCyclic.exists_generator (α := C)
  let z : H := e.symm ((x : A n), 1)
  have hz4 : z ^ 4 = 1 := by
    apply e.injective
    simp only [map_pow, map_one, z, e.apply_symm_apply]
    exact Prod.ext x.property (by simp)
  have hzO : z ∈ O := Subgroup.subset_closure hz4
  let zO : O := ⟨z, hzO⟩
  have hnormal (w : O) : ∃ (a : ℕ) (b : B),
      (w : H) = z ^ a * e.symm (1, b) := by
    have hw4 := omega_four e w.property
    have hc : (e (w : H)).1 ∈ C := by
      change (e (w : H)).1 ^ 4 = 1
      have he : e (w : H) ^ 4 = 1 := by rw [← map_pow, hw4, map_one]
      exact congrArg Prod.fst he
    obtain ⟨a, ha⟩ := exists_power hx ⟨(e (w : H)).1, hc⟩
    refine ⟨a, (e (w : H)).2, ?_⟩
    apply e.injective
    simp only [map_mul, map_pow, z, e.apply_symm_apply]
    apply Prod.ext
    · simpa using (congrArg (fun y : C => (y : A n)) ha).symm
    · simp
  have hB (k : K) (b : B) : f k (e.symm (1, b)) = e.symm (1, b) := by
    apply hfix
    apply e.injective
    simp only [map_pow, map_one, e.apply_symm_apply]
    exact Prod.ext (by simp) (B_sq b)
  have hext (k l : K) (he : f k z = f l z) : r k = r l := by
    apply MulEquiv.ext
    intro w
    apply Subtype.ext
    change f k (w : H) = f l (w : H)
    obtain ⟨a, b, hw⟩ := hnormal w
    rw [hw, map_mul, map_pow, hB, map_mul, map_pow, hB, he]
  have hsq (a : r.range) : (((a : MulAut O) zO : O) : H) ^ 2 = z ^ 2 := by
    obtain ⟨k, hk⟩ := a.property
    rw [← hk]
    change (f k z) ^ 2 = z ^ 2
    rw [← map_pow]
    apply hfix
    simpa only [← pow_mul] using hz4
  let j : r.range → (powMonoidHom 2 : G n →* G n).ker := fun a =>
    ⟨e (((a : MulAut O) zO : O) : H) * (e z)⁻¹, by
      change (e (((a : MulAut O) zO : O) : H) * (e z)⁻¹) ^ 2 = 1
      rw [mul_pow, inv_pow, ← map_pow, hsq, map_pow, mul_inv_cancel]⟩
  have hj : Function.Injective j := by
    intro a b hab
    have he : (((a : MulAut O) zO : O) : H) = (((b : MulAut O) zO : O) : H) := by
      apply e.injective
      exact mul_right_cancel (congrArg Subtype.val hab)
    obtain ⟨k, hk⟩ := a.property
    obtain ⟨l, hl⟩ := b.property
    apply Subtype.ext
    rw [← hk, ← hl]
    apply hext
    rw [← hk, ← hl] at he
    exact he
  exact (Nat.card_le_card_of_injective j hj).trans_eq (card_square_kernel n hn)
end AbelianCyclicTwoFixedAut

/-- An action on a cyclic two-group times `C₂` fixing all elements of square one
has pairwise commuting automorphisms. -/
public theorem abelian_cyclic_two_fixed_aut_commute_of_equiv
    {H K : Type*} [Group H] [Group K] {n : ℕ} (hn : 2 ≤ n)
    (e : H ≃* (Multiplicative (ZMod (2 ^ n)) × Multiplicative (ZMod 2)))
    (f : K →* MulAut H)
    (hfix : ∀ k : K, ∀ x : H, x ^ 2 = 1 → f k x = x) :
    ∀ k l : K, Commute (f k) (f l) := by
  intro k l
  have hF (j : K) (z : AbelianCyclicTwoFixedAut.G n) (hz : z ^ 2 = 1) :
      (MulAut.congr e) (f j) z = z := by
    change e (f j (e.symm z)) = z
    rw [hfix j (e.symm z) (by rw [← map_pow, hz, map_one]), e.apply_symm_apply]
  change f k * f l = f l * f k
  apply (MulAut.congr e).injective
  simpa only [map_mul] using
    (AbelianCyclicTwoFixedAut.model_commute (by omega : 1 ≤ n)
      ((MulAut.congr e) (f k)) ((MulAut.congr e) (f l)) (hF k) (hF l)).eq

/-- The restriction to second omega of an action on a cyclic two-group times
`C₂` fixing all elements of square one has image of order at most four. -/
public theorem abelian_cyclic_two_fixed_aut_omega_two_range_card_le_four_of_equiv
    {H K : Type*} [Group H] [Group K] {n : ℕ} (hn : 2 ≤ n)
    (e : H ≃* (Multiplicative (ZMod (2 ^ n)) × Multiplicative (ZMod 2)))
    (f : K →* MulAut H)
    (hfix : ∀ k : K, ∀ x : H, x ^ 2 = 1 → f k x = x) :
    let := omega_characteristic H (p := 2) 2
    Nat.card (((MulAut.characteristic (omega H (p := 2) 2)).comp f).range) ≤ 4 :=
  AbelianCyclicTwoFixedAut.card_restriction (by omega) e f hfix
