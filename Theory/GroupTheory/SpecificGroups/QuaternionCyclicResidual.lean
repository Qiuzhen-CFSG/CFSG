module

public import Theory.GroupTheory.SpecificGroups.QuaternionCyclicAutomorphisms
public import Theory.GroupTheory.SpecificGroups.QuaternionEightResidual
public import Theory.GroupTheory.CentralCharacteristicAutomorphisms
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# Residual automorphisms of Q₈ ◦ C₄

The automorphism decomposition identifies the literal two-residual with the
faithfully extended quaternion residual. The four-diagonal quaternion action
then identifies it with A₄. Transporting the quaternion generators shows that
it is exactly the join of the inner automorphisms and the specified cubic.

The quotient action is retained in the explicit C₂² coordinates of the model;
its residual image is generated by the specified cubic map.
For a finite acting group whose image contains the inner actions and cubic,
residual monotonicity and the two-perfectness of the intrinsic residual
identify its residual image as well.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Lemma 14.2.21, printed p.988 (PDF page 1005).
-/

public section

namespace QuaternionCyclic

/-- Inner automorphisms and the specified cubic generate the literal two-residual. -/
theorem residual_eq_join : pResidual 2 (MulAut Model) =
    (MulAut.conj : Model →* MulAut Model).range ⊔ Subgroup.zpowers cubic := by
  have hn : quaternionCubic ≠ 1 := by
    intro h
    apply cubic_ne_one
    change extendAutHom quaternionCubic = 1
    rw [h, map_one]
  rw [pResidual_eq_map_extendAutHom, QuaternionGroup.Residual.residual_eq_join quaternionCubic
    quaternionCubic_cube hn, Subgroup.map_sup, ← inner_range_eq_map, MonoidHom.map_zpowers]
  rfl

/-- Restriction to the embedded quaternion factor identifies the actual residuals. -/
noncomputable def residualQuaternionEquiv :
    pResidual 2 (MulAut Model) ≃* pResidual 2 (MulAut (QuaternionGroup 2)) :=
  (MulEquiv.subgroupCongr pResidual_eq_map_extendAutHom).trans
    ((pResidual 2 (MulAut (QuaternionGroup 2))).equivMapOfInjective
      extendAutHom extendAutHom_injective).symm

/-- Extending the restricted residual automorphism recovers its full action. -/
theorem residualQuaternionEquiv_action (a : pResidual 2 (MulAut Model)) :
    extendAutHom (residualQuaternionEquiv a) = a := by
  have h := ((pResidual 2 (MulAut (QuaternionGroup 2))).equivMapOfInjective
    extendAutHom extendAutHom_injective).apply_symm_apply
      (MulEquiv.subgroupCongr pResidual_eq_map_extendAutHom a)
  exact congrArg Subtype.val h

/-- The intrinsic residual is A₄, through the quaternion four-diagonal action. -/
noncomputable def residualEquivAlternating :
    pResidual 2 (MulAut Model) ≃* alternatingGroup (Fin 4) :=
  residualQuaternionEquiv.trans QuaternionGroup.Residual.residualEquivAlternating

/-- The A₄ identification is the permutation of quaternion diagonals induced
by restriction of the original automorphism. -/
theorem residualEquivAlternating_apply (a : pResidual 2 (MulAut Model)) :
    (residualEquivAlternating a : Equiv.Perm (Fin 4)) =
      QuaternionGroup.Residual.autEquivPerm (restrictionHom a) := by
  have h := congrArg restrictionHom (residualQuaternionEquiv_action a)
  rw [restrictionHom_extendAutHom] at h
  change (QuaternionGroup.Residual.residualEquivAlternating (residualQuaternionEquiv a) :
    Equiv.Perm (Fin 4)) = _
  rw [QuaternionGroup.Residual.residualEquivAlternating_apply, h]

/-- The residual fixes the entire central cyclic factor pointwise. -/
theorem residual_fixes_center {a : MulAut Model} (ha : a ∈ pResidual 2 (MulAut Model))
    (x : Model) (hx : x ∈ Subgroup.center Model) : a x = x := by
  rw [center_eq_cyclic] at hx
  obtain ⟨c, rfl⟩ := hx
  rw [← extend_restriction_of_sign_one a (pResidual_le_centralSign_ker ha)]
  exact extendAut_cyclic _ _

/-- For a finite acting group, containing the inner actions and cubic already
forces its residual image to be the full intrinsic residual. -/
theorem residual_image_of_range_contains {P : Type*} [Group P] [Finite P]
    (ρ : P →* MulAut Model)
    (hi : (MulAut.conj : Model →* MulAut Model).range ≤ ρ.range)
    (hc : cubic ∈ ρ.range) :
    (pResidual 2 P).map ρ = pResidual 2 (MulAut Model) := by
  apply le_antisymm (Subgroup.map_pResidual_le 2 ρ)
  have hle : pResidual 2 (MulAut Model) ≤ ρ.range := by
    rw [residual_eq_join]
    exact sup_le hi (Subgroup.zpowers_le.mpr hc)
  have hmono := Subgroup.embedded_pResidual_mono 2 hle
  have hperfect := (pResidual_eq_top_iff 2 (pResidual 2 (MulAut Model))).mpr
    (Subgroup.isPPerfect_pResidual 2)
  rw [hperfect, ← MonoidHom.range_eq_map, Subgroup.range_subtype] at hmono
  rw [← Subgroup.map_pResidual_of_surjective 2 ρ.rangeRestrict ρ.rangeRestrict_surjective,
    Subgroup.map_map, MonoidHom.subtype_comp_rangeRestrict] at hmono
  exact hmono

/-- The action induced on the actual central quotient, in its C₂² coordinates. -/
noncomputable def quotientAction : MulAut Model →* MulAut CentralQuotient :=
  (MulAut.congr centralQuotientEquiv).toMonoidHom.comp
    (Subgroup.quotientAut (Subgroup.center Model))

/-- Equivariance with the given quotient map for every automorphism. -/
theorem quotientAction_apply (a : MulAut Model) (x : Model) :
    quotientAction a (centralQuotient x) = centralQuotient (a x) := by
  change centralQuotientEquiv ((Subgroup.quotientAut (Subgroup.center Model) a)
    (centralQuotientEquiv.symm (centralQuotient x))) = _
  rw [← centralQuotientEquiv_mk, centralQuotientEquiv.symm_apply_apply,
    Subgroup.quotientAut_apply_mk, centralQuotientEquiv_mk]

/-- The cubic induces the specified coordinate map `(a,b) ↦ (b,a+b)`. -/
theorem quotientAction_cubic : quotientAction cubic = cubicQuotient := by
  apply MulEquiv.ext
  intro y
  obtain ⟨x, rfl⟩ := centralQuotient_surjective y
  rw [quotientAction_apply, cubic_centralQuotient]

/-- The marked quotient actor has order three. -/
theorem cubicQuotient_order : orderOf cubicQuotient = 3 := by
  apply orderOf_eq_prime
  · rw [← quotientAction_cubic, ← map_pow, cubic_cube, map_one]
  · intro h
    have hh := DFunLike.congr_fun h (Multiplicative.ofAdd (1, 0))
    exact (by decide : cubicQuotient (Multiplicative.ofAdd (1, 0)) ≠
      Multiplicative.ofAdd (1, 0)) hh

/-- Inner automorphisms act trivially on the abelian central quotient. -/
theorem quotientAction_inner (x : Model) : quotientAction (MulAut.conj x) = 1 := by
  apply MulEquiv.ext
  intro y
  obtain ⟨t, rfl⟩ := centralQuotient_surjective y
  rw [quotientAction_apply]
  change centralQuotient (x * t * x⁻¹) = centralQuotient t
  simp only [map_mul, map_inv]
  rw [mul_comm (centralQuotient x), mul_inv_cancel_right]

/-- The exact quotient action image of the residual is the specified cubic subgroup. -/
theorem residual_quotient_image :
    (pResidual 2 (MulAut Model)).map quotientAction = Subgroup.zpowers cubicQuotient := by
  rw [residual_eq_join, Subgroup.map_sup, MonoidHom.map_zpowers, quotientAction_cubic]
  have h : ((MulAut.conj : Model →* MulAut Model).range).map quotientAction = ⊥ := by
    apply le_antisymm ?_ bot_le
    rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    exact quotientAction_inner x
  rw [h, bot_sup_eq]

end QuaternionCyclic

end
