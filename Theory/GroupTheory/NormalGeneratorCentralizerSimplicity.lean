module

public import Mathlib.GroupTheory.IsPerfect
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.GroupTheory.Subgroup.Simple
public import Mathlib.Order.Atoms

/-!
# Simplicity from a maximal centralizer of a normal generator

Let `t` normally generate a perfect group. If `C(t)` is maximal, each normal
subgroup is central or is the whole group. Indeed, a normal subgroup contained
in `C(t)` centralizes every conjugate of `t`. Otherwise it supplements `C(t)`,
so the image of `t` in the quotient is central; normal generation and perfectness
then make that quotient trivial. If moreover `Z(C(t))` consists of `1` and `t`,
properness of `C(t)` eliminates the ambient center and proves simplicity.

This is the group-theoretic argument of
`Theory.SpecificGroups.BabyMonster.NormalSubgroups.Reduction`, extracted here
without any dependence on a particular group construction. It is an elementary
centralizer version of the Iwasawa argument.
-/

public section
namespace Subgroup

variable {G : Type*} [Group G] {t : G}

/-- Maximality of the centralizer of a normal generator reduces normal subgroups
of a perfect group to central subgroups and the whole group. -/
theorem normal_le_center_or_eq_top_of_normal_generator [Group.IsPerfect G]
    (hgen : ∀ (N : Subgroup G) [N.Normal], t ∈ N → N = ⊤)
    (hmax : IsCoatom (centralizer ({t} : Set G)))
    (N : Subgroup G) [N.Normal] : N ≤ center G ∨ N = ⊤ := by
  by_cases hNC : N ≤ centralizer ({t} : Set G)
  · left
    have ht : t ∈ centralizer (N : Set G) := by
      intro n hn
      exact mem_centralizer_singleton_iff.mp (hNC hn)
    have hC := hgen (centralizer (N : Set G)) ht
    intro n hn
    apply mem_center_iff.mpr
    intro g
    have hg : g ∈ centralizer (N : Set G) := by rw [hC]; trivial
    exact (hg n hn).symm
  · right
    have hsup : N ⊔ centralizer ({t} : Set G) = ⊤ := by
      apply hmax.lt_iff.mp
      exact lt_of_le_of_ne le_sup_right (fun he => hNC (he ▸ le_sup_left))
    let q := QuotientGroup.mk' N
    have ht : q t ∈ center (G ⧸ N) := by
      apply mem_center_iff.mpr
      intro x
      obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N x
      have hg : g ∈ N ⊔ centralizer ({t} : Set G) := by rw [hsup]; trivial
      obtain ⟨n, hn, c, hc, rfl⟩ := mem_sup_of_normal_left.mp hg
      have hnq : q n = 1 := (QuotientGroup.eq_one_iff _).mpr hn
      change q (n * c) * q t = q t * q (n * c)
      rw [map_mul, hnq, one_mul, ← map_mul, ← map_mul]
      exact congrArg q (mem_centralizer_singleton_iff.mp hc)
    have hpre := hgen ((center (G ⧸ N)).comap q) ht
    have hcomm : IsMulCommutative (G ⧸ N) := by
      apply center_eq_top_iff.mp
      apply top_unique
      intro x _
      obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N x
      have hg : g ∈ (center (G ⧸ N)).comap q := by rw [hpre]; trivial
      exact hg
    apply top_unique
    intro x _
    exact (QuotientGroup.eq_one_iff _).mp (Subsingleton.elim (q x) 1)

/-- A proper element centralizer with center contained in `{1,t}` forces the
ambient group to have trivial center. -/
theorem center_eq_bot_of_centralizer_center
    (hproper : centralizer ({t} : Set G) ≠ ⊤)
    (hcenter : ∀ z : centralizer ({t} : Set G),
      z ∈ center (centralizer ({t} : Set G)) → (z : G) = 1 ∨ (z : G) = t) :
    center G = ⊥ := by
  apply bot_unique
  intro z hz
  have hzC : z ∈ centralizer ({t} : Set G) := center_le_centralizer _ hz
  have hzZ : (⟨z, hzC⟩ : centralizer ({t} : Set G)) ∈
      center (centralizer ({t} : Set G)) := by
    apply mem_center_iff.mpr
    intro c
    exact Subtype.ext (mem_center_iff.mp hz c)
  rcases hcenter ⟨z, hzC⟩ hzZ with h | h
  · exact mem_bot.mpr h
  · exfalso
    apply hproper
    apply top_unique
    intro g _
    apply mem_centralizer_singleton_iff.mpr
    rw [← h]
    exact mem_center_iff.mp hz g

/-- A centerless perfect group with a normal generator whose centralizer is
maximal is simple. -/
theorem isSimpleGroup_of_normal_generator_maximal_centralizer
    [Nontrivial G] [Group.IsPerfect G]
    (hgen : ∀ (N : Subgroup G) [N.Normal], t ∈ N → N = ⊤)
    (hmax : IsCoatom (centralizer ({t} : Set G)))
    (hcenter : center G = ⊥) : IsSimpleGroup G := by
  apply IsSimpleGroup.mk
  intro N hN
  rcases normal_le_center_or_eq_top_of_normal_generator hgen hmax N with h | h
  · exact Or.inl (bot_unique (h.trans_eq hcenter))
  · exact Or.inr h

/-- A perfect group normally generated by `t` is simple if `C(t)` is maximal
and its center is contained in `{1,t}`. -/
theorem isSimpleGroup_of_normal_generator_centralizer [Nontrivial G] [Group.IsPerfect G]
    (hgen : ∀ (N : Subgroup G) [N.Normal], t ∈ N → N = ⊤)
    (hmax : IsCoatom (centralizer ({t} : Set G)))
    (hcenter : ∀ z : centralizer ({t} : Set G),
      z ∈ center (centralizer ({t} : Set G)) → (z : G) = 1 ∨ (z : G) = t) :
    IsSimpleGroup G := by
  exact isSimpleGroup_of_normal_generator_maximal_centralizer hgen hmax
    (center_eq_bot_of_centralizer_center hmax.ne_top hcenter)

end Subgroup
