module
public import Theory.GroupTheory.QuaternionGenerated
public import Mathlib.GroupTheory.Subgroup.Center
public import Mathlib.Tactic.Positivity

/-!
# The center of an explicit semidihedral presentation

Suppose `n ≥ 4`, the generators `a, b` have orders `2^(n-1)` and two,
conjugation by `b` sends `a` to `a^(2^(n-2)-1)`, and together they generate
`G`. Then `Semidihedral.center_eq` identifies the actual center with the
cyclic subgroup generated by `a^(2^(n-2))`. No semidihedral classification
predicate or finiteness instance is needed.

The bounded normal forms specialize `Subgroup.square_normal_form_int` to
`b² = 1` and reduce integer exponents modulo the order of `a`. A central
element cannot have form `a^i*b`, since the two generators do not commute.
For a central power `a^i`, conjugation forces `2^(n-1)` to divide
`(2^(n-2)-2)*i`; cancellation of two and the remaining odd factor forces
`2^(n-2)` to divide `i`. Conversely, the half-order power commutes with both
normal forms. The supporting results retain forwarding APIs in the ABG
presentation development.

This extracts the explicit center calculation for Alperin–Brauer–Gorenstein,
Chapter II, §1, Lemma 1(v), article p. 9, from the presentation on article
p. 2 (`refs/latex/alperin-brauer-gorenstein.tex`). Our order parameter is one
larger than the article's. The quotient-dihedral assertion is not used here.
-/

namespace Semidihedral
variable {G : Type*} [Group G]

/-- Move the involutory generator past a natural power of the cyclic generator. -/
public theorem move_pow (a b : G) (k : ℕ)
    (hconj : b * a * b⁻¹ = a ^ k) (i : ℕ) :
    b * a ^ i = a ^ (k * i) * b := by
  have h := congrArg (fun y : G => y ^ i) hconj
  rw [← MulAut.conj_apply, ← map_pow, MulAut.conj_apply, ← pow_mul] at h
  calc
    b * a ^ i = (b * a ^ i * b⁻¹) * b := by group
    _ = a ^ (k * i) * b := congrArg (· * b) h

/-- Every element of a group with this presentation has one of the two bounded normal forms. -/
public theorem normal_form (a b : G) (m k : ℕ)
    (hm : 0 < m) (ha : orderOf a = m) (hb : b ^ 2 = 1)
    (hconj : b * a * b⁻¹ = a ^ k)
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤) (x : G) :
    ∃ i : ℕ, i < m ∧ (x = a ^ i ∨ x = a ^ i * b) := by
  have hx : x ∈ Subgroup.closure ({a, b} : Set G) := by rw [hgen]; trivial
  obtain ⟨z, hz⟩ := Subgroup.square_normal_form_int a b k 0
    (by simpa only [zpow_zero] using hb) hconj x hx
  have hm' : (0 : ℤ) < m := Int.natCast_pos.mpr hm
  have hnonneg := Int.emod_nonneg z (ne_of_gt hm')
  have hlt := Int.emod_lt_of_pos z hm'
  refine ⟨(z % m).toNat, ?_, ?_⟩
  · exact_mod_cast (show ((z % m).toNat : ℤ) < m by simpa [Int.toNat_of_nonneg hnonneg] using hlt)
  · have heq : a ^ (z % (m : ℤ)).toNat = a ^ z := by
      rw [← zpow_natCast, Int.toNat_of_nonneg hnonneg, ← ha, zpow_mod_orderOf]
    simpa only [heq] using hz

/-- The cyclic and involutory generators in the quasi-dihedral presentation
do not commute; only the cyclic generator order and conjugation are needed. -/
public theorem generators_not_commute {S : Type*} [Group S] {n : ℕ} (hn : 4 ≤ n)
    {a b : S} (ha : orderOf a = 2 ^ (n - 1))
    (hab : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1)) : ¬ Commute a b := by
  intro hcomm
  have hfour : 4 ≤ 2 ^ (n - 2) := by
    calc
      4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ (n - 2) := Nat.pow_le_pow_right (by omega) (by omega)
  have hlt : 2 ^ (n - 2) < 2 ^ (n - 1) :=
    Nat.pow_lt_pow_right (by omega) (by omega)
  have heq : a ^ 1 = a ^ (2 ^ (n - 2) - 1) := by
    simpa only [hcomm.eq.symm, mul_assoc, mul_inv_cancel, mul_one, pow_one] using hab
  have heq' := pow_inj_mod.mp heq
  rw [ha, Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)] at heq'
  omega


/-- The conjugation exponent fixes a cyclic power only when its exponent is
  divisible by the half-order. This cancels a factor of two and an odd factor. -/
public theorem half_order_dvd {n i : ℕ} (hn : 4 ≤ n)
    (h : 2 ^ (n - 1) ∣ (2 ^ (n - 2) - 2) * i) : 2 ^ (n - 2) ∣ i := by
  have he1 : n - 1 = (n - 2) + 1 := by omega
  have he2 : n - 2 = (n - 3) + 1 := by omega
  have hp : 0 < 2 ^ (n - 3) := by positivity
  have he : 2 ^ (n - 2) - 2 = 2 * (2 ^ (n - 3) - 1) := by
    rw [he2, pow_succ]
    omega
  have hd : 2 ^ (n - 2) ∣ (2 ^ (n - 3) - 1) * i := by
    rw [he1, pow_succ, he] at h
    have h' : 2 * 2 ^ (n - 2) ∣ 2 * ((2 ^ (n - 3) - 1) * i) := by
      simpa only [Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using h
    exact (Nat.mul_dvd_mul_iff_left (by decide : 0 < 2)).mp h'
  have hodd : Odd (2 ^ (n - 3) - 1) := by
    have he3 : n - 3 = (n - 4) + 1 := by omega
    rw [he3, pow_succ]
    refine ⟨2 ^ (n - 4) - 1, ?_⟩
    have : 0 < 2 ^ (n - 4) := by positivity
    omega
  exact ((hodd.coprime_two_left.pow_left (n - 2)).dvd_mul_left).mp hd

/-- The center is the subgroup generated by the half-order power of the cyclic generator. -/
public theorem center_eq {n : ℕ} (hn : 4 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤) :
    Subgroup.center G = Subgroup.zpowers (a ^ (2 ^ (n - 2))) := by
  have hnoncomm := generators_not_commute hn ha hconj
  have hb2 : b ^ 2 = 1 := by rw [← hb]; exact pow_orderOf_eq_one b
  have hlow : 2 ≤ 2 ^ (n - 2) := by
    calc
      2 = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ (n - 2) := Nat.pow_le_pow_right (by omega) (by omega)
  apply le_antisymm
  · intro x hx
    obtain ⟨i, _, rfl | rfl⟩ := normal_form a b _ _ (by positivity) ha hb2 hconj hgen x
    · have heq : a ^ ((2 ^ (n - 2) - 1) * i) = a ^ i := by
        apply mul_right_cancel (b := b)
        rw [← move_pow a b _ hconj i]
        exact Subgroup.mem_center_iff.mp hx b
      have hd : 2 ^ (n - 1) ∣ (2 ^ (n - 2) - 2) * i := by
        have h := (pow_eq_pow_iff_modEq.mp heq).symm.dvd'
        rw [ha] at h
        convert h using 1
        simp only [show 2 ^ (n - 2) - 2 = 2 ^ (n - 2) - 1 - 1 by omega,
          Nat.sub_mul, one_mul]
      obtain ⟨j, hj⟩ := half_order_dvd hn hd
      rw [hj, pow_mul]
      exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _
    · exfalso
      apply hnoncomm
      have h := Subgroup.mem_center_iff.mp hx a
      change a * b = b * a
      apply mul_left_cancel (a := a ^ i)
      calc
        a ^ i * (a * b) = a * (a ^ i * b) := by rw [← mul_assoc, (Commute.self_pow a i).symm.eq, mul_assoc]
        _ = (a ^ i * b) * a := h
        _ = a ^ i * (b * a) := mul_assoc _ _ _
  · apply Subgroup.zpowers_le.mpr
    apply Subgroup.mem_center_iff.mpr
    intro x
    have hbcomm : b * a ^ (2 ^ (n - 2)) = a ^ (2 ^ (n - 2)) * b := by
      rw [move_pow a b _ hconj _]
      congr 1
      apply pow_eq_pow_iff_modEq.mpr
      apply Nat.ModEq.symm
      apply (Nat.modEq_iff_dvd' (by
        have hpos : 1 ≤ 2 ^ (n - 2) - 1 := by omega
        simpa only [one_mul] using Nat.mul_le_mul_right (2 ^ (n - 2)) hpos)).mpr
      rw [ha]
      have he1 : n - 1 = (n - 2) + 1 := by omega
      have he2 : n - 2 = (n - 3) + 1 := by omega
      have he : 2 ^ (n - 2) - 2 = 2 * (2 ^ (n - 3) - 1) := by
        rw [he2, pow_succ]
        have : 0 < 2 ^ (n - 3) := by positivity
        omega
      refine ⟨2 ^ (n - 3) - 1, ?_⟩
      calc
        (2 ^ (n - 2) - 1) * 2 ^ (n - 2) - 2 ^ (n - 2) =
            (2 ^ (n - 2) - 2) * 2 ^ (n - 2) := by
          simp only [show 2 ^ (n - 2) - 2 = 2 ^ (n - 2) - 1 - 1 by omega,
            Nat.sub_mul, one_mul]
        _ = 2 ^ (n - 1) * (2 ^ (n - 3) - 1) := by rw [he, he1, pow_succ]; ring
    obtain ⟨i, _, rfl | rfl⟩ := normal_form a b _ _ (by positivity) ha hb2 hconj hgen x
    · exact (Commute.pow_pow_self a i (2 ^ (n - 2))).eq
    · calc
        (a ^ i * b) * a ^ (2 ^ (n - 2)) = a ^ i * (a ^ (2 ^ (n - 2)) * b) := by rw [mul_assoc, hbcomm]
        _ = a ^ (2 ^ (n - 2)) * (a ^ i * b) := by rw [← mul_assoc, (Commute.pow_pow_self a i (2 ^ (n - 2))).eq, mul_assoc]

end Semidihedral
