module
public import Theory.GroupTheory.CoprimeCentralizerDecomposition
public import Theory.GroupTheory.Commutator.CentralSylowTransfer
public import Theory.GroupTheory.AbelianQuotientFixedSubgroup
/-!
# A Sylow subgroup generated by coprime commutators

Suppose the fixed subgroup of a coprime actor on P lies in the ambient
center and derived subgroup. Sylow transfer puts the fixed subgroup in P′.
Coprime decomposition writes P=[P,D]C_P(D), and the central supplement
implies P′≤[P,D]. Thus P=[P,D].

This is the transfer step behind the natural-block torus calculation in
Aschbacher–Smith, Lemma 2.4.8(5), printed p.530.
-/
public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]

theorem sylow_commutator_eq_of_central_derived_fixed (P : Sylow p G) (D : Subgroup G)
    (hn : D ≤ normalizer (P : Set G))
    (hc : Nat.Coprime (Nat.card D) (Nat.card P))
    (hfix : (P : Subgroup G) ⊓ centralizer (D : Set G) ≤ center G ⊓ _root_.commutator G) :
    ⁅(P : Subgroup G),D⁆ = (P : Subgroup G) := by
  let C := (P : Subgroup G) ⊓ centralizer (D : Set G)
  let K := ⁅(P : Subgroup G),D⁆
  have hdec : (P : Subgroup G) = K ⊔ C := eq_commutator_sup_centralizer_of_solvable_coprime
    _ _ hn (@IsNilpotent.to_isSolvable P _ P.isPGroup'.isNilpotent) hc
  have hCP : C ≤ ⁅(P : Subgroup G),(P : Subgroup G)⁆ :=
    (le_inf hfix inf_le_left).trans (center_inf_commutator_inf_sylow_le_commutator P)
  have hCK : C ≤ normalizer (K : Set G) := inf_le_left.trans (normalizer_commutator_ge_left _ _)
  have hCC : ⁅C,C⁆ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr
    ((hfix.trans inf_le_left).trans (center_le_centralizer _))
  have hPP : ⁅(P : Subgroup G),(P : Subgroup G)⁆ ≤ K := by
    rw [hdec]
    exact commutator_sup_le_of_normalized_derived K C hCK (by rw [hCC];exact bot_le)
  apply le_antisymm (le_normalizer_iff_commutator_le_left.mp hn)
  change (P : Subgroup G) ≤ K
  exact hdec.le.trans (sup_le le_rfl (hCP.trans hPP))

end Subgroup
