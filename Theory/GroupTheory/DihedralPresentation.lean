module
public import Mathlib.GroupTheory.SpecificGroups.Dihedral
public import Mathlib.Algebra.Group.Conj
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# Recognition of the dihedral presentation

A group generated by `c` and `d` with `c ^ m = 1`, `d ^ 2 = 1`, and conjugation
by `d` inverting `c` is dihedral when `m > 0` and its cardinality is `2 * m`.
The exact-order formulation is included as a wrapper. These recognition results
identify the dihedral subgroups and central quotients in the elementary
quasidihedral analysis of Alperin–Brauer–Gorenstein, Chapter II, Lemma 1.1.

The proof maps the rotation and reflection constructors to `c ^ i.val` and
`d * c ^ i.val`. The relations verify multiplication, generation makes this map
surjective, and equality of finite cardinalities makes it bijective. Only the
recognition and cardinality theorems are public; the normal-form homomorphism is
private. In particular, two involutions whose product has exponent dividing
`m > 0` generate a finite subgroup of order at most `2 * m`, without any
finiteness assumption on the ambient group.
-/

private def rotation {G : Type*} [Group G] {m : ℕ} [NeZero m]
    (c : G) (hc : c ^ m = 1) : Multiplicative (ZMod m) →* G where
  toFun i := c ^ i.toAdd.val
  map_one' := by simp
  map_mul' i j := by
    change c ^ (i.toAdd + j.toAdd).val = c ^ i.toAdd.val * c ^ j.toAdd.val
    rw [ZMod.val_add, ← pow_add]
    exact (pow_eq_pow_mod (i.toAdd.val + j.toAdd.val) hc).symm

private theorem rotation_one {G : Type*} [Group G] {m : ℕ} [NeZero m]
    (c : G) (hc : c ^ m = 1) : rotation c hc (.ofAdd 1) = c := by
  change c ^ (1 : ZMod m).val = c
  rw [← Nat.cast_one, ZMod.val_natCast, ← pow_eq_pow_mod 1 hc, pow_one]

private def presentationHom {G : Type*} [Group G] {m : ℕ} [NeZero m]
    (c d : G) (hc : c ^ m = 1) (hd : d ^ 2 = 1)
    (hconj : d * c * d⁻¹ = c⁻¹) : DihedralGroup m →* G := by
  let f := rotation c hc
  have hswap (i : Multiplicative (ZMod m)) : f i * d = d * (f i)⁻¹ := by
    have hh : d * f i * d⁻¹ = (f i)⁻¹ := by
      change d * c ^ i.toAdd.val * d⁻¹ = (c ^ i.toAdd.val)⁻¹
      rw [← conj_pow, hconj, inv_pow]
    have dd : d * d = 1 := by simpa [pow_two] using hd
    calc
      f i * d = (d * d) * f i * d := by rw [dd, one_mul]
      _ = d * (d * f i * d⁻¹) := by
        have hi : d⁻¹ = d := inv_eq_of_mul_eq_one_right dd
        rw [hi]
        simp only [mul_assoc]
      _ = d * (f i)⁻¹ := by rw [hh]
  refine {
    toFun := fun x => match x with
      | .r i => f (.ofAdd i)
      | .sr i => d * f (.ofAdd i)
    map_one' := by change f 1 = 1; exact f.map_one
    map_mul' := ?_ }
  intro x y
  cases x with
  | r i =>
    cases y with
    | r j => exact f.map_mul (.ofAdd i) (.ofAdd j)
    | sr j =>
      change d * f (.ofAdd (j - i)) = f (.ofAdd i) * (d * f (.ofAdd j))
      rw [← mul_assoc, hswap, mul_assoc]
      rw [sub_eq_add_neg]
      change d * f ((.ofAdd j) * (.ofAdd i)⁻¹) = d * ((f (.ofAdd i))⁻¹ * f (.ofAdd j))
      rw [map_mul, map_inv]
      congr 1
      simpa only [map_inv] using (Commute.map (Commute.all (.ofAdd j) ((.ofAdd i)⁻¹)) f).eq
  | sr i =>
    cases y with
    | r j =>
      change d * f ((.ofAdd i) * (.ofAdd j)) = d * f (.ofAdd i) * f (.ofAdd j)
      rw [map_mul, mul_assoc]
    | sr j =>
      change f (.ofAdd (j - i)) = (d * f (.ofAdd i)) * (d * f (.ofAdd j))
      rw [mul_assoc d, ← mul_assoc (f (.ofAdd i)), hswap, ← mul_assoc d, ← mul_assoc d d]
      have dd : d * d = 1 := by simpa [pow_two] using hd
      rw [dd, one_mul]
      rw [sub_eq_add_neg]
      change f ((.ofAdd j) * (.ofAdd i)⁻¹) = (f (.ofAdd i))⁻¹ * f (.ofAdd j)
      rw [map_mul, map_inv]
      simpa only [map_inv] using (Commute.map (Commute.all (.ofAdd j) ((.ofAdd i)⁻¹)) f).eq

/-- Two involutions whose product has exponent dividing `m > 0` generate a
finite subgroup of order at most `2 * m`. -/
public theorem Subgroup.closure_pair_finite_card_le_of_involutions
    {G : Type*} [Group G] {m : ℕ} (hm : 0 < m)
    (a b : G) (ha : a ^ 2 = 1) (hb : b ^ 2 = 1)
    (hab : (b * a) ^ m = 1) :
    Finite (Subgroup.closure ({a, b} : Set G)) ∧
      Nat.card (Subgroup.closure ({a, b} : Set G)) ≤ 2 * m := by
  let : NeZero m := ⟨Nat.ne_of_gt hm⟩
  have haa : a * a = 1 := by simpa only [pow_two] using ha
  have hbb : b * b = 1 := by simpa only [pow_two] using hb
  have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right haa
  have hbi : b⁻¹ = b := inv_eq_of_mul_eq_one_right hbb
  have hconj : a * (b * a) * a⁻¹ = (b * a)⁻¹ := by
    simp only [mul_inv_rev, hai, hbi, mul_assoc, haa, mul_one]
  let f := presentationHom (b * a) a hab ha hconj
  have ha_mem : a ∈ f.range := by
    refine ⟨.sr 0, ?_⟩
    change a * rotation (b * a) hab 1 = a
    rw [map_one, mul_one]
  have hba_mem : b * a ∈ f.range := ⟨.r 1, rotation_one (b * a) hab⟩
  have hb_mem : b ∈ f.range := by
    simpa only [mul_assoc, haa, mul_one] using f.range.mul_mem hba_mem ha_mem
  have hle : Subgroup.closure ({a, b} : Set G) ≤ f.range := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact ha_mem
    · exact Set.mem_singleton_iff.mp hx ▸ hb_mem
  have hsurj := f.rangeRestrict_surjective
  let : Finite f.range := Finite.of_surjective _ hsurj
  let i := Subgroup.inclusion hle
  have hi : Function.Injective i := Subgroup.inclusion_injective hle
  refine ⟨Finite.of_injective i hi, ?_⟩
  calc
    Nat.card (Subgroup.closure ({a, b} : Set G)) ≤ Nat.card f.range :=
      Nat.card_le_card_of_injective i hi
    _ ≤ Nat.card (DihedralGroup m) := Nat.card_le_card_of_surjective _ hsurj
    _ = 2 * m := DihedralGroup.nat_card

/-- The dihedral relations, generation, and expected cardinality determine the group. -/
public theorem dihedralGroup_equiv_of_relations
    {G : Type*} [Group G] {m : ℕ} (hm : 0 < m)
    (c d : G) (hc : c ^ m = 1) (hd : d ^ 2 = 1)
    (hconj : d * c * d⁻¹ = c⁻¹)
    (hgen : Subgroup.closure ({c, d} : Set G) = ⊤)
    (hcard : Nat.card G = 2 * m) : Nonempty (G ≃* DihedralGroup m) := by
  let : NeZero m := ⟨Nat.ne_of_gt hm⟩
  let f := presentationHom c d hc hd hconj
  have hs : Function.Surjective f := by
    apply MonoidHom.range_eq_top.mp
    apply top_unique
    rw [← hgen]
    apply (Subgroup.closure_le f.range).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with hx | hx
    · subst x
      exact ⟨.r 1, rotation_one c hc⟩
    · have hx : x = d := Set.mem_singleton_iff.mp hx
      subst x
      refine ⟨.sr 0, ?_⟩
      change d * rotation c hc 1 = d
      rw [map_one, mul_one]
  exact ⟨(MulEquiv.ofBijective f (hs.bijective_of_nat_card_le
    (by rw [DihedralGroup.nat_card, hcard]))).symm⟩

/-- A group with a rotation of order `m`, an inverting involution, and the
expected order is dihedral. -/
public theorem dihedralGroup_equiv_of_presentation
    {G : Type*} [Group G] {m : ℕ} (hm : 0 < m)
    (c d : G) (hc : orderOf c = m) (hd : d ^ 2 = 1)
    (hconj : d * c * d⁻¹ = c⁻¹)
    (hgen : Subgroup.closure ({c, d} : Set G) = ⊤)
    (hcard : Nat.card G = 2 * m) : Nonempty (G ≃* DihedralGroup m) := by
  exact dihedralGroup_equiv_of_relations hm c d (hc ▸ pow_orderOf_eq_one c)
    hd hconj hgen hcard
