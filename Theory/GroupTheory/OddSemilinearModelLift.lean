module
public import Theory.GroupTheory.OddActionCentralTwoKernel
public import Theory.GroupTheory.CentralPGroupHomRigidity
public import Mathlib.GroupTheory.SemidirectProduct
public import Mathlib.Algebra.GroupWithZero.Action.End

/-!
# Lifting an odd complement into its actual semilinear model

A finite group H has normal subgroup L and odd complement E. An equivalence
identifies L with a finite model D, and an injective coefficient map identifies
E with actual automorphisms of D. Suppose a projective homomorphism from H
has the prescribed values on L and E, through an equivariant map q on D whose
kernel is a two-group and whose transported kernel is central in H.

If the coefficients fix a Sylow two-subgroup T of D pointwise, and L is
generated by its transported T and a subgroup L0 without a normal subgroup
of index two, the prescribed maps on L and E extend to an embedding of H
into the actual semidirect product D ⋊ A. The theorem retains the given
coefficient action, equivalence, maps, and original ambient group.

The projective equations make conjugation and the model action agree modulo
the central kernel. Central p-group homomorphism rigidity gives agreement
on L0. For each transported T point, the actual conjugation discrepancies
lie in the kernel, fixed by ambient centrality; the pointwise odd-action
lemma forces fixation. Agreement extends across the generating subgroup
join. Mathlib's complement equivalence and semidirect product map then give
the embedding and its specified values. Normality of L0 is unnecessary.

This formalizes the final action comparison in Alperin--Brauer--Gorenstein,
II.3 Proposition 3, article pages 27--28 (PDF pages 28--29). The source uses
perfectness for q > 3 and treats q = 3 separately; the no-normal-index-two
hypothesis gives a uniform sufficient condition for this abstract step.
-/

namespace Subgroup

/-- The actual projective complement action lifts through the central two-kernel,
with the prescribed linear and coefficient values. -/
public theorem exists_injective_semilinear_lift_of_odd_complement
    {H D Q A : Type*} [Group H] [Finite H] [Group D] [Finite D]
    [Group Q] [Group A]
    (L E : Subgroup H) [L.Normal] (hcomp : L.IsComplement' E)
    (hodd : Odd (Nat.card E)) (α : A →* MulAut D) (β : A →* MulAut Q)
    (eL : L ≃* D) (c : E →* A) (hc : Function.Injective c)
    (q : D →* Q) (hq : ∀ a d, q (α a d) = β a (q d))
    (hqtwo : IsPGroup 2 q.ker)
    (hZ : (q.ker.comap eL.toMonoidHom).map L.subtype ≤ center H)
    (f : H →* Q ⋊[β] A)
    (hfL : ∀ l : L, f l = SemidirectProduct.inl (q (eL l)))
    (hfE : ∀ e : E, f e = SemidirectProduct.inr (c e))
    (T : Sylow 2 D) (hT : ∀ (e : E) (t : T), α (c e) t.val = t.val)
    (L0 : Subgroup L)
    (hno : ∀ N : Subgroup L0, N.Normal → N.index ≠ 2)
    (hgen : L0 ⊔ (T : Subgroup D).comap eL.toMonoidHom = ⊤) :
    ∃ F : H →* D ⋊[α] A, Function.Injective F ∧
      (∀ l : L, F l = SemidirectProduct.inl (eL l)) ∧
      (∀ e : E, F e = SemidirectProduct.inr (c e)) := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let γ : E →* MulAut L :=
    L.normalizerMonoidHom.comp (inclusion (L.normalizer_eq_top ▸ le_top))
  let N := q.ker.comap eL.toMonoidHom
  have hNcentral : N ≤ center L := by
    intro n hn
    rw [mem_center_iff]
    intro l
    apply Subtype.ext
    exact mem_center_iff.mp (hZ (mem_map_of_mem L.subtype hn)) l.val
  have hqcentral : q.ker ≤ center D := by
    intro d hd
    rw [mem_center_iff]
    intro x
    have hn : eL.symm d ∈ N := by simpa [N] using hd
    have hh := mem_center_iff.mp (hNcentral hn) (eL.symm x)
    simpa using congrArg eL hh
  have hNtwo : IsPGroup 2 N := by
    let j : N →* q.ker :=
      (eL.toMonoidHom.comp N.subtype).codRestrict q.ker (fun n => n.property)
    exact hqtwo.of_injective j (fun x y h => Subtype.ext (eL.injective (congrArg Subtype.val h)))
  have hγ (e : E) (l : L) : (γ e l : H) = e * l * (e : H)⁻¹ := rfl
  have hproj (e : E) (l : L) : q (eL (γ e l)) = q (α (c e) (eL l)) := by
    apply SemidirectProduct.inl_injective (φ := β)
    rw [← hfL, hγ, map_mul, map_mul, map_inv, hfL, hfE, hq]
    simpa using (SemidirectProduct.inl_aut (φ := β) (c e) (q (eL l))).symm
  let : MulDistribMulAction E L := MulDistribMulAction.compHom L γ
  have hNfix : ∀ e : E, ∀ n ∈ N, e • n = n := by
    intro e n hn
    apply Subtype.ext
    change (γ e n : H) = n
    rw [hγ]
    have hh := mem_center_iff.mp (hZ (mem_map_of_mem L.subtype hn)) e.val
    change (e : H) * (n : H) = (n : H) * (e : H) at hh
    rw [hh, mul_inv_cancel_right]
  have hSfix (e : E) (s : L) (hs : s ∈ (T : Subgroup D).comap eL.toMonoidHom) :
      γ e s = s := by
    apply MulDistribMulAction.fixed_of_odd_of_central_two_discrepancy hodd N hNcentral
      hNtwo hNfix s _ e
    intro b
    change q (eL ((γ b s) * s⁻¹)) = 1
    rw [map_mul, map_inv, map_mul, map_inv, hproj, hT b ⟨eL s, hs⟩, mul_inv_cancel]
  have hagree (e : E) :
      eL.toMonoidHom.comp (γ e).toMonoidHom =
        (α (c e)).toMonoidHom.comp eL.toMonoidHom := by
    let u := eL.toMonoidHom.comp (γ e).toMonoidHom
    let v := (α (c e)).toMonoidHom.comp eL.toMonoidHom
    have h0 : u.comp L0.subtype = v.comp L0.subtype := by
      apply MonoidHom.eq_of_central_pgroup_discrepancy hno q.ker hqcentral hqtwo
      intro l
      change q (eL (γ e l.val) * (α (c e) (eL l.val))⁻¹) = 1
      rw [map_mul, map_inv, hproj, mul_inv_cancel]
    have hle : L0 ⊔ (T : Subgroup D).comap eL.toMonoidHom ≤ u.eqLocus v := by
      apply sup_le
      · intro l hl
        exact DFunLike.congr_fun h0 ⟨l, hl⟩
      · intro s hs
        change eL (γ e s) = α (c e) (eL s)
        rw [hSfix e s hs, hT e ⟨eL s, hs⟩]
    have hall : (⊤ : Subgroup L) ≤ u.eqLocus v := hgen ▸ hle
    exact DFunLike.ext _ _ (fun l => hall (mem_top l))
  let k := SemidirectProduct.mulEquivSubgroup hcomp
  let m : L ⋊[γ] E →* D ⋊[α] A := SemidirectProduct.map eL.toMonoidHom c hagree
  let F : H →* D ⋊[α] A := m.comp k.symm.toMonoidHom
  refine ⟨F, ?_, ?_, ?_⟩
  · change Function.Injective (m ∘ k.symm)
    apply Function.Injective.comp _ k.symm.injective
    intro x y h
    apply SemidirectProduct.ext
    · exact eL.injective (congrArg SemidirectProduct.left h)
    · exact hc (congrArg SemidirectProduct.right h)
  · intro l
    have hk : k.symm l = SemidirectProduct.inl l := by
      apply k.injective
      rw [k.apply_symm_apply]
      simp [k]
    change m (k.symm l) = _
    rw [hk]
    exact SemidirectProduct.map_inl _ _ _ _
  · intro e
    have hk : k.symm e = SemidirectProduct.inr e := by
      apply k.injective
      rw [k.apply_symm_apply]
      simp [k]
    change m (k.symm e) = _
    rw [hk]
    exact SemidirectProduct.map_inr _ _ _ _
end Subgroup
