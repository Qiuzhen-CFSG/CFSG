module
public import Theory.GroupTheory.CharacteristicCentralizerFusion
public import Mathlib.GroupTheory.FixedPointFree
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Containment from fixed-point-free conjugation

A fixed-point-free automorphism has a surjective commutator map. Applied
to an image, this lifts subgroup containment through the actual kernel.
Applied to the centralizer of R in P, where Y is generated by R and one
complement element, it places that centralizer in R when C_P(Y)=1 and
P intersects Y inside R. All normalization is relative to these subgroups.
Source application: Aschbacher–Smith 14.2.16 and 14.3.15, pp.986,994.
-/
public noncomputable section
open Subgroup
open scoped commutatorElement

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- A cyclic residual complement controls the centralizer inside a normalized subgroup. -/
theorem centralizer_le_of_fixedPointFree_residual_complement
    (P Y R : Subgroup G) (c : G)
    (hYP : Y ≤ normalizer (P : Set G))
    (hRN : Y ≤ normalizer (R : Set G))
    (hPY : P ≤ normalizer (Y : Set G))
    (hcY : c ∈ Y) (hgen : R ⊔ zpowers c = Y)
    (hcent : P ⊓ centralizer (Y : Set G) = ⊥) (hinter : P ⊓ Y ≤ R) :
    P ⊓ centralizer (R : Set G) ≤ R := by
  let C := P ⊓ centralizer (R : Set G)
  have hn : Y ≤ normalizer (C : Set G) :=
    (le_inf hYP (hRN.trans (normalizer_le_normalizer_centralizer R))).trans
      inf_normalizer_le_normalizer_inf
  let α : MulAut C := C.normalizerMonoidHom ⟨c,hn hcY⟩
  have hf : MonoidHom.FixedPointFree α.toMonoidHom := by
    intro x hx
    apply Subtype.ext
    have hxc : (x:G) ∈ centralizer ({c} : Set G) := by
      have hh := congrArg Subtype.val hx
      change c*(x:G)*c⁻¹=(x:G) at hh
      exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hh).symm
    have hxY : (x:G) ∈ centralizer (Y : Set G) := by
      have hYx : Y ≤ centralizer ({(x:G)} : Set G) := by
        rw [←hgen]
        exact sup_le (fun r hr => mem_centralizer_singleton_iff.mpr (x.property.2 r hr))
          (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr
            (mem_centralizer_singleton_iff.mp hxc).symm))
      exact fun y hy => mem_centralizer_singleton_iff.mp (hYx hy)
    exact mem_bot.mp (hcent ▸ (show (x:G) ∈ P ⊓ centralizer (Y : Set G) from
      ⟨x.property.1,hxY⟩))
  intro x hx
  obtain ⟨y,hy⟩ := hf.commutatorMap_surjective (⟨x,hx⟩ : C)
  have hcomm : ⁅P,Y⁆ ≤ P ⊓ Y := le_inf
    (le_normalizer_iff_commutator_le_left.mp hYP)
    (le_normalizer_iff_commutator_le_right.mp hPY)
  have he : (y:G) / (α y:G) = x := congrArg Subtype.val hy
  have he' : ⁅(y:G),c⁆ = x := by
    change (y:G) / (c*(y:G)*c⁻¹) = x at he
    simpa only [div_eq_mul_inv,mul_inv_rev,inv_inv,commutatorElement_def,mul_assoc] using he
  exact he' ▸ hinter (hcomm (commutator_mem_commutator y.property.1 hcY))

omit [Finite G] in
/-- Fixed-point-free action on the literal image lifts containment through its kernel. -/
theorem le_of_fixedPointFree_image
    {H : Type*} [Group H] [Finite H] (f : G →* H) (R K : Subgroup G) (c : G)
    (hc : c ∈ normalizer (R : Set G)) (hcK : c ∈ K)
    (hn : R ≤ normalizer (K : Set G)) (hk : R ⊓ f.ker ≤ K)
    (hfix : ∀ x ∈ R, f (c*x*c⁻¹) = f x → f x = 1) : R ≤ K := by
  let A := R.map f
  have hfc : f c ∈ normalizer (A : Set H) :=
    R.le_normalizer_map f (mem_map_of_mem f hc)
  let α : MulAut A := A.normalizerMonoidHom ⟨f c,hfc⟩
  have hf : MonoidHom.FixedPointFree α.toMonoidHom := by
    intro a ha
    obtain ⟨x,hx,he⟩ := a.property
    apply Subtype.ext
    change a.val = 1
    rw [←he]
    apply hfix x hx
    have hh := congrArg Subtype.val ha
    change f c * a.val * (f c)⁻¹ = a.val at hh
    simpa only [map_mul,map_inv,he] using hh
  intro r hr
  obtain ⟨a,ha⟩ := hf.commutatorMap_surjective (⟨f r,mem_map_of_mem f hr⟩ : A)
  obtain ⟨x,hx,he⟩ := a.property
  have hxf : f ⁅x,c⁆ = f r := by
    have hh := congrArg Subtype.val ha
    change a.val / (f c*a.val*(f c)⁻¹) = f r at hh
    rw [←he] at hh
    simpa only [map_mul,map_inv,commutatorElement_def,div_eq_mul_inv,mul_inv_rev,
      inv_inv,mul_assoc] using hh
  have hwR : ⁅x,c⁆ ∈ R := by
    have hh := (mem_normalizer_iff.mp hc x⁻¹).mp (R.inv_mem hx)
    simpa only [commutatorElement_def,mul_assoc] using R.mul_mem hx hh
  have hwK : ⁅x,c⁆ ∈ K := le_normalizer_iff_commutator_le_right.mp hn
    (commutator_mem_commutator hx hcK)
  have hdiv : r / ⁅x,c⁆ ∈ K := hk ⟨R.div_mem hr hwR,by
    change f (r / ⁅x,c⁆) = 1
    rw [map_div,hxf,div_self']⟩
  simpa only [div_mul_cancel] using K.mul_mem hdiv hwK
end Subgroup
