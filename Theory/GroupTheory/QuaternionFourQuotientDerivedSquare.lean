/-!
# A derived square in a quaternion index-four extension

Let a self-centralizing core of order 32 be generated by two commuting normal
quaternion factors meeting in order two. If its index in a finite two-group
is four, the simultaneous factor action has order 64 and equals the product
of its two order-eight images. Thus every pair of factor actions lifts.

Suppose the fixed subgroup in the core of an involution `t` is elementary.
An inner quaternion automorphism fixes an element of order four, so the action
of `t` on either factor is outer. On the first factor choose the axis-fixing
inner twist from `QuaternionEightAxisTwist`; pair it with the identity action
on the second factor. Its lift `d` centralizes the fixed subgroup: the first
component of a fixed core element has central displacement and is fixed by
the selected twist.

The commutator of `t` and `d` lies in the core because the core quotient is
abelian. It centralizes the second factor, hence lies in the first. Its action
on that factor is nontrivial, so it cannot have square one. Both `t` and `d`
centralize the fixed subgroup, giving the required derived-square witness.

Factor normality is an explicit hypothesis. No fusion assumptions or bounds
on nonnormal elementary subgroups enter the argument; even extraspeciality,
normality and order four of the fixed subgroup are unnecessary here.

Source: Janko–Thompson, Math. Z. 113 (1970), §4 case (b)(ii), printed p.391,
with the structural references on p.386.
-/

open scoped Pointwise commutatorElement
namespace Subgroup
variable {T : Type*} [Group T] [Finite T]

omit [Finite T] in
private theorem action_card_dvd_eight (hT : IsPGroup 2 T)
    {Q : Type*} [Group Q] [Finite Q] (e : Q ≃* QuaternionGroup 2)
    (f : T →* MulAut Q) : Nat.card f.range ∣ 8 := by
  have hcard : Nat.card (MulAut Q) = 24 :=
    (Nat.card_congr (MulAut.congr e).toEquiv).trans QuaternionGroup.card_mulAut_two
  have hd := f.range.card_subgroup_dvd_card
  rw [hcard] at hd
  obtain ⟨n, hn⟩ := (hT.of_surjective f.rangeRestrict f.rangeRestrict_surjective).exists_card_eq
  have hnle : n ≤ 3 := by
    by_contra h
    have hh : 16 ∣ 24 := (show 2^4 ∣ 2^n from pow_dvd_pow 2 (by omega)).trans (hn ▸ hd)
    norm_num at hh
  rw [hn]
  exact pow_dvd_pow 2 hnle

omit [Finite T] in
private theorem conjNormal_ker (B : Subgroup T) [B.Normal] :
    (MulAut.conjNormal : T →* MulAut B).ker = centralizer (B : Set T) := by
  ext g
  constructor
  · intro hg b hb
    have hh := congrArg (fun e : MulAut B => (e ⟨b, hb⟩ : T)) hg
    change g*b*g⁻¹=b at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm
  · intro hg
    apply MulEquiv.ext
    intro b
    apply Subtype.ext
    change g*(b:T)*g⁻¹=b
    rw [← hg b b.property, mul_inv_cancel_right]

/-- The actions on normal quaternion factors of a self-centralizing core in
an order-128 two-group are independent, and each image has order eight. -/
public theorem quaternion_normal_factor_action_product
    (hT : IsPGroup 2 T) (hcard : Nat.card T = 128)
    (B C : Subgroup T) [B.Normal] [C.Normal]
    (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hinter : Nat.card (B ⊓ C : Subgroup T) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b*c=c*b)
    (hself : centralizer ((B ⊔ C : Subgroup T) : Set T) ≤ B ⊔ C) :
    let f : T →* MulAut B := MulAut.conjNormal
    let g : T →* MulAut C := MulAut.conjNormal
    Nat.card f.range = 8 ∧ Nat.card g.range = 8 ∧
      (f.prod g).range = f.range.prod g.range := by
  classical
  let f : T →* MulAut B := MulAut.conjNormal
  let g : T →* MulAut C := MulAut.conjNormal
  let J := B ⊔ C
  have hk : (f.prod g).ker = centralizer (J : Set T) := by
    have heq : (f.prod g).ker = f.ker ⊓ g.ker := by
      ext x
      change (f x, g x) = (1, 1) ↔ f x = 1 ∧ g x = 1
      simp only [Prod.mk.injEq]
    rw [heq, conjNormal_ker B, conjNormal_ker C]
    apply le_antisymm
    · intro x hx
      have hle : J ≤ centralizer ({x} : Set T) := sup_le
        (fun b hb => mem_centralizer_singleton_iff.mpr (hx.1 b hb))
        (fun c hc => mem_centralizer_singleton_iff.mpr (hx.2 c hc))
      exact fun y hy => mem_centralizer_singleton_iff.mp (hle hy)
    · intro x hx
      exact ⟨fun b hb => hx b (mem_sup_left hb), fun c hc => hx c (mem_sup_right hc)⟩
  have hcenter : centralizer (J : Set T) = (center J).map J.subtype := by
    ext x
    constructor
    · intro hx
      exact ⟨⟨x, hself hx⟩, mem_center_iff.mpr
        (fun y => Subtype.ext (hx y y.property)), rfl⟩
    · rintro ⟨x, hx, rfl⟩ y hy
      exact congrArg Subtype.val (mem_center_iff.mp hx ⟨y,hy⟩)
  have hkcard : Nat.card (f.prod g).ker = 2 := by
    rw [hk, hcenter, card_map_of_injective J.subtype_injective]
    exact quaternion_central_product_center_card B C hB hC hinter hcomm
  have hrange : Nat.card (f.prod g).range = 64 := by
    have hc := (f.prod g).ker.card_mul_index
    rw [index_ker, hkcard, hcard] at hc
    omega
  obtain ⟨eB⟩ := hB
  obtain ⟨eC⟩ := hC
  have hfle : Nat.card f.range ≤ 8 := Nat.le_of_dvd (by decide) (action_card_dvd_eight hT eB f)
  have hgle : Nat.card g.range ≤ 8 := Nat.le_of_dvd (by decide) (action_card_dvd_eight hT eC g)
  have hle : (f.prod g).range ≤ f.range.prod g.range := by
    rintro _ ⟨x, rfl⟩
    exact ⟨⟨x,rfl⟩, ⟨x,rfl⟩⟩
  have hcprod : Nat.card (f.range.prod g.range) = Nat.card f.range * Nat.card g.range := by
    rw [Nat.card_congr (prodEquiv f.range g.range).toEquiv, Nat.card_prod]
  have hge := card_le_of_le hle
  rw [hrange, hcprod] at hge
  have hf : Nat.card f.range = 8 := by nlinarith
  have hg : Nat.card g.range = 8 := by nlinarith
  exact ⟨hf, hg, eq_of_le_of_card_ge hle (by rw [hcprod, hf, hg, hrange])⟩
end Subgroup

namespace Subgroup
variable {T : Type*} [Group T] [Finite T]

private theorem join_inf_quaternion_centralizer (B C : Subgroup T)
    (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hinter : Nat.card (B ⊓ C : Subgroup T) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b * c = c * b) :
    (B ⊔ C) ⊓ centralizer (B : Set T) = C := by
  apply le_antisymm
  · intro x hx
    have hn : B ≤ normalizer (C : Set T) := by
      apply le_trans ?_ (centralizer_le_normalizer _)
      exact fun b hb c hc => (hcomm b hb c hc).symm
    have hx' : x ∈ (↑(B ⊔ C) : Set T) := hx.1
    rw [coe_mul_of_left_le_normalizer_right B C hn] at hx'
    obtain ⟨b, hb, c, hc, rfl⟩ := hx'
    have hbZ : (⟨b, hb⟩ : B) ∈ center B := by
      apply mem_center_iff.mpr
      intro y
      apply Subtype.ext
      apply mul_right_cancel (b := c)
      calc
        (y : T) * b * c = (y : T) * (b*c) := mul_assoc _ _ _
        _ = (b*c) * y := hx.2 y y.property
        _ = b * y * c := by rw [mul_assoc, ← hcomm y y.property c hc, ← mul_assoc]
    have hbC : b ∈ B ⊓ C := by
      rw [intersection_eq_factor_center B C hB hinter hcomm]
      exact ⟨⟨b,hb⟩, hbZ, rfl⟩
    exact C.mul_mem hbC.2 hc
  · exact fun c hc => ⟨mem_sup_right hc, fun b hb => hcomm b hb c hc⟩

/-- A noncommuting first-factor action and a trivial second-factor action
produce a nontrivial derived square in any subgroup containing the two lifts.
The abelian core quotient places their commutator back in the core. -/
public theorem quaternion_derived_square_of_factor_actions
    (P B C D : Subgroup T) [P.Normal] [B.Normal] [C.Normal]
    [IsMulCommutative (T ⧸ P)]
    (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hjoin : B ⊔ C = P)
    (hinter : Nat.card (B ⊓ C : Subgroup T) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b*c=c*b)
    (t d : D)
    (hd : (MulAut.conjNormal (d : T) : MulAut C) = 1)
    (hne : ¬ Commute (MulAut.conjNormal (t : T) : MulAut B)
      (MulAut.conjNormal (d : T) : MulAut B)) :
    ∃ x : D, x ∈ _root_.commutator D ∧ x^2 ≠ 1 := by
  let x : D := ⁅t,d⁆
  have hxcomm : x ∈ _root_.commutator D := commutator_mem_commutator (mem_top t) (mem_top d)
  have hxP : (x : T) ∈ P := by
    apply Normal.quotient_commutative_iff_commutator_le.mp inferInstance
    exact commutator_mem_commutator (mem_top (t:T)) (mem_top (d:T))
  have hxC : (x : T) ∈ centralizer (C : Set T) := by
    rw [← conjNormal_ker C]
    change (MulAut.conjNormal : T →* MulAut C) ⁅(t:T),(d:T)⁆ = 1
    rw [map_commutatorElement, hd]
    simp
  have hxB : (x : T) ∈ B := by
    rw [← join_inf_quaternion_centralizer C B hC (by simpa [inf_comm] using hinter)
      (fun c hc b hb => (hcomm b hb c hc).symm)]
    exact ⟨by simpa [sup_comm, hjoin] using hxP, hxC⟩
  refine ⟨x, hxcomm, fun hx2 => ?_⟩
  obtain ⟨model⟩ := hB
  let b : B := ⟨x, hxB⟩
  have hb2 : b^2=1 := Subtype.ext (congrArg (fun z : D => (z : T)) hx2)
  have hfinite : ∀ q : QuaternionGroup 2, q^2=1 → ∀ r, r*q=q*r := by decide
  have hbcentral : b ∈ center B := by
    apply mem_center_iff.mpr
    intro y
    apply model.injective
    simpa only [map_mul] using hfinite (model b) (by rw [← map_pow, hb2, map_one]) (model y)
  apply hne
  apply commutatorElement_eq_one_iff_commute.mp
  rw [← map_commutatorElement]
  change (MulAut.conjNormal (x:T) : MulAut B) = 1
  apply MulEquiv.ext
  intro y
  apply Subtype.ext
  change (x:T)*(y:T)*(x:T)⁻¹=(y:T)
  have hh := congrArg Subtype.val (mem_center_iff.mp hbcentral y)
  change (y:T)*(x:T)=(x:T)*(y:T) at hh
  rw [← hh, mul_inv_cancel_right]
end Subgroup

namespace Subgroup
variable {T : Type*} [Group T] [Finite T]

omit [Finite T] in
/-- Independent factor actions lift an automorphism fixing the central
 displacement axis to an element centralizing the fixed subgroup of `t`. -/
public theorem quaternion_fixed_centralizer_action_lift
    (P B C W : Subgroup T) [B.Normal] [C.Normal]
    (hjoin : B ⊔ C = P)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b*c=c*b)
    (t : T) (hfixed : P ⊓ centralizer ({t} : Set T) = W)
    (hprod : ((MulAut.conjNormal : T →* MulAut B).prod
      (MulAut.conjNormal : T →* MulAut C)).range =
      (MulAut.conjNormal : T →* MulAut B).range.prod
      (MulAut.conjNormal : T →* MulAut C).range)
    (a : MulAut B) (ha : a ∈ (MulAut.conjNormal : T →* MulAut B).range)
    (haxis : ∀ b : B, b⁻¹ * (MulAut.conjNormal t : MulAut B) b ∈ center B → a b = b) :
    ∃ d : centralizer (W : Set T),
      (MulAut.conjNormal (d:T) : MulAut B) = a ∧
      (MulAut.conjNormal (d:T) : MulAut C) = 1 := by
  have hrange : (a, 1) ∈ ((MulAut.conjNormal : T →* MulAut B).prod
      (MulAut.conjNormal : T →* MulAut C)).range := by
    rw [hprod]
    exact ⟨ha, one_mem _⟩
  obtain ⟨d, hd⟩ := hrange
  have hdB : (MulAut.conjNormal d : MulAut B) = a := congrArg Prod.fst hd
  have hdC : (MulAut.conjNormal d : MulAut C) = 1 := congrArg Prod.snd hd
  refine ⟨⟨d, ?_⟩, hdB, hdC⟩
  intro w hw
  have hw' : w ∈ P ⊓ centralizer ({t} : Set T) := hfixed ▸ hw
  have hn : B ≤ normalizer (C : Set T) := by
    apply le_trans ?_ (centralizer_le_normalizer _)
    exact fun b hb c hc => (hcomm b hb c hc).symm
  have hwP : w ∈ (B : Set T)*(C : Set T) := by
    rw [← coe_mul_of_left_le_normalizer_right B C hn, hjoin]
    exact hw'.1
  obtain ⟨b, hb, c, hc, rfl⟩ := hwP
  let bb : B := ⟨b,hb⟩
  let cc : C := ⟨c,hc⟩
  let eb : B := (MulAut.conjNormal t : MulAut B) bb
  let ec : C := (MulAut.conjNormal t : MulAut C) cc
  have htfix : (eb:T)*(ec:T) = b*c := by
    change (t*b*t⁻¹)*(t*c*t⁻¹)=b*c
    calc
      (t*b*t⁻¹)*(t*c*t⁻¹) = t*(b*c)*t⁻¹ := by group
      _ = b*c := by rw [← mem_centralizer_singleton_iff.mp hw'.2, mul_inv_cancel_right]
  have hdisp : b⁻¹*(eb:T) = c*(ec:T)⁻¹ := by
    calc
      b⁻¹*(eb:T) = b⁻¹*((eb:T)*(ec:T))*(ec:T)⁻¹ := by group
      _ = b⁻¹*(b*c)*(ec:T)⁻¹ := by rw [htfix]
      _ = c*(ec:T)⁻¹ := by group
  have hdispC : b⁻¹*(eb:T) ∈ C := hdisp ▸ C.mul_mem hc (C.inv_mem ec.property)
  have haxisB : bb⁻¹ * (MulAut.conjNormal t : MulAut B) bb ∈ center B := by
    apply mem_center_iff.mpr
    intro y
    exact Subtype.ext (hcomm y y.property _ hdispC)
  have hdb : d*b*d⁻¹=b := by
    have hh := congrArg Subtype.val (haxis bb haxisB)
    rw [← hdB] at hh
    exact hh
  have hdc : d*c*d⁻¹=c := congrArg (fun e : MulAut C => (e cc : T)) hdC
  have hdw : d*(b*c)*d⁻¹=b*c := by
    calc
      d*(b*c)*d⁻¹=(d*b*d⁻¹)*(d*c*d⁻¹) := by group
      _ = b*c := by rw [hdb, hdc]
  exact (mul_inv_eq_iff_eq_mul.mp hdw).symm
end Subgroup

namespace Subgroup
variable {T : Type*} [Group T]
/-- An elementary fixed subgroup cannot contain the fixed elements of an
inner automorphism of a quaternion factor. -/
public theorem quaternion_factor_outer_of_elementary_fixed
    (P B W : Subgroup T) [B.Normal] [IsElementaryAbelian 2 W]
    (hBP : B ≤ P) (model : B ≃* QuaternionGroup 2)
    (t : T) (hfixed : P ⊓ centralizer ({t} : Set T) = W) :
    ¬ ∃ b : B, (MulAut.conjNormal t : MulAut B) = MulAut.conj b := by
  rintro ⟨b,hb⟩
  have ht : ∀ q : QuaternionGroup 2, ∃ x, q*x=x*q ∧ x^2 ≠ 1 := by decide
  obtain ⟨q, hq, hq2⟩ := ht (model b)
  let x := model.symm q
  have hx2 : x^2 ≠ 1 := by
    intro hh
    apply hq2
    simpa [x] using congrArg model hh
  have hbx : b*x=x*b := by
    apply model.injective
    simpa only [x, map_mul, MulEquiv.apply_symm_apply] using hq
  have htx : (MulAut.conjNormal t : MulAut B) x = x := by
    rw [hb]
    change b*x*b⁻¹=x
    rw [hbx, mul_inv_cancel_right]
  have hxW : (x:T) ∈ W := by
    rw [← hfixed]
    refine ⟨hBP x.property, mem_centralizer_singleton_iff.mpr ?_⟩
    have hh := congrArg Subtype.val htx
    change t*(x:T)*t⁻¹=(x:T) at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm
  have hh : (⟨x,hxW⟩ : W)^2=1 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 W) _
  exact hx2 (Subtype.ext (congrArg (fun y : W => (y:T)) hh))
end Subgroup

namespace Subgroup
variable {T : Type*} [Group T] [Finite T]
/-- A self-centralizing quaternion central product of index four in a finite
two-group has a nontrivial derived square in the centralizer of an elementary
fixed subgroup of an involution, when its two quaternion factors are normal. -/
public theorem quaternion_four_quotient_exists_derived_square
    (hT : IsPGroup 2 T)
    (P : Subgroup T) [P.Normal] [IsElementaryAbelian 2 (T ⧸ P)]
    (hP : Nat.card P = 32) (hindex : P.index = 4)
    (hself : centralizer (P : Set T) ≤ P)
    (B C : Subgroup T) [B.Normal] [C.Normal]
    (hB : Nonempty (B ≃* QuaternionGroup 2))
    (hC : Nonempty (C ≃* QuaternionGroup 2))
    (hjoin : B ⊔ C = P)
    (hinter : Nat.card (B ⊓ C : Subgroup T) = 2)
    (hcomm : ∀ b ∈ B, ∀ c ∈ C, b*c=c*b)
    (W : Subgroup T) [IsElementaryAbelian 2 W]
    (t : T) (ht : orderOf t = 2)
    (hfixed : P ⊓ centralizer ({t} : Set T) = W) :
    ∃ x : centralizer (W : Set T),
      x ∈ _root_.commutator (centralizer (W : Set T)) ∧ x^2 ≠ 1 := by
  have hcard : Nat.card T = 128 := by
    have hh := P.card_mul_index
    rw [hP, hindex] at hh
    exact hh.symm
  have hprod := (quaternion_normal_factor_action_product hT hcard B C hB hC
    hinter hcomm (by simpa only [hjoin] using hself)).2.2
  obtain ⟨model⟩ := hB
  let e : MulAut B := MulAut.conjNormal t
  have he : e^2=1 := by
    change (MulAut.conjNormal t : MulAut B)^2=1
    rw [← map_pow, (show t^2=1 from ht ▸ pow_orderOf_eq_one t), map_one]
  have ho : ¬ ∃ b : B, e = MulAut.conj b :=
    quaternion_factor_outer_of_elementary_fixed P B W (hjoin ▸ le_sup_left) model t hfixed
  obtain ⟨b, hne, haxis⟩ := QuaternionGroup.exists_axis_fixing_twist_of_equiv model e he ho
  let a := e * MulAut.conj b
  have ha : a ∈ (MulAut.conjNormal : T →* MulAut B).range := by
    refine ⟨t*(b:T), ?_⟩
    rw [map_mul, MulAut.conjNormal_val]
  obtain ⟨d, hdB, hdC⟩ := quaternion_fixed_centralizer_action_lift P B C W hjoin hcomm
    t hfixed hprod a ha haxis
  have htD : t ∈ centralizer (W : Set T) := by
    intro w hw
    have hh : w ∈ P ⊓ centralizer ({t} : Set T) := hfixed ▸ hw
    exact mem_centralizer_singleton_iff.mp hh.2
  let : IsMulCommutative (T ⧸ P) := IsElementaryAbelian.toIsMulCommutative (p := 2)
  apply quaternion_derived_square_of_factor_actions P B C (centralizer (W : Set T))
    ⟨model⟩ hC hjoin hinter hcomm ⟨t,htD⟩ d hdC
  simpa only [hdB] using hne
end Subgroup
