module
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# Subgroups of cyclic groups of two-power exponent

A subgroup of `zpowers a`, where `a^(2^m)=1`, is generated by a power
`a^(2^k)` with `k≤m`. No exact-order hypothesis is needed. This elementary
cyclic-group calculation supports ABG Chapter II §1 Lemma 2(xi).

Choose a subgroup generator `a^j`. Bézout's identity replaces `j` by
`gcd(2^m,j)` without changing the generated subgroup; a divisor of `2^m`
is a power of two.
-/

namespace Subgroup
variable {S : Type*} [Group S]

public theorem eq_zpowers_two_pow_of_le {a : S} {m : ℕ} (ha : a ^ (2 ^ m) = 1)
    (H : Subgroup S) (hH : H ≤ Subgroup.zpowers a) :
    ∃ k ≤ m, H = Subgroup.zpowers (a ^ (2 ^ k)) := by
  obtain ⟨j, rfl⟩ := (Subgroup.le_zpowers_iff a H).mp hH
  obtain ⟨k, hkm, hk⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp
    (Nat.gcd_dvd_left (2 ^ m) j)
  refine ⟨k, hkm, ?_⟩
  apply le_antisymm
  · apply Subgroup.zpowers_le_of_mem
    obtain ⟨l, hl⟩ := hk ▸ Nat.gcd_dvd_right (2 ^ m) j
    rw [hl, pow_mul]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) l
  · apply Subgroup.zpowers_le_of_mem
    have hz : a ^ ((Nat.gcd (2 ^ m) j : ℕ) : ℤ) =
        (a ^ j) ^ (Nat.gcdB (2 ^ m) j) := by
      rw [Nat.gcd_eq_gcd_ab, zpow_add, zpow_mul, zpow_mul,
        zpow_natCast, zpow_natCast, ha, one_zpow, one_mul]
    rw [← hk]
    have hh := (Subgroup.zpowers (a ^ j)).zpow_mem (Subgroup.mem_zpowers _) (Nat.gcdB (2 ^ m) j)
    rw [← hz] at hh
    simpa only [zpow_natCast] using hh

end Subgroup
