module
public import Theory.GroupTheory.SemidihedralCenter
public import Theory.GroupTheory.PGroup.OmegaAmbient

/-!
# Involution generation in a semidihedral presentation

For a rotation `a` of order `2^n` and an involution `b` with the semidihedral
conjugation exponent, the subgroup generated by all involutions of `⟨a,b⟩`
is exactly `⟨a²,b⟩`. The rotation exponent bound `n ≥ 2` is retained.

The two bounded normal forms are `a^i` and `a^i*b`. An outer element squares
to the `i`th power of the central half-turn, so an involution has even `i`.
The involutions among the rotations also have even exponent. Conversely,
`b` and `a²*b` are involutions and their product is `a²`.

This is the omega calculation for the semidihedral factor in Aschbacher–Smith
16.3.12, printed pp.1181–1182, using the presentation conventions of
`SemidihedralCenter` (whose parameter is the whole-group exponent).
-/

open Subgroup
namespace Semidihedral
variable {G : Type*} [Group G]

/-- Involutions in the semidihedral presentation generate precisely the even
rotations together with the designated involution. -/
public theorem omegaOneAmbient_sup_eq {n : ℕ} (hn : 2 ≤ n) (a b : G)
    (ha : orderOf a = 2 ^ n) (hb : b ^ 2 = 1)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 1) - 1)) :
    omegaOneAmbient (zpowers a ⊔ zpowers b) = zpowers (a ^ 2) ⊔ zpowers b := by
  let C := zpowers a ⊔ zpowers b
  let R := zpowers (a ^ 2) ⊔ zpowers b
  have hh : 2 ^ n = 2 ^ (n - 1) * 2 := by
    rw [← pow_succ]
    congr 1
    omega
  have hp : 0 < 2 ^ (n - 1) := by positivity
  have hz : orderOf (a ^ (2 ^ (n - 1))) = 2 := by
    rw [orderOf_pow_of_dvd (ne_of_gt hp) (by rw [ha, hh]; exact dvd_mul_right _ _),
      ha, hh, Nat.mul_div_right _ hp]
  have hbb : b * b = 1 := by simpa only [pow_two] using hb
  have hsq (i : ℕ) : (a ^ i * b) ^ 2 = (a ^ (2 ^ (n - 1))) ^ i := by
    calc
      (a ^ i * b) ^ 2 = a ^ i * (b * a ^ i) * b := by simp only [pow_two, mul_assoc]
      _ = a ^ i * (a ^ ((2 ^ (n - 1) - 1) * i) * b) * b := by
        rw [move_pow a b _ hconj i]
      _ = a ^ (i + (2 ^ (n - 1) - 1) * i) := by
        rw [mul_assoc, mul_assoc, hbb, mul_one, ← pow_add]
      _ = (a ^ (2 ^ (n - 1))) ^ i := by
        rw [← pow_mul]
        congr 1
        have : 2 ^ (n - 1) - 1 + 1 = 2 ^ (n - 1) := by omega
        nlinarith
  have hnf (x : G) (hx : x ∈ C) : ∃ i : ℕ, x = a ^ i ∨ x = a ^ i * b := by
    let ac : C := ⟨a, mem_sup_left (mem_zpowers _)⟩
    let bc : C := ⟨b, mem_sup_right (mem_zpowers _)⟩
    have hgen : closure ({ac, bc} : Set C) = ⊤ := by
      apply map_injective C.subtype_injective
      rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, C.range_subtype]
      rw [Set.image_insert_eq, Set.image_singleton]
      change closure ({a, b} : Set G) = C
      rw [← Set.singleton_union, Subgroup.closure_union, ← zpowers_eq_closure, ← zpowers_eq_closure]
    obtain ⟨i, -, hi | hi⟩ := normal_form ac bc _ _ (by positivity)
      ((orderOf_coe ac).symm.trans ha) (Subtype.ext hb) (Subtype.ext hconj) hgen ⟨x, hx⟩
    · exact ⟨i, Or.inl (congrArg Subtype.val hi)⟩
    · exact ⟨i, Or.inr (congrArg Subtype.val hi)⟩
  have heven (i : ℕ) (hi : 2 ∣ i) : a ^ i ∈ R := by
    obtain ⟨j, rfl⟩ := hi
    rw [pow_mul]
    exact mem_sup_left (pow_mem (mem_zpowers _) _)
  apply le_antisymm
  · apply (omegaOneAmbient_le_iff _ _).mpr
    intro x hx hx2
    obtain ⟨i, rfl | rfl⟩ := hnf x hx
    · have hd : 2 ^ (n - 1) ∣ i := by
        have hd := orderOf_dvd_of_pow_eq_one (show a ^ (i * 2) = 1 by rw [pow_mul]; exact hx2)
        rw [ha, hh] at hd
        exact (Nat.mul_dvd_mul_iff_right (by decide : 0 < 2)).mp hd
      have htwo : 2 ∣ 2 ^ (n - 1) := dvd_pow_self 2 (by omega)
      exact heven i (htwo.trans hd)
    · have hd : 2 ∣ i := by
        rw [hsq] at hx2
        simpa only [hz] using orderOf_dvd_of_pow_eq_one hx2
      exact mul_mem (heven i hd) (mem_sup_right (mem_zpowers _))
  · have hbO : b ∈ omegaOneAmbient C :=
      (omegaOneAmbient_le_iff _ _).mp le_rfl _ (mem_sup_right (mem_zpowers _)) hb
    have habO : a ^ 2 * b ∈ omegaOneAmbient C := by
      apply (omegaOneAmbient_le_iff _ _).mp le_rfl
      · exact mul_mem (mem_sup_left (pow_mem (mem_zpowers _) _)) (mem_sup_right (mem_zpowers _))
      · rw [hsq]
        have hz2 := pow_orderOf_eq_one (a ^ (2 ^ (n - 1) : ℕ))
        rw [hz] at hz2
        exact hz2
    apply sup_le (zpowers_le.mpr ?_) (zpowers_le.mpr hbO)
    simpa only [mul_assoc, hbb, mul_one] using mul_mem habO hbO
end Semidihedral
