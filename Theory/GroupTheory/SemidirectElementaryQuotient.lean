module

public import Theory.ElementaryAbelian.Basic
public import Mathlib.GroupTheory.SemidirectProduct
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Elementary quotients of a split extension

Suppose an elementary kernel is central modulo a normal subgroup W. If the
actor commutator is generated by commutators with the image of W, the actor
is also abelian modulo W. Squares in the actor commutator then make the whole
quotient elementary. The argument retains the actual section and W.
-/

namespace Theory.GroupTheory
open Subgroup
open scoped commutatorElement
variable {V D : Type*} [Group V] [Group D] [IsElementaryAbelian 2 V]

public theorem semidirect_squares_mem_of_mixed_commutator
    (φ : D→*MulAut V) (W : Subgroup (V ⋊[φ] D)) [W.Normal]
    (hmove : ∀ d v, SemidirectProduct.inl (φ d v*v⁻¹)∈W)
    (hmix : ⁅(⊤ : Subgroup D),W.map SemidirectProduct.rightHom⁆=_root_.commutator D)
    (hsq : ∀d:D, d^2∈_root_.commutator D) :
    ∀x : V ⋊[φ] D, x^2∈W := by
  let q := QuotientGroup.mk' W
  let f := q.comp (SemidirectProduct.inr : D→*V ⋊[φ] D)
  have hfix (d : D) (v : V) : q (SemidirectProduct.inl (φ d v))=q (SemidirectProduct.inl v) := by
    have hh := (QuotientGroup.eq_one_iff _).mpr (hmove d v)
    change q (SemidirectProduct.inl (φ d v*v⁻¹))=1 at hh
    rw [map_mul,map_inv,map_mul,map_inv,mul_inv_eq_one] at hh
    exact hh
  have hcomm (d : D) (v : V) : Commute (f d) (q (SemidirectProduct.inl v)) := by
    change q (SemidirectProduct.inr d)*q (SemidirectProduct.inl v)=
      q (SemidirectProduct.inl v)*q (SemidirectProduct.inr d)
    have hh := hfix d v
    simp only [SemidirectProduct.inl_aut,map_mul,map_inv] at hh
    exact mul_inv_eq_iff_eq_mul.mp hh
  have hdk : _root_.commutator D≤f.ker := by
    rw [←hmix]
    apply commutator_le.mpr
    intro d _ a ha
    obtain ⟨w,hw,rfl⟩ := ha
    have hwq : q w=1 := (QuotientGroup.eq_one_iff w).mpr hw
    have hwa : f w.right=(q (SemidirectProduct.inl w.left))⁻¹ := by
      rw [←SemidirectProduct.inl_left_mul_inr_right w,map_mul] at hwq
      have hh := congrArg (fun x => (q (SemidirectProduct.inl w.left))⁻¹*x) hwq
      change q (SemidirectProduct.inr w.right)=(q (SemidirectProduct.inl w.left))⁻¹
      simpa only [←mul_assoc,inv_mul_cancel,one_mul,mul_one] using hh
    change f ⁅d,w.right⁆=1
    rw [map_commutatorElement,hwa]
    exact (hcomm d w.left).inv_right.commutator_eq
  intro x
  apply (QuotientGroup.eq_one_iff _).mp
  change q (x^2)=1
  rw [map_pow,←SemidirectProduct.inl_left_mul_inr_right x,map_mul]
  have hV : (q (SemidirectProduct.inl x.left))^2=1 := by
    have hv := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 V) x.left
    rw [←map_pow,←map_pow,hv,map_one,map_one]
  have hD : (f x.right)^2=1 := by
    rw [←map_pow]
    exact hdk (hsq x.right)
  change (q (SemidirectProduct.inl x.left)*f x.right)^2=1
  rw [(hcomm x.right x.left).symm.mul_pow,hV,hD,one_mul]

end Theory.GroupTheory
