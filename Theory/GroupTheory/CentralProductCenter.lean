module
public import Mathlib.GroupTheory.Subgroup.Center

/-!
# The center of a central product

If a group is generated by a central subgroup Z and a subgroup L, and
the ambient image of the center of L lies in Z, then its center is exactly Z.
No finiteness, cyclicity or cardinality assumption is needed.

Write a central element as z*l using the actual generating subgroups.
Since z is central, l is central as well, so it lies in the center of L
and consequently in Z. The reverse inclusion is the given centrality.

This identifies the actual central kernel in the central-product model
comparison of Alperin--Brauer--Gorenstein II.3 Proposition 3, article p26.
The source's cardinal-two overlap is supplied separately.
-/

namespace Subgroup

public theorem center_eq_of_central_product
    {G : Type*} [Group G] (Z L : Subgroup G)
    (hZ : Z ≤ Subgroup.center G) (hgen : Z ⊔ L = ⊤)
    (hLC : (Subgroup.center L).map L.subtype ≤ Z) : Subgroup.center G = Z := by
  have hZN : Z.Normal := ⟨fun z hz g => by
    rw [Subgroup.mem_center_iff.mp (hZ hz) g, mul_inv_cancel_right]
    exact hz⟩
  let := hZN
  apply le_antisymm ?_ hZ
  intro x hx
  have hxprod : x ∈ Z ⊔ L := hgen ▸ Subgroup.mem_top x
  obtain ⟨z, hz, l, hl, rfl⟩ := Subgroup.mem_sup_of_normal_left.mp hxprod
  have hlC : l ∈ Subgroup.center G := by
    have hc := (Subgroup.center G).mul_mem ((Subgroup.center G).inv_mem (hZ hz)) hx
    simpa only [inv_mul_cancel_left] using hc
  have hlCL : (⟨l, hl⟩ : L) ∈ Subgroup.center L := by
    apply Subgroup.mem_center_iff.mpr
    intro y
    exact Subtype.ext (Subgroup.mem_center_iff.mp hlC y)
  exact Z.mul_mem hz (hLC ⟨⟨l, hl⟩, hlCL, rfl⟩)


end Subgroup

