module

public import Theory.GroupTheory.CentralPChiefFactors
public import Theory.GroupTheory.PResidualCommutator
public import Theory.GroupTheory.PResidual.Defs
public import Theory.PGroupCore
public import Mathlib.Data.Nat.Factorization.Basic
public import Mathlib.Order.Atoms.Finite

/-!
# Central chief factors in p-perfect groups

For a finite p-perfect group H with central p-chief factors, O_p(H) is central.
Prime-to-p elements generate H. Coprime commutator idempotence therefore makes
M = [O_p(H),H] satisfy [M,H] = M. If M were nontrivial, a maximal proper
H-normal subgroup K of M would give a p-chief quotient M/K. Its centrality
would force [M,H] ≤ K, a contradiction.

Source: the central-core step of Aschbacher–Smith, *The Classification of
Quasithin Groups*, B.7.2, printed p.119 (PDF p.130). The residual hypothesis
is essential; central chief factors alone do not imply centrality of the core.
-/

public section

open Subgroup
/-- A finite p-perfect group is generated by its elements of order prime to p. -/
theorem closure_coprime_order_eq_top_of_pResidual_eq_top {H : Type*} [Group H] [Finite H] (p : ℕ) [Fact p.Prime]
    (hr : pResidual p H = ⊤) :
    closure {x : H | Nat.Coprime p (orderOf x)} = ⊤ := by
  let S := closure {x : H | Nat.Coprime p (orderOf x)}
  have hn : S.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    apply le_normalizer_iff.mpr
    intro g _ x hx
    induction hx using closure_induction with
    | mem y hy =>
      apply subset_closure
      change Nat.Coprime p (orderOf (g * y * g⁻¹))
      change Nat.Coprime p (orderOf (MulAut.conj g y))
      rwa [MulEquiv.orderOf_eq]
    | one => simp
    | mul x y hx hy hix hiy =>
      simpa only [mul_assoc, inv_mul_cancel_left] using S.mul_mem hix hiy
    | inv x hx hi =>
      simpa only [mul_inv_rev, inv_inv, mul_assoc] using S.inv_mem hi
  let := hn
  have hp : IsPGroup p (H ⧸ S) := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective S q
    obtain ⟨k, m, hm, he⟩ := Nat.exists_eq_pow_mul_and_not_dvd
      (ne_of_gt (orderOf_pos x)) p (Fact.out : p.Prime).ne_one
    refine ⟨k, ?_⟩
    rw [← map_pow]
    apply (QuotientGroup.eq_one_iff _).mpr
    apply subset_closure
    change Nat.Coprime p (orderOf (x ^ (p ^ k)))
    have hd : p ^ k ∣ orderOf x := he ▸ dvd_mul_right _ _
    rw [orderOf_pow_of_dvd (pow_ne_zero _ (Fact.out : p.Prime).ne_zero) hd, he,
      Nat.mul_div_right _ (pow_pos (Fact.out : p.Prime).pos _)]
    exact (Fact.out : p.Prime).coprime_iff_not_dvd.mpr hm
  exact (pResidual_eq_top_iff p H).mp hr S hn hp


/-- Central p-chief factors make the p-core central in a finite p-perfect group. -/
theorem pCore_le_center_of_centralPChiefFactors {H : Type*} [Group H] [Finite H] (p : ℕ) [Fact p.Prime]
    (hr : pResidual p H = ⊤) (hc : HasCentralPChiefFactors p H) :
    pCore p H ≤ center H := by
  have hgen := closure_coprime_order_eq_top_of_pResidual_eq_top p hr
  have hid : ⁅⁅pCore p H, (⊤ : Subgroup H)⁆, (⊤ : Subgroup H)⁆ = ⁅pCore p H, (⊤ : Subgroup H)⁆ := by
    have h := commutator_closure_coprime_idempotent (pCore p H)
      {x : H | Nat.Coprime p (orderOf x)} le_normalizer_of_normal
      (by
        intro x hx
        obtain ⟨n, hn⟩ := (pCore_isPGroup (p := p) (G := H)).exists_card_eq
        rw [hn]
        exact hx.symm.pow_right n)
    rwa [hgen] at h
  let M := ⁅pCore p H, (⊤ : Subgroup H)⁆
  have hM : M.Normal := inferInstance
  have hpM : IsPGroup p M := pCore_isPGroup.to_le (commutator_le_left _ _)
  apply commutator_top_right_eq_bot_iff_le_center.mp
  by_contra hne
  have hbot : (⊥ : Subgroup H) < M := bot_lt_iff_ne_bot.mpr hne
  let _ : Finite (Subgroup H) :=
    Finite.of_injective (fun N : Subgroup H => (N : Set H)) SetLike.coe_injective
  obtain ⟨K, _, hmax⟩ := Finite.exists_le_maximal
    (p := fun N : Subgroup H => N.Normal ∧ N < M) (a := ⊥) ⟨inferInstance, hbot⟩
  let _ := hmax.prop.1
  have hchief : ∀ N : Subgroup H, N.Normal → K ≤ N → N ≤ M → N = K ∨ N = M := by
    intro N hn hKN hNM
    by_cases he : N = M
    · exact Or.inr he
    · exact Or.inl (le_antisymm (hmax.2 ⟨hn, lt_of_le_of_ne hNM he⟩ hKN) hKN)
  have hcomm := hc.commutator_le K M hmax.prop.2 hchief (hpM.to_quotient (K.subgroupOf M))
  rw [commutator_comm, hid] at hcomm
  exact hmax.prop.2.not_ge hcomm
