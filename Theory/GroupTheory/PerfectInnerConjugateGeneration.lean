module
public import Theory.GroupTheory.Commutator.CentralizingComplement
public import Mathlib.GroupTheory.IsPerfect
public import Mathlib.Tactic

/-!
# Lifting conjugate generation across an inner action

If an ambient element acts on a perfect subgroup by an inner element t,
their ratio centralizes that subgroup. Thus conjugates of the ambient
element generate the same perfect part as conjugates of t: adjoining
the central ratio does not enlarge the derived subgroup.
This retains the ambient actor, rather than replacing it by its inner
implementer. Source application: Aschbacher--Smith 12.6.26, p.833.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G]
/-- A central twist does not change the perfect part generated by conjugates. -/
theorem perfect_le_conjugates_of_inner_action
    (K : Subgroup G) [Group.IsPerfect K] (v : G) (t : K)
    (ha : ∀ k : K, v * k.val * v⁻¹ = (t*k*t⁻¹).val)
    {n : ℕ} (c : Fin n → K)
    (hg : closure (Set.range fun i => c i*t*(c i)⁻¹) = ⊤) :
    K ≤ ⨆ i, (zpowers v).map (MulAut.conj (c i : G)).toMonoidHom := by
  let J := ⨆ i, (zpowers v).map (MulAut.conj (c i : G)).toMonoidHom
  let z := t.val⁻¹*v
  have hz : z ∈ centralizer (K : Set G) := by
    intro k hk
    have he := ha ⟨k,hk⟩
    change v*k*v⁻¹=t.val*k*t.val⁻¹ at he
    have hh : z*k*z⁻¹=k := by
      calc
        _ = t.val⁻¹*(v*k*v⁻¹)*t.val := by dsimp [z]; group
        _ = k := by rw [he]; group
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm
  have hv : v = t.val*z := by simp [z]
  have hzv : Commute z v := by
    rw [hv]
    exact (show Commute z t.val from (hz t.val t.property).symm).mul_right (Commute.refl z)
  have hJz : J ≤ centralizer ({z} : Set G) := by
    apply iSup_le
    intro i
    rw [MonoidHom.map_zpowers]
    apply zpowers_le.mpr
    apply mem_centralizer_singleton_iff.mpr
    exact (((show Commute z (c i : G) from (hz _ (c i).property).symm).mul_right hzv).mul_right
      (show Commute z (c i : G)⁻¹ from ((show Commute z (c i : G) from
        (hz _ (c i).property).symm)).inv_right)).eq.symm
  have hzJ : z ∈ centralizer (J : Set G) := by
    intro j hj
    exact mem_centralizer_singleton_iff.mp (hJz hj)
  have hKJ : K ≤ J ⊔ zpowers z := by
    have hle : (closure (Set.range fun i => c i*t*(c i)⁻¹)).map K.subtype ≤ J ⊔ zpowers z := by
      rw [MonoidHom.map_closure]
      apply (closure_le _).mpr
      rintro _ ⟨_,⟨i,rfl⟩,rfl⟩
      have hm : (c i : G)*v*(c i : G)⁻¹ ∈ J :=
        mem_iSup_of_mem i (mem_map_of_mem _ (mem_zpowers v))
      have he : (c i : G)*t.val*(c i : G)⁻¹ =
          ((c i : G)*v*(c i : G)⁻¹)*z⁻¹ := by
        rw [hv]
        have hzc := (show Commute z (c i : G) from (hz _ (c i).property).symm).inv_right.eq
        calc
          _ = (c i : G)*t.val*((c i : G)⁻¹*z)*z⁻¹ := by group
          _ = (c i : G)*(t.val*z)*(c i : G)⁻¹*z⁻¹ := by rw [←hzc]; group
      change (c i : G)*t.val*(c i : G)⁻¹ ∈ _
      rw [he]
      exact (J ⊔ zpowers z).mul_mem (mem_sup_left hm)
        (mem_sup_right ((zpowers z).inv_mem (mem_zpowers z)))
    rw [hg, ←MonoidHom.range_eq_map, range_subtype] at hle
    exact hle
  have hCJ : zpowers z ≤ centralizer (J : Set G) := zpowers_le.mpr hzJ
  have hCC : zpowers z ≤ centralizer (zpowers z : Set G) := by
    intro x hx y hy
    obtain ⟨i,rfl⟩ := hx
    obtain ⟨j,rfl⟩ := hy
    exact (Commute.zpow_zpow_self z j i).eq
  have hC : zpowers z ≤ centralizer ((J ⊔ zpowers z : Subgroup G) : Set G) := by
    apply le_centralizer_iff.mp
    apply sup_le
    · exact le_centralizer_iff.mp hCJ
    · exact hCC
  have hnorm : J ⊔ zpowers z ≤ normalizer (J : Set G) :=
    sup_le J.le_normalizer (hCJ.trans (centralizer_le_normalizer _))
  have hd : ⁅J ⊔ zpowers z,J ⊔ zpowers z⁆ = ⁅J,J⁆ := by
    calc
      _ = ⁅J ⊔ zpowers z,J⁆ := (commutator_eq_of_centralizing_sup
        (sup_comm (zpowers z) J) hC
        (le_sup_left.trans (J ⊔ zpowers z).le_normalizer)).symm
      _ = ⁅J,J ⊔ zpowers z⁆ := commutator_comm _ _
      _ = ⁅J,J⁆ := (commutator_eq_of_centralizing_sup
        (sup_comm (zpowers z) J) hCJ J.le_normalizer).symm
  have hh := commutator_mono hKJ hKJ
  rw [commutator_eq_self,hd] at hh
  exact hh.trans J.commutator_le_self
end Subgroup
