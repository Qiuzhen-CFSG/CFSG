module
public import Theory.GroupTheory.CyclicHallNormalizerEscape

/-!
# Two-group supplements with inversion outside a subgroup

A subgroup generated by a normal two-subgroup and an inverted supplement has
an inverting element outside it. The supplement has index prime to every odd
prime. This data transports through group isomorphisms and permits later
conjugacy arguments for prescribed odd-primary subgroups.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G H : Type*} [Group G] [Group H]

/-- A normal two-subgroup and an externally inverted supplement generate `B`. -/
@[expose] def HasInvertingSupplement (B : Subgroup G) : Prop :=
  ∃ U C : Subgroup G, U ≤ B ∧ C ≤ B ∧ IsPGroup 2 U ∧
    (U.subgroupOf B).Normal ∧ U ⊔ C = B ∧
    ∃ w : G, w ∉ B ∧ ∀ c ∈ C, w * c * w⁻¹ = c⁻¹

/-- Both the complete supplement and its inverting element transport along an
isomorphism, retaining normality inside the specified subgroup. -/
theorem HasInvertingSupplement.map {B : Subgroup G}
    (h : HasInvertingSupplement B) (e : G ≃* H) :
    HasInvertingSupplement (B.map e.toMonoidHom) := by
  obtain ⟨U,C,hUB,hCB,hU,hn,hgen,w,hw,hinv⟩ := h
  refine ⟨U.map e.toMonoidHom,C.map e.toMonoidHom,map_mono hUB,map_mono hCB,
    hU.map e.toMonoidHom,?_,?_,e w,?_,?_⟩
  · apply normal_subgroupOf_of_le_normalizer
    rw [← map_equiv_normalizer_eq]
    exact map_mono ((normal_subgroupOf_iff_le_normalizer hUB).mp hn)
  · rw [← Subgroup.map_sup,hgen]
  · rintro ⟨x,hx,hxw⟩
    exact hw (e.injective hxw ▸ hx)
  · rintro c ⟨x,hx,rfl⟩
    change e w * e x * (e w)⁻¹ = (e x)⁻¹
    simpa only [map_mul,map_inv] using congrArg e (hinv x hx)

/-- The normal two-group controls the index of the full inverted supplement.
Thus no odd prime divides that index. -/
theorem HasInvertingSupplement.odd_index_data [Finite G] {B : Subgroup G}
    (h : HasInvertingSupplement B) :
    ∃ C : Subgroup G, C ≤ B ∧
      (∀ (p : ℕ) [Fact p.Prime], Odd p → ¬ p ∣ (C.subgroupOf B).index) ∧
      ∃ w : G, w ∉ B ∧ ∀ c ∈ C, w * c * w⁻¹ = c⁻¹ := by
  obtain ⟨U,C,hUB,hCB,hU,hn,hgen,w,hw,hinv⟩ := h
  refine ⟨C,hCB,?_,w,hw,hinv⟩
  intro p _ hp
  let := hn
  have hs : U.subgroupOf B ⊔ C.subgroupOf B = ⊤ := by
    rw [← subgroupOf_sup hUB hCB,hgen,subgroupOf_self]
  have hd := index_dvd_of_normal_supplement (U.subgroupOf B) (C.subgroupOf B) hs
  have hUBp : IsPGroup 2 (U.subgroupOf B) := hU.comap_subtype
  obtain ⟨n,hn⟩ := hUBp.exists_card_eq
  have hc : Nat.Coprime p (Nat.card (U.subgroupOf B)) := by
    rw [hn]
    exact hp.coprime_two_right.pow_right n
  exact fun hh => (Fact.out : p.Prime).ne_one
    (Nat.eq_one_of_dvd_coprimes hc (dvd_refl p) (hh.trans hd))
end Theory.GroupTheory
