module
public import Theory.GroupTheory.PCoreSurjective
public import Theory.GroupTheory.Commutator.CentralExtensionPairing

/-!
# Invariant lifts of a commutator-generated two-core

A normal lift of the target two-core in a central extension contains the
full source two-core whenever that core is generated by its commutators.
Changing a lift by a central kernel element leaves its commutator unchanged.
In particular such a lift contains the covering kernel. This gives the
local obstruction used in Aschbacher--Smith 8.2.10(3), printed p.721.
-/

public section
open Subgroup
namespace PerfectCentralCovering
open scoped commutatorElement
variable {E B : Type*} [Group E] [Group B] [Finite E] [Finite B]

/-- A normal lift of the full target two-core contains a central kernel
whenever the full source two-core is generated by local commutators. -/
theorem kernel_le_normal_core_lift
    (f : E →* B) (hf : Function.Surjective f) (hc : f.ker ≤ center E)
    (hk : IsPGroup 2 f.ker)
    (hcomm : ⁅pCore 2 E, (⊤ : Subgroup E)⁆ = pCore 2 E)
    (H : Subgroup E) [H.Normal] (hH : H.map f = pCore 2 B) : f.ker ≤ H := by
  have hpre := f.comap_pCore_of_ker_isPGroup hf hk
  have hcore : pCore 2 E ≤ H := by
    rw [←hcomm]
    apply commutator_le.mpr
    intro x hx y _
    have hfx : f x ∈ H.map f := by
      rw [hH]
      exact show x ∈ (pCore 2 B).comap f from hpre.symm ▸ hx
    obtain ⟨a,ha,he⟩ := hfx
    rw [CentralExtension.commutator_eq_of_image_eq f hc he.symm rfl]
    exact commutator_le_left H (⊤ : Subgroup E)
      (commutator_mem_commutator ha (mem_top y))
  exact (show f.ker ≤ pCore 2 E from le_sSup ⟨inferInstance,hk⟩).trans hcore

end PerfectCentralCovering
