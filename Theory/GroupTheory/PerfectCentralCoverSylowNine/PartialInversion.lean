module

public import Theory.GroupTheory.CentralExtensionPartialInversion
public import Theory.GroupTheory.PerfectCentralCoverSylowNine
import all Theory.GroupTheory.PerfectCentralCoverSylowNine

/-!
# Simultaneous inversion on a nonabelian Sylow three-subgroup

Let a Sylow three-subgroup be generated by cubic elements x and y, with
nontrivial central commutator z. If an ambient element inverts x and y and
fixes z, partial inversion makes the commutator of their lifts central in
the lifted Sylow subgroup. Its cube is one. The lifted derived subgroup is
therefore cyclic of order three and maps injectively downstairs. Central
Sylow transfer now excludes three from a perfect central kernel.

This companion intentionally reuses the internal two-generator Frattini and
commutator proofs from `PerfectCentralCoverSylowNine`, without changing that
module's public boundary. Unlike its order-nine application, the subgroup
downstairs here is nonabelian. The concrete consumer is the G₂(4) calculation
in Aschbacher–Smith I.1.3(1), GLS III §6.1.
-/

open scoped commutatorElement
open Subgroup

namespace PerfectCentralCovering

/-- A nonabelian two-generator Sylow three-subgroup with simultaneous
inversion has no three-primary perfect central kernel. -/
public theorem not_three_dvd_card_kernel_of_simultaneous_inversion
    {E G : Type*} [Group E] [Finite E] [Group.IsPerfect E] [Group G] [Finite G]
    (f : E →* G) (hf : Function.Surjective f) (hk : f.ker ≤ center E)
    (Q : Sylow 3 G) (x y r : G)
    (hQ : closure ({x, y} : Set G) = (Q : Subgroup G))
    (hx : x ^ 3 = 1) (hy : y ^ 3 = 1) (hz : ⁅x, y⁆ ≠ 1)
    (hxz : Commute x ⁅x, y⁆) (hyz : Commute y ⁅x, y⁆)
    (hrx : r * x * r⁻¹ = x⁻¹) (hry : r * y * r⁻¹ = y⁻¹)
    (hrz : Commute r ⁅x, y⁆) : ¬ 3 ∣ Nat.card f.ker := by
  obtain ⟨P, hPQ⟩ := Sylow.mapSurjective_surjective hf 3 Q
  have hmap : (P : Subgroup E).map f = (Q : Subgroup G) := by
    rw [← Sylow.coe_mapSurjective hf, hPQ]
  have hxmem : x ∈ (P : Subgroup E).map f := by
    rw [hmap, ← hQ]
    exact subset_closure (by simp)
  have hymem : y ∈ (P : Subgroup E).map f := by
    rw [hmap, ← hQ]
    exact subset_closure (by simp)
  obtain ⟨aE, haP, ha⟩ := hxmem
  obtain ⟨bE, hbP, hb⟩ := hymem
  let a : P := ⟨aE, haP⟩
  let b : P := ⟨bE, hbP⟩
  let c : P := ⁅a, b⁆
  have hfc : f (c : E) = ⁅x, y⁆ := by
    change f ⁅aE, bE⁆ = _
    rw [map_commutatorElement, ha, hb]
  have hgen : closure ({a, b} : Set P) = ⊤ :=
    SylowNine.pair_lifts_generate f hk P a b (by
      change closure ({f aE, f bE} : Set G) = _
      rw [ha, hb, hQ, hmap])
  have hca : Commute c a := by
    apply Subtype.ext
    exact (CentralExtension.commute_lifts_of_partial_inversion f hf hk
      x ⁅x, y⁆ r (by decide : Nat.Coprime 3 2) hx hxz hrx hrz aE c ha hfc).symm.eq
  have hcb : Commute c b := by
    apply Subtype.ext
    exact (CentralExtension.commute_lifts_of_partial_inversion f hf hk
      y ⁅x, y⁆ r (by decide : Nat.Coprime 3 2) hy hyz hry hrz bE c hb hfc).symm.eq
  have hder : _root_.commutator P ≤ zpowers c :=
    SylowNine.commutator_le_zpowers_of_pair a b hgen hca hcb
  have hc3 : c ^ 3 = 1 := by
    apply SylowNine.cube_commutator a b hca
    apply Subtype.ext
    exact (mem_center_iff.mp (hk (by
      change f (aE ^ 3) = 1
      rw [map_pow, ha, hx])) bE).symm
  have hcorder : orderOf c = 3 := orderOf_eq_prime hc3 (by
    intro hc
    apply hz
    rw [← hfc, hc, Subgroup.coe_one, map_one])
  have hzorder : orderOf ⁅x, y⁆ = 3 := orderOf_eq_prime (by
    rw [← hfc, ← map_pow]
    exact (congrArg f (congrArg Subtype.val hc3)).trans (map_one f)) hz
  intro hd
  obtain ⟨w, hw⟩ := exists_prime_orderOf_dvd_card' 3 hd
  have hwE : orderOf (w : E) = 3 := (Subgroup.orderOf_coe w).trans hw
  let W := zpowers (w : E)
  have hW : W ≤ center E := zpowers_le.mpr (hk w.property)
  let : W.Normal := ⟨fun v hv g => by
    rw [mem_center_iff.mp (hW hv) g, mul_inv_cancel_right]
    exact hv⟩
  have hWp : IsPGroup 3 W := IsPGroup.of_card (n := 1) (by
    simpa only [W, Nat.card_zpowers, pow_one] using hwE)
  have hwP : (w : E) ∈ (P : Subgroup E) := hWp.le_sylow_of_normal P (mem_zpowers _)
  have hwder := center_inf_commutator_inf_sylow_le_commutator P
    ⟨⟨hk w.property, Group.IsPerfect.mem_commutator⟩, hwP⟩
  rw [← map_subtype_commutator] at hwder
  obtain ⟨v, hv, hvw⟩ := hwder
  obtain ⟨k, hkpow⟩ := mem_zpowers_iff.mp (hder hv)
  have hpowimage : ⁅x, y⁆ ^ k = 1 := by
    rw [← hfc, ← map_zpow]
    exact (congrArg f ((congrArg Subtype.val hkpow).trans hvw)).trans w.property
  have hcpow : c ^ k = 1 := orderOf_dvd_iff_zpow_eq_one.mp (by
    rw [hcorder, ← hzorder]
    exact orderOf_dvd_iff_zpow_eq_one.mpr hpowimage)
  have hwone : (w : E) = 1 := by
    rw [← hvw, ← hkpow, hcpow, map_one]
  rw [hwone, orderOf_one] at hwE
  norm_num at hwE

end PerfectCentralCovering
