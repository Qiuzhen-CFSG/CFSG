module
public import Theory.GroupTheory.CComponent.ProperNormalizerIndex
public import Theory.GroupTheory.CommutatorPreimage
public import Theory.GroupTheory.Commutator.SimpleSubnormal

/-!
# Perfect centralization through a core supplement

If a perfect subgroup is generated by a point centralizer and actors whose
commutators with the point lie in a central layer, it centralizes the point.
The three-subgroup lemma removes the remaining action on that layer.
Equal orders of intrinsic two-core quotients supply the required supplement
inside a literal ambient subgroup.

These are the group-theoretic steps in the equal-rank endpoint argument of
Aschbacher--Smith 14.6.24(3), printed p.1041. The actual Chapter14 consumer
retains the central point and opposite module, rather than assuming that
the two-core centralizes the unquotiented module.
-/

public section
open Subgroup
open scoped commutatorElement
namespace Subgroup
variable {G : Type*} [Group G]

/-- Perfectness removes a central commutator layer after supplementing by a point centralizer. -/
theorem centralizes_of_perfect_supplement
    (J B Q A Z : Subgroup G) [Group.IsPerfect J]
    (hgen : J ≤ B ⊔ Q) (hBZ : B ≤ normalizer (Z : Set G))
    (hQZ : Q ≤ normalizer (Z : Set G))
    (hBA : B ≤ centralizer (A : Set G)) (hQA : ⁅Q,A⁆ ≤ Z)
    (hZJ : Z ≤ centralizer (J : Set G)) : J ≤ centralizer (A : Set G) := by
  have hs : B ⊔ Q ≤ commutatorPreimage (normalizer (Z : Set G)) A Z :=
    sup_le (le_commutatorPreimage hBZ
      ((commutator_eq_bot_iff_le_centralizer.mpr hBA).le.trans bot_le))
      (le_commutatorPreimage hQZ hQA)
  have hc : ⁅J,A⁆ ≤ Z := (commutator_mono (hgen.trans hs) le_rfl).trans
    (commutator_commutatorPreimage_le _ _ _ le_rfl)
  apply le_centralizer_iff.mp
  apply commutator_eq_bot_iff_le_centralizer.mp
  apply commutator_eq_bot_of_iterated_eq_bot
  rw [commutator_comm A J]
  exact commutator_eq_bot_iff_le_centralizer.mpr (hc.trans hZJ)

/-- Equal or larger intrinsic quotient order gives a literal two-core supplement. -/
theorem sup_twoCoreIn_eq_of_quotient_card_le [Finite G]
    (B J : Subgroup G) (hBJ : B ≤ J)
    (hc : Nat.card (J ⧸ pCore 2 J) ≤ Nat.card (B ⧸ pCore 2 B)) :
    B ⊔ J.pCoreIn 2 = J := by
  let e := subgroupOfEquivOfLe hBJ
  let eq := e.toMonoidHom.pCoreQuotientEquiv (p := 2) e.surjective
    (IsPGroup.ker_isPGroup_of_injective e.injective)
  have hcard : Nat.card (J ⧸ pCore 2 J) ≤
      Nat.card (B.subgroupOf J ⧸ pCore 2 (B.subgroupOf J)) := by
    rwa [Nat.card_congr eq.toEquiv]
  have hh := congrArg (Subgroup.map J.subtype)
    (sup_twoCore_eq_top_of_quotient_card_le (B.subgroupOf J) hcard)
  simpa only [pCoreIn,map_sup,map_subgroupOf_eq_of_le hBJ,
    ←MonoidHom.range_eq_map,range_subtype] using hh
end Subgroup
