module

public import Theory.GroupTheory.PerfectFiveSectionSmallCore

/-!
# A simple five-section acts trivially on a small normal two-section

A two-perfect group with simple two-core quotient divisible by five is
generated by its five-elements. Its action on a normal section of order
dividing eight is therefore trivial. The statement keeps the literal
quotient map and bounds the original ambient commutator by its kernel.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {L G : Type*} [Group L] [Finite L] [Group G] [Finite G]

theorem hom_eq_one_of_twoPerfect_simple_five_section
    [IsSimpleGroup (L ⧸ pCore 2 L)] (hL : IsPPerfect 2 L)
    (hfive : 5 ∣ Nat.card (L ⧸ pCore 2 L))
    {D : Type*} [Group D] [Finite D] (f : L →* D)
    (hcop : Nat.Coprime 5 (Nat.card D)) : f = 1 := by
  let : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  have hres := primeToResidual_eq_top_of_simple_quotient 5 2
    (pCore 2 L) pCore_isPGroup hL hfive
  have hk := primeToResidual_le_ker f hcop
  rw [hres] at hk
  exact MonoidHom.ker_eq_top_iff.mp (top_le_iff.mp hk)

theorem commutator_le_of_simple_five_small_section
    [IsSimpleGroup (L ⧸ pCore 2 L)] (hL : IsPPerfect 2 L)
    (hfive : 5 ∣ Nat.card (L ⧸ pCore 2 L))
    (f : L →* G) (Q V : Subgroup G) [Q.Normal] [V.Normal]
    (hsmall : Nat.card (Q.map (QuotientGroup.mk' V)) ∣ 8) :
    ⁅Q, f.range⁆ ≤ V := by
  let q := QuotientGroup.mk' V
  let U := Q.map q
  let : U.Normal := Subgroup.Normal.map inferInstance q (QuotientGroup.mk'_surjective V)
  let a : L →* MulAut U := (MulAut.conjNormal : (G ⧸ V) →* MulAut U).comp (q.comp f)
  have ha : a = 1 := hom_eq_one_of_twoPerfect_simple_five_section hL hfive a
    (five_coprime_card_mulAut_of_card_dvd_eight hsmall)
  have hc : f.range.map q ≤ centralizer (U : Set (G ⧸ V)) := by
    rintro _ ⟨_,⟨l,rfl⟩,rfl⟩ u hu
    have he := congrArg (fun b : MulAut U => (b ⟨u,hu⟩ : G ⧸ V))
      (DFunLike.congr_fun ha l)
    change q (f l) * u * (q (f l))⁻¹ = u at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  rw [← QuotientGroup.ker_mk' V, ← Subgroup.map_eq_bot_iff, map_commutator]
  exact commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hc)

end Theory.GroupTheory
