module
public import Theory.GroupTheory.SolvableThreePartCore
public import Theory.GroupTheory.SemidihedralNormalElementary
public import Theory.GroupTheory.PGroup.CharacteristicPairReduction

/-!
# The characteristic involution in solvable groups with a semidihedral Sylow subgroup

In a finite group with nontrivial two-core and a semidihedral Sylow subgroup
of order sixteen, the central involution of that Sylow subgroup generates a
characteristic subgroup. Indeed, the first omega subgroup of the center of
the two-core is nontrivial, elementary abelian and characteristic. Inside
the Sylow subgroup, the semidihedral presentation identifies it with the
subgroup generated by the fourth power of the order-eight generator.

A solvable group of order forty-eight has nontrivial two-core by the small
three-part Fitting argument. Hence every automorphism fixes this involution;
if the group is normal in an overgroup, the whole overgroup centralizes it.

Source application: Aschbacher–Smith, *The Classification of Quasithin
Groups*, the PSU₃(5) case of the Cartan-normalization argument for 9.3.1.
-/

public section
open Subgroup
open scoped IsMulCommutative

namespace Semidihedral
variable {G : Type*} [Group G] [Finite G]

private theorem twoCore_ne_bot_of_solvable_card_forty_eight
    (hs : Group.IsSolvable G) (hcard : Nat.card G = 48) : pCore 2 G ≠ ⊥ := by
  apply Theory.GroupTheory.twoCore_ne_bot_of_solvable_threeCore_le_three hs
  · intro p hp hd
    rw [hcard, show 48 = 2 ^ 4 * 3 by norm_num] at hd
    rcases hp.dvd_mul.mp hd with h | h
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp (hp.dvd_of_dvd_pow h))
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp h)
  · obtain ⟨n, hn⟩ := (pCore_isPGroup (p := 3) (G := G)).exists_card_eq
    have hd : 3 ^ n ∣ 48 := by
      rw [← hn, ← hcard]
      exact (pCore 3 G).card_subgroup_dvd_card
    have hnle : n ≤ 1 := by
      by_contra h
      have hd9 : 9 ∣ 48 := dvd_trans (show 3 ^ 2 ∣ 3 ^ n from pow_dvd_pow 3 (by omega)) hd
      norm_num at hd9
    rw [hn]
    exact (Nat.pow_le_pow_right (by decide : 0 < 3) hnle).trans_eq (by norm_num)
  · rw [hcard]
    norm_num

/-- The central involution line of the marked semidihedral Sylow subgroup is
characteristic as soon as the ambient two-core is nontrivial. -/
theorem characteristic_zpowers_fourth_of_twoCore_ne_bot (S : Sylow 2 G) (a b : S)
    (ha : orderOf a = 8) (hb : orderOf b = 2)
    (hc : b * a * b⁻¹ = a ^ 3)
    (hg : closure ({a, b} : Set S) = ⊤)
    (hcore : pCore 2 G ≠ ⊥) :
    (zpowers ((a : G) ^ 4)).Characteristic := by
  let Q := pCore 2 G
  let : Nontrivial Q := (nontrivial_iff_ne_bot Q).mpr hcore
  let : (omega₁ (center Q) (p := 2)).Characteristic := omega₁_characteristic _
  let : IsElementaryAbelian 2 (omega₁ (center Q) (p := 2)) :=
    IsElementaryAbelian.omega₁_of_isMulCommutative _
  let E₀ := (omega₁ (center Q) (p := 2)).map (center Q).subtype
  let : IsElementaryAbelian 2 E₀ := IsElementaryAbelian.map_subtype
  let E := E₀.map Q.subtype
  let : E.Characteristic := inferInstance
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.map_subtype
  have hEne : E ≠ ⊥ := fun h => omega_center_ne_bot (G := Q) pCore_isPGroup
    ((E₀.map_eq_bot_iff_of_injective Q.subtype_injective).mp h)
  have hES : E ≤ (S : Subgroup G) :=
    (map_subtype_le _).trans (pCore_isPGroup.le_sylow_of_normal S)
  let R := E.subgroupOf (S : Subgroup G)
  let : R.Normal := inferInstance
  let : IsElementaryAbelian 2 R := IsElementaryAbelian.subgroupOf hES
  have hRne : R ≠ ⊥ := by
    intro h
    apply hEne
    have hh := congrArg (Subgroup.map (S : Subgroup G).subtype) h
    simpa only [R, map_subgroupOf_eq_of_le hES, Subgroup.map_bot] using hh
  have hR := normal_elementary_eq_of_order_sixteen a b ha hb hc hg R hRne
  have hE : E = zpowers ((a : G) ^ 4) := by
    have hh := congrArg (Subgroup.map (S : Subgroup G).subtype) hR
    simpa only [R, map_subgroupOf_eq_of_le hES, MonoidHom.map_zpowers, map_pow,
      Subgroup.coe_subtype] using hh
  rw [← hE]
  infer_instance

/-- Every automorphism fixes the central Sylow involution in a solvable group
of order forty-eight with the marked semidihedral Sylow presentation. -/
theorem automorphism_fix_fourth_of_solvable_card_forty_eight
    (hs : Group.IsSolvable G) (hcard : Nat.card G = 48)
    (S : Sylow 2 G) (a b : S)
    (ha : orderOf a = 8) (hb : orderOf b = 2)
    (hc : b * a * b⁻¹ = a ^ 3)
    (hg : closure ({a, b} : Set S) = ⊤)
    (φ : MulAut G) : φ ((a : G) ^ 4) = (a : G) ^ 4 := by
  classical
  let z : G := (a : G) ^ 4
  have hz : orderOf z = 2 := by
    change orderOf ((a : G) ^ 4) = 2
    rw [orderOf_pow, orderOf_coe, ha]
    decide
  have hz1 : z ≠ 1 := by
    intro h
    rw [h, orderOf_one] at hz
    omega
  let : (zpowers z).Characteristic :=
    characteristic_zpowers_fourth_of_twoCore_ne_bot S a b ha hb hc hg
      (twoCore_ne_bot_of_solvable_card_forty_eight hs hcard)
  have hm : φ z ∈ zpowers z :=
    characteristic_iff_le_comap.mp inferInstance φ (mem_zpowers z)
  rw [mem_zpowers_iff_mem_range_orderOf, hz] at hm
  obtain ⟨n, hn, he⟩ := Finset.mem_image.mp hm
  have hn2 : n < 2 := Finset.mem_range.mp hn
  interval_cases n
  · have hφ : φ z = 1 := by simpa using he.symm
    exact False.elim (hz1 (φ.injective (hφ.trans (map_one φ).symm)))
  · simpa only [pow_one] using he.symm

/-- Application to a literal normal subgroup: the whole overgroup centralizes
the fourth power of its marked order-eight Sylow generator. -/
theorem conj_fix_fourth_of_normal_solvable_card_forty_eight
    {Y : Type*} [Group Y] [Finite Y]
    (X : Subgroup Y) [X.Normal]
    (hs : Group.IsSolvable X) (hcard : Nat.card X = 48)
    (S : Sylow 2 X) (a b : S)
    (ha : orderOf a = 8) (hb : orderOf b = 2)
    (hc : b * a * b⁻¹ = a ^ 3)
    (hg : closure ({a, b} : Set S) = ⊤)
    (y : Y) : y * ((a : X) : Y) ^ 4 * y⁻¹ = ((a : X) : Y) ^ 4 := by
  have h := automorphism_fix_fourth_of_solvable_card_forty_eight hs hcard S a b
    ha hb hc hg (MulAut.conjNormal y)
  exact congrArg X.subtype h

end Semidihedral
