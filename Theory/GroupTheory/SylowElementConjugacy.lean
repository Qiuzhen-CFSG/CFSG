module
public import Mathlib.GroupTheory.Sylow

/-!
# Conjugating prime-power-order elements into a chosen Sylow subgroup

In a finite group, an element whose order is a power of a prime `p` has a
conjugate in any chosen Sylow `p`-subgroup. The result returns an element
of that subgroup itself, with ambient conjugacy in the specified direction.

The cyclic subgroup generated by the element is a `p`-group, so it lies
in a Sylow subgroup. Sylow conjugacy carries that subgroup, and therefore
the element, into the chosen one. This standard consequence of the Sylow
theorems is used in the global involution and order-four conjugacy counts
of ABG Chapter II, §1, Proposition 1, in
`refs/latex/alperin-brauer-gorenstein.tex`.
-/

open scoped Pointwise
namespace Sylow
/-- Every prime-power-order element has a conjugate in a chosen Sylow subgroup. -/
public theorem exists_isConj_of_orderOf_eq_prime_pow
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (P : Sylow p G) {x : G} {n : ℕ} (hx : orderOf x = p ^ n) :
    ∃ y : P, IsConj x (y : G) := by
  have hp : IsPGroup p (Subgroup.zpowers x) :=
    IsPGroup.of_card (by simpa only [Nat.card_zpowers] using hx)
  obtain ⟨Q, hQ⟩ := hp.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G Q P
  have hy : (MulAut.conj g) x ∈ P := by
    rw [← hg]
    change (MulAut.conj g) • x ∈ (MulAut.conj g) • (Q : Set G)
    exact Set.smul_mem_smul_set (hQ (Subgroup.mem_zpowers x))
  exact ⟨⟨(MulAut.conj g) x, hy⟩, isConj_iff.mpr ⟨g, rfl⟩⟩
end Sylow
