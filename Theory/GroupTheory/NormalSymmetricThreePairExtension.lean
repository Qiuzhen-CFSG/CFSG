module
public import Theory.GroupTheory.SymmetricThreePairAutomorphisms
public import Theory.GroupTheory.PGroup.NormalSupplementKernel
public import Theory.GroupTheory.PGroup.NormalDirectPowerSection
public import Theory.GroupTheory.PCoreFrattiniTransport

/-!
# Two-group extensions of a symmetric-three pair

A finite group generated by a normal subgroup with two-core quotient
S₃ × S₃ and a two-subgroup has quotient S₃ × S₃ or S₃ ≀ C₂ over its own
two-core. After removing that core, conjugation on the normal pair is
faithful: the restricted action is faithful and the supplement makes its
whole kernel a two-group. The automorphism calculation then gives the
exact alternatives. Neither extension is assumed to split before quotienting.

The normalized-join form retains the original subgroups and their own cores.
Source application: Aschbacher--Smith 15.1.22(3), pp.1099--1100.
-/

public section
open Subgroup
set_option linter.style.haveILetI false

namespace Theory.GroupTheory.NormalSymmetricThreePairExtension
open SymmetricThreePairAutomorphisms
variable {G : Type*} [Group G]

/-- A core-free group generated by a normal symmetric-three pair and a
two-subgroup is either that pair or its full automorphism group. -/
theorem coreFree (hcore : pCore 2 G = ⊥)
    (N P : Subgroup G) [N.Normal] (e : N ≃* X)
    (hP : IsPGroup 2 P) (hgen : N ⊔ P = ⊤) :
    Nonempty (G ≃* X) ∨ Nonempty (G ≃* W) := by
  let f : G →* MulAut X :=
    (MulAut.congr e).toMonoidHom.comp (MulAut.conjNormal (H := N))
  have hfN : f.comp N.subtype = (MulAut.conj : X →* MulAut X).comp e.toMonoidHom := by
    apply MonoidHom.ext
    intro x
    apply MulEquiv.ext
    intro y
    change e (x * e.symm y * x⁻¹) = e x * y * (e x)⁻¹
    simp
  have hkerN : (f.comp N.subtype).ker = ⊥ := by
    apply (MonoidHom.ker_eq_bot_iff _).mpr
    rw [hfN]
    exact pair_conj_injective.comp e.injective
  have hk : IsPGroup 2 f.ker := f.kernel_isPGroup_of_normal_supplement N P hP hgen
    (by rw [hkerN]; exact IsPGroup.of_subsingleton 2 _)
  have hf : Function.Injective f := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    exact bot_unique ((show f.ker ≤ pCore 2 G from le_sSup ⟨inferInstance,hk⟩).trans hcore.le)
  have hR : (MulAut.conj : X →* MulAut X).range ≤ f.range := by
    rintro _ ⟨x,rfl⟩
    obtain ⟨y,rfl⟩ := e.surjective x
    exact ⟨y,DFunLike.congr_fun hfN y⟩
  rcases inner_overgroup f.range hR with hr | hr
  · exact Or.inl ⟨(MonoidHom.ofInjective hf).trans
      ((MulEquiv.subgroupCongr hr).trans (MonoidHom.ofInjective pair_conj_injective).symm)⟩
  · exact Or.inr ⟨(MonoidHom.ofInjective hf).trans
      (((MulEquiv.subgroupCongr hr).trans topEquiv).trans autEquiv)⟩

/-- Normal two-group extensions of the pair retain exactly the product and
wreath possibilities modulo their own two-core. No splitting is assumed. -/
theorem quotient [Finite G]
    (N P : Subgroup G) [N.Normal] (e : (N ⧸ pCore 2 N) ≃* X)
    (hP : IsPGroup 2 P) (hgen : N ⊔ P = ⊤) :
    Nonempty ((G ⧸ pCore 2 G) ≃* X) ∨
      Nonempty ((G ⧸ pCore 2 G) ≃* W) := by
  let q := QuotientGroup.mk' (pCore 2 G)
  let I := N.map q
  let R := P.map q
  letI : I.Normal := Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  let t : I ≃* X :=
    ((Normal.isSubnormal (inferInstance : N.Normal)).quotientCoreImageEquiv 2).symm.trans e
  have hgen' : I ⊔ R = ⊤ := by
    rw [←Subgroup.map_sup,hgen,←MonoidHom.range_eq_map,
      q.range_eq_top_of_surjective (QuotientGroup.mk'_surjective _)]
  have hqker : IsPGroup 2 q.ker := by
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hcore : pCore 2 (G ⧸ pCore 2 G) = ⊥ := by
    apply comap_injective (QuotientGroup.mk'_surjective (pCore 2 G))
    rw [q.comap_pCore_of_ker_isPGroup (QuotientGroup.mk'_surjective _) hqker,
      MonoidHom.comap_bot,QuotientGroup.ker_mk']
  exact coreFree hcore I R t (hP.map q) hgen'

/-- The dichotomy for the literal join with a normalizing two-subgroup. -/
theorem normalized_join [Finite G]
    (N P : Subgroup G) (hn : P ≤ normalizer (N : Set G))
    (e : (N ⧸ pCore 2 N) ≃* X) (hP : IsPGroup 2 P) :
    Nonempty (((N ⊔ P : Subgroup G) ⧸ pCore 2 (N ⊔ P : Subgroup G)) ≃* X) ∨
      Nonempty (((N ⊔ P : Subgroup G) ⧸ pCore 2 (N ⊔ P : Subgroup G)) ≃* W) := by
  let H := N ⊔ P
  let I := N.subgroupOf H
  let R := P.subgroupOf H
  letI : I.Normal := normal_subgroupOf_of_le_normalizer (sup_le N.le_normalizer hn)
  let t : I ≃* N := subgroupOfEquivOfLe (show N ≤ H from le_sup_left)
  have hgen : I ⊔ R = ⊤ := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le (show N ≤ H from le_sup_left),
      map_subgroupOf_eq_of_le (show P ≤ H from le_sup_right),
      ←MonoidHom.range_eq_map,range_subtype]
  exact quotient I R ((QuotientGroup.congr _ _ t (pCore_map_iso 2 t)).trans e)
    hP.comap_subtype hgen

end Theory.GroupTheory.NormalSymmetricThreePairExtension
