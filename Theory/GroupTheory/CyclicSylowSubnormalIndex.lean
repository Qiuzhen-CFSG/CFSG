module

public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Theory.GroupTheory.OddPrimeRankOneSylow
public import Mathlib.GroupTheory.SpecificGroups.ZGroup

/-!
# Cyclic Sylow subgroups and subnormal residual index

If a normal subgroup N has commutator order divisible by p, a cyclic
Sylow p-subgroup lies in N. Apply the cyclic-Sylow commutator dichotomy
inside NP: its commutator lies in N, and its index is prime to p.

For a subnormal subgroup generated by its p-elements, repeat this argument
along the subnormal chain. At each step N is the prime-to-p residual,
so it is characteristic and therefore normal in the next step. Odd prime
rank at most one supplies the cyclic Sylow groups throughout the chain.

This is the transfer step for the perfect-quotient blocks in
Aschbacher–Smith, E.6.14, printed p.251. The cyclic-Sylow dichotomy itself
is Mathlib's `Sylow.not_dvd_card_commutator_or_not_dvd_index_commutator`.
-/

public section
namespace Subgroup

/-- A normal subgroup whose commutator has p-torsion has index prime to p
when an ambient Sylow p-subgroup is cyclic. -/
theorem coprime_index_of_cyclicSylow_of_dvd_commutator {G : Type*} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] (N : Subgroup G) [N.Normal]
    (P : Sylow p G) [IsCyclic P]
    (hd : p ∣ Nat.card (_root_.commutator N)) : Nat.Coprime p N.index := by
  let K := N ⊔ (P : Subgroup G)
  let Q := P.subtype (show (P : Subgroup G) ≤ K from le_sup_right)
  let A := N.subgroupOf K
  let : A.Normal := inferInstance
  let eP := subgroupOfEquivOfLe (show (P : Subgroup G) ≤ K from le_sup_right)
  let : IsCyclic Q := isCyclic_of_injective eP.toMonoidHom eP.injective
  have hgen : A ⊔ (Q : Subgroup K) = ⊤ := by
    apply (map_injective K.subtype_injective)
    change (N.subgroupOf K ⊔ (P : Subgroup G).subgroupOf K).map K.subtype =
      (⊤ : Subgroup K).map K.subtype
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le (show N ≤ K from le_sup_left),
      map_subgroupOf_eq_of_le (show (P : Subgroup G) ≤ K from le_sup_right),
      ← MonoidHom.range_eq_map, range_subtype]
  have hder : _root_.commutator K ≤ A :=
    Subgroup.Normal.commutator_le_of_self_sup_commutative_eq_top hgen inferInstance
  let e := subgroupOfEquivOfLe (show N ≤ K from le_sup_left)
  have hdA : p ∣ Nat.card (_root_.commutator A) := by
    have he : (_root_.commutator A).map e.toMonoidHom = _root_.commutator N := by
      simp only [_root_.commutator_def, map_commutator,
        map_top_of_surjective e.toMonoidHom e.surjective]
    rw [← he, card_map_of_injective e.injective] at hd
    exact hd
  have hdc : p ∣ Nat.card (_root_.commutator K) := by
    have hm : (_root_.commutator A).map A.subtype ≤ _root_.commutator K := by
      rw [map_subtype_commutator]
      exact commutator_mono le_top le_top
    have hdmap : p ∣ Nat.card ((_root_.commutator A).map A.subtype) := by
      rwa [card_map_of_injective A.subtype_injective]
    exact hdmap.trans (card_dvd_of_le hm)
  have hcop : Nat.Coprime p A.index := by
    apply (Fact.out : p.Prime).coprime_iff_not_dvd.mpr
    exact fun h => (Q.not_dvd_card_commutator_or_not_dvd_index_commutator.resolve_left
      (not_not.mpr hdc)) (h.trans (index_dvd_of_le hder))
  have hcopK : Nat.Coprime p K.index :=
    ((Fact.out : p.Prime).coprime_iff_not_dvd.mpr P.not_dvd_index).coprime_dvd_right
      (index_dvd_of_le (show (P : Subgroup G) ≤ K from le_sup_right))
  rw [← relIndex_mul_index (show N ≤ K from le_sup_left)]
  exact hcop.mul_right hcopK


/-- Subnormality suffices for a subgroup intrinsically generated by p-elements
and with p-torsion in its commutator, when the odd prime rank is at most one. -/
theorem coprime_index_of_subnormal_primeToResidual_of_rank_one {G : Type*} [Group G] [Finite G]
    {p : ℕ} [Fact p.Prime] (N : Subgroup G)
    (hsub : N.IsSubnormal) (hres : primeToResidual p N = ⊤)
    (hp : Odd p) (hrank : primeRank p G ≤ 1)
    (hd : p ∣ Nat.card (_root_.commutator N)) : Nat.Coprime p N.index := by
  obtain ⟨n, F, hmono, hnorm, hzero, hn⟩ := hsub.exists_chain
  have hNF (i : ℕ) : N ≤ F i := hzero ▸ hmono (Nat.zero_le i)
  have hmain (i : ℕ) : (primeToResidual p (F i)).map (F i).subtype = N := by
    induction i with
    | zero =>
      rw [hzero, hres, ← MonoidHom.range_eq_map, range_subtype]
    | succ i ih =>
      have hnormal : F (i + 1) ≤ normalizer (N : Set G) := by
        rw [← ih]
        exact ((normal_subgroupOf_iff_le_normalizer (hmono (Nat.le_succ i))).mp
          (hnorm i)).trans
          (normalizer_le_normalizer_characteristic_image (F i) (primeToResidual p (F i)))
      let A := N.subgroupOf (F (i + 1))
      let : A.Normal := normal_subgroupOf_of_le_normalizer hnormal
      let e := subgroupOfEquivOfLe (hNF (i + 1))
      have hAres : primeToResidual p A = ⊤ := by
        have he := map_primeToResidual (p := p) e.symm
        rw [hres, map_top_of_surjective e.symm.toMonoidHom e.symm.surjective] at he
        exact he.symm
      have hAd : p ∣ Nat.card (_root_.commutator A) := by
        have he : (_root_.commutator A).map e.toMonoidHom = _root_.commutator N := by
          simp only [_root_.commutator_def, map_commutator,
            map_top_of_surjective e.toMonoidHom e.surjective]
        rw [← he, card_map_of_injective e.injective] at hd
        exact hd
      let P : Sylow p (F (i + 1)) := Classical.choice inferInstance
      let : IsCyclic P := by
        apply P.isCyclic_of_odd_of_elementary_card_le hp
        intro E hE
        let := hE
        let : IsElementaryAbelian p (E.map (F (i + 1)).subtype) :=
          IsElementaryAbelian.map_subtype
        have hh := IsElementaryAbelian.card_le_prime_of_primeRank_le_one hrank
          (E.map (F (i + 1)).subtype)
        rwa [card_map_of_injective (F (i + 1)).subtype_injective] at hh
      have hiA := coprime_index_of_cyclicSylow_of_dvd_commutator A P hAd
      have he : primeToResidual p (F (i + 1)) = A :=
        le_antisymm (primeToResidual_le A hiA) (le_primeToResidual_of_eq_top p A hAres)
      rw [he, map_subgroupOf_eq_of_le (hNF _)]
  have he := hmain n
  rw [hn] at he
  change (primeToResidual p (⊤ : Subgroup G)).map topEquiv.toMonoidHom = N at he
  rw [map_primeToResidual] at he
  rw [← he]
  exact primeToResidual_index_coprime p

end Subgroup
