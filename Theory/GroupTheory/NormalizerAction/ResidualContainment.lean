module
public import Theory.GroupTheory.NormalizerAction
public import Theory.GroupTheory.PResidual.PrimeToTransport

/-!
# Recovering a prime-generated subgroup from its inner action

Suppose D normalizes K and its actual image in N(K)/C(K) lies in K/Z(K).
Then D lies in K C(K). If D is generated by its p-elements and C(K) has
order prime to p, the image of D modulo K is trivial. This recovers D≤K
without identifying D with its faithful action image or classifying every
outer actor. The literal normalizer quotient is retained throughout.

Source application: Aschbacher--Smith 13.6.6, printed p.927.
-/

public section
open Subgroup
namespace Subgroup.NormalizerAction
variable {G : Type*} [Group G] {p : ℕ}
theorem le_component_of_prime_generated_inner_image
    (K D : Subgroup G) (hDN : D ≤ normalizer (K : Set G))
    (himage : (D.subgroupOf (normalizer (K : Set G))).map (quotient K) ≤ componentImage K)
    (hD : primeToResidual p D = ⊤)
    (hC : Nat.Coprime p (Nat.card (centralizer (K : Set G)))) : D ≤ K := by
  let N := normalizer (K : Set G)
  let A := K.subgroupOf N
  let B := (centralizer (K : Set G)).subgroupOf N
  let D0 := D.subgroupOf N
  let q := QuotientGroup.mk' A
  have hAB : D0 ≤ A ⊔ B := by
    have hh := (map_le_iff_le_comap).mp himage
    change D0 ≤ ((A.map (quotient K)).comap (quotient K)) at hh
    rw [comap_map_eq] at hh
    have hk : (quotient K).ker = B := by
      change (QuotientGroup.mk' (C K)).ker = B
      rw [QuotientGroup.ker_mk']
    exact hk ▸ hh
  have hmap : D0.map q ≤ B.map q := by
    have hh := map_mono (f := q) hAB
    rw [map_sup] at hh
    have hA : A.map q = ⊥ := (map_eq_bot_iff A).mpr (by rw [QuotientGroup.ker_mk'])
    simpa only [hA, bot_sup_eq] using hh
  let f : D0 →* B.map q := (q.comp D0.subtype).codRestrict _ (fun x =>
    hmap (mem_map_of_mem q x.property))
  have hBc : Nat.Coprime p (Nat.card B) := by
    rw [Nat.card_congr (subgroupOfEquivOfLe
      (centralizer_le_normalizer (K : Set G))).toEquiv]
    exact hC
  have hc : Nat.Coprime p (Nat.card (B.map q)) :=
    hBc.coprime_dvd_right (card_map_dvd B q)
  have hD0 : primeToResidual p D0 = ⊤ := by
    let e := (subgroupOfEquivOfLe hDN).symm
    have hh := map_primeToResidual (p := p) e
    rw [hD, map_top_of_surjective _ e.surjective] at hh
    exact hh.symm
  have hk := primeToResidual_le_ker f hc
  rw [hD0] at hk
  intro x hx
  let y : D0 := ⟨⟨x,hDN hx⟩,hx⟩
  have hy : f y = 1 := hk (show y ∈ ⊤ from trivial)
  have hq : q y.val = 1 := congrArg Subtype.val hy
  exact (QuotientGroup.eq_one_iff y.val).mp hq
end Subgroup.NormalizerAction
