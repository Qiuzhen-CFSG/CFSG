module

public import Mathlib.GroupTheory.OrderOfElement

/-!
# Collecting words through a cyclic extension

In a finite group, suppose conjugation by `a` carries the generators of `H`
into `H`, and `a ^ m = 1`. Every element generated by `H` and `a` then has
the form `h * a ^ i`, with `i < m`. Conjugation extends from the generators
to their subgroup by the closure universal property. Induction on positive
words collects one letter at a time; finiteness supplies positive words for
inverses. This is the elementary collection step for a polycyclic sequence.
-/

namespace Theory.GroupTheory

/-- Collect an element of a finite cyclic extension, keeping the old subgroup
on the left and a bounded power of the new generator on the right. -/
public theorem exists_mul_pow_of_mem_closure_insert
    {G : Type*} [Group G] [Finite G]
    (S : Set G) (a : G) (m : ℕ) (hm : 0 < m) (ha : a ^ m = 1)
    (hc : ∀ b ∈ S, a * b * a⁻¹ ∈ Subgroup.closure S)
    {x : G} (hx : x ∈ Subgroup.closure (insert a S)) :
    ∃ y ∈ Subgroup.closure S, ∃ i : Fin m, y * a ^ i.val = x := by
  have hconj : ∀ y ∈ Subgroup.closure S, a * y * a⁻¹ ∈ Subgroup.closure S := by
    have hle : Subgroup.closure S ≤
        (Subgroup.closure S).comap (MulAut.conj a).toMonoidHom :=
      (Subgroup.closure_le _).mpr hc
    exact hle
  change x ∈ (Subgroup.closure (insert a S)).toSubmonoid at hx
  rw [Subgroup.closure_toSubmonoid_of_finite] at hx
  induction hx using Submonoid.closure_induction_left with
  | one => exact ⟨1, (Subgroup.closure S).one_mem, ⟨0, hm⟩, by simp⟩
  | mul_left b hb x _ ih =>
    rcases ih with ⟨y, hy, i, rfl⟩
    rcases hb with rfl | hb
    · refine ⟨b * y * b⁻¹, hconj y hy,
        ⟨(i.val + 1) % m, Nat.mod_lt _ hm⟩, ?_⟩
      rw [← pow_eq_pow_mod _ ha, pow_succ']
      simp [mul_assoc]
    · exact ⟨b * y, (Subgroup.closure S).mul_mem (Subgroup.subset_closure hb) hy,
        i, mul_assoc _ _ _⟩

end Theory.GroupTheory
