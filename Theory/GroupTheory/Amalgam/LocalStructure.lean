module

public import Theory.GroupTheory.Amalgam.RankTwo
public import Theory.PGroupCore

/-!
# Transport of local cores in a rank-two amalgam

An actual group isomorphism restricts to an isomorphism of prime cores and
descends to their quotients. Thus parabolic equivalence transports these
invariants of the three groups. To transport a subgroup generated by a marked
local subgroup and a marked subgroup of the overlap, one also needs the
commuting squares of an amalgam isomorphism. These squares identify the images
of the overlap; preservation of joins then gives the required restriction.

In the application to Aschbacher--Smith, F.1.12, the groups of the amalgam
are `LᵢB`, whereas some asserted cores are those of `Lᵢ` or `LᵢS`. The
subgroup maps below retain this distinction. A join models the generated
subgroup; identifying it with a product requires the appropriate normalization
hypothesis in the application.

Source: *The Classification of Quasithin Groups*, Notation F.1.11 and
Proposition F.1.12, printed pp. 262--264. No recognition or concrete-model
existence theorem is asserted here.
-/

@[expose] public section

namespace Theory.GroupTheory

namespace LocalCoreTransport

variable {G H : Type*} [Group G] [Group H]

/-- Restriction of an isomorphism to the intrinsic prime cores. -/
def coreEquiv (p : ℕ) (e : G ≃* H) : pCore p G ≃* pCore p H :=
  (e.subgroupMap (pCore p G)).trans (MulEquiv.subgroupCongr (pCore_map_iso p e))

/-- The induced isomorphism on the actual quotients by the prime cores. -/
def quotientEquiv (p : ℕ) (e : G ≃* H) :
    (G ⧸ pCore p G) ≃* (H ⧸ pCore p H) :=
  QuotientGroup.congr _ _ e (pCore_map_iso p e)

/-- Restriction to specified subgroups, with their images explicitly checked. -/
def subgroupEquiv (e : G ≃* H) {K : Subgroup G} {K' : Subgroup H}
    (h : K.map e.toMonoidHom = K') : K ≃* K' :=
  (e.subgroupMap K).trans (MulEquiv.subgroupCongr h)

@[simp] theorem coreEquiv_apply (p : ℕ) (e : G ≃* H) (x : pCore p G) :
    (coreEquiv p e x : H) = e x := rfl

@[simp] theorem quotientEquiv_mk (p : ℕ) (e : G ≃* H) (x : G) :
    quotientEquiv p e (QuotientGroup.mk x) = QuotientGroup.mk (e x) := rfl

@[simp] theorem subgroupEquiv_apply (e : G ≃* H) {K : Subgroup G}
    {K' : Subgroup H} (h : K.map e.toMonoidHom = K') (x : K) :
    (subgroupEquiv e h x : H) = e x := rfl

theorem core_card (p : ℕ) (e : G ≃* H) :
    Nat.card (pCore p G) = Nat.card (pCore p H) :=
  Nat.card_congr (coreEquiv p e).toEquiv

end LocalCoreTransport

namespace RankTwoAmalgam

variable {L B R L' B' R' : Type*}
  [Group L] [Group B] [Group R] [Group L'] [Group B'] [Group R']
  {α : RankTwoAmalgam L B R} {β : RankTwoAmalgam L' B' R'}

namespace ParabolicEquiv

/-- Local quotient information needs no commuting-square hypothesis. -/
def leftCoreQuotientEquiv (e : ParabolicEquiv α β) (p : ℕ) :
    (L ⧸ pCore p L) ≃* (L' ⧸ pCore p L') :=
  LocalCoreTransport.quotientEquiv p e.left

def rightCoreQuotientEquiv (e : ParabolicEquiv α β) (p : ℕ) :
    (R ⧸ pCore p R) ≃* (R' ⧸ pCore p R') :=
  LocalCoreTransport.quotientEquiv p e.right

end ParabolicEquiv

namespace Iso

/-- Compatibility identifies the left image of every subgroup of the overlap. -/
theorem map_left_overlap (e : Iso α β) (S : Subgroup B) :
    (S.map α.left).map e.left.toMonoidHom =
      (S.map e.middle.toMonoidHom).map β.left := by
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1
  exact MonoidHom.ext e.left_commutes

/-- Compatibility identifies the right image of every subgroup of the overlap. -/
theorem map_right_overlap (e : Iso α β) (S : Subgroup B) :
    (S.map α.right).map e.right.toMonoidHom =
      (S.map e.middle.toMonoidHom).map β.right := by
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1
  exact MonoidHom.ext e.right_commutes

/-- Restrict an amalgam isomorphism to the left local subgroup enlarged by `S`.
The two marked images are hypotheses, not consequences of recognition. -/
def leftLocalEquiv (e : Iso α β) {K : Subgroup L} {K' : Subgroup L'}
    (hK : K.map e.left.toMonoidHom = K') {S : Subgroup B} {S' : Subgroup B'}
    (hS : S.map e.middle.toMonoidHom = S') :
    (K ⊔ S.map α.left : Subgroup L) ≃* (K' ⊔ S'.map β.left : Subgroup L') :=
  LocalCoreTransport.subgroupEquiv e.left (by
    rw [Subgroup.map_sup, hK, e.map_left_overlap, hS])

/-- Restrict an amalgam isomorphism to the right local subgroup enlarged by `S`. -/
def rightLocalEquiv (e : Iso α β) {K : Subgroup R} {K' : Subgroup R'}
    (hK : K.map e.right.toMonoidHom = K') {S : Subgroup B} {S' : Subgroup B'}
    (hS : S.map e.middle.toMonoidHom = S') :
    (K ⊔ S.map α.right : Subgroup R) ≃* (K' ⊔ S'.map β.right : Subgroup R') :=
  LocalCoreTransport.subgroupEquiv e.right (by
    rw [Subgroup.map_sup, hK, e.map_right_overlap, hS])

end Iso

/-- An ambient isomorphism carrying three specified subgroups gives an
isomorphism of their inclusion amalgams, including both commuting squares. -/
def ofSubgroupsIso {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    {P₁ D P₂ : Subgroup G} {P₁' D' P₂' : Subgroup H}
    (h₁ : D ≤ P₁) (h₂ : D ≤ P₂) (h₁' : D' ≤ P₁') (h₂' : D' ≤ P₂')
    (hP₁ : P₁.map e.toMonoidHom = P₁') (hD : D.map e.toMonoidHom = D')
    (hP₂ : P₂.map e.toMonoidHom = P₂') :
    Iso (ofSubgroups P₁ D P₂ h₁ h₂) (ofSubgroups P₁' D' P₂' h₁' h₂') where
  left := LocalCoreTransport.subgroupEquiv e hP₁
  middle := LocalCoreTransport.subgroupEquiv e hD
  right := LocalCoreTransport.subgroupEquiv e hP₂
  left_commutes _ := Subtype.ext rfl
  right_commutes _ := Subtype.ext rfl

end RankTwoAmalgam
end Theory.GroupTheory
