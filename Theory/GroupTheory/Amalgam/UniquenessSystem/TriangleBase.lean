module

public import Theory.GroupTheory.Amalgam.UniquenessSystem.TriangleHomotopy
public import Theory.GroupTheory.GraphUniquenessSystem

/-!
# Triangle bases for uniqueness systems

Backtrack and triangle homotopies imply the nonabelian cycle closure used by
`GraphUniquenessSystem.System.IsBase`. If every triangle lies in a translate of
the local edge orbit, triangle simple connectivity therefore makes that orbit
a base. `LocalTriangle` specializes this to a distinguished three-vertex clique;
its vertex set is proved to be the actual local group orbit, and the local group
stabilizes it setwise.

The proof sends the elementary homotopies to the normal walk congruence and
then replaces its triangle generators by translated local cycles. Combining
this with `TriangleContractionData.simplyConnected` gives the local geometric
criterion used at the end of Aschbacher–Smith §F.5.

Sources: Aschbacher, *Sporadic Groups* (1994), §§33–35 and the definition of
base in §37, p.200; Aschbacher–Smith, *The Classification of Quasithin Groups*,
Lemma F.5.8, printed pp.303–304.
-/

@[expose] public section

namespace SimpleGraph
namespace Walk.TriangleHomotopy
variable {V : Type*} {Γ : SimpleGraph V} {x y : V} {p q : Γ.Walk x y}

/-- Triangle homotopies belong to the nonabelian congruence generated by triangle cycles. -/
theorem toCycleRel (h : p.TriangleHomotopy q) :
    WalkClosure.Rel (WalkClosure.triangles Γ) p q := by
  induction h with
  | refl p => exact .refl p
  | symm _ ih => exact .symm ih
  | trans _ _ ih₁ ih₂ => exact .trans ih₁ ih₂
  | cons h _ ih => exact .append (.refl h.toWalk) ih
  | backtrack h p =>
    simpa using WalkClosure.Rel.append
      (WalkClosure.Rel.cancel (S := WalkClosure.triangles _) h.toWalk) (.refl p)
  | triangle h₁ h₂ h₃ p =>
    have hc := WalkClosure.Rel.append
      (WalkClosure.Rel.cycle (S := WalkClosure.triangles _)
        (.cons h₁ (.cons h₂ h₃.symm.toWalk)) rfl) (.refl h₃.toWalk)
    have hb := WalkClosure.Rel.append
      (WalkClosure.Rel.refl (.cons h₁ h₂.toWalk))
      (WalkClosure.Rel.cancel (S := WalkClosure.triangles _) h₃.symm.toWalk)
    exact .append (hb.symm.trans hc) (.refl p)
end Walk.TriangleHomotopy

/-- Contractibility by triangle moves gives the source normal-cycle closure condition. -/
theorem TriangleSimplyConnected.triangulable {V : Type*} {Γ : SimpleGraph V}
    (h : Γ.TriangleSimplyConnected) : WalkClosure.Triangulable Γ :=
  fun x p => (h x p).toCycleRel
end SimpleGraph

namespace Theory.GroupTheory.GraphUniquenessSystem
universe u v
variable {G : Type u} {V : Type v} [Group G] [MulAction G V]

namespace System
variable (U : System G V)

/-- Every ambient triangle lies in a single translate of the actual local edge orbit. -/
def TrianglesInLocalOrbits : Prop :=
  ∀ a b c, U.graph.Adj a b → U.graph.Adj b c → U.graph.Adj c a →
    ∃ g : G, U.localEdge (g⁻¹ • a) (g⁻¹ • b) ∧
      U.localEdge (g⁻¹ • b) (g⁻¹ • c) ∧ U.localEdge (g⁻¹ • c) (g⁻¹ • a)

/-- An ambient three-edge cycle is a translated local cycle under the triangle-orbit condition. -/
theorem triangle_mem_baseCycles (ht : U.TrianglesInLocalOrbits)
    (a : V) (p : U.graph.Walk a a) (hp : p.length = 3) : p ∈ U.baseCycles a := by
  cases p with
  | nil => simp at hp
  | cons hab p =>
    cases p with
    | nil => simp at hp
    | cons hbc p =>
      cases p with
      | nil => simp at hp
      | cons hca p =>
        cases p with
        | nil =>
          obtain ⟨g, hab', hbc', hca'⟩ := ht _ _ _ hab hbc hca
          exact ⟨g, hab', hbc', hca', trivial⟩
        | cons h p => simp at hp

/-- Triangle contraction and local containment of triangles give a uniqueness-system base. -/
theorem isBase_of_triangleSimplyConnected (hsc : U.graph.TriangleSimplyConnected)
    (ht : U.TrianglesInLocalOrbits) : U.IsBase := by
  apply SimpleGraph.WalkClosure.isCycleBase_of_triangles hsc.triangulable
  intro a p hp
  exact .cycle p (U.triangle_mem_baseCycles ht a p hp)

/-- The local edge orbit is precisely a clique on the distinguished edge and a third vertex. -/
structure LocalTriangle where
  third : V
  third_ne_x : third ≠ U.x
  third_ne_y : third ≠ U.y
  localEdge_iff : ∀ a b, U.localEdge a b ↔
    a ≠ b ∧ a ∈ ({U.x, U.y, third} : Set V) ∧ b ∈ ({U.x, U.y, third} : Set V)

namespace LocalTriangle
variable {U} (T : U.LocalTriangle)

/-- The three vertices of the distinguished local triangle. -/
def vertices : Set V := {U.x, U.y, T.third}

/-- The displayed triangle has exactly the vertices of the actual local group orbit. -/
theorem mem_vertices_iff (a : V) :
    a ∈ T.vertices ↔ ∃ h : U.H, (h : G) • U.x = a := by
  constructor
  · intro ha
    by_cases hx : a = U.x
    · exact ⟨1, by simpa only [Subgroup.coe_one, one_smul] using hx.symm⟩
    obtain ⟨h, he | he⟩ := (T.localEdge_iff a U.x).mpr ⟨hx, ha, by simp⟩
    · exact ⟨h, he.1⟩
    · obtain ⟨k, hk⟩ := U.local_orbit
      exact ⟨h * k, by simp only [Subgroup.coe_mul, mul_smul, hk, he.2]⟩
  · rintro ⟨h, rfl⟩
    exact ((T.localEdge_iff _ _).mp ⟨h, Or.inl ⟨rfl, rfl⟩⟩).2.1

/-- The local group stabilizes the distinguished triangle setwise. -/
theorem local_smul_vertices (h : U.H) :
    (fun v => (h : G) • v) '' T.vertices = T.vertices := by
  ext a
  constructor
  · rintro ⟨v, hv, rfl⟩
    obtain ⟨k, hk⟩ := (T.mem_vertices_iff v).mp hv
    exact (T.mem_vertices_iff _).mpr ⟨h * k, by rw [Subgroup.coe_mul, mul_smul, hk]⟩
  · intro ha
    refine ⟨(h : G)⁻¹ • a, ?_, by simp⟩
    obtain ⟨k, rfl⟩ := (T.mem_vertices_iff a).mp ha
    exact (T.mem_vertices_iff _).mpr
      ⟨h⁻¹ * k, by simp only [Subgroup.coe_mul, Subgroup.coe_inv, mul_smul]⟩

/-- Every ambient triangle is a group translate of the distinguished local triangle. -/
def IsTriangleOrbit : Prop :=
  ∀ a b c, U.graph.Adj a b → U.graph.Adj b c → U.graph.Adj c a →
    ∃ g : G, (fun v => g • v) '' T.vertices = {a, b, c}

/-- Conjugacy of triangles puts every triangle in a translated local edge orbit. -/
theorem trianglesInLocalOrbits (ht : T.IsTriangleOrbit) : U.TrianglesInLocalOrbits := by
  intro a b c hab hbc hca
  obtain ⟨g, hg⟩ := ht a b c hab hbc hca
  have hm {v : V} (hv : v ∈ ({a, b, c} : Set V)) : g⁻¹ • v ∈ T.vertices := by
    rw [← hg] at hv
    obtain ⟨w, hw, rfl⟩ := hv
    simpa only [inv_smul_smul] using hw
  have ha := hm (v := a) (by simp)
  have hb := hm (v := b) (by simp)
  have hc := hm (v := c) (by simp)
  refine ⟨g, (T.localEdge_iff _ _).mpr ⟨?_, ha, hb⟩,
    (T.localEdge_iff _ _).mpr ⟨?_, hb, hc⟩, (T.localEdge_iff _ _).mpr ⟨?_, hc, ha⟩⟩
  · exact fun h => hab.ne ((MulAction.injective g⁻¹) h)
  · exact fun h => hbc.ne ((MulAction.injective g⁻¹) h)
  · exact fun h => hca.ne ((MulAction.injective g⁻¹) h)

/-- A simply connected triangle graph with one triangle orbit has the distinguished triangle as a base. -/
theorem isBase (hsc : U.graph.TriangleSimplyConnected) (ht : T.IsTriangleOrbit) :
    U.IsBase := U.isBase_of_triangleSimplyConnected hsc (T.trianglesInLocalOrbits ht)

/-- The diameter-two common-neighbor criterion and the triangle orbit give a base. -/
theorem isBase_of_contraction (D : U.graph.TriangleContractionData)
    (ht : T.IsTriangleOrbit) : U.IsBase := T.isBase D.simplyConnected ht
end LocalTriangle
end System

end Theory.GroupTheory.GraphUniquenessSystem
