module
public import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected
/-!
# Triangle homotopy and a local contraction criterion

Edge-path homotopy is generated by backtrack cancellation and triangle moves,
with fixed endpoints. Concatenation and graph maps preserve this relation.
Triangle-compatible transport in an arbitrary family of fibers is invariant
under homotopy, hence independent of the path on a triangle-simply-connected graph.

`TriangleContractionData` packages the local conditions used in the diameter-two
criterion: distinct nonadjacent vertices have a connected common-neighbor graph,
and an edge and a vertex nonadjacent to both its endpoints have a common neighbor.
We only need preconnectedness of the common-neighbor graph; the diameter condition
ensures nonemptiness. The proof connects two-edge paths through common neighbors,
then shortens every three-edge path. Induction shortens arbitrary walks and
contracts loops. In fact the shortening argument only uses the two local
conditions; the diameter field separately gives preconnectedness of the graph.

Sources: Aschbacher–Smith, *The Classification of Quasithin Groups*, §F.5,
Lemma F.5.8, printed pp. 303–304; Aschbacher, *Sporadic Groups* (1994),
§§34–35 (especially 34.5, 34.6, 34.8 and 35.14).
-/

public section
namespace SimpleGraph
universe u
variable {V : Type u} {G : SimpleGraph V}
namespace Walk
/-- Edge-path homotopy in the triangle complex of a graph. -/
inductive TriangleHomotopy : {x y : V} → G.Walk x y → G.Walk x y → Prop
  | refl {x y} (p : G.Walk x y) : TriangleHomotopy p p
  | symm {x y} {p q : G.Walk x y} : TriangleHomotopy p q → TriangleHomotopy q p
  | trans {x y} {p q r : G.Walk x y} :
      TriangleHomotopy p q → TriangleHomotopy q r → TriangleHomotopy p r
  | cons {x y z} (h : G.Adj x y) {p q : G.Walk y z} :
      TriangleHomotopy p q → TriangleHomotopy (.cons h p) (.cons h q)
  | backtrack {x y z} (h : G.Adj x y) (p : G.Walk x z) :
      TriangleHomotopy (.cons h (.cons h.symm p)) p
  | triangle {x y z w} (hxy : G.Adj x y) (hyz : G.Adj y z)
      (hxz : G.Adj x z) (p : G.Walk z w) :
      TriangleHomotopy (.cons hxy (.cons hyz p)) (.cons hxz p)
namespace TriangleHomotopy
variable {x y z : V} {p q : G.Walk x y}
/-- Homotopies can be followed by the same walk. -/
theorem append_right (h : TriangleHomotopy p q) (r : G.Walk y z) :
    TriangleHomotopy (p.append r) (q.append r) := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact (ih r).symm
  | trans _ _ ih₁ ih₂ => exact (ih₁ r).trans (ih₂ r)
  | cons h _ ih => exact .cons h (ih r)
  | backtrack h p => exact .backtrack h (p.append r)
  | triangle h₁ h₂ h₃ p => exact .triangle h₁ h₂ h₃ (p.append r)
/-- Homotopies can be preceded by the same walk. -/
theorem append_left (r : G.Walk z x) (h : TriangleHomotopy p q) :
    TriangleHomotopy (r.append p) (r.append q) := by
  induction r with
  | nil => exact h
  | cons h' r ih => exact .cons h' (ih h)
/-- A walk followed by its reverse contracts by backtracks. -/
theorem append_reverse (p : G.Walk x y) : TriangleHomotopy (p.append p.reverse) .nil := by
  induction p with
  | nil => exact .refl _
  | cons h p ih =>
    simp only [reverse_cons, cons_append, append_assoc]
    exact (TriangleHomotopy.cons h (ih.append_right h.symm.toWalk)).trans (.backtrack h .nil)
/-- Graph homomorphisms preserve triangle homotopies. -/
theorem map {W : Type*} {H : SimpleGraph W} (f : G →g H)
    (h : TriangleHomotopy p q) : TriangleHomotopy (p.map f) (q.map f) := by
  induction h with
  | refl => exact .refl _
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | cons h _ ih => exact .cons (f.map_adj h) ih
  | backtrack h p => exact .backtrack (f.map_adj h) (p.map f)
  | triangle h₁ h₂ h₃ p =>
    exact .triangle (f.map_adj h₁) (f.map_adj h₂) (f.map_adj h₃) (p.map f)
end TriangleHomotopy
end Walk
/-- Every closed edge path contracts using triangles and backtracks. -/
@[expose] def TriangleSimplyConnected (G : SimpleGraph V) : Prop :=
  ∀ (x : V) (p : G.Walk x x), p.TriangleHomotopy .nil

/-- Contractibility of closed walks implies uniqueness of paths up to homotopy. -/
theorem TriangleSimplyConnected.homotopic (h : G.TriangleSimplyConnected)
    {x y : V} (p q : G.Walk x y) : p.TriangleHomotopy q := by
  have hq : (q.reverse.append q).TriangleHomotopy .nil := by
    simpa only [Walk.reverse_reverse] using Walk.TriangleHomotopy.append_reverse q.reverse
  have h₁ := hq.append_left p
  have h₂ := (h x (p.append q.reverse)).append_right q
  simp only [Walk.append_nil] at h₁
  simp only [Walk.nil_append, ← Walk.append_assoc] at h₂
  exact h₁.symm.trans h₂

/-- Transport in a family of fibers along graph edges, compatible with the elementary
homotopies. This is useful for lifting paths through graph coverings. -/
structure TriangleTransport (G : SimpleGraph V) (F : V → Type*) where
  edge : ∀ {x y}, G.Adj x y → F x → F y
  backtrack : ∀ {x y} (h : G.Adj x y) (a : F x), edge h.symm (edge h a) = a
  triangle : ∀ {x y z} (hxy : G.Adj x y) (hyz : G.Adj y z) (hxz : G.Adj x z)
    (a : F x), edge hyz (edge hxy a) = edge hxz a

namespace TriangleTransport
variable {F : V → Type*} (T : TriangleTransport G F)
/-- Successively transport an element along a walk. -/
@[expose] def along : {x y : V} → G.Walk x y → F x → F y
  | _, _, .nil, a => a
  | _, _, .cons h p, a => along p (T.edge h a)

/-- Elementary edge-path homotopies preserve transport. -/
theorem along_homotopy {x y : V} {p q : G.Walk x y}
    (h : p.TriangleHomotopy q) (a : F x) : T.along p a = T.along q a := by
  induction h with
  | refl => rfl
  | symm _ ih => exact (ih a).symm
  | trans _ _ ih₁ ih₂ => exact (ih₁ a).trans (ih₂ a)
  | cons h _ ih => exact ih (T.edge h a)
  | backtrack h p => simp only [along, T.backtrack]
  | triangle h₁ h₂ h₃ p => simp only [along, T.triangle h₁ h₂ h₃]

/-- On a triangle-simply-connected graph transport depends only on the endpoints. -/
theorem along_eq (h : G.TriangleSimplyConnected) {x y : V}
    (p q : G.Walk x y) (a : F x) : T.along p a = T.along q a :=
  T.along_homotopy (h.homotopic p q) a

/-- Transport around a contractible closed walk is the identity. -/
theorem along_loop (h : G.TriangleSimplyConnected) {x : V}
    (p : G.Walk x x) (a : F x) : T.along p a = a :=
  T.along_homotopy (h x p) a
end TriangleTransport

/-- The common-neighbor graph of two vertices. -/
@[expose] def commonNeighborGraph (G : SimpleGraph V) (x y : V) :
    SimpleGraph {z : V // G.Adj x z ∧ G.Adj y z} :=
  G.induce {z | G.Adj x z ∧ G.Adj y z}

/-- Local hypotheses for triangle contraction in a graph of diameter at most two. -/
structure TriangleContractionData (G : SimpleGraph V) : Prop where
  short : ∀ x y, x = y ∨ G.Adj x y ∨ ∃ z, G.Adj x z ∧ G.Adj z y
  common_connected : ∀ x y, x ≠ y → ¬ G.Adj x y →
    (G.commonNeighborGraph x y).Preconnected
  triple : ∀ x y v, G.Adj x y → v ≠ x → v ≠ y →
    ¬ G.Adj v x → ¬ G.Adj v y → ∃ a, G.Adj v a ∧ G.Adj x a ∧ G.Adj y a

namespace TriangleContractionData
open Walk Walk.TriangleHomotopy
variable (D : TriangleContractionData G)

private theorem two_step_of_common_path {x y : V}
    {a b : {z : V // G.Adj x z ∧ G.Adj y z}}
    (p : (G.commonNeighborGraph x y).Walk a b) :
    TriangleHomotopy (.cons a.property.1 a.property.2.symm.toWalk)
      (.cons b.property.1 b.property.2.symm.toWalk) := by
  induction p with
  | nil => exact .refl _
  | @cons a c b hac p ih =>
    have hac' : G.Adj a.val c.val := hac
    exact ((TriangleHomotopy.triangle a.property.1 hac' c.property.1 c.property.2.symm.toWalk).symm.trans
      (.cons a.property.1 (.triangle hac' c.property.2.symm a.property.2.symm .nil))).symm.trans ih

include D

/-- The diameter hypothesis supplies a walk of length at most two. -/
theorem short_walk (x y : V) : ∃ p : G.Walk x y, p.length ≤ 2 := by
  rcases D.short x y with h | h | ⟨z, hxz, hzy⟩
  · subst y
    exact ⟨.nil, by simp⟩
  · exact ⟨h.toWalk, by simp⟩
  · exact ⟨.cons hxz hzy.toWalk, by simp⟩

/-- The diameter hypothesis implies preconnectedness, including the empty case. -/
theorem preconnected : G.Preconnected := fun x y => ⟨(D.short_walk x y).choose⟩

/-- Any two walks of length two with the same endpoints are homotopic. -/
theorem two_step {x y a b : V} (hxa : G.Adj x a) (hay : G.Adj a y)
    (hxb : G.Adj x b) (hby : G.Adj b y) :
    TriangleHomotopy (.cons hxa hay.toWalk) (.cons hxb hby.toWalk) := by
  by_cases hxy : x = y
  · subst y
    exact (TriangleHomotopy.backtrack hxa .nil).trans (TriangleHomotopy.backtrack hxb .nil).symm
  by_cases h : G.Adj x y
  · exact (TriangleHomotopy.triangle hxa hay h .nil).trans (TriangleHomotopy.triangle hxb hby h .nil).symm
  obtain ⟨p⟩ := D.common_connected x y hxy h ⟨a, hxa, hay.symm⟩ ⟨b, hxb, hby.symm⟩
  exact two_step_of_common_path p

/-- Every three-edge walk can be shortened to at most two edges. -/
theorem shorten_three {x a b y : V} (hxa : G.Adj x a) (hab : G.Adj a b)
    (hby : G.Adj b y) : ∃ q : G.Walk x y, q.length ≤ 2 ∧
      TriangleHomotopy (.cons hxa (.cons hab hby.toWalk)) q := by
  by_cases hxb : x = b
  · subst b
    exact ⟨hby.toWalk, by simp, .backtrack hxa hby.toWalk⟩
  by_cases h : G.Adj x b
  · exact ⟨.cons h hby.toWalk, by simp, .triangle hxa hab h hby.toWalk⟩
  by_cases hxy : x = y
  · subst y
    exact (h hby.symm).elim
  by_cases h' : G.Adj x y
  · exact ⟨h'.toWalk, by simp,
      (TriangleHomotopy.cons hxa (D.two_step hab hby hxa.symm h')).trans (.backtrack hxa h'.toWalk)⟩
  obtain ⟨c, hxc, hbc, hyc⟩ := D.triple b y x hby hxb hxy h h'
  exact ⟨.cons hxc hyc.symm.toWalk, by simp,
    ((D.two_step hxa hab hxc hbc.symm).append_right hby.toWalk).trans
      (.cons hxc (.triangle hbc.symm hby hyc.symm .nil))⟩

/-- An arbitrary walk is homotopic to one with at most two edges. -/
theorem shorten {x y : V} (p : G.Walk x y) :
    ∃ q : G.Walk x y, q.length ≤ 2 ∧ TriangleHomotopy p q := by
  induction p with
  | nil => exact ⟨.nil, by simp, .refl _⟩
  | cons h p ih =>
    obtain ⟨q, hq, hpq⟩ := ih
    cases q with
    | nil => exact ⟨h.toWalk, by simp, .cons h hpq⟩
    | cons h' q =>
      cases q with
      | nil => exact ⟨.cons h h'.toWalk, by simp, .cons h hpq⟩
      | cons h'' q =>
        cases q with
        | nil =>
          obtain ⟨r, hr, hqr⟩ := D.shorten_three h h' h''
          exact ⟨r, hr, (TriangleHomotopy.cons h hpq).trans hqr⟩
        | cons h''' q => simp at hq

/-- The local common-neighbor conditions contract every closed walk. -/
theorem simplyConnected : G.TriangleSimplyConnected := by
  intro x p
  obtain ⟨q, hq, hpq⟩ := D.shorten p
  apply hpq.trans
  cases q with
  | nil => exact .refl _
  | cons h q =>
    cases q with
    | nil => exact (G.irrefl h).elim
    | cons h' q =>
      cases q with
      | nil => exact .backtrack h .nil
      | cons h'' q => simp at hq
end TriangleContractionData

end SimpleGraph
