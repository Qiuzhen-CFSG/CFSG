module
public import Theory.GroupTheory.Amalgam.RankTwoCompletion

/-!
# The faithful completion in the subgroup generated by the original endpoints

Use the literal two endpoint inclusions into their join. They agree on the
original middle subgroup and generate this join by construction. This avoids
replacing an ambient source subgroup by an abstractly isomorphic carrier when
transporting a marked inclusion amalgam.

Source application: Aschbacher–Smith J.4.5–7, printed pp.441–445.
-/

public section
noncomputable section
namespace Theory.GroupTheory.RankTwoAmalgam.FaithfulCompletion
open Subgroup
variable {G:Type*} [Group G]

/-- The original endpoint inclusions in their actual generated subgroup. -/
def ofGeneratedSubgroups (P₁ T P₂:Subgroup G) (h₁:T≤P₁) (h₂:T≤P₂) :
    FaithfulCompletion (RankTwoAmalgam.ofSubgroups P₁ T P₂ h₁ h₂) (G:=(P₁⊔P₂ : Subgroup G)) where
  left := inclusion le_sup_left
  right := inclusion le_sup_right
  compatible := rfl
  left_injective := inclusion_injective _
  right_injective := inclusion_injective _
  middle_injective := fun _ _ h => Subtype.ext (congrArg (fun x:(P₁⊔P₂ : Subgroup G) => (x:G)) h)
  generated := by
    apply (map_injective (P₁⊔P₂).subtype_injective)
    rw [Subgroup.map_sup,MonoidHom.map_range,MonoidHom.map_range,←MonoidHom.range_eq_map,range_subtype]
    change P₁.subtype.range⊔P₂.subtype.range=P₁⊔P₂
    rw [range_subtype,range_subtype]

theorem ofGeneratedSubgroups_left (P₁ T P₂:Subgroup G) (h₁:T≤P₁) (h₂:T≤P₂)
    (a:P₁) : ((ofGeneratedSubgroups P₁ T P₂ h₁ h₂).left a:G)=a := by rfl

theorem ofGeneratedSubgroups_right (P₁ T P₂:Subgroup G) (h₁:T≤P₁) (h₂:T≤P₂)
    (a:P₂) : ((ofGeneratedSubgroups P₁ T P₂ h₁ h₂).right a:G)=a := by rfl

theorem ofGeneratedSubgroups_left_range (P₁ T P₂:Subgroup G) (h₁:T≤P₁) (h₂:T≤P₂) :
    (ofGeneratedSubgroups P₁ T P₂ h₁ h₂).left.range=P₁.subgroupOf (P₁⊔P₂) := by
  exact inclusion_range le_sup_left

theorem ofGeneratedSubgroups_right_range (P₁ T P₂:Subgroup G) (h₁:T≤P₁) (h₂:T≤P₂) :
    (ofGeneratedSubgroups P₁ T P₂ h₁ h₂).right.range=P₂.subgroupOf (P₁⊔P₂) := by
  exact inclusion_range le_sup_right

end Theory.GroupTheory.RankTwoAmalgam.FaithfulCompletion
