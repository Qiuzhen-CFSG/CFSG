module

public import Theory.GroupTheory.Amalgam.RankTwo
public import Mathlib.GroupTheory.Perm.Fin
public import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# The symmetric-three amalgam over a transposition

The middle subgroup is the actual cyclic subgroup generated by (0 1).
Any two injective embeddings of a group of order two into copies of S₃
produce this amalgam: conjugate the image of the unique nonidentity
element to (0 1) on each side. The resulting vertex maps agree on the
entire middle subgroup. A small checked permutation calculation supplies
only the conjugacy of the three involutions.

Application: Aschbacher–Smith F.6.5(2)(i), printed p.305.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace Theory.GroupTheory.RankTwoAmalgam
abbrev SymmetricThree := Equiv.Perm (Fin 3)
def swapMiddle : Subgroup SymmetricThree := zpowers (Equiv.swap 0 1)
def symmetricThreePair : RankTwoAmalgam SymmetricThree swapMiddle SymmetricThree :=
  ⟨swapMiddle.subtype, swapMiddle.subtype⟩

theorem swapMiddle_card : Nat.card swapMiddle = 2 := by
  change Nat.card (zpowers (Equiv.swap (0 : Fin 3) 1)) = 2
  rw [Nat.card_zpowers]
  apply orderOf_eq_prime
  · decide +kernel
  · decide +kernel

theorem swapMiddle_equiv_cyclicTwo : Nonempty (swapMiddle ≃* Multiplicative (ZMod 2)) :=
  ⟨mulEquivOfPrimeCardEq swapMiddle_card (by simp)⟩

private theorem conjugate_to_swap : ∀ x : SymmetricThree, x ≠ 1 → x ^ 2 = 1 →
    ∃ g : SymmetricThree, g * x * g⁻¹ = Equiv.swap 0 1 := by decide +kernel

 theorem iso_symmetricThreePair {A B C : Type*} [Group A] [Group B] [Group C]
    [Finite B] (α : RankTwoAmalgam A B C)
    (hl : Function.Injective α.left) (hr : Function.Injective α.right)
    (hB : Nat.card B = 2) (eA : A ≃* SymmetricThree) (eC : C ≃* SymmetricThree) :
    Nonempty (Iso α symmetricThreePair) := by
  classical
  obtain ⟨t, ht, hunique⟩ := (Nat.card_eq_two_iff' (1 : B)).mp hB
  have hcases (b : B) : b = 1 ∨ b = t := by
    by_cases hb : b = 1
    · exact Or.inl hb
    · exact Or.inr (hunique b hb)
  have ht2 : t ^ 2 = 1 := by simpa only [hB] using (pow_card_eq_one' (x := t))
  obtain ⟨a, ha⟩ := conjugate_to_swap (eA (α.left t))
    (by intro he; apply ht; apply hl; apply eA.injective; simpa only [map_one] using he)
    (by rw [← map_pow, ← map_pow, ht2, map_one, map_one])
  obtain ⟨c, hc⟩ := conjugate_to_swap (eC (α.right t))
    (by intro he; apply ht; apply hr; apply eC.injective; simpa only [map_one] using he)
    (by rw [← map_pow, ← map_pow, ht2, map_one, map_one])
  let l := eA.trans (MulAut.conj a)
  let r := eC.trans (MulAut.conj c)
  have hlt : l (α.left t) = Equiv.swap 0 1 := ha
  have hrt : r (α.right t) = Equiv.swap 0 1 := hc
  let m : B →* swapMiddle :=
    (l.toMonoidHom.comp α.left).codRestrict swapMiddle (fun b => by
      rcases hcases b with rfl | rfl
      · simp only [MulEquiv.toMonoidHom_eq_coe, map_one]
        exact swapMiddle.one_mem
      · exact hlt ▸ (mem_zpowers (Equiv.swap (0 : Fin 3) 1)))
  have hm : Function.Injective m := by
    intro x y he
    exact hl (l.injective (congrArg Subtype.val he))
  let em := MulEquiv.ofBijective m ((Nat.bijective_iff_injective_and_card m).mpr
    ⟨hm, hB.trans swapMiddle_card.symm⟩)
  refine ⟨{
    left := l
    middle := em
    right := r
    left_commutes := fun _ => rfl
    right_commutes := ?_ }⟩
  intro b
  change r (α.right b) = l (α.left b)
  rcases hcases b with rfl | rfl
  · simp
  · rw [hrt, hlt]
end Theory.GroupTheory.RankTwoAmalgam
