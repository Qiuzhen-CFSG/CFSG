module
public import Theory.GroupTheory.ElementaryThompsonComponentGeneration
public import Theory.GroupTheory.ElementaryThompsonSylowOvergroup
public import Theory.GroupTheory.ElementaryThompsonRelative

/-!
# Thompson containment in a component–Sylow join

A normal C-component in the global elementary Thompson subgroup is
generated by its commutators with the Sylow Thompson subgroup. That
generation puts it in the Thompson subgroup of its own join with the Sylow.
-/
public section
open Subgroup
namespace Stellmacher
variable {G : Type*} [Group G] [Finite G]

/-- Restrict global Thompson containment to the literal component–Sylow join. -/
theorem normal_cComponent_le_maxJ_sup_sylow
    (S : Sylow 2 G) {D : Subgroup G} [D.Normal] (hD : D.IsCComponent)
    (hDJ : D ≤ elementaryAbelianMaxJ (⊤ : Subgroup G)) :
    D ≤ elementaryAbelianMaxJ (D ⊔ (S : Subgroup G)) := by
  let K := D ⊔ (S : Subgroup G)
  have hSK : (S : Subgroup G) ≤ K := le_sup_right
  have hJS : elementaryAbelianMaxJ (S : Subgroup G) ≤ elementaryAbelianMaxJ K := by
    apply elementaryAbelianMaxJ_mono_of_contains_sylow _ K hSK (S.subtype hSK)
    rw [Sylow.coe_subtype, map_subgroupOf_eq_of_le hSK]
  have hDN : D ≤ normalizer (elementaryAbelianMaxJ K : Set G) :=
    (show D ≤ K from le_sup_left).trans
      (K.le_normalizer.trans (normalizer_le_normalizer_elementaryAbelianMaxJ K))
  calc
    D = ⁅D, elementaryAbelianMaxJ (S : Subgroup G)⁆ :=
      (normal_cComponent_commutator_maxJ S hD hDJ).symm
    _ ≤ ⁅D, elementaryAbelianMaxJ K⁆ := commutator_mono le_rfl hJS
    _ ≤ elementaryAbelianMaxJ K := le_normalizer_iff_commutator_le_right.mp hDN

end Stellmacher
