module
public import Theory.GroupTheory.DihedralCentralProductSix.Model

/-!
# A uniform literal dihedral central-product quotient

For `n + 1` factors, quotient the direct product by the `n` central
identifications with factor zero. The relation subgroup is parametrized by
`n` binary coordinates, with their parity in coordinate zero. Thus the
quotient has order `2^(1 + 2*(n+1))`. Only the existing eight-element dihedral
and two-element binary calculations are used, independently of `n`.
At `n = 5` this quotient is definitionally the existing sixfold model.

Source: Aschbacher–Smith 8.2.12, printed p.722 (PDF p.739).
-/

namespace DihedralCentralProductFourSix
open DihedralGroup
open scoped BigOperators

/-- The direct product of `n + 1` copies of D₈. -/
public abbrev D (n : ℕ) := Fin (n + 1) → DihedralGroup 4

@[expose] public def c {n : ℕ} (i : Fin (n + 1)) : D n := Pi.mulSingle i (r 2)
@[expose] public def relation {n : ℕ} (i : Fin n) : D n := c 0 * c i.succ
/-- The subgroup generated by the identifications of the central involutions. -/
@[expose] public def Delta (n : ℕ) : Subgroup (D n) := Subgroup.closure (Set.range relation)

private theorem c_central {n : ℕ} (i : Fin (n + 1)) : c i ∈ Subgroup.center (D n) := by
  rw [Subgroup.mem_center_iff]
  intro x
  funext j
  by_cases h : j = i
  · subst j
    simpa [c] using Subgroup.mem_center_iff.mp DihedralCentralProductSix.r_two_central (x i)
  · simp [c, Pi.mulSingle_eq_of_ne h]

public theorem Delta_central (n : ℕ) : Delta n ≤ Subgroup.center (D n) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  exact (Subgroup.center (D n)).mul_mem (c_central 0) (c_central i.succ)

public instance Delta_normal (n : ℕ) : (Delta n).Normal := by
  constructor
  intro x hx y
  have h := Subgroup.mem_center_iff.mp (Delta_central n hx) y
  simpa [h, mul_assoc] using hx

/-- The literal central product of `n + 1` copies of D₈. -/
public abbrev Model (n : ℕ) := D n ⧸ Delta n

private abbrev Bit := DihedralCentralProductSix.Bit
private noncomputable abbrev bit := DihedralCentralProductSix.bit

private theorem bit_cases (b : Bit) : b = 1 ∨ b = .ofAdd 1 := by
  exact (show ∀ b : Bit, b = 1 ∨ b = .ofAdd 1 by decide) b

private noncomputable def deltaParam (n : ℕ) : (Fin n → Bit) →* D n where
  toFun v := Fin.cases (bit (∏ i, v i)) (fun i => bit (v i))
  map_one' := by ext i; refine Fin.cases ?_ (fun j => ?_) i <;> simp
  map_mul' v w := by
    ext i
    refine Fin.cases ?_ (fun j => ?_) i <;> simp [Finset.prod_mul_distrib]

private theorem deltaParam_injective (n : ℕ) : Function.Injective (deltaParam n) := by
  intro v w h
  funext i
  apply DihedralCentralProductSix.bit_injective
  exact congrFun h i.succ

private theorem deltaParam_single {n : ℕ} (i : Fin n) :
    deltaParam n (Pi.mulSingle i (.ofAdd 1)) = relation i := by
  ext j
  refine Fin.cases ?_ (fun k => ?_) j
  · simp [relation, c, deltaParam, bit]
  · by_cases h : k = i
    · subst k; simp [relation, c, deltaParam, bit]
    · simp [relation, c, deltaParam, bit, h]

private theorem deltaParam_range (n : ℕ) : (deltaParam n).range = Delta n := by
  apply le_antisymm
  · rintro _ ⟨v, rfl⟩
    apply Pi.mulSingle_induction (fun v => deltaParam n v ∈ Delta n) v
    · simp
    · intro v w hv hw
      simpa only [map_mul] using (Delta n).mul_mem hv hw
    · intro i b
      rcases bit_cases b with rfl | rfl
      · simp
      · rw [deltaParam_single]
        exact Subgroup.subset_closure ⟨i, rfl⟩
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨Pi.mulSingle i (.ofAdd 1), deltaParam_single i⟩

public theorem Delta_card (n : ℕ) : Nat.card (Delta n) = 2 ^ n := by
  rw [← deltaParam_range]
  rw [← Nat.card_congr (Equiv.ofBijective (deltaParam n).rangeRestrict
    ⟨fun _ _ h => deltaParam_injective n (congrArg Subtype.val h),
      (deltaParam n).rangeRestrict_surjective⟩)]
  simp [Nat.card_eq_fintype_card, Bit, DihedralCentralProductSix.Bit]

public theorem D_card (n : ℕ) : Nat.card (D n) = 2 ^ (3 * (n + 1)) := by
  simp [D, Nat.card_eq_fintype_card, DihedralGroup.card, pow_mul]

public theorem Model_card (n : ℕ) : Nat.card (Model n) = 2 ^ (1 + 2 * (n + 1)) := by
  have h := Subgroup.card_eq_card_quotient_mul_card_subgroup (Delta n)
  rw [D_card, Delta_card] at h
  apply Nat.mul_right_cancel (m := 2 ^ n) (Nat.pow_pos (by decide))
  rw [← h, ← pow_add]
  congr 1
  omega

/-- The uniform quotient with six factors is the original sixfold quotient,
with the same direct-product coordinates and central identifications. -/
public def sixModelEquiv : Model 5 ≃* DihedralCentralProductSix.Model := MulEquiv.refl _

end DihedralCentralProductFourSix
