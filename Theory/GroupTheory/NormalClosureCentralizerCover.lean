module

public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Normal-closure containment from a quotient centralizer cover

Suppose `V` is normally generated by `Z`, the subgroup `Z` centralizes `S`,
and `V ≤ [V,G]`. If `U` is normal and the image of `S` together with the
centralizer of the image of `V` generates `G/U`, then `V ≤ U`. No finiteness,
Sylow or elementary abelian hypotheses are required.

In the quotient, `Z` centralizes the image of `S`. Its containment in `V`
also makes it commute with the centralizer of the image of `V`. The cover
therefore places the image of `Z` in the center. Pulling that center back
and using the normal-closure universal property shows that the image of
`V` is central. The mapped commutator hypothesis now makes this image
trivial, giving the desired containment in the quotient kernel.

This criterion supplies the selected-coordinate orbit spanning argument on
the original module in Stellmacher (4.6), journal p.26. Its source-facing
caller verifies the quotient cover; no conjugacy of arbitrary direct-product
factors is assumed here. Source: refs/latex/stellmacher-n-group.tex.
-/

namespace Subgroup

/-- A quotient centralizer cover kills a normally generated subgroup that is
contained in its commutator with the ambient group. -/
public theorem normalClosure_le_of_centralizer_cover
    {G : Type*} [Group G] (Z V U S : Subgroup G) [U.Normal]
    (hZV : Z ≤ V) (hV : V = normalClosure (Z : Set G))
    (hZS : Z ≤ centralizer (S : Set G))
    (hcomm : V ≤ ⁅V, (⊤ : Subgroup G)⁆)
    (hcover : centralizer (V.map (QuotientGroup.mk' U) : Set (G ⧸ U)) ⊔
      S.map (QuotientGroup.mk' U) = ⊤) : V ≤ U := by
  let π := QuotientGroup.mk' U
  have hZSbar : Z.map π ≤ centralizer (S.map π : Set (G ⧸ U)) :=
    (map_mono hZS).trans (map_centralizer_le_centralizer_image (S : Set G) π)
  have hZcentral : Z.map π ≤ center (G ⧸ U) := by
    apply centralizer_eq_top_iff_subset.mp
    apply top_unique
    rw [← hcover]
    exact sup_le (centralizer_le (map_mono hZV)) (le_centralizer_iff.mp hZSbar)
  have hVcentral : V.map π ≤ center (G ⧸ U) := by
    apply map_le_iff_le_comap.mpr
    rw [hV]
    exact normalClosure_le_normal (map_le_iff_le_comap.mp hZcentral)
  have hqcomm : (⁅V, (⊤ : Subgroup G)⁆).map π = ⊥ := by
    rw [map_commutator, map_top_of_surjective π (QuotientGroup.mk'_surjective U)]
    exact commutator_top_right_eq_bot_iff_le_center.mpr hVcentral
  have hkill : V.map π = ⊥ := bot_unique ((map_mono hcomm).trans_eq hqcomm)
  simpa only [π, QuotientGroup.ker_mk'] using (map_eq_bot_iff V).mp hkill

end Subgroup
