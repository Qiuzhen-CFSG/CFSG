module

public import Mathlib.GroupTheory.Torsion

/-!
# Prime-power closure transfer through a kernel

Let `Kfix ≤ K₁` be subgroups of an arbitrary group and let `φ : K₁ → H`
have kernel `Kfix`.  If `H` has no nontrivial elements killed by a power of a
prime `p`, then every `p`-power-order element of `K₁` already belongs to
`Kfix`.  Consequently the subgroups generated by the `p`-elements of `K₁`
and `Kfix` agree.

This packages the finite-group step used in GLS3, Theorem 2.1.8.  The source
expresses it through two successive quotients of order prime to `p`; a single
homomorphism with prime-to-`p` target gives the same transfer directly and does
not require either ambient group to be finite.
-/

namespace Subgroup

/-- The subgroup generated by the `p`-power-order elements of a subgroup
agrees with that generated inside the kernel of a homomorphism whenever the
target has no nontrivial `p`-power torsion. -/
public theorem closure_primePowerOrder_eq_of_ker_of_pow_eq_one
    {G H : Type*} [Group G] [Group H]
    {p : ℕ} [Fact p.Prime]
    (Kfix K₁ : Subgroup G) (hfix : Kfix ≤ K₁)
    (φ : K₁ →* H)
    (hker : φ.ker = Kfix.subgroupOf K₁)
    (hpowTarget : ∀ (z : H) (a : ℕ), z ^ p ^ a = 1 → z = 1) :
    closure {g : G | g ∈ K₁ ∧ ∃ a : ℕ, orderOf g = p ^ a} =
      closure {g : G | g ∈ Kfix ∧ ∃ a : ℕ, orderOf g = p ^ a} := by
  apply le_antisymm
  · rw [closure_le]
    intro g hg
    apply subset_closure
    refine ⟨?_, hg.2⟩
    let g₁ : K₁ := ⟨g, hg.1⟩
    obtain ⟨a, ha⟩ := hg.2
    have hgpow : g ^ p ^ a = 1 := by
      rw [← ha]
      exact pow_orderOf_eq_one g
    have hφpow : φ g₁ ^ p ^ a = 1 := by
      rw [← map_pow, ← map_one φ]
      apply congrArg φ
      apply Subtype.ext
      exact hgpow
    have hφone : φ g₁ = 1 := hpowTarget (φ g₁) a hφpow
    have hgker : g₁ ∈ φ.ker := MonoidHom.mem_ker.mpr hφone
    rw [hker] at hgker
    exact hgker
  · apply closure_mono
    intro g hg
    exact ⟨hfix hg.1, hg.2⟩

/-- Finite-target form of the prime-power closure transfer: it suffices that
the target cardinality be coprime to `p`. -/
public theorem closure_primePowerOrder_eq_of_ker_of_card_coprime
    {G H : Type*} [Group G] [Group H] [Finite H]
    {p : ℕ} [Fact p.Prime]
    (Kfix K₁ : Subgroup G) (hfix : Kfix ≤ K₁)
    (φ : K₁ →* H)
    (hker : φ.ker = Kfix.subgroupOf K₁)
    (hcard : Nat.Coprime (Nat.card H) p) :
    closure {g : G | g ∈ K₁ ∧ ∃ a : ℕ, orderOf g = p ^ a} =
      closure {g : G | g ∈ Kfix ∧ ∃ a : ℕ, orderOf g = p ^ a} := by
  apply closure_primePowerOrder_eq_of_ker_of_pow_eq_one
    Kfix K₁ hfix φ hker
  intro z a hz
  apply orderOf_eq_one_iff.mp
  exact Nat.eq_one_of_dvd_coprimes (hcard.symm.pow_left a)
    (orderOf_dvd_of_pow_eq_one hz) (_root_.orderOf_dvd_natCard z)

end Subgroup
