module

public import Theory.GroupTheory.CyclicNormalOddQuotient

/-!+# Odd subgroups of a cyclic group extended by a commuting involution

In an abelian group generated by a cyclic subgroup and an involution,
every square belongs to the cyclic subgroup. Squaring is bijective on an
odd-prime group, so every odd-prime subgroup lies in that cyclic subgroup.
This is the field–graph quotient calculation in GLS3, Theorem 2.5.12(d,e),
used by the outer-group inspection on printed p.510 of Aschbacher–Smith.
-/

public section
namespace Theory.GroupTheory
open Subgroup

/-- Odd-prime subgroups of a cyclic subgroup extended by a commuting
involution are cyclic. Neither a direct-product decomposition nor uniqueness
of the cyclic and involution factors is needed. -/
theorem isCyclic_pSubgroup_of_cyclic_sup_involution
    {G : Type*} [Group G] [IsMulCommutative G]
    (C : Subgroup G) [IsCyclic C] (t : G) (ht : t ^ 2 = 1)
    (hgen : C ⊔ zpowers t = ⊤) (p : ℕ) (ho : Odd p)
    (U : Subgroup G) (hU : IsPGroup p U) : IsCyclic U := by
  let : CommGroup G := IsMulCommutative.instCommGroup
  have hsquare (x : G) : x ^ 2 ∈ C := by
    obtain ⟨c, hc, d, hd, rfl⟩ := Subgroup.mem_sup.mp
      (show x ∈ C ⊔ zpowers t by rw [hgen]; trivial)
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hd
    have hk : (t ^ k) ^ 2 = 1 := by
      rw [← zpow_natCast, ← zpow_mul, mul_comm k, zpow_mul, zpow_natCast, ht, one_zpow]
    simpa only [mul_pow, hk, mul_one] using C.pow_mem hc 2
  have hUC : U ≤ C := by
    intro x hx
    obtain ⟨y, hy⟩ := (hU.powEquiv ho.coprime_two_right).surjective ⟨x, hx⟩
    have heq : (y.val : G) ^ 2 = x := congrArg Subtype.val hy
    rw [← heq]
    exact hsquare y.val
  exact isCyclic_of_injective (Subgroup.inclusion hUC) (Subgroup.inclusion_injective hUC)

end Theory.GroupTheory
