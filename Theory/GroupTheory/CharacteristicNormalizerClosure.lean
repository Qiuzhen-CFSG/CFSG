module

public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# The subgroup generated by characteristic normalizers

For a subgroup R of G, form C(G,R) by joining the normalizers in G of all
nontrivial characteristic subgroups of R. Its containment in a proper
subgroup prevents every such characteristic subgroup from being normal in G.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
combined manuscript (1 March 2004), C.1.3–C.1.6, p. 122.
-/

@[expose] public section

namespace Subgroup

variable {G : Type*} [Group G]

/-- The subgroup C(G,R) generated by normalizers of nontrivial characteristic subgroups. -/
def characteristicNormalizerClosure (R : Subgroup G) : Subgroup G :=
  ⨆ (C : Subgroup R) (_ : C.Characteristic) (_ : C ≠ ⊥),
    normalizer (C.map R.subtype : Set G)

/-- Each defining normalizer belongs to C(G,R). -/
theorem normalizer_le_characteristicNormalizerClosure (R : Subgroup G)
    (C : Subgroup R) [hC : C.Characteristic] (hne : C ≠ ⊥) :
    normalizer (C.map R.subtype : Set G) ≤ characteristicNormalizerClosure R :=
  le_iSup_of_le C (le_iSup_of_le hC (le_iSup_of_le hne le_rfl))

/-- A containment criterion for C(G,R). -/
theorem characteristicNormalizerClosure_le_iff (R M : Subgroup G) :
    characteristicNormalizerClosure R ≤ M ↔
      ∀ C : Subgroup R, C.Characteristic → C ≠ ⊥ →
        normalizer (C.map R.subtype : Set G) ≤ M := by
  simp only [characteristicNormalizerClosure, iSup_le_iff]

/-- The normalizer of a nontrivial subgroup is contained in C(G,R). -/
theorem normalizer_le_characteristicNormalizerClosure_self (R : Subgroup G)
    (hne : R ≠ ⊥) : normalizer (R : Set G) ≤ characteristicNormalizerClosure R := by
  have htop : (⊤ : Subgroup R) ≠ ⊥ := by
    intro h
    have hh := congrArg (fun C : Subgroup R => C.map R.subtype) h
    exact hne (by simpa only [← MonoidHom.range_eq_map, subtype_range, map_bot] using hh)
  simpa only [← MonoidHom.range_eq_map, subtype_range] using
    normalizer_le_characteristicNormalizerClosure R ⊤ htop

/-- If C(G,R) lies in a proper subgroup, no nontrivial characteristic subgroup
of R is normal in G. -/
theorem not_normal_of_characteristicNormalizerClosure_le
    (R M : Subgroup G) (hM : M < ⊤)
    (hRM : characteristicNormalizerClosure R ≤ M)
    (C : Subgroup R) [C.Characteristic] (hne : C ≠ ⊥) :
    ¬ (C.map R.subtype).Normal := by
  intro hnormal
  have h := (normalizer_le_characteristicNormalizerClosure R C hne).trans hRM
  rw [normalizer_eq_top_iff.mpr hnormal] at h
  exact hM.ne (top_le_iff.mp h)

end Subgroup
