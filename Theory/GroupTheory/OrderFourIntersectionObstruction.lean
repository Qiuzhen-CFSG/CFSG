module
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Algebra.Group.Subgroup.Finite
public import Mathlib.GroupTheory.SpecificGroups.Dihedral
/-!
# Two nontrivial intersections in a subgroup of order four

An order-four subgroup meeting two disjoint subgroups nontrivially is generated
by those intersections. Multiplication embeds the product of the intersections
in their join; each intersection has at least two elements, so the join already
has all four elements.

Consequently, if the two disjoint subgroups lie in an abelian subgroup, the
order-four subgroup lies there too. Its join with either of the original
subgroups cannot be dihedral of order eight.

This is the final elementary obstruction in Aschbacher--Smith, *The
Classification of Quasithin Groups*, combined manuscript, 1 March 2004,
proof of Theorem 15.4.24, printed p. 1165. There the disjoint subgroups are
`O₂(X₁)` and `O₂(X₂)`, the order-four subgroup is `O₂(Y₁)`, and the abelian
containing subgroup is `O₂(X)`. The results here do not require the surrounding
classification hypotheses.
-/

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]
/-- Two disjoint nontrivial subgroups of a group of order four generate it. -/
public theorem sup_eq_of_disjoint_of_card_four {A B V : Subgroup G}
    (hA : A ≤ V) (hB : B ≤ V) (hdis : Disjoint A B)
    (hneA : A ≠ ⊥) (hneB : B ≠ ⊥) (hV : Nat.card V = 4) : A ⊔ B = V := by
  let f : A × B → ↥(A ⊔ B) := fun p =>
    ⟨(p.1 : G) * (p.2 : G), mul_mem_sup p.1.property p.2.property⟩
  have hf : Function.Injective f := fun _ _ h =>
    mul_injective_of_disjoint hdis (congrArg Subtype.val h)
  have hcard := Nat.card_le_card_of_injective f hf
  rw [Nat.card_prod] at hcard
  have htwoA : 2 ≤ Nat.card A := (A.one_lt_card_iff_ne_bot.mpr hneA)
  have htwoB : 2 ≤ Nat.card B := (B.one_lt_card_iff_ne_bot.mpr hneB)
  apply eq_of_le_of_card_ge (sup_le hA hB)
  rw [hV]
  exact (Nat.mul_le_mul htwoA htwoB).trans hcard

/-- An order-four subgroup is generated by its nontrivial intersections with
 two disjoint subgroups. -/
public theorem inf_sup_inf_eq_of_card_four {A A' B : Subgroup G}
    (hdis : Disjoint A A') (hAB : A ⊓ B ≠ ⊥) (hA'B : A' ⊓ B ≠ ⊥)
    (hB : Nat.card B = 4) : (A ⊓ B) ⊔ (A' ⊓ B) = B :=
  sup_eq_of_disjoint_of_card_four inf_le_right inf_le_right
    (hdis.mono inf_le_left inf_le_left) hAB hA'B hB

/-- If two disjoint subgroups of `E` meet an order-four subgroup nontrivially,
that order-four subgroup lies in `E`. -/
public theorem order_four_le_of_two_disjoint_intersections {A A' B E : Subgroup G}
    (hA : A ≤ E) (hA' : A' ≤ E) (hdis : Disjoint A A')
    (hAB : A ⊓ B ≠ ⊥) (hA'B : A' ⊓ B ≠ ⊥) (hB : Nat.card B = 4) : B ≤ E := by
  rw [← inf_sup_inf_eq_of_card_four hdis hAB hA'B hB]
  exact sup_le (inf_le_left.trans hA) (inf_le_left.trans hA')

/-- The two-intersection configuration inside an abelian subgroup is
incompatible with a dihedral join of order eight. -/
public theorem no_dihedral_join_of_order_four_intersections {A A' B E : Subgroup G}
    [IsMulCommutative E] (hA : A ≤ E) (hA' : A' ≤ E) (hdis : Disjoint A A')
    (hAB : A ⊓ B ≠ ⊥) (hA'B : A' ⊓ B ≠ ⊥) (hB : Nat.card B = 4)
    (e : ↥(A ⊔ B) ≃* DihedralGroup 4) : False := by
  have hBE := order_four_le_of_two_disjoint_intersections hA hA' hdis hAB hA'B hB
  have hsup : A ⊔ B ≤ E := sup_le hA hBE
  have hcomm : IsMulCommutative ↥(A ⊔ B) :=
    le_centralizer_iff_isMulCommutative.mp
      (hsup.trans (E.le_centralizer.trans (centralizer_le hsup)))
  apply DihedralGroup.not_commutative (by decide : 4 ≠ 1) (by decide : 4 ≠ 2)
  apply IsMulCommutative.of_comm
  intro x y
  apply e.symm.injective
  simp only [map_mul]
  exact (isMulCommutative_iff.mp hcomm) _ _
end Subgroup
