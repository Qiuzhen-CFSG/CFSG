module

public import Theory.GroupTheory.NormalizingInvolutionCard
public import Theory.GroupTheory.NormalizedSupCard
public import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# Products of involutions in a cubic centralizer

Let u have order three, and let x,w be involutions centralizing u. If the
order of C(u) divides 6m, then (xw)^m = 1. Indeed, with v = xw and n its
order, the dihedral subgroup generated by v,x has order 2n. The subgroups
⟨u⟩ and ⟨v⟩ commute and intersect trivially: x fixes the first and inverts
the second, so their intersection has exponent dividing both two and three.
Their join therefore has order 3n. Thus n divides both 3m and 2m, hence m.

For m = 5 this supplies the structure identity in Gorenstein, *Finite
Groups*, §16.6, equation (6.2), p.483, once the cubic centralizer bound and
the inverting involution have been independently established. No recognition
of a group of order thirty or representation is used.
-/

open Subgroup

variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem conjugates_product (x w : G) (hx : orderOf x = 2)
    (hw : orderOf w = 2) : x * (x * w) * x⁻¹ = (x * w)⁻¹ := by
  have hx2 : x * x = 1 := by simpa only [hx, pow_two] using pow_orderOf_eq_one x
  have hxi : x⁻¹ = x := inv_eq_of_mul_eq_one_left hx2
  have hw2 : w * w = 1 := by simpa only [hw, pow_two] using pow_orderOf_eq_one w
  have hwi : w⁻¹ = w := inv_eq_of_mul_eq_one_left hw2
  simp only [mul_inv_rev, hxi, hwi]
  rw [← mul_assoc, hx2, one_mul]

private theorem involution_not_mem_product (x w : G) (hx : orderOf x = 2)
    (hw : orderOf w = 2) : x ∉ zpowers (x * w) := by
  classical
  intro hxm
  have hc : Commute x (x * w) := by
    obtain ⟨k, hk⟩ := mem_zpowers_iff.mp hxm
    simpa only [hk] using (Commute.refl (x * w)).zpow_left k
  have hi := conjugates_product x w hx hw
  have he : x * w = (x * w)⁻¹ := by
    rw [mul_inv_eq_iff_eq_mul.mpr hc.eq] at hi
    exact hi
  have hp : (x * w) ^ 2 = 1 := by
    rw [pow_two]
    calc
      _ = (x * w)⁻¹ * (x * w) := congrArg (fun a => a * (x * w)) he
      _ = 1 := inv_mul_cancel _
  have hd : orderOf (x * w) ∣ 2 := orderOf_dvd_of_pow_eq_one hp
  have hle : orderOf (x * w) ≤ 2 := Nat.le_of_dvd (by decide) hd
  rw [mem_zpowers_iff_mem_range_orderOf] at hxm
  obtain ⟨k, hk, hkx⟩ := Finset.mem_image.mp hxm
  have hklt := Finset.mem_range.mp hk
  have hk2 : k < 2 := lt_of_lt_of_le hklt hle
  interval_cases k
  · have he1 : x = 1 := by simpa using hkx.symm
    simp [he1] at hx
  · have he1 : w = 1 := by
      have hh : x * w = x := by simpa using hkx
      exact mul_left_cancel (hh.trans (mul_one x).symm)
    simp [he1] at hw

/-- Two involutions centralizing an element of order three have product
exponent dividing one sixth of any multiple of that centralizer's order. -/
public theorem involution_product_pow_eq_one_of_cubic_centralizer_card_dvd (u x w : G) (m : ℕ)
    (hu : orderOf u = 3) (hx : orderOf x = 2) (hw : orderOf w = 2)
    (hxu : Commute x u) (hwu : Commute w u)
    (hcard : Nat.card (centralizer ({u} : Set G)) ∣ 6 * m) :
    (x * w) ^ m = 1 := by
  let v := x * w
  let U := zpowers u
  let V := zpowers v
  let C := centralizer ({u} : Set G)
  have hxC : x ∈ C := mem_centralizer_singleton_iff.mpr hxu.eq
  have hwC : w ∈ C := mem_centralizer_singleton_iff.mpr hwu.eq
  have hUC : U ≤ C := zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl)
  have hVC : V ≤ C := zpowers_le.mpr (C.mul_mem hxC hwC)
  have hxV : x ∈ normalizer (V : Set G) := by
    rw [mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
    change zpowers (x * v * x⁻¹) = zpowers v
    rw [conjugates_product x w hx hw, zpowers_inv]
  have htwo : 2 * orderOf v ∣ Nat.card C := by
    have hd := card_dvd_of_le (sup_le hVC (zpowers_le.mpr hxC))
    rw [card_sup_zpowers_of_normalizing_involution V x
      (by simpa [hx] using pow_orderOf_eq_one x)
      (involution_not_mem_product x w hx hw) hxV, Nat.card_zpowers] at hd
    exact hd
  have hVU : V ≤ normalizer (U : Set G) := by
    apply zpowers_le.mpr
    apply centralizer_le_normalizer
    rw [mem_centralizer_iff]
    intro a ha
    obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp ha
    exact ((hxu.mul_left hwu).symm.zpow_left k).eq
  have hdisj : Disjoint U V := by
    apply disjoint_def.mpr
    intro a haU haV
    obtain ⟨i, hi⟩ := mem_zpowers_iff.mp haU
    obtain ⟨j, hj⟩ := mem_zpowers_iff.mp haV
    have hcomm : Commute x a := hi ▸ hxu.zpow_right i
    have hinv : x * a * x⁻¹ = a⁻¹ := by
      rw [← hj]
      change (MulAut.conj x) (v ^ j) = (v ^ j)⁻¹
      rw [map_zpow]
      change (x * v * x⁻¹) ^ j = (v ^ j)⁻¹
      rw [conjugates_product x w hx hw, inv_zpow]
    have ha2 : a ^ 2 = 1 := by
      have he : a = a⁻¹ := (mul_inv_eq_iff_eq_mul.mpr hcomm.eq).symm.trans hinv
      rw [pow_two]
      calc
        _ = a⁻¹ * a := congrArg (fun b => b * a) he
        _ = 1 := inv_mul_cancel _
    have ha3 : orderOf a ∣ 3 := by
      have hd := U.orderOf_dvd_natCard haU
      simpa [U, Nat.card_zpowers, hu] using hd
    exact orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes (by decide : Nat.Coprime 2 3)
      (orderOf_dvd_of_pow_eq_one ha2) ha3)
  have hthree : 3 * orderOf v ∣ Nat.card C := by
    have hd := card_dvd_of_le (sup_le hUC hVC)
    rw [card_sup_eq_mul_of_normalizes_of_disjoint U V hVU hdisj,
      Nat.card_zpowers, hu, Nat.card_zpowers] at hd
    exact hd
  have h3m : orderOf v ∣ 3 * m :=
    (Nat.mul_dvd_mul_iff_left (by decide : 0 < 2)).mp
      (show 2 * orderOf v ∣ 2 * (3 * m) by simpa only [← Nat.mul_assoc] using htwo.trans hcard)
  have h2m : orderOf v ∣ 2 * m :=
    (Nat.mul_dvd_mul_iff_left (by decide : 0 < 3)).mp
      (show 3 * orderOf v ∣ 3 * (2 * m) by simpa only [← Nat.mul_assoc] using hthree.trans hcard)
  apply orderOf_dvd_iff_pow_eq_one.mp
  simpa [Nat.gcd_mul_right] using Nat.dvd_gcd h3m h2m
