module
public import Theory.GroupTheory.PCoreImage
public import Theory.GroupTheory.PResidual.NormalizedGenerators
public import Theory.GroupTheory.PResidual.FiniteImage
public import Theory.GroupTheory.Commutator.NormalizesSupplement
public import Theory.PPrimeCore

/-!
# Three-group residual quotients of a normalized join

Suppose a finite group is generated by R, A and a two-subgroup T, where
R is normal, T normalizes A, and both R/O₂(R) and A/O₂(A) are three-groups.
If [A,R] lies in O₂(R), the join O₂(A)O₂(R) is a normal two-subgroup:
R normalizes it by the commutator bound, while A and T preserve each core.
After removing O₂(G), the two generating images are three-groups with the
R-image normal. Their join contains O²(G/O₂(G)), so that residual is a
three-group. The same conclusion passes to the quotient by O₃′(G).

Source application: the final quotient calculation in Aschbacher--Smith,
The Classification of Quasithin Groups, 13.2.14, printed p.883.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- Killing a subgroup's two-core preserves its three-group quotient in the image. -/
theorem isThreeGroup_map_of_twoCore_quotient
    {D : Type*} [Group D] (A : Subgroup G) (f : G →* D)
    (hA : IsPGroup 3 (A ⧸ pCore 2 A)) (hk : A.pCoreIn 2 ≤ f.ker) :
    IsPGroup 3 (A.map f) := by
  let g := f.subgroupMap A
  have hg : pCore 2 A ≤ g.ker := by
    intro a ha
    apply Subtype.ext
    exact hk (mem_map_of_mem A.subtype ha)
  let q := QuotientGroup.lift (pCore 2 A) g hg
  apply hA.of_surjective q
  intro y
  obtain ⟨a,ha⟩ := f.subgroupMap_surjective A y
  exact ⟨QuotientGroup.mk a,ha⟩

/-- A normal residual and a Sylow-normalized Borel with cubic core quotients
have three-group residual modulo O₂ when their commutator lies in O₂ of
the normal factor. -/
theorem twoResidual_mod_twoCore_isThree_of_normalized_join
    (A R T : Subgroup G) [R.Normal]
    (hA : IsPGroup 3 (A ⧸ pCore 2 A))
    (hR : IsPGroup 3 (R ⧸ pCore 2 R))
    (hT : IsPGroup 2 T) (hTA : T ≤ normalizer (A : Set G))
    (hgen : (R ⊔ A) ⊔ T = ⊤)
    (hc : ⁅A,R⁆ ≤ R.pCoreIn 2) :
    IsPGroup 3 (pResidual 2 (G ⧸ pCore 2 G)) := by
  let Q := A.pCoreIn 2 ⊔ R.pCoreIn 2
  let : (R.pCoreIn 2).Normal := inferInstanceAs ((pCore 2 R).map R.subtype).Normal
  have hQtwo : IsPGroup 2 Q :=
    (isPGroup_pCoreIn 2 A).to_sup_of_normal_right (isPGroup_pCoreIn 2 R)
  have hRQ : R ≤ normalizer (Q : Set G) :=
    le_normalizer_sup_of_commutator_le A R (A.pCoreIn 2) (R.pCoreIn 2)
      (pCoreIn_le 2 A) hc
  have hAQ : A ≤ normalizer (Q : Set G) :=
    (le_inf (A.le_normalizer.trans (normalizer_le_normalizer_characteristic_image A
      (pCore 2 A))) le_normalizer_of_normal).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hTQ : T ≤ normalizer (Q : Set G) :=
    (le_inf (hTA.trans (normalizer_le_normalizer_characteristic_image A
      (pCore 2 A))) le_normalizer_of_normal).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _)
  let : Q.Normal := normalizer_eq_top_iff.mp (top_unique (hgen ▸ sup_le (sup_le hRQ hAQ) hTQ))
  have hQcore : Q ≤ pCore 2 G := le_sSup ⟨inferInstance,hQtwo⟩
  let f := QuotientGroup.mk' (pCore 2 G)
  have hAc : A.pCoreIn 2 ≤ f.ker := by
    rw [QuotientGroup.ker_mk']
    exact le_sup_left.trans hQcore
  have hRc : R.pCoreIn 2 ≤ f.ker := by
    rw [QuotientGroup.ker_mk']
    exact le_sup_right.trans hQcore
  have hAp := isThreeGroup_map_of_twoCore_quotient A f hA hAc
  have hRp := isThreeGroup_map_of_twoCore_quotient R f hR hRc
  let K := R ⊔ A
  let : K.Normal := normalizer_eq_top_iff.mp (top_unique (by
    rw [←hgen]
    exact sup_le K.le_normalizer
      ((le_inf le_normalizer_of_normal hTA).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _))))
  have hr : pResidual 2 G ≤ K := sInf_le
    ⟨inferInstance,isPGroup_quotient_of_sup_eq_top K T hT hgen⟩
  have hp : IsPGroup 3 (K.map f) := by
    rw [show K = R ⊔ A from rfl,Subgroup.map_sup]
    let : (R.map f).Normal := Normal.map inferInstance f (QuotientGroup.mk'_surjective _)
    exact hRp.to_sup_of_normal_left hAp
  rw [←map_pResidual_of_surjective 2 f (QuotientGroup.mk'_surjective _)]
  exact hp.to_le (map_mono hr)

/-- The source quotient by O₃′ is a further quotient of the two-core quotient. -/
theorem twoResidual_mod_primeToThreeCore_isThree
    (h : IsPGroup 3 (pResidual 2 (G ⧸ pCore 2 G))) :
    IsPGroup 3 (pResidual 2 (G ⧸ pPrimeCore 3 G)) := by
  have hle : pCore 2 G ≤ pPrimeCore 3 G := by
    apply le_sSup
    refine ⟨inferInstance,?_⟩
    obtain ⟨n,hn⟩ := (pCore_isPGroup (p := 2) (G := G)).exists_card_eq
    rw [hn]
    exact (by decide : Nat.Coprime 3 2).pow_right _
  let f := QuotientGroup.map (pCore 2 G) (pPrimeCore 3 G) (MonoidHom.id G) hle
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨g,rfl⟩ := QuotientGroup.mk'_surjective (pPrimeCore 3 G) y
    exact ⟨QuotientGroup.mk g,rfl⟩
  have hm := h.map f
  rwa [map_pResidual_of_surjective 2 f hf] at hm
end Subgroup
