module

public import Theory.GroupTheory.InvolutionGeneratedCommutator
public import Theory.ElementaryAbelian.Basic

/-!
# Elementary subgroups and involution generation

An elementary abelian two-subgroup intersected with `Q` lies in the subgroup
generated by the involutions of `Q`. Injective homomorphisms preserve this
generated subgroup, because square-one elements lift through an injection.
These facts transport local commutator bounds to ambient conjugate layers.

The application in Aschbacher--Smith, *The Classification of Quasithin Groups*,
combined manuscript (1 March 2004), printed p.1120, uses the two elementary
normal-closure layers and Lemma 15.2.28.
-/

public section

namespace Subgroup

variable {G K : Type*} [Group G] [Group K]

/-- An injection preserves the subgroup generated by square-one elements. -/
theorem map_involutionGenerated_of_injective (Q : Subgroup G)
    (f : G →* K) (hf : Function.Injective f) :
    (involutionGenerated Q).map f = involutionGenerated (Q.map f) := by
  rw [involutionGenerated, MonoidHom.map_closure, involutionGenerated]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨hy, hy2⟩, rfl⟩
    exact ⟨mem_map_of_mem f hy, by simpa only [map_pow, map_one] using congrArg f hy2⟩
  · rintro ⟨⟨y, hy, rfl⟩, hy2⟩
    refine ⟨y, ⟨hy, hf ?_⟩, rfl⟩
    simpa only [map_pow, map_one] using hy2

/-- An elementary two-subgroup meets `Q` inside its involution-generated subgroup. -/
theorem elementary_inf_le_involutionGenerated (A Q : Subgroup G)
    [IsElementaryAbelian 2 A] : A ⊓ Q ≤ involutionGenerated Q := by
  intro x hx
  exact subset_closure ⟨hx.2, elemPow_eq_one_of_isElementaryAbelian x hx.1⟩

end Subgroup
