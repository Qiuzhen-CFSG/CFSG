module
public import Theory.Frattini.CoprimeAction
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Commutator idempotence for coprime-generated actions

If `R` is generated by elements whose orders are coprime to the order of a
subgroup `M` normalized by `R`, then `[[M,R],R] = [M,R]`. In particular, for
a finite p-subgroup `M` normalized by `P`, this applies to the subgroup generated
by the prime-to-p elements of `P`, viewed in the ambient group. There is no
containment requirement between `M` and `P`.

For each generator, the cyclic coprime-action theorem puts its commutators
inside the double commutator. The latter is normalized by `R`, so the
commutator product and inverse identities extend this containment to the
whole generating closure. The other inclusion follows from normalization.

This is the standard residual commutator argument needed in Stellmacher's
N-group paper (1997), (9.1), relation (3). Identification of the generating
closure with the source-specific residual is left to the campaign adapter.
-/

open Subgroup
open scoped commutatorElement

private theorem coprime_le_double {G : Type*} [Group G]
    (M A : Subgroup G) (hn : A ≤ normalizer M)
    (hc : Nat.Coprime (Nat.card A) (Nat.card M)) :
    ⁅M,A⁆ ≤ ⁅⁅M,A⁆,A⁆ := by
  let _ : Subgroup.Normalizes A M := ⟨hn⟩
  let _ : MulDistribMulAction A M :=
    Subgroup.conjMulDistribMulActionOfLeNormalizer A M hn
  have hm := commutatorAction_subgroup_conj_map_eq_commutator M A hn
  calc
    ⁅M,A⁆ = (commutatorAction₂ (A := A) (G := M)).map M.subtype := by
      rw [commutatorAction₂_eq_commutatorAction_of_coprime hc, hm]
    _ ≤ ⁅⁅M,A⁆,A⁆ := ?_
  rw [commutatorAction₂, commutatorSubgroup, MonoidHom.map_closure, closure_le]
  rintro _ ⟨v, ⟨a, m, hm, rfl⟩, rfl⟩
  have hmem : (m : G) ∈ ⁅M,A⁆ := by
    rw [← commutatorAction_subgroup_conj_map_eq_commutator M A hn]
    exact mem_map_of_mem _ hm
  have h := commutator_mem_commutator (inv_mem hmem) a.property
  simpa [commutatorElement_def,
    Subgroup.conjMulDistribMulActionOfLeNormalizer_smul_coe, mul_assoc] using h

/-- An action generated by elements of coprime order is idempotent on its
commutator subgroup. -/
public theorem commutator_closure_coprime_idempotent
    {G : Type*} [Group G] (M : Subgroup G) (S : Set G)
    (hn : closure S ≤ normalizer M)
    (hc : ∀ a ∈ S, Nat.Coprime (orderOf a) (Nat.card M)) :
    ⁅⁅M,closure S⁆,closure S⁆ = ⁅M,closure S⁆ := by
  let R := closure S
  let U := ⁅⁅M,R⁆,R⁆
  have hUn : R ≤ normalizer U := normalizer_commutator_ge_right _ _
  apply le_antisymm
  · exact le_normalizer_iff_commutator_le_left.mp (normalizer_commutator_ge_right M R)
  rw [commutator_le]
  intro m hm a ha
  have hall : ∀ a ∈ R, ∀ m ∈ M, ⁅m,a⁆ ∈ U := by
    intro a ha
    induction ha using closure_induction with
    | mem a ha =>
      intro m hm
      have hAR : zpowers a ≤ R := zpowers_le.mpr (subset_closure ha)
      have hcop : Nat.Coprime (Nat.card (zpowers a)) (Nat.card M) := by
        simpa only [Nat.card_zpowers] using hc a ha
      exact (commutator_mono (commutator_mono le_rfl hAR) hAR)
        (coprime_le_double M (zpowers a) (hAR.trans hn) hcop
          (commutator_mem_commutator hm (mem_zpowers a)))
    | one => intro m hm; simp [U]
    | mul a b ha hb hia hib =>
      intro m hm
      rw [commutatorElement_mul_right_eq_mul_conj]
      rw [mul_assoc ⁅m,a⁆ a, mul_assoc ⁅m,a⁆ _]
      exact U.mul_mem (hia m hm)
        ((mem_normalizer_iff.mp (hUn ha) _).mp (hib m hm))
    | inv a ha hi =>
      intro m hm
      rw [commutatorElement_inv_right, ← commutatorElement_inv]
      simpa only [inv_inv] using
        (mem_normalizer_iff.mp (hUn (R.inv_mem ha)) _).mp (U.inv_mem (hi m hm))
  exact hall a ha m hm

/-- The prime-to-p generators of a normalizing subgroup act idempotently on
their commutator with a finite p-subgroup. -/
public theorem commutator_coprime_order_generators_idempotent
    {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]
    (M P : Subgroup G) (hM : IsPGroup p M) (hPM : P ≤ normalizer M) :
    let R := (closure {a : P | Nat.Coprime p (orderOf a)}).map P.subtype
    ⁅⁅M,R⁆,R⁆ = ⁅M,R⁆ := by
  classical
  dsimp only
  rw [MonoidHom.map_closure]
  apply commutator_closure_coprime_idempotent
  · rw [closure_le]
    rintro _ ⟨a, ha, rfl⟩
    exact hPM a.property
  · rintro _ ⟨a, ha, rfl⟩
    obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := p)).mp hM
    rw [hn]
    simpa only [Subgroup.coe_subtype, Subgroup.orderOf_coe] using ha.symm.pow_right n
