def representative (k : Fin 32) : FactorSet twistedAction :=
  if classAt k then twistedFactorSet else FactorSet.trivial twistedAction

theorem cochainAt_zero : ∀ k, cochainAt k 0 = 1 := by decide +kernel

theorem correction_table : ∀ (k : Fin 32) (a : Fin 2) (t : Fin 24),
    table (family (parametersAt k)) (gen a) t * cochainAt k (mul (gen a) t) =
      cochainAt k (gen a) * twistedAction (perm (gen a)) (cochainAt k t) *
        (representative k).toFun (perm (gen a)) (perm t) := by
  decide +kernel

