module

public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.NonsplitAlternatives.ExtraExtensions.ThirdRealization.Certificates
public import Mathlib.Tactic.FinCases

/-!
# The exact third permutation extension

A checked transition table covers the subgroup generated by the published
permutations. Its action on four blocks gives a surjection to S4, with kernel
exactly the displayed binary inclusion. Conjugation is checked on generators
and extended by group induction. Source context: Huppert--Blackburn III,
XII.1.18(b), p.314.
-/

namespace Theory.GroupTheory.HeldM22A10.NonsplitAlternatives.ExtraExtensions.ThirdRealization
open LocalModelDichotomy NonsplitModels
set_option maxRecDepth 100000

@[expose] public def rowPerm (i : Fin 384) : Equiv.Perm (Fin 16) :=
  evalWord ![thirdA, thirdB] (word i)

public theorem rowPerm_apply (i : Fin 384) (x : Fin 16) : rowPerm i x = row i x :=
  (row_word i x).symm

private theorem word_mem (w : List (Fin 2)) :
    evalWord ![thirdA, thirdB] w ∈ thirdSubgroup := by
  induction w with
  | nil => exact thirdSubgroup.one_mem
  | cons j w ih =>
      apply thirdSubgroup.mul_mem _ ih
      apply Subgroup.subset_closure
      fin_cases j <;> simp

public theorem rowPerm_mem (i : Fin 384) : rowPerm i ∈ thirdSubgroup := word_mem _

private theorem rowPerm_next (i : Fin 384) (j : Fin 4) :
    rowPerm (next i j) = rowPerm i * ![thirdA, thirdB, thirdA⁻¹, thirdB⁻¹] j := by
  apply Equiv.ext
  intro x
  simp only [Equiv.Perm.mul_apply, rowPerm_apply]
  exact row_next i j x

public theorem rowPerm_cover (h : Third) : ∃ i, rowPerm i = h.val := by
  have one : rowPerm 0 = 1 := Equiv.ext (fun x => (rowPerm_apply 0 x).trans (row_one x))
  rcases h with ⟨h, hh⟩
  change ∃ i, rowPerm i = h
  induction hh using Subgroup.closure_induction_right with
  | one => exact ⟨0, one⟩
  | mul_right x hx y hy ih =>
      obtain ⟨i, rfl⟩ := ih
      rcases hy with rfl | rfl
      · exact ⟨next i 0, rowPerm_next i 0⟩
      · exact ⟨next i 1, rowPerm_next i 1⟩
  | mul_inv_cancel x hx y hy ih =>
      obtain ⟨i, rfl⟩ := ih
      rcases hy with rfl | rfl
      · exact ⟨next i 2, rowPerm_next i 2⟩
      · exact ⟨next i 3, rowPerm_next i 3⟩

@[expose] public def rowElement (i : Fin 384) : Third := ⟨rowPerm i, rowPerm_mem i⟩

public theorem rowElement_surjective : Function.Surjective rowElement := by
  intro h
  obtain ⟨i, hi⟩ := rowPerm_cover h
  exact ⟨i, Subtype.ext hi⟩

private theorem preserves_blocks (h : Third) (x : Fin 16) :
    block (h.val x) = block (h.val (blockRep (block x))) := by
  obtain ⟨i, rfl⟩ := rowElement_surjective h
  simpa only [rowElement, rowPerm_apply] using row_blocks i x

@[expose] public def quotientFun (h : Third) (j : Fin 4) : Fin 4 :=
  block (h.val (blockRep j))

private theorem quotientFun_one (j : Fin 4) : quotientFun 1 j = j := block_rep j

private theorem quotientFun_mul (h k : Third) (j : Fin 4) :
    quotientFun (h * k) j = quotientFun h (quotientFun k j) :=
  preserves_blocks h (k.val (blockRep j))

/-- The quotient map acts on the four blocks `(x / 2) % 4`. -/
@[expose] public def projection : Third →* SymmetricFour where
  toFun h :=
    { toFun := quotientFun h
      invFun := quotientFun h⁻¹
      left_inv j := by rw [← quotientFun_mul, inv_mul_cancel, quotientFun_one]
      right_inv j := by rw [← quotientFun_mul, mul_inv_cancel, quotientFun_one] }
  map_one' := by exact Equiv.ext quotientFun_one
  map_mul' h k := by exact Equiv.ext (quotientFun_mul h k)

public theorem projection_apply (h : Third) (j : Fin 4) :
    projection h j = block (h.val (blockRep j)) := rfl

public theorem projection_surjective : Function.Surjective projection := by
  intro s
  refine ⟨rowElement (quotientWitness s), Equiv.ext (fun j => ?_)⟩
  change block (rowPerm (quotientWitness s) (blockRep j)) = s j
  rw [rowPerm_apply]
  exact quotient_witness s j

/-- Binary coordinates embedded as actual words in the published generators. -/
@[expose] public def inclusion : BinaryFour →* Third where
  toFun v := rowElement (kernelRows (binaryCode v))
  map_one' := by
    apply Subtype.ext
    exact Equiv.ext (fun x => (rowPerm_apply _ x).trans (kernel_one x))
  map_mul' v w := by
    apply Subtype.ext
    apply Equiv.ext
    intro x
    simp only [rowElement, Subgroup.coe_mul, Equiv.Perm.mul_apply, rowPerm_apply]
    exact kernel_mul v w x

public theorem inclusion_apply (v : BinaryFour) (x : Fin 16) :
    (inclusion v).val x = kernelRow v x := rowPerm_apply _ x

public theorem inclusion_injective : Function.Injective inclusion := by
  intro v w h
  apply kernel_injective_key
  have hp : ∀ x, kernelRow v x = kernelRow w x := fun x =>
    (inclusion_apply v x).symm.trans ((congrArg (fun g : Third => g.val x) h).trans
      (inclusion_apply w x))
  simp only [hp]

public theorem projection_inclusion (v : BinaryFour) : projection (inclusion v) = 1 := by
  apply Equiv.ext
  intro j
  change block ((inclusion v).val (blockRep j)) = j
  rw [inclusion_apply]
  exact kernel_blocks v j

public theorem inclusion_range : inclusion.range = projection.ker := by
  ext h
  constructor
  · rintro ⟨v, rfl⟩
    exact projection_inclusion v
  · intro hh
    obtain ⟨i, rfl⟩ := rowElement_surjective h
    refine ⟨binaryVector (kernelCoordinate i), ?_⟩
    apply Subtype.ext
    apply Equiv.ext
    intro x
    rw [inclusion_apply]
    change _ = rowPerm i x
    rw [rowPerm_apply]
    apply (row_kernel i _ x).symm
    intro j
    have hj := congrArg (fun s : SymmetricFour => s j) hh
    simpa only [projection_apply, rowElement, rowPerm_apply, Equiv.Perm.one_apply] using hj

private def generator (j : Fin 2) : Third :=
  ⟨![thirdA, thirdB] j, by apply Subgroup.subset_closure; fin_cases j <;> simp⟩

private theorem projection_generator (j : Fin 2) :
    projection (generator j) = ![quotientA, quotientB] j :=
  Equiv.ext (quotient_generators j)

private theorem conjugation_generator (j : Fin 2) (v : BinaryFour) :
    inclusion (sixOrbitAction (projection (generator j)) v) =
      generator j * inclusion v * (generator j)⁻¹ := by
  apply Subtype.ext
  apply Equiv.ext
  intro x
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, Equiv.Perm.mul_apply, inclusion_apply,
    projection_generator]
  exact conjugation_generators j v x

public theorem conjugation (h : Third) (v : BinaryFour) :
    inclusion (sixOrbitAction (projection h) v) = h * inclusion v * h⁻¹ := by
  have key : ∀ (g : Equiv.Perm (Fin 16)) (hg : g ∈ thirdSubgroup), ∀ w,
      inclusion (sixOrbitAction (projection ⟨g, hg⟩) w) =
        (⟨g, hg⟩ : Third) * inclusion w * (⟨g, hg⟩ : Third)⁻¹ := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
        rcases hg with rfl | rfl
        · exact conjugation_generator 0
        · exact conjugation_generator 1
    | one =>
        intro w
        change inclusion (sixOrbitAction (projection (1 : Third)) w) = 1 * inclusion w * 1⁻¹
        simp
    | @mul g k hg hk ihg ihk =>
        intro w
        change inclusion (sixOrbitAction (projection ((⟨g, hg⟩ : Third) * ⟨k, hk⟩)) w) =
          ((⟨g, hg⟩ : Third) * ⟨k, hk⟩) * inclusion w *
            ((⟨g, hg⟩ : Third) * ⟨k, hk⟩)⁻¹
        rw [map_mul, map_mul, MulAut.mul_apply, ihg, ihk]
        simp [mul_assoc]
    | @inv g hg ih =>
        intro w
        let a : Third := ⟨g, hg⟩
        change inclusion (sixOrbitAction (projection a⁻¹) w) = a⁻¹ * inclusion w * (a⁻¹)⁻¹
        have e := ih (sixOrbitAction (projection a⁻¹) w)
        change inclusion (sixOrbitAction (projection a) (sixOrbitAction (projection a⁻¹) w)) =
          a * inclusion (sixOrbitAction (projection a⁻¹) w) * a⁻¹ at e
        rw [map_inv, map_inv, MulAut.apply_inv_self] at e
        rw [inv_inv, map_inv, map_inv]
        rw [e]
        group
  exact key h.val h.property v

/-- The actual short exact sequence with the prescribed six-orbit action. -/
@[expose] public def extension : ActionExtension sixOrbitAction Third where
  inl := inclusion
  rightHom := projection
  inl_injective := inclusion_injective
  range_inl_eq_ker_rightHom := inclusion_range
  rightHom_surjective := projection_surjective
  conjugation := conjugation

end Theory.GroupTheory.HeldM22A10.NonsplitAlternatives.ExtraExtensions.ThirdRealization
