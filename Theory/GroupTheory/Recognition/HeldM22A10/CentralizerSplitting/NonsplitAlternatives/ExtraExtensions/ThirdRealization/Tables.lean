def block (x : Fin 16) : Fin 4 := ⟨x.val / 2 % 4, Nat.mod_lt _ (by decide)⟩

def blockRep (j : Fin 4) : Fin 16 := ⟨2 * j.val, by omega⟩

def binaryCode (v : BinaryFour) : Fin 16 :=
  ⟨(v.toAdd 0).val + 2 * (v.toAdd 1).val + 4 * (v.toAdd 2).val +
    8 * (v.toAdd 3).val, by
    have h0 := (v.toAdd 0).val_lt
    have h1 := (v.toAdd 1).val_lt
    have h2 := (v.toAdd 2).val_lt
    have h3 := (v.toAdd 3).val_lt
    omega⟩

def binaryVector (i : Fin 16) : BinaryFour :=
  Multiplicative.ofAdd (fun j => (i.val / 2 ^ j.val : ℕ))

def kernelRow (v : BinaryFour) : Fin 16 → Fin 16 := row (kernelRows (binaryCode v))

