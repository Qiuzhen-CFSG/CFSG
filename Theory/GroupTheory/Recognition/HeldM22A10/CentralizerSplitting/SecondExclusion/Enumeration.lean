@[expose] public def digit (n : ℕ) (j : Fin 16) : Fin 16 :=
  ⟨n / 16 ^ j.val % 16, Nat.mod_lt _ (by decide)⟩

@[expose] public def row (i : Fin 384) : Fin 16 → Fin 16 := digit codes[i.val]!
@[expose] public def inverseRow (i : Fin 384) : Fin 16 → Fin 16 :=
  digit inverseCodes[i.val]!

private theorem inverse_left : ∀ i : Fin 384, ∀ j : Fin 16,
    inverseRow i (row i j) = j := by decide +kernel

private theorem inverse_right : ∀ i : Fin 384, ∀ j : Fin 16,
    row i (inverseRow i j) = j := by decide +kernel

/-- The actual permutation in row `i`. -/
@[expose] public def perm (i : Fin 384) : Equiv.Perm (Fin 16) where
  toFun := row i
  invFun := inverseRow i
  left_inv := by exact inverse_left i
  right_inv := by exact inverse_right i

