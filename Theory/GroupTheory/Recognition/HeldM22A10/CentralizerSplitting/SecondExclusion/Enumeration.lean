private def indexDigit (n : ℕ) (j : Fin 2) : Fin 384 :=
  ⟨n / 384 ^ j.val % 384, Nat.mod_lt _ (by decide)⟩
private def next (i : Fin 384) (j : Fin 2) : Fin 384 := indexDigit nextCodes[i.val]! j
private def prev (i : Fin 384) (j : Fin 2) : Fin 384 := indexDigit prevCodes[i.val]! j

private theorem perm_next : ∀ i j, perm (next i j) = perm i * generators j := by
  decide +kernel
private theorem perm_prev : ∀ i j, perm (prev i j) = perm i * (generators j)⁻¹ := by
  decide +kernel

private theorem range_generators : Set.range generators = {secondA, secondB} := by
  ext p
  simp [generators, or_comm]

/-- Every checked row belongs to the original generated subgroup. -/
public theorem perm_mem (i : Fin 384) : perm i ∈ secondSubgroup := by
  rw [perm_eq_word]
  apply SubgroupEnumeration.evalWord_mem
  intro j
  apply Subgroup.subset_closure
  rw [← range_generators]
  exact Set.mem_range_self j

/-- All elements of the shared carrier occur in the table. -/
public theorem exists_perm (p : Second) : ∃ i : Fin 384, perm i = (p : Equiv.Perm (Fin 16)) := by
  have hp : (p : Equiv.Perm (Fin 16)) ∈ Subgroup.closure (Set.range generators) := by
    rw [range_generators]
    exact p.property
  suffices ∀ x : Equiv.Perm (Fin 16),
      x ∈ Subgroup.closure (Set.range generators) → ∃ i : Fin 384, perm i = x from
    this p hp
  intro x hx
  induction hx using Subgroup.closure_induction_right with
  | one => exact ⟨0, perm_zero⟩
  | mul_right x hx y hy ih =>
    obtain ⟨i, rfl⟩ := ih
    obtain ⟨j, rfl⟩ := hy
    exact ⟨next i j, perm_next i j⟩
  | mul_inv_cancel x hx y hy ih =>
    obtain ⟨i, rfl⟩ := ih
    obtain ⟨j, rfl⟩ := hy
    exact ⟨prev i j, perm_prev i j⟩

private def key (i : Fin 384) : ℕ :=
  (row i 0).val * 4096 + (row i 1).val * 256 + (row i 2).val * 16 + (row i 3).val

private theorem key_strictMono : StrictMono key :=
  Fin.strictMono_iff_lt_succ.mpr (by decide +kernel)

/-- Distinct rows are distinct permutations. -/
public theorem perm_injective : Function.Injective perm := by
  intro i j hij
  have hh : row i = row j := congrArg (fun p : Equiv.Perm (Fin 16) => p.toFun) hij
  have hk : key i = key j := by
    dsimp only [key]
    rw [hh]
  exact key_strictMono.injective hk

/-- Enumeration into the original carrier; no new multiplication is introduced. -/
@[expose] public def element (i : Fin 384) : Second := ⟨perm i, by exact perm_mem i⟩

public theorem element_bijective : Function.Bijective element := by
  constructor
  · intro i j h
    exact perm_injective (congrArg Subtype.val h)
  · intro p
    obtain ⟨i, hi⟩ := exists_perm p
    exact ⟨i, Subtype.ext hi⟩

/-- The second published permutation group has order 384. -/
public theorem card : Nat.card Second = 384 := by
  exact (Nat.card_congr (Equiv.ofBijective element element_bijective)).symm.trans
    (Nat.card_fin 384)

end Theory.GroupTheory.HeldM22A10.SecondExclusion.Model
