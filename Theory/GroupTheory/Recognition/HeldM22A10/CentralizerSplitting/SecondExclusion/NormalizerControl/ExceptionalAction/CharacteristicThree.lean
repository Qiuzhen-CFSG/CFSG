module
public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.SecondExclusion.Structure
public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.SecondExclusion.Context
public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.SecondExclusion.NormalizerControl.Geometry
public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.SecondExclusion.NormalizerControl.ExceptionalAction.CharacteristicFour

/-!
# The intrinsic order-eight subgroup of Q

V is the intersection of F with the subgroup generated by involutions outside
F. Explicit products of two or three involutions generate V, and an explicit
order-thirty-two subgroup bounds the generated subgroup in the other direction.
Thus invariance of F proves invariance of V under every automorphism of Q.
The finite permutation identities are checked by the kernel.

These are local ingredients for the independent normalizer argument toward
Huppert--Blackburn III, XII.1.18(b), printed p.314.
-/
namespace Theory.GroupTheory.HeldM22A10.SecondExclusion.NormalizerControl.ExceptionalAction
open NonsplitModels Model Subgroup
set_option maxRecDepth 100000

private def generatedRows (i : Fin 32) : Second :=
  element (![0, 1, 8, 9, 12, 13, 20, 21, 48, 49, 52, 53, 60, 61, 64, 65, 96, 97, 104, 105, 108, 109, 116, 117, 240, 241, 244, 245, 252, 253, 256, 257] i)

private def pairRows (i : Fin 8) (j : Fin 2) : Second :=
  element ((![![20, 20], ![20, 21], ![20, 20], ![20, 20], ![20, 20], ![20, 20], ![20, 96], ![20, 97]]) i j)

private def tripleRows (i : Fin 8) (j : Fin 3) : Second :=
  element ((![![20, 20, 20], ![20, 20, 20], ![20, 48, 60], ![20, 48, 61], ![20, 48, 244], ![20, 48, 245], ![20, 20, 20], ![20, 20, 20]]) i j)

private def generatedMulRow (i : Fin 32) (j : Fin 32) : Fin 32 :=
  ⟨((#[1459980823972598128486511383358617792788444579872, 1415692895568631373389430024791457701283719351297, 472789015345789230937694279952652858041731940450, 517076859277236294707727338236247535476732331075, 1227112441064192953848816989140958971133284292772, 1271400284995640017618850047424553648568284683397, 705657398253851379650102242081985326201264312550, 661369469849884624553020883514825234696539083975, 1082819111113696331786610113985168855344651544872, 1038531182709729576689528755418008763839926316297, 95627302486887434237793010579203920597938905450, 139915146418334498007826068862798598032939296075, 849950728205291157148915719767510033689491257772, 894238572136738220918948778051104711124491648397, 328495685394949582950200972708536388757471277550, 284207756990982827853119614141376297252746048975, 1177293880339920090350565218574906722403186494000, 1133005951935953335253483860007746630898461265425, 567263065194164697284736054665178308531440894578, 611550909125611761054769112948772985966441285203, 1321586490912568420195858763853484421622993246900, 1365874334844015483965891822137079099057993637525, 422970454621173341514156077298274255816006226678, 378682526217206586417074718731114164311280998103, 800132167481018293650663949201457784959393459000, 755844239077051538553582590634297693454668230425, 190101352335262900584834785291729371087647859578, 234389196266709964354867843575324048522648250203, 944424778053666623495957494480035484179200211900, 988712621985113687265990552763630161614200602525, 45808741762271544814254807924825318372213191678, 1520813358304789717173449357665226867487963103] : Array ℕ)[i.val]! / 32 ^ j.val) % 32, Nat.mod_lt _ (by decide)⟩

private def generatedInvRow (i : Fin 32) : Fin 32 :=
  ![0, 1, 2, 3, 5, 4, 6, 7, 8, 9, 29, 28, 12, 13, 24, 25, 16, 17, 19, 18, 20, 21, 22, 23, 14, 15, 26, 27, 11, 10, 30, 31] i

private def generatedGroup : Subgroup Second where
  carrier := Set.range generatedRows
  one_mem' := by exact (by decide +kernel : ∃ i, generatedRows i = 1)
  mul_mem' := by
    rintro _ _ ⟨i, rfl⟩ ⟨j, rfl⟩
    exact ⟨generatedMulRow i j, (by decide +kernel : ∀ i j,
      generatedRows (generatedMulRow i j) = generatedRows i * generatedRows j) i j⟩
  inv_mem' := by
    rintro _ ⟨i, rfl⟩
    exact ⟨generatedInvRow i, (by decide +kernel : ∀ i,
      generatedRows (generatedInvRow i) = (generatedRows i)⁻¹) i⟩

private instance : DecidablePred (· ∈ generatedGroup) := fun x =>
  inferInstanceAs (Decidable (∃ i, generatedRows i = x))

private def outsideInvolutions : Set exceptionalSubgroup :=
  {x | x ^ 2 = 1 ∧ (x : Second) ∉ fourGroup}

private theorem outside_mem_generated (x : exceptionalSubgroup) (hx : x ∈ outsideInvolutions) :
    (x : Second) ∈ generatedGroup := by
  obtain ⟨i, hi⟩ := element_bijective.2 (x : Second)
  have h := (by decide +kernel : ∀ i : Fin 384,
    element i ∈ exceptionalSubgroup → (element i) ^ 2 = 1 →
    element i ∉ fourGroup → element i ∈ generatedGroup) i
  rw [hi] at h
  exact h x.property (congrArg Subtype.val hx.1) hx.2

private theorem generated_inter_four (x : Second) (hx : x ∈ generatedGroup)
    (hf : x ∈ fourGroup) : x ∈ threeGroup := by
  obtain ⟨i, rfl⟩ := hx
  exact (by decide +kernel : ∀ i, generatedRows i ∈ fourGroup →
    generatedRows i ∈ threeGroup) i hf

private theorem three_mem_closure (x : exceptionalSubgroup) (hx : (x : Second) ∈ threeGroup) :
    x ∈ closure outsideInvolutions := by
  obtain ⟨i, hi⟩ := hx
  have hp : ∀ j, pairRows i j ∈ exceptionalSubgroup ∧
      (pairRows i j) ^ 2 = 1 ∧ pairRows i j ∉ fourGroup :=
    (by decide +kernel : ∀ i j, pairRows i j ∈ exceptionalSubgroup ∧
      (pairRows i j) ^ 2 = 1 ∧ pairRows i j ∉ fourGroup) i
  have ht : ∀ j, tripleRows i j ∈ exceptionalSubgroup ∧
      (tripleRows i j) ^ 2 = 1 ∧ tripleRows i j ∉ fourGroup :=
    (by decide +kernel : ∀ i j, tripleRows i j ∈ exceptionalSubgroup ∧
      (tripleRows i j) ^ 2 = 1 ∧ tripleRows i j ∉ fourGroup) i
  let p (j : Fin 2) : exceptionalSubgroup := ⟨pairRows i j, (hp j).1⟩
  let t (j : Fin 3) : exceptionalSubgroup := ⟨tripleRows i j, (ht j).1⟩
  have hp' (j) : p j ∈ closure outsideInvolutions :=
    subset_closure ⟨Subtype.ext (hp j).2.1, (hp j).2.2⟩
  have ht' (j) : t j ∈ closure outsideInvolutions :=
    subset_closure ⟨Subtype.ext (ht j).2.1, (ht j).2.2⟩
  rcases (by decide +kernel : ∀ i,
      pairRows i 0 * pairRows i 1 = threeRows i ∨
      tripleRows i 0 * tripleRows i 1 * tripleRows i 2 = threeRows i) i with h | h
  · have he : p 0 * p 1 = x := Subtype.ext (h.trans hi)
    rw [← he]
    exact (closure outsideInvolutions).mul_mem (hp' 0) (hp' 1)
  · have he : t 0 * t 1 * t 2 = x := Subtype.ext (h.trans hi)
    rw [← he]
    exact (closure outsideInvolutions).mul_mem
      ((closure outsideInvolutions).mul_mem (ht' 0) (ht' 1)) (ht' 2)

private theorem three_intrinsic (x : exceptionalSubgroup) :
    (x : Second) ∈ threeGroup ↔
      (x : Second) ∈ fourGroup ∧ x ∈ closure outsideInvolutions := by
  refine ⟨fun hx => ⟨threeGroup_le_fourGroup hx, three_mem_closure x hx⟩, ?_⟩
  rintro ⟨hf, hr⟩
  apply generated_inter_four _ ?_ hf
  have hle : closure outsideInvolutions ≤ generatedGroup.comap exceptionalSubgroup.subtype := by
    rw [Subgroup.closure_le]
    exact fun q hq => outside_mem_generated q hq
  exact hle hr

private theorem closure_invariant (a : MulAut exceptionalSubgroup) {x : exceptionalSubgroup}
    (hx : x ∈ closure outsideInvolutions) : a x ∈ closure outsideInvolutions := by
  have hle : closure outsideInvolutions ≤ (closure outsideInvolutions).comap a.toMonoidHom := by
    rw [Subgroup.closure_le]
    intro q hq
    change a q ∈ closure outsideInvolutions
    apply Subgroup.subset_closure
    refine ⟨?_, fun h => hq.2 ((four_invariant a q).mp h)⟩
    simpa only [map_pow, map_one] using congrArg a hq.1
  exact hle hx

/-- Every automorphism of Q preserves V, the indicated intrinsic intersection. -/
public theorem three_invariant (a : MulAut exceptionalSubgroup) (x : exceptionalSubgroup) :
    (a x : Second) ∈ threeGroup ↔ (x : Second) ∈ threeGroup := by
  have fwd (a : MulAut exceptionalSubgroup) (x : exceptionalSubgroup)
      (hx : (x : Second) ∈ threeGroup) : (a x : Second) ∈ threeGroup := by
    rw [three_intrinsic] at hx ⊢
    exact ⟨(four_invariant a x).mpr hx.1, closure_invariant a hx.2⟩
  exact ⟨fun h => by simpa only [a.symm_apply_apply] using fwd a.symm (a x) h, fwd a x⟩


end Theory.GroupTheory.HeldM22A10.SecondExclusion.NormalizerControl.ExceptionalAction
