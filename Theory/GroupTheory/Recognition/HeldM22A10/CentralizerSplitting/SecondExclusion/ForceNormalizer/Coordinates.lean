private def transferConjugate (i : Fin 384) (j : Fin 6) : Fin 64 :=
  ⟨transferConjugateCodes[i.val]! / 64 ^ j.val % 64, Nat.mod_lt _ (by decide)⟩

private theorem transfer_conjugate : ∀ i j,
    element i * transferGenerators j * (element i)⁻¹ =
      element (transferIndex (transferConjugate i j)) := by
  decide +kernel

/-- Normality is in the entire concrete centralizer, not just its Sylow subgroup. -/
public instance transferSubgroup_normal : transferSubgroup.Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  apply le_normalizer_closure_iff.mpr
  intro x _ y hy
  obtain ⟨i, rfl⟩ := element_bijective.2 x
  obtain ⟨j, rfl⟩ := hy
  rw [transfer_conjugate]
  exact transfer_element_mem _

public theorem transferSubgroup_index_in_sylow :
    (transferSubgroup.subgroupOf sylowSubgroup).index = 2 := by
  have hcard : Nat.card (transferSubgroup.subgroupOf sylowSubgroup) = 64 :=
    (Nat.card_congr (subgroupOfEquivOfLe transferSubgroup_le_sylow).toEquiv).trans
      transferSubgroup_card
  have h := (transferSubgroup.subgroupOf sylowSubgroup).card_mul_index
  rw [hcard, sylowSubgroup_card] at h
  omega

