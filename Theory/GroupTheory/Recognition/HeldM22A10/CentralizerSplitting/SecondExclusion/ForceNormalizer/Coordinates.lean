private def transferPrev (i : Fin 64) (j : Fin 6) : Fin 64 :=
  ⟨transferPrevCodes[i.val]! / 64 ^ j.val % 64, Nat.mod_lt _ (by decide)⟩

private theorem transfer_prev : ∀ i j,
    element (transferIndex (transferPrev i j)) =
      element (transferIndex i) * (transferGenerators j)⁻¹ := by
  decide +kernel

public theorem transfer_element_mem (i : Fin 64) :
    element (transferIndex i) ∈ transferSubgroup := by
  rw [transfer_word]
  exact SubgroupEnumeration.evalWord_mem transferGenerators transferSubgroup
    (fun j => subset_closure (Set.mem_range_self j)) _

public theorem exists_transfer_element (x : Second) (hx : x ∈ transferSubgroup) :
    ∃ i : Fin 64, element (transferIndex i) = x := by
  induction hx using Subgroup.closure_induction_right with
  | one => exact ⟨0, by decide +kernel⟩
  | mul_right x hx y hy ih =>
    obtain ⟨i, rfl⟩ := ih
    obtain ⟨j, rfl⟩ := hy
    exact ⟨transferNext i j, transfer_next i j⟩
  | mul_inv_cancel x hx y hy ih =>
    obtain ⟨i, rfl⟩ := ih
    obtain ⟨j, rfl⟩ := hy
    exact ⟨transferPrev i j, transfer_prev i j⟩

public theorem transfer_mem_iff (x : Second) :
    x ∈ transferSubgroup ↔ ∃ i : Fin 64, element (transferIndex i) = x :=
  ⟨exists_transfer_element x, fun ⟨i, hi⟩ => hi ▸ transfer_element_mem i⟩

public instance instDecidableMemTransfer : DecidablePred (· ∈ transferSubgroup) :=
  fun x => decidable_of_iff (∃ i : Fin 64, element (transferIndex i) = x)
    (transfer_mem_iff x).symm

public theorem transferSubgroup_card : Nat.card transferSubgroup = 64 := by
  let f : Fin 64 → transferSubgroup := fun i => ⟨element (transferIndex i), transfer_element_mem i⟩
  have hf : Function.Bijective f := by
    constructor
    · intro i j hij
      exact transferIndex_strictMono.injective
        (element_bijective.1 (congrArg Subtype.val hij))
    · intro x
      obtain ⟨i, hi⟩ := exists_transfer_element x x.property
      exact ⟨i, Subtype.ext hi⟩
  exact (Nat.card_congr (Equiv.ofBijective f hf)).symm.trans (Nat.card_fin 64)

/-- The published Sylow candidate is indeed a Sylow two-subgroup. -/
@[expose] public noncomputable def sylow : Sylow 2 Second :=
  Sylow.ofCard sylowSubgroup (by rw [sylowSubgroup_card, card]; decide +kernel)

public theorem sylow_coe : (sylow : Subgroup Second) = sylowSubgroup := rfl

private theorem transfer_generators_in_sylow : ∀ j : Fin 6,
    transferGenerators j = element (sylowIndex (![11, 27, 37, 19, 1, 39] j)) := by
  decide +kernel

public theorem transferSubgroup_le_sylow : transferSubgroup ≤ sylowSubgroup := by
  apply (closure_le _).mpr
  rintro _ ⟨j, rfl⟩
  rw [transfer_generators_in_sylow j]
  exact sylow_element_mem _

