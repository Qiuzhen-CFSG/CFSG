private def sylowPrev (i : Fin 128) (j : Fin 7) : Fin 128 :=
  ⟨sylowPrevCodes[i.val]! / 128 ^ j.val % 128, Nat.mod_lt _ (by decide)⟩

private theorem sylow_prev : ∀ i j,
    element (sylowIndex (sylowPrev i j)) =
      element (sylowIndex i) * (sylowGenerators j)⁻¹ := by
  decide +kernel

public theorem sylow_element_mem (i : Fin 128) :
    element (sylowIndex i) ∈ sylowSubgroup := by
  rw [sylow_word]
  exact SubgroupEnumeration.evalWord_mem sylowGenerators sylowSubgroup
    (fun j => subset_closure (Set.mem_range_self j)) _

public theorem exists_sylow_element (x : Second) (hx : x ∈ sylowSubgroup) :
    ∃ i : Fin 128, element (sylowIndex i) = x := by
  induction hx using Subgroup.closure_induction_right with
  | one => exact ⟨0, by decide +kernel⟩
  | mul_right x hx y hy ih =>
    obtain ⟨i, rfl⟩ := ih
    obtain ⟨j, rfl⟩ := hy
    exact ⟨sylowNext i j, sylow_next i j⟩
  | mul_inv_cancel x hx y hy ih =>
    obtain ⟨i, rfl⟩ := ih
    obtain ⟨j, rfl⟩ := hy
    exact ⟨sylowPrev i j, sylow_prev i j⟩

public theorem sylow_mem_iff (x : Second) :
    x ∈ sylowSubgroup ↔ ∃ i : Fin 128, element (sylowIndex i) = x :=
  ⟨exists_sylow_element x, fun ⟨i, hi⟩ => hi ▸ sylow_element_mem i⟩

public instance instDecidableMemSylow : DecidablePred (· ∈ sylowSubgroup) :=
  fun x => decidable_of_iff (∃ i : Fin 128, element (sylowIndex i) = x)
    (sylow_mem_iff x).symm

public theorem sylowSubgroup_card : Nat.card sylowSubgroup = 128 := by
  let f : Fin 128 → sylowSubgroup := fun i => ⟨element (sylowIndex i), sylow_element_mem i⟩
  have hf : Function.Bijective f := by
    constructor
    · intro i j hij
      exact sylowIndex_strictMono.injective
        (element_bijective.1 (congrArg Subtype.val hij))
    · intro x
      obtain ⟨i, hi⟩ := exists_sylow_element x x.property
      exact ⟨i, Subtype.ext hi⟩
  exact (Nat.card_congr (Equiv.ofBijective f hf)).symm.trans (Nat.card_fin 128)

