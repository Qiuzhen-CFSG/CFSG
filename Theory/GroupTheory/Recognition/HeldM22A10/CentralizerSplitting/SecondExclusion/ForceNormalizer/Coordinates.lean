private theorem exceptional_in_sylow_rows : ∀ i : Fin 384,
    element i * exceptionalPoint = exceptionalPoint * element i →
    element (sylowIndex ⟨exceptionalSylowPreimage[i.val]! % 128,
      Nat.mod_lt _ (by decide)⟩) = element i := by
  decide +kernel

public theorem exceptionalSubgroup_le_sylow : exceptionalSubgroup ≤ sylowSubgroup := by
  intro x hx
  obtain ⟨i, rfl⟩ := element_bijective.2 x
  rw [← exceptional_in_sylow_rows i (mem_centralizer_singleton_iff.mp hx)]
  exact sylow_element_mem _

public theorem exceptionalSubgroup_index_in_sylow :
    (exceptionalSubgroup.subgroupOf sylowSubgroup).index = 2 := by
  have hcard : Nat.card (exceptionalSubgroup.subgroupOf sylowSubgroup) = 64 :=
    (Nat.card_congr (subgroupOfEquivOfLe exceptionalSubgroup_le_sylow).toEquiv).trans
      exceptionalSubgroup_card
  have h := (exceptionalSubgroup.subgroupOf sylowSubgroup).card_mul_index
  rw [hcard, sylowSubgroup_card] at h
  omega

public instance exceptionalSubgroup_normal_in_sylow :
    (exceptionalSubgroup.subgroupOf sylowSubgroup).Normal :=
  normal_of_index_eq_two exceptionalSubgroup_index_in_sylow

