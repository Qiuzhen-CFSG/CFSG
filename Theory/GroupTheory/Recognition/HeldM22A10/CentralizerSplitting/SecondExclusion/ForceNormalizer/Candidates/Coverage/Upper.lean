/-- The maximal-subgroup trichotomy for entries from 24 onwards. -/
public theorem classify_upper (i : Fin 45) (hi : 24 ≤ i.val) (H : Subgroup S)
    (hH : H ⋖ representative i) : Classified H := by
  have he : (⟨(i.val - 24) + 24, by omega⟩ : Fin 45) = i := by
    apply Fin.ext
    simp only [Nat.sub_add_cancel hi]
  apply classify_upper_fin ⟨i.val - 24, by omega⟩ H
  simpa only [he] using hH

