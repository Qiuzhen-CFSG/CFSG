    ⟨signatureIndex σ % 4, Nat.mod_lt _ (by decide)⟩

private theorem pivot_checked : ∀ σ : Fin 2 → Bool,
    (∃ k, σ k = true) → σ (pivot σ) = true := by decide +kernel

