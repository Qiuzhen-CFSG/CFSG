module

public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.SecondExclusion.ForceNormalizer.Candidates.Coverage.Soundness

/-!
# Checked maximal subgroups of Held representatives 0 through 23

Smaller generating families are identified with the fixed representatives by
word equations in both directions. Every nonzero binary signature has a checked
certificate placing its Schreier subgroup in the kernel, exhibiting an outside
centralizer element, or conjugating it to one of the fixed representatives.
The outside certificates bound the entire closure using generator transitions.

Generated by `Coverage/source/generate.py` from the actual CFSG permutations.
Every finite equation is checked by `decide +kernel`. No external enumeration
is trusted. Source problem: Huppert--Blackburn III, XII.1.18(b), printed p.314;
these are intermediate finite subgroup calculations, not new source hypotheses.
-/

namespace Theory.GroupTheory.HeldM22A10.SecondExclusion.ForceNormalizer.Candidates.CoverageCertificate
open Subgroup SubgroupEnumeration
set_option maxRecDepth 100000

namespace Node0

private def gen : Fin 2 → S :=
  fun k => Model.sylowElement (![123, 39] k)

private def generationWords : ClosureWords 2 7 :=
  ⟨![[0], [2]], ![[0], [0, 0], [1], [], [], [], []]⟩

private theorem generated : closure (Set.range gen) = representative 0 :=
  generated_of_words 0 gen generationWords (by decide +kernel)

private def pivot (σ : Fin 2 → Bool) : Fin 2 :=
  ![0, 0, 1, 0] ⟨signatureIndex σ % 4, Nat.mod_lt _ (by decide)⟩

private def branches (σ : Fin 2 → Bool) : BranchData 2 :=
  ![.inside,
    .inside,
    .noncentric 16 ⟨4, ![0, 52, 87, 123], 0, ![![3, 0, 3, 0], ![0, 1, 0, 1], ![1, 2, 1, 2], ![2, 3, 2, 3]], ![![1, 0, 1, 0], ![2, 1, 2, 1], ![3, 2, 3, 2], ![0, 3, 0, 3]]⟩,
