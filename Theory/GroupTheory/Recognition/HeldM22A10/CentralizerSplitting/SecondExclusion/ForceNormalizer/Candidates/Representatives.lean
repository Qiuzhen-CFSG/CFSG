module

public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.SecondExclusion.ForceNormalizer.Model

/-!
# Concrete representatives for the second Held kernel calculation

The entries are actual subgroups of the fixed order-128 Sylow subgroup. Their
coordinates refer to `Model.sylowElement`, whose bijectivity is already proved.
Entry 40 is the specified exceptional subgroup and entry 44 is the whole Sylow
subgroup. The other entries are generated by the seven displayed elements,
with identity padding. No coverage or automorphism assertion is made by these
definitions.

The proposed list was obtained from the exact permutations in `Model.element`,
using the exploratory calculations described in `source/README.md`. These
calculations are discovery tools, not certificates.
The separate coverage and automorphism obligations are stated below. This is
an intermediate calculation for Huppert--Blackburn III, XII.1.18(b), p.314.
-/

namespace Theory.GroupTheory.HeldM22A10.SecondExclusion.ForceNormalizer.Candidates
open Subgroup

/-- The transfer kernel inside the fixed Sylow group. -/
@[expose] public def kernel : Subgroup Model.sylowSubgroup :=
  Model.transferSubgroup.subgroupOf Model.sylowSubgroup

/-- The exceptional subgroup inside the same Sylow group. -/
@[expose] public def exceptional : Subgroup Model.sylowSubgroup :=
  Model.exceptionalSubgroup.subgroupOf Model.sylowSubgroup

/-- Normality of the kernel is inherited from the whole second model. -/
public instance kernel_normal : kernel.Normal := by
  dsimp [kernel]
  infer_instance

/-- The exceptional subgroup is normal relative to the Sylow group. -/
public instance exceptional_normal : exceptional.Normal := by
  dsimp [exceptional]
  infer_instance

/-- Generator indices in the existing bijective 128-element enumeration. -/
@[expose] public def generatorIndex : Fin 45 → Fin 7 → Fin 128 :=
  ![![123, 87, 39, 0, 0, 0, 0],
    ![77, 19, 39, 0, 0, 0, 0],
    ![80, 12, 38, 39, 0, 0, 0],
    ![45, 12, 1, 39, 0, 0, 0],
    ![113, 12, 1, 39, 0, 0, 0],
    ![113, 15, 1, 39, 0, 0, 0],
    ![113, 4, 1, 39, 0, 0, 0],
    ![20, 12, 38, 39, 0, 0, 0],
    ![27, 20, 7, 39, 0, 0, 0],
    ![27, 45, 12, 39, 0, 0, 0],
    ![69, 20, 7, 39, 0, 0, 0],
    ![69, 45, 12, 39, 0, 0, 0],
    ![20, 7, 1, 39, 0, 0, 0],
    ![20, 15, 38, 39, 0, 0, 0],
    ![80, 4, 1, 39, 0, 0, 0],
    ![123, 87, 1, 39, 0, 0, 0],
    ![15, 1, 9, 39, 0, 0, 0],
    ![4, 1, 9, 39, 0, 0, 0],
    ![15, 1, 2, 39, 0, 0, 0],
    ![4, 1, 2, 39, 0, 0, 0],
    ![7, 1, 60, 11, 0, 0, 0],
    ![4, 1, 60, 11, 0, 0, 0],
    ![77, 19, 1, 39, 0, 0, 0],
    ![20, 4, 1, 39, 0, 0, 0],
    ![77, 19, 1, 2, 39, 0, 0],
    ![1, 2, 60, 11, 4, 0, 0],
    ![20, 4, 1, 60, 11, 0, 0],
    ![20, 7, 1, 60, 11, 0, 0],
    ![27, 113, 15, 1, 39, 0, 0],
    ![27, 20, 7, 1, 39, 0, 0],
    ![27, 45, 12, 1, 39, 0, 0],
    ![27, 80, 4, 1, 39, 0, 0],
    ![113, 15, 1, 2, 39, 0, 0],
    ![20, 15, 1, 2, 39, 0, 0],
    ![20, 4, 1, 2, 39, 0, 0],
    ![80, 7, 1, 60, 11, 0, 0],
    ![80, 4, 1, 60, 11, 0, 0],
    ![123, 87, 36, 2, 39, 0, 0],
    ![1, 2, 60, 11, 77, 16, 0],
    ![27, 20, 4, 1, 37, 39, 0],
    ![1, 2, 60, 11, 20, 4, 0],
    ![27, 113, 15, 1, 2, 39, 0],
    ![101, 20, 4, 1, 2, 39, 0],
    ![101, 113, 15, 1, 2, 39, 0],
    ![1, 2, 60, 11, 20, 4, 27]]

/-- Actual Sylow elements, not formal group-family labels. -/
@[expose] public def generator (i : Fin 45) (j : Fin 7) : Model.sylowSubgroup :=
  Model.sylowElement (generatorIndex i j)

/-- The two distinguished entries use the shared subgroup definitions exactly. -/
@[expose] public def representative (i : Fin 45) : Subgroup Model.sylowSubgroup :=
  if i = 40 then exceptional else if i = 44 then ⊤ else closure (Set.range (generator i))

public theorem representative_exceptional : representative 40 = exceptional := by
  simp [representative]

public theorem representative_top : representative 44 = ⊤ := by
  simp [representative]

/-- Intrinsic radicality in the Sylow group, using the full automorphism two-core. -/
@[expose] public def IntrinsicRadical (U : Subgroup Model.sylowSubgroup) : Prop :=
  U.normalizerMonoidHom.range ⊓ pCore 2 (MulAut U) ≤
    (MulAut.conj : U →* MulAut U).range

/-- Exhaustive coverage required from the subgroup certificate. No radicality
hypothesis is used to hide omitted subgroups. -/
@[expose] public def Coverage : Prop :=
  ∀ U : Subgroup Model.sylowSubgroup, centralizer (U : Set Model.sylowSubgroup) ≤ U →
    ¬ U ≤ kernel → ∃ (i : Fin 45) (g : Model.sylowSubgroup),
      U.map (MulAut.conj g).toMonoidHom = representative i

/-- The automorphism calculation required for the displayed representatives.
Its hypotheses are the genuine centricity and intrinsic-radical conditions. -/
@[expose] public def RepresentativeProperty : Prop :=
  ∀ i : Fin 45, centralizer (representative i : Set Model.sylowSubgroup) ≤ representative i →
    IntrinsicRadical (representative i) →
    (kernel.subgroupOf (representative i)).Characteristic ∨ representative i = exceptional

end Theory.GroupTheory.HeldM22A10.SecondExclusion.ForceNormalizer.Candidates
