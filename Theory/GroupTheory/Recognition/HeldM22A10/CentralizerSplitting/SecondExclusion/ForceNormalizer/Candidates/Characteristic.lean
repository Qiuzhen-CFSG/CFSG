private theorem kernel_word : ∀ (j : Fin 25) (x : Point), member j x → inKernel x →
    x = evalWord (kernelGeneratorPoint j) (kernelWords[j.val]!)[(x : Fin 128).val]! := by
  decide +kernel

private theorem kernelGenerator_word_val (j : Fin 25) (w : List (Fin 5)) :
    (evalWord (kernelGenerator j) w).val = evalWord (kernelGeneratorPoint j) w := by
  induction w with
  | nil => rfl
  | cons k w ih =>
    change kernelGeneratorPoint j k * (evalWord (kernelGenerator j) w).val = _
    rw [ih]

private theorem characteristic_coordinate_kernel (j : Fin 25) :
    ((kernel.subgroupOf (representative (characteristicIndex j))).comap
      (candidateEquiv j).toMonoidHom).Characteristic := by
  let K := (kernel.subgroupOf (representative (characteristicIndex j))).comap
    (candidateEquiv j).toMonoidHom
  have hmem (x : candidate j) : x ∈ K ↔ inKernel x.val := (inKernel_iff x.val).symm
  have hgenerated : K ≤ closure (Set.range (kernelGenerator j)) := by
    intro x hx
    have hw : x = evalWord (kernelGenerator j) (kernelWords[j.val]!)[(x.val : Fin 128).val]! := by
      apply Subtype.ext
      rw [kernelGenerator_word_val]
      exact kernel_word j x.val x.property ((hmem x).mp hx)
    rw [hw]
    exact SubgroupEnumeration.evalWord_mem _ _
      (fun k => subset_closure (Set.mem_range_self k)) _
  apply characteristic_iff_le_comap.mpr
  intro a
  apply le_trans hgenerated
  apply (closure_le _).mpr
  rintro _ ⟨k, rfl⟩
  exact (hmem (a (kernelGenerator j k))).mpr
    (test_inKernel j _ (intrinsicTest_aut _ a _ (kernelGenerator_test j k)))

/-- All 25 actual kernel intersections are characteristic under the full
intrinsic automorphism groups of their representatives. -/
public theorem characteristicChecks : CharacteristicChecks := by
  intro j
  let e := candidateEquiv j
  let N := kernel.subgroupOf (representative (characteristicIndex j))
  have hchar : (N.comap e.toMonoidHom).Characteristic := characteristic_coordinate_kernel j
  apply characteristic_iff_le_comap.mpr
  intro a x hx
  obtain ⟨y, rfl⟩ := e.surjective x
  have h := characteristic_iff_le_comap.mp hchar (e.trans (a.trans e.symm)) hx
  change e (e.symm (a (e y))) ∈ N at h
  change a (e y) ∈ N
  simpa only [e.apply_symm_apply] using h

end Theory.GroupTheory.HeldM22A10.SecondExclusion.ForceNormalizer.Candidates
