set_option maxRecDepth 100000

private def involutionCount {G : Type*} [Group G] [Fintype G] [DecidableEq G] (x : G) : ℕ :=
  (Finset.univ.filter (fun y : G => y * x = x * y ∧ y * y = 1)).card

private theorem involutionCount_aut {G : Type*} [Group G] [Fintype G] [DecidableEq G]
    (a : MulAut G) (x : G) : involutionCount (a x) = involutionCount x := by
  have h := Nat.card_congr (a.toEquiv.subtypeEquiv (p := fun y : G => y * x = x * y ∧ y * y = 1)
    (q := fun y : G => y * a x = a x * y ∧ y * y = 1) (by
      intro y
      change (y * x = x * y ∧ y * y = 1) ↔
        (a y * a x = a x * a y ∧ a y * a y = 1)
      rw [← map_mul, ← map_mul, a.injective.eq_iff, ← map_mul,
        ← map_one a, a.injective.eq_iff]
      simp only [map_one]))
  simpa only [Nat.card_eq_fintype_card, Fintype.card_subtype, involutionCount] using h.symm

private def intrinsicTest {G : Type*} [Group G] [Fintype G] [DecidableEq G]
    (kind : Fin 6) (x : G) : Prop :=
  match kind.val with
  | 0 => x * x = 1
  | 1 => (x * x) * (x * x) = 1
  | 2 => (x * x) * (x * x) = 1 ∧ x * x ≠ 1
  | 3 => x * x ≠ 1
  | 4 => 8 < involutionCount x
  | _ => ∀ y : G, y * x = x * y → y * y = 1

private instance {G : Type*} [Group G] [Fintype G] [DecidableEq G]
    (kind : Fin 6) (x : G) : Decidable (intrinsicTest kind x) := by
  unfold intrinsicTest
  split <;> infer_instance

private theorem intrinsicTest_aut {G : Type*} [Group G] [Fintype G] [DecidableEq G]
    (kind : Fin 6) (a : MulAut G) (x : G) (hx : intrinsicTest kind x) :
    intrinsicTest kind (a x) := by
  have hs (y : G) : a y * a y = 1 ↔ y * y = 1 := by
    rw [← map_mul, ← map_one a, a.injective.eq_iff]
    simp only [map_one]
  have hf : (a x * a x) * (a x * a x) = 1 ↔ (x * x) * (x * x) = 1 := by
    simpa only [map_mul] using hs (x * x)
  fin_cases kind
  · exact (hs x).mpr hx
  · exact hf.mpr hx
  · exact ⟨hf.mpr hx.1, (hs x).not.mpr hx.2⟩
  · exact (hs x).not.mpr hx
  · change 8 < involutionCount (a x)
    rw [involutionCount_aut]
    exact hx
  · intro y hy
    obtain ⟨z, rfl⟩ := a.surjective y
    apply (hs z).mpr
    apply hx z
    exact a.injective (by simpa only [map_mul] using hy)

