private def kernelGeneratorPoint (j : Fin 25) (k : Fin 5) : Point :=
  (kernelGeneratorIndices[j.val]!)[k.val]!

private theorem kernelGenerator_mem : ∀ j k, kernelGeneratorPoint j k ∈ candidate j := by
  decide +kernel

private def kernelGenerator (j : Fin 25) (k : Fin 5) : candidate j :=
  ⟨kernelGeneratorPoint j k, kernelGenerator_mem j k⟩

