private def indexedGenerator (j : Fin 25) (k : Fin 7) : Point :=
  generatorIndex (characteristicIndex j) k

private theorem candidate_generator_mem : ∀ (j : Fin 25) (k : Fin 7),
    member j (indexedGenerator j k) := by decide +kernel

private theorem candidate_word : ∀ (j : Fin 25) (x : Point), member j x →
    x = evalWord (indexedGenerator j)
      ((candidateWords[j.val]!)[(x : Fin 128).val]!) := by decide +kernel

private theorem member_one : ∀ j, member j 1 := by decide +kernel
private theorem member_inv : ∀ j x, member j x → member j x⁻¹ := by decide +kernel

private theorem member_step : ∀ (j : Fin 25) (x : Point) (k : Fin 7),
    member j x → member j (x * indexedGenerator j k) := by decide +kernel

private theorem member_word (j : Fin 25) (x : Point) (hx : member j x)
    (w : List (Fin 7)) : member j (x * evalWord (indexedGenerator j) w) := by
  induction w generalizing x with
  | nil => simpa only [evalWord, mul_one] using hx
  | cons k w ih =>
    change member j (x * (indexedGenerator j k * evalWord (indexedGenerator j) w))
    rw [← mul_assoc]
    exact ih _ (member_step j x k hx)

private theorem member_mul (j : Fin 25) (x y : Point)
    (hx : member j x) (hy : member j y) : member j (x * y) := by
  rw [candidate_word j y hy]
  exact member_word j x hx _

/-- The finite subgroup described by each checked mask. -/
@[expose] public def candidate (j : Fin 25) : Subgroup Point where
  carrier := {x | member j x}
  one_mem' := by exact member_one j
  mul_mem' := by exact member_mul j _ _
  inv_mem' := by exact member_inv j _

public instance (j : Fin 25) : DecidablePred (· ∈ candidate j) := fun x => inferInstanceAs (Decidable (member j x))

public instance (j : Fin 25) : Fintype (candidate j) := Subtype.fintype _

private theorem realize_evalWord (j : Fin 25) (w : List (Fin 7)) :
    realize (evalWord (indexedGenerator j) w) =
      evalWord (generator (characteristicIndex j)) w := by
  induction w with
  | nil => exact equiv.map_one
  | cons k w ih =>
    change realize (_ * _) = _ * _
    rw [show realize (_ * _) = realize _ * realize _ from equiv.map_mul _ _, ih]
    rfl

/-- The coordinate subgroup is exactly the published representative. -/
public theorem candidate_map (j : Fin 25) :
    (candidate j).map equiv.toMonoidHom = representative (characteristicIndex j) := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    change realize x ∈ representative (characteristicIndex j)
    rw [candidate_word j x hx, realize_evalWord]
    exact SubgroupEnumeration.evalWord_mem _ _ (generator_mem _) _
  · rw [representative_eq_closure]
    apply (closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    exact ⟨generatorIndex (characteristicIndex j) k, candidate_generator_mem j k, rfl⟩

/-- The corresponding isomorphism of the actual subgroups. -/
@[expose] public noncomputable def candidateEquiv (j : Fin 25) :
    candidate j ≃* representative (characteristicIndex j) :=
  (equiv.subgroupMap (candidate j)).trans (MulEquiv.subgroupCongr (candidate_map j))

@[expose] public def inKernel (x : Point) : Prop :=
  (320261193559897846160102605693932998415 : ℕ).testBit (x : Fin 128).val = true

public instance : DecidablePred inKernel := fun _x => inferInstanceAs (Decidable (_ = true))

/-- The coordinate kernel is membership in the existing transfer subgroup. -/
public theorem inKernel_iff (x : Point) : inKernel x ↔ realize x ∈ kernel := by
  change inKernel x ↔ Model.element (Model.sylowIndex x) ∈ Model.transferSubgroup
  rw [Model.transfer_mem_iff]
  simp only [Model.element_bijective.1.eq_iff]
  have h : ∀ y : Point, inKernel y ↔ ∃ i : Fin 64, Model.transferIndex i = Model.sylowIndex y := by
    decide +kernel
  exact h x

end Theory.GroupTheory.HeldM22A10.SecondExclusion.ForceNormalizer.Candidates.CharacteristicCoordinates
