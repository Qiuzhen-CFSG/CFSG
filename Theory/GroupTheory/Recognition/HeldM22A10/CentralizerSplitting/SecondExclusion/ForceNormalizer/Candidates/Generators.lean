private theorem exceptional_generator_mem : ∀ j : Fin 7,
    generator 40 j ∈ exceptional := by
  change ∀ j : Fin 7, ((generator 40 j : Model.sylowSubgroup) : NonsplitModels.Second) ∈
    Model.exceptionalSubgroup
  decide +kernel

private theorem exceptional_word : ∀ i : Fin 128,
    ((Model.sylowElement i : Model.sylowSubgroup) : NonsplitModels.Second) *
        Model.exceptionalPoint = Model.exceptionalPoint * Model.sylowElement i →
    Model.sylowElement i = evalWord (generator 40) exceptionalWords[i.val]! := by
  decide +kernel

private theorem top_word : ∀ i : Fin 128,
    Model.sylowElement i = evalWord (generator 44) topWords[i.val]! := by
  decide +kernel

private theorem exceptional_eq_closure :
    exceptional = closure (Set.range (generator 40)) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨i, rfl⟩ := Model.sylowElement_bijective.2 x
    have hc : ((Model.sylowElement i : Model.sylowSubgroup) : NonsplitModels.Second) *
        Model.exceptionalPoint = Model.exceptionalPoint * Model.sylowElement i :=
      mem_centralizer_singleton_iff.mp hx
    rw [exceptional_word i hc]
    exact SubgroupEnumeration.evalWord_mem _ _
      (fun j => subset_closure (Set.mem_range_self j)) _
  · exact (closure_le exceptional).mpr (Set.range_subset_iff.mpr exceptional_generator_mem)

private theorem top_eq_closure :
    (⊤ : Subgroup Model.sylowSubgroup) = closure (Set.range (generator 44)) := by
  apply le_antisymm
  · intro x _
    obtain ⟨i, rfl⟩ := Model.sylowElement_bijective.2 x
    rw [top_word]
    exact SubgroupEnumeration.evalWord_mem _ _
      (fun j => subset_closure (Set.mem_range_self j)) _
  · exact le_top

/-- The displayed generators generate each actual representative, including
both entries defined using shared subgroup names. -/
public theorem representative_eq_closure (i : Fin 45) :
    representative i = closure (Set.range (generator i)) := by
  by_cases h40 : i = 40
  · subst i
    rw [representative_exceptional]
    exact exceptional_eq_closure
  · by_cases h44 : i = 44
    · subst i
      rw [representative_top]
      exact top_eq_closure
    · simp only [representative, if_neg h40, if_neg h44]

public theorem generator_mem (i : Fin 45) (j : Fin 7) :
    generator i j ∈ representative i := by
  rw [representative_eq_closure]
  exact subset_closure (Set.mem_range_self j)

