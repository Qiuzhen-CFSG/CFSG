module

public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.SecondExclusion.Context
public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.SecondExclusion.ForceNormalizer
public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.SecondExclusion.NormalizerControl

/-!
# Exclusion of the second nonsplit Held centralizer

The actual involution centralizer in a finite simple group satisfying
`LocalData` cannot be isomorphic to `NonsplitModels.Second`, the subgroup
generated by the two published permutations. Its checked enumeration and
subgroup calculations feed two ambient arguments: exceptional normalizer
control, and character fusion followed by transfer under that control.

The theorem below supplies the proved normalizer containment to the conditional
transfer argument. Every additional premise is discharged, retaining the
original local data and arbitrary ambient universe. Splitting and recognition
are separate conclusions of the source theorem, not assumptions here.

Source: Huppert--Blackburn, *Finite Groups III*, XII.1.18(b), p.314;
D. Held, J. Algebra 8 (1968), 436--449, DOI 10.1016/0021-8693(68)90054-9.
-/

namespace Theory.GroupTheory.HeldM22A10.LocalData

/-- The second nonsplit permutation model cannot be the actual involution
centralizer under the original finite simple ambient-group hypotheses. -/
public theorem not_nonempty_equiv_second
    {G : Type*} [Group G] [Finite G] [IsSimpleGroup G] (D : LocalData G) :
    ¬ Nonempty (D.centralizer ≃* NonsplitModels.Second) := by
  rintro ⟨e⟩
  exact SecondExclusion.ForceNormalizer.false_of_normalizer_le D e
    (SecondExclusion.NormalizerControl.normalizer_le D e)

end Theory.GroupTheory.HeldM22A10.LocalData
