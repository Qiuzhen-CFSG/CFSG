set_option maxHeartbeats 1000000 in
public theorem product_rows_1 (i : Fin 32) (j : Fin 128) (x : Fin 16) :
    row (product (Fin.ofNat 128 (i.val + 32)) j) x =
      row (Fin.ofNat 128 (i.val + 32)) (row j x) := by
  fin_cases i
  · exact product_row_32 j x
  · exact product_row_33 j x
  · exact product_row_34 j x
  · exact product_row_35 j x
  · exact product_row_36 j x
  · exact product_row_37 j x
  · exact product_row_38 j x
