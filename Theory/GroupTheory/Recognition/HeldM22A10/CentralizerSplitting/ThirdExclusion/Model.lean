module

public import Theory.GroupTheory.Recognition.HeldM22A10.CentralizerSplitting.ThirdExclusion.Certificates
public import Theory.GroupTheory.CheckedFiniteTable

/-!
# A certified two-subgroup of the third nonsplit model

An injective table of 128 permutations transports the inherited group law.
Each row is also checked against a word in `thirdA` and `thirdB`, giving an
injective homomorphism into the actual shared `Third` carrier. This avoids
using a SmallGroups identifier as a group isomorphism.

The certificate is generated by `source/generate.py`; every identity is
checked by kernel reduction. Source of the exclusion problem:
Huppert--Blackburn III, XII.1.18(b), p.314.
-/

namespace Theory.GroupTheory.HeldM22A10.ThirdExclusion
open NonsplitModels

set_option maxRecDepth 100000

/-- The actual degree-sixteen permutation represented by a row. -/
@[expose] public def rowPerm (i : Fin 128) : Equiv.Perm (Fin 16) where
  toFun := Tables.row i
  invFun := Tables.inverseRow i
  left_inv := by exact Tables.row_left_inverse i
  right_inv := by exact Tables.row_right_inverse i

private theorem row_injective : Function.Injective rowPerm := by
  intro i j h
  apply Tables.key_injective
  unfold Tables.key
  have he : ∀ x, Tables.row i x = Tables.row j x := fun x => congrArg (fun f => f x) h
  simp only [he]

private theorem row_one : rowPerm 0 = 1 := by
  exact Equiv.ext Tables.row_one

private theorem row_mul : ∀ i j, rowPerm (Tables.product i j) = rowPerm i * rowPerm j := by
  intro i j
  exact Equiv.ext (Tables.row_product i j)

/-- The finite table transfers, rather than postulates, the permutation group law. -/
@[expose] public def tableData : CheckedFiniteTable.Data (Equiv.Perm (Fin 16)) 128 where
  val := rowPerm
  mul := Tables.product
  inv := Tables.inverse
  unit := 0
  injective := by exact row_injective
  val_unit := by exact row_one
  val_mul := by exact row_mul
  inv_mul := by exact Tables.inverse_product

/-- A concrete group of order 128 embedded in `Third`. -/
public abbrev Model := CheckedFiniteTable.Carrier tableData

private theorem row_word : ∀ i, rowPerm i = evalWord ![thirdA, thirdB] (Tables.word i) := by
  intro i
  exact Equiv.ext (Tables.row_word i)

private theorem row_mem (i : Fin 128) : rowPerm i ∈ thirdSubgroup := by
  rw [row_word]
  apply SubgroupEnumeration.evalWord_mem
  intro j
  apply Subgroup.subset_closure
  fin_cases j <;> simp

/-- Every row belongs to the exact generated carrier in `NonsplitModels`. -/
@[expose] public def embedding : Model →* Third where
  toFun := fun i => ⟨rowPerm i, by exact row_mem i⟩
  map_one' := by exact Subtype.ext row_one
  map_mul' := by exact fun i j => Subtype.ext (row_mul i j)

public theorem embedding_injective : Function.Injective embedding :=
  fun _ _ h => row_injective (congrArg Subtype.val h)

public theorem model_card : Nat.card Model = 128 := Nat.card_fin 128

end Theory.GroupTheory.HeldM22A10.ThirdExclusion
