set_option maxHeartbeats 1000000 in
public theorem product_rows_0 (i : Fin 32) (j : Fin 128) (x : Fin 16) :
    row (product (Fin.ofNat 128 (i.val + 0)) j) x =
      row (Fin.ofNat 128 (i.val + 0)) (row j x) := by
  fin_cases i
  · exact product_row_0 j x
  · exact product_row_1 j x
  · exact product_row_2 j x
  · exact product_row_3 j x
  · exact product_row_4 j x
