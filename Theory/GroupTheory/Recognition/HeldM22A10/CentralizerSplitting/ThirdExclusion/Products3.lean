set_option maxHeartbeats 1000000 in
public theorem product_rows_3 (i : Fin 32) (j : Fin 128) (x : Fin 16) :
    row (product (Fin.ofNat 128 (i.val + 96)) j) x =
      row (Fin.ofNat 128 (i.val + 96)) (row j x) := by
  fin_cases i
  · exact product_row_96 j x
  · exact product_row_97 j x
  · exact product_row_98 j x
  · exact product_row_99 j x
  · exact product_row_100 j x
  · exact product_row_101 j x
  · exact product_row_102 j x
