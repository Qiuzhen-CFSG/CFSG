set_option maxHeartbeats 1000000 in
public theorem product_rows_2 (i : Fin 32) (j : Fin 128) (x : Fin 16) :
    row (product (Fin.ofNat 128 (i.val + 64)) j) x =
      row (Fin.ofNat 128 (i.val + 64)) (row j x) := by
