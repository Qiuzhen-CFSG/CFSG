module
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.LocalModelDichotomy.ActionAlternatives.CaseFourExclusion.Ambient
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.LocalModelDichotomy.ActionAlternatives.CaseFourExclusion.Structure

/-!
# The Case IV elementary subgroup in the original centralizer

The first coordinate vector is the original central involution: it is fixed
by every marked complement generator and the centralizer has center of order
two. The projection of F to S4 is the four-group generated by a and d. Its
normalizer in S4 is the dihedral actor subgroup, so N_G(F) ∩ C_G(z) lies in
our actual coordinate Sylow subgroup T. This also gives C_G(F) = F.

Source: Janko, A characterization of the Mathieu simple groups, I,
J. Algebra 9 (1968), Section 1, printed pp.2–3.
-/

namespace Theory.GroupTheory.HeldM22A10.LocalModelDichotomy.CaseFour
open Subgroup
open scoped IsMulCommutative
universe u
variable {G : Type u} [Group G] [Finite G] (D : LocalData G)
  (K : Subgroup D.centralizer) (hK : D.kernel.IsComplement' K)
  (R : JankoCoordinates (D.binaryAction K hK) .four)

private noncomputable def markedVector : G :=
  R.ambientBasis D K hK (Multiplicative.ofAdd ![1, 0, 0, 0])

private theorem fixed_first_vector (s : SymmetricFour) :
    D.binaryAction K hK s (R.basis (Multiplicative.ofAdd ![1, 0, 0, 0])) =
      R.basis (Multiplicative.ofAdd ![1, 0, 0, 0]) := by
  let v : BinaryFour := Multiplicative.ofAdd ![1, 0, 0, 0]
  have ha : jankoSourceA .four v = v := by decide +kernel
  have hb : jankoSourceB .four v = v := by decide +kernel
  have hc : jankoSourceC v = v := by decide +kernel
  have hd : jankoSourceD .four v = v := by decide +kernel
  change D.binaryAction K hK s (R.basis v) = R.basis v
  obtain ⟨i, j, k, l, rfl⟩ := janko_decomposition s
  fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
    simp only [pow_zero, pow_succ,
      map_one, map_mul, MulAut.mul_apply, MulAut.one_apply, R.action_a, R.action_b,
      R.action_c_left, R.action_d, ha, hb, hc, hd]

/-- The source marking is the original involution, not just a new central line. -/
private theorem markedVector_eq : markedVector D K hK R = D.z := by
  let v : BinaryFour := Multiplicative.ofAdd ![1, 0, 0, 0]
  let w : D.kernel := D.kernelBinaryEquiv.symm (R.basis v)
  have hfixed (s : SymmetricFour) :
      jankoAmbientComplement D K hK s * markedVector D K hK R =
        markedVector D K hK R * jankoAmbientComplement D K hK s := by
    have h := R.ambient_conjugation_of_action D K hK s v v
      (fixed_first_vector D K hK R s⁻¹)
    have hh := congrArg (fun x => jankoAmbientComplement D K hK s * x) h
    simpa only [← mul_assoc, mul_inv_cancel, one_mul, markedVector, v] using hh.symm
  have hwcentral : (w : D.centralizer) ∈ center D.centralizer := by
    apply mem_center_iff.mpr
    intro x
    obtain ⟨⟨f, k⟩, hfk, _⟩ := hK.existsUnique x
    dsimp at hfk
    rw [← hfk]
    have hf : (f : D.centralizer) * w = w * f := by
      let := D.kernel_elementary
      exact congrArg D.kernel.subtype (mul_comm f w)
    have hk : (k : D.centralizer) * w = w * k := by
      apply Subtype.ext
      have hh := hfixed (D.complementEquiv K hK k)
      simp only [jankoAmbientComplement, MonoidHom.comp_apply,
        MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_apply] at hh
      exact hh
    calc
      (f : D.centralizer) * k * w = f * ((k : D.centralizer) * w) := mul_assoc _ _ _
      _ = f * (w * k) := by rw [hk]
      _ = w * ((f : D.centralizer) * k) := by rw [← mul_assoc, hf, mul_assoc]
  have hwne : (w : D.centralizer) ≠ 1 := by
    intro he
    have h : markedVector D K hK R = 1 := congrArg D.centralizer.subtype he
    have hv : v = 1 := (R.ambientBasis_injective D K hK)
      (h.trans (map_one _).symm)
    have hvne : v ≠ 1 := by decide +kernel
    exact hvne hv
  let wz : center D.centralizer := ⟨w, hwcentral⟩
  let zz : center D.centralizer := ⟨D.centralInvolution, D.centralInvolution_mem_center⟩
  obtain ⟨a, _, ha⟩ := (Nat.card_eq_two_iff' (1 : center D.centralizer)).mp D.center_card
  have hwz : wz ≠ 1 := fun he => hwne (congrArg Subtype.val he)
  have hzz : zz ≠ 1 := fun he => D.z_ne_one
    (congrArg (fun y : center D.centralizer => ((y : D.centralizer) : G)) he)
  exact congrArg (fun y : center D.centralizer => ((y : D.centralizer) : G))
    ((ha wz hwz).trans (ha zz hzz).symm)


public theorem into_z_zero : into D K hK R (z 0) = D.z := by
  rw [into_z]
  have hv : Multiplicative.ofAdd (Pi.single (0 : Fin 4) (1 : ZMod 2)) =
      (Multiplicative.ofAdd ![1, 0, 0, 0] : BinaryFour) := by decide +kernel
  rw [hv]
  exact markedVector_eq D K hK R

@[expose] public noncomputable def Fg : Subgroup G := F.map (into D K hK R)

public theorem Fg_le_T : Fg D K hK R ≤ T D K hK R := map_le_range _ _

public theorem Fg_card : Nat.card (Fg D K hK R) = 16 := by
  rw [Fg, card_map_of_injective (into_injective D K hK R), F_card]

public theorem T_le_normalizer_Fg : T D K hK R ≤ normalizer (Fg D K hK R : Set G) := by
  have h := F.le_normalizer_map (into D K hK R)
  rw [F.normalizer_eq_top, ← MonoidHom.range_eq_map] at h
  exact h

private noncomputable def localInto : Model →* D.centralizer :=
  (D.binarySemidirectEquiv K hK).toMonoidHom.comp (toBinary R)

private noncomputable def projection : D.centralizer →* SymmetricFour :=
  SemidirectProduct.rightHom.comp (D.binarySemidirectEquiv K hK).symm.toMonoidHom

private theorem projection_localInto (x : Model) :
    projection D K hK (localInto D K hK R x) = actor x.right := by
  change ((D.binarySemidirectEquiv K hK).symm
    ((D.binarySemidirectEquiv K hK) (toBinary R x))).right = _
  rw [MulEquiv.symm_apply_apply]
  rfl

private theorem mem_T_of_projection (x : D.centralizer)
    (hx : ∃ r : DihedralGroup 4, actor r = projection D K hK x) :
    (x : G) ∈ T D K hK R := by
  obtain ⟨r, hr⟩ := hx
  let y := (D.binarySemidirectEquiv K hK).symm x
  refine ⟨⟨R.basis.symm y.left, r⟩, ?_⟩
  change ((D.binarySemidirectEquiv K hK)
    (toBinary R ⟨R.basis.symm y.left, r⟩) : G) = x
  have he : toBinary R ⟨R.basis.symm y.left, r⟩ = y := by
    apply SemidirectProduct.ext
    · exact R.basis.apply_symm_apply _
    · exact hr
  rw [he]
  exact congrArg Subtype.val ((D.binarySemidirectEquiv K hK).apply_symm_apply x)

private def actorFour (s : SymmetricFour) : Prop :=
  s = 1 ∨ s = jankoA ∨ s = jankoD ∨ s = jankoA * jankoD
private instance (s : SymmetricFour) : Decidable (actorFour s) :=
  inferInstanceAs (Decidable (_ ∨ _ ∨ _ ∨ _))

private theorem F_actor : ∀ x : Model, x ∈ F → actorFour (actor x.right) := by
  decide +kernel

private theorem actor_normalizer : ∀ s : SymmetricFour,
    actorFour (s * jankoA * s⁻¹) → ∃ r : DihedralGroup 4, actor r = s := by
  decide +kernel

public theorem normalizer_Fg_inter_centralizer_le :
    normalizer (Fg D K hK R : Set G) ⊓ D.centralizer ≤ T D K hK R := by
  intro g hg
  apply mem_T_of_projection D K hK R ⟨g, hg.2⟩
  apply actor_normalizer
  have ha : into D K hK R a ∈ Fg D K hK R := ⟨a, F_generators.2.2.1, rfl⟩
  obtain ⟨x, hx, he⟩ := (hg.1 (into D K hK R a)).mp ha
  have he' : localInto D K hK R x =
      (⟨g, hg.2⟩ : D.centralizer) * localInto D K hK R a * ⟨g, hg.2⟩⁻¹ :=
    Subtype.ext he
  have hh := congrArg (projection D K hK) he'
  rw [map_mul, map_mul, map_inv, projection_localInto, projection_localInto] at hh
  have haa : actor a.right = jankoA := by decide +kernel
  rw [haa] at hh
  rw [← hh]
  exact F_actor x hx

/-- The coordinate Sylow subgroup lies in the original involution centralizer. -/
public theorem T_le_centralizer : T D K hK R ≤ D.centralizer := by
  rintro g ⟨x, rfl⟩
  exact (localInto D K hK R x).property

/-- The local stabilizer in the whole ambient normalizer is exactly T. -/
public theorem normalizer_Fg_inter_centralizer :
    normalizer (Fg D K hK R : Set G) ⊓ D.centralizer = T D K hK R :=
  le_antisymm (normalizer_Fg_inter_centralizer_le D K hK R)
    (le_inf (T_le_normalizer_Fg D K hK R) (T_le_centralizer D K hK R))

public theorem centralizer_Fg : centralizer (Fg D K hK R : Set G) = Fg D K hK R := by
  apply le_antisymm
  · intro g hg
    have hz : g ∈ D.centralizer := by
      apply mem_centralizer_singleton_iff.mpr
      have hzF : into D K hK R (z 0) ∈ Fg D K hK R := ⟨z 0, F_generators.1, rfl⟩
      have hh := (hg _ hzF).symm
      rwa [into_z_zero] at hh
    have hn : g ∈ normalizer (Fg D K hK R : Set G) := centralizer_le_normalizer _ hg
    obtain ⟨x, rfl⟩ := (normalizer_Fg_inter_centralizer D K hK R).le ⟨hn, hz⟩
    refine ⟨x, ?_, rfl⟩
    rw [← F_centralizer]
    intro y hy
    apply into_injective D K hK R
    simpa only [map_mul] using hg _ (show into D K hK R y ∈ Fg D K hK R from ⟨y, hy, rfl⟩)
  · let := F_elementary
    let : IsElementaryAbelian 2 (Fg D K hK R) := IsElementaryAbelian.map _
    exact le_centralizer _

public theorem T_inter_centralizer_d :
    T D K hK R ⊓ centralizer ({into D K hK R d} : Set G) = Fg D K hK R := by
  apply le_antisymm
  · rintro g ⟨⟨x, rfl⟩, hx⟩
    refine ⟨x, ?_, rfl⟩
    apply mem_centralizer_singleton_iff.mpr
    apply into_injective D K hK R
    simpa only [map_mul] using mem_centralizer_singleton_iff.mp hx
  · rintro g ⟨x, hx, rfl⟩
    refine ⟨⟨x, rfl⟩, mem_centralizer_singleton_iff.mpr ?_⟩
    simpa only [map_mul] using congrArg (into D K hK R)
      (mem_centralizer_singleton_iff.mp hx)

end Theory.GroupTheory.HeldM22A10.LocalModelDichotomy.CaseFour
