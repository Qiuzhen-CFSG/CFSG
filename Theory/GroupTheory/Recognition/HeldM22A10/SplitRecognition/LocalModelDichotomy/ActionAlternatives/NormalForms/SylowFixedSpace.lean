module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.LocalModelDichotomy.ActionAlternatives.Coordinates
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.LocalModelDichotomy.BinaryReduction
public import Mathlib.Tactic.FinCases

/-!
# The fixed space of the actual Sylow preimage

The centralizer of `(01)(23)` in S4 is the dihedral subgroup generated by
Janko's `a`, `b`, and `d`. Its preimage in the binary semidirect product is
Sylow, since the kernel has order sixteen. Vectors fixed by those three
actors embed in the center of that preimage. Thus a center of order two
bounds the common fixed space by the distinguished nonzero line.

This supplies the actual Sylow-center hypothesis in the coefficient argument
on printed p.2 of Janko, J. Algebra 9 (1968), Section 1,
DOI 10.1016/0021-8693(68)90002-1.
-/

namespace Theory.GroupTheory.HeldM22A10.LocalModelDichotomy

private def actorTwo : Subgroup SymmetricFour where
  carrier := {s | s * jankoA = jankoA * s}
  one_mem' := by simp
  mul_mem' := by decide +kernel
  inv_mem' := by decide +kernel

private instance : Fintype actorTwo :=
  inferInstanceAs (Fintype {s : SymmetricFour // s * jankoA = jankoA * s})

private def actorSylow : Sylow 2 SymmetricFour :=
  Sylow.ofCard actorTwo (by
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
    decide +kernel)

private theorem actorTwo_words : ∀ s : SymmetricFour, s ∈ actorTwo →
    ∃ i j l : Fin 2, s = jankoA ^ i.val * jankoB ^ j.val * jankoD ^ l.val := by
  change ∀ s : SymmetricFour, s * jankoA = jankoA * s → _
  decide +kernel

private def threeFixed (ρ : SymmetricFour →* MulAut BinaryFour) : Subgroup BinaryFour where
  carrier := {v | ρ jankoA v = v ∧ ρ jankoB v = v ∧ ρ jankoD v = v}
  one_mem' := by simp
  mul_mem' := by
    rintro x y ⟨ha,hb,hd⟩ ⟨ha',hb',hd'⟩
    exact ⟨by simp [map_mul, ha, ha'], by simp [map_mul, hb, hb'], by simp [map_mul, hd, hd']⟩
  inv_mem' := by
    rintro x ⟨ha,hb,hd⟩
    exact ⟨by simp [ha], by simp [hb], by simp [hd]⟩

private theorem threeFixed_actor (ρ : SymmetricFour →* MulAut BinaryFour)
    (v : threeFixed ρ) (s : actorTwo) : ρ s v = v := by
  obtain ⟨i,j,l,hs⟩ := actorTwo_words s s.property
  have ha := v.property.1
  have hb := v.property.2.1
  have hd := v.property.2.2
  rw [hs]
  fin_cases i <;> fin_cases j <;> fin_cases l <;>
    simp [map_mul, MulAut.mul_apply, ha, hb, hd]

private def productSylow (ρ : SymmetricFour →* MulAut BinaryFour) :
    Sylow 2 (BinaryFour ⋊[ρ] SymmetricFour) := by
  have hE : IsPGroup 2 BinaryFour := IsPGroup.of_card (n := 4) (by
    rw [Nat.card_eq_fintype_card]
    decide +kernel)
  have hker : IsPGroup 2 (SemidirectProduct.rightHom :
      BinaryFour ⋊[ρ] SymmetricFour →* SymmetricFour).ker := by
    rw [← SemidirectProduct.range_inl_eq_ker_rightHom]
    exact hE.of_surjective SemidirectProduct.inl.rangeRestrict
      (MonoidHom.rangeRestrict_surjective _)
  exact actorSylow.comapOfKerIsPGroup SemidirectProduct.rightHom hker (by
    rw [MonoidHom.range_eq_top.mpr SemidirectProduct.rightHom_surjective]
    exact le_top)

private def fixedToCenter (ρ : SymmetricFour →* MulAut BinaryFour) :
    threeFixed ρ → Subgroup.center (productSylow ρ) := fun v =>
  ⟨⟨SemidirectProduct.inl v, by change (1 : SymmetricFour) ∈ actorTwo; exact actorTwo.one_mem⟩, by
    apply Subgroup.mem_center_iff.mpr
    intro x
    apply Subtype.ext
    apply SemidirectProduct.ext
    · change x.val.left * ρ x.val.right v.val = v.val * ρ 1 x.val.left
      rw [map_one, MulAut.one_apply, threeFixed_actor ρ v ⟨x.val.right,x.property⟩, mul_comm]
    · simp⟩

private theorem fixedToCenter_injective (ρ : SymmetricFour →* MulAut BinaryFour) :
    Function.Injective (fixedToCenter ρ) := by
  intro x y h
  apply Subtype.ext
  exact SemidirectProduct.inl_injective (congrArg (fun z => z.val.val) h)

private theorem threeFixed_card_le (ρ : SymmetricFour →* MulAut BinaryFour)
    (hc : ∀ P : Sylow 2 (BinaryFour ⋊[ρ] SymmetricFour), Nat.card (Subgroup.center P) = 2) :
    Nat.card (threeFixed ρ) ≤ 2 := by
  let : Finite (BinaryFour ⋊[ρ] SymmetricFour) :=
    Finite.of_equiv (BinaryFour × SymmetricFour) SemidirectProduct.equivProd.symm
  have h := Nat.card_le_card_of_injective (fixedToCenter ρ) (fixedToCenter_injective ρ)
  simpa only [hc] using h


private theorem eq_one_or_eq_of_card_le_two {H : Type*} [Group H] [Finite H]
    (hc : Nat.card H ≤ 2) (z : H) (hz : z ≠ 1) (x : H) : x = 1 ∨ x = z := by
  classical
  by_contra h
  have hx1 : x ≠ 1 := fun hh => h (Or.inl hh)
  have hxz : x ≠ z := fun hh => h (Or.inr hh)
  let f : Fin 3 → H := ![1,z,x]
  have hf : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [f, Ne.symm]
  have hc' := Nat.card_le_card_of_injective f hf
  rw [Nat.card_fin] at hc'
  exact Nat.not_succ_le_self 2 (hc'.trans hc)

/-- A vector fixed by the three Sylow generators lies on the distinguished
fixed line, using the centers of the genuine Sylow preimages. -/
public theorem jankoSylow_fixed_eq_one_or
    (ρ : SymmetricFour →* MulAut BinaryFour)
    (hc : ∀ P : Sylow 2 (BinaryFour ⋊[ρ] SymmetricFour), Nat.card (Subgroup.center P) = 2)
    (z : BinaryFour) (hz : ρ jankoA z = z ∧ ρ jankoB z = z ∧ ρ jankoD z = z)
    (hz1 : z ≠ 1) (v : BinaryFour)
    (hv : ρ jankoA v = v ∧ ρ jankoB v = v ∧ ρ jankoD v = v) : v = 1 ∨ v = z := by
  have hz' : (⟨z,hz⟩ : threeFixed ρ) ≠ 1 := fun h => hz1 (congrArg Subtype.val h)
  rcases eq_one_or_eq_of_card_le_two (threeFixed_card_le ρ hc) ⟨z,hz⟩ hz'
      (⟨v,hv⟩ : threeFixed ρ) with h | h
  · exact Or.inl (congrArg Subtype.val h)
  · exact Or.inr (congrArg Subtype.val h)

end Theory.GroupTheory.HeldM22A10.LocalModelDichotomy
