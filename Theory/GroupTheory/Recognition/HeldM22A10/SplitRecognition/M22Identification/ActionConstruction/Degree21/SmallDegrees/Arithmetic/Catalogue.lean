private theorem divisor_coverage : ∀ n : Fin 666,
    n.val ∣ 443520 → n.val ∈ divisors := by decide +kernel

private theorem finite_rows : ∀ n ∈ divisors, ∀ c : Fin 5 → Fin 3,
    (128 : ℤ) ∣ (n : ℤ) + 153 * decoded c 0 - 202 * decoded c 1 +
      127 * decoded c 2 + 280 * decoded c 3 + 45 * decoded c 4 →
    0 ≤ (n : ℤ) + 15 * columnValue (decoded c) 0 →
    columnValue (decoded c) 0 < (n : ℤ) → (n, decoded c) ∈ rows := by
  decide +kernel

public theorem row_mem (n : ℕ) (c : Fin 5 → ℤ)
    (hn : n ≤ 665) (hdvd : n ∣ 443520)
    (hu : ∀ i, c i = 0 ∨ c i = 1 ∨ c i = -1)
    (hres : (128 : ℤ) ∣ (n : ℤ) + 153 * c 0 - 202 * c 1 +
      127 * c 2 + 280 * c 3 + 45 * c 4)
    (hfix : 0 ≤ (n : ℤ) + 15 * columnValue c 0)
    (hlt : columnValue c 0 < (n : ℤ)) : (n, c) ∈ rows := by
  let f (i : Fin 5) : Fin 3 := ⟨(c i + 1).toNat, by have := hu i; omega⟩
  have hf : decoded f = c := by
    funext i
    dsimp [decoded, f]
    have := hu i
    omega
  have hh := finite_rows n (divisor_coverage ⟨n, by omega⟩ hdvd) f
  rw [hf] at hh
  exact hh hres hfix hlt

public theorem signed_mem_two : ∀ r ∈ rows,
    r.2 2 ≠ 0 → signed 2 r ∈ signedRows2 := by decide +kernel
public theorem signed_mem_zero : ∀ r ∈ rows,
    r.2 0 ≠ 0 → (r.2 2 = 0 ∨ r.1 = 55 ∨ r.1 = 154 ∨ r.1 = 210) →
    signed 0 r ∈ signedRows0 := by decide +kernel
public theorem signed_mem_one : ∀ r ∈ rows,
    r.2 1 ≠ 0 → (r.2 2 = 0 ∨ r.1 = 55 ∨ r.1 = 154 ∨ r.1 = 210) →
    signed 1 r ∈ signedRows1 := by decide +kernel

