module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.M22Identification.OrderRecognition.LocalAnalysis.ClassDistributions.Model
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.M22Identification.ActionConstruction.CharacterData

/-!
# Exhausting the even classes for the degree-21 character

The seven ambient conjugacy classes counted in the involution centralizer are
disjoint and their counts sum to 384, so they cover it. Every even-order
element has an involutory power; fusion transports that element into the
marked centralizer. This proves the even-order spectrum without any character
hypothesis, and transports a class function's seven local values to all even
classes and the order-three class.

`HasLocalValues` specifies the literal marked elements under the given model
isomorphism. Its existence for an irreducible character is still required;
the numerical row here is not a character construction.

Source: Z. Janko, *A characterization of the Mathieu simple groups, I*,
J. Algebra 9 (1968), Sections 5 and 7, especially the degree-21 row on p.16,
DOI 10.1016/0021-8693(68)90002-1.
-/

open Subgroup
namespace Theory.GroupTheory.HeldM22A10.M22Identification.ActionConstruction.Degree21
open LocalModelDichotomy CaseII
universe u
variable {G : Type u} [Group G]

private theorem conj_order {x y : G} (h : IsConj x y) : orderOf x = orderOf y := by
  obtain ⟨g, hg⟩ := isConj_iff.mp h
  have hy : (MulAut.conj g) x = y := hg
  rw [← hy]
  exact ((MulAut.conj g).orderOf_eq x).symm

/-- The seven marked elements have the source orders in the ambient group. -/
public theorem representative_order (D : LocalData G)
    (k : TwistedModel ≃* D.centralizer) (i : Fin 7) :
    orderOf (into D k (classRepresentative i)) = ![1, 2, 3, 4, 4, 6, 8] i := by
  rw [orderOf_injective (into D k) (into_injective D k),
    Distribution.classRepresentative_order]

/-- Distinct marked classes stay distinct: orders separate all but the two
order-four classes, which are separated by the local analysis. -/
public theorem representatives_separated (D : LocalData G)
    (k : TwistedModel ≃* D.centralizer) (L : LocalAnalysisData D k)
    {i j : Fin 7}
    (h : IsConj (into D k (classRepresentative i)) (into D k (classRepresentative j))) :
    i = j := by
  have ho := conj_order h
  rw [representative_order, representative_order] at ho
  have hf : ∀ i j : Fin 7, ![1, 2, 3, 4, 4, 6, 8] i = ![1, 2, 3, 4, 4, 6, 8] j →
      i = j ∨ (i = 3 ∧ j = 4) ∨ (i = 4 ∧ j = 3) := by decide
  rcases hf i j ho with hij | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact hij
  · exact False.elim (L.four_not_fused h)
  · exact False.elim (L.four_not_fused h.symm)

variable [Finite G]

/-- The seven disjoint class fibers exhaust the centralizer because their
cardinalities sum to its order 384. -/
public theorem centralizer_covered (D : LocalData G)
    (k : TwistedModel ≃* D.centralizer) (L : LocalAnalysisData D k)
    (x : D.centralizer) :
    ∃ i : Fin 7, IsConj (x : G) (into D k (classRepresentative i)) := by
  classical
  let := Fintype.ofFinite D.centralizer
  let T (i : Fin 7) := {x : D.centralizer // IsConj (x : G) (into D k (classRepresentative i))}
  let f : (Σ i, T i) → D.centralizer := fun x => x.2.1
  have hf : Function.Injective f := by
    rintro ⟨i, x, hx⟩ ⟨j, y, hy⟩ h
    have hxy : x = y := h
    subst y
    have hij : i = j := representatives_separated D k L (hx.symm.trans hy)
    subst j
    rfl
  have hc : ∀ i, Fintype.card (T i) = ![1, 51, 32, 84, 72, 96, 48] i := by
    intro i
    rw [← Nat.card_eq_fintype_card]
    exact L.centralizer_distribution i
  have hcard : Fintype.card (Σ i, T i) = Fintype.card D.centralizer := by
    rw [Fintype.card_sigma, ← Nat.card_eq_fintype_card, D.centralizer_card]
    simp [hc, Fin.sum_univ_succ]
  have hs := ((Fintype.bijective_iff_injective_and_card f).mpr ⟨hf, hcard⟩).surjective
  obtain ⟨⟨i, y, hy⟩, hxy⟩ := hs x
  exact ⟨i, by simpa only [show y = x from hxy] using hy⟩

/-- Conjugate the unique involution in the cyclic group generated by an
even-order element to the marked involution, transporting the element with it. -/
public theorem even_conjugate_into_centralizer (D : LocalData G)
    (k : TwistedModel ≃* D.centralizer) (L : LocalAnalysisData D k)
    (g : G) (hg : Even (orderOf g)) :
    ∃ x : D.centralizer, IsConj g (x : G) := by
  have ht : orderOf (g ^ (orderOf g / 2)) = 2 :=
    orderOf_pow_orderOf_div (ne_of_gt (orderOf_pos g)) (even_iff_two_dvd.mp hg)
  obtain ⟨a, ha⟩ := isConj_iff.mp (L.involution_fusion _ ht)
  let e := MulAut.conj a
  have he : e (g ^ (orderOf g / 2)) = D.z := ha
  have hc : e g ∈ D.centralizer := by
    apply mem_centralizer_singleton_iff.mpr
    rw [← he]
    exact ((Commute.refl g).pow_right (orderOf g / 2)).map e |>.eq
  exact ⟨⟨e g, hc⟩, isConj_iff.mpr ⟨a, rfl⟩⟩

/-- The local columns of Janko's degree-21 row, in `classRepresentative` order. -/
@[expose] public def localValues : Fin 7 → ℂ := ![21, 5, 3, 1, 1, -1, -1]

/-- Specifying values at the actual marked elements, not merely a numerical row. -/
@[expose] public def HasLocalValues (D : LocalData G)
    (k : TwistedModel ≃* D.centralizer) (χ : ClassFunction G) : Prop :=
  ∀ i : Fin 7, χ (into D k (classRepresentative i)) = localValues i

omit [Finite G] in
/-- The identity column gives the degree in the original ambient group. -/
public theorem HasLocalValues.degree {D : LocalData G}
    {k : TwistedModel ≃* D.centralizer} {χ : ClassFunction G}
    (h : HasLocalValues D k χ) : χ 1 = 21 := by
  simpa [HasLocalValues, classRepresentative, localValues] using h 0

omit [Finite G] in
private theorem class_value {χ : ClassFunction G} (hχ : IsClassFunction χ)
    {x y : G} (h : IsConj x y) : χ x = χ y := by
  obtain ⟨a, rfl⟩ := isConj_iff.mp h
  exact (hχ x a).symm

/-- The local row determines every even-order value, and excludes all
even orders other than 2, 4, 6, and 8. -/
public theorem even_values (D : LocalData G)
    (k : TwistedModel ≃* D.centralizer) (L : LocalAnalysisData D k)
    {χ : ClassFunction G} (hχ : IsClassFunction χ) (hloc : HasLocalValues D k χ)
    (g : G) (hg : Even (orderOf g)) :
    (orderOf g = 2 ∧ χ g = 5) ∨ (orderOf g = 4 ∧ χ g = 1) ∨
    (orderOf g = 6 ∧ χ g = -1) ∨ (orderOf g = 8 ∧ χ g = -1) := by
  obtain ⟨x, hx⟩ := even_conjugate_into_centralizer D k L g hg
  obtain ⟨i, hi⟩ := centralizer_covered D k L x
  have hgi := hx.trans hi
  have ho := (conj_order hgi).trans (representative_order D k i)
  have hv := (class_value hχ hgi).trans (hloc i)
  fin_cases i <;> norm_num [localValues] at ho hv <;> simp_all [even_iff_two_dvd]

/-- The even-order exclusion needs no character or ambient-order hypothesis. -/
public theorem even_orders (D : LocalData G)
    (k : TwistedModel ≃* D.centralizer) (L : LocalAnalysisData D k)
    (g : G) (hg : Even (orderOf g)) : orderOf g ∈ ({2, 4, 6, 8} : Finset ℕ) := by
  obtain ⟨x, hx⟩ := even_conjugate_into_centralizer D k L g hg
  obtain ⟨i, hi⟩ := centralizer_covered D k L x
  have ho := (conj_order (hx.trans hi)).trans (representative_order D k i)
  fin_cases i <;> norm_num at ho <;> simp_all [even_iff_two_dvd]

/-- The missing odd-order spectrum combines with the proved even-order bound. -/
public theorem orders_of_odd_orders (D : LocalData G)
    (k : TwistedModel ≃* D.centralizer) (L : LocalAnalysisData D k)
    (hodd : ∀ g : G, Odd (orderOf g) →
      orderOf g ∈ ({1, 3, 5, 7, 11} : Finset ℕ)) (g : G) :
    orderOf g ∈ ({1, 2, 3, 4, 5, 6, 7, 8, 11} : Finset ℕ) := by
  by_cases h : Even (orderOf g)
  · have ho := even_orders D k L g h
    simp only [Finset.mem_insert, Finset.mem_singleton] at ho ⊢
    tauto
  · have ho := hodd g (Nat.not_even_iff_odd.mp h)
    simp only [Finset.mem_insert, Finset.mem_singleton] at ho ⊢
    tauto

omit [Finite G] in
/-- The single order-three class carries the specified local value. -/
public theorem value_at_three (D : LocalData G)
    (k : TwistedModel ≃* D.centralizer) (L : LocalAnalysisData D k)
    {χ : ClassFunction G} (hχ : IsClassFunction χ) (hloc : HasLocalValues D k χ)
    (g : G) (hg : orderOf g = 3) : χ g = 3 := by
  have hc := class_value hχ (L.three_fusion g hg)
  have hv := hloc 2
  change χ (into D k c) = 3 at hv
  exact hc.trans hv

end Theory.GroupTheory.HeldM22A10.M22Identification.ActionConstruction.Degree21
