module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.M22Identification.OrderRecognition.LocalAnalysis.Contracts
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.M22Identification.OrderRecognition.LocalAnalysis.Elementary

/-!
# The Sylow subgroup and the two local complements in Case II

The inverse image of the centralizer of `(01)(23)` in S4 has order 128.
The actor subgroup complements E; the eight source words generated by
`z 1 * z 2`, `z 3`, and `b` complement F. The normalizer of F in the
centralizer model is exactly this Sylow subgroup. For the last statement,
it suffices to test the conjugate of `d`: F is abelian and equals C(d).

Source: Z. Janko, *A characterization of the Mathieu simple groups, I*,
J. Algebra 9 (1968), Section 2, p.4. Indices here are zero-based.
-/

open Subgroup
namespace Theory.GroupTheory.HeldM22A10.M22Identification.CaseII
open LocalModelDichotomy
local instance : DecidableEq TwistedModel := fun x y =>
  decidable_of_iff (x.left = y.left ∧ x.right = y.right) SemidirectProduct.ext_iff.symm
local instance : Fintype TwistedModel := Fintype.ofEquiv
  (BinaryFour × SymmetricFour) SemidirectProduct.equivProd.symm
local instance : DecidablePred (· ∈ modelE) := fun x =>
  inferInstanceAs (Decidable (x.right = 1))
local instance : DecidablePred (· ∈ modelF) := fun x =>
  decidable_of_iff (x * d = d * x) mem_centralizer_singleton_iff.symm

/-- The source Sylow subgroup in the coordinate centralizer. -/
@[expose] public def modelT : Subgroup TwistedModel :=
  (centralizer ({a.right} : Set SymmetricFour)).comap SemidirectProduct.rightHom
local instance : DecidablePred (· ∈ modelT) := fun x =>
  decidable_of_iff (x.right * a.right = a.right * x.right) mem_centralizer_singleton_iff.symm

public theorem modelT_card : Nat.card modelT = 128 := by
  rw [Nat.card_eq_fintype_card]
  decide +kernel
public theorem modelE_le_modelT : modelE ≤ modelT := by
  change ∀ x, x ∈ modelE → x ∈ modelT
  decide +kernel
public theorem modelF_le_modelT : modelF ≤ modelT := by
  change ∀ x, x ∈ modelF → x ∈ modelT
  decide +kernel

private def fWord (r : Fin 2 × Fin 2 × Fin 2) : TwistedModel :=
  (z 1 * z 2) ^ r.1.val * z 3 ^ r.2.1.val * b ^ r.2.2.val

/-- The eight words in the source complement to F. -/
public def modelFComplement : Subgroup TwistedModel where
  carrier := Set.range fWord
  one_mem' := by exact ⟨⟨0,0,0⟩, by decide +kernel⟩
  mul_mem' := by
    rintro x y ⟨r, rfl⟩ ⟨s, rfl⟩
    have h : ∀ r s, ∃ t, fWord t = fWord r * fWord s := by decide +kernel
    exact h r s
  inv_mem' := by
    rintro x ⟨r, rfl⟩
    have h : ∀ r, ∃ t, fWord t = (fWord r)⁻¹ := by decide +kernel
    exact h r
local instance : DecidablePred (· ∈ modelFComplement) := fun x =>
  inferInstanceAs (Decidable (∃ r, fWord r = x))
public theorem modelFComplement_card : Nat.card modelFComplement = 8 := by
  rw [Nat.card_eq_fintype_card]
  decide +kernel
public theorem modelFComplement_le_modelT : modelFComplement ≤ modelT := by
  change ∀ x, x ∈ modelFComplement → x ∈ modelT
  decide +kernel
public theorem modelFComplement_inf : modelF ⊓ modelFComplement = ⊥ := by
  ext x
  have h : ∀ x, (x ∈ modelF ∧ x ∈ modelFComplement) ↔ x = 1 := by decide +kernel
  exact h x

/-- The actor complement to E inside the coordinate Sylow subgroup. -/
public def modelEComplement : Subgroup TwistedModel where
  carrier := {x | x.left = 1 ∧ x ∈ modelT}
  one_mem' := ⟨rfl, modelT.one_mem⟩
  mul_mem' := by
    intro x y hx hy
    refine ⟨?_, modelT.mul_mem hx.2 hy.2⟩
    simp [SemidirectProduct.mul_left, hx.1, hy.1]
  inv_mem' := by
    intro x hx
    refine ⟨?_, modelT.inv_mem hx.2⟩
    simp [SemidirectProduct.inv_left, hx.1]
local instance : DecidablePred (· ∈ modelEComplement) := fun x =>
  inferInstanceAs (Decidable (x.left = 1 ∧ x ∈ modelT))
public theorem modelEComplement_card : Nat.card modelEComplement = 8 := by
  rw [Nat.card_eq_fintype_card]
  decide +kernel
public theorem modelEComplement_inf : modelE ⊓ modelEComplement = ⊥ := by
  ext x
  have h : ∀ x, (x ∈ modelE ∧ x ∈ modelEComplement) ↔ x = 1 := by decide +kernel
  exact h x


public theorem modelEComplement_le_modelT : modelEComplement ≤ modelT := fun _ h => h.2

public theorem modelE_complement : (modelE.subgroupOf modelT).IsComplement'
    (modelEComplement.subgroupOf modelT) := by
  apply isComplement'_of_card_mul_and_disjoint
  · rw [Nat.card_congr (subgroupOfEquivOfLe modelE_le_modelT).toEquiv,
      Nat.card_congr (subgroupOfEquivOfLe modelEComplement_le_modelT).toEquiv,
      modelE_card, modelEComplement_card, modelT_card]
  · rw [disjoint_iff]
    ext x
    change ((x : TwistedModel) ∈ modelE ⊓ modelEComplement) ↔ x = 1
    rw [modelEComplement_inf, mem_bot]
    exact ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩

public theorem modelF_complement : (modelF.subgroupOf modelT).IsComplement'
    (modelFComplement.subgroupOf modelT) := by
  apply isComplement'_of_card_mul_and_disjoint
  · rw [Nat.card_congr (subgroupOfEquivOfLe modelF_le_modelT).toEquiv,
      Nat.card_congr (subgroupOfEquivOfLe modelFComplement_le_modelT).toEquiv,
      modelF_card, modelFComplement_card, modelT_card]
  · rw [disjoint_iff]
    ext x
    change ((x : TwistedModel) ∈ modelF ⊓ modelFComplement) ↔ x = 1
    rw [modelFComplement_inf, mem_bot]
    exact ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩

private theorem modelF_normalizer_test : ∀ x : TwistedModel,
    x * d * x⁻¹ ∈ modelF ↔ x ∈ modelT := by decide +kernel

public theorem modelF_normalizer : normalizer (modelF : Set TwistedModel) = modelT := by
  have hclosed (x : modelT) (y : modelF) :
      (x : TwistedModel) * y * (x : TwistedModel)⁻¹ ∈ modelF := by
    let := modelF_elementary
    have hd := (modelF_normalizer_test (x : TwistedModel)⁻¹).mpr
      (modelT.inv_mem x.property)
    have hc : Commute (y : TwistedModel) ((MulAut.conj (x : TwistedModel)⁻¹) d) :=
      setLike_mul_comm y.property hd
    apply mem_centralizer_singleton_iff.mpr
    simpa [MulAut.conj_apply, mul_assoc] using (hc.map (MulAut.conj (x : TwistedModel))).eq
  apply le_antisymm
  · intro x hx
    exact (modelF_normalizer_test x).mp
      ((mem_normalizer_iff.mp hx d).mp modelF_generators.2.2.2)
  · intro x hx
    apply mem_normalizer_iff.mpr
    intro y
    constructor
    · intro hy
      exact hclosed ⟨x,hx⟩ ⟨y,hy⟩
    · intro hy
      simpa [mul_assoc] using hclosed ⟨x⁻¹, modelT.inv_mem hx⟩ ⟨x*y*x⁻¹,hy⟩

end Theory.GroupTheory.HeldM22A10.M22Identification.CaseII
