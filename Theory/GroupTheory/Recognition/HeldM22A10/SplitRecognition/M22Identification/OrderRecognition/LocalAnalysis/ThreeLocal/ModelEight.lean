module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.M22Identification.OrderRecognition.LocalAnalysis.Elementary

/-!
# The self-centralizing elementary eight-group in Case II

Janko's subgroup `H* = ⟨z₁,a,b⟩` is the common centralizer of `a,b`
in the twisted local model. Its eight elements have explicit binary
coordinates. The generators show that it centralizes itself and that
its entire centralizer is itself. Since it contains the marked
involution, the ambient centralizer computation reduces to this model
computation.

The local normalizer is determined by the images of `a,b`: the remaining
generator `z₁` is central. Counting this two-generator predicate gives
local normalizer order 192. The ambient normalizer enlargement and the
order-21 subgroup still require the global involution-fusion argument.

Source: Z. Janko, *A characterization of the Mathieu simple groups, I*,
J. Algebra 9 (1968), Section 4, p.8, Lemma 9.
-/

open Subgroup
namespace Theory.GroupTheory.HeldM22A10.M22Identification.CaseII
open Theory.GroupTheory.HeldM22A10.LocalModelDichotomy
open Theory.GroupTheory.HeldM22A10
local instance : DecidableEq TwistedModel := fun x y =>
  decidable_of_iff (x.left = y.left ∧ x.right = y.right) SemidirectProduct.ext_iff.symm
local instance : Fintype TwistedModel := Fintype.ofEquiv
  (BinaryFour × SymmetricFour) SemidirectProduct.equivProd.symm

/-- The common centralizer of the two Klein-four actors in the local model. -/
@[expose] public def modelHstar : Subgroup TwistedModel := centralizer {a, b}
local instance : DecidablePred (· ∈ modelHstar) := fun x =>
  decidable_of_iff (a * x = x * a ∧ b * x = x * b) (by simp [modelHstar, mem_centralizer_iff])
/-- The common centralizer is elementary abelian of exponent two. -/
public theorem modelHstar_elementary : IsElementaryAbelian 2 modelHstar := by
  have h : ∀ x : modelHstar, x ^ 2 = 1 := by
    have h' : ∀ x : modelHstar, (x : TwistedModel) ^ 2 = 1 := by decide +kernel
    exact fun x => Subtype.ext (h' x)
  exact { is_comm.comm := fun x y => (Commute.of_orderOf_dvd_two
            (fun x => orderOf_dvd_of_pow_eq_one (h x)) x y).eq
          exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr h }
/-- The three source generators belong to the common centralizer. -/
public theorem modelHstar_generators : z 0 ∈ modelHstar ∧ a ∈ modelHstar ∧ b ∈ modelHstar := by decide +kernel
/-- Every element is a binary word in the three source generators. -/
public theorem modelHstar_expansion : ∀ x : modelHstar, ∃ r : Fin 3 → Fin 2,
    (x : TwistedModel) = z 0 ^ (r 0).val * a ^ (r 1).val * b ^ (r 2).val := by decide +kernel
/-- There are exactly eight such elements. -/
public theorem modelHstar_card : Nat.card modelHstar = 8 := by
  rw [Nat.card_eq_fintype_card]
  decide +kernel
/-- The common centralizer is exactly the source subgroup generated by `z₁,a,b`. -/
public theorem modelHstar_eq_closure : modelHstar = closure {z 0, a, b} := by
  apply le_antisymm
  · intro x hx
    obtain ⟨r, hr⟩ := modelHstar_expansion ⟨x, hx⟩
    change x = _ at hr
    rw [hr]
    exact mul_mem (mul_mem (pow_mem (subset_closure (by simp)) _)
      (pow_mem (subset_closure (by simp)) _)) (pow_mem (subset_closure (by simp)) _)
  · apply (closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact modelHstar_generators.1
    · exact modelHstar_generators.2.1
    · exact modelHstar_generators.2.2
/-- The elementary eight-group is self-centralizing in the local model. -/
public theorem modelHstar_centralizer : centralizer (modelHstar : Set TwistedModel) = modelHstar := by
  apply le_antisymm
  · intro x hx
    apply mem_centralizer_iff.mpr
    intro y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
    rcases hy with rfl | rfl
    · exact hx _ modelHstar_generators.2.1
    · exact hx _ modelHstar_generators.2.2
  · let := modelHstar_elementary
    exact le_centralizer modelHstar

/-- Testing the two noncentral generators suffices for normalization. -/
public theorem modelHstar_normalizer_iff (x : TwistedModel) :
    x ∈ normalizer (modelHstar : Set TwistedModel) ↔
      x * a * x⁻¹ ∈ modelHstar ∧ x * b * x⁻¹ ∈ modelHstar := by
  constructor
  · intro hx
    exact ⟨(hx a).mp modelHstar_generators.2.1,
      (hx b).mp modelHstar_generators.2.2⟩
  · intro hx
    rw [mem_normalizer_iff_map_conj_eq]
    apply Subgroup.eq_of_le_of_card_ge
    · rw [map_le_iff_le_comap]
      nth_rw 1 [modelHstar_eq_closure]
      apply (closure_le _).mpr
      intro y hy
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
      rcases hy with rfl | rfl | rfl
      · change x * z 0 * x⁻¹ ∈ modelHstar
        have hz := mem_center_iff.mp z_zero_mem_center x
        rw [hz, mul_inv_cancel_right]
        exact modelHstar_generators.1
      · exact hx.1
      · exact hx.2
    · rw [card_map_of_injective (MulAut.conj x).injective]

/-- The normalizer inside the involution-centralizer model has order 192. -/
public theorem modelHstar_normalizer_card :
    Nat.card (normalizer (modelHstar : Set TwistedModel)) = 192 := by
  rw [Nat.card_congr (Equiv.subtypeEquivRight modelHstar_normalizer_iff),
    Nat.card_eq_fintype_card]
  decide +kernel

variable {G : Type*} [Group G] (D : LocalData G)
  (k : TwistedModel ≃* D.centralizer)

/-- The actual ambient subgroup corresponding to Janko's `H*`. -/
@[expose] public def Hstar : Subgroup G := modelHstar.map (into D k)

/-- The ambient image has the original source generators. -/
public theorem Hstar_eq_closure :
    Hstar D k = closure {into D k (z 0), into D k a, into D k b} := by
  rw [Hstar, modelHstar_eq_closure, MonoidHom.map_closure]
  congr 1
  simp only [Set.image_insert_eq, Set.image_singleton]

/-- The actual ambient subgroup is elementary abelian. -/
public theorem Hstar_elementary : IsElementaryAbelian 2 (Hstar D k) := by
  let := modelHstar_elementary
  exact IsElementaryAbelian.map (into D k)

/-- Its order is eight. -/
public theorem Hstar_card : Nat.card (Hstar D k) = 8 := by
  rw [Hstar, card_map_of_injective (into_injective D k)]
  exact modelHstar_card

/-- Containing the marked involution makes its ambient centralizer itself. -/
public theorem Hstar_centralizer [Finite G] : centralizer (Hstar D k : Set G) = Hstar D k := by
  rw [Hstar, centralizer_map D k modelHstar modelHstar_generators.1, modelHstar_centralizer]

/-- The subgroup lies in the given involution centralizer. -/
public theorem Hstar_le_centralizer : Hstar D k ≤ D.centralizer := by
  rintro x ⟨y, hy, rfl⟩
  exact (k y).property

/-- The distinguished involution belongs to the subgroup. -/
public theorem z_mem_Hstar [Finite G] : D.z ∈ Hstar D k := by
  rw [← into_z_zero D k]
  exact mem_map_of_mem (into D k) modelHstar_generators.1

end Theory.GroupTheory.HeldM22A10.M22Identification.CaseII
