module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.M22Identification.PermutationData
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.M22Identification.JankoModel

/-!+# The four terminal permutations in Janko's argument

These are the first and third permutations on p.18 of Janko,
*A characterization of the Mathieu simple groups, I*, J. Algebra 9 (1968).
The second and fourth are already defined in `JankoModel`. All permutations
use left composition, with the label 22 represented by 0 in `Fin 22`.

The square conditions record the coordinate choice preceding the finite
enumeration. They are conditions on actual permutations, not recognition
assumptions. Their construction and the enumeration remain separate proofs.
-/

namespace Theory.GroupTheory.HeldM22A10.M22Identification.PermutationClassification

open JankoModel

/-- The first rejected candidate on Janko's p.18. -/
@[expose] public def n1 : Equiv.Perm (Fin 22) :=
  Equiv.swap 11 22 * Equiv.swap 1 12 * List.formPerm [10, 7, 2, 6] *
    List.formPerm [21, 18, 13, 17] * List.formPerm [4, 16, 3, 20] *
    List.formPerm [5, 14, 9, 15]

/-- The third rejected candidate on Janko's p.18. -/
@[expose] public def n3 : Equiv.Perm (Fin 22) :=
  Equiv.swap 11 22 * Equiv.swap 7 18 * List.formPerm [4, 5, 3, 9] *
    List.formPerm [15, 16, 14, 20] * List.formPerm [2, 21, 8, 17] *
    List.formPerm [10, 19, 6, 13]

/-- The exact order and fixed-point restriction on a permutation. -/
@[expose] public def HasAllowedProfile (g : Equiv.Perm (Fin 22)) : Prop :=
  (orderOf g, (Finset.univ.filter (fun x => g x = x)).card) ∈ allowedOrderFixedPairs

/-- The coordinate choice for the square of the order-four generator. -/
@[expose] public def SquareNormalized (n : Equiv.Perm (Fin 22)) : Prop :=
  (n ^ 2) 1 = 1 ∧ (n ^ 2) 3 = 4 ∧ (n ^ 2) 5 = 9 ∧
    (n ^ 2) 11 = 11 ∧ (n ^ 2) 22 = 22

/-- The concrete coordinate conditions used before Janko's four-case check.
Producing this data requires choosing coordinates for the 11:5 subgroup and
then adjusting the order-four generator; it does not assert a candidate. -/
public structure NormalizedGenerators (H : Subgroup (Equiv.Perm (Fin 22))) where
  n : Equiv.Perm (Fin 22)
  ell_mem : ell ∈ H
  m_mem : m ∈ H
  n_mem : n ∈ H
  n_order : orderOf n = 4
  n_fixed : (Finset.univ.filter (fun x => n x = x)).card = 2
  square_fixed : (Finset.univ.filter (fun x => (n ^ 2) x = x)).card = 6
  conjugates_m : n * m * n⁻¹ = m ^ 2
  square_normalized : SquareNormalized n

/-- The group generated by the first candidate and the fixed 11:5 subgroup. -/
@[expose] public def firstModel : Subgroup (Equiv.Perm (Fin 22)) :=
  Subgroup.closure {ell, m, n1}

/-- The group generated by the third candidate and the fixed 11:5 subgroup. -/
@[expose] public def thirdModel : Subgroup (Equiv.Perm (Fin 22)) :=
  Subgroup.closure {ell, m, n3}

end Theory.GroupTheory.HeldM22A10.M22Identification.PermutationClassification
