module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.Fusion.AdditionalFusion.Tables
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.SourceChecks
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.Coordinates
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.Fusion.AmbientGeometry
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.Fusion.Bounds

/-!
# The normalizer-action contradiction in Held Lemma 2.6

Assume pi is fused to mu, lambda and the five additional representatives are
not fused to pi, and an explicit element normalizing M carries pi to mu.
The local class table gives the seven-point pi orbit, so orbit-stabilizer
and C_G(pi) = H give |N_G(M)| = 384 * 7.

The subgroup generated by pi, mu and mu' consists of the identity and the
seven pi-fused elements of M. It is therefore invariant under N_G(M).
Its ambient centralizer is M, so the actual conjugation action induces a
faithful action of N_G(M)/M on this subgroup.

The two local four-point classes outside the even flips give xi an orbit
of size four or eight. The local xi centralizer of order 96 rules out eight.
Cauchy's theorem now supplies an order-seven element in C_N(xi). Its induced
permutation on the four-point xi orbit has order dividing both seven and
24, and hence fixes every point. The four local xi conjugates generate M,
whose ambient centralizer is M itself. Thus the order-seven element lies
in M of order sixteen, a contradiction.

This last argument replaces the source's PSL(2,7) identification and explicit
seven-cycle by the equivalent faithful action on the four xi generators.
The public final helper retains the supplied order-three actor and both
source conjugation equations; only its normalization and pi-to-mu equation
are needed after that actor has been constructed. No simplicity assumption
beyond the supplied local data is needed for this conditional argument.

Source: D. Held, "A Characterization of some multiply transitive permutation
groups, I", Illinois J. Math. 13 (1969), 224--240,
DOI 10.1215/ijm/1256053756, first paragraph of Lemma 2.6, p.228.
Source conjugation is x^g = g^-1*x*g. The normalizer actions below use Lean's
left conjugation g*x*g^-1; the supplied actor is inverted when needed.
-/

open Subgroup Equiv
namespace Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.Fusion
open Coordinates

private theorem even_mul_table : ∀ (a b : BaseCode),
    elementaryWord 0 (a + b) = elementaryWord 0 a * elementaryWord 0 b := by
  decide +kernel

/-- The eight even pair flips in the concrete centralizer. -/
@[expose] public def modelEvenFlip : Subgroup H where
  carrier := {x | ∃ a : BaseCode, a.2.2.2 = 0 ∧ elementaryWord 0 a = x}
  one_mem' := ⟨0, rfl, by decide +kernel⟩
  mul_mem' := by
    rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
    exact ⟨a + b, by change a.2.2.2 + b.2.2.2 = 0; rw [ha, hb]; rfl,
      even_mul_table a b⟩
  inv_mem' := by
    rintro _ ⟨a, ha, rfl⟩
    refine ⟨a, ha, ?_⟩
    have h : ∀ a : BaseCode, elementaryWord 0 a = (elementaryWord 0 a)⁻¹ := by
      decide +kernel
    exact h a

public theorem modelEvenFlip_generate :
    closure (Set.range evenFlipGenerator) = modelEvenFlip := by
  apply le_antisymm
  · rw [closure_le]
    rintro _ ⟨i, rfl⟩
    have h : ∀ i, ∃ a : BaseCode, a.2.2.2 = 0 ∧ elementaryWord 0 a = evenFlipGenerator i := by
      decide +kernel
    exact h i
  · rintro x ⟨a, ha, rfl⟩
    let K := closure (Set.range evenFlipGenerator)
    have hm (j : Fin 3) : evenFlipGenerator j ∈ K := subset_closure ⟨j, rfl⟩
    change pi ^ a.1.val * mu ^ a.2.1.val * mup ^ a.2.2.1.val * xi ^ a.2.2.2.val ∈ K
    rw [ha]
    simpa [evenFlipGenerator] using K.mul_mem (K.mul_mem (K.pow_mem (hm 0) _) (K.pow_mem (hm 1) _))
      (K.pow_mem (hm 2) _)

public theorem modelEvenFlip_le : modelEvenFlip ≤ modelM := by
  rintro _ ⟨a, _, rfl⟩
  exact (mem_elementary 0 _).mpr ⟨a, rfl⟩

private theorem elementaryWord_zero_iff (a : BaseCode) : elementaryWord 0 a = 1 ↔ a = 0 := by
  have h : ∀ a : BaseCode, elementaryWord 0 a = 1 ↔ a = 0 := by decide +kernel
  exact h a

public theorem mem_modelEvenFlip_word (a : BaseCode) :
    elementaryWord 0 a ∈ modelEvenFlip ↔ a.2.2.2 = 0 := by
  constructor
  · rintro ⟨b, hb, he⟩
    have he' : b = a := (elementaryWord_bijective 0).injective (Subtype.ext he)
    simpa [he'] using hb
  · exact fun ha => ⟨a, ha, rfl⟩

private theorem elementaryClass_M_cases : ∀ a : BaseCode,
    elementaryClass 0 a = 0 ∨ elementaryClass 0 a = 1 ∨ elementaryClass 0 a = 2 ∨
      elementaryClass 0 a = 6 ∨ elementaryClass 0 a = 7 := by decide +kernel

private theorem xi_selected_count : ∀ b : Bool,
    Fintype.card {a : BaseCode // elementaryClass 0 a = 6 ∨
      (elementaryClass 0 a = 7 ∧ b = true)} = if b then 8 else 4 := by decide +kernel

private theorem local_xi_count (p : H → Prop)
    (hconj : ∀ g x, p (g * x * g⁻¹) ↔ p x)
    (h1 : ¬ p 1) (hp : ¬ p pi) (hm : ¬ p mu) (hx : p xi) :
    Nat.card {a : BaseCode // p (elementaryWord 0 a)} = 4 ∨
      Nat.card {a : BaseCode // p (elementaryWord 0 a)} = 8 := by
  classical
  let b := decide (p (pi * xi))
  have he (a : BaseCode) : p (elementaryWord 0 a) ↔
      elementaryClass 0 a = 6 ∨ (elementaryClass 0 a = 7 ∧ b = true) := by
    obtain ⟨g, hg⟩ := isConj_iff.mp (elementaryWord_isConj 0 a)
    have h : p (elementaryWord 0 a) ↔ p (localRepresentative (elementaryClass 0 a)) := by
      rw [← hg]; exact hconj _ _
    rw [h]
    rcases elementaryClass_M_cases a with hc | hc | hc | hc | hc <;>
      simp [hc, localRepresentative, h1, hp, hm, hx, b]
  have hc : Nat.card {a : BaseCode // p (elementaryWord 0 a)} =
      Nat.card {a : BaseCode // elementaryClass 0 a = 6 ∨
        (elementaryClass 0 a = 7 ∧ b = true)} :=
    Nat.card_congr (Equiv.subtypeEquiv (Equiv.refl BaseCode) he)
  rw [hc, Nat.card_eq_fintype_card, xi_selected_count]
  cases b <;> simp

universe u
variable {G : Type u} [Group G] [Finite G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer)

public abbrev mNormalizer := normalizer (ambientElementary D e 0 : Set G)
@[expose] public def mPiPoint : ambientElementary D e 0 :=
  ⟨D.z, z_mem_ambientElementary D e 0⟩
@[expose] public noncomputable def mXiPoint : ambientElementary D e 0 :=
  ⟨D.a10ModelEmbedding e xi, mem_map_of_mem _ (elementaryGenerators_mem 0 3)⟩

private noncomputable def mWordEquiv : BaseCode ≃ ambientElementary D e 0 :=
  (Equiv.ofBijective _ (elementaryWord_bijective 0)).trans
    ((elementary 0).equivMapOfInjective (D.a10ModelEmbedding e)
      (D.a10ModelEmbedding_injective e)).toEquiv

private def mInOrbit (x y : G) : Prop :=
  ∃ n : mNormalizer D e, (n : G) * x * (n : G)⁻¹ = y

omit [Finite G] in
private theorem mInOrbit_iff (x y : ambientElementary D e 0) :
    mInOrbit D e (x : G) (y : G) ↔ y ∈ MulAction.orbit (mNormalizer D e) x := by
  constructor
  · rintro ⟨n, hn⟩
    exact MulAction.mem_orbit_iff.mpr ⟨n, Subtype.ext hn⟩
  · intro hy
    obtain ⟨n, hn⟩ := MulAction.mem_orbit_iff.mp hy
    exact ⟨n, congrArg Subtype.val hn⟩

omit [Finite G] in
private theorem mInOrbit_conj (x y : G) (g : mNormalizer D e) :
    mInOrbit D e x ((g : G) * y * (g : G)⁻¹) ↔ mInOrbit D e x y := by
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨g⁻¹ * n, ?_⟩
    change ((g : G)⁻¹ * (n : G)) * x * ((g : G)⁻¹ * (n : G))⁻¹ = y
    calc
      _ = (g : G)⁻¹ * ((n : G) * x * (n : G)⁻¹) * (g : G) := by group
      _ = y := by rw [hn]; group
  · rintro ⟨n, hn⟩
    refine ⟨g * n, ?_⟩
    change ((g : G) * (n : G)) * x * ((g : G) * (n : G))⁻¹ = _
    calc
      _ = (g : G) * ((n : G) * x * (n : G)⁻¹) * (g : G)⁻¹ := by group
      _ = _ := by rw [hn]

omit [Finite G] in
private theorem mInOrbit_model_conj (x : G) (g y : H) :
    mInOrbit D e x (D.a10ModelEmbedding e (g * y * g⁻¹)) ↔
      mInOrbit D e x (D.a10ModelEmbedding e y) := by
  let n : mNormalizer D e := ⟨D.a10ModelEmbedding e g,
    centralizer_le_normalizer_M D e ((D.a10ModelEmbedding_range e) ▸ ⟨g, rfl⟩)⟩
  simpa only [map_mul, map_inv] using mInOrbit_conj D e x (D.a10ModelEmbedding e y) n

omit [Finite G] in
private theorem mInOrbit_local_isConj (x : G) {a b : H} (h : IsConj a b) :
    mInOrbit D e x (D.a10ModelEmbedding e a) ↔
      mInOrbit D e x (D.a10ModelEmbedding e b) := by
  obtain ⟨g, rfl⟩ := isConj_iff.mp h
  exact (mInOrbit_model_conj D e x g a).symm

/-- The local class table and the supplied actor give all seven pi conjugates in M. -/
public theorem mPiPoint_orbit_eq_fused
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) (v : G) (hv : v ∈ mNormalizer D e)
    (hvpi : v⁻¹ * D.z * v = D.a10NoncentralInvolution e) :
    MulAction.orbit (mNormalizer D e) (mPiPoint D e) =
      fusedElements (ambientElementary D e 0) D.z := by
  ext y
  rw [← mInOrbit_iff]
  constructor
  · rintro ⟨n, hn⟩
    exact isConj_iff.mpr ⟨(n : G), hn⟩
  · intro hy
    obtain ⟨a, rfl⟩ := (mWordEquiv D e).surjective y
    have hf := (elementaryWord_fusion D e hmu hlam hno 0 a).mp hy
    apply (mInOrbit_local_isConj D e D.z (elementaryWord_isConj 0 a)).mp
    rcases hf with hc | hc
    · rw [hc]
      refine ⟨1, ?_⟩
      simpa [localRepresentative] using (D.a10ModelEmbedding_central e).symm
    · rw [hc]
      exact ⟨⟨v⁻¹, (mNormalizer D e).inv_mem hv⟩, by
        simpa [localRepresentative, mu, LocalData.a10NoncentralInvolution] using hvpi⟩

public theorem mPiPoint_orbit_card
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) (v : G) (hv : v ∈ mNormalizer D e)
    (hvpi : v⁻¹ * D.z * v = D.a10NoncentralInvolution e) :
    (MulAction.orbit (mNormalizer D e) (mPiPoint D e)).ncard = 7 := by
  rw [mPiPoint_orbit_eq_fused D e hmu hlam hno v hv hvpi,
    ambientElementary_fused_card D e hmu hlam hno]
  rfl

public theorem mNormalizer_card
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) (v : G) (hv : v ∈ mNormalizer D e)
    (hvpi : v⁻¹ * D.z * v = D.a10NoncentralInvolution e) :
    Nat.card (mNormalizer D e) = 384 * 7 := by
  have hs : MulAction.stabilizer (mNormalizer D e) (mPiPoint D e) =
      D.centralizer.subgroupOf (mNormalizer D e) := by
    ext g
    rw [MulAction.mem_stabilizer_iff, Subtype.ext_iff]
    change (g : G) * D.z * (g : G)⁻¹ = D.z ↔ (g : G) ∈ D.centralizer
    rw [mem_centralizer_singleton_iff, mul_inv_eq_iff_eq_mul]
  have hc := (MulAction.stabilizer (mNormalizer D e) (mPiPoint D e)).card_mul_index
  rw [MulAction.index_stabilizer, mPiPoint_orbit_card D e hmu hlam hno v hv hvpi,
    hs, Nat.card_congr (subgroupOfEquivOfLe (centralizer_le_normalizer_M D e)).toEquiv,
    D.centralizer_card] at hc
  exact hc.symm

/-- The ambient even pair flips, generated by pi, mu and mu'. -/
@[expose] public noncomputable def ambientEvenFlip : Subgroup G :=
  modelEvenFlip.map (D.a10ModelEmbedding e)

omit [Finite G] in
public theorem ambientEvenFlip_generate :
    closure (Set.range (fun i => D.a10ModelEmbedding e (evenFlipGenerator i))) =
      ambientEvenFlip D e := by
  rw [Set.range_comp', ← MonoidHom.map_closure, modelEvenFlip_generate]
  rfl

omit [Finite G] in
public theorem ambientEvenFlip_le : ambientEvenFlip D e ≤ ambientElementary D e 0 :=
  map_mono modelEvenFlip_le

public theorem ambientEvenFlip_centralizer :
    centralizer (ambientEvenFlip D e : Set G) = ambientElementary D e 0 := by
  rw [← ambientEvenFlip_generate, centralizer_closure, ambient_evenFlip_centralizer]

/-- Even flips are the identity and precisely the pi-fused elements of M. -/
public theorem ambientEvenFlip_mem_iff
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) (x : ambientElementary D e 0) :
    (x : G) ∈ ambientEvenFlip D e ↔ x = 1 ∨ IsConj D.z (x : G) := by
  obtain ⟨a, rfl⟩ := (mWordEquiv D e).surjective x
  change D.a10ModelEmbedding e (elementaryWord 0 a) ∈
      modelEvenFlip.map (D.a10ModelEmbedding e) ↔ _
  rw [mem_map_iff_mem (D.a10ModelEmbedding_injective e), mem_modelEvenFlip_word]
  have he : mWordEquiv D e a = 1 ↔ a = 0 := by
    rw [Subtype.ext_iff]
    change D.a10ModelEmbedding e (elementaryWord 0 a) = 1 ↔ a = 0
    rw [← map_one (D.a10ModelEmbedding e),
      (D.a10ModelEmbedding_injective e).eq_iff, elementaryWord_zero_iff]
  rw [he]
  change a.2.2.2 = 0 ↔ a = 0 ∨
    IsConj D.z (D.a10ModelEmbedding e (elementaryWord 0 a))
  rw [elementaryWord_fusion D e hmu hlam hno, elementaryClass_M_fused_iff]
  by_cases ha : a = 0 <;> simp [ha]

/-- N_G(M) preserves the even-flip subgroup, because it preserves ambient fusion. -/
public theorem mNormalizer_le_normalizer_evenFlip
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) :
    mNormalizer D e ≤ normalizer (ambientEvenFlip D e : Set G) := by
  have hfwd (g : G) (hg : g ∈ mNormalizer D e) (x : G)
      (hx : x ∈ ambientEvenFlip D e) : g * x * g⁻¹ ∈ ambientEvenFlip D e := by
    let y : ambientElementary D e 0 := ⟨x, ambientEvenFlip_le D e hx⟩
    let n : mNormalizer D e := ⟨g, hg⟩
    change ((n • y : ambientElementary D e 0) : G) ∈ ambientEvenFlip D e
    rw [ambientEvenFlip_mem_iff D e hmu hlam hno]
    rcases (ambientEvenFlip_mem_iff D e hmu hlam hno y).mp hx with hy | hy
    · exact Or.inl (by rw [hy, smul_one])
    · exact Or.inr (hy.trans (isConj_iff.mpr ⟨g, rfl⟩))
  intro g hg
  rw [mem_normalizer_iff]
  intro x
  refine ⟨hfwd g hg x, fun hx => ?_⟩
  simpa [mul_assoc] using hfwd g⁻¹ ((mNormalizer D e).inv_mem hg) _ hx

/-- The conjugation homomorphism on the actual even-flip subgroup. -/
@[expose] public noncomputable def evenFlipAction
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) :
    mNormalizer D e →* MulAut (ambientEvenFlip D e) :=
  (ambientEvenFlip D e).normalizerMonoidHom.comp
    (inclusion (mNormalizer_le_normalizer_evenFlip D e hmu hlam hno))

public theorem evenFlipAction_ker
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) :
    (evenFlipAction D e hmu hlam hno).ker =
      (ambientElementary D e 0).subgroupOf (mNormalizer D e) := by
  rw [evenFlipAction, ← MonoidHom.comap_ker, normalizerMonoidHom_ker,
    ambientEvenFlip_centralizer]
  rfl

/-- The induced N_G(M)/M action on the even flips is faithful. -/
public theorem evenFlip_quotient_action_faithful
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) :
    ∃ φ : mNormalizer D e ⧸ (ambientElementary D e 0).subgroupOf (mNormalizer D e) →*
        MulAut (ambientEvenFlip D e),
      Function.Injective φ ∧ ∀ n : mNormalizer D e,
        φ (QuotientGroup.mk n) = evenFlipAction D e hmu hlam hno n := by
  let f := evenFlipAction D e hmu hlam hno
  have hk : (ambientElementary D e 0).subgroupOf (mNormalizer D e) = f.ker :=
    (evenFlipAction_ker D e hmu hlam hno).symm
  refine ⟨QuotientGroup.lift _ f hk.le, ?_, fun _ => rfl⟩
  exact (QuotientGroup.injective_lift_iff _ f hk.le).mpr hk

/-- The two local four-element classes give exactly the two possible xi-orbit lengths. -/
public theorem mXiPoint_orbit_card_alternatives
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hno : NoAdditionalFusion D e) :
    (MulAction.orbit (mNormalizer D e) (mXiPoint D e)).ncard = 4 ∨
      (MulAction.orbit (mNormalizer D e) (mXiPoint D e)).ncard = 8 := by
  let f := D.a10ModelEmbedding e
  let p : H → Prop := fun y => mInOrbit D e (f xi) (f y)
  have hx1 : f xi ≠ 1 := by
    intro hh
    have hxi : xi ≠ 1 := by decide +kernel
    exact hxi ((D.a10ModelEmbedding_injective e) (hh.trans (map_one f).symm))
  have hnoXi : ¬ IsConj D.z (f xi) := hno 2
  have h1 : ¬ p 1 := by
    rintro ⟨g, hg⟩
    have hconj : IsConj (f xi) 1 := isConj_iff.mpr ⟨g, by simpa using hg⟩
    exact hx1 (isConj_one_right.mp hconj.symm)
  have hp : ¬ p pi := by
    rintro ⟨g, hg⟩
    apply hnoXi
    have hconj : IsConj (f xi) D.z :=
      isConj_iff.mpr ⟨g, hg.trans (D.a10ModelEmbedding_central e)⟩
    exact hconj.symm
  have hm : ¬ p mu := by
    rintro ⟨g, hg⟩
    exact hnoXi (hmu.trans (isConj_iff.mpr ⟨(g : G), hg⟩).symm)
  have hx : p xi := ⟨1, by simp⟩
  have h := local_xi_count p (fun g x => mInOrbit_model_conj D e (f xi) g x) h1 hp hm hx
  have hc : Nat.card {a : BaseCode // p (elementaryWord 0 a)} =
      (MulAction.orbit (mNormalizer D e) (mXiPoint D e)).ncard := by
    apply Nat.card_congr (Equiv.subtypeEquiv (mWordEquiv D e) ?_)
    intro a
    exact mInOrbit_iff D e (mXiPoint D e) (mWordEquiv D e a)
  rwa [hc] at h

omit [Finite G] in
private theorem local_xi_centralizer_dvd_stabilizer :
    96 ∣ Nat.card (MulAction.stabilizer (mNormalizer D e) (mXiPoint D e)) := by
  let f := D.a10ModelEmbedding e
  let j : centralizer ({xi} : Set H) →* mNormalizer D e :=
    { toFun := fun x => ⟨f x, centralizer_le_normalizer_M D e
        ((D.a10ModelEmbedding_range e) ▸ ⟨x, rfl⟩)⟩
      map_one' := Subtype.ext (map_one f)
      map_mul' := fun x y => Subtype.ext (map_mul f (x : H) (y : H)) }
  have hj : Function.Injective j := by
    intro a b hab
    have h : f (a : H) = f (b : H) :=
      congrArg (fun n : mNormalizer D e => (n : G)) hab
    exact Subtype.ext ((D.a10ModelEmbedding_injective e) h)
  have hr : j.range ≤ MulAction.stabilizer (mNormalizer D e) (mXiPoint D e) := by
    rintro _ ⟨x, rfl⟩
    rw [MulAction.mem_stabilizer_iff, Subtype.ext_iff]
    change f x * f xi * (f x)⁻¹ = f xi
    rw [mul_inv_eq_iff_eq_mul, ← map_mul, ← map_mul]
    exact congrArg f (mem_centralizer_singleton_iff.mp x.property)
  have hd := card_dvd_of_le hr
  rw [← Nat.card_congr (MonoidHom.ofInjective hj).toEquiv] at hd
  have hc : Nat.card (centralizer ({xi} : Set H)) = 96 :=
    involution_centralizer_cards.2.2.2.2.2.1
  rwa [hc] at hd

/-- The local centralizer of order 96 excludes the eight-point orbit. -/
public theorem mXiPoint_orbit_card
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) (v : G) (hv : v ∈ mNormalizer D e)
    (hvpi : v⁻¹ * D.z * v = D.a10NoncentralInvolution e) :
    (MulAction.orbit (mNormalizer D e) (mXiPoint D e)).ncard = 4 := by
  rcases mXiPoint_orbit_card_alternatives D e hmu hno with h4 | h8
  · exact h4
  have hc := (MulAction.stabilizer (mNormalizer D e) (mXiPoint D e)).card_mul_index
  rw [MulAction.index_stabilizer, h8, mNormalizer_card D e hmu hlam hno v hv hvpi] at hc
  obtain ⟨k, hk⟩ := local_xi_centralizer_dvd_stabilizer D e
  omega

/-- C_N(xi) has order 96 * 7. -/
public theorem mXiPoint_stabilizer_card
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) (v : G) (hv : v ∈ mNormalizer D e)
    (hvpi : v⁻¹ * D.z * v = D.a10NoncentralInvolution e) :
    Nat.card (MulAction.stabilizer (mNormalizer D e) (mXiPoint D e)) = 96 * 7 := by
  have hc := (MulAction.stabilizer (mNormalizer D e) (mXiPoint D e)).card_mul_index
  rw [MulAction.index_stabilizer, mXiPoint_orbit_card D e hmu hlam hno v hv hvpi,
    mNormalizer_card D e hmu hlam hno v hv hvpi] at hc
  omega

/-- Cauchy's theorem supplies the source's order-seven element in C_N(xi). -/
public theorem exists_seven_actor
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) (v : G) (hv : v ∈ mNormalizer D e)
    (hvpi : v⁻¹ * D.z * v = D.a10NoncentralInvolution e) :
    ∃ g : mNormalizer D e, orderOf g = 7 ∧ g • mXiPoint D e = mXiPoint D e := by
  let _ : Fact (Nat.Prime 7) := ⟨by decide⟩
  have hd : 7 ∣ Nat.card (MulAction.stabilizer (mNormalizer D e) (mXiPoint D e)) := by
    rw [mXiPoint_stabilizer_card D e hmu hlam hno v hv hvpi]
    norm_num
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' 7 hd
  exact ⟨g, (Subgroup.orderOf_coe g).trans hg, g.property⟩

omit [Finite G] in
private theorem xiConjugate_mem_mXiPoint_orbit (i : Fin 4) :
    (⟨D.a10ModelEmbedding e (xiConjugate i), mem_map_of_mem _ (xiConjugate_mem i)⟩ :
      ambientElementary D e 0) ∈ MulAction.orbit (mNormalizer D e) (mXiPoint D e) := by
  rw [← mInOrbit_iff]
  apply (mInOrbit_local_isConj D e (D.a10ModelEmbedding e xi) (xiConjugate_isConj i)).mp
  exact ⟨1, by simp⟩

/-- An order-seven actor fixes the four-point xi orbit pointwise. -/
public theorem seven_actor_fixes_xi_orbit
    (hfour : (MulAction.orbit (mNormalizer D e) (mXiPoint D e)).ncard = 4)
    (g : mNormalizer D e) (hg : orderOf g = 7)
    (x : MulAction.orbit (mNormalizer D e) (mXiPoint D e)) : g • x = x := by
  let O := MulAction.orbit (mNormalizer D e) (mXiPoint D e)
  let f := MulAction.toPermHom (mNormalizer D e) O
  have h7 : orderOf (f g) ∣ 7 := hg ▸ orderOf_map_dvd f g
  have h24 : orderOf (f g) ∣ 24 := by
    have hh := orderOf_dvd_natCard (f g)
    rw [Nat.card_perm, show Nat.card O = 4 from hfour] at hh
    exact hh
  have hone : f g = 1 := by
    have hd := Nat.dvd_gcd h7 h24
    norm_num at hd
    exact hd
  exact congrArg (fun σ : Perm O => σ x) hone

/-- The normalizer-action contradiction in the first paragraph of Held Lemma 2.6.
The order-three actor is an explicit input; constructing it belongs to the caller. -/
public theorem additional_fusion_contradiction_of_three_actor
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (hno : NoAdditionalFusion D e) (v : G) (hv : v ∈ mNormalizer D e)
    (_hv3 : orderOf v = 3)
    (hvpi : v⁻¹ * D.z * v = D.a10NoncentralInvolution e)
    (_hvmu : v⁻¹ * D.a10NoncentralInvolution e * v = D.z * D.a10NoncentralInvolution e) :
    False := by
  obtain ⟨g, hg, _⟩ := exists_seven_actor D e hmu hlam hno v hv hvpi
  have hfour := mXiPoint_orbit_card D e hmu hlam hno v hv hvpi
  have hc : (g : G) ∈ centralizer
      (Set.range (fun i => D.a10ModelEmbedding e (xiConjugate i))) := by
    apply mem_centralizer_iff.mpr
    rintro _ ⟨i, rfl⟩
    let x : MulAction.orbit (mNormalizer D e) (mXiPoint D e) :=
      ⟨⟨D.a10ModelEmbedding e (xiConjugate i), mem_map_of_mem _ (xiConjugate_mem i)⟩,
        xiConjugate_mem_mXiPoint_orbit D e i⟩
    have hfix := congrArg (fun y : MulAction.orbit (mNormalizer D e) (mXiPoint D e) =>
      ((y : ambientElementary D e 0) : G)) (seven_actor_fixes_xi_orbit D e hfour g hg x)
    change (g : G) * D.a10ModelEmbedding e (xiConjugate i) * (g : G)⁻¹ =
      D.a10ModelEmbedding e (xiConjugate i) at hfix
    exact (mul_inv_eq_iff_eq_mul.mp hfix).symm
  rw [ambient_centralizer_xiConjugates] at hc
  have hd := (ambientElementary D e 0).orderOf_dvd_natCard hc
  rw [ambientElementary_card, Subgroup.orderOf_coe, hg] at hd
  norm_num at hd

end Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.Fusion
