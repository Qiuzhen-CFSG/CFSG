module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.SourceChecks
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.Coordinates

/-!
# Held's four elementary subgroups

The actual model subgroups M, S, L₁ and L₂ are generated by the four rows
printed in Section 1. Each has sixteen binary normal forms, is elementary
abelian, lies in the displayed subgroup D, and is self-centralizing in H.
The coordinate test for self-centralization recovers a specific binary word
from a commuting element's unique H normal form. All finite checks use
kernel reduction. No enumeration of the full alternating group is performed.

Their images in the arbitrary ambient G also have order sixteen and are
self-centralizing: a centralizing element commutes with pi and hence lies
in the specified H. The full catalogue of elementary subgroups of D, the
Sylow property of the displayed D, and the ambient normalizer analysis are
not asserted here.

Source: D. Held, "A Characterization of some multiply transitive permutation
groups, I", Illinois J. Math. 13 (1969), 224--240,
DOI 10.1215/ijm/1256053756, Section 1, p.225, and Lemmas 2.4--2.6.
-/

open Subgroup Equiv
open scoped IsMulCommutative
namespace Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.Fusion
open Coordinates

/-- Generator rows for M, S, L₁ and L₂, in that order. -/
@[expose] public def elementaryGenerators : Fin 4 → Fin 4 → H :=
  ![![pi, mu, mup, xi], ![pi, mu, tau, lam],
    ![pi, mu, lam, mup * xi], ![pi, mu, tau * lam, xi]]

@[expose] public def elementaryWord (k : Fin 4) (a : BaseCode) : H :=
  elementaryGenerators k 0 ^ a.1.val * elementaryGenerators k 1 ^ a.2.1.val *
    elementaryGenerators k 2 ^ a.2.2.1.val * elementaryGenerators k 3 ^ a.2.2.2.val

set_option maxRecDepth 20000 in
set_option maxHeartbeats 2000000 in
private theorem elementaryWord_mul : ∀ k a b,
    elementaryWord k (a + b) = elementaryWord k a * elementaryWord k b := by
  decide +kernel

private theorem elementaryWord_zero : ∀ k, elementaryWord k 0 = 1 := by decide +kernel

/-- The source elementary coordinates inside the unique 384 normal forms. -/
@[expose] public def elementaryCode (k : Fin 4) (a : BaseCode) : Code :=
  ![(a, (0, 0, 0, 0)),
    ((a.1, a.2.1, 0, 0), (a.2.2.1, 0, 0, a.2.2.2)),
    ((a.1, a.2.1, a.2.2.2, a.2.2.2), (0, 0, 0, a.2.2.1)),
    ((a.1, a.2.1, 0, a.2.2.2), (a.2.2.1, 0, 0, a.2.2.1))] k

public theorem elementaryWord_eq_word : ∀ k a, elementaryWord k a = word (elementaryCode k a) := by
  decide +kernel

private theorem elementaryWord_injective (k : Fin 4) : Function.Injective (elementaryWord k) := by
  have hi : Function.Injective (elementaryCode k) := by
    fin_cases k <;> intro a b hab <;> simp_all [elementaryCode, Prod.ext_iff]
  intro a b h
  apply hi
  apply word_injective
  simpa only [← elementaryWord_eq_word] using h

private def elementaryHom (k : Fin 4) : Multiplicative BaseCode →* H where
  toFun a := elementaryWord k a.toAdd
  map_one' := elementaryWord_zero k
  map_mul' a b := elementaryWord_mul k a.toAdd b.toAdd

/-- The four concrete elementary subgroups of Held Section 1. -/
public def elementary (k : Fin 4) : Subgroup H := (elementaryHom k).range

public abbrev modelM : Subgroup H := elementary 0
public abbrev modelS : Subgroup H := elementary 1
public abbrev modelL1 : Subgroup H := elementary 2
public abbrev modelL2 : Subgroup H := elementary 3

/-- Held's displayed Sylow subgroup, before ambient transport. -/
@[expose] public def modelD : Subgroup H := closure (Set.range (![pi, mu, mup, tau, taup, lam, xi] : Fin 7 → H))

/-- Membership uses sixteen concrete binary normal forms. -/
public theorem mem_elementary (k : Fin 4) (x : H) : x ∈ elementary k ↔ ∃ a, elementaryWord k a = x := by rfl

public theorem elementary_card (k : Fin 4) : Nat.card (elementary k) = 16 := by
  have hi : Function.Injective (elementaryHom k) := elementaryWord_injective k
  rw [elementary, ← Nat.card_congr (MonoidHom.ofInjective hi).toEquiv]
  simp [BaseCode]

public theorem elementary_isElementaryAbelian (k : Fin 4) : IsElementaryAbelian 2 (elementary k) := by
  refine { toIsMulCommutative := ⟨⟨?_⟩⟩, exponent_dvd_p := ?_ }
  · rintro ⟨x, a, rfl⟩ ⟨y, b, rfl⟩
    apply Subtype.ext
    change elementaryWord k a.toAdd * elementaryWord k b.toAdd =
      elementaryWord k b.toAdd * elementaryWord k a.toAdd
    rw [← elementaryWord_mul, add_comm, elementaryWord_mul]
  · apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
    rintro ⟨x, a, rfl⟩
    apply Subtype.ext
    have h : ∀ b : BaseCode, elementaryWord k b ^ 2 = 1 := by
      revert k
      decide +kernel
    exact h a.toAdd

private theorem elementaryWord_mem (k : Fin 4) {K : Subgroup H}
    (h : ∀ i, elementaryGenerators k i ∈ K) (a : BaseCode) : elementaryWord k a ∈ K := by
  unfold elementaryWord
  repeat' first | apply K.mul_mem | apply K.pow_mem
  all_goals apply h

public theorem elementaryGenerators_mem (k : Fin 4) (i : Fin 4) :
    elementaryGenerators k i ∈ elementary k := by
  rw [mem_elementary]
  have h : ∀ j i, ∃ a : BaseCode, elementaryWord j a = elementaryGenerators j i := by
    decide +kernel
  exact h k i

public theorem elementary_eq_closure (k : Fin 4) :
    elementary k = closure (Set.range (elementaryGenerators k)) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨a, rfl⟩ := (mem_elementary k x).mp hx
    exact elementaryWord_mem k (K := closure (Set.range (elementaryGenerators k)))
      (fun i => subset_closure ⟨i, rfl⟩) a
  · apply (closure_le _).2
    rintro x ⟨i, rfl⟩
    exact elementaryGenerators_mem k i

private def elementaryRead (k : Fin 4) (b : Code) : BaseCode :=
  ![b.1, (b.1.1, b.1.2.1, b.2.1, b.2.2.2.2),
    (b.1.1, b.1.2.1, b.2.2.2.2, b.1.2.2.2),
    (b.1.1, b.1.2.1, b.2.1, b.1.2.2.2)] k

local instance codeDecidableEq : DecidableEq Code := inferInstance

set_option maxRecDepth 20000 in
set_option maxHeartbeats 2000000 in
private theorem centralizing_code : ∀ (k : Fin 4) (b : Code),
    (∀ i, elementaryGenerators k i * word b = word b * elementaryGenerators k i) →
    elementaryCode k (elementaryRead k b) = b := by
  decide +kernel

/-- Each of the four elementary groups is self-centralizing in the whole H. -/
public theorem elementary_selfCentralizing (k : Fin 4) :
    centralizer (elementary k : Set H) = elementary k := by
  apply le_antisymm
  · intro x hx
    have hgen : ∀ i, elementaryGenerators k i * x = x * elementaryGenerators k i :=
      fun i => mem_centralizer_iff.mp hx _ (elementaryGenerators_mem k i)
    obtain ⟨a, rfl⟩ := word_bijective.surjective x
    rw [mem_elementary]
    exact ⟨elementaryRead k a, (elementaryWord_eq_word k _).trans
      (congrArg word (centralizing_code k a hgen))⟩
  · intro x hx
    apply mem_centralizer_iff.mpr
    intro y hy
    let := elementary_isElementaryAbelian k
    exact congrArg Subtype.val (mul_comm (⟨y, hy⟩ : elementary k) ⟨x, hx⟩)

public theorem pi_mem_elementary (k : Fin 4) : pi ∈ elementary k := by
  have h := elementaryGenerators_mem k 0
  have he : elementaryGenerators k 0 = pi := by fin_cases k <;> rfl
  rwa [he] at h

/-- The four named elementary subgroups all lie in the displayed two-subgroup. -/
public theorem elementary_le_modelD (k : Fin 4) : elementary k ≤ modelD := by
  rw [elementary_eq_closure]
  apply (closure_le _).mpr
  rintro x ⟨i, rfl⟩
  have h : ∀ j : Fin 7, (![pi, mu, mup, tau, taup, lam, xi] : Fin 7 → H) j ∈ modelD :=
    fun j => subset_closure ⟨j, rfl⟩
  fin_cases k <;> fin_cases i
  all_goals first
    | exact h 0
    | exact h 1
    | exact h 2
    | exact h 3
    | exact h 5
    | exact h 6
    | exact modelD.mul_mem (h 2) (h 6)
    | exact modelD.mul_mem (h 3) (h 5)

universe u
variable {G : Type u} [Group G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer)

/-- The actual ambient image of one of Held's four elementary groups. -/
@[expose] public noncomputable def ambientElementary (k : Fin 4) : Subgroup G := (elementary k).map (D.a10ModelEmbedding e)

/-- The actual ambient image of the displayed Sylow candidate. -/
@[expose] public noncomputable def ambientD : Subgroup G := modelD.map (D.a10ModelEmbedding e)

public theorem ambientElementary_card (k : Fin 4) : Nat.card (ambientElementary D e k) = 16 := by
  rw [ambientElementary, card_map_of_injective (D.a10ModelEmbedding_injective e)]
  exact elementary_card k

public theorem ambientElementary_isElementaryAbelian (k : Fin 4) :
    IsElementaryAbelian 2 (ambientElementary D e k) := by
  let := elementary_isElementaryAbelian k
  exact IsElementaryAbelian.map (D.a10ModelEmbedding e)

public theorem z_mem_ambientElementary [Finite G] (k : Fin 4) : D.z ∈ ambientElementary D e k :=
  ⟨pi, pi_mem_elementary k, D.a10ModelEmbedding_central e⟩

/-- Self-centralization also holds in G, because pi belongs to the subgroup. -/
public theorem ambientElementary_selfCentralizing [Finite G] (k : Fin 4) :
    centralizer (ambientElementary D e k : Set G) = ambientElementary D e k := by
  ext x
  constructor
  · intro hx
    have hxH : x ∈ D.centralizer := mem_centralizer_singleton_iff.mpr
      (mem_centralizer_iff.mp hx D.z (z_mem_ambientElementary D e k)).symm
    have hxr : x ∈ (D.a10ModelEmbedding e).range := by
      rw [D.a10ModelEmbedding_range e]
      exact hxH
    obtain ⟨y, rfl⟩ := hxr
    refine ⟨y, ?_, rfl⟩
    rw [← elementary_selfCentralizing k]
    apply mem_centralizer_iff.mpr
    intro t ht
    apply D.a10ModelEmbedding_injective e
    simpa only [map_mul] using mem_centralizer_iff.mp hx
      (D.a10ModelEmbedding e t) ⟨t, ht, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    apply mem_centralizer_iff.mpr
    rintro _ ⟨t, ht, rfl⟩
    have hyc : y ∈ centralizer (elementary k : Set H) := by
      rw [elementary_selfCentralizing]
      exact hy
    simpa only [map_mul] using congrArg (D.a10ModelEmbedding e)
      (mem_centralizer_iff.mp hyc t ht)

end Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.Fusion
