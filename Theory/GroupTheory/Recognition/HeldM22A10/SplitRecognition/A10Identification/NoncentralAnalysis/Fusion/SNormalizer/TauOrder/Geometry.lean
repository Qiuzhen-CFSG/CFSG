module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.Fusion.SNormalizer.TauOrder.Model
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.Fusion.SNormalizer.PiLambda
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.Fusion.LambdaSeparation.NormalizerAction

/-!
# The elementary eight-group in Held's tau fusion case

Under pi~mu, pi~tau and pi not~lambda, the global pi-class in S is exactly
the seven nonidentity elements of U=<pi,mu,tau>. Thus N_G(S) normalizes U.
The concrete centralizer calculation C_H(U)=S, together with pi in U,
gives C_G(U)=S. This prepares the faithful action on U used to determine
the normalizer order in Held, Illinois J. Math. 13 (1969), Lemma 2.6, p.228.
All conjugation and centralizer calculations use the actual A10 model.
-/

open Subgroup Equiv
open scoped IsMulCommutative
namespace Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.Fusion
open Coordinates

universe u
variable {G : Type u} [Group G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer)

/-- The actual ambient eight-group generated by pi, mu and tau. -/
@[expose] public noncomputable def tauFusionSpace : Subgroup G :=
  tauFusionSpaceModel.map (D.a10ModelEmbedding e)

public theorem tauFusionSpace_card : Nat.card (tauFusionSpace D e) = 8 := by
  rw [tauFusionSpace, card_map_of_injective (D.a10ModelEmbedding_injective e),
    tauFusionSpaceModel_card]

public theorem tauFusionSpace_le_S : tauFusionSpace D e ≤ ambientElementary D e 1 :=
  map_mono tauFusionSpaceModel_le_S

public theorem tauFusionSpace_isElementaryAbelian : IsElementaryAbelian 2 (tauFusionSpace D e) := by
  let := ambientElementary_isElementaryAbelian D e 1
  refine { is_comm := ⟨?_⟩, exponent_dvd_p := ?_ }
  · intro a b
    exact Subtype.ext (setLike_mul_comm (tauFusionSpace_le_S D e a.property)
      (tauFusionSpace_le_S D e b.property))
  · apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
    intro x
    exact Subtype.ext (elemPow_eq_one_of_isElementaryAbelian (p := 2) (x : G)
      (tauFusionSpace_le_S D e x.property))

variable [Finite G]

public theorem z_mem_tauFusionSpace : D.z ∈ tauFusionSpace D e :=
  ⟨pi, pi_mem_tauFusionSpaceModel, D.a10ModelEmbedding_central e⟩

/-- The ambient centralizer is S, using pi to first reduce to H. -/
public theorem tauFusionSpace_centralizer :
    centralizer (tauFusionSpace D e : Set G) = ambientElementary D e 1 := by
  apply le_antisymm
  · intro x hx
    have hxH : x ∈ D.centralizer := mem_centralizer_singleton_iff.mpr
      (mem_centralizer_iff.mp hx D.z (z_mem_tauFusionSpace D e)).symm
    have hxr : x ∈ (D.a10ModelEmbedding e).range := by
      rwa [D.a10ModelEmbedding_range e]
    obtain ⟨y, rfl⟩ := hxr
    refine ⟨y, ?_, rfl⟩
    change y ∈ modelS
    rw [← tauFusionSpaceModel_centralizer]
    apply mem_centralizer_iff.mpr
    intro t ht
    apply D.a10ModelEmbedding_injective e
    simpa only [map_mul] using mem_centralizer_iff.mp hx
      (D.a10ModelEmbedding e t) ⟨t, ht, rfl⟩
  · rw [← ambientElementary_selfCentralizing D e 1]
    exact centralizer_le (tauFusionSpace_le_S D e)

/-- The complete global pi-class in S in the tau case. -/
public theorem isConj_z_iff_mem_tauFusionSpace
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (htau : IsConj D.z (D.a10ModelEmbedding e tau))
    {x : G} (hx : x ∈ ambientElementary D e 1) :
    IsConj D.z x ↔ x ∈ tauFusionSpace D e ∧ x ≠ 1 := by
  let f := D.a10ModelEmbedding e
  let p (y : H) := IsConj D.z (f y)
  have hconj (g y : H) : p (g * y * g⁻¹) ↔ p y := by
    have hc : IsConj (f y) (f (g * y * g⁻¹)) :=
      isConj_iff.mpr ⟨f g, by simp only [map_mul, map_inv]⟩
    exact ⟨fun h => h.trans hc.symm, fun h => h.trans hc⟩
  have h1 : ¬ p 1 := by
    intro h
    exact D.z_ne_one (isConj_one_left.mp (by simpa only [p, map_one] using h))
  have hpi : p pi := by
    change IsConj D.z (D.a10ModelEmbedding e pi)
    rw [D.a10ModelEmbedding_central e]
  have hpiLam : ¬ p (Coordinates.pi * lam) := piLambda_nonfusion_of_mu D e hmu hlam
  obtain ⟨y, hy, rfl⟩ := hx
  change p y ↔ _
  rw [tauFusionSpaceModel_class p hconj h1 hpi hmu htau hlam hpiLam hy]
  have hm : f y ∈ tauFusionSpace D e ↔ y ∈ tauFusionSpaceModel :=
    mem_map_iff_mem (D.a10ModelEmbedding_injective e)
  rw [hm]
  exact and_congr Iff.rfl (by
    rw [← f.map_one, (D.a10ModelEmbedding_injective e).ne_iff])

/-- Ambient fusion invariance forces the actual S-normalizer to preserve U. -/
public theorem normalizer_S_le_normalizer_tauFusionSpace
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (htau : IsConj D.z (D.a10ModelEmbedding e tau)) :
    normalizer (ambientElementary D e 1 : Set G) ≤ normalizer (tauFusionSpace D e : Set G) := by
  apply le_normalizer_iff.mpr
  intro g hg x hx
  by_cases h1 : x = 1
  · simp [h1]
  have hs := tauFusionSpace_le_S D e hx
  have hc := (isConj_z_iff_mem_tauFusionSpace D e hmu hlam htau hs).mpr ⟨hx, h1⟩
  have hy : IsConj D.z (g * x * g⁻¹) := hc.trans (isConj_iff.mpr ⟨g, rfl⟩)
  have hys : g * x * g⁻¹ ∈ ambientElementary D e 1 := (mem_normalizer_iff.mp hg x).mp hs
  exact ((isConj_z_iff_mem_tauFusionSpace D e hmu hlam htau hys).mp hy).1

/-- The pi orbit in the normalizer has at most seven points. -/
public theorem normalizer_pi_orbit_card_le_seven
    (hmu : IsConj D.z (D.a10NoncentralInvolution e))
    (hlam : ¬ IsConj D.z (D.a10ModelEmbedding e lam))
    (htau : IsConj D.z (D.a10ModelEmbedding e tau)) :
    (MulAction.orbit (LambdaSeparation.sNormalizer D e) (LambdaSeparation.piPoint D e)).ncard ≤ 7 := by
  let O := MulAction.orbit (LambdaSeparation.sNormalizer D e) (LambdaSeparation.piPoint D e)
  let U := tauFusionSpace D e
  have hm (x : O) : (x.val : G) ∈ U ∧ (x.val : G) ≠ 1 := by
    apply (isConj_z_iff_mem_tauFusionSpace D e hmu hlam htau x.val.property).mp
    obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp x.property
    exact isConj_iff.mpr ⟨g, congrArg Subtype.val hg⟩
  let j : O → {x : U // x ≠ 1} := fun x =>
    ⟨⟨x.val.val, (hm x).1⟩, fun h => (hm x).2 (congrArg Subtype.val h)⟩
  have hj : Function.Injective j := by
    intro x y h
    exact Subtype.ext (Subtype.ext (congrArg (fun z : {x : U // x ≠ 1} => z.val.val) h))
  have hc : Nat.card {x : U // x ≠ 1} = 7 := by
    change ({1}ᶜ : Set U).ncard = 7
    rw [Set.ncard_compl, Set.ncard_singleton, tauFusionSpace_card]
  exact (Nat.card_le_card_of_injective j hj).trans_eq hc

end Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.Fusion
