module

public import Mathlib.GroupTheory.SpecificGroups.Dihedral
public import Mathlib.GroupTheory.Sylow

/-!
# The two Sylow groups in Held's transfer calculation

The order-32 group is C2 × C2 × D8, with the source generators l,z,p,t,m.
The subgroup generated by lt and zm is the graph of two binary characters
of D8. Its projection to D8 is an isomorphism, so this constructs the actual
dihedral subgroup of order eight, rather than a group-family predicate.

These are abstract local coordinates. They do not assert ambient fusion or
choose the source's lambda and xi normalizations for a supplied embedding.
Source: Held, Illinois J. Math. 13 (1969), 224--240, pp.233--234,
DOI 10.1215/ijm/1256053756, proof of Lemma 4.2.
-/

open Subgroup
namespace Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.CentralizerStructure.TransferModel
public abbrev Model := Multiplicative (ZMod 2) × Multiplicative (ZMod 2) × DihedralGroup 4

@[expose] public def p : Model := (1, 1, DihedralGroup.r 2)
@[expose] public def l : Model := (Multiplicative.ofAdd 1, 1, 1)
@[expose] public def z : Model := (1, Multiplicative.ofAdd 1, 1)
@[expose] public def t : Model := (1, 1, DihedralGroup.sr 0)
@[expose] public def m : Model := (1, 1, DihedralGroup.sr 1)

@[expose] public def coreWord : DihedralGroup 4 → Model
  | .r i => (Multiplicative.ofAdd (i.val : ZMod 2),
      Multiplicative.ofAdd (i.val : ZMod 2), .r i)
  | .sr i => (Multiplicative.ofAdd ((i.val : ZMod 2) + 1),
      Multiplicative.ofAdd (i.val : ZMod 2), .sr i)

@[expose] public def coreHom : DihedralGroup 4 →* Model where
  toFun := coreWord
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

public theorem coreHom_injective : Function.Injective coreHom := by
  intro a b hab
  have ha (d : DihedralGroup 4) : (coreHom d).2.2 = d := by cases d <;> rfl
  simpa only [ha] using congrArg (fun d : Model => d.2.2) hab

public abbrev R := coreHom.range
public noncomputable def coreEquiv : DihedralGroup 4 ≃* R :=
  MulEquiv.ofBijective coreHom.rangeRestrict
    ⟨fun _ _ h => coreHom_injective (congrArg Subtype.val h), coreHom.rangeRestrict_surjective⟩

public theorem coreHom_r_one : coreHom (.r 1) = (l * t) * (z * m) := by decide +kernel
public theorem coreHom_sr_zero : coreHom (.sr 0) = l * t := by decide +kernel
public theorem coreHom_sr_one : coreHom (.sr 1) = z * m := by decide +kernel
public theorem coreHom_r_two : coreHom (.r 2) = p := by decide +kernel

public theorem R_le {K : Subgroup Model} (hlt : l * t ∈ K) (hzm : z * m ∈ K) : R ≤ K := by
  rintro _ ⟨d, rfl⟩
  have hr : coreHom (.r 1) ∈ K := by rw [coreHom_r_one]; exact K.mul_mem hlt hzm
  have hrall (i : ZMod 4) : coreHom (.r i) ∈ K := by
    have he : DihedralGroup.r i = (DihedralGroup.r 1 : DihedralGroup 4) ^ i.val := by
      rw [DihedralGroup.r_one_pow, ZMod.natCast_zmod_val]
    rw [he, map_pow]
    exact K.pow_mem hr _
  cases d with
  | r i => exact hrall i
  | sr i =>
    have he : DihedralGroup.sr i = (DihedralGroup.sr 0 : DihedralGroup 4) * .r i := by simp
    rw [he, map_mul, coreHom_sr_zero]
    exact K.mul_mem hlt (hrall i)

public theorem p_mem_R : p ∈ R := ⟨.r 2, coreHom_r_two⟩
public theorem lt_mem_R : l * t ∈ R := ⟨.sr 0, coreHom_sr_zero⟩
public theorem zm_mem_R : z * m ∈ R := ⟨.sr 1, coreHom_sr_one⟩

public theorem p_order : orderOf p = 2 := by
  apply orderOf_eq_prime
  · decide +kernel
  · decide +kernel

public theorem m_conj_lt : m * (l * t) * m⁻¹ = p * (l * t) := by decide +kernel

open scoped commutatorElement in
public theorem commutator_lt_zm : ⁅l * t, z * m⁆ = p := by decide +kernel

end Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.CentralizerStructure.TransferModel
