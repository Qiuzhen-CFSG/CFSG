module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.CentralizerStructure.Recognition.FaithfulExclusion.SourceActors.Relations

/-!
# The eight-group in Held's Section 2.13

The subgroup generated by pi, mu and xi has eight distinct binary words.
Replacing xi by pi*xi changes its coordinates but leaves the subgroup unchanged.
We give its ambient realization, order, elementary abelian structure and a
closure characterization, so its normalizer has a fixed mathematical meaning.

`Section213Overgroup` specifies the part of Held's group L used to extract
alpha: order 192, normalization of the eight-group, centralization of pi*mu,
and intersection of order 64 with H = C_G(pi). Its construction is a separate
obligation; none of its fields prescribes an actor or its conjugation action.

Source: D. Held, Illinois J. Math. 13 (1969), 224--240,
DOI 10.1215/ijm/1256053756, Section 2.13, p.231.
-/

open Subgroup
namespace Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.CentralizerStructure
namespace FaithfulExclusion
open Coordinates

@[expose] public def section213Word (d : Bit) (i : WordCode) : H :=
  Coordinates.pi ^ i.1.val * Coordinates.mu ^ i.2.1.val * normalizedXi d ^ i.2.2.val

private def eightHom : Multiplicative WordCode →* H where
  toFun i := section213Word 0 i.toAdd
  map_one' := by decide +kernel
  map_mul' := by
    intro i j
    change section213Word 0 (i.toAdd + j.toAdd) = _
    have h : ∀ i j, section213Word 0 (i + j) =
        section213Word 0 i * section213Word 0 j := by decide +kernel
    exact h _ _

universe u
variable {G : Type u} [Group G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer)

/-- The actual subgroup generated by pi, mu and xi, independent of the xi choice. -/
public noncomputable def section213Eight : Subgroup G :=
  ((D.a10ModelEmbedding e).comp eightHom).range

public theorem mem_section213Eight_iff (d : Bit) (x : G) :
    x ∈ section213Eight D e ↔ ∃ i : WordCode,
      D.a10ModelEmbedding e (section213Word d i) = x := by
  have h : ∀ d i, ∃ j, section213Word d i = section213Word 0 j := by decide +kernel
  have h' : ∀ d i, ∃ j, section213Word 0 i = section213Word d j := by decide +kernel
  constructor
  · rintro ⟨i, rfl⟩
    obtain ⟨j, hj⟩ := h' d i.toAdd
    exact ⟨j, congrArg (D.a10ModelEmbedding e) hj.symm⟩
  · rintro ⟨i, rfl⟩
    obtain ⟨j, hj⟩ := h d i
    exact ⟨Multiplicative.ofAdd j, congrArg (D.a10ModelEmbedding e) hj.symm⟩

public theorem section213Eight_eq_closure : section213Eight D e =
    closure (Set.range (fun i : Fin 3 => D.a10ModelEmbedding e
      ((![Coordinates.pi, Coordinates.mu, xi] : Fin 3 → H) i))) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨i, rfl⟩ := (mem_section213Eight_iff D e 0 x).mp hx
    have hg (j : Fin 3) : D.a10ModelEmbedding e ((![Coordinates.pi, Coordinates.mu, xi] : Fin 3 → H) j) ∈
        closure (Set.range (fun i : Fin 3 => D.a10ModelEmbedding e
          ((![Coordinates.pi, Coordinates.mu, xi] : Fin 3 → H) i))) := subset_closure ⟨j, rfl⟩
    simp only [section213Word, normalizedXi, Fin.val_zero, pow_zero, one_mul, map_mul, map_pow]
    exact mul_mem (mul_mem (pow_mem (hg 0) _) (pow_mem (hg 1) _)) (pow_mem (hg 2) _)
  · apply (closure_le _).mpr
    rintro x ⟨i, rfl⟩
    change D.a10ModelEmbedding e ((![Coordinates.pi, Coordinates.mu, xi] : Fin 3 → H) i) ∈ section213Eight D e
    rw [mem_section213Eight_iff D e 0]
    have h : ∀ i : Fin 3, ∃ j, section213Word 0 j = (![Coordinates.pi, Coordinates.mu, xi] : Fin 3 → H) i := by
      decide +kernel
    obtain ⟨j, hj⟩ := h i
    exact ⟨j, congrArg (D.a10ModelEmbedding e) hj⟩

/-- The eight binary words are distinct in the local model. -/
public theorem section213Word_injective (d : Bit) : Function.Injective (section213Word d) := by
  have h : ∀ d, Function.Injective (section213Word d) := by decide +kernel
  exact h d

public theorem section213Eight_card : Nat.card (section213Eight D e) = 8 := by
  have hi : Function.Injective ((D.a10ModelEmbedding e).comp eightHom) :=
    (D.a10ModelEmbedding_injective e).comp (section213Word_injective 0)
  rw [section213Eight, ← Nat.card_congr (MonoidHom.ofInjective hi).toEquiv]
  simp [WordCode, Bit]

public theorem section213Eight_le_centralizer : section213Eight D e ≤ D.centralizer := by
  rintro x ⟨i, rfl⟩
  exact (e.symm _).property

public theorem section213Eight_isElementaryAbelian : IsElementaryAbelian 2 (section213Eight D e) := by
  have hs (x : section213Eight D e) : x ^ 2 = 1 := by
    apply Subtype.ext
    obtain ⟨i, hi⟩ := (mem_section213Eight_iff D e 0 x).mp x.property
    change (x : G) ^ 2 = 1
    rw [← hi, ← map_pow]
    have hl : ∀ i, section213Word 0 i ^ 2 = 1 := by decide +kernel
    rw [hl i, map_one]
  refine { is_comm := ?_, exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hs }
  exact ⟨fun x y => (Commute.of_orderOf_dvd_two
    (fun x => orderOf_dvd_of_pow_eq_one (hs x)) x y).eq⟩

/-- The part of Held's order-192 overgroup needed to extract alpha.
Normalizing the eight-group and centralizing pi*mu are ambient conditions. -/
public structure Section213Overgroup where
  subgroup : Subgroup G
  card : Nat.card subgroup = 192
  normalizes_eight : subgroup ≤ normalizer (section213Eight D e : Set G)
  centralizes_corePi : subgroup ≤ centralizer ({D.a10ModelEmbedding e corePi} : Set G)
  intersection_card : Nat.card (subgroup ⊓ D.centralizer : Subgroup G) = 64

end FaithfulExclusion
end Theory.GroupTheory.HeldM22A10.A10Identification.NoncentralAnalysis.CentralizerStructure
