module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction.SectionTransport
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.OvergroupConstruction.LocalGeometry.Coordinates

/-!
# The dihedral complement supplied by the normal A₆ section

The local subgroup generated by lambda and mu-prime is dihedral of order
eight, with central involution mu. The centerless normal A₆ section avoids
mu, so this dihedral subgroup injects into its quotient. Equal orders make
that map bijective. This proves the full centralizer decomposition and the
trivial intersection with the four-group generated by mu and lambda.
No normalization of lambda or xi, or existence of the order-three actors,
is assumed here.

Source: D. Held, Illinois J. Math. 13 (1969), 224–240,
DOI 10.1215/ijm/1256053756, Lemma 4.2, pp.234–235.
The dihedral calculation also occurs in the independent core quotient
construction, NoncentralAnalysis/CentralizerStructure/Recognition/Quotient.
-/

open Subgroup
namespace Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction

variable {G : Type*} [Group G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer)
  (s : NoncentralAnalysis.AlternatingSixSection
    (centralizer ({D.a10NoncentralInvolution e} : Set G)))

public theorem mu_not_mem_section : mu D e ∉ s.ambientSubgroup := by
  intro hm
  let m : s.ambientSubgroup := ⟨mu D e, hm⟩
  have hc : m ∈ center s.ambientSubgroup := by
    rw [mem_center_iff]
    intro a
    apply Subtype.ext
    exact mem_centralizer_singleton_iff.mp (s.ambientSubgroup_le a.property)
  rw [s.ambientSubgroup_center_eq_bot] at hc
  exact element_ne_one D e 1 (congrArg Subtype.val (show m = 1 from hc))

public theorem mu'_normalizes_section : mu' D e ∈ normalizer (s.ambientSubgroup : Set G) :=
  s.le_normalizer_ambientSubgroup (mem_centralizer_singleton_iff.mpr (mu_commute_mu' D e).symm.eq)

private def localDihedral : DihedralGroup 4 →* CentralizerModels.a10Centralizer where
  toFun d := match d with
    | .r i => (modelElement 6 * modelElement 2) ^ i.val
    | .sr i => modelElement 2 * (modelElement 6 * modelElement 2) ^ i.val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

private theorem localDihedral_centralizes : ∀ d,
    localDihedral d * modelElement 1 = modelElement 1 * localDihedral d := by
  decide +kernel

private noncomputable def ambientDihedral : DihedralGroup 4 →*
    centralizer ({D.a10NoncentralInvolution e} : Set G) where
  toFun d := ⟨D.a10ModelEmbedding e (localDihedral d),
    mem_centralizer_singleton_iff.mpr (by
      rw [← mu_eq D e]
      simpa only [map_mul, mu, element] using
        congrArg (D.a10ModelEmbedding e) (localDihedral_centralizes d))⟩
  map_one' := Subtype.ext (by simp)
  map_mul' a b := Subtype.ext (by simp)

private theorem ambientDihedral_central : (ambientDihedral D e (.r 2) : G) = mu D e := by
  have h : localDihedral (.r 2) = modelElement 1 := by decide +kernel
  change D.a10ModelEmbedding e (localDihedral (.r 2)) = _
  rw [h]
  rfl

private theorem dihedral_four_injective {B : Type*} [Group B]
    (f : DihedralGroup 4 →* B) (h : f (.r 2) ≠ 1) : Function.Injective f := by
  have hcases : ∀ d : DihedralGroup 4, d = 1 ∨ d = .r 2 ∨
      d * d = .r 2 ∨ (.r 1 * d * (.r 1)⁻¹) * d⁻¹ = .r 2 := by decide +kernel
  apply (MonoidHom.ker_eq_bot_iff f).mp
  apply eq_bot_iff.mpr
  intro d hd
  have hfd : f d = 1 := hd
  rcases hcases d with h1 | h2 | hsq | hcomm
  · exact h1
  · exact (h (h2 ▸ hfd)).elim
  · apply False.elim
    apply h
    rw [← hsq, map_mul, hfd, one_mul]
  · apply False.elim
    apply h
    rw [← hcomm, map_mul, map_mul, map_mul, map_inv, map_inv, hfd]
    simp

private theorem quotient_dihedral_bijective :
    let := s.normal
    Function.Bijective ((QuotientGroup.mk' s.subgroup).comp (ambientDihedral D e)) := by
  let := s.normal
  let f := (QuotientGroup.mk' s.subgroup).comp (ambientDihedral D e)
  have hf : Function.Injective f := by
    apply dihedral_four_injective
    intro h
    have hm : (ambientDihedral D e (.r 2) : G) ∈ s.ambientSubgroup :=
      ⟨_, (QuotientGroup.eq_one_iff _).mp h, rfl⟩
    rw [ambientDihedral_central] at hm
    exact mu_not_mem_section D e s hm
  let : Finite (centralizer ({D.a10NoncentralInvolution e} : Set G) ⧸ s.subgroup) :=
    Finite.of_equiv (DihedralGroup 4) s.quotientEquiv.symm.toEquiv
  exact hf.bijective_of_nat_card_le (by
    rw [Nat.card_congr s.quotientEquiv.toEquiv])

private theorem ambientDihedral_mem_join (d : DihedralGroup 4) :
    (ambientDihedral D e d : G) ∈
      closure ({mu D e, lam D e} : Set G) ⊔ zpowers (mu' D e) := by
  have hl : lam D e ∈ closure ({mu D e, lam D e} : Set G) ⊔ zpowers (mu' D e) :=
    (show closure ({mu D e, lam D e} : Set G) ≤ _ from le_sup_left)
      (subset_closure (by simp))
  have hm : mu' D e ∈ closure ({mu D e, lam D e} : Set G) ⊔ zpowers (mu' D e) :=
    (show zpowers (mu' D e) ≤ _ from le_sup_right) (mem_zpowers _)
  cases d with
  | r i =>
    change D.a10ModelEmbedding e ((modelElement 6 * modelElement 2) ^ i.val) ∈ _
    simpa only [map_pow, map_mul, lam, mu', element] using pow_mem (mul_mem hl hm) i.val
  | sr i =>
    change D.a10ModelEmbedding e (modelElement 2 * (modelElement 6 * modelElement 2) ^ i.val) ∈ _
    simpa only [map_pow, map_mul, lam, mu', element] using mul_mem hm (pow_mem (mul_mem hl hm) i.val)

/-- The section already forces the full centralizer decomposition. -/
public theorem section_centralizer_decomposition : centralizer ({mu D e} : Set G) =
    (closure ({mu D e, lam D e} : Set G) ⊔ s.ambientSubgroup) ⊔ zpowers (mu' D e) := by
  let := s.normal
  apply le_antisymm
  · intro x hx
    let c : centralizer ({D.a10NoncentralInvolution e} : Set G) := ⟨x, hx⟩
    obtain ⟨d, hd⟩ := (quotient_dihedral_bijective D e s).surjective (QuotientGroup.mk' s.subgroup c)
    have hmem : c / ambientDihedral D e d ∈ s.subgroup := by
      apply (QuotientGroup.eq_one_iff _).mp
      change QuotientGroup.mk' s.subgroup (c / ambientDihedral D e d) = 1
      rw [map_div]
      change QuotientGroup.mk' s.subgroup (ambientDihedral D e d) =
        QuotientGroup.mk' s.subgroup c at hd
      rw [hd, div_self']
    have hA : x / (ambientDihedral D e d : G) ∈ s.ambientSubgroup := ⟨_, hmem, rfl⟩
    have hdJ := ambientDihedral_mem_join D e d
    have hAJ : s.ambientSubgroup ≤
        (closure ({mu D e, lam D e} : Set G) ⊔ s.ambientSubgroup) ⊔ zpowers (mu' D e) :=
      le_sup_right.trans le_sup_left
    have hdJ' : (ambientDihedral D e d : G) ∈
        (closure ({mu D e, lam D e} : Set G) ⊔ s.ambientSubgroup) ⊔ zpowers (mu' D e) :=
      (show closure ({mu D e, lam D e} : Set G) ⊔ zpowers (mu' D e) ≤ _
        from sup_le_sup_right le_sup_left _) hdJ
    simpa only [div_mul_cancel] using mul_mem (hAJ hA) hdJ'
  · apply sup_le
    · apply sup_le
      · apply (closure_le _).mpr
        intro x hx
        rcases Set.mem_insert_iff.mp hx with rfl | hx
        · exact mem_centralizer_singleton_iff.mpr rfl
        · have he : x = lam D e := Set.mem_singleton_iff.mp hx
          rw [he]
          exact mem_centralizer_singleton_iff.mpr (mu_commute_lam D e).symm.eq
      · exact s.ambientSubgroup_le
    · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr (mu_commute_mu' D e).symm.eq)

private theorem four_le_dihedral_range :
    closure ({mu D e, lam D e} : Set G) ≤
      ((centralizer ({D.a10NoncentralInvolution e} : Set G)).subtype.comp (ambientDihedral D e)).range := by
  apply (closure_le _).mpr
  intro x hx
  rcases Set.mem_insert_iff.mp hx with rfl | hx
  · exact ⟨.r 2, ambientDihedral_central D e⟩
  · have he : x = lam D e := Set.mem_singleton_iff.mp hx
    rw [he]
    refine ⟨.sr 3, ?_⟩
    have h : localDihedral (.sr 3) = modelElement 6 := by decide +kernel
    change D.a10ModelEmbedding e (localDihedral (.sr 3)) = _
    rw [h]
    rfl

public theorem section_disjoint_four :
    Disjoint (closure ({mu D e, lam D e} : Set G)) s.ambientSubgroup := by
  let := s.normal
  apply disjoint_def.mpr
  intro x hx ha
  obtain ⟨d, rfl⟩ := four_le_dihedral_range D e hx
  have hdmem : ambientDihedral D e d ∈ s.subgroup := by
    obtain ⟨a, ha, he⟩ := ha
    have he' : a = ambientDihedral D e d := Subtype.ext he
    exact he' ▸ ha
  have hd : d = 1 := (quotient_dihedral_bijective D e s).injective (by
    rw [map_one]
    change (ambientDihedral D e d : _ ⧸ s.subgroup) = 1
    exact (QuotientGroup.eq_one_iff _).mpr hdmem)
  rw [hd, map_one]

end Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction
