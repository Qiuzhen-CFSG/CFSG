module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction.ActorConstruction.SectionActions
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators
import Mathlib.Tactic.Group

/-!
# The marked four-group normalized by Held's two actors

The commuting involutions pi*mu and tau*lambda generate a Klein four-group
inside the supplied A₆. The two cubic actors induce opposite cycles on its
three nonidentity elements, and mu-prime fixes pi*mu and interchanges the
other two. These computations precede, and do not assume, the commuting choice.

Source: D. Held, Illinois J. Math. 13 (1969), 224--240,
DOI 10.1215/ijm/1256053756, Sections 4.1--4.2 and 5.1, pp.232--236.
-/

open Subgroup Equiv
namespace Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction
namespace CommutingChoice

variable {G : Type*} [Group G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer)

/-- The actual ambient subgroup generated by the two marked involutions. -/
public def four : Subgroup G := closure ({pi D e * mu D e, tau D e * lam D e} : Set G)

private theorem core_commute_second : Commute (pi D e * mu D e) (tau D e * lam D e) := by
  have h : Commute (modelElement 0 * modelElement 1) (modelElement 3 * modelElement 6) := by
    change _ * _ = _ * _
    decide +kernel
  simpa only [pi, mu, tau, lam, element, map_mul] using h.map (D.a10ModelEmbedding e)

public theorem four_klein : IsKleinFour (four D e) := by
  apply isKleinFour_closure_pair
  · simpa only [pow_two] using actor_core_square D e
  · simpa only [pow_two] using actor_second_square D e
  · exact actor_core_ne_one D e
  · intro h
    have hm : modelElement 3 * modelElement 6 = 1 := by
      apply D.a10ModelEmbedding_injective e
      simpa only [element, map_mul, map_one] using h
    exact (show modelElement 3 * modelElement 6 ≠ 1 from by decide +kernel) hm
  · intro h
    have hm : modelElement 0 * modelElement 1 = modelElement 3 * modelElement 6 := by
      apply D.a10ModelEmbedding_injective e
      simpa only [element, map_mul] using h
    exact (show modelElement 0 * modelElement 1 ≠ modelElement 3 * modelElement 6
      from by decide +kernel) hm
  · exact core_commute_second D e

public theorem core_mem : pi D e * mu D e ∈ four D e := subset_closure (by simp)
public theorem second_mem : tau D e * lam D e ∈ four D e := subset_closure (by simp)

private theorem normalizes_four_of_conjugates (g : G)
    (hk : g⁻¹ * (pi D e * mu D e) * g ∈ four D e)
    (hc : g⁻¹ * (tau D e * lam D e) * g ∈ four D e) :
    g ∈ normalizer (four D e : Set G) := by
  let := four_klein D e
  let : Finite (four D e) := Nat.finite_of_card_ne_zero (by simp)
  have h : (four D e).map (MulAut.conj g⁻¹).toMonoidHom ≤ four D e := by
    rw [map_le_iff_le_comap]
    apply (closure_le _).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · change g⁻¹ * (pi D e * mu D e) * g⁻¹⁻¹ ∈ four D e
      simpa only [inv_inv] using hk
    · have hx' := Set.mem_singleton_iff.mp hx
      subst x
      change g⁻¹ * (tau D e * lam D e) * g⁻¹⁻¹ ∈ four D e
      simpa only [inv_inv] using hc
  have hn : g⁻¹ ∈ normalizer (four D e : Set G) := by
    apply mem_normalizer_fintype (S := (four D e : Set G))
    intro x hx
    exact h ⟨x, hx, rfl⟩
  simpa only [inv_inv] using (normalizer (four D e : Set G)).inv_mem hn

public theorem u_normalizes_four (a : UActor D e) :
    a.u ∈ normalizer (four D e : Set G) := by
  apply normalizes_four_of_conjugates
  · rw [a.pi_mu_u D e]
    exact second_mem D e
  · have h : a.u⁻¹ * (tau D e * lam D e) * a.u =
        (pi D e * mu D e) * (tau D e * lam D e) := by
      calc
        _ = (a.u⁻¹ * tau D e * a.u) * (a.u⁻¹ * lam D e * a.u) := by group
        _ = (pi D e * tau D e) * (mu D e * lam D e) := by rw [a.tau_u D e, a.lam_u]
        _ = _ := by
          have hmodel : (modelElement 0 * modelElement 3) * (modelElement 1 * modelElement 6) =
              (modelElement 0 * modelElement 1) * (modelElement 3 * modelElement 6) := by decide +kernel
          simpa only [element, map_mul] using congrArg (D.a10ModelEmbedding e) hmodel
    rw [h]
    exact mul_mem (core_mem D e) (second_mem D e)

public theorem v_normalizes_four (b : VActor D e) :
    b.v ∈ normalizer (four D e : Set G) := by
  have hm : b.v⁻¹ * mu D e * b.v = mu D e := by
    rw [mul_assoc, ← b.mu_commute.eq, inv_mul_cancel_left]
  have hl : b.v⁻¹ * lam D e * b.v = lam D e := by
    rw [mul_assoc, ← b.lam_commute.eq, inv_mul_cancel_left]
  apply normalizes_four_of_conjugates
  · have h : b.v⁻¹ * (pi D e * mu D e) * b.v =
        (pi D e * mu D e) * (tau D e * lam D e) := by
      calc
        _ = (b.v⁻¹ * pi D e * b.v) * (b.v⁻¹ * mu D e * b.v) := by group
        _ = (pi D e * tau D e * lam D e) * mu D e := by rw [b.pi_v, hm]
        _ = _ := by
          have hmodel : (modelElement 0 * modelElement 3 * modelElement 6) * modelElement 1 =
              (modelElement 0 * modelElement 1) * (modelElement 3 * modelElement 6) := by decide +kernel
          simpa only [element, map_mul] using congrArg (D.a10ModelEmbedding e) hmodel
    rw [h]
    exact mul_mem (core_mem D e) (second_mem D e)
  · have h : b.v⁻¹ * (tau D e * lam D e) * b.v = pi D e * mu D e := by
      calc
        _ = (b.v⁻¹ * tau D e * b.v) * (b.v⁻¹ * lam D e * b.v) := by group
        _ = (pi D e * mu D e * lam D e) * lam D e := by rw [b.tau_v, hl]
        _ = _ := by
          have hs := element_square D e 6 (by decide)
          change lam D e ^ 2 = 1 at hs
          rw [mul_assoc, ← pow_two, hs, mul_one]
    rw [h]
    exact core_mem D e

public theorem mu'_normalizes_four : mu' D e ∈ normalizer (four D e : Set G) := by
  apply normalizes_four_of_conjugates
  · have h : (mu' D e)⁻¹ * (pi D e * mu D e) * mu' D e = pi D e * mu D e := by
      have hmodel : (modelElement 2)⁻¹ * (modelElement 0 * modelElement 1) * modelElement 2 =
          modelElement 0 * modelElement 1 := by decide +kernel
      simpa only [element, map_mul, map_inv] using congrArg (D.a10ModelEmbedding e) hmodel
    rw [h]
    exact core_mem D e
  · have h : (mu' D e)⁻¹ * (tau D e * lam D e) * mu' D e =
        (pi D e * mu D e) * (tau D e * lam D e) := by
      have hmodel : (modelElement 2)⁻¹ * (modelElement 3 * modelElement 6) * modelElement 2 =
          (modelElement 0 * modelElement 1) * (modelElement 3 * modelElement 6) := by decide +kernel
      simpa only [element, map_mul, map_inv] using congrArg (D.a10ModelEmbedding e) hmodel
    rw [h]
    exact mul_mem (core_mem D e) (second_mem D e)

public theorem four_le_section
    (s : NoncentralAnalysis.AlternatingSixSection
      (centralizer ({D.a10NoncentralInvolution e} : Set G)))
    (m : MarkedSection D e s) : four D e ≤ s.ambientSubgroup := by
  apply (closure_le _).mpr
  intro x hx
  rcases Set.mem_insert_iff.mp hx with rfl | hx
  · exact m.pi_mu_mem
  · have hx' := Set.mem_singleton_iff.mp hx
    subst x
    exact m.tau_lam_mem

end CommutingChoice
end Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction
