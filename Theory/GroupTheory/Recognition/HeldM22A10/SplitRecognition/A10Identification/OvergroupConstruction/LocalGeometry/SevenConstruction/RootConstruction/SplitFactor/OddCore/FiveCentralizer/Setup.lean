module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction.RootConstruction.SplitFactor.RootQuotient
public import Theory.PPrimeCore

/-!
# The marked four-group in a five-element centralizer

For an order-five element w of the given A6, work in the full ambient
centralizer C_G(w). Its central subgroup <w> lies in its odd core. The
marked mu and lambda belong to this centralizer, and conjugation by uv
cycles mu, lambda and their product. The internal centralizer of mu is
identified with the actual intersection C_G(mu) ∩ C_G(w).

These constructions use the corrected six-point data directly. They
assume neither a recognized root quotient nor an odd-core conclusion.
Source: D. Held, Illinois J. Math. 13 (1969), 224–240,
DOI 10.1215/ijm/1256053756, Lemma 5.3, printed p.236.
-/

open Subgroup
noncomputable section

namespace Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction.SplitFactor.OddCore.FiveCentralizer

variable {G : Type*} [Group G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer)
  (L : Source.SixLocalData D e) (w : G) (hwA : w ∈ L.A)

/-- The full ambient centralizer of the chosen five-element. -/
public abbrev ambient : Subgroup G := centralizer ({w} : Set G)

/-- The chosen element, viewed in its own centralizer. -/
@[expose] public def omega : ambient w := ⟨w, mem_centralizer_singleton_iff.mpr rfl⟩

/-- The central cyclic subgroup generated by the five-element. -/
public abbrev kernel : Subgroup (ambient w) := zpowers (omega w)

public theorem kernel_le_center : kernel w ≤ center (ambient w) := by
  apply zpowers_le.mpr
  rw [mem_center_iff]
  intro x
  exact Subtype.ext (mem_centralizer_singleton_iff.mp x.property)

public instance kernel_normal : (kernel w).Normal where
  conj_mem x hx g := by
    have hc := mem_center_iff.mp (kernel_le_center w hx) g
    simpa only [hc, mul_inv_cancel_right] using hx

public theorem kernel_card (hw : orderOf w = 5) : Nat.card (kernel w) = 5 := by
  rw [Nat.card_zpowers, ← orderOf_coe]
  exact hw

public theorem kernel_le_oddCore (hw : orderOf w = 5) :
    kernel w ≤ pPrimeCore 2 (ambient w) := by
  apply le_sSup
  exact ⟨inferInstance, by rw [kernel_card w hw]; decide⟩

/-- Held's mu, regarded as an element of the five-centralizer. -/
@[expose] public def first : ambient w := ⟨mu D e, mem_centralizer_singleton_iff.mpr
  (mem_centralizer_iff.mp (L.A_centralizes hwA) _ (by simp))⟩
/-- Held's lambda, regarded as an element of the five-centralizer. -/
@[expose] public def second : ambient w := ⟨lam D e, mem_centralizer_singleton_iff.mpr
  (mem_centralizer_iff.mp (L.A_centralizes hwA) _ (by simp))⟩
/-- The root uv cycles the three nontrivial elements of the four-group. -/
@[expose] public def cycler : ambient w := ⟨L.u * L.v, mem_centralizer_singleton_iff.mpr
  (L.root_centralizes w hwA).eq⟩

public theorem first_square : first D e L w hwA ^ 2 = 1 :=
  Subtype.ext (element_square D e 1 (by decide))
public theorem second_square : second D e L w hwA ^ 2 = 1 :=
  Subtype.ext (element_square D e 6 (by decide))
public theorem first_commute_second : Commute (first D e L w hwA) (second D e L w hwA) :=
  Subtype.ext (mu_commute_lam D e).eq

public theorem first_order : orderOf (first D e L w hwA) = 2 := by
  apply orderOf_eq_prime (first_square D e L w hwA)
  intro h
  exact element_ne_one D e 1 (congrArg Subtype.val h)

/-- The internal involution centralizer is the literal ambient intersection. -/
@[expose] public def firstCentralizerEquiv :
    centralizer ({first D e L w hwA} : Set (ambient w)) ≃*
      (centralizer ({mu D e} : Set G) ⊓ ambient w : Subgroup G) where
  toFun x := ⟨x.val.val, ⟨mem_centralizer_singleton_iff.mpr
    (congrArg Subtype.val (mem_centralizer_singleton_iff.mp x.property)), x.val.property⟩⟩
  invFun x := ⟨⟨x.val, x.property.2⟩, mem_centralizer_singleton_iff.mpr
    (Subtype.ext (mem_centralizer_singleton_iff.mp x.property.1))⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

public theorem cycle_first : (cycler D e L w hwA)⁻¹ * first D e L w hwA *
    cycler D e L w hwA = second D e L w hwA := by
  apply Subtype.ext
  change (L.u * L.v)⁻¹ * mu D e * (L.u * L.v) = lam D e
  calc
    _ = L.v⁻¹ * (L.u⁻¹ * mu D e * L.u) * L.v := by group
    _ = _ := by rw [L.mu_u, L.v_lam_commute.inv_left.eq, inv_mul_cancel_right]

public theorem cycle_second : (cycler D e L w hwA)⁻¹ * second D e L w hwA *
    cycler D e L w hwA = first D e L w hwA * second D e L w hwA := by
  apply Subtype.ext
  change (L.u * L.v)⁻¹ * lam D e * (L.u * L.v) = mu D e * lam D e
  calc
    _ = L.v⁻¹ * (L.u⁻¹ * lam D e * L.u) * L.v := by group
    _ = _ := by
      rw [L.lam_u, (L.v_mu_commute.mul_right L.v_lam_commute).inv_left.eq,
        inv_mul_cancel_right]

/-- Cauchy's theorem supplies an order-five element of the given A6. -/
public theorem exists_five [Finite G] : ∃ w ∈ L.A, orderOf w = 5 := by
  have hc : Nat.card L.A = 360 := by
    rw [Nat.card_congr L.alternatingEquiv.toEquiv, nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  have h5 : 5 ∣ Nat.card L.A := by rw [hc]; decide
  have : Fact (Nat.Prime 5) := ⟨by decide⟩
  obtain ⟨w, hw⟩ := exists_prime_orderOf_dvd_card' (G := L.A) 5 h5
  exact ⟨w, w.property, (orderOf_coe w).trans hw⟩

end Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction.SplitFactor.OddCore.FiveCentralizer
