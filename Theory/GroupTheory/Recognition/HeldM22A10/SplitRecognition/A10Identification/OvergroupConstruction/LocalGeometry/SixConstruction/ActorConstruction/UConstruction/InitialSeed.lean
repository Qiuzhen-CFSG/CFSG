module
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction.ActorConstruction.UConstruction.Seed
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction.ActorConstruction.UConstruction.InitialSeed.FourCycle
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.NoncentralAnalysis.Fusion.Geometry
import Mathlib.Tactic.Group

/-!
# Held's initial four-action element from the marked A₆

The marked four-group in A₆ is generated by pi*mu and tau*lambda.
A three-element c of A₆ cycles its nonidentity elements and centralizes
mu and lambda. Consequently the word g = (c²*tau')² induces the two
required three-cycles on <pi, tau> and <mu, lambda>.

The cube of g centralizes the elementary sixteen S. The known equality
C_G(S) = S implies g⁶ = 1, so u = g⁴ has order three and the same four
actions. This constructs the initial seed directly from the supplied
marked section. It requires neither a normalizer-order assumption nor
any previously constructed actor, and leaves both later normalizations
of u to their separate constructions.

Source: D. Held, Illinois J. Math. 13 (1969), 224--240,
DOI 10.1215/ijm/1256053756, Lemma 4.2, printed p.233.
This is an alternative to the initial normalizer-order argument using
the explicit marked A₆ supplied in the task. Conjugation is x^g = g⁻¹*x*g.
-/

open Subgroup Equiv
namespace Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction
namespace InitialSeed
variable {G : Type*} [Group G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer)

private theorem marked_four_relations :
    (pi D e * mu D e) ^ 2 = 1 ∧ pi D e * mu D e ≠ 1 ∧
    (tau D e * lam D e) ^ 2 = 1 ∧ tau D e * lam D e ≠ 1 ∧
    tau D e * lam D e ≠ pi D e * mu D e ∧
    Commute (pi D e * mu D e) (tau D e * lam D e) := by
  have hs₁ : (modelElement 0 * modelElement 1) ^ 2 = 1 := by decide +kernel
  have hn₁ : modelElement 0 * modelElement 1 ≠ 1 := by decide +kernel
  have hs₂ : (modelElement 3 * modelElement 6) ^ 2 = 1 := by decide +kernel
  have hn₂ : modelElement 3 * modelElement 6 ≠ 1 := by decide +kernel
  have hn₃ : modelElement 3 * modelElement 6 ≠ modelElement 0 * modelElement 1 := by decide +kernel
  have hc : Commute (modelElement 0 * modelElement 1) (modelElement 3 * modelElement 6) := by
    change _ * _ = _ * _
    decide +kernel
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa only [element, map_mul, map_pow, map_one] using congrArg (D.a10ModelEmbedding e) hs₁
  · intro h
    apply hn₁
    apply D.a10ModelEmbedding_injective e
    simpa only [element, map_mul, map_one] using h
  · simpa only [element, map_mul, map_pow, map_one] using congrArg (D.a10ModelEmbedding e) hs₂
  · intro h
    apply hn₂
    apply D.a10ModelEmbedding_injective e
    simpa only [element, map_mul, map_one] using h
  · intro h
    apply hn₃
    apply D.a10ModelEmbedding_injective e
    simpa only [element, map_mul] using h
  · simpa only [element, map_mul] using hc.map (D.a10ModelEmbedding e)

/-- The marked A₆ supplies a cycler of its four-group. Its centralization
of mu and lambda determines the two remaining actions on S. -/
private theorem exists_section_cycle
    (s : NoncentralAnalysis.AlternatingSixSection
      (centralizer ({D.a10NoncentralInvolution e} : Set G))) (m : MarkedSection D e s) :
    ∃ c : G, c⁻¹ * pi D e * c = pi D e * tau D e * lam D e ∧
      c⁻¹ * tau D e * c = pi D e * mu D e * lam D e ∧
      c⁻¹ * mu D e * c = mu D e ∧ c⁻¹ * lam D e * c = lam D e := by
  let A := s.ambientSubgroup
  let j := s.ambientAlternatingEquiv
  let f : alternatingGroup (Fin 6) →* G := A.subtype.comp j.symm.toMonoidHom
  have hf : Function.Injective f := Subtype.val_injective.comp j.symm.injective
  let a₀ : A := ⟨pi D e * mu D e, m.pi_mu_mem⟩
  let b₀ : A := ⟨tau D e * lam D e, m.tau_lam_mem⟩
  let a := j a₀
  let b := j b₀
  have fa : f a = pi D e * mu D e := congrArg Subtype.val (j.symm_apply_apply a₀)
  have fb : f b = tau D e * lam D e := congrArg Subtype.val (j.symm_apply_apply b₀)
  obtain ⟨ha, hane, hb, hbne, hba, hab⟩ := marked_four_relations D e
  obtain ⟨w, _, hwa, hwb⟩ := FourCycle.exists_alternating_cycler a b
    (hf (by simpa only [map_pow, map_one, fa] using ha))
    (fun h => hane (by rw [← fa, h, map_one]))
    (hf (by simpa only [map_pow, map_one, fb] using hb))
    (fun h => hbne (by rw [← fb, h, map_one]))
    (fun h => hba (by rw [← fb, ← fa, h]))
    (Commute.of_map hf (by simpa only [fa, fb] using hab))
  let c := f w
  let W := MulAut.conj c⁻¹
  have W_apply (x : G) : W x = c⁻¹ * x * c := by
    simp only [W, MulAut.conj_apply, inv_inv]
  have hcm : Commute c (mu D e) :=
    (mem_centralizer_iff.mp (m.centralizes (j.symm w).property) (mu D e) (by simp)).symm
  have hcl : Commute c (lam D e) :=
    (mem_centralizer_iff.mp (m.centralizes (j.symm w).property) (lam D e) (by simp)).symm
  have hm : W (mu D e) = mu D e := by
    rw [W_apply]
    rw [hcm.inv_left.eq, inv_mul_cancel_right]
  have hl : W (lam D e) = lam D e := by
    rw [W_apply]
    rw [hcl.inv_left.eq, inv_mul_cancel_right]
  have hpa : W (pi D e * mu D e) = (pi D e * mu D e) * (tau D e * lam D e) := by
    simpa only [W_apply, map_mul, map_inv, fa, fb] using congrArg f hwa
  have hpb : W (tau D e * lam D e) = pi D e * mu D e := by
    simpa only [W_apply, map_mul, map_inv, fa, fb] using congrArg f hwb
  refine ⟨c, ?_, ?_, by simpa only [W_apply] using hm, by simpa only [W_apply] using hl⟩
  · rw [← W_apply]
    apply mul_right_cancel (b := mu D e)
    calc
      _ = W (pi D e * mu D e) := by rw [map_mul, hm]
      _ = (pi D e * mu D e) * (tau D e * lam D e) := hpa
      _ = (pi D e * tau D e * lam D e) * mu D e := by
        simp only [pi, mu, tau, lam, element, ← map_mul]
        apply congrArg (D.a10ModelEmbedding e)
        decide +kernel
  · rw [← W_apply]
    apply mul_right_cancel (b := lam D e)
    calc
      _ = W (tau D e * lam D e) := by rw [map_mul, hl]
      _ = pi D e * mu D e := hpb
      _ = (pi D e * mu D e * lam D e) * lam D e := by
        simp only [pi, mu, lam, element, ← map_mul]
        apply congrArg (D.a10ModelEmbedding e)
        decide +kernel

private theorem tau'_actions :
    (tau' D e)⁻¹ * pi D e * tau' D e = pi D e ∧
    (tau' D e)⁻¹ * mu D e * tau' D e = pi D e * mu D e ∧
    (tau' D e)⁻¹ * tau D e * tau' D e = tau D e ∧
    (tau' D e)⁻¹ * lam D e * tau' D e = tau D e * lam D e := by
  have h :
      (modelElement 4)⁻¹ * modelElement 0 * modelElement 4 = modelElement 0 ∧
      (modelElement 4)⁻¹ * modelElement 1 * modelElement 4 = modelElement 0 * modelElement 1 ∧
      (modelElement 4)⁻¹ * modelElement 3 * modelElement 4 = modelElement 3 ∧
      (modelElement 4)⁻¹ * modelElement 6 * modelElement 4 = modelElement 3 * modelElement 6 := by
    decide +kernel
  rcases h with ⟨hp, hm, ht, hl⟩
  exact ⟨by simpa only [element, map_mul, map_inv] using congrArg (D.a10ModelEmbedding e) hp,
    by simpa only [element, map_mul, map_inv] using congrArg (D.a10ModelEmbedding e) hm,
    by simpa only [element, map_mul, map_inv] using congrArg (D.a10ModelEmbedding e) ht,
    by simpa only [element, map_mul, map_inv] using congrArg (D.a10ModelEmbedding e) hl⟩

/-- The word c² tau' c² tau' induces the desired pair of three-cycles on S. -/
private theorem exists_four_action_element
    (s : NoncentralAnalysis.AlternatingSixSection
      (centralizer ({D.a10NoncentralInvolution e} : Set G))) (m : MarkedSection D e s) :
    ∃ g : G, g⁻¹ * pi D e * g = tau D e ∧
      g⁻¹ * tau D e * g = pi D e * tau D e ∧
      g⁻¹ * mu D e * g = lam D e ∧ g⁻¹ * lam D e * g = mu D e * lam D e := by
  obtain ⟨c, hp, ht, hm, hl⟩ := exists_section_cycle D e s m
  obtain ⟨hzp, hzm, hzt, hzl⟩ := tau'_actions D e
  let W := MulAut.conj c⁻¹
  have W_apply (x : G) : W x = c⁻¹ * x * c := by
    simp only [W, MulAut.conj_apply, inv_inv]
  let T := MulAut.conj (tau' D e)⁻¹
  have T_apply (x : G) : T x = (tau' D e)⁻¹ * x * tau' D e := by
    simp only [T, MulAut.conj_apply, inv_inv]
  rw [← W_apply] at hp
  rw [← W_apply] at ht
  rw [← W_apply] at hm
  rw [← W_apply] at hl
  rw [← T_apply] at hzp
  rw [← T_apply] at hzm
  rw [← T_apply] at hzt
  rw [← T_apply] at hzl
  let g := c ^ 2 * tau' D e * c ^ 2 * tau' D e
  have hact (x : G) : g⁻¹ * x * g = T (W (W (T (W (W x))))) := by
    simp only [g, W, T, MulAut.conj_apply, inv_inv, pow_two]
    group
  refine ⟨g, ?_, ?_, ?_, ?_⟩
  all_goals
    rw [hact]
    simp only [map_mul, hp, ht, hm, hl, hzp, hzt, hzm, hzl]
    simp only [pi, mu, tau, lam, element, ← map_mul]
    apply congrArg (D.a10ModelEmbedding e)
    decide +kernel

/-- The kernel of the action on S is S itself and has exponent two.
Taking the fourth power removes this kernel from a lift of the three-cycle. -/
private theorem seed_of_four_actions [Finite G] (g : G)
    (hp : g⁻¹ * pi D e * g = tau D e)
    (ht : g⁻¹ * tau D e * g = pi D e * tau D e)
    (hm : g⁻¹ * mu D e * g = lam D e)
    (hl : g⁻¹ * lam D e * g = mu D e * lam D e) : Nonempty (USeed D e) := by
  let F := MulAut.conj g⁻¹
  have F_apply (x : G) : F x = g⁻¹ * x * g := by
    simp only [F, MulAut.conj_apply, inv_inv]
  rw [← F_apply] at hp
  rw [← F_apply] at ht
  rw [← F_apply] at hm
  rw [← F_apply] at hl
  have hfix : F (F (F (pi D e))) = pi D e ∧
      F (F (F (mu D e))) = mu D e ∧
      F (F (F (tau D e))) = tau D e ∧
      F (F (F (lam D e))) = lam D e := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · simp only [map_mul, hp, ht]
      simp only [pi, tau, element, ← map_mul]
      apply congrArg (D.a10ModelEmbedding e)
      decide +kernel
    · simp only [map_mul, hm, hl]
      simp only [mu, lam, element, ← map_mul]
      apply congrArg (D.a10ModelEmbedding e)
      decide +kernel
    · simp only [map_mul, hp, ht]
      simp only [pi, tau, element, ← map_mul]
      apply congrArg (D.a10ModelEmbedding e)
      decide +kernel
    · simp only [map_mul, hm, hl]
      simp only [mu, lam, element, ← map_mul]
      apply congrArg (D.a10ModelEmbedding e)
      decide +kernel
  obtain ⟨hfp, hfm, hft, hfl⟩ := hfix
  have hpow3 (x : G) : (g ^ 3)⁻¹ * x * g ^ 3 = F (F (F x)) := by
    simp only [F, MulAut.conj_apply, inv_inv, pow_succ, pow_zero]
    group
  have hcenter : g ^ 3 ∈ centralizer
      (NoncentralAnalysis.Fusion.ambientElementary D e 1 : Set G) := by
    apply mem_centralizer_iff.mpr
    rintro _ ⟨y, hy, rfl⟩
    obtain ⟨a, rfl⟩ := (NoncentralAnalysis.Fusion.mem_elementary 1 y).mp hy
    have hfixed : F (F (F (D.a10ModelEmbedding e
        (NoncentralAnalysis.Fusion.elementaryWord 1 a)))) =
        D.a10ModelEmbedding e (NoncentralAnalysis.Fusion.elementaryWord 1 a) := by
      simp only [NoncentralAnalysis.Fusion.elementaryWord, map_mul, map_pow]
      change F (F (F (pi D e))) ^ a.1.val * F (F (F (mu D e))) ^ a.2.1.val *
        F (F (F (tau D e))) ^ a.2.2.1.val * F (F (F (lam D e))) ^ a.2.2.2.val =
        pi D e ^ a.1.val * mu D e ^ a.2.1.val *
          tau D e ^ a.2.2.1.val * lam D e ^ a.2.2.2.val
      rw [hfp, hfm, hft, hfl]
    have hc := (hpow3 (D.a10ModelEmbedding e
      (NoncentralAnalysis.Fusion.elementaryWord 1 a))).trans hfixed
    calc
      _ = g ^ 3 * ((g ^ 3)⁻¹ * D.a10ModelEmbedding e
          (NoncentralAnalysis.Fusion.elementaryWord 1 a) * g ^ 3) := by group
      _ = _ := by rw [hc]
  have hmem : g ^ 3 ∈ NoncentralAnalysis.Fusion.ambientElementary D e 1 := by
    rwa [NoncentralAnalysis.Fusion.ambientElementary_selfCentralizing D e 1] at hcenter
  let := NoncentralAnalysis.Fusion.ambientElementary_isElementaryAbelian D e 1
  have h6 : g ^ 6 = 1 := by
    simpa only [← pow_mul] using elemPow_eq_one_of_isElementaryAbelian (p := 2) (g ^ 3) hmem
  have horder : (g ^ 4) ^ 3 = 1 := by
    calc
      _ = (g ^ 6) ^ 2 := by simp only [← pow_mul]
      _ = 1 := by rw [h6, one_pow]
  have hpow4 (x : G) : (g ^ 4)⁻¹ * x * g ^ 4 = F (F (F (F x))) := by
    simp only [F, MulAut.conj_apply, inv_inv, pow_succ, pow_zero]
    group
  have hup : (g ^ 4)⁻¹ * pi D e * g ^ 4 = tau D e := by rw [hpow4, hfp, hp]
  have hut : (g ^ 4)⁻¹ * tau D e * g ^ 4 = pi D e * tau D e := by rw [hpow4, hft, ht]
  have hum : (g ^ 4)⁻¹ * mu D e * g ^ 4 = lam D e := by rw [hpow4, hfm, hm]
  have hul : (g ^ 4)⁻¹ * lam D e * g ^ 4 = mu D e * lam D e := by rw [hpow4, hfl, hl]
  have hne : g ^ 4 ≠ 1 := by
    intro h
    have he : pi D e = tau D e := by simpa only [h, inv_one, one_mul, mul_one] using hup
    have hn : modelElement 0 ≠ modelElement 3 := by decide +kernel
    exact hn (D.a10ModelEmbedding_injective e he)
  exact ⟨⟨g ^ 4, orderOf_eq_prime horder hne, hup, hut, hum, hul⟩⟩

end InitialSeed

variable {G : Type*} [Group G]
/-- The initial four-action element of Held 4.2. The supplied marked A₆
already suffices for this construction; no normalizer-order or actor premise
is needed. The source nonfusion and simplicity hypotheses are retained. -/
public theorem exists_uSeed_of_markedSection [Finite G] [IsSimpleGroup G]
    (D : LocalData G) (e : D.centralizer ≃* CentralizerModels.a10Centralizer)
    (_hfusion : ¬ IsConj D.z (D.a10NoncentralInvolution e))
    (_hlam : ¬ IsConj (pi D e) (lam D e))
    (_hxi : ¬ IsConj (pi D e) (xi D e))
    (s : NoncentralAnalysis.AlternatingSixSection
      (centralizer ({D.a10NoncentralInvolution e} : Set G))) (m : MarkedSection D e s) :
    Nonempty (USeed D e) := by
  obtain ⟨g, hp, ht, hm, hl⟩ := InitialSeed.exists_four_action_element D e s m
  exact InitialSeed.seed_of_four_actions D e g hp ht hm hl

end Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SixConstruction
