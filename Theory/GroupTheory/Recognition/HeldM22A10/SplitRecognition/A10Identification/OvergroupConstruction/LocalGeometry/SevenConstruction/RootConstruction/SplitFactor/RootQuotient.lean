module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction.RootConstruction.Factor

/-!
# The central root quotient in Held's Lemma 5.4

We take the quotient of the full ambient centralizer of `uv` by its central
subgroup generated by `uv`. The given A6 lies in that centralizer and intersects
the root subgroup trivially, since A6 has trivial center. These constructions
give an actual embedded A6 in the quotient, using only the corrected six-point
data, with no recognition hypothesis. The concrete double-transposition
centralizer in A7 fixes the model used by the remaining local recognition step.

Source: D. Held, Illinois J. Math. 13 (1969), 224–240,
DOI 10.1215/ijm/1256053756, Lemma 5.4, pp.236–237.
-/

open Subgroup Equiv

namespace Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction.SplitFactor

variable {G : Type*} [Group G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer)
  (L : Source.SixLocalData D e)

/-- The full ambient centralizer, not a prescribed local subgroup. -/
public abbrev rootCentralizer : Subgroup G := centralizer ({L.u * L.v} : Set G)

/-- The root viewed in its full centralizer. -/
@[expose] public def centralRoot : rootCentralizer D e L :=
  ⟨L.u * L.v, mem_centralizer_singleton_iff.mpr rfl⟩

/-- The order-three kernel inside the root centralizer. -/
public abbrev rootKernel : Subgroup (rootCentralizer D e L) :=
  zpowers (centralRoot D e L)

public theorem rootKernel_le_center :
    rootKernel D e L ≤ center (rootCentralizer D e L) := by
  apply zpowers_le.mpr
  rw [mem_center_iff]
  intro x
  apply Subtype.ext
  exact mem_centralizer_singleton_iff.mp x.property

public instance rootKernel_normal : (rootKernel D e L).Normal where
  conj_mem x hx g := by
    have hc := mem_center_iff.mp (rootKernel_le_center D e L hx) g
    simpa only [hc, mul_inv_cancel_right] using hx

/-- The quotient that must actually be recognized as A7. -/
public abbrev rootQuotient := rootCentralizer D e L ⧸ rootKernel D e L

public theorem centralRoot_order : orderOf (centralRoot D e L) = 3 := by
  rw [← Subgroup.orderOf_coe]
  exact root_order D e L

public theorem rootKernel_card : Nat.card (rootKernel D e L) = 3 := by
  rw [Nat.card_zpowers, centralRoot_order D e L]

public theorem rootKernel_map :
    (rootKernel D e L).map (rootCentralizer D e L).subtype = zpowers (L.u * L.v) := by
  exact MonoidHom.map_zpowers _ _

public theorem A_le_rootCentralizer : L.A ≤ rootCentralizer D e L := by
  intro a ha
  exact mem_centralizer_singleton_iff.mpr (L.root_centralizes a ha).symm.eq

/-- The actual A6, restricted to the full root centralizer. -/
public abbrev rootSix : Subgroup (rootCentralizer D e L) :=
  L.A.subgroupOf (rootCentralizer D e L)

public noncomputable def rootSixEquiv : rootSix D e L ≃* alternatingGroup (Fin 6) :=
  (subgroupOfEquivOfLe (A_le_rootCentralizer D e L)).trans L.alternatingEquiv

public theorem rootSix_card : Nat.card (rootSix D e L) = 360 := by
  rw [Nat.card_congr (rootSixEquiv D e L).toEquiv, nat_card_alternatingGroup]
  norm_num [Nat.factorial]

public theorem rootKernel_disjoint_six : Disjoint (rootKernel D e L) (rootSix D e L) := by
  apply Subgroup.disjoint_def.mpr
  intro x hxR hxA
  let a : rootSix D e L := ⟨x, hxA⟩
  have ha : a ∈ center (rootSix D e L) := by
    rw [mem_center_iff]
    intro b
    apply Subtype.ext
    exact mem_center_iff.mp (rootKernel_le_center D e L hxR) b
  have he : rootSixEquiv D e L a ∈ center (alternatingGroup (Fin 6)) := by
    rw [mem_center_iff]
    intro b
    obtain ⟨c, rfl⟩ := (rootSixEquiv D e L).surjective b
    simpa only [map_mul] using congrArg (rootSixEquiv D e L) (mem_center_iff.mp ha c)
  rw [alternatingGroup.center_eq_bot (by simp)] at he
  have ha1 : a = 1 := (rootSixEquiv D e L).injective (by simpa using he)
  exact congrArg Subtype.val ha1

/-- Restriction of the quotient map to the given A6. -/
@[expose] public def rootSixToQuotient : rootSix D e L →* rootQuotient D e L :=
  (QuotientGroup.mk' (rootKernel D e L)).comp (rootSix D e L).subtype

public theorem rootSixToQuotient_injective : Function.Injective (rootSixToQuotient D e L) := by
  apply (rootSixToQuotient D e L).ker_eq_bot_iff.mp
  apply le_bot_iff.mp
  intro x hx
  have hxR : (x : rootCentralizer D e L) ∈ rootKernel D e L :=
    (QuotientGroup.eq_one_iff _).mp hx
  have hxone : (x : rootCentralizer D e L) = 1 :=
    Subgroup.disjoint_def.mp (rootKernel_disjoint_six D e L) hxR x.property
  exact Subtype.ext hxone

/-- The actual image of the marked A6 in the central quotient. -/
public abbrev quotientSix : Subgroup (rootQuotient D e L) := (rootSixToQuotient D e L).range

/-- The image retains the given A6 identification, since the kernel is disjoint. -/
public noncomputable def quotientSixEquiv : quotientSix D e L ≃* alternatingGroup (Fin 6) :=
  (MonoidHom.ofInjective (rootSixToQuotient_injective D e L)).symm.trans (rootSixEquiv D e L)

public theorem quotientSix_card : Nat.card (quotientSix D e L) = 360 := by
  rw [Nat.card_congr (quotientSixEquiv D e L).toEquiv, nat_card_alternatingGroup]
  norm_num [Nat.factorial]

/-- A double transposition in the concrete seven-point alternating group. -/
@[expose] public def sevenInvolution : alternatingGroup (Fin 7) :=
  ⟨swap 0 1 * swap 2 3, by
    rw [Equiv.Perm.mem_alternatingGroup]
    decide +kernel⟩

public theorem sevenInvolution_order : orderOf sevenInvolution = 2 :=
  orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The full centralizer of the concrete double transposition. An identification
with this subgroup is a remaining local theorem, not part of the six-point data. -/
public abbrev sevenInvolutionCentralizer : Subgroup (alternatingGroup (Fin 7)) :=
  centralizer ({sevenInvolution} : Set (alternatingGroup (Fin 7)))

end Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction.SplitFactor
