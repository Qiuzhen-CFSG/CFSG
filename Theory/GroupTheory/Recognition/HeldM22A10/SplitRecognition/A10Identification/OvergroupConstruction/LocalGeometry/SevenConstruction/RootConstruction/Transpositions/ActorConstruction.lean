module

public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction.RootConstruction.Transpositions.SixCycler
public import Theory.GroupTheory.Recognition.HeldM22A10.SplitRecognition.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction.RootConstruction.Transpositions.SixParity
import Mathlib.Tactic.Group
/-!
# Constructing the actor for Held's transposition theorem

Inside the supplied A6, put p = pi*mu and q = mu'*xi. They are distinct
commuting involutions. The supplied S6 extension and its exact even subgroup
allow `SixCycler` to construct beta in A6, cycling p, q and pq and normalizing
the eight-group generated by them and mu-prime. Put alpha = tau'*beta*tau'.
The coordinate identities give the earlier alpha relations and beta lies in W;
`commute_v_of_beta_mem` therefore recovers Held 5.9.

There are four possible images of mu-prime under alpha. The fusion of p and q
inside A6 shows that mu*mu'*xi is conjugate to pi. The local rho actions and
the same A6 conjugacy put mu', mu*mu' and xi*mu' in the mu class. Nonfusion of
pi and mu then rules out three images, proving (mu')^alpha = mu*mu'.
Thus the actor is constructed from the given six-point geometry; no earlier
actor existence, global recognition, or compatible seven-point marking is used.

Source: D. Held, *A Characterization of some multiply transitive permutation
groups, I*, Illinois J. Math. 13 (1969), 224–240,
DOI 10.1215/ijm/1256053756, Lemmas 5.9–5.10, printed p.238.
Conjugation in the source means x^g = g⁻¹*x*g.
-/

open Subgroup Equiv
namespace Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction
open NoncentralAnalysis.CentralizerStructure.FaithfulExclusion
variable {G : Type*} [Group G] (D : LocalData G)
  (e : D.centralizer ≃* CentralizerModels.a10Centralizer) (L : Source.SixLocalData D e)
  (F : RootFactor D e L)
local notation "π" => pi D e
local notation "μ" => mu D e
local notation "a" => mu' D e
local notation "ξ" => xi D e
local notation "t" => tau' D e
include F in
private theorem exists_six_actor : ∃ b : G, b ∈ L.A ∧ b ^ 3 = 1 ∧
    b⁻¹ * (π * μ) * b = (π * μ) * (a * ξ) ∧
    b⁻¹ * (a * ξ) * b = π * μ ∧
    b⁻¹ * a * b ∈ ({a, (π * μ) * a, (a * ξ) * a, (π * μ) * (a * ξ) * a} : Set G) := by
  let X : Subgroup G := L.A ⊔ zpowers a
  let r : X := ⟨π * μ, (show L.A ≤ X from le_sup_left) L.pi_mu_mem⟩
  let q : X := ⟨a * ξ, (show L.A ≤ X from le_sup_left) L.mu'_xi_mem⟩
  let m : X := ⟨a, (show zpowers a ≤ X from le_sup_right) (mem_zpowers _)⟩
  let s := L.symmetricEquiv
  have heven (x : X) : Perm.sign (s x) = 1 ↔ (x : G) ∈ L.A := by
    change x ∈ (alternatingGroup (Fin 6)).comap s.toMonoidHom ↔ _
    rw [six_even_subgroup D e L]
    rfl
  have hr : r ^ 2 = 1 ∧ r ≠ 1 := by
    constructor
    · apply Subtype.ext
      have h : (modelElement 0 * modelElement 1) ^ 2 = 1 := by decide +kernel
      simpa only [r, Subgroup.coe_pow, Subgroup.coe_one, element, map_mul, map_pow, map_one] using
        congrArg (D.a10ModelEmbedding e) h
    · intro h
      have he := congrArg (fun x : X => (x : G)) h
      have hn : modelElement 0 * modelElement 1 ≠ 1 := by decide +kernel
      apply hn
      apply D.a10ModelEmbedding_injective e
      simpa only [r, Subgroup.coe_one, element, map_mul, map_one] using he
  have hq : q ^ 2 = 1 ∧ q ≠ 1 := by
    constructor
    · apply Subtype.ext
      have h : (modelElement 2 * modelElement 7) ^ 2 = 1 := by decide +kernel
      simpa only [q, Subgroup.coe_pow, Subgroup.coe_one, element, map_mul, map_pow, map_one] using
        congrArg (D.a10ModelEmbedding e) h
    · intro h
      have he := congrArg (fun x : X => (x : G)) h
      have hn : modelElement 2 * modelElement 7 ≠ 1 := by decide +kernel
      apply hn
      apply D.a10ModelEmbedding_injective e
      simpa only [q, Subgroup.coe_one, element, map_mul, map_one] using he
  have hqr : q ≠ r := by
    intro h
    have hn : modelElement 2 * modelElement 7 ≠ modelElement 0 * modelElement 1 := by decide +kernel
    apply hn
    apply D.a10ModelEmbedding_injective e
    simpa only [q, r, element, map_mul] using congrArg (fun x : X => (x : G)) h
  have hm : m ^ 2 = 1 := Subtype.ext (element_square D e 2 (by decide))
  have hms : Perm.sign (s m) ≠ 1 := by
    intro h
    exact F.mu'_not_mem D e L (F.A_le D e L ((heven m).mp h))
  have hc : Commute r q ∧ Commute r m ∧ Commute q m := by
    have h : Commute (modelElement 0 * modelElement 1) (modelElement 2 * modelElement 7) ∧
        Commute (modelElement 0 * modelElement 1) (modelElement 2) ∧
        Commute (modelElement 2 * modelElement 7) (modelElement 2) := by
      change _ * _ = _ * _ ∧ _ * _ = _ * _ ∧ _ * _ = _ * _
      decide +kernel
    refine ⟨Subtype.ext ?_, Subtype.ext ?_, Subtype.ext ?_⟩
    · simpa only [Subgroup.coe_mul, r, q, element, map_mul] using (h.1.map (D.a10ModelEmbedding e)).eq
    · simpa only [Subgroup.coe_mul, r, m, element, map_mul] using (h.2.1.map (D.a10ModelEmbedding e)).eq
    · simpa only [Subgroup.coe_mul, q, m, element, map_mul] using (h.2.2.map (D.a10ModelEmbedding e)).eq
  obtain ⟨b, hb3, hbs, hbr, hbq, hbm⟩ := SixCycler.exists_cycler (s r) (s q) (s m)
    (by rw [← map_pow, hr.1, map_one]) (fun h => hr.2 (s.injective (h.trans (map_one s).symm)))
    ((heven r).mpr L.pi_mu_mem)
    (by rw [← map_pow, hq.1, map_one]) (fun h => hq.2 (s.injective (h.trans (map_one s).symm)))
    ((heven q).mpr L.mu'_xi_mem) (fun h => hqr (s.injective h))
    (by rw [← map_pow, hm, map_one]) hms
    (hc.1.map s.toMonoidHom) (hc.2.1.map s.toMonoidHom) (hc.2.2.map s.toMonoidHom)
  let y := s.symm b
  have hA : (y : G) ∈ L.A := (heven y).mp (by simpa only [y, s.apply_symm_apply] using hbs)
  have hy3 : y ^ 3 = 1 := by
    apply s.injective
    simpa only [map_pow, map_one, y, s.apply_symm_apply] using hb3
  have hyr : y⁻¹ * r * y = r * q := by
    apply s.injective
    simpa only [map_mul, map_inv, y, s.apply_symm_apply] using hbr
  have hyq : y⁻¹ * q * y = r := by
    apply s.injective
    simpa only [map_mul, map_inv, y, s.apply_symm_apply] using hbq
  refine ⟨y, hA, congrArg Subtype.val hy3, congrArg Subtype.val hyr,
    congrArg Subtype.val hyq, ?_⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hbm ⊢
  rcases hbm with h | h | h | h
  · left
    have hh : y⁻¹ * m * y = m := by
      apply s.injective
      simpa only [map_mul, map_inv, y, s.apply_symm_apply] using h
    exact congrArg Subtype.val hh
  · right; left
    have hh : y⁻¹ * m * y = r * m := by
      apply s.injective
      simpa only [map_mul, map_inv, y, s.apply_symm_apply] using h
    exact congrArg Subtype.val hh
  · right; right; left
    have hh : y⁻¹ * m * y = q * m := by
      apply s.injective
      simpa only [map_mul, map_inv, y, s.apply_symm_apply] using h
    exact congrArg Subtype.val hh
  · right; right; right
    have hh : y⁻¹ * m * y = r * q * m := by
      apply s.injective
      simpa only [map_mul, map_inv, y, s.apply_symm_apply] using h
    exact congrArg Subtype.val hh

private theorem model_pi_bridge : NoncentralAnalysis.Coordinates.pi = modelElement 0 := by decide +kernel
private theorem model_mu_bridge : NoncentralAnalysis.Coordinates.mu = modelElement 1 := by decide +kernel
private theorem model_xi_bridge : NoncentralAnalysis.Coordinates.xi = modelElement 7 := by decide +kernel

/-- Recover Held's actor, including its placement and the additional mu-prime
conjugation, from the supplied corrected A6 geometry and pi–mu nonfusion. -/
public theorem exists_rootTranspositionActor [Finite G]
    (hfusion : ¬ IsConj D.z (D.a10NoncentralInvolution e)) :
    Nonempty (RootTranspositionActor D e L F) := by
  obtain ⟨b, hb, hb3, hbr, hbq, hba⟩ := exists_six_actor D e L F
  let f := MulAut.conj t
  have ht2 : t * t = 1 := by simpa only [pow_two] using element_square D e 4 (by decide)
  have ff (x : G) : f (f x) = x := by
    change t * (t * x * t⁻¹) * t⁻¹ = x
    rw [coordinate_inv D e 4 (by decide)]
    calc
      _ = (t * t) * x * (t * t) := by group
      _ = x := by rw [ht2, one_mul, mul_one]
  have fa : f a = a := tau'_mu' D e
  have fμ : f μ = π * μ := by
    have h : modelElement 4 * modelElement 1 * (modelElement 4)⁻¹ =
        modelElement 0 * modelElement 1 := by decide +kernel
    simpa only [f, MulAut.conj_apply, element, map_mul, map_inv] using
      congrArg (D.a10ModelEmbedding e) h
  have fr : f (π * μ) = μ := by rw [← fμ, ff]
  have fξ : f ξ = a * ξ := by
    simpa only [f, MulAut.conj_apply, coordinate_inv D e 4 (by decide)] using tau'_xi D e
  have fq : f (a * ξ) = ξ := by rw [← fξ, ff]
  have hbμ : Commute b μ :=
    (mem_centralizer_iff.mp (L.A_centralizes hb) μ (by simp)).symm
  have hαr : Commute (f b) (π * μ) := by
    have hh : Commute (f b) (f μ) := hbμ.map f.toMonoidHom
    rwa [fμ] at hh
  have hαμ : (f b)⁻¹ * μ * (f b) = μ * ξ := by
    simpa only [map_mul, map_inv, fr, fq] using congrArg f hbr
  have hαξ : (f b)⁻¹ * ξ * (f b) = μ := by
    simpa only [map_mul, map_inv, fr, fq] using congrArg f hbq
  let c := MulAut.conj (f b)⁻¹
  have hc (x : G) : c x = (f b)⁻¹ * x * f b := by simp only [c, MulAut.conj_apply, inv_inv]
  have hcμ : c μ = μ * ξ := (hc μ).trans hαμ
  have hcξ : c ξ = μ := (hc ξ).trans hαξ
  have hcr : c (π * μ) = π * μ := by
    rw [hc]
    rw [hαr.inv_left.eq, inv_mul_cancel_right]
  have hcπ : c π = π * ξ := by
    have hr := hcr
    rw [map_mul, hcμ] at hr
    apply mul_right_cancel (b := μ * ξ)
    rw [hr]
    have h : (modelElement 0 * modelElement 7) * (modelElement 1 * modelElement 7) =
        modelElement 0 * modelElement 1 := by decide +kernel
    simpa only [element, map_mul] using (congrArg (D.a10ModelEmbedding e) h).symm
  let ar : AlphaRelations D e 0 := {
    alpha := f b
    cube := by rw [← map_pow, hb3, map_one]
    corePi_commute := by simpa only [corePi, model_pi_bridge, model_mu_bridge, map_mul, element] using hαr
    xi_alpha := by simpa only [normalizedXi, Fin.val_zero, pow_zero, one_mul, model_xi_bridge, model_mu_bridge, element] using hαξ
    pi_alpha := by simpa only [normalizedXi, Fin.val_zero, pow_zero, one_mul, model_xi_bridge, model_pi_bridge, element, map_mul, hc] using hcπ
  }
  have hchoices : c a ∈ ({a, μ * a, ξ * a, μ * ξ * a} : Set G) := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hba ⊢
    rcases hba with h | h | h | h
    · left
      simpa only [hc, map_mul, map_inv, fa] using congrArg f h
    · right; left
      simpa only [hc, map_mul, map_inv, fa, fr] using congrArg f h
    · right; right; left
      simpa only [hc, map_mul, map_inv, fa, fq] using congrArg f h
    · right; right; right
      simpa only [hc, map_mul, map_inv, fa, fr, fq] using congrArg f h
  -- The bad involution is fused with pi inside the supplied A6 extension.
  have hbad : IsConj D.z (μ * a * ξ) := by
    rw [← pi_eq D e]
    apply IsConj.symm
    apply isConj_iff.mpr
    refine ⟨b⁻¹, ?_⟩
    simp only [inv_inv]
    calc
      _ = μ * (b⁻¹ * (a * ξ) * b) := by
        calc
          _ = ((b⁻¹ * μ) * a) * ξ * b := by group
          _ = _ := by rw [hbμ.inv_left.eq]; group
      _ = π := by
        rw [hbq]
        have h : modelElement 1 * (modelElement 0 * modelElement 1) = modelElement 0 := by decide +kernel
        simpa only [element, map_mul] using congrArg (D.a10ModelEmbedding e) h
  have hma : IsConj μ a := by
    apply isConj_iff.mpr
    refine ⟨rho D e, ?_⟩
    have h : modelElement 5 * modelElement 1 * (modelElement 5)⁻¹ = modelElement 2 := by decide +kernel
    simpa only [element, map_mul, map_inv] using congrArg (D.a10ModelEmbedding e) h
  have hmμa : IsConj μ (μ * a) := by
    apply isConj_iff.mpr
    refine ⟨(rho D e)⁻¹, ?_⟩
    have h : (modelElement 5)⁻¹ * modelElement 1 * ((modelElement 5)⁻¹)⁻¹ =
        modelElement 1 * modelElement 2 := by decide +kernel
    simpa only [element, map_mul, map_inv] using congrArg (D.a10ModelEmbedding e) h
  have hmξa : IsConj μ (ξ * a) := by
    have h1 : IsConj μ (π * μ) := isConj_iff.mpr ⟨t, fμ⟩
    have h2 : IsConj (a * ξ) (π * μ) := isConj_iff.mpr ⟨b⁻¹, by simpa only [inv_inv] using hbq⟩
    rw [(mu'_commute_xi D e).eq] at h2
    exact h1.trans h2.symm
  have hcconj (x : G) : IsConj x (c x) := isConj_iff.mpr ⟨(f b)⁻¹, rfl⟩
  have hnotbad : ¬ IsConj μ (μ * a * ξ) := by
    intro h
    exact hfusion (hbad.trans h.symm)
  have hca : c a = μ * a := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hchoices
    rcases hchoices with h | h | h | h
    · exfalso
      apply hnotbad
      have he : c (μ * a) = μ * a * ξ := by
        rw [map_mul, hcμ, h, mul_assoc, (mu'_commute_xi D e).symm.eq, ← mul_assoc]
      exact hmμa.trans (he ▸ hcconj (μ * a))
    · exact h
    · exfalso
      apply hnotbad
      have he : c (ξ * a) = μ * a * ξ := by
        rw [map_mul, hcξ, h, mul_assoc, (mu'_commute_xi D e).symm.eq, ← mul_assoc]
      exact hmξa.trans (he ▸ hcconj (ξ * a))
    · exfalso
      apply hnotbad
      have he : c a = μ * a * ξ := by
        rw [h, mul_assoc, (mu'_commute_xi D e).symm.eq, ← mul_assoc]
      exact hma.trans (he ▸ hcconj a)
  refine ⟨{ relations := ar, mu'_alpha := (hc a).symm.trans hca, beta_mem := ?_ }⟩
  have hbb : t * ar.alpha * t = b := by
    simpa only [ar, f, MulAut.conj_apply, coordinate_inv D e 4 (by decide)] using ff b
  rw [hbb]
  exact F.A_le D e L hb

end Theory.GroupTheory.HeldM22A10.A10Identification.OvergroupConstruction.LocalGeometry.SevenConstruction
