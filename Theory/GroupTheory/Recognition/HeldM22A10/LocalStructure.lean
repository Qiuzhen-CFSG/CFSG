module

public import Theory.GroupTheory.Recognition.HeldM22A10.Setup
public import Theory.GroupTheory.PGroup.CyclicInvolution
public import Mathlib.Data.Fintype.Perm

/-!
# Elementary consequences of the Held local hypotheses

For the chosen involution centralizer H and normal elementary subgroup F,
we prove |H| = 384, |T| = 128, F lies in the restricted Sylow subgroup, and
Z(H) is generated by the specified involution. In particular, that involution
belongs to F and |Z(H)| = 2.

The quotient S4 gives the order of H and has trivial center, forcing Z(H)
into F. A nonidentity element of Z(H) is then an involution central in T;
cyclicity of Z(T) identifies it with the specified involution. The Sylow order
follows by taking the two-part of 384. The S4 center calculation is checked
by kernel reduction over its twenty-four permutations.

These are preliminary consequences of Huppert--Blackburn, *Finite Groups III*,
XII, 1.18(b), printed p.314. They do not yet prove the asserted splitting or
the global M22/A10 alternative. None requires simplicity of the ambient group.
-/

open Subgroup
namespace Theory.GroupTheory.HeldM22A10.LocalData
universe u
variable {G : Type u} [Group G] (D : LocalData G)

/-- The cyclic Sylow center has exactly one involution. -/
public theorem involution_unique [Finite G] (j : center D.sylow) (hj : orderOf j = 2) :
    j = D.involution := by
  let := D.cyclic_center
  exact IsCyclic.eq_of_orderOf_eq_two hj D.involution_order

/-- The normal elementary two-subgroup lies in the chosen local Sylow subgroup. -/
public theorem kernel_le_localSylow [Finite G] : D.kernel ≤ D.localSylow := by
  let := D.kernel_normal
  let := D.kernel_elementary
  exact (IsElementaryAbelian.isPGroup 2 D.kernel).le_sylow_of_normal D.localSylow

/-- The order of the actual centralizer is 16 times 24. -/
public theorem centralizer_card : Nat.card D.centralizer = 384 := by
  let := D.kernel_normal
  rw [Subgroup.card_eq_card_quotient_mul_card_subgroup D.kernel,
    Nat.card_congr D.quotientEquiv.toEquiv, D.kernel_card]
  rw [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin]
  decide +kernel

/-- The original ambient Sylow subgroup has order 128. -/
public theorem sylow_card [Finite G] : Nat.card D.sylow = 128 := by
  have hlocal : Nat.card D.localSylow = 128 := by
    rw [Sylow.card_eq_multiplicity, D.centralizer_card]
    decide +kernel
  have he := Nat.card_congr (Subgroup.subgroupOfEquivOfLe D.sylow_le_centralizer).toEquiv
  exact he.symm.trans hlocal

private theorem perm_four_center_trivial (x : Equiv.Perm (Fin 4))
    (hx : x ∈ center (Equiv.Perm (Fin 4))) : x = 1 := by
  have h : ∀ a : Equiv.Perm (Fin 4), (∀ b, b * a = a * b) → a = 1 := by
    decide +kernel
  exact h x (mem_center_iff.mp hx)

/-- The center maps trivially into the symmetric quotient. -/
public theorem center_le_kernel : center D.centralizer ≤ D.kernel := by
  let := D.kernel_normal
  intro x hx
  let f : D.centralizer →* Equiv.Perm (Fin 4) :=
    D.quotientEquiv.toMonoidHom.comp (QuotientGroup.mk' D.kernel)
  have hsurj : Function.Surjective f :=
    D.quotientEquiv.surjective.comp (QuotientGroup.mk'_surjective D.kernel)
  have hfc : f x ∈ center (Equiv.Perm (Fin 4)) := by
    apply mem_center_iff.mpr
    intro y
    obtain ⟨a, rfl⟩ := hsurj y
    simpa only [map_mul] using congrArg f (mem_center_iff.mp hx a)
  have hf : f x = 1 := perm_four_center_trivial (f x) hfc
  have hq : QuotientGroup.mk' D.kernel x = 1 := by
    apply D.quotientEquiv.injective
    exact hf.trans D.quotientEquiv.map_one.symm
  exact (QuotientGroup.eq_one_iff x).mp hq

/-- The specified involution belongs to the normal elementary subgroup. -/
public theorem centralInvolution_mem_kernel : D.centralInvolution ∈ D.kernel :=
  D.center_le_kernel D.centralInvolution_mem_center

/-- The center of the centralizer is generated by the specified involution. -/
public theorem center_eq_zpowers [Finite G] :
    center D.centralizer = zpowers D.centralInvolution := by
  apply le_antisymm
  · intro x hx
    by_cases hx1 : x = 1
    · simp [hx1]
    have hxF : x ∈ D.kernel := D.center_le_kernel hx
    have hxT : (x : G) ∈ D.sylow := D.kernel_le_localSylow hxF
    let xT : D.sylow := ⟨x, hxT⟩
    have hxZ : xT ∈ center D.sylow := by
      apply mem_center_iff.mpr
      intro t
      exact Subtype.ext (congrArg (fun a : D.centralizer => (a : G))
        (mem_center_iff.mp hx ⟨t, D.sylow_le_centralizer t.property⟩))
    have hx2 : orderOf x = 2 := by
      let := D.kernel_elementary
      exact orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian (p := 2) x hxF) hx1
    have hxT2 : orderOf (⟨xT, hxZ⟩ : center D.sylow) = 2 := by
      simpa only [Subgroup.orderOf_mk, xT, Subgroup.orderOf_coe] using hx2
    have heq := D.involution_unique ⟨xT, hxZ⟩ hxT2
    have hxj : x = D.centralInvolution :=
      Subtype.ext (congrArg (fun a : center D.sylow => ((a : D.sylow) : G)) heq)
    exact hxj ▸ mem_zpowers D.centralInvolution
  · exact zpowers_le.mpr D.centralInvolution_mem_center

/-- The center of the actual centralizer has order two. -/
public theorem center_card [Finite G] : Nat.card (center D.centralizer) = 2 := by
  rw [D.center_eq_zpowers, Nat.card_zpowers]
  simpa only [centralInvolution, Subgroup.orderOf_mk] using D.z_order

end Theory.GroupTheory.HeldM22A10.LocalData
