module

public import Theory.SpecificGroups.SymmetricSix.Parabolics.TwoCores.Duad.Calculation
public import Mathlib.GroupTheory.SpecificGroups.KleinFour

/-!
# The four Klein subgroups of the actual symmetric group on four letters

The normal four and the three fours generated by disjoint transpositions
exhaust the Klein subgroups. The normal four normalizes all four, while the
other three are conjugate. Only pairs of actual four-letter permutations are
enumerated; no enumeration of arbitrary subgroups is used.

Source: Aschbacher, *Sporadic Groups* (1994), Exercise 2(1), printed p.249.
-/

@[expose] public section

open Subgroup
namespace Theory.GroupTheory.Recognition.AlternatingSixCubicTI.NativeFour
open Theory.SpecificGroups.SymmetricSix.DuadCalculation

def leftSwap (i:Fin 3):Four :=
  if i=0 then Equiv.swap 0 1 else if i=1 then Equiv.swap 0 2 else Equiv.swap 0 3

def rightSwap (i:Fin 3):Four :=
  if i=0 then Equiv.swap 2 3 else if i=1 then Equiv.swap 1 3 else Equiv.swap 1 2

def splitFour (i:Fin 3):Subgroup Four where
  carrier := {g | g=1 ∨ g=leftSwap i ∨ g=rightSwap i ∨ g=leftSwap i*rightSwap i}
  one_mem' := Or.inl rfl
  mul_mem' := by revert i; decide +kernel
  inv_mem' := by revert i; decide +kernel

instance (i:Fin 3):DecidablePred (·∈splitFour i) := fun _=>inferInstanceAs (Decidable (_∨_∨_∨_))

theorem splitFour_card (i:Fin 3):Nat.card (splitFour i)=4 := by
  rw [Nat.card_eq_fintype_card]
  revert i
  decide +kernel

instance core_klein : IsKleinFour core where
  card_four := core_card
  exponent_two := by
    let : Fact (Nat.Prime 2):=⟨by decide⟩
    let : Nontrivial core:=Finite.one_lt_card_iff_nontrivial.mp (by rw [core_card]; decide)
    exact IsElementaryAbelian.exponent_eq_prime

instance splitFour_klein (i:Fin 3):IsKleinFour (splitFour i) where
  card_four := splitFour_card i
  exponent_two := by
    let : Nontrivial (splitFour i):=Finite.one_lt_card_iff_nontrivial.mp (by rw [splitFour_card]; decide)
    apply (Monoid.exponent_eq_prime_iff (by decide : Nat.Prime 2)).mpr
    intro x hx
    let : Fact (Nat.Prime 2):=⟨by decide⟩
    apply orderOf_eq_prime _ hx
    apply Subtype.ext
    exact (show ∀i:Fin 3,∀x:Four,x∈splitFour i→x^2=1 by decide +kernel) i x x.property

theorem splitFour_injective : Function.Injective splitFour := by
  intro i j hij
  have h:∀g:Four,g∈splitFour i↔g∈splitFour j := fun g=>by rw [hij]
  exact (show ∀i j:Fin 3,(∀g:Four,g∈splitFour i↔g∈splitFour j)→i=j by decide +kernel) i j h

theorem splitFour_ne_core (i:Fin 3):splitFour i≠core := by
  intro he
  have hh:(leftSwap i)∈core := he ▸ (show leftSwap i∈splitFour i from Or.inr (Or.inl rfl))
  exact (show ∀i:Fin 3,leftSwap i∉core by decide +kernel) i hh

theorem core_normalizes_splitFour (i:Fin 3):core≤normalizer (splitFour i:Set Four) := by
  intro g hg
  rw [mem_normalizer_iff]
  exact (show ∀i:Fin 3,∀g∈core,∀x:Four,x∈splitFour i↔g*x*g⁻¹∈splitFour i by decide +kernel) i g hg

theorem splitFour_conjugate (i j:Fin 3):∃g:Four,(splitFour i).map (MulAut.conj g).toMonoidHom=splitFour j := by
  have hc:∀i j:Fin 3,∃g:Four,∀x:Four,x∈splitFour j↔g⁻¹*x*g∈splitFour i := by decide +kernel
  obtain ⟨g,hg⟩:=hc i j
  refine ⟨g,?_⟩
  ext x
  rw [mem_map_equiv]
  exact (hg x).symm

private def isPair (x y:Four):Prop :=
  x≠1 ∧ y≠1 ∧ x≠y ∧ x*x=1 ∧ y*y=1 ∧ x*y=y*x
private instance (x y:Four):Decidable (isPair x y) :=
  inferInstanceAs (Decidable (_∧_∧_∧_∧_∧_))
private def hasCover (x y:Four):Prop :=
  (∀g:Four,(g=x*y ∨ g=x ∨ g=y ∨ g=1)↔g∈core) ∨
    ∃i:Fin 3,∀g:Four,(g=x*y ∨ g=x ∨ g=y ∨ g=1)↔g∈splitFour i
private instance (x y:Four):Decidable (hasCover x y) :=
  inferInstanceAs (Decidable (_∨_))
private theorem pair_cover : ∀x y:Four,isPair x y→hasCover x y := by
  decide +kernel

theorem kleinFour_cases (K:Subgroup Four) [IsKleinFour K]:K=core ∨ ∃i:Fin 3,K=splitFour i := by
  classical
  let : Fintype K := Fintype.ofFinite K
  let : IsMulCommutative K := IsKleinFour.isMulCommutative
  have hx:∃x:K,x≠1 := by
    by_contra! hh
    have hu:Subsingleton K:=⟨fun x y=>(hh x).trans (hh y).symm⟩
    let : Subsingleton K := hu
    have hc:Fintype.card K≤1 := Fintype.card_le_one_iff_subsingleton.mpr hu
    have hc4:Fintype.card K=4:=by simp
    omega
  obtain ⟨x,hx⟩:=hx
  have hy:∃y:K,y≠1 ∧ y≠x := by
    by_contra! hh
    have hsub:(Finset.univ:Finset K)⊆{1,x} := by
      intro y _
      by_cases hy:y=1
      · simp [hy]
      · simp [hh y hy]
    have hc:=Finset.card_le_card hsub
    have hc4:Fintype.card K=4:=by simp
    have hc2:=Finset.card_le_two (a:=(1:K)) (b:=x)
    simp only [Finset.card_univ,hc4] at hc
    omega
  obtain ⟨y,hy,hyx⟩:=hy
  have he:∀g:Four,g∈K↔g=(x:Four)*(y:Four) ∨ g=x ∨ g=y ∨ g=1 := by
    intro g
    constructor
    · intro hg
      have hh:(⟨g,hg⟩:K)∈({x*y,x,y,1}:Finset K) := by
        rw [IsKleinFour.eq_finset_univ hx hy hyx.symm]
        exact Finset.mem_univ _
      simp only [Finset.mem_insert,Finset.mem_singleton] at hh
      rcases hh with hh|hh|hh|hh
      · exact Or.inl (congrArg Subtype.val hh)
      · exact Or.inr (Or.inl (congrArg Subtype.val hh))
      · exact Or.inr (Or.inr (Or.inl (congrArg Subtype.val hh)))
      · exact Or.inr (Or.inr (Or.inr (congrArg Subtype.val hh)))
    · rintro (rfl|rfl|rfl|rfl)
      · exact K.mul_mem x.property y.property
      · exact x.property
      · exact y.property
      · exact K.one_mem
  have hp:=pair_cover x y ⟨(fun hh=>hx (Subtype.ext hh)), (fun hh=>hy (Subtype.ext hh)),
    (fun hh=>hyx (Subtype.ext hh.symm)),
    (congrArg Subtype.val (IsKleinFour.mul_self x)), (congrArg Subtype.val (IsKleinFour.mul_self y)),
    (congrArg Subtype.val (IsMulCommutative.is_comm.comm x y))⟩
  rcases hp with hp|⟨i,hp⟩
  · exact Or.inl (by ext g; exact (he g).trans (hp g))
  · exact Or.inr ⟨i,by ext g; exact (he g).trans (hp g)⟩

theorem core_normalizes_klein (K:Subgroup Four) [IsKleinFour K]:core≤normalizer (K:Set Four) := by
  rcases kleinFour_cases K with rfl|⟨i,rfl⟩
  · exact core.le_normalizer
  · exact core_normalizes_splitFour i

theorem klein_conjugate_of_ne_core (K L:Subgroup Four) [IsKleinFour K] [IsKleinFour L]
    (hK:K≠core) (hL:L≠core):∃g:Four,K.map (MulAut.conj g).toMonoidHom=L := by
  obtain ⟨i,rfl⟩:=(kleinFour_cases K).resolve_left hK
  obtain ⟨j,rfl⟩:=(kleinFour_cases L).resolve_left hL
  exact splitFour_conjugate i j

theorem klein_count : Nat.card {K:Subgroup Four // IsKleinFour K}=4 := by
  classical
  let f:Unit⊕Fin 3→{K:Subgroup Four // IsKleinFour K}:=fun i=>
    match i with
    | Sum.inl _=>⟨core,inferInstance⟩
    | Sum.inr i=>⟨splitFour i,inferInstance⟩
  have hf:Function.Bijective f := by
    constructor
    · rintro (⟨⟩|i) (⟨⟩|j) he
      · rfl
      · exact (splitFour_ne_core j (congrArg Subtype.val he).symm).elim
      · exact (splitFour_ne_core i (congrArg Subtype.val he)).elim
      · exact congrArg Sum.inr (splitFour_injective (congrArg Subtype.val he))
    · rintro ⟨K,hK⟩
      let : IsKleinFour K:=hK
      rcases kleinFour_cases K with rfl|⟨i,rfl⟩
      · exact ⟨Sum.inl (),rfl⟩
      · exact ⟨Sum.inr i,rfl⟩
  rw [←Nat.card_congr (Equiv.ofBijective f hf)]
  simp
end Theory.GroupTheory.Recognition.AlternatingSixCubicTI.NativeFour
