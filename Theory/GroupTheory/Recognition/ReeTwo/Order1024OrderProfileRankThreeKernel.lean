module

public import Theory.GroupTheory.Recognition.ReeTwo.Order1024OrderProfileRankThreeCoordinates
public import Theory.Frattini.BinarySquares

/-!
# Frattini kernels of the five rank-three Ree two projections

Each representative is a two-group. Its Frattini subgroup is generated by
squares, so the binary projection kills it. Seven independent squares and
commutators lie in the Frattini subgroup; their coordinate words fill the
128-element projection kernel.

Source: Shinoda (1975), (2.3), pp. 81–82, with the concrete multiplication
and ordered lifts in the preceding coordinate module.
-/

namespace ReeTwo.SylowModel
set_option maxRecDepth 16384

private abbrev H (j : Fin 5) := residualCandidate (rankThreeIndex j)

private theorem hP (j : Fin 5) : IsPGroup 2 (H j) :=
  (IsPGroup.of_card (n := 12) ReeTwo.SylowModel.card).to_subgroup _

private theorem square_mem (j : Fin 5) (x : H j) : x ^ 2 ∈ frattini (H j) := by
  rw [(hP j).frattini_eq_closure_squares]
  exact Subgroup.subset_closure ⟨x, rfl⟩

private theorem comm_mem (j : Fin 5) (x y : H j) :
    rightComm x y ∈ frattini (H j) := by
  have he : rightComm x y = (x⁻¹) ^ 2 * (x * y⁻¹) ^ 2 * y ^ 2 := by
    simp [rightComm, pow_two, mul_assoc]
  rw [he]
  exact (frattini (H j)).mul_mem
    ((frattini (H j)).mul_mem (square_mem j _) (square_mem j _)) (square_mem j _)

private def lift (j : Fin 5) (k : Fin 3) : H j := rankThreeBasisLift j k
private def pair (j : Fin 5) : H j := ⟨root 2 * root 3, rankThree_pair_mem j⟩
private def tail (j : Fin 5) (i : CoreRoot) (hi : 4 ≤ i.val) : H j :=
  ⟨root i, tailSubgroup_le_residualCandidate _
    (Subgroup.subset_closure ⟨i, hi, rfl⟩)⟩

private def witness (j : Fin 5) (k : Fin 7) : H j :=
  let a := lift j 0
  let b := lift j 1
  let c := lift j 2
  let p := pair j
  let t4 := tail j 4 (by decide)
  let t5 := tail j 5 (by decide)
  let t6 := tail j 6 (by decide)
  let t7 := tail j 7 (by decide)
  let t8 := tail j 8 (by decide)
  (![![rightComm b c, c ^ 2, b ^ 2, rightComm a b,
      a ^ 2, rightComm b t8, rightComm c t5],
    ![rightComm b c, rightComm a c, a ^ 2, rightComm a t4,
      rightComm c t6, rightComm a t6, rightComm a p],
    ![rightComm b c, rightComm a c, a ^ 2, rightComm a t4,
      rightComm c t6, rightComm a t7, rightComm a p],
    ![rightComm b c, rightComm a c, a ^ 2, rightComm a t4,
      c ^ 2, rightComm b t6, rightComm a p],
    ![rightComm b c, rightComm a c, a ^ 2, rightComm a t4,
      c ^ 2, rightComm a t6, rightComm a b]] j) k

set_option maxHeartbeats 20000000 in
private theorem witness_mem (j : Fin 5) (k : Fin 7) :
    witness j k ∈ frattini (H j) := by
  fin_cases j
  · fin_cases k
    · exact comm_mem _ _ _
    · exact square_mem _ _
    · exact square_mem _ _
    · exact comm_mem _ _ _
    · exact square_mem _ _
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
  · fin_cases k
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
    · exact square_mem _ _
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
  · fin_cases k
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
    · exact square_mem _ _
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
  · fin_cases k
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
    · exact square_mem _ _
    · exact comm_mem _ _ _
    · exact square_mem _ _
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
  · fin_cases k
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _
    · exact square_mem _ _
    · exact comm_mem _ _ _
    · exact square_mem _ _
    · exact comm_mem _ _ _
    · exact comm_mem _ _ _

private def word (j : Fin 5) (v : Fin 7 → ZMod 2) : H j :=
  witness j 0 ^ (v 0).val * witness j 1 ^ (v 1).val *
  witness j 2 ^ (v 2).val * witness j 3 ^ (v 3).val *
  witness j 4 ^ (v 4).val * witness j 5 ^ (v 5).val *
  witness j 6 ^ (v 6).val

private theorem word_mem (j : Fin 5) (v : Fin 7 → ZMod 2) :
    word j v ∈ frattini (H j) := by
  unfold word
  repeat apply Subgroup.mul_mem
  all_goals exact (frattini (H j)).pow_mem (witness_mem j _) _

private def coreWitness (j : Fin 5) (k : Fin 7) : Core :=
  let r (xs : List Nat) : Core := Core.ofCoords (fun i => if i.val ∈ xs then 1 else 0)
  (![![r [2,3,5,6,9], r [4,5,7,9], r [5], r [5,6,9],
      r [8], r [9], r [7,8]],
    ![r [2,3,4,5,6,7,9], r [4,8,9], r [5,8], r [7,8,9],
      r [8], r [9], r [6,7]],
    ![r [2,3,4,5,6,7,9], r [4,8,9], r [5], r [7,8,9],
      r [8], r [9], r [6,9]],
    ![r [2,3,4,7,9], r [4,8,9], r [5], r [7,8,9],
      r [8], r [9], r [6,9]],
    ![r [2,3,4,9], r [4,8,9], r [5,8], r [7,8,9],
      r [8], r [9], r [5,6,9]]] j) k

set_option maxHeartbeats 4000000 in
private theorem witness_val (j : Fin 5) (k : Fin 7) :
    (witness j k).val = SemidirectProduct.inl (coreWitness j k) := by
  fin_cases j <;> fin_cases k <;> decide +kernel

private def coreWord (j : Fin 5) (v : Fin 7 → ZMod 2) : Core :=
  coreWitness j 0 ^ (v 0).val * coreWitness j 1 ^ (v 1).val *
  coreWitness j 2 ^ (v 2).val * coreWitness j 3 ^ (v 3).val *
  coreWitness j 4 ^ (v 4).val * coreWitness j 5 ^ (v 5).val *
  coreWitness j 6 ^ (v 6).val

private theorem word_val (j : Fin 5) (v : Fin 7 → ZMod 2) :
    (word j v).val = SemidirectProduct.inl (coreWord j v) := by
  simp only [word, coreWord, Subgroup.coe_mul, Subgroup.coe_pow,
    witness_val, map_mul, map_pow]

private def coreView (x : Core) : Fin 7 → ZMod 2 :=
  ![x.b2, x.b4, x.b5, x.b6, x.b7, x.b8, x.b9]

set_option maxHeartbeats 20000000 in
private theorem coreWord_view_injective (j : Fin 5) :
    Function.Injective (fun v : Fin 7 → ZMod 2 => coreView (coreWord j v)) := by
  intro v w h
  fin_cases j <;> revert v w h <;> decide +kernel

private theorem word_injective (j : Fin 5) : Function.Injective (word j) := by
  intro v w he
  have hc : coreWord j v = coreWord j w :=
    SemidirectProduct.inl_injective (by simpa only [word_val] using congrArg Subtype.val he)
  apply coreWord_view_injective j
  exact congrArg coreView hc

private theorem frattini_card_ge (j : Fin 5) : 128 ≤ Nat.card (frattini (H j)) := by
  have h := Nat.card_le_card_of_injective
    (fun v : Fin 7 → ZMod 2 => (⟨word j v, word_mem j v⟩ : frattini (H j)))
    (fun _ _ he => word_injective j (congrArg Subtype.val he))
  have hc : Nat.card (Fin 7 → ZMod 2) = 128 := by
    rw [Nat.card_fun]
    norm_num
  rwa [hc] at h

/-- The binary rank-three projection has precisely the Frattini subgroup as kernel. -/
public theorem rankThreeProjection_ker_eq_frattini (j : Fin 5) :
    (rankThreeProjection j).ker = frattini (residualCandidate (rankThreeIndex j)) := by
  symm
  apply Subgroup.eq_of_le_of_card_ge
  · rw [(hP j).frattini_eq_closure_squares]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x, rfl⟩
    change rankThreeProjection j (x ^ 2) = 1
    rw [map_pow]
    change Multiplicative.ofAdd (2 • (rankThreeProjection j x).toAdd) = 1
    congr 1
    funext i
    change (2 : ℕ) • (rankThreeProjection j x).toAdd i = 0
    simp [show (2 : ZMod 2) = 0 by decide]
  · rw [rankThreeProjection_ker_card]
    exact frattini_card_ge j

end ReeTwo.SylowModel
