@[expose] public def nodeGeneratorIndex (i : Fin 599) : Fin 10 → Fin 390 :=
  let j : Fin 50 := ⟨i.val % 50, Nat.mod_lt _ (by decide)⟩
  match i.val / 50 with
  | 0 => nodeGeneratorIndexBlock0 j
  | 1 => nodeGeneratorIndexBlock1 j
  | 2 => nodeGeneratorIndexBlock2 j
  | 3 => nodeGeneratorIndexBlock3 j
  | 4 => nodeGeneratorIndexBlock4 j
  | 5 => nodeGeneratorIndexBlock5 j
  | 6 => nodeGeneratorIndexBlock6 j
  | 7 => nodeGeneratorIndexBlock7 j
  | 8 => nodeGeneratorIndexBlock8 j
  | 9 => nodeGeneratorIndexBlock9 j
  | 10 => nodeGeneratorIndexBlock10 j
  | _ => nodeGeneratorIndexBlock11 j

/-- The listed parent; coverage and maximality require separate certificates. -/
@[expose] public def parent (e : Fin 3617) : Fin 600 := (row e).parent

/-- Target in the nonzero node family. -/
@[expose] public def targetIndex (e : Fin 3617) : Fin 599 := (row e).targetIndex

/-- Target in the original 600-node numbering. -/
@[expose] public def target (e : Fin 3617) : Fin 600 := (targetIndex e).succ

/-- The diagnostic conjugator, in Lean's left-conjugation convention. -/
@[expose] public def conjugator (e : Fin 3617) : SylowModel :=
  word (row e).conjugatorIndex

/-- Recorded generators, padded by repeating the final entry. -/
@[expose] public def generator (e : Fin 3617) (k : Fin 10) : SylowModel :=
  word ((row e).generatorIndex k)

/-- The actual maximal-subgroup candidate from each diagnostic row. -/
@[expose] public def edge (e : Fin 3617) : Subgroup SylowModel :=
  Subgroup.closure (Set.range (generator e))

/-- Recorded generators of a nonzero node, padded by repeating the final entry. -/
@[expose] public def nodeGenerator (i : Fin 599) (k : Fin 10) : SylowModel :=
  word (nodeGeneratorIndex i k)

/-- Word-based form of the nonzero nodes for finite certificates. -/
@[expose] public def nodeClosure (i : Fin 599) : Subgroup SylowModel :=
  Subgroup.closure (Set.range (nodeGenerator i))

end ReeTwo.SylowModel.SmallEvenDescentEdges
