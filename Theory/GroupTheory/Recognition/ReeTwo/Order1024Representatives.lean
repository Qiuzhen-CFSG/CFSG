module

public import Theory.SpecificGroups.ReeTwo.SylowTail

/-!
# Three exceptional Ree two subgroup representatives

Let T be the subgroup generated by Shinoda roots 7–12. The three subgroups
specified here are generated over T by, respectively,
(x₅x₆, x₄x₆, x₁), (x₅x₆, x₄x₆, x₁x₆), and (x₅x₆, x₄, x₁).
They are the three additional representatives suggested by the order-1024
centric-subgroup diagnostic, labelled 20, 23, and 25 in that calculation.

These definitions specify the groups for separate enumeration and automorphism
proofs. This module makes no assertion that the list is exhaustive or that
these subgroups satisfy the radical condition. The diagnostic is not a proof.
The root convention and multiplication come from Shinoda (1975), (2.3),
pp. 81–82, as formalized in `ReeTwo.Sylow`.
-/

namespace ReeTwo.SylowModel

/-- The three explicit subgroups requiring a stronger obstruction than
having a two-group automorphism group. -/
@[expose] public def exceptionalCandidate (i : Fin 3) : Subgroup SylowModel :=
  tailSubgroup ⊔ Subgroup.closure
    (![({root 2 * root 3, root 1 * root 3, rootOne} : Set SylowModel),
      {root 2 * root 3, root 1 * root 3, rootOne * root 3},
      {root 2 * root 3, root 1, rootOne}] i)

/-- The common tail is included by construction. -/
public theorem tailSubgroup_le_exceptionalCandidate (i : Fin 3) :
    tailSubgroup ≤ exceptionalCandidate i := le_sup_left

end ReeTwo.SylowModel
