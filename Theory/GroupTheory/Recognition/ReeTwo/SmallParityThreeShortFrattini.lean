module

public import Theory.GroupTheory.Recognition.ReeTwo.SmallParityThreeShortCoordinates
public import Theory.Frattini.BinarySquares
/-!
# Frattini kernels for the three order-128 parity candidates

Four explicit products of squares of the prescribed basis lifts supply the
four kernel directions. The vanishing quotient coordinates yield a normal
form in these directions. Consequently the kernel equals the subgroup
generated by all squares, which is the Frattini subgroup of this finite
two-group. The two-group premise comes from the ambient Sylow group of order
4096, independently of any candidate order computation.

Source: Shinoda (1975), (2.3), pp. 81–82, through `SmallParityThreeGenerators`
and the verified coordinate model in `SmallParityThreeShortCoordinates`.
-/

@[expose] public section
namespace ReeTwo.SylowModel.SmallParityShort
set_option maxRecDepth 32768

private def kernelElement (c : Fin 3) (w : Fin 4 → ZMod 2) : SylowModel :=
  element c (Multiplicative.ofAdd (2 * (w 0).val),
    ![0, w 1, if c = 0 then w 1 else w 0 + if c = 2 then w 1 else 0, w 2, w 3])

private def kernelGenerator (c : Fin 3) (j : Fin 4) : SylowModel :=
  kernelElement c (fun k => if k = j then 1 else 0)

private def squareWords (c : Fin 3) (j : Fin 4) : List (List (Fin 3)) :=
  (![![[[1]], [[1],[1,0]], [[0],[0,1,1]], [[0,1,1]]],
     ![[[1]], [[1],[0,1]], [[0]], [[0,1,1]]],
     ![[[1]], [[1],[0,1]], [[1,1]], [[0],[1,1]]]] :
     Fin 3 → Fin 4 → List (List (Fin 3))) c j

private def word {I : Type*} (g : I → SylowModel) (w : List I) : SylowModel :=
  (w.map g).prod

set_option maxHeartbeats 8000000 in
private theorem squareWords_valid : ∀ (c : Fin 3) (j : Fin 4),
    word (fun w => (word (fun j => (smallParityThreeBasisLift (index c) j).val) w) ^ 2)
      (squareWords c j) = kernelGenerator c j := by decide +kernel

private def kernelWord (c : Fin 3) (p : Parameters) : SylowModel :=
  kernelGenerator c 1 ^ (p.2 1).val * kernelGenerator c 2 ^ (p.2 3).val *
    kernelGenerator c 3 ^ (p.2 4).val * kernelGenerator c 0 ^ (p.1.toAdd.val / 2)

set_option maxHeartbeats 8000000 in
private theorem kernelWord_valid : ∀ (c : Fin 3) (p : Parameters),
    coordinates c (element c p) = 1 → kernelWord c p = element c p := by decide +kernel

private theorem word_mem {I : Type*} (D : Subgroup SylowModel)
    (g : I → SylowModel) (hg : ∀ j, g j ∈ D) (w : List I) : word g w ∈ D := by
  induction w with
  | nil => exact D.one_mem
  | cons j w ih => exact D.mul_mem (hg j) ih

private theorem kernelGenerator_mem (c : Fin 3) (D : Subgroup SylowModel)
    (hsq : ∀ x ∈ Candidate c, x ^ 2 ∈ D) (j : Fin 4) : kernelGenerator c j ∈ D := by
  rw [← squareWords_valid c j]
  apply word_mem
  intro w
  apply hsq
  exact word_mem _ _ (fun j => (smallParityThreeBasisLift (index c) j).property) w

theorem projection_ker (c : Fin 3) : (projection c).ker = frattini (Candidate c) := by
  have hU : IsPGroup 2 (Candidate c) :=
    (IsPGroup.of_card (n := 12) card).to_subgroup _
  have hphi := hU.frattini_eq_closure_squares
  apply le_antisymm
  · intro x hx
    let D := (frattini (Candidate c)).map (Candidate c).subtype
    have hsq (y : SylowModel) (hy : y ∈ Candidate c) : y ^ 2 ∈ D := by
      refine ⟨(⟨y,hy⟩ : Candidate c) ^ 2, ?_, rfl⟩
      rw [hphi]
      exact Subgroup.subset_closure ⟨⟨y,hy⟩,rfl⟩
    have he := candidate_carrier c x.val x.property
    have hz : coordinates c (element c (parameters x.val)) = 1 := by
      rw [he]
      exact hx
    have hv : x.val ∈ D := by
      rw [← he, ← kernelWord_valid c (parameters x.val) hz]
      unfold kernelWord
      repeat apply Subgroup.mul_mem
      all_goals exact D.pow_mem (kernelGenerator_mem c D hsq _) _
    obtain ⟨y,hy,heq⟩ := hv
    exact (show y = x from Subtype.ext heq) ▸ hy
  · rw [hphi]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x,rfl⟩
    change projection c (x ^ 2) = 1
    rw [map_pow]
    exact (by decide +kernel : ∀ v : SmallParityThreeQuotient, v ^ 2 = 1) _

end ReeTwo.SylowModel.SmallParityShort
