module

public import Theory.GroupTheory.Recognition.ReeTwo.Order1024OrderProfileData
public import Theory.SpecificGroups.ReeTwo.TailQuotientOrder16Nodes
public import Theory.Frattini.BinarySquares

/-!
# The rank-four Frattini order profile of residual representative zero

The subgroup is the preimage of tail-quotient node 3. Its binary quotient
coordinates are `(b₃+b₄,b₂+b₄,b₀,t/2)`, in the ordered basis
`(root 3,root 2,root 0,rootOne²)`. Each fiber has six free binary coordinates.
The kernel is generated by `root 2 * root 3 * root 4` and roots 5 through 9,
which are obtained from squares and commutators. Finite power checks on the
six free coordinates give the element-order counts.

Source: Shinoda (1975), (2.3), pp. 81–82, via the verified coordinate
multiplication and root action in `ReeTwo.Core` and `ReeTwo.Sylow`.
-/

namespace ReeTwo.SylowModel
namespace OrderProfileRankFourZero
set_option maxRecDepth 16384
open TailQuotient

private theorem image_zero : (residualCandidate 0).map projection = Order16Nodes.node 3 := by
  have ht : tailSubgroup.map projection = ⊥ :=
    (Subgroup.map_eq_bot_iff _).mpr (le_of_eq ker_projection.symm)
  change (tailSubgroup ⊔ Subgroup.closure {root 3, root 2, root 0, rootOne ^ 2}).map projection = _
  rw [Subgroup.map_sup, ht, bot_sup_eq, MonoidHom.map_closure]
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x, hx, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl <;> change Order16Nodes.member 3 _ <;> decide +kernel
  · rw [Order16Nodes.node_eq_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨j, rfl⟩
    fin_cases j
    · exact Subgroup.subset_closure ⟨root 0, by simp, by decide +kernel⟩
    · exact Subgroup.subset_closure ⟨root 2, by simp, by decide +kernel⟩
    · exact Subgroup.subset_closure ⟨rootOne ^ 2, by simp, by decide +kernel⟩
    · have hh : Order16Nodes.generator (3 : Fin 27) (3 : Fin 4) = 1 := by
        apply coordinateCode_injective
        decide +kernel
      change Order16Nodes.generator (3 : Fin 27) (3 : Fin 4) ∈ _
      rw [hh]
      exact (Subgroup.one_mem (Subgroup.closure (projection '' {root 3, root 2, root 0, rootOne ^ 2})))

theorem mem_zero (x : SylowModel) : x ∈ residualCandidate 0 ↔
    x.left.b1 = 0 ∧ x.right.toAdd.val % 2 = 0 := by
  rw [← comap_map (residualCandidate 0) (tailSubgroup_le_residualCandidate 0), image_zero]
  change projection x ∈ Order16Nodes.node 3 ↔ _
  exact (by decide +kernel : ∀ q : TailQuotient.Group,
    q ∈ Order16Nodes.node 3 ↔ q.left.toAdd 1 = 0 ∧ q.right.toAdd.val % 2 = 0) (projection x)

def coords (x : SylowModel) : OrderProfileQuotient 4 :=
  Multiplicative.ofAdd ![x.left.b3 + x.left.b4, x.left.b2 + x.left.b4,
    x.left.b0, (x.right.toAdd.val / 2 : ℕ)]

def coreCoords : Core →* OrderProfileQuotient 3 where
  toFun x := Multiplicative.ofAdd ![x.b3 + x.b4, x.b2 + x.b4, x.b0]
  map_one' := by ext i; fin_cases i <;> rfl
  map_mul' x y := by
    change (![_, _, _] : Fin 3 → ZMod 2) = _ + _
    funext i
    fin_cases i
    · change (x.b3 + y.b3) + (x.b4 + y.b4) = (x.b3 + x.b4) + (y.b3 + y.b4)
      ring
    · change (x.b2 + y.b2) + (x.b4 + y.b4) = (x.b2 + x.b4) + (y.b2 + y.b4)
      ring
    · rfl

def correctedCoords (b : ZMod 2) : Core →* OrderProfileQuotient 3 where
  toFun x := Multiplicative.ofAdd ![x.b3 + x.b4 + b * x.b1,
    x.b2 + x.b4 + b * x.b1, x.b0]
  map_one' := by
    change (![0 + 0 + b * 0, 0 + 0 + b * 0, 0] : Fin 3 → ZMod 2) = 0
    simp
  map_mul' x y := by
    change (![_, _, _] : Fin 3 → ZMod 2) = _ + _
    funext i
    fin_cases i
    · change (x.b3 + y.b3) + (x.b4 + y.b4) + b * (x.b1 + y.b1) = _
      change _ = (x.b3 + x.b4 + b * x.b1) + (y.b3 + y.b4 + b * y.b1)
      ring
    · change (x.b2 + y.b2) + (x.b4 + y.b4) + b * (x.b1 + y.b1) = _
      change _ = (x.b2 + x.b4 + b * x.b1) + (y.b2 + y.b4 + b * y.b1)
      ring
    · rfl

theorem action_coords (t : FiveFour.Cyclic 4) (x : Core)
    (ht : t.toAdd.val % 2 = 0) (hx : x.b1 = 0) :
    coreCoords (Core.complementAction (SemidirectProduct.inr t) x) = coreCoords x := by
  have hh : coreCoords.comp (Core.complementAction (SemidirectProduct.inr t)).toMonoidHom =
      correctedCoords ((t.toAdd.val / 2 : ℕ) : ZMod 2) := by
    apply Core.hom_ext
    exact (by decide +kernel : ∀ t : FiveFour.Cyclic 4, t.toAdd.val % 2 = 0 → ∀ i : CoreRoot,
      coreCoords (Core.complementAction (SemidirectProduct.inr t) (Core.root i)) =
        correctedCoords ((t.toAdd.val / 2 : ℕ) : ZMod 2) (Core.root i)) t ht
  have he := DFunLike.congr_fun hh x
  simpa [correctedCoords, coreCoords, hx] using he

def proj : residualCandidate 0 →* OrderProfileQuotient 4 where
  toFun x := coords x
  map_one' := by ext i; fin_cases i <;> rfl
  map_mul' x y := by
    have hx := (mem_zero x).mp x.property
    have hy := (mem_zero y).mp y.property
    have hact := congrArg Multiplicative.toAdd (action_coords x.val.right y.val.left hx.2 hy.1)
    have h0 := congrFun hact 0
    have h1 := congrFun hact 1
    have h2 := congrFun hact 2
    change (![_, _, _, _] : Fin 4 → ZMod 2) = _ + _
    funext i
    fin_cases i
    · change (_ + _) + (_ + _) = _
      rw [show ∀ a b c d : ZMod 2, (a + b) + (c + d) = (a + c) + (b + d) by intros; ring]
      exact congrArg (x.val.left.b3 + x.val.left.b4 + ·) h0
    · change (_ + _) + (_ + _) = _
      rw [show ∀ a b c d : ZMod 2, (a + b) + (c + d) = (a + c) + (b + d) by intros; ring]
      exact congrArg (x.val.left.b2 + x.val.left.b4 + ·) h1
    · exact congrArg (x.val.left.b0 + ·) h2
    · exact (by decide : ∀ t s : FiveFour.Cyclic 4, t.toAdd.val % 2 = 0 → s.toAdd.val % 2 = 0 →
        (((t * s).toAdd.val / 2 : ℕ) : ZMod 2) =
          (t.toAdd.val / 2 : ℕ) + (s.toAdd.val / 2 : ℕ)) x.val.right y.val.right hx.2 hy.2

def element (v : OrderProfileQuotient 4) (w : Fin 6 → ZMod 2) : residualCandidate 0 :=
  ⟨⟨⟨v.toAdd 2, 0, v.toAdd 1 + w 0, v.toAdd 0 + w 0,
      w 0, w 1, w 2, w 3, w 4, w 5⟩,
      Multiplicative.ofAdd (2 * (v.toAdd 3).val)⟩,
    (mem_zero _).mpr ⟨rfl, (by decide : ∀ b : ZMod 2,
      (2 * b.val : ZMod 4).val % 2 = 0) (v.toAdd 3)⟩⟩

theorem proj_element (v : OrderProfileQuotient 4) (w : Fin 6 → ZMod 2) :
    proj (element v w) = v := by
  change (![_, _, _, _] : Fin 4 → ZMod 2) = v.toAdd
  funext i
  fin_cases i
  · change (v.toAdd 0 + w 0) + w 0 = v.toAdd 0
    simp [add_assoc, ← two_mul, show (2 : ZMod 2) = 0 by decide]
  · change (v.toAdd 1 + w 0) + w 0 = v.toAdd 1
    simp [add_assoc, ← two_mul, show (2 : ZMod 2) = 0 by decide]
  · rfl
  · exact (by decide : ∀ b : ZMod 2, (((2 * b.val : ZMod 4).val / 2 : ℕ) : ZMod 2) = b) _

theorem proj_surjective : Function.Surjective proj :=
  fun v => ⟨element v 0, proj_element v 0⟩

def remainder (x : residualCandidate 0) : Fin 6 → ZMod 2 :=
  ![x.val.left.b4, x.val.left.b5, x.val.left.b6,
    x.val.left.b7, x.val.left.b8, x.val.left.b9]

theorem element_coords (x : residualCandidate 0) :
    element (proj x) (remainder x) = x := by
  apply Subtype.ext
  apply SemidirectProduct.ext
  · apply Core.ext
    all_goals first | rfl | skip
    · exact ((mem_zero x).mp x.property).1.symm
    · change (x.val.left.b2 + x.val.left.b4) + x.val.left.b4 = x.val.left.b2
      simp [add_assoc, ← two_mul, show (2 : ZMod 2) = 0 by decide]
    · change (x.val.left.b3 + x.val.left.b4) + x.val.left.b4 = x.val.left.b3
      simp [add_assoc, ← two_mul, show (2 : ZMod 2) = 0 by decide]
  · exact (by decide : ∀ t : FiveFour.Cyclic 4, t.toAdd.val % 2 = 0 →
      Multiplicative.ofAdd (2 * ((((t.toAdd.val / 2 : ℕ) : ZMod 2).val) : ZMod 4)) = t)
      x.val.right ((mem_zero x).mp x.property).2

def fiberEquiv (v : OrderProfileQuotient 4) :
    {x : residualCandidate 0 // proj x = v} ≃ (Fin 6 → ZMod 2) where
  toFun x := remainder x.val
  invFun w := ⟨element v w, proj_element v w⟩
  left_inv x := by
    apply Subtype.ext
    change element v (remainder x.val) = x.val
    simpa only [x.property] using element_coords x.val
  right_inv w := by funext i; fin_cases i <;> rfl

theorem ker_card : Nat.card proj.ker = 64 := by
  change Nat.card {x : residualCandidate 0 // proj x = 1} = 64
  rw [Nat.card_congr (fiberEquiv 1), Nat.card_fun]
  simp

set_option maxHeartbeats 200000 in
theorem ker_frattini : proj.ker = frattini (residualCandidate 0) := by
  have hP : IsPGroup 2 (residualCandidate 0) :=
    (IsPGroup.of_card (p := 2) (n := 12) card).to_subgroup _
  let : Fact (IsPGroup 2 (residualCandidate 0)) := ⟨hP⟩
  let D := (frattini (residualCandidate 0)).map (residualCandidate 0).subtype
  have hroot (i : CoreRoot) (hi : i ≠ 1) : root i ∈ residualCandidate 0 := by
    rw [mem_zero]
    exact (by decide +kernel : ∀ i : CoreRoot, i ≠ 1 →
      (root i).left.b1 = 0 ∧ (root i).right.toAdd.val % 2 = 0) i hi
  have hs : rootOne ^ 2 ∈ residualCandidate 0 := (mem_zero _).mpr (by decide +kernel)
  have hsq (x : SylowModel) (hx : x ∈ residualCandidate 0) : x ^ 2 ∈ D :=
    Subgroup.mem_map_of_mem (residualCandidate 0).subtype
      (pth_power_mem_frattini_of_isPGroup (p := 2) (⟨x, hx⟩ : residualCandidate 0))
  have hcomm (x y : SylowModel) (hx : x ∈ residualCandidate 0)
      (hy : y ∈ residualCandidate 0) : rightComm x y ∈ D := by
    suffices hh : rightComm (⟨x, hx⟩ : residualCandidate 0) ⟨y, hy⟩ ∈
        frattini (residualCandidate 0) from
      Subgroup.mem_map_of_mem (residualCandidate 0).subtype hh
    apply commutator_le_frattini_of_isPGroup (p := 2)
    open scoped commutatorElement in
      simpa only [commutatorElement_def, inv_inv, rightComm, commutator_def] using
        (Subgroup.commutator_mem_commutator
          (Subgroup.mem_top (⟨x, hx⟩ : residualCandidate 0)⁻¹)
          (Subgroup.mem_top (⟨y, hy⟩ : residualCandidate 0)⁻¹))
  have h8 : root 8 ∈ D := by
    rw [← show root 3 ^ 2 = root 8 from by decide +kernel]
    exact hsq _ (hroot _ (by decide))
  have h9 : root 9 ∈ D := by
    rw [← show root 2 ^ 2 = root 9 from by decide +kernel]
    exact hsq _ (hroot _ (by decide))
  have h5 : root 5 ∈ D := by
    rw [← show rightComm (root 0) (root 2) = root 5 from by decide +kernel]
    exact hcomm _ _ (hroot _ (by decide)) (hroot _ (by decide))
  have h7 : root 7 ∈ D := by
    rw [← show rightComm (root 2) (root 3) = root 7 from by decide +kernel]
    exact hcomm _ _ (hroot _ (by decide)) (hroot _ (by decide))
  have h6 : root 6 ∈ D := by
    have hh := hcomm _ _ (hroot 0 (by decide)) (hroot 3 (by decide))
    rw [show rightComm (root 0) (root 3) = root 5 * root 6 * root 9 from by decide +kernel] at hh
    exact (D.mul_mem_cancel_left h5).mp ((D.mul_mem_cancel_right h9).mp hh)
  have hp : root 2 * root 3 * root 4 ∈ D := by
    have hh := hcomm _ _ hs (hroot 0 (by decide))
    rw [show rightComm (rootOne ^ 2) (root 0) =
      root 2 * root 3 * root 4 * root 5 * root 6 from by decide +kernel] at hh
    exact (D.mul_mem_cancel_right h5).mp ((D.mul_mem_cancel_right h6).mp hh)
  apply le_antisymm
  · intro x hx
    have he := element_coords x
    have hv : proj x = 1 := hx
    rw [hv] at he
    suffices hh : (element 1 (remainder x)).val ∈ D by
      rw [he] at hh
      obtain ⟨y, hy, hxy⟩ := Subgroup.mem_map.mp hh
      exact (show y = x from Subtype.ext hxy) ▸ hy
    let w := remainder x
    have hn := congrArg (SemidirectProduct.inl : Core →* SylowModel)
      (Core.normal_form ⟨0, 0, w 0, w 0, w 0, w 1, w 2, w 3, w 4, w 5⟩)
    simp only [map_mul, map_pow] at hn
    change root 0 ^ 0 * root 1 ^ 0 * root 2 ^ (w 0).val * root 3 ^ (w 0).val *
      root 4 ^ (w 0).val * root 5 ^ (w 1).val * root 6 ^ (w 2).val *
      root 7 ^ (w 3).val * root 8 ^ (w 4).val * root 9 ^ (w 5).val = _ at hn
    simp only [pow_zero, one_mul] at hn
    have hpair : ∀ b : ZMod 2, root 2 ^ b.val * root 3 ^ b.val * root 4 ^ b.val =
      (root 2 * root 3 * root 4) ^ b.val := by decide +kernel
    rw [hpair] at hn
    have hv' : (SemidirectProduct.inl : Core →* SylowModel)
        ⟨0, 0, w 0, w 0, w 0, w 1, w 2, w 3, w 4, w 5⟩ = (element 1 w).val := by
      apply SemidirectProduct.ext
      · change (⟨0, 0, w 0, w 0, w 0, w 1, w 2, w 3, w 4, w 5⟩ : Core) =
          ⟨0, 0, 0 + w 0, 0 + w 0, w 0, w 1, w 2, w 3, w 4, w 5⟩
        simp only [zero_add]
      · rfl
    rw [hv'] at hn
    rw [← hn]
    exact D.mul_mem (D.mul_mem (D.mul_mem (D.mul_mem (D.mul_mem
      (D.pow_mem hp _) (D.pow_mem h5 _)) (D.pow_mem h6 _))
      (D.pow_mem h7 _)) (D.pow_mem h8 _)) (D.pow_mem h9 _)
  · rw [hP.frattini_eq_closure_squares]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x, rfl⟩
    change proj (x ^ 2) = 1
    rw [map_pow]
    exact (by decide +kernel : ∀ v : OrderProfileQuotient 4, v ^ 2 = 1) _

def orderFiberEquiv (v : OrderProfileQuotient 4) (n : ℕ) :
    {x : residualCandidate 0 // proj x = v ∧ orderOf x = n} ≃
      {w : Fin 6 → ZMod 2 // orderOf (element v w) = n} where
  toFun x := ⟨remainder x.val, by
    have h : element v (remainder x.val) = x.val := by
      simpa only [x.property.1] using element_coords x.val
    rw [h]
    exact x.property.2⟩
  invFun w := ⟨element v w.val, proj_element v w.val, w.property⟩
  left_inv x := by
    apply Subtype.ext
    change element v (remainder x.val) = x.val
    simpa only [x.property.1] using element_coords x.val
  right_inv w := by
    apply Subtype.ext
    funext i; fin_cases i <;> rfl

theorem order_four_iff {G : Type*} [Group G] (x : G) :
    orderOf x = 4 ↔ x ^ 4 = 1 ∧ x ^ 2 ≠ 1 := by
  constructor
  · intro h
    refine ⟨h ▸ pow_orderOf_eq_one x, ?_⟩
    intro hh
    have hd := orderOf_dvd_of_pow_eq_one hh
    rw [h] at hd
    norm_num at hd
  · rintro ⟨h4, h2⟩
    exact orderOf_eq_prime_pow (p := 2) (n := 1) h2 h4

set_option maxHeartbeats 4000000 in
set_option synthInstance.maxSize 4096 in
theorem fiber_counts (v : OrderProfileQuotient 4) :
    (Subgroup.fiberProfile proj orderOf v 1, Subgroup.fiberProfile proj orderOf v 2,
      Subgroup.fiberProfile proj orderOf v 4) = orderProfileCounts 0 v := by
  have hc (n : ℕ) : Subgroup.fiberProfile proj orderOf v n =
      Nat.card {w : Fin 6 → ZMod 2 // orderOf (element v w) = n} :=
    by
      classical
      rw [Subgroup.fiberProfile_eq_card_filter, ← Fintype.card_subtype,
        ← Nat.card_eq_fintype_card]
      exact Nat.card_congr (orderFiberEquiv v n)
  rw [hc 1, hc 2, hc 4]
  simp only [orderOf_eq_one_iff, orderOf_eq_prime_iff, order_four_iff]
  simp only [Nat.card_eq_fintype_card]
  exact (by
    unfold orderProfileCounts orderProfileColor orderProfileRank
    decide +kernel : ∀ v : OrderProfileQuotient 4,
    (Fintype.card {w : Fin 6 → ZMod 2 // element v w = 1},
      Fintype.card {w : Fin 6 → ZMod 2 // element v w ^ 2 = 1 ∧ element v w ≠ 1},
      Fintype.card {w : Fin 6 → ZMod 2 // element v w ^ 4 = 1 ∧ element v w ^ 2 ≠ 1}) =
        orderProfileCounts 0 v) v

end OrderProfileRankFourZero

/-- The residual representative at index zero has the stated rank-four
Frattini quotient and element-order profile. -/
public theorem orderProfileModel_zero : OrderProfileModel 0 :=
  OrderProfileModel.of_counts 0 OrderProfileRankFourZero.proj
    OrderProfileRankFourZero.proj_surjective OrderProfileRankFourZero.ker_frattini
    OrderProfileRankFourZero.fiber_counts

end ReeTwo.SylowModel
