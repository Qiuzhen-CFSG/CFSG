/-- Proposed descent nodes; coverage is a separate theorem. -/
@[expose] public def smallEvenDescentNode (i : Fin 600) : Subgroup SylowModel :=
  let j : Fin 50 := ⟨i.val % 50, Nat.mod_lt _ (by decide)⟩
  match i.val / 50 with
  | 0 => SmallEvenDescentData.block0 j
  | 1 => SmallEvenDescentData.block1 j
  | 2 => SmallEvenDescentData.block2 j
  | 3 => SmallEvenDescentData.block3 j
  | 4 => SmallEvenDescentData.block4 j
  | 5 => SmallEvenDescentData.block5 j
  | 6 => SmallEvenDescentData.block6 j
  | 7 => SmallEvenDescentData.block7 j
  | 8 => SmallEvenDescentData.block8 j
  | 9 => SmallEvenDescentData.block9 j
  | 10 => SmallEvenDescentData.block10 j
  | _ => SmallEvenDescentData.block11 j

/-- Embedding of the prescribed survivor list in the descent list. -/
@[expose] public def smallEvenCandidateNode (i : Fin 59) : Fin 600 :=
  ![11, 14, 18, 19, 26, 27, 33, 48, 50, 63, 81, 83, 87, 93, 96, 97, 98, 99, 112, 113, 114, 115, 119, 120, 129, 136, 138, 142, 161, 171, 174, 199, 200, 201, 231, 238, 271, 279, 281, 286, 287, 288, 291, 319, 395, 462, 543, 546, 548, 553, 556, 560, 568, 576, 581, 582, 586, 588, 590] i

/-- Node zero starts descent at the whole parity kernel. -/
public theorem smallEvenDescentNode_zero : smallEvenDescentNode 0 = character.ker := rfl

/-- The survivor entries are the originally specified subgroups. -/
public theorem smallEvenDescentNode_candidate (i : Fin 59) :
    smallEvenDescentNode (smallEvenCandidateNode i) = smallEvenCandidate i := by
  fin_cases i <;> rfl

