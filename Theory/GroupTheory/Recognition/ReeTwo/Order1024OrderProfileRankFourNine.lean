module

public import Theory.GroupTheory.Recognition.ReeTwo.Order1024OrderProfileData
public import Theory.SpecificGroups.ReeTwo.TailQuotientOrder16Nodes
public import Theory.Frattini.BinarySquares

/-!
# The rank-four Frattini order profile of residual representative nine

The subgroup is the preimage of tail-quotient node 7. Its binary quotient
coordinates are `(b₃,b₂,b₁,t/2)`, in the ordered basis
`(root 3,root 2,root 1,rootOne²)`. Each fiber has six free binary coordinates.
The kernel is generated by roots 4 through 9,
which are obtained from squares and commutators. Finite power checks on the
six free coordinates give the element-order counts.

Source: Shinoda (1975), (2.3), pp. 81–82, via the verified coordinate
multiplication and root action in `ReeTwo.Core` and `ReeTwo.Sylow`.
-/

namespace ReeTwo.SylowModel
namespace OrderProfileRankFourNine
set_option maxRecDepth 16384
open TailQuotient

private theorem image_nine : (residualCandidate 9).map projection = Order16Nodes.node 7 := by
  have ht : tailSubgroup.map projection = ⊥ :=
    (Subgroup.map_eq_bot_iff _).mpr (le_of_eq ker_projection.symm)
  change (tailSubgroup ⊔ Subgroup.closure {root 3, root 2, root 1, rootOne ^ 2}).map projection = _
  rw [Subgroup.map_sup, ht, bot_sup_eq, MonoidHom.map_closure]
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x, hx, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl <;> change Order16Nodes.member 7 _ <;> decide +kernel
  · rw [Order16Nodes.node_eq_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨j, rfl⟩
    fin_cases j
    · exact Subgroup.subset_closure ⟨root 1, by simp, by decide +kernel⟩
    · exact Subgroup.subset_closure ⟨root 2, by simp, by decide +kernel⟩
    · exact Subgroup.subset_closure ⟨root 3, by simp, by decide +kernel⟩
    · exact Subgroup.subset_closure ⟨rootOne ^ 2, by simp, by decide +kernel⟩

theorem mem_nine (x : SylowModel) : x ∈ residualCandidate 9 ↔
    x.left.b0 = 0 ∧ x.right.toAdd.val % 2 = 0 := by
  rw [← comap_map (residualCandidate 9) (tailSubgroup_le_residualCandidate 9), image_nine]
  change projection x ∈ Order16Nodes.node 7 ↔ _
  exact (by decide +kernel : ∀ q : TailQuotient.Group,
    q ∈ Order16Nodes.node 7 ↔ q.left.toAdd 0 = 0 ∧ q.right.toAdd.val % 2 = 0) (projection x)

def quotientCoords (q : TailQuotient.Group) : OrderProfileQuotient 4 :=
  Multiplicative.ofAdd ![q.left.toAdd 3, q.left.toAdd 2, q.left.toAdd 1,
    (q.right.toAdd.val / 2 : ℕ)]

def nodeHom : Order16Nodes.node 7 →* OrderProfileQuotient 4 where
  toFun q := quotientCoords q
  map_one' := by ext i; fin_cases i <;> rfl
  map_mul' q r := (by decide +kernel : ∀ q r : TailQuotient.Group,
    q ∈ Order16Nodes.node 7 → r ∈ Order16Nodes.node 7 →
    quotientCoords (q * r) = quotientCoords q * quotientCoords r)
    q.val r.val q.property r.property

def toNode : residualCandidate 9 →* Order16Nodes.node 7 :=
  (projection.comp (residualCandidate 9).subtype).codRestrict _ (fun x => by
    rw [← image_nine]
    exact Subgroup.mem_map_of_mem projection x.property)

def proj : residualCandidate 9 →* OrderProfileQuotient 4 := nodeHom.comp toNode

def element (v : OrderProfileQuotient 4) (w : Fin 6 → ZMod 2) : residualCandidate 9 :=
  ⟨⟨⟨0, v.toAdd 2, v.toAdd 1, v.toAdd 0,
      w 0, w 1, w 2, w 3, w 4, w 5⟩,
      Multiplicative.ofAdd (2 * (v.toAdd 3).val)⟩,
    (mem_nine _).mpr ⟨rfl, (by decide : ∀ b : ZMod 2,
      (2 * b.val : ZMod 4).val % 2 = 0) (v.toAdd 3)⟩⟩

theorem proj_element (v : OrderProfileQuotient 4) (w : Fin 6 → ZMod 2) :
    proj (element v w) = v := by
  change (![_, _, _, _] : Fin 4 → ZMod 2) = v.toAdd
  funext i
  fin_cases i
  · rfl
  · rfl
  · rfl
  · exact (by decide : ∀ b : ZMod 2, (((2 * b.val : ZMod 4).val / 2 : ℕ) : ZMod 2) = b) _

theorem proj_surjective : Function.Surjective proj :=
  fun v => ⟨element v 0, proj_element v 0⟩

def remainder (x : residualCandidate 9) : Fin 6 → ZMod 2 :=
  ![x.val.left.b4, x.val.left.b5, x.val.left.b6,
    x.val.left.b7, x.val.left.b8, x.val.left.b9]

theorem element_coords (x : residualCandidate 9) :
    element (proj x) (remainder x) = x := by
  apply Subtype.ext
  apply SemidirectProduct.ext
  · apply Core.ext
    all_goals first | rfl | skip
    · exact ((mem_nine x).mp x.property).1.symm
  · exact (by decide : ∀ t : FiveFour.Cyclic 4, t.toAdd.val % 2 = 0 →
      Multiplicative.ofAdd (2 * ((((t.toAdd.val / 2 : ℕ) : ZMod 2).val) : ZMod 4)) = t)
      x.val.right ((mem_nine x).mp x.property).2

def fiberEquiv (v : OrderProfileQuotient 4) :
    {x : residualCandidate 9 // proj x = v} ≃ (Fin 6 → ZMod 2) where
  toFun x := remainder x.val
  invFun w := ⟨element v w, proj_element v w⟩
  left_inv x := by
    apply Subtype.ext
    change element v (remainder x.val) = x.val
    simpa only [x.property] using element_coords x.val
  right_inv w := by funext i; fin_cases i <;> rfl

theorem ker_card : Nat.card proj.ker = 64 := by
  change Nat.card {x : residualCandidate 9 // proj x = 1} = 64
  rw [Nat.card_congr (fiberEquiv 1), Nat.card_fun]
  simp

set_option maxHeartbeats 200000 in
theorem ker_frattini : proj.ker = frattini (residualCandidate 9) := by
  have hP : IsPGroup 2 (residualCandidate 9) :=
    (IsPGroup.of_card (p := 2) (n := 12) card).to_subgroup _
  let : Fact (IsPGroup 2 (residualCandidate 9)) := ⟨hP⟩
  let D := (frattini (residualCandidate 9)).map (residualCandidate 9).subtype
  have hroot (i : CoreRoot) (hi : i ≠ 0) : root i ∈ residualCandidate 9 := by
    rw [mem_nine]
    exact (by decide +kernel : ∀ i : CoreRoot, i ≠ 0 →
      (root i).left.b0 = 0 ∧ (root i).right.toAdd.val % 2 = 0) i hi
  have hs : rootOne ^ 2 ∈ residualCandidate 9 := (mem_nine _).mpr (by decide +kernel)
  have hsq (x : SylowModel) (hx : x ∈ residualCandidate 9) : x ^ 2 ∈ D :=
    Subgroup.mem_map_of_mem (residualCandidate 9).subtype
      (pth_power_mem_frattini_of_isPGroup (p := 2) (⟨x, hx⟩ : residualCandidate 9))
  have hcomm (x y : SylowModel) (hx : x ∈ residualCandidate 9)
      (hy : y ∈ residualCandidate 9) : rightComm x y ∈ D := by
    suffices hh : rightComm (⟨x, hx⟩ : residualCandidate 9) ⟨y, hy⟩ ∈
        frattini (residualCandidate 9) from
      Subgroup.mem_map_of_mem (residualCandidate 9).subtype hh
    apply commutator_le_frattini_of_isPGroup (p := 2)
    open scoped commutatorElement in
      simpa only [commutatorElement_def, inv_inv, rightComm, commutator_def] using
        (Subgroup.commutator_mem_commutator
          (Subgroup.mem_top (⟨x, hx⟩ : residualCandidate 9)⁻¹)
          (Subgroup.mem_top (⟨y, hy⟩ : residualCandidate 9)⁻¹))
  have h8 : root 8 ∈ D := by
    rw [← show root 3 ^ 2 = root 8 from by decide +kernel]
    exact hsq _ (hroot _ (by decide))
  have h9 : root 9 ∈ D := by
    rw [← show root 2 ^ 2 = root 9 from by decide +kernel]
    exact hsq _ (hroot _ (by decide))
  have h5 : root 5 ∈ D := by
    rw [← show root 1 ^ 2 = root 5 from by decide +kernel]
    exact hsq _ (hroot _ (by decide))
  have h7 : root 7 ∈ D := by
    rw [← show rightComm (root 2) (root 3) = root 7 from by decide +kernel]
    exact hcomm _ _ (hroot _ (by decide)) (hroot _ (by decide))
  have h6 : root 6 ∈ D := by
    rw [← show rightComm (root 1) (root 2) = root 6 from by decide +kernel]
    exact hcomm _ _ (hroot _ (by decide)) (hroot _ (by decide))
  have h4 : root 4 ∈ D := by
    have hh := hcomm _ _ hs (hroot 1 (by decide))
    rw [show rightComm (rootOne ^ 2) (root 1) =
      root 4 * root 8 * root 9 from by decide +kernel] at hh
    exact (D.mul_mem_cancel_right h8).mp ((D.mul_mem_cancel_right h9).mp hh)
  apply le_antisymm
  · intro x hx
    have he := element_coords x
    have hv : proj x = 1 := hx
    rw [hv] at he
    suffices hh : (element 1 (remainder x)).val ∈ D by
      rw [he] at hh
      obtain ⟨y, hy, hxy⟩ := Subgroup.mem_map.mp hh
      exact (show y = x from Subtype.ext hxy) ▸ hy
    let w := remainder x
    have hn := congrArg (SemidirectProduct.inl : Core →* SylowModel)
      (Core.normal_form ⟨0, 0, 0, 0, w 0, w 1, w 2, w 3, w 4, w 5⟩)
    simp only [map_mul, map_pow] at hn
    change root 0 ^ 0 * root 1 ^ 0 * root 2 ^ 0 * root 3 ^ 0 *
      root 4 ^ (w 0).val * root 5 ^ (w 1).val * root 6 ^ (w 2).val *
      root 7 ^ (w 3).val * root 8 ^ (w 4).val * root 9 ^ (w 5).val = _ at hn
    simp only [pow_zero, one_mul] at hn
    change _ = (element 1 w).val at hn
    rw [← hn]
    exact D.mul_mem (D.mul_mem (D.mul_mem (D.mul_mem (D.mul_mem
      (D.pow_mem h4 _) (D.pow_mem h5 _)) (D.pow_mem h6 _))
      (D.pow_mem h7 _)) (D.pow_mem h8 _)) (D.pow_mem h9 _)
  · rw [hP.frattini_eq_closure_squares]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x, rfl⟩
    change proj (x ^ 2) = 1
    rw [map_pow]
    exact (by decide +kernel : ∀ v : OrderProfileQuotient 4, v ^ 2 = 1) _

def orderFiberEquiv (v : OrderProfileQuotient 4) (n : ℕ) :
    {x : residualCandidate 9 // proj x = v ∧ orderOf x = n} ≃
      {w : Fin 6 → ZMod 2 // orderOf (element v w) = n} where
  toFun x := ⟨remainder x.val, by
    have h : element v (remainder x.val) = x.val := by
      simpa only [x.property.1] using element_coords x.val
    rw [h]
    exact x.property.2⟩
  invFun w := ⟨element v w.val, proj_element v w.val, w.property⟩
  left_inv x := by
    apply Subtype.ext
    change element v (remainder x.val) = x.val
    simpa only [x.property.1] using element_coords x.val
  right_inv w := by
    apply Subtype.ext
    funext i; fin_cases i <;> rfl

theorem order_four_iff {G : Type*} [Group G] (x : G) :
    orderOf x = 4 ↔ x ^ 4 = 1 ∧ x ^ 2 ≠ 1 := by
  constructor
  · intro h
    refine ⟨h ▸ pow_orderOf_eq_one x, ?_⟩
    intro hh
    have hd := orderOf_dvd_of_pow_eq_one hh
    rw [h] at hd
    norm_num at hd
  · rintro ⟨h4, h2⟩
    exact orderOf_eq_prime_pow (p := 2) (n := 1) h2 h4

set_option maxHeartbeats 4000000 in
set_option synthInstance.maxSize 4096 in
theorem fiber_counts (v : OrderProfileQuotient 4) :
    (Subgroup.fiberProfile proj orderOf v 1, Subgroup.fiberProfile proj orderOf v 2,
      Subgroup.fiberProfile proj orderOf v 4) = orderProfileCounts 9 v := by
  have hc (n : ℕ) : Subgroup.fiberProfile proj orderOf v n =
      Nat.card {w : Fin 6 → ZMod 2 // orderOf (element v w) = n} :=
    by
      classical
      rw [Subgroup.fiberProfile_eq_card_filter, ← Fintype.card_subtype,
        ← Nat.card_eq_fintype_card]
      exact Nat.card_congr (orderFiberEquiv v n)
  rw [hc 1, hc 2, hc 4]
  simp only [orderOf_eq_one_iff, orderOf_eq_prime_iff, order_four_iff]
  simp only [Nat.card_eq_fintype_card]
  exact (by
    unfold orderProfileCounts orderProfileColor orderProfileRank
    decide +kernel : ∀ v : OrderProfileQuotient 4,
    (Fintype.card {w : Fin 6 → ZMod 2 // element v w = 1},
      Fintype.card {w : Fin 6 → ZMod 2 // element v w ^ 2 = 1 ∧ element v w ≠ 1},
      Fintype.card {w : Fin 6 → ZMod 2 // element v w ^ 4 = 1 ∧ element v w ^ 2 ≠ 1}) =
        orderProfileCounts 9 v) v

end OrderProfileRankFourNine

/-- The residual representative at index nine has the stated rank-four
Frattini quotient and element-order profile. -/
public theorem orderProfileModel_nine : OrderProfileModel 9 :=
  OrderProfileModel.of_counts 9 OrderProfileRankFourNine.proj
    OrderProfileRankFourNine.proj_surjective OrderProfileRankFourNine.ker_frattini
    OrderProfileRankFourNine.fiber_counts

end ReeTwo.SylowModel
