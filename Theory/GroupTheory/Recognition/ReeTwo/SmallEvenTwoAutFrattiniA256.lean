module

public import Theory.GroupTheory.Recognition.ReeTwo.SmallEvenTwoAutCoordinatesA256
public import Theory.Frattini.BinarySquares
/-!
# Frattini certificates for the order-256 small even candidates

The fixed four binary coordinates preserve multiplication, including the
quadratic correction in row 7. Each candidate has order 256, so its Frattini
subgroup is generated by squares. The coordinate homomorphism kills squares;
conversely, an explicit table writes every identity-fiber element as a product
of at most two squares. Lean's kernel checks all entries against polynomial
multiplication, and the coordinate equivalence transfers the identities to the
original generator closures.

The integers in the square-word table encode eight-bit square roots, with bit
`j` giving coordinate `j`. Four row-specific coordinates select the entry.
The table is a certificate, not an assumption or external computation oracle.

Source: Shinoda (1975), (2.3), pp. 81–82, through the verified Ree two root model
and the coordinate conventions in `SmallEvenTwoAutCoordinatesA256`.
-/

open ReeTwo ReeTwo.SmallEvenAutProfilesA
set_option maxRecDepth 16384
set_option maxHeartbeats 4000000
namespace ReeTwo.SylowModel
private theorem coordinates_mul (i : Fin 11) (v w : A256Bits) :
    a256Coordinates i (a256Read i (evenPairMul (a256Pair i v) (a256Pair i w))) =
      a256Coordinates i v * a256Coordinates i w := by
  apply Multiplicative.toAdd.injective
  change _ = (a256Coordinates i v).toAdd + (a256Coordinates i w).toAdd
  fin_cases i <;> funext j <;> fin_cases j
  all_goals dsimp [a256Coordinates, a256Read, a256Pair, evenPairMul]
  all_goals try split_ifs
  all_goals simp only [show ∀ x y : Core, x * y = Core.mul x y from fun _ _ => rfl,
    Core.mul, evenCoreAction]
  all_goals ring_nf
  all_goals reduce_mod_char
  all_goals
    have bit : ∀ z : ZMod 2, z = 0 ∨ z = 1 := by decide
    rcases bit (v 0) with h0 | h0 <;>
      rcases bit (v 1) with h1 | h1 <;>
      rcases bit (v 2) with h2 | h2 <;> simp_all [show (1 : ZMod 2) + 1 = 0 by decide]
  all_goals ring_nf
  all_goals reduce_mod_char

/-- The fixed quotient coordinate map preserves multiplication. -/
public theorem a256Map_mul (i : Fin 11) (x y : smallEvenCandidate (a256Index i)) :
    a256Map i (x * y) = a256Map i x * a256Map i y := by
  obtain ⟨v, rfl⟩ := (a256Equiv i).surjective x
  obtain ⟨w, rfl⟩ := (a256Equiv i).surjective y
  change a256Map i (a256Element i v * a256Element i w) = _
  rw [a256Element_mul]
  simpa only [a256Map, show a256Element i = a256Equiv i from rfl,
    Equiv.symm_apply_apply] using coordinates_mul i v w

/-- Decode a binary word into the eight free coordinates. -/
private def squareBits (n : ℕ) : A256Bits :=
  fun j => if n.testBit j.val then 1 else 0

/-- Four free bits distinguish the sixteen elements of the identity fiber. -/
private def kernelIndex (i : Fin 11) (v : A256Bits) : ℕ :=
  let js : Fin 4 → Fin 8 := (![
    ![1, 5, 6, 7],
    ![3, 5, 6, 7],
    ![3, 5, 6, 7],
    ![3, 4, 6, 7],
    ![3, 4, 6, 7],
    ![3, 5, 6, 7],
    ![2, 5, 6, 7],
    ![3, 4, 5, 7],
    ![3, 4, 5, 7],
    ![3, 4, 5, 7],
    ![3, 4, 5, 7]]) i
  (v (js 0)).val + 2 * (v (js 1)).val + 4 * (v (js 2)).val + 8 * (v (js 3)).val

/-- Each entry lists square roots whose squared product gives the fiber element. -/
private def squareWords (i : Fin 11) : List (List ℕ) :=
  (![
    [[], [43], [22], [19], [68], [133], [220], [99], [18], [117], [236], [237], [162], [69], [154], [163]],
    [[], [172, 173], [22], [3, 242], [172], [173], [172, 22], [243], [121], [172, 149], [102], [3, 172], [242], [149], [172, 102], [3]],
    [[], [211], [86], [35, 38], [60], [35, 76], [35, 61], [93], [34], [35], [38], [35, 86], [76], [35, 60], [35, 93], [61]],
    [[], [243], [53], [23, 22], [46], [23, 13], [23, 51], [47], [242], [51], [13], [23, 46], [22], [23, 53], [23, 243], [23]],
    [[], [182, 7], [53], [107, 182], [106], [183], [182, 13], [83], [12], [182, 183], [13], [107, 106], [182], [7], [182, 53], [107]],
    [[], [1], [67, 229], [167], [158], [67], [67, 167], [229], [156], [33], [67, 173], [239], [250], [19], [67, 239], [173]],
    [[], [3], [237, 231], [165], [254], [65], [237, 165], [231], [252], [175], [237, 199], [247], [154], [237], [237, 247], [199]],
    [[], [223, 188], [223, 206], [99], [84], [138], [223, 139], [38], [113], [223, 84], [223, 38], [139], [188], [223], [223, 99], [206]],
    [[], [175, 253], [219, 202], [174], [175, 174], [203], [253], [175], [252], [175, 189], [219, 175], [190], [175, 190], [219], [189], [202]],
    [[], [235], [223, 206], [223, 221], [220], [207], [53], [38], [113], [234], [223, 38], [223, 53], [204], [223], [221], [206]],
    [[], [235], [103, 235], [103], [46, 234], [142], [253], [189, 234], [252], [234], [103, 234], [143], [46, 235], [46], [189], [189, 235]]]) i

private def squareWord (i : Fin 11) (v : A256Bits) : List A256Bits :=
  ((squareWords i).getD (kernelIndex i v) []).map squareBits

private theorem squareWord_check : ∀ (i : Fin 11) (v : A256Tuple),
    a256Coordinates i (a256BitsEquiv v) = 1 →
      evenPairProd ((squareWord i (a256BitsEquiv v)).map (fun w =>
        evenPairMul (a256Pair i w) (a256Pair i w))) =
          a256Pair i (a256BitsEquiv v) := by
  decide +kernel

private theorem frattini_eq_squares (i : Fin 11) :
    frattini (smallEvenCandidate (a256Index i)) =
      Subgroup.closure (Set.range (fun x : smallEvenCandidate (a256Index i) => x ^ 2)) :=
  (IsPGroup.of_card (p := 2) (n := 8) (a256Candidate_card i)).frattini_eq_closure_squares

private theorem square_mem (i : Fin 11) (x : smallEvenCandidate (a256Index i)) :
    x ^ 2 ∈ frattini (smallEvenCandidate (a256Index i)) := by
  rw [frattini_eq_squares]
  exact Subgroup.subset_closure ⟨x, rfl⟩

private theorem squareWord_eval (i : Fin 11) (ws : List A256Bits) :
    (((ws.map (fun w => a256Element i w ^ 2)).prod :
      smallEvenCandidate (a256Index i)) : SylowModel) =
    evenPairElement (evenPairProd (ws.map (fun w =>
      evenPairMul (a256Pair i w) (a256Pair i w)))) := by
  induction ws with
  | nil => rfl
  | cons w ws ih =>
    change (a256Element i w : SylowModel) ^ 2 *
      (((ws.map (fun w => a256Element i w ^ 2)).prod :
        smallEvenCandidate (a256Index i)) : SylowModel) = _
    rw [ih]
    simp only [List.map_cons, evenPairProd, evenPairElement_mul, pow_two]
    rfl

private theorem identity_fiber_mem (i : Fin 11) (v : A256Bits)
    (hv : a256Coordinates i v = 1) :
    a256Element i v ∈ frattini (smallEvenCandidate (a256Index i)) := by
  have hc := squareWord_check i (a256BitsEquiv.symm v)
  rw [Equiv.apply_symm_apply] at hc
  have he : ((squareWord i v).map (fun w => a256Element i w ^ 2)).prod =
      a256Element i v := by
    apply Subtype.ext
    rw [squareWord_eval, hc hv]
    rfl
  rw [← he]
  apply Subgroup.list_prod_mem
  intro x hx
  obtain ⟨w, _, rfl⟩ := List.mem_map.mp hx
  exact square_mem i _

/-- The identity fiber of the fixed coordinate map is precisely the Frattini subgroup. -/
public theorem a256Map_eq_one_iff_frattini (i : Fin 11) (x : smallEvenCandidate (a256Index i)) :
    a256Map i x = 1 ↔ x ∈ frattini (smallEvenCandidate (a256Index i)) := by
  constructor
  · intro hx
    obtain ⟨v, rfl⟩ := (a256Equiv i).surjective x
    apply identity_fiber_mem
    simpa only [a256Map, Equiv.symm_apply_apply] using hx
  · intro hx
    let π : smallEvenCandidate (a256Index i) →* FourQuotient :=
      MonoidHom.mk' (a256Map i) (a256Map_mul i)
    have hle : frattini (smallEvenCandidate (a256Index i)) ≤ π.ker := by
      rw [frattini_eq_squares]
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨y, rfl⟩
      change π (y ^ 2) = 1
      rw [map_pow]
      exact (by decide +kernel : ∀ v : FourQuotient, v ^ 2 = 1) (π y)
    exact hle hx

end ReeTwo.SylowModel
