/-- The proposed descending family, including all intermediate nodes. -/
@[expose] public def smallParityCensusNode (i : Fin 131) : Subgroup SylowModel :=
  ((#[SmallParityCensusData.block0, SmallParityCensusData.block1, SmallParityCensusData.block2, SmallParityCensusData.block3, SmallParityCensusData.block4, SmallParityCensusData.block5, SmallParityCensusData.block6, SmallParityCensusData.block7, SmallParityCensusData.block8] : Array (Array (Subgroup SylowModel))).getD (i.val / 16) #[]).getD
    (i.val % 16) ⊤


/-- The first node is the whole group. -/
public theorem smallParityCensusNode_zero : smallParityCensusNode 0 = ⊤ := by simp [smallParityCensusNode, SmallParityCensusData.block0]

/-- Positions of the nineteen existing representatives in the descending family. -/
@[expose] public def smallParityCandidateCensusIndex (i : Fin 19) : Fin 131 :=
  ![20, 22, 23, 25, 28, 45, 50, 60, 75, 76, 77, 78, 89, 96, 81, 116, 121, 124, 125] i

/-- The nineteen proposed survivors retain their exact public definitions. -/
public theorem smallParityCensusNode_candidate (i : Fin 19) :
    smallParityCensusNode (smallParityCandidateCensusIndex i) = smallParityCandidate i := by
  fin_cases i <;> rfl

end ReeTwo.SylowModel
