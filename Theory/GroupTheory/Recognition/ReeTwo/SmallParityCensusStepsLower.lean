/-!
# Maximal parity-census steps at nodes 97 through 128

Each node is generated by a checked short generating family. Membership in a
maximal subgroup of this finite two-group gives a nonzero binary signature.
The first outside generator supplies a Schreier transversal. Every signature
is certified either by parity containment, conjugacy to an exact census node,
or an outside element centralizing the Schreier subgroup.

For noncentric branches, nonmembership follows from a short word recovering
the outside pivot, a noncommuting centralizer element, or an explicit finite
transition table. All word and coordinate equations are checked by the Lean
kernel. The finite tables select witnesses only; no group presentation or
external computation is assumed. In particular no order bound or Frattini
survival condition is used to discard a branch.

Source: Shinoda (1975), (2.3), pp. 81–82, in the verified root model;
the exact root words are those of `SmallParityCensusNodes`. Binary Schreier
soundness is supplied by `SubgroupEnumerationBinary`. The 196 branches are
56 represented, 108 noncentric, and 32 contained in parity.
-/

namespace ReeTwo.SylowModel
open Theory.GroupTheory Theory.GroupTheory.SubgroupEnumeration


private theorem centralizes {n : ℕ} (s : Fin n → SylowModel) (c : SylowModel)
    (hc : ∀ j, s j * c = c * s j) :
    c ∈ Subgroup.centralizer (Subgroup.closure (Set.range s) : Set SylowModel) := by
  rw [Subgroup.centralizer_closure]
  rintro _ ⟨j, rfl⟩
  exact hc j

private theorem outside_of_noncommute {n : ℕ} (s : Fin n → SylowModel) (c d : SylowModel)
    (hd : ∀ j, s j * d = d * s j) (hcd : c * d ≠ d * c) :
    c ∉ Subgroup.closure (Set.range s) := by
  intro hc
  exact hcd (centralizes s d hd c hc)

private theorem outside_of_word {n : ℕ} (s : Fin n → SylowModel) (c t : SylowModel)
    (w : List (Fin (n + 2))) (hw : evalWord (extensionGen s c) w = t)
    (ht : t ∉ Subgroup.closure (Set.range s)) : c ∉ Subgroup.closure (Set.range s) := by
  intro hc
  apply ht
  rw [← hw]
  apply evalWord_mem
  intro k
  refine Fin.addCases (fun j => ?_) (fun j => ?_) k
  · simp only [extensionGen, Fin.addCases_left]
    exact Subgroup.subset_closure (Set.mem_range_self j)
  · simp only [extensionGen, Fin.addCases_right]
    split
    · exact hc
    · exact (Subgroup.closure (Set.range s)).inv_mem hc

private def flat {n : ℕ} (s : Fin n → SylowModel) (t : SylowModel)
    (σ : Fin n → Bool) : Fin (n + n) → SylowModel :=
  Fin.addCases (fun j => binarySchreierGenerator s t σ (false, j))
    (fun j => binarySchreierGenerator s t σ (true, j))

private theorem flat_range {n : ℕ} (s : Fin n → SylowModel) (t : SylowModel)
    (σ : Fin n → Bool) : Set.range (flat s t σ) =
      Set.range (binarySchreierGenerator s t σ) := by
  ext x
  constructor
  · rintro ⟨k, rfl⟩
    refine Fin.addCases (fun j => ?_) (fun j => ?_) k
    · exact ⟨(false, j), by simp only [flat, Fin.addCases_left]⟩
    · exact ⟨(true, j), by simp only [flat, Fin.addCases_right]⟩
  · rintro ⟨⟨b, j⟩, rfl⟩
    cases b
    · exact ⟨Fin.castAdd n j, by simp only [flat, Fin.addCases_left]⟩
    · exact ⟨Fin.natAdd n j, by simp only [flat, Fin.addCases_right]⟩

private theorem step_checked {n q : ℕ} (i : Fin 131)
    (s : Fin n → SylowModel) (hs : Subgroup.closure (Set.range s) = smallParityCensusNode i)
    (sig : Fin q → Fin n → Bool) (pivot : Fin q → Fin n)
    (edge : Fin q → Fin (n + n) → SylowModel)
    (hedge : ∀ m k, edge m k = flat s (s (pivot m)) (sig m) k)
    (cover : ∀ σ : Fin n → Bool, ∃ m, σ = sig m)
    (checks : ∀ m j, sig m j = true → sig m (pivot m) = true ∧
      let L := Subgroup.closure (Set.range (edge m))
      s (pivot m) ∉ L → L ≤ character.ker ∨ (∃ c, c ∈ Subgroup.centralizer (L : Set SylowModel) ∧ c ∉ L) ∨
        Represented smallParityCensusNode L)
    (H : Subgroup SylowModel) (hmax : H ⋖ smallParityCensusNode i)
    (hcent : Subgroup.centralizer (H : Set SylowModel) ≤ H)
    (hpar : ¬ H ≤ character.ker) : Represented smallParityCensusNode H := by
  classical
  let σ : Fin n → Bool := fun j => decide (s j ∉ H)
  obtain ⟨m, hm⟩ := cover σ
  have hout : ∃ j, s j ∉ H := by
    by_contra h
    push Not at h
    apply hmax.lt.not_ge
    rw [← hs, Subgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    exact h j
  obtain ⟨j, hj⟩ := hout
  have hsig : ∀ j, sig m j = true ↔ s j ∉ H := by
    intro j
    rw [← hm]
    simp [σ]
  obtain ⟨hp, hc⟩ := checks m j ((hsig j).mpr hj)
  have he := binarySchreier_eq_relative hmax.le
    (relIndex_two_of_covBy (IsPGroup.of_card (p := 2) (n := 12) card) hmax)
    s hs (s (pivot m)) (hs ▸ Subgroup.subset_closure ⟨pivot m, rfl⟩)
    ((hsig _).mp hp) (sig m) hsig
  dsimp only at hc
  have he' : Subgroup.closure (Set.range (edge m)) = H := by
    rw [show edge m = flat s (s (pivot m)) (sig m) from funext (hedge m), flat_range, he]
  have hc := hc (by rw [he']; exact (hsig _).mp hp)
  rw [he'] at hc
  rcases hc with hp | ⟨c, hc, hnc⟩ | hr
  · exact (hpar hp).elim
  · exact (hnc (hcent hc)).elim
  · exact hr


