module

public import Theory.GroupTheory.Recognition.ReeTwo.SmallParityThreeLongCoordinates
public import Theory.SpecificGroups.ReeTwo.CollectedBitVectors

/-!
# Simultaneous centralizer counting for the long rank-three rows

The natural-number enumeration is bijective with the original finite parameters.
Its bit-vector columns are checked against every original element. The verified
commuting mask therefore has population count equal to `commutingCount`, with
no subgroup-identification assumption.

Source: Shinoda (1975), (2.3), pp. 81–82, through the parametrizations in
`SmallParityThreeLongCoordinates` and arithmetic in `CollectedBitVectors`.
The numeric columns are witnesses verified by kernel reduction.
-/

@[expose] public section
namespace ReeTwo.SylowModel.SmallParityLong
namespace Counts
open CollectedBitVectors
set_option maxRecDepth 32768
set_option exponentiation.threshold 1024

def size (c : Fin 3) : ℕ := 2^(9-c.val)
instance (c : Fin 3) : NeZero (size c) := ⟨by unfold size; positivity⟩
def enumerate (c : Fin 3) (n : Fin (size c)) : Parameters c :=
  (Multiplicative.ofAdd (n.val : ZMod 4), fun j => (n.val / 2^(j.val+2) : ℕ))
def number (c : Fin 3) (p : Parameters c) : Fin (size c) :=
  Fin.ofNat (size c) (p.1.toAdd.val + 4*∑ j, 2^j.val*(p.2 j).val)
set_option maxHeartbeats 2000000 in
def enumeration (c : Fin 3) : Fin (size c) ≃ Parameters c where
  toFun := enumerate c
  invFun := number c
  left_inv := by
    revert c; decide +kernel
  right_inv := by
    revert c; decide +kernel

