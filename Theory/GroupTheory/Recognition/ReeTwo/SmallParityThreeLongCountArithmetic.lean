set_option maxHeartbeats 2000000 in
theorem read_elements : ∀ (c : Fin 3) (n : Fin (size c)),
    read (elements c) n = element c (enumerate c n) := by decide +kernel

def centralCount (c : Fin 3) (x : SylowModel) : ℕ :=
  (commuteMask (elements c) (pack x)).cpopNatRec (size c) 0

theorem centralCount_eq (c : Fin 3) (x : SylowModel) :
    commutingCount c x = centralCount c x := by
  unfold commutingCount centralCount
  rw [← pop_card]
  rw [← Fintype.card_subtype]
  apply (Fintype.card_congr ((enumeration c).subtypeEquiv ?_)).symm
  intro n
  rw [commuteMask_spec, read_elements, read_pack]
  rfl

end Counts
end ReeTwo.SylowModel.SmallParityLong
