    BitVec.ofNat 512 13407603346151304507647333602124270744930157291580986197148043437687863763597662002711256755796972443613438635551055889478487182262900810351549134401372160,
    BitVec.ofNat 512 13407807926820848549984871490950625460264621687587329935306297008442977448960781863686381587396241115434734742314166555940848600484775015044616064818216960,
    BitVec.ofNat 512 13407807929942597098847186273910239236969444018900783322580063136098668673514857287274768220802268387129003177701362428774192761570871467260109520434626560,
    BitVec.ofNat 512 13407807929942597099574024998205846127439963814395998898511282403621620416268583029620646167694378705270794824322841769944638336182637648515027502377205760,
    BitVec.ofNat 512 13407807929942597099574024998205846127479365820592393377723561443721764030073431184712636981971479856705023170278632780869088242247907112362425735876444160)
theorem get_seeds : ∀ n, getBinary seeds n = decode n := by decide +kernel
def packedCent (i : Fin 6) (w : Binary) : ℕ :=
  (eqMask (pproduct i seeds (pack w)) (pproduct i (pack w) seeds)).cpopNatRec 512 0
theorem pop_sum (x : BitVec 512) (n : ℕ) :
    x.cpopNatRec n 0 = ∑ k ∈ Finset.range n, (x.getLsbD k).toNat := by
  induction n with
  | zero => simp [BitVec.cpopNatRec]
  | succ n ih =>
    rw [BitVec.cpopNatRec_succ, BitVec.cpopNatRec_eq, ih, Finset.sum_range_succ, Nat.zero_add]
theorem pop_card (x : BitVec 512) :
    (Finset.univ.filter (fun n : Fin 512 => x.getLsbD n.val = true)).card =
      x.cpopNatRec 512 0 := by
  rw [pop_sum, ← Fin.sum_univ_eq_sum_range]
  rw [Finset.card_filter]
  apply Finset.sum_congr rfl
  intro n _
  cases x.getLsbD n.val <;> rfl

def toBits (w : Bits) : Binary :=
  (w 0 == 1, w 1 == 1, w 2 == 1, w 3 == 1, w 4 == 1,
    w 5 == 1, w 6 == 1, w 7 == 1, w 8 == 1)
def binaryEquiv : Binary ≃ Bits where
  toFun := fromBits
  invFun := toBits
  left_inv := by decide +kernel
  right_inv := by decide +kernel
def number (w : Binary) : Fin 512 :=
  Fin.ofNat 512 (w.1.toNat + 2*w.2.1.toNat + 4*w.2.2.1.toNat +
    8*w.2.2.2.1.toNat + 16*w.2.2.2.2.1.toNat + 32*w.2.2.2.2.2.1.toNat +
    64*w.2.2.2.2.2.2.1.toNat + 128*w.2.2.2.2.2.2.2.1.toNat +
    256*w.2.2.2.2.2.2.2.2.toNat)
def decodeEquiv : Fin 512 ≃ Binary where
  toFun := decode
  invFun := number
  left_inv := by decide +kernel
  right_inv := by decide +kernel
def equiv (i : Fin 6) := binaryEquiv.trans (smallEvenCandidateEquivA512 i)
def elem (i : Fin 6) (w : Binary) := smallEvenElementA512 i (fromBits w)
theorem lift_bcore (i : Fin 6) (w : Binary) :
    liftCore (bcore i w) = (elem i w).left := by
  fin_cases i <;> simp only [liftCore, bcore, elem, smallEvenElementA512,
    fromBits, zbit_xor, Matrix.cons_val, Fin.reduceFinMk, show zbit false = 0 from rfl]
theorem elem_even (i : Fin 6) (w : Binary) :
    elem i w = evenElement (zbit w.2.2.2.2.2.2.2.2) (liftCore (bcore i w)) := by
  rw [lift_bcore]
  rfl
theorem lift_inj (x y : BCore) : liftCore x = liftCore y ↔ x = y := by
  have hz : ∀ a b, zbit a = zbit b ↔ a = b := by decide +kernel
  cases x; cases y
  simp only [liftCore, Core.mk.injEq, BCore.mk.injEq, hz]
theorem elem_mul (i : Fin 6) (w z : Binary) :
    elem i w * elem i z = evenElement
      (zbit w.2.2.2.2.2.2.2.2 + zbit z.2.2.2.2.2.2.2.2)
      (liftCore (bproduct i w z)) := by
  rw [elem_even, elem_even, evenElement_mul]
  unfold bproduct
  cases w.2.2.2.2.2.2.2.2 <;>
    simp only [zbit, Bool.false_eq_true, if_false, if_true,
      show (1 : ZMod 2) ≠ 0 from by decide, lift_bmul, lift_bact]
theorem comm_iff (i : Fin 6) (w z : Binary) :
    elem i w * elem i z = elem i z * elem i w ↔ bproduct i w z = bproduct i z w := by
  rw [elem_mul, elem_mul]
  constructor
  · intro h
    exact (lift_inj _ _).mp (congrArg SemidirectProduct.left h)
  · intro h
    rw [h, add_comm]
theorem cent_eq (i : Fin 6) (w : Binary) :
    MulAut.commutingCard (equiv i w) = packedCent i w := by
  rw [MulAut.commutingCard_eq_card_filter_of_equiv (decodeEquiv.trans (equiv i))]
  unfold packedCent
  rw [← pop_card]
  congr 1
  apply Finset.filter_congr
  intro n _
  change ((equiv i (decode n)) * equiv i w = equiv i w * equiv i (decode n)) ↔ _
  rw [Subtype.ext_iff]
  change (elem i (decode n) * elem i w = elem i w * elem i (decode n)) ↔ _
  rw [comm_iff, eqMask_spec, get_pproduct, get_pproduct, get_seeds, get_pack]
def bzero : BCore := ⟨false,false,false,false,false,false,false,false,false,false⟩
theorem lift_eq_one (x : BCore) : liftCore x = 1 ↔ x = bzero := lift_inj x bzero
def square (i : Fin 6) (w : Binary) := bproduct i w w
theorem elem_square (i : Fin 6) (w : Binary) :
    elem i w ^ 2 = evenElement 0 (liftCore (square i w)) := by
  rw [pow_two, elem_mul]
  rw [show ∀ t : ZMod 2, t+t=0 from by decide]
  rfl
theorem elem_fourth (i : Fin 6) (w : Binary) :
    elem i w ^ 4 = evenElement 0 (liftCore (bmul (square i w) (square i w))) := by
  change elem i w ^ (2*2) = _
  rw [pow_mul, elem_square, pow_two, evenElement_mul, lift_bmul]
  rfl
theorem even_zero_one (c : Core) : evenElement 0 c = 1 ↔ c = 1 := by
  constructor
  · exact fun h => congrArg SemidirectProduct.left h
  · rintro rfl; rfl
theorem elem_one (i : Fin 6) (w : Binary) :
    elem i w = 1 ↔ w.2.2.2.2.2.2.2.2 = false ∧ bcore i w = bzero := by
  rw [elem_even]
  have ht : ∀ t : Bool,
      (Multiplicative.ofAdd (2 * (zbit t).val) : FiveFour.Cyclic 4) = 1 ↔ t = false := by decide
  constructor
  · intro h
    exact ⟨(ht _).mp (congrArg SemidirectProduct.right h),
      (lift_eq_one _).mp (congrArg SemidirectProduct.left h)⟩
  · rintro ⟨hp, hc⟩
    rw [hp, hc]
    rfl
theorem order_four_iff {G : Type*} [Group G] (x : G) :
    orderOf x = 4 ↔ x ^ 4 = 1 ∧ x ^ 2 ≠ 1 := by
  constructor
  · intro h
    constructor
    · rw [← h]; exact pow_orderOf_eq_one x
    · intro hh
      have hd := orderOf_dvd_of_pow_eq_one hh
      rw [h] at hd
      norm_num at hd
  · rintro ⟨h4, h2⟩
    exact orderOf_eq_prime_pow (p := 2) (n := 1) h2 h4

def orderTest (i : Fin 6) (o : ℕ) (w : Binary) : Prop :=
  if o = 2 then square i w = bzero ∧
    ¬ (w.2.2.2.2.2.2.2.2 = false ∧ bcore i w = bzero)
  else bmul (square i w) (square i w) = bzero ∧ square i w ≠ bzero
instance (i : Fin 6) (o : ℕ) (w : Binary) : Decidable (orderTest i o w) := by
  unfold orderTest; infer_instance
theorem orderTest_iff (i : Fin 6) (o : ℕ) (w : Binary) (ho : o = 2 ∨ o = 4) :
    orderOf (equiv i w) = o ↔ orderTest i o w := by
  have h : orderOf (equiv i w) = orderOf (elem i w) := Subgroup.orderOf_mk _ _
  rw [h]
  rcases ho with rfl | rfl
  · simp only [orderTest, ite_true, orderOf_eq_prime_iff, elem_square,
      even_zero_one, lift_eq_one, ne_eq, elem_one]
  · simp only [orderTest, show ¬(4 : ℕ) = 2 from by decide, if_false,
      order_four_iff, elem_square, elem_fourth, even_zero_one, lift_eq_one, ne_eq]

/-- Binary parameters in increasing bit order. -/
@[expose] public def parameters (n : Fin 512) : Fin 9 → ZMod 2 :=
  ![(n.val : ZMod 2), (n.val / 2 : ℕ), (n.val / 4 : ℕ), (n.val / 8 : ℕ),
    (n.val / 16 : ℕ), (n.val / 32 : ℕ), (n.val / 64 : ℕ),
    (n.val / 128 : ℕ), (n.val / 256 : ℕ)]
theorem parameters_eq : ∀ n, fromBits (decode n) = parameters n := by decide +kernel
