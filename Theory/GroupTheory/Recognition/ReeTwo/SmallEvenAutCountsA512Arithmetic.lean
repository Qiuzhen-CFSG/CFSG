module

public import Theory.GroupTheory.Recognition.ReeTwo.SmallEvenAutCarrierA512
public import Theory.GroupTheory.PGroup.InvariantFiberCoordinates
/-!
# Arithmetic certificates for the order-512 small even candidates

The original carrier equivalence enumerates each candidate by nine binary
parameters. Boolean versions of the verified even multiplication calculate
squares, fourth powers and commuting pairs. A packed bit vector evaluates all
512 possible commuting partners at once; its population count is proved to be
the cardinality of that exact candidate centralizer.

Kernel reduction verifies the resulting invariant tables. The public counting
interface transports an arbitrary ambient coordinate function along the
original candidate parametrization, without a multiplicativity assumption.

Source: Shinoda (1975), (2.3), pp. 81–82, through `EvenCoordinates` and the exact
carriers in `SmallEvenAutCarrierA512`. Tables are verified witnesses only.
-/
namespace ReeTwo.SylowModel
namespace SmallEvenAutCountsA512
set_option maxRecDepth 32768
set_option exponentiation.threshold 1024
set_option synthInstance.maxSize 8192
abbrev Binary := Bool × Bool × Bool × Bool × Bool × Bool × Bool × Bool × Bool
abbrev Bits := Fin 9 → ZMod 2
def zbit (b : Bool) : ZMod 2 := if b then 1 else 0
theorem zbit_xor : ∀ a b, zbit (a ^^ b) = zbit a + zbit b := by decide +kernel
theorem zbit_and : ∀ a b, zbit (a && b) = zbit a * zbit b := by decide +kernel
def fromBits (w : Binary) : Bits :=
  ![zbit w.1, zbit w.2.1, zbit w.2.2.1, zbit w.2.2.2.1,
    zbit w.2.2.2.2.1, zbit w.2.2.2.2.2.1, zbit w.2.2.2.2.2.2.1,
    zbit w.2.2.2.2.2.2.2.1, zbit w.2.2.2.2.2.2.2.2]
structure BCore where
  b0 : Bool
  b1 : Bool
  b2 : Bool
  b3 : Bool
  b4 : Bool
  b5 : Bool
  b6 : Bool
  b7 : Bool
  b8 : Bool
  b9 : Bool
  deriving DecidableEq
def liftCore (c : BCore) : Core :=
  ⟨zbit c.b0, zbit c.b1, zbit c.b2, zbit c.b3, zbit c.b4, zbit c.b5, zbit c.b6, zbit c.b7, zbit c.b8, zbit c.b9⟩
def bmul (x y : BCore) : BCore where
  b0 := (x.b0 ^^ y.b0)
  b1 := (x.b1 ^^ y.b1)
  b2 := (x.b2 ^^ y.b2)
  b3 := (x.b3 ^^ y.b3)
  b4 := (x.b4 ^^ y.b4)
  b5 := ((((x.b5 ^^ (x.b2 && y.b0)) ^^ (x.b3 && y.b0)) ^^ (x.b1 && y.b1)) ^^ y.b5)
  b6 := ((((x.b6 ^^ (x.b3 && y.b0)) ^^ (x.b4 && y.b0)) ^^ (x.b2 && y.b1)) ^^ y.b6)
  b7 := ((((x.b7 ^^ (x.b4 && y.b0)) ^^ (x.b4 && y.b1)) ^^ (x.b3 && y.b2)) ^^ y.b7)
  b8 := ((((x.b8 ^^ (x.b4 && y.b1)) ^^ (x.b4 && y.b2)) ^^ (x.b3 && y.b3)) ^^ y.b8)
  b9 := (((((((((((((((((((x.b9 ^^ (x.b3 && y.b0)) ^^ ((x.b2 && x.b4) && y.b0)) ^^ ((x.b3 && x.b4) && y.b0)) ^^ (x.b8 && y.b0)) ^^ ((x.b2 && x.b3) && y.b1)) ^^ (x.b4 && y.b1)) ^^ ((x.b1 && x.b4) && y.b1)) ^^ (x.b7 && y.b1)) ^^ ((x.b4 && y.b0) && y.b1)) ^^ (x.b2 && y.b2)) ^^ (x.b6 && y.b3)) ^^ ((x.b3 && y.b0) && y.b3)) ^^ ((x.b4 && y.b0) && y.b3)) ^^ ((x.b2 && y.b1) && y.b3)) ^^ (x.b5 && y.b4)) ^^ ((x.b2 && y.b0) && y.b4)) ^^ ((x.b3 && y.b0) && y.b4)) ^^ ((x.b1 && y.b1) && y.b4)) ^^ y.b9)
theorem lift_bmul (x y : BCore) : liftCore (bmul x y) = Core.mul (liftCore x) (liftCore y) := by
  apply Core.ext <;> simp only [liftCore, bmul, Core.mul, zbit_xor, zbit_and]
def bact (x : BCore) : BCore where
  b0 := x.b0
  b1 := x.b1
  b2 := (x.b0 ^^ x.b2)
  b3 := (x.b0 ^^ x.b3)
  b4 := ((x.b0 ^^ x.b1) ^^ x.b4)
  b5 := (x.b0 ^^ x.b5)
  b6 := ((x.b0 ^^ (x.b0 && x.b1)) ^^ x.b6)
  b7 := ((((x.b0 ^^ (x.b0 && x.b1)) ^^ (x.b0 && x.b2)) ^^ x.b5) ^^ x.b7)
  b8 := (((((((x.b1 ^^ (x.b0 && x.b1)) ^^ (x.b0 && x.b2)) ^^ (x.b1 && x.b2)) ^^ (x.b0 && x.b3)) ^^ x.b5) ^^ x.b6) ^^ x.b8)
  b9 := (((((((x.b0 ^^ x.b1) ^^ (x.b0 && x.b2)) ^^ (x.b0 && x.b3)) ^^ ((x.b0 && x.b1) && x.b3)) ^^ (x.b0 && x.b4)) ^^ x.b5) ^^ x.b9)
theorem lift_bact (x : BCore) : liftCore (bact x) = evenCoreAction (liftCore x) := by
  apply Core.ext <;> simp only [liftCore, bact, evenCoreAction, zbit_xor, zbit_and]
def bcore (i : Fin 6) (w : Binary) : BCore :=
  let a := w.1
  let b := w.2.1
  let c := w.2.2.1
  let d := w.2.2.2.1
  let e := w.2.2.2.2.1
  let f := w.2.2.2.2.2.1
  let g := w.2.2.2.2.2.2.1
  let h := w.2.2.2.2.2.2.2.1
  let t := w.2.2.2.2.2.2.2.2
  ![⟨a,false,b,c,b,d,e,f,g,h⟩, ⟨a,false,b,c,c,d,e,f,g,h⟩,
    ⟨a,false,b,b ^^ t,c,d,e,f,g,h⟩,
    ⟨a ^^ t,a,b,a ^^ t ^^ b,c,d,e,f,g,h⟩,
    ⟨false,t,a,b,c,d,e,f,g,h⟩, ⟨false,a,false,b,c,d,e,f,g,h⟩] i
def bproduct (i : Fin 6) (w z : Binary) : BCore :=
  bmul (bcore i w) (if w.2.2.2.2.2.2.2.2 then bact (bcore i z) else bcore i z)
def bcent (i : Fin 6) (w : Binary) : ℕ :=
  Fintype.card {z : Binary // bproduct i z w = bproduct i w z}
abbrev PackedBinary := BitVec 512 × BitVec 512 × BitVec 512 × BitVec 512 × BitVec 512 × BitVec 512 × BitVec 512 × BitVec 512 × BitVec 512
structure PCore where
  b0 : BitVec 512
  b1 : BitVec 512
  b2 : BitVec 512
  b3 : BitVec 512
  b4 : BitVec 512
  b5 : BitVec 512
  b6 : BitVec 512
  b7 : BitVec 512
  b8 : BitVec 512
  b9 : BitVec 512
  deriving DecidableEq
def pmul (x y : PCore) : PCore where
  b0 := (x.b0 ^^^ y.b0)
  b1 := (x.b1 ^^^ y.b1)
  b2 := (x.b2 ^^^ y.b2)
  b3 := (x.b3 ^^^ y.b3)
  b4 := (x.b4 ^^^ y.b4)
  b5 := ((((x.b5 ^^^ (x.b2 &&& y.b0)) ^^^ (x.b3 &&& y.b0)) ^^^ (x.b1 &&& y.b1)) ^^^ y.b5)
  b6 := ((((x.b6 ^^^ (x.b3 &&& y.b0)) ^^^ (x.b4 &&& y.b0)) ^^^ (x.b2 &&& y.b1)) ^^^ y.b6)
  b7 := ((((x.b7 ^^^ (x.b4 &&& y.b0)) ^^^ (x.b4 &&& y.b1)) ^^^ (x.b3 &&& y.b2)) ^^^ y.b7)
  b8 := ((((x.b8 ^^^ (x.b4 &&& y.b1)) ^^^ (x.b4 &&& y.b2)) ^^^ (x.b3 &&& y.b3)) ^^^ y.b8)
  b9 := (((((((((((((((((((x.b9 ^^^ (x.b3 &&& y.b0)) ^^^ ((x.b2 &&& x.b4) &&& y.b0)) ^^^ ((x.b3 &&& x.b4) &&& y.b0)) ^^^ (x.b8 &&& y.b0)) ^^^ ((x.b2 &&& x.b3) &&& y.b1)) ^^^ (x.b4 &&& y.b1)) ^^^ ((x.b1 &&& x.b4) &&& y.b1)) ^^^ (x.b7 &&& y.b1)) ^^^ ((x.b4 &&& y.b0) &&& y.b1)) ^^^ (x.b2 &&& y.b2)) ^^^ (x.b6 &&& y.b3)) ^^^ ((x.b3 &&& y.b0) &&& y.b3)) ^^^ ((x.b4 &&& y.b0) &&& y.b3)) ^^^ ((x.b2 &&& y.b1) &&& y.b3)) ^^^ (x.b5 &&& y.b4)) ^^^ ((x.b2 &&& y.b0) &&& y.b4)) ^^^ ((x.b3 &&& y.b0) &&& y.b4)) ^^^ ((x.b1 &&& y.b1) &&& y.b4)) ^^^ y.b9)
def pact (x : PCore) : PCore where
  b0 := x.b0
  b1 := x.b1
  b2 := (x.b0 ^^^ x.b2)
  b3 := (x.b0 ^^^ x.b3)
  b4 := ((x.b0 ^^^ x.b1) ^^^ x.b4)
  b5 := (x.b0 ^^^ x.b5)
  b6 := ((x.b0 ^^^ (x.b0 &&& x.b1)) ^^^ x.b6)
  b7 := ((((x.b0 ^^^ (x.b0 &&& x.b1)) ^^^ (x.b0 &&& x.b2)) ^^^ x.b5) ^^^ x.b7)
  b8 := (((((((x.b1 ^^^ (x.b0 &&& x.b1)) ^^^ (x.b0 &&& x.b2)) ^^^ (x.b1 &&& x.b2)) ^^^ (x.b0 &&& x.b3)) ^^^ x.b5) ^^^ x.b6) ^^^ x.b8)
  b9 := (((((((x.b0 ^^^ x.b1) ^^^ (x.b0 &&& x.b2)) ^^^ (x.b0 &&& x.b3)) ^^^ ((x.b0 &&& x.b1) &&& x.b3)) ^^^ (x.b0 &&& x.b4)) ^^^ x.b5) ^^^ x.b9)
def pcore (i : Fin 6) (w : PackedBinary) : PCore :=
  let a := w.1
  let b := w.2.1
  let c := w.2.2.1
  let d := w.2.2.2.1
  let e := w.2.2.2.2.1
  let f := w.2.2.2.2.2.1
  let g := w.2.2.2.2.2.2.1
  let h := w.2.2.2.2.2.2.2.1
  let t := w.2.2.2.2.2.2.2.2
  ![⟨a,0,b,c,b,d,e,f,g,h⟩, ⟨a,0,b,c,c,d,e,f,g,h⟩,
    ⟨a,0,b,b ^^^ t,c,d,e,f,g,h⟩,
    ⟨a ^^^ t,a,b,a ^^^ t ^^^ b,c,d,e,f,g,h⟩,
    ⟨0,t,a,b,c,d,e,f,g,h⟩, ⟨0,a,0,b,c,d,e,f,g,h⟩] i
def getCore (c : PCore) (n : Fin 512) : BCore :=
  ⟨c.b0.getLsbD n.val, c.b1.getLsbD n.val, c.b2.getLsbD n.val, c.b3.getLsbD n.val, c.b4.getLsbD n.val, c.b5.getLsbD n.val, c.b6.getLsbD n.val, c.b7.getLsbD n.val, c.b8.getLsbD n.val, c.b9.getLsbD n.val⟩
def getBinary (w : PackedBinary) (n : Fin 512) : Binary :=
  ((w.1).getLsbD n.val, (w.2.1).getLsbD n.val, (w.2.2.1).getLsbD n.val, (w.2.2.2.1).getLsbD n.val, (w.2.2.2.2.1).getLsbD n.val, (w.2.2.2.2.2.1).getLsbD n.val, (w.2.2.2.2.2.2.1).getLsbD n.val, (w.2.2.2.2.2.2.2.1).getLsbD n.val, (w.2.2.2.2.2.2.2.2).getLsbD n.val)
def select (t : BitVec 512) (x y : PCore) : PCore :=
  ⟨x.b0 ^^^ (t &&& (x.b0 ^^^ y.b0)), x.b1 ^^^ (t &&& (x.b1 ^^^ y.b1)), x.b2 ^^^ (t &&& (x.b2 ^^^ y.b2)), x.b3 ^^^ (t &&& (x.b3 ^^^ y.b3)), x.b4 ^^^ (t &&& (x.b4 ^^^ y.b4)), x.b5 ^^^ (t &&& (x.b5 ^^^ y.b5)), x.b6 ^^^ (t &&& (x.b6 ^^^ y.b6)), x.b7 ^^^ (t &&& (x.b7 ^^^ y.b7)), x.b8 ^^^ (t &&& (x.b8 ^^^ y.b8)), x.b9 ^^^ (t &&& (x.b9 ^^^ y.b9))⟩
theorem get_pmul (x y : PCore) (n : Fin 512) :
    getCore (pmul x y) n = bmul (getCore x n) (getCore y n) := by
  simp only [getCore, pmul, bmul, BitVec.getLsbD_xor, BitVec.getLsbD_and]
theorem get_pact (x : PCore) (n : Fin 512) :
    getCore (pact x) n = bact (getCore x n) := by
  simp only [getCore, pact, bact, BitVec.getLsbD_xor, BitVec.getLsbD_and]
theorem get_pcore (i : Fin 6) (w : PackedBinary) (n : Fin 512) :
    getCore (pcore i w) n = bcore i (getBinary w n) := by
  fin_cases i <;> simp only [getCore, pcore, bcore, getBinary,
    Matrix.cons_val, Fin.reduceFinMk, BitVec.getLsbD_xor, BitVec.ofNat_eq_ofNat, BitVec.getLsbD_zero]
theorem bool_select (t x y : Bool) : (x ^^ (t && (x ^^ y))) = if t then y else x := by
  cases t <;> cases x <;> cases y <;> rfl
theorem get_select (t : BitVec 512) (x y : PCore) (n : Fin 512) :
    getCore (select t x y) n = if t.getLsbD n.val then getCore y n else getCore x n := by
  simp only [getCore, select, BitVec.getLsbD_xor, BitVec.getLsbD_and, bool_select]
  cases t.getLsbD n.val <;> rfl
def pproduct (i : Fin 6) (w z : PackedBinary) : PCore :=
  pmul (pcore i w) (select w.2.2.2.2.2.2.2.2 (pcore i z) (pact (pcore i z)))
theorem get_pproduct (i : Fin 6) (w z : PackedBinary) (n : Fin 512) :
    getCore (pproduct i w z) n = bproduct i (getBinary w n) (getBinary z n) := by
  simp only [pproduct, get_pmul, get_select, get_pact, get_pcore, bproduct]
  rfl
def eqMask (x y : PCore) : BitVec 512 :=
  ~~~(x.b0 ^^^ y.b0) &&&
    ~~~(x.b1 ^^^ y.b1) &&&
    ~~~(x.b2 ^^^ y.b2) &&&
    ~~~(x.b3 ^^^ y.b3) &&&
    ~~~(x.b4 ^^^ y.b4) &&&
    ~~~(x.b5 ^^^ y.b5) &&&
    ~~~(x.b6 ^^^ y.b6) &&&
    ~~~(x.b7 ^^^ y.b7) &&&
    ~~~(x.b8 ^^^ y.b8) &&&
    ~~~(x.b9 ^^^ y.b9)
theorem eqMask_spec (x y : PCore) (n : Fin 512) :
    (eqMask x y).getLsbD n.val = true ↔ getCore x n = getCore y n := by
  simp [eqMask, getCore, BCore.mk.injEq, n.isLt, and_assoc]
def replicate (b : Bool) : BitVec 512 := if b then BitVec.allOnes 512 else 0
def pack (w : Binary) : PackedBinary :=
  (replicate w.1, replicate w.2.1, replicate w.2.2.1, replicate w.2.2.2.1, replicate w.2.2.2.2.1, replicate w.2.2.2.2.2.1, replicate w.2.2.2.2.2.2.1, replicate w.2.2.2.2.2.2.2.1, replicate w.2.2.2.2.2.2.2.2)
theorem get_replicate (b : Bool) (n : Fin 512) : (replicate b).getLsbD n.val = b := by
  cases b <;> simp only [replicate, Bool.false_eq_true, if_false, if_true, BitVec.ofNat_eq_ofNat, BitVec.getLsbD_zero, BitVec.getLsbD_allOnes, n.isLt, decide_true]
theorem get_pack (w : Binary) (n : Fin 512) : getBinary (pack w) n = w := by
  simp only [pack, getBinary, get_replicate]
def decode (n : Fin 512) : Binary :=
  (n.val.testBit 0, n.val.testBit 1, n.val.testBit 2, n.val.testBit 3, n.val.testBit 4, n.val.testBit 5, n.val.testBit 6, n.val.testBit 7, n.val.testBit 8)
