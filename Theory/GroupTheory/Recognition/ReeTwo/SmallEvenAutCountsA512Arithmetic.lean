def centTable (i : Fin 6) (w : Binary) : ℕ := (invariantTable i (number w)).2
set_option Elab.async false in
set_option maxHeartbeats 16000000 in
theorem cert0 : ∀ n, packedCent 0 (decode n) = centTable 0 (decode n) := by decide +kernel

set_option Elab.async false in
set_option maxHeartbeats 16000000 in
theorem cert1 : ∀ n, packedCent 1 (decode n) = centTable 1 (decode n) := by decide +kernel

set_option Elab.async false in
set_option maxHeartbeats 16000000 in
theorem cert2 : ∀ n, packedCent 2 (decode n) = centTable 2 (decode n) := by decide +kernel

