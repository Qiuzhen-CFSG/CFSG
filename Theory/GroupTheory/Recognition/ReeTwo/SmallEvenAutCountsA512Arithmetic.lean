set_option maxHeartbeats 16000000 in
theorem cert5 : ∀ n, packedCent 5 (decode n) = centTable 5 (decode n) := by decide +kernel

theorem centTable_eq (i : Fin 6) (w : Binary) : packedCent i w = centTable i w := by
  obtain ⟨n, rfl⟩ := decodeEquiv.surjective w
  fin_cases i
  · exact cert0 n
  · exact cert1 n
  · exact cert2 n
  · exact cert3 n
  · exact cert4 n
  · exact cert5 n

set_option Elab.async false in
set_option maxHeartbeats 4000000 in
theorem order_certificate : ∀ i n (k : Fin 2),
    orderTest i (if k = 0 then 2 else 4) (decode n) ↔
      (invariantTable i n).1 = (if k = 0 then 2 else 4) := by decide +kernel

theorem order_table (i : Fin 6) (n : Fin 512) (o : ℕ) (ho : o = 2 ∨ o = 4) :
    orderOf (equiv i (decode n)) = o ↔ (invariantTable i n).1 = o := by
  rw [orderTest_iff i o (decode n) ho]
  rcases ho with rfl | rfl
  · exact order_certificate i n 0
  · exact order_certificate i n 1

/-- Exact order-centralizer fiber counts in the original candidate, for either
of the two orders used by the six fixed profiles. -/
public theorem card_orderCentralizerTest (i : Fin 6) {V : Type*} [DecidableEq V]
    (f : SylowModel → V) (v : V) (t : ℕ × ℕ × ℕ)
    (ho : t.1 = 2 ∨ t.1 = 4) (hz : t.2.2 = 0) :
    Nat.card {x : smallEvenCandidate (smallEvenIndexA512 i) //
      f x.val = v ∧ MulAut.orderCentralizerTest t x} =
      Fintype.card {n : Fin 512 //
        f (smallEvenElementA512 i (parameters n)) = v ∧
          (invariantTable i n).1 = t.1 ∧ (invariantTable i n).2 = t.2.1} := by
  rw [← Nat.card_eq_fintype_card]
  apply (Nat.card_congr _).symm
  refine (decodeEquiv.trans (equiv i)).subtypeEquiv (fun n => ?_)
  change (_ ∧ _ ∧ _) ↔ f (elem i (decode n)) = v ∧
    MulAut.orderCentralizerTest t (equiv i (decode n))
  have hp : elem i (decode n) = smallEvenElementA512 i (parameters n) :=
    congrArg (smallEvenElementA512 i) (parameters_eq n)
  have hn : number (decode n) = n := decodeEquiv.left_inv n
  simp only [MulAut.orderCentralizerTest, hz, true_or, and_true,
    order_table i n t.1 ho, cent_eq, centTable_eq, centTable, hn, hp]
end SmallEvenAutCountsA512
