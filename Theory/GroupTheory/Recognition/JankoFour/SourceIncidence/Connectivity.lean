module
public import Theory.GroupTheory.Recognition.JankoFour.SourceIncidence.PlaneUniqueness
public import Theory.GroupTheory.Recognition.JankoFour.SourceIncidence.PlaneMaximal
public import Theory.GroupTheory.Recognition.JankoFour.SourceIncidence.LineAction
public import Mathlib.Algebra.Group.Action.Sum

/-!
# Residual connectivity of the source incidence geometry

Each local group is generated by its two literal overlap subgroups. For the
point group, the marked K-action escapes the maximal plane overlap. For the
line group, the plane overlap is transitive on its five points and hence
supplements the point overlap. The plane-group generation is already proved.
The component of a flag is invariant under both overlap groups, so these
identities give connected point, line and plane residues. The same left action
transports the results to all ambient residues.

The final theorem converts the precise generation equation H ⊔ M = G into
ambient connectivity. That equation is the independent AS91 (6.5)(2)
obligation; no generation or connectivity is added to LocalData.

Source: Aschbacher–Segev, Invent. Math. 105 (1991), (5.2)(1), p.600,
DOI 10.1007/BF01232280.
-/

public section
open Subgroup
namespace Theory.GroupTheory.Recognition.JankoFour.SourceIncidence
open LocalGeometry LocalGeometry.LocalSubgroups SourceCycleBase GraphUniquenessSystem

private theorem connected_of_generators {A V : Type*} [Group A]
    (Γ : SimpleGraph V) (act : A → V → V)
    (one : ∀ v, act 1 v = v) (mul : ∀ g h v, act (g*h) v = act g (act h v))
    (edge : ∀ (g : A) u v, Γ.Adj u v → Γ.Adj (act g u) (act g v))
    (S T : Subgroup A) (gen : S ⊔ T = ⊤) (u v : V) (uv : Γ.Adj u v)
    (fixu : ∀ g ∈ S, act g u = u) (fixv : ∀ g ∈ T, act g v = v)
    (cover : ∀ w, ∃ g c, Γ.Reachable u c ∧ act g c = w) : Γ.Connected := by
  let f (g : A) : Γ →g Γ := ⟨act g, edge g _ _⟩
  let K : Subgroup A := {
    carrier := {g | Γ.Reachable u (act g u)}
    one_mem' := by change Γ.Reachable u (act 1 u); rw [one]
    mul_mem' := by
      intro g h hg hh
      change Γ.Reachable u (act (g*h) u)
      rw [mul]
      exact hg.trans (hh.map (f g))
    inv_mem' := by
      intro g hg
      have hh := (hg.map (f g⁻¹)).symm
      change Γ.Reachable (act g⁻¹ (act g u)) (act g⁻¹ u) at hh
      change Γ.Reachable u (act g⁻¹ u)
      simpa only [←mul,inv_mul_cancel,one] using hh }
  have hS : S ≤ K := fun g hg => by
    change Γ.Reachable u (act g u); exact (fixu g hg).symm ▸ SimpleGraph.Reachable.refl u
  have hT : T ≤ K := fun g hg => by
    change Γ.Reachable u (act g u)
    have hh := uv.symm.reachable.map (f g)
    change Γ.Reachable (act g v) (act g u) at hh
    rw [fixv g hg] at hh
    exact uv.reachable.trans hh
  have hK : K = ⊤ := top_unique (gen ▸ sup_le hS hT)
  apply (SimpleGraph.connected_iff_exists_forall_reachable Γ).mpr
  refine ⟨u,fun w => ?_⟩
  obtain ⟨g,c,hc,rfl⟩ := cover w
  have hgK : g ∈ K := hK ▸ mem_top g
  have hg : Γ.Reachable u (act g u) := hgK
  exact hg.trans (hc.map (f g))

private theorem residue_connected_of_generators {A V : Type*} [Group A] [MulAction A V]
    (Γ : SimpleGraph V) (edge : ∀ (g : A) u v, Γ.Adj u v → Γ.Adj (g • u) (g • v))
    (u : V) (K : Subgroup A) (fixu : ∀ g : K, (g : A) • u = u)
    (S T : Subgroup K) (gen : S ⊔ T = ⊤) (b c : V)
    (ub : Γ.Adj u b) (uc : Γ.Adj u c) (bc : Γ.Adj b c)
    (fixb : ∀ g ∈ S, (g : A) • b = b) (fixc : ∀ g ∈ T, (g : A) • c = c)
    (cover : ∀ w, Γ.Adj u w →
      (∃ g : K, (g : A) • b = w) ∨ ∃ g : K, (g : A) • c = w) :
    (Γ.induce {w | Γ.Adj u w}).Connected := by
  let act (g : K) (w : {w | Γ.Adj u w}) : {w | Γ.Adj u w} :=
    ⟨(g : A) • w.val,by
      change Γ.Adj u ((g : A) • w.val)
      simpa only [fixu g] using edge g u w.val w.property⟩
  let b' : {w | Γ.Adj u w} := ⟨b,ub⟩
  let c' : {w | Γ.Adj u w} := ⟨c,uc⟩
  apply connected_of_generators (Γ.induce {w | Γ.Adj u w}) act
    (fun w => Subtype.ext (one_smul A w.val))
    (fun g h w => Subtype.ext (mul_smul (g : A) (h : A) w.val))
    (fun g _ _ hbc => edge g _ _ hbc) S T gen b' c' bc
  · exact fun g hg => Subtype.ext (fixb g hg)
  · exact fun g hg => Subtype.ext (fixc g hg)
  · intro w
    rcases cover w.val w.property with ⟨g,hg⟩ | ⟨g,hg⟩
    · exact ⟨g,b',SimpleGraph.Reachable.refl _,Subtype.ext hg⟩
    · exact ⟨g,c',SimpleGraph.Adj.reachable bc,Subtype.ext hg⟩

variable {G : Type*} [Group G] [Finite G] {z : G}
variable {P : PointData z} {L : LineData z P}

/-- The actual left action preserves all three kinds of incidence. -/
theorem incidentObject_smul (g : G) {u v : Object L} (huv : IncidentObject L u v) :
    IncidentObject L (g • u) (g • v) := by
  rcases u with u | u <;> rcases v with v | v
  · exact huv
  · rcases v with v | v <;> exact incident_smul g huv
  · rcases u with u | u <;> exact incident_smul g huv
  · rcases u with u | u <;> rcases v with v | v
    · exact huv
    · exact incident_smul g huv
    · exact incident_smul g huv
    · exact huv

namespace LocalData
variable {h : IsTypeJ4 z} (a : LocalData h)

/-- The two actual overlaps generate the point stabilizer. -/
theorem point_flag_generate :
    a.L.G₂.subgroupOf a.P.M ⊔ (centralizer z).subgroupOf a.P.M = ⊤ := by
  rw [sup_comm]
  apply a.vertex_maximal.2
  apply lt_iff_le_not_ge.mpr
  refine ⟨le_sup_left,?_⟩
  intro hh
  obtain ⟨k,hk⟩ := a.d.exists_K_marked_permutation h (Equiv.swap 0 1)
  have hkM : (k : G) ∈ a.P.M := a.K_le_point k.property
  have hkN : (k : G) ∈ a.L.G₂ := a.line_normalizer.symm ▸ a.d.K_le_normalizer k.property
  have hnle : a.L.G₂.subgroupOf a.P.M ≤ (centralizer z).subgroupOf a.P.M :=
    le_sup_right.trans hh
  have hc : (k : G) ∈ centralizer z := hnle (show
    (⟨k,hkM⟩ : a.P.M) ∈ a.L.G₂.subgroupOf a.P.M from hkN)
  have hz : (k : G)*z*(k : G)⁻¹ = z := by
    rw [mem_centralizer_singleton_iff.mp hc,mul_inv_cancel_right]
  have hr : (k : G)*z*(k : G)⁻¹ = a.d.r := by
    simpa [SourceRecognition.ThreeSpaceData.markedPoint,Equiv.swap_apply_def] using hk 0
  exact a.d.r_ne (hr.symm.trans hz)

/-- The line group is the product of its plane and point overlaps. -/
theorem line_flag_factorization (n : a.L.G₂) :
    ∃ b : a.L.G₂, (b : G) ∈ centralizer z ∧
      ∃ c : a.L.G₂, (c : G) ∈ a.P.M ∧ n = b*c := by
  obtain ⟨b,hb,he⟩ := a.line_point_representative (Cosets.vertex a.P.M n)
    ⟨n,rfl,(Cosets.vertex_eq_base _ _).mpr n.property⟩
  have hcM : b⁻¹*(n : G) ∈ a.P.M := QuotientGroup.eq.mp he
  refine ⟨⟨b,hb.1⟩,hb.2,⟨b⁻¹*n,a.L.G₂.mul_mem (a.L.G₂.inv_mem hb.1) n.property⟩,
    hcM,?_⟩
  apply Subtype.ext
  simp

/-- The original line-group overlaps generate the full line group. -/
theorem line_flag_generate :
    a.P.M.subgroupOf a.L.G₂ ⊔ (centralizer z).subgroupOf a.L.G₂ = ⊤ := by
  apply top_unique
  intro n _
  obtain ⟨b,hb,c,hc,rfl⟩ := a.line_flag_factorization n
  exact mul_mem
    ((show (centralizer z).subgroupOf a.L.G₂ ≤ _ from le_sup_right) hb)
    ((show a.P.M.subgroupOf a.L.G₂ ≤ _ from le_sup_left) hc)

/-- The incidence graph in the residue of the original point is connected. -/
theorem point_residue_connected :
    ((incidenceGraph a.L).induce
      {v | IncidentObject a.L (.inl (Cosets.vertex a.P.M 1)) v}).Connected := by
  apply residue_connected_of_generators (incidenceGraph a.L)
    (fun g _ _ huv => incidentObject_smul g huv)
    (.inl (Cosets.vertex a.P.M 1)) a.P.M
    (fun g => by simp only [Sum.smul_inl,Cosets.smul_vertex,mul_one,
      (Cosets.vertex_eq_base _ _).mpr g.property])
    (a.L.G₂.subgroupOf a.P.M) ((centralizer z).subgroupOf a.P.M)
    a.point_flag_generate (.inr (.inl (Cosets.vertex a.L.G₂ 1)))
    (.inr (.inr (Cosets.vertex (centralizer z) 1)))
    ⟨1,rfl,rfl⟩ ⟨1,rfl,rfl⟩ ⟨1,rfl,rfl⟩
  · intro g hg
    simp only [Sum.smul_inr,Sum.smul_inl,Cosets.smul_vertex,mul_one,
      (Cosets.vertex_eq_base a.L.G₂ (g : G)).mpr hg]
  · intro g hg
    simp only [Sum.smul_inr,Cosets.smul_vertex,mul_one,
      (Cosets.vertex_eq_base (centralizer z) (g : G)).mpr hg]
  · intro w hw
    rcases w with w | w
    · exact hw.elim
    · rcases w with w | w
      · obtain ⟨g,hg,hw⟩ := hw
        exact Or.inl ⟨⟨g,(Cosets.vertex_eq_base _ _).mp hg⟩,by
          simp only [Sum.smul_inr,Sum.smul_inl,Cosets.smul_vertex,mul_one,hw]⟩
      · obtain ⟨g,hg,hw⟩ := hw
        exact Or.inr ⟨⟨g,(Cosets.vertex_eq_base _ _).mp hg⟩,by
          simp only [Sum.smul_inr,Cosets.smul_vertex,mul_one,hw]⟩

/-- The incidence graph in the residue of the original line is connected. -/
theorem line_residue_connected :
    ((incidenceGraph a.L).induce
      {v | IncidentObject a.L (.inr (.inl (Cosets.vertex a.L.G₂ 1))) v}).Connected := by
  apply residue_connected_of_generators (incidenceGraph a.L)
    (fun g _ _ huv => incidentObject_smul g huv)
    (.inr (.inl (Cosets.vertex a.L.G₂ 1))) a.L.G₂
    (fun g => by simp only [Sum.smul_inr,Sum.smul_inl,Cosets.smul_vertex,mul_one,
      (Cosets.vertex_eq_base _ _).mpr g.property])
    (a.P.M.subgroupOf a.L.G₂) ((centralizer z).subgroupOf a.L.G₂)
    a.line_flag_generate (.inl (Cosets.vertex a.P.M 1))
    (.inr (.inr (Cosets.vertex (centralizer z) 1)))
    ⟨1,rfl,rfl⟩ ⟨1,rfl,rfl⟩ ⟨1,rfl,rfl⟩
  · intro g hg
    simp only [Sum.smul_inl,Cosets.smul_vertex,mul_one,
      (Cosets.vertex_eq_base a.P.M (g : G)).mpr hg]
  · intro g hg
    simp only [Sum.smul_inr,Cosets.smul_vertex,mul_one,
      (Cosets.vertex_eq_base (centralizer z) (g : G)).mpr hg]
  · intro w hw
    rcases w with w | w
    · obtain ⟨g,hw,hg⟩ := hw
      exact Or.inl ⟨⟨g,(Cosets.vertex_eq_base _ _).mp hg⟩,by
        simp only [Sum.smul_inl,Cosets.smul_vertex,mul_one,hw]⟩
    · rcases w with w | w
      · exact hw.elim
      · obtain ⟨g,hg,hw⟩ := hw
        exact Or.inr ⟨⟨g,(Cosets.vertex_eq_base _ _).mp hg⟩,by
          simp only [Sum.smul_inr,Cosets.smul_vertex,mul_one,hw]⟩

/-- The incidence graph in the residue of the original plane is connected. -/
theorem plane_residue_connected :
    ((incidenceGraph a.L).induce
      {v | IncidentObject a.L (.inr (.inr (Cosets.vertex (centralizer z) 1))) v}).Connected := by
  apply residue_connected_of_generators (incidenceGraph a.L)
    (fun g _ _ huv => incidentObject_smul g huv)
    (.inr (.inr (Cosets.vertex (centralizer z) 1))) (centralizer z)
    (fun g => by simp only [Sum.smul_inr,Cosets.smul_vertex,mul_one,
      (Cosets.vertex_eq_base _ _).mpr g.property])
    (a.P.M.subgroupOf (centralizer z)) (a.L.G₂.subgroupOf (centralizer z))
    a.plane_flag_generate (.inl (Cosets.vertex a.P.M 1))
    (.inr (.inl (Cosets.vertex a.L.G₂ 1)))
    ⟨1,rfl,rfl⟩ ⟨1,rfl,rfl⟩ ⟨1,rfl,rfl⟩
  · intro g hg
    simp only [Sum.smul_inl,Cosets.smul_vertex,mul_one,
      (Cosets.vertex_eq_base a.P.M (g : G)).mpr hg]
  · intro g hg
    simp only [Sum.smul_inr,Sum.smul_inl,Cosets.smul_vertex,mul_one,
      (Cosets.vertex_eq_base a.L.G₂ (g : G)).mpr hg]
  · intro w hw
    rcases w with w | w
    · obtain ⟨g,hw,hg⟩ := hw
      exact Or.inl ⟨⟨g,(Cosets.vertex_eq_base _ _).mp hg⟩,by
        simp only [Sum.smul_inl,Cosets.smul_vertex,mul_one,hw]⟩
    · rcases w with w | w
      · obtain ⟨g,hw,hg⟩ := hw
        exact Or.inr ⟨⟨g,(Cosets.vertex_eq_base _ _).mp hg⟩,by
          simp only [Sum.smul_inr,Sum.smul_inl,Cosets.smul_vertex,mul_one,hw]⟩
      · exact hw.elim

/-- All ambient residues are connected, by transport under the original left action. -/
theorem residues_connected (u : Object a.L) :
    ((incidenceGraph a.L).induce {v | IncidentObject a.L u v}).Connected := by
  have tr (g : G) (u : Object a.L)
      (hc : ((incidenceGraph a.L).induce {v | IncidentObject a.L u v}).Connected) :
      ((incidenceGraph a.L).induce {v | IncidentObject a.L (g • u) v}).Connected := by
    let f : ((incidenceGraph a.L).induce {v | IncidentObject a.L u v}) →g
        ((incidenceGraph a.L).induce {v | IncidentObject a.L (g • u) v}) := {
      toFun v := ⟨g • v.val,incidentObject_smul g v.property⟩
      map_rel' := fun hvw => incidentObject_smul g hvw }
    apply hc.map f
    intro v
    refine ⟨⟨g⁻¹ • v.val,?_⟩,Subtype.ext (smul_inv_smul _ _)⟩
    have hh := incidentObject_smul (g⁻¹ : G) v.property
    have he : (g⁻¹ : G) • (g • u) = u := inv_smul_smul _ _
    rw [he] at hh
    exact hh
  have base (A : Subgroup G) (u : Cosets.Vertex A) :
      representative u • Cosets.vertex A 1 = u := by
    rw [Cosets.smul_vertex,mul_one,vertex_representative]
  rcases u with u | u
  · have hh := tr (representative u) (.inl (Cosets.vertex a.P.M 1)) a.point_residue_connected
    have he : (representative u : G) • (.inl (Cosets.vertex a.P.M 1) : Object a.L) = .inl u :=
      congrArg Sum.inl (base a.P.M u)
    rw [he] at hh
    exact hh
  · rcases u with u | u
    · have hh := tr (representative u) (.inr (.inl (Cosets.vertex a.L.G₂ 1))) a.line_residue_connected
      have he : (representative u : G) • (.inr (.inl (Cosets.vertex a.L.G₂ 1)) : Object a.L) = .inr (.inl u) :=
        congrArg (Sum.inr ∘ Sum.inl) (base a.L.G₂ u)
      rw [he] at hh
      exact hh
    · have hh := tr (representative u) (.inr (.inr (Cosets.vertex (centralizer z) 1))) a.plane_residue_connected
      have he : (representative u : G) • (.inr (.inr (Cosets.vertex (centralizer z) 1)) : Object a.L) = .inr (.inr u) :=
        congrArg (Sum.inr ∘ Sum.inr) (base (centralizer z) u)
      rw [he] at hh
      exact hh

/-- Ambient connectivity follows from exactly the generation conclusion of
(6.5)(2), with no geometric premise. -/
theorem geometry_connected_of_generate (hg : centralizer z ⊔ a.P.M = ⊤) :
    (incidenceGraph a.L).Connected := by
  let x : Object a.L := .inl (Cosets.vertex a.P.M 1)
  let π : Object a.L := .inr (.inr (Cosets.vertex (centralizer z) 1))
  apply connected_of_generators (incidenceGraph a.L) (fun g v => g • v)
    (one_smul G) (mul_smul) (fun g _ _ huv => incidentObject_smul g huv)
    a.P.M (centralizer z) (by rwa [sup_comm]) x π
  · exact ⟨1,rfl,rfl⟩
  · intro g hg
    change Sum.inl (g • Cosets.vertex a.P.M 1) = _
    rw [Cosets.smul_vertex,mul_one,(Cosets.vertex_eq_base _ _).mpr hg]
  · intro g hg
    change Sum.inr (Sum.inr (g • Cosets.vertex (centralizer z) 1)) = _
    rw [Cosets.smul_vertex,mul_one,(Cosets.vertex_eq_base _ _).mpr hg]
  · intro w
    rcases w with w | w
    · refine ⟨representative w,x,SimpleGraph.Reachable.refl _,?_⟩
      simp [x,Cosets.smul_vertex]
    · rcases w with w | w
      · refine ⟨representative w,.inr (.inl (Cosets.vertex a.L.G₂ 1)),?_,?_⟩
        · exact (show (incidenceGraph a.L).Adj x (.inr (.inl (Cosets.vertex a.L.G₂ 1))) from
            ⟨1,rfl,rfl⟩).reachable
        · simp [Cosets.smul_vertex]
      · refine ⟨representative w,π,?_,?_⟩
        · exact (show (incidenceGraph a.L).Adj x π from ⟨1,rfl,rfl⟩).reachable
        · simp [π,Cosets.smul_vertex]

end LocalData
end Theory.GroupTheory.Recognition.JankoFour.SourceIncidence
