def pairAt (i : Fin 231) : Finset (Fin 22) := {(endpoints i).1,(endpoints i).2}
theorem pair_card : ∀ i, (pairAt i).card = 2 := by decide +kernel
def parent : Fin 231 → Fin 231 := fun i => ⟨(( >>> (8 * i.val)) % 256) % 231, Nat.mod_lt _ (by decide)⟩
def letter : Fin 231 → Fin 3 := fun i => ⟨((7148187471843870762799216006372402509240103007078646962126118110521276599121969958230962565216053809827878723772841420173609129720693236232 >>> (2 * i.val)) % 4) % 3, Nat.mod_lt _ (by decide)⟩
def depth : Fin 231 → Nat := fun i => ( >>> (5 * i.val)) % 32
def root : Fin 231 → Fin 3 := fun i => ⟨((4702937283903138959306798781046585047910700160348817184258320961339144584376672297053731894045024496232728987272919949157591296318886029973 >>> (2 * i.val)) % 4) % 3, Nat.mod_lt _ (by decide)⟩
def seed : Fin 3 → Fin 231 := ![21,0,3]
theorem forest : ∀ i : Fin 231,
    (depth i = 0 → i = seed (root i)) ∧
    (depth i ≠ 0 → depth (parent i) < depth i ∧ root (parent i) = root i ∧
      (pairAt (parent i)).image (table (letter i)) = pairAt i) := by
  decide +kernel

theorem roots_pattern : ∀ i : Fin 3,
    (i = 0 → pairAt (seed i) ⊆ m22Hexad123) ∧
    (i = 1 → ∀ j : Fin 77, pairAt (seed i) ⊆ m22BlockAt j →
      (m22BlockAt j ∩ m22Hexad123).card = 2) ∧
    (i = 2 → (Finset.univ.filter (fun j : Fin 77 =>
      pairAt (seed i) ⊆ m22BlockAt j ∧ (m22BlockAt j ∩ m22Hexad123).card = 2)).card = 3) := by
  decide +kernel

theorem root_marks : ∀ i : Fin 231,
    root i = (if pairAt i ⊆ m22Hexad123 then 0 else
      if (pairAt i ∩ m22Hexad123).card = 0 then 2 else 1) := by
  decide +kernel


