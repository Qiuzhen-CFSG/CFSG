theorem generator_apply (i : Fin 3) (x : Fin 22) : (generator i).val x = table i x := by
  revert i x; decide +kernel
theorem generator_fixes (i : Fin 3) : generator i • m22Hexad123 = m22Hexad123 := by
  change m22Hexad123.image (generator i).val = m22Hexad123
  have hg : (generator i).val = table i := funext (generator_apply i)
  rw [hg]
  revert i; decide +kernel
