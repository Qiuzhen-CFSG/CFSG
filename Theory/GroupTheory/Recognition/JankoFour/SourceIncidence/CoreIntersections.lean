module
public import Theory.GroupTheory.Recognition.JankoFour.SourceIncidence.PlaneUniqueness
public import Theory.GroupTheory.Recognition.JankoFour.SourceIncidence.Native.VectorIntersection
/-!
# Literal point-radical intersections and AS91 (6.2)

For nonadjacent points in one plane, the overlap supplement makes their
radical intersection invariant under M ∩ H. Ambient plane uniqueness permits
only the original sextet vector in that intersection. The native pair
calculation sends every pair vector to a sum which is a different sextet
vector, excluding the weight-two case. Thus the intersection is exactly the
order-two subgroup generated by the plane marker, distinct from the order-128
point stabilizer in E. Conjugation transports this to every ambient plane.

Together with the earlier neighboring-radical three-space, this proves
(6.2)(3) with its exact standing hypothesis: distinct conjugate radicals whose
intersection contains a conjugate of z have only conjugates of z among their
nonidentity intersection elements. Both the original left-coset comap and the
literal conjugate-map convention of the fusion consumer are retained. The
60/60 neighbor counts in a 77-point plane also give (6.2)(1).

Source: Aschbacher–Segev, Invent. Math. 105 (1991), (5.3)(2), (6.1)–(6.2),
pp.600–602, DOI 10.1007/BF01232280.
-/
public section
open Subgroup
open scoped Pointwise IsMulCommutative
namespace Theory.GroupTheory.Recognition.JankoFour.SourceIncidence.LocalData
open LocalGeometry LocalGeometry.LocalSubgroups SourceCycleBase GraphUniquenessSystem
open Sporadic.Mathieu Sporadic.Mathieu.M24LocalGeometry MathieuCode
variable {G : Type*} [Group G] [Finite G] {z : G} {h : IsTypeJ4 z} (a : LocalData h)

theorem core_normalizer (x : Point a.P) :
    normalizer (coreAt a.P x : Set G) = MulAction.stabilizer G x := by
  rw [←vertex_representative x,coreAt_vertex,Cosets.stabilizer_vertex,
    ←comap_normalizer_eq_of_surjective a.P.E (MulAut.conj (representative x)⁻¹).surjective,
    a.point_normalizer]

private theorem todd_vector_conjugation (g : M24) (v : Cocode) :
    a.P.vectorEmbedding (Multiplicative.ofAdd (cocodeRepresentation g v)) =
      (a.P.toddEquiv (SemidirectProduct.inr g) : G) *
        a.P.vectorEmbedding (Multiplicative.ofAdd v) *
          (a.P.toddEquiv (SemidirectProduct.inr g) : G)⁻¹ := by
  let j := a.P.M.subtype.comp a.P.toddEquiv.toMonoidHom
  have hh := congrArg j (SemidirectProduct.inl_aut (φ := toddAction) g (Multiplicative.ofAdd v))
  have hv : toddAction g (Multiplicative.ofAdd v) = Multiplicative.ofAdd (cocodeRepresentation g v) := rfl
  rw [hv] at hh
  simpa only [j,PointData.vectorEmbedding,MonoidHom.comp_apply,MulEquiv.coe_toMonoidHom,map_mul,map_inv,Subgroup.coe_subtype] using hh

/-- Every literal sextet vector is the marker of an actual ambient plane. -/
theorem sextet_vector_marker (S : Sextet) :
    ∃ π : Plane z, marker π = a.P.vectorEmbedding (Multiplicative.ofAdd (sextetVector S)) := by
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq M24 a.sextet S
  refine ⟨Cosets.vertex (centralizer z) (a.P.toddEquiv (SemidirectProduct.inr g)),?_⟩
  rw [marker_vertex,←hg,←NativeVectors.sextetVector_smul,a.todd_vector_conjugation,a.marker_vector]

private theorem nonneighbor_intersection_conj (u : Point a.P)
    (hu : OnPlane a.P u (Cosets.vertex (centralizer z) 1))
    (hne : u ≠ Cosets.vertex a.P.M 1) (hn : ¬ Adj a.L (Cosets.vertex a.P.M 1) u)
    (m : G) (hm : m ∈ a.P.M ⊓ centralizer z) (v : G)
    (hv : v ∈ a.P.E ⊓ coreAt a.P u) : m*v*m⁻¹ ∈ a.P.E ⊓ coreAt a.P u := by
  obtain ⟨e,k,hk,he⟩ := a.nonneighbor_overlap_supplement u hu hne hn m hm
  have hkE : k ∈ normalizer (a.P.E : Set G) := a.point_normalizer.symm ▸ hk.1.1
  have hkU : k ∈ normalizer (coreAt a.P u : Set G) := (a.core_normalizer u).symm ▸ hk.2
  have hvE := (mem_normalizer_iff.mp hkE v).mp hv.1
  have hvU := (mem_normalizer_iff.mp hkU v).mp hv.2
  let := a.P.E_elementary
  have hc : Commute (e : G) (k*v*k⁻¹) :=
    (Commute.all e (⟨k*v*k⁻¹,hvE⟩ : a.P.E)).map a.P.E.subtype
  have hh : m*v*m⁻¹ = k*v*k⁻¹ := by
    calc
      _ = (e : G)*(k*v*k⁻¹)*(e : G)⁻¹ := by rw [he]; group
      _ = k*v*k⁻¹ := mul_inv_eq_iff_eq_mul.mpr hc.eq
  rw [hh]
  exact ⟨hvE,hvU⟩

private theorem nonneighbor_intersection_sextet (u : Point a.P)
    (hu : OnPlane a.P u (Cosets.vertex (centralizer z) 1))
    (hne : u ≠ Cosets.vertex a.P.M 1) (hn : ¬ Adj a.L (Cosets.vertex a.P.M 1) u)
    (S : Sextet) (hS : a.P.vectorEmbedding (Multiplicative.ofAdd (sextetVector S)) ∈
      a.P.E ⊓ coreAt a.P u) : S = a.sextet := by
  obtain ⟨π,hπ⟩ := a.sextet_vector_marker S
  have hxπ : OnPlane a.P (Cosets.vertex a.P.M 1) π := by
    apply (a.marker_mem_core_base π).mp
    have hb : coreAt a.P (Cosets.vertex a.P.M 1) = a.P.E := by
      rw [coreAt_vertex]
      ext v
      simp
    rw [hb,hπ]
    exact hS.1
  have huπ : OnPlane a.P u π := (a.marker_mem_core π u).mp (hπ.symm ▸ hS.2)
  have he := a.unique_plane (Cosets.vertex (centralizer z) 1) (Cosets.vertex a.P.M 1) u
    ⟨1,rfl,rfl⟩ hu hne.symm hn π hxπ huπ
  have hv : a.P.vectorEmbedding (Multiplicative.ofAdd (sextetVector S)) = z := by
    rw [←hπ,he,marker_vertex]
    simp
  exact sextetVector_injective (congrArg Multiplicative.toAdd
    (a.P.vectorEmbedding_injective (hv.trans a.marker_vector.symm)))

private theorem nonneighbor_intersection_no_pair (u : Point a.P)
    (hu : OnPlane a.P u (Cosets.vertex (centralizer z) 1))
    (hne : u ≠ Cosets.vertex a.P.M 1) (hn : ¬ Adj a.L (Cosets.vertex a.P.M 1) u)
    (P : PointPair) : a.P.vectorEmbedding (Multiplicative.ofAdd (pairVector P)) ∉
      a.P.E ⊓ coreAt a.P u := by
  intro hv
  obtain ⟨g,S,hneS,he⟩ := NativeVectors.pair_displacement a.sextet P
  let m := a.P.toddEquiv (SemidirectProduct.inr g.val)
  have hm : (m : G) ∈ a.P.M ⊓ centralizer z := by
    refine ⟨m.property,(a.point_plane_todd_overlap m).mpr ?_⟩
    have he : a.P.projection m = g.val := by simp [m,PointData.projection]
    rw [he]
    exact g.property
  have hw := a.nonneighbor_intersection_conj u hu hne hn m hm _ hv
  rw [←a.todd_vector_conjugation] at hw
  have hs := (a.P.E ⊓ coreAt a.P u).mul_mem hv hw
  rw [←map_mul] at hs
  change a.P.vectorEmbedding (Multiplicative.ofAdd
    (pairVector P + cocodeRepresentation g.val (pairVector P))) ∈ _ at hs
  rw [he] at hs
  exact hneS (a.nonneighbor_intersection_sextet u hu hne hn S hs)

/-- The nonadjacent-plane radical intersection, distinct from E ∩ G_u. -/
theorem nonneighbor_core_intersection_elements (u : Point a.P)
    (hu : OnPlane a.P u (Cosets.vertex (centralizer z) 1))
    (hne : u ≠ Cosets.vertex a.P.M 1) (hn : ¬ Adj a.L (Cosets.vertex a.P.M 1) u)
    (v : G) (hv : v ∈ a.P.E ⊓ coreAt a.P u) : v = 1 ∨ v = z := by
  obtain ⟨w,hw⟩ := hv.1
  rcases NativeVectors.cocode_cases w.toAdd with hz | ⟨P,hP⟩ | ⟨S,hS⟩
  · left
    rw [←hw,show w = 1 from congrArg Multiplicative.ofAdd hz,map_one]
  · exfalso
    apply a.nonneighbor_intersection_no_pair u hu hne hn P
    have he : w = Multiplicative.ofAdd (pairVector P) := congrArg Multiplicative.ofAdd hP
    rwa [←he,hw]
  · right
    have he : w = Multiplicative.ofAdd (sextetVector S) := congrArg Multiplicative.ofAdd hS
    have hs := a.nonneighbor_intersection_sextet u hu hne hn S (by rwa [←he,hw])
    rw [←hw,he,hs,a.marker_vector]

theorem nonneighbor_core_intersection (u : Point a.P)
    (hu : OnPlane a.P u (Cosets.vertex (centralizer z) 1))
    (hne : u ≠ Cosets.vertex a.P.M 1) (hn : ¬ Adj a.L (Cosets.vertex a.P.M 1) u) :
    a.P.E ⊓ coreAt a.P u = zpowers z := by
  apply le_antisymm
  · intro v hv
    rcases a.nonneighbor_core_intersection_elements u hu hne hn v hv with he | he
    · rw [he]; exact (zpowers z).one_mem
    · rw [he]; exact mem_zpowers z
  · apply zpowers_le.mpr
    refine ⟨a.marker_mem_E,?_⟩
    have hh := (a.marker_mem_core (Cosets.vertex (centralizer z) 1) u).mpr hu
    simpa only [marker_vertex,one_mul,inv_one,mul_one,coe_toSubmonoid,SetLike.mem_coe,mem_toSubmonoid] using hh
/-- The same radical intersection at any ambient nonadjacent coplanar pair. -/
theorem nonadjacent_core_intersection_elements (π : Plane z) (x y : Point a.P)
    (hx : OnPlane a.P x π) (hy : OnPlane a.P y π) (hne : x ≠ y)
    (hn : ¬ Adj a.L x y) (v : G) (hv : v ∈ coreAt a.P x ⊓ coreAt a.P y) :
    v = 1 ∨ v = marker π := by
  obtain ⟨g,rfl,rfl⟩ := hx
  have hgx : g⁻¹ • Cosets.vertex a.P.M g = Cosets.vertex a.P.M 1 := by
    rw [Cosets.smul_vertex,inv_mul_cancel]
  have hy' : OnPlane a.P (g⁻¹ • y) (Cosets.vertex (centralizer z) 1) := by
    simpa only [OnPlane,Cosets.smul_vertex,inv_mul_cancel] using incident_smul g⁻¹ hy
  have hne' : g⁻¹ • y ≠ Cosets.vertex a.P.M 1 := by
    rw [←hgx]
    exact fun he => hne (MulAction.injective g⁻¹ he).symm
  have hn' : ¬ Adj a.L (Cosets.vertex a.P.M 1) (g⁻¹ • y) := by
    intro hh
    rw [←hgx] at hh
    exact hn (by simpa only [smul_inv_smul] using adj_smul g hh)
  have hv' : g⁻¹*v*g ∈ a.P.E ⊓ coreAt a.P (g⁻¹ • y) := by
    constructor
    · have hh := hv.1
      rw [coreAt_vertex] at hh
      simpa only [coe_toSubmonoid,SetLike.mem_coe,mem_toSubmonoid,mem_comap,MulEquiv.coe_toMonoidHom,MulAut.conj_apply,inv_inv] using hh
    · rw [coreAt_smul]
      simpa only [coe_toSubmonoid,SetLike.mem_coe,mem_toSubmonoid,mem_comap,MulEquiv.coe_toMonoidHom,MulAut.conj_apply,
        inv_inv,mul_assoc,mul_inv_cancel_left,mul_inv_cancel,mul_one] using hv.2
  rcases a.nonneighbor_core_intersection_elements (g⁻¹ • y) hy' hne' hn' _ hv' with he | he
  · left
    have hh := congrArg (fun w => g*w*g⁻¹) he
    simpa only [mul_assoc,mul_inv_cancel_left,mul_inv_cancel,mul_one] using hh
  · right
    have hh := congrArg (fun w => g*w*g⁻¹) he
    simpa only [mul_assoc,mul_inv_cancel_left,mul_inv_cancel,mul_one,marker_vertex] using hh

theorem nonadjacent_core_intersection (π : Plane z) (x y : Point a.P)
    (hx : OnPlane a.P x π) (hy : OnPlane a.P y π) (hne : x ≠ y)
    (hn : ¬ Adj a.L x y) : coreAt a.P x ⊓ coreAt a.P y = zpowers (marker π) := by
  apply le_antisymm
  · intro v hv
    rcases a.nonadjacent_core_intersection_elements π x y hx hy hne hn v hv with rfl | rfl
    · exact (zpowers (marker π)).one_mem
    · exact mem_zpowers (marker π)
  · apply zpowers_le.mpr
    exact ⟨(a.marker_mem_core π x).mpr hx,(a.marker_mem_core π y).mpr hy⟩

private theorem adjacent_intersection_conjugate (x y : Point a.P) (hxy : Adj a.L x y)
    (v : G) (hv : v ∈ coreAt a.P x ⊓ coreAt a.P y) (hne : v ≠ 1) : IsConj z v := by
  obtain ⟨hxy,l,hxl,hyl⟩ := hxy
  obtain ⟨g,rfl,rfl⟩ := hxl
  rw [a.core_intersection_at g y hyl hxy.symm] at hv
  have hv' : g⁻¹*v*g ∈ a.d.space := by
    simpa only [coe_toSubmonoid,SetLike.mem_coe,mem_toSubmonoid,mem_comap,MulEquiv.coe_toMonoidHom,MulAut.conj_apply,inv_inv] using hv
  have hne' : g⁻¹*v*g ≠ 1 := by
    intro hh
    have he := congrArg (fun w => g*w*g⁻¹) hh
    exact hne (by simpa only [mul_assoc,mul_inv_cancel_left,mul_inv_cancel,mul_one] using he)
  obtain ⟨n,_,he⟩ := a.d.normalizer_transitive _ hv' hne'
  refine isConj_iff.mpr ⟨g*n,?_⟩
  have hh := congrArg (fun w => g*w*g⁻¹) he
  change (g*n)*z*(g*n)⁻¹ = v
  simpa only [MulAut.conj_apply,mul_inv_rev,mul_assoc,mul_inv_cancel_left,mul_inv_cancel,mul_one] using hh

/-- Source (6.2)(3) with its standing marker-conjugate hypothesis retained. -/
theorem intersection_nonidentity_conjugate (x y : Point a.P) (hne : x ≠ y)
    (hm : ∃ w ∈ coreAt a.P x ⊓ coreAt a.P y, IsConj z w)
    (v : G) (hv : v ∈ coreAt a.P x ⊓ coreAt a.P y) (hv1 : v ≠ 1) : IsConj z v := by
  by_cases hxy : Adj a.L x y
  · exact a.adjacent_intersection_conjugate x y hxy v hv hv1
  · obtain ⟨w,hw,hwc⟩ := hm
    obtain ⟨k,hk⟩ := isConj_iff.mp hwc
    let π := Cosets.vertex (centralizer z) k
    have hπ : marker π = w := by rw [marker_vertex]; exact hk
    have hx : OnPlane a.P x π := (a.marker_mem_core π x).mp (hπ.symm ▸ hw.1)
    have hy : OnPlane a.P y π := (a.marker_mem_core π y).mp (hπ.symm ▸ hw.2)
    rcases a.nonadjacent_core_intersection_elements π x y hx hy hne hxy v hv with he | he
    · exact (hv1 he).elim
    · rw [he,hπ]
      exact hwc

/-- The literal conjugate-subgroup form needed by the section 6 fusion owner.
For distinct E and its conjugate, the intersection must contain a conjugate
of z before the conclusion about all its nonidentity elements is asserted. -/
theorem source_six_two_three (g : G)
    (hne : a.P.E ≠ a.P.E.comap (MulAut.conj g⁻¹).toMonoidHom)
    (hm : ∃ w ∈ a.P.E ⊓ a.P.E.comap (MulAut.conj g⁻¹).toMonoidHom, IsConj z w)
    (v : G) (hv : v ∈ a.P.E ⊓ a.P.E.comap (MulAut.conj g⁻¹).toMonoidHom)
    (hv1 : v ≠ 1) : IsConj z v := by
  have hb : coreAt a.P (Cosets.vertex a.P.M 1) = a.P.E := by
    rw [coreAt_vertex]
    ext v
    simp
  have hy : coreAt a.P (Cosets.vertex a.P.M g) = a.P.E.comap (MulAut.conj g⁻¹).toMonoidHom :=
    coreAt_vertex a.P g
  have hxy : Cosets.vertex a.P.M 1 ≠ Cosets.vertex a.P.M g := by
    intro he
    exact hne (hb.symm.trans ((congrArg (coreAt a.P) he).trans hy))
  apply a.intersection_nonidentity_conjugate _ _ hxy
  · rwa [hb,hy]
  · rwa [hb,hy]
  · exact hv1

/-- The two 60-point neighbor sets inside a 77-point plane meet. -/
theorem plane_common_neighbor (π : Plane z) (x y : Point a.P)
    (hx : OnPlane a.P x π) (hy : OnPlane a.P y π) :
    ∃ u, OnPlane a.P u π ∧ Adj a.L x u ∧ Adj a.L y u := by
  let A : Set (Point a.P) := {u | OnPlane a.P u π ∧ Adj a.L x u}
  let B : Set (Point a.P) := {u | OnPlane a.P u π ∧ Adj a.L y u}
  have ha : A.ncard = 60 := a.plane_neighbor_card π x hx
  have hb : B.ncard = 60 := a.plane_neighbor_card π y hy
  have hu : (A ∪ B).ncard ≤ 77 := by
    have hh : A ∪ B ⊆ {u | OnPlane a.P u π} := by
      intro u hu
      rcases hu with hu | hu
      · exact hu.1
      · exact hu.1
    simpa only [a.plane_card] using Set.ncard_le_ncard hh
  have hc := Set.ncard_union_add_ncard_inter A B
  rw [ha,hb] at hc
  have hp : 0 < (A ∩ B).ncard := by omega
  obtain ⟨u,hu⟩ := (Set.ncard_pos (s := A ∩ B)).mp hp
  exact ⟨u,hu.1.1,hu.1.2,hu.2.2⟩

/-- Source (6.2)(1), with its original marker-conjugate standing hypothesis. -/
theorem intersection_point_alternatives (x y : Point a.P)
    (hm : ∃ w ∈ coreAt a.P x ⊓ coreAt a.P y, IsConj z w) :
    x = y ∨ Adj a.L x y ∨ PlaneDistanceTwo a.L x y := by
  by_cases hxy : x = y
  · exact Or.inl hxy
  by_cases ha : Adj a.L x y
  · exact Or.inr (Or.inl ha)
  obtain ⟨w,hw,hwc⟩ := hm
  obtain ⟨k,hk⟩ := isConj_iff.mp hwc
  let π := Cosets.vertex (centralizer z) k
  have hπ : marker π = w := by rw [marker_vertex]; exact hk
  have hx : OnPlane a.P x π := (a.marker_mem_core π x).mp (hπ.symm ▸ hw.1)
  have hy : OnPlane a.P y π := (a.marker_mem_core π y).mp (hπ.symm ▸ hw.2)
  obtain ⟨u,_,hxu,hyu⟩ := a.plane_common_neighbor π x y hx hy
  exact Or.inr (Or.inr ⟨⟨hxy,ha,⟨u,hxu,adj_symm hyu⟩⟩,π,hx,hy⟩)

/-- Exact map convention of the independent source-fusion consumer. -/
theorem source_six_two_three_map (g : G)
    (hne : a.P.E.map (MulAut.conj g).toMonoidHom ≠ a.P.E)
    (hm : ∃ w ∈ a.P.E ⊓ a.P.E.map (MulAut.conj g).toMonoidHom, IsConj z w)
    (v : G) (hv : v ∈ a.P.E ⊓ a.P.E.map (MulAut.conj g).toMonoidHom)
    (hv1 : v ≠ 1) : IsConj z v := by
  have he : a.P.E.map (MulAut.conj g).toMonoidHom =
      a.P.E.comap (MulAut.conj g⁻¹).toMonoidHom := by
    ext v
    rw [mem_map_equiv]
    simp
  rw [he] at hne hm hv
  exact a.source_six_two_three g hne.symm hm v hv hv1

end Theory.GroupTheory.Recognition.JankoFour.SourceIncidence.LocalData
