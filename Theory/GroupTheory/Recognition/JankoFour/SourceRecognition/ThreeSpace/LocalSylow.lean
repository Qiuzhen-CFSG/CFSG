module
public import Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.ThreeSpace.FaithfulRadical
public import Theory.GroupTheory.PCoreProduct
public import Theory.GroupTheory.PCoreSurjective
public import Theory.Frattini.OmegaProducts

/-!
# The literal source line core and a compatible ambient Sylow subgroup

The quotient product (K/R) times (S/R) has trivial two-core. Lifting through
the original quotient therefore proves O2(N_G(Z))=R. The characteristic
center of R identifies N_G(R)=N_G(Z), and the faithful radical action gives
the full ambient centralizer C_G(R)=Z. Transport along the literal subgroup
inclusions supplies all intrinsic special-core and factor-quotient clauses
used in the line-group interface, including representative equations for
the existing K/R and S/R markings.

The original normalizer is transitive on the seven nonidentity elements of
Z. Thus its intersection with C_G(z) has index seven in N_G(Z), and the
proved orders give index 231 in C_G(z). A Sylow subgroup of this intersection
is Sylow in C_G(z), hence in G by the existing center-two-core promotion.
It contains both the original extraspecial core and R, has order 2^21 and
center generated by z. Its image under the original marked quotient is a
Sylow subgroup and is the product of its two projected factors.

This is the line-core and Sylow portion of the section 4 algebra required
by `SourceIncidence.LocalData`. The elementary Thompson subgroup E and the
split Todd subgroup, their overlaps, and recognition remain separate
construction obligations; none is an input here.

Source: Aschbacher--Segev, *The uniqueness of groups of type J4*, Invent.
Math. 105 (1991), (4.4)--(4.7), pp.597--598, DOI 10.1007/BF01232280.
-/

@[expose] public section
open Subgroup
namespace Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.ThreeSpaceData
variable {G : Type*} [Group G] [Finite G] {z : G}
variable {e : CubicAutomorphismQuotient (centralizer z ⧸ core z)}
  {X : Sylow 3 (LocalGeometry.CubicLift.subgroup e)}
variable (d : ThreeSpaceData z e X)
attribute [local instance] R_normal_in_K R_normal_in_S_intrinsic R_normal_in_normalizer

theorem R_subgroupOf_K_eq_twoCore (h : IsTypeJ4 z) : d.R.subgroupOf d.K = pCore 2 d.K := by
  rw [d.R_eq_K_twoCore h]
  exact comap_map_eq_self_of_injective d.K.subtype_injective _

theorem R_subgroupOf_S_eq_twoCore (h : IsTypeJ4 z) : d.R.subgroupOf d.S = pCore 2 d.S := by
  rw [d.R_eq_S_twoCore h]
  exact comap_map_eq_self_of_injective d.S.subtype_injective _

theorem normalizer_quotient_twoCore_eq_bot (h : IsTypeJ4 z) :
    pCore 2 (normalizer (d.space : Set G) ⧸ d.R.subgroupOf (normalizer (d.space : Set G))) = ⊥ := by
  have hk : pCore 2 (d.K ⧸ d.R.subgroupOf d.K) = ⊥ := by
    let f := QuotientGroup.quotientMulEquivOfEq (d.R_subgroupOf_K_eq_twoCore h)
    apply (Subgroup.map_eq_bot_iff_of_injective _ (f := f.toMonoidHom) f.injective).mp
    rw [pCore_map_iso, pCore_quotient_pCore_eq_bot]
  have hs : pCore 2 (d.S ⧸ d.R.subgroupOf d.S) = ⊥ := by
    let f := QuotientGroup.quotientMulEquivOfEq (d.R_subgroupOf_S_eq_twoCore h)
    apply (Subgroup.map_eq_bot_iff_of_injective _ (f := f.toMonoidHom) f.injective).mp
    rw [pCore_map_iso, pCore_quotient_pCore_eq_bot]
  rw [←pCore_map_iso 2 (d.quotientProductEquiv h),pCore_prod,hk,hs,bot_prod_bot,Subgroup.map_bot]

theorem normalizer_twoCore (h : IsTypeJ4 z) :
    pCore 2 (normalizer (d.space : Set G)) = d.R.subgroupOf (normalizer (d.space : Set G)) := by
  have hp : IsPGroup 2 d.R := by
    rw [d.R_eq_K_twoCore h]
    exact isPGroup_pCoreIn 2 d.K
  let q := QuotientGroup.mk' (d.R.subgroupOf (normalizer (d.space : Set G)))
  have hk : IsPGroup 2 q.ker := by
    rw [QuotientGroup.ker_mk']
    exact hp.comap_subtype
  have hh := q.comap_pCore_of_ker_isPGroup (QuotientGroup.mk'_surjective _) hk
  rw [d.normalizer_quotient_twoCore_eq_bot h,MonoidHom.comap_bot,QuotientGroup.ker_mk'] at hh
  exact hh.symm

theorem R_eq_normalizer_twoCore (h : IsTypeJ4 z) :
    d.R = (normalizer (d.space : Set G)).pCoreIn 2 := by
  change d.R = (pCore 2 (normalizer (d.space : Set G))).map _
  rw [d.normalizer_twoCore h,map_subgroupOf_eq_of_le d.R_le_normalizer]

theorem R_normalizer (h : IsTypeJ4 z) :
    normalizer (d.R : Set G) = normalizer (d.space : Set G) := by
  apply le_antisymm ?_ d.R_normalized
  rw [←d.R_center_eq_space h]
  exact normalizer_le_normalizer_characteristic_image d.R (center d.R)

theorem R_centralizer (h : IsTypeJ4 z) :
    Subgroup.centralizer (d.R : Set G) = d.space := by
  rw [←d.normalizer_radical_centralizer h]
  exact (inf_eq_right.mpr ((centralizer_le_normalizer _).trans (d.R_normalizer h).le)).symm

theorem normalizer_card (h : IsTypeJ4 z) :
    Nat.card (normalizer (d.space : Set G)) = 660602880 := by
  let : IsElementaryAbelian 2 d.space := d.elementary
  have hq : Nat.card (normalizer (d.space : Set G) ⧸
      d.R.subgroupOf (normalizer (d.space : Set G))) = 20160 := by
    rw [Nat.card_congr (d.markedNormalizerQuotientEquiv h).toEquiv,Nat.card_prod,
      card_mulAut_of_elementary_eight d.space d.card,Nat.card_perm,Nat.card_fin]
    norm_num
  have hr : Nat.card (d.R.subgroupOf (normalizer (d.space : Set G))) = 32768 :=
    (Nat.card_congr (subgroupOfEquivOfLe d.R_le_normalizer).toEquiv).trans (d.R_card h)
  have hh := (d.R.subgroupOf (normalizer (d.space : Set G))).card_mul_index
  change _ * Nat.card (normalizer (d.space : Set G) ⧸ _) = _ at hh
  rw [hr,hq] at hh
  exact hh.symm

theorem point_normalizer_index (h : IsTypeJ4 z) :
    (centralizer z).relIndex (normalizer (d.space : Set G)) = 7 := by
  classical
  let N := normalizer (d.space : Set G)
  let : MulAction N d.space := MulAction.compHom d.space d.normalizerAction
  let z₀ : d.space := ⟨z,by rw [space,d.generated]; exact subset_closure (by simp)⟩
  have hz₀ : z₀ ≠ 1 := by
    intro he
    have hz : z = 1 := congrArg Subtype.val he
    have hh := h.involution
    simp [hz] at hh
  have horbit : MulAction.orbit N z₀ = {t : d.space | t ≠ 1} := by
    ext t
    constructor
    · rintro ⟨a,ha⟩ he
      apply hz₀
      apply (d.normalizerAction a).injective
      exact ha.trans (he.trans (d.normalizerAction a).map_one.symm)
    · intro ht
      obtain ⟨n,hn,he⟩ := d.normalizer_transitive t.val t.property
        (fun he => ht (Subtype.ext he))
      exact ⟨⟨n,hn⟩,Subtype.ext he⟩
  have hstab : MulAction.stabilizer N z₀ = (centralizer z).subgroupOf N := by
    ext n
    change (d.normalizerAction n) z₀ = z₀ ↔ (n : G) ∈ centralizer z
    rw [mem_centralizer_singleton_iff]
    constructor
    · intro hh
      exact mul_inv_eq_iff_eq_mul.mp (congrArg Subtype.val hh)
    · intro hh
      apply Subtype.ext
      exact mul_inv_eq_iff_eq_mul.mpr hh
  change ((centralizer z).subgroupOf N).index = 7
  rw [←hstab,MulAction.index_stabilizer,horbit,←Nat.card_coe_set_eq]
  let := Fintype.ofFinite d.space
  change Nat.card {t : d.space // t ≠ 1} = 7
  rw [Nat.card_eq_fintype_card,Fintype.card_subtype_compl]
  simp only [Fintype.card_unique,←Nat.card_eq_fintype_card,show Nat.card d.space=8 from d.card]

theorem point_normalizer_card (h : IsTypeJ4 z) :
    Nat.card (centralizer z ⊓ normalizer (d.space : Set G) : Subgroup G) = 94371840 := by
  have hh := ((centralizer z).subgroupOf (normalizer (d.space : Set G))).card_mul_index
  rw [←card_map_of_injective (normalizer (d.space : Set G)).subtype_injective,
    subgroupOf_map_subtype] at hh
  change _ * (centralizer z).relIndex (normalizer (d.space : Set G)) = _ at hh
  rw [d.point_normalizer_index h,d.normalizer_card h] at hh
  omega

theorem centralizer_card (h : IsTypeJ4 z) : Nat.card (centralizer z) = 21799895040 := by
  have hh := (core z).card_mul_index
  change _ * Nat.card (centralizer z ⧸ core z) = _ at hh
  rw [h.core_card,coreQuotient_card h] at hh
  exact hh.symm

theorem point_normalizer_plane_index (h : IsTypeJ4 z) :
    (normalizer (d.space : Set G)).relIndex (centralizer z) = 231 := by
  have hh := ((normalizer (d.space : Set G)).subgroupOf (centralizer z)).card_mul_index
  rw [←card_map_of_injective (centralizer z).subtype_injective,
    subgroupOf_map_subtype,inf_comm,d.point_normalizer_card h,centralizer_card h] at hh
  change _ * (normalizer (d.space : Set G)).relIndex (centralizer z) = _ at hh
  omega

theorem exists_common_sylow (h : IsTypeJ4 z) :
    ∃ T : Sylow 2 G,
      (T : Subgroup G) ≤ centralizer z ⊓ normalizer (d.space : Set G) := by
  let C := centralizer z ⊓ normalizer (d.space : Set G)
  let U : Sylow 2 C := Sylow.nonempty.some
  let V : Subgroup (centralizer z) := (U : Subgroup C).map
    (inclusion (inf_le_left : C ≤ centralizer z))
  have hv : IsPGroup 2 V := U.isPGroup'.map _
  have hiC : (C.subgroupOf (centralizer z)).index = 231 := by
    change C.relIndex (centralizer z) = _
    rw [show C = centralizer z ⊓ normalizer (d.space : Set G) from rfl,inf_relIndex_left]
    exact d.point_normalizer_plane_index h
  have hiV : V.index = U.index * 231 := by
    dsimp only [V]
    rw [index_map_of_injective _ (inclusion_injective _)]
    have hr : (inclusion (inf_le_left : C ≤ centralizer z)).range = C.subgroupOf (centralizer z) := by
      ext x
      exact ⟨fun ⟨y,hy⟩ => hy ▸ y.property,fun hx => ⟨⟨x.val,hx⟩,Subtype.ext rfl⟩⟩
    rw [hr,hiC]
  have hi : ¬ 2 ∣ V.index := by
    rw [hiV]
    exact Nat.Prime.not_dvd_mul (by decide) U.not_dvd_index (by decide)
  let W : Sylow 2 (centralizer z) := hv.toSylow hi
  obtain ⟨T,hT⟩ := h.exists_ambient_sylow W
  refine ⟨T,?_⟩
  rw [hT]
  change V.map (centralizer z).subtype ≤ C
  dsimp only [V]
  rw [map_map]
  have hf : (centralizer z).subtype.comp (inclusion (inf_le_left : C ≤ centralizer z)) = C.subtype := rfl
  rw [hf]
  exact map_subtype_le _

theorem R_le_sylow (h : IsTypeJ4 z) (T : Sylow 2 G)
    (hT : (T : Subgroup G) ≤ normalizer (d.space : Set G)) : d.R ≤ (T : Subgroup G) := by
  have hh := pCoreIn_le_sylow (normalizer (d.space : Set G)) (T.subtype hT)
  rw [←d.R_eq_normalizer_twoCore h] at hh
  simpa only [Sylow.coe_subtype, map_subgroupOf_eq_of_le hT] using hh

theorem core_le_sylow (h : IsTypeJ4 z) (T : Sylow 2 G)
    (hT : (T : Subgroup G) ≤ centralizer z) : ambientCore z ≤ (T : Subgroup G) := by
  have hh := pCoreIn_le_sylow (centralizer z) (T.subtype hT)
  rw [pCoreIn,←h.core_eq_twoCore] at hh
  simpa only [Sylow.coe_subtype, map_subgroupOf_eq_of_le hT, ambientCore] using hh

theorem common_sylow_center (h : IsTypeJ4 z) (T : Sylow 2 G)
    (hT : (T : Subgroup G) ≤ centralizer z) :
    (center (T : Subgroup G)).map (T : Subgroup G).subtype = zpowers z := by
  have hh := h.sylow_center_image (T.subtype hT)
  let F := fun A : Subgroup G => (center A).map A.subtype
  exact (congrArg F (map_subgroupOf_eq_of_le hT)).symm.trans hh

theorem common_sylow_card (h : IsTypeJ4 z) (T : Sylow 2 G)
    (hT : (T : Subgroup G) ≤ centralizer z) : Nat.card T = 2 ^ 21 := by
  have hh := (T.subtype hT).card_eq_multiplicity
  rw [centralizer_card h] at hh
  have he := Nat.card_congr (subgroupOfEquivOfLe hT).toEquiv
  change Nat.card ((T : Subgroup G).subgroupOf (centralizer z)) = Nat.card T at he
  rw [Sylow.coe_subtype] at hh
  rw [he] at hh
  rw [show (21799895040 : ℕ) = 2^21 * 10395 from by norm_num,
    Nat.factorization_mul (by norm_num) (by norm_num),
    Nat.factorization_pow, Finsupp.add_apply, Finsupp.smul_apply,
    Nat.Prime.factorization_self (by decide : Nat.Prime 2),
    Nat.factorization_eq_zero_of_not_dvd (by decide : ¬ 2 ∣ 10395)] at hh
  simpa using hh

/-- The original full marked quotient, before quotienting its domain. -/
noncomputable def normalizerProjection (h : IsTypeJ4 z) :
    normalizer (d.space : Set G) →* MulAut d.space × Equiv.Perm (Fin 5) :=
  (d.markedNormalizerQuotientEquiv h).toMonoidHom.comp (QuotientGroup.mk' _)

theorem normalizerProjection_surjective (h : IsTypeJ4 z) :
    Function.Surjective (d.normalizerProjection h) :=
  (d.markedNormalizerQuotientEquiv h).surjective.comp (QuotientGroup.mk'_surjective _)

theorem normalizerProjection_ker (h : IsTypeJ4 z) :
    (d.normalizerProjection h).ker = d.R.subgroupOf (normalizer (d.space : Set G)) := by
  ext n
  change d.markedNormalizerQuotientEquiv h (QuotientGroup.mk' _ n) = 1 ↔ _
  constructor
  · intro hn
    apply (QuotientGroup.eq_one_iff n).mp
    exact (d.markedNormalizerQuotientEquiv h).injective
      (hn.trans (map_one (d.markedNormalizerQuotientEquiv h)).symm)
  · intro hn
    rw [show QuotientGroup.mk' (d.R.subgroupOf (normalizer (d.space : Set G))) n = 1
      from (QuotientGroup.eq_one_iff n).mpr hn,map_one]

theorem normalizerProjection_product (h : IsTypeJ4 z) (k : d.K) (s : d.S) :
    d.normalizerProjection h (⟨(k : G)*(s : G),
      (normalizer (d.space : Set G)).mul_mem (d.K_le_normalizer k.property)
        ((centralizer_le_normalizer _) s.property)⟩ : normalizer (d.space : Set G)) =
      (d.KAction k,d.SQuotientEquiv h (QuotientGroup.mk' _ s)) :=
  d.markedNormalizerQuotientEquiv_product h k s

/-- The same ambient Sylow, in the original quotient markings. -/
noncomputable def markedSylow (h : IsTypeJ4 z) (T : Sylow 2 G)
    (hT : (T : Subgroup G) ≤ normalizer (d.space : Set G)) :
    Sylow 2 (MulAut d.space × Equiv.Perm (Fin 5)) :=
  (T.subtype hT).mapSurjective (d.normalizerProjection_surjective h)

theorem markedSylow_image (h : IsTypeJ4 z) (T : Sylow 2 G)
    (hT : (T : Subgroup G) ≤ normalizer (d.space : Set G)) :
    (d.markedSylow h T hT : Subgroup (MulAut d.space × Equiv.Perm (Fin 5))) =
      ((T : Subgroup G).subgroupOf (normalizer (d.space : Set G))).map
        (d.normalizerProjection h) := rfl


noncomputable def normalizerCoreEquiv (h : IsTypeJ4 z) :
    pCore 2 (normalizer (d.space : Set G)) ≃* d.R :=
  (MulEquiv.subgroupCongr (d.normalizer_twoCore h)).trans
    (subgroupOfEquivOfLe d.R_le_normalizer)

@[simp] theorem normalizerCoreEquiv_val (h : IsTypeJ4 z)
    (x : pCore 2 (normalizer (d.space : Set G))) :
    (d.normalizerCoreEquiv h x : G) = ((x : normalizer (d.space : Set G)) : G) := rfl

theorem normalizer_core_card (h : IsTypeJ4 z) :
    Nat.card (pCore 2 (normalizer (d.space : Set G))) = 2^15 :=
  (Nat.card_congr (d.normalizerCoreEquiv h).toEquiv).trans (d.R_card h)

theorem normalizer_core_center_card (h : IsTypeJ4 z) :
    Nat.card (center (pCore 2 (normalizer (d.space : Set G)))) = 8 := by
  rw [Nat.card_congr (centerCongr (d.normalizerCoreEquiv h)).toEquiv,
    ←card_map_of_injective d.R.subtype_injective,d.R_center_eq_space h]
  exact d.card

theorem normalizer_core_center_elementary (h : IsTypeJ4 z) :
    IsElementaryAbelian 2 (center (pCore 2 (normalizer (d.space : Set G)))) := by
  let : IsElementaryAbelian 2 d.space := d.elementary
  let f : center d.R →* d.space := {
    toFun x := ⟨x.val.val, by
      rw [←d.R_center_eq_space h]
      exact mem_map_of_mem d.R.subtype x.property⟩
    map_one' := rfl
    map_mul' _ _ := rfl }
  have hf : Function.Injective f := by
    intro x y he
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun v : d.space => v.val) he
  let : IsElementaryAbelian 2 (center d.R) := IsElementaryAbelian.of_injective f hf
  exact IsElementaryAbelian.of_injective (centerCongr (d.normalizerCoreEquiv h)).toMonoidHom
    (centerCongr (d.normalizerCoreEquiv h)).injective

theorem normalizer_core_derived_eq_center (h : IsTypeJ4 z) :
    commutator (pCore 2 (normalizer (d.space : Set G))) =
      center (pCore 2 (normalizer (d.space : Set G))) := by
  apply map_injective (f := (d.normalizerCoreEquiv h).toMonoidHom) (d.normalizerCoreEquiv h).injective
  rw [map_commutator_eq, MonoidHom.range_eq_top.mpr (d.normalizerCoreEquiv h).surjective,
    ←_root_.commutator_def,center_map_equiv,d.R_derived_eq_center h]

theorem normalizer_core_frattini_eq_center (h : IsTypeJ4 z) :
    frattini (pCore 2 (normalizer (d.space : Set G))) =
      center (pCore 2 (normalizer (d.space : Set G))) := by
  apply map_injective (f := (d.normalizerCoreEquiv h).toMonoidHom) (d.normalizerCoreEquiv h).injective
  rw [frattini_map_equiv,center_map_equiv,d.R_frattini_eq_center h]

/-- The quotient marking for K viewed inside the actual line normalizer. -/
noncomputable def normalizerKQuotientEquiv (h : IsTypeJ4 z) :
    ((d.K.subgroupOf (normalizer (d.space : Set G))) ⧸
      (pCore 2 (normalizer (d.space : Set G))).subgroupOf
        (d.K.subgroupOf (normalizer (d.space : Set G)))) ≃* MulAut d.space := by
  let F := subgroupOfEquivOfLe d.K_le_normalizer
  refine (QuotientGroup.congr _ _ F ?_).trans (d.KQuotientEquivAut h)
  rw [d.normalizer_twoCore h]
  ext k
  constructor
  · rintro ⟨a,ha,rfl⟩
    exact ha
  · intro hk
    exact ⟨F.symm k,hk,F.apply_symm_apply k⟩

/-- The symmetric marking is the SAME previously constructed S/R marking. -/
noncomputable def normalizerSQuotientEquiv (h : IsTypeJ4 z) :
    ((d.S.subgroupOf (normalizer (d.space : Set G))) ⧸
      (pCore 2 (normalizer (d.space : Set G))).subgroupOf
        (d.S.subgroupOf (normalizer (d.space : Set G)))) ≃* Equiv.Perm (Fin 5) := by
  let F := subgroupOfEquivOfLe (show d.S ≤ normalizer (d.space : Set G) from centralizer_le_normalizer _)
  refine (QuotientGroup.congr _ _ F ?_).trans (d.SQuotientEquiv h)
  rw [d.normalizer_twoCore h]
  ext s
  constructor
  · rintro ⟨a,ha,rfl⟩
    exact ha
  · intro hs
    exact ⟨F.symm s,hs,F.apply_symm_apply s⟩

theorem normalizerKQuotientEquiv_mk (h : IsTypeJ4 z)
    (k : d.K.subgroupOf (normalizer (d.space : Set G))) :
    d.normalizerKQuotientEquiv h (QuotientGroup.mk' _ k) =
      d.KAction (subgroupOfEquivOfLe d.K_le_normalizer k) := rfl

theorem normalizerSQuotientEquiv_mk (h : IsTypeJ4 z)
    (s : d.S.subgroupOf (normalizer (d.space : Set G))) :
    d.normalizerSQuotientEquiv h (QuotientGroup.mk' _ s) =
      d.SQuotientEquiv h (QuotientGroup.mk' _
        (subgroupOfEquivOfLe (show d.S ≤ normalizer (d.space : Set G) from centralizer_le_normalizer _) s)) := rfl

/-- The relative factors intersect in the literal two-core of the line group. -/
theorem normalizer_factors_inf (h : IsTypeJ4 z) :
    d.K.subgroupOf (normalizer (d.space : Set G)) ⊓
      d.S.subgroupOf (normalizer (d.space : Set G)) = pCore 2 (normalizer (d.space : Set G)) := by
  rw [d.normalizer_twoCore h]
  rfl

theorem normalizer_factors_product (h : IsTypeJ4 z)
    (n : normalizer (d.space : Set G)) :
    ∃ k : d.K.subgroupOf (normalizer (d.space : Set G)),
      ∃ s : d.S.subgroupOf (normalizer (d.space : Set G)),
        (k : normalizer (d.space : Set G)) * (s : normalizer (d.space : Set G)) = n := by
  obtain ⟨k,hk,s,hs,he⟩ := d.normalizer_product h n.val n.property
  exact ⟨⟨⟨k,d.K_le_normalizer hk⟩,hk⟩,
    ⟨⟨s,(centralizer_le_normalizer _) hs⟩,hs⟩,Subtype.ext he⟩

theorem normalizer_K_image :
    (d.K.subgroupOf (normalizer (d.space : Set G))).map (normalizer (d.space : Set G)).subtype = d.K :=
  map_subgroupOf_eq_of_le d.K_le_normalizer

theorem normalizer_S_image :
    (d.S.subgroupOf (normalizer (d.space : Set G))).map (normalizer (d.space : Set G)).subtype = d.S :=
  map_subgroupOf_eq_of_le (centralizer_le_normalizer _)

theorem normalizer_K_quotient_PSL (h : IsTypeJ4 z) :
    Nonempty (((d.K.subgroupOf (normalizer (d.space : Set G))) ⧸
      (pCore 2 (normalizer (d.space : Set G))).subgroupOf
        (d.K.subgroupOf (normalizer (d.space : Set G)))) ≃* Matrix.PSL3Two.PSL) := by
  let : IsElementaryAbelian 2 d.space := d.elementary
  obtain ⟨f⟩ := MulAut.elementaryEight_equiv_PSL3 (show Nat.card d.space = 8 from d.card)
  exact ⟨(d.normalizerKQuotientEquiv h).trans f⟩


/-- No correlation between the two Sylow factors remains after the original marking. -/
theorem markedSylow_eq_prod (h : IsTypeJ4 z) (T : Sylow 2 G)
    (hT : (T : Subgroup G) ≤ normalizer (d.space : Set G)) :
    let U := d.markedSylow h T hT
    (U : Subgroup (MulAut d.space × Equiv.Perm (Fin 5))) =
      ((U : Subgroup (MulAut d.space × Equiv.Perm (Fin 5))).map (MonoidHom.fst _ _)).prod
      ((U : Subgroup (MulAut d.space × Equiv.Perm (Fin 5))).map (MonoidHom.snd _ _)) := by
  dsimp only
  let U := d.markedSylow h T hT
  let A := (U : Subgroup (MulAut d.space × Equiv.Perm (Fin 5))).map (MonoidHom.fst _ _)
  let B := (U : Subgroup (MulAut d.space × Equiv.Perm (Fin 5))).map (MonoidHom.snd _ _)
  have hp : IsPGroup 2 (A.prod B) :=
    (Subgroup.isPGroup_prod (U.isPGroup'.map _) (U.isPGroup'.map _)).of_equiv
      (Subgroup.prodEquiv A B).symm
  exact (U.is_maximal' hp (fun x hx =>
    ⟨mem_map_of_mem (MonoidHom.fst _ _) hx,mem_map_of_mem (MonoidHom.snd _ _) hx⟩)).symm

/-- All of the chosen Sylow data use the SAME literal source three-space. -/
theorem exists_common_sylow_structure (h : IsTypeJ4 z) :
    ∃ T : Sylow 2 G,
      (T : Subgroup G) ≤ centralizer z ⊓ normalizer (d.space : Set G) ∧
      ambientCore z ≤ (T : Subgroup G) ∧ d.R ≤ (T : Subgroup G) ∧
      d.space ≤ (T : Subgroup G) ∧ Nat.card T = 2^21 ∧
      (center (T : Subgroup G)).map (T : Subgroup G).subtype = zpowers z := by
  obtain ⟨T,hT⟩ := d.exists_common_sylow h
  have hR := d.R_le_sylow h T (hT.trans inf_le_right)
  refine ⟨T,hT,core_le_sylow h T (hT.trans inf_le_left),hR,?_,
    common_sylow_card h T (hT.trans inf_le_left),common_sylow_center h T (hT.trans inf_le_left)⟩
  rw [←d.R_center_eq_space h]
  exact (map_subtype_le _).trans hR

end Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.ThreeSpaceData
