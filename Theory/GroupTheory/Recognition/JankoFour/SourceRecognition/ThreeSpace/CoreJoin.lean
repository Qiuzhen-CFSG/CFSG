module
public import Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.ThreeSpace.Normalizer

/-!
# The source group generated by the seven cores

The three-space normalizer permutes the original centralizer cores at its
nonzero points. Their join is therefore relatively normal in that normalizer.
When the previously proved point fusion and core containment are supplied,
the join lies in the normalizer and is literally the source join of conjugates
of Q whose original central marker is in Z.

Source: Aschbacher–Segev, *The uniqueness of groups of type J₄*,
Invent. Math. 105 (1991), definition of K in (4.4), p.597,
DOI 10.1007/BF01232280. The actual construction supplying all premises is
`ThreeSpace.SourceData`; this module does not assume a recognition interface.
-/

@[expose] public section
open Subgroup
namespace Theory.GroupTheory.Recognition.JankoFour.SourceRecognition
variable {G : Type*} [Group G] [Finite G] {z : G}

/-- The join of the original centralizer cores at the seven nonzero points. -/
def threeSpaceCores (Z : Subgroup G) : Subgroup G :=
  ⨆ t : {t : G // t ∈ Z ∧ t ≠ 1}, ambientCore t.val

/-- Normalizing the three-space permutes its actual centralizer cores. -/
theorem threeSpaceCores_normalizer (Z : Subgroup G) :
    normalizer (Z : Set G) ≤ normalizer (threeSpaceCores Z : Set G) := by
  intro n hn
  apply mem_normalizer_iff_map_conj_eq.mpr
  apply eq_of_le_of_card_ge
  · change (threeSpaceCores Z).map (MulAut.conj n).toMonoidHom ≤ threeSpaceCores Z
    rw [threeSpaceCores,Subgroup.map_iSup]
    apply iSup_le
    intro t
    rw [ambientCore_map]
    have hm : n*t.val*n⁻¹ ∈ Z := (mem_normalizer_iff.mp hn t.val).mp t.property.1
    have hne : n*t.val*n⁻¹ ≠ 1 := by
      intro he
      exact t.property.2 ((MulAut.conj n).injective (he.trans (map_one (MulAut.conj n)).symm))
    exact le_iSup_of_le ⟨n*t.val*n⁻¹,hm,hne⟩ le_rfl
  · rw [card_map_of_injective (MulAut.conj n).injective]

omit [Finite G] in
theorem core_le_threeSpaceCores (Z : Subgroup G) (hz : z ∈ Z) (hz1 : z ≠ 1) :
    ambientCore z ≤ threeSpaceCores Z := le_iSup_of_le ⟨z,hz,hz1⟩ le_rfl

/-- With the proved point fusion, this is exactly the source join of
G-conjugates of Q whose central marker lies in Z. -/
theorem threeSpaceCores_eq_conjugate_join (h : IsTypeJ4 z) (Z : Subgroup G)
    (hf : ∀ t ∈ Z, t ≠ 1 → IsConj z t) :
    threeSpaceCores Z =
      ⨆ g : {g : G // MulAut.conj g z ∈ Z},
        (ambientCore z).map (MulAut.conj g.val).toMonoidHom := by
  apply le_antisymm
  · apply iSup_le
    intro t
    obtain ⟨g,hg⟩ := isConj_iff.mp (hf t.val t.property.1 t.property.2)
    have hm : MulAut.conj g z ∈ Z := by
      change g*z*g⁻¹ ∈ Z
      rw [hg]
      exact t.property.1
    apply le_iSup_of_le ⟨g,hm⟩
    rw [ambientCore_map]
    change ambientCore t.val ≤ ambientCore (g*z*g⁻¹)
    rw [hg]
  · apply iSup_le
    intro g
    rw [ambientCore_map]
    apply core_le_threeSpaceCores Z g.property
    intro he
    have hz1 : z = 1 := (MulAut.conj g.val).injective (he.trans (map_one (MulAut.conj g.val)).symm)
    have hz2 := h.involution
    simp [hz1] at hz2

/-- The exact relative normality of K in the ambient three-space normalizer. -/
theorem threeSpaceCores_normal_in_normalizer (Z : Subgroup G) :
    ((threeSpaceCores Z).subgroupOf (normalizer (Z : Set G))).Normal := by
  apply normal_subgroupOf_of_le_normalizer
  exact threeSpaceCores_normalizer Z

omit [Finite G] in
/-- All seven original cores lie in the original normalizer. -/
theorem threeSpaceCores_le_normalizer (Z : Subgroup G)
    (hn : ∀ t ∈ Z, t ≠ 1 → ambientCore t ≤ normalizer (Z : Set G)) :
    threeSpaceCores Z ≤ normalizer (Z : Set G) := by
  apply iSup_le
  intro t
  exact hn t.val t.property.1 t.property.2

end Theory.GroupTheory.Recognition.JankoFour.SourceRecognition
