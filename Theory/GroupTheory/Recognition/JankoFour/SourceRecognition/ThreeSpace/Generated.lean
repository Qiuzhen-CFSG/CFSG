module
public import Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.ThreeSpace.Intersection

/-!
# The three-space generated by returning markers

Choose a returning involution with the first native vector marking, and lift
an inverse scalar from the original cubic Sylow action. The two marked vectors
span the native binary two-space. The original core center supplies the third
binary dimension, so the triple-core intersection is exactly the subgroup
generated by the three conjugate markers. The final construction starts only
with `IsTypeJ4`; all markings, scalar lifts and intersection data are proved
internally. Its conclusion is an elementary subgroup of order eight.

Source: Aschbacher–Segev, *The uniqueness of groups of type J₄*,
Invent. Math. 105 (1991), (4.3)(2), p.597, DOI 10.1007/BF01232280.
This establishes the generated-three-space and triple-intersection clauses.
The source commutator description and subsequent normalizer structure are
not asserted here.
-/

@[expose] public section
open Subgroup Sporadic.Mathieu
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel
open Janko4.InvolutionCentralizers.First.QuotientExtension
open M22TripleCover.Ambient
namespace Theory.GroupTheory.Recognition.JankoFour.SourceRecognition
open VectorOrbits
variable {G : Type*} [Group G] [Finite G] {z : G}
variable (h : IsTypeJ4 z)
variable (e : CubicAutomorphismQuotient (centralizer z ⧸ core z))
variable (X : Sylow 3 (LocalGeometry.CubicLift.subgroup e))
variable [IsExtraspecial 2 (core z)]

/-- The second generator is the inverse scalar image of the returning marker. -/
theorem scalar_conjugate_mark (r : core z)
    (hmark : coreNativeEquiv h e X
      (Additive.ofMul (QuotientGroup.mk' (center (core z)) r)) = VectorOrbits.decode 4)
    (a : centralizer z)
    (ha : coreAmbientHom h e X (QuotientGroup.mk' (core z) a) = scalarElement) :
    coreNativeEquiv h e X
      (Additive.ofMul (QuotientGroup.mk' (center (core z)) (MulAut.conjNormal a⁻¹ r))) =
        vector 1471 := by
  let s : core z := MulAut.conjNormal a⁻¹ r
  have hs : MulAut.conjNormal a s = r := by
    apply Subtype.ext
    simp [s]
  have he := coreAmbientHom_intertwines h e X (QuotientGroup.mk' (core z) a)
    (Additive.ofMul (QuotientGroup.mk' (center (core z)) s))
  rw [coreBinaryRepresentation_apply,toMul_ofMul,coreQuotientAction_mk,hs,hmark,ha] at he
  have hv : binaryAction scalarElement (vector 1471) = VectorOrbits.decode 4 := by
    rw [ThreeSpace.Native.scalar_action,← vector_packedAction]
    decide +kernel
  have hi : Function.Injective (binaryAction scalarElement) := by
    intro v w hvw
    have hd := congrArg (binaryAction scalarElement⁻¹) hvw
    simpa only [← Module.End.mul_apply,← map_mul,inv_mul_cancel,map_one,Module.End.one_apply] using hd
  exact hi (he.symm.trans hv.symm)

/-- The triple-core intersection is precisely the subgroup generated by
its three original conjugate markers. -/
theorem triple_core_eq_closure (r : core z)
    (hr : IsConj z ((r : centralizer z) : G)) (hne : ((r : centralizer z) : G) ≠ z)
    (hmark : coreNativeEquiv h e X
      (Additive.ofMul (QuotientGroup.mk' (center (core z)) r)) = VectorOrbits.decode 4)
    (a : centralizer z)
    (ha : coreAmbientHom h e X (QuotientGroup.mk' (core z) a) = scalarElement) :
    (ambientCore z ⊓ ambientCore ((r : centralizer z) : G) ⊓
      ambientCore ((a : G)⁻¹ * ((r : centralizer z) : G) * (a : G))) =
        closure ({z, ((r : centralizer z) : G),
          (a : G)⁻¹ * ((r : centralizer z) : G) * (a : G)} : Set G) := by
  let s : core z := MulAut.conjNormal a⁻¹ r
  let A : Subgroup (core z) := coreIntersection z ((r : centralizer z) : G) ⊓
    coreIntersection z ((s : centralizer z) : G)
  let B : Subgroup G := closure ({z, ((r : centralizer z) : G),
    ((s : centralizer z) : G)} : Set G)
  have hs : IsConj z ((s : centralizer z) : G) :=
    hr.trans (isConj_iff.mpr ⟨(a : G)⁻¹,by simp [s]⟩)
  have hAz : center (core z) ≤ A :=
    le_inf (center_le_coreIntersection h hr (mem_map_of_mem _ r.property))
      (center_le_coreIntersection h hs (mem_map_of_mem _ s.property))
  have him : nativeImage h e X A = ThreeSpace.Native.line := by
    simpa [A,s] using triple_nativeImage h e X r hr hne hmark a ha
  have hmarkS : coreNativeEquiv h e X
      (Additive.ofMul (QuotientGroup.mk' (center (core z)) s)) = vector 1471 :=
    scalar_conjugate_mark h e X r hmark a ha
  have hlr : vector 4 ∈ ThreeSpace.Native.line := by
    exact ⟨![1,0],by simp [ThreeSpace.Native.lineMap]⟩
  have hls : vector 1471 ∈ ThreeSpace.Native.line := by
    refine ⟨![1,1],?_⟩
    simp only [ThreeSpace.Native.lineMap, LinearMap.coe_mk, AddHom.coe_mk,
      Matrix.cons_val_zero, Matrix.cons_val_one, one_smul]
    rw [← vector_xor]
    rfl
  have hrA : r ∈ A := (nativeImage_mem_iff h e X A hAz r).mp
    (by rw [hmark,him]; exact hlr)
  have hsA : s ∈ A := (nativeImage_mem_iff h e X A hAz s).mp
    (by rw [hmarkS,him]; exact hls)
  have hBz : center (core z) ≤ B.comap (coreInclusion z) := by
    intro q hq
    have hm : ((q : centralizer z) : G) ∈ zpowers z := by
      rw [← LocalGeometry.core_center_image h]
      exact mem_map_of_mem _ (mem_map_of_mem _ hq)
    exact (zpowers_le.mpr (subset_closure (by simp : z ∈
      ({z, ((r : centralizer z) : G), ((s : centralizer z) : G)} : Set G)))) hm
  have hrB : r ∈ B.comap (coreInclusion z) := subset_closure (by simp [coreInclusion])
  have hsB : s ∈ B.comap (coreInclusion z) := subset_closure (by simp [coreInclusion])
  have himB : ThreeSpace.Native.line ≤ nativeImage h e X (B.comap (coreInclusion z)) := by
    have hv4 : vector 4 ∈ nativeImage h e X (B.comap (coreInclusion z)) := by
      have hm := (nativeImage_mem_iff h e X _ hBz r).mpr hrB
      rw [hmark] at hm
      exact hm
    have hv1471 : vector 1471 ∈ nativeImage h e X (B.comap (coreInclusion z)) := by
      have hm := (nativeImage_mem_iff h e X _ hBz s).mpr hsB
      rw [hmarkS] at hm
      exact hm
    have hv1467 : vector 1467 ∈ nativeImage h e X (B.comap (coreInclusion z)) := by
      have hm := (nativeImage h e X (B.comap (coreInclusion z))).add_mem hv4 hv1471
      rw [← vector_xor] at hm
      exact hm
    rintro v ⟨u,rfl⟩
    exact (nativeImage h e X (B.comap (coreInclusion z))).add_mem
      (Submodule.smul_mem _ _ hv4) (Submodule.smul_mem _ _ hv1467)
  have hAB : A = B.comap (coreInclusion z) := by
    apply le_antisymm
    · intro q hq
      exact (nativeImage_mem_iff h e X _ hBz q).mp (himB
        (him ▸ (nativeImage_mem_iff h e X _ hAz q).mpr hq))
    · have hle : B ≤ A.map (coreInclusion z) := by
        apply (Subgroup.closure_le _).mpr
        intro g hg
        rcases (by simpa using hg : g = z ∨ g = ((r : centralizer z) : G) ∨
          g = ((s : centralizer z) : G)) with hg | hg | hg <;> subst g
        · have hz : z ∈ (center (core z)).map (coreInclusion z) := by
            rw [coreInclusion,← Subgroup.map_map,LocalGeometry.core_center_image h]
            exact mem_zpowers z
          exact map_mono hAz hz
        · exact mem_map_of_mem _ hrA
        · exact mem_map_of_mem _ hsA
      intro q hq
      have hm := hle hq
      obtain ⟨q',hq',he⟩ := hm
      exact (Subtype.val_injective.comp Subtype.val_injective he) ▸ hq'
  have hBcore : B ≤ ambientCore z := by
    apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases (by simpa using hg : g = z ∨ g = ((r : centralizer z) : G) ∨
      g = ((s : centralizer z) : G)) with hg | hg | hg <;> subst g
    · exact marker_mem_ambientCore z
    · exact mem_map_of_mem _ r.property
    · exact mem_map_of_mem _ s.property
  change (ambientCore z ⊓ ambientCore ((r : centralizer z) : G) ⊓
    ambientCore ((a : G)⁻¹ * ((r : centralizer z) : G) * (a : G))) = _
  have hm : A.map (coreInclusion z) = ambientCore z ⊓
      ambientCore ((r : centralizer z) : G) ⊓ ambientCore ((s : centralizer z) : G) := by
    dsimp only [A]
    rw [Subgroup.map_inf _ _ _ (Subtype.val_injective.comp Subtype.val_injective),
      coreIntersection_map,coreIntersection_map]
    ext g
    simp only [returningIntersection,Subgroup.mem_inf]
    tauto
  have he : A.map (coreInclusion z) = B := by
    rw [hAB,Subgroup.map_comap_eq]
    apply inf_eq_right.mpr
    intro g hg
    obtain ⟨c,hc,rfl⟩ := hBcore hg
    exact ⟨⟨c,hc⟩,rfl⟩
  have he' := hm.symm.trans he
  simpa [B,s] using he'

omit [IsExtraspecial 2 (core z)] in
include h in
/-- The genuine type-J₄ data construct three distinct conjugate central markers
whose original cores intersect in an elementary subgroup of order eight.
The construction uses a scalar lift in the original cubic Sylow; no geometry
or intersection witness is assumed. The intersection is exactly generated
by the three original markers. -/
theorem source_three_space :
    ∃ r s : G, IsConj z r ∧ IsConj z s ∧ r ≠ z ∧ s ≠ z ∧ r ≠ s ∧
      r ∈ ambientCore z ∧ s ∈ ambientCore z ∧
      IsElementaryAbelian 2 (ambientCore z ⊓ ambientCore r ⊓ ambientCore s : Subgroup G) ∧
      Nat.card (ambientCore z ⊓ ambientCore r ⊓ ambientCore s : Subgroup G) = 8 ∧
      (ambientCore z ⊓ ambientCore r ⊓ ambientCore s) =
        closure ({z,r,s} : Set G) := by
  let := h.extraspecial
  obtain ⟨e⟩ := h.cubic_quotient
  obtain ⟨X⟩ := (inferInstance : Nonempty (Sylow 3 (LocalGeometry.CubicLift.subgroup e)))
  obtain ⟨r,_,_,_,hrc,_,hmark,_,_⟩ := source_involution_orbit_cover h e X
  obtain ⟨g,w,hw,hwne⟩ := h.exists_returning_conjugate
  have hwc : IsConj z ((w : centralizer z) : G) := isConj_iff.mpr ⟨g,hw.symm⟩
  have hl := returning_label_four h e X w hwc hwne
  have hc : IsConj (r : centralizer z) (w : centralizer z) :=
    core_isConj_of_label h e X r w hrc (by rw [hmark,VectorOrbits.label_decode,hl]; rfl)
  have hr : IsConj z ((r : centralizer z) : G) :=
    hwc.trans ((centralizer z).subtype.map_isConj hc.symm)
  have hne : ((r : centralizer z) : G) ≠ z := by
    intro he
    apply hrc
    apply mem_center_iff.mpr
    intro q
    apply Subtype.ext
    apply Subtype.ext
    change ((q : centralizer z) : G) * ((r : centralizer z) : G) =
      ((r : centralizer z) : G) * ((q : centralizer z) : G)
    rw [he]
    exact mem_centralizer_singleton_iff.mp (q : centralizer z).property
  obtain ⟨a,_,ha⟩ := exists_scalar_lift h e X
  let s : core z := MulAut.conjNormal a⁻¹ r
  have hs : IsConj z ((s : centralizer z) : G) :=
    hr.trans (isConj_iff.mpr ⟨(a : G)⁻¹,by simp [s]⟩)
  have hR : ((r : centralizer z) : G) ∈ ambientCore z := mem_map_of_mem _ r.property
  have hS : ((s : centralizer z) : G) ∈ ambientCore z := mem_map_of_mem _ s.property
  have h8 : Nat.card (ambientCore z ⊓ ambientCore ((r : centralizer z) : G) ⊓
      ambientCore ((s : centralizer z) : G) : Subgroup G) = 8 :=
    by simpa [s] using (triple_core_card h e X r hr hne hmark a ha)
  have h128 := (returning_intersection_image_orders h hr hR hne).1
  have hsne : ((s : centralizer z) : G) ≠ z := by
    intro he
    rw [he,inf_eq_left.mpr inf_le_left] at h8
    change Nat.card (returningIntersection z ((r : centralizer z) : G)) = 8 at h8
    omega
  have hrs : ((r : centralizer z) : G) ≠ ((s : centralizer z) : G) := by
    intro he
    rw [← he,inf_assoc,inf_idem] at h8
    change Nat.card (returningIntersection z ((r : centralizer z) : G)) = 8 at h8
    omega
  let := returningIntersection_elementary h hr hne
  have hel : IsElementaryAbelian 2 (ambientCore z ⊓ ambientCore ((r : centralizer z) : G) ⊓
      ambientCore ((s : centralizer z) : G) : Subgroup G) :=
    IsElementaryAbelian.of_injective (inclusion inf_le_left) (inclusion_injective inf_le_left)
  have hgen : (ambientCore z ⊓ ambientCore ((r : centralizer z) : G) ⊓
      ambientCore ((s : centralizer z) : G)) =
        closure ({z,((r : centralizer z) : G),((s : centralizer z) : G)} : Set G) := by
    simpa [s] using triple_core_eq_closure h e X r hr hne hmark a ha
  exact ⟨_,_,hr,hs,hne,hsne,hrs,hR,hS,hel,h8,hgen⟩

omit [IsExtraspecial 2 (core z)] in
include h in
/-- The underlying triple-core order and elementary structure. -/
theorem source_three_core_intersection :
    ∃ r s : G, IsConj z r ∧ IsConj z s ∧ r ≠ z ∧ s ≠ z ∧ r ≠ s ∧
      r ∈ ambientCore z ∧ s ∈ ambientCore z ∧
      IsElementaryAbelian 2 (ambientCore z ⊓ ambientCore r ⊓ ambientCore s : Subgroup G) ∧
      Nat.card (ambientCore z ⊓ ambientCore r ⊓ ambientCore s : Subgroup G) = 8 := by
  obtain ⟨r,s,hr,hs,hrz,hsz,hrs,hrQ,hsQ,hel,h8,_⟩ := source_three_space h
  exact ⟨r,s,hr,hs,hrz,hsz,hrs,hrQ,hsQ,hel,h8⟩

end Theory.GroupTheory.Recognition.JankoFour.SourceRecognition
