module
public import Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.ThreeSpace.Multiplicity
public import Mathlib.Data.Fintype.Perm

/-!
# The original line stabilizers act trivially on their four-spaces

The image of each original point core on Z is an order-four transvection
subgroup, with displacement in the line generated by its central marker.
Two distinct such images are disjoint. They preserve the plane spanned by
their markers, and their join has at least sixteen elements. The plane
stabilizer embeds in the permutations of the four outside points, so the
orders inside GL₃(2) force both groups to have order twenty-four.

Each point core fixes its own radical section. Consequently the entire
plane stabilizer fixes the intersection of the two sections pointwise.
This removes the choice of K-element from transport between line sections:
the transport depends only on the image of the original plane, not on a
chosen lift. The action is the literal radical action through the existing
K/R marking, and it still commutes with the original S/R action.

This supplies the stabilizer and transport step in the dual-natural tensor
argument; the full tensor equivalence and natural L₂(4) identification are
not asserted here.

Source: Aschbacher–Segev, *The uniqueness of groups of type J₄*,
Invent. Math. 105 (1991), (4.4), pp.597–598, DOI 10.1007/BF01232280.
-/

@[expose] public section
open Subgroup
open scoped commutatorElement IsMulCommutative Pointwise
namespace Theory.GroupTheory.Recognition.JankoFour.SourceRecognition

/-- Automorphisms preserving the specified subgroup setwise. -/
def preservingSubgroup {V : Type*} [Group V] (W : Subgroup V) : Subgroup (MulAut V) where
  carrier := {a | ∀ v, a v ∈ W ↔ v ∈ W}
  one_mem' := fun _ => Iff.rfl
  mul_mem' ha hb v := (ha _).trans (hb v)
  inv_mem' {a} ha v := by
    have hh := ha (a⁻¹ v)
    simpa only [MulAut.apply_inv_self] using hh.symm

private def outsideAction {V : Type*} [Group V] (W : Subgroup V) :
    preservingSubgroup W →* Equiv.Perm {v : V // v ∉ W} where
  toFun a := {
    toFun v := ⟨a.val v,fun hv => v.property ((a.property _).mp hv)⟩
    invFun v := ⟨a.val⁻¹ v,fun hv => v.property (((a⁻¹).property _).mp hv)⟩
    left_inv v := Subtype.ext (a.val.symm_apply_apply v)
    right_inv v := Subtype.ext (a.val.apply_symm_apply v) }
  map_one' := by ext v; rfl
  map_mul' a b := by ext v; rfl

private theorem preserving_card_le {V : Type*} [Group V] [Finite V]
    (hV : Nat.card V = 8) (W : Subgroup V) (hW : Nat.card W = 4) :
    Nat.card (preservingSubgroup W) ≤ 24 := by
  classical
  let := Fintype.ofFinite V
  have hout : Nat.card {v : V // v ∉ W} = 4 := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype_compl,
      ←Nat.card_eq_fintype_card,←Nat.card_eq_fintype_card,hV,hW]
  obtain ⟨c⟩ : Nonempty {v : V // v ∉ W} :=
    (Nat.card_pos_iff.mp (by omega : 0 < Nat.card {v : V // v ∉ W})).1
  have hinj : Function.Injective (outsideAction W) := by
    intro a b hab
    have he (v : V) (hv : v ∉ W) : a.val v = b.val v :=
      congrArg (fun f : Equiv.Perm {v : V // v ∉ W} => (f ⟨v,hv⟩).val) hab
    apply Subtype.ext
    apply MulEquiv.ext
    intro v
    by_cases hv : v ∈ W
    · have hvc : v*c.val ∉ W := by
        intro hh
        exact c.property (by simpa using W.mul_mem (W.inv_mem hv) hh)
      have hh := he _ hvc
      rw [map_mul,map_mul,he c c.property] at hh
      exact mul_right_cancel hh
    · exact he v hv
  have hh := Nat.card_le_card_of_injective _ hinj
  rw [Nat.card_eq_fintype_card (α := Equiv.Perm _),Fintype.card_perm,
    ←Nat.card_eq_fintype_card,hout] at hh
  exact hh

private theorem zpowers_two_mem {V : Type*} [Group V] [Finite V]
    {t x : V} (ht : orderOf t = 2) (hx : x ∈ zpowers t) : x = 1 ∨ x = t := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf,ht] at hx
  obtain ⟨n,hn,he⟩ := Finset.mem_image.mp hx
  have hn' : n < 2 := Finset.mem_range.mp hn
  interval_cases n
  · exact Or.inl (by simpa using he.symm)
  · exact Or.inr (by simpa using he.symm)

namespace ThreeSpaceData
variable {G : Type*} [Group G] [Finite G] {z : G}
variable {e : CubicAutomorphismQuotient (centralizer z ⧸ core z)}
  {X : Sylow 3 (LocalGeometry.CubicLift.subgroup e)}
variable (d : ThreeSpaceData z e X)
local instance lineSpaceElementary : IsElementaryAbelian 2 d.space := d.elementary
attribute [local instance] R_normal_in_K

/-- The original point core acts by conjugation on the same Z. -/
def pointCoreAction (t : d.space) (ht : (t : G) ≠ 1) : ambientCore t.val →* MulAut d.space :=
  d.normalizerAction.comp (inclusion (d.cores_normalize t.val t.property ht))

/-- The literal image of that core, retaining its actual action map. -/
def pointTransvections (t : d.space) (ht : (t : G) ≠ 1) : Subgroup (MulAut d.space) :=
  (d.pointCoreAction t ht).range

theorem pointCoreAction_ker (t : d.space) (ht : (t : G) ≠ 1) :
    (d.pointCoreAction t ht).ker = d.S.subgroupOf (ambientCore t.val) := by
  ext q
  change d.pointCoreAction t ht q = 1 ↔ (q : G) ∈ d.S
  constructor
  · intro hh v hv
    have he := congrArg (fun a : MulAut d.space => (a ⟨v,hv⟩ : G)) hh
    change (q : G)*v*(q : G)⁻¹=v at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  · intro hh
    apply MulEquiv.ext
    intro v
    apply Subtype.ext
    change (q : G)*(v : G)*(q : G)⁻¹=(v : G)
    rw [←hh v v.property,mul_inv_cancel_right]

theorem pointTransvections_card (h : IsTypeJ4 z) (t : d.space) (ht : (t : G) ≠ 1) :
    Nat.card (d.pointTransvections t ht) = 4 := by
  have hk : Nat.card (d.pointCoreAction t ht).ker = 2048 := by
    rw [d.pointCoreAction_ker,←inf_subgroupOf_right,
      Nat.card_congr (subgroupOfEquivOfLe (show d.S ⊓ ambientCore t.val ≤ ambientCore t.val
        from inf_le_right)).toEquiv,inf_comm]
    exact d.coreCentralizer_card h t.property ht
  have hh := (d.pointCoreAction t ht).ker.card_mul_index
  rw [index_ker,hk] at hh
  have hQ : Nat.card (ambientCore t.val) = 8192 :=
    (Nat.card_congr (LocalGeometry.coreEquivAmbient t.val).toEquiv).symm.trans
      (d.point_type h t.property ht).core_card
  rw [hQ] at hh
  change Nat.card (d.pointCoreAction t ht).range = 4
  omega

theorem pointCoreAction_displacement (h : IsTypeJ4 z) (t : d.space)
    (ht : (t : G) ≠ 1) (q : ambientCore t.val) (v : d.space) :
    d.pointCoreAction t ht q v * v⁻¹ ∈ zpowers t := by
  have htp := d.point_type h t.property ht
  let := IsExtraspecial.of_mulEquiv (LocalGeometry.coreEquivAmbient t.val) htp.extraspecial
  have he : ⁅ambientCore t.val,ambientCore t.val⁆ = zpowers t.val := by
    rw [←map_subtype_commutator,IsExtraspecial.commutator_eq_center (p := 2),
      LocalGeometry.ambientCore_center_image htp]
  have hm := commutator_mem_commutator q.property (d.contained_in_cores t t.property ht v.property)
  rw [he] at hm
  have hm' : ((d.pointCoreAction t ht q v * v⁻¹ : d.space) : G) ∈
      (zpowers t).map d.space.subtype := by
    rw [MonoidHom.map_zpowers]
    exact hm
  exact (mem_map_iff_mem d.space.subtype_injective).mp hm'

theorem pointTransvections_disjoint (h : IsTypeJ4 z) (t u : d.space)
    (ht : (t : G) ≠ 1) (hu : (u : G) ≠ 1) (htu : t ≠ u) :
    Disjoint (d.pointTransvections t ht) (d.pointTransvections u hu) := by
  apply disjoint_def.mpr
  intro a ha hb
  obtain ⟨q,hq⟩ := ha
  obtain ⟨r,hr⟩ := hb
  apply MulEquiv.ext
  intro v
  have hdt : a v * v⁻¹ ∈ zpowers t := hq ▸ d.pointCoreAction_displacement h t ht q v
  have hdu : a v * v⁻¹ ∈ zpowers u := hr ▸ d.pointCoreAction_displacement h u hu r v
  have hot : orderOf t = 2 := (orderOf_coe t).symm.trans (d.point_type h t.property ht).involution
  have hou : orderOf u = 2 := (orderOf_coe u).symm.trans (d.point_type h u.property hu).involution
  have he : a v * v⁻¹ = 1 := by
    rcases zpowers_two_mem hot hdt with hh | hh
    · exact hh
    rcases zpowers_two_mem hou hdu with he | he
    · exact he
    exact (htu (hh.symm.trans he)).elim
  exact mul_inv_eq_one.mp he

/-- The Fano line, as a binary plane in the original three-space. -/
def pointLine (t u : d.space) : Subgroup d.space := closure ({t,u} : Set d.space)

/-- The setwise stabilizer of that original plane in Aut(Z). -/
def lineStabilizer (t u : d.space) : Subgroup (MulAut d.space) :=
  preservingSubgroup (d.pointLine t u)

theorem pointLine_card (t u : d.space)
    (ht : (t : G) ≠ 1) (hu : (u : G) ≠ 1) (htu : t ≠ u) :
    Nat.card (d.pointLine t u) = 4 := by
  have hp (v : d.space) : v*v=1 := by
    simpa only [pow_two] using Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 d.space) v
  let : IsKleinFour (d.pointLine t u) := isKleinFour_closure_pair t u (hp t) (hp u)
    (fun he => ht (congrArg Subtype.val he))
    (fun he => hu (congrArg Subtype.val he)) htu (mul_comm t u)
  exact IsKleinFour.card_four

theorem pointTransvections_le_lineStabilizer (h : IsTypeJ4 z) (t u : d.space)
    (ht : (t : G) ≠ 1) : d.pointTransvections t ht ≤ d.lineStabilizer t u := by
  rintro _ ⟨q,rfl⟩
  have hz : zpowers t ≤ d.pointLine t u := zpowers_le.mpr (subset_closure (by simp))
  have hforward (q : ambientCore t.val) (v : d.space) (hv : v ∈ d.pointLine t u) :
      d.pointCoreAction t ht q v ∈ d.pointLine t u := by
    have hh := (d.pointLine t u).mul_mem (hz (d.pointCoreAction_displacement h t ht q v)) hv
    simpa only [inv_mul_cancel_right] using hh
  intro v
  refine ⟨fun hv => ?_,hforward q v⟩
  simpa only [map_inv,MulAut.inv_apply_self] using hforward q⁻¹ _ hv

private theorem rootJoin_card (h : IsTypeJ4 z) (t u : d.space)
    (ht : (t : G) ≠ 1) (hu : (u : G) ≠ 1) (htu : t ≠ u) :
    Nat.card (d.pointTransvections t ht ⊔ d.pointTransvections u hu : Subgroup (MulAut d.space)) = 24 := by
  let A := d.pointTransvections t ht
  let B := d.pointTransvections u hu
  have hle : A ⊔ B ≤ d.lineStabilizer t u := by
    refine sup_le (d.pointTransvections_le_lineStabilizer h t u ht) ?_
    have he : d.lineStabilizer u t = d.lineStabilizer t u := by
      simp only [lineStabilizer,pointLine,Set.pair_comm]
    rw [←he]
    exact d.pointTransvections_le_lineStabilizer h u t hu
  let f : A × B → (A ⊔ B : Subgroup (MulAut d.space)) :=
    fun ab => ⟨ab.1.val*ab.2.val,mul_mem_sup ab.1.property ab.2.property⟩
  have hinj : Function.Injective f := fun _ _ he =>
    mul_injective_of_disjoint (d.pointTransvections_disjoint h t u ht hu htu)
      (congrArg Subtype.val he)
  have hlo := Nat.card_le_card_of_injective f hinj
  rw [Nat.card_prod,d.pointTransvections_card h t ht,d.pointTransvections_card h u hu] at hlo
  have hhi := (card_le_of_le hle).trans
    (preserving_card_le (show Nat.card d.space=8 from d.card) _ (d.pointLine_card t u ht hu htu))
  have hd := (A ⊔ B).card_subgroup_dvd_card
  rw [card_mulAut_of_elementary_eight d.space (show Nat.card d.space=8 from d.card)] at hd
  have hfour := card_dvd_of_le (show A ≤ A ⊔ B from le_sup_left)
  rw [d.pointTransvections_card h t ht] at hfour
  change Nat.card (A ⊔ B : Subgroup (MulAut d.space)) = 24
  generalize Nat.card (A ⊔ B : Subgroup (MulAut d.space)) = n at hlo hhi hd hfour ⊢
  interval_cases n <;> norm_num at hd
  all_goals norm_num at hfour
  rfl

theorem lineStabilizer_eq_pointTransvections_sup (h : IsTypeJ4 z) (t u : d.space)
    (ht : (t : G) ≠ 1) (hu : (u : G) ≠ 1) (htu : t ≠ u) :
    d.lineStabilizer t u = d.pointTransvections t ht ⊔ d.pointTransvections u hu := by
  symm
  apply eq_of_le_of_card_ge
  · refine sup_le (d.pointTransvections_le_lineStabilizer h t u ht) ?_
    have he : d.lineStabilizer u t = d.lineStabilizer t u := by
      simp only [lineStabilizer,pointLine,Set.pair_comm]
    rw [←he]
    exact d.pointTransvections_le_lineStabilizer h u t hu
  · rw [d.rootJoin_card h t u ht hu htu]
    exact preserving_card_le (show Nat.card d.space=8 from d.card) _ (d.pointLine_card t u ht hu htu)

theorem lineStabilizer_card (h : IsTypeJ4 z) (t u : d.space)
    (ht : (t : G) ≠ 1) (hu : (u : G) ≠ 1) (htu : t ≠ u) :
    Nat.card (d.lineStabilizer t u) = 24 := by
  rw [d.lineStabilizer_eq_pointTransvections_sup h t u ht hu htu]
  exact d.rootJoin_card h t u ht hu htu

/-- The radical action through the original K/R ≃ Aut(Z) marking. -/
noncomputable def linearRadicalAction (h : IsTypeJ4 z) :
    MulAut d.space →* MulAut (d.R ⧸ center d.R) :=
  (d.KRadicalAction h).comp (d.KQuotientEquivAut h).symm.toMonoidHom

@[simp] theorem linearRadicalAction_KAction (h : IsTypeJ4 z) (k : d.K) :
    d.linearRadicalAction h (d.KAction k) = d.radicalAction (inclusion d.K_le_normalizer k) := by
  rw [←d.KQuotientEquivAut_mk h k]
  change d.KRadicalAction h ((d.KQuotientEquivAut h).symm (d.KQuotientEquivAut h _)) = _
  rw [MulEquiv.symm_apply_apply,d.KRadicalAction_mk]

@[simp] theorem linearRadicalAction_pointCoreAction (h : IsTypeJ4 z) (t : d.space)
    (ht : (t : G) ≠ 1) (q : ambientCore t.val) :
    d.linearRadicalAction h (d.pointCoreAction t ht q) =
      d.radicalAction (inclusion (d.cores_normalize t.val t.property ht) q) :=
  d.linearRadicalAction_KAction h ⟨q.val,core_le_threeSpaceCores d.space t.property ht q.property⟩

private def radicalFixer (h : IsTypeJ4 z) (W : Subgroup (d.R ⧸ center d.R)) :
    Subgroup (MulAut d.space) where
  carrier := {a | ∀ v ∈ W, d.linearRadicalAction h a v = v}
  one_mem' := by intro v _; rw [map_one]; rfl
  mul_mem' {a b} ha hb := by intro v hv; rw [map_mul,MulAut.mul_apply,hb v hv,ha v hv]
  inv_mem' {a} ha := by
    intro v hv
    have he := congrArg (d.linearRadicalAction h a⁻¹) (ha v hv)
    simpa only [map_inv,MulAut.inv_apply_self] using he.symm

theorem lineStabilizer_fixes_pairSection (h : IsTypeJ4 z) (t u : d.space)
    (ht : (t : G) ≠ 1) (hu : (u : G) ≠ 1) (htu : t ≠ u)
    (a : MulAut d.space) (ha : a ∈ d.lineStabilizer t u)
    (v : d.R ⧸ center d.R) (hv : v ∈ d.coreSection t.val ⊓ d.coreSection u.val) :
    d.linearRadicalAction h a v = v := by
  have hle : d.lineStabilizer t u ≤ d.radicalFixer h (d.coreSection t.val ⊓ d.coreSection u.val) := by
    rw [d.lineStabilizer_eq_pointTransvections_sup h t u ht hu htu]
    apply sup_le
    · rintro _ ⟨q,rfl⟩ v hv
      rw [d.linearRadicalAction_pointCoreAction]
      exact d.pointCore_fixes_coreSection h t.property ht q hv.1
    · rintro _ ⟨q,rfl⟩ v hv
      rw [d.linearRadicalAction_pointCoreAction]
      exact d.pointCore_fixes_coreSection h u.property hu q hv.2
  exact hle ha v hv

theorem linearRadicalAction_conjugate_section (h : IsTypeJ4 z) (a : MulAut d.space)
    (t : d.space) :
    (d.coreSection t.val).map (d.linearRadicalAction h a).toMonoidHom =
      d.coreSection (a t).val := by
  obtain ⟨k,rfl⟩ := d.KAction_surjective h a
  rw [d.linearRadicalAction_KAction,d.coreSection_conjugate]
  rfl

theorem linearRadicalAction_commutes_S (h : IsTypeJ4 z) (a : MulAut d.space)
    (b : d.S ⧸ d.R.subgroupOf d.S) :
    Commute (d.linearRadicalAction h a) (d.SRadicalAction h b) :=
  d.radical_factors_commute h ((d.KQuotientEquivAut h).symm a) b

theorem lineTransport_independent (h : IsTypeJ4 z) (t u : d.space)
    (ht : (t : G) ≠ 1) (hu : (u : G) ≠ 1) (htu : t ≠ u)
    (a b : MulAut d.space)
    (he : (d.pointLine t u).map a.toMonoidHom = (d.pointLine t u).map b.toMonoidHom)
    (v : d.R ⧸ center d.R) (hv : v ∈ d.coreSection t.val ⊓ d.coreSection u.val) :
    d.linearRadicalAction h a v = d.linearRadicalAction h b v := by
  have hab : a⁻¹*b ∈ d.lineStabilizer t u := by
    intro w
    change a⁻¹ (b w) ∈ d.pointLine t u ↔ w ∈ d.pointLine t u
    have hm : a⁻¹ (b w) ∈ d.pointLine t u ↔ b w ∈ (d.pointLine t u).map a.toMonoidHom := by
      rw [mem_map_equiv]
      rfl
    rw [hm,he]
    exact mem_map_iff_mem b.injective
  have hf := d.lineStabilizer_fixes_pairSection h t u ht hu htu (a⁻¹*b) hab v hv
  rw [map_mul,map_inv,MulAut.mul_apply] at hf
  exact (congrArg (d.linearRadicalAction h a) hf).symm.trans
    ((d.linearRadicalAction h a).apply_symm_apply _)

theorem pairSectionTransport_independent (h : IsTypeJ4 z) (k l : d.K)
    (t u : G) (hkt : (k : G)*z*(k : G)⁻¹=t) (hku : (k : G)*d.r*(k : G)⁻¹=u)
    (hlt : (l : G)*z*(l : G)⁻¹=t) (hlu : (l : G)*d.r*(l : G)⁻¹=u) :
    d.pairSectionTransport h k z d.r t u hkt hku =
      d.pairSectionTransport h l z d.r t u hlt hlu := by
  let t₀ := d.markedPoint 0
  let u₀ := d.markedPoint 1
  have ht₀ : (t₀ : G) ≠ 1 := by
    intro he
    have hi := h.involution
    change z=1 at he
    simp [he] at hi
  have hu₀ : (u₀ : G) ≠ 1 := by
    intro he
    exact ht₀ (isConj_one_left.mp (he ▸ d.r_conj))
  have htu : t₀ ≠ u₀ := fun he => d.r_ne (congrArg Subtype.val he).symm
  have he : (d.pointLine t₀ u₀).map (d.KAction k).toMonoidHom =
      (d.pointLine t₀ u₀).map (d.KAction l).toMonoidHom := by
    have h₀ : d.KAction k t₀ = d.KAction l t₀ := Subtype.ext (hkt.trans hlt.symm)
    have h₁ : d.KAction k u₀ = d.KAction l u₀ := Subtype.ext (hku.trans hlu.symm)
    simp only [pointLine,MonoidHom.map_closure,Set.image_insert_eq,Set.image_singleton,
      MulEquiv.toMonoidHom_eq_coe,MonoidHom.coe_coe,h₀,h₁]
  apply MulEquiv.ext
  intro w
  apply Subtype.ext
  rw [d.pairSectionTransport_apply,d.pairSectionTransport_apply,
    d.KRadicalAction_mk,d.KRadicalAction_mk]
  have hh := d.lineTransport_independent h t₀ u₀ ht₀ hu₀ htu
    (d.KAction k) (d.KAction l) he w w.property
  simpa only [d.linearRadicalAction_KAction] using hh

end ThreeSpaceData
end Theory.GroupTheory.Recognition.JankoFour.SourceRecognition
