module

public import Theory.GroupTheory.Recognition.JankoFour.LocalGeometry.Intrinsic
public import Theory.GroupTheory.GeneralizedFitting.CentralizerViaCComponents
public import Theory.GroupTheory.CenterTwoCoreSylowPromotion

/-!
# Sylow subgroups of a type-J₄ involution centralizer

The extraspecial generalized Fitting subgroup contains its centralizer.
Its center has order two, so the center of every local Sylow subgroup is
generated by the original involution. The normalizer of that Sylow fixes
the involution and is contained in its centralizer; local Sylow maximality
therefore promotes the very same subgroup to an ambient Sylow subgroup.

This proves (4.5) directly from the original type-J₄ hypotheses, without
requiring the source's particular choice of the subgroup G₁,₃. It also
identifies the full ambient centralizer of the extraspecial core, needed
for the faithful local action in §4.

Source: Aschbacher–Segev, *The uniqueness of groups of type J₄*, Invent.
Math. 105 (1991), §4, printed pp.597–598, especially (4.5).
-/

public section

namespace Theory.GroupTheory.Recognition.JankoFour

open Subgroup LocalGeometry

variable {G : Type*} [Group G] [Finite G] {z : G}

namespace IsTypeJ4

theorem twoCore_selfCentralizing (h : IsTypeJ4 z) :
    Subgroup.centralizer (pCore 2 (centralizer z) : Set (centralizer z)) ≤
      pCore 2 (centralizer z) := by
  rw [← h.core_eq_twoCore]
  exact centralizer_generalizedFitting_le (centralizer z)

theorem twoCore_center_card (h : IsTypeJ4 z) :
    Nat.card (center (pCore 2 (centralizer z))) = 2 := by
  rw [← h.core_eq_twoCore]
  let := h.extraspecial
  exact IsExtraspecial.center_order_p 2 (core z)

/-- The center of the full local centralizer is the original involution line. -/
theorem centralizer_center_image (h : IsTypeJ4 z) :
    (center (centralizer z)).map (centralizer z).subtype = zpowers z :=
  (centralizer_structure_of_center_two_core z h.involution
    h.twoCore_center_card h.twoCore_selfCentralizing).2.1

/-- The full ambient centralizer of the extraspecial core is its center. -/
theorem centralizer_ambientCore (h : IsTypeJ4 z) :
    Subgroup.centralizer (ambientCore z : Set G) = zpowers z := by
  apply le_antisymm
  · intro x hx
    have hxC : x ∈ centralizer z :=
      mem_centralizer_singleton_iff.mpr (hx z (marker_mem_ambientCore z)).symm
    have hxQ : (⟨x, hxC⟩ : centralizer z) ∈ core z := by
      apply centralizer_generalizedFitting_le (centralizer z)
      intro q hq
      exact Subtype.ext (hx q (mem_map_of_mem (centralizer z).subtype hq))
    have hxA : x ∈ ambientCore z := mem_map_of_mem (centralizer z).subtype hxQ
    rw [← ambientCore_center_image h]
    exact ⟨⟨x, hxA⟩, mem_center_iff.mpr
      (fun q => Subtype.ext (hx q q.property)), rfl⟩
  · rw [← ambientCore_center_image h]
    rintro x ⟨q, hq, rfl⟩ y hy
    exact congrArg Subtype.val (mem_center_iff.mp hq ⟨y, hy⟩)

/-- The chosen local Sylow subgroup has center generated by z, in the
literal ambient embedding. -/
theorem sylow_center_image (h : IsTypeJ4 z) (T : Sylow 2 (centralizer z)) :
    let S := (T : Subgroup (centralizer z)).map (centralizer z).subtype
    (center S).map S.subtype = zpowers z :=
  mapped_sylow_center_of_center_two_core z h.involution
    h.twoCore_center_card h.twoCore_selfCentralizing T

/-- Source (4.5), retaining any chosen Sylow subgroup and its actual embedding. -/
theorem exists_ambient_sylow (h : IsTypeJ4 z) (T : Sylow 2 (centralizer z)) :
    ∃ S : Sylow 2 G,
      (S : Subgroup G) = (T : Subgroup (centralizer z)).map (centralizer z).subtype :=
  (centralizer_structure_of_center_two_core z h.involution
    h.twoCore_center_card h.twoCore_selfCentralizing).2.2 T

end IsTypeJ4

end Theory.GroupTheory.Recognition.JankoFour

end
