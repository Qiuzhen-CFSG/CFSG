module
public import Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.Naturality
public import Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.CoreStabilizers
public import Theory.GroupTheory.ExtraspecialIntersection
public import Theory.GroupTheory.PGroup.ExtraspecialNormalizedFour
public import Theory.Mathieu.M22.Properties.TwoRank
public import Theory.Quasithin.CoprimeRank

/-!
# Returning cores and their literal quotient image

For a distinct returning conjugate r of z, C_Q(r) has order 4096 and its
image in C_G(r)/Q_r has order at most 256. Its kernel Q ∩ Q_r therefore has
order at least sixteen. If this intersection omitted z, the extraspecial
commutator pairing would put it in the four generated by z and r, a
contradiction. This constructs reciprocal core membership.

The distinct central lines make Q ∩ Q_r elementary abelian, of order at
most 128. Its complementary image (Q_r ∩ H)Q/Q is elementary abelian and
normal in the literal C_H(r)Q/Q. Their orders multiply to 4096. The genuine
cubic quotient and the Aut(M₂₂) two-rank bound force equality: the orders
are 128 and 32. In particular the actual quotient stabilizer has two-core
of order at least 32, the source premise used to exclude its second orbit.

Source: Aschbacher–Segev, *The uniqueness of groups of type J₄*, Invent.
Math. 105 (1991), (4.3), printed p.597, DOI 10.1007/BF01232280.
This proves the intersection-rank clause and constructs the normal image;
it does not yet identify the returning H-class, the three-space Z, or the
later geometry and ambient recognition.
-/

@[expose] public section
open Subgroup
open scoped commutatorElement
namespace Theory.GroupTheory.Recognition.JankoFour.SourceRecognition
variable {G : Type*} [Group G] [Finite G] {z : G}

private theorem type_of_isConj (h : IsTypeJ4 z) {r : G} (hr : IsConj z r) : IsTypeJ4 r := by
  obtain ⟨g,rfl⟩ := isConj_iff.mp hr
  exact type_map h (MulAut.conj g)

private theorem ambient_extraspecial (h : IsTypeJ4 z) : IsExtraspecial 2 (ambientCore z) :=
  IsExtraspecial.of_mulEquiv (LocalGeometry.coreEquivAmbient z) h.extraspecial

private theorem ambient_card (h : IsTypeJ4 z) : Nat.card (ambientCore z) = 8192 :=
  (Nat.card_congr (LocalGeometry.coreEquivAmbient z).toEquiv).symm.trans h.core_card

private theorem involution_not_mem_line (h : IsTypeJ4 z) {r : G}
    (hr : orderOf r = 2) (hne : r ≠ z) : r ∉ zpowers z := by
  intro hm
  have hz1 : z ≠ 1 := by intro he; simpa [he] using h.involution
  have hr1 : r ≠ 1 := by intro he; simp [he] at hr
  obtain ⟨w,_,hw⟩ := (Nat.card_eq_two_iff' (1 : zpowers z)).mp
    ((Nat.card_zpowers z).trans h.involution)
  exact hne (congrArg Subtype.val ((hw ⟨r,hm⟩ (fun he => hr1 (congrArg Subtype.val he))).trans
    (hw ⟨z,mem_zpowers z⟩ (fun he => hz1 (congrArg Subtype.val he))).symm))

/-- The actual returning-core intersection, in the original ambient group. -/
abbrev returningIntersection (z r : G) : Subgroup G := ambientCore z ⊓ ambientCore r

/-- The part of the first core centralizing the returning involution. -/
abbrev returningCentralizer (z r : G) : Subgroup G := ambientCore z ⊓ centralizer r

private theorem returningCentralizer_card (h : IsTypeJ4 z) {r : G}
    (hr : IsTypeJ4 r) (hrQ : r ∈ ambientCore z) (hne : r ≠ z) :
    Nat.card (returningCentralizer z r) = 4096 := by
  let := ambient_extraspecial h
  have hb := ExtraspecialIntersection.card_inf_centralizer_mul_two (ambientCore z) r hrQ
    (by rw [LocalGeometry.ambientCore_center_image h]; exact involution_not_mem_line h hr.involution hne)
  rw [ambient_card h] at hb
  change Nat.card (returningCentralizer z r) * 2 = 8192 at hb
  omega

/-- Quotienting this centralizer uses the literal second core and quotient map. -/
noncomputable def returningProjection (z r : G) :
    returningCentralizer z r →* (centralizer r ⧸ core r) :=
  (QuotientGroup.mk' (core r)).comp (inclusion inf_le_right)

private theorem returningProjection_kernel_card (z r : G) :
    Nat.card (returningProjection z r).ker = Nat.card (returningIntersection z r) := by
  have hk : (returningProjection z r).ker =
      (returningIntersection z r).subgroupOf (returningCentralizer z r) := by
    ext x
    change QuotientGroup.mk' (core r) ⟨x.val,x.property.2⟩ = 1 ↔ _
    constructor
    · intro hx
      have hx' : (⟨x.val,x.property.2⟩ : centralizer r) ∈ core r :=
        (QuotientGroup.eq_one_iff _).mp hx
      exact ⟨x.property.1, mem_map_of_mem (centralizer r).subtype hx'⟩
    · rintro ⟨_,a,ha,he⟩
      apply (QuotientGroup.eq_one_iff _).mpr
      have he' : a = (⟨x.val,x.property.2⟩ : centralizer r) := Subtype.ext he
      exact he' ▸ ha
  rw [hk]
  exact Nat.card_congr (subgroupOfEquivOfLe
    (inf_le_inf_left _ (LocalGeometry.ambientCore_le r))).toEquiv

/-- The quotient Sylow order forces a sizeable actual intersection before
mutual core containment has been established. -/
theorem returningIntersection_card_lower (h : IsTypeJ4 z) {r : G}
    (hr : IsConj z r) (hrQ : r ∈ ambientCore z) (hne : r ≠ z) :
    16 ≤ Nat.card (returningIntersection z r) := by
  have ht := type_of_isConj h hr
  let := ambient_extraspecial h
  have hp : IsPGroup 2 (returningCentralizer z r) :=
    (IsExtraspecial.isPGroup 2 (ambientCore z)).of_injective
      (inclusion inf_le_left) (inclusion_injective inf_le_left)
  have hi := hp.of_surjective (returningProjection z r).rangeRestrict
    (returningProjection z r).rangeRestrict_surjective
  obtain ⟨S,hS⟩ := hi.exists_le_sylow
  have hSc : Nat.card S = 256 := by
    rw [Sylow.card_eq_multiplicity,coreQuotient_card ht]
    decide +kernel
  have hib := card_le_of_le hS
  rw [hSc] at hib
  have hc := (returningProjection z r).ker.card_mul_index
  rw [index_ker, returningProjection_kernel_card, returningCentralizer_card h ht hrQ hne] at hc
  nlinarith

private theorem involution_mem_normalized_large
    {P : Type*} [Group P] [Finite P] [IsExtraspecial 2 P]
    (z u : P) (hz : orderOf z = 2) (hzZ : z ∈ center P)
    (hu : orderOf u = 2) (huz : u ≠ z)
    (V : Subgroup P) (hV : 4 ≤ Nat.card V)
    (hn : Subgroup.centralizer ({u} : Set P) ≤ normalizer (V : Set P)) : z ∈ V := by
  by_contra hzV
  have hz1 : z ≠ 1 := by intro he; simp [he] at hz
  have htriv (a : P) (haZ : a ∈ center P) (haV : a ∈ V) : a = 1 := by
    by_contra ha
    obtain ⟨w,_,hw⟩ := (Nat.card_eq_two_iff' (1 : center P)).mp
      (IsExtraspecial.center_order_p 2 P)
    have he : a = z := congrArg Subtype.val ((hw ⟨a,haZ⟩
      (fun he => ha (congrArg Subtype.val he))).trans
      (hw ⟨z,hzZ⟩ (fun he => hz1 (congrArg Subtype.val he))).symm)
    exact hzV (he ▸ haV)
  have hVC : V ≤ Subgroup.centralizer (Subgroup.centralizer ({u} : Set P) : Set P) := by
    intro v hv c hc
    apply commutatorElement_eq_one_iff_mul_comm.mp
    exact htriv _
      ((IsExtraspecial.quotient_elementary_abelian 2 P).commutator_le_center_of_central_quotient
        (commutator_mem_commutator (mem_top c) (mem_top v)))
      (le_normalizer_iff_commutator_le_right.mp hn (commutator_mem_commutator hc hv))
  let : IsExtraspecial 2 (⊤ : Subgroup P) := IsExtraspecial.of_mulEquiv topEquiv.symm inferInstance
  have hd := IsExtraspecial.ambient_involution_double_centralizer_le
    (⊤ : Subgroup P) le_top z u hz hzZ (mem_top u) hu
  have hi : ((⊤ : Subgroup P) ⊓ Subgroup.centralizer ({u} : Set P) : Set P) =
      (Subgroup.centralizer ({u} : Set P) : Set P) := by ext x; simp
  rw [hi] at hd
  let E := closure ({z,u} : Set P)
  have hVE : V ≤ E := hVC.trans hd
  let : IsKleinFour E := isKleinFour_closure_pair_of_orderOf z u hz hu huz.symm
    (mem_center_iff.mp hzZ u).symm
  have he : V = E := eq_of_le_of_card_ge hVE (by rw [IsKleinFour.card_four]; exact hV)
  exact hzV (he ▸ subset_closure (by simp))

/-- Reciprocal incidence follows from the actual normalizers and the order
bound; it is not an additional hypothesis on the returning conjugate. -/
theorem returning_core_reciprocity (h : IsTypeJ4 z) {r : G}
    (hr : IsConj z r) (hrQ : r ∈ ambientCore z) : z ∈ ambientCore r := by
  by_cases hne : r = z
  · subst r
    exact marker_mem_ambientCore z
  have ht := type_of_isConj h hr
  let Q := ambientCore z
  let Z : Q := ⟨z,marker_mem_ambientCore z⟩
  let U : Q := ⟨r,hrQ⟩
  let V := (returningIntersection z r).subgroupOf Q
  let := ambient_extraspecial h
  have hZ : Z ∈ center Q := mem_center_iff.mpr (fun q =>
    Subtype.ext (mem_centralizer_singleton_iff.mp (LocalGeometry.ambientCore_le z q.property)))
  have hvcard : 4 ≤ Nat.card V := by
    change 4 ≤ Nat.card ((ambientCore z ⊓ ambientCore r).subgroupOf (ambientCore z))
    rw [Nat.card_congr (subgroupOfEquivOfLe inf_le_left).toEquiv]
    exact (by decide : 4 ≤ 16).trans (returningIntersection_card_lower h hr hrQ hne)
  have hn : Subgroup.centralizer ({U} : Set Q) ≤ normalizer (V : Set Q) := by
    intro c hc
    apply Subgroup.le_normalizer_comap Q.subtype
    apply inf_normalizer_le_normalizer_inf
    refine ⟨Q.le_normalizer c.property, ?_⟩
    rw [LocalGeometry.normalizer_ambientCore ht]
    exact mem_centralizer_singleton_iff.mpr (congrArg Subtype.val
      (mem_centralizer_singleton_iff.mp hc))
  exact (involution_mem_normalized_large Z U
    ((orderOf_coe Z).symm.trans h.involution) hZ
    ((orderOf_coe U).symm.trans ht.involution)
    (fun he => hne (congrArg Subtype.val he)) V hvcard hn).2

/-- The two distinct source centers force the intersection elementary abelian. -/
theorem returningIntersection_elementary (h : IsTypeJ4 z) {r : G}
    (hr : IsConj z r) (hne : r ≠ z) :
    IsElementaryAbelian 2 (returningIntersection z r) := by
  have ht := type_of_isConj h hr
  let := ambient_extraspecial h
  let := ambient_extraspecial ht
  apply ExtraspecialIntersection.elementary_inf
  apply ExtraspecialIntersection.disjoint_centers_of_ne
  rw [LocalGeometry.ambientCore_center_image h,LocalGeometry.ambientCore_center_image ht]
  intro he
  exact involution_not_mem_line h ht.involution hne (he ▸ mem_zpowers r)

/-- The extraspecial bound gives the source upper bound m ≤ 7. -/
theorem returningIntersection_card_upper (h : IsTypeJ4 z) {r : G}
    (hr : IsConj z r) (hne : r ≠ z) :
    Nat.card (returningIntersection z r) ≤ 128 := by
  have ht := type_of_isConj h hr
  let := ambient_extraspecial h
  let := ambient_extraspecial ht
  have hd : Disjoint ((center (ambientCore z)).map (ambientCore z).subtype)
      ((center (ambientCore r)).map (ambientCore r).subtype) := by
    apply ExtraspecialIntersection.disjoint_centers_of_ne
    rw [LocalGeometry.ambientCore_center_image h,LocalGeometry.ambientCore_center_image ht]
    intro he
    exact involution_not_mem_line h ht.involution hne (he ▸ mem_zpowers r)
  have hh := ExtraspecialIntersection.card_inf_sq_le (ambientCore z) (ambientCore r) hd
  rw [ambient_card h] at hh
  change Nat.card (returningIntersection z r)^2 ≤ 2*8192 at hh
  nlinarith

/-- The original image (Q_r ∩ H)Q/Q, without replacing either quotient map. -/
abbrev returningImage (z r : G) : Subgroup (centralizer z ⧸ core z) :=
  ((ambientCore r).subgroupOf (centralizer z)).map (QuotientGroup.mk' (core z))

private theorem returningProjection_range (z r : G) :
    (returningProjection r z).range = returningImage z r := by
  ext x
  constructor
  · rintro ⟨a,rfl⟩
    exact ⟨⟨a.val,a.property.2⟩,a.property.1,rfl⟩
  · rintro ⟨a,ha,rfl⟩
    exact ⟨⟨a.val,ha,a.property⟩,rfl⟩

/-- The two orders multiply to 2¹², with the actual intersection as kernel. -/
theorem returningImage_card_formula (h : IsTypeJ4 z) {r : G}
    (hr : IsConj z r) (hrQ : r ∈ ambientCore z) (hne : r ≠ z) :
    Nat.card (returningIntersection z r) * Nat.card (returningImage z r) = 4096 := by
  have ht := type_of_isConj h hr
  have hc := (returningProjection r z).ker.card_mul_index
  rw [index_ker,returningProjection_kernel_card,returningProjection_range,
    returningCentralizer_card ht h (returning_core_reciprocity h hr hrQ) hne.symm] at hc
  simpa only [returningIntersection,inf_comm] using hc

/-- Source (4.3)'s lower bound on the normal quotient subgroup, prior to
identifying which of the two stabilizers can contain it. -/
theorem returningImage_card_lower (h : IsTypeJ4 z) {r : G}
    (hr : IsConj z r) (hrQ : r ∈ ambientCore z) (hne : r ≠ z) :
    32 ≤ Nat.card (returningImage z r) := by
  have hf := returningImage_card_formula h hr hrQ hne
  have hb := returningIntersection_card_upper h hr hne
  nlinarith

/-- The retained image is elementary abelian: squares in Q_r lie in ⟨r⟩,
which is killed by the original quotient H → H/Q. -/
theorem returningImage_elementary (h : IsTypeJ4 z) {r : G}
    (hr : IsConj z r) (hrQ : r ∈ ambientCore z) :
    IsElementaryAbelian 2 (returningImage z r) := by
  have ht := type_of_isConj h hr
  let := ambient_extraspecial ht
  have hs (x : returningImage z r) : x ^ 2 = 1 := by
    obtain ⟨a,ha,hea⟩ := x.property
    have hsq : a.val ^ 2 ∈ ambientCore z := by
      let aR : ambientCore r := ⟨a.val,ha⟩
      have hm := mem_map_of_mem (ambientCore r).subtype
        ((IsExtraspecial.quotient_elementary_abelian 2 (ambientCore r)).sq_mem_center_of_central_quotient aR)
      rw [LocalGeometry.ambientCore_center_image ht] at hm
      exact (zpowers_le.mpr hrQ) hm
    have hsq' : a ^ 2 ∈ core z := by
      obtain ⟨q,hq,he⟩ := hsq
      exact (Subtype.ext he : q = a^2) ▸ hq
    apply Subtype.ext
    change x.val ^ 2 = 1
    rw [← hea,← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr hsq'
  have hi (x : returningImage z r) : x⁻¹ = x :=
    inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using hs x)
  exact { toIsMulCommutative := ⟨⟨fun x y => by
            have he := hi (x*y)
            rw [mul_inv_rev,hi x,hi y] at he
            exact he.symm⟩⟩
          exponent_dvd_p := Monoid.exponent_dvd_of_forall_pow_eq_one hs }

/-- Containment in the literal image of the element centralizer. -/
theorem returningImage_le (r : core z) :
    returningImage z ((r : centralizer z) : G) ≤
      (Subgroup.centralizer ({(r : centralizer z)} : Set (centralizer z))).map
        (QuotientGroup.mk' (core z)) := by
  apply map_mono
  intro a ha
  apply mem_centralizer_singleton_iff.mpr
  exact Subtype.ext (mem_centralizer_singleton_iff.mp
    (LocalGeometry.ambientCore_le ((r : centralizer z) : G) ha))

/-- Normality is relative to C_H(r)Q/Q, not to H/Q. -/
theorem returningImage_normal (h : IsTypeJ4 z) (r : core z)
    (hr : IsConj z ((r : centralizer z) : G)) :
    ((returningImage z ((r : centralizer z) : G)).subgroupOf
      ((Subgroup.centralizer ({(r : centralizer z)} : Set (centralizer z))).map
        (QuotientGroup.mk' (core z)))).Normal := by
  let R := (ambientCore ((r : centralizer z) : G)).subgroupOf (centralizer z)
  let C := Subgroup.centralizer ({(r : centralizer z)} : Set (centralizer z))
  let q := QuotientGroup.mk' (core z)
  have hn : C ≤ normalizer (R : Set (centralizer z)) := by
    intro a ha
    apply le_normalizer_comap (centralizer z).subtype
    rw [LocalGeometry.normalizer_ambientCore (type_of_isConj h hr)]
    exact mem_centralizer_singleton_iff.mpr (congrArg Subtype.val
      (mem_centralizer_singleton_iff.mp ha))
  apply (normal_subgroupOf_iff_le_normalizer (returningImage_le r)).mpr
  exact (map_mono (f := q) hn).trans (R.le_normalizer_map q)

/-- The source normal two-core lower bound is now attached to the literal
quotient stabilizer, with no mutual-containment or normality assumption. -/
theorem returning_stabilizer_twoCore_card (h : IsTypeJ4 z) (r : core z)
    (hr : IsConj z ((r : centralizer z) : G))
    (hne : ((r : centralizer z) : G) ≠ z) :
    32 ≤ Nat.card (pCore 2
      ((Subgroup.centralizer ({(r : centralizer z)} : Set (centralizer z))).map
        (QuotientGroup.mk' (core z)))) := by
  let I := returningImage z ((r : centralizer z) : G)
  let C := (Subgroup.centralizer ({(r : centralizer z)} : Set (centralizer z))).map
    (QuotientGroup.mk' (core z))
  have hrQ : ((r : centralizer z) : G) ∈ ambientCore z :=
    mem_map_of_mem (centralizer z).subtype r.property
  let := returningImage_normal h r hr
  let := returningImage_elementary h hr hrQ
  have hp : IsPGroup 2 (I.subgroupOf C) :=
    (IsElementaryAbelian.isPGroup 2 I).comap_subtype
  have hle : I.subgroupOf C ≤ pCore 2 C := le_sSup ⟨inferInstance,hp⟩
  have hb := card_le_of_le hle
  rw [Nat.card_congr (subgroupOfEquivOfLe (returningImage_le r)).toEquiv] at hb
  exact (returningImage_card_lower h hr hrQ hne).trans hb

/-- The full cubic quotient has two-rank at most five; its cubic kernel is
retained and explicitly checked to have order prime to two. -/
theorem coreQuotient_twoRank_le (h : IsTypeJ4 z) :
    primeRank 2 (centralizer z ⧸ core z) ≤ 5 := by
  obtain ⟨e⟩ := h.cubic_quotient
  apply (primeRank_le_of_coprime_ker 2 e.projection ?_).trans
    Sporadic.Mathieu.m22_automorphism_twoRank_le_five
  rw [e.kernel_card]
  decide

/-- Source (4.3): the reciprocal cores intersect in an elementary subgroup
of order 2⁷ and its crossing image has order 2⁵. -/
theorem returning_intersection_image_orders (h : IsTypeJ4 z) {r : G}
    (hr : IsConj z r) (hrQ : r ∈ ambientCore z) (hne : r ≠ z) :
    Nat.card (returningIntersection z r) = 128 ∧ Nat.card (returningImage z r) = 32 := by
  have he := returningImage_elementary h hr hrQ
  have hib : Nat.card (returningImage z r) ≤ 32 :=
    (primeRank_le_iff_elementary_card_le (centralizer z ⧸ core z)).mp
      (coreQuotient_twoRank_le h) _ he
  have hi : Nat.card (returningImage z r) = 32 :=
    Nat.le_antisymm hib (returningImage_card_lower h hr hrQ hne)
  have hf := returningImage_card_formula h hr hrQ hne
  rw [hi] at hf
  exact ⟨by omega,hi⟩

/-- The original returning conjugate constructs all intersection and normal
image data needed for the source stabilizer exclusion. This does not yet
identify its H-class or the three-space in the rest of (4.3). -/
theorem source_returning_intersection : IsTypeJ4 z →
    ∃ r : core z,
      IsConj z ((r : centralizer z) : G) ∧ ((r : centralizer z) : G) ≠ z ∧
      z ∈ ambientCore ((r : centralizer z) : G) ∧
      IsElementaryAbelian 2 (returningIntersection z ((r : centralizer z) : G)) ∧
      Nat.card (returningIntersection z ((r : centralizer z) : G)) = 128 ∧
      IsElementaryAbelian 2 (returningImage z ((r : centralizer z) : G)) ∧
      Nat.card (returningImage z ((r : centralizer z) : G)) = 32 ∧
      ((returningImage z ((r : centralizer z) : G)).subgroupOf
        ((Subgroup.centralizer ({(r : centralizer z)} : Set (centralizer z))).map
          (QuotientGroup.mk' (core z)))).Normal ∧
      32 ≤ Nat.card (pCore 2
        ((Subgroup.centralizer ({(r : centralizer z)} : Set (centralizer z))).map
          (QuotientGroup.mk' (core z)))) := by
  intro h
  obtain ⟨g,r,he,hne⟩ := h.exists_returning_conjugate
  have hr : IsConj z ((r : centralizer z) : G) := isConj_iff.mpr ⟨g,he.symm⟩
  have hrQ : ((r : centralizer z) : G) ∈ ambientCore z :=
    mem_map_of_mem (centralizer z).subtype r.property
  obtain ⟨hB,hI⟩ := returning_intersection_image_orders h hr hrQ hne
  exact ⟨r,hr,hne,returning_core_reciprocity h hr hrQ,
    returningIntersection_elementary h hr hne,hB,
    returningImage_elementary h hr hrQ,hI,returningImage_normal h r hr,
    returning_stabilizer_twoCore_card h r hr hne⟩

end Theory.GroupTheory.Recognition.JankoFour.SourceRecognition
end
