module
public import Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.HexadCore
public import Theory.GroupTheory.CoprimeCentralizerDecomposition
public import Theory.GroupTheory.CommutatorPreimage

/-!
# The original hexad fixed-space preimage

The full two-core of G₁,₃ is Q joined with its cubic-central rank-five
factor P. Define E₁ as the preimage of C_(Q/Z(H))(O₂(G₁,₃)). Cubic
fixed-point freedom removes the central ambiguity: this is exactly
Q intersect C_H(P). Its definition through the whole two-core proves
normalization by G₁,₃.

This constructs the literal source subgroup; its elementary structure and
order 128 require the native fixed-space calculation. No identification
with a point-indexed elementary preimage is asserted.

Source: Aschbacher–Segev, The uniqueness of groups of type J4,
Invent. Math. 105 (1991), (4.6), p.598, DOI 10.1007/BF01232280.
-/

@[expose] public section
noncomputable section
open Subgroup
open scoped IsMulCommutative Pointwise
namespace Theory.GroupTheory.Recognition.JankoFour.SourceRecognition
open Sporadic.Mathieu LocalGeometry LocalGeometry.LocalSubgroups
variable {G : Type*} [Group G] [Finite G] {z : G}
variable (h : IsTypeJ4 z) (e : CubicAutomorphismQuotient (centralizer z ⧸ core z))
  (X : Sylow 3 (CubicLift.subgroup e))

include h in
/-- Cubic fixed-point freedom removes the central ambiguity when an actor
centralizing X fixes a stable subgroup of Q modulo Z(H). -/
theorem cubic_fixed_core_lift_centralizes
    (P U : Subgroup (centralizer z)) (hPC : P ≤ fullCubicCentralizer e X)
    (hUQ : U ≤ core z)
    (hXU : cubicSylowImage e X ≤ normalizer (U : Set (centralizer z)))
    (hUP : ⁅U,P⁆ ≤ center (centralizer z)) :
    U ≤ Subgroup.centralizer (P : Set (centralizer z)) := by
  let A := cubicSylowImage e X
  have hAP : ⁅A,P⁆ = ⊥ := by
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr hPC
  have hPUP : ⁅⁅P,U⁆,A⁆ = ⊥ := by
    rw [commutator_comm P U]
    exact commutator_eq_bot_iff_le_centralizer.mpr
      (hUP.trans (center_le_centralizer _))
  have hcomm : ⁅⁅U,A⁆,P⁆ = ⊥ :=
    commutator_commutator_eq_bot_of_rotate (by rw [hAP,commutator_bot_left]) hPUP
  have hfix : U ⊓ Subgroup.centralizer (A : Set (centralizer z)) ≤
      center (centralizer z) := by
    intro u hu
    have hh : (⟨u,hUQ hu.1⟩ : core z) ∈
        (Subgroup.centralizer (A : Set (centralizer z))).subgroupOf (core z) := hu.2
    rw [core_cubic_centralizer h e X] at hh
    rw [← core_center_eq_centralizer_center h]
    exact mem_map_of_mem _ hh
  have hU2 : IsPGroup 2 U := (IsPGroup.of_card h.core_card).to_le hUQ
  let : Group.IsNilpotent U := hU2.isNilpotent
  have hA3 : IsPGroup 3 A :=
    X.isPGroup'.map (CubicLift.subgroup e).subtype
  have hcop := IsPGroup.coprime_card_of_ne 3 2 (by decide) A U hA3 hU2
  rw [eq_commutator_sup_centralizer_of_solvable_coprime U A hXU inferInstance hcop]
  exact sup_le (commutator_eq_bot_iff_le_centralizer.mp hcomm)
    (hfix.trans (center_le_centralizer _))

/-- The original quotient-fixed subgroup needed for E1. -/
def originalHexadFixedCore (B : Finset (Fin 22)) : Subgroup (centralizer z) :=
  commutatorPreimage (core z) (originalHexadCore h e X B) (center (centralizer z))

/-- Fixing the rank-five actor modulo the central marker is literal
centralization, with the same subgroup of the original Q. -/
theorem originalHexadFixedCore_eq (B : Finset (Fin 22)) :
    originalHexadFixedCore h e X B = core z ⊓
      Subgroup.centralizer (originalHexadCore h e X B : Set (centralizer z)) := by
  let P := originalHexadCore h e X B
  have hPC : P ≤ fullCubicCentralizer e X :=
    (originalHexadCore_eq_source h e X B).le.trans inf_le_right
  apply le_antisymm
  · refine le_inf (commutatorPreimage_le _ _ _) ?_
    apply cubic_fixed_core_lift_centralizes h e X P _ hPC
      (commutatorPreimage_le _ _ _)
    · apply commutatorPreimage_normalized _ _ _ _ le_normalizer_of_normal
        le_normalizer_of_normal _ le_normalizer_of_normal
      exact (le_centralizer_iff.mp hPC).trans (Subgroup.centralizer_le_normalizer _)
    · exact commutator_commutatorPreimage_le _ _ _ le_normalizer_of_normal
  · apply le_commutatorPreimage inf_le_left
    rw [commutator_eq_bot_iff_le_centralizer.mpr
      (show core z ⊓ Subgroup.centralizer (P : Set (centralizer z)) ≤
        Subgroup.centralizer (P : Set (centralizer z)) from inf_le_right)]
    exact bot_le

theorem originalPlaneHexad_cubic_le (B : Finset (Fin 22)) :
    CubicLift.subgroup e ≤ originalPlaneHexad e B := by
  intro x hx
  change CubicLift.projection e x ∈ designStabilizer B
  rw [show CubicLift.projection e x = 1 from hx]
  exact one_mem _

/-- The full source hexad two-core is generated by Q and the literal
cubic-central rank-five factor. -/
theorem originalPlaneHexad_twoCore (B : Finset (Fin 22)) :
    (originalPlaneHexad e B).pCoreIn 2 = core z ⊔ originalHexadCore h e X B := by
  let H := originalPlaneHexad e B
  let A := cubicSylowImage e X
  let R := H.pCoreIn 2
  have hQH : core z ≤ H := (CubicLift.core_le e).trans (originalPlaneHexad_cubic_le e B)
  have hAH : A ≤ H := (map_subtype_le (X : Subgroup (CubicLift.subgroup e))).trans
    (originalPlaneHexad_cubic_le e B)
  have hQ2 : IsPGroup 2 (core z) := IsPGroup.of_card h.core_card
  have hQR : core z ≤ R := le_pCoreIn_of_normalizes hQ2 hQH le_normalizer_of_normal
  have hAR : A ≤ normalizer (R : Set (centralizer z)) :=
    hAH.trans (H.le_normalizer.trans (normalizer_le_normalizer_characteristic_image H (pCore 2 H)))
  have hNcent : R ⊓ normalizer (A : Set (centralizer z)) ≤
      Subgroup.centralizer (A : Set (centralizer z)) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    apply le_bot_iff.mp
    have hcommR : ⁅R ⊓ normalizer (A : Set (centralizer z)),A⁆ ≤ R :=
      (commutator_mono inf_le_left le_rfl).trans
        (le_normalizer_iff_commutator_le_left.mp hAR)
    have hcommA : ⁅R ⊓ normalizer (A : Set (centralizer z)),A⁆ ≤ A :=
      le_normalizer_iff_commutator_le_right.mp inf_le_right
    have hA3 : IsPGroup 3 A := X.isPGroup'.map (CubicLift.subgroup e).subtype
    exact (le_inf hcommR hcommA).trans
      ((isPGroup_pCoreIn 2 H).disjoint_of_coprime hA3 (by decide)).eq_bot.le
  rw [originalHexadCore_eq_source h e X B]
  apply le_antisymm _ (sup_le hQR inf_le_left)
  intro g hg
  obtain ⟨q,n,he⟩ := exists_core_mul_cubicNormalizer e h X g
  have hnR : n.val ∈ R := by
    have hh := R.mul_mem (R.inv_mem (hQR q.property)) hg
    rw [←he] at hh
    simpa only [inv_mul_cancel_left] using hh
  rw [←he]
  exact (core z ⊔ (H.pCoreIn 2 ⊓ fullCubicCentralizer e X) : Subgroup (centralizer z)).mul_mem
    ((le_sup_left : core z ≤ core z ⊔ (H.pCoreIn 2 ⊓ fullCubicCentralizer e X)) q.property)
    ((le_sup_right : H.pCoreIn 2 ⊓ fullCubicCentralizer e X ≤
      core z ⊔ (H.pCoreIn 2 ⊓ fullCubicCentralizer e X)) ⟨hnR,hNcent ⟨hnR,n.property⟩⟩)

/-- The same subgroup is the full preimage of the source fixed space
C_(Q/Z)(O₂(G₁,₃)). -/
theorem originalHexadFixedCore_source (B : Finset (Fin 22)) :
    originalHexadFixedCore h e X B = commutatorPreimage (core z)
      ((originalPlaneHexad e B).pCoreIn 2) (center (centralizer z)) := by
  let U := originalHexadFixedCore h e X B
  let P := originalHexadCore h e X B
  let q := QuotientGroup.mk' (center (centralizer z))
  have hUQ : U ≤ core z := commutatorPreimage_le _ _ _
  have hUP : ⁅U,P⁆ ≤ center (centralizer z) :=
    commutator_commutatorPreimage_le _ _ _ le_normalizer_of_normal
  have hQQ : ⁅core z,core z⁆ ≤ center (centralizer z) := by
    rw [←core_center_eq_centralizer_center h,←map_subtype_commutator]
    apply map_mono
    let := h.extraspecial
    exact (IsExtraspecial.quotient_elementary_abelian 2 (core z)).commutator_le_center_of_central_quotient
  have hf (A : Subgroup (centralizer z)) (hc : ⁅U,A⁆ ≤ center (centralizer z)) :
      A.map q ≤ Subgroup.centralizer (U.map q : Set _) := by
    apply le_centralizer_iff.mp
    apply commutator_eq_bot_iff_le_centralizer.mp
    rw [←map_commutator]
    apply (Subgroup.map_eq_bot_iff _).mpr
    rwa [QuotientGroup.ker_mk']
  apply le_antisymm
  · apply le_commutatorPreimage hUQ
    have hm : (⁅U,(originalPlaneHexad e B).pCoreIn 2⁆).map q = ⊥ := by
      rw [map_commutator]
      apply commutator_eq_bot_iff_le_centralizer.mpr
      apply le_centralizer_iff.mp
      rw [originalPlaneHexad_twoCore h e X B,Subgroup.map_sup]
      exact sup_le (hf (core z) ((commutator_mono hUQ le_rfl).trans hQQ)) (hf P hUP)
    have hh := (Subgroup.map_eq_bot_iff _).mp hm
    rwa [QuotientGroup.ker_mk'] at hh
  · apply le_commutatorPreimage (commutatorPreimage_le _ _ _)
    have hPR : P ≤ (originalPlaneHexad e B).pCoreIn 2 :=
      (originalHexadCore_eq_source h e X B).le.trans inf_le_left
    exact (commutator_mono le_rfl hPR).trans
      (commutator_commutatorPreimage_le _ _ _ le_normalizer_of_normal)

theorem originalHexadFixedCore_normalized (B : Finset (Fin 22)) :
    originalPlaneHexad e B ≤ normalizer (originalHexadFixedCore h e X B : Set (centralizer z)) := by
  rw [originalHexadFixedCore_source h e X B]
  exact commutatorPreimage_normalized _ _ _ _ le_normalizer_of_normal
    le_normalizer_of_normal
    ((originalPlaneHexad e B).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 (originalPlaneHexad e B))))
    le_normalizer_of_normal

end Theory.GroupTheory.Recognition.JankoFour.SourceRecognition
end
