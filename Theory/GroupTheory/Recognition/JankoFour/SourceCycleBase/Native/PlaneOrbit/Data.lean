def blocks : Fin 28 → Fin 64 → Row :=
  ![block00, block01, block02, block03, block04, block05, block06, block07, block08, block09, block10, block11, block12, block13, block14, block15, block16, block17, block18, block19, block20, block21, block22, block23, block24, block25, block26, block27]

def row (i : Fin 1771) : Row := blocks ⟨i.val / 64, by omega⟩ ⟨i.val % 64, by omega⟩
def masks (a : Fin 6 → BitVec 24) : Finset (BitVec 24) := Finset.univ.image a
def seed : Fin 4 → Fin 1771 := ![0, 1308, 1159, 1317]

def key (i : Fin 1771) : Nat := ((row i).masks 0).toNat
def rowCheck (i : Fin 1771) : Prop :=
  (∀ j, ((row i).masks 0).toNat ≤ ((row i).masks j).toNat) ∧
  (if (row i).depth = 0 then i = seed (row i).root else
    (row (row i).parent).depth < (row i).depth ∧
    (row (row i).parent).root = (row i).root ∧
    (masks (row (row i).parent).masks).image
        (m24PermuteMask (FarOrbit.generatorPerm (row i).generator)) = masks (row i).masks)
def orderedNext (i : Fin 1771) : Prop := ∀ h : i.val+1 < 1771, key i < key ⟨i.val+1,h⟩
instance (i : Fin 1771) : Decidable (rowCheck i) := by unfold rowCheck; infer_instance
instance (i : Fin 1771) : Decidable (orderedNext i) := by unfold orderedNext; infer_instance
def index (k : Fin 28) (j : Fin 64) : Fin 1771 := ⟨min (64*k.val+j.val) 1770, by omega⟩
end Theory.GroupTheory.Recognition.JankoFour.SourceCycleBase.Native.PlaneOrbit
