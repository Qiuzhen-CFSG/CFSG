module
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessMathieu.OctadGraph.Source.FourLifts
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessMathieu.OctadGraph.Source.NativeSecond

/-!
# The original local placement and ambient Mathieu recognition

Let L be the subgroup generated by the three original marked normalizers
and t the marked second-class involution. The source local centralizer
I = C_{N_G(A₂)}(t) lies in C_L(t) and has order 7680. The proved octad
comparison identifies L with the actual Witt-design M₂₄. The order of I
rules out the first involution class there, while the native second-class
bound gives |C_L(t)| ≤ 7680. Equality of these literal subgroups proves
C_L(t) ≤ N_G(A₂).

This discharges the last premise of the existing quotient-lift and fixed-
coset arguments, giving source 41.2's ambient generation and the actual
ambient M₂₄ isomorphism. The original-fusion applications use exactly the
oriented marking and LocalData produced by SourceData.ofFusion, retaining
the 21/45 orientation throughout.

Source: Aschbacher, *Sporadic Groups* (1994), 41.2–41.5, printed pp.221–222,
and Exercise 13.2, p.210.
-/

public noncomputable section
open Subgroup
namespace Theory.GroupTheory.TransvectionFive.UniquenessMathieu.OctadSource
open UniquenessLinear SourceNormalizer PlaneTensor PlaneCensus
open Sporadic.Mathieu Sporadic.Mathieu.M24InvolutionCentralizers

private theorem inf_centralizer_card {G : Type*} [Group G] (L : Subgroup G) (x : L) :
    Nat.card (L ⊓ centralizer ({(x : G)} : Set G) : Subgroup G) =
      Nat.card (centralizer ({x} : Set L)) := by
  let e : (L ⊓ centralizer ({(x : G)} : Set G) : Subgroup G) ≃ centralizer ({x} : Set L) :=
    { toFun := fun a => ⟨⟨a.val,a.property.1⟩,
        mem_centralizer_singleton_iff.mpr (Subtype.ext (mem_centralizer_singleton_iff.mp a.property.2))⟩
      invFun := fun a => ⟨a.val.val,a.val.property,
        mem_centralizer_singleton_iff.mpr (congrArg Subtype.val (mem_centralizer_singleton_iff.mp a.property))⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  exact Nat.card_congr e

private theorem centralizer_equiv_card {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (x : G) : Nat.card (centralizer ({x} : Set G)) =
      Nat.card (centralizer ({e x} : Set H)) := by
  apply Nat.card_congr (Equiv.subtypeEquiv e.toEquiv ?_)
  intro a
  simp only [mem_centralizer_singleton_iff, MulEquiv.toEquiv_eq_coe, MulEquiv.coe_toEquiv]
  constructor
  · intro ha
    simpa only [map_mul] using congrArg e ha
  · intro ha
    apply e.injective
    simpa only [map_mul] using ha

variable {G : Type*} [Group G] [Finite G] {z : G} (F : MarkedCentralizer z)

/-- The centralizer in the recognized span lies in the original plane normalizer. -/
theorem local_second_centralizer_placement (D : LocalData F) :
    normalizerSpan F ⊓ centralizer ({planeSecondPoint F} : Set G) ≤ threeSpaceNormalizer F := by
  let L := normalizerSpan F
  let I := involutionCentralizer F (planeSecondPoint F)
  let K := L ⊓ centralizer ({planeSecondPoint F} : Set G)
  have hIL : I ≤ L := by
    change I ≤ normalizerSpan F
    rw [normalizerSpan_eq]
    exact inf_le_left.trans le_sup_right
  have hIK : I ≤ K := le_inf hIL inf_le_right
  let t : L := ⟨planeSecondPoint F,
    point_centralizer_le_normalizerSpan F (F.pullback_le _ (planeSecondPoint_mem F))⟩
  obtain ⟨e⟩ := normalizerSpan_equiv F D
  have hecard : Nat.card K = Nat.card (centralizer ({e t} : Set M24)) :=
    (inf_centralizer_card L t).trans (centralizer_equiv_card e t)
  have hd : 7680 ∣ Nat.card (centralizer ({e t} : Set M24)) := by
    rw [← hecard,← local_second_centralizer_card F D]
    exact card_dvd_of_le hIK
  have hto : orderOf (e t) = 2 := by
    rw [e.orderOf_eq,← Subgroup.orderOf_coe]
    exact planeSecondPoint_order F
  have hcard : Nat.card K ≤ 7680 := by
    rw [hecard]
    rcases involution_classes (e t) hto with ha | hb
    · have hc := card_centralizer_eq_of_isConj _ _ ha
      rw [← hc,TwoA.centralizer_card] at hd
      norm_num at hd
    · rw [← card_centralizer_eq_of_isConj _ _ hb]
      exact NativeSecond.centralizer_card_bound
  have heq : I = K := eq_of_le_of_card_ge hIK (by rw [local_second_centralizer_card F D]; exact hcard)
  intro a ha
  exact (show a ∈ I from heq.symm ▸ ha).1

/-- Equality with the centralizer in the original full plane normalizer. -/
theorem local_second_centralizer_eq (D : LocalData F) :
    normalizerSpan F ⊓ centralizer ({planeSecondPoint F} : Set G) =
      involutionCentralizer F (planeSecondPoint F) := by
  apply le_antisymm
  · exact le_inf (local_second_centralizer_placement F D) inf_le_right
  · apply le_inf _ inf_le_right
    rw [normalizerSpan_eq]
    exact inf_le_left.trans le_sup_right

/-- The second involution's full ambient centralizer lies in the actual span. -/
theorem second_centralizer_le (D : LocalData F) :
    centralizer ({planeSecondPoint F} : Set G) ≤ normalizerSpan F :=
  second_centralizer_le_of_local_placement F D (local_second_centralizer_placement F D)

/-- Source 41.2: the original two full normalizers generate G. -/
theorem normalizer_generation (D : LocalData F) :
    threeSpaceNormalizer F ⊔ rowNormalizer F = ⊤ :=
  normalizer_generation_of_local_placement F D (local_second_centralizer_placement F D)

/-- The source-local data now gives an actual isomorphism of the ambient group. -/
theorem equiv (D : LocalData F) : Nonempty (G ≃* Sporadic.Mathieu.M24) :=
  equiv_of_local_placement F D (local_second_centralizer_placement F D)

/-- Local placement on the very same oriented marking supplied by the producer. -/
theorem oriented_local_second_centralizer_placement (hfusion : F.MathieuFusion) :
    let E := SourceData.ofFusion F hfusion
    normalizerSpan E.oriented.marking ⊓
      centralizer ({planeSecondPoint E.oriented.marking} : Set G) ≤
        threeSpaceNormalizer E.oriented.marking :=
  let E := SourceData.ofFusion F hfusion
  local_second_centralizer_placement E.oriented.marking E.localData

/-- Original-fusion source 41.2 on the producer's 21/45 orientation. -/
theorem oriented_normalizer_generation (hfusion : F.MathieuFusion) :
    let E := SourceData.ofFusion F hfusion
    threeSpaceNormalizer E.oriented.marking ⊔ rowNormalizer E.oriented.marking = ⊤ :=
  let E := SourceData.ofFusion F hfusion
  normalizer_generation E.oriented.marking E.localData

/-- The original Mathieu fusion pattern recognizes the actual ambient group. -/
theorem oriented_equiv (hfusion : F.MathieuFusion) :
    Nonempty (G ≃* Sporadic.Mathieu.M24) :=
  oriented_equiv_of_local_placement F hfusion
    (oriented_local_second_centralizer_placement F hfusion)

end Theory.GroupTheory.TransvectionFive.UniquenessMathieu.OctadSource
