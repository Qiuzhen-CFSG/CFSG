module
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessMathieu.OctadGraph.Source.LinePlane
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessMathieu.SourceNormalizer.Complete
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourceFusion

/-!
# The normalizer-generated subgroup in the Mathieu source geometry

The line-stabilizer factorization identifies the three-normalizer span with
N_G(A₂) ∨ N_G(U₁). Restrict the full centralizer marking to this actual
subgroup. Fusion control in each rectangle preserves both literal fusion
sets, hence the 21/45 orientation without another interchange. The inherited
normalizer images generate the subgroup, and its local boundary and point
nonweak closure follow from the already proved source construction.

This is the induction setup of Aschbacher, *Sporadic Groups* (1994), 41.1,
printed pp.219–220. It does not assume the span simple and does not assert
that it equals G. That ambient-generation step still requires the source
second-involution centralizer argument in 41.2.
-/

public noncomputable section
open Subgroup
namespace Theory.GroupTheory.TransvectionFive.UniquenessMathieu.OctadSource
open UniquenessLinear SourceNormalizer
variable {G : Type*} [Group G] [Finite G] {z : G} (F : MarkedCentralizer z)

/-- Both oriented fusion sets are preserved inside every overgroup of the
full centralizer and the two rectangle normalizers. -/
theorem overgroup_orientation (h : MathieuFusionOrientation F) (L : Subgroup G)
    (hCL : centralizer ({z} : Set G) ≤ L)
    (hPL : planeNormalizer F ≤ L) (hSL : threeSpaceNormalizer F ≤ L) :
    MathieuFusionOrientation (overgroupMarking F L hCL) := by
  constructor
  · have he := congrArg Set.ncard (overgroup_plane_fusion_image F L hCL hPL)
    rw [Set.ncard_image_of_injective _ L.subtype_injective] at he
    exact he.trans h.1
  · have he := congrArg Set.ncard (overgroup_threeSpace_fusion_image F L hCL hSL)
    rw [Set.ncard_image_of_injective _ L.subtype_injective] at he
    exact he.trans h.2

/-- The 21-point rectangle already supplies nonweak closure in the literal
point two-core. No simplicity assumption is used. -/
theorem orientation_pointCoreFusion (h : MathieuFusionOrientation F) : PointCoreFusion z := by
  have hrow : F.row ≤ (centralizer ({z} : Set G)).pCoreIn 2 :=
    le_pCoreIn_of_normalizes
      (IsPGroup.of_card (p := 2) (n := 4) (by rw [row_card]; decide))
      (F.pullback_le _) (point_centralizer_le_row_normalizer F)
  obtain ⟨g, hg⟩ := row_point_mover F h.1
  exact ⟨g, hrow ((mem_normalizer_iff.mp g.property z).mp (point_mem_row F)), hg⟩

/-- The line normalizer is already in the subgroup generated by the point
and plane normalizers, by its actual flag factorization. -/
theorem planeNormalizer_le_pair (D : LocalData F) :
    planeNormalizer F ≤ threeSpaceNormalizer F ⊔ rowNormalizer F := by
  rw [← line_flag_generate F D]
  exact sup_le (inf_le_left.trans le_sup_right) (inf_le_right.trans le_sup_left)

/-- The three-generator subgroup in source 41.1 is the exact pair appearing
in the source uniqueness system's generation axiom. -/
theorem normalizerSpan_eq_pair (D : LocalData F) :
    normalizerSpan F = threeSpaceNormalizer F ⊔ rowNormalizer F := by
  rw [normalizerSpan_eq]
  apply le_antisymm
  · exact sup_le (sup_le le_sup_right (planeNormalizer_le_pair F D)) le_sup_left
  · exact sup_le le_sup_right (le_sup_left.trans le_sup_left)

/-- Restriction preserves 21/45 in that order, with the same marking. -/
theorem normalizerSpan_orientation (h : MathieuFusionOrientation F) :
    MathieuFusionOrientation (normalizerSpanMarking F) := by
  rw [normalizerSpanMarking_eq]
  exact overgroup_orientation F h _ (point_centralizer_le_normalizerSpan F)
    (by rw [normalizerSpan_eq]; exact le_sup_right.trans le_sup_left)
    (by rw [normalizerSpan_eq]; exact le_sup_right)

/-- The full constructed local boundary inside the actual generated subgroup.
No new interchange of the two rectangles is made. -/
def normalizerSpanLocalData (D : LocalData F) : LocalData (normalizerSpanMarking F) :=
  LocalData.ofFusion _ (normalizerSpan_orientation F D.orientation)

/-- The normalizers in the induction subgroup generate that subgroup. This
uses their exact images under inclusion, not simplicity of the subgroup. -/
theorem normalizerSpan_pair_generate (D : LocalData F) :
    threeSpaceNormalizer (normalizerSpanMarking F) ⊔
      rowNormalizer (normalizerSpanMarking F) = ⊤ := by
  apply Subgroup.map_injective (normalizerSpan F).subtype_injective
  rw [Subgroup.map_sup, (normalizerSpan_normalizers_map F).2.2,
    (normalizerSpan_normalizers_map F).1]
  rw [← MonoidHom.range_eq_map (normalizerSpan F).subtype, Subgroup.range_subtype,
    normalizerSpan_eq_pair F D]

/-- The induction group retains the original nonweak-closure hypothesis,
proved internally from its inherited fusion rather than restricted by fiat. -/
theorem normalizerSpan_pointCoreFusion (D : LocalData F) :
    PointCoreFusion (overgroupPoint (normalizerSpan F) (point_centralizer_le_normalizerSpan F)) :=
  orientation_pointCoreFusion _ (normalizerSpan_orientation F D.orientation)

end Theory.GroupTheory.TransvectionFive.UniquenessMathieu.OctadSource
