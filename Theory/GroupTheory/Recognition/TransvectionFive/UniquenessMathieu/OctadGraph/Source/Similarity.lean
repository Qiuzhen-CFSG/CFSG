module
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessMathieu.OctadGraph.Source.Inner
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessMathieu.OctadGraph.Source.Overlap
import all Theory.GroupTheory.Recognition.TransvectionFive.UniquenessMathieu.OctadGraph.Source.GeneratedSystem

/-!
# The complete source/native octad comparison

Full innerness of the literal point–plane intersection discharges the last
premise of the overlap correction. The resulting vertex and plane maps
agree on every overlap element and preserve both the full edge fixer and
the local setwise edge. The proved edge rigidity and native octad base then
give an actual isomorphism from the normalizer-generated subgroup to M₂₄.

The original-fusion applications use the same orientation and local data
from `SourceData.ofFusion`. No similarity or automorphism premise remains.
For recognition of the original ambient group, generation remains explicit;
the equality of the normalizer span with G is the separate 41.2 obligation.

Source: Aschbacher, *Sporadic Groups* (1994), 41.3–41.5, printed p.222,
and Exercise 13.2, p.210.
The internal import unfolds only the existing oriented-system wrapper while
preserving its public boundary.
-/

public noncomputable section
open Subgroup
namespace Theory.GroupTheory.TransvectionFive.UniquenessMathieu.OctadSource
open UniquenessLinear SourceNormalizer GraphUniquenessSystem
open Sporadic.Mathieu Sporadic.Mathieu.M24LocalGeometry
variable {G : Type*} [Group G] [Finite G] {z : G}
  (F : MarkedCentralizer z) (D : LocalData F)

/-- The actual source/native similarity with full overlap agreement. -/
theorem native_similarity
    (hgen : threeSpaceNormalizer F ⊔ rowNormalizer F = ⊤) :
    Nonempty (Similarity (system_of_generation F D hgen) OctadGraph.system) :=
  native_similarity_of_inner_point_plane F D hgen (point_plane_inner F D)

include D in
/-- Recognition of the original ambient group once source 41.2 supplies generation. -/
theorem equiv_of_generation
    (hgen : threeSpaceNormalizer F ⊔ rowNormalizer F = ⊤) :
    Nonempty (G ≃* M24) := by
  obtain ⟨s⟩ := native_similarity F D hgen
  obtain ⟨e,_,_⟩ := OctadGraph.existsUnique_mulEquiv_of_rigid s
    (edge_plane_automorphismRigid F D)
  exact ⟨e⟩

/-- The complete comparison in the actual induction subgroup needs no extra premise. -/
theorem normalizerSpan_similarity :
    Nonempty (Similarity (normalizerSpan_system F D) OctadGraph.system) :=
  native_similarity (normalizerSpanMarking F) (normalizerSpanLocalData F D)
    (normalizerSpan_pair_generate F D)

include D in
/-- The subgroup generated by the three literal normalizers is M₂₄. -/
theorem normalizerSpan_equiv : Nonempty (normalizerSpan F ≃* M24) := by
  obtain ⟨s⟩ := normalizerSpan_similarity F D
  obtain ⟨e,_,_⟩ := normalizerSpan_existsUnique_mulEquiv_of_similarity F D s
  exact ⟨e⟩

omit D in
/-- Original-fusion comparison with exactly the producer's oriented marking. -/
theorem oriented_normalizerSpan_similarity (hfusion : F.MathieuFusion) :
    Nonempty (Similarity (oriented_normalizerSpan_system F hfusion) OctadGraph.system) :=
  let E := SourceData.ofFusion F hfusion
  normalizerSpan_similarity E.oriented.marking E.localData

omit D in
/-- The original fusion data alone identifies its oriented normalizer span. -/
theorem oriented_normalizerSpan_equiv (hfusion : F.MathieuFusion) :
    let E := SourceData.ofFusion F hfusion
    Nonempty (normalizerSpan E.oriented.marking ≃* M24) :=
  oriented_normalizerSpan_recognition F hfusion
    (oriented_normalizerSpan_similarity F hfusion).some

omit D in
/-- The source uniqueness branch now has only its ambient-generation obligation. -/
theorem oriented_equiv_of_generation (hfusion : F.MathieuFusion)
    (hgen : let E := SourceData.ofFusion F hfusion
      threeSpaceNormalizer E.oriented.marking ⊔ rowNormalizer E.oriented.marking = ⊤) :
    Nonempty (G ≃* M24) :=
  let E := SourceData.ofFusion F hfusion
  equiv_of_generation E.oriented.marking E.localData hgen

end Theory.GroupTheory.TransvectionFive.UniquenessMathieu.OctadSource
