theorem neighbor_coverage0 : ∀ b : Fin 759,
    Disjoint (m24BlockAt (representativeIndex 0)) (m24BlockAt b) →
      neighbor 0 (neighborIndex 0 b) = b := by
  decide +kernel

theorem neighbor_coverage1 : ∀ b : Fin 759,
    Disjoint (m24BlockAt (representativeIndex 1)) (m24BlockAt b) →
      neighbor 1 (neighborIndex 1 b) = b := by
  decide +kernel

theorem neighbor_coverage2 : ∀ b : Fin 759,
    Disjoint (m24BlockAt (representativeIndex 2)) (m24BlockAt b) →
      neighbor 2 (neighborIndex 2 b) = b := by
  decide +kernel

theorem neighbor_coverage3 : ∀ b : Fin 759,
    Disjoint (m24BlockAt (representativeIndex 3)) (m24BlockAt b) →
      neighbor 3 (neighborIndex 3 b) = b := by
  decide +kernel

theorem neighbor_coverage (i : Fin 4) (b : Fin 759) :
    Disjoint (m24BlockAt (representativeIndex i)) (m24BlockAt b) →
      neighbor i (neighborIndex i b) = b := by
  fin_cases i
  · exact neighbor_coverage0 b
  · exact neighbor_coverage1 b
  · exact neighbor_coverage2 b
  · exact neighbor_coverage3 b

theorem horizontal_valid : ∀ i : Fin 4, ∀ j : Fin 30,
    rankSet (m24BlockAt (representativeIndex i)) = rankSet (m24BlockAt (neighbor i j)) →
    Disjoint (m24BlockAt (representativeIndex i)) (m24BlockAt (horizontal i j)) ∧
    Disjoint (m24BlockAt (horizontal i j)) (m24BlockAt (neighbor i j)) ∧
    rankSet (m24BlockAt (horizontal i j)) < rankSet (m24BlockAt (representativeIndex i)) := by
  decide +kernel

theorem down_coverage : ∀ i : Fin 4, ∀ j : Fin 30,
    rankSet (m24BlockAt (neighbor i j)) < rankSet (m24BlockAt (representativeIndex i)) →
    downNeighbor i (downIndex i j) = neighbor i j := by
  decide +kernel

theorem down_valid : ∀ i : Fin 4, 0 < rankSet (m24BlockAt (representativeIndex i)) →
    ∀ j : Fin 15,
      Disjoint (m24BlockAt (representativeIndex i)) (m24BlockAt (downNeighbor i j)) ∧
      rankSet (m24BlockAt (downNeighbor i j)) < rankSet (m24BlockAt (representativeIndex i)) := by
  decide +kernel

theorem down_tree : ∀ i : Fin 4, 0 < rankSet (m24BlockAt (representativeIndex i)) →
    ∀ j : Fin 15, downNeighbor i j = downNeighbor i 0 ∨
      downParent i j < j ∧
      Disjoint (m24BlockAt (downNeighbor i (downParent i j))) (m24BlockAt (downCommon i j)) ∧
      Disjoint (m24BlockAt (downCommon i j)) (m24BlockAt (downNeighbor i j)) ∧
      rankSet (m24BlockAt (downCommon i j)) < rankSet (m24BlockAt (representativeIndex i)) := by
  decide +kernel

end DescentCertificate
