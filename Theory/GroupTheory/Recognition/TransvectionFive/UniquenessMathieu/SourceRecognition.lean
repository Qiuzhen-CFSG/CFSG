module

public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessMathieu.OctadGraph.Source.LocalPlacement

/-!
# Recognition of the Mathieu transvection-centralizer branch

The unequal 21/45 fusion counts orient the original marked centralizer and
construct the full ambient-normalizer quotients and marked intersections.
On that same marking, the native 759-octad comparison identifies the subgroup
generated by the row and three-space normalizers with M₂₄. The second
involution's centralizer and fixed-coset arguments prove that this subgroup
is the whole ambient group.

This assembles the Mathieu case of Aschbacher, *Sporadic Groups* (1994),
40.3–40.5 and 41.1–41.6, pp.217–222, using the native octad base of
Exercise 13.2, p.210. The public source statement retains finite simplicity
and point-core fusion; the proved construction already follows from the
marked full centralizer and the two fusion counts. All normalizer, local
placement, generation and graph-comparison inputs are discharged.
-/

public section
namespace Theory.GroupTheory.TransvectionFive
variable {G : Type*} [Group G] [Finite G] {z : G}

/-- The original Mathieu fusion pattern recognizes the actual M₂₄. The
corrected normalizer data and native octad uniqueness theorem use the same
orientation of the original marking, with no additional source premise. -/
theorem mathieu_of_mathieuFusion_source (F : MarkedCentralizer z)
    (_hG : IsSimpleGroup G) (_hcore : PointCoreFusion z)
    (hfusion : F.MathieuFusion) : Nonempty (G ≃* Sporadic.Mathieu.M24) := by
  let D := UniquenessMathieu.SourceNormalizer.SourceData.ofFusion F hfusion
  exact UniquenessMathieu.OctadSource.equiv D.oriented.marking D.localData

end Theory.GroupTheory.TransvectionFive
