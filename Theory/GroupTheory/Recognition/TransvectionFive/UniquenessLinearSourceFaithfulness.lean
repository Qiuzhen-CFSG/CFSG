module

public import Theory.GroupTheory.Recognition.TransvectionFive.LocalData
public import Theory.GroupTheory.GraphUniquenessSystem.CosetConstruction
public import Mathlib.GroupTheory.Subgroup.Simple

/-!
# Faithfulness of the marked source coset actions

Each of the four marked root groups contains the distinguished involution
and lies in its full centralizer. Nonweak closure makes that centralizer
proper. In a simple ambient group these root groups therefore have proper
normalizers, and the normalizers have trivial normal core. In particular the
literal point action used in the linear source geometry is faithful.

This supplies the faithfulness premise of the coset-system constructor, not
the generation or local comparison assertions of Aschbacher, *Sporadic
Groups* (1994), §§40–41, pp.217–222. Simplicity is used only in the ambient
group, never in a subgroup generated by the local normalizers.
-/

public section
namespace Theory.GroupTheory.TransvectionFive.UniquenessLinear
open Subgroup BinaryLinear.TransvectionFiveLocal GraphUniquenessSystem

universe u
variable {G : Type u} [Group G] {z : G}

/-- Nonweak closure rules out a central distinguished involution. -/
theorem point_centralizer_ne_top (hcore : PointCoreFusion z) :
    centralizer ({z} : Set G) ≠ ⊤ := by
  intro he
  obtain ⟨g, _, hg⟩ := hcore
  have hc : g ∈ centralizer ({z} : Set G) := he ▸ mem_top g
  apply hg
  rw [mem_centralizer_singleton_iff.mp hc, mul_inv_cancel_right]

variable (F : MarkedCentralizer z)

/-- The marked point belongs to every pullback whose model contains the root. -/
theorem point_mem_pullback (A : Subgroup SL) (hz : transvection ∈ A) :
    z ∈ F.pullback A := by
  apply (F.mem_pullback_iff A ⟨z, mem_centralizer_singleton_iff.mpr rfl⟩).mpr
  rwa [F.on_point]

theorem point_mem_row : z ∈ F.row :=
  point_mem_pullback F _ (subset_closure ⟨4, by decide, rfl⟩)

theorem point_mem_column : z ∈ F.column :=
  point_mem_pullback F _ (subset_closure ⟨0, by decide, rfl⟩)

theorem point_mem_plane : z ∈ F.plane :=
  point_mem_pullback F _ (subset_closure ⟨0, 4, by decide, by decide, by decide, rfl⟩)

theorem point_mem_threeSpace : z ∈ F.threeSpace :=
  point_mem_pullback F _ (subset_closure ⟨0, 4, by decide, by decide, by decide, rfl⟩)

private theorem marked_normalizer_ne_top (hG : IsSimpleGroup G)
    (hcore : PointCoreFusion z) (A : Subgroup SL) (hz : z ∈ F.pullback A) :
    normalizer (F.pullback A : Set G) ≠ ⊤ := by
  let := hG
  have hz1 : z ≠ 1 := by
    intro he
    have ho := F.point_orderOf
    simp [he] at ho
  intro he
  have hn := normalizer_eq_top_iff.mp he
  rcases hn.eq_bot_or_eq_top with h | h
  · exact hz1 (by simpa only [h, mem_bot] using hz)
  · exact point_centralizer_ne_top hcore (top_unique (h ▸ F.pullback_le A))

/-- All three stabilizers of the source flag, and the opposite endpoint
normalizer, are proper in the original simple group. -/
theorem flag_normalizers_ne_top (hG : IsSimpleGroup G) (hcore : PointCoreFusion z) :
    normalizer (F.row : Set G) ≠ ⊤ ∧
    normalizer (F.column : Set G) ≠ ⊤ ∧
    normalizer (F.plane : Set G) ≠ ⊤ ∧
    normalizer (F.threeSpace : Set G) ≠ ⊤ :=
  ⟨marked_normalizer_ne_top F hG hcore _ (point_mem_row F),
    marked_normalizer_ne_top F hG hcore _ (point_mem_column F),
    marked_normalizer_ne_top F hG hcore _ (point_mem_plane F),
    marked_normalizer_ne_top F hG hcore _ (point_mem_threeSpace F)⟩

private theorem core_eq_bot (hG : IsSimpleGroup G) (M : Subgroup G) (hM : M ≠ ⊤) :
    M.normalCore = ⊥ := by
  let := hG
  rcases (inferInstance : M.normalCore.Normal).eq_bot_or_eq_top with h | h
  · exact h
  · exact False.elim (hM (top_unique (h ▸ M.normalCore_le)))

/-- The source point stabilizer has trivial normal core. This is the literal
`hfaithful` premise in `Cosets.system`. -/
theorem row_normalizer_core (hG : IsSimpleGroup G) (hcore : PointCoreFusion z) :
    (normalizer (F.row : Set G)).normalCore = ⊥ :=
  core_eq_bot hG _ (flag_normalizers_ne_top F hG hcore).1

/-- The actual action on the source points is faithful. -/
theorem source_point_action_faithful (hG : IsSimpleGroup G) (hcore : PointCoreFusion z)
    (g : G) (hg : ∀ a : Cosets.Vertex (normalizer (F.row : Set G)), g • a = a) :
    g = 1 :=
  Cosets.faithful _ (row_normalizer_core F hG hcore) g hg

end Theory.GroupTheory.TransvectionFive.UniquenessLinear
