module
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourcePlaneCensus
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.GroupTheory.Perm.Basic

/-!
# The point stabilizer of the binary rectangle rank-one locus

An additive permutation preserving the 21 nonzero rank-one matrices and
fixing the marked code 4 preserves the unique eight-element singular subgroup
through that point. Its action there is normalized by one of 24 short words
in the marked column shears. The remaining choice is one row shear; purity
of five translates then determines the other two basis images.

Thus the full point stabilizer is generated by the five actual centralizer
shears. The finite certificates inspect six-bit vectors and pairs of them,
not the full automorphism group. This is the stabilizer input to the literal
quotient identification in Aschbacher, *Sporadic Groups* (1994), 40.3,
printed pp.217–218.
-/

public section
namespace Theory.GroupTheory.TransvectionFive.UniquenessLinear.PlaneCensus

/-- Additive permutations preserving the nonzero rank-one matrices. -/
def rankOneGroup : Subgroup (Equiv.Perm Code) where
  carrier := {f | (∀ x y, f (x ^^^ y) = f x ^^^ f y) ∧ (∀ x, pure (f x) = pure x)}
  one_mem' := ⟨fun _ _ => rfl, fun _ => rfl⟩
  mul_mem' := by
    rintro f g ⟨hf, hp⟩ ⟨hg, hq⟩
    exact ⟨fun x y => by change f (g (x ^^^ y)) = f (g x) ^^^ f (g y); rw [hg, hf],
      fun x => (hp (g x)).trans (hq x)⟩
  inv_mem' := by
    rintro f ⟨hf, hp⟩
    constructor
    · intro x y
      change f.symm (x ^^^ y) = f.symm x ^^^ f.symm y
      apply f.injective
      rw [f.apply_symm_apply, hf, f.apply_symm_apply, f.apply_symm_apply]
    · intro x
      exact (hp (f.symm x)).symm.trans (congrArg pure (f.apply_symm_apply x))

theorem mem_rankOneGroup (f : Equiv.Perm Code) : f ∈ rankOneGroup ↔
    (∀ x y, f (x ^^^ y) = f x ^^^ f y) ∧ (∀ x, pure (f x) = pure x) := by rfl

private theorem shear_square : ∀ (k : Fin 5) (x : Code), shear k (shear k x) = x := by decide
private theorem shear_xor : ∀ (k : Fin 5) (x y : Code),
    shear k (x ^^^ y) = shear k x ^^^ shear k y := by decide
private theorem shear_pure : ∀ (k : Fin 5) (x : Code), pure (shear k x) = pure x := by decide
private theorem shear_point : ∀ k : Fin 5, shear k 4 = 4 := by decide

def shearPerm (k : Fin 5) : Equiv.Perm Code where
  toFun := shear k
  invFun := shear k
  left_inv := shear_square k
  right_inv := shear_square k

theorem shearPerm_apply (k : Fin 5) (x : Code) : shearPerm k x = shear k x := by rfl

theorem shearPerm_mem (k : Fin 5) : shearPerm k ∈ rankOneGroup :=
  ⟨shear_xor k, shear_pure k⟩

private def rowCodes : Finset Code := Finset.univ.filter (fun x => x >>> 3 = 0)
private theorem row_card : rowCodes.card = 8 := by decide
private theorem row_xor : ∀ x y : Code, x ∈ rowCodes → y ∈ rowCodes → x ^^^ y ∈ rowCodes := by decide
private theorem row_pure : ∀ x : Code, x ∈ rowCodes → x = 0 ∨ pure x = true := by decide
private def common (b : Code) : Finset Code := Finset.univ.filter (fun x =>
  (x = 0 ∨ pure x = true) ∧ (4 ^^^ x = 0 ∨ pure (4 ^^^ x) = true) ∧
    (b ^^^ x = 0 ∨ pure (b ^^^ x) = true))
private theorem common_bound : ∀ b : Code, b ∉ rowCodes →
    (b = 0 ∨ pure b = true) → (4 ^^^ b = 0 ∨ pure (4 ^^^ b) = true) →
      (common b).card ≤ 4 := by decide

private theorem eight_pure_eq_row (s : Finset Code) (hc : s.card = 8)
    (h4 : (4 : Code) ∈ s) (hp : ∀ a ∈ s, a = 0 ∨ pure a = true)
    (hadd : ∀ a ∈ s, ∀ b ∈ s, a ^^^ b ∈ s) : s = rowCodes := by
  have hle : s ⊆ rowCodes := by
    intro b hb
    by_contra hn
    have hsub : s ⊆ common b := by
      intro x hx
      simp only [common, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨hp x hx, hp _ (hadd 4 h4 x hx), hp _ (hadd b hb x hx)⟩
    have hcard := (Finset.card_le_card hsub).trans
      (common_bound b hn (hp b hb) (hp _ (hadd 4 h4 b hb)))
    omega
  exact Finset.eq_of_subset_of_card_le hle (by rw [hc, row_card])

theorem rankOneGroup_zero (f : Equiv.Perm Code) (hf : f ∈ rankOneGroup) : f 0 = 0 := by
  have h := hf.1 0 0
  simpa using h

private theorem preserves_row (f : Equiv.Perm Code) (hf : f ∈ rankOneGroup) (h4 : f 4 = 4) :
    rowCodes.image f = rowCodes := by
  apply eight_pure_eq_row
  · rw [Finset.card_image_of_injective _ f.injective, row_card]
  · exact Finset.mem_image.mpr ⟨4, by decide, h4⟩
  · rintro a ha
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp ha
    rcases row_pure x hx with hx | hx
    · left; rw [hx, rankOneGroup_zero f hf]
    · right; rw [hf.2, hx]
  · rintro a ha b hb
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp ha
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hb
    exact Finset.mem_image.mpr ⟨x ^^^ y, row_xor x y hx hy, hf.1 x y⟩

private def word : List (Fin 5) → Equiv.Perm Code
  | [] => 1
  | k :: w => word w * shearPerm k

private theorem word_mem (w : List (Fin 5)) : word w ∈ Subgroup.closure (Set.range shearPerm) := by
  induction w with
  | nil => exact Subgroup.one_mem _
  | cons k w ih => exact Subgroup.mul_mem _ ih (Subgroup.subset_closure ⟨k, rfl⟩)
private theorem word_rankOne (w : List (Fin 5)) : word w ∈ rankOneGroup :=
  ((Subgroup.closure_le rankOneGroup).mpr (by rintro _ ⟨k, rfl⟩; exact shearPerm_mem k)) (word_mem w)
private theorem word_point (w : List (Fin 5)) : word w 4 = 4 := by
  induction w with
  | nil => rfl
  | cons k w ih => change word w (shear k 4) = 4; rw [shear_point, ih]

private def rowWord (a b : Code) : List (Fin 5) :=
  (![![[],[],[],[],[],[],[],[]],![[],[],[],[2],[],[],[4],[4,2]],![[],[1,2,1],[],[2,1],[],[3,1,2,1],[],[3,2,1]],![[],[1,2],[1],[],[],[1,4,2],[1,4],[]],![[],[],[],[],[],[],[],[]],![[],[],[3],[2,3],[],[],[4,3],[3,2]],![[],[4,1,2,1],[],[2,3,1],[],[1,4,2,1],[],[4,2,1]],![[],[4,1,2],[3,1],[],[],[3,1,2],[4,1],[]]]) ⟨a.toNat % 8, Nat.mod_lt _ (by decide)⟩ ⟨b.toNat % 8, Nat.mod_lt _ (by decide)⟩

private theorem rowWord_normalizes : ∀ a b : Code,
    a ∈ rowCodes → b ∈ rowCodes → a ≠ 0 → b ≠ 0 → a ≠ b →
    a ≠ 4 → b ≠ 4 → a ^^^ b ≠ 4 →
    word (rowWord a b) a = 1 ∧ word (rowWord a b) b = 2 := by decide

private theorem outside_row_pair : ∀ x : Code,
    x ∉ rowCodes → pure x = true → pure (x ^^^ 4) = true → x = 32 ∨ x = 36 := by decide
private theorem rigid_eight : ∀ x : Code,
    pure x = pure 8 → pure (x ^^^ 1) = pure (8 ^^^ 1) →
    pure (x ^^^ 2) = pure (8 ^^^ 2) → pure (x ^^^ 3) = pure (8 ^^^ 3) →
    pure (x ^^^ 32) = pure (8 ^^^ 32) → x = 8 := by decide
private theorem rigid_sixteen : ∀ x : Code,
    pure x = pure 16 → pure (x ^^^ 1) = pure (16 ^^^ 1) →
    pure (x ^^^ 2) = pure (16 ^^^ 2) → pure (x ^^^ 3) = pure (16 ^^^ 3) →
    pure (x ^^^ 32) = pure (16 ^^^ 32) → x = 16 := by decide

private theorem basis_ext (f : Equiv.Perm Code) (hf : f ∈ rankOneGroup)
    (h1 : f 1 = 1) (h2 : f 2 = 2) (h4 : f 4 = 4) (h32 : f 32 = 32) : f = 1 := by
  have h3 : f 3 = 3 := by
    change f (1 ^^^ 2) = 1 ^^^ 2
    rw [hf.1, h1, h2]
  have hp (x y : Code) (hy : f y = y) : pure (f x ^^^ y) = pure (x ^^^ y) := by
    calc
      pure (f x ^^^ y) = pure (f (x ^^^ y)) := by rw [hf.1, hy]
      _ = pure (x ^^^ y) := hf.2 _
  have h8 : f 8 = 8 := rigid_eight (f 8) (hf.2 8)
    (hp 8 1 h1) (hp 8 2 h2) (hp 8 3 h3) (hp 8 32 h32)
  have h16 : f 16 = 16 := rigid_sixteen (f 16) (hf.2 16)
    (hp 16 1 h1) (hp 16 2 h2) (hp 16 3 h3) (hp 16 32 h32)
  have hd : ∀ x : Code, x =
      (if x.getLsbD 0 then 1 else 0) ^^^ (if x.getLsbD 1 then 2 else 0) ^^^
      (if x.getLsbD 2 then 4 else 0) ^^^ (if x.getLsbD 3 then 8 else 0) ^^^
      (if x.getLsbD 4 then 16 else 0) ^^^ (if x.getLsbD 5 then 32 else 0) := by decide
  apply Equiv.ext
  intro x
  change f x = x
  conv_lhs => rw [hd x]
  simp only [hf.1, apply_ite f, h1, h2, h4, h8, h16, h32, rankOneGroup_zero f hf]
  exact (hd x).symm

/-- The point stabilizer in the full rank-one preserving additive group is
already generated by the five marked centralizer shears. -/
theorem rankOneGroup_point_stabilizer (f : Equiv.Perm Code)
    (hf : f ∈ rankOneGroup) (h4 : f 4 = 4) : f ∈ Subgroup.closure (Set.range shearPerm) := by
  let w := rowWord (f 1) (f 2)
  have hr := preserves_row f hf h4
  have hrow (x : Code) (hx : x ∈ rowCodes) : f x ∈ rowCodes := by
    rw [← hr]; exact Finset.mem_image_of_mem f hx
  have hneq (x y : Code) (h : x ≠ y) : f x ≠ f y := fun he => h (f.injective he)
  have hz := rankOneGroup_zero f hf
  have hab := rowWord_normalizes (f 1) (f 2) (hrow 1 (by decide)) (hrow 2 (by decide))
    (by rw [← hz]; exact hneq 1 0 (by decide))
    (by rw [← hz]; exact hneq 2 0 (by decide)) (hneq 1 2 (by decide))
    (by rw [← h4]; exact hneq 1 4 (by decide))
    (by rw [← h4]; exact hneq 2 4 (by decide))
    (by rw [← hf.1, ← h4]; exact hneq 3 4 (by decide))
  let g := word w * f
  have hg : g ∈ rankOneGroup := rankOneGroup.mul_mem (word_rankOne w) hf
  have hg1 : g 1 = 1 := hab.1
  have hg2 : g 2 = 2 := hab.2
  have hg4 : g 4 = 4 := by change word w (f 4) = 4; rw [h4, word_point]
  have hg32out : g 32 ∉ rowCodes := by
    intro hmem
    rw [← preserves_row g hg hg4] at hmem
    obtain ⟨x, hx, he⟩ := Finset.mem_image.mp hmem
    have he' : x = 32 := g.injective he
    exact (by decide : (32 : Code) ∉ rowCodes) (he' ▸ hx)
  have hg32 := outside_row_pair (g 32) hg32out (by rw [hg.2]; decide)
    (by rw [← hg4, ← hg.1, hg.2]; decide)
  let K := Subgroup.closure (Set.range shearPerm)
  have hgin : g ∈ K := by
    rcases hg32 with he | he
    · rw [basis_ext g hg hg1 hg2 hg4 he]
      exact K.one_mem
    · have heq : shearPerm 0 * g = 1 := basis_ext _
        (rankOneGroup.mul_mem (shearPerm_mem 0) hg)
        (by change shear 0 (g 1) = 1; rw [hg1]; rfl)
        (by change shear 0 (g 2) = 2; rw [hg2]; rfl)
        (by change shear 0 (g 4) = 4; rw [hg4]; rfl)
        (by change shear 0 (g 32) = 32; rw [he]; rfl)
      have ht : g = (shearPerm 0)⁻¹ := eq_inv_of_mul_eq_one_right heq
      rw [ht]
      exact K.inv_mem (Subgroup.subset_closure ⟨0, rfl⟩)
  have hm := K.mul_mem (K.inv_mem (word_mem w)) hgin
  simpa only [g, inv_mul_cancel_left] using hm

end Theory.GroupTheory.TransvectionFive.UniquenessLinear.PlaneCensus
