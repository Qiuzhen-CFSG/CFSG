module
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourceEdgeFixer

/-!
# The literal linear source uniqueness system

The marked linear fusion geometry proves faithfulness, both local generation
identities, and the orbit description of its literal collinearity graph.
Consequently global generation by the row and three-space normalizers gives
an actual source uniqueness system. In their generated subgroup that final
premise is proved by the literal normalizer identifications, so the system
is constructed there without assuming simplicity or an ambient isomorphism.

This is the source-system step of Aschbacher, *Sporadic Groups* (1994),
41.1–41.4, pp.219–222. Global generation in the original group and compatible
local comparison with the native matrix system remain separate obligations.
-/

public noncomputable section
open Subgroup
namespace Theory.GroupTheory.TransvectionFive.UniquenessLinear.SourceGeometry
open GraphUniquenessSystem GraphUniquenessSystem.Cosets
open UniquenessMathieu.OctadSource (Point graph)
variable {G : Type*} [Group G] [Finite G] {z : G}
  (F : MarkedCentralizer z) (hlinear : F.LinearFusion)

/-- Construct the source system once the global generation clause of 41.1 is known. -/
def system_of_global_generation
    (hgen : rowNormalizer F ⊔ sourceThreeSpaceNormalizer F = ⊤) :
    System G (Point F) :=
  Cosets.system (rowNormalizer F) (planeSwap F hlinear : G)
    (sourceThreeSpaceNormalizer F)
    (planeSwap_mem F hlinear)
    (planeSwap_not_row F hlinear)
    (planeSwap_square_mem F hlinear)
    (linear_row_normalizer_core F hlinear)
    (by simpa only [sup_comm] using hgen)
    (plane_flag_maximal F hlinear)
    (local_flag_maximal F hlinear)
    (by
      rw [← Cosets.edgeFixer_eq]
      exact edgeFixer_not_le_plane F hlinear)

@[simp] theorem system_of_global_generation_point
    (hgen : rowNormalizer F ⊔ sourceThreeSpaceNormalizer F = ⊤) :
    (system_of_global_generation F hlinear hgen).x =
      vertex (rowNormalizer F) 1 := by rfl

@[simp] theorem system_of_global_generation_neighbor
    (hgen : rowNormalizer F ⊔ sourceThreeSpaceNormalizer F = ⊤) :
    (system_of_global_generation F hlinear hgen).y =
      vertex (rowNormalizer F) (planeSwap F hlinear : G) := by rfl

@[simp] theorem system_of_global_generation_local
    (hgen : rowNormalizer F ⊔ sourceThreeSpaceNormalizer F = ⊤) :
    (system_of_global_generation F hlinear hgen).H =
      sourceThreeSpaceNormalizer F := by rfl

/-- The vertex group is the original row normalizer. -/
@[simp] theorem system_of_global_generation_vertexGroup
    (hgen : rowNormalizer F ⊔ sourceThreeSpaceNormalizer F = ⊤) :
    (system_of_global_generation F hlinear hgen).vertexGroup = rowNormalizer F := by
  change MulAction.stabilizer G _ = _
  rw [system_of_global_generation_point, stabilizer_base]

/-- The constructed system has the literal collinearity graph of the source geometry. -/
theorem system_graph_eq_collinear
    (hgen : rowNormalizer F ⊔ sourceThreeSpaceNormalizer F = ⊤) :
    (system_of_global_generation F hlinear hgen).graph = graph F := by
  symm
  exact graph_eq_orbit F hlinear (planeSwap F hlinear : G)
    (planeSwap F hlinear).property (planeSwap_not_row F hlinear)

/-- Adjacency is exactly incidence with a common literal plane-normalizer coset. -/
theorem system_graph_adj_iff
    (hgen : rowNormalizer F ⊔ sourceThreeSpaceNormalizer F = ⊤) (a b : Point F) :
    (system_of_global_generation F hlinear hgen).graph.Adj a b ↔
      Collinear (rowNormalizer F) (sourcePlaneNormalizer F) a b := by
  rw [system_graph_eq_collinear]
  rfl

/-- The edge group of the actual uniqueness system has the literal source
line-kernel description needed by the comparison and rigidity arguments. -/
theorem system_edgeGroup_eq_line_kernel
    (hgen : rowNormalizer F ⊔ sourceThreeSpaceNormalizer F = ⊤) :
    (system_of_global_generation F hlinear hgen).edgeGroup =
      ((lineAction F hlinear).ker).map (sourcePlaneNormalizer F).subtype := by
  change edgeFixer G _ _ = _
  rw [system_of_global_generation_point, system_of_global_generation_neighbor,
    plane_edgeFixer_eq_line_kernel]

include hlinear in
/-- The actual induction overgroup is generated by its original row and
three-space normalizers, with both subgroup embeddings retained. -/
theorem normalizerSpan_row_threeSpace_generate :
    rowNormalizer (normalizerSpanMarking F) ⊔
      sourceThreeSpaceNormalizer (normalizerSpanMarking F) = ⊤ := by
  apply Subgroup.map_injective (normalizerSpan F).subtype_injective
  rw [Subgroup.map_sup, (normalizerSpan_normalizers_map F).1,
    (normalizerSpan_normalizers_map F).2.2]
  rw [← MonoidHom.range_eq_map (normalizerSpan F).subtype,
    Subgroup.range_subtype, normalizerSpan_eq, normalizer_span_eq F hlinear]

/-- A complete source uniqueness system in the normalizer-generated subgroup.
Every system axiom is discharged; no simplicity of this subgroup is used. -/
def normalizerSpan_system :
    System (normalizerSpan F) (Point (normalizerSpanMarking F)) :=
  system_of_global_generation (normalizerSpanMarking F)
    (normalizerSpan_linearFusion F hlinear) (normalizerSpan_row_threeSpace_generate F hlinear)

/-- The internal system retains the literal point, local subgroup and collinearity
relation needed in the induction of source 41.1. -/
theorem normalizerSpan_system_geometry :
    (normalizerSpan_system F hlinear).x = vertex (rowNormalizer (normalizerSpanMarking F)) 1 ∧
    (normalizerSpan_system F hlinear).H = sourceThreeSpaceNormalizer (normalizerSpanMarking F) ∧
    ∀ a b, (normalizerSpan_system F hlinear).graph.Adj a b ↔
      Collinear (rowNormalizer (normalizerSpanMarking F))
        (sourcePlaneNormalizer (normalizerSpanMarking F)) a b := by
  exact ⟨system_of_global_generation_point _ _ _, system_of_global_generation_local _ _ _,
    system_graph_adj_iff _ _ _⟩

end Theory.GroupTheory.TransvectionFive.UniquenessLinear.SourceGeometry
