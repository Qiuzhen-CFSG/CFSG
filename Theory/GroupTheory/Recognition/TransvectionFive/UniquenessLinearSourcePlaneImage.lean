module
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourceTensorProduct
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourceRankOne
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourcePlaneAction

/-!
# The source rectangle normalizer quotients in the linear branch

The faithful conjugation action of N_G(A₁)/A₁ preserves the actual 21-point
fusion set, which is the rank-one locus in the original marked coordinates.
Every additive rank-one symmetry fixing z is a product of the five marked
centralizer shears. Source fusion control supplies the complete point orbit,
so the quotient action is exactly the full rank-one symmetry group. Its
proved tensor decomposition identifies the literal quotient with GL₃(2) × S₃.
The opposite marking gives the original A₂ quotient and its conjugation map.

The action equations retain the actual denominators, ambient conjugation,
and tensor factors. Application to the subgroup generated by the normalizers
uses its inherited fusion counts and requires no simplicity of that subgroup.
This proves the rectangle quotient assertions of Aschbacher, *Sporadic
Groups* (1994), 40.3 and 40.5(1), pp.217–219. Rectangle splittings, source
generation and the §41 local comparison remain separate obligations.
-/

public noncomputable section
open Subgroup BinaryLinear.TransvectionFiveLocal
namespace Theory.GroupTheory.TransvectionFive.UniquenessLinear
open PlaneCensus (Code pure rankOneGroup shearPerm)
namespace PlaneTensor
variable {G : Type*} [Group G] {z : G} (F : MarkedCentralizer z)

private def coordinatePermutation : MulAut F.plane →* Equiv.Perm Code :=
  (sourceEquiv F).symm.permCongrHom.toMonoidHom.comp (MulAut.toPerm F.plane)

private theorem coordinatePermutation_element (a : MulAut F.plane) (x : Code) :
    element F (coordinatePermutation F a x) = (a (sourceEquiv F x) : G) := by
  change ((sourceEquiv F) ((sourceEquiv F).symm (a (sourceEquiv F x))) : G) = _
  rw [Equiv.apply_symm_apply]

private theorem coordinatePermutation_normalizer (n : sourcePlaneNormalizer F) :
    coordinatePermutation F (F.plane.normalizerMonoidHom n) = normalizerAction F n := by
  apply Equiv.ext
  intro x
  apply element_injective F
  rw [coordinatePermutation_element, normalizerAction_element]
  exact normalizerMonoidHom_apply_apply_coe F.plane n _

private theorem coordinatePermutation_injective : Function.Injective (coordinatePermutation F) := by
  intro a b hab
  apply MulEquiv.ext
  intro x
  obtain ⟨y, rfl⟩ := (sourceEquiv F).surjective x
  apply Subtype.ext
  simpa only [coordinatePermutation_element] using
    congrArg (fun f : Equiv.Perm Code => element F (f y)) hab

/-- The literal normalizer quotient acts on the six-bit coordinates by ambient conjugation. -/
def quotientCodeAction : sourcePlaneQuotient F →* Equiv.Perm Code :=
  (coordinatePermutation F).comp (sourcePlaneQuotientAction F)

theorem quotientCodeAction_injective : Function.Injective (quotientCodeAction F) :=
  (coordinatePermutation_injective F).comp (sourcePlaneQuotientAction_injective F)

theorem quotientCodeAction_mk (n : sourcePlaneNormalizer F) :
    quotientCodeAction F (QuotientGroup.mk n) = normalizerAction F n := by
  apply Equiv.ext
  intro x
  apply element_injective F
  change element F (coordinatePermutation F (sourcePlaneQuotientAction F (QuotientGroup.mk n)) x) = _
  rw [coordinatePermutation_element, sourcePlaneQuotientAction_mk, normalizerAction_element]
  rfl

/-- The relative normalizer retains the same point-centralizer marking. -/
def pointCodeAction :
    ↥(Subgroup.centralizer ({z} : Set G) ⊓ sourcePlaneNormalizer F) →* Equiv.Perm Code :=
  (coordinatePermutation F).comp
    (F.plane.normalizerMonoidHom.comp (Subgroup.inclusion inf_le_right))

theorem pointCodeAction_apply
    (n : ↥(Subgroup.centralizer ({z} : Set G) ⊓ sourcePlaneNormalizer F)) :
    pointCodeAction F n = normalizerAction F ⟨n, n.property.2⟩ :=
  coordinatePermutation_normalizer F _

variable [Finite G]

private theorem exists_shear_normalizer (k : Fin 5) :
    ∃ n : ↥(Subgroup.centralizer ({z} : Set G) ⊓ sourcePlaneNormalizer F),
      pointCodeAction F n = shearPerm k := by
  obtain ⟨n, hn, he⟩ := exists_shear_conjugator_uniform F k
  have hnN : n ∈ sourcePlaneNormalizer F := by
    apply mem_normalizer_iff_map_conj_eq.mpr
    apply eq_of_le_of_card_ge
    · rintro _ ⟨a, ha, rfl⟩
      obtain ⟨x, hx⟩ := (sourceEquiv F).surjective ⟨a, ha⟩
      have hx' : element F x = a := congrArg Subtype.val hx
      change n * a * n⁻¹ ∈ F.plane
      rw [← hx', he]
      exact element_mem F _
    · rw [card_map_of_injective (MulAut.conj n).injective]
  refine ⟨⟨n, hn, hnN⟩, ?_⟩
  apply Equiv.ext
  intro x
  apply element_injective F
  rw [pointCodeAction_apply, normalizerAction_element, PlaneCensus.shearPerm_apply]
  exact he x

/-- Every rank-one preserving additive permutation fixing the marked point
is induced by an actual element of C_G(z) normalizing the original rectangle. -/
theorem exists_point_code_action (f : Equiv.Perm Code) (hf : f ∈ rankOneGroup)
    (h4 : f 4 = 4) :
    ∃ n : ↥(Subgroup.centralizer ({z} : Set G) ⊓ sourcePlaneNormalizer F),
      pointCodeAction F n = f := by
  apply ((Subgroup.closure_le (pointCodeAction F).range).mpr ?_)
    (PlaneCensus.rankOneGroup_point_stabilizer f hf h4)
  rintro _ ⟨k, rfl⟩
  exact exists_shear_normalizer F k

private theorem normalizer_rankOne (hlinear : F.LinearFusion) (n : sourcePlaneNormalizer F) :
    normalizerAction F n ∈ rankOneGroup := by
  apply (PlaneCensus.mem_rankOneGroup _).mpr
  refine ⟨normalizerAction_xor F n, fun x => ?_⟩
  have he : (pure (normalizerAction F n x) = true) ↔ pure x = true := by
    rw [← fusion_iff_pure F hlinear, ← fusion_iff_pure F hlinear, normalizerAction_element]
    have hc : IsConj (element F x) ((n : G) * element F x * (n : G)⁻¹) :=
      isConj_iff.mpr ⟨n, rfl⟩
    exact ⟨fun h => h.trans hc.symm, fun h => h.trans hc⟩
  cases hp : pure (normalizerAction F n x) <;> cases hq : pure x <;> simp_all

private theorem quotientCodeAction_rankOne (hlinear : F.LinearFusion) (q : sourcePlaneQuotient F) :
    quotientCodeAction F q ∈ rankOneGroup := by
  induction q using QuotientGroup.induction_on with
  | H n => rw [quotientCodeAction_mk]; exact normalizer_rankOne F hlinear n

/-- The full rank-one preserving additive group is realized by the source
normalizer: fusion gives the point orbit, and the marked centralizer supplies
its entire stabilizer. -/
theorem quotientCodeAction_range (hlinear : F.LinearFusion) :
    (quotientCodeAction F).range = rankOneGroup := by
  apply le_antisymm
  · rintro _ ⟨q, rfl⟩
    exact quotientCodeAction_rankOne F hlinear q
  · intro f hf
    have hp : pure (f 4) = true := by
      rw [(PlaneCensus.mem_rankOneGroup f).mp hf |>.2]
      decide
    obtain ⟨n, hn, hne⟩ := source_plane_fusion F (point_mem_plane F) (element_mem F (f 4))
      ((fusion_iff_pure F hlinear (f 4)).mpr hp)
    let q : sourcePlaneQuotient F := QuotientGroup.mk (⟨n, hn⟩ : sourcePlaneNormalizer F)
    let b := quotientCodeAction F q
    have hb : b 4 = f 4 := by
      apply element_injective F
      change element F (quotientCodeAction F q 4) = _
      rw [quotientCodeAction_mk, normalizerAction_element, element_point]
      exact hne
    have hd : b⁻¹ * f ∈ rankOneGroup := rankOneGroup.mul_mem
      (rankOneGroup.inv_mem (quotientCodeAction_rankOne F hlinear q)) hf
    have hd4 : (b⁻¹ * f) 4 = 4 := by
      change b.symm (f 4) = 4
      rw [← hb, b.symm_apply_apply]
    obtain ⟨c, hc⟩ := exists_point_code_action F (b⁻¹ * f) hd hd4
    have hcR : b⁻¹ * f ∈ (quotientCodeAction F).range := by
      refine ⟨QuotientGroup.mk (⟨c, c.property.2⟩ : sourcePlaneNormalizer F), ?_⟩
      rw [quotientCodeAction_mk, ← pointCodeAction_apply, hc]
    have h := (quotientCodeAction F).range.mul_mem (show b ∈ (quotientCodeAction F).range from ⟨q, rfl⟩) hcR
    simpa only [mul_inv_cancel_left] using h

/-- The actual quotient N_G(A₁)/A₁, with its full natural rank-one geometry. -/
def quotientRankOneEquiv (hlinear : F.LinearFusion) : sourcePlaneQuotient F ≃* rankOneGroup :=
  MulEquiv.ofBijective
    ((quotientCodeAction F).codRestrict rankOneGroup (quotientCodeAction_rankOne F hlinear))
    ⟨fun _ _ h => quotientCodeAction_injective F (congrArg Subtype.val h), by
      intro f
      have hf : f.val ∈ (quotientCodeAction F).range := (quotientCodeAction_range F hlinear).symm ▸ f.property
      obtain ⟨q, hq⟩ := hf
      exact ⟨q, Subtype.ext hq⟩⟩

/-- The isomorphism retains the literal quotient map and original conjugation. -/
theorem quotientRankOneEquiv_action (hlinear : F.LinearFusion)
    (n : sourcePlaneNormalizer F) (x : Code) :
    element F ((quotientRankOneEquiv F hlinear (QuotientGroup.mk n)).val x) =
      (n : G) * element F x * (n : G)⁻¹ := by
  change element F (quotientCodeAction F (QuotientGroup.mk n) x) = _
  rw [quotientCodeAction_mk, normalizerAction_element]

end PlaneTensor

variable {G : Type*} [Group G] [Finite G] {z : G} (F : MarkedCentralizer z)

private def normalizerQuotientCongr (A B : Subgroup G) (h : A = B) :
    (normalizer (A : Set G) ⧸ A.subgroupOf (normalizer (A : Set G))) ≃*
      (normalizer (B : Set G) ⧸ B.subgroupOf (normalizer (B : Set G))) := by
  subst B
  exact MulEquiv.refl _

omit [Finite G] in
private theorem normalizerQuotientCongr_mk (A B : Subgroup G) (h : A = B)
    (n : normalizer (A : Set G)) :
    normalizerQuotientCongr A B h (QuotientGroup.mk n) =
      QuotientGroup.mk (⟨n, h ▸ n.property⟩ : normalizer (B : Set G)) := by
  subst B
  rfl

/-- Opposite marking identifies the literal three-space quotient with the same
rank-one symmetry group, retaining the original denominator. -/
def threeSpaceRankOneEquiv (hlinear : F.LinearFusion) :
    sourceThreeSpaceQuotient F ≃* rankOneGroup :=
  (normalizerQuotientCongr F.threeSpace (oppositeMarking F).plane
    (oppositeMarking_plane F).symm).trans
      (PlaneTensor.quotientRankOneEquiv (oppositeMarking F) (oppositeMarking_linearFusion F hlinear))

/-- The three-space quotient also retains its original ambient conjugation,
written in the opposite marked coordinates. -/
theorem threeSpaceRankOneEquiv_action (hlinear : F.LinearFusion)
    (n : sourceThreeSpaceNormalizer F) (x : Code) :
    PlaneTensor.element (oppositeMarking F) ((threeSpaceRankOneEquiv F hlinear
      (QuotientGroup.mk n)).val x) =
        (n : G) * PlaneTensor.element (oppositeMarking F) x * (n : G)⁻¹ := by
  change PlaneTensor.element (oppositeMarking F)
    ((PlaneTensor.quotientRankOneEquiv (oppositeMarking F)
      (oppositeMarking_linearFusion F hlinear)
      (normalizerQuotientCongr _ _ _ (QuotientGroup.mk n))).val x) = _
  rw [normalizerQuotientCongr_mk]
  exact PlaneTensor.quotientRankOneEquiv_action (oppositeMarking F)
    (oppositeMarking_linearFusion F hlinear) _ x

/-- Source 40.3: the literal plane normalizer quotient is GL₃(2) × S₃. -/
def linearPlaneQuotientEquiv (hlinear : F.LinearFusion) : sourcePlaneQuotient F ≃*
    (((Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) × Equiv.Perm (Fin 3)) :=
  (PlaneTensor.quotientRankOneEquiv F hlinear).trans PlaneCensus.rankOneGroupEquivLinearSymmetric

/-- The second quotient in source 40.5(1), on the original three-space denominator. -/
def linearThreeSpaceQuotientEquiv (hlinear : F.LinearFusion) : sourceThreeSpaceQuotient F ≃*
    (((Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) × Equiv.Perm (Fin 3)) :=
  (threeSpaceRankOneEquiv F hlinear).trans PlaneCensus.rankOneGroupEquivLinearSymmetric

/-- The plane quotient has the actual natural tensor action, using the same
quotient map, marked subgroup and ambient conjugation. -/
theorem linearPlaneQuotientEquiv_action (hlinear : F.LinearFusion)
    (n : sourcePlaneNormalizer F) (i : Fin 3) (v : Fin 3 → ZMod 2) :
    PlaneTensor.element F (PlaneCensus.tensorCode
      ((linearPlaneQuotientEquiv F hlinear (QuotientGroup.mk n)).2 i)
      ((linearPlaneQuotientEquiv F hlinear (QuotientGroup.mk n)).1 v)) =
    (n : G) * PlaneTensor.element F (PlaneCensus.tensorCode i v) * (n : G)⁻¹ := by
  rw [← PlaneTensor.quotientRankOneEquiv_action F hlinear n]
  congr 1
  exact (PlaneCensus.rankOneGroupEquivLinearSymmetric_action
    (PlaneTensor.quotientRankOneEquiv F hlinear (QuotientGroup.mk n)) i v).symm

/-- The same natural tensor action for the original three-space quotient. -/
theorem linearThreeSpaceQuotientEquiv_action (hlinear : F.LinearFusion)
    (n : sourceThreeSpaceNormalizer F) (i : Fin 3) (v : Fin 3 → ZMod 2) :
    PlaneTensor.element (oppositeMarking F) (PlaneCensus.tensorCode
      ((linearThreeSpaceQuotientEquiv F hlinear (QuotientGroup.mk n)).2 i)
      ((linearThreeSpaceQuotientEquiv F hlinear (QuotientGroup.mk n)).1 v)) =
    (n : G) * PlaneTensor.element (oppositeMarking F) (PlaneCensus.tensorCode i v) * (n : G)⁻¹ := by
  rw [← threeSpaceRankOneEquiv_action F hlinear n]
  congr 1
  exact (PlaneCensus.rankOneGroupEquivLinearSymmetric_action
    (threeSpaceRankOneEquiv F hlinear (QuotientGroup.mk n)) i v).symm

/-- The 41.1 induction subgroup inherits both standard rectangle quotient
identifications from its proved fusion counts, without a simplicity assumption. -/
theorem normalizerSpan_rectangle_quotients (hlinear : F.LinearFusion) :
    Nonempty (sourcePlaneQuotient (normalizerSpanMarking F) ≃*
      (((Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) × Equiv.Perm (Fin 3))) ∧
    Nonempty (sourceThreeSpaceQuotient (normalizerSpanMarking F) ≃*
      (((Fin 3 → ZMod 2) ≃ₗ[ZMod 2] (Fin 3 → ZMod 2)) × Equiv.Perm (Fin 3))) :=
  ⟨⟨linearPlaneQuotientEquiv (normalizerSpanMarking F) (normalizerSpan_linearFusion F hlinear)⟩,
    ⟨linearThreeSpaceQuotientEquiv (normalizerSpanMarking F) (normalizerSpan_linearFusion F hlinear)⟩⟩

/-- The subgroup generated by the source normalizers inherits both complete
rectangle actions. No simplicity premise is imposed on this subgroup. -/
theorem normalizerSpan_rectangle_rankOne (hlinear : F.LinearFusion) :
    Nonempty (sourcePlaneQuotient (normalizerSpanMarking F) ≃* rankOneGroup) ∧
    Nonempty (sourceThreeSpaceQuotient (normalizerSpanMarking F) ≃* rankOneGroup) :=
  ⟨⟨PlaneTensor.quotientRankOneEquiv (normalizerSpanMarking F) (normalizerSpan_linearFusion F hlinear)⟩,
    ⟨threeSpaceRankOneEquiv (normalizerSpanMarking F) (normalizerSpan_linearFusion F hlinear)⟩⟩

end Theory.GroupTheory.TransvectionFive.UniquenessLinear
