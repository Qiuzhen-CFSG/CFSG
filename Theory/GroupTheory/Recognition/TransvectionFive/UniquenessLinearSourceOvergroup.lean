module
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourceRow
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourceSylow

/-!
# Restricting the marked geometry to its normalizer-generated subgroup

An overgroup of the full point centralizer inherits the same centralizer
marking. Each marked root group maps to its original subgroup under inclusion,
and every ambient normalizer contained in the overgroup is preserved exactly.
The canonical Sylow also maps to the same ambient Sylow.

Apply this to the subgroup generated by the row, plane and three-space
normalizers. This supplies the full marking and literal normalizer/Sylow
identifications needed in the induction of Aschbacher, *Sporadic Groups*
(1994), 41.1, printed pp.219–220. No simplicity of that generated subgroup
is assumed. Transfer of ambient fusion into this subgroup and the assertion
that it is the whole group remain separate source obligations.
-/

public noncomputable section
open Subgroup BinaryLinear.TransvectionFiveLocal
namespace Theory.GroupTheory.TransvectionFive.UniquenessLinear
variable {G : Type*} [Group G] {z : G} (F : MarkedCentralizer z)

/-- The distinguished involution in an overgroup of its full centralizer. -/
def overgroupPoint (L : Subgroup G)
    (hCL : Subgroup.centralizer ({z} : Set G) ≤ L) : L :=
  ⟨z, hCL (mem_centralizer_singleton_iff.mpr rfl)⟩

/-- The restricted point is the original involution under literal inclusion. -/
@[simp] theorem overgroupPoint_val (L : Subgroup G)
    (hCL : Subgroup.centralizer ({z} : Set G) ≤ L) :
    (overgroupPoint L hCL : G) = z := by rfl

private def centralizerRestriction (L : Subgroup G)
    (hCL : Subgroup.centralizer ({z} : Set G) ≤ L) :
    Subgroup.centralizer ({overgroupPoint L hCL} : Set L) ≃*
      Subgroup.centralizer ({z} : Set G) where
  toFun x := ⟨x.val.val, mem_centralizer_singleton_iff.mpr
    (congrArg Subtype.val (mem_centralizer_singleton_iff.mp x.property))⟩
  invFun x := ⟨⟨x, hCL x.property⟩, mem_centralizer_singleton_iff.mpr
    (Subtype.ext (mem_centralizer_singleton_iff.mp x.property))⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

/-- Restriction retains the full marked centralizer and its distinguished involution. -/
def overgroupMarking (L : Subgroup G)
    (hCL : Subgroup.centralizer ({z} : Set G) ≤ L) :
    MarkedCentralizer (overgroupPoint L hCL) where
  equiv := (centralizerRestriction L hCL).trans F.equiv
  on_point := F.on_point

/-- Every marked subgroup is preserved by the literal subgroup inclusion. -/
theorem overgroupMarking_pullback_map (L : Subgroup G)
    (hCL : Subgroup.centralizer ({z} : Set G) ≤ L) (A : Subgroup SL) :
    ((overgroupMarking F L hCL).pullback A).map L.subtype = F.pullback A := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    have hc := (overgroupMarking F L hCL).pullback_le A hy
    have hcG : (y : G) ∈ Subgroup.centralizer ({z} : Set G) :=
      mem_centralizer_singleton_iff.mpr
        (congrArg Subtype.val (mem_centralizer_singleton_iff.mp hc))
    apply (F.mem_pullback_iff A ⟨y, hcG⟩).mpr
    exact ((overgroupMarking F L hCL).mem_pullback_iff A ⟨y, hc⟩).mp hy
  · intro hx
    have hc := F.pullback_le A hx
    let y : L := ⟨x, hCL hc⟩
    have hy : y ∈ Subgroup.centralizer ({overgroupPoint L hCL} : Set L) :=
      mem_centralizer_singleton_iff.mpr
        (Subtype.ext (mem_centralizer_singleton_iff.mp hc))
    refine ⟨y, ?_, rfl⟩
    apply ((overgroupMarking F L hCL).mem_pullback_iff A ⟨y, hy⟩).mpr
    exact (F.mem_pullback_iff A ⟨x, hc⟩).mp hx

/-- Within the overgroup the marked subgroup is the exact restriction. -/
theorem overgroupMarking_pullback (L : Subgroup G)
    (hCL : Subgroup.centralizer ({z} : Set G) ≤ L) (A : Subgroup SL) :
    (overgroupMarking F L hCL).pullback A = (F.pullback A).subgroupOf L := by
  have hh := congrArg (Subgroup.comap L.subtype) (overgroupMarking_pullback_map F L hCL A)
  exact (comap_map_eq_self_of_injective L.subtype_injective _).symm.trans hh

/-- An ambient normalizer lying in the overgroup is preserved exactly. -/
theorem overgroupMarking_normalizer_map (L : Subgroup G)
    (hCL : Subgroup.centralizer ({z} : Set G) ≤ L) (A : Subgroup SL)
    (hNL : normalizer (F.pullback A : Set G) ≤ L) :
    (normalizer ((overgroupMarking F L hCL).pullback A : Set L)).map L.subtype =
      normalizer (F.pullback A : Set G) := by
  rw [overgroupMarking_pullback, ← subgroupOf_normalizer_eq ((F.pullback_le A).trans hCL),
    map_subgroupOf_eq_of_le hNL]

/-- The actual subgroup used in the generation argument of source 41.1. -/
def normalizerSpan : Subgroup G :=
  normalizer (F.row : Set G) ⊔ normalizer (F.plane : Set G) ⊔
    normalizer (F.threeSpace : Set G)

/-- The source generation subgroup retains its three actual generators. -/
theorem normalizerSpan_eq : normalizerSpan F =
    normalizer (F.row : Set G) ⊔ normalizer (F.plane : Set G) ⊔
      normalizer (F.threeSpace : Set G) := by rfl

/-- The generated subgroup contains the whole point centralizer. -/
theorem point_centralizer_le_normalizerSpan :
    Subgroup.centralizer ({z} : Set G) ≤ normalizerSpan F :=
  (point_centralizer_le_row_normalizer F).trans (le_sup_left.trans le_sup_left)

/-- A full marking inside the generated subgroup, with no simplicity assumption. -/
def normalizerSpanMarking :
    MarkedCentralizer (overgroupPoint (normalizerSpan F) (point_centralizer_le_normalizerSpan F)) :=
  overgroupMarking F (normalizerSpan F) (point_centralizer_le_normalizerSpan F)

/-- The induction marking is precisely centralizer restriction. -/
theorem normalizerSpanMarking_eq : normalizerSpanMarking F =
    overgroupMarking F (normalizerSpan F) (point_centralizer_le_normalizerSpan F) := by rfl

/-- All three full source normalizers survive restriction to the generated subgroup. -/
theorem normalizerSpan_normalizers_map :
    (normalizer ((normalizerSpanMarking F).row : Set (normalizerSpan F))).map
        (normalizerSpan F).subtype = normalizer (F.row : Set G) ∧
    (normalizer ((normalizerSpanMarking F).plane : Set (normalizerSpan F))).map
        (normalizerSpan F).subtype = normalizer (F.plane : Set G) ∧
    (normalizer ((normalizerSpanMarking F).threeSpace : Set (normalizerSpan F))).map
        (normalizerSpan F).subtype = normalizer (F.threeSpace : Set G) := by
  exact ⟨overgroupMarking_normalizer_map F _ _ _ (le_sup_left.trans le_sup_left),
    overgroupMarking_normalizer_map F _ _ _ (le_sup_right.trans le_sup_left),
    overgroupMarking_normalizer_map F _ _ _ le_sup_right⟩

/-- The same canonical Sylow is preserved under centralizer-overgroup restriction. -/
theorem overgroup_sourceSylow_map [Finite G] (L : Subgroup G)
    (hCL : Subgroup.centralizer ({z} : Set G) ≤ L) :
    ((sourceSylow (overgroupMarking F L hCL) : Subgroup L).map L.subtype) =
      (sourceSylow F : Subgroup G) := by
  rw [coe_sourceSylow, coe_sourceSylow, overgroupMarking_pullback_map]

/-- The local generation subgroup has the literal marked Sylow of G.
No simplicity of this subgroup enters the Sylow construction. -/
theorem normalizerSpan_sourceSylow_map [Finite G] :
    ((sourceSylow (normalizerSpanMarking F) : Subgroup (normalizerSpan F)).map
      (normalizerSpan F).subtype) = (sourceSylow F : Subgroup G) :=
  overgroup_sourceSylow_map F _ _

end Theory.GroupTheory.TransvectionFive.UniquenessLinear
