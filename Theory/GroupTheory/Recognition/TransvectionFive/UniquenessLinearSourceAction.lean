module

public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourceRow
public import Theory.GroupTheory.Recognition.TransvectionFive.NormalizerTransport
public import Theory.SpecificGroups.BinaryLinear.OuterCyclic.Model
public import Theory.LinearAlgebra.BinaryTwoTransitivity
import Mathlib.LinearAlgebra.Matrix.Dual
public import Mathlib.Algebra.Module.ZMod
public import Theory.GroupTheory.Gaschutz
import Mathlib.Tactic.FinCases

/-!
# The source row normalizer and its split four-dimensional action

The marked full centralizer realizes every row automorphism fixing the
distinguished involution. The construction extends the inverse dual of a
four-space automorphism to the five-space, preserving the row coordinates.
Two-point transport then proves that an overgroup moving the involution
has full row action. The kernel is the actual row group.

The same block construction gives a homomorphic section of the point
centralizer action. In the full-action case its index in the row normalizer
is fifteen; Gaschütz transfers the splitting to that normalizer. This proves
the row normality, self-centralization and splitting in Aschbacher,
*Sporadic Groups* (1994), 39.1(2), and the row alternative in 39.3,
printed pp.213–214, for arbitrary ambient groups (finite for normalizer splitting).
It does not assume the simplicity of any subgroup generated by normalizers.

This is an upstream source theorem, not the requested 40.3–41.4 comparison:
the fusion arguments must still eliminate the point-centralizer alternative
and determine the plane normalizers before source generation and rigidity.
-/

public noncomputable section
open Subgroup BinaryLinear.TransvectionFiveLocal
namespace Theory.GroupTheory.TransvectionFive.UniquenessLinear
private abbrev Four := Fin 4 → ZMod 2
private abbrev Five := Fin 5 → ZMod 2
private abbrev lin := BinaryLinear.OuterCyclic.slEquivLinear 5

private def headTail : Five ≃ₗ[ZMod 2] ZMod 2 × Four where
  toFun v := (v 0, Fin.tail v)
  invFun v := Fin.cons v.1 v.2
  left_inv v := by ext i; refine Fin.cases ?_ (fun j => ?_) i <;> rfl
  right_inv v := rfl
  map_add' v w := rfl
  map_smul' c v := rfl

private def dualChange (f : Four ≃ₗ[ZMod 2] Four) : Four ≃ₗ[ZMod 2] Four :=
  (dotProductEquiv (ZMod 2) (Fin 4)).trans
    (f.symm.dualMap.trans (dotProductEquiv (ZMod 2) (Fin 4)).symm)

private theorem dualChange_pair (f : Four ≃ₗ[ZMod 2] Four) (v w : Four) :
    (f v) ⬝ᵥ dualChange f w = v ⬝ᵥ w := by
  have h : dotProductEquiv (ZMod 2) (Fin 4) (dualChange f w) =
      f.symm.dualMap (dotProductEquiv (ZMod 2) (Fin 4) w) := by
    simp [dualChange]
  have he := congrArg (fun q : Module.Dual (ZMod 2) Four => q (f v)) h
  simpa [dotProduct_comm] using he

private def liftChange (f : Four ≃ₗ[ZMod 2] Four) : Five ≃ₗ[ZMod 2] Five :=
  headTail.trans ((LinearEquiv.prodCongr (LinearEquiv.refl (ZMod 2) (ZMod 2))
    (dualChange f)).trans headTail.symm)

private theorem row_linear (a : Model.row) (v : Five) :
    headTail (lin a v) =
      (v 0 + (modelRowCoordinates a).toAdd ⬝ᵥ Fin.tail v, Fin.tail v) := by
  rw [BinaryLinear.OuterCyclic.slEquivLinear_apply, modelRowCoordinates_matrix]
  apply Prod.ext
  · change ((1 + Matrix.single 0 1 ((modelRowCoordinates a).toAdd 0) +
      Matrix.single 0 2 ((modelRowCoordinates a).toAdd 1) +
      Matrix.single 0 3 ((modelRowCoordinates a).toAdd 2) +
      Matrix.single 0 4 ((modelRowCoordinates a).toAdd 3) :
      Matrix (Fin 5) (Fin 5) (ZMod 2)).mulVec v) 0 = _
    simp [Matrix.add_mulVec, Matrix.single_mulVec, dotProduct,
      Fin.sum_univ_succ, Fin.tail, add_assoc]
  · ext i
    change ((1 + Matrix.single 0 1 ((modelRowCoordinates a).toAdd 0) +
      Matrix.single 0 2 ((modelRowCoordinates a).toAdd 1) +
      Matrix.single 0 3 ((modelRowCoordinates a).toAdd 2) +
      Matrix.single 0 4 ((modelRowCoordinates a).toAdd 3) :
      Matrix (Fin 5) (Fin 5) (ZMod 2)).mulVec v) i.succ = v i.succ
    simp [Matrix.add_mulVec, Matrix.single_mulVec, Fin.succ_ne_zero]

private theorem liftChange_row (f : Four ≃ₗ[ZMod 2] Four) (a : Model.row) :
    liftChange f * lin a * (liftChange f)⁻¹ =
      lin (modelRowCoordinates.symm (Multiplicative.ofAdd (f (modelRowCoordinates a).toAdd))) := by
  apply mul_inv_eq_iff_eq_mul.mpr
  apply LinearEquiv.ext
  intro v
  apply headTail.injective
  have ha := row_linear a v
  have hb := row_linear (modelRowCoordinates.symm
    (Multiplicative.ofAdd (f (modelRowCoordinates a).toAdd))) (liftChange f v)
  change headTail (liftChange f (lin a v)) =
    headTail (lin (modelRowCoordinates.symm
      (Multiplicative.ofAdd (f (modelRowCoordinates a).toAdd))) (liftChange f v))
  rw [hb]
  have hcoords : (modelRowCoordinates (modelRowCoordinates.symm
      (Multiplicative.ofAdd (f (modelRowCoordinates a).toAdd)))).toAdd =
      f (modelRowCoordinates a).toAdd := by simp
  rw [hcoords]
  change ((headTail (lin a v)).1, dualChange f (headTail (lin a v)).2) = _
  rw [ha]
  change (v 0 + (modelRowCoordinates a).toAdd ⬝ᵥ Fin.tail v, dualChange f (Fin.tail v)) =
    (v 0 + f (modelRowCoordinates a).toAdd ⬝ᵥ dualChange f (Fin.tail v),
      dualChange f (Fin.tail v))
  rw [dualChange_pair]

private def coordinateAut : MulAut (Multiplicative Four) ≃* (Four ≃ₗ[ZMod 2] Four) where
  toFun a :=
    { toFun := fun x => (a (Multiplicative.ofAdd x)).toAdd
      invFun := fun x => (a.symm (Multiplicative.ofAdd x)).toAdd
      left_inv := fun x => a.symm_apply_apply (Multiplicative.ofAdd x)
      right_inv := fun x => a.apply_symm_apply (Multiplicative.ofAdd x)
      map_add' := fun x y => a.map_mul (Multiplicative.ofAdd x) (Multiplicative.ofAdd y)
      map_smul' := by
        intro c v
        rcases (by decide : ∀ c : ZMod 2, c = 0 ∨ c = 1) c with rfl | rfl
        · simp
        · simp }
  invFun f := f.toAddEquiv.toMultiplicative
  left_inv a := by ext x; rfl
  right_inv f := by ext x; rfl
  map_mul' a b := by ext x; rfl

private def modelLift (a : MulAut Model.row) : SL :=
  lin.symm (liftChange (coordinateAut (MulAut.congr modelRowCoordinates a)))

private theorem modelLift_conjugation (a : MulAut Model.row) (x : Model.row) :
    modelLift a * (x : SL) * (modelLift a)⁻¹ = (a x : SL) := by
  apply lin.injective
  rw [map_mul, map_mul, map_inv]
  rw [show lin (modelLift a) = liftChange (coordinateAut (MulAut.congr modelRowCoordinates a))
    from lin.apply_symm_apply _, liftChange_row]
  congr 1
  change (modelRowCoordinates.symm
    (modelRowCoordinates (a (modelRowCoordinates.symm (modelRowCoordinates x)))) : SL) = _
  simp

private theorem modelLift_mem_centralizer (a : MulAut Model.row)
    (ha : a ⟨transvection, subset_closure ⟨4, by decide, rfl⟩⟩ =
      ⟨transvection, subset_closure ⟨4, by decide, rfl⟩⟩) :
    modelLift a ∈ centralizer := by
  apply mem_centralizer_singleton_iff.mpr
  apply mul_inv_eq_iff_eq_mul.mp
  simpa only [ha] using modelLift_conjugation a
    ⟨transvection, subset_closure ⟨4, by decide, rfl⟩⟩

variable {G : Type*} [Group G] {z : G} (F : MarkedCentralizer z)

/-- Every automorphism of the marked row fixing z is induced by an element
of the full point centralizer, with the original ambient conjugation. -/
theorem exists_point_centralizer_row_action (a : MulAut F.row)
    (ha : a ⟨z, point_mem_row F⟩ = ⟨z, point_mem_row F⟩) :
    ∃ g : Subgroup.centralizer ({z} : Set G),
      ∀ x : F.row, (g : G) * (x : G) * (g : G)⁻¹ = (a x : G) := by
  let e := F.pullbackEquiv Model.row Model.row_le_centralizer
  have hez : e ⟨z, point_mem_row F⟩ =
      ⟨transvection, subset_closure ⟨4, by decide, rfl⟩⟩ := by
    apply Subtype.ext
    exact F.on_point
  let b : MulAut Model.row := MulAut.congr e a
  have hb : b ⟨transvection, subset_closure ⟨4, by decide, rfl⟩⟩ =
      ⟨transvection, subset_closure ⟨4, by decide, rfl⟩⟩ := by
    rw [← hez]
    change e (a (e.symm (e ⟨z, point_mem_row F⟩))) = e ⟨z, point_mem_row F⟩
    rw [e.symm_apply_apply, ha]
  let g := F.equiv.symm ⟨modelLift b, modelLift_mem_centralizer b hb⟩
  refine ⟨g, fun x => ?_⟩
  have hx := modelLift_conjugation b (e x)
  have he : g * ⟨x, F.pullback_le Model.row x.property⟩ * g⁻¹ =
      ⟨a x, F.pullback_le Model.row (a x).property⟩ := by
    apply F.equiv.injective
    apply Subtype.ext
    simp only [map_mul, map_inv, Subgroup.coe_mul, Subgroup.coe_inv,
      g, F.equiv.apply_symm_apply]
    change modelLift b * (e x : SL) * (modelLift b)⁻¹ = (e (a x) : SL)
    rw [hx]
    change (e (a (e.symm (e x))) : SL) = _
    rw [e.symm_apply_apply]
  exact congrArg Subtype.val he

/-- The full linear model of the marked row automorphism group. -/
def rowAutLinearEquiv : MulAut F.row ≃* ((Fin 4 → ZMod 2) ≃ₗ[ZMod 2] (Fin 4 → ZMod 2)) :=
  (MulAut.congr (rowCoordinates F)).trans coordinateAut

/-- The coordinates retain evaluation of an automorphism on the same row element. -/
theorem rowAutLinearEquiv_apply (a : MulAut F.row) (x : F.row) :
    rowAutLinearEquiv F a (rowCoordinates F x).toAdd = (rowCoordinates F (a x)).toAdd := by
  change (rowCoordinates F (a ((rowCoordinates F).symm (rowCoordinates F x)))).toAdd = _
  rw [MulEquiv.symm_apply_apply]

private theorem liftChange_mul (f h : Four ≃ₗ[ZMod 2] Four) :
    liftChange (f * h) = liftChange f * liftChange h := by
  apply LinearEquiv.ext
  intro v
  apply headTail.injective
  apply Prod.ext
  · rfl
  · apply (dotProductEquiv (ZMod 2) (Fin 4)).injective
    apply LinearMap.ext
    intro w
    simp [liftChange, dualChange, LinearEquiv.dualMap_apply]
    rfl

private theorem modelLift_mul (a b : MulAut Model.row) :
    modelLift (a * b) = modelLift a * modelLift b := by
  apply lin.injective
  simp only [modelLift, map_mul, MulEquiv.apply_symm_apply, liftChange_mul]

private def rowFixer (F : MarkedCentralizer z) : Subgroup (MulAut F.row) :=
  MulAction.stabilizer (MulAut F.row) (⟨z, point_mem_row F⟩ : F.row)

private def pointRowAction (F : MarkedCentralizer z) :
    Subgroup.centralizer ({z} : Set G) →* rowFixer F where
  toFun g := ⟨F.row.normalizerMonoidHom
      ⟨g, point_centralizer_le_row_normalizer F g.property⟩, by
    apply Subtype.ext
    change (g : G) * z * (g : G)⁻¹ = z
    rw [mem_centralizer_singleton_iff.mp g.property, mul_inv_cancel_right]⟩
  map_one' := by apply Subtype.ext; exact F.row.normalizerMonoidHom.map_one
  map_mul' g h := by
    apply Subtype.ext
    exact F.row.normalizerMonoidHom.map_mul
      ⟨g, point_centralizer_le_row_normalizer F g.property⟩
      ⟨h, point_centralizer_le_row_normalizer F h.property⟩

private def rowFixerLift (F : MarkedCentralizer z) :
    rowFixer F →* Subgroup.centralizer ({z} : Set G) where
  toFun a := F.equiv.symm ⟨modelLift (MulAut.congr
    (F.pullbackEquiv Model.row Model.row_le_centralizer) a), by
      apply modelLift_mem_centralizer
      let e := F.pullbackEquiv Model.row Model.row_le_centralizer
      have hez : e ⟨z, point_mem_row F⟩ =
          ⟨transvection, subset_closure ⟨4, by decide, rfl⟩⟩ := Subtype.ext F.on_point
      rw [← hez]
      change e (a.val (e.symm (e ⟨z, point_mem_row F⟩))) = e ⟨z, point_mem_row F⟩
      rw [e.symm_apply_apply, show a.val ⟨z, point_mem_row F⟩ = _ from a.property]⟩
  map_one' := by
    apply F.equiv.injective
    apply Subtype.ext
    simp only [MulEquiv.apply_symm_apply, Subgroup.coe_one, map_one]
    have hh := (modelLift_mul 1 1).symm
    simpa only [mul_one, mul_eq_left] using hh
  map_mul' a b := by
    apply F.equiv.injective
    apply Subtype.ext
    simp only [map_mul, MulEquiv.apply_symm_apply, Subgroup.coe_mul, modelLift_mul]

private theorem pointRowAction_lift (a : rowFixer F) :
    pointRowAction F (rowFixerLift F a) = a := by
  apply Subtype.ext
  apply MulEquiv.ext
  intro x
  apply Subtype.ext
  let e := F.pullbackEquiv Model.row Model.row_le_centralizer
  have hx := modelLift_conjugation (MulAut.congr e a.val) (e x)
  have he : ((rowFixerLift F a) * ⟨x, F.pullback_le Model.row x.property⟩ *
      (rowFixerLift F a)⁻¹ : Subgroup.centralizer ({z} : Set G)) =
      ⟨a.val x, F.pullback_le Model.row (a.val x).property⟩ := by
    apply F.equiv.injective
    apply Subtype.ext
    simp only [rowFixerLift, MonoidHom.coe_mk, OneHom.coe_mk,
      map_mul, map_inv, Subgroup.coe_mul, Subgroup.coe_inv, MulEquiv.apply_symm_apply]
    change modelLift (MulAut.congr e a.val) * (e x : SL) *
      (modelLift (MulAut.congr e a.val))⁻¹ = (e (a.val x) : SL)
    rw [hx]
    change (e (a.val (e.symm (e x))) : SL) = _
    rw [e.symm_apply_apply]
  exact congrArg (fun q : Subgroup.centralizer ({z} : Set G) => (q : G)) he

private theorem pointRowAction_ker :
    (pointRowAction F).ker = F.row.subgroupOf (Subgroup.centralizer ({z} : Set G)) := by
  ext g
  change pointRowAction F g = 1 ↔ (g : G) ∈ F.row
  conv_rhs => rw [← row_centralizer_eq F, mem_centralizer_iff]
  constructor
  · intro hg x hx
    have hh := congrArg (fun a : rowFixer F => (a.val ⟨x, hx⟩ : G)) hg
    change (g : G) * x * (g : G)⁻¹ = x at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm
  · intro hg
    apply Subtype.ext
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    change (g : G) * (x : G) * (g : G)⁻¹ = (x : G)
    rw [← hg x x.property, mul_inv_cancel_right]

/-- The point centralizer splits over the literal marked row group.
The complement is the inverse-dual block action fixing the distinguished root. -/
theorem point_centralizer_splits_row :
    ∃ K : Subgroup (Subgroup.centralizer ({z} : Set G)),
      (F.row.subgroupOf (Subgroup.centralizer ({z} : Set G))).IsComplement' K := by
  refine ⟨(rowFixerLift F).range, ?_⟩
  rw [← pointRowAction_ker]
  apply isComplement'_of_disjoint_and_mul_eq_univ
  · apply disjoint_def.mpr
    intro x hx hy
    obtain ⟨a, rfl⟩ := hy
    have ha : a = 1 := (pointRowAction_lift F a).symm.trans hx
    rw [ha, map_one]
  · apply Set.eq_univ_iff_forall.mpr
    intro x
    refine ⟨x * (rowFixerLift F (pointRowAction F x))⁻¹, ?_,
      rowFixerLift F (pointRowAction F x), ⟨pointRowAction F x, rfl⟩,
      inv_mul_cancel_right _ _⟩
    change pointRowAction F (x * (rowFixerLift F (pointRowAction F x))⁻¹) = 1
    rw [map_mul, map_inv, pointRowAction_lift, mul_inv_cancel]

private theorem row_aut_pair (p q r s : F.row)
    (hp : p ≠ 1) (hq : q ≠ 1) (hr : r ≠ 1) (hs : s ≠ 1)
    (hpq : p ≠ q) (hrs : r ≠ s) :
    ∃ a : MulAut F.row, a p = r ∧ a q = s := by
  let e := rowCoordinates F
  have hn (x : F.row) (hx : x ≠ 1) : (e x).toAdd ≠ 0 := by
    intro he
    exact hx (e.map_eq_one_iff.mp he)
  obtain ⟨f, hfp, hfq⟩ := BinaryLinear.exists_linearEquiv_pair
    (e p).toAdd (e q).toAdd (e r).toAdd (e s).toAdd
    (hn p hp) (hn q hq) (hn r hr) (hn s hs)
    (fun he => hpq (e.injective he)) (fun he => hrs (e.injective he))
  refine ⟨(rowAutLinearEquiv F).symm f, ?_, ?_⟩
  · apply e.injective
    have hh := rowAutLinearEquiv_apply F ((rowAutLinearEquiv F).symm f) p
    rw [MulEquiv.apply_symm_apply] at hh
    exact hh.symm.trans hfp
  · apply e.injective
    have hh := rowAutLinearEquiv_apply F ((rowAutLinearEquiv F).symm f) q
    rw [MulEquiv.apply_symm_apply] at hh
    exact hh.symm.trans hfq

private theorem row_aut_transitive (p q : F.row) (hp : p ≠ 1) (hq : q ≠ 1) :
    ∃ a : MulAut F.row, a p = q := by
  by_cases he : p = q
  · exact ⟨1, he⟩
  · obtain ⟨a, ha, _⟩ := row_aut_pair F p q q p hp hq hq hp he (Ne.symm he)
    exact ⟨a, ha⟩

/-- The normalizer action is full as soon as it moves the distinguished point.
This is the maximal point-stabilizer argument of source 39.3. -/
theorem row_action_surjective_of_normalizer_ne_centralizer
    (hne : rowNormalizer F ≠ Subgroup.centralizer ({z} : Set G)) :
    Function.Surjective F.row.normalizerMonoidHom := by
  let p : F.row := ⟨z, point_mem_row F⟩
  have hp : p ≠ 1 := by
    intro h
    have hz := F.point_orderOf
    have hz1 : z = 1 := congrArg Subtype.val h
    simp [hz1] at hz
  have hnot : ¬ rowNormalizer F ≤ Subgroup.centralizer ({z} : Set G) :=
    fun h => hne (le_antisymm h (point_centralizer_le_row_normalizer F))
  obtain ⟨g, hgM, hgC⟩ := SetLike.not_le_iff_exists.mp hnot
  let t : rowNormalizer F := ⟨g, hgM⟩
  let b := F.row.normalizerMonoidHom t
  have hbp : b p ≠ p := by
    intro he
    apply hgC
    apply mem_centralizer_singleton_iff.mpr
    apply mul_inv_eq_iff_eq_mul.mp
    exact congrArg Subtype.val he
  have hfix (a : MulAut F.row) (ha : a p = p) : a ∈ F.row.normalizerMonoidHom.range := by
    obtain ⟨h, hh⟩ := exists_point_centralizer_row_action F a ha
    refine ⟨⟨h, point_centralizer_le_row_normalizer F h.property⟩, ?_⟩
    ext x
    exact hh x
  intro a
  by_cases hap : a p = p
  · exact hfix a hap
  · obtain ⟨c, hcp, hcb⟩ := row_aut_pair F p (b p) p (a p) hp
      (fun h => hp (b.map_eq_one_iff.mp h)) hp
      (fun h => hp (a.map_eq_one_iff.mp h)) (Ne.symm hbp) (Ne.symm hap)
    have hc := hfix c hcp
    have hcbR : c * b ∈ F.row.normalizerMonoidHom.range :=
      F.row.normalizerMonoidHom.range.mul_mem hc ⟨t, rfl⟩
    have hd : (c * b)⁻¹ * a ∈ F.row.normalizerMonoidHom.range := hfix _ (by
      change (c * b).symm (a p) = p
      apply (c * b).injective
      exact (c * b).apply_symm_apply (a p) |>.trans hcb.symm)
    have hh : a ∈ F.row.normalizerMonoidHom.range := by
      simpa only [mul_inv_cancel_left] using
        F.row.normalizerMonoidHom.range.mul_mem hcbR hd
    exact hh

/-- The normalizer quotient is the full linear group in the nontrivial case
of source 39.3. Its action was constructed by literal conjugation. -/
def rowQuotientEquivLinear
    (hne : rowNormalizer F ≠ Subgroup.centralizer ({z} : Set G)) :
    rowQuotient F ≃* ((Fin 4 → ZMod 2) ≃ₗ[ZMod 2] (Fin 4 → ZMod 2)) :=
  (MulEquiv.ofBijective (rowQuotientAction F) ⟨rowQuotientAction_injective F, by
    intro a
    obtain ⟨g, hg⟩ := row_action_surjective_of_normalizer_ne_centralizer F hne a
    refine ⟨QuotientGroup.mk g, ?_⟩
    rw [← hg]
    ext x
    exact rowQuotientAction_mk_apply F g x⟩).trans (rowAutLinearEquiv F)

/-- The two possible row-normalizer actions, without any simplicity assumption. -/
theorem row_normalizer_quotient_dichotomy :
    rowNormalizer F = Subgroup.centralizer ({z} : Set G) ∨
      Nonempty (rowQuotient F ≃* ((Fin 4 → ZMod 2) ≃ₗ[ZMod 2] (Fin 4 → ZMod 2))) := by
  by_cases he : rowNormalizer F = Subgroup.centralizer ({z} : Set G)
  · exact Or.inl he
  · exact Or.inr ⟨rowQuotientEquivLinear F he⟩

/-- In the full-action case the point centralizer has index fifteen in the
actual row normalizer. -/
theorem point_centralizer_row_index [Finite G]
    (hne : rowNormalizer F ≠ Subgroup.centralizer ({z} : Set G)) :
    (Subgroup.centralizer ({z} : Set G)).relIndex (rowNormalizer F) = 15 := by
  let p : F.row := ⟨z, point_mem_row F⟩
  have hp : p ≠ 1 := by
    intro h
    have hz := F.point_orderOf
    have hz1 : z = 1 := congrArg Subtype.val h
    simp [hz1] at hz
  have he : (Subgroup.centralizer ({z} : Set G)).subgroupOf (rowNormalizer F) =
      (MulAction.stabilizer (MulAut F.row) p).comap F.row.normalizerMonoidHom := by
    ext g
    change (g : G) ∈ Subgroup.centralizer ({z} : Set G) ↔
      F.row.normalizerMonoidHom g p = p
    rw [Subtype.ext_iff, mem_centralizer_singleton_iff]
    change (g : G) * z = z * (g : G) ↔ (g : G) * z * (g : G)⁻¹ = z
    exact mul_inv_eq_iff_eq_mul.symm
  rw [Subgroup.relIndex, he, Subgroup.index_comap_of_surjective
    _ (row_action_surjective_of_normalizer_ne_centralizer F hne), MulAction.index_stabilizer]
  have ho : MulAction.orbit (MulAut F.row) p = Set.univ \ {1} := by
    ext x
    simp only [MulAction.mem_orbit_iff, Set.mem_sdiff, Set.mem_univ,
      Set.mem_singleton_iff, true_and]
    constructor
    · rintro ⟨a, rfl⟩ he
      exact hp (a.map_eq_one_iff.mp he)
    · exact row_aut_transitive F p x hp
  rw [ho, Set.ncard_sdiff (Set.subset_univ _), Set.ncard_univ, Set.ncard_singleton, row_card]

private theorem complement_comap {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) (V K : Subgroup B) (h : V.IsComplement' K) :
    (V.comap e.toMonoidHom).IsComplement' (K.comap e.toMonoidHom) := by
  apply isComplement'_of_disjoint_and_mul_eq_univ
  · apply disjoint_def.mpr
    intro x hx hk
    apply e.injective
    exact (disjoint_def.mp h.disjoint hx hk).trans e.map_one.symm
  · apply Set.eq_univ_iff_forall.mpr
    intro x
    obtain ⟨⟨v, k⟩, hvk⟩ := h.2 (e x)
    refine ⟨e.symm v, ?_, e.symm k, ?_, ?_⟩
    · change e (e.symm v) ∈ V
      rw [e.apply_symm_apply]
      exact v.property
    · change e (e.symm k) ∈ K
      rw [e.apply_symm_apply]
      exact k.property
    · apply e.injective
      simpa only [map_mul, e.apply_symm_apply] using hvk

/-- The splitting in source 39.3 holds in the literal normalizer. The index
is one or fifteen, so Gaschütz transfers the proved point-centralizer split. -/
theorem row_normalizer_splits [Finite G] :
    ∃ K : Subgroup (rowNormalizer F),
      (F.row.subgroupOf (rowNormalizer F)).IsComplement' K := by
  let M := rowNormalizer F
  let C := Subgroup.centralizer ({z} : Set G)
  let H := C.subgroupOf M
  let E := F.row.subgroupOf M
  let eH : H ≃* C := subgroupOfEquivOfLe (point_centralizer_le_row_normalizer F)
  let eE : E ≃* F.row := subgroupOfEquivOfLe le_normalizer
  let coords := eE.trans (rowCoordinates F)
  let : IsMulCommutative E := ⟨⟨fun x y => coords.injective (by
    simp only [map_mul, mul_comm])⟩⟩
  have hEH : E ≤ H := fun x hx => F.pullback_le Model.row hx
  have hcard : Nat.card E = 16 := (Nat.card_congr eE.toEquiv).trans (row_card F)
  have hi : H.index = 1 ∨ H.index = 15 := by
    by_cases he : M = C
    · left
      change (C.subgroupOf M).index = 1
      rw [he, subgroupOf_self, index_top]
    · exact Or.inr (point_centralizer_row_index F he)
  apply exists_complement_of_coprime_overgroup E H hEH
  · rw [hcard]
    rcases hi with hi | hi <;> rw [hi] <;> decide
  · obtain ⟨K, hK⟩ := point_centralizer_splits_row F
    exact ⟨K.comap eH.toMonoidHom,
      complement_comap eH (F.row.subgroupOf C) K hK⟩

/-- Full source 39.3 for the marked row: either its normalizer is the point
centralizer, or its literal quotient has full faithful binary four-space action
and the extension splits. No simplicity of a generated subgroup is used. -/
theorem row_normalizer_structure [Finite G] :
    rowNormalizer F = Subgroup.centralizer ({z} : Set G) ∨
      (Nonempty (rowQuotient F ≃* ((Fin 4 → ZMod 2) ≃ₗ[ZMod 2] (Fin 4 → ZMod 2))) ∧
        ∃ K : Subgroup (rowNormalizer F),
          (F.row.subgroupOf (rowNormalizer F)).IsComplement' K) := by
  rcases row_normalizer_quotient_dichotomy F with he | he
  · exact Or.inl he
  · exact Or.inr ⟨he, row_normalizer_splits F⟩
end Theory.GroupTheory.TransvectionFive.UniquenessLinear
