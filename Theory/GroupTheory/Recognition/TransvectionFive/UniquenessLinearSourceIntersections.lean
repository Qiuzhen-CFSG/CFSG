module
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourceRectangles
public import Theory.GroupTheory.Recognition.TransvectionFive.UniquenessLinearSourceColumn
public import Theory.GroupTheory.CharacteristicCentralizerFusion
import Mathlib.Tactic.FinCases

/-!
# Centralizers and normalizers of the marked row-plane intersections

Commuting with the three roots in the row-plane intersection forces a matrix
into the seven-root group generated by the row and plane. Squaring such a
matrix shows that each involution lies in one of those two elementary groups.
Every elementary subgroup of the centralizer therefore lies in one of them.

Transport these calculations through the full point-centralizer marking.
An intersection normalizer preserves its centralizer and its elementary
subgroups. The plane has order 64 and the row order 16, so the plane cannot
map into the row. Since the row is not contained in the plane, it too is
preserved. The opposite marking proves the corresponding assertions for the
column and three-space, retaining the literal ambient subgroups throughout.

These prove Aschbacher, *Sporadic Groups* (1994), 39.1(8) and 39.6(4),
printed pp.213–215. The normalizer equality supplies the intersection step
used in the last paragraph of 40.3, p.218. Point movement in that normalizer,
the full normalizer identification, and the §41 source comparison remain
separate obligations; no simplicity of a generated subgroup is assumed.
-/

public noncomputable section
open Subgroup BinaryLinear.TransvectionFiveLocal
namespace Theory.GroupTheory.TransvectionFive.UniquenessLinear
open Theory.SpecificGroups.LinearSylowNormalizers
private theorem root_commuting_row (g : SL) (i j : Fin 5) (hij : i < j)
    (hg : root hij * g = g * root hij) (k : Fin 5) :
    g j k = if k = j then g i i else 0 := by
  have he := congrArg (fun a : SL => a i k) hg
  change ((1 + Matrix.single i j 1) * g.val : Matrix (Fin 5) (Fin 5) (ZMod 2)) i k = (g.val * (1 + Matrix.single i j 1) : Matrix (Fin 5) (Fin 5) (ZMod 2)) i k at he
  by_cases hk : k = j
  · subst k
    simpa only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
      Matrix.add_apply, Matrix.single_mul_apply_same, Matrix.mul_single_apply_same,
      one_mul, mul_one, add_right_inj, ite_true] using he
  · simpa only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
      Matrix.add_apply, Matrix.single_mul_apply_same, Matrix.mul_single_apply_of_ne _ _ _ _ _ hk,
      one_mul, add_zero, add_eq_left, if_neg hk] using he

private theorem root_commuting_column (g : SL) (i j : Fin 5) (hij : i < j)
    (hg : root hij * g = g * root hij) (k : Fin 5) :
    g k i = if k = i then g j j else 0 := by
  have he := congrArg (fun a : SL => a k j) hg
  change ((1 + Matrix.single i j 1) * g.val : Matrix (Fin 5) (Fin 5) (ZMod 2)) k j = (g.val * (1 + Matrix.single i j 1) : Matrix (Fin 5) (Fin 5) (ZMod 2)) k j at he
  by_cases hk : k = i
  · subst k
    simpa only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
      Matrix.add_apply, Matrix.single_mul_apply_same, Matrix.mul_single_apply_same,
      one_mul, mul_one, add_right_inj, ite_true] using he.symm
  · simpa only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
      Matrix.add_apply, Matrix.mul_single_apply_same, Matrix.single_mul_apply_of_ne _ _ _ _ _ hk,
      mul_one, add_zero, add_eq_left, if_neg hk] using he.symm


private theorem row_mem_iff (g : SL) : g ∈ Model.row ↔
    ∀ i j : Fin 5, ¬ (i = 0 ∧ 0 < j) → g i j = if i = j then 1 else 0 := by
  constructor
  · intro hg i j hij
    rw [modelRowCoordinates_matrix ⟨g, hg⟩]
    fin_cases i <;> fin_cases j <;> simp_all [Matrix.single]
  · intro hg
    let v : Multiplicative (Fin 4 → ZMod 2) := Multiplicative.ofAdd (fun i => g 0 i.succ)
    have he : g = (modelRowCoordinates.symm v : SL) := by
      apply Subtype.ext
      rw [modelRowCoordinates_matrix, modelRowCoordinates.apply_symm_apply]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [Matrix.single, v]
      all_goals exact hg _ _ (by decide)
    rw [he]
    exact (modelRowCoordinates.symm v).property

private theorem row_plane_centralizer_shape (g : SL)
    (hg : g ∈ Subgroup.centralizer ((Model.row ⊓ Model.plane : Subgroup SL) : Set SL)) :
    ∀ i j : Fin 5, ¬ (i < j ∧ i.val < 2) → g i j = if i = j then 1 else 0 := by
  have hr (j : Fin 5) (hj : 2 ≤ j.val) : root (show 0 < j from by omega) * g =
      g * root (show 0 < j from by omega) :=
    mem_centralizer_iff.mp hg _ ⟨subset_closure ⟨j, by omega, rfl⟩,
      subset_closure ⟨0, j, by omega, by decide, hj, rfl⟩⟩
  have hc (k : Fin 5) : g k 0 = if k = 0 then g 4 4 else 0 :=
    root_commuting_column g 0 4 (by decide) (hr 4 (by decide)) k
  have h44 : g 4 4 = 1 := by
    have hn : g 4 4 ≠ 0 := by
      intro he
      apply g.det_ne_zero
      apply Matrix.det_eq_zero_of_column_eq_zero 0
      intro k
      simp [hc k, he]
    exact (by decide : ∀ a : ZMod 2, a ≠ 0 → a = 1) _ hn
  have h00 : g 0 0 = 1 := by simpa [h44] using hc 0
  have hrow (i j : Fin 5) (hi : 2 ≤ i.val) :
      g i j = if i = j then 1 else 0 := by
    rw [root_commuting_row g 0 i (by omega) (hr i hi), h00]
    simp only [eq_comm]
  have htri : g.val.IsUpperTriangular := by
    intro i j hij
    change j < i at hij
    by_cases hj : j = 0
    · subst j; simpa [ne_of_gt hij, h44] using hc i
    · exact (hrow i j (by omega)).trans (if_neg (ne_of_gt hij))
  have hd (i : Fin 5) : g i i = 1 := by
    have hdet := g.property
    rw [Matrix.det_of_isUpperTriangular htri] at hdet
    have hn : g i i ≠ 0 := Finset.prod_ne_zero_iff.mp
      (show (∏ j, g j j) ≠ 0 by rw [hdet]; exact one_ne_zero) i (Finset.mem_univ i)
    exact (by decide : ∀ a : ZMod 2, a ≠ 0 → a = 1) _ hn
  intro i j hij
  by_cases he : i = j
  · subst j; simpa using hd i
  · by_cases hji : j < i
    · simpa [he] using htri hji
    · exact hrow i j (by omega)

private theorem row_plane_centralizer_square (g : SL)
    (hg : g ∈ Subgroup.centralizer ((Model.row ⊓ Model.plane : Subgroup SL) : Set SL))
    (hsq : g ^ 2 = 1) : g ∈ Model.row ∨ g ∈ Model.plane := by
  have hshape := row_plane_centralizer_shape g hg
  by_cases h01 : g 0 1 = 0
  · right
    apply (RectangleCoordinates.mem2_iff g).mpr
    intro i j hij
    by_cases hs : ¬ (i < j ∧ i.val < 2)
    · exact hshape i j hs
    · have hi : i = 0 := by omega
      have hj : j = 1 := by omega
      subst i; subst j
      exact h01
  · left
    have h1 (j : Fin 5) (hj : 2 ≤ j.val) : g 1 j = 0 := by
      have he := congrArg (fun a : SL => a 0 j) (show g * g = 1 by simpa only [pow_two] using hsq)
      change (g.val * g.val) 0 j = (1 : Matrix (Fin 5) (Fin 5) (ZMod 2)) 0 j at he
      have hz : g 0 1 * g 1 j = 0 := by
        fin_cases j <;> norm_num at hj
        all_goals simp [Matrix.mul_apply, Fin.sum_univ_succ, hshape] at he
        all_goals linear_combination (norm := (ring_nf; simp [show (2 : ZMod 2) = 0 from rfl])) he
      exact (mul_eq_zero.mp hz).resolve_left h01
    apply (row_mem_iff g).mpr
    intro i j hij
    by_cases hs : ¬ (i < j ∧ i.val < 2)
    · exact hshape i j hs
    · have hi : i = 1 := by omega
      subst i
      simpa [show (1 : Fin 5) ≠ j by omega] using h1 j (by omega)

private theorem row_plane_centralizer_eq :
    Subgroup.centralizer ((Model.row ⊓ Model.plane : Subgroup SL) : Set SL) =
      Model.row ⊔ Model.plane := by
  apply le_antisymm
  · intro g hg
    have hs := row_plane_centralizer_shape g hg
    let r : SL := Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 5) ≠ 1) (g 0 1)
    have hr : r ∈ Model.row := by
      rcases (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) (g 0 1) with h | h
      · simp [r, h]
      · change Matrix.SpecialLinearGroup.transvection _ (g 0 1) ∈ Model.row
        rw [h]
        exact subset_closure ⟨1, by decide, rfl⟩
    have hgr : g * r ∈ Model.plane := by
      apply (RectangleCoordinates.mem2_iff _).mpr
      intro i j hij
      change (g.val * (1 + Matrix.single 0 1 (g 0 1)) : Matrix (Fin 5) (Fin 5) (ZMod 2)) i j = _
      simp only [Matrix.mul_add, Matrix.mul_one, Matrix.add_apply]
      by_cases hj : j = 1
      · subst j
        rw [Matrix.mul_single_apply_same]
        fin_cases i <;> simp [hs]
        exact CharTwo.add_self_eq_zero _
      · rw [Matrix.mul_single_apply_of_ne _ _ _ _ _ hj, add_zero]
        exact hs i j (by omega)
    have hm := (Model.row ⊔ Model.plane).mul_mem ((show Model.plane ≤ Model.row ⊔ Model.plane from le_sup_right) hgr)
      ((show Model.row ≤ Model.row ⊔ Model.plane from le_sup_left) (Model.row.inv_mem hr))
    simpa only [mul_inv_cancel_right] using hm
  · apply sup_le
    · have hc : Model.row ≤ Subgroup.centralizer (Model.row : Set SL) := by
        apply le_centralizer_iff_isMulCommutative.mpr
        exact ⟨⟨fun x y => modelRowCoordinates.injective (by simp only [map_mul, mul_comm])⟩⟩
      exact hc.trans (centralizer_le inf_le_left)
    · let := model_rectangle_commutative 2
      exact Model.plane.le_centralizer.trans (centralizer_le inf_le_right)

variable {G : Type*} [Group G] {z : G} (F : MarkedCentralizer z)

private theorem pullback_inf (A B : Subgroup SL) :
    F.pullback (A ⊓ B) = F.pullback A ⊓ F.pullback B := by
  simp only [MarkedCentralizer.pullback, subgroupOf, comap_inf,
    map_inf _ _ F.equiv.symm.toMonoidHom F.equiv.symm.injective,
    map_inf _ _ (Subgroup.centralizer ({z} : Set G)).subtype (Subgroup.centralizer ({z} : Set G)).subtype_injective]

private theorem pullback_sup (A B : Subgroup SL) (hA : A ≤ centralizer) (hB : B ≤ centralizer) :
    F.pullback (A ⊔ B) = F.pullback A ⊔ F.pullback B := by
  simp only [MarkedCentralizer.pullback, subgroupOf_sup hA hB, Subgroup.map_sup]

private theorem pullback_centralizer (A : Subgroup SL) (hA : A ≤ centralizer)
    (hz : transvection ∈ A) :
    F.pullback (Subgroup.centralizer (A : Set SL)) =
      Subgroup.centralizer (F.pullback A : Set G) := by
  have hzG : z ∈ F.pullback A := point_mem_pullback F A hz
  ext x
  constructor
  · intro hx
    have hxC := F.pullback_le _ hx
    have hxM := (F.mem_pullback_iff _ ⟨x, hxC⟩).mp hx
    apply mem_centralizer_iff.mpr
    intro y hy
    have hyC := F.pullback_le A hy
    have he : F.equiv ⟨y, hyC⟩ * F.equiv ⟨x, hxC⟩ =
        F.equiv ⟨x, hxC⟩ * F.equiv ⟨y, hyC⟩ :=
      Subtype.ext (mem_centralizer_iff.mp hxM _ ((F.mem_pullback_iff A ⟨y, hyC⟩).mp hy))
    have heG : (⟨y, hyC⟩ : Subgroup.centralizer ({z} : Set G)) * ⟨x, hxC⟩ =
        ⟨x, hxC⟩ * ⟨y, hyC⟩ := F.equiv.injective (by simpa only [map_mul] using he)
    exact congrArg Subtype.val heG
  · intro hx
    have hxC : x ∈ Subgroup.centralizer ({z} : Set G) :=
      mem_centralizer_singleton_iff.mpr (mem_centralizer_iff.mp hx z hzG).symm
    apply (F.mem_pullback_iff _ ⟨x, hxC⟩).mpr
    apply mem_centralizer_iff.mpr
    intro a ha
    change a ∈ A at ha
    let b := F.equiv.symm ⟨a, hA ha⟩
    have hb : (b : G) ∈ F.pullback A := by
      apply (F.mem_pullback_iff A b).mpr
      simpa only [b, F.equiv.apply_symm_apply] using ha
    have he : b * ⟨x, hxC⟩ = ⟨x, hxC⟩ * b :=
      Subtype.ext (mem_centralizer_iff.mp hx b hb)
    have he' := congrArg (fun q => (F.equiv q : SL)) he
    simpa only [map_mul, Subgroup.coe_mul, b, F.equiv.apply_symm_apply] using he'

/-- The full centralizer of the marked intersection is the join of the two
original subgroups, as in 39.1(8). -/
theorem source_row_plane_centralizer :
    Subgroup.centralizer ((F.row ⊓ F.plane : Subgroup G) : Set G) = F.row ⊔ F.plane := by
  rw [← pullback_inf F, ← pullback_centralizer F _ (inf_le_left.trans Model.row_le_centralizer)
    (show transvection ∈ Model.row ⊓ Model.plane from
      ⟨subset_closure ⟨4, by decide, rfl⟩, subset_closure ⟨0, 4, by decide, by decide, by decide, rfl⟩⟩),
    row_plane_centralizer_eq, pullback_sup F _ _ Model.row_le_centralizer Model.plane_le_centralizer]

/-- Every element squaring to one in the intersection centralizer lies in
one of the two marked elementary groups. -/
theorem source_row_plane_centralizer_square (x : G)
    (hx : x ∈ Subgroup.centralizer ((F.row ⊓ F.plane : Subgroup G) : Set G))
    (hsq : x ^ 2 = 1) : x ∈ F.row ∨ x ∈ F.plane := by
  have hxC : x ∈ Subgroup.centralizer ({z} : Set G) :=
    mem_centralizer_singleton_iff.mpr
      (mem_centralizer_iff.mp hx z ⟨point_mem_row F, point_mem_plane F⟩).symm
  rw [← pullback_inf F, ← pullback_centralizer F _ (inf_le_left.trans Model.row_le_centralizer)
    (show transvection ∈ Model.row ⊓ Model.plane from
      ⟨subset_closure ⟨4, by decide, rfl⟩, subset_closure ⟨0, 4, by decide, by decide, by decide, rfl⟩⟩)] at hx
  have hs : (F.equiv ⟨x, hxC⟩ : SL) ^ 2 = 1 := by
    have he := congrArg (fun a => (F.equiv a : SL))
      (show (⟨x, hxC⟩ : Subgroup.centralizer ({z} : Set G)) ^ 2 = 1 from Subtype.ext hsq)
    simpa only [map_pow, map_one, Subgroup.coe_pow, Subgroup.coe_one] using he
  exact (row_plane_centralizer_square _ ((F.mem_pullback_iff _ ⟨x, hxC⟩).mp hx) hs).imp
    ((F.mem_pullback_iff Model.row ⟨x, hxC⟩).mpr) ((F.mem_pullback_iff Model.plane ⟨x, hxC⟩).mpr)

/-- The original row is elementary abelian in its marked binary coordinates. -/
theorem source_row_elementary : IsElementaryAbelian 2 F.row where
  toIsMulCommutative := ⟨⟨fun x y => (rowCoordinates F).injective
    (by simp only [map_mul, mul_comm])⟩⟩
  exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun x => by
    apply (rowCoordinates F).injective
    rw [map_pow, map_one]
    apply Multiplicative.toAdd.injective
    change (2 : ℕ) • (rowCoordinates F x).toAdd = 0
    rw [two_nsmul]
    funext i
    exact CharTwo.add_self_eq_zero _)

/-- Every elementary subgroup of the intersection centralizer lies in one
of its two specified maximal elementary subgroups, source 39.1(8). -/
theorem source_row_plane_elementary_le (E : Subgroup G) [IsElementaryAbelian 2 E]
    (hE : E ≤ Subgroup.centralizer ((F.row ⊓ F.plane : Subgroup G) : Set G)) :
    E ≤ F.row ∨ E ≤ F.plane := by
  apply SubgroupClass.subset_union.mp
  intro x hx
  apply source_row_plane_centralizer_square F x (hE hx)
  exact congrArg Subtype.val (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
    (IsElementaryAbelian.exponent_dvd_p 2 E) ⟨x, hx⟩)

private theorem row_not_le_plane : ¬ F.row ≤ F.plane := by
  let a : SL := root (show (0 : Fin 5) < 1 by decide)
  have ha : a ∈ Model.row := subset_closure ⟨1, by decide, rfl⟩
  let x := F.equiv.symm ⟨a, Model.row_le_centralizer ha⟩
  have hx : (x : G) ∈ F.row := (F.mem_pullback_iff Model.row x).mpr (by
    simpa only [x, F.equiv.apply_symm_apply] using ha)
  intro h
  have hxA := (F.mem_pullback_iff Model.plane x).mp (h hx)
  have hm : a ∈ Model.plane := by simpa only [x, F.equiv.apply_symm_apply] using hxA
  have he := (RectangleCoordinates.mem2_iff a).mp hm 0 1 (by decide)
  norm_num [a, root, Matrix.SpecialLinearGroup.transvection_coe, Matrix.single, Matrix.one_apply] at he

private theorem conjugate_le_intersection_centralizer {E : Subgroup G}
    (hE : E ≤ Subgroup.centralizer ((F.row ⊓ F.plane : Subgroup G) : Set G))
    {g : G} (hg : g ∈ normalizer ((F.row ⊓ F.plane : Subgroup G) : Set G)) :
    E.map (MulAut.conj g).toMonoidHom ≤
      Subgroup.centralizer ((F.row ⊓ F.plane : Subgroup G) : Set G) := by
  have hn := normalizer_le_normalizer_centralizer (F.row ⊓ F.plane) hg
  rintro _ ⟨a, ha, rfl⟩
  exact (mem_normalizer_iff.mp hn a).mp (hE ha)

/-- The intersection normalizer preserves the original plane; this is ambient
normalization, not normalization merely inside the point centralizer. -/
theorem source_row_plane_normalizer_le_plane [Finite G] :
    normalizer ((F.row ⊓ F.plane : Subgroup G) : Set G) ≤ normalizer (F.plane : Set G) := by
  intro g hg
  let := marked_rectangle_elementary F 2
  let := IsElementaryAbelian.map (p := 2) (A := F.plane) (MulAut.conj g).toMonoidHom
  have hAC : F.plane ≤ Subgroup.centralizer ((F.row ⊓ F.plane : Subgroup G) : Set G) := by
    rw [source_row_plane_centralizer]
    exact le_sup_right
  have he := source_row_plane_elementary_le F _ (conjugate_le_intersection_centralizer F hAC hg)
  have hle : F.plane.map (MulAut.conj g).toMonoidHom ≤ F.plane := by
    rcases he with he | he
    · have hc := Subgroup.card_le_of_le he
      rw [card_map_of_injective (MulAut.conj g).injective, source_plane_card, row_card] at hc
      omega
    · exact he
  apply mem_normalizer_iff_map_conj_eq.mpr
  exact eq_of_le_of_card_ge hle (by rw [card_map_of_injective (MulAut.conj g).injective])

/-- Source 39.6(4), retaining both original intersection factors. -/
theorem source_row_plane_normalizer [Finite G] :
    normalizer ((F.row ⊓ F.plane : Subgroup G) : Set G) =
      normalizer (F.row : Set G) ⊓ normalizer (F.plane : Set G) := by
  apply le_antisymm ?_ inf_normalizer_le_normalizer_inf
  intro g hg
  have hgA := source_row_plane_normalizer_le_plane F hg
  refine ⟨?_, hgA⟩
  let := source_row_elementary F
  let := IsElementaryAbelian.map (p := 2) (A := F.row) (MulAut.conj g).toMonoidHom
  have hUC : F.row ≤ Subgroup.centralizer ((F.row ⊓ F.plane : Subgroup G) : Set G) := by
    rw [source_row_plane_centralizer]
    exact le_sup_left
  have he := source_row_plane_elementary_le F _ (conjugate_le_intersection_centralizer F hUC hg)
  have hle : F.row.map (MulAut.conj g).toMonoidHom ≤ F.row := by
    rcases he with he | he
    · exact he
    · exfalso
      apply row_not_le_plane F
      intro a ha
      exact (mem_normalizer_iff.mp hgA a).mpr (he (mem_map_of_mem _ ha))
  exact mem_normalizer_iff_map_conj_eq.mpr
    (eq_of_le_of_card_ge hle (by rw [card_map_of_injective (MulAut.conj g).injective]))

/-- The opposite intersection has the same full centralizer calculation. -/
theorem source_column_threeSpace_centralizer :
    Subgroup.centralizer ((F.column ⊓ F.threeSpace : Subgroup G) : Set G) =
      F.column ⊔ F.threeSpace := by
  simpa only [oppositeMarking_row, oppositeMarking_plane] using
    source_row_plane_centralizer (oppositeMarking F)

/-- The involution description is preserved by the original opposite marking. -/
theorem source_column_threeSpace_centralizer_square (x : G)
    (hx : x ∈ Subgroup.centralizer ((F.column ⊓ F.threeSpace : Subgroup G) : Set G))
    (hsq : x ^ 2 = 1) : x ∈ F.column ∨ x ∈ F.threeSpace := by
  apply (source_row_plane_centralizer_square (oppositeMarking F) x _ hsq).imp
    (fun h => by simpa only [oppositeMarking_row] using h)
    (fun h => by simpa only [oppositeMarking_plane] using h)
  simpa only [oppositeMarking_row, oppositeMarking_plane] using hx

/-- Source 39.6(4) at the opposite end of the same marked flag. -/
theorem source_column_threeSpace_normalizer [Finite G] :
    normalizer ((F.column ⊓ F.threeSpace : Subgroup G) : Set G) =
      normalizer (F.column : Set G) ⊓ normalizer (F.threeSpace : Set G) := by
  simpa only [oppositeMarking_row, oppositeMarking_plane] using
    source_row_plane_normalizer (oppositeMarking F)

end Theory.GroupTheory.TransvectionFive.UniquenessLinear
