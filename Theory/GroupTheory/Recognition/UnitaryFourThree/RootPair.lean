module
public import Theory.GroupTheory.Recognition.UnitaryFourThree.Orbit
public import Theory.GroupTheory.PGroup.ExtraspecialNormalizedFour
public import Theory.ElementaryAbelian.Join
public import Theory.GroupTheory.SylowCentralizerConjugacy
public import Theory.GroupTheory.SubgroupProductCard
public import Theory.GroupTheory.NormalizingInvolutionCard

/-!
# The marked binary root pair in the U₄(3) recognition configuration

The literal order-four intersection is normalized by the involution centralizer
in the original extraspecial core. The normalized-four lemma forces the original
central involution into the conjugate core. Thus the intersection is exactly
the four generated by the two marked involutions. Their centralizers each have
order sixteen, normalize one another, and form the actual product of order 64.

No root-group model or mutual-containment premise is supplied. All conjugation
uses the source right-conjugation convention. Source: Aschbacher, *Sporadic
Groups* (1994), Lemmas 8.15 and 45.3, printed pp. 29–30 and 242–243.
-/

@[expose] public section
open Subgroup
open scoped Pointwise
namespace Theory.GroupTheory.Recognition.UnitaryFourThree
variable {G : Type*} [Group G] [Finite G] {z : G}
structure RootPair (z : G) where
  g : G
  mem_core : g⁻¹ * z * g ∈ core z
  not_mem_line : g⁻¹ * z * g ∉ zpowers z

omit [Finite G] in
theorem IsType.exists_rootPair (h : IsType z) : Nonempty (RootPair z) := by
  obtain ⟨g,hg,hgz⟩ := h.fused
  exact ⟨⟨g,hg,hgz⟩⟩
namespace RootPair
variable (P : RootPair z)
def u : G := P.g⁻¹ * z * P.g
def E : Subgroup G := zpowers z ⊔ zpowers P.u
def conjugateCore : Subgroup G := conjugate (core z) P.g
def leftCore : Subgroup G := core z ⊓ centralizer P.u
def rightCore : Subgroup G := P.conjugateCore ⊓ centralizer z
def R : Subgroup G := P.leftCore ⊔ P.rightCore

omit [Finite G] in
theorem core_le_centralizer : core z ≤ centralizer z :=
  (pCoreIn_le 2 (residual z)).trans (map_subtype_le _)
omit [Finite G] in
theorem u_order (h : IsType z) : orderOf P.u = 2 :=
  by simpa only [u,MulAut.conj_apply,inv_inv] using
    ((MulAut.conj P.g⁻¹).orderOf_eq z).trans h.involution
omit [Finite G] in
theorem u_ne_z : P.u ≠ z := by
  intro he
  apply P.not_mem_line
  change P.u ∈ zpowers z
  rw [he]
  exact mem_zpowers z
omit [Finite G] in
theorem commute : Commute z P.u :=
  (mem_centralizer_singleton_iff.mp (core_le_centralizer P.mem_core)).symm
theorem z_mem_core (h : IsType z) : z ∈ core z := h.toCentralizerHypothesis.line_le_core (mem_zpowers z)
theorem E_le_core (h : IsType z) : P.E ≤ core z :=
  sup_le h.toCentralizerHypothesis.line_le_core (zpowers_le.mpr P.mem_core)
omit [Finite G] in
theorem z_mem_E : z ∈ P.E := mem_sup_left (mem_zpowers z)
omit [Finite G] in
theorem u_mem_E : P.u ∈ P.E := mem_sup_right (mem_zpowers P.u)
omit [Finite G] in
theorem E_card (h : IsType z) : Nat.card P.E = 4 := by
  have hn : P.u ∈ normalizer (zpowers z : Set G) := by
    apply Subgroup.centralizer_le_normalizer
    intro x hx
    obtain ⟨n,rfl⟩ := mem_zpowers_iff.mp hx
    exact (P.commute.zpow_left n).eq
  rw [E, card_sup_zpowers_of_normalizing_involution _ _
    (P.u_order h ▸ pow_orderOf_eq_one P.u) (show P.u ∉ zpowers z from P.not_mem_line) hn,
    Nat.card_zpowers,h.involution]
omit [Finite G] in
theorem E_elementary (h : IsType z) : IsElementaryAbelian 2 P.E := by
  let : IsElementaryAbelian 2 (zpowers z) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one (h.involution ▸ pow_orderOf_eq_one z)
  let : IsElementaryAbelian 2 (zpowers P.u) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one (P.u_order h ▸ pow_orderOf_eq_one P.u)
  apply IsElementaryAbelian.sup_of_le_centralizer
  apply zpowers_le.mpr
  intro x hx
  obtain ⟨n,rfl⟩ := mem_zpowers_iff.mp hx
  exact (P.commute.zpow_left n).eq

omit [Finite G] in
theorem conjugateCore_le : P.conjugateCore ≤ centralizer P.u := by
  rintro _ ⟨q,hq,rfl⟩
  apply mem_centralizer_singleton_iff.mpr
  simpa only [MulAut.conj_apply,inv_inv,u,MulEquiv.coe_toMonoidHom] using
    (map_mul (MulAut.conj P.g⁻¹) q z).symm.trans
    ((congrArg (MulAut.conj P.g⁻¹)
      (mem_centralizer_singleton_iff.mp (core_le_centralizer hq))).trans
      (map_mul (MulAut.conj P.g⁻¹) z q))
omit [Finite G] in
theorem conjugate_centralizer :
    (centralizer z).map (MulAut.conj P.g⁻¹).toMonoidHom = centralizer P.u := by
  let e := MulAut.conj P.g⁻¹
  apply le_antisymm
  · simpa only [Set.image_singleton,MulEquiv.coe_toMonoidHom,e,u,MulAut.conj_apply,inv_inv,centralizer]
      using map_centralizer_le_centralizer_image ({z} : Set G) e.toMonoidHom
  · intro x hx
    refine mem_map.mpr ⟨e.symm x, ?_,e.apply_symm_apply x⟩
    apply mem_centralizer_singleton_iff.mpr
    apply e.injective
    simpa only [map_mul,e.apply_symm_apply,e,u,MulAut.conj_apply,inv_inv]
      using mem_centralizer_singleton_iff.mp hx
theorem normalizer_conjugateCore (h : IsType z) : normalizer (P.conjugateCore : Set G) = centralizer P.u := by
  rw [conjugateCore,conjugate,← map_equiv_normalizer_eq,h.toCentralizerHypothesis.normalizer_core]
  exact P.conjugate_centralizer

theorem leftCore_normalizes_intersection (h : IsType z) :
    P.leftCore ≤ normalizer (core z ⊓ P.conjugateCore : Set G) := by
  apply le_trans _ inf_normalizer_le_normalizer_inf
  apply le_inf
  · exact inf_le_left.trans (core z).le_normalizer
  · rw [P.normalizer_conjugateCore h]
    exact inf_le_right

/-- The original involution belongs to the returning conjugate core. -/
theorem z_mem_conjugateCore (h : IsType z) : z ∈ P.conjugateCore := by
  let Q := core z
  let Z : Q := ⟨z,z_mem_core h⟩
  let U : Q := ⟨P.u,P.mem_core⟩
  let V := (Q ⊓ P.conjugateCore).subgroupOf Q
  let : IsExtraspecial 2 Q := h.toCentralizerHypothesis.core_extraspecial
  have hZ : Z ∈ center Q := mem_center_iff.mpr (fun q =>
    Subtype.ext (mem_centralizer_singleton_iff.mp (core_le_centralizer q.property)))
  have hvcard : Nat.card V = 4 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe inf_le_left).toEquiv]
    exact h.intersection_card P.g P.mem_core P.not_mem_line
  have hn : Subgroup.centralizer ({U} : Set Q) ≤ normalizer (V : Set Q) := by
    intro c hc
    apply Subgroup.le_normalizer_comap Q.subtype
    apply P.leftCore_normalizes_intersection h
    exact ⟨c.property,mem_centralizer_singleton_iff.mpr
      (congrArg Subtype.val (mem_centralizer_singleton_iff.mp hc))⟩
  have hzV := IsExtraspecial.involution_mem_normalized_four Z U
    ((orderOf_coe Z).symm.trans h.involution) hZ
    ((orderOf_coe U).symm.trans (P.u_order h))
    (fun he => P.u_ne_z (congrArg Subtype.val he)) V hvcard hn
  exact hzV.2

theorem u_mem_conjugateCore (h : IsType z) : P.u ∈ P.conjugateCore := by
  simpa only [u,conjugateCore,conjugate,MulAut.conj_apply,inv_inv,MulEquiv.coe_toMonoidHom] using
    mem_map_of_mem (MulAut.conj P.g⁻¹).toMonoidHom (z_mem_core h)
theorem E_le_conjugateCore (h : IsType z) : P.E ≤ P.conjugateCore :=
  sup_le (zpowers_le.mpr (P.z_mem_conjugateCore h))
    (zpowers_le.mpr (P.u_mem_conjugateCore h))
theorem core_intersection (h : IsType z) : core z ⊓ P.conjugateCore = P.E := by
  symm
  apply eq_of_le_of_card_ge (le_inf (P.E_le_core h) (P.E_le_conjugateCore h))
  rw [P.E_card h]
  exact (h.intersection_card P.g P.mem_core P.not_mem_line).le

theorem R_coe (h : IsType z) : (P.R : Set G) = (P.leftCore : Set G) * (P.rightCore : Set G) := by
  apply coe_mul_of_left_le_normalizer_right
  apply le_trans _ inf_normalizer_le_normalizer_inf
  apply le_inf
  · rw [P.normalizer_conjugateCore h]
    exact inf_le_right
  · exact (inf_le_left.trans core_le_centralizer).trans le_normalizer

omit [Finite G] in
theorem R_le_double_centralizer : P.R ≤ centralizer z ⊓ centralizer P.u :=
  sup_le (le_inf (inf_le_left.trans core_le_centralizer) inf_le_right)
    (le_inf inf_le_right (inf_le_left.trans P.conjugateCore_le))

noncomputable def conjugateCoreEquiv : core z ≃* P.conjugateCore :=
  (core z).equivMapOfInjective (MulAut.conj P.g⁻¹).toMonoidHom (MulAut.conj P.g⁻¹).injective

theorem conjugateCore_card (h : IsType z) : Nat.card P.conjugateCore = 32 :=
  (Nat.card_congr P.conjugateCoreEquiv.toEquiv).symm.trans h.toCentralizerHypothesis.core_card

theorem conjugateCore_extraspecial (h : IsType z) : IsExtraspecial 2 P.conjugateCore :=
  IsExtraspecial.of_mulEquiv P.conjugateCoreEquiv h.toCentralizerHypothesis.core_extraspecial

theorem conjugateCore_center (h : IsType z) :
    (center P.conjugateCore).map P.conjugateCore.subtype = zpowers P.u := by
  symm
  apply eq_of_le_of_card_ge
  · apply zpowers_le.mpr
    refine ⟨⟨P.u,P.u_mem_conjugateCore h⟩,mem_center_iff.mpr ?_,rfl⟩
    intro x
    exact Subtype.ext (mem_centralizer_singleton_iff.mp (P.conjugateCore_le x.property))
  · let : IsExtraspecial 2 P.conjugateCore := P.conjugateCore_extraspecial h
    rw [card_map_of_injective P.conjugateCore.subtype_injective,
      IsExtraspecial.center_order_p 2 P.conjugateCore,Nat.card_zpowers,P.u_order h]

omit [Finite G] in
private theorem card_inf_centralizer (Q : Subgroup G) (u : Q) :
    Nat.card (Q ⊓ centralizer (u : G) : Subgroup G) =
      Nat.card (Subgroup.centralizer ({u} : Set Q)) := by
  change Nat.card (Q ⊓ Subgroup.centralizer ({(u:G)} : Set G) : Subgroup G) = _
  rw [← map_subtype_centralizer_singleton Q u,card_map_of_injective Q.subtype_injective]

theorem leftCore_card (h : IsType z) : Nat.card P.leftCore = 16 := by
  rw [leftCore,card_inf_centralizer (core z) ⟨P.u,P.mem_core⟩]
  let : IsExtraspecial 2 (core z) := h.toCentralizerHypothesis.core_extraspecial
  apply IsExtraspecial.centralizer_card_sixteen_of_card_thirty_two
    h.toCentralizerHypothesis.core_card
  intro hz
  apply P.not_mem_line
  rw [← h.toCentralizerHypothesis.core_center]
  exact mem_map_of_mem (core z).subtype hz

theorem rightCore_card (h : IsType z) : Nat.card P.rightCore = 16 := by
  rw [rightCore,card_inf_centralizer P.conjugateCore ⟨z,P.z_mem_conjugateCore h⟩]
  let : IsExtraspecial 2 P.conjugateCore := P.conjugateCore_extraspecial h
  apply IsExtraspecial.centralizer_card_sixteen_of_card_thirty_two (P.conjugateCore_card h)
  intro hz
  have hzline : z ∈ zpowers P.u := P.conjugateCore_center h ▸
    mem_map_of_mem P.conjugateCore.subtype hz
  have hle : P.E ≤ zpowers P.u := sup_le (zpowers_le.mpr hzline) le_rfl
  have hc := Nat.card_le_card_of_injective (inclusion hle) (inclusion_injective hle)
  rw [P.E_card h,Nat.card_zpowers,P.u_order h] at hc
  omega

theorem E_le_leftCore (h : IsType z) : P.E ≤ P.leftCore := by
  apply le_inf (P.E_le_core h)
  apply sup_le
  · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr P.commute.eq)
  · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl)
theorem E_le_rightCore (h : IsType z) : P.E ≤ P.rightCore := by
  apply le_inf (P.E_le_conjugateCore h)
  apply sup_le
  · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl)
  · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr P.commute.symm.eq)
theorem E_le_R (h : IsType z) : P.E ≤ P.R := (P.E_le_leftCore h).trans le_sup_left

theorem leftCore_inf_rightCore (h : IsType z) : P.leftCore ⊓ P.rightCore = P.E := by
  apply le_antisymm
  · exact (inf_le_inf inf_le_left inf_le_left).trans (P.core_intersection h).le
  · exact le_inf (P.E_le_leftCore h) (P.E_le_rightCore h)
theorem R_card (h : IsType z) : Nat.card P.R = 64 := by
  have he := card_set_mul_mul_card_inf P.leftCore P.rightCore
  rw [← P.R_coe h,P.leftCore_inf_rightCore h,P.E_card h,
    P.leftCore_card h,P.rightCore_card h] at he
  change Nat.card P.R * 4 = 16 * 16 at he
  omega

omit [Finite G] in
theorem centralizer_E_eq :
    Subgroup.centralizer (P.E : Set G) = centralizer z ⊓ centralizer P.u := by
  apply le_antisymm
  · intro x hx
    exact ⟨mem_centralizer_singleton_iff.mpr (hx z P.z_mem_E).symm,
      mem_centralizer_singleton_iff.mpr (hx P.u P.u_mem_E).symm⟩
  · intro x hx y hy
    have hE : P.E ≤ Subgroup.centralizer ({x} : Set G) := by
      apply sup_le
      · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr
          (mem_centralizer_singleton_iff.mp hx.1).symm)
      · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr
          (mem_centralizer_singleton_iff.mp hx.2).symm)
    exact mem_centralizer_singleton_iff.mp (hE hy)

end RootPair
end Theory.GroupTheory.Recognition.UnitaryFourThree
