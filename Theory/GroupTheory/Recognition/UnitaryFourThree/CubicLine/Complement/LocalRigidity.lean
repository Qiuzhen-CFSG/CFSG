module
public import Theory.GroupTheory.Recognition.UnitaryFourThree.CubicLine.Complement.NormalizerComparison

/-!
# The original marked local-normalizer rigidity theorem

The compatible extraspecial and complement identifications give a normalizer
isomorphism retaining the selected cubic and rotation. The original Sylow
subgroup is D joined with that cubic. Its unique abelian subgroup of order81
is V, so the same map preserves V. Squaring the preserved rotation identifies
the original distinguished involutions. Every input is the original source
configuration; no action-classification or local-rigidity premise remains.

Source: Aschbacher, *Sporadic Groups* (1994), 45.11, p.248.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace Theory.GroupTheory.Recognition.UnitaryFourThree.CubicGeometry.SourceConfiguration
variable {G : Type*} [Group G] [Finite G] {z : G} {h : IsType z}
  {P : Sylow 3 (centralizer z)} (c : SourceConfiguration h P)

omit [Finite G] in
private theorem kernel_le_line_normalizer : c.V≤normalizer (c.W : Set G) := by
  have hWX : c.W≤c.X := zpowers_le.mpr (c.actors_eq.le c.actors.x.property)
  exact ((map_subtype_le _).trans (centralizer_le hWX)).trans (centralizer_le_normalizer _)

private theorem axis_le_kernel : zpowers (c.actors.y:G)≤c.V := by
  apply (zpowers_le.mpr (c.actors_eq.le c.actors.y.property)).trans
  exact CubicNormalizer.le_oddKernel c.X (h.cubic_sylow_image_card P)
    (h.toCentralizerHypothesis.cubic_centralizer c.X (h.cubic_sylow_image_card P) (map_subtype_le _))

/-- The source Sylow product is generated by its extraspecial part and the
selected cubic of the actual complement. -/
theorem sylow_eq_odd_sup_axis : c.Q=c.D⊔zpowers (c.actors.y:G) := by
  symm
  apply eq_of_le_of_card_ge (sup_le le_sup_right (c.axis_le_kernel.trans le_sup_left))
  have hYK : zpowers (c.actors.y:G)≤c.K := le_sup_right.trans le_sup_left
  rw [card_sup_eq_mul_of_normalizes_of_disjoint _ _
    (hYK.trans c.complement_normalizes_odd) (c.complement_disjoint.mono_right hYK),
    c.odd_card,Nat.card_zpowers,c.actors.y_order,c.sylow_card]

omit [Finite G] in
private theorem axis_subgroupOf (N : Subgroup G) (hy : (c.actors.y:G)∈N) :
    (zpowers (c.actors.y:G)).subgroupOf N=zpowers (⟨c.actors.y,hy⟩:N) := by
  apply map_injective N.subtype_injective
  rw [map_subgroupOf_eq_of_le (zpowers_le.mpr hy),MonoidHom.map_zpowers]
  rfl

variable {G' : Type*} [Group G'] [Finite G'] {z' : G'} {h' : IsType z'}
  {P' : Sylow 3 (centralizer z')} (c' : SourceConfiguration h' P')

/-- The full source local rigidity: the actual D, K and V are simultaneously
preserved by an isomorphism of the original point normalizers. -/
theorem exists_local_normalizer_equiv :
    ∃ e : normalizer (c.W : Set G) ≃* normalizer (c'.W : Set G'),
      (c.D.subgroupOf (normalizer (c.W : Set G))).map e.toMonoidHom =
        c'.D.subgroupOf (normalizer (c'.W : Set G')) ∧
      (c.K.subgroupOf (normalizer (c.W : Set G))).map e.toMonoidHom =
        c'.K.subgroupOf (normalizer (c'.W : Set G')) ∧
      (c.V.subgroupOf (normalizer (c.W : Set G))).map e.toMonoidHom =
        c'.V.subgroupOf (normalizer (c'.W : Set G')) ∧
      (∀ hz hz', e ⟨z,hz⟩=⟨z',hz'⟩) := by
  obtain ⟨e,hD,hK,hy,hr⟩ := c.exists_marked_normalizer_equiv c'
  let N := normalizer (c.W : Set G)
  let N' := normalizer (c'.W : Set G')
  have hDN : c.D≤N := le_sup_left.trans_eq c.complement_product.symm
  have hDN' : c'.D≤N' := le_sup_left.trans_eq c'.complement_product.symm
  have hKN : c.K≤N := c.complement_le.trans inf_le_right
  have hKN' : c'.K≤N' := c'.complement_le.trans inf_le_right
  have hyN : (c.actors.y:G)∈N := hKN (mem_sup_left (mem_sup_right (mem_zpowers _)))
  have hyN' : (c'.actors.y:G')∈N' := hKN' (mem_sup_left (mem_sup_right (mem_zpowers _)))
  have hYN : zpowers (c.actors.y:G)≤N := zpowers_le.mpr hyN
  have hYN' : zpowers (c'.actors.y:G')≤N' := zpowers_le.mpr hyN'
  have hY : ((zpowers (c.actors.y:G)).subgroupOf N).map e.toMonoidHom=
      (zpowers (c'.actors.y:G')).subgroupOf N' := by
    rw [c.axis_subgroupOf N hyN,c'.axis_subgroupOf N' hyN',MonoidHom.map_zpowers]
    exact congrArg zpowers (hy hyN hyN')
  have hQ : (c.Q.subgroupOf N).map e.toMonoidHom=c'.Q.subgroupOf N' := by
    rw [c.sylow_eq_odd_sup_axis,c'.sylow_eq_odd_sup_axis,
      subgroupOf_sup hDN hYN,subgroupOf_sup hDN' hYN',Subgroup.map_sup,hD,hY]
  have hQN' : c'.Q≤N' := by
    rw [c'.sylow_eq_odd_sup_axis]
    exact sup_le hDN' hYN'
  let B := ((c.V.subgroupOf N).map e.toMonoidHom).map N'.subtype
  have hBQ : B≤c'.Q := by
    have hvq : c.V.subgroupOf N≤c.Q.subgroupOf N := subgroupOf_mono N le_sup_left
    have hm := map_mono (f:=N'.subtype) (map_mono (f:=e.toMonoidHom) hvq)
    rw [hQ,map_subgroupOf_eq_of_le hQN'] at hm
    exact hm
  have hBc : Nat.card B=81 := by
    rw [card_map_of_injective N'.subtype_injective,card_map_of_injective e.injective]
    exact (Nat.card_congr (subgroupOfEquivOfLe c.kernel_le_line_normalizer).toEquiv).trans c.kernel_card
  have hBV : B=c'.V := by
    let : IsElementaryAbelian 3 c.V := c.kernel_elementary
    exact (c'.maximum B inferInstance hBQ).2 (by rw [hBc])
  have hV : (c.V.subgroupOf N).map e.toMonoidHom=c'.V.subgroupOf N' := by
    apply map_injective N'.subtype_injective
    rw [map_subgroupOf_eq_of_le c'.kernel_le_line_normalizer]
    exact hBV
  refine ⟨e,hD,hK,hV,?_⟩
  intro hz hz'
  let R : N := ⟨c.marking.s*c.marking.t,hKN (mem_sup_right (mem_zpowers _))⟩
  let R' : N' := ⟨c'.marking.s*c'.marking.t,hKN' (mem_sup_right (mem_zpowers _))⟩
  have hR : e R=R' := hr _ _
  have hR2 : R^2=⟨z,hz⟩ := Subtype.ext c.marking.rotation_square
  have hR2' : R'^2=⟨z',hz'⟩ := Subtype.ext c'.marking.rotation_square
  rw [←hR2,←hR2',map_pow,hR]
end Theory.GroupTheory.Recognition.UnitaryFourThree.CubicGeometry.SourceConfiguration
