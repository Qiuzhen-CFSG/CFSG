module

public import Theory.GroupTheory.Recognition.UnitaryFourThree.Factors
public import Theory.GroupTheory.PCoreCentralProduct
public import Theory.GroupTheory.QuaternionCentralProductIntrinsic

/-!
# The marked extraspecial two-core in the U₄(3) source configuration

The prime core of the actual SL₂(3) central product is generated by its two
 quaternion cores. Their intersection is exactly the source line ⟨z⟩. The
 intrinsic quaternion-product interface then proves order 32, extraspeciality
 and the marked center, keeping all subgroup inclusions in the original group.

Source: Aschbacher, *Sporadic Groups* (1994), Lemma 45.2, printed p.242.
-/

@[expose] public section
open Subgroup GLS3.Chapter5.SchurPresentation
namespace Theory.GroupTheory.Recognition.UnitaryFourThree
variable {G : Type*} [Group G] [Finite G] {z : G}
namespace Factors
variable (d : Factors z)

def leftCore : Subgroup G := d.left.pCoreIn 2
def rightCore : Subgroup G := d.right.pCoreIn 2

noncomputable def factorCoreEquiv (A : Subgroup G) (e : A ≃* SL23) :
    A.pCoreIn 2 ≃* QuaternionGroup 2 :=
  ((pCore 2 A).equivMapOfInjective A.subtype A.subtype_injective).symm.trans
    (((pCore 2 A).equivMapOfInjective e.toMonoidHom e.injective).trans
      ((MulEquiv.subgroupCongr (pCore_map_iso 2 e)).trans sl23_twoCoreEquiv))

theorem core_span (hz : orderOf z = 2) : d.leftCore ⊔ d.rightCore = core z := by
  change d.left.pCoreIn 2 ⊔ d.right.pCoreIn 2 = (residual z).pCoreIn 2
  rw [← d.span]
  symm
  apply pCoreIn_sup_of_commuting_of_intersection_isPGroup 2 d.left d.right
    (fun a b => d.factors_commute hz a a.property b b.property)
  rw [d.intersection]
  exact IsPGroup.of_card (n := 1) (by simp [Nat.card_zpowers, hz])

omit [Finite G] in
private theorem central_line_le_core (A : Subgroup G) (hA : A ≤ centralizer z)
    (hzA : zpowers z ≤ A) (hz : orderOf z = 2) : zpowers z ≤ A.pCoreIn 2 := by
  apply le_pCoreIn_of_normalizes
    (IsPGroup.of_card (n := 1) (by simp [Nat.card_zpowers, hz])) hzA
  apply le_trans ?_ (centralizer_le_normalizer _)
  intro a ha x hx
  obtain ⟨n,rfl⟩ := mem_zpowers_iff.mp hx
  exact ((show Commute a z from mem_centralizer_singleton_iff.mp (hA ha)).zpow_right n).symm

omit [Finite G] in
theorem core_intersection (hz : orderOf z = 2) : d.leftCore ⊓ d.rightCore = zpowers z := by
  apply le_antisymm
  · exact (inf_le_inf (pCoreIn_le 2 d.left) (pCoreIn_le 2 d.right)).trans d.intersection.le
  · apply le_inf
    · exact central_line_le_core d.left (d.left_le.trans (map_subtype_le _))
        (d.intersection ▸ inf_le_left) hz
    · exact central_line_le_core d.right (d.right_le.trans (map_subtype_le _))
        (d.intersection ▸ inf_le_right) hz

noncomputable def coreData (hz : orderOf z = 2) : QuaternionCentralProductData (core z) where
  left := d.leftCore.subgroupOf (core z)
  right := d.rightCore.subgroupOf (core z)
  left_model := ⟨(subgroupOfEquivOfLe (d.core_span hz ▸ le_sup_left)).trans
    (factorCoreEquiv d.left d.left_model.some)⟩
  right_model := ⟨(subgroupOfEquivOfLe (d.core_span hz ▸ le_sup_right)).trans
    (factorCoreEquiv d.right d.right_model.some)⟩
  intersection_card := by
    change Nat.card ((d.leftCore ⊓ d.rightCore).subgroupOf (core z)) = 2
    rw [Nat.card_congr (subgroupOfEquivOfLe
      (inf_le_left.trans (d.core_span hz ▸ le_sup_left))).toEquiv,
      d.core_intersection hz, Nat.card_zpowers,hz]
  commute := by
    intro b hb c hc
    apply Subtype.ext
    exact d.factors_commute hz b (pCoreIn_le 2 d.left hb) c (pCoreIn_le 2 d.right hc)
  span := by
    rw [← subgroupOf_sup (d.core_span hz ▸ le_sup_left) (d.core_span hz ▸ le_sup_right),
      d.core_span hz,subgroupOf_self]

include d in
theorem core_card (hz : orderOf z = 2) : Nat.card (core z) = 32 := (d.coreData hz).card

include d in
theorem core_center (hz : orderOf z = 2) : (center (core z)).map (core z).subtype = zpowers z := by
  rw [(d.coreData hz).center_eq]
  change ((d.leftCore ⊓ d.rightCore).subgroupOf (core z)).map _ = _
  rw [map_subgroupOf_eq_of_le
    (inf_le_left.trans (d.core_span hz ▸ le_sup_left)),d.core_intersection hz]

end Factors
end Theory.GroupTheory.Recognition.UnitaryFourThree
