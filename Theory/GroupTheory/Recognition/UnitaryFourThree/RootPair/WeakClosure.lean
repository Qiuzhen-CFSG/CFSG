module
public import Theory.GroupTheory.Recognition.UnitaryFourThree.RootPair.PlanePair

/-!
# Weak closure and fusion in the two source planes

The span of the maximum elementary family is R. Its characteristic center
identifies its normalizer with N_G(E), which fixes both planes individually.
Burnside set fusion therefore proves weak closure of each plane and gives
literal normalizer conjugators for all fusion inside it.

Source: Aschbacher, *Sporadic Groups* (1994), 45.5(3), printed p.244.
-/

@[expose] public section
open Subgroup
namespace Theory.GroupTheory.Recognition.UnitaryFourThree
variable {G : Type*} [Group G] [Finite G] {z : G}
namespace RootPair
variable (P : RootPair z)

private def planeFamily : Set (Subgroup G) := {V | IsElementaryAbelian 2 V ∧ Nat.card V=16}

omit [Finite G] in
private theorem planeFamily_invariant : SubgroupFamily.ConjugationInvariant (planeFamily (G:=G)) := by
  intro V hV g
  let : IsElementaryAbelian 2 V := hV.1
  exact ⟨IsElementaryAbelian.map _,(card_map_of_injective (MulAut.conj g).injective).trans hV.2⟩

private theorem planeFamily_span (h : IsType z) : SubgroupFamily.span planeFamily P.T=P.R := by
  obtain ⟨d⟩ := P.exists_planePair h
  apply le_antisymm
  · apply sSup_le
    rintro V ⟨hV,hVT⟩
    let : IsElementaryAbelian 2 V := hV.1
    exact P.large_elementary_le_R h V hVT hV.2.ge
  · rw [←d.sup_eq]
    apply sup_le
    · exact SubgroupFamily.le_span ⟨d.first_elementary,d.first_card⟩ (d.first_le.trans le_sup_left)
    · exact SubgroupFamily.le_span ⟨d.second_elementary,d.second_card⟩ (d.second_le.trans le_sup_left)

/-- R is the subgroup generated by the maximum elementary family and is weakly closed. -/
theorem R_map_eq_of_le (h : IsType z) (g:G)
    (hg : P.R.map (MulAut.conj g).toMonoidHom≤P.T) :
    P.R.map (MulAut.conj g).toMonoidHom=P.R := by
  rw [←P.planeFamily_span h] at hg ⊢
  exact SubgroupFamily.span_weakly_closed planeFamily_invariant P.T g hg

theorem normalizer_R_eq_N (h : IsType z) : normalizer (P.R:Set G)=P.N := by
  apply le_antisymm _ (P.N_normalizes_R h)
  have hh := normalizer_le_normalizer_characteristic_image P.R (center P.R)
  rw [P.R_center h] at hh
  exact hh

theorem plane_normalized_by_N (h : IsType z) (V:Subgroup G)
    (hV : V≤P.T ∧ IsElementaryAbelian 2 V ∧ Nat.card V=16) :
    P.N≤normalizer (V:Set G) := by
  obtain ⟨d⟩ := P.exists_planePair h
  rcases (d.exhaustive V).mp hV with rfl | rfl
  · exact d.first_normalized
  · exact d.second_normalized

/-- Each actual elementary sixteen-group is weakly closed in the ambient Sylow T. -/
theorem plane_weakly_closed (h : IsType z) (V:Subgroup G)
    (hV : V≤P.T ∧ IsElementaryAbelian 2 V ∧ Nat.card V=16) (g:G)
    (hg : V.map (MulAut.conj g).toMonoidHom≤P.T) :
    V.map (MulAut.conj g).toMonoidHom=V := by
  obtain ⟨S,hS⟩ := P.exists_sylow_T h
  have hRS : P.R≤(S:Subgroup G) := hS ▸ (show P.R≤P.T from le_sup_left)
  have hw : ∀a:G,P.R.map (MulAut.conj a).toMonoidHom≤(S:Subgroup G) →
      a∈normalizer (P.R:Set G) := by
    intro a ha
    exact mem_normalizer_iff_map_conj_eq.mpr (P.R_map_eq_of_le h a (hS ▸ ha))
  have hV' : IsElementaryAbelian 2 (V.map (MulAut.conj g).toMonoidHom) := by
    let := hV.2.1
    exact IsElementaryAbelian.map _
  have hc' : Nat.card (V.map (MulAut.conj g).toMonoidHom)=16 :=
    (card_map_of_injective (MulAut.conj g).injective).trans hV.2.2
  have hRN : P.R≤P.N := (show P.R≤P.T from le_sup_left).trans (P.T_le_N h)
  obtain ⟨n,hn,he⟩ := S.weakly_closed_normalizer_controls_set_fusion P.R hRS hw
    (V:Set G) (V.map (MulAut.conj g).toMonoidHom:Set G)
    (hRN.trans (P.plane_normalized_by_N h V hV))
    (hRN.trans (P.plane_normalized_by_N h _ ⟨hg,hV',hc'⟩)) g rfl
  have hnN : n∈P.N := P.normalizer_R_eq_N h ▸ hn
  have hnV := mem_normalizer_iff_conj_image_eq.mp (P.plane_normalized_by_N h V hV hnN)
  exact SetLike.coe_injective (he.symm.trans hnV)

/-- Burnside fusion in each source plane is controlled by its actual normalizer. -/
theorem plane_controls_fusion (h : IsType z) (V:Subgroup G)
    (hV : V≤P.T ∧ IsElementaryAbelian 2 V ∧ Nat.card V=16)
    {x y:G} (hx:x∈V) (hy:y∈V) (hxy:IsConj x y) :
    ∃ n∈normalizer (V:Set G),n*x*n⁻¹=y := by
  obtain ⟨S,hS⟩ := P.exists_sylow_T h
  let := hV.2.1
  have hcent {a:G} (ha:a∈V) : a∈Subgroup.centralizer (V:Set G) := by
    intro b hb
    exact congrArg Subtype.val ((IsMulCommutative.is_comm (M:=V)).comm ⟨b,hb⟩ ⟨a,ha⟩)
  exact S.weakly_closed_normalizer_controls_centralizer_fusion V (hS ▸ hV.1)
    (fun g hg=>mem_normalizer_iff_map_conj_eq.mpr (P.plane_weakly_closed h V hV g (hS ▸ hg)))
    (hcent hx) (hcent hy) hxy

end RootPair
end Theory.GroupTheory.Recognition.UnitaryFourThree
