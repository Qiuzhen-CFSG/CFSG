module
public import Theory.SpecificGroups.PSL3Four.HyperbolicRootRecognition.SourceConsumer

/-!
# The two root planes are normalized by the whole original N

The literal two reflections preserve each transported elementary plane.
Inner automorphisms of R preserve them as well. Each extraspecial core is
generated by its index-two factor and its chosen reflection actor, hence
N=⟨Q,Qᵍ⟩ normalizes both planes. This keeps the actual ambient subgroups
and the exact N from source45.3.

Source: Aschbacher, *Sporadic Groups* (1994),45.3(2), printed pp.242–243.
-/

@[expose] public section
open Subgroup
open Theory.GroupTheory.HyperbolicRecognition
namespace Theory.GroupTheory.Recognition.UnitaryFourThree
variable {G : Type*} [Group G] [Finite G] {z : G}
namespace RootPair
variable (P : RootPair z)

omit [Finite G] in
private theorem le_of_half_and_outside (Q A D : Subgroup G) (hAQ : A≤Q)
    (hQc : Nat.card Q=32) (hAc : Nat.card A=16) (hAD : A≤D)
    (s : G) (hs : s∈Q) (hsA : s∉A) (hsD : s∈D) : Q≤D := by
  let A' := A.subgroupOf Q
  have hi : A'.index=2 := by
    have he := A'.card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe hAQ).toEquiv,hQc,hAc] at he
    omega
  intro q hq
  by_cases hqa : q∈A
  · exact hAD hqa
  · have ha : q*s⁻¹∈A := by
      have hqa' : (⟨q,hq⟩:Q)∉A' := hqa
      have hsA' : (⟨s,hs⟩:Q)∉A' := hsA
      exact (show (⟨q,hq⟩:Q)*(⟨s,hs⟩:Q)⁻¹∈A' from
        (A'.mul_mem_iff_of_index_two hi).mpr
          (by simpa only [inv_mem_iff] using iff_of_false hqa' hsA'))
    simpa only [inv_mul_cancel_right] using D.mul_mem (hAD ha) hsD

omit [Finite G] in
private theorem ambient_normalizer_of_actor (S : Subgroup P.R) (a:G)
    (α:MulAut P.R) (hα : ∀x:P.R,(α x:G)=a*x*a⁻¹)
    (hS : S.map α.toMonoidHom=S) : a∈normalizer (S.map P.R.subtype : Set G) := by
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [map_map]
  have hf : (MulAut.conj a).toMonoidHom.comp P.R.subtype =
      P.R.subtype.comp α.toMonoidHom := by
    ext x
    exact (hα x).symm
  change S.map ((MulAut.conj a).toMonoidHom.comp P.R.subtype)=_
  rw [hf,←map_map,hS]

omit [Finite G] in
private theorem normal_in_R_ambient (S : Subgroup P.R) [S.Normal] :
    P.R≤normalizer (S.map P.R.subtype : Set G) := by
  have hh := S.le_normalizer_map P.R.subtype
  rw [normalizer_eq_top_iff.mpr inferInstance,←MonoidHom.range_eq_map,range_subtype] at hh
  exact hh

private theorem normalizer_contains_N (h : IsType z)
    (a:G) (ha : a∈core z) (b:G) (hb : b∈P.conjugateCore)
    (α : (P.hyperbolicFactors h).FirstActor) (β : (P.hyperbolicFactors h).SecondActor)
    (hα : ∀x:P.R,(α.aut x:G)=a*x*a⁻¹)
    (hβ : ∀x:P.R,(β.aut x:G)=b*x*b⁻¹)
    (S : Subgroup P.R) [S.Normal]
    (hSa : S.map α.aut.toMonoidHom=S) (hSb : S.map β.aut.toMonoidHom=S) :
    P.N≤normalizer (S.map P.R.subtype : Set G) := by
  have hR := P.normal_in_R_ambient S
  have hAN := P.ambient_normalizer_of_actor S a α.aut hα hSa
  have hBN := P.ambient_normalizer_of_actor S b β.aut hβ hSb
  have haA : a∉P.leftCore := by
    intro haA
    have hcomm := mem_centralizer_singleton_iff.mp haA.2
    have he := (hα (P.hyperbolicFactors h).u).symm.trans
      (congrArg (fun x:P.R=>(x:G)) α.map_u)
    change a*P.u*a⁻¹=z*P.u at he
    rw [hcomm,mul_inv_cancel_right] at he
    have hz1 : z=1 := mul_right_cancel (by simpa only [one_mul] using he.symm)
    have hi := h.involution
    simp [hz1] at hi
  have hbB : b∉P.rightCore := by
    intro hbB
    have hcomm := mem_centralizer_singleton_iff.mp hbB.2
    have he := (hβ (P.hyperbolicFactors h).z).symm.trans
      (congrArg (fun x:P.R=>(x:G)) β.map_z)
    change b*z*b⁻¹=z*P.u at he
    rw [hcomm,mul_inv_cancel_right] at he
    have hu1 : P.u=1 := mul_left_cancel (by simpa only [mul_one] using he.symm)
    have hi := P.u_order h
    simp [hu1] at hi
  rw [P.N_eq_core_join h]
  apply sup_le
  · exact le_of_half_and_outside (core z) P.leftCore _ inf_le_left
      h.toCentralizerHypothesis.core_card (P.leftCore_card h)
      (le_sup_left.trans hR) a ha haA hAN
  · exact le_of_half_and_outside P.conjugateCore P.rightCore _ inf_le_left
      (P.conjugateCore_card h) (P.rightCore_card h)
      (le_sup_right.trans hR) b hb hbB hBN

/-- The two actual root planes are each normalized by the whole source N. -/
theorem exists_two_N_normal_root_planes (h : IsType z) :
    ∃ E₁ E₂ : Subgroup P.R,
      IsElementaryAbelian 2 E₁ ∧ IsElementaryAbelian 2 E₂ ∧
      Nat.card E₁=16 ∧ Nat.card E₂=16 ∧ E₁≠E₂ ∧
      (E₁⊓E₂).map P.R.subtype=P.E ∧
      P.N≤normalizer (E₁.map P.R.subtype:Set G) ∧
      P.N≤normalizer (E₂.map P.R.subtype:Set G) ∧
      (∀E:Subgroup P.R,(IsElementaryAbelian 2 E ∧ Nat.card E=16) ↔ E=E₁ ∨ E=E₂) := by
  obtain ⟨a,ha,b,hb,α,β,e,hα,hβ⟩ := P.exists_actorRootRealization h
  refine ⟨transportedPlane₁ e.equiv,transportedPlane₂ e.equiv,inferInstance,inferInstance,
    card_transportedPlane₁ e.equiv,card_transportedPlane₂ e.equiv,transportedPlanes_ne e.equiv,
    ?_,?_,?_,transported_elementary_sixteen_iff e.equiv⟩
  · rw [transportedPlanes_inf,P.R_center h]
  · exact P.normalizer_contains_N h a ha b hb α β hα hβ _ e.first_left e.second_left
  · exact P.normalizer_contains_N h a ha b hb α β hα hβ _ e.first_right e.second_right

end RootPair
end Theory.GroupTheory.Recognition.UnitaryFourThree
