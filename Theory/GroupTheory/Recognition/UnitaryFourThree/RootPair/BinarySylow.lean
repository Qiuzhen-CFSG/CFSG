module
public import Theory.GroupTheory.Recognition.UnitaryFourThree.RootPair.NormalPlanes
public import Theory.GroupTheory.Recognition.UnitaryFourThree.RootPair.ResidualProduct
public import Theory.GroupTheory.CentralizerSylowPromotion

/-!
# The literal source Sylow subgroup of order128

The product T=RQ has order128 and centralizes z. Its center is exactly
⟨z⟩ because T contains the self-centralizing extraspecial core Q. The
original centralizer order makes T Sylow in H=C_G(z), and the center
criterion promotes this same subgroup to an ambient Sylow subgroup.

Source: Aschbacher, *Sporadic Groups* (1994),45.5(2), printed p.244.
-/

@[expose] public section
open Subgroup
open scoped Pointwise
namespace Theory.GroupTheory.Recognition.UnitaryFourThree
variable {G : Type*} [Group G] [Finite G] {z : G}
namespace RootPair
variable (P : RootPair z)

def T : Subgroup G := P.R⊔core z

omit [Finite G] in
theorem T_le_centralizer : P.T≤centralizer z :=
  sup_le (P.R_le_double_centralizer.trans inf_le_left) core_le_centralizer

theorem T_le_N (h : IsType z) : P.T≤P.N := by
  apply sup_le _ (P.core_le_N h)
  exact sup_le (inf_le_left.trans (P.core_le_N h)) (inf_le_left.trans (P.conjugateCore_le_N h))

theorem T_card (h : IsType z) : Nat.card P.T=128 := by
  have hn : P.R≤normalizer (core z : Set G) :=
    (P.R_le_double_centralizer.trans inf_le_left).trans
      CentralizerHypothesis.centralizer_normalizes_core
  have he := card_mul_eq_card_inf_mul_card_sup_of_normalizes (core z) P.R hn
  rw [inf_comm,sup_comm,P.R_inf_core h,h.toCentralizerHypothesis.core_card,
    P.R_card h,P.leftCore_card h] at he
  change 32*64=16*Nat.card P.T at he
  omega

theorem T_center (h : IsType z) : (center P.T).map P.T.subtype=zpowers z := by
  apply le_antisymm
  · rintro _ ⟨x,hx,rfl⟩
    rw [←h.toCentralizerHypothesis.centralizer_core]
    intro q hq
    exact congrArg Subtype.val (mem_center_iff.mp hx ⟨q,mem_sup_right hq⟩)
  · apply zpowers_le.mpr
    refine ⟨⟨z,mem_sup_right (z_mem_core h)⟩,mem_center_iff.mpr ?_,rfl⟩
    intro x
    exact Subtype.ext (mem_centralizer_singleton_iff.mp (P.T_le_centralizer x.property))

/-- The literal binary subgroup generated by the root product and original core is Sylow in G. -/
theorem exists_sylow_T (h : IsType z) : ∃ S : Sylow 2 G,(S:Subgroup G)=P.T := by
  let S : Sylow 2 (centralizer z) := Sylow.ofCard (P.T.subgroupOf (centralizer z)) (by
    rw [Nat.card_congr (subgroupOfEquivOfLe P.T_le_centralizer).toEquiv,
      P.T_card h,h.centralizer_card]
    decide +kernel)
  have hS : (S:Subgroup (centralizer z)).map (centralizer z).subtype=P.T :=
    map_subgroupOf_eq_of_le P.T_le_centralizer
  obtain ⟨S',hS'⟩ := exists_ambient_sylow_of_centralizer_center z h.involution S (by
    exact (congrArg (fun A:Subgroup G=>(center A).map A.subtype) hS).trans (P.T_center h))
  exact ⟨S',hS'.trans hS⟩

end RootPair
end Theory.GroupTheory.Recognition.UnitaryFourThree
