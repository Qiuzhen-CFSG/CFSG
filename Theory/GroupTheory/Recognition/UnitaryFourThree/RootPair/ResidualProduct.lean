module
public import Theory.GroupTheory.Recognition.UnitaryFourThree.RootPair.Reflections
public import Theory.GroupTheory.PCoreOddIndex

/-!
# The actual involution centralizer is generated by the root product and residual

The residual has normal Sylow two-core of order32 and odd index9. Its
intersection with R is therefore the marked order16 first factor. The
product formula and original centralizer order then give H=R O²(H).
Since all squares of R lie in E≤O²(H), every square of H lies in O²(H).
This is the source45.5(1) input to the cubic normalizer action bound.

Source: Aschbacher, *Sporadic Groups* (1994),45.5, printed p.244.
-/

@[expose] public section
open Subgroup
open scoped Pointwise
namespace Theory.GroupTheory.Recognition.UnitaryFourThree
variable {G : Type*} [Group G] [Finite G] {z : G}
namespace CentralizerHypothesis
variable (h : CentralizerHypothesis z)

include h in
/-- Every binary subgroup of the residual lies in its actual two-core. -/
theorem two_subgroup_le_core (A : Subgroup G) (hA : IsPGroup 2 A)
    (hAL : A≤residual z) : A≤core z := by
  let L:=residual z
  let Q:=pCore 2 L
  have hQcard : Nat.card Q=32 := by
    have hc : core z=Q.map L.subtype := rfl
    have hh := h.core_card
    rw [hc,card_map_of_injective L.subtype_injective] at hh
    exact hh
  have hindex : Q.index=9 := by
    have hh := Q.card_mul_index
    rw [hQcard,h.residual_card] at hh
    omega
  let A' := A.subgroupOf L
  have ha' : IsPGroup 2 A' := hA.of_equiv (subgroupOfEquivOfLe hAL).symm
  have hle : A'≤Q := ha'.le_pCore_of_le_oddIndexOverCore
    (C:=⊤) le_top (by
      change ¬2∣Q.relIndex ⊤
      rw [relIndex_top_right,hindex]
      decide) le_top
  intro a ha
  exact mem_map_of_mem L.subtype (hle (show (⟨a,hAL ha⟩:L)∈A' from ha))
end CentralizerHypothesis
namespace RootPair
variable (P : RootPair z)

theorem R_inf_residual (h : IsType z) : P.R⊓residual z=P.leftCore := by
  have hp : IsPGroup 2 P.R := IsPGroup.of_card (p:=2) (n:=6) (P.R_card h)
  have hle : P.R⊓residual z≤core z := h.toCentralizerHypothesis.two_subgroup_le_core
    (P.R⊓residual z) hp.to_inf_left inf_le_right
  apply le_antisymm
  · exact (le_inf inf_le_left hle).trans (P.R_inf_core h).le
  · exact le_inf le_sup_left (inf_le_left.trans (pCoreIn_le 2 (residual z)))

/-- The whole original involution centralizer is the product of R and its residual. -/
theorem centralizer_eq_R_sup_residual (h : IsType z) :
    centralizer z=P.R⊔residual z := by
  have hR : P.R≤centralizer z := P.R_le_double_centralizer.trans inf_le_left
  have hL : residual z≤centralizer z := map_subtype_le _
  have hn : P.R≤normalizer (residual z : Set G) :=
    hR.trans CentralizerHypothesis.centralizer_normalizes_residual
  have hc := card_mul_eq_card_inf_mul_card_sup_of_normalizes (residual z) P.R hn
  rw [inf_comm,sup_comm,P.R_card h,h.toCentralizerHypothesis.residual_card,P.R_inf_residual h,P.leftCore_card h] at hc
  symm
  apply eq_of_le_of_card_ge (sup_le hR hL)
  rw [h.centralizer_card]
  omega

include P in
/-- Every element of the original involution centralizer has square in its residual. -/
theorem centralizer_square_mem_residual (h : IsType z) (x : G)
    (hx : x∈centralizer z) : x^2∈residual z := by
  have hn : P.R≤normalizer (residual z : Set G) :=
    (P.R_le_double_centralizer.trans inf_le_left).trans
      CentralizerHypothesis.centralizer_normalizes_residual
  have hp : x∈(P.R : Set G)*(residual z : Set G) := by
    rw [← coe_mul_of_left_le_normalizer_right P.R (residual z) hn]
    exact (P.centralizer_eq_R_sup_residual h) ▸ hx
  obtain ⟨r,hr,l,hl,rfl⟩ := hp
  have hr2 : r^2∈residual z := (pCoreIn_le 2 (residual z))
    (P.E_le_core h (P.R_square_mem_E h r hr))
  have hrl : r⁻¹*l*r∈residual z := by
    have hri : r⁻¹∈normalizer (residual z : Set G) :=
      (normalizer (residual z : Set G)).inv_mem (hn hr)
    simpa only [inv_inv] using (mem_normalizer_iff.mp hri l).mp hl
  have he : (r*l)^2=r^2*(r⁻¹*l*r)*l := by simp only [pow_two]; group
  rw [he]
  exact (residual z).mul_mem ((residual z).mul_mem hr2 hrl) hl

end RootPair
end Theory.GroupTheory.Recognition.UnitaryFourThree
