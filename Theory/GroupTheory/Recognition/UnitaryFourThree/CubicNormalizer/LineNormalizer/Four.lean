module
public import Theory.GroupTheory.Recognition.UnitaryFourThree.CubicNormalizer.LineNormalizer.Sylow
public import Theory.GroupTheory.Recognition.UnitaryFourThree.RootPair.CubicKernelConsumer
public import Theory.GroupTheory.IndexTwoFourCentralizerControl
/-!
# The original reflected four-group

The second reflection inverts U=C_X(t). The subgroup generated by z and t
is elementary of order four. It is both the plane centralizer of U and the
centralizer of U in the original dihedral eight. These equalities preserve
the original actors for the local A6 action and global normalizer closure.
Source: Aschbacher, Sporadic Groups (1994),45.7(3),printed p.245.
-/
public section
open Subgroup
namespace Theory.GroupTheory.Recognition.UnitaryFourThree
variable {G:Type*} [Group G] [Finite G] {z:G}
namespace CubicNormalizer.ReflectedMarking
variable {X:Subgroup G} (m:ReflectedMarking z X)
omit [Finite G] in
theorem s_inverts_fixed : ∀u∈X⊓Subgroup.centralizer ({m.t}:Set G),m.s*u*m.s⁻¹=u⁻¹ := by
  intro u hu
  have htfix:m.t*u*m.t⁻¹=u := mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp hu.2).symm
  calc
    m.s*u*m.s⁻¹=m.s*(m.t*u*m.t⁻¹)*m.s⁻¹ := congrArg (fun x:G=>m.s*x*m.s⁻¹) htfix.symm
    _=(m.s*m.t)*u*(m.s*m.t)⁻¹ := by group
    _=u⁻¹ := m.rotation_inverts u hu.1

theorem s_not_centralizes_fixed : m.s∉Subgroup.centralizer ((X⊓Subgroup.centralizer ({m.t}:Set G):Subgroup G):Set G) := by
  intro hs
  let U:=X⊓Subgroup.centralizer ({m.t}:Set G)
  obtain ⟨u,hu⟩:=exists_prime_orderOf_dvd_card' (G:=U) 3 (by rw [m.common_fixed_card])
  have hu3:orderOf (u:G)=3 := (orderOf_injective U.subtype U.subtype_injective u).trans hu
  have hc:m.s*(u:G)*m.s⁻¹=u := mul_inv_eq_iff_eq_mul.mpr (hs u u.property).symm
  have hi:(u:G)=(u:G)⁻¹ := hc.symm.trans (m.s_inverts_fixed u u.property)
  have h2:(u:G)^2=1 := by
    calc
      (u:G)^2=(u:G)*(u:G)⁻¹ := by simpa only [pow_two] using congrArg ((u:G)*·) hi
      _=1 := mul_inv_cancel _
  have hd:=orderOf_dvd_of_pow_eq_one h2
  rw [hu3] at hd
  norm_num at hd
end CubicNormalizer.ReflectedMarking
namespace IsType
variable (h:IsType z)
include h in
theorem reflected_four (P:Sylow 3 (centralizer z))
    (m:CubicNormalizer.ReflectedMarking z ((P:Subgroup (centralizer z)).map (centralizer z).subtype)) :
    let S:=zpowers z⊔zpowers m.t
    IsElementaryAbelian 2 S ∧ Nat.card S=4 := by
  let X:=(P:Subgroup (centralizer z)).map (centralizer z).subtype
  have hz2:z^2=1 := h.involution ▸ pow_orderOf_eq_one z
  have ht2:m.t^2=1 := m.t_order ▸ pow_orderOf_eq_one m.t
  have htZ:m.t∉zpowers z := by
    intro ht
    have hzC:zpowers z≤Subgroup.centralizer (X:Set G) := zpowers_le.mpr
      (fun x hx=>mem_centralizer_singleton_iff.mp ((map_subtype_le _) hx))
    have hXC:X≤Subgroup.centralizer ({m.t}:Set G) := fun x hx=>
      mem_centralizer_singleton_iff.mpr (hzC ht x hx)
    have hh:=m.common_fixed_card
    rw [inf_eq_left.mpr hXC,h.cubic_sylow_image_card P] at hh
    omega
  have htC:m.t∈Subgroup.centralizer (zpowers z:Set G) := fun x hx=>by
    obtain ⟨k,rfl⟩:=mem_zpowers_iff.mp hx
    exact (m.zt_commute.zpow_left k).eq
  let : IsElementaryAbelian 2 (zpowers z) := IsElementaryAbelian.zpowers_of_pow_eq_one hz2
  let : IsElementaryAbelian 2 (zpowers m.t) := IsElementaryAbelian.zpowers_of_pow_eq_one ht2
  refine ⟨IsElementaryAbelian.sup_of_le_centralizer (zpowers_le.mpr htC),?_⟩
  rw [card_sup_zpowers_of_normalizing_involution (zpowers z) m.t ht2 htZ
    ((centralizer_le_normalizer _) htC),Nat.card_zpowers,h.involution]
end IsType
namespace RootPair
variable (R:RootPair z) (h:IsType z)
include h in
theorem reflected_four_eq_plane_fixed (P:Sylow 3 (centralizer z))
    (m:CubicNormalizer.ReflectedMarking z ((P:Subgroup (centralizer z)).map (centralizer z).subtype))
    (A:Subgroup G) (hA:A≤R.T ∧ IsElementaryAbelian 2 A ∧ Nat.card A=16) (htA:m.t∈A) :
    A⊓Subgroup.centralizer
      ((((P:Subgroup (centralizer z)).map (centralizer z).subtype)⊓Subgroup.centralizer ({m.t}:Set G):Subgroup G):Set G)=
      zpowers z⊔zpowers m.t := by
  let X:=(P:Subgroup (centralizer z)).map (centralizer z).subtype
  let U:=X⊓Subgroup.centralizer ({m.t}:Set G)
  have hzU:z∈Subgroup.centralizer (U:Set G) := fun u hu=>
    mem_centralizer_singleton_iff.mp ((map_subtype_le _) hu.1)
  have htU:m.t∈Subgroup.centralizer (U:Set G) := fun u hu=>
    (mem_centralizer_singleton_iff.mp hu.2)
  have hle:zpowers z⊔zpowers m.t≤A⊓Subgroup.centralizer (U:Set G) :=
    sup_le (zpowers_le.mpr ⟨R.E_le_plane h A hA R.z_mem_E,hzU⟩)
      (zpowers_le.mpr ⟨htA,htU⟩)
  exact (eq_of_le_of_card_ge hle (by
    rw [(R.reflected_line_plane_position h P m A hA htA).2.2,(h.reflected_four P m).2])).symm

include h in
theorem reflected_four_eq_sylow_fixed (P:Sylow 3 (centralizer z))
    (m:CubicNormalizer.ReflectedMarking z ((P:Subgroup (centralizer z)).map (centralizer z).subtype))
    (ht:m.t∈R.cubicSylow ((P:Subgroup (centralizer z)).map (centralizer z).subtype))
    (hs:m.s∈R.cubicSylow ((P:Subgroup (centralizer z)).map (centralizer z).subtype)) :
    R.cubicSylow ((P:Subgroup (centralizer z)).map (centralizer z).subtype)⊓Subgroup.centralizer
      ((((P:Subgroup (centralizer z)).map (centralizer z).subtype)⊓Subgroup.centralizer ({m.t}:Set G):Subgroup G):Set G)=
      zpowers z⊔zpowers m.t := by
  let X:=(P:Subgroup (centralizer z)).map (centralizer z).subtype
  let U:=X⊓Subgroup.centralizer ({m.t}:Set G)
  let T:=R.cubicSylow X
  let S:=zpowers z⊔zpowers m.t
  have hzT:z∈T := by
    have hh:=R.cubicSylow_inf_core h X (h.cubic_sylow_image_card P) (map_subtype_le _)
    exact ((hh.symm ▸ mem_zpowers z):z∈core z⊓R.cubicSylow X).2
  have hle:S≤T⊓Subgroup.centralizer (U:Set G) := sup_le
    (zpowers_le.mpr ⟨hzT,fun u hu=>mem_centralizer_singleton_iff.mp ((map_subtype_le _) hu.1)⟩)
    (zpowers_le.mpr ⟨ht,fun u hu=>mem_centralizer_singleton_iff.mp hu.2⟩)
  have hcard:Nat.card T=8:=R.cubicSylow_card h X (h.cubic_sylow_image_card P) (map_subtype_le _)
  have hd:Nat.card (T⊓Subgroup.centralizer (U:Set G):Subgroup G)∣8:=hcard ▸ card_dvd_of_le inf_le_left
  have hge:4≤Nat.card (T⊓Subgroup.centralizer (U:Set G):Subgroup G):=by
    rw [←(h.reflected_four P m).2];exact card_le_of_le hle
  have hne:Nat.card (T⊓Subgroup.centralizer (U:Set G):Subgroup G)≠8:=by
    intro hh
    have he:T⊓Subgroup.centralizer (U:Set G)=T:=eq_of_le_of_card_ge inf_le_left (by rw [hh,hcard])
    exact m.s_not_centralizes_fixed ((he.symm ▸ (show m.s∈T from hs)).2)
  have hc:Nat.card (T⊓Subgroup.centralizer (U:Set G):Subgroup G)=4:=by
    have hh:=Nat.mem_divisors.mpr ⟨hd,(by decide:8≠0)⟩
    have he:Nat.divisors 8={1,2,4,8}:=by decide
    simp only [he,Finset.mem_insert,Finset.mem_singleton] at hh
    omega
  exact (eq_of_le_of_card_ge hle (by rw [hc,(h.reflected_four P m).2])).symm
end RootPair
end Theory.GroupTheory.Recognition.UnitaryFourThree
