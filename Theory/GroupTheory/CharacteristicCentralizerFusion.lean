module

public import Mathlib.GroupTheory.Nilpotent
public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Algebra.Group.Conj
public import Theory.GroupTheory.NormalCenterQuotient
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators
import Mathlib.Tactic

/-!
# Characteristic subgroups and fusion in involution centralizers

Suppose two conjugate elements have a common centralizer which is a p-group
smaller than a Sylow p-subgroup of either centralizer. Its normalizer cannot
be contained in the first centralizer: the normalizer condition in a Sylow
subgroup of the second centralizer supplies an element outside it.

Consequently a characteristic subgroup of this common centralizer cannot
have ambient image generated by the first element when that element is an
involution. More generally, any characteristic chain forcing the common
centralizer's normalizer to fix that involution excludes fusion.

This is the normalizer argument used in Parrott, *A characterization of the
Tits' simple group* (1972), pp.675–677. The centralizer computations in that
application are separate from the general finite-group argument here.
-/

namespace Subgroup

/-- The subgroup generated by n-th powers is characteristic. -/
public theorem closure_range_pow_characteristic
    {G : Type*} [Group G] (n : ℕ) :
    (closure (Set.range (fun x : G => x ^ n))).Characteristic := by
  apply characteristic_iff_le_comap.mpr
  intro f
  apply (closure_le _).mpr
  rintro _ ⟨x, rfl⟩
  change f (x ^ n) ∈ closure (Set.range (fun x : G => x ^ n))
  rw [map_pow]
  exact subset_closure ⟨f x, rfl⟩

/-- The ambient normalizer preserves every characteristic subgroup image. -/
public theorem normalizer_le_normalizer_characteristic_image
    {G : Type*} [Group G] (H : Subgroup G) (K : Subgroup H)
    [K.Characteristic] :
    normalizer (H : Set G) ≤ normalizer (K.map H.subtype : Set G) := by
  apply le_normalizer_iff.mpr
  intro g hg x hx
  obtain ⟨y, hy, rfl⟩ := hx
  let f := H.normalizerMonoidHom ⟨g, hg⟩
  have hfy : f y ∈ K := characteristic_iff_le_comap.mp inferInstance f hy
  exact ⟨f y, hfy, rfl⟩

/-- Normalizing a subgroup also normalizes its ambient centralizer. -/
public theorem normalizer_le_normalizer_centralizer
    {G : Type*} [Group G] (K : Subgroup G) :
    normalizer (K : Set G) ≤ normalizer (centralizer (K : Set G) : Set G) := by
  apply le_normalizer_iff.mpr
  intro g hg x hx y hy
  let f : G ≃* G := MulAut.conj g
  have hfy : f.symm y ∈ K := (hg (f.symm y)).mpr (by
    change f (f.symm y) ∈ K
    rw [f.apply_symm_apply]
    exact hy)
  have heq := congrArg f (hx (f.symm y) hfy)
  change y * f x = f x * y
  simpa only [map_mul, f.apply_symm_apply] using heq

/-- Normalizing the subgroup generated by an involution fixes the involution. -/
public theorem normalizer_zpowers_eq_centralizer_of_order_two
    {G : Type*} [Group G] [Finite G] (z : G) (hz : orderOf z = 2) :
    normalizer (zpowers z : Set G) = centralizer ({z} : Set G) := by
  classical
  apply le_antisymm
  · intro g hg
    have hmem : g * z * g⁻¹ ∈ zpowers z := (hg z).mp (mem_zpowers z)
    have hne : g * z * g⁻¹ ≠ 1 := by
      intro heq
      have hz1 : z = 1 := (MulAut.conj g).injective
        (heq.trans (map_one (MulAut.conj g)).symm)
      simp [hz1] at hz
    rw [mem_zpowers_iff_mem_range_orderOf, hz] at hmem
    obtain ⟨n, hn, heq⟩ := Finset.mem_image.mp hmem
    have hn2 := Finset.mem_range.mp hn
    have hfixed : g * z * g⁻¹ = z := by
      interval_cases n
      · exact (hne (by simpa using heq.symm)).elim
      · simpa using heq.symm
    exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hfixed)
  · intro g hg
    apply mem_normalizer_iff_map_conj_eq.mpr
    rw [MonoidHom.map_zpowers]
    have heq : (MulAut.conj g) z = z :=
      mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp hg)
    exact congrArg zpowers heq

/-- A characteristic involution line forces the whole normalizer to fix it. -/
public theorem normalizer_le_centralizer_of_characteristic_involution
    {G : Type*} [Group G] [Finite G] (H : Subgroup G) (K : Subgroup H)
    [K.Characteristic] (z : G) (hz : orderOf z = 2)
    (hK : K.map H.subtype = zpowers z) :
    normalizer (H : Set G) ≤ centralizer ({z} : Set G) := by
  have hle := normalizer_le_normalizer_characteristic_image H K
  rwa [hK, normalizer_zpowers_eq_centralizer_of_order_two z hz] at hle

/-- A small common p-centralizer of conjugate elements has a normalizer
outside either element centralizer. -/
public theorem normalizer_inf_centralizer_not_le_of_isConj
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (z t : G) (hconj : IsConj z t)
    (hp : IsPGroup p (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Subgroup G))
    (S : Sylow p (centralizer ({z} : Set G)))
    (hsmall : Nat.card (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Subgroup G) <
      Nat.card S) :
    ¬ normalizer
      (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Set G) ≤
        centralizer ({z} : Set G) := by
  classical
  let H := centralizer ({z} : Set G)
  let D := centralizer ({t} : Set G)
  let C := H ⊓ D
  have hcard : Nat.card D = Nat.card H := by
    obtain ⟨g, hg⟩ := isConj_iff.mp hconj
    let f : G ≃* G := MulAut.conj g
    have hfz : f z = t := hg
    apply (Nat.card_congr (Equiv.subtypeEquiv f.toEquiv ?_)).symm
    intro a
    change a ∈ H ↔ f a ∈ D
    simp only [H, D, mem_centralizer_singleton_iff]
    constructor
    · intro ha
      simpa only [map_mul, hfz] using congrArg f ha
    · intro ha
      apply f.injective
      simpa only [map_mul, hfz] using ha
  let K := C.subgroupOf D
  have hKD : K.map D.subtype = C := map_subgroupOf_eq_of_le inf_le_right
  have hKcard : Nat.card K = Nat.card C :=
    Nat.card_congr (subgroupOfEquivOfLe (show C ≤ D from inf_le_right)).toEquiv
  have hKp : IsPGroup p K := hp.comap_subtype
  obtain ⟨T, hKT⟩ := hKp.exists_le_sylow
  have hTcard : Nat.card T = Nat.card S := by
    rw [T.card_eq_multiplicity, S.card_eq_multiplicity, hcard]
  have hproper : K.subgroupOf (T : Subgroup D) < ⊤ := by
    rw [lt_top_iff_ne_top, Ne, subgroupOf_eq_top]
    intro hTK
    have hh := card_le_of_le hTK
    rw [hKcard, hTcard] at hh
    exact (not_le_of_gt hsmall) hh
  let : Group.IsNilpotent T := T.isPGroup'.isNilpotent
  obtain ⟨u, huN, huK⟩ := SetLike.exists_of_lt
    (Group.normalizerCondition_of_isNilpotent (K.subgroupOf (T : Subgroup D)) hproper)
  have huNK : (u : D) ∈ normalizer (K : Set D) := by
    rw [← subgroupOf_normalizer_eq hKT] at huN
    exact huN
  have huNC : ((u : D) : G) ∈ normalizer (C : Set G) := by
    rw [← hKD]
    exact K.le_normalizer_map D.subtype (mem_map_of_mem D.subtype huNK)
  intro hN
  exact huK ⟨hN huNC, (u : D).property⟩

/-- Normalizer control excludes fusion when the common centralizer is small. -/
public theorem not_isConj_of_small_common_centralizer_normalizer
    {G : Type*} [Group G] [Finite G] {p : ℕ} [Fact p.Prime]
    (z t : G)
    (hp : IsPGroup p (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Subgroup G))
    (S : Sylow p (centralizer ({z} : Set G)))
    (hsmall : Nat.card (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Subgroup G) <
      Nat.card S)
    (hN : normalizer
      (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Set G) ≤
        centralizer ({z} : Set G)) : ¬ IsConj z t := by
  intro hconj
  exact normalizer_inf_centralizer_not_le_of_isConj z t hconj hp S hsmall hN

/-- When the common centralizer has center generated by the two involutions,
a characteristic subgroup of order two rules out fusion. This also handles
an unspecified involution generating the characteristic subgroup. -/
public theorem not_isConj_of_common_centralizer_characteristic_two
    {G : Type*} [Group G] [Finite G]
    (z t : G) (hz : orderOf z = 2) (ht : orderOf t = 2) (hzt : Commute z t)
    (hp : IsPGroup 2 (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Subgroup G))
    (S : Sylow 2 (centralizer ({z} : Set G)))
    (hsmall : Nat.card (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Subgroup G) <
      Nat.card S)
    (hcenter :
      (center (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Subgroup G)).map
        (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G)).subtype =
          closure ({z, t} : Set G))
    (K : Subgroup (centralizer ({z} : Set G) ⊓ centralizer ({t} : Set G) : Subgroup G))
    [K.Characteristic] (hK : Nat.card K = 2) : ¬ IsConj z t := by
  classical
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let H := centralizer ({z} : Set G)
  let D := centralizer ({t} : Set G)
  let C := H ⊓ D
  let L := C.subgroupOf H
  have hLcard : Nat.card L = Nat.card C :=
    Nat.card_congr (subgroupOfEquivOfLe (show C ≤ H from inf_le_left)).toEquiv
  have hLp : IsPGroup 2 L := hp.comap_subtype
  obtain ⟨T, hLT⟩ := hLp.exists_le_sylow
  have hTcard : Nat.card T = Nat.card S := by
    rw [T.card_eq_multiplicity, S.card_eq_multiplicity]
  have hproper : L.subgroupOf (T : Subgroup H) < ⊤ := by
    rw [lt_top_iff_ne_top, Ne, subgroupOf_eq_top]
    intro hTL
    have hle := card_le_of_le hTL
    rw [hLcard, hTcard] at hle
    exact (not_le_of_gt hsmall) hle
  let : Group.IsNilpotent T := T.isPGroup'.isNilpotent
  obtain ⟨u, huN, huL⟩ := SetLike.exists_of_lt
    (Group.normalizerCondition_of_isNilpotent (L.subgroupOf (T : Subgroup H)) hproper)
  have huNL : (u : H) ∈ normalizer (L : Set H) := by
    rw [← subgroupOf_normalizer_eq hLT] at huN
    exact huN
  let g : G := ((u : H) : G)
  have hgNC : g ∈ normalizer (C : Set G) := by
    have hmap : L.map H.subtype = C := map_subgroupOf_eq_of_le inf_le_left
    rw [← hmap]
    exact L.le_normalizer_map H.subtype (mem_map_of_mem H.subtype huNL)
  have hgH : g ∈ H := (u : H).property
  have hgD : g ∉ D := fun hg => huL ⟨hgH, hg⟩
  obtain ⟨k, hk⟩ := exists_prime_orderOf_dvd_card' (G := K) 2 (by rw [hK])
  let kG : G := ((k : C) : G)
  have hkorder : orderOf kG = 2 :=
    (orderOf_coe (k : C)).trans ((orderOf_coe k).trans hk)
  have hkne : kG ≠ 1 := by
    intro heq
    simp [heq] at hkorder
  have hline : K.map C.subtype = zpowers kG := by
    apply (eq_of_le_of_card_ge (zpowers_le.mpr
      (mem_map_of_mem C.subtype k.property)) ?_).symm
    rw [card_map_of_injective C.subtype_injective, hK, Nat.card_zpowers]
    exact hkorder.ge
  have hNfix := normalizer_le_centralizer_of_characteristic_involution C K kG hkorder hline
  have hgk : g * kG = kG * g := mem_centralizer_singleton_iff.mp (hNfix hgNC)
  have hgz : g * z = z * g := mem_centralizer_singleton_iff.mp hgH
  have hkcenter : kG ∈ (center C).map C.subtype :=
    mem_map_of_mem C.subtype (central_of_normal_card_two K hK k.property)
  rw [hcenter] at hkcenter
  have hzsq : z * z = 1 := by simpa only [pow_two, hz] using pow_orderOf_eq_one z
  have htsq : t * t = 1 := by simpa only [pow_two, ht] using pow_orderOf_eq_one t
  have hkz : kG = z := by
    rcases (mem_closure_pair_iff z t hzsq htsq hzt kG).mp hkcenter with h1 | hz' | ht' | hzt'
    · exact (hkne h1).elim
    · exact hz'
    · exact (hgD (mem_centralizer_singleton_iff.mpr (ht' ▸ hgk))).elim
    · exfalso
      apply hgD
      apply mem_centralizer_singleton_iff.mpr
      apply mul_left_cancel (a := z)
      calc
        z * (g * t) = g * (z * t) := by rw [← mul_assoc, ← hgz, mul_assoc]
        _ = (z * t) * g := hzt' ▸ hgk
        _ = z * (t * g) := mul_assoc _ _ _
  have hN : normalizer (C : Set G) ≤ H := by
    simpa only [hkz] using hNfix
  exact not_isConj_of_small_common_centralizer_normalizer z t hp S hsmall hN

end Subgroup
