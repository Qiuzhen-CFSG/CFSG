module

public import Theory.Order.UniqueMaximalOver
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Data.SetLike.Fintype

/-!
# Generation by nonnormal unique-maximal overgroups

For a subgroup `X` of a finite group `G`, retain the overgroups `U` having a
unique maximal subgroup above `X` in which `X` is not normal. Their join is
normal in `G` and, multiplied by the normalizer of `X`, equals `G`.
If `X` is proper and normally generates `G`, these overgroups generate `G`.

McBride's finite-lattice lemma gives generation by all unique-maximal overgroups.
The discarded overgroups lie in the normalizer of `X`; that normalizer permutes
the retained family and hence normalizes its join. This proves the product
formula and normality, after which the normal-closure assertion follows.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), Definition B.6.2 and Lemma B.6.4, pp. 112–113.
-/

open scoped Pointwise

namespace Subgroup
variable {G : Type*} [Group G]
/-- The family `Û_G(X)`: unique-maximal overgroups in which `X` is not normal. -/
@[expose] public def nonNormalUniqueMaximalOvergroups (X : Subgroup G) : Set (Subgroup G) :=
  {U | Order.HasUniqueMaximalOver X U ∧ ¬ U ≤ normalizer (X : Set G)}
/-- The subgroup generated by the nonnormal unique-maximal overgroups of `X`. -/
@[expose] public def nonNormalUniqueMaximalClosure (X : Subgroup G) : Subgroup G :=
  sSup (nonNormalUniqueMaximalOvergroups X)

/-- Automorphisms transport the nonnormal unique-maximal overgroups. -/
public theorem map_nonNormalUniqueMaximalOvergroups (e : G ≃* G) {X U : Subgroup G}
    (hU : U ∈ nonNormalUniqueMaximalOvergroups X) :
    U.map e.toMonoidHom ∈ nonNormalUniqueMaximalOvergroups (X.map e.toMonoidHom) := by
  refine ⟨hU.1.map (MulEquiv.mapSubgroup e), ?_⟩
  rw [← map_normalizer_eq_of_bijective X e.bijective]
  exact fun h => hU.2 ((MulEquiv.mapSubgroup e).le_iff_le.mp h)

/-- The normalizer of `X` normalizes the join of its retained overgroups. -/
public theorem normalizer_le_normalizer_nonNormalUniqueMaximalClosure (X : Subgroup G) :
    normalizer (X : Set G) ≤ normalizer (nonNormalUniqueMaximalClosure X : Set G) := by
  apply le_normalizer_iff.mpr
  intro g hg x hx
  have hfix : X.map (MulAut.conj g).toMonoidHom = X :=
    mem_normalizer_iff_map_conj_eq.mp hg
  have hle :
      (nonNormalUniqueMaximalClosure X).map (MulAut.conj g).toMonoidHom ≤
        nonNormalUniqueMaximalClosure X := by
    change (MulEquiv.mapSubgroup (MulAut.conj g))
      (sSup (nonNormalUniqueMaximalOvergroups X)) ≤ _
    rw [OrderIso.map_sSup]
    refine iSup_le fun U => iSup_le fun hU => le_sSup ?_
    have h := map_nonNormalUniqueMaximalOvergroups (MulAut.conj g) hU
    rwa [hfix] at h
  exact hle (mem_map_of_mem (MulAut.conj g).toMonoidHom hx)

/-- The retained overgroups and the normalizer of `X` generate the whole group (B.6.4(1)). -/
public theorem nonNormalUniqueMaximalClosure_sup_normalizer [Finite G] (X : Subgroup G) :
    nonNormalUniqueMaximalClosure X ⊔ normalizer (X : Set G) = ⊤ := by
  classical
  by_cases hX : X = ⊤
  · subst X
    exact top_unique (le_sup_right.trans' (show (⊤ : Subgroup G) ≤ normalizer (⊤ : Subgroup G) from le_normalizer))
  · have hgen := Order.eq_sSup_hasUniqueMaximalOver (lt_top_iff_ne_top.mpr hX)
    apply top_unique
    conv_lhs => rw [hgen]
    refine sSup_le fun U hU => ?_
    by_cases hUn : U ≤ normalizer (X : Set G)
    · exact hUn.trans le_sup_right
    · exact (le_sSup (show U ∈ nonNormalUniqueMaximalOvergroups X from ⟨hU.2, hUn⟩)).trans
        le_sup_left

/-- The join of the retained overgroups is normal (B.6.4(1)). -/
public theorem nonNormalUniqueMaximalClosure_normal [Finite G] (X : Subgroup G) :
    (nonNormalUniqueMaximalClosure X).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← nonNormalUniqueMaximalClosure_sup_normalizer X]
  exact sup_le le_normalizer (normalizer_le_normalizer_nonNormalUniqueMaximalClosure X)

/-- The generation statement is a setwise product, as in B.6.4(1). -/
public theorem nonNormalUniqueMaximalClosure_mul_normalizer [Finite G] (X : Subgroup G) :
    (nonNormalUniqueMaximalClosure X : Set G) * (normalizer (X : Set G) : Set G) =
      Set.univ := by
  rw [← coe_mul_of_right_le_normalizer_left _ _
    (normalizer_le_normalizer_nonNormalUniqueMaximalClosure X),
    nonNormalUniqueMaximalClosure_sup_normalizer]
  rfl

/-- A proper subgroup that normally generates the group has retained overgroups generating it (B.6.4(2)). -/
public theorem nonNormalUniqueMaximalClosure_eq_top [Finite G] (X : Subgroup G)
    (hX : X < ⊤) (hclosure : normalClosure (X : Set G) = ⊤) :
    nonNormalUniqueMaximalClosure X = ⊤ := by
  classical
  have hne : (nonNormalUniqueMaximalOvergroups X).Nonempty := by
    by_contra hn
    have hempty : nonNormalUniqueMaximalOvergroups X = ∅ := Set.not_nonempty_iff_eq_empty.mp hn
    have hnorm : normalizer (X : Set G) = ⊤ := by
      simpa [nonNormalUniqueMaximalClosure, hempty] using
        nonNormalUniqueMaximalClosure_sup_normalizer X
    have : X.Normal := normalizer_eq_top_iff.mp hnorm
    rw [normalClosure_eq_self] at hclosure
    exact hX.ne hclosure
  obtain ⟨U, hU⟩ := hne
  have hle : X ≤ nonNormalUniqueMaximalClosure X := hU.1.1.le.trans (le_sSup hU)
  have : (nonNormalUniqueMaximalClosure X).Normal := nonNormalUniqueMaximalClosure_normal X
  apply top_unique
  rw [← hclosure]
  exact normalClosure_le_normal hle
/-- A normal subgroup either lies in the core of the unique maximal overgroup,
or generates the ambient group together with `X`. This is the generation step
in the proof of Aschbacher–Smith B.6.8(4). -/
public theorem normal_le_core_or_sup_eq_top_of_uniqueMaximal [Finite G]
    {X M N : Subgroup G} [N.Normal]
    (h : Order.HasUniqueMaximalOver X ⊤) (hM : X ≤ M ∧ IsCoatom M) :
    N ≤ M.normalCore ∨ X ⊔ N = ⊤ := by
  classical
  by_cases hNM : N ≤ M
  · exact Or.inl (normal_le_normalCore.mpr hNM)
  · right
    by_contra hp
    exact hNM (le_sup_right.trans
      (h.le_maximal ⟨hM.1, hM.2.covBy_top⟩ le_sup_left (lt_top_iff_ne_top.mpr hp)))

end Subgroup
