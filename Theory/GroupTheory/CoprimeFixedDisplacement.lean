module
public import Theory.GroupTheory.CoprimeCentralizerDirectProduct
public import Theory.GroupTheory.TwoFixedLinesIrreducible
public import Theory.GroupTheory.Commutator.FixedSeedKernel

/-!
# Detecting coprime displacement on a p-group fixed subgroup

Let an actor A of coprime order normalize an abelian p-group V. If A fixes
C_V(S), for a p-group S, and S normalizes [V,A], then A fixes V. Otherwise
the p-group fixed-point theorem gives a nonidentity point in
[V,A] intersect C_V(S), contradicting coprime fixed/moved disjointness.

Normalization of the image of A modulo a kernel centralizing V suffices
for the displacement-invariance premise. This retains the original V and
does not require V to be generated by its S-fixed points under another actor.
Source application: Aschbacher--Smith 4.4.14 and 10.2.3(2), printed pp.624--625,745.
-/

public section
open scoped IsMulCommutative
namespace Subgroup
variable {G Q : Type*} [Group G] [Finite G] [Group Q]

/-- Coprime displacement normalized by a p-group is detected on its fixed subgroup. -/
theorem commutator_eq_bot_of_fixed_centralizer_of_normalizes_displacement
    {p : ℕ} [Fact p.Prime] (V A S : Subgroup G) [IsMulCommutative V]
    (hV : IsPGroup p V) (hS : IsPGroup p S)
    (hAV : A ≤ normalizer (V : Set G))
    (hcop : Nat.Coprime (Nat.card A) (Nat.card V))
    (hfix : V ⊓ centralizer (S : Set G) ≤ centralizer (A : Set G))
    (hSW : S ≤ normalizer (⁅V,A⁆ : Subgroup G)) : ⁅V,A⁆ = ⊥ := by
  have hWV : ⁅V,A⁆ ≤ V := le_normalizer_iff_commutator_le_left.mp hAV
  by_contra hne
  apply inf_centralizer_ne_bot_of_pGroups S ⁅V,A⁆ hS (hV.to_le hWV) hSW hne
  apply bot_unique
  apply le_trans _ (commutator_disjoint_centralizer_of_coprime V A hAV hcop).eq_bot.le
  exact le_inf inf_le_left (le_inf (inf_le_left.trans hWV)
    ((inf_le_inf_right _ hWV).trans hfix))

omit [Finite G] in
/-- Normalization of the actual actor image normalizes its displacement,
even when the original actor subgroup is not normalized. -/
theorem normalizes_commutator_of_normalizes_image
    (V A S : Subgroup G) (q : G →* Q)
    (hker : q.ker ≤ centralizer (V : Set G))
    (hSV : S ≤ normalizer (V : Set G))
    (himage : S.map q ≤ normalizer (A.map q : Set Q)) :
    S ≤ normalizer (⁅V,A⁆ : Subgroup G) := by
  intro s hs
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [map_commutator,mem_normalizer_iff_map_conj_eq.mp (hSV hs)]
  apply commutator_eq_of_centralizing_kernel V V _ A q hker le_rfl
  have he := mem_normalizer_iff_map_conj_eq.mp (himage (mem_map_of_mem q hs))
  rw [map_map] at he ⊢
  convert he using 1
  congr 1
  ext a
  simp only [MonoidHom.comp_apply, MulAut.conj_apply,
    MonoidHom.coe_coe, map_mul, map_inv]

/-- A normalized coprime actor image fixing the p-group fixed subgroup fixes V. -/
theorem commutator_eq_bot_of_fixed_centralizer_of_normalizes_image
    {p : ℕ} [Fact p.Prime] (V A S : Subgroup G) [IsMulCommutative V]
    (hV : IsPGroup p V) (hS : IsPGroup p S)
    (hAV : A ≤ normalizer (V : Set G))
    (hcop : Nat.Coprime (Nat.card A) (Nat.card V))
    (hfix : V ⊓ centralizer (S : Set G) ≤ centralizer (A : Set G))
    (q : G →* Q) (hker : q.ker ≤ centralizer (V : Set G))
    (hSV : S ≤ normalizer (V : Set G))
    (himage : S.map q ≤ normalizer (A.map q : Set Q)) : ⁅V,A⁆ = ⊥ :=
  commutator_eq_bot_of_fixed_centralizer_of_normalizes_displacement V A S hV hS hAV hcop
    hfix (normalizes_commutator_of_normalizes_image V A S q hker hSV himage)

end Subgroup
