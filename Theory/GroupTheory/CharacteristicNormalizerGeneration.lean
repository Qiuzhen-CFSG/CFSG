module

public import Theory.GroupTheory.CharacteristicNormalizerClosure

/-!
# Generation by a subgroup normalizer and a local subgroup

If G is generated by N_G(S) and Y, a characteristic subgroup of S normalized
by Y is normal in G. Similarly, if G is generated by Y and C_G(Z), any
subgroup of Z centralized by Y is central in G. These lattice arguments are
the final generation steps in Glauberman's Argument.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), proof of C.1.21(2–3), pp.128–129.
-/

public section

namespace Subgroup

variable {G : Type*} [Group G]

/-- Normalizing a characteristic subgroup and generating with the normalizer
of its parent subgroup makes the characteristic subgroup normal. -/
theorem normal_characteristic_image_of_normalizer_sup_eq_top
    (S Y : Subgroup G) (D : Subgroup S) [D.Characteristic]
    (hgen : normalizer (S : Set G) ⊔ Y = ⊤)
    (hY : Y ≤ normalizer (D.map S.subtype : Set G)) :
    (D.map S.subtype).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_le_iff.mp
  rw [← hgen]
  exact sup_le (normalizer_le_normalizer_characteristic_image S D) hY

/-- Centralizing a subgroup and generating with a suitable centralizer makes
that subgroup central in the whole group. -/
theorem le_center_of_sup_centralizer_eq_top (Y Z D : Subgroup G) (hDZ : D ≤ Z)
    (hgen : Y ⊔ centralizer (Z : Set G) = ⊤)
    (hY : Y ≤ centralizer (D : Set G)) : D ≤ center G := by
  apply centralizer_eq_top_iff_subset.mp
  apply top_le_iff.mp
  rw [← hgen]
  exact sup_le hY (centralizer_le hDZ)

/-- Both normalizers of nontrivial characteristic subgroups are in C(G,S). -/
theorem normalizer_pair_le_characteristicNormalizerClosure
    (S : Subgroup G) (C₁ C₂ : Subgroup S) [C₁.Characteristic] [C₂.Characteristic]
    (h₁ : C₁ ≠ ⊥) (h₂ : C₂ ≠ ⊥) :
    normalizer (C₁.map S.subtype : Set G) ⊔ normalizer (C₂.map S.subtype : Set G) ≤
      characteristicNormalizerClosure S :=
  sup_le (normalizer_le_characteristicNormalizerClosure S C₁ h₁)
    (normalizer_le_characteristicNormalizerClosure S C₂ h₂)

/-- The centralizer-normalizer join used in the local C(G,T) theorem lies
in C(G,S). -/
theorem centralizer_normalizer_le_characteristicNormalizerClosure
    (S : Subgroup G) (C₁ C₂ : Subgroup S) [C₁.Characteristic] [C₂.Characteristic]
    (h₁ : C₁ ≠ ⊥) (h₂ : C₂ ≠ ⊥) :
    centralizer (C₁.map S.subtype : Set G) ⊔ normalizer (C₂.map S.subtype : Set G) ≤
      characteristicNormalizerClosure S :=
  (sup_le_sup (centralizer_le_normalizer _) le_rfl).trans
    (normalizer_pair_le_characteristicNormalizerClosure S C₁ C₂ h₁ h₂)

end Subgroup
