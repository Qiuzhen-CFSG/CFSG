module
public import Mathlib.GroupTheory.SpecificGroups.Quaternion
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Tactic.Group

/-!
# Recognition of a generalized quaternion presentation

A group generated by `c` and `d`, with `c` of order `2 * m`, `d² = c^m`,
and conjugation by `d` inverting `c`, is isomorphic to `QuaternionGroup m`
when its cardinality is `4 * m` and `m > 0`.

The proof constructs the presentation map on the two normal forms of Mathlib's
quaternion group: `a i` maps to `c^i` and `xa i` maps to `d * c^i`. Powers
factor through `ZMod (2 * m)` by the order hypothesis. The inversion relation
checks the four multiplication cases; the generators give surjectivity, and
the cardinality hypothesis upgrades it to bijectivity. All implementation
helpers are private; the recognition theorem is the public interface.

This is the standard generalized quaternion presentation used in
Alperin–Brauer–Gorenstein, Chapter II, Lemma 1(iii), article p.9, to identify
one of the maximal subgroups of a quasi-dihedral group. The theorem is general
and requires no classification or quasi-dihedral hypotheses.
-/

namespace QuaternionGroup
variable {G : Type*} [Group G] {m : ℕ} [NeZero m]

private def rotation (c : G) (i : ZMod (2 * m)) : G := c ^ i.val

private theorem rotation_add (c : G) (hc : orderOf c = 2 * m)
    (i j : ZMod (2 * m)) : rotation c (i + j) = rotation c i * rotation c j := by
  simp only [rotation, ZMod.val_add]
  rw [← pow_add]
  simpa only [hc] using pow_mod_orderOf c (i.val + j.val)

omit [NeZero m] in
private theorem rotation_natCast (c : G) (hc : orderOf c = 2 * m) (k : ℕ) :
    rotation c (k : ZMod (2 * m)) = c ^ k := by
  simp only [rotation, ZMod.val_natCast]
  rw [← hc, pow_mod_orderOf]

omit [NeZero m] in
private theorem rotation_zero (c : G) : rotation (m := m) c 0 = 1 := by
  simp [rotation]

private theorem rotation_neg (c : G) (hc : orderOf c = 2 * m)
    (i : ZMod (2 * m)) : rotation c (-i) = (rotation c i)⁻¹ := by
  apply eq_inv_of_mul_eq_one_left
  rw [← rotation_add c hc, neg_add_cancel, rotation_zero]

private theorem rotation_sub (c : G) (hc : orderOf c = 2 * m)
    (i j : ZMod (2 * m)) : rotation c (i - j) = rotation c i * (rotation c j)⁻¹ := by
  rw [sub_eq_add_neg, rotation_add c hc, rotation_neg c hc]

private theorem pow_mul_twist (c d : G) (hinv : d * c * d⁻¹ = c⁻¹) (k : ℕ) :
    c ^ k * d = d * (c ^ k)⁻¹ := by
  have h : c * d = d * c⁻¹ := by
    have h' := congrArg Inv.inv hinv
    simp only [mul_inv_rev, inv_inv] at h'
    calc
      c * d = (d * c⁻¹ * d⁻¹) * d := by simpa only [mul_assoc] using congrArg (· * d) h'.symm
      _ = d * c⁻¹ := by group
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ, mul_assoc, h, ← mul_assoc, ih]
    group

private def presentationHom (c d : G) (hc : orderOf c = 2 * m)
    (hsq : d ^ 2 = c ^ m) (hinv : d * c * d⁻¹ = c⁻¹) : QuaternionGroup m →* G where
  toFun
    | a i => rotation c i
    | xa i => d * rotation c i
  map_one' := rotation_zero c
  map_mul' := by
    have ht (i : ZMod (2 * m)) : rotation c i * d = d * (rotation c i)⁻¹ :=
      pow_mul_twist c d hinv i.val
    rintro (i | i) (j | j)
    · exact rotation_add c hc i j
    · change d * rotation c (j - i) = rotation c i * (d * rotation c j)
      rw [rotation_sub c hc]
      rw [← mul_assoc (rotation c i), ht]
      have hcomm : Commute (rotation c i) (rotation c j) := by
        exact Commute.pow_pow (Commute.refl c) _ _
      rw [mul_assoc, ← hcomm.inv_left.eq]
    · change d * rotation c (i + j) = (d * rotation c i) * rotation c j
      rw [rotation_add c hc, mul_assoc]
    · change rotation c ((m : ZMod (2 * m)) + j - i) =
        (d * rotation c i) * (d * rotation c j)
      rw [rotation_sub c hc, rotation_add c hc, rotation_natCast c hc]
      calc
        c ^ m * rotation c j * (rotation c i)⁻¹ =
            c ^ m * (rotation c i)⁻¹ * rotation c j := by
          have hcomm : Commute (rotation c i) (rotation c j) :=
            Commute.pow_pow (Commute.refl c) _ _
          rw [mul_assoc, ← hcomm.inv_left.eq, ← mul_assoc]
        _ = (d * rotation c i) * (d * rotation c j) := by
          rw [← hsq, pow_two]
          calc
            d * d * (rotation c i)⁻¹ * rotation c j =
                d * (rotation c i * d) * rotation c j := by rw [ht]; simp only [mul_assoc]
            _ = _ := by group

omit [NeZero m] in
/-- A group of order `4 * m` with the quaternion generators and relations is the
standard generalized quaternion group. -/
public theorem quaternionGroup_equiv_of_presentation
    (hm : 0 < m) (c d : G) (hc : orderOf c = 2 * m)
    (hsq : d ^ 2 = c ^ m) (hinv : d * c * d⁻¹ = c⁻¹)
    (hgen : Subgroup.closure ({c, d} : Set G) = ⊤)
    (hcard : Nat.card G = 4 * m) : Nonempty (G ≃* QuaternionGroup m) := by
  let : NeZero m := ⟨Nat.ne_of_gt hm⟩
  let f := presentationHom c d hc hsq hinv
  have hsurj : Function.Surjective f := by
    apply MonoidHom.range_eq_top.mp
    apply top_unique
    rw [← hgen]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with hx | hx
    · subst x
      refine ⟨a 1, ?_⟩
      change rotation c 1 = c
      simpa using rotation_natCast c hc 1
    · have hx' : x = d := Set.mem_singleton_iff.mp hx
      subst x
      refine ⟨xa 0, ?_⟩
      change d * rotation c 0 = d
      rw [rotation_zero, mul_one]
  have hbij : Function.Bijective f := hsurj.bijective_of_nat_card_le (by
    rw [hcard, Nat.card_eq_fintype_card, QuaternionGroup.card])
  exact ⟨(MulEquiv.ofBijective f hbij).symm⟩

end QuaternionGroup
