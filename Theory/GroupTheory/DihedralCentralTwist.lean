module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Tactic.Group

/-!
# Removing a central twist from a dihedral action

Suppose r and y are involutions, (ry)^5 = 1, and x^2 = yz, where z is
central in the subgroup generated by x,y,r and z^2 = 1. If the discrepancy
between ryr and x⁻¹rx lies in ⟨z⟩, then rxr = (yr)^2 x.

The nontrivial possible discrepancy would give r^x = ryrz. Applying the
same conjugation twice gives (ry)^3 rz = yry, whereas (ry)^5 = 1 gives
(ry)^3 r = yry. Thus this discrepancy is trivial. This supplies the final
central-error removal in Parrott's equation (24) directly from the power
relations, without an additional fusion assertion.

Source: D. Parrott, *A characterization of the Tits' simple group* (1972),
printed p.681, the argument immediately preceding equation (24).
-/

namespace Theory.GroupTheory

variable {G : Type*} [Group G] {z x y r : G}

private theorem sqinv {a : G} (h : a ^ 2 = 1) : a⁻¹ = a :=
  inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using h)

private theorem tail {a b c : G} (h : a * b = c) (d : G) : a * (b * d) = c * d := by
  rw [← mul_assoc, h]

private theorem conjmul (g a b : G) :
    g⁻¹ * (a * b) * g = (g⁻¹ * a * g) * (g⁻¹ * b * g) := by group

/-- The central involution discrepancy vanishes because conjugation by x,
applied twice, is conjugation by y. -/
public theorem dihedral_word_of_central_involution_discrepancy (hz : z ^ 2 = 1) (hy : y ^ 2 = 1) (hr : r ^ 2 = 1)
    (hry : (r * y) ^ 5 = 1) (hx : x ^ 2 = y * z)
    (hzx : Commute z x) (hzy : Commute z y) (hzr : Commute z r)
    (hc : r * y * r * (x⁻¹ * r * x) ∈ Subgroup.zpowers z) :
    r * x * r = (y * r) ^ 2 * x := by
  have hinvr := sqinv hr
  have hinvy := sqinv hy
  have hinvz := sqinv hz
  have sqz : z * z = 1 := by simpa only [pow_two] using hz
  have hxy : Commute x y := by
    have he : y = x ^ 2 * z := by rw [hx, mul_assoc, sqz, mul_one]
    rw [he]
    exact (Commute.self_pow x 2).mul_right hzx.symm
  have heven : r * y * r * y * r * y * r = y * r * y := by
    apply (mul_inv_eq_one).mp
    simp only [mul_inv_rev, hinvr, hinvy]
    simpa only [pow_succ, pow_zero, one_mul, mul_assoc] using hry
  have hfixy : x⁻¹ * y * x = y := by rw [mul_assoc, hxy.symm.eq, inv_mul_cancel_left]
  have hfixz : x⁻¹ * z * x = z := by rw [mul_assoc, hzx.eq, inv_mul_cancel_left]
  have hcases : r * y * r * (x⁻¹ * r * x) = 1 ∨
      r * y * r * (x⁻¹ * r * x) = z := by
    obtain ⟨k, hk⟩ := hc
    have ho : orderOf z ∣ 2 := orderOf_dvd_of_pow_eq_one hz
    have hzpow : ∀ k : ℤ, z ^ k = 1 ∨ z ^ k = z := by
      intro k
      have he := zpow_mod_orderOf z k
      rcases Nat.dvd_prime Nat.prime_two |>.mp ho with h | h
      · have hz1 := orderOf_eq_one_iff.mp h
        simp [hz1]
      · rw [h] at he
        have hm := Int.emod_nonneg k (by decide : (2 : ℤ) ≠ 0)
        have hn := Int.emod_lt_of_pos k (by decide : (0 : ℤ) < 2)
        have hh : k % 2 = 0 ∨ k % 2 = 1 := by omega
        rcases hh with hh | hh <;> simp [hh] at he
        · exact Or.inl he.symm
        · exact Or.inr he.symm
    exact hk ▸ hzpow k
  have hconj : x⁻¹ * r * x = r * y * r := by
    rcases hcases with hcase | hcase
    · have hh := mul_eq_one_iff_eq_inv.mp hcase
      simpa only [mul_inv_rev, hinvr, hinvy, inv_inv, mul_assoc] using hh.symm
    · have he : x⁻¹ * r * x = r * y * r * z := by
        calc
          _ = (r * y * r)⁻¹ * (r * y * r * (x⁻¹ * r * x)) := by group
          _ = r * y * r * z := by
            rw [hcase]; simp only [mul_inv_rev, hinvr, hinvy, mul_assoc]
      have hdouble : x⁻¹ * (x⁻¹ * r * x) * x = y * r * y := by
        calc
          _ = (x ^ 2)⁻¹ * r * x ^ 2 := by simp only [pow_two]; group
          _ = (y * z)⁻¹ * r * (y * z) := by rw [hx]
          _ = y * r * y := by
            simp only [mul_inv_rev, hinvy, hinvz, mul_assoc, tail hzy.eq,
              tail hzr.eq, sqz, mul_one]
      have hmap : x⁻¹ * (r * y * r * z) * x =
          (x⁻¹ * r * x) * y * (x⁻¹ * r * x) * z := by
        simp only [conjmul, hfixy, hfixz]
      rw [he, hmap, he] at hdouble
      have htriple : (r * y * r * z) * y * (r * y * r * z) * z =
          (r * y * r * y * r * y * r) * z := by
        simp only [mul_assoc, tail hzy.eq, tail hzr.eq, sqz, mul_one]
      rw [htriple, heven] at hdouble
      have heq : z = 1 := mul_left_cancel (hdouble.trans (mul_one _).symm)
      simpa [heq] using he
  have hxrx : x * r * x⁻¹ = y * r * y * r * y := by
    calc
      _ = x⁻¹ * (x ^ 2 * r * (x ^ 2)⁻¹) * x := by simp only [pow_two]; group
      _ = x⁻¹ * ((y * z) * r * (y * z)⁻¹) * x := by rw [hx]
      _ = x⁻¹ * (y * r * y) * x := by
        congr 2
        simp only [mul_inv_rev, hinvy, hinvz, mul_assoc, tail hzr.eq,
          tail sqz, one_mul]
      _ = y * (x⁻¹ * r * x) * y := by simp only [conjmul, hfixy]
      _ = _ := by rw [hconj]; group
  calc
    r * x * r = r * (x * r * x⁻¹) * x := by group
    _ = (r * y) ^ 3 * x := by rw [hxrx]; simp only [pow_succ, pow_zero, one_mul, mul_assoc]
    _ = (y * r) ^ 2 * x := by
      apply congrArg (· * x)
      apply (mul_inv_eq_one).mp
      rw [← inv_pow, mul_inv_rev, hinvr, hinvy, ← pow_add]
      exact hry

end Theory.GroupTheory
