module
public import Theory.GroupTheory.QuaternionResidualSwapEquivalence
public import Theory.GroupTheory.IndexTwoExtensionEquivalence

/-!
# Comparing the subgroup generated by a quaternion residual and a swap

The residual comparison remains equivariant even if the ambient group has
an additional outer coset. Restricting to the subgroup of twice the residual
order and extending across the chosen swapping involution recovers the
ordinary point group inside that ambient group.

The consumer is the normal subgroup O²(H)V in the doubled branch of
Aschbacher--Smith 13.5.17, printed p.922. No complement in the whole ambient
group is assumed.
-/

public noncomputable section
open Subgroup
namespace Subgroup.QuaternionResidualCentralProduct

/-- The ordinary subgroup generated by the residual and its marked swap is
recognized even in a larger ambient group. -/
theorem exists_mulEquiv_subgroup_of_swap
    {G P : Type*} [Group G] [Finite G] [Group P] [Finite P]
    {Q : Subgroup G} {Q' : Subgroup P}
    {d : QuaternionCentralProductData Q} {d' : QuaternionCentralProductData Q'}
    (c : QuaternionResidualCentralProduct Q d) (c' : QuaternionResidualCentralProduct Q' d')
    (J : Subgroup G) (hR : pResidual 2 G ≤ J)
    (hcJ : Nat.card J = 2 * Nat.card (pResidual 2 G))
    (v : G) (hvJ : v ∈ J) (w : P) (hv : v^2=1) (hw : w^2=1)
    (hvR : v ∉ pResidual 2 G)
    (hcomp : (pResidual 2 P).IsComplement' (zpowers w))
    (hs : c.left.map (MulAut.conj v).toMonoidHom=c.right)
    (ht : c'.left.map (MulAut.conj w).toMonoidHom=c'.right)
    (eL : c.left ≃* c'.left) :
    ∃ e : J ≃* P, e ⟨v,hvJ⟩=w := by
  obtain ⟨eR,_,ha⟩ := c.exists_residual_equiv_of_swap c' v w hv hw hs ht eL
  let N := (pResidual 2 G).subgroupOf J
  let vJ : J := ⟨v,hvJ⟩
  have hi : N.index=2 := by
    have h := N.card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe hR).toEquiv,hcJ] at h
    have hp := Nat.card_pos (α := pResidual 2 G)
    nlinarith
  have hw2 : orderOf w=2 := c'.swapper_order_two w hw ht
  have hi' : (pResidual 2 P).index=2 := by
    rw [hcomp.symm.index_eq_card,Nat.card_zpowers,hw2]
  have hwR : w ∉ pResidual 2 P := by
    intro hh
    have he : w=1 := hcomp.disjoint.le_bot ⟨hh,mem_zpowers w⟩
    rw [he,orderOf_one] at hw2
    contradiction
  let eN : N ≃* pResidual 2 P := (subgroupOfEquivOfLe hR).trans eR
  obtain ⟨e,_,hev⟩ := exists_mulEquiv_of_index_two_extensions N (pResidual 2 P)
    hi hi' vJ w hvR hwR eN (by
      have hh : vJ^2=1 := Subtype.ext hv
      have hz : (⟨vJ^2,N.sq_mem_of_index_two hi vJ⟩ : N)=1 := Subtype.ext hh
      rw [hz,map_one,hw]
      rfl) (by
        intro x
        change (eR ((MulAut.conjNormal v : MulAut (pResidual 2 G))
          ((subgroupOfEquivOfLe hR) x)) : P) =
            w * (eR ((subgroupOfEquivOfLe hR) x) : P) * w⁻¹
        exact congrArg Subtype.val (ha ((subgroupOfEquivOfLe hR) x)))
  exact ⟨e,hev⟩
end Subgroup.QuaternionResidualCentralProduct
