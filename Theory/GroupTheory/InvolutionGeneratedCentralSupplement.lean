module
public import Theory.GroupTheory.InvolutionGeneratedElementary
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Involution generation through a central elementary supplement

If W is generated by involutions and W = I E with E central and elementary
abelian of exponent two, then I is generated by involutions. Decomposing an
involution as i e makes i an involution, since i and e commute. The resulting
generators cover W together with E; their intersection with I absorbs E ∩ I.

This supplies the intersection step in DGS, *Groups and Graphs* (1985),
8.4(3), p.138, when the strict residual index forces the central supplement.
The central supplement is essential: arbitrary intersections of groups
generated by involutions need not be generated by involutions.
-/

open scoped Pointwise
open Subgroup

namespace Subgroup
variable {G : Type*} [Group G]

/-- A central elementary supplement allows involution generation to descend. -/
public theorem involutionGenerated_eq_of_central_elementary_supplement (W I E : Subgroup G) [IsElementaryAbelian 2 E]
    (hgen : involutionGenerated W = W) (hjoin : I ⊔ E = W)
    (hc : E ≤ centralizer (I : Set G)) : involutionGenerated I = I := by
  have split (A : Subgroup G) (hEA : E ≤ normalizer (A : Set G))
      {x : G} (hx : x ∈ A ⊔ E) : ∃ a ∈ A, ∃ e ∈ E, a * e = x := by
    have he : x ∈ (A : Set G) * (E : Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left A E hEA]
      exact hx
    exact he
  have hEI : E ≤ normalizer (I : Set G) := hc.trans (centralizer_le_normalizer _)
  have hW : W ≤ involutionGenerated I ⊔ E := by
    rw [← hgen]
    apply (involutionGenerated_le_iff _ _).mpr
    intro x hx hx2
    obtain ⟨i,hi,e,he,rfl⟩ := split I hEI (hjoin.symm ▸ hx)
    have hie : Commute i e := hc he i hi
    have hi2 : i ^ 2 = 1 := by
      rw [hie.mul_pow,elemPow_eq_one_of_isElementaryAbelian (p := 2) e he,mul_one] at hx2
      exact hx2
    exact mul_mem_sup (subset_closure ⟨hi,hi2⟩) he
  apply le_antisymm (involutionGenerated_le I)
  intro x hx
  obtain ⟨i,hi,e,he,heq⟩ := split (involutionGenerated I)
    (hEI.trans (normalizer_le_normalizer_involutionGenerated I))
    (hW ((show I ≤ W from hjoin ▸ le_sup_left) hx))
  have heI : e ∈ I := by
    have hh := I.mul_mem (I.inv_mem (involutionGenerated_le I hi)) hx
    rwa [←heq,inv_mul_cancel_left] at hh
  rw [←heq]
  exact (involutionGenerated I).mul_mem hi (subset_closure
    ⟨heI,elemPow_eq_one_of_isElementaryAbelian (p := 2) e he⟩)

end Subgroup
