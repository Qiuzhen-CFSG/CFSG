module
public import Theory.GroupTheory.ConjugateSubgroupClosure
/-!
# Conjugation transports whole-subgroup closure

A conjugate of an ambient conjugate of Z is another such conjugate.
Consequently the closure generated by whole conjugates contained in P
commutes with conjugation of P. This is the Sylow transport used in
Aschbacher–Smith, 2.4.20(6), printed p.535.
-/
public section
namespace Subgroup
variable {G : Type*} [Group G]

theorem map_conj_conjugateSubgroupClosure_le (Z P : Subgroup G) (m : G) :
    (conjugateSubgroupClosure Z P).map (MulAut.conj m).toMonoidHom ≤
      conjugateSubgroupClosure Z (P.map (MulAut.conj m).toMonoidHom) := by
  apply map_le_iff_le_comap.mpr
  apply conjugateSubgroupClosure_le
  intro g hg a ha
  change (MulAut.conj m) a ∈ conjugateSubgroupClosure Z (P.map (MulAut.conj m).toMonoidHom)
  have he : Z.map (MulAut.conj (m*g)).toMonoidHom =
      (Z.map (MulAut.conj g).toMonoidHom).map (MulAut.conj m).toMonoidHom := conjBy_mul Z m g
  have hh : Z.map (MulAut.conj (m*g)).toMonoidHom ≤ P.map (MulAut.conj m).toMonoidHom := by
    rw [he]
    exact map_mono hg
  apply map_conj_le_conjugateSubgroupClosure Z (m*g) hh
  rw [he]
  exact mem_map_of_mem (MulAut.conj m).toMonoidHom ha

theorem map_conj_conjugateSubgroupClosure (Z P : Subgroup G) (m : G) :
    (conjugateSubgroupClosure Z P).map (MulAut.conj m).toMonoidHom =
      conjugateSubgroupClosure Z (P.map (MulAut.conj m).toMonoidHom) := by
  refine le_antisymm (map_conj_conjugateSubgroupClosure_le Z P m) ?_
  have hh := map_conj_conjugateSubgroupClosure_le Z (P.map (MulAut.conj m).toMonoidHom) m⁻¹
  have he : (P.map (MulAut.conj m).toMonoidHom).map (MulAut.conj m⁻¹).toMonoidHom = P :=
    conjBy_inv P m
  rw [he] at hh
  intro a ha
  refine ⟨(MulAut.conj m).symm a,?_,(MulAut.conj m).apply_symm_apply a⟩
  apply hh
  have he' : (MulAut.conj m).symm a = (MulAut.conj m⁻¹) a := by
    apply (MulAut.conj m).injective
    simp only [MulEquiv.apply_symm_apply, MulAut.conj_apply]
    group
  rw [he']
  exact mem_map_of_mem (MulAut.conj m⁻¹).toMonoidHom ha
end Subgroup
