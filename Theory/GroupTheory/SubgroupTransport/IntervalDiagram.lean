module
public import Theory.GroupTheory.SubgroupTransport.IntersectionLattice
public import Theory.GroupTheory.SubgroupTransport.IntersectionCommutators
public import Theory.ElementaryAbelian.Injective

/-!
# Interval coordinates for a partial-isomorphism rectangle

Reindexing the intersection rectangle by interval endpoints makes meets
literal interval intersections. Adjacent reconstruction makes overlapping
joins literal unions and expresses every interval as the join of its
singleton cells. Restricted isomorphisms transfer elementary abelianness
to deeper diagonals and transport the shifted-center commutator estimate.

Source: Niles, *Pushing-up in finite groups* (1979), Theorem 4.7(a) and the
first assertion of (d), pp.47–48. Natural endpoints here are the printed
integer endpoints plus one; this preserves the interval lengths.
-/

public section
open Subgroup
namespace Theory.GroupTheory.SubgroupTransport
variable {G : Type*} [Group G] {S T : Subgroup G}

/-- The interval with endpoints i and j in a rectangle cut at depth w.
The source's integer endpoints are shifted up by one. -/
@[expose] noncomputable def intervalDiagram (φ : S ≃* T) (w i j : ℕ) : Subgroup G :=
  intervalCell φ i (w - j)

theorem intervalDiagram_mono (φ : S ≃* T) {w i j k l : ℕ}
    (hki : k ≤ i) (hjl : j ≤ l) :
    intervalDiagram φ w i j ≤ intervalDiagram φ w k l :=
  intervalCell_antitone φ hki (Nat.sub_le_sub_left hjl w)

theorem intervalDiagram_inf (φ : S ≃* T) (w i j k l : ℕ) :
    intervalDiagram φ w i j ⊓ intervalDiagram φ w k l =
      intervalDiagram φ w (max i k) (min j l) := by
  unfold intervalDiagram
  rw [intervalCell_inf]
  congr 1
  omega

theorem image_intervalDiagram (φ : S ≃* T) {w i j : ℕ} (hj : j < w) :
    image φ (intervalDiagram φ w i j) = intervalDiagram φ w (i + 1) (j + 1) := by
  unfold intervalDiagram
  rw [show w - j = (w - (j + 1)) + 1 by omega, image_intervalCell]

/-- Adjacent reconstruction propagates any subgroup bound from a terminal
diagonal to its root. -/
theorem intervalCell_le_of_diagonal (φ : S ≃* T) (U : Subgroup G) (a b n : ℕ)
    (hdiag : ∀ i j : ℕ, i + j = n → intervalCell φ (a + i) (b + j) ≤ U)
    (hgen : ∀ i j : ℕ, i + j < n →
      intervalCell φ (a + i) (b + j + 1) ⊔ intervalCell φ (a + i + 1) (b + j) =
        intervalCell φ (a + i) (b + j)) :
    intervalCell φ a b ≤ U := by
  have key : ∀ k i j : ℕ, i + j + k = n → intervalCell φ (a + i) (b + j) ≤ U := by
    intro k
    induction k with
    | zero => exact fun i j hij => hdiag i j (by omega)
    | succ k ih =>
      intro i j hij
      rw [← hgen i j (by omega)]
      exact sup_le (by simpa only [Nat.add_assoc] using ih i (j + 1) (by omega))
        (by simpa only [Nat.add_assoc] using ih (i + 1) j (by omega))
  simpa only [Nat.add_zero] using key n 0 0 (by omega)

/-- A reconstructed interval is generated by its singleton cells. -/
theorem intervalDiagram_le_of_points (φ : S ≃* T) (w : ℕ)
    (hgen : ∀ a b : ℕ, a + b < w →
      intervalCell φ a (b + 1) ⊔ intervalCell φ (a + 1) b = intervalCell φ a b)
    {i j : ℕ} (hij : i ≤ j) (hjw : j ≤ w) (U : Subgroup G)
    (hpoints : ∀ k : ℕ, i ≤ k → k ≤ j → intervalDiagram φ w k k ≤ U) :
    intervalDiagram φ w i j ≤ U := by
  apply intervalCell_le_of_diagonal φ U i (w - j) (j - i)
  · intro a b hab
    have he : w - j + b = w - (i + a) := by omega
    rw [he]
    exact hpoints (i + a) (by omega) (by omega)
  · intro a b hab
    exact hgen (i + a) (w - j + b) (by omega)

/-- Meeting intervals join to their union. -/
theorem intervalDiagram_sup_of_overlap (φ : S ≃* T) (w : ℕ)
    (hgen : ∀ a b : ℕ, a + b < w →
      intervalCell φ a (b + 1) ⊔ intervalCell φ (a + 1) b = intervalCell φ a b)
    {i j k l : ℕ} (hik : i ≤ k) (hkj : k ≤ j) (hjl : j ≤ l) (hlw : l ≤ w) :
    intervalDiagram φ w i j ⊔ intervalDiagram φ w k l = intervalDiagram φ w i l := by
  apply le_antisymm
  · exact sup_le (intervalDiagram_mono φ le_rfl hjl) (intervalDiagram_mono φ hik le_rfl)
  · apply intervalDiagram_le_of_points φ w hgen (by omega) hlw
    intro a hia hal
    by_cases haj : a ≤ j
    · exact (intervalDiagram_mono φ hia haj).trans le_sup_left
    · exact (intervalDiagram_mono φ (by omega) hal).trans le_sup_right

theorem intervalDiagram_eq_iSup_points (φ : S ≃* T) (w : ℕ)
    (hgen : ∀ a b : ℕ, a + b < w →
      intervalCell φ a (b + 1) ⊔ intervalCell φ (a + 1) b = intervalCell φ a b)
    {i j : ℕ} (hij : i ≤ j) (hjw : j ≤ w) :
    intervalDiagram φ w i j = ⨆ k ∈ Set.Icc i j, intervalDiagram φ w k k := by
  apply le_antisymm
  · apply intervalDiagram_le_of_points φ w hgen hij hjw
    intro k hik hkj
    exact le_iSup_of_le k (le_iSup_of_le ⟨hik, hkj⟩ le_rfl)
  · apply iSup_le
    intro k
    apply iSup_le
    intro hk
    exact intervalDiagram_mono φ hk.1 hk.2

/-- Every deeper cell inherits elementary abelianness from one cell on an
earlier diagonal, using the actual restricted isomorphisms. -/
theorem intervalCell_elementary_of_diagonal (φ : S ≃* T) (p v a b : ℕ)
    [IsElementaryAbelian p (intervalCell φ 1 v)] (hdepth : v + 1 ≤ a + b) :
    IsElementaryAbelian p (intervalCell φ a b) := by
  obtain ⟨e⟩ := intervalCell_diagonal_equiv φ 1 v
  let _ : IsElementaryAbelian p (intervalCell φ 0 (v + 1)) := by
    have he := IsElementaryAbelian.of_injective (p := p) e.symm.toMonoidHom e.symm.injective
    rw [show 1 + v = v + 1 by omega] at he
    exact he
  have hle : intervalCell φ 0 (a + b) ≤ intervalCell φ 0 (v + 1) :=
    intervalCell_antitone φ le_rfl hdepth
  let _ := IsElementaryAbelian.of_injective (p := p) (inclusion hle) (inclusion_injective hle)
  obtain ⟨f⟩ := intervalCell_diagonal_equiv φ a b
  exact IsElementaryAbelian.of_injective f.toMonoidHom f.injective

/-- Intervals of length less than 2v in the depth-3v diagram are elementary
abelian, as in Niles Theorem 4.7(a). -/
theorem intervalDiagram_elementary_of_short (φ : S ≃* T) (p v : ℕ)
    [IsElementaryAbelian p (intervalCell φ 1 v)] {i j : ℕ}
    (hj : j ≤ 3 * v) (hlen : j < i + 2 * v) :
    IsElementaryAbelian p (intervalDiagram φ (3 * v) i j) :=
  intervalCell_elementary_of_diagonal φ p v i (3 * v - j) (by omega)

/-- The shifted-center estimate gives the singleton commutator bound at
every position separated by 2v, retaining the literal partial isomorphism. -/
theorem intervalDiagram_commutator_twice (φ : S ≃* T) (v : ℕ)
    (hcomm : ⁅intervalCell φ 0 (2 * v), intervalCell φ v v⁆ ≤ intervalCell φ v (2 * v))
    {i : ℕ} (hi : i ≤ v) :
    ⁅intervalDiagram φ (3 * v) i i,
      intervalDiagram φ (3 * v) (i + 2 * v) (i + 2 * v)⁆ ≤
      intervalDiagram φ (3 * v) (i + v) (i + v) := by
  have hbase : ⁅intervalCell φ 0 (3 * v), intervalCell φ (2 * v) v⁆ ≤
      intervalCell φ v (2 * v) :=
    (commutator_mono (intervalCell_antitone φ le_rfl (by omega))
      (intervalCell_antitone φ (by omega) le_rfl)).trans hcomm
  have hh := intervalCell_commutator_shift φ i 0 (3 * v - i) (2 * v) (v - i)
    v (2 * v - i) (by
      simpa only [show 3 * v - i + i = 3 * v by omega,
        show v - i + i = v by omega, show 2 * v - i + i = 2 * v by omega] using hbase)
  simpa only [intervalDiagram, Nat.zero_add, show 2 * v + i = i + 2 * v by omega,
    show v + i = i + v by omega,
    show 3 * v - (i + 2 * v) = v - i by omega,
    show 3 * v - (i + v) = 2 * v - i by omega] using hh

end Theory.GroupTheory.SubgroupTransport
