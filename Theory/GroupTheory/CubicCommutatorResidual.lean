module
public import Theory.GroupTheory.CharacteristicTwoCubicResidual
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# The two-residual generated by a local commutator

For X=O²([O²(G),P]), both P and O²(G) normalize X. A normal subgroup V
moved fully by X lies in X. If P centralizes a normal subgroup R modulo V,
then X does too: the full fixer of R/V is normal and contains P.
The final theorem applies the cubic core splitting to this exact X, removing
independent containment, perfectness, normalization and two-layer premises.

Source: Aschbacher–Smith15.1.11, printed p.1089. The chosen-normalizer consumer
supplies characteristic two and the original V; the natural Omega action
supplies the three explicitly retained movement, fixed-space and image facts.
-/

public section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- The residual O²([O²(G),P]) used in source15.1.11. -/
abbrev cubicCommutatorResidual (P : Subgroup G) : Subgroup G :=
  (pResidual 2 (⁅pResidual 2 G,P⁆ : Subgroup G)).map (⁅pResidual 2 G,P⁆).subtype

omit [Finite G] in
theorem cubicCommutatorResidual_normalized (P : Subgroup G) :
    pResidual 2 G ⊔ P ≤ normalizer (cubicCommutatorResidual P : Set G) :=
  (sup_le (normalizer_commutator_ge_left _ _) (normalizer_commutator_ge_right _ _)).trans
    (normalizer_le_normalizer_characteristic_image _ (pResidual 2 _))

omit [Finite G] in
theorem cubicCommutatorResidual_le (P : Subgroup G) :
    cubicCommutatorResidual P ≤ pResidual 2 G :=
  (map_subtype_le _).trans (commutator_le_left _ _)

omit [Finite G] in
theorem le_cubicCommutatorResidual_of_moved (P V : Subgroup G)
    (hmove : ⁅V,cubicCommutatorResidual P⁆ = V) : V ≤ cubicCommutatorResidual P := by
  have hV : V ≤ pResidual 2 G := by
    rw [←hmove]
    exact (commutator_mono le_rfl (cubicCommutatorResidual_le P)).trans
      (commutator_le_right _ _)
  have hn : V ≤ normalizer (cubicCommutatorResidual P : Set G) :=
    hV.trans (le_sup_left.trans (cubicCommutatorResidual_normalized P))
  rw [←hmove]
  exact le_normalizer_iff_commutator_le_right.mp hn

omit [Finite G] in
theorem cubicCommutatorResidual_two_layer (P R V : Subgroup G)
    [R.Normal] [V.Normal] (hcomm : ⁅R,P⁆ ≤ V) :
    ⁅R,cubicCommutatorResidual P⁆ ≤ V := by
  let F := commutatorPreimage ⊤ R V
  let : F.Normal := by
    apply normalizer_eq_top_iff.mp
    exact top_le_iff.mp (commutatorPreimage_normalized ⊤ R V ⊤
      le_normalizer_of_normal le_normalizer_of_normal le_normalizer_of_normal
      le_normalizer_of_normal)
  have hPF : P ≤ F := le_commutatorPreimage le_top (by rwa [commutator_comm])
  have hXF : cubicCommutatorResidual P ≤ F :=
    (map_subtype_le _).trans ((commutator_mono le_rfl hPF).trans (commutator_le_right _ _))
  rw [commutator_comm]
  exact (commutator_mono hXF le_rfl).trans
    (commutator_commutatorPreimage_le ⊤ R V le_normalizer_of_normal)

theorem cubicCommutatorResidual_core_splitting
    (V P : Subgroup G) [V.Normal] [IsElementaryAbelian 2 V]
    (hV : V ≤ pCore 2 G) (hcentral : V ≤ centralizer (pCore 2 G : Set G))
    (hG : centralizer (pCore 2 G : Set G) ≤ pCore 2 G)
    (hcomm : ⁅pCore 2 G,P⁆ ≤ V)
    (hmove : ⁅V,cubicCommutatorResidual P⁆ = V)
    (hfixed : V ⊓ centralizer (cubicCommutatorResidual P : Set G) = ⊥)
    (himage : IsElementaryAbelian 3
      ((cubicCommutatorResidual P).map (QuotientGroup.mk' (centralizer (V : Set G))))) :
    let X := cubicCommutatorResidual P
    X ⊓ centralizer (V : Set G) = V ∧
      pCore 2 G = V ⊔ (pCore 2 G ⊓ centralizer (X : Set G)) ∧
      Disjoint V (pCore 2 G ⊓ centralizer (X : Set G)) ∧
      P ≤ centralizer (pCore 2 G ⊓ centralizer (X : Set G) : Set G) := by
  obtain ⟨hk,hs,hd⟩ := cubic_residual_core_splitting V (cubicCommutatorResidual P)
    hV (le_cubicCommutatorResidual_of_moved P V hmove) hcentral hG
    (isPPerfect_embedded_pResidual 2 _) (cubicCommutatorResidual_two_layer P _ V hcomm)
    hfixed himage
  exact ⟨hk,hs,hd,centralizes_core_fixed_of_normalizes_residual V _ P _
    le_normalizer_of_normal (le_sup_right.trans (cubicCommutatorResidual_normalized P)) hcomm hfixed⟩
end Subgroup
