module
public import Mathlib.GroupTheory.NoncommCoprod
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Equivalences of central products with compatible factors

Two groups generated by commuting subgroup pairs are isomorphic if their
corresponding factors are isomorphic and those equivalences identify exactly
the same overlap. The resulting equivalence extends both prescribed factor
maps; no finite-group hypothesis is needed.

Multiplication is a surjective homomorphism from the direct product of each
pair. After transporting the second pair through the given equivalences,
the overlap condition identifies the two kernels. The first isomorphism
theorem constructs the ambient equivalence, and evaluation on the two direct
product factors proves the required restrictions.

This is the explicit gluing step for central-product recognition, used in
ABG II.3 Proposition 3, article p.26. The overlap compatibility is an actual
hypothesis to discharge from the cyclic-center and intersection calculations;
central-product uniqueness is not assumed.
-/

namespace Subgroup

public theorem exists_mulEquiv_of_central_products
    {G H : Type*} [Group G] [Group H]
    (Z L : Subgroup G) (Z' L' : Subgroup H)
    (hcomm : ∀ z : Z, ∀ l : L, Commute (z : G) (l : G))
    (hcomm' : ∀ z : Z', ∀ l : L', Commute (z : H) (l : H))
    (hgen : Z ⊔ L = ⊤) (hgen' : Z' ⊔ L' = ⊤)
    (eZ : Z ≃* Z') (eL : L ≃* L')
    (hcompat : ∀ z : Z, ∀ l : L, (z : G) = (l : G) ↔
      (eZ z : H) = (eL l : H)) :
    ∃ e : G ≃* H, (∀ z : Z, e z = (eZ z : H)) ∧
      ∀ l : L, e l = (eL l : H) := by
  let f : Z × L →* G := Z.subtype.noncommCoprod L.subtype hcomm
  let g : Z × L →* H := (Z'.subtype.comp eZ.toMonoidHom).noncommCoprod
    (L'.subtype.comp eL.toMonoidHom) (fun z l => hcomm' (eZ z) (eL l))
  have hf : Function.Surjective f := by
    apply MonoidHom.range_eq_top.mp
    exact (MonoidHom.noncommCoprod_range Z.subtype L.subtype hcomm).trans
      (by rw [Z.range_subtype, L.range_subtype, hgen])
  have hg : Function.Surjective g := by
    apply MonoidHom.range_eq_top.mp
    have hZ : (Z'.subtype.comp eZ.toMonoidHom).range = Z' := by
      rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eZ.surjective,
        ← MonoidHom.range_eq_map, Z'.range_subtype]
    have hL : (L'.subtype.comp eL.toMonoidHom).range = L' := by
      rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr eL.surjective,
        ← MonoidHom.range_eq_map, L'.range_subtype]
    exact (MonoidHom.noncommCoprod_range (Z'.subtype.comp eZ.toMonoidHom)
      (L'.subtype.comp eL.toMonoidHom) (fun z l => hcomm' (eZ z) (eL l))).trans
      (by rw [hZ, hL, hgen'])
  have hker : f.ker = g.ker := by
    ext x
    change (x.1 : G) * (x.2 : G) = 1 ↔ (eZ x.1 : H) * (eL x.2 : H) = 1
    simpa only [mul_eq_one_iff_eq_inv, map_inv, coe_inv] using hcompat x.1 x.2⁻¹
  let ef := QuotientGroup.quotientKerEquivOfSurjective f hf
  let eg := QuotientGroup.quotientKerEquivOfSurjective g hg
  let e := ef.symm.trans ((QuotientGroup.quotientMulEquivOfEq hker).trans eg)
  have he (a : Z × L) : e (f a) = g a := by
    change eg (QuotientGroup.quotientMulEquivOfEq hker (ef.symm (f a))) = g a
    have hfa : ef (QuotientGroup.mk a) = f a := rfl
    rw [← hfa, ef.symm_apply_apply]
    rfl
  refine ⟨e, ?_, ?_⟩
  · intro z
    have h := he (z, 1)
    change e ((z : G) * 1) = (eZ z : H) * (eL 1 : H) at h
    simpa only [map_one, coe_one, mul_one] using h
  · intro l
    have h := he (1, l)
    change e (1 * (l : G)) = (eZ 1 : H) * (eL l : H) at h
    simpa only [map_one, coe_one, one_mul] using h

end Subgroup

