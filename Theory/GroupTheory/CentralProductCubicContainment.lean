module
public import Theory.GroupTheory.PrimeRankZero
public import Theory.GroupTheory.PrimeRankResidualCentralizer
public import Theory.GroupTheory.PerfectCentralCoverExistence
public import Theory.GroupTheory.PerfectCentralCoverAbelianSylow
public import Theory.GroupTheory.PResidual.PrimeToTransport
public import Mathlib.GroupTheory.NoncommCoprod

/-!
# A cubic centralizer forces containment in one central-product factor

Let L be a perfect subgroup of a product of commuting subgroups K and C.
Assume L is generated by its three-elements and has cyclic Sylow three-subgroups.
An element of order three which normalizes both factors and centralizes L forces
L into one factor whenever the ambient three-rank is at most two.

The universal perfect central cover of L supplies genuine coordinate maps, even
when K and C intersect. Uniqueness of maps through a central extension makes the
specified actor centralize both coordinate images. Cyclic Sylow transfer gives
three-prime centers in those perfect images. If both images were nontrivial,
their independent cubic ranks together with the centralizing actor would give
ambient three-rank at least three.

Source application: Aschbacher--Smith, 1 March 2004 manuscript, proof of 2.4.25,
printed p.542. This uses the actual centralizing cubic in the paired A₅ block
configuration and avoids any assumption that the two ambient factors are conjugate.
-/

public section
open Subgroup
namespace Theory.GroupTheory
open ResidualCentralizerRank
variable {G : Type*} [Group G] [Finite G]

/-- Rank addition inside the join of two commuting subgroups with a prime-to-p center. -/
theorem primeRank_add_le_join_of_center_coprime
    (A B : Subgroup G) (hcomm : A ≤ centralizer (B : Set G))
    {p : ℕ} [Fact p.Prime] (hc : Nat.Coprime p (Nat.card (center B))) :
    primeRank p A + primeRank p B ≤ primeRank p (A ⊔ B : Subgroup G) := by
  let J := A ⊔ B
  let eA := subgroupOfEquivOfLe (show A ≤ J from le_sup_left)
  let eB := subgroupOfEquivOfLe (show B ≤ J from le_sup_right)
  have hc' : Nat.Coprime p (Nat.card (center (B.subgroupOf J))) := by
    rwa [Nat.card_congr (centerCongr eB).toEquiv]
  have hr := primeRank_add_le_of_center_coprime (A.subgroupOf J) (B.subgroupOf J)
    (show A.subgroupOf J ≤ centralizer (B.subgroupOf J : Set J) from
      fun a ha b hb => Subtype.ext (hcomm ha b hb)) hc'
  rwa [primeRank_equiv p eA, primeRank_equiv p eB] at hr

/-- Two cubic contributions exhaust rank two, so their common centralizer is three-prime. -/
theorem centralizer_join_coprime_three_of_centers_coprime
    (P Q : Subgroup G) (hcomm : P ≤ centralizer (Q : Set G))
    (hP : Nat.Coprime 3 (Nat.card (center P)))
    (hQ : Nat.Coprime 3 (Nat.card (center Q)))
    (h3P : 3 ∣ Nat.card P) (h3Q : 3 ∣ Nat.card Q)
    (hr : primeRank 3 G ≤ 2) :
    Nat.Coprime 3 (Nat.card (centralizer ((P ⊔ Q : Subgroup G) : Set G))) := by
  let C := centralizer ((P ⊔ Q : Subgroup G) : Set G)
  have hCP : C ≤ centralizer (P : Set G) := centralizer_le (show P ≤ P ⊔ Q from le_sup_left)
  have hCQ : C ≤ centralizer (Q : Set G) := centralizer_le (show Q ≤ P ⊔ Q from le_sup_right)
  have h1 := primeRank_add_le_join_of_center_coprime C P hCP hP
  have h2 := primeRank_add_le_of_center_coprime (C ⊔ P) Q (sup_le hCQ hcomm) hQ
  have hp : 1 ≤ primeRank 3 P := by
    by_contra! h
    exact (PrimeRank.eq_zero_iff_not_dvd_card.mp (by omega : primeRank 3 P = 0)) h3P
  have hq : 1 ≤ primeRank 3 Q := by
    by_contra! h
    exact (PrimeRank.eq_zero_iff_not_dvd_card.mp (by omega : primeRank 3 Q = 0)) h3Q
  apply Nat.prime_three.coprime_iff_not_dvd.mpr
  apply PrimeRank.eq_zero_iff_not_dvd_card.mp
  change primeRank 3 C = 0
  omega

private theorem residual_top_of_perfect_central_surjection
    {D H : Type*} [Group D] [Finite D] [Group.IsPerfect D] [Group H]
    (f : D →* H) (hf : Function.Surjective f) (hk : f.ker ≤ center D)
    (hr : primeToResidual 3 H = ⊤) : primeToResidual 3 D = ⊤ := by
  let R := primeToResidual 3 D
  have hm : R.map f = ⊤ := (map_primeToResidual_of_surjective 3 f hf).trans hr
  have hs : Function.Surjective (f.comp R.subtype) := by
    apply MonoidHom.range_eq_top.mp
    rw [MonoidHom.range_comp,range_subtype]
    exact hm
  have hsur := PerfectCentralCovering.surjective_of_comp_surjective_of_ker_le_center_of_isPerfect
    f R.subtype hs hk
  simpa only [range_subtype] using MonoidHom.range_eq_top.mpr hsur

private theorem cyclic_sylows_of_surjective
    {D H : Type*} [Group D] [Finite D] [Group H] [Finite H]
    (f : D →* H) (hf : Function.Surjective f)
    (hc : ∀ P : Sylow 3 D, IsCyclic P) (Q : Sylow 3 H) : IsCyclic Q := by
  obtain ⟨P,rfl⟩ := Sylow.mapSurjective_surjective hf 3 Q
  let := hc P
  exact isCyclic_of_surjective (f.subgroupMap (P : Subgroup D)) (f.subgroupMap_surjective _)

private theorem center_coprime_three_of_cyclic_sylows
    {D : Type*} [Group D] [Finite D] [Group.IsPerfect D]
    (hc : ∀ P : Sylow 3 D, IsCyclic P) : Nat.Coprime 3 (Nat.card (center D)) := by
  let P : Sylow 3 D := default
  let := hc P
  have hh := PerfectCentralCovering.not_dvd_card_kernel_of_abelian_sylow
    (QuotientGroup.mk' (center D)) (by rw [QuotientGroup.ker_mk']) P inferInstance
  rw [QuotientGroup.ker_mk'] at hh
  exact Nat.prime_three.coprime_iff_not_dvd.mpr hh

private theorem three_dvd_range_of_residual_top
    {D H : Type*} [Group D] [Group H] [Finite H]
    (hr : primeToResidual 3 D = ⊤) (f : D →* H) (hne : f.range ≠ ⊥) :
    3 ∣ Nat.card f.range := by
  by_contra hd
  have hk := primeToResidual_le_ker f.rangeRestrict
    (Nat.prime_three.coprime_iff_not_dvd.mpr hd)
  apply hne
  apply MonoidHom.range_eq_bot_iff.mpr
  ext x
  exact congrArg Subtype.val (show f.rangeRestrict x = 1 from hk (hr ▸ mem_top x))

/-- A perfect three-generated subgroup with cyclic Sylow three-subgroups cannot
project nontrivially onto both commuting factors when a cubic centralizes it. -/
theorem perfect_subgroup_le_factor_of_cubic_centralizer
    (K C L : Subgroup G) (hc : K ≤ centralizer (C : Set G))
    [Group.IsPerfect L] (hL : L ≤ K ⊔ C)
    (hcyc : ∀ P : Sylow 3 L, IsCyclic P) (hres : primeToResidual 3 L = ⊤)
    (b : G) (hb : orderOf b = 3)
    (hbK : b ∈ normalizer (K : Set G)) (hbC : b ∈ normalizer (C : Set G))
    (hbL : b ∈ centralizer (L : Set G)) (hr : primeRank 3 G ≤ 2) :
    L ≤ K ∨ L ≤ C := by
  let f : K × C →* G := K.subtype.noncommCoprod C.subtype (fun k c =>
    (hc k.property c c.property).symm)
  have hfr : f.range = K ⊔ C := by
    exact (MonoidHom.noncommCoprod_range _ _ _).trans (by rw [range_subtype,range_subtype])
  let U := L.comap f
  let q : U →* L := f.subgroupComap L
  have hq : Function.Surjective q := by
    intro l
    obtain ⟨x,hx⟩ := (show (l:G)∈f.range by rw [hfr]; exact hL l.property)
    exact ⟨⟨x,by change f x∈L; rw [hx]; exact l.property⟩,Subtype.ext hx⟩
  have hk : q.ker ≤ center U := by
    intro x hx
    have he : ((x:K×C).1:G)*((x:K×C).2:G)=1 := congrArg Subtype.val hx
    have hleft : ((x:K×C).1:G)=((x:K×C).2:G)⁻¹ := eq_inv_of_mul_eq_one_left he
    have hright : ((x:K×C).2:G)=((x:K×C).1:G)⁻¹ := eq_inv_of_mul_eq_one_right he
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    apply Prod.ext <;> apply Subtype.ext
    · change ((y:K×C).1:G)*((x:K×C).1:G)=((x:K×C).1:G)*((y:K×C).1:G)
      rw [hleft]
      exact (hc (y:K×C).1.property _ (C.inv_mem (x:K×C).2.property)).symm
    · change ((y:K×C).2:G)*((x:K×C).2:G)=((x:K×C).2:G)*((y:K×C).2:G)
      rw [hright]
      exact hc (K.inv_mem (x:K×C).1.property) _ (y:K×C).2.property
  let D := PerfectCentralCovering.UniversalGroup L
  let pi : D →* L := PerfectCentralCovering.universalProjection L
  have hpi := PerfectCentralCovering.universalProjection_surjective (G := L)
  have hkip := PerfectCentralCovering.universalProjection_ker_le_center (G := L)
  obtain ⟨s,hs,_⟩ := PerfectCentralCovering.universalProjection_existsUnique_lift q hq hk
  let a : D →* G := K.subtype.comp ((MonoidHom.fst K C).comp (U.subtype.comp s))
  let c : D →* G := C.subtype.comp ((MonoidHom.snd K C).comp (U.subtype.comp s))
  have hprod (x : D) : a x * c x = (pi x : G) := congrArg Subtype.val (DFunLike.congr_fun hs x)
  have haK : a.range ≤ K := by rintro _ ⟨x,rfl⟩; exact ((s x : U) : K × C).1.property
  have hcC : c.range ≤ C := by rintro _ ⟨x,rfl⟩; exact ((s x : U) : K × C).2.property
  have hLP : L ≤ a.range ⊔ c.range := by
    intro l hl
    obtain ⟨x,hx⟩ := hpi ⟨l,hl⟩
    have he : a x * c x = l := (hprod x).trans (congrArg Subtype.val hx)
    rw [←he]
    exact mul_mem (mem_sup_left ⟨x,rfl⟩) (mem_sup_right ⟨x,rfl⟩)
  by_cases ha : a.range = ⊥
  · have hh : L ≤ c.range := by simpa only [ha,bot_sup_eq] using hLP
    exact Or.inr (hh.trans hcC)
  by_cases hc' : c.range = ⊥
  · have hh : L ≤ a.range := by simpa only [hc',sup_bot_eq] using hLP
    exact Or.inl (hh.trans haK)
  have hDcyc (P : Sylow 3 D) : IsCyclic P :=
    PerfectCentralCovering.isCyclic_sylow_of_isCyclic_mapSurjective P pi hpi hkip
      (hcyc (P.mapSurjective hpi))
  have hDres : primeToResidual 3 D = ⊤ :=
    residual_top_of_perfect_central_surjection pi hpi hkip hres
  let : Group.IsPerfect a.range := Group.IsPerfect.ofSurjective a.rangeRestrict_surjective
  let : Group.IsPerfect c.range := Group.IsPerfect.ofSurjective c.rangeRestrict_surjective
  have hP := center_coprime_three_of_cyclic_sylows
    (cyclic_sylows_of_surjective a.rangeRestrict a.rangeRestrict_surjective hDcyc)
  have hQ := center_coprime_three_of_cyclic_sylows
    (cyclic_sylows_of_surjective c.rangeRestrict c.rangeRestrict_surjective hDcyc)
  have hPQ : a.range ≤ centralizer (c.range : Set G) :=
    haK.trans (hc.trans (centralizer_le hcC))
  have hcop := centralizer_join_coprime_three_of_centers_coprime a.range c.range hPQ hP hQ
    (three_dvd_range_of_residual_top hDres a ha)
    (three_dvd_range_of_residual_top hDres c hc') hr
  let e : K×C ≃* K×C :=
    (K.normalizerMonoidHom ⟨b,hbK⟩).prodCongr (C.normalizerMonoidHom ⟨b,hbC⟩)
  have hef (x : K×C) : f (e x) = b * f x * b⁻¹ := by
    change (b*(x.1:G)*b⁻¹)*(b*(x.2:G)*b⁻¹)=b*((x.1:G)*(x.2:G))*b⁻¹
    group
  have hfix (x : U) : f (e x) = f x := by
    rw [hef,←mem_centralizer_iff.mp hbL (f x) x.property,mul_inv_cancel_right]
  let t : D →* U := (e.toMonoidHom.comp (U.subtype.comp s)).codRestrict U
    (fun x => by change f (e (s x)) ∈ L; rw [hfix]; exact (s x).property)
  have hqt : q.comp t = q.comp s := by
    ext x
    exact hfix (s x)
  have hts : t = s := PerfectCentralCovering.monoidHom_eq_of_isPerfect_of_comp_eq q hk t s hqt
  have hba (x : D) : b * a x * b⁻¹ = a x :=
    congrArg (fun u : U => (((u : K×C).1 : K) : G)) (DFunLike.congr_fun hts x)
  have hbc (x : D) : b * c x * b⁻¹ = c x :=
    congrArg (fun u : U => (((u : K×C).2 : C) : G)) (DFunLike.congr_fun hts x)
  have hbjoin : b ∈ centralizer ((a.range ⊔ c.range : Subgroup G) : Set G) := by
    have hleft : a.range ≤ centralizer ({b} : Set G) := by
      rintro _ ⟨x,rfl⟩
      rw [mem_centralizer_singleton_iff]
      exact (mul_inv_eq_iff_eq_mul.mp (hba x)).symm
    have hright : c.range ≤ centralizer ({b} : Set G) := by
      rintro _ ⟨x,rfl⟩
      rw [mem_centralizer_singleton_iff]
      exact (mul_inv_eq_iff_eq_mul.mp (hbc x)).symm
    intro x hx
    exact mem_centralizer_singleton_iff.mp ((sup_le hleft hright) hx)
  apply False.elim
  apply Nat.prime_three.coprime_iff_not_dvd.mp hcop
  have hd := orderOf_dvd_natCard (⟨b,hbjoin⟩ : centralizer ((a.range ⊔ c.range : Subgroup G) : Set G))
  simpa only [Subgroup.orderOf_mk,hb] using hd
end Theory.GroupTheory
