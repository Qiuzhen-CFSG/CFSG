module
public import Theory.GroupTheory.AmalgamGraph.SylowCenterSpan
public import Theory.GroupTheory.AbelianConjugateSpan

/-!
# Fixed-subgroup generation of the actual Sylow-center span

If a local subgroup L contains every Sylow two-subgroup of P, Sylow
conjugacy inside L generates the original P-span from the omega-center
of any one Sylow. This seed centralizes that Sylow, so its fixed subgroup
also generates the entire span under L. All subgroup embeddings are retained.

Source: DGS, *Groups and Graphs* (1985), the p.81 definition of Z and the
fixed-space-generation correction to 5.12 used in 8.2--8.7.
-/

@[expose] public noncomputable section
open Subgroup
namespace Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G]

private theorem sylows_conjugate_inside (P L : Subgroup G) [Finite P]
    (hT : ∀ T : Sylow 2 P, (T : Subgroup P).map P.subtype ≤ L)
    (T R : Sylow 2 P) :
    ∃ g ∈ L, ((T : Subgroup P).map P.subtype).map (MulAut.conj g).toMonoidHom =
      (R : Subgroup P).map P.subtype := by
  let K := L.subgroupOf P
  have ht : (T : Subgroup P) ≤ K := fun x hx => hT T (mem_map_of_mem P.subtype hx)
  have hr : (R : Subgroup P) ≤ K := fun x hx => hT R (mem_map_of_mem P.subtype hx)
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq K (T.subtype ht) (R.subtype hr)
  refine ⟨((g : P) : G), g.property, ?_⟩
  have he : ((T : Subgroup P).subgroupOf K).map (MulAut.conj g).toMonoidHom =
      (R : Subgroup P).subgroupOf K := by
    exact congrArg (fun S : Sylow 2 K => (S : Subgroup K)) hg
  have hm := congrArg (fun S : Subgroup K => (S.map K.subtype).map P.subtype) he
  rw [map_map, map_map, map_subgroupOf_eq_of_le hr] at hm
  calc
    _ = ((((T : Subgroup P).subgroupOf K).map K.subtype).map P.subtype).map
        (MulAut.conj ((g : P) : G)).toMonoidHom := by rw [map_subgroupOf_eq_of_le ht]
    _ = _ := by
      rw [map_map, map_map]
      have hf : (MulAut.conj ((g : P) : G)).toMonoidHom.comp (P.subtype.comp K.subtype) =
          (P.subtype.comp K.subtype).comp (MulAut.conj g).toMonoidHom := by
        ext x
        rfl
      change (((T : Subgroup P).subgroupOf K).map
        ((MulAut.conj ((g : P) : G)).toMonoidHom.comp (P.subtype.comp K.subtype))) = _
      rw [hf]
      exact hm

/-- The actual join over all Sylows is generated by one Sylow omega-center
under any local overgroup containing all the Sylows. -/
theorem sylowCenterSpan_eq_conjugateSpan (P L : Subgroup G) [Finite P]
    (hLP : L ≤ P)
    (hT : ∀ T : Sylow 2 P, (T : Subgroup P).map P.subtype ≤ L)
    (T : Sylow 2 P) :
    sylowCenterSpan P = conjugateSpanBy (omegaCenterIn ((T : Subgroup P).map P.subtype)) L := by
  have hnormal : P ≤ normalizer (sylowCenterSpan P : Set G) :=
    (normal_subgroupOf_iff_le_normalizer (sylowCenterSpan_le P)).mp (sylowCenterSpan_normal P)
  apply le_antisymm
  · apply iSup_le
    intro R
    obtain ⟨g, hg, he⟩ := sylows_conjugate_inside P L hT T R
    rw [← he, ← NilesRankOneKernel.omegaCenterIn_map_injective _ (MulAut.conj g).injective]
    rintro _ ⟨x, hx, rfl⟩
    exact subset_closure ⟨g, hg, x, hx, rfl⟩
  · exact conjugateSpanBy_le (le_iSup (fun R : Sylow 2 P => omegaCenterIn ((R : Subgroup P).map P.subtype)) T) (hLP.trans hnormal)

/-- The original source center span is generated by its fixed subgroup for
an actual local Sylow, with the same conjugating group and ambient embeddings.
This is the group form of the corrected fixed-space-generation premise in 5.12. -/
theorem sylowCenterSpan_generated_by_sylow_fixed (P L : Subgroup G) [Finite P]
    (hLP : L ≤ P)
    (hT : ∀ T : Sylow 2 P, (T : Subgroup P).map P.subtype ≤ L)
    (T : Sylow 2 P) :
    conjugateSpanBy (sylowCenterSpan P ⊓
      centralizer (((T : Subgroup P).map P.subtype : Subgroup G) : Set G)) L =
        sylowCenterSpan P := by
  have hnormal : P ≤ normalizer (sylowCenterSpan P : Set G) :=
    (normal_subgroupOf_iff_le_normalizer (sylowCenterSpan_le P)).mp (sylowCenterSpan_normal P)
  apply le_antisymm (conjugateSpanBy_le inf_le_left (hLP.trans hnormal))
  rw [sylowCenterSpan_eq_conjugateSpan P L hLP hT T]
  apply conjugateSpanBy_mono _ le_rfl
  apply le_inf
  · exact le_conjugateSpanBy _ _
  · exact fun x hx => ((mem_omegaCenterIn_iff _ _).mp hx).2.1

end Theory.GroupTheory.AmalgamGraph
