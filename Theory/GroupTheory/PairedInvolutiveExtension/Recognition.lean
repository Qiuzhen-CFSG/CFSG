module
public import Theory.GroupTheory.PairedInvolutiveExtension
public import Mathlib.Algebra.Group.Subgroup.Ker
public import Mathlib.GroupTheory.Subgroup.Center
/-!
# Recognition of the actual paired action

The paired extension acts on its two factors by an inner pair followed by
its four-group actor. Centerlessness and the outer character of the selected
involution make this action faithful. If a second faithful action contains
the inner pairs and is generated by the simultaneous-outer and interchange
cosets, inner correction recovers the literal actors and identifies the two
groups. The original coset representatives need not be involutions.

This is the marked replacement step in Aschbacher--Smith 2.4.34, printed
p.548 of the combined manuscript of 1 March 2004.
-/

public section
namespace Theory.GroupTheory.PairedInvolutiveExtension
open Subgroup
variable {K : Type*} [Group K] (α : MulAut K) (hα : Function.Involutive α)

/-- The actual conjugation action on the two factors. -/
def representation : Model α hα →* MulAut (K×K) where
  toFun u := MulAut.conj u.left * action α hα u.right
  map_one' := by simp
  map_mul' u v := by
    ext z : 1
    change (u.left * action α hα u.right v.left) *
      action α hα (u.right*v.right) z * (u.left * action α hα u.right v.left)⁻¹ =
      u.left * action α hα u.right (v.left * action α hα v.right z * v.left⁻¹) * u.left⁻¹
    rw [map_mul]
    simp only [MulAut.mul_apply,map_mul,map_inv]
    group

@[simp] theorem representation_mk (a b : K) (p q : Bit) :
    representation α hα (mk α hα a b p q) = MulAut.conj (a,b) * action α hα (p,q) := by rfl

private theorem representation_kernel (hconj : Function.Injective (MulAut.conj : K →* MulAut K))
    (houter : ∀ a:K,α≠MulAut.conj a) (u : Model α hα)
    (hu : representation α hα u=1) : u=1 := by
  rcases u with ⟨⟨a,b⟩,p,q⟩
  change representation α hα (mk α hα a b p q)=1 at hu
  have hn : Nontrivial K := by
    by_contra hn
    have : Subsingleton K := not_nontrivial_iff_subsingleton.mp hn
    apply houter 1
    ext x
    exact Subsingleton.elim _ _
  rcases bit_cases q with rfl|rfl
  · rcases bit_cases p with rfl|rfl
    · have ha : MulAut.conj a=1 := by
        ext x
        exact congrArg Prod.fst (MulEquiv.congr_fun hu (x,1))
      have hb : MulAut.conj b=1 := by
        ext x
        exact congrArg Prod.snd (MulEquiv.congr_fun hu (1,x))
      have ha1 : a=1 := hconj (ha.trans (map_one MulAut.conj).symm)
      have hb1 : b=1 := hconj (hb.trans (map_one MulAut.conj).symm)
      subst a; subst b
      rfl
    · exfalso
      apply houter a⁻¹
      ext x
      have he := congrArg Prod.fst (MulEquiv.congr_fun hu (x,1))
      change a*α x*a⁻¹=x at he
      change α x=a⁻¹*x*(a⁻¹)⁻¹
      calc
        α x = a⁻¹*(a*α x*a⁻¹)*a := by group
        _ = a⁻¹*x*(a⁻¹)⁻¹ := by rw [he]; simp
  · obtain ⟨x,hx⟩ := exists_ne (1:K)
    exfalso
    apply hx
    have he := congrArg Prod.fst (MulEquiv.congr_fun hu (x,1))
    rcases bit_cases p with rfl|rfl
    · simpa [representation,mk,action] using he.symm
    · simpa [representation,mk,action,MulEquiv.prodCongr] using he.symm

theorem representation_injective (hconj : Function.Injective (MulAut.conj : K →* MulAut K))
    (houter : ∀ a:K,α≠MulAut.conj a) : Function.Injective (representation α hα) := by
  apply (representation α hα).ker_eq_bot_iff.mp
  apply bot_unique
  intro u hu
  exact mem_bot.mpr (representation_kernel α hα hconj houter u hu)


@[simp] theorem representation_base (a b : K) :
    representation α hα (base α hα a b)=MulAut.conj (a,b) := by
  simp [base,action]
@[simp] theorem representation_graph :
    representation α hα (graph α hα)=α.prodCongr α := by
  simp [graph,action]
  exact map_one _
@[simp] theorem representation_swap :
    representation α hα (swap α hα)=(MulEquiv.prodComm : MulAut (K×K)) := by
  simp [swap,action]
  exact map_one _

theorem representation_range : (representation α hα).range =
    (MulAut.conj : K×K →* MulAut (K×K)).range ⊔ zpowers (α.prodCongr α) ⊔
      zpowers (MulEquiv.prodComm : MulAut (K×K)) := by
  apply le_antisymm
  · rintro f ⟨⟨⟨a,b⟩,p,q⟩,rfl⟩
    have hi : MulAut.conj (a,b) ∈
        (MulAut.conj : K×K →* MulAut (K×K)).range ⊔ zpowers (α.prodCongr α) ⊔
          zpowers (MulEquiv.prodComm : MulAut (K×K)) :=
      mem_sup_left (mem_sup_left ⟨(a,b),rfl⟩)
    have hg : α.prodCongr α ∈
        (MulAut.conj : K×K →* MulAut (K×K)).range ⊔ zpowers (α.prodCongr α) ⊔
          zpowers (MulEquiv.prodComm : MulAut (K×K)) :=
      mem_sup_left (mem_sup_right (mem_zpowers _))
    have hs : (MulEquiv.prodComm : MulAut (K×K)) ∈
        (MulAut.conj : K×K →* MulAut (K×K)).range ⊔ zpowers (α.prodCongr α) ⊔
          zpowers (MulEquiv.prodComm : MulAut (K×K)) := mem_sup_right (mem_zpowers _)
    change MulAut.conj (a,b) * action α hα (p,q) ∈ _
    apply mul_mem hi
    rcases bit_cases p with rfl|rfl <;> rcases bit_cases q with rfl|rfl
    · simp [action]
    · simpa [action] using hs
    · simpa [action] using hg
    · simpa [action] using mul_mem hg hs
  · refine sup_le (sup_le ?_ ?_) ?_
    · rintro f ⟨⟨a,b⟩,rfl⟩
      exact ⟨base α hα a b,representation_base α hα a b⟩
    · exact zpowers_le.mpr ⟨graph α hα,representation_graph α hα⟩
    · exact zpowers_le.mpr ⟨swap α hα,representation_swap α hα⟩

/-- Inner correction of the two original outer cosets recovers both canonical actors. -/
theorem range_eq_of_two_cosets (R : Subgroup (MulAut (K×K)))
    (hN : (MulAut.conj : K×K →* MulAut (K×K)).range ≤ R)
    (hR : R ≤ (representation α hα).range)
    (a b c d : K) (p : Bit)
    (hx : MulAut.conj (a,b) * α.prodCongr α ∈ R)
    (hs : MulAut.conj (c,d) * action α hα (p,on) ∈ R) :
    R=(representation α hα).range := by
  have hg : α.prodCongr α ∈ R := by
    have hi := R.mul_mem (R.inv_mem (hN ⟨(a,b),rfl⟩)) hx
    simpa using hi
  have ht : action α hα (p,on) ∈ R := by
    have hi := R.mul_mem (R.inv_mem (hN ⟨(c,d),rfl⟩)) hs
    simpa using hi
  have hw : (MulEquiv.prodComm : MulAut (K×K)) ∈ R := by
    rcases bit_cases p with rfl|rfl
    · simpa [action] using ht
    · have hh := R.mul_mem (R.inv_mem hg) ht
      simpa [action] using hh
  apply le_antisymm hR
  rw [representation_range]
  exact sup_le (sup_le hN (zpowers_le.mpr hg)) (zpowers_le.mpr hw)

/-- Faithful actual actions with this exact image identify the original group
with the paired extension, preserving the action on the original factors. -/
noncomputable def equivOfImage {H : Type*} [Group H]
    (ρ : H →* MulAut (K×K)) (hρ : Function.Injective ρ)
    (hconj : Function.Injective (MulAut.conj : K →* MulAut K))
    (houter : ∀ a:K,α≠MulAut.conj a)
    (himage : ρ.range=(representation α hα).range) : H ≃* Model α hα :=
  (MonoidHom.ofInjective hρ).trans ((MulEquiv.subgroupCongr himage).trans
    (MonoidHom.ofInjective (representation_injective α hα hconj houter)).symm)

theorem equivOfImage_spec {H : Type*} [Group H]
    (ρ : H →* MulAut (K×K)) (hρ : Function.Injective ρ)
    (hconj : Function.Injective (MulAut.conj : K →* MulAut K))
    (houter : ∀ a:K,α≠MulAut.conj a)
    (himage : ρ.range=(representation α hα).range) (x : H) :
    representation α hα (equivOfImage α hα ρ hρ hconj houter himage x)=ρ x := by
  exact MonoidHom.apply_ofInjective_symm (representation_injective α hα hconj houter) _

/-- The source generators need only lie in the simultaneous-outer and
interchanging cosets; they themselves need not be commuting involutions. -/
theorem range_eq_of_generated_cosets (R : Subgroup (MulAut (K×K)))
    (a b c d : K) (p : Bit)
    (hgen : R=(MulAut.conj : K×K →* MulAut (K×K)).range ⊔
      zpowers (MulAut.conj (a,b) * α.prodCongr α) ⊔
      zpowers (MulAut.conj (c,d) * action α hα (p,on))) :
    R=(representation α hα).range := by
  refine range_eq_of_two_cosets α hα R ?_ ?_ a b c d p ?_ ?_
  · rw [hgen]
    exact le_sup_of_le_left le_sup_left
  · rw [hgen]
    refine sup_le (sup_le ?_ ?_) ?_
    · rintro f ⟨⟨u,v⟩,rfl⟩
      exact ⟨base α hα u v,representation_base α hα u v⟩
    · apply zpowers_le.mpr
      refine ⟨mk α hα a b on 1,?_⟩
      simp [representation_mk,action]
    · exact zpowers_le.mpr ⟨mk α hα c d p on,representation_mk α hα c d p on⟩
  · rw [hgen]
    exact mem_sup_left (mem_sup_right (mem_zpowers _))
  · rw [hgen]
    exact mem_sup_right (mem_zpowers _)
end Theory.GroupTheory.PairedInvolutiveExtension

