module
public import Theory.GroupTheory.Signalizer.Defs
public import Theory.ElementaryAbelian.VectorSpace
public import Theory.GroupAction.KleinFourFactorization
public import Mathlib.GroupTheory.GroupAction.FixedPoints

/-!
# Binary signalizer subgroups lie in the generated closure

For a finite elementary abelian two-group of order at least four, every
signalizer subgroup lies in the subgroup generated by the family values.
No completeness hypothesis is needed. This gives the maximality property
of completed restrictions used in the local-completeness argument.

Choose two distinct nonidentity actors a,b, so a,b,ab are nonidentity.
Their actions on an odd signalizer subgroup are commuting involutive
automorphisms. The proved Klein-four three-factor theorem writes each
point as an ordered product of points fixed by a,b,ab. The signalizer
bounds place each factor in its corresponding family value and hence in
the generated closure. The action on the subgroup is the original action
restricted using its stored invariant-subgroup proof.

Source: the coprime-generation observation (+) in Kurzweil–Stellmacher,
*The Theory of Finite Groups*, §11.1, printed p.304. The binary proof uses
the existing odd-group Klein-four factorization without a solvability or
faithfulness assumption on the action.
-/

open scoped IsMulCommutative

namespace Theory.GroupTheory.TwoSignalizerFamily

/-- Every signalizer subgroup lies in the closure for a noncyclic binary actor. -/
public theorem IsSignalizerSubgroup.le_closure
    {A G : Type*} [Group A] [Finite A] [Group G] [Finite G]
    [IsElementaryAbelian 2 A] [MulDistribMulAction A G]
    {θ : TwoSignalizerFamily A G} {U : Subgroup G}
    (hU : θ.IsSignalizerSubgroup U) (hA : 4 ≤ Nat.card A) : U ≤ θ.closure := by
  classical
  let : Fintype A := Fintype.ofFinite A
  have hthree : 3 ≤ ENat.card A := by
    rw [ENat.card_eq_coe_fintype_card]
    exact_mod_cast (show 3 ≤ Fintype.card A by simpa only [← Nat.card_eq_fintype_card] using (by omega : 3 ≤ Nat.card A))
  obtain ⟨a, ha, _⟩ := ENat.exists_ne_ne_of_three_le hthree (1 : A) 1
  obtain ⟨b, hb, hba⟩ := ENat.exists_ne_ne_of_three_le hthree (1 : A) a
  have hpow (a : A) : a ^ 2 = 1 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 A) a
  have hab : a * b ≠ 1 := by
    intro h
    apply hba
    have hmul := congrArg (fun x : A => a * x) h
    simpa only [← mul_assoc, ← pow_two, hpow a, one_mul, mul_one] using hmul
  let : IsInvariant A G U := hU.2.2.1
  let ρ := MulDistribMulAction.toMulAut A U
  have hinvolutive (a : A) : Function.Involutive (ρ a) := by
    intro u
    change a • (a • u) = u
    rw [← mul_smul, ← pow_two, hpow a, one_smul]
  have hcomm : Commute (ρ a) (ρ b) := by
    rw [Commute, SemiconjBy, ← map_mul, ← map_mul, mul_comm a b]
  have hfixed_le (a : A) (ha : a ≠ 1) (u : U) (hu : ρ a u = u) : (u : G) ∈ θ.closure := by
    apply θ.le_closure ⟨a, ha⟩
    apply hU.2.2.2 ⟨a, ha⟩
    refine ⟨u.property, ?_⟩
    intro z
    obtain ⟨k, hk⟩ := z.property
    change (z : A) • (u : G) = (u : G)
    rw [← hk]
    exact MulAction.mem_fixedBy_zpow (congrArg Subtype.val hu) k
  intro x hx
  obtain ⟨x₀, x₁, x₂, h₀, h₁, h₂, h⟩ :=
    MulAut.exists_fixed_mul_fixed_mul_fixed_of_odd_card hU.1 (ρ a) (ρ b)
      (hinvolutive a) (hinvolutive b) hcomm (⟨x, hx⟩ : U)
  have h₂' : ρ (a * b) x₂ = x₂ := by simpa only [map_mul] using h₂
  have hout := θ.closure.mul_mem
    (θ.closure.mul_mem (hfixed_le a ha x₀ h₀) (hfixed_le b hb x₁ h₁))
    (hfixed_le (a * b) hab x₂ h₂')
  have hxEq : x = (x₀ : G) * (x₁ : G) * (x₂ : G) := congrArg Subtype.val h
  rwa [← hxEq] at hout

end Theory.GroupTheory.TwoSignalizerFamily
