module

public import Theory.GroupAction.Invariant
public import Mathlib.GroupTheory.Solvable
public import Mathlib.Algebra.Group.Subgroup.Actions
public import Mathlib.SetTheory.Cardinal.Finite

/-!
# Odd solvable signalizer families for a supplied action

A two-signalizer family assigns an actual subgroup of G to each nonidentity
actor in A. Each value is solvable, has odd order, is invariant under A, and
is fixed by its indexing actor. The balance condition bounds its intersection
with another actor's fixed subgroup by the other value. These are precisely
the local hypotheses; completeness is a separate property to be proved.

The actor acts externally on G. This retains the original action when later
proofs restrict G to an invariant subgroup or quotient by an invariant normal
subgroup; A need not embed in those groups. The binary and rank hypotheses
belong to the completion theorem, not these definitions.

The closure is the actual supremum of the values, and the common subgroup
is their infimum. A signalizer subgroup is an odd solvable invariant subgroup
whose fixed subgroups satisfy the family bounds. Completeness means the
closure is a signalizer subgroup. The elementary lemmas here show that the
closure is invariant and that completeness gives exact fixed-subgroup
recovery. Only these mathematical constructions have exposed bodies.

Source: Kurzweil–Stellmacher, *The Theory of Finite Groups*, §11.1,
printed pp. 304–305, `refs/latex/kurzweil.tex`. These definitions form the
shared boundary for the binary-actor solvable signalizer theorem.
-/

namespace Theory.GroupTheory

universe u v

/-- Local data of an odd solvable signalizer family for the supplied action. -/
public structure TwoSignalizerFamily
    (A : Type u) (G : Type v) [Group A] [Group G] [MulDistribMulAction A G] where
  subgroup : {a : A // a ≠ 1} → Subgroup G
  odd : ∀ a, Odd (Nat.card (subgroup a))
  solvable : ∀ a, Group.IsSolvable (subgroup a)
  invariant : ∀ a, IsInvariant A G (subgroup a)
  le_fixed : ∀ a, subgroup a ≤ FixedPoints.subgroup (Subgroup.zpowers a.val) G
  balance : ∀ a b, subgroup a ⊓ FixedPoints.subgroup (Subgroup.zpowers b.val) G ≤ subgroup b

namespace TwoSignalizerFamily

variable {A : Type u} {G : Type v} [Group A] [Group G] [MulDistribMulAction A G]

/-- The subgroup generated by the signalizer values. -/
@[expose] public def closure (θ : TwoSignalizerFamily A G) : Subgroup G :=
  ⨆ a, θ.subgroup a

/-- The subgroup common to all signalizer values, the source C_A. -/
@[expose] public def common (θ : TwoSignalizerFamily A G) : Subgroup G :=
  ⨅ a, θ.subgroup a

/-- A solvable odd invariant subgroup whose fixed subgroups obey the family bounds. -/
@[expose] public def IsSignalizerSubgroup (θ : TwoSignalizerFamily A G) (U : Subgroup G) : Prop :=
  Odd (Nat.card U) ∧ Group.IsSolvable U ∧ IsInvariant A G U ∧
    ∀ a : {a : A // a ≠ 1}, U ⊓ FixedPoints.subgroup (Subgroup.zpowers a.val) G ≤ θ.subgroup a

/-- Completeness says that the actual generated subgroup obeys the signalizer bounds. -/
@[expose] public def IsComplete (θ : TwoSignalizerFamily A G) : Prop :=
  θ.IsSignalizerSubgroup θ.closure

public theorem le_closure (θ : TwoSignalizerFamily A G) (a : {a : A // a ≠ 1}) :
    θ.subgroup a ≤ θ.closure := le_iSup _ a

public theorem common_le (θ : TwoSignalizerFamily A G) (a : {a : A // a ≠ 1}) :
    θ.common ≤ θ.subgroup a := iInf_le _ a

public theorem closure_le (θ : TwoSignalizerFamily A G) {U : Subgroup G} :
    θ.closure ≤ U ↔ ∀ a, θ.subgroup a ≤ U := iSup_le_iff

public theorem value_isSignalizerSubgroup (θ : TwoSignalizerFamily A G)
    (a : {a : A // a ≠ 1}) : θ.IsSignalizerSubgroup (θ.subgroup a) :=
  ⟨θ.odd a, θ.solvable a, θ.invariant a, θ.balance a⟩

public theorem closure_invariant (θ : TwoSignalizerFamily A G) :
    IsInvariant A G θ.closure := by
  have forward (a : A) (g : G) (hg : g ∈ θ.closure) : a • g ∈ θ.closure := by
    refine Subgroup.iSup_induction _ (C := fun x => a • x ∈ θ.closure) hg ?_ ?_ ?_
    · intro i x hx
      exact θ.le_closure i (((θ.invariant i).invariant a x).mp hx)
    · simp
    · intro x y hx hy
      simpa only [smul_mul'] using θ.closure.mul_mem hx hy
  constructor
  intro a g
  exact ⟨forward a g, fun hg => by simpa using forward a⁻¹ (a • g) hg⟩

public theorem IsComplete.fixed_eq {θ : TwoSignalizerFamily A G} (hθ : θ.IsComplete)
    (a : {a : A // a ≠ 1}) :
    θ.closure ⊓ FixedPoints.subgroup (Subgroup.zpowers a.val) G = θ.subgroup a :=
  le_antisymm (hθ.2.2.2 a) (le_inf (θ.le_closure a) (θ.le_fixed a))

end TwoSignalizerFamily
end Theory.GroupTheory
