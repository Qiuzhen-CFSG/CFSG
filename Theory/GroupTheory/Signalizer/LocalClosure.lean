module
public import Theory.GroupTheory.Signalizer.Generation
public import Theory.GroupTheory.Signalizer.Restriction
public import Theory.GroupTheory.Signalizer.Conjugation

/-!
# The generated signalizer subgroup inside an invariant subgroup

For a binary signalizer family, `closureWithin H` is the actual subgroup
generated by the intersections of its values with H. It is the ambient
image of the closure of the restricted family. For an elementary binary
actor of order at least four, every signalizer subgroup contained in H
lies in this generated subgroup by noncyclic fixed-point generation.

When the restriction is complete, this gives the largest signalizer
subgroup inside H and exact fixed-value recovery. Conjugation by the
common intersection of the family values carries this generated subgroup
to the corresponding generated subgroup inside the conjugate of H.
All restrictions use the original supplied action. No completeness is
stored in the family or assumed for the containment theorem.

This formalizes the notation theta(H) in Kurzweil–Stellmacher, *The Theory
of Finite Groups*, Section 11.1 (printed p.305), used for normalizer
closures in the local completeness argument of Section 11.2.
-/

namespace Theory.GroupTheory.TwoSignalizerFamily

variable {A G : Type*} [Group A] [Group G] [MulDistribMulAction A G]

@[expose] public def closureWithin (θ : TwoSignalizerFamily A G) (H : Subgroup G) : Subgroup G :=
  ⨆ a, θ.subgroup a ⊓ H

public theorem closureWithin_le (θ : TwoSignalizerFamily A G) (H : Subgroup G) :
    θ.closureWithin H ≤ H := iSup_le fun _ => inf_le_right

public theorem closureWithin_le_closure (θ : TwoSignalizerFamily A G) (H : Subgroup G) :
    θ.closureWithin H ≤ θ.closure := iSup_le fun a => inf_le_left.trans (θ.le_closure a)

public theorem value_inf_le_closureWithin (θ : TwoSignalizerFamily A G)
    (H : Subgroup G) (a : {a : A // a ≠ 1}) : θ.subgroup a ⊓ H ≤ θ.closureWithin H :=
  le_iSup (fun b : {b : A // b ≠ 1} => θ.subgroup b ⊓ H) a

public theorem closureWithin_mono (θ : TwoSignalizerFamily A G) {H K : Subgroup G}
    (hHK : H ≤ K) : θ.closureWithin H ≤ θ.closureWithin K :=
  iSup_mono fun _ => inf_le_inf_left _ hHK

public theorem closureWithin_eq_restrict (θ : TwoSignalizerFamily A G)
    (H : Subgroup G) [IsInvariant A G H] :
    θ.closureWithin H = (θ.restrict H).closure.map H.subtype :=
  (θ.restrict_closure_map H).symm

public theorem closureWithin_invariant (θ : TwoSignalizerFamily A G)
    (H : Subgroup G) [IsInvariant A G H] : IsInvariant A G (θ.closureWithin H) := by
  rw [θ.closureWithin_eq_restrict H]
  let := (θ.restrict H).closure_invariant
  exact isInvariant_map_subtype H (θ.restrict H).closure

public theorem IsSignalizerSubgroup.le_closureWithin
    [Finite A] [Finite G] [IsElementaryAbelian 2 A]
    {θ : TwoSignalizerFamily A G} {U H : Subgroup G} [IsInvariant A G H]
    (hU : θ.IsSignalizerSubgroup U) (hA : 4 ≤ Nat.card A) (hUH : U ≤ H) :
    U ≤ θ.closureWithin H := by
  have hnative := ((θ.isSignalizerSubgroup_subgroupOf_iff H U hUH).mpr hU).le_closure hA
  have hmapped := Subgroup.map_mono (f := H.subtype) hnative
  rwa [Subgroup.map_subgroupOf_eq_of_le hUH, ← θ.closureWithin_eq_restrict H] at hmapped

public theorem isSignalizerSubgroup_closureWithin_iff (θ : TwoSignalizerFamily A G)
    (H : Subgroup G) [IsInvariant A G H] :
    θ.IsSignalizerSubgroup (θ.closureWithin H) ↔ (θ.restrict H).IsComplete := by
  rw [closureWithin_eq_restrict]
  exact (θ.isComplete_restrict_iff H).symm

public theorem closureWithin_fixed_eq (θ : TwoSignalizerFamily A G)
    (H : Subgroup G) [IsInvariant A G H] (hH : (θ.restrict H).IsComplete)
    (a : {a : A // a ≠ 1}) :
    θ.closureWithin H ⊓ FixedPoints.subgroup (Subgroup.zpowers a.val) G = θ.subgroup a ⊓ H := by
  have hsig := (θ.isSignalizerSubgroup_closureWithin_iff H).mpr hH
  apply le_antisymm
  · exact le_inf (hsig.2.2.2 a) (inf_le_left.trans (θ.closureWithin_le H))
  · exact le_inf (θ.value_inf_le_closureWithin H a) (inf_le_left.trans (θ.le_fixed a))

public theorem closureWithin_map_conj (θ : TwoSignalizerFamily A G)
    (H : Subgroup G) {c : G} (hc : c ∈ θ.common) :
    (θ.closureWithin H).map (MulAut.conj c : G →* G) =
      θ.closureWithin (H.map (MulAut.conj c : G →* G)) := by
  simp only [closureWithin, Subgroup.map_iSup]
  apply iSup_congr
  intro a
  rw [Subgroup.map_inf (θ.subgroup a) H (MulAut.conj c : G →* G) (show Function.Injective (MulAut.conj c : G →* G) from
    (MulAut.conj c).injective)]
  rw [Subgroup.mem_normalizer_iff_map_conj_eq.mp
    ((θ.subgroup a).le_normalizer (θ.common_le a hc))]

end Theory.GroupTheory.TwoSignalizerFamily
