module
public import Theory.GroupTheory.Signalizer.Defs
public import Theory.GroupTheory.PPrimeCoreSupplement
public import Theory.GroupAction.HallProductFixedPoints
public import Theory.ElementaryAbelian.Basic

/-!
# Transferring a local core decomposition to a signalizer value

Let C be an actual signalizer value and U,V actual signalizer subgroups.
If C is generated by its mapped q-prime core and C∩U, and U by its mapped
q-prime core and U∩V, then C is generated by its own mapped q-prime core
and C∩V. The ambient group is finite and the actor is elementary binary;
no actor finiteness, rank, or completeness hypothesis is needed.

A point of C∩U is fixed by C's indexing actor. The core of U is normal
inside U, so its supplied join decomposition is an ordered product. Both
factors are invariant; the odd-intersection fixed-factor theorem supplies
factors fixed by that same cyclic actor. The signalizer bounds place both
back in C. The supplement-core absorption theorem then puts the first in
the core of C, while the second lies in C∩V. The reverse containment follows
from the subgroup definitions. Every action is restricted from the original
supplied action on the ambient group.

This is the fixed-core absorption step in Kurzweil–Stellmacher, *The Theory
of Finite Groups*, §11.2.7 step(2), printed p.322, using the relative
factorization of §11.2.6. The independently proved absorption theorem is
imported from the general prime-core supplement API.
-/

open scoped Pointwise

namespace Theory.GroupTheory.TwoSignalizerFamily

public theorem value_core_factorization_of_local_factorization
    {A G : Type*} [Group A] [Group G] [Finite G]
    [IsElementaryAbelian 2 A] [MulDistribMulAction A G]
    (θ : TwoSignalizerFamily A G) (q : ℕ) [Fact q.Prime]
    (a : {a : A // a ≠ 1}) (U V : Subgroup G)
    (hUsig : θ.IsSignalizerSubgroup U) (hVsig : θ.IsSignalizerSubgroup V)
    (hC : θ.subgroup a = (pPrimeCore q (θ.subgroup a)).map (θ.subgroup a).subtype ⊔
      (θ.subgroup a ⊓ U))
    (hU : U = (pPrimeCore q U).map U.subtype ⊔ (U ⊓ V)) :
    θ.subgroup a = (pPrimeCore q (θ.subgroup a)).map (θ.subgroup a).subtype ⊔
      (θ.subgroup a ⊓ V) := by
  let D := (pPrimeCore q U).map U.subtype
  let E := U ⊓ V
  let _ := hUsig.2.2.1
  let _ := hVsig.2.2.1
  let _ : IsInvariant A U (pPrimeCore q U) :=
    isInvariant_of_characteristic (A := A) (pPrimeCore q U)
  have hDI : IsInvariant A G D := isInvariant_map_subtype U (pPrimeCore q U)
  have hEI : IsInvariant A G E := isInvariant_inf U V
  let _ : IsInvariant (Subgroup.zpowers a.val) G D := ⟨fun b x => hDI.invariant b.val x⟩
  let _ : IsInvariant (Subgroup.zpowers a.val) G E := ⟨fun b x => hEI.invariant b.val x⟩
  have hUD : U ≤ Subgroup.normalizer (D : Set G) := by
    have h := (pPrimeCore q U).le_normalizer_map U.subtype
    rwa [Subgroup.normalizer_eq_top, ← MonoidHom.range_eq_map, Subgroup.range_subtype] at h
  have hED : E ≤ Subgroup.normalizer (D : Set G) := inf_le_left.trans hUD
  have hodd : Odd (Nat.card (D ⊓ E : Subgroup G)) :=
    hUsig.1.of_dvd_nat (Subgroup.card_dvd_of_le
      (show D ⊓ E ≤ U from inf_le_right.trans inf_le_left))
  have habsorb := Subgroup.inf_pPrimeCore_map_le_of_supplement (θ.subgroup a) U hC
  apply le_antisymm
  · calc
      θ.subgroup a = (pPrimeCore q (θ.subgroup a)).map (θ.subgroup a).subtype ⊔
          (θ.subgroup a ⊓ U) := hC
      _ ≤ (pPrimeCore q (θ.subgroup a)).map (θ.subgroup a).subtype ⊔
          (θ.subgroup a ⊓ V) := by
        refine sup_le le_sup_left ?_
        intro x hx
        have hprod : x ∈ (D : Set G) * (E : Set G) := by
          rw [← Subgroup.coe_mul_of_right_le_normalizer_left D E hED]
          change x ∈ (pPrimeCore q U).map U.subtype ⊔ (U ⊓ V)
          rw [← hU]
          exact hx.2
        obtain ⟨y, hy, z, hz, rfl⟩ := Set.mem_mul.mp
          (fixed_mem_mul_of_odd_inf ((IsElementaryAbelian.isPGroup 2 A).to_subgroup _)
            D E hodd (θ.le_fixed a hx.1) hprod)
        have hyU : y ∈ U := Subgroup.map_subtype_le (pPrimeCore q U) hy.1
        have hyC : y ∈ θ.subgroup a := hUsig.2.2.2 a ⟨hyU, hy.2⟩
        have hzC : z ∈ θ.subgroup a := hUsig.2.2.2 a ⟨hz.1.1, hz.2⟩
        exact Subgroup.mul_mem_sup (habsorb ⟨hyC, hy.1⟩) ⟨hzC, hz.1.2⟩
  · exact sup_le (Subgroup.map_subtype_le _) inf_le_left

end Theory.GroupTheory.TwoSignalizerFamily
