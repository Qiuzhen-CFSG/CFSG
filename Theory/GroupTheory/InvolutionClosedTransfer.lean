module
public import Theory.GroupTheory.InvolutionTransfer
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# An index-two transfer kernel containing an involution-generated subgroup

If an index-two subgroup of a Sylow two-subgroup is generated by involutions
and its involutions do not fuse with those outside it, binary transfer extends
its quotient character on involutions. An outside involution makes the transfer
surjective, and its kernel meets the Sylow subgroup in exactly the given subgroup.

This is the form of Thompson transfer used in Parrott, *A characterization
of the Tits' simple group* (1972), §4, p.682.
-/
open Subgroup
namespace Sylow

public theorem exists_normal_index_two_of_involution_fusion
    {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    (U : Subgroup S) (hU : U.index = 2)
    (hgen : U ≤ closure {x : S | x ∈ U ∧ x ^ 2 = 1})
    (hclosed : ∀ x y : S, orderOf x = 2 → IsConj (x : G) (y : G) →
      (x ∈ U ↔ y ∈ U))
    (w : S) (hw : orderOf w = 2) (hwU : w ∉ U) :
    ∃ M : Subgroup G, M.Normal ∧ M.index = 2 ∧ M.subgroupOf (S : Subgroup G) = U := by
  classical
  let : U.Normal := U.normal_of_index_eq_two hU
  have hcard : Nat.card (S ⧸ U) = 2 := hU
  let : IsCyclic (S ⧸ U) := isCyclic_of_prime_card hcard
  let : CommGroup (S ⧸ U) := IsCyclic.commGroup
  let f : S →* S ⧸ U := QuotientGroup.mk' U
  have hf (x : S) : f x = 1 ↔ x ∈ U := QuotientGroup.eq_one_iff x
  have heq (x y : S) (hmem : x ∈ U ↔ y ∈ U) : f y = f x := by
    by_cases hx : x ∈ U
    · rw [(hf x).mpr hx, (hf y).mpr (hmem.mp hx)]
    · obtain ⟨u, _, hunique⟩ := (Nat.card_eq_two_iff' (1 : S ⧸ U)).mp hcard
      exact (hunique _ (fun hh => hx (hmem.mpr ((hf y).mp hh)))).trans
        (hunique _ (fun hh => hx ((hf x).mp hh))).symm
  have htransfer (x : S) (hx : orderOf x = 2) : f.transfer (x : G) = f x := by
    have hrespect (n : ℕ) (y : S)
        (hconj : IsConj (((x ^ n) : S) : G) (y : G)) : f y = f (x ^ n) := by
      have hreduce : x ^ n = x ^ (n % 2) := by
        simpa only [hx] using (pow_mod_orderOf x n).symm
      rw [hreduce] at hconj ⊢
      have hlt := Nat.mod_lt n (by decide : 0 < 2)
      generalize n % 2 = r at hconj ⊢ hlt
      interval_cases r
      · have hy : y = 1 := Subtype.coe_injective (isConj_one_right.mp (by simpa using hconj))
        simp [hy]
      · simp only [pow_one] at hconj ⊢
        exact heq x y (hclosed x y hx hconj)
    rw [f.transfer_apply_eq_pow_of_conjugate_powers x hrespect]
    have hodd : (S : Subgroup G).index % 2 = 1 := by
      have hn := S.not_dvd_index
      omega
    simpa only [hcard, hodd, pow_one] using
      (pow_mod_natCard (f x) (S : Subgroup G).index).symm
  let M := f.transfer.ker
  have hwM : (w : G) ∉ M := by
    change f.transfer (w : G) ≠ 1
    rw [htransfer w hw]
    exact fun hh => hwU ((hf w).mp hh)
  have hMk : M.index = 2 := by
    have hd : M.index ∣ 2 := by
      rw [index_ker]
      have hd := card_subgroup_dvd_card f.transfer.range
      rwa [hcard] at hd
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with hone | htwo
    · exact (hwM (index_eq_one.mp hone ▸ mem_top _)).elim
    · exact htwo
  have hUM : U ≤ M.subgroupOf (S : Subgroup G) := by
    apply hgen.trans
    apply (closure_le _).mpr
    rintro x ⟨hxU, hx2⟩
    change f.transfer (x : G) = 1
    by_cases hx1 : x = 1
    · simp [hx1]
    · have hx : orderOf x = 2 := orderOf_eq_prime_iff.mpr ⟨hx2, hx1⟩
      rw [htransfer x hx]
      exact (hf x).mpr hxU
  have hrest : (M.subgroupOf (S : Subgroup G)).index = 2 := by
    have hd : (M.subgroupOf (S : Subgroup G)).index ∣ 2 := by
      have hd := index_dvd_of_le hUM
      rwa [hU] at hd
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with hone | htwo
    · exact (hwM (show w ∈ M.subgroupOf (S : Subgroup G) from
        index_eq_one.mp hone ▸ mem_top w)).elim
    · exact htwo
  refine ⟨M, inferInstance, hMk, (eq_of_le_of_card_ge hUM ?_).symm⟩
  have h1 := U.index_mul_card
  have h2 := (M.subgroupOf (S : Subgroup G)).index_mul_card
  rw [hU] at h1
  rw [hrest] at h2
  omega
end Sylow
