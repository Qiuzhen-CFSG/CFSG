module

public import Theory.GroupTheory.PResidual.PrimeSection
public import Mathlib.GroupTheory.IsPerfect

/-!
# A cubic theta obstruction to a simple two-kernel section

If L is generated by the cubic elements of D, then D normalizes L.
When L/O₂(L) has order three, L is solvable. Its image in a simple perfect
section with two-group kernel is nontrivial (a cubic element survives),
but cannot be the whole section. Thus an overgroup of L admitting that
section cannot lie in D.

This is the noncontainment argument used for the degree-four local
component in Aschbacher–Smith, combined manuscript of 1 March 2004,
13.8.25, printed p.959 (PDF p.976). It uses relative normality only.
-/

public section

open Subgroup
open scoped IsMulCommutative
namespace Subgroup
variable {G S : Type*} [Group G] [Group S]

private theorem cubic_theta_normalizes (D : Subgroup G) :
    D ≤ normalizer (closure {x : G | x ∈ D ∧ orderOf x = 3} : Set G) := by
  apply le_normalizer_closure_iff.mpr
  intro g hg x hx
  apply subset_closure
  refine ⟨D.mul_mem (D.mul_mem hg hx.1) (D.inv_mem hg), ?_⟩
  exact ((MulAut.conj g).orderOf_eq x).trans hx.2

/-- If L is the cubic theta subgroup of D and has cubic two-core quotient,
an overgroup of L with a simple perfect two-kernel section is not contained in D. -/
theorem not_le_cubic_theta_of_simple_two_section [Finite G]
    [IsSimpleGroup S] [Group.IsPerfect S]
    (L D Y : Subgroup G)
    (htheta : L = closure {x : G | x ∈ D ∧ orderOf x = 3})
    (hLY : L ≤ Y) (hc : Nat.card (L ⧸ pCore 2 L) = 3)
    (f : Y →* S) (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker) :
    ¬ Y ≤ D := by
  intro hYD
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  let : Group.IsNilpotent (pCore 2 L) := pCore_isPGroup.isNilpotent
  let : IsCyclic (L ⧸ pCore 2 L) := isCyclic_of_prime_card hc
  let : Group.IsSolvable L :=
    (Group.isSolvable_iff_subgroup_quotient (pCore 2 L)).mpr ⟨inferInstance, inferInstance⟩
  let A := L.subgroupOf Y
  let : Group.IsSolvable A := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe hLY).toMonoidHom) (subgroupOfEquivOfLe hLY).injective
  have hn : Y ≤ normalizer (L : Set G) := by
    rw [htheta]
    exact hYD.trans (cubic_theta_normalizes D)
  let : A.Normal := (normal_subgroupOf_iff_le_normalizer hLY).mpr hn
  let : (A.map f).Normal := (inferInstance : A.Normal).map f hf
  rcases (inferInstance : (A.map f).Normal).eq_bot_or_eq_top with hb | ht
  · obtain ⟨x, hx, _⟩ := exists_prime_order_sup_pCore_eq_top (G := L)
      (by decide : Nat.Coprime 2 3) hc
    let y : Y := ⟨x, hLY x.property⟩
    have hy : orderOf y = 3 := by
      rw [← Y.orderOf_coe y]
      exact (L.orderOf_coe x).trans hx
    have ho : orderOf (f y) = 3 :=
      (f.orderOf_map_eq_of_coprime_of_isPGroup_ker hk y (hy ▸ (by decide))).trans hy
    have hz : f y = 1 := mem_bot.mp (hb ▸ mem_map_of_mem f (show y ∈ A from x.property))
    rw [hz, orderOf_one] at ho
    exact (by decide : (1 : ℕ) ≠ 3) ho
  · have hs : Function.Surjective (f.comp A.subtype) := by
      apply MonoidHom.range_eq_top.mp
      rw [MonoidHom.range_comp, range_subtype, ht]
    exact Group.IsPerfect.not_isSolvable S (Group.isSolvable_of_surjective hs)
end Subgroup

end
