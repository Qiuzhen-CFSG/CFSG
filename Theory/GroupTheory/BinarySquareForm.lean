module

public import Theory.GroupTheory.CentralBinaryKernelSquares
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.LinearAlgebra.QuadraticForm.Basic
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.Tactic.Group

/-!
# Binary quadratic forms from central squares

For a surjection from a group onto a binary vector space with kernel the
center, squares and commutators are central. If the center has exponent two,
squaring is independent of the representative. Applying a binary character
of the center gives a quadratic form: its polar form is the character of the
commutator, whose additivity follows from the class-two commutator identity.

When the center is generated by a central involution `s` and a disjoint
subgroup of order two, the quotient of the center by `⟨s⟩` has order two.
Its binary character therefore detects exactly squares outside `⟨s⟩`.
No recognition of the group or its quotient is used; finiteness of the
ambient group is unnecessary.

Source application: the square calculation modulo `V₄` in Aschbacher–Smith,
I.2.2(5), refs/quasithin.pdf, printed p.412 / PDF p.423. The square/polar
argument also appears in `QuaternionCentralProductOrthogonalAction.Geometry.Basic`;
here it applies to arbitrary central extensions with these hypotheses.
-/

public section

open Subgroup
open scoped commutatorElement
namespace Theory.GroupTheory.BinarySquareForm
variable {R V : Type*} [Group R] [AddCommGroup V] [Module (ZMod 2) V]
variable (c : R →* Multiplicative V) (hc : c.ker = center R)

include c hc

/-- Squares lie in the kernel because the coordinate space has characteristic two. -/
theorem square_mem_center (r : R) : r ^ 2 ∈ center R := by
  rw [← hc, MonoidHom.mem_ker, map_pow]
  change (2 : ℕ) • (c r).toAdd = 0
  rw [← Nat.cast_smul_eq_nsmul (ZMod 2), ZMod.natCast_self, zero_smul]

omit [Module (ZMod 2) V] in
/-- Commutators are central because the coordinate space is abelian. -/
theorem commutator_mem_center (x y : R) : ⁅x,y⁆ ∈ center R := by
  rw [← hc, MonoidHom.mem_ker, map_commutatorElement]
  exact commutatorElement_eq_one_iff_mul_comm.mpr (mul_comm _ _)

omit [Module (ZMod 2) V] in
/-- The square is independent of the chosen coordinate representative. -/
theorem square_eq_of_coordinates_eq
    (h2 : ∀ z ∈ center R, z ^ 2 = 1) {x y : R} (hxy : c x = c y) :
    x ^ 2 = y ^ 2 :=
  c.square_eq_of_map_eq_of_central_binary_kernel hc.le (by simpa only [hc] using h2) hxy

variable (hsurj : Function.Surjective c) (h2 : ∀ z ∈ center R, z ^ 2 = 1)
variable (χ : center R →* Multiplicative (ZMod 2))

/-- Evaluate the central character on the square of a chosen lift. -/
noncomputable def square (v : V) : ZMod 2 :=
  (χ ⟨(hsurj (Multiplicative.ofAdd v)).choose ^ 2,
    square_mem_center c hc _⟩).toAdd

include h2 in
/-- The chosen-lift definition agrees with the square of every lift. -/
theorem square_coordinates (r : R) :
    square c hc hsurj χ (c r).toAdd =
      (χ ⟨r ^ 2, square_mem_center c hc r⟩).toAdd := by
  unfold square
  congr 2
  apply Subtype.ext
  exact square_eq_of_coordinates_eq c hc h2 (hsurj _).choose_spec

include h2 in
theorem square_zero : square c hc hsurj χ 0 = 0 := by
  have h := square_coordinates c hc hsurj h2 χ 1
  simp only [map_one, one_pow] at h
  change square c hc hsurj χ 0 = (χ 1).toAdd at h
  simpa only [map_one, toAdd_one] using h

private theorem square_mul (x y : R) :
    (x * y) ^ 2 = x ^ 2 * y ^ 2 * ⁅x,y⁆ := by
  symm
  calc
    x ^ 2 * y ^ 2 * ⁅x,y⁆ = ⁅x,y⁆ * (x ^ 2 * y ^ 2) :=
      mem_center_iff.mp (commutator_mem_center c hc x y) _
    _ = x * y * x⁻¹ * (y⁻¹ * x ^ 2) * y ^ 2 := by
      simp only [commutatorElement_def, mul_assoc]
    _ = x * y * x⁻¹ * (x ^ 2 * y⁻¹) * y ^ 2 := by
      rw [mem_center_iff.mp (square_mem_center c hc x)]
    _ = (x * y) ^ 2 := by simp only [pow_two]; group

include h2 in
/-- The polar map is the central character evaluated on the commutator. -/
theorem polar_coordinates (x y : R) :
    QuadraticMap.polar (square c hc hsurj χ) (c x).toAdd (c y).toAdd =
      (χ ⟨⁅x,y⁆, commutator_mem_center c hc x y⟩).toAdd := by
  have hs : (⟨(x*y)^2, square_mem_center c hc (x*y)⟩ : center R) =
      ⟨x^2, square_mem_center c hc x⟩ * ⟨y^2, square_mem_center c hc y⟩ *
        ⟨⁅x,y⁆, commutator_mem_center c hc x y⟩ := Subtype.ext (square_mul c hc x y)
  simp only [QuadraticMap.polar, ← toAdd_mul, ← map_mul]
  rw [square_coordinates c hc hsurj h2, square_coordinates c hc hsurj h2,
    square_coordinates c hc hsurj h2, hs, map_mul χ, map_mul χ]
  simp only [toAdd_mul]
  abel

include h2 in
theorem polar_add_left (u v w : V) :
    QuadraticMap.polar (square c hc hsurj χ) (u + v) w =
      QuadraticMap.polar (square c hc hsurj χ) u w +
        QuadraticMap.polar (square c hc hsurj χ) v w := by
  obtain ⟨x, hx⟩ := hsurj (Multiplicative.ofAdd u)
  obtain ⟨y, hy⟩ := hsurj (Multiplicative.ofAdd v)
  obtain ⟨z, hz⟩ := hsurj (Multiplicative.ofAdd w)
  have hu : u = (c x).toAdd := congrArg Multiplicative.toAdd hx.symm
  have hv : v = (c y).toAdd := congrArg Multiplicative.toAdd hy.symm
  have hw : w = (c z).toAdd := congrArg Multiplicative.toAdd hz.symm
  subst u v w
  have hc' : ⁅x*y,z⁆ = ⁅x,z⁆ * ⁅y,z⁆ := by
    rw [commutatorElement_mul_left_eq_conj_mul,
      mem_center_iff.mp (commutator_mem_center c hc y z) x]
    simp only [mul_inv_cancel_right]
    exact (mem_center_iff.mp (commutator_mem_center c hc y z) ⁅x,z⁆).symm
  rw [← toAdd_mul, ← map_mul]
  rw [polar_coordinates c hc hsurj h2, polar_coordinates c hc hsurj h2,
    polar_coordinates c hc hsurj h2]
  have he : (⟨⁅x*y,z⁆, commutator_mem_center c hc (x*y) z⟩ : center R) =
      ⟨⁅x,z⁆, commutator_mem_center c hc x z⟩ *
        ⟨⁅y,z⁆, commutator_mem_center c hc y z⟩ := Subtype.ext hc'
  rw [he, map_mul χ]
  rfl

include h2 in
/-- Binary scalar homogeneity of the square function. -/
theorem square_smul (a : ZMod 2) (v : V) :
    square c hc hsurj χ (a • v) = (a * a) • square c hc hsurj χ v := by
  have binary : ∀ a : ZMod 2, a = 0 ∨ a = 1 := by decide
  rcases binary a with rfl | rfl <;> simp [square_zero c hc hsurj h2 χ]

include h2 in
/-- Scalar linearity of the polar map; symmetry gives linearity on the right. -/
theorem polar_smul_left (a : ZMod 2) (v w : V) :
    QuadraticMap.polar (square c hc hsurj χ) (a • v) w =
      a • QuadraticMap.polar (square c hc hsurj χ) v w := by
  have binary : ∀ a : ZMod 2, a = 0 ∨ a = 1 := by decide
  rcases binary a with rfl | rfl <;>
    simp [QuadraticMap.polar, square_zero c hc hsurj h2 χ]

/-- The quadratic form defined by a binary central character and squaring. -/
noncomputable def quadraticForm : QuadraticForm (ZMod 2) V :=
  QuadraticMap.ofPolar (square c hc hsurj χ)
    (square_smul c hc hsurj h2 χ)
    (polar_add_left c hc hsurj h2 χ)
    (polar_smul_left c hc hsurj h2 χ)

section Character
omit c hc
variable (s : R) (hs : s ∈ center R) (hs2 : s ^ 2 = 1)
    (Z : Subgroup R) (hcenter : center R = zpowers s ⊔ Z)
    (hZ : Nat.card Z = 2) (hsZ : s ∉ Z)

include hs hs2 hcenter hZ hsZ in
/-- The central quotient by the chosen involution has a binary character with
exactly that cyclic subgroup as kernel. -/
theorem exists_central_character :
    ∃ χ : center R →* Multiplicative (ZMod 2),
      ∀ z : center R, (χ z).toAdd = 0 ↔ (z : R) ∈ zpowers s := by
  classical
  have hsle : zpowers s ≤ center R := zpowers_le.mpr hs
  have hZle : Z ≤ center R := hcenter ▸ le_sup_right
  have horder : orderOf s = 2 := orderOf_eq_prime hs2 (fun h => hsZ (h ▸ Z.one_mem))
  have hfin : IsOfFinOrder s := isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by decide, hs2⟩
  have hcases {x : R} (hx : x ∈ zpowers s) : x = 1 ∨ x = s := by
    rw [hfin.mem_zpowers_iff_mem_range_orderOf, horder] at hx
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hx
    have hn2 := Finset.mem_range.mp hn
    have hn' : n = 0 ∨ n = 1 := by omega
    rcases hn' with rfl | rfl <;> simp
  let H := (zpowers s).subgroupOf (center R)
  let π := QuotientGroup.mk' H
  let i : Z →* center R := inclusion hZle
  let f : Z →* (center R ⧸ H) := π.comp i
  have hinj : Function.Injective f := by
    apply f.ker_eq_bot_iff.mp
    apply bot_unique
    intro z hz
    have hzH : (z : R) ∈ zpowers s := (QuotientGroup.eq_one_iff (i z)).mp hz
    rcases hcases hzH with h | h
    · exact Subtype.ext h
    · exact (hsZ (h ▸ z.property)).elim
  have hsurj : Function.Surjective f := by
    let : (zpowers s).Normal := ⟨fun n hn g => by
      rw [mem_center_iff.mp (hsle hn) g, mul_inv_cancel_right]
      exact hn⟩
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective H q
    have hx : (x : R) ∈ zpowers s ⊔ Z := hcenter ▸ x.property
    obtain ⟨y, hy, z, hz, he⟩ := mem_sup_of_normal_left.mp hx
    refine ⟨⟨z, hz⟩, ?_⟩
    have hx' : x = (⟨y, hsle hy⟩ : center R) * ⟨z, hZle hz⟩ :=
      Subtype.ext he.symm
    change π (⟨z, hZle hz⟩ : center R) = π x
    have hy' : π (⟨y, hsle hy⟩ : center R) = 1 :=
      (QuotientGroup.eq_one_iff (N := H) _).mpr hy
    rw [hx', map_mul, hy', one_mul]
  have hcard : Nat.card (center R ⧸ H) = 2 :=
    (Nat.card_congr (Equiv.ofBijective f ⟨hinj, hsurj⟩)).symm.trans hZ
  let e : (center R ⧸ H) ≃* Multiplicative (ZMod 2) :=
    mulEquivOfPrimeCardEq hcard (by simp)
  refine ⟨e.toMonoidHom.comp π, ?_⟩
  intro z
  change e (π z) = 1 ↔ (z : R) ∈ zpowers s
  rw [e.map_eq_one_iff]
  exact QuotientGroup.eq_one_iff z

end Character

/-- The quadratic form evaluates the square of the literal representative. -/
theorem quadraticForm_coordinates (r : R) :
    quadraticForm c hc hsurj h2 χ (c r).toAdd =
      (χ ⟨r ^ 2, square_mem_center c hc r⟩).toAdd :=
  square_coordinates c hc hsurj h2 χ r

/-- The bilinear polar form evaluates the literal group commutator. -/
theorem polarBilin_coordinates (x y : R) :
    (quadraticForm c hc hsurj h2 χ).polarBilin (c x).toAdd (c y).toAdd =
      (χ ⟨⁅x,y⁆, commutator_mem_center c hc x y⟩).toAdd :=
  polar_coordinates c hc hsurj h2 χ x y

include hsurj h2 in
/-- Squaring modulo the chosen central involution is a binary quadratic form. -/
theorem exists_quadraticForm (s : R) (hs : s ∈ center R)
    (Z : Subgroup R) (hcenter : center R = zpowers s ⊔ Z)
    (hZ : Nat.card Z = 2) (hsZ : s ∉ Z) :
    ∃ q : QuadraticForm (ZMod 2) V,
      ∀ r : R, q (c r).toAdd = 0 ↔ r ^ 2 ∈ zpowers s := by
  obtain ⟨χ, hχ⟩ := exists_central_character s hs (h2 s hs) Z hcenter hZ hsZ
  refine ⟨quadraticForm c hc hsurj h2 χ, fun r => ?_⟩
  rw [quadraticForm_coordinates]
  exact hχ _

end Theory.GroupTheory.BinarySquareForm
