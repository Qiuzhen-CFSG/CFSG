module
public import Theory.GroupTheory.PerfectCentralCoverSylowNine
import all Theory.GroupTheory.PerfectCentralCoverSylowNine

/-!
# Perfect central covers with a semidihedral Sylow subgroup

For an SD16 Sylow subgroup, choose lifts a,b of its standard generators.
Centrality of b² and z = bab⁻¹a⁻³ gives [b,a] = a²z and [b,a]⁴ = 1.
The cyclic subgroup generated by this commutator is normal and contains the
whole derived subgroup. Its image has order four, so it meets the covering
kernel trivially. Central Sylow transfer then excludes two from that kernel.

The actual M₁₁ application is in `Theory.Mathieu.SchurMultipliers`, using
its certified SD16 subgroup. Source: Aschbacher–Smith I.1.1–I.1.3, p.407.
The internal import reuses the existing two-generator derived-subgroup lemma.
-/

open Subgroup
open scoped commutatorElement
namespace PerfectCentralCovering.Semidihedral

private theorem local_bound {H : Type*} [Group H] [Finite H]
    (a b : H) (hgen : closure ({a, b} : Set H) = ⊤)
    (hb : b ^ 2 ∈ center H)
    (hz : b * a * b⁻¹ * (a ^ 3)⁻¹ ∈ center H) :
    _root_.commutator H ≤ zpowers ⁅b, a⁆ ∧ ⁅b, a⁆ ^ 4 = 1 := by
  let z := b * a * b⁻¹ * (a ^ 3)⁻¹
  have hza : Commute z a := (mem_center_iff.mp hz a).symm
  have hzb : Commute z b := (mem_center_iff.mp hz b).symm
  let φ := MulAut.conj b
  have hφa : φ a = a ^ 3 * z := by
    change b * a * b⁻¹ = a ^ 3 * z
    rw [← (hza.pow_right 3).eq]
    dsimp [z]
    group
  have hφz : φ z = z := by
    change b * z * b⁻¹ = z
    rw [hzb.symm.eq, mul_inv_cancel_right]
  have hφφa : φ (φ a) = a := by
    change b * (b * a * b⁻¹) * b⁻¹ = a
    calc
      _ = b ^ 2 * a * (b ^ 2)⁻¹ := by simp only [pow_two, mul_inv_rev]; group
      _ = a := by rw [← mem_center_iff.mp hb a, mul_inv_cancel_right]
  have hrel : a ^ 8 * z ^ 4 = 1 := by
    have h := hφφa
    rw [hφa, map_mul, map_pow, hφa, hφz,
      (hza.symm.pow_left 3).mul_pow] at h
    have hh : a * (a ^ 8 * z ^ 4) = a * 1 := by
      calc
        _ = (a ^ 3) ^ 3 * z ^ 3 * z := by group
        _ = a := h
        _ = a * 1 := (mul_one _).symm
    exact mul_left_cancel hh
  have hc : ⁅b, a⁆ = a ^ 2 * z := by
    rw [commutatorElement_def]
    change φ a * a⁻¹ = a ^ 2 * z
    rw [hφa, mul_assoc, hza.inv_right.eq]
    group
  have hcpow : ⁅b, a⁆ ^ 4 = 1 := by
    rw [hc, (hza.symm.pow_left 2).mul_pow, ← pow_mul]
    exact hrel
  have hca : Commute ⁅b, a⁆ a := by
    rw [hc]
    exact (Commute.refl a |>.pow_left 2).mul_left hza
  have hφc : φ ⁅b, a⁆ = ⁅b, a⁆ ^ 3 := by
    rw [hc, map_mul, map_pow, hφa, hφz,
      (hza.symm.pow_left 3).mul_pow, (hza.symm.pow_left 2).mul_pow]
    group
  have hn : (zpowers ⁅b, a⁆).Normal := by
    rw [← normalizer_eq_top_iff]
    apply top_unique
    rw [← hgen, closure_le]
    intro g hg
    rcases Set.mem_insert_iff.mp hg with hg | hg
    · subst g
      apply mem_normalizer_fintype
      intro v hv
      obtain ⟨n, rfl⟩ := mem_zpowers_iff.mp hv
      rw [(hca.symm.zpow_right n).eq, mul_inv_cancel_right]
      exact zpow_mem (mem_zpowers _) _
    · have hg : g = b := Set.mem_singleton_iff.mp hg
      subst g
      apply mem_normalizer_fintype
      intro v hv
      obtain ⟨n, rfl⟩ := mem_zpowers_iff.mp hv
      change φ (⁅b, a⁆ ^ n) ∈ zpowers ⁅b, a⁆
      rw [map_zpow, hφc]
      exact zpow_mem (pow_mem (mem_zpowers _) _) _
  let := hn
  refine ⟨?_, hcpow⟩
  apply SylowNine.derived_le_of_pair a b hgen
  rw [← commutatorElement_inv b a]
  exact inv_mem (mem_zpowers _)

end Semidihedral

/-- An SD16 Sylow subgroup excludes two from every finite perfect central kernel. -/
public theorem not_two_dvd_card_kernel_of_semidihedral_sylow
    {E G : Type*} [Group E] [Finite E] [Group.IsPerfect E] [Group G] [Finite G]
    (f : E →* G) (hf : Function.Surjective f) (hk : f.ker ≤ center E)
    (Q : Sylow 2 G) (a b : Q) (ha : orderOf a = 8) (hb : b ^ 2 = 1)
    (hba : b * a * b⁻¹ = a ^ 3) (hgen : closure ({a, b} : Set Q) = ⊤) :
    ¬ 2 ∣ Nat.card f.ker := by
  obtain ⟨P, hPQ⟩ := Sylow.mapSurjective_surjective hf 2 Q
  have hmap : (P : Subgroup E).map f = (Q : Subgroup G) := by
    rw [← Sylow.coe_mapSurjective hf, hPQ]
  obtain ⟨xE, hxP, hx⟩ := show (a : G) ∈ (P : Subgroup E).map f by
    rw [hmap]; exact a.property
  obtain ⟨yE, hyP, hy⟩ := show (b : G) ∈ (P : Subgroup E).map f by
    rw [hmap]; exact b.property
  let x : P := ⟨xE, hxP⟩
  let y : P := ⟨yE, hyP⟩
  have hxy : closure ({x, y} : Set P) = ⊤ := by
    let g : P →* G := f.comp (P : Subgroup E).subtype
    have hbase : closure ({(a : G), (b : G)} : Set G) = Q := by
      have h := congrArg (Subgroup.map (Q : Subgroup G).subtype) hgen
      simpa only [MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton,
        ← MonoidHom.range_eq_map, range_subtype, coe_subtype] using h
    have hm : (closure ({x, y} : Set P)).map g = g.range := by
      rw [MonoidHom.map_closure]
      simpa only [Set.image_insert_eq, Set.image_singleton, g, MonoidHom.comp_apply,
        Subgroup.coe_subtype, MonoidHom.range_comp, range_subtype, x, y, hx, hy, hmap] using hbase
    have hs : closure ({x, y} : Set P) ⊔ g.ker = ⊤ := by
      have hh := congrArg (Subgroup.comap g) hm
      simpa only [comap_map_eq, MonoidHom.comap_range_self] using hh
    apply frattini_nongenerating
    exact top_unique (hs ▸ sup_le_sup_left (ker_comap_le_frattini_sylow P f hk) _)
  have central (v : P) (hv : f (v : E) = 1) : v ∈ center P :=
    mem_center_iff.mpr fun w => Subtype.ext (mem_center_iff.mp (hk hv) w)
  obtain ⟨hder, hc4⟩ := Semidihedral.local_bound x y hxy
    (central (y ^ 2) (by
      change f (yE ^ 2) = 1
      rw [map_pow, hy]
      exact congrArg Subtype.val hb))
    (central (y * x * y⁻¹ * (x ^ 3)⁻¹) (by
      change f (yE * xE * yE⁻¹ * (xE ^ 3)⁻¹) = 1
      simp only [map_mul, map_inv, map_pow, hx, hy]
      have hh := congrArg Subtype.val hba
      change (b : G) * a * (b : G)⁻¹ = (a : G) ^ 3 at hh
      rw [hh, mul_inv_cancel]))
  have hfc : f (⁅y, x⁆ : P) = (a : G) ^ 2 := by
    change f ⁅yE, xE⁆ = _
    rw [map_commutatorElement, hx, hy, commutatorElement_def]
    have hh := congrArg Subtype.val hba
    change (b : G) * a * (b : G)⁻¹ = (a : G) ^ 3 at hh
    rw [hh]
    group
  have horder : orderOf (f (⁅y, x⁆ : P)) = 4 := by
    rw [hfc, orderOf_pow, Subgroup.orderOf_coe, ha]
    decide +kernel
  intro hd
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' 2 hd
  have hzE : orderOf (z : E) = 2 := (Subgroup.orderOf_coe z).trans hz
  let Z := zpowers (z : E)
  have hZ : Z ≤ center E := zpowers_le.mpr (hk z.property)
  let : Z.Normal := ⟨fun v hv g => by
    rw [mem_center_iff.mp (hZ hv) g, mul_inv_cancel_right]
    exact hv⟩
  have hZp : IsPGroup 2 Z := IsPGroup.of_card (n := 1) (by
    simpa only [Z, Nat.card_zpowers, pow_one] using hzE)
  have hzP : (z : E) ∈ (P : Subgroup E) := hZp.le_sylow_of_normal P (mem_zpowers _)
  have hzd := center_inf_commutator_inf_sylow_le_commutator P
    ⟨⟨hk z.property, Group.IsPerfect.mem_commutator⟩, hzP⟩
  rw [← map_subtype_commutator] at hzd
  obtain ⟨w, hw, hwz⟩ := hzd
  obtain ⟨n, hn⟩ := mem_zpowers_iff.mp (hder hw)
  have hfn : (f (⁅y, x⁆ : P)) ^ n = 1 := by
    rw [← map_zpow]
    exact (congrArg f ((congrArg Subtype.val hn).trans hwz)).trans z.property
  have hdiv := orderOf_dvd_iff_zpow_eq_one.mpr hfn
  rw [horder] at hdiv
  obtain ⟨k, hk⟩ := hdiv
  have hone : (z : E) = 1 := by
    rw [← hwz, ← hn, hk, zpow_mul, zpow_natCast, hc4, one_zpow]
    rfl
  rw [hone, orderOf_one] at hzE
  norm_num at hzE

end PerfectCentralCovering
