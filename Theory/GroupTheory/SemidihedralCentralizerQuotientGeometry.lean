module
public import Theory.GroupTheory.DihedralPresentation
public import Theory.GroupTheory.SemidihedralCenter
public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.Subgroup.Center
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Tactic.NormNum
public import Mathlib.Tactic.Positivity

/-!
# The actual dihedral Sylow image in a semidihedral centralizer quotient

For an explicit semidihedral Sylow two-subgroup of order `2^n`, `n ≥ 4`,
the half-order power `z` is an involution centralized by that Sylow subgroup.
Inside `N = C_G(z)`, the cyclic subgroup generated by the actual element
`zN` is central and normal. The actual inclusion followed by the quotient
map has a Sylow image of order `2^(n-1)`, isomorphic to
`DihedralGroup (2^(n-2))`. The quarter-order power maps to a central
involution of this image. The presentation squares are retained explicitly.

The proof uses `Semidihedral.center_eq` for centralizer containment, restricts
the given Sylow subgroup to `N`, and applies surjective Sylow transport.
The composite homomorphism has kernel generated by the half-order power.
The first isomorphism theorem computes its image cardinality. The mapped
generators satisfy the dihedral relations and still generate, so
`dihedralGroup_equiv_of_relations` recognizes the image. Its quarter-power
element commutes with both generators; it is nontrivial since an element
of order four cannot belong to the order-two kernel.

This is the elementary quotient geometry on printed p.90 of
`refs/files/alperin-brauer-gorenstein.pdf`. The presentation quotient and
Sylow transport also occur in ABG II.1 and II.3. This module has only downward
imports and uses no ambient fusion or no-normal-index-two assumption.
The exposed predicate packages the exact maps and witness, allowing clients
to unpack the geometry while retaining their actual normality instance.
-/

private theorem presentation_squares {H : Type*} [Group H] {n : ℕ}
    (hn : 4 ≤ n) (a b : H) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1)) :
    (a ^ (2 ^ (n - 3))) ^ 2 = a ^ (2 ^ (n - 2)) ∧
      (a * b) ^ 2 = a ^ (2 ^ (n - 2)) ∧ b ^ 2 = 1 := by
  have hb2 : b ^ 2 = 1 := by rw [← hb]; exact pow_orderOf_eq_one b
  refine ⟨?_, ?_, hb2⟩
  · rw [← pow_mul, show n - 2 = n - 3 + 1 by omega, pow_succ]
  · have hba : b * a = a ^ (2 ^ (n - 2) - 1) * b :=
      mul_inv_eq_iff_eq_mul.mp hconj
    calc
      (a * b) ^ 2 = a * (b * a) * b := by simp only [pow_two, mul_assoc]
      _ = a * (a ^ (2 ^ (n - 2) - 1) * b) * b := by rw [hba]
      _ = (a * a ^ (2 ^ (n - 2) - 1)) * b ^ 2 := by simp only [pow_two, mul_assoc]
      _ = a ^ (2 ^ (n - 2)) := by
        rw [hb2, mul_one, ← pow_succ', Nat.sub_add_cancel (Nat.one_le_pow _ _ (by decide))]

private theorem power_orders {H : Type*} [Group H] {n : ℕ}
    (hn : 4 ≤ n) (a : H) (ha : orderOf a = 2 ^ (n - 1)) :
    orderOf (a ^ (2 ^ (n - 2))) = 2 ∧
      orderOf (a ^ (2 ^ (n - 3))) = 4 := by
  constructor
  · rw [orderOf_pow_of_dvd (by positivity) (by rw [ha]; exact pow_dvd_pow 2 (by omega)), ha]
    rw [show n - 1 = n - 2 + 1 by omega, pow_succ, Nat.mul_div_right _ (by positivity)]
  · rw [orderOf_pow_of_dvd (by positivity) (by rw [ha]; exact pow_dvd_pow 2 (by omega)), ha]
    rw [show n - 1 = n - 3 + 2 by omega, pow_add, Nat.mul_div_right _ (by positivity)]
    norm_num

private theorem quotient_image_data {H K : Type*} [Group H] [Group K]
    {n : ℕ} (hn : 4 ≤ n) (hcard : Nat.card H = 2 ^ n)
    (a b : H) (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set H) = ⊤)
    (f : H →* K) (hf : Function.Surjective f)
    (hker : f.ker = Subgroup.zpowers (a ^ (2 ^ (n - 2)))) :
    Nat.card K = 2 ^ (n - 1) ∧
      Nonempty (K ≃* DihedralGroup (2 ^ (n - 2))) ∧
      orderOf (f (a ^ (2 ^ (n - 3)))) = 2 ∧
      f (a ^ (2 ^ (n - 3))) ∈ Subgroup.center K := by
  have horders := power_orders hn a ha
  have hsquares := presentation_squares hn a b hb hconj
  have hhalf : f (a ^ (2 ^ (n - 2))) = 1 := by
    apply MonoidHom.mem_ker.mp
    rw [hker]
    exact Subgroup.mem_zpowers _
  have hrotation : (f a) ^ (2 ^ (n - 2)) = 1 := by simpa only [map_pow] using hhalf
  have hreflection : (f b) ^ 2 = 1 := by rw [← map_pow, hsquares.2.2, map_one]
  have hinversion : f b * f a * (f b)⁻¹ = (f a)⁻¹ := by
    have h := congrArg f hconj
    simp only [map_mul, map_inv, map_pow] at h
    rw [h]
    apply eq_inv_iff_mul_eq_one.mpr
    rw [← pow_succ, Nat.sub_add_cancel (Nat.one_le_pow _ _ (by decide))]
    exact hrotation
  have hg : Subgroup.closure ({f a, f b} : Set K) = ⊤ := by
    have h := congrArg (fun subgroup : Subgroup H => subgroup.map f) hgen
    rw [MonoidHom.map_closure, Subgroup.map_top_of_surjective _ hf] at h
    simpa only [Set.image_insert_eq, Set.image_singleton] using h
  have hc : Nat.card K = 2 ^ (n - 1) := by
    have h := Subgroup.card_eq_card_quotient_mul_card_subgroup f.ker
    rw [hcard, hker, Nat.card_zpowers, horders.1] at h
    have he := Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv
    rw [hker] at he
    rw [he, show n = n - 1 + 1 by omega, pow_succ] at h
    omega
  refine ⟨hc, ?_, ?_, ?_⟩
  · exact dihedralGroup_equiv_of_relations (by positivity) _ _ hrotation hreflection
      hinversion hg (by rw [hc, show n - 1 = n - 2 + 1 by omega, pow_succ]; omega)
  · apply orderOf_eq_prime
    · rw [← map_pow, hsquares.1, hhalf]
    · intro htrivial
      have hmem : a ^ (2 ^ (n - 3)) ∈ Subgroup.zpowers (a ^ (2 ^ (n - 2))) := by
        rw [← hker]
        exact htrivial
      have hdvd := orderOf_dvd_of_mem_zpowers hmem
      rw [horders.1, horders.2] at hdvd
      norm_num at hdvd
  · have htsquare : (f (a ^ (2 ^ (n - 3)))) ^ 2 = 1 := by
      rw [← map_pow, hsquares.1, hhalf]
    have hcomm : ∀ y : K, y * f (a ^ (2 ^ (n - 3))) = f (a ^ (2 ^ (n - 3))) * y := by
      have hle : Subgroup.closure ({f a, f b} : Set K) ≤
          Subgroup.centralizer {f (a ^ (2 ^ (n - 3)))} := by
        apply (Subgroup.closure_le _).mpr
        intro y hy
        rcases Set.mem_insert_iff.mp hy with rfl | hy
        · apply Subgroup.mem_centralizer_singleton_iff.mpr
          rw [map_pow]
          exact (Commute.self_pow (f a) _).eq
        · have hyb : y = f b := Set.mem_singleton_iff.mp hy
          subst y
          apply Subgroup.mem_centralizer_singleton_iff.mpr
          apply mul_inv_eq_iff_eq_mul.mp
          rw [map_pow, ← conj_pow, hinversion, inv_pow]
          apply inv_eq_of_mul_eq_one_left
          simpa only [map_pow, pow_two] using htsquare
      rw [hg] at hle
      intro y
      exact Subgroup.mem_centralizer_singleton_iff.mp (hle (Subgroup.mem_top y))
    exact Subgroup.mem_center_iff.mpr hcomm

/-- The actual quotient image, its dihedral model, and its specified central involution. -/
@[expose] public def SemidihedralQuotientSylowGeometry
    {H N : Type*} [Group H] [Group N]
    (n : ℕ) (a : H) (inclusion : H →* N) (zN : N)
    [(Subgroup.zpowers zN).Normal] : Prop :=
  ∃ P : Sylow 2 (N ⧸ Subgroup.zpowers zN),
    (P : Subgroup _) =
      ((QuotientGroup.mk' (Subgroup.zpowers zN)).comp inclusion).range ∧
    Nat.card P = 2 ^ (n - 1) ∧
    Nonempty (P ≃* DihedralGroup (2 ^ (n - 2))) ∧
    ∃ t : P, (t : N ⧸ Subgroup.zpowers zN) =
      QuotientGroup.mk' (Subgroup.zpowers zN) (inclusion (a ^ (2 ^ (n - 3)))) ∧
      orderOf t = 2 ∧ t ∈ Subgroup.center P

/-- An explicit semidihedral Sylow subgroup has the specified actual centralizer quotient geometry. -/
public theorem semidihedral_centralizer_quotient_geometry
    {G : Type*} [Group G] [Finite G] (S : Sylow 2 G)
    {n : ℕ} (hn : 4 ≤ n) (hcard : Nat.card S = 2 ^ n)
    (a b : S) (ha : orderOf a = 2 ^ (n - 1)) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ (2 ^ (n - 2) - 1))
    (hgen : Subgroup.closure ({a, b} : Set S) = ⊤) :
    let z : G := (a ^ (2 ^ (n - 2)) : S)
    orderOf z = 2 ∧
      (a ^ (2 ^ (n - 3))) ^ 2 = a ^ (2 ^ (n - 2)) ∧
      (a * b) ^ 2 = a ^ (2 ^ (n - 2)) ∧ b ^ 2 = 1 ∧
      ∃ hSN : (S : Subgroup G) ≤ Subgroup.centralizer {z},
        let N := Subgroup.centralizer ({z} : Set G)
        let zN : N := ⟨z, Subgroup.mem_centralizer_singleton_iff.mpr rfl⟩
        zN ∈ Subgroup.center N ∧
        ∃ hZ : (Subgroup.zpowers zN).Normal,
          letI := hZ
          SemidihedralQuotientSylowGeometry n a (Subgroup.inclusion hSN) zN := by
  classical
  have hcentral : a ^ (2 ^ (n - 2)) ∈ Subgroup.center S := by
    exact (Semidihedral.center_eq hn a b ha hb hconj hgen).symm ▸ Subgroup.mem_zpowers _
  dsimp only
  let z : G := (a ^ (2 ^ (n - 2)) : S)
  have hzorder : orderOf z = 2 := by
    rw [show orderOf z = orderOf (a ^ (2 ^ (n - 2))) from
      orderOf_injective (S : Subgroup G).subtype Subtype.coe_injective (a ^ (2 ^ (n - 2)))]
    exact (power_orders hn a ha).1
  obtain ⟨hsquare, habsquare, hbsquare⟩ := presentation_squares hn a b hb hconj
  refine ⟨hzorder, hsquare, habsquare, hbsquare, ?_⟩
  have hSN : (S : Subgroup G) ≤ Subgroup.centralizer {z} := by
    intro x hx
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    exact congrArg (fun value : S => (value : G))
      (Subgroup.mem_center_iff.mp hcentral ⟨x, hx⟩)
  refine ⟨hSN, ?_⟩
  let N := Subgroup.centralizer ({z} : Set G)
  let zN : N := ⟨z, Subgroup.mem_centralizer_singleton_iff.mpr rfl⟩
  let inclusion : S →* N := Subgroup.inclusion hSN
  have hzNcenter : zN ∈ Subgroup.center N := by
    apply Subgroup.mem_center_iff.mpr
    intro x
    apply Subtype.ext
    exact Subgroup.mem_centralizer_singleton_iff.mp x.property
  refine ⟨hzNcenter, ?_⟩
  have hZ : (Subgroup.zpowers zN).Normal := by
    have hle : Subgroup.zpowers zN ≤ Subgroup.center N := Subgroup.zpowers_le.mpr hzNcenter
    refine ⟨?_⟩
    intro x hx y
    have hcomm := Subgroup.mem_center_iff.mp (hle hx) y
    rw [hcomm, mul_inv_cancel_right]
    exact hx
  refine ⟨hZ, ?_⟩
  let normality : (Subgroup.zpowers zN).Normal := hZ
  let q := QuotientGroup.mk' (Subgroup.zpowers zN)
  let f : S →* N ⧸ Subgroup.zpowers zN := q.comp inclusion
  let P : Sylow 2 (N ⧸ Subgroup.zpowers zN) :=
    Sylow.mapSurjective (QuotientGroup.mk'_surjective _) (S.subtype hSN)
  have hrange : f.range = (P : Subgroup _) := by
    rw [Sylow.coe_mapSurjective, Sylow.coe_subtype]
    change (q.comp inclusion).range = _
    rw [MonoidHom.range_comp, Subgroup.inclusion_range]
  let F : S →* P := f.codRestrict _ (fun x => hrange ▸ ⟨x, rfl⟩)
  have hF : Function.Surjective F := by
    intro x
    have hx : (x : N ⧸ Subgroup.zpowers zN) ∈ f.range := hrange.symm ▸ x.property
    obtain ⟨y, hy⟩ := hx
    exact ⟨y, Subtype.ext hy⟩
  have hker : F.ker = Subgroup.zpowers (a ^ (2 ^ (n - 2))) := by
    have hzimage : inclusion (a ^ (2 ^ (n - 2))) = zN := rfl
    have hmap : (Subgroup.zpowers (a ^ (2 ^ (n - 2)))).map inclusion =
        Subgroup.zpowers zN := by rw [MonoidHom.map_zpowers, hzimage]
    ext x
    change F x = 1 ↔ x ∈ Subgroup.zpowers (a ^ (2 ^ (n - 2)))
    rw [show F x = 1 ↔ f x = 1 from Subtype.ext_iff]
    change q (inclusion x) = 1 ↔ _
    rw [show q (inclusion x) = 1 ↔ inclusion x ∈ Subgroup.zpowers zN from
      QuotientGroup.eq_one_iff (inclusion x), ← hmap]
    change x ∈ ((Subgroup.zpowers (a ^ (2 ^ (n - 2)))).map inclusion).comap inclusion ↔ _
    rw [Subgroup.comap_map_eq_self_of_injective (Subgroup.inclusion_injective hSN)]
  obtain ⟨hc, he, htorder, htcenter⟩ := quotient_image_data hn hcard a b ha hb hconj hgen F hF hker
  exact ⟨P, hrange.symm, hc, he, F (a ^ (2 ^ (n - 3))), rfl, htorder, htcenter⟩
