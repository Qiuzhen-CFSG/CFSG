module
public import Mathlib.GroupTheory.Subgroup.Simple
public import Mathlib.Algebra.Group.Subgroup.Pointwise
/-!
# The subgroup generated by all automorphic images

The automorphism span is characteristic, contains its seed, and is unchanged
when the seed is replaced by an automorphic image. These are the intrinsic
orbit constructions in Campbell II.8, printed p.38, used to select one pair
before all marked local overgroups.
-/
public section
namespace Subgroup
variable {G H : Type*} [Group G] [Group H]
@[expose] noncomputable def automorphismSpan (U : Subgroup G) : Subgroup G :=
  ⨆ a : MulAut G, U.map a.toMonoidHom

theorem le_automorphismSpan (U : Subgroup G) : U ≤ automorphismSpan U := by
  simpa [automorphismSpan] using
    (le_iSup (fun a : MulAut G => U.map a.toMonoidHom) (MulEquiv.refl G))

theorem map_le_automorphismSpan (U : Subgroup G) (a : MulAut G) :
    U.map a.toMonoidHom ≤ automorphismSpan U := by
  exact le_iSup (fun c : MulAut G => U.map c.toMonoidHom) a

theorem automorphismSpan_characteristic (U : Subgroup G) : (automorphismSpan U).Characteristic := by
  apply characteristic_iff_map_le.mpr
  intro a
  rw [automorphismSpan,map_iSup]
  apply iSup_le
  intro b
  rw [map_map]
  exact le_iSup (fun c : MulAut G => U.map c.toMonoidHom) (b.trans a)

theorem automorphismSpan_le_iff (U N : Subgroup G) [N.Characteristic] :
    automorphismSpan U ≤ N ↔ U ≤ N := by
  constructor
  · exact le_trans (le_automorphismSpan U)
  · intro h
    apply iSup_le
    intro a
    exact (map_mono h).trans_eq ((characteristic_iff_map_eq.mp inferInstance) a)

theorem automorphismSpan_ne_bot {U : Subgroup G} (hU : U ≠ ⊥) : automorphismSpan U ≠ ⊥ := by
  intro h
  exact hU (le_bot_iff.mp (h ▸ le_automorphismSpan U))

theorem automorphismSpan_map_aut (U : Subgroup G) (a : MulAut G) :
    automorphismSpan (U.map a.toMonoidHom) = automorphismSpan U := by
  apply le_antisymm
  · apply iSup_le
    intro b
    rw [map_map]
    exact le_iSup (fun c : MulAut G => U.map c.toMonoidHom) (a.trans b)
  · apply iSup_le
    intro b
    have hl := le_iSup (fun c : MulAut G => (U.map a.toMonoidHom).map c.toMonoidHom) (a.symm.trans b)
    have he : (a.symm.trans b).toMonoidHom.comp a.toMonoidHom = b.toMonoidHom := by
      ext x; exact congrArg b (a.symm_apply_apply x)
    simpa only [automorphismSpan,map_map,he] using hl
end Subgroup
