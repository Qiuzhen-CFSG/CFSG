module
public import Theory.GroupTheory.OrderedRootPresentation

/-!
# Evaluation on a faithfully coordinated ordered root subgroup

The presentation may contain root indices outside the chosen order. Restricting
its evaluation to the subgroup generated by the listed roots removes those
extraneous generators. Collection and uniqueness of native ordered coordinates
make this restricted evaluation an isomorphism, so any second realization of
the same local table receives a homomorphism from the native ordered subgroup.

This is the suffix comparison used in the positive-root collection argument
of Steinberg, §11: only equations internal to the suffix are required.
-/

@[expose] public noncomputable section
namespace Theory.GroupTheory.OrderedRootPresentation
open Subgroup
universe u v
variable {I : Type u} {R : I → Type v} [∀ i, Group (R i)] [DecidableEq I]
  {order : List I} (d : Table R order)
  {G H : Type*} [Group G] [Group H]
  {x : ∀ i, R i →* G} {y : ∀ i, R i →* H}

/-- Evaluation restricted to the subgroup on the chosen list of root indices. -/
def orderedEval (E : Equations d x) (hn : order.Nodup) :
    join R (rootHom d) order →* join R x order :=
  ((eval d E).comp (join R (rootHom d) order).subtype).codRestrict _ (by
    intro g
    obtain ⟨p,hp⟩ := (generator_equations d).exists_word d hn g g.property
    change word R (fun i => root d i) order p = (g : Presentation d) at hp
    change eval d E g ∈ join R x order
    rw [←hp,eval_word]
    exact word_mem_join R x order p)

/-- No cardinal comparison is used: the native word is already injective. -/
theorem orderedEval_bijective (E : Equations d x) (hn : order.Nodup)
    (hi : Function.Injective (word R (fun i => x i) order)) :
    Function.Bijective (orderedEval d E hn) := by
  constructor
  · intro a b hab
    obtain ⟨p,hp⟩ := (generator_equations d).exists_word d hn a a.property
    obtain ⟨q,hq⟩ := (generator_equations d).exists_word d hn b b.property
    change word R (fun i => root d i) order p = (a : Presentation d) at hp
    change word R (fun i => root d i) order q = (b : Presentation d) at hq
    have he := congrArg Subtype.val hab
    change eval d E a = eval d E b at he
    rw [←hp,←hq,eval_word,eval_word] at he
    have hpq := hi he
    apply Subtype.ext
    exact hp.symm.trans (hpq ▸ hq)
  · intro a
    obtain ⟨p,hp⟩ := E.exists_word d hn a a.property
    refine ⟨⟨word R (fun i => root d i) order p,
      word_mem_join R (rootHom d) order p⟩,?_⟩
    apply Subtype.ext
    exact (eval_word d E order p).trans hp

/-- Native ordered coordinates identify the generated part of the presentation. -/
def orderedEquiv (E : Equations d x) (hn : order.Nodup)
    (hi : Function.Injective (word R (fun i => x i) order)) :
    join R (rootHom d) order ≃* join R x order :=
  MulEquiv.ofBijective (orderedEval d E hn) (orderedEval_bijective d E hn hi)

/-- Transport of the internal multiplication law, with no equations outside the order. -/
def realization (E : Equations d x) (F : Equations d y) (hn : order.Nodup)
    (hi : Function.Injective (word R (fun i => x i) order)) : join R x order →* H :=
  ((eval d F).comp (join R (rootHom d) order).subtype).comp
    (orderedEquiv d E hn hi).symm.toMonoidHom

@[simp] theorem realization_root (E : Equations d x) (F : Equations d y)
    (hn : order.Nodup) (hi : Function.Injective (word R (fun i => x i) order))
    (i : I) (hmem : i ∈ order) (a : R i) :
    realization d E F hn hi ⟨x i a,range_le_join R x order hmem ⟨a,rfl⟩⟩ = y i a := by
  let r : join R (rootHom d) order :=
    ⟨root d i a,range_le_join R (rootHom d) order hmem ⟨a,rfl⟩⟩
  have hr : orderedEquiv d E hn hi r =
      ⟨x i a,range_le_join R x order hmem ⟨a,rfl⟩⟩ :=
    Subtype.ext (eval_root d E i a)
  rw [←hr]
  change eval d F ((orderedEquiv d E hn hi).symm ((orderedEquiv d E hn hi) r)) = _
  rw [MulEquiv.symm_apply_apply]
  exact eval_root d F i a

end Theory.GroupTheory.OrderedRootPresentation
