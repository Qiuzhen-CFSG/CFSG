module
public import Stellmacher.ElementaryAbelianMaxOrder
public import Theory.ElementaryAbelian.AbelianNormalClosure
public import Mathlib.GroupTheory.Index
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.GroupTheory.GroupAction.ConjAct
public import Mathlib.Tactic.Linarith

/-!
# Thompson stability in a pair-swapping index-two extension

The involutions of a group generated by two elementary cores lie in their
union when every nontrivial actor has their intersection as its fixed group.
An elementary subgroup in an index-two extension therefore has its fixed
intersection inside both cores. Two successive index bounds force equality
there if it has maximum order. The centralizer bound then improves the
count and gives a contradiction.

Source application: Aschbacher–Smith C.6.1, printed p.165.
-/

public section
open Subgroup
open scoped IsMulCommutative Pointwise
namespace Stellmacher
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem count (Q A : Subgroup G) :
    Nat.card ↥(Q ⊓ A) * Q.relIndex A = Nat.card A := by
  simpa only [relIndex_bot_left,inf_relIndex_right] using
    relIndex_mul_relIndex (⊥ : Subgroup G) (Q ⊓ A) A bot_le inf_le_right

theorem thompson_stable_of_pair_count (M R S Q Q' : Subgroup G)
    (hRM : R ≤ M) (hSR : S ≤ R)
    (hQR : Q ∈ Stellmacher.elementaryAbelianMaxSubgroups R)
    (hi : R.relIndex M = 2)
    (hbound : ∀ E : Subgroup G, E ≤ R → IsElementaryAbelian 2 E →
      Nat.card E ≤ 2 * Nat.card (E ⊓ S : Subgroup G))
    (hcover : ∀ b ∈ S, b ^ 2 = 1 → b ∈ Q ∨ b ∈ Q')
    (hswap : ∀ x ∈ M, x ∉ R →
      Q.map (MulAut.conj x).toMonoidHom = Q' ∧
      Q'.map (MulAut.conj x).toMonoidHom = Q)
    (hcentralizer : R ⊓ centralizer ((Q ⊓ Q' : Subgroup G) : Set G) ≤ S)
    (hlarge : 4 * Nat.card (Q ⊓ Q' : Subgroup G) ≤ Nat.card Q) :
    Stellmacher.elementaryAbelianMaxJ M = Stellmacher.elementaryAbelianMaxJ R := by
  have hJ : Stellmacher.elementaryAbelianMaxJ M ≤ R := by
    apply sSup_le
    intro A hA
    let : IsElementaryAbelian 2 A := hA.2.1
    by_contra hn
    obtain ⟨a,ha,har⟩ := SetLike.not_le_iff_exists.mp hn
    let B := A ⊓ S
    let E := A ⊓ R
    have hsw := hswap a (hA.1 ha) har
    have hBI : B ≤ Q ⊓ Q' := by
      rintro b ⟨hbA,hbS⟩
      have hb2 : b ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian (A := A) b hbA
      have hfix : (MulAut.conj a).toMonoidHom b = b := by
        change a * b * a⁻¹ = b
        rw [setLike_mul_comm ha hbA,mul_inv_cancel_right]
      rcases hcover b hbS hb2 with hq | hq'
      · exact ⟨hq,hsw.1 ▸ mem_map.mpr ⟨b,hq,hfix⟩⟩
      · exact ⟨hsw.2 ▸ mem_map.mpr ⟨b,hq',hfix⟩,hq'⟩
    have hcount : Nat.card A ≤ 2 * Nat.card E := by
      have hidx : R.relIndex A ≤ 2 := by
        simpa only [hi] using relIndex_le_of_le_right (H := R) hA.1 (by omega : R.relIndex M ≠ 0)
      have hc := count R A
      rw [inf_comm R A] at hc
      dsimp only [E]
      nlinarith
    have hEB : Nat.card E ≤ 2 * Nat.card B := by
      have he : IsElementaryAbelian 2 E := IsElementaryAbelian.of_le inf_le_left
      simpa only [E,B,inf_assoc,inf_eq_right.mpr hSR] using hbound E inf_le_right he
    have hcB := card_le_of_le hBI
    have hcQ := hA.2.2 Q (hQR.1.trans hRM) hQR.2.1
    have hIB : Q ⊓ Q' = B := (eq_of_le_of_card_ge hBI (by nlinarith)).symm
    have hES : E ≤ S := by
      intro e he
      apply hcentralizer
      refine ⟨he.2,?_⟩
      intro b hb
      have hbA : b ∈ A := (show b ∈ B from hIB ▸ hb).1
      exact setLike_mul_comm hbA he.1
    have hEeq : E = B := le_antisymm (le_inf inf_le_left hES) (inf_le_inf_left A hSR)
    rw [hEeq] at hcount
    have hp : 0 < Nat.card (Q ⊓ Q' : Subgroup G) := Nat.card_pos
    nlinarith
  have h₁ := Stellmacher.elementaryAbelianMaxOrder_le_and_j_le_of_eq R M hRM
  have h₂ := Stellmacher.elementaryAbelianMaxOrder_le_and_j_le_of_maxJ_le M R hJ
  have he := le_antisymm h₁.1 h₂.1
  exact le_antisymm (h₂.2 he.symm) (h₁.2 he)
end Stellmacher
namespace Stellmacher
open Subgroup
open scoped Pointwise
variable {G : Type*} [Group G]
theorem involution_in_pair (S Q Q' : Subgroup G)
    [IsElementaryAbelian 2 Q] [IsElementaryAbelian 2 Q']
    (hS : S = Q ⊔ Q') (hN : Q' ≤ normalizer (Q : Set G))
    (hfix : ∀ s ∈ S, s ∉ Q → Q ⊓ centralizer ({s} : Set G) = Q ⊓ Q')
    (b : G) (hb : b ∈ S) (hb2 : b ^ 2 = 1) : b ∈ Q ∨ b ∈ Q' := by
  have hp : b ∈ (Q : Set G) * (Q' : Set G) := by
    rw [←coe_mul_of_right_le_normalizer_left Q Q' hN,←hS]
    exact hb
  obtain ⟨q,hq,t,ht,rfl⟩ := hp
  by_cases htQ : t ∈ Q
  · exact Or.inl (Q.mul_mem hq htQ)
  · have hq2 : q * q = 1 := by
      simpa only [←pow_two] using elemPow_eq_one_of_isElementaryAbelian (A := Q) q hq
    have ht2 : t * t = 1 := by
      simpa only [←pow_two] using elemPow_eq_one_of_isElementaryAbelian (A := Q') t ht
    have hqt : q * t = t * q := by
      have hh : (q*t)⁻¹ = q*t := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hb2)
      simpa only [mul_inv_rev,inv_eq_of_mul_eq_one_right hq2,inv_eq_of_mul_eq_one_right ht2] using hh.symm
    have hqI : q ∈ Q ⊓ Q' := by
      rw [←hfix t (hS ▸ mem_sup_right ht) htQ]
      exact ⟨hq,mem_centralizer_singleton_iff.mpr hqt⟩
    exact Or.inr (Q'.mul_mem hqI.2 ht)
end Stellmacher

