module
public import Mathlib.GroupTheory.Sylow
public import Mathlib.Data.Set.Finite.Lemmas
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Internal conjugators preserving a generated quotient image

Choose a smallest subgroup generated by the original V and one conjugate,
subject to its prescribed image. The image of its conjugator already lies
in that image, so a member of the generated subgroup has the same image.
Replacing the conjugator by that member gives a smaller pair with the same
image; minimality makes the pairs equal. No Sylow-image condition is needed.

Source: the minimal-pair rechoice in Aschbacher–Smith E.2.9, printed p.221.
This form applies also when V* is strictly smaller than a Sylow subgroup,
as in the Suzuki and symplectic source families.
-/

public section
namespace Subgroup
open scoped Pointwise
variable {G D : Type*} [Group G] [Finite G] [Group D]

theorem exists_internal_conjugator_of_generated_image
    (f : G →* D) (V : Subgroup G) (L : Subgroup D)
    (hex : ∃g:G, f g ∈ L ∧ (V ⊔ V.map (MulAut.conj g).toMonoidHom).map f = L) :
    ∃g:G,g ∈ V ⊔ V.map (MulAut.conj g).toMonoidHom ∧
      (V ⊔ V.map (MulAut.conj g).toMonoidHom).map f = L := by
  classical
  let pair (g : G) := V ⊔ V.map (MulAut.conj g).toMonoidHom
  let good : Set G := {g | f g ∈ L ∧ (pair g).map f = L}
  obtain ⟨g,hg,hmin⟩ := Set.exists_min_image good (fun x => Nat.card (pair x))
    (Set.toFinite _) hex
  have hfg : f g ∈ (pair g).map f := hg.2.symm ▸ hg.1
  obtain ⟨x,hx,hfx⟩ := hfg
  have him : (pair x).map f = L := by
    calc
      (pair x).map f = (pair g).map f := by
        dsimp only [pair]
        rw [Subgroup.map_sup,Subgroup.map_sup,map_map,map_map]
        congr 2
        ext a
        simp only [MonoidHom.comp_apply,MulEquiv.coe_toMonoidHom,
          MulAut.conj_apply,map_mul,map_inv,hfx]
      _ = L := hg.2
  have hpair : pair x ≤ pair g := by
    apply sup_le le_sup_left
    rintro y ⟨v,hv,rfl⟩
    exact (pair g).mul_mem ((pair g).mul_mem hx (mem_sup_left hv)) ((pair g).inv_mem hx)
  have he : pair x = pair g := eq_of_le_of_card_ge hpair
    (hmin x ⟨hfx.symm ▸ hg.1,him⟩)
  refine ⟨x,?_,him⟩
  change x ∈ pair x
  rw [he]
  exact hx
end Subgroup
