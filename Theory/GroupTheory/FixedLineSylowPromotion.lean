module

public import Theory.GroupTheory.NormalFourCentralizerSeparation

/-!
# Promoting a Sylow subgroup through its fixed involution

If C_D(S) is the line generated by an involution z, every element normalizing
both S and D fixes z. Thus local Sylow maximality in C_G(z) ∩ N_G(D) promotes
to Sylow maximality in N_G(D). No characteristicity of D in S is needed:
normalizer control is relative to N_G(D).

Source application: Aschbacher–Smith, Lemma 14.4.9, printed p.1010.
-/

namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- The relative normalizer fixes the unique nonidentity fixed vector. -/
public theorem normalizer_inf_le_centralizer_of_fixed_line (D S : Subgroup G) (z : G) (hz : orderOf z = 2)
    (hfix : D ⊓ centralizer (S : Set G) = zpowers z) :
    normalizer (S : Set G) ⊓ normalizer (D : Set G) ≤ centralizer ({z} : Set G) := by
  have hnorm : normalizer (S : Set G) ⊓ normalizer (D : Set G) ≤
      normalizer (D ⊓ centralizer (S : Set G) : Set G) :=
    (le_inf inf_le_right
      (inf_le_left.trans (normalizer_le_normalizer_centralizer S))).trans
      inf_normalizer_le_normalizer_inf
  change normalizer (S : Set G) ⊓ normalizer (D : Set G) ≤
    normalizer ((D ⊓ centralizer (S : Set G) : Subgroup G) : Set G) at hnorm
  rwa [hfix, normalizer_zpowers_eq_centralizer_of_order_two z hz] at hnorm

/-- A local Sylow subgroup with a unique fixed involution is Sylow in the module normalizer. -/
public theorem exists_sylow_normalizer_of_fixed_line (D S : Subgroup G) (z : G) (hz : orderOf z = 2)
    (hp : IsPGroup 2 S) (hSD : S ≤ normalizer (D : Set G))
    (hfix : D ⊓ centralizer (S : Set G) = zpowers z)
    (hlocal : ¬ 2 ∣ S.relIndex (centralizer ({z} : Set G) ⊓ normalizer (D : Set G))) :
    ∃ P : Sylow 2 (normalizer (D : Set G)),
      (P : Subgroup (normalizer (D : Set G))) = S.subgroupOf (normalizer (D : Set G)) := by
  have hn := normalizer_inf_le_centralizer_of_fixed_line D S z hz hfix
  have hi := not_dvd_relIndex_of_normalizer_inf_le S
    (centralizer ({z} : Set G) ⊓ normalizer (D : Set G))
    (normalizer (D : Set G)) hp hSD hlocal (le_inf hn inf_le_right)
  exact ⟨hp.comap_subtype.toSylow hi, rfl⟩
end Subgroup
