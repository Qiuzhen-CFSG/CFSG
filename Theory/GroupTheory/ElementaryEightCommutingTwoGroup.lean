module
public import Theory.GroupTheory.ElementaryEightThreeNormalizer
public import Theory.GroupTheory.PResidual.PrimeOrderGeneration
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Two-groups commuting with a cubic-section action on an elementary eight

A nontrivial action of a two-perfect group with cubic two-core quotient
contains a cubic automorphism: the source group is generated by its elements
of order three. The centralizer of that cubic automorphism on an elementary
eight has odd order. Hence a commuting two-group acts trivially.

This supplies the small-module centralization step in Aschbacher--Smith,
13.3.14(g), printed pp.892--893, with the original seed of order eight.
-/

public section
open Subgroup
open scoped commutatorElement
namespace Theory.GroupTheory
variable {A E : Type*} [Group A] [Finite A] [Group E] [Finite E]
  [IsElementaryAbelian 2 E]

omit [Finite E] [IsElementaryAbelian 2 E] in
/-- Every nontrivial image of a two-perfect cubic-core quotient contains
an element of order three lifted from an element of order three. -/
theorem exists_cubic_image_of_twoPerfect_cubic_section
    (hA : IsPPerfect 2 A) (hquot : Nat.card (A ⧸ pCore 2 A) = 3)
    (f : A →* MulAut E) (hf : f ≠ 1) :
    ∃ a : A, orderOf a = 3 ∧ orderOf (f a) = 3 := by
  have hgen := closure_prime_order_eq_top_of_isPPerfect hA
    (by decide : Nat.Coprime 2 3) hquot
  have hex : ∃ a : A, orderOf a = 3 ∧ f a ≠ 1 := by
    by_contra! hh
    have hk : closure {a : A | orderOf a = 3} ≤ f.ker :=
      (closure_le _).mpr hh
    rw [hgen] at hk
    apply hf
    apply MonoidHom.ext
    intro a
    exact hk (mem_top a)
  obtain ⟨a, ha, hfa⟩ := hex
  refine ⟨a, ha, orderOf_eq_prime ?_ hfa⟩
  rw [← map_pow, ← ha, pow_orderOf_eq_one, map_one]

/-- A two-group of automorphisms commuting with such a nontrivial action
on an elementary eight is trivial. -/
theorem twoSubgroup_eq_bot_of_commuting_cubic_section
    (hE : Nat.card E = 8) (hA : IsPPerfect 2 A)
    (hquot : Nat.card (A ⧸ pCore 2 A) = 3)
    (f : A →* MulAut E) (hf : f ≠ 1)
    (Q : Subgroup (MulAut E)) (hQ : IsPGroup 2 Q)
    (hc : Q ≤ centralizer (f.range : Set (MulAut E))) : Q = ⊥ := by
  obtain ⟨a, _, ha⟩ := exists_cubic_image_of_twoPerfect_cubic_section hA hquot f hf
  let B := zpowers (f a)
  have hB : Nat.card B = 3 := (Nat.card_zpowers (f a)).trans ha
  have hBR : B ≤ f.range := zpowers_le.mpr ⟨a, rfl⟩
  have hQC : Q ≤ centralizer (B : Set (MulAut E)) := hc.trans (centralizer_le hBR)
  have ho := odd_card_centralizer_of_elementary_eight_three hE B hB
  obtain ⟨n, hn⟩ := hQ.exists_card_eq
  have hd : Disjoint Q (centralizer (B : Set (MulAut E))) :=
    disjoint_of_coprime_natCard (by rw [hn]; exact ho.coprime_two_left.pow_left n)
  exact le_bot_iff.mp ((le_inf le_rfl hQC).trans hd.le_bot)

/-- The intrinsic conjugation-action form, retaining the original subgroups.
The commutator premise says the two actions commute on the given eight. -/
theorem centralizes_elementary_eight_of_commuting_cubic_section
    {G : Type*} [Group G] [Finite G]
    (U A Q : Subgroup G) [IsElementaryAbelian 2 U]
    (hU : Nat.card U = 8) (hA : IsPPerfect 2 A)
    (hquot : Nat.card (A ⧸ pCore 2 A) = 3)
    (hAU : A ≤ normalizer (U : Set G))
    (hQU : Q ≤ normalizer (U : Set G)) (hQ : IsPGroup 2 Q)
    (hc : ⁅A,Q⁆ ≤ centralizer (U : Set G)) (hm : ⁅U,A⁆ ≠ ⊥) :
    Q ≤ centralizer (U : Set G) := by
  let f := U.normalizerMonoidHom.comp (inclusion hAU)
  let g := U.normalizerMonoidHom.comp (inclusion hQU)
  have hf : f ≠ 1 := by
    intro hf
    apply hm
    rw [commutator_comm]
    apply commutator_eq_bot_iff_le_centralizer.mpr
    intro a ha
    have he : f ⟨a,ha⟩ = 1 := congrArg (fun k : A →* MulAut U => k ⟨a,ha⟩) hf
    have hk : (inclusion hAU ⟨a,ha⟩) ∈ U.normalizerMonoidHom.ker := he
    rwa [normalizerMonoidHom_ker] at hk
  have hg : g.range ≤ centralizer (f.range : Set (MulAut U)) := by
    rintro _ ⟨q,rfl⟩
    rw [mem_centralizer_iff]
    rintro _ ⟨a,rfl⟩
    apply commutatorElement_eq_one_iff_mul_comm.mp
    have hk : ⁅inclusion hAU a,inclusion hQU q⁆ ∈ U.normalizerMonoidHom.ker := by
      rw [normalizerMonoidHom_ker]
      exact hc (commutator_mem_commutator a.property q.property)
    change ⁅U.normalizerMonoidHom (inclusion hAU a),
      U.normalizerMonoidHom (inclusion hQU q)⁆ = 1
    rw [← map_commutatorElement]
    exact hk
  have hz := twoSubgroup_eq_bot_of_commuting_cubic_section hU hA hquot f hf g.range
    (hQ.of_surjective g.rangeRestrict g.rangeRestrict_surjective) hg
  intro q hq
  have he : g ⟨q,hq⟩ = 1 := mem_bot.mp (hz ▸ (show g ⟨q,hq⟩ ∈ g.range from ⟨_,rfl⟩))
  have hk : (inclusion hQU ⟨q,hq⟩) ∈ U.normalizerMonoidHom.ker := he
  rwa [normalizerMonoidHom_ker] at hk

end Theory.GroupTheory
