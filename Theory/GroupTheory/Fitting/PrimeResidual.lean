module
public import Theory.GroupTheory.Fitting.Core
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.PGroup.CharacteristicKernel

/-!
# Prime cores generating the Fitting residual

The embedded p-residual of the Fitting subgroup is the join of all prime
cores for primes other than p. The complementary prime cores form a normal
subgroup supplemented by the p-core, so the quotient is a p-group. Conversely,
every element in a different prime core has order prime to p and lies in
the p-residual. The equality retains the original Fitting inclusion.

Source application: Aschbacher–Smith, F.6.9 and the odd-prime reduction
in 14.5.11, printed pp.306 and 1015–1016.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G] (p : ℕ) [Fact p.Prime]

/-- The original embedded Fitting residual is generated by the other prime cores. -/
theorem fitting_pResidual_eq_sup_prime_cores :
    (pResidual p (fittingSubgroup G)).map (fittingSubgroup G).subtype =
      ⨆ q : (Nat.card G).primeFactors.attach, ⨆ (_ : q.1.1 ≠ p), pCore q.1.1 G := by
  let F := fittingSubgroup G
  let Q : Subgroup G := ⨆ q : (Nat.card G).primeFactors.attach,
    ⨆ (_ : q.1.1 ≠ p), pCore q.1.1 G
  let : Q.Normal := by dsimp [Q]; infer_instance
  have hQF : Q ≤ F := iSup_le fun q => iSup_le fun _ => pCore_le_fitting G _
  have hPF : pCore p G ≤ F := pCore_le_fitting G p
  have hF : F = pCore p G ⊔ Q := by
    apply le_antisymm ?_ (sup_le hPF hQF)
    dsimp only [F]
    rw [fitting_eq_sup_pCore]
    apply iSup_le
    intro q
    by_cases he : q.1.1 = p
    · rw [he]; exact le_sup_left
    · exact le_sup_of_le_right (le_iSup_of_le q (le_iSup_of_le he le_rfl))
  have hs : (pCore p G).subgroupOf F ⊔ Q.subgroupOf F = ⊤ := by
    rw [←subgroupOf_sup hPF hQF,←hF,subgroupOf_self]
  have hquot : IsPGroup p (F ⧸ Q.subgroupOf F) :=
    quotient_isPGroup_of_sup_eq_top ((pCore p G).subgroupOf F) (Q.subgroupOf F)
      pCore_isPGroup.comap_subtype hs
  refine le_antisymm ?_ ?_
  · have hp : pResidual p F ≤ Q.subgroupOf F := sInf_le ⟨inferInstance,hquot⟩
    exact (map_mono hp).trans_eq (map_subgroupOf_eq_of_le hQF)
  · apply iSup_le
    intro q
    apply iSup_le
    intro hqp x hx
    let a : F := ⟨x,pCore_le_fitting G q.1.1 hx⟩
    have hcop : Nat.Coprime p (Nat.card (pCore q.1.1 G)) := by
      obtain ⟨n,hn⟩ := (pCore_isPGroup (p := q.1.1) (G := G)).exists_card_eq
      rw [hn]
      exact ((Nat.coprime_primes Fact.out Fact.out).mpr hqp.symm).pow_right n
    have ha : a ∈ pResidual p F := mem_pResidual_of_orderOf_coprime
      (hcop.of_dvd_right (by simpa only [a,orderOf_mk] using
        _root_.orderOf_dvd_natCard (⟨x,hx⟩ : pCore q.1.1 G)))
    exact mem_map_of_mem F.subtype ha

end Theory.GroupTheory
