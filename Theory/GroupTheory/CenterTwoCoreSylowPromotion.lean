module
public import Theory.PGroupCore
public import Theory.GroupTheory.CentralizerSylowPromotion
public import Theory.GroupTheory.SubgroupLocalStructureTransport

/-!
# An involution centralizer with a center-two core

Let H be the centralizer of an involution z in a finite group G, and let J
be its two-core. If J contains its centralizer in H and its center has order
two, both the center of J and the center of H have ambient image generated
by z. Every Sylow two-subgroup of H then maps exactly to a Sylow two-subgroup
of G. All images use the given subgroup inclusions, without conjugating the
chosen Sylow subgroup.

The element z is central in H, so its cyclic group is a normal two-subgroup
contained in J. It exhausts the order-two center of J. Consequently the
centralizer of J in H is generated by z, which also identifies the center
of H. Since J lies in every Sylow two-subgroup T of H, the center of the
ambient image of T centralizes J and is again generated by z. The existing
centralizer Sylow-promotion theorem then supplies the exact ambient Sylow.

This source-neutral transfer is the last paragraph of Parrott, "A
Characterization of the Tits' Simple Group", Canadian Journal of Mathematics
24 (1972), Lemma 1, printed p.672. The surrounding recognition hypotheses
are used only by consumers to establish the two assumptions on J.
-/

namespace Subgroup

private theorem centralizer_structure_of_center_two_core_aux
    {G : Type*} [Group G] [Finite G] (z : G) (horder : orderOf z = 2)
    (hcenter : Nat.card (center (pCore 2 (centralizer {z}))) = 2)
    (hself : centralizer (pCore 2 (centralizer {z}) : Set (centralizer {z})) ≤
      pCore 2 (centralizer {z})) :
    let H := centralizer {z}
    let J := pCore 2 H
    (center J).map (H.subtype.comp J.subtype) = zpowers z ∧
      (center H).map H.subtype = zpowers z ∧
      ∀ T : Sylow 2 H,
        (center ((T : Subgroup H).map H.subtype)).map
          ((T : Subgroup H).map H.subtype).subtype = zpowers z ∧
        ∃ S : Sylow 2 G, (S : Subgroup G) = (T : Subgroup H).map H.subtype := by
  let H : Subgroup G := centralizer {z}
  let J : Subgroup H := pCore 2 H
  let zH : H := ⟨z, mem_centralizer_singleton_iff.mpr rfl⟩
  have hzcenter : zH ∈ center H := by
    apply mem_center_iff.mpr
    intro h
    exact Subtype.ext (mem_centralizer_singleton_iff.mp h.property)
  have horderH : orderOf zH = 2 := by
    have hh : orderOf (zH : G) = 2 := horder
    simpa only [Subgroup.orderOf_coe] using hh
  have hcyclicCentral : zpowers zH ≤ center H := zpowers_le.mpr hzcenter
  let : (zpowers zH).Normal := ⟨by
    intro x hx h
    have hcomm := mem_center_iff.mp (hcyclicCentral hx) h
    simpa only [hcomm, mul_assoc, mul_inv_cancel, mul_one] using hx⟩
  have hcyclicTwo : IsPGroup 2 (zpowers zH) := by
    apply IsPGroup.of_card (n := 1)
    rw [Nat.card_zpowers, horderH, pow_one]
  have hcyclicCore : zpowers zH ≤ J := le_sSup ⟨inferInstance, hcyclicTwo⟩
  have hzJ : zH ∈ J := hcyclicCore (mem_zpowers zH)
  have hzZ : zH ∈ (center J).map J.subtype := by
    refine ⟨⟨zH, hzJ⟩, ?_, rfl⟩
    apply mem_center_iff.mpr
    intro j
    exact Subtype.ext (mem_center_iff.mp hzcenter j)
  have hZ : (center J).map J.subtype = zpowers zH := by
    symm
    apply eq_of_le_of_card_ge (zpowers_le.mpr hzZ)
    rw [card_map_of_injective J.subtype_injective, Nat.card_zpowers, horderH]
    exact hcenter.le
  have hC : centralizer (J : Set H) = zpowers zH :=
    (centralizer_eq_mapped_center_of_le J hself).trans hZ
  have hcenterH : center H = zpowers zH :=
    le_antisymm (hC ▸ center_le_centralizer (J : Set H)) hcyclicCentral
  have hmap : (zpowers zH).map H.subtype = zpowers z := MonoidHom.map_zpowers _ _
  refine ⟨?_, ?_, ?_⟩
  · calc
      (center J).map (H.subtype.comp J.subtype) =
          ((center J).map J.subtype).map H.subtype := (map_map _ _ _).symm
      _ = zpowers z := by rw [hZ, hmap]
  · rw [hcenterH, hmap]
  · intro T
    let I : Subgroup G := (T : Subgroup H).map H.subtype
    have hJT : J ≤ T := pCore_isPGroup.le_sylow_of_normal T
    have hzI : z ∈ I := ⟨zH, hJT hzJ, rfl⟩
    have hIcenter : (center I).map I.subtype = zpowers z := by
      apply le_antisymm
      · rintro x ⟨y, hy, rfl⟩
        have hyH : (y : G) ∈ H := map_subtype_le _ y.property
        let yH : H := ⟨y, hyH⟩
        have hyC : yH ∈ centralizer (J : Set H) := by
          intro j hj
          have hjI : (j : G) ∈ I := ⟨j, hJT hj, rfl⟩
          apply Subtype.ext
          exact congrArg (fun t : I => (t : G)) (mem_center_iff.mp hy ⟨j, hjI⟩)
        have hycyclic : yH ∈ zpowers zH := hC ▸ hyC
        rw [← hmap]
        exact mem_map_of_mem H.subtype hycyclic
      · apply zpowers_le.mpr
        refine ⟨⟨z, hzI⟩, ?_, rfl⟩
        apply mem_center_iff.mpr
        intro y
        exact Subtype.ext (mem_centralizer_singleton_iff.mp (map_subtype_le _ y.property))
    exact ⟨hIcenter, exists_ambient_sylow_of_centralizer_center z horder T hIcenter⟩

/-- The centers of the core and centralizer are generated by the original
involution, and each chosen local Sylow promotes without conjugation. -/
public theorem centralizer_structure_of_center_two_core
    {G : Type*} [Group G] [Finite G] (z : G) (horder : orderOf z = 2)
    (hcenter : Nat.card (center (pCore 2 (centralizer {z}))) = 2)
    (hself : centralizer (pCore 2 (centralizer {z}) : Set (centralizer {z})) ≤
      pCore 2 (centralizer {z})) :
    let H := centralizer {z}
    let J := pCore 2 H
    (center J).map (H.subtype.comp J.subtype) = zpowers z ∧
      (center H).map H.subtype = zpowers z ∧
      ∀ T : Sylow 2 H, ∃ S : Sylow 2 G,
        (S : Subgroup G) = (T : Subgroup H).map H.subtype := by
  obtain ⟨hJ, hH, hT⟩ := centralizer_structure_of_center_two_core_aux z horder hcenter hself
  exact ⟨hJ, hH, fun T => (hT T).2⟩

/-- The center of the actual ambient image of any chosen Sylow subgroup of
an involution centralizer is generated by that involution. -/
public theorem mapped_sylow_center_of_center_two_core
    {G : Type*} [Group G] [Finite G] (z : G) (horder : orderOf z = 2)
    (hcenter : Nat.card (center (pCore 2 (centralizer {z}))) = 2)
    (hself : centralizer (pCore 2 (centralizer {z}) : Set (centralizer {z})) ≤
      pCore 2 (centralizer {z}))
    (T : Sylow 2 (centralizer {z})) :
    let I := (T : Subgroup (centralizer {z})).map (centralizer {z}).subtype
    (center I).map I.subtype = zpowers z := by
  exact ((centralizer_structure_of_center_two_core_aux z horder hcenter hself).2.2 T).1

end Subgroup
