module

public import Theory.ElementaryAbelian.BinaryAlternatingPencilRadicals
public import Theory.ElementaryAbelian.VectorSpace
public import Theory.ElementaryAbelian.BinaryAlternatingPencilRanks
public import Theory.ElementaryAbelian.BinaryAlternatingPencilSpan

/-!
# An invariant isotropic subgroup from binary pencil radicals

The canonical subgroup generated by the line radicals is invariant under
all compatible automorphisms. In dimension five, target transitivity forces
the radicals to have order two, and they generate at least eight elements.
Their span therefore supplies the required invariant isotropic subgroup.
The construction and isotropy are proved in `BinaryAlternatingPencilRadicals`,
the radical orders in `BinaryAlternatingPencilRanks`, and the span bound in
`BinaryAlternatingPencilSpan`.

Source: MacWilliams, Trans. AMS 150 (1970), §4; JT 1.4(c), p.386.
-/

open scoped IsMulCommutative

namespace BinaryAlternatingPencil

/-- The canonical radical span supplies an invariant isotropic subgroup once
its two numerical properties have been established. -/
public theorem exists_invariant_isotropic_of_radical_data
    {V W : Type*} [Group V] [CommGroup W]
    (b : V →* (V →* W)) (halt : ∀ x, b x x = 1)
    (hr : ∀ L : Subgroup W, Nat.card L = 2 → Nat.card (radicalOver b L) = 2)
    (hsize : 8 ≤ Nat.card (radicalSpan b)) :
    ∃ U : Subgroup V, 8 ≤ Nat.card U ∧
      (∀ x ∈ U, ∀ y ∈ U, b x y = 1) ∧
      (∀ (a : MulAut V) (c : MulAut W),
        (∀ x y, b (a x) (a y) = c (b x y)) → U.map a.toMonoidHom = U) :=
  ⟨radicalSpan b, hsize, radicalSpan_isotropic b halt hr, radicalSpan_map b⟩

/-- A separating alternating binary pencil in dimension five, transitive on
nonidentity target values, has an isotropic subgroup of order at least eight
invariant under every compatible pair of automorphisms. -/
public theorem exists_invariant_isotropic
    {V W : Type*} [Group V] [Group W] [Finite V] [Finite W]
    [IsElementaryAbelian 2 V] [IsElementaryAbelian 2 W]
    (hV : Nat.card V = 32) (hW : Nat.card W = 4)
    (b : V →* (V →* W)) (halt : ∀ x, b x x = 1)
    (hsep : ∀ x, (∀ y, b x y = 1) → x = 1)
    (htrans : ∀ z₁ z₂ : W, z₁ ≠ 1 → z₂ ≠ 1 →
      ∃ (a : MulAut V) (c : MulAut W), c z₁ = z₂ ∧
        ∀ x y, b (a x) (a y) = c (b x y)) :
    ∃ U : Subgroup V, 8 ≤ Nat.card U ∧
      (∀ x ∈ U, ∀ y ∈ U, b x y = 1) ∧
      (∀ (a : MulAut V) (c : MulAut W),
        (∀ x y, b (a x) (a y) = c (b x y)) → U.map a.toMonoidHom = U) := by
  have hr := radicalOver_card_two hV hW b halt hsep htrans
  exact exists_invariant_isotropic_of_radical_data b halt hr
    (radicalSpan_card_ge_eight hV hW b halt hsep hr)

end BinaryAlternatingPencil
