module

public import Theory.ElementaryAbelian.Basic

/-!
# Abelian normal closures of elementary abelian subgroups

An abelian subgroup generated by elements of exponent dividing `p` has exponent
dividing `p`. Conjugation preserves powers, so an abelian normal closure of an
elementary abelian `p`-subgroup is elementary abelian. Subgroups inherit this
property, without finiteness assumptions.

The proof is induction on subgroup closure, using commutativity only in the
multiplication step. The normal-closure application supplies the conjugates
of the original subgroup as generators.

Source application: Aschbacher–Smith, *The Classification of Quasithin Groups*,
combined manuscript (1 March 2004), §14.5, the paragraph after Hypothesis
14.5.1 and Lemma 14.5.15(2), printed pp.1013 and 1017.
-/

open scoped IsMulCommutative

namespace IsElementaryAbelian

/-- An abelian subgroup generated by elements whose orders divide `p` is elementary abelian. -/
public theorem closure_of_isMulCommutative
    {p : ℕ} {G : Type*} [Group G] (s : Set G)
    [IsMulCommutative (Subgroup.closure s)] (hs : ∀ x ∈ s, x ^ p = 1) :
    IsElementaryAbelian p (Subgroup.closure s) := by
  refine { exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
  rintro ⟨x, hx⟩
  apply Subtype.ext
  change x ^ p = 1
  induction hx using Subgroup.closure_induction with
  | mem y hy => exact hs y hy
  | one => simp
  | mul y z hy hz ihy ihz =>
    have hc : Commute y z :=
      setLike_mul_comm hy hz
    rw [hc.mul_pow, ihy, ihz, one_mul]
  | inv y _ ih => rw [inv_pow, ih, inv_one]

/-- If the normal closure of an elementary abelian subgroup is abelian, it is elementary abelian. -/
public theorem normalClosure_of_isMulCommutative
    {p : ℕ} {G : Type*} [Group G] (V : Subgroup G)
    [IsElementaryAbelian p V] [hc : IsMulCommutative (Subgroup.normalClosure (V : Set G))] :
    IsElementaryAbelian p (Subgroup.normalClosure (V : Set G)) := by
  let : IsMulCommutative (Subgroup.closure (Group.conjugatesOfSet (V : Set G))) := hc
  apply closure_of_isMulCommutative
  intro x hx
  obtain ⟨v, hv, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hx
  obtain ⟨g, rfl⟩ := isConj_iff.mp hconj
  rw [conj_pow, elemPow_eq_one_of_isElementaryAbelian v hv, mul_one, mul_inv_cancel]

/-- Elementary abelianness passes to a smaller subgroup of the same ambient group. -/
public theorem of_le
    {p : ℕ} {G : Type*} [Group G] {A B : Subgroup G}
    [IsElementaryAbelian p B] (hAB : A ≤ B) : IsElementaryAbelian p A := by
  refine {
    toIsMulCommutative := ⟨⟨fun x y => Subtype.ext
      (setLike_mul_comm (hAB x.property) (hAB y.property))⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
  intro x
  exact Subtype.ext (elemPow_eq_one_of_isElementaryAbelian (x : G) (hAB x.property))

end IsElementaryAbelian

