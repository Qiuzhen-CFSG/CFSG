module
public import Theory.ElementaryAbelian.Join
public import Theory.ElementaryAbelian.Quotient
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# A central quotient generated by two elementary binary groups

If two elementary binary subgroups generate a group and their mixed
commutators are central, their images commute in the central quotient.
Their join is therefore elementary abelian and surjects onto that quotient.

Source application: Aschbacher--Smith, F.9.5(6.ii) and 12.6.26,
printed pp.319 and 831.
-/

public section
namespace Subgroup
variable {P : Type*} [Group P]

/-- Central mixed commutators make the central quotient elementary abelian. -/
theorem elementary_central_quotient_of_generating_pair
    (C E : Subgroup P) [IsElementaryAbelian 2 C] [IsElementaryAbelian 2 E]
    (hgen : C ⊔ E = ⊤) (hcomm : ⁅C,E⁆ ≤ center P) :
    IsElementaryAbelian 2 (P ⧸ center P) := by
  let q := QuotientGroup.mk' (center P)
  let A := C.map q
  let B := E.map q
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.map q
  let : IsElementaryAbelian 2 B := IsElementaryAbelian.map q
  have hc : B ≤ centralizer (A : Set (P ⧸ center P)) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    rw [commutator_comm]
    change ⁅C.map q,E.map q⁆ = ⊥
    rw [←map_commutator,map_eq_bot_iff,QuotientGroup.ker_mk']
    exact hcomm
  have he : A ⊔ B = ⊤ := by
    rw [←map_sup,hgen,map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  have hh := IsElementaryAbelian.sup_of_le_centralizer (p := 2) hc
  rw [he] at hh
  let := hh
  exact IsElementaryAbelian.of_surjective (topEquiv (G := P ⧸ center P)).toMonoidHom (topEquiv (G := P ⧸ center P)).surjective

end Subgroup
