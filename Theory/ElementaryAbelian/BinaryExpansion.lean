module
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Tactic
/-!
# Binary expansions in commuting involutions

An element in the subgroup generated by a finite family of commuting
involutions is a product in which each generator occurs zero or one times.
Closure induction combines the binary choices by exclusive-or; inversion
preserves them. No independence of the generators is required.
-/

namespace Theory.GroupTheory

/-- A finite family of commuting involutions spans by binary products. -/
public theorem exists_bool_prod_of_mem_closure_range
    {A ι : Type*} [CommGroup A] [Fintype ι] (g : ι → A)
    (hs : ∀ i, g i * g i = 1) {x : A}
    (hx : x ∈ Subgroup.closure (Set.range g)) :
    ∃ b : ι → Bool, x = ∏ i, if b i then g i else 1 := by
  classical
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i,rfl⟩ := hx
    exact ⟨fun j => decide (j=i), by simp⟩
  | one => exact ⟨fun _ => false, by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨b,rfl⟩ := hx
    obtain ⟨c,rfl⟩ := hy
    refine ⟨fun i => Bool.xor (b i) (c i), ?_⟩
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro i _
    cases hb : b i <;> cases hc : c i <;> simp [hb, hc, hs]
  | inv x _ hx =>
    obtain ⟨b,rfl⟩ := hx
    refine ⟨b, ?_⟩
    rw [← Finset.prod_inv_distrib]
    apply Finset.prod_congr rfl
    intro i _
    cases b i <;> simp [inv_eq_of_mul_eq_one_right (hs i)]
end Theory.GroupTheory
