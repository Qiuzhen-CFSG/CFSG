module
public import Theory.LinearAlgebra.AdjacentSubspaceClique
public import Theory.ElementaryAbelian.VectorSpace
public import Mathlib.FieldTheory.Finiteness
public import Mathlib.GroupTheory.Index

/-!
# Cliques of adjacent elementary abelian subgroups

A family of equally large elementary abelian 2-subgroups with pairwise
intersection index at most two has either a common index-two intersection
or a span generated by any two distinct members. Transport to binary
subspaces and apply the Grassmann-clique dimension argument.

This is used by the binary orbit argument of Meierfrankenfeld--Stellmacher,
*Pushing up weak BN-pairs of rank two* (1993), (1.6), pp.845--847.
-/

public section
open scoped IsMulCommutative
namespace Subgroup
variable {E : Type*} [Group E] [Finite E] [IsElementaryAbelian 2 E]

private noncomputable def binarySubspaces : Subgroup E ≃o Submodule (ZMod 2) (Additive E) :=
  Subgroup.toAddSubgroup.trans (AddSubgroup.toZModSubmodule (n:=2))

private theorem binary_card (W : Subgroup E) :
    Nat.card W = 2 ^ Module.finrank (ZMod 2) (binarySubspaces W) := by
  let e : W ≃ (binarySubspaces W) := {
    toFun := fun x => ⟨Additive.ofMul x,x.property⟩
    invFun := fun x => ⟨Additive.toMul x,x.property⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }
  exact (Nat.card_congr e).trans (by
    simpa only [Nat.card_zmod] using
      Module.natCard_eq_pow_finrank (K:=ZMod 2) (V:=binarySubspaces W))

omit [Finite E] [IsElementaryAbelian 2 E] in
private theorem index_mul_intersection_card (A B : Subgroup E) :
    Nat.card (A⊓B : Subgroup E) * A.relIndex B = Nat.card B := by
  simpa only [relIndex_bot_left,inf_relIndex_right] using
    relIndex_mul_relIndex (⊥ : Subgroup E) (A⊓B) B bot_le inf_le_right

private theorem binary_adjacent_rank (A B : Subgroup E) (h : A.relIndex B≤2) :
    Module.finrank (ZMod 2) (binarySubspaces B) ≤
      Module.finrank (ZMod 2) ↥(binarySubspaces A⊓binarySubspaces B)+1 := by
  have hc := index_mul_intersection_card A B
  have hle : Nat.card B≤Nat.card (A⊓B : Subgroup E)*2 := by
    rw [← hc]
    exact Nat.mul_le_mul_left _ h
  rw [binary_card,binary_card,← pow_succ] at hle
  rw [← binarySubspaces.map_inf]
  exact (Nat.pow_le_pow_iff_right (by decide : 1<2)).mp hle

 theorem binary_clique_core_or_span {ι : Type*} (W : ι → Subgroup E)
    (i j : ι) (hne : W i≠W j)
    (hc : ∀ k, Nat.card (W k)=Nat.card (W i))
    (ha : ∀ k l, (W k).relIndex (W l)≤2) :
    (⨅ k,W k).relIndex (W i)=2 ∨
      (⨆ k,W k : Subgroup E)=W i⊔W j := by
  let φ : Subgroup E ≃o Submodule (ZMod 2) (Additive E) := binarySubspaces
  let n := Module.finrank (ZMod 2) (φ (W i))
  have hr (k : ι) : Module.finrank (ZMod 2) (φ (W k))=n := by
    apply Nat.pow_right_injective (by decide : 2≤2)
    change 2^Module.finrank (ZMod 2) (binarySubspaces (W k)) =
      2^Module.finrank (ZMod 2) (binarySubspaces (W i))
    rw [← binary_card,← binary_card]
    exact hc k
  have hpair (k l : ι) : n≤Module.finrank (ZMod 2) ↥(φ (W k)⊓φ (W l))+1 := by
    rw [← hr l]
    exact binary_adjacent_rank (W k) (W l) (ha k l)
  rcases Submodule.clique_star_or_top (fun k => φ (W k)) n hr hpair i j
    (fun hh => hne (φ.injective hh)) with hs | ht
  · left
    let C : Subgroup E := ⨅ k,W k
    have hC : C≤W i := iInf_le W i
    have heC : C=W i⊓W j := by
      apply le_antisymm (le_inf (iInf_le W i) (iInf_le W j))
      apply le_iInf
      intro l
      apply φ.le_iff_le.mp
      simpa only [φ.map_inf] using hs l
    have hdim := Submodule.rank_intersection_of_adjacent (hr i) (hr j) (hpair i j)
      (fun hh => hne (φ.injective hh))
    have hrank : Module.finrank (ZMod 2) (φ C)+1=n := by
      rw [heC,φ.map_inf]
      exact hdim
    have hcard : Nat.card (W i)=Nat.card C*2 := by
      rw [binary_card,binary_card]
      change 2^n=2^Module.finrank (ZMod 2) (φ C)*2
      rw [← hrank,pow_succ]
    have hi := index_mul_intersection_card C (W i)
    rw [inf_eq_left.mpr hC,hcard] at hi
    exact Nat.eq_of_mul_eq_mul_left Nat.card_pos hi
  · right
    apply le_antisymm
    · apply iSup_le
      intro l
      apply φ.le_iff_le.mp
      simpa only [φ.map_sup] using ht l
    · exact sup_le (le_iSup W i) (le_iSup W j)

end Subgroup
