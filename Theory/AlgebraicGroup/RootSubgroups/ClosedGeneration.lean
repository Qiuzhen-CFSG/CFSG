module

public import Theory.AlgebraicGroup.RootSubgroups.FixedTorusConnectedGeneration
public import Theory.AlgebraicGroup.RootSubgroups.TorusGeneratedNormalizer

/-!
# Closed connected subgroups generated by realized roots

Finite-word generation by connected closed subgroups makes a selected family
of realized root groups, with or without its torus, closed and connected.
Torus normalization identifies the latter subgroup with the pointwise product
`T * U` and makes `U` normal inside that subgroup. These constructions do not
assert solvability or Borel maximality.

This is the subgroup-construction step of GLS3, Theorem 1.11.2
(`refs/KGroup/GLS3/Chapter1.tex`), used by the concrete F4 Borel candidates.
-/

@[expose] public noncomputable section

namespace Theory.AlgebraicGroup.RootGroupData
open scoped Pointwise
universe u
variable {k : Type u} [Field k] [IsAlgClosed k]
  {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
  (D : RootGroupData G T) (hD : D.IsRealization)

omit [IsAlgClosed k] in
private theorem subgroup_connected (S : ClosedSubgroup G)
    (hS : Variety.IsConnected S.carrierVariety) :
    _root_.IsConnected (S : Set (Variety.Point G)) := by
  let : ConnectedSpace (Variety.Point S.carrierVariety) :=
    connectedSpace_iff_univ.mpr hS
  change _root_.IsConnected (S.toSubgroup : Set (Variety.Point G))
  rw [← S.range_inclusion]
  exact isConnected_range S.inclusion.toVariety.continuous

include hD in
/-- Root-generated subgroups are closed, without any sign restriction. -/
theorem generated_isZariskiClosed (A : Set D.Root) :
    IsZariskiClosed G (RootSubgroupGenerated D A : Set (Variety.Point G)) := by
  have h := closure_iUnion_connected_closedSubgroup_isZariskiClosed
    (fun a : A => D.rootSubgroup a.1)
    (fun a => subgroup_connected _ (hD.2.2.1 a.1).1.2.isConnected)
  rw [Set.iUnion_subtype] at h
  exact h

/-- The closed subgroup with exactly the abstract root-generated point group. -/
def generatedClosedSubgroup (A : Set D.Root) : ClosedSubgroup G :=
  ClosedSubgroup.ofSubgroup (RootSubgroupGenerated D A) (D.generated_isZariskiClosed hD A)

@[simp] theorem generatedClosedSubgroup_toSubgroup (A : Set D.Root) :
    (D.generatedClosedSubgroup hD A).toSubgroup = RootSubgroupGenerated D A := rfl

/-- Connected root groups generate a connected subgroup. -/
theorem generatedClosedSubgroup_connected (A : Set D.Root) :
    _root_.IsConnected (D.generatedClosedSubgroup hD A : Set (Variety.Point G)) := by
  have h := closure_iUnion_connected_closedSubgroup_isConnected
    (fun a : A => D.rootSubgroup a.1)
    (fun a => subgroup_connected _ (hD.2.2.1 a.1).1.2.isConnected)
  rw [Set.iUnion_subtype] at h
  exact h

variable (hT : IsSubtorus T)

private def torusRootFamily (A : Set D.Root) : Option A → ClosedSubgroup G
  | none => T
  | some a => D.rootSubgroup a.1

include hD hT in
private theorem torusRootFamily_connected (A : Set D.Root) (a : Option A) :
    _root_.IsConnected (torusRootFamily D A a : Set (Variety.Point G)) := by
  cases a with
  | none => exact subgroup_connected T hT.isConnected
  | some a => exact subgroup_connected _ (hD.2.2.1 a.1).1.2.isConnected

omit [IsAlgClosed k] in
private theorem torusRootFamily_generated (A : Set D.Root) :
    Subgroup.closure (⋃ a, (torusRootFamily D A a : Set (Variety.Point G))) =
      T.toSubgroup ⊔ RootSubgroupGenerated D A := by
  have hu : (⋃ a, (torusRootFamily D A a : Set (Variety.Point G))) =
      (T : Set (Variety.Point G)) ∪
        ⋃ a ∈ A, (D.rootSubgroup a : Set (Variety.Point G)) := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_union]
    constructor
    · rintro ⟨a, ha⟩
      cases a with
      | none => exact Or.inl ha
      | some a => exact Or.inr ⟨a.1, a.2, ha⟩
    · rintro (hx | ⟨a, ha, hx⟩)
      · exact ⟨none, hx⟩
      · exact ⟨some ⟨a, ha⟩, hx⟩
  rw [hu, Subgroup.closure_union]
  rw [show Subgroup.closure (T : Set (Variety.Point G)) = T.toSubgroup from
    Subgroup.closure_eq _]
  rfl

include hD hT in
/-- Adjoining the realizing torus preserves closedness. -/
theorem torusGenerated_isZariskiClosed (A : Set D.Root) :
    IsZariskiClosed G
      ((T.toSubgroup ⊔ RootSubgroupGenerated D A : Subgroup (Variety.Point G)) :
        Set (Variety.Point G)) := by
  rw [← torusRootFamily_generated]
  exact closure_iUnion_connected_closedSubgroup_isZariskiClosed
    (torusRootFamily D A) (torusRootFamily_connected D hD hT A)

/-- The closed subgroup generated by the torus and selected root groups. -/
def torusGeneratedClosedSubgroup (A : Set D.Root) : ClosedSubgroup G :=
  ClosedSubgroup.ofSubgroup (T.toSubgroup ⊔ RootSubgroupGenerated D A)
    (D.torusGenerated_isZariskiClosed hD hT A)

@[simp] theorem torusGeneratedClosedSubgroup_toSubgroup (A : Set D.Root) :
    (D.torusGeneratedClosedSubgroup hD hT A).toSubgroup =
      T.toSubgroup ⊔ (D.generatedClosedSubgroup hD A).toSubgroup := rfl

/-- Adjoining the realizing torus also preserves connectedness. -/
theorem torusGeneratedClosedSubgroup_connected (A : Set D.Root) :
    _root_.IsConnected (D.torusGeneratedClosedSubgroup hD hT A : Set (Variety.Point G)) :=
  isConnected_sup_rootSubgroupGenerated T (subgroup_connected T hT.isConnected) D hD A

/-- The generated subgroup is the actual pointwise product, not just its closure. -/
theorem torusGeneratedClosedSubgroup_eq_mul (A : Set D.Root) :
    (D.torusGeneratedClosedSubgroup hD hT A : Set (Variety.Point G)) =
      (T : Set (Variety.Point G)) *
        (D.generatedClosedSubgroup hD A : Set (Variety.Point G)) :=
  Subgroup.coe_mul_of_left_le_normalizer_right _ _
    (torus_le_rootSubgroupGenerated_normalizer D hD A)

/-- Exact torus/root factorization, prior to Borel certification. -/
theorem mem_torusGeneratedClosedSubgroup_iff (A : Set D.Root) (x : Variety.Point G) :
    x ∈ D.torusGeneratedClosedSubgroup hD hT A ↔ ∃ t u,
      t ∈ T ∧ u ∈ RootSubgroupGenerated D A ∧ x = t * u := by
  change x ∈ (D.torusGeneratedClosedSubgroup hD hT A : Set (Variety.Point G)) ↔ _
  rw [D.torusGeneratedClosedSubgroup_eq_mul hD hT]
  constructor
  · rintro ⟨t, ht, u, hu, htu⟩
    exact ⟨t, u, ht, hu, htu.symm⟩
  · rintro ⟨t, u, ht, hu, rfl⟩
    exact Set.mul_mem_mul ht hu

/-- Normality is relative to the torus/root subgroup. -/
theorem generatedClosedSubgroup_normal_in_torusGenerated (A : Set D.Root) :
    ((D.generatedClosedSubgroup hD A).toSubgroup.subgroupOf
      (D.torusGeneratedClosedSubgroup hD hT A).toSubgroup).Normal := by
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_right).mpr
  exact sup_le (torus_le_rootSubgroupGenerated_normalizer D hD A) Subgroup.le_normalizer

end Theory.AlgebraicGroup.RootGroupData
