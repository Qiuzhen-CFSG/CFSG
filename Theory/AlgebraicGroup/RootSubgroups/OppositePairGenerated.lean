module

public import Theory.AlgebraicGroup.ClosedSubgroup.Closure
public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.RootSubgroups.Defs

/-!
# The closed subgroup generated by an opposite pair

Two one-parameter closed subgroups generate a Zariski-closed abstract subgroup:
each curve is connected, so finite connected-subgroup generation applies.  We
package the subgroup canonically as the Zariski closure of their supremum and
prove that the closure adds no points.

This is the closure-theoretic first step in the local opposite-root rank-one
analysis underlying GLS3, Theorem 1.9.5(d).  It uses neither an opposite-root
classification nor any conclusion of that theorem; later rank-one geometry can
therefore use this subgroup as the target of its `SL2` central isogeny.
-/

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- The canonical closed subgroup obtained from two closed subgroups by taking
the Zariski closure of their abstract supremum. -/
public noncomputable def oppositePairGeneratedSubgroup
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K) : ClosedSubgroup K :=
  subgroupZariskiClosure K (Xplus.toSubgroup ⊔ Xminus.toSubgroup)

omit [IsAlgClosed k] in
/-- Each abstract generator lies in the canonical closed generated subgroup. -/
public theorem sup_le_oppositePairGeneratedSubgroup
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K) :
    Xplus.toSubgroup ⊔ Xminus.toSubgroup ≤
      (oppositePairGeneratedSubgroup Xplus Xminus).toSubgroup := by
  intro g hg
  unfold oppositePairGeneratedSubgroup subgroupZariskiClosure
  change g ∈ closure
    ((Xplus.toSubgroup ⊔ Xminus.toSubgroup : Subgroup (Variety.Point K)) :
      Set (Variety.Point K))
  exact subset_closure hg

private lemma oneParameterClosedSubgroup_isConnected
    {K : Variety k} [AlgebraicGroup K] (X : ClosedSubgroup K)
    (hX : IsOneParameterGroup X.carrierVariety) :
    _root_.IsConnected (X : Set (Variety.Point K)) := by
  let : ConnectedSpace (Variety.Point X.carrierVariety) :=
    connectedSpace_iff_univ.mpr hX.isConnected
  change _root_.IsConnected (X.toSubgroup : Set (Variety.Point K))
  rw [← X.range_inclusion]
  exact isConnected_range X.inclusion.toVariety.continuous

/-- For one-parameter factors, the canonical closure is exactly the abstract
subgroup generated by the two factors. -/
public theorem oppositePairGeneratedSubgroup_toSubgroup
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K)
    (hplus : IsOneParameterGroup Xplus.carrierVariety)
    (hminus : IsOneParameterGroup Xminus.carrierVariety) :
    (oppositePairGeneratedSubgroup Xplus Xminus).toSubgroup =
      Xplus.toSubgroup ⊔ Xminus.toSubgroup := by
  let H : Bool → ClosedSubgroup K := fun b => match b with
    | false => Xplus
    | true => Xminus
  have hHconnected : ∀ b, _root_.IsConnected (H b : Set (Variety.Point K)) := by
    intro b
    cases b <;> simp only [H]
    · exact oneParameterClosedSubgroup_isConnected Xplus hplus
    · exact oneParameterClosedSubgroup_isConnected Xminus hminus
  have hclosedUnion :=
    closure_iUnion_connected_closedSubgroup_isZariskiClosed H hHconnected
  have hgenerated :
      Subgroup.closure (⋃ b, (H b : Set (Variety.Point K))) =
        Xplus.toSubgroup ⊔ Xminus.toSubgroup := by
    apply le_antisymm
    · rw [Subgroup.closure_le]
      intro x hx
      simp only [Set.mem_iUnion] at hx
      obtain ⟨b, hb⟩ := hx
      cases b
      · exact Subgroup.mem_sup_left hb
      · exact Subgroup.mem_sup_right hb
    · apply sup_le
      · intro x hx
        apply Subgroup.subset_closure
        exact Set.mem_iUnion.mpr ⟨false, hx⟩
      · intro x hx
        apply Subgroup.subset_closure
        exact Set.mem_iUnion.mpr ⟨true, hx⟩
  rw [hgenerated] at hclosedUnion
  apply SetLike.coe_injective
  change closure
      ((Xplus.toSubgroup ⊔ Xminus.toSubgroup : Subgroup (Variety.Point K)) :
        Set (Variety.Point K)) = _
  exact (Variety.isClosed_iff_isZariskiClosed.mpr hclosedUnion).closure_eq

end Theory.AlgebraicGroup
