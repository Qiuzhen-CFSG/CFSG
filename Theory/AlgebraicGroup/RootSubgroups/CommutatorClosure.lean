module

public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup

universe u

/-!
Collection infrastructure for the positive-root commutator arguments in GLS3
§1.12.  The point of this file is to isolate the closure step: once the
commutator of each pair of root factors is known to lie in a normal subgroup,
the same is true for the subgroups generated by those factors.
-/

namespace Theory.AlgebraicGroup

open scoped commutatorElement

section

variable {k : Type u} [Field k]

private lemma map_rootFactor_mem_centralizer_generated
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A B : Set D.Root)
    (N : Subgroup (Variety.Point K)) [N.Normal]
    (hpair : ∀ α ∈ A, ∀ β ∈ B, ∀ x, x ∈ D.rootSubgroup α →
      ∀ y, y ∈ D.rootSubgroup β → ⁅x, y⁆ ∈ N)
    {α : D.Root} (hα : α ∈ A) {x : Variety.Point K}
    (hx : x ∈ D.rootSubgroup α) :
    QuotientGroup.mk' N x ∈
      Subgroup.centralizer
        (Subgroup.map (QuotientGroup.mk' N)
          (RootSubgroupGenerated D B) : Set (Variety.Point K ⧸ N)) := by
  rw [Subgroup.mem_centralizer_iff]
  intro qy hqy
  obtain ⟨y, hy, hqy⟩ := Subgroup.mem_map.mp hqy
  subst qy
  change y ∈ Subgroup.closure
    (⋃ β ∈ B, (D.rootSubgroup β : Set (Variety.Point K))) at hy
  -- The closure is generated by the root factors indexed by `B`.
  have hcommute : Commute (QuotientGroup.mk' N x) (QuotientGroup.mk' N y) := by
    apply Subgroup.closure_induction (p := fun z _ =>
      Commute (QuotientGroup.mk' N x) (QuotientGroup.mk' N z)) ?_ ?_ ?_ ?_ hy
    · intro z hz
      simp only [Set.mem_iUnion] at hz
      obtain ⟨β, hβ, hz⟩ := hz
      have hcomm := hpair α hα β hβ x hx z hz
      have hcomm' : ⁅QuotientGroup.mk' N x, QuotientGroup.mk' N z⁆ = 1 := by
        rw [← map_commutatorElement]
        exact (QuotientGroup.eq_one_iff _).mpr hcomm
      exact commutatorElement_eq_one_iff_commute.mp hcomm'
    · exact Commute.one_right _
    · intro z w hz hw hzw hww
      exact hzw.mul_right hww
    · intro z hz hcomm
      exact hcomm.inv_right
  exact hcommute.eq.symm

private lemma generated_mem_centralizer_generated
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A B : Set D.Root)
    (N : Subgroup (Variety.Point K)) [N.Normal]
    (hpair : ∀ α ∈ A, ∀ β ∈ B, ∀ x, x ∈ D.rootSubgroup α →
      ∀ y, y ∈ D.rootSubgroup β → ⁅x, y⁆ ∈ N) :
    Subgroup.map (QuotientGroup.mk' N) (RootSubgroupGenerated D A) ≤
      Subgroup.centralizer
        (Subgroup.map (QuotientGroup.mk' N)
          (RootSubgroupGenerated D B) : Set (Variety.Point K ⧸ N)) := by
  rw [Subgroup.map_le_iff_le_comap]
  rw [RootSubgroupGenerated_le_iff]
  intro α hα x hx
  exact map_rootFactor_mem_centralizer_generated D A B N hpair hα hx

/--
The closure form of the root-commutator argument.  This is the reusable core
behind the ideal/normal-subgroup clauses of GLS3 Theorem 1.12.7: pairwise root
commutators in a normal subgroup imply the commutator of the generated root
subgroups lies in that subgroup.
-/
public lemma rootSubgroupGenerated_commutator_le_of_rootFactor_commutators
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A B : Set D.Root)
    (N : Subgroup (Variety.Point K)) [N.Normal]
    (hpair : ∀ α ∈ A, ∀ β ∈ B, ∀ x, x ∈ D.rootSubgroup α →
      ∀ y, y ∈ D.rootSubgroup β → ⁅x, y⁆ ∈ N) :
    ⁅RootSubgroupGenerated D A, RootSubgroupGenerated D B⁆ ≤ N := by
  rw [Subgroup.commutator_le]
  intro x hx y hy
  have hcx := generated_mem_centralizer_generated D A B N hpair
  have hx' : QuotientGroup.mk' N x ∈
      Subgroup.centralizer
        (Subgroup.map (QuotientGroup.mk' N)
          (RootSubgroupGenerated D B) : Set (Variety.Point K ⧸ N)) :=
    hcx (by exact ⟨x, hx, rfl⟩)
  have hy' : QuotientGroup.mk' N y ∈
      Subgroup.map (QuotientGroup.mk' N) (RootSubgroupGenerated D B) :=
    ⟨y, hy, rfl⟩
  have hcomm : ⁅QuotientGroup.mk' N x, QuotientGroup.mk' N y⁆ = 1 := by
    apply commutatorElement_eq_one_iff_commute.mpr
    exact (Subgroup.mem_centralizer_iff.mp hx' _ hy').symm
  apply (QuotientGroup.eq_one_iff _).mp
  change QuotientGroup.mk' N ⁅x, y⁆ = 1
  rw [map_commutatorElement]
  exact hcomm

/-- Pairwise root-factor commutators in a normal generated subgroup imply that
the first generated subgroup normalizes the second one. -/
public lemma rootSubgroupGenerated_le_normalizer_of_rootFactor_commutators
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A B : Set D.Root)
    (hN : (RootSubgroupGenerated D B).Normal)
    (hpair : ∀ α ∈ A, ∀ β ∈ B, ∀ x, x ∈ D.rootSubgroup α →
      ∀ y, y ∈ D.rootSubgroup β → ⁅x, y⁆ ∈ RootSubgroupGenerated D B) :
    RootSubgroupGenerated D A ≤
      Subgroup.normalizer (RootSubgroupGenerated D B : Set (Variety.Point K)) := by
  let := hN
  rw [Subgroup.le_normalizer_iff_commutator_le_right]
  exact rootSubgroupGenerated_commutator_le_of_rootFactor_commutators D A B
    (RootSubgroupGenerated D B) hpair

end

end Theory.AlgebraicGroup
