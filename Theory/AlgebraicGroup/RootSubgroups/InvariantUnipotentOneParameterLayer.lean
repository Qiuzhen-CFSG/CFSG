module

public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup

universe u

namespace Theory.AlgebraicGroup

section

variable {k : Type u} [Field k] [IsAlgClosed k]

/-!
This module records the exact one-parameter-layer input used by the
invariant-unipotent root-generation argument.  The source application only
needs a witness outside the subgroup generated by the root subgroups already
contained in `X`; it does not require an escape witness for every proper
abstract subgroup of `X.toSubgroup` (which may be non-closed and hence need not
be detected by a closed-subgroup construction).  The predicate below makes
that canonical, conditional contract explicit, and `exists_layer` is the
small eliminator consumed by the generation theorem.
-/

/-- A canonical one-parameter layer exists whenever the root subgroups already
contained in `X` generate a proper subgroup. -/
public def HasInvariantOneParameterLayerOutsideGeneratedRoots
    {K : Variety k} [AlgebraicGroup K]
    (T X : ClosedSubgroup K) (D : RootGroupData K T) : Prop :=
  RootSubgroupGenerated D
      {α | (D.rootSubgroup α).toSubgroup ≤ X.toSubgroup} < X.toSubgroup →
    ∃ Y : ClosedSubgroup K,
      IsClosedSubgroupInvariant T Y ∧
      IsOneParameterGroup Y.carrierVariety ∧
      Y.toSubgroup ≤ X.toSubgroup ∧
      ¬ Y.toSubgroup ≤
        RootSubgroupGenerated D
          {α | (D.rootSubgroup α).toSubgroup ≤ X.toSubgroup}

omit [IsAlgClosed k] in
/-- Extract the layer from the canonical properness premise. -/
public theorem HasInvariantOneParameterLayerOutsideGeneratedRoots.exists_layer
    {K : Variety k} [AlgebraicGroup K]
    (T X : ClosedSubgroup K) (D : RootGroupData K T)
    (hLayer : HasInvariantOneParameterLayerOutsideGeneratedRoots T X D)
    (hproper : RootSubgroupGenerated D
      {α | (D.rootSubgroup α).toSubgroup ≤ X.toSubgroup} < X.toSubgroup) :
    ∃ Y : ClosedSubgroup K,
      IsClosedSubgroupInvariant T Y ∧
      IsOneParameterGroup Y.carrierVariety ∧
      Y.toSubgroup ≤ X.toSubgroup ∧
      ¬ Y.toSubgroup ≤
        RootSubgroupGenerated D
          {α | (D.rootSubgroup α).toSubgroup ≤ X.toSubgroup} := by
  exact hLayer hproper

end

end Theory.AlgebraicGroup
