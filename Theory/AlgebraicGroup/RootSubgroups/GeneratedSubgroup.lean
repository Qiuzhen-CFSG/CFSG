module

public import Theory.AlgebraicGroup.RootSubgroups.Defs

universe u v

/-! Elementary properties of subgroups generated by root subgroups. -/

namespace Theory.AlgebraicGroup

section

variable {k : Type u} [Field k]

public lemma RootSubgroupGenerated_empty
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) :
    RootSubgroupGenerated D (∅ : Set D.Root) = ⊥ := by
  rw [RootSubgroupGenerated]
  simp

/-- Generating from a union of root sets is the supremum of the generated
subgroups for the individual root sets. -/
public lemma RootSubgroupGenerated_iUnion
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) {ι : Sort v} (s : ι → Set D.Root) :
    RootSubgroupGenerated D (⋃ i, s i) = ⨆ i, RootSubgroupGenerated D (s i) := by
  change Subgroup.closure (⋃ α ∈ ⋃ i, s i,
      (D.rootSubgroup α : Set (Variety.Point K))) =
    ⨆ i, Subgroup.closure (⋃ α ∈ s i,
      (D.rootSubgroup α : Set (Variety.Point K)))
  rw [show (⋃ α ∈ ⋃ i, s i,
      (D.rootSubgroup α : Set (Variety.Point K))) =
      ⋃ i, ⋃ α ∈ s i, (D.rootSubgroup α : Set (Variety.Point K)) by
    ext x
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨α, ⟨i, hα⟩, hx⟩
      exact ⟨i, α, hα, hx⟩
    · rintro ⟨i, α, hα, hx⟩
      exact ⟨α, ⟨i, hα⟩, hx⟩]
  exact Subgroup.closure_iUnion _

public lemma RootSubgroupGenerated_le_iff
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root)
    (H : Subgroup (Variety.Point K)) :
    RootSubgroupGenerated D A ≤ H ↔
      ∀ α ∈ A, (D.rootSubgroup α).toSubgroup ≤ H := by
  change Subgroup.closure
      (⋃ α ∈ A, (D.rootSubgroup α : Set (Variety.Point K))) ≤ H ↔ _
  rw [Subgroup.closure_le]
  simp only [Set.iUnion_subset_iff]
  constructor <;> intro h α hα x hx
  · exact h α hα hx
  · exact h α hα hx

/-- The subgroup generated by root subgroups contained in a subgroup is itself
contained in that subgroup. -/
public lemma RootSubgroupGenerated_le_of_rootSubgroup_le
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root)
    (X : Subgroup (Variety.Point K))
    (hX : ∀ α ∈ A, (D.rootSubgroup α).toSubgroup ≤ X) :
    RootSubgroupGenerated D A ≤ X := by
  exact (RootSubgroupGenerated_le_iff D A X).2 hX

/-- Enlarging the set of roots enlarges the subgroup generated by their root
subgroups. -/
public lemma RootSubgroupGenerated_mono
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) {A B : Set D.Root} (hAB : A ⊆ B) :
    RootSubgroupGenerated D A ≤ RootSubgroupGenerated D B := by
  apply Subgroup.closure_mono
  intro x hx
  simp only [Set.mem_iUnion] at hx ⊢
  obtain ⟨α, hαA, hxα⟩ := hx
  exact ⟨α, hAB hαA, hxα⟩

public lemma rootSubgroup_le_RootSubgroupGenerated
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) {A : Set D.Root} {α : D.Root} (hα : α ∈ A) :
    (D.rootSubgroup α).toSubgroup ≤ RootSubgroupGenerated D A := by
  intro x hx
  apply Subgroup.subset_closure
  simp only [Set.mem_iUnion]
  exact ⟨α, hα, hx⟩

/-- The root set cut out by containment in a closed subgroup has generated
subgroup contained in that subgroup. -/
public lemma exists_rootSet_with_generated_le
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (X : ClosedSubgroup K) :
    ∃ A : Set D.Root,
      (∀ α, α ∈ A ↔ (D.rootSubgroup α).toSubgroup ≤ X.toSubgroup) ∧
      RootSubgroupGenerated D A ≤ X.toSubgroup := by
  let A : Set D.Root :=
    {α | (D.rootSubgroup α).toSubgroup ≤ X.toSubgroup}
  refine ⟨A, fun _ => Iff.rfl, ?_⟩
  exact RootSubgroupGenerated_le_of_rootSubgroup_le D A X.toSubgroup fun _ hα => hα

/-- A singleton root set generates exactly its root subgroup. -/
public lemma RootSubgroupGenerated_singleton
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (α : D.Root) :
    RootSubgroupGenerated D {α} = (D.rootSubgroup α).toSubgroup := by
  apply le_antisymm
  · apply RootSubgroupGenerated_le_of_rootSubgroup_le
    intro β hβ
    simp only [Set.mem_singleton_iff] at hβ
    subst β
    exact le_rfl
  · exact rootSubgroup_le_RootSubgroupGenerated D (by simp)

/-- Generating from a union of root sets is the supremum of the separately
generated root subgroups. -/
public lemma RootSubgroupGenerated_union
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A B : Set D.Root) :
    RootSubgroupGenerated D (A ∪ B) =
      RootSubgroupGenerated D A ⊔ RootSubgroupGenerated D B := by
  apply le_antisymm
  · rw [RootSubgroupGenerated, Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_iUnion] at hx
    obtain ⟨α, hα, hxα⟩ := hx
    rcases hα with hαA | hαB
    · exact Subgroup.mem_sup_left
        (rootSubgroup_le_RootSubgroupGenerated D hαA hxα)
    · exact Subgroup.mem_sup_right
        (rootSubgroup_le_RootSubgroupGenerated D hαB hxα)
  · exact sup_le
      (RootSubgroupGenerated_mono D Set.subset_union_left)
      (RootSubgroupGenerated_mono D Set.subset_union_right)

end

end Theory.AlgebraicGroup
