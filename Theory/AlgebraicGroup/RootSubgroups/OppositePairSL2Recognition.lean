module

public import Theory.AlgebraicGroup.Instance.PSL
public import Theory.AlgebraicGroup.Morphism.CodRestrict
public import Theory.AlgebraicGroup.Morphism.Isogeny
public import Theory.AlgebraicGroup.RootSubgroups.OppositePairGenerated
public import Theory.AlgebraicGroup.RootSubgroups.SL2RootCurves
public import Mathlib.LinearAlgebra.Projectivization.PSL.PSL2

/-!
# Formal recognition of an opposite-pair SL2 morphism

This module isolates the group-theoretic part of rank-one recognition.  Given
a morphism from standard `SL2` whose upper and lower root curves are the two
chosen one-parameter generators, the morphism is automatically surjective and
has finite central kernel.  Surjectivity follows because both pairs of curves
generate their respective groups.  For the kernel, simplicity of `PSL2` and
perfectness of `SL2` show that every proper normal subgroup of `SL2` is central;
the center is finite.

Thus the remaining geometric input in opposite-root recognition is exactly
the construction of a regular morphism with the two curve identities.  No
normalizer representative, coroot, reflection formula, root-string theorem,
or numbered root-system result is used here.  This is the formal final step of
the local rank-one argument underlying GLS3, Theorem 1.9.5(d).
-/

universe u

namespace Theory.AlgebraicGroup

open StandardRootSystem

variable {k : Type u} [Field k]

/-- The canonical inclusion of the first factor into the closed subgroup
generated by an ordered pair. -/
public noncomputable def oppositePairPlusMorphism
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K) :
    AlgebraicGroup.Morphism Xplus.carrierVariety
      (oppositePairGeneratedSubgroup Xplus Xminus).carrierVariety :=
  Xplus.inclusion.codRestrictClosedSubgroup
    (oppositePairGeneratedSubgroup Xplus Xminus) fun x => by
      apply sup_le_oppositePairGeneratedSubgroup Xplus Xminus
      exact Subgroup.mem_sup_left (T := Xminus.toSubgroup) (Xplus.pointEquiv x).property

/-- The canonical inclusion of the second factor into the closed subgroup
generated by an ordered pair. -/
public noncomputable def oppositePairMinusMorphism
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K) :
    AlgebraicGroup.Morphism Xminus.carrierVariety
      (oppositePairGeneratedSubgroup Xplus Xminus).carrierVariety :=
  Xminus.inclusion.codRestrictClosedSubgroup
    (oppositePairGeneratedSubgroup Xplus Xminus) fun x => by
      apply sup_le_oppositePairGeneratedSubgroup Xplus Xminus
      exact Subgroup.mem_sup_right (S := Xplus.toSubgroup) (Xminus.pointEquiv x).property

public lemma oppositePairPlusMorphism_inclusion_apply
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K) (x : Variety.Point Xplus.carrierVariety) :
    (oppositePairGeneratedSubgroup Xplus Xminus).inclusion.onPoints
        ((oppositePairPlusMorphism Xplus Xminus).onPoints x) =
      Xplus.inclusion.onPoints x := by
  unfold oppositePairPlusMorphism
  exact Morphism.codRestrictClosedSubgroup_inclusion_apply _ _ _ _

public lemma oppositePairMinusMorphism_inclusion_apply
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K) (x : Variety.Point Xminus.carrierVariety) :
    (oppositePairGeneratedSubgroup Xplus Xminus).inclusion.onPoints
        ((oppositePairMinusMorphism Xplus Xminus).onPoints x) =
      Xminus.inclusion.onPoints x := by
  unfold oppositePairMinusMorphism
  exact Morphism.codRestrictClosedSubgroup_inclusion_apply _ _ _ _

private lemma oppositePairPlusMorphism_injective
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K) :
    Function.Injective (oppositePairPlusMorphism Xplus Xminus).onPoints := by
  intro x y hxy
  apply Xplus.inclusion_injective
  rw [← oppositePairPlusMorphism_inclusion_apply Xplus Xminus x,
    ← oppositePairPlusMorphism_inclusion_apply Xplus Xminus y]
  exact congrArg
    (oppositePairGeneratedSubgroup Xplus Xminus).inclusion.onPoints hxy

variable [IsAlgClosed k]

/-- Compatibility means that a morphism carries the standard upper and lower
unipotent curves to the two selected parametrized factors. -/
@[expose]
public def OppositePairSL2Compatible
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K)
    (xplus : OneParameterParametrization Xplus.carrierVariety)
    (xminus : OneParameterParametrization Xminus.carrierVariety)
    (f : AlgebraicGroup.Morphism (slVariety k 2)
      (oppositePairGeneratedSubgroup Xplus Xminus).carrierVariety) : Prop :=
  (oppositePairPlusMorphism Xplus Xminus).comp xplus.hom =
      f.comp standardSL2UpperMorphism ∧
    (oppositePairMinusMorphism Xplus Xminus).comp xminus.hom =
      f.comp standardSL2LowerMorphism

private lemma sl2FieldWitness :
    ∃ a : k, a ≠ 0 ∧ a ^ 2 ≠ 1 := by
  let p : Polynomial k := Polynomial.X ^ 2 - Polynomial.X - 1
  have hpdegree : p.degree = 2 := by
    dsimp [p]
    compute_degree <;> norm_num
  have hp : p.degree ≠ 0 := by
    rw [hpdegree]
    norm_num
  obtain ⟨a, ha⟩ := IsAlgClosed.exists_root p hp
  have haeq : a ^ 2 - a - 1 = 0 := by
    simpa [p, Polynomial.IsRoot] using ha
  have ha0 : a ≠ 0 := by
    intro h
    subst a
    simp at haeq
  refine ⟨a, ha0, ?_⟩
  intro ha2
  rw [ha2] at haeq
  simp at haeq
  exact ha0 haeq

private lemma sl2Matrix_normal_le_center_of_ne_top
    (N : Subgroup (Matrix.SpecialLinearGroup (Fin 2) k)) [N.Normal]
    (hN : N ≠ ⊤) :
    N ≤ Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) k) := by
  obtain ⟨a, ha, ha2⟩ := sl2FieldWitness (k := k)
  let _ : IsSimpleGroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) k) :=
    Matrix.ProjectiveSpecialLinearGroup.rank_two_simple' ⟨a, ha, ha2⟩
  let Z := Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) k)
  let q := QuotientGroup.mk' Z
  have hnormal : (N.map q).Normal :=
    Subgroup.Normal.map inferInstance q (QuotientGroup.mk'_surjective Z)
  rcases hnormal.eq_bot_or_eq_top with hbot | htop
  · have hle : N ≤ q.ker := N.map_eq_bot_iff.mp hbot
    simpa [q, Z] using hle
  · exfalso
    apply hN
    have hsup : N ⊔ Z = ⊤ := by
      calc
        N ⊔ Z = N ⊔ q.ker := by rw [QuotientGroup.ker_mk']
        _ = Subgroup.comap q (N.map q) := (Subgroup.comap_map_eq q N).symm
        _ = ⊤ := by rw [htop]; simp
    have hcomm : commutator (Matrix.SpecialLinearGroup (Fin 2) k) ≤ N :=
      Subgroup.Normal.commutator_le_of_self_sup_commutative_eq_top hsup inferInstance
    rw [Matrix.SL2.commutator_eq_top ha ha2] at hcomm
    exact top_unique hcomm

private lemma sl2Point_normal_le_center_of_ne_top
    (N : Subgroup (Variety.Point (slVariety k 2))) [N.Normal]
    (hN : N ≠ ⊤) :
    N ≤ Subgroup.center (Variety.Point (slVariety k 2)) := by
  let e := slPointMulEquiv (k := k) 2
  let M := N.map e.toMonoidHom
  let _ : M.Normal := Subgroup.Normal.map inferInstance e.toMonoidHom e.surjective
  have hM : M ≠ ⊤ := by
    intro hMtop
    apply hN
    have h := congrArg (Subgroup.comap e.toMonoidHom) hMtop
    rw [Subgroup.comap_map_eq_self_of_injective e.injective, Subgroup.comap_top] at h
    exact h
  have hMcenter := sl2Matrix_normal_le_center_of_ne_top M hM
  intro g hg
  exact (MulEquivClass.apply_mem_center_iff e).mp
    (hMcenter (Subgroup.mem_map_of_mem e.toMonoidHom hg))

private lemma finiteSL2PointCenter :
    Finite (Subgroup.center (Variety.Point (slVariety k 2))) := by
  let e := slPointMulEquiv (k := k) 2
  let _ : NeZero (max (Fintype.card (Fin 2)) 1) := ⟨by simp⟩
  let c := (Subgroup.centerCongr e).trans
    Matrix.SpecialLinearGroup.center_equiv_rootsOfUnity
  exact Finite.of_injective c c.injective

omit [IsAlgClosed k] in
private lemma kPlusPoint_one_ne_one :
    kPlusPoint (1 : k) ≠ 1 := by
  intro h
  have h' := congrArg
    (fun z => Multiplicative.toAdd (additiveGroupPointEquiv k z)) h
  change (1 : k) = 0 at h'
  exact one_ne_zero h'

private lemma oppositePairParametrizations_generate
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K)
    (xplus : OneParameterParametrization Xplus.carrierVariety)
    (xminus : OneParameterParametrization Xminus.carrierVariety) :
    Subgroup.closure
        (Set.range
            ((oppositePairPlusMorphism Xplus Xminus).comp xplus.hom).onPoints ∪
          Set.range
            ((oppositePairMinusMorphism Xplus Xminus).comp xminus.hom).onPoints) =
      ⊤ := by
  let H := oppositePairGeneratedSubgroup Xplus Xminus
  let S : Subgroup (Variety.Point H.carrierVariety) :=
    Subgroup.closure
      (Set.range
          ((oppositePairPlusMorphism Xplus Xminus).comp xplus.hom).onPoints ∪
        Set.range
          ((oppositePairMinusMorphism Xplus Xminus).comp xminus.hom).onPoints)
  change S = ⊤
  apply top_unique
  intro y _hy
  have hplus : Xplus.toSubgroup ≤ S.map H.inclusion.onPoints := by
    intro g hg
    have hg' : g ∈ Set.range Xplus.inclusion.onPoints := by
      rw [Xplus.range_inclusion]
      exact hg
    obtain ⟨z, rfl⟩ := hg'
    obtain ⟨a, rfl⟩ := xplus.toMulEquiv.surjective z
    refine ⟨((oppositePairPlusMorphism Xplus Xminus).comp xplus.hom).onPoints a,
      Subgroup.subset_closure (Set.mem_union_left _ ⟨a, rfl⟩), ?_⟩
    exact oppositePairPlusMorphism_inclusion_apply
      Xplus Xminus (xplus.hom.onPoints a)
  have hminus : Xminus.toSubgroup ≤ S.map H.inclusion.onPoints := by
    intro g hg
    have hg' : g ∈ Set.range Xminus.inclusion.onPoints := by
      rw [Xminus.range_inclusion]
      exact hg
    obtain ⟨z, rfl⟩ := hg'
    obtain ⟨a, rfl⟩ := xminus.toMulEquiv.surjective z
    refine ⟨((oppositePairMinusMorphism Xplus Xminus).comp xminus.hom).onPoints a,
      Subgroup.subset_closure (Set.mem_union_right _ ⟨a, rfl⟩), ?_⟩
    exact oppositePairMinusMorphism_inclusion_apply
      Xplus Xminus (xminus.hom.onPoints a)
  have hyambient : H.inclusion.onPoints y ∈ Xplus.toSubgroup ⊔ Xminus.toSubgroup := by
    rw [← oppositePairGeneratedSubgroup_toSubgroup Xplus Xminus
      ⟨xplus⟩ ⟨xminus⟩]
    exact (H.pointEquiv y).property
  have hymap : H.inclusion.onPoints y ∈ S.map H.inclusion.onPoints :=
    (sup_le hplus hminus) hyambient
  obtain ⟨z, hzS, hzy⟩ := hymap
  have : z = y := H.inclusion_injective hzy
  simpa [this] using hzS

private lemma compatibleSL2Morphism_surjective
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K)
    (xplus : OneParameterParametrization Xplus.carrierVariety)
    (xminus : OneParameterParametrization Xminus.carrierVariety)
    (f : AlgebraicGroup.Morphism (slVariety k 2)
      (oppositePairGeneratedSubgroup Xplus Xminus).carrierVariety)
    (hcompat : OppositePairSL2Compatible Xplus Xminus xplus xminus f) :
    Function.Surjective f.onPoints := by
  rw [← MonoidHom.range_eq_top]
  let R := f.onPoints.range
  apply top_unique
  intro y _hy
  have hcurves :=
    oppositePairParametrizations_generate Xplus Xminus xplus xminus
  have hR : Subgroup.closure
      (Set.range
          ((oppositePairPlusMorphism Xplus Xminus).comp xplus.hom).onPoints ∪
        Set.range
          ((oppositePairMinusMorphism Xplus Xminus).comp xminus.hom).onPoints) ≤ R := by
    rw [Subgroup.closure_le]
    rintro z (hz | hz)
    · obtain ⟨a, rfl⟩ := hz
      rw [hcompat.1]
      exact ⟨(standardSL2UpperMorphism (k := k)).onPoints a, rfl⟩
    · obtain ⟨a, rfl⟩ := hz
      rw [hcompat.2]
      exact ⟨(standardSL2LowerMorphism (k := k)).onPoints a, rfl⟩
  rw [hcurves] at hR
  exact hR trivial

private lemma compatibleSL2Morphism_kernel_ne_top
    {K : Variety k} [AlgebraicGroup K]
    (Xplus Xminus : ClosedSubgroup K)
    (xplus : OneParameterParametrization Xplus.carrierVariety)
    (f : AlgebraicGroup.Morphism (slVariety k 2)
      (oppositePairGeneratedSubgroup Xplus Xminus).carrierVariety)
    (hplus : (oppositePairPlusMorphism Xplus Xminus).comp xplus.hom =
      f.comp standardSL2UpperMorphism) :
    f.kernel ≠ ⊤ := by
  intro hkernel
  have hmem :
      (standardSL2UpperMorphism (k := k)).onPoints (kPlusPoint (1 : k)) ∈
        f.kernel := by
    rw [hkernel]
    trivial
  have hcurveOne :
      ((oppositePairPlusMorphism Xplus Xminus).comp xplus.hom).onPoints
          (kPlusPoint (1 : k)) = 1 := by
    rw [hplus]
    exact MonoidHom.mem_ker.mp hmem
  have hxplusOne :
      xplus.hom.onPoints (kPlusPoint (1 : k)) = 1 := by
    apply oppositePairPlusMorphism_injective Xplus Xminus
    exact hcurveOne.trans
      (oppositePairPlusMorphism Xplus Xminus).onPoints.map_one.symm
  apply kPlusPoint_one_ne_one (k := k)
  apply xplus.toMulEquiv.injective
  exact hxplusOne.trans xplus.hom.onPoints.map_one.symm

private lemma finiteKernel_of_le_SL2PointCenter
    {K : Variety k} [AlgebraicGroup K]
    (f : AlgebraicGroup.Morphism (slVariety k 2) K)
    (hcenter : f.kernel ≤
      Subgroup.center (Variety.Point (slVariety k 2))) :
    Finite f.kernel := by
  let _ : Finite (Subgroup.center (Variety.Point (slVariety k 2))) :=
    finiteSL2PointCenter (k := k)
  let embed : f.kernel → Subgroup.center (Variety.Point (slVariety k 2)) :=
    fun z => ⟨z.1, hcenter z.2⟩
  exact Finite.of_injective embed fun x y hxy => by
    apply Subtype.ext
    exact congrArg
      (fun z : Subgroup.center (Variety.Point (slVariety k 2)) => z.1) hxy

/-- A curve-compatible morphism from standard `SL2` has central kernel. -/
public theorem OppositePairSL2Compatible.kernel_le_center
    {K : Variety k} [AlgebraicGroup K]
    {Xplus Xminus : ClosedSubgroup K}
    {xplus : OneParameterParametrization Xplus.carrierVariety}
    {xminus : OneParameterParametrization Xminus.carrierVariety}
    {f : AlgebraicGroup.Morphism (slVariety k 2)
      (oppositePairGeneratedSubgroup Xplus Xminus).carrierVariety}
    (hcompat : OppositePairSL2Compatible Xplus Xminus xplus xminus f) :
    f.kernel ≤ Subgroup.center (Variety.Point (slVariety k 2)) :=
  sl2Point_normal_le_center_of_ne_top f.kernel
    (compatibleSL2Morphism_kernel_ne_top Xplus Xminus xplus f hcompat.1)

/-- Formal rank-one recognition: a morphism carrying the standard upper and
lower curves to the selected opposite-pair parametrizations is an isogeny. -/
public theorem OppositePairSL2Compatible.isIsogeny
    {K : Variety k} [AlgebraicGroup K]
    {Xplus Xminus : ClosedSubgroup K}
    {xplus : OneParameterParametrization Xplus.carrierVariety}
    {xminus : OneParameterParametrization Xminus.carrierVariety}
    {f : AlgebraicGroup.Morphism (slVariety k 2)
      (oppositePairGeneratedSubgroup Xplus Xminus).carrierVariety}
    (hcompat : OppositePairSL2Compatible Xplus Xminus xplus xminus f) :
    IsIsogeny f := by
  refine ⟨compatibleSL2Morphism_surjective Xplus Xminus xplus xminus f hcompat, ?_⟩
  exact finiteKernel_of_le_SL2PointCenter f hcompat.kernel_le_center

end Theory.AlgebraicGroup
