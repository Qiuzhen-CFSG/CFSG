module

public import Theory.AlgebraicGroup.Tori.Character.Point
public import Theory.AlgebraicGroup.Unipotent.OneParameter

universe u

/-!
Root subgroups, their weights, and root-group realization data.

A realization indexes exactly the actual torus roots: `rootWeight` is injective,
while its range is `TorusRootSet`.  The remaining fields record the chosen root
subgroups and the additive, reflection, pairing, and positivity bookkeeping.
`RootGroupData.IsRootAdditionComplete` supplies the converse omitted from the
legacy realization tuple: every sum which is an actual root is returned by the
partial root-addition operation.
Following GLS3, Remarks 1.9.6, every root also carries its algebraic
cocharacter.  The realized weight pairing is the unique exponent obtained by
evaluating any torus character on that cocharacter, not merely a function whose
values happen to agree with Cartan integers on root weights.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

@[expose]
public def IsClosedSubgroupInvariant
    {K : Variety k} [AlgebraicGroup K] (T X : ClosedSubgroup K) : Prop :=
  ∀ t, t ∈ T → ∀ x, x ∈ X → t⁻¹ * x * t ∈ X

/-- Definition 1.9.1: a weight is a character of the maximal torus. -/
public abbrev TorusWeight {K : Variety k} [AlgebraicGroup K]
    (T : ClosedSubgroup K) := TorusCharacter T.carrierVariety

/-- Definition 1.9.1: a root subgroup is a torus-invariant one-parameter
closed subgroup. -/
@[expose]
public def IsTorusRootSubgroup
    {K : Variety k} [AlgebraicGroup K] (T X : ClosedSubgroup K) : Prop :=
  IsClosedSubgroupInvariant T X ∧ IsOneParameterGroup X.carrierVariety

@[expose]
public def RootWeightEquation
    {K : Variety k} [AlgebraicGroup K] (T X : ClosedSubgroup K)
    (χ : TorusWeight T) : Prop :=
  ∀ x : OneParameterParametrization X.carrierVariety,
    ∀ t : k, ∀ s : Variety.Point T.carrierVariety,
      (T.includePoint s)⁻¹ * X.includePoint (x.value t) * T.includePoint s =
        X.includePoint (x.value (χ.pointCharacter s * t))

/-- Definition 1.9.3: roots are precisely weights occurring in the
conjugation action on root subgroups. -/
@[expose]
public def IsTorusRoot
    {K : Variety k} [AlgebraicGroup K] (T : ClosedSubgroup K)
    (χ : TorusWeight T) : Prop :=
  ∃ X : ClosedSubgroup K, IsTorusRootSubgroup T X ∧ RootWeightEquation T X χ

@[expose]
public def TorusRootSet
    {K : Variety k} [AlgebraicGroup K] (T : ClosedSubgroup K) :
    Set (TorusWeight T) :=
  {χ | IsTorusRoot T χ}

/-- Definition 1.9.3: the root lattice is generated by the torus roots. -/
@[expose]
public noncomputable def TorusRootLattice
    {K : Variety k} [AlgebraicGroup K] (T : ClosedSubgroup K) :
    Subgroup (TorusWeight T) :=
  Subgroup.closure (TorusRootSet T)

/-- A cocharacter of a closed subgroup torus is an algebraic-group morphism
from the multiplicative one-dimensional torus. -/
public abbrev ClosedSubgroupTorusCocharacter
    {G : Variety k} [AlgebraicGroup G] (T : ClosedSubgroup G) :=
  AlgebraicGroup.Morphism (KMult k) T.carrierVariety

/-- The character--cocharacter pairing has value `m` when their composite is
the Laurent power `t ↦ t ^ m`. -/
@[expose]
public def WeightCocharacterEquation
    {G : Variety k} [AlgebraicGroup G] (T : ClosedSubgroup G)
    (χ : TorusWeight T) (h : ClosedSubgroupTorusCocharacter T) (m : ℤ) : Prop :=
  ∀ t : Variety.Point (KMult k),
    χ.pointCharacter (h.onPoints t) = (dPointEquiv 1 t 0 : k) ^ m

/-- Choices attached to a root-system realization. -/
public structure RootGroupData
    (K : Variety k) [AlgebraicGroup K] (T : ClosedSubgroup K) where
  Root : Type u
  rootWeight : Root → TorusWeight T
  rootSubgroup : Root → ClosedSubgroup K
  neg : Root → Root
  add : Root → Root → Option Root
  pairing : Root → Root → ℤ
  weightPairing : TorusWeight T → Root → ℤ
  rootCocharacter : Root → ClosedSubgroupTorusCocharacter T
  reflect : Root → Root → Root
  positive : Set Root
  simple : Set Root
  height : Root → ℤ

@[expose]
public def RootGroupData.IsRealization
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) : Prop :=
  Function.Injective D.rootWeight ∧
    Set.range D.rootWeight = TorusRootSet T ∧
    (∀ α, IsTorusRootSubgroup T (D.rootSubgroup α) ∧
      RootWeightEquation T (D.rootSubgroup α) (D.rootWeight α)) ∧
    (∀ α, D.rootWeight (D.neg α) = (D.rootWeight α)⁻¹) ∧
    (∀ α β γ, D.add α β = some γ →
      D.rootWeight γ = D.rootWeight α * D.rootWeight β) ∧
    (∀ α β, D.rootWeight (D.reflect α β) =
      D.rootWeight β * D.rootWeight α ^ (-D.pairing β α)) ∧
    (∀ α, D.pairing α α = 2) ∧
    (∀ α β, D.weightPairing (D.rootWeight α) β = D.pairing α β) ∧
    (∀ α, D.height (D.neg α) = -D.height α) ∧
    (∀ α β γ, D.add α β = some γ →
      D.height γ = D.height α + D.height β) ∧
    D.positive = {α | 0 < D.height α} ∧
    (∀ α, α ∈ D.simple ↔
      α ∈ D.positive ∧
        ∀ β γ, D.add β γ = some α →
          ¬ (β ∈ D.positive ∧ γ ∈ D.positive)) ∧
    ∀ χ β, WeightCocharacterEquation T χ (D.rootCocharacter β)
      (D.weightPairing χ β)

/-- Every actual root which is the sum of two actual roots is represented by
`D.add`.  Actual roots are identified by their torus weights, whose group law
is addition of characters. -/
@[expose]
public def RootGroupData.IsRootAdditionComplete
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) : Prop :=
  ∀ α β γ, D.rootWeight γ = D.rootWeight α * D.rootWeight β →
    D.add α β = some γ

omit [IsAlgClosed k] in
/-- On root weights, the realized character--coroot pairing is the Cartan
pairing already carried by the root data. -/
public theorem RootGroupData.IsRealization.weightPairing_rootWeight
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    {D : RootGroupData K T} (hD : D.IsRealization) (α β : D.Root) :
    D.weightPairing (D.rootWeight α) β = D.pairing α β :=
  hD.2.2.2.2.2.2.2.1 α β

omit [IsAlgClosed k] in
/-- Every value of a realized weight pairing is computed by evaluating the
character on the root's chosen algebraic cocharacter. -/
public theorem RootGroupData.IsRealization.weightPairing_spec
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    {D : RootGroupData K T} (hD : D.IsRealization)
    (χ : TorusWeight T) (β : D.Root) :
    WeightCocharacterEquation T χ (D.rootCocharacter β)
      (D.weightPairing χ β) := by
  rcases hD with ⟨_, _, _, _, _, _, _, _, _, _, _, _, hPairing⟩
  exact hPairing χ β

omit [IsAlgClosed k] in
/-- The chosen root cocharacters realize the Cartan pairing on actual root
weights. -/
public theorem RootGroupData.IsRealization.rootWeight_rootCocharacter
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    {D : RootGroupData K T} (hD : D.IsRealization) (α β : D.Root) :
    WeightCocharacterEquation T (D.rootWeight α) (D.rootCocharacter β)
      (D.pairing α β) := by
  rw [← hD.weightPairing_rootWeight α β]
  exact hD.weightPairing_spec (D.rootWeight α) β

@[expose]
public def IsPositiveSystem
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (P : Set D.Root) : Prop :=
  P ∩ D.neg ⁻¹' P = ∅ ∧
    P ∪ D.neg ⁻¹' P = Set.univ ∧
    ∀ α ∈ P, ∀ β ∈ P, ∀ γ, D.add α β = some γ → γ ∈ P

/-- The fundamental roots determined by a selected positive system. -/
@[expose]
public def FundamentalRootsFor
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (P : Set D.Root) : Set D.Root :=
  {α | α ∈ P ∧
    ∀ β, β ∈ P → ∀ γ, γ ∈ P → D.add β γ ≠ some α}

@[expose]
public def RootSubgroupGenerated
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root) : Subgroup (Variety.Point K) :=
  Subgroup.closure (⋃ α ∈ A, (D.rootSubgroup α : Set (Variety.Point K)))

/-- A torus root subgroup is invariant, unipotent, and nontrivial. -/
public lemma IsTorusRootSubgroup.invariant_unipotent_ne_bot
    {K : Variety k} [AlgebraicGroup K] {T X : ClosedSubgroup K}
    (hX : IsTorusRootSubgroup T X) :
    IsClosedSubgroupInvariant T X ∧
      IsUnipotentAlgebraicGroup X.carrierVariety ∧ X.toSubgroup ≠ ⊥ := by
  refine ⟨hX.1, hX.2.isUnipotentAlgebraicGroup, ?_⟩
  intro hbot
  obtain ⟨e⟩ := hX.2
  let x := e.hom.onPoints (kPlusPoint (1 : k))
  have hx : x ≠ 1 := by
    intro hx
    have h := congrArg e.inv.onPoints hx
    rw [e.hom_inv_id, map_one] at h
    have h' := congrArg (additiveGroupPointEquiv k) h
    change Multiplicative.ofAdd (1 : k) = Multiplicative.ofAdd 0 at h'
    exact one_ne_zero (congrArg Multiplicative.toAdd h')
  have hxmem : X.includePoint x ∈ X := (X.pointEquiv x).property
  have hincOne : X.includePoint x = 1 := by
    apply Subgroup.mem_bot.mp
    rw [← hbot]
    exact hxmem
  apply hx
  apply X.inclusion_injective
  change X.includePoint x = X.includePoint 1
  have hone : X.includePoint (1 : Variety.Point X.carrierVariety) = 1 :=
    X.inclusion.map_one
  exact hincOne.trans hone.symm

end Theory.AlgebraicGroup
