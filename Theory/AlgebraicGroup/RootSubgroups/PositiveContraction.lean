module

public import Theory.AlgebraicGroup.RootSubgroups.CocharacterExistence
public import Theory.AlgebraicGroup.Unipotent.Contraction.Defs

/-!
Contraction of subgroups generated by roots with positive cocharacter weights.

For a root element `x(c)` of positive integral weight `m`, the curve
`a ↦ x(a^m c)` extends its inverse-conjugation orbit and equals one at zero.
Products and inverses of these curves contract every element of the subgroup
generated by the selected roots. An integral functional positive on their
characters gives the required algebraic cocharacter by torus duality.

This proves the contraction step behind Borel, §14.5, and GLS3, Theorem 1.11.2,
in arbitrary characteristic, including the empty generating set. Existence
of a positive functional for an abstract positive system is a separate input.
-/

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]
variable {G : Variety k} [AlgebraicGroup G]

private def contractionMonomial (n : ℕ) (c : k) :
    Variety.Morphism (KPlus k) (KPlus k) where
  toFun z := kPlusPoint (z.val PUnit.unit ^ n * c)
  regular := by
    intro i
    refine ⟨MvPolynomial.X PUnit.unit ^ n * MvPolynomial.C c, ?_⟩
    intro z
    change z.val PUnit.unit ^ n * c = _
    simp [evalPolynomial]

variable {T : ClosedSubgroup G}

/-- A root on which a cocharacter has positive exponent is contracted by it.
The curve is explicitly `a ↦ x(a^m c)`, with natural exponent `m > 0`. -/
public theorem rootElement_isCocharacterContracted
    (D : RootGroupData G T) (hD : D.IsRealization)
    (lambda : ClosedSubgroupTorusCocharacter T)
    (alpha : D.Root) (m : ℤ) (hm : 0 < m)
    (hpair : WeightCocharacterEquation T (D.rootWeight alpha) lambda m)
    {g : Variety.Point G} (hg : g ∈ D.rootSubgroup alpha) :
    IsCocharacterContracted (T.inclusion.comp lambda) g := by
  let X := D.rootSubgroup alpha
  let x : OneParameterParametrization X.carrierVariety :=
    Classical.choice (hD.2.2.1 alpha).1.2
  let y := X.pointEquiv.symm ⟨g, hg⟩
  let z := x.inv.onPoints y
  let c : k := Multiplicative.toAdd (additiveGroupPointEquiv k z)
  have hc : X.includePoint (x.value c) = g := by
    change X.includePoint (x.hom.onPoints (kPlusPoint c)) = g
    rw [show kPlusPoint c = z from kPlusPoint_coordinate z]
    change X.includePoint (x.hom.onPoints (x.inv.onPoints y)) = g
    rw [x.inv_hom_id]
    exact congrArg Subtype.val (X.pointEquiv.apply_symm_apply ⟨g, hg⟩)
  let f := X.inclusion.toVariety.comp
    (x.hom.toVariety.comp (contractionMonomial m.toNat c))
  refine ⟨f, ?_, ?_⟩
  · change X.includePoint (x.value ((0 : k) ^ m.toNat * c)) = 1
    rw [zero_pow (by omega : m.toNat ≠ 0), zero_mul]
    change X.inclusion.onPoints (x.hom.onPoints (1 : Variety.Point (KPlus k))) = 1
    rw [map_one, map_one]
  · intro t
    change X.includePoint (x.value ((dPointEquiv 1 t 0 : k) ^ m.toNat * c)) =
      (T.includePoint (lambda.onPoints t))⁻¹ * g * T.includePoint (lambda.onPoints t)
    rw [← hc, (hD.2.2.1 alpha).2 x c (lambda.onPoints t), hpair t]
    rw [← Int.toNat_of_nonneg hm.le, zpow_natCast, Int.toNat_natCast]

/-- Contraction passes from each chosen root subgroup to its abstractly
generated subgroup; no ordering or commutator formula is needed. -/
public theorem rootSubgroupGenerated_isCocharacterContracted
    (D : RootGroupData G T) (hD : D.IsRealization)
    (A : Set D.Root) (lambda : ClosedSubgroupTorusCocharacter T)
    (m : D.Root → ℤ) (hm : ∀ alpha ∈ A, 0 < m alpha)
    (hpair : ∀ alpha ∈ A,
      WeightCocharacterEquation T (D.rootWeight alpha) lambda (m alpha))
    {g : Variety.Point G} (hg : g ∈ RootSubgroupGenerated D A) :
    IsCocharacterContracted (T.inclusion.comp lambda) g := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
      obtain ⟨alpha, ha, hg⟩ := Set.mem_iUnion.mp hg |>.imp fun _ => Set.mem_iUnion.mp
      exact rootElement_isCocharacterContracted D hD lambda alpha (m alpha)
        (hm alpha ha) (hpair alpha ha) hg
  | one => exact IsCocharacterContracted.one _
  | mul g h hg hh hcg hch => exact hcg.mul hch
  | inv g hg hcg => exact hcg.inv

variable [IsAlgClosed k]

/-- A positive integral character functional gives a common contracting
cocharacter for the subgroup generated by the selected roots. -/
public theorem rootSubgroupGenerated_exists_contracting_cocharacter
    (D : RootGroupData G T) (hD : D.IsRealization) (hT : IsSubtorus T)
    (A : Set D.Root) (phi : Additive (TorusWeight T) →+ ℤ)
    (hphi : ∀ alpha ∈ A, 0 < phi (Additive.ofMul (D.rootWeight alpha))) :
    ∃ lambda : ClosedSubgroupTorusCocharacter T,
      ∀ g ∈ RootSubgroupGenerated D A,
        IsCocharacterContracted (T.inclusion.comp lambda) g := by
  obtain ⟨lambda, hlambda⟩ := exists_cocharacter_realizing_characterFunctional T hT phi
  refine ⟨lambda, fun g hg => ?_⟩
  exact rootSubgroupGenerated_isCocharacterContracted D hD A lambda
    (fun alpha => phi (Additive.ofMul (D.rootWeight alpha))) hphi
    (fun alpha _ => hlambda (D.rootWeight alpha)) hg

end Theory.AlgebraicGroup
