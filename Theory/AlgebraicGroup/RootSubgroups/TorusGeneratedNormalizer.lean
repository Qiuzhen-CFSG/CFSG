module

public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup
public import Theory.AlgebraicGroup.RootSubgroups.NormalizerMembership

universe u

/-!
Normalization of root-generated subgroups by a realizing torus.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

/-- A realizing torus normalizes every subgroup generated by a set of its root
subgroups. -/
public lemma torus_le_rootSubgroupGenerated_normalizer
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (A : Set D.Root) :
    T.toSubgroup ≤
      Subgroup.normalizer
        (RootSubgroupGenerated D A : Set (Variety.Point K)) := by
  rw [RootSubgroupGenerated, Subgroup.le_normalizer_closure_iff]
  intro g hg x hx
  simp only [Set.mem_iUnion] at hx
  obtain ⟨α, hα, hxα⟩ := hx
  have hnorm := mem_rootSubgroup_normalizer_of_mem_torus D hD g hg α
  change g ∈ Subgroup.normalizer
    ((D.rootSubgroup α).toSubgroup : Set (Variety.Point K)) at hnorm
  rw [Subgroup.mem_normalizer_iff] at hnorm
  apply Subgroup.subset_closure
  simp only [Set.mem_iUnion]
  exact ⟨α, hα, (hnorm x).mp hxα⟩

end Theory.AlgebraicGroup
