module

public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.RootSubgroups.TorusGeneratedNormalizer
public import Theory.AlgebraicGroup.Tori.Character.AffinePolynomialSupport

/-!
Character support for subgroups generated by realized root subgroups.

For a root realization relative to a subtorus, this module proves that a root
subgroup contained in the join of a root-generated subgroup and the torus has
character in the multiplicative monoid generated by the chosen root
characters.  The proof is independent of Borels, positive systems, and
Chevalley systems.

Finite connected-subgroup generation gives one finite root word.  After
factoring a nonzero point of the target root subgroup as that word times a
torus point, the word parameters define a morphism from affine space.  Torus
conjugation scales its coordinates by their root characters.  A polynomial
function on the ambient group restricts to the exact affine parameter on the
target root subgroup; pulling it back along the word morphism and applying the
torus character-algebra support lemma detects the target character.  This
degree-one ambient coordinate comes from the closed immersion of the root
subgroup, so the argument remains valid in positive characteristic and does
not infer tangent generation from point generation.
-/

namespace Theory.AlgebraicGroup

open scoped BigOperators Pointwise

universe u

variable {k : Type u} [Field k] [IsAlgClosed k]

private noncomputable def affineCoordinateMorphism
    (sigma : Type u) [Finite sigma] (i : sigma) :
    Variety.Morphism (affineSpaceVariety k sigma) (KPlus k) where
  toFun z := kPlusPoint (z.val i)
  regular := by
    intro j
    refine ⟨MvPolynomial.X i, ?_⟩
    intro z
    rw [show j = PUnit.unit by rfl]
    change z.val i = evalPolynomial z.val (MvPolynomial.X i)
    rw [evalPolynomial_X]

private noncomputable def rootParametrization
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (alpha : D.Root) :
    OneParameterParametrization (D.rootSubgroup alpha).carrierVariety :=
  Classical.choice (hD.2.2.1 alpha).1.2

private noncomputable def rootCurve
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (alpha : D.Root) :
    Variety.Morphism (KPlus k) K :=
  (D.rootSubgroup alpha).inclusion.toVariety.comp
    (rootParametrization D hD alpha).hom.toVariety

private noncomputable def varietyMorphismListProduct
    {X K : Variety k} [AlgebraicGroup K] :
    List (Variety.Morphism X K) → Variety.Morphism X K
  | [] => Variety.Morphism.const X K 1
  | f :: fs => (AlgebraicGroup.mulMorphism K).comp
      (f.pair (varietyMorphismListProduct fs))

omit [IsAlgClosed k] in
private lemma varietyMorphismListProduct_apply
    {X K : Variety k} [AlgebraicGroup K]
    (fs : List (Variety.Morphism X K)) (z : Variety.Point X) :
    (varietyMorphismListProduct fs).toFun z =
      (fs.map fun f => f.toFun z).prod := by
  induction fs with
  | nil => rfl
  | cons f fs ih =>
      change f.toFun z * (varietyMorphismListProduct fs).toFun z = _
      rw [ih]
      rfl

private noncomputable def rootWordMorphism
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (w : List D.Root) :
    Variety.Morphism
      (affineSpaceVariety k (ULift.{u} (Fin w.length))) K :=
  varietyMorphismListProduct
    (List.ofFn fun i =>
      (rootCurve D hD (w.get i)).comp
        (affineCoordinateMorphism (ULift.{u} (Fin w.length))
          (ULift.up i)))

omit [IsAlgClosed k] in
private lemma rootWordMorphism_apply
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (w : List D.Root)
    (a : Fin w.length → k) :
    (rootWordMorphism D hD w).toFun
        (affineSpacePoint fun i => a i.down) =
      (List.ofFn fun i =>
        (rootCurve D hD (w.get i)).toFun (kPlusPoint (a i))).prod := by
  rw [rootWordMorphism, varietyMorphismListProduct_apply, List.map_ofFn]
  rfl

omit [IsAlgClosed k] in
private lemma closedSubgroupWordProduct_map
    {K : Variety k} [AlgebraicGroup K] {ι j : Type*}
    (H : j → ClosedSubgroup K) (f : ι → j) (w : List ι) :
    closedSubgroupWordProduct H (w.map f) =
      closedSubgroupWordProduct (fun i => H (f i)) w := by
  induction w with
  | nil => rfl
  | cons i w ih =>
      simp only [List.map_cons, closedSubgroupWordProduct, ih]

omit [IsAlgClosed k] in
private lemma exists_rootParameter
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (alpha : D.Root)
    (g : Variety.Point K) (hg : g ∈ D.rootSubgroup alpha) :
    ∃ c : k, (rootCurve D hD alpha).toFun (kPlusPoint c) = g := by
  let X := D.rootSubgroup alpha
  let x := rootParametrization D hD alpha
  let y : Variety.Point X.carrierVariety := X.pointEquiv.symm ⟨g, hg⟩
  let z : Variety.Point (KPlus k) := x.inv.onPoints y
  let c : k := Multiplicative.toAdd (additiveGroupPointEquiv k z)
  have hzc : kPlusPoint c = z := by
    apply (additiveGroupPointEquiv k).injective
    simp [kPlusPoint, c]
  refine ⟨c, ?_⟩
  change X.includePoint (x.hom.onPoints (kPlusPoint c)) = g
  rw [hzc, x.inv_hom_id]
  change (X.pointEquiv y).val = g
  simp [y]

omit [IsAlgClosed k] in
private lemma exists_rootWordMorphism_eq_of_mem
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization)
    (w : List D.Root) (g : Variety.Point K)
    (hg : g ∈ closedSubgroupWordProduct D.rootSubgroup w) :
    ∃ a : Fin w.length → k,
      (rootWordMorphism D hD w).toFun
        (affineSpacePoint fun i => a i.down) = g := by
  induction w generalizing g with
  | nil =>
      have hgone : g = 1 := by
        simpa only [closedSubgroupWordProduct, Set.mem_singleton_iff] using hg
      subst g
      refine ⟨fun i => Fin.elim0 i, ?_⟩
      rw [rootWordMorphism_apply]
      rfl
  | cons alpha w ih =>
      rcases Set.mem_mul.mp hg with ⟨x, hx, y, hy, hxy⟩
      obtain ⟨c, hc⟩ := exists_rootParameter D hD alpha x hx
      obtain ⟨a, ha⟩ := ih y hy
      refine ⟨Fin.cons c a, ?_⟩
      rw [rootWordMorphism_apply, List.ofFn_succ, List.prod_cons]
      simp only [List.get_cons_zero, Fin.cons_zero, Fin.cons_succ]
      have htail : (fun i : Fin w.length =>
          (rootCurve D hD ((alpha :: w).get i.succ)).toFun
            (kPlusPoint (a i))) =
          fun i => (rootCurve D hD (w.get i)).toFun
            (kPlusPoint (a i)) := by
        rfl
      rw [hc, htail, ← rootWordMorphism_apply D hD w a, ha, hxy]

omit [IsAlgClosed k] in
private lemma conjugate_list_prod
    {K : Variety k} [AlgebraicGroup K]
    (g : Variety.Point K) (xs : List (Variety.Point K)) :
    g⁻¹ * xs.prod * g = (xs.map fun x => g⁻¹ * x * g).prod := by
  induction xs with
  | nil => simp
  | cons x xs ih =>
      rw [List.prod_cons, List.map_cons, List.prod_cons]
      calc
        g⁻¹ * (x * xs.prod) * g =
            (g⁻¹ * x * g) * (g⁻¹ * xs.prod * g) := by
          simp [mul_assoc]
        _ = (g⁻¹ * x * g) *
            (List.map (fun y => g⁻¹ * y * g) xs).prod := by rw [ih]

omit [IsAlgClosed k] in
private lemma rootCurve_scale
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (alpha : D.Root)
    (c : k) (s : Variety.Point T.carrierVariety) :
    (T.includePoint s)⁻¹ * (rootCurve D hD alpha).toFun (kPlusPoint c) *
        T.includePoint s =
      (rootCurve D hD alpha).toFun
        (kPlusPoint ((D.rootWeight alpha).pointCharacter s * c)) := by
  change (T.includePoint s)⁻¹ *
      (D.rootSubgroup alpha).includePoint
        ((rootParametrization D hD alpha).value c) * T.includePoint s =
      (D.rootSubgroup alpha).includePoint
      ((rootParametrization D hD alpha).value
        ((D.rootWeight alpha).pointCharacter s * c))
  exact (hD.2.2.1 alpha).2 (rootParametrization D hD alpha) c s

omit [IsAlgClosed k] in
private lemma rootWordMorphism_scale
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (w : List D.Root)
    (a : Fin w.length → k) (s : Variety.Point T.carrierVariety) :
    (rootWordMorphism D hD w).toFun
        (affineSpacePoint fun i =>
          (D.rootWeight (w.get i.down)).pointCharacter s * a i.down) =
      (T.includePoint s)⁻¹ *
        (rootWordMorphism D hD w).toFun
          (affineSpacePoint fun i => a i.down) *
        T.includePoint s := by
  rw [rootWordMorphism_apply D hD w
      (fun i => (D.rootWeight (w.get i)).pointCharacter s * a i),
    rootWordMorphism_apply D hD w a,
    conjugate_list_prod, List.map_ofFn]
  congr 1
  apply List.ofFn_inj.mpr
  funext i
  exact (rootCurve_scale D hD (w.get i) (a i) s).symm

private noncomputable def rootWordWithTailMorphism
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (w : List D.Root)
    (t : Variety.Point T.carrierVariety) :
    Variety.Morphism
      (affineSpaceVariety k (ULift.{u} (Fin w.length))) K :=
  (AlgebraicGroup.mulMorphism K).comp
    ((rootWordMorphism D hD w).pair
      (Variety.Morphism.const _ K (T.includePoint t)))

omit [IsAlgClosed k] in
private lemma rootWordWithTailMorphism_apply
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization) (w : List D.Root)
    (t : Variety.Point T.carrierVariety)
    (z : Variety.Point (affineSpaceVariety k (ULift.{u} (Fin w.length)))) :
    (rootWordWithTailMorphism D hD w t).toFun z =
      (rootWordMorphism D hD w).toFun z * T.includePoint t := by
  rfl

omit [IsAlgClosed k] in
private lemma rootWordWithTailMorphism_scale
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (hT : IsSubtorus T) (D : RootGroupData K T) (hD : D.IsRealization)
    (w : List D.Root) (a : Fin w.length → k)
    (s t : Variety.Point T.carrierVariety) :
    (rootWordWithTailMorphism D hD w t).toFun
        (affineSpacePoint fun i =>
          (D.rootWeight (w.get i.down)).pointCharacter s * a i.down) =
      (T.includePoint s)⁻¹ *
        (rootWordWithTailMorphism D hD w t).toFun
          (affineSpacePoint fun i => a i.down) *
        T.includePoint s := by
  rw [rootWordWithTailMorphism_apply, rootWordWithTailMorphism_apply,
    rootWordMorphism_scale]
  have hTcomm := hT.isMulCommutative
  rw [isMulCommutative_iff] at hTcomm
  have hst : T.includePoint s * T.includePoint t =
      T.includePoint t * T.includePoint s := by
    calc
      T.includePoint s * T.includePoint t = T.includePoint (s * t) :=
        (T.inclusion.map_mul s t).symm
      _ = T.includePoint (t * s) := congrArg T.includePoint (hTcomm s t)
      _ = T.includePoint t * T.includePoint s := T.inclusion.map_mul t s
  rw [mul_assoc, hst]
  simp only [mul_assoc]

/-- If a realized root subgroup is contained in the subgroup generated by a
set of realized root subgroups and the realizing torus, then its character is
in the multiplicative monoid generated by the characters of that set. -/
public theorem rootWeight_mem_submonoidClosure_of_rootSubgroup_le_generated_sup_torus
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (hT : IsSubtorus T) (D : RootGroupData K T) (hD : D.IsRealization)
    (S : Set D.Root) (alpha : D.Root)
    (hle : (D.rootSubgroup alpha).toSubgroup ≤
      RootSubgroupGenerated D S ⊔ T.toSubgroup) :
    D.rootWeight alpha ∈ Submonoid.closure (D.rootWeight '' S) := by
  classical
  let H : S → ClosedSubgroup K := fun beta => D.rootSubgroup beta.1
  have hHconnected : ∀ beta,
      _root_.IsConnected (H beta : Set (Variety.Point K)) := by
    intro beta
    have hconn : Variety.IsConnected
        (D.rootSubgroup beta.1).carrierVariety :=
      (hD.2.2.1 beta.1).1.2.isConnected
    let : ConnectedSpace
        (Variety.Point (D.rootSubgroup beta.1).carrierVariety) :=
      connectedSpace_iff_univ.mpr hconn
    change _root_.IsConnected
      ((D.rootSubgroup beta.1).toSubgroup : Set (Variety.Point K))
    rw [← (D.rootSubgroup beta.1).range_inclusion]
    exact isConnected_range
      (D.rootSubgroup beta.1).inclusion.toVariety.continuous
  obtain ⟨w0, hw0⟩ :=
    exists_closedSubgroupWordProduct_eq_closure_iUnion H hHconnected
  let w : List D.Root := w0.map Subtype.val
  have hword : closedSubgroupWordProduct D.rootSubgroup w =
      (RootSubgroupGenerated D S : Set (Variety.Point K)) := by
    calc
      closedSubgroupWordProduct D.rootSubgroup w =
          closedSubgroupWordProduct H w0 := by
        exact closedSubgroupWordProduct_map D.rootSubgroup Subtype.val w0
      _ = (Subgroup.closure
          (⋃ beta : S, (H beta : Set (Variety.Point K))) :
            Set (Variety.Point K)) := hw0
      _ = (RootSubgroupGenerated D S : Set (Variety.Point K)) := by
        rw [RootSubgroupGenerated]
        rw [show (⋃ beta : S,
            (H beta : Set (Variety.Point K))) =
            ⋃ beta ∈ S,
              (D.rootSubgroup beta : Set (Variety.Point K)) by
          change (⋃ beta : S,
            (D.rootSubgroup beta.1 : Set (Variety.Point K))) = _
          exact Set.iUnion_subtype (fun beta : D.Root => beta ∈ S)
            (fun beta =>
              (D.rootSubgroup beta.1 : Set (Variety.Point K)))]
  let xalpha := rootParametrization D hD alpha
  let ualpha : Variety.Point K :=
    (rootCurve D hD alpha).toFun (kPlusPoint (1 : k))
  have hualphaRoot : ualpha ∈ D.rootSubgroup alpha := by
    change (D.rootSubgroup alpha).includePoint (xalpha.value 1) ∈
      D.rootSubgroup alpha
    exact ((D.rootSubgroup alpha).pointEquiv (xalpha.value 1)).property
  have hualphaJoin : ualpha ∈ RootSubgroupGenerated D S ⊔ T.toSubgroup :=
    hle hualphaRoot
  have hnormal := torus_le_rootSubgroupGenerated_normalizer D hD S
  have hualphaProduct : ualpha ∈
      (RootSubgroupGenerated D S : Set (Variety.Point K)) *
        (T.toSubgroup : Set (Variety.Point K)) :=
    (Set.ext_iff.mp (Subgroup.coe_mul_of_right_le_normalizer_left
      (RootSubgroupGenerated D S) T.toSubgroup hnormal) ualpha).mp
        hualphaJoin
  rcases Set.mem_mul.mp hualphaProduct with
    ⟨g, hg, t0, ht0, hgt⟩
  have hgword : g ∈ closedSubgroupWordProduct D.rootSubgroup w := by
    rw [hword]
    exact hg
  obtain ⟨a, ha⟩ := exists_rootWordMorphism_eq_of_mem D hD w g hgword
  let t : Variety.Point T.carrierVariety := T.pointEquiv.symm ⟨t0, ht0⟩
  have ht : T.includePoint t = t0 := by
    change (T.pointEquiv t).val = t0
    simp [t]
  have htail : (rootWordWithTailMorphism D hD w t).toFun
      (affineSpacePoint fun i => a i.down) = ualpha := by
    rw [rootWordWithTailMorphism_apply, ha, ht, hgt]
  obtain ⟨F, hF⟩ :=
    oneParameterParametrization_exists_ambient_parameterPolynomial
      (D.rootSubgroup alpha) xalpha
  let q : Variety.PolynomialFunction
      (affineSpaceVariety k (ULift.{u} (Fin w.length))) :=
    Variety.PolynomialFunction.pullback
      (rootWordWithTailMorphism D hD w t) F
  obtain ⟨P, hP⟩ := q.representedBy
  let beta : ULift.{u} (Fin w.length) → TorusCharacter T.carrierVariety :=
    fun i => D.rootWeight (w.get i.down)
  let coefficients : ULift.{u} (Fin w.length) → k := fun i => a i.down
  have hcharacter : D.rootWeight alpha ∈
      Submonoid.closure (Set.range beta) := by
    apply affinePolynomial_character_mem_submonoidClosure hT beta coefficients P
      (D.rootWeight alpha)
    intro s
    let z : Variety.Point
        (affineSpaceVariety k (ULift.{u} (Fin w.length))) :=
      affineSpacePoint fun i =>
        (D.rootWeight (w.get i.down)).pointCharacter s * a i.down
    change evalPolynomial z.val P =
      (D.rootWeight alpha).pointCharacter s
    rw [← hP z]
    change F ((rootWordWithTailMorphism D hD w t).toFun z) =
      (D.rootWeight alpha).pointCharacter s
    rw [rootWordWithTailMorphism_scale hT D hD w a s t, htail]
    change F ((T.includePoint s)⁻¹ *
      (rootCurve D hD alpha).toFun (kPlusPoint (1 : k)) *
      T.includePoint s) = _
    rw [rootCurve_scale D hD alpha 1 s]
    change F ((D.rootSubgroup alpha).includePoint
      (xalpha.value ((D.rootWeight alpha).pointCharacter s * 1))) = _
    rw [hF]
    simp
  apply Submonoid.closure_mono _ hcharacter
  rintro chi ⟨i, rfl⟩
  have hmem : w.get i.down ∈ w := List.get_mem w i.down
  change w.get i.down ∈ w0.map Subtype.val at hmem
  rcases List.mem_map.mp hmem with ⟨gamma, _, hgamma⟩
  exact ⟨gamma.1, gamma.2, congrArg D.rootWeight hgamma⟩

end Theory.AlgebraicGroup
