module

public import Theory.AlgebraicGroup.ClosedSubgroup.Closure
public import Theory.AlgebraicGroup.ClosedSubgroup.Connected
public import Theory.AlgebraicGroup.RootSubgroups.CommutatorClosure

universe u v

/-!
  Zariski-closed root blocks.

  A root block is obtained by taking the Zariski closure of the abstract
  subgroup generated by the root groups indexed by a set of roots.  The
  construction itself is unconditional; the extra geometric assertions used
  in the component theorem (connectedness and simplicity) are deliberately
  not built into this definition.
-/

namespace Theory.AlgebraicGroup

open scoped commutatorElement

variable {k : Type u} [Field k]

@[expose]
public noncomputable def rootBlockSubgroup
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) (A : Set D.Root) : ClosedSubgroup G :=
  subgroupZariskiClosure G (RootSubgroupGenerated D A)

/-! Taking the identity component gives a canonical connected closed root
block.  The next lemmas record precisely what is retained by this operation.
-/

@[expose]
public noncomputable def connectedRootBlockSubgroup
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (A : Set D.Root) : ClosedSubgroup G :=
  (rootBlockSubgroup D A).identityComponentAmbient

public lemma connectedRootBlockSubgroup_isConnected
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (A : Set D.Root) :
    _root_.IsConnected
      (connectedRootBlockSubgroup D A : Set (Variety.Point G)) := by
  exact ClosedSubgroup.identityComponentAmbient_isConnected
    (rootBlockSubgroup D A)

public lemma connectedRootBlockSubgroup_le_rootBlockSubgroup
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (A : Set D.Root) :
    connectedRootBlockSubgroup D A ≤ rootBlockSubgroup D A := by
  exact ClosedSubgroup.identityComponentAmbient_le (rootBlockSubgroup D A)

public lemma rootSubgroupGenerated_le_rootBlockSubgroup
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) (A : Set D.Root) :
    RootSubgroupGenerated D A ≤ (rootBlockSubgroup D A).toSubgroup := by
  change RootSubgroupGenerated D A ≤
    closure (RootSubgroupGenerated D A : Set (Variety.Point G))
  exact subset_closure

/-! Basic functoriality and nontriviality of the closure construction. -/

public lemma rootBlockSubgroup_mono
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) {A B : Set D.Root} (hAB : A ⊆ B) :
    rootBlockSubgroup D A ≤ rootBlockSubgroup D B := by
  change closure (RootSubgroupGenerated D A : Set (Variety.Point G)) ⊆
    closure (RootSubgroupGenerated D B : Set (Variety.Point G))
  apply closure_mono
  exact (RootSubgroupGenerated_mono D hAB)

public lemma rootBlockSubgroup_eq_of_generated_eq
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) {A B : Set D.Root}
    (hAB : RootSubgroupGenerated D A = RootSubgroupGenerated D B) :
    rootBlockSubgroup D A = rootBlockSubgroup D B := by
  simp only [rootBlockSubgroup, hAB]

/-!
  A root-factor commutator condition is enough to make the generated block
  normal once the ambient group is generated by all root factors.  This is the
  precise closure-level bridge needed before taking Zariski closures; no
  simplicity or component decomposition is assumed.
-/

public lemma rootSubgroupGenerated_isNormal_of_rootFactor_commutators
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) (A : Set D.Root)
    (hgen : RootSubgroupGenerated D (Set.univ : Set D.Root) =
      (⊤ : Subgroup (Variety.Point G)))
    (hstable : ∀ β, ∀ α ∈ A, ∀ x, x ∈ D.rootSubgroup β →
      ∀ y, y ∈ D.rootSubgroup α →
        ⁅x, y⁆ ∈ RootSubgroupGenerated D A) :
    (RootSubgroupGenerated D A).Normal := by
  let N : Subgroup (Variety.Point G) := RootSubgroupGenerated D A
  have hforward : ∀ β, ∀ x, x ∈ D.rootSubgroup β →
      ∀ y, y ∈ N → x * y * x⁻¹ ∈ N := by
    intro β x hx y hy
    apply Subgroup.closure_induction (p := fun z _ =>
      x * z * x⁻¹ ∈ N) ?_ ?_ ?_ ?_ hy
    · intro z hz
      simp only [Set.mem_iUnion] at hz
      obtain ⟨α, hα, hz⟩ := hz
      have hcomm := hstable β α hα x hx z hz
      have hgenmem : z ∈
          (⋃ α : D.Root, ⋃ (_ : α ∈ A),
            (D.rootSubgroup α : Set (Variety.Point G))) := by
        exact Set.mem_iUnion.mpr ⟨α, Set.mem_iUnion.mpr ⟨hα, hz⟩⟩
      have hmem : ⁅x, z⁆ * z ∈ N := N.mul_mem hcomm
        (Subgroup.subset_closure hgenmem)
      simpa [commutatorElement_def, mul_assoc] using hmem
    · simp
    · intro z w hz hw hconjz hconjw
      have hzw : x * (z * w) * x⁻¹ =
          (x * z * x⁻¹) * (x * w * x⁻¹) := by group
      rw [hzw]
      exact N.mul_mem hconjz hconjw
    · intro z hz hconj
      have hinv : x * z⁻¹ * x⁻¹ = (x * z * x⁻¹)⁻¹ := by group
      rw [hinv]
      exact N.inv_mem hconj
  have hnormalizer :
      RootSubgroupGenerated D (Set.univ : Set D.Root) ≤
        Subgroup.normalizer (N : Set (Variety.Point G)) := by
    rw [RootSubgroupGenerated_le_iff]
    intro β hβ x hx
    rw [Subgroup.mem_normalizer_iff]
    intro y
    constructor
    · exact hforward β x hx y
    · intro hconj
      have hback := hforward β x⁻¹
        ((D.rootSubgroup β).toSubgroup.inv_mem hx) (x * y * x⁻¹) hconj
      simpa [mul_assoc] using hback
  rw [hgen] at hnormalizer
  exact (Subgroup.normalizer_eq_top_iff.mp (top_unique hnormalizer))

public lemma rootBlockSubgroup_isNormal_of_generated_isNormal
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) (A : Set D.Root)
    (hA : (RootSubgroupGenerated D A).Normal) :
    (rootBlockSubgroup D A).toSubgroup.Normal := by
  exact subgroupZariskiClosure_isNormal G (RootSubgroupGenerated D A) hA

public lemma connectedRootBlockSubgroup_normal_of_generated_isNormal
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (A : Set D.Root)
    (hA : (RootSubgroupGenerated D A).Normal) :
    (connectedRootBlockSubgroup D A).toSubgroup.Normal := by
  exact ClosedSubgroup.identityComponentAmbient_normal_of_normal
    (rootBlockSubgroup D A)
    (rootBlockSubgroup_isNormal_of_generated_isNormal D A hA)

public lemma rootBlockSubgroup_isNormal_of_rootFactor_commutators
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) (A : Set D.Root)
    (hgen : RootSubgroupGenerated D (Set.univ : Set D.Root) =
      (⊤ : Subgroup (Variety.Point G)))
    (hstable : ∀ β, ∀ α ∈ A, ∀ x, x ∈ D.rootSubgroup β →
      ∀ y, y ∈ D.rootSubgroup α →
        ⁅x, y⁆ ∈ RootSubgroupGenerated D A) :
    (rootBlockSubgroup D A).toSubgroup.Normal := by
  exact rootBlockSubgroup_isNormal_of_generated_isNormal D A
    (rootSubgroupGenerated_isNormal_of_rootFactor_commutators D A hgen hstable)

public lemma connectedRootBlockSubgroup_normal_of_rootFactor_commutators
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (A : Set D.Root)
    (hgen : RootSubgroupGenerated D (Set.univ : Set D.Root) =
      (⊤ : Subgroup (Variety.Point G)))
    (hstable : ∀ β, ∀ α ∈ A, ∀ x, x ∈ D.rootSubgroup β →
      ∀ y, y ∈ D.rootSubgroup α →
        ⁅x, y⁆ ∈ RootSubgroupGenerated D A) :
    (connectedRootBlockSubgroup D A).toSubgroup.Normal := by
  exact connectedRootBlockSubgroup_normal_of_generated_isNormal D A
    (rootSubgroupGenerated_isNormal_of_rootFactor_commutators D A hgen hstable)

public lemma rootSubgroup_le_connectedRootBlockSubgroup_of_isRealization
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (hD : D.IsRealization)
    (A : Set D.Root) {α : D.Root} (hα : α ∈ A) :
    (D.rootSubgroup α).toSubgroup ≤
      (connectedRootBlockSubgroup D A).toSubgroup := by
  have hroot : (D.rootSubgroup α).toSubgroup ≤
      (rootBlockSubgroup D A).toSubgroup :=
    (rootSubgroup_le_RootSubgroupGenerated D hα).trans
      (rootSubgroupGenerated_le_rootBlockSubgroup D A)
  apply connected_closedSubgroup_le_identityComponentAmbient
    (D.rootSubgroup α) (rootBlockSubgroup D A)
  · have hconn : Variety.IsConnected
        (D.rootSubgroup α).carrierVariety := (hD.2.2.1 α).1.2.isConnected
    let : ConnectedSpace (Variety.Point (D.rootSubgroup α).carrierVariety) :=
      connectedSpace_iff_univ.mpr hconn
    change _root_.IsConnected
      ((D.rootSubgroup α).toSubgroup : Set (Variety.Point G))
    rw [← (D.rootSubgroup α).range_inclusion]
    exact isConnected_range (D.rootSubgroup α).inclusion.toVariety.continuous
  · exact hroot

public lemma rootSubgroupGenerated_le_connectedRootBlockSubgroup_of_isRealization
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (hD : D.IsRealization)
    (A : Set D.Root) :
    RootSubgroupGenerated D A ≤
      (connectedRootBlockSubgroup D A).toSubgroup := by
  apply RootSubgroupGenerated_le_of_rootSubgroup_le D A
  intro α hα
  exact rootSubgroup_le_connectedRootBlockSubgroup_of_isRealization D hD A hα

public lemma connectedRootBlockSubgroup_ne_bot_of_nonempty
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (hD : D.IsRealization)
    {A : Set D.Root} (hA : A.Nonempty) :
    (connectedRootBlockSubgroup D A).toSubgroup ≠ ⊥ := by
  obtain ⟨α, hα⟩ := hA
  intro hbot
  have hroot := rootSubgroup_le_connectedRootBlockSubgroup_of_isRealization
    D hD A hα
  have hrootbot : (D.rootSubgroup α).toSubgroup ≤ ⊥ := by
    rw [hbot] at hroot
    exact hroot
  exact (IsTorusRootSubgroup.invariant_unipotent_ne_bot (hD.2.2.1 α).1).2.2
    (bot_unique hrootbot)

public lemma rootBlockSubgroup_eq_connectedRootBlockSubgroup_of_generated_isConnected
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (A : Set D.Root)
    (hconn : _root_.IsConnected
      (RootSubgroupGenerated D A : Set (Variety.Point G))) :
    rootBlockSubgroup D A = connectedRootBlockSubgroup D A := by
  apply SetLike.coe_injective
  apply Set.Subset.antisymm
  · apply connected_closedSubgroup_le_identityComponentAmbient
      (rootBlockSubgroup D A) (rootBlockSubgroup D A)
    · change _root_.IsConnected
        (closure (RootSubgroupGenerated D A : Set (Variety.Point G)))
      exact hconn.closure
    · intro x hx
      exact hx
  · exact connectedRootBlockSubgroup_le_rootBlockSubgroup D A

private lemma subgroupZariskiClosure_bot
    {G : Variety k} [AlgebraicGroup G] :
    subgroupZariskiClosure G (⊥ : Subgroup (Variety.Point G)) =
      ClosedSubgroup.bot := by
  apply SetLike.coe_injective
  ext x
  change x ∈ closure ((⊥ : Subgroup (Variety.Point G)) :
      Set (Variety.Point G)) ↔ x ∈ (⊥ : Subgroup (Variety.Point G))
  rw [show ((⊥ : Subgroup (Variety.Point G)) : Set (Variety.Point G)) =
      ({(1 : Variety.Point G)} : Set (Variety.Point G)) by
        ext y
        simp]
  have hclosed : IsClosed ({(1 : Variety.Point G)} : Set (Variety.Point G)) := by
    rw [Variety.isClosed_iff_isZariskiClosed]
    exact isZariskiClosed_singleton G (1 : Variety.Point G)
  rw [closure_eq_iff_isClosed.mpr hclosed]
  simp

public lemma rootBlockSubgroup_bot
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) :
    rootBlockSubgroup D (∅ : Set D.Root) = ClosedSubgroup.bot := by
  rw [rootBlockSubgroup, RootSubgroupGenerated_empty]
  exact subgroupZariskiClosure_bot

public lemma rootBlockSubgroup_commutator_eq_bot_of_rootFactor_commute
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) (A B : Set D.Root)
    (hpair : ∀ α ∈ A, ∀ β ∈ B, ∀ x, x ∈ D.rootSubgroup α →
      ∀ y, y ∈ D.rootSubgroup β → Commute x y) :
    ⁅(rootBlockSubgroup D A).toSubgroup,
      (rootBlockSubgroup D B).toSubgroup⁆ = ⊥ := by
  have hpair' : ∀ α ∈ A, ∀ β ∈ B, ∀ x, x ∈ D.rootSubgroup α →
      ∀ y, y ∈ D.rootSubgroup β → ⁅x, y⁆ ∈ (⊥ : Subgroup (Variety.Point G)) := by
    intro α hα β hβ x hx y hy
    rw [Subgroup.mem_bot]
    exact (commutatorElement_eq_one_iff_commute.mpr (hpair α hα β hβ x hx y hy))
  have hgen : ⁅RootSubgroupGenerated D A, RootSubgroupGenerated D B⁆ =
      (⊥ : Subgroup (Variety.Point G)) := by
    apply le_antisymm
    · exact rootSubgroupGenerated_commutator_le_of_rootFactor_commutators
        D A B ⊥ hpair'
    · exact bot_le
  apply le_antisymm
  · calc
      ⁅(rootBlockSubgroup D A).toSubgroup,
          (rootBlockSubgroup D B).toSubgroup⁆ ≤
          (subgroupZariskiClosure G
            ⁅RootSubgroupGenerated D A, RootSubgroupGenerated D B⁆).toSubgroup :=
        commutator_subgroupZariskiClosure_le_two G
          (RootSubgroupGenerated D A) (RootSubgroupGenerated D B)
      _ = (subgroupZariskiClosure G (⊥ : Subgroup (Variety.Point G))).toSubgroup := by
        rw [hgen]
      _ = (ClosedSubgroup.bot (G := G)).toSubgroup := by
        rw [subgroupZariskiClosure_bot]
      _ = ⊥ := by rfl
  · exact bot_le

public lemma connectedRootBlockSubgroup_commutator_eq_bot_of_rootFactor_commute
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (A B : Set D.Root)
    (hpair : ∀ α ∈ A, ∀ β ∈ B, ∀ x, x ∈ D.rootSubgroup α →
      ∀ y, y ∈ D.rootSubgroup β → Commute x y) :
    ⁅(connectedRootBlockSubgroup D A).toSubgroup,
      (connectedRootBlockSubgroup D B).toSubgroup⁆ = ⊥ := by
  apply le_antisymm
  · exact (Subgroup.commutator_mono
      (connectedRootBlockSubgroup_le_rootBlockSubgroup D A)
      (connectedRootBlockSubgroup_le_rootBlockSubgroup D B)).trans_eq
      (rootBlockSubgroup_commutator_eq_bot_of_rootFactor_commute D A B hpair)
  · exact bot_le

public lemma connectedRootBlockSubgroup_iSup_eq_top_of_root_cover
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (hD : D.IsRealization)
    {ι : Type v} (A : ι → Set D.Root)
    (hcover : ⋃ i, A i = Set.univ)
    (hgen : RootSubgroupGenerated D (Set.univ : Set D.Root) =
      (⊤ : Subgroup (Variety.Point G))) :
    (⨆ i, (connectedRootBlockSubgroup D (A i)).toSubgroup) = ⊤ := by
  have hroot : RootSubgroupGenerated D (Set.univ : Set D.Root) ≤
      ⨆ i, (connectedRootBlockSubgroup D (A i)).toSubgroup := by
    rw [RootSubgroupGenerated_le_iff]
    intro α hα
    have hα' : α ∈ ⋃ i, A i := by rw [hcover]; exact hα
    obtain ⟨i, hAi⟩ := Set.mem_iUnion.mp hα'
    exact (rootSubgroup_le_connectedRootBlockSubgroup_of_isRealization
      D hD (A i) hAi).trans (le_iSup (fun j =>
        (connectedRootBlockSubgroup D (A j)).toSubgroup) i)
  rw [hgen] at hroot
  exact top_unique hroot

public lemma rootBlockSubgroup_eq_top_of_generated_eq_top
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) (A : Set D.Root)
    (hA : RootSubgroupGenerated D A = ⊤) :
    rootBlockSubgroup D A = ClosedSubgroup.top := by
  apply SetLike.coe_injective
  ext x
  change x ∈ closure (RootSubgroupGenerated D A : Set (Variety.Point G)) ↔
    x ∈ (⊤ : Subgroup (Variety.Point G))
  rw [hA]
  simp

public lemma connectedRootBlockSubgroup_eq_top_of_generated_eq_top_of_connected
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    [IsAlgClosed k] (D : RootGroupData G T) (A : Set D.Root)
    (hA : RootSubgroupGenerated D A =
      (⊤ : Subgroup (Variety.Point G)))
    (hconn : _root_.IsConnected
      (RootSubgroupGenerated D A : Set (Variety.Point G))) :
    connectedRootBlockSubgroup D A = ClosedSubgroup.top := by
  rw [← rootBlockSubgroup_eq_top_of_generated_eq_top D A hA]
  exact (rootBlockSubgroup_eq_connectedRootBlockSubgroup_of_generated_isConnected
    D A hconn).symm

end Theory.AlgebraicGroup
