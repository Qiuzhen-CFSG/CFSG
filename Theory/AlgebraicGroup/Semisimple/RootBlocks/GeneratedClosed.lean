module

public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.Reductive.Defs
public import Theory.AlgebraicGroup.RootData.Realization
public import Theory.AlgebraicGroup.RootSystems.Defs
public import Theory.AlgebraicGroup.Semisimple.RootBlocks

universe u

/-!
Finite root-subgroup products and closed generated root blocks.

A finite set of roots in a realized root-group datum indexes a finite family of
connected closed one-parameter subgroups.  The finite connected-generation
theorem therefore writes their abstractly generated subgroup as one finite
word product and proves that subgroup Zariski closed.  Specializing along the
root bijection of an actual reduced crystallographic root pairing gives the
closedness statement for every irreducible part of an orthogonal
decomposition.

Only finiteness of the chosen roots and the one-parameter clause of the
realization are needed for the geometric argument.  The final specialization
retains the reductive, maximal-torus, actual-pairing, and irreducible-part
hypotheses used by the root-block component development.  In particular, it
does not identify the generated subgroup with `connectedRootBlockSubgroup`.

This is the finite-word geometric step used in the proof of GLS3, Theorem
1.10.1(b), established independently of that theorem.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

private lemma realizedRootSubgroup_isConnected
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    {D : RootGroupData K T} (hD : D.IsRealization) (alpha : D.Root) :
    _root_.IsConnected
      (D.rootSubgroup alpha : Set (Variety.Point K)) := by
  have hconn : Variety.IsConnected
      (D.rootSubgroup alpha).carrierVariety :=
    (hD.2.2.1 alpha).1.2.isConnected
  let : ConnectedSpace
      (Variety.Point (D.rootSubgroup alpha).carrierVariety) :=
    connectedSpace_iff_univ.mpr hconn
  change _root_.IsConnected
    ((D.rootSubgroup alpha).toSubgroup : Set (Variety.Point K))
  rw [← (D.rootSubgroup alpha).range_inclusion]
  exact isConnected_range
    (D.rootSubgroup alpha).inclusion.toVariety.continuous

/-- A finite set of realized roots generates its abstract subgroup after one
finite word of root-subgroup factors. -/
public theorem exists_rootSubgroupWordProduct_eq_generated_of_finite
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization)
    (A : Set D.Root) [Fintype A] :
    ∃ w : List A,
      closedSubgroupWordProduct
          (fun alpha : A => D.rootSubgroup alpha.1) w =
        (RootSubgroupGenerated D A : Set (Variety.Point K)) := by
  let H : A → ClosedSubgroup K :=
    fun alpha => D.rootSubgroup alpha.1
  have hconnected : ∀ alpha,
      _root_.IsConnected (H alpha : Set (Variety.Point K)) := by
    intro alpha
    exact realizedRootSubgroup_isConnected hD alpha.1
  obtain ⟨w, hw⟩ :=
    exists_closedSubgroupWordProduct_eq_closure_iUnion H hconnected
  refine ⟨w, ?_⟩
  rw [RootSubgroupGenerated]
  change closedSubgroupWordProduct H w = _
  rw [hw]
  rw [show (⋃ alpha : A, (H alpha : Set (Variety.Point K))) =
      ⋃ alpha ∈ A,
        (D.rootSubgroup alpha : Set (Variety.Point K)) by
    change (⋃ alpha : A,
      (D.rootSubgroup alpha.1 : Set (Variety.Point K))) = _
    exact Set.iUnion_subtype (fun alpha : D.Root => alpha ∈ A)
      (fun alpha => (D.rootSubgroup alpha.1 : Set (Variety.Point K)))]

/-- The abstract subgroup generated by finitely many realized root subgroups
is Zariski closed. -/
public theorem rootSubgroupGenerated_isZariskiClosed_of_finite
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (hD : D.IsRealization)
    (A : Set D.Root) [Fintype A] :
    IsZariskiClosed K
      (RootSubgroupGenerated D A : Set (Variety.Point K)) := by
  let H : A → ClosedSubgroup K :=
    fun alpha => D.rootSubgroup alpha.1
  have hconnected : ∀ alpha,
      _root_.IsConnected (H alpha : Set (Variety.Point K)) := by
    intro alpha
    exact realizedRootSubgroup_isConnected hD alpha.1
  have hclosed :=
    closure_iUnion_connected_closedSubgroup_isZariskiClosed H hconnected
  rw [RootSubgroupGenerated]
  have hunion : (⋃ alpha : A,
      (D.rootSubgroup alpha.1 : Set (Variety.Point K))) =
      ⋃ alpha ∈ A,
        (D.rootSubgroup alpha : Set (Variety.Point K)) :=
    Set.iUnion_subtype (fun alpha : D.Root => alpha ∈ A)
      (fun alpha => (D.rootSubgroup alpha.1 : Set (Variety.Point K)))
  rw [← hunion]
  exact hclosed

/-- An irreducible orthogonal root block generates a Zariski-closed abstract
subgroup.  The root-system hypotheses identify the finite set as an actual
root block; closedness itself follows from finite connected generation. -/
public theorem rootSubgroupGenerated_isZariskiClosed_of_irreduciblePart
    {K : Variety k} [AlgebraicGroup K]
    (_hK : IsReductiveAlgebraicGroup K)
    (T : ClosedSubgroup K) (_hT : IsMaximalTorus T)
    (D : RootGroupData K T) (hD : D.IsRealization)
    {iota M N : Type u} [Fintype iota]
    [AddCommGroup M] [Module ℝ M] [AddCommGroup N] [Module ℝ N]
    (P : RootPairing iota ℝ M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (base : P.Base) (e : D.Root ≃ iota)
    (_hActual : IsActualBasedRootPairing D P base e)
    (d : P.OrthogonalDecomposition) (hd : d.IsIrreducible)
    {s : Set iota} (hs : s ∈ d.parts) :
    IsZariskiClosed K
      (RootSubgroupGenerated D (e.symm '' s) :
        Set (Variety.Point K)) := by
  have _hirreducible : P.IsIrreducibleSet s := hd s hs
  let _ : Fintype D.Root := Fintype.ofEquiv iota e.symm
  let _ : Fintype (e.symm '' s) := Fintype.ofFinite (e.symm '' s)
  exact rootSubgroupGenerated_isZariskiClosed_of_finite
    D hD (e.symm '' s)

end Theory.AlgebraicGroup
