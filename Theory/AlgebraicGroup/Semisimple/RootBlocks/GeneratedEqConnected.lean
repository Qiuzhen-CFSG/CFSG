module

public import Theory.AlgebraicGroup.Semisimple.RootBlocks.GeneratedClosed

universe u

/-!
Identification of an irreducible generated root block with its connected
closed root block.

The realized root groups lie in the identity component of their Zariski-closed
root block, so their abstractly generated subgroup lies there as well.  In the
reverse direction, finite connected generation makes the subgroup attached to
an irreducible part Zariski closed.  Its Zariski closure is consequently itself,
and the identity component of that closure is contained in it.  These two
inclusions give the required equality.

The closedness input is the finite-word algebraic-group argument in
`RootBlocks.GeneratedClosed`; the root-block formulation follows GLS3,
Theorem 1.10.1(b).
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- The abstract subgroup generated by an irreducible orthogonal root block is
exactly the point subgroup of its connected closed root block. -/
public theorem rootSubgroupGenerated_eq_connectedRootBlockSubgroup_of_irreduciblePart
    {K : Variety k} [AlgebraicGroup K] (hK : IsReductiveAlgebraicGroup K)
    (T : ClosedSubgroup K) (hT : IsMaximalTorus T)
    (D : RootGroupData K T) (hD : D.IsRealization)
    {iota M N : Type u} [Fintype iota]
    [AddCommGroup M] [Module ℝ M] [AddCommGroup N] [Module ℝ N]
    (P : RootPairing iota ℝ M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (base : P.Base) (e : D.Root ≃ iota)
    (hActual : IsActualBasedRootPairing D P base e)
    (d : P.OrthogonalDecomposition) (hd : d.IsIrreducible)
    {s : Set iota} (hs : s ∈ d.parts) :
    RootSubgroupGenerated D (e.symm '' s) =
      (connectedRootBlockSubgroup D (e.symm '' s)).toSubgroup := by
  apply le_antisymm
  · exact rootSubgroupGenerated_le_connectedRootBlockSubgroup_of_isRealization
      D hD (e.symm '' s)
  · refine (connectedRootBlockSubgroup_le_rootBlockSubgroup
      D (e.symm '' s)).trans ?_
    change closure
      (RootSubgroupGenerated D (e.symm '' s) : Set (Variety.Point K)) ⊆
        RootSubgroupGenerated D (e.symm '' s)
    rw [closure_eq_iff_isClosed.mpr
      (Variety.isClosed_iff_isZariskiClosed.mpr
        (rootSubgroupGenerated_isZariskiClosed_of_irreduciblePart
          hK T hT D hD P base e hActual d hd hs))]

end Theory.AlgebraicGroup
