module

public import Theory.AlgebraicGroup.RootSubgroups.Conjugation
public import Theory.AlgebraicGroup.RootSubgroups.TangentLie
public import Theory.AlgebraicGroup.RootSubgroups.TorusGeneratedNormalizer
public import Theory.AlgebraicGroup.Semisimple.RootBlocks.GeneratedEqConnected

/-!
# Characteristic-free tangent closure of a root block

The ordinary Lie subalgebra generated by root-subgroup tangents need not be the
full tangent Lie algebra of the connected root block.  In characteristic two,
the two root tangents of the standard block in `PGL_2` bracket to zero in
`gl_2 / kI`, leaving the third tangent direction outside their Lie span.

`rootBlockTangentClosure` is the characteristic-free replacement used by the
root-block decomposition campaign: it is the smallest ambient tangent Lie
subalgebra containing every selected root-subgroup tangent and stable under
both the selected root-generated subgroup and the ambient torus.  Its ordinary
Lie span is contained in it.  For an irreducible orthogonal part, the principal
theorem proves that this closure is contained in the tangent of the exact
`connectedRootBlockSubgroup`; no inseparable differential-surjectivity claim
is made.

The proof realizes the closure as an infimum.  The connected block tangent is
a candidate: root inclusions factor through the block, inner conjugation
preserves its tangent range by functoriality of identity differentials, and
ambient-torus conjugation restricts to the block using the torus-invariance
corollary proved from root-subgroup generation and normalization.  This uses
the established root-block equality underlying GLS3 Theorem 1.10.1(b), but no
unresolved source-numbered theorem.
-/

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

omit [IsAlgClosed k] in
private theorem identityTangentMorphismLinearMap_comp'
    {G H K : Variety k} [AlgebraicGroup G] [AlgebraicGroup H]
    [AlgebraicGroup K]
    (f : AlgebraicGroup.Morphism G H)
    (g : AlgebraicGroup.Morphism H K) :
    identityTangentMorphismLinearMap (g.comp f) =
      (identityTangentMorphismLinearMap g).comp
        (identityTangentMorphismLinearMap f) := by
  ext D a
  rfl

omit [IsAlgClosed k] in
private theorem identityTangentMorphismLinearMap_conjugation_naturality'
    {G H : Variety k} [AlgebraicGroup G] [AlgebraicGroup H]
    (f : AlgebraicGroup.Morphism G H) (g : Variety.Point G) :
    (identityTangentMorphismLinearMap f).comp
        ((identityTangentRepresentation G).action g).1 =
      ((identityTangentRepresentation H).action (f.onPoints g)).1.comp
        (identityTangentMorphismLinearMap f) := by
  ext D a
  change
    (((identityTangentRepresentation G).action g).1 D)
        (f.toVariety.pullbackAlgHom a) =
      (((identityTangentRepresentation H).action (f.onPoints g)).1
        (identityTangentMorphismLinearMap f D)) a
  rw [identityTangentRepresentation_action_apply,
    identityTangentRepresentation_action_apply]
  apply congrArg D
  apply Variety.PolynomialFunction.ext
  intro x
  change a (f.onPoints (g * x * g⁻¹)) =
    a (f.onPoints g * f.onPoints x * (f.onPoints g)⁻¹)
  simp only [f.onPoints.map_mul, f.onPoints.map_inv]

@[expose] public def IsRootBlockTangentClosureCandidate
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root)
    (W : LieSubalgebra k (IdentityPointDerivation K)) : Prop :=
  (∀ alpha, alpha ∈ A →
      (identityTangentMorphismLieHom
        (D.rootSubgroup alpha).inclusion).range ≤ W) ∧
    (∀ g, g ∈ RootSubgroupGenerated D A →
      ∀ v, v ∈ W →
        ((identityTangentRepresentation K).action g).1 v ∈ W) ∧
    (∀ t, t ∈ T.toSubgroup →
      ∀ v, v ∈ W →
        ((identityTangentRepresentation K).action t).1 v ∈ W)

public noncomputable def rootBlockTangentClosure
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root) :
    LieSubalgebra k (IdentityPointDerivation K) :=
  sInf {W | IsRootBlockTangentClosureCandidate D A W}

@[expose] public def rootBlockTangentGeneratorSet
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root) :
    Set (IdentityPointDerivation K) :=
  {v | ∃ alpha, alpha ∈ A ∧
    v ∈ (identityTangentMorphismLieHom
      (D.rootSubgroup alpha).inclusion).range}

public noncomputable def rootBlockTangentLieSpan
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root) :
    LieSubalgebra k (IdentityPointDerivation K) :=
  LieSubalgebra.lieSpan k (IdentityPointDerivation K)
    (rootBlockTangentGeneratorSet D A)

omit [IsAlgClosed k] in
public theorem rootBlockTangentClosure_le
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root)
    {W : LieSubalgebra k (IdentityPointDerivation K)}
    (hW : IsRootBlockTangentClosureCandidate D A W) :
    rootBlockTangentClosure D A ≤ W :=
  sInf_le hW

omit [IsAlgClosed k] in
public theorem rootTangent_le_rootBlockTangentClosure
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root)
    (alpha : D.Root) (halpha : alpha ∈ A) :
    (identityTangentMorphismLieHom
      (D.rootSubgroup alpha).inclusion).range ≤
        rootBlockTangentClosure D A := by
  apply le_sInf
  intro W hW
  exact hW.1 alpha halpha

omit [IsAlgClosed k] in
public theorem rootBlockTangentClosure_rootSubgroupGenerated_invariant
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root)
    (g : Variety.Point K) (hg : g ∈ RootSubgroupGenerated D A)
    {v : IdentityPointDerivation K} (hv : v ∈ rootBlockTangentClosure D A) :
    ((identityTangentRepresentation K).action g).1 v ∈
      rootBlockTangentClosure D A := by
  have hmem :
      ((identityTangentRepresentation K).action g).1 v ∈
        ⋂ W ∈ {W | IsRootBlockTangentClosureCandidate D A W},
          (W : Set (IdentityPointDerivation K)) := by
    simp only [Set.mem_iInter]
    intro W hW
    exact hW.2.1 g hg v (rootBlockTangentClosure_le D A hW hv)
  rw [← LieSubalgebra.coe_sInf] at hmem
  exact hmem

omit [IsAlgClosed k] in
public theorem rootBlockTangentClosure_torus_invariant
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root)
    (t : Variety.Point K) (ht : t ∈ T.toSubgroup)
    {v : IdentityPointDerivation K} (hv : v ∈ rootBlockTangentClosure D A) :
    ((identityTangentRepresentation K).action t).1 v ∈
      rootBlockTangentClosure D A := by
  have hmem :
      ((identityTangentRepresentation K).action t).1 v ∈
        ⋂ W ∈ {W | IsRootBlockTangentClosureCandidate D A W},
          (W : Set (IdentityPointDerivation K)) := by
    simp only [Set.mem_iInter]
    intro W hW
    exact hW.2.2 t ht v (rootBlockTangentClosure_le D A hW hv)
  rw [← LieSubalgebra.coe_sInf] at hmem
  exact hmem

omit [IsAlgClosed k] in
public theorem rootBlockTangentClosure_isCandidate
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root) :
    IsRootBlockTangentClosureCandidate D A
      (rootBlockTangentClosure D A) := by
  refine ⟨?_, ?_, ?_⟩
  · intro alpha halpha
    exact rootTangent_le_rootBlockTangentClosure D A alpha halpha
  · intro g hg v hv
    exact rootBlockTangentClosure_rootSubgroupGenerated_invariant
      D A g hg hv
  · intro t ht v hv
    exact rootBlockTangentClosure_torus_invariant D A t ht hv

omit [IsAlgClosed k] in
public theorem rootBlockTangentLieSpan_le_rootBlockTangentClosure
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (A : Set D.Root) :
    rootBlockTangentLieSpan D A ≤ rootBlockTangentClosure D A := by
  rw [rootBlockTangentLieSpan, LieSubalgebra.lieSpan_le]
  rintro v ⟨alpha, halpha, hv⟩
  exact rootTangent_le_rootBlockTangentClosure D A alpha halpha hv

omit [IsAlgClosed k] in
private theorem rootTangent_le_closedSubgroupTangent
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    (A : Set D.Root) (H : ClosedSubgroup K)
    (hroot : ∀ alpha, alpha ∈ A → D.rootSubgroup alpha ≤ H)
    (alpha : D.Root) (halpha : alpha ∈ A) :
    (identityTangentMorphismLieHom
      (D.rootSubgroup alpha).inclusion).range ≤
        (identityTangentMorphismLieHom H.inclusion).range := by
  intro v hv
  rcases hv with ⟨v, rfl⟩
  let j := (D.rootSubgroup alpha).inclusion.codRestrictClosedSubgroup H
    (fun x => hroot alpha halpha
      ((D.rootSubgroup alpha).pointEquiv x).property)
  refine ⟨identityTangentMorphismLinearMap j v, ?_⟩
  change identityTangentMorphismLinearMap H.inclusion
      (identityTangentMorphismLinearMap j v) =
    identityTangentMorphismLinearMap (D.rootSubgroup alpha).inclusion v
  rw [← LinearMap.comp_apply,
    ← identityTangentMorphismLinearMap_comp']
  congr 1

omit [IsAlgClosed k] in
private theorem closedSubgroupTangent_self_invariant
    {K : Variety k} [AlgebraicGroup K] (H : ClosedSubgroup K)
    (g : Variety.Point K) (hg : g ∈ H.toSubgroup)
    {v : IdentityPointDerivation K}
    (hv : v ∈ (identityTangentMorphismLieHom H.inclusion).range) :
    ((identityTangentRepresentation K).action g).1 v ∈
      (identityTangentMorphismLieHom H.inclusion).range := by
  rcases hv with ⟨v, rfl⟩
  let gH : Variety.Point H.carrierVariety := H.pointEquiv.symm ⟨g, hg⟩
  refine ⟨((identityTangentRepresentation H.carrierVariety).action gH).1 v, ?_⟩
  change identityTangentMorphismLinearMap H.inclusion
      (((identityTangentRepresentation H.carrierVariety).action gH).1 v) =
    ((identityTangentRepresentation K).action g).1
      (identityTangentMorphismLinearMap H.inclusion v)
  have hgH : H.inclusion.onPoints gH = g :=
    congrArg Subtype.val (H.pointEquiv.apply_symm_apply ⟨g, hg⟩)
  have h := LinearMap.congr_fun
    (identityTangentMorphismLinearMap_conjugation_naturality'
      H.inclusion gH) v
  change identityTangentMorphismLinearMap H.inclusion
      (((identityTangentRepresentation H.carrierVariety).action gH).1 v) =
    ((identityTangentRepresentation K).action
      (H.inclusion.onPoints gH)).1
        (identityTangentMorphismLinearMap H.inclusion v) at h
  rw [hgH] at h
  exact h

omit [IsAlgClosed k] in
private theorem closedSubgroupTangent_torus_invariant
    {K : Variety k} [AlgebraicGroup K] (T H : ClosedSubgroup K)
    (hInv : IsClosedSubgroupInvariant T H)
    (t : Variety.Point K) (ht : t ∈ T.toSubgroup)
    {v : IdentityPointDerivation K}
    (hv : v ∈ (identityTangentMorphismLieHom H.inclusion).range) :
    ((identityTangentRepresentation K).action t).1 v ∈
      (identityTangentMorphismLieHom H.inclusion).range := by
  rcases hv with ⟨v, rfl⟩
  let tInv : Variety.Point T.carrierVariety :=
    T.pointEquiv.symm ⟨t⁻¹, T.toSubgroup.inv_mem ht⟩
  let c := (rootConjugationIso T H hInv tInv).hom
  let cAmbient : AlgebraicGroup.Morphism K K :=
    { toVariety := AlgebraicGroup.conjugationByMorphism K t
      map_one := by
        rw [AlgebraicGroup.conjugationByMorphism_apply]
        group
      map_mul := by
        intro x y
        simp only [AlgebraicGroup.conjugationByMorphism_apply]
        group }
  refine ⟨identityTangentMorphismLinearMap c v, ?_⟩
  change identityTangentMorphismLinearMap H.inclusion
      (identityTangentMorphismLinearMap c v) =
    ((identityTangentRepresentation K).action t).1
      (identityTangentMorphismLinearMap H.inclusion v)
  rw [← LinearMap.comp_apply,
    ← identityTangentMorphismLinearMap_comp']
  have htInv : T.includePoint tInv = t⁻¹ :=
    congrArg Subtype.val
      (T.pointEquiv.apply_symm_apply
        ⟨t⁻¹, T.toSubgroup.inv_mem ht⟩)
  have hcomp :
      H.inclusion.comp c =
        cAmbient.comp H.inclusion := by
    apply AlgebraicGroup.Morphism.ext
    funext x
    change H.inclusion.onPoints (c.onPoints x) =
      cAmbient.onPoints (H.inclusion.onPoints x)
    rw [rootConjugationIso_inclusion_apply]
    change (T.includePoint tInv)⁻¹ * H.inclusion.onPoints x *
        T.includePoint tInv =
      t * H.inclusion.onPoints x * t⁻¹
    rw [htInv, inv_inv]
  rw [hcomp, identityTangentMorphismLinearMap_comp']
  apply Derivation.ext
  intro a
  rw [identityTangentRepresentation_action_apply]
  rfl

public theorem connectedRootBlockSubgroup_isInvariant_of_irreduciblePart
    {K : Variety k} [AlgebraicGroup K] (hK : IsReductiveAlgebraicGroup K)
    (T : ClosedSubgroup K) (hT : IsMaximalTorus T)
    (D : RootGroupData K T) (hD : D.IsRealization)
    {iota M N : Type u} [Fintype iota]
    [AddCommGroup M] [Module ℝ M] [AddCommGroup N] [Module ℝ N]
    (P : RootPairing iota ℝ M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (base : P.Base) (e : D.Root ≃ iota)
    (hActual : IsActualBasedRootPairing D P base e)
    (d : P.OrthogonalDecomposition) (hd : d.IsIrreducible)
    {s : Set iota} (hs : s ∈ d.parts) :
    IsClosedSubgroupInvariant T
      (connectedRootBlockSubgroup D (e.symm '' s)) := by
  let H := connectedRootBlockSubgroup D (e.symm '' s)
  have hgenerated : RootSubgroupGenerated D (e.symm '' s) = H.toSubgroup :=
    rootSubgroupGenerated_eq_connectedRootBlockSubgroup_of_irreduciblePart
      hK T hT D hD P base e hActual d hd hs
  have hnormalizer :=
    torus_le_rootSubgroupGenerated_normalizer D hD (e.symm '' s)
  rw [hgenerated] at hnormalizer
  intro t ht x hx
  have htInv : t⁻¹ ∈ T.toSubgroup := T.toSubgroup.inv_mem ht
  have hconj := Subgroup.mem_normalizer_iff.mp (hnormalizer htInv) x
  change t⁻¹ * x * t ∈ H.toSubgroup
  simpa only [inv_inv] using hconj.mp hx

public theorem rootBlockTangentClosure_le_connectedRootBlockTangent_of_irreduciblePart
    {K : Variety k} [AlgebraicGroup K] (hK : IsReductiveAlgebraicGroup K)
    (T : ClosedSubgroup K) (hT : IsMaximalTorus T)
    (D : RootGroupData K T) (hD : D.IsRealization)
    {iota M N : Type u} [Fintype iota]
    [AddCommGroup M] [Module ℝ M] [AddCommGroup N] [Module ℝ N]
    (P : RootPairing iota ℝ M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (base : P.Base) (e : D.Root ≃ iota)
    (hActual : IsActualBasedRootPairing D P base e)
    (d : P.OrthogonalDecomposition) (hd : d.IsIrreducible)
    {s : Set iota} (hs : s ∈ d.parts) :
    rootBlockTangentClosure D (e.symm '' s) ≤
      (identityTangentMorphismLieHom
        (connectedRootBlockSubgroup D (e.symm '' s)).inclusion).range := by
  let H := connectedRootBlockSubgroup D (e.symm '' s)
  have hgenerated : RootSubgroupGenerated D (e.symm '' s) = H.toSubgroup :=
    rootSubgroupGenerated_eq_connectedRootBlockSubgroup_of_irreduciblePart
      hK T hT D hD P base e hActual d hd hs
  have hInv : IsClosedSubgroupInvariant T H :=
    connectedRootBlockSubgroup_isInvariant_of_irreduciblePart
      hK T hT D hD P base e hActual d hd hs
  apply rootBlockTangentClosure_le D (e.symm '' s)
  refine ⟨?_, ?_, ?_⟩
  · intro alpha halpha
    apply rootTangent_le_closedSubgroupTangent D (e.symm '' s) H _ alpha halpha
    intro beta hbeta
    exact rootSubgroup_le_connectedRootBlockSubgroup_of_isRealization
      D hD (e.symm '' s) hbeta
  · intro g hg v hv
    apply closedSubgroupTangent_self_invariant H g _ hv
    rwa [← hgenerated]
  · intro t ht v hv
    exact closedSubgroupTangent_torus_invariant T H hInv t ht hv

end Theory.AlgebraicGroup
