module

public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.Parabolic.RelativeRoot.SourceSetup

/-!
Closed source relative-root layers.

For a `RelativeRootRepresentationSource`, every source layer is generated by a
subfamily of the Chevalley root subgroups appearing in the source root datum.
Those root subgroups are connected by the stored realization hypothesis, so the
general finite-word generation theorem for connected closed subgroups shows that
the abstract root-generated layer is already Zariski closed.

The resulting `ClosedSubgroup` packaging is kept at the source layer, with an
explicit underlying-subgroup equation and connectedness certificate, so
quotient and action constructions can use the closed carrier without importing
the standard-parabolic setup or the later representation theorems.
-/

set_option warningAsError false

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

private lemma sourceRealizedRootSubgroup_isConnected
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (α : S.D.Root) :
    _root_.IsConnected (S.D.rootSubgroup α : Set (Variety.Point K)) := by
  have hconn : Variety.IsConnected (S.D.rootSubgroup α).carrierVariety :=
    (S.isRealization.2.2.1 α).1.2.isConnected
  let : ConnectedSpace (Variety.Point (S.D.rootSubgroup α).carrierVariety) :=
    connectedSpace_iff_univ.mpr hconn
  change _root_.IsConnected
    ((S.D.rootSubgroup α).toSubgroup : Set (Variety.Point K))
  rw [← (S.D.rootSubgroup α).range_inclusion]
  exact isConnected_range (S.D.rootSubgroup α).inclusion.toVariety.continuous

private theorem sourceRootSubgroupGenerated_isZariskiClosed
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (A : Set S.D.Root) :
    IsZariskiClosed K (RootSubgroupGenerated S.D A : Set (Variety.Point K)) := by
  let H : A → ClosedSubgroup K := fun α => S.D.rootSubgroup α.1
  have hconnected : ∀ α, _root_.IsConnected (H α : Set (Variety.Point K)) := by
    intro α
    exact sourceRealizedRootSubgroup_isConnected S α.1
  have hclosed := closure_iUnion_connected_closedSubgroup_isZariskiClosed H hconnected
  rw [RootSubgroupGenerated]
  have hunion :
      (⋃ α : A, (H α : Set (Variety.Point K))) =
        ⋃ α ∈ A, (S.D.rootSubgroup α : Set (Variety.Point K)) := by
    change (⋃ α : A, (S.D.rootSubgroup α.1 : Set (Variety.Point K))) =
      ⋃ α ∈ A, (S.D.rootSubgroup α : Set (Variety.Point K))
    exact Set.iUnion_subtype (fun α : S.D.Root => α ∈ A)
      (fun α => (S.D.rootSubgroup α : Set (Variety.Point K)))
  rw [← hunion]
  exact hclosed

private theorem sourceRootSubgroupGenerated_isConnected
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (A : Set S.D.Root) :
    _root_.IsConnected
      (RootSubgroupGenerated S.D A : Set (Variety.Point K)) := by
  let H : A → ClosedSubgroup K := fun α => S.D.rootSubgroup α.1
  have hconnected : ∀ α, _root_.IsConnected (H α : Set (Variety.Point K)) := by
    intro α
    exact sourceRealizedRootSubgroup_isConnected S α.1
  have hconn := closure_iUnion_connected_closedSubgroup_isConnected H hconnected
  rw [RootSubgroupGenerated]
  have hunion :
      (⋃ α : A, (H α : Set (Variety.Point K))) =
        ⋃ α ∈ A, (S.D.rootSubgroup α : Set (Variety.Point K)) := by
    change (⋃ α : A, (S.D.rootSubgroup α.1 : Set (Variety.Point K))) =
      ⋃ α ∈ A, (S.D.rootSubgroup α : Set (Variety.Point K))
    exact Set.iUnion_subtype (fun α : S.D.Root => α ∈ A)
      (fun α => (S.D.rootSubgroup α : Set (Variety.Point K)))
  rw [← hunion]
  exact hconn

omit [IsAlgClosed k] in
/-- The simple-root support stored in the source record is the simple root set
of its root-group datum. -/
public theorem RelativeRootRepresentationSource.base_support_eq_simple_toFinset
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) :
    S.base.support = S.D.simple.toFinite.toFinset := by
  ext α
  simp only [Set.Finite.mem_toFinset]
  exact (S.rootSystemRealization.2.2.2.1 α).symm

/-- Every source relative-root layer is Zariski closed. -/
public theorem sourceRelativeRootLayer_isZariskiClosed
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) :
    IsZariskiClosed K
      (sourceRelativeRootLayer S.D S.base.support S.coeff S.J i :
        Set (Variety.Point K)) := by
  let A : Set S.D.Root :=
    {α | (i : ℤ) ≤
      RelativeRootHeight S.coeff S.base.support ((Equiv.refl S.D.Root) '' S.J)
        ((Equiv.refl S.D.Root) α)}
  have hclosed := sourceRootSubgroupGenerated_isZariskiClosed S A
  simpa [sourceRelativeRootLayer, RelativeRootSeries, A] using hclosed

/-- The source layer written with the root-datum simple set is Zariski closed. -/
public theorem sourceRelativeRootLayer_simple_isZariskiClosed
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) :
    IsZariskiClosed K
      (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J i :
        Set (Variety.Point K)) := by
  simpa [RelativeRootRepresentationSource.base_support_eq_simple_toFinset S]
    using sourceRelativeRootLayer_isZariskiClosed S i

/-- Every simple-set source relative-root layer is connected. -/
public theorem sourceRelativeRootLayer_simple_isConnected
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) :
    _root_.IsConnected
      (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J i :
        Set (Variety.Point K)) := by
  let A : Set S.D.Root :=
    {α | (i : ℤ) ≤
      RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J α}
  have hconn := sourceRootSubgroupGenerated_isConnected S A
  simpa [sourceRelativeRootLayer, RelativeRootSeries, A] using hconn

/-- A source relative-root layer, packaged as a closed algebraic subgroup. -/
@[expose]
public noncomputable def RelativeRootRepresentationSource.sourceLayerClosedSubgroup
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) : ClosedSubgroup K :=
  ClosedSubgroup.ofSubgroup
    (sourceRelativeRootLayer S.D S.base.support S.coeff S.J i)
    (sourceRelativeRootLayer_isZariskiClosed S i)

/-- The closed-subgroup packaging has exactly the original source layer as its
underlying abstract subgroup. -/
public theorem RelativeRootRepresentationSource.sourceLayerClosedSubgroup_toSubgroup
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) :
    (S.sourceLayerClosedSubgroup i).toSubgroup =
      sourceRelativeRootLayer S.D S.base.support S.coeff S.J i := by
  rfl

/-- A simple-set source layer, packaged as a closed algebraic subgroup. -/
@[expose]
public noncomputable def RelativeRootRepresentationSource.sourceSimpleLayerClosedSubgroup
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) : ClosedSubgroup K :=
  ClosedSubgroup.ofSubgroup
    (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J i)
    (sourceRelativeRootLayer_simple_isZariskiClosed S i)

/-- The simple-set closed-subgroup packaging has exactly the corresponding
source layer as its underlying abstract subgroup. -/
public theorem RelativeRootRepresentationSource.sourceSimpleLayerClosedSubgroup_toSubgroup
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) :
    (S.sourceSimpleLayerClosedSubgroup i).toSubgroup =
      sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J i := by
  rfl

end Theory.AlgebraicGroup
