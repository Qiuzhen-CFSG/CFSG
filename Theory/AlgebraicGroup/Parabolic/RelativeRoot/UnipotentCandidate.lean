module

public import Theory.AlgebraicGroup.RootData.RelativeRoots
public import Theory.AlgebraicGroup.RootData.StandardParabolicGenerated

/-!
The standard unipotent candidate attached to a positive system and a chosen
simple-root subset is the Zariski closure of the root subgroups outside the
corresponding root subsystem.  This topic-level module isolates that
construction from the numbered standard-parabolic theorems, so structural
results about the candidate can depend only on its defining root-product API.

The definition follows the positive-root factor in GLS3, Theorem 1.13.3.  It
asserts no unipotence or radical property; those require the Chevalley
collection argument supplied separately.
-/

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

/-- The closed subgroup generated by the positive root subgroups outside the
root subsystem spanned by `J`. -/
public noncomputable def unipotentCandidate
    {K : Variety k} [AlgebraicGroup K]
    (T : ClosedSubgroup K) (D : RootGroupData K T)
    (positiveRoots J : Set D.Root) : ClosedSubgroup K :=
  subgroupZariskiClosure K
    (standardUnipotentRootFactor D positiveRoots (RootSubsystemSpan D J))

/-- The standard unipotent candidate is unconditionally the Zariski closure of
its prescribed positive root factor. -/
public theorem unipotentCandidate_spec
    {K : Variety k} [AlgebraicGroup K]
    (T : ClosedSubgroup K) (D : RootGroupData K T)
    (positiveRoots J : Set D.Root) :
    unipotentCandidate T D positiveRoots J =
      subgroupZariskiClosure K
        (standardUnipotentRootFactor D positiveRoots
          (RootSubsystemSpan D J)) := by
  rfl

end Theory.AlgebraicGroup
