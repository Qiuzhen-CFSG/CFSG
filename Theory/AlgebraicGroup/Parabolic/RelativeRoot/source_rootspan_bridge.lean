module

public import Theory.AlgebraicGroup.Parabolic.RelativeRoot.SourceSetup
public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.RelativeRootNeg
public import Theory.AlgebraicGroup.RootSubgroups.Cocharacter

/-!
This module identifies the source root subsystem generated by `S.J` with the
roots whose rational root vectors lie in the span of the corresponding simple
root vectors.  The reverse implication is the bridge needed to turn rational
fiber calculations into actual `RootSubsystemSpan` membership.

The essential input is the realization data already stored by
`RelativeRootRepresentationSource`: its abstract and actual Cartan pairings,
simple roots, negation, and reflections agree.  The proof constructs the
integral root-lattice map sending each abstract simple root to its actual torus
weight and proves, by induction through simple reflections, that it sends every
abstract root to the matching actual weight.  Rational span membership forces
all simple-root coefficients outside `S.J` to vanish, so the integral expansion
then becomes a product of generators in the subgroup closure.  The converse is
the standard perfect-pairing argument.  This is the source-level lattice bridge
used in the relative-root fiber analysis following GLS3, Section 1.14.
-/

open scoped BigOperators

universe u

set_option linter.style.haveILetI false

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]
variable {K : Variety k} [AlgebraicGroup K]

omit [IsAlgClosed k] in
private noncomputable def rootWeightLatticeMap
    (S : RelativeRootRepresentationSource K) :
    S.pairing.rootSpan ℤ →ₗ[ℤ] Additive (TorusWeight S.T) :=
  S.base.toWeightBasisInt.constr ℤ
    (fun j => Additive.ofMul (S.D.rootWeight j.1))

omit [IsAlgClosed k] in
private lemma rootWeightLatticeMap_basis
    (S : RelativeRootRepresentationSource K) (j : S.base.support) :
    rootWeightLatticeMap S (S.base.toWeightBasisInt j) =
      Additive.ofMul (S.D.rootWeight j.1) := by
  exact S.base.toWeightBasisInt.constr_basis ℤ _ j

omit [IsAlgClosed k] in
private lemma rootWeightLatticeMap_root
    (S : RelativeRootRepresentationSource K) (i : S.D.Root) :
    rootWeightLatticeMap S (S.pairing.rootSpanMem ℤ i) =
      Additive.ofMul (S.D.rootWeight i) := by
  apply S.base.induction_reflect i
  · intro j hj
    have hneg : S.D.neg j = S.pairing.reflectionPerm j j := by
      simpa only [Equiv.refl_apply] using S.rootSystemRealization.2.2.1 j
    rw [S.pairing.rootSpanMem_reflectionPerm_self, map_neg, hj]
    rw [← hneg, S.isRealization.2.2.2.1, ofMul_inv]
  · intro j hj
    have hjBasis : S.pairing.rootSpanMem ℤ j =
        S.base.toWeightBasisInt ⟨j, hj⟩ := by
      apply Subtype.ext
      simp
    rw [hjBasis, rootWeightLatticeMap_basis]
  · intro a j ha hj
    have hreflect : S.D.reflect j a = S.pairing.reflectionPerm j a := by
      simpa only [Equiv.refl_apply] using S.rootSystemRealization.2.1 j a
    have hpair : S.pairing.pairingIn ℤ a j = S.D.pairing a j := by
      have hcast : (S.pairing.pairingIn ℤ a j : ℚ) =
          (S.D.pairing a j : ℚ) := by
        change algebraMap ℤ ℚ (S.pairing.pairingIn ℤ a j) =
          algebraMap ℤ ℚ (S.D.pairing a j)
        rw [S.pairing.algebraMap_pairingIn ℤ]
        exact (S.rootSystemRealization.1 a j).symm
      exact_mod_cast hcast
    have hrootSpan : S.pairing.rootSpanMem ℤ (S.pairing.reflectionPerm j a) =
        S.pairing.rootSpanMem ℤ a -
          S.pairing.pairingIn ℤ a j • S.pairing.rootSpanMem ℤ j := by
      apply Subtype.ext
      change S.pairing.root (S.pairing.reflectionPerm j a) =
        S.pairing.root a - S.pairing.pairingIn ℤ a j • S.pairing.root j
      rw [S.pairing.root_reflectionPerm, S.pairing.reflection_apply_root' ℤ]
    have hjBasis : S.pairing.rootSpanMem ℤ j =
        S.base.toWeightBasisInt ⟨j, hj⟩ := by
      apply Subtype.ext
      simp
    rw [hrootSpan, map_sub, map_zsmul, ha, hjBasis,
      rootWeightLatticeMap_basis, ← hreflect,
      S.isRealization.2.2.2.2.2.1]
    simp only [hpair, ofMul_mul, ofMul_zpow, sub_eq_add_neg, neg_smul]

private lemma base_coeff_coord
    {ι M N : Type*} [Fintype ι]
    [AddCommGroup M] [Module ℚ M] [AddCommGroup N] [Module ℚ N]
    (P : RootPairing ι ℚ M N) [P.IsRootSystem]
    (base : P.Base) (coeff : ι → ι → ℤ)
    (hCoeff : HasSimpleRootExpansion P base coeff)
    (a x : ι) (hx : x ∈ base.support) :
    (base.toWeightBasis.repr (P.root a)) ⟨x, hx⟩ = (coeff a x : ℚ) := by
  classical
  have hrepr := congrArg base.toWeightBasis.repr (hCoeff a).1
  simp only [map_sum, map_smul] at hrepr
  have h := congrArg
    (Finsupp.lapply (⟨x, hx⟩ : base.support) :
      (base.support →₀ ℚ) →ₗ[ℚ] ℚ) hrepr
  simp only [map_sum, map_smul, Finsupp.lapply_apply] at h
  have hrootcoord {j : ι} (hj : j ∈ base.support) :
      (base.toWeightBasis.repr (P.root j)) ⟨x, hx⟩ =
        if j = x then 1 else 0 := by
    let z : base.support := ⟨j, hj⟩
    have hz := base.toWeightBasis_repr_root z
    simpa [z, Finsupp.single_apply] using
      congrArg (fun y : base.support →₀ ℚ => y ⟨x, hx⟩) hz
  rw [show (∑ j ∈ base.support, (coeff a j : ℚ) •
      (base.toWeightBasis.repr (P.root j)) ⟨x, hx⟩) =
      ∑ j ∈ base.support, (coeff a j : ℚ) • (if j = x then 1 else 0) by
    apply Finset.sum_congr rfl
    intro j hj
    rw [hrootcoord hj]] at h
  rw [Finset.sum_eq_single_of_mem x hx] at h
  · simpa using h
  · intro b hb hbx
    simp [hbx]

private lemma root_span_coord_zero
    {ι M N : Type*} [Fintype ι]
    [AddCommGroup M] [Module ℚ M] [AddCommGroup N] [Module ℚ N]
    (P : RootPairing ι ℚ M N) [P.IsRootSystem]
    (base : P.Base) (J : Set ι) (hJ : J ⊆ base.support)
    {z : M} (hz : z ∈ Submodule.span ℚ (P.root '' J))
    (x : ι) (hx : x ∈ base.support) (hxJ : x ∉ J) :
    (base.toWeightBasis.repr z) ⟨x, hx⟩ = 0 := by
  classical
  induction hz using Submodule.span_induction with
  | mem z hz =>
      rcases hz with ⟨j, hj, rfl⟩
      let y : base.support := ⟨j, hJ hj⟩
      have hneq : j ≠ x := by
        intro h
        exact hxJ (h ▸ hj)
      rw [base.toWeightBasis_repr_root y]
      simp [y, hneq]
  | zero => simp
  | add z₁ z₂ _ _ hz₁ hz₂ => simp [map_add, hz₁, hz₂]
  | smul c z _ hz => simp [map_smul, hz]

private lemma root_mem_span_of_mem_rootSubsystemSpan
    (S : RelativeRootRepresentationSource K) {delta : S.D.Root}
    (hdelta : delta ∈ RootSubsystemSpan S.D S.J) :
    S.pairing.root delta ∈
      Submodule.span ℚ (S.pairing.root '' S.J) := by
  let Q : Submodule ℚ S.X :=
    Submodule.span ℚ (S.pairing.root '' S.J)
  have htransport : ∀ (chi : TorusWeight S.T),
      chi ∈ Subgroup.closure (S.D.rootWeight '' S.J) →
      ∃ z : Q, ∀ beta : S.D.Root,
        (S.D.weightPairing chi beta : ℚ) =
          S.pairing.toLinearMap z.1 (S.pairing.coroot beta) := by
    intro chi hchi
    refine Subgroup.closure_induction
      (p := fun chi _ => ∃ z : Q, ∀ beta : S.D.Root,
        (S.D.weightPairing chi beta : ℚ) =
          S.pairing.toLinearMap z.1 (S.pairing.coroot beta)) ?_ ?_ ?_ ?_ hchi
    · intro x hx
      rcases hx with ⟨gamma, hgamma, rfl⟩
      refine ⟨⟨S.pairing.root gamma,
        Submodule.subset_span ⟨gamma, hgamma, rfl⟩⟩, ?_⟩
      intro beta
      rw [S.isRealization.weightPairing_rootWeight,
        S.rootSystemRealization.1 gamma beta,
        S.pairing.root_coroot_eq_pairing]
      simp
    · refine ⟨0, ?_⟩
      intro beta
      rw [S.isRealization.weightPairing_one]
      simp
    · intro x y hx hy
      rintro ⟨zx, hzx⟩ ⟨zy, hzy⟩
      refine ⟨zx + zy, ?_⟩
      intro beta
      rw [S.isRealization.weightPairing_mul]
      simp only [Int.cast_add, Submodule.coe_add, map_add]
      rw [hzx beta, hzy beta]
      simp
    · intro x hx
      rintro ⟨z, hz⟩
      refine ⟨-z, ?_⟩
      intro beta
      rw [S.isRealization.weightPairing_inv]
      simp only [Int.cast_neg, Submodule.coe_neg, map_neg]
      rw [hz beta]
      simp
  change S.D.rootWeight delta ∈
    Subgroup.closure (S.D.rootWeight '' S.J) at hdelta
  obtain ⟨z, hz⟩ := htransport (S.D.rootWeight delta) hdelta
  have hmaps : S.pairing.toLinearMap (S.pairing.root delta) =
      S.pairing.toLinearMap z.1 := by
    apply LinearMap.ext_on
      (RootPairing.IsRootSystem.span_coroot_eq_top (P := S.pairing))
    rintro _ ⟨beta, rfl⟩
    rw [S.pairing.root_coroot_eq_pairing]
    calc
      (S.pairing.pairing delta beta : ℚ) =
          (S.D.pairing delta beta : ℚ) := by
        symm
        simpa using S.rootSystemRealization.1 delta beta
      _ = (S.D.weightPairing (S.D.rootWeight delta) beta : ℚ) := by
        rw [S.isRealization.weightPairing_rootWeight]
      _ = _ := hz beta
  have hroot : S.pairing.root delta = z.1 :=
    S.pairing.toPerfPair.injective hmaps
  rw [hroot]
  exact z.2

omit [IsAlgClosed k] in
/-- Rational span by source simple roots implies membership in the actual
subsystem generated by their torus weights. -/
public theorem RelativeRootRepresentationSource.mem_rootSubsystemSpan_of_root_mem_span
    (S : RelativeRootRepresentationSource K) {delta : S.D.Root}
    (hspan : S.pairing.root delta ∈
      Submodule.span ℚ (S.pairing.root '' S.J)) :
    delta ∈ RootSubsystemSpan S.D S.J := by
  classical
  let _ := Fintype.ofFinite S.D.Root
  have hJ : S.J ⊆ S.base.support := by
    intro j hj
    exact (S.rootSystemRealization.2.2.2.1 j).mp (S.J_simple hj)
  have hcoeffZero (j : S.D.Root) (hj : j ∈ S.base.support)
      (hjJ : j ∉ S.J) : S.coeff delta j = 0 := by
    have hcoord := root_span_coord_zero S.pairing S.base S.J hJ
      hspan j hj hjJ
    have hcoeff := base_coeff_coord S.pairing S.base S.coeff
      S.simpleRootExpansion delta j hj
    have hcast : (S.coeff delta j : ℚ) = 0 := by
      simpa [hcoeff] using hcoord
    exact_mod_cast hcast
  have hrootExpansion : S.pairing.rootSpanMem ℤ delta =
      ∑ j ∈ S.base.support,
        S.coeff delta j • S.pairing.rootSpanMem ℤ j := by
    apply Subtype.ext
    rw [Submodule.coe_sum]
    change S.pairing.root delta =
      ∑ j ∈ S.base.support, S.coeff delta j • S.pairing.root j
    simpa only [Int.cast_smul_eq_zsmul] using (S.simpleRootExpansion delta).1
  have hweight : Additive.ofMul (S.D.rootWeight delta) =
      ∑ j ∈ S.base.support,
        S.coeff delta j • Additive.ofMul (S.D.rootWeight j) := by
    calc
      Additive.ofMul (S.D.rootWeight delta) =
          rootWeightLatticeMap S (S.pairing.rootSpanMem ℤ delta) :=
        (rootWeightLatticeMap_root S delta).symm
      _ = rootWeightLatticeMap S
          (∑ j ∈ S.base.support,
            S.coeff delta j • S.pairing.rootSpanMem ℤ j) := by
        rw [hrootExpansion]
      _ = ∑ j ∈ S.base.support,
          S.coeff delta j • Additive.ofMul (S.D.rootWeight j) := by
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro j hj
        rw [map_zsmul]
        have hjBasis : S.pairing.rootSpanMem ℤ j =
            S.base.toWeightBasisInt ⟨j, hj⟩ := by
          apply Subtype.ext
          simp
        rw [hjBasis, rootWeightLatticeMap_basis]
  have hweightMul : S.D.rootWeight delta =
      ∏ j ∈ S.base.support,
        S.D.rootWeight j ^ S.coeff delta j := by
    exact congrArg Additive.toMul hweight
  change S.D.rootWeight delta ∈
    Subgroup.closure (S.D.rootWeight '' S.J)
  rw [hweightMul]
  apply Subgroup.prod_mem
  intro j hj
  by_cases hjJ : j ∈ S.J
  · have hgen : S.D.rootWeight j ∈ S.D.rootWeight '' S.J :=
      ⟨j, hjJ, rfl⟩
    exact Subgroup.zpow_mem _ (Subgroup.subset_closure hgen) _
  · rw [hcoeffZero j hj hjJ, zpow_zero]
    exact Subgroup.one_mem _

/-- For a representation source, abstract rational root span and actual root
subsystem membership define the same roots. -/
public theorem RelativeRootRepresentationSource.root_mem_span_iff_mem_rootSubsystemSpan
    (S : RelativeRootRepresentationSource K) (delta : S.D.Root) :
    S.pairing.root delta ∈
        Submodule.span ℚ (S.pairing.root '' S.J) ↔
      delta ∈ RootSubsystemSpan S.D S.J :=
  ⟨S.mem_rootSubsystemSpan_of_root_mem_span,
    root_mem_span_of_mem_rootSubsystemSpan S⟩

/-- Roots in the source Levi subsystem have zero relative-root projection. -/
public theorem RelativeRootRepresentationSource.relativeRootProjection_eq_zero_of_mem_rootSubsystemSpan
    (S : RelativeRootRepresentationSource K) {delta : S.D.Root}
    (hdelta : delta ∈ RootSubsystemSpan S.D S.J) :
    RelativeRootProjection S.coeff
      (S.D.simple.toFinite.toFinset : Set S.D.Root) S.J delta = 0 := by
  classical
  let _ := Fintype.ofFinite S.D.Root
  have hspan := (S.root_mem_span_iff_mem_rootSubsystemSpan delta).mpr hdelta
  have hJ : S.J ⊆ S.base.support := by
    intro j hj
    exact (S.rootSystemRealization.2.2.2.1 j).mp (S.J_simple hj)
  have hprojBase :
      RelativeRootProjection S.coeff (S.base.support : Set S.D.Root)
        S.J delta = 0 := by
    apply Finsupp.ext
    intro x
    by_cases hx : x ∈ S.base.support
    · by_cases hxJ : x ∈ S.J
      · simp [RelativeRootProjection, hx, hxJ]
      · have hcoord := root_span_coord_zero S.pairing S.base S.J hJ
          hspan x hx hxJ
        have hcoeff := base_coeff_coord S.pairing S.base S.coeff
          S.simpleRootExpansion delta x hx
        have hzero : S.coeff delta x = 0 := by
          have : (S.coeff delta x : ℚ) = 0 := by
            simpa [hcoeff] using hcoord
          exact_mod_cast this
        simp [RelativeRootProjection, hx, hxJ, hzero]
    · simp [RelativeRootProjection, hx]
  have hbase : S.base.support = S.D.simple.toFinite.toFinset := by
    ext gamma
    simp only [Set.Finite.mem_toFinset]
    exact (S.rootSystemRealization.2.2.2.1 gamma).symm
  simpa [hbase] using hprojBase

/-- Roots in the source Levi subsystem have relative height zero. -/
public theorem RelativeRootRepresentationSource.relativeRootHeight_eq_zero_of_mem_rootSubsystemSpan
    (S : RelativeRootRepresentationSource K) {delta : S.D.Root}
    (hdelta : delta ∈ RootSubsystemSpan S.D S.J) :
    RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J delta = 0 := by
  letI := Fintype.ofFinite S.D.Root
  exact relativeRootHeight_eq_zero_of_projection_eq_zero S.coeff
    S.D.simple.toFinite.toFinset S.J
    (S.relativeRootProjection_eq_zero_of_mem_rootSubsystemSpan hdelta)

end Theory.AlgebraicGroup
