module

public import Theory.AlgebraicGroup.ClosedSubgroup.Normalizer
public import Theory.AlgebraicGroup.Parabolic.RelativeRoot.SourceLayerClosedInterface
public import Theory.AlgebraicGroup.Parabolic.RelativeRoot.RepresentationSourceCoordinateEquivalence
public import Theory.AlgebraicGroup.Parabolic.RelativeRoot.source_rootspan_bridge
public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.QuotientAction
public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.ZeroHeightNormalizer
public import Theory.AlgebraicGroup.RootSubgroups.TorusGeneratedNormalizer

/-!
Source Levi conjugation on exact relative-root layer quotients.

For a `RelativeRootRepresentationSource S`, the chosen Levi subgroup is the
Zariski closure of the subgroup generated by the source torus and the
root-subgroups whose roots lie in the subsystem generated by `S.J`.  The torus
normalizes every root-generated layer.  Roots in the subsystem have zero
relative height, and the Chevalley commutator formula then shows that their
root subgroups normalize every positive source layer; the zero layer is
handled by inclusion.  Since the source layers are closed, their normalizers
are closed, so normalization extends from the generators to `S.L`.

The resulting action on `relativeRootLayerQuotient S` is the ambient
conjugation action on the adjacent quotient.  Its computation rule on
`QuotientGroup.mk'` is exposed for later coordinate and rationality work.
This module uses only the source data and the closed source-layer interface;
it does not use `RelativeRootFiberModule`, `theorem_1_13_5`, `theorem_1_14_6`,
or `theorem_1_14_7`.
-/

universe u

set_option linter.style.haveILetI false

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

omit [IsAlgClosed k] in
/-- The source torus normalizes every source relative-root layer. -/
public lemma RelativeRootRepresentationSource.torus_le_sourceRelativeRootLayer_normalizer
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) :
    S.T.toSubgroup ≤
      Subgroup.normalizer
        (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J i :
          Set (Variety.Point K)) := by
  have h := torus_le_rootSubgroupGenerated_normalizer S.D S.isRealization
    {α : S.D.Root | (i : ℤ) ≤
      RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J α}
  simpa [sourceRelativeRootLayer, RelativeRootSeries] using h

/-- The root-generated source Levi factor normalizes every source
relative-root layer. -/
public lemma RelativeRootRepresentationSource.leviRootFactor_le_sourceRelativeRootLayer_normalizer
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) :
    standardLeviRootFactor S.D (RootSubsystemSpan S.D S.J) ≤
      Subgroup.normalizer
        (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J i :
          Set (Variety.Point K)) := by
  letI := Fintype.ofFinite S.D.Root
  rw [standardLeviRootFactor, RootSubgroupGenerated_le_iff]
  intro α hα
  have hzero : RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J α = 0 := by
    rcases hα with hα | ⟨β, hβ, rfl⟩
    · exact S.relativeRootHeight_eq_zero_of_mem_rootSubsystemSpan hα
    · have hbase : S.base.support = S.D.simple.toFinite.toFinset :=
        S.base_support_eq_simple_toFinset
      have hβzero : RelativeRootHeight S.coeff S.base.support S.J β = 0 := by
        simpa [hbase] using S.relativeRootHeight_eq_zero_of_mem_rootSubsystemSpan hβ
      have hneg :
          RelativeRootHeight S.coeff S.base.support S.J (S.D.neg β) = 0 := by
        have hβzero' :
            RelativeRootHeight S.coeff S.base.support S.J
              ((Equiv.refl S.D.Root) β) = 0 := by
          simpa using hβzero
        change RelativeRootHeight S.coeff S.base.support S.J
          ((Equiv.refl S.D.Root) (S.D.neg β)) = 0
        rw [S.rootSystemRealization.2.2.1 β,
          relativeRootHeight_reflectionPerm_self S.pairing S.base S.J S.coeff
            S.simpleRootExpansion,
          hβzero', neg_zero]
      simpa [hbase] using hneg
  cases i with
  | zero =>
      have hrootLe :
          (S.D.rootSubgroup α).toSubgroup ≤
            sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J 0 := by
        intro x hx
        rw [sourceRelativeRootLayer, RelativeRootSeries, RootSubgroupGenerated]
        apply Subgroup.subset_closure
        simp only [Set.mem_iUnion, Set.mem_ofPred_eq]
        have himage : (Equiv.refl S.D.Root : S.D.Root → S.D.Root) '' S.J =
            S.J := by
          ext beta
          simp
        have hnonneg :
            (0 : Int) ≤
              RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J α := by
          rw [hzero]
        exact ⟨α, by simpa [himage] using hnonneg, hx⟩
      exact hrootLe.trans
        (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J 0).le_normalizer
  | succ i =>
      have hbase : S.base.support = S.D.simple.toFinite.toFinset :=
        S.base_support_eq_simple_toFinset
      have hzeroBase :
          RelativeRootHeight S.coeff S.base.support S.J α = 0 := by
        simpa [hbase] using hzero
      have himage : (Equiv.refl S.D.Root : S.D.Root → S.D.Root) '' S.J =
          S.J := by
        ext beta
        simp
      have hzeroBase' :
          RelativeRootHeight S.coeff S.base.support
            ((Equiv.refl S.D.Root) '' S.J) ((Equiv.refl S.D.Root) α) = 0 := by
        simpa [himage] using hzeroBase
      simpa [sourceRelativeRootLayer, hbase] using
        (rootSubgroup_le_normalizer_relativeRootSeries_of_height_zero
          S.D S.C S.pairing (Equiv.refl S.D.Root) S.base S.coeff
          S.simpleRootExpansion S.chevalleySystem S.J (i + 1)
          (Nat.succ_pos i) α hzeroBase')

/-- The abstract subgroup generated by the source torus and the source Levi
root factor normalizes every source relative-root layer. -/
public lemma RelativeRootRepresentationSource.leviGeneratingSubgroup_le_sourceRelativeRootLayer_normalizer
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) :
    Subgroup.closure ((S.T : Set (Variety.Point K)) ∪
        standardLeviRootFactor S.D (RootSubsystemSpan S.D S.J)) ≤
      Subgroup.normalizer
        (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J i :
          Set (Variety.Point K)) := by
  rw [Subgroup.closure_le]
  intro x hx
  rcases hx with hxT | hxRoot
  · exact S.torus_le_sourceRelativeRootLayer_normalizer i hxT
  · exact S.leviRootFactor_le_sourceRelativeRootLayer_normalizer i hxRoot

/-- The source Levi subgroup normalizes every source relative-root layer. -/
public theorem RelativeRootRepresentationSource.levi_le_sourceRelativeRootLayer_normalizer
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (i : ℕ) :
    S.L.toSubgroup ≤
      Subgroup.normalizer
        (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J i :
          Set (Variety.Point K)) := by
  let H : ClosedSubgroup K := S.sourceSimpleLayerClosedSubgroup i
  have hH : H.toSubgroup =
      sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J i :=
    S.sourceSimpleLayerClosedSubgroup_toSubgroup i
  have hgen := S.leviGeneratingSubgroup_le_sourceRelativeRootLayer_normalizer i
  rw [S.levi_alignment]
  change closure
      ((Subgroup.closure ((S.T : Set (Variety.Point K)) ∪
        standardLeviRootFactor S.D (RootSubsystemSpan S.D S.J)) :
          Subgroup (Variety.Point K)) : Set (Variety.Point K)) ⊆ _
  apply closure_minimal hgen
  rw [← hH]
  exact Variety.isClosed_iff_isZariskiClosed.mpr H.normalizer_isZariskiClosed

@[reducible]
private noncomputable def sourceSubgroupConjugationAction
    {K : Variety k} [AlgebraicGroup K]
    (L S : Subgroup (Variety.Point K))
    (hL : L ≤ Subgroup.normalizer (S : Set (Variety.Point K))) :
    MulDistribMulAction L S := by
  let ι : L →* Subgroup.normalizer (S : Set (Variety.Point K)) :=
    { toFun := fun l => ⟨l.1, hL l.2⟩
      map_one' := by ext; rfl
      map_mul' := by intro a b; ext; rfl }
  exact MulDistribMulAction.compHom S ι

/-- Ambient conjugation by source Levi points on the exact-height source
relative-root layer quotient. -/
@[reducible]
public noncomputable def RelativeRootRepresentationSource.sourceLayerQuotientConjugationAction
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) :
    MulDistribMulAction S.L.toSubgroup (relativeRootLayerQuotient S) := by
  let S0 : Subgroup (Variety.Point K) :=
    sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J S.height
  let Snext : Subgroup (Variety.Point K) :=
    sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
      (S.height + 1)
  let hLi : S.L.toSubgroup ≤
      Subgroup.normalizer (S0 : Set (Variety.Point K)) := by
    intro l hl
    exact S.levi_le_sourceRelativeRootLayer_normalizer S.height hl
  let hLnext : S.L.toSubgroup ≤
      Subgroup.normalizer (Snext : Set (Variety.Point K)) := by
    intro l hl
    exact S.levi_le_sourceRelativeRootLayer_normalizer (S.height + 1) hl
  letI : MulDistribMulAction S.L.toSubgroup S0 :=
    sourceSubgroupConjugationAction S.L.toSubgroup S0 hLi
  let N : Subgroup S0 := Snext.subgroupOf S0
  let hInv : IsInvariant S.L.toSubgroup S0 N := by
    constructor
    intro l x
    change x.1 ∈ Snext ↔
      ((sourceSubgroupConjugationAction S.L.toSubgroup S0 hLi).smul l x :
        Variety.Point K) ∈ Snext
    change x.1 ∈ Snext ↔ l.1 * x.1 * l.1⁻¹ ∈ Snext
    have hnorm := hLnext l.2
    rw [Subgroup.mem_normalizer_iff] at hnorm
    exact hnorm x.1
  let : IsInvariant S.L.toSubgroup S0 N := hInv
  let : N.Normal := by
    dsimp only [N, S0, Snext]
    exact sourceRelativeRootLayer_next_normal S
  change MulDistribMulAction S.L.toSubgroup (S0 ⧸ N)
  exact quotientMulDistribMulAction N hInv

/-- The source-layer quotient action agrees with ambient quotient
conjugation on quotient classes. -/
public theorem RelativeRootRepresentationSource.sourceLayerQuotientConjugationAction_mk
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (l : S.L.toSubgroup)
    (x : sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J S.height) :
    (S.sourceLayerQuotientConjugationAction).smul l
        (QuotientGroup.mk'
          ((sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
            (S.height + 1)).subgroupOf
            (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
              S.height)) x) =
      QuotientGroup.mk'
        ((sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
          (S.height + 1)).subgroupOf
          (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
            S.height))
        ⟨l.1 * x.1 * l.1⁻¹, by
          have hnorm := S.levi_le_sourceRelativeRootLayer_normalizer S.height l.2
          rw [Subgroup.mem_normalizer_iff] at hnorm
          exact (hnorm x.1).mp x.2⟩ := by
  let S0 : Subgroup (Variety.Point K) :=
    sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J S.height
  let Snext : Subgroup (Variety.Point K) :=
    sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
      (S.height + 1)
  let hLi : S.L.toSubgroup ≤
      Subgroup.normalizer (S0 : Set (Variety.Point K)) := by
    intro a ha
    exact S.levi_le_sourceRelativeRootLayer_normalizer S.height ha
  let hLnext : S.L.toSubgroup ≤
      Subgroup.normalizer (Snext : Set (Variety.Point K)) := by
    intro a ha
    exact S.levi_le_sourceRelativeRootLayer_normalizer (S.height + 1) ha
  letI : MulDistribMulAction S.L.toSubgroup S0 :=
    sourceSubgroupConjugationAction S.L.toSubgroup S0 hLi
  let N : Subgroup S0 := Snext.subgroupOf S0
  let hInv : IsInvariant S.L.toSubgroup S0 N := by
    constructor
    intro a y
    change y.1 ∈ Snext ↔
      ((sourceSubgroupConjugationAction S.L.toSubgroup S0 hLi).smul a y :
        Variety.Point K) ∈ Snext
    change y.1 ∈ Snext ↔ a.1 * y.1 * a.1⁻¹ ∈ Snext
    have hnorm := hLnext a.2
    rw [Subgroup.mem_normalizer_iff] at hnorm
    exact hnorm y.1
  let : IsInvariant S.L.toSubgroup S0 N := hInv
  let : N.Normal := by
    dsimp only [N, S0, Snext]
    exact sourceRelativeRootLayer_next_normal S
  change (quotientMulDistribMulAction N hInv).smul l (QuotientGroup.mk' N x) =
    QuotientGroup.mk' N
      ⟨l.1 * x.1 * l.1⁻¹, by
        have hnorm := S.levi_le_sourceRelativeRootLayer_normalizer S.height l.2
        rw [Subgroup.mem_normalizer_iff] at hnorm
        exact (hnorm x.1).mp x.2⟩
  rfl

/-- The monoid homomorphism recording source Levi conjugation automorphisms on
the exact-height quotient. -/
@[reducible]
public noncomputable def RelativeRootRepresentationSource.sourceLayerQuotientConjugationHom
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) :
    S.L.toSubgroup →* MulAut (relativeRootLayerQuotient S) := by
  letI : MulDistribMulAction S.L.toSubgroup (relativeRootLayerQuotient S) :=
    S.sourceLayerQuotientConjugationAction
  exact MulDistribMulAction.toMulAut S.L.toSubgroup (relativeRootLayerQuotient S)

/-- The same exact-height quotient conjugation action, indexed by rational
points of the source Levi carrier variety. -/
@[reducible]
public noncomputable def RelativeRootRepresentationSource.sourceLayerCarrierQuotientConjugationHom
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) :
    Variety.Point S.L.carrierVariety →* MulAut (relativeRootLayerQuotient S) := by
  let ι : Variety.Point S.L.carrierVariety →* S.L.toSubgroup :=
    { toFun := S.L.pointEquiv
      map_one' := rfl
      map_mul' := by intro _ _; rfl }
  exact S.sourceLayerQuotientConjugationHom.comp ι

/-- Ambient conjugation by source Levi carrier points on the exact-height
source relative-root layer quotient. -/
@[reducible]
public noncomputable def RelativeRootRepresentationSource.sourceLayerCarrierQuotientConjugationAction
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) :
    MulDistribMulAction (Variety.Point S.L.carrierVariety)
      (relativeRootLayerQuotient S) := by
  exact MulDistribMulAction.compHom _
    (S.sourceLayerCarrierQuotientConjugationHom)

/-- The source-layer carrier action agrees with ambient quotient conjugation
on quotient classes. -/
public theorem RelativeRootRepresentationSource.sourceLayerCarrierQuotientConjugationAction_mk
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (l : Variety.Point S.L.carrierVariety)
    (x : sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J S.height) :
    (S.sourceLayerCarrierQuotientConjugationAction).smul l
        (show relativeRootLayerQuotient S from QuotientGroup.mk'
          ((sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
            (S.height + 1)).subgroupOf
            (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
              S.height)) x) =
      QuotientGroup.mk'
        ((sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
          (S.height + 1)).subgroupOf
          (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
            S.height))
        ⟨S.L.includePoint l * x.1 * (S.L.includePoint l)⁻¹, by
          have hnorm := S.levi_le_sourceRelativeRootLayer_normalizer S.height
            (S.L.pointEquiv l).2
          rw [Subgroup.mem_normalizer_iff] at hnorm
          exact (hnorm x.1).mp x.2⟩ := by
  dsimp [RelativeRootRepresentationSource.sourceLayerCarrierQuotientConjugationAction,
    RelativeRootRepresentationSource.sourceLayerCarrierQuotientConjugationHom]
  change (S.sourceLayerQuotientConjugationAction).smul (S.L.pointEquiv l)
      (show relativeRootLayerQuotient S from QuotientGroup.mk'
        ((sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
          (S.height + 1)).subgroupOf
          (sourceRelativeRootLayer S.D S.D.simple.toFinite.toFinset S.coeff S.J
            S.height)) x) = _
  simpa [ClosedSubgroup.includePoint] using
    S.sourceLayerQuotientConjugationAction_mk (S.L.pointEquiv l) x

/-- Source Levi conjugation transported to the full exact-height coordinate
group through `relativeRootLayerQuotient_coordinateEquiv`. -/
@[expose, reducible]
public noncomputable def
    RelativeRootRepresentationSource.sourceLayerCoordinateConjugationHom
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) :
    S.L.toSubgroup →*
      MulAut (Multiplicative ({gamma : S.D.Root //
        RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J gamma =
          S.height} → k)) := by
  let Q := relativeRootLayerQuotient S
  let C := Multiplicative ({gamma : S.D.Root //
    RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J gamma =
      S.height} → k)
  let e : Q ≃* C := relativeRootLayerQuotient_coordinateEquiv S
  letI : MulDistribMulAction S.L.toSubgroup Q :=
    S.sourceLayerQuotientConjugationAction
  exact
    { toFun := fun l => e.symm.trans
        ((MulDistribMulAction.toMulAut S.L.toSubgroup Q l).trans e)
      map_one' := by
        ext c
        simp [Q, C, e]
      map_mul' := by
        intro a b
        ext c
        simp [Q, C, e, mul_smul] }

/-- The multiplicative action on exact-height coordinates obtained by
transporting source-layer quotient conjugation through the coordinate
equivalence. -/
@[reducible]
public noncomputable def
    RelativeRootRepresentationSource.sourceLayerCoordinateConjugationAction
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) :
    MulDistribMulAction S.L.toSubgroup
      (Multiplicative ({gamma : S.D.Root //
        RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J gamma =
          S.height} → k)) := by
  exact MulDistribMulAction.compHom _
    (S.sourceLayerCoordinateConjugationHom)

/-- Pointwise formula for the transported coordinate action. -/
public theorem
    RelativeRootRepresentationSource.sourceLayerCoordinateConjugationAction_apply
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (l : S.L.toSubgroup)
    (c : Multiplicative ({gamma : S.D.Root //
      RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J gamma =
        S.height} → k)) :
    (S.sourceLayerCoordinateConjugationAction).smul l c =
      relativeRootLayerQuotient_coordinateEquiv S
        ((S.sourceLayerQuotientConjugationAction).smul l
          ((relativeRootLayerQuotient_coordinateEquiv S).symm c)) := by
  rfl

/-- Source Levi carrier-point conjugation transported to the full exact-height
coordinate group through `relativeRootLayerQuotient_coordinateEquiv`. -/
@[expose, reducible]
public noncomputable def
    RelativeRootRepresentationSource.sourceLayerCarrierCoordinateConjugationHom
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) :
    Variety.Point S.L.carrierVariety →*
      MulAut (Multiplicative ({gamma : S.D.Root //
        RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J gamma =
          S.height} → k)) := by
  let ι : Variety.Point S.L.carrierVariety →* S.L.toSubgroup :=
    { toFun := S.L.pointEquiv
      map_one' := rfl
      map_mul' := by intro _ _; rfl }
  exact S.sourceLayerCoordinateConjugationHom.comp ι

/-- The multiplicative action on exact-height coordinates indexed by source
Levi carrier points. -/
@[expose, reducible]
public noncomputable def
    RelativeRootRepresentationSource.sourceLayerCarrierCoordinateConjugationAction
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) :
    MulDistribMulAction (Variety.Point S.L.carrierVariety)
      (Multiplicative ({gamma : S.D.Root //
        RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J gamma =
          S.height} → k)) := by
  exact MulDistribMulAction.compHom _
    (S.sourceLayerCarrierCoordinateConjugationHom)

/-- Pointwise formula for the transported coordinate action indexed by source
Levi carrier points. -/
public theorem
    RelativeRootRepresentationSource.sourceLayerCarrierCoordinateConjugationAction_apply
    {K : Variety k} [AlgebraicGroup K]
    (S : RelativeRootRepresentationSource K) (l : Variety.Point S.L.carrierVariety)
    (c : Multiplicative ({gamma : S.D.Root //
      RelativeRootHeight S.coeff S.D.simple.toFinite.toFinset S.J gamma =
        S.height} → k)) :
    (S.sourceLayerCarrierCoordinateConjugationAction).smul l c =
      relativeRootLayerQuotient_coordinateEquiv S
        ((S.sourceLayerCarrierQuotientConjugationAction).smul l
          ((relativeRootLayerQuotient_coordinateEquiv S).symm c)) := by
  change (S.sourceLayerCoordinateConjugationAction).smul (S.L.pointEquiv l) c =
    relativeRootLayerQuotient_coordinateEquiv S
      ((S.sourceLayerQuotientConjugationAction).smul (S.L.pointEquiv l)
        ((relativeRootLayerQuotient_coordinateEquiv S).symm c))
  exact S.sourceLayerCoordinateConjugationAction_apply (S.L.pointEquiv l) c

