module

public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.ParabolicSetup
public import Theory.AlgebraicGroup.RootData.StandardParabolicGenerated

/-!
# Parabolic relative-root layer setup

This module records the data used by the parabolic relative-root filtration,
independently of the unresolved structural conclusions in `theorem_1_13_3`.
It packages compatible integral and rational root realizations, Chevalley data,
the chosen standard parabolic, and its root-generated layers.  Exact root
addition in the integral realization supplies the partial-addition
completeness needed by collection arguments.

Keeping the setup and its elementary layer API at this lower boundary lets
coordinate and commutator arguments use only their actual hypotheses, without
importing Borel decomposition theorems or placeholder-backed declarations.
-/

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- Root-realization, Chevalley, and standard-parabolic data for the relative
root filtration. -/
public structure ParabolicRelativeRootSetup
    (K : Variety k) [AlgebraicGroup K] where
  isSimple : IsSimpleAlgebraicGroup K
  T : ClosedSubgroup K
  B : ClosedSubgroup K
  D : RootGroupData K T
  C : ChevalleyData K D
  [finiteActualRoot : Finite D.Root]
  ι : Type u
  X : Type u
  Y : Type u
  [finiteRoot : Finite ι]
  [addCommGroupX : AddCommGroup X]
  [addCommGroupY : AddCommGroup Y]
  pairing : RootPairing ι ℤ X Y
  [isRootSystem : pairing.IsRootSystem]
  [isCrystallographic : pairing.IsCrystallographic]
  [isReduced : pairing.IsReduced]
  base : pairing.Base
  rootEquiv : D.Root ≃ ι
  weightEquiv : Multiplicative X ≃* TorusWeight T
  positiveRoots : Set D.Root
  J : Set D.Root
  sigmaJ : Set D.Root
  coeff : ι → ι → ℤ
  rootGroupRealization : D.IsRealization
  integralRootAdditionRealization :
    IsRootAdditionRealization D pairing rootEquiv
  actualRootDatum :
    IsActualBasedRootDatum D pairing base rootEquiv weightEquiv positiveRoots
  simpleRootExpansion : HasSimpleRootExpansion pairing base coeff
  XQ : Type u
  YQ : Type u
  [addCommGroupXQ : AddCommGroup XQ]
  [moduleXQ : Module ℚ XQ]
  [addCommGroupYQ : AddCommGroup YQ]
  [moduleYQ : Module ℚ YQ]
  rootPairing : RootPairing ι ℚ XQ YQ
  [rootPairingIsRootSystem : rootPairing.IsRootSystem]
  [rootPairingIsCrystallographic : rootPairing.IsCrystallographic]
  [rootPairingIsReduced : rootPairing.IsReduced]
  rootBase : rootPairing.Base
  rootBase_support : rootBase.support = base.support
  rootSystemRealization :
    IsRootSystemRealization D rootPairing rootEquiv rootBase
  rationalRootAdditionRealization :
    IsRootAdditionRealization D rootPairing rootEquiv
  rootSimpleRootExpansion :
    HasSimpleRootExpansion rootPairing rootBase coeff
  chevalleySystem : IsChevalleySystem D C rootPairing rootEquiv rootBase
  standardParabolic : IsStandardParabolicSetup T B D positiveRoots J sigmaJ
  P : ClosedSubgroup K
  L : ClosedSubgroup K
  U : ClosedSubgroup K
  M : ClosedSubgroup K
  parabolic_alignment :
    P = subgroupZariskiClosure K
      (T.toSubgroup ⊔ standardParabolicRootFactor D positiveRoots sigmaJ)
  levi_alignment :
    L = subgroupZariskiClosure K
      (T.toSubgroup ⊔ standardLeviRootFactor D sigmaJ)
  unipotentRootGeneration :
    U.toSubgroup = RootSubgroupGenerated D (positiveRoots \ sigmaJ)
  maxRelativeHeight : ℕ
  relativeHeight_le : ∀ α,
    RelativeRootHeight coeff rootBase.support (rootEquiv '' J) (rootEquiv α) ≤
      maxRelativeHeight
  relativeHeight_eq :
    (positiveRoots \ sigmaJ = ∅ ∧ maxRelativeHeight = 0) ∨
      ∃ α, α ∈ positiveRoots \ sigmaJ ∧
        RelativeRootHeight coeff rootBase.support (rootEquiv '' J) (rootEquiv α) =
          maxRelativeHeight

attribute [instance] ParabolicRelativeRootSetup.finiteActualRoot
  ParabolicRelativeRootSetup.finiteRoot
  ParabolicRelativeRootSetup.addCommGroupX
  ParabolicRelativeRootSetup.addCommGroupY
  ParabolicRelativeRootSetup.isRootSystem
  ParabolicRelativeRootSetup.isCrystallographic
  ParabolicRelativeRootSetup.isReduced
  ParabolicRelativeRootSetup.moduleXQ
  ParabolicRelativeRootSetup.moduleYQ
  ParabolicRelativeRootSetup.addCommGroupXQ
  ParabolicRelativeRootSetup.addCommGroupYQ
  ParabolicRelativeRootSetup.rootPairingIsRootSystem
  ParabolicRelativeRootSetup.rootPairingIsCrystallographic
  ParabolicRelativeRootSetup.rootPairingIsReduced

omit [IsAlgClosed k] in
/-- Exact addition in the integral actual-root model supplies completeness of
the partial addition operation on torus roots. -/
public theorem ParabolicRelativeRootSetup.rootAdditionComplete
    {K : Variety k} [AlgebraicGroup K]
    (S : ParabolicRelativeRootSetup K) :
    S.D.IsRootAdditionComplete :=
  S.integralRootAdditionRealization.isRootAdditionComplete
    S.actualRootDatum.2.1

/-- The subgroup generated by roots of relative height at least `i`. -/
@[expose]
public noncomputable def ParabolicRelativeRootSetup.layer
    {K : Variety k} [AlgebraicGroup K]
    (S : ParabolicRelativeRootSetup K) (i : ℕ) :
    Subgroup (Variety.Point K) :=
  RelativeRootSeries S.D S.rootEquiv S.base.support S.coeff S.J i

/-- Absolute roots of exact relative height `i`. -/
@[expose]
public def ParabolicRelativeRootSetup.layerRootIndex
    {K : Variety k} [AlgebraicGroup K]
    (S : ParabolicRelativeRootSetup K) (i : ℕ) :=
  { α : S.D.Root // RelativeRootHeight S.coeff S.base.support
      (S.rootEquiv '' S.J) (S.rootEquiv α) = i }

public instance ParabolicRelativeRootSetup.finiteLayerRootIndex
    {K : Variety k} [AlgebraicGroup K]
    (S : ParabolicRelativeRootSetup K) (i : ℕ) :
    Finite (S.layerRootIndex i) := by
  dsimp [ParabolicRelativeRootSetup.layerRootIndex]
  infer_instance

end Theory.AlgebraicGroup
