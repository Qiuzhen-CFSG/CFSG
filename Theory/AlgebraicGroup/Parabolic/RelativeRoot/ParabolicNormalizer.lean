module

public import Theory.AlgebraicGroup.Parabolic.RelativeRoot.theorem_1_13_3
public import Theory.AlgebraicGroup.ClosedSubgroup.Normalizer
public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.ParabolicClosed
public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.ParabolicLeviAction
public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.ParabolicNormalizer

universe u

/-!
Parabolic normalization of every relative-root layer attached to a
`ParabolicRelativeRootSetup`.

The setup alignment realizes the parabolic as the Zariski closure of the
subgroup generated by its standard torus and standard-parabolic root factor.
The maintained standard-parabolic APIs put both generators in the normalizer
of each layer.  Standard relative-root layers, including the zero layer, are
Zariski closed, so their normalizers are closed; `closure_minimal` therefore
extends generator normalization across the aligned parabolic closure.

This is the normalization step used for the relative-root filtration in GLS3,
Section 1.13.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

private def ParabolicRelativeRootSetup.toStandardForParabolicNormalizer
    {K : Variety k} [AlgebraicGroup K]
    (S : ParabolicRelativeRootSetup K) :
    StandardParabolicRelativeRootSetup K where
  T := S.T
  B := S.B
  U := S.U
  D := S.D
  C := S.C
  finiteActualRoot := S.finiteActualRoot
  ι := S.ι
  X := S.X
  Y := S.Y
  finiteRoot := S.finiteRoot
  addCommGroupX := S.addCommGroupX
  addCommGroupY := S.addCommGroupY
  integralPairing := S.pairing
  integralRootSystem := S.isRootSystem
  integralCrystallographic := S.isCrystallographic
  integralReduced := S.isReduced
  integralBase := S.base
  rootEquiv := S.rootEquiv
  weightEquiv := S.weightEquiv
  positiveRoots := S.positiveRoots
  J := S.J
  sigmaJ := S.sigmaJ
  coeff := S.coeff
  integralRootAdditionRealization := S.integralRootAdditionRealization
  actualRootDatum := S.actualRootDatum
  integralSimpleRootExpansion := S.simpleRootExpansion
  standardParabolic := S.standardParabolic
  unipotentRootGeneration := S.unipotentRootGeneration
  XQ := S.XQ
  YQ := S.YQ
  addCommGroupXQ := S.addCommGroupXQ
  moduleXQ := S.moduleXQ
  addCommGroupYQ := S.addCommGroupYQ
  moduleYQ := S.moduleYQ
  rationalPairing := S.rootPairing
  rationalRootSystem := S.rootPairingIsRootSystem
  rationalCrystallographic := S.rootPairingIsCrystallographic
  rationalReduced := S.rootPairingIsReduced
  rationalBase := S.rootBase
  baseSupport_eq := S.rootBase_support
  rationalRootRealization := S.rootSystemRealization
  rationalRootAdditionRealization := S.rationalRootAdditionRealization
  rationalSimpleRootExpansion := S.rootSimpleRootExpansion
  chevalleySystem := S.chevalleySystem
  maxRelativeHeight := S.maxRelativeHeight
  relativeHeight_le := S.relativeHeight_le

omit [IsAlgClosed k] in
private lemma layer_toStandardForParabolicNormalizer
    {K : Variety k} [AlgebraicGroup K]
    (S : ParabolicRelativeRootSetup K) (i : ℕ) :
    S.toStandardForParabolicNormalizer.layer i = S.layer i := by
  rw [StandardParabolicRelativeRootSetup.layer,
    ParabolicRelativeRootSetup.layer]
  change RelativeRootSeries S.D S.rootEquiv S.rootBase.support S.coeff S.J i =
    RelativeRootSeries S.D S.rootEquiv S.base.support S.coeff S.J i
  rw [S.rootBase_support]

/-- The aligned parabolic normalizes every layer of its relative-root
filtration, including the zero layer. -/
public theorem ParabolicRelativeRootSetup.parabolic_le_layer_normalizer
    {K : Variety k} [AlgebraicGroup K]
    (S : ParabolicRelativeRootSetup K) :
    ∀ i, S.P.toSubgroup ≤
      Subgroup.normalizer (S.layer i : Set (Variety.Point K)) := by
  intro i
  let S' := S.toStandardForParabolicNormalizer
  let H : ClosedSubgroup K := ClosedSubgroup.ofSubgroup (S'.layer i) (by
    cases i with
    | zero => exact standardParabolicRelativeRootLayer_zero_isZariskiClosed S'
    | succ j =>
        exact standardParabolicRelativeRootLayer_isZariskiClosed S' (j + 1) (by omega))
  have hH : H.toSubgroup = S.layer i := by
    change S'.layer i = S.layer i
    exact layer_toStandardForParabolicNormalizer S i
  have hgen : S.T.toSubgroup ⊔
      standardParabolicRootFactor S.D S.positiveRoots S.sigmaJ ≤
      Subgroup.normalizer (S.layer i : Set (Variety.Point K)) := by
    apply sup_le
    · have htorus :=
        standardParabolicTorus_le_relativeRootLayer_normalizer S' i
      change S.T.toSubgroup ≤ Subgroup.normalizer
        (S'.layer i : Set (Variety.Point K)) at htorus
      rwa [layer_toStandardForParabolicNormalizer S i] at htorus
    · have hroot :=
        standardParabolicRootFactor_le_relativeRootLayer_normalizer S' i
      change standardParabolicRootFactor S.D S.positiveRoots S.sigmaJ ≤
        Subgroup.normalizer (S'.layer i : Set (Variety.Point K)) at hroot
      rwa [layer_toStandardForParabolicNormalizer S i] at hroot
  rw [S.parabolic_alignment]
  change closure
      ((S.T.toSubgroup ⊔ standardParabolicRootFactor S.D S.positiveRoots S.sigmaJ :
        Subgroup (Variety.Point K)) : Set (Variety.Point K)) ⊆ _
  apply closure_minimal hgen
  rw [← hH]
  exact Variety.isClosed_iff_isZariskiClosed.mpr H.normalizer_isZariskiClosed

end Theory.AlgebraicGroup
