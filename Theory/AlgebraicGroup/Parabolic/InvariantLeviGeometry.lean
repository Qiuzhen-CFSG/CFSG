module

public import Theory.AlgebraicGroup.RootSubgroups.ClosedGeneration
public import Theory.AlgebraicGroup.RootData.StandardLevi
public import Theory.AlgebraicGroup.RootData.Standard
public import Theory.AlgebraicGroup.Borel.StandardPositiveSystemClassification.Defs
public import Theory.AlgebraicGroup.Parabolic.Defs

/-!
# Closed standard parabolic candidates

Realized root subgroups and the torus generate closed connected subgroups.
This constructs the standard parabolic, unipotent and Levi candidates with
exact point groups. An aligned positive Borel lies in the parabolic candidate,
so that candidate is parabolic. Root-set transport gives exact invariance,
including surjectivity onto each factor, from exact transport of root groups.

Source: GLS3, §§1.11–1.13, especially 1.13.1–1.13.3, and 2.6.5.
The Levi decomposition and radical identification require further geometry;
these conclusions are not included in the definitions below.
-/

@[expose] public noncomputable section

namespace Theory.AlgebraicGroup.InvariantLeviGeometry

universe u
variable {k : Type u} [Field k] [IsAlgClosed k]
  {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
  (D : RootGroupData K T) (hD : D.IsRealization) (hT : IsSubtorus T)

/-- The closed subgroup generated by the torus and the standard parabolic roots. -/
def parabolic (positiveRoots sigmaJ : Set D.Root) : ClosedSubgroup K :=
  D.torusGeneratedClosedSubgroup hD hT (positiveRoots ∪ sigmaJ ∪ D.neg '' sigmaJ)

/-- The closed subgroup generated by positive roots outside the Levi subsystem. -/
def unipotent (positiveRoots sigmaJ : Set D.Root) : ClosedSubgroup K :=
  D.generatedClosedSubgroup hD (positiveRoots \ sigmaJ)

/-- The closed subgroup generated by the torus and the Levi roots. -/
def levi (sigmaJ : Set D.Root) : ClosedSubgroup K :=
  D.torusGeneratedClosedSubgroup hD hT (sigmaJ ∪ D.neg '' sigmaJ)

@[simp] theorem parabolic_toSubgroup (positiveRoots sigmaJ : Set D.Root) :
    (parabolic D hD hT positiveRoots sigmaJ).toSubgroup =
      T.toSubgroup ⊔ standardParabolicRootFactor D positiveRoots sigmaJ := rfl

@[simp] theorem unipotent_toSubgroup (positiveRoots sigmaJ : Set D.Root) :
    (unipotent D hD positiveRoots sigmaJ).toSubgroup =
      standardUnipotentRootFactor D positiveRoots sigmaJ := rfl

@[simp] theorem levi_toSubgroup (sigmaJ : Set D.Root) :
    (levi D hD hT sigmaJ).toSubgroup = standardLeviSubgroup D sigmaJ := rfl

/-- Closedness does not add any points to the three root-generated factors. -/
theorem candidates_connected (positiveRoots sigmaJ : Set D.Root) :
    _root_.IsConnected (parabolic D hD hT positiveRoots sigmaJ : Set (Variety.Point K)) ∧
    _root_.IsConnected (unipotent D hD positiveRoots sigmaJ : Set (Variety.Point K)) ∧
    _root_.IsConnected (levi D hD hT sigmaJ : Set (Variety.Point K)) :=
  ⟨D.torusGeneratedClosedSubgroup_connected hD hT _,
    D.generatedClosedSubgroup_connected hD _,
    D.torusGeneratedClosedSubgroup_connected hD hT _⟩

/-- Both factors lie in the standard parabolic point group. -/
theorem factors_le (positiveRoots sigmaJ : Set D.Root) :
    (unipotent D hD positiveRoots sigmaJ).toSubgroup ≤
      (parabolic D hD hT positiveRoots sigmaJ).toSubgroup ∧
    (levi D hD hT sigmaJ).toSubgroup ≤
      (parabolic D hD hT positiveRoots sigmaJ).toSubgroup := by
  constructor
  · exact (standardUnipotentRootFactor_le_standardParabolicRootFactor
      D positiveRoots sigmaJ).trans le_sup_right
  · exact sup_le_sup_left
      (standardLeviRootFactor_le_standardParabolicRootFactor D positiveRoots sigmaJ) _

/-- Partitioning positive roots into Levi roots and the complement generates
exactly the parabolic. Pointwise multiplication additionally needs normality. -/
theorem factors_sup (positiveRoots sigmaJ : Set D.Root) :
    (unipotent D hD positiveRoots sigmaJ).toSubgroup ⊔
      (levi D hD hT sigmaJ).toSubgroup =
        (parabolic D hD hT positiveRoots sigmaJ).toSubgroup := by
  classical
  apply le_antisymm (sup_le (factors_le D hD hT _ _).1 (factors_le D hD hT _ _).2)
  refine sup_le (le_sup_of_le_right le_sup_left) ?_
  apply RootSubgroupGenerated_le_of_rootSubgroup_le
  intro a ha
  rcases ha with (ha | ha) | ha
  · by_cases hs : a ∈ sigmaJ
    · exact (rootSubgroup_le_RootSubgroupGenerated D (Or.inl hs)).trans
        (le_sup_of_le_right le_sup_right)
    · exact (rootSubgroup_le_RootSubgroupGenerated D (A := positiveRoots \ sigmaJ) ⟨ha, hs⟩).trans le_sup_left
  · exact (rootSubgroup_le_RootSubgroupGenerated D (Or.inl ha)).trans
      (le_sup_of_le_right le_sup_right)
  · exact (rootSubgroup_le_RootSubgroupGenerated D (Or.inr ha)).trans
      (le_sup_of_le_right le_sup_right)

/-- The alignment with the positive Borel supplies its containment and hence
parabolicity. This uses no standard-parabolic classification theorem. -/
theorem parabolic_of_positiveBorel (positiveRoots sigmaJ : Set D.Root)
    {B : ClosedSubgroup K} (hB : IsBorelOfPositiveSystem D positiveRoots B) :
    IsParabolicSubgroup (parabolic D hD hT positiveRoots sigmaJ) ∧
      B ≤ parabolic D hD hT positiveRoots sigmaJ := by
  have hle : B.toSubgroup ≤ (parabolic D hD hT positiveRoots sigmaJ).toSubgroup := by
    rw [hB.torus_unipotent_generate, hB.root_generated, parabolic_toSubgroup]
    apply sup_le_sup_left
    exact RootSubgroupGenerated_mono D (fun _ ha => Or.inl (Or.inl ha))
  exact ⟨⟨B, hB.borel, hle⟩, hle⟩

omit [IsAlgClosed k] in
/-- Exact transport of root groups transports the subgroup they generate. -/
theorem map_rootGenerated (f : Variety.Point K →* Variety.Point K)
    (e : D.Root ≃ D.Root)
    (hroot : ∀ a, (D.rootSubgroup a).toSubgroup.map f =
      (D.rootSubgroup (e a)).toSubgroup) (A : Set D.Root) :
    (RootSubgroupGenerated D A).map f = RootSubgroupGenerated D (e '' A) := by
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap, RootSubgroupGenerated_le_iff]
    intro a ha
    rw [← Subgroup.map_le_iff_le_comap, hroot]
    exact rootSubgroup_le_RootSubgroupGenerated D ⟨a, ha, rfl⟩
  · apply RootSubgroupGenerated_le_of_rootSubgroup_le
    rintro _ ⟨a, ha, rfl⟩
    rw [← hroot]
    exact Subgroup.map_mono (rootSubgroup_le_RootSubgroupGenerated D ha)

/-- Exact invariance of each closed point group from the actual root-group
permutation. Both positivity and the Levi root set must be preserved. -/
theorem candidates_map_eq (positiveRoots sigmaJ : Set D.Root)
    (f : Variety.Point K →* Variety.Point K) (e : D.Root ≃ D.Root)
    (hroot : ∀ a, (D.rootSubgroup a).toSubgroup.map f =
      (D.rootSubgroup (e a)).toSubgroup)
    (htorus : T.toSubgroup.map f = T.toSubgroup)
    (hpositive : e '' positiveRoots = positiveRoots)
    (hlevi : e '' sigmaJ = sigmaJ)
    (hneg : ∀ a, e (D.neg a) = D.neg (e a)) :
    (parabolic D hD hT positiveRoots sigmaJ).toSubgroup.map f =
        (parabolic D hD hT positiveRoots sigmaJ).toSubgroup ∧
    (unipotent D hD positiveRoots sigmaJ).toSubgroup.map f =
        (unipotent D hD positiveRoots sigmaJ).toSubgroup ∧
    (levi D hD hT sigmaJ).toSubgroup.map f =
        (levi D hD hT sigmaJ).toSubgroup := by
  have hnegative : e '' (D.neg '' sigmaJ) = D.neg '' sigmaJ := by
    rw [Set.image_image, show (fun a => e (D.neg a)) =
      (fun a => D.neg (e a)) from funext hneg, ← Set.image_image, hlevi]
  have hpar : e '' (positiveRoots ∪ sigmaJ ∪ D.neg '' sigmaJ) =
      positiveRoots ∪ sigmaJ ∪ D.neg '' sigmaJ := by
    rw [Set.image_union, Set.image_union, hpositive, hlevi, hnegative]
  have huni : e '' (positiveRoots \ sigmaJ) = positiveRoots \ sigmaJ := by
    rw [Set.image_sdiff e.injective, hpositive, hlevi]
  have hlev : e '' (sigmaJ ∪ D.neg '' sigmaJ) = sigmaJ ∪ D.neg '' sigmaJ := by
    rw [Set.image_union, hlevi, hnegative]
  simp only [parabolic_toSubgroup, unipotent_toSubgroup, levi_toSubgroup,
    standardLeviSubgroup, standardParabolicRootFactor, standardUnipotentRootFactor,
    standardLeviRootFactor, Subgroup.map_sup, htorus, map_rootGenerated D f e hroot,
    hpar, huni, hlev, and_self]

end Theory.AlgebraicGroup.InvariantLeviGeometry
