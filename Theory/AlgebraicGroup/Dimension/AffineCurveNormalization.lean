module

public import Mathlib.RingTheory.DiscreteValuationRing.TFAE
public import Mathlib.RingTheory.LocalProperties.IntegrallyClosed
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.RingTheory.NoetherNormalization
public import Theory.AlgebraicGroup.Bor1.SmoothRegularLocal

/-!
# Finite normalization of smooth affine curves

For a finitely generated integral algebra of transcendence degree one, this module packages
Noether normalization as a finite injective evaluation map `k[X] → A`.  Noether normalization
(Stacks Project, Tag 00OW) first produces a finite injection from a polynomial ring in finitely
many variables.  Those variables form a transcendence basis after mapping into the integral
extension, and the basis-cardinality formula forces their number to be one.  The distinguished
parameter is the image of `X`.

Transcendence degree one also makes every nonzero prime maximal.  For a smooth algebra over a
field, the local regularity theorem in `Theory.AlgebraicGroup.Bor1.SmoothRegularLocal` then makes
each maximal localization a Dedekind domain.  The local criterion for integral closedness shows
that the original algebra is normal, and it is therefore itself a Dedekind domain.  Together these
results are the finite-normalization and regularity inputs for affine Hopf curves.

They deliberately do not assert that `A = k[t]`: smooth integral affine curves of transcendence
degree one need not be affine lines.  Obtaining a singleton algebra generator requires the extra
Hopf/conilpotence argument supplied by the downstream curve-classification theorem.
-/

universe u v

namespace Theory.AlgebraicGroup

open scoped Cardinal

variable (k : Type u) (A : Type v) [Field k] [CommRing A] [Algebra k A]

/-- A finite Noether normalization of an affine curve, with its polynomial parameter implicit as
the image of `Polynomial.X`. -/
public structure AffineCurveNormalizationData where
  map : Polynomial k →ₐ[k] A
  injective : Function.Injective map
  finite : map.Finite

namespace AffineCurveNormalizationData

variable {k A}

/-- The element of the curve algebra corresponding to the coordinate of the normalizing affine
line. -/
@[expose]
public noncomputable def parameter (D : AffineCurveNormalizationData k A) : A :=
  D.map Polynomial.X

@[simp]
public theorem map_parameter (D : AffineCurveNormalizationData k A) :
    D.map Polynomial.X = D.parameter := rfl

/-- The normalization map is evaluation at its distinguished parameter. -/
public theorem map_eq_aeval (D : AffineCurveNormalizationData k A) :
    D.map = Polynomial.aeval D.parameter := by
  apply Polynomial.algHom_ext
  simp

/-- A Noether-normalizing curve parameter is transcendental over the base field. -/
public theorem parameter_transcendental (D : AffineCurveNormalizationData k A) :
    Transcendental k D.parameter := by
  rw [transcendental_iff_injective, ← D.map_eq_aeval]
  exact D.injective

/-- The curve algebra is finite as a module over the polynomial algebra generated by the
normalizing parameter. -/
public theorem finite_aeval (D : AffineCurveNormalizationData k A) :
    (Polynomial.aeval (R := k) D.parameter : Polynomial k →ₐ[k] A).Finite := by
  rw [← D.map_eq_aeval]
  exact D.finite

end AffineCurveNormalizationData

/-- A finitely generated integral algebra of transcendence degree one admits a finite injective
polynomial normalization. -/
public theorem exists_affineCurveNormalizationData_of_trdeg_eq_one
    [IsDomain A] [Algebra.FiniteType k A]
    (htrdeg : Algebra.trdeg k A = 1) :
    Nonempty (AffineCurveNormalizationData k A) := by
  obtain ⟨n, g, hg, hgfinite⟩ := exists_finite_inj_algHom_of_fg k A
  let B := MvPolynomial (Fin n) k
  let _ : Algebra B A := g.toRingHom.toAlgebra
  let _ : IsScalarTower k B A :=
    IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
  let _ : Algebra.IsIntegral B A := ⟨hgfinite.to_isIntegral⟩
  let _ : FaithfulSMul B A :=
    (faithfulSMul_iff_algebraMap_injective (R := B) (A := A)).mpr hg
  have hxB : IsTranscendenceBasis k (MvPolynomial.X : Fin n → B) :=
    IsTranscendenceBasis.mvPolynomial (Fin n) k
  have hxA : IsTranscendenceBasis k
      (algebraMap B A ∘ (MvPolynomial.X : Fin n → B)) :=
    hxB.algebraMap_comp
  have hnCard : Cardinal.lift.{v} #(Fin n) = 1 := by
    rw [hxA.lift_cardinalMk_eq_trdeg, htrdeg, Cardinal.lift_one]
  have hn : n = 1 := by
    simpa using hnCard
  subst n
  let e : Polynomial k ≃ₐ[k] MvPolynomial (Fin 1) k :=
    (MvPolynomial.uniqueAlgEquiv k (Fin 1)).symm
  let f : Polynomial k →ₐ[k] A := g.comp e.toAlgHom
  refine ⟨⟨f, hg.comp e.injective, ?_⟩⟩
  exact hgfinite.comp (AlgHom.Finite.of_surjective e.toAlgHom e.surjective)

/-- A finitely generated integral algebra of transcendence degree one has Krull dimension at most
one: its finite polynomial normalization is integral, so the dimension-one property of `k[X]`
transfers to the curve algebra. -/
public theorem dimensionLEOne_of_trdeg_eq_one [IsDomain A] [Algebra.FiniteType k A]
    (htrdeg : Algebra.trdeg k A = 1) : Ring.DimensionLEOne A := by
  let D := Classical.choice (exists_affineCurveNormalizationData_of_trdeg_eq_one k A htrdeg)
  let _ : Algebra (Polynomial k) A := D.map.toRingHom.toAlgebra
  let _ : Algebra.IsIntegral (Polynomial k) A := ⟨D.finite.to_isIntegral⟩
  exact Ring.DimensionLEOne.of_isIntegral (Polynomial k) A

/-- A smooth algebra over a field is a regular ring: all of its prime localizations are regular
local rings. -/
public theorem isRegularRing_of_smooth_over_field [Algebra.Smooth k A] : IsRegularRing A := by
  let _ : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  rw [isRegularRing_iff]
  intro p hp
  exact Bor1.isRegularLocalRing_localizationAtPrime_of_smooth k A p

/-- A smooth integral affine curve algebra is normal.  At a maximal ideal, regularity and the
dimension-one bound make the cotangent space at most one-dimensional, so the maximal ideal is
principal and the localization is Dedekind.  Integral closedness then descends from all maximal
localizations. -/
public theorem isIntegrallyClosed_of_smooth_trdeg_eq_one [IsDomain A] [Algebra.Smooth k A]
    (htrdeg : Algebra.trdeg k A = 1) : IsIntegrallyClosed A := by
  let _ : Ring.DimensionLEOne A := dimensionLEOne_of_trdeg_eq_one k A htrdeg
  apply IsIntegrallyClosed.of_localization_maximal
  intro p hp hmax
  let _ : p.IsPrime := hmax.isPrime
  let R := Localization.AtPrime p
  let _ : Ring.DimensionLEOne R :=
    Ring.DimensionLEOne.localization R p.primeCompl_le_nonZeroDivisors
  let _ : IsRegularLocalRing R :=
    Bor1.isRegularLocalRing_localizationAtPrime_of_smooth k A p
  have hcot : Module.finrank (IsLocalRing.ResidueField R)
      (IsLocalRing.CotangentSpace R) ≤ 1 := by
    have hcast := calc
      (↑(Module.finrank (IsLocalRing.ResidueField R)
          (IsLocalRing.CotangentSpace R)) : WithBot ℕ∞) = ringKrullDim R :=
        (IsRegularLocalRing.iff_finrank_cotangentSpace R).mp inferInstance
      _ ≤ (↑(1 : ℕ) : WithBot ℕ∞) :=
        Ring.krullDimLE_iff.mp (inferInstance : Ring.KrullDimLE 1 R)
    exact_mod_cast hcast
  have hprincipal : (IsLocalRing.maximalIdeal R).IsPrincipal :=
    IsLocalRing.finrank_cotangentSpace_le_one_iff.mp hcot
  let _ : IsDedekindDomain R :=
    ((tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain R).out 4 2).mp hprincipal
  infer_instance

/-- A smooth integral finitely generated algebra of transcendence degree one is a Dedekind
domain. -/
public theorem isDedekindDomain_of_smooth_trdeg_eq_one [IsDomain A] [Algebra.Smooth k A]
    (htrdeg : Algebra.trdeg k A = 1) : IsDedekindDomain A := by
  let hnoetherian : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  let hdim : Ring.DimensionLEOne A := dimensionLEOne_of_trdeg_eq_one k A htrdeg
  let hnormal : IsIntegrallyClosed A :=
    isIntegrallyClosed_of_smooth_trdeg_eq_one k A htrdeg
  refine (isDedekindDomain_iff A (FractionRing A)).mpr
    ⟨inferInstance, hnoetherian, hdim, ?_⟩
  exact (isIntegrallyClosed_iff (FractionRing A)).mp hnormal

end Theory.AlgebraicGroup
