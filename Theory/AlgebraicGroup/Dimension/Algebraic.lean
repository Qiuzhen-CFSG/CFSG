module

public import Mathlib.RingTheory.Flat.FaithfullyFlat.Algebra
public import Theory.AlgebraicGroup.Variety.CoordinateRing

universe u

/-! Algebraic control of fraction fields of affine coordinate rings. -/

namespace Theory.AlgebraicGroup

open scoped TensorProduct Cardinal

open LinearMap Submodule

variable {k : Type u} [Field k]

/-- `Polynomial.aeval` commutes with the quotient map to the coordinate ring. -/
public theorem aeval_quotient_X (V : Variety k) (i : V.Coordinates) (p : Polynomial k) :
    Polynomial.aeval (Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
        (MvPolynomial.X i)) p =
      Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
        (Polynomial.aeval (MvPolynomial.X (R := k) i) p) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simp [hp, hq]
  | monomial m a =>
      simp only [Polynomial.aeval_monomial, map_mul, map_pow]
      rw [show algebraMap k (MvPolynomial V.Coordinates k) a = MvPolynomial.C a from rfl]
      rw [show algebraMap k (MvPolynomial V.Coordinates k ⧸
            vanishingIdeal (Set.univ : Set (Variety.Point V))) a =
          Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
            (MvPolynomial.C a) from rfl]

/-- Evaluating `Polynomial.aeval (X i) p` at a point evaluates `p` at the
coordinate value. -/
public theorem evalPolynomial_aeval_X (V : Variety k) (x : Variety.Point V)
    (i : V.Coordinates) (p : Polynomial k) :
    evalPolynomial x.val (Polynomial.aeval (MvPolynomial.X (R := k) i) p) =
      p.eval (x.val i) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [Polynomial.aeval_add, Polynomial.eval_add]
      rw [show evalPolynomial x.val (Polynomial.aeval (MvPolynomial.X (R := k) i) p +
            Polynomial.aeval (MvPolynomial.X (R := k) i) q) =
          evalPolynomial x.val (Polynomial.aeval (MvPolynomial.X (R := k) i) p) +
            evalPolynomial x.val (Polynomial.aeval (MvPolynomial.X (R := k) i) q) from by
        simp [evalPolynomial]]
      rw [hp, hq]
  | monomial m a => simp [evalPolynomial, Polynomial.aeval_monomial]

/-- The canonical map to the fraction ring commutes with `Polynomial.aeval`. -/
public theorem aeval_algebraMap_fractionRing (A : Type u) [CommRing A] [Algebra k A]
    (a : A) (p : Polynomial k) :
    algebraMap A (FractionRing A) (Polynomial.aeval a p) =
      Polynomial.aeval (algebraMap A (FractionRing A) a) p := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [Polynomial.aeval_add, map_add, hp, hq, Polynomial.aeval_add]
  | monomial m a0 =>
      simp only [Polynomial.aeval_monomial, map_mul, map_pow]
      rw [show (algebraMap A (FractionRing A)) (algebraMap k A a0) =
          algebraMap k (FractionRing A) a0 from rfl]

/-- The image of the coordinate ring in its fraction ring is contained in the
subalgebra generated by the coordinate images. -/
public theorem algebraMap_coordinateRing_mem_adjoin (V : Variety k) :
    ∀ a : coordinateRing V,
      algebraMap (coordinateRing V) (FractionRing (coordinateRing V)) a ∈
        Algebra.adjoin k (Set.range (fun i : V.Coordinates =>
          algebraMap (coordinateRing V) (FractionRing (coordinateRing V))
            (Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
              (MvPolynomial.X i)))) := by
  classical
  intro a
  rcases Ideal.Quotient.mk_surjective a with ⟨p, hp⟩
  rw [Algebra.adjoin_range_eq_range_aeval]
  refine (AlgHom.mem_range (MvPolynomial.aeval (fun i : V.Coordinates =>
      algebraMap (coordinateRing V) (FractionRing (coordinateRing V))
        (Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
          (MvPolynomial.X i))))).mpr ⟨p, ?_⟩
  have haeval : MvPolynomial.aeval (fun i : V.Coordinates =>
      algebraMap (coordinateRing V) (FractionRing (coordinateRing V))
        (Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
          (MvPolynomial.X i))) p =
        algebraMap (coordinateRing V) (FractionRing (coordinateRing V))
          (Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V))) p) := by
    apply MvPolynomial.induction_on p
    · intro r
      rw [show MvPolynomial.aeval (fun i : V.Coordinates =>
          algebraMap (coordinateRing V) (FractionRing (coordinateRing V))
            (Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
              (MvPolynomial.X i))) (MvPolynomial.C r) =
          algebraMap k (FractionRing (coordinateRing V)) r from by simp]
      rw [show (algebraMap (coordinateRing V) (FractionRing (coordinateRing V)))
            (Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
              (MvPolynomial.C r)) =
          algebraMap (coordinateRing V) (FractionRing (coordinateRing V))
            (algebraMap k (coordinateRing V) r) from rfl]
      rw [show (algebraMap (coordinateRing V) (FractionRing (coordinateRing V)))
            (algebraMap k (coordinateRing V) r) =
          algebraMap k (FractionRing (coordinateRing V)) r from rfl]
    · intro p q hp hq
      simp [map_add, hp, hq]
    · intro i p hp
      simp [hp]
  rw [haeval, hp]

/-- The fraction ring of the coordinate ring is algebraic over the subalgebra
generated by the coordinate images. -/
public theorem fractionRing_isAlgebraic_of_coordinates (V : Variety k)
    [Nontrivial (coordinateRing V)] :
    Algebra.IsAlgebraic (Algebra.adjoin k (Set.range (fun i : V.Coordinates =>
      algebraMap (coordinateRing V) (FractionRing (coordinateRing V))
        (Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
          (MvPolynomial.X i))))) (FractionRing (coordinateRing V)) := by
  classical
  let B := Algebra.adjoin k (Set.range (fun i : V.Coordinates =>
    algebraMap (coordinateRing V) (FractionRing (coordinateRing V))
      (Ideal.Quotient.mk (vanishingIdeal (Set.univ : Set (Variety.Point V)))
        (MvPolynomial.X i))))
  refine ⟨fun t ↦ ?_⟩
  rcases IsLocalization.surj (M := nonZeroDivisors (coordinateRing V)) t with ⟨r, hsurj⟩
  let a' : FractionRing (coordinateRing V) :=
    algebraMap (coordinateRing V) (FractionRing (coordinateRing V)) r.1
  let s' : FractionRing (coordinateRing V) :=
    algebraMap (coordinateRing V) (FractionRing (coordinateRing V)) (r.2 : coordinateRing V)
  have ha' : a' ∈ B := algebraMap_coordinateRing_mem_adjoin V r.1
  have hs' : s' ∈ B := algebraMap_coordinateRing_mem_adjoin V (r.2 : coordinateRing V)
  have hEq : t * s' = a' := hsurj
  let sB : B := ⟨s', hs'⟩
  let aB : B := ⟨a', ha'⟩
  refine ⟨Polynomial.C sB * Polynomial.X - Polynomial.C aB, ?_, ?_⟩
  · have hcoeff : (Polynomial.C sB * Polynomial.X - Polynomial.C aB).coeff 1 = sB := by
      simp
    intro hp0
    have hsB : sB = 0 := by
      have hc := congrArg (fun q : Polynomial B => q.coeff 1) hp0
      simpa [hcoeff] using hc
    have hs' : s' = 0 := by
      have hc := congrArg (fun b : B => (b : FractionRing (coordinateRing V))) hsB
      simpa [sB] using hc
    have hr2 : (r.2 : coordinateRing V) = 0 := by
      exact (IsFractionRing.injective (coordinateRing V) (FractionRing (coordinateRing V)))
        (by simp [s'] at hs' ⊢)
    -- `r.2` is a non-zero-divisor, so it cannot be zero
    exact one_ne_zero (r.2.property.1 1 (by simp [hr2]))
  · have h2 : Polynomial.aeval t (Polynomial.C sB * Polynomial.X - Polynomial.C aB) =
        s' * t - a' := by
      simp [sB, aB]
    rw [h2]
    rw [← hEq]
    ring

/-- The fraction ring of a `k`-algebra that is algebraic over `k` is algebraic
over `k` (every element is a fraction `a / s` with `a`, `s` algebraic and `s`
invertible in the fraction ring). -/
public theorem fractionRing_isAlgebraic_of_algebraic {A : Type u} [CommRing A]
    [Algebra k A] (hA : Algebra.IsAlgebraic k A) :
    Algebra.IsAlgebraic k (FractionRing A) := by
  classical
  refine ⟨fun t ↦ ?_⟩
  rcases IsLocalization.surj (M := nonZeroDivisors A) t with ⟨r, hsurj⟩
  have ht : t * algebraMap A (FractionRing A) (r.2 : A) = algebraMap A (FractionRing A) r.1 := hsurj
  have hA' : IsAlgebraic k (algebraMap A (FractionRing A) r.1) :=
    IsAlgebraic.algebraMap (hA.1 r.1)
  have hs' : IsAlgebraic k (algebraMap A (FractionRing A) (r.2 : A)) :=
    IsAlgebraic.algebraMap (hA.1 (r.2 : A))
  have hInv : Invertible (algebraMap A (FractionRing A) (r.2 : A)) :=
    (IsLocalization.map_units (M := nonZeroDivisors A) (S := FractionRing A) r.2).invertible
  have hsinv : IsAlgebraic k (⅟(algebraMap A (FractionRing A) (r.2 : A))) :=
    (IsAlgebraic.invOf_iff (R := k) (x := algebraMap A (FractionRing A) (r.2 : A))).mpr hs'
  have hprod : IsAlgebraic k (algebraMap A (FractionRing A) r.1 *
      ⅟(algebraMap A (FractionRing A) (r.2 : A))) := hA'.mul hsinv
  have ht' : t = algebraMap A (FractionRing A) r.1 * ⅟(algebraMap A (FractionRing A) (r.2 : A)) := by
    calc
      t = t * (algebraMap A (FractionRing A) (r.2 : A) *
          ⅟(algebraMap A (FractionRing A) (r.2 : A))) := by
        rw [mul_invOf_self, mul_one]
      _ = t * algebraMap A (FractionRing A) (r.2 : A) * ⅟(algebraMap A (FractionRing A) (r.2 : A)) := by
        rw [mul_assoc]
      _ = algebraMap A (FractionRing A) r.1 * ⅟(algebraMap A (FractionRing A) (r.2 : A)) := by
        rw [ht]
  simpa [ht'] using hprod

end Theory.AlgebraicGroup
