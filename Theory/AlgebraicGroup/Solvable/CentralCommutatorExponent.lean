module

public import Theory.AlgebraicGroup.RightTranslation.Representation
public import Theory.AlgebraicGroup.Solvable.CentralCommutatorExponent.Linear

/-!
# Uniform exponent for central commutators in characteristic two

An affine algebraic group has a faithful finite-dimensional representation on the
space generated by right translates of its affine coordinates. If this space has
dimension `n`, central commutators are killed by `n! * 2^n`: apply the eigenspace
and determinant argument for linear automorphisms and then use faithfulness.

The representation is the coordinate-translation construction from Borel,
*Linear Algebraic Groups*, Chapter I; the positive-characteristic unipotent
power calculation is §4.1(a), in `refs/KGroup/Bor1/Chapter1.tex`.
-/

namespace Theory.AlgebraicGroup

open scoped commutatorElement

variable {k : Type*} [Field k] [IsAlgClosed k] [CharP k 2]

/-- Central commutators in a characteristic-two algebraic group have a common
positive exponent, depending only on the group. No nilpotence or finiteness
hypothesis on its group of points is required. -/
public theorem exists_centralCommutatorExponent (G : Variety k) [AlgebraicGroup G] :
    ∃ m : ℕ, 0 < m ∧ ∀ x y : Variety.Point G,
      Commute ⁅x, y⁆ x → Commute ⁅x, y⁆ y → ⁅x, y⁆ ^ m = 1 := by
  let : Module.Finite k (coordinateTranslationSubmodule G) :=
    coordinateTranslationSubmodule_finite G
  let n := Module.finrank k (coordinateTranslationSubmodule G)
  refine ⟨n.factorial * 2 ^ n,
    Nat.mul_pos (Nat.factorial_pos n) (pow_pos (by decide) n), ?_⟩
  intro x y hx hy
  let ρ := coordinateTranslationRepresentation G
  apply coordinateTranslationRepresentation_injective G
  change ρ (⁅x, y⁆ ^ (n.factorial * 2 ^ n)) = ρ 1
  rw [map_pow, map_commutatorElement, map_one]
  exact LinearMap.GeneralLinearGroup.centralCommutator_pow_factorial_mul_two_pow_finrank
    (ρ x) (ρ y) (by simpa only [map_commutatorElement] using hx.map ρ)
    (by simpa only [map_commutatorElement] using hy.map ρ)

end Theory.AlgebraicGroup
