module

public import Mathlib.RingTheory.Nullstellensatz
public import Theory.AlgebraicGroup.Bor1.CoordinateRingSmooth
public import Theory.AlgebraicGroup.Bor1.SmoothSemisimpleWeightIdeal
public import Theory.AlgebraicGroup.Bor1.TangentVanishingIdeal
public import Theory.AlgebraicGroup.Jordan.Conjugation

universe u

namespace Theory.AlgebraicGroup.Bor1

open Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

/-!
This module applies the smooth nontrivial-weight ideal theorem to the
coordinate-ring argument for the fixed locus of a semisimple polynomial
automorphism.  The automorphism contract includes local finiteness of pullback:
together with `IsSemisimpleAutomorphism`, which controls finite invariant
submodules, this makes the coordinate ring spanned by eigenvectors and makes
the ideal generated by the nontrivial weights radical.  The ideal generated by
pullback differences `ψ⁺f - f` is the same weight ideal.

The affine Nullstellensatz identifies the ideal of functions vanishing on the
rational fixed points with the radical of that difference ideal.  Radicality
therefore identifies all three ideals and supplies the weight-generation and
reducedness contracts used by the cotangent argument.  The public
`fixedPointIdealWeightGeneration_of_semisimple` and
`fixedPointIdealReducedAtIdentity_of_semisimple` theorems expose these two
conclusions without auxiliary fixed-locus hypotheses.  Consequently
`identityDerivation_eq_zero_of_semisimple_fixedPoint_vanishing` is the direct
cotangent exactness statement needed by the semisimple infinitesimal
stabilizer argument.

The mathematical source is GLS Bor1, Proposition 9.1.  The explicit inverse
and local-finiteness field repair the former interface, which accepted an
arbitrary polynomial endomorphism and could not justify an eigenspace
decomposition of its coordinate ring.
-/

/-- An explicit polynomial automorphism of a presented affine variety. -/
public structure PolynomialAutomorphismContract (G : Variety k)
    [AlgebraicGroup G] where
  forward : Variety.Morphism G G
  inverse : Variety.Morphism G G
  fixes_one : forward.toFun 1 = 1
  left_inv : ∀ x, inverse.toFun (forward.toFun x) = x
  right_inv : ∀ x, forward.toFun (inverse.toFun x) = x
  pullback_locallyFinite :
    Theory.AlgebraicGroup.Module.End.IsLocallyFinite
      forward.pullbackAlgHom.toLinearMap

/-- Conjugation by a group point, packaged with its inverse and the locally
finite pullback action required by the fixed-point argument. -/
public def conjugationPolynomialAutomorphismContract
    (G : Variety k) [AlgebraicGroup G] (s : Variety.Point G) :
    PolynomialAutomorphismContract (k := k) G where
  forward := AlgebraicGroup.conjugationByMorphism G s
  inverse := AlgebraicGroup.conjugationByMorphism G s⁻¹
  fixes_one := by simp [AlgebraicGroup.conjugationByMorphism_apply]
  left_inv := by
    intro x
    simp only [AlgebraicGroup.conjugationByMorphism_apply]
    group
  right_inv := by
    intro x
    simp only [AlgebraicGroup.conjugationByMorphism_apply]
    group
  pullback_locallyFinite := conjugationPullback_locallyFinite G s

/-- The scheme-theoretic fixed-point ideal generated by pullback differences. -/
public def fixedPointDifferenceIdeal
    {A : Type u} [CommRing A] [Algebra k A]
    (φ : A →ₐ[k] A) : Ideal A :=
  Ideal.span (Set.range fun a => φ a - a)

/-- The ideal of regular functions vanishing at every rational fixed point of a
polynomial self-map. -/
public def fixedPointVanishingIdeal
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G) : Ideal G.PolynomialFunction where
  carrier := {f | ∀ x : Variety.Point G, ψ.toFun x = x → f x = 0}
  zero_mem' := by
    intro x hx
    simp
  add_mem' := by
    intro f g hf hg x hx
    change f x + g x = 0
    rw [hf x hx, hg x hx, add_zero]
  smul_mem' := by
    intro a f hf x hx
    change a x * f x = 0
    rw [hf x hx, mul_zero]

omit [IsAlgClosed k] in
/-- Membership in the rational fixed-point vanishing ideal is pointwise
vanishing on every fixed rational point. -/
public theorem mem_fixedPointVanishingIdeal_iff
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    (f : G.PolynomialFunction) :
    f ∈ fixedPointVanishingIdeal G ψ ↔
      ∀ x : Variety.Point G, ψ.toFun x = x → f x = 0 :=
  Iff.rfl

/-- The repaired polynomial-automorphism contract and finite semisimplicity give
the eigenspace decomposition needed by the fixed-ideal argument. -/
public theorem pullback_weightVectors_span_eq_top
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsem : IsSemisimpleAutomorphism G ψ.forward) :
    Submodule.span k (weightVectors ψ.forward.pullbackAlgHom) = ⊤ :=
  weightVectors_span_eq_top_of_locallyFinite_of_finitelySemisimple
    ψ.forward.pullbackAlgHom ψ.pullback_locallyFinite hsem

/-- The pullback of a semisimple polynomial automorphism has radical
nontrivial-weight ideal. -/
public theorem pullback_weightIdeal_isRadical
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsem : IsSemisimpleAutomorphism G ψ.forward) :
    (Ideal.span
      (nontrivialWeightVectors ψ.forward.pullbackAlgHom)).IsRadical := by
  let _ : Algebra.Smooth k G.PolynomialFunction :=
    polynomialFunction_smooth_of_algebraicGroup G
  exact weightIdeal_isRadical_of_locallyFinite_of_finitelySemisimple
    ψ.forward.pullbackAlgHom ψ.pullback_locallyFinite hsem

omit [IsAlgClosed k] in
/-- If an algebra is spanned by eigenvectors, its pullback-difference ideal is
generated by precisely the eigenvectors whose eigenvalue is not one. -/
public theorem fixedPointDifferenceIdeal_eq_weightIdeal_of_weightVectors_span
    {A : Type u} [CommRing A] [Algebra k A]
    (φ : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors φ) = ⊤) :
    fixedPointDifferenceIdeal φ = Ideal.span (nontrivialWeightVectors φ) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨a, rfl⟩
    have ha : a ∈ Submodule.span k (weightVectors φ) := by
      rw [hspan]
      trivial
    induction ha using Submodule.span_induction with
    | mem b hb =>
        change φ b - b ∈ Ideal.span (nontrivialWeightVectors φ)
        rcases hb with ⟨c, hc⟩
        by_cases hc1 : c = 1
        · subst c
          rw [hc]
          simp
        · have hbmem : b ∈ Ideal.span (nontrivialWeightVectors φ) :=
            Ideal.subset_span ⟨c, hc1, hc⟩
          have hmul := (Ideal.span (nontrivialWeightVectors φ)).mul_mem_left
            (algebraMap k A c - 1) hbmem
          rw [hc]
          simpa [sub_mul] using hmul
    | zero => simp
    | add a b _ _ ha hb =>
        change φ (a + b) - (a + b) ∈ Ideal.span (nontrivialWeightVectors φ)
        rw [map_add]
        convert (Ideal.span (nontrivialWeightVectors φ)).add_mem ha hb using 1
        all_goals ring
    | smul c a _ ha =>
        change φ (c • a) - c • a ∈ Ideal.span (nontrivialWeightVectors φ)
        rw [map_smul]
        have := (Ideal.span (nontrivialWeightVectors φ)).mul_mem_left
          (algebraMap k A c) ha
        simpa [Algebra.smul_def, mul_sub] using this
  · apply Ideal.span_le.mpr
    intro a ha
    rcases ha with ⟨c, hc1, hc⟩
    have hdiff : φ a - a ∈ fixedPointDifferenceIdeal φ :=
      Ideal.subset_span ⟨a, rfl⟩
    have hmul := (fixedPointDifferenceIdeal φ).mul_mem_left
      (algebraMap k A (c - 1)⁻¹) hdiff
    have hcsub : c - 1 ≠ 0 := sub_ne_zero.mpr hc1
    rw [hc] at hmul
    have hca : algebraMap k A c * a - a = algebraMap k A (c - 1) * a := by
      rw [map_sub, map_one, sub_mul, one_mul]
    rw [hca, ← mul_assoc, ← map_mul] at hmul
    simpa [hcsub] using hmul

omit [IsAlgClosed k] in
/-- The ideal of functions vanishing on rational fixed points is radical. -/
public theorem fixedPointVanishingIdeal_isRadical
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G) :
    (fixedPointVanishingIdeal G ψ).IsRadical := by
  rw [Ideal.isRadical_iff_pow_one_lt 2 (by decide)]
  intro f hf x hx
  have hfx := hf x hx
  change f x ^ 2 = 0 at hfx
  exact sq_eq_zero_iff.mp hfx

omit [IsAlgClosed k] in
/-- Pullback differences vanish at every rational fixed point. -/
public theorem fixedPointDifferenceIdeal_le_fixedPointVanishingIdeal
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G) :
    fixedPointDifferenceIdeal ψ.pullbackAlgHom ≤
      fixedPointVanishingIdeal G ψ := by
  apply Ideal.span_le.mpr
  rintro _ ⟨a, rfl⟩ x hx
  change a (ψ.toFun x) - a x = 0
  rw [hx, sub_self]

/-- Over an algebraically closed field, the rational fixed-point vanishing
ideal is the radical of the pullback-difference ideal. -/
public theorem fixedPointVanishingIdeal_eq_radical_differenceIdeal
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G) :
    fixedPointVanishingIdeal G ψ =
      (fixedPointDifferenceIdeal ψ.pullbackAlgHom).radical := by
  apply le_antisymm
  · intro f hf
    obtain ⟨p, hp⟩ := evaluationRingHom_surjective G f
    let q := evaluationRingHom (V := G)
    let J := fixedPointDifferenceIdeal ψ.pullbackAlgHom
    have hpq : q p = f := hp
    have hpRad : p ∈ (J.comap q).radical := by
      rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := k)]
      intro z hz
      have hzEq : ∀ r, q r ∈ J → evalPolynomial z r = 0 := by
        intro r hr
        exact hz r hr
      have hzG : ∀ r ∈ G.equations, evalPolynomial z r = 0 := by
        intro r hr
        apply hzEq r
        have hqr : q r = 0 := by
          apply Variety.PolynomialFunction.ext
          intro x
          change evalPolynomial x.val r = 0
          exact x.isZero r hr
        rw [hqr]
        exact J.zero_mem
      let x : Variety.Point G := ⟨z, hzG⟩
      have hJzero : ∀ a ∈ J, a x = 0 := by
        intro a ha
        obtain ⟨r, rfl⟩ := evaluationRingHom_surjective G a
        exact hzEq r ha
      have hxfix : ψ.toFun x = x := by
        apply Variety.Point.ext
        funext i
        let Xi : G.PolynomialFunction :=
          Variety.PolynomialFunction.ofPolynomial G (MvPolynomial.X i)
        have hd : ψ.pullbackAlgHom Xi - Xi ∈ J :=
          Ideal.subset_span ⟨Xi, rfl⟩
        have hzero := hJzero _ hd
        change Xi (ψ.toFun x) - Xi x = 0 at hzero
        have hcoord : (ψ.toFun x).val i - x.val i = 0 := by
          simpa [Xi, Variety.PolynomialFunction.ofPolynomial,
            Variety.PolynomialFunction.toFun, evalPolynomial] using hzero
        exact sub_eq_zero.mp hcoord
      have hfx := hf x hxfix
      change f x = 0 at hfx
      rw [← hpq] at hfx
      exact hfx
    rcases hpRad with ⟨n, hn⟩
    refine ⟨n, ?_⟩
    rw [← hpq, ← map_pow]
    exact hn
  · apply (fixedPointVanishingIdeal_isRadical G ψ).radical_le_iff.mpr
    exact fixedPointDifferenceIdeal_le_fixedPointVanishingIdeal G ψ

/-- A semisimple automorphism satisfying the repaired local-finiteness contract
has rational fixed-point ideal equal to the radical of its nontrivial-weight
ideal. -/
public theorem fixedPointVanishingIdeal_eq_radical_weightIdeal_of_semisimple
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsem : IsSemisimpleAutomorphism G ψ.forward) :
    fixedPointVanishingIdeal G ψ.forward =
      (Ideal.span
        (nontrivialWeightVectors ψ.forward.pullbackAlgHom)).radical := by
  rw [fixedPointVanishingIdeal_eq_radical_differenceIdeal]
  rw [fixedPointDifferenceIdeal_eq_weightIdeal_of_weightVectors_span _
    (pullback_weightVectors_span_eq_top G ψ hsem)]

/-- The regular fixed-ideal contract: the square of every function vanishing on
all fixed rational points belongs to the ideal generated by nontrivial weight
vectors. The separate reducedness clause then recovers the function itself. -/
public def FixedPointIdealWeightGeneration
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G) : Prop :=
  ∀ f : G.PolynomialFunction,
    f ∈ fixedPointVanishingIdeal G ψ →
      f ^ 2 ∈ Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom)

/-- The reducedness clause used by the fixed-ideal construction.  We state the
global square-root property of the weight ideal, which in particular supplies
the reducedness needed after localization at the augmentation. -/
public def FixedPointIdealReducedAtIdentity
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G) : Prop :=
  ∀ f : G.PolynomialFunction,
    f ^ 2 ∈ Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom) →
      f ∈ Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom)

omit [IsAlgClosed k] in
/-- Radicality of the nontrivial-weight ideal supplies the historical
square-root reducedness contract. -/
public theorem fixedPointIdealReducedAtIdentity_of_weightIdeal_isRadical
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    (hradical :
      (Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom)).IsRadical) :
    FixedPointIdealReducedAtIdentity G ψ := by
  rw [Ideal.isRadical_iff_pow_one_lt 2 (by decide)] at hradical
  exact hradical

/-- Once the nontrivial-weight ideal is radical, semisimplicity and local
finiteness identify it with the rational fixed-point vanishing ideal. -/
public theorem fixedPointVanishingIdeal_eq_weightIdeal_of_semisimple_of_isRadical
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsem : IsSemisimpleAutomorphism G ψ.forward)
    (hradical : (Ideal.span
      (nontrivialWeightVectors ψ.forward.pullbackAlgHom)).IsRadical) :
    fixedPointVanishingIdeal G ψ.forward =
      Ideal.span (nontrivialWeightVectors ψ.forward.pullbackAlgHom) := by
  rw [fixedPointVanishingIdeal_eq_radical_weightIdeal_of_semisimple G ψ hsem]
  exact hradical.radical

/-- Radicality of the weight ideal also supplies the historical square
weight-generation contract. -/
public theorem fixedPointIdealWeightGeneration_of_semisimple_of_isRadical
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsem : IsSemisimpleAutomorphism G ψ.forward)
    (hradical : (Ideal.span
      (nontrivialWeightVectors ψ.forward.pullbackAlgHom)).IsRadical) :
    FixedPointIdealWeightGeneration G ψ.forward := by
  intro f hf
  have hfWeight :
      f ∈ Ideal.span (nontrivialWeightVectors ψ.forward.pullbackAlgHom) := by
    rw [← fixedPointVanishingIdeal_eq_weightIdeal_of_semisimple_of_isRadical
      G ψ hsem hradical]
    exact hf
  exact Ideal.pow_mem_of_mem
    (Ideal.span (nontrivialWeightVectors ψ.forward.pullbackAlgHom))
    hfWeight 2 (by decide)

/-- A semisimple polynomial automorphism of an algebraic group satisfies the
fixed-point weight-generation contract.  Smoothness of the coordinate ring is
supplied by the algebraic-group structure. -/
public theorem fixedPointIdealWeightGeneration_of_semisimple
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsem : IsSemisimpleAutomorphism G ψ.forward) :
    FixedPointIdealWeightGeneration G ψ.forward :=
  fixedPointIdealWeightGeneration_of_semisimple_of_isRadical G ψ hsem
    (pullback_weightIdeal_isRadical G ψ hsem)

/-- A semisimple polynomial automorphism of an algebraic group satisfies the
square-root reducedness contract for its nontrivial-weight ideal. -/
public theorem fixedPointIdealReducedAtIdentity_of_semisimple
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsem : IsSemisimpleAutomorphism G ψ.forward) :
    FixedPointIdealReducedAtIdentity G ψ.forward :=
  fixedPointIdealReducedAtIdentity_of_weightIdeal_isRadical G ψ.forward
    (pullback_weightIdeal_isRadical G ψ hsem)

omit [IsAlgClosed k] in
private lemma nontrivialWeightVector_mem_fixedPointVanishingIdeal
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    {a : G.PolynomialFunction}
    (ha : a ∈ nontrivialWeightVectors ψ.pullbackAlgHom) :
    a ∈ fixedPointVanishingIdeal G ψ := by
  rcases ha with ⟨c, hc, ha⟩
  intro x hx
  have h := congrArg (fun f : G.PolynomialFunction => f x) ha
  have hpull : (ψ.pullbackAlgHom a) x = a (ψ.toFun x) := rfl
  rw [hpull] at h
  have h' : a (ψ.toFun x) = c * a x := by
    simpa only [polynomialFunction_mul_apply,
      polynomialFunction_algebraMap_apply] using h
  rw [hx] at h'
  have : (c - 1) * a x = 0 := by
    calc
      (c - 1) * a x = c * a x - a x := by ring
      _ = 0 := by rw [← h', sub_self]
  exact (mul_eq_zero.mp this).resolve_left (sub_ne_zero.mpr hc)

omit [IsAlgClosed k] in
/-- Every nontrivial weight vector vanishes on the fixed-point locus, hence the
weight ideal is contained in the fixed-point vanishing ideal. -/
public theorem weightIdeal_le_fixedPointVanishingIdeal
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G) :
    Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom) ≤
      fixedPointVanishingIdeal G ψ := by
  apply Ideal.span_le.mpr
  intro a ha
  exact nontrivialWeightVector_mem_fixedPointVanishingIdeal G ψ ha

omit [IsAlgClosed k] in
/-- The fixed-point contract and its reducedness clause identify the regular
fixed ideal with the ideal generated by nontrivial weights. -/
public theorem fixedPointVanishingIdeal_le_weightIdeal
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    (hfixed : FixedPointIdealWeightGeneration G ψ)
    (hreduced : FixedPointIdealReducedAtIdentity G ψ) :
    fixedPointVanishingIdeal G ψ ≤
      Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom) := by
  intro f hf
  exact hreduced f (hfixed f hf)

omit [IsAlgClosed k] in
/-- The reducedness clause is exactly radicality of the nontrivial-weight
ideal.  We record this in the standard ideal-theoretic form for downstream
localization arguments. -/
public theorem weightIdeal_isRadical_of_fixedPointIdealReduced
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    (hreduced : FixedPointIdealReducedAtIdentity G ψ) :
    (Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom)).IsRadical := by
  rw [Ideal.isRadical_iff_pow_one_lt 2 (by decide)]
  exact hreduced

omit [IsAlgClosed k] in
/-- Under the two regular fixed-ideal clauses, the rational fixed-point
vanishing ideal is the nontrivial-weight ideal. -/
public theorem fixedPointVanishingIdeal_eq_weightIdeal
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    (hfixed : FixedPointIdealWeightGeneration G ψ)
    (hreduced : FixedPointIdealReducedAtIdentity G ψ) :
    fixedPointVanishingIdeal G ψ =
      Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom) := by
  exact le_antisymm
    (fixedPointVanishingIdeal_le_weightIdeal G ψ hfixed hreduced)
    (weightIdeal_le_fixedPointVanishingIdeal G ψ)

omit [IsAlgClosed k] in
/-- The regular fixed-ideal clauses recover membership for every function
vanishing on the fixed rational points. -/
public theorem fixedPointIdeal_mem_of_vanishing
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    (hfixed : FixedPointIdealWeightGeneration G ψ)
    (hreduced : FixedPointIdealReducedAtIdentity G ψ)
    (f : G.PolynomialFunction)
    (hf : f ∈ fixedPointVanishingIdeal G ψ) :
    f ∈ Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom) :=
  hreduced f (hfixed f hf)

omit [IsAlgClosed k] in
private lemma derivation_zero_of_nontrivial_weight
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    (D : IdentityPointDerivation G)
    (hD : ∀ f : G.PolynomialFunction,
      D (ψ.pullbackAlgHom f) = D f)
    {a : G.PolynomialFunction}
    (ha : a ∈ nontrivialWeightVectors ψ.pullbackAlgHom) :
    D a = 0 := by
  rcases ha with ⟨c, hc, ha⟩
  have hcD : c * D a = D a := by
    calc
      c * D a = D (algebraMap k G.PolynomialFunction c * a) := by
        rw [D.leibniz, D.map_algebraMap]
        simp
      _ = D (ψ.pullbackAlgHom a) := by rw [← ha]
      _ = D a := hD a
  have : (c - 1) * D a = 0 := by
    calc
      (c - 1) * D a = c * D a - D a := by ring
      _ = 0 := by rw [hcD, sub_self]
  have hcsub : c - 1 ≠ 0 := sub_ne_zero.mpr hc
  exact (mul_eq_zero.mp this).resolve_left hcsub

omit [IsAlgClosed k] in
private lemma weight_vector_vanishes_at_one
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    (hψone : ψ.toFun 1 = 1)
    {a : G.PolynomialFunction}
    (ha : a ∈ nontrivialWeightVectors ψ.pullbackAlgHom) :
    a 1 = 0 := by
  rcases ha with ⟨c, hc, ha⟩
  have h := congrArg (fun f : G.PolynomialFunction => f 1) ha
  have hpull : (ψ.pullbackAlgHom a) 1 = a (ψ.toFun 1) := rfl
  rw [hpull] at h
  have h' : a (ψ.toFun 1) = c * a 1 := by
    simpa only [polynomialFunction_mul_apply,
      polynomialFunction_algebraMap_apply] using h
  rw [hψone] at h'
  have : (c - 1) * a 1 = 0 := by
    calc
      (c - 1) * a 1 = c * a 1 - a 1 := by ring
      _ = 0 := by rw [← h', sub_self]
  exact (mul_eq_zero.mp this).resolve_left (sub_ne_zero.mpr hc)

omit [IsAlgClosed k] in
private lemma derivation_zero_on_weightIdeal
    (G : Variety k) [AlgebraicGroup G]
    (ψ : Variety.Morphism G G)
    (hψone : ψ.toFun 1 = 1)
    (D : IdentityPointDerivation G)
    (hD : ∀ f : G.PolynomialFunction,
      D (ψ.pullbackAlgHom f) = D f) :
    ∀ f ∈ Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom), D f = 0 := by
  intro f hf
  have hstrong : ∀ a ∈ Ideal.span (nontrivialWeightVectors ψ.pullbackAlgHom),
      D a = 0 ∧ a 1 = 0 := by
    intro a ha
    induction ha using Submodule.span_induction with
    | mem b hb =>
        exact ⟨derivation_zero_of_nontrivial_weight G ψ D hD hb,
          weight_vector_vanishes_at_one G ψ hψone hb⟩
    | zero => exact ⟨map_zero D, by simp⟩
    | add b c _ _ hb hc =>
        rw [map_add, hb.1, hc.1, add_zero]
        exact ⟨rfl, by
          change b 1 + c 1 = 0
          rw [hb.2, hc.2, add_zero]⟩
    | smul c b _ hb =>
        constructor
        · change D (c * b) = 0
          rw [D.leibniz]
          change c 1 * D b + b 1 * D c = 0
          rw [hb.1, hb.2]
          rw [mul_zero, zero_mul, add_zero]
        · change (c * b) 1 = 0
          rw [polynomialFunction_mul_apply, hb.2, mul_zero]
  exact (hstrong f hf).1

/-- Invariant identity derivations annihilate the regular fixed ideal once the
weight-generation and reducedness clauses are supplied explicitly. -/
public theorem identityDerivation_eq_zero_of_semisimple_fixedPoint_vanishing_of_fixedIdeal
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsmooth : Algebra.Smooth k G.PolynomialFunction)
    (hsemisimple : IsSemisimpleAutomorphism G ψ.forward)
    (hfixed : FixedPointIdealWeightGeneration G ψ.forward)
    (hreduced : FixedPointIdealReducedAtIdentity G ψ.forward)
    (D : IdentityPointDerivation G)
    (hD : ∀ f : G.PolynomialFunction,
      D (ψ.forward.pullbackAlgHom f) = D f)
    (f : G.PolynomialFunction)
    (hf : f ∈ fixedPointVanishingIdeal G ψ.forward) :
    D f = 0 := by
  let _ := hsmooth
  let _ := hfixed
  have hradical :
      (Ideal.span
        (nontrivialWeightVectors ψ.forward.pullbackAlgHom)).IsRadical :=
    weightIdeal_isRadical_of_fixedPointIdealReduced G ψ.forward hreduced
  have heq := fixedPointVanishingIdeal_eq_weightIdeal_of_semisimple_of_isRadical
    G ψ hsemisimple hradical
  have hmem : f ∈ Ideal.span (nontrivialWeightVectors ψ.forward.pullbackAlgHom) := by
    rw [← heq]
    exact hf
  apply derivation_zero_on_weightIdeal G ψ.forward
    ψ.fixes_one D hD f
  exact hmem

/-- The cotangent conclusion in the repaired API: the geometric fixed-locus
argument only has to prove radicality of the nontrivial-weight ideal. -/
public theorem identityDerivation_eq_zero_of_semisimple_fixedPoint_vanishing_of_isRadical
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsmooth : Algebra.Smooth k G.PolynomialFunction)
    (hsemisimple : IsSemisimpleAutomorphism G ψ.forward)
    (hradical : (Ideal.span
      (nontrivialWeightVectors ψ.forward.pullbackAlgHom)).IsRadical)
    (D : IdentityPointDerivation G)
    (hD : ∀ f : G.PolynomialFunction,
      D (ψ.forward.pullbackAlgHom f) = D f)
    (f : G.PolynomialFunction)
    (hf : f ∈ fixedPointVanishingIdeal G ψ.forward) :
    D f = 0 := by
  apply identityDerivation_eq_zero_of_semisimple_fixedPoint_vanishing_of_fixedIdeal
    G ψ hsmooth hsemisimple
    (fixedPointIdealWeightGeneration_of_semisimple_of_isRadical
      G ψ hsemisimple hradical)
    (fixedPointIdealReducedAtIdentity_of_weightIdeal_isRadical
      G ψ.forward hradical)
    D hD f hf

/-- Invariant identity derivations annihilate the fixed-point vanishing ideal
of a semisimple polynomial automorphism, without auxiliary fixed-locus
smoothness or reducedness hypotheses. -/
public theorem identityDerivation_eq_zero_of_semisimple_fixedPoint_vanishing
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsemisimple : IsSemisimpleAutomorphism G ψ.forward)
    (D : IdentityPointDerivation G)
    (hD : ∀ f : G.PolynomialFunction,
      D (ψ.forward.pullbackAlgHom f) = D f)
    (f : G.PolynomialFunction)
    (hf : f ∈ fixedPointVanishingIdeal G ψ.forward) :
    D f = 0 := by
  exact identityDerivation_eq_zero_of_semisimple_fixedPoint_vanishing_of_fixedIdeal
    G ψ (polynomialFunction_smooth_of_algebraicGroup G) hsemisimple
      (fixedPointIdealWeightGeneration_of_semisimple G ψ hsemisimple)
      (fixedPointIdealReducedAtIdentity_of_semisimple G ψ hsemisimple)
      D hD f hf

/-- Compatibility alias for the assumption-free fixed-locus cotangent
exactness theorem. -/
public theorem identityDerivation_eq_zero_of_semisimple_fixedPoint_vanishing_unconditional
    (G : Variety k) [AlgebraicGroup G]
    (ψ : PolynomialAutomorphismContract (k := k) G)
    (hsemisimple : IsSemisimpleAutomorphism G ψ.forward)
    (D : IdentityPointDerivation G)
    (hD : ∀ f : G.PolynomialFunction,
      D (ψ.forward.pullbackAlgHom f) = D f)
    (f : G.PolynomialFunction)
    (hf : f ∈ fixedPointVanishingIdeal G ψ.forward) :
    D f = 0 :=
  identityDerivation_eq_zero_of_semisimple_fixedPoint_vanishing
    G ψ hsemisimple D hD f hf

