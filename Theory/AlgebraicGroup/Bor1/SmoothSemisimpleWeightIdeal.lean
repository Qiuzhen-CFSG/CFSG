module

public import Mathlib.LinearAlgebra.Eigenspace.Semisimple
public import Mathlib.LinearAlgebra.Projection
public import Mathlib.RingTheory.Smooth.Basic
public import Theory.AlgebraicGroup.Bor1.SmoothReduced
public import Theory.AlgebraicGroup.Jordan.LocallyFiniteEndomorphism

universe u

/-!
This module proves the algebraic core of the smooth semisimple fixed-locus
argument used in GLS Bor1, Proposition 9.1.  For a locally finite algebra
endomorphism which is semisimple on every finite invariant submodule, its
ambient algebra is spanned by weight vectors.  If the algebra is smooth over a
field, the ideal generated by all nontrivial weight vectors is radical.

The proof splits the algebra, as a vector space, into the weight-one eigenspace
and the sum of the other eigenspaces.  Projection to weight one corrects an
arbitrary infinitesimal lift supplied by formal smoothness.  Multiplicativity is
checked on weight vectors.  The exceptional product of two nontrivial inverse
weights has weight one, but both lifted factors lie in the square-zero ideal,
so their product vanishes.  The quotient is therefore formally smooth.  It is
also finitely presented, hence smooth and reduced by the smooth-algebra
reducedness theorem.
-/

namespace Theory.AlgebraicGroup.Bor1

variable {k A : Type u} [Field k]
variable [CommRing A] [Algebra k A]

/-- Vectors of arbitrary weight for an algebra endomorphism. -/
@[expose] public def weightVectors (phi : A →ₐ[k] A) : Set A :=
  {a | ∃ c : k, phi a = algebraMap k A c * a}

/-- Vectors of nontrivial weight for an algebra endomorphism. -/
@[expose] public def nontrivialWeightVectors (phi : A →ₐ[k] A) : Set A :=
  {a | ∃ c : k, c ≠ 1 ∧ phi a = algebraMap k A c * a}

/-- A locally finite endomorphism that is semisimple on every finite invariant
submodule has an eigenvector-spanned ambient module. -/
public theorem weightVectors_span_eq_top_of_locallyFinite_of_finitelySemisimple
    [IsAlgClosed k]
    (phi : A →ₐ[k] A)
    (hloc : Theory.AlgebraicGroup.Module.End.IsLocallyFinite phi.toLinearMap)
    (hsem : Module.End.IsFinitelySemisimple phi.toLinearMap) :
    Submodule.span k (weightVectors phi) = ⊤ := by
  apply top_unique
  intro x _
  obtain ⟨P, hPfinite, hPinv, hxP⟩ := hloc x
  let : Module.Finite k P := hPfinite
  let phiP : Module.End k P := phi.toLinearMap.restrict hPinv
  have hphiP : Module.End.IsSemisimple phiP := hsem P hPinv hPfinite
  have htop : (⨆ c : k, phiP.eigenspace c) = ⊤ :=
    hphiP.iSup_eigenspace_eq_top
  have hle : (⨆ c : k, phiP.eigenspace c) ≤
      (Submodule.span k (weightVectors phi)).comap P.subtype := by
    apply iSup_le
    intro c y hy
    change (y : A) ∈ Submodule.span k (weightVectors phi)
    apply Submodule.subset_span
    refine ⟨c, ?_⟩
    have heq := Module.End.mem_eigenspace_iff.mp hy
    have heq' := congrArg Subtype.val heq
    have hrestrict :
        ((phi.toLinearMap.restrict hPinv y : P) : A) = phi (y : A) := rfl
    rw [hrestrict] at heq'
    simpa [phiP, Algebra.smul_def] using heq'
  have hxTop : (⟨x, hxP⟩ : P) ∈ (⊤ : Submodule k P) := Submodule.mem_top
  rw [← htop] at hxTop
  exact hle hxTop

private abbrev algebraEnd (phi : A →ₐ[k] A) : Module.End k A :=
  phi.toLinearMap

private def nontrivialEigenspaces (phi : A →ₐ[k] A) : Submodule k A :=
  ⨆ c : k, ⨆ (_ : c ≠ 1), (algebraEnd phi).eigenspace c

private lemma nontrivialEigenspaces_le_weightIdeal (phi : A →ₐ[k] A) :
    nontrivialEigenspaces phi ≤
      (Ideal.span (nontrivialWeightVectors phi)).restrictScalars k := by
  apply iSup_le
  intro c
  apply iSup_le
  intro hc a ha
  apply Ideal.subset_span
  refine ⟨c, hc, ?_⟩
  simpa [Algebra.smul_def] using Module.End.mem_eigenspace_iff.mp ha

private lemma weightEigenspaces_isCompl
    (phi : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors phi) = ⊤) :
    IsCompl ((algebraEnd phi).eigenspace 1) (nontrivialEigenspaces phi) := by
  classical
  constructor
  · exact (algebraEnd phi).eigenspaces_iSupIndep.disjoint_biSup (fun h => h rfl)
  · rw [codisjoint_iff_le_sup, ← hspan]
    apply Submodule.span_le.mpr
    intro a ha
    rcases ha with ⟨c, hc⟩
    have haEig : a ∈ (algebraEnd phi).eigenspace c :=
      Module.End.mem_eigenspace_iff.mpr (by simpa [Algebra.smul_def] using hc)
    by_cases hc1 : c = 1
    · subst c
      exact (le_sup_left : (algebraEnd phi).eigenspace 1 ≤ _) haEig
    · exact (le_sup_right : nontrivialEigenspaces phi ≤ _)
        (Submodule.mem_iSup_of_mem c (Submodule.mem_iSup_of_mem hc1 haEig))

private noncomputable def weightOneProjection
    (phi : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors phi) = ⊤) : A →ₗ[k] A :=
  ((algebraEnd phi).eigenspace 1).projection (nontrivialEigenspaces phi)
    (weightEigenspaces_isCompl phi hspan)

private lemma weightOneProjection_apply_of_nontrivial_weight
    (phi : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors phi) = ⊤)
    {a : A} {c : k} (hc : c ≠ 1)
    (ha : phi a = algebraMap k A c * a) :
    weightOneProjection phi hspan a = 0 := by
  have haEig : a ∈ (algebraEnd phi).eigenspace c :=
    Module.End.mem_eigenspace_iff.mpr (by simpa [Algebra.smul_def] using ha)
  exact Submodule.projection_apply_of_mem_right
    (weightEigenspaces_isCompl phi hspan)
    (Submodule.mem_iSup_of_mem c (Submodule.mem_iSup_of_mem hc haEig))

private lemma weightOneProjection_apply_of_fixed
    (phi : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors phi) = ⊤)
    {a : A} (ha : phi a = a) :
    weightOneProjection phi hspan a = a := by
  have haEig : a ∈ (algebraEnd phi).eigenspace 1 :=
    Module.End.mem_eigenspace_iff.mpr (by simpa [Algebra.smul_def] using ha)
  exact Submodule.projection_apply_of_mem_left
    (weightEigenspaces_isCompl phi hspan) haEig

private lemma weightOneProjection_one
    (phi : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors phi) = ⊤) :
    weightOneProjection phi hspan 1 = 1 := by
  apply weightOneProjection_apply_of_fixed phi hspan
  simp

private lemma sub_weightOneProjection_mem_weightIdeal
    (phi : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors phi) = ⊤)
    (a : A) :
    a - weightOneProjection phi hspan a ∈
      Ideal.span (nontrivialWeightVectors phi) := by
  apply nontrivialEigenspaces_le_weightIdeal phi
  exact Submodule.sub_projection_mem (weightEigenspaces_isCompl phi hspan) a

private lemma weightOneProjection_mul_after_squareZeroLift
    (phi : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors phi) = ⊤)
    {C : Type u} [CommRing C] [Algebra k C]
    (J : Ideal C) (hJ : J ^ 2 = ⊥)
    (f : (A ⧸ Ideal.span (nontrivialWeightVectors phi)) →ₐ[k] (C ⧸ J))
    (g : A →ₐ[k] C)
    (hg : (Ideal.Quotient.mkₐ k J).comp g =
      f.comp (Ideal.Quotient.mkₐ k
        (Ideal.span (nontrivialWeightVectors phi)))) :
    ∀ a b : A,
      g (weightOneProjection phi hspan (a * b)) =
        g (weightOneProjection phi hspan a) *
          g (weightOneProjection phi hspan b) := by
  let I : Ideal A := Ideal.span (nontrivialWeightVectors phi)
  have g_mem (a : A) (ha : a ∈ I) : g a ∈ J := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change (Ideal.Quotient.mkₐ k J) (g a) = 0
    rw [← AlgHom.comp_apply, hg, AlgHom.comp_apply]
    change f ((Ideal.Quotient.mkₐ k I) a) = 0
    have hqa : (Ideal.Quotient.mkₐ k I) a = 0 := by
      rw [Ideal.Quotient.mkₐ_eq_mk]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
    rw [hqa, map_zero]
  have on_weights (a b : A) (ha : a ∈ weightVectors phi)
      (hb : b ∈ weightVectors phi) :
      g (weightOneProjection phi hspan (a * b)) =
        g (weightOneProjection phi hspan a) *
          g (weightOneProjection phi hspan b) := by
    rcases ha with ⟨c, ha⟩
    rcases hb with ⟨d, hb⟩
    have hab : phi (a * b) = algebraMap k A (c * d) * (a * b) := by
      rw [map_mul, ha, hb, map_mul]
      ring
    by_cases hc : c = 1
    · subst c
      have haFixed : phi a = a := by simpa using ha
      rw [weightOneProjection_apply_of_fixed phi hspan haFixed]
      by_cases hd : d = 1
      · subst d
        have hbFixed : phi b = b := by simpa using hb
        have habFixed : phi (a * b) = a * b := by simpa using hab
        rw [weightOneProjection_apply_of_fixed phi hspan hbFixed,
          weightOneProjection_apply_of_fixed phi hspan habFixed, map_mul]
      · have habNontrivial : 1 * d ≠ 1 := by simpa using hd
        rw [weightOneProjection_apply_of_nontrivial_weight phi hspan hd hb,
          weightOneProjection_apply_of_nontrivial_weight phi hspan habNontrivial hab]
        simp
    by_cases hd : d = 1
    · subst d
      have hbFixed : phi b = b := by simpa using hb
      have habNontrivial : c * 1 ≠ 1 := by simpa using hc
      rw [weightOneProjection_apply_of_nontrivial_weight phi hspan hc ha,
        weightOneProjection_apply_of_fixed phi hspan hbFixed,
        weightOneProjection_apply_of_nontrivial_weight phi hspan habNontrivial hab]
      simp
    by_cases hcd : c * d = 1
    · have habFixed : phi (a * b) = a * b := by simpa [hcd] using hab
      rw [weightOneProjection_apply_of_nontrivial_weight phi hspan hc ha,
        weightOneProjection_apply_of_nontrivial_weight phi hspan hd hb,
        weightOneProjection_apply_of_fixed phi hspan habFixed]
      simp only [map_zero, mul_zero]
      rw [map_mul]
      have hm' : g a * g b ∈ J * J := Ideal.mul_mem_mul
        (g_mem a (Ideal.subset_span ⟨c, hc, ha⟩))
        (g_mem b (Ideal.subset_span ⟨d, hd, hb⟩))
      have hm : g a * g b ∈ J ^ 2 := by simpa [pow_two] using hm'
      rw [hJ] at hm
      exact hm
    · rw [weightOneProjection_apply_of_nontrivial_weight phi hspan hc ha,
        weightOneProjection_apply_of_nontrivial_weight phi hspan hd hb,
        weightOneProjection_apply_of_nontrivial_weight phi hspan hcd hab]
      simp
  intro a b
  have haTop : a ∈ Submodule.span k (weightVectors phi) := by rw [hspan]; trivial
  induction haTop using Submodule.span_induction generalizing b with
  | mem a ha =>
      have hbTop : b ∈ Submodule.span k (weightVectors phi) := by rw [hspan]; trivial
      induction hbTop using Submodule.span_induction with
      | mem b hb => exact on_weights a b ha hb
      | zero => simp
      | add b c _ _ hb hc => simpa [mul_add, add_mul] using congrArg₂ (.+.) hb hc
      | smul r b _ hb =>
          calc
            g (weightOneProjection phi hspan (a * (r • b))) =
                g (weightOneProjection phi hspan (r • (a * b))) := by
                  congr 2
                  simp [Algebra.smul_def, mul_assoc, mul_comm]
            _ = g (r • weightOneProjection phi hspan (a * b)) := by rw [map_smul]
            _ = r • g (weightOneProjection phi hspan (a * b)) := by rw [map_smul]
            _ = r • (g (weightOneProjection phi hspan a) *
                g (weightOneProjection phi hspan b)) := congrArg (r • .) hb
            _ = g (weightOneProjection phi hspan a) *
                (r • g (weightOneProjection phi hspan b)) := by
                  simp [Algebra.smul_def, mul_left_comm]
            _ = g (weightOneProjection phi hspan a) *
                g (weightOneProjection phi hspan (r • b)) := by rw [map_smul, map_smul]
  | zero => simp
  | add a c _ _ ha hc => simpa [add_mul] using congrArg₂ (.+.) (ha b) (hc b)
  | smul r a _ ha =>
      calc
        g (weightOneProjection phi hspan ((r • a) * b)) =
            g (weightOneProjection phi hspan (r • (a * b))) := by
              congr 2
              simp [Algebra.smul_def, mul_assoc, mul_left_comm]
        _ = g (r • weightOneProjection phi hspan (a * b)) := by rw [map_smul]
        _ = r • g (weightOneProjection phi hspan (a * b)) := by rw [map_smul]
        _ = r • (g (weightOneProjection phi hspan a) *
            g (weightOneProjection phi hspan b)) := congrArg (r • .) (ha b)
        _ = (r • g (weightOneProjection phi hspan a)) *
            g (weightOneProjection phi hspan b) := by simp [Algebra.smul_def, mul_assoc]
        _ = g (weightOneProjection phi hspan (r • a)) *
            g (weightOneProjection phi hspan b) := by rw [map_smul, map_smul]

/-- If an algebra is spanned by weight vectors, quotienting by its nontrivial
weight vectors preserves formal smoothness. -/
public theorem weightIdeal_quotient_formallySmooth_of_weightVectors_span
    (phi : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors phi) = ⊤)
    [Algebra.FormallySmooth k A] :
    Algebra.FormallySmooth k
      (A ⧸ Ideal.span (nontrivialWeightVectors phi)) := by
  apply Algebra.FormallySmooth.of_comp_surjective
  intro C _ _ J hJ f
  let I : Ideal A := Ideal.span (nontrivialWeightVectors phi)
  let q : A →ₐ[k] (A ⧸ I) := Ideal.Quotient.mkₐ k I
  let g : A →ₐ[k] C := Algebra.FormallySmooth.lift J ⟨2, hJ⟩ (f.comp q)
  have hg : (Ideal.Quotient.mkₐ k J).comp g = f.comp q :=
    Algebra.FormallySmooth.comp_lift J ⟨2, hJ⟩ (f.comp q)
  let P : A →ₗ[k] A := weightOneProjection phi hspan
  let g' : A →ₐ[k] C :=
    { toFun := fun a => g (P a)
      map_one' := by
        calc
          g (P 1) = g 1 := congrArg g (weightOneProjection_one phi hspan)
          _ = 1 := map_one g
      map_mul' := weightOneProjection_mul_after_squareZeroLift
        phi hspan J hJ f g hg
      map_zero' := by simp [P]
      map_add' := by simp [P]
      commutes' := by
        intro r
        change g (P (algebraMap k A r)) = algebraMap k C r
        rw [show algebraMap k A r = r • (1 : A) by
          simp [Algebra.smul_def], map_smul, weightOneProjection_one phi hspan,
          map_smul, map_one]
        simp [Algebra.smul_def] }
  have hg'I_le : I ≤ RingHom.ker g'.toRingHom := by
    apply Ideal.span_le.mpr
    intro b hb
    rcases hb with ⟨c, hc, hb⟩
    change g (P b) = 0
    rw [weightOneProjection_apply_of_nontrivial_weight phi hspan hc hb, map_zero]
  have hg'I : ∀ a, a ∈ I → g' a = 0 := fun a ha => hg'I_le ha
  let lift : (A ⧸ I) →ₐ[k] C := Ideal.Quotient.liftₐ I g' hg'I
  refine ⟨lift, ?_⟩
  apply AlgHom.ext
  intro x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  change (Ideal.Quotient.mkₐ k J) (g (P a)) = f ((Ideal.Quotient.mkₐ k I) a)
  rw [← AlgHom.comp_apply, hg, AlgHom.comp_apply]
  congr 1
  change (Ideal.Quotient.mkₐ k I) (P a) = (Ideal.Quotient.mkₐ k I) a
  rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq]
  simpa [P] using I.neg_mem (sub_weightOneProjection_mem_weightIdeal phi hspan a)

set_option linter.style.haveILetI false in
/-- In a smooth algebra spanned by weight vectors, the ideal generated by the
nontrivial weight vectors is radical. -/
public theorem weightIdeal_isRadical_of_weightVectors_span
    (phi : A →ₐ[k] A)
    (hspan : Submodule.span k (weightVectors phi) = ⊤)
    [Algebra.Smooth k A] :
    (Ideal.span (nontrivialWeightVectors phi)).IsRadical := by
  rw [Ideal.isRadical_iff_quotient_reduced]
  let I : Ideal A := Ideal.span (nontrivialWeightVectors phi)
  letI : Algebra.FormallySmooth k (A ⧸ I) :=
    weightIdeal_quotient_formallySmooth_of_weightVectors_span phi hspan
  letI : Algebra.FiniteType k (A ⧸ I) := Algebra.FiniteType.quotient k I
  letI : Algebra.FinitePresentation k (A ⧸ I) :=
    Algebra.FinitePresentation.of_finiteType.mp inferInstance
  letI : Algebra.Smooth k (A ⧸ I) := ⟨inferInstance, inferInstance⟩
  exact isReduced_of_smooth_of_field (K := k) (A := A ⧸ I)

/-- A locally finite, finitely semisimple algebra endomorphism of a smooth
algebra has radical nontrivial-weight ideal. -/
public theorem weightIdeal_isRadical_of_locallyFinite_of_finitelySemisimple
    [IsAlgClosed k]
    (phi : A →ₐ[k] A)
    (hloc : Theory.AlgebraicGroup.Module.End.IsLocallyFinite phi.toLinearMap)
    (hsem : Module.End.IsFinitelySemisimple phi.toLinearMap)
    [Algebra.Smooth k A] :
    (Ideal.span (nontrivialWeightVectors phi)).IsRadical :=
  weightIdeal_isRadical_of_weightVectors_span phi
    (weightVectors_span_eq_top_of_locallyFinite_of_finitelySemisimple phi hloc hsem)

end Theory.AlgebraicGroup.Bor1
