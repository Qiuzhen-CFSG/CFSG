module

public import Theory.AlgebraicGroup.Bor1.BorelTangentControl
public import Theory.AlgebraicGroup.Borel.StandardPositiveSystemClassification.Defs
public import Theory.AlgebraicGroup.Morphism.CodRestrict
public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup

/-!
# Derived-unipotent control of a regular Borel tangent

This module proves the unipotent clause of the tangent-action contract used in
Bor1, Lemma 14.23.  An `IsBorelOfPositiveSystem` certificate identifies the
unipotent radical with the subgroup generated by the positive root subgroups.
Consequently every chosen simple-root tangent, and hence their sum, lies in the
range of the radical-inclusion differential.

The principal theorem then composes the two source inputs explicitly.  Bor1,
Proposition 3.17 places `Ad(u)Y - Y`, for `u` in the radical and `Y` in its
tangent range, in the tangent range of the closed derived subgroup.  Formula
14.5 places that latter range in the span of the non-simple positive-root
tangents.  The assembly theorem combines this result with the torus-factor
calculation from `BorelTangentControl`: for a general Borel point the surviving
simple coefficients are nonzero torus-character values, rather than all one.

The exported range lemma is the bridge from root-subgroup containment to
tangent containment.  Chosen root tangents are nonzero, and the public import
of `BorelTangentControl` re-exports its linear-independence support theorem for
the resulting weighted sum.

Source: Bor1, Chapter 1, Proposition 3.17 (lines 1122--1140), and Chapter 4,
Lemma 14.23 with formula 14.5 (lines 1439--1447).
-/

open scoped BigOperators

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

omit [IsAlgClosed k] in
private theorem RootGroupData.IsRealization.simple_subset_positive
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    {D : RootGroupData K T} (hD : D.IsRealization) :
    D.simple ⊆ D.positive := by
  rcases hD with ⟨_, _, _, _, _, _, _, _, _, _, _, hsimple, _⟩
  intro alpha halpha
  exact (hsimple alpha).mp halpha |>.1

/-- If a root subgroup is contained in `U`, its chosen ambient root tangent is
in the range of the identity differential of `U → K`. -/
public theorem rootTangentVector_mem_identityTangentRange
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    (x : (alpha : D.Root) ->
      OneParameterParametrization (D.rootSubgroup alpha).carrierVariety)
    (U : ClosedSubgroup K) (alpha : D.Root)
    (hroot : D.rootSubgroup alpha ≤ U) :
    rootTangentVector D x alpha ∈
      LinearMap.range (identityTangentMorphismLinearMap U.inclusion) := by
  obtain ⟨Y, hY⟩ := oneParameterTangent_mem_range_inclusion
    (D.rootSubgroup alpha) (x alpha)
  let i := (D.rootSubgroup alpha).inclusion.codRestrictClosedSubgroup U
    (fun z => hroot ((D.rootSubgroup alpha).pointEquiv z).property)
  refine ⟨identityTangentMorphismLinearMap i Y, ?_⟩
  rw [rootTangentVector, ← hY]
  apply Derivation.ext
  intro f
  change Y ((U.inclusion.comp i).toVariety.pullbackAlgHom f) =
    Y ((D.rootSubgroup alpha).inclusion.toVariety.pullbackAlgHom f)
  congr 1

/-- Every chosen root tangent is nonzero. -/
public theorem rootTangentVector_ne_zero
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    (x : (alpha : D.Root) ->
      OneParameterParametrization (D.rootSubgroup alpha).carrierVariety)
    (alpha : D.Root) :
    rootTangentVector D x alpha ≠ 0 := by
  exact oneParameterTangent_ne_zero (D.rootSubgroup alpha) (x alpha)

/-- The tangent containments of Bor1 3.17 and 14.5 imply the required
unipotent-radical control of the simple-root tangent sum. -/
public theorem IsBorelOfPositiveSystem.hasDerivedUnipotentSimpleRootTangentControl
    {K : Variety k} [AlgebraicGroup K] {T B : ClosedSubgroup K}
    (D : RootGroupData K T) [Finite D.Root] (hD : D.IsRealization)
    (hB : IsBorelOfPositiveSystem D D.positive B)
    (x : (alpha : D.Root) ->
      OneParameterParametrization (D.rootSubgroup alpha).carrierVariety)
    (C : ClosedSubgroup K)
    (hcommutatorTangent :
      ∀ u : Variety.Point K, u ∈ hB.unipotent ->
      ∀ Y, Y ∈ LinearMap.range
          (identityTangentMorphismLinearMap hB.unipotent.inclusion) ->
        ((identityTangentRepresentation K).action u).1 Y - Y ∈
          LinearMap.range (identityTangentMorphismLinearMap C.inclusion))
    (hcommutatorHigher :
      LinearMap.range (identityTangentMorphismLinearMap C.inclusion) ≤
        nonSimplePositiveRootTangentSpan D x) :
    HasDerivedUnipotentSimpleRootTangentControl hB.unipotent T D x := by
  intro u hu
  apply hcommutatorHigher
  apply hcommutatorTangent u hu
  rw [simpleRootTangentSum]
  apply Submodule.sum_mem
  intro alpha halpha
  apply rootTangentVector_mem_identityTangentRange D x hB.unipotent alpha
  change (D.rootSubgroup alpha).toSubgroup ≤ hB.unipotent.toSubgroup
  rw [hB.root_generated]
  apply rootSubgroup_le_RootSubgroupGenerated D
  exact hD.simple_subset_positive (by simpa using halpha)

/-- Under a `T * U` point factorization, the derived-unipotent tangent
containments give the corrected all-Borel action and support package. -/
public theorem IsBorelOfPositiveSystem.borelTangentDerivedUnipotentControl
    {K : Variety k} [AlgebraicGroup K] {T B : ClosedSubgroup K}
    (D : RootGroupData K T) [Finite D.Root] (hD : D.IsRealization)
    (hB : IsBorelOfPositiveSystem D D.positive B)
    (x : (alpha : D.Root) ->
      OneParameterParametrization (D.rootSubgroup alpha).carrierVariety)
    (C : ClosedSubgroup K)
    (hfactor : ∀ b : Variety.Point K, b ∈ B ->
      ∃ t u : Variety.Point K, t ∈ T ∧ u ∈ hB.unipotent ∧ b = t * u)
    (hcommutatorTangent :
      ∀ u : Variety.Point K, u ∈ hB.unipotent ->
      ∀ Y, Y ∈ LinearMap.range
          (identityTangentMorphismLinearMap hB.unipotent.inclusion) ->
        ((identityTangentRepresentation K).action u).1 Y - Y ∈
          LinearMap.range (identityTangentMorphismLinearMap C.inclusion))
    (hcommutatorHigher :
      LinearMap.range (identityTangentMorphismLinearMap C.inclusion) ≤
        nonSimplePositiveRootTangentSpan D x) :
    BorelTangentDerivedUnipotentControl B hB.unipotent T D x := by
  apply BorelTangentDerivedUnipotentControl.of_factorization
    B hB.unipotent T D x hD hB.radical hfactor
  exact hB.hasDerivedUnipotentSimpleRootTangentControl D hD x C
    hcommutatorTangent hcommutatorHigher

end Theory.AlgebraicGroup
