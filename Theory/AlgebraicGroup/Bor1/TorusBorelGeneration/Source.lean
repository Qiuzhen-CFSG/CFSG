module

public import Theory.AlgebraicGroup.Bor1.TorusBorelGeneration.FixedCoset
public import Theory.AlgebraicGroup.Borel.SelfNormalizer.Source
public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.Borel.IntersectionGeometry.BruhatCoverage.Generation

/-!
# Generation by the Borels containing a maximal torus

Borel, Linear Algebraic Groups, second edition, Proposition 13.7, pp.167–168.
The abstract subgroup generated by the connected closed Borels is itself
closed. It contains a Borel and hence is parabolic. Its torus normalizer
preserves the generating family, and parabolic self-normalization puts that
normalizer in the generated subgroup. If the subgroup were proper, the proved
diagonal-orbit construction would give an escaping fixed Borel coset.
Conjugacy of maximal tori inside that Borel adjusts its representative into
the torus normalizer, a contradiction.

The final theorem instantiates the existing Borel/normalizer generation
consumer with both geometric premises discharged. Neither theorem replaces
abstract generation by Zariski density.
-/

public noncomputable section

namespace Theory.AlgebraicGroup.Bor1.TorusBorelGeneration
open BorelIntersectionGeometry
universe u
variable {k : Type u} [Field k] [IsAlgClosed k]
variable {G : Variety k} [AlgebraicGroup G]

private theorem exists_borel_containing_torus (T : ClosedSubgroup G) (hT : IsSubtorus T) :
    ∃ B : ClosedSubgroup G, IsBorelSubgroup B ∧ T ≤ B := by
  have hconn : _root_.IsConnected (T : Set (Variety.Point G)) := by
    let : ConnectedSpace (Variety.Point T.carrierVariety) :=
      connectedSpace_iff_univ.mpr hT.isConnected
    change _root_.IsConnected (T.toSubgroup : Set (Variety.Point G))
    rw [← T.range_inclusion]
    exact isConnected_range T.inclusion.toVariety.continuous
  exact exists_borelSubgroup_containing_connected_solvable T hconn
    (Group.isSolvable_of_comm (isMulCommutative_iff.mp hT.isMulCommutative))

omit [IsAlgClosed k] in
private theorem torus_normalizer_normalizes_borel_span (T : ClosedSubgroup G) :
    T.normalizer.toSubgroup ≤ Subgroup.normalizer
      (Subgroup.closure (⋃ B : BorelContainingIndex T,
        (B.1 : Set (Variety.Point G))) : Set (Variety.Point G)) := by
  let J := Subgroup.closure (⋃ B : BorelContainingIndex T, (B.1 : Set (Variety.Point G)))
  have hmap (n : Variety.Point G) (hn : n ∈ T.normalizer.toSubgroup) :
      ∀ x ∈ J, n * x * n⁻¹ ∈ J := by
    have hle : J ≤ J.comap (MulAut.conj n).toMonoidHom := by
      apply (Subgroup.closure_le (J.comap (MulAut.conj n).toMonoidHom)).mpr
      intro x hx
      obtain ⟨B, hxB⟩ := Set.mem_iUnion.mp hx
      have hTC : T ≤ B.1.conjugate n := by
        have hh := conjugate_le B.2.2 n
        rwa [ClosedSubgroup.conjugate_eq_self_of_mem_normalizer n hn] at hh
      let C : BorelContainingIndex T := ⟨B.1.conjugate n, B.2.1.conjugate n, hTC⟩
      apply Subgroup.subset_closure
      refine Set.mem_iUnion.mpr ⟨C, ?_⟩
      apply (B.1.mem_conjugate_iff n _).mpr
      change n⁻¹ * (n * x * n⁻¹) * n ∈ B.1.toSubgroup
      have hc : n⁻¹ * (n * x * n⁻¹) * n = x := by group
      rwa [hc]
    intro x hx
    exact hle hx
  intro n hn
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · exact hmap n hn x
  · intro hx
    have hh := hmap n⁻¹ (T.normalizer.toSubgroup.inv_mem hn) _ hx
    simpa only [inv_inv, inv_mul_cancel_left, mul_assoc, inv_mul_cancel, mul_one] using hh

/-- Borel 13.7: the group of points is generated, as an abstract group, by
all Borel subgroups containing a prescribed maximal torus. -/
theorem closure_borels_containing_maximalTorus_eq_top
    (hG : Variety.IsConnected G) (T : ClosedSubgroup G) (hT : IsMaximalTorus T) :
    Subgroup.closure (⋃ B : BorelContainingIndex T, (B.1 : Set (Variety.Point G))) = ⊤ := by
  let J := Subgroup.closure (⋃ B : BorelContainingIndex T, (B.1 : Set (Variety.Point G)))
  have hclosed : IsZariskiClosed G (J : Set (Variety.Point G)) :=
    closure_iUnion_connected_closedSubgroup_isZariskiClosed
      (fun B : BorelContainingIndex T => B.1) (fun B => B.2.1.connected)
  let P := ClosedSubgroup.ofSubgroup J hclosed
  have hBP (B : BorelContainingIndex T) : B.1 ≤ P := by
    intro x hx
    exact Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨B, hx⟩)
  obtain ⟨B, hB, hTB⟩ := exists_borel_containing_torus T hT.1
  have hpara : IsParabolicSubgroup P := ⟨B, hB, hBP ⟨B, hB, hTB⟩⟩
  have hNP : T.normalizer.toSubgroup ≤ P.toSubgroup := by
    have hh := torus_normalizer_normalizes_borel_span T
    change T.normalizer.toSubgroup ≤ P.normalizer.toSubgroup at hh
    rwa [BorelSelfNormalizer.parabolic_normalizer_eq hG P hpara] at hh
  by_contra hproper
  obtain ⟨g, hgP, hTgB⟩ := exists_fixed_borel_coset_outside_parabolic
    hG T P B hT.1 hB (hBP ⟨B, hB, hTB⟩) hproper
  have hconj : T.conjugate g⁻¹ ≤ B := by
    have hh := conjugate_le hTgB g⁻¹
    rwa [ClosedSubgroup.conjugate_conjugate, inv_mul_cancel,
      ClosedSubgroup.conjugate_one] at hh
  obtain ⟨b, hb, hTb⟩ := BorelSelfNormalizer.maximalTori_conjugate_inside_borel
    hB hT (conjugate_isMaximalTorus hT g⁻¹) hTB hconj
  have hTn : T.conjugate (g * b) = T := by
    rw [← ClosedSubgroup.conjugate_conjugate, ← hTb,
      ClosedSubgroup.conjugate_conjugate, mul_inv_cancel, ClosedSubgroup.conjugate_one]
  have hn : g * b ∈ T.normalizer.toSubgroup := by
    change g * b ∈ Subgroup.normalizer (T.toSubgroup : Set (Variety.Point G))
    rw [Subgroup.mem_normalizer_iff]
    intro t
    have hback : ∀ x : Variety.Point G,
        (g * b)⁻¹ * x * (g * b) ∈ T.toSubgroup ↔ x ∈ T.toSubgroup := by
      intro x
      rw [← T.mem_conjugate_iff, hTn]
      rfl
    have hh := hback ((g * b) * t * (g * b)⁻¹)
    have hc : (g * b)⁻¹ * ((g * b) * t * (g * b)⁻¹) * (g * b) = t := by group
    rwa [hc] at hh
  have hbP : b ∈ P.toSubgroup := hBP ⟨B, hB, hTB⟩ hb
  have hg : (g * b) * b⁻¹ ∈ P.toSubgroup :=
    P.toSubgroup.mul_mem (hNP hn) (P.toSubgroup.inv_mem hbP)
  exact hgP (by simpa only [mul_inv_cancel_right] using hg)

/-- Literal abstract B/N generation, with the earlier geometric premises
of the Bruhat-coverage consumer discharged by Borel conjugacy and 13.7. -/
theorem borel_normalizer_generation
    (hG : Variety.IsConnected G) {B T : ClosedSubgroup G}
    (hB : IsBorelSubgroup B) (hT : IsMaximalTorus T) (hTB : T ≤ B) :
    Subgroup.closure ((B.toSubgroup : Set (Variety.Point G)) ∪
      (T.normalizer.toSubgroup : Set (Variety.Point G))) = ⊤ := by
  apply borel_normalizer_generation_of_torus_borel_generation_and_conjugacy hB hT hTB
  · intro C
    exact BorelGeometricConjugacy.conjugacy hB C.2.1
  · exact closure_borels_containing_maximalTorus_eq_top hG T hT

end Theory.AlgebraicGroup.Bor1.TorusBorelGeneration
