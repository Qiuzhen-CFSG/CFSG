module

public import Theory.AlgebraicGroup.Bor1.SmoothSemisimpleFixedCotangent
public import Theory.AlgebraicGroup.ClosedSubgroup.Centralizer
public import Theory.AlgebraicGroup.ClosedSubgroup.Closure

universe u

namespace Theory.AlgebraicGroup.Bor1

open Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

/-!
This module proves the infinitesimal stabilizer step in GLS Bor1,
Proposition 9.1, for conjugation by a semisimple point.  If `s` is semisimple,
an identity tangent fixed by conjugation by `s` comes from the centralizer of
the Zariski closure of the cyclic subgroup generated by `s`.

The proof applies semisimple fixed-locus cotangent exactness to conjugation by
`s`.  That result is obtained from the locally finite semisimple action on the
coordinate algebra and the radicality of its nontrivial-weight ideal, rather
than from an assumed smoothness theorem for fixed loci.  A fixed point of
conjugation commutes with every power of `s`; the closed equalizer of its left
and right translations therefore contains the cyclic subgroup and its
Zariski closure.  Thus every function vanishing on the closed centralizer also
vanishes on the fixed locus, so the invariant derivation annihilates the
centralizer ideal.  The closed-subgroup tangent/vanishing-ideal criterion then
gives the claimed lift through the inclusion differential.
-/

omit [IsAlgClosed k] in
private lemma mem_cyclicClosure_centralizer_of_commute
    {G : Variety k} [AlgebraicGroup G] (s x : Variety.Point G)
    (hcomm : s * x = x * s) :
    x ∈ (subgroupZariskiClosure G (Subgroup.zpowers s)).centralizer := by
  change x ∈ Subgroup.centralizer
    ((subgroupZariskiClosure G (Subgroup.zpowers s)).toSubgroup :
      Set (Variety.Point G))
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  let E : Set (Variety.Point G) := {z | z * x = x * z}
  have hEclosed : IsClosed E := by
    apply Variety.isClosed_iff_isZariskiClosed.mpr
    simpa [E, AlgebraicGroup.leftMulMorphism_apply,
      AlgebraicGroup.rightMulMorphism_apply] using
      Variety.Morphism.isZariskiClosed_equalizer
        (AlgebraicGroup.rightMulMorphism G x)
        (AlgebraicGroup.leftMulMorphism G x)
  have hpowers : (Subgroup.zpowers s : Set (Variety.Point G)) ⊆ E := by
    intro z hz
    rcases Subgroup.mem_zpowers_iff.mp hz with ⟨n, rfl⟩
    exact (show Commute s x from hcomm).zpow_left n
  exact closure_minimal hpowers hEclosed hy

/-- An identity tangent fixed by conjugation by a semisimple point lifts from
the centralizer of the Zariski closure of that point's cyclic subgroup. -/
public theorem identityTangent_fixed_mem_semisimplePointCentralizer_range
    (G : Variety k) [AlgebraicGroup G]
    (s : Variety.Point G) (hs : IsSemisimpleElement G s)
    (D : IdentityPointDerivation G)
    (hD : identityTangentConjugationLinearMap G s D = D) :
    let C := (subgroupZariskiClosure G (Subgroup.zpowers s)).centralizer
    D ∈ LinearMap.range (identityTangentMorphismLinearMap C.inclusion) := by
  let C := (subgroupZariskiClosure G (Subgroup.zpowers s)).centralizer
  apply (identityTangent_inclusion_range_iff_vanishingIdeal C D).mpr
  intro f hf
  let psi : PolynomialAutomorphismContract (k := k) G := {
    forward := AlgebraicGroup.conjugationByMorphism G s
    inverse := AlgebraicGroup.conjugationByMorphism G s⁻¹
    fixes_one := by simp [AlgebraicGroup.conjugationByMorphism_apply]
    left_inv := by
      intro x
      simp only [AlgebraicGroup.conjugationByMorphism_apply]
      group
    right_inv := by
      intro x
      simp only [AlgebraicGroup.conjugationByMorphism_apply]
      group
    pullback_locallyFinite := conjugationPullback_locallyFinite G s }
  apply identityDerivation_eq_zero_of_semisimple_fixedPoint_vanishing
    G psi (conjugationBy_semisimpleElement_isSemisimple s hs) D
  · intro q
    have hq := congrArg
      (fun E : IdentityPointDerivation G => E q) hD
    simpa only [identityTangentConjugationLinearMap_apply] using hq
  · rw [mem_fixedPointVanishingIdeal_iff]
    intro x hx
    rw [AlgebraicGroup.conjugationByMorphism_apply] at hx
    have hcomm : s * x = x * s := by
      have hx' := congrArg (fun y : Variety.Point G => y * s) hx
      simpa [mul_assoc] using hx'
    exact (C.mem_vanishingIdeal_iff f).mp hf x
      (mem_cyclicClosure_centralizer_of_commute s x hcomm)

end Theory.AlgebraicGroup.Bor1
