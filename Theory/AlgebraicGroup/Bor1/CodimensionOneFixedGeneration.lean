module

public import Theory.AlgebraicGroup.Bor1.TangentDimension
public import Theory.AlgebraicGroup.Bor1.DiagonalizableCentralizerTangent
public import Theory.AlgebraicGroup.ClosedSubgroup.Centralizer
public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.Representations.Algebraic.WeightSetFinite
public import Theory.AlgebraicGroup.RootSubgroups.Tangent
public import Theory.AlgebraicGroup.Tori.Character.ConnectedKernel
public import Theory.AlgebraicGroup.Tori.DiagonalizableClosedSubgroup

/-!
This module formalizes the conjugation form of Bor1, Chapter III, 9.5(2).
If a connected algebraic group is not fixed pointwise by a subtorus, it is
generated by the identity components of the centralizers of the connected
kernels of its nontrivial identity-tangent weights.  Each kernel is a
codimension-one subtorus by
`TorusCharacter.connectedKernel_codimension_one`.

The proof takes the finite family of nontrivial tangent weights and forms the
closed subgroup generated by their connected fixed subgroups.  The fixed
tangent formula for diagonalizable centralizers puts every nontrivial weight
space in this subgroup's tangent.  One nontrivial weight also absorbs the
trivial weight space.  The weight-space decomposition makes the generated
subgroup full-dimensional, and connectedness then makes it the whole group.

The final wrapper transports an ambient subtorus into any connected closed
subgroup containing it.  It is the form used for Borels containing a maximal
torus and for connected subtorus centralizers.  The source is Bor1, Chapter
III, Propositions 9.4(1),(4) and 9.5(2), with the Chapter IV application at
13.16.
-/

universe u

set_option linter.style.haveILetI false

namespace Theory.AlgebraicGroup.Bor1

open Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

private noncomputable def topClosedSubgroupIso
    (G : Variety k) [AlgebraicGroup G] :
    AlgebraicGroup.Iso G (ClosedSubgroup.top (G := G)).carrierVariety := by
  let T : ClosedSubgroup G := ClosedSubgroup.top
  let toTop : AlgebraicGroup.Morphism G T.carrierVariety :=
    (AlgebraicGroup.Morphism.id G).codRestrictClosedSubgroup T
      (fun _ => trivial)
  exact
    { hom := toTop
      inv := T.inclusion
      hom_inv_id := by intro x; rfl
      inv_hom_id := by
        intro y
        apply T.inclusion_injective
        rfl }

omit [IsAlgClosed k] in
private lemma isDiagonalizableClosedSubgroup_of_isSubtorus
    {G : Variety k} [AlgebraicGroup G]
    {S : ClosedSubgroup G} (hS : IsSubtorus S) :
    IsDiagonalizableClosedSubgroup S := by
  rcases hS with ⟨n, ⟨e⟩⟩
  let D : ClosedSubgroup (dVariety k n) := ClosedSubgroup.top
  letI : AlgebraicGroup D.carrierVariety := D.carrierAlgebraicGroup
  exact ⟨n, D, ⟨(topClosedSubgroupIso (dVariety k n)).comp e.symm⟩⟩

private lemma identityTangent_fixed_mem_centralizerIdentityComponent_range
    {G : Variety k} [AlgebraicGroup G]
    (S : ClosedSubgroup G) (hS : IsDiagonalizableClosedSubgroup S)
    (D : IdentityPointDerivation G)
    (hD : forall s : Variety.Point S.carrierVariety,
      identityTangentConjugationLinearMap G (S.includePoint s) D = D) :
    D ∈ LinearMap.range
      (identityTangentMorphismLinearMap
        S.centralizer.identityComponentAmbient.inclusion) := by
  let C := S.centralizer
  letI : AlgebraicGroup C.carrierVariety := C.carrierAlgebraicGroup
  let C0 := AlgebraicGroup.identityComponentClosedSubgroup C.carrierVariety
  letI : AlgebraicGroup C0.carrierVariety := C0.carrierAlgebraicGroup
  let I := C.identityComponentAmbient
  letI : AlgebraicGroup I.carrierVariety := I.carrierAlgebraicGroup
  obtain ⟨E, hE⟩ := identityTangent_fixed_mem_centralizer_range S hS D hD
  obtain ⟨E0, hE0⟩ :=
    identityComponent_inclusion_tangent_surjective C.carrierVariety E
  let f : AlgebraicGroup.Morphism C0.carrierVariety G :=
    C.inclusion.comp C0.inclusion
  let q : AlgebraicGroup.Morphism C0.carrierVariety I.carrierVariety :=
    f.codRestrictClosedSubgroup I (fun x => by
      change f.onPoints x ∈ I
      exact (ClosedSubgroup.mem_identityComponentAmbient_iff C _).mpr
        ⟨C0.inclusion.onPoints x, (C0.pointEquiv x).property, rfl⟩)
  refine ⟨identityTangentMorphismLinearMap q E0, ?_⟩
  calc
    identityTangentMorphismLinearMap I.inclusion
        (identityTangentMorphismLinearMap q E0) =
        identityTangentMorphismLinearMap (I.inclusion.comp q) E0 := by
      rw [identityTangentMorphismLinearMap_comp]
      rfl
    _ = identityTangentMorphismLinearMap f E0 := by
      congr 1
    _ = identityTangentMorphismLinearMap C.inclusion
        (identityTangentMorphismLinearMap C0.inclusion E0) := by
      rw [identityTangentMorphismLinearMap_comp]
      rfl
    _ = identityTangentMorphismLinearMap C.inclusion E := by rw [hE0]
    _ = D := hE

private lemma closedSubgroup_eq_top_of_identityTangent_surjective_of_connected
    {G : Variety k} [AlgebraicGroup G]
    (H : ClosedSubgroup G) (hG : Variety.IsConnected G)
    (hD : Function.Surjective
      (identityTangentMorphismLinearMap H.inclusion)) :
    H = ClosedSubgroup.top := by
  let e : IdentityPointDerivation H.carrierVariety ≃ₗ[k]
      IdentityPointDerivation G :=
    LinearEquiv.ofBijective
      (identityTangentMorphismLinearMap H.inclusion)
      ⟨identityTangentMorphismLinearMap_inclusion_injective H, hD⟩
  have hdimNat : Cardinal.toNat (Variety.dimension H.carrierVariety) =
      Cardinal.toNat (Variety.dimension G) := by
    rw [← identityPointDerivation_finrank_eq_dimension,
      ← identityPointDerivation_finrank_eq_dimension]
    exact e.finrank_eq
  have hdim : Variety.dimension H.carrierVariety = Variety.dimension G :=
    (Cardinal.toNat_inj_of_lt_aleph0
      (variety_dimension_lt_aleph0 H.carrierVariety)
      (variety_dimension_lt_aleph0 G)).mp hdimNat
  have hcontains :=
    (closedSubgroup_dimension_eq_iff_contains_identityComponent G H).mp hdim
  apply SetLike.coe_injective
  apply Set.Subset.antisymm
  · intro x hx
    trivial
  · intro x hx
    apply hcontains
    rw [(identityComponent_eq_univ_iff_isConnected G).mpr hG]
    trivial

/-- The nontrivial characters occurring in the identity tangent under
conjugation by a closed subtorus. -/
public abbrev NontrivialIdentityTangentWeight
    (G : Variety k) [AlgebraicGroup G] (T : ClosedSubgroup G) :=
  {chi : TorusWeight T //
    chi ∈ representationWeights
      (Theory.AlgebraicGroup.identityTangentRepresentation G) T ∧
      chi ≠ 1}

/-- The identity component of the fixed subgroup of the connected kernel of a
torus character. -/
@[expose]
public noncomputable def torusCharacterFixedIdentityComponent
    {G : Variety k} [AlgebraicGroup G] (T : ClosedSubgroup G)
    (chi : TorusWeight T) : ClosedSubgroup G :=
  (chi.ambientConnectedKernel T).centralizer.identityComponentAmbient

private lemma nonempty_nontrivialIdentityTangentWeight_of_centralizer_ne_top
    {G : Variety k} [AlgebraicGroup G]
    (T : ClosedSubgroup G) (hT : IsSubtorus T)
    (hG : Variety.IsConnected G)
    (hne : T.centralizer ≠ ClosedSubgroup.top) :
    Nonempty (NontrivialIdentityTangentWeight G T) := by
  classical
  by_contra hempty
  have hother (chi : TorusWeight T) (hchi : chi ≠ 1) :
      weightSpace (Theory.AlgebraicGroup.identityTangentRepresentation G)
        T chi = ⊥ := by
    by_contra hneWeight
    exact hempty ⟨⟨chi, hneWeight, hchi⟩⟩
  have honeTop :
      weightSpace (Theory.AlgebraicGroup.identityTangentRepresentation G)
        T 1 = ⊤ := by
    apply top_unique
    rw [← identityTangentRepresentation_weightSpace_iSup_eq_top G T hT]
    apply iSup_le
    intro chi
    by_cases hchi : chi = 1
    · simpa only [hchi] using
        (show weightSpace
          (Theory.AlgebraicGroup.identityTangentRepresentation G) T 1 ≤
            weightSpace
              (Theory.AlgebraicGroup.identityTangentRepresentation G) T 1
          from le_rfl)
    · rw [show weightSpace
          (Theory.AlgebraicGroup.identityTangentRepresentation G) T chi = ⊥
        from hother chi hchi]
      exact bot_le
  have hsurj : Function.Surjective
      (identityTangentMorphismLinearMap T.centralizer.inclusion) := by
    intro D
    have hDweight :
        D ∈ weightSpace
          (Theory.AlgebraicGroup.identityTangentRepresentation G) T 1 := by
      rw [honeTop]
      trivial
    apply identityTangent_fixed_mem_centralizer_range T
      (isDiagonalizableClosedSubgroup_of_isSubtorus hT) D
    intro t
    have h := hDweight t
    have hone : (1 : TorusWeight T).pointCharacter t = 1 := rfl
    rw [hone, one_smul] at h
    apply Derivation.ext
    intro f
    rw [identityTangentConjugationLinearMap_apply]
    have hf := congrArg (fun E : IdentityPointDerivation G => E f) h
    rw [Theory.AlgebraicGroup.identityTangentRepresentation_action_apply] at hf
    exact hf
  exact hne
    (closedSubgroup_eq_top_of_identityTangent_surjective_of_connected
      T.centralizer hG hsurj)

/-- Bor1 9.5(2), specialized to the conjugation action of a closed subtorus:
a connected group not fixed pointwise by the torus is generated by the
identity components fixed by the codimension-one connected character
kernels occurring in its identity tangent. -/
public theorem torus_connectedKernelCentralizer_generation
    {G : Variety k} [AlgebraicGroup G]
    (T : ClosedSubgroup G) (hT : IsSubtorus T)
    (hG : Variety.IsConnected G)
    (hne : T.centralizer ≠ ClosedSubgroup.top) :
    Subgroup.closure
        (⋃ chi : NontrivialIdentityTangentWeight G T,
          (torusCharacterFixedIdentityComponent T chi.1 :
            Set (Variety.Point G))) = ⊤ := by
  classical
  let rho := Theory.AlgebraicGroup.identityTangentRepresentation G
  let W := NontrivialIdentityTangentWeight G T
  let S : W → ClosedSubgroup G := fun chi =>
    (chi.1 : TorusWeight T).ambientConnectedKernel T
  let C : W → ClosedSubgroup G := fun chi =>
    torusCharacterFixedIdentityComponent T chi.1
  letI : Fintype W := Set.Finite.fintype
    ((representationWeights_finite rho T).subset (by
      intro chi hchi
      exact hchi.1))
  have hW : Nonempty W :=
    nonempty_nontrivialIdentityTangentWeight_of_centralizer_ne_top
      T hT hG hne
  have hpack (chi : W) :
      (chi.1 : TorusWeight T).ConnectedKernelCodimensionOne T :=
    (chi.1 : TorusWeight T).connectedKernel_codimension_one T hT chi.2.2
  have hCconn (chi : W) :
      _root_.IsConnected (C chi : Set (Variety.Point G)) := by
    exact (S chi).centralizer.identityComponentAmbient_isConnected
  let Jsub : Subgroup (Variety.Point G) :=
    Subgroup.closure (⋃ chi : W, (C chi : Set (Variety.Point G)))
  let J : ClosedSubgroup G := ClosedSubgroup.ofSubgroup Jsub
    (closure_iUnion_connected_closedSubgroup_isZariskiClosed C hCconn)
  letI : AlgebraicGroup J.carrierVariety := J.carrierAlgebraicGroup
  have hCJ (chi : W) : C chi ≤ J := by
    intro x hx
    change x ∈ Jsub
    apply Subgroup.subset_closure
    exact Set.mem_iUnion.mpr ⟨chi, hx⟩
  have hweightC (chi : W) :
      weightSpace rho T (chi.1 : TorusWeight T) ≤
        LinearMap.range
          (identityTangentMorphismLinearMap (C chi).inclusion) := by
    intro D hD
    apply identityTangent_fixed_mem_centralizerIdentityComponent_range
      (S chi)
      (isDiagonalizableClosedSubgroup_of_isSubtorus
        (hpack chi).ambientConnectedKernel_isSubtorus) D
    intro s
    have hs : (S chi).includePoint s ∈ S chi :=
      ((S chi).pointEquiv s).property
    obtain ⟨t, ht, heq⟩ :=
      ((hpack chi).mem_ambientConnectedKernel_iff
        ((S chi).includePoint s)).mp hs
    have hker : (chi.1 : TorusWeight T).onPoints t = 1 := by
      have htker :=
        ((chi.1 : TorusWeight T).kernelClosedSubgroup).identityComponentAmbient_le ht
      exact htker
    have hpoint : (chi.1 : TorusWeight T).pointCharacter t = 1 := by
      change (dPointEquiv 1 ((chi.1 : TorusWeight T).onPoints t) 0 : k) = 1
      rw [hker, dPointEquiv_one]
      rfl
    have haction := hD t
    have heq' : T.includePoint t = (S chi).includePoint s := heq
    rw [heq', hpoint, one_smul] at haction
    apply Derivation.ext
    intro f
    rw [identityTangentConjugationLinearMap_apply]
    have hf := congrArg (fun E : IdentityPointDerivation G => E f) haction
    rw [Theory.AlgebraicGroup.identityTangentRepresentation_action_apply] at hf
    exact hf
  have hweightJ (chi : W) :
      weightSpace rho T (chi.1 : TorusWeight T) ≤
        LinearMap.range (identityTangentMorphismLinearMap J.inclusion) := by
    intro D hD
    obtain ⟨E, hE⟩ := hweightC chi hD
    let q : AlgebraicGroup.Morphism (C chi).carrierVariety J.carrierVariety :=
      (C chi).inclusion.codRestrictClosedSubgroup J (fun x =>
        hCJ chi ((C chi).pointEquiv x).property)
    refine ⟨identityTangentMorphismLinearMap q E, ?_⟩
    calc
      identityTangentMorphismLinearMap J.inclusion
          (identityTangentMorphismLinearMap q E) =
          identityTangentMorphismLinearMap (J.inclusion.comp q) E := by
        rw [identityTangentMorphismLinearMap_comp]
        rfl
      _ = identityTangentMorphismLinearMap (C chi).inclusion E := by
        congr 1
      _ = D := hE
  let chi0 : W := Classical.choice hW
  have htrivialC : weightSpace rho T 1 ≤
      LinearMap.range
        (identityTangentMorphismLinearMap (C chi0).inclusion) := by
    intro D hD
    apply identityTangent_fixed_mem_centralizerIdentityComponent_range
      (S chi0)
      (isDiagonalizableClosedSubgroup_of_isSubtorus
        (hpack chi0).ambientConnectedKernel_isSubtorus) D
    intro s
    have hs : (S chi0).includePoint s ∈ S chi0 :=
      ((S chi0).pointEquiv s).property
    obtain ⟨t, _ht, heq⟩ :=
      ((hpack chi0).mem_ambientConnectedKernel_iff
        ((S chi0).includePoint s)).mp hs
    have haction := hD t
    have hone : (1 : TorusWeight T).pointCharacter t = 1 := rfl
    have heq' : T.includePoint t = (S chi0).includePoint s := heq
    rw [heq', hone, one_smul] at haction
    apply Derivation.ext
    intro f
    rw [identityTangentConjugationLinearMap_apply]
    have hf := congrArg (fun E : IdentityPointDerivation G => E f) haction
    rw [Theory.AlgebraicGroup.identityTangentRepresentation_action_apply] at hf
    exact hf
  have htrivialJ : weightSpace rho T 1 ≤
      LinearMap.range (identityTangentMorphismLinearMap J.inclusion) := by
    intro D hD
    obtain ⟨E, hE⟩ := htrivialC hD
    let q : AlgebraicGroup.Morphism (C chi0).carrierVariety J.carrierVariety :=
      (C chi0).inclusion.codRestrictClosedSubgroup J (fun x =>
        hCJ chi0 ((C chi0).pointEquiv x).property)
    refine ⟨identityTangentMorphismLinearMap q E, ?_⟩
    calc
      identityTangentMorphismLinearMap J.inclusion
          (identityTangentMorphismLinearMap q E) =
          identityTangentMorphismLinearMap (J.inclusion.comp q) E := by
        rw [identityTangentMorphismLinearMap_comp]
        rfl
      _ = identityTangentMorphismLinearMap (C chi0).inclusion E := by
        congr 1
      _ = D := hE
  have hallWeights (chi : TorusWeight T) : weightSpace rho T chi ≤
      LinearMap.range (identityTangentMorphismLinearMap J.inclusion) := by
    by_cases hchi : chi = 1
    · simpa only [hchi] using htrivialJ
    · by_cases hzero : weightSpace rho T chi = ⊥
      · rw [hzero]
        exact bot_le
      · let w : W := ⟨chi, hzero, hchi⟩
        simpa only [w] using hweightJ w
  have hsurj : Function.Surjective
      (identityTangentMorphismLinearMap J.inclusion) := by
    rw [← LinearMap.range_eq_top]
    apply top_unique
    rw [← identityTangentRepresentation_weightSpace_iSup_eq_top G T hT]
    exact iSup_le hallWeights
  have hJtop : J = ClosedSubgroup.top :=
    closedSubgroup_eq_top_of_identityTangent_surjective_of_connected J hG hsurj
  change Jsub = ⊤
  exact congrArg (fun H : ClosedSubgroup G => H.toSubgroup) hJtop

/-- The copy of an ambient subtorus inside a closed subgroup containing it. -/
public noncomputable def torusInsideClosedSubgroup
    {G : Variety k} [AlgebraicGroup G]
    (T H : ClosedSubgroup G) (hTH : T ≤ H) :
    ClosedSubgroup H.carrierVariety := by
  let f : AlgebraicGroup.Morphism T.carrierVariety H.carrierVariety :=
    T.inclusion.codRestrictClosedSubgroup H (fun t =>
      hTH ((T.pointEquiv t).property))
  exact f.imageClosedSubgroup

/-- A point of a containing closed subgroup lies in the transported torus
exactly when its ambient point lies in the original torus. -/
public theorem mem_torusInsideClosedSubgroup_iff
    {G : Variety k} [AlgebraicGroup G]
    (T H : ClosedSubgroup G) (hTH : T ≤ H)
    (x : Variety.Point H.carrierVariety) :
    letI : AlgebraicGroup H.carrierVariety := H.carrierAlgebraicGroup
    x ∈ torusInsideClosedSubgroup T H hTH ↔ H.includePoint x ∈ T := by
  letI : AlgebraicGroup H.carrierVariety := H.carrierAlgebraicGroup
  let f : AlgebraicGroup.Morphism T.carrierVariety H.carrierVariety :=
    T.inclusion.codRestrictClosedSubgroup H (fun t =>
      hTH ((T.pointEquiv t).property))
  have hf (t : Variety.Point T.carrierVariety) :
      H.inclusion.onPoints (f.onPoints t) = T.inclusion.onPoints t := by
    exact T.inclusion.codRestrictClosedSubgroup_inclusion_apply H
      (fun t => hTH ((T.pointEquiv t).property)) t
  change x ∈ f.imageClosedSubgroup ↔ H.includePoint x ∈ T
  change (∃ t, f.onPoints t = x) ↔ H.includePoint x ∈ T
  constructor
  · rintro ⟨t, rfl⟩
    change H.inclusion.onPoints (f.onPoints t) ∈ T
    rw [hf]
    exact (T.pointEquiv t).property
  · intro hx
    let t : Variety.Point T.carrierVariety :=
      T.pointEquiv.symm ⟨H.includePoint x, hx⟩
    refine ⟨t, H.inclusion_injective ?_⟩
    rw [hf]
    exact congrArg Subtype.val (T.pointEquiv.apply_symm_apply ⟨H.includePoint x, hx⟩)

/-- Transporting a subtorus into a containing closed subgroup again gives a
subtorus. -/
public theorem torusInsideClosedSubgroup_isSubtorus
    {G : Variety k} [AlgebraicGroup G]
    (T H : ClosedSubgroup G) (hTH : T ≤ H) (hT : IsSubtorus T) :
    letI : AlgebraicGroup H.carrierVariety := H.carrierAlgebraicGroup
    IsSubtorus (torusInsideClosedSubgroup T H hTH) := by
  letI : AlgebraicGroup H.carrierVariety := H.carrierAlgebraicGroup
  let f : AlgebraicGroup.Morphism T.carrierVariety H.carrierVariety :=
    T.inclusion.codRestrictClosedSubgroup H (fun t =>
      hTH ((T.pointEquiv t).property))
  change IsSubtorus f.imageClosedSubgroup
  exact morphism_image_isTorus f hT

/-- Closed-subgroup form of Bor1 9.5(2).  It applies directly to a connected
Borel containing `T`, or to a connected centralizer containing `T`. -/
public theorem closedSubgroup_torus_connectedKernelCentralizer_generation
    {G : Variety k} [AlgebraicGroup G]
    (T H : ClosedSubgroup G) (hTH : T ≤ H) (hT : IsSubtorus T)
    (hH : Variety.IsConnected H.carrierVariety)
    (hne : letI : AlgebraicGroup H.carrierVariety := H.carrierAlgebraicGroup
      (torusInsideClosedSubgroup T H hTH).centralizer ≠
        ClosedSubgroup.top) :
    letI : AlgebraicGroup H.carrierVariety := H.carrierAlgebraicGroup
    Subgroup.closure
        (⋃ chi : NontrivialIdentityTangentWeight H.carrierVariety
            (torusInsideClosedSubgroup T H hTH),
          (torusCharacterFixedIdentityComponent
              (torusInsideClosedSubgroup T H hTH) chi.1 :
            Set (Variety.Point H.carrierVariety))) = ⊤ := by
  letI : AlgebraicGroup H.carrierVariety := H.carrierAlgebraicGroup
  exact torus_connectedKernelCentralizer_generation
    (torusInsideClosedSubgroup T H hTH)
    (torusInsideClosedSubgroup_isSubtorus T H hTH hT) hH hne

end Theory.AlgebraicGroup.Bor1
