module

public import Theory.AlgebraicGroup.BNPair.BruhatIndexUnique

/-!
Standard parabolics in an abstract Tits system.

For a subset `I` of the distinguished involutions, `standardParabolic` is the
subgroup generated by `B` and the Bruhat cells indexed by `Subgroup.closure I`.
The main carrier theorem identifies this generated subgroup with exactly that
union of cells.  Every subgroup containing `B` is then recovered from the
distinguished cells it contains, and the construction reflects inclusion and
equality, with `B` and the whole group as its endpoints.

The proof is entirely internal to the BN-pair axioms.  The two cell-product
lemmas are the shortest-word exchange inductions in the GLS3 Carter excerpt
`Chapter2Ca1`, Propositions 8.2.4 and 8.2.5.  Their descent consequence shows
that every letter of a shortest word indexing a cell in a subgroup already has
its simple cell in that subgroup.  This gives the classification theorem
(8.3.2).  Finally, the
minimality argument of 8.3.4 removes one distinguished generator, regards the
remaining generators as another Tits system, and uses classification plus
Bruhat-index uniqueness to obtain a contradiction.  No root-system or
algebraic-group structure enters the argument.
-/

namespace Theory.AlgebraicGroup.TitsSystem

open scoped Pointwise

variable {X : Type*} [Group X]

@[expose] public def bruhatCell (T : TitsSystem (X := X))
    (w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) : Set X :=
  (T.B : Set X) * representativeSet T.B T.N w * (T.B : Set X)

/-- A chosen normalizer representative belongs to its Bruhat cell. -/
public lemma representative_mem_bruhatCell (T : TitsSystem (X := X))
    (w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) (nw : T.N)
    (hnw : QuotientGroup.mk' ((T.B ⊓ T.N).subgroupOf T.N) nw = w) :
    (nw : X) ∈ T.bruhatCell w := by
  rw [bruhatCell, B_mul_representativeSet_mul_B T.B T.N w nw hnw]
  exact DoubleCoset.mem_doubleCoset_self T.B T.B (nw : X)

private lemma inv_mem_bruhatCell (T : TitsSystem (X := X))
    (w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) {x : X}
    (hx : x ∈ T.bruhatCell w) : x⁻¹ ∈ T.bruhatCell w⁻¹ := by
  obtain ⟨y, hy, b₂, hb₂, rfl⟩ := Set.mem_mul.mp hx
  obtain ⟨b₁, hb₁, n, ⟨nN, hnw, rfl⟩, rfl⟩ := Set.mem_mul.mp hy
  refine ⟨(b₂⁻¹ * (nN⁻¹ : T.N) : X), ?_, b₁⁻¹, T.B.inv_mem hb₁, ?_⟩
  · exact ⟨b₂⁻¹, T.B.inv_mem hb₂, (nN⁻¹ : T.N),
      ⟨nN⁻¹, by rw [map_inv, hnw], rfl⟩, rfl⟩
  · simp only [mul_inv_rev, Subgroup.coe_inv, mul_assoc]

/-- If a subgroup contains `B` and one point of a Bruhat cell, it contains the
whole cell. -/
public lemma bruhatCell_subset_of_mem (T : TitsSystem (X := X))
    (H : Subgroup X) (hB : T.B ≤ H)
    {w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} {x : X}
    (hxw : x ∈ T.bruhatCell w) (hxH : x ∈ H) : T.bruhatCell w ⊆ H := by
  obtain ⟨nw, hnw⟩ := QuotientGroup.mk'_surjective ((T.B ⊓ T.N).subgroupOf T.N) w
  rw [bruhatCell, B_mul_representativeSet_mul_B T.B T.N w nw hnw] at hxw ⊢
  obtain ⟨z, hz, b₂, hb₂, rfl⟩ := Set.mem_mul.mp hxw
  obtain ⟨b₁, hb₁, -, rfl, rfl⟩ := Set.mem_mul.mp hz
  have hnH : (nw : X) ∈ H := by
    have := H.mul_mem (H.mul_mem (H.inv_mem (hB hb₁)) hxH) (H.inv_mem (hB hb₂))
    simpa only [mul_assoc, inv_mul_cancel_left, mul_inv_cancel, mul_one] using this
  intro y hy
  obtain ⟨z, hz, c₂, hc₂, rfl⟩ := Set.mem_mul.mp hy
  obtain ⟨c₁, hc₁, -, rfl, rfl⟩ := Set.mem_mul.mp hz
  exact H.mul_mem (H.mul_mem (hB hc₁) hnH) (hB hc₂)

private lemma eq_one_of_wordLength_eq_zero (T : TitsSystem (X := X))
    {w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hw : T.wordLength w = 0) : w = 1 := by
  obtain ⟨l, hlen, -, hprod⟩ := T.wordLength_spec w
  rw [hw] at hlen
  have hl : l = [] := List.eq_nil_of_length_eq_zero hlen
  subst l
  simpa using hprod.symm

private lemma wordLength_init_eq (T : TitsSystem (X := X))
    (l : List (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)) (hl : l ≠ [])
    (hlS : ∀ s ∈ l, s ∈ T.S)
    (hmin : l.length = T.wordLength l.prod) :
    T.wordLength l.dropLast.prod = l.dropLast.length := by
  let j := l.getLast hl
  have hj : j ∈ T.S := hlS j (List.getLast_mem hl)
  have hfull : l.dropLast ++ [j] = l := List.dropLast_append_getLast hl
  have hupper : T.wordLength l.dropLast.prod ≤ l.dropLast.length :=
    T.wordLength_le l.dropLast.prod l.dropLast
      (fun s hs => hlS s (by rw [← hfull]; simp [hs])) rfl
  obtain ⟨r, hrlen, hrS, hrprod⟩ := T.wordLength_spec l.dropLast.prod
  have hwhole : T.wordLength l.prod ≤ (r ++ [j]).length := by
    apply T.wordLength_le l.prod (r ++ [j])
    · intro s hs
      rcases List.mem_append.mp hs with hs | hs
      · exact hrS s hs
      · rw [List.mem_singleton] at hs
        subst s
        exact hj
    · rw [List.prod_append, hrprod, List.prod_singleton]
      simpa only [List.prod_append, List.prod_singleton] using congrArg List.prod hfull
  have hlower : l.dropLast.length ≤ T.wordLength l.dropLast.prod := by
    rw [← hrlen]
    simp only [List.length_append, List.length_singleton] at hwhole
    rw [← hmin, ← hfull, List.length_append, List.length_singleton] at hwhole
    omega
  omega

private lemma exists_wordLength_mul_right (T : TitsSystem (X := X))
    {w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} {n : ℕ}
    (hword : T.wordLength w = n) (hn : n ≠ 0) :
    ∃ v s, s ∈ T.S ∧ w = v * s ∧ T.wordLength v = n - 1 := by
  obtain ⟨l, hlen, hlS, hprod⟩ := T.wordLength_spec w
  rw [hword] at hlen
  have hl : l ≠ [] := by
    intro h
    subst l
    simp at hlen
    exact hn hlen.symm
  let s := l.getLast hl
  let v := l.dropLast.prod
  have hs : s ∈ T.S := hlS s (List.getLast_mem hl)
  have hfull : l.dropLast ++ [s] = l := List.dropLast_append_getLast hl
  have hvlen : T.wordLength v = l.dropLast.length := by
    apply T.wordLength_init_eq l hl hlS
    rw [hprod, hword]
    exact hlen
  refine ⟨v, s, hs, ?_, ?_⟩
  · rw [← hprod, ← hfull, List.prod_append, List.prod_singleton]
  · rw [hvlen]
    have hdrop : l.dropLast.length + 1 = l.length := by
      simpa only [List.length_append, List.length_singleton] using congrArg List.length hfull
    have : l.dropLast.length + 1 = n := hdrop.trans hlen
    omega

private lemma wordLength_mul_right_le (T : TitsSystem (X := X))
    {s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hs : s ∈ T.S)
    (w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) :
    T.wordLength (w * s) ≤ T.wordLength w + 1 := by
  obtain ⟨l, hlen, hlS, hprod⟩ := T.wordLength_spec w
  have hle := T.wordLength_le (w * s) (l ++ [s])
    (by
      intro t ht
      rcases List.mem_append.mp ht with ht | ht
      · exact hlS t ht
      · rw [List.mem_singleton] at ht
        subst t
        exact hs)
    (by simp only [List.prod_append, hprod, List.prod_singleton])
  simpa only [List.length_append, List.length_singleton, hlen] using hle

@[simp] public lemma bruhatCell_one (T : TitsSystem (X := X)) :
    T.bruhatCell 1 = (T.B : Set X) := by
  exact doubleCoset_one_eq_B T.B T.N

public lemma bruhatCell_mul_subset_product (T : TitsSystem (X := X))
    (u v : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) :
    T.bruhatCell (u * v) ⊆ T.bruhatCell u * T.bruhatCell v := by
  exact doubleCoset_mul_subset_product T.B T.N u v

private lemma bruhatCell_mul_bruhatCell_subset_right (T : TitsSystem (X := X))
    (w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)
    {s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hs : s ∈ T.S) :
    T.bruhatCell w * T.bruhatCell s ⊆
      T.bruhatCell (w * s) ∪ T.bruhatCell w := by
  intro x hx
  obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_mul.mp hx
  have haInv := T.inv_mem_bruhatCell w ha
  have hbInv := T.inv_mem_bruhatCell s hb
  have hsInv : s⁻¹ = s :=
    mul_eq_one_iff_inv_eq.mp (by simpa only [pow_two] using (T.involutions s hs).2)
  have hinv : (a * b)⁻¹ ∈ T.bruhatCell s * T.bruhatCell w⁻¹ := by
    refine ⟨b⁻¹, ?_, a⁻¹, haInv, (mul_inv_rev a b).symm⟩
    simpa only [hsInv] using hbInv
  rcases doubleCoset_mul_doubleCoset_subset_of_mem_S T hs w⁻¹ hinv with hsw | hw
  · exact Or.inl (by
      have := T.inv_mem_bruhatCell (s * w⁻¹) hsw
      simpa only [mul_inv_rev, inv_inv, hsInv] using this)
  · exact Or.inr (by
      have := T.inv_mem_bruhatCell w⁻¹ hw
      simpa only [inv_inv] using this)

/-- If left multiplication by a distinguished generator does not shorten the
index, the lower Bruhat cell in the exchange inclusion cannot occur. -/
public theorem bruhatCell_mul_bruhatCell_subset_of_wordLength_le
    (T : TitsSystem (X := X))
    {s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hs : s ∈ T.S)
    (w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)
    (hlen : T.wordLength w ≤ T.wordLength (s * w)) :
    T.bruhatCell s * T.bruhatCell w ⊆ T.bruhatCell (s * w) := by
  intro x hx
  generalize hn : T.wordLength w = n at hlen
  induction n using Nat.strong_induction_on generalizing s w x with
  | h n ih =>
      by_cases hn0 : n = 0
      · have hw : w = 1 := T.eq_one_of_wordLength_eq_zero (hn.trans hn0)
        subst w
        rw [bruhatCell_one] at hx
        simpa only [mul_one] using
          (by
            obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_mul.mp hx
            change a * b ∈
              (T.B : Set X) * representativeSet T.B T.N s * (T.B : Set X)
            simpa only [one_mul] using mul_mem_doubleCoset T.B T.N s T.B.one_mem hb ha)
      · obtain ⟨v, t, ht, hw, hvlen⟩ := T.exists_wordLength_mul_right hn hn0
        have hlenSV : T.wordLength v ≤ T.wordLength (s * v) := by
          by_contra hnot
          have hlt : T.wordLength (s * v) < T.wordLength v := Nat.lt_of_not_ge hnot
          have hright := T.wordLength_mul_right_le ht (s * v)
          have hsw : s * w = (s * v) * t := by rw [hw, mul_assoc]
          rw [hsw] at hlen
          omega
        rcases doubleCoset_mul_doubleCoset_subset_of_mem_S T hs w hx with hupper | hlower
        · exact hupper
        · exfalso
          obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_mul.mp hx
          change a * b ∈ T.bruhatCell w at hlower
          have hbprod : b ∈ T.bruhatCell v * T.bruhatCell t := by
            apply T.bruhatCell_mul_subset_product v t
            simpa only [hw] using hb
          obtain ⟨c, hc, d, hd, rfl⟩ := Set.mem_mul.mp hbprod
          have htInv : t⁻¹ = t :=
            mul_eq_one_iff_inv_eq.mp (by simpa only [pow_two] using (T.involutions t ht).2)
          have hdInv : d⁻¹ ∈ T.bruhatCell t := by
            have := T.inv_mem_bruhatCell t hd
            simpa only [htInv] using this
          have hyLeft : a * c ∈ T.bruhatCell s * T.bruhatCell v :=
            ⟨a, ha, c, hc, rfl⟩
          have hyUpper : a * c ∈ T.bruhatCell (s * v) := by
            exact ih (T.wordLength v) (by omega) hs v hyLeft rfl hlenSV
          have hyRight : a * c ∈ T.bruhatCell w * T.bruhatCell t := by
            refine ⟨a * (c * d), hlower, d⁻¹, hdInv, ?_⟩
            simp only [mul_assoc, mul_inv_cancel, mul_one]
          rcases T.bruhatCell_mul_bruhatCell_subset_right w ht hyRight with hwt | hwcell
          · have heq := T.doubleCoset_index_unique hyUpper hwt
            have ht2 : t * t = 1 := by simpa only [pow_two] using (T.involutions t ht).2
            have heq' : s * v = v := by
              simpa only [hw, mul_assoc, ht2, mul_one] using heq
            apply (T.involutions s hs).1
            exact mul_right_cancel (by simpa only [one_mul] using heq')
          · have heq := T.doubleCoset_index_unique hyUpper hwcell
            have ht2 : t * t = 1 := by simpa only [pow_two] using (T.involutions t ht).2
            have hsw : s * w = v := by
              calc
                s * w = (s * v) * t := by rw [hw, mul_assoc]
                _ = w * t := by rw [heq]
                _ = v := by rw [hw, mul_assoc, ht2, mul_one]
            rw [hsw, hvlen] at hlen
            omega

/-- A distinguished rank-one cell contains an element of the form `n b n`.
This is the nontriviality witness used in normalizer arguments. -/
public theorem exists_rankOne_witness (T : TitsSystem (X := X))
    {s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hs : s ∈ T.S) :
    ∃ (ns : T.N) (b : X),
      QuotientGroup.mk' ((T.B ⊓ T.N).subgroupOf T.N) ns = s ∧
      b ∈ T.B ∧ (ns : X) * b * (ns : X) ∈ T.bruhatCell s := by
  obtain ⟨ns, hns⟩ := QuotientGroup.mk'_surjective ((T.B ⊓ T.N).subgroupOf T.N) s
  let A : Set X := ({(ns : X)} : Set X) * (T.B : Set X) * ({(ns : X)} : Set X)
  have hnot : ¬A ⊆ (T.B : Set X) := by
    intro hsub
    have hA : A = (T.B : Set X) := by
      apply Set.Subset.antisymm hsub
      intro b hb
      let q : X := ns
      have hq2 : q ^ 2 ∈ T.B := by
        change ((ns ^ 2 : T.N) : X) ∈ T.B
        have hsq := T.representative_sq_mem_intersection hs ns hns
        exact hsq.1
      let q2i : X := (q ^ 2)⁻¹
      have hq2i : q2i ∈ T.B := T.B.inv_mem hq2
      let b₁ : X := q2i * b
      have hb₁ : b₁ ∈ T.B := T.B.mul_mem hq2i hb
      have hc₁ : q * b₁ * q ∈ T.B := hsub (by
        exact ⟨q * b₁, ⟨q, Set.mem_singleton q, b₁, hb₁, rfl⟩,
          q, Set.mem_singleton q, rfl⟩)
      let c : X := (q * b₁ * q) * q2i
      have hc : c ∈ T.B := T.B.mul_mem hc₁ hq2i
      refine ⟨q * c, ⟨q, Set.mem_singleton q, c, hc, rfl⟩,
        q, Set.mem_singleton q, ?_⟩
      dsimp only [c, b₁, q2i]
      simp only [pow_two, mul_inv_rev, mul_assoc, inv_mul_cancel, mul_one,
        mul_inv_cancel_left]
    apply T.nontrivial s hs
    calc
      representativeSet T.B T.N s * (T.B : Set X) * representativeSet T.B T.N s =
          A := by
        dsimp only [A]
        rw [mul_assoc, B_mul_representativeSet T.B T.N s ns hns, ← mul_assoc,
          representativeSet_mul_B T.B T.N s ns hns]
      _ = (T.B : Set X) := hA
  obtain ⟨z, hzA, hzB⟩ := Set.not_subset.mp hnot
  obtain ⟨y, hy, q₂, hq₂, rfl⟩ := Set.mem_mul.mp hzA
  rw [Set.mem_singleton_iff] at hq₂
  subst q₂
  obtain ⟨q₁, hq₁, b, hb, rfl⟩ := Set.mem_mul.mp hy
  rw [Set.mem_singleton_iff] at hq₁
  subst q₁
  have hzExchange := T.exchange s hs s (by
    exact ⟨(ns : X) * b, ⟨(ns : X), ⟨ns, hns, rfl⟩, b, hb, rfl⟩,
      (ns : X), ⟨ns, hns, rfl⟩, rfl⟩)
  have hs2 : s * s = 1 := by simpa only [pow_two] using (T.involutions s hs).2
  rcases hzExchange with hzOne | hzS
  · rw [hs2, doubleCoset_one_eq_B] at hzOne
    exact (hzB hzOne).elim
  · exact ⟨ns, b, hns, hb, hzS⟩

/-- If left multiplication by a distinguished generator shortens an index,
the product of the two Bruhat cells meets the original cell. -/
public theorem bruhatCell_mul_bruhatCell_inter_nonempty_of_wordLength_le
    (T : TitsSystem (X := X))
    {s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hs : s ∈ T.S)
    (w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)
    (hlen : T.wordLength (s * w) ≤ T.wordLength w) :
    (T.bruhatCell s * T.bruhatCell w ∩ T.bruhatCell w).Nonempty := by
  obtain ⟨ns, b, hns, hb, hz⟩ := T.exists_rankOne_witness hs
  obtain ⟨nw, hnw⟩ := QuotientGroup.mk'_surjective ((T.B ⊓ T.N).subgroupOf T.N) w
  let x : X := (ns : X) * b * (nw : X)
  have hnsCell := T.representative_mem_bruhatCell s ns hns
  have hnwCell := T.representative_mem_bruhatCell w nw hnw
  have hbnw : b * (nw : X) ∈ T.bruhatCell w := by
    change b * (nw : X) ∈
      (T.B : Set X) * representativeSet T.B T.N w * (T.B : Set X)
    simpa only [mul_one] using
      mul_mem_doubleCoset T.B T.N w hb T.B.one_mem hnwCell
  have hxProduct : x ∈ T.bruhatCell s * T.bruhatCell w :=
    ⟨(ns : X), hnsCell, b * (nw : X), hbnw, by
      dsimp only [x]
      rw [mul_assoc]⟩
  have hnsInv : QuotientGroup.mk' ((T.B ⊓ T.N).subgroupOf T.N) ns⁻¹ = s := by
    rw [map_inv, hns]
    exact mul_eq_one_iff_inv_eq.mp
      (by simpa only [pow_two] using (T.involutions s hs).2)
  have hnsInvNw :
      QuotientGroup.mk' ((T.B ⊓ T.N).subgroupOf T.N) (ns⁻¹ * nw) = s * w := by
    rw [map_mul, hnsInv, hnw]
  have htail := T.representative_mem_bruhatCell (s * w) (ns⁻¹ * nw) hnsInvNw
  have hxSecondProduct : x ∈ T.bruhatCell s * T.bruhatCell (s * w) := by
    refine ⟨(ns : X) * b * (ns : X), hz,
      ((ns⁻¹ * nw : T.N) : X), htail, ?_⟩
    dsimp only [x]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, mul_assoc, mul_inv_cancel_left]
  have hs2 : s * s = 1 := by simpa only [pow_two] using (T.involutions s hs).2
  have hlen' : T.wordLength (s * w) ≤ T.wordLength (s * (s * w)) := by
    simpa only [← mul_assoc, hs2, one_mul] using hlen
  have hxCell := T.bruhatCell_mul_bruhatCell_subset_of_wordLength_le
    hs (s * w) hlen' hxSecondProduct
  have : x ∈ T.bruhatCell w := by
    simpa only [← mul_assoc, hs2, one_mul] using hxCell
  exact ⟨x, hxProduct, this⟩

/-- If a Bruhat cell belongs to a subgroup containing `B`, then every simple
left descent of its index also belongs to that subgroup. -/
public theorem bruhatCell_subset_of_descent (T : TitsSystem (X := X))
    (H : Subgroup X) (hB : T.B ≤ H)
    {s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hs : s ∈ T.S)
    (w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)
    (hlen : T.wordLength (s * w) ≤ T.wordLength w)
    (hw : T.bruhatCell w ⊆ H) : T.bruhatCell s ⊆ H := by
  obtain ⟨z, hzProduct, hzW⟩ :=
    T.bruhatCell_mul_bruhatCell_inter_nonempty_of_wordLength_le hs w hlen
  obtain ⟨a, ha, b, hb, hab⟩ := Set.mem_mul.mp hzProduct
  have hzH : z ∈ H := hw hzW
  have hbH : b ∈ H := hw hb
  have haH : a ∈ H := by
    have := H.mul_mem hzH (H.inv_mem hbH)
    rw [← hab] at this
    simpa only [mul_assoc, mul_inv_cancel, mul_one] using this
  exact T.bruhatCell_subset_of_mem H hB ha haH

private def parabolicCarrier (T : TitsSystem (X := X))
    (I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)) : Set X :=
  {x | ∃ w ∈ Subgroup.closure I, x ∈ T.bruhatCell w}

/-- The standard parabolic attached to `I` is generated by `B` together with
the Bruhat cells whose indices belong to the subgroup generated by `I`. -/
public def standardParabolic (T : TitsSystem (X := X))
    (I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)) : Subgroup X :=
  Subgroup.closure ((T.B : Set X) ∪ T.parabolicCarrier I)

private lemma mem_submonoid_closure_of_mem_subgroup_closure
    (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (hI : I ⊆ T.S)
    {w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hw : w ∈ Subgroup.closure I) :
    w ∈ Submonoid.closure I := by
  let M := Submonoid.closure I
  have hmem : ∀ v ∈ Subgroup.closure I, v ∈ M ∧ v⁻¹ ∈ M := by
    intro v hv
    induction hv using Subgroup.closure_induction with
    | mem s hs =>
        have hsM : s ∈ M := Submonoid.subset_closure hs
        have hsInv : s⁻¹ = s :=
          mul_eq_one_iff_inv_eq.mp
            (by simpa only [pow_two] using (T.involutions s (hI hs)).2)
        refine ⟨hsM, ?_⟩
        rw [hsInv]
        exact hsM
    | one => exact ⟨M.one_mem, by rw [inv_one]; exact M.one_mem⟩
    | mul a b ha hb iha ihb =>
        refine ⟨M.mul_mem iha.1 ihb.1, ?_⟩
        rw [mul_inv_rev]
        exact M.mul_mem ihb.2 iha.2
    | inv a ha iha => exact ⟨iha.2, by simpa using iha.1⟩
  exact (hmem w hw).1

private lemma B_mul_bruhatCell_subset (T : TitsSystem (X := X))
    (w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) :
    (T.B : Set X) * T.bruhatCell w ⊆ T.bruhatCell w := by
  rintro x ⟨b, hb, y, hy, rfl⟩
  obtain ⟨z, hz, c, hc, rfl⟩ := Set.mem_mul.mp hy
  obtain ⟨b₁, hb₁, n, hn, rfl⟩ := Set.mem_mul.mp hz
  exact ⟨(b * b₁) * n, ⟨b * b₁, T.B.mul_mem hb hb₁, n, hn, rfl⟩,
    c, hc, by simp only [mul_assoc]⟩

private lemma bruhatCell_word_mul_subset_parabolicCarrier
    (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (hI : I ⊆ T.S)
    (l : List (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N))
    (hlI : ∀ s ∈ l, s ∈ I)
    {v : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hv : v ∈ Subgroup.closure I) :
    T.bruhatCell l.prod * T.bruhatCell v ⊆ T.parabolicCarrier I := by
  induction l with
  | nil =>
      intro x hx
      exact ⟨v, hv, T.B_mul_bruhatCell_subset v (by simpa using hx)⟩
  | cons s l ih =>
      have hsI : s ∈ I := hlI s (by simp)
      have hsS : s ∈ T.S := hI hsI
      have hlI' : ∀ t ∈ l, t ∈ I := by
        intro t ht
        exact hlI t (by simp [ht])
      intro x hx
      obtain ⟨a, ha, b, hb, hab⟩ := Set.mem_mul.mp hx
      have haSplit := T.bruhatCell_mul_subset_product s l.prod ha
      obtain ⟨a₁, ha₁, a₂, ha₂, haeq⟩ := Set.mem_mul.mp haSplit
      have htail : a₂ * b ∈ T.parabolicCarrier I :=
        ih hlI' ⟨a₂, ha₂, b, hb, rfl⟩
      obtain ⟨k, hk, hkCell⟩ := htail
      have hxExchange : a₁ * (a₂ * b) ∈
          T.bruhatCell (s * k) ∪ T.bruhatCell k :=
        doubleCoset_mul_doubleCoset_subset_of_mem_S T hsS k
          ⟨a₁, ha₁, a₂ * b, hkCell, rfl⟩
      have hx' : x = a₁ * (a₂ * b) := by
        rw [← hab, ← haeq, mul_assoc]
      rw [hx']
      rcases hxExchange with hxsk | hxk
      · exact ⟨s * k, (Subgroup.closure I).mul_mem (Subgroup.subset_closure hsI) hk, hxsk⟩
      · exact ⟨k, hk, hxk⟩

private lemma parabolicCarrier_mul_mem (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (hI : I ⊆ T.S)
    {x y : X} (hx : x ∈ T.parabolicCarrier I) (hy : y ∈ T.parabolicCarrier I) :
    x * y ∈ T.parabolicCarrier I := by
  obtain ⟨u, hu, hxCell⟩ := hx
  obtain ⟨v, hv, hyCell⟩ := hy
  have huMonoid := T.mem_submonoid_closure_of_mem_subgroup_closure hI hu
  obtain ⟨l, hlI, hlprod⟩ := Submonoid.exists_list_of_mem_closure huMonoid
  apply T.bruhatCell_word_mul_subset_parabolicCarrier hI l hlI hv
  rw [hlprod]
  exact ⟨x, hxCell, y, hyCell, rfl⟩

private def parabolicCarrierSubgroup (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (hI : I ⊆ T.S) : Subgroup X where
  carrier := T.parabolicCarrier I
  one_mem' := ⟨1, (Subgroup.closure I).one_mem, by simp⟩
  mul_mem' hx hy := T.parabolicCarrier_mul_mem hI hx hy
  inv_mem' := by
    rintro x ⟨w, hw, hx⟩
    exact ⟨w⁻¹, (Subgroup.closure I).inv_mem hw, T.inv_mem_bruhatCell w hx⟩

/-- The subgroup generated by the indicated Bruhat cells is exactly their
union when `I` consists of distinguished generators. -/
public theorem mem_standardParabolic_iff (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (hI : I ⊆ T.S) (x : X) :
    x ∈ T.standardParabolic I ↔
      ∃ w ∈ Subgroup.closure I, x ∈ T.bruhatCell w := by
  change x ∈ Subgroup.closure ((T.B : Set X) ∪ T.parabolicCarrier I) ↔ _
  constructor
  · intro hx
    have hle : Subgroup.closure ((T.B : Set X) ∪ T.parabolicCarrier I) ≤
        T.parabolicCarrierSubgroup hI := by
      rw [Subgroup.closure_le]
      intro y hy
      rcases hy with hyB | hyP
      · exact ⟨1, (Subgroup.closure I).one_mem, by simpa using hyB⟩
      · exact hyP
    exact hle hx
  · rintro ⟨w, hw, hxw⟩
    exact Subgroup.subset_closure (Or.inr ⟨w, hw, hxw⟩)

public lemma B_le_standardParabolic (T : TitsSystem (X := X))
    (I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)) : T.B ≤ T.standardParabolic I := by
  intro b hb
  exact Subgroup.subset_closure (Or.inl hb)

private lemma bruhatCell_subset_of_mem_closure (T : TitsSystem (X := X))
    (H : Subgroup X) (hB : T.B ≤ H)
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)}
    (hI : ∀ s ∈ I, T.bruhatCell s ⊆ H)
    {w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hw : w ∈ Subgroup.closure I) :
    T.bruhatCell w ⊆ H := by
  induction hw using Subgroup.closure_induction with
  | mem s hs => exact hI s hs
  | one => simpa using hB
  | mul u v hu hv ihu ihv =>
      intro x hx
      obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_mul.mp
        (T.bruhatCell_mul_subset_product u v hx)
      exact H.mul_mem (ihu ha) (ihv hb)
  | inv u hu ihu =>
      intro x hx
      have hxInv : x⁻¹ ∈ T.bruhatCell u := by
        have := T.inv_mem_bruhatCell u⁻¹ hx
        simpa only [inv_inv] using this
      exact inv_inv x ▸ H.inv_mem (ihu hxInv)

/-- A standard parabolic lies in every subgroup containing `B` and the
simple cells from which it is generated. -/
public theorem standardParabolic_le (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (H : Subgroup X)
    (hB : T.B ≤ H) (hI : ∀ s ∈ I, T.bruhatCell s ⊆ H) :
    T.standardParabolic I ≤ H := by
  rw [standardParabolic, Subgroup.closure_le]
  rintro x (hxB | ⟨w, hw, hxw⟩)
  · exact hB hxB
  · exact T.bruhatCell_subset_of_mem_closure H hB hI hw hxw

/-- The distinguished indices whose Bruhat cells lie in a subgroup. -/
public def simpleIndices (T : TitsSystem (X := X)) (H : Subgroup X) :
    Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) :=
  {s | s ∈ T.S ∧ T.bruhatCell s ⊆ H}

@[simp] public theorem mem_simpleIndices_iff (T : TitsSystem (X := X))
    (H : Subgroup X) (s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) :
    s ∈ T.simpleIndices H ↔ s ∈ T.S ∧ T.bruhatCell s ⊆ H := Iff.rfl

public lemma simpleIndices_subset (T : TitsSystem (X := X)) (H : Subgroup X) :
    T.simpleIndices H ⊆ T.S := fun _ hs => hs.1

private lemma wordLength_tail_eq_local (T : TitsSystem (X := X))
    {s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N}
    {l : List (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)}
    (hs : s ∈ T.S) (hlS : ∀ t ∈ l, t ∈ T.S)
    (hmin : (s :: l).length = T.wordLength ((s :: l).prod)) :
    T.wordLength l.prod = l.length := by
  have hupper : T.wordLength l.prod ≤ l.length := T.wordLength_le l.prod l hlS rfl
  obtain ⟨r, hrlen, hrS, hrprod⟩ := T.wordLength_spec l.prod
  have hlower : T.wordLength ((s :: l).prod) ≤ (s :: r).length := by
    apply T.wordLength_le ((s :: l).prod) (s :: r)
    · simpa only [List.forall_mem_cons] using ⟨hs, hrS⟩
    · simp only [List.prod_cons, hrprod]
  have hlower' : (s :: l).length ≤ (s :: r).length := by
    simpa only [hmin] using hlower
  simp only [List.length_cons, hrlen] at hlower'
  omega

private lemma shortest_word_cells_subset (T : TitsSystem (X := X))
    (H : Subgroup X) (hB : T.B ≤ H)
    (l : List (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N))
    (hlS : ∀ s ∈ l, s ∈ T.S)
    (hmin : l.length = T.wordLength l.prod)
    (hlCell : T.bruhatCell l.prod ⊆ H) :
    ∀ s ∈ l, T.bruhatCell s ⊆ H := by
  induction l with
  | nil => simp
  | cons s l ih =>
      have hs : s ∈ T.S := hlS s (by simp)
      have hlS' : ∀ t ∈ l, t ∈ T.S := by
        intro t ht
        exact hlS t (by simp [ht])
      have htailLength : T.wordLength l.prod = l.length :=
        T.wordLength_tail_eq_local hs hlS' hmin
      have hs2 : s * s = (1 : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) := by
        simpa only [pow_two] using (T.involutions s hs).2
      have hdescent : T.wordLength (s * (s :: l).prod) ≤
          T.wordLength (s :: l).prod := by
        calc
          T.wordLength (s * (s :: l).prod) = T.wordLength l.prod := by
            simp only [List.prod_cons, ← mul_assoc, hs2, one_mul]
          _ = l.length := htailLength
          _ ≤ (s :: l).length := by simp
          _ = T.wordLength (s :: l).prod := hmin
      have hsCell : T.bruhatCell s ⊆ H :=
        T.bruhatCell_subset_of_descent H hB hs (s :: l).prod hdescent hlCell
      have hlCell' : T.bruhatCell l.prod ⊆ H := by
        obtain ⟨ns, hns⟩ :=
          QuotientGroup.mk'_surjective ((T.B ⊓ T.N).subgroupOf T.N) s
        obtain ⟨nl, hnl⟩ :=
          QuotientGroup.mk'_surjective ((T.B ⊓ T.N).subgroupOf T.N) l.prod
        have hnsnl : QuotientGroup.mk' ((T.B ⊓ T.N).subgroupOf T.N) (ns * nl) =
            (s :: l).prod := by
          simp only [map_mul, hns, hnl, List.prod_cons]
        have hprodH : (((ns * nl : T.N) : X)) ∈ H :=
          hlCell (T.representative_mem_bruhatCell (s :: l).prod (ns * nl) hnsnl)
        have hnsH : (ns : X) ∈ H :=
          hsCell (T.representative_mem_bruhatCell s ns hns)
        have hnlH : (nl : X) ∈ H := by
          have := H.mul_mem (H.inv_mem hnsH) hprodH
          simpa only [Subgroup.coe_mul, Subgroup.coe_inv, mul_assoc,
            inv_mul_cancel_left] using this
        exact T.bruhatCell_subset_of_mem H hB
          (T.representative_mem_bruhatCell l.prod nl hnl) hnlH
      intro t ht
      rcases List.mem_cons.mp ht with rfl | ht
      · exact hsCell
      · exact ih hlS' htailLength.symm hlCell' t ht

private lemma list_prod_mem_subgroup (H : Subgroup X) (l : List X)
    (hl : ∀ x ∈ l, x ∈ H) : l.prod ∈ H := by
  induction l with
  | nil => exact H.one_mem
  | cons x l ih =>
      rw [List.prod_cons]
      exact H.mul_mem (hl x (by simp)) (ih (by
        intro y hy
        exact hl y (by simp [hy])))

private lemma index_mem_closure_simpleIndices_of_cell_subset
    (T : TitsSystem (X := X)) (H : Subgroup X) (hB : T.B ≤ H)
    {w : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hw : T.bruhatCell w ⊆ H) :
    w ∈ Subgroup.closure (T.simpleIndices H) := by
  obtain ⟨l, hlen, hlS, hprod⟩ := T.wordLength_spec w
  have hlCells := T.shortest_word_cells_subset H hB l hlS
    (by rw [hprod]; exact hlen) (by simpa only [hprod] using hw)
  rw [← hprod]
  apply list_prod_mem_subgroup (Subgroup.closure (T.simpleIndices H)) l
  intro s hs
  apply Subgroup.subset_closure
  exact ⟨hlS s hs, hlCells s hs⟩

/-- Every subgroup containing `B` is the standard parabolic determined by its
distinguished Bruhat cells. -/
public theorem subgroup_eq_standardParabolic_simpleIndices
    (T : TitsSystem (X := X)) (H : Subgroup X) (hB : T.B ≤ H) :
    H = T.standardParabolic (T.simpleIndices H) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨w, hxw⟩ := T.exists_mem_doubleCoset x
    have hwH : T.bruhatCell w ⊆ H := T.bruhatCell_subset_of_mem H hB hxw hx
    apply (T.mem_standardParabolic_iff (T.simpleIndices_subset H) x).2
    exact ⟨w, T.index_mem_closure_simpleIndices_of_cell_subset H hB hwH, hxw⟩
  · apply T.standardParabolic_le H hB
    intro s hs
    exact hs.2

@[simp] public theorem standardParabolic_empty (T : TitsSystem (X := X)) :
    T.standardParabolic ∅ = T.B := by
  apply le_antisymm
  · apply T.standardParabolic_le T.B le_rfl
    simp
  · exact T.B_le_standardParabolic ∅

private lemma eq_one_or_eq_of_mem_closure_singleton {G : Type*} [Group G]
    {s w : G} (hs2 : s ^ 2 = 1) (hw : w ∈ Subgroup.closure ({s} : Set G)) :
    w = 1 ∨ w = s := by
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
      right
      simpa only [Set.mem_singleton_iff] using hx
  | one => exact Or.inl rfl
  | mul a b ha hb iha ihb =>
      rcases iha with rfl | rfl <;> rcases ihb with rfl | rfl
      all_goals simp_all [pow_two]
  | inv a ha iha =>
      rcases iha with rfl | rfl
      all_goals simp_all [pow_two, mul_eq_one_iff_inv_eq]

/-- No distinguished generator lies in the subgroup generated by the other
members of a subset of `S`. This is the BN-pair form of irredundancy. -/
public theorem mem_of_mem_closure_of_subset_S (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (hI : I ⊆ T.S)
    {s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hs : s ∈ T.S)
    (hsClosure : s ∈ Subgroup.closure I) : s ∈ I := by
  by_contra hsI
  let J : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N) := T.S \ {s}
  have hIJ : I ⊆ J := by
    intro t ht
    exact ⟨hI ht, by
      rw [Set.mem_singleton_iff]
      intro hts
      exact hsI (hts ▸ ht)⟩
  have hsJClosure : s ∈ Subgroup.closure J :=
    Subgroup.closure_mono hIJ hsClosure
  have hJGenerate : Subgroup.closure J = ⊤ := by
    apply top_unique
    rw [← T.quotient_generate]
    rw [Subgroup.closure_le]
    intro t ht
    by_cases hts : t = s
    · subst t
      exact hsJClosure
    · exact Subgroup.subset_closure ⟨ht, by simpa only [Set.mem_singleton_iff]⟩
  let T' : TitsSystem (X := X) := {
    B := T.B
    N := T.N
    generate := T.generate
    intersection_normal := T.intersection_normal
    S := J
    finite_S := by
      dsimp only [J]
      exact T.finite_S.sdiff
    involutions := by
      intro t ht
      exact T.involutions t ht.1
    quotient_generate := hJGenerate
    exchange := by
      intro t ht
      exact T.exchange t ht.1
    nontrivial := by
      intro t ht
      exact T.nontrivial t ht.1
  }
  let P := T.standardParabolic ({s} : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N))
  have hclass : P = T'.standardParabolic (T'.simpleIndices P) := by
    apply T'.subgroup_eq_standardParabolic_simpleIndices P
    simpa only [T'] using T.B_le_standardParabolic ({s} : Set _)
  have hsimple : T'.simpleIndices P = ∅ := by
    ext t
    simp only [Set.mem_empty_iff_false, iff_false]
    intro ht
    change t ∈ J ∧ T.bruhatCell t ⊆ P at ht
    have htJ : t ∈ J := ht.1
    have htS : t ∈ T.S := htJ.1
    have htne : t ≠ s := by
      simpa only [J, Set.mem_singleton_iff] using htJ.2
    have htCell : T.bruhatCell t ⊆ P := ht.2
    obtain ⟨nt, hnt⟩ :=
      QuotientGroup.mk'_surjective ((T.B ⊓ T.N).subgroupOf T.N) t
    have hntP : (nt : X) ∈ P := htCell (T.representative_mem_bruhatCell t nt hnt)
    obtain ⟨w, hw, hntw⟩ := (T.mem_standardParabolic_iff (I := {s})
      (Set.singleton_subset_iff.mpr hs) (nt : X)).1 (by
        simpa only [P] using hntP)
    have htw : t = w := T.doubleCoset_index_unique
      (T.representative_mem_bruhatCell t nt hnt) hntw
    rcases eq_one_or_eq_of_mem_closure_singleton
      (T.involutions s hs).2 hw with hw1 | hws
    · apply (T.involutions t htS).1
      exact htw.trans hw1
    · exact htne (htw.trans hws)
  have hPB : P = T.B := by
    rw [hsimple, T'.standardParabolic_empty] at hclass
    simpa only [T'] using hclass
  obtain ⟨ns, hns⟩ := QuotientGroup.mk'_surjective ((T.B ⊓ T.N).subgroupOf T.N) s
  have hnsP : (ns : X) ∈ P := by
    apply Subgroup.subset_closure
    right
    exact ⟨s, Subgroup.subset_closure (by simp),
      T.representative_mem_bruhatCell s ns hns⟩
  have hnsB : (ns : X) ∈ T.B := hPB ▸ hnsP
  apply (T.involutions s hs).1
  rw [← hns]
  apply (QuotientGroup.eq_one_iff ns).2
  exact ⟨hnsB, ns.property⟩

public lemma bruhatCell_subset_standardParabolic_of_mem
    (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} {s : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N}
    (hs : s ∈ I) : T.bruhatCell s ⊆ T.standardParabolic I := by
  intro x hx
  apply Subgroup.subset_closure
  right
  exact ⟨s, Subgroup.subset_closure hs, hx⟩

/-- The simple-cell construction recovers the subset defining a standard
parabolic. -/
public theorem simpleIndices_standardParabolic (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (hI : I ⊆ T.S) :
    T.simpleIndices (T.standardParabolic I) = I := by
  ext s
  constructor
  · intro hsP
    obtain ⟨ns, hns⟩ :=
      QuotientGroup.mk'_surjective ((T.B ⊓ T.N).subgroupOf T.N) s
    have hnsP : (ns : X) ∈ T.standardParabolic I :=
      hsP.2 (T.representative_mem_bruhatCell s ns hns)
    obtain ⟨w, hw, hnsw⟩ := (T.mem_standardParabolic_iff hI (ns : X)).1 hnsP
    have hsw : s = w := T.doubleCoset_index_unique
      (T.representative_mem_bruhatCell s ns hns) hnsw
    apply T.mem_of_mem_closure_of_subset_S hI hsP.1
    simpa only [← hsw] using hw
  · intro hs
    exact ⟨hI hs, T.bruhatCell_subset_standardParabolic_of_mem hs⟩

/-- Exact carrier form of standard-parabolic saturation. -/
public theorem standardParabolic_carrier (T : TitsSystem (X := X))
    {I : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (hI : I ⊆ T.S) :
    (T.standardParabolic I : Set X) =
      {x | ∃ w ∈ Subgroup.closure I, x ∈ T.bruhatCell w} := by
  ext x
  exact T.mem_standardParabolic_iff hI x

public theorem standardParabolic_mono (T : TitsSystem (X := X))
    {I J : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)} (hIJ : I ⊆ J) :
    T.standardParabolic I ≤ T.standardParabolic J := by
  apply T.standardParabolic_le (T.standardParabolic J) (T.B_le_standardParabolic J)
  intro s hs
  exact T.bruhatCell_subset_standardParabolic_of_mem (hIJ hs)

/-- Standard parabolics reflect inclusion on subsets of the distinguished
generators. -/
public theorem standardParabolic_le_iff (T : TitsSystem (X := X))
    {I J : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)}
    (hI : I ⊆ T.S) (hJ : J ⊆ T.S) :
    T.standardParabolic I ≤ T.standardParabolic J ↔ I ⊆ J := by
  constructor
  · intro hle s hs
    have hsSimpleI : s ∈ T.simpleIndices (T.standardParabolic I) := by
      rw [T.simpleIndices_standardParabolic hI]
      exact hs
    have hsSimpleJ : s ∈ T.simpleIndices (T.standardParabolic J) :=
      ⟨hsSimpleI.1, fun x hx => hle (hsSimpleI.2 hx)⟩
    rw [T.simpleIndices_standardParabolic hJ] at hsSimpleJ
    exact hsSimpleJ
  · exact T.standardParabolic_mono

/-- Two standard parabolics attached to subsets of `S` are equal exactly when
their defining subsets are equal. -/
public theorem standardParabolic_eq_iff (T : TitsSystem (X := X))
    {I J : Set (T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N)}
    (hI : I ⊆ T.S) (hJ : J ⊆ T.S) :
    T.standardParabolic I = T.standardParabolic J ↔ I = J := by
  constructor
  · intro h
    apply Set.Subset.antisymm
    · exact (T.standardParabolic_le_iff hI hJ).1 h.le
    · exact (T.standardParabolic_le_iff hJ hI).1 h.ge
  · intro h
    rw [h]

@[simp] public theorem standardParabolic_S (T : TitsSystem (X := X)) :
    T.standardParabolic T.S = ⊤ := by
  have hclass := T.subgroup_eq_standardParabolic_simpleIndices (⊤ : Subgroup X) le_top
  have hsimple : T.simpleIndices (⊤ : Subgroup X) = T.S := by
    ext s
    change (s ∈ T.S ∧ T.bruhatCell s ⊆ (⊤ : Subgroup X)) ↔ s ∈ T.S
    constructor
    · exact fun hs => hs.1
    · exact fun hs => ⟨hs, Set.subset_univ _⟩
  rw [hsimple] at hclass
  exact hclass.symm

end Theory.AlgebraicGroup.TitsSystem
