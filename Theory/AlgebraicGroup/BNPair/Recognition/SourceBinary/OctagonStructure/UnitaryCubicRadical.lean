module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.RootCoordinates.SubgroupFixedProducts
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.OctagonStructure.UnitaryCubicFixed
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.HexagonStructure.SuzukiDerivedRoots

/-!
# The full cubic centralizer in the unitary octagon radical

The seven unique positive-root coordinates have four linear and three
unitary factors. The Cartan three-core has trivial fixed groups on the
linear roots and fixes exactly the Frattini groups of the unitary roots.
Thus its entire radical centralizer is the ordered product of those three
Frattini groups. Both endpoint orientations use the same quotient and
literal Weyl words. The full Cartan and the group generated by the two
opposite unitary Frattini groups normalize this centralizer, as required
in the following commutator argument.

Source: Fong--Seitz I (6F), printed pp.46--47. No abelianness or terminal
unitary exclusion is assumed or asserted here.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.ReeSource
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.OctagonStructure
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P) (split : SplitData Q.tits)

private theorem ssq (i : Fin 2) : Q.simple i*Q.simple i = 1 := by
  simpa only [pow_two] using (Q.tits.involutions _ (Q.simple_mem i)).2
private theorem right_rep (i : Fin 2) (v w : Weyl Q) :
    rightConjugate (rootAt Q split i v) (representative w : X ⧸ Q.D) =
      rootAt Q split i (v*w) := rootAt_right Q split i v w _ (representative_spec _)
private theorem right_simple (i : Fin 2) (w : Weyl Q) :
    rightConjugate (simpleRoot Q split i) (representative w : X ⧸ Q.D) =
      rootAt Q split i w := rfl
/-- The full cubic radical centralizer is the source's ordered product of
three root Frattini groups, in either endpoint orientation. -/
theorem unitary_cubic_radical_product (hm : rotationOrder Q = 8)
    (i j : Fin 2) (hij : i ≠ j)
    (hfree : ∀ w : Weyl Q, rootAt Q split i w ⊓
      centralizer (cartanThreeCore Q : Set (X ⧸ Q.D)) = ⊥)
    (hfix : ∀ w : Weyl Q, rootAt Q split j w ⊓
      centralizer (cartanThreeCore Q : Set (X ⧸ Q.D)) = rootFrattiniAt Q split j w) :
    (↑(simpleRemainder Q split j ⊓ centralizer (cartanThreeCore Q : Set (X ⧸ Q.D))) :
      Set (X ⧸ Q.D)) =
      (rootFrattiniAt Q split j (Q.simple i) : Set (X ⧸ Q.D)) *
      (rootFrattiniAt Q split j (Q.simple i*Q.simple j*Q.simple i) : Set (X ⧸ Q.D)) *
      (rootFrattiniAt Q split j (Q.simple i*Q.simple j) : Set (X ⧸ Q.D)) := by
  have hint (b : Bool) : rootIntersection split (longest Q) (alternatingWord Q b 7)⁻¹ =
      simpleRemainder Q split (if b then 0 else 1) := by
    have he : longest Q = Q.simple (if b then 0 else 1)*alternatingWord Q b 7 := by
      have hh := (alternatingWord_longest Q (!b)).symm
      rw [hm] at hh
      cases b <;> exact hh
    change split.U ⊓ unipotentConjugate split
      (longest Q*(alternatingWord Q b 7)⁻¹) = _
    rw [he,mul_inv_cancel_right]
    rfl
  have hlast : rootFrattiniAt Q split j (Q.simple i*Q.simple j*Q.simple i*Q.simple j*Q.simple i) =
      rootFrattiniAt Q split j (Q.simple i*Q.simple j) := by
    have hw : Q.simple i*Q.simple j*Q.simple i*Q.simple j*Q.simple i =
        (longest Q*Q.simple j)*(Q.simple i*Q.simple j) := by
      have hh (b : Bool) := alternatingWord_longest Q b
      rcases (show i=0 ∨ i=1 by omega) with rfl | rfl <;>
        rcases (show j=0 ∨ j=1 by omega) with rfl | rfl
      · exact (hij rfl).elim
      · rw [←hh false,hm]
        simp only [alternatingWord,Bool.false_eq_true,↓reduceIte,Bool.not_false,Bool.not_true,
          mul_one,mul_assoc,←mul_assoc (Q.simple 0) (Q.simple 0),ssq,one_mul]
      · rw [←hh true,hm]
        simp only [alternatingWord,Bool.false_eq_true,↓reduceIte,Bool.not_false,Bool.not_true,
          mul_one,mul_assoc,←mul_assoc (Q.simple 1) (Q.simple 1),ssq,one_mul]
      · exact (hij rfl).elim
    unfold rootFrattiniAt
    rw [hw,rootAt_longest_simple_mul Q split hm j i hij.symm]
  have h0 := ordered_root_subgroup_centralizer Q split false 7 (by omega)
    (cartanThreeCore Q) (cartanThreeCore_le Q)
  have h1 := ordered_root_subgroup_centralizer Q split true 7 (by omega)
    (cartanThreeCore Q) (cartanThreeCore_le Q)
  rw [hint] at h0 h1
  have hzero : simpleRoot Q split i ⊓ centralizer (cartanThreeCore Q : Set (X ⧸ Q.D)) = ⊥ := by
    simpa only [rootAt_one] using hfree 1
  simp only [mul_assoc] at hlast
  rcases (show i=0 ∨ i=1 by omega) with rfl | rfl <;>
    rcases (show j=0 ∨ j=1 by omega) with rfl | rfl
  · exact (hij rfl).elim
  · simp only [orderedRoots,Bool.false_eq_true,↓reduceIte,Bool.not_false,Bool.not_true,
      List.map_cons,List.map_nil,right_simple,right_rep,←mul_assoc,
      hzero,hfree,hfix,List.prod_cons,List.prod_nil,coe_bot,Set.singleton_one,
      one_mul,mul_one] at h0
    simpa only [hlast,mul_assoc] using h0
  · simp only [orderedRoots,Bool.false_eq_true,↓reduceIte,Bool.not_false,Bool.not_true,
      List.map_cons,List.map_nil,right_simple,right_rep,←mul_assoc,
      hzero,hfree,hfix,List.prod_cons,List.prod_nil,coe_bot,Set.singleton_one,
      one_mul,mul_one] at h1
    simpa only [hlast,mul_assoc] using h1
  · exact (hij rfl).elim

/-- The same radical centralizer is invariant under the full source Cartan. -/
theorem unitary_cubic_radical_cartan_normalizes (j : Fin 2)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j) :
    Q.tits.B ⊓ Q.tits.N ≤ normalizer
      (↑(simpleRemainder Q split j ⊓ centralizer (cartanThreeCore Q : Set (X ⧸ Q.D))) :
        Set (X ⧸ Q.D)) := by
  apply (le_inf (inf_le_left.trans ((Q.tits.B_le_standardParabolic _).trans
    (remainder_parabolic_normalizes Q split j hKj))) ?_).trans
      inf_normalizer_le_normalizer_inf
  exact inf_le_right.trans ((cartanThreeCore_normalized Q).trans
    (normalizer_le_normalizer_centralizer _))

/-- The two opposite unitary Frattini groups normalize the fixed radical.
This is the precise acting group in the first paragraph of printed p.47. -/
theorem unitary_cubic_radical_frattini_normalizes (j : Fin 2)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    (hfix : ∀ w : Weyl Q, rootAt Q split j w ⊓
      centralizer (cartanThreeCore Q : Set (X ⧸ Q.D)) = rootFrattiniAt Q split j w) :
    rootFrattiniAt Q split j 1 ⊔ rootFrattiniAt Q split j (Q.simple j) ≤ normalizer
      (↑(simpleRemainder Q split j ⊓ centralizer (cartanThreeCore Q : Set (X ⧸ Q.D))) :
        Set (X ⧸ Q.D)) := by
  have hR : rootFrattiniAt Q split j 1 ⊔ rootFrattiniAt Q split j (Q.simple j) ≤
      rankOne Q split j := by
    apply sup_le
    · exact (show rootFrattiniAt Q split j 1 ≤ simpleRoot Q split j by
        unfold rootFrattiniAt
        rw [rootAt_one]
        exact map_subtype_le _).trans le_sup_left
    · exact (map_subtype_le _).trans le_sup_right
  have hC : rootFrattiniAt Q split j 1 ⊔ rootFrattiniAt Q split j (Q.simple j) ≤
      centralizer (cartanThreeCore Q : Set (X ⧸ Q.D)) := by
    apply sup_le <;> rw [←hfix] <;> exact inf_le_right
  exact (le_inf (hR.trans ((rankOne_le_parabolic Q split j).trans
    (remainder_parabolic_normalizes Q split j hKj)))
      (hC.trans (centralizer (cartanThreeCore Q : Set (X ⧸ Q.D))).le_normalizer)).trans
        inf_normalizer_le_normalizer_inf

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.OctagonStructure
