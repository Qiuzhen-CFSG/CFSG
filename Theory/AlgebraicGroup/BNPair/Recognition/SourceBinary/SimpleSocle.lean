module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.LocalCoordinates
public import Theory.GroupTheory.SylowNormalIntersection
public import Theory.GroupTheory.ConjugateSpanNormalizer
public import Mathlib.GroupTheory.Subgroup.Simple

/-!
# A minimal normal simple power has one component

Let K be normal in a finite group Y, supplemented by a Sylow two-subgroup U,
and contained in every nontrivial normal subgroup of Y. Suppose K is a finite
power of a simple group and contains a faithful perfect local factor A,
normalized by U. If A is normally generated by its Sylow and all its proper
normal subgroups are solvable, LocalCoordinates puts A in one coordinate.

The K-conjugate span of A lies in that coordinate. Both K and U normalize
the span, so it is Y-normal. Ambient minimality forces the span to contain
K, and projection to that coordinate gives an actual isomorphism to the
simple factor. This proves simplicity without classifying that factor.

This is the single-component reduction for the perfect branch of the
Fong–Seitz invocation in DGS, Groups and Graphs, Part II, pp.80–81 and224.
The statement is carrier-general: Y may in particular be the finite
geometric quotient of an infinite universal amalgam completion. No descent
to a quotient of the original generated subgroup is required.
-/

public noncomputable section
open Subgroup
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary
variable {Y A C : Type*} [Group Y] [Finite Y] [Group A] [Finite A]
  [Nontrivial A] [Group.IsPerfect A] [Group C] [Finite C] [IsSimpleGroup C]

/-- A Sylow-normalized rank-one factor and ambient minimality collapse a simple power. -/
theorem simple_of_simple_power_local_factor (K : Subgroup Y) [K.Normal]
    (U : Sylow 2 Y) (hKU : K ⊔ (U : Subgroup Y) = ⊤)
    (hmin : ∀ V : Subgroup Y, V.Normal → V ≠ ⊥ → K ≤ V)
    {n : ℕ} (e : K ≃* (Fin n → C))
    (f : A →* Y) (hf : Function.Injective f) (hfK : f.range ≤ K)
    (hn : (U : Subgroup Y) ≤ normalizer (f.range : Set Y)) (T : Sylow 2 A)
    (hTU : (T : Subgroup A).map f ≤ U)
    (hgen : normalClosure (T : Set A) = ⊤)
    (hsol : ∀ N : Subgroup A, N.Normal → N ≠ ⊤ → Group.IsSolvable N) :
    IsSimpleGroup K := by
  classical
  let fK : A →* K := f.codRestrict K (fun a => hfK ⟨a, rfl⟩)
  have hfKinj : Function.Injective fK := fun a b hab => hf (congrArg Subtype.val hab)
  obtain ⟨UK, hUK⟩ := U.exists_subgroupOf_eq_of_normal K
  let V := UK.mapSurjective (f := e.toMonoidHom) e.surjective
  let g := e.toMonoidHom.comp fK
  have hg : Function.Injective g := e.injective.comp hfKinj
  have hTV : (T : Subgroup A).map g ≤ V := by
    rintro _ ⟨t, ht, rfl⟩
    apply mem_map_of_mem
    change fK t ∈ (UK : Subgroup K)
    rw [hUK]
    exact hTU (mem_map_of_mem f ht)
  have hnK : (UK : Subgroup K) ≤ normalizer (fK.range : Set K) := by
    intro u hu
    apply mem_normalizer_iff.mpr
    intro x
    have huU : (u : Y) ∈ (U : Subgroup Y) := by
      change u ∈ (U : Subgroup Y).subgroupOf K
      rwa [← hUK]
    have hrange (z : K) : z ∈ fK.range ↔ (z : Y) ∈ f.range := by
      constructor
      · rintro ⟨a, rfl⟩; exact ⟨a, rfl⟩
      · rintro ⟨a, ha⟩; exact ⟨a, Subtype.ext ha⟩
    simpa only [hrange, Subgroup.coe_mul, Subgroup.coe_inv] using
      mem_normalizer_iff.mp (hn huU) (x : Y)
  have hnV : (V : Subgroup (Fin n → C)) ≤ normalizer (g.range : Set (Fin n → C)) := by
    rw [MonoidHom.range_comp]
    exact (map_mono hnK).trans (fK.range.le_normalizer_map e.toMonoidHom)
  obtain ⟨i, hi⟩ := local_image_in_coordinate g hg V T hTV hnV hgen hsol
  let M := (coordinate (C := fun _ : Fin n => C) i).comap e.toMonoidHom
  let W := M.map K.subtype
  have hKW : K ≤ normalizer (W : Set Y) := by
    have hm := M.le_normalizer_map K.subtype
    simpa only [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype] using hm
  have hfW : f.range ≤ W := by
    rintro _ ⟨a, rfl⟩
    exact ⟨fK a, hi ⟨a, rfl⟩, rfl⟩
  let Z := conjugateSpanBy f.range K
  have hZn : Z.Normal := normalizer_eq_top_iff.mp (top_unique (hKU ▸
    sup_le (le_normalizer_conjugateSpanBy f.range K)
      (normalizes_conjugateSpanBy f.range K U hn le_normalizer_of_normal)))
  have hZne : Z ≠ ⊥ := by
    intro hz
    have hr : f.range = ⊥ := le_bot_iff.mp (hz ▸ le_conjugateSpanBy f.range K)
    obtain ⟨a, ha⟩ := exists_ne (1 : A)
    apply ha
    apply hf
    simpa using hr.le (show f a ∈ f.range from ⟨a, rfl⟩)
  have hKW' : K ≤ W := (hmin Z hZn hZne).trans (conjugateSpanBy_le hfW hKW)
  have hsupp (x : K) : e x ∈ coordinate (C := fun _ : Fin n => C) i := by
    obtain ⟨y, hy, hyx⟩ := hKW' x.property
    have he : y = x := Subtype.ext hyx
    exact he ▸ hy
  let p : K →* C := (Pi.evalMonoidHom (fun _ : Fin n => C) i).comp e.toMonoidHom
  have hp : Function.Bijective p := by
    constructor
    · intro a b hab
      apply e.injective
      funext j
      by_cases hji : j = i
      · subst j; exact hab
      · exact (hsupp a j hji).trans (hsupp b j hji).symm
    · intro c
      exact ⟨e.symm (Pi.mulSingle i c), by simp [p]⟩
  exact (MulEquiv.ofBijective p hp).isSimpleGroup

end Theory.AlgebraicGroup.TitsSystem.SourceBinary
