/-!
# The regular Suzuki pair contradiction on the source hexagon

The (3G) short-root interval places the penultimate commutator in the last
root. The exact opposite derived-radical intersection refines this to the
last root's Frattini subgroup. This has exponent two and centralizes the
first input, so the square-commutator identity proves that the penultimate
Frattini subgroup centralizes the simple root.

The natural composition section constructed in SuzukiNaturalPlacement has
its actual kernel in the middle root. Unique five-root coordinates show
that the last two root Frattini subgroups inject jointly into this section.
Both centralize the actual simple root. The concrete natural Suzuki module,
however, has only a single field line fixed by a full Sylow subgroup. Thus
q² ≤ q, a contradiction. This uses the literal natural factor and its
placement to replace the general Hall--Higman invocation in the source.

The existing directional two-layer bound excludes an opposite root of
order four; combining it with the new regular-pair contradiction handles
all Suzuki pairs with at least one positive parameter. The pair of two solvable endpoints, the remaining unitary
rows, and the exhaustive structural assembly are separate obligations.
Source: Fong--Seitz I (3G), pp.14--16, and (6C), printed pp.40--41.
-/

public noncomputable section
set_option backward.isDefEq.respectTransparency false
open Subgroup BenderSuzuki.MatrixGroups
open scoped commutatorElement IsMulCommutative
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
open RootCoordinates ReeSource
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P) (split : SplitData Q.tits)

private theorem frattini_square_one_of_suzuki
    {A : Type*} [Group A] [Finite A] {m : ℕ} (hm : 0 < m)
    (ν : A ≃* SuzukiRootSubgroup m) (x : A) (hx : x ∈ frattini A) : x^2 = 1 := by
  let f := (SchurCover.Family.rootCoordinate m hm).comp ν.toMonoidHom
  have hker : frattini A ≤ f.ker := Theory.GroupTheory.frattini_le_ker_of_square_image f (by
    intro a
    change 2 • (f a).toAdd = 0
    exact (two_nsmul _).trans (CharTwo.add_self_eq_zero _))
  have hc : ν x ∈ center (SuzukiRootSubgroup m) := by
    rw [←SchurCover.Family.root_commutator_eq_center m hm,
      ←SchurCover.Family.rootCoordinate_ker m hm]
    exact hker hx
  have hs := (suzukiRootSubgroup_square_iff_center m hm (ν x)).mpr hc
  apply ν.injective
  simpa only [map_pow,map_one] using hs

/-- The literal penultimate root commutator lies in the last root's
Frattini subgroup, by (3G) and the exact opposite derived intersection. -/
theorem suzuki_penultimate_commutator_le_frattini (hhex : rotationOrder Q = 6)
    (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    {m : ℕ} (hm : 0 < m)
    (μi : rankOne Q split i ≃* SuzukiMatrixGroup m)
    (μj : rankOne Q split j ≃* SuzukiMatrixGroup m)
    (νi : simpleRoot Q split i ≃* SuzukiRootSubgroup m)
    (νj : simpleRoot Q split j ≃* SuzukiRootSubgroup m) :
    ⁅rootAt Q split j (Q.simple i*Q.simple j),simpleRoot Q split j⁆ ≤
      rootFrattiniAt Q split i (Q.simple j) := by
  have hC : ⁅rootAt Q split j (Q.simple i*Q.simple j),simpleRoot Q split j⁆ ≤
      rootAt Q split i (Q.simple j) := by
    rw [commutator_comm]
    exact distance_two_commutator_le Q split hhex j i hij.symm hKj
  have hD : ⁅rootAt Q split j (Q.simple i*Q.simple j),simpleRoot Q split j⁆ ≤
      ⁅simpleRemainder Q split i,simpleRemainder Q split i⁆ :=
    commutator_mono (radicalRoot_le Q split hhex j i hij.symm 2)
      (simpleRoot_le_other_remainder Q split hhex j i hij.symm)
  exact (le_inf hC hD).trans
    (suzuki_nonmiddle_root_inf_derived Q split hhex j i hij.symm hKj hKi hm μj μi νj νi 1 (by decide)).le

/-- The penultimate root Frattini subgroup centralizes the actual simple
root. The commutator has square one and is fixed by the first input, so
squares centralize; the two-group Frattini subgroup is generated by squares. -/
theorem suzuki_penultimate_frattini_centralizes_root (hhex : rotationOrder Q = 6)
    (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    {m : ℕ} (hm : 0 < m)
    (μi : rankOne Q split i ≃* SuzukiMatrixGroup m)
    (μj : rankOne Q split j ≃* SuzukiMatrixGroup m)
    (νi : simpleRoot Q split i ≃* SuzukiRootSubgroup m)
    (νj : simpleRoot Q split j ≃* SuzukiRootSubgroup m) :
    ⁅rootFrattiniAt Q split j (Q.simple i*Q.simple j),simpleRoot Q split j⁆ = ⊥ := by
  let C := rootAt Q split j (Q.simple i*Q.simple j)
  let E := rootAt Q split i (Q.simple j)
  have hCE : ⁅C,E⁆ = ⊥ := by
    have hh := congrArg (fun K : Subgroup (X ⧸ Q.D) =>
      rightConjugate K (representative (Q.simple j) : X ⧸ Q.D))
      (adjacent_commutator_eq_bot Q split hhex i j hij hKi hKj)
    have hh' : ⁅rightConjugate (simpleRoot Q split i) (representative (Q.simple j) : X ⧸ Q.D),
      rightConjugate (rootAt Q split j (Q.simple i)) (representative (Q.simple j) : X ⧸ Q.D)⁆ = ⊥ := by
      simpa only [rightConjugate,comap_equiv_eq_map_symm',map_commutator,Subgroup.map_bot] using hh
    rw [rootAt_right Q split j _ _ _ (representative_spec _),commutator_comm] at hh'
    exact hh'
  have hcomm := suzuki_penultimate_commutator_le_frattini Q split hhex i j hij hKi hKj hm μi μj νi νj
  apply commutator_eq_bot_iff_le_centralizer.mpr
  apply (map_le_iff_le_comap).mpr
  rw [(rootAt_isTwo Q split j (Q.simple i*Q.simple j)).out.frattini_eq_closure_squares]
  apply (closure_le _).mpr
  rintro x ⟨a,rfl⟩
  change (a : X ⧸ Q.D)^2 ∈ centralizer (simpleRoot Q split j : Set (X ⧸ Q.D))
  rw [mem_centralizer_iff]
  intro y hy
  have hc := hcomm (commutator_mem_commutator a.property hy)
  obtain ⟨c,hc,he⟩ := hc
  change (c : X ⧸ Q.D) = ⁅(a : X ⧸ Q.D),y⁆ at he
  have hs : ⁅(a : X ⧸ Q.D),y⁆^2 = 1 := by
    rw [←he]
    exact congrArg Subtype.val (frattini_square_one_of_suzuki hm
      ((RootAction.conjugateEquiv (simpleRoot Q split i) (representative (Q.simple j))).trans νi) c hc)
  have hfix : (a : X ⧸ Q.D)*⁅(a : X ⧸ Q.D),y⁆*(a : X ⧸ Q.D)⁻¹ = ⁅(a : X ⧸ Q.D),y⁆ := by
    have hh := commutator_eq_bot_iff_le_centralizer.mp hCE a.property c c.property
    rw [he] at hh
    rw [←hh,mul_inv_cancel_right]
  have hz : ⁅(a : X ⧸ Q.D)^2,y⁆ = 1 := by
    rw [pow_two,commutatorElement_mul_left_eq_conj_mul,hfix,←pow_two,hs]
  exact (commutatorElement_eq_one_iff_mul_comm.mp hz).symm

open Representation.BinaryOffender
private theorem suzuki_natural_sylow_fixed_card_le {m : ℕ} (hm : 0 < m)
    (S : Sylow 2 (SuzukiMatrixGroup m)) :
    Nat.card (fixedSpace (Representation.SuzukiNatural.natural m) (S : Subgroup _)) ≤ 2^(2*m+1) := by
  let ρ := Representation.SuzukiNatural.natural m
  obtain ⟨T,hT⟩ := suzukiRootSubgroup_isSylow m hm
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq (SuzukiMatrixGroup m) S T
  have hmap : (S : Subgroup (SuzukiMatrixGroup m)).map (MulAut.conj g).toMonoidHom =
      SuzukiRootSubgroup m := (congrArg Sylow.toSubgroup hg).trans hT
  have hc := Nat.card_congr (fixedSpaceConjEquiv ρ (S : Subgroup _) g).toEquiv
  rw [hmap] at hc
  rw [hc]
  let f : fixedSpace ρ (SuzukiRootSubgroup m) → Representation.SuzukiNatural.F m := fun v => v.val 0
  have hf : Function.Injective f := by
    intro x y he
    apply Subtype.ext
    rw [Representation.SuzukiNatural.root_fixed_coordinates m x.val (fun r hr => x.property ⟨r,hr⟩),
      Representation.SuzukiNatural.root_fixed_coordinates m y.val (fun r hr => y.property ⟨r,hr⟩)]
    exact congrArg (fun a => ![a,0,0,0]) he
  have hh := Nat.card_le_card_of_injective f hf
  simpa only [Representation.SuzukiNatural.F,GaloisField.card 2 (2*m+1) (by omega)] using hh

open scoped Pointwise
/-- Two actual root Frattini layers inject into the fixed space of the
natural Suzuki factor. Their independence uses the literal middle-root
kernel and the unique five-root coordinates. The natural root-fixed line
has order q, whereas these two layers have order q². This excludes the
regular Suzuki/Suzuki hexagon on the actual marked quotient. -/
theorem suzuki_regular_pair_excluded (hhex : rotationOrder Q = 6)
    (hcore : Q.tits.B.normalCore = ⊥) (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    {m : ℕ} (hm : 0 < m)
    (μi : rankOne Q split i ≃* SuzukiMatrixGroup m)
    (μj : rankOne Q split j ≃* SuzukiMatrixGroup m)
    (νi : simpleRoot Q split i ≃* SuzukiRootSubgroup m)
    (νj : simpleRoot Q split j ≃* SuzukiRootSubgroup m) : False := by
  obtain ⟨A,hAD,hRA,f,hf,hBC,hprod,heq⟩ :=
    suzuki_derived_natural_placement Q split hhex hcore i j hij hKi hKj hm μi μj νi νj
  let C2 := rootAt Q split i (Q.simple j*Q.simple i)
  let C3 := rootAt Q split j (Q.simple i*Q.simple j)
  let C4 := rootAt Q split i (Q.simple j)
  let F3 := rootFrattiniAt Q split j (Q.simple i*Q.simple j)
  let F4 := rootFrattiniAt Q split i (Q.simple j)
  have h3C : F3 ≤ C3 := map_subtype_le _
  have h4C : F4 ≤ C4 := map_subtype_le _
  have h3A : F3 ≤ A := by
    intro x hx
    change x ∈ (A : Set (X ⧸ Q.D))
    rw [hprod]
    exact ⟨x,⟨x,⟨1,⟨1,one_mem _,1,one_mem _,one_mul _⟩,x,hx,one_mul _⟩,
      1,one_mem _,mul_one _⟩,1,one_mem _,mul_one _⟩
  have h4A : F4 ≤ A := by
    intro x hx
    change x ∈ (A : Set (X ⧸ Q.D))
    rw [hprod]
    exact ⟨x,⟨1,⟨1,⟨1,one_mem _,1,one_mem _,one_mul _⟩,1,one_mem _,one_mul _⟩,
      x,hx,one_mul _⟩,1,one_mem _,mul_one _⟩
  have h3fix : F3 ≤ centralizer (simpleRoot Q split j : Set (X ⧸ Q.D)) :=
    commutator_eq_bot_iff_le_centralizer.mp
      (suzuki_penultimate_frattini_centralizes_root Q split hhex i j hij hKi hKj hm μi μj νi νj)
  have h4fix : F4 ≤ centralizer (simpleRoot Q split j : Set (X ⧸ Q.D)) := by
    have hh := adjacent_commutator_eq_bot Q split hhex j i hij.symm hKj hKi
    rw [commutator_comm] at hh
    exact h4C.trans (commutator_eq_bot_iff_le_centralizer.mp hh)
  obtain ⟨S,hS⟩ := simpleRoot_sylow_of_suzuki Q split j μj νj
  let T := S.mapSurjective (f := μj.toMonoidHom) μj.surjective
  let ρ := Representation.SuzukiNatural.natural m
  let p : F3 × F4 → A := fun x => ⟨x.1*x.2,mul_mem (h3A x.1.property) (h4A x.2.property)⟩
  have hfix (x : F3 × F4) : (f (p x)).toAdd ∈ fixedSpace ρ (T : Subgroup _) := by
    intro t
    obtain ⟨r,hr,her⟩ := t.property
    have hrU : (r : X ⧸ Q.D) ∈ simpleRoot Q split j := by
      have hh : r ∈ (S : Subgroup (rankOne Q split j)) := hr
      rwa [hS] at hh
    have hpr : A.normalizerMonoidHom (inclusion hRA r) (p x) = p x := by
      apply Subtype.ext
      change (r : X ⧸ Q.D)*((x.1 : X ⧸ Q.D)*x.2)*(r : X ⧸ Q.D)⁻¹ = (x.1 : X ⧸ Q.D)*x.2
      have hh := mem_centralizer_iff.mp
        ((centralizer (simpleRoot Q split j : Set (X ⧸ Q.D))).mul_mem
          (h3fix x.1.property) (h4fix x.2.property)) r hrU
      rw [hh,mul_inv_cancel_right]
    change ρ t.val (f (p x)).toAdd = (f (p x)).toAdd
    rw [←her]
    exact (heq r (p x)).symm.trans (congrArg (fun a => (f a).toAdd) hpr)
  let g : F3 × F4 → fixedSpace ρ (T : Subgroup _) := fun x => ⟨(f (p x)).toAdd,hfix x⟩
  have hg : Function.Injective g := by
    intro x y hxy
    have hfxy : f (p x) = f (p y) := Multiplicative.toAdd.injective (congrArg Subtype.val hxy)
    let z := p x / p y
    have hz : z ∈ f.ker := by
      change f (p x / p y) = 1
      rw [map_div,hfxy,div_eq_mul_inv,mul_inv_cancel]
    have hzC : (z : X ⧸ Q.D) ∈ C2 := hBC (mem_map_of_mem A.subtype hz)
    have hcoords :
        ((1 : simpleRoot Q split i),(1 : rootAt Q split j (Q.simple i)),(1 : C2),
          inclusion h3C x.1,inclusion h4C x.2) =
        ((1 : simpleRoot Q split i),(1 : rootAt Q split j (Q.simple i)),
          (⟨z,hzC⟩ : C2),inclusion h3C y.1,inclusion h4C y.2) := by
      apply (radicalCoordinates Q split hhex i j hij).injective
      apply Subtype.ext
      rw [radicalCoordinates_apply,radicalCoordinates_apply]
      change 1*1*1*(x.1 : X ⧸ Q.D)*x.2 = 1*1*(z : X ⧸ Q.D)*y.1*y.2
      dsimp only [z,p]
      change 1*1*1*(x.1 : X ⧸ Q.D)*x.2 =
        1*1*(((x.1 : X ⧸ Q.D)*x.2)/((y.1 : X ⧸ Q.D)*y.2))*y.1*y.2
      simp only [div_eq_mul_inv]
      group
    exact Prod.ext
      (Subtype.ext (congrArg (fun t => (t.2.2.2.1 : X ⧸ Q.D)) hcoords))
      (Subtype.ext (congrArg (fun t => (t.2.2.2.2 : X ⧸ Q.D)) hcoords))
  have hc3 : Nat.card F3 = 2^(2*m+1) := by
    rw [show F3 = (frattini C3).map C3.subtype from rfl,card_map_of_injective C3.subtype_injective]
    exact suzuki_rootAt_frattini_card Q split j hKj hm μj νj _
  have hc4 : Nat.card F4 = 2^(2*m+1) := by
    rw [show F4 = (frattini C4).map C4.subtype from rfl,card_map_of_injective C4.subtype_injective]
    exact suzuki_rootAt_frattini_card Q split i hKi hm μi νi _
  have hbound := (Nat.card_le_card_of_injective g hg).trans (suzuki_natural_sylow_fixed_card_le hm T)
  rw [Nat.card_prod,hc3,hc4] at hbound
  have hq : 1 < 2^(2*m+1) := Nat.one_lt_pow (by omega) (by decide)
  nlinarith

/-- A positive Suzuki endpoint cannot face any Suzuki parameter, including
zero. Parameter equality is proved on the regular branch; the solvable
opposite branch uses its actual root order four. -/
theorem suzuki_pair_excluded_of_pos (hhex : rotationOrder Q = 6)
    (hcore : Q.tits.B.normalCore = ⊥) (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    {m n : ℕ} (hn : 0 < n)
    (μi : rankOne Q split i ≃* SuzukiMatrixGroup m)
    (μj : rankOne Q split j ≃* SuzukiMatrixGroup n)
    (νi : simpleRoot Q split i ≃* SuzukiRootSubgroup m)
    (νj : simpleRoot Q split j ≃* SuzukiRootSubgroup n) : False := by
  by_cases hm : m = 0
  · subst m
    apply no_regular_suzuki_opposite_four Q split hhex i j hij hKj hn μj νj
    rw [Nat.card_congr νi.toEquiv,matrixRoot_card]
    norm_num
  · have hm : 0 < m := Nat.pos_of_ne_zero hm
    have he := suzuki_suzuki_parameters_eq Q split hhex i j hij hKi hKj hm hn μi μj νi νj
    subst m
    exact suzuki_regular_pair_excluded Q split hhex hcore i j hij hKi hKj hn μi μj νi νj

