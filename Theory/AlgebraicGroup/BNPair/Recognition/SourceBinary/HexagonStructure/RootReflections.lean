module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.RootCoordinates.Recurrence

/-!
# The canonical root-generated rank-one subgroups

Conjugates of the two canonical simple roots depend only on their Weyl
classes, including for arbitrary lifts in the full normalizer N. Reduced
word lengths place these conjugates in the literal unipotent intersections
and separate distinct roots. The subgroup R_i is generated by U_i and
its opposite U_i^{s_i}; no original local factor is identified with R_i.

`RootReflection` records the earlier source choice of a lift of s_i inside
R_i. This is a group-membership premise from Fong--Seitz I, Section 5,
printed p.26, following (5C), not a conclusion about the hexagon branch.
The nonabelian-radical argument uses precisely this choice.

Source: Fong--Seitz, Groups with a (B,N)-pair of rank 2, I (1973),
Sections 3 and 5; Carter 2.5.7--2.5.10 for the reduced-root intersections.
All conjugations are on the right: A^n = n^{-1} A n.
-/

public noncomputable section
open Subgroup
open scoped Pointwise
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
open RootCoordinates
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
variable (Q : MarkedQuotient P) (split : SplitData Q.tits)

@[expose] def rootAt (i : Fin 2) (w : Weyl Q) : Subgroup (X ⧸ Q.D) :=
  rightConjugate (simpleRoot Q split i) (representative w : X ⧸ Q.D)

/-- The entire original Cartan normalizes each conjugated simple root. -/
theorem rootAt_torus_normalizes (i : Fin 2) (w : Weyl Q) :
    Q.tits.B ⊓ Q.tits.N ≤ normalizer (rootAt Q split i w : Set (X ⧸ Q.D)) :=
  torus_normalizes_rightConjugate _ (torus_normalizes_simpleRoot Q split i)
    (representative w)

theorem rootAt_eq (i : Fin 2) (w : Weyl Q) (n : Q.tits.N)
    (hn : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) n = w) :
    rootAt Q split i w = rightConjugate (simpleRoot Q split i) (n : X ⧸ Q.D) :=
  rightConjugate_eq_of_quotient_eq _ (torus_normalizes_simpleRoot Q split i)
    (representative w) n ((representative_spec w).trans hn.symm)

@[simp] theorem rootAt_one (i : Fin 2) : rootAt Q split i 1 = simpleRoot Q split i := by
  rw [rootAt_eq Q split i 1 1 (map_one _)]
  exact rightConjugate_one _

theorem rootAt_right (i : Fin 2) (v w : Weyl Q) (n : Q.tits.N)
    (hn : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) n = w) :
    rightConjugate (rootAt Q split i v) (n : X ⧸ Q.D) = rootAt Q split i (v*w) := by
  rw [rootAt, ← rightConjugate_mul, rootAt_eq Q split i (v*w) (representative v*n)
    (by rw [map_mul, representative_spec, hn])]
  rfl

theorem rootAt_le_conjugate (i : Fin 2) (v w : Weyl Q)
    (hlen : Q.tits.wordLength ((w*v⁻¹)*Q.simple i) = Q.tits.wordLength (w*v⁻¹)+1) :
    rootAt Q split i v ≤ unipotentConjugate split w := by
  have h := (simpleRoot_le_ascent_intersection Q split (w*v⁻¹) i hlen).trans inf_le_right
  have hc := comap_mono (f := (MulAut.conj (representative v : X ⧸ Q.D)).toMonoidHom) h
  change rootAt Q split i v ≤ rightConjugate (unipotentConjugate split (w*v⁻¹))
    (representative v : X ⧸ Q.D) at hc
  rwa [unipotentConjugate_right split _ _ (representative v) (representative_spec _),
    inv_mul_cancel_right] at hc

theorem rootAt_le_remainder (i j : Fin 2) (v : Weyl Q)
    (hU : Q.tits.wordLength (v⁻¹*Q.simple i) = Q.tits.wordLength v⁻¹+1)
    (hV : Q.tits.wordLength ((Q.simple j*v⁻¹)*Q.simple i) =
      Q.tits.wordLength (Q.simple j*v⁻¹)+1) :
    rootAt Q split i v ≤ simpleRemainder Q split j := by
  apply le_inf
  · have h := rootAt_le_conjugate Q split i v 1 (by simpa only [one_mul] using hU)
    rwa [unipotentConjugate_one] at h
  · exact rootAt_le_conjugate Q split i v (Q.simple j) hV

theorem simpleRoot_disjoint_simpleConjugate (i : Fin 2) :
    Disjoint (simpleRoot Q split i) (unipotentConjugate split (Q.simple i)) := by
  apply disjoint_iff.mpr
  apply eq_bot_iff.mpr
  intro x hx
  exact (disjoint_iff.mp (simpleRoot_disjoint_remainder Q split i)).le
    ⟨hx.1, (simpleRoot_le Q split i hx.1), hx.2⟩

theorem rootAt_disjoint (i : Fin 2) (v w : Weyl Q)
    (hlen : Q.tits.wordLength ((Q.simple i*(w*v⁻¹)⁻¹)*Q.simple i) =
      Q.tits.wordLength (Q.simple i*(w*v⁻¹)⁻¹)+1) :
    Disjoint (rootAt Q split i v) (rootAt Q split i w) := by
  apply disjoint_iff.mpr
  apply eq_bot_iff.mpr
  intro x hx
  let n := representative v
  have hn : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) n⁻¹ = v⁻¹ := by
    rw [map_inv, representative_spec]
  have hxw : (n : X ⧸ Q.D)*x*(n : X ⧸ Q.D)⁻¹ ∈ rootAt Q split i (w*v⁻¹) := by
    rw [← rootAt_right Q split i w v⁻¹ n⁻¹ hn]
    change (n : X ⧸ Q.D)⁻¹*((n : X ⧸ Q.D)*x*(n : X ⧸ Q.D)⁻¹)*
      ((n : X ⧸ Q.D)⁻¹)⁻¹ ∈ rootAt Q split i w
    simpa only [inv_inv, mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using
      (show x ∈ rootAt Q split i w from hx.2)
  have hz : (n : X ⧸ Q.D)*x*(n : X ⧸ Q.D)⁻¹ = 1 := by
    apply mem_bot.mp
    rw [← disjoint_iff.mp (simpleRoot_disjoint_simpleConjugate Q split i)]
    exact ⟨hx.1, rootAt_le_conjugate Q split i (w*v⁻¹) (Q.simple i) hlen hxw⟩
  apply mem_bot.mpr
  apply (MulAut.conj (n : X ⧸ Q.D)).injective
  simpa only [MulAut.conj_apply, map_one] using hz

theorem rootAt_ne_bot (i : Fin 2) (w : Weyl Q) : rootAt Q split i w ≠ ⊥ := by
  intro hz
  apply simpleRoot_ne_bot Q split i
  apply eq_bot_iff.mpr
  intro x hx
  let n := representative w
  have hm : (n : X ⧸ Q.D)⁻¹*x*(n : X ⧸ Q.D) ∈ rootAt Q split i w := by
    change (n : X ⧸ Q.D)*((n : X ⧸ Q.D)⁻¹*x*(n : X ⧸ Q.D))*(n : X ⧸ Q.D)⁻¹ ∈
      simpleRoot Q split i
    simpa only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one] using hx
  rw [hz, mem_bot] at hm
  apply mem_bot.mpr
  apply (MulAut.conj (n : X ⧸ Q.D)⁻¹).injective
  simpa only [MulAut.conj_apply, inv_inv, map_one] using hm

@[expose] def rankOne (i : Fin 2) : Subgroup (X ⧸ Q.D) :=
  simpleRoot Q split i ⊔ rootAt Q split i (Q.simple i)

/-- The same full Cartan normalizes the root-generated R_i. -/
theorem rankOne_torus_normalizes (i : Fin 2) :
    Q.tits.B ⊓ Q.tits.N ≤ normalizer (rankOne Q split i : Set (X ⧸ Q.D)) :=
  (le_inf (torus_normalizes_simpleRoot Q split i)
    (rootAt_torus_normalizes Q split i (Q.simple i))).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)

theorem rankOne_eq (i : Fin 2) (n : Q.tits.N)
    (hn : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) n = Q.simple i) :
    rankOne Q split i = simpleRoot Q split i ⊔
      rightConjugate (simpleRoot Q split i) (n : X ⧸ Q.D) := by
  rw [rankOne, rootAt_eq Q split i (Q.simple i) n hn]

/-- R_i lies in its actual marked endpoint; it is not defined as that endpoint. -/
theorem rankOne_le_parabolic (i : Fin 2) :
    rankOne Q split i ≤ Q.tits.standardParabolic {Q.simple i} := by
  let n := representative (Q.simple i)
  have hn : (n : X ⧸ Q.D) ∈ Q.tits.standardParabolic {Q.simple i} :=
    Q.tits.bruhatCell_subset_standardParabolic_of_mem (Set.mem_singleton _)
      (Q.tits.representative_mem_bruhatCell _ n (representative_spec _))
  have hU := (simpleRoot_le Q split i).trans
    (split.U_le.trans (Q.tits.B_le_standardParabolic {Q.simple i}))
  apply sup_le hU
  intro x hx
  have h := (Q.tits.standardParabolic {Q.simple i}).mul_mem
    ((Q.tits.standardParabolic {Q.simple i}).mul_mem
      ((Q.tits.standardParabolic {Q.simple i}).inv_mem hn) (hU hx)) hn
  change (n : X ⧸ Q.D)⁻¹*((n : X ⧸ Q.D)*x*(n : X ⧸ Q.D)⁻¹)*(n : X ⧸ Q.D) ∈
    Q.tits.standardParabolic {Q.simple i} at h
  simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using h

structure RootReflection (i : Fin 2) where
  val : Q.tits.N
  class_eq : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) val = Q.simple i
  mem_rankOne : (val : X ⧸ Q.D) ∈ rankOne Q split i

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
