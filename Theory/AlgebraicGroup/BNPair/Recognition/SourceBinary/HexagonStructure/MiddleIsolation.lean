module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.HexagonStructure.MiddleFixed
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.NumberTheory.BinaryPrimitiveDivisor.Separation

/-!
# Odd-Cartan isolation of the derived subgroup in an unequal linear hexagon

Write V=U_sj, D=[V,V], M for its three middle roots, and C for the middle
smaller root. The preceding results give 1<D<M. A separating odd Cartan
actor has C_M(t)=C. If C meets D trivially, the linear degree bound forces
|D| at least q_j²; unique middle coordinates then give M=D C. The actor
would fix the actual V/D, contradicting the proved faithful radical action.
Thus C lies in D.

The first larger middle root cannot lie in D: reflection by s_j would put
the third one there too, giving D=M. Cartan irreducibility therefore makes
its intersection with D trivial. Counting their product gives
|D| ≤ q_i q_j < q_j². The small-section theorem now centralizes D under
R_j, so D lies in C_M(t)=C, proving equality. The four vanishing mixed
commutators follow from the previous centrality theorem with its derived
premise discharged.

All subgroups and actions are on the same finite marked quotient. The
proof uses actual local models and kernel inclusions, with no ambient
perfectness or simplicity assumption. Both nonzero commutator identities,
irreducibility, the cubic ratio, and nonlinear exclusions remain unproved.
The binary opposite root, acting field four, and exponent six are included.

Source: Fong--Seitz I (6E), printed pp.43--45, especially the torus argument
on p.44. The original/geometric and triality applications are in CFSG.
-/

public noncomputable section
open Subgroup
open scoped Pointwise MatrixGroups
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
open RootCoordinates GTwoSource
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P) (split : SplitData Q.tits)

/-- If the three middle roots were generated by the derived subgroup and
the fixed middle root, the actor would fix the actual radical abelianization. -/
private theorem radicalQuotient_fixed_of_middle_sup
    (hm : rotationOrder Q = 6) (i j : Fin 2) (hij : i ≠ j)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    (t : rankOne Q split j)
    (hfix : ∀ w, (t : X ⧸ Q.D) ∈ centralizer (rootAt Q split i w : Set (X ⧸ Q.D)))
    (hM : middleRoots Q split i j ≤
      ⁅simpleRemainder Q split j,simpleRemainder Q split j⁆ ⊔
        rootAt Q split i (Q.simple j*Q.simple i)) :
    radicalQuotientAction Q split j hKj t = 1 := by
  let V := simpleRemainder Q split j
  let q : V →* RadicalQuotient Q split j := Abelianization.of
  let f := radicalQuotientAction Q split j hKj t
  let K := (f.toMonoidHom.comp q).eqLocus q
  let Z := K.map V.subtype
  have hD : ⁅V,V⁆ ≤ Z := by
    intro d hd
    have hd' : d ∈ q.ker.map V.subtype := (radicalProjection_kernel Q split j).symm ▸ hd
    obtain ⟨v,hv,rfl⟩ := hd'
    refine mem_map_of_mem V.subtype ?_
    change f (q v) = q v
    change q v = 1 at hv
    rw [hv,map_one]
  have hroot (w : Weyl Q) (hV : rootAt Q split i w ≤ V) : rootAt Q split i w ≤ Z := by
    intro u hu
    let v : V := ⟨u,hV hu⟩
    have he : radicalAction Q split j hKj t v = v := by
      apply Subtype.ext
      rw [radicalAction_apply]
      change (t : X ⧸ Q.D)*u*(t : X ⧸ Q.D)⁻¹ = u
      exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_iff.mp (hfix w) u hu).symm
    refine ⟨v,?_,rfl⟩
    change radicalQuotientAction Q split j hKj t (Abelianization.of v) = Abelianization.of v
    rw [radicalQuotientAction_of,he]
  have hA : simpleRoot Q split i ≤ Z := by
    simpa only [rootAt_one] using hroot 1
      (by simpa only [rootAt_one] using simpleRoot_le_other_remainder Q split hm i j hij)
  have hC := hroot (Q.simple j*Q.simple i) (exchanged_roots_le_remainder Q split hm i j hij).2
  have hE := hroot (Q.simple j) (exchanged_roots_le_remainder Q split hm i j hij).1
  have hMZ : middleRoots Q split i j ≤ Z := hM.trans (sup_le hD hC)
  have hVZ : V ≤ Z := by
    intro v hv
    have hv' : v ∈ (simpleRemainder Q split j : Set (X ⧸ Q.D)) := hv
    rw [radical_five_product Q split hm i j hij] at hv'
    obtain ⟨abcd,⟨abc,⟨ab,⟨a,ha,b,hb,rfl⟩,c,hc,rfl⟩,d,hd,rfl⟩,e,he,rfl⟩ := hv'
    exact Z.mul_mem (Z.mul_mem (Z.mul_mem (Z.mul_mem (hA ha)
      (hMZ (mem_sup_left (mem_sup_left hb)))) (hC hc))
      (hMZ (mem_sup_right hd))) (hE he)
  apply MulEquiv.ext
  intro v
  induction v using QuotientGroup.induction_on with
  | H v =>
    obtain ⟨u,hu,he⟩ := hVZ v.property
    have huv : u = v := Subtype.ext he
    subst u
    exact hu

variable {F E : Type*} [Field F] [Finite F] [CharP F 2]
  [Field E] [Finite E] [CharP E 2]

/-- Odd-Cartan isolation of the literal middle root, including q=2 opposite
roots, acting q=4, and the binary primitive-divisor exponent-six exception. -/
theorem unequal_linear_derived_eq_middle_root
    (hm : rotationOrder Q = 6) (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    (μi : localGroup Q split i ≃* PSL(2,E))
    (μj : localGroup Q split j ≃* PSL(2,F))
    (si : RootReflection Q split i) (sj : RootReflection Q split j)
    {a b : ℕ} (ha : 0 < a) (hab : a < b)
    (hE : Nat.card E = 2^a) (hF : Nat.card F = 2^b) :
    ⁅simpleRemainder Q split j,simpleRemainder Q split j⁆ =
      rootAt Q split i (Q.simple j*Q.simple i) := by
  let V := simpleRemainder Q split j
  let D := ⁅V,V⁆
  let M := middleRoots Q split i j
  let C := rootAt Q split i (Q.simple j*Q.simple i)
  let B := rootAt Q split j (Q.simple i)
  have hMV : M ≤ V := middleRoots_le_remainder Q split hm i j hij
  have hCM : C ≤ M := le_sup_right.trans le_sup_left
  have hBM : B ≤ M := le_sup_left.trans le_sup_left
  have hDV : D ≤ V := commutator_le_self V
  have hPN := radical_commutator_normalized Q split j hKj
  have hRN : rankOne Q split j ≤ normalizer (D : Set (X ⧸ Q.D)) :=
    (rankOne_le_parabolic Q split j).trans hPN
  have hVN : V ≤ normalizer (D : Set (X ⧸ Q.D)) :=
    (inf_le_left.trans (split.U_le.trans (Q.tits.B_le_standardParabolic _))).trans hPN
  have hHN : Q.tits.B ⊓ Q.tits.N ≤ normalizer (D : Set (X ⧸ Q.D)) :=
    inf_le_left.trans ((Q.tits.B_le_standardParabolic _).trans hPN)
  obtain ⟨_,hDne,hDlt⟩ := unequal_linear_middle_structure Q split j hKj μj sj hm i hij
    hKi μi si ha hab hE hF
  change ⊥ < D at hDne
  change D < M at hDlt
  obtain ⟨r,hr,hrF,hrE⟩ := Theory.NumberTheory.exists_binary_separating_prime ha hab
  obtain ⟨t,ht,hto,hfix,hsi,hsj,hBfree,hDfree⟩ := exists_prime_cartan_separation Q split
    i j hKi hKj μi μj si sj hr (by rwa [hF]) (by rwa [hE])
  have htne : t ≠ 1 := by
    intro he
    rw [he,orderOf_one] at hto
    exact hr.ne_one hto.symm
  have hMC : M ⊓ centralizer ({t} : Set (X ⧸ Q.D)) = C :=
    middleRoots_fixed_eq Q split hm i j hij ht.1 (hfix _) hBfree hDfree
  have hsmall (hd : Nat.card D < 2^(2*b)) : D ≤ C := by
    have hz := linear_small_subgroup_centralized Q split j hKj μj sj D hDV hRN
      (by omega : 1 < b) hF hd
    intro d hdD
    rw [← hMC]
    exact ⟨hDlt.le hdD,mem_centralizer_singleton_iff.mpr
      (mem_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hz ht.2) d hdD)⟩
  have hcardM : Nat.card M = 2^a * (2^b)^2 := by
    rw [middleRoots_card Q split hm i j hij,
      simpleRoot_card Q split i hKi μi,simpleRoot_card Q split j hKj μj,hE,hF]
  have hcardC : Nat.card C = 2^a := by
    simp only [C,rootAt,card_rightConjugate,simpleRoot_card Q split i hKi μi,hE]
  have hcardB : Nat.card B = 2^b := by
    simp only [B,rootAt,card_rightConjugate,simpleRoot_card Q split j hKj μj,hF]
  have hCpos : 0 < 2^a := Nat.pow_pos (by decide)
  have hBpos : 0 < 2^b := Nat.pow_pos (by decide)
  have hpow : 2^(2*b) = (2^b)^2 := by rw [← pow_mul,Nat.mul_comm]
  have hCD : C ≤ D := by
    rcases middle_root_derived_dichotomy Q split j i hKi μi hKj with h | hd
    · exact h
    · have hlarge : (2^b)^2 ≤ Nat.card D := by
        by_contra! hl
        have hDC := hsmall (by rwa [hpow])
        have hz : D = ⊥ := disjoint_self.mp (hd.mono hDC le_rfl)
        exact (ne_of_gt hDne) hz
      have hDCM : D ⊔ C ≤ M := sup_le hDlt.le hCM
      have hcount := card_sup_eq_mul_of_normalizes_of_disjoint D C (hCM.trans (hMV.trans hVN)) hd.symm
      have heq : D ⊔ C = M := by
        apply eq_of_le_of_card_ge hDCM
        rw [hcount,hcardC,hcardM]
        nlinarith
      have hact := radicalQuotient_fixed_of_middle_sup Q split hm i j hij hKj
        ⟨t,ht.2⟩ hfix (by rw [heq])
      have ht1 := linear_radicalQuotientAction_injective Q split j hKj μj sj hm i hij hKi
        (hact.trans (map_one _).symm)
      exact (htne (congrArg Subtype.val ht1)).elim
  have hBD : Disjoint B D := by
    by_contra hn
    have hi : B ⊓ D ≠ ⊥ := fun he => hn (disjoint_iff.mpr he)
    have hH := (le_inf (rootAt_torus_normalizes Q split j (Q.simple i)) hHN).trans
      inf_normalizer_le_normalizer_inf
    have he := QuadrangleStructure.rootAt_eq_of_torus_invariant Q split j μj hKj
      (Q.simple i) (B ⊓ D) inf_le_left hi hH
    have hB : B ≤ D := he.symm.le.trans inf_le_right
    have hThird : rootAt Q split j (Q.simple i*Q.simple j) ≤ D := by
      have hh := comap_mono (f := (MulAut.conj (sj.val : X ⧸ Q.D)).toMonoidHom) hB
      change rightConjugate B (sj.val : X ⧸ Q.D) ≤ rightConjugate D (sj.val : X ⧸ Q.D) at hh
      rw [rootAt_right Q split j _ _ sj.val sj.class_eq,
        rightConjugate_eq_self D (hRN sj.mem_rankOne)] at hh
      exact hh
    have hMD : M ≤ D := sup_le (sup_le hB hCD) hThird
    exact (not_le_of_gt hDlt) hMD
  have hcount := card_sup_eq_mul_of_normalizes_of_disjoint D B
    (hBM.trans (hMV.trans hVN)) hBD.symm
  have hbound := card_le_of_le (sup_le hDlt.le hBM : D ⊔ B ≤ M)
  rw [hcount,hcardB,hcardM] at hbound
  have hDcard : Nat.card D ≤ 2^a*2^b := by nlinarith
  have hlt : 2^a < 2^b := Nat.pow_lt_pow_right (by decide) hab
  exact le_antisymm (hsmall (by rw [hpow]; nlinarith)) hCD

/-- All four vanishing identities in the unequal branch now follow without
assuming the derived-subgroup identity. Both nonzero identities remain separate. -/
theorem unequal_linear_zero_relations
    (hm : rotationOrder Q = 6) (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    (μi : localGroup Q split i ≃* PSL(2,E))
    (μj : localGroup Q split j ≃* PSL(2,F))
    (si : RootReflection Q split i) (sj : RootReflection Q split j)
    {a b : ℕ} (ha : 0 < a) (hab : a < b)
    (hE : Nat.card E = 2^a) (hF : Nat.card F = 2^b) :
    ⁅simpleRoot Q split i,rootAt Q split i (Q.simple j*Q.simple i)⁆ = ⊥ ∧
    ⁅rootAt Q split i (Q.simple j*Q.simple i),rootAt Q split i (Q.simple j)⁆ = ⊥ ∧
    ⁅simpleRoot Q split i,rootAt Q split j (Q.simple i*Q.simple j)⁆ = ⊥ ∧
    ⁅rootAt Q split j (Q.simple i),rootAt Q split i (Q.simple j)⁆ = ⊥ := by
  apply derived_middle_root_zero_relations Q split j hKj μj sj hm i hij hKi μi
    (unequal_linear_derived_eq_middle_root Q split hm i j hij hKi hKj μi μj si sj ha hab hE hF)
    (by omega) hF
  rw [simpleRoot_card Q split i hKi μi,hE]
  exact Nat.pow_lt_pow_right (by decide) (by omega)

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
