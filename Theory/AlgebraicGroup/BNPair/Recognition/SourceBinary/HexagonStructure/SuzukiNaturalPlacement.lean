module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.HexagonStructure.RankOneCentralizer
public import Theory.GroupTheory.CoprimeCentralizerDecomposition

/-!
# Natural Suzuki section and its literal middle-root kernel

The natural composition section of the actual derived-radical Frattini
quotient is pulled back to a subgroup of the same derived radical. Its kernel
has order at most q²; the rank-one group centralizes it, so the five-root
coordinate argument places it in the middle root. The quotient of the derived
radical by the numerator also has order at most q², and its actual rank-one
section is centralized by the small-section bound.

A coprime-action argument puts each nonmiddle root Frattini subgroup inside
the numerator. Unique five-root coordinates and the natural quotient order
then prove the exact ordered source product: the four nonmiddle Frattini
subgroups followed by this kernel. The order-four triple-commutator
contradiction remains the next source step.

Source: Fong--Seitz I (6C), printed p.41. Small-field and unitary exclusions,
and exhaustive assembly of (6E), remain outside these Suzuki steps.
-/

public noncomputable section
set_option backward.isDefEq.respectTransparency false
open scoped IsMulCommutative commutatorElement
open Subgroup BenderSuzuki.MatrixGroups
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
open RootCoordinates ReeSource
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P) (split : SplitData Q.tits)

/-- Each nonmiddle root Frattini subgroup is generated by its commutators
with the actual rank-one Cartan, and thus lies in the moved derived radical. -/
theorem suzuki_nonmiddle_frattini_le_rankOne_commutator (hhex : rotationOrder Q = 6)
    (hcore : Q.tits.B.normalCore = ⊥) (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    {m : ℕ} (hm : 0 < m)
    (μi : rankOne Q split i ≃* SuzukiMatrixGroup m)
    (μj : rankOne Q split j ≃* SuzukiMatrixGroup m)
    (νi : simpleRoot Q split i ≃* SuzukiRootSubgroup m)
    (νj : simpleRoot Q split j ≃* SuzukiRootSubgroup m)
    (t : Fin 5) (ht : t ≠ 2) :
    rootFrattiniAt Q split (radicalRootKind i j t) (radicalRootWord Q i j t) ≤
      ⁅rankOne Q split j,⁅simpleRemainder Q split j,simpleRemainder Q split j⁆⁆ := by
  let C := rootAt Q split (radicalRootKind i j t) (radicalRootWord Q i j t)
  let F := rootFrattiniAt Q split (radicalRootKind i j t) (radicalRootWord Q i j t)
  let H := (Q.tits.B ⊓ Q.tits.N : Subgroup (X ⧸ Q.D))
  let T := H ⊓ rankOne Q split j
  have hFC : F ≤ C := map_subtype_le _
  have hTF : T ≤ normalizer (F : Set (X ⧸ Q.D)) :=
    (inf_le_left.trans (rootAt_torus_normalizes Q split _ _)).trans
      (normalizer_le_normalizer_characteristic_image C (frattini C))
  have hF2 : IsPGroup 2 F := (rootAt_isTwo Q split _ _).out.of_injective
    (inclusion hFC) (inclusion_injective _)
  let : Group.IsNilpotent F := hF2.isNilpotent
  have hcop : Nat.Coprime (Nat.card T) (Nat.card F) := by
    obtain ⟨a,ha⟩ := (IsPGroup.iff_card (p := 2)).mp hF2
    rw [ha]
    exact (split.odd.symm.of_dvd_left (card_dvd_of_le (show T ≤ H from inf_le_left))).pow_right a
  have hfix : F ⊓ centralizer (T : Set (X ⧸ Q.D)) = ⊥ := by
    apply bot_unique
    exact (inf_le_inf_right _ hFC).trans
      (suzuki_nonmiddle_rankOne_cartan_fixedFree Q split hhex hcore i j hij hKi hKj hm μi μj νi νj t ht).le
  have hd := eq_commutator_sup_centralizer_of_solvable_coprime F T hTF inferInstance hcop
  rw [hfix,sup_bot_eq] at hd
  calc
    F = ⁅T,F⁆ := hd.trans (commutator_comm _ _)
    _ ≤ ⁅rankOne Q split j,⁅simpleRemainder Q split j,simpleRemainder Q split j⁆⁆ :=
      commutator_mono inf_le_right
        (suzuki_radical_root_frattini_le_derived Q split hhex i j hij hm hm νi νj t)


private def invariantSection (j : Fin 2) (A B : Subgroup (X ⧸ Q.D))
    (hAV : A ≤ simpleRemainder Q split j)
    (hRA : rankOne Q split j ≤ normalizer (A : Set (X ⧸ Q.D)))
    (hAB : A ≤ normalizer (B : Set (X ⧸ Q.D)))
    (hRB : rankOne Q split j ≤ normalizer (B : Set (X ⧸ Q.D))) : RootSection Q split j where
  numerator := A
  le_radical := hAV
  normalized := hRA
  denominator := B.subgroupOf A
  normal := normal_subgroupOf_of_le_normalizer hAB
  invariant r := by
    apply le_antisymm
    · rintro x ⟨y,hy,rfl⟩
      exact (mem_normalizer_iff.mp (hRB r.property) _).mp hy
    · intro x hx
      refine ⟨A.normalizerMonoidHom ⟨(r⁻¹ : rankOne Q split j),hRA (inv_mem r.property)⟩ x,?_,?_⟩
      · exact (mem_normalizer_iff.mp (hRB (inv_mem r.property)) _).mp hx
      · change (A.normalizerMonoidHom.comp (inclusion hRA)) r
          ((A.normalizerMonoidHom.comp (inclusion hRA)) r⁻¹ x) = x
        rw [map_inv]
        exact MulEquiv.apply_symm_apply _ x

private theorem small_section_action (j : Fin 2) {m : ℕ} (hm : 0 < m)
    (μ : rankOne Q split j ≃* SuzukiMatrixGroup m)
    (d : RootSection Q split j) (hc : Nat.card d.Carrier < 2^(4*(2*m+1))) : d.action = 1 := by
  by_contra hn
  have hh := suzuki_section_card_bound Q split j hm μ d hn
  have hle : Nat.card d.EffectiveCarrier ≤ Nat.card d.Carrier :=
    index_antitone (show d.denominator ≤ d.effectiveDenominator from by
      rw [d.effectiveDenominator_eq]; exact le_sup_right)
  exact (not_lt_of_ge (hh.trans hle)) hc

private theorem section_commutator_le {j : Fin 2} (d : RootSection Q split j)
    (hd : d.action = 1) : ⁅rankOne Q split j,d.numerator⁆ ≤ d.denominator.map d.numerator.subtype := by
  apply commutator_le.mpr
  intro r hr x hx
  let r' : rankOne Q split j := ⟨r,hr⟩
  let x' : d.numerator := ⟨x,hx⟩
  have he : d.action r' (QuotientGroup.mk x') = QuotientGroup.mk x' := by rw [hd]; rfl
  rw [d.action_mk] at he
  have hmem := QuotientGroup.eq_iff_div_mem.mp he
  refine ⟨d.numeratorAction r' x' / x',hmem,?_⟩
  change (r*x*r⁻¹)/x = ⁅r,x⁆
  simp only [commutatorElement_def,div_eq_mul_inv]


/-- The natural constituent is realized by an equivariant surjection from
an actual subgroup of the derived radical. Both subgroups are normalized
by the literal rank-one actor. -/
theorem suzuki_derived_natural_lift (hhex : rotationOrder Q = 6)
    (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    {m : ℕ} (hm : 0 < m)
    (μi : rankOne Q split i ≃* SuzukiMatrixGroup m)
    (μj : rankOne Q split j ≃* SuzukiMatrixGroup m)
    (νi : simpleRoot Q split i ≃* SuzukiRootSubgroup m)
    (νj : simpleRoot Q split j ≃* SuzukiRootSubgroup m) :
    ∃ (A : Subgroup (X ⧸ Q.D)),
      A ≤ ⁅simpleRemainder Q split j,simpleRemainder Q split j⁆ ∧
      (⁅simpleRemainder Q split j,simpleRemainder Q split j⁆ : Subgroup (X ⧸ Q.D)) ≤ normalizer (A : Set (X ⧸ Q.D)) ∧
      ∃ (hRA : rankOne Q split j ≤ normalizer (A : Set (X ⧸ Q.D)))
        (f : A →* Multiplicative (Representation.SuzukiNatural.W m)),
        Function.Surjective f ∧
        ∀ (r : rankOne Q split j) (a : A),
          (f (A.normalizerMonoidHom (inclusion hRA r) a)).toAdd =
            Representation.SuzukiNatural.natural m (μj r) (f a).toAdd := by
  let d := frattiniSection Q split j (radicalSection Q split j hKj)
  have hD := suzuki_frattiniSection_numerator_eq_derived Q split hhex i j hij hKj hm hm νi νj
  let ρ := d.effectiveRepresentation.comp μj.symm.toMonoidHom
  obtain ⟨U,N,_,⟨e⟩,_⟩ := suzuki_derived_radical_natural_section Q split hhex i j hij hKi hKj hm μi μj νi νj
  let π := QuotientGroup.mk' d.effectiveDenominator
  let T : Subgroup d.EffectiveCarrier := U.toSubmodule.toAddSubgroup.toSubgroup'
  let A₀ := T.comap π
  let A := A₀.map d.numerator.subtype
  have hAd : A ≤ d.numerator := map_subtype_le _
  let α : A ≃* A₀ := (A₀.equivMapOfInjective d.numerator.subtype d.numerator.subtype_injective).symm
  have hα (a : A) : ((α a).val : X ⧸ Q.D) = a := by
    exact congrArg Subtype.val ((A₀.equivMapOfInjective d.numerator.subtype d.numerator.subtype_injective).apply_symm_apply a)
  let q : A →* Multiplicative U.toSubmodule := {
    toFun a := Multiplicative.ofAdd ⟨Additive.ofMul (π (α a).val),(α a).property⟩
    map_one' := by apply Multiplicative.toAdd.injective; apply Subtype.ext; simp only [map_one]; rfl
    map_mul' a b := by apply Multiplicative.toAdd.injective; apply Subtype.ext; simp only [map_mul]; rfl }
  have hq : Function.Surjective q := by
    intro u
    obtain ⟨x,hx⟩ := QuotientGroup.mk'_surjective d.effectiveDenominator u.toAdd.val.toMul
    have hxt : x ∈ A₀ := by change Additive.ofMul (π x) ∈ U; rw [hx]; exact u.toAdd.property
    refine ⟨α.symm ⟨x,hxt⟩,?_⟩
    apply Multiplicative.toAdd.injective
    apply Subtype.ext
    change Additive.ofMul (π (α (α.symm ⟨x,hxt⟩)).val) = u.toAdd.val
    rw [α.apply_symm_apply,hx]
    rfl
  have hRA : rankOne Q split j ≤ normalizer (A : Set (X ⧸ Q.D)) := by
    apply le_normalizer_iff.mpr
    rintro r hr x ⟨a,ha,rfl⟩
    refine ⟨d.numeratorAction ⟨r,hr⟩ a,?_,rfl⟩
    have hh := U.apply_mem_toSubmodule (μj ⟨r,hr⟩) ha
    change d.effectiveRepresentation (μj.symm (μj ⟨r,hr⟩)) (Additive.ofMul (π a)) ∈ U at hh
    rw [μj.symm_apply_apply] at hh
    change d.effectiveRepresentation ⟨r,hr⟩ (Additive.ofMul (QuotientGroup.mk a)) ∈ U at hh
    rw [d.effectiveRepresentation_mk] at hh
    exact hh
  have hDA : d.numerator ≤ normalizer (A : Set (X ⧸ Q.D)) := by
    apply le_normalizer_iff.mpr
    rintro x hx y ⟨a,ha,rfl⟩
    let x' : d.numerator := ⟨x,hx⟩
    refine ⟨x'*a*x'⁻¹,?_,rfl⟩
    change π (x'*a*x'⁻¹) ∈ T
    rw [map_mul,map_mul,map_inv,mul_comm (π x') (π a),mul_inv_cancel_right]
    exact ha
  have hqe (r : rankOne Q split j) (a : A) :
      (q (A.normalizerMonoidHom (inclusion hRA r) a)).toAdd = U.toRepresentation (μj r) (q a).toAdd := by
    apply Subtype.ext
    have hαr : (α (A.normalizerMonoidHom (inclusion hRA r) a)).val = d.numeratorAction r (α a).val := by
      apply Subtype.ext
      rw [hα,d.numeratorAction_apply,hα]
      rfl
    change Additive.ofMul (π (α (A.normalizerMonoidHom (inclusion hRA r) a)).val) =
      d.effectiveRepresentation (μj.symm (μj r)) (Additive.ofMul (π (α a).val))
    rw [hαr,μj.symm_apply_apply]
    exact (d.effectiveRepresentation_mk r (α a).val).symm
  let f : A →* Multiplicative (Representation.SuzukiNatural.W m) :=
    e.toLinearEquiv.toAddEquiv.toMultiplicative.toMonoidHom.comp
      (N.toSubmodule.mkQ.toAddMonoidHom.toMultiplicative.comp q)
  have hf : Function.Surjective f := e.toLinearEquiv.surjective.comp
    (N.toSubmodule.mkQ_surjective.comp hq)
  refine ⟨A,hAd.trans hD.le,hD ▸ hDA,hRA,f,hf,?_⟩
  intro r a
  change e (N.toSubmodule.mkQ (q (A.normalizerMonoidHom (inclusion hRA r) a)).toAdd) = _
  rw [hqe]
  exact LinearMap.congr_fun (e.isIntertwining' (μj r)) (N.toSubmodule.mkQ (q a).toAdd)

/-- The natural constituent has a literal numerator in the derived radical.
Its denominator lies in the middle root, and the rank-one actor centralizes
the quotient of the derived radical by its numerator. -/
theorem suzuki_derived_natural_middle_kernel (hhex : rotationOrder Q = 6)
    (hcore : Q.tits.B.normalCore = ⊥) (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    {m : ℕ} (hm : 0 < m)
    (μi : rankOne Q split i ≃* SuzukiMatrixGroup m)
    (μj : rankOne Q split j ≃* SuzukiMatrixGroup m)
    (νi : simpleRoot Q split i ≃* SuzukiRootSubgroup m)
    (νj : simpleRoot Q split j ≃* SuzukiRootSubgroup m) :
    ∃ (A : Subgroup (X ⧸ Q.D)),
      A ≤ ⁅simpleRemainder Q split j,simpleRemainder Q split j⁆ ∧
      (⁅simpleRemainder Q split j,simpleRemainder Q split j⁆ : Subgroup (X ⧸ Q.D)) ≤ normalizer (A : Set (X ⧸ Q.D)) ∧
      ⁅rankOne Q split j,⁅simpleRemainder Q split j,simpleRemainder Q split j⁆⁆ ≤ A ∧
      ∃ (hRA : rankOne Q split j ≤ normalizer (A : Set (X ⧸ Q.D)))
        (f : A →* Multiplicative (Representation.SuzukiNatural.W m)),
        Function.Surjective f ∧
        f.ker.map A.subtype ≤ rootAt Q split i (Q.simple j*Q.simple i) ∧
        ∀ (r : rankOne Q split j) (a : A),
          (f (A.normalizerMonoidHom (inclusion hRA r) a)).toAdd =
            Representation.SuzukiNatural.natural m (μj r) (f a).toAdd := by
  obtain ⟨A,hAD,hDA,hRA,f,hf,he⟩ :=
    suzuki_derived_natural_lift Q split hhex i j hij hKi hKj hm μi μj νi νj
  let D := ⁅simpleRemainder Q split j,simpleRemainder Q split j⁆
  let B := f.ker.map A.subtype
  have hBA : B ≤ A := map_subtype_le _
  have hDV : D ≤ simpleRemainder Q split j := commutator_le_self _
  have hRD : rankOne Q split j ≤ normalizer (D : Set (X ⧸ Q.D)) :=
    (rankOne_le_parabolic Q split j).trans (radical_commutator_normalized Q split j hKj)
  have hRB : rankOne Q split j ≤ normalizer (B : Set (X ⧸ Q.D)) := by
    apply le_normalizer_iff.mpr
    rintro r hr x ⟨a,ha,rfl⟩
    refine ⟨A.normalizerMonoidHom (inclusion hRA ⟨r,hr⟩) a,?_,rfl⟩
    change f (A.normalizerMonoidHom (inclusion hRA ⟨r,hr⟩) a) = 1
    apply Multiplicative.toAdd.injective
    rw [he,show f a = 1 from ha]
    exact map_zero _
  have hBc : Nat.card B = Nat.card f.ker := Nat.card_congr
    (f.ker.equivMapOfInjective A.subtype A.subtype_injective).symm.toEquiv
  have hWc : Nat.card (Multiplicative (Representation.SuzukiNatural.W m)) = 2^(4*(2*m+1)) := by
    change Nat.card (Representation.SuzukiNatural.W m) = _
    simpa only [Nat.card_zmod,Representation.SuzukiNatural.natural_finrank] using
      Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Representation.SuzukiNatural.W m)
  have hfc : f.ker.index = 2^(4*(2*m+1)) :=
    (Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv).trans hWc
  have hprod : 2^(4*(2*m+1))*Nat.card B = Nat.card A := by
    rw [hBc,←hfc]
    exact f.ker.index_mul_card
  have hDc : Nat.card D ≤ 2^(6*(2*m+1)) := by
    rcases suzuki_derived_radical_card Q split hhex i j hij hKi hKj hm μi μj νi νj with hh | hh
    · rw [hh]; exact Nat.pow_le_pow_right (by decide) (by omega)
    · exact hh.le
  have hAc : Nat.card A ≤ 2^(6*(2*m+1)) := (Nat.card_le_card_of_injective (inclusion hAD) (inclusion_injective _)).trans hDc
  have hsmall : 2^(6*(2*m+1)) < 2^(4*(2*m+1))*2^(4*(2*m+1)) := by
    rw [←pow_add]
    exact Nat.pow_lt_pow_right (by decide) (by omega)
  have hBsmall : Nat.card B < 2^(4*(2*m+1)) := by
    by_contra! hh
    exact (not_lt_of_ge ((Nat.mul_le_mul_left (2^(4*(2*m+1))) hh).trans
      (hprod.le.trans hAc))) hsmall
  let dB := invariantSection Q split j B ⊥ (hBA.trans (hAD.trans hDV)) hRB
    (by rw [(⊥ : Subgroup (X ⧸ Q.D)).normalizer_eq_top]; exact le_top)
    (by rw [(⊥ : Subgroup (X ⧸ Q.D)).normalizer_eq_top]; exact le_top)
  have hBsize : Nat.card dB.Carrier = Nat.card B := by
    change (⊥ : Subgroup (X ⧸ Q.D)).relIndex B = _
    exact relIndex_bot_left _
  have hactB := small_section_action Q split j hm μj dB (hBsize ▸ hBsmall)
  have hcommB : ⁅rankOne Q split j,B⁆ = ⊥ := by
    apply eq_bot_iff.mpr
    have hh := section_commutator_le Q split dB hactB
    change ⁅rankOne Q split j,B⁆ ≤ ((⊥ : Subgroup (X ⧸ Q.D)).subgroupOf B).map B.subtype at hh
    simpa only [bot_subgroupOf, Subgroup.map_bot] using hh
  have hBcentral : B ≤ centralizer (rankOne Q split j : Set (X ⧸ Q.D)) := by
    intro b hb
    rw [mem_centralizer_iff]
    intro r hr
    have hh := hcommB.le (commutator_mem_commutator hr hb)
    exact (commutatorElement_eq_one_iff_mul_comm.mp hh)
  have hBmiddle := (le_inf (hBA.trans (hAD.trans hDV)) hBcentral).trans
    (suzuki_radical_rankOne_centralizer_le_middle Q split hhex hcore i j hij hKi hKj hm μi μj νi νj)
  let dQ := invariantSection Q split j D A hDV hRD hDA hRA
  have hQprod : Nat.card dQ.Carrier * Nat.card A = Nat.card D := by
    change A.relIndex D * Nat.card A = Nat.card D
    rw [←relIndex_bot_left A,←relIndex_bot_left D]
    exact (Nat.mul_comm _ _).trans (relIndex_mul_relIndex ⊥ A D bot_le hAD)
  have hnatural : 2^(4*(2*m+1)) ≤ Nat.card A := by
    rw [←hprod]
    exact Nat.le_mul_of_pos_right _ Nat.card_pos
  have hQsmall : Nat.card dQ.Carrier < 2^(4*(2*m+1)) := by
    by_contra! hh
    exact (not_lt_of_ge ((Nat.mul_le_mul hh hnatural).trans
      (hQprod.le.trans hDc))) hsmall
  have hactQ := small_section_action Q split j hm μj dQ hQsmall
  have hcommQ := section_commutator_le Q split dQ hactQ
  change ⁅rankOne Q split j,D⁆ ≤ (A.subgroupOf D).map D.subtype at hcommQ
  rw [map_subgroupOf_eq_of_le hAD] at hcommQ
  exact ⟨A,hAD,hDA,hcommQ,hRA,f,hf,hBmiddle,he⟩


open scoped Pointwise

/-- The four nonmiddle root Frattini subgroups followed by an actual
normal denominator, using the source ordering in (6C). -/
@[expose] def naturalRootProduct (i j : Fin 2) (B : Subgroup (X ⧸ Q.D)) : Set (X ⧸ Q.D) :=
  (rootFrattiniAt Q split i 1 : Set (X ⧸ Q.D)) *
  (rootFrattiniAt Q split j (Q.simple i) : Set (X ⧸ Q.D)) *
  (rootFrattiniAt Q split j (Q.simple i*Q.simple j) : Set (X ⧸ Q.D)) *
  (rootFrattiniAt Q split i (Q.simple j) : Set (X ⧸ Q.D)) * (B : Set (X ⧸ Q.D))

private theorem natural_root_product_of_order (hhex : rotationOrder Q = 6)
    (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    {m : ℕ} (hm : 0 < m)
    (μi : rankOne Q split i ≃* SuzukiMatrixGroup m)
    (μj : rankOne Q split j ≃* SuzukiMatrixGroup m)
    (νi : simpleRoot Q split i ≃* SuzukiRootSubgroup m)
    (νj : simpleRoot Q split j ≃* SuzukiRootSubgroup m)
    (A B : Subgroup (X ⧸ Q.D)) (hBA : B ≤ A)
    (hAB : A ≤ normalizer (B : Set (X ⧸ Q.D)))
    (hBC : B ≤ rootAt Q split i (Q.simple j*Q.simple i))
    (hF : ∀ t : Fin 5, t ≠ 2 →
      rootFrattiniAt Q split (radicalRootKind i j t) (radicalRootWord Q i j t) ≤ A)
    (hc : Nat.card A = 2^(4*(2*m+1))*Nat.card B) :
    (A : Set (X ⧸ Q.D)) = naturalRootProduct Q split i j B := by
  let C0 := rootAt Q split i 1
  let C1 := rootAt Q split j (Q.simple i)
  let C2 := rootAt Q split i (Q.simple j*Q.simple i)
  let C3 := rootAt Q split j (Q.simple i*Q.simple j)
  let C4 := rootAt Q split i (Q.simple j)
  let F0 := frattini C0
  let F1 := frattini C1
  let F3 := frattini C3
  let F4 := frattini C4
  have h0 (x : F0) : (x.val : X ⧸ Q.D) ∈ A := hF 0 (by decide) (mem_map_of_mem C0.subtype x.property)
  have h1 (x : F1) : (x.val : X ⧸ Q.D) ∈ A := hF 1 (by decide) (mem_map_of_mem C1.subtype x.property)
  have h3 (x : F3) : (x.val : X ⧸ Q.D) ∈ A := hF 3 (by decide) (mem_map_of_mem C3.subtype x.property)
  have h4 (x : F4) : (x.val : X ⧸ Q.D) ∈ A := hF 4 (by decide) (mem_map_of_mem C4.subtype x.property)
  let f : F0 × F1 × B × F3 × F4 → A := fun z =>
    ⟨(z.1.val : X ⧸ Q.D)*z.2.1.val*z.2.2.1*z.2.2.2.1.val*z.2.2.2.2.val,
      mul_mem (mul_mem (mul_mem (mul_mem (h0 z.1) (h1 z.2.1)) (hBA z.2.2.1.property))
        (h3 z.2.2.2.1)) (h4 z.2.2.2.2)⟩
  have h0eq : C0 = simpleRoot Q split i := rootAt_one Q split i
  let c0 : C0 ≃* simpleRoot Q split i := MulEquiv.subgroupCongr h0eq
  let coords (z : F0 × F1 × B × F3 × F4) :=
    (c0 z.1.val,z.2.1.val,(⟨z.2.2.1,hBC z.2.2.1.property⟩ : C2),z.2.2.2.1.val,z.2.2.2.2.val)
  have hf : Function.Injective f := by
    intro z y he
    have hh : coords z = coords y := by
      apply (radicalCoordinates Q split hhex i j hij).injective
      apply Subtype.ext
      rw [radicalCoordinates_apply,radicalCoordinates_apply]
      exact congrArg Subtype.val he
    apply Prod.ext (Subtype.ext (c0.injective (congrArg Prod.fst hh)))
    apply Prod.ext (Subtype.ext (congrArg (fun z => z.2.1) hh))
    have hb : z.2.2.1 = y.2.2.1 := Subtype.ext (congrArg (fun z => (z.2.2.1 : X ⧸ Q.D)) hh)
    apply Prod.ext hb
    exact Prod.ext (Subtype.ext (congrArg (fun z => z.2.2.2.1) hh))
      (Subtype.ext (congrArg (fun z => z.2.2.2.2) hh))
  have hcard : Nat.card (F0 × F1 × B × F3 × F4) = Nat.card A := by
    rw [hc]
    simp only [Nat.card_prod,
      show Nat.card F0 = _ from suzuki_rootAt_frattini_card Q split i hKi hm μi νi 1,
      show Nat.card F1 = _ from suzuki_rootAt_frattini_card Q split j hKj hm μj νj _,
      show Nat.card F3 = _ from suzuki_rootAt_frattini_card Q split j hKj hm μj νj _,
      show Nat.card F4 = _ from suzuki_rootAt_frattini_card Q split i hKi hm μi νi _]
    have hp : 2^(4*(2*m+1)) = 2^(2*m+1)*2^(2*m+1)*2^(2*m+1)*2^(2*m+1) := by
      simp only [←pow_add]; congr 1; omega
    rw [hp]
    ring
  have hs := ((Nat.bijective_iff_injective_and_card f).mpr ⟨hf,hcard⟩).surjective
  apply Set.Subset.antisymm
  · intro x hx
    obtain ⟨⟨a,b,c,d,e⟩,he⟩ := hs ⟨x,hx⟩
    have hde : ((d.val : X ⧸ Q.D)*e.val) ∈ A := mul_mem (h3 d) (h4 e)
    let k := ((d.val : X ⧸ Q.D)*e.val)⁻¹*c*((d.val : X ⧸ Q.D)*e.val)
    have hk : k ∈ B := by
      simpa only [inv_inv] using (mem_normalizer_iff.mp (hAB (inv_mem hde)) c).mp c.property
    have hx' : (a.val : X ⧸ Q.D)*b.val*d.val*e.val*k = x := by
      have he' := congrArg Subtype.val he
      change (a.val : X ⧸ Q.D)*b.val*c*d.val*e.val = x at he'
      rw [←he']; dsimp only [k]; group
    exact ⟨_,⟨_,⟨_,⟨_,mem_map_of_mem C0.subtype a.property,
      _,mem_map_of_mem C1.subtype b.property,rfl⟩,
      _,mem_map_of_mem C3.subtype d.property,rfl⟩,
      _,mem_map_of_mem C4.subtype e.property,rfl⟩,_,hk,hx'⟩
  · rintro x ⟨abcd,⟨abc,⟨ab,⟨a,ha,b,hb,rfl⟩,c,hc,rfl⟩,d,hd,rfl⟩,e,he,rfl⟩
    exact mul_mem (mul_mem (mul_mem (mul_mem (hF 0 (by decide) ha)
      (hF 1 (by decide) hb)) (hF 3 (by decide) hc)) (hF 4 (by decide) hd)) (hBA he)

/-- The natural factor has exactly the source numerator: the four
nonmiddle root Frattini subgroups times its middle-root denominator.
The quotient map is equivariant for the actual conjugation action. -/
theorem suzuki_derived_natural_placement (hhex : rotationOrder Q = 6)
    (hcore : Q.tits.B.normalCore = ⊥) (i j : Fin 2) (hij : i ≠ j)
    (hKi : simpleRemainder Q split i ≤ localKernel Q i)
    (hKj : simpleRemainder Q split j ≤ localKernel Q j)
    {m : ℕ} (hm : 0 < m)
    (μi : rankOne Q split i ≃* SuzukiMatrixGroup m)
    (μj : rankOne Q split j ≃* SuzukiMatrixGroup m)
    (νi : simpleRoot Q split i ≃* SuzukiRootSubgroup m)
    (νj : simpleRoot Q split j ≃* SuzukiRootSubgroup m) :
    ∃ (A : Subgroup (X ⧸ Q.D)),
      A ≤ ⁅simpleRemainder Q split j,simpleRemainder Q split j⁆ ∧
      ∃ (hRA : rankOne Q split j ≤ normalizer (A : Set (X ⧸ Q.D)))
        (f : A →* Multiplicative (Representation.SuzukiNatural.W m)),
        Function.Surjective f ∧
        f.ker.map A.subtype ≤ rootAt Q split i (Q.simple j*Q.simple i) ∧
        (A : Set (X ⧸ Q.D)) = naturalRootProduct Q split i j (f.ker.map A.subtype) ∧
        ∀ (r : rankOne Q split j) (a : A),
          (f (A.normalizerMonoidHom (inclusion hRA r) a)).toAdd =
            Representation.SuzukiNatural.natural m (μj r) (f a).toAdd := by
  obtain ⟨A,hAD,_,hcomm,hRA,f,hf,hBC,he⟩ :=
    suzuki_derived_natural_middle_kernel Q split hhex hcore i j hij hKi hKj hm μi μj νi νj
  let B := f.ker.map A.subtype
  have hAB : A ≤ normalizer (B : Set (X ⧸ Q.D)) := by
    apply le_normalizer_iff.mpr
    rintro r hr x ⟨a,ha,rfl⟩
    let r' : A := ⟨r,hr⟩
    refine ⟨r'*a*r'⁻¹,?_,rfl⟩
    change f (r'*a*r'⁻¹) = 1
    rw [map_mul,map_mul,map_inv,show f a = 1 from ha,mul_one,mul_inv_cancel]
  have hF (t : Fin 5) (ht : t ≠ 2) :
      rootFrattiniAt Q split (radicalRootKind i j t) (radicalRootWord Q i j t) ≤ A :=
    (suzuki_nonmiddle_frattini_le_rankOne_commutator Q split hhex hcore i j hij hKi hKj hm μi μj νi νj t ht).trans hcomm
  have hWc : Nat.card (Multiplicative (Representation.SuzukiNatural.W m)) = 2^(4*(2*m+1)) := by
    change Nat.card (Representation.SuzukiNatural.W m) = _
    simpa only [Nat.card_zmod,Representation.SuzukiNatural.natural_finrank] using
      Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Representation.SuzukiNatural.W m)
  have hfc : f.ker.index = 2^(4*(2*m+1)) :=
    (Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv).trans hWc
  have hBc : Nat.card B = Nat.card f.ker := Nat.card_congr
    (f.ker.equivMapOfInjective A.subtype A.subtype_injective).symm.toEquiv
  have hc : Nat.card A = 2^(4*(2*m+1))*Nat.card B := by
    rw [hBc,←hfc]
    exact f.ker.index_mul_card.symm
  exact ⟨A,hAD,hRA,f,hf,hBC,
    natural_root_product_of_order Q split hhex i j hij hKi hKj hm μi μj νi νj
      A B (map_subtype_le _) hAB hBC hF hc,he⟩

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
