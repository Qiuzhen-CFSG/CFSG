module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.Irreducibility
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.NormalGeneration

/-!
# Normal quotients of the marked characteristic-two group

Every nontrivial normal subgroup V supplements the Borel. Indeed, any
proper standard parabolic in rank two lies in one of the two singleton
parabolics, each of which has trivial ambient normal core.

If the group is generated by conjugates of U, then VU is also the whole
group. The factorization VB = X and the B-normality of U make VU normal
in X; it therefore contains the normal closure of U. Restricting the
literal quotient map to U now proves that X/V is a two-group.

This supplies a further elementary normal-subgroup reduction for the
Fong–Seitz invocation in DGS, Groups and Graphs, Part II, pp.80–81 and224.
The normal-generation premise has already been proved for the selected
perfect-factor source consumer. No simplicity or Lie recognition is
inferred here. All statements retain the original marked finite quotient.
-/

public noncomputable section
open Subgroup
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.MarkedQuotient
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X} (d : MarkedQuotient P)

/-- A nontrivial normal subgroup is transitive on the Borel cosets. -/
theorem normal_subgroup_sup_borel (split : SplitData d.tits)
    (hc : ∀ i, centralizer (pCore 2 (d.tits.standardParabolic {d.simple i}) :
      Set (d.tits.standardParabolic {d.simple i})) ≤
      pCore 2 (d.tits.standardParabolic {d.simple i}))
    (V : Subgroup (X ⧸ d.D)) [V.Normal] (hne : V ≠ ⊥) :
    V ⊔ d.tits.B = ⊤ := by
  let A := V ⊔ d.tits.B
  have hA := d.tits.subgroup_eq_standardParabolic_simpleIndices A le_sup_right
  have hS : d.tits.simpleIndices A = d.tits.S := by
    apply Set.Subset.antisymm (d.tits.simpleIndices_subset A)
    intro s hs
    obtain ⟨i, rfl⟩ := d.simple_range.symm ▸ hs
    by_contra hi
    have hsub : d.tits.simpleIndices A ⊆ {d.simple (1 - i)} := by
      intro t ht
      obtain ⟨j, rfl⟩ := d.simple_range.symm ▸ d.tits.simpleIndices_subset A ht
      have hji : j ≠ i := fun he => hi (he ▸ ht)
      have he : j = 1 - i := by
        fin_cases i <;> fin_cases j
        · exact (hji rfl).elim
        · rfl
        · rfl
        · exact (hji rfl).elim
      exact congrArg d.simple he
    have hV : V ≤ d.tits.standardParabolic {d.simple (1 - i)} :=
      (show V ≤ A from le_sup_left).trans (hA ▸ d.tits.standardParabolic_mono hsub)
    have hz := normal_le_normalCore.mpr hV
    rw [d.parabolic_normalCore_eq_bot split (1 - i) (hc (1 - i))] at hz
    exact hne (le_bot_iff.mp hz)
  change A = ⊤
  rw [hA, hS, d.tits.standardParabolic_S]

/-- Normal generation by the specified U improves the Borel supplement
to a supplement by U itself. -/
theorem normal_subgroup_sup_unipotent (split : SplitData d.tits)
    (hc : ∀ i, centralizer (pCore 2 (d.tits.standardParabolic {d.simple i}) :
      Set (d.tits.standardParabolic {d.simple i})) ≤
      pCore 2 (d.tits.standardParabolic {d.simple i}))
    (hgen : split.unipotentClosure = ⊤)
    (V : Subgroup (X ⧸ d.D)) [V.Normal] (hne : V ≠ ⊥) :
    V ⊔ split.U = ⊤ := by
  let K := V ⊔ split.U
  have hVK : V ≤ normalizer (K : Set (X ⧸ d.D)) :=
    (show V ≤ K from le_sup_left).trans K.le_normalizer
  have hBK : d.tits.B ≤ normalizer (K : Set (X ⧸ d.D)) := by
    apply le_trans (le_inf (show d.tits.B ≤ normalizer (V : Set (X ⧸ d.D)) from
      le_normalizer_of_normal) split.normalizes)
    exact normalizer_inf_normalizer_le_normalizer_sup _ _
  let : K.Normal := normalizer_eq_top_iff.mp
    (top_unique ((d.normal_subgroup_sup_borel split hc V hne) ▸ sup_le hVK hBK))
  have hUK : split.unipotentClosure ≤ K := normalClosure_le_normal (fun _ hx => (show split.U ≤ K from le_sup_right) hx)
  exact top_unique (hgen ▸ hUK)

/-- Every quotient by a nontrivial normal subgroup is a two-group. -/
theorem quotient_isPGroup_of_ne_bot (split : SplitData d.tits)
    (hc : ∀ i, centralizer (pCore 2 (d.tits.standardParabolic {d.simple i}) :
      Set (d.tits.standardParabolic {d.simple i})) ≤
      pCore 2 (d.tits.standardParabolic {d.simple i}))
    (hgen : split.unipotentClosure = ⊤)
    (V : Subgroup (X ⧸ d.D)) [V.Normal] (hne : V ≠ ⊥) :
    IsPGroup 2 ((X ⧸ d.D) ⧸ V) := by
  let f := (QuotientGroup.mk' V).comp split.U.subtype
  apply split.isTwo.of_surjective f
  intro x
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective V x
  obtain ⟨v, hv, u, hu, rfl⟩ := mem_sup_of_normal_left.mp
    ((d.normal_subgroup_sup_unipotent split hc hgen V hne) ▸ mem_top y)
  refine ⟨⟨u, hu⟩, ?_⟩
  change QuotientGroup.mk' V u = QuotientGroup.mk' V (v * u)
  have hvq : QuotientGroup.mk' V v = 1 := (QuotientGroup.eq_one_iff v).mpr hv
  rw [map_mul, hvq, one_mul]

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.MarkedQuotient
