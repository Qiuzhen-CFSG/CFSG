module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.UnitarySource.RootActors
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.ReeSource.CartanKernels
public import Mathlib.GroupTheory.GroupAction.MultipleTransitivity

/-!
# The actual root actor on the full endpoint panel

The simple root acts regularly on the punctured panel by the existing
literal chart r ↦ r nᵢ B. Its opposite contains an element outside B, so
the subgroup generated by the two roots is transitive on the entire panel.
Combining these facts proves double transitivity of this actual actor,
without identifying an arbitrary parabolic with a rank-one model.

This supplies the rank-one permutation action used before the module
realizations in Fong--Seitz I §§2--4 (especially pp.10,16--19) and (6A),
pp.36--38. It does not classify the actor or assert that its panel kernel
is trivial; in the U5 branch the central SU3 versus PSU3 kernel matters.
-/

public noncomputable section
open Subgroup
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.UnitarySource
open RootCoordinates
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
variable (Q : MarkedQuotient P) (split : SplitData Q.tits) (i : Fin 2)

abbrev PanelEndpoint := Q.tits.standardParabolic {Q.simple i}
@[expose] def panelActor : Subgroup (PanelEndpoint Q i) :=
  (rootActor Q split i).subgroupOf (PanelEndpoint Q i)

@[expose] def panelRoot (r : simpleRoot Q split i) : panelActor Q split i :=
  ⟨⟨r, rootActor_le_endpoint Q split i (mem_sup_left r.property)⟩, mem_sup_left r.property⟩

@[expose] def oppositePoint : Panel Q i :=
  QuotientGroup.mk (ReeSource.reflectionLift Q i)

private theorem chart_eq (r : simpleRoot Q split i) :
    (simplePanelMap Q split i (representative (Q.simple i)) (representative_spec _) r).val =
      panelRoot Q split i r • oppositePoint Q i := by
  rw [simplePanelMap_apply]
  rfl

theorem panelRoot_fixes_base (r : simpleRoot Q split i) :
    panelRoot Q split i r • panelBase Q i = panelBase Q i := by
  rw [ReeSource.panelBase_eq_mk_one Q split i]
  change QuotientGroup.mk ((panelRoot Q split i r : PanelEndpoint Q i) * 1) =
    (QuotientGroup.mk 1 : Panel Q i)
  apply QuotientGroup.eq.mpr
  change ((r : X ⧸ Q.D)*1)⁻¹*1 ∈ Q.tits.B
  simpa only [mul_one] using Q.tits.B.inv_mem (split.U_le r.property.1)

/-- The actual root acts regularly on the punctured panel. -/
theorem exists_unique_root_transport (a b : Panel Q i)
    (ha : a ≠ panelBase Q i) (hb : b ≠ panelBase Q i) :
    ∃! r : simpleRoot Q split i, panelRoot Q split i r • a = b := by
  let chart := simplePanelMap Q split i (representative (Q.simple i)) (representative_spec _)
  obtain ⟨u,hu⟩ := (simplePanelMap_bijective Q split i _ (representative_spec _)).surjective ⟨a,ha⟩
  obtain ⟨v,hv⟩ := (simplePanelMap_bijective Q split i _ (representative_spec _)).surjective ⟨b,hb⟩
  have hau : a = panelRoot Q split i u • oppositePoint Q i :=
    (congrArg Subtype.val hu).symm.trans (chart_eq Q split i u)
  have hbv : b = panelRoot Q split i v • oppositePoint Q i :=
    (congrArg Subtype.val hv).symm.trans (chart_eq Q split i v)
  have hm (r t : simpleRoot Q split i) :
      panelRoot Q split i (r*t) = panelRoot Q split i r * panelRoot Q split i t := rfl
  refine ⟨v*u⁻¹, ?_, ?_⟩
  · dsimp only
    rw [hau, hbv, ← mul_smul, ← hm, inv_mul_cancel_right]
  · intro r hr
    rw [hau, hbv, ← mul_smul, ← hm] at hr
    have he : chart (r*u) = chart v := by
      apply Subtype.ext
      exact (chart_eq Q split i (r*u)).trans (hr.trans (chart_eq Q split i v).symm)
    exact eq_mul_inv_iff_mul_eq.mpr
      (simplePanelMap_injective Q split i _ (representative_spec _) he)

/-- The opposite root contains an element moving the base point. -/
theorem exists_actor_moves_base :
    ∃ r : panelActor Q split i, r • panelBase Q i ≠ panelBase Q i := by
  have hnot := rootActor_not_le_borel Q split i
  obtain ⟨x,hx,hxB⟩ := Set.not_subset.mp hnot
  let r : panelActor Q split i := ⟨⟨x,rootActor_le_endpoint Q split i hx⟩,hx⟩
  refine ⟨r, ?_⟩
  rw [ReeSource.panelBase_eq_mk_one Q split i]
  intro he
  have hm := QuotientGroup.eq.mp he.symm
  apply hxB
  change (1 : X ⧸ Q.D)⁻¹*(x*1) ∈ Q.tits.B at hm
  simpa only [inv_one, one_mul, mul_one, SetLike.mem_coe] using hm

theorem exists_actor_from_base (a : Panel Q i) :
    ∃ r : panelActor Q split i, r • panelBase Q i = a := by
  by_cases ha : a = panelBase Q i
  · exact ⟨1, by simpa only [one_smul] using ha.symm⟩
  obtain ⟨r,hr⟩ := exists_actor_moves_base Q split i
  obtain ⟨u,hu,_⟩ := exists_unique_root_transport Q split i _ a hr ha
  exact ⟨panelRoot Q split i u*r, by rw [mul_smul,hu]⟩

/-- The root-generated actor is transitive on the entire actual endpoint panel. -/
theorem panelActor_pretransitive : MulAction.IsPretransitive (panelActor Q split i) (Panel Q i) where
  exists_smul_eq a b := by
    obtain ⟨r,hr⟩ := exists_actor_from_base Q split i a
    obtain ⟨s,hs⟩ := exists_actor_from_base Q split i b
    exact ⟨s*r⁻¹, by rw [← hr,mul_smul,inv_smul_smul,hs]⟩

/-- The SAME root-generated actor is doubly transitive, without a model identification. -/
theorem panelActor_two_pretransitive :
    MulAction.IsMultiplyPretransitive (panelActor Q split i) (Panel Q i) 2 := by
  rw [MulAction.is_two_pretransitive_iff]
  intro a b c d hab hcd
  obtain ⟨r,hr⟩ := exists_actor_from_base Q split i a
  obtain ⟨s,hs⟩ := exists_actor_from_base Q split i c
  have hb : r⁻¹ • b ≠ panelBase Q i := by
    intro he
    have he' := congrArg (fun z => r • z) he
    rw [smul_inv_smul,hr] at he'
    exact hab he'.symm
  have hd : s⁻¹ • d ≠ panelBase Q i := by
    intro he
    have he' := congrArg (fun z => s • z) he
    rw [smul_inv_smul,hs] at he'
    exact hcd he'.symm
  obtain ⟨u,hu,_⟩ := exists_unique_root_transport Q split i _ _ hb hd
  refine ⟨s*panelRoot Q split i u*r⁻¹, ?_, ?_⟩
  · rw [mul_smul, mul_smul, ← hr, inv_smul_smul, panelRoot_fixes_base,hs]
  · rw [mul_smul, mul_smul,hu,smul_inv_smul]

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.UnitarySource
