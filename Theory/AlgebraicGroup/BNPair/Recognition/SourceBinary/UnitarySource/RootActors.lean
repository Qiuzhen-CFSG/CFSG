module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.RootGeneration
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.RootCoordinates.SimplePanels

/-!
# Actual rank-one actors and generation from Weyl lifts

The actor at an endpoint is generated by its canonical simple root and
its opposite under that endpoint's reflection. It is independent of the
representative modulo the full Cartan, lies in the actual endpoint and is
normalized by the Cartan and by that reflection. Its opposite root meets
the Borel trivially, so this actor cannot be replaced by the Borel.

Two chosen simple lifts generate the Weyl quotient. Consequently any
subgroup containing U and those lifts contains every Weyl root. The
source application combines this with normal generation to prove whole
group generation, including nonperfect local factors.

Source: Fong--Seitz I §§3--4, pp.12--19; Carter §2.5. The module and
rank-one model identifications required in Fong--Seitz I (6A) are separate
mathematical obligations, not fields of the actor definition.
-/

public noncomputable section
open Subgroup
open scoped Pointwise
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.UnitarySource
open RootCoordinates RootGeneration
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
variable (Q : MarkedQuotient P) (split : SplitData Q.tits)

@[expose] def oppositeRoot (i : Fin 2) : Subgroup (X ⧸ Q.D) :=
  rightConjugate (simpleRoot Q split i) (representative (Q.simple i) : X ⧸ Q.D)

@[expose] def rootActor (i : Fin 2) : Subgroup (X ⧸ Q.D) :=
  simpleRoot Q split i ⊔ oppositeRoot Q split i

/-- Changing the lift by any element of the full Cartan preserves the actor. -/
theorem oppositeRoot_eq (i : Fin 2) (n : Q.tits.N)
    (hn : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) n = Q.simple i) :
    oppositeRoot Q split i = rightConjugate (simpleRoot Q split i) (n : X ⧸ Q.D) :=
  rightConjugate_eq_of_quotient_eq _ (torus_normalizes_simpleRoot Q split i)
    _ n ((representative_spec _).trans hn.symm)

theorem rootActor_le_endpoint (i : Fin 2) :
    rootActor Q split i ≤ Q.tits.standardParabolic {Q.simple i} := by
  have hR : simpleRoot Q split i ≤ Q.tits.standardParabolic {Q.simple i} :=
    (simpleRoot_le Q split i).trans (split.U_le.trans (Q.tits.B_le_standardParabolic _))
  have hn : (representative (Q.simple i) : X ⧸ Q.D) ∈ Q.tits.standardParabolic {Q.simple i} :=
    Q.tits.bruhatCell_subset_standardParabolic_of_mem (Set.mem_singleton _)
      (Q.tits.representative_mem_bruhatCell _ _ (representative_spec _))
  apply sup_le hR
  intro x hx
  have hm := (Q.tits.standardParabolic {Q.simple i}).mul_mem
    ((Q.tits.standardParabolic {Q.simple i}).mul_mem
      ((Q.tits.standardParabolic {Q.simple i}).inv_mem hn) (hR hx)) hn
  change (representative (Q.simple i) : X ⧸ Q.D)⁻¹ *
    ((representative (Q.simple i) : X ⧸ Q.D)*x*(representative (Q.simple i) : X ⧸ Q.D)⁻¹) *
    (representative (Q.simple i) : X ⧸ Q.D) ∈ _ at hm
  simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using hm

theorem torus_normalizes_rootActor (i : Fin 2) :
    Q.tits.B ⊓ Q.tits.N ≤ normalizer (rootActor Q split i : Set (X ⧸ Q.D)) :=
  (le_inf (torus_normalizes_simpleRoot Q split i)
    (torus_normalizes_rightConjugate _ (torus_normalizes_simpleRoot Q split i) _)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)

/-- The reflection interchanges the two generating roots; no order-two lift is assumed. -/
theorem reflection_conjugates_rootActor (i : Fin 2) (n : Q.tits.N)
    (hn : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) n = Q.simple i) :
    rightConjugate (rootActor Q split i) (n : X ⧸ Q.D) = rootActor Q split i := by
  have hnn : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) (n*n) = 1 := by
    rw [map_mul, hn, ← pow_two, (Q.tits.involutions _ (Q.simple_mem i)).2]
  have htwice : rightConjugate (oppositeRoot Q split i) (n : X ⧸ Q.D) = simpleRoot Q split i := by
    rw [oppositeRoot_eq Q split i n hn, ← rightConjugate_mul]
    have he := rightConjugate_eq_of_quotient_eq (simpleRoot Q split i)
      (torus_normalizes_simpleRoot Q split i) (n*n) 1 (by simpa using hnn)
    simpa only [Subgroup.coe_mul, Subgroup.coe_one, rightConjugate_one] using he
  change (simpleRoot Q split i ⊔ oppositeRoot Q split i).comap
    (MulAut.conj (n : X ⧸ Q.D)).toMonoidHom = _
  rw [← comap_sup_eq _ _ _ (MulAut.conj (n : X ⧸ Q.D)).surjective]
  change rightConjugate (simpleRoot Q split i) (n : X ⧸ Q.D) ⊔
    rightConjugate (oppositeRoot Q split i) (n : X ⧸ Q.D) = _
  rw [← oppositeRoot_eq Q split i n hn, htwice, sup_comm]
  rfl

/-- The opposite simple root is disjoint from the whole Borel. -/
theorem oppositeRoot_disjoint_borel (i : Fin 2) :
    Disjoint (oppositeRoot Q split i) Q.tits.B := by
  apply disjoint_iff.mpr
  apply eq_bot_iff.mpr
  intro x hx
  let n := representative (Q.simple i)
  have hnn : (n : X ⧸ Q.D)*(n : X ⧸ Q.D) ∈ Q.tits.B := by
    have he := (Q.tits.representative_sq_mem_intersection (Q.simple_mem i)
      n (representative_spec _)).1
    change (n : X ⧸ Q.D)^2 ∈ Q.tits.B at he
    simpa only [pow_two] using he
  have hmem : (n : X ⧸ Q.D)*x*(n : X ⧸ Q.D)⁻¹ ∈
      simpleRoot Q split i ⊓ borelConjugate (Q.simple i) := by
    refine ⟨hx.1, ?_⟩
    change (n : X ⧸ Q.D)*((n : X ⧸ Q.D)*x*(n : X ⧸ Q.D)⁻¹)*
      (n : X ⧸ Q.D)⁻¹ ∈ Q.tits.B
    have h := Q.tits.B.mul_mem (Q.tits.B.mul_mem hnn hx.2) (Q.tits.B.inv_mem hnn)
    simpa only [mul_inv_rev, mul_assoc] using h
  rw [disjoint_iff.mp (simpleRoot_disjoint_conjugateBorel Q split i), mem_bot] at hmem
  apply (MulAut.conj (n : X ⧸ Q.D)).injective
  simpa only [MulAut.conj_apply, map_one] using hmem

/-- The actor has a nontrivial opposite root outside the entire Borel. -/
theorem rootActor_not_le_borel (i : Fin 2) : ¬ rootActor Q split i ≤ Q.tits.B := by
  intro hle
  have hO : oppositeRoot Q split i = ⊥ := by
    apply bot_unique
    intro x hx
    exact (disjoint_iff.mp (oppositeRoot_disjoint_borel Q split i)).le
      ⟨hx, hle (mem_sup_right hx)⟩
  apply simpleRoot_ne_bot Q split i
  apply bot_unique
  intro x hx
  let n := representative (Q.simple i)
  have hm : (n : X ⧸ Q.D)⁻¹*x*(n : X ⧸ Q.D) ∈ oppositeRoot Q split i := by
    change (n : X ⧸ Q.D)*((n : X ⧸ Q.D)⁻¹*x*(n : X ⧸ Q.D))*(n : X ⧸ Q.D)⁻¹ ∈ simpleRoot Q split i
    simpa only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one] using hx
  rw [hO, mem_bot] at hm
  have he := congrArg (fun z => (n : X ⧸ Q.D)*z*(n : X ⧸ Q.D)⁻¹) hm
  simpa only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one, mem_bot] using he

/-- Actual simple lifts have representatives inside every subgroup containing them. -/
theorem exists_weyl_lift_in (n : Fin 2 → Q.tits.N)
    (hn : ∀ i, QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) (n i) = Q.simple i)
    (K : Subgroup (X ⧸ Q.D)) (hK : ∀ i, (n i : X ⧸ Q.D) ∈ K) (w : Weyl Q) :
    ∃ k : Q.tits.N, (k : X ⧸ Q.D) ∈ K ∧
      QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) k = w := by
  let q := QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N)
  have htop : (K.subgroupOf Q.tits.N).map q = ⊤ := by
    apply top_unique
    rw [← Q.tits.quotient_generate]
    apply (closure_le _).mpr
    intro s hs
    obtain ⟨i,rfl⟩ := Q.simple_range.symm ▸ hs
    exact ⟨n i, hK i, hn i⟩
  have hw : w ∈ (K.subgroupOf Q.tits.N).map q := htop ▸ mem_top w
  exact hw

/-- This removes a whole-group generation premise once U and two literal
simple Weyl lifts are present. No Cartan-surjectivity premise is used. -/
theorem weylRootSpan_le_of_unipotent_and_lifts (n : Fin 2 → Q.tits.N)
    (hn : ∀ i, QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) (n i) = Q.simple i)
    (K : Subgroup (X ⧸ Q.D)) (hU : split.U ≤ K) (hK : ∀ i, (n i : X ⧸ Q.D) ∈ K) :
    weylRootSpan Q split ≤ K := by
  rw [weylRootSpan_eq_iSup_weyl]
  apply iSup_le
  intro i
  apply iSup_le
  intro w
  obtain ⟨k,hk,hw⟩ := exists_weyl_lift_in Q n hn K hK w
  rw [rightConjugate_eq_of_quotient_eq _ (torus_normalizes_simpleRoot Q split i)
    (representative w) k ((representative_spec w).trans hw.symm)]
  intro x hx
  have hm := K.mul_mem (K.mul_mem (K.inv_mem hk) (hU (simpleRoot_le Q split i hx))) hk
  change (k : X ⧸ Q.D)⁻¹ * ((k : X ⧸ Q.D)*x*(k : X ⧸ Q.D)⁻¹) *
    (k : X ⧸ Q.D) ∈ K at hm
  simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using hm

/-- The whole marked endpoint is generated by the whole Borel and any
lift of its specified reflection. This is an equality of actual subgroups. -/
theorem endpoint_eq_borel_sup_lift (i : Fin 2) (n : Q.tits.N)
    (hn : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) n = Q.simple i) :
    Q.tits.standardParabolic {Q.simple i} =
      Q.tits.B ⊔ closure ({(n : X ⧸ Q.D)} : Set (X ⧸ Q.D)) := by
  apply le_antisymm
  · apply Q.tits.standardParabolic_le _ le_sup_left
    intro s hs
    obtain rfl := Set.mem_singleton_iff.mp hs
    intro x hx
    rw [bruhatCell, B_mul_representativeSet_mul_B Q.tits.B Q.tits.N (Q.simple i) n hn] at hx
    obtain ⟨b,hb,c,hc,rfl⟩ := DoubleCoset.mem_doubleCoset.mp hx
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (mem_sup_left hb)
      (mem_sup_right (subset_closure (Set.mem_singleton _)))) (mem_sup_left hc)
  · apply sup_le (Q.tits.B_le_standardParabolic _)
    apply (closure_le _).mpr
    rintro x rfl
    exact Q.tits.bruhatCell_subset_standardParabolic_of_mem (Set.mem_singleton _)
      (Q.tits.representative_mem_bruhatCell _ n hn)

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.UnitarySource
