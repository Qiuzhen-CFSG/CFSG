module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.UnitarySource.CoreAction
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.UnitarySource.RootActors
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.HexagonStructure.LocalActions
public import Theory.Representation.EndFieldRep
public import Mathlib.FieldTheory.Finite.Basic

/-!
# The coefficient field constructed from the same source core

Let Rᵢ be the subgroup generated by the actual simple and opposite roots.
Once U ∩ U^s lies in the panel kernel, the full H Rᵢ acts on its Frattini
section by literal conjugation. The subgroup H ∩ Kᵢ is central in H Rᵢ,
so its faithful operators embed in the commuting ring of this action.

If this actual H Rᵢ module is irreducible, the finite Schur theorem makes
that ring a finite field of characteristic two. The scalar embedding is
constructed from the action, including its equation on the original core;
its injectivity gives cyclicity and the precise divisibility by |E|−1.
No source field identification or matrix-module isomorphism is an input.

Source: Fong--Seitz II (8B), p.201, and (8C), p.203. The containment from
I (2B), p.9, and the row-specific irreducibility from I (6A), pp.37--38,
remain explicit earlier-source premises of this intermediate construction.
Their proofs, field dimensions and natural/tensor realizations remain with
the unitary source-reconstruction owner. In particular irreducibility here
is for H Rᵢ, as required in the small-field U4 branch.
-/

public noncomputable section
open Subgroup
open scoped IsMulCommutative MonoidAlgebra
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.UnitarySource
open RootCoordinates
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
variable (Q : MarkedQuotient P) (split : SplitData Q.tits) (i : Fin 2)

@[expose] def coreActor : Subgroup (X ⧸ Q.D) :=
  (Q.tits.B ⊓ Q.tits.N) ⊔ rootActor Q split i

theorem coreCartan_centralizes_coreActor :
    coreCartan Q i ≤ centralizer (coreActor Q split i : Set (X ⧸ Q.D)) := by
  apply le_centralizer_iff.mp
  apply sup_le
  · intro a ha
    rw [mem_centralizer_iff]
    intro b hb
    let : IsMulCommutative (Q.tits.B ⊓ Q.tits.N : Subgroup (X ⧸ Q.D)) := split.abelian
    exact congrArg Subtype.val (mul_comm (⟨b,hb.1⟩ : ↥(Q.tits.B ⊓ Q.tits.N)) ⟨a,ha⟩)
  · exact (commutator_eq_bot_iff_le_centralizer.mp
      (ReeSource.rankOneRootGroup_commutator_cartanKernel Q split i))

variable (hV : simpleRemainder Q split i ≤ HexagonStructure.localKernel Q i)

@[expose] def coreActorAction : coreActor Q split i →* MulAut (simpleRemainder Q split i) :=
  (simpleRemainder Q split i).normalizerMonoidHom.comp
    (inclusion ((sup_le (inf_le_left.trans (Q.tits.B_le_standardParabolic _))
      (rootActor_le_endpoint Q split i)).trans
        (HexagonStructure.remainder_parabolic_normalizes Q split i hV)))

@[expose] def coreActorFrattiniAction : coreActor Q split i →*
    MulAut ((simpleRemainder Q split i) ⧸ frattini (simpleRemainder Q split i)) :=
  (Subgroup.quotientAut (frattini (simpleRemainder Q split i))).comp (coreActorAction Q split i hV)

@[expose] def coreActorRepresentation :
    Representation (ZMod 2) (coreActor Q split i) (CoreSpace Q split i) where
  toFun h := (coreActorFrattiniAction Q split i hV h).toMonoidHom.toAdditive.toZModLinearMap 2
  map_one' := by
    ext v
    change Additive.ofMul (coreActorFrattiniAction Q split i hV 1 v.toMul) = v
    rw [map_one]
    rfl
  map_mul' h k := by
    ext v
    change Additive.ofMul (coreActorFrattiniAction Q split i hV (h*k) v.toMul) = _
    rw [map_mul]
    rfl

@[expose] def coreCartanInActor : coreCartan Q i →* coreActor Q split i :=
  inclusion (inf_le_left.trans le_sup_left)

@[simp] theorem coreActorRepresentation_coreCartan (h : coreCartan Q i) :
    coreActorRepresentation Q split i hV (coreCartanInActor Q split i h) =
      coreFrattiniRepresentation Q split i h := by
  ext v
  rfl

@[expose] def coreScalarIntertwiner (h : coreCartan Q i) :
    Representation.IntertwiningMap (coreActorRepresentation Q split i hV)
      (coreActorRepresentation Q split i hV) where
  toLinearMap := coreFrattiniRepresentation Q split i h
  isIntertwining' g := by
    apply LinearMap.ext
    intro v
    have hc : (coreCartanInActor Q split i h) * g = g * (coreCartanInActor Q split i h) :=
      Subtype.ext (((mem_centralizer_iff.mp (coreCartan_centralizes_coreActor Q split i h.property))
        g g.property).symm)
    have he := congrArg (fun a => coreActorRepresentation Q split i hV a v) hc
    simpa only [map_mul, Module.End.mul_apply, LinearMap.comp_apply, coreActorRepresentation_coreCartan] using he

/-- This is the actual commuting ring of the action on the original core section. -/
abbrev CoreEnd := Module.End (ZMod 2)[coreActor Q split i]
  (coreActorRepresentation Q split i hV).asModule

@[expose] def coreScalar : coreCartan Q i →* CoreEnd Q split i hV where
  toFun h := Representation.IntertwiningMap.equivAlgEnd _ (coreScalarIntertwiner Q split i hV h)
  map_one' := by
    apply (Representation.IntertwiningMap.equivAlgEnd _).symm.injective
    simp only [AlgEquiv.symm_apply_apply]
    apply Representation.IntertwiningMap.ext
    apply LinearMap.ext
    intro v
    exact LinearMap.congr_fun (map_one (coreFrattiniRepresentation Q split i)) v
  map_mul' h k := by
    rw [← map_mul]
    congr 1
    apply Representation.IntertwiningMap.ext
    apply LinearMap.ext
    intro v
    exact LinearMap.congr_fun (map_mul (coreFrattiniRepresentation Q split i) h k) v

@[simp] theorem coreScalar_apply (h : coreCartan Q i)
    (v : (coreActorRepresentation Q split i hV).asModule) :
    (coreActorRepresentation Q split i hV).asModuleEquiv (coreScalar Q split i hV h v) =
      coreFrattiniRepresentation Q split i h ((coreActorRepresentation Q split i hV).asModuleEquiv v) := rfl

theorem coreScalar_injective
    (hc : centralizer (pCore 2 (Q.tits.standardParabolic {Q.simple i}) :
      Set (Q.tits.standardParabolic {Q.simple i})) ≤
      pCore 2 (Q.tits.standardParabolic {Q.simple i})) :
    Function.Injective (coreScalar Q split i hV) := by
  intro h k he
  apply coreFrattiniRepresentation_injective Q split i hc
  apply LinearMap.ext
  intro v
  have hv := congrArg (fun f : CoreEnd Q split i hV =>
    (coreActorRepresentation Q split i hV).asModuleEquiv
      (f ((coreActorRepresentation Q split i hV).asModuleEquiv.symm v))) he
  simpa only [coreScalar_apply, LinearEquiv.apply_symm_apply] using hv

/-- The scalar map lands in units because its actor is a group. -/
@[expose] def coreScalarUnits : coreCartan Q i →* (CoreEnd Q split i hV)ˣ :=
  (coreScalar Q split i hV).toHomUnits

theorem coreScalarUnits_injective
    (hc : centralizer (pCore 2 (Q.tits.standardParabolic {Q.simple i}) :
      Set (Q.tits.standardParabolic {Q.simple i})) ≤
      pCore 2 (Q.tits.standardParabolic {Q.simple i})) :
    Function.Injective (coreScalarUnits Q split i hV) := by
  intro h k he
  exact coreScalar_injective Q split i hV hc (congrArg Units.val he)

@[simp] theorem coreScalarUnits_smul (h : coreCartan Q i)
    (v : (coreActorRepresentation Q split i hV).asModule) :
    (coreActorRepresentation Q split i hV).asModuleEquiv
      ((coreScalarUnits Q split i hV h : CoreEnd Q split i hV) • v) =
      coreFrattiniRepresentation Q split i h ((coreActorRepresentation Q split i hV).asModuleEquiv v) :=
  coreScalar_apply Q split i hV h v

variable [Representation.IsIrreducible (coreActorRepresentation Q split i hV)]
instance coreEnd_charTwo : CharP (CoreEnd Q split i hV) 2 :=
  charP_of_injective_algebraMap (algebraMap (ZMod 2) (CoreEnd Q split i hV)).injective 2

/-- The source scalar actor has order dividing the nonzero elements of the constructed field. -/
theorem coreCartan_card_dvd_field_sub_one
    (hc : centralizer (pCore 2 (Q.tits.standardParabolic {Q.simple i}) :
      Set (Q.tits.standardParabolic {Q.simple i})) ≤
      pCore 2 (Q.tits.standardParabolic {Q.simple i})) :
    Nat.card (coreCartan Q i) ∣ Nat.card (CoreEnd Q split i hV) - 1 := by
  rw [← Nat.card_units]
  exact card_dvd_of_injective (coreScalarUnits Q split i hV)
    (coreScalarUnits_injective Q split i hV hc)

include split hV in
/-- The scalar Cartan kernel is cyclic, derived from its faithful field embedding. -/
theorem coreCartan_isCyclic
    (hc : centralizer (pCore 2 (Q.tits.standardParabolic {Q.simple i}) :
      Set (Q.tits.standardParabolic {Q.simple i})) ≤
      pCore 2 (Q.tits.standardParabolic {Q.simple i})) : IsCyclic (coreCartan Q i) :=
  isCyclic_of_injective (coreScalarUnits Q split i hV)
    (coreScalarUnits_injective Q split i hV hc)

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.UnitarySource
