module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.ReeSection10.V2Support

/-!
# The first derived-subgroup bound for the linear Section 10 radical

Relations (10.2)(ii)--(iii), conjugated by the actual simple reflections,
place three linear roots and two Omega subgroups in [U_s₁,U_s₁]. This is
the first displayed lower bound on printed p.222; it remains valid at q=2.
The subgroup's own abelianization then strips those three linear factors
from Carter's five-root commutator support, leaving the two Suzuki factors.

The consumer LinearGraph lifts (10.5) back from the literal V₂ quotient.
No characteristic denominator or natural linear representation is assumed.
Source: Fong--Seitz, Groups with a (B,N)-pair of rank 2, II (1974),
(10.2), printed pp.221--222.
-/

@[expose] public noncomputable section
open Subgroup
open scoped Pointwise
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.ReeSource
namespace Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.ReeSection10
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P) (split : SplitData Q.tits) {n m : ℕ}
  (c : ReeSixHData Q split n m)

def linearDerived : Subgroup (X ⧸ Q.D) :=
  ⁅simpleRemainder Q split 0,simpleRemainder Q split 0⁆

def linearDerivedSeed : Subgroup (X ⧸ Q.D) :=
  positiveRoot Q split (.inl 2) ⊔ omegaOneAmbient (positiveRoot Q split (.inr 1)) ⊔
    positiveRoot Q split (.inl 3) ⊔ omegaOneAmbient (positiveRoot Q split (.inr 3)) ⊔
      positiveRoot Q split (.inl 1)

/-- The subgroup generated by the five factors of the source T₁ product,
in their printed order. Product and characteristic-section identifications
are separate from the derived-subgroup bounds. -/
def T1 : Subgroup (X ⧸ Q.D) :=
  positiveRoot Q split (.inl 2) ⊔ positiveRoot Q split (.inr 1) ⊔
    positiveRoot Q split (.inl 3) ⊔ positiveRoot Q split (.inr 3) ⊔ positiveRoot Q split (.inl 1)

private theorem conjugate_omega (A : Subgroup (X ⧸ Q.D)) (g : X ⧸ Q.D) :
    rightConjugate (omegaOneAmbient A) g = omegaOneAmbient (rightConjugate A g) := by
  simp only [rightConjugate,comap_equiv_eq_map_symm']
  exact map_omegaOneAmbient_injective _ (MulEquiv.injective _) _

include c in
theorem reflectedLinear_le_linearDerived :
    positiveRoot Q split (.inl 1) ≤ linearDerived Q split := by
  have h := c.relations.ten_two_ii_left 1
  change ⁅nConj (simpleRoot Q split 1) 1,nConj (positiveRoot Q split (.inr 3)) 1⁆ =
    nConj (positiveRoot Q split (.inl 1)) 1 at h
  simp only [nConj,OneMemClass.coe_one,rightConjugate_one] at h
  rw [←h]
  exact commutator_mono
    (by simpa only [positiveRoot,positiveKind,positiveWord,Matrix.cons_val,
      Fin.isValue,Matrix.head_cons,rootAt_one] using
      positiveRoot_le_remainder Q split c (.inr 0) 0 (by decide))
    (positiveRoot_le_remainder Q split c (.inr 3) 0 (by decide))

include c in
theorem nextLinear_le_linearDerived :
    positiveRoot Q split (.inl 2) ≤ linearDerived Q split := by
  let s := (c.reflections 0).val
  have h := c.relations.ten_two_ii_left s
  change ⁅rightConjugate (simpleRoot Q split 1) (s : X ⧸ Q.D),
    rightConjugate (rootAt Q split 1 (Q.simple 0*Q.simple 1)) (s : X ⧸ Q.D)⁆ =
    rightConjugate (rootAt Q split 0 (Q.simple 1)) (s : X ⧸ Q.D) at h
  rw [←rootAt_eq Q split 1 _ s (c.reflections 0).class_eq,
    rootAt_right Q split 1 _ _ s (c.reflections 0).class_eq,
    rootAt_right Q split 0 _ _ s (c.reflections 0).class_eq] at h
  change ⁅positiveRoot Q split (.inr 2),positiveRoot Q split (.inr 1)⁆ =
    positiveRoot Q split (.inl 2) at h
  rw [←h]
  exact commutator_mono (positiveRoot_le_remainder Q split c _ 0 (by decide))
    (positiveRoot_le_remainder Q split c _ 0 (by decide))

include c in
theorem perpendicularLinear_le_linearDerived :
    positiveRoot Q split (.inl 3) ≤ linearDerived Q split := by
  let s := (c.reflections 0).val
  let t := (c.reflections 1).val
  have hst : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) (s*t) =
      Q.simple 0*Q.simple 1 := by
    rw [map_mul]; exact congrArg₂ (·*·) (c.reflections 0).class_eq (c.reflections 1).class_eq
  have h := c.relations.ten_two_ii_left (s*t)
  change ⁅rightConjugate (simpleRoot Q split 1) ((s*t : Q.tits.N) : X ⧸ Q.D),
    rightConjugate (rootAt Q split 1 (Q.simple 0*Q.simple 1)) ((s*t : Q.tits.N) : X ⧸ Q.D)⁆ =
    rightConjugate (rootAt Q split 0 (Q.simple 1)) ((s*t : Q.tits.N) : X ⧸ Q.D) at h
  rw [←rootAt_eq Q split 1 _ (s*t) hst,
    rootAt_right Q split 1 _ _ (s*t) hst,rootAt_right Q split 0 _ _ (s*t) hst] at h
  have hperp : rootAt Q split 1 ((Q.simple 0*Q.simple 1)*(Q.simple 0*Q.simple 1)) =
      positiveRoot Q split (.inr 1) := by
    rw [←mul_assoc,←rootAt_right Q split 1 _ _ t (c.reflections 1).class_eq]
    exact perpendicular_root_stable Q split c.rotation_eight 1 0 (by decide) t
      (c.reflections 1).class_eq
  rw [hperp] at h
  have h : ⁅positiveRoot Q split (.inr 3),positiveRoot Q split (.inr 1)⁆ =
      positiveRoot Q split (.inl 3) := by
    simpa only [positiveRoot,positiveKind,positiveWord,Matrix.cons_val,Fin.isValue,
      Matrix.head_cons,mul_assoc] using h
  rw [←h]
  exact commutator_mono (positiveRoot_le_remainder Q split c _ 0 (by decide))
    (positiveRoot_le_remainder Q split c _ 0 (by decide))

include c in
theorem shiftedOmega_le_linearDerived :
    omegaOneAmbient (positiveRoot Q split (.inr 3)) ≤ linearDerived Q split := by
  have h := c.relations.ten_two_iii_left 1
  change ⁅nConj (simpleRoot Q split 1) 1,nConj (positiveRoot Q split (.inl 3)) 1⁆ =
    nConj (omegaOneAmbient (positiveRoot Q split (.inr 3))) 1 at h
  simp only [nConj,OneMemClass.coe_one,rightConjugate_one] at h
  rw [←h]
  exact commutator_mono
    (by simpa only [positiveRoot,positiveKind,positiveWord,Matrix.cons_val,
      Fin.isValue,Matrix.head_cons,rootAt_one] using
      positiveRoot_le_remainder Q split c (.inr 0) 0 (by decide))
    (positiveRoot_le_remainder Q split c (.inl 3) 0 (by decide))

include c in
theorem perpendicularOmega_le_linearDerived :
    omegaOneAmbient (positiveRoot Q split (.inr 1)) ≤ linearDerived Q split := by
  let s := (c.reflections 0).val
  have h := c.relations.ten_two_iii_left s
  change ⁅rightConjugate (simpleRoot Q split 1) (s : X ⧸ Q.D),
    rightConjugate (rootAt Q split 0 (Q.simple 1*Q.simple 0*Q.simple 1)) (s : X ⧸ Q.D)⁆ =
    rightConjugate (omegaOneAmbient (rootAt Q split 1 (Q.simple 0*Q.simple 1))) (s : X ⧸ Q.D) at h
  rw [←rootAt_eq Q split 1 _ s (c.reflections 0).class_eq,
    perpendicular_root_stable Q split c.rotation_eight 0 1 (by decide) s (c.reflections 0).class_eq,
    conjugate_omega,rootAt_right Q split 1 _ _ s (c.reflections 0).class_eq] at h
  change ⁅positiveRoot Q split (.inr 2),positiveRoot Q split (.inl 3)⁆ =
    omegaOneAmbient (positiveRoot Q split (.inr 1)) at h
  rw [←h]
  exact commutator_mono (positiveRoot_le_remainder Q split c _ 0 (by decide))
    (positiveRoot_le_remainder Q split c _ 0 (by decide))

include c in
/-- The first derived-subgroup bound on printed p.222, including q = 2. -/
theorem linearDerivedSeed_le : linearDerivedSeed Q split ≤ linearDerived Q split :=
  sup_le (sup_le (sup_le (sup_le (nextLinear_le_linearDerived Q split c)
    (perpendicularOmega_le_linearDerived Q split c)) (perpendicularLinear_le_linearDerived Q split c))
    (shiftedOmega_le_linearDerived Q split c)) (reflectedLinear_le_linearDerived Q split c)

/-- Membership in the ambient derived radical is detected by the literal
abelianization of the subgroup, not by an ambient quotient of X/D. -/
theorem linearDerived_abelianization_iff (v : simpleRemainder Q split 0) :
    Abelianization.of v = 1 ↔ (v : X ⧸ Q.D) ∈ linearDerived Q split := by
  change v ∈ (Abelianization.of : simpleRemainder Q split 0 →*
    Abelianization (simpleRemainder Q split 0)).ker ↔ _
  rw [Abelianization.ker_of]
  rw [linearDerived,←map_subtype_commutator]
  exact (mem_map_iff_mem (simpleRemainder Q split 0).subtype_injective).symm

include c in
/-- Strip the three already derived linear factors from the actual five-root
commutator support. The two remaining Suzuki factors retain their order. -/
theorem linearDerived_interior_strip
    (a : positiveRoot Q split (.inl 2)) (b : positiveRoot Q split (.inr 1))
    (d : positiveRoot Q split (.inl 3)) (e : positiveRoot Q split (.inr 3))
    (f : positiveRoot Q split (.inl 1))
    (h : (a : X ⧸ Q.D)*b*d*e*f ∈ linearDerived Q split) :
    (b : X ⧸ Q.D)*e ∈ linearDerived Q split := by
  let a' := inclusion (positiveRoot_le_remainder Q split c (.inl 2) 0 (by decide)) a
  let b' := inclusion (positiveRoot_le_remainder Q split c (.inr 1) 0 (by decide)) b
  let d' := inclusion (positiveRoot_le_remainder Q split c (.inl 3) 0 (by decide)) d
  let e' := inclusion (positiveRoot_le_remainder Q split c (.inr 3) 0 (by decide)) e
  let f' := inclusion (positiveRoot_le_remainder Q split c (.inl 1) 0 (by decide)) f
  have ha : Abelianization.of a' = 1 := (linearDerived_abelianization_iff Q split a').mpr
    (nextLinear_le_linearDerived Q split c a.property)
  have hd : Abelianization.of d' = 1 := (linearDerived_abelianization_iff Q split d').mpr
    (perpendicularLinear_le_linearDerived Q split c d.property)
  have hf : Abelianization.of f' = 1 := (linearDerived_abelianization_iff Q split f').mpr
    (reflectedLinear_le_linearDerived Q split c f.property)
  have hh := (linearDerived_abelianization_iff Q split (a'*b'*d'*e'*f')).mpr h
  simp only [map_mul,ha,hd,hf,one_mul,mul_one] at hh
  exact (linearDerived_abelianization_iff Q split (b'*e')).mp (by simpa only [map_mul] using hh)

end Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.ReeSection10
