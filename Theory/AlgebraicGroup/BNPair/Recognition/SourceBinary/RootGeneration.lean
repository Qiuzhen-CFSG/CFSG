module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.RootCoordinates.OrderedProducts
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.NormalGeneration

/-!
# Generation by the actual Weyl root subgroups

For a finite split rank-two marked quotient, let V be generated by the
N-conjugates of its two canonical simple roots. Ordered positive products
put U in V. The actual N normalizes V; B = U(B ∩ N) then normalizes V as
well, so the BN generation axiom makes V normal in the whole quotient.
Consequently V is exactly the normal closure of U, hence O^{2′}(Y).

This proves generation from explicit root ranges without assuming a Lie
row, a permitted Weyl order, or compatible field operations. Normalizing
by the full N also shows that one lift per Weyl class suffices. The ordered
containment lemma needs no normality of its target and applies to positive
root parameters in a presentation.

Source: Carter 2.5.10–2.5.17, refs/KGroup/GLS3/Chapter2Ca2.tex; the minimal
reduction in DGS, Groups and Graphs, Part II, pp.80–81 and Theorem D, p.224.
-/

public noncomputable section
open Subgroup
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootGeneration
open RootCoordinates
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P) (split : SplitData Q.tits)

/-- The subgroup generated by actual N-conjugates of the two simple roots. -/
@[expose] def weylRootSpan : Subgroup (X ⧸ Q.D) :=
  closure {x | ∃ (i : Fin 2) (n : Q.tits.N) (r : simpleRoot Q split i),
    (n : X ⧸ Q.D)⁻¹ * r * n = x}

theorem conjugate_le_weylRootSpan (i : Fin 2) (n : Q.tits.N) :
    rightConjugate (simpleRoot Q split i) (n : X ⧸ Q.D) ≤ weylRootSpan Q split := by
  intro x hx
  exact subset_closure ⟨i, n, ⟨(n : X ⧸ Q.D)*x*(n : X ⧸ Q.D)⁻¹, hx⟩,
    by simp only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one]⟩

theorem weylRootSpan_eq_iSup :
    weylRootSpan Q split = ⨆ (i : Fin 2) (n : Q.tits.N),
      rightConjugate (simpleRoot Q split i) (n : X ⧸ Q.D) := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro x ⟨i,n,r,rfl⟩
    have hle : rightConjugate (simpleRoot Q split i) (n : X ⧸ Q.D) ≤
        ⨆ (j : Fin 2) (m : Q.tits.N),
          rightConjugate (simpleRoot Q split j) (m : X ⧸ Q.D) :=
      le_iSup_of_le i (le_iSup_of_le n le_rfl)
    apply hle
    change (n : X ⧸ Q.D)*((n : X ⧸ Q.D)⁻¹*r*n)*(n : X ⧸ Q.D)⁻¹ ∈ simpleRoot Q split i
    simpa only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one] using r.property
  · exact iSup_le fun i => iSup_le fun n => conjugate_le_weylRootSpan Q split i n

/-- It suffices to use one lift of each actual Weyl class. -/
theorem weylRootSpan_eq_iSup_weyl :
    weylRootSpan Q split = ⨆ (i : Fin 2) (w : Weyl Q),
      rightConjugate (simpleRoot Q split i) (representative w : X ⧸ Q.D) := by
  rw [weylRootSpan_eq_iSup]
  apply le_antisymm
  · apply iSup_le
    intro i
    apply iSup_le
    intro n
    let w : Weyl Q := QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) n
    have he := rightConjugate_eq_of_quotient_eq (simpleRoot Q split i)
      (torus_normalizes_simpleRoot Q split i) n (representative w)
      (representative_spec w).symm
    rw [he]
    exact le_iSup_of_le i (le_iSup_of_le w le_rfl)
  · exact iSup_le fun i => iSup_le fun w =>
      le_iSup_of_le i (le_iSup_of_le (representative w) le_rfl)

/-- Ordered positive-root containment suffices without normality of the target. -/
theorem unipotent_le_of_orderedRoots_le (K : Subgroup (X ⧸ Q.D)) (b : Bool)
    (hK : ∀ A ∈ orderedRoots Q split b (rotationOrder Q), A ≤ K) : split.U ≤ K := by
  intro x hx
  obtain ⟨p,hp⟩ := (unipotentOrderedCoordinates Q split b).surjective ⟨x,hx⟩
  have hm := rootProduct_mem (orderedRoots Q split b (rotationOrder Q)) K hK p
  have he : rootProduct (orderedRoots Q split b (rotationOrder Q)) p = x :=
    (unipotentOrderedCoordinates_apply Q split b p).symm.trans (congrArg Subtype.val hp)
  rwa [he] at hm

theorem unipotent_le_weylRootSpan : split.U ≤ weylRootSpan Q split := by
  apply unipotent_le_of_orderedRoots_le Q split _ false
  intro A hA
  obtain ⟨i,n,rfl⟩ := orderedRoots_are_simple_conjugates Q split false _ A hA
  exact conjugate_le_weylRootSpan Q split i n

theorem N_normalizes_weylRootSpan :
    Q.tits.N ≤ normalizer (weylRootSpan Q split : Set (X ⧸ Q.D)) := by
  apply le_normalizer_closure_iff.mpr
  rintro g hg x ⟨i,n,r,rfl⟩
  exact subset_closure ⟨i, n * (⟨g,hg⟩ : Q.tits.N)⁻¹, r, by
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, mul_inv_rev, inv_inv, mul_assoc]⟩

theorem borel_normalizes_weylRootSpan :
    Q.tits.B ≤ normalizer (weylRootSpan Q split : Set (X ⧸ Q.D)) := by
  rw [← split.factorization]
  exact sup_le ((unipotent_le_weylRootSpan Q split).trans le_normalizer)
    (inf_le_right.trans (N_normalizes_weylRootSpan Q split))

instance weylRootSpan_normal : (weylRootSpan Q split).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← Q.tits.generate]
  exact (closure_le _).mpr (Set.union_subset (borel_normalizes_weylRootSpan Q split)
    (N_normalizes_weylRootSpan Q split))

/-- No perfectness is needed: the root span equals the normal closure of U. -/
theorem weylRootSpan_eq_unipotentClosure : weylRootSpan Q split = split.unipotentClosure := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro x ⟨i,n,r,rfl⟩
    change (n : X ⧸ Q.D)⁻¹ * r * n ∈ split.unipotentClosure
    have hr : (r : X ⧸ Q.D) ∈ split.unipotentClosure :=
      le_normalClosure (simpleRoot_le Q split i r.property)
    have hc := (inferInstance : split.unipotentClosure.Normal).conj_mem _ hr (n : X ⧸ Q.D)⁻¹
    simpa only [inv_inv] using hc
  · exact normalClosure_le_normal (unipotent_le_weylRootSpan Q split)

/-- The same statement in the residual convention used by the source. -/
theorem weylRootSpan_eq_primeToResidual :
    weylRootSpan Q split = primeToResidual 2 (X ⧸ Q.D) :=
  (weylRootSpan_eq_unipotentClosure Q split).trans split.unipotentClosure_eq_primeToResidual

/-- A subgroup containing the marked Weyl roots contains the actual U. -/
theorem unipotent_le_of_conjugates_le (K : Subgroup (X ⧸ Q.D))
    (hK : ∀ (i : Fin 2) (n : Q.tits.N),
      rightConjugate (simpleRoot Q split i) (n : X ⧸ Q.D) ≤ K) : split.U ≤ K := by
  apply (unipotent_le_weylRootSpan Q split).trans
  rw [weylRootSpan_eq_iSup]
  exact iSup_le fun i => iSup_le fun n => hK i n

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootGeneration
