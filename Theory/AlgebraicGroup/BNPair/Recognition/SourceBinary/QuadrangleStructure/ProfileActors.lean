/-!
# Full linear actors on the same marked quadrangle

The local closure generated by U and its reflected conjugate is the
prime-to-two residual of its parabolic. The earlier source reflection
inside R supplies the Bruhat cell, and the full Cartan normalizes both
unipotent factors. Its two-core is precisely the complementary section.
The proved root-cover isomorphism therefore identifies the FULL R with
this residual modulo its two-core, retaining the inclusion on representatives.

A normal original actor with a binary SL2 quotient and two-group kernel
is that same residual once it contains the parabolic Sylow. This uses
transvection generation, including SL2(2), without perfectness. Finally,
a centerless full-actor marking identifies the faithful panel image via
the actual projection. No unitary scalar kernel is discarded.

Source: Fong--Seitz I (5B)--(5C), (6A), pp.25--26,37--38; DGS,
Groups and Graphs (1985), original actors in (10.5), (11.7)--(11.8).
The CFSG ProfileActors and EqualLinearActors applications supply the
literal original endpoint and actor markings.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.QuadrangleStructure
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P) (split : SplitData Q.tits)

/-- The full Cartan supplements the local root closure. -/
theorem localClosure_sup_torus (i : Fin 2) (s : RootReflection Q split i) :
    localClosure Q split i ⊔ (Q.tits.B ⊓ Q.tits.N) = Q.tits.standardParabolic {Q.simple i} := by
  have hB : Q.tits.B ≤ localClosure Q split i ⊔ (Q.tits.B ⊓ Q.tits.N) := by
    nth_rw 1 [←split.factorization]
    exact sup_le_sup le_sup_left le_rfl
  apply le_antisymm (sup_le (localClosure_le_parabolic Q split i)
    (inf_le_left.trans (Q.tits.B_le_standardParabolic _)))
  apply Q.tits.standardParabolic_le _ hB
  intro w hw
  have hw' : w = Q.simple i := Set.mem_singleton_iff.mp hw
  subst w
  exact Q.tits.bruhatCell_subset_of_mem _ hB
    (Q.tits.representative_mem_bruhatCell _ s.val s.class_eq)
    ((show localClosure Q split i ≤ localClosure Q split i ⊔ (Q.tits.B ⊓ Q.tits.N) from le_sup_left)
      (rankOne_le_localClosure Q split i s.mem_rankOne))

/-- Relative normality of the closure of the two actual full unipotent subgroups. -/
theorem localClosure_parabolic_normalizes (i : Fin 2) (s : RootReflection Q split i) :
    Q.tits.standardParabolic {Q.simple i} ≤ normalizer (localClosure Q split i : Set (X ⧸ Q.D)) := by
  rw [←localClosure_sup_torus Q split i s]
  apply sup_le (localClosure Q split i).le_normalizer
  exact (le_inf (inf_le_left.trans split.normalizes)
    (torus_normalizes_rightConjugate split.U (inf_le_left.trans split.normalizes)
      (representative (Q.simple i)))).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)

/-- The full local closure is O^{2'} of the marked parabolic. -/
theorem localClosure_eq_primeToResidual (i : Fin 2) (s : RootReflection Q split i) :
    (localClosure Q split i).subgroupOf (Q.tits.standardParabolic {Q.simple i}) =
      primeToResidual 2 (Q.tits.standardParabolic {Q.simple i}) := by
  let E := Q.tits.standardParabolic {Q.simple i}
  let C := (localClosure Q split i).subgroupOf E
  let T : Sylow 2 E := split.sylow.subtype (split.U_le.trans (Q.tits.B_le_standardParabolic _))
  let : C.Normal := normal_subgroupOf_of_le_normalizer (localClosure_parabolic_normalizes Q split i s)
  apply le_antisymm
  · rw [localClosure,subgroupOf_sup
      (split.U_le.trans (Q.tits.B_le_standardParabolic _))
      ((show unipotentConjugate split (Q.simple i) ≤ localClosure Q split i from le_sup_right).trans
        (localClosure_le_parabolic Q split i))]
    apply sup_le
    · exact le_primeToResidual_of_isPGroup split.isTwo.comap_subtype
    · exact le_primeToResidual_of_isPGroup
        ((split.isTwo.comap_of_injective (MulAut.conj (representative (Q.simple i) : X ⧸ Q.D)).toMonoidHom
          (MulAut.conj _).injective).comap_subtype)
  · apply primeToResidual_le C
    exact (Nat.prime_two.coprime_iff_not_dvd.mpr T.not_dvd_index).of_dvd_right
      (index_dvd_of_le (subgroupOf_mono E (show split.U ≤ localClosure Q split i from le_sup_left)))

theorem localClosure_core (i : Fin 2) (s : RootReflection Q split i)
    (hV : simpleRemainder Q split i ≤ localKernel Q i) :
    pCore 2 (localClosure Q split i) = LocalCover.radicalInClosure Q split i := by
  let E := Q.tits.standardParabolic {Q.simple i}
  have hUE : split.U ≤ E := split.U_le.trans (Q.tits.B_le_standardParabolic _)
  have hcoreU : E.pCoreIn 2 ≤ split.U := by
    have hh := pCoreIn_le_sylow E (split.sylow.subtype hUE)
    change E.pCoreIn 2 ≤ (split.U.subgroupOf E).map E.subtype at hh
    rwa [map_subgroupOf_eq_of_le hUE] at hh
  have hcore : (localClosure Q split i).pCoreIn 2 ≤ E.pCoreIn 2 :=
    pCoreIn_mono_of_normalizes (localClosure_le_parabolic Q split i)
      (localClosure_parabolic_normalizes Q split i s)
  apply le_antisymm
  · intro x hx
    have hx' := hcore (mem_map_of_mem (localClosure Q split i).subtype hx)
    have hv := parabolic_core_le_remainder Q split i hcoreU hx'
    exact ⟨hv.1,hV hv⟩
  · exact le_sSup ⟨inferInstance, (split.isTwo.to_le (show LocalCover.radical Q split i ≤ split.U from inf_le_left)).comap_subtype⟩

/-- Restriction of the endpoint inclusion to its prime-to-two residual. -/
def localClosureResidualEquiv (i : Fin 2) (s : RootReflection Q split i) :
    localClosure Q split i ≃* primeToResidual 2 (Q.tits.standardParabolic {Q.simple i}) :=
  (subgroupOfEquivOfLe (localClosure_le_parabolic Q split i)).symm.trans
    (MulEquiv.subgroupCongr (localClosure_eq_primeToResidual Q split i s))

@[simp] theorem localClosureResidualEquiv_apply (i : Fin 2) (s : RootReflection Q split i)
    (c : localClosure Q split i) :
    ((localClosureResidualEquiv Q split i s c : Q.tits.standardParabolic {Q.simple i}) : X ⧸ Q.D) = c := by rfl

/-- Identify the full root-generated group with the original local residual modulo its core. -/
def rankOneResidualCoreEquiv (i : Fin 2) (s : RootReflection Q split i)
    (hV : simpleRemainder Q split i ≤ localKernel Q i) :
    rankOne Q split i ≃*
      (primeToResidual 2 (Q.tits.standardParabolic {Q.simple i}) ⧸
        pCore 2 (primeToResidual 2 (Q.tits.standardParabolic {Q.simple i}))) :=
  (RootLocalCover.coverEquiv Q split i hV).trans
    ((QuotientGroup.quotientMulEquivOfEq (localClosure_core Q split i s hV).symm).trans
      (LocalCoreTransport.quotientEquiv 2 (localClosureResidualEquiv Q split i s)))

@[simp] theorem rankOneResidualCoreEquiv_apply (i : Fin 2) (s : RootReflection Q split i)
    (hV : simpleRemainder Q split i ≤ localKernel Q i) (r : rankOne Q split i) :
    rankOneResidualCoreEquiv Q split i s hV r = QuotientGroup.mk'
      (pCore 2 (primeToResidual 2 (Q.tits.standardParabolic {Q.simple i})))
      (localClosureResidualEquiv Q split i s (inclusion (rankOne_le_localClosure Q split i) r)) := by
  simp only [rankOneResidualCoreEquiv, MulEquiv.trans_apply, RootLocalCover.coverEquiv_apply]
  rfl

/-- An actual binary SL2 quotient with a two-group kernel is generated by two-elements,
including SL2(2). -/
theorem linear_cover_primeToResidual_top {A F : Type*} [Group A] [Finite A] [Field F] [CharP F 2]
    (f : A →* Matrix.SpecialLinearGroup (Fin 2) F) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) : primeToResidual 2 A = ⊤ := by
  have ht : primeToResidual 2 (Matrix.SpecialLinearGroup (Fin 2) F) = ⊤ := by
    apply top_unique
    intro x _
    exact Matrix.SL2.map_mem_primeToResidual 2 (MonoidHom.id _) x
  have hm := congrArg (Subgroup.comap f) (map_primeToResidual_of_surjective 2 f hf)
  rw [comap_map_eq,ht,comap_top,sup_eq_left.mpr (le_primeToResidual_of_isPGroup hk)] at hm
  exact hm

/-- A normal binary linear local actor containing the specified Sylow is the
whole prime-to-two residual, with no perfectness assumption. -/
theorem linear_actor_eq_residual {A F : Type*} [Group A] [Finite A]
    [Field F] [CharP F 2] (J : Subgroup A) [J.Normal] (T : Sylow 2 A)
    (hT : (T : Subgroup A) ≤ J)
    (f : J →* Matrix.SpecialLinearGroup (Fin 2) F) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) : J = primeToResidual 2 A := by
  apply le_antisymm
    (le_primeToResidual_of_eq_top 2 J (linear_cover_primeToResidual_top f hf hk))
  apply primeToResidual_le
  exact (Nat.prime_two.coprime_iff_not_dvd.mpr T.not_dvd_index).of_dvd_right
    (index_dvd_of_le hT)

/-- The full root actor's linear marking also identifies its faithful panel image. -/
def localGroupEquivOfCenterless (i : Fin 2)
    (hV : simpleRemainder Q split i ≤ localKernel Q i)
    {A : Type*} [Group A] (μ : rankOne Q split i ≃* A) (hA : center A = ⊥) :
    localGroup Q split i ≃* A := by
  have hk : (RootLocalCover.projection Q split i).ker = ⊥ := by
    apply eq_bot_iff.mpr
    intro x hx
    have hz : μ x ∈ center A := by
      apply mem_center_iff.mpr
      intro a
      obtain ⟨y,rfl⟩ := μ.surjective a
      simpa only [map_mul] using congrArg μ
        (mem_center_iff.mp (RootLocalCover.projection_ker_central Q split i hx) y)
    rw [hA,mem_bot] at hz
    exact mem_bot.mpr (μ.map_eq_one_iff.mp hz)
  exact (MulEquiv.ofBijective (RootLocalCover.projection Q split i)
    ⟨(MonoidHom.ker_eq_bot_iff _).mp hk,
      (RootLocalCover.central_odd_cover Q split i hV).1⟩).symm.trans μ

@[simp] theorem localGroupEquivOfCenterless_projection (i : Fin 2)
    (hV : simpleRemainder Q split i ≤ localKernel Q i)
    {A : Type*} [Group A] (μ : rankOne Q split i ≃* A) (hA : center A = ⊥)
    (r : rankOne Q split i) :
    localGroupEquivOfCenterless Q split i hV μ hA (RootLocalCover.projection Q split i r) = μ r := by
  simp only [localGroupEquivOfCenterless, MulEquiv.trans_apply]
  exact congrArg μ ((MulEquiv.ofBijective (RootLocalCover.projection Q split i) _).symm_apply_apply r)

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.QuadrangleStructure
