module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.HexagonStructure.LocalActions
public import Theory.GroupTheory.Commutator.RelativeGeneration
public import Mathlib.GroupTheory.Abelianization.Defs

/-!
# The actual local central odd cover

For a finite marked split rank-two quotient, let Kᵢ be the full kernel of
Pᵢ acting on Pᵢ/B and Cᵢ = ⟨U,U^{sᵢ}⟩. The intersection Vᵢ = U ∩ Kᵢ
is O₂(Kᵢ), embedded in the same quotient, and is normal in Pᵢ. Since
[U,Kᵢ] ≤ Vᵢ and the chosen simple lift preserves Vᵢ and Kᵢ, also
[Cᵢ,Kᵢ] ≤ Vᵢ. Thus the literal action factors through Cᵢ/Vᵢ with
central kernel (Kᵢ ∩ Cᵢ)/Vᵢ. The normal Sylow of B makes that kernel
odd. Every abelian image of Cᵢ is generated by two two-subgroups, so
is a two-group; consequently the odd kernel lies in the derived group.

This proves Fong--Seitz I, (5B), printed p.25 (PDF p.25), including
its covering-group condition for nonperfect groups. It uses the same
local action and full kernel as HexagonStructure.LocalActions. No
identification of Kᵢ with O₂(Pᵢ), of an original factor with the
root-generated Rᵢ, or of the local permutation group with a Lie model
is assumed. Those catalogue and smaller-root transports remain separate.
-/

public noncomputable section
open Subgroup
open scoped commutatorElement
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.LocalCover
open RootCoordinates HexagonStructure
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P) (split : SplitData Q.tits)

@[expose] def radical (i : Fin 2) : Subgroup (X ⧸ Q.D) := split.U ⊓ localKernel Q i

theorem kernel_twoCore (i : Fin 2) :
    pCore 2 (localKernel Q i) = split.U.subgroupOf (localKernel Q i) := by
  have hn := (localKernel_le_borel Q i).trans split.normalizes
  let : (split.U.subgroupOf (localKernel Q i)).Normal :=
    normal_subgroupOf_of_le_normalizer hn
  apply le_antisymm
  · intro x hx
    exact two_subgroup_le_unipotent split _ (pCore_isPGroup.map (localKernel Q i).subtype)
      ((map_subtype_le _).trans (localKernel_le_borel Q i)) ⟨x,hx,rfl⟩
  · exact le_sSup ⟨inferInstance, split.isTwo.comap_subtype⟩

theorem radical_eq_core_image (i : Fin 2) :
    radical Q split i = (pCore 2 (localKernel Q i)).map (localKernel Q i).subtype := by
  rw [kernel_twoCore Q split i, subgroupOf_map_subtype]
  rfl

theorem radical_parabolic_normalizes (i : Fin 2) :
    Q.tits.standardParabolic {Q.simple i} ≤ normalizer (radical Q split i : Set _) := by
  rw [radical_eq_core_image]
  apply le_normalizer_iff.mpr
  intro g hg x hx
  obtain ⟨y,hy,rfl⟩ := hx
  let f := (localKernel Q i).normalizerMonoidHom
    ⟨g,localKernel_parabolic_normalizes Q i hg⟩
  have hfy : f y ∈ pCore 2 (localKernel Q i) :=
    characteristic_iff_le_comap.mp inferInstance f hy
  exact ⟨f y,hfy,rfl⟩

private theorem simple_lift_mem (i : Fin 2) :
    (representative (Q.simple i) : X ⧸ Q.D) ∈ Q.tits.standardParabolic {Q.simple i} :=
  Q.tits.bruhatCell_subset_standardParabolic_of_mem (Set.mem_singleton _)
    (Q.tits.representative_mem_bruhatCell _ _ (representative_spec _))

theorem unipotent_kernel_commutator (i : Fin 2) :
    ⁅split.U,localKernel Q i⁆ ≤ radical Q split i := by
  exact le_inf
    (le_normalizer_iff_commutator_le_left.mp
      ((localKernel_le_borel Q i).trans split.normalizes))
    (le_normalizer_iff_commutator_le_right.mp
      ((split.U_le.trans (Q.tits.B_le_standardParabolic _)).trans
        (localKernel_parabolic_normalizes Q i)))

theorem conjugate_unipotent_kernel_commutator (i : Fin 2) :
    ⁅unipotentConjugate split (Q.simple i),localKernel Q i⁆ ≤ radical Q split i := by
  let n := representative (Q.simple i)
  apply commutator_le.mpr
  intro u hu k hk
  have hk' : (n : X ⧸ Q.D)*k*(n : X ⧸ Q.D)⁻¹ ∈ localKernel Q i :=
    (mem_normalizer_iff.mp (localKernel_parabolic_normalizes Q i (simple_lift_mem Q i)) k).mp hk
  have hh := unipotent_kernel_commutator Q split i (commutator_mem_commutator hu hk')
  have he : ⁅(n : X ⧸ Q.D)*u*(n : X ⧸ Q.D)⁻¹,
      (n : X ⧸ Q.D)*k*(n : X ⧸ Q.D)⁻¹⁆ =
      (n : X ⧸ Q.D)*⁅u,k⁆*(n : X ⧸ Q.D)⁻¹ := by
    exact (map_commutatorElement (MulAut.conj (n : X ⧸ Q.D)).toMonoidHom u k).symm
  change ⁅(n : X ⧸ Q.D)*u*(n : X ⧸ Q.D)⁻¹,
    (n : X ⧸ Q.D)*k*(n : X ⧸ Q.D)⁻¹⁆ ∈ radical Q split i at hh
  rw [he] at hh
  exact (mem_normalizer_iff.mp
    (radical_parabolic_normalizes Q split i (simple_lift_mem Q i)) ⁅u,k⁆).mpr hh

theorem localClosure_kernel_commutator (i : Fin 2) :
    ⁅localClosure Q split i,localKernel Q i⁆ ≤ radical Q split i := by
  exact commutator_sup_le_of_relative_normal (Q.tits.standardParabolic {Q.simple i})
    _ _ _ _ (radical_parabolic_normalizes Q split i)
    ((show split.U ≤ localClosure Q split i from le_sup_left).trans
      (localClosure_le_parabolic Q split i))
    ((show unipotentConjugate split (Q.simple i) ≤ localClosure Q split i from le_sup_right).trans
      (localClosure_le_parabolic Q split i))
    (unipotent_kernel_commutator Q split i)
    (conjugate_unipotent_kernel_commutator Q split i)

theorem radical_relative_index_odd (i : Fin 2) (A : Subgroup (X ⧸ Q.D))
    (hA : A ≤ localKernel Q i) : Nat.Coprime 2 ((radical Q split i).relIndex A) := by
  have he : (radical Q split i).subgroupOf A = split.U.subgroupOf A := by
    ext a
    exact and_iff_left (hA a.property)
  change Nat.Coprime 2 ((radical Q split i).subgroupOf A).index
  rw [he]
  let UB := split.U.subgroupOf Q.tits.B
  let : UB.Normal := normal_subgroupOf_of_le_normalizer split.normalizes
  have hd := relIndex_dvd_index_of_normal (H := UB) (A.subgroupOf Q.tits.B)
  rw [relIndex_subgroupOf (hA.trans (localKernel_le_borel Q i))] at hd
  exact (Nat.prime_two.coprime_iff_not_dvd.mpr split.borel_index_not_two).of_dvd_right hd

@[expose] def radicalInClosure (i : Fin 2) : Subgroup (localClosure Q split i) :=
  (radical Q split i).subgroupOf (localClosure Q split i)

instance radicalInClosure_normal (i : Fin 2) : (radicalInClosure Q split i).Normal :=
  normal_subgroupOf_of_le_normalizer ((localClosure_le_parabolic Q split i).trans
    (radical_parabolic_normalizes Q split i))

abbrev CoverGroup (i : Fin 2) := localClosure Q split i ⧸ radicalInClosure Q split i

def projection (i : Fin 2) : CoverGroup Q split i →* (localAction Q split i).range :=
  QuotientGroup.lift _ (localAction Q split i).rangeRestrict (by
    rw [MonoidHom.ker_rangeRestrict, localAction_ker]
    exact fun _ hx => hx.2)

@[simp] theorem projection_mk (i : Fin 2) (x : localClosure Q split i) :
    (projection Q split i (QuotientGroup.mk' _ x) : Equiv.Perm (Panel Q i)) =
      localAction Q split i x := by rfl

theorem projection_surjective (i : Fin 2) : Function.Surjective (projection Q split i) := by
  intro y
  obtain ⟨x,hx⟩ := (localAction Q split i).rangeRestrict_surjective y
  exact ⟨QuotientGroup.mk' _ x,hx⟩

theorem projection_ker (i : Fin 2) : (projection Q split i).ker =
    ((localKernel Q i).subgroupOf (localClosure Q split i)).map
      (QuotientGroup.mk' (radicalInClosure Q split i)) := by
  rw [projection, QuotientGroup.ker_lift, MonoidHom.ker_rangeRestrict, localAction_ker]

theorem projection_ker_central (i : Fin 2) :
    (projection Q split i).ker ≤ center (CoverGroup Q split i) := by
  rw [projection_ker]
  rintro _ ⟨x,hx,rfl⟩
  apply mem_center_iff.mpr
  intro y
  induction y using QuotientGroup.induction_on with
  | H y =>
    apply commutatorElement_eq_one_iff_mul_comm.mp
    change ⁅(QuotientGroup.mk' (radicalInClosure Q split i)) y,
      (QuotientGroup.mk' (radicalInClosure Q split i)) x⁆ = 1
    rw [← map_commutatorElement]
    apply (QuotientGroup.eq_one_iff _).mpr
    exact localClosure_kernel_commutator Q split i
      (commutator_mem_commutator y.property hx)

theorem projection_ker_odd (i : Fin 2) :
    Nat.Coprime 2 (Nat.card (projection Q split i).ker) := by
  rw [projection_ker, ← relIndex_ker, QuotientGroup.ker_mk']
  change Nat.Coprime 2 (((radical Q split i).comap (localClosure Q split i).subtype).relIndex
    ((localKernel Q i).subgroupOf (localClosure Q split i)))
  rw [relIndex_comap, subgroupOf_map_subtype]
  exact radical_relative_index_odd Q split i _ inf_le_left

/-- Any abelian quotient of the whole-root numerator is a two-group. -/
theorem localClosure_abelian_image_isTwo (i : Fin 2) {A : Type*} [CommGroup A]
    (f : localClosure Q split i →* A) (hf : Function.Surjective f) : IsPGroup 2 A := by
  let U := split.U.subgroupOf (localClosure Q split i)
  let V := (unipotentConjugate split (Q.simple i)).subgroupOf (localClosure Q split i)
  have hgen : U ⊔ V = ⊤ := by
    rw [← subgroupOf_sup (show split.U ≤ localClosure Q split i from le_sup_left)
      (show unipotentConjugate split (Q.simple i) ≤ localClosure Q split i from le_sup_right)]
    exact subgroupOf_self _
  have hU : IsPGroup 2 (U.map f) := split.isTwo.comap_subtype.map f
  have hV : IsPGroup 2 (V.map f) :=
    (split.isTwo.comap_of_injective (MulAut.conj
      (representative (Q.simple i) : X ⧸ Q.D)).toMonoidHom
        (MulAut.conj _).injective).comap_subtype.map f
  have ht : IsPGroup 2 (⊤ : Subgroup A) := by
    rw [← map_top_of_surjective f hf, ← hgen, Subgroup.map_sup]
    exact hU.to_sup_of_normal_right hV
  exact ht.of_equiv Subgroup.topEquiv

theorem cover_abelianization_isTwo (i : Fin 2) :
    IsPGroup 2 (Abelianization (CoverGroup Q split i)) := by
  apply localClosure_abelian_image_isTwo Q split i
    (Abelianization.of.comp (QuotientGroup.mk' (radicalInClosure Q split i)))
  exact (QuotientGroup.mk'_surjective (_root_.commutator (CoverGroup Q split i))).comp
    (QuotientGroup.mk'_surjective _)

/-- The central odd kernel lies in the derived subgroup, also in nonperfect cases. -/
theorem projection_ker_le_commutator (i : Fin 2) :
    (projection Q split i).ker ≤ _root_.commutator (CoverGroup Q split i) := by
  let : Finite (Abelianization (CoverGroup Q split i)) :=
    Finite.of_surjective Abelianization.of
      (QuotientGroup.mk'_surjective (_root_.commutator (CoverGroup Q split i)))
  let K := (projection Q split i).ker
  let a : CoverGroup Q split i →* Abelianization (CoverGroup Q split i) := Abelianization.of
  have ho : Nat.Coprime 2 (Nat.card (K.map a)) :=
    (projection_ker_odd Q split i).of_dvd_right (K.card_map_dvd a)
  obtain ⟨n,hn⟩ := ((cover_abelianization_isTwo Q split i).to_subgroup (K.map a)).exists_card_eq
  have hn0 : n = 0 := by
    by_contra hh
    apply Nat.prime_two.coprime_iff_not_dvd.mp ho
    rw [hn]
    exact dvd_pow_self 2 (by omega)
  have hz : K.map a = ⊥ := Subgroup.card_eq_one.mp (by rw [hn,hn0,pow_zero])
  have hle := (Subgroup.map_eq_bot_iff _).mp hz
  change K ≤ Abelianization.of.ker at hle
  rwa [Abelianization.ker_of] at hle

/-- Fong--Seitz I (5B), with the actual map, full kernel and stem condition. -/
theorem central_odd_cover (i : Fin 2) :
    Function.Surjective (projection Q split i) ∧
      (projection Q split i).ker ≤ center (CoverGroup Q split i) ∧
      Nat.Coprime 2 (Nat.card (projection Q split i).ker) ∧
      (projection Q split i).ker ≤ _root_.commutator (CoverGroup Q split i) :=
  ⟨projection_surjective Q split i, projection_ker_central Q split i,
    projection_ker_odd Q split i, projection_ker_le_commutator Q split i⟩

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.LocalCover
