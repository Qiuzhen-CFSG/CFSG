module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.LocalCover

/-!
# The actual smaller root-generated local cover

Let Rᵢ be generated by the canonical simple root and its opposite, and
let Kᵢ be the full panel kernel. Conjugating Rᵢ by the longest Weyl lift
puts it in the opposite marked parabolic. Increasing Bruhat multiplication
then traps Rᵢ intersect Kᵢ inside the actual Cartan B intersect N. Hence
Rᵢ meets U intersect Kᵢ trivially, without a perfectness assumption or a
prescribed Weyl order.

If the earlier local-section containment U_{sᵢ} ≤ Kᵢ holds, the root
product decomposition gives ⟨U,U^{sᵢ}⟩ = Rᵢ(U intersect Kᵢ). Restriction
of the literal quotient map therefore identifies Rᵢ with the existing
central odd cover. Its map to the SAME local permutation group retains
the exact full kernel and the stem condition, including nonperfect cases.

Source: Fong--Seitz I, (5C)(a) and the reduction in (5C)(b), printed
pp.25--26 (PDF pp.25--26). The containment from (2B), classification of
the local permutation groups and their central covers, and the seven
marked Lie comparisons remain separate source obligations.
-/

public noncomputable section
open Subgroup
open scoped Pointwise commutatorElement
namespace Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootLocalCover
open RootCoordinates HexagonStructure
variable {X : Type*} [Group X] {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P) (split : SplitData Q.tits)

private theorem parabolic_inf_ascent_borel
    {s w : Weyl Q} (hs : s ∈ Q.tits.S)
    (hlen : Q.tits.wordLength w ≤ Q.tits.wordLength (s*w)) :
    Q.tits.standardParabolic {s} ⊓ borelConjugate w⁻¹ ≤ Q.tits.B := by
  intro x hx
  have hxcell : x ∈ (Q.tits.B : Set (X ⧸ Q.D)) ∪ Q.tits.bruhatCell s :=
    singleton_parabolic_cells hs ▸ hx.1
  rcases hxcell with hxB | hxS
  · exact hxB
  · let nw := representative w
    have hprod : x * (nw : X ⧸ Q.D) ∈ Q.tits.bruhatCell (s*w) :=
      Q.tits.bruhatCell_mul_bruhatCell_subset_of_wordLength_le hs w hlen
        ⟨x, hxS, nw, Q.tits.representative_mem_bruhatCell w nw (representative_spec _), rfl⟩
    have hx' := hx.2
    rw [borelConjugate_eq w⁻¹ nw⁻¹ (by rw [map_inv, representative_spec])] at hx'
    have hh := mul_mem_doubleCoset Q.tits.B Q.tits.N w Q.tits.B.one_mem hx'
      (Q.tits.representative_mem_bruhatCell w nw (representative_spec _))
    have hsame : x * (nw : X ⧸ Q.D) ∈ Q.tits.bruhatCell w := by
      change 1 * (nw : X ⧸ Q.D) * ((nw : X ⧸ Q.D)⁻¹ * x *
        ((nw : X ⧸ Q.D)⁻¹)⁻¹) ∈ Q.tits.bruhatCell w at hh
      simpa only [Subgroup.coe_inv, inv_inv, one_mul, mul_inv_cancel_left, mul_assoc] using hh
    have he := Q.tits.doubleCoset_index_unique hprod hsame
    exact False.elim ((Q.tits.involutions s hs).1
      (mul_right_cancel (he.trans (one_mul w).symm)))

private theorem exists_opposite_simple (i : Fin 2) :
    ∃ j, longest Q * Q.simple i * longest Q = Q.simple j := by
  have hlen : Q.tits.wordLength (longest Q * Q.simple i * longest Q) = 1 := by
    rw [mul_assoc, length_longest_mul, wordLength_simple_mul_longest]
    have := rotationOrder_ge_two Q
    omega
  obtain ⟨l, hl, hS, he⟩ := Q.tits.wordLength_spec (longest Q * Q.simple i * longest Q)
  rw [hlen] at hl
  obtain ⟨s,rfl⟩ := List.length_eq_one_iff.mp hl
  have hs : s ∈ Q.tits.S := hS s (by simp)
  obtain ⟨j,hj⟩ := Q.simple_range.symm ▸ hs
  exact ⟨j, (show longest Q * Q.simple i * longest Q = s by simpa using he.symm).trans hj.symm⟩

private theorem rankOne_opposite_parabolic (i j : Fin 2)
    (hij : longest Q * Q.simple i * longest Q = Q.simple j)
    (n : Q.tits.N)
    (hn : QuotientGroup.mk' ((Q.tits.B ⊓ Q.tits.N).subgroupOf Q.tits.N) n = longest Q) :
    rightConjugate (rankOne Q split i) (n : X ⧸ Q.D) ≤
      Q.tits.standardParabolic {Q.simple j} := by
  change (simpleRoot Q split i ⊔ rootAt Q split i (Q.simple i)).comap
    (MulAut.conj (n : X ⧸ Q.D)).toMonoidHom ≤ _
  rw [← comap_sup_eq _ _ _ (MulAut.conj (n : X ⧸ Q.D)).surjective]
  have hU := split.U_le.trans (Q.tits.B_le_standardParabolic {Q.simple j})
  have hconj : unipotentConjugate split (Q.simple j) ≤
      Q.tits.standardParabolic {Q.simple j} :=
    (show unipotentConjugate split (Q.simple j) ≤ localClosure Q split j from le_sup_right).trans
      (localClosure_le_parabolic Q split j)
  have hXi : simpleRoot Q split i ≤ unipotentConjugate split (longest Q * Q.simple i) := inf_le_right
  apply sup_le
  · have hc := comap_mono (f := (MulAut.conj (n : X ⧸ Q.D)).toMonoidHom) hXi
    change _ ≤ rightConjugate (unipotentConjugate split (longest Q * Q.simple i)) _ at hc
    rw [unipotentConjugate_right split _ _ n hn, hij] at hc
    exact hc.trans hconj
  · have hc := comap_mono (f := (MulAut.conj
        (representative (Q.simple i) : X ⧸ Q.D)).toMonoidHom) hXi
    change rootAt Q split i (Q.simple i) ≤
      rightConjugate (unipotentConjugate split (longest Q * Q.simple i)) _ at hc
    rw [unipotentConjugate_right split _ _ _ (representative_spec _)] at hc
    have hs : Q.simple i * Q.simple i = 1 := by
      simpa only [pow_two] using (Q.tits.involutions _ (Q.simple_mem i)).2
    rw [mul_assoc, hs, mul_one] at hc
    have hc' := comap_mono (f := (MulAut.conj (n : X ⧸ Q.D)).toMonoidHom) hc
    change _ ≤ rightConjugate (unipotentConjugate split (longest Q)) _ at hc'
    rw [unipotentConjugate_right split _ _ n hn, longest_mul_self, unipotentConjugate_one] at hc'
    exact hc'.trans hU

/-- The actual root-generated local kernel lies in the full Cartan. -/
theorem rankOne_inf_kernel_le_torus (i : Fin 2) :
    rankOne Q split i ⊓ localKernel Q i ≤ Q.tits.B ⊓ Q.tits.N := by
  obtain ⟨j,hij⟩ := exists_opposite_simple Q i
  let n := representative (longest Q)
  have hn := representative_spec (longest Q)
  have hss : Q.simple i * Q.simple i = 1 := by
    simpa only [pow_two] using (Q.tits.involutions _ (Q.simple_mem i)).2
  have hi : (Q.simple i)⁻¹ = Q.simple i := inv_eq_of_mul_eq_one_right hss
  have hw : Q.simple j * (longest Q * Q.simple i) = longest Q := by
    rw [← hij]
    simp only [mul_assoc, ← mul_assoc (longest Q) (longest Q), longest_mul_self,
      one_mul, hss, mul_one]
  have hlen : Q.tits.wordLength (longest Q * Q.simple i) ≤
      Q.tits.wordLength (Q.simple j * (longest Q * Q.simple i)) := by
    rw [hw, wordLength_longest_mul_simple, wordLength_longest]
    exact Nat.sub_le _ _
  intro x hx
  let y := (n : X ⧸ Q.D)⁻¹ * x * (n : X ⧸ Q.D)
  have hyR : y ∈ rightConjugate (rankOne Q split i) (n : X ⧸ Q.D) := by
    change (n : X ⧸ Q.D) * ((n : X ⧸ Q.D)⁻¹ * x * (n : X ⧸ Q.D)) *
      (n : X ⧸ Q.D)⁻¹ ∈ rankOne Q split i
    simpa only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one] using
      (show x ∈ rankOne Q split i from hx.1)
  have hyP := rankOne_opposite_parabolic Q split i j hij n hn hyR
  have hyB : y ∈ borelConjugate (longest Q * Q.simple i)⁻¹ := by
    let ns := representative (Q.simple i)
    rw [mul_inv_rev, hi, longest_inv,
      borelConjugate_eq (Q.simple i * longest Q) (ns*n)
        (by rw [map_mul, representative_spec, hn])]
    have hxB := localKernel_le_conjugate_borel Q i hx.2
    change (ns : X ⧸ Q.D) * x * (ns : X ⧸ Q.D)⁻¹ ∈ Q.tits.B at hxB
    change ((ns : X ⧸ Q.D) * (n : X ⧸ Q.D)) *
      ((n : X ⧸ Q.D)⁻¹ * x * (n : X ⧸ Q.D)) *
      ((ns : X ⧸ Q.D) * (n : X ⧸ Q.D))⁻¹ ∈ Q.tits.B
    simpa only [mul_inv_rev, mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one] using hxB
  have hy := parabolic_inf_ascent_borel Q (Q.simple_mem j) hlen ⟨hyP,hyB⟩
  rw [← borel_inf_opposite Q split]
  refine ⟨localKernel_le_borel Q i hx.2, ?_⟩
  rw [borelConjugate_eq (longest Q) n⁻¹ (by rw [map_inv, hn, longest_inv])]
  change (n : X ⧸ Q.D)⁻¹ * x * ((n : X ⧸ Q.D)⁻¹)⁻¹ ∈ Q.tits.B
  simpa only [inv_inv] using hy

theorem rankOne_disjoint_radical (i : Fin 2) :
    Disjoint (rankOne Q split i) (LocalCover.radical Q split i) := by
  apply disjoint_def.mpr
  intro x hx hr
  apply mem_bot.mp
  rw [← split.unipotent_inf_N]
  exact ⟨hr.1, (rankOne_inf_kernel_le_torus Q split i ⟨hx,hr.2⟩).2⟩

/-- The full Cartan normalizes the exact root-generated panel kernel. -/
theorem torus_normalizes_rankOne_kernel (i : Fin 2) :
    Q.tits.B ⊓ Q.tits.N ≤
      normalizer (rankOne Q split i ⊓ localKernel Q i : Set (X ⧸ Q.D)) :=
  (le_inf (rankOne_torus_normalizes Q split i)
    ((inf_le_left.trans (Q.tits.B_le_standardParabolic _)).trans
      (localKernel_parabolic_normalizes Q i))).trans inf_normalizer_le_normalizer_inf

/-- The equality in (5C)(a) specializes to trivial groups under the odd-Cartan hypothesis. -/
theorem unipotent_inf_rankOne_kernel (i : Fin 2) :
    split.U ⊓ (rankOne Q split i ⊓ localKernel Q i) =
      split.U ⊓ (Q.tits.B ⊓ Q.tits.N) ⊓ localKernel Q i := by
  have hr : split.U ⊓ (rankOne Q split i ⊓ localKernel Q i) = ⊥ := by
    apply eq_bot_iff.mpr
    intro x hx
    exact mem_bot.mpr ((disjoint_def.mp (rankOne_disjoint_radical Q split i))
      hx.2.1 ⟨hx.1,hx.2.2⟩)
  have ht : split.U ⊓ (Q.tits.B ⊓ Q.tits.N) = ⊥ := by
    exact le_bot_iff.mp ((inf_le_inf_left _ inf_le_right).trans split.unipotent_inf_N.le)
  rw [hr, ht, bot_inf_eq]

/-- The inclusion followed by the existing local-cover quotient. -/
def coverMap (i : Fin 2) : rankOne Q split i →* LocalCover.CoverGroup Q split i :=
  (QuotientGroup.mk' (LocalCover.radicalInClosure Q split i)).comp
    (inclusion (rankOne_le_localClosure Q split i))

theorem coverMap_injective (i : Fin 2) : Function.Injective (coverMap Q split i) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply eq_bot_iff.mpr
  intro r hr
  change QuotientGroup.mk' (LocalCover.radicalInClosure Q split i)
    (inclusion (rankOne_le_localClosure Q split i) r) = 1 at hr
  have hv := (QuotientGroup.eq_one_iff
    (N := LocalCover.radicalInClosure Q split i) _).mp hr
  exact Subtype.ext ((disjoint_def.mp (rankOne_disjoint_radical Q split i)) r.property hv)

theorem rankOne_sup_radical (i : Fin 2)
    (hV : simpleRemainder Q split i ≤ localKernel Q i) :
    rankOne Q split i ⊔ LocalCover.radical Q split i = localClosure Q split i := by
  apply le_antisymm (sup_le (rankOne_le_localClosure Q split i)
    (inf_le_left.trans le_sup_left))
  have hU : split.U ≤ rankOne Q split i ⊔ LocalCover.radical Q split i := by
    intro x hx
    have hm : x ∈ (simpleRoot Q split i : Set (X ⧸ Q.D)) *
        (simpleRemainder Q split i : Set (X ⧸ Q.D)) :=
      (simpleRoot_mul_remainder Q split i).symm ▸ hx
    obtain ⟨r,hr,v,hv,rfl⟩ := hm
    exact mul_mem_sup ((show simpleRoot Q split i ≤ rankOne Q split i from le_sup_left) hr)
      ⟨hv.1,hV hv⟩
  apply sup_le hU
  let n := representative (Q.simple i)
  have hnP : (n : X ⧸ Q.D) ∈ Q.tits.standardParabolic {Q.simple i} :=
    Q.tits.bruhatCell_subset_standardParabolic_of_mem (Set.mem_singleton _)
      (Q.tits.representative_mem_bruhatCell _ n (representative_spec _))
  have hc := comap_mono (f := (MulAut.conj (n : X ⧸ Q.D)).toMonoidHom) hU
  rw [← comap_sup_eq _ _ _ (MulAut.conj (n : X ⧸ Q.D)).surjective] at hc
  change unipotentConjugate split (Q.simple i) ≤
    rightConjugate (rankOne Q split i) (n : X ⧸ Q.D) ⊔
      rightConjugate (LocalCover.radical Q split i) (n : X ⧸ Q.D) at hc
  rwa [rankOne_conjugate Q split i n (representative_spec _),
    rightConjugate_eq_self _ (LocalCover.radical_parabolic_normalizes Q split i hnP)] at hc

theorem coverMap_surjective (i : Fin 2)
    (hV : simpleRemainder Q split i ≤ localKernel Q i) :
    Function.Surjective (coverMap Q split i) := by
  intro y
  induction y using QuotientGroup.induction_on with
  | H y =>
    have hy : (y : X ⧸ Q.D) ∈ rankOne Q split i ⊔ LocalCover.radical Q split i :=
      (rankOne_sup_radical Q split i hV).symm ▸ y.property
    rw [← SetLike.mem_coe, coe_mul_of_left_le_normalizer_right _ _
      ((rankOne_le_parabolic Q split i).trans (LocalCover.radical_parabolic_normalizes Q split i))] at hy
    obtain ⟨r,hr,v,hv,he⟩ := hy
    refine ⟨⟨r,hr⟩, QuotientGroup.eq.mpr ?_⟩
    change r⁻¹ * (y : X ⧸ Q.D) ∈ LocalCover.radical Q split i
    rw [← he, inv_mul_cancel_left]
    exact hv

/-- No quotient of R_i is hidden: its radical intersection is trivial. -/
def coverEquiv (i : Fin 2) (hV : simpleRemainder Q split i ≤ localKernel Q i) :
    rankOne Q split i ≃* LocalCover.CoverGroup Q split i :=
  MulEquiv.ofBijective (coverMap Q split i)
    ⟨coverMap_injective Q split i, coverMap_surjective Q split i hV⟩

@[simp] theorem coverEquiv_apply (i : Fin 2)
    (hV : simpleRemainder Q split i ≤ localKernel Q i) (r : rankOne Q split i) :
    coverEquiv Q split i hV r = QuotientGroup.mk'
      (LocalCover.radicalInClosure Q split i) (inclusion (rankOne_le_localClosure Q split i) r) := by rfl

def projection (i : Fin 2) : rankOne Q split i →* localGroup Q split i :=
  (LocalCover.projection Q split i).comp (coverMap Q split i)

@[simp] theorem projection_apply (i : Fin 2) (r : rankOne Q split i) :
    (projection Q split i r : Equiv.Perm (Panel Q i)) =
      localAction Q split i (inclusion (rankOne_le_localClosure Q split i) r) := by
  change (LocalCover.projection Q split i (QuotientGroup.mk'
    (LocalCover.radicalInClosure Q split i)
    (inclusion (rankOne_le_localClosure Q split i) r)) : Equiv.Perm (Panel Q i)) = _
  exact LocalCover.projection_mk Q split i _

theorem projection_ker (i : Fin 2) :
    (projection Q split i).ker = (localKernel Q i).subgroupOf (rankOne Q split i) := by
  ext r
  change projection Q split i r = 1 ↔ _
  rw [Subtype.ext_iff, projection_apply]
  change localAction Q split i (inclusion (rankOne_le_localClosure Q split i) r) = 1 ↔ _
  exact SetLike.ext_iff.mp (localAction_ker Q split i)
    (inclusion (rankOne_le_localClosure Q split i) r)

/-- Centrality already follows before identifying the whole local image. -/
theorem projection_ker_central (i : Fin 2) :
    (projection Q split i).ker ≤ center (rankOne Q split i) := by
  intro k hk
  have hk' : (k : X ⧸ Q.D) ∈ localKernel Q i := by
    change k ∈ (localKernel Q i).subgroupOf (rankOne Q split i)
    rwa [← projection_ker]
  apply mem_center_iff.mpr
  intro r
  apply commutatorElement_eq_one_iff_mul_comm.mp
  apply Subtype.ext
  apply (disjoint_def.mp (rankOne_disjoint_radical Q split i))
  · exact (⁅r,k⁆ : rankOne Q split i).property
  · exact LocalCover.localClosure_kernel_commutator Q split i
      (commutator_mem_commutator (rankOne_le_localClosure Q split i r.property) hk')

theorem projection_ker_odd (i : Fin 2) :
    Nat.Coprime 2 (Nat.card (projection Q split i).ker) := by
  rw [projection_ker, ← card_map_of_injective (rankOne Q split i).subtype_injective,
    subgroupOf_map_subtype]
  exact split.odd.of_dvd_right (card_dvd_of_le (show localKernel Q i ⊓ rankOne Q split i ≤
      Q.tits.B ⊓ Q.tits.N from fun _ hx => rankOne_inf_kernel_le_torus Q split i ⟨hx.2,hx.1⟩))

theorem central_odd_cover (i : Fin 2)
    (hV : simpleRemainder Q split i ≤ localKernel Q i) :
    Function.Surjective (projection Q split i) ∧
      (projection Q split i).ker ≤ center (rankOne Q split i) ∧
      Nat.Coprime 2 (Nat.card (projection Q split i).ker) ∧
      (projection Q split i).ker ≤ _root_.commutator (rankOne Q split i) := by
  let a := coverEquiv Q split i hV
  have hk : (projection Q split i).ker =
      (LocalCover.projection Q split i).ker.comap a.toMonoidHom := rfl
  refine ⟨(LocalCover.projection_surjective Q split i).comp a.surjective,
    projection_ker_central Q split i, projection_ker_odd Q split i, ?_⟩
  intro x hx
  have hx' := LocalCover.projection_ker_le_commutator Q split i (hk ▸ hx)
  have hm : a.symm (a x) ∈
      (_root_.commutator (LocalCover.CoverGroup Q split i)).map a.symm.toMonoidHom :=
    mem_map_of_mem _ hx'
  rw [map_commutator_eq, MonoidHom.range_eq_top.mpr a.symm.surjective] at hm
  simpa only [MulEquiv.symm_apply_apply, _root_.commutator_def] using hm

end Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootLocalCover
