module

public import Theory.AlgebraicGroup.Borel.IsogenyImage

universe u

/-! Derived-subgroup consequences of dense opposite Borel decompositions. -/

open scoped Pointwise

namespace Theory.AlgebraicGroup

section

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- A dense opposite decomposition and a self-centralizing maximal torus
identify the derived subgroup with the subgroup generated by all roots. -/
public theorem derivedSubgroup_eq_rootSubgroupGenerated_of_dense_opposite_decomposition
    {K : Variety k} [AlgebraicGroup K]
    [Nonempty (Variety.Point K)] [PreirreducibleSpace (Variety.Point K)]
    (T : ClosedSubgroup K) (D : RootGroupData K T)
    (hT : IsMaximalTorus T) (hD : D.IsRealization)
    (hcentralizer : T.centralizer.toSubgroup = T.toSubgroup)
    (B Bopp : ClosedSubgroup K) (P : Set D.Root)
    (hP : IsPositiveSystem D P)
    (hK : _root_.IsConnected (Set.univ : Set (Variety.Point K)))
    (hBform : ∀ x, x ∈ B ↔ ∃ t u,
      t ∈ T ∧ u ∈ RootSubgroupGenerated D P ∧ x = t * u)
    (hBoppform : ∀ x, x ∈ Bopp ↔ ∃ t u,
      t ∈ T ∧ u ∈ RootSubgroupGenerated D (D.neg ⁻¹' P) ∧ x = t * u)
    (hdense : Dense
      ((B.toSubgroup : Set (Variety.Point K)) *
        (Bopp.toSubgroup : Set (Variety.Point K)))) :
    ⁅(⊤ : Subgroup (Variety.Point K)), ⊤⁆ =
      RootSubgroupGenerated D Set.univ := by
  have hgen :=
    rootSubgroupGenerated_sup_torus_eq_top_of_dense_opposite_decomposition_product
      T B Bopp D P hP hK hBform hBoppform hdense
  exact derivedSubgroup_eq_rootSubgroupGenerated_of_centralizer_and_generation
    T D hT hD hcentralizer hgen

/-- The dense opposite-decomposition conclusion follows when the maximal
torus centralizer is itself a subtorus. -/
public theorem derivedSubgroup_eq_rootSubgroupGenerated_of_subtorus_centralizer_and_dense_decomposition
    {K : Variety k} [AlgebraicGroup K]
    [Nonempty (Variety.Point K)] [PreirreducibleSpace (Variety.Point K)]
    (T : ClosedSubgroup K) (D : RootGroupData K T)
    (hT : IsMaximalTorus T) (hD : D.IsRealization)
    (hcentralizer : IsSubtorus T.centralizer)
    (B Bopp : ClosedSubgroup K) (P : Set D.Root)
    (hP : IsPositiveSystem D P)
    (hK : _root_.IsConnected (Set.univ : Set (Variety.Point K)))
    (hBform : ∀ x, x ∈ B ↔ ∃ t u,
      t ∈ T ∧ u ∈ RootSubgroupGenerated D P ∧ x = t * u)
    (hBoppform : ∀ x, x ∈ Bopp ↔ ∃ t u,
      t ∈ T ∧ u ∈ RootSubgroupGenerated D (D.neg ⁻¹' P) ∧ x = t * u)
    (hdense : Dense
      ((B.toSubgroup : Set (Variety.Point K)) *
        (Bopp.toSubgroup : Set (Variety.Point K)))) :
    ⁅(⊤ : Subgroup (Variety.Point K)), ⊤⁆ =
      RootSubgroupGenerated D Set.univ := by
  have hcentralizerEq : T.centralizer.toSubgroup = T.toSubgroup :=
    maximalTorus_centralizer_eq_of_isTorus hT hcentralizer
  exact derivedSubgroup_eq_rootSubgroupGenerated_of_dense_opposite_decomposition
    T D hT hD hcentralizerEq B Bopp P hP hK hBform hBoppform hdense

end

end Theory.AlgebraicGroup
