module

public import Theory.AlgebraicGroup.RootData.FundamentalRootRankTwoIsolation
public import Theory.AlgebraicGroup.RootData.PositiveSystemBaseExistence
public import Theory.AlgebraicGroup.RootData.Standard

/-!
Generation of the positive-root subgroup by fundamental root subgroups.

For a realized positive system, choose an abstract root-system base whose
positive roots are exactly the selected roots.  Cumulative induction on the
integer height of that aligned base then proves containment of every positive
root subgroup in the subgroup generated by the fundamental ones.  A support
root has height one and is fundamental directly.  For any other positive root,
subtracting a support root with positive Cartan pairing gives a positive root
of smaller height and a positive rank-two chain step.

The group-theoretic induction step is the characteristic-free isolation result
from `FundamentalRootRankTwoIsolation`.  It is derived from the genuine
Chevalley commutator and collection relations and may use all fundamental
roots and previously generated positive roots.  In particular, it covers the
singular characteristic-two and characteristic-three rank-two cases without
assuming that an individual commutator coefficient is nonzero.  This is the
fundamental-root generation argument in GLS3, Theorem 1.12.7(d).
-/

namespace Theory.AlgebraicGroup

universe u

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- The root subgroups of a realized positive system are generated by those
positive roots which are not sums of two positive roots. -/
public theorem rootSubgroupGenerated_positiveRoots_eq_fundamentalRootsFor
    {K : Variety k} [AlgebraicGroup K]
    {T B : ClosedSubgroup K} (D : RootGroupData K T)
    (C : ChevalleyData K D) (positiveRoots : Set D.Root)
    [Fintype D.Root]
    (hSetup : IsStandardBorelSetup T B D positiveRoots)
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (systemBase : P.Base)
    (hActual : IsRootSystemRealization D P e systemBase)
    (hAdd : IsRootAdditionRealization D P e)
    (hC : IsChevalleySystem D C P e systemBase) :
    RootSubgroupGenerated D positiveRoots =
      RootSubgroupGenerated D (FundamentalRootsFor D positiveRoots) := by
  classical
  obtain ⟨positiveBase, hPositiveRoots⟩ :=
    exists_base_isPos_iff_of_positiveSystem D P e systemBase
      hSetup.2.2.1 hActual hAdd
  have hD : D.IsRealization := hSetup.2.1
  have hFundamental {rho : D.Root} (hrho : e rho ∈ positiveBase.support) :
      rho ∈ FundamentalRootsFor D positiveRoots := by
    have hrhoPos : positiveBase.IsPos (e rho) :=
      positiveBase.isPos_of_mem_support hrho
    refine ⟨(hPositiveRoots rho).2 hrhoPos, ?_⟩
    intro alpha halpha delta hdelta hadd
    have hsum : P.root (e rho) = P.root (e alpha) + P.root (e delta) :=
      (hAdd alpha delta rho).1 hadd
    have hheight := positiveBase.height_add hsum
    rw [positiveBase.height_one_of_mem_support hrho] at hheight
    have halphaHeight : 0 < positiveBase.height (e alpha) :=
      (positiveBase.isPos_iff).1 ((hPositiveRoots alpha).1 halpha)
    have hdeltaHeight : 0 < positiveBase.height (e delta) :=
      (positiveBase.isPos_iff).1 ((hPositiveRoots delta).1 hdelta)
    omega
  have hGenerated : ∀ heightBound : ℤ, ∀ gamma : D.Root,
      positiveBase.IsPos (e gamma) →
      positiveBase.height (e gamma) ≤ heightBound →
      (D.rootSubgroup gamma).toSubgroup ≤
        RootSubgroupGenerated D (FundamentalRootsFor D positiveRoots) := by
    intro heightBound
    induction heightBound using Int.induction_on with
    | zero =>
        intro gamma hgammaPos hgammaHeight
        rw [positiveBase.isPos_iff] at hgammaPos
        omega
    | succ heightBound ih =>
        intro gamma hgammaPos hgammaHeight
        by_cases hEarlierHeight : positiveBase.height (e gamma) ≤ heightBound
        · exact ih gamma hgammaPos hEarlierHeight
        · have hgammaHeightEq :
              positiveBase.height (e gamma) = heightBound + 1 := by
            omega
          by_cases hgammaSupport : e gamma ∈ positiveBase.support
          · exact rootSubgroup_le_RootSubgroupGenerated D
              (hFundamental hgammaSupport)
          · obtain ⟨j, hjSupport, hjPairing⟩ :=
              hgammaPos.exists_mem_support_pos_pairingIn
            rw [P.zero_lt_pairingIn_iff'] at hjPairing
            have hgammaNeJ : e gamma ≠ j := by
              intro hgammaJ
              apply hgammaSupport
              simpa [hgammaJ] using hjSupport
            obtain ⟨alphaIndex, halphaIndex⟩ :=
              P.root_sub_root_mem_of_pairingIn_pos hjPairing hgammaNeJ
            let alpha : D.Root := e.symm alphaIndex
            let delta : D.Root := e.symm j
            have halphaPos : positiveBase.IsPos (e alpha) := by
              dsimp [alpha]
              simpa using hgammaPos.sub hjSupport
                (by simpa [alpha, delta] using halphaIndex)
            have hgammaSum :
                P.root (e gamma) = P.root (e alpha) + P.root (e delta) := by
              dsimp [alpha, delta]
              rw [e.apply_symm_apply, e.apply_symm_apply]
              rw [halphaIndex]
              module
            have hStep :
                RankTwoPositiveChainStep D P e positiveBase alpha delta gamma :=
              { delta_mem_base := by
                  dsimp [delta]
                  simpa using hjSupport
                alpha_positive := halphaPos
                gamma_positive := hgammaPos
                gamma_eq_alpha_add_delta := hgammaSum }
            apply
              rootSubgroup_le_fundamentalRootsGenerated_of_alignedRankTwoPositiveChainStep
                D C P e systemBase positiveBase hD hPositiveRoots hC hActual hAdd hStep
            intro rho hrho hrhoHeight
            apply ih rho ((hPositiveRoots rho).1 hrho)
            omega
    | pred heightBound ih =>
        intro gamma hgammaPos hgammaHeight
        exact ih gamma hgammaPos (by omega)
  apply le_antisymm
  · apply RootSubgroupGenerated_le_of_rootSubgroup_le
    intro gamma hgamma
    apply hGenerated (positiveBase.height (e gamma)) gamma
    · exact (hPositiveRoots gamma).1 hgamma
    · rfl
  · apply RootSubgroupGenerated_mono D
    intro gamma hgamma
    exact hgamma.1

end Theory.AlgebraicGroup
