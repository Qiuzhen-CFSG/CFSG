module

public import Theory.AlgebraicGroup.Borel.RootStructure.theorem_1_11_4
public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup
public import Theory.AlgebraicGroup.RootSubgroups.TorusGeneratedNormalizer

/-!
# Ordered inversion-root factors for Bruhat normal form

This module is the public interface used by the reduction of GLS3 Theorem
1.11.5.  For a normalizer element `n`, the factor is generated by the roots in
`BruhatRootSet`; an ordered-product witness records a finite nodup list of
exactly those roots and the pointwise `List.Forall₂` product formula.  The
remaining fields record the independent geometric inputs of the Bruhat
argument: containment in the positive unipotent subgroup, transport of root
groups by the Weyl action, absorption `n * q = a * n * v`, and triangular
positive/negative separation.

The finite product and torus-normalization lemmas below use only the realized
root-data and the filtered collection interface.  Absorption and triangular
separation are deliberately exposed as fields of the cohesive API: their
proofs are the non-circular rank-one/Bruhat geometric route of GLS3 1.11.5,
and neither is smuggled in through the ordered-product definition.
-/

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- The subgroup generated by the positive roots inverted by a normalizer word. -/
public def bruhatFactor
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (positiveRoots : Set D.Root)
    {ι X Y : Type u} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (e : D.Root ≃ ι)
    (weylMap : T.normalizer.toSubgroup →* P.weylGroup)
    (n : T.normalizer.toSubgroup) : Subgroup (Variety.Point K) :=
  RootSubgroupGenerated D
    (BruhatRootSet D positiveRoots P e (normalizerWeylClass T P weylMap n))

@[simp]
public theorem mem_bruhatFactor
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (positiveRoots : Set D.Root)
    {ι X Y : Type u} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (e : D.Root ≃ ι)
    (weylMap : T.normalizer.toSubgroup →* P.weylGroup)
    (n : T.normalizer.toSubgroup) (x : Variety.Point K) :
    x ∈ bruhatFactor D positiveRoots P e weylMap n ↔
      x ∈ RootSubgroupGenerated D
        (BruhatRootSet D positiveRoots P e
          (normalizerWeylClass T P weylMap n)) := Iff.rfl

/-- A finite ordered product representation of every Bruhat inversion factor. -/
public structure BruhatFactorOrderedProduct
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (positiveRoots : Set D.Root)
    {ι X Y : Type u} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (e : D.Root ≃ ι)
    (weylMap : T.normalizer.toSubgroup →* P.weylGroup) where
  roots : T.normalizer.toSubgroup → List D.Root
  roots_nodup : ∀ n, (roots n).Nodup
  roots_mem_iff : ∀ n α,
    α ∈ roots n ↔ α ∈ BruhatRootSet D positiveRoots P e
      (normalizerWeylClass T P weylMap n)
  mem_iff : ∀ n (x : Variety.Point K),
    x ∈ bruhatFactor D positiveRoots P e weylMap n ↔
      ∃ xs : List (Variety.Point K),
        List.Forall₂ (fun α y => y ∈ D.rootSubgroup α) (roots n) xs ∧
          xs.prod = x

public theorem bruhatFactor_ordered_product
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    {D : RootGroupData K T} {positiveRoots : Set D.Root}
    {ι X Y : Type u} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    {P : RootPairing ι ℤ X Y} {e : D.Root ≃ ι}
    {weylMap : T.normalizer.toSubgroup →* P.weylGroup}
    (O : BruhatFactorOrderedProduct D positiveRoots P e weylMap)
    (n : T.normalizer.toSubgroup) (x : Variety.Point K) :
    x ∈ bruhatFactor D positiveRoots P e weylMap n ↔
      ∃ xs : List (Variety.Point K),
        List.Forall₂ (fun α y => y ∈ D.rootSubgroup α) (O.roots n) xs ∧
          xs.prod = x :=
  O.mem_iff n x

public theorem bruhatFactor_roots_finite
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    {D : RootGroupData K T} {positiveRoots : Set D.Root}
    {ι X Y : Type u} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    {P : RootPairing ι ℤ X Y} {e : D.Root ≃ ι}
    {weylMap : T.normalizer.toSubgroup →* P.weylGroup}
    (O : BruhatFactorOrderedProduct D positiveRoots P e weylMap)
    (n : T.normalizer.toSubgroup) : Set.Finite (O.roots n) := by
  classical
  simpa using Finset.finite_toSet ((O.roots n).toFinset)

/-- Every inversion-root factor is contained in the positive-root subgroup. -/
public theorem bruhatFactor_le_rootSubgroupGenerated_positive
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    {D : RootGroupData K T} {positiveRoots : Set D.Root}
    {ι X Y : Type u} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    {P : RootPairing ι ℤ X Y} {e : D.Root ≃ ι}
    {weylMap : T.normalizer.toSubgroup →* P.weylGroup}
    (n : T.normalizer.toSubgroup) :
    bruhatFactor D positiveRoots P e weylMap n ≤
      RootSubgroupGenerated D positiveRoots := by
  apply RootSubgroupGenerated_mono D
  intro α hα
  exact hα.1

/-- The same containment with the ambient unipotent subgroup as target. -/
public theorem bruhatFactor_le_of_unipotent_generation
    {K : Variety k} [AlgebraicGroup K] {T U : ClosedSubgroup K}
    {D : RootGroupData K T} {positiveRoots : Set D.Root}
    {ι X Y : Type u} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    {P : RootPairing ι ℤ X Y} {e : D.Root ≃ ι}
    {weylMap : T.normalizer.toSubgroup →* P.weylGroup}
    (hU : U.toSubgroup = RootSubgroupGenerated D positiveRoots)
    (n : T.normalizer.toSubgroup) :
    bruhatFactor D positiveRoots P e weylMap n ≤ U.toSubgroup := by
  rw [hU]
  exact bruhatFactor_le_rootSubgroupGenerated_positive n

/-- Torus conjugation preserves every inversion-root factor. -/
public theorem bruhatFactor_torus_conjugation
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    {D : RootGroupData K T} {positiveRoots : Set D.Root}
    {ι X Y : Type u} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    {P : RootPairing ι ℤ X Y} {e : D.Root ≃ ι}
    {weylMap : T.normalizer.toSubgroup →* P.weylGroup}
    (hD : D.IsRealization) (t : Variety.Point K) (ht : t ∈ T.toSubgroup)
    (n : T.normalizer.toSubgroup) {v : Variety.Point K}
    (hv : v ∈ bruhatFactor D positiveRoots P e weylMap n) :
    t * v * t⁻¹ ∈ bruhatFactor D positiveRoots P e weylMap n := by
  have hn := (torus_le_rootSubgroupGenerated_normalizer D hD
    (BruhatRootSet D positiveRoots P e
      (normalizerWeylClass T P weylMap n))) ht
  rw [Subgroup.mem_normalizer_iff] at hn
  exact (hn v).mp hv

/-- The complete contract consumed by the unique Bruhat normal-form reduction.

`weyl_transport` is the root-subgroup Weyl action, while `absorb` and
`triangular` are the two geometric GLS3 1.11.5 inputs. -/
public structure BruhatUnipotentSplittingAPI
    {K : Variety k} [AlgebraicGroup K] {T U : ClosedSubgroup K}
    (D : RootGroupData K T) (positiveRoots : Set D.Root)
    {ι X Y : Type u} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (e : D.Root ≃ ι)
    (weylMap : T.normalizer.toSubgroup →* P.weylGroup) where
  ordered : BruhatFactorOrderedProduct D positiveRoots P e weylMap
  factor_le : ∀ n, bruhatFactor D positiveRoots P e weylMap n ≤ U.toSubgroup
  weyl_transport : ∀ (m : T.normalizer.toSubgroup) (α : D.Root),
    (D.rootSubgroup α).conjugate ((m : Variety.Point K)⁻¹) =
      D.rootSubgroup (e.symm
        (P.weylGroupToPerm (weylMap m)⁻¹ (e α)))
  absorb : ∀ (n : T.normalizer.toSubgroup) (q : Variety.Point K),
    q ∈ U.toSubgroup →
      ∃ a v : Variety.Point K,
        a ∈ U.toSubgroup ∧
          v ∈ bruhatFactor D positiveRoots P e weylMap n ∧
          (n : Variety.Point K) * q = a * (n : Variety.Point K) * v
  triangular : ∀ (n : T.normalizer.toSubgroup)
      (v t : Variety.Point K),
    v ∈ bruhatFactor D positiveRoots P e weylMap n →
    t ∈ T.toSubgroup →
    (n : Variety.Point K) * (v * t) * (n : Variety.Point K)⁻¹ ∈ U.toSubgroup →
      v = 1 ∧ t = 1

end Theory.AlgebraicGroup
