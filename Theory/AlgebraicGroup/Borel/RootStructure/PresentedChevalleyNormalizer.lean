module

public import Theory.AlgebraicGroup.Borel.RootStructure.GeneralChevalleyRelatorAPI
public import Theory.AlgebraicGroup.RootSystems.PositiveSubsystem
public import Theory.AlgebraicGroup.RootSystems.StrongExchange

/-!
This module proves a normal form for the subgroup of the general presented
Chevalley group generated by the formal reflection and torus symbols.  Every
element of that subgroup is written as a product of a word in base-coroot
torus symbols and a reduced word in chosen simple-reflection lifts.  The same
normal form records the induced Weyl action on all root indices, and a trivial
Weyl factor forces the element itself to be represented by the base-torus
word.

The proof is internal to the presentation.  The common Chevalley relators
move torus factors past reflection lifts, replace arbitrary coroot factors by
base-coroot factors, and account for reflection squares.  Strong exchange and
the root-system word-length API then reduce reflection words without invoking
an evaluation map or any presentation-kernel inclusion.  This is the
normalizer-word component needed by the later arbitrary Chevalley kernel
argument.
-/

set_option linter.unusedSectionVars false

namespace Theory.AlgebraicGroup

universe u

variable {k : Type u} [Field k] [IsAlgClosed k]
variable {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
variable {D : RootGroupData K T}
variable {ι R M N : Type u} [Finite ι] [Field R] [CharZero R]
variable [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
variable {P : RootPairing ι R M N} [P.IsRootSystem]
variable [P.IsCrystallographic] [P.IsReduced]
variable {e : D.Root ≃ ι} {base : P.Base}
variable (hActual : IsRootSystemRealization D P e base)
variable (data : ChevalleyRelationData D P e base)
variable (weights : base.support → TorusWeight T)

private abbrev Q :=
  PresentedGroup (generalChevalleyRelators data weights)

public abbrev presentedChevalleyN (α : D.Root) (t : kˣ) :
    PresentedGroup (generalChevalleyRelators data weights) :=
  PresentedGroup.of (.n α t)

public abbrev presentedChevalleyH (α : D.Root) (t : kˣ) :
    PresentedGroup (generalChevalleyRelators data weights) :=
  PresentedGroup.of (.h α t)

private abbrev pN (alpha : D.Root) (t : kˣ) : Q data weights :=
  presentedChevalleyN data weights alpha t

private abbrev pH (alpha : D.Root) (t : kˣ) : Q data weights :=
  presentedChevalleyH data weights alpha t

private theorem commonRelator_eq
    {a b : FreeGroup (FormalChevalleyGenerator D.Root k)}
    (h : IsCommonChevalleyRelator data (formalRelation a b)) :
    PresentedGroup.mk (generalChevalleyRelators data weights) a =
      PresentedGroup.mk (generalChevalleyRelators data weights) b := by
  apply PresentedGroup.mk_eq_mk_of_mul_inv_mem
  rw [← formalRelation_eq]
  rw [mem_generalChevalleyRelators (e := e) (base := base)]
  apply Or.inl
  rw [mem_universalChevalleyRelators]
  exact h

private theorem pH_commute (α β : D.Root) (t s : kˣ) :
    Commute (pH data weights α t) (pH data weights β s) := by
  have h := commonRelator_eq data weights
    (IsCommonChevalleyRelator.torusCommutes α β t s)
  simp only [formalChevalleyH_eq, map_mul, map_inv, map_one] at h
  change (pH data weights α t)⁻¹ * (pH data weights β s)⁻¹ *
    pH data weights α t * pH data weights β s = 1 at h
  have hx : (pH data weights β s)⁻¹ * pH data weights α t *
      pH data weights β s = pH data weights α t := by
    apply mul_left_cancel (a := (pH data weights α t)⁻¹)
    simpa [mul_assoc] using h
  calc
    pH data weights α t * pH data weights β s =
        pH data weights β s *
          ((pH data weights β s)⁻¹ * pH data weights α t *
            pH data weights β s) := by group
    _ = pH data weights β s * pH data weights α t := by rw [hx]

private theorem pH_mul (α : D.Root) (t s : kˣ) :
    pH data weights α t * pH data weights α s = pH data weights α (t * s) := by
  simpa [pH, formalChevalleyH_eq, PresentedGroup.of, map_mul] using
    commonRelator_eq data weights
      (IsCommonChevalleyRelator.torusMultiplication α t s)

private theorem pH_expand (α : D.Root) (t : kˣ) :
    pH data weights α t =
      (base.support.attach.toList.map fun i : base.support =>
        pH data weights (e.symm i) (t ^ data.corootCoefficient α i)).prod := by
  simpa [pH, formalChevalleyH_eq, PresentedGroup.of, map_list_prod,
    List.map_map, Function.comp_def] using
    commonRelator_eq data weights
      (IsCommonChevalleyRelator.corootExpansion α t)

private theorem reflect_reflect (e : D.Root ≃ ι) (base : P.Base)
    (hActual : IsRootSystemRealization D P e base) (α β : D.Root) :
    D.reflect β (D.reflect β α) = α := by
  apply Equiv.injective e
  rw [hActual.2.1, hActual.2.1, P.reflectionPerm_self]

private theorem pH_one (α : D.Root) : pH data weights α 1 = 1 := by
  apply mul_left_cancel (a := pH data weights α 1)
  simpa using pH_mul data weights α 1 1

private theorem pH_inv (α : D.Root) (t : kˣ) :
    (pH data weights α t)⁻¹ = pH data weights α t⁻¹ := by
  apply inv_eq_iff_mul_eq_one.mpr
  rw [pH_mul]
  simpa using pH_one data weights α

private theorem pN_parameter (α : D.Root) (t : kˣ) :
    pN data weights α t = pN data weights α 1 * pH data weights α t := by
  have h := commonRelator_eq data weights
    (IsCommonChevalleyRelator.hDefinition α t)
  simp only [formalChevalleyH_eq, formalChevalleyN_eq, map_mul, map_inv] at h
  change pH data weights α t =
    (pN data weights α 1)⁻¹ * pN data weights α t at h
  calc
    pN data weights α t = pN data weights α 1 *
        ((pN data weights α 1)⁻¹ * pN data weights α t) := by simp
    _ = pN data weights α 1 * pH data weights α t := by rw [← h]

private theorem pN_square (α : D.Root) :
    pN data weights α 1 * pN data weights α 1 = pH data weights α (-1) := by
  simpa [pN, pH, formalChevalleyN_eq, formalChevalleyH_eq,
    PresentedGroup.of, map_mul] using
    commonRelator_eq data weights (IsCommonChevalleyRelator.reflectionSquare α)

private theorem pN_inv (α : D.Root) :
    (pN data weights α 1)⁻¹ =
      pN data weights α 1 * (pH data weights α (-1))⁻¹ := by
  apply inv_eq_iff_mul_eq_one.mpr
  rw [← mul_assoc, pN_square]
  simp

private theorem pN_conj_H (α β : D.Root) (t : kˣ) :
    (pN data weights β 1)⁻¹ * pH data weights α t * pN data weights β 1 =
      pH data weights (D.reflect β α) t := by
  simpa [pN, pH, formalChevalleyN_eq, formalChevalleyH_eq,
    PresentedGroup.of, map_mul, map_inv] using
    commonRelator_eq data weights
      (IsCommonChevalleyRelator.reflectionConjugatesTorus α β t)

private theorem pN_conj_pH (e : D.Root ≃ ι) (base : P.Base)
    (hActual : IsRootSystemRealization D P e base)
    (alpha beta : D.Root) (t : kˣ) :
    pN data weights beta 1 * pH data weights alpha t *
        (pN data weights beta 1)⁻¹ =
      pH data weights (D.reflect beta alpha) t := by
  have h := congrArg
    (fun z => pN data weights beta 1 * z * (pN data weights beta 1)⁻¹)
    (pN_conj_H data weights (D.reflect beta alpha) beta t)
  simpa [reflect_reflect e base hActual alpha beta, mul_assoc] using h.symm

private theorem pN_conj_N (α β : D.Root) (t : kˣ) :
    (pN data weights β 1)⁻¹ * pN data weights α t * pN data weights β 1 =
      pN data weights (D.reflect β α) (data.reflectionSign α β * t) := by
  simpa [pN, formalChevalleyN_eq, PresentedGroup.of, map_mul, map_inv] using
    commonRelator_eq data weights
      (IsCommonChevalleyRelator.reflectionConjugatesReflection α β t)

private def baseTorus : Subgroup (Q data weights) :=
  Subgroup.closure (Set.range fun z : base.support × kˣ =>
    pH data weights (e.symm z.1) z.2)

public abbrev presentedChevalleyBaseTorusWord
    (l : List (base.support × kˣ)) :
    PresentedGroup (generalChevalleyRelators data weights) :=
  (l.map fun z => presentedChevalleyH data weights (e.symm z.1) z.2).prod

private abbrev baseWord (l : List (base.support × kˣ)) : Q data weights :=
  (l.map fun z => pH data weights (e.symm z.1) z.2).prod

private theorem baseWord_append
    (l m : List (base.support × kˣ)) :
    baseWord data weights (l ++ m) =
      baseWord data weights l * baseWord data weights m := by
  simp [baseWord]

private theorem baseWord_inv
    (l : List (base.support × kˣ)) :
    (baseWord data weights l)⁻¹ =
      baseWord data weights (l.reverse.map fun z => (z.1, z.2⁻¹)) := by
  induction l with
  | nil => simp [baseWord]
  | cons z l ih =>
      rw [show baseWord data weights (z :: l) =
          pH data weights (e.symm z.1) z.2 * baseWord data weights l by rfl]
      rw [mul_inv_rev, ih, pH_inv]
      simp [baseWord, List.reverse_cons, List.map_append, Function.comp_def]

private theorem pH_mem_baseTorus (α : D.Root) (t : kˣ) :
    pH data weights α t ∈ baseTorus data weights := by
  rw [pH_expand data weights α t]
  apply Subgroup.list_prod_mem
  intro z hz
  simp only [List.mem_map] at hz
  obtain ⟨i, -, rfl⟩ := hz
  exact Subgroup.subset_closure ⟨(i, t ^ data.corootCoefficient α i), rfl⟩

private theorem baseTorus_has_word (x : Q data weights)
    (hx : x ∈ baseTorus data weights) :
    ∃ l : List (base.support × kˣ), x = baseWord data weights l := by
  induction hx using Subgroup.closure_induction'' with
  | mem x hx =>
      rcases hx with ⟨z, rfl⟩
      exact ⟨[z], by simp [baseWord]⟩
  | inv_mem x hx =>
      rcases hx with ⟨z, rfl⟩
      exact ⟨[(z.1, z.2⁻¹)], by simp [baseWord, pH_inv]⟩
  | one => exact ⟨[], by simp [baseWord]⟩
  | mul x y hx hy ihx ihy =>
      rcases ihx with ⟨l, rfl⟩
      rcases ihy with ⟨m, rfl⟩
      exact ⟨l ++ m, (baseWord_append data weights l m).symm⟩

private theorem pH_commute_baseWord (alpha : D.Root) (t : Units k)
    (l : List (base.support × Units k)) :
    Commute (pH data weights alpha t) (baseWord data weights l) := by
  induction l with
  | nil => simp [baseWord]
  | cons z l ih =>
      rw [show baseWord data weights (z :: l) =
        pH data weights (e.symm z.1) z.2 * baseWord data weights l by rfl]
      calc
        pH data weights alpha t *
            (pH data weights (e.symm z.1) z.2 * baseWord data weights l) =
          (pH data weights alpha t * pH data weights (e.symm z.1) z.2) *
            baseWord data weights l := by rw [mul_assoc]
        _ = (pH data weights (e.symm z.1) z.2 * pH data weights alpha t) *
            baseWord data weights l := by rw [(pH_commute data weights _ _ _ _).eq]
        _ = pH data weights (e.symm z.1) z.2 *
            (pH data weights alpha t * baseWord data weights l) := by rw [mul_assoc]
        _ = pH data weights (e.symm z.1) z.2 *
            (baseWord data weights l * pH data weights alpha t) := by rw [ih.eq]
        _ = (pH data weights (e.symm z.1) z.2 * baseWord data weights l) *
            pH data weights alpha t := by rw [mul_assoc]

private theorem baseWord_commute
    (l m : List (base.support × Units k)) :
    Commute (baseWord data weights l) (baseWord data weights m) := by
  induction l with
  | nil => simp [baseWord]
  | cons z l ih =>
      rw [show baseWord data weights (z :: l) =
        pH data weights (e.symm z.1) z.2 * baseWord data weights l by rfl]
      calc
        (pH data weights (e.symm z.1) z.2 * baseWord data weights l) *
            baseWord data weights m =
          pH data weights (e.symm z.1) z.2 *
            (baseWord data weights l * baseWord data weights m) := by rw [mul_assoc]
        _ = pH data weights (e.symm z.1) z.2 *
            (baseWord data weights m * baseWord data weights l) := by rw [ih.eq]
        _ = (pH data weights (e.symm z.1) z.2 * baseWord data weights m) *
            baseWord data weights l := by rw [mul_assoc]
        _ = (baseWord data weights m * pH data weights (e.symm z.1) z.2) *
            baseWord data weights l := by
              rw [(pH_commute_baseWord data weights _ _ _).eq]
        _ = baseWord data weights m *
            (pH data weights (e.symm z.1) z.2 * baseWord data weights l) := by
              rw [mul_assoc]

private theorem baseTorus_commute {x y : Q data weights}
    (hx : x ∈ baseTorus data weights) (hy : y ∈ baseTorus data weights) :
    Commute x y := by
  obtain ⟨l, rfl⟩ := baseTorus_has_word data weights x hx
  obtain ⟨m, rfl⟩ := baseTorus_has_word data weights y hy
  exact baseWord_commute data weights l m

private theorem pN_inv_conj_baseTorus (beta : D.Root)
    {x : Q data weights} (hx : x ∈ baseTorus data weights) :
    (pN data weights beta 1)⁻¹ * x * pN data weights beta 1 ∈
      baseTorus data weights := by
  induction hx using Subgroup.closure_induction'' with
  | mem x hx =>
      rcases hx with ⟨z, rfl⟩
      rw [pN_conj_H]
      exact pH_mem_baseTorus data weights _ _
  | inv_mem x hx =>
      rcases hx with ⟨z, rfl⟩
      rw [pH_inv, pN_conj_H]
      exact pH_mem_baseTorus data weights _ _
  | one => simp
  | mul x y hx hy ihx ihy =>
      convert (baseTorus data weights).mul_mem ihx ihy using 1
      all_goals group

include hActual in
private theorem pN_conj_baseTorus (beta : D.Root)
    {x : Q data weights} (hx : x ∈ baseTorus data weights) :
    pN data weights beta 1 * x * (pN data weights beta 1)⁻¹ ∈
      baseTorus data weights := by
  induction hx using Subgroup.closure_induction'' with
  | mem x hx =>
      rcases hx with ⟨z, rfl⟩
      rw [pN_conj_pH data weights e base hActual]
      exact pH_mem_baseTorus data weights _ _
  | inv_mem x hx =>
      rcases hx with ⟨z, rfl⟩
      rw [pH_inv, pN_conj_pH data weights e base hActual]
      exact pH_mem_baseTorus data weights _ _
  | one => simp
  | mul x y hx hy ihx ihy =>
      convert (baseTorus data weights).mul_mem ihx ihy using 1
      all_goals group

include hActual in
private theorem pN_mem_normalizer (beta : D.Root) :
    pN data weights beta 1 ∈
      Subgroup.normalizer (baseTorus data weights : Set (Q data weights)) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · exact pN_conj_baseTorus (hActual := hActual) data weights beta
  · intro hx
    have h := pN_inv_conj_baseTorus data weights beta hx
    simpa [mul_assoc] using h

@[expose]
public def presentedChevalleyNormalizer :
    Subgroup (PresentedGroup (generalChevalleyRelators data weights)) :=
  Subgroup.closure <| Set.range fun z : (D.Root × kˣ) ⊕ (D.Root × kˣ) =>
    match z with
    | .inl z => presentedChevalleyN data weights z.1 z.2
    | .inr z => presentedChevalleyH data weights z.1 z.2

private abbrev presentedNormalizer : Subgroup (Q data weights) :=
  presentedChevalleyNormalizer data weights

private theorem pN_mem_presentedNormalizer (alpha : D.Root) (t : kˣ) :
    pN data weights alpha t ∈ presentedNormalizer data weights := by
  exact Subgroup.subset_closure ⟨Sum.inl (alpha, t), rfl⟩

private theorem pH_mem_presentedNormalizer (alpha : D.Root) (t : kˣ) :
    pH data weights alpha t ∈ presentedNormalizer data weights := by
  exact Subgroup.subset_closure ⟨Sum.inr (alpha, t), rfl⟩

private theorem baseTorus_le_presentedNormalizer :
    baseTorus data weights ≤ presentedNormalizer data weights := by
  rw [baseTorus, Subgroup.closure_le]
  rintro x ⟨z, rfl⟩
  exact pH_mem_presentedNormalizer data weights _ _

include hActual in
private theorem presentedNormalizer_le_normalizer :
    presentedNormalizer data weights ≤
      Subgroup.normalizer (baseTorus data weights : Set (Q data weights)) := by
  rw [presentedNormalizer, presentedChevalleyNormalizer,
    Subgroup.closure_le]
  rintro x ⟨z, rfl⟩
  cases z with
  | inl z =>
      change pN data weights z.1 z.2 ∈
        Subgroup.normalizer (baseTorus data weights : Set (Q data weights))
      rw [pN_parameter]
      exact (Subgroup.normalizer
          (baseTorus data weights : Set (Q data weights))).mul_mem
        (pN_mem_normalizer (hActual := hActual) data weights z.1)
        ((baseTorus data weights).le_normalizer
          (pH_mem_baseTorus data weights z.1 z.2))
  | inr z =>
      change pH data weights z.1 z.2 ∈
        Subgroup.normalizer (baseTorus data weights : Set (Q data weights))
      exact (baseTorus data weights).le_normalizer
        (pH_mem_baseTorus data weights z.1 z.2)

private def torusRelated (x y : Q data weights) : Prop :=
  x * y⁻¹ ∈ baseTorus data weights

private theorem torusRelated_refl (x : Q data weights) :
    torusRelated data weights x x := by
  simp [torusRelated]

private theorem torusRelated_symm {x y : Q data weights}
    (h : torusRelated data weights x y) : torusRelated data weights y x := by
  have := (baseTorus data weights).inv_mem h
  simpa [torusRelated, mul_inv_rev] using this

private theorem torusRelated_trans {x y z : Q data weights}
    (hxy : torusRelated data weights x y)
    (hyz : torusRelated data weights y z) :
    torusRelated data weights x z := by
  have h := (baseTorus data weights).mul_mem hxy hyz
  simpa [torusRelated, mul_assoc] using h

private theorem torusRelated_mul_right {x y : Q data weights}
    (hxy : torusRelated data weights x y) (z : Q data weights) :
    torusRelated data weights (x * z) (y * z) := by
  simpa [torusRelated, mul_inv_rev, mul_assoc] using hxy

include hActual in
private theorem torusRelated_mul_left {x y a : Q data weights}
    (ha : a ∈ presentedNormalizer data weights)
    (hxy : torusRelated data weights x y) :
    torusRelated data weights (a * x) (a * y) := by
  have hnorm := presentedNormalizer_le_normalizer
    (hActual := hActual) data weights ha
  have hconj := (Subgroup.mem_normalizer_iff.mp hnorm (x * y⁻¹)).mp hxy
  simpa [torusRelated, mul_inv_rev, mul_assoc] using hconj

include hActual in
private theorem torusRelated_mul {x₁ y₁ x₂ y₂ : Q data weights}
    (hy₁ : y₁ ∈ presentedNormalizer data weights)
    (h₁ : torusRelated data weights x₁ y₁)
    (h₂ : torusRelated data weights x₂ y₂) :
    torusRelated data weights (x₁ * x₂) (y₁ * y₂) := by
  exact torusRelated_trans data weights
    (torusRelated_mul_right data weights h₁ x₂)
    (torusRelated_mul_left (hActual := hActual) data weights hy₁ h₂)

public abbrev presentedChevalleySimpleWord (l : List base.support) :
    PresentedGroup (generalChevalleyRelators data weights) :=
  (l.map fun i => presentedChevalleyN data weights (e.symm i) 1).prod

private abbrev simpleWord (l : List base.support) : Q data weights :=
  (l.map fun i => pN data weights (e.symm i) 1).prod

@[simp]
private theorem simpleWord_nil : simpleWord data weights ([] : List base.support) = 1 :=
  rfl

@[simp]
private theorem simpleWord_cons (i : base.support) (l : List base.support) :
    simpleWord data weights (i :: l) =
      pN data weights (e.symm i) 1 * simpleWord data weights l :=
  rfl

private theorem simpleWord_append (l m : List base.support) :
    simpleWord data weights (l ++ m) =
      simpleWord data weights l * simpleWord data weights m := by
  simp [simpleWord]

private theorem simpleWord_mem_presentedNormalizer (l : List base.support) :
    simpleWord data weights l ∈ presentedNormalizer data weights := by
  apply Subgroup.list_prod_mem
  intro x hx
  simp only [List.mem_map] at hx
  rcases hx with ⟨i, -, rfl⟩
  exact pN_mem_presentedNormalizer data weights _ _

private theorem pH_related_one (alpha : D.Root) (t : kˣ) :
    torusRelated data weights (pH data weights alpha t) 1 := by
  simpa [torusRelated] using pH_mem_baseTorus data weights alpha t

include hActual in
private theorem pN_parameter_related (alpha : D.Root) (t : kˣ) :
    torusRelated data weights (pN data weights alpha t)
      (pN data weights alpha 1) := by
  rw [pN_parameter]
  have hnorm := presentedNormalizer_le_normalizer
    (hActual := hActual) data weights
      (pN_mem_presentedNormalizer data weights alpha 1)
  have hconj :=
    (Subgroup.mem_normalizer_iff.mp hnorm (pH data weights alpha t)).mp
      (pH_mem_baseTorus data weights alpha t)
  simpa [torusRelated, mul_assoc] using hconj

private theorem pN_square_related_one (alpha : D.Root) :
    torusRelated data weights
      (pN data weights alpha 1 * pN data weights alpha 1) 1 := by
  rw [pN_square]
  exact pH_related_one data weights _ _

include hActual in
private theorem pN_swap (alpha beta : D.Root) :
    torusRelated data weights
      (pN data weights beta 1 * pN data weights alpha 1)
      (pN data weights (D.reflect beta alpha) 1 * pN data weights beta 1) := by
  let c := data.reflectionSign (D.reflect beta alpha) beta
  have hconj :=
    pN_conj_N data weights (D.reflect beta alpha) beta c⁻¹
  have hconj' :
      (pN data weights beta 1)⁻¹ *
          pN data weights (D.reflect beta alpha) c⁻¹ *
            pN data weights beta 1 = pN data weights alpha 1 := by
    simpa [c, reflect_reflect e base hActual] using hconj
  have hexact :
      pN data weights beta 1 * pN data weights alpha 1 =
        pN data weights (D.reflect beta alpha)
            c⁻¹ *
          pN data weights beta 1 := by
    rw [← hconj']
    group
  rw [hexact]
  exact torusRelated_mul_right data weights
    (pN_parameter_related (hActual := hActual) data weights _ _) _

private theorem strongExchange_index (l : List base.support) (j : base.support)
    (hneg : ¬ base.IsPos (P.weylGroupToPerm (base.wordProd l) j)) :
    ∃ p : List base.support, ∃ i : base.support, ∃ q : List base.support,
      l = p ++ i :: q ∧
      P.weylGroupToPerm (base.wordProd q) j = i ∧
      base.wordProd (p ++ q) =
        base.wordProd l * base.simpleReflection j := by
  induction l with
  | nil =>
      exfalso
      apply hneg
      simpa using base.isPos_of_mem_support j.property
  | cons k l ih =>
      have hneg' : ¬ base.IsPos
          (P.reflectionPerm k
            (P.weylGroupToPerm (base.wordProd l) j)) := by
        rw [base.wordProd_cons] at hneg
        change ¬ base.IsPos
          (P.reflectionPerm k
            (P.weylGroupToPerm (base.wordProd l) j)) at hneg
        exact hneg
      by_cases hpos :
          base.IsPos (P.weylGroupToPerm (base.wordProd l) j)
      · have heq : P.weylGroupToPerm (base.wordProd l) j = k :=
          (simpleReflection_unique_positiveRoot P base k.property _).mp
            ⟨hpos, hneg'⟩
        refine ⟨[], k, l, rfl, heq, ?_⟩
        simp only [List.nil_append, base.wordProd_cons]
        change base.wordProd l = base.simpleReflection k *
          (base.wordProd l * RootPairing.weylGroup.ofIdx P j)
        rw [base.wordProd_mul_ofIdx, ← mul_assoc]
        change base.wordProd l = base.simpleReflection k *
          RootPairing.weylGroup.ofIdx P
            (P.weylGroupToPerm (base.wordProd l) j) * base.wordProd l
        rw [heq]
        change base.wordProd l =
          (base.simpleReflection k * base.simpleReflection k) *
            base.wordProd l
        simp
      · obtain ⟨p, i, q, hdecomp, hindex, hprod⟩ := ih hpos
        refine ⟨k :: p, i, q, ?_, hindex, ?_⟩
        · simp only [List.cons_append, List.cons.injEq, true_and]
          exact hdecomp
        · simp only [List.cons_append, base.wordProd_cons]
          rw [hprod]
          simp only [mul_assoc]

include hActual in
private theorem simpleWord_move_root (l : List base.support) (alpha : D.Root) :
    torusRelated data weights
      (simpleWord data weights l * pN data weights alpha 1)
      (pN data weights
          (e.symm (P.weylGroupToPerm (base.wordProd l) (e alpha))) 1 *
        simpleWord data weights l) := by
  induction l with
  | nil => simp [simpleWord, torusRelated_refl]
  | cons i l ih =>
      let gammaIndex := P.weylGroupToPerm (base.wordProd l) (e alpha)
      let gamma := e.symm gammaIndex
      have hreflect : D.reflect (e.symm i) gamma =
          e.symm (P.reflectionPerm i gammaIndex) := by
        apply e.injective
        rw [hActual.2.1]
        simp [gamma, gammaIndex]
      have hleft := torusRelated_mul_left (hActual := hActual) data weights
        (pN_mem_presentedNormalizer data weights (e.symm i) 1) ih
      have hswap := torusRelated_mul_right data weights
        (pN_swap (hActual := hActual) data weights gamma (e.symm i))
        (simpleWord data weights l)
      have hswap' : torusRelated data weights
          (pN data weights (e.symm i) 1 *
            (pN data weights gamma 1 * simpleWord data weights l))
          (pN data weights (D.reflect (e.symm i) gamma) 1 *
            (pN data weights (e.symm i) 1 * simpleWord data weights l)) := by
        simpa only [mul_assoc] using hswap
      have h := torusRelated_trans data weights hleft (by
        simpa only [gamma] using hswap')
      rw [hreflect] at h
      have haction :
          P.weylGroupToPerm (base.wordProd (i :: l)) (e alpha) =
            P.reflectionPerm i gammaIndex := by
        rw [base.wordProd_cons]
        rfl
      rw [haction]
      simpa only [simpleWord_cons, mul_assoc, gammaIndex] using h

include hActual in
private theorem simpleWord_delete_last (l : List base.support)
    (j : base.support)
    (hneg : ¬ base.IsPos (P.weylGroupToPerm (base.wordProd l) j)) :
    ∃ l' : List base.support,
      torusRelated data weights
        (simpleWord data weights l * pN data weights (e.symm j) 1)
        (simpleWord data weights l') ∧
      base.wordProd l' = base.wordProd l * base.simpleReflection j ∧
      l'.length < l.length := by
  obtain ⟨p, i, q, hdecomp, hindex, hprod⟩ :=
      strongExchange_index l j hneg
  refine ⟨p ++ q, ?_, hprod, ?_⟩
  · have hmove := simpleWord_move_root
      (hActual := hActual) data weights q (e.symm j)
    simp only [e.apply_symm_apply, hindex] at hmove
    have hpNi :
        simpleWord data weights p * pN data weights (e.symm i) 1 ∈
          presentedNormalizer data weights :=
      (presentedNormalizer data weights).mul_mem
        (simpleWord_mem_presentedNormalizer data weights p)
        (pN_mem_presentedNormalizer data weights _ _)
    have hstep1 := torusRelated_mul_left
      (hActual := hActual) data weights hpNi hmove
    have hsquare := pN_square_related_one data weights (e.symm i)
    have hstep2 := torusRelated_mul_left (hActual := hActual) data weights
      (simpleWord_mem_presentedNormalizer data weights p)
      (torusRelated_mul_right data weights hsquare
        (simpleWord data weights q))
    have h := torusRelated_trans data weights hstep1 (by
      simpa only [mul_assoc, one_mul] using hstep2)
    rw [hdecomp, simpleWord_append, simpleWord_cons, simpleWord_append]
    simpa only [mul_assoc] using h
  · rw [hdecomp]
    simp

include hActual in
private theorem simpleWord_reduce (l : List base.support) :
    ∃ r : List base.support,
      torusRelated data weights (simpleWord data weights l)
        (simpleWord data weights r) ∧
      base.wordProd r = base.wordProd l ∧
      r.length = base.wordLength (base.wordProd r) := by
  induction l using List.reverseRecOn with
  | nil =>
      exact ⟨[], torusRelated_refl data weights _, rfl, by simp⟩
  | append_singleton l j ih =>
      obtain ⟨r, hrel, hprod, hred⟩ := ih
      have hprefix : torusRelated data weights
          (simpleWord data weights (l ++ [j]))
          (simpleWord data weights (r ++ [j])) := by
        simpa [simpleWord_append, simpleWord] using
          torusRelated_mul_right data weights hrel
            (pN data weights (e.symm j) 1)
      by_cases hpos :
          base.IsPos (P.weylGroupToPerm (base.wordProd r) j)
      · refine ⟨r ++ [j], hprefix, ?_, ?_⟩
        · simp [base.wordProd_append, hprod]
        · simp only [List.length_append, List.length_singleton,
            base.wordProd_append, base.wordProd_cons, base.wordProd_nil,
            mul_one]
          rw [base.wordLength_mul_simpleReflection_of_isPos _ _ hpos,
            ← hred]
      · obtain ⟨q, hqrel, hqprod, hqlt⟩ :=
          simpleWord_delete_last (hActual := hActual) data weights r j hpos
        refine ⟨q, torusRelated_trans data weights hprefix ?_, ?_, ?_⟩
        · simpa [simpleWord_append, simpleWord] using hqrel
        · simpa [base.wordProd_append, hprod] using hqprod
        · have hdec := base.wordLength_mul_simpleReflection_of_not_isPos
            (base.wordProd r) j hpos
          have hmin := base.wordLength_le (base.wordProd q) q rfl
          rw [hqprod] at hmin ⊢
          rw [← hred] at hdec
          omega

private theorem pN_inv_related (alpha : D.Root) :
    torusRelated data weights (pN data weights alpha 1)⁻¹
      (pN data weights alpha 1) := by
  have h := (baseTorus data weights).inv_mem
    (pH_mem_baseTorus data weights alpha (-1))
  rw [← pN_square] at h
  simpa [torusRelated, mul_inv_rev] using h

include hActual in
private theorem simpleWord_inv_related (l : List base.support) :
    torusRelated data weights (simpleWord data weights l)⁻¹
      (simpleWord data weights l.reverse) := by
  induction l using List.reverseRecOn with
  | nil => exact torusRelated_refl data weights 1
  | append_singleton l j ih =>
      have h := torusRelated_mul (hActual := hActual) data weights
        (pN_mem_presentedNormalizer data weights (e.symm j) 1)
        (pN_inv_related data weights (e.symm j)) ih
      simpa [simpleWord_append, simpleWord, List.reverse_append,
        mul_inv_rev] using h

include hActual in
private theorem pN_related_simpleWord (alpha : D.Root) :
    ∃ r : List base.support,
      torusRelated data weights (pN data weights alpha 1)
        (simpleWord data weights r) ∧
      r.length = base.wordLength (base.wordProd r) := by
  obtain ⟨g, j, hj, hroot⟩ :=
    weylGroup_orbit_meets_base P base (e alpha)
  let j' : base.support := ⟨j, hj⟩
  have hperm : P.weylGroupToPerm g (e alpha) = j := by
    apply P.root.injective
    rw [← P.weylGroup_apply_root]
    exact hroot
  obtain ⟨l, hl⟩ := base.exists_wordProd_eq g
  have hmove := simpleWord_move_root
    (hActual := hActual) data weights l alpha
  rw [hl, hperm] at hmove
  change torusRelated data weights
    (simpleWord data weights l * pN data weights alpha 1)
    (pN data weights (e.symm j') 1 * simpleWord data weights l) at hmove
  have hleft := torusRelated_mul_left (hActual := hActual) data weights
    ((presentedNormalizer data weights).inv_mem
      (simpleWord_mem_presentedNormalizer data weights l)) hmove
  have hconj : torusRelated data weights (pN data weights alpha 1)
      ((simpleWord data weights l)⁻¹ *
        pN data weights (e.symm j') 1 * simpleWord data weights l) := by
    simpa [mul_assoc] using hleft
  have hinv := simpleWord_inv_related (hActual := hActual) data weights l
  have hreplace := torusRelated_mul_right data weights
    (torusRelated_mul_right data weights hinv
      (pN data weights (e.symm j') 1))
    (simpleWord data weights l)
  have hword : torusRelated data weights (pN data weights alpha 1)
      (simpleWord data weights (l.reverse ++ j' :: l)) := by
    apply torusRelated_trans data weights hconj
    simpa [simpleWord_append, simpleWord, mul_assoc] using hreplace
  obtain ⟨r, hreduce, -, hred⟩ :=
    simpleWord_reduce (hActual := hActual) data weights (l.reverse ++ j' :: l)
  exact ⟨r, torusRelated_trans data weights hword hreduce, hred⟩

include hActual in
private theorem torusRelated_inv {x y : Q data weights}
    (hx : x ∈ presentedNormalizer data weights)
    (hxy : torusRelated data weights x y) :
    torusRelated data weights x⁻¹ y⁻¹ := by
  have hinv := (baseTorus data weights).inv_mem hxy
  have hnorm := presentedNormalizer_le_normalizer
    (hActual := hActual) data weights
    ((presentedNormalizer data weights).inv_mem hx)
  have hconj :=
    (Subgroup.mem_normalizer_iff.mp hnorm (y * x⁻¹)).mp (by
      simpa [torusRelated, mul_inv_rev] using hinv)
  simpa [torusRelated, mul_inv_rev, mul_assoc] using hconj

include hActual in
private theorem presentedNormalizer_related_reduced {x : Q data weights}
    (hx : x ∈ presentedNormalizer data weights) :
    ∃ l : List base.support,
      torusRelated data weights x (simpleWord data weights l) ∧
      l.length = base.wordLength (base.wordProd l) := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
      rcases hx with ⟨z, rfl⟩
      cases z with
      | inl z =>
          have hparameter := pN_parameter_related
            (hActual := hActual) data weights z.1 z.2
          obtain ⟨l, hword, hred⟩ :=
            pN_related_simpleWord (hActual := hActual) data weights z.1
          exact ⟨l, torusRelated_trans data weights hparameter hword, hred⟩
      | inr z =>
          exact ⟨[], by simpa using pH_related_one data weights z.1 z.2,
            by simp⟩
  | one =>
      exact ⟨[], torusRelated_refl data weights 1, by simp⟩
  | mul x y hx hy ihx ihy =>
      obtain ⟨l, hl, hlred⟩ := ihx
      obtain ⟨m, hm, hmred⟩ := ihy
      have hmul := torusRelated_mul (hActual := hActual) data weights
        (simpleWord_mem_presentedNormalizer data weights l) hl hm
      have hcat : torusRelated data weights (x * y)
          (simpleWord data weights (l ++ m)) := by
        simpa [simpleWord_append] using hmul
      obtain ⟨r, hreduce, -, hrred⟩ :=
        simpleWord_reduce (hActual := hActual) data weights (l ++ m)
      exact ⟨r, torusRelated_trans data weights hcat hreduce, hrred⟩
  | inv x hx ih =>
      obtain ⟨l, hl, hlred⟩ := ih
      have hinv := torusRelated_inv (hActual := hActual) data weights hx hl
      have hreverse := simpleWord_inv_related
        (hActual := hActual) data weights l
      have hword := torusRelated_trans data weights hinv hreverse
      obtain ⟨r, hreduce, -, hrred⟩ :=
        simpleWord_reduce (hActual := hActual) data weights l.reverse
      exact ⟨r, torusRelated_trans data weights hword hreduce, hrred⟩

private theorem baseWord_mem_baseTorus (l : List (base.support × kˣ)) :
    baseWord data weights l ∈ baseTorus data weights := by
  apply Subgroup.list_prod_mem
  intro x hx
  simp only [List.mem_map] at hx
  rcases hx with ⟨z, -, rfl⟩
  exact Subgroup.subset_closure ⟨z, rfl⟩

include hActual in
private theorem simpleWord_conj_H (l : List base.support)
    (alpha : D.Root) (t : kˣ) :
    simpleWord data weights l * pH data weights alpha t *
        (simpleWord data weights l)⁻¹ =
      pH data weights
        (e.symm (P.weylGroupToPerm (base.wordProd l) (e alpha))) t := by
  induction l with
  | nil => simp
  | cons i l ih =>
      rw [simpleWord_cons, mul_inv_rev]
      calc
        (pN data weights (e.symm i) 1 * simpleWord data weights l) *
              pH data weights alpha t *
            ((simpleWord data weights l)⁻¹ *
              (pN data weights (e.symm i) 1)⁻¹) =
          pN data weights (e.symm i) 1 *
            (simpleWord data weights l * pH data weights alpha t *
              (simpleWord data weights l)⁻¹) *
            (pN data weights (e.symm i) 1)⁻¹ := by group
        _ = pN data weights (e.symm i) 1 *
            pH data weights
              (e.symm
                (P.weylGroupToPerm (base.wordProd l) (e alpha))) t *
            (pN data weights (e.symm i) 1)⁻¹ := by rw [ih]
        _ = pH data weights
            (D.reflect (e.symm i)
              (e.symm
                (P.weylGroupToPerm (base.wordProd l) (e alpha)))) t := by
              rw [pN_conj_pH data weights e base hActual]
        _ = pH data weights
            (e.symm
              (P.weylGroupToPerm (base.wordProd (i :: l)) (e alpha))) t := by
              congr 2
              apply e.injective
              rw [hActual.2.1, base.wordProd_cons]
              simp only [e.apply_symm_apply]
              rfl

include hActual in
public theorem presentedChevalley_normalizerWord_normalForm
    (z : PresentedGroup (generalChevalleyRelators data weights))
    (hz : z ∈ presentedChevalleyNormalizer data weights) :
    ∃ torusWord : List (base.support × kˣ),
      ∃ reflectionWord : List base.support,
        z = presentedChevalleyBaseTorusWord data weights torusWord *
            presentedChevalleySimpleWord data weights reflectionWord ∧
        reflectionWord.length =
          base.wordLength (base.wordProd reflectionWord) ∧
        (∀ alpha : D.Root, ∀ t : kˣ,
          Commute
            (presentedChevalleyBaseTorusWord data weights torusWord)
            (presentedChevalleyH data weights alpha t)) ∧
        (∀ alpha : D.Root, ∀ t : kˣ,
          z * presentedChevalleyH data weights alpha t * z⁻¹ =
            presentedChevalleyH data weights
              (e.symm
                (P.weylGroupToPerm (base.wordProd reflectionWord) (e alpha))) t) ∧
        (base.wordProd reflectionWord = 1 →
          z = presentedChevalleyBaseTorusWord data weights torusWord) := by
  obtain ⟨reflectionWord, hrelated, hreduced⟩ :=
    presentedNormalizer_related_reduced
      (hActual := hActual) data weights hz
  obtain ⟨torusWord, htorus⟩ :=
    baseTorus_has_word data weights _ hrelated
  have hzform : z = baseWord data weights torusWord *
      simpleWord data weights reflectionWord := by
    calc
      z = (z * (simpleWord data weights reflectionWord)⁻¹) *
          simpleWord data weights reflectionWord := by group
      _ = baseWord data weights torusWord *
          simpleWord data weights reflectionWord := by rw [htorus]
  refine ⟨torusWord, reflectionWord, hzform, hreduced, ?_, ?_, ?_⟩
  · intro alpha t
    exact baseTorus_commute data weights
      (baseWord_mem_baseTorus data weights torusWord)
      (pH_mem_baseTorus data weights alpha t)
  · intro alpha t
    let gamma := e.symm
      (P.weylGroupToPerm (base.wordProd reflectionWord) (e alpha))
    have hcomm : Commute (baseWord data weights torusWord)
        (pH data weights gamma t) :=
      baseTorus_commute data weights
        (baseWord_mem_baseTorus data weights torusWord)
        (pH_mem_baseTorus data weights gamma t)
    rw [hzform, mul_inv_rev]
    calc
      (baseWord data weights torusWord *
            simpleWord data weights reflectionWord) *
          pH data weights alpha t *
          ((simpleWord data weights reflectionWord)⁻¹ *
            (baseWord data weights torusWord)⁻¹) =
        baseWord data weights torusWord *
          (simpleWord data weights reflectionWord *
            pH data weights alpha t *
              (simpleWord data weights reflectionWord)⁻¹) *
          (baseWord data weights torusWord)⁻¹ := by group
      _ = baseWord data weights torusWord * pH data weights gamma t *
          (baseWord data weights torusWord)⁻¹ := by
            rw [simpleWord_conj_H (hActual := hActual)]
      _ = pH data weights gamma t := by
            rw [hcomm.eq]
            simp
  · intro htrivial
    have hlength : reflectionWord.length = 0 := by
      rw [hreduced, htrivial, base.wordLength_one]
    have hnil : reflectionWord = [] := List.length_eq_zero_iff.mp hlength
    simpa [hnil] using hzform

end Theory.AlgebraicGroup
