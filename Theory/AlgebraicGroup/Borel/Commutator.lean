module

public import Theory.AlgebraicGroup.Borel.AdjointCenter
public import Theory.AlgebraicGroup.RootSubgroups.NormalizerMembership
public import Theory.AlgebraicGroup.Tori.Maximal

universe u

/-! A group-theoretic assembly lemma for derived subgroup calculations. -/

namespace Theory.AlgebraicGroup

/-- A normal subgroup is the derived subgroup when it lies in the derived
subgroup and, together with a commutative subgroup, generates the whole group. -/
public theorem commutator_eq_of_normal_le_and_sup_commutative_eq_top
    {G : Type u} [Group G] {N H : Subgroup G} [N.Normal]
    (hN : N ≤ _root_.commutator G) (hNH : N ⊔ H = ⊤)
    (hH : IsMulCommutative H) :
    _root_.commutator G = N := by
  exact le_antisymm
    (Subgroup.Normal.commutator_le_of_self_sup_commutative_eq_top hNH hH) hN

section

variable {k : Type u} [Field k] [IsAlgClosed k]

omit [IsAlgClosed k] in
/-- If every realized root weight is nontrivial, the subgroup generated by all
root subgroups lies in the derived subgroup. -/
public theorem rootSubgroupGenerated_le_commutator_of_weights_ne_one
    {K : Variety k} [AlgebraicGroup K] (T : ClosedSubgroup K)
    (D : RootGroupData K T) (hD : D.IsRealization)
    (hne : ∀ α, D.rootWeight α ≠ 1) :
    RootSubgroupGenerated D Set.univ ≤
      _root_.commutator (Variety.Point K) := by
  rw [RootSubgroupGenerated, Subgroup.closure_le]
  intro g hg
  simp only [Set.mem_iUnion] at hg
  obtain ⟨α, _, hg⟩ := hg
  exact rootSubgroup_le_commutator_of_weight_ne_one T (D.rootSubgroup α)
    (D.rootWeight α) (hD.2.2.1 α).1 (hD.2.2.1 α).2 (hne α) hg

/-- For a self-centralizing torus, the subgroup generated by all realized root
subgroups lies in the derived subgroup. -/
public theorem rootSubgroupGenerated_le_commutator_of_centralizer_eq
    {K : Variety k} [AlgebraicGroup K] (T : ClosedSubgroup K)
    (D : RootGroupData K T) (hD : D.IsRealization)
    (hT : IsSubtorus T)
    (hcentralizer : T.centralizer.toSubgroup = T.toSubgroup) :
    RootSubgroupGenerated D Set.univ ≤
      _root_.commutator (Variety.Point K) := by
  apply rootSubgroupGenerated_le_commutator_of_weights_ne_one T D hD
  intro α
  exact IsTorusRootSubgroup.rootWeight_ne_one_of_centralizer_eq hT hcentralizer
    (hD.2.2.1 α).1 (D.rootWeight α) (hD.2.2.1 α).2

/-- Self-centralization of a maximal torus and generation by that torus and
the root subgroups identify the derived subgroup. -/
public theorem derivedSubgroup_eq_rootSubgroupGenerated_of_centralizer_and_generation
    {K : Variety k} [AlgebraicGroup K] (T : ClosedSubgroup K)
    (D : RootGroupData K T) (hT : IsMaximalTorus T) (hD : D.IsRealization)
    (hcentralizer : T.centralizer.toSubgroup = T.toSubgroup)
    (hgen : RootSubgroupGenerated D Set.univ ⊔ T.toSubgroup = ⊤) :
    ⁅(⊤ : Subgroup (Variety.Point K)), ⊤⁆ =
      RootSubgroupGenerated D Set.univ := by
  let : (RootSubgroupGenerated D Set.univ).Normal :=
    rootSubgroupGenerated_normal_of_sup_torus_eq_top T D
      (fun α => (hD.2.2.1 α).1.1) hgen
  have hderived := rootSubgroupGenerated_le_commutator_of_centralizer_eq
    T D hD hT.1 hcentralizer
  have hTcomm : IsMulCommutative T.toSubgroup :=
    Subgroup.le_centralizer_iff_isMulCommutative.mp
      (maximalTorus_le_centralizer hT)
  exact commutator_eq_of_normal_le_and_sup_commutative_eq_top
    hderived hgen hTcomm

end

open scoped Pointwise

/-- In a connected topological group, a subgroup containing two subgroups
whose pointwise product is open is the whole group. -/
public theorem subgroup_eq_top_of_contains_subgroups_with_open_product
    {G : Type u} [Group G] [TopologicalSpace G] [SeparatelyContinuousMul G]
    (H B Bopp : Subgroup G)
    (hconn : IsConnected (Set.univ : Set G))
    (hB : B ≤ H) (hBopp : Bopp ≤ H)
    (hopen : IsOpen ((B : Set G) * (Bopp : Set G))) :
    H = ⊤ := by
  have hone : (1 : G) ∈ (B : Set G) * (Bopp : Set G) := by
    simpa using Set.mul_mem_mul B.one_mem Bopp.one_mem
  have hproduct : (B : Set G) * (Bopp : Set G) ⊆ H := by
    intro x hx
    obtain ⟨b, hb, bopp, hbopp, rfl⟩ := Set.mem_mul.mp hx
    exact H.mul_mem (hB hb) (hBopp hbopp)
  have hHopen : IsOpen (H : Set G) :=
    Subgroup.isOpen_of_mem_nhds H
      (Filter.mem_of_superset (hopen.mem_nhds hone) hproduct)
  have hHclosed : IsClosed (H : Set G) :=
    Subgroup.isClosed_of_isOpen H hHopen
  have hHuniv : (H : Set G) = Set.univ := by
    by_contra hne
    rcases hconn with ⟨_, hpreconn⟩
    have hHne : ((Set.univ : Set G) ∩ (H : Set G)).Nonempty :=
      ⟨1, Set.mem_univ 1, H.one_mem⟩
    have hHcne : ((Set.univ : Set G) ∩ (H : Set G)ᶜ).Nonempty := by
      obtain ⟨x, hx⟩ := Set.nonempty_compl.mpr hne
      exact ⟨x, Set.mem_univ x, hx⟩
    have hinter := hpreconn (H : Set G) (H : Set G)ᶜ
      hHopen hHclosed.isOpen_compl
      (by
        intro x _
        by_cases hx : x ∈ H
        · exact Or.inl hx
        · exact Or.inr hx)
      hHne hHcne
    obtain ⟨x, _, hxH, hxHc⟩ := hinter
    exact hxHc hxH
  apply SetLike.ext'
  simpa using hHuniv

open scoped Pointwise Topology

/-- In a connected topological group, a subgroup containing two subgroups is
the whole group as soon as their pointwise product is a neighborhood of one.
-/
public theorem subgroup_eq_top_of_contains_subgroups_with_product_mem_nhds_one
    {G : Type u} [Group G] [TopologicalSpace G] [SeparatelyContinuousMul G]
    (H B C : Subgroup G)
    (hconn : IsConnected (Set.univ : Set G))
    (hB : B ≤ H) (hC : C ≤ H)
    (hnhds : ((B : Set G) * (C : Set G)) ∈ 𝓝 (1 : G)) :
    H = ⊤ := by
  have hproduct : (B : Set G) * (C : Set G) ⊆ H := by
    intro x hx
    obtain ⟨b, hb, c, hc, rfl⟩ := Set.mem_mul.mp hx
    exact H.mul_mem (hB hb) (hC hc)
  have hHopen : IsOpen (H : Set G) :=
    Subgroup.isOpen_of_mem_nhds H (Filter.mem_of_superset hnhds hproduct)
  have hHclosed : IsClosed (H : Set G) :=
    Subgroup.isClosed_of_isOpen H hHopen
  have hHuniv : (H : Set G) = Set.univ := by
    by_contra hne
    rcases hconn with ⟨_, hpreconn⟩
    have hHne : ((Set.univ : Set G) ∩ (H : Set G)).Nonempty :=
      ⟨1, Set.mem_univ 1, H.one_mem⟩
    have hHcne : ((Set.univ : Set G) ∩ (H : Set G)ᶜ).Nonempty := by
      obtain ⟨x, hx⟩ := Set.nonempty_compl.mpr hne
      exact ⟨x, Set.mem_univ x, hx⟩
    have hinter := hpreconn (H : Set G) (H : Set G)ᶜ
      hHopen hHclosed.isOpen_compl
      (by
        intro x _
        by_cases hx : x ∈ H
        · exact Or.inl hx
        · exact Or.inr hx)
      hHne hHcne
    obtain ⟨x, _, hxH, hxHc⟩ := hinter
    exact hxHc hxH
  apply SetLike.ext'
  simpa using hHuniv

end Theory.AlgebraicGroup
