module

public import Theory.AlgebraicGroup.Borel.IntersectionGeometry.FixedTorusCommonRoots.PositiveCharacterSupport.IntegralReflection
public import Theory.AlgebraicGroup.Borel.StandardPositiveSystemClassification.Defs
public import Theory.AlgebraicGroup.Reductive.Defs
public import Theory.AlgebraicGroup.RootSubgroups.Cocharacter
public import Theory.AlgebraicGroup.RootSubgroups.Finite

/-!
# Positive-character support for actual Borel roots

An actual root character in the monoid generated by a positive system belongs
to that system. Actual root finiteness comes from the tangent representation,
and the character lattice of a torus is finite free. The chosen algebraic
coroots provide integral linear functionals and the realized reflection
formula. `PositiveCharacterSupport.mem_of_root_sum` constructs the corresponding
root pairing on the actual root span and reduces a character sum to successive
root additions. Addition completeness and the positive system's closure then
finish the argument.

In fact these inputs suffice already for a subtorus, without reductivity or a
Borel witness. The final theorem specializes this stronger result to the exact
compatible Borel witnesses used in GLS3, Theorem 1.11.4. It discharges the
positive-character-support premise of the parent common-root argument; it
does not assert the entire Borel-intersection theorem.

Source: Borel, *Linear Algebraic Groups*, IV, §§14.5–14.8, in particular the
closed-root-set sum argument of §14.7, printed p.188. The supplied TeX excerpt
omits §§14.6–14.8; these were checked in the authorized book PDF.
-/

namespace Theory.AlgebraicGroup

universe u

variable {k : Type u} [Field k] [IsAlgClosed k]

omit [IsAlgClosed k] in
private theorem exists_root_list
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (D : RootGroupData G T) (S : Set D.Root) (weights : List (TorusWeight T))
    (hweights : ∀ χ ∈ weights, χ ∈ D.rootWeight '' S) :
    ∃ roots : List D.Root, (∀ a ∈ roots, a ∈ S) ∧ roots.map D.rootWeight = weights := by
  induction weights with
  | nil => exact ⟨[], by simp, rfl⟩
  | cons χ weights ih =>
      obtain ⟨a, haS, ha⟩ := hweights χ (by simp)
      obtain ⟨roots, hroots, heq⟩ := ih (by
        intro ψ hψ
        exact hweights ψ (by simp [hψ]))
      refine ⟨a :: roots, ?_, ?_⟩
      · intro b hb
        rcases List.mem_cons.mp hb with rfl | hb
        · exact haS
        · exact hroots b hb
      · simp [ha, heq]

/-- Character support in a positive system reflects membership of actual roots. -/
public theorem positiveSystem_mem_of_rootWeight_mem_closure
    {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
    (hT : IsSubtorus T) (D : RootGroupData G T) (hD : D.IsRealization)
    (hAdd : D.IsRootAdditionComplete) (P : Set D.Root) (hP : IsPositiveSystem D P)
    (a : D.Root) (ha : D.rootWeight a ∈ Submonoid.closure (D.rootWeight '' P)) :
    a ∈ P := by
  classical
  obtain ⟨n, ⟨e⟩⟩ := hT
  obtain ⟨basis⟩ := torus_character_basis_of_iso n e
  let : Module.Free ℤ (Additive (TorusWeight T)) := Module.Free.of_basis basis
  let : Module.Finite ℤ (Additive (TorusWeight T)) := Module.Finite.of_basis basis
  have hfinite : (Set.univ : Set D.Root).Finite := by
    apply Set.Finite.of_finite_image (f := D.rootWeight)
    · simpa only [Set.image_univ, hD.2.1] using torusRootSet_finite T
    · exact hD.1.injOn
  let : Finite D.Root := Set.finite_univ_iff.mp hfinite
  let r : D.Root ↪ Additive (TorusWeight T) :=
    ⟨fun b => Additive.ofMul (D.rootWeight b), Additive.ofMul.injective.comp hD.1⟩
  let c (b : D.Root) : Module.Dual ℤ (Additive (TorusWeight T)) :=
    (D.characterCorootPairing b).toIntLinearMap
  have htwo (b : D.Root) : c b (r b) = 2 := by
    change D.characterCorootPairing b (Additive.ofMul (D.rootWeight b)) = 2
    rw [hD.characterCorootPairing_rootWeight]
    exact hD.2.2.2.2.2.2.1 b
  have href (b d : D.Root) :
      r (D.reflect b d) = r d - c b (r d) • r b := by
    change Additive.ofMul (D.rootWeight (D.reflect b d)) =
      Additive.ofMul (D.rootWeight d) -
        D.characterCorootPairing b (Additive.ofMul (D.rootWeight d)) •
          Additive.ofMul (D.rootWeight b)
    rw [hD.characterCorootPairing_rootWeight, hD.2.2.2.2.2.1 b d]
    simp [sub_eq_add_neg]
  obtain ⟨weights, hweights, hprod⟩ := Submonoid.exists_list_of_mem_closure ha
  obtain ⟨roots, hroots, hmap⟩ := exists_root_list D P weights hweights
  have hprod' : (roots.map D.rootWeight).prod = D.rootWeight a := by
    rw [hmap]
    exact hprod
  have hsum : r a = (roots.map r).sum := by
    change Additive.ofMul (D.rootWeight a) =
      (roots.map fun b => Additive.ofMul (D.rootWeight b)).sum
    rw [← hprod']
    simp only [ofMul_list_prod, List.map_map, Function.comp_def]
  apply PositiveCharacterSupport.mem_of_root_sum r c D.reflect htwo href P
    (fun b hb d hd g hg => ?_) roots a hroots hsum
  apply hP.2.2 b hb d hd g
  apply hAdd
  exact congrArg Additive.toMul hg

/-- Positive-character support for the compatible Borel witnesses used in the
common-root formula for Borel intersections. -/
public theorem fixedTorus_positive_character_support
    {G : Variety k} [AlgebraicGroup G] (_hG : IsReductiveAlgebraicGroup G)
    {T : ClosedSubgroup G} (hT : IsMaximalTorus T)
    (D : RootGroupData G T) (hD : D.IsRealization) (hAdd : D.IsRootAdditionComplete)
    (P : Set D.Root) (hP : IsPositiveSystem D P)
    (B : ClosedSubgroup G) (_hBP : IsBorelOfPositiveSystem D P B) :
    ∀ a, D.rootWeight a ∈ Submonoid.closure (D.rootWeight '' P) → a ∈ P :=
  positiveSystem_mem_of_rootWeight_mem_closure hT.1 D hD hAdd P hP

end Theory.AlgebraicGroup
