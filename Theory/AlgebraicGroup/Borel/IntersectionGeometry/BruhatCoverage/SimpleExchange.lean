module

public import Theory.AlgebraicGroup.Borel.IntersectionGeometry.BruhatCoverage.SimpleExchange.RootGeometry

/-!
Conditional construction of simple lifts and their two-cell exchange law.

The positive-root subgroup is the product of the subgroup generated by all
but the selected simple root and the selected root subgroup. The relative
normalization input makes this a pointwise product, rather than just a join.
The reflection carries the torus and the remaining positive factors into the
Borel. The actual `SL₂` calculation then handles the final simple-root factor,
with its normalizer conjugate's sign selecting the cell.

This supplies the group calculation in GLS3, Theorem 1.11.3, and Borel, §14.15
T2/T3. The existence of `SimpleExchangeRootGeometry` and
`SimpleRootRemainderNormalization` from reductivity is still required; the
conditional results here do not assert that source theorem.
-/

universe u

namespace Theory.AlgebraicGroup.BorelIntersectionGeometry

open scoped Pointwise

variable {k : Type u} [Field k]
    {G : Variety k} [AlgebraicGroup G] {B T : ClosedSubgroup G}

namespace SimpleExchangeRootGeometry

variable (R : SimpleExchangeRootGeometry B T)

private theorem borel_eq :
    B.toSubgroup = T.toSubgroup ⊔ RootSubgroupGenerated R.data R.positive := by
  rw [R.borel.torus_unipotent_generate, R.borel.root_generated]

include R in
private theorem torus_le : T.toSubgroup ≤ B.toSubgroup := by
  rw [R.borel_eq]
  exact le_sup_left

private theorem positive_le : RootSubgroupGenerated R.data R.positive ≤ B.toSubgroup := by
  rw [R.borel_eq]
  exact le_sup_right

/-- Collect the selected simple-root factor last, leaving a Borel factor whose
conjugate by the selected reflection is again in the Borel. -/
public theorem exists_simple_factor
    (hrem : SimpleRootRemainderNormalization R.data R.positive)
    (i : {α // α ∈ FundamentalRootsFor R.data R.positive})
    (b : Variety.Point G) (hb : b ∈ B.toSubgroup) :
    ∃ b₀ t, b₀ ∈ B.toSubgroup ∧
      R.rankOne i BruhatGeneration.SL2.reflection * b₀ *
        (R.rankOne i BruhatGeneration.SL2.reflection)⁻¹ ∈ B.toSubgroup ∧
      b = b₀ * R.rankOne i (BruhatGeneration.SL2.upper t) := by
  let V := RootSubgroupGenerated R.data (R.positive \ {i.val})
  let A := (R.data.rootSubgroup i.val).toSubgroup
  let U := RootSubgroupGenerated R.data R.positive
  let s := R.rankOne i BruhatGeneration.SL2.reflection
  have hi : i.val ∈ R.positive := i.property.1
  have hU : U = V ⊔ A := by
    have hsets : R.positive = (R.positive \ {i.val}) ∪ {i.val} := by
      ext α
      simp only [Set.mem_union, Set.mem_sdiff, Set.mem_singleton_iff]
      constructor
      · intro hα
        by_cases heq : α = i.val
        · exact Or.inr heq
        · exact Or.inl ⟨hα, heq⟩
      · rintro (⟨hα, _⟩ | rfl)
        · exact hα
        · exact hi
    dsimp [U, V, A]
    conv_lhs => rw [hsets]
    rw [RootSubgroupGenerated_union, RootSubgroupGenerated_singleton]
  have hVle : V ≤ B.toSubgroup :=
    (RootSubgroupGenerated_mono R.data Set.sdiff_subset).trans R.positive_le
  have hVconj : V ≤ B.toSubgroup.comap (MulAut.conj s).toMonoidHom := by
    apply RootSubgroupGenerated_le_of_rootSubgroup_le
    intro β hβ x hx
    change s * x * s⁻¹ ∈ B.toSubgroup
    exact R.reflection_other_positive i β hβ.1 hβ.2 x hx
  have hb' : b ∈ (T.toSubgroup : Set (Variety.Point G)) * (U : Set (Variety.Point G)) := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right T.toSubgroup U
      (torus_le_rootSubgroupGenerated_normalizer R.data R.realized R.positive)]
    rwa [← R.borel_eq]
  obtain ⟨t₀, ht₀, u, hu, rfl⟩ := Set.mem_mul.mp hb'
  have hu' : u ∈ (V : Set (Variety.Point G)) * (A : Set (Variety.Point G)) := by
    rw [← Subgroup.coe_mul_of_right_le_normalizer_left V A (hrem i.val i.property), ← hU]
    exact hu
  obtain ⟨v, hv, a, ha, rfl⟩ := Set.mem_mul.mp hu'
  have harange : a ∈ Set.range (fun t => R.rankOne i (BruhatGeneration.SL2.upper t)) := by
    rw [R.upper_range]
    exact ha
  obtain ⟨t, rfl⟩ := harange
  refine ⟨t₀ * v, t, B.toSubgroup.mul_mem (R.torus_le ht₀) (hVle hv), ?_, ?_⟩
  · have htconj : s * t₀ * s⁻¹ ∈ T.toSubgroup :=
      (Subgroup.mem_normalizer_iff.mp (R.reflection_mem i) t₀).mp ht₀
    have hvconj : s * v * s⁻¹ ∈ B.toSubgroup := hVconj hv
    have h := B.toSubgroup.mul_mem (R.torus_le htconj) hvconj
    have he : s * (t₀ * v) * s⁻¹ = (s * t₀ * s⁻¹) * (s * v * s⁻¹) := by group
    change s * (t₀ * v) * s⁻¹ ∈ B.toSubgroup
    rwa [he]
  · exact (mul_assoc _ _ _).symm

/-- Actual rank-one matrix homomorphisms give the local two-cell law once the
simple-root remainder normalization has been supplied. -/
public theorem simpleLiftExchange
    (hrem : SimpleRootRemainderNormalization R.data R.positive) :
    BruhatGeneration.SimpleLiftExchange B.toSubgroup T.normalizer.toSubgroup
      (Set.range fun i => R.rankOne i BruhatGeneration.SL2.reflection) := by
  apply BruhatGeneration.SL2.exchange B.toSubgroup T.toSubgroup T.normalizer.toSubgroup
    R.torus_le R.rankOne _ R.diagonal_mem (R.exists_simple_factor hrem) R.transport_sign
  intro i t
  apply R.positive_le
  apply rootSubgroup_le_RootSubgroupGenerated R.data i.property.1
  change R.rankOne i (BruhatGeneration.SL2.upper t) ∈
    (R.data.rootSubgroup i.val : Set (Variety.Point G))
  rw [← R.upper_range]
  exact ⟨t, rfl⟩

end SimpleExchangeRootGeometry

/-- Assemble the requested lift set from geometric root data and relative
normalization. Both inputs must be constructed to obtain the reductive result. -/
public theorem exists_simple_lifts_of_root_geometry
    (R : SimpleExchangeRootGeometry B T)
    (hrem : SimpleRootRemainderNormalization R.data R.positive) :
    ∃ S : Set (Variety.Point G),
      Subgroup.closure ((T.toSubgroup : Set (Variety.Point G)) ∪ S) =
          T.normalizer.toSubgroup ∧
        (∀ s ∈ S, s * s ∈ T.toSubgroup) ∧
        BruhatGeneration.SimpleLiftExchange B.toSubgroup T.normalizer.toSubgroup S := by
  refine ⟨Set.range (fun i => R.rankOne i BruhatGeneration.SL2.reflection),
    R.normalizer_generated, ?_, R.simpleLiftExchange hrem⟩
  rintro s ⟨i, rfl⟩
  rw [← map_mul, BruhatGeneration.SL2.reflection_square]
  exact R.diagonal_mem i _ _

end Theory.AlgebraicGroup.BorelIntersectionGeometry
