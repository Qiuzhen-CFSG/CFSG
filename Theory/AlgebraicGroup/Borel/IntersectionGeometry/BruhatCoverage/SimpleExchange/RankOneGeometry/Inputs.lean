module

public import Theory.AlgebraicGroup.Borel.IntersectionGeometry.BruhatCoverage.SimpleExchange.RootGeometry
public import Theory.AlgebraicGroup.RootSubgroups.SL2RootMarking

/-!
Independent geometric inputs to the SL₂ simple-root construction.

`SimpleRootMarkings` concerns local rank-one maps and their root reflection
formula. `NormalizerRootAction` concerns the actual normalizer's action on all
roots, including its torus kernel and Weyl-group image. Their existence can be
proved independently with the same supplied root data and positive system.
The parent module proves generation by the selected matrix lifts and the
upper-or-lower sign alternative from these inputs. These are conditional
interfaces, not existence assertions or substitutes for the source geometry.

Sources: GLS3, Theorem 1.9.5(f) and §§1.11–1.12; Borel, §§13.18, 14.6–14.8,
and 14.15 T2/T3. Borel §§14.6–14.12 are absent from the local transcription.
-/

universe u

namespace Theory.AlgebraicGroup.BorelIntersectionGeometry.RankOneGeometry

variable {k : Type u} [Field k]
variable {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}

/-- Local rank-one geometry: calibrated SL₂ maps at the actual fundamental
roots, whose reflection words induce the prescribed root reflections. -/
public structure SimpleRootMarkings (D : RootGroupData G T) (P : Set D.Root) where
  marking : (i : {α // α ∈ FundamentalRootsFor D P}) → SL2RootMarking D i.val
  reflection_root : ∀ i β,
    (D.rootSubgroup β).conjugate ((marking i).hom BruhatGeneration.SL2.reflection) =
      D.rootSubgroup (D.reflect i.val β)

/-- Global root geometry for the actual torus normalizer. The action is direct
conjugation, its kernel is exactly T inside N(T), and its image is the abstract
reflection group generated by the fundamental reflections. The last clause is
the positive-root property of a simple reflection. None of these geometric
facts is inferred merely from `RootGroupData.IsRealization`. -/
public structure NormalizerRootAction (D : RootGroupData G T) (P : Set D.Root) where
  action : T.normalizer.toSubgroup →* Equiv.Perm D.Root
  kernel : action.ker = T.toSubgroup.subgroupOf T.normalizer.toSubgroup
  transport : ∀ n α,
    (D.rootSubgroup α).conjugate n.val = D.rootSubgroup (action n α)
  neg : ∀ n α, action n (D.neg α) = D.neg (action n α)
  reflection : {α // α ∈ FundamentalRootsFor D P} → Equiv.Perm D.Root
  reflection_apply : ∀ i β, reflection i β = D.reflect i.val β
  range_eq : action.range = Subgroup.closure (Set.range reflection)
  other_positive : ∀ (i : {α // α ∈ FundamentalRootsFor D P}) β,
    β ∈ P → β ≠ i.val → D.reflect i.val β ∈ P

end Theory.AlgebraicGroup.BorelIntersectionGeometry.RankOneGeometry
