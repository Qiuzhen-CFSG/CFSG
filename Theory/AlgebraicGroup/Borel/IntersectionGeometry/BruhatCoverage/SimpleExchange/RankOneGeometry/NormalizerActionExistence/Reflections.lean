module
public import Theory.AlgebraicGroup.Borel.IntersectionGeometry.BruhatCoverage.SimpleExchange.RankOneGeometry.Inputs
public import Theory.AlgebraicGroup.RootSubgroups.Cocharacter

/-!
The reflections carried by realized root data are involutions. The key point is
that their pairing is an additive integral functional on actual torus characters,
not an arbitrary assignment on root indices. Evaluating a reflected character on
its coroot negates the pairing, so the second reflection cancels the first.
This supplies actual permutations before any normalizer realization is chosen.

Source: GLS3, 1.9.5(d) and Remarks 1.9.6.
-/
universe u
namespace Theory.AlgebraicGroup.BorelIntersectionGeometry.RankOneGeometry.NormalizerActionExistence
variable {k : Type u} [Field k] [IsAlgClosed k]
variable {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}
variable {D : RootGroupData G T} (hD : D.IsRealization)

include hD in
private theorem pairing_reflect (α β : D.Root) :
    D.pairing (D.reflect α β) α = -D.pairing β α := by
  rw [← hD.characterCorootPairing_rootWeight, hD.2.2.2.2.2.1]
  change D.characterCorootPairing α (Additive.ofMul (D.rootWeight β) +
    (-D.pairing β α) • Additive.ofMul (D.rootWeight α)) = _
  rw [map_add, map_zsmul, hD.characterCorootPairing_rootWeight,
    hD.characterCorootPairing_rootWeight, hD.2.2.2.2.2.2.1]
  simp only [zsmul_eq_mul, Int.cast_id]
  ring

include hD in
/-- The prescribed reflection is its own inverse on the actual root indices. -/
public theorem reflect_involutive (α : D.Root) : Function.Involutive (D.reflect α) := by
  intro β
  apply hD.1
  rw [hD.2.2.2.2.2.1, hD.2.2.2.2.2.1, pairing_reflect hD]
  simp only [neg_neg, zpow_neg]
  group

/-- The actual permutation with underlying function `D.reflect α`. -/
public noncomputable def reflectionPerm (α : D.Root) : Equiv.Perm D.Root where
  toFun := D.reflect α
  invFun := D.reflect α
  left_inv := reflect_involutive hD α
  right_inv := reflect_involutive hD α

public theorem reflectionPerm_apply (α β : D.Root) :
    reflectionPerm hD α β = D.reflect α β := by rfl

/-- The reflection sends its own root to the specified negative root. -/
public theorem reflectionPerm_self (α : D.Root) :
    reflectionPerm hD α α = D.neg α := by
  apply hD.1
  rw [reflectionPerm_apply, hD.2.2.2.2.2.1, hD.2.2.2.2.2.2.1, hD.2.2.2.1]
  group

/-- The subgroup of permutations generated by the actual fundamental reflections. -/
@[expose] public noncomputable def reflectionGroup (hD : D.IsRealization) (P : Set D.Root) :
    Subgroup (Equiv.Perm D.Root) :=
  Subgroup.closure (Set.range (fun i : {α // α ∈ FundamentalRootsFor D P} =>
    reflectionPerm hD i.val))


end Theory.AlgebraicGroup.BorelIntersectionGeometry.RankOneGeometry.NormalizerActionExistence
