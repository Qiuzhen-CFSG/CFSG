module

public import Theory.AlgebraicGroup.Borel.Defs
public import Theory.AlgebraicGroup.RootSubgroups.Defs
public import Theory.AlgebraicGroup.Unipotent.Radical

universe u

/-!
Public data for the standard-Borel classification in GLS3, Theorem 1.11.2.

`BorelContaining T` packages the Borel subgroups containing the fixed torus,
while `IsBorelOfPositiveSystem D positiveRoots B` records the source theorem's
identification of the unipotent radical with the subgroup generated by the
selected positive root subgroups and the factorization of `B` by that radical
and `T`.  Keeping these structures below the classification and numbered
theorem modules lets both geometric directions share the same stable API.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

public structure BorelContaining
    {K : Variety k} [AlgebraicGroup K] (T : ClosedSubgroup K) where
  carrier : ClosedSubgroup K
  isBorel : IsBorelSubgroup carrier
  torus_le : T ≤ carrier

public structure IsBorelOfPositiveSystem
    {K : Variety k} [AlgebraicGroup K]
    {T : ClosedSubgroup K} (D : RootGroupData K T)
    (positiveRoots : Set D.Root) (B : ClosedSubgroup K) where
  unipotent : ClosedSubgroup K
  root_generated :
    unipotent.toSubgroup = RootSubgroupGenerated D positiveRoots
  borel : IsBorelSubgroup B
  radical : IsUnipotentRadicalOf B unipotent
  torus_unipotent_generate :
    B.toSubgroup = T.toSubgroup ⊔ unipotent.toSubgroup

end Theory.AlgebraicGroup
