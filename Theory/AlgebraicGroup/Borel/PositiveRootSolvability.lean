module

public import Theory.AlgebraicGroup.Borel.SolvableRootContainment
public import Theory.AlgebraicGroup.Jordan.ClosedSubgroup
public import Theory.AlgebraicGroup.RootSubgroups.PositiveContraction
public import Theory.AlgebraicGroup.Unipotent.Basic

/-!
A geometric reduction for solvability of positive-root generated subgroups.

A positive integral character functional contracts every generated element.
Given the general implication from cocharacter contraction to unipotence,
finite connected-subgroup generation supplies a closed subgroup consisting
of unipotent elements. Its point group is solvable, hence lies with the torus
in a Borel by `exists_borelSubgroup_containing_solvable_roots`.

For the positive-root assertion of GLS3, Theorem 1.11.2 (Borel, §14.5), two
inputs remain explicit here: existence of a positive integral functional
for the selected positive system, and contraction implying unipotence.
The results below do not assert that these two geometric inputs are proved.
-/

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]
variable {G : Variety k} [AlgebraicGroup G]

variable [IsAlgClosed k] {T : ClosedSubgroup G}

private theorem rootSubgroupGenerated_isZariskiClosed
    (D : RootGroupData G T) (hD : D.IsRealization) (A : Set D.Root) :
    IsZariskiClosed G (RootSubgroupGenerated D A : Set (Variety.Point G)) := by
  let H : A → ClosedSubgroup G := fun alpha => D.rootSubgroup alpha.1
  have hconn : ∀ alpha, _root_.IsConnected (H alpha : Set (Variety.Point G)) := by
    intro alpha
    let : ConnectedSpace (Variety.Point (H alpha).carrierVariety) :=
      connectedSpace_iff_univ.mpr (hD.2.2.1 alpha.1).1.2.isConnected
    change _root_.IsConnected ((H alpha).toSubgroup : Set (Variety.Point G))
    rw [← (H alpha).range_inclusion]
    exact isConnected_range (H alpha).inclusion.toVariety.continuous
  have h := closure_iUnion_connected_closedSubgroup_isZariskiClosed H hconn
  change IsZariskiClosed G (Subgroup.closure (⋃ alpha : A,
    (D.rootSubgroup alpha.1 : Set (Variety.Point G))) : Set (Variety.Point G)) at h
  rw [Set.iUnion_subtype] at h
  exact h

/-- Solvability reduction with two independent geometric premises: a positive
character functional and the general contraction-to-unipotence theorem. -/
public theorem rootSubgroupGenerated_isSolvable_of_positive_characterFunctional
    (D : RootGroupData G T) (hD : D.IsRealization) (hT : IsSubtorus T)
    (A : Set D.Root) (phi : Additive (TorusWeight T) →+ ℤ)
    (hphi : ∀ alpha ∈ A, 0 < phi (Additive.ofMul (D.rootWeight alpha)))
    (hcontraction : ∀ (lambda : AlgebraicGroup.Morphism (KMult k) G)
      (g : Variety.Point G), IsCocharacterContracted lambda g → IsUnipotentElement G g) :
    Group.IsSolvable (RootSubgroupGenerated D A) := by
  obtain ⟨lambda, hlambda⟩ :=
    rootSubgroupGenerated_exists_contracting_cocharacter D hD hT A phi hphi
  let U := ClosedSubgroup.ofSubgroup (RootSubgroupGenerated D A)
    (rootSubgroupGenerated_isZariskiClosed D hD A)
  have hU : IsUnipotentAlgebraicGroup U.carrierVariety := by
    intro u
    have hu := (U.pointEquiv u).property
    have hg : IsUnipotentElement G (U.includePoint u) :=
      hcontraction (T.inclusion.comp lambda) _ (hlambda _ hu)
    have h := closedSubgroup_unipotent_of_ambient U hu hg
    have heq : U.pointEquiv.symm ⟨(U.pointEquiv u).val, hu⟩ = u := by
      apply U.pointEquiv.injective
      rw [U.pointEquiv.apply_symm_apply]
    rw [heq] at h
    exact h
  let : Group.IsSolvable (Variety.Point U.carrierVariety) :=
    isSolvable_of_isUnipotentAlgebraicGroup hU
  exact Group.isSolvable_of_surjective
    (f := (Equiv.mulEquiv U.pointEquiv).toMonoidHom)
    (Equiv.mulEquiv U.pointEquiv).surjective


omit [IsAlgClosed k] in
/-- The subgroup generated by no roots is solvable. -/
public theorem rootSubgroupGenerated_isSolvable_empty (D : RootGroupData G T) :
    Group.IsSolvable (RootSubgroupGenerated D ∅) := by
  rw [RootSubgroupGenerated_empty]
  infer_instance

omit [IsAlgClosed k] in
/-- The case of an empty root type needs no geometric input. -/
public theorem rootSubgroupGenerated_isSolvable_of_isEmpty
    (D : RootGroupData G T) [IsEmpty D.Root] (A : Set D.Root) :
    Group.IsSolvable (RootSubgroupGenerated D A) := by
  rw [Set.eq_empty_of_isEmpty A]
  exact rootSubgroupGenerated_isSolvable_empty D

/-- Application to the Borel-containment step of GLS3, Theorem 1.11.2.
The solvability premise of that step is discharged by contraction. -/
public theorem exists_borelSubgroup_containing_roots_of_positive_characterFunctional
    (D : RootGroupData G T) (hD : D.IsRealization) (hT : IsSubtorus T)
    (A : Set D.Root) (phi : Additive (TorusWeight T) →+ ℤ)
    (hphi : ∀ alpha ∈ A, 0 < phi (Additive.ofMul (D.rootWeight alpha)))
    (hcontraction : ∀ (lambda : AlgebraicGroup.Morphism (KMult k) G)
      (g : Variety.Point G), IsCocharacterContracted lambda g → IsUnipotentElement G g) :
    ∃ B : ClosedSubgroup G, IsBorelSubgroup B ∧ T ≤ B ∧
      RootSubgroupGenerated D A ≤ B.toSubgroup := by
  exact exists_borelSubgroup_containing_solvable_roots D hD hT A
    (rootSubgroupGenerated_isSolvable_of_positive_characterFunctional
      D hD hT A phi hphi hcontraction)

end Theory.AlgebraicGroup
