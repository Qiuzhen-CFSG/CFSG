module

public import Theory.AlgebraicGroup.Borel.Existence
public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.RootSubgroups.TorusGeneratedNormalizer
public import Theory.AlgebraicGroup.Tori.Power

universe u

/-!
Borel containment for a solvable subgroup generated by actual torus roots.

The torus normalizes the generated root subgroup. Their join is therefore a
solvable extension, and finite-word generation by connected closed subgroups
makes it closed and connected. Maximal connected solvable containment gives a
Borel containing both factors. This reduces positive-root Borel existence to
solvability of the generated positive-root subgroup, a consequence of the
unipotence assertion in GLS3, Theorem 1.11.2, and Borel, §§14.4–14.5.
-/

namespace Theory.AlgebraicGroup

open scoped Pointwise

private theorem solvable_sup_of_normalizes
    {H : Type*} [Group H] (S U : Subgroup H)
    [Group.IsSolvable S] [Group.IsSolvable U]
    (hnorm : S ≤ Subgroup.normalizer (U : Set H)) :
    Group.IsSolvable (S ⊔ U : Subgroup H) := by
  let J := S ⊔ U
  let N : Subgroup J := U.subgroupOf J
  let : N.Normal := Subgroup.normal_subgroupOf_sup_of_le_normalizer hnorm
  let q := QuotientGroup.mk' N
  let iS : S →* J := Subgroup.inclusion le_sup_left
  have hsurj : Function.Surjective (q.comp iS) := by
    intro y
    obtain ⟨j, rfl⟩ := QuotientGroup.mk'_surjective N y
    have hj : j.1 ∈ (U : Set H) * (S : Set H) := by
      have hj' : j.1 ∈ U ⊔ S := by simpa only [J, sup_comm] using j.2
      exact (Set.ext_iff.mp
        (Subgroup.coe_mul_of_right_le_normalizer_left U S hnorm) j.1).mp hj'
    obtain ⟨u, hu, s, hs, hprod⟩ := hj
    refine ⟨⟨s, hs⟩, ?_⟩
    apply (QuotientGroup.eq_iff_div_mem).mpr
    change s / j.1 ∈ U
    rw [← hprod]
    simpa using U.inv_mem hu
  let : Group.IsSolvable (J ⧸ N) := Group.isSolvable_of_surjective hsurj
  exact Group.isSolvable_of_ker_le_range (Subgroup.inclusion le_sup_right) q
    (by simp [q, N, J])

variable {k : Type u} [Field k] [IsAlgClosed k]
variable {G : Variety k} [AlgebraicGroup G] {T : ClosedSubgroup G}

omit [IsAlgClosed k] in
private theorem ambient_connected_of_carrier_connected (S : ClosedSubgroup G)
    (hS : Variety.IsConnected S.carrierVariety) :
    _root_.IsConnected (S : Set (Variety.Point G)) := by
  let : ConnectedSpace (Variety.Point S.carrierVariety) :=
    connectedSpace_iff_univ.mpr hS
  change _root_.IsConnected (S.toSubgroup : Set (Variety.Point G))
  rw [← S.range_inclusion]
  exact isConnected_range S.inclusion.toVariety.continuous

/-- Solvability of a root-generated subgroup supplies a Borel containing all
its roots and the realizing torus. No positive-root classification is assumed. -/
public theorem exists_borelSubgroup_containing_solvable_roots
    (D : RootGroupData G T) (hD : D.IsRealization) (hT : IsSubtorus T)
    (A : Set D.Root) (hsolvable : Group.IsSolvable (RootSubgroupGenerated D A)) :
    ∃ B : ClosedSubgroup G, IsBorelSubgroup B ∧ T ≤ B ∧
      RootSubgroupGenerated D A ≤ B.toSubgroup := by
  let H : Option A → ClosedSubgroup G := fun i =>
    match i with
    | none => T
    | some a => D.rootSubgroup a.1
  have hc : ∀ i, _root_.IsConnected (H i : Set (Variety.Point G)) := by
    intro i
    cases i with
    | none => exact ambient_connected_of_carrier_connected T hT.isConnected
    | some a =>
        exact ambient_connected_of_carrier_connected (D.rootSubgroup a.1)
          (hD.2.2.1 a.1).1.2.isConnected
  have hu : (⋃ i, (H i : Set (Variety.Point G))) =
      (T : Set (Variety.Point G)) ∪
        ⋃ a ∈ A, (D.rootSubgroup a : Set (Variety.Point G)) := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_union]
    constructor
    · rintro ⟨i, hi⟩
      cases i with
      | none => exact Or.inl hi
      | some a => exact Or.inr ⟨a.1, a.2, hi⟩
    · rintro (hx | ⟨a, ha, hx⟩)
      · exact ⟨none, hx⟩
      · exact ⟨some ⟨a, ha⟩, hx⟩
  have hgenerated : Subgroup.closure (⋃ i, (H i : Set (Variety.Point G))) =
      T.toSubgroup ⊔ RootSubgroupGenerated D A := by
    rw [hu, Subgroup.closure_union,
      show Subgroup.closure (T : Set (Variety.Point G)) = T.toSubgroup from
        Subgroup.closure_eq T.toSubgroup]
    rfl
  have hclosed := closure_iUnion_connected_closedSubgroup_isZariskiClosed H hc
  have hconnected := closure_iUnion_connected_closedSubgroup_isConnected H hc
  rw [hgenerated] at hclosed hconnected
  let J : ClosedSubgroup G :=
    ClosedSubgroup.ofSubgroup (T.toSubgroup ⊔ RootSubgroupGenerated D A) hclosed
  let : Group.IsSolvable (Variety.Point T.carrierVariety) :=
    Group.isSolvable_of_comm (isMulCommutative_iff.mp hT.isMulCommutative)
  let : Group.IsSolvable T.toSubgroup :=
    Group.isSolvable_of_surjective
      (f := (Equiv.mulEquiv T.pointEquiv).toMonoidHom)
      (Equiv.mulEquiv T.pointEquiv).surjective
  let : Group.IsSolvable (RootSubgroupGenerated D A) := hsolvable
  let : Group.IsSolvable J.toSubgroup := solvable_sup_of_normalizes
    T.toSubgroup (RootSubgroupGenerated D A)
    (torus_le_rootSubgroupGenerated_normalizer D hD A)
  have hJsolvable : Group.IsSolvable (Variety.Point J.carrierVariety) :=
    Group.isSolvable_of_isSolvable_injective
      (f := (Equiv.mulEquiv J.pointEquiv).toMonoidHom)
      (Equiv.mulEquiv J.pointEquiv).injective
  obtain ⟨B, hB, hJB⟩ :=
    exists_borelSubgroup_containing_connected_solvable J hconnected hJsolvable
  exact ⟨B, hB, fun _ hx => hJB (Subgroup.mem_sup_left hx),
    fun _ hx => hJB (Subgroup.mem_sup_right hx)⟩

end Theory.AlgebraicGroup
