module

public import Theory.AlgebraicGroup.Borel.StandardPositiveSystemClassification.Defs

universe u

/-!
Standard Borel subgroups attached to positive root systems, forming the first
clause of GLS3, Theorem 1.11.2.

The classification sends a positive system to the Borel generated by its
positive root subgroups and the fixed maximal torus.  The Borel's unipotent
radical is exactly the generated positive-root subgroup.  Conversely, a Borel
containing the torus determines its unique positive system through the root
subgroups in that radical.  Once these two geometric constructions are in
place, their uniqueness properties give the required equivalence.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

section

variable {K : Variety k} [AlgebraicGroup K]
    (T : ClosedSubgroup K) (D : RootGroupData K T)

private noncomputable def classifyBorel
    (hforward : ∀ positiveRoots :
        {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots},
      ∃ B : BorelContaining T,
        Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 B.carrier))
    (positiveRoots :
      {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots}) :
    BorelContaining T :=
  Classical.choose (hforward positiveRoots)

private theorem classifyBorel_spec
    (hforward : ∀ positiveRoots :
        {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots},
      ∃ B : BorelContaining T,
        Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 B.carrier))
    (positiveRoots :
      {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots}) :
    Nonempty (IsBorelOfPositiveSystem D positiveRoots.1
      (classifyBorel T D hforward positiveRoots).carrier) :=
  Classical.choose_spec (hforward positiveRoots)

private theorem borelContaining_unique
    (positiveRoots :
      {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots})
    {B C : BorelContaining T}
    (hB : Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 B.carrier))
    (hC : Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 C.carrier)) :
    B = C := by
  obtain ⟨hB⟩ := hB
  obtain ⟨hC⟩ := hC
  have hcarrier : B.carrier = C.carrier := SetLike.coe_injective <|
    congrArg (fun H : Subgroup (Variety.Point K) => (H : Set (Variety.Point K))) <| by
      calc
        B.carrier.toSubgroup =
            T.toSubgroup ⊔ RootSubgroupGenerated D positiveRoots.1 := by
          rw [hB.torus_unipotent_generate, hB.root_generated]
        _ = C.carrier.toSubgroup := by
          rw [hC.torus_unipotent_generate, hC.root_generated]
  cases B
  cases C
  cases hcarrier
  rfl

private theorem classifyBorel_injective
    (hforward : ∀ positiveRoots :
        {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots},
      ∃ B : BorelContaining T,
        Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 B.carrier))
    (hbackward : ∀ B : BorelContaining T,
      ∃! positiveRoots :
          {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots},
        Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 B.carrier)) :
    Function.Injective (classifyBorel T D hforward) := by
  intro P Q hPQ
  have hP : Nonempty (IsBorelOfPositiveSystem D P.1
      (classifyBorel T D hforward P).carrier) :=
    classifyBorel_spec T D hforward P
  have hQ : Nonempty (IsBorelOfPositiveSystem D Q.1
      (classifyBorel T D hforward P).carrier) := by
    rw [hPQ]
    exact classifyBorel_spec T D hforward Q
  exact (hbackward (classifyBorel T D hforward P)).unique hP hQ

private theorem classifyBorel_surjective
    (hforward : ∀ positiveRoots :
        {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots},
      ∃ B : BorelContaining T,
        Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 B.carrier))
    (hbackward : ∀ B : BorelContaining T,
      ∃! positiveRoots :
          {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots},
        Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 B.carrier)) :
    Function.Surjective (classifyBorel T D hforward) := by
  intro B
  let P := Classical.choose (hbackward B)
  have hPB : Nonempty (IsBorelOfPositiveSystem D P.1 B.carrier) :=
    (Classical.choose_spec (hbackward B)).1
  refine ⟨P, ?_⟩
  exact borelContaining_unique T D P
    (classifyBorel_spec T D hforward P) hPB

private theorem standardBorelClassification_of_geometric_classification
    (hforward : ∀ positiveRoots :
        {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots},
      ∃ B : BorelContaining T,
        Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 B.carrier))
    (hbackward : ∀ B : BorelContaining T,
      ∃! positiveRoots :
          {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots},
        Nonempty (IsBorelOfPositiveSystem D positiveRoots.1 B.carrier)) :
    ∃ classify :
        {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots} ≃
          BorelContaining T,
      ∀ positiveRoots,
        Nonempty (IsBorelOfPositiveSystem D positiveRoots.1
          (classify positiveRoots).carrier) := by
  let classify :
      {positiveRoots : Set D.Root // IsPositiveSystem D positiveRoots} ≃
        BorelContaining T :=
    Equiv.ofBijective (classifyBorel T D hforward)
      ⟨classifyBorel_injective T D hforward hbackward,
        classifyBorel_surjective T D hforward hbackward⟩
  exact ⟨classify, classifyBorel_spec T D hforward⟩

end


end Theory.AlgebraicGroup
