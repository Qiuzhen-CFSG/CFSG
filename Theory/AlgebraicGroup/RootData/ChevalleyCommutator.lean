module

public import Theory.AlgebraicGroup.RootData.Chevalley
public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup

universe u

open scoped commutatorElement

/-!
Root-subgroup commutator containment from a Chevalley system.

For two linearly independent realized roots, the Chevalley commutator identity
writes every point commutator as a finite ordered product of root elements.
The roots of those factors are exactly the roots of the form
`i * alpha + j * beta` with positive integral coefficients.  Therefore the
whole subgroup commutator is contained in the subgroup generated by those
root factors.

This is the low-level, source-free consequence of the Chevalley-system
interface needed by root-collection and root-block arguments.  It does not use
the unresolved existence statement `theorem_1_12_1`; construction of a
Chevalley system for an arbitrary reductive group remains a separate geometric
input.  The formula is the standard Chevalley commutator relation appearing in
GLS3, Theorem 1.12.1.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

/-- Roots that occur as positive integral combinations in the Chevalley
commutator formula for `alpha` and `beta`. -/
public def ChevalleyCommutatorRoots
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (α β : D.Root) : Set D.Root :=
  {γ | ∃ q : ChevalleyCommutatorTerm D.Root,
    IsValidChevalleyCommutatorTerm D P e α β q ∧ q.root = γ}

/-- Membership in `ChevalleyCommutatorRoots` is precisely the existence of a
positive integral expression in the two input roots. -/
public theorem mem_chevalleyCommutatorRoots_iff
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (α β γ : D.Root) :
    γ ∈ ChevalleyCommutatorRoots D P e α β ↔
      ∃ i j : ℕ, 0 < i ∧ 0 < j ∧
        P.root (e γ) = (i : R) • P.root (e α) + (j : R) • P.root (e β) := by
  constructor
  · rintro ⟨q, hq, rfl⟩
    exact ⟨q.i, q.j, hq.1, hq.2.1, hq.2.2⟩
  · rintro ⟨i, j, hi, hj, hroot⟩
    exact ⟨⟨i, j, γ⟩, ⟨hi, hj, hroot⟩, rfl⟩

/-- The commutator of two linearly independent root subgroups is generated by
the root subgroups indexed by valid positive integral root combinations. -/
public theorem rootSubgroup_commutator_le_chevalleyCommutatorRoots
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (base : P.Base)
    (hC : IsChevalleySystem D C P e base)
    {α β : D.Root} (hLI : AreLinearlyIndependentRoots D P e α β) :
    ⁅(D.rootSubgroup α).toSubgroup, (D.rootSubgroup β).toSubgroup⁆ ≤
      RootSubgroupGenerated D (ChevalleyCommutatorRoots D P e α β) := by
  rw [Subgroup.commutator_le]
  intro x hx y hy
  have hrootα : (D.rootSubgroup α : Set (Variety.Point K)) =
      Set.range (C.x α) := by
    simpa using (hC.1 α).2.symm
  have hrootβ : (D.rootSubgroup β : Set (Variety.Point K)) =
      Set.range (C.x β) := by
    simpa using (hC.1 β).2.symm
  have hx' : x ∈ (D.rootSubgroup α : Set (Variety.Point K)) := hx
  rw [hrootα] at hx'
  have hy' : y ∈ (D.rootSubgroup β : Set (Variety.Point K)) := hy
  rw [hrootβ] at hy'
  rcases hx' with ⟨t, rfl⟩
  rcases hy' with ⟨u, rfl⟩
  obtain ⟨order, coefficient, _hnodup, _hpairwise, hvalid, _hcoeff, hformula⟩ :=
    hC.2.2.2.2.1 α β hLI

  -- The formula is stated for the inverse-oriented commutator.  Negating the
  -- additive root parameters produces the subgroup commutator orientation.
  have hzeroα : C.x α 0 = 1 := by
    simpa using (hC.2.2.2.1 α 0 0)
  have hzeroβ : C.x β 0 = 1 := by
    simpa using (hC.2.2.2.1 β 0 0)
  have hxinv : C.x α (-t) = (C.x α t)⁻¹ := by
    apply eq_inv_iff_mul_eq_one.mpr
    rw [hC.2.2.2.1 α (-t) t]
    simpa using hzeroα
  have hyinv : C.x β (-u) = (C.x β u)⁻¹ := by
    apply eq_inv_iff_mul_eq_one.mpr
    rw [hC.2.2.2.1 β (-u) u]
    simpa using hzeroβ

  have hprod :
      (order.map fun q =>
        C.x q.root (coefficient q * (-t) ^ q.i * (-u) ^ q.j)).prod ∈
        RootSubgroupGenerated D (ChevalleyCommutatorRoots D P e α β) := by
    apply Subgroup.list_prod_mem
    intro z hz
    rw [List.mem_map] at hz
    rcases hz with ⟨q, hq, rfl⟩
    have hxq : C.x q.root
        (coefficient q * (-t) ^ q.i * (-u) ^ q.j) ∈ Set.range (C.x q.root) :=
      Set.mem_range_self _
    have hxq' : C.x q.root
        (coefficient q * (-t) ^ q.i * (-u) ^ q.j) ∈
          (D.rootSubgroup q.root : Set (Variety.Point K)) := by
      simpa [(hC.1 q.root).2] using hxq
    apply Subgroup.subset_closure
    simp only [Set.mem_iUnion]
    exact ⟨q.root, ⟨q, (hvalid q).mp hq, rfl⟩, hxq'⟩
  have hcommRaw :
      (C.x α (-t))⁻¹ * (C.x β (-u))⁻¹ * C.x α (-t) * C.x β (-u) ∈
        RootSubgroupGenerated D (ChevalleyCommutatorRoots D P e α β) := by
    rw [hformula (-t) (-u)]
    exact hprod
  simpa [hxinv, hyinv, commutatorElement_def, mul_assoc] using hcommRaw

/-- Pointwise form of root-subgroup commutator containment. -/
public theorem rootSubgroup_commutatorElement_mem_chevalleyCommutatorRoots
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (base : P.Base)
    (hC : IsChevalleySystem D C P e base)
    {α β : D.Root} (hLI : AreLinearlyIndependentRoots D P e α β)
    {x y : Variety.Point K} (hx : x ∈ D.rootSubgroup α)
    (hy : y ∈ D.rootSubgroup β) :
    ⁅x, y⁆ ∈ RootSubgroupGenerated D
      (ChevalleyCommutatorRoots D P e α β) :=
  rootSubgroup_commutator_le_chevalleyCommutatorRoots D C P e base hC hLI
    (Subgroup.commutator_mem_commutator hx hy)

/-- If no root is a positive integral combination of the two input roots, the
corresponding root subgroups commute pointwise. -/
public theorem rootSubgroups_commute_of_chevalleyCommutatorRoots_eq_empty
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (base : P.Base)
    (hC : IsChevalleySystem D C P e base)
    {α β : D.Root} (hLI : AreLinearlyIndependentRoots D P e α β)
    (hEmpty : ChevalleyCommutatorRoots D P e α β = ∅) :
    ∀ x, x ∈ D.rootSubgroup α → ∀ y, y ∈ D.rootSubgroup β → Commute x y := by
  intro x hx y hy
  apply commutatorElement_eq_one_iff_commute.mp
  rw [← Subgroup.mem_bot]
  rw [← RootSubgroupGenerated_empty D, ← hEmpty]
  exact rootSubgroup_commutatorElement_mem_chevalleyCommutatorRoots
    D C P e base hC hLI hx hy

end Theory.AlgebraicGroup
