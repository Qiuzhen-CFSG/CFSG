module

public import Theory.AlgebraicGroup.ClosedSubgroup.Product
public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.ParabolicBounds
public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup

universe u

set_option linter.style.haveILetI false

/-!
Zariski closedness of the relative-root layers attached to a standard
parabolic setup.

The proof descends from the terminal trivial layer.  At height `i`, the layer
is generated by layer `i + 1` and the finitely many root subgroups of exact
relative height `i`.  The Chevalley commutator estimate puts every commutator
inside layer `i + 1`; consequently each new root subgroup normalizes the
partial product already constructed.  Such a normalized product is the range
of a regular multiplication morphism, so it is constructible, and a
constructible subgroup of an algebraic group is closed.

This supplies the closed-subgroup packaging needed to apply closed normalizer
and Zariski-closure arguments to the filtration in the standard-parabolic
development.  Mathematically it is the closed-root-product step underlying
the relative-root filtration in GLS3, Section 1.13.

The zero layer is handled separately: it is generated by the finite family of
all root subgroups whose relative height is nonnegative, so finite connected
generation makes it Zariski closed as well.
-/

namespace Theory.AlgebraicGroup

open scoped Pointwise

variable {k : Type u} [Field k] [IsAlgClosed k]

private lemma subgroup_sup_isZariskiClosed_of_le_normalizer
    {K : Variety k} [AlgebraicGroup K]
    (H L : Subgroup (Variety.Point K))
    (hH : IsZariskiClosed K (H : Set (Variety.Point K)))
    (hL : IsZariskiClosed K (L : Set (Variety.Point K)))
    (hnorm : L ≤ Subgroup.normalizer (H : Set (Variety.Point K))) :
    IsZariskiClosed K ((H ⊔ L : Subgroup (Variety.Point K)) :
      Set (Variety.Point K)) := by
  let Hc : ClosedSubgroup K := ClosedSubgroup.ofSubgroup H hH
  let Lc : ClosedSubgroup K := ClosedSubgroup.ofSubgroup L hL
  obtain ⟨m, hm⟩ :=
    exists_closedSubgroup_productMorphism_range_eq_pointwise_mul Hc Lc
  have hHcarrier : Hc.toClosedSubgroup.toSubgroup = H := rfl
  have hLcarrier : Lc.toClosedSubgroup.toSubgroup = L := rfl
  have hm' : Set.range m.toFun =
      (H : Set (Variety.Point K)) * (L : Set (Variety.Point K)) := by
    simpa only [hHcarrier, hLcarrier] using hm
  rw [← Variety.isClosed_iff_isZariskiClosed]
  apply constructible_subgroup_isClosed K
  rw [Subgroup.coe_mul_of_right_le_normalizer_left H L hnorm, ← hm']
  exact m.range_isConstructible

private lemma standardParabolicRelativeRootLayer_isZariskiClosed_of_next
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K) (i : ℕ) (hi : 0 < i)
    (hnext : IsZariskiClosed K
      (S.layer (i + 1) : Set (Variety.Point K))) :
    IsZariskiClosed K (S.layer i : Set (Variety.Point K)) := by
  classical
  letI := Fintype.ofFinite S.D.Root
  letI := Fintype.ofFinite S.ι
  let exactRoots : Finset S.D.Root := Finset.univ.filter fun α =>
    RelativeRootHeight S.coeff S.rationalBase.support
      (S.rootEquiv '' S.J) (S.rootEquiv α) = i
  have hcomm : ⁅S.layer i, S.layer i⁆ ≤ S.layer (i + 1) :=
    relativeRootSeries_commutator_same_layer_le_next_layer S.D S.C
      S.rationalPairing S.rootEquiv S.rationalBase S.coeff
      S.rationalSimpleRootExpansion S.chevalleySystem S.J i hi
  have hnext_le : S.layer (i + 1) ≤ S.layer i :=
    relativeRootSeries_antitone S.D S.rootEquiv S.rationalBase.support
      S.coeff S.J (Nat.le_succ i)
  have hfinite : ∀ A : Finset S.D.Root,
      (∀ α ∈ A, RelativeRootHeight S.coeff S.rationalBase.support
        (S.rootEquiv '' S.J) (S.rootEquiv α) = i) →
      IsZariskiClosed K
        ((S.layer (i + 1) ⊔ RootSubgroupGenerated S.D (A : Set S.D.Root) :
          Subgroup (Variety.Point K)) : Set (Variety.Point K)) := by
    intro A hA
    induction A using Finset.induction_on with
    | empty =>
        simpa [RootSubgroupGenerated_empty] using hnext
    | @insert α A hαA ih =>
        have hαheight : RelativeRootHeight S.coeff S.rationalBase.support
            (S.rootEquiv '' S.J) (S.rootEquiv α) = i :=
          hA α (Finset.mem_insert_self α A)
        have hAheight : ∀ β ∈ A,
            RelativeRootHeight S.coeff S.rationalBase.support
              (S.rootEquiv '' S.J) (S.rootEquiv β) = i := by
          intro β hβ
          exact hA β (Finset.mem_insert_of_mem hβ)
        have ihclosed := ih hAheight
        let H : Subgroup (Variety.Point K) :=
          S.layer (i + 1) ⊔ RootSubgroupGenerated S.D (A : Set S.D.Root)
        let X : Subgroup (Variety.Point K) := (S.D.rootSubgroup α).toSubgroup
        have hXclosed : IsZariskiClosed K (X : Set (Variety.Point K)) := by
          exact (S.D.rootSubgroup α).isZariskiClosed
        have hXle : X ≤ S.layer i := by
          apply rootSubgroup_le_RootSubgroupGenerated S.D
          change (i : ℤ) ≤ RelativeRootHeight S.coeff
            S.rationalBase.support (S.rootEquiv '' S.J) (S.rootEquiv α)
          omega
        have hgenerated_le : RootSubgroupGenerated S.D (A : Set S.D.Root) ≤
            S.layer i := by
          rw [RootSubgroupGenerated_le_iff]
          intro β hβ
          apply rootSubgroup_le_RootSubgroupGenerated S.D
          change (i : ℤ) ≤ RelativeRootHeight S.coeff
            S.rationalBase.support (S.rootEquiv '' S.J) (S.rootEquiv β)
          have hβ' : β ∈ A := hβ
          rw [hAheight β hβ']
        have hHle : H ≤ S.layer i := sup_le hnext_le hgenerated_le
        have hnextH : S.layer (i + 1) ≤ H := le_sup_left
        have hnorm : X ≤ Subgroup.normalizer (H : Set (Variety.Point K)) := by
          rw [Subgroup.le_normalizer_iff_commutator_le_right]
          exact (Subgroup.commutator_mono hXle hHle).trans hcomm |>.trans hnextH
        have hsupclosed := subgroup_sup_isZariskiClosed_of_le_normalizer
          H X ihclosed hXclosed hnorm
        have heq :
            S.layer (i + 1) ⊔
                RootSubgroupGenerated S.D ((insert α A : Finset S.D.Root) :
                  Set S.D.Root) =
              H ⊔ X := by
          simp only [Finset.coe_insert, Set.insert_eq,
            RootSubgroupGenerated_union, RootSubgroupGenerated_singleton]
          dsimp only [H, X]
          ac_rfl
        rw [heq]
        exact hsupclosed
  have hexact : (exactRoots : Set S.D.Root) =
      {α | RelativeRootHeight S.coeff S.rationalBase.support
        (S.rootEquiv '' S.J) (S.rootEquiv α) = i} := by
    ext α
    simp [exactRoots]
  have hclosed := hfinite exactRoots (by
    intro α hα
    simpa [exactRoots] using hα)
  have hrootSet :
      {α | (i : ℤ) ≤ RelativeRootHeight S.coeff S.rationalBase.support
          (S.rootEquiv '' S.J) (S.rootEquiv α)} =
        {α | (i + 1 : ℕ) ≤ RelativeRootHeight S.coeff S.rationalBase.support
          (S.rootEquiv '' S.J) (S.rootEquiv α)} ∪
        {α | RelativeRootHeight S.coeff S.rationalBase.support
          (S.rootEquiv '' S.J) (S.rootEquiv α) = i} := by
    ext α
    simp only [Set.mem_ofPred_eq, Set.mem_union]
    omega
  rw [StandardParabolicRelativeRootSetup.layer, RelativeRootSeries, hrootSet,
    RootSubgroupGenerated_union]
  simpa [StandardParabolicRelativeRootSetup.layer, RelativeRootSeries, hexact]
    using hclosed

/-- The zero standard-parabolic relative-root layer is Zariski closed. -/
public theorem standardParabolicRelativeRootLayer_zero_isZariskiClosed
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K) :
    IsZariskiClosed K (S.layer 0 : Set (Variety.Point K)) := by
  classical
  letI := Fintype.ofFinite S.D.Root
  let A : Set S.D.Root := {α | (0 : ℤ) ≤ RelativeRootHeight S.coeff
    S.rationalBase.support (S.rootEquiv '' S.J) (S.rootEquiv α)}
  let H : A → ClosedSubgroup K := fun α => S.D.rootSubgroup α.1
  have hconn : ∀ α, _root_.IsConnected
      (H α : Set (Variety.Point K)) := by
    intro α
    have hc : Variety.IsConnected (H α).carrierVariety :=
      (S.standardParabolic.1.2.1.2.2.1 α.1).1.2.isConnected
    letI : ConnectedSpace (Variety.Point (H α).carrierVariety) :=
      connectedSpace_iff_univ.mpr hc
    change _root_.IsConnected ((H α).toSubgroup : Set (Variety.Point K))
    rw [← (H α).range_inclusion]
    exact isConnected_range (H α).inclusion.toVariety.continuous
  have hclosed := closure_iUnion_connected_closedSubgroup_isZariskiClosed H hconn
  rw [StandardParabolicRelativeRootSetup.layer, RelativeRootSeries,
    RootSubgroupGenerated]
  change IsZariskiClosed K
    (Subgroup.closure (⋃ α ∈ A,
      (S.D.rootSubgroup α : Set (Variety.Point K))) :
      Set (Variety.Point K))
  have hunion : (⋃ α : A, (H α : Set (Variety.Point K))) =
      ⋃ α ∈ A, (S.D.rootSubgroup α : Set (Variety.Point K)) := by
    change (⋃ α : A, (S.D.rootSubgroup α.1 : Set (Variety.Point K))) = _
    exact Set.iUnion_subtype (fun α : S.D.Root => α ∈ A)
      (fun α => (S.D.rootSubgroup α : Set (Variety.Point K)))
  rw [← hunion]
  exact hclosed

/-- Every positive standard-parabolic relative-root layer is Zariski closed. -/
public theorem standardParabolicRelativeRootLayer_isZariskiClosed
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K) (i : ℕ) (hi : 0 < i) :
    IsZariskiClosed K (S.layer i : Set (Variety.Point K)) := by
  letI := Fintype.ofFinite S.D.Root
  letI := Fintype.ofFinite S.ι
  by_cases hle : i ≤ S.maxRelativeHeight + 1
  · apply Nat.decreasingInduction'
      (m := i) (n := S.maxRelativeHeight + 1) (P := fun j =>
        IsZariskiClosed K (S.layer j : Set (Variety.Point K)))
    · intro j _ hij hclosed
      apply standardParabolicRelativeRootLayer_isZariskiClosed_of_next
        S j (hi.trans_le hij) hclosed
    · exact hle
    · rw [standardParabolicRelativeRootLayer_terminal S]
      exact (ClosedSubgroup.bot (G := K)).isZariskiClosed
  · have hterminal_le : S.maxRelativeHeight + 1 ≤ i := by omega
    have hbot : S.layer i = ⊥ := by
      apply bot_unique
      rw [← standardParabolicRelativeRootLayer_terminal S]
      exact relativeRootSeries_antitone S.D S.rootEquiv
        S.rationalBase.support S.coeff S.J hterminal_le
    rw [hbot]
    exact (ClosedSubgroup.bot (G := K)).isZariskiClosed

/-- A positive standard-parabolic relative-root layer, packaged as a closed
algebraic subgroup. -/
@[expose]
public noncomputable def StandardParabolicRelativeRootSetup.layerClosedSubgroup
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K) (i : ℕ) (hi : 0 < i) :
    ClosedSubgroup K :=
  ClosedSubgroup.ofSubgroup (S.layer i)
    (standardParabolicRelativeRootLayer_isZariskiClosed S i hi)

/-- The closed-subgroup packaging has the original relative-root layer as its
underlying abstract subgroup. -/
public lemma StandardParabolicRelativeRootSetup.layerClosedSubgroup_toSubgroup
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K) (i : ℕ) (hi : 0 < i) :
    (S.layerClosedSubgroup i hi).toSubgroup = S.layer i := rfl

end Theory.AlgebraicGroup
