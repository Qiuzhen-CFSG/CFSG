module

public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.ParabolicSetup
public import Theory.AlgebraicGroup.RootData.StandardLevi

universe u

set_option linter.style.haveILetI false

/-!
The torus-center part of the standard Levi action on relative-root fibers.
-/

namespace Theory.AlgebraicGroup

open scoped BigOperators

variable {k : Type u} [Field k]

private noncomputable def torusWeightPointEval
    {K : Variety k} [AlgebraicGroup K] (T : ClosedSubgroup K)
    (s : Variety.Point T.carrierVariety) : TorusWeight T →* kˣ where
  toFun := fun χ => dPointEquiv 1 (χ.onPoints s) 0
  map_one' := by
    change dPointEquiv 1 (1 : Variety.Point (KMult k)) 0 = 1
    rw [dPointEquiv_one]
    rfl
  map_mul' := by
    intro χ ψ
    change dPointEquiv 1 (χ.onPoints s * ψ.onPoints s) 0 =
      dPointEquiv 1 (χ.onPoints s) 0 * dPointEquiv 1 (ψ.onPoints s) 0
    exact congrFun (dPointEquiv_mul 1 (χ.onPoints s) (ψ.onPoints s)) 0

/-- Points of the chosen torus that centralize the root-generated standard
Levi factor.  This is a subgroup of torus points, not a claim identifying the
full algebraic center of a Levi subgroup. -/
public noncomputable def standardLeviTorusCenter
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K) :
    Subgroup (Variety.Point S.T.carrierVariety) :=
  (Subgroup.centralizer
    (standardLeviRootFactor S.D S.sigmaJ : Set (Variety.Point K))).comap
      S.T.inclusion.onPoints

/-- Membership in the torus-center subgroup is ambient centralization of the
root-generated Levi factor. -/
public lemma mem_standardLeviTorusCenter
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K)
    (s : Variety.Point S.T.carrierVariety) :
    s ∈ standardLeviTorusCenter S ↔
      S.T.includePoint s ∈ Subgroup.centralizer
        (standardLeviRootFactor S.D S.sigmaJ : Set (Variety.Point K)) := by
  rfl

/-- Within the chosen torus, centralizing the root-generated Levi factor is
equivalent to centralizing the entire standard Levi point subgroup. -/
public lemma
    mem_standardLeviTorusCenter_iff_mem_standardLeviSubgroup_centralizer
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K)
    (s : Variety.Point S.T.carrierVariety) :
    s ∈ standardLeviTorusCenter S ↔
      S.T.includePoint s ∈ Subgroup.centralizer
        (standardLeviSubgroup S.D S.sigmaJ : Set (Variety.Point K)) := by
  constructor
  · intro hs
    rw [mem_standardLeviTorusCenter] at hs
    have hle : standardLeviSubgroup S.D S.sigmaJ ≤
        Subgroup.centralizer ({S.T.includePoint s} : Set (Variety.Point K)) := by
      rw [standardLeviSubgroup, sup_le_iff]
      constructor
      · intro x hx
        rw [Subgroup.mem_centralizer_singleton_iff]
        let sx : Variety.Point S.T.carrierVariety :=
          S.T.pointEquiv.symm ⟨x, hx⟩
        have hsx : S.T.includePoint sx = x :=
          congrArg Subtype.val (S.T.pointEquiv.apply_symm_apply ⟨x, hx⟩)
        have hcomm : sx * s = s * sx := by
          exact isMulCommutative_iff.mp
            (IsSubtorus.isMulCommutative S.standardParabolic.1.1.1) sx s
        have h := congrArg (Equiv.mulEquiv S.T.pointEquiv) hcomm
        have h' := congrArg Subtype.val h
        change (S.T.pointEquiv sx).val * (S.T.pointEquiv s).val =
          (S.T.pointEquiv s).val * (S.T.pointEquiv sx).val at h'
        have hsx' : (S.T.pointEquiv sx).val = x := hsx
        have hs' : (S.T.pointEquiv s).val = S.T.includePoint s := rfl
        simpa only [map_mul, hsx', hs'] using h'
      · intro x hx
        rw [Subgroup.mem_centralizer_singleton_iff]
        exact hs x hx
    rw [Subgroup.mem_centralizer_iff]
    intro x hx
    exact Subgroup.mem_centralizer_singleton_iff.mp (hle hx)
  · intro hs
    rw [mem_standardLeviTorusCenter, Subgroup.mem_centralizer_iff]
    rw [Subgroup.mem_centralizer_iff] at hs
    intro x hx
    apply hs x
    rw [standardLeviSubgroup]
    exact Subgroup.mem_sup_right hx

/-- Equal relative-root projections make the quotient of the two root
characters lie in the subgroup generated by the Levi simple-root characters. -/
public lemma
    rootWeight_mul_inv_mem_standardLeviSimpleWeightClosure_of_projection_eq
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K) {α β : S.D.Root}
    (hProjection :
      RelativeRootProjection S.coeff S.integralBase.support
          (S.rootEquiv '' S.J) (S.rootEquiv α) =
        RelativeRootProjection S.coeff S.integralBase.support
          (S.rootEquiv '' S.J) (S.rootEquiv β)) :
    S.D.rootWeight α * (S.D.rootWeight β)⁻¹ ∈
      Subgroup.closure (S.D.rootWeight '' S.J) := by
  letI := Fintype.ofFinite S.ι
  classical
  have hdiff :
      S.integralPairing.root (S.rootEquiv α) -
          S.integralPairing.root (S.rootEquiv β) ∈
        AddSubgroup.closure
          (S.integralPairing.root '' (S.rootEquiv '' S.J)) := by
    rw [(S.integralSimpleRootExpansion (S.rootEquiv α)).1,
      (S.integralSimpleRootExpansion (S.rootEquiv β)).1,
      ← Finset.sum_sub_distrib]
    simp_rw [← sub_smul]
    apply AddSubgroup.sum_mem
    intro γ hγ
    by_cases hγJ : S.rootEquiv.symm γ ∈ S.J
    · apply AddSubgroup.zsmul_mem
      apply AddSubgroup.subset_closure
      exact ⟨γ, ⟨S.rootEquiv.symm γ, hγJ,
        S.rootEquiv.apply_symm_apply γ⟩, rfl⟩
    · have hvalue := congrArg (fun f : S.ι →₀ ℤ => f γ) hProjection
      have hcoeff : S.coeff (S.rootEquiv α) γ =
          S.coeff (S.rootEquiv β) γ := by
        simpa [RelativeRootProjection, hγ, hγJ] using hvalue
      rw [hcoeff, sub_self, zero_smul]
      exact AddSubgroup.zero_mem _
  have hmap :
      S.weightEquiv (Multiplicative.ofAdd
        (S.integralPairing.root (S.rootEquiv α) -
          S.integralPairing.root (S.rootEquiv β))) ∈
        Subgroup.closure (S.D.rootWeight '' S.J) := by
    refine AddSubgroup.closure_induction (p := fun x _ =>
      S.weightEquiv (Multiplicative.ofAdd x) ∈
        Subgroup.closure (S.D.rootWeight '' S.J)) ?_ ?_ ?_ ?_ hdiff
    · intro x hx
      rcases hx with ⟨γ, ⟨δ, hδJ, rfl⟩, rfl⟩
      rw [S.actualRootDatum.2.1 δ]
      exact Subgroup.subset_closure ⟨δ, hδJ, rfl⟩
    · simp
    · intro x y hx hy ihx ihy
      simpa using Subgroup.mul_mem _ ihx ihy
    · intro x hx ihx
      simpa using Subgroup.inv_mem _ ihx
  simpa [S.actualRootDatum.2.1 α, S.actualRootDatum.2.1 β,
    div_eq_mul_inv] using hmap

private lemma rootWeight_eval_eq_one_of_mem_standardLeviSimpleRoots
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K)
    (s : Variety.Point S.T.carrierVariety)
    (hcentral : S.T.includePoint s ∈ Subgroup.centralizer
      (standardLeviRootFactor S.D S.sigmaJ : Set (Variety.Point K)))
    {δ : S.D.Root} (hδJ : δ ∈ S.J) :
    torusWeightPointEval S.T s (S.D.rootWeight δ) = 1 := by
  let hD := S.standardParabolic.1.2.1
  let X := S.D.rootSubgroup δ
  let x : OneParameterParametrization X.carrierVariety :=
    Classical.choice (hD.2.2.1 δ).1.2
  have hδSigma : δ ∈ S.sigmaJ := by
    rw [S.standardParabolic.2.2, RootSubsystemSpan]
    exact Subgroup.subset_closure ⟨δ, hδJ, rfl⟩
  have hxmem : X.includePoint (x.value 1) ∈ X :=
    (X.pointEquiv (x.value 1)).2
  have hxLevi : X.includePoint (x.value 1) ∈
      standardLeviRootFactor S.D S.sigmaJ := by
    apply rootSubgroup_le_RootSubgroupGenerated S.D (Or.inl hδSigma)
    exact hxmem
  have hcomm : X.includePoint (x.value 1) * S.T.includePoint s =
      S.T.includePoint s * X.includePoint (x.value 1) :=
    hcentral _ hxLevi
  have hconj :
      (S.T.includePoint s)⁻¹ * X.includePoint (x.value 1) *
          S.T.includePoint s = X.includePoint (x.value 1) := by
    calc
      (S.T.includePoint s)⁻¹ * X.includePoint (x.value 1) *
          S.T.includePoint s =
          (S.T.includePoint s)⁻¹ *
            (X.includePoint (x.value 1) * S.T.includePoint s) := by
              rw [mul_assoc]
      _ = (S.T.includePoint s)⁻¹ *
            (S.T.includePoint s * X.includePoint (x.value 1)) := by
              rw [hcomm]
      _ = X.includePoint (x.value 1) := by simp
  have hweight := (hD.2.2.1 δ).2 x 1 s
  rw [hconj, mul_one] at hweight
  have hxval : x.value 1 =
      x.value ((S.D.rootWeight δ).pointCharacter s) := by
    apply X.inclusion_injective
    exact hweight
  have hkplus : kPlusPoint 1 =
      kPlusPoint ((S.D.rootWeight δ).pointCharacter s) := by
    have h := congrArg x.inv.onPoints hxval
    simpa only [OneParameterParametrization.value, x.hom_inv_id] using h
  apply Units.ext
  change (S.D.rootWeight δ).pointCharacter s = 1
  exact (congrArg
    (fun q : Variety.Point (KPlus k) => q.val PUnit.unit) hkplus).symm

/-- A torus-center point evaluates equally on two roots in the same relative
root fiber. -/
public lemma standardLeviTorusCenter_rootWeight_pointCharacter_eq_of_projection_eq
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K)
    (s : standardLeviTorusCenter S) {α β : S.D.Root}
    (hProjection :
      RelativeRootProjection S.coeff S.integralBase.support
          (S.rootEquiv '' S.J) (S.rootEquiv α) =
        RelativeRootProjection S.coeff S.integralBase.support
          (S.rootEquiv '' S.J) (S.rootEquiv β)) :
    (S.D.rootWeight α).pointCharacter s.1 =
      (S.D.rootWeight β).pointCharacter s.1 := by
  have hspan :=
    rootWeight_mul_inv_mem_standardLeviSimpleWeightClosure_of_projection_eq
      S hProjection
  have heval : torusWeightPointEval S.T s.1
      (S.D.rootWeight α * (S.D.rootWeight β)⁻¹) = 1 := by
    refine Subgroup.closure_induction (p := fun χ _ =>
      torusWeightPointEval S.T s.1 χ = 1) ?_ ?_ ?_ ?_ hspan
    · intro χ hχ
      rcases hχ with ⟨δ, hδJ, rfl⟩
      exact rootWeight_eval_eq_one_of_mem_standardLeviSimpleRoots
        S s.1 s.2 hδJ
    · simp
    · intro χ ψ hχ hψ ihχ ihψ
      simp [ihχ, ihψ]
    · intro χ hχ ihχ
      simp [ihχ]
  have heqUnit : torusWeightPointEval S.T s.1 (S.D.rootWeight α) =
      torusWeightPointEval S.T s.1 (S.D.rootWeight β) := by
    apply mul_inv_eq_one.mp
    simpa only [map_mul, map_inv] using heval
  exact congrArg Units.val heqUnit

/-- A torus-center point acts by one common scalar on any two
one-parameter root subgroups in the same relative-root fiber. -/
public lemma standardLeviTorusCenter_relativeRoot_conjugation
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K)
    (s : standardLeviTorusCenter S) {α β : S.D.Root}
    (hProjection :
      RelativeRootProjection S.coeff S.integralBase.support
          (S.rootEquiv '' S.J) (S.rootEquiv α) =
        RelativeRootProjection S.coeff S.integralBase.support
          (S.rootEquiv '' S.J) (S.rootEquiv β))
    (xα : OneParameterParametrization
      (S.D.rootSubgroup α).carrierVariety)
    (xβ : OneParameterParametrization
      (S.D.rootSubgroup β).carrierVariety) (t : k) :
    let c := (S.D.rootWeight α).pointCharacter s.1
    (S.T.includePoint s.1)⁻¹ *
          (S.D.rootSubgroup α).includePoint (xα.value t) *
          S.T.includePoint s.1 =
        (S.D.rootSubgroup α).includePoint (xα.value (c * t)) ∧
      (S.T.includePoint s.1)⁻¹ *
          (S.D.rootSubgroup β).includePoint (xβ.value t) *
          S.T.includePoint s.1 =
        (S.D.rootSubgroup β).includePoint (xβ.value (c * t)) := by
  let hD := S.standardParabolic.1.2.1
  have heq :=
    standardLeviTorusCenter_rootWeight_pointCharacter_eq_of_projection_eq
      S s hProjection
  dsimp only
  constructor
  · exact (hD.2.2.1 α).2 xα t s.1
  · have hβ := (hD.2.2.1 β).2 xβ t s.1
    rw [← heq] at hβ
    exact hβ

end Theory.AlgebraicGroup
