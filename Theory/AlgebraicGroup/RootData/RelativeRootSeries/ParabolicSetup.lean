module

public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.Basic
public import Theory.AlgebraicGroup.RootData.Standard

universe u

/-!
Standard-parabolic data for the relative-root filtration.

Besides the forward equations in the root-group realization, the setup stores
exact root-addition realizations for both its integral actual-root model and
its rational Chevalley model.  The integral realization yields completeness of
`D.add` on actual root weights, while the rational realization is the direct
input to Chevalley collection.  Together they prevent a degenerate partial
addition from changing the selected simple-root subsystem.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

/-- A standard parabolic root configuration equipped with compatible integral
root-datum and rational Chevalley realizations. -/
public structure StandardParabolicRelativeRootSetup
    (K : Variety k) [AlgebraicGroup K] where
  T : ClosedSubgroup K
  B : ClosedSubgroup K
  U : ClosedSubgroup K
  D : RootGroupData K T
  C : ChevalleyData K D
  [finiteActualRoot : Finite D.Root]
  ι : Type u
  X : Type u
  Y : Type u
  [finiteRoot : Finite ι]
  [addCommGroupX : AddCommGroup X]
  [addCommGroupY : AddCommGroup Y]
  integralPairing : RootPairing ι ℤ X Y
  [integralRootSystem : integralPairing.IsRootSystem]
  [integralCrystallographic : integralPairing.IsCrystallographic]
  [integralReduced : integralPairing.IsReduced]
  integralBase : integralPairing.Base
  rootEquiv : D.Root ≃ ι
  weightEquiv : Multiplicative X ≃* TorusWeight T
  positiveRoots : Set D.Root
  J : Set D.Root
  sigmaJ : Set D.Root
  coeff : ι → ι → ℤ
  integralRootAdditionRealization :
    IsRootAdditionRealization D integralPairing rootEquiv
  actualRootDatum :
    IsActualBasedRootDatum D integralPairing integralBase rootEquiv
      weightEquiv positiveRoots
  integralSimpleRootExpansion :
    HasSimpleRootExpansion integralPairing integralBase coeff
  standardParabolic :
    IsStandardParabolicSetup T B D positiveRoots J sigmaJ
  unipotentRootGeneration :
    U.toSubgroup = RootSubgroupGenerated D (positiveRoots \ sigmaJ)
  XQ : Type u
  YQ : Type u
  [addCommGroupXQ : AddCommGroup XQ]
  [moduleXQ : Module ℚ XQ]
  [addCommGroupYQ : AddCommGroup YQ]
  [moduleYQ : Module ℚ YQ]
  rationalPairing : RootPairing ι ℚ XQ YQ
  [rationalRootSystem : rationalPairing.IsRootSystem]
  [rationalCrystallographic : rationalPairing.IsCrystallographic]
  [rationalReduced : rationalPairing.IsReduced]
  rationalBase : rationalPairing.Base
  baseSupport_eq : rationalBase.support = integralBase.support
  rationalRootRealization :
    IsRootSystemRealization D rationalPairing rootEquiv rationalBase
  rationalRootAdditionRealization :
    IsRootAdditionRealization D rationalPairing rootEquiv
  rationalSimpleRootExpansion :
    HasSimpleRootExpansion rationalPairing rationalBase coeff
  chevalleySystem :
    IsChevalleySystem D C rationalPairing rootEquiv rationalBase
  maxRelativeHeight : ℕ
  relativeHeight_le : ∀ α,
    RelativeRootHeight coeff rationalBase.support (rootEquiv '' J)
        (rootEquiv α) ≤ maxRelativeHeight

attribute [instance]
  StandardParabolicRelativeRootSetup.finiteActualRoot
  StandardParabolicRelativeRootSetup.finiteRoot
  StandardParabolicRelativeRootSetup.addCommGroupX
  StandardParabolicRelativeRootSetup.addCommGroupY
  StandardParabolicRelativeRootSetup.integralRootSystem
  StandardParabolicRelativeRootSetup.integralCrystallographic
  StandardParabolicRelativeRootSetup.integralReduced
  StandardParabolicRelativeRootSetup.addCommGroupXQ
  StandardParabolicRelativeRootSetup.moduleXQ
  StandardParabolicRelativeRootSetup.addCommGroupYQ
  StandardParabolicRelativeRootSetup.moduleYQ
  StandardParabolicRelativeRootSetup.rationalRootSystem
  StandardParabolicRelativeRootSetup.rationalCrystallographic
  StandardParabolicRelativeRootSetup.rationalReduced

/-- Exact addition in the integral actual-root model supplies completeness of
the partial addition operation on torus roots. -/
public theorem StandardParabolicRelativeRootSetup.rootAdditionComplete
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K) :
    S.D.IsRootAdditionComplete :=
  S.integralRootAdditionRealization.isRootAdditionComplete
    S.actualRootDatum.2.1

/-- The subgroup generated by roots of relative height at least `i`. -/
@[expose]
public noncomputable def StandardParabolicRelativeRootSetup.layer
    {K : Variety k} [AlgebraicGroup K]
    (S : StandardParabolicRelativeRootSetup K) (i : ℕ) :
    Subgroup (Variety.Point K) :=
  RelativeRootSeries S.D S.rootEquiv S.rationalBase.support S.coeff S.J i

end Theory.AlgebraicGroup
