module

public import Theory.AlgebraicGroup.RootData.PositiveSystemBase
public import Theory.AlgebraicGroup.RootData.RankTwoSingularIsolation

/-!
Fundamental-root induction across a positive rank-two chain step.

For a positive system aligned with a root-system base, this module turns the
characteristic-free rank-two parameter isolation into the induction step used
to generate positive root subgroups.  If the root subgroups at smaller base
height already lie in the subgroup generated by the base-support roots, then
the endpoint obtained by adding a base-support root lies there as well.  A
second theorem identifies the support of an independently aligned positive
base with `FundamentalRootsFor D positiveRoots`, giving the form needed by the
Borel fundamental-generation theorem.  The former same-base declarations are
kept as compatibility wrappers.

The proof delegates the finite `A2`, `B2`, `C2`, and `G2` calculation to
`RankTwoSingularIsolation`.  That calculation uses the full Chevalley
collection word and its singular characteristic-two and characteristic-three
branches, so this module never assumes that the `(1,1)` coefficient is
nonzero.  The only remaining argument separates support roots into fundamental
roots and positive roots of strictly smaller height.  This is the local
rank-two step in the positive-root induction of GLS3, Section 1.12.
-/

namespace Theory.AlgebraicGroup

universe u

variable {k : Type u} [Field k] [IsAlgClosed k]

/- Fundamental roots are the height-one support roots for any base aligned
with the selected positive system; this uses only exact root addition. -/
omit [IsAlgClosed k] in
private theorem fundamentalRootsFor_eq_baseSupport_of_positiveAlignment
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) {positiveRoots : Set D.Root}
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (base : P.Base)
    (hPositiveRoots : ∀ rho, rho ∈ positiveRoots ↔ base.IsPos (e rho))
    (hAdd : IsRootAdditionRealization D P e) :
    FundamentalRootsFor D positiveRoots = {rho | e rho ∈ base.support} := by
  ext alpha
  constructor
  · intro hFund
    change alpha ∈ positiveRoots ∧
      ∀ beta, beta ∈ positiveRoots → ∀ gamma, gamma ∈ positiveRoots →
        D.add beta gamma ≠ some alpha at hFund
    by_contra hNotSupport
    have hAlphaPos : base.IsPos (e alpha) := (hPositiveRoots alpha).mp hFund.1
    obtain ⟨j, hj, hjpair⟩ := hAlphaPos.exists_mem_support_pos_pairingIn
    rw [P.zero_lt_pairingIn_iff'] at hjpair
    have hne : e alpha ≠ j := by
      intro heq
      apply hNotSupport
      change e alpha ∈ base.support
      simpa [heq] using hj
    obtain ⟨m, hm⟩ := P.root_sub_root_mem_of_pairingIn_pos hjpair hne
    let beta : D.Root := e.symm m
    let delta : D.Root := e.symm j
    have hbetaPos : base.IsPos (e beta) := by
      dsimp [beta]
      simpa using hAlphaPos.sub hj (by simpa [beta, delta] using hm)
    have hdeltaPos : base.IsPos (e delta) := by
      dsimp [delta]
      simpa using base.isPos_of_mem_support hj
    have hsum : P.root (e alpha) = P.root (e beta) + P.root (e delta) := by
      dsimp [beta, delta]
      rw [e.apply_symm_apply, e.apply_symm_apply]
      rw [hm]
      module
    have hadd : D.add beta delta = some alpha :=
      hAdd.add_of_root_eq_add hsum
    exact (hFund.2 beta ((hPositiveRoots beta).mpr hbetaPos)
      delta ((hPositiveRoots delta).mpr hdeltaPos) hadd)
  · intro hSupport
    have hAlphaPos : base.IsPos (e alpha) := base.isPos_of_mem_support hSupport
    refine ⟨(hPositiveRoots alpha).mpr hAlphaPos, ?_⟩
    intro beta hbeta gamma hgamma hadd
    have hsum : P.root (e alpha) = P.root (e beta) + P.root (e gamma) :=
      (hAdd beta gamma alpha).mp hadd
    have hbetaPos : base.IsPos (e beta) := (hPositiveRoots beta).mp hbeta
    have hgammaPos : base.IsPos (e gamma) := (hPositiveRoots gamma).mp hgamma
    have hheight := base.height_add hsum
    rw [base.height_one_of_mem_support hSupport] at hheight
    have hb : 0 < base.height (e beta) := (base.isPos_iff).mp hbetaPos
    have hg : 0 < base.height (e gamma) := (base.isPos_iff).mp hgammaPos
    omega

public theorem rootSubgroup_le_baseSupportGenerated_of_rankTwoPositiveChainStep_of_separateBase
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {positiveRoots : Set D.Root}
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (systemBase positiveBase : P.Base)
    (hPositiveRoots : ∀ rho, rho ∈ positiveRoots ↔ positiveBase.IsPos (e rho))
    (hC : IsChevalleySystem D C P e systemBase)
    (hActual : IsRootSystemRealization D P e systemBase)
    (hAdd : IsRootAdditionRealization D P e)
    {alpha delta gamma : D.Root}
    (hStep : RankTwoPositiveChainStep D P e positiveBase alpha delta gamma)
    (hEarlier : ∀ rho, rho ∈ positiveRoots →
      positiveBase.height (e rho) < positiveBase.height (e gamma) →
      (D.rootSubgroup rho).toSubgroup ≤
        RootSubgroupGenerated D {sigma | e sigma ∈ positiveBase.support}) :
    (D.rootSubgroup gamma).toSubgroup ≤
      RootSubgroupGenerated D {sigma | e sigma ∈ positiveBase.support} := by
  apply rootSubgroup_le_of_rankTwoPositiveChainStep_of_separateBase
    D C P e systemBase positiveBase hC hActual hAdd hStep
    (RootSubgroupGenerated D {sigma | e sigma ∈ positiveBase.support})
  intro rho hrho
  rcases hrho with hrho | hrho
  · exact rootSubgroup_le_RootSubgroupGenerated D hrho
  · exact hEarlier rho ((hPositiveRoots rho).2 hrho.1) hrho.2

public theorem rootSubgroup_le_baseSupportGenerated_of_rankTwoPositiveChainStep
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {positiveRoots : Set D.Root}
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (base : P.Base)
    (hPositiveRoots : ∀ rho, rho ∈ positiveRoots ↔ base.IsPos (e rho))
    (hC : IsChevalleySystem D C P e base)
    (hActual : IsRootSystemRealization D P e base)
    (hAdd : IsRootAdditionRealization D P e)
    {alpha delta gamma : D.Root}
    (hStep : RankTwoPositiveChainStep D P e base alpha delta gamma)
    (hEarlier : ∀ rho, rho ∈ positiveRoots →
      base.height (e rho) < base.height (e gamma) →
      (D.rootSubgroup rho).toSubgroup ≤
        RootSubgroupGenerated D {sigma | e sigma ∈ base.support}) :
    (D.rootSubgroup gamma).toSubgroup ≤
      RootSubgroupGenerated D {sigma | e sigma ∈ base.support} := by
  exact rootSubgroup_le_baseSupportGenerated_of_rankTwoPositiveChainStep_of_separateBase
    D C P e base base hPositiveRoots hC hActual hAdd hStep hEarlier

/-- Fundamental-root form of the rank-two induction step.  The realization
identifies the base-support roots with the fundamental roots of the aligned
positive system. -/
public theorem rootSubgroup_le_fundamentalRootsGenerated_of_alignedRankTwoPositiveChainStep
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {positiveRoots : Set D.Root}
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (systemBase positiveBase : P.Base)
    (hD : D.IsRealization)
    (hPositiveRoots : ∀ rho, rho ∈ positiveRoots ↔ positiveBase.IsPos (e rho))
    (hC : IsChevalleySystem D C P e systemBase)
    (hActual : IsRootSystemRealization D P e systemBase)
    (hAdd : IsRootAdditionRealization D P e)
    {alpha delta gamma : D.Root}
    (hStep : RankTwoPositiveChainStep D P e positiveBase alpha delta gamma)
    (hEarlier : ∀ rho, rho ∈ positiveRoots →
      positiveBase.height (e rho) < positiveBase.height (e gamma) →
      (D.rootSubgroup rho).toSubgroup ≤
        RootSubgroupGenerated D (FundamentalRootsFor D positiveRoots)) :
      (D.rootSubgroup gamma).toSubgroup ≤
      RootSubgroupGenerated D (FundamentalRootsFor D positiveRoots) := by
  have _hD := hD
  have hsupport := fundamentalRootsFor_eq_baseSupport_of_positiveAlignment
    D P e positiveBase hPositiveRoots hAdd
  have hEarlier' : ∀ rho, rho ∈ positiveRoots →
      positiveBase.height (e rho) < positiveBase.height (e gamma) →
      (D.rootSubgroup rho).toSubgroup ≤
        RootSubgroupGenerated D {sigma | e sigma ∈ positiveBase.support} := by
    intro rho hrho hheight
    simpa [← hsupport] using hEarlier rho hrho hheight
  have hresult := rootSubgroup_le_baseSupportGenerated_of_rankTwoPositiveChainStep_of_separateBase
    D C P e systemBase positiveBase hPositiveRoots hC hActual hAdd hStep hEarlier'
  simpa [← hsupport] using hresult

public theorem rootSubgroup_le_fundamentalRootsGenerated_of_rankTwoPositiveChainStep
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {positiveRoots : Set D.Root}
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (base : P.Base)
    (hD : D.IsRealization)
    (hPositiveRoots : ∀ rho, rho ∈ positiveRoots ↔ base.IsPos (e rho))
    (hC : IsChevalleySystem D C P e base)
    (hActual : IsRootSystemRealization D P e base)
    (hAdd : IsRootAdditionRealization D P e)
    {alpha delta gamma : D.Root}
    (hStep : RankTwoPositiveChainStep D P e base alpha delta gamma)
    (hEarlier : ∀ rho, rho ∈ positiveRoots →
      base.height (e rho) < base.height (e gamma) →
      (D.rootSubgroup rho).toSubgroup ≤
        RootSubgroupGenerated D (FundamentalRootsFor D positiveRoots)) :
    (D.rootSubgroup gamma).toSubgroup ≤
      RootSubgroupGenerated D (FundamentalRootsFor D positiveRoots) := by
  exact rootSubgroup_le_fundamentalRootsGenerated_of_alignedRankTwoPositiveChainStep
    D C P e base base hD hPositiveRoots hC hActual hAdd hStep hEarlier

end Theory.AlgebraicGroup
