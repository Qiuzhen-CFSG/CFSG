    apply Subgroup.list_prod_mem
    intro x hx
    rw [List.mem_map] at hx
    obtain ⟨q, hq, rfl⟩ := hx
    rw [List.mem_map] at hq
    obtain ⟨r, hr, rfl⟩ := hq
    exact positiveRoot_mem_layer (P := P) (e := e)
      (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
        (n := i) (alpha := r.1) (t := r.2.1) S (by rw [hexact r hr])
  have hrightLayer : FilteredCollection.wordProduct C.x
      (word.map fun q => (q.1, q.2.2)) ∈ L := by
    apply Subgroup.list_prod_mem
    intro x hx
    rw [List.mem_map] at hx
    obtain ⟨q, hq, rfl⟩ := hx
    rw [List.mem_map] at hq
    obtain ⟨r, hr, rfl⟩ := hq
    exact positiveRoot_mem_layer (P := P) (e := e)
      (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
        (n := i) (alpha := r.1) (t := r.2.2) S (by rw [hexact r hr])
  have hdifferenceLayer : FilteredCollection.wordProduct C.x
      (word.map fun q => (q.1, q.2.1 - q.2.2)) ∈ L := by
    apply Subgroup.list_prod_mem
    intro x hx
    rw [List.mem_map] at hx
    obtain ⟨q, hq, rfl⟩ := hx
    rw [List.mem_map] at hq
    obtain ⟨r, hr, rfl⟩ := hq
    exact positiveRoot_mem_layer (P := P) (e := e)
      (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
        (n := i) (alpha := r.1) (t := r.2.1 - r.2.2) S (by rw [hexact r hr])
  let leftPoint : L :=
    ⟨FilteredCollection.wordProduct C.x (word.map fun q => (q.1, q.2.1)),
      hleftLayer⟩
  let rightPoint : L :=
    ⟨FilteredCollection.wordProduct C.x (word.map fun q => (q.1, q.2.2)),
      hrightLayer⟩
  let differencePoint : L :=
    ⟨FilteredCollection.wordProduct C.x
      (word.map fun q => (q.1, q.2.1 - q.2.2)), hdifferenceLayer⟩
  revert hrelation
  have hquotient : QuotientGroup.mk' Nsub differencePoint =
      QuotientGroup.mk' Nsub leftPoint * (QuotientGroup.mk' Nsub rightPoint)⁻¹ := by
    induction word with
    | nil =>
        change (1 : Q) = 1 * 1⁻¹
        simp
    | cons q tail ih =>
        have hqExact := hexact q (by simp)
        have htailExact : ∀ r ∈ tail,
            positiveHeight P e positiveBase r.1 = i := by
          intro r hr
          exact hexact r (by simp [hr])
        let qLeft : L := ⟨C.x q.1 q.2.1,
          positiveRoot_mem_layer (P := P) (e := e)
            (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
              (n := i) (alpha := q.1) (t := q.2.1) S (by rw [hqExact])⟩
        let qRight : L := ⟨C.x q.1 q.2.2,
          positiveRoot_mem_layer (P := P) (e := e)
            (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
              (n := i) (alpha := q.1) (t := q.2.2) S (by rw [hqExact])⟩
        let qDifference : L := ⟨C.x q.1 (q.2.1 - q.2.2),
          positiveRoot_mem_layer (P := P) (e := e)
            (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
              (n := i) (alpha := q.1) (t := q.2.1 - q.2.2) S (by rw [hqExact])⟩
        let tailLeft : L :=
          ⟨FilteredCollection.wordProduct C.x (tail.map fun r => (r.1, r.2.1)), by
            apply Subgroup.list_prod_mem
            intro x hx
            rw [List.mem_map] at hx
            obtain ⟨r, hr, rfl⟩ := hx
            rw [List.mem_map] at hr
            obtain ⟨s, hs, rfl⟩ := hr
            exact positiveRoot_mem_layer (P := P) (e := e)
              (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
                (n := i) (alpha := s.1) (t := s.2.1) S (by rw [htailExact s hs])⟩
        let tailRight : L :=
          ⟨FilteredCollection.wordProduct C.x (tail.map fun r => (r.1, r.2.2)), by
            apply Subgroup.list_prod_mem
            intro x hx
            rw [List.mem_map] at hx
            obtain ⟨r, hr, rfl⟩ := hx
            rw [List.mem_map] at hr
            obtain ⟨s, hs, rfl⟩ := hr
            exact positiveRoot_mem_layer (P := P) (e := e)
              (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
                (n := i) (alpha := s.1) (t := s.2.2) S (by rw [htailExact s hs])⟩
        let tailDifference : L :=
          ⟨FilteredCollection.wordProduct C.x
              (tail.map fun r => (r.1, r.2.1 - r.2.2)), by
            apply Subgroup.list_prod_mem
            intro x hx
            rw [List.mem_map] at hx
            obtain ⟨r, hr, rfl⟩ := hx
            rw [List.mem_map] at hr
            obtain ⟨s, hs, rfl⟩ := hr
            exact positiveRoot_mem_layer (P := P) (e := e)
              (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
                (n := i) (alpha := s.1) (t := s.2.1 - s.2.2) S
                  (by rw [htailExact s hs])⟩
        have ih' := ih htailExact tailLeft.property tailRight.property
          tailDifference.property
        change QuotientGroup.mk' Nsub tailDifference =
          QuotientGroup.mk' Nsub tailLeft * (QuotientGroup.mk' Nsub tailRight)⁻¹ at ih'
        have hfactor : QuotientGroup.mk' Nsub qDifference =
            QuotientGroup.mk' Nsub qLeft * (QuotientGroup.mk' Nsub qRight)⁻¹ := by
          have hx : C.x q.1 (q.2.1 - q.2.2) =
              C.x q.1 q.2.1 * (C.x q.1 q.2.2)⁻¹ := by
            rw [sub_eq_add_neg, ← S.chevalley.2.2.2.1,
              chevalleyRoot_neg P e systemBase positiveBase C S]
          rw [← map_inv, ← map_mul]
          apply congrArg (QuotientGroup.mk' Nsub)
          apply Subtype.ext
          exact hx
        change QuotientGroup.mk' Nsub (qDifference * tailDifference) =
          QuotientGroup.mk' Nsub (qLeft * tailLeft) *
            (QuotientGroup.mk' Nsub (qRight * tailRight))⁻¹
        rw [map_mul, map_mul, map_mul, ih', hfactor, mul_inv_rev]
        ac_rfl
  intro hrelation
  have hrelationOne : QuotientGroup.mk' Nsub leftPoint *
      (QuotientGroup.mk' Nsub rightPoint)⁻¹ = 1 := by
    rw [← map_inv, ← map_mul]
    exact (QuotientGroup.eq_one_iff
      (⟨FilteredCollection.wordProduct C.x (word.map fun q => (q.1, q.2.1)) *
        (FilteredCollection.wordProduct C.x (word.map fun q => (q.1, q.2.2)))⁻¹,
          L.mul_mem hleftLayer (L.inv_mem hrightLayer)⟩ : L)).2 hrelation
  have hdifferenceOne : QuotientGroup.mk' Nsub differencePoint = 1 := by
    rw [hquotient, hrelationOne]
  exact (QuotientGroup.eq_one_iff differencePoint).1 hdifferenceOne

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma chevalleyWord_eq_one_of_params_eq_zero
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (word : List (D.Root × k)) (hzero : ∀ q ∈ word, q.2 = 0) :
    FilteredCollection.wordProduct C.x word = 1 := by
  induction word with
  | nil => simp [FilteredCollection.wordProduct]
  | cons q tail ih =>
      have hq := hzero q (by simp)
      have htail : ∀ r ∈ tail, r.2 = 0 := by
        intro r hr
        exact hzero r (by simp [hr])
      rw [show FilteredCollection.wordProduct C.x (q :: tail) =
        C.x q.1 q.2 * FilteredCollection.wordProduct C.x tail by rfl]
      rw [hq, chevalleyRoot_zero P e systemBase positiveBase C S, ih htail, one_mul]

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma chevalleyWord_eq_single_of_other_params_eq_zero
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (word : List (D.Root × k)) (q : D.Root × k) (hq : q ∈ word)
    (hnodup : (word.map Prod.fst).Nodup)
    (hzero : ∀ r ∈ word, r ≠ q → r.2 = 0) :
    FilteredCollection.wordProduct C.x word = C.x q.1 q.2 := by
  induction word with
  | nil => simp at hq
  | cons r tail ih =>
      have hnodup' := List.nodup_cons.mp hnodup
      rcases List.mem_cons.mp hq with rfl | hqtail
      · have htail : ∀ z ∈ tail, z.2 = 0 := by
          intro z hz
          apply hzero z (by simp [hz])
          intro heq
          subst z
          exact hnodup'.1 (List.mem_map.mpr ⟨q, hz, rfl⟩)
        rw [show FilteredCollection.wordProduct C.x (q :: tail) =
          C.x q.1 q.2 * FilteredCollection.wordProduct C.x tail by rfl]
        rw [chevalleyWord_eq_one_of_params_eq_zero
          P e systemBase positiveBase C S tail htail, mul_one]
      · have hrzero : r.2 = 0 := hzero r (by simp) (by
          intro heq
          subst r
          exact hnodup'.1 (List.mem_map.mpr ⟨q, hqtail, rfl⟩))
        have htail : ∀ z ∈ tail, z ≠ q → z.2 = 0 := by
          intro z hz hzne
          exact hzero z (by simp [hz]) hzne
        rw [show FilteredCollection.wordProduct C.x (r :: tail) =
          C.x r.1 r.2 * FilteredCollection.wordProduct C.x tail by rfl]
        rw [hrzero, chevalleyRoot_zero P e systemBase positiveBase C S, one_mul,
          ih hqtail hnodup'.2 htail]

private noncomputable def nonzeroRootSupport
    (word : List (D.Root × k)) : Finset D.Root := by
  classical
  exact (word.toFinset.filter fun q => q.2 ≠ 0).image Prod.fst

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma mem_nonzeroRootSupport_iff
    (word : List (D.Root × k)) (alpha : D.Root) :
    alpha ∈ nonzeroRootSupport word ↔
      ∃ q ∈ word, q.1 = alpha ∧ q.2 ≠ 0 := by
  classical
  simp [nonzeroRootSupport]

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma pair_eq_of_mem_of_root_eq
    (word : List (D.Root × k)) (hnodup : (word.map Prod.fst).Nodup)
    {q r : D.Root × k} (hq : q ∈ word) (hr : r ∈ word)
    (hroot : q.1 = r.1) : q = r := by
  induction word with
  | nil => simp at hq
  | cons z tail ih =>
      have hnodup' := List.nodup_cons.mp hnodup
      rcases List.mem_cons.mp hq with rfl | hqtail
      · rcases List.mem_cons.mp hr with rfl | hrtail
        · rfl
        · exact False.elim (hnodup'.1
            (List.mem_map.mpr ⟨r, hrtail, hroot.symm⟩))
      · rcases List.mem_cons.mp hr with rfl | hrtail
        · exact False.elim (hnodup'.1
            (List.mem_map.mpr ⟨q, hqtail, hroot⟩))
        · exact ih hnodup'.2 hqtail hrtail

omit [Fintype D.Root] in
private lemma exactWord_parameters_eq_zero_of_singleRoot
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i)
    (hsingle : ∀ alpha t,
      positiveHeight P e positiveBase alpha = i →
        C.x alpha t ∈ positiveLayer P e positiveBase (i + 1) → t = 0)
    (word : List (D.Root × k)) (hnodup : (word.map Prod.fst).Nodup)
    (hexact : ∀ q ∈ word, positiveHeight P e positiveBase q.1 = i)
    (hmem : FilteredCollection.wordProduct C.x word ∈
      positiveLayer P e positiveBase (i + 1)) :
    ∀ q ∈ word, q.2 = 0 := by
  classical
  by_cases hempty : nonzeroRootSupport word = ∅
  · intro q hq
    by_contra hqzero
    have hqsupport : q.1 ∈ nonzeroRootSupport word :=
      (mem_nonzeroRootSupport_iff word q.1).2 ⟨q, hq, rfl, hqzero⟩
    simp [hempty] at hqsupport
  · have hsupportNonempty : (nonzeroRootSupport word).Nonempty :=
      Finset.nonempty_iff_ne_empty.mpr hempty
    obtain ⟨alpha, halphaSupport⟩ := hsupportNonempty
    obtain ⟨qa, hqa, hqaRoot, hqaNonzero⟩ :=
      (mem_nonzeroRootSupport_iff word alpha).1 halphaSupport
    by_cases hcard : (nonzeroRootSupport word).card = 1
    · have hcardLe : (nonzeroRootSupport word).card ≤ 1 := by omega
      have hzeroOther : ∀ r ∈ word, r ≠ qa → r.2 = 0 := by
        intro r hr hrne
        by_contra hrzero
        have hrSupport : r.1 ∈ nonzeroRootSupport word :=
          (mem_nonzeroRootSupport_iff word r.1).2 ⟨r, hr, rfl, hrzero⟩
        have hroot : r.1 = qa.1 :=
          Finset.card_le_one.mp hcardLe r.1 hrSupport qa.1
            ((mem_nonzeroRootSupport_iff word qa.1).2
              ⟨qa, hqa, rfl, hqaNonzero⟩)
        exact hrne (pair_eq_of_mem_of_root_eq word hnodup hr hqa hroot)
      have hproduct := chevalleyWord_eq_single_of_other_params_eq_zero
        P e systemBase positiveBase C S word qa hqa hnodup hzeroOther
      have hqaMem : C.x qa.1 qa.2 ∈ positiveLayer P e positiveBase (i + 1) := by
        rw [← hproduct]
        exact hmem
      exact False.elim (hqaNonzero
        (hsingle qa.1 qa.2 (hexact qa hqa) hqaMem))
    · have hcardGt : 1 < (nonzeroRootSupport word).card := by
        have hcardPos : 0 < (nonzeroRootSupport word).card :=
          Finset.card_pos.mpr ⟨alpha, halphaSupport⟩
        omega
      obtain ⟨beta, hbetaSupport, hbetaNe⟩ :=
        Finset.exists_mem_ne hcardGt alpha
      obtain ⟨qb, hqb, hqbRoot, hqbNonzero⟩ :=
        (mem_nonzeroRootSupport_iff word beta).1 hbetaSupport
      have halphaPos : 0 < positiveHeight P e positiveBase qa.1 := by
        rw [hexact qa hqa]
        exact_mod_cast hi
      have hbetaPos : 0 < positiveHeight P e positiveBase qb.1 := by
        rw [hexact qb hqb]
        exact_mod_cast hi
      have hrootNe : qa.1 ≠ qb.1 := by
        rw [hqaRoot, hqbRoot]
        exact hbetaNe.symm
      obtain ⟨u, v, hfix, hmove⟩ :=
        exists_pairingSeparator P e systemBase positiveBase C S qa.1 qb.1
          halphaPos hbetaPos hrootNe
      let differenceWord := word.map fun q =>
        (q.1, (corootPairScale (D := D) qa.1 qb.1 q.1 u v - 1) * q.2)
      have hscaledMem :
          FilteredCollection.wordProduct C.x
              (word.map fun q =>
                (q.1, corootPairScale (D := D) qa.1 qb.1 q.1 u v * q.2)) ∈
            positiveLayer P e positiveBase (i + 1) := by
        have hconj := corootPair_conjugates_layer
          P e systemBase positiveBase C S (i + 1) qa.1 qb.1 u v
            (FilteredCollection.wordProduct C.x word) hmem
        rw [corootPair_conjugates_word P e systemBase positiveBase C S] at hconj
        exact hconj
      have hrelation :
          FilteredCollection.wordProduct C.x
              (word.map fun q =>
                (q.1, corootPairScale (D := D) qa.1 qb.1 q.1 u v * q.2)) *
            (FilteredCollection.wordProduct C.x word)⁻¹ ∈
              positiveLayer P e positiveBase (i + 1) :=
        (positiveLayer P e positiveBase (i + 1)).mul_mem hscaledMem
          ((positiveLayer P e positiveBase (i + 1)).inv_mem hmem)
      have hdifferenceMem :
          FilteredCollection.wordProduct C.x differenceWord ∈
            positiveLayer P e positiveBase (i + 1) := by
        exact exactWord_difference_mem_next P e systemBase positiveBase C S i hi
          word hexact qa.1 qb.1 u v hrelation
      have hdifferenceNodup : (differenceWord.map Prod.fst).Nodup := by
        simpa [differenceWord, List.map_map, Function.comp_def] using hnodup
      have hdifferenceExact : ∀ q ∈ differenceWord,
          positiveHeight P e positiveBase q.1 = i := by
        intro q hq
        rw [List.mem_map] at hq
        obtain ⟨r, hr, rfl⟩ := hq
        exact hexact r hr
      have hsupportSubset : nonzeroRootSupport differenceWord ⊆
          nonzeroRootSupport word := by
        intro gamma hgamma
        obtain ⟨q, hq, hqRoot, hqNonzero⟩ :=
          (mem_nonzeroRootSupport_iff differenceWord gamma).1 hgamma
        rw [List.mem_map] at hq
        obtain ⟨r, hr, rfl⟩ := hq
        apply (mem_nonzeroRootSupport_iff word gamma).2
        refine ⟨r, hr, hqRoot, ?_⟩
        intro hrzero
        apply hqNonzero
        rw [hrzero, mul_zero]
      have hqaNotDifference : qa.1 ∉ nonzeroRootSupport differenceWord := by
        intro hqaDifference
        obtain ⟨q, hq, hqRoot, hqNonzero⟩ :=
          (mem_nonzeroRootSupport_iff differenceWord qa.1).1 hqaDifference
        rw [List.mem_map] at hq
        obtain ⟨r, hr, rfl⟩ := hq
        apply hqNonzero
        rw [hqRoot, hfix, sub_self, zero_mul]
      have hqaOriginal : qa.1 ∈ nonzeroRootSupport word :=
        (mem_nonzeroRootSupport_iff word qa.1).2
          ⟨qa, hqa, rfl, hqaNonzero⟩
      have hproper : nonzeroRootSupport differenceWord ⊂ nonzeroRootSupport word :=
        Finset.ssubset_iff_subset_ne.mpr ⟨hsupportSubset, fun heq =>
          hqaNotDifference (heq.symm ▸ hqaOriginal)⟩
      have hrec := exactWord_parameters_eq_zero_of_singleRoot
        S i hi hsingle differenceWord
          hdifferenceNodup hdifferenceExact hdifferenceMem
      have hqbDifference :
          (qb.1,
            (corootPairScale (D := D) qa.1 qb.1 qb.1 u v - 1) * qb.2) ∈
              differenceWord :=
        List.mem_map.mpr ⟨qb, hqb, rfl⟩
      have hbetaDifferenceZero := hrec _ hqbDifference
      have hmoveField :
          corootPairScale (D := D) qa.1 qb.1 qb.1 u v ≠ 1 := hmove
      exact False.elim
        ((mul_ne_zero (sub_ne_zero.mpr hmoveField) hqbNonzero) hbetaDifferenceZero)
termination_by (nonzeroRootSupport word).card
decreasing_by exact Finset.card_lt_card hproper

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma word_mul_exactHeightPart_inv_mem_next
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) (word : List (D.Root × k))
    (hzeroBelow : ∀ q ∈ word,
      positiveHeight P e positiveBase q.1 < i → q.2 = 0) :
    FilteredCollection.wordProduct C.x word *
        (FilteredCollection.wordProduct C.x
          (word.filter fun q => positiveHeight P e positiveBase q.1 = i))⁻¹ ∈
      positiveLayer P e positiveBase (i + 1) := by
  classical
  let hN := positiveLayer_next_normal P e systemBase positiveBase C S i hi
  induction word with
  | nil => simp [FilteredCollection.wordProduct]
  | cons q tail ih =>
      have hzeroTail : ∀ r ∈ tail,
          positiveHeight P e positiveBase r.1 < i → r.2 = 0 := by
        intro r hr
        exact hzeroBelow r (by simp [hr])
      have ih' := ih hzeroTail
      have hqLayer : C.x q.1 q.2 ∈ positiveLayer P e positiveBase i := by
        by_cases hle : (i : Int) ≤ positiveHeight P e positiveBase q.1
        · exact positiveRoot_mem_layer P e systemBase positiveBase C i q.1 q.2 S hle
        · have hqzero := hzeroBelow q (by simp) (by omega)
          rw [hqzero, chevalleyRoot_zero P e systemBase positiveBase C S]
          exact Subgroup.one_mem _
      by_cases hqExact : positiveHeight P e positiveBase q.1 = i
      · have hconj := hN.conj_mem
          (⟨FilteredCollection.wordProduct C.x tail *
              (FilteredCollection.wordProduct C.x
                (tail.filter fun r => positiveHeight P e positiveBase r.1 = i))⁻¹,
            positiveLayer_succ_le P e positiveBase i ih'⟩ :
              positiveLayer P e positiveBase i)
          ih' (⟨C.x q.1 q.2, hqLayer⟩ : positiveLayer P e positiveBase i)
        change C.x q.1 q.2 *
            (FilteredCollection.wordProduct C.x tail *
              (FilteredCollection.wordProduct C.x
                (tail.filter fun r => positiveHeight P e positiveBase r.1 = i))⁻¹) *
              (C.x q.1 q.2)⁻¹ ∈ positiveLayer P e positiveBase (i + 1) at hconj
        simpa [FilteredCollection.wordProduct, hqExact, mul_inv_rev, mul_assoc]
          using hconj
      · have hqNotBelowOrAbove :
            positiveHeight P e positiveBase q.1 < i ∨
              (i + 1 : Int) ≤ positiveHeight P e positiveBase q.1 := by
          omega
        rcases hqNotBelowOrAbove with hqBelow | hqAbove
        · have hqzero := hzeroBelow q (by simp) hqBelow
          simpa [FilteredCollection.wordProduct, hqExact, hqzero,
            chevalleyRoot_zero P e systemBase positiveBase C S] using ih'
        · have hqNext : C.x q.1 q.2 ∈ positiveLayer P e positiveBase (i + 1) :=
            positiveRoot_mem_layer P e systemBase positiveBase C (i + 1) q.1 q.2 S
              hqAbove
          have hmul := (positiveLayer P e positiveBase (i + 1)).mul_mem hqNext ih'
          simpa [FilteredCollection.wordProduct, hqExact, mul_assoc] using hmul

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma minimalHeight_difference_mem_next
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) (word : List (D.Root × k))
    (hzeroBelow : ∀ q ∈ word,
      positiveHeight P e positiveBase q.1 < i → q.2 = 0)
    (alpha beta : D.Root) (u v : kˣ)
    (heq : FilteredCollection.wordProduct C.x
      (word.map fun q =>
        (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)) =
      FilteredCollection.wordProduct C.x word) :
    FilteredCollection.wordProduct C.x
      ((word.filter fun q => positiveHeight P e positiveBase q.1 = i).map fun q =>
        (q.1, (corootPairScale (D := D) alpha beta q.1 u v - 1) * q.2)) ∈
      positiveLayer P e positiveBase (i + 1) := by
  classical
  let scaledWord := word.map fun q =>
    (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)
  let exactWord := word.filter fun q => positiveHeight P e positiveBase q.1 = i
  have hscaledZeroBelow : ∀ q ∈ scaledWord,
      positiveHeight P e positiveBase q.1 < i → q.2 = 0 := by
    intro q hq hqBelow
    rw [List.mem_map] at hq
    obtain ⟨r, hr, rfl⟩ := hq
    rw [hzeroBelow r hr hqBelow, mul_zero]
  have horigApprox := word_mul_exactHeightPart_inv_mem_next
    P e systemBase positiveBase C S i hi word hzeroBelow
  have hscaledApprox := word_mul_exactHeightPart_inv_mem_next
    P e systemBase positiveBase C S i hi scaledWord hscaledZeroBelow
  have hfilter :
      scaledWord.filter (fun q => positiveHeight P e positiveBase q.1 = i) =
        exactWord.map fun q =>
          (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2) := by
    dsimp [scaledWord, exactWord]
    rw [List.filter_map]
    rfl
  have hrelation :
      FilteredCollection.wordProduct C.x
          (exactWord.map fun q =>
            (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)) *
        (FilteredCollection.wordProduct C.x exactWord)⁻¹ ∈
          positiveLayer P e positiveBase (i + 1) := by
    have hmul := (positiveLayer P e positiveBase (i + 1)).mul_mem
      ((positiveLayer P e positiveBase (i + 1)).inv_mem hscaledApprox) horigApprox
    rw [hfilter] at hmul
    dsimp [exactWord] at hmul ⊢
    convert hmul using 1
    all_goals
      rw [heq]
      group
  apply exactWord_difference_mem_next P e systemBase positiveBase C S i hi exactWord
  · intro q hq
    dsimp [exactWord] at hq
    exact of_decide_eq_true (List.mem_filter.mp hq).2
  · exact hrelation

private noncomputable def maxPositiveHeight : Nat :=
  Finset.univ.sup fun alpha : D.Root => (positiveHeight P e positiveBase alpha).toNat

omit [IsAlgClosed k] [Finite ι] [P.IsRootSystem] [P.IsCrystallographic]
  [P.IsReduced] in
private lemma positiveHeight_toNat_le_max (alpha : D.Root) :
    (positiveHeight P e positiveBase alpha).toNat ≤
      maxPositiveHeight P e positiveBase := by
  classical
  exact Finset.le_sup (f := fun gamma : D.Root =>
    (positiveHeight P e positiveBase gamma).toNat) (Finset.mem_univ alpha)

private theorem exactHeight_parameters_eq_zero_of_wordProduct_mem_next
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) (word : List (D.Root × k))
    (hnodup : (word.map Prod.fst).Nodup)
    (hexact : ∀ q ∈ word, positiveHeight P e positiveBase q.1 = i)
    (hmem : FilteredCollection.wordProduct C.x word ∈
      positiveLayer P e positiveBase (i + 1)) :
    ∀ q ∈ word, q.2 = 0 := by
  classical
  have hsingle : ∀ alpha t,
      positiveHeight P e positiveBase alpha = i →
        C.x alpha t ∈ positiveLayer P e positiveBase (i + 1) → t = 0 := by
    intro alpha t halpha hrootMem
    obtain ⟨params, hparams⟩ := positiveLayer_exists_collected
      P e systemBase positiveBase C (i + 1) (by omega) S (C.x alpha t) hrootMem
    let highWord : List (D.Root × k) :=
      (rootAtLeastList P e positiveBase (i + 1)).map fun gamma =>
        (gamma, params gamma)
    have hhighProduct :
        FilteredCollection.wordProduct C.x highWord = C.x alpha t := by
      calc
        FilteredCollection.wordProduct C.x highWord =
            ((rootAtLeastList P e positiveBase (i + 1)).map fun gamma =>
              C.x gamma (params gamma)).prod := by
                simp [highWord, FilteredCollection.wordProduct, List.map_map,
                  Function.comp_def]
        _ = C.x alpha t := hparams.symm
    have hhighNodup : (highWord.map Prod.fst).Nodup := by
      dsimp [highWord]
      simpa [List.map_map, Function.comp_def] using
        rootAtLeastList_nodup P e positiveBase (i + 1)
    have hparamsZero : ∀ gamma ∈ rootAtLeastList P e positiveBase (i + 1),
        params gamma = 0 := by
      by_contra hnotAllZero
      push Not at hnotAllZero
      let support : Finset D.Root := Finset.univ.filter fun gamma =>
        gamma ∈ rootAtLeastList P e positiveBase (i + 1) ∧ params gamma ≠ 0
      have hsupportNonempty : support.Nonempty := by
        obtain ⟨gamma, hgammaList, hgamma⟩ := hnotAllZero
        exact ⟨gamma, by simp [support, hgammaList, hgamma]⟩
      let heights : Finset Nat := support.image fun gamma =>
        (positiveHeight P e positiveBase gamma).toNat
      have hheightsNonempty : heights.Nonempty := hsupportNonempty.image _
      let j : Nat := heights.min' hheightsNonempty
      have hjMem : j ∈ heights := Finset.min'_mem heights hheightsNonempty
      obtain ⟨beta, hbetaSupport, hbetaDegree⟩ := Finset.mem_image.mp hjMem
      have hbetaList : beta ∈ rootAtLeastList P e positiveBase (i + 1) := by
        have hbetaSupport' :
            beta ∈ rootAtLeastList P e positiveBase (i + 1) ∧ params beta ≠ 0 := by
          simpa [support] using hbetaSupport
        exact hbetaSupport'.1
      have hbetaParam : params beta ≠ 0 := by
        have hbetaSupport' :
            beta ∈ rootAtLeastList P e positiveBase (i + 1) ∧ params beta ≠ 0 := by
          simpa [support] using hbetaSupport
        exact hbetaSupport'.2
      have hbetaLower := (mem_rootAtLeastList_iff P e positiveBase (i + 1) beta).1
        hbetaList
      have hbetaPos : 0 < positiveHeight P e positiveBase beta := by
        exact lt_of_lt_of_le (by exact_mod_cast (show 0 < i + 1 by omega)) hbetaLower
      have hbetaHeight : positiveHeight P e positiveBase beta = j := by
        calc
          positiveHeight P e positiveBase beta =
              ((positiveHeight P e positiveBase beta).toNat : Int) :=
            (Int.toNat_of_nonneg (le_of_lt hbetaPos)).symm
          _ = (j : Int) := by exact_mod_cast hbetaDegree
      have hij : i < j := by
        rw [hbetaHeight] at hbetaLower
        omega
      have hj : 0 < j := lt_trans hi hij
      have hjMax : j ≤ maxPositiveHeight P e positiveBase := by
        have hle := positiveHeight_toNat_le_max P e positiveBase beta
        rw [hbetaHeight, Int.toNat_natCast] at hle
        exact hle
      have hzeroBelow : ∀ q ∈ highWord,
          positiveHeight P e positiveBase q.1 < j → q.2 = 0 := by
        intro q hq hqBelow
        rw [List.mem_map] at hq
        obtain ⟨gamma, hgammaList, rfl⟩ := hq
        by_contra hgammaParam
        have hgammaSupport : gamma ∈ support := by
          simp [support, hgammaList, hgammaParam]
        have hgammaLower :=
          (mem_rootAtLeastList_iff P e positiveBase (i + 1) gamma).1 hgammaList
        have hgammaHeightPos : 0 < positiveHeight P e positiveBase gamma := by
          exact lt_of_lt_of_le (by exact_mod_cast (show 0 < i + 1 by omega)) hgammaLower
        have hmin : j ≤ (positiveHeight P e positiveBase gamma).toNat := by
          apply Finset.min'_le heights
          exact Finset.mem_image_of_mem _ hgammaSupport
        have hminCast : (j : Int) ≤
            ((positiveHeight P e positiveBase gamma).toNat : Int) := by
          exact_mod_cast hmin
        rw [Int.toNat_of_nonneg (le_of_lt hgammaHeightPos)] at hminCast
        exact (not_lt_of_ge hminCast hqBelow).elim
      have hrootNe : alpha ≠ beta := by
        intro heq
        subst beta
        rw [halpha] at hbetaHeight
        omega
      have halphaPos : 0 < positiveHeight P e positiveBase alpha := by
        rw [halpha]
        exact_mod_cast hi
      obtain ⟨u, v, hfix, hmove⟩ := exists_pairingSeparator
        P e systemBase positiveBase C S alpha beta halphaPos hbetaPos hrootNe
      have hscaledProduct :
          FilteredCollection.wordProduct C.x
              (highWord.map fun q =>
                (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)) =
            FilteredCollection.wordProduct C.x highWord := by
        calc
          FilteredCollection.wordProduct C.x
              (highWord.map fun q =>
                (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)) =
              (C.h beta u * C.h alpha v)⁻¹ *
                FilteredCollection.wordProduct C.x highWord *
                  (C.h beta u * C.h alpha v) :=
            (corootPair_conjugates_word P e systemBase positiveBase C S
              alpha beta u v highWord).symm
          _ = (C.h beta u * C.h alpha v)⁻¹ *
                C.x alpha t * (C.h beta u * C.h alpha v) := by
            rw [hhighProduct]
          _ = C.x alpha (corootPairScale (D := D) alpha beta alpha u v * t) :=
            corootPair_conjugates_root P e systemBase positiveBase C S
              alpha beta alpha u v t
          _ = C.x alpha t := by rw [hfix, one_mul]
          _ = FilteredCollection.wordProduct C.x highWord := hhighProduct.symm
      let exactDifferenceWord : List (D.Root × k) :=
        ((highWord.filter fun q => positiveHeight P e positiveBase q.1 = j).map fun q =>
          (q.1, (corootPairScale (D := D) alpha beta q.1 u v - 1) * q.2))
      have hexactDifferenceMem :
          FilteredCollection.wordProduct C.x exactDifferenceWord ∈
            positiveLayer P e positiveBase (j + 1) := by
        exact minimalHeight_difference_mem_next P e systemBase positiveBase C S
          j hj highWord hzeroBelow alpha beta u v hscaledProduct
      have hfilteredNodup :
          ((highWord.filter fun q => positiveHeight P e positiveBase q.1 = j).map
            Prod.fst).Nodup := by
        have hpairNodup : highWord.Nodup := List.Nodup.of_map Prod.fst hhighNodup
        apply (hpairNodup.filter _).map_on
        intro q hq r hr hroot
        apply pair_eq_of_mem_of_root_eq highWord hhighNodup
        · exact List.mem_of_mem_filter hq
        · exact List.mem_of_mem_filter hr
        · exact hroot
      have hexactDifferenceNodup :
          (exactDifferenceWord.map Prod.fst).Nodup := by
        simpa [exactDifferenceWord, List.map_map, Function.comp_def] using
          hfilteredNodup
      have hexactDifferenceHeight : ∀ q ∈ exactDifferenceWord,
          positiveHeight P e positiveBase q.1 = j := by
        intro q hq
        rw [List.mem_map] at hq
        obtain ⟨r, hr, rfl⟩ := hq
        exact of_decide_eq_true (List.mem_filter.mp hr).2
      have hrecursive := exactHeight_parameters_eq_zero_of_wordProduct_mem_next
        S j hj exactDifferenceWord hexactDifferenceNodup
          hexactDifferenceHeight hexactDifferenceMem
      have hbetaHigh : (beta, params beta) ∈ highWord :=
        List.mem_map.mpr ⟨beta, hbetaList, rfl⟩
      have hbetaFiltered : (beta, params beta) ∈
          highWord.filter fun q => positiveHeight P e positiveBase q.1 = j :=
        List.mem_filter.mpr ⟨hbetaHigh, by simp [hbetaHeight]⟩
      have hbetaDifference :
          (beta, (corootPairScale (D := D) alpha beta beta u v - 1) *
            params beta) ∈ exactDifferenceWord :=
        List.mem_map.mpr ⟨(beta, params beta), hbetaFiltered, rfl⟩
      have hbetaDifferenceZero := hrecursive _ hbetaDifference
      exact (mul_ne_zero (sub_ne_zero.mpr hmove) hbetaParam) hbetaDifferenceZero
    have hhighOne := chevalleyWord_eq_one_of_params_eq_zero
      P e systemBase positiveBase C S highWord (by
        intro q hq
        rw [List.mem_map] at hq
        obtain ⟨gamma, hgamma, rfl⟩ := hq
        exact hparamsZero gamma hgamma)
    have hxOne : C.x alpha t = 1 := by rw [← hhighProduct, hhighOne]
    have hxZero : C.x alpha 0 = 1 := chevalleyRoot_zero
      P e systemBase positiveBase C S alpha
    exact (S.chevalley.1 alpha).1 (hxOne.trans hxZero.symm)
  exact exactWord_parameters_eq_zero_of_singleRoot
    P e systemBase positiveBase C S i hi hsingle word hnodup hexact hmem
termination_by maxPositiveHeight P e positiveBase + 1 - i
decreasing_by
  exact Nat.sub_lt_sub_left (by omega) hij

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma positiveLayer_one_le_normalizer
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) :
    positiveLayer P e positiveBase 1 ≤
      Subgroup.normalizer
        (positiveLayer P e positiveBase (i + 1) : Set (Variety.Point K)) := by
  classical
  let next := positiveLayer P e positiveBase (i + 1)
  have hrootConj : ∀ {alpha : D.Root} (x : Variety.Point K),
      (1 : Int) ≤ positiveHeight P e positiveBase alpha →
      x ∈ D.rootSubgroup alpha →
      ∀ z ∈ next, x * z * x⁻¹ ∈ next := by
    intro alpha x halpha hx z hz
    change z ∈ positiveLayer P e positiveBase (i + 1) at hz
    rw [positiveLayer, RootSubgroupGenerated] at hz
    refine Subgroup.closure_induction
      (p := fun z _ => x * z * x⁻¹ ∈ next)
      (k := ⋃ beta ∈ {beta |
        (i + 1 : Nat) ≤ positiveHeight P e positiveBase beta},
        (D.rootSubgroup beta : Set (Variety.Point K))) ?_ ?_ ?_ ?_ hz
    · intro y hy
      simp only [Set.mem_iUnion, Set.mem_ofPred_eq] at hy
      obtain ⟨beta, hbeta, hy⟩ := hy
      have hcomm : ⁅x, y⁆ ∈ next := by
        have hdeep := rootFactor_commutator_mem_layer
          P e systemBase positiveBase C S 1 (i + 1) (by omega) (by omega)
            halpha hbeta hx hy
        exact positiveLayer_antitone P e positiveBase (by omega) hdeep
      have hyNext : y ∈ next := by
        apply rootSubgroup_le_RootSubgroupGenerated D hbeta
        exact hy
      change (MulAut.conj x) y ∈ next
      rw [conj_eq_commutatorElement_mul]
      exact next.mul_mem hcomm hyNext
    · simp
    · intro z w hz hw ihz ihw
      simpa [mul_assoc] using next.mul_mem ihz ihw
    · intro z hz ihz
      simpa [mul_assoc] using next.inv_mem ihz
  intro x hx
  rw [positiveLayer, RootSubgroupGenerated] at hx
  refine Subgroup.closure_induction
    (p := fun x _ => x ∈ Subgroup.normalizer (next : Set (Variety.Point K)))
    (k := ⋃ alpha ∈ {alpha |
      (1 : Int) ≤ positiveHeight P e positiveBase alpha},
      (D.rootSubgroup alpha : Set (Variety.Point K))) ?_ ?_ ?_ ?_ hx
  · intro x hx
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq] at hx
    obtain ⟨alpha, halpha, hx⟩ := hx
    rw [Subgroup.mem_normalizer_iff]
    intro z
    constructor
    · exact hrootConj x halpha hx z
    · intro hz
      have hxinv : x⁻¹ ∈ D.rootSubgroup alpha := (D.rootSubgroup alpha).inv_mem hx
      simpa [mul_assoc] using hrootConj x⁻¹ halpha hxinv (x * z * x⁻¹) hz
  · exact (Subgroup.normalizer (next : Set (Variety.Point K))).one_mem
  · intro x y hx hy ihx ihy
    exact (Subgroup.normalizer (next : Set (Variety.Point K))).mul_mem ihx ihy
  · intro x hx ihx
    exact (Subgroup.normalizer (next : Set (Variety.Point K))).inv_mem ihx

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma positiveLayer_next_normal_in_one
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) :
    ((positiveLayer P e positiveBase (i + 1)).subgroupOf
      (positiveLayer P e positiveBase 1)).Normal := by
  exact Subgroup.normal_subgroupOf_of_le_normalizer
    (positiveLayer_one_le_normalizer P e systemBase positiveBase C S i hi)

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma exactRoot_commutator_layer_one_mem_next
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) (alpha : D.Root) (t : k)
    (halpha : positiveHeight P e positiveBase alpha = i)
    (y : Variety.Point K) (hy : y ∈ positiveLayer P e positiveBase 1) :
    ⁅C.x alpha t, y⁆ ∈ positiveLayer P e positiveBase (i + 1) := by
  classical
  let next := positiveLayer P e positiveBase (i + 1)
  have hnorm := positiveLayer_one_le_normalizer
    P e systemBase positiveBase C S i hi
  have hxRoot : C.x alpha t ∈ D.rootSubgroup alpha := by
    change C.x alpha t ∈ (D.rootSubgroup alpha : Set (Variety.Point K))
    rw [← (S.chevalley.1 alpha).2]
    exact Set.mem_range_self t
  rw [positiveLayer, RootSubgroupGenerated] at hy
  refine Subgroup.closure_induction
    (p := fun y _ => ⁅C.x alpha t, y⁆ ∈ next)
    (k := ⋃ beta ∈ {beta |
      (1 : Int) ≤ positiveHeight P e positiveBase beta},
      (D.rootSubgroup beta : Set (Variety.Point K))) ?_ ?_ ?_ ?_ hy
  · intro z hz
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq] at hz
    obtain ⟨beta, hbeta, hz⟩ := hz
    have hdeep := rootFactor_commutator_mem_layer
      P e systemBase positiveBase C S i 1 hi (by omega)
        (by rw [halpha]) hbeta hxRoot hz
    simpa [add_comm] using hdeep
  · simp
  · intro y z hy hz ihy ihz
    have hyNorm := hnorm hy
    have hyConj : y * ⁅C.x alpha t, z⁆ * y⁻¹ ∈ next :=
      (Subgroup.mem_normalizer_iff.mp hyNorm ⁅C.x alpha t, z⁆).mp ihz
    rw [commutatorElement_mul_right_eq_mul_conj]
    simpa [mul_assoc] using next.mul_mem ihy hyConj
  · intro y hy ihy
    have hyNorm := hnorm hy
    have hyInvNorm := (Subgroup.normalizer (next : Set (Variety.Point K))).inv_mem hyNorm
    have hyx : ⁅y, C.x alpha t⁆ ∈ next := by
      simpa [commutatorElement_inv] using next.inv_mem ihy
    have hconj : y⁻¹ * ⁅y, C.x alpha t⁆ * y⁻¹⁻¹ ∈ next :=
      (Subgroup.mem_normalizer_iff.mp hyInvNorm ⁅y, C.x alpha t⁆).mp hyx
    simpa [commutatorElement_def, mul_assoc] using hconj

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma positiveWordProduct_mem_layer_one
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (word : List (D.Root × k))
    (hpositive : ∀ q ∈ word, 0 < positiveHeight P e positiveBase q.1) :
    FilteredCollection.wordProduct C.x word ∈ positiveLayer P e positiveBase 1 := by
  apply Subgroup.list_prod_mem
  intro x hx
  rw [List.mem_map] at hx
  obtain ⟨q, hq, rfl⟩ := hx
  exact positiveRoot_mem_layer P e systemBase positiveBase C 1 q.1 q.2 S (by
    have := hpositive q hq
    omega)

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma exactRoot_commutes_in_one_quotient
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i)
    (hN : ((positiveLayer P e positiveBase (i + 1)).subgroupOf
      (positiveLayer P e positiveBase 1)).Normal)
    (alpha : D.Root) (t : k)
    (halpha : positiveHeight P e positiveBase alpha = i)
    (y : positiveLayer P e positiveBase 1) :
    Commute
      (QuotientGroup.mk'
        ((positiveLayer P e positiveBase (i + 1)).subgroupOf
          (positiveLayer P e positiveBase 1))
        ⟨C.x alpha t, positiveRoot_mem_layer
          P e systemBase positiveBase C 1 alpha t S (by rw [halpha]; omega)⟩)
      (QuotientGroup.mk'
        ((positiveLayer P e positiveBase (i + 1)).subgroupOf
          (positiveLayer P e positiveBase 1)) y) := by
  let _ := hN
  apply commutatorElement_eq_one_iff_commute.mp
  rw [← map_commutatorElement]
  exact (QuotientGroup.eq_one_iff
    (⟨⁅C.x alpha t, y.1⁆, by
      simp only [commutatorElement_def]
      exact (positiveLayer P e positiveBase 1).mul_mem
        ((positiveLayer P e positiveBase 1).mul_mem
          ((positiveLayer P e positiveBase 1).mul_mem
            (positiveRoot_mem_layer P e systemBase positiveBase C 1 alpha t S (by
              rw [halpha]
              omega)) y.2)
          ((positiveLayer P e positiveBase 1).inv_mem
            (positiveRoot_mem_layer P e systemBase positiveBase C 1 alpha t S (by
            rw [halpha]
            omega)))) ((positiveLayer P e positiveBase 1).inv_mem y.2)⟩ :
              positiveLayer P e positiveBase 1)).2
    (exactRoot_commutator_layer_one_mem_next
      P e systemBase positiveBase C S i hi alpha t halpha y.1 y.2)

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma word_quotient_eq_lower_mul_exact
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i)
    (hN : ((positiveLayer P e positiveBase (i + 1)).subgroupOf
      (positiveLayer P e positiveBase 1)).Normal)
    (word : List (D.Root × k))
    (hpositive : ∀ q ∈ word, 0 < positiveHeight P e positiveBase q.1) :
    QuotientGroup.mk'
        ((positiveLayer P e positiveBase (i + 1)).subgroupOf
          (positiveLayer P e positiveBase 1))
        ⟨FilteredCollection.wordProduct C.x word,
          positiveWordProduct_mem_layer_one P e systemBase positiveBase C S word
            hpositive⟩ =
      QuotientGroup.mk'
          ((positiveLayer P e positiveBase (i + 1)).subgroupOf
            (positiveLayer P e positiveBase 1))
          ⟨FilteredCollection.wordProduct C.x
              (word.filter fun q => positiveHeight P e positiveBase q.1 < i),
            positiveWordProduct_mem_layer_one P e systemBase positiveBase C S _ (by
              intro q hq
              exact hpositive q (List.mem_of_mem_filter hq))⟩ *
        QuotientGroup.mk'
          ((positiveLayer P e positiveBase (i + 1)).subgroupOf
            (positiveLayer P e positiveBase 1))
          ⟨FilteredCollection.wordProduct C.x
              (word.filter fun q => positiveHeight P e positiveBase q.1 = i),
            positiveWordProduct_mem_layer_one P e systemBase positiveBase C S _ (by
              intro q hq
              exact hpositive q (List.mem_of_mem_filter hq))⟩ := by
  classical
  let L := positiveLayer P e positiveBase 1
  let Nsub := (positiveLayer P e positiveBase (i + 1)).subgroupOf L
  let Q := L ⧸ Nsub
  let _ := hN
  induction word with
  | nil =>
      change (1 : Q) = 1 * 1
      simp
  | cons q tail ih =>
      have hqPositive := hpositive q (by simp)
      have htailPositive : ∀ r ∈ tail,
          0 < positiveHeight P e positiveBase r.1 := by
        intro r hr
        exact hpositive r (by simp [hr])
      have ih' := ih htailPositive
      let qPoint : L := ⟨C.x q.1 q.2,
        positiveRoot_mem_layer P e systemBase positiveBase C 1 q.1 q.2 S (by
          have := hqPositive
          omega)⟩
      let tailPoint : L := ⟨FilteredCollection.wordProduct C.x tail,
        positiveWordProduct_mem_layer_one P e systemBase positiveBase C S tail
          htailPositive⟩
      let lowerPoint : L :=
        ⟨FilteredCollection.wordProduct C.x
            (tail.filter fun r => positiveHeight P e positiveBase r.1 < i),
          positiveWordProduct_mem_layer_one P e systemBase positiveBase C S _ (by
            intro r hr
            exact htailPositive r (List.mem_of_mem_filter hr))⟩
      let exactPoint : L :=
        ⟨FilteredCollection.wordProduct C.x
            (tail.filter fun r => positiveHeight P e positiveBase r.1 = i),
          positiveWordProduct_mem_layer_one P e systemBase positiveBase C S _ (by
            intro r hr
            exact htailPositive r (List.mem_of_mem_filter hr))⟩
      change QuotientGroup.mk' Nsub tailPoint =
        QuotientGroup.mk' Nsub lowerPoint * QuotientGroup.mk' Nsub exactPoint at ih'
      by_cases hqBelow : positiveHeight P e positiveBase q.1 < i
      · have hqNotExact : positiveHeight P e positiveBase q.1 ≠ i := by omega
        simp only [List.filter_cons, decide_eq_true_eq, hqBelow, hqNotExact,
          if_true, if_false]
        change QuotientGroup.mk' Nsub (qPoint * tailPoint) =
          QuotientGroup.mk' Nsub (qPoint * lowerPoint) *
            QuotientGroup.mk' Nsub exactPoint
        rw [map_mul, map_mul, ih']
        group
      · by_cases hqExact : positiveHeight P e positiveBase q.1 = i
        · have hcomm : Commute (QuotientGroup.mk' Nsub qPoint)
              (QuotientGroup.mk' Nsub lowerPoint) := exactRoot_commutes_in_one_quotient
            P e systemBase positiveBase C S i hi hN q.1 q.2 hqExact
              lowerPoint
          simp only [List.filter_cons, decide_eq_true_eq, hqExact,
            lt_self_iff_false, if_true, if_false]
          change QuotientGroup.mk' Nsub (qPoint * tailPoint) =
            QuotientGroup.mk' Nsub lowerPoint *
              QuotientGroup.mk' Nsub (qPoint * exactPoint)
          rw [map_mul, map_mul, ih']
          rw [← mul_assoc, hcomm.eq, mul_assoc]
        · have hqAbove : (i + 1 : Int) ≤ positiveHeight P e positiveBase q.1 := by
            omega
          have hqOne : QuotientGroup.mk' Nsub qPoint = 1 := by
            exact (QuotientGroup.eq_one_iff _).2
              (positiveRoot_mem_layer P e systemBase positiveBase C (i + 1)
                q.1 q.2 S hqAbove)
          simp only [List.filter_cons, decide_eq_true_eq, hqBelow, hqExact, if_false]
          change QuotientGroup.mk' Nsub (qPoint * tailPoint) =
            QuotientGroup.mk' Nsub lowerPoint * QuotientGroup.mk' Nsub exactPoint
          rw [map_mul, hqOne, one_mul, ih']

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma pairedWord_exact_difference_mem_next
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) (word : List (D.Root × (k × k)))
    (hpositive : ∀ q ∈ word, 0 < positiveHeight P e positiveBase q.1)
    (hbelow : ∀ q ∈ word, positiveHeight P e positiveBase q.1 < i →
      q.2.1 = q.2.2)
    (hfull :
      FilteredCollection.wordProduct C.x (word.map fun q => (q.1, q.2.1)) =
        FilteredCollection.wordProduct C.x (word.map fun q => (q.1, q.2.2))) :
    FilteredCollection.wordProduct C.x
        ((word.filter fun q => positiveHeight P e positiveBase q.1 = i).map fun q =>
          (q.1, q.2.1 - q.2.2)) ∈
      positiveLayer P e positiveBase (i + 1) := by
  classical
  let leftWord := word.map fun q => (q.1, q.2.1)
  let rightWord := word.map fun q => (q.1, q.2.2)
  let lowerPairs := word.filter fun q => positiveHeight P e positiveBase q.1 < i
  let exactPairs := word.filter fun q => positiveHeight P e positiveBase q.1 = i
  let hN := positiveLayer_next_normal_in_one P e systemBase positiveBase C S i hi
  let _ := hN
  let L := positiveLayer P e positiveBase 1
  let Nsub := (positiveLayer P e positiveBase (i + 1)).subgroupOf L
  have hleftPositive : ∀ q ∈ leftWord,
      0 < positiveHeight P e positiveBase q.1 := by
    intro q hq
    rw [List.mem_map] at hq
    obtain ⟨r, hr, rfl⟩ := hq
    exact hpositive r hr
  have hrightPositive : ∀ q ∈ rightWord,
      0 < positiveHeight P e positiveBase q.1 := by
    intro q hq
    rw [List.mem_map] at hq
    obtain ⟨r, hr, rfl⟩ := hq
    exact hpositive r hr
  have hleftLower :
      leftWord.filter (fun q => positiveHeight P e positiveBase q.1 < i) =
        lowerPairs.map fun q => (q.1, q.2.1) := by
    dsimp [leftWord, lowerPairs]
    rw [List.filter_map]
    rfl
  have hrightLower :
      rightWord.filter (fun q => positiveHeight P e positiveBase q.1 < i) =
        lowerPairs.map fun q => (q.1, q.2.2) := by
    dsimp [rightWord, lowerPairs]
    rw [List.filter_map]
    rfl
  have hleftExact :
      leftWord.filter (fun q => positiveHeight P e positiveBase q.1 = i) =
        exactPairs.map fun q => (q.1, q.2.1) := by
    dsimp [leftWord, exactPairs]
    rw [List.filter_map]
    rfl
  have hrightExact :
      rightWord.filter (fun q => positiveHeight P e positiveBase q.1 = i) =
        exactPairs.map fun q => (q.1, q.2.2) := by
    dsimp [rightWord, exactPairs]
    rw [List.filter_map]
    rfl
  have hlowerWords :
      lowerPairs.map (fun q => (q.1, q.2.1)) =
        lowerPairs.map fun q => (q.1, q.2.2) := by
    apply List.map_congr_left
    intro q hq
    congr 1
    apply hbelow q (List.mem_of_mem_filter hq)
    exact of_decide_eq_true (List.mem_filter.mp hq).2
  have hleftDecomp := word_quotient_eq_lower_mul_exact
    P e systemBase positiveBase C S i hi hN leftWord hleftPositive
  have hrightDecomp := word_quotient_eq_lower_mul_exact
    P e systemBase positiveBase C S i hi hN rightWord hrightPositive
  simp only [hleftLower, hleftExact] at hleftDecomp
  simp only [hrightLower, hrightExact] at hrightDecomp
  have hfullQ :
      QuotientGroup.mk' Nsub
          ⟨FilteredCollection.wordProduct C.x leftWord,
            positiveWordProduct_mem_layer_one P e systemBase positiveBase C S
              leftWord hleftPositive⟩ =
        QuotientGroup.mk' Nsub
          ⟨FilteredCollection.wordProduct C.x rightWord,
            positiveWordProduct_mem_layer_one P e systemBase positiveBase C S
              rightWord hrightPositive⟩ := by
    apply congrArg (QuotientGroup.mk' Nsub)
    apply Subtype.ext
    exact hfull
  rw [hleftDecomp, hrightDecomp] at hfullQ
  have hlowerQ :
      QuotientGroup.mk' Nsub
          ⟨FilteredCollection.wordProduct C.x
              (lowerPairs.map fun q => (q.1, q.2.1)),
            positiveWordProduct_mem_layer_one P e systemBase positiveBase C S _ (by
              intro q hq
              rw [List.mem_map] at hq
              obtain ⟨r, hr, rfl⟩ := hq
              exact hpositive r (List.mem_of_mem_filter hr))⟩ =
        QuotientGroup.mk' Nsub
          ⟨FilteredCollection.wordProduct C.x
              (lowerPairs.map fun q => (q.1, q.2.2)),
            positiveWordProduct_mem_layer_one P e systemBase positiveBase C S _ (by
              intro q hq
              rw [List.mem_map] at hq
              obtain ⟨r, hr, rfl⟩ := hq
              exact hpositive r (List.mem_of_mem_filter hr))⟩ := by
    apply congrArg (QuotientGroup.mk' Nsub)
    apply Subtype.ext
    exact congrArg (FilteredCollection.wordProduct C.x) hlowerWords
  rw [hlowerQ] at hfullQ
  have hexactQ := mul_left_cancel hfullQ
  have hexactPositive : ∀ q ∈ exactPairs,
      0 < positiveHeight P e positiveBase q.1 := by
    intro q hq
    exact hpositive q (List.mem_of_mem_filter hq)
  have hrelation :
      FilteredCollection.wordProduct C.x
          (exactPairs.map fun q => (q.1, q.2.1)) *
        (FilteredCollection.wordProduct C.x
          (exactPairs.map fun q => (q.1, q.2.2)))⁻¹ ∈
          positiveLayer P e positiveBase (i + 1) := by
    let leftExact : L :=
      ⟨FilteredCollection.wordProduct C.x
          (exactPairs.map fun q => (q.1, q.2.1)),
        positiveWordProduct_mem_layer_one P e systemBase positiveBase C S _ (by
          intro q hq
          rw [List.mem_map] at hq
          obtain ⟨r, hr, rfl⟩ := hq
          exact hexactPositive r hr)⟩
    let rightExact : L :=
      ⟨FilteredCollection.wordProduct C.x
          (exactPairs.map fun q => (q.1, q.2.2)),
        positiveWordProduct_mem_layer_one P e systemBase positiveBase C S _ (by
          intro q hq
          rw [List.mem_map] at hq
          obtain ⟨r, hr, rfl⟩ := hq
          exact hexactPositive r hr)⟩
    change QuotientGroup.mk' Nsub leftExact = QuotientGroup.mk' Nsub rightExact at hexactQ
    have hOne : QuotientGroup.mk' Nsub (leftExact * rightExact⁻¹) = 1 := by
      rw [map_mul, map_inv, hexactQ, mul_inv_cancel]
    exact (QuotientGroup.eq_one_iff (leftExact * rightExact⁻¹)).1 hOne
  apply exactPair_difference_mem_next
    P e systemBase positiveBase C S i hi exactPairs
  · intro q hq
    exact of_decide_eq_true (List.mem_filter.mp hq).2
  · exact hrelation

/-- Ordered multiplication of the positive Chevalley root groups has unique
coordinates, even when the Chevalley system and positivity bases differ. -/
public theorem positiveRootOrderedProduct_injective_of_separateBase
    (hPositive : IsPositiveSystem D positiveRoots)
    (hpositive : ∀ alpha, alpha ∈ positiveRoots ↔ positiveBase.IsPos (e alpha))
    (hAdd : IsRootAdditionRealization D P e)
    (hActual : IsRootSystemRealization D P e systemBase)
    (hC : IsChevalleySystem D C P e systemBase)
    (order : List D.Root) (horder : EnumeratesRootSet positiveRoots order) :
    Function.Injective (orderedChevalleyProduct C order) := by
  classical
  let S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots) :=
    ⟨hC, hAdd, hPositive, hpositive, hActual⟩
  intro left right hproduct
  let word : List (D.Root × (k × k)) :=
    List.ofFn fun idx => (order.get idx, (left idx, right idx))
  have hwordPositive : ∀ q ∈ word,
      0 < positiveHeight P e positiveBase q.1 := by
    intro q hq
    obtain ⟨idx, rfl⟩ := List.mem_ofFn.mp hq
    apply (S.positive (order.get idx)).mp
    exact (horder.2 (order.get idx)).mp (List.get_mem order idx)
  have hwordRoots : word.map Prod.fst = order := by
    dsimp [word]
    rw [List.map_ofFn]
    change List.ofFn order.get = order
    exact List.ofFn_get order
  have hwordRootsNodup : (word.map Prod.fst).Nodup := by
    rw [hwordRoots]
    exact horder.1
  have hfull :
      FilteredCollection.wordProduct C.x (word.map fun q => (q.1, q.2.1)) =
        FilteredCollection.wordProduct C.x (word.map fun q => (q.1, q.2.2)) := by
    simpa [word, orderedChevalleyProduct, FilteredCollection.wordProduct,
      List.map_map, Function.comp_def, List.map_ofFn] using hproduct
  have hcoordinate : ∀ n : Nat, ∀ idx : Fin order.length,
      (positiveHeight P e positiveBase (order.get idx)).toNat = n →
        left idx = right idx := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro idx hidxHeight
        have hidxWord : (order.get idx, (left idx, right idx)) ∈ word :=
          List.mem_ofFn.mpr ⟨idx, rfl⟩
        have hidxPositive : 0 < positiveHeight P e positiveBase (order.get idx) := by
          simpa using hwordPositive _ hidxWord
        have hn : 0 < n := by omega
        have hidxExact : positiveHeight P e positiveBase (order.get idx) = (n : Int) := by
          omega
        have hbelow : ∀ q ∈ word,
            positiveHeight P e positiveBase q.1 < n → q.2.1 = q.2.2 := by
          intro q hq hqBelow
          obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hq
          have hjPositive : 0 < positiveHeight P e positiveBase (order.get j) := by
            simpa using hwordPositive _ (List.mem_ofFn.mpr ⟨j, rfl⟩)
          have hjBelow : positiveHeight P e positiveBase (order.get j) < (n : Int) := by
            simpa using hqBelow
          have hjLower :
              (positiveHeight P e positiveBase (order.get j)).toNat < n := by
            omega
          exact ih _ hjLower j rfl
        let exactPairs :=
          word.filter fun q => positiveHeight P e positiveBase q.1 = n
        let differenceWord : List (D.Root × k) :=
          exactPairs.map fun q => (q.1, q.2.1 - q.2.2)
        have hexactPairs : ∀ q ∈ exactPairs,
            positiveHeight P e positiveBase q.1 = n := by
          intro q hq
          exact of_decide_eq_true (List.mem_filter.mp hq).2
        have hexactRootsNodup : (exactPairs.map Prod.fst).Nodup := by
          apply List.Nodup.sublist
          · exact (List.filter_sublist (p := fun q =>
              decide (positiveHeight P e positiveBase q.1 = (n : Int)))
                (l := word)).map Prod.fst
          · exact hwordRootsNodup
        have hdifferenceNodup : (differenceWord.map Prod.fst).Nodup := by
          dsimp [differenceWord]
          simpa [List.map_map, Function.comp_def] using hexactRootsNodup
        have hdifferenceExact : ∀ q ∈ differenceWord,
            positiveHeight P e positiveBase q.1 = n := by
          intro q hq
          dsimp [differenceWord] at hq
          rw [List.mem_map] at hq
          obtain ⟨r, hr, rfl⟩ := hq
          exact hexactPairs r hr
        have hdifferenceMem : FilteredCollection.wordProduct C.x differenceWord ∈
            positiveLayer P e positiveBase (n + 1) := by
          exact pairedWord_exact_difference_mem_next
            P e systemBase positiveBase C S n hn word hwordPositive hbelow hfull
        have hallZero := exactHeight_parameters_eq_zero_of_wordProduct_mem_next
          P e systemBase positiveBase C S n hn differenceWord hdifferenceNodup
            hdifferenceExact hdifferenceMem
        have hidxExactPair : (order.get idx, (left idx, right idx)) ∈ exactPairs := by
          apply List.mem_filter.mpr
          exact ⟨hidxWord, by simpa using hidxExact⟩
        have hidxDifference : (order.get idx, left idx - right idx) ∈ differenceWord := by
          apply List.mem_map.mpr
          exact ⟨(order.get idx, (left idx, right idx)), hidxExactPair, rfl⟩
        exact sub_eq_zero.mp (hallZero _ hidxDifference)
  funext idx
  exact hcoordinate _ idx rfl

end

end Theory.AlgebraicGroup
