module

public import Theory.AlgebraicGroup.RootData.PositiveRootCollection
public import Theory.AlgebraicGroup.Borel.RootStructure.FundamentalCorootData
public import Theory.AlgebraicGroup.RootData.RelativeRootSeries.Quotient
public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup
public import Theory.AlgebraicGroup.Tori.Basic

/-!
This module proves uniqueness of positive-root coordinates for a Chevalley
system when the root-system base used by the system is separate from the base
that defines positivity.  Its single public result applies to every duplicate-
free ordering of the chosen positive roots.

The proof filters the subgroup generated by positive root groups by integral
height.  Exact root addition and the Chevalley commutator formula make successive
layers normal with commutative quotients.  Conjugation by two root cocharacters,
together with the realized Cartan pairing, separates one exact-height root from
all the others; this forces every parameter in a word lying in the next layer
to vanish.  Finally, arbitrary ordered products are compared with their lower-
and exact-height parts in the layer-one quotient, and strong induction on height
recovers all coordinates.  This is the uniqueness half of the positive-root
factorization used in GLS3, Theorem 1.12.7.
-/

universe u v w x y

open scoped BigOperators commutatorElement

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

section

variable {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
variable {D : RootGroupData K T} [Fintype D.Root]
variable {ι : Type v} {R : Type w} {M : Type x} {N : Type y} [Finite ι] [Field R] [CharZero R]
variable [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
variable (P : RootPairing ι R M N) [P.IsRootSystem]
variable [P.IsCrystallographic] [P.IsReduced]
variable (e : D.Root ≃ ι) (systemBase positiveBase : P.Base)
variable (C : ChevalleyData K D)
variable {positiveRoots : Set D.Root}

private structure PositiveCoordinateSetup where
  chevalley : IsChevalleySystem D C P e systemBase
  rootAddition : IsRootAdditionRealization D P e
  positiveSystem : IsPositiveSystem D positiveRoots
  positive : ∀ alpha, alpha ∈ positiveRoots ↔ positiveBase.IsPos (e alpha)
  actual : IsRootSystemRealization D P e systemBase

private noncomputable def positiveHeight (alpha : D.Root) : Int :=
  positiveBase.height (e alpha)

private noncomputable def positiveLayer (n : Nat) : Subgroup (Variety.Point K) :=
  RootSubgroupGenerated D {alpha | (n : Int) ≤ positiveHeight P e positiveBase alpha}

omit [IsAlgClosed k] [Fintype D.Root] [Finite ι] [P.IsRootSystem]
  [P.IsCrystallographic] [P.IsReduced] in
private lemma positiveLayer_succ_le (n : Nat) :
    positiveLayer P e positiveBase (n + 1) ≤ positiveLayer P e positiveBase n := by
  apply RootSubgroupGenerated_mono D
  intro alpha halpha
  change ((n + 1 : Nat) : Int) ≤ positiveHeight P e positiveBase alpha at halpha
  change (n : Int) ≤ positiveHeight P e positiveBase alpha
  omega

omit [IsAlgClosed k] [Fintype D.Root] [Finite ι] [P.IsRootSystem]
  [P.IsCrystallographic] [P.IsReduced] in
private lemma positiveLayer_antitone {i j : Nat} (hij : i ≤ j) :
    positiveLayer P e positiveBase j ≤ positiveLayer P e positiveBase i := by
  apply RootSubgroupGenerated_mono D
  intro alpha halpha
  change (j : Int) ≤ positiveHeight P e positiveBase alpha at halpha
  change (i : Int) ≤ positiveHeight P e positiveBase alpha
  have hij' : (i : Int) ≤ (j : Int) := by exact_mod_cast hij
  exact hij'.trans halpha

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma positiveRoot_mem_layer (n : Nat) (alpha : D.Root) (t : k)
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (halpha : (n : Int) ≤ positiveHeight P e positiveBase alpha) :
    C.x alpha t ∈ positiveLayer P e positiveBase n := by
  apply rootSubgroup_le_RootSubgroupGenerated D halpha
  change C.x alpha t ∈ (D.rootSubgroup alpha : Set (Variety.Point K))
  rw [← (S.chevalley.1 alpha).2]
  exact Set.mem_range_self t

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma chevalleyRoot_zero
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (alpha : D.Root) : C.x alpha 0 = 1 := by
  simpa using S.chevalley.2.2.2.1 alpha 0 0

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma chevalleyRoot_neg
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (alpha : D.Root) (a : k) :
    C.x alpha (-a) = (C.x alpha a)⁻¹ := by
  apply eq_inv_iff_mul_eq_one.mpr
  rw [S.chevalley.2.2.2.1]
  simpa using chevalleyRoot_zero P e systemBase positiveBase C S alpha

private noncomputable def rootAtLeastList (n : Nat) : List D.Root := by
  let roots : Finset D.Root :=
    Finset.univ.filter fun alpha => (n : Int) ≤ positiveHeight P e positiveBase alpha
  exact roots.toList

omit [IsAlgClosed k] [Finite ι] [P.IsRootSystem] [P.IsCrystallographic]
  [P.IsReduced] in
private lemma rootAtLeastList_nodup (n : Nat) :
    (rootAtLeastList P e positiveBase n).Nodup := by
  classical
  exact Finset.nodup_toList _

omit [IsAlgClosed k] [Finite ι] [P.IsRootSystem] [P.IsCrystallographic]
  [P.IsReduced] in
private lemma mem_rootAtLeastList_iff (n : Nat) (alpha : D.Root) :
    alpha ∈ rootAtLeastList P e positiveBase n ↔
      (n : Int) ≤ positiveHeight P e positiveBase alpha := by
  classical
  simp [rootAtLeastList]

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma positiveLayer_exists_word (n : Nat) (z : Variety.Point K)
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (hz : z ∈ positiveLayer P e positiveBase n) :
    ∃ word : List (D.Root × k),
      (∀ q ∈ word, (n : Int) ≤ positiveHeight P e positiveBase q.1) ∧
      z = FilteredCollection.wordProduct C.x word := by
  classical
  have hwordInv : ∀ word : List (D.Root × k),
      (FilteredCollection.wordProduct C.x word)⁻¹ =
        FilteredCollection.wordProduct C.x
          (word.reverse.map fun q => (q.1, -q.2)) := by
    intro word
    let f : D.Root × k → Variety.Point K := fun q => C.x q.1 q.2
    let negParam : D.Root × k → D.Root × k := fun q => (q.1, -q.2)
    have hneg (q : D.Root × k) : f (negParam q) = (f q)⁻¹ := by
      exact chevalleyRoot_neg P e systemBase positiveBase C S q.1 q.2
    change (word.map f).prod⁻¹ = ((word.reverse.map negParam).map f).prod
    induction word with
    | nil => simp
    | cons q tail ih =>
        simp only [List.map_cons, List.prod_cons, List.reverse_cons,
          List.map_append, List.map_map, List.prod_append, mul_inv_rev]
        rw [ih, hneg]
        simp [Function.comp_def]
  rw [positiveLayer, RootSubgroupGenerated] at hz
  refine Subgroup.closure_induction
    (p := fun z _ => ∃ word : List (D.Root × k),
      (∀ q ∈ word, (n : Int) ≤ positiveHeight P e positiveBase q.1) ∧
      z = FilteredCollection.wordProduct C.x word)
    (k := ⋃ alpha ∈ {alpha | (n : Int) ≤ positiveHeight P e positiveBase alpha},
      (D.rootSubgroup alpha : Set (Variety.Point K))) ?_ ?_ ?_ ?_ hz
  · intro x hx
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq] at hx
    obtain ⟨alpha, halpha, hxalpha⟩ := hx
    rw [← (S.chevalley.1 alpha).2] at hxalpha
    obtain ⟨t, rfl⟩ := hxalpha
    exact ⟨[(alpha, t)], by simp [halpha], by simp [FilteredCollection.wordProduct]⟩
  · exact ⟨[], by simp, by simp [FilteredCollection.wordProduct]⟩
  · intro x y hx hy
    rintro ⟨wordX, hwordX, rfl⟩ ⟨wordY, hwordY, rfl⟩
    refine ⟨wordX ++ wordY, ?_, ?_⟩
    · intro q hq
      exact (List.mem_append.mp hq).elim (hwordX q) (hwordY q)
    · simp [FilteredCollection.wordProduct]
  · intro x hx
    rintro ⟨word, hword, rfl⟩
    refine ⟨word.reverse.map fun q => (q.1, -q.2), ?_, hwordInv word⟩
    intro q hq
    rw [List.mem_map] at hq
    obtain ⟨r, hr, rfl⟩ := hq
    exact hword r (List.mem_reverse.mp hr)

omit [IsAlgClosed k] in
private lemma positiveLayer_exists_collected (n : Nat) (hn : 0 < n)
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (z : Variety.Point K) (hz : z ∈ positiveLayer P e positiveBase n) :
    ∃ params : D.Root → k,
      z = ((rootAtLeastList P e positiveBase n).map fun alpha =>
        C.x alpha (params alpha)).prod := by
  obtain ⟨word, hword, rfl⟩ :=
    positiveLayer_exists_word (P := P) (e := e) (systemBase := systemBase)
      (positiveBase := positiveBase) (C := C) n z S hz
  have hsubset : ∀ alpha, (n : Int) ≤ positiveHeight P e positiveBase alpha →
      alpha ∈ positiveRoots := by
    intro alpha halpha
    apply (S.positive alpha).mpr
    change 0 < positiveHeight P e positiveBase alpha
    exact lt_of_lt_of_le (by exact_mod_cast hn) halpha
  have hclosed : ∀ alpha beta gamma,
      (n : Int) ≤ positiveHeight P e positiveBase alpha →
      (n : Int) ≤ positiveHeight P e positiveBase beta →
      D.add alpha beta = some gamma →
      (n : Int) ≤ positiveHeight P e positiveBase gamma := by
    intro alpha beta gamma halpha hbeta hadd
    have hgammaPositive : gamma ∈ positiveRoots :=
      S.positiveSystem.2.2 alpha (hsubset alpha halpha) beta (hsubset beta hbeta)
        gamma hadd
    have _hgammaHeight : 0 < positiveHeight P e positiveBase gamma :=
      (S.positive gamma).mp hgammaPositive
    have hroot := (S.rootAddition alpha beta gamma).mp hadd
    change (n : Int) ≤ positiveBase.height (e alpha) at halpha
    change (n : Int) ≤ positiveBase.height (e beta) at hbeta
    change (n : Int) ≤ positiveBase.height (e gamma)
    rw [positiveBase.height_add hroot]
    omega
  have hwordSupport : ∀ q ∈ word,
      q.1 ∈ {alpha | (n : Int) ≤ positiveHeight P e positiveBase alpha} := by
    intro q hq
    exact hword q hq
  obtain ⟨params, hparams⟩ :=
    positiveRootChevalleyCollection_exists_params_of_separateBase
      (D := D) (P := P) (e := e) (systemBase := systemBase)
        (positiveBase := positiveBase) (C := C)
        S.chevalley S.rootAddition S.positive
        (positiveRoots := positiveRoots)
        (support := {alpha | (n : Int) ≤ positiveHeight P e positiveBase alpha})
        hsubset hclosed
        (rootAtLeastList P e positiveBase n)
        (rootAtLeastList_nodup P e positiveBase n)
        (mem_rootAtLeastList_iff P e positiveBase n) word hwordSupport
  exact ⟨params, hparams⟩

omit [IsAlgClosed k] [Fintype D.Root] [Finite ι] [P.IsRootSystem]
  [P.IsCrystallographic] in
private lemma positiveRoots_linearlyIndependent
    {alpha beta : D.Root}
    (halpha : 0 < positiveHeight P e positiveBase alpha)
    (hbeta : 0 < positiveHeight P e positiveBase beta)
    (hne : alpha ≠ beta) :
    AreLinearlyIndependentRoots D P e alpha beta := by
  let _ := P.indexNeg
  have halphaPos : positiveBase.IsPos (e alpha) := halpha
  have hbetaPos : positiveBase.IsPos (e beta) := hbeta
  have hnotopp : P.root (e alpha) ≠ -P.root (e beta) := by
    intro hneg
    have hidx : e alpha = P.reflectionPerm (e beta) (e beta) :=
      P.root_eq_neg_iff.mp hneg
    have halphaNeg : positiveBase.IsPos (-e beta) := by
      simpa [hidx] using halphaPos
    exact ((RootPairing.Base.IsPos.neg_iff_not
      (P := P) (b := positiveBase) (i := e beta)).mp halphaNeg) hbetaPos
  have hrootne : e alpha ≠ e beta := fun heq => hne (e.injective heq)
  have hlin : LinearIndependent R ![P.root (e alpha), P.root (e beta)] :=
    RootPairing.IsReduced.linearIndependent (P := P) hrootne hnotopp
  rw [LinearIndependent.pair_iff] at hlin
  simpa [AreLinearlyIndependentRoots] using hlin

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma validTerm_positiveHeight
    {alpha beta : D.Root} (q : ChevalleyCommutatorTerm D.Root)
    (hq : IsValidChevalleyCommutatorTerm D P e alpha beta q) :
    positiveHeight P e positiveBase q.root =
      (q.i : Int) * positiveHeight P e positiveBase alpha +
        (q.j : Int) * positiveHeight P e positiveBase beta := by
  classical
  obtain ⟨f, -, -, hf⟩ := positiveBase.exists_root_eq_sum_int (e alpha)
  obtain ⟨g, -, -, hg⟩ := positiveBase.exists_root_eq_sum_int (e beta)
  have hf : P.root (e alpha) =
      ∑ l ∈ positiveBase.support, f l • P.root l := hf
  have hg : P.root (e beta) =
      ∑ l ∈ positiveBase.support, g l • P.root l := hg
  have hqexp : P.root (e q.root) =
      ∑ l ∈ positiveBase.support,
        ((q.i : Int) * f l + (q.j : Int) * g l) • P.root l := by
    have hq' : P.root (e q.root) =
        (q.i : Int) • P.root (e alpha) + (q.j : Int) • P.root (e beta) := by
      simpa only [Nat.cast_smul_eq_nsmul R, ← natCast_zsmul] using hq.2.2
    rw [hq', hf, hg]
    simp_rw [Finset.smul_sum, smul_smul, add_zsmul, Finset.sum_add_distrib]
  change positiveBase.height (e q.root) =
    (q.i : Int) * positiveBase.height (e alpha) +
      (q.j : Int) * positiveBase.height (e beta)
  rw [positiveBase.height_eq_sum hqexp, positiveBase.height_eq_sum hf,
    positiveBase.height_eq_sum hg]
  simp_rw [Finset.sum_add_distrib, Finset.mul_sum]

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma rootFactor_commutator_mem_layer
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i j : Nat) (hi : 0 < i) (hj : 0 < j)
    {alpha beta : D.Root}
    (halpha : (i : Int) ≤ positiveHeight P e positiveBase alpha)
    (hbeta : (j : Int) ≤ positiveHeight P e positiveBase beta)
    {x y : Variety.Point K} (hx : x ∈ D.rootSubgroup alpha)
    (hy : y ∈ D.rootSubgroup beta) :
    ⁅x, y⁆ ∈ positiveLayer P e positiveBase (i + j) := by
  have hrootAlpha : (D.rootSubgroup alpha : Set (Variety.Point K)) =
      Set.range (C.x alpha) := by
    simpa using (S.chevalley.1 alpha).2.symm
  have hrootBeta : (D.rootSubgroup beta : Set (Variety.Point K)) =
      Set.range (C.x beta) := by
    simpa using (S.chevalley.1 beta).2.symm
  change x ∈ (D.rootSubgroup alpha : Set (Variety.Point K)) at hx
  change y ∈ (D.rootSubgroup beta : Set (Variety.Point K)) at hy
  rw [hrootAlpha] at hx
  rw [hrootBeta] at hy
  obtain ⟨t, rfl⟩ := hx
  obtain ⟨u, rfl⟩ := hy
  by_cases heq : alpha = beta
  · subst beta
    have hcomm : Commute (C.x alpha t) (C.x alpha u) := by
      show C.x alpha t * C.x alpha u = C.x alpha u * C.x alpha t
      calc
        C.x alpha t * C.x alpha u = C.x alpha (t + u) :=
          S.chevalley.2.2.2.1 alpha t u
        _ = C.x alpha (u + t) := by rw [add_comm]
        _ = C.x alpha u * C.x alpha t :=
          (S.chevalley.2.2.2.1 alpha u t).symm
    rw [hcomm.commutator_eq]
    exact (positiveLayer P e positiveBase (i + j)).one_mem
  · have halphaPos : 0 < positiveHeight P e positiveBase alpha := by
      exact lt_of_lt_of_le (by exact_mod_cast hi) halpha
    have hbetaPos : 0 < positiveHeight P e positiveBase beta := by
      exact lt_of_lt_of_le (by exact_mod_cast hj) hbeta
    have hLI := positiveRoots_linearlyIndependent P e positiveBase
      halphaPos hbetaPos heq
    obtain ⟨order, coefficient, -, -, hvalid, -, hformula⟩ :=
      S.chevalley.2.2.2.2.1 alpha beta hLI
    have hterm (q : ChevalleyCommutatorTerm D.Root) (hq : q ∈ order) :
        C.x q.root (coefficient q * (-t) ^ q.i * (-u) ^ q.j) ∈
          positiveLayer P e positiveBase (i + j) := by
      have hqvalid := (hvalid q).mp hq
      apply positiveRoot_mem_layer (P := P) (e := e)
        (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
        (n := i + j) (alpha := q.root)
        (t := coefficient q * (-t) ^ q.i * (-u) ^ q.j) S
      rw [validTerm_positiveHeight P e positiveBase q hqvalid]
      have hqi : (1 : Int) ≤ q.i := by exact_mod_cast hqvalid.1
      have hqj : (1 : Int) ≤ q.j := by exact_mod_cast hqvalid.2.1
      have hijCast : ((i + j : Nat) : Int) = (i : Int) + (j : Int) := by omega
      rw [hijCast]
      nlinarith
    have hprod :
        (order.map fun q =>
          C.x q.root (coefficient q * (-t) ^ q.i * (-u) ^ q.j)).prod ∈
            positiveLayer P e positiveBase (i + j) := by
      apply Subgroup.list_prod_mem
      intro z hz
      rw [List.mem_map] at hz
      obtain ⟨q, hq, rfl⟩ := hz
      exact hterm q hq
    have hraw :
        (C.x alpha (-t))⁻¹ * (C.x beta (-u))⁻¹ *
            C.x alpha (-t) * C.x beta (-u) ∈
          positiveLayer P e positiveBase (i + j) := by
      rw [hformula (-t) (-u)]
      exact hprod
    have hxinv := chevalleyRoot_neg P e systemBase positiveBase C S alpha t
    have hyinv := chevalleyRoot_neg P e systemBase positiveBase C S beta u
    simpa [hxinv, hyinv, commutatorElement_def, mul_assoc] using hraw

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma positiveLayer_le_normalizer_next
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) :
    positiveLayer P e positiveBase i ≤
      Subgroup.normalizer
        (positiveLayer P e positiveBase (i + 1) : Set (Variety.Point K)) := by
  classical
  let next := positiveLayer P e positiveBase (i + 1)
  have hrootConj : ∀ {alpha : D.Root} (x : Variety.Point K),
      (i : Int) ≤ positiveHeight P e positiveBase alpha →
      x ∈ D.rootSubgroup alpha →
      ∀ z ∈ next, x * z * x⁻¹ ∈ next := by
    intro alpha x halpha hx z hz
    change z ∈ positiveLayer P e positiveBase (i + 1) at hz
    rw [positiveLayer, RootSubgroupGenerated] at hz
    refine Subgroup.closure_induction
      (p := fun z _ => x * z * x⁻¹ ∈ next)
      (k := ⋃ beta ∈ {beta |
        (i + 1 : Nat) ≤ positiveHeight P e positiveBase beta},
        (D.rootSubgroup beta : Set (Variety.Point K))) ?_ ?_ ?_ ?_ hz
    · intro y hy
      simp only [Set.mem_iUnion, Set.mem_ofPred_eq] at hy
      obtain ⟨beta, hbeta, hy⟩ := hy
      have hcomm : ⁅x, y⁆ ∈ next := by
        have hdeep := rootFactor_commutator_mem_layer
          P e systemBase positiveBase C S i (i + 1) hi (by omega)
            halpha hbeta hx hy
        exact positiveLayer_antitone P e positiveBase (by omega) hdeep
      have hyNext : y ∈ next := by
        apply rootSubgroup_le_RootSubgroupGenerated D hbeta
        exact hy
      change (MulAut.conj x) y ∈ next
      rw [conj_eq_commutatorElement_mul]
      exact next.mul_mem hcomm hyNext
    · simp
    · intro z w hz hw ihz ihw
      simpa [mul_assoc] using next.mul_mem ihz ihw
    · intro z hz ihz
      simpa [mul_assoc] using next.inv_mem ihz
  intro x hx
  rw [positiveLayer, RootSubgroupGenerated] at hx
  refine Subgroup.closure_induction
    (p := fun x _ => x ∈ Subgroup.normalizer (next : Set (Variety.Point K)))
    (k := ⋃ alpha ∈ {alpha |
      (i : Int) ≤ positiveHeight P e positiveBase alpha},
      (D.rootSubgroup alpha : Set (Variety.Point K))) ?_ ?_ ?_ ?_ hx
  · intro x hx
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq] at hx
    obtain ⟨alpha, halpha, hx⟩ := hx
    rw [Subgroup.mem_normalizer_iff]
    intro z
    constructor
    · exact hrootConj x halpha hx z
    · intro hz
      have hxinv : x⁻¹ ∈ D.rootSubgroup alpha := (D.rootSubgroup alpha).inv_mem hx
      simpa [mul_assoc] using hrootConj x⁻¹ halpha hxinv (x * z * x⁻¹) hz
  · exact (Subgroup.normalizer (next : Set (Variety.Point K))).one_mem
  · intro x y hx hy ihx ihy
    exact (Subgroup.normalizer (next : Set (Variety.Point K))).mul_mem ihx ihy
  · intro x hx ihx
    exact (Subgroup.normalizer (next : Set (Variety.Point K))).inv_mem ihx

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma positiveLayer_next_normal
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) :
    ((positiveLayer P e positiveBase (i + 1)).subgroupOf
      (positiveLayer P e positiveBase i)).Normal := by
  exact Subgroup.normal_subgroupOf_of_le_normalizer
    (positiveLayer_le_normalizer_next P e systemBase positiveBase C S i hi)

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma positiveLayer_commutator_le_next
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) :
    ⁅positiveLayer P e positiveBase i, positiveLayer P e positiveBase i⁆ ≤
      positiveLayer P e positiveBase (i + 1) := by
  classical
  let next := positiveLayer P e positiveBase (i + 1)
  have hnorm := positiveLayer_le_normalizer_next
    P e systemBase positiveBase C S i hi
  rw [Subgroup.commutator_le]
  intro x hx
  rw [positiveLayer, RootSubgroupGenerated] at hx
  refine Subgroup.closure_induction
    (p := fun x _ => ∀ y ∈ positiveLayer P e positiveBase i, ⁅x, y⁆ ∈ next)
    (k := ⋃ alpha ∈ {alpha |
      (i : Int) ≤ positiveHeight P e positiveBase alpha},
      (D.rootSubgroup alpha : Set (Variety.Point K))) ?_ ?_ ?_ ?_ hx
  · intro x hx
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq] at hx
    obtain ⟨alpha, halpha, hx⟩ := hx
    intro y hy
    rw [positiveLayer, RootSubgroupGenerated] at hy
    refine Subgroup.closure_induction
      (p := fun y _ => ⁅x, y⁆ ∈ next)
      (k := ⋃ beta ∈ {beta |
        (i : Int) ≤ positiveHeight P e positiveBase beta},
        (D.rootSubgroup beta : Set (Variety.Point K))) ?_ ?_ ?_ ?_ hy
    · intro y hy
      simp only [Set.mem_iUnion, Set.mem_ofPred_eq] at hy
      obtain ⟨beta, hbeta, hy⟩ := hy
      have hdeep := rootFactor_commutator_mem_layer
        P e systemBase positiveBase C S i i hi hi halpha hbeta hx hy
      exact positiveLayer_antitone P e positiveBase (by omega) hdeep
    · simp
    · intro y z hy hz ihy ihz
      have hyNorm := hnorm hy
      have hyConj : y * ⁅x, z⁆ * y⁻¹ ∈ next :=
        (Subgroup.mem_normalizer_iff.mp hyNorm ⁅x, z⁆).mp ihz
      rw [commutatorElement_mul_right_eq_mul_conj]
      simpa [mul_assoc] using next.mul_mem ihy hyConj
    · intro y hy ihy
      have hyNorm := hnorm hy
      have hyInvNorm :=
        (Subgroup.normalizer (next : Set (Variety.Point K))).inv_mem hyNorm
      have hyx : ⁅y, x⁆ ∈ next := by
        simpa [commutatorElement_inv] using next.inv_mem ihy
      have hconj : y⁻¹ * ⁅y, x⁆ * y⁻¹⁻¹ ∈ next :=
        (Subgroup.mem_normalizer_iff.mp hyInvNorm ⁅y, x⁆).mp hyx
      simpa [commutatorElement_def, mul_assoc] using hconj
  · intro y hy
    simp
  · intro x z hx hz ihx ihz y hy
    have hxNorm := hnorm hx
    have hxConj : x * ⁅z, y⁆ * x⁻¹ ∈ next :=
      (Subgroup.mem_normalizer_iff.mp hxNorm ⁅z, y⁆).mp (ihz y hy)
    rw [commutatorElement_mul_left_eq_conj_mul]
    exact next.mul_mem hxConj (ihx y hy)
  · intro x hx ihx y hy
    have hxNorm := hnorm hx
    have hxInvNorm :=
      (Subgroup.normalizer (next : Set (Variety.Point K))).inv_mem hxNorm
    have hyx : ⁅y, x⁆ ∈ next := by
      simpa [commutatorElement_inv] using next.inv_mem (ihx y hy)
    have hconj : x⁻¹ * ⁅y, x⁆ * x⁻¹⁻¹ ∈ next :=
      (Subgroup.mem_normalizer_iff.mp hxInvNorm ⁅y, x⁆).mp hyx
    simpa [commutatorElement_inv_left] using hconj

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma positiveLayer_quotient_commutative
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i)
    (hN : ((positiveLayer P e positiveBase (i + 1)).subgroupOf
      (positiveLayer P e positiveBase i)).Normal) :
    IsMulCommutative
      ((positiveLayer P e positiveBase i) ⧸
        (positiveLayer P e positiveBase (i + 1)).subgroupOf
          (positiveLayer P e positiveBase i)) := by
  let _ := hN
  exact (Subgroup.Normal.quotient_commutative_iff_commutator_le).2 <| by
    have hcomm := positiveLayer_commutator_le_next
      P e systemBase positiveBase C S i hi
    have hmap :
        (_root_.commutator ↑(positiveLayer P e positiveBase i)).map
          (positiveLayer P e positiveBase i).subtype ≤
            positiveLayer P e positiveBase (i + 1) := by
      rw [Subgroup.map_subtype_commutator]
      exact hcomm
    simpa [Subgroup.comap_subtype] using
      (Subgroup.map_le_iff_le_comap.mp hmap)

private def corootPairScale (alpha beta gamma : D.Root) (u v : kˣ) : k :=
  (u : k) ^ D.pairing gamma beta * (v : k) ^ D.pairing gamma alpha

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma corootPair_conjugates_root
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (alpha beta gamma : D.Root) (u v : kˣ) (t : k) :
    (C.h beta u * C.h alpha v)⁻¹ * C.x gamma t *
        (C.h beta u * C.h alpha v) =
      C.x gamma (corootPairScale (D := D) alpha beta gamma u v * t) := by
  have hconj := S.chevalley.2.2.2.2.2.2.2.2.2.2.2.1
  calc
    (C.h beta u * C.h alpha v)⁻¹ * C.x gamma t *
        (C.h beta u * C.h alpha v) =
        (C.h alpha v)⁻¹ * ((C.h beta u)⁻¹ * C.x gamma t * C.h beta u) *
          C.h alpha v := by group
    _ = (C.h alpha v)⁻¹ *
          C.x gamma ((u : k) ^ D.pairing gamma beta * t) * C.h alpha v := by
      rw [hconj gamma beta t u]
    _ = C.x gamma ((v : k) ^ D.pairing gamma alpha *
          ((u : k) ^ D.pairing gamma beta * t)) :=
      hconj gamma alpha ((u : k) ^ D.pairing gamma beta * t) v
    _ = _ := by
      apply congrArg (C.x gamma)
      simp only [corootPairScale]
      ring

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma corootPair_conjugates_word
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (alpha beta : D.Root) (u v : kˣ) (word : List (D.Root × k)) :
    (C.h beta u * C.h alpha v)⁻¹ *
        FilteredCollection.wordProduct C.x word *
          (C.h beta u * C.h alpha v) =
      FilteredCollection.wordProduct C.x
        (word.map fun q =>
          (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)) := by
  induction word with
  | nil => simp [FilteredCollection.wordProduct]
  | cons q tail ih =>
      rw [show FilteredCollection.wordProduct C.x (q :: tail) =
          C.x q.1 q.2 * FilteredCollection.wordProduct C.x tail by rfl]
      rw [show FilteredCollection.wordProduct C.x
          ((q :: tail).map fun r =>
            (r.1, corootPairScale (D := D) alpha beta r.1 u v * r.2)) =
          C.x q.1 (corootPairScale (D := D) alpha beta q.1 u v * q.2) *
            FilteredCollection.wordProduct C.x
              (tail.map fun r =>
                (r.1, corootPairScale (D := D) alpha beta r.1 u v * r.2)) by rfl]
      calc
        (C.h beta u * C.h alpha v)⁻¹ *
            (C.x q.1 q.2 * FilteredCollection.wordProduct C.x tail) *
              (C.h beta u * C.h alpha v) =
            ((C.h beta u * C.h alpha v)⁻¹ * C.x q.1 q.2 *
              (C.h beta u * C.h alpha v)) *
            ((C.h beta u * C.h alpha v)⁻¹ *
              FilteredCollection.wordProduct C.x tail *
                (C.h beta u * C.h alpha v)) := by group
        _ = _ := by
          rw [corootPair_conjugates_root P e systemBase positiveBase C S, ih]

omit [Fintype D.Root] in
private lemma exists_pairingSeparator
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (alpha beta : D.Root)
    (halpha : 0 < positiveHeight P e positiveBase alpha)
    (hbeta : 0 < positiveHeight P e positiveBase beta)
    (hne : alpha ≠ beta) :
    ∃ u v : kˣ,
      corootPairScale (D := D) alpha beta alpha u v = 1 ∧
      corootPairScale (D := D) alpha beta beta u v ≠ 1 := by
  have hLI := positiveRoots_linearlyIndependent P e positiveBase halpha hbeta hne
  have hlin : LinearIndependent R ![P.root (e alpha), P.root (e beta)] := by
    rw [LinearIndependent.pair_iff]
    simpa [AreLinearlyIndependentRoots] using hLI
  have hcox : P.coxeterWeight (e alpha) (e beta) ≠ 4 :=
    (P.linearIndependent_iff_coxeterWeight_ne_four).mp hlin
  let z : Int := 4 - D.pairing alpha beta * D.pairing beta alpha
  have hz : z ≠ 0 := by
    intro hz0
    apply hcox
    rw [RootPairing.coxeterWeight, ← S.actual.1 alpha beta,
      ← S.actual.1 beta alpha]
    have hzprod : D.pairing alpha beta * D.pairing beta alpha = 4 := by
      dsimp [z] at hz0
      omega
    exact_mod_cast hzprod
  obtain ⟨c, hc⟩ := exists_unit_zpow_ne_one (k := k) hz
  let a := D.pairing alpha beta
  let b := D.pairing beta alpha
  have halphaSelf : D.pairing alpha alpha = 2 := by
    have halphaSelfR : (D.pairing alpha alpha : R) = 2 := by
      rw [S.actual.1 alpha alpha, P.pairing_same]
    exact_mod_cast halphaSelfR
  have hbetaSelf : D.pairing beta beta = 2 := by
    have hbetaSelfR : (D.pairing beta beta : R) = 2 := by
      rw [S.actual.1 beta beta, P.pairing_same]
    exact_mod_cast hbetaSelfR
  refine ⟨c ^ (2 : Int), c ^ (-a), ?_, ?_⟩
  · simp only [corootPairScale, halphaSelf]
    have hu : (c ^ (2 : Int)) ^ a * (c ^ (-a)) ^ (2 : Int) = 1 := by
      rw [← zpow_mul, ← zpow_mul, ← zpow_add]
      convert zpow_zero c using 1
      ring_nf
    simpa [a] using congrArg Units.val hu
  · simp only [corootPairScale, hbetaSelf]
    intro heq
    apply hc
    have heqUnits : (c ^ (2 : Int)) ^ (2 : Int) * (c ^ (-a)) ^ b = 1 := by
      apply Units.ext
      simpa using heq
    rw [← zpow_mul, ← zpow_mul, ← zpow_add] at heqUnits
    convert heqUnits using 1
    dsimp [a, b, z]
    ring_nf

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma corootPair_conjugates_layer
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (n : Nat) (alpha beta : D.Root) (u v : kˣ)
    (z : Variety.Point K) (hz : z ∈ positiveLayer P e positiveBase n) :
    (C.h beta u * C.h alpha v)⁻¹ * z * (C.h beta u * C.h alpha v) ∈
      positiveLayer P e positiveBase n := by
  obtain ⟨word, hword, rfl⟩ := positiveLayer_exists_word
    (P := P) (e := e) (systemBase := systemBase)
      (positiveBase := positiveBase) (C := C) n z S hz
  rw [corootPair_conjugates_word P e systemBase positiveBase C S]
  apply Subgroup.list_prod_mem
  intro x hx
  rw [List.mem_map] at hx
  obtain ⟨q, hq, rfl⟩ := hx
  rw [List.mem_map] at hq
  obtain ⟨r, hr, rfl⟩ := hq
  exact positiveRoot_mem_layer (P := P) (e := e)
    (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
      (n := n) (alpha := r.1)
      (t := corootPairScale (D := D) alpha beta r.1 u v * r.2) S (hword r hr)

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma exactWord_difference_mem_next
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) (word : List (D.Root × k))
    (hexact : ∀ q ∈ word, positiveHeight P e positiveBase q.1 = i)
    (alpha beta : D.Root) (u v : kˣ)
    (hrelation :
      FilteredCollection.wordProduct C.x
          (word.map fun q =>
            (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)) *
        (FilteredCollection.wordProduct C.x word)⁻¹ ∈
          positiveLayer P e positiveBase (i + 1)) :
    FilteredCollection.wordProduct C.x
        (word.map fun q =>
          (q.1, (corootPairScale (D := D) alpha beta q.1 u v - 1) * q.2)) ∈
      positiveLayer P e positiveBase (i + 1) := by
  classical
  let hN := positiveLayer_next_normal P e systemBase positiveBase C S i hi
  let _ := hN
  let hcomm := positiveLayer_quotient_commutative
    P e systemBase positiveBase C S i hi hN
  let _ := hcomm
  let L := positiveLayer P e positiveBase i
  let Nsub := (positiveLayer P e positiveBase (i + 1)).subgroupOf L
  let Q := L ⧸ Nsub
  have horigLayer : FilteredCollection.wordProduct C.x word ∈ L := by
    apply Subgroup.list_prod_mem
    intro x hx
    rw [List.mem_map] at hx
    obtain ⟨q, hq, rfl⟩ := hx
    exact positiveRoot_mem_layer (P := P) (e := e)
      (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
        (n := i) (alpha := q.1) (t := q.2) S (by rw [hexact q hq])
  have hscaledLayer : FilteredCollection.wordProduct C.x
      (word.map fun q =>
        (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)) ∈ L := by
    apply Subgroup.list_prod_mem
    intro x hx
    rw [List.mem_map] at hx
    obtain ⟨q, hq, rfl⟩ := hx
    rw [List.mem_map] at hq
    obtain ⟨r, hr, rfl⟩ := hq
    exact positiveRoot_mem_layer (P := P) (e := e)
      (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
        (n := i) (alpha := r.1)
        (t := corootPairScale (D := D) alpha beta r.1 u v * r.2) S
          (by rw [hexact r hr])
  let original (q : {q // q ∈ word}) : Q :=
    QuotientGroup.mk' Nsub
      ⟨C.x q.1.1 q.1.2, positiveRoot_mem_layer (P := P) (e := e)
        (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
          (n := i) (alpha := q.1.1) (t := q.1.2) S (by rw [hexact q.1 q.2])⟩
  let scaled (q : {q // q ∈ word}) : Q :=
    QuotientGroup.mk' Nsub
      ⟨C.x q.1.1 (corootPairScale (D := D) alpha beta q.1.1 u v * q.1.2),
        positiveRoot_mem_layer (P := P) (e := e)
          (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
            (n := i) (alpha := q.1.1)
            (t := corootPairScale (D := D) alpha beta q.1.1 u v * q.1.2) S
              (by rw [hexact q.1 q.2])⟩
  let difference (q : {q // q ∈ word}) : Q :=
    QuotientGroup.mk' Nsub
      ⟨C.x q.1.1
          ((corootPairScale (D := D) alpha beta q.1.1 u v - 1) * q.1.2),
        positiveRoot_mem_layer (P := P) (e := e)
          (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
            (n := i) (alpha := q.1.1)
            (t := (corootPairScale (D := D) alpha beta q.1.1 u v - 1) * q.1.2) S
              (by rw [hexact q.1 q.2])⟩
  have hfactor (q : {q // q ∈ word}) :
      difference q = scaled q * (original q)⁻¹ := by
    have hparam :
        (corootPairScale (D := D) alpha beta q.1.1 u v - 1) * q.1.2 =
          corootPairScale (D := D) alpha beta q.1.1 u v * q.1.2 + (-q.1.2) := by
      ring
    have hx : C.x q.1.1
        ((corootPairScale (D := D) alpha beta q.1.1 u v - 1) * q.1.2) =
          C.x q.1.1
              (corootPairScale (D := D) alpha beta q.1.1 u v * q.1.2) *
            (C.x q.1.1 q.1.2)⁻¹ := by
      rw [hparam, ← S.chevalley.2.2.2.1,
        chevalleyRoot_neg P e systemBase positiveBase C S]
    change QuotientGroup.mk' Nsub ⟨C.x q.1.1 _, _⟩ =
      QuotientGroup.mk' Nsub ⟨C.x q.1.1 _, _⟩ *
        (QuotientGroup.mk' Nsub ⟨C.x q.1.1 q.1.2, _⟩)⁻¹
    rw [← map_inv, ← map_mul]
    apply congrArg (QuotientGroup.mk' Nsub)
    apply Subtype.ext
    exact hx
  have hprod :
      (word.attach.map difference).prod =
        (word.attach.map scaled).prod * (word.attach.map original).prod⁻¹ := by
    induction word.attach with
    | nil => simp
    | cons q tail ih =>
        simp only [List.map_cons, List.prod_cons]
        rw [hfactor, ih, mul_inv_rev]
        ac_rfl
  have horiginal :
      (word.attach.map original).prod =
        QuotientGroup.mk' Nsub
          ⟨FilteredCollection.wordProduct C.x word, horigLayer⟩ := by
    calc
      (word.attach.map original).prod =
          ((word.attach.map fun q =>
            (⟨C.x q.1.1 q.1.2, positiveRoot_mem_layer (P := P) (e := e)
              (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
                (n := i) (alpha := q.1.1) (t := q.1.2) S
                  (by rw [hexact q.1 q.2])⟩ : L)).map
              (QuotientGroup.mk' Nsub)).prod := by
            simp only [List.map_map]
            rfl
      _ = QuotientGroup.mk' Nsub
          (word.attach.map fun q =>
            (⟨C.x q.1.1 q.1.2, positiveRoot_mem_layer (P := P) (e := e)
              (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
                (n := i) (alpha := q.1.1) (t := q.1.2) S
                  (by rw [hexact q.1 q.2])⟩ : L)).prod :=
            (map_list_prod (QuotientGroup.mk' Nsub) _).symm
      _ = QuotientGroup.mk' Nsub
          ⟨FilteredCollection.wordProduct C.x word, horigLayer⟩ := by
            apply congrArg (QuotientGroup.mk' Nsub)
            apply Subtype.ext
            rw [SubmonoidClass.coe_list_prod]
            simp only [List.map_map]
            exact congrArg List.prod (List.attach_map_val
              (l := word) (f := fun q => C.x q.1 q.2))
  have hscaled :
      (word.attach.map scaled).prod =
        QuotientGroup.mk' Nsub
          ⟨FilteredCollection.wordProduct C.x
            (word.map fun q =>
              (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)),
            hscaledLayer⟩ := by
    calc
      (word.attach.map scaled).prod =
          ((word.attach.map fun q =>
            (⟨C.x q.1.1
                (corootPairScale (D := D) alpha beta q.1.1 u v * q.1.2),
              positiveRoot_mem_layer (P := P) (e := e)
                (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
                  (n := i) (alpha := q.1.1)
                  (t := corootPairScale (D := D) alpha beta q.1.1 u v * q.1.2) S
                    (by rw [hexact q.1 q.2])⟩ : L)).map
              (QuotientGroup.mk' Nsub)).prod := by
            simp only [List.map_map]
            rfl
      _ = QuotientGroup.mk' Nsub
          (word.attach.map fun q =>
            (⟨C.x q.1.1
                (corootPairScale (D := D) alpha beta q.1.1 u v * q.1.2),
              positiveRoot_mem_layer (P := P) (e := e)
                (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
                  (n := i) (alpha := q.1.1)
                  (t := corootPairScale (D := D) alpha beta q.1.1 u v * q.1.2) S
                    (by rw [hexact q.1 q.2])⟩ : L)).prod :=
            (map_list_prod (QuotientGroup.mk' Nsub) _).symm
      _ = QuotientGroup.mk' Nsub
          ⟨FilteredCollection.wordProduct C.x
            (word.map fun q =>
              (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)),
            hscaledLayer⟩ := by
            apply congrArg (QuotientGroup.mk' Nsub)
            apply Subtype.ext
            rw [SubmonoidClass.coe_list_prod]
            simp only [List.map_map]
            rw [FilteredCollection.wordProduct]
            simp only [List.map_map]
            change (word.attach.map fun q => C.x q.1.1
              (corootPairScale (D := D) alpha beta q.1.1 u v * q.1.2)).prod = _
            exact congrArg List.prod (List.attach_map_val
              (l := word)
              (f := fun q => C.x q.1
                (corootPairScale (D := D) alpha beta q.1 u v * q.2)))
  have hrelationOne :
      (word.attach.map scaled).prod * (word.attach.map original).prod⁻¹ = 1 := by
    rw [hscaled, horiginal, ← map_inv, ← map_mul]
    exact (QuotientGroup.eq_one_iff
      (⟨FilteredCollection.wordProduct C.x
          (word.map fun q =>
            (q.1, corootPairScale (D := D) alpha beta q.1 u v * q.2)) *
        (FilteredCollection.wordProduct C.x word)⁻¹, by
          exact L.mul_mem hscaledLayer (L.inv_mem horigLayer)⟩ : L)).2 hrelation
  have hdifferenceOne : (word.attach.map difference).prod = 1 := by
    rw [hprod, hrelationOne]
  let differencePoint : L :=
    ⟨FilteredCollection.wordProduct C.x
      (word.map fun q =>
        (q.1, (corootPairScale (D := D) alpha beta q.1 u v - 1) * q.2)), by
      apply Subgroup.list_prod_mem
      intro x hx
      rw [List.mem_map] at hx
      obtain ⟨q, hq, rfl⟩ := hx
      rw [List.mem_map] at hq
      obtain ⟨r, hr, rfl⟩ := hq
      exact positiveRoot_mem_layer (P := P) (e := e)
        (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
          (n := i) (alpha := r.1)
          (t := (corootPairScale (D := D) alpha beta r.1 u v - 1) * r.2) S
            (by rw [hexact r hr])⟩
  have hdifference :
      (word.attach.map difference).prod = QuotientGroup.mk' Nsub differencePoint := by
    calc
      (word.attach.map difference).prod =
          ((word.attach.map fun q =>
            (⟨C.x q.1.1
                ((corootPairScale (D := D) alpha beta q.1.1 u v - 1) * q.1.2),
              positiveRoot_mem_layer (P := P) (e := e)
                (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
                  (n := i) (alpha := q.1.1)
                  (t := (corootPairScale (D := D) alpha beta q.1.1 u v - 1) *
                    q.1.2) S (by rw [hexact q.1 q.2])⟩ : L)).map
              (QuotientGroup.mk' Nsub)).prod := by
            simp only [List.map_map]
            rfl
      _ = QuotientGroup.mk' Nsub
          (word.attach.map fun q =>
            (⟨C.x q.1.1
                ((corootPairScale (D := D) alpha beta q.1.1 u v - 1) * q.1.2),
              positiveRoot_mem_layer (P := P) (e := e)
                (systemBase := systemBase) (positiveBase := positiveBase) (C := C)
                  (n := i) (alpha := q.1.1)
                  (t := (corootPairScale (D := D) alpha beta q.1.1 u v - 1) *
                    q.1.2) S (by rw [hexact q.1 q.2])⟩ : L)).prod :=
            (map_list_prod (QuotientGroup.mk' Nsub) _).symm
      _ = QuotientGroup.mk' Nsub differencePoint := by
            apply congrArg (QuotientGroup.mk' Nsub)
            apply Subtype.ext
            rw [SubmonoidClass.coe_list_prod]
            simp only [List.map_map]
            dsimp [differencePoint]
            rw [FilteredCollection.wordProduct]
            simp only [List.map_map]
            change (word.attach.map fun q => C.x q.1.1
              ((corootPairScale (D := D) alpha beta q.1.1 u v - 1) *
                q.1.2)).prod = _
            exact congrArg List.prod (List.attach_map_val
              (l := word)
              (f := fun q => C.x q.1
                ((corootPairScale (D := D) alpha beta q.1 u v - 1) * q.2)))
  rw [hdifference] at hdifferenceOne
  exact (QuotientGroup.eq_one_iff differencePoint).1 hdifferenceOne

omit [IsAlgClosed k] [Fintype D.Root] in
private lemma exactPair_difference_mem_next
    (S : PositiveCoordinateSetup P e systemBase positiveBase C
      (positiveRoots := positiveRoots))
    (i : Nat) (hi : 0 < i) (word : List (D.Root × (k × k)))
