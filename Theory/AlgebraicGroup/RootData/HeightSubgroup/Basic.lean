module

public import Mathlib.Data.Int.ConditionallyCompleteOrder
public import Theory.AlgebraicGroup.Borel.Defs
public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup
public import Theory.AlgebraicGroup.Unipotent.Radical

/-!
Root-height subgroups for the Borel filtration in GLS3 Theorem 1.12.9.

`RootHeightBorelSetup` aligns a realized root datum and positive system with a
Borel subgroup and its unipotent radical.  It also requires completeness of the
partial root-addition operation: whenever the sum of two realized root weights
is again a root, `D.add` returns that root.  This independent contract is the
input needed by later Chevalley collection arguments; it is not a conclusion of
the numbered theorem.  The elementary results below identify the first layer,
place positive layers in the unipotent radical, and show that the filtration is
descending.
-/

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

/-- Root data, complete root addition, a Borel subgroup, and its unipotent
radical, with the chosen positive system aligned with the root-height
function. -/
public structure RootHeightBorelSetup
    {K : Variety k} [AlgebraicGroup K]
    (T : ClosedSubgroup K) (D : RootGroupData K T)
    (positiveRoots : Set D.Root) (B U : ClosedSubgroup K) : Prop where
  maximalTorus : IsMaximalTorus T
  rootRealization : D.IsRealization
  rootAdditionComplete : D.IsRootAdditionComplete
  positiveSystem : IsPositiveSystem D positiveRoots
  height_positiveRoots : ∀ α, α ∈ positiveRoots ↔ 0 < D.height α
  borel : IsBorelSubgroup B
  torus_le_borel : T ≤ B
  unipotentRadical : IsUnipotentRadicalOf B U
  positiveRootGeneration :
    U.toSubgroup = RootSubgroupGenerated D positiveRoots
  torus_unipotent_factorization :
    B.toSubgroup = T.toSubgroup ⊔ U.toSubgroup

/-- The roots of height at least `i`. -/
public def rootHeightSet
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (i : ℕ) : Set D.Root :=
  {α | (i : ℤ) ≤ D.height α}

/-- The subgroup generated by all root subgroups of height at least `i`. -/
public def rootHeightSubgroup
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (i : ℕ) : Subgroup (Variety.Point K) :=
  RootSubgroupGenerated D (rootHeightSet D i)

/-- GLS3 Theorem 1.12.9(a): the first root-height subgroup is the unipotent
radical generated by the positive root subgroups. -/
public lemma rootHeightSubgroup_first_eq
    {K : Variety k} [AlgebraicGroup K]
    (T : ClosedSubgroup K) (D : RootGroupData K T)
    (positiveRoots : Set D.Root) (B U : ClosedSubgroup K)
    (S : RootHeightBorelSetup T D positiveRoots B U) :
    rootHeightSubgroup D 1 = U.toSubgroup := by
  rw [rootHeightSubgroup, S.positiveRootGeneration]
  congr 1
  ext α
  rw [S.height_positiveRoots]
  change ((1 : ℕ) : ℤ) ≤ D.height α ↔ 0 < D.height α
  omega

/-- GLS3 Theorem 1.12.9(a): every positive root-height subgroup lies in the
unipotent radical. -/
public lemma rootHeightSubgroup_le_unipotentRadical
    {K : Variety k} [AlgebraicGroup K]
    (T : ClosedSubgroup K) (D : RootGroupData K T)
    (positiveRoots : Set D.Root) (B U : ClosedSubgroup K)
    (S : RootHeightBorelSetup T D positiveRoots B U)
    (i : ℕ) (hi : 0 < i) :
    rootHeightSubgroup D i ≤ U.toSubgroup := by
  rw [rootHeightSubgroup, S.positiveRootGeneration]
  apply RootSubgroupGenerated_mono D
  intro α hα
  rw [S.height_positiveRoots]
  exact lt_of_lt_of_le (by exact_mod_cast hi) hα

/-- GLS3 Theorem 1.12.9(a): the root-height filtration is descending. -/
public lemma rootHeightSubgroup_succ_le
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (i : ℕ) :
    rootHeightSubgroup D (i + 1) ≤ rootHeightSubgroup D i := by
  apply RootSubgroupGenerated_mono D
  intro α hα
  change (i : ℤ) ≤ D.height α
  exact le_trans (by omega) hα

end Theory.AlgebraicGroup
