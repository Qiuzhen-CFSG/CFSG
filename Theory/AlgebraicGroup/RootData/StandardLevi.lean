module

public import Theory.AlgebraicGroup.RootData.StandardParabolicGenerated

universe u

/-!
The standard Levi subgroup on rational points.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

/-- The subgroup of rational points generated by the chosen torus and the
root subgroups in the standard Levi subsystem.  No algebraic closedness claim
is built into this definition. -/
@[expose]
public noncomputable def standardLeviSubgroup
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (sigmaJ : Set D.Root) :
    Subgroup (Variety.Point K) :=
  T.toSubgroup ⊔ standardLeviRootFactor D sigmaJ

end Theory.AlgebraicGroup
