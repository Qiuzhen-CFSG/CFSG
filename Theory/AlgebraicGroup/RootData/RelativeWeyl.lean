module

public import Theory.AlgebraicGroup.RootData.RelativeRoots

set_option linter.style.haveILetI false

/-!
Relative Weyl subgroups and their action on relative-root heights.
-/

namespace Theory.AlgebraicGroup

section

@[expose]
public noncomputable def RelativeWeylSubgroup
    {ι R M N : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) (J : Set ι) : Subgroup P.weylGroup :=
  Subgroup.closure ((fun δ => RootPairing.weylGroup.ofIdx P δ) '' J)

end

section

/-- Every relative Weyl orbit contains a root of maximal full base height. -/
public theorem exists_relativeWeylSubgroup_baseHeight_maximal
    {ι R M N : Type*} [Fintype ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    (base : P.Base) (J : Set ι) (α : ι) :
    ∃ w : RelativeWeylSubgroup P J, ∀ v : RelativeWeylSubgroup P J,
      base.height (P.weylGroupToPerm v.1 α) ≤
        base.height (P.weylGroupToPerm w.1 α) := by
  let : Finite P.weylGroup := weylGroup_finite P
  letI : Fintype (RelativeWeylSubgroup P J) := Fintype.ofFinite _
  obtain ⟨w, -, hw⟩ := Finset.exists_max_image Finset.univ
    (fun v : RelativeWeylSubgroup P J =>
      base.height (P.weylGroupToPerm v.1 α)) Finset.univ_nonempty
  exact ⟨w, fun v => hw v (Finset.mem_univ v)⟩

end

section

/-- Every relative Weyl orbit contains a root of minimal full base height. -/
public theorem exists_relativeWeylSubgroup_baseHeight_minimal
    {ι R M N : Type*} [Fintype ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    (base : P.Base) (J : Set ι) (α : ι) :
    ∃ w : RelativeWeylSubgroup P J, ∀ v : RelativeWeylSubgroup P J,
      base.height (P.weylGroupToPerm w.1 α) ≤
        base.height (P.weylGroupToPerm v.1 α) := by
  let : Finite P.weylGroup := weylGroup_finite P
  letI : Fintype (RelativeWeylSubgroup P J) := Fintype.ofFinite _
  obtain ⟨w, -, hw⟩ := Finset.exists_min_image Finset.univ
    (fun v : RelativeWeylSubgroup P J =>
      base.height (P.weylGroupToPerm v.1 α)) Finset.univ_nonempty
  exact ⟨w, fun v => hw v (Finset.mem_univ v)⟩

end

section

/-- Every element generated by the fundamental reflections in `J` preserves
relative root height outside `J`. -/
public theorem relativeWeylSubgroup_relativeRootHeight_eq
    {ι R M N : Type*} [Fintype ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (base : P.Base) (J : Set ι) (hJ : J ⊆ base.support)
    (coeff : ι → ι → ℤ) (hCoeff : HasSimpleRootExpansion P base coeff)
    (w : RelativeWeylSubgroup P J) (α : ι) :
    RelativeRootHeight coeff base.support J (P.weylGroupToPerm w.1 α) =
      RelativeRootHeight coeff base.support J α := by
  let height := RelativeRootHeight coeff base.support J
  change height (P.weylGroupToPerm w.1 α) = height α
  have hclosure : ∀ x : P.weylGroup,
      x ∈ RelativeWeylSubgroup P J →
        ∀ β, height (P.weylGroupToPerm x β) = height β := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
        rcases hx with ⟨δ, hδJ, rfl⟩
        intro β
        exact relativeRootHeight_reflectionPerm_eq P base J hJ coeff hCoeff hδJ β
    | one => simp
    | mul x y hx hy hx' hy' =>
        intro β
        rw [map_mul, Equiv.Perm.mul_apply, hx', hy']
    | inv x hx hx' =>
        intro β
        have h := hx' (P.weylGroupToPerm x⁻¹ β)
        simp at h
        exact h.symm
  exact hclosure w.1 w.2 α

end

section

/-- A full-height-maximal representative of a relative Weyl orbit pairs
nonnegatively with every simple root in the relative subsystem. -/
public theorem relativeWeylSubgroup_baseHeight_maximal_pairingIn_nonneg
    {ι R M N : Type*} [Fintype ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem] [P.IsCrystallographic]
    (base : P.Base) (J : Set ι) (α : ι)
    (w : RelativeWeylSubgroup P J)
    (hw : ∀ v : RelativeWeylSubgroup P J,
      base.height (P.weylGroupToPerm v.1 α) ≤
        base.height (P.weylGroupToPerm w.1 α))
    (δ : ι) (hδJ : δ ∈ J) (hδSupport : δ ∈ base.support) :
    0 ≤ P.pairingIn ℤ (P.weylGroupToPerm w.1 α) δ := by
  let α' := P.weylGroupToPerm w.1 α
  let s : RelativeWeylSubgroup P J :=
    ⟨RootPairing.weylGroup.ofIdx P δ,
      Subgroup.subset_closure ⟨δ, hδJ, rfl⟩⟩
  have hmax := hw (s * w)
  have hperm : P.weylGroupToPerm (s * w).1 α = P.reflectionPerm δ α' := by
    change ((RootPairing.Equiv.reflection P δ) *
      (w.1 : RootPairing.Aut P)).indexEquiv α = _
    simp [α']
  rw [hperm] at hmax
  change base.height (P.reflectionPerm δ α') ≤ base.height α' at hmax
  have href : P.root (P.reflectionPerm δ α') =
      P.root α' + (-P.pairingIn ℤ α' δ) • P.root δ := by
    rw [P.root_reflectionPerm, P.reflection_apply_root' ℤ]
    module
  have hheight := base.height_add_zsmul href
  rw [base.height_one_of_mem_support hδSupport] at hheight
  have hheight' : base.height (P.reflectionPerm δ α') =
      base.height α' - P.pairingIn ℤ α' δ := by
    simpa [sub_eq_add_neg] using hheight
  change 0 ≤ P.pairingIn ℤ α' δ
  omega

end

section

/-- Every relative root of height at least two splits with a height-one summand.

This is GLS3, Lemma 1.13.6 (second conjunct). -/
public theorem relativeRootHeight_split_of_ge_two
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (base : P.Base) (J : Set ι) (hJ : J ⊆ base.support)
    (coeff : ι → ι → ℤ) (hCoeff : HasSimpleRootExpansion P base coeff)
    (α : ι) (hα : 2 ≤ RelativeRootHeight coeff base.support J α) :
    ∃ β γ, P.root α = P.root β + P.root γ ∧
      RelativeRootHeight coeff base.support J β = 1 := by
  letI := Fintype.ofFinite ι
  obtain ⟨w, hw⟩ := exists_relativeWeylSubgroup_baseHeight_minimal P base J α
  let α' := P.weylGroupToPerm w.1 α
  have hα'Height : RelativeRootHeight coeff base.support J α' =
      RelativeRootHeight coeff base.support J α :=
    relativeWeylSubgroup_relativeRootHeight_eq P base J hJ coeff hCoeff w α
  have hα'Ge : 2 ≤ RelativeRootHeight coeff base.support J α' := by omega
  have hα'Pos : base.IsPos α' :=
    base_isPos_of_relativeRootHeight_pos P base J coeff hCoeff (by omega)
  obtain ⟨δ, hδSupport, hpair⟩ := hα'Pos.exists_mem_support_pos_pairingIn
  have hpair' : 0 < P.pairingIn ℤ α' δ :=
    (P.zero_lt_pairingIn_iff' ℤ).mpr hpair
  have hδNotJ : δ ∉ J := by
    intro hδJ
    let s : RelativeWeylSubgroup P J :=
      ⟨RootPairing.weylGroup.ofIdx P δ,
        Subgroup.subset_closure ⟨δ, hδJ, rfl⟩⟩
    have hmin := hw (s * w)
    have hperm : P.weylGroupToPerm (s * w).1 α = P.reflectionPerm δ α' := by
      change ((RootPairing.Equiv.reflection P δ) *
        (w.1 : RootPairing.Aut P)).indexEquiv α = _
      simp [α']
    change base.height α' ≤ _ at hmin
    rw [hperm] at hmin
    have href : P.root (P.reflectionPerm δ α') =
        P.root α' + (-P.pairingIn ℤ α' δ) • P.root δ := by
      rw [P.root_reflectionPerm, P.reflection_apply_root' ℤ]
      module
    have hheight := base.height_add_zsmul href
    rw [base.height_one_of_mem_support hδSupport] at hheight
    have hheight' : base.height (P.reflectionPerm δ α') =
        base.height α' - P.pairingIn ℤ α' δ := by
      simpa [sub_eq_add_neg] using hheight
    omega
  have hδHeight : RelativeRootHeight coeff base.support J δ = 1 :=
    (relativeRootHeight_eq_one_iff_not_mem P base J coeff hCoeff hδSupport).mpr hδNotJ
  have hα'Neδ : α' ≠ δ := by
    intro h
    rw [h] at hα'Ge
    omega
  obtain ⟨γ, hγ⟩ := P.root_sub_root_mem_of_pairingIn_pos hpair' hα'Neδ
  have hdecomp : P.root α' = P.root δ + P.root γ := by
    rw [hγ]
    module
  let β := P.weylGroupToPerm w.1⁻¹ δ
  let γ' := P.weylGroupToPerm w.1⁻¹ γ
  refine ⟨β, γ', ?_, ?_⟩
  · calc
      P.root α = w.1⁻¹ • (w.1 • P.root α) := by simp
      _ = w.1⁻¹ • P.root α' := by
        rw [P.weylGroup_apply_root]
      _ = w.1⁻¹ • (P.root δ + P.root γ) := congrArg _ hdecomp
      _ = w.1⁻¹ • P.root δ + w.1⁻¹ • P.root γ := smul_add _ _ _
      _ = P.root β + P.root γ' := by
        simpa [β, γ'] using congrArg₂ (· + ·)
          (P.weylGroup_apply_root w.1⁻¹ δ) (P.weylGroup_apply_root w.1⁻¹ γ)
  · exact (relativeWeylSubgroup_relativeRootHeight_eq P base J hJ coeff hCoeff w⁻¹ δ).trans
      hδHeight

end

section

/-- A negative pairing with a simple root outside `J` gives the required
relative-root extension.

This is GLS3, Lemma 1.13.6 (third conjunct, local form). -/
public theorem relativeRootHeight_extension_of_negative_simple_pairing
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (base : P.Base) (J : Set ι) (hJ : J ⊆ base.support)
    (coeff : ι → ι → ℤ) (hCoeff : HasSimpleRootExpansion P base coeff)
    (α : ι) (hα : 1 ≤ RelativeRootHeight coeff base.support J α)
    (w : RelativeWeylSubgroup P J) (δ : ι)
    (hδSupport : δ ∈ base.support) (hδNotJ : δ ∉ J)
    (hpair : P.pairingIn ℤ (P.weylGroupToPerm w.1 α) δ < 0) :
    ∃ β η, P.root η = P.root α + P.root β ∧
      RelativeRootHeight coeff base.support J β = 1 := by
  letI := Fintype.ofFinite ι
  let α' := P.weylGroupToPerm w.1 α
  have hα'Height : RelativeRootHeight coeff base.support J α' =
      RelativeRootHeight coeff base.support J α :=
    relativeWeylSubgroup_relativeRootHeight_eq P base J hJ coeff hCoeff w α
  have hα'Pos : base.IsPos α' :=
    base_isPos_of_relativeRootHeight_pos P base J coeff hCoeff (by omega)
  have hδPos : base.IsPos δ := base.isPos_of_mem_support hδSupport
  have hnotneg : P.root α' ≠ -P.root δ := by
    intro heq
    letI := P.indexNeg
    have hidx : α' = -δ := P.root.injective (by simpa using heq)
    rw [hidx, RootPairing.Base.IsPos.neg_iff_not base] at hα'Pos
    exact hα'Pos hδPos
  obtain ⟨η, hη⟩ := P.root_add_root_mem_of_pairingIn_neg hpair hnotneg
  let β := P.weylGroupToPerm w.1⁻¹ δ
  let η' := P.weylGroupToPerm w.1⁻¹ η
  refine ⟨β, η', ?_, ?_⟩
  · calc
      P.root η' = w.1⁻¹ • P.root η := by
        rw [P.weylGroup_apply_root]
      _ = w.1⁻¹ • (P.root α' + P.root δ) := congrArg _ hη
      _ = w.1⁻¹ • P.root α' + w.1⁻¹ • P.root δ := smul_add _ _ _
      _ = P.root α + P.root β := by
        have hfirst : w.1⁻¹ • P.root (P.weylGroupToPerm w.1 α) = P.root α := by
          calc
            w.1⁻¹ • P.root (P.weylGroupToPerm w.1 α) =
                w.1⁻¹ • (w.1 • P.root α) :=
              congrArg (w.1⁻¹ • ·) (P.weylGroup_apply_root w.1 α).symm
            _ = P.root α := inv_smul_smul w.1 (P.root α)
        have hsecond : w.1⁻¹ • P.root δ = P.root β := by
          simpa [β] using P.weylGroup_apply_root w.1⁻¹ δ
        simpa [α'] using congrArg₂ (· + ·) hfirst hsecond
  · exact (relativeWeylSubgroup_relativeRootHeight_eq P base J hJ coeff hCoeff w⁻¹ δ).trans
      ((relativeRootHeight_eq_one_iff_not_mem P base J coeff hCoeff hδSupport).mpr hδNotJ)

end

section

/-- Every positive relative root below the maximal relative height admits a
height-one root extension.

This is GLS3, Lemma 1.13.6 (third conjunct). -/
public theorem relativeRootHeight_extension_below_max
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced] [P.IsIrreducible]
    (base : P.Base) (J : Set ι) (_hJ : J ⊆ base.support)
    (coeff : ι → ι → ℤ) (hCoeff : HasSimpleRootExpansion P base coeff)
    (a : ℤ)
    (haMax : (∀ α, RelativeRootHeight coeff base.support J α ≤ a) ∧
      ∃ α, RelativeRootHeight coeff base.support J α = a) :
    ∀ α, 1 ≤ RelativeRootHeight coeff base.support J α →
      RelativeRootHeight coeff base.support J α < a →
      ∃ β δ, P.root δ = P.root α + P.root β ∧
        RelativeRootHeight coeff base.support J β = 1 := by
  letI := Fintype.ofFinite ι
  intro α hαheight hαlt
  have hαpos : base.IsPos α :=
    base_isPos_of_relativeRootHeight_pos P base J coeff hCoeff (by omega)
  obtain ⟨γ, l, hl, hγ, hγpos, hγterm⟩ :=
    exists_simpleExtension_terminal P base α hαpos
  obtain ⟨θ, hθheight⟩ := haMax.2
  have hθpos : base.IsPos θ :=
    base_isPos_of_relativeRootHeight_pos P base J coeff hCoeff (by omega)
  obtain ⟨γθ, lθ, hlθ, hγθ, hγθpos, hγθterm⟩ :=
    exists_simpleExtension_terminal P base θ hθpos
  have hγθeq : γθ = γ :=
    terminalPositiveRoot_unique P base γθ γ hγθpos hγpos hγθterm hγterm
  have hsumNonneg :
      0 ≤ (lθ.map (RelativeRootHeight coeff base.support J)).sum := by
    apply List.sum_nonneg
    intro x hx
    obtain ⟨δ, hδl, rfl⟩ := List.mem_map.mp hx
    have hδsupport := hlθ δ hδl
    by_cases hδJ : δ ∈ J
    · rw [(relativeRootHeight_eq_zero_iff_mem P base J coeff hCoeff hδsupport).mpr hδJ]
    · rw [(relativeRootHeight_eq_one_iff_not_mem P base J coeff hCoeff hδsupport).mpr hδJ]
      omega
  have hγheightFormula : RelativeRootHeight coeff base.support J γ =
      a + (lθ.map (RelativeRootHeight coeff base.support J)).sum := by
    rw [← hγθeq, relativeRootHeight_eq_add_list_of_root_eq_add_sum
      P base J coeff hCoeff lθ hγθ, hθheight]
  have hγheight : RelativeRootHeight coeff base.support J γ = a := by
    have hγupper := haMax.1 γ
    omega
  exact positiveRootDifference_exists_relativeHeight_one_add P base J coeff hCoeff
    α γ l (by omega) hl hγ (by omega)

end
end Theory.AlgebraicGroup

