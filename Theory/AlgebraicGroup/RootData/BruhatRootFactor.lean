module

public import Theory.AlgebraicGroup.RootData.Realization
public import Theory.AlgebraicGroup.RootSubgroups.GeneratedSubgroup

universe u

/-! Root-generated factors indexed by Weyl inversion roots. -/

namespace Theory.AlgebraicGroup

section

variable {k : Type u} [Field k]

/-- The roots of `D` corresponding to positive roots sent to negative roots by
a Weyl-group element. -/
public def bruhatInversionRoots
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι X Y : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (base : P.Base) (e : D.Root ≃ ι)
    (w : P.weylGroup) : Set D.Root :=
  {α | base.IsPos (e α) ∧ ¬ base.IsPos (P.weylGroupToPerm w (e α))}

/-- The subgroup generated by the positive root subgroups sent to negative
roots by a Weyl-group element. -/
public def bruhatRootFactor
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι X Y : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (base : P.Base) (e : D.Root ≃ ι)
    (w : P.weylGroup) : Subgroup (Variety.Point K) :=
  RootSubgroupGenerated D (bruhatInversionRoots D P base e w)

@[simp]
public lemma mem_bruhatInversionRoots
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι X Y : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (base : P.Base) (e : D.Root ≃ ι)
    (w : P.weylGroup) (α : D.Root) :
    α ∈ bruhatInversionRoots D P base e w ↔
      base.IsPos (e α) ∧
        ¬ base.IsPos (P.weylGroupToPerm w (e α)) :=
  Iff.rfl

/-- In an actual based root datum, the inversion roots are exactly the chosen
positive roots whose Weyl images are outside the chosen positive system. -/
public lemma mem_bruhatInversionRoots_iff_mem_positiveRoots
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι X Y : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (base : P.Base) (e : D.Root ≃ ι)
    (weightEquiv : Multiplicative X ≃* TorusWeight T)
    (positiveRoots : Set D.Root)
    (hActual : IsActualBasedRootDatum D P base e weightEquiv positiveRoots)
    (w : P.weylGroup) (α : D.Root) :
    α ∈ bruhatInversionRoots D P base e w ↔
      α ∈ positiveRoots ∧
        e.symm (P.weylGroupToPerm w (e α)) ∉ positiveRoots := by
  rw [mem_bruhatInversionRoots, hActual.2.2 α,
    hActual.2.2 (e.symm (P.weylGroupToPerm w (e α)))]
  simp only [Equiv.apply_symm_apply]

/-- The identity Weyl element has no inversion roots. -/
public lemma bruhatInversionRoots_one
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι X Y : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (base : P.Base) (e : D.Root ≃ ι) :
    bruhatInversionRoots D P base e 1 = ∅ := by
  ext α
  simp [bruhatInversionRoots]

/-- The root factor of the identity Weyl element is trivial. -/
public lemma bruhatRootFactor_one
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι X Y : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (base : P.Base) (e : D.Root ≃ ι) :
    bruhatRootFactor D P base e 1 = ⊥ := by
  rw [bruhatRootFactor, bruhatInversionRoots_one,
    RootSubgroupGenerated_empty]

/-- Every selected inversion-root subgroup lies in the corresponding Bruhat
root factor. -/
public lemma rootSubgroup_le_bruhatRootFactor
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι X Y : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (base : P.Base) (e : D.Root ≃ ι)
    (w : P.weylGroup) {α : D.Root}
    (hα : α ∈ bruhatInversionRoots D P base e w) :
    (D.rootSubgroup α).toSubgroup ≤ bruhatRootFactor D P base e w := by
  exact rootSubgroup_le_RootSubgroupGenerated D hα

/-- In an actual based root datum, the Bruhat root factor lies in the subgroup
generated by all positive root subgroups. -/
public lemma bruhatRootFactor_le_rootSubgroupGenerated_positiveRoots
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι X Y : Type*} [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    (P : RootPairing ι ℤ X Y) (base : P.Base) (e : D.Root ≃ ι)
    (weightEquiv : Multiplicative X ≃* TorusWeight T)
    (positiveRoots : Set D.Root)
    (hActual : IsActualBasedRootDatum D P base e weightEquiv positiveRoots)
    (w : P.weylGroup) :
    bruhatRootFactor D P base e w ≤
      RootSubgroupGenerated D positiveRoots := by
  apply RootSubgroupGenerated_mono D
  intro α hα
  exact (mem_bruhatInversionRoots_iff_mem_positiveRoots
    D P base e weightEquiv positiveRoots hActual w α).mp hα |>.1

end

end Theory.AlgebraicGroup
