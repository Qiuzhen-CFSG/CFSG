module

public import Theory.AlgebraicGroup.CoordinateRing.Hopf.PrimitiveCurveNormalIndexPArtinSchreierCore
public import Theory.AlgebraicGroup.CoordinateRing.Hopf.PolynomialArtinSchreierCocycleConsumer

/-!
# Normal index-p primitive Artin--Schreier layers

This module constructs the primitive coordinate attached to a normal index-`p`
layer of the separable fraction-field kernel of a normal Hopf curve.  The
regular certificate first supplies an integral Artin--Schreier generator `s₀`
whose reduced coproduct is a polynomial two-cocycle.  Polynomial cocycle
straightening writes that cocycle as a coboundary and, following Borel's
argument in section 10.9 and the sketch after Corollary 11.6, algebraic
closedness removes the higher `p`-powers while preserving an additive
correction.  Subtracting its evaluation from `s₀` therefore gives a primitive
element `s` satisfying `s^p - s = a * t` with `a ≠ 0`.

The linear equation recovers the original rational-function parameter from
`s`, so the `k`-field generated by `s` is precisely the restriction of the
fixed field.  It also forces every primitive character fixing `s` to fix `t`;
the bijective primitive translation action then embeds the new character
kernel into the prescribed subgroup.  Its cardinal is consequently strictly
smaller.  This is the induction interface for the positive-characteristic
separable-core argument and does not use rationality of arbitrary degree-`p`
extensions.
-/

open scoped TensorProduct

namespace Theory.AlgebraicGroup

noncomputable section

universe u v

set_option linter.style.haveILetI false

variable {k : Type u} {A : Type v} {p : Nat}
variable [Field k] [IsAlgClosed k] [CharP k p] [Fact p.Prime]
variable [CommRing A] [HopfAlgebra k A] [IsDomain A]
variable [Algebra.FiniteType k A] [IsIntegrallyClosed A]

private lemma additiveCoboundary_add_of_additive_right
    (f g : Polynomial k) (hg : IsAdditivePolynomial g) :
    additiveCoboundary (f + g) = additiveCoboundary f := by
  apply Polynomial.ext
  intro n
  apply Polynomial.funext
  intro x
  have hpoly : (additiveCoboundary (f + g)).map (Polynomial.evalRingHom x) =
      (additiveCoboundary f).map (Polynomial.evalRingHom x) := by
    apply Polynomial.funext
    intro y
    rw [Polynomial.map_evalRingHom_eval, Polynomial.map_evalRingHom_eval,
      additiveCoboundary_eval, additiveCoboundary_eval]
    have hxy := (isAdditivePolynomial_iff g).mp hg x y
    simp only [Polynomial.eval_add]
    linear_combination hxy
  have hc := congrArg (fun Q : Polynomial k => Q.coeff n) hpoly
  simpa using hc

/-- A normal index-`p` subgroup of the separable primitive Galois group is the
fixed group of a primitive coordinate whose character kernel is strictly
smaller than that of the original coordinate. -/
public theorem primitive_hopf_curve_normal_index_p_artin_schreier_layer
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
      IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
    let F := separableClosure (RatFunc k) (FractionRing A)
    forall H : Subgroup (F ≃ₐ[RatFunc k] F), H.index = p ->
      exists s : A, exists _hs : Transcendental k s,
        exists hsp : reducedComultiplication (k := k) s = 0,
        exists hsF : algebraMap A (FractionRing A) s ∈ F,
          IntermediateField.adjoin k
              ({(Subtype.mk (algebraMap A (FractionRing A) s) hsF : F)} : Set F) =
            (IntermediateField.fixedField H).restrictScalars k /\
          Nat.card (primitiveCharacterKernel s hsp) <
            Nat.card (primitiveCharacterKernel t hprimitive) := by
  classical
  letI : CharP A p :=
    charP_of_injective_algebraMap
      (FaithfulSMul.algebraMap_injective k A) p
  let K := RatFunc k
  let L := FractionRing A
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra K L := f.toRingHom.toAlgebra
  letI : IsScalarTower k K L :=
    IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
  let F := separableClosure K L
  letI : IsScalarTower k K F :=
    IsScalarTower.of_algebraMap_eq fun x => by
      apply Subtype.ext
      exact IsScalarTower.algebraMap_apply k K L x
  dsimp only
  intro H hH
  obtain ⟨_, _, _, _, sigma, qchar, _, s0, _, hs0F, hqchar, hfixT,
      hsigmaAmbient, hsigmaH, _, hs0E, _, _, hsigma, _, hfinrank, g, C,
      hAS, hC, hnormalized, hsymmetric, hadditive, hCAS, hadjoin, hcard⟩ :=
    primitive_hopf_curve_normal_index_p_artin_schreier_certificate
      (p := p) htrdeg t ht hprimitive H hH
  obtain ⟨h, P, hCh, hP, hPadd⟩ :=
    polynomial_artin_schreier_cocycle_straightening
      hnormalized hsymmetric hadditive hCAS
  obtain ⟨q, a, hqadd, hlinear⟩ :=
    additivePolynomial_congruent_linear_with_additive_correction P hPadd
  let r : Polynomial k := h + q
  let s : A := s0 - Polynomial.aeval t r
  have hrC : additiveCoboundary r = C := by
    rw [show r = h + q by rfl,
      additiveCoboundary_add_of_additive_right h q hqadd, hCh]
  have hsp : reducedComultiplication (k := k) s = 0 := by
    rw [show s = s0 - Polynomial.aeval t r by rfl,
      reducedComultiplication_sub, hC,
      ← bivariateAeval_additiveCoboundary t hprimitive r, hrC, sub_self]
  have haddpow : (h + q) ^ p = h ^ p + q ^ p := by
    simpa only [pow_one] using add_pow_char_pow h q p 1
  have hrLinear : g - (r ^ p - r) = Polynomial.C a * Polynomial.X := by
    rw [show r = h + q by rfl, haddpow, ← hlinear, hP]
    ring
  have hsAS : s ^ p - s = algebraMap k A a * t := by
    have hrEval := congrArg (Polynomial.aeval t) hrLinear
    simp only [map_sub, map_pow, Polynomial.aeval_mul, Polynomial.aeval_C,
      Polynomial.aeval_X] at hrEval
    rw [show s = s0 - Polynomial.aeval t r by rfl, sub_pow_char]
    linear_combination hAS + hrEval
  have hpoly : algebraMap A L (Polynomial.aeval t r) =
      algebraMap K L (algebraMap (Polynomial k) K r) := by
    change algebraMap A L (Polynomial.aeval t r) =
      primitiveFractionMap t ht (algebraMap (Polynomial k) K r)
    rw [show algebraMap (Polynomial k) K r =
        algebraMap (Polynomial k) K r /
          algebraMap (Polynomial k) K 1 by simp,
      primitiveFractionMap_apply_div]
    simp only [map_one, div_one]
    change algebraMap A L (Polynomial.aeval t r) =
      algebraMap A L (Polynomial.aeval t r)
    rfl
  have hsF : algebraMap A L s ∈ F := by
    rw [show algebraMap A L s = algebraMap A L s0 -
        algebraMap A L (Polynomial.aeval t r) by simp [s], hpoly]
    exact F.sub_mem hs0F (F.algebraMap_mem _)
  let sF : F := ⟨algebraMap A L s, hsF⟩
  let s0F : F := ⟨algebraMap A L s0, hs0F⟩
  have hsF_eq : sF = s0F - algebraMap K F (algebraMap (Polynomial k) K r) := by
    apply Subtype.ext
    change algebraMap A L s = algebraMap A L s0 -
      algebraMap K L (algebraMap (Polynomial k) K r)
    rw [show s = s0 - Polynomial.aeval t r by rfl, map_sub, hpoly]
  have hsigma_sF : sigma sF = sF + 1 := by
    calc
      sigma sF = sigma
          (s0F - algebraMap K F (algebraMap (Polynomial k) K r)) :=
        congrArg sigma hsF_eq
      _ = sigma s0F - algebraMap K F (algebraMap (Polynomial k) K r) := by
        rw [map_sub, sigma.commutes]
      _ = (s0F - algebraMap K F (algebraMap (Polynomial k) K r)) + 1 := by
        rw [hsigma]
        ring
      _ = sF + 1 := by rw [← hsF_eq]
  have hsFtrans : Transcendental k sF := by
    intro hsFalg
    have hmonic : (minpoly k sF).leadingCoeff = 1 :=
      minpoly.monic hsFalg.isIntegral
    have hdegree : (minpoly k sF).degree = 1 :=
      IsAlgClosed.degree_eq_one_of_irreducible k
        (minpoly.irreducible hsFalg.isIntegral)
    have heval : Polynomial.aeval sF (minpoly k sF) = 0 :=
      minpoly.aeval k sF
    rw [Polynomial.eq_X_add_C_of_degree_eq_one hdegree, hmonic,
      Polynomial.C_1, one_mul, Polynomial.aeval_add, Polynomial.aeval_X,
      Polynomial.aeval_C, add_eq_zero_iff_eq_neg] at heval
    let c : k := -(minpoly k sF).coeff 0
    have hc : algebraMap k F c = sF := by
      exact (map_neg (algebraMap k F) ((minpoly k sF).coeff 0)).symm ▸
        heval.symm
    have hfix : sigma sF = sF := by
      rw [← hc]
      rw [IsScalarTower.algebraMap_apply k K F]
      exact sigma.commutes (algebraMap k K c)
    have hone : (1 : F) = 0 := by
      apply add_left_cancel (a := sF)
      simpa using hsigma_sF.symm.trans hfix
    exact one_ne_zero hone
  have hs : Transcendental k s := by
    apply (transcendental_algebraMap_iff
      (FaithfulSMul.algebraMap_injective A L)).mp
    intro hsLalg
    apply hsFtrans
    apply (isAlgebraic_algHom_iff
      (F.val.restrictScalars k) Subtype.val_injective).mp
    change IsAlgebraic k (algebraMap A L s)
    exact hsLalg
  have ha : a ≠ 0 := by
    intro ha0
    apply hs
    refine ⟨Polynomial.X ^ p - Polynomial.X, ?_, ?_⟩
    · intro hzero
      have hcoeff := congrArg (fun Q : Polynomial k => Q.coeff p) hzero
      have hpne : 1 ≠ p := (Fact.out : p.Prime).one_lt.ne
      simp [Polynomial.coeff_X, hpne] at hcoeff
    · simpa [ha0] using hsAS
  have hX : algebraMap K L (RatFunc.X : K) = algebraMap A L t := by
    change primitiveFractionMap t ht (RatFunc.X : K) = algebraMap A L t
    rw [show (RatFunc.X : K) =
        algebraMap (Polynomial k) K Polynomial.X /
          algebraMap (Polynomial k) K 1 by
            rw [map_one, div_one]
            exact RatFunc.algebraMap_X.symm,
      primitiveFractionMap_apply_div]
    simp only [Polynomial.aeval_X, map_one, div_one]
    change algebraMap A L t = algebraMap A L t
    rfl
  have htF : algebraMap A L t ∈ F := by
    rw [← hX]
    exact F.algebraMap_mem (RatFunc.X : K)
  let tF : F := ⟨algebraMap A L t, htF⟩
  have htF_eq : tF = algebraMap K F (RatFunc.X : K) := by
    apply Subtype.ext
    exact hX.symm
  have hsAS_F : sF ^ p - sF = algebraMap k F a * tF := by
    apply Subtype.ext
    change (algebraMap A L s) ^ p - algebraMap A L s =
      ((algebraMap k F a : F) : L) * algebraMap A L t
    rw [show ((algebraMap k F a : F) : L) =
        algebraMap A L (algebraMap k A a) by
      calc
        ((algebraMap k F a : F) : L) = algebraMap k L a :=
          (F.val.restrictScalars k).commutes a
        _ = algebraMap A L (algebraMap k A a) :=
          (IsScalarTower.algebraMap_apply k A L a).symm]
    simpa only [map_sub, map_pow, map_mul] using
      congrArg (algebraMap A L) hsAS
  let E := IntermediateField.adjoin k ({sF} : Set F)
  have htE : tF ∈ E := by
    have hca : algebraMap k F a ≠ 0 := by
      intro hzero
      apply ha
      exact (algebraMap k F).injective (hzero.trans (map_zero _).symm)
    rw [show tF = (algebraMap k F a)⁻¹ * (sF ^ p - sF) by
      calc
        tF = 1 * tF := (one_mul tF).symm
        _ = ((algebraMap k F a)⁻¹ * algebraMap k F a) * tF := by
          rw [inv_mul_cancel₀ hca]
        _ = (algebraMap k F a)⁻¹ * (algebraMap k F a * tF) :=
          mul_assoc _ _ _
        _ = (algebraMap k F a)⁻¹ * (sF ^ p - sF) := by rw [hsAS_F]]
    exact E.mul_mem (E.inv_mem (E.algebraMap_mem a))
      (E.sub_mem (E.pow_mem
        (IntermediateField.subset_adjoin k {sF} (Set.mem_singleton sF)) p)
        (IntermediateField.subset_adjoin k {sF} (Set.mem_singleton sF)))
  have hpolyE (Q : Polynomial k) : Polynomial.aeval tF Q ∈ E := by
    have hsub : Algebra.adjoin k ({tF} : Set F) ≤ E.toSubalgebra :=
      Algebra.adjoin_le fun z hz => by
        simp only [Set.mem_singleton_iff] at hz
        subst z
        exact htE
    exact hsub (Polynomial.aeval_mem_adjoin_singleton k tF)
  have hmapPoly (Q : Polynomial k) :
      algebraMap K F (algebraMap (Polynomial k) K Q) =
        Polynomial.aeval tF Q := by
    calc
      algebraMap K F (algebraMap (Polynomial k) K Q) =
          algebraMap K F (Polynomial.aeval (RatFunc.X : K) Q) := by
        rw [RatFunc.aeval_X_left_eq_algebraMap]
      _ = Polynomial.aeval (algebraMap K F (RatFunc.X : K)) Q := by
        exact (Polynomial.aeval_algHom_apply
          (IsScalarTower.toAlgHom k K F) (RatFunc.X : K) Q).symm
      _ = Polynomial.aeval tF Q := by rw [htF_eq]
  have hbase : (⊥ : IntermediateField K F).restrictScalars k ≤ E := by
    intro x hx
    obtain ⟨xK, hxK⟩ := hx
    rw [← hxK]
    induction xK using RatFunc.induction_on with
    | f num den hden =>
        change algebraMap K F
          (algebraMap (Polynomial k) K num /
            algebraMap (Polynomial k) K den) ∈ E
        rw [map_div₀, hmapPoly, hmapPoly]
        apply E.div_mem
        · exact hpolyE num
        · exact hpolyE den
  have hadjoinS : IntermediateField.adjoin K ({sF} : Set F) =
      IntermediateField.fixedField H := by
    rw [← hadjoin]
    apply le_antisymm
    · rw [IntermediateField.adjoin_le_iff]
      intro z hz
      simp only [Set.mem_singleton_iff] at hz
      subst z
      rw [hsF_eq]
      exact (IntermediateField.adjoin K ({s0F} : Set F)).sub_mem
        (IntermediateField.subset_adjoin K {s0F} (Set.mem_singleton s0F))
        ((IntermediateField.adjoin K ({s0F} : Set F)).algebraMap_mem _)
    · rw [IntermediateField.adjoin_le_iff]
      intro z hz
      simp only [Set.mem_singleton_iff] at hz
      subst z
      change s0F ∈ IntermediateField.adjoin K ({sF} : Set F)
      rw [show s0F = sF +
          algebraMap K F (algebraMap (Polynomial k) K r) by
        rw [hsF_eq]
        ring]
      exact (IntermediateField.adjoin K ({sF} : Set F)).add_mem
        (IntermediateField.subset_adjoin K {sF} (Set.mem_singleton sF))
        ((IntermediateField.adjoin K ({sF} : Set F)).algebraMap_mem _)
  refine ⟨s, hs, hsp, hsF, ?_, ?_⟩
  · change E = (IntermediateField.fixedField H).restrictScalars k
    rw [← hadjoinS]
    let EK : IntermediateField K F :=
      E.toSubfield.toIntermediateField fun x =>
        hbase ((⊥ : IntermediateField K F).algebraMap_mem x)
    calc
      E = EK.restrictScalars k := rfl
      _ = (IntermediateField.adjoin K ({sF} : Set F)).restrictScalars k := by
        apply congrArg (IntermediateField.restrictScalars k)
        apply le_antisymm
        · intro x hx
          have hxE : x ∈ E := hx
          have hsmall : E ≤
              (IntermediateField.adjoin K ({sF} : Set F)).restrictScalars k := by
            rw [show E = IntermediateField.adjoin k ({sF} : Set F) by rfl,
              IntermediateField.adjoin_le_iff]
            intro y hy
            simp only [Set.mem_singleton_iff] at hy
            subst y
            exact IntermediateField.subset_adjoin K {sF}
              (Set.mem_singleton sF)
          exact hsmall hxE
        · rw [IntermediateField.adjoin_le_iff]
          intro x hx
          simp only [Set.mem_singleton_iff] at hx
          subst x
          exact IntermediateField.subset_adjoin k {sF}
            (Set.mem_singleton sF)
  · let actionT := primitiveSeparableKernelAction t ht hprimitive
    have hactionT : Function.Bijective actionT :=
      primitiveSeparableKernelAction_bijective htrdeg t ht hprimitive
    letI : Module.Finite K F :=
      primitive_hopf_curve_separableClosure_finite htrdeg t ht hprimitive
    let toT (z : primitiveCharacterKernel s hsp) :
        primitiveCharacterKernel t hprimitive :=
      ⟨z.1, (mem_primitiveCharacterKernel t hprimitive z.1).mpr (by
        have hzs := (mem_primitiveCharacterKernel s hsp z.1).mp z.2
        have hzAS := congrArg z.1 hsAS
        simp only [map_sub, map_pow, map_mul] at hzAS
        rw [hzs, zero_pow (Fact.out : p.Prime).ne_zero, sub_self,
          z.1.ofConv.commutes a] at hzAS
        exact (mul_eq_zero.mp hzAS.symm).resolve_left ha)⟩
    have hfixS (z : primitiveCharacterKernel s hsp) :
        actionT (MulOpposite.op (toT z)) sF = sF := by
      apply Subtype.ext
      rw [primitiveSeparableKernelAction_apply,
        primitiveFractionTranslation_algebraMap,
        MulOpposite.unop_op,
        regularCharacterTranslation_apply_of_primitive z.1 s hsp,
        (mem_primitiveCharacterKernel s hsp z.1).mp z.2,
        map_zero, zero_add]
    let toH (z : primitiveCharacterKernel s hsp) : H :=
      ⟨actionT (MulOpposite.op (toT z)), by
        rw [← IntermediateField.fixingSubgroup_fixedField H]
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        have hx' : x ∈ IntermediateField.adjoin K ({sF} : Set F) := by
          rw [hadjoinS]
          exact hx
        have hall :=
          (IntermediateField.forall_mem_adjoin_smul_eq_self_iff
            K (S := ({sF} : Set F))
            (actionT (MulOpposite.op (toT z)))).mpr (by
              intro y hy
              simp only [Set.mem_singleton_iff] at hy
              subst y
              exact hfixS z)
        exact hall x hx'⟩
    have htoH : Function.Injective toH := by
      intro z w hzw
      have hactionEq : actionT (MulOpposite.op (toT z)) =
          actionT (MulOpposite.op (toT w)) := congrArg Subtype.val hzw
      have hopEq := hactionT.1 hactionEq
      have htoTEq : toT z = toT w := MulOpposite.op_injective hopEq
      apply (primitiveCharacterKernel s hsp).subtype_injective
      change z.1 = w.1
      have hval := congrArg
        (fun x : primitiveCharacterKernel t hprimitive => x.1) htoTEq
      change z.1 = w.1 at hval
      exact hval
    calc
      Nat.card (primitiveCharacterKernel s hsp) ≤ Nat.card H :=
        Nat.card_le_card_of_injective toH htoH
      _ < Nat.card (F ≃ₐ[K] F) := hcard
      _ = Nat.card ((primitiveCharacterKernel t hprimitive)ᵐᵒᵖ) :=
        (Nat.card_congr (Equiv.ofBijective actionT hactionT)).symm
      _ = Nat.card (primitiveCharacterKernel t hprimitive) :=
        Nat.card_congr MulOpposite.opEquiv.symm

end

end Theory.AlgebraicGroup
