module

public import Mathlib.Algebra.CharP.Lemmas
public import Mathlib.Algebra.Polynomial.Degree.Lemmas
public import Mathlib.RingTheory.HopfAlgebra.Basic
public import Theory.AlgebraicGroup.CoordinateRing.Hopf.Basic

open scoped TensorProduct

universe u v

/-!
# Ordered conilpotent Hopf curves

This module records the coordinate-Hopf filtration used by the
one-dimensional unitriangular classification. A finite ordered family is
required to have zero augmentation, to generate the algebra, and to have
reduced coproduct in the tensor square of the algebra generated by earlier
members. It also records the elementary positive-characteristic calculation
behind the later elimination argument: every polynomial supported in the
positive `p`-powers is additive.

The definitions formalize the filtration underlying GLS Proposition 1.3.5(c)
and are intended to be instantiated by matrix-entry coordinates of a closed
unitriangular subgroup. `HasOrderedConilpotentGenerators` is a typeclass so
later Hopf-curve modules can request the filtration with an instance binder;
its `out` field is the stable public accessor for the unchanged existential
witness. Elementary zero and subtraction formulas expose the linearity of the
reduced coproduct for later coordinate changes. The curve-normalization and
composition-Bezout steps belong in separate theorem modules; in particular,
this file makes no finite-kernel splitting assumption.
-/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]
variable {A : Type v} [CommRing A] [HopfAlgebra k A]

/-- The reduced coproduct of an element of a Hopf algebra. -/
public def reducedComultiplication (a : A) : A ⊗[k] A :=
  Coalgebra.comul (R := k) a - (a ⊗ₜ[k] (1 : A)) - ((1 : A) ⊗ₜ[k] a)

/-- The subalgebra generated by the entries preceding `i` in an ordered family. -/
public def priorAdjoin {n : ℕ} (x : Fin n → A) (i : Fin n) : Subalgebra k A :=
  Algebra.adjoin k (Set.range (fun j : Fin i.val =>
    x ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩))

/-- A finite ordered augmentation-zero family with triangular reduced coproduct. -/
@[class] public def HasOrderedConilpotentGenerators : Prop :=
  ∃ n : ℕ, ∃ x : Fin n → A,
    Algebra.adjoin k (Set.range x) = ⊤ ∧
    (∀ i : Fin n, Coalgebra.counit (R := k) (x i) = 0) ∧
    (∀ i : Fin n, ∃ w : priorAdjoin (k := k) x i ⊗[k]
        priorAdjoin (k := k) x i,
      Algebra.TensorProduct.map
          (priorAdjoin (k := k) x i).val
          (priorAdjoin (k := k) x i).val w =
        reducedComultiplication (x i))

/-- The ordered generating family and its triangular reduced coproduct data. -/
public theorem HasOrderedConilpotentGenerators.out
    [HasOrderedConilpotentGenerators (k := k) (A := A)] :
    ∃ n : ℕ, ∃ x : Fin n → A,
      Algebra.adjoin k (Set.range x) = ⊤ ∧
      (∀ i : Fin n, Coalgebra.counit (R := k) (x i) = 0) ∧
      (∀ i : Fin n, ∃ w : priorAdjoin (k := k) x i ⊗[k]
          priorAdjoin (k := k) x i,
        Algebra.TensorProduct.map
            (priorAdjoin (k := k) x i).val
            (priorAdjoin (k := k) x i).val w =
          reducedComultiplication (x i)) := by
  exact ‹HasOrderedConilpotentGenerators (k := k) (A := A)›

@[simp]
public lemma reducedComultiplication_zero :
    reducedComultiplication (k := k) (0 : A) = 0 := by
  simp [reducedComultiplication]

/-- Reduced comultiplication commutes with subtraction. -/
public lemma reducedComultiplication_sub (a b : A) :
    reducedComultiplication (k := k) (a - b) =
      reducedComultiplication (k := k) a -
        reducedComultiplication (k := k) b := by
  simp only [reducedComultiplication, map_sub, TensorProduct.sub_tmul,
    TensorProduct.tmul_sub]
  abel

public lemma reducedComultiplication_eq_zero_iff (a : A) :
    reducedComultiplication (k := k) a = 0 ↔
      Coalgebra.comul (R := k) a = a ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] a := by
  constructor
  · intro h
    have h' : Coalgebra.comul (R := k) a - a ⊗ₜ[k] (1 : A) =
        (1 : A) ⊗ₜ[k] a := sub_eq_zero.mp (by
          simpa [reducedComultiplication] using h)
    have h'' := eq_add_of_sub_eq h'
    simpa [add_comm] using h''
  · intro h
    rw [reducedComultiplication, h]
    abel

/-- A polynomial in the `p`-power monomials. -/
public def IsPPolynomial (p : ℕ) (f : Polynomial k) : Prop :=
  ∀ d ∈ f.support, ∃ i : ℕ, d = p ^ i

/-- Characterization of a polynomial supported in the `p`-power monomials. -/
public lemma isPPolynomial_iff (p : ℕ) (f : Polynomial k) :
    IsPPolynomial p f ↔ ∀ d ∈ f.support, ∃ i : ℕ, d = p ^ i :=
  Iff.rfl

/-- An additive polynomial is a `p`-polynomial in positive characteristic. -/
public def IsAdditivePolynomial (f : Polynomial k) : Prop :=
  (∀ x y : k, f.eval (x + y) = f.eval x + f.eval y)

/-- Pointwise characterization of an additive polynomial. -/
public lemma isAdditivePolynomial_iff (f : Polynomial k) :
    IsAdditivePolynomial f ↔ ∀ x y : k, f.eval (x + y) = f.eval x + f.eval y :=
  Iff.rfl

public lemma pPower_isAdditive (p : ℕ) [Fact p.Prime] [CharP k p] (i : ℕ) :
    IsAdditivePolynomial (Polynomial.X ^ (p ^ i) : Polynomial k) := by
  intro x y
  simp only [Polynomial.eval_pow, Polynomial.eval_X]
  exact add_pow_char_pow x y p i

public lemma pPolynomial_isAdditive (p : ℕ) [Fact p.Prime] [CharP k p]
    {f : Polynomial k} (hf : IsPPolynomial p f) :
    IsAdditivePolynomial f := by
  classical
  intro x y
  rw [← Polynomial.sum_C_mul_X_pow_eq f]
  simp only [Polynomial.eval_sum, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_pow, Polynomial.eval_X]
  simp only [Polynomial.sum]
  calc
    _ = ∑ d ∈ f.support, f.coeff d * (x ^ d + y ^ d) := by
      apply Finset.sum_congr rfl
      intro d hd
      obtain ⟨i, hi⟩ := hf d hd
      subst d
      rw [add_pow_char_pow]
    _ = _ := by
      simp only [mul_add, Finset.sum_add_distrib]

end Theory.AlgebraicGroup
