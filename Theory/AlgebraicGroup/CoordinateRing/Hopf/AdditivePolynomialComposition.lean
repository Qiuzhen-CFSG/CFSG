module

public import Mathlib.Algebra.SkewPolynomial.Basic
public import Mathlib.Algebra.CharZero.Infinite
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.FieldTheory.Separable
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Theory.AlgebraicGroup.CoordinateRing.Hopf.ConilpotentCurve

/-!
# Additive-polynomial composition Bezout elimination

This module supplies the polynomial elimination step used in the normalization of
one-dimensional conilpotent Hopf curves.  In prime characteristic, a finite family of
`p`-polynomials with a separable member and common zero locus `{0}` generates `X` under
addition and composition by `p`-polynomials.  In characteristic zero, every nonzero
additive polynomial has degree one.

For the positive-characteristic result, following the classical additive-polynomial
argument, a polynomial `∑ aᵢ X^(p^i)` is represented in the Frobenius Ore ring
`k[T; a ↦ a^p]`.  Multiplication there decodes to composition.  Explicit cancellation
of the leading Ore term gives left division; a least-degree nonzero element in the left
ideal generated by the input family is therefore a common right divisor.  Separability
makes its linear coefficient nonzero, while algebraic closedness and the common-root
hypothesis force that divisor to have degree one.  Normalizing it yields `1` in the Ore
ideal and hence the required composition identity.  This avoids choosing a section of
an arbitrary finite-kernel additive character.

The characteristic-zero proof compares additivity at `(x, x)` with the leading
coefficient after scaling by two.  Characteristic zero makes `2^n = 2` force `n = 1`.

This is the additive-polynomial elimination implicit in GLS Proposition 1.3.5(c),
made explicit here so the later Hopf-curve normalization does not rely on a
finite-kernel splitting assertion.
-/

open scoped Polynomial

@[instance_reducible]
private noncomputable def frobeniusAction
    (k : Type*) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] :
    MulSemiringAction (Multiplicative ℕ) k where
  smul n a := a ^ p ^ n.toAdd
  one_smul a := by
    change a ^ p ^ 0 = a
    simp
  mul_smul m n a := by
    change a ^ p ^ (m.toAdd + n.toAdd) = (a ^ p ^ n.toAdd) ^ p ^ m.toAdd
    rw [← pow_mul]
    congr 1
    rw [pow_add]
    ac_rfl
  smul_zero n := by
    change (0 : k) ^ p ^ n.toAdd = 0
    exact zero_pow (pow_pos (Fact.out : p.Prime).pos _).ne'
  smul_add n a b := add_pow_char_pow a b p n.toAdd
  smul_one n := one_pow _
  smul_mul n a b := mul_pow a b _

namespace Theory.AlgebraicGroup

noncomputable section

universe u
variable {k : Type u} [Field k]
variable (p : ℕ) [Fact p.Prime] [CharP k p]

local instance : MulSemiringAction (Multiplicative ℕ) k := frobeniusAction k p

private noncomputable def decode (F : SkewPolynomial k) : Polynomial k :=
  F.sum fun i a => Polynomial.monomial (p ^ i) a

omit [Fact p.Prime] [CharP k p] in
private lemma decode_monomial (i : ℕ) (a : k) :
    decode p (SkewPolynomial.monomial i a) = Polynomial.monomial (p ^ i) a := by
  exact SkewPolynomial.sum_monomial_index (by simp)

omit [Fact p.Prime] [CharP k p] in
private lemma decode_add (F G : SkewPolynomial k) :
    decode p (F + G) = decode p F + decode p G := by
  exact SkewPolynomial.sum_add_index F G _ (fun _ => by simp) (fun _ _ _ => by simp)

omit [Fact p.Prime] [CharP k p] in
private lemma decode_zero : decode p (0 : SkewPolynomial k) = 0 := by
  simp [decode]

private noncomputable def decodeAddHom : SkewPolynomial k →+ Polynomial k where
  toFun := decode p
  map_zero' := decode_zero p
  map_add' := decode_add p

omit [Fact p.Prime] [CharP k p] in
private lemma decode_sub (F G : SkewPolynomial k) :
    decode p (F - G) = decode p F - decode p G := by
  exact (decodeAddHom p).map_sub F G

private lemma action_apply (i : ℕ) (a : k) :
    (SkewPolynomial.φ^[i]) a = a ^ p ^ i := by
  rw [SkewPolynomial.φ_iterate_apply]
  rfl

private lemma decode_monomial_mul (i : ℕ) (a : k) (G : SkewPolynomial k) :
    decode p (SkewPolynomial.monomial i a * G) =
      (decode p (SkewPolynomial.monomial i a)).comp (decode p G) := by
  induction G using SkewPolynomial.induction with
  | h0 => simp [decode, (Fact.out : p.Prime).ne_zero]
  | ha j b G hj hb ih =>
      rw [mul_add, decode_add, decode_add, ih, decode_monomial,
        Polynomial.monomial_comp]
      simp only [Polynomial.monomial_comp]
      rw [add_pow_char_pow]
      rw [mul_add]
      congr 1
      rw [SkewPolynomial.monomial_mul_monomial, decode_monomial]
      simp only [action_apply]
      rw [decode_monomial, ← Polynomial.C_mul_X_pow_eq_monomial]
      rw [← Polynomial.C_mul_X_pow_eq_monomial]
      simp only [mul_pow, ← Polynomial.C_pow, ← pow_mul]
      rw [← mul_assoc, ← Polynomial.C_mul]
      congr 1
      rw [pow_add]
      ac_rfl

private lemma decode_mul (F G : SkewPolynomial k) :
    decode p (F * G) = (decode p F).comp (decode p G) := by
  induction F using SkewPolynomial.induction with
  | h0 => simp [decode_zero]
  | ha i a F hi ha ih =>
      rw [add_mul, decode_add, decode_add, Polynomial.add_comp,
        decode_monomial_mul, ih]

omit [Fact p.Prime] [CharP k p] in
private lemma decode_one : decode p (1 : SkewPolynomial k) = Polynomial.X := by
  change decode p (SkewPolynomial.monomial 0 1) = Polynomial.X
  rw [decode_monomial]
  simpa using Polynomial.monomial_one_one_eq_X (R := k)

omit [Fact p.Prime] [CharP k p] in
private lemma isPPolynomial_monomial (i : ℕ) (a : k) :
    Theory.AlgebraicGroup.IsPPolynomial p (Polynomial.monomial (p ^ i) a) := by
  rw [Theory.AlgebraicGroup.isPPolynomial_iff]
  intro d hd
  have hda : d = p ^ i := by
    exact Finset.mem_singleton.mp (Polynomial.support_monomial_subset _ _ hd)
  exact ⟨i, hda⟩

omit [Fact p.Prime] [CharP k p] in
private lemma isPPolynomial_add {f g : Polynomial k}
    (hf : Theory.AlgebraicGroup.IsPPolynomial p f)
    (hg : Theory.AlgebraicGroup.IsPPolynomial p g) :
    Theory.AlgebraicGroup.IsPPolynomial p (f + g) := by
  rw [Theory.AlgebraicGroup.isPPolynomial_iff] at hf hg ⊢
  intro d hd
  have hd' : d ∈ f.support ∪ g.support := Polynomial.support_add hd
  rcases Finset.mem_union.mp hd' with hdf | hdg
  · exact hf d hdf
  · exact hg d hdg

omit [Fact p.Prime] [CharP k p] in
private lemma decode_isPPolynomial (F : SkewPolynomial k) :
    Theory.AlgebraicGroup.IsPPolynomial p (decode p F) := by
  induction F using SkewPolynomial.induction with
  | h0 =>
      rw [decode_zero, Theory.AlgebraicGroup.isPPolynomial_iff]
      simp
  | ha i a F hi ha ih =>
      rw [decode_add, decode_monomial]
      exact isPPolynomial_add (p := p) (isPPolynomial_monomial p i a) ih

omit [CharP k p] in
private lemma decode_coeff (F : SkewPolynomial k) (i : ℕ) :
    (decode p F).coeff (p ^ i) = F.coeff i := by
  classical
  rw [decode, SkewPolynomial.sum_def, Polynomial.finsetSum_coeff]
  by_cases hi : i ∈ F.support
  · rw [Finset.sum_eq_single i]
    · simp
    · intro j hj hji
      have hpji : p ^ j ≠ p ^ i := fun e =>
        hji ((Nat.pow_right_injective (Fact.out : p.Prime).two_le) e)
      simp [Polynomial.coeff_monomial, hpji]
    · simp [hi]
  · rw [SkewPolynomial.notMem_support_iff.mp hi]
    apply Finset.sum_eq_zero
    intro j hj
    have hji : j ≠ i := fun e => hi (e ▸ hj)
    have hpji : p ^ j ≠ p ^ i := fun e =>
      hji ((Nat.pow_right_injective (Fact.out : p.Prime).two_le) e)
    simp [Polynomial.coeff_monomial, hpji]

omit [CharP k p] in
private lemma decode_injective : Function.Injective (decode (k := k) p) := by
  intro F G h
  apply SkewPolynomial.ext
  intro i
  rw [← decode_coeff p F i, ← decode_coeff p G i, h]

omit [CharP k p] in
private lemma decode_ne_zero {F : SkewPolynomial k} (hF : F ≠ 0) : decode p F ≠ 0 := by
  exact fun h => hF (decode_injective p (h.trans (decode_zero p).symm))

private noncomputable def encode {f : Polynomial k}
    (hf : Theory.AlgebraicGroup.IsPPolynomial p f) : SkewPolynomial k :=
  ∑ d ∈ f.support.attach,
    SkewPolynomial.monomial
      (Classical.choose ((Theory.AlgebraicGroup.isPPolynomial_iff p f).mp hf d.1 d.2))
      (f.coeff d.1)

omit [Fact p.Prime] [CharP k p] in
private lemma decode_finset_sum {ι : Type*} (s : Finset ι) (F : ι → SkewPolynomial k) :
    decode p (∑ i ∈ s, F i) = ∑ i ∈ s, decode p (F i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [decode_zero]
  | @insert a s ha ih => simp [ha, decode_add, ih]

omit [Fact p.Prime] [CharP k p] in
private lemma decode_encode {f : Polynomial k}
    (hf : Theory.AlgebraicGroup.IsPPolynomial p f) : decode p (encode p hf) = f := by
  classical
  have hpow (d : f.support) :
      p ^ Classical.choose
        ((Theory.AlgebraicGroup.isPPolynomial_iff p f).mp hf d.1 d.2) = d.1 :=
    (Classical.choose_spec
      ((Theory.AlgebraicGroup.isPPolynomial_iff p f).mp hf d.1 d.2)).symm
  rw [encode, decode_finset_sum]
  simp_rw [decode_monomial, hpow]
  exact (Finset.sum_attach f.support
    (fun n => Polynomial.monomial n (f.coeff n))).trans f.as_sum_support.symm

omit [CharP k p] in
private lemma isPPolynomial_eval_zero {f : Polynomial k}
    (hf : Theory.AlgebraicGroup.IsPPolynomial p f) : f.eval 0 = 0 := by
  change f.eval₂ (RingHom.id k) 0 = 0
  rw [Polynomial.eval₂_at_zero]
  simp only [RingHom.id_apply]
  by_contra h
  have hmem : 0 ∈ f.support := Polynomial.mem_support_iff.mpr h
  obtain ⟨i, hi⟩ :=
    (Theory.AlgebraicGroup.isPPolynomial_iff p f).mp hf 0 hmem
  have hpos : 0 < p ^ i := pow_pos (Fact.out : p.Prime).pos _
  omega

omit [Fact p.Prime] [CharP k p] in
private lemma pPolynomial_natDegree_eq_pow {f : Polynomial k}
    (hf : Theory.AlgebraicGroup.IsPPolynomial p f) (hne : f ≠ 0) :
    ∃ i : ℕ, f.natDegree = p ^ i :=
  (Theory.AlgebraicGroup.isPPolynomial_iff p f).mp hf _
    (Polynomial.natDegree_mem_support_of_nonzero hne)

/-- The leading-term cancellation step in the Frobenius Ore ring. -/
private lemma exists_left_remainder_natDegree_lt (A B : SkewPolynomial k)
    (hA : A ≠ 0) (hB : B ≠ 0)
    (hdeg : (decode p B).natDegree ≤ (decode p A).natDegree) :
    ∃ Q : SkewPolynomial k,
      (decode p (A - Q * B)).natDegree < (decode p A).natDegree := by
  let a := decode p A
  let b := decode p B
  have ha : a ≠ 0 := decode_ne_zero p hA
  have hb : b ≠ 0 := decode_ne_zero p hB
  obtain ⟨ia, hia⟩ := pPolynomial_natDegree_eq_pow p (decode_isPPolynomial p A) ha
  obtain ⟨ib, hib⟩ := pPolynomial_natDegree_eq_pow p (decode_isPPolynomial p B) hb
  have hibia : ib ≤ ia := by
    rw [hib, hia] at hdeg
    exact (Nat.pow_le_pow_iff_right (Fact.out : p.Prime).one_lt).mp hdeg
  let c : k := a.leadingCoeff / b.leadingCoeff ^ (p ^ (ia - ib))
  have hc : c ≠ 0 := by
    exact div_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr ha)
      (pow_ne_zero _ (Polynomial.leadingCoeff_ne_zero.mpr hb))
  let Q : SkewPolynomial k := SkewPolynomial.monomial (ia - ib) c
  have hbdeg : b.natDegree ≠ 0 := by
    rw [hib]
    exact (pow_pos (Fact.out : p.Prime).pos _).ne'
  have hQBdeg : (decode p (Q * B)).natDegree = a.natDegree := by
    rw [decode_mul]
    dsimp only [Q]
    rw [decode_monomial, Polynomial.natDegree_comp,
      Polynomial.natDegree_monomial_eq _ hc, hia, hib, ← pow_add,
      Nat.sub_add_cancel hibia]
  have hQB0 : decode p (Q * B) ≠ 0 := by
    intro hzero
    rw [hzero] at hQBdeg
    simp only [Polynomial.natDegree_zero] at hQBdeg
    exact (pow_pos (Fact.out : p.Prime).pos ia).ne (hQBdeg.trans hia)
  have hQBlead : (decode p (Q * B)).leadingCoeff = a.leadingCoeff := by
    rw [decode_mul]
    dsimp only [Q]
    rw [decode_monomial, Polynomial.leadingCoeff_comp hbdeg,
      Polynomial.natDegree_monomial_eq _ hc]
    simp only [Polynomial.leadingCoeff_monomial, c]
    exact div_mul_cancel₀ _ (pow_ne_zero _ (Polynomial.leadingCoeff_ne_zero.mpr hb))
  have hQBdegree : a.degree = (decode p (Q * B)).degree := by
    rw [Polynomial.degree_eq_natDegree ha, Polynomial.degree_eq_natDegree hQB0,
      hQBdeg]
  refine ⟨Q, ?_⟩
  rw [decode_sub]
  have hdegree := Polynomial.degree_sub_lt_left hQBdegree ha hQBlead.symm
  by_cases hrem : a - decode p (Q * B) = 0
  · rw [hrem, Polynomial.natDegree_zero, hia]
    exact pow_pos (Fact.out : p.Prime).pos _
  · exact Polynomial.natDegree_lt_natDegree hrem hdegree

private lemma derivative_eval_zero_eq_coeff_one (f : Polynomial k) :
    f.derivative.eval 0 = f.coeff 1 := by
  change f.derivative.eval₂ (RingHom.id k) 0 = f.coeff 1
  rw [Polynomial.eval₂_at_zero]
  rw [Polynomial.coeff_derivative]
  simp

private lemma coeff_one_comp (f g : Polynomial k) (hg0 : g.eval 0 = 0) :
    (f.comp g).coeff 1 = f.coeff 1 * g.coeff 1 := by
  rw [← derivative_eval_zero_eq_coeff_one]
  rw [Polynomial.derivative_comp, Polynomial.eval_mul, Polynomial.eval_comp, hg0,
    derivative_eval_zero_eq_coeff_one, derivative_eval_zero_eq_coeff_one]
  exact mul_comm _ _

private lemma coeff_one_ne_zero_of_separable {f : Polynomial k}
    (hsep : f.Separable) (hf0 : f.eval 0 = 0) : f.coeff 1 ≠ 0 := by
  have hderiv := hsep.eval₂_derivative_ne_zero (RingHom.id k)
    (show f.eval₂ (RingHom.id k) 0 = 0 from hf0)
  simpa only [Polynomial.eval₂_id, derivative_eval_zero_eq_coeff_one] using hderiv

private lemma natDegree_eq_one_of_unique_root {f : Polynomial k} [IsAlgClosed k]
    (hf0 : f.eval 0 = 0) (hroots : ∀ x : k, f.eval x = 0 → x = 0)
    (hcoeff : f.coeff 1 ≠ 0) : f.natDegree = 1 := by
  have hmem : 1 ∈ f.support := Polynomial.mem_support_iff.mpr hcoeff
  have hone_le : 1 ≤ f.natDegree := Polynomial.le_natDegree_of_mem_supp 1 hmem
  apply le_antisymm _ hone_le
  by_contra hnot
  have hgt : 1 < f.natDegree := by omega
  have hdivpos : 0 < f.divX.natDegree := by
    rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]
    omega
  have hdivdegree : f.divX.degree ≠ 0 :=
    ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp hdivpos)
  obtain ⟨x, hx⟩ := IsAlgClosed.exists_root f.divX hdivdegree
  have hfcoeff0 : f.coeff 0 = 0 := by
    change f.eval₂ (RingHom.id k) 0 = 0 at hf0
    rw [Polynomial.eval₂_at_zero] at hf0
    simpa using hf0
  have hfactor : Polynomial.X * f.divX = f := by
    simpa [hfcoeff0] using Polynomial.X_mul_divX_add f
  have hfx : f.eval x = 0 := by
    rw [← hfactor, Polynomial.eval_mul, hx.eq_zero, mul_zero]
  have hx0 : x = 0 := hroots x hfx
  have hdivzero : f.divX.eval 0 = 0 := by simpa [hx0] using hx.eq_zero
  have hdivcoeff : f.divX.eval 0 = f.coeff 1 := by
    change f.divX.eval₂ (RingHom.id k) 0 = f.coeff 1
    rw [Polynomial.eval₂_at_zero, Polynomial.coeff_divX]
    simp
  exact hcoeff (hdivcoeff ▸ hdivzero)

private lemma minimal_left_ideal_generator_dvd
    (L : Submodule (SkewPolynomial k) (SkewPolynomial k))
    (H : SkewPolynomial k) (hHL : H ∈ L) (hHne : H ≠ 0)
    (hminimal : ∀ {A : SkewPolynomial k}, A ∈ L → A ≠ 0 →
      (decode p H).natDegree ≤ (decode p A).natDegree)
    (A : SkewPolynomial k) (hAL : A ∈ L) :
    ∃ Q : SkewPolynomial k, A = Q * H := by
  generalize hn : (decode p A).natDegree = n
  induction n using Nat.strong_induction_on generalizing A with
  | h n ih =>
      by_cases hAne : A = 0
      · exact ⟨0, by simp [hAne]⟩
      · obtain ⟨Q, hremdeg⟩ := exists_left_remainder_natDegree_lt p A H
          hAne hHne (hminimal hAL hAne)
        have hQHmem : Q * H ∈ L := by
          simpa only [smul_eq_mul] using L.smul_mem Q hHL
        have hremmem : A - Q * H ∈ L := L.sub_mem hAL hQHmem
        have hremdeg' : (decode p (A - Q * H)).natDegree < n := by
          simpa only [hn] using hremdeg
        obtain ⟨S, hS⟩ := ih _ hremdeg' (A - Q * H) hremmem rfl
        refine ⟨Q + S, ?_⟩
        calc
          A = Q * H + (A - Q * H) := by abel
          _ = Q * H + S * H := by rw [hS]
          _ = (Q + S) * H := (add_mul Q S H).symm

/-- Composition Bezout elimination for a finite family of `p`-polynomials. -/
public theorem pPolynomial_composition_bezout {ι : Type*} [Fintype ι] [IsAlgClosed k]
    (f : ι → Polynomial k)
    (hf : ∀ i, Theory.AlgebraicGroup.IsPPolynomial p (f i))
    (hseparable : ∃ i, (f i).Separable)
    (hzero : ∀ x : k, (∀ i, (f i).eval x = 0) ↔ x = 0) :
    ∃ g : ι → Polynomial k,
      (∀ i, Theory.AlgebraicGroup.IsPPolynomial p (g i)) ∧
      ∑ i, (g i).comp (f i) = Polynomial.X := by
  classical
  let F : ι → SkewPolynomial k := fun i => encode p (hf i)
  let L : Submodule (SkewPolynomial k) (SkewPolynomial k) :=
    Submodule.span (SkewPolynomial k) (Set.range F)
  have hFmem (i : ι) : F i ∈ L :=
    Submodule.subset_span (Set.mem_range_self i)
  have hFdecode (i : ι) : decode p (F i) = f i := by
    dsimp only [F]
    exact decode_encode p (hf i)
  obtain ⟨j, hjsep⟩ := hseparable
  have hFjne : F j ≠ 0 := by
    intro h
    apply hjsep.ne_zero
    rw [← hFdecode j, h, decode_zero]
  let P : ℕ → Prop := fun n =>
    ∃ A : SkewPolynomial k, A ∈ L ∧ A ≠ 0 ∧ (decode p A).natDegree = n
  have hP : ∃ n, P n :=
    ⟨(decode p (F j)).natDegree, F j, hFmem j, hFjne, rfl⟩
  obtain ⟨H, hHL, hHne, hHdegree⟩ := Nat.find_spec hP
  have hminimal {A : SkewPolynomial k} (hAL : A ∈ L) (hAne : A ≠ 0) :
      (decode p H).natDegree ≤ (decode p A).natDegree := by
    rw [hHdegree]
    exact Nat.find_min' hP ⟨A, hAL, hAne, rfl⟩
  have hdiv (i : ι) : ∃ Q : SkewPolynomial k, F i = Q * H :=
    minimal_left_ideal_generator_dvd p L H hHL hHne hminimal (F i) (hFmem i)
  have hHpoly0 : (decode p H).eval 0 = 0 :=
    isPPolynomial_eval_zero p (decode_isPPolynomial p H)
  have hHroots : ∀ x : k, (decode p H).eval x = 0 → x = 0 := by
    intro x hx
    apply (hzero x).mp
    intro i
    obtain ⟨Q, hQi⟩ := hdiv i
    have hfi : f i = (decode p Q).comp (decode p H) := by
      rw [← hFdecode i, hQi, decode_mul]
    rw [hfi, Polynomial.eval_comp, hx]
    exact isPPolynomial_eval_zero p (decode_isPPolynomial p Q)
  have hjcoeff : (f j).coeff 1 ≠ 0 :=
    coeff_one_ne_zero_of_separable hjsep (isPPolynomial_eval_zero p (hf j))
  obtain ⟨Qj, hQj⟩ := hdiv j
  have hfj : f j = (decode p Qj).comp (decode p H) := by
    rw [← hFdecode j, hQj, decode_mul]
  have hHcoeff : (decode p H).coeff 1 ≠ 0 := by
    intro hcoeff
    apply hjcoeff
    rw [hfj, coeff_one_comp _ _ hHpoly0, hcoeff, mul_zero]
  have hHnatDegree : (decode p H).natDegree = 1 :=
    natDegree_eq_one_of_unique_root hHpoly0 hHroots hHcoeff
  have hHcoeff0 : (decode p H).coeff 0 = 0 := by
    change (decode p H).eval₂ (RingHom.id k) 0 = 0 at hHpoly0
    rw [Polynomial.eval₂_at_zero] at hHpoly0
    simpa using hHpoly0
  have hHlinear :
      decode p H = Polynomial.C ((decode p H).coeff 1) * Polynomial.X := by
    rw [Polynomial.eq_X_add_C_of_natDegree_le_one hHnatDegree.le, hHcoeff0]
    simp
  let a : k := (decode p H).coeff 1
  have ha : a ≠ 0 := hHcoeff
  have hHlinear' : decode p H = Polynomial.C a * Polynomial.X := hHlinear
  let U : SkewPolynomial k :=
    SkewPolynomial.monomial 0 a⁻¹ * H
  have hUdecode : decode p U = Polynomial.X := by
    calc
      decode p U =
          (Polynomial.monomial 1 a⁻¹).comp (decode p H) := by
        rw [decode_mul, decode_monomial, pow_zero]
      _ = (Polynomial.C a⁻¹ * Polynomial.X).comp
          (decode p H) := by rw [Polynomial.C_mul_X_eq_monomial]
      _ = Polynomial.C a⁻¹ * decode p H := by simp
      _ = Polynomial.C a⁻¹ * (Polynomial.C a * Polynomial.X) := by rw [hHlinear']
      _ = Polynomial.X := by
        rw [← mul_assoc, ← Polynomial.C_mul]
        simp [ha]
  have hUone : U = 1 :=
    decode_injective p (hUdecode.trans (decode_one p).symm)
  have hUmem : U ∈ L := by
    dsimp only [U]
    simpa only [smul_eq_mul] using
      L.smul_mem (SkewPolynomial.monomial 0 a⁻¹) hHL
  have hone : (1 : SkewPolynomial k) ∈ L := hUone ▸ hUmem
  obtain ⟨c, hc⟩ :=
    (Submodule.mem_span_range_iff_exists_fun (SkewPolynomial k)).mp hone
  have hsum : ∑ i, c i * F i = (1 : SkewPolynomial k) := by
    simpa only [smul_eq_mul] using hc
  refine ⟨fun i => decode p (c i), fun i => decode_isPPolynomial p (c i), ?_⟩
  calc
    ∑ i, (decode p (c i)).comp (f i) = ∑ i, decode p (c i * F i) := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [decode_mul, decode_encode]
    _ = decode p (∑ i, c i * F i) :=
      (_root_.map_sum (decodeAddHom p) (fun i => c i * F i) Finset.univ).symm
    _ = decode p 1 := by rw [hsum]
    _ = Polynomial.X := decode_one p

end

section CharZero

variable {K : Type*} [Field K] [CharZero K]

omit [CharZero K] in
private lemma additivePolynomial_eval_zero {f : Polynomial K}
    (hf : Theory.AlgebraicGroup.IsAdditivePolynomial f) : f.eval 0 = 0 := by
  have h := (Theory.AlgebraicGroup.isAdditivePolynomial_iff f).mp hf 0 0
  have h' := congrArg (fun z : K => z - f.eval 0) h
  simpa using h'.symm

private lemma additivePolynomial_scale_two {f : Polynomial K}
    (hf : Theory.AlgebraicGroup.IsAdditivePolynomial f) :
    f.comp (Polynomial.C (2 : K) * Polynomial.X) = Polynomial.C 2 * f := by
  apply Polynomial.funext
  intro x
  have h := (Theory.AlgebraicGroup.isAdditivePolynomial_iff f).mp hf x x
  simpa [two_mul] using h

/-- A nonzero additive polynomial over a characteristic-zero field has degree one. -/
public theorem additivePolynomial_natDegree_eq_one {f : Polynomial K}
    (hf : Theory.AlgebraicGroup.IsAdditivePolynomial f) (hne : f ≠ 0) :
    f.natDegree = 1 := by
  have hf0 := additivePolynomial_eval_zero hf
  have hfcoeff0 : f.coeff 0 = 0 := by
    change f.eval₂ (RingHom.id K) 0 = 0 at hf0
    rw [Polynomial.eval₂_at_zero] at hf0
    simpa using hf0
  have hdegreepos : 0 < f.natDegree := by
    by_contra h
    have hdegreezero : f.natDegree = 0 := Nat.eq_zero_of_not_pos h
    apply hne
    rw [Polynomial.eq_C_of_natDegree_eq_zero hdegreezero, hfcoeff0]
    simp
  let q : Polynomial K := Polynomial.C (2 : K) * Polynomial.X
  have htwo : (2 : K) ≠ 0 := by norm_num
  have hqdegree : q.natDegree = 1 := Polynomial.natDegree_C_mul_X _ htwo
  have hscale := additivePolynomial_scale_two hf
  have hcoeff := congrArg (fun r : Polynomial K => r.coeff f.natDegree) hscale
  have hleft : (f.comp q).coeff f.natDegree =
      f.leadingCoeff * (2 : K) ^ f.natDegree := by
    have h := Polynomial.coeff_comp_degree_mul_degree (p := f) (q := q)
      (by rw [hqdegree]; exact one_ne_zero)
    simp [q, hqdegree] at h ⊢
  rw [hleft, Polynomial.coeff_C_mul, Polynomial.coeff_natDegree] at hcoeff
  have hpow : (2 : K) ^ f.natDegree = 2 := by
    apply mul_left_cancel₀ (Polynomial.leadingCoeff_ne_zero.mpr hne)
    simpa [mul_comm] using hcoeff
  have hpowNat : 2 ^ f.natDegree = (2 : ℕ) := by exact_mod_cast hpow
  apply Nat.pow_right_injective (by omega : 2 ≤ 2)
  change 2 ^ f.natDegree = 2 ^ 1
  rw [pow_one]
  exact hpowNat

end CharZero
end Theory.AlgebraicGroup
