module

public import Mathlib.FieldTheory.PurelyInseparable.Basic
public import Mathlib.FieldTheory.RatFunc.AsPolynomial
public import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
public import Theory.AlgebraicGroup.CoordinateRing.Hopf.PrimitiveCurveFractionMap

/-!
# The zero fibre of a primitive Hopf curve

For a normal affine Hopf curve and a transcendental primitive coordinate `t`,
this module identifies the `k`-valued zero fibre of `t` with the embeddings of
the finite function-field extension generated by `t`.  A field embedding is
restricted to the coordinate ring and convolved with the antipode of the
canonical inclusion.  Primitivity makes this difference vanish on `t`.
Finiteness over `k[t]` then makes every value integral over `k`, so algebraic
closedness brings the difference back to a unique `k`-valued character.

Conversely, such a character acts by Hopf translation.  The translation
extends to the fraction field and fixes `RatFunc k`; the two explicit antipode
cancellation identities show that the constructions are inverse.  The fibre
cardinal is therefore the finite separable degree, and the separable-closure
tower converts that degree to the requested finrank.

This is the constant-fibre/separable-degree form of AG 18.2 at the Hopf
coordinate-ring layer.  It uses only the finite primitive fraction map and
Hopf translations, with no rationality or affine-line classification theorem.
-/

open scoped TensorProduct

universe u v

namespace Theory.AlgebraicGroup

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

variable {k : Type u} {A : Type v}
variable [Field k] [IsAlgClosed k] [CommRing A] [HopfAlgebra k A]
variable [IsDomain A] [Algebra.FiniteType k A] [IsIntegrallyClosed A]

private noncomputable def translation (q : WithConv (A →ₐ[k] k)) : A →ₐ[k] A :=
  (WithConv.toConv ((Algebra.ofId k A).comp q.ofConv) *
    WithConv.toConv (AlgHom.id k A)).ofConv

private lemma translation_mul (q r : WithConv (A →ₐ[k] k)) :
    (translation q).comp (translation r) = translation (r * q) := by
  have hscalar :
      (WithConv.toConv ((Algebra.ofId k A).comp q.ofConv) *
          WithConv.toConv (AlgHom.id k A)).ofConv.comp
          ((Algebra.ofId k A).comp r.ofConv) =
        (Algebra.ofId k A).comp r.ofConv := by
    ext x
    simp
  have hid :
      (WithConv.toConv ((Algebra.ofId k A).comp q.ofConv) *
          WithConv.toConv (AlgHom.id k A)).ofConv.comp (AlgHom.id k A) =
        (WithConv.toConv ((Algebra.ofId k A).comp q.ofConv) *
          WithConv.toConv (AlgHom.id k A)).ofConv := by
    rfl
  simp only [translation, AlgHom.comp_convMul_distrib, WithConv.toConv_ofConv]
  rw [hscalar, hid]
  simp only [WithConv.toConv_ofConv, mul_assoc]

private lemma translation_one :
    translation (1 : WithConv (A →ₐ[k] k)) = AlgHom.id k A := by
  have hscalar :
      WithConv.toConv ((Algebra.ofId k A).comp
          (1 : WithConv (A →ₐ[k] k)).ofConv) =
        (1 : WithConv (A →ₐ[k] A)) := by
    apply WithConv.ofConv_injective
    ext x
    simp
  rw [translation, hscalar, one_mul]

private noncomputable def translationEquiv
    (q : WithConv (A →ₐ[k] k)) : A ≃ₐ[k] A :=
  AlgEquiv.ofAlgHom (translation q) (translation q⁻¹)
    (by rw [translation_mul]; simp [translation_one])
    (by rw [translation_mul]; simp [translation_one])

private lemma translation_apply_of_primitive
    (q : WithConv (A →ₐ[k] k)) (t : A)
    (ht : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t) :
    translation q t = algebraMap k A (q t) + t := by
  rw [translation, AlgHom.convMul_apply, ht]
  simp

private noncomputable def fractionTranslationEquiv
    (q : WithConv (A →ₐ[k] k)) : FractionRing A ≃ₐ[k] FractionRing A :=
  IsFractionRing.algEquivOfAlgEquiv (translationEquiv q)

private lemma fractionTranslationEquiv_algebraMap
    (q : WithConv (A →ₐ[k] k)) (a : A) :
    fractionTranslationEquiv q (algebraMap A (FractionRing A) a) =
      algebraMap A (FractionRing A) (translation q a) := by
  simp [fractionTranslationEquiv, translationEquiv]

private lemma fractionTranslationEquiv_primitiveFractionMap
    (q : WithConv (A →ₐ[k] k)) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (hqt : q t = 0) (x : RatFunc k) :
    fractionTranslationEquiv q (primitiveFractionMap t ht x) =
      primitiveFractionMap t ht x := by
  have hcomul : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t :=
    (reducedComultiplication_eq_zero_iff (k := k) t).mp hprimitive
  have hpoly (f : Polynomial k) :
      fractionTranslationEquiv q
          (primitiveFractionMap t ht
            (algebraMap (Polynomial k) (RatFunc k) f)) =
        primitiveFractionMap t ht
          (algebraMap (Polynomial k) (RatFunc k) f) := by
    rw [show algebraMap (Polynomial k) (RatFunc k) f =
      algebraMap (Polynomial k) (RatFunc k) f /
        algebraMap (Polynomial k) (RatFunc k) 1 by simp]
    rw [primitiveFractionMap_apply_div]
    simp only [map_one, div_one]
    rw [fractionTranslationEquiv_algebraMap]
    rw [show translation q (Polynomial.aeval t f) =
        Polynomial.aeval (algebraMap k A (q t) + t) f by
      rw [← Polynomial.aeval_algHom_apply (translation q) t f,
        translation_apply_of_primitive q t hcomul]]
    simp [hqt]
  rw [← x.num_div_denom, map_div₀, map_div₀]
  rw [hpoly, hpoly]

private noncomputable def fractionTranslationOverPrimitive
    (q : WithConv (A →ₐ[k] k)) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (hqt : q t = 0) :
    letI : Algebra (RatFunc k) (FractionRing A) :=
      (primitiveFractionMap t ht).toRingHom.toAlgebra
    FractionRing A ≃ₐ[RatFunc k] FractionRing A := by
  letI : Algebra (RatFunc k) (FractionRing A) :=
    (primitiveFractionMap t ht).toRingHom.toAlgebra
  exact AlgEquiv.ofRingEquiv (f := (fractionTranslationEquiv q).toRingEquiv)
    fun x => by
      rw [RingHom.algebraMap_toAlgebra]
      exact fractionTranslationEquiv_primitiveFractionMap
        q t ht hprimitive hqt x

private lemma character_mul_apply_of_primitive
    {B : Type*} [CommRing B] [Algebra k B]
    (q r : WithConv (A →ₐ[k] B)) (t : A)
    (ht : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t) :
    (q * r) t = q t + r t := by
  rw [AlgHom.convMul_apply, ht]
  simp

private lemma character_one_apply_of_primitive
    {B : Type*} [CommRing B] [Algebra k B]
    (t : A) (ht : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t) :
    (1 : WithConv (A →ₐ[k] B)) t = 0 := by
  have h := character_mul_apply_of_primitive
    (1 : WithConv (A →ₐ[k] B)) 1 t ht
  rw [one_mul] at h
  apply add_left_cancel (a := (1 : WithConv (A →ₐ[k] B)) t)
  simpa using h.symm

private lemma antipode_apply_of_primitive
    (t : A)
    (ht : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t) :
    HopfAlgebra.antipode k t = -t := by
  have h := character_mul_apply_of_primitive
    (WithConv.toConv (AlgHom.id k A))
    (WithConv.toConv (HopfAlgebra.antipodeAlgHom k A)) t ht
  have hcancel :
      WithConv.toConv (AlgHom.id k A) *
          WithConv.toConv (HopfAlgebra.antipodeAlgHom k A) = 1 := by
    change WithConv.toConv (AlgHom.id k A) *
        (WithConv.toConv (AlgHom.id k A))⁻¹ = 1
    simp
  rw [hcancel, character_one_apply_of_primitive t ht] at h
  symm at h
  change t + HopfAlgebra.antipode k t = 0 at h
  exact eq_neg_of_add_eq_zero_right h

private lemma primitiveFractionMap_X
    (t : A) (ht : Transcendental k t) :
    primitiveFractionMap t ht (RatFunc.X : RatFunc k) =
      algebraMap A (FractionRing A) t := by
  rw [show (RatFunc.X : RatFunc k) =
      algebraMap (Polynomial k) (RatFunc k) Polynomial.X /
        algebraMap (Polynomial k) (RatFunc k) 1 by simp]
  rw [primitiveFractionMap_apply_div]
  simp

section Embeddings

variable (t : A) (ht : Transcendental k t)

variable [Algebra (RatFunc k) (FractionRing A)]
variable [IsScalarTower k (RatFunc k) (FractionRing A)]
variable (hf : algebraMap (RatFunc k) (FractionRing A) = primitiveFractionMap t ht)

private noncomputable def canonicalFractionEmbedding :
    A →ₐ[k] AlgebraicClosure (FractionRing A) :=
  (IsScalarTower.toAlgHom k (FractionRing A) _).comp
    (IsScalarTower.toAlgHom k A (FractionRing A))

private noncomputable def canonicalAntipodeEmbedding :
    A →ₐ[k] AlgebraicClosure (FractionRing A) :=
  canonicalFractionEmbedding.comp (HopfAlgebra.antipodeAlgHom k A)

private lemma canonicalAntipodeEmbedding_mul_canonicalFractionEmbedding :
    WithConv.toConv (canonicalAntipodeEmbedding (k := k) (A := A)) *
        WithConv.toConv (canonicalFractionEmbedding (k := k) (A := A)) = 1 := by
  apply WithConv.ofConv_injective
  simp only [canonicalAntipodeEmbedding]
  change (WithConv.toConv
      ((canonicalFractionEmbedding (k := k) (A := A)).comp
        (HopfAlgebra.antipodeAlgHom k A)) *
      WithConv.toConv
        ((canonicalFractionEmbedding (k := k) (A := A)).comp
          (AlgHom.id k A))).ofConv = _
  rw [← AlgHom.comp_convMul_distrib
      (canonicalFractionEmbedding (k := k) (A := A)),
    AlgHom.antipode_id_cancel]
  ext a
  simp

private lemma canonicalFractionEmbedding_mul_canonicalAntipodeEmbedding :
    WithConv.toConv (canonicalFractionEmbedding (k := k) (A := A)) *
        WithConv.toConv (canonicalAntipodeEmbedding (k := k) (A := A)) = 1 := by
  have hcancel :
      WithConv.toConv (AlgHom.id k A) *
          WithConv.toConv (HopfAlgebra.antipodeAlgHom k A) = 1 := by
    change WithConv.toConv (AlgHom.id k A) *
        (WithConv.toConv (AlgHom.id k A))⁻¹ = 1
    simp
  apply WithConv.ofConv_injective
  simp only [canonicalAntipodeEmbedding]
  change (WithConv.toConv
      ((canonicalFractionEmbedding (k := k) (A := A)).comp
        (AlgHom.id k A)) *
      WithConv.toConv
        ((canonicalFractionEmbedding (k := k) (A := A)).comp
          (HopfAlgebra.antipodeAlgHom k A))).ofConv = _
  rw [← AlgHom.comp_convMul_distrib
      (canonicalFractionEmbedding (k := k) (A := A)), hcancel]
  ext a
  simp

private noncomputable def embeddingRestrict
    (phi : Field.Emb (RatFunc k) (FractionRing A)) :
    A →ₐ[k] AlgebraicClosure (FractionRing A) :=
  (phi.restrictScalars k).comp (IsScalarTower.toAlgHom k A (FractionRing A))

private noncomputable def embeddingDifference
    (phi : Field.Emb (RatFunc k) (FractionRing A)) :
  WithConv (A →ₐ[k] AlgebraicClosure (FractionRing A)) :=
  WithConv.toConv (embeddingRestrict phi) *
    WithConv.toConv canonicalAntipodeEmbedding

include ht hf in
private lemma embeddingRestrict_primitive
    (phi : Field.Emb (RatFunc k) (FractionRing A)) :
    embeddingRestrict (k := k) (A := A) phi t =
      canonicalFractionEmbedding (k := k) (A := A) t := by
  calc
    embeddingRestrict (k := k) (A := A) phi t =
        phi (algebraMap A (FractionRing A) t) := rfl
    _ = phi (primitiveFractionMap t ht (RatFunc.X : RatFunc k)) := by
      rw [primitiveFractionMap_X]
    _ = phi (algebraMap (RatFunc k) (FractionRing A) RatFunc.X) :=
      congrArg phi
        (congrArg (fun g : RatFunc k →+* FractionRing A => g RatFunc.X) hf).symm
    _ = algebraMap (RatFunc k) (AlgebraicClosure (FractionRing A)) RatFunc.X :=
      phi.commutes RatFunc.X
    _ = algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))
        (primitiveFractionMap t ht RatFunc.X) := by
      rw [IsScalarTower.algebraMap_apply (RatFunc k) (FractionRing A)
        (AlgebraicClosure (FractionRing A)), hf]
      rfl
    _ = canonicalFractionEmbedding (k := k) (A := A) t := by
      rw [primitiveFractionMap_X]
      rfl

include ht hf in
private lemma embeddingDifference_primitive
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (phi : Field.Emb (RatFunc k) (FractionRing A)) :
    embeddingDifference phi t = 0 := by
  have hcomul : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t :=
    (reducedComultiplication_eq_zero_iff (k := k) t).mp hprimitive
  rw [embeddingDifference, character_mul_apply_of_primitive _ _ t hcomul]
  change embeddingRestrict (k := k) (A := A) phi t +
      canonicalFractionEmbedding (k := k) (A := A)
        (HopfAlgebra.antipode k t) = 0
  rw [antipode_apply_of_primitive t hcomul, map_neg,
    embeddingRestrict_primitive t ht hf phi, add_neg_cancel]

include ht hf in
private lemma embeddingDifference_isIntegral
    (htrdeg : Algebra.trdeg k A = 1)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (phi : Field.Emb (RatFunc k) (FractionRing A)) (a : A) :
    IsIntegral k (embeddingDifference phi a) := by
  letI : Algebra (Polynomial k) A := (Polynomial.aeval t).toRingHom.toAlgebra
  have hfinite : Module.Finite (Polynomial k) A :=
    primitive_hopf_curve_aeval_finite htrdeg t ht hprimitive
  letI : Module.Finite (Polynomial k) A := hfinite
  apply IsIntegral.map_of_comp_eq (Polynomial.evalRingHom 0)
    (embeddingDifference phi).ofConv.toRingHom
  · apply Polynomial.ringHom_ext
    · intro x
      simp [RingHom.algebraMap_toAlgebra]
    · simpa [RingHom.algebraMap_toAlgebra] using
        (embeddingDifference_primitive t ht hf hprimitive phi).symm
  · exact IsIntegral.of_finite (Polynomial k) a

include ht hf in
private noncomputable def embeddingDifferenceIntegral
    (htrdeg : Algebra.trdeg k A = 1)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (phi : Field.Emb (RatFunc k) (FractionRing A)) :
    A →ₐ[k] integralClosure k (AlgebraicClosure (FractionRing A)) :=
  (embeddingDifference phi).ofConv.codRestrict _
    (embeddingDifference_isIntegral t ht hf htrdeg hprimitive phi)

private noncomputable def baseIntegralClosureEquiv :
    k ≃ₐ[k] integralClosure k (AlgebraicClosure (FractionRing A)) :=
  AlgEquiv.ofBijective (Algebra.ofId k _)
    IsAlgClosed.algebraMap_bijective_of_isIntegral

include ht hf in
private noncomputable def embeddingToZeroFibre
    (htrdeg : Algebra.trdeg k A = 1)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (phi : Field.Emb (RatFunc k) (FractionRing A)) :
    {q : A →ₐ[k] k // q t = 0} := by
  let q : A →ₐ[k] k :=
    (baseIntegralClosureEquiv (k := k) (A := A)).symm.toAlgHom.comp
    (embeddingDifferenceIntegral t ht hf htrdeg hprimitive phi)
  refine ⟨q, ?_⟩
  change (baseIntegralClosureEquiv (k := k) (A := A)).symm
      (embeddingDifferenceIntegral t ht hf htrdeg hprimitive phi t) = 0
  apply (baseIntegralClosureEquiv (k := k) (A := A)).injective
  rw [AlgEquiv.apply_symm_apply, map_zero]
  apply Subtype.ext
  exact embeddingDifference_primitive t ht hf hprimitive phi

include ht hf in
private lemma embeddingToZeroFibre_algebraMap
    (htrdeg : Algebra.trdeg k A = 1)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (phi : Field.Emb (RatFunc k) (FractionRing A)) (a : A) :
    algebraMap k (AlgebraicClosure (FractionRing A))
        ((embeddingToZeroFibre t ht hf htrdeg hprimitive phi).1 a) =
      embeddingDifference phi a := by
  change algebraMap k (AlgebraicClosure (FractionRing A))
      ((baseIntegralClosureEquiv (k := k) (A := A)).symm
        (embeddingDifferenceIntegral t ht hf htrdeg hprimitive phi a)) = _
  calc
    _ = ((baseIntegralClosureEquiv (k := k) (A := A)
          ((baseIntegralClosureEquiv (k := k) (A := A)).symm
            (embeddingDifferenceIntegral t ht hf htrdeg hprimitive phi a))) :
        AlgebraicClosure (FractionRing A)) := rfl
    _ = embeddingDifferenceIntegral t ht hf htrdeg hprimitive phi a :=
      congrArg Subtype.val
        ((baseIntegralClosureEquiv (k := k) (A := A)).apply_symm_apply _)
    _ = embeddingDifference phi a := rfl

include ht hf in
private noncomputable def zeroFibreToEmbedding
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (q : {q : A →ₐ[k] k // q t = 0}) :
    Field.Emb (RatFunc k) (FractionRing A) := by
  let e : FractionRing A ≃ₐ[RatFunc k] FractionRing A :=
    AlgEquiv.ofRingEquiv
      (f := (fractionTranslationEquiv (WithConv.toConv q.1)).toRingEquiv) fun x => by
        rw [hf]
        exact fractionTranslationEquiv_primitiveFractionMap
          (WithConv.toConv q.1) t ht hprimitive q.2 x
  exact (IsScalarTower.toAlgHom (RatFunc k) (FractionRing A)
    (AlgebraicClosure (FractionRing A))).comp e.toAlgHom

include ht hf in
private lemma embeddingRestrict_zeroFibreToEmbedding
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (q : {q : A →ₐ[k] k // q t = 0}) :
    WithConv.toConv (embeddingRestrict
      (zeroFibreToEmbedding t ht hf hprimitive q)) =
      WithConv.toConv ((Algebra.ofId k _).comp q.1) *
        WithConv.toConv canonicalFractionEmbedding := by
  calc
    WithConv.toConv (embeddingRestrict
        (zeroFibreToEmbedding t ht hf hprimitive q)) =
        WithConv.toConv (canonicalFractionEmbedding.comp
          (translation (WithConv.toConv q.1))) := by
      apply WithConv.ofConv_injective
      ext a
      change algebraMap (FractionRing A) (AlgebraicClosure (FractionRing A))
          (fractionTranslationEquiv (WithConv.toConv q.1)
            (algebraMap A (FractionRing A) a)) = _
      rw [fractionTranslationEquiv_algebraMap]
      rfl
    _ = _ := by
      apply WithConv.ofConv_injective
      rw [translation, AlgHom.comp_convMul_distrib canonicalFractionEmbedding]
      rfl

include ht hf in
private lemma zeroFibreToEmbedding_embeddingToZeroFibre
    (htrdeg : Algebra.trdeg k A = 1)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (phi : Field.Emb (RatFunc k) (FractionRing A)) :
    zeroFibreToEmbedding t ht hf hprimitive
        (embeddingToZeroFibre t ht hf htrdeg hprimitive phi) = phi := by
  apply AlgHom.coe_ringHom_injective
  apply IsFractionRing.ringHom_ext (A := A)
  intro a
  have hq : WithConv.toConv
      ((Algebra.ofId k (AlgebraicClosure (FractionRing A))).comp
        (embeddingToZeroFibre t ht hf htrdeg hprimitive phi).1) =
      embeddingDifference phi := by
    apply WithConv.ofConv_injective
    ext x
    exact embeddingToZeroFibre_algebraMap t ht hf htrdeg hprimitive phi x
  have hrestr := embeddingRestrict_zeroFibreToEmbedding
    t ht hf hprimitive (embeddingToZeroFibre t ht hf htrdeg hprimitive phi)
  rw [hq] at hrestr
  have hcancel :
      WithConv.toConv (embeddingRestrict
        (zeroFibreToEmbedding t ht hf hprimitive
          (embeddingToZeroFibre t ht hf htrdeg hprimitive phi))) =
        WithConv.toConv (embeddingRestrict phi) := by
    rw [hrestr, embeddingDifference, mul_assoc,
      canonicalAntipodeEmbedding_mul_canonicalFractionEmbedding, mul_one]
  exact congrArg (fun z => z.ofConv a) hcancel

include ht hf in
private lemma embeddingToZeroFibre_zeroFibreToEmbedding
    (htrdeg : Algebra.trdeg k A = 1)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (q : {q : A →ₐ[k] k // q t = 0}) :
    embeddingToZeroFibre t ht hf htrdeg hprimitive
        (zeroFibreToEmbedding t ht hf hprimitive q) = q := by
  apply Subtype.ext
  ext a
  apply (algebraMap k (AlgebraicClosure (FractionRing A))).injective
  rw [embeddingToZeroFibre_algebraMap]
  have hrestr := embeddingRestrict_zeroFibreToEmbedding t ht hf hprimitive q
  rw [embeddingDifference, hrestr]
  rw [mul_assoc, canonicalFractionEmbedding_mul_canonicalAntipodeEmbedding,
    mul_one]
  rfl

include ht hf in
private noncomputable def zeroFibreEquivEmbedding
    (htrdeg : Algebra.trdeg k A = 1)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    {q : A →ₐ[k] k // q t = 0} ≃
      Field.Emb (RatFunc k) (FractionRing A) where
  toFun := zeroFibreToEmbedding t ht hf hprimitive
  invFun := embeddingToZeroFibre t ht hf htrdeg hprimitive
  left_inv := embeddingToZeroFibre_zeroFibreToEmbedding t ht hf htrdeg hprimitive
  right_inv := zeroFibreToEmbedding_embeddingToZeroFibre t ht hf htrdeg hprimitive

end Embeddings

/-- The number of `k`-valued characters in the zero fibre of a transcendental
primitive coordinate equals the degree of the separable part of its finite
function-field extension. -/
public theorem primitive_hopf_curve_zero_fibre_card_eq_separable_finrank
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
      IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
    Nat.card {q : A →ₐ[k] k // q t = 0} =
      Module.finrank (RatFunc k)
        (separableClosure (RatFunc k) (FractionRing A)) := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
  have hfinite : Module.Finite (RatFunc k) (FractionRing A) := by
    simpa [AlgHom.Finite, RingHom.Finite] using
      primitive_hopf_curve_fraction_map_finite htrdeg t ht hprimitive
  letI : Module.Finite (RatFunc k) (FractionRing A) := hfinite
  have hsep : Field.finSepDegree (RatFunc k) (FractionRing A) =
      Module.finrank (RatFunc k)
        (separableClosure (RatFunc k) (FractionRing A)) := by
    haveI : Module.Finite (RatFunc k)
        (separableClosure (RatFunc k) (FractionRing A)) :=
      Module.Finite.of_injective
        (separableClosure (RatFunc k) (FractionRing A)).val.toLinearMap
        Subtype.val_injective
    haveI : Module.Finite
        (separableClosure (RatFunc k) (FractionRing A)) (FractionRing A) :=
      Module.Finite.of_restrictScalars_finite (RatFunc k)
        (separableClosure (RatFunc k) (FractionRing A)) (FractionRing A)
    have htower := Field.finSepDegree_mul_finSepDegree_of_isAlgebraic
      (RatFunc k) (separableClosure (RatFunc k) (FractionRing A))
      (FractionRing A)
    rw [Field.finSepDegree_eq_finrank_of_isSeparable,
      IsPurelyInseparable.finSepDegree_eq_one, mul_one] at htower
    exact htower.symm
  calc
    Nat.card {q : A →ₐ[k] k // q t = 0} =
        Nat.card (Field.Emb (RatFunc k) (FractionRing A)) :=
      Nat.card_congr (zeroFibreEquivEmbedding t ht rfl htrdeg hprimitive)
    _ = Field.finSepDegree (RatFunc k) (FractionRing A) := rfl
    _ = _ := hsep

end Theory.AlgebraicGroup
