module

public import Mathlib.FieldTheory.Galois.Basic
import Mathlib.FieldTheory.PurelyInseparable.Basic
import Mathlib.LinearAlgebra.FreeModule.Finite.Matrix
import Mathlib.RingTheory.Finiteness.Quotient
import Mathlib.RingTheory.Polynomial.Quotient
public import Theory.AlgebraicGroup.CoordinateRing.Hopf.PrimitiveCurveCharacterPPrimaryCharP
public import Theory.AlgebraicGroup.CoordinateRing.Hopf.PrimitiveCurveZeroFibreSeparableDegree

/-!
# The separable kernel of a primitive Hopf curve in positive characteristic

For a normal affine Hopf curve with transcendence degree one and a
transcendental primitive coordinate `t`, this module identifies the separable
part of the finite extension generated by `t`.  Characters vanishing at `t`
act by Hopf translation.  These translations extend to the fraction field,
fix the embedded `RatFunc k`, and hence restrict to its separable closure.  The
opposite character group records the reversal between convolution product and
composition of translations.

The underlying coordinate-ring action is exposed as
`regularCharacterTranslation` for arbitrary characters.  Its public
specifications record the reversed composition order, translation of a
primitive coordinate by the character value, counit evaluation, and agreement
with `primitiveFractionTranslation` on coordinate-ring elements.

The proof has three main inputs.  First, finiteness over `k[t]` makes the zero
fibre finite: the counit identifies the polynomial comap of `(t)` with `(X)`,
so `A/(t)` is finite-dimensional over `k`.  Second, the zero-fibre cardinal
theorem identifies the order of the character kernel with the degree of the
separable closure.  Pure inseparability of the ambient fraction field over
that closure makes restriction faithful; the general automorphism-cardinality
bound then makes the action bijective and proves the extension Galois.  Third,
the p-primary character theorem transfers the `p`-group property through this
action.  The final evaluation theorem retains the character translation on
the ambient fraction field, as needed for normal Artin--Schreier layers.

This is the function-field kernel step in Borel 10.9 and the sketch following
11.6.  It uses the finite primitive fraction map and direct Hopf translation
algebra, not the parent rationality theorem or an affine-line classification.
-/

open scoped TensorProduct

universe u v

namespace Theory.AlgebraicGroup

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

variable {k : Type u} {A : Type v}
variable [Field k] [IsAlgClosed k] [CommRing A] [HopfAlgebra k A]

private lemma character_mul_apply_of_primitive
    (q r : WithConv (A →ₐ[k] k)) (t : A)
    (ht : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t) :
    (q * r) t = q t + r t := by
  rw [AlgHom.convMul_apply, ht]
  simp

private lemma character_one_apply_of_primitive
    (t : A) (ht : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t) :
    (1 : WithConv (A →ₐ[k] k)) t = 0 := by
  have h := character_mul_apply_of_primitive
    (1 : WithConv (A →ₐ[k] k)) 1 t ht
  rw [one_mul] at h
  apply add_left_cancel (a := (1 : WithConv (A →ₐ[k] k)) t)
  simpa using h.symm

/-- Characters whose primitive coordinate is zero. -/
public def primitiveCharacterKernel
    (t : A) (hprimitive : reducedComultiplication (k := k) t = 0) :
    Subgroup (WithConv (A →ₐ[k] k)) where
  carrier := {q | q t = 0}
  one_mem' := character_one_apply_of_primitive t
    ((reducedComultiplication_eq_zero_iff (k := k) t).mp hprimitive)
  mul_mem' := by
    intro q r hq hr
    rw [Set.mem_ofPred_eq,
      character_mul_apply_of_primitive q r t
        ((reducedComultiplication_eq_zero_iff (k := k) t).mp hprimitive),
      hq, hr, add_zero]
  inv_mem' := by
    intro q hq
    change q t = 0 at hq
    change q⁻¹ t = 0
    have hone : (1 : WithConv (A →ₐ[k] k)) t = 0 :=
      character_one_apply_of_primitive t
        ((reducedComultiplication_eq_zero_iff (k := k) t).mp hprimitive)
    have h := character_mul_apply_of_primitive q⁻¹ q t
      ((reducedComultiplication_eq_zero_iff (k := k) t).mp hprimitive)
    have hgroup : q⁻¹ * q = 1 := by simp
    rw [hgroup, hone, hq, add_zero] at h
    exact h.symm

@[simp]
public theorem mem_primitiveCharacterKernel
    (t : A) (hprimitive : reducedComultiplication (k := k) t = 0)
    (q : WithConv (A →ₐ[k] k)) :
    q ∈ primitiveCharacterKernel t hprimitive ↔ q t = 0 :=
  Iff.rfl

variable [IsDomain A] [Algebra.FiniteType k A]

private lemma polynomial_comap_span_primitive_eq_span_X
    (t : A) (hprimitive : reducedComultiplication (k := k) t = 0) :
    letI : Algebra (Polynomial k) A :=
      (Polynomial.aeval t).toRingHom.toAlgebra
    (Ideal.span ({t} : Set A)).comap (algebraMap (Polynomial k) A) =
      Ideal.span ({Polynomial.X} : Set (Polynomial k)) := by
  letI : Algebra (Polynomial k) A :=
    (Polynomial.aeval t).toRingHom.toAlgebra
  apply le_antisymm
  · intro f hf
    rw [Ideal.mem_comap] at hf
    have hcounit : Bialgebra.counitAlgHom k A t = 0 := by
      simpa using character_one_apply_of_primitive t
        ((reducedComultiplication_eq_zero_iff (k := k) t).mp hprimitive)
    have hcoeff : f.coeff 0 = 0 := by
      have hle : Ideal.span ({t} : Set A) ≤
          RingHom.ker (Bialgebra.counitAlgHom k A) := by
        rw [Ideal.span_le]
        intro x hx
        obtain rfl := Set.mem_singleton_iff.mp hx
        simpa [RingHom.mem_ker] using hcounit
      have hkill : Bialgebra.counitAlgHom k A
          ((algebraMap (Polynomial k) A) f) = 0 :=
        RingHom.mem_ker.mp (hle hf)
      simpa [RingHom.algebraMap_toAlgebra, Polynomial.aeval_def, hcounit] using hkill
    rw [Ideal.mem_span_singleton, Polynomial.X_dvd_iff]
    exact hcoeff
  · rw [Ideal.span_le]
    intro f hf
    obtain rfl := Set.mem_singleton_iff.mp hf
    change (algebraMap (Polynomial k) A) Polynomial.X ∈
      Ideal.span ({t} : Set A)
    rw [RingHom.algebraMap_toAlgebra]
    simp

private lemma zero_fibre_module_finite
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    Module.Finite k (A ⧸ Ideal.span ({t} : Set A)) := by
  let p : Ideal (Polynomial k) := Ideal.span ({Polynomial.X} : Set (Polynomial k))
  let P : Ideal A := Ideal.span ({t} : Set A)
  letI : Algebra (Polynomial k) A :=
    (Polynomial.aeval t).toRingHom.toAlgebra
  have hfinite : Module.Finite (Polynomial k) A :=
    primitive_hopf_curve_aeval_finite htrdeg t ht hprimitive
  letI : Module.Finite (Polynomial k) A := hfinite
  have hcomap : P.comap (algebraMap (Polynomial k) A) = p :=
    polynomial_comap_span_primitive_eq_span_X t hprimitive
  letI : P.LiesOver p := ⟨hcomap.symm⟩
  letI : Module.Finite ((Polynomial k) ⧸ p) (A ⧸ P) := inferInstance
  have hpfinite : Module.Finite k ((Polynomial k) ⧸ p) := by
    change Module.Finite k
      ((Polynomial k) ⧸ Ideal.span ({Polynomial.X} : Set (Polynomial k)))
    rw [show Ideal.span ({Polynomial.X} : Set (Polynomial k)) =
        Ideal.span ({Polynomial.X - Polynomial.C 0} : Set (Polynomial k)) by simp]
    exact Module.Finite.equiv (M := k)
      (Polynomial.quotientSpanXSubCAlgEquiv (R := k) 0).symm.toLinearEquiv
  letI : Module.Finite k ((Polynomial k) ⧸ p) := hpfinite
  exact Module.Finite.trans ((Polynomial k) ⧸ p) (A ⧸ P)

private noncomputable def primitiveCharacterKernelToZeroFibre
    (t : A) (hprimitive : reducedComultiplication (k := k) t = 0) :
    primitiveCharacterKernel t hprimitive →
      (A ⧸ Ideal.span ({t} : Set A)) →ₐ[k] k := fun q ↦
  Ideal.Quotient.liftₐ (Ideal.span ({t} : Set A)) q.1.1 <| by
    intro a ha
    have hle : Ideal.span ({t} : Set A) ≤ RingHom.ker q.1.1 := by
      rw [Ideal.span_le]
      intro x hx
      obtain rfl := Set.mem_singleton_iff.mp hx
      exact q.2
    exact RingHom.mem_ker.mp (hle ha)

private lemma primitiveCharacterKernelToZeroFibre_injective
    (t : A) (hprimitive : reducedComultiplication (k := k) t = 0) :
    Function.Injective (primitiveCharacterKernelToZeroFibre t hprimitive) := by
  intro q r hqr
  apply Subtype.ext
  apply WithConv.ofConv_injective
  have h := congrArg
    (fun z : (A ⧸ Ideal.span ({t} : Set A)) →ₐ[k] k ↦
      z.comp (Ideal.Quotient.mkₐ k (Ideal.span ({t} : Set A)))) hqr
  simpa only [primitiveCharacterKernelToZeroFibre,
    Ideal.Quotient.liftₐ_comp] using h

/-- The primitive character kernel is finite. -/
public theorem primitiveCharacterKernel_finite
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    Finite (primitiveCharacterKernel t hprimitive) := by
  letI : Module.Finite k (A ⧸ Ideal.span ({t} : Set A)) :=
    zero_fibre_module_finite htrdeg t ht hprimitive
  exact Finite.of_injective
    (primitiveCharacterKernelToZeroFibre t hprimitive)
    (primitiveCharacterKernelToZeroFibre_injective t hprimitive)

/-- In characteristic `p`, the primitive character kernel is a `p`-group. -/
public theorem primitiveCharacterKernel_isPGroup
    {p : ℕ} [CharP k p] [Fact p.Prime] [IsIntegrallyClosed A]
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    IsPGroup p (primitiveCharacterKernel t hprimitive) :=
  (primitive_hopf_curve_characters_are_pGroup
    (p := p) htrdeg t ht hprimitive).to_subgroup
      (primitiveCharacterKernel t hprimitive)

private noncomputable def translation
    (q : WithConv (A →ₐ[k] k)) : A →ₐ[k] A :=
  (WithConv.toConv ((Algebra.ofId k A).comp q.ofConv) *
    WithConv.toConv (AlgHom.id k A)).ofConv

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
private lemma translation_mul (q r : WithConv (A →ₐ[k] k)) :
    (translation q).comp (translation r) = translation (r * q) := by
  have hscalar :
      (WithConv.toConv ((Algebra.ofId k A).comp q.ofConv) *
          WithConv.toConv (AlgHom.id k A)).ofConv.comp
          ((Algebra.ofId k A).comp r.ofConv) =
        (Algebra.ofId k A).comp r.ofConv := by
    ext x
    simp
  have hid :
      (WithConv.toConv ((Algebra.ofId k A).comp q.ofConv) *
          WithConv.toConv (AlgHom.id k A)).ofConv.comp (AlgHom.id k A) =
        (WithConv.toConv ((Algebra.ofId k A).comp q.ofConv) *
          WithConv.toConv (AlgHom.id k A)).ofConv := rfl
  simp only [translation, AlgHom.comp_convMul_distrib, WithConv.toConv_ofConv]
  rw [hscalar, hid]
  simp only [WithConv.toConv_ofConv, mul_assoc]

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
private lemma translation_one :
    translation (1 : WithConv (A →ₐ[k] k)) = AlgHom.id k A := by
  have hscalar :
      WithConv.toConv ((Algebra.ofId k A).comp
          (1 : WithConv (A →ₐ[k] k)).ofConv) =
        (1 : WithConv (A →ₐ[k] A)) := by
    apply WithConv.ofConv_injective
    ext x
    simp
  rw [translation, hscalar, one_mul]

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
private noncomputable def translationEquiv
    (q : WithConv (A →ₐ[k] k)) : A ≃ₐ[k] A :=
  AlgEquiv.ofAlgHom (translation q) (translation q⁻¹)
    (by rw [translation_mul]; simp [translation_one])
    (by rw [translation_mul]; simp [translation_one])

/-- The regular coordinate-ring translation attached to a Hopf character. -/
public noncomputable def regularCharacterTranslation
    (q : WithConv (A →ₐ[k] k)) : A ≃ₐ[k] A :=
  translationEquiv q

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
/-- Character convolution acts in the reverse order under regular translation. -/
public theorem regularCharacterTranslation_mul
    (q r : WithConv (A →ₐ[k] k)) :
    regularCharacterTranslation (q * r) =
      regularCharacterTranslation r * regularCharacterTranslation q := by
  apply AlgEquiv.ext
  intro a
  simp only [regularCharacterTranslation]
  change translation (q * r) a = translation r (translation q a)
  exact (DFunLike.congr_fun (translation_mul r q) a).symm

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
private lemma translation_apply_of_primitive
    (q : WithConv (A →ₐ[k] k)) (t : A)
    (ht : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t) :
    translation q t = algebraMap k A (q t) + t := by
  rw [translation, AlgHom.convMul_apply, ht]
  simp

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
/-- A character translates a primitive coordinate by its value there. -/
public theorem regularCharacterTranslation_apply_of_primitive
    (q : WithConv (A →ₐ[k] k)) (t : A)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    regularCharacterTranslation q t = algebraMap k A (q t) + t := by
  exact translation_apply_of_primitive q t
    ((reducedComultiplication_eq_zero_iff (k := k) t).mp hprimitive)

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
private lemma translation_aeval_of_primitive
    (q : WithConv (A →ₐ[k] k)) (t : A)
    (ht : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t)
    (f : Polynomial k) :
    translation q (Polynomial.aeval t f) =
      Polynomial.aeval (algebraMap k A (q t) + t) f := by
  rw [← Polynomial.aeval_algHom_apply (translation q) t f,
    translation_apply_of_primitive q t ht]

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
private lemma translation_apply_repr
    (q : WithConv (A →ₐ[k] k)) (a : A) {ι : Type*}
    (r : Coalgebra.Repr k a ι) :
    translation q a =
      ∑ i ∈ r.index, q (r.left i) • r.right i := by
  rw [translation, AlgHom.convMul_apply, ← r.eq]
  simp [Algebra.smul_def]

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
private lemma counit_translation
    (q : WithConv (A →ₐ[k] k)) (a : A) :
    Bialgebra.counitAlgHom k A (translation q a) = q a := by
  let r := Coalgebra.Repr.arbitrary k a
  have hright :
      ∑ i ∈ r.index, Coalgebra.counit (R := k) (r.right i) • r.left i = a := by
    have h := Coalgebra.sum_tmul_counit_eq r
    apply_fun (TensorProduct.rid k A) at h
    simpa only [map_sum, TensorProduct.rid_tmul, one_smul] using h
  rw [translation_apply_repr q a r, map_sum]
  calc
    ∑ i ∈ r.index,
        Bialgebra.counitAlgHom k A (q (r.left i) • r.right i) =
        q (∑ i ∈ r.index,
          Coalgebra.counit (R := k) (r.right i) • r.left i) := by
            simp [mul_comm]
    _ = q a := by rw [hright]

omit [IsAlgClosed k] [Algebra.FiniteType k A] in
/-- Evaluating a regular translation at the counit recovers the character. -/
public theorem counit_regularCharacterTranslation
    (q : WithConv (A →ₐ[k] k)) (a : A) :
    Bialgebra.counitAlgHom k A (regularCharacterTranslation q a) = q a := by
  exact counit_translation q a

private noncomputable def fractionTranslationEquiv
    (q : WithConv (A →ₐ[k] k)) : FractionRing A ≃ₐ[k] FractionRing A :=
  IsFractionRing.algEquivOfAlgEquiv (translationEquiv q)

private lemma fractionTranslationEquiv_algebraMap
    (q : WithConv (A →ₐ[k] k)) (a : A) :
    fractionTranslationEquiv q (algebraMap A (FractionRing A) a) =
      algebraMap A (FractionRing A) (translation q a) := by
  simp [fractionTranslationEquiv, translationEquiv]

private lemma fractionTranslationEquiv_mul
    (q r : WithConv (A →ₐ[k] k)) :
    fractionTranslationEquiv (r * q) =
      fractionTranslationEquiv q * fractionTranslationEquiv r := by
  apply AlgEquiv.coe_ringEquiv_injective
  apply RingEquiv.toRingHom_injective
  apply IsFractionRing.ringHom_ext (A := A)
  intro a
  change fractionTranslationEquiv (r * q)
      (algebraMap A (FractionRing A) a) =
    fractionTranslationEquiv q
      (fractionTranslationEquiv r (algebraMap A (FractionRing A) a))
  rw [fractionTranslationEquiv_algebraMap,
    fractionTranslationEquiv_algebraMap,
    fractionTranslationEquiv_algebraMap]
  exact congr_arg (algebraMap A (FractionRing A))
    (DFunLike.congr_fun (translation_mul q r) a).symm

private lemma fractionTranslationEquiv_primitiveFractionMap
    (q : WithConv (A →ₐ[k] k)) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (hqt : q t = 0) (x : RatFunc k) :
    fractionTranslationEquiv q (primitiveFractionMap t ht x) =
      primitiveFractionMap t ht x := by
  have hcomul : Coalgebra.comul (R := k) t =
      t ⊗ₜ[k] (1 : A) + (1 : A) ⊗ₜ[k] t :=
    (reducedComultiplication_eq_zero_iff (k := k) t).mp hprimitive
  have hpoly (f : Polynomial k) :
      fractionTranslationEquiv q
          (primitiveFractionMap t ht
            (algebraMap (Polynomial k) (RatFunc k) f)) =
        primitiveFractionMap t ht
          (algebraMap (Polynomial k) (RatFunc k) f) := by
    rw [show algebraMap (Polynomial k) (RatFunc k) f =
      algebraMap (Polynomial k) (RatFunc k) f /
        algebraMap (Polynomial k) (RatFunc k) 1 by simp]
    rw [primitiveFractionMap_apply_div]
    simp only [map_one, div_one]
    rw [fractionTranslationEquiv_algebraMap,
      translation_aeval_of_primitive q t hcomul, hqt, map_zero, zero_add]
  rw [← x.num_div_denom, map_div₀, map_div₀]
  rw [hpoly, hpoly]

/-- The fraction-field translation attached to a primitive-kernel character. -/
public noncomputable def primitiveFractionTranslation
    (t : A) (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (q : primitiveCharacterKernel t hprimitive) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    FractionRing A ≃ₐ[RatFunc k] FractionRing A := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  exact AlgEquiv.ofRingEquiv (f := (fractionTranslationEquiv q.1).toRingEquiv)
    fun x => by
      rw [RingHom.algebraMap_toAlgebra]
      exact fractionTranslationEquiv_primitiveFractionMap
        q.1 t ht hprimitive q.2 x

/-- On coordinate-ring elements, primitive fraction translation is the regular
character translation followed by the fraction-ring algebra map. -/
public theorem primitiveFractionTranslation_algebraMap
    (t : A) (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (q : primitiveCharacterKernel t hprimitive) (a : A) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    primitiveFractionTranslation t ht hprimitive q
        (algebraMap A (FractionRing A) a) =
      algebraMap A (FractionRing A) (regularCharacterTranslation q.1 a) := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  dsimp only
  change fractionTranslationEquiv q.1 (algebraMap A (FractionRing A) a) =
    algebraMap A (FractionRing A) (regularCharacterTranslation q.1 a)
  rw [show regularCharacterTranslation q.1 a = translation q.1 a by rfl]
  exact fractionTranslationEquiv_algebraMap q.1 a

private lemma primitiveFractionTranslation_mul
    (t : A) (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0)
    (q r : primitiveCharacterKernel t hprimitive) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    primitiveFractionTranslation t ht hprimitive (r * q) =
      primitiveFractionTranslation t ht hprimitive q *
        primitiveFractionTranslation t ht hprimitive r := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  dsimp only
  apply AlgEquiv.ext
  intro x
  change fractionTranslationEquiv (r.1 * q.1) x =
    (fractionTranslationEquiv q.1 * fractionTranslationEquiv r.1) x
  exact DFunLike.congr_fun (fractionTranslationEquiv_mul q.1 r.1) x

/-- The direct character translations act on the separable closure; the
opposite group accounts for convolution composition order. -/
public noncomputable def primitiveSeparableKernelAction
    (t : A) (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    let F := separableClosure (RatFunc k) (FractionRing A)
    (primitiveCharacterKernel t hprimitive)ᵐᵒᵖ →* (F ≃ₐ[RatFunc k] F) := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  let F := separableClosure (RatFunc k) (FractionRing A)
  let restrict (q : primitiveCharacterKernel t hprimitive) : F ≃ₐ[RatFunc k] F :=
    separableClosure.algEquivOfAlgEquiv
      (primitiveFractionTranslation t ht hprimitive q)
  exact
    { toFun := fun q => restrict q.unop
      map_one' := by
        apply AlgEquiv.ext
        intro x
        apply Subtype.ext
        change fractionTranslationEquiv (1 : WithConv (A →ₐ[k] k)) x.1 = x.1
        rw [show fractionTranslationEquiv (1 : WithConv (A →ₐ[k] k)) = 1 by
          apply AlgEquiv.coe_ringEquiv_injective
          apply RingEquiv.toRingHom_injective
          apply IsFractionRing.ringHom_ext (A := A)
          intro a
          simp [fractionTranslationEquiv_algebraMap, translation_one]]
        rfl
      map_mul' := by
        intro q r
        apply AlgEquiv.ext
        intro x
        apply Subtype.ext
        exact DFunLike.congr_fun
          (primitiveFractionTranslation_mul t ht hprimitive q.unop r.unop) x.1 }

/-- Evaluation of the separable-closure action is evaluation of the ambient
fraction-field character translation. -/
public theorem primitiveSeparableKernelAction_apply
    (t : A) (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    ∀ (q : (primitiveCharacterKernel t hprimitive)ᵐᵒᵖ)
      (x : separableClosure (RatFunc k) (FractionRing A)),
    (((primitiveSeparableKernelAction t ht hprimitive) q x :
        separableClosure (RatFunc k) (FractionRing A)) : FractionRing A) =
      primitiveFractionTranslation t ht hprimitive q.unop x.1 := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  dsimp only
  intro q x
  rfl

/-- The separable closure of the rational function field inside the ambient
fraction field is finite-dimensional. -/
public theorem primitive_hopf_curve_separableClosure_finite
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
      IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
    Module.Finite (RatFunc k)
      (separableClosure (RatFunc k) (FractionRing A)) := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
  letI : Module.Finite (RatFunc k) (FractionRing A) :=
    primitive_hopf_curve_fraction_map_finite htrdeg t ht hprimitive
  exact Module.Finite.of_injective
    (separableClosure (RatFunc k) (FractionRing A)).val.toLinearMap
    Subtype.val_injective

private def primitiveCharacterKernelEquivZeroFibre
    (t : A) (hprimitive : reducedComultiplication (k := k) t = 0) :
    primitiveCharacterKernel t hprimitive ≃ {q : A →ₐ[k] k // q t = 0} where
  toFun q := ⟨q.1.ofConv, q.2⟩
  invFun q := ⟨WithConv.toConv q.1, q.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

private lemma primitiveSeparableKernelAction_injective
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    Function.Injective (primitiveSeparableKernelAction t ht hprimitive) := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
  letI : Module.Finite (RatFunc k) (FractionRing A) :=
    primitive_hopf_curve_fraction_map_finite htrdeg t ht hprimitive
  dsimp only
  intro q r hqr
  apply MulOpposite.unop_injective
  apply Subtype.ext
  apply WithConv.ofConv_injective
  ext a
  have hrestrict :
      primitiveFractionTranslation t ht hprimitive q.unop =
        primitiveFractionTranslation t ht hprimitive r.unop := by
    have hcomp :
        (primitiveFractionTranslation t ht hprimitive q.unop).toRingHom.comp
            (algebraMap (separableClosure (RatFunc k) (FractionRing A))
              (FractionRing A)) =
          (primitiveFractionTranslation t ht hprimitive r.unop).toRingHom.comp
            (algebraMap (separableClosure (RatFunc k) (FractionRing A))
              (FractionRing A)) := by
      ext x
      exact congr_arg Subtype.val (DFunLike.congr_fun hqr x)
    have heq := IsPurelyInseparable.injective_comp_algebraMap
      (separableClosure (RatFunc k) (FractionRing A))
      (FractionRing A) (FractionRing A) hcomp
    apply AlgEquiv.ext
    intro x
    exact DFunLike.congr_fun heq x
  have htranslation : translation q.unop.1 a = translation r.unop.1 a := by
    apply IsFractionRing.injective A (FractionRing A)
    have ha := DFunLike.congr_fun hrestrict (algebraMap A (FractionRing A) a)
    change fractionTranslationEquiv q.unop.1
        (algebraMap A (FractionRing A) a) =
      fractionTranslationEquiv r.unop.1
        (algebraMap A (FractionRing A) a) at ha
    simpa only [fractionTranslationEquiv_algebraMap] using ha
  rw [← counit_translation q.unop.1 a, ← counit_translation r.unop.1 a,
    htranslation]

private lemma primitiveSeparableKernelAction_card_eq_finrank
    [IsIntegrallyClosed A]
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    Nat.card ((primitiveCharacterKernel t hprimitive)ᵐᵒᵖ) =
      Module.finrank (RatFunc k)
        (separableClosure (RatFunc k) (FractionRing A)) := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  calc
    Nat.card ((primitiveCharacterKernel t hprimitive)ᵐᵒᵖ) =
        Nat.card (primitiveCharacterKernel t hprimitive) :=
      Nat.card_congr MulOpposite.opEquiv.symm
    _ = Nat.card {q : A →ₐ[k] k // q t = 0} :=
      Nat.card_congr (primitiveCharacterKernelEquivZeroFibre t hprimitive)
    _ = Module.finrank (RatFunc k)
          (separableClosure (RatFunc k) (FractionRing A)) :=
      primitive_hopf_curve_zero_fibre_card_eq_separable_finrank
        htrdeg t ht hprimitive

/-- The primitive character action exhausts the automorphism group of the
separable closure. -/
public theorem primitiveSeparableKernelAction_bijective
    [IsIntegrallyClosed A]
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    Function.Bijective (primitiveSeparableKernelAction t ht hprimitive) := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
  letI : Module.Finite (RatFunc k) (FractionRing A) :=
    primitive_hopf_curve_fraction_map_finite htrdeg t ht hprimitive
  letI : Module.Finite (RatFunc k)
      (separableClosure (RatFunc k) (FractionRing A)) :=
    Module.Finite.of_injective
      (separableClosure (RatFunc k) (FractionRing A)).val.toLinearMap
      Subtype.val_injective
  letI : Finite (primitiveCharacterKernel t hprimitive) :=
    primitiveCharacterKernel_finite htrdeg t ht hprimitive
  have hinj := primitiveSeparableKernelAction_injective htrdeg t ht hprimitive
  apply hinj.bijective_of_nat_card_le
  calc
    Nat.card
        (separableClosure (RatFunc k) (FractionRing A) ≃ₐ[RatFunc k]
          separableClosure (RatFunc k) (FractionRing A)) ≤
        Module.finrank (RatFunc k)
          (separableClosure (RatFunc k) (FractionRing A)) := by
      rw [Nat.card_eq_fintype_card]
      exact AlgEquiv.card_le
    _ = Nat.card ((primitiveCharacterKernel t hprimitive)ᵐᵒᵖ) :=
      (primitiveSeparableKernelAction_card_eq_finrank
        htrdeg t ht hprimitive).symm

/-- The separable primitive kernel is finite Galois, and its Galois group is a
`p`-group. -/
public theorem primitive_hopf_curve_separable_kernel_is_galois_pGroup
    {p : ℕ} [CharP k p] [Fact p.Prime] [IsIntegrallyClosed A]
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
      IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
    let F := separableClosure (RatFunc k) (FractionRing A)
    IsGalois (RatFunc k) F ∧ IsPGroup p (F ≃ₐ[RatFunc k] F) := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
  letI : Module.Finite (RatFunc k) (FractionRing A) :=
    primitive_hopf_curve_fraction_map_finite htrdeg t ht hprimitive
  let F := separableClosure (RatFunc k) (FractionRing A)
  letI : Module.Finite (RatFunc k) F :=
    primitive_hopf_curve_separableClosure_finite htrdeg t ht hprimitive
  letI : Finite (primitiveCharacterKernel t hprimitive) :=
    primitiveCharacterKernel_finite htrdeg t ht hprimitive
  have hb := primitiveSeparableKernelAction_bijective htrdeg t ht hprimitive
  have hcard : Nat.card (F ≃ₐ[RatFunc k] F) = Module.finrank (RatFunc k) F := by
    rw [← primitiveSeparableKernelAction_card_eq_finrank htrdeg t ht hprimitive]
    exact Nat.card_congr (Equiv.ofBijective
      (primitiveSeparableKernelAction t ht hprimitive) hb).symm
  constructor
  · exact IsGalois.of_card_aut_eq_finrank (RatFunc k) F hcard
  · have hkernel := primitiveCharacterKernel_isPGroup
      (p := p) htrdeg t ht hprimitive
    have hopposite := hkernel.of_equiv
      (MulEquiv.inv' (primitiveCharacterKernel t hprimitive))
    exact hopposite.of_equiv
      (MulEquiv.ofBijective
        (primitiveSeparableKernelAction t ht hprimitive) hb)

/-- The fixed field of the full separable-kernel Galois group is the embedded
rational function field. -/
public theorem primitive_hopf_curve_separable_kernel_fixedField_eq_bot
    {p : ℕ} [CharP k p] [Fact p.Prime] [IsIntegrallyClosed A]
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
      IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
    let F := separableClosure (RatFunc k) (FractionRing A)
    IntermediateField.fixedField (⊤ : Subgroup (F ≃ₐ[RatFunc k] F)) = ⊥ := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
  letI : Module.Finite (RatFunc k) (FractionRing A) :=
    primitive_hopf_curve_fraction_map_finite htrdeg t ht hprimitive
  let F := separableClosure (RatFunc k) (FractionRing A)
  letI : Module.Finite (RatFunc k) F :=
    primitive_hopf_curve_separableClosure_finite htrdeg t ht hprimitive
  letI : IsGalois (RatFunc k) F :=
    (primitive_hopf_curve_separable_kernel_is_galois_pGroup
      (p := p) htrdeg t ht hprimitive).1
  exact IsGalois.fixedField_top

/-- Every Galois automorphism is, pointwise, the restriction of one character
translation on the ambient fraction field. -/
public theorem primitive_hopf_curve_galois_automorphism_apply
    [IsIntegrallyClosed A]
    (htrdeg : Algebra.trdeg k A = 1) (t : A)
    (ht : Transcendental k t)
    (hprimitive : reducedComultiplication (k := k) t = 0) :
    let f := primitiveFractionMap (k := k) t ht
    letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
    letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
      IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
    ∀ σ : separableClosure (RatFunc k) (FractionRing A) ≃ₐ[RatFunc k]
        separableClosure (RatFunc k) (FractionRing A),
      ∃ q : primitiveCharacterKernel t hprimitive,
      ∀ x : separableClosure (RatFunc k) (FractionRing A),
        ((σ x : separableClosure (RatFunc k) (FractionRing A)) : FractionRing A) =
          primitiveFractionTranslation t ht hprimitive q x.1 := by
  let f := primitiveFractionMap (k := k) t ht
  letI : Algebra (RatFunc k) (FractionRing A) := f.toRingHom.toAlgebra
  letI : IsScalarTower k (RatFunc k) (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq fun x => (f.commutes x).symm
  dsimp only
  intro σ
  obtain ⟨q, hq⟩ :=
    (primitiveSeparableKernelAction_bijective htrdeg t ht hprimitive).2 σ
  refine ⟨q.unop, fun x => ?_⟩
  rw [← primitiveSeparableKernelAction_apply t ht hprimitive q x, hq]

end Theory.AlgebraicGroup
