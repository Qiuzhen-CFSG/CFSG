module

public import Theory.AlgebraicGroup.Morphism.ClosedImage
public import Theory.AlgebraicGroup.Representations.Matrix
public import Theory.AlgebraicGroup.Representations.Nilpotence
public import Theory.AlgebraicGroup.RightTranslation.MatrixCoefficients
public import Theory.AlgebraicGroup.Unipotent.Defs

universe u

/-! The faithful finite-dimensional representation generated by right
translations of the affine coordinates of an algebraic group. -/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- The regular function represented by the `i`th affine coordinate. -/
@[expose]
public noncomputable def coordinatePolynomialFunction (G : Variety k)
    (i : G.Coordinates) : Variety.PolynomialFunction G :=
  Variety.PolynomialFunction.ofPolynomial G (MvPolynomial.X i)

/-- The span of the right-translation orbit spans of all affine coordinates. -/
@[expose]
public noncomputable def coordinateTranslationSubmodule
    (G : Variety k) [AlgebraicGroup G] :
    Submodule k (Variety.PolynomialFunction G) :=
  ⨆ i : G.Coordinates,
    rightTranslateOrbitSpan G (coordinatePolynomialFunction G i)

omit [IsAlgClosed k] in
/-- The coordinate-translation submodule is finite-dimensional. -/
public lemma coordinateTranslationSubmodule_finite
    (G : Variety k) [AlgebraicGroup G] :
    Module.Finite k (coordinateTranslationSubmodule G) := by
  let : ∀ i : G.Coordinates,
      FiniteDimensional k
        (rightTranslateOrbitSpan G (coordinatePolynomialFunction G i)) :=
    fun i ↦ rightTranslateOrbitSpan_moduleFinite G
      (coordinatePolynomialFunction G i)
  exact Submodule.finiteDimensional_iSup _

omit [IsAlgClosed k] in
/-- Every affine coordinate belongs to the coordinate-translation submodule. -/
public lemma coordinatePolynomialFunction_mem_coordinateTranslationSubmodule
    (G : Variety k) [AlgebraicGroup G] (i : G.Coordinates) :
    coordinatePolynomialFunction G i ∈ coordinateTranslationSubmodule G := by
  apply Submodule.mem_iSup_of_mem i
  apply Submodule.subset_span
  refine ⟨1, ?_⟩
  exact AlgebraicGroup.rightMul_pullback_one G (coordinatePolynomialFunction G i)

omit [IsAlgClosed k] in
/-- Right translation preserves the coordinate-translation submodule. -/
public lemma coordinateTranslationSubmodule_mapsTo
    (G : Variety k) [AlgebraicGroup G] (g : Variety.Point G) :
    Set.MapsTo (rightTranslationPullback G g)
      (coordinateTranslationSubmodule G) (coordinateTranslationSubmodule G) := by
  let T := coordinateTranslationSubmodule G
  intro f hf
  change rightTranslationPullback G g f ∈ T
  refine Submodule.iSup_induction
    (motive := fun x ↦ rightTranslationPullback G g x ∈ T)
    (fun i : G.Coordinates ↦
      rightTranslateOrbitSpan G (coordinatePolynomialFunction G i)) hf ?_ ?_ ?_
  · intro i x hx
    apply Submodule.mem_iSup_of_mem i
    exact rightTranslateOrbitSpan_stable G (coordinatePolynomialFunction G i) g x hx
  · rw [(rightTranslationPullback G g).map_zero]
    exact T.zero_mem
  · intro x y hx hy
    rw [(rightTranslationPullback G g).map_add]
    exact T.add_mem hx hy

/-- Right translation restricted to the coordinate-translation submodule. -/
@[expose]
public noncomputable def rightTranslationOnCoordinateSubmodule
    (G : Variety k) [AlgebraicGroup G] (g : Variety.Point G) :
    Module.End k (coordinateTranslationSubmodule G) :=
  LinearMap.codRestrict (coordinateTranslationSubmodule G)
    ((rightTranslationPullback G g).domRestrict
      (coordinateTranslationSubmodule G))
    (fun c ↦ coordinateTranslationSubmodule_mapsTo G g c.2)

omit [IsAlgClosed k] in
/-- Restricted translation agrees with ambient pullback. -/
public lemma rightTranslationOnCoordinateSubmodule_apply
    (G : Variety k) [AlgebraicGroup G] (g : Variety.Point G)
    (f : coordinateTranslationSubmodule G) :
    (rightTranslationOnCoordinateSubmodule G g f).val =
      rightTranslationPullback G g f.val := by
  simp [rightTranslationOnCoordinateSubmodule, LinearMap.codRestrict,
    LinearMap.domRestrict]

omit [IsAlgClosed k] in
/-- Restricted right translation by the identity is the identity. -/
public lemma rightTranslationOnCoordinateSubmodule_one
    (G : Variety k) [AlgebraicGroup G] :
    rightTranslationOnCoordinateSubmodule G (1 : Variety.Point G) =
      (1 : Module.End k (coordinateTranslationSubmodule G)) := by
  apply LinearMap.ext
  intro f
  apply Subtype.ext
  rw [rightTranslationOnCoordinateSubmodule_apply]
  simp [rightTranslationPullback_one]

omit [IsAlgClosed k] in
/-- Restricted right translations multiply in the same order as points. -/
public lemma rightTranslationOnCoordinateSubmodule_mul
    (G : Variety k) [AlgebraicGroup G] (a b : Variety.Point G) :
    rightTranslationOnCoordinateSubmodule G (a * b) =
      rightTranslationOnCoordinateSubmodule G a *
        rightTranslationOnCoordinateSubmodule G b := by
  apply LinearMap.ext
  intro f
  apply Subtype.ext
  rw [rightTranslationOnCoordinateSubmodule_apply]
  simp only [Module.End.mul_apply, rightTranslationOnCoordinateSubmodule_apply]
  rw [rightTranslationPullback_mul]
  rfl

omit [IsAlgClosed k] in
/-- Restricted right translation faithfully recovers the group point. -/
public lemma rightTranslationOnCoordinateSubmodule_injective
    (G : Variety k) [AlgebraicGroup G] :
    Function.Injective (rightTranslationOnCoordinateSubmodule G) := by
  intro a b hab
  apply Variety.Point.ext
  funext i
  let f : coordinateTranslationSubmodule G :=
    ⟨coordinatePolynomialFunction G i,
      coordinatePolynomialFunction_mem_coordinateTranslationSubmodule G i⟩
  have hf := congrArg (fun T ↦ T f) hab
  have hf' := congrArg (fun z : coordinateTranslationSubmodule G ↦ z.val) hf
  have hev := congrArg (fun z : Variety.PolynomialFunction G ↦
      z (1 : Variety.Point G)) hf'
  change (rightTranslationPullback G a (coordinatePolynomialFunction G i)) 1 =
    (rightTranslationPullback G b (coordinatePolynomialFunction G i)) 1 at hev
  rw [rightTranslationPullback_apply, rightTranslationPullback_apply] at hev
  simpa [coordinatePolynomialFunction,
    Variety.PolynomialFunction.ofPolynomial,
    Variety.PolynomialFunction.toFun, evalPolynomial] using hev

omit [IsAlgClosed k] in
/-- Pointwise unipotence restricts to local nilpotence on the finite
coordinate-translation submodule. -/
public lemma rightTranslationOnCoordinateSubmodule_sub_one_locallyNilpotent
    {G : Variety k} [AlgebraicGroup G]
    (hunipotent : IsUnipotentAlgebraicGroup G) (g : Variety.Point G) :
    ∀ f : coordinateTranslationSubmodule G,
      ∃ n : ℕ,
        (((rightTranslationOnCoordinateSubmodule G g) -
          (1 : Module.End k (coordinateTranslationSubmodule G)))^[n]) f = 0 := by
  intro f
  rcases hunipotent g f.val with ⟨n, hn⟩
  refine ⟨n, ?_⟩
  apply Subtype.ext
  let T : Module.End k (coordinateTranslationSubmodule G) :=
    rightTranslationOnCoordinateSubmodule G g - 1
  let S : Module.End k (Variety.PolynomialFunction G) :=
    rightTranslationPullback G g - 1
  have hstep (z : coordinateTranslationSubmodule G) :
      (T z).val = S z.val := by
    change ((rightTranslationOnCoordinateSubmodule G g - 1) z).val =
      (rightTranslationPullback G g - 1) z.val
    change (rightTranslationOnCoordinateSubmodule G g z).val - z.val =
      rightTranslationPullback G g z.val - z.val
    rw [rightTranslationOnCoordinateSubmodule_apply]
  have hiter : ∀ m : ℕ, (T^[m] f).val = (S^[m]) f.val := by
    intro m
    induction m with
    | zero => simp
    | succ m ihm =>
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
        rw [hstep, ihm]
  change (T^[n] f).val = 0
  rw [hiter n, hn]

/-- The faithful coordinate-translation representation into a general linear
group. -/
@[expose]
public noncomputable def coordinateTranslationRepresentation
    (G : Variety k) [AlgebraicGroup G] :
    Variety.Point G →*
      LinearMap.GeneralLinearGroup k (coordinateTranslationSubmodule G) where
  toFun := fun g ↦
    { val := rightTranslationOnCoordinateSubmodule G g
      inv := rightTranslationOnCoordinateSubmodule G g⁻¹
      val_inv := by
        rw [← rightTranslationOnCoordinateSubmodule_mul, mul_inv_cancel]
        exact rightTranslationOnCoordinateSubmodule_one G
      inv_val := by
        rw [← rightTranslationOnCoordinateSubmodule_mul, inv_mul_cancel]
        exact rightTranslationOnCoordinateSubmodule_one G }
  map_one' := Units.ext (rightTranslationOnCoordinateSubmodule_one G)
  map_mul' := fun a b ↦
    Units.ext (rightTranslationOnCoordinateSubmodule_mul G a b)

/-- The coordinate-translation action as a rational representation. -/
@[expose]
public noncomputable def coordinateTranslationRationalRepresentation
    (G : Variety k) [AlgebraicGroup G] :
    RationalRepresentation G (coordinateTranslationSubmodule G) :=
  ⟨coordinateTranslationRepresentation G⟩

omit [IsAlgClosed k] in
/-- The coordinate-translation representation is faithful. -/
public lemma coordinateTranslationRepresentation_injective
    (G : Variety k) [AlgebraicGroup G] :
    Function.Injective (coordinateTranslationRepresentation G) := by
  intro a b hab
  apply rightTranslationOnCoordinateSubmodule_injective G
  have hval := congrArg
    (fun z : LinearMap.GeneralLinearGroup k (coordinateTranslationSubmodule G) ↦
      (z : Module.End k (coordinateTranslationSubmodule G))) hab
  simpa [coordinateTranslationRepresentation] using hval

omit [IsAlgClosed k] in
/-- Every point acts unipotently in the faithful finite-dimensional
coordinate-translation representation. -/
public lemma coordinateTranslationRepresentation_sub_one_pow_finrank_eq_zero
    {G : Variety k} [AlgebraicGroup G]
    (hG : IsUnipotentAlgebraicGroup G) (g : Variety.Point G) :
    (((coordinateTranslationRepresentation G g :
        LinearMap.GeneralLinearGroup k (coordinateTranslationSubmodule G)) :
        Module.End k (coordinateTranslationSubmodule G)) - 1) ^
      Module.finrank k (coordinateTranslationSubmodule G) = 0 := by
  let : Module.Finite k (coordinateTranslationSubmodule G) :=
    coordinateTranslationSubmodule_finite G
  apply endomorphism_pow_finrank_eq_zero_of_locallyNilpotent
  simpa [coordinateTranslationRepresentation] using
    rightTranslationOnCoordinateSubmodule_sub_one_locallyNilpotent hG g

omit [IsAlgClosed k] in
/-- A fixed finite basis of the coordinate-translation representation space. -/
@[expose]
public noncomputable def coordinateTranslationBasis
    (G : Variety k) [AlgebraicGroup G] :
    Module.Basis (Fin (Module.finrank k
      (coordinateTranslationSubmodule G))) k
      (coordinateTranslationSubmodule G) := by
  let : Module.Finite k (coordinateTranslationSubmodule G) :=
    coordinateTranslationSubmodule_finite G
  exact Module.finBasis k (coordinateTranslationSubmodule G)

omit [IsAlgClosed k] in
/-- A regular function giving a basis matrix coefficient of the faithful
coordinate-translation representation. -/
@[expose]
public noncomputable def coordinateTranslationMatrixCoefficient
    (G : Variety k) [AlgebraicGroup G]
    (e : Module.Basis (Fin (Module.finrank k
      (coordinateTranslationSubmodule G))) k
      (coordinateTranslationSubmodule G))
    (i j : Fin (Module.finrank k (coordinateTranslationSubmodule G))) :
    Variety.PolynomialFunction G := by
  let : Module.Finite k (coordinateTranslationSubmodule G) :=
    coordinateTranslationSubmodule_finite G
  exact
    (polynomialFunctionSubspaceDualCoefficients G
      (coordinateTranslationSubmodule G) (e.coord i)).sum fun x a ↦
        a • Variety.PolynomialFunction.pullback
          (AlgebraicGroup.leftMulMorphism G x) (e j).val

omit [IsAlgClosed k] in
/-- Evaluation of a regular matrix coefficient is the corresponding basis
coordinate of restricted right translation. -/
public lemma coordinateTranslationMatrixCoefficient_apply
    (G : Variety k) [AlgebraicGroup G]
    (e : Module.Basis (Fin (Module.finrank k
      (coordinateTranslationSubmodule G))) k
      (coordinateTranslationSubmodule G))
    (i j : Fin (Module.finrank k (coordinateTranslationSubmodule G)))
    (g : Variety.Point G) :
    coordinateTranslationMatrixCoefficient G e i j g =
      e.repr (rightTranslationOnCoordinateSubmodule G g (e j)) i := by
  let : Module.Finite k (coordinateTranslationSubmodule G) :=
    coordinateTranslationSubmodule_finite G
  let c := polynomialFunctionSubspaceDualCoefficients G
    (coordinateTranslationSubmodule G) (e.coord i)
  have hc := congrArg
    (fun L : Module.Dual k (coordinateTranslationSubmodule G) ↦
      L (rightTranslationOnCoordinateSubmodule G g (e j)))
    (polynomialFunctionSubspaceDualCoefficients_spec G
      (coordinateTranslationSubmodule G) (e.coord i))
  change
    ((c.sum fun x a ↦ a • polynomialFunctionSubspaceEvaluation G
      (coordinateTranslationSubmodule G) x)
      (rightTranslationOnCoordinateSubmodule G g (e j))) =
      e.repr (rightTranslationOnCoordinateSubmodule G g (e j)) i at hc
  rw [← hc]
  change
    polynomialFunctionEvalAddHom G g
        (c.sum fun x a ↦ a • Variety.PolynomialFunction.pullback
          (AlgebraicGroup.leftMulMorphism G x) (e j).val) =
      (LinearMap.applyₗ (R := k)
        (M := coordinateTranslationSubmodule G) (M₂ := k)
        (rightTranslationOnCoordinateSubmodule G g (e j)))
        (c.sum fun x a ↦ a • polynomialFunctionSubspaceEvaluation G
          (coordinateTranslationSubmodule G) x)
  rw [map_finsuppSum, map_finsuppSum]
  apply Finsupp.sum_congr
  intro x hx
  simp only [Variety.PolynomialFunction.pullback,
    AlgebraicGroup.leftMulMorphism_apply,
    polynomialFunctionSubspaceEvaluation]
  rw [polynomialFunctionEvalAddHom_apply]
  simp only [polynomialFunction_smul_apply]
  rw [map_smul, LinearMap.applyₗ_apply_apply]
  simp only [smul_eq_mul]
  congr 1

/-- The faithful coordinate-translation representation as a regular
algebraic-group morphism. -/
@[expose]
public noncomputable def coordinateTranslationRepresentationMorphism
    (G : Variety k) [AlgebraicGroup G] :
    AlgebraicGroup.Morphism G
      (glVarietyOf k (coordinateTranslationSubmodule G)) := by
  let inverseMatrixCoefficient
      (i j : Fin (Module.finrank k (coordinateTranslationSubmodule G))) :
      Variety.PolynomialFunction G :=
    Variety.PolynomialFunction.pullback (AlgebraicGroup.invMorphism G)
      (coordinateTranslationMatrixCoefficient G
        (coordinateTranslationBasis G) i j)
  let invM : Matrix
      (Fin (Module.finrank k (coordinateTranslationSubmodule G)))
      (Fin (Module.finrank k (coordinateTranslationSubmodule G)))
      G.PolynomialFunction := fun i j => inverseMatrixCoefficient i j
  let inverseDeterminant : Variety.PolynomialFunction G :=
    Matrix.det invM
  have inverseDeterminant_apply (g : Variety.Point G) :
      inverseDeterminant g =
        (LinearMap.toMatrix (coordinateTranslationBasis G)
          (coordinateTranslationBasis G)
          ((coordinateTranslationRepresentation G g :
            LinearMap.GeneralLinearGroup k
              (coordinateTranslationSubmodule G)) :
            Module.End k (coordinateTranslationSubmodule G))).det⁻¹ := by
    let : Module.Finite k (coordinateTranslationSubmodule G) :=
      coordinateTranslationSubmodule_finite G
    let ev : Variety.PolynomialFunction G →+* k :=
      { toFun := fun f ↦ f g
        map_one' := rfl
        map_mul' := by
          intro x y
          change (x * y) g = x g * y g
          rfl
        map_zero' := rfl
        map_add' := fun _ _ ↦ rfl }
    let B : Matrix
        (Fin (Module.finrank k (coordinateTranslationSubmodule G)))
        (Fin (Module.finrank k (coordinateTranslationSubmodule G))) k :=
      LinearMap.toMatrix (coordinateTranslationBasis G)
        (coordinateTranslationBasis G)
        ((coordinateTranslationRepresentation G g⁻¹ :
          LinearMap.GeneralLinearGroup k
            (coordinateTranslationSubmodule G)) :
          Module.End k (coordinateTranslationSubmodule G))
    have hEval : inverseDeterminant g = B.det := by
      change ev (Matrix.det invM) = B.det
      rw [RingHom.map_det]
      congr 1
      funext i j
      change invM i j g = _
      change coordinateTranslationMatrixCoefficient G
          (coordinateTranslationBasis G) i j g⁻¹ = B i j
      rw [coordinateTranslationMatrixCoefficient_apply]
      change _ = (LinearMap.toMatrix (coordinateTranslationBasis G)
        (coordinateTranslationBasis G)
        ((coordinateTranslationRepresentation G g⁻¹ :
          LinearMap.GeneralLinearGroup k
            (coordinateTranslationSubmodule G)) :
          Module.End k (coordinateTranslationSubmodule G))) i j
      rw [LinearMap.toMatrix_apply]
      rfl
    rw [hEval]
    simp [B]
  exact generalLinearRepresentationMorphism
    (coordinateTranslationBasis G)
    (coordinateTranslationRepresentation G)
    (coordinateTranslationMatrixCoefficient G (coordinateTranslationBasis G))
    (coordinateTranslationMatrixCoefficient_apply G (coordinateTranslationBasis G))
    inverseDeterminant inverseDeterminant_apply

/-- The coordinate-translation representation is rational. -/
public lemma coordinateTranslationRationalRepresentation_isRational
    (G : Variety k) [AlgebraicGroup G] :
    IsRationalRepresentation (coordinateTranslationRationalRepresentation G) := by
  let : Module.Finite k (coordinateTranslationSubmodule G) :=
    coordinateTranslationSubmodule_finite G
  let b := coordinateTranslationBasis G
  refine ⟨b, coordinateTranslationRepresentationMorphism G, ?_⟩
  intro g
  change glPointEquivOf k (coordinateTranslationSubmodule G) b
      (generalLinearRepresentationPoint b
        (coordinateTranslationRepresentation G g)) =
    coordinateTranslationRepresentation G g
  exact glPointEquivOf_generalLinearRepresentationPoint b
    (coordinateTranslationRepresentation G g)

/-- The regular coordinate-translation representation is faithful. -/
public lemma coordinateTranslationRepresentationMorphism_injective
    (G : Variety k) [AlgebraicGroup G] :
    Function.Injective
      (coordinateTranslationRepresentationMorphism G).onPoints := by
  intro g h hgh
  apply coordinateTranslationRepresentation_injective G
  change generalLinearRepresentationPoint (coordinateTranslationBasis G)
      (coordinateTranslationRepresentation G g) =
    generalLinearRepresentationPoint (coordinateTranslationBasis G)
      (coordinateTranslationRepresentation G h) at hgh
  have hmatrix := congrArg
    (translationGLPointMulEquiv
      (Module.finrank k (coordinateTranslationSubmodule G))) hgh
  have hlinear := congrArg
    (Matrix.GeneralLinearGroup.toLin' (coordinateTranslationBasis G)) hmatrix
  simpa [generalLinearRepresentationPoint] using hlinear

omit [IsAlgClosed k] in
/-- An original affine coordinate, regarded as a vector in the finite
coordinate-translation module. -/
@[expose]
public noncomputable def coordinateTranslationCoordinateVector
    (G : Variety k) [AlgebraicGroup G] (c : G.Coordinates) :
    coordinateTranslationSubmodule G :=
  ⟨coordinatePolynomialFunction G c,
    coordinatePolynomialFunction_mem_coordinateTranslationSubmodule G c⟩

/-- The faithful coordinate-translation morphism is an algebraic-group
isomorphism onto its canonical closed image. -/
private lemma coordinateTranslationRepresentationMorphism_iso_imageClosedSubgroup
    (G : Variety k) [AlgebraicGroup G] :
    ∃ e : AlgebraicGroup.Iso G
        (coordinateTranslationRepresentationMorphism G).imageClosedSubgroup.carrierVariety,
      e.hom = (coordinateTranslationRepresentationMorphism G).codRestrictClosedSubgroup
        (coordinateTranslationRepresentationMorphism G).imageClosedSubgroup
        (fun y ↦ ⟨y, rfl⟩) := by
  let f := coordinateTranslationRepresentationMorphism G
  let I := f.imageClosedSubgroup
  let hmap : ∀ x, f.onPoints x ∈ I.toSubgroup := fun x ↦ ⟨x, rfl⟩
  let r : AlgebraicGroup.Morphism G I.carrierVariety :=
    f.codRestrictClosedSubgroup I hmap
  let e := coordinateTranslationBasis G
  let evaluationOne : Module.Dual k (coordinateTranslationSubmodule G) :=
    polynomialFunctionSubspaceEvaluation G (coordinateTranslationSubmodule G) 1
  let generalMatrixCoefficient
      (K : Module.Dual k (coordinateTranslationSubmodule G))
      (v : coordinateTranslationSubmodule G) :
      Variety.PolynomialFunction G :=
    ∑ j, e.repr v j •
      ∑ i, K (e i) • coordinateTranslationMatrixCoefficient G e i j
  have generalMatrixCoefficient_apply
      (K : Module.Dual k (coordinateTranslationSubmodule G))
      (v : coordinateTranslationSubmodule G) (g : Variety.Point G) :
      generalMatrixCoefficient K v g =
        K (rightTranslationOnCoordinateSubmodule G g v) := by
    have hK (x : coordinateTranslationSubmodule G) :
        ∑ i, K (e i) * e.repr x i = K x := by
      calc
        ∑ i, K (e i) * e.repr x i =
            ∑ i, e.repr x i * K (e i) := by
              apply Finset.sum_congr rfl
              intro i hi
              rw [mul_comm]
        _ = K (∑ i, e.repr x i • e i) := by
              rw [map_sum]
              simp [smul_eq_mul]
        _ = K x := by rw [e.sum_repr]
    have hsum (j) :
        (∑ i, K (e i) • coordinateTranslationMatrixCoefficient G e i j) g =
          ∑ i, K (e i) * coordinateTranslationMatrixCoefficient G e i j g := by
      change polynomialFunctionEvalAddHom G g
        (∑ i, K (e i) • coordinateTranslationMatrixCoefficient G e i j) = _
      rw [map_sum]
      simp [polynomialFunction_smul_apply]
    change polynomialFunctionEvalAddHom G g
      (∑ j, e.repr v j •
        ∑ i, K (e i) • coordinateTranslationMatrixCoefficient G e i j) = _
    rw [map_sum]
    simp_rw [polynomialFunctionEvalAddHom_apply,
      polynomialFunction_smul_apply, hsum]
    simp_rw [coordinateTranslationMatrixCoefficient_apply, hK]
    calc
      ∑ j, e.repr v j *
          K (rightTranslationOnCoordinateSubmodule G g (e j)) =
          K (∑ j, e.repr v j •
            rightTranslationOnCoordinateSubmodule G g (e j)) := by
              rw [map_sum]
              simp [smul_eq_mul]
      _ = K (rightTranslationOnCoordinateSubmodule G g
          (∑ j, e.repr v j • e j)) := by
            congr 1
            rw [map_sum]
            simp
      _ = K (rightTranslationOnCoordinateSubmodule G g v) := by
            rw [e.sum_repr]
  let targetMatrixCoordinate
      (i j : Fin (Module.finrank k (coordinateTranslationSubmodule G))) :
      Variety.PolynomialFunction
        (glVarietyOf k (coordinateTranslationSubmodule G)) :=
    Variety.PolynomialFunction.ofPolynomial _
      (MvPolynomial.X (Sum.inl (i, j)))
  let coordinatePreimage (c : G.Coordinates) :
      Variety.PolynomialFunction
        (glVarietyOf k (coordinateTranslationSubmodule G)) :=
    ∑ j, e.repr (coordinateTranslationCoordinateVector G c) j •
      ∑ i, evaluationOne (e i) • targetMatrixCoordinate i j
  have coordinatePreimage_pullback (c : G.Coordinates) :
      Variety.PolynomialFunction.pullback f.toVariety (coordinatePreimage c) =
        coordinatePolynomialFunction G c := by
    apply Variety.PolynomialFunction.ext
    intro g
    let v := coordinateTranslationCoordinateVector G c
    have hrepresentation : f.onPoints g =
        (generalLinearRepresentationPoint e
          (coordinateTranslationRepresentation G g) : Variety.Point
            (glVarietyOf k (coordinateTranslationSubmodule G))) := rfl
    have hsum (j) :
        (∑ i, evaluationOne (e i) • targetMatrixCoordinate i j)
            (f.onPoints g) =
          ∑ i, evaluationOne (e i) *
            coordinateTranslationMatrixCoefficient G e i j g := by
      change polynomialFunctionEvalAddHom _
        (f.onPoints g)
        (∑ i, evaluationOne (e i) • targetMatrixCoordinate i j) = _
      rw [map_sum]
      simp only [polynomialFunctionEvalAddHom_apply]
      apply Finset.sum_congr rfl
      intro i hi
      rw [polynomialFunction_smul_apply]
      rw [hrepresentation]
      congr 1
      calc
        targetMatrixCoordinate i j
            (generalLinearRepresentationPoint e
              (coordinateTranslationRepresentation G g)) =
            (generalLinearRepresentationPoint e
              (coordinateTranslationRepresentation G g)).val (Sum.inl (i, j)) := by
          unfold targetMatrixCoordinate
          unfold Variety.PolynomialFunction.ofPolynomial
            Variety.PolynomialFunction.toFun evalPolynomial
          exact MvPolynomial.eval_X _
        _ = e.repr (((coordinateTranslationRepresentation G g :
              LinearMap.GeneralLinearGroup k
                (coordinateTranslationSubmodule G)) :
              Module.End k (coordinateTranslationSubmodule G)) (e j)) i :=
          generalLinearRepresentationPoint_matrix e
            (coordinateTranslationRepresentation G g) i j
        _ = e.repr (rightTranslationOnCoordinateSubmodule G g (e j)) i := rfl
        _ = coordinateTranslationMatrixCoefficient G e i j g :=
          (coordinateTranslationMatrixCoefficient_apply G e i j g).symm
    change coordinatePreimage c (f.onPoints g) = coordinatePolynomialFunction G c g
    change polynomialFunctionEvalAddHom
      (glVarietyOf k (coordinateTranslationSubmodule G)) (f.onPoints g)
      (∑ j, e.repr v j •
        ∑ i, evaluationOne (e i) • targetMatrixCoordinate i j) = _
    rw [map_sum]
    simp_rw [polynomialFunctionEvalAddHom_apply,
      polynomialFunction_smul_apply, hsum]
    have hgeneral :
        generalMatrixCoefficient evaluationOne v g =
          ∑ j, e.repr v j *
            ∑ i, evaluationOne (e i) *
              coordinateTranslationMatrixCoefficient G e i j g := by
      change polynomialFunctionEvalAddHom G g
        (∑ j, e.repr v j •
          ∑ i, evaluationOne (e i) •
            coordinateTranslationMatrixCoefficient G e i j) = _
      rw [map_sum]
      simp only [polynomialFunctionEvalAddHom_apply,
        polynomialFunction_smul_apply]
      apply Finset.sum_congr rfl
      intro j hj
      congr 1
      change polynomialFunctionEvalAddHom G g
        (∑ i, evaluationOne (e i) •
          coordinateTranslationMatrixCoefficient G e i j) = _
      rw [map_sum]
      simp [polynomialFunction_smul_apply]
    rw [← hgeneral, generalMatrixCoefficient_apply]
    change (rightTranslationOnCoordinateSubmodule G g v).val 1 = _
    rw [rightTranslationOnCoordinateSubmodule_apply,
      rightTranslationPullback_apply]
    change coordinatePolynomialFunction G c (1 * g) =
      coordinatePolynomialFunction G c g
    rw [one_mul]
  let imageCoordinatePreimage (c : G.Coordinates) :
      Variety.PolynomialFunction I.carrierVariety :=
    Variety.PolynomialFunction.pullback I.inclusion.toVariety
      (coordinatePreimage c)
  have imageCoordinatePreimage_pullback (c : G.Coordinates) :
      Variety.PolynomialFunction.pullback r.toVariety
        (imageCoordinatePreimage c) = coordinatePolynomialFunction G c := by
    apply Variety.PolynomialFunction.ext
    intro x
    change coordinatePreimage c (I.inclusion.onPoints (r.onPoints x)) =
      coordinatePolynomialFunction G c x
    rw [AlgebraicGroup.Morphism.codRestrictClosedSubgroup_inclusion_apply]
    exact congrArg (fun p ↦ p x) (coordinatePreimage_pullback c)
  let surj : Function.Surjective r.onPoints :=
    AlgebraicGroup.Morphism.codRestrictImageClosedSubgroup_surjective f hmap
  let gToFun : Variety.Point I.carrierVariety → Variety.Point G :=
    fun y ↦ Classical.choose (surj y)
  have hpreimage (y : Variety.Point I.carrierVariety) :
      r.onPoints (gToFun y) = y :=
    Classical.choose_spec (surj y)
  let g : AlgebraicGroup.Morphism I.carrierVariety G :=
    { toVariety :=
        { toFun := gToFun
          regular := by
            intro i
            rcases (imageCoordinatePreimage i).representedBy with ⟨p, hp⟩
            refine ⟨p, ?_⟩
            intro y
            have hqy : imageCoordinatePreimage i y =
                coordinatePolynomialFunction G i (gToFun y) := by
              have hq' := congrArg
                (fun q : Variety.PolynomialFunction G ↦ q (gToFun y))
                (imageCoordinatePreimage_pullback i)
              change imageCoordinatePreimage i (r.onPoints (gToFun y)) =
                coordinatePolynomialFunction G i (gToFun y) at hq'
              simpa [Variety.PolynomialFunction.pullback, hpreimage y] using hq'
            have hpy : imageCoordinatePreimage i y = evalPolynomial y.val p := hp y
            rw [hpy] at hqy
            simpa [coordinatePolynomialFunction,
              Variety.PolynomialFunction.ofPolynomial,
              Variety.PolynomialFunction.toFun, evalPolynomial] using hqy.symm }
      map_one := by
        apply coordinateTranslationRepresentationMorphism_injective G
        have h1 := congrArg I.inclusion.onPoints
          (hpreimage (1 : Variety.Point I.carrierVariety))
        simpa [r,
          AlgebraicGroup.Morphism.codRestrictClosedSubgroup_inclusion_apply]
          using h1
      map_mul := by
        intro x y
        apply coordinateTranslationRepresentationMorphism_injective G
        have hx : f.onPoints (gToFun x) = I.inclusion.onPoints x := by
          simpa [r,
            AlgebraicGroup.Morphism.codRestrictClosedSubgroup_inclusion_apply]
            using congrArg I.inclusion.onPoints (hpreimage x)
        have hy : f.onPoints (gToFun y) = I.inclusion.onPoints y := by
          simpa [r,
            AlgebraicGroup.Morphism.codRestrictClosedSubgroup_inclusion_apply]
            using congrArg I.inclusion.onPoints (hpreimage y)
        calc
          f.onPoints (gToFun (x * y)) = I.inclusion.onPoints (x * y) := by
            simpa [r,
              AlgebraicGroup.Morphism.codRestrictClosedSubgroup_inclusion_apply]
              using congrArg I.inclusion.onPoints (hpreimage (x * y))
          _ = I.inclusion.onPoints x * I.inclusion.onPoints y := by
            exact (I.inclusion.map_mul x y).symm
          _ = f.onPoints (gToFun x * gToFun y) := by
            rw [MonoidHom.map_mul f.onPoints, hx, hy] }
  have hgf (x : Variety.Point G) : g.onPoints (r.onPoints x) = x := by
    apply coordinateTranslationRepresentationMorphism_injective G
    have h := congrArg I.inclusion.onPoints (hpreimage (r.onPoints x))
    rw [AlgebraicGroup.Morphism.codRestrictClosedSubgroup_inclusion_apply] at h
    exact h
  have hfg (y : Variety.Point I.carrierVariety) : r.onPoints (g.onPoints y) = y := by
    apply I.inclusion_injective
    rw [AlgebraicGroup.Morphism.codRestrictClosedSubgroup_inclusion_apply]
    have h := congrArg I.inclusion.onPoints (hpreimage y)
    rw [AlgebraicGroup.Morphism.codRestrictClosedSubgroup_inclusion_apply] at h
    exact h
  exact ⟨{ hom := r, inv := g, hom_inv_id := hgf, inv_hom_id := hfg }, rfl⟩

/-- GLS Definition 1.1.1: an algebraic group is realizable as a closed
subgroup of a finite-dimensional general linear group. -/
@[expose]
public noncomputable def IsClosedSubgroupOfGeneralLinear
    (V : Variety k) [AlgebraicGroup V] : Prop :=
  ∃ n : ℕ, ∃ H : ClosedSubgroup (glVariety n : Variety k),
    letI := H.carrierAlgebraicGroup
    Nonempty (AlgebraicGroup.Iso V H.carrierVariety)

/-- Every algebraic group has the closed general-linear realization of GLS
Definition 1.1.1. -/
public theorem algebraicGroup_isClosedSubgroupOfGeneralLinear
    (G : Variety k) [AlgebraicGroup G] :
    IsClosedSubgroupOfGeneralLinear G := by
  let f := coordinateTranslationRepresentationMorphism G
  let I := f.imageClosedSubgroup
  let n := Module.finrank k (coordinateTranslationSubmodule G)
  refine ⟨n, I, ?_⟩
  exact ⟨(coordinateTranslationRepresentationMorphism_iso_imageClosedSubgroup G).choose⟩

end Theory.AlgebraicGroup
