module

public import Theory.AlgebraicGroup.RightTranslation.Exterior

universe u v w

/-! Invariant spans of orbits in linear representations. -/

namespace Theory.AlgebraicGroup

section

variable {k : Type u} [Field k]
variable {Γ : Type v} [Group Γ]
variable {V : Type w} [AddCommGroup V] [Module k V]

@[expose]
public def linearRepresentationOrbitVector
    (ρ : Γ →* LinearMap.GeneralLinearGroup k V) (v : V) (g : Γ) : V :=
  ((ρ g : LinearMap.GeneralLinearGroup k V) : Module.End k V) v

@[expose]
public def linearRepresentationOrbitSpan
    (ρ : Γ →* LinearMap.GeneralLinearGroup k V) (v : V) : Submodule k V :=
  Submodule.span k (Set.range (linearRepresentationOrbitVector ρ v))

public lemma linearRepresentationOrbitVector_mem_span
    (ρ : Γ →* LinearMap.GeneralLinearGroup k V) (v : V) (g : Γ) :
    linearRepresentationOrbitVector ρ v g ∈ linearRepresentationOrbitSpan ρ v :=
  Submodule.subset_span ⟨g, rfl⟩

public lemma linearRepresentationOrbitSpan_map_eq
    (ρ : Γ →* LinearMap.GeneralLinearGroup k V) (v : V) (g : Γ) :
    Submodule.map ((ρ g : LinearMap.GeneralLinearGroup k V) : Module.End k V)
      (linearRepresentationOrbitSpan ρ v) = linearRepresentationOrbitSpan ρ v := by
  have hle : ∀ a : Γ,
      Submodule.map ((ρ a : LinearMap.GeneralLinearGroup k V) : Module.End k V)
        (linearRepresentationOrbitSpan ρ v) ≤ linearRepresentationOrbitSpan ρ v := by
    intro a
    rw [Submodule.map_le_iff_le_comap]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨x, rfl⟩
    change ((ρ a : LinearMap.GeneralLinearGroup k V) : Module.End k V)
      (linearRepresentationOrbitVector ρ v x) ∈ linearRepresentationOrbitSpan ρ v
    rw [linearRepresentationOrbitVector]
    change (((ρ a) * (ρ x) : LinearMap.GeneralLinearGroup k V) : Module.End k V) v ∈
      linearRepresentationOrbitSpan ρ v
    rw [← map_mul]
    exact linearRepresentationOrbitVector_mem_span ρ v (a * x)
  apply le_antisymm (hle g)
  intro x hx
  let y := ((ρ g⁻¹ : LinearMap.GeneralLinearGroup k V) : Module.End k V) x
  have hy : y ∈ linearRepresentationOrbitSpan ρ v := hle g⁻¹ ⟨x, hx, rfl⟩
  refine ⟨y, hy, ?_⟩
  change (((ρ g) * (ρ g⁻¹) : LinearMap.GeneralLinearGroup k V) : Module.End k V) x = x
  rw [← map_mul]
  simp

end

variable {k : Type u} [Field k] [IsAlgClosed k]

/-! The finite-dimensional right-translation representation generated by one
polynomial function. -/

public noncomputable def rightTranslateOrbitLinearMap
    (G : Variety k) [AlgebraicGroup G]
    (f : Variety.PolynomialFunction G) (x : Variety.Point G) :
    rightTranslateOrbitSpan G f →ₗ[k] rightTranslateOrbitSpan G f :=
  (rightMulMorphism G x).pullbackAlgHom.toLinearMap.restrict
    (fun q hq ↦ rightTranslateOrbitSpan_stable G f x q hq)

public noncomputable def rightTranslateOrbitRepresentation
    (G : Variety k) [AlgebraicGroup G]
    (f : Variety.PolynomialFunction G) :
    Representation k (Variety.Point G) (rightTranslateOrbitSpan G f) where
  toFun := rightTranslateOrbitLinearMap G f
  map_one' := by
    ext q g
    change q.1 (g * 1) = q.1 g
    rw [mul_one]
  map_mul' := by
    intro x h
    ext q g
    change q.1 (g * (x * h)) = q.1 ((g * x) * h)
    rw [mul_assoc]

/-! The invariant linear span of the affine Plücker orbit. -/

section

open scoped ExteriorAlgebra

variable {k : Type u} [Field k] [IsAlgClosed k]

@[expose]
public noncomputable def ClosedSubgroup.rightTranslateVanishingPluckerOrbitVector
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G)
    (g : Variety.Point G) :
    ⋀[k]^H.rightTranslateVanishingTopWedgeData.degree
      H.rightTranslateVanishingSpan :=
  linearRepresentationOrbitVector
    H.rightTranslateVanishingExteriorGeneralLinear
    H.rightTranslateVanishingPluckerVector g

@[expose]
public noncomputable def ClosedSubgroup.rightTranslateVanishingPluckerOrbitSpan
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G) :
    Submodule k
      (⋀[k]^H.rightTranslateVanishingTopWedgeData.degree
        H.rightTranslateVanishingSpan) :=
  linearRepresentationOrbitSpan
    H.rightTranslateVanishingExteriorGeneralLinear
    H.rightTranslateVanishingPluckerVector

omit [IsAlgClosed k] in
public lemma ClosedSubgroup.rightTranslateVanishingPluckerOrbitVector_mem_span
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G)
    (g : Variety.Point G) :
    H.rightTranslateVanishingPluckerOrbitVector g ∈
      H.rightTranslateVanishingPluckerOrbitSpan :=
  linearRepresentationOrbitVector_mem_span
    H.rightTranslateVanishingExteriorGeneralLinear
    H.rightTranslateVanishingPluckerVector g

omit [IsAlgClosed k] in
public lemma ClosedSubgroup.rightTranslateVanishingPluckerOrbitSpan_stable
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G)
    (g : Variety.Point G) :
    Submodule.map
      ((H.rightTranslateVanishingExteriorGeneralLinear g :
        LinearMap.GeneralLinearGroup k
          (⋀[k]^H.rightTranslateVanishingTopWedgeData.degree
            H.rightTranslateVanishingSpan)) :
        Module.End k
          (⋀[k]^H.rightTranslateVanishingTopWedgeData.degree
            H.rightTranslateVanishingSpan))
      H.rightTranslateVanishingPluckerOrbitSpan =
        H.rightTranslateVanishingPluckerOrbitSpan :=
  linearRepresentationOrbitSpan_map_eq
    H.rightTranslateVanishingExteriorGeneralLinear
    H.rightTranslateVanishingPluckerVector g

end

/-! Matrix multiplication evaluated on the affine Plücker orbit. -/

section

open scoped ExteriorAlgebra BigOperators

variable {k : Type u} [Field k] [IsAlgClosed k]

omit [IsAlgClosed k] in
public lemma ClosedSubgroup.rightTranslateVanishingExteriorRepresentationMatrix_mul_repr_eq_pluckerOrbit
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G)
    (i : Fin (Fintype.card H.rightTranslateVanishingExteriorIndex))
    (g : Variety.Point G) :
    ∑ j, (H.rightTranslateVanishingExteriorBasis.repr
      H.rightTranslateVanishingPluckerVector j) *
      H.rightTranslateVanishingExteriorRepresentationMatrix g i j =
      H.rightTranslateVanishingExteriorBasis.repr
        (H.rightTranslateVanishingPluckerOrbitVector g) i := by
  rw [ClosedSubgroup.rightTranslateVanishingPluckerOrbitVector]
  exact H.rightTranslateVanishingExteriorRepresentationMatrix_mul_repr i g

end

/-! A fixed finite basis of the affine Plücker orbit span. -/

section

variable {k : Type u} [Field k] [IsAlgClosed k]

public noncomputable instance ClosedSubgroup.rightTranslateVanishingPluckerOrbitSpan_free
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G) :
    Module.Free k H.rightTranslateVanishingPluckerOrbitSpan :=
  Module.Free.of_divisionRing k H.rightTranslateVanishingPluckerOrbitSpan

public noncomputable instance ClosedSubgroup.rightTranslateVanishingPluckerOrbitSpan_finite
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G) :
    Module.Finite k H.rightTranslateVanishingPluckerOrbitSpan :=
  Module.Finite.of_injective H.rightTranslateVanishingPluckerOrbitSpan.subtype
    H.rightTranslateVanishingPluckerOrbitSpan.injective_subtype

@[expose]
public noncomputable def ClosedSubgroup.rightTranslateVanishingPluckerOrbitSpanBasis
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G) :
    Module.Basis (Fin (Module.finrank k H.rightTranslateVanishingPluckerOrbitSpan)) k
      H.rightTranslateVanishingPluckerOrbitSpan :=
  Module.finBasis k H.rightTranslateVanishingPluckerOrbitSpan

end

/-! Ambient extensions of coordinate functionals on the Plücker orbit span. -/

section

open scoped ExteriorAlgebra

variable {k : Type u} [Field k] [IsAlgClosed k]

@[expose]
public noncomputable def ClosedSubgroup.rightTranslateVanishingPluckerOrbitSpanCoordinateExtension
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G)
    (i : Fin (Module.finrank k H.rightTranslateVanishingPluckerOrbitSpan)) :
    Module.Dual k
      (⋀[k]^H.rightTranslateVanishingTopWedgeData.degree
        H.rightTranslateVanishingSpan) :=
  Classical.choose (LinearMap.exists_extend
    (H.rightTranslateVanishingPluckerOrbitSpanBasis.coord i))

omit [IsAlgClosed k] in
public lemma ClosedSubgroup.rightTranslateVanishingPluckerOrbitSpanCoordinateExtension_apply
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G)
    (i : Fin (Module.finrank k H.rightTranslateVanishingPluckerOrbitSpan))
    (x : H.rightTranslateVanishingPluckerOrbitSpan) :
    H.rightTranslateVanishingPluckerOrbitSpanCoordinateExtension i x =
      H.rightTranslateVanishingPluckerOrbitSpanBasis.repr x i := by
  have hs := Classical.choose_spec (LinearMap.exists_extend
    (H.rightTranslateVanishingPluckerOrbitSpanBasis.coord i))
  exact LinearMap.congr_fun hs x

end

/-! Restriction of a linear representation to an invariant subspace. -/

section

variable {k : Type u} [Field k]
variable {Γ : Type v} [Group Γ]
variable {V : Type w} [AddCommGroup V] [Module k V]

@[expose]
public noncomputable def linearRepresentationRestrict
    (ρ : Γ →* LinearMap.GeneralLinearGroup k V) (S : Submodule k V)
    (hstable : ∀ g : Γ,
      Submodule.map ((ρ g : LinearMap.GeneralLinearGroup k V) : Module.End k V) S = S) :
    Γ →* LinearMap.GeneralLinearGroup k S where
  toFun g := LinearMap.GeneralLinearGroup.ofLinearEquiv
    (((ρ g).toLinearEquiv.submoduleMap S).trans
      (LinearEquiv.ofEq _ _ (hstable g)))
  map_one' := by
    apply Units.ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change ((ρ 1 : LinearMap.GeneralLinearGroup k V) : Module.End k V) (x : V) = x
    simp
  map_mul' g h := by
    apply Units.ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change ((ρ (g * h) : LinearMap.GeneralLinearGroup k V) : Module.End k V) (x : V) =
      ((ρ g : LinearMap.GeneralLinearGroup k V) : Module.End k V)
        (((ρ h : LinearMap.GeneralLinearGroup k V) : Module.End k V) (x : V))
    simp

public lemma linearRepresentationRestrict_apply_coe
    (ρ : Γ →* LinearMap.GeneralLinearGroup k V) (S : Submodule k V)
    (hstable : ∀ g : Γ,
      Submodule.map ((ρ g : LinearMap.GeneralLinearGroup k V) : Module.End k V) S = S)
    (g : Γ) (x : S) :
    (((linearRepresentationRestrict ρ S hstable g :
      LinearMap.GeneralLinearGroup k S) : Module.End k S) x : V) =
      ((ρ g : LinearMap.GeneralLinearGroup k V) : Module.End k V) x :=
  rfl

end

end Theory.AlgebraicGroup
