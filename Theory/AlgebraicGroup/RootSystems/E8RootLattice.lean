module

public import Theory.AlgebraicGroup.RootSystems.TypeE8RootPairing

/-!
# The root and weight lattices of the standard E8 pairing

For the canonical real root pairing `typeE8RootPairing`, the integral weight
module is the `ℤ`-dual of the coroot lattice, and the coweight module is the
dual of the root lattice.  Restricting roots and coroots gives integral
functionals in these two modules.

The displayed E8 Cartan matrix has the explicit integral inverse with first
row `[4, 7, 10, 5, 8, 6, 4, 2]` and the seven remaining rows displayed below.
Multiplication in both orders shows directly that the matrix is unimodular.
Evaluating an arbitrary weight or coweight on the corresponding simple basis
then expresses it as an integral combination of the simple roots or coroots.
Thus both root-datum lattice inclusions are equalities.  These are the integral
character and cocharacter statements needed to identify the simply connected
and adjoint E8 root data; no center or version classification is used.
-/

namespace Theory.AlgebraicGroup.StandardRootSystem

open Matrix Set Submodule

/-- The ambient integral weight module of the canonical E8 root pairing. -/
public abbrev typeE8WeightModule :=
  Module.Dual ℤ (typeE8RootPairing.corootSpan ℤ)

/-- A root of the canonical E8 pairing, restricted to its integral coroot
lattice. -/
@[expose] public noncomputable def typeE8RootWeight (r : typeE8Roots) :
    typeE8WeightModule :=
  typeE8RootPairing.root'In ℤ r

/-- The additive lattice generated by the canonical E8 roots inside the
weight module. -/
@[expose] public noncomputable def typeE8RootLattice :
    AddSubgroup typeE8WeightModule :=
  AddSubgroup.closure (Set.range typeE8RootWeight)

/-- The full integral weight lattice of the canonical E8 pairing. -/
@[expose] public noncomputable def typeE8WeightLattice :
    AddSubgroup typeE8WeightModule :=
  ⊤

/-- The ambient integral coweight module of the canonical E8 root pairing. -/
public abbrev typeE8CoweightModule :=
  Module.Dual ℤ (typeE8RootPairing.rootSpan ℤ)

/-- A coroot of the canonical E8 pairing, restricted to its integral root
lattice. -/
@[expose] public noncomputable def typeE8CorootCoweight (r : typeE8Roots) :
    typeE8CoweightModule :=
  typeE8RootPairing.coroot'In ℤ r

/-- The additive lattice generated by the canonical E8 coroots inside the
coweight module. -/
@[expose] public noncomputable def typeE8CorootLattice :
    AddSubgroup typeE8CoweightModule :=
  AddSubgroup.closure (Set.range typeE8CorootCoweight)

/-- The full integral coweight lattice of the canonical E8 pairing. -/
@[expose] public noncomputable def typeE8CoweightLattice :
    AddSubgroup typeE8CoweightModule :=
  ⊤

private def typeE8CartanInverse : Matrix (Fin 8) (Fin 8) ℤ :=
  !![4, 7, 10, 5, 8, 6, 4, 2;
    7, 14, 20, 10, 16, 12, 8, 4;
    10, 20, 30, 15, 24, 18, 12, 6;
    5, 10, 15, 8, 12, 9, 6, 3;
    8, 16, 24, 12, 20, 15, 10, 5;
    6, 12, 18, 9, 15, 12, 8, 4;
    4, 8, 12, 6, 10, 8, 6, 3;
    2, 4, 6, 3, 5, 4, 3, 2]

private lemma typeE8CartanInverse_mul :
    typeE8CartanInverse * typeE8CartanMatrix = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [typeE8CartanInverse, typeE8CartanMatrix, Matrix.mul_apply,
      Fin.sum_univ_succ] <;> simp

private lemma typeE8CartanMatrix_mul_inverse :
    typeE8CartanMatrix * typeE8CartanInverse = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [typeE8CartanInverse, typeE8CartanMatrix, Matrix.mul_apply,
      Fin.sum_univ_succ] <;> simp

/-- For E8 the root lattice equals the full weight lattice.  Equivalently,
every integral functional on the coroot lattice is an integral linear
combination of roots. -/
public theorem typeE8_rootLattice_eq_weightLattice :
    typeE8RootLattice = typeE8WeightLattice := by
  rw [typeE8WeightLattice]
  apply top_unique
  intro f _
  let simpleCombination : typeE8WeightModule :=
    ∑ k : Fin 8,
      f (typeE8RootPairing.corootSpanMem ℤ (typeE8RootPairing_baseEquiv k)) •
        ∑ i : Fin 8, typeE8CartanInverse k i •
          typeE8RootWeight (typeE8RootPairing_baseEquiv i)
  have hCombination : simpleCombination = f := by
    apply (typeE8RootPairing_base.flip.toWeightBasisInt).ext
    intro j
    let j' : Fin 8 := typeE8RootPairing_baseEquiv.symm j
    have hj : typeE8RootPairing_baseEquiv j' = j :=
      typeE8RootPairing_baseEquiv.apply_symm_apply j
    have hjBasis : typeE8RootPairing_base.flip.toWeightBasisInt j =
        typeE8RootPairing.corootSpanMem ℤ j := by
      apply Subtype.ext
      simp
    have hcoeff (k : Fin 8) :
        ∑ i : Fin 8, typeE8CartanInverse k i * typeE8CartanMatrix i j' =
          if k = j' then 1 else 0 := by
      have h := congrFun (congrFun typeE8CartanInverse_mul k) j'
      simpa [Matrix.mul_apply, Matrix.one_apply] using h
    rw [hjBasis]
    change (∑ k : Fin 8,
      f (typeE8RootPairing.corootSpanMem ℤ (typeE8RootPairing_baseEquiv k)) *
        ∑ i : Fin 8, typeE8CartanInverse k i *
          typeE8RootPairing.pairingIn ℤ (typeE8RootPairing_baseEquiv i) j) =
      f (typeE8RootPairing.corootSpanMem ℤ j)
    rw [← hj]
    simp_rw [← RootPairing.Base.cartanMatrixIn_def,
      typeE8RootPairing_base_cartan_apply]
    simp_rw [hcoeff]
    simp
  rw [← hCombination]
  apply AddSubgroup.sum_mem
  intro k _
  apply AddSubgroup.zsmul_mem
  apply AddSubgroup.sum_mem
  intro i _
  apply AddSubgroup.zsmul_mem
  exact AddSubgroup.subset_closure ⟨typeE8RootPairing_baseEquiv i, rfl⟩

/-- For E8 the coroot lattice equals the full coweight lattice.  Equivalently,
every integral functional on the root lattice is an integral linear
combination of coroots. -/
public theorem typeE8_corootLattice_eq_coweightLattice :
    typeE8CorootLattice = typeE8CoweightLattice := by
  rw [typeE8CoweightLattice]
  apply top_unique
  intro f _
  let simpleCombination : typeE8CoweightModule :=
    ∑ k : Fin 8,
      f (typeE8RootPairing.rootSpanMem ℤ (typeE8RootPairing_baseEquiv k)) •
        ∑ i : Fin 8, typeE8CartanInverse i k •
          typeE8CorootCoweight (typeE8RootPairing_baseEquiv i)
  have hCombination : simpleCombination = f := by
    apply typeE8RootPairing_base.toWeightBasisInt.ext
    intro j
    let j' : Fin 8 := typeE8RootPairing_baseEquiv.symm j
    have hj : typeE8RootPairing_baseEquiv j' = j :=
      typeE8RootPairing_baseEquiv.apply_symm_apply j
    have hjBasis : typeE8RootPairing_base.toWeightBasisInt j =
        typeE8RootPairing.rootSpanMem ℤ j := by
      apply Subtype.ext
      simp
    have hcoeff (k : Fin 8) :
        ∑ i : Fin 8, typeE8CartanMatrix j' i * typeE8CartanInverse i k =
          if j' = k then 1 else 0 := by
      have h := congrFun (congrFun typeE8CartanMatrix_mul_inverse j') k
      simpa [Matrix.mul_apply, Matrix.one_apply] using h
    have hcoeff' (k : Fin 8) :
        ∑ i : Fin 8, typeE8CartanInverse i k * typeE8CartanMatrix j' i =
          if j' = k then 1 else 0 := by
      rw [← hcoeff k]
      apply Finset.sum_congr rfl
      intro i _
      exact mul_comm _ _
    rw [hjBasis]
    change (∑ k : Fin 8,
      f (typeE8RootPairing.rootSpanMem ℤ (typeE8RootPairing_baseEquiv k)) *
        ∑ i : Fin 8, typeE8CartanInverse i k *
          typeE8RootPairing.pairingIn ℤ j (typeE8RootPairing_baseEquiv i)) =
      f (typeE8RootPairing.rootSpanMem ℤ j)
    rw [← hj]
    simp_rw [← RootPairing.Base.cartanMatrixIn_def,
      typeE8RootPairing_base_cartan_apply]
    simp_rw [hcoeff']
    simp
  rw [← hCombination]
  apply AddSubgroup.sum_mem
  intro k _
  apply AddSubgroup.zsmul_mem
  apply AddSubgroup.sum_mem
  intro i _
  apply AddSubgroup.zsmul_mem
  exact AddSubgroup.subset_closure ⟨typeE8RootPairing_baseEquiv i, rfl⟩

/-- The exact integral E8 root-datum endpoint: roots generate every integral
character on the coroot lattice, and coroots generate every integral
cocharacter on the root lattice. -/
public theorem typeE8_integral_character_cocharacter_lattices :
    typeE8RootLattice = typeE8WeightLattice ∧
      typeE8CorootLattice = typeE8CoweightLattice :=
  ⟨typeE8_rootLattice_eq_weightLattice,
    typeE8_corootLattice_eq_coweightLattice⟩

end Theory.AlgebraicGroup.StandardRootSystem
