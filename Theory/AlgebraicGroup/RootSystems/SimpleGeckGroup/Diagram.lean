module
public import Theory.AlgebraicGroup.RootSystems.SimpleGeckGroup
public import Theory.AlgebraicGroup.RootSystems.GeckDiagramEquivariance

/-!
# Pinned diagram automorphisms of simple-root Geck groups

Reindexing the Cartan-plus-root lattice carries each simple-root divided-power
curve to the curve at the permuted simple root. Hence it preserves the generated
matrix group. Restriction gives a group automorphism, commuting with every
coefficient map. In particular this supplies the graph part of the D4 triality
construction without choosing paths to nonsimple roots.

Source: GLS3 §§1.12 and 2.1–2.3, using the integral Geck construction.
-/

@[expose] public section
noncomputable section
set_option linter.unusedSectionVars false
namespace RootPairing.SimpleGeckGroup
open IntegralGeckConstruction
variable {ι R M N : Type*} [CommRing R] [IsDomain R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [P.IsCrystallographic] [P.IsReduced]
  {b : P.Base} [Fintype ι] [DecidableEq ι]
variable (d : P.Equiv P) (db : b.support ≃ b.support)
  (hd : ∀ i : b.support, d.indexEquiv i = (db i : ι))
variable {S T : Type*} [CommRing S] [CommRing T]

private theorem diagram_smul (t : S) (A : Matrix (b.support ⊕ ι) (b.support ⊕ ι) S) :
    diagramMatrixEquiv d db S (t • A) = t • diagramMatrixEquiv d db S A := rfl

include hd

@[simp] theorem diagram_positiveMatrix (i : b.support) (t : S) :
    diagramMatrixEquiv d db S (positiveMatrix i t) = positiveMatrix (db i) t := by
  simp only [positiveMatrix_formula, map_add, map_one, diagram_smul,
    diagramMatrixEquiv_map, diagram_eDividedPower d db hd]

@[simp] theorem diagram_negativeMatrix (i : b.support) (t : S) :
    diagramMatrixEquiv d db S (negativeMatrix i t) = negativeMatrix (db i) t := by
  simp only [negativeMatrix_formula, map_add, map_one, diagram_smul,
    diagramMatrixEquiv_map, diagram_fDividedPower d db hd]

@[simp] theorem diagram_positiveUnit (i : b.support) (t : S) :
    diagramUnitsEquiv d db S (positiveUnit i t) = positiveUnit (db i) t :=
  Units.ext (diagram_positiveMatrix d db hd i t)

@[simp] theorem diagram_negativeUnit (i : b.support) (t : S) :
    diagramUnitsEquiv d db S (negativeUnit i t) = negativeUnit (db i) t :=
  Units.ext (diagram_negativeMatrix d db hd i t)

private theorem diagram_unit (i : Bool × b.support) (t : S) :
    diagramUnitsEquiv d db S ((simpleFamily (b := b)).unit i t) =
      (simpleFamily (b := b)).unit (i.1, db i.2) t := by
  rcases i with ⟨s,i⟩
  cases s
  · exact diagram_negativeUnit d db hd i t
  · exact diagram_positiveUnit d db hd i t

/-- The pinned diagram action preserves the subgroup generated by the simple roots. -/
theorem diagram_subgroup :
    (subgroup b S).map (diagramUnitsEquiv d db S).toMonoidHom = subgroup b S := by
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i,t,rfl⟩
    change diagramUnitsEquiv d db S ((simpleFamily (b := b)).unit i t) ∈ subgroup b S
    rw [diagram_unit d db hd]
    exact (simpleFamily (b := b)).unit_mem _ _
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨s,i⟩,t,rfl⟩
    refine ⟨(simpleFamily (b := b)).unit (s, db.symm i) t,
      (simpleFamily (b := b)).unit_mem _ _, ?_⟩
    change diagramUnitsEquiv d db S ((simpleFamily (b := b)).unit (s, db.symm i) t) = _
    simp only [diagram_unit d db hd, Equiv.apply_symm_apply]

/-- The diagram automorphism on the root-generated group. -/
def diagramEquiv : Carrier b S ≃* Carrier b S :=
  ((diagramUnitsEquiv d db S).subgroupMap (subgroup b S)).trans
    (MulEquiv.subgroupCongr (diagram_subgroup d db hd))

@[simp] theorem diagramEquiv_val (g : Carrier b S) :
    (diagramEquiv d db hd g).val = diagramUnitsEquiv d db S g.val := rfl

@[simp] theorem diagramEquiv_positive (i : b.support) (t : S) :
    diagramEquiv d db hd (positive i t) = positive (db i) t :=
  Subtype.ext (diagram_positiveUnit d db hd i t)

@[simp] theorem diagramEquiv_negative (i : b.support) (t : S) :
    diagramEquiv d db hd (negative i t) = negative (db i) t :=
  Subtype.ext (diagram_negativeUnit d db hd i t)

/-- Entrywise coefficient maps commute with the pinned diagram action. -/
theorem diagramEquiv_map (f : S →+* T) (g : Carrier b S) :
    diagramEquiv d db hd (map f g) = map f (diagramEquiv d db hd g) := by
  apply Subtype.ext
  exact diagramUnitsEquiv_map d db f g.val

/-- The same commutation statement for coefficient equivalences. -/
theorem diagramEquiv_equiv (f : S ≃+* T) (g : Carrier b S) :
    diagramEquiv d db hd (equiv f g) = equiv f (diagramEquiv d db hd g) :=
  diagramEquiv_map d db hd f.toRingHom g

/-- A diagram whose root and base permutations have cube one also has cube one
on the generated group. -/
theorem diagramEquiv_three
    (hr : ∀ i, d.indexEquiv (d.indexEquiv (d.indexEquiv i)) = i)
    (hb : ∀ i, db (db (db i)) = i) (g : Carrier b S) :
    diagramEquiv d db hd (diagramEquiv d db hd (diagramEquiv d db hd g)) = g := by
  let e := diagramIndexEquiv d db
  have he (i) : e (e (e i)) = i := by
    rcases i with i | i <;> simp [e, hr, hb]
  apply Subtype.ext
  apply Units.ext
  change diagramMatrixEquiv d db S (diagramMatrixEquiv d db S
    (diagramMatrixEquiv d db S g.val.val)) = g.val.val
  ext j k
  calc
    _ = diagramMatrixEquiv d db S (diagramMatrixEquiv d db S
        (diagramMatrixEquiv d db S g.val.val)) (e (e (e j))) (e (e (e k))) := by
      rw [he, he]
    _ = g.val.val j k := by simp only [e, diagramMatrixEquiv_apply]

omit hd in
/-- A coefficient automorphism with cube one induces a group automorphism
with cube one. -/
theorem equiv_three (f : S ≃+* S) (hf : ∀ t, f (f (f t)) = t) (g : Carrier b S) :
    equiv f (equiv f (equiv f g)) = g := by
  apply Subtype.ext
  apply Units.ext
  ext j k
  exact hf (g.val.val j k)

end RootPairing.SimpleGeckGroup
