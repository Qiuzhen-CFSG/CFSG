module

public import Mathlib.Data.Matrix.Basic
public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.Algebra.GroupWithZero.Units.Fintype
public import Mathlib.Tactic.Module
public import Mathlib.Tactic.NormNum

/-!
# Groups generated by integral cubic divided-power curves

This is the coefficient-ring part of the simple-root Geck construction. Integral
matrix families satisfying divided-power convolution and vanishing in degree four
specialize to additive polynomial curves over every commutative ring. Their values
are units, and the subgroup they generate is functorial in the coefficient ring.

The proof expands the cubic convolution without division; in particular it applies
in characteristics two and three. The integral root-string matrices are supplied by
the separate Geck construction. See GLS3 §§1.12 and 2.1–2.3. The cubic expansion is
adapted from `Borel/IntegralChevalleyRootCurves.lean`, with no all-root dependencies.
-/

@[expose] public section

namespace RootPairing.SimpleGeckGroup

variable {κ n : Type*} [Fintype n] [DecidableEq n]

/-- An integral family of divided powers truncated above degree three. -/
structure IntegralCubicFamily (κ n : Type*) [Fintype n] [DecidableEq n] where
  dividedPower : κ → ℕ → Matrix n n ℤ
  mul : ∀ i a b, dividedPower i a * dividedPower i b =
    (a + b).choose a • dividedPower i (a + b)
  vanish : ∀ i a, 4 ≤ a → dividedPower i a = 0

namespace IntegralCubicFamily

variable (D : IntegralCubicFamily κ n)
variable {S T U : Type*} [CommRing S] [CommRing T] [CommRing U]

/-- Extend the integral coefficients to the target ring. -/
def coefficient (i : κ) (a : ℕ) : Matrix n n S :=
  (D.dividedPower i a).map (Int.castRingHom S)

lemma coefficient_mul (i : κ) (a b : ℕ) :
    D.coefficient (S := S) i a * D.coefficient i b =
      ((a + b).choose a : S) • D.coefficient i (a + b) := by
  rw [coefficient, coefficient, ← Matrix.map_mul, D.mul]
  ext x y
  change ((((a + b).choose a : ℤ) * D.dividedPower i (a + b) x y : ℤ) : S) =
    ((a + b).choose a : S) * (D.dividedPower i (a + b) x y : S)
  rw [Int.cast_mul, Int.cast_natCast]

lemma coefficient_vanish (i : κ) (a : ℕ) (ha : 4 ≤ a) :
    D.coefficient (S := S) i a = 0 := by
  simp [coefficient, D.vanish i a ha]

/-- The degree-three, division-free exponential. -/
def curve (i : κ) (t : S) : Matrix n n S :=
  1 + t • D.coefficient i 1 + t ^ 2 • D.coefficient i 2 +
    t ^ 3 • D.coefficient i 3

@[simp] theorem curve_zero (i : κ) : D.curve (S := S) i 0 = 1 := by
  simp [curve]

/-- Divided-power convolution gives the additive parameter law. -/
theorem curve_add (i : κ) (s t : S) :
    D.curve i (s + t) = D.curve i s * D.curve i t := by
  have h11 : D.coefficient (S := S) i 1 * D.coefficient i 1 =
      (2 : S) • D.coefficient i 2 := by simpa using D.coefficient_mul (S := S) i 1 1
  have h12 : D.coefficient (S := S) i 1 * D.coefficient i 2 =
      (3 : S) • D.coefficient i 3 := by simpa using D.coefficient_mul (S := S) i 1 2
  have h21 : D.coefficient (S := S) i 2 * D.coefficient i 1 =
      (3 : S) • D.coefficient i 3 := by simpa using D.coefficient_mul (S := S) i 2 1
  have hz (a b : ℕ) (h : 4 ≤ a + b) :
      D.coefficient (S := S) i a * D.coefficient i b = 0 := by
    rw [D.coefficient_mul, D.coefficient_vanish i (a + b) h, smul_zero]
  simp only [curve, add_mul, mul_add, one_mul, mul_one, smul_mul_assoc,
    mul_smul_comm, smul_smul, h11, h12, h21,
    hz 1 3 (by decide), hz 3 1 (by decide), hz 2 2 (by decide),
    hz 2 3 (by decide), hz 3 2 (by decide), hz 3 3 (by decide)]
  module

@[simp] theorem curve_mul_neg (i : κ) (t : S) :
    D.curve i t * D.curve i (-t) = 1 := by
  rw [← D.curve_add, add_neg_cancel, D.curve_zero]

@[simp] theorem curve_neg_mul (i : κ) (t : S) :
    D.curve i (-t) * D.curve i t = 1 := by
  rw [← D.curve_add, neg_add_cancel, D.curve_zero]

/-- A curve value together with its polynomial inverse. -/
def unit (i : κ) (t : S) : (Matrix n n S)ˣ where
  val := D.curve i t
  inv := D.curve i (-t)
  val_inv := D.curve_mul_neg i t
  inv_val := D.curve_neg_mul i t

@[simp] theorem unit_val (i : κ) (t : S) : (D.unit i t).val = D.curve i t := rfl

@[simp] theorem unit_zero (i : κ) : D.unit (S := S) i 0 = 1 :=
  Units.ext (D.curve_zero i)

theorem unit_add (i : κ) (s t : S) :
    D.unit i (s + t) = D.unit i s * D.unit i t :=
  Units.ext (D.curve_add i s t)

@[simp] theorem unit_inv (i : κ) (t : S) : (D.unit i t)⁻¹ = D.unit i (-t) :=
  Units.ext rfl

/-- The subgroup generated by all the curves of the given integral family. -/
def subgroup (S : Type*) [CommRing S] : Subgroup (Matrix n n S)ˣ :=
  Subgroup.closure {g | ∃ i t, g = D.unit i t}

/-- The matrix group generated by the integral cubic family. -/
abbrev Carrier (S : Type*) [CommRing S] := D.subgroup S

instance : Group (D.Carrier S) := inferInstance

instance [Finite S] : Finite (D.Carrier S) := inferInstance

noncomputable instance [Fintype S] : Fintype (D.Carrier S) := Fintype.ofFinite _

theorem unit_mem (i : κ) (t : S) : D.unit i t ∈ D.subgroup S :=
  Subgroup.subset_closure ⟨i, t, rfl⟩

/-- A curve value as an element of the generated group. -/
def generator (i : κ) (t : S) : D.Carrier S := ⟨D.unit i t, D.unit_mem i t⟩

@[simp] theorem map_coefficient (f : S →+* T) (i : κ) (a : ℕ) :
    (D.coefficient (S := S) i a).map f = D.coefficient (S := T) i a := by
  ext x y
  simp [coefficient]

@[simp] theorem map_curve (f : S →+* T) (i : κ) (t : S) :
    (D.curve i t).map f = D.curve i (f t) := by
  ext x y
  simp [curve, coefficient, Matrix.one_apply, apply_ite f]

/-- Entrywise coefficient mapping on ambient matrix units. -/
def mapUnits (f : S →+* T) : (Matrix n n S)ˣ →* (Matrix n n T)ˣ :=
  Units.map f.mapMatrix.toMonoidHom

@[simp] theorem mapUnits_unit (f : S →+* T) (i : κ) (t : S) :
    mapUnits f (D.unit i t) = D.unit i (f t) :=
  Units.ext (D.map_curve f i t)

lemma mapUnits_mem (f : S →+* T) {g : (Matrix n n S)ˣ}
    (hg : g ∈ D.subgroup S) : mapUnits f g ∈ D.subgroup T := by
  have h : D.subgroup S ≤ (D.subgroup T).comap (mapUnits f) := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, t, rfl⟩
    change mapUnits f (D.unit i t) ∈ D.subgroup T
    rw [D.mapUnits_unit]
    exact D.unit_mem i (f t)
  exact h hg

/-- Coefficient ring homomorphisms induce homomorphisms of generated groups. -/
def map (f : S →+* T) : D.Carrier S →* D.Carrier T where
  toFun g := ⟨mapUnits f g.val, D.mapUnits_mem f g.property⟩
  map_one' := Subtype.ext (map_one (mapUnits f))
  map_mul' g h := Subtype.ext (map_mul (mapUnits f) g.val h.val)

@[simp] theorem map_generator (f : S →+* T) (i : κ) (t : S) :
    D.map f (D.generator i t) = D.generator i (f t) :=
  Subtype.ext (D.mapUnits_unit f i t)

@[simp] theorem map_id (g : D.Carrier S) : D.map (RingHom.id S) g = g := by
  apply Subtype.ext
  apply Units.ext
  rfl

@[simp] theorem map_comp (f : T →+* U) (e : S →+* T) (g : D.Carrier S) :
    D.map f (D.map e g) = D.map (f.comp e) g := by
  apply Subtype.ext
  apply Units.ext
  rfl

/-- A coefficient-ring equivalence induces a group equivalence. Automorphisms
of the coefficient ring give automorphisms of the same generated group. -/
def equiv (e : S ≃+* T) : D.Carrier S ≃* D.Carrier T where
  toFun := D.map e.toRingHom
  invFun := D.map e.symm.toRingHom
  left_inv g := by
    apply Subtype.ext
    apply Units.ext
    ext x y
    exact e.symm_apply_apply _
  right_inv g := by
    apply Subtype.ext
    apply Units.ext
    ext x y
    exact e.apply_symm_apply _
  map_mul' := (D.map e.toRingHom).map_mul

@[simp] theorem equiv_generator (e : S ≃+* T) (i : κ) (t : S) :
    D.equiv e (D.generator i t) = D.generator i (e t) :=
  D.map_generator e.toRingHom i t

end IntegralCubicFamily
end RootPairing.SimpleGeckGroup
