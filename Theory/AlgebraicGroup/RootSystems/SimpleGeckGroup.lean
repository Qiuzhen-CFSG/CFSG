module

public import Theory.AlgebraicGroup.RootSystems.IntegralGeckConstruction
public import Theory.AlgebraicGroup.RootSystems.SimpleGeckGroup.IntegralCurves

/-!
# Simple-root Geck groups over arbitrary coefficient rings

For a finite reduced crystallographic pairing with base `b`, specialize Geck's
integral divided powers along `ℤ → S`. The positive and negative degree-three
exponentials generate a subgroup of units in the matrix ring on `b.support ⊕ ι`.
Their addition and inversion laws, and coefficient-ring functoriality, hold over
all commutative rings, including characteristics two and three.

The integral convolution and vanishing identities discharge the hypotheses of
`IntegralCubicFamily`; no all-root route choices or varieties are needed.
Reference: GLS3 §§1.12 and 2.1–2.3, the standard integral Chevalley construction.
-/

@[expose] public section

noncomputable section

namespace RootPairing.SimpleGeckGroup

variable {ι R M N : Type*} [CommRing R] [IsDomain R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [P.IsCrystallographic] [P.IsReduced]
  {b : P.Base} [Fintype ι] [DecidableEq ι]

/-- Both simple-root directions: `true` denotes the positive direction. -/
def simpleFamily : IntegralCubicFamily (Bool × b.support) (b.support ⊕ ι) where
  dividedPower
    | (true, i), a => IntegralGeckConstruction.eDividedPower i a
    | (false, i), a => IntegralGeckConstruction.fDividedPower i a
  mul := by
    rintro ⟨s, i⟩ a c
    cases s
    · exact IntegralGeckConstruction.fDividedPower_mul i a c
    · exact IntegralGeckConstruction.eDividedPower_mul i a c
  vanish := by
    rintro ⟨s, i⟩ a ha
    cases s
    · exact IntegralGeckConstruction.fDividedPower_eq_zero_of_four_le i ha
    · exact IntegralGeckConstruction.eDividedPower_eq_zero_of_four_le i ha

variable {S T : Type*} [CommRing S] [CommRing T]

/-- The positive simple-root polynomial exponential over `S`. -/
def positiveMatrix (i : b.support) (t : S) : Matrix (b.support ⊕ ι) (b.support ⊕ ι) S :=
  (simpleFamily (b := b)).curve (true, i) t

/-- The negative simple-root polynomial exponential over `S`. -/
def negativeMatrix (i : b.support) (t : S) : Matrix (b.support ⊕ ι) (b.support ⊕ ι) S :=
  (simpleFamily (b := b)).curve (false, i) t

theorem positiveMatrix_formula (i : b.support) (t : S) :
    positiveMatrix i t = 1 +
      t • (IntegralGeckConstruction.eDividedPower i 1).map (Int.castRingHom S) +
      t ^ 2 • (IntegralGeckConstruction.eDividedPower i 2).map (Int.castRingHom S) +
      t ^ 3 • (IntegralGeckConstruction.eDividedPower i 3).map (Int.castRingHom S) := rfl

theorem negativeMatrix_formula (i : b.support) (t : S) :
    negativeMatrix i t = 1 +
      t • (IntegralGeckConstruction.fDividedPower i 1).map (Int.castRingHom S) +
      t ^ 2 • (IntegralGeckConstruction.fDividedPower i 2).map (Int.castRingHom S) +
      t ^ 3 • (IntegralGeckConstruction.fDividedPower i 3).map (Int.castRingHom S) := rfl

@[simp] theorem positiveMatrix_zero (i : b.support) : positiveMatrix (S := S) i 0 = 1 :=
  (simpleFamily (b := b)).curve_zero _

@[simp] theorem negativeMatrix_zero (i : b.support) : negativeMatrix (S := S) i 0 = 1 :=
  (simpleFamily (b := b)).curve_zero _

theorem positiveMatrix_add (i : b.support) (s t : S) :
    positiveMatrix i (s + t) = positiveMatrix i s * positiveMatrix i t :=
  (simpleFamily (b := b)).curve_add _ s t

theorem negativeMatrix_add (i : b.support) (s t : S) :
    negativeMatrix i (s + t) = negativeMatrix i s * negativeMatrix i t :=
  (simpleFamily (b := b)).curve_add _ s t

/-- The positive simple-root curve, as matrix units. -/
def positiveUnit (i : b.support) (t : S) : (Matrix (b.support ⊕ ι) (b.support ⊕ ι) S)ˣ :=
  (simpleFamily (b := b)).unit (true, i) t

/-- The negative simple-root curve, as matrix units. -/
def negativeUnit (i : b.support) (t : S) : (Matrix (b.support ⊕ ι) (b.support ⊕ ι) S)ˣ :=
  (simpleFamily (b := b)).unit (false, i) t

@[simp] theorem positiveUnit_val (i : b.support) (t : S) :
    (positiveUnit i t).val = positiveMatrix i t := rfl

@[simp] theorem negativeUnit_val (i : b.support) (t : S) :
    (negativeUnit i t).val = negativeMatrix i t := rfl

theorem positiveUnit_add (i : b.support) (s t : S) :
    positiveUnit i (s + t) = positiveUnit i s * positiveUnit i t :=
  (simpleFamily (b := b)).unit_add _ s t

theorem negativeUnit_add (i : b.support) (s t : S) :
    negativeUnit i (s + t) = negativeUnit i s * negativeUnit i t :=
  (simpleFamily (b := b)).unit_add _ s t

@[simp] theorem positiveUnit_inv (i : b.support) (t : S) :
    (positiveUnit i t)⁻¹ = positiveUnit i (-t) :=
  (simpleFamily (b := b)).unit_inv _ t

@[simp] theorem negativeUnit_inv (i : b.support) (t : S) :
    (negativeUnit i t)⁻¹ = negativeUnit i (-t) :=
  (simpleFamily (b := b)).unit_inv _ t

/-- The subgroup generated by positive and negative simple-root curves. -/
def subgroup (b : P.Base) (S : Type*) [CommRing S] :
    Subgroup (Matrix (b.support ⊕ ι) (b.support ⊕ ι) S)ˣ :=
  (simpleFamily (b := b)).subgroup S

/-- The simple-root Geck group. -/
abbrev Carrier (b : P.Base) (S : Type*) [CommRing S] := subgroup b S

instance : Group (Carrier b S) := inferInstance
instance [Finite S] : Finite (Carrier b S) := inferInstance
noncomputable instance [Fintype S] : Fintype (Carrier b S) := Fintype.ofFinite _

theorem positiveUnit_mem (i : b.support) (t : S) : positiveUnit i t ∈ subgroup b S :=
  (simpleFamily (b := b)).unit_mem _ t

theorem negativeUnit_mem (i : b.support) (t : S) : negativeUnit i t ∈ subgroup b S :=
  (simpleFamily (b := b)).unit_mem _ t

/-- A positive simple-root generator. -/
def positive (i : b.support) (t : S) : Carrier b S := ⟨positiveUnit i t, positiveUnit_mem i t⟩

/-- A negative simple-root generator. -/
def negative (i : b.support) (t : S) : Carrier b S := ⟨negativeUnit i t, negativeUnit_mem i t⟩

/-- Coefficient homomorphisms induce homomorphisms of Geck groups. -/
def map (f : S →+* T) : Carrier b S →* Carrier b T :=
  (simpleFamily (b := b)).map f

@[simp] theorem map_positive (f : S →+* T) (i : b.support) (t : S) :
    map f (positive i t) = positive i (f t) :=
  (simpleFamily (b := b)).map_generator f (true, i) t

@[simp] theorem map_negative (f : S →+* T) (i : b.support) (t : S) :
    map f (negative i t) = negative i (f t) :=
  (simpleFamily (b := b)).map_generator f (false, i) t

/-- Coefficient-ring equivalences induce group equivalences, hence automorphisms
when the source and target ring agree. -/
def equiv (e : S ≃+* T) : Carrier b S ≃* Carrier b T :=
  (simpleFamily (b := b)).equiv e

@[simp] theorem equiv_positive (e : S ≃+* T) (i : b.support) (t : S) :
    equiv e (positive i t) = positive i (e t) :=
  (simpleFamily (b := b)).equiv_generator e (true, i) t

@[simp] theorem equiv_negative (e : S ≃+* T) (i : b.support) (t : S) :
    equiv e (negative i t) = negative i (e t) :=
  (simpleFamily (b := b)).equiv_generator e (false, i) t

end RootPairing.SimpleGeckGroup
