module

public import Theory.AlgebraicGroup.RootSystems.G2RootPairing

/-!
# The root and weight lattices of the standard G2 pairing

For the canonical real root pairing `typeG2RootPairing`, its integral weight module is the
`ℤ`-dual of the coroot lattice.  Every root restricts to an integral functional on that lattice;
the root lattice below is the additive subgroup generated by those restricted roots, while the
weight lattice is the full dual.

The displayed G2 Cartan matrix is `!![2, -1; -3, 2]`, with integral inverse
`!![2, 1; 3, 2]`.  Evaluating an arbitrary weight on the simple-coroot basis and multiplying by
this inverse expresses it as an integral combination of the two simple roots.  Thus the Cartan
matrix is unimodular and the root and weight lattices coincide.  The calculation is integral, so
it is unchanged after passage to the G2 Chevalley model in characteristics two or three, and it
uses no classification of centers or versions.
-/

namespace Theory.AlgebraicGroup.StandardRootSystem

open Matrix Set Submodule

/-- The ambient integral weight module of the canonical G2 root pairing. -/
public abbrev typeG2WeightModule :=
  Module.Dual ℤ (typeG2RootPairing.corootSpan ℤ)

/-- A root of the canonical G2 pairing, restricted to its integral coroot lattice. -/
@[expose] public noncomputable def typeG2RootWeight (r : typeG2Root) :
    typeG2WeightModule :=
  typeG2RootPairing.root'In ℤ r

/-- The additive lattice generated by the canonical G2 roots inside the weight module. -/
@[expose] public noncomputable def typeG2RootLattice :
    AddSubgroup typeG2WeightModule :=
  AddSubgroup.closure (Set.range typeG2RootWeight)

/-- The full integral weight lattice of the canonical G2 pairing. -/
@[expose] public noncomputable def typeG2WeightLattice :
    AddSubgroup typeG2WeightModule :=
  ⊤

private def typeG2CartanInverse : Matrix (Fin 2) (Fin 2) ℤ :=
  !![2, 1; 3, 2]

private lemma typeG2CartanInverse_mul :
    typeG2CartanInverse * typeG2CartanMatrix = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [typeG2CartanInverse, typeG2CartanMatrix, Matrix.mul_apply,
      Fin.sum_univ_succ]

/-- For G2 the root lattice equals the full weight lattice.  Equivalently, every integral
functional on the coroot lattice is an integral linear combination of roots. -/
public theorem typeG2_rootLattice_eq_weightLattice :
    typeG2RootLattice = typeG2WeightLattice := by
  rw [typeG2WeightLattice]
  apply top_unique
  intro f _
  let simpleCombination : typeG2WeightModule :=
    ∑ k : Fin 2,
      f (typeG2RootPairing.corootSpanMem ℤ (typeG2RootPairing_baseEquiv k)) •
        ∑ i : Fin 2, typeG2CartanInverse k i •
          typeG2RootWeight (typeG2RootPairing_baseEquiv i)
  have hCombination : simpleCombination = f := by
    apply (typeG2RootPairing_base.flip.toWeightBasisInt).ext
    intro j
    let j' : Fin 2 := typeG2RootPairing_baseEquiv.symm j
    have hj : typeG2RootPairing_baseEquiv j' = j :=
      typeG2RootPairing_baseEquiv.apply_symm_apply j
    have hjBasis : typeG2RootPairing_base.flip.toWeightBasisInt j =
        typeG2RootPairing.corootSpanMem ℤ j := by
      apply Subtype.ext
      simp
    have hcoeff (k : Fin 2) :
        ∑ i : Fin 2, typeG2CartanInverse k i * typeG2CartanMatrix i j' =
          if k = j' then 1 else 0 := by
      have h := congrFun (congrFun typeG2CartanInverse_mul k) j'
      simpa [Matrix.mul_apply, Matrix.one_apply] using h
    rw [hjBasis]
    change (∑ k : Fin 2,
      f (typeG2RootPairing.corootSpanMem ℤ (typeG2RootPairing_baseEquiv k)) *
        ∑ i : Fin 2, typeG2CartanInverse k i *
          typeG2RootPairing.pairingIn ℤ (typeG2RootPairing_baseEquiv i) j) =
      f (typeG2RootPairing.corootSpanMem ℤ j)
    rw [← hj]
    simp_rw [← RootPairing.Base.cartanMatrixIn_def,
      typeG2RootPairing_base_cartan_apply]
    simp_rw [hcoeff]
    simp
  rw [← hCombination]
  apply AddSubgroup.sum_mem
  intro k _
  apply AddSubgroup.zsmul_mem
  apply AddSubgroup.sum_mem
  intro i _
  apply AddSubgroup.zsmul_mem
  exact AddSubgroup.subset_closure ⟨typeG2RootPairing_baseEquiv i, rfl⟩

end Theory.AlgebraicGroup.StandardRootSystem
