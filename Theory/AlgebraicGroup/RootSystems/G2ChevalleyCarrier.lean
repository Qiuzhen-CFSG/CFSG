module

public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.ClosedSubgroup.Maximal
public import Theory.AlgebraicGroup.Morphism.ClosedEmbedding
public import Theory.AlgebraicGroup.Morphism.ClosedImage
public import Theory.AlgebraicGroup.Representations.Matrix
public import Theory.AlgebraicGroup.RootSystems.G2ChevalleyRepresentation
public import Theory.AlgebraicGroup.Tori.Character.Image
public import Theory.AlgebraicGroup.Tori.Character.Laurent
public import Theory.AlgebraicGroup.Tori.Character.Regular
public import Theory.AlgebraicGroup.Tori.Power
public import Theory.AlgebraicGroup.Unipotent.OneParameter

/-!
# The closed G2 Chevalley carrier

This module specializes the integral G2 Chevalley matrices to an algebraically closed
field, proves that the root curves and the rank-two diagonal torus are regular
algebraic-group morphisms, and takes the abstract subgroup generated by their images.
The finite connected-generation theorem makes that subgroup Zariski closed, hence its
closed-subgroup carrier inherits an algebraic-group structure.

The two diagonal parameters are recovered regularly from the short- and long-root
diagonal entries: the corresponding exponent matrix is unimodular. Consequently the
diagonal morphism is an isomorphism onto its closed image, with explicit point,
matrix, character, and cocharacter formulas. This argument only uses integral Laurent
identities, so it remains valid in characteristics two and three.

The diagonal image is therefore a subtorus of the carrier. A maximal connected
closed-subgroup argument, applied only to subtori containing that image, supplies a
maximal torus candidate containing it. Thus maximality is obtained from the general
closed-subgroup existence theorem rather than from any downstream classification
theorem.

The matrices are those constructed integrally in `G2ChevalleyRepresentation`.
Their cubic divided-power formulas are used directly to provide polynomial coordinate
functions (and inverse-coordinate functions) for every root curve. This is the
characteristic-free Chevalley construction used in the exceptional-type existence
argument, following the standard integral construction described by Steinberg and
the GLS3 source.
-/

open scoped BigOperators Matrix

universe u

@[expose] public section

namespace Theory.AlgebraicGroup.G2Chevalley

variable {k : Type u} [Field k] [IsAlgClosed k]

public noncomputable abbrev Ambient (k : Type u) [Field k] [IsAlgClosed k] :=
  glVariety (Module.finrank k (Basis → k)) (k := k)

public noncomputable def rootCoordinatePolynomial (r : Root) (i j : Basis) :
    MvPolynomial PUnit k :=
  MvPolynomial.C ((1 : Matrix Basis Basis k) i j) +
    MvPolynomial.X PUnit.unit *
      MvPolynomial.C (specialize (R := k) (rootDividedPower r 1) i j) +
    MvPolynomial.X PUnit.unit ^ 2 *
      MvPolynomial.C (specialize (R := k) (rootDividedPower r 2) i j) +
    MvPolynomial.X PUnit.unit ^ 3 *
      MvPolynomial.C (specialize (R := k) (rootDividedPower r 3) i j)

public noncomputable def rootInverseCoordinatePolynomial (r : Root) (i j : Basis) :
    MvPolynomial PUnit k :=
  MvPolynomial.C ((1 : Matrix Basis Basis k) i j) -
    MvPolynomial.X PUnit.unit *
      MvPolynomial.C (specialize (R := k) (rootDividedPower r 1) i j) +
    MvPolynomial.X PUnit.unit ^ 2 *
      MvPolynomial.C (specialize (R := k) (rootDividedPower r 2) i j) -
    MvPolynomial.X PUnit.unit ^ 3 *
      MvPolynomial.C (specialize (R := k) (rootDividedPower r 3) i j)

omit [IsAlgClosed k] in
public lemma eval_rootCoordinatePolynomial (r : Root) (i j : Basis)
    (x : Variety.Point (KPlus k)) :
    evalPolynomial x.val (rootCoordinatePolynomial (k := k) r i j) =
      rootCurve r (x.val PUnit.unit) i j := by
  simp [rootCoordinatePolynomial, rootCurve, evalPolynomial]

omit [IsAlgClosed k] in
public lemma eval_rootInverseCoordinatePolynomial (r : Root) (i j : Basis)
    (x : Variety.Point (KPlus k)) :
    evalPolynomial x.val (rootInverseCoordinatePolynomial (k := k) r i j) =
      rootCurve r (-x.val PUnit.unit) i j := by
  simp [rootInverseCoordinatePolynomial, rootCurve, evalPolynomial]
  ring

omit [IsAlgClosed k] in
public lemma rootCurveUnit_zero (r : Root) : rootCurveUnit (R := k) r 0 = 1 := by
  apply Units.ext
  exact rootCurve_zero r

omit [IsAlgClosed k] in
public lemma rootCurveUnit_add (r : Root) (a b : k) :
    rootCurveUnit r (a + b) = rootCurveUnit r a * rootCurveUnit r b := by
  apply Units.ext
  exact rootCurve_add r a b

omit [IsAlgClosed k] in
public lemma rootCurveUnit_inv (r : Root) (a : k) :
    (rootCurveUnit r a)⁻¹ = rootCurveUnit r (-a) := by
  apply Units.ext
  rfl

public noncomputable def carrierIndexEquiv :
    Basis ≃ Fin (Module.finrank k (Basis → k)) :=
  let h : Module.finrank k (Basis → k) = 14 := by
    simpa only [Fintype.card_fin] using (Module.finrank_pi k :
      Module.finrank k (Basis → k) = Fintype.card Basis)
  Equiv.cast (congrArg Fin h.symm)

public noncomputable def carrierBasis :
    Module.Basis (Fin (Module.finrank k (Basis → k))) k (Basis → k) := by
  exact (Pi.basisFun k Basis).reindex (carrierIndexEquiv (k := k))

public noncomputable def rootPointRepresentation (r : Root) :
    Variety.Point (KPlus k) →* LinearMap.GeneralLinearGroup k (Basis → k) where
  toFun := fun x => Matrix.GeneralLinearGroup.toLin
    (rootCurveUnit r (x.val PUnit.unit))
  map_one' := by
    have hcoord : ((1 : Variety.Point (KPlus k)).val PUnit.unit) = 0 := by
      rw [← kPlusPoint_coordinate (k := k) (1 : Variety.Point (KPlus k))]
      rfl
    change Matrix.GeneralLinearGroup.toLin
      (rootCurveUnit r ((1 : Variety.Point (KPlus k)).val PUnit.unit)) = 1
    rw [hcoord, rootCurveUnit_zero]
    exact map_one _
  map_mul' := by
    intro x y
    change Matrix.GeneralLinearGroup.toLin
      (rootCurveUnit r ((x * y).val PUnit.unit)) =
      Matrix.GeneralLinearGroup.toLin (rootCurveUnit r (x.val PUnit.unit)) *
        Matrix.GeneralLinearGroup.toLin (rootCurveUnit r (y.val PUnit.unit))
    rw [kPlusPoint_coordinate_mul, rootCurveUnit_add, map_mul]

public noncomputable def rootMatrixCoefficient (r : Root)
    (i j : Fin (Module.finrank k (Basis → k))) :
    (KPlus k).PolynomialFunction :=
  Variety.PolynomialFunction.ofPolynomial (KPlus k)
    (rootCoordinatePolynomial r ((carrierIndexEquiv (k := k)).symm.toFun i)
      ((carrierIndexEquiv (k := k)).symm.toFun j))

public noncomputable def rootInverseMatrixCoefficient (r : Root)
    (i j : Fin (Module.finrank k (Basis → k))) :
    (KPlus k).PolynomialFunction :=
  Variety.PolynomialFunction.ofPolynomial (KPlus k)
    (rootInverseCoordinatePolynomial r ((carrierIndexEquiv (k := k)).symm.toFun i)
      ((carrierIndexEquiv (k := k)).symm.toFun j))

omit [IsAlgClosed k] in
public lemma rootMatrixCoefficient_apply (r : Root)
    (i j : Fin (Module.finrank k (Basis → k))) (x : Variety.Point (KPlus k)) :
    rootMatrixCoefficient r i j x =
      (carrierBasis (k := k)).repr
        (((rootPointRepresentation r x : LinearMap.GeneralLinearGroup k (Basis → k)) :
          Module.End k (Basis → k)) ((carrierBasis (k := k)) j)) i := by
  change evalPolynomial x.val
    (rootCoordinatePolynomial r ((carrierIndexEquiv (k := k)).symm.toFun i)
      ((carrierIndexEquiv (k := k)).symm.toFun j)) = _
  rw [eval_rootCoordinatePolynomial]
  simp [carrierBasis, rootPointRepresentation, Module.Basis.reindex_apply]
  rfl

omit [IsAlgClosed k] in
public lemma rootInverseMatrixCoefficient_apply (r : Root)
    (i j : Fin (Module.finrank k (Basis → k))) (x : Variety.Point (KPlus k)) :
    rootInverseMatrixCoefficient r i j x =
      (carrierBasis (k := k)).repr
        (((((rootPointRepresentation r x)⁻¹ : LinearMap.GeneralLinearGroup k (Basis → k)) :
          Module.End k (Basis → k)) ((carrierBasis (k := k)) j))) i := by
  change evalPolynomial x.val
    (rootInverseCoordinatePolynomial r ((carrierIndexEquiv (k := k)).symm.toFun i)
      ((carrierIndexEquiv (k := k)).symm.toFun j)) = _
  rw [eval_rootInverseCoordinatePolynomial]
  have hinv : (rootPointRepresentation r x)⁻¹ =
      Matrix.GeneralLinearGroup.toLin
        (rootCurveUnit r (-x.val PUnit.unit)) := by
    change (Matrix.GeneralLinearGroup.toLin (rootCurveUnit r (x.val PUnit.unit)))⁻¹ = _
    rw [← map_inv, rootCurveUnit_inv]
  rw [hinv]
  simp [carrierBasis, Module.Basis.reindex_apply]
  rfl

public noncomputable def rootAmbientMorphism (r : Root) :
    AlgebraicGroup.Morphism (KPlus k) (Ambient k) := by
  simpa [Ambient] using
    generalLinearRepresentationMorphismOfInverseMatrixCoefficient
      (carrierBasis (k := k)) (rootPointRepresentation r)
      (rootMatrixCoefficient r) (rootInverseMatrixCoefficient r)
      (rootMatrixCoefficient_apply r) (rootInverseMatrixCoefficient_apply r)

@[simp]
public lemma rootAmbientMorphism_apply (r : Root) (x : Variety.Point (KPlus k)) :
    (rootAmbientMorphism r).onPoints x =
      generalLinearRepresentationPoint (carrierBasis (k := k))
        (rootPointRepresentation r x) := by
  rw [rootAmbientMorphism]
  exact generalLinearRepresentationMorphismOfInverseMatrixCoefficient_apply
    (carrierBasis (k := k)) (rootPointRepresentation r)
    (rootMatrixCoefficient r) (rootInverseMatrixCoefficient r)
    (rootMatrixCoefficient_apply r) (rootInverseMatrixCoefficient_apply r) x

public def torusWeightExponent (b : Basis) (i : Fin 2) : ℤ :=
  -basisWeight b i

omit [IsAlgClosed k] in
public lemma basisTorusUnit_one (b : Basis) :
    basisTorusUnit (R := k) 1 b = 1 := by
  simp [basisTorusUnit]

omit [IsAlgClosed k] in
public lemma basisTorusUnit_mul (u v : TorusParameter k) (b : Basis) :
    basisTorusUnit (u * v) b = basisTorusUnit u b * basisTorusUnit v b := by
  simp only [basisTorusUnit, Pi.mul_apply, mul_zpow, Finset.prod_mul_distrib]

omit [IsAlgClosed k] in
public lemma torusElement_one : torusElement (R := k) 1 = 1 := by
  apply Units.ext
  ext i j
  simp [torusElement, basisTorusUnit_one, Matrix.one_apply]

omit [IsAlgClosed k] in
public lemma torusElement_mul (u v : TorusParameter k) :
    torusElement (u * v) = torusElement u * torusElement v := by
  apply Units.ext
  change Matrix.diagonal _ = Matrix.diagonal _ * Matrix.diagonal _
  rw [Matrix.diagonal_mul_diagonal]
  congr 1
  funext b
  exact congrArg Units.val (basisTorusUnit_mul u v b)

public noncomputable def torusPointRepresentation :
    Variety.Point (dVariety k 2) →* LinearMap.GeneralLinearGroup k (Basis → k) where
  toFun := fun x => Matrix.GeneralLinearGroup.toLin (torusElement (dPointEquiv 2 x))
  map_one' := by
    simp [dPointEquiv_one, torusElement_one]
  map_mul' := by
    intro x y
    simp only [dPointEquiv_mul, torusElement_mul, map_mul]

public noncomputable def torusCharacter (b : Basis) : TorusCharacter (dVariety k 2) :=
  dLaurentCharacter 2 (torusWeightExponent b)

public noncomputable def torusInverseCharacter (b : Basis) : TorusCharacter (dVariety k 2) :=
  dLaurentCharacter 2 (basisWeight b)

omit [IsAlgClosed k] in
public lemma torusCharacter_scalar_apply (b : Basis)
    (x : Variety.Point (dVariety k 2)) :
    (torusCharacter b).scalarPolynomialFunction x =
      (basisTorusUnit (dPointEquiv 2 x) b : k) := by
  rw [TorusCharacter.scalarPolynomialFunction_apply]
  rw [torusCharacter, TorusCharacter.pointCharacter_dLaurentCharacter]
  rfl

omit [IsAlgClosed k] in
public lemma torusInverseCharacter_scalar_apply (b : Basis)
    (x : Variety.Point (dVariety k 2)) :
    (torusInverseCharacter b).scalarPolynomialFunction x =
      ((basisTorusUnit (dPointEquiv 2 x) b)⁻¹ : kˣ) := by
  rw [TorusCharacter.scalarPolynomialFunction_apply]
  rw [torusInverseCharacter, TorusCharacter.pointCharacter_dLaurentCharacter]
  change (↑(∏ i, (dPointEquiv 2 x i) ^ basisWeight b i) : k) =
    (↑((∏ i, (dPointEquiv 2 x i) ^ (-basisWeight b i))⁻¹) : k)
  apply congrArg Units.val
  calc
    ∏ i, (dPointEquiv 2 x i) ^ basisWeight b i =
        ∏ i, ((dPointEquiv 2 x i) ^ (-basisWeight b i))⁻¹ := by
      apply Finset.prod_congr rfl
      intro i hi
      rw [zpow_neg, inv_inv]
    _ = (∏ i, (dPointEquiv 2 x i) ^ (-basisWeight b i))⁻¹ := by
      simpa only [Finset.mem_univ, and_true] using
        (Finset.prod_inv_distrib
          (s := Finset.univ) (fun i => (dPointEquiv 2 x i) ^ (-basisWeight b i)))

public noncomputable def torusMatrixCoefficient
    (i j : Fin (Module.finrank k (Basis → k))) :
    (dVariety k 2).PolynomialFunction :=
  if i = j then
    (torusCharacter ((carrierIndexEquiv (k := k)).symm.toFun i)).scalarPolynomialFunction
  else 0

public noncomputable def torusInverseMatrixCoefficient
    (i j : Fin (Module.finrank k (Basis → k))) :
    (dVariety k 2).PolynomialFunction :=
  if i = j then
    (torusInverseCharacter
      ((carrierIndexEquiv (k := k)).symm.toFun i)).scalarPolynomialFunction
  else 0

omit [IsAlgClosed k] in
public lemma torusMatrixCoefficient_apply
    (i j : Fin (Module.finrank k (Basis → k))) (x : Variety.Point (dVariety k 2)) :
    torusMatrixCoefficient i j x =
      (carrierBasis (k := k)).repr
        (((torusPointRepresentation x : LinearMap.GeneralLinearGroup k (Basis → k)) :
          Module.End k (Basis → k)) ((carrierBasis (k := k)) j)) i := by
  by_cases hij : i = j
  · subst j
    rw [torusMatrixCoefficient, if_pos rfl, torusCharacter_scalar_apply]
    simp [torusPointRepresentation, carrierBasis, Module.Basis.reindex_apply, torusElement]
  · have hidx : (carrierIndexEquiv (k := k)).symm i ≠
        (carrierIndexEquiv (k := k)).symm j := by
      exact fun h => hij ((carrierIndexEquiv (k := k)).symm.injective h)
    rw [torusMatrixCoefficient, if_neg hij]
    simp [torusPointRepresentation, carrierBasis, Module.Basis.reindex_apply,
      torusElement, hidx]

omit [IsAlgClosed k] in
public lemma torusPointRepresentation_inv_coefficient
    (i j : Fin (Module.finrank k (Basis → k))) (x : Variety.Point (dVariety k 2)) :
    (carrierBasis (k := k)).repr
        (((((torusPointRepresentation x)⁻¹ : LinearMap.GeneralLinearGroup k (Basis → k)) :
          Module.End k (Basis → k)) ((carrierBasis (k := k)) j))) i =
      if i = j then
        (((basisTorusUnit (dPointEquiv 2 x)
          ((carrierIndexEquiv (k := k)).symm i))⁻¹ : kˣ) : k)
      else 0 := by
  change (carrierBasis (k := k)).repr
      (((((Matrix.GeneralLinearGroup.toLin (torusElement (dPointEquiv 2 x)))⁻¹ :
        LinearMap.GeneralLinearGroup k (Basis → k)) : Module.End k (Basis → k))
        ((carrierBasis (k := k)) j))) i = _
  have hinv :
      (Matrix.GeneralLinearGroup.toLin (torusElement (dPointEquiv 2 x)))⁻¹ =
        Matrix.GeneralLinearGroup.toLin ((torusElement (dPointEquiv 2 x))⁻¹) :=
    ((Matrix.GeneralLinearGroup.toLin (n := Basis) (R := k)).map_inv _).symm
  rw [hinv]
  by_cases hij : i = j
  · subst j
    simp [carrierBasis, Module.Basis.reindex_apply, torusElement]
  · have hidx : (carrierIndexEquiv (k := k)).symm i ≠
        (carrierIndexEquiv (k := k)).symm j := by
      exact fun h => hij ((carrierIndexEquiv (k := k)).symm.injective h)
    simp [hij, carrierBasis, Module.Basis.reindex_apply, torusElement, hidx]

omit [IsAlgClosed k] in
public lemma torusInverseMatrixCoefficient_apply
    (i j : Fin (Module.finrank k (Basis → k))) (x : Variety.Point (dVariety k 2)) :
    torusInverseMatrixCoefficient i j x =
      (carrierBasis (k := k)).repr
        (((((torusPointRepresentation x)⁻¹ : LinearMap.GeneralLinearGroup k (Basis → k)) :
          Module.End k (Basis → k)) ((carrierBasis (k := k)) j))) i := by
  by_cases hij : i = j
  · subst j
    rw [torusInverseMatrixCoefficient, if_pos rfl, torusInverseCharacter_scalar_apply]
    rw [torusPointRepresentation_inv_coefficient, if_pos rfl]
    rfl
  ·
    rw [torusInverseMatrixCoefficient, if_neg hij]
    rw [torusPointRepresentation_inv_coefficient, if_neg hij]
    rfl

public noncomputable def torusAmbientMorphism :
    AlgebraicGroup.Morphism (dVariety k 2) (Ambient k) := by
  simpa [Ambient] using
    generalLinearRepresentationMorphismOfInverseMatrixCoefficient
      (carrierBasis (k := k)) torusPointRepresentation
      torusMatrixCoefficient torusInverseMatrixCoefficient
      torusMatrixCoefficient_apply torusInverseMatrixCoefficient_apply

@[simp]
public lemma torusAmbientMorphism_apply (x : Variety.Point (dVariety k 2)) :
    torusAmbientMorphism.onPoints x =
      generalLinearRepresentationPoint (carrierBasis (k := k))
        (torusPointRepresentation x) := by
  rw [torusAmbientMorphism]
  exact generalLinearRepresentationMorphismOfInverseMatrixCoefficient_apply
    (carrierBasis (k := k)) torusPointRepresentation
    torusMatrixCoefficient torusInverseMatrixCoefficient
    torusMatrixCoefficient_apply torusInverseMatrixCoefficient_apply x

public noncomputable def ambientRootSubgroup (r : Root) : ClosedSubgroup (Ambient k) :=
  (rootAmbientMorphism r).imageClosedSubgroup

public noncomputable def ambientSplitTorus : ClosedSubgroup (Ambient k) :=
  torusAmbientMorphism.imageClosedSubgroup

public noncomputable def generatorFamily : Option Root → ClosedSubgroup (Ambient k)
  | none => ambientSplitTorus
  | some r => ambientRootSubgroup r

public lemma generatorFamily_connected (i : Option Root) :
    _root_.IsConnected (generatorFamily (k := k) i : Set (Variety.Point (Ambient k))) := by
  cases i with
  | none =>
      exact torusAmbientMorphism.imageClosedSubgroup_isConnected (dVariety_isConnected 2)
  | some r =>
      exact (rootAmbientMorphism r).imageClosedSubgroup_isConnected kPlus_isConnected

public noncomputable def ambientCarrierSubgroup : Subgroup (Variety.Point (Ambient k)) :=
  Subgroup.closure (⋃ i, (generatorFamily (k := k) i : Set (Variety.Point (Ambient k))))

public theorem ambientCarrier_isZariskiClosed :
    IsZariskiClosed (Ambient k)
      (ambientCarrierSubgroup (k := k) : Set (Variety.Point (Ambient k))) :=
  closure_iUnion_connected_closedSubgroup_isZariskiClosed
    (generatorFamily (k := k)) generatorFamily_connected

public noncomputable def ambientClosedCarrier : ClosedSubgroup (Ambient k) :=
  ClosedSubgroup.ofSubgroup ambientCarrierSubgroup ambientCarrier_isZariskiClosed

public noncomputable abbrev Carrier :=
  (ambientClosedCarrier (k := k)).carrierVariety

noncomputable instance : AlgebraicGroup (Carrier (k := k)) :=
  (ambientClosedCarrier (k := k)).carrierAlgebraicGroup

public lemma ambientRoot_mem_carrier (r : Root) (x : Variety.Point (KPlus k)) :
    (rootAmbientMorphism r).onPoints x ∈ ambientCarrierSubgroup (k := k) := by
  apply Subgroup.subset_closure
  refine Set.mem_iUnion.mpr ⟨some r, ?_⟩
  change (rootAmbientMorphism r).onPoints x ∈ (rootAmbientMorphism r).image
  exact ⟨x, rfl⟩

public lemma ambientTorus_mem_carrier (x : Variety.Point (dVariety k 2)) :
    torusAmbientMorphism.onPoints x ∈ ambientCarrierSubgroup (k := k) := by
  apply Subgroup.subset_closure
  refine Set.mem_iUnion.mpr ⟨none, ?_⟩
  change torusAmbientMorphism.onPoints x ∈ torusAmbientMorphism.image
  exact ⟨x, rfl⟩

public noncomputable def rootMorphism (r : Root) :
    AlgebraicGroup.Morphism (KPlus k) (Carrier (k := k)) :=
  (rootAmbientMorphism r).codRestrictClosedSubgroup ambientClosedCarrier
    (ambientRoot_mem_carrier r)

@[simp]
public lemma rootMorphism_inclusion_apply (r : Root) (x : Variety.Point (KPlus k)) :
    (ambientClosedCarrier (k := k)).inclusion.onPoints
        ((rootMorphism r).onPoints x) =
      (rootAmbientMorphism r).onPoints x :=
  (rootAmbientMorphism r).codRestrictClosedSubgroup_inclusion_apply
    ambientClosedCarrier (ambientRoot_mem_carrier r) x

public noncomputable def splitTorusMorphism :
    AlgebraicGroup.Morphism (dVariety k 2) (Carrier (k := k)) :=
  torusAmbientMorphism.codRestrictClosedSubgroup ambientClosedCarrier
    ambientTorus_mem_carrier

@[simp]
public lemma splitTorusMorphism_inclusion_apply
    (x : Variety.Point (dVariety k 2)) :
    (ambientClosedCarrier (k := k)).inclusion.onPoints
        (splitTorusMorphism.onPoints x) =
      torusAmbientMorphism.onPoints x :=
  torusAmbientMorphism.codRestrictClosedSubgroup_inclusion_apply
    ambientClosedCarrier ambientTorus_mem_carrier x

public noncomputable def splitTorus : ClosedSubgroup (Carrier (k := k)) :=
  splitTorusMorphism.imageClosedSubgroup

public theorem splitTorus_isSubtorus : IsSubtorus (splitTorus (k := k)) :=
  morphism_image_isTorus splitTorusMorphism (dVariety_isTorus 2)

/-! ## Explicit coordinates on the split torus -/

omit [IsAlgClosed k] in
private lemma basisTorusUnit_inv (u : TorusParameter k) (b : Basis) :
    basisTorusUnit u⁻¹ b = (basisTorusUnit u b)⁻¹ := by
  simp [basisTorusUnit, Finset.prod_inv_distrib]

omit [IsAlgClosed k] in
private lemma dPointEquiv_inv_local (n : ℕ)
    (x : Variety.Point (dVariety k n)) :
    dPointEquiv n x⁻¹ = (dPointEquiv n x)⁻¹ := by
  have h := dPointEquiv_mul n x⁻¹ x
  rw [inv_mul_cancel, dPointEquiv_one] at h
  calc
    dPointEquiv n x⁻¹ = dPointEquiv n x⁻¹ * 1 := (mul_one _).symm
    _ = dPointEquiv n x⁻¹ * (dPointEquiv n x * (dPointEquiv n x)⁻¹) := by
      rw [mul_inv_cancel]
    _ = (dPointEquiv n x⁻¹ * dPointEquiv n x) * (dPointEquiv n x)⁻¹ := by
      rw [mul_assoc]
    _ = 1 * (dPointEquiv n x)⁻¹ := by rw [← h]
    _ = (dPointEquiv n x)⁻¹ := one_mul _

omit [IsAlgClosed k] in
private lemma basisTorusUnit_recover (u : TorusParameter k) (i : Fin 2) :
    u i =
      (basisTorusUnit u (rootBasis Root.short))⁻¹ ^ (i.val + 2) *
        (basisTorusUnit u (rootBasis Root.long))⁻¹ ^ (i.val + 1) := by
  fin_cases i
  · apply Units.ext
    simp [basisTorusUnit, basisWeight, Root.pairingSimple, Root.coord,
      Root.short, Root.long, rootBasis, basisRoot, Fin.prod_univ_two]
    field_simp
  · apply Units.ext
    simp [basisTorusUnit, basisWeight, Root.pairingSimple, Root.coord,
      Root.short, Root.long, rootBasis, basisRoot, Fin.prod_univ_two]
    field_simp

omit [IsAlgClosed k] in
private lemma basisTorusUnit_inv_recover (u : TorusParameter k) (i : Fin 2) :
    (u i)⁻¹ =
      basisTorusUnit u (rootBasis Root.short) ^ (i.val + 2) *
        basisTorusUnit u (rootBasis Root.long) ^ (i.val + 1) := by
  fin_cases i
  · apply Units.ext
    simp [basisTorusUnit, basisWeight, Root.pairingSimple, Root.coord,
      Root.short, Root.long, rootBasis, basisRoot, Fin.prod_univ_two]
    field_simp
  · apply Units.ext
    simp [basisTorusUnit, basisWeight, Root.pairingSimple, Root.coord,
      Root.short, Root.long, rootBasis, basisRoot, Fin.prod_univ_two]
    field_simp

private lemma torusAmbientMorphism_diagonal_apply
    (x : Variety.Point (dVariety k 2)) (b : Basis) :
    (torusAmbientMorphism.onPoints x).val
        (Sum.inl (carrierIndexEquiv (k := k) b, carrierIndexEquiv (k := k) b)) =
      (basisTorusUnit (dPointEquiv 2 x) b : k) := by
  rw [torusAmbientMorphism_apply, generalLinearRepresentationPoint_matrix]
  simp [torusPointRepresentation, carrierBasis, Module.Basis.reindex_apply,
    torusElement]

private noncomputable def carrierDiagonalCoordinate (b : Basis) :
    Variety.PolynomialFunction (Carrier (k := k)) :=
  Variety.PolynomialFunction.pullback
    (ambientClosedCarrier (k := k)).inclusion.toVariety
    (generalLinearMatrixCoordinate (k := k)
      (Module.finrank k (Basis → k))
      (carrierIndexEquiv (k := k) b) (carrierIndexEquiv (k := k) b))

private noncomputable def carrierInverseDiagonalCoordinate (b : Basis) :
    Variety.PolynomialFunction (Carrier (k := k)) :=
  Variety.PolynomialFunction.pullback
    (ambientClosedCarrier (k := k)).inclusion.toVariety
    (generalLinearInverseMatrixCoordinate (k := k)
      (Module.finrank k (Basis → k))
      (carrierIndexEquiv (k := k) b) (carrierIndexEquiv (k := k) b))

private lemma carrierDiagonalCoordinate_splitTorusMorphism_apply
    (b : Basis) (x : Variety.Point (dVariety k 2)) :
    carrierDiagonalCoordinate (k := k) b (splitTorusMorphism.onPoints x) =
      (basisTorusUnit (dPointEquiv 2 x) b : k) := by
  change generalLinearMatrixCoordinate (k := k)
      (Module.finrank k (Basis → k))
      (carrierIndexEquiv (k := k) b) (carrierIndexEquiv (k := k) b)
      ((ambientClosedCarrier (k := k)).inclusion.onPoints
        (splitTorusMorphism.onPoints x)) = _
  rw [splitTorusMorphism_inclusion_apply, generalLinearMatrixCoordinate_apply]
  exact torusAmbientMorphism_diagonal_apply x b

private lemma carrierInverseDiagonalCoordinate_splitTorusMorphism_apply
    (b : Basis) (x : Variety.Point (dVariety k 2)) :
    carrierInverseDiagonalCoordinate (k := k) b (splitTorusMorphism.onPoints x) =
      ((basisTorusUnit (dPointEquiv 2 x) b)⁻¹ : kˣ) := by
  change generalLinearInverseMatrixCoordinate (k := k)
      (Module.finrank k (Basis → k))
      (carrierIndexEquiv (k := k) b) (carrierIndexEquiv (k := k) b)
      ((ambientClosedCarrier (k := k)).inclusion.onPoints
        (splitTorusMorphism.onPoints x)) = _
  rw [splitTorusMorphism_inclusion_apply, generalLinearInverseMatrixCoordinate_apply]
  rw [← torusAmbientMorphism.map_inv, torusAmbientMorphism_diagonal_apply]
  rw [dPointEquiv_inv_local, basisTorusUnit_inv]

private noncomputable def carrierRecoverCoordinate (i : Fin 2) :
    Variety.PolynomialFunction (Carrier (k := k)) :=
  carrierInverseDiagonalCoordinate (k := k) (rootBasis Root.short) ^ (i.val + 2) *
    carrierInverseDiagonalCoordinate (k := k) (rootBasis Root.long) ^ (i.val + 1)

private noncomputable def carrierRecoverInverseCoordinate (i : Fin 2) :
    Variety.PolynomialFunction (Carrier (k := k)) :=
  carrierDiagonalCoordinate (k := k) (rootBasis Root.short) ^ (i.val + 2) *
    carrierDiagonalCoordinate (k := k) (rootBasis Root.long) ^ (i.val + 1)

private lemma carrierRecoverCoordinate_splitTorusMorphism_apply
    (i : Fin 2) (x : Variety.Point (dVariety k 2)) :
    carrierRecoverCoordinate (k := k) i (splitTorusMorphism.onPoints x) =
      (dPointEquiv 2 x i : k) := by
  rw [carrierRecoverCoordinate]
  change carrierInverseDiagonalCoordinate (k := k) (rootBasis Root.short)
        (splitTorusMorphism.onPoints x) ^ (i.val + 2) *
      carrierInverseDiagonalCoordinate (k := k) (rootBasis Root.long)
        (splitTorusMorphism.onPoints x) ^ (i.val + 1) = _
  rw [carrierInverseDiagonalCoordinate_splitTorusMorphism_apply,
    carrierInverseDiagonalCoordinate_splitTorusMorphism_apply]
  exact congrArg Units.val (basisTorusUnit_recover (dPointEquiv 2 x) i).symm

private lemma carrierRecoverInverseCoordinate_splitTorusMorphism_apply
    (i : Fin 2) (x : Variety.Point (dVariety k 2)) :
    carrierRecoverInverseCoordinate (k := k) i (splitTorusMorphism.onPoints x) =
      ((dPointEquiv 2 x i)⁻¹ : kˣ) := by
  rw [carrierRecoverInverseCoordinate]
  change carrierDiagonalCoordinate (k := k) (rootBasis Root.short)
        (splitTorusMorphism.onPoints x) ^ (i.val + 2) *
      carrierDiagonalCoordinate (k := k) (rootBasis Root.long)
        (splitTorusMorphism.onPoints x) ^ (i.val + 1) = _
  rw [carrierDiagonalCoordinate_splitTorusMorphism_apply,
    carrierDiagonalCoordinate_splitTorusMorphism_apply]
  exact congrArg Units.val (basisTorusUnit_inv_recover (dPointEquiv 2 x) i).symm

private theorem splitTorusMorphism_injective :
    Function.Injective (splitTorusMorphism (k := k)).onPoints := by
  intro x y hxy
  apply (dPointEquiv 2).injective
  funext i
  apply Units.ext
  rw [← carrierRecoverCoordinate_splitTorusMorphism_apply i x,
    ← carrierRecoverCoordinate_splitTorusMorphism_apply i y, hxy]

private theorem splitTorusMorphism_coordinate_preimage
    (c : (dVariety k 2).Coordinates) :
    ∃ q : Variety.PolynomialFunction (Carrier (k := k)),
      Variety.PolynomialFunction.pullback splitTorusMorphism.toVariety q =
        Variety.PolynomialFunction.ofPolynomial (dVariety k 2) (MvPolynomial.X c) := by
  cases c with
  | inl i =>
      refine ⟨carrierRecoverCoordinate (k := k) i.down, ?_⟩
      apply Variety.PolynomialFunction.ext
      intro x
      change carrierRecoverCoordinate (k := k) i.down
          (splitTorusMorphism.onPoints x) =
        evalPolynomial x.val (MvPolynomial.X (Sum.inl i))
      rw [carrierRecoverCoordinate_splitTorusMorphism_apply, evalPolynomial_X]
      rfl
  | inr i =>
      refine ⟨carrierRecoverInverseCoordinate (k := k) i.down, ?_⟩
      apply Variety.PolynomialFunction.ext
      intro x
      change carrierRecoverInverseCoordinate (k := k) i.down
          (splitTorusMorphism.onPoints x) =
        evalPolynomial x.val (MvPolynomial.X (Sum.inr i))
      rw [carrierRecoverInverseCoordinate_splitTorusMorphism_apply,
        evalPolynomial_X, Units.val_inv_eq_inv_val]
      change (dPointEntry 2 x i.down)⁻¹ = dPointEntryInv 2 x i.down
      exact dPoint_entry_inv 2 x i.down

/-- The two-parameter diagonal morphism is an isomorphism onto its closed
image. The inverse is regular because the short- and long-root diagonal
entries recover both parameters by integral powers. -/
public theorem exists_splitTorusIso :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    ∃ e : AlgebraicGroup.Iso (dVariety k 2) (splitTorus (k := k)).carrierVariety,
      e.hom = splitTorusMorphism.codRestrictClosedSubgroup splitTorus
        (fun y => ⟨y, rfl⟩) := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  exact splitTorusMorphism.iso_imageClosedSubgroup_of_coordinate_preimage
    splitTorusMorphism_injective splitTorusMorphism_coordinate_preimage

/-- The standard rank-two torus identified with its closed image in the G2
Chevalley carrier. -/
public noncomputable def splitTorusIso :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    AlgebraicGroup.Iso (dVariety k 2) (splitTorus (k := k)).carrierVariety := by
  letI := (splitTorus (k := k)).carrierAlgebraicGroup
  exact Classical.choose (exists_splitTorusIso (k := k))

public lemma splitTorusIso_hom :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    (splitTorusIso (k := k)).hom =
      splitTorusMorphism.codRestrictClosedSubgroup splitTorus
        (fun y => ⟨y, rfl⟩) := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  exact Classical.choose_spec (exists_splitTorusIso (k := k))

public lemma splitTorusIso_inclusion_apply
    (x : Variety.Point (dVariety k 2)) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    (splitTorus (k := k)).inclusion.onPoints
        ((splitTorusIso (k := k)).hom.onPoints x) =
      splitTorusMorphism.onPoints x := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  rw [splitTorusIso_hom]
  exact splitTorusMorphism.codRestrictClosedSubgroup_inclusion_apply
    splitTorus (fun y => ⟨y, rfl⟩) x

public lemma splitTorusIso_ambient_inclusion_apply
    (x : Variety.Point (dVariety k 2)) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    (ambientClosedCarrier (k := k)).inclusion.onPoints
        ((splitTorus (k := k)).inclusion.onPoints
          ((splitTorusIso (k := k)).hom.onPoints x)) =
      torusAmbientMorphism.onPoints x := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  rw [splitTorusIso_inclusion_apply, splitTorusMorphism_inclusion_apply]

public lemma splitTorusIso_inverse_apply
    (s : Variety.Point (splitTorus (k := k)).carrierVariety) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    splitTorusMorphism.onPoints ((splitTorusIso (k := k)).inv.onPoints s) =
      (splitTorus (k := k)).inclusion.onPoints s := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  have h := splitTorusIso_inclusion_apply (k := k)
    ((splitTorusIso (k := k)).inv.onPoints s)
  rw [(splitTorusIso (k := k)).inv_hom_id] at h
  exact h.symm

public lemma splitTorus_inclusion_torusElement_apply
    (s : Variety.Point (splitTorus (k := k)).carrierVariety) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    (ambientClosedCarrier (k := k)).inclusion.onPoints
        ((splitTorus (k := k)).inclusion.onPoints s) =
      generalLinearRepresentationPoint (carrierBasis (k := k))
        (Matrix.GeneralLinearGroup.toLin
          (torusElement
            (dPointEquiv 2 ((splitTorusIso (k := k)).inv.onPoints s)))) := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  rw [← splitTorusIso_inverse_apply, splitTorusMorphism_inclusion_apply,
    torusAmbientMorphism_apply]
  rfl

public lemma splitTorus_diagonal_matrix_apply
    (s : Variety.Point (splitTorus (k := k)).carrierVariety) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    glPointEquivOf k (Basis → k) (carrierBasis (k := k))
        ((ambientClosedCarrier (k := k)).inclusion.onPoints
          ((splitTorus (k := k)).inclusion.onPoints s)) =
      Matrix.GeneralLinearGroup.toLin
        (torusElement
          (dPointEquiv 2 ((splitTorusIso (k := k)).inv.onPoints s))) := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  rw [splitTorus_inclusion_torusElement_apply,
    glPointEquivOf_generalLinearRepresentationPoint]

/-- The inverse point parametrization of the closed split torus. -/
public noncomputable def splitTorusPointEquiv :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    Variety.Point (splitTorus (k := k)).carrierVariety ≃*
      Variety.Point (dVariety k 2) := by
  letI := (splitTorus (k := k)).carrierAlgebraicGroup
  exact (splitTorusIso (k := k)).toMulEquiv.symm

/-- A Laurent character transported from the standard rank-two torus. -/
public noncomputable def splitTorusCharacter (z : Fin 2 → ℤ) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    TorusCharacter (splitTorus (k := k)).carrierVariety := by
  letI := (splitTorus (k := k)).carrierAlgebraicGroup
  exact (dLaurentCharacter (k := k) 2 z).comp
    (splitTorusIso (k := k)).inv

public lemma splitTorusCharacter_apply (z : Fin 2 → ℤ)
    (x : Variety.Point (dVariety k 2)) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    dPointEquiv 1
        ((splitTorusCharacter (k := k) z).onPoints
          ((splitTorusIso (k := k)).hom.onPoints x)) 0 =
      ∏ i, (dPointEquiv 2 x i) ^ z i := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  change dPointEquiv 1
      ((dLaurentCharacter (k := k) 2 z).onPoints
        ((splitTorusIso (k := k)).inv.onPoints
          ((splitTorusIso (k := k)).hom.onPoints x))) 0 = _
  rw [(splitTorusIso (k := k)).hom_inv_id, dLaurentCharacter_apply]

public lemma splitTorusCharacter_apply_point (z : Fin 2 → ℤ)
    (s : Variety.Point (splitTorus (k := k)).carrierVariety) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    dPointEquiv 1 ((splitTorusCharacter (k := k) z).onPoints s) 0 =
      ∏ i, (dPointEquiv 2 ((splitTorusIso (k := k)).inv.onPoints s) i) ^ z i := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  change dPointEquiv 1
      ((dLaurentCharacter (k := k) 2 z).onPoints
        ((splitTorusIso (k := k)).inv.onPoints s)) 0 = _
  exact dLaurentCharacter_apply 2 z _

/-- The character giving the diagonal entry indexed by `b`. -/
public noncomputable def splitTorusBasisCharacter (b : Basis) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    TorusCharacter (splitTorus (k := k)).carrierVariety :=
  splitTorusCharacter (k := k) (torusWeightExponent b)

public lemma splitTorusBasisCharacter_apply (b : Basis)
    (x : Variety.Point (dVariety k 2)) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    dPointEquiv 1
        ((splitTorusBasisCharacter (k := k) b).onPoints
          ((splitTorusIso (k := k)).hom.onPoints x)) 0 =
      basisTorusUnit (dPointEquiv 2 x) b := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  exact splitTorusCharacter_apply (k := k) (torusWeightExponent b) x

/-- A cocharacter transported from an integral exponent vector on `D₂`. -/
public noncomputable def splitTorusCocharacter (z : Fin 2 → ℤ) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    TorusCocharacter (splitTorus (k := k)).carrierVariety := by
  letI := (splitTorus (k := k)).carrierAlgebraicGroup
  exact (splitTorusIso (k := k)).hom.comp
    (dCharacterTupleMorphism (k := k) 2 1 (fun i _ => z i))

public lemma splitTorusCocharacter_inverse_apply (z : Fin 2 → ℤ)
    (t : Variety.Point (KMult k)) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    (splitTorusIso (k := k)).inv.onPoints
        ((splitTorusCocharacter (k := k) z).onPoints t) =
      (dCharacterTupleMorphism (k := k) 2 1
        (fun i _ => z i)).onPoints t := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  change (splitTorusIso (k := k)).inv.onPoints
      ((splitTorusIso (k := k)).hom.onPoints
        ((dCharacterTupleMorphism (k := k) 2 1
          (fun i _ => z i)).onPoints t)) = _
  rw [(splitTorusIso (k := k)).hom_inv_id]

public lemma splitTorusCocharacter_inclusion_apply (z : Fin 2 → ℤ)
    (t : Variety.Point (KMult k)) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    (splitTorus (k := k)).inclusion.onPoints
        ((splitTorusCocharacter (k := k) z).onPoints t) =
      splitTorusMorphism.onPoints
        ((dCharacterTupleMorphism (k := k) 2 1
          (fun i _ => z i)).onPoints t) := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  exact splitTorusIso_inclusion_apply (k := k)
    ((dCharacterTupleMorphism (k := k) 2 1
      (fun i _ => z i)).onPoints t)

public lemma splitTorusCocharacter_torusElement_apply (z : Fin 2 → ℤ)
    (t : Variety.Point (KMult k)) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    (ambientClosedCarrier (k := k)).inclusion.onPoints
        ((splitTorus (k := k)).inclusion.onPoints
          ((splitTorusCocharacter (k := k) z).onPoints t)) =
      generalLinearRepresentationPoint (carrierBasis (k := k))
        (Matrix.GeneralLinearGroup.toLin
          (torusElement (fun i => (dPointEquiv 1 t 0) ^ z i))) := by
  let _ : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
    (splitTorus (k := k)).carrierAlgebraicGroup
  rw [splitTorusCocharacter_inclusion_apply,
    splitTorusMorphism_inclusion_apply, torusAmbientMorphism_apply]
  have hparam :
      dPointEquiv 2
          ((dCharacterTupleMorphism (k := k) 2 1
            (fun i _ => z i)).onPoints t) =
        fun i => (dPointEquiv 1 t 0) ^ z i := by
    funext i
    rw [dCharacterTupleMorphism_apply]
    simp
  change generalLinearRepresentationPoint (carrierBasis (k := k))
      (Matrix.GeneralLinearGroup.toLin
        (torusElement
          (dPointEquiv 2
            ((dCharacterTupleMorphism (k := k) 2 1
              (fun i _ => z i)).onPoints t)))) = _
  rw [hparam]

public theorem exists_maximalTorus_containing_split :
    ∃ M : ClosedSubgroup (Carrier (k := k)),
      IsMaximalTorus M ∧ splitTorus (k := k) ≤ M := by
  obtain ⟨M, hM, hmax⟩ := exists_maximal_connected_closedSubgroup (Carrier (k := k))
    (fun S => IsSubtorus S ∧ splitTorus (k := k) ≤ S)
    ⟨splitTorus, splitTorus_isSubtorus, fun _ hx => hx⟩
    (fun S hS => by
      let _ : AlgebraicGroup S.carrierVariety := S.carrierAlgebraicGroup
      have hSvar : Variety.IsConnected S.carrierVariety := hS.1.isConnected
      let : ConnectedSpace (Variety.Point S.carrierVariety) :=
        connectedSpace_iff_univ.mpr hSvar
      change _root_.IsConnected (S.toSubgroup : Set (Variety.Point (Carrier (k := k))))
      rw [← S.range_inclusion]
      exact isConnected_range S.inclusion.toVariety.continuous)
  refine ⟨M, ⟨hM.1, ?_⟩, hM.2⟩
  intro S hS hMS
  exact hmax S ⟨hS, fun x hx => hMS (hM.2 hx)⟩ hMS

public noncomputable def maximalTorus : ClosedSubgroup (Carrier (k := k)) :=
  Classical.choose (exists_maximalTorus_containing_split (k := k))

public theorem maximalTorus_isMaximal : IsMaximalTorus (maximalTorus (k := k)) :=
  (Classical.choose_spec (exists_maximalTorus_containing_split (k := k))).1

public theorem maximalTorus_isSubtorus : IsSubtorus (maximalTorus (k := k)) :=
  (maximalTorus_isMaximal (k := k)).1

public theorem splitTorus_le_maximalTorus :
    splitTorus (k := k) ≤ maximalTorus (k := k) :=
  (Classical.choose_spec (exists_maximalTorus_containing_split (k := k))).2

end Theory.AlgebraicGroup.G2Chevalley
