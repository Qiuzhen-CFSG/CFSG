module

public import Mathlib.Data.Real.Basic
public import Mathlib.LinearAlgebra.RootSystem.Base

/-! Dynkin-type labels used by root-system classification interfaces. -/

namespace Theory.AlgebraicGroup

public inductive DynkinType
  | A | B | C | D | E6 | E7 | E8 | F4 | G2
  deriving DecidableEq

public structure RootClassification where
  kind : DynkinType
  rank : Nat

/-! GLS3, Definition 1.8.1. -/

/-- Definition 1.8.1: a Euclidean root system, represented by Mathlib's
finite real root-pairing interface. -/
public abbrev EuclideanRootSystem
    (ι E E' : Type*) [Finite ι]
    [AddCommGroup E] [Module ℝ E] [AddCommGroup E'] [Module ℝ E'] :=
  RootPairing ι ℝ E E'

/-- Definition 1.8.1: the root-system condition. -/
public abbrev IsEuclideanRootSystem
    {ι E E' : Type*} [Finite ι]
    [AddCommGroup E] [Module ℝ E] [AddCommGroup E'] [Module ℝ E']
    (P : EuclideanRootSystem ι E E') : Prop :=
  P.IsRootSystem

/-- Definition 1.8.1: reducedness. -/
public abbrev IsReducedRootSystem
    {ι E E' : Type*} [Finite ι]
    [AddCommGroup E] [Module ℝ E] [AddCommGroup E'] [Module ℝ E']
    (P : EuclideanRootSystem ι E E') : Prop :=
  P.IsReduced

/-- Definition 1.8.1: crystallographicity. -/
public abbrev IsCrystallographicRootSystem
    {ι E E' : Type*} [Finite ι]
    [AddCommGroup E] [Module ℝ E] [AddCommGroup E'] [Module ℝ E']
    (P : EuclideanRootSystem ι E E') : Prop :=
  P.IsCrystallographic

/-- Definition 1.8.1: the Weyl group generated by the root reflections. -/
public noncomputable abbrev RootSystemWeylGroup
    {ι E E' : Type*} [Finite ι]
    [AddCommGroup E] [Module ℝ E] [AddCommGroup E'] [Module ℝ E']
    (P : EuclideanRootSystem ι E E') :=
  P.weylGroup

open Set

/-- Definition 1.8.4: an orthogonal decomposition of the roots.  The parts
partition the root indices, and roots in distinct parts are orthogonal. -/
public structure _root_.RootPairing.OrthogonalDecomposition
    {ι R M N : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) where
  parts : Set (Set ι)
  nonempty_parts : ∀ s ∈ parts, s.Nonempty
  cover : ⋃₀ parts = Set.univ
  pairwise_disjoint : parts.PairwiseDisjoint id
  orthogonal : ∀ s ∈ parts, ∀ t ∈ parts, s ≠ t →
    ∀ i ∈ s, ∀ j ∈ t, P.IsOrthogonal i j

/-- Definition 1.8.4: a nonempty set of roots is irreducible when it cannot
be partitioned into two nonempty orthogonal subsets. -/
@[expose]
public def _root_.RootPairing.IsIrreducibleSet
    {ι R M N : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) (s : Set ι) : Prop :=
  s.Nonempty ∧
    ∀ a b : Set ι, a.Nonempty → b.Nonempty → a ∪ b = s → Disjoint a b →
      ∃ i ∈ a, ∃ j ∈ b, ¬ P.IsOrthogonal i j

/-- An orthogonal decomposition is irreducible when each of its parts is. -/
@[expose]
public def _root_.RootPairing.OrthogonalDecomposition.IsIrreducible
    {ι R M N : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {P : RootPairing ι R M N} (d : P.OrthogonalDecomposition) : Prop :=
  ∀ s ∈ d.parts, P.IsIrreducibleSet s

/-- Definition 1.8.4: two root systems are isomorphic when their root
pairings are equivalent, so the root bijection preserves all pairings. -/
public abbrev _root_.RootPairing.IsIsomorphic
    {ι ι₂ R M N M₂ N₂ : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    [AddCommGroup M₂] [Module R M₂] [AddCommGroup N₂] [Module R N₂]
    (P : RootPairing ι R M N) (Q : RootPairing ι₂ R M₂ N₂) : Prop :=
  Nonempty (P.Equiv Q)

/-- Definition 1.8.6: the directed integral Cartan data on a set of roots.
For roots meeting at an obtuse or right angle, the two directed entries encode
both the bond strength (their product) and its orientation. -/
@[expose]
public noncomputable def _root_.RootPairing.dynkinDiagramOn
    {ι R M N : Type*} [CommRing R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsCrystallographic] (X : Set ι) :
    Matrix X X ℤ :=
  fun i j => P.pairingIn ℤ i j

/-- The strength of the bond joining two vertices of a Dynkin diagram. -/
public noncomputable def _root_.RootPairing.dynkinBondStrength
    {ι R M N : Type*} [CommRing R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsCrystallographic]
    (X : Set ι) (i j : X) : ℤ :=
  P.dynkinDiagramOn X i j * P.dynkinDiagramOn X j i

/-- An isomorphism of Dynkin diagrams preserves the directed Cartan entries;
hence it preserves both bond strengths and arrow orientations. -/
public structure _root_.RootPairing.DynkinDiagramIso
    {ι ι₂ R M N M₂ N₂ : Type*} [CommRing R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    [AddCommGroup M₂] [Module R M₂] [AddCommGroup N₂] [Module R N₂]
    (P : RootPairing ι R M N) [P.IsCrystallographic] (X : Set ι)
    (Q : RootPairing ι₂ R M₂ N₂) [Q.IsCrystallographic] (Y : Set ι₂) where
  toEquiv : X ≃ Y
  map_entry : ∀ i j,
    Q.dynkinDiagramOn Y (toEquiv i) (toEquiv j) = P.dynkinDiagramOn X i j

/-- The Dynkin diagram of a root system relative to a fundamental system. -/
public noncomputable abbrev _root_.RootPairing.Base.dynkinDiagram
    {ι R M N : Type*} [CommRing R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {P : RootPairing ι R M N} [P.IsCrystallographic] (b : P.Base) :
    Matrix b.support b.support ℤ :=
  P.dynkinDiagramOn b.support

/-- The extended Dynkin diagram obtained by adjoining a distinguished lowest
root to the vertices of a based diagram. -/
public noncomputable def _root_.RootPairing.extendedDynkinDiagramOn
    {ι R M N : Type*} [CommRing R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsCrystallographic]
    (X : Set ι) (lowest : ι) :
    Matrix ↥(insert lowest X) ↥(insert lowest X) ℤ :=
  P.dynkinDiagramOn (insert lowest X)

/-- The extended Dynkin diagram of a base, with its lowest-root index
adjoined as a blackened vertex in the source notation. -/
public noncomputable abbrev _root_.RootPairing.Base.extendedDynkinDiagram
    {ι R M N : Type*} [CommRing R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {P : RootPairing ι R M N} [P.IsCrystallographic]
    (b : P.Base) (lowest : ι) :
    Matrix ↥(insert lowest (b.support : Set ι))
      ↥(insert lowest (b.support : Set ι)) ℤ :=
  P.extendedDynkinDiagramOn (b.support : Set ι) lowest

end Theory.AlgebraicGroup
