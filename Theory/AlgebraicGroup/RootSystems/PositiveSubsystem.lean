/-- A positive-definite diagonal symmetrization cannot contain a triangle whose
diagonal entries are `2` and whose directed off-diagonal entries are all at
most `-1`. -/
public lemma not_cartan_weightedTriangle_of_diagonal_mul_posDef
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (A : Matrix κ κ ℤ) (d : κ → ℤ)
    (hpos : (Matrix.diagonal d * A).PosDef)
    (e : Fin 3 ↪ κ)
    (hdiag : ∀ i, A (e i) (e i) = 2)
    (hoff : ∀ i j, i ≠ j → A (e i) (e j) ≤ -1) : False := by
  have hsub := hpos.submatrix e.injective
  let x : Fin 3 → ℤ := fun _ => 1
  have hx : x ≠ 0 := by
    intro h
    have h0 := congrFun h 0
    simp [x] at h0
  have hd (i : Fin 3) : 0 < d (e i) := by
    have hi := hpos.diag_pos (i := e i)
    simp [Matrix.diagonal_mul, hdiag] at hi
    omega
  have hrow0 : 2 + A (e 0) (e 1) + A (e 0) (e 2) ≤ 0 := by
    have h01 := hoff 0 1 (by decide)
    have h02 := hoff 0 2 (by decide)
    omega
  have hrow1 : A (e 1) (e 0) + 2 + A (e 1) (e 2) ≤ 0 := by
    have h10 := hoff 1 0 (by decide)
    have h12 := hoff 1 2 (by decide)
    omega
  have hrow2 : A (e 2) (e 0) + A (e 2) (e 1) + 2 ≤ 0 := by
    have h20 := hoff 2 0 (by decide)
    have h21 := hoff 2 1 (by decide)
    omega
  have hnon0 : d (e 0) * (2 + A (e 0) (e 1) + A (e 0) (e 2)) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (hd 0).le hrow0
  have hnon1 : d (e 1) * (A (e 1) (e 0) + 2 + A (e 1) (e 2)) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (hd 1).le hrow1
  have hnon2 : d (e 2) * (A (e 2) (e 0) + A (e 2) (e 1) + 2) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (hd 2).le hrow2
  have hquad := hsub.dotProduct_mulVec_pos hx
  simp [x, Matrix.submatrix, Matrix.diagonal_mul, dotProduct, Matrix.mulVec,
    hdiag, Fin.sum_univ_succ] at hquad
  nlinarith

/-- A matrix with a nonzero integral kernel vector cannot become positive
definite after diagonal row scaling. -/
public lemma not_diagonal_mul_posDef_of_nonzero_mulVec_eq_zero
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (A : Matrix κ κ ℤ) (d : κ → ℤ) (x : κ → ℤ)
    (hx : x ≠ 0) (hker : A.mulVec x = 0) :
    ¬(Matrix.diagonal d * A).PosDef := by
  intro hpos
  have hmul : (Matrix.diagonal d * A).mulVec x = 0 := by
    rw [← Matrix.mulVec_mulVec, hker, Matrix.mulVec_zero]
  have hquad := hpos.dotProduct_mulVec_pos hx
  rw [hmul, dotProduct_zero] at hquad
  exact (lt_irrefl 0) hquad

/-- Remark 1.8.9: an irreducible reduced crystallographic root system has
roots of at most two lengths, measured by any invariant form. -/
public theorem invariantForm_atMost_two_rootLengths
    {ι R M N : Type*} [Finite ι] [Nonempty ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsCrystallographic] [P.IsReduced]
    [P.IsIrreducible] (B : P.InvariantForm) :
    ∃ i j, ∀ k,
      B.form (P.root k) (P.root k) = B.form (P.root i) (P.root i) ∨
      B.form (P.root k) (P.root k) = B.form (P.root j) (P.root j) :=
  B.exists_apply_eq_or

/-- Remark 1.8.9: relative to any base, every root is Weyl-conjugate to a
root belonging to that base. -/
public theorem weylGroup_orbit_meets_base
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsCrystallographic] [P.IsReduced]
    (b : P.Base) (i : ι) :
    ∃ g : P.weylGroup, ∃ j, j ∈ b.support ∧ g • P.root i = P.root j := by
  suffices ∃ g : P.weylGroup, P.weylGroupToPerm g i ∈ b.support by
    obtain ⟨g, hg⟩ := this
    exact ⟨g, P.weylGroupToPerm g i, hg, P.weylGroup_apply_root g i⟩
  apply b.induction_reflect i
  · intro k ⟨g, hg⟩
    let r : P.weylGroup :=
      ⟨RootPairing.Equiv.reflection P k, P.reflection_mem_weylGroup k⟩
    refine ⟨g * r, ?_⟩
    simpa [r] using hg
  · intro k hk
    exact ⟨1, by simpa using hk⟩
  · intro k j ⟨g, hg⟩ hj
    let r : P.weylGroup :=
      ⟨RootPairing.Equiv.reflection P j, P.reflection_mem_weylGroup j⟩
    refine ⟨g * r, ?_⟩
    simpa [r] using hg

open Set

/-- Remark 1.8.9: every positive root is a sum of simple roots such that
each nonempty initial partial sum is again a root. -/
public theorem positiveRoot_sum_chain
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {P : RootPairing ι R M N} [P.IsCrystallographic]
    (b : P.Base) {i : ι} (hi : b.IsPos i) :
    ∃ n, ∃ f : Fin n → ι,
      range f ⊆ b.support ∧
      P.root i = ∑ m, P.root (f m) ∧
      ∀ m, ∑ m' ≤ m, P.root (f m') ∈ range P.root :=
  b.exists_eq_sum_and_forall_sum_mem_of_isPos hi

open MulAction Set Submodule

/-- Remark 1.8.9: for an irreducible root system, the roots having the same
length as any fixed root span the ambient root space. -/
public theorem sameLengthRoots_span_rootSpace
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsCrystallographic] [P.IsReduced]
    [P.IsIrreducible] (B : P.InvariantForm) (i : ι) :
    span R (P.root '' {j |
      B.form (P.root j) (P.root j) = B.form (P.root i) (P.root i)}) = ⊤ := by
  apply top_unique
  rw [← P.span_orbit_eq_top i]
  apply span_mono
  intro x hx
  obtain ⟨g, rfl⟩ := mem_orbit_iff.mp hx
  refine ⟨P.weylGroupToPerm g i, ?_, P.weylGroup_apply_root g i |>.symm⟩
  simp only [Set.mem_ofPred_eq]
  rw [← P.weylGroup_apply_root g i]
  exact RootPairing.InvariantForm.apply_weylGroup_smul P (B := B) g
    (P.root i) (P.root i)

open SimpleGraph

/-- An injective homomorphism of finite simple graphs cannot increase the
degree at a vertex.  The proof compares the finite neighbor-set subtypes via
the induced injection; no conclusion-bearing graph structure is introduced. -/
public lemma simpleGraph_degree_le_of_injective_hom
    {V W : Type*} [Fintype V] [Fintype W]
    (G : SimpleGraph V) (H : SimpleGraph W)
    [DecidableRel G.Adj] [DecidableRel H.Adj]
    (f : G →g H) (hf : Function.Injective f) (v : V) :
    G.degree v ≤ H.degree (f v) := by
  classical
  let nmap : G.neighborSet v → H.neighborSet (f v) := fun w =>
    ⟨f w.1, f.apply_mem_neighborSet w.2⟩
  have hninj : Function.Injective nmap := by
    intro x y hxy
    apply Subtype.ext
    apply hf
    exact congrArg (fun z : H.neighborSet (f v) => (z : W)) hxy
  simpa only [SimpleGraph.card_neighborSet_eq_degree] using
    (Fintype.card_le_of_injective nmap hninj)

/-- A degree-three vertex has exactly three pairwise-distinct neighbors.
The witnesses and the exhaustive adjacency description are ordinary theorem
conclusions, ready for the three-arm decomposition of a finite tree. -/
public lemma simpleGraph_degree_three_neighbors
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (c : V) (hdeg : G.degree c = 3) :
    ∃ a b d : V,
      a ≠ b ∧ a ≠ d ∧ b ≠ d ∧
      G.Adj c a ∧ G.Adj c b ∧ G.Adj c d ∧
      ∀ v, G.Adj c v ↔ v = a ∨ v = b ∨ v = d := by
  have hcard : (G.neighborFinset c).card = 3 := by
    simpa only [G.card_neighborFinset_eq_degree] using hdeg
  obtain ⟨a, b, d, hab, had, hbd, hneighbors⟩ :=
    Finset.card_eq_three.mp hcard
  refine ⟨a, b, d, hab, had, hbd, ?_, ?_, ?_, ?_⟩
  · rw [← G.mem_neighborFinset, hneighbors]
    simp
  · rw [← G.mem_neighborFinset, hneighbors]
    simp
  · rw [← G.mem_neighborFinset, hneighbors]
    simp
  · intro v
    rw [← G.mem_neighborFinset, hneighbors]
    simp

end Theory.AlgebraicGroup
