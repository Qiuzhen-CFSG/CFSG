open Set

namespace Theory.AlgebraicGroup

variable {ι R M N : Type*} [CommRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-- A positive subsystem of a root pairing: it is closed under addition of
roots and contains exactly one root from each pair `α, -α`. -/
public structure _root_.RootPairing.PositiveSubsystem (P : RootPairing ι R M N) where
  /-- The indices of the positive roots. -/
  carrier : Set ι
  add_mem {i j k : ι} :
    i ∈ carrier → j ∈ carrier → P.root k = P.root i + P.root j → k ∈ carrier
  mem_xor_neg (i : ι) :
    Xor (i ∈ carrier) (P.reflectionPerm i i ∈ carrier)

variable {P : RootPairing ι R M N}

public instance _root_.RootPairing.PositiveSubsystem.instSetLike :
    SetLike P.PositiveSubsystem ι where
  coe := RootPairing.PositiveSubsystem.carrier
  coe_injective S T h := by cases S; cases T; cases h; rfl

/-- A positive root is indecomposable if it is not a sum of two positive
roots. -/
public def _root_.RootPairing.PositiveSubsystem.IsIndecomposable
    (S : P.PositiveSubsystem) (i : ι) : Prop :=
  i ∈ S ∧ ¬∃ j k, j ∈ S ∧ k ∈ S ∧ P.root i = P.root j + P.root k

public lemma _root_.RootPairing.PositiveSubsystem.isIndecomposable_iff
    (S : P.PositiveSubsystem) (i : ι) :
    S.IsIndecomposable i ↔
      i ∈ S ∧ ¬∃ j k, j ∈ S ∧ k ∈ S ∧ P.root i = P.root j + P.root k :=
  Iff.rfl

@[ext]
public lemma _root_.RootPairing.PositiveSubsystem.ext
    {S T : P.PositiveSubsystem} (h : ∀ i, i ∈ S ↔ i ∈ T) : S = T := by
  apply SetLike.ext
  exact h

public lemma _root_.RootPairing.PositiveSubsystem.mem_or_neg
    (S : P.PositiveSubsystem) (i : ι) :
    i ∈ S ∨ P.reflectionPerm i i ∈ S :=
  (S.mem_xor_neg i).imp And.left And.left

public lemma _root_.RootPairing.PositiveSubsystem.neg_mem_iff_not_mem
    (S : P.PositiveSubsystem) (i : ι) :
    P.reflectionPerm i i ∈ S ↔ i ∉ S := by
  rcases S.mem_xor_neg i with h | h
  · constructor
    · intro hneg hi
      exact h.2 hneg
    · intro hi
      exact (hi h.1).elim
  · exact ⟨fun _ => h.2, fun _ => h.1⟩

/-- The positive subsystem determined by a base. -/
public def _root_.RootPairing.Base.toPositiveSubsystem
    [CharZero R] (b : P.Base) : P.PositiveSubsystem where
  carrier := {i | b.IsPos i}
  add_mem hi hj hk := hi.add hj hk
  mem_xor_neg i := by
    let := P.indexNeg
    rcases RootPairing.Base.IsPos.or_neg b i with hi | hni
    · refine Or.inl ⟨hi, ?_⟩
      intro hneg
      exact (RootPairing.Base.IsPos.neg_iff_not b i).mp hneg hi
    · exact Or.inr
        ⟨by simpa using hni, (RootPairing.Base.IsPos.neg_iff_not b i).mp hni⟩

@[simp]
public lemma _root_.RootPairing.Base.mem_toPositiveSubsystem
    [CharZero R] (b : P.Base) (i : ι) :
    i ∈ b.toPositiveSubsystem ↔ b.IsPos i :=
  Iff.rfl

/-- A root is positive relative to a base exactly when it belongs to the
additive monoid generated by the simple roots. -/
public theorem _root_.RootPairing.Base.isPos_iff_root_mem_closure
    {ι R M N : Type*} [CommRing R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {P : RootPairing ι R M N} (b : P.Base) (i : ι) :
    b.IsPos i ↔ P.root i ∈ AddSubmonoid.closure (P.root '' (b.support : Set ι)) := by
  classical
  have closure_exists (m : M)
      (hm : m ∈ AddSubmonoid.closure (P.root '' (b.support : Set ι))) :
      ∃ f : ι → ℕ, f.support ⊆ b.support ∧
        m = ∑ j ∈ b.support, f j • P.root j := by
    induction hm using AddSubmonoid.closure_induction with
    | mem x hx =>
        rcases hx with ⟨j, hj, rfl⟩
        exact ⟨Pi.single j 1, by simpa, by
          rw [Finset.sum_eq_single_of_mem j hj]
          · simp
          · intro k hk hkj
            simp [hkj]⟩
    | zero => exact ⟨0, by simp, by simp⟩
    | add x y hx hy hx' hy' =>
        rcases hx' with ⟨f, hf, rfl⟩
        rcases hy' with ⟨g, hg, rfl⟩
        exact ⟨f + g, (Function.support_add f g).trans (union_subset hf hg), by
          simp [add_smul, Finset.sum_add_distrib]⟩
  constructor
  · intro hi
    obtain ⟨f, hf, hroot | hroot⟩ := b.exists_root_eq_sum_nat_or_neg i
    · rw [hroot]
      exact AddSubmonoid.sum_mem _ fun j hj =>
        AddSubmonoid.nsmul_mem _
          (AddSubmonoid.subset_closure (show P.root j ∈ P.root '' (b.support : Set ι) from
            ⟨j, by simpa using hj, rfl⟩)) _
    · let z : ι → ℤ := fun j => -(f j : ℤ)
      have hz : P.root i = ∑ j ∈ b.support, z j • P.root j := by
        simp [z, Finset.sum_neg_distrib, hroot]
      rw [b.isPos_iff, b.height_eq_sum hz] at hi
      have hnonneg : 0 ≤ ∑ j ∈ b.support, (f j : ℤ) :=
        Finset.sum_nonneg fun _ _ => by simp
      simp [z] at hi
      omega
  · intro hi
    obtain ⟨f, hf, hsum⟩ := closure_exists _ hi
    let z : ι → ℤ := fun j => (f j : ℤ)
    have hz : P.root i = ∑ j ∈ b.support, z j • P.root j := by
      simpa [z] using hsum
    rw [b.isPos_iff, b.height_eq_sum hz]
    have hnonneg : 0 ≤ ∑ j ∈ b.support, z j :=
      Finset.sum_nonneg fun _ _ => by simp [z]
    have hne : ∑ j ∈ b.support, z j ≠ 0 := by
      intro hzero
      have hzzero : ∀ j ∈ b.support, z j = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg (fun j hj => by simp [z])).mp hzero
      apply P.ne_zero i
      rw [hz]
      exact Finset.sum_eq_zero fun j hj => by simp [hzzero j hj]
    omega

/-- The closure-induction connectedness premise for a Cartan matrix implies
preconnectedness of its undirected nonzero-entry support graph. -/
public lemma cartanSupport_preconnected
    {κ : Type*} (A : Matrix κ κ ℤ)
    (hconn : ∀ (p : κ → Prop) {i j : κ}, p i →
      (∀ i j, p i → A j i ≠ 0 → p j) → p j) :
    (SimpleGraph.fromRel fun i j => A i j ≠ 0).Preconnected := by
  let G : SimpleGraph κ := SimpleGraph.fromRel fun i j => A i j ≠ 0
  change G.Preconnected
  intro i j
  apply hconn (fun k => G.Reachable i k) (i := i) (j := j)
  · exact SimpleGraph.Reachable.rfl
  · intro u v hu huv
    by_cases huvEq : u = v
    · simpa [huvEq] using hu
    · have hadj : G.Adj u v := by
        change (SimpleGraph.fromRel fun i j => A i j ≠ 0).Adj u v
        rw [SimpleGraph.fromRel_adj]
        exact ⟨huvEq, Or.inr huv⟩
      exact hu.trans hadj.reachable

/-- A positive-definite diagonal symmetrization equates the two weighted
orientations of every matrix entry. -/
public lemma cartanSymmetrizer_entry_eq_of_diagonal_mul_posDef
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (A : Matrix κ κ ℤ) (d : κ → ℤ)
    (hpos : (Matrix.diagonal d * A).PosDef) (i j : κ) :
    d i * A i j = d j * A j i := by
  have hij := hpos.isHermitian.apply i j
  simpa [Matrix.diagonal_mul] using hij.symm

open SimpleGraph

/-- Under an exact path-graph numbering of Cartan support, two distinct
nonadjacent path positions have both directed entries equal to zero. -/
public lemma cartan_pathGraph_nonadjacent_entries_eq_zero
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (A : Matrix κ κ ℤ)
    (hrank : ∀ i j, i ≠ j →
      (A i j = 0 ∧ A j i = 0) ∨
      (A i j = -1 ∧ A j i = -1) ∨
      (A i j = -1 ∧ A j i = -2) ∨
      (A i j = -2 ∧ A j i = -1) ∨
      (A i j = -1 ∧ A j i = -3) ∨
      (A i j = -3 ∧ A j i = -1))
    {n : ℕ} (e : Fin n ≃ κ)
    (hpath : ∀ i j,
      (SimpleGraph.fromRel fun i j => A i j ≠ 0).Adj (e i) (e j) ↔
        (pathGraph n).Adj i j)
    {i j : Fin n} (hij : i ≠ j) (hnadj : ¬(pathGraph n).Adj i j) :
    A (e i) (e j) = 0 ∧ A (e j) (e i) = 0 := by
  have hforward : A (e i) (e j) = 0 := by
    by_contra hne
    apply hnadj
    apply (hpath i j).mp
    rw [SimpleGraph.fromRel_adj]
    exact ⟨e.injective.ne hij, Or.inl hne⟩
  rcases hrank (e i) (e j) (e.injective.ne hij) with
    h0 | h11 | h12 | h21 | h13 | h31
  · exact h0
  all_goals omega

/-- In the six finite rank-two Cartan patterns, a nonzero off-diagonal entry
forces both orientations to be negative and their product to be positive. -/
public lemma cartan_rankTwo_nonzero_bounds
    {κ : Type*} (A : Matrix κ κ ℤ)
    (hrank : ∀ i j, i ≠ j →
      (A i j = 0 ∧ A j i = 0) ∨
      (A i j = -1 ∧ A j i = -1) ∨
      (A i j = -1 ∧ A j i = -2) ∨
      (A i j = -2 ∧ A j i = -1) ∨
      (A i j = -1 ∧ A j i = -3) ∨
      (A i j = -3 ∧ A j i = -1))
    {i j : κ} (hij : i ≠ j) (hne : A i j ≠ 0) :
    A i j ≤ -1 ∧ A j i ≤ -1 ∧ 1 ≤ A i j * A j i := by
  rcases hrank i j hij with h0 | ⟨hijA, hjiA⟩ | ⟨hijA, hjiA⟩ |
    ⟨hijA, hjiA⟩ | ⟨hijA, hjiA⟩ | ⟨hijA, hjiA⟩
  · exact (hne h0.1).elim
  all_goals simp [hijA, hjiA]

open SimpleGraph

/-- If an exact global three-arm numbering has simple center bonds and simple
consecutive arm bonds, every directed support edge has matrix entry `-1`. -/
public lemma cartan_three_arm_support_adj_entry_eq_neg_one
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (A : Matrix κ κ ℤ) {n0 n1 n2 : ℕ}
    (e : Option (Fin (n0 + 1) ⊕ Fin (n1 + 1) ⊕ Fin (n2 + 1)) ≃ κ)
    (hcenter0 : ∀ j,
      (SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj
        (e none) (e (some (Sum.inl j))) ↔ j = 0)
    (hcenter1 : ∀ j,
      (SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj
        (e none) (e (some (Sum.inr (Sum.inl j)))) ↔ j = 0)
    (hcenter2 : ∀ j,
      (SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj
        (e none) (e (some (Sum.inr (Sum.inr j)))) ↔ j = 0)
    (hpath0 : ∀ j l,
      (SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj
        (e (some (Sum.inl j))) (e (some (Sum.inl l))) ↔
        (pathGraph (n0 + 1)).Adj j l)
    (hpath1 : ∀ j l,
      (SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj
        (e (some (Sum.inr (Sum.inl j))))
        (e (some (Sum.inr (Sum.inl l)))) ↔
        (pathGraph (n1 + 1)).Adj j l)
    (hpath2 : ∀ j l,
      (SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj
        (e (some (Sum.inr (Sum.inr j))))
        (e (some (Sum.inr (Sum.inr l)))) ↔
        (pathGraph (n2 + 1)).Adj j l)
    (hcross01 : ∀ j l,
      ¬(SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj
        (e (some (Sum.inl j))) (e (some (Sum.inr (Sum.inl l)))))
    (hcross02 : ∀ j l,
      ¬(SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj
        (e (some (Sum.inl j))) (e (some (Sum.inr (Sum.inr l)))))
    (hcross12 : ∀ j l,
      ¬(SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj
        (e (some (Sum.inr (Sum.inl j))))
        (e (some (Sum.inr (Sum.inr l)))))
    (hcenterBond0 :
      A (e none) (e (some (Sum.inl 0))) = -1 ∧
      A (e (some (Sum.inl 0))) (e none) = -1)
    (hcenterBond1 :
      A (e none) (e (some (Sum.inr (Sum.inl 0)))) = -1 ∧
      A (e (some (Sum.inr (Sum.inl 0)))) (e none) = -1)
    (hcenterBond2 :
      A (e none) (e (some (Sum.inr (Sum.inr 0)))) = -1 ∧
      A (e (some (Sum.inr (Sum.inr 0)))) (e none) = -1)
    (hsimple0 : ∀ r : Fin (n0 + 1), 0 < r.val →
      A (e (some (Sum.inl ⟨r.val - 1, by omega⟩)))
          (e (some (Sum.inl r))) = -1 ∧
      A (e (some (Sum.inl r)))
          (e (some (Sum.inl ⟨r.val - 1, by omega⟩))) = -1)
    (hsimple1 : ∀ r : Fin (n1 + 1), 0 < r.val →
      A (e (some (Sum.inr (Sum.inl ⟨r.val - 1, by omega⟩))))
          (e (some (Sum.inr (Sum.inl r)))) = -1 ∧
      A (e (some (Sum.inr (Sum.inl r))))
          (e (some (Sum.inr (Sum.inl ⟨r.val - 1, by omega⟩)))) = -1)
    (hsimple2 : ∀ r : Fin (n2 + 1), 0 < r.val →
      A (e (some (Sum.inr (Sum.inr ⟨r.val - 1, by omega⟩))))
          (e (some (Sum.inr (Sum.inr r)))) = -1 ∧
      A (e (some (Sum.inr (Sum.inr r))))
          (e (some (Sum.inr (Sum.inr ⟨r.val - 1, by omega⟩)))) = -1) :
    ∀ x y,
      (SimpleGraph.fromRel fun x y => A x y ≠ 0).Adj x y → A x y = -1 := by
  let G : SimpleGraph κ := SimpleGraph.fromRel fun x y => A x y ≠ 0
  have sameArm : ∀ {n : ℕ} (f : Fin (n + 1) → κ),
      (∀ j l, G.Adj (f j) (f l) ↔ (pathGraph (n + 1)).Adj j l) →
      (∀ r : Fin (n + 1), 0 < r.val →
        A (f ⟨r.val - 1, by omega⟩) (f r) = -1 ∧
        A (f r) (f ⟨r.val - 1, by omega⟩) = -1) →
      ∀ j l, G.Adj (f j) (f l) → A (f j) (f l) = -1 := by
    intro n f hpath hsimple j l hadj
    have hp := (hpath j l).mp hadj
    rw [pathGraph_adj] at hp
    rcases hp with hjl | hlj
    · have hlpos : 0 < l.val := by omega
      have hs := hsimple l hlpos
      have hpred : (⟨l.val - 1, by omega⟩ : Fin (n + 1)) = j := by
        apply Fin.ext
        change l.val - 1 = j.val
        omega
      rw [hpred] at hs
      exact hs.1
    · have hjpos : 0 < j.val := by omega
      have hs := hsimple j hjpos
      have hpred : (⟨j.val - 1, by omega⟩ : Fin (n + 1)) = l := by
        apply Fin.ext
        change j.val - 1 = l.val
        omega
      rw [hpred] at hs
      exact hs.2
  intro x y hxy
  generalize hix : e.symm x = ix
  generalize hiy : e.symm y = iy
  have hx : e ix = x := by
    rw [← hix]
    exact e.apply_symm_apply x
  have hy : e iy = y := by
    rw [← hiy]
    exact e.apply_symm_apply y
  rw [← hx, ← hy] at hxy ⊢
  cases ix with
  | none =>
      cases iy with
      | none => exact (G.irrefl hxy).elim
      | some s =>
          cases s with
          | inl j =>
              have hj := (hcenter0 j).mp hxy
              subst j
              exact hcenterBond0.1
          | inr s =>
              cases s with
              | inl j =>
                  have hj := (hcenter1 j).mp hxy
                  subst j
                  exact hcenterBond1.1
              | inr j =>
                  have hj := (hcenter2 j).mp hxy
                  subst j
                  exact hcenterBond2.1
  | some s =>
      cases s with
      | inl j =>
          cases iy with
          | none =>
              have h := hxy
              rw [G.adj_comm] at h
              have hj := (hcenter0 j).mp h
              subst j
              exact hcenterBond0.2
          | some t =>
              cases t with
              | inl l =>
                  exact sameArm (fun q => e (some (Sum.inl q))) hpath0 hsimple0 j l hxy
              | inr t =>
                  cases t with
                  | inl l => exact (hcross01 j l hxy).elim
                  | inr l => exact (hcross02 j l hxy).elim
      | inr s =>
          cases s with
          | inl j =>
              cases iy with
              | none =>
                  have h := hxy
                  rw [G.adj_comm] at h
                  have hj := (hcenter1 j).mp h
                  subst j
                  exact hcenterBond1.2
              | some t =>
                  cases t with
                  | inl l =>
                      have h := hxy
                      rw [G.adj_comm] at h
                      exact (hcross01 l j h).elim
                  | inr t =>
                      cases t with
                      | inl l =>
                          exact sameArm
                            (fun q => e (some (Sum.inr (Sum.inl q))))
                            hpath1 hsimple1 j l hxy
                      | inr l => exact (hcross12 j l hxy).elim
          | inr j =>
              cases iy with
              | none =>
                  have h := hxy
                  rw [G.adj_comm] at h
                  have hj := (hcenter2 j).mp h
                  subst j
                  exact hcenterBond2.2
              | some t =>
                  cases t with
                  | inl l =>
                      have h := hxy
                      rw [G.adj_comm] at h
                      exact (hcross02 l j h).elim
                  | inr t =>
                      cases t with
                      | inl l =>
                          have h := hxy
                          rw [G.adj_comm] at h
                          exact (hcross12 l j h).elim
                      | inr l =>
                          exact sameArm
                            (fun q => e (some (Sum.inr (Sum.inr q))))
                            hpath2 hsimple2 j l hxy

open scoped SimpleGraph

/-- An injective numbering of a central simple path together with two distinct
off-path vertices at each endpoint.  The four extra vertices are kept as
ordinary witnesses; no affine-D or classification conclusion is packaged in
the statement. -/
public lemma central_path_plus_four_offpath_embedding
    {V : Type*}
    {G : SimpleGraph V} {c₁ c₂ : V} {p : G.Walk c₁ c₂}
    (hp : p.IsPath)
    {a₁ a₂ b₁ b₂ : V}
    (ha12 : a₁ ≠ a₂) (hb12 : b₁ ≠ b₂)
    (hab₁ : a₁ ≠ b₁) (hab₂ : a₁ ≠ b₂)
    (hac₁ : a₂ ≠ b₁) (hac₂ : a₂ ≠ b₂)
    (ha₁off : a₁ ∉ p.support) (ha₂off : a₂ ∉ p.support)
    (hb₁off : b₁ ∉ p.support) (hb₂off : b₂ ∉ p.support) :
    ∃ e : Fin (p.length + 1 + 4) ↪ V,
      (∀ i : Fin (p.length + 1), e (Fin.castAdd 4 i) = p.getVert i) ∧
      e (Fin.natAdd (p.length + 1) (0 : Fin 4)) = a₁ ∧
      e (Fin.natAdd (p.length + 1) (1 : Fin 4)) = a₂ ∧
      e (Fin.natAdd (p.length + 1) (2 : Fin 4)) = b₁ ∧
      e (Fin.natAdd (p.length + 1) (3 : Fin 4)) = b₂ := by
  classical
  let e4 : Fin 4 → V := ![a₁, a₂, b₁, b₂]
  have he4 : Function.Injective e4 := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [e4]
  have hpget : Function.Injective (fun i : Fin (p.length + 1) => p.getVert i) := by
    intro i j hij
    apply Fin.ext
    apply hp.getVert_injOn
    · exact Nat.le_of_lt_succ i.isLt
    · exact Nat.le_of_lt_succ j.isLt
    · exact hij
  have hcross : ∀ (i : Fin (p.length + 1)) (j : Fin 4),
      p.getVert i ≠ e4 j := by
    intro i j hij
    have himem : p.getVert i ∈ p.support := p.getVert_mem_support i
    fin_cases j <;> simp_all [e4]
  have hsum : Function.Injective
      (Sum.elim (fun i : Fin (p.length + 1) => p.getVert i) e4) := by
    intro x y hxy
    rcases x with i | i <;> rcases y with j | j
    · exact congrArg Sum.inl (hpget hxy)
    · exact (hcross i j hxy).elim
    · exact (hcross j i hxy.symm).elim
    · exact congrArg Sum.inr (he4 hxy)
  let es : Fin (p.length + 1 + 4) ↪ V :=
    ⟨(Sum.elim (fun i : Fin (p.length + 1) => p.getVert i) e4) ∘
        finSumFinEquiv.symm,
      fun i j hij => by
        have hs : finSumFinEquiv.symm i = finSumFinEquiv.symm j := hsum hij
        calc
          i = finSumFinEquiv (finSumFinEquiv.symm i) :=
            (finSumFinEquiv.apply_symm_apply i).symm
          _ = finSumFinEquiv (finSumFinEquiv.symm j) := by rw [hs]
          _ = j := finSumFinEquiv.apply_symm_apply j⟩
  refine ⟨es, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    change ((Sum.elim (fun i : Fin (p.length + 1) => p.getVert i) e4) ∘
        finSumFinEquiv.symm) (Fin.castAdd 4 i) = p.getVert i
    simp [finSumFinEquiv_symm_apply_castAdd]
  · change ((Sum.elim (fun i : Fin (p.length + 1) => p.getVert i) e4) ∘
        finSumFinEquiv.symm) (Fin.natAdd (p.length + 1) (0 : Fin 4)) = a₁
    simp [finSumFinEquiv_symm_apply_natAdd, e4]
  · change ((Sum.elim (fun i : Fin (p.length + 1) => p.getVert i) e4) ∘
        finSumFinEquiv.symm) (Fin.natAdd (p.length + 1) (1 : Fin 4)) = a₂
    simp [finSumFinEquiv_symm_apply_natAdd, e4]
  · change ((Sum.elim (fun i : Fin (p.length + 1) => p.getVert i) e4) ∘
        finSumFinEquiv.symm) (Fin.natAdd (p.length + 1) (2 : Fin 4)) = b₁
    simp [finSumFinEquiv_symm_apply_natAdd, e4]
  · change ((Sum.elim (fun i : Fin (p.length + 1) => p.getVert i) e4) ∘
        finSumFinEquiv.symm) (Fin.natAdd (p.length + 1) (3 : Fin 4)) = b₂
    simp [finSumFinEquiv_symm_apply_natAdd, e4]

/-- Positive definiteness of a diagonally scaled matrix passes to any
principal submatrix, with the diagonal scale restricted along the same
embedding. -/
public lemma diagonal_mul_submatrix_posDef
    {κ ι : Type*} [Fintype κ] [Fintype ι]
    [DecidableEq κ] [DecidableEq ι]
    (A : Matrix κ κ ℤ) (d : κ → ℤ) (e : ι ↪ κ)
    (hpos : (Matrix.diagonal d * A).PosDef) :
    (Matrix.diagonal (d ∘ e) * A.submatrix e e).PosDef := by
  have heq : Matrix.diagonal (d ∘ e) * A.submatrix e e =
      (Matrix.diagonal d * A).submatrix e e := by
    ext i j
    simp [Matrix.diagonal_mul]
  rw [heq]
  exact hpos.submatrix e.injective

/-- Conjugating a root-pairing reflection by another reflection gives the
reflection in the reflected root. -/
public lemma _root_.RootPairing.Equiv.reflection_reflectionPerm
    {ι R M N : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) (i j : ι) :
    RootPairing.Equiv.reflection P (P.reflectionPerm j i) =
      RootPairing.Equiv.reflection P j *
        RootPairing.Equiv.reflection P i *
          RootPairing.Equiv.reflection P j := by
  have hweight : P.reflection (P.reflectionPerm j i) =
      P.reflection j * P.reflection i * P.reflection j :=
    P.reflection_reflectionPerm
  apply RootPairing.Equiv.ext
  · exact congrArg LinearEquiv.toLinearMap hweight
  · exact congrArg LinearEquiv.toLinearMap
      (P.flip.reflection_reflectionPerm (i := i) (j := j))
  · ext l
    change P.reflectionPerm (P.reflectionPerm j i) l =
      P.reflectionPerm j (P.reflectionPerm i (P.reflectionPerm j l))
    apply P.root.injective
    have hl := LinearEquiv.congr_fun hweight (P.root l)
    simpa only [P.root_reflectionPerm, LinearEquiv.mul_apply] using hl

/-- A finite partition into five pairwise disjoint Finsets yields an explicit
`Fin` numbering of the ambient vertex type.  The hypotheses are ordinary
partition facts; no Dynkin or classification conclusion is stored in data. -/
public lemma fin_numbering_of_finset_partition
    {V : Type*} [Fintype V] [DecidableEq V]
    (S : Fin 5 → Finset V)
    (hdisj : ∀ ⦃i j : Fin 5⦄, i ≠ j → Disjoint (S i) (S j))
    (hcover : ∀ v : V, ∃ i : Fin 5, v ∈ S i) :
    ∃ n : ℕ, ∃ _e : Fin n ≃ V, n = ∑ i : Fin 5, (S i).card := by
  classical
  let (i : Fin 5) : Fintype {v : V // v ∈ S i} :=
    Fintype.ofFinset (S i) (by intro x; rfl)
  let U := Σ i : Fin 5, {v : V // v ∈ S i}
  let f : U → V := fun z => z.2.1
  have hsurj : Function.Surjective f := by
    intro v
    obtain ⟨i, hi⟩ := hcover v
    exact ⟨⟨i, ⟨v, hi⟩⟩, rfl⟩
  have hinj : Function.Injective f := by
    intro a b hab
    rcases a with ⟨i, vi⟩
    rcases b with ⟨j, vj⟩
    dsimp [f] at hab
    by_cases hij : i = j
    · subst j
      have hv : vi.val = vj.val := hab
      exact Sigma.ext rfl (heq_of_eq (Subtype.ext hv))
    · exfalso
      have hmemi : vi.val ∈ S i := vi.property
      have hmemj : vj.val ∈ S j := vj.property
      exact (Finset.disjoint_left.1 (hdisj hij)) hmemi (by simpa only [hab] using hmemj)
  let eU : U ≃ V := Equiv.ofBijective f ⟨hinj, hsurj⟩
  let eFin : Fin (Fintype.card U) ≃ U := (Fintype.equivFin U).symm
  refine ⟨Fintype.card U, eFin.trans eU, ?_⟩
  rw [Fintype.card_sigma]
  simp

/-- A finite sum supported on four pairwise-distinct indices is the sum of
its four displayed values. -/
public lemma fin_sum_support_four {n : ℕ} [DecidableEq (Fin n)]
    (f : Fin n → ℤ) (a b c d : Fin n)
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (hz : ∀ j, j ≠ a → j ≠ b → j ≠ c → j ≠ d → f j = 0) :
    (∑ j : Fin n, f j) = f a + f b + f c + f d := by
  classical
  have hsum : (∑ j : Fin n, f j) =
      ∑ j ∈ ({a, b, c, d} : Finset (Fin n)), f j := by
    symm
    apply Finset.sum_subset (by simp)
    intro j hj hjS
    have hja : j ≠ a := by intro h; subst j; simp at hjS
    have hjb : j ≠ b := by intro h; subst j; simp at hjS
    have hjc : j ≠ c := by intro h; subst j; simp at hjS
    have hjd : j ≠ d := by intro h; subst j; simp at hjS
    exact hz j hja hjb hjc hjd
  rw [hsum]
  simp [Finset.sum_insert, hab, hac, had, hbc, hbd, hcd]
  ring

/-- A finite sum whose support is contained in three distinct coordinates is
the explicit sum of those three values. -/
public lemma fin_sum_support_three {n : ℕ} [DecidableEq (Fin n)]
    (f : Fin n → ℤ) (a b c : Fin n)
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c)
    (hz : ∀ j, j ≠ a → j ≠ b → j ≠ c → f j = 0) :
    (∑ j : Fin n, f j) = f a + f b + f c := by
  have hsum : (∑ j : Fin n, f j) =
      ∑ j ∈ ({a, b, c} : Finset (Fin n)), f j := by
    symm
    apply Finset.sum_subset (by simp)
    intro j hj hjS
    have hja : j ≠ a := by
      intro h
      subst j
      simp at hjS
    have hjb : j ≠ b := by
      intro h
      subst j
      simp at hjS
    have hjc : j ≠ c := by
      intro h
      subst j
      simp at hjS
    exact hz j hja hjb hjc
  rw [hsum]
  simp [Finset.sum_insert, hab, hac, hbc]
  ring

/-- A finite sum whose support is contained in two distinct coordinates is the
explicit sum of those two values. -/
public lemma fin_sum_support_two {n : ℕ} [DecidableEq (Fin n)]
    (f : Fin n → ℤ) (a b : Fin n) (hab : a ≠ b)
    (hz : ∀ j, j ≠ a → j ≠ b → f j = 0) :
    (∑ j : Fin n, f j) = f a + f b := by
  have hsum : (∑ j : Fin n, f j) =
      ∑ j ∈ ({a, b} : Finset (Fin n)), f j := by
    symm
    apply Finset.sum_subset (by simp)
    intro j hj hjS
    have hja : j ≠ a := by
      intro h
      subst j
      simp at hjS
    have hjb : j ≠ b := by
      intro h
      subst j
      simp at hjS
    exact hz j hja hjb
  rw [hsum, Finset.sum_pair hab]

/-- Once the three affine fork patterns are ruled out, a sorted positive triple
of arm lengths is one of the `D`, `E₆`, `E₇`, or `E₈` length patterns.  The
forbidden-pattern hypotheses are explicit arithmetic premises; no
classification conclusion is stored in a definition or structure. -/
public lemma nat_three_arm_lengths_of_affine_forbidden
    (a b c : ℕ)
    (ha : 1 ≤ a) (hab : a ≤ b) (hbc : b ≤ c)
    (hE6 : ¬ (2 ≤ a ∧ 2 ≤ b ∧ 2 ≤ c))
    (hE7 : ¬ (1 ≤ a ∧ 3 ≤ b ∧ 3 ≤ c))
    (hE8 : ¬ (1 ≤ a ∧ 2 ≤ b ∧ 5 ≤ c)) :
    (a = 1 ∧ b = 1) ∨
      (a = 1 ∧ b = 2 ∧ c = 2) ∨
      (a = 1 ∧ b = 2 ∧ c = 3) ∨
      (a = 1 ∧ b = 2 ∧ c = 4) := by
  omega

