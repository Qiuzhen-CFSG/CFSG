/-- A positive-definite diagonal symmetrization cannot contain a simply-laced
cycle of length at least three as a principal Cartan submatrix. -/
public lemma not_cartan_cycleGraph_of_diagonal_mul_posDef
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (n : ℕ) (A : Matrix κ κ ℤ) (d : κ → ℤ)
    (hpos : (Matrix.diagonal d * A).PosDef)
    (e : Fin (n + 3) ↪ κ)
    (hA : ∀ i j, A (e i) (e j) = (cycleGraph (n + 3)).lapMatrix ℤ i j) : False := by
  have hsub := hpos.submatrix e.injective
  let x : Fin (n + 3) → ℤ := fun _ => 1
  have hx : x ≠ 0 := by
    intro h
    have h0 := congrFun h 0
    simp [x] at h0
  have hmul : ((Matrix.diagonal d * A).submatrix e e).mulVec x = 0 := by
    ext i
    simp only [Matrix.mulVec, dotProduct, Matrix.submatrix_apply,
      Matrix.diagonal_mul, x, mul_one, Pi.zero_apply]
    rw [← Finset.mul_sum]
    simp_rw [hA]
    have hz := congrFun
      (SimpleGraph.lapMatrix_mulVec_const_eq_zero (R := ℤ) (cycleGraph (n + 3))) i
    have hsum : ∑ j, (cycleGraph (n + 3)).lapMatrix ℤ i j = 0 := by
      simpa [Matrix.mulVec, dotProduct] using hz
    rw [hsum, mul_zero]
  have hquad := hsub.dotProduct_mulVec_pos hx
  rw [hmul] at hquad
  simp at hquad

/-- A positive-definite diagonal symmetrization cannot contain a center with
four pairwise nonadjacent leaves whose opposite Cartan-entry products are
positive. -/
public lemma not_cartan_fourStar_of_diagonal_mul_posDef
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (A : Matrix κ κ ℤ) (d : κ → ℤ)
    (hdiag : ∀ i, A i i = 2)
    (hpos : (Matrix.diagonal d * A).PosDef)
    (c : κ) (l : Fin 4 → κ)
    (he : Function.Injective ![c, l 0, l 1, l 2, l 3])
    (hleaf : ∀ ⦃a b : Fin 4⦄, a ≠ b → A (l a) (l b) = 0)
    (hedge : ∀ a, 1 ≤ A c (l a) * A (l a) c) : False := by
  let e : Fin 5 → κ := ![c, l 0, l 1, l 2, l 3]
  change Function.Injective e at he
  have hsub := hpos.submatrix he
  let x : Fin 5 → ℤ := ![2, -A (l 0) c, -A (l 1) c, -A (l 2) c, -A (l 3) c]
  have hx : x ≠ 0 := by
    intro h
    have h0 := congrFun h 0
    simp [x] at h0
  have hdc : 0 < d c := by
    have hc := hpos.diag_pos (i := c)
    simp [Matrix.diagonal_mul, hdiag] at hc
    omega
  have hquad := hsub.dotProduct_mulVec_pos hx
  simp [x, e, Matrix.submatrix, Matrix.diagonal_mul, dotProduct, Matrix.mulVec,
    hdiag, hleaf, Fin.sum_univ_succ] at hquad
  have hsum : 4 ≤
      A c (l 0) * A (l 0) c + A c (l 1) * A (l 1) c +
        A c (l 2) * A (l 2) c + A c (l 3) * A (l 3) c := by
    have h0 := hedge 0
    have h1 := hedge 1
    have h2 := hedge 2
    have h3 := hedge 3
    omega
  nlinarith

/-- A four-vertex Cartan path with heavy bonds at both ends of the path cannot
be positive definite when the middle bond is simple.  This is the local
obstruction for two separated heavy bonds at distance one in the path branch.
The edge-pattern assumptions are explicit matrix hypotheses, not a
classification-bearing structure. -/
public lemma not_cartan_path_two_heavy_edges_distance_two_of_diagonal_mul_posDef
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (A : Matrix κ κ ℤ) (d : κ → ℤ)
    (hpos : (Matrix.diagonal d * A).PosDef)
    (e : Fin 4 ↪ κ) (u v s t : ℤ)
    (hA : ∀ i j, A (e i) (e j) =
      if i = j then 2 else if
        (i = 0 ∧ j = 1) then u else if
        (i = 1 ∧ j = 0) then v else if
        (i = 1 ∧ j = 2) then -1 else if
        (i = 2 ∧ j = 1) then -1 else if
        (i = 2 ∧ j = 3) then s else if
        (i = 3 ∧ j = 2) then t else 0)
    (huv : 2 ≤ u * v) (hst : 2 ≤ s * t) : False := by
  have hsub := hpos.submatrix e.injective
  let x : Fin 4 → ℤ := ![s, -v * s, -v * s, v]
  have hx : x ≠ 0 := by
    intro h
    have h0 := congrFun h 0
    simp [x] at h0
    subst s
    norm_num at hst
  have hquad := hsub.dotProduct_mulVec_pos hx
  simp [x, Matrix.submatrix, Matrix.diagonal_mul, dotProduct, Matrix.mulVec,
    hA, Fin.sum_univ_succ] at hquad
  ring_nf at hquad
  have hd0 : 0 < d (e 0) := by
    have h := hpos.diag_pos (i := e 0)
    have hdiag0 : A (e 0) (e 0) = 2 := by
      simpa using hA 0 0
    simp [Matrix.diagonal_mul, hdiag0] at h
    omega
  have hd3 : 0 < d (e 3) := by
    have h := hpos.diag_pos (i := e 3)
    have hdiag3 : A (e 3) (e 3) = 2 := by
      simpa using hA 3 3
    simp [Matrix.diagonal_mul, hdiag3] at h
    omega
  have hs2 : 0 ≤ s ^ 2 := sq_nonneg s
  have hv2 : 0 ≤ v ^ 2 := sq_nonneg v
  have hq1 : 2 - u * v ≤ 0 := by omega
  have hq3 : 2 - s * t ≤ 0 := by omega
  have hterm0 : d (e 0) * s ^ 2 * (2 - u * v) ≤ 0 := by
    exact mul_nonpos_of_nonneg_of_nonpos
      (mul_nonneg (le_of_lt hd0) hs2) hq1
  have hterm3 : d (e 3) * v ^ 2 * (2 - s * t) ≤ 0 := by
    exact mul_nonpos_of_nonneg_of_nonpos
      (mul_nonneg (le_of_lt hd3) hv2) hq3
  nlinarith

