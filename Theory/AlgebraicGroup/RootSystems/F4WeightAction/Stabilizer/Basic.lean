module

public import Theory.AlgebraicGroup.RootSystems.F4WeightAction
public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.Tactic.LinearCombination

/-!
# Evaluation kernels in the actual F4 Weyl group

Conjugation transports the subgroup generated by vanishing-root reflections.
In characteristic two, doubled displacement forces a root to vanish. Cubic
torsion has four line cases, retained for the determinant-nine F4 elements.
These lemmas use the full integral action and field units, with no torus or
centralizer classification premise.
-/

open Theory.AlgebraicGroup.StandardRootSystem
namespace Theory.AlgebraicGroup.StandardRootSystem.F4WeightAction.Stabilizer
public noncomputable section

theorem reflection_mul (g : Weyl) (r : typeF4Roots) :
    g * RootPairing.weylGroup.ofIdx typeF4RootPairing r =
      RootPairing.weylGroup.ofIdx typeF4RootPairing (typeF4RootPairing.weylGroupToPerm g r) * g := by
  apply Subtype.ext
  apply RootPairing.Equiv.weightHom_injective typeF4RootPairing
  apply LinearEquiv.ext
  intro x
  change g.val.weightMap (typeF4RootPairing.reflection r x) =
    typeF4RootPairing.reflection (g.val.indexEquiv r) (g.val.weightMap x)
  have hp := RootPairing.Hom.weight_coweight_transpose_apply typeF4RootPairing typeF4RootPairing
    (typeF4RootPairing.coroot (g.val.indexEquiv r)) g.val.toHom
  rw [RootPairing.Hom.coroot_coweightMap_apply, g.val.indexEquiv.symm_apply_apply] at hp
  have hpx := congrArg (fun f : Module.Dual ℝ (Vec 4) => f x) hp
  change typeF4RootPairing.toLinearMap (g.val.weightMap x) (typeF4RootPairing.coroot (g.val.indexEquiv r)) =
    typeF4RootPairing.toLinearMap x (typeF4RootPairing.coroot r) at hpx
  change (typeF4RootPairing.coroot' (g.val.indexEquiv r)) (g.val.weightMap x) = (typeF4RootPairing.coroot' r) x at hpx
  simp only [RootPairing.reflection_apply, map_sub, map_smul, hpx]
  rw [RootPairing.Hom.root_weightMap_apply]

theorem reflection_conj (g : Weyl) (r : typeF4Roots) :
    g * RootPairing.weylGroup.ofIdx typeF4RootPairing r * g⁻¹ =
      RootPairing.weylGroup.ofIdx typeF4RootPairing (typeF4RootPairing.weylGroupToPerm g r) := by
  rw [reflection_mul]
  group

private theorem additive_units_two {F : Type*} [Field F] [CharP F 2]
    (u : Additive Fˣ) (h : u + u = 0) : u = 0 := by
  have he := congrArg (fun z : Additive Fˣ => (z.toMul : F)) h
  change (u.toMul : F) * u.toMul = 1 at he
  change u.toMul = 1
  apply Units.ext
  apply CharTwo.sq_injective
  simpa only [pow_two, Units.val_one, one_mul] using he

theorem ev_displacement {F : Type*} [Field F]
    (ev : Weight →+ Additive Fˣ) (w : Weyl)
    (hw : ∀a, ev (representation w a) = ev a) (a : Weight) :
    ev (representation w a - a) = 0 := by rw [map_sub, hw, sub_self]

theorem doubled_root_zero {F : Type*} [Field F] [CharP F 2]
    (ev : Weight →+ Additive Fˣ) (w : Weyl)
    (hw : ∀a, ev (representation w a) = ev a)
    (r : typeF4Roots) (a : Weight)
    (ha : representation w a - a = (2:ℤ) • rootWeight r) : ev (rootWeight r) = 0 := by
  have h := ev_displacement ev w hw a
  rw [ha, two_zsmul, map_add] at h
  exact additive_units_two _ h

@[expose] def reflectionKernel {F : Type*} [Field F] (ev : Weight →+ Additive Fˣ) : Subgroup Weyl :=
  Subgroup.closure ((fun r : typeF4Roots => RootPairing.weylGroup.ofIdx typeF4RootPairing r) ''
    {r | ev (rootWeight r) = 0})

theorem conjugate_mem_kernel {F : Type*} [Field F]
    (ev : Weight →+ Additive Fˣ) (g w : Weyl)
    (hw : w ∈ reflectionKernel (ev.comp (representation g).toAddMonoidHom)) :
    g * w * g⁻¹ ∈ reflectionKernel ev := by
  have hle : reflectionKernel (ev.comp (representation g).toAddMonoidHom) ≤
      (reflectionKernel ev).comap (MulAut.conj g).toMonoidHom := by
    apply (Subgroup.closure_le _).2
    rintro _ ⟨r,hr,rfl⟩
    change g * RootPairing.weylGroup.ofIdx typeF4RootPairing r * g⁻¹ ∈ reflectionKernel ev
    rw [reflection_conj]
    apply Subgroup.subset_closure
    refine ⟨typeF4RootPairing.weylGroupToPerm g r, ?_, rfl⟩
    change ev (rootWeight (typeF4RootPairing.weylGroupToPerm g r)) = 0
    change ev (representation g (rootWeight r)) = 0 at hr
    simpa only [representation_root] using hr
  exact hle hw

private theorem cube_root_cases {F : Type*} [Field F] (a b : F)
    (ha : a ^ 3 = 1) (hb : b ^ 3 = 1) :
    a = 1 ∨ b = 1 ∨ b = a ∨ b = a ^ 2 := by
  by_cases ha1 : a = 1
  · exact Or.inl ha1
  right
  have hq : a ^ 2 + a + 1 = 0 := by
    have hp : (a - 1) * (a ^ 2 + a + 1) = 0 := by
      linear_combination ha
    exact (mul_eq_zero.mp hp).resolve_left (sub_ne_zero.mpr ha1)
  have hp : (b - 1) * (b - a) * (b - a ^ 2) = 0 := by
    linear_combination hb + (b - 1) * ha - (b ^ 2 - b) * hq
  rcases mul_eq_zero.mp hp with h | h
  · rcases mul_eq_zero.mp h with h | h
    · exact Or.inl (sub_eq_zero.mp h)
    · exact Or.inr (Or.inl (sub_eq_zero.mp h))
  · exact Or.inr (Or.inr (sub_eq_zero.mp h))

theorem additive_cube_cases {F : Type*} [Field F]
    (u v : Additive Fˣ) (hu : (3:ℤ) • u = 0) (hv : (3:ℤ) • v = 0) :
    u = 0 ∨ v = 0 ∨ v - u = 0 ∨ v - (2:ℤ) • u = 0 := by
  have hu' : u + u + u = 0 := by
    simpa only [show (3:ℤ) = 2 + 1 from rfl, add_zsmul, two_zsmul, one_zsmul] using hu
  have hv' : v + v + v = 0 := by
    simpa only [show (3:ℤ) = 2 + 1 from rfl, add_zsmul, two_zsmul, one_zsmul] using hv
  have hp : (u.toMul : F)^3 = 1 := by
    have h := congrArg (fun z : Additive Fˣ => (z.toMul : F)) hu'
    change (u.toMul : F) * u.toMul * u.toMul = 1 at h
    simpa only [pow_succ, pow_zero, one_mul] using h
  have hq : (v.toMul : F)^3 = 1 := by
    have h := congrArg (fun z : Additive Fˣ => (z.toMul : F)) hv'
    change (v.toMul : F) * v.toMul * v.toMul = 1 at h
    simpa only [pow_succ, pow_zero, one_mul] using h
  rcases cube_root_cases (u.toMul : F) v.toMul hp hq with h|h|h|h
  · left
    change u.toMul = 1
    exact Units.ext h
  · exact Or.inr (Or.inl (show v.toMul = 1 from Units.ext h))
  · right; right; left
    apply sub_eq_zero.mpr
    change v.toMul = u.toMul
    exact Units.ext h
  · right; right; right
    apply sub_eq_zero.mpr
    rw [two_zsmul]
    change v.toMul = u.toMul * u.toMul
    apply Units.ext
    simpa only [Units.val_mul, pow_two] using h

end
end Theory.AlgebraicGroup.StandardRootSystem.F4WeightAction.Stabilizer
