module

public import Theory.AlgebraicGroup.RootSystems.AlgebraicGroups.F4ShortRepresentation
public import Theory.AlgebraicGroup.RootSystems.AlgebraicGroups.F4ShortIrreducibility
public import Theory.AlgebraicGroup.Semisimple.FaithfulIrreducible

/-!
# Semisimplicity of the literal F4 carrier in characteristic two

The carrier is the closed matrix group generated by the integral F4 root
curves. Its connectedness and the short-ideal action's rationality, faithfulness
and irreducibility are proved in the imported constructions.

Root generation and characteristic two force every linear representation to
have determinant one. Lie--Kolchin and irreducibility make each radical act
by scalars; determinant one and faithfulness make it finite, and connectedness
then makes it trivial. The terminal theorem supplies the actual short-ideal
irreducibility proof, discharging every premise of the retained reductions.

This proves the characteristic-two F4 case of Steinberg's Theorem 6(a)
(`refs/KGroup/GLS3/Chapter2St1.tex`), with the radical convention of GLS3,
Definition 1.7.1 (`refs/KGroup/GLS3/Chapter1.tex`).
-/


@[expose] public section

open ReeF4.BinaryDegree.ExceptionalTensor
open ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.ExceptionalMorphism
namespace Theory.AlgebraicGroup.F4Chevalley
variable {k : Type*} [Field k] [IsAlgClosed k] [CharP k 2]
  {V : Type*} [AddCommGroup V] [Module k V] [FiniteDimensional k V]

omit [FiniteDimensional k V] in
/-- Every linear action of the characteristic-two F4 carrier has
determinant one: its root generators have square one. -/
theorem representation_det_eq_one (ρ : RationalRepresentation (Carrier (k := k)) V)
    (g : Variety.Point (Carrier (k := k))) :
    LinearMap.det (ρ.action g : Module.End k V) = 1 := by
  let δ : Variety.Point (Carrier (k := k)) →* k :=
    LinearMap.det.comp ((Units.coeHom (Module.End k V)).comp ρ.action)
  have hle : (⊤ : Subgroup (Variety.Point (Carrier (k := k)))) ≤ δ.ker := by
    rw [← algebraicRootElements_generate]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨r, t⟩, rfl⟩
    change δ (algebraicRootElement r t) = 1
    have he : algebraicRootElement r t * algebraicRootElement r t = 1 := by
      apply pointMatrix_injective
      rw [map_mul, pointMatrix_root, ← rootCurve_add, CharTwo.add_self_eq_zero,
        rootCurve_zero, map_one]
    have hd := congrArg δ he
    rw [map_mul, map_one] at hd
    rcases mul_self_eq_one_iff.mp hd with h | h
    · exact h
    · simpa only [CharTwo.neg_eq] using h
  exact hle (Subgroup.mem_top g)

/-- A faithful irreducible rational representation proves semisimplicity
of the literal F4 carrier; connectedness and determinant one are automatic. -/
theorem carrier_isSemisimple_of_faithful_irreducible [Nontrivial V]
    (ρ : RationalRepresentation (Carrier (k := k)) V)
    (hfaithful : Function.Injective ρ.action)
    (hirr : IsIrreducibleRepresentation ρ) :
    IsSemisimpleAlgebraicGroup (Carrier (k := k)) :=
  isSemisimple_of_faithful_irreducible_det_one ρ hfaithful hirr
    carrier_isConnected (representation_det_eq_one ρ)

/-- Irreducibility of the constructed short-ideal action suffices for
semisimplicity; its other properties are proved. -/
theorem carrier_isSemisimple_of_short_irreducible
    (hirr : IsAlgebraicallyIrreducibleRepresentation (shortRepresentation (k := k))) :
    IsSemisimpleAlgebraicGroup (Carrier (k := k)) :=
  carrier_isSemisimple_of_faithful_irreducible shortRepresentation
    shortRepresentation_faithful ⟨shortRepresentation_isRational, hirr⟩

/-- The literal F4 Chevalley carrier over an algebraically closed field of
characteristic two is connected and every radical subgroup is trivial. -/
theorem carrier_isSemisimple :
    IsSemisimpleAlgebraicGroup (Carrier (k := k)) :=
  carrier_isSemisimple_of_short_irreducible
    shortRepresentation_isAlgebraicallyIrreducible

end Theory.AlgebraicGroup.F4Chevalley
