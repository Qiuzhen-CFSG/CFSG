module

public import Theory.AlgebraicGroup.RootData.Chevalley
public import Theory.AlgebraicGroup.RootSubgroups.Generation
public import Theory.AlgebraicGroup.RootSubgroups.InvariantUnipotentOneParameterLayer
public import Theory.GroupTheory.FilteredCollection

/-!
This module converts generated-layer certificates for a torus-invariant
unipotent subgroup into the explicit collection data used in GLS3,
Theorem 1.9.5(i).  A Chevalley system turns membership in a subgroup generated
by selected root subgroups into an actual finite root-element word: generators
use the range of `C.x`, multiplication concatenates words, and inversion
reverses a word while negating its parameters.

For two contained roots, the extra layer certificate places their commutator
in the subgroup generated by contained roots of strictly larger degree.  The
same conversion therefore gives a supported correction word, and the group
commutator identity gives the adjacent exchange formula.  Thus the public
result concludes with a degree bound, exchange words, and source words; it
does not replace any of these pointwise conclusions by
`RootSubgroupGenerated`.  A second theorem obtains the global generation
certificate from the existing multiplicity-one generation theorem.  The
remaining geometric work is therefore precisely root-weight multiplicity one,
one-parameter layer extraction, and the strict higher commutator layer.
-/

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

private theorem chevalley_source_word_of_mem_rootSubgroupGenerated
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {ι R M N : Type*} [Fintype ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (b : P.Base)
    (hC : IsChevalleySystem D C P e b) (A : Set D.Root)
    (z : Variety.Point K) (hz : z ∈ RootSubgroupGenerated D A) :
    ∃ word : List (D.Root × k),
      (∀ q ∈ word, q.1 ∈ A) ∧
      FilteredCollection.wordProduct (fun α t => C.x α t) word = z := by
  classical
  have hrootNeg (α : D.Root) (a : k) : C.x α (-a) = (C.x α a)⁻¹ := by
    have hzero : C.x α 0 = 1 := by
      simpa using hC.2.2.2.1 α 0 0
    have hmul : C.x α a * C.x α (-a) = 1 := by
      rw [hC.2.2.2.1]
      simpa using hzero
    exact eq_inv_of_mul_eq_one_right hmul
  have hwordInv : ∀ word : List (D.Root × k),
      (FilteredCollection.wordProduct (fun α t => C.x α t) word)⁻¹ =
        FilteredCollection.wordProduct (fun α t => C.x α t)
          (word.reverse.map fun q => (q.1, -q.2)) := by
    intro word
    induction word with
    | nil => simp [FilteredCollection.wordProduct]
    | cons q tail ih =>
        simp only [FilteredCollection.wordProduct] at ih
        simp only [FilteredCollection.wordProduct, List.map_cons, List.prod_cons,
          List.reverse_cons, List.map_append, List.map_map, List.prod_append,
          mul_inv_rev]
        rw [ih, hrootNeg]
        simp [Function.comp_def]
  rw [RootSubgroupGenerated] at hz
  refine Subgroup.closure_induction
    (p := fun z _ => ∃ word : List (D.Root × k),
      (∀ q ∈ word, q.1 ∈ A) ∧
      FilteredCollection.wordProduct (fun α t => C.x α t) word = z)
    (k := ⋃ α ∈ A, (D.rootSubgroup α : Set (Variety.Point K)))
    ?_ ?_ ?_ ?_ hz
  · intro x hx
    simp only [Set.mem_iUnion] at hx
    rcases hx with ⟨α, hα, hxα⟩
    have hxRange : x ∈ Set.range (C.x α) := by
      rw [(hC.1 α).2]
      exact hxα
    rcases hxRange with ⟨t, rfl⟩
    exact ⟨[(α, t)], by simp [hα], by simp [FilteredCollection.wordProduct]⟩
  · exact ⟨[], by simp, by simp [FilteredCollection.wordProduct]⟩
  · intro x y hx hy
    rintro ⟨wordX, hwordX, rfl⟩ ⟨wordY, hwordY, rfl⟩
    refine ⟨wordX ++ wordY, ?_, ?_⟩
    · intro q hq
      rcases List.mem_append.mp hq with hq | hq
      · exact hwordX q hq
      · exact hwordY q hq
    · simp [FilteredCollection.wordProduct]
  · intro x hx
    rintro ⟨word, hword, rfl⟩
    refine ⟨word.reverse.map fun q => (q.1, -q.2), ?_, (hwordInv word).symm⟩
    intro q hq
    rw [List.mem_map] at hq
    rcases hq with ⟨r, hr, rfl⟩
    exact hword r (List.mem_reverse.mp hr)

/-- Convert invariant-unipotent generation and higher-commutator-layer
certificates into the explicit data required by the filtered collector. -/
public theorem invariant_unipotent_source_word_and_exchange_of_generated_layers
    {K : Variety k} [AlgebraicGroup K] {T X : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {ι R M N : Type*} [Fintype ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (b : P.Base)
    (hAdd : IsRootAdditionRealization D P e)
    (hC : IsChevalleySystem D C P e b)
    (roots : List D.Root)
    (hroots : ∀ α, α ∈ roots ↔ D.rootSubgroup α ≤ X)
    (hgenerated : X.toSubgroup = RootSubgroupGenerated D
      {α | D.rootSubgroup α ≤ X})
    (degree : D.Root → ℕ) (degreeBound : ℕ)
    (hdegreeBound : ∀ α ∈ roots, degree α < degreeBound)
    (hcommutatorLayer : IsRootAdditionRealization D P e →
      ∀ α β a c, α ∈ roots → β ∈ roots → α ≠ β →
        (C.x α a)⁻¹ * (C.x β c)⁻¹ * C.x α a * C.x β c ∈
          RootSubgroupGenerated D
            {γ | D.rootSubgroup γ ≤ X ∧
              max (degree α) (degree β) < degree γ}) :
    (∀ α ∈ roots, degree α < degreeBound) ∧
    (∀ α β a c, α ∈ roots → β ∈ roots → α ≠ β →
      ∃ correction : List (D.Root × k),
        (∀ z ∈ correction,
          z.1 ∈ roots ∧
            max (degree α) (degree β) < degree z.1) ∧
        C.x α a * C.x β c =
          C.x β c * C.x α a *
            FilteredCollection.wordProduct
              (fun γ t => C.x γ t) correction) ∧
    ∀ x : Variety.Point K, x ∈ X →
      ∃ word : List (D.Root × k),
        (∀ z ∈ word, z.1 ∈ roots) ∧
        FilteredCollection.wordProduct
          (fun γ t => C.x γ t) word = x := by
  classical
  refine ⟨hdegreeBound, ?_, ?_⟩
  · intro α β a c hα hβ hαβ
    obtain ⟨correction, hcorrection, hproduct⟩ :=
      chevalley_source_word_of_mem_rootSubgroupGenerated
        D C P e b hC
          {γ | D.rootSubgroup γ ≤ X ∧
            max (degree α) (degree β) < degree γ}
          ((C.x α a)⁻¹ * (C.x β c)⁻¹ * C.x α a * C.x β c)
          (hcommutatorLayer hAdd α β a c hα hβ hαβ)
    refine ⟨correction, ?_, ?_⟩
    · intro z hz
      have hz' := hcorrection z hz
      exact ⟨(hroots z.1).mpr hz'.1, hz'.2⟩
    · rw [hproduct]
      group
  · intro x hx
    have hxGenerated : x ∈ RootSubgroupGenerated D
        {α | D.rootSubgroup α ≤ X} := by
      rw [← hgenerated]
      exact hx
    obtain ⟨word, hword, hproduct⟩ :=
      chevalley_source_word_of_mem_rootSubgroupGenerated
        D C P e b hC {α | D.rootSubgroup α ≤ X} x hxGenerated
    exact ⟨word, fun z hz => (hroots z.1).mpr (hword z hz), hproduct⟩

/-- Use multiplicity-one root generation to discharge the global generated
subgroup certificate in the source-word and exchange bridge. -/
public theorem invariant_unipotent_source_word_and_exchange_of_layers
    [IsAlgClosed k] {K : Variety k} [AlgebraicGroup K]
    (hK : IsReductiveAlgebraicGroup K)
    (T X : ClosedSubgroup K) (hT : IsMaximalTorus T)
    (hX : IsClosedSubgroupInvariant T X)
    (hXu : IsUnipotentAlgebraicGroup X.carrierVariety)
    (D : RootGroupData K T) (hD : D.IsRealization)
    {ι R M N : Type*} [Fintype ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (b : P.Base)
    (C : ChevalleyData K D)
    (hAdd : IsRootAdditionRealization D P e)
    (hC : IsChevalleySystem D C P e b)
    (roots : List D.Root)
    (hroots : ∀ α, α ∈ roots ↔ D.rootSubgroup α ≤ X)
    (hLayer : HasInvariantOneParameterLayerOutsideGeneratedRoots T X D)
    (hmult : ∀ α : D.Root,
      RootWeightSpaceMultiplicityOne T (D.rootWeight α))
    (degree : D.Root → ℕ) (degreeBound : ℕ)
    (hdegreeBound : ∀ α ∈ roots, degree α < degreeBound)
    (hcommutatorLayer : IsRootAdditionRealization D P e →
      ∀ α β a c, α ∈ roots → β ∈ roots → α ≠ β →
        (C.x α a)⁻¹ * (C.x β c)⁻¹ * C.x α a * C.x β c ∈
          RootSubgroupGenerated D
            {γ | D.rootSubgroup γ ≤ X ∧
              max (degree α) (degree β) < degree γ}) :
    (∀ α ∈ roots, degree α < degreeBound) ∧
    (∀ α β a c, α ∈ roots → β ∈ roots → α ≠ β →
      ∃ correction : List (D.Root × k),
        (∀ z ∈ correction,
          z.1 ∈ roots ∧
            max (degree α) (degree β) < degree z.1) ∧
        C.x α a * C.x β c =
          C.x β c * C.x α a *
            FilteredCollection.wordProduct
              (fun γ t => C.x γ t) correction) ∧
    ∀ x : Variety.Point K, x ∈ X →
      ∃ word : List (D.Root × k),
        (∀ z ∈ word, z.1 ∈ roots) ∧
        FilteredCollection.wordProduct
          (fun γ t => C.x γ t) word = x := by
  obtain ⟨A, hA, hgenerated⟩ :=
    invariant_unipotent_generated_by_rootSubgroups_of_multiplicityOne
      T X D hK hT hD hX hXu hLayer hmult
  have hAeq : A = {α | D.rootSubgroup α ≤ X} := by
    ext α
    exact hA α
  rw [hAeq] at hgenerated
  exact invariant_unipotent_source_word_and_exchange_of_generated_layers
    D C P e b hAdd hC roots hroots hgenerated degree degreeBound
      hdegreeBound hcommutatorLayer

end Theory.AlgebraicGroup
