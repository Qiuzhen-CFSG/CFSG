module

public import Theory.AlgebraicGroup.RootData.ChevalleyCommutator

/-!
# Higher commutator layers for invariant unipotent root sets

This module isolates the root-height part of the strict commutator filtration
used in the invariant-unipotent proof of GLS3, Theorem 1.9.5(i). Given a base
for which every contained root is positive, base height is a natural-number
degree on the finite contained-root list, and the sum of those degrees plus one
is a uniform finite bound.

The remaining input is stated as an exact support certificate: the commutator
must lie in the subgroup generated by roots that are both contained in the
unipotent subgroup and valid Chevalley positive combinations of the two input
roots. This is intentionally stronger than the bare Chevalley commutator
formula, which does not imply that its individual formal root factors are
contained in the subgroup, particularly when a structure coefficient vanishes
in the ground field.

For every valid commutator root `i * alpha + j * beta`, compatibility of base
height with root expansion gives height `i * height alpha + j * height beta`.
Both coefficients are positive, so this height is strictly greater than each
input height. Monotonicity of `RootSubgroupGenerated` then converts the exact
support certificate into the strict layer required by the source-word
collector. The root-height calculation is the usual one underlying the
Chevalley collection argument in GLS3, Theorem 1.12.1.
-/

namespace Theory.AlgebraicGroup

universe u

variable {k : Type u} [Field k]

private lemma height_of_validChevalleyCommutatorTerm
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (base : P.Base) {α β : D.Root}
    (q : ChevalleyCommutatorTerm D.Root)
    (hq : IsValidChevalleyCommutatorTerm D P e α β q) :
    base.height (e q.root) =
      (q.i : ℤ) * base.height (e α) +
        (q.j : ℤ) * base.height (e β) := by
  classical
  obtain ⟨f, -, -, hf⟩ := base.exists_root_eq_sum_int (e α)
  obtain ⟨g, -, -, hg⟩ := base.exists_root_eq_sum_int (e β)
  have hf : P.root (e α) = ∑ l ∈ base.support, f l • P.root l := hf
  have hg : P.root (e β) = ∑ l ∈ base.support, g l • P.root l := hg
  have hqexp : P.root (e q.root) =
      ∑ l ∈ base.support,
        ((q.i : ℤ) * f l + (q.j : ℤ) * g l) • P.root l := by
    have hq' : P.root (e q.root) =
        (q.i : ℤ) • P.root (e α) + (q.j : ℤ) • P.root (e β) := by
      have hqNat : P.root (e q.root) =
          q.i • P.root (e α) + q.j • P.root (e β) := by
        simpa only [Nat.cast_smul_eq_nsmul R] using hq.2.2
      rw [← natCast_zsmul (P.root (e α)) q.i,
        ← natCast_zsmul (P.root (e β)) q.j] at hqNat
      exact hqNat
    rw [hq', hf, hg]
    simp_rw [Finset.smul_sum, smul_smul, add_zsmul,
      Finset.sum_add_distrib]
  rw [base.height_eq_sum hqexp, base.height_eq_sum hf,
    base.height_eq_sum hg]
  simp_rw [Finset.sum_add_distrib, Finset.mul_sum]

private lemma degree_strict_of_mem_chevalleyCommutatorRoots
    {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
    (D : RootGroupData K T)
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (base : P.Base) {α β γ : D.Root}
    (hα : base.IsPos (e α)) (hβ : base.IsPos (e β))
    (hγ : γ ∈ ChevalleyCommutatorRoots D P e α β) :
    max (Int.toNat (base.height (e α)))
        (Int.toNat (base.height (e β))) <
      Int.toNat (base.height (e γ)) := by
  obtain ⟨i, j, hiNat, hjNat, hroot⟩ :=
    (mem_chevalleyCommutatorRoots_iff D P e α β γ).mp hγ
  let q : ChevalleyCommutatorTerm D.Root := ⟨i, j, γ⟩
  have hq : IsValidChevalleyCommutatorTerm D P e α β q :=
    ⟨hiNat, hjNat, hroot⟩
  rw [RootPairing.Base.isPos_iff] at hα hβ
  rw [height_of_validChevalleyCommutatorTerm D P e base q hq]
  have hi : (1 : ℤ) ≤ q.i := by exact_mod_cast hiNat
  have hj : (1 : ℤ) ≤ q.j := by exact_mod_cast hjNat
  apply max_lt
  · exact (Int.toNat_lt_toNat (by nlinarith)).mpr (by nlinarith)
  · exact (Int.toNat_lt_toNat (by nlinarith)).mpr (by nlinarith)

/-- Base height turns an exact Chevalley-support certificate into strict
higher commutator layers on a finite positive root list. -/
public theorem higherCommutatorLayers_of_positiveSupport
    {K : Variety k} [AlgebraicGroup K] {T X : ClosedSubgroup K}
    (D : RootGroupData K T) (C : ChevalleyData K D)
    {ι R M N : Type*} [Finite ι] [Field R] [CharZero R]
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (P : RootPairing ι R M N) [P.IsRootSystem]
    [P.IsCrystallographic] [P.IsReduced]
    (e : D.Root ≃ ι) (base : P.Base)
    (roots : List D.Root)
    (hpositive : ∀ α ∈ roots, base.IsPos (e α))
    (hcommutatorSupport : ∀ α β a c,
      α ∈ roots → β ∈ roots → α ≠ β →
      (C.x α a)⁻¹ * (C.x β c)⁻¹ * C.x α a * C.x β c ∈
        RootSubgroupGenerated D
          {γ | D.rootSubgroup γ ≤ X ∧
            γ ∈ ChevalleyCommutatorRoots D P e α β}) :
    ∃ degree : D.Root → ℕ, ∃ degreeBound : ℕ,
      (∀ α ∈ roots, degree α < degreeBound) ∧
      ∀ α β a c, α ∈ roots → β ∈ roots → α ≠ β →
        (C.x α a)⁻¹ * (C.x β c)⁻¹ * C.x α a * C.x β c ∈
          RootSubgroupGenerated D
            {γ | D.rootSubgroup γ ≤ X ∧
              max (degree α) (degree β) < degree γ} := by
  classical
  let degree : D.Root → ℕ :=
    fun α => Int.toNat (base.height (e α))
  let degreeBound := (roots.map degree).sum + 1
  refine ⟨degree, degreeBound, ?_, ?_⟩
  · intro α hα
    have hmem : degree α ∈ roots.map degree := List.mem_map_of_mem hα
    exact (List.le_sum_of_mem hmem).trans_lt (Nat.lt_succ_self _)
  · intro α β a c hα hβ hne
    apply (RootSubgroupGenerated_mono D ?_)
      (hcommutatorSupport α β a c hα hβ hne)
    intro γ hγ
    exact ⟨hγ.1,
      degree_strict_of_mem_chevalleyCommutatorRoots D P e base
        (hpositive α hα) (hpositive β hβ) hγ.2⟩

end Theory.AlgebraicGroup
