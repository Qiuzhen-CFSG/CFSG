module

public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.Morphism.ClosedImage
public import Theory.AlgebraicGroup.RootSystems.AlgebraicGroups.F4IntegralChevalleyRepresentation

/-!
# The closed F4 Chevalley carrier

This module specializes the characteristic-free integral F4 root curves to an
algebraically closed field.  The generic integral root-curve construction gives
regular additive one-parameter morphisms into a finite general linear group and
their closed images.  Since the F4 root set is finite and every image is
connected, the finite connected-generation theorem makes the subgroup generated
by all root images Zariski closed.  Its closed-subgroup carrier therefore
inherits the `Variety` and `AlgebraicGroup` structures used by the subsequent
root-realization modules.

The construction uses only the checked integral representation and the generic
closed-image and finite-generation APIs; it does not invoke an abstract
Chevalley-group existence theorem or any numbered classification result.
-/

open scoped Matrix

universe u

@[expose] public section

namespace Theory.AlgebraicGroup.F4Chevalley

open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- The finite-dimensional general-linear ambient variety for the F4 lattice. -/
public noncomputable abbrev Ambient (k : Type u) [Field k] [IsAlgClosed k] :=
  RootCurveAmbient (P := typeF4RootPairing) (b := typeF4RootPairing_base)
    (ι := Root) (k := k)

/-- The specialized integral root morphism in the ambient general-linear group. -/
public noncomputable abbrev ambientRootMorphism (r : Root) :
    AlgebraicGroup.Morphism (KPlus k) (Ambient k) :=
  rootMorphism (P := typeF4RootPairing) (b := typeF4RootPairing_base) r

/-- The closed image of one F4 root one-parameter subgroup. -/
public noncomputable abbrev ambientRootSubgroup (r : Root) :
    ClosedSubgroup (Ambient k) :=
  rootSubgroup (P := typeF4RootPairing) (b := typeF4RootPairing_base) r

@[simp] public theorem ambientRootMorphism_apply (r : Root)
    (x : Variety.Point (KPlus k)) :
    (ambientRootMorphism (k := k) r).onPoints x =
      generalLinearRepresentationPoint
        (RootPairing.IntegralGeckConstruction.carrierBasis
          (P := typeF4RootPairing) (b := typeF4RootPairing_base))
        (RootPairing.IntegralGeckConstruction.rootPointRepresentation
          (P := typeF4RootPairing) (b := typeF4RootPairing_base) r x) := by
  exact RootPairing.IntegralGeckConstruction.rootMorphism_apply
    (P := typeF4RootPairing) (b := typeF4RootPairing_base) r x

public theorem ambientRootMorphism_injective (r : Root) :
    Function.Injective (ambientRootMorphism (k := k) r).onPoints :=
  RootPairing.IntegralGeckConstruction.rootMorphism_injective
    (P := typeF4RootPairing) (b := typeF4RootPairing_base) r

public theorem ambientRootSubgroup_eq_image (r : Root) :
    ambientRootSubgroup (k := k) r =
      (ambientRootMorphism (k := k) r).imageClosedSubgroup :=
  rfl

public theorem ambientRootSubgroup_isConnected (r : Root) :
    _root_.IsConnected
      (ambientRootSubgroup (k := k) r : Set (Variety.Point (Ambient k))) := by
  exact (ambientRootMorphism (k := k) r).imageClosedSubgroup_isConnected
    kPlus_isConnected

public theorem ambientRootSubgroup_isOneParameter (r : Root) :
    @IsOneParameterGroup k _
      (ambientRootSubgroup (k := k) r).carrierVariety
      (ambientRootSubgroup (k := k) r).carrierAlgebraicGroup := by
  exact rootSubgroup_isOneParameter
    (P := typeF4RootPairing) (b := typeF4RootPairing_base) r

/-- The exact subgroup generated by all specialized F4 root images. -/
public noncomputable def ambientCarrierSubgroup :
    Subgroup (Variety.Point (Ambient k)) :=
  Subgroup.closure
    (⋃ r : Root,
      (ambientRootSubgroup (k := k) r : Set (Variety.Point (Ambient k))))

public theorem ambientCarrierSubgroup_eq_generated :
    ambientCarrierSubgroup (k := k) =
      Subgroup.closure
        (⋃ r : Root,
          (ambientRootSubgroup (k := k) r : Set (Variety.Point (Ambient k)))) :=
  rfl

public theorem ambientCarrier_isZariskiClosed :
    IsZariskiClosed (Ambient k)
      (ambientCarrierSubgroup (k := k) : Set (Variety.Point (Ambient k))) :=
  closure_iUnion_connected_closedSubgroup_isZariskiClosed
    (ambientRootSubgroup (k := k)) ambientRootSubgroup_isConnected

public theorem ambientCarrier_isConnected :
    _root_.IsConnected
      (ambientCarrierSubgroup (k := k) : Set (Variety.Point (Ambient k))) :=
  closure_iUnion_connected_closedSubgroup_isConnected
    (ambientRootSubgroup (k := k)) ambientRootSubgroup_isConnected

/-- The genuine closed algebraic subgroup generated by all F4 root images. -/
public noncomputable def ambientClosedCarrier : ClosedSubgroup (Ambient k) :=
  ClosedSubgroup.ofSubgroup ambientCarrierSubgroup ambientCarrier_isZariskiClosed

public theorem ambientClosedCarrier_toSubgroup_eq :
    (ambientClosedCarrier (k := k)).toSubgroup =
      ambientCarrierSubgroup (k := k) := by
  rfl

/-- The carrier variety of the closed F4 Chevalley subgroup. -/
public noncomputable abbrev Carrier :=
  (ambientClosedCarrier (k := k)).carrierVariety

noncomputable instance : AlgebraicGroup (Carrier (k := k)) :=
  (ambientClosedCarrier (k := k)).carrierAlgebraicGroup

public theorem carrier_isConnected :
    Variety.IsConnected (Carrier (k := k)) := by
  let e := Variety.closedSubvarietyPointHomeomorph
    (ambientClosedCarrier (k := k)).isZariskiClosed
  let : ConnectedSpace
      {x : Variety.Point (Ambient k) //
        x ∈ (ambientClosedCarrier (k := k) : Set (Variety.Point (Ambient k)))} :=
    Subtype.connectedSpace ambientCarrier_isConnected
  let : ConnectedSpace (Variety.Point (Carrier (k := k))) :=
    e.connectedSpace_iff.mpr inferInstance
  exact connectedSpace_iff_univ.mp inferInstance

public theorem ambientRoot_mem_carrier (r : Root)
    (x : Variety.Point (KPlus k)) :
    (ambientRootMorphism (k := k) r).onPoints x ∈
      ambientCarrierSubgroup (k := k) := by
  apply Subgroup.subset_closure
  refine Set.mem_iUnion.mpr ⟨r, ?_⟩
  exact ⟨x, rfl⟩

/-- The root morphism with codomain restricted to the closed carrier. -/
public noncomputable def rootMorphism (r : Root) :
    AlgebraicGroup.Morphism (KPlus k) (Carrier (k := k)) :=
  (ambientRootMorphism (k := k) r).codRestrictClosedSubgroup
    (ambientClosedCarrier (k := k)) (ambientRoot_mem_carrier r)

@[simp] public theorem rootMorphism_inclusion_apply (r : Root)
    (x : Variety.Point (KPlus k)) :
    (ambientClosedCarrier (k := k)).inclusion.onPoints
        ((rootMorphism (k := k) r).onPoints x) =
      (ambientRootMorphism (k := k) r).onPoints x :=
  (ambientRootMorphism (k := k) r).codRestrictClosedSubgroup_inclusion_apply
    (ambientClosedCarrier (k := k)) (ambientRoot_mem_carrier r) x

/-- The closed root subgroup inside the carrier. -/
public noncomputable def rootSubgroup (r : Root) : ClosedSubgroup (Carrier (k := k)) :=
  (rootMorphism (k := k) r).imageClosedSubgroup

public theorem rootSubgroup_isConnected (r : Root) :
    _root_.IsConnected
      (rootSubgroup (k := k) r : Set (Variety.Point (Carrier (k := k)))) := by
  exact (rootMorphism (k := k) r).imageClosedSubgroup_isConnected
    kPlus_isConnected

public theorem rootMorphism_injective (r : Root) :
    Function.Injective (rootMorphism (k := k) r).onPoints := by
  intro x y hxy
  apply ambientRootMorphism_injective (k := k) r
  rw [← rootMorphism_inclusion_apply (k := k) r x,
    ← rootMorphism_inclusion_apply (k := k) r y, hxy]

public theorem rootSubgroup_inclusion_image (r : Root) :
    (ambientClosedCarrier (k := k)).inclusion.onPoints ''
        (rootSubgroup (k := k) r : Set (Variety.Point (Carrier (k := k)))) =
      (ambientRootSubgroup (k := k) r : Set (Variety.Point (Ambient k))) := by
  ext y
  constructor
  · rintro ⟨x, ⟨z, rfl⟩, rfl⟩
    exact ⟨z, rootMorphism_inclusion_apply (k := k) r z⟩
  · rintro ⟨x, rfl⟩
    refine ⟨(rootMorphism (k := k) r).onPoints x, ⟨x, rfl⟩, ?_⟩
    exact rootMorphism_inclusion_apply (k := k) r x

public theorem typeF4_chevalleyCarrier_exists :
    ∃ C : ClosedSubgroup (Ambient k),
      C = ambientClosedCarrier (k := k) ∧
      _root_.IsConnected (C : Set (Variety.Point (Ambient k))) ∧
      (C : Set (Variety.Point (Ambient k))) =
        (Subgroup.closure
          (⋃ r : Root,
            (ambientRootSubgroup (k := k) r :
              Set (Variety.Point (Ambient k)))) :
          Set (Variety.Point (Ambient k))) := by
  refine ⟨ambientClosedCarrier (k := k), rfl, ?_, ?_⟩
  · exact ambientCarrier_isConnected
  · rfl

end Theory.AlgebraicGroup.F4Chevalley
