module

public import Theory.AlgebraicGroup.RootSystems.F4RootPairing

/-!
# The root and weight lattices of the standard F4 pairing

For the canonical real root pairing `typeF4RootPairing`, its integral weight module is the
`ℤ`-dual of the coroot lattice.  Every root restricts to an integral functional on that lattice;
the root lattice below is the additive subgroup generated by those restricted roots, while the
weight lattice is the full dual.

The displayed F4 Cartan matrix has the explicit integral inverse
`!![2, 3, 4, 2; 3, 6, 8, 4; 2, 4, 6, 3; 1, 2, 3, 2]`.  Evaluating an arbitrary weight on the
simple-coroot basis and multiplying by this inverse expresses it as an integral combination of
the four simple roots.  Thus the Cartan matrix is unimodular and the root and weight lattices
coincide.  This is the lattice calculation needed to identify the simply connected and adjoint
F4 root data; it uses no classification of centers or versions.
-/

namespace Theory.AlgebraicGroup.StandardRootSystem

open Matrix Set Submodule

/-- The ambient integral weight module of the canonical F4 root pairing. -/
public abbrev typeF4WeightModule :=
  Module.Dual ℤ (typeF4RootPairing.corootSpan ℤ)

/-- A root of the canonical F4 pairing, restricted to its integral coroot lattice. -/
@[expose] public noncomputable def typeF4RootWeight (r : typeF4Roots) :
    typeF4WeightModule :=
  typeF4RootPairing.root'In ℤ r

/-- The additive lattice generated by the canonical F4 roots inside the weight module. -/
@[expose] public noncomputable def typeF4RootLattice :
    AddSubgroup typeF4WeightModule :=
  AddSubgroup.closure (Set.range typeF4RootWeight)

/-- The full integral weight lattice of the canonical F4 pairing. -/
@[expose] public noncomputable def typeF4WeightLattice :
    AddSubgroup typeF4WeightModule :=
  ⊤

private def typeF4CartanInverseTranspose : Matrix (Fin 4) (Fin 4) ℤ :=
  !![2, 3, 2, 1; 3, 6, 4, 2; 4, 8, 6, 3; 2, 4, 3, 2]

private def typeF4CartanInverse : Matrix (Fin 4) (Fin 4) ℤ :=
  typeF4CartanInverseTranspose.transpose

private lemma typeF4CartanInverse_mul :
    typeF4CartanInverse * typeF4CartanMatrix = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [typeF4CartanInverse, typeF4CartanInverseTranspose, typeF4CartanMatrix,
      Matrix.mul_apply, Fin.sum_univ_succ] <;> simp

/-- For F4 the root lattice equals the full weight lattice.  Equivalently, every integral
functional on the coroot lattice is an integral linear combination of roots. -/
public theorem typeF4_rootLattice_eq_weightLattice :
    typeF4RootLattice = typeF4WeightLattice := by
  rw [typeF4WeightLattice]
  apply top_unique
  intro f _
  let simpleCombination : typeF4WeightModule :=
    ∑ k : Fin 4,
      f (typeF4RootPairing.corootSpanMem ℤ (typeF4RootPairing_baseEquiv k)) •
        ∑ i : Fin 4, typeF4CartanInverse k i •
          typeF4RootWeight (typeF4RootPairing_baseEquiv i)
  have hCombination : simpleCombination = f := by
    apply (typeF4RootPairing_base.flip.toWeightBasisInt).ext
    intro j
    let j' : Fin 4 := typeF4RootPairing_baseEquiv.symm j
    have hj : typeF4RootPairing_baseEquiv j' = j :=
      typeF4RootPairing_baseEquiv.apply_symm_apply j
    have hjBasis : typeF4RootPairing_base.flip.toWeightBasisInt j =
        typeF4RootPairing.corootSpanMem ℤ j := by
      apply Subtype.ext
      simp
    have hcoeff (k : Fin 4) :
        ∑ i : Fin 4, typeF4CartanInverse k i * typeF4CartanMatrix i j' =
          if k = j' then 1 else 0 := by
      have h := congrFun (congrFun typeF4CartanInverse_mul k) j'
      simpa [Matrix.mul_apply, Matrix.one_apply] using h
    rw [hjBasis]
    change (∑ k : Fin 4,
      f (typeF4RootPairing.corootSpanMem ℤ (typeF4RootPairing_baseEquiv k)) *
        ∑ i : Fin 4, typeF4CartanInverse k i *
          typeF4RootPairing.pairingIn ℤ (typeF4RootPairing_baseEquiv i) j) =
      f (typeF4RootPairing.corootSpanMem ℤ j)
    rw [← hj]
    simp_rw [← RootPairing.Base.cartanMatrixIn_def,
      typeF4RootPairing_base_cartan_apply]
    simp_rw [hcoeff]
    simp
  rw [← hCombination]
  apply AddSubgroup.sum_mem
  intro k _
  apply AddSubgroup.zsmul_mem
  apply AddSubgroup.sum_mem
  intro i _
  apply AddSubgroup.zsmul_mem
  exact AddSubgroup.subset_closure ⟨typeF4RootPairing_baseEquiv i, rfl⟩

end Theory.AlgebraicGroup.StandardRootSystem
