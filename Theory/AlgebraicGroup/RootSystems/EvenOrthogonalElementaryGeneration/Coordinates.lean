module

public import Theory.AlgebraicGroup.RootSystems.EvenOrthogonalRootSubgroups
import Mathlib.Tactic

/-!
# Elementary subgroups of the standard hyperbolic form

The subgroup here is the closure of the existing coordinate type-D root
matrices. The coordinate lemmas expose its three elementary matrix families.
In rank four, upper roots first make the initial coordinate nonzero, clear
the other first-summand coordinates, and scale the pivot to one. Lower roots
then clear the last three second-summand coordinates; preservation of the form
fixes the remaining coordinate. Thus the subgroup acts transitively on
norm-one vectors over every field. These are the concrete generators used
in GLS3, Sections 1.10--1.12.
-/

universe u
namespace Theory.AlgebraicGroup
open StandardRootSystem
variable {k : Type u} [Field k]

/-- The subgroup generated by the standard coordinate root matrices. -/
@[expose] public noncomputable def evenOrthogonalElementarySubgroup (n : ℕ) :
    Subgroup (quadraticIsometrySubgroup (hyperbolicForm (k := k) n)) :=
  Subgroup.closure (Set.range fun p : TypeDRootIndex n × k =>
    evenOrthogonalRootQuadraticPoint n p.1 p.2)

namespace EvenOrthogonalElementary

public lemma root_mem (n : ℕ) (r : TypeDRootIndex n) (a : k) :
    evenOrthogonalRootQuadraticPoint n r a ∈ evenOrthogonalElementarySubgroup n :=
  Subgroup.subset_closure ⟨(r, a), rfl⟩

public lemma upper_mem (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : k) :
    hyperbolicUpperRootPoint n i j hij a ∈ evenOrthogonalElementarySubgroup n := by
  rcases lt_or_gt_of_ne hij with h | h
  · simpa [evenOrthogonalRootQuadraticPoint, evenOrthogonalRootIsometry,
      show (-1 : ℝ) ≠ 1 by norm_num, hyperbolicUpperRootPoint] using root_mem n (⟨(i, j), h⟩, ⟨1, by simp⟩, ⟨-1, by simp⟩) a
  · simpa [evenOrthogonalRootQuadraticPoint, evenOrthogonalRootIsometry,
      show (-1 : ℝ) ≠ 1 by norm_num, hyperbolicUpperRootPoint] using root_mem n (⟨(j, i), h⟩, ⟨-1, by simp⟩, ⟨1, by simp⟩) a

public lemma lower_mem (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : k) :
    hyperbolicLowerRootPoint n i j hij a ∈ evenOrthogonalElementarySubgroup n := by
  rcases lt_or_gt_of_ne hij with h | h
  · simpa [evenOrthogonalRootQuadraticPoint, evenOrthogonalRootIsometry,
      show (-1 : ℝ) ≠ 1 by norm_num, hyperbolicLowerRootPoint] using root_mem n (⟨(i, j), h⟩, ⟨-1, by simp⟩, ⟨-1, by simp⟩) a
  · have heq : hyperbolicLowerRootPoint n i j hij a =
        hyperbolicLowerRootPoint n j i hij.symm (-a) := by
      apply Subtype.ext
      apply LinearEquiv.ext
      intro z
      apply Prod.ext
      · rfl
      · funext p
        simp [hyperbolicLowerRootPoint, hyperbolicLowerRoot,
          hyperbolicLowerRootLinearEquiv]
        ring
    rw [heq]
    simpa [evenOrthogonalRootQuadraticPoint, evenOrthogonalRootIsometry,
      show (-1 : ℝ) ≠ 1 by norm_num, hyperbolicLowerRootPoint] using root_mem n (⟨(j, i), h⟩, ⟨-1, by simp⟩, ⟨-1, by simp⟩) (-a)

public lemma skewUpper_mem (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : k) :
    hyperbolicSkewUpperRootPoint n i j hij a ∈ evenOrthogonalElementarySubgroup n := by
  rcases lt_or_gt_of_ne hij with h | h
  · simpa [evenOrthogonalRootQuadraticPoint, evenOrthogonalRootIsometry,
      show (-1 : ℝ) ≠ 1 by norm_num, hyperbolicSkewUpperRootPoint] using root_mem n (⟨(i, j), h⟩, ⟨1, by simp⟩, ⟨1, by simp⟩) a
  · have heq : hyperbolicSkewUpperRootPoint n i j hij a =
        hyperbolicSkewUpperRootPoint n j i hij.symm (-a) := by
      apply Subtype.ext
      apply LinearEquiv.ext
      intro z
      apply Prod.ext
      · funext p
        simp [hyperbolicSkewUpperRootPoint, hyperbolicSkewUpperRoot,
          hyperbolicSkewUpperRootLinearEquiv]
        ring
      · rfl
    rw [heq]
    simpa [evenOrthogonalRootQuadraticPoint, evenOrthogonalRootIsometry,
      show (-1 : ℝ) ≠ 1 by norm_num, hyperbolicSkewUpperRootPoint] using root_mem n (⟨(j, i), h⟩, ⟨1, by simp⟩, ⟨1, by simp⟩) (-a)

/-- Every elementary matrix lies in the actual orthogonal derived subgroup. -/
public lemma le_commutator [IsAlgClosed k] (n : ℕ) :
    evenOrthogonalElementarySubgroup (k := k) n ≤
      commutator (quadraticIsometrySubgroup (hyperbolicForm (k := k) n)) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨⟨r, a⟩, rfl⟩
  obtain ⟨g, h, heq⟩ := evenOrthogonalRootQuadraticPoint_is_commutator n r a
  dsimp only
  rw [heq]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top h)

public lemma upper_apply (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : k)
    (v : HyperbolicSpace k n) :
    (hyperbolicUpperRootPoint n i j hij a).1 v =
      (v.1 + (a * v.1 j) • Pi.single i 1,
       v.2 - (a * v.2 i) • Pi.single j 1) := rfl

public lemma lower_apply (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : k)
    (v : HyperbolicSpace k n) :
    (hyperbolicLowerRootPoint n i j hij a).1 v =
      (v.1, v.2 + (a * v.1 j) • Pi.single i 1 -
       (a * v.1 i) • Pi.single j 1) := rfl

public lemma skewUpper_apply (n : ℕ) (i j : Fin n) (hij : i ≠ j) (a : k)
    (v : HyperbolicSpace k n) :
    (hyperbolicSkewUpperRootPoint n i j hij a).1 v =
      (v.1 + (a * v.2 j) • Pi.single i 1 -
       (a * v.2 i) • Pi.single j 1, v.2) := rfl


@[simp] public lemma point_mul_apply (n : ℕ)
    (g h : quadraticIsometrySubgroup (hyperbolicForm (k := k) n))
    (v : HyperbolicSpace k n) : (g * h).1 v = g.1 (h.1 v) := rfl

private lemma exists_pivot (v : HyperbolicSpace k 4)
    (hv : hyperbolicForm 4 v ≠ 0) :
    ∃ g : quadraticIsometrySubgroup (hyperbolicForm (k := k) 4),
      g ∈ evenOrthogonalElementarySubgroup 4 ∧ (g.1 v).1 0 ≠ 0 := by
  by_cases h : v.1 0 ≠ 0
  · exact ⟨1, one_mem _, h⟩
  · have h0 : v.1 0 = 0 := not_ne_iff.mp h
    obtain ⟨i, hi⟩ : ∃ i, v.1 i ≠ 0 := by
      by_contra hn
      push Not at hn
      apply hv
      simp [hyperbolicForm_apply, hn]
    have hi0 : (0 : Fin 4) ≠ i := by
      rintro rfl
      exact hi h0
    refine ⟨hyperbolicUpperRootPoint 4 0 i hi0 1, upper_mem _ _ _ _ _, ?_⟩
    simpa [upper_apply, h0] using hi

private lemma exists_first_basis (v : HyperbolicSpace k 4) (hv : v.1 0 ≠ 0) :
    ∃ g : quadraticIsometrySubgroup (hyperbolicForm (k := k) 4),
      g ∈ evenOrthogonalElementarySubgroup 4 ∧ (g.1 v).1 = Pi.single 0 1 := by
  let a := v.1 0
  let h := hyperbolicUpperRootPoint 4 1 0 (by decide) (-v.1 1 / a) *
    hyperbolicUpperRootPoint 4 2 0 (by decide) (-v.1 2 / a) *
    hyperbolicUpperRootPoint 4 3 0 (by decide) (-v.1 3 / a)
  have hh : h ∈ evenOrthogonalElementarySubgroup 4 :=
    mul_mem (mul_mem (upper_mem _ _ _ _ _) (upper_mem _ _ _ _ _))
      (upper_mem _ _ _ _ _)
  have hx : (h.1 v).1 = Pi.single 0 a := by
    funext i
    fin_cases i <;>
      simp [h, upper_apply, a] <;> field_simp [hv] <;> ring
  let s := hyperbolicUpperRootPoint 4 1 0 (by decide) (-1 : k) *
    hyperbolicUpperRootPoint 4 0 1 (by decide) (1 - a) *
    hyperbolicUpperRootPoint 4 1 0 (by decide) a⁻¹
  have hs : s ∈ evenOrthogonalElementarySubgroup 4 :=
    mul_mem (mul_mem (upper_mem _ _ _ _ _) (upper_mem _ _ _ _ _))
      (upper_mem _ _ _ _ _)
  refine ⟨s * h, mul_mem hs hh, ?_⟩
  rw [point_mul_apply]
  funext i
  fin_cases i <;> simp [s, upper_apply, hx, a, hv]

/-- Coordinate root matrices carry each norm-one vector to the first
standard anisotropic vector. -/
public theorem exists_map_norm_one (v : HyperbolicSpace k 4)
    (hv : hyperbolicForm 4 v = 1) :
    ∃ g : quadraticIsometrySubgroup (hyperbolicForm (k := k) 4),
      g ∈ evenOrthogonalElementarySubgroup 4 ∧
      g.1 v = (Pi.single 0 1, Pi.single 0 1) := by
  obtain ⟨g, hg, hpivot⟩ := exists_pivot v (by rw [hv]; exact one_ne_zero)
  obtain ⟨h, hh, hfirst⟩ := exists_first_basis (g.1 v) hpivot
  let w := (h * g).1 v
  have hw : w.1 = Pi.single 0 1 := hfirst
  have hq : hyperbolicForm 4 w = 1 := by
    rw [(mem_quadraticIsometrySubgroup _ _).1 (h * g).2, hv]
  have hy0 : w.2 0 = 1 := by
    simpa [hyperbolicForm_apply, hw, Pi.single_apply] using hq
  let s := hyperbolicLowerRootPoint 4 1 0 (by decide) (-w.2 1) *
    hyperbolicLowerRootPoint 4 2 0 (by decide) (-w.2 2) *
    hyperbolicLowerRootPoint 4 3 0 (by decide) (-w.2 3)
  have hs : s ∈ evenOrthogonalElementarySubgroup 4 :=
    mul_mem (mul_mem (lower_mem _ _ _ _ _) (lower_mem _ _ _ _ _))
      (lower_mem _ _ _ _ _)
  refine ⟨s * (h * g), mul_mem hs (mul_mem hh hg), ?_⟩
  change s.1 w = _
  apply Prod.ext
  · simpa [s, lower_apply] using hw
  · funext i
    fin_cases i <;> simp [s, lower_apply, hw, hy0]

end EvenOrthogonalElementary
end Theory.AlgebraicGroup
