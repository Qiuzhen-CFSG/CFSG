module

public import Theory.AlgebraicGroup.Automorphisms.Lang.theorem_2_1_6

/-!
This internal module isolates normality of the closure generated by the
twisted commutator map in source Theorem 2.1.8.  Since every element of `Z` is
central in the ambient group, two elements of the subgroup subtype commute.
Thus conjugation by an element of `Z` fixes every element of the closure, which
proves its normality without using any further property of the map.
-/

universe u

set_option warningAsError false

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

public theorem theorem_2_1_8_l_normal
    {K : Variety k} [AlgebraicGroup K]
    (Z : ClosedSubgroup K)
    (hZ : Z.toSubgroup ≤ Subgroup.center (Variety.Point K))
    (comm : Z.toSubgroup → Z.toSubgroup) :
    (Subgroup.closure (Set.range comm)).Normal := by
  constructor
  intro n hn z
  have hcommute : (z : Variety.Point K) * n = n * z :=
    Subgroup.mem_center_iff.mp (hZ n.property) z
  have hconj : z * n * z⁻¹ = n := by
    apply Subtype.ext
    change (z : Variety.Point K) * n * (z : Variety.Point K)⁻¹ = n
    rw [hcommute]
    simp
  simpa [hconj] using hn

end Theory.AlgebraicGroup
