module

public import Theory.AlgebraicGroup.Tori.Character.Algebra
public import Theory.AlgebraicGroup.Tori.Semisimple

/-!
Character support in a polynomially parametrized torus orbit.

If a polynomial in affine coordinates scaled by torus characters agrees on
every torus point with a single character, that character lies in the
multiplicative monoid generated by the coordinate characters.  The proof
factors the polynomial through the monoid algebra of that monoid and then uses
the character-algebra description of regular functions on a torus.  Thus it
uses equality of regular functions, not differentiation, and remains valid in
positive characteristic even when point maps can be inseparable.
-/

namespace Theory.AlgebraicGroup

open scoped BigOperators

universe u

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- A torus character represented by a polynomial in coordinates of weights
`beta` belongs to the submonoid generated by those weights. -/
public theorem affinePolynomial_character_mem_submonoidClosure
    {T : Variety k} [AlgebraicGroup T] (hT : IsTorus T)
    {sigma : Type u} [Finite sigma]
    (beta : sigma → TorusCharacter T) (a : sigma → k)
    (P : MvPolynomial sigma k) (alpha : TorusCharacter T)
    (hP : forall s : Variety.Point T,
      MvPolynomial.eval (fun i => (beta i).pointCharacter s * a i) P =
        alpha.pointCharacter s) :
    alpha ∈ Submonoid.closure (Set.range beta) := by
  classical
  let M : Submonoid (TorusCharacter T) :=
    Submonoid.closure (Set.range beta)
  let vars : sigma → MonoidAlgebra k M := fun i =>
    MonoidAlgebra.single
      (show M from ⟨beta i,
        Submonoid.subset_closure (Set.mem_range_self i)⟩) (a i)
  let qM : MonoidAlgebra k M := MvPolynomial.aeval vars P
  let mapCharacters : MonoidAlgebra k M →ₐ[k]
      MonoidAlgebra k (TorusCharacter T) :=
    MonoidAlgebra.mapDomainAlgHom k k M.subtype
  let eT := torusCharacterAlgebraEquiv T
    hT.isMulCommutative (IsTorus.all_semisimple hT)
  let targetVariables : sigma → Variety.PolynomialFunction T := fun i =>
    a i • (beta i).scalarPolynomialFunction
  have heTsingle (chi : TorusCharacter T) (c : k) :
      eT (MonoidAlgebra.single chi c) =
        c • chi.scalarPolynomialFunction := by
    change
      ((MonoidAlgebra.lift k (Variety.PolynomialFunction T)
        (TorusCharacter T))
        (TorusCharacter.scalarPolynomialFunctionMonoidHom T))
        (MonoidAlgebra.single chi c) = _
    rw [MonoidAlgebra.lift_single]
    rfl
  have hmap : eT (mapCharacters qM) =
      MvPolynomial.aeval targetVariables P := by
    have hhom : (eT.toAlgHom.comp mapCharacters).comp
        (MvPolynomial.aeval vars) =
        MvPolynomial.aeval targetVariables := by
      apply MvPolynomial.algHom_ext
      intro i
      have hi : eT.toAlgHom (mapCharacters (vars i)) =
          targetVariables i := by
        rw [show mapCharacters (vars i) =
            MonoidAlgebra.single (beta i) (a i) by
          simp [mapCharacters, vars]]
        exact heTsingle (beta i) (a i)
      simpa only [AlgHom.comp_apply, MvPolynomial.aeval_X] using hi
    exact DFunLike.congr_fun hhom P
  have htarget : MvPolynomial.aeval targetVariables P =
      alpha.scalarPolynomialFunction := by
    apply Variety.PolynomialFunction.ext
    intro s
    rw [TorusCharacter.scalarPolynomialFunction_apply]
    let ev : Variety.PolynomialFunction T →+* k :=
      { toFun := fun f => f s
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have heval := MvPolynomial.map_aeval targetVariables ev P
    change (MvPolynomial.aeval targetVariables P) s = _
    rw [← show ev (MvPolynomial.aeval targetVariables P) =
        (MvPolynomial.aeval targetVariables P) s by rfl, heval]
    change MvPolynomial.eval₂ _
      (fun i => (a i • (beta i).scalarPolynomialFunction) s) P = _
    have hscalar : ev.comp
        (algebraMap k (Variety.PolynomialFunction T)) = RingHom.id k := by
      apply RingHom.ext
      intro r
      exact polynomialFunction_algebraMap_apply T r s
    rw [hscalar, MvPolynomial.eval₂_id]
    simp only [polynomialFunction_smul_apply,
      TorusCharacter.scalarPolynomialFunction_apply]
    simpa [mul_comm] using hP s
  have hsingle : eT (MonoidAlgebra.single alpha 1) =
      alpha.scalarPolynomialFunction := by
    simpa using heTsingle alpha 1
  have hq : mapCharacters qM = MonoidAlgebra.single alpha 1 := by
    apply eT.injective
    rw [hmap, htarget, hsingle]
  have hcoeff : (mapCharacters qM).coeff alpha ≠ 0 := by
    rw [hq]
    simp
  have hcoeff' : (Finsupp.mapDomain M.subtype qM.coeff) alpha ≠ 0 := by
    simpa only [mapCharacters, MonoidAlgebra.mapDomainAlgHom_apply,
      MonoidAlgebra.mapDomain] using hcoeff
  have hrange : alpha ∈ Set.range M.subtype := by
    exact Finsupp.mem_range_of_mapDomain_ne_zero
      (f := M.subtype) (x := qM.coeff) hcoeff'
  obtain ⟨chi, hchi⟩ := hrange
  exact hchi ▸ chi.property

end Theory.AlgebraicGroup
