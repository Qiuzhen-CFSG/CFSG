module

public import Theory.AlgebraicGroup.Bor1.TangentDimension
public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration

/-!
Linear dimension and generation tools for Borel III, 9.4--9.5 and IV, 13.16.
We view every closed subgroup tangent inside the tangent of the ambient group.
The dimension bound uses only the inclusion of the tangent of an intersection
in the intersection of the tangents; it neither asserts equality for arbitrary
intersections nor equips a homogeneous space with a quotient-group structure.
-/

universe u

namespace Theory.AlgebraicGroup.SemisimpleCenterContainment.RadicalGeometry.IntersectionNormality

open Bor1

variable {k : Type u} [Field k] [IsAlgClosed k]

/-- The identity tangent of a closed subgroup, embedded in the ambient tangent. -/
public noncomputable abbrev closedSubgroupTangent
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G) :
    Submodule k (IdentityPointDerivation G) :=
  LinearMap.range (identityTangentMorphismLinearMap H.inclusion)

/-- Subgroup inclusion induces tangent-space inclusion. -/
public theorem closedSubgroupTangent_mono
    {G : Variety k} [AlgebraicGroup G] {A B : ClosedSubgroup G} (hAB : A ≤ B) :
    closedSubgroupTangent A ≤ closedSubgroupTangent B := by
  rintro D ⟨E, rfl⟩
  let q : AlgebraicGroup.Morphism A.carrierVariety B.carrierVariety :=
    A.inclusion.codRestrictClosedSubgroup B (fun x => hAB (A.pointEquiv x).property)
  refine ⟨identityTangentMorphismLinearMap q E, ?_⟩
  calc
    identityTangentMorphismLinearMap B.inclusion
        (identityTangentMorphismLinearMap q E) =
        identityTangentMorphismLinearMap (B.inclusion.comp q) E := by
      rw [identityTangentMorphismLinearMap_comp]
      rfl
    _ = identityTangentMorphismLinearMap A.inclusion E := by congr 1

/-- Embedded tangent dimension equals geometric dimension. -/
public theorem closedSubgroupTangent_finrank
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G) :
    Module.finrank k (closedSubgroupTangent H) =
      Cardinal.toNat (Variety.dimension H.carrierVariety) := by
  rw [closedSubgroupTangent,
    LinearMap.finrank_range_of_inj (identityTangentMorphismLinearMap_inclusion_injective H)]
  exact identityPointDerivation_finrank_eq_dimension H.carrierVariety

/-- Passing to the identity component does not change the embedded tangent. -/
public theorem closedSubgroupTangent_identityComponent
    {G : Variety k} [AlgebraicGroup G] (H : ClosedSubgroup G) :
    closedSubgroupTangent H.identityComponentAmbient = closedSubgroupTangent H := by
  apply Submodule.eq_of_le_of_finrank_eq
    (closedSubgroupTangent_mono H.identityComponentAmbient_le)
  rw [closedSubgroupTangent_finrank, closedSubgroupTangent_finrank,
    ClosedSubgroup.dimension_identityComponentAmbient]

/-- Tangent spanning forces a connected closed subgroup to be generated by
any prescribed family of connected closed subgroups contained in it. -/
public theorem subgroupClosure_eq_of_tangent_span
    {G : Variety k} [AlgebraicGroup G] {ι : Type*}
    (H : ClosedSubgroup G) (C : ι → ClosedSubgroup G)
    (hHc : _root_.IsConnected (H : Set (Variety.Point G)))
    (hCc : ∀ i, _root_.IsConnected (C i : Set (Variety.Point G)))
    (hCH : ∀ i, C i ≤ H)
    (hspan : closedSubgroupTangent H ≤ ⨆ i, closedSubgroupTangent (C i)) :
    Subgroup.closure (⋃ i, (C i : Set (Variety.Point G))) = H.toSubgroup := by
  let J : ClosedSubgroup G := ClosedSubgroup.ofSubgroup
    (Subgroup.closure (⋃ i, (C i : Set (Variety.Point G))))
    (closure_iUnion_connected_closedSubgroup_isZariskiClosed C hCc)
  have hCJ (i : ι) : C i ≤ J := by
    intro x hx
    exact Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨i, hx⟩)
  have hJH : J ≤ H := by
    change Subgroup.closure _ ≤ H.toSubgroup
    apply (Subgroup.closure_le H.toSubgroup).mpr
    intro x hx
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
    exact hCH i hi
  have hJc : _root_.IsConnected (J : Set (Variety.Point G)) :=
    closure_iUnion_connected_closedSubgroup_isConnected C hCc
  have ht : closedSubgroupTangent H ≤ closedSubgroupTangent J :=
    hspan.trans (iSup_le (fun i => closedSubgroupTangent_mono (hCJ i)))
  have hd : Variety.dimension H.carrierVariety ≤ Variety.dimension J.carrierVariety := by
    apply (Cardinal.toNat_le_iff_le_of_lt_aleph0
      (variety_dimension_lt_aleph0 _) (variety_dimension_lt_aleph0 _)).mp
    rw [← closedSubgroupTangent_finrank H, ← closedSubgroupTangent_finrank J]
    exact Submodule.finrank_mono ht
  have heq : J = H := by
    by_contra hne
    exact (not_lt_of_ge hd)
      (connected_closedSubgroup_dimension_lt_of_le_of_ne J H hJH hne hJc hHc)
  exact congrArg (fun A : ClosedSubgroup G => A.toSubgroup) heq

/-- A dimension bound from tangent spanning, valid without normality of `U`.
Only one direction of the tangent-intersection comparison is used. -/
public theorem dimension_le_add_of_tangent_le_sup
    {G : Variety k} [AlgebraicGroup G] (H U F : ClosedSubgroup G) (n : ℕ)
    (hspan : closedSubgroupTangent H ≤
      closedSubgroupTangent U ⊔ closedSubgroupTangent F)
    (hlocal : Variety.dimension F.carrierVariety ≤
      Variety.dimension (F.inter U).carrierVariety + n) :
    Variety.dimension H.carrierVariety ≤ Variety.dimension U.carrierVariety + n := by
  have hinter : closedSubgroupTangent (F.inter U) ≤
      closedSubgroupTangent U ⊓ closedSubgroupTangent F :=
    le_inf (closedSubgroupTangent_mono (fun _ hx => hx.2))
      (closedSubgroupTangent_mono (fun _ hx => hx.1))
  have hspanDim := Submodule.finrank_mono hspan
  have hinterDim := Submodule.finrank_mono hinter
  have hsum := Submodule.finrank_sup_add_finrank_inf_eq
    (closedSubgroupTangent U) (closedSubgroupTangent F)
  have hlocalNat := Cardinal.toNat_le_toNat hlocal
    (Cardinal.add_lt_aleph0 (variety_dimension_lt_aleph0 _) Cardinal.natCast_lt_aleph0)
  rw [Cardinal.toNat_add (variety_dimension_lt_aleph0 _)
    (Cardinal.natCast_lt_aleph0), Cardinal.toNat_natCast,
    ← closedSubgroupTangent_finrank F,
    ← closedSubgroupTangent_finrank (F.inter U)] at hlocalNat
  apply (Cardinal.toNat_le_iff_le_of_lt_aleph0
    (variety_dimension_lt_aleph0 _)
    (Cardinal.add_lt_aleph0 (variety_dimension_lt_aleph0 _) Cardinal.natCast_lt_aleph0)).mp
  rw [Cardinal.toNat_add (variety_dimension_lt_aleph0 _)
    (Cardinal.natCast_lt_aleph0), Cardinal.toNat_natCast,
    ← closedSubgroupTangent_finrank H, ← closedSubgroupTangent_finrank U]
  omega

end Theory.AlgebraicGroup.SemisimpleCenterContainment.RadicalGeometry.IntersectionNormality
