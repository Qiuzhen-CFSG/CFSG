module

public import Theory.AlgebraicGroup.Bor1.SolvableCompleteFixedPoint
public import Theory.AlgebraicGroup.Unipotent.SemisimpleCommutator
public import Theory.AlgebraicGroup.Variety.MorphicActionFixedLocus
public import Theory.AlgebraicGroup.Variety.MorphicActionPullback

/-!
# A common fixed point for a centralizing solvable subgroup

If a connected solvable subgroup `S` centralizes `a`, then it acts on the
closed locus fixed by `a` in any complete geometric variety. A nonempty such
locus has an `S`-fixed point by the solvable fixed-point theorem.

We realize the locus using the cyclic subgroup generated by `a` inside the
closed point centralizer of `a`. That cyclic subgroup is central there, so the
existing normal-subgroup fixed-locus construction supplies its regular action
and genuine geometric completeness. Restricting this action to `S` proves
the common fixed-point step of Borel, *Linear Algebraic Groups*, §11.12
(`refs/KGroup/Bor1/Chapter4.tex`). No connectedness of a centralizer is used.
-/

open Theory.AlgebraicGroup
open Theory.AlgebraicGroup.Variety.Geometric

universe u
namespace Theory.AlgebraicGroup.SemisimpleCenterContainment.CartanGeometry
variable {k : Type u} [Field k] [IsAlgClosed k]
variable {G : Variety k} [AlgebraicGroup G]

set_option linter.style.haveILetI false

/-- A connected solvable subgroup centralizing an element fixes a point on its
nonempty fixed locus in a complete variety. Neither the element nor the ambient
group is assumed to be contained in that solvable subgroup. -/
public theorem exists_common_fixedPoint_of_centralizes
    {X : Variety.Geometric k} (A : MorphicAction G X)
    (hX : IsComplete X) (S : ClosedSubgroup G)
    (hSconn : Variety.IsConnected S.carrierVariety)
    (hSsolv : Group.IsSolvable (Variety.Point S.carrierVariety))
    (a : Variety.Point G) (ha : a ∈ S.centralizer)
    (hne : ∃ x : Point X, A.toMulAction.smul a x = x) :
    ∃ x : Point X, A.toMulAction.smul a x = x ∧
      ∀ s : Variety.Point G, s ∈ S → A.toMulAction.smul s x = x := by
  let C := semisimpleCommutatorPointCentralizer a
  have haC : a ∈ C := by
    change a ∈ Subgroup.centralizer ({a} : Set (Variety.Point G))
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    rw [Set.mem_singleton_iff.mp hy]
  let aC : Variety.Point C.carrierVariety := C.pointEquiv.symm ⟨a, haC⟩
  have haCval : C.inclusion.onPoints aC = a := by
    change (C.pointEquiv aC).val = a
    simp [aC]
  have hcomm (g : Variety.Point C.carrierVariety) : Commute g aC := by
    apply C.inclusion_injective
    simp only [map_mul, haCval]
    exact ((Subgroup.mem_centralizer_iff.mp (C.pointEquiv g).property) a
      (Set.mem_singleton a)).symm
  let N := Subgroup.zpowers aC
  have hN : N.Normal := by
    constructor
    intro n hn g
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp hn
    have hi := (hcomm g).zpow_right i
    have heq : g * aC ^ i * g⁻¹ = aC ^ i := by
      rw [hi.eq, mul_assoc, mul_inv_cancel, mul_one]
    rw [heq]
    exact Subgroup.zpow_mem_zpowers aC i
  let AC := A.pullbackGroup C.inclusion
  have hNne : Nonempty (Point (AC.subgroupFixedLocus N).toGeometric) := by
    apply AC.subgroupFixedLocus_nonempty
    obtain ⟨x, hx⟩ := hne
    refine ⟨x, ?_⟩
    intro n
    obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp n.property
    rw [← hi]
    letI := AC.toMulAction
    apply MulAction.mem_fixedBy_zpow (g := aC)
    change A.toMulAction.smul (C.inclusion.onPoints aC) x = x
    rwa [haCval]
  have hSC : S ≤ C := by
    intro s hs
    change s ∈ Subgroup.centralizer ({a} : Set (Variety.Point G))
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    subst y
    exact ((Subgroup.mem_centralizer_iff.mp ha) s hs).symm
  let j : AlgebraicGroup.Morphism S.carrierVariety C.carrierVariety :=
    S.inclusion.codRestrictClosedSubgroup C (fun s => hSC (S.pointEquiv s).property)
  let F := AC.onSubgroupFixedLocus N hN
  obtain ⟨y, hy⟩ :=
    (F.pullbackGroup j).exists_fixedPoint_of_isConnected_isSolvable_isComplete
      hSconn hSsolv (AC.subgroupFixedLocus_isComplete N hX) hNne
  let x := (AC.subgroupFixedLocus N).inclusion y
  refine ⟨x, ?_, ?_⟩
  · have h := AC.subgroupFixedLocus_fixed N y ⟨aC, Subgroup.mem_zpowers aC⟩
    change A.toMulAction.smul (C.inclusion.onPoints aC) x = x at h
    rwa [haCval] at h
  · intro s hs
    let sS : Variety.Point S.carrierVariety := S.pointEquiv.symm ⟨s, hs⟩
    have heq := AC.onSubgroupFixedLocus_smul N hN (j.onPoints sS) y
    have hfix := hy sS
    change F.toMulAction.smul (j.onPoints sS) y = y at hfix
    rw [hfix] at heq
    have hj : C.inclusion.onPoints (j.onPoints sS) = s := by
      rw [AlgebraicGroup.Morphism.codRestrictClosedSubgroup_inclusion_apply]
      change (S.pointEquiv sS).val = s
      simp [sS]
    change x = A.toMulAction.smul (C.inclusion.onPoints (j.onPoints sS)) x at heq
    rw [hj] at heq
    exact heq.symm

end Theory.AlgebraicGroup.SemisimpleCenterContainment.CartanGeometry
