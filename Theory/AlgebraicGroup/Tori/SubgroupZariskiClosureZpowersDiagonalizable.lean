module

public import Theory.AlgebraicGroup.ClosedSubgroup.Closure
public import Theory.AlgebraicGroup.Morphism.ClosedEmbedding
public import Theory.AlgebraicGroup.Representations.DiagonalBasis
public import Theory.AlgebraicGroup.Representations.RationalBasis
public import Theory.AlgebraicGroup.RightTranslation.SemisimpleEigenbasis
public import Theory.AlgebraicGroup.Tori.DiagonalizableClosedSubgroup

universe u

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k] [IsAlgClosed k]

/- The Zariski closure of the cyclic subgroup generated by a semisimple
element is diagonalizable.  The proof embeds the closure into the diagonal
image of a semisimple eigenbasis in the faithful coordinate representation. -/
public theorem subgroupZariskiClosure_zpowers_isDiagonalizable_of_semisimple
    {G : Variety k} [AlgebraicGroup G]
    (g : Variety.Point G) (hg : IsSemisimpleElement G g) :
    IsDiagonalizableClosedSubgroup
      (subgroupZariskiClosure G (Subgroup.zpowers g)) := by
  let : Module.Finite k (coordinateTranslationSubmodule G) :=
    coordinateTranslationSubmodule_finite G
  have hrho : IsRationalRepresentation
      (coordinateTranslationRationalRepresentation G) :=
    coordinateTranslationRationalRepresentation_isRational G
  obtain ⟨b, mu, hmuEigen⟩ := exists_coordinateTranslation_eigenbasis g hg
  obtain ⟨f, hf⟩ := hrho.exists_morphism_in_basis b
  let evaluationOne : Module.Dual k (coordinateTranslationSubmodule G) :=
    polynomialFunctionSubspaceEvaluation G (coordinateTranslationSubmodule G) 1
  let targetMatrixCoordinate
      (i j : Fin (Module.finrank k (coordinateTranslationSubmodule G))) :
      Variety.PolynomialFunction
        (glVarietyOf k (coordinateTranslationSubmodule G)) :=
    Variety.PolynomialFunction.ofPolynomial _
      (MvPolynomial.X (Sum.inl (i, j)))
  have targetMatrixCoordinate_apply
      (i j : Fin (Module.finrank k (coordinateTranslationSubmodule G)))
      (x : Variety.Point (glVarietyOf k (coordinateTranslationSubmodule G))) :
      targetMatrixCoordinate i j x =
        b.repr ((((glPointEquivOf k (coordinateTranslationSubmodule G) b x) :
          LinearMap.GeneralLinearGroup k (coordinateTranslationSubmodule G)) :
            Module.End k (coordinateTranslationSubmodule G)) (b j)) i := by
    have hcoordinate : targetMatrixCoordinate i j x =
        x.val (Sum.inl (i, j)) := by
      simp only [targetMatrixCoordinate, Variety.PolynomialFunction.ofPolynomial,
        Variety.PolynomialFunction.toFun]
      exact MvPolynomial.eval_X _
    rw [hcoordinate]
    have hb := glPointEquivOf_apply_basis
      (coordinateTranslationSubmodule G) b x j
    have hc := congrArg (b.coord i) hb
    rw [Module.Basis.coord_equivFun_symm] at hc
    exact hc.symm
  let coordinatePreimage (c : G.Coordinates) :
      Variety.PolynomialFunction
        (glVarietyOf k (coordinateTranslationSubmodule G)) :=
    let v := coordinateTranslationCoordinateVector G c
    ∑ i, ∑ j,
      algebraMap k (Variety.PolynomialFunction
        (glVarietyOf k (coordinateTranslationSubmodule G)))
          (evaluationOne (b i) * b.repr v j) *
        targetMatrixCoordinate i j
  have coordinatePreimage_apply (c : G.Coordinates) (x : Variety.Point G) :
      coordinatePreimage c (f.onPoints x) = coordinatePolynomialFunction G c x := by
    let v := coordinateTranslationCoordinateVector G c
    have hmatrix : coordinatePreimage c (f.onPoints x) =
        evaluationOne
          (((coordinateTranslationRationalRepresentation G).action x :
            Module.End k (coordinateTranslationSubmodule G)) v) := by
      change polynomialFunctionEvalAddHom _ _ (∑ i, ∑ j,
        algebraMap k (Variety.PolynomialFunction
          (glVarietyOf k (coordinateTranslationSubmodule G)))
            (evaluationOne (b i) * b.repr v j) *
          targetMatrixCoordinate i j) = _
      rw [map_sum]
      simp_rw [map_sum]
      simp_rw [map_mul]
      simp_rw [polynomialFunctionEvalAddHom_apply]
      simp_rw [polynomialFunction_mul_apply]
      simp_rw [polynomialFunction_algebraMap_apply]
      calc
        ∑ i, ∑ j, (evaluationOne (b i) * b.repr v j) *
              targetMatrixCoordinate i j (f.onPoints x) =
            ∑ i, ∑ j, (evaluationOne (b i) * b.repr v j) *
              b.repr ((((glPointEquivOf k (coordinateTranslationSubmodule G) b
                (f.onPoints x)) : LinearMap.GeneralLinearGroup k
                  (coordinateTranslationSubmodule G)) : Module.End k
                    (coordinateTranslationSubmodule G)) (b j)) i := by
          apply Finset.sum_congr rfl
          intro i _
          apply Finset.sum_congr rfl
          intro j _
          rw [targetMatrixCoordinate_apply]
        _ = ∑ i, ∑ j, (evaluationOne (b i) * b.repr v j) *
              b.repr ((((coordinateTranslationRationalRepresentation G).action x :
                LinearMap.GeneralLinearGroup k
                  (coordinateTranslationSubmodule G)) : Module.End k
                    (coordinateTranslationSubmodule G)) (b j)) i := by
          rw [hf x]
        _ = evaluationOne
              (((coordinateTranslationRationalRepresentation G).action x :
                Module.End k (coordinateTranslationSubmodule G)) v) := by
          simpa [LinearMap.toMatrix_apply] using
            LinearMap.dual_apply_eq_sum_toMatrix b evaluationOne
              ((coordinateTranslationRationalRepresentation G).action x :
                Module.End k (coordinateTranslationSubmodule G)) v
    rw [hmatrix]
    change (rightTranslationOnCoordinateSubmodule G x v).val 1 = _
    rw [rightTranslationOnCoordinateSubmodule_apply,
      rightTranslationPullback_apply]
    change coordinatePolynomialFunction G c (1 * x) =
      coordinatePolynomialFunction G c x
    rw [one_mul]
  have hfinj : Function.Injective f.onPoints := by
    intro x y hxy
    apply coordinateTranslationRepresentation_injective G
    have hxy' := congrArg
      (glPointEquivOf k (coordinateTranslationSubmodule G) b) hxy
    rw [hf x, hf y] at hxy'
    change coordinateTranslationRepresentation G x =
      coordinateTranslationRepresentation G y at hxy'
    exact hxy'
  obtain ⟨diag, hdiagTorus, hdiagAction⟩ := exists_basisDiagonalMorphism b
  have hmuNe (i : Fin (Module.finrank k (coordinateTranslationSubmodule G))) :
      mu i ≠ 0 := by
    intro hzero
    have hz : rightTranslationOnCoordinateSubmodule G g (b i) = 0 := by
      rw [hmuEigen i, hzero, zero_smul]
    have hbi : b i = 0 := by
      have hz' := congrArg
        (rightTranslationOnCoordinateSubmodule G g⁻¹) hz
      rw [← Module.End.mul_apply,
        ← rightTranslationOnCoordinateSubmodule_mul,
        inv_mul_cancel, rightTranslationOnCoordinateSubmodule_one] at hz'
      simpa using hz'
    exact b.ne_zero i hbi
  let dg : Variety.Point
      (dVariety k (Module.finrank k (coordinateTranslationSubmodule G))) :=
    (dPointEquiv (Module.finrank k (coordinateTranslationSubmodule G))).symm
      (fun i => Units.mk0 (mu i) (hmuNe i))
  have hdiag_g : diag.onPoints dg = f.onPoints g := by
    apply (glPointEquivOf k (coordinateTranslationSubmodule G) b).injective
    apply Units.ext
    apply b.ext
    intro i
    rw [hdiagAction dg i, hf g]
    change dPointEntry (Module.finrank k (coordinateTranslationSubmodule G)) dg i • b i =
      rightTranslationOnCoordinateSubmodule G g (b i)
    rw [hmuEigen i]
    congr 1
  let J : ClosedSubgroup (glVarietyOf k (coordinateTranslationSubmodule G)) :=
    diag.imageClosedSubgroup
  let P : ClosedSubgroup G := f.closedSubgroupPreimage J
  have hgP : g ∈ P.toSubgroup := by
    change f.onPoints g ∈ J.toSubgroup
    rw [← hdiag_g]
    exact ⟨dg, rfl⟩
  have hzpowersP : Subgroup.zpowers g ≤ P.toSubgroup :=
    Subgroup.zpowers_le.2 hgP
  let C : ClosedSubgroup G :=
    subgroupZariskiClosure G (Subgroup.zpowers g)
  have hCP : C ≤ P := by
    intro x hx
    change x ∈ closure (Subgroup.zpowers g : Set (Variety.Point G)) at hx
    exact closure_minimal hzpowersP (by
      rw [Variety.isClosed_iff_isZariskiClosed]
      exact P.isZariskiClosed) hx
  have hmapJ (x : Variety.Point C.carrierVariety) :
      (f.comp C.inclusion).onPoints x ∈ J.toSubgroup := by
    change f.onPoints (C.inclusion.onPoints x) ∈ J.toSubgroup
    change C.inclusion.onPoints x ∈ P.toSubgroup
    exact hCP (C.pointEquiv x).property
  let r : AlgebraicGroup.Morphism C.carrierVariety J.carrierVariety :=
    (f.comp C.inclusion).codRestrictClosedSubgroup J hmapJ
  have hr_inclusion (x : Variety.Point C.carrierVariety) :
      J.inclusion.onPoints (r.onPoints x) =
        f.onPoints (C.inclusion.onPoints x) := by
    exact Morphism.codRestrictClosedSubgroup_inclusion_apply
      (f.comp C.inclusion) J hmapJ x
  obtain ⟨n, ⟨e⟩⟩ := hdiagTorus
  let delta : AlgebraicGroup.Morphism C.carrierVariety (dVariety k n) :=
    e.inv.comp r
  have hdeltaInj : Function.Injective delta.onPoints := by
    intro x y hxy
    have hrxy : r.onPoints x = r.onPoints y :=
      Function.LeftInverse.injective e.inv_hom_id hxy
    apply C.inclusion_injective
    apply hfinj
    have hamb := congrArg J.inclusion.onPoints hrxy
    rwa [hr_inclusion x, hr_inclusion y] at hamb
  have hcoordinate : ∀ c : C.carrierVariety.Coordinates,
      ∃ q : Variety.PolynomialFunction (dVariety k n),
        Variety.PolynomialFunction.pullback delta.toVariety q =
          Variety.PolynomialFunction.ofPolynomial C.carrierVariety
            (MvPolynomial.X c) := by
    intro c
    obtain ⟨a, ha⟩ := C.exists_polynomialFunction_extension
      (coordinatePolynomialFunction C.carrierVariety c)
    obtain ⟨p, hp⟩ := a.representedBy
    have hpoly (p : MvPolynomial G.Coordinates k) :
        ∃ qGL : Variety.PolynomialFunction
            (glVarietyOf k (coordinateTranslationSubmodule G)),
          ∀ x : Variety.Point G,
            qGL (f.onPoints x) = evalPolynomial x.val p := by
      induction p using MvPolynomial.induction_on with
      | C z =>
          refine ⟨Variety.PolynomialFunction.ofPolynomial _
            (MvPolynomial.C z), ?_⟩
          intro x
          simp [Variety.PolynomialFunction.ofPolynomial,
            Variety.PolynomialFunction.toFun, evalPolynomial]
      | add p q hp hq =>
          obtain ⟨pGL, hpGL⟩ := hp
          obtain ⟨qGL, hqGL⟩ := hq
          refine ⟨pGL + qGL, ?_⟩
          intro x
          change pGL (f.onPoints x) + qGL (f.onPoints x) = _
          rw [hpGL, hqGL]
          simp [evalPolynomial]
      | mul_X p c hp =>
          obtain ⟨pGL, hpGL⟩ := hp
          refine ⟨pGL * coordinatePreimage c, ?_⟩
          intro x
          change pGL (f.onPoints x) * coordinatePreimage c (f.onPoints x) = _
          rw [hpGL, coordinatePreimage_apply]
          simp [coordinatePolynomialFunction,
            Variety.PolynomialFunction.ofPolynomial,
            Variety.PolynomialFunction.toFun, evalPolynomial]
    obtain ⟨qGL, hqGL'⟩ := hpoly p
    have hqGL (x : Variety.Point G) : qGL (f.onPoints x) = a x := by
      rw [hqGL', hp]
    let qJ : Variety.PolynomialFunction J.carrierVariety :=
      Variety.PolynomialFunction.pullback J.inclusion.toVariety qGL
    let qD : Variety.PolynomialFunction (dVariety k n) :=
      Variety.PolynomialFunction.pullback e.hom.toVariety qJ
    refine ⟨qD, ?_⟩
    apply Variety.PolynomialFunction.ext
    intro x
    change qGL (J.inclusion.onPoints
      (e.hom.onPoints (e.inv.onPoints (r.onPoints x)))) =
        coordinatePolynomialFunction C.carrierVariety c x
    rw [e.inv_hom_id]
    rw [hr_inclusion]
    rw [hqGL, ha]
  change IsDiagonalizableClosedSubgroup C
  let : AlgebraicGroup delta.imageClosedSubgroup.carrierVariety :=
    delta.imageClosedSubgroup.carrierAlgebraicGroup
  obtain ⟨edelta, _⟩ :=
    delta.iso_imageClosedSubgroup_of_coordinate_preimage hdeltaInj hcoordinate
  exact ⟨n, delta.imageClosedSubgroup, ⟨edelta⟩⟩

end Theory.AlgebraicGroup
