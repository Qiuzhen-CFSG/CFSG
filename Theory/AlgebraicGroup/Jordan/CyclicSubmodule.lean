module

public import Mathlib.Algebra.Module.Submodule.Invariant

universe u v

/-! Cyclic submodules generated by a linear endomorphism. -/

namespace Theory.AlgebraicGroup

variable {k : Type u} [Field k]

/-- The cyclic submodule generated by a vector under an endomorphism. -/
@[expose]
public def Module.End.cyclicSubmodule
    {M : Type v} [AddCommGroup M] [Module k M]
    (T : Module.End k M) (x : M) : Submodule k M :=
  Submodule.span k (Set.range fun n : ℕ ↦ (T^[n]) x)

/-- A cyclic submodule is invariant under its generating endomorphism. -/
public lemma Module.End.cyclicSubmodule_mem_invtSubmodule
    {M : Type v} [AddCommGroup M] [Module k M]
    (T : Module.End k M) (x : M) :
    Module.End.cyclicSubmodule T x ∈ T.invtSubmodule := by
  simp only [Module.End.mem_invtSubmodule, Module.End.cyclicSubmodule,
    Submodule.span_le]
  rintro y ⟨n, rfl⟩
  apply Submodule.subset_span
  exact ⟨n + 1, by
    simpa only [Nat.succ_eq_add_one] using
      Function.iterate_succ_apply' (⇑T) n x⟩

/-- The generating vector belongs to its cyclic submodule. -/
public lemma Module.End.mem_cyclicSubmodule
    {M : Type v} [AddCommGroup M] [Module k M]
    (T : Module.End k M) (x : M) :
    x ∈ Module.End.cyclicSubmodule T x := by
  apply Submodule.subset_span
  exact ⟨0, rfl⟩

end Theory.AlgebraicGroup
