module

public import Mathlib.LinearAlgebra.Eigenspace.Semisimple
public import Mathlib.LinearAlgebra.JordanChevalley
public import Theory.AlgebraicGroup.Jordan.CyclicSubmodule

universe u v

/-! Linear Jordan--Chevalley decomposition infrastructure. -/

namespace Theory.AlgebraicGroup

open Algebra LinearMap Submodule
open _root_.Module.End

namespace Module.End

variable {K : Type u} [Field K]
variable {M : Type v} [AddCommGroup M] [Module K M]

/-- The cyclic submodule generated by a vector is contained in every invariant
submodule containing that vector. -/
public lemma cyclicSubmodule_le_of_mem {T : _root_.Module.End K M} {P : Submodule K M}
    (hP : P ∈ T.invtSubmodule) {x : M} (hx : x ∈ P) :
    Theory.AlgebraicGroup.Module.End.cyclicSubmodule T x ≤ P := by
  rw [Theory.AlgebraicGroup.Module.End.cyclicSubmodule, Submodule.span_le]
  rintro y ⟨n, rfl⟩
  induction n with
  | zero => simpa using hx
  | succ n ih =>
      have h := hP ih
      change T (((⇑T)^[n]) x) ∈ P at h
      change ((⇑T)^[n + 1]) x ∈ (P : Set M)
      rw [Function.iterate_succ_apply']
      exact h

variable [PerfectField K]

/-- A Jordan--Chevalley decomposition retaining the polynomial-dependence
information supplied by Mathlib. -/
public structure JordanDecomposition (T : _root_.Module.End K M) where
  nilpotentPart : _root_.Module.End K M
  semisimplePart : _root_.Module.End K M
  nilpotent_mem : nilpotentPart ∈ K[T]
  semisimple_mem : semisimplePart ∈ K[T]
  nilpotent : IsNilpotent nilpotentPart
  semisimple : semisimplePart.IsSemisimple
  eq_add : T = nilpotentPart + semisimplePart

variable [FiniteDimensional K M]

public lemma exists_jordanDecomposition (T : _root_.Module.End K M) :
    Nonempty (JordanDecomposition T) := by
  rcases T.exists_isNilpotent_isSemisimple with ⟨n, hn, s, hs, hn_nil, hs_ss, hT⟩
  exact ⟨⟨n, s, hn, hs, hn_nil, hs_ss, hT⟩⟩

public noncomputable def jordanDecomposition (T : _root_.Module.End K M) : JordanDecomposition T :=
  Classical.choice (exists_jordanDecomposition T)

omit [PerfectField K] [FiniteDimensional K M] in
public lemma JordanDecomposition.commute (T : _root_.Module.End K M) (d : JordanDecomposition T) :
    Commute d.nilpotentPart d.semisimplePart := by
  change d.nilpotentPart * d.semisimplePart = d.semisimplePart * d.nilpotentPart
  exact setLike_mul_comm d.nilpotent_mem d.semisimple_mem

omit [PerfectField K] [FiniteDimensional K M] in
public lemma mem_invtSubmodule_of_mem_adjoin {T S : _root_.Module.End K M} {P : Submodule K M}
    (hP : P ∈ T.invtSubmodule) (hS : S ∈ K[T]) :
    P ∈ S.invtSubmodule := by
  induction hS using Algebra.adjoin_induction with
  | mem x hx =>
      simp only [Set.mem_singleton_iff] at hx
      simpa [hx] using hP
  | algebraMap r =>
      intro x hx
      simpa [Module.algebraMap_end_apply] using P.smul_mem r hx
  | add x y _ _ hx hy =>
      intro z hz
      exact P.add_mem (hx hz) (hy hz)
  | mul x y _ _ hx hy =>
      intro z hz
      exact hx (hy hz)

variable {K : Type u} [Field K] [PerfectField K]
variable {M : Type v} [AddCommGroup M] [Module K M] [FiniteDimensional K M]

/-- The uniqueness data of a Jordan--Chevalley decomposition, without the
polynomial-dependence fields needed for invariant-subspace descent. -/
public structure JordanPair (T : _root_.Module.End K M) where
  nilpotentPart : _root_.Module.End K M
  semisimplePart : _root_.Module.End K M
  nilpotent : IsNilpotent nilpotentPart
  semisimple : semisimplePart.IsSemisimple
  commute : Commute nilpotentPart semisimplePart
  eq_add : T = nilpotentPart + semisimplePart

omit [PerfectField K] [FiniteDimensional K M] in
public lemma JordanPair.commute_semisimplePart {T : _root_.Module.End K M}
    (dT : JordanPair T) : Commute T dT.semisimplePart := by
  change T * dT.semisimplePart = dT.semisimplePart * T
  calc
    T * dT.semisimplePart =
        (dT.nilpotentPart + dT.semisimplePart) * dT.semisimplePart :=
      congrArg (fun A => A * dT.semisimplePart) dT.eq_add
    _ = dT.semisimplePart *
        (dT.nilpotentPart + dT.semisimplePart) :=
      (dT.commute.add_left (Commute.refl dT.semisimplePart)).eq
    _ = dT.semisimplePart * T :=
      congrArg (fun A => dT.semisimplePart * A) dT.eq_add.symm

omit [PerfectField K] [FiniteDimensional K M] in
public lemma JordanPair.semisimplePart_injective {T : _root_.Module.End K M}
    (d : JordanPair T) (hT : Function.Injective T) :
    Function.Injective d.semisimplePart := by
  rw [← LinearMap.ker_eq_bot]
  let P : Submodule K M := LinearMap.ker d.semisimplePart
  have hPn : P ∈ d.nilpotentPart.invtSubmodule := by
    intro x hx
    rw [LinearMap.mem_ker] at hx
    change d.semisimplePart (d.nilpotentPart x) = 0
    have h := LinearMap.congr_fun d.commute.eq x
    simpa [hx] using h.symm
  have hPT : P ∈ T.invtSubmodule := by
    intro x hx
    rw [LinearMap.mem_ker] at hx
    change d.semisimplePart (T x) = 0
    have hcomm := d.commute_semisimplePart
    change T.comp d.semisimplePart = d.semisimplePart.comp T at hcomm
    have h := LinearMap.congr_fun hcomm x
    simpa [hx] using h.symm
  let nP : _root_.Module.End K P := d.nilpotentPart.restrict hPn
  let tP : _root_.Module.End K P := T.restrict hPT
  have hEq : tP = nP := by
    ext x
    change T x.1 = d.nilpotentPart x.1
    have hx : d.semisimplePart x.1 = 0 := x.2
    have h := LinearMap.congr_fun d.eq_add x.1
    rw [h, LinearMap.add_apply, hx, add_zero]
  have hnP : IsNilpotent nP := isNilpotent.restrict hPn d.nilpotent
  have htP : IsNilpotent tP := hEq ▸ hnP
  have htP_inj : Function.Injective tP := by
    intro x y hxy
    apply Subtype.ext
    exact hT (congrArg Subtype.val hxy)
  apply le_antisymm
  · intro x hx
    let xP : P := ⟨x, hx⟩
    rcases htP with ⟨n, hn⟩
    have hpow_inj : Function.Injective (tP ^ n) :=
      Module.End.iterate_injective htP_inj n
    have hxP : xP = 0 := by
      apply hpow_inj
      rw [hn]
      simp
    show x = 0
    simpa [xP] using congrArg Subtype.val hxP
  · exact bot_le

public noncomputable def JordanPair.semisimpleEquiv {T : _root_.Module.End K M}
    (d : JordanPair T) (hT : Function.Injective T) : M ≃ₗ[K] M :=
  LinearEquiv.ofBijective d.semisimplePart
    ⟨d.semisimplePart_injective hT,
      LinearMap.injective_iff_surjective.mp (d.semisimplePart_injective hT)⟩

public noncomputable def JordanPair.unipotentPart {T : _root_.Module.End K M}
    (d : JordanPair T) (hT : Function.Injective T) : _root_.Module.End K M :=
  (d.semisimpleEquiv hT).symm.toLinearMap.comp T

omit [PerfectField K] in
public lemma JordanPair.semisimple_comp_unipotentPart {T : _root_.Module.End K M}
    (d : JordanPair T) (hT : Function.Injective T) :
    d.semisimplePart.comp (d.unipotentPart hT) = T := by
  ext x
  change d.semisimplePart ((d.semisimpleEquiv hT).symm (T x)) = T x
  exact (d.semisimpleEquiv hT).apply_symm_apply (T x)

omit [PerfectField K] in
public lemma JordanPair.unipotentPart_comp_semisimple {T : _root_.Module.End K M}
    (d : JordanPair T) (hT : Function.Injective T) :
    (d.unipotentPart hT).comp d.semisimplePart = T := by
  ext x
  change (d.semisimpleEquiv hT).symm (T (d.semisimplePart x)) = T x
  have hcomm := d.commute_semisimplePart
  change T.comp d.semisimplePart = d.semisimplePart.comp T at hcomm
  have hcommx : T (d.semisimplePart x) = d.semisimplePart (T x) := by
    simpa using LinearMap.congr_fun hcomm x
  rw [hcommx]
  exact (d.semisimpleEquiv hT).symm_apply_apply (T x)

omit [PerfectField K] in
public lemma JordanPair.commute_multiplicativeParts {T : _root_.Module.End K M}
    (d : JordanPair T) (hT : Function.Injective T) :
    Commute d.semisimplePart (d.unipotentPart hT) := by
  change d.semisimplePart.comp (d.unipotentPart hT) =
    (d.unipotentPart hT).comp d.semisimplePart
  rw [d.semisimple_comp_unipotentPart hT,
    d.unipotentPart_comp_semisimple hT]

omit [PerfectField K] in
public lemma JordanPair.commute_semisimpleEquiv_symm_nilpotentPart
    {T : _root_.Module.End K M} (d : JordanPair T) (hT : Function.Injective T) :
    Commute (d.semisimpleEquiv hT).symm.toLinearMap d.nilpotentPart := by
  let se : M ≃ₗ[K] M := d.semisimpleEquiv hT
  change se.symm.toLinearMap.comp d.nilpotentPart =
    d.nilpotentPart.comp se.symm.toLinearMap
  apply LinearMap.ext
  intro x
  apply se.injective
  simp only [LinearMap.comp_apply, LinearEquiv.coe_toLinearMap]
  rw [LinearEquiv.apply_symm_apply]
  -- goal: n x = se (n (se.symm x))
  have hcomm : d.nilpotentPart.comp (se : M →ₗ[K] M) =
      (se : M →ₗ[K] M).comp d.nilpotentPart := by
    rw [← Module.End.mul_eq_comp, ← Module.End.mul_eq_comp]
    change d.nilpotentPart * d.semisimplePart = d.semisimplePart * d.nilpotentPart
    exact d.commute.eq
  have h := LinearMap.congr_fun hcomm (se.symm x)
  simp only [LinearMap.comp_apply, LinearEquiv.coe_toLinearMap] at h
  rw [LinearEquiv.apply_symm_apply] at h
  exact h

omit [PerfectField K] in
public lemma JordanPair.unipotentPart_sub_one {T : _root_.Module.End K M}
    (d : JordanPair T) (hT : Function.Injective T) :
    d.unipotentPart hT - 1 =
      (d.semisimpleEquiv hT).symm.toLinearMap.comp d.nilpotentPart := by
  ext x
  change (d.semisimpleEquiv hT).symm (T x) - x =
    (d.semisimpleEquiv hT).symm (d.nilpotentPart x)
  have hTadd := LinearMap.congr_fun d.eq_add x
  rw [hTadd, LinearMap.add_apply, LinearEquiv.map_add]
  rw [show (d.semisimpleEquiv hT).symm (d.semisimplePart x) = x from
    (d.semisimpleEquiv hT).symm_apply_apply x]
  abel

omit [PerfectField K] in
public lemma JordanPair.unipotentPart_isUnipotent {T : _root_.Module.End K M}
    (d : JordanPair T) (hT : Function.Injective T) :
    IsNilpotent (d.unipotentPart hT - 1) := by
  rw [d.unipotentPart_sub_one hT]
  rw [← Module.End.mul_eq_comp]
  exact (d.commute_semisimpleEquiv_symm_nilpotentPart hT).isNilpotent_mul_left
    d.nilpotent

/-- A finite-dimensional multiplicative Jordan pair. -/
public structure MultiplicativeJordanPair (T : _root_.Module.End K M) where
  semisimplePart : _root_.Module.End K M
  unipotentPart : _root_.Module.End K M
  semisimple : semisimplePart.IsSemisimple
  unipotent : IsNilpotent (unipotentPart - 1)
  commute : Commute semisimplePart unipotentPart
  eq_mul : T = semisimplePart * unipotentPart

@[expose]
public noncomputable def JordanPair.toMultiplicativeJordanPair {T : _root_.Module.End K M}
    (d : JordanPair T) (hT : Function.Injective T) :
    MultiplicativeJordanPair T where
  semisimplePart := d.semisimplePart
  unipotentPart := d.unipotentPart hT
  semisimple := d.semisimple
  unipotent := d.unipotentPart_isUnipotent hT
  commute := d.commute_multiplicativeParts hT
  eq_mul := by
    rw [Module.End.mul_eq_comp]
    exact (d.semisimple_comp_unipotentPart hT).symm

omit [PerfectField K] [FiniteDimensional K M] in
public lemma MultiplicativeJordanPair.nilpotent_additivePart {T : _root_.Module.End K M}
    (d : MultiplicativeJordanPair T) :
    IsNilpotent (d.semisimplePart * (d.unipotentPart - 1)) :=
  (d.commute.sub_right (Commute.one_right _)).isNilpotent_mul_left d.unipotent

public def MultiplicativeJordanPair.toJordanPair {T : _root_.Module.End K M}
    (d : MultiplicativeJordanPair T) : JordanPair T where
  nilpotentPart := d.semisimplePart * (d.unipotentPart - 1)
  semisimplePart := d.semisimplePart
  nilpotent := d.nilpotent_additivePart
  semisimple := d.semisimple
  commute := by
    let V := d.unipotentPart - 1
    have hSV : Commute d.semisimplePart V :=
      d.commute.sub_right (Commute.one_right _)
    change Commute (d.semisimplePart * V) d.semisimplePart
    calc
      (d.semisimplePart * V) * d.semisimplePart =
          d.semisimplePart * (V * d.semisimplePart) := mul_assoc _ _ _
      _ = d.semisimplePart * (d.semisimplePart * V) :=
        congrArg (fun z => d.semisimplePart * z) hSV.eq.symm
      _ = d.semisimplePart * d.semisimplePart * V := (mul_assoc _ _ _).symm
  eq_add := by
    calc
      T = d.semisimplePart * d.unipotentPart := d.eq_mul
      _ = d.semisimplePart * (d.unipotentPart - 1) +
          d.semisimplePart := by noncomm_ring

public lemma MultiplicativeJordanPair.semisimplePart_unique {T : _root_.Module.End K M}
    (d e : MultiplicativeJordanPair T) :
    d.semisimplePart = e.semisimplePart := by
  have h := isNilpotent_isSemisimple_unique
    d.toJordanPair.nilpotent d.toJordanPair.semisimple
    e.toJordanPair.nilpotent e.toJordanPair.semisimple
    d.toJordanPair.commute e.toJordanPair.commute
    (d.toJordanPair.eq_add.symm.trans e.toJordanPair.eq_add)
  simpa [MultiplicativeJordanPair.toJordanPair] using h.2

variable {K : Type u} [Field K] [PerfectField K]
variable {M : Type v} [AddCommGroup M] [Module K M] [FiniteDimensional K M]
variable {N : Type*} [AddCommGroup N] [Module K N] [FiniteDimensional K N]

omit [FiniteDimensional K M] in
@[expose]
public def JordanDecomposition.toJordanPair {T : _root_.Module.End K M}
    (d : JordanDecomposition T) : JordanPair T where
  nilpotentPart := d.nilpotentPart
  semisimplePart := d.semisimplePart
  nilpotent := d.nilpotent
  semisimple := d.semisimple
  commute := d.commute T
  eq_add := d.eq_add

omit [FiniteDimensional K M] in
public lemma JordanPair.semiconj_of_linearEquiv
    {T : _root_.Module.End K M} {U : _root_.Module.End K N} (dT : JordanPair T)
    (dU : JordanPair U) (e : M ≃ₗ[K] N)
    (he : e.toLinearMap.comp T = U.comp e.toLinearMap) :
    e.toLinearMap.comp dT.semisimplePart =
      dU.semisimplePart.comp e.toLinearMap := by
  let n' : _root_.Module.End K N := e.conj dT.nilpotentPart
  let s' : _root_.Module.End K N := e.conj dT.semisimplePart
  have hn' : IsNilpotent n' := by
    exact dT.nilpotent.map e.conjRingEquiv
  have hs_intertwine : e.toLinearMap.comp dT.semisimplePart =
      s'.comp e.toLinearMap := by
    ext x
    simp [s', LinearEquiv.conj_apply]
  have hs' : s'.IsSemisimple :=
    (e.isSemisimple_iff dT.semisimplePart s' hs_intertwine).mp dT.semisimple
  have hc' : Commute n' s' := by
    exact dT.commute.map e.conjRingEquiv
  have hsum' : n' + s' = U := by
    ext y
    calc
      (n' + s') y = e (T (e.symm y)) := by
        simp [n', s', LinearEquiv.conj_apply, dT.eq_add]
      _ = U (e (e.symm y)) := LinearMap.congr_fun he (e.symm y)
      _ = U y := by simp
  have huniq := isNilpotent_isSemisimple_unique hn' hs'
    dU.nilpotent dU.semisimple hc' dU.commute (hsum'.trans dU.eq_add)
  rw [← huniq.2]
  exact hs_intertwine

omit [FiniteDimensional K M] in
public lemma JordanDecomposition.semiconj_of_linearEquiv
    {T : _root_.Module.End K M} {U : _root_.Module.End K N} (dT : JordanDecomposition T)
    (dU : JordanDecomposition U) (e : M ≃ₗ[K] N)
    (he : e.toLinearMap.comp T = U.comp e.toLinearMap) :
    e.toLinearMap.comp dT.semisimplePart =
      dU.semisimplePart.comp e.toLinearMap :=
  dT.toJordanPair.semiconj_of_linearEquiv dU.toJordanPair e he

omit [FiniteDimensional K N] in
public lemma JordanDecomposition.semiconj_of_injective
    {T : _root_.Module.End K M} {U : _root_.Module.End K N} (dT : JordanDecomposition T)
    (dU : JordanDecomposition U) (L : M →ₗ[K] N)
    (hL : Function.Injective L)
    (hTU : L.comp T = U.comp L) :
    L.comp dT.semisimplePart = dU.semisimplePart.comp L := by
  let R : Submodule K N := LinearMap.range L
  have hR : R ∈ U.invtSubmodule := by
    rintro y ⟨x, rfl⟩
    exact ⟨T x, LinearMap.congr_fun hTU x⟩
  have hRn : R ∈ dU.nilpotentPart.invtSubmodule :=
    mem_invtSubmodule_of_mem_adjoin hR dU.nilpotent_mem
  have hRs : R ∈ dU.semisimplePart.invtSubmodule :=
    mem_invtSubmodule_of_mem_adjoin hR dU.semisimple_mem
  let nR : _root_.Module.End K R := dU.nilpotentPart.restrict hRn
  let sR : _root_.Module.End K R := dU.semisimplePart.restrict hRs
  have hnR : IsNilpotent nR := isNilpotent.restrict hRn dU.nilpotent
  have hsR : sR.IsSemisimple := dU.semisimple.restrict hRs
  have hcR : Commute nR sR :=
    LinearMap.restrict_commute (dU.commute U) hRn hRs
  have hsumR : U.restrict (p := R) (q := R) hR = nR + sR := by
    ext x
    exact LinearMap.congr_fun dU.eq_add x
  let e : M ≃ₗ[K] R := LinearEquiv.ofInjective L hL
  have heT : e.toLinearMap.comp T =
      (U.restrict (p := R) (q := R) hR).comp e.toLinearMap := by
    ext x
    exact LinearMap.congr_fun hTU x
  let dR : JordanPair (U.restrict (p := R) (q := R) hR) :=
    { nilpotentPart := nR
      semisimplePart := sR
      nilpotent := hnR
      semisimple := hsR
      commute := hcR
      eq_add := hsumR }
  have heS := dT.toJordanPair.semiconj_of_linearEquiv dR e heT
  ext x
  have hx := LinearMap.congr_fun heS x
  exact congrArg Subtype.val hx

variable [IsAlgClosed K]

omit [PerfectField K] [FiniteDimensional K M] [FiniteDimensional K N] [IsAlgClosed K] in
public lemma mapsTo_maxGenEigenspace_of_semiconj
    {T : _root_.Module.End K M} {U : _root_.Module.End K N} (L : M →ₗ[K] N)
    (hTU : L.comp T = U.comp L) (mu : K) :
    Set.MapsTo L (T.maxGenEigenspace mu) (U.maxGenEigenspace mu) := by
  intro x hx
  have hx' := (T.mem_maxGenEigenspace mu x).mp hx
  apply (U.mem_maxGenEigenspace mu (L x)).mpr
  rcases hx' with ⟨n, hn⟩
  refine ⟨n, ?_⟩
  have hshift : L.comp (T - mu • 1) = (U - mu • 1).comp L := by
    ext y
    have hTy : L (T y) = U (L y) := LinearMap.congr_fun hTU y
    simp only [LinearMap.comp_apply, LinearMap.sub_apply, LinearMap.smul_apply,
      one_apply, map_sub, map_smul]
    rw [hTy]
  have hp := Module.End.commute_pow_left_of_commute hshift.symm n
  have hy := LinearMap.congr_fun hp x
  simpa [hn] using hy

omit [PerfectField K] [FiniteDimensional K M] [IsAlgClosed K] in
public lemma JordanPair.semisimplePart_apply_of_mem_maxGenEigenspace
    {T : _root_.Module.End K M} (dT : JordanPair T) (mu : K) (x : M)
    (hx : x ∈ T.maxGenEigenspace mu) :
    dT.semisimplePart x = mu • x := by
  apply apply_eq_of_mem_of_comm_of_isFinitelySemisimple_of_isNil hx
  · exact calc
      T * dT.semisimplePart =
          (dT.nilpotentPart + dT.semisimplePart) * dT.semisimplePart :=
        congrArg (fun A => A * dT.semisimplePart) dT.eq_add
      _ = dT.semisimplePart *
          (dT.nilpotentPart + dT.semisimplePart) :=
        (dT.commute.add_left (Commute.refl dT.semisimplePart)).eq
      _ = dT.semisimplePart * T :=
        congrArg (fun A => dT.semisimplePart * A) dT.eq_add.symm
  · exact dT.semisimple.isFinitelySemisimple
  · have hsub : T - dT.semisimplePart = dT.nilpotentPart := by
      calc
        T - dT.semisimplePart =
            (dT.nilpotentPart + dT.semisimplePart) - dT.semisimplePart :=
          congrArg (fun A => A - dT.semisimplePart) dT.eq_add
        _ = dT.nilpotentPart := by abel
    simpa only [hsub] using dT.nilpotent

omit [PerfectField K] [FiniteDimensional K N] in
public lemma JordanPair.semiconj
    {T : _root_.Module.End K M} {U : _root_.Module.End K N} (dT : JordanPair T)
    (dU : JordanPair U) (L : M →ₗ[K] N)
    (hTU : L.comp T = U.comp L) :
    L.comp dT.semisimplePart = dU.semisimplePart.comp L := by
  apply LinearMap.ext
  intro x
  let D : M →ₗ[K] N :=
    L.comp dT.semisimplePart - dU.semisimplePart.comp L
  have htop : ⊤ ≤ LinearMap.ker D := by
    rw [← iSup_maxGenEigenspace_eq_top T]
    refine iSup_le fun mu => ?_
    intro y hy
    rw [LinearMap.mem_ker]
    change L (dT.semisimplePart y) - dU.semisimplePart (L y) = 0
    have hLy : L y ∈ U.maxGenEigenspace mu :=
      mapsTo_maxGenEigenspace_of_semiconj L hTU mu hy
    rw [dT.semisimplePart_apply_of_mem_maxGenEigenspace mu y hy,
      dU.semisimplePart_apply_of_mem_maxGenEigenspace mu (L y) hLy,
      map_smul]
    simp
  have hx : x ∈ LinearMap.ker D := htop (by simp)
  rw [LinearMap.mem_ker] at hx
  exact sub_eq_zero.mp hx

open scoped TensorProduct

omit [PerfectField K] [FiniteDimensional K N] [IsAlgClosed K] in
public lemma IsSemisimple.rTensor {T : _root_.Module.End K M} (hT : T.IsSemisimple) :
    Module.End.IsSemisimple (T.rTensor N : _root_.Module.End K (M ⊗[K] N)) := by
  apply isSemisimple_of_squarefree_aeval_eq_zero hT.minpoly_squarefree
  change Polynomial.aeval ((Module.End.rTensorAlgHom K M N) T)
    (minpoly K T) = 0
  rw [Polynomial.aeval_algHom_apply (Module.End.rTensorAlgHom K M N),
    minpoly.aeval, map_zero]

omit [PerfectField K] [FiniteDimensional K M] [IsAlgClosed K] in
public lemma IsSemisimple.lTensor {T : _root_.Module.End K N} (hT : T.IsSemisimple) :
    Module.End.IsSemisimple (T.lTensor M : _root_.Module.End K (M ⊗[K] N)) := by
  apply isSemisimple_of_squarefree_aeval_eq_zero hT.minpoly_squarefree
  change Polynomial.aeval ((Module.End.lTensorAlgHom K N M) T)
    (minpoly K T) = 0
  rw [Polynomial.aeval_algHom_apply (Module.End.lTensorAlgHom K N M),
    minpoly.aeval, map_zero]

omit [PerfectField K] [FiniteDimensional K M] [FiniteDimensional K N] [IsAlgClosed K] in
public lemma commute_lTensor_rTensor (T : _root_.Module.End K M) (U : _root_.Module.End K N) :
    Commute (U.lTensor M) (T.rTensor N) := by
  change (U.lTensor M) * (T.rTensor N) =
    (T.rTensor N) * (U.lTensor M)
  rw [Module.End.mul_eq_comp, Module.End.mul_eq_comp,
    LinearMap.lTensor_comp_rTensor, LinearMap.rTensor_comp_lTensor]

omit [PerfectField K] [FiniteDimensional K M] [IsAlgClosed K] in
public lemma JordanPair.commute_nilpotentPart {T : _root_.Module.End K M}
    (dT : JordanPair T) : Commute T dT.nilpotentPart := by
  change T * dT.nilpotentPart = dT.nilpotentPart * T
  calc
    T * dT.nilpotentPart =
        (dT.nilpotentPart + dT.semisimplePart) * dT.nilpotentPart :=
      congrArg (fun A => A * dT.nilpotentPart) dT.eq_add
    _ = dT.nilpotentPart *
        (dT.nilpotentPart + dT.semisimplePart) :=
      ((Commute.refl dT.nilpotentPart).add_left dT.commute.symm).eq
    _ = dT.nilpotentPart * T :=
      congrArg (fun A => dT.nilpotentPart * A) dT.eq_add.symm

@[expose]
public noncomputable def JordanPair.tensorProduct
    {T : _root_.Module.End K M} {U : _root_.Module.End K N} (dT : JordanPair T) (dU : JordanPair U) :
    JordanPair (TensorProduct.map T U) := by
  let nUl : _root_.Module.End K (M ⊗[K] N) := dU.nilpotentPart.lTensor M
  let sUl : _root_.Module.End K (M ⊗[K] N) := dU.semisimplePart.lTensor M
  let tUl : _root_.Module.End K (M ⊗[K] N) := U.lTensor M
  let nTr : _root_.Module.End K (M ⊗[K] N) := dT.nilpotentPart.rTensor N
  let sTr : _root_.Module.End K (M ⊗[K] N) := dT.semisimplePart.rTensor N
  let tTr : _root_.Module.End K (M ⊗[K] N) := T.rTensor N
  let A : _root_.Module.End K (M ⊗[K] N) := nUl * tTr
  let B : _root_.Module.End K (M ⊗[K] N) := sUl * nTr
  let S : _root_.Module.End K (M ⊗[K] N) := TensorProduct.map dT.semisimplePart dU.semisimplePart
  have htensor : TensorProduct.map T U = tUl * tTr := by
    dsimp [tUl, tTr]
    rw [Module.End.mul_eq_comp, LinearMap.lTensor_comp_rTensor]
  have hsemisimpleTensor : S = sUl * sTr := by
    dsimp [S, sUl, sTr]
    rw [Module.End.mul_eq_comp, LinearMap.lTensor_comp_rTensor]
  have hUl : tUl = nUl + sUl := by
    dsimp [tUl, nUl, sUl]
    calc
      U.lTensor M =
          (dU.nilpotentPart + dU.semisimplePart).lTensor M :=
        congrArg (fun F : _root_.Module.End K N => F.lTensor M) dU.eq_add
      _ = dU.nilpotentPart.lTensor M + dU.semisimplePart.lTensor M :=
        LinearMap.lTensor_add M _ _
  have hTr : tTr = nTr + sTr := by
    dsimp [tTr, nTr, sTr]
    calc
      T.rTensor N =
          (dT.nilpotentPart + dT.semisimplePart).rTensor N :=
        congrArg (fun F : _root_.Module.End K M => F.rTensor N) dT.eq_add
      _ = dT.nilpotentPart.rTensor N + dT.semisimplePart.rTensor N :=
        LinearMap.rTensor_add N _ _
  have hdiff : TensorProduct.map T U - S = A + B := by
    rw [htensor, hsemisimpleTensor]
    dsimp [A, B]
    rw [hUl, hTr]
    noncomm_ring
  have hnUl : IsNilpotent nUl := by
    exact dU.nilpotent.map (Module.End.lTensorAlgHom K N M)
  have hnTr : IsNilpotent nTr := by
    exact dT.nilpotent.map (Module.End.rTensorAlgHom K M N)
  have hcross_nUl_tTr : Commute nUl tTr := by
    exact commute_lTensor_rTensor T dU.nilpotentPart
  have hcross_sUl_nTr : Commute sUl nTr := by
    exact commute_lTensor_rTensor dT.nilpotentPart dU.semisimplePart
  have hA : IsNilpotent A := by
    exact hcross_nUl_tTr.isNilpotent_mul_right hnUl
  have hB : IsNilpotent B := by
    exact hcross_sUl_nTr.isNilpotent_mul_left hnTr
  have hnUsU : Commute nUl sUl := by
    exact dU.commute.map (Module.End.lTensorAlgHom K N M)
  have hnUnT : Commute nUl nTr := by
    exact commute_lTensor_rTensor dT.nilpotentPart dU.nilpotentPart
  have hTsU : Commute tTr sUl := by
    exact (commute_lTensor_rTensor T dU.semisimplePart).symm
  have hTnT : Commute tTr nTr := by
    exact dT.commute_nilpotentPart.map (Module.End.rTensorAlgHom K M N)
  have hAB : Commute A B := by
    dsimp [A, B]
    exact (hnUsU.mul_right hnUnT).mul_left (hTsU.mul_right hTnT)
  have hn : IsNilpotent (TensorProduct.map T U - S) := by
    rw [hdiff]
    exact hAB.isNilpotent_add hA hB
  have hsUl : sUl.IsSemisimple := by
    exact IsSemisimple.lTensor dU.semisimple
  have hsTr : sTr.IsSemisimple := by
    exact IsSemisimple.rTensor dT.semisimple
  have hcross_s : Commute sUl sTr :=
    commute_lTensor_rTensor dT.semisimplePart dU.semisimplePart
  have hs : S.IsSemisimple := by
    rw [hsemisimpleTensor]
    exact Module.End.IsSemisimple.mul_of_commute hcross_s hsUl hsTr
  have hUsU : Commute tUl sUl := by
    exact dU.commute_semisimplePart.map (Module.End.lTensorAlgHom K N M)
  have hUsT : Commute tUl sTr :=
    commute_lTensor_rTensor dT.semisimplePart U
  have hTsU' : Commute tTr sUl :=
    (commute_lTensor_rTensor T dU.semisimplePart).symm
  have hTsT : Commute tTr sTr := by
    exact dT.commute_semisimplePart.map (Module.End.rTensorAlgHom K M N)
  have hTS : Commute (TensorProduct.map T U) S := by
    rw [htensor, hsemisimpleTensor]
    exact (hUsU.mul_right hUsT).mul_left (hTsU'.mul_right hTsT)
  exact
    { nilpotentPart := TensorProduct.map T U - S
      semisimplePart := S
      nilpotent := hn
      semisimple := hs
      commute := hTS.sub_left (Commute.refl S)
      eq_add := by abel }

variable {K : Type u} [Field K] [PerfectField K]
variable {M : Type v} [AddCommGroup M] [Module K M] [FiniteDimensional K M]

@[expose]
public noncomputable def invariantJordanDecomposition (T : _root_.Module.End K M)
    (P : Submodule K M) (hP : P ∈ T.invtSubmodule) [Module.Finite K P] :
    JordanDecomposition (T.restrict (p := P) (q := P) hP) :=
  jordanDecomposition _

omit [FiniteDimensional K M] in
public lemma invariantJordanDecomposition_semisimple_mono
    (T : _root_.Module.End K M) (P Q : Submodule K M)
    (hP : P ∈ T.invtSubmodule) (hQ : Q ∈ T.invtSubmodule)
    [Module.Finite K P] [Module.Finite K Q] (hPQ : P ≤ Q) :
    (Submodule.inclusion hPQ).comp
        (invariantJordanDecomposition T P hP).semisimplePart =
      (invariantJordanDecomposition T Q hQ).semisimplePart.comp
        (Submodule.inclusion hPQ) := by
  apply JordanDecomposition.semiconj_of_injective
  · exact Submodule.inclusion_injective hPQ
  · ext x
    rfl

omit [FiniteDimensional K M] in
public lemma invariantJordanDecomposition_semisimple_mono_apply
    (T : _root_.Module.End K M) (P Q : Submodule K M)
    (hP : P ∈ T.invtSubmodule) (hQ : Q ∈ T.invtSubmodule)
    [Module.Finite K P] [Module.Finite K Q] (hPQ : P ≤ Q) (x : M) (hx : x ∈ P) :
    P.subtype ((invariantJordanDecomposition T P hP).semisimplePart ⟨x, hx⟩) =
      Q.subtype ((invariantJordanDecomposition T Q hQ).semisimplePart ⟨x, hPQ hx⟩) := by
  have h := LinearMap.congr_fun
    (invariantJordanDecomposition_semisimple_mono T P Q hP hQ hPQ) ⟨x, hx⟩
  exact congrArg Subtype.val h

end Module.End

end Theory.AlgebraicGroup
