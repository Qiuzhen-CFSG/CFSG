module

public import Theory.AlgebraicGroup.Jordan.LocallyFinite
public import Theory.AlgebraicGroup.Jordan.LocallyFiniteEndomorphism
public import Theory.AlgebraicGroup.Jordan.Translation

universe u

/-! Jordan decomposition of algebraic-group elements, following GLS Proposition 1.2.2(d). -/

namespace Theory.AlgebraicGroup

open LinearMap _root_.Theory.AlgebraicGroup.Submodule Polynomial

variable {k : Type u} [Field k] [IsAlgClosed k]

private lemma semisimplePart_mem_cyclicSubmodule
    {M : Type*} [AddCommGroup M] [Module k M]
    {T : Module.End k M} (hT : Module.End.IsLocallyFinite T) (x : M) :
    hT.semisimplePart x ∈ Module.End.cyclicSubmodule T x := by
  let P : Submodule k M := Module.End.cyclicSubmodule T x
  have hP : P ∈ T.invtSubmodule :=
    Module.End.cyclicSubmodule_mem_invtSubmodule T x
  let W : Submodule k M := hT.submodule x
  let : Module.Finite k W := hT.finite x
  have hPW : P ≤ W := Module.End.cyclicSubmodule_le_of_mem
    (hT.invariant x) (hT.mem x)
  let : Module.Finite k P := Module.Finite.of_injective
    (Submodule.inclusion hPW) (Submodule.inclusion_injective hPW)
  exact hT.semisimplePart_mem_invtSubmodule P hP
    (Module.End.mem_cyclicSubmodule T x)

private lemma unipotentPart_mem_cyclicSubmodule
    {M : Type*} [AddCommGroup M] [Module k M]
    {T : Module.End k M} (hT : Module.End.IsLocallyFinite T)
    (hTin : Function.Injective T) (x : M) :
    hT.unipotentPart hTin x ∈ Module.End.cyclicSubmodule T x := by
  let P : Submodule k M := Module.End.cyclicSubmodule T x
  have hP : P ∈ T.invtSubmodule :=
    Module.End.cyclicSubmodule_mem_invtSubmodule T x
  let W : Submodule k M := hT.submodule x
  let : Module.Finite k W := hT.finite x
  have hPW : P ≤ W := Module.End.cyclicSubmodule_le_of_mem
    (hT.invariant x) (hT.mem x)
  let : Module.Finite k P := Module.Finite.of_injective
    (Submodule.inclusion hPW) (Submodule.inclusion_injective hPW)
  exact hT.unipotentPart_mem_invtSubmodule hTin P hP
    (Module.End.mem_cyclicSubmodule T x)

omit [IsAlgClosed k] in
/-- If right translation by `a` sends every polynomial function into its
cyclic subspace for right translation by `g`, then `a` belongs to the
Zariski closure of the cyclic subgroup generated by `g`. -/
private lemma point_mem_closure_zpowers_of_pullback_mem_cyclic
    {G : Variety k} [AlgebraicGroup G] (g a : Variety.Point G)
    (ha : ∀ f : Variety.PolynomialFunction G,
      rightTranslationPullback G a f ∈
        Module.End.cyclicSubmodule (rightTranslationPullback G g) f) :
    a ∈ closure (Subgroup.zpowers g : Set (Variety.Point G)) := by
  let C : Set (Variety.Point G) :=
    closure (Subgroup.zpowers g : Set (Variety.Point G))
  have hCz : IsZariskiClosed G C :=
    Variety.isClosed_iff_isZariskiClosed.mp isClosed_closure
  change a ∈ C
  rw [← zeroLocus_vanishingIdeal hCz]
  intro p hp
  let f : Variety.PolynomialFunction G :=
    Variety.PolynomialFunction.ofPolynomial G p
  let ev : Variety.PolynomialFunction G →ₗ[k] k :=
    (polynomialFunctionPointAlgHom G 1).toLinearMap
  have hcyc : Module.End.cyclicSubmodule
      (rightTranslationPullback G g) f ≤ LinearMap.ker ev := by
    rw [Module.End.cyclicSubmodule, Submodule.span_le]
    rintro y ⟨n, rfl⟩
    change ev (((⇑(rightTranslationPullback G g))^[n]) f) = 0
    change (((⇑(rightTranslationPullback G g))^[n]) f) 1 = 0
    rw [rightTranslationPullback_pow]
    change f (1 * g ^ n) = 0
    rw [one_mul]
    exact hp (g ^ n) (subset_closure
      ((Subgroup.zpowers g).pow_mem (Subgroup.mem_zpowers g) n))
  have hz := hcyc (ha f)
  change ev (rightTranslationPullback G a f) = 0 at hz
  change (rightTranslationPullback G a f) 1 = 0 at hz
  rw [rightTranslationPullback_apply, one_mul] at hz
  exact hz

/-! ## Jordan components -/

/-- A commuting semisimple--unipotent factorization of an algebraic-group
element. -/
public structure JordanDecomposition {G : Variety k} [AlgebraicGroup G]
    (g : Variety.Point G) where
  semisimplePart : Variety.Point G
  unipotentPart : Variety.Point G
  eq_mul : g = semisimplePart * unipotentPart
  commute : Commute semisimplePart unipotentPart
  semisimple : IsSemisimpleElement G semisimplePart
  unipotent : IsUnipotentElement G unipotentPart

/-- The canonical Jordan decomposition from GLS Proposition 1.2.2(d). -/
public noncomputable def jordanDecomposition
    {G : Variety k} [AlgebraicGroup G] (g : Variety.Point G) :
    JordanDecomposition g := by
  let A := Variety.PolynomialFunction G
  let T : Module.End k A := rightTranslationPullback G g
  let TAlg : A →ₐ[k] A :=
    (AlgebraicGroup.rightMulMorphism G g).pullbackAlgHom
  have hTloc : Module.End.IsLocallyFinite T :=
    rightTranslationPullback_locallyFinite G g
  have hTin : Function.Injective T := rightTranslationPullback_injective G g
  have hOne : T 1 = 1 := by
    change TAlg 1 = 1
    exact map_one TAlg
  have hMul : ∀ x y : A, T (x * y) = T x * T y := by
    intro x y
    change TAlg (x * y) = TAlg x * TAlg y
    exact map_mul TAlg x y
  let SAlg : A ≃ₐ[k] A := hTloc.semisimpleAlgEquiv hTin hOne hMul
  have hScomm : ∀ x : Variety.Point G,
      (leftTranslationPullback G x).comp SAlg.toLinearMap =
        SAlg.toLinearMap.comp (leftTranslationPullback G x) := by
    intro x
    have hTL := leftTranslationPullback_comm_rightTranslationPullback G x g
    have hs := hTloc.semisimplePart_semiconj hTloc
      (leftTranslationPullback G x) (by simpa [T] using hTL)
    change (leftTranslationPullback G x).comp hTloc.semisimplePart =
      hTloc.semisimplePart.comp (leftTranslationPullback G x)
    exact hs
  let gₛ : Variety.Point G := (polynomialFunctionPointAlgHomEquiv G).symm
    ((polynomialFunctionPointAlgHom G 1).comp SAlg.toAlgHom)
  have hS : SAlg.toLinearMap = rightTranslationPullback G gₛ :=
    algHom_toLinearMap_eq_rightTranslationPullback G SAlg.toAlgHom hScomm
  have hS' : hTloc.semisimplePart = rightTranslationPullback G gₛ := by
    apply LinearMap.ext
    intro f
    exact LinearMap.congr_fun hS f
  let gᵤ : Variety.Point G := gₛ⁻¹ * g
  have hg : gₛ * gᵤ = g := by simp [gᵤ]
  have hU : hTloc.unipotentPart hTin = rightTranslationPullback G gᵤ := by
    apply LinearMap.ext
    intro f
    apply hTloc.semisimplePart_injective hTin
    calc
      hTloc.semisimplePart (hTloc.unipotentPart hTin f) = T f := by
        exact LinearMap.congr_fun
          (hTloc.semisimplePart_comp_unipotentPart hTin) f
      _ = rightTranslationPullback G g f := rfl
      _ = rightTranslationPullback G (gₛ * gᵤ) f := by rw [hg]
      _ = (rightTranslationPullback G gₛ).comp
          (rightTranslationPullback G gᵤ) f := by
            rw [rightTranslationPullback_mul]
      _ = hTloc.semisimplePart (rightTranslationPullback G gᵤ f) := by
        rw [hS']
        rfl
  refine
    { semisimplePart := gₛ
      unipotentPart := gᵤ
      eq_mul := hg.symm
      commute := ?_
      semisimple := ?_
      unipotent := ?_ }
  · have hsg : Commute gₛ g := by
      apply rightTranslationPullback_point_injective G
      rw [rightTranslationPullback_mul, rightTranslationPullback_mul, ← hS']
      exact hTloc.semisimplePart_commute.eq.symm
    change Commute gₛ (gₛ⁻¹ * g)
    change gₛ * (gₛ⁻¹ * g) = (gₛ⁻¹ * g) * gₛ
    calc
      gₛ * (gₛ⁻¹ * g) = g := by group
      _ = (gₛ⁻¹ * g) * gₛ := by
        calc
          g = gₛ⁻¹ * (gₛ * g) := by group
          _ = gₛ⁻¹ * (g * gₛ) := by rw [hsg.eq]
          _ = (gₛ⁻¹ * g) * gₛ := by group
  · change Module.End.IsFinitelySemisimple (rightTranslationPullback G gₛ)
    rw [← hS']
    exact hTloc.semisimplePart_isFinitelySemisimple
  · change ∀ f : A, ∃ n : ℕ,
      (((rightTranslationPullback G gᵤ - 1 : Module.End k A))^[n]) f = 0
    rw [← hU]
    exact hTloc.unipotentPart_isLocallyUnipotent hTin

/-- The semisimple factor realizes the canonical locally finite semisimple
part of right translation. -/
public lemma JordanDecomposition.semisimplePart_pullback
    {G : Variety k} [AlgebraicGroup G] {g : Variety.Point G}
    (d : JordanDecomposition g) :
    Module.End.IsLocallyFinite.semisimplePart
        (rightTranslationPullback_locallyFinite G g) =
      rightTranslationPullback G d.semisimplePart := by
  let T : Module.End k (Variety.PolynomialFunction G) :=
    rightTranslationPullback G g
  let S : Module.End k (Variety.PolynomialFunction G) :=
    rightTranslationPullback G d.semisimplePart
  let U : Module.End k (Variety.PolynomialFunction G) :=
    rightTranslationPullback G d.unipotentPart
  have hTloc : Module.End.IsLocallyFinite T :=
    rightTranslationPullback_locallyFinite G g
  have hSloc : Module.End.IsLocallyFinite S :=
    rightTranslationPullback_locallyFinite G d.semisimplePart
  have hUloc : Module.End.IsLocallyFinite U :=
    rightTranslationPullback_locallyFinite G d.unipotentPart
  have hTin : Function.Injective T := rightTranslationPullback_injective G g
  have hSU : Commute S U := by
    change S.comp U = U.comp S
    rw [← rightTranslationPullback_mul, ← rightTranslationPullback_mul]
    exact congrArg (rightTranslationPullback G) d.commute.eq
  have hmul : T = S * U := by
    change T = S.comp U
    rw [← rightTranslationPullback_mul]
    exact congrArg (rightTranslationPullback G) d.eq_mul
  exact hTloc.semisimplePart_eq_of_multiplicativeJordan hSloc hUloc hTin
    d.semisimple d.unipotent hSU hmul

/-- The unipotent factor realizes the canonical locally finite unipotent part
of right translation. -/
public lemma JordanDecomposition.unipotentPart_pullback
    {G : Variety k} [AlgebraicGroup G] {g : Variety.Point G}
    (d : JordanDecomposition g) :
    Module.End.IsLocallyFinite.unipotentPart
        (rightTranslationPullback_locallyFinite G g)
        (rightTranslationPullback_injective G g) =
      rightTranslationPullback G d.unipotentPart := by
  let T : Module.End k (Variety.PolynomialFunction G) :=
    rightTranslationPullback G g
  have hTloc : Module.End.IsLocallyFinite T :=
    rightTranslationPullback_locallyFinite G g
  have hTin : Function.Injective T := rightTranslationPullback_injective G g
  apply LinearMap.ext
  intro f
  apply hTloc.semisimplePart_injective hTin
  calc
    hTloc.semisimplePart (hTloc.unipotentPart hTin f) = T f := by
      exact LinearMap.congr_fun
        (hTloc.semisimplePart_comp_unipotentPart hTin) f
    _ = rightTranslationPullback G g f := rfl
    _ = rightTranslationPullback G
        (d.semisimplePart * d.unipotentPart) f := by rw [← d.eq_mul]
    _ = (rightTranslationPullback G d.semisimplePart).comp
        (rightTranslationPullback G d.unipotentPart) f := by
          rw [rightTranslationPullback_mul]
    _ = hTloc.semisimplePart
        (rightTranslationPullback G d.unipotentPart f) := by
      rw [d.semisimplePart_pullback]
      rfl

/-- The semisimple Jordan component lies in the closure of the cyclic subgroup
generated by the original element. -/
public lemma JordanDecomposition.semisimplePart_mem_closure
    {G : Variety k} [AlgebraicGroup G] {g : Variety.Point G}
    (d : JordanDecomposition g) :
    d.semisimplePart ∈
      closure (Subgroup.zpowers g : Set (Variety.Point G)) := by
  apply point_mem_closure_zpowers_of_pullback_mem_cyclic g d.semisimplePart
  intro f
  rw [← d.semisimplePart_pullback]
  exact semisimplePart_mem_cyclicSubmodule
    (rightTranslationPullback_locallyFinite G g) f

/-- The unipotent Jordan component lies in the closure of the cyclic subgroup
generated by the original element. -/
public lemma JordanDecomposition.unipotentPart_mem_closure
    {G : Variety k} [AlgebraicGroup G] {g : Variety.Point G}
    (d : JordanDecomposition g) :
    d.unipotentPart ∈
      closure (Subgroup.zpowers g : Set (Variety.Point G)) := by
  apply point_mem_closure_zpowers_of_pullback_mem_cyclic g d.unipotentPart
  intro f
  rw [← d.unipotentPart_pullback]
  exact unipotentPart_mem_cyclicSubmodule
    (rightTranslationPullback_locallyFinite G g)
    (rightTranslationPullback_injective G g) f

/-- A commuting semisimple--unipotent factorization is unique. -/
public lemma JordanDecomposition.unique
    {G : Variety k} [AlgebraicGroup G] {g : Variety.Point G}
    (d e : JordanDecomposition g) : d = e := by
  have hs : d.semisimplePart = e.semisimplePart := by
    apply rightTranslationPullback_point_injective G
    rw [← d.semisimplePart_pullback, ← e.semisimplePart_pullback]
  have hprod :
      d.semisimplePart * d.unipotentPart =
        e.semisimplePart * e.unipotentPart :=
    d.eq_mul.symm.trans e.eq_mul
  rw [hs] at hprod
  have hu : d.unipotentPart = e.unipotentPart := mul_left_cancel hprod
  cases d
  cases e
  cases hs
  cases hu
  rfl

omit [IsAlgClosed k] in
/-- The identity element is semisimple. -/
public lemma one_isSemisimpleElement (G : Variety k) [AlgebraicGroup G] :
    IsSemisimpleElement G (1 : Variety.Point G) := by
  change Module.End.IsFinitelySemisimple
    (rightTranslationPullback G (1 : Variety.Point G))
  rw [rightTranslationPullback_one]
  intro P hP hfinite
  let : Module.Finite k P := hfinite
  have hid : LinearMap.restrict
      (1 : Module.End k (Variety.PolynomialFunction G)) hP =
      (1 : Module.End k P) := by
    apply LinearMap.ext
    intro x
    rfl
  have hss : Module.End.IsSemisimple (1 : Module.End k P) :=
    Module.End.isSemisimple_id
  rw [← hid] at hss
  exact hss

omit [IsAlgClosed k] in
/-- The identity element is unipotent. -/
public lemma one_isUnipotentElement (G : Variety k) [AlgebraicGroup G] :
    IsUnipotentElement G (1 : Variety.Point G) := by
  intro f
  refine ⟨1, ?_⟩
  rw [rightTranslationPullback_one]
  simp

end Theory.AlgebraicGroup
