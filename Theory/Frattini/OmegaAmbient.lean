module

public import Theory.Frattini.PGroupMap
public import Theory.GroupTheory.PGroup.OmegaAmbient

/-!
# First omega of a Frattini subgroup in an ambient group

For finite two-groups, homomorphisms carry Frattini subgroups into Frattini
subgroups and involutions to involutions. Their composite therefore respects
inclusions and normalizers. The omega operation is retained explicitly:
Frattini subgroups need not have exponent two.

This supplies the subgroup comparison in the final argument of
Aschbacher–Smith, Theorem 16.3.7, printed p.1182 / PDF p.1199.
-/

@[expose] public section

namespace Subgroup
variable {G H : Type*} [Group G] [Group H]

/-- The subgroup Ω₁(Φ(S)), viewed in the original ambient group. -/
noncomputable def omegaFrattini (S : Subgroup G) : Subgroup G :=
  omegaOneAmbient ((frattini S).map S.subtype)

/-- The omega of the Frattini subgroup lies in its original group. -/
theorem omegaFrattini_le (S : Subgroup G) : S.omegaFrattini ≤ S :=
  (omegaOneAmbient_le _).trans (map_subtype_le _)

/-- Homomorphisms preserve the subgroup generated by involutions. -/
theorem map_omegaOneAmbient_le (f : G →* H) {S : Subgroup G} {R : Subgroup H}
    (h : S.map f ≤ R) : (omegaOneAmbient S).map f ≤ omegaOneAmbient R := by
  rw [map_le_iff_le_comap]
  apply (omegaOneAmbient_le_iff _ _).mpr
  intro x hx hx2
  exact (omegaOneAmbient_le_iff R (omegaOneAmbient R)).mp le_rfl (f x)
    (h (mem_map_of_mem f hx)) (by rw [← map_pow, hx2, map_one])

/-- Homomorphisms between finite two-groups preserve Ω₁(Φ(-)). -/
theorem map_omegaFrattini_le [Finite G] [Finite H]
    (f : G →* H) {S : Subgroup G} {R : Subgroup H}
    (hS : IsPGroup 2 S) (hR : IsPGroup 2 R) (h : S.map f ≤ R) :
    S.omegaFrattini.map f ≤ R.omegaFrattini := by
  let g : S →* R :=
    { toFun := fun x => ⟨f x, h (mem_map_of_mem f x.property)⟩
      map_one' := Subtype.ext (map_one f)
      map_mul' := fun x y => Subtype.ext (map_mul f (x : G) (y : G)) }
  let : Fact (IsPGroup 2 S) := ⟨hS⟩
  let : Fact (IsPGroup 2 R) := ⟨hR⟩
  have hphi : ((frattini S).map S.subtype).map f ≤ (frattini R).map R.subtype := by
    calc
      ((frattini S).map S.subtype).map f = ((frattini S).map g).map R.subtype := by
        rw [map_map, map_map]
        rfl
      _ ≤ (frattini R).map R.subtype := map_mono (frattini_map_le_of_isPGroup (p := 2) g)
  exact map_omegaOneAmbient_le f hphi

/-- Ω₁(Φ(-)) is monotone among finite two-subgroups. -/
theorem omegaFrattini_mono [Finite G] {S R : Subgroup G}
    (hS : IsPGroup 2 S) (hR : IsPGroup 2 R) (h : S ≤ R) :
    S.omegaFrattini ≤ R.omegaFrattini := by
  simpa only [map_id] using map_omegaFrattini_le (MonoidHom.id G) hS hR (by simpa)

/-- Normalizing a finite two-subgroup also normalizes its Ω₁(Φ(-)). -/
theorem normalizer_le_normalizer_omegaFrattini [Finite G]
    (S : Subgroup G) (hS : IsPGroup 2 S) :
    normalizer (S : Set G) ≤ normalizer (S.omegaFrattini : Set G) := by
  apply le_normalizer_iff.mpr
  intro g hg x hx
  have hmap : S.map (MulAut.conj g).toMonoidHom ≤ S :=
    (mem_normalizer_iff_map_conj_eq.mp hg).le
  exact map_omegaFrattini_le (MulAut.conj g).toMonoidHom hS hS hmap
    (mem_map_of_mem (MulAut.conj g).toMonoidHom hx)
end Subgroup
