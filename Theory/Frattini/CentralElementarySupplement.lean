module

public import Theory.Frattini.PGroupMap
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Central elementary supplements preserve the Frattini subgroup

If a finite two-group `Q` is generated by subgroups `Z` and `D`, where `Z`
is elementary abelian and centralizes `Q`, then the ambient images of the
Frattini subgroups of `Q` and `D` coincide. Ambient normality of these
subgroups is not assumed.

The Frattini subgroup of a finite two-group is generated by squares:
commutators are products of squares via
`[a,b] = a² (a⁻¹b)² (b²)⁻¹`. Every element of `Q` factors as `z d`; its
square is `d²` because `z` is a central involution. This proves the forward
inclusion, and Frattini preservation under homomorphisms gives the reverse
inclusion along `D → Q`.

This is the source-neutral Frattini comparison in Stellmacher, *Pushing up*,
Arch. Math. 46 (1986), proof of (3.4)(b), p.16, specialized to two-groups.
-/

open scoped Pointwise commutatorElement

private theorem frattini_map_le_of_square_mem
    {H G : Type*} [Group H] [Group G] [Finite H] [Fact (IsPGroup 2 H)]
    (f : H →* G) (K : Subgroup G) (hsq : ∀ x : H, f x ^ 2 ∈ K) :
    (frattini H).map f ≤ K := by
  rw [Subgroup.map_le_iff_le_comap, frattini_eq_closure_commutator_union_powers (p := 2)]
  apply (Subgroup.closure_le (K := K.comap f)).mpr
  rintro x (hx | ⟨y, rfl⟩)
  · have hcomm : commutator H ≤ K.comap f := by
      rw [commutator_def]
      apply Subgroup.commutator_le.mpr
      intro a _ b _
      change f ⁅a, b⁆ ∈ K
      rw [map_commutatorElement]
      have hid : ⁅f a, f b⁆ = f a ^ 2 * f (a⁻¹ * b) ^ 2 * (f b ^ 2)⁻¹ := by
        simp [map_mul, map_inv, commutatorElement_def, pow_two, mul_assoc]
      rw [hid]
      exact K.mul_mem (K.mul_mem (hsq a) (hsq (a⁻¹ * b))) (K.inv_mem (hsq b))
    exact hcomm hx
  · change f (y ^ 2) ∈ K
    simpa only [map_pow] using hsq y

/-- Adjoining a central elementary abelian two-subgroup to a finite two-group
does not change its Frattini subgroup, viewed in the common ambient group. -/
public theorem frattini_map_eq_of_central_elementary_supplement
    {G : Type*} [Group G] [Finite G] (Q D Z : Subgroup G)
    (hQ : IsPGroup 2 Q) (hZ : IsElementaryAbelian 2 Z)
    (hcentral : Z ≤ Subgroup.centralizer (Q : Set G)) (hgen : Q = Z ⊔ D) :
    (frattini Q).map Q.subtype = (frattini D).map D.subtype := by
  let : Fact (IsPGroup 2 Q) := ⟨hQ⟩
  let : IsElementaryAbelian 2 Z := hZ
  have hDQ : D ≤ Q := hgen ▸ le_sup_right
  let : Fact (IsPGroup 2 D) := ⟨hQ.of_injective (Subgroup.inclusion hDQ)
    (Subgroup.inclusion_injective hDQ)⟩
  have hZD : Z ≤ Subgroup.centralizer (D : Set G) :=
    hcentral.trans (Subgroup.centralizer_le hDQ)
  apply le_antisymm
  · apply frattini_map_le_of_square_mem Q.subtype
    intro x
    have hxmul : (x : G) ∈ (Z : Set G) * (D : Set G) := by
      rw [← Subgroup.coe_mul_of_left_le_normalizer_right Z D
        (hZD.trans (Subgroup.centralizer_le_normalizer _)), ← hgen]
      exact x.property
    obtain ⟨z, hz, d, hd, hzd⟩ := hxmul
    have hcomm : Commute z d := (Subgroup.mem_centralizer_iff.mp (hZD hz) d hd).symm
    have hpow : (x : G) ^ 2 = d ^ 2 := by
      rw [← hzd, hcomm.mul_pow, elemPow_eq_one_of_isElementaryAbelian z hz, one_mul]
    change (x : G) ^ 2 ∈ (frattini D).map D.subtype
    rw [hpow]
    exact Subgroup.mem_map_of_mem D.subtype
      (pth_power_mem_frattini_of_isPGroup (p := 2) (⟨d, hd⟩ : D))
  · have hi := frattini_map_le_of_isPGroup (p := 2) (Subgroup.inclusion hDQ)
    calc
      (frattini D).map D.subtype =
          ((frattini D).map (Subgroup.inclusion hDQ)).map Q.subtype := by
        rw [Subgroup.map_map]
        rfl
      _ ≤ (frattini Q).map Q.subtype := Subgroup.map_mono hi
