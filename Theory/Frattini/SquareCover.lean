module
public import Theory.Frattini.BinarySquares

/-!
# Frattini bounds from a generating square cover

Let a finite two-group T be generated by subgroups J and K. If their
squares and the derived subgroup of T lie in D, then Phi(T) lies in D.
The elements of T whose squares lie in D form a subgroup by
(xy)^2 = x^2 [x^-1,y] y^2. It contains both generators, and the binary
Frattini generation theorem finishes the argument. No ambient finiteness
or normality of D is required.

This supplies the derived-to-Frattini calculation in the Suzuki core and
third-kernel centralizer in DGS85, Groups and Graphs, (12.9), pp.188--189.
-/
public section
open Subgroup
open scoped commutatorElement
namespace Subgroup
/-- A two-group generated by subgroups with squares in D has Frattini image
in D when its derived subgroup also lies there. -/
theorem frattini_image_le_of_square_cover
    {G : Type*} [Group G] (T J K D : Subgroup G) [Finite T]
    (hp : IsPGroup 2 T) (hgen : J ⊔ K = T)
    (hder : ⁅T,T⁆ ≤ D)
    (hJ : ∀ x ∈ J, x^2 ∈ D) (hK : ∀ x ∈ K, x^2 ∈ D) :
    (frattini T).map T.subtype ≤ D := by
  let U : Subgroup G := {
    carrier := {x | x ∈ T ∧ x^2 ∈ D}
    one_mem' := by simp
    inv_mem' := by
      rintro x ⟨hx,hs⟩
      exact ⟨T.inv_mem hx,by simpa only [inv_pow] using D.inv_mem hs⟩
    mul_mem' := by
      rintro x y ⟨hx,hs⟩ ⟨hy,ht⟩
      refine ⟨T.mul_mem hx hy,?_⟩
      have he : (x*y)^2 = x^2*⁅x⁻¹,y⁆*y^2 := by
        simp [commutatorElement_def,pow_two,mul_assoc]
      rw [he]
      exact D.mul_mem (D.mul_mem hs (hder (commutator_mem_commutator (T.inv_mem hx) hy))) ht }
  have hTU : T ≤ U := by
    rw [←hgen]
    exact sup_le (fun x hx => ⟨(le_sup_left.trans hgen.le) hx,hJ x hx⟩)
      (fun x hx => ⟨(le_sup_right.trans hgen.le) hx,hK x hx⟩)
  rw [map_le_iff_le_comap,hp.frattini_eq_closure_squares]
  apply (closure_le _).mpr
  rintro x ⟨y,rfl⟩
  exact (hTU y.property).2
end Subgroup
