module

public import Theory.Frattini.PGroup

/-!
# The Frattini subgroup of a two-group is generated by squares

For any group, commutators are products of squares:
`[a,b] = a² (a⁻¹b)² (b²)⁻¹`. Thus the usual generators of the Frattini
subgroup of a finite two-group reduce to squares alone. This is the binary
specialization of the Frattini generation theorem in `Theory.Frattini.PGroup`.
-/

open scoped commutatorElement

/-- Commutators are contained in the subgroup generated by squares. -/
public theorem commutator_le_closure_squares {P : Type*} [Group P] :
    commutator P ≤ Subgroup.closure (Set.range (fun x : P => x ^ 2)) := by
  let K := Subgroup.closure (Set.range (fun x : P => x ^ 2))
  have hsq (x : P) : x ^ 2 ∈ K := Subgroup.subset_closure ⟨x, rfl⟩
  rw [commutator_def]
  apply Subgroup.commutator_le.mpr
  intro a _ b _
  have hid : ⁅a, b⁆ = a ^ 2 * (a⁻¹ * b) ^ 2 * (b ^ 2)⁻¹ := by
    simp [commutatorElement_def, pow_two, mul_assoc]
  rw [hid]
  exact K.mul_mem (K.mul_mem (hsq a) (hsq (a⁻¹ * b))) (K.inv_mem (hsq b))

/-- In a finite two-group, the Frattini subgroup is generated by squares. -/
public theorem IsPGroup.frattini_eq_closure_squares
    {P : Type*} [Group P] [Finite P] (hP : IsPGroup 2 P) :
    frattini P = Subgroup.closure (Set.range (fun x : P => x ^ 2)) := by
  let : Fact (IsPGroup 2 P) := ⟨hP⟩
  rw [frattini_eq_closure_commutator_union_powers (p := 2)]
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro x (hx | hx)
    · exact commutator_le_closure_squares hx
    · exact Subgroup.subset_closure hx
  · exact Subgroup.closure_mono Set.subset_union_right
