module

public import Theory.Frattini.OmegaAmbient

/-!
# Frattini omega under equivalences and products

An injective homomorphism preserves the subgroup generated by involutions.
Together with the invariance of the Frattini subgroup under isomorphism this
transports ambient Frattini omega. Projections and factor inclusions give the
product formula for finite two-groups.

These are the intrinsic product facts used in Aschbacher–Smith, printed
p.1182 / PDF p.1199, in the calculation following Lemma 16.3.12.
-/

@[expose] public section
namespace Subgroup
variable {A B : Type*} [Group A] [Group B]

theorem frattini_map_equiv (e : A ≃* B) :
    (frattini A).map e.toMonoidHom = frattini B := by
  apply le_antisymm
  · exact map_le_iff_le_comap.mpr (frattini_le_comap_frattini_of_surjective e.surjective)
  · intro x hx
    refine ⟨e.symm x, ?_, e.apply_symm_apply x⟩
    exact frattini_le_comap_frattini_of_surjective (φ := e.symm.toMonoidHom) e.symm.surjective hx

theorem map_omegaOneAmbient_injective (f : A →* B) (hf : Function.Injective f)
    (S : Subgroup A) :
    (omegaOneAmbient S).map f = omegaOneAmbient (S.map f) := by
  apply le_antisymm (map_omegaOneAmbient_le f le_rfl)
  apply (omegaOneAmbient_le_iff _ _).mpr
  rintro x ⟨a, ha, rfl⟩ hx2
  apply mem_map_of_mem
  exact (omegaOneAmbient_le_iff _ _).mp le_rfl a ha
    (hf (by simpa only [map_pow, map_one] using hx2))

theorem omegaFrattini_top : (⊤ : Subgroup A).omegaFrattini = omegaOneAmbient (frattini A) := by
  unfold omegaFrattini
  rw [show (frattini (⊤ : Subgroup A)).map (⊤ : Subgroup A).subtype = frattini A from
    frattini_map_equiv (Subgroup.topEquiv)]

theorem omegaFrattini_map_subtype (S : Subgroup A) :
    ((⊤ : Subgroup S).omegaFrattini).map S.subtype = S.omegaFrattini := by
  rw [omegaFrattini_top, map_omegaOneAmbient_injective S.subtype S.subtype_injective]
  rfl

theorem omegaFrattini_top_map_equiv (e : A ≃* B) :
    ((⊤ : Subgroup A).omegaFrattini).map e.toMonoidHom =
      (⊤ : Subgroup B).omegaFrattini := by
  rw [omegaFrattini_top, omegaFrattini_top,
    map_omegaOneAmbient_injective e.toMonoidHom e.injective, frattini_map_equiv e]

theorem center_map_equiv (e : A ≃* B) :
    (center A).map e.toMonoidHom = center B := by
  ext x
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact (centerCongr e ⟨a, ha⟩).property
  · intro hx
    refine ⟨e.symm x, ?_, e.apply_symm_apply x⟩
    exact (centerCongr e.symm ⟨x, hx⟩).property

theorem isPGroup_prod {A B : Type*} [Group A] [Group B]
    (hA : IsPGroup 2 A) (hB : IsPGroup 2 B) : IsPGroup 2 (A × B) := by
  rw [isPGroup_iff_pow_pow_eq_one] at hA hB ⊢
  rintro ⟨a, b⟩
  obtain ⟨m, hm⟩ := hA a
  obtain ⟨n, hn⟩ := hB b
  refine ⟨m + n, ?_⟩
  simp only [Prod.pow_mk, Prod.mk_eq_one]
  change a ^ 2 ^ (m + n) = 1 ∧ b ^ 2 ^ (m + n) = 1
  constructor <;> rw [show 2 ^ (m + n) = 2 ^ m * 2 ^ n by rw [pow_add]]
  · rw [pow_mul, hm, one_pow]
  · rw [show 2 ^ m * 2 ^ n = 2 ^ n * 2 ^ m by ac_rfl, pow_mul, hn, one_pow]

theorem omegaFrattini_top_prod {A B : Type*} [Group A] [Group B]
    [Finite A] [Finite B] (hA : IsPGroup 2 A) (hB : IsPGroup 2 B) :
    (⊤ : Subgroup (A × B)).omegaFrattini =
      (⊤ : Subgroup A).omegaFrattini.prod (⊤ : Subgroup B).omegaFrattini := by
  let hAB : IsPGroup 2 (A × B) := isPGroup_prod hA hB
  have hAT : IsPGroup 2 (⊤ : Subgroup A) := hA.to_subgroup _
  have hBT : IsPGroup 2 (⊤ : Subgroup B) := hB.to_subgroup _
  have hABT : IsPGroup 2 (⊤ : Subgroup (A × B)) := hAB.to_subgroup _
  have hfst := Subgroup.map_omegaFrattini_le (MonoidHom.fst A B)
    (S := (⊤ : Subgroup (A × B))) (R := (⊤ : Subgroup A)) hABT hAT (by simp)
  have hsnd := Subgroup.map_omegaFrattini_le (MonoidHom.snd A B)
    (S := (⊤ : Subgroup (A × B))) (R := (⊤ : Subgroup B)) hABT hBT (by simp)
  have hinl := Subgroup.map_omegaFrattini_le (MonoidHom.inl A B)
    (S := (⊤ : Subgroup A)) (R := (⊤ : Subgroup (A × B))) hAT hABT (by simp)
  have hinr := Subgroup.map_omegaFrattini_le (MonoidHom.inr A B)
    (S := (⊤ : Subgroup B)) (R := (⊤ : Subgroup (A × B))) hBT hABT (by simp)
  apply le_antisymm
  · intro x hx
    exact ⟨hfst (Subgroup.mem_map_of_mem (MonoidHom.fst A B) hx),
      hsnd (Subgroup.mem_map_of_mem (MonoidHom.snd A B) hx)⟩
  · rintro ⟨a, b⟩ hx
    have ha : (a, 1) ∈ (⊤ : Subgroup (A × B)).omegaFrattini := by
      apply hinl
      exact Subgroup.mem_map_of_mem (MonoidHom.inl A B) hx.1
    have hb : (1, b) ∈ (⊤ : Subgroup (A × B)).omegaFrattini := by
      apply hinr
      exact Subgroup.mem_map_of_mem (MonoidHom.inr A B) hx.2
    simpa using (⊤ : Subgroup (A × B)).omegaFrattini.mul_mem ha hb

/-- Frattini subgroups of finite two-groups commute with direct products. -/
theorem frattini_prod {A B : Type*} [Group A] [Group B] [Finite A] [Finite B]
    (hA : IsPGroup 2 A) (hB : IsPGroup 2 B) :
    frattini (A × B) = (frattini A).prod (frattini B) := by
  let : Fact (IsPGroup 2 A) := ⟨hA⟩
  let : Fact (IsPGroup 2 B) := ⟨hB⟩
  let : Fact (IsPGroup 2 (A × B)) := ⟨isPGroup_prod hA hB⟩
  have hfst := frattini_map_le_of_isPGroup (p := 2) (MonoidHom.fst A B)
  have hsnd := frattini_map_le_of_isPGroup (p := 2) (MonoidHom.snd A B)
  have hinl := frattini_map_le_of_isPGroup (p := 2) (MonoidHom.inl A B)
  have hinr := frattini_map_le_of_isPGroup (p := 2) (MonoidHom.inr A B)
  apply le_antisymm
  · intro x hx
    exact ⟨hfst (mem_map_of_mem _ hx), hsnd (mem_map_of_mem _ hx)⟩
  · rintro ⟨a, b⟩ ⟨ha, hb⟩
    have ha' : (a, 1) ∈ frattini (A × B) := hinl (mem_map_of_mem (MonoidHom.inl A B) ha)
    have hb' : (1, b) ∈ frattini (A × B) := hinr (mem_map_of_mem (MonoidHom.inr A B) hb)
    simpa only [Prod.mul_def, mul_one, one_mul] using (frattini (A × B)).mul_mem ha' hb'

end Subgroup
