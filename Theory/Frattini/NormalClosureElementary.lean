module
public import Theory.ElementaryAbelian.NormalClosureQuotient
public import Theory.GroupTheory.CommutatorPreimageFrattini

/-!
# Frattini bounds for an elementary normal-closure seed

If an elementary p-subgroup normally generates A inside a normal p-subgroup
P, then A/[P,A] is elementary: it is abelian and generated by elements of
order p. Hence the ambient Frattini subgroup of A lies in [P,A].
This is the Frattini estimate for the paired orbits in MS93 (3.6), p.871.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace Subgroup
variable {G : Type*} [Group G] [Finite G]

theorem normalClosure_frattini_image_le_commutator
    {p : ℕ} [Fact p.Prime] (Y P : Subgroup G) [P.Normal]
    [IsElementaryAbelian p Y] (hP : IsPGroup p P)
    (hYP : normalClosure (Y : Set G) ≤ P) :
    (frattini (normalClosure (Y : Set G))).map (normalClosure (Y : Set G)).subtype ≤
      ⁅P,normalClosure (Y : Set G)⁆ := by
  let A := normalClosure (Y : Set G)
  let : A.Normal := normalClosure_normal
  let N := (⁅P,A⁆).subgroupOf A
  have hA : IsPGroup p A := hP.of_injective (inclusion hYP) (inclusion_injective _)
  have hc : _root_.commutator A ≤ N := by
    intro a ha
    have hh : (a : G) ∈ ⁅A,A⁆ := by
      rw [←map_subtype_commutator]
      exact mem_map_of_mem A.subtype ha
    exact (commutator_mono hYP le_rfl) hh
  have he : IsElementaryAbelian p (A ⧸ N) :=
    normalClosure_quotient_elementary p Y N (Normal.quotient_commutative_iff_commutator_le.mpr hc)
  have hphi := frattini_le_of_elementary_quotient hA N he
  exact map_le_iff_le_comap.mpr hphi

end Subgroup
