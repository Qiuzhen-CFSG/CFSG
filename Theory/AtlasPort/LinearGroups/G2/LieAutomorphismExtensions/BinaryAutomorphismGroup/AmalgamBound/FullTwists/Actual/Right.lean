/-- All finite checks discharge the actual root-action and row-multiplication contract. -/
theorem right_action : rightCoordinates.ActionTable rightGenerators where
  zero := by
    have h : ∀ c r : Fin 8, column (rightLabel 0) c r = basisVector c r := by
      decide +kernel
    exact fun c => funext (h c)
  step := by
    have h : ∀ (i : Fin 192) (b : Fin 3) (c r : Fin 8),
        rightApplyGenerator b (column (rightLabel i) c) r =
        column (rightLabel (rightMul (⟨b.val+1, by omega⟩) i)) c r := by
      apply forall_blocks (n := 24)
      intro k
      fin_cases k
      · exact right_step_0
      · exact right_step_1
      · exact right_step_2
      · exact right_step_3
      · exact right_step_4
      · exact right_step_5
      · exact right_step_6
      · exact right_step_7
      · exact right_step_8
      · exact right_step_9
      · exact right_step_10
      · exact right_step_11
      · exact right_step_12
      · exact right_step_13
      · exact right_step_14
      · exact right_step_15
      · exact right_step_16
      · exact right_step_17
      · exact right_step_18
      · exact right_step_19
      · exact right_step_20
      · exact right_step_21
      · exact right_step_22
      · exact right_step_23
    intro b i c
    rw [rightGenerators_apply]
    exact funext (h i b c)
  words := by decide +kernel
  product := by
    apply forall_blocks (n := 24)
    intro k
    fin_cases k
    · exact right_product_0
    · exact right_product_1
    · exact right_product_2
    · exact right_product_3
    · exact right_product_4
    · exact right_product_5
    · exact right_product_6
    · exact right_product_7
    · exact right_product_8
    · exact right_product_9
    · exact right_product_10
    · exact right_product_11
    · exact right_product_12
    · exact right_product_13
    · exact right_product_14
    · exact right_product_15
    · exact right_product_16
    · exact right_product_17
    · exact right_product_18
    · exact right_product_19
    · exact right_product_20
    · exact right_product_21
    · exact right_product_22
    · exact right_product_23
  separate i j h := right_label_injective
    (labels_eq (right_label_bound i) (right_label_bound j) h)

