/-- All finite checks discharge the actual root-action and row-multiplication contract. -/
theorem left_action : leftCoordinates.ActionTable leftGenerators where
  zero := by
    have h : ∀ c r : Fin 8, column (leftLabel 0) c r = basisVector c r := by
      decide +kernel
    exact fun c => funext (h c)
  step := by
    have h : ∀ (i : Fin 192) (b : Fin 3) (c r : Fin 8),
        leftApplyGenerator b (column (leftLabel i) c) r =
        column (leftLabel (leftMul (⟨b.val+1, by omega⟩) i)) c r := by
      apply forall_blocks (n := 24)
      intro k
      fin_cases k
      · exact left_step_0
      · exact left_step_1
      · exact left_step_2
      · exact left_step_3
      · exact left_step_4
      · exact left_step_5
      · exact left_step_6
      · exact left_step_7
      · exact left_step_8
      · exact left_step_9
      · exact left_step_10
      · exact left_step_11
      · exact left_step_12
      · exact left_step_13
      · exact left_step_14
      · exact left_step_15
      · exact left_step_16
      · exact left_step_17
      · exact left_step_18
      · exact left_step_19
      · exact left_step_20
      · exact left_step_21
      · exact left_step_22
      · exact left_step_23
    intro b i c
    rw [leftGenerators_apply]
    exact funext (h i b c)
  words := by decide +kernel
  product := by
    apply forall_blocks (n := 24)
    intro k
    fin_cases k
    · exact left_product_0
    · exact left_product_1
    · exact left_product_2
    · exact left_product_3
    · exact left_product_4
    · exact left_product_5
    · exact left_product_6
    · exact left_product_7
    · exact left_product_8
    · exact left_product_9
    · exact left_product_10
    · exact left_product_11
    · exact left_product_12
    · exact left_product_13
    · exact left_product_14
    · exact left_product_15
    · exact left_product_16
    · exact left_product_17
    · exact left_product_18
    · exact left_product_19
    · exact left_product_20
    · exact left_product_21
    · exact left_product_22
    · exact left_product_23
  separate i j h := left_label_injective
    (labels_eq (left_label_bound i) (left_label_bound j) h)

