/-!
# No order-four fixer of the inner short-root centralizer residual in G₂(4)

The subgroup `residualBlock` is the actual affine block generated by the A–B
root plane and the opposite-vector SL₂ block. Its two-perfectness places it
inside `O²(C_G(rootC a))`, computed inside that centralizer and then included
in G. This containment transports through the specified short-root conjugator;
no identification of the full centralizer or its full residual is needed.

Fixing the entire A-root group under the published inner-field action forces
the field part to be trivial: the A-root operator is affine linear in its
parameter, and commutation with its value at one implies commutation with all
its values. The inner factor then normalizes the A–B plane, so lies in the
long parabolic. Under a fourth-power-one assumption its scalar on the fixed
line is one in characteristic two. Commutation with A and B kills the SL₂
factor; commutation with E and the long Weyl element leaves only the C-root
group. That group has exponent two, excluding order four.

The abstract-automorphism corollary has precisely one extra structural input:
surjectivity of the actual semilinear action. It keeps the genuine nonzero
root parameter and conjugator in `ShortRootProducts.IsShortRootElement`.

This supplies an intrinsic model calculation for the terminal contradiction
in Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), Lemma 16.4.10, printed p.1193. It does not assert
that the chapter's remaining ambient hypotheses or automorphism coverage
have been discharged.
-/

public section

open Subgroup Atlas.SplitOctonion
open scoped MatrixGroups Pointwise
namespace Atlas.G2.ShortRootResidualFixer
open LieParabolicSetup PairStabilizer Explicit ShortRootProducts.CentralizerCore
open LieAutomorphismExtensions
variable {F : Type*} [Field F] [CharP F 2]
set_option maxHeartbeats 800000

omit [CharP F 2] in
private theorem rootA_affine (a : F) (x : Carrier F) :
    (rootA a).val x = x + a • ((rootA 1).val x - x) := by
  funext i
  fin_cases i <;> simp [rootA, rootAEquiv, rootALinear, rootAApply, Matrix.vecHead, Matrix.vecTail]
  ring

omit [CharP F 2] in
private theorem commute_rootA_of_one {g : Model F} (h : Commute g (rootA 1))
    (a : F) : Commute g (rootA a) := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  change g.val ((rootA a).val x) = (rootA a).val (g.val x)
  rw [rootA_affine a x, rootA_affine a (g.val x), map_add, map_smul, map_sub]
  have he := congrArg (fun k : Model F => k.val x) h.eq
  change g.val ((rootA 1).val x) = (rootA 1).val (g.val x) at he
  rw [he]

omit [CharP F 2] in
private theorem field_eq_one (z : Model F ⋊[fieldAction] (F ≃+* F))
    (hz : ∀ a : F, semilinearAction z (rootA a) = rootA a) : z.right = 1 := by
  have h (a : F) : MulAut.conj z.left (rootA (z.right a)) = rootA a := by
    have hh := hz a
    change MulAut.conj z.left (fieldEquiv z.right (rootA a)) = rootA a at hh
    simpa only [fieldEquiv_rootA] using hh
  have hc : Commute z.left (rootA 1) := by
    have hh := h 1
    rw [map_one, MulAut.conj_apply] at hh
    exact mul_inv_eq_iff_eq_mul.mp hh
  apply RingEquiv.ext
  intro a
  apply rootA_injective
  have hh := h a
  rwa [MulAut.conj_apply, (commute_rootA_of_one hc (z.right a)).eq,
    mul_inv_cancel_right] at hh

private theorem eq_one_of_fourth {a : F} (ha : a ^ 4 = 1) : a = 1 := by
  have hs (b : F) (hb : b ^ 2 = 1) : b = 1 := by
    rcases sq_eq_one_iff.mp hb with h | h
    · exact h
    · simpa only [CharTwo.neg_eq] using h
  exact hs a (hs (a ^ 2) (by simpa only [← pow_mul] using ha))

private theorem local_of_parabolic_fourth {g : Model F} (hg : g ∈ parabolic₂)
    (hfour : g ^ 4 = 1) : g ∈ local₂ := by
  let gp : pointStabilizer (K := F) :=
    ⟨g, by rw [← parabolic_eq_pointStabilizer]; exact hg⟩
  have hp : gp ^ 4 = 1 := Subtype.ext hfour
  have hs : (lineScalarHom gp) ^ 4 = 1 := by rw [← map_pow, hp, map_one]
  have he : lineScalarHom gp = 1 := by
    apply Units.ext
    apply eq_one_of_fourth
    exact congrArg Units.val hs
  have hm : gp ∈ lineScalarHom.ker := he
  rw [lineScalarHom_kernel] at hm
  rw [local₂_eq_fixingFirstVector]
  exact hm

private theorem factor_block (t : Fin 6 → F) (M : SL(2,F)) (ht : t 4 = 0)
    (ha : Commute (unipotentProduct t * blockHom M) (rootA 1))
    (hb : Commute (unipotentProduct t * blockHom M) (rootB 1)) : M = 1 := by
  have h10 := congrArg (fun g : Model F => g.val (basisVector 5) 0) ha.eq
  have h00 := congrArg (fun g : Model F => g.val (basisVector 7) 1) ha.eq
  have h11 := congrArg (fun g : Model F => g.val (basisVector 6) 0) ha.eq
  have h01 := congrArg (fun g : Model F => g.val (basisVector 6) 0) hb.eq
  simp [unipotentProduct, rootA, rootB, rootC, rootD, rootE, rootF,
    rootAEquiv, rootBEquiv, rootCEquiv, rootDEquiv, rootEEquiv, rootFEquiv,
    rootALinear, rootBLinear, rootCLinear, rootDLinear, rootELinear, rootFLinear,
    rootAApply, rootBApply, rootCApply, rootDApply, rootEApply, rootFApply,
    blockHom, blockEquiv, blockLinear,
    basisVector, ht, CharTwo.neg_eq, CharTwo.sub_eq_add] at h10 h00 h11 h01
  have h00' : M 0 0 = 1 := by linear_combination h00
  have h11' : M 1 1 = 1 := by linear_combination -h11
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [h00', h11', h01, h10]

private theorem unipotent_block_fixer (t : Fin 6 → F) (ht : t 4 = 0)
    (he : Commute (unipotentProduct t) (rootE 1))
    (hr : Commute (unipotentProduct t) (weylR : Model F)) :
    unipotentProduct t = rootC (t 2) := by
  have heq := he.eq
  have hE : rootE (1 : F) = unipotentProduct ![0,0,0,0,1,0] := by simp [unipotentProduct]
  rw [hE, unipotentProduct_mul, unipotentProduct_mul] at heq
  have h3 := congrFun (unipotentProduct_injective heq) 3
  have h0 := congrFun (unipotentProduct_injective heq) 0
  simp [unipotentProductParameters, ht, CharTwo.sub_eq_add] at h3 h0
  have h1 : t 1 = 0 := by simpa [h3] using h0.symm
  have hform : unipotentProduct t = rootA (t 0) * rootC (t 2) * rootD (t 3) := by
    simp [unipotentProduct, ht, h3, h1]
  have hR : MulAut.conj (weylR : Model F) (unipotentProduct t) = unipotentProduct t := by
    rw [MulAut.conj_apply, ← hr.eq, mul_inv_cancel_right]
  have hRC : MulAut.conj (weylR : Model F) (rootC (t 2)) = rootC (t 2) := by
    have h := block_commute_rootC (rankOneJ (F := F)) (t 2)
    rw [long_block_J] at h
    rw [MulAut.conj_apply, h.eq, mul_inv_cancel_right]
  rw [hform, map_mul, map_mul, hRC,
    show MulAut.conj (weylR : Model F) (rootA (t 0)) = rootB (t 0) from weylR_rootA _,
    show MulAut.conj (weylR : Model F) (rootD (t 3)) = rootF (t 3) from weylR_rootD _] at hR
  have hp : unipotentProduct ![0,t 0,t 2,0,0,t 3] =
      unipotentProduct ![t 0,0,t 2,t 3,0,0] := by
    simpa [unipotentProduct] using hR
  have h0' : t 0 = 0 := by simpa using (congrFun (unipotentProduct_injective hp) 0).symm
  have h3' : t 3 = 0 := by simpa using (congrFun (unipotentProduct_injective hp) 3).symm
  simp [unipotentProduct, ht, h3, h1, h0', h3']

private theorem inner_fixer_fourth {g : Model F}
    (hg : ∀ x ∈ residualBlock (F := F), MulAut.conj g x = x)
    (hfour : g ^ 4 = 1) : g ^ 2 = 1 := by
  have hc (x : Model F) (hx : x ∈ residualBlock) : Commute g x := by
    have h := hg x hx
    rw [MulAut.conj_apply] at h
    exact mul_inv_eq_iff_eq_mul.mp h
  have hp : g ∈ parabolic₂ := by
    rw [← SylowParabolicInvariance.normalizer_longRootLocal]
    apply centralizer_le_normalizer
    apply mem_centralizer_iff.mpr
    intro x hx
    exact (hc x (mem_sup_left hx)).eq.symm
  have hl := local_of_parabolic_fourth hp hfour
  rw [← SetLike.mem_coe, local₂_eq_radical₂_mul_fixingPair] at hl
  obtain ⟨u, ⟨t, ht, rfl⟩, m, hm, he⟩ := hl
  have hblock := congrArg Subtype.val (block_imageSL ⟨m, hm⟩)
  change blockHom (imageSL ⟨m, hm⟩) = m at hblock
  have hform : g = unipotentProduct t * blockHom (imageSL ⟨m, hm⟩) := by
    rw [hblock]
    exact he.symm
  have hM := factor_block t (imageSL ⟨m, hm⟩) ht
    (hform ▸ hc (rootA 1) (mem_sup_left (rootA_mem_longRootLocal 1)))
    (hform ▸ hc (rootB 1) (mem_sup_left (rootB_mem_longRootLocal 1)))
  rw [hM, map_one, mul_one] at hform
  have hE : rootE (1 : F) ∈ residualBlock := by
    rw [← block_upper]
    exact mem_sup_right ⟨_,rfl⟩
  have hR : (weylR : Model F) ∈ residualBlock := by
    rw [← long_block_J]
    exact mem_sup_right ⟨_,rfl⟩
  have hu := unipotent_block_fixer t ht (hform ▸ hc _ hE) (hform ▸ hc _ hR)
  rw [hform, hu, pow_two, Atlas.G2.rootC_add, CharTwo.add_self_eq_zero, rootC_zero]

private theorem semilinear_no_four [Finite F] (hq : 2 < Nat.card F)
    (z : Model F ⋊[fieldAction] (F ≃+* F))
    (hz : ∀ x ∈ residualBlock (F := F), semilinearAction z x = x) :
    orderOf (semilinearAction z) ≠ 4 := by
  have hs : z.right = 1 := field_eq_one z
    (fun a => hz (rootA a) (mem_sup_left (rootA_mem_longRootLocal a)))
  have he : semilinearAction z = MulAut.conj z.left := by
    rw [semilinearAction_apply, hs, map_one, mul_one]
  intro ho
  have hfour : z.left ^ 4 = 1 := by
    apply Theory.GroupTheory.conj_injective_of_center_eq_bot (model_center_eq_bot hq)
    rw [map_pow, ← he, ← ho, pow_orderOf_eq_one, map_one]
  have hsquare : (semilinearAction z) ^ 2 = 1 := by
    rw [he, ← map_pow, inner_fixer_fourth (by simpa only [he] using hz) hfour, map_one]
  have hd := orderOf_dvd_of_pow_eq_one hsquare
  rw [ho] at hd
  norm_num at hd


open Theory.GroupTheory

/-- The affine block lies in the two-residual of the actual inner centralizer. -/
theorem residualBlock_le_centralizerTwoResidual [Finite F]
    (hq : 2 < Nat.card F) (a : F) :
    residualBlock (F := F) ≤ centralizerTwoResidual (rootC a) := by
  have hle := residualBlock_le_centralizer_rootC (F := F) a
  have hp : IsPPerfect 2 ((residualBlock (F := F)).subgroupOf
      (centralizer ({rootC a} : Set (Model F)))) :=
    (residualBlock_isTwoPerfect (F := F) hq).of_surjective
      (subgroupOfEquivOfLe hle).symm.toMonoidHom (subgroupOfEquivOfLe hle).symm.surjective
  have h := Subgroup.map_mono (f := (centralizer ({rootC a} : Set (Model F))).subtype)
    (le_pResidual_of_isPPerfect _ hp)
  rw [map_subgroupOf_eq_of_le hle] at h
  exact h

/-- The marking is transported by the actual conjugating automorphism. -/
theorem conjugate_residualBlock_le_centralizerTwoResidual [Finite F]
    (hq : 2 < Nat.card F) (a : F) (g : Model F) :
    (residualBlock (F := F)).map (MulAut.conj g).toMonoidHom ≤
      centralizerTwoResidual (MulAut.conj g (rootC a)) := by
  rw [← map_centralizerTwoResidual]
  exact map_mono (residualBlock_le_centralizerTwoResidual hq a)

/-- No order-four element of the actual inner-field action fixes the affine block pointwise. -/
theorem semilinearAction_orderOf_ne_four [Finite F] (hF : Nat.card F = 4)
    (gamma : Model F ⋊[fieldAction] (F ≃+* F))
    (hfix : ∀ x ∈ residualBlock (F := F), semilinearAction gamma x = x) :
    orderOf (semilinearAction gamma) ≠ 4 :=
  semilinear_no_four (by omega) gamma hfix

/-- Coverage is the sole additional structural input for abstract automorphisms.
The root marking retains both its nonzero parameter and its actual conjugator. -/
theorem automorphism_orderOf_ne_four [Finite F] (hF : Nat.card F = 4)
    (hcoverage : Function.Surjective (semilinearAction (F := F)))
    (v : Model F) (hv : ShortRootProducts.IsShortRootElement v)
    (alpha : MulAut (Model F))
    (hfix : ∀ x ∈ centralizerTwoResidual v, alpha x = x) : orderOf alpha ≠ 4 := by
  obtain ⟨a, ha, g, rfl⟩ := hv
  let e : MulAut (Model F) := MulAut.conj g
  let beta : MulAut (Model F) := MulAut.conj e⁻¹ alpha
  have hb : ∀ x ∈ residualBlock (F := F), beta x = x := by
    intro x hx
    change e.symm (alpha (e x)) = x
    have hx' : e x ∈ centralizerTwoResidual (MulAut.conj g (rootC a)) :=
      conjugate_residualBlock_le_centralizerTwoResidual (by omega) a g
        (mem_map_of_mem (MulAut.conj g).toMonoidHom hx)
    rw [hfix _ hx', e.symm_apply_apply]
  obtain ⟨gamma, hgamma⟩ := hcoverage beta
  have hn := semilinearAction_orderOf_ne_four hF gamma (by simpa only [hgamma] using hb)
  rw [hgamma] at hn
  exact ((MulAut.conj e⁻¹).orderOf_eq alpha) ▸ hn

end Atlas.G2.ShortRootResidualFixer
