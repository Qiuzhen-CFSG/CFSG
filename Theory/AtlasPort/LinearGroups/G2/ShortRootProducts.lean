module

public import Theory.GroupTheory.CentralizerResidualProducts
public import Theory.AtlasPort.LinearGroups.G2.LieParabolicSetup
public import Theory.AtlasPort.LinearGroups.G2.LongRootNormalGeneration

/-!
# Short-root conjugate products in the split-octonion G₂ model

In Wilson's six-root coordinates, A, B, E are long roots and C, D, F
are short roots. In characteristic two the explicit collection formula gives
`x_C(a) x_C(a)^(x_D(b)) = x_A(ab)`, with left conjugation. The long-root
plane generated by A and B consists, away from the identity, of conjugates
of A: the E root group performs a shear, and the long Weyl reflection
interchanges A and B. The highest-root group is central in the actual
unipotent Sylow two-subgroup, proving two-centrality.

The root predicates below are conjugacy classes of actual octonion
automorphisms, not labels attached to arbitrary groups. Identification of
the plane with the two-core of the short-root centralizer residual is a
separate obligation.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
combined manuscript (1 March 2004), printed pp.1202–1203, case (a).
The coordinate multiplication and Weyl identities are from the imported
ATLAS G₂ development by Gerald Höhn and the ATLAS contributors, licensed
under LICENSES/ATLAS.txt; see LICENSES/ATLAS-CITATION.cff.
-/

@[expose] public section

open Subgroup

namespace Atlas.G2.ShortRootProducts
open Theory.GroupTheory
variable {F : Type*} [Field F] [CharP F 2]

theorem product_rootC_conjugate (a b : F) :
    rootC a * MulAut.conj (rootD b) (rootC a) = rootA (a*b) := by
  have hd : (rootD b)⁻¹ = rootD b := by
    apply inv_eq_of_mul_eq_one_left
    rw [rootD_add, CharTwo.add_self_eq_zero, rootD_zero]
  have h3 : (3 : F) = 1 := by
    have h := CharTwo.add_self_eq_zero (1 : F)
    linear_combination h
  rw [MulAut.conj_apply, hd]
  calc
    _ = unipotentProduct ![0,0,a,0,0,0] * unipotentProduct ![0,0,0,b,0,0] *
        unipotentProduct ![0,0,a,0,0,0] * unipotentProduct ![0,0,0,b,0,0] := by
      simp [unipotentProduct, mul_assoc]
    _ = unipotentProduct ![a*b,0,0,0,0,0] := by
      rw [unipotentProduct_mul, unipotentProduct_mul, unipotentProduct_mul]
      congr 1
      funext i
      fin_cases i <;> simp [unipotentProductParameters, CharTwo.add_self_eq_zero,
        h3, mul_comm]
    _ = _ := by simp [unipotentProduct]

theorem rootA_twoCentral [Finite F] {a : F} (ha : a ≠ 0) :
    IsSylowCentralInvolution (rootA a) := by
  refine ⟨orderOf_eq_prime ?_ ?_, LieParabolicSetup.sylow, ?_, ?_⟩
  · rw [pow_two, rootA_add, CharTwo.add_self_eq_zero, rootA_zero]
  · intro h
    exact ha (rootA_injective (h.trans rootA_zero.symm))
  · change rootA a ∈ unipotent
    simpa [unipotentProduct] using unipotentProduct_mem ![a,0,0,0,0,0]
  · intro x hx
    change x ∈ unipotent at hx
    rw [unipotent_eq_range] at hx
    obtain ⟨t, rfl⟩ := hx
    exact mem_centralizer_singleton_iff.mpr
      (LieParabolicSetup.unipotentProduct_commute_rootA t a).eq

/-- The conjugacy class of nonzero values of the actual short-root curve C. -/
def IsShortRootElement (v : Model F) : Prop :=
  ∃ a : F, a ≠ 0 ∧ ∃ g : Model F, v = MulAut.conj g (rootC a)

/-- The conjugacy class of nonzero values of the actual long-root curve A. -/
def IsLongRootElement (v : Model F) : Prop :=
  ∃ a : F, a ≠ 0 ∧ ∃ g : Model F, v = MulAut.conj g (rootA a)

theorem IsLongRootElement.twoCentral [Finite F] {v : Model F}
    (hv : IsLongRootElement v) : IsSylowCentralInvolution v := by
  obtain ⟨a, ha, g, rfl⟩ := hv
  exact (rootA_twoCentral ha).map (MulAut.conj g)

theorem rootE_conjugate_rootB (s b : F) :
    MulAut.conj (rootE s) (rootB b) = rootA (s*b) * rootB b := by
  have he : (rootE s)⁻¹ = rootE s := by
    apply inv_eq_of_mul_eq_one_left
    rw [rootE_add, CharTwo.add_self_eq_zero, rootE_zero]
  rw [MulAut.conj_apply, he]
  calc
    _ = unipotentProduct ![0,0,0,0,s,0] * unipotentProduct ![0,b,0,0,0,0] *
        unipotentProduct ![0,0,0,0,s,0] := by simp [unipotentProduct]
    _ = unipotentProduct ![s*b,b,0,0,0,0] := by
      rw [unipotentProduct_mul, unipotentProduct_mul]
      congr 1
      funext i
      fin_cases i <;> simp [unipotentProductParameters, CharTwo.neg_eq,
        CharTwo.add_self_eq_zero, mul_comm]
    _ = _ := by simp [unipotentProduct]

theorem longRootLocal_isLong {w : Model F} (hw : w ∈ longRootLocal) (hne : w ≠ 1) :
    IsLongRootElement w := by
  obtain ⟨p, rfl⟩ := hw
  change IsLongRootElement (rootA p.toAdd.1 * rootB p.toAdd.2)
  by_cases hb : p.toAdd.2 = 0
  · refine ⟨p.toAdd.1, ?_, 1, ?_⟩
    · intro ha
      apply hne
      simp [longRootHom, ha, hb]
    · simp [hb]
  · refine ⟨p.toAdd.2, hb, rootE (p.toAdd.1 / p.toAdd.2) * weylR, ?_⟩
    rw [map_mul, MulAut.mul_apply]
    rw [show MulAut.conj weylR (rootA p.toAdd.2) = rootB p.toAdd.2 from weylR_rootA _]
    rw [rootE_conjugate_rootB, div_mul_cancel₀ _ hb]

theorem shortRoot_order {v : Model F} (hv : IsShortRootElement v) : orderOf v = 2 := by
  obtain ⟨a, ha, g, rfl⟩ := hv
  rw [MulEquiv.orderOf_eq]
  apply orderOf_eq_prime
  · rw [pow_two, rootC_add, CharTwo.add_self_eq_zero, rootC_zero]
  · intro h
    exact ha (rootC_injective (h.trans rootC_zero.symm))

theorem shortRoot_product [Finite F] {v : Model F} (hv : IsShortRootElement v) :
    ∃ l : Model F, IsLongRootElement (v * MulAut.conj l v) ∧
      IsSylowCentralInvolution (v * MulAut.conj l v) := by
  obtain ⟨a, ha, g, rfl⟩ := hv
  let l := MulAut.conj g (rootD (1 : F))
  have h : MulAut.conj g (rootC a) * MulAut.conj l (MulAut.conj g (rootC a)) =
      MulAut.conj g (rootA a) := by
    have hh := congrArg (MulAut.conj g) (product_rootC_conjugate a (1 : F))
    simpa [l, MulAut.conj_apply, mul_assoc] using hh
  refine ⟨l, ?_, ?_⟩
  · rw [h]
    exact ⟨a, ha, g, rfl⟩
  · rw [h]
    exact (rootA_twoCentral ha).map (MulAut.conj g)

/-- The marked product already lies in the concrete long-root plane. -/
theorem rootC_product_mem_longRootLocal (a : F) :
    rootC a * MulAut.conj (rootD (1 : F)) (rootC a) ∈ longRootLocal := by
  rw [product_rootC_conjugate, mul_one]
  exact rootA_mem_longRootLocal a

end Atlas.G2.ShortRootProducts
