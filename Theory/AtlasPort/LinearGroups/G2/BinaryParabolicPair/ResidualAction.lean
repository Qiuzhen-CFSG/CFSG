module

public import Theory.AtlasPort.LinearGroups.G2.BinaryParabolicPair.Restriction
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# The first binary G₂ parabolic residual and its quaternion action

In the original positive-root coordinates, let K be generated by the right
quaternion factor and the cubic `rootF 1 * weylS`. This module proves that K
is the ambient image of the actual two-residual of both the first parabolic
and its restriction to the commutator subgroup. It has order 24, fixes the
left quaternion factor pointwise, and acts on the right factor through the
join of the inner automorphisms and the specified cubic. The action kernel
is precisely the distinguished root involution.

The commuting quaternion factors and the short-root reflection normalize K.
Adjoining the positive-root two-group gives the first parabolic, so its
quotient by K is a two-group. Conversely, products of two quaternion–cubic
commutators cover the right factor; hence every normal subgroup containing
the cubic contains K. Coprime orders give the unique quaternion–cyclic normal
form and the order calculation. The explicit action also identifies the
centralizer inside K of either actual first-parabolic core. The imported
restriction retains the original Q₈ ◦ C₄ isomorphism and central quotient.

These are concrete model facts for Aschbacher–Smith, Lemma 14.2.21, printed
p.988 (PDF p.1005), not a geometric parabolic-pair recognition theorem.
Root conventions and source attribution are those of the imported ATLAS port.
-/

@[expose] public section

open Atlas.G2.Explicit
namespace Atlas.G2.BinaryParabolicPair.ResidualAction
open BinaryCore
set_option maxRecDepth 100000

def left : QuaternionGroup 2 →* Model (ZMod 2) := embedding.comp leftEmbedding
def right : QuaternionGroup 2 →* Model (ZMod 2) := embedding.comp rightEmbedding
def K : Subgroup (Model (ZMod 2)) := right.range ⊔ Subgroup.zpowers cubicActor

theorem right_injective : Function.Injective right := embedding_injective.comp BinaryCore.right_injective

def rightCubicMap : QuaternionGroup 2 → QuaternionGroup 2
  | .a n => (QuaternionGroup.xa 1) ^ n.val
  | .xa n => QuaternionGroup.a 1 * (QuaternionGroup.xa 1) ^ n.val

def rightCubic : MulAut (QuaternionGroup 2) where
  toFun := rightCubicMap
  invFun x := rightCubicMap (rightCubicMap x)
  left_inv := by decide +kernel
  right_inv := by decide +kernel
  map_mul' := by decide +kernel

/-- The orientation on the original right quaternion generators. -/
theorem rightCubic_i : rightCubic (QuaternionGroup.a 1) =
    (QuaternionGroup.a 1 * QuaternionGroup.xa 0)⁻¹ := by decide +kernel

theorem rightCubic_j : rightCubic (QuaternionGroup.xa 0) = QuaternionGroup.a 1 := by
  decide +kernel

theorem cubic_right (q : QuaternionGroup 2) :
    cubicActor * right q * cubicActor⁻¹ = right (rightCubic q) := by
  rw [show right q = embedding (rightEmbedding q) from rfl, cubic_conjugate]
  apply congrArg embedding
  revert q
  decide +kernel

theorem cubic_normalizes_right : cubicActor ∈ (Subgroup.normalizer (right.range : Set (Model (ZMod 2)))) := by
  apply Subgroup.mem_normalizer_fintype
  rintro _ ⟨q,rfl⟩
  exact ⟨rightCubic q, (cubic_right q).symm⟩

theorem K_normalizes_right : K ≤ (Subgroup.normalizer (right.range : Set (Model (ZMod 2)))) :=
  sup_le right.range.le_normalizer (Subgroup.zpowers_le.mpr cubic_normalizes_right)

theorem right_mem (q : QuaternionGroup 2) : right q ∈ K := Subgroup.mem_sup_left ⟨q,rfl⟩
theorem cubic_mem : cubicActor ∈ K := Subgroup.mem_sup_right (Subgroup.mem_zpowers _)

theorem K_le_first : K ≤ firstParabolic := by
  apply sup_le
  · rintro _ ⟨q,rfl⟩
    exact core_le_firstParabolic ⟨rightEmbedding q,rfl⟩
  · exact Subgroup.zpowers_le.mpr cubicActor_mem

theorem K_le_derived : K ≤ commutator (Model (ZMod 2)) := by
  apply sup_le
  · rintro _ ⟨q,rfl⟩
    apply (embedding_mem_derived_iff _).mpr
    revert q
    decide +kernel
  · exact Subgroup.zpowers_le.mpr cubicActor_mem_derived

theorem K_fixes_left : K ≤ Subgroup.centralizer (left.range : Set (Model (ZMod 2))) := by
  apply sup_le
  · rintro _ ⟨q,rfl⟩
    apply Subgroup.mem_centralizer_iff.mpr
    rintro _ ⟨r,rfl⟩
    change embedding (leftEmbedding r) * embedding (rightEmbedding q) =
      embedding (rightEmbedding q) * embedding (leftEmbedding r)
    rw [← map_mul, ← map_mul]
    apply congrArg embedding
    exact quaternionData.commute _ ⟨r,rfl⟩ _ ⟨q,rfl⟩
  · apply Subgroup.zpowers_le.mpr
    apply Subgroup.mem_centralizer_iff.mpr
    rintro _ ⟨q,rfl⟩
    exact (mul_inv_eq_iff_eq_mul.mp (cubic_fixes_left q)).symm

theorem core_eq_sup : core = left.range ⊔ right.range := by
  rw [left, right, MonoidHom.range_comp, MonoidHom.range_comp, ← Subgroup.map_sup]
  change embedding.range = (quaternionData.left ⊔ quaternionData.right).map embedding
  rw [quaternionData.span]
  exact embedding.range_eq_map

theorem core_normalizes_K : core ≤ Subgroup.normalizer (K : Set (Model (ZMod 2))) := by
  rw [core_eq_sup]
  apply sup_le
  · exact (Subgroup.le_centralizer_iff.mp K_fixes_left).trans
      (Subgroup.centralizer_le_normalizer _)
  · exact (le_sup_left : right.range ≤ K).trans K.le_normalizer

theorem short_normalizes_K : shortRoot ∈ Subgroup.normalizer (K : Set (Model (ZMod 2))) := by
  have hr : shortRoot ∈ Subgroup.normalizer (right.range : Set (Model (ZMod 2))) := by
    apply Subgroup.mem_normalizer_fintype
    rintro _ ⟨q,rfl⟩
    have h : ∀ q : QuaternionGroup 2, shortConjugate (rightEmbedding q) ∈ rightEmbedding.range := by
      decide +kernel
    obtain ⟨r,hr⟩ := h q
    refine ⟨r, ?_⟩
    change embedding (rightEmbedding r) = shortRoot * embedding (rightEmbedding q) * shortRoot⁻¹
    rw [short_conjugate, hr]
  have hc : shortRoot ∈ Subgroup.normalizer (Subgroup.zpowers cubicActor : Set (Model (ZMod 2))) := by
    have hf : shortRoot⁻¹ = shortRoot :=
      inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using shortRoot_sq)
    have hs : (weylS : Model (ZMod 2))⁻¹ = weylS :=
      inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using weylS_sq)
    have he : shortRoot * cubicActor * shortRoot⁻¹ = cubicActor⁻¹ := by
      simp only [cubicActor, mul_inv_rev, hf, hs]
      have hff : shortRoot * shortRoot = 1 := by simpa only [pow_two] using shortRoot_sq
      simp only [← mul_assoc, hff, one_mul]
    apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
    rw [MonoidHom.map_zpowers]
    change Subgroup.zpowers (shortRoot * cubicActor * shortRoot⁻¹) = _
    rw [he, Subgroup.zpowers_inv]
  exact Subgroup.normalizer_inf_normalizer_le_normalizer_sup right.range
    (Subgroup.zpowers cubicActor) ⟨hr,hc⟩

theorem first_normalizes_K : firstParabolic ≤ (Subgroup.normalizer (K : Set (Model (ZMod 2)))) := by
  apply sup_le
  · rw [unipotent_eq_core_sup]
    exact sup_le core_normalizes_K ((Subgroup.closure_le _).mpr (by simpa using short_normalizes_K))
  · apply (Subgroup.closure_le _).mpr
    simp only [Set.singleton_subset_iff]
    have he : (weylS : Model (ZMod 2)) = shortRoot⁻¹ * cubicActor := by
      simp [cubicActor]
    rw [he]
    exact (Subgroup.normalizer (K : Set (Model (ZMod 2)))).mul_mem ((Subgroup.normalizer (K : Set (Model (ZMod 2)))).inv_mem short_normalizes_K)
      (K.le_normalizer cubic_mem)

instance K_normal : (K.subgroupOf firstParabolic).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer first_normalizes_K

theorem K_mul_form {g : Model (ZMod 2)} (hg : g ∈ K) :
    ∃ q : QuaternionGroup 2, ∃ c : Subgroup.zpowers cubicActor, right q * c = g := by
  have hset := Subgroup.coe_mul_of_right_le_normalizer_left right.range
    (Subgroup.zpowers cubicActor) (Subgroup.zpowers_le.mpr cubic_normalizes_right)
  rw [show K = right.range ⊔ Subgroup.zpowers cubicActor from rfl, ← SetLike.mem_coe, hset] at hg
  obtain ⟨_,⟨q,rfl⟩,c,hc,he⟩ := hg
  exact ⟨q,⟨c,hc⟩,he⟩

theorem card_right : Nat.card right.range = 8 := by
  rw [← Nat.card_congr (MonoidHom.ofInjective right_injective).toEquiv]
  rw [Nat.card_eq_fintype_card]
  decide +kernel

theorem right_disjoint_cubic : Disjoint right.range (Subgroup.zpowers cubicActor) :=
  Subgroup.disjoint_of_coprime_natCard (by rw [card_right, Nat.card_zpowers, cubicActor_order]; decide)

private def productMap (x : right.range × Subgroup.zpowers cubicActor) : K :=
  ⟨x.1 * x.2, K.mul_mem (Subgroup.mem_sup_left x.1.prop) (Subgroup.mem_sup_right x.2.prop)⟩

private theorem productMap_bijective : Function.Bijective productMap := by
  constructor
  · intro x y h
    apply Subgroup.mul_injective_of_disjoint right_disjoint_cubic
    exact congrArg Subtype.val h
  · intro g
    obtain ⟨q,c,h⟩ := K_mul_form g.prop
    exact ⟨(⟨right q,⟨q,rfl⟩⟩,c), Subtype.ext h⟩

theorem card_K : Nat.card K = 24 := by
  rw [← Nat.card_congr (Equiv.ofBijective productMap productMap_bijective), Nat.card_prod,
    card_right, Nat.card_zpowers, cubicActor_order]

/-- The commutators of the cubic with its quaternion factor generate that entire factor. -/
theorem K_le_of_normalizes (N : Subgroup (Model (ZMod 2)))
    (hn : right.range ≤ Subgroup.normalizer (N : Set (Model (ZMod 2))))
    (hc : cubicActor ∈ N) : K ≤ N := by
  apply sup_le
  · rintro _ ⟨q,rfl⟩
    have hd (r : QuaternionGroup 2) :
        embedding (rightEmbedding r * cubicConjugate (rightEmbedding r)⁻¹) ∈ N := by
      have hm := N.mul_mem ((Subgroup.mem_normalizer_iff.mp (hn ⟨r,rfl⟩) _).mp hc)
        (N.inv_mem hc)
      have he : right r * cubicActor * (right r)⁻¹ * cubicActor⁻¹ =
          embedding (rightEmbedding r * cubicConjugate (rightEmbedding r)⁻¹) := by
        change embedding (rightEmbedding r) * cubicActor * (embedding (rightEmbedding r))⁻¹ *
          cubicActor⁻¹ = _
        rw [← map_inv]
        calc
          _ = embedding (rightEmbedding r) *
              (cubicActor * embedding (rightEmbedding r)⁻¹ * cubicActor⁻¹) := by group
          _ = _ := by rw [cubic_conjugate, map_mul]
      rwa [he] at hm
    have hh : ∀ q : QuaternionGroup 2, ∃ r s : QuaternionGroup 2,
        rightEmbedding q =
          (rightEmbedding r * cubicConjugate (rightEmbedding r)⁻¹) *
          (rightEmbedding s * cubicConjugate (rightEmbedding s)⁻¹) := by decide +kernel
    obtain ⟨r,s,he⟩ := hh q
    change embedding (rightEmbedding q) ∈ N
    rw [he, map_mul]
    exact N.mul_mem (hd r) (hd s)
  · exact Subgroup.zpowers_le.mpr hc

theorem K_le_residual (L : Subgroup (Model (ZMod 2))) (hKL : K ≤ L) :
    K ≤ (pResidual 2 L).map L.subtype := by
  have hcL : cubicActor ∈ L := hKL cubic_mem
  apply K_le_of_normalizes
  · rintro _ ⟨q,rfl⟩
    apply Subgroup.le_normalizer_map L.subtype
    refine ⟨⟨right q, hKL (right_mem q)⟩, ?_, rfl⟩
    rw [Subgroup.normalizer_eq_top]
    trivial
  · refine ⟨⟨cubicActor,hcL⟩, ?_, rfl⟩
    apply Subgroup.mem_pResidual_of_orderOf_coprime
    rw [← orderOf_injective L.subtype L.subtype_injective]
    change Nat.Coprime 2 (orderOf cubicActor)
    rw [cubicActor_order]
    decide

theorem K_sup_unipotent : K ⊔ unipotent = firstParabolic := by
  apply le_antisymm (sup_le K_le_first unipotent_le_firstParabolic)
  apply sup_le le_sup_right
  apply (Subgroup.closure_le _).mpr
  simp only [Set.singleton_subset_iff]
  have he : (weylS : Model (ZMod 2)) = shortRoot⁻¹ * cubicActor := by simp [cubicActor]
  rw [he]
  exact (K ⊔ unipotent).mul_mem
    (Subgroup.mem_sup_right (unipotent.inv_mem shortRoot_mem_unipotent))
    (Subgroup.mem_sup_left cubic_mem)

theorem first_residual : (pResidual 2 firstParabolic).map firstParabolic.subtype = K := by
  apply le_antisymm ?_ (K_le_residual firstParabolic K_le_first)
  have hs : K.subgroupOf firstParabolic ⊔ unipotent.subgroupOf firstParabolic = ⊤ := by
    rw [← Subgroup.subgroupOf_sup K_le_first unipotent_le_firstParabolic,
      K_sup_unipotent, Subgroup.subgroupOf_self]
  have hp : IsPGroup 2 (unipotent.subgroupOf firstParabolic) :=
    (IsPGroup.of_card (show Nat.card (unipotent (K := ZMod 2)) = 2^6 from
      card_unipotent_binary)).of_equiv
        (Subgroup.subgroupOfEquivOfLe unipotent_le_firstParabolic).symm
  have hq := Subgroup.isPGroup_quotient_of_sup_eq_top (K.subgroupOf firstParabolic)
    (unipotent.subgroupOf firstParabolic) hp hs
  have hle : pResidual 2 firstParabolic ≤ K.subgroupOf firstParabolic :=
    sInf_le ⟨inferInstance, hq⟩
  rintro _ ⟨x,hx,rfl⟩
  exact hle hx

theorem derived_ambient_residual :
    (pResidual 2 derivedFirstAmbient).map derivedFirstAmbient.subtype = K := by
  apply le_antisymm ?_ (K_le_residual _ (le_inf K_le_first K_le_derived))
  rw [← first_residual]
  let f := Subgroup.inclusion (show derivedFirstAmbient ≤ firstParabolic from inf_le_left)
  rintro _ ⟨x,hx,rfl⟩
  exact ⟨f x, Subgroup.map_pResidual_le 2 f ⟨x,hx,rfl⟩, rfl⟩

theorem derived_residual :
    ((pResidual 2 derivedFirst).map derivedFirst.subtype).map DerivedModel.subtype = K := by
  have h := congrArg (Subgroup.map derivedFirstAmbient.subtype)
    (Subgroup.map_pResidual 2 derivedFirstEquiv)
  have hf : derivedFirstAmbient.subtype.comp derivedFirstEquiv.toMonoidHom =
      DerivedModel.subtype.comp derivedFirst.subtype := by ext x; rfl
  rw [Subgroup.map_map, hf, ← Subgroup.map_map, derived_ambient_residual] at h
  exact h

theorem K_form {g : Model (ZMod 2)} (hg : g ∈ K) :
    ∃ q : QuaternionGroup 2, ∃ n : Fin 3, right q * cubicActor ^ n.val = g := by
  classical
  obtain ⟨q,c,hc⟩ := K_mul_form hg
  have hm := (mem_zpowers_iff_mem_range_orderOf.mp c.prop)
  rw [cubicActor_order] at hm
  obtain ⟨n,hn,he⟩ := Finset.mem_image.mp hm
  exact ⟨q,⟨n,Finset.mem_range.mp hn⟩, by simpa only [he] using hc⟩

noncomputable def rightEquiv : QuaternionGroup 2 ≃* right.range :=
  MonoidHom.ofInjective right_injective

/-- Conjugation by the actual order-24 subgroup, on its embedded quaternion factor. -/
noncomputable def action : K →* MulAut (QuaternionGroup 2) :=
  (MulAut.congr rightEquiv.symm).toMonoidHom.comp
    (right.range.normalizerMonoidHom.comp (Subgroup.inclusion K_normalizes_right))

theorem action_spec (k : K) (q : QuaternionGroup 2) :
    right (action k q) = (k : Model (ZMod 2)) * right q * (k : Model (ZMod 2))⁻¹ := by
  change ((rightEquiv (rightEquiv.symm _)) : Model (ZMod 2)) = _
  rw [MulEquiv.apply_symm_apply]
  rfl

def rightInK : QuaternionGroup 2 →* K := right.codRestrict K right_mem
def cubicInK : K := ⟨cubicActor,cubic_mem⟩

theorem action_right (q : QuaternionGroup 2) : action (rightInK q) = MulAut.conj q := by
  ext r
  apply right_injective
  rw [action_spec]
  change right q * right r * (right q)⁻¹ = right (q*r*q⁻¹)
  simp only [map_mul, map_inv]

theorem action_cubic : action cubicInK = rightCubic := by
  ext q
  apply right_injective
  rw [action_spec]
  exact cubic_right q

theorem action_range : action.range =
    (MulAut.conj : QuaternionGroup 2 →* MulAut (QuaternionGroup 2)).range ⊔
      Subgroup.zpowers rightCubic := by
  apply le_antisymm
  · rintro _ ⟨k,rfl⟩
    obtain ⟨q,n,he⟩ := K_form k.prop
    have hk : k = rightInK q * cubicInK ^ n.val := Subtype.ext he.symm
    rw [hk,map_mul,map_pow,action_right,action_cubic]
    exact Subgroup.mul_mem_sup ⟨q,rfl⟩ (Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _)
  · apply sup_le
    · rintro _ ⟨q,rfl⟩
      exact ⟨rightInK q,action_right q⟩
    · exact Subgroup.zpowers_le.mpr ⟨cubicInK,action_cubic⟩

private theorem kernel_test (q : QuaternionGroup 2) (n : Fin 3) :
    (∀ r : QuaternionGroup 2, q * (rightCubic ^ n.val) r * q⁻¹ = r) ↔
      n = 0 ∧ (q = 1 ∨ q = QuaternionGroup.a 2) := by
  revert q n
  decide +kernel

theorem action_kernel : action.ker.map K.subtype = distinguished := by
  apply le_antisymm
  · rintro _ ⟨k,hk,rfl⟩
    obtain ⟨q,n,he⟩ := K_form k.prop
    have hke : k = rightInK q * cubicInK ^ n.val := Subtype.ext he.symm
    have ha : MulAut.conj q * rightCubic ^ n.val = 1 := by
      have hh := MonoidHom.mem_ker.mp hk
      simpa only [hke,map_mul,map_pow,action_right,action_cubic] using hh
    have ht : ∀ r : QuaternionGroup 2, q * (rightCubic ^ n.val) r * q⁻¹ = r :=
      fun r => DFunLike.congr_fun ha r
    obtain ⟨hn,hq⟩ := (kernel_test q n).mp ht
    subst n
    simp only [Fin.val_zero,pow_zero,mul_one] at he
    change (k : Model (ZMod 2)) ∈ distinguished
    rw [← he]
    rcases hq with hq | hq
    · rw [hq,map_one]; exact distinguished.one_mem
    · rw [hq]
      have hz : right (QuaternionGroup.a 2) = z := by
        change embedding (rightEmbedding (QuaternionGroup.a 2)) = z
        rw [show rightEmbedding (QuaternionGroup.a 2) = involution from rfl]
        exact embedding_involution
      rw [hz]
      exact Subgroup.mem_zpowers z
  · apply Subgroup.zpowers_le.mpr
    have hz : right (QuaternionGroup.a 2) = z := embedding_involution
    refine ⟨rightInK (QuaternionGroup.a 2), ?_, hz⟩
    apply MonoidHom.mem_ker.mpr
    rw [action_right]
    ext q
    revert q
    decide +kernel


theorem rightCubic_cube : rightCubic ^ 3 = 1 := by
  ext q
  revert q
  decide +kernel

theorem rightCubic_order : orderOf rightCubic = 3 := by
  apply orderOf_eq_prime rightCubic_cube
  intro h
  have he := DFunLike.congr_fun h (QuaternionGroup.a 1)
  exact (by decide +kernel : rightCubic (QuaternionGroup.a 1) ≠ QuaternionGroup.a 1) he

theorem card_action_range : Nat.card action.range = 12 := by
  have hk : Nat.card action.ker = 2 := by
    rw [Nat.card_congr (action.ker.equivMapOfInjective K.subtype K.subtype_injective).toEquiv,
      action_kernel, card_distinguished]
  have h := action.ker.card_mul_index
  rw [hk, Subgroup.index_ker, card_K] at h
  omega

theorem centralizer_right :
    K ⊓ Subgroup.centralizer (right.range : Set (Model (ZMod 2))) = distinguished := by
  rw [← action_kernel]
  ext g
  constructor
  · rintro ⟨hg,hc⟩
    refine ⟨⟨g,hg⟩, ?_, rfl⟩
    apply MonoidHom.mem_ker.mpr
    ext q
    apply right_injective
    rw [action_spec]
    exact mul_inv_eq_iff_eq_mul.mpr
      ((Subgroup.mem_centralizer_iff.mp hc) (right q) ⟨q,rfl⟩).symm
  · rintro ⟨k,hk,rfl⟩
    refine ⟨k.prop, Subgroup.mem_centralizer_iff.mpr ?_⟩
    rintro _ ⟨q,rfl⟩
    have hh := congrArg (fun a : MulAut (QuaternionGroup 2) => right (a q))
      (MonoidHom.mem_ker.mp hk)
    rw [action_spec] at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm

theorem distinguished_le_K : distinguished ≤ K := by
  rw [← action_kernel]
  exact Subgroup.map_subtype_le _

theorem centralizer_core :
    K ⊓ Subgroup.centralizer (core : Set (Model (ZMod 2))) = distinguished := by
  apply le_antisymm
  · rw [← centralizer_right]
    exact inf_le_inf_left K (Subgroup.centralizer_le (by
      rintro _ ⟨q,rfl⟩
      exact ⟨rightEmbedding q,rfl⟩))
  · apply le_inf distinguished_le_K
    apply Subgroup.zpowers_le.mpr
    exact Subgroup.mem_centralizer_iff.mpr z_centralizes_core

theorem centralizer_derivedCore :
    K ⊓ Subgroup.centralizer (derivedCore : Set (Model (ZMod 2))) = distinguished := by
  apply le_antisymm
  · rw [← centralizer_right]
    exact inf_le_inf_left K (Subgroup.centralizer_le (by
      rintro _ ⟨q,rfl⟩
      refine ⟨rightEmbedding q, ?_, rfl⟩
      change (rightEmbedding q).c = (rightEmbedding q).d
      revert q
      decide +kernel))
  · rw [← centralizer_core]
    exact inf_le_inf_left K (Subgroup.centralizer_le derivedCore_le_core)


/-- Both commuting quaternion factors retain their original ambient embeddings. -/
theorem core_product_form {g : Model (ZMod 2)} (hg : g ∈ core) :
    ∃ q r : QuaternionGroup 2, left q * right r = g := by
  have hn : right.range ≤ Subgroup.normalizer (left.range : Set (Model (ZMod 2))) :=
    ((le_sup_left : right.range ≤ K).trans K_fixes_left).trans
      (Subgroup.centralizer_le_normalizer _)
  have hset := Subgroup.coe_mul_of_right_le_normalizer_left left.range right.range hn
  rw [core_eq_sup, ← SetLike.mem_coe, hset] at hg
  obtain ⟨_,⟨q,rfl⟩,_,⟨r,rfl⟩,he⟩ := hg
  exact ⟨q,r,he⟩

theorem conjugate_core_product (k : K) (q r : QuaternionGroup 2) :
    (k : Model (ZMod 2)) * (left q * right r) * (k : Model (ZMod 2))⁻¹ =
      left q * right (action k r) := by
  have hcomm := Subgroup.mem_centralizer_iff.mp (K_fixes_left k.prop) (left q) ⟨q,rfl⟩
  rw [action_spec]
  calc
    _ = ((k : Model (ZMod 2)) * left q) * right r * (k : Model (ZMod 2))⁻¹ := by group
    _ = _ := by rw [← hcomm]; group

end Atlas.G2.BinaryParabolicPair.ResidualAction
