module

public import Theory.AtlasPort.LinearGroups.G2.BinaryParabolicPair.Levi
public import Theory.AtlasPort.LinearGroups.G2.BinaryParabolicPair.DerivedSylowCenter
public import Theory.GroupTheory.QuaternionCentralProductResidualRecognition.Residual

/-!
# Markings and orders of the binary derived parabolic pair

The short-root element lies outside the index-two commutator subgroup. Hence
restriction halves the orders of the positive-root Sylow subgroup and each
parabolic: they have orders 32, 96 and 96. The Sylow witness supplied by normal
restriction is exactly the original positive-root subgroup restricted to the
actual commutator, with its embeddings in both parabolics and indices three.

The central-involution calculation identifies Ω₁ of its center with the
original distinguished root subgroup. The original natural plane remains an
elementary abelian four-group, generated by the conjugates of the distinguished
involution under the restricted second parabolic. Its existing cubic actor
belongs to the two-residual and moves that involution.

Source: Aschbacher–Smith, Hypothesis 14.2.1 and Lemma 14.2.21, printed pp.981
and 988 (combined 1 March 2004 manuscript). Root coordinates and the signed
quotient are inherited from the licensed ATLAS port through the imports.
-/

@[expose] public section

namespace Atlas.G2.BinaryParabolicPair
open Atlas.G2.Explicit BinaryCore
open scoped IsMulCommutative
set_option maxRecDepth 100000

theorem shortRoot_not_mem_derived : shortRoot ∉ DerivedModel := by
  intro h
  apply quotientBit_ne_one
  exact (QuotientGroup.eq_one_iff _).mpr (commutator_eq_longRootClosure ▸ h)

private def restrictionSwap (H : Subgroup (Model (ZMod 2))) :
    H.subgroupOf DerivedModel ≃* DerivedModel.subgroupOf H where
  toFun x := ⟨⟨x.val.val, x.prop⟩, x.val.prop⟩
  invFun x := ⟨⟨x.val.val, x.prop⟩, x.val.prop⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

private theorem derived_relative_index (H : Subgroup (Model (ZMod 2)))
    (hH : shortRoot ∈ H) : (DerivedModel.subgroupOf H).index = 2 := by
  have hd : DerivedModel.relIndex H ∣ 2 := by
    have hi : DerivedModel.index = 2 := by
      rw [DerivedModel, commutator_eq_longRootClosure, BinaryException.index_H]
    have ht := DerivedModel.relIndex_dvd_index_of_normal H
    rw [hi] at ht
    exact ht
  apply (Nat.prime_two.eq_one_or_self_of_dvd _ hd).resolve_left
  intro he
  exact shortRoot_not_mem_derived ((Subgroup.relIndex_eq_one.mp he) hH)

private theorem card_restriction (H : Subgroup (Model (ZMod 2)))
    (hH : shortRoot ∈ H) : Nat.card (H.subgroupOf DerivedModel) * 2 = Nat.card H := by
  have hc := (DerivedModel.subgroupOf H).card_mul_index
  rw [derived_relative_index H hH,
    ← Nat.card_congr (restrictionSwap H).toEquiv] at hc
  exact hc

/-- The existing Sylow witness is precisely the subgroup obtained by restriction. -/
theorem derivedSylow_eq :
    (derivedSylow : Subgroup DerivedModel) = unipotent.subgroupOf DerivedModel := by
  apply Subgroup.map_injective DerivedModel.subtype_injective
  rw [derivedSylow_map_subtype, Subgroup.subgroupOf_map_subtype]
  rfl

theorem derivedFirst_map_subtype :
    derivedFirst.map DerivedModel.subtype = derivedFirstAmbient :=
  Subgroup.subgroupOf_map_subtype _ _

theorem derivedSecond_map_subtype :
    derivedSecond.map DerivedModel.subtype = derivedSecondAmbient :=
  Subgroup.subgroupOf_map_subtype _ _

theorem derived_parabolic_intersection_in_model :
    derivedFirst ⊓ derivedSecond = (derivedSylow : Subgroup DerivedModel) := by
  rw [derivedSylow_eq]
  change (firstParabolic ⊓ secondParabolic).subgroupOf DerivedModel = _
  rw [parabolic_intersection]

theorem derivedSylow_le_first : (derivedSylow : Subgroup DerivedModel) ≤ derivedFirst := by
  rw [derivedSylow_eq]
  exact Subgroup.subgroupOf_mono _ unipotent_le_firstParabolic

theorem derivedSylow_le_second : (derivedSylow : Subgroup DerivedModel) ≤ derivedSecond := by
  rw [derivedSylow_eq]
  exact Subgroup.subgroupOf_mono _ unipotent_le_parabolic

noncomputable def derivedFirstSylow : Sylow 2 derivedFirst :=
  derivedSylow.subtype derivedSylow_le_first

noncomputable def derivedSecondSylow : Sylow 2 derivedSecond :=
  derivedSylow.subtype derivedSylow_le_second

theorem derivedFirstSylow_map_subtype :
    (derivedFirstSylow : Subgroup derivedFirst).map derivedFirst.subtype = derivedSylow :=
  Subgroup.map_subgroupOf_eq_of_le derivedSylow_le_first

theorem derivedSecondSylow_map_subtype :
    (derivedSecondSylow : Subgroup derivedSecond).map derivedSecond.subtype = derivedSylow :=
  Subgroup.map_subgroupOf_eq_of_le derivedSylow_le_second

theorem card_derivedSylow : Nat.card derivedSylow = 32 := by
  have hc := card_restriction unipotent shortRoot_mem_unipotent
  rw [← derivedSylow_eq, card_unipotent_binary] at hc
  omega

theorem card_derivedFirst : Nat.card derivedFirst = 96 := by
  have hc := card_restriction firstParabolic
    (unipotent_le_firstParabolic shortRoot_mem_unipotent)
  rw [card_firstParabolic] at hc
  change Nat.card derivedFirst * 2 = 192 at hc
  omega

theorem card_derivedSecond : Nat.card derivedSecond = 96 := by
  have hc := card_restriction secondParabolic
    (unipotent_le_parabolic shortRoot_mem_unipotent)
  rw [secondParabolic_card] at hc
  change Nat.card derivedSecond * 2 = 192 at hc
  omega

theorem derivedSylow_index_in_first :
    ((derivedSylow : Subgroup DerivedModel).subgroupOf derivedFirst).index = 3 := by
  have hc := ((derivedSylow : Subgroup DerivedModel).subgroupOf derivedFirst).card_mul_index
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe derivedSylow_le_first).toEquiv,
    card_derivedSylow, card_derivedFirst] at hc
  omega

theorem derivedSylow_index_in_second :
    ((derivedSylow : Subgroup DerivedModel).subgroupOf derivedSecond).index = 3 := by
  have hc := ((derivedSylow : Subgroup DerivedModel).subgroupOf derivedSecond).card_mul_index
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe derivedSylow_le_second).toEquiv,
    card_derivedSylow, card_derivedSecond] at hc
  omega

/-- The original natural plane survives intact in the actual derived group. -/
theorem natural_le_derived : natural ≤ DerivedModel := by
  rintro g ⟨x, hx, rfl⟩
  exact (embedding_mem_derived_iff x).mpr (hx.1.trans hx.2.1.symm)

theorem distinguished_le_derived : distinguished ≤ DerivedModel :=
  distinguished_le_natural.trans natural_le_derived

def derivedNatural : Subgroup DerivedModel := natural.subgroupOf DerivedModel

def derivedDistinguished : Subgroup DerivedModel := distinguished.subgroupOf DerivedModel

theorem derivedNatural_map_subtype : derivedNatural.map DerivedModel.subtype = natural :=
  Subgroup.map_subgroupOf_eq_of_le natural_le_derived

theorem derivedDistinguished_map_subtype :
    derivedDistinguished.map DerivedModel.subtype = distinguished :=
  Subgroup.map_subgroupOf_eq_of_le distinguished_le_derived

theorem card_derivedNatural : Nat.card derivedNatural = 4 := by
  rw [derivedNatural, Nat.card_congr (Subgroup.subgroupOfEquivOfLe natural_le_derived).toEquiv,
    card_natural]

theorem card_derivedDistinguished : Nat.card derivedDistinguished = 2 := by
  rw [derivedDistinguished,
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe distinguished_le_derived).toEquiv,
    card_distinguished]

instance derivedNatural_elementary : IsElementaryAbelian 2 derivedNatural where
  is_comm := ⟨by
    intro a b
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun t : elementary => t.val) (mul_comm
      (⟨a.val.val, natural_le_elementary a.prop⟩ : elementary)
      (⟨b.val.val, natural_le_elementary b.prop⟩ : elementary))⟩
  exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (by
    intro x
    apply Subtype.ext
    apply Subtype.ext
    exact elemPow_eq_one_of_isElementaryAbelian x.val.val (natural_le_elementary x.prop))

theorem derivedDistinguished_le_natural : derivedDistinguished ≤ derivedNatural :=
  Subgroup.subgroupOf_mono _ distinguished_le_natural

theorem derivedNatural_le_sylow : derivedNatural ≤ (derivedSylow : Subgroup DerivedModel) := by
  rw [derivedSylow_eq]
  exact Subgroup.subgroupOf_mono _
    (natural_le_elementary.trans (elementary_le_core.trans core_le_unipotent))

theorem derivedSecond_normalizes_natural :
    derivedSecond ≤ Subgroup.normalizer (derivedNatural : Set DerivedModel) := by
  rw [Subgroup.le_normalizer_iff]
  intro g hg x hx
  exact (Subgroup.mem_normalizer_iff.mp
    (secondParabolic_normalizes_natural hg) x.val).mp hx

instance derivedNatural_normal : (derivedNatural.subgroupOf derivedSecond).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer derivedSecond_normalizes_natural

private theorem natural_coordinate_cases : ∀ x : naturalCoordinates,
    x.val = 1 ∨ x.val = involution ∨
    x.val = weylConjugate ⟨involution, involution_mem_elementary⟩ ∨
    x.val = involution * weylConjugate ⟨involution, involution_mem_elementary⟩ := by
  decide +kernel

private theorem natural_le_of_weyl_conjugate (E : Subgroup (Model (ZMod 2)))
    (hzE : z ∈ E) (hw : (weylR : Model (ZMod 2)) * z * weylR⁻¹ ∈ E) : natural ≤ E := by
  have he : embedding (weylConjugate ⟨involution, involution_mem_elementary⟩) ∈ E := by
    rw [← weyl_conjugate_elementary, embedding_involution]
    exact hw
  rintro _ ⟨x, hx, rfl⟩
  rcases natural_coordinate_cases ⟨x, hx⟩ with h | h | h | h
  · change x = _ at h
    rw [h, map_one]; exact E.one_mem
  · change x = _ at h
    rw [h, embedding_involution]; exact hzE
  · change x = _ at h
    rw [h]; exact he
  · change x = _ at h
    rw [h, map_mul, embedding_involution]; exact E.mul_mem hzE he

/-- The four-group is still generated by the conjugates of the marked involution:
every subgroup invariant under the restricted second parabolic and containing it
contains the actual natural plane. -/
theorem derivedNatural_minimal (N : Subgroup DerivedModel)
    (hN : derivedSecond ≤ Subgroup.normalizer (N : Set DerivedModel))
    (hz : (⟨z, rootA_one_mem_commutator⟩ : DerivedModel) ∈ N) : derivedNatural ≤ N := by
  apply (Subgroup.map_le_map_iff_of_injective DerivedModel.subtype_injective).mp
  rw [derivedNatural_map_subtype]
  let E := N.map DerivedModel.subtype
  have hzE : z ∈ E := ⟨⟨z,rootA_one_mem_commutator⟩, hz, rfl⟩
  have hwD : (weylR : Model (ZMod 2)) ∈ DerivedModel := by
    rw [DerivedModel, commutator_eq_longRootClosure]
    exact BinaryException.weylR_in_H
  let w : DerivedModel := ⟨weylR, hwD⟩
  have hwS : w ∈ derivedSecond := weylR_mem_parabolic
  have hwN : w * ⟨z,rootA_one_mem_commutator⟩ * w⁻¹ ∈ N :=
    (Subgroup.mem_normalizer_iff.mp (hN hwS) ⟨z,rootA_one_mem_commutator⟩).mp hz
  have hw : (weylR : Model (ZMod 2)) * z * weylR⁻¹ ∈ E := by
    have hm := Subgroup.mem_map_of_mem DerivedModel.subtype hwN
    rw [map_mul, map_mul, map_inv,
      show DerivedModel.subtype w = (weylR : Model (ZMod 2)) from rfl,
      show DerivedModel.subtype (⟨z,rootA_one_mem_commutator⟩ : DerivedModel) = z from rfl] at hm
    exact hm
  exact natural_le_of_weyl_conjugate E hzE hw

/-- The marked subgroup is Ω₁ of the center of the actual derived Sylow. -/
theorem derivedSylow_omega_center :
    (((omega₁ (Subgroup.center (derivedSylow : Subgroup DerivedModel)) (p := 2)).map
      (Subgroup.center (derivedSylow : Subgroup DerivedModel)).subtype).map
      (derivedSylow : Subgroup DerivedModel).subtype).map DerivedModel.subtype =
      distinguished := by
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap, Subgroup.map_le_iff_le_comap,
      Subgroup.map_le_iff_le_comap]
    apply (Subgroup.closure_le _).mpr
    intro x hx
    change x.val.val.val ∈ distinguished
    apply derivedSylowAmbient_central_involution_mem
    · exact ⟨derivedSylow_eq.le x.val.prop, x.val.val.prop⟩
    · exact congrArg (fun y : Subgroup.center (derivedSylow : Subgroup DerivedModel) =>
        y.val.val.val) hx
    · intro u hu
      let ud : DerivedModel := ⟨u, hu.2⟩
      have huS : ud ∈ (derivedSylow : Subgroup DerivedModel) := by
        rw [derivedSylow_eq]
        exact hu.1
      exact congrArg (fun y : (derivedSylow : Subgroup DerivedModel) => y.val.val)
        (Subgroup.mem_center_iff.mp x.prop ⟨ud,huS⟩)
  · apply Subgroup.zpowers_le.mpr
    let zd : DerivedModel := ⟨z, rootA_one_mem_commutator⟩
    have hzS : zd ∈ (derivedSylow : Subgroup DerivedModel) := by
      rw [derivedSylow_eq]
      exact core_le_unipotent (elementary_le_core z_mem_elementary)
    let zs : (derivedSylow : Subgroup DerivedModel) := ⟨zd,hzS⟩
    have hzC : zs ∈ Subgroup.center (derivedSylow : Subgroup DerivedModel) := by
      apply Subgroup.mem_center_iff.mpr
      intro g
      apply Subtype.ext
      apply Subtype.ext
      exact firstParabolic_centralizes_z g.val.val (derivedSylow_le_first g.prop)
    refine ⟨zd, ⟨zs, ⟨⟨zs,hzC⟩, ?_, rfl⟩, rfl⟩, rfl⟩
    apply Subgroup.subset_closure
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    change z ^ (2^1) = 1
    simpa [z_order] using pow_orderOf_eq_one z

theorem derivedSylow_omega_center_in_model :
    ((omega₁ (Subgroup.center (derivedSylow : Subgroup DerivedModel)) (p := 2)).map
      (Subgroup.center (derivedSylow : Subgroup DerivedModel)).subtype).map
      (derivedSylow : Subgroup DerivedModel).subtype = derivedDistinguished := by
  apply Subgroup.map_injective DerivedModel.subtype_injective
  rw [derivedSylow_omega_center, derivedDistinguished_map_subtype]

theorem movingActor_mem_derived : movingActor ∈ DerivedModel := by
  rw [DerivedModel, commutator_eq_longRootClosure]
  exact BinaryException.H.mul_mem (BinaryException.rootE_in_H 1) BinaryException.weylR_in_H

theorem movingActor_mem_derivedSecond :
    (⟨movingActor, movingActor_mem_derived⟩ : DerivedModel) ∈ derivedSecond := movingActor_mem

private theorem cubic_mem_twoResidual {G : Type*} [Group G] (a : G) (ha : a^3=1) :
    a ∈ pResidual 2 G :=
  Subgroup.mem_pResidual_of_orderOf_coprime
    (Nat.Coprime.of_dvd_right (orderOf_dvd_of_pow_eq_one ha) (by decide : Nat.Coprime 2 3))

theorem movingActor_derived_residual :
    (⟨⟨movingActor, movingActor_mem_derived⟩, movingActor_mem_derivedSecond⟩ : derivedSecond) ∈
      pResidual 2 derivedSecond :=
  cubic_mem_twoResidual _ (Subtype.ext (Subtype.ext movingActor_cube))

theorem movingActor_derived_moves :
    (⟨movingActor, movingActor_mem_derived⟩ : DerivedModel) *
      ⟨z, rootA_one_mem_commutator⟩ * (⟨movingActor, movingActor_mem_derived⟩ : DerivedModel)⁻¹ ≠
      ⟨z, rootA_one_mem_commutator⟩ := by
  intro h
  exact movingActor_moves (congrArg Subtype.val h)

end Atlas.G2.BinaryParabolicPair
