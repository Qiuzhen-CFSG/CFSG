public import Theory.AtlasPort.LinearGroups.G2.LieLongParabolic.Geometry
public import Theory.AtlasPort.LinearGroups.G2.LongRootNormalGeneration
public import Theory.AtlasPort.LinearGroups.G2.TorusNormalization
public import Theory.GroupTheory.SolvableResidual

/-!
# Perfectness of the long local subgroup

For a finite field of characteristic two and order greater than two, the group
`local₂` generated by the positive roots and the long Weyl element is perfect.
The torus elements `torus 1 m` fix the first vector, hence lie in this local
group. Their commutators give roots A, D and E. Long Weyl conjugation gives B
and F, and the F–E root identity then gives C despite its trivial torus
character. The long rank-one word finally puts the Weyl generator in the
local derived subgroup. All normalization used here is relative to `local₂`.

The exported residual is the intersection of the local derived series, mapped
back into the ambient group when stating `L₂ = L₂∞`.

Source: Aschbacher–Smith, F.1.12(II), printed pp. 263–264, especially the
perfectness assertion on p. 264. Root and rank-one identities are from the
licensed ATLAS port; the local argument adapts its torus-commutator method.
-/

@[expose] public section

open Atlas.SplitOctonion Atlas.G2 Atlas.G2.Explicit
open scoped commutatorElement
namespace Atlas.G2.LieParabolicSetup
variable {F : Type*} [Field F] [CharP F 2]

private theorem long_torus_mem_local₂ (m : Fˣ) : torus 1 m ∈ local₂ := by
  rw [local₂_eq_fixingFirstVector]
  change (torus 1 m).val (basisVector 0) = basisVector 0
  simpa using torus_first_basis (1 : Fˣ) m

omit [CharP F 2] in
private theorem long_root_mem_derived (X : F → Model F)
    (hadd : ∀ a b, X a * X b = X (a + b)) (hzero : X 0 = 1)
    (hmem : ∀ a, X a ∈ local₂) (g : Model F) (hg : g ∈ local₂)
    (c : F) (hc : c ≠ 1) (hconj : ∀ a, g * X a * g⁻¹ = X (c*a))
    (a : F) : X a ∈ ⁅local₂ (F := F), local₂ (F := F)⁆ := by
  have hinv (b : F) : X (-b) = (X b)⁻¹ := by
    apply eq_inv_of_mul_eq_one_left
    rw [hadd, neg_add_cancel, hzero]
  have he : ⁅g, X (a / (c-1))⁆ = X a := by
    rw [commutatorElement_def, hconj, ← hinv, hadd]
    congr 1
    field_simp
    ring
  rw [← he]
  exact Subgroup.commutator_mem_commutator hg (hmem _)

/-- The long local group is perfect in characteristic two when the field has more than two elements. -/
theorem local₂_isPerfect [Finite F] (hq : 2 < Nat.card F) :
    Group.IsPerfect (local₂ (F := F)) := by
  classical
  let := Fintype.ofFinite F
  have hc : ({0,1} : Finset F).card < (Finset.univ : Finset F).card := by
    simpa [Nat.card_eq_fintype_card] using hq
  obtain ⟨t, _, ht⟩ := Finset.exists_mem_notMem_of_card_lt_card hc
  have ht' : t ≠ 0 ∧ t ≠ 1 := by simpa using ht
  let m : Fˣ := Units.mk0 t ht'.1
  let H : Subgroup (Model F) := ⁅local₂ (F := F), local₂ (F := F)⁆
  have hR : (weylR : Model F) ∈ local₂ :=
    Subgroup.mem_sup_right (Subgroup.subset_closure (by simp))
  have hconj {x : Model F} (hx : x ∈ H) : weylR * x * weylR⁻¹ ∈ H := by
    have hn := Subgroup.normalizer_commutator_ge_left
      (local₂ (F := F)) (local₂ (F := F)) hR
    exact (Subgroup.mem_normalizer_iff.mp hn x).mp hx
  have hA (a : F) : rootA a ∈ H := by
    apply long_root_mem_derived rootA rootA_add rootA_zero
      (fun a => unipotent_le_local₂ (Subgroup.subset_closure (by simp)))
      (torus 1 m) (long_torus_mem_local₂ m) t ht'.2
    intro b
    simpa [m] using torus_rootA (1 : Fˣ) m b
  have hB (a : F) : rootB a ∈ H := by
    rw [← weylR_rootA]
    exact hconj (hA a)
  have hD (a : F) : rootD a ∈ H := by
    apply long_root_mem_derived rootD rootD_add rootD_zero
      (fun a => unipotent_le_local₂ (Subgroup.subset_closure (by simp)))
      (torus 1 m) (long_torus_mem_local₂ m) t ht'.2
    intro b
    simpa [m] using torus_rootD (1 : Fˣ) m b
  have ht2 : t^2 ≠ 1 := by
    intro he
    rcases (sq_eq_one_iff.mp he) with he | he
    · exact ht'.2 he
    · exact ht'.2 (by simpa only [CharTwo.neg_eq] using he)
  have hE (a : F) : rootE a ∈ H := by
    apply long_root_mem_derived rootE rootE_add rootE_zero
      (fun a => unipotent_le_local₂ (Subgroup.subset_closure (by simp)))
      (torus 1 m) (long_torus_mem_local₂ m) (t^2) ht2
    intro b
    simpa [m] using torus_rootE (1 : Fˣ) m b
  have hF (a : F) : rootF a ∈ H := by
    rw [← weylR_rootD]
    exact hconj (hD a)
  have hC (a : F) : rootC a ∈ H := by
    have hh := H.mul_mem (H.mul_mem (hF 1) (hE a)) (hF (-1))
    rw [rootF_conjugate_rootE] at hh
    simp only [one_pow, mul_one] at hh
    exact (H.mul_mem_cancel_left (H.mul_mem (hA _) (hB _))).mp
      ((H.mul_mem_cancel_right (hD _)).mp ((H.mul_mem_cancel_right (hE a)).mp hh))
  have hU : unipotent (K := F) ≤ H := by
    apply (Subgroup.closure_le H).mpr
    intro g hg
    rcases hg with (((((hg|hg)|hg)|hg)|hg)|hg)
    all_goals obtain ⟨a,rfl⟩ := hg
    · exact hA a
    · exact hB a
    · exact hC a
    · exact hD a
    · exact hE a
    · exact hF a
  have hRH : (weylR : Model F) ∈ H := by
    have hh := H.mul_mem (H.mul_mem (hE 1) (hconj (hE (-1)))) (hE 1)
    have hw := long_rank_one_word (1 : Fˣ)
    have hneg : (-1 : Fˣ) = 1 := by
      apply Units.ext
      simp [CharTwo.neg_eq]
    simp only [Units.val_one, inv_one, hneg, torus_identity, one_mul] at hw
    rwa [hw] at hh
  apply Subgroup.isPerfect_iff.mpr
  apply le_antisymm (Subgroup.commutator_le_self _)
  exact sup_le hU ((Subgroup.closure_le H).mpr (by simpa using hRH))

/-- The terminal derived subgroup inside the long local group is the whole group. -/
theorem local₂_solvableResidual_eq_top [Finite F] (hq : 2 < Nat.card F) :
    Subgroup.solvableResidual (local₂ (F := F)) = ⊤ := by
  let := local₂_isPerfect (F := F) hq
  exact Subgroup.solvableResidual_eq_top

/-- The source equality `L₂∞ = L₂`, with the residual embedded in the ambient group. -/
theorem local₂_map_solvableResidual [Finite F] (hq : 2 < Nat.card F) :
    (Subgroup.solvableResidual (local₂ (F := F))).map (local₂ (F := F)).subtype =
      local₂ (F := F) := by
  rw [local₂_solvableResidual_eq_top hq, ← MonoidHom.range_eq_map,
    Subgroup.range_subtype]

end Atlas.G2.LieParabolicSetup
