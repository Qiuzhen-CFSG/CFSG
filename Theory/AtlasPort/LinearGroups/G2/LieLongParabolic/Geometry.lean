public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Theory.AtlasPort.LinearGroups.G2.FieldTransport

/-!
# Geometry of the long local subgroup in characteristic two

The group generated by the positive roots and the long Weyl element is exactly
the stabilizer of the first singular vector. Indeed the long Weyl element is
an SL₂ block in characteristic two; transvections generate the opposite-vector
stabilizer, and the five-root partner reduction supplies the remaining factor.

The scalar character on the first singular line proves relative normality in
the full point parabolic, hence the literal product `P₂ = L₂ B`. The partner
chart gives a normal-form bijection with affine five-space times SL₂, and the
five-root factor is a two-group for finite fields. Coefficientwise transport
preserves both the local group and the five-root subgroup.

This module does not yet identify the five-root subgroup with the two-core or
construct the rank-one quotient; its factorization is a set product and its
normal form is an equivalence of sets, with no direct-product group assertion.

Source: Aschbacher--Smith, F.1.12(I)(3) and (II), printed pp. 262--264;
root coordinates and geometric reduction from the licensed ATLAS port.
-/

@[expose] public section

open Atlas.SplitOctonion Atlas.G2 Atlas.G2.Explicit Atlas.G2.PairStabilizer
open scoped MatrixGroups Pointwise
namespace Atlas.G2.LieParabolicSetup
variable {F : Type*} [Field F] [CharP F 2]
theorem long_block_J : blockHom (rankOneJ (F := F)) = weylR := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  funext i
  fin_cases i <;> simp [blockHom, blockEquiv, blockLinear, rankOneJ,
    weylR, weylREquiv, weylRLinear, weylRApply, CharTwo.neg_eq]
theorem block_mem_local₂ (M : SL(2,F)) : blockHom M ∈ local₂ := by
  have hJ : blockHom (rankOneJ (F := F)) ∈ local₂ := by
    rw [long_block_J]
    exact Subgroup.mem_sup_right (Subgroup.subset_closure (by simp))
  have hE (a : F) : rootE a ∈ local₂ :=
    unipotent_le_local₂ (Subgroup.subset_closure (by simp))
  apply Matrix.SL2.transvection_induction (fun M => blockHom M ∈ local₂) ?_ ?_ M
  · intro i j hij a
    fin_cases i <;> fin_cases j
    · exact (hij rfl).elim
    · change blockHom (upperSL a) ∈ local₂
      rw [block_upper]
      exact hE a
    · change blockHom (lowerSL a) ∈ local₂
      rw [lowerSL_conjugate, map_mul, map_mul, map_inv, block_upper]
      exact local₂.mul_mem (local₂.mul_mem hJ (hE _)) (local₂.inv_mem hJ)
    · exact (hij rfl).elim
  · intro A B hA hB
    rw [map_mul]
    exact local₂.mul_mem hA hB

theorem fixingPair_le_local₂ : fixingPair (F := F) ≤ local₂ := by
  intro g hg
  have he := congrArg Subtype.val (block_imageSL ⟨g,hg⟩)
  change blockHom (imageSL ⟨g,hg⟩) = g at he
  rw [← he]
  exact block_mem_local₂ _

theorem local₂_eq_fixingFirstVector : local₂ (F := F) = fixingFirstVector := by
  apply le_antisymm
  · apply sup_le unipotent_le_fixingFirstVector
    apply (Subgroup.closure_le _).mpr
    rintro g (rfl : g = weylR)
    change weylR.val (basisVector 0) = basisVector (F := F) 0
    funext i
    fin_cases i <;> simp [weylR, weylREquiv, weylRLinear, weylRApply,
      basisVector, CharTwo.neg_eq]
  · intro g hg
    let p : fixingFirstVector (K := F) := ⟨g,hg⟩
    have hn := fixingPair_le_local₂ (normalizedPair p).prop
    have hs := unipotent_le_local₂ (chartReducer_mem_unipotent (partnerOf p).val)
    have h := local₂.mul_mem (local₂.inv_mem hs) hn
    change (chartReducer (partnerOf p).val)⁻¹ *
      ((chartReducer (partnerOf p).val) * g) ∈ local₂ at h
    simpa only [inv_mul_cancel_left] using h

omit [CharP F 2] in
theorem local₂_le_parabolic₂ : local₂ (F := F) ≤ parabolic₂ := by
  rw [← local₂_sup_borel]
  exact le_sup_left

/-- Normality is inside the parabolic, not in the ambient G₂ group. -/
instance local₂_normal_in_parabolic₂ :
    ((local₂ (F := F)).subgroupOf parabolic₂).Normal := by
  rw [local₂_eq_fixingFirstVector]
  change ((fixingFirstVector (K := F)).subgroupOf parabolic).Normal
  rw [parabolic_eq_pointStabilizer]
  change ((fixingFirstVector (K := F)).comap pointStabilizer.subtype).Normal
  rw [← lineScalarHom_kernel]
  infer_instance

theorem parabolic₂_le_normalizer_local₂ :
    parabolic₂ (F := F) ≤ Subgroup.normalizer (local₂ (F := F)) :=
  Subgroup.le_normalizer_of_normal_subgroupOf local₂_le_parabolic₂

theorem borel_le_normalizer_local₂ : borel (K := F) ≤ Subgroup.normalizer (local₂ (F := F)) :=
  borel_le_parabolic₂.trans parabolic₂_le_normalizer_local₂

theorem parabolic₂_eq_local₂_mul_borel :
    (parabolic₂ (F := F) : Set (Model F)) =
      (local₂ (F := F) : Set (Model F)) * (borel (K := F) : Set (Model F)) := by
  rw [← local₂_sup_borel]
  exact Subgroup.coe_mul_of_right_le_normalizer_left _ _ borel_le_normalizer_local₂

omit [CharP F 2] in
theorem chartReducer_mem_radical₂ (x : Carrier F) : chartReducer x ∈ radical₂ := by
  have hA (a : F) : rootA a ∈ radical₂ :=
    ⟨![a,0,0,0,0,0], by simp, by simp [unipotentProduct]⟩
  have hB (a : F) : rootB a ∈ radical₂ :=
    ⟨![0,a,0,0,0,0], by simp, by simp [unipotentProduct]⟩
  have hC (a : F) : rootC a ∈ radical₂ :=
    ⟨![0,0,a,0,0,0], by simp, by simp [unipotentProduct]⟩
  have hD (a : F) : rootD a ∈ radical₂ :=
    ⟨![0,0,0,a,0,0], by simp, by simp [unipotentProduct]⟩
  have hF (a : F) : rootF a ∈ radical₂ :=
    ⟨![0,0,0,0,0,a], by simp, by simp [unipotentProduct]⟩
  exact radical₂.mul_mem (radical₂.mul_mem (radical₂.mul_mem
    (radical₂.mul_mem (hB _) (hA _)) (hC _)) (hD _)) (hF _)

/-- The five-root factor followed by the actual opposite-vector stabilizer. -/
theorem local₂_eq_radical₂_mul_fixingPair :
    (local₂ (F := F) : Set (Model F)) =
      (radical₂ (F := F) : Set (Model F)) * (fixingPair (F := F) : Set (Model F)) := by
  ext g
  constructor
  · intro hg
    have hfix : g ∈ fixingFirstVector := by rwa [← local₂_eq_fixingFirstVector]
    let p : fixingFirstVector (K := F) := ⟨g,hfix⟩
    refine ⟨(chartReducer (partnerOf p).val)⁻¹,
      radical₂.inv_mem (chartReducer_mem_radical₂ _), (normalizedPair p).val,
      (normalizedPair p).property, ?_⟩
    change (chartReducer (partnerOf p).val)⁻¹ *
      ((chartReducer (partnerOf p).val) * g) = g
    exact inv_mul_cancel_left _ _
  · rintro ⟨u, hu, m, hm, rfl⟩
    exact local₂.mul_mem (radical₂_le_local₂ hu) (fixingPair_le_local₂ hm)

/-- Partner-chart coordinates, as a bijection of sets. -/
noncomputable def local₂NormalForm :
    local₂ (F := F) ≃ (Fin 5 → F) × SL(2,F) :=
  (MulEquiv.subgroupCongr local₂_eq_fixingFirstVector).toEquiv |>.trans
    (fixingFirstVectorEquivPartners.trans (Equiv.prodCongr
      (singularPartnersEquiv F) fixingPairEquivSL2.toEquiv))

theorem card_local₂ [Finite F] :
    Nat.card (local₂ (F := F)) = Nat.card F ^ 5 * (Nat.card F * (Nat.card F ^ 2 - 1)) := by
  rw [Nat.card_congr local₂NormalForm, Nat.card_prod, Nat.card_fun, Nat.card_fin,
    Atlas.card_sl_two]

theorem radical₂_isTwoGroup [Finite F] : IsPGroup 2 (radical₂ (F := F)) := by
  obtain ⟨n, _, hn⟩ := field_card (F := F)
  apply IsPGroup.of_card (n := n * 5)
  rw [card_radical₂, hn, pow_mul]


variable {K : Type*} [Field K]

omit [CharP F 2] in
private theorem long_mapCoefficients_basis (e : F ≃+* K) (i : Fin 8) :
    mapCoefficients e (basisVector i) = basisVector i := by
  funext j
  simp [mapCoefficients, basisVector, Pi.single_apply, apply_ite e]

theorem local₂_field_mem_iff [CharP K 2] (e : F ≃+* K) (g : Model F) :
    fieldEquiv e g ∈ local₂ ↔ g ∈ local₂ := by
  rw [local₂_eq_fixingFirstVector, local₂_eq_fixingFirstVector]
  change (fieldEquiv e g).val (basisVector 0) = basisVector 0 ↔
    g.val (basisVector 0) = basisVector 0
  rw [← long_mapCoefficients_basis e 0, fieldEquiv_action]
  constructor
  · intro h
    funext i
    exact e.injective (congrFun h i)
  · intro h
    rw [h]

theorem local₂_field_map [CharP K 2] (e : F ≃+* K) :
    (local₂ (F := F)).map (fieldEquiv e).toMonoidHom = local₂ (F := K) := by
  ext g
  constructor
  · rintro ⟨h, hh, rfl⟩
    exact (local₂_field_mem_iff e h).mpr hh
  · intro hg
    refine ⟨(fieldEquiv e).symm g, ?_, (fieldEquiv e).apply_symm_apply g⟩
    apply (local₂_field_mem_iff e _).mp
    simpa only [MulEquiv.apply_symm_apply] using hg

/-- The long local groups are identified by coefficientwise field transport. -/
def local₂FieldEquiv [CharP K 2] (e : F ≃+* K) :
    local₂ (F := F) ≃* local₂ (F := K) :=
  ((fieldEquiv e).subgroupMap _).trans (MulEquiv.subgroupCongr (local₂_field_map e))

omit [CharP F 2] in
theorem long_field_unipotentProduct (e : F ≃+* K) (t : Fin 6 → F) :
    fieldEquiv e (unipotentProduct t) = unipotentProduct (e ∘ t) := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  funext i
  fin_cases i <;> simp [fieldEquiv, transportAutomorphism, transportLinear,
    mapCoefficients, unipotentProduct, rootA, rootB, rootC, rootD, rootE, rootF,
    rootAEquiv, rootBEquiv, rootCEquiv, rootDEquiv, rootEEquiv, rootFEquiv,
    rootALinear, rootBLinear, rootCLinear, rootDLinear, rootELinear, rootFLinear,
    rootAApply, rootBApply, rootCApply, rootDApply, rootEApply, rootFApply]

omit [CharP F 2] in
theorem radical₂_field_map (e : F ≃+* K) :
    (radical₂ (F := F)).map (fieldEquiv e).toMonoidHom = radical₂ (F := K) := by
  ext g
  constructor
  · rintro ⟨h, ⟨t, ht, rfl⟩, rfl⟩
    exact ⟨e ∘ t, by simp [ht], (long_field_unipotentProduct e t).symm⟩
  · rintro ⟨t, ht, rfl⟩
    refine ⟨unipotentProduct (e.symm ∘ t), ⟨_, by simp [ht], rfl⟩, ?_⟩
    change fieldEquiv e (unipotentProduct (e.symm ∘ t)) = unipotentProduct t
    rw [long_field_unipotentProduct]
    congr 1
    funext i
    exact e.apply_symm_apply _

end Atlas.G2.LieParabolicSetup
