module

public import Theory.AtlasPort.LinearGroups.G2.BinaryNaturalPlane
public import Theory.AtlasPort.LinearGroups.G2.Order
public import Mathlib.GroupTheory.Sylow

/-!
# The first binary G₂ parabolic and its explicit quaternion action

The short-root parabolic is generated by the six positive root groups and
`weylS`. Its five-root subgroup is normal, and the same positive-root
subgroup is a Sylow two-subgroup of both parabolics. Conjugation by `rootF 1`
and `weylS` is computed on all five coordinates. Their product is a cubic
in the two-residual, fixing the left quaternion factor and rotating the right.

The proofs use the unique positive-root coordinates and the action on the
split-octonion basis. All finite coordinate checks are kernel checked.
Source: Aschbacher–Smith, Lemma 14.2.21, printed p.988 (PDF p.1005).
Root conventions follow the licensed ATLAS port imported above.
-/

@[expose] public section

open Atlas.G2.Explicit
namespace Atlas.G2.BinaryParabolicPair
open BinaryCore
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

/-- The short-root parabolic, with the same positive roots as the second one. -/
def firstParabolic : Subgroup (Model (ZMod 2)) :=
  unipotent ⊔ Subgroup.closure {weylS}

def shortRoot : Model (ZMod 2) := rootF 1

def cubicActor : Model (ZMod 2) := shortRoot * weylS

theorem shortRoot_mem_unipotent : shortRoot ∈ unipotent :=
  Subgroup.subset_closure (by simp [shortRoot])

theorem unipotent_le_firstParabolic : unipotent (K := ZMod 2) ≤ firstParabolic := le_sup_left

theorem weylS_mem_firstParabolic : (weylS : Model (ZMod 2)) ∈ firstParabolic :=
  Subgroup.mem_sup_right (Subgroup.subset_closure (by simp))

theorem cubicActor_mem : cubicActor ∈ firstParabolic :=
  firstParabolic.mul_mem (unipotent_le_firstParabolic shortRoot_mem_unipotent)
    weylS_mem_firstParabolic

def shortConjugate (x : Coordinates) : Coordinates :=
  ⟨x.a+x.d+x.d*x.e+x.e,x.b+x.c+x.d+x.e,x.c+x.e,x.d+x.e,x.e⟩

def reflectionConjugate (x : Coordinates) : Coordinates :=
  ⟨x.a+x.b*x.e+x.c*x.d,x.e,x.d,x.c,x.b⟩

def cubicConjugate (x : Coordinates) : Coordinates := shortConjugate (reflectionConjugate x)

theorem reflection_conjugate (x : Coordinates) :
    (weylS : Model (ZMod 2))*embedding x*weylS⁻¹ = embedding (reflectionConjugate x) := by
  apply Subtype.ext
  apply LinearEquiv.toLinearMap_injective
  apply (Pi.basisFun (ZMod 2) (Fin 8)).ext
  intro j
  funext i
  simp only [Pi.basisFun_apply]
  revert x j i
  decide +kernel

theorem short_conjugate (x : Coordinates) :
    shortRoot*embedding x*shortRoot⁻¹ = embedding (shortConjugate x) := by
  apply Subtype.ext
  apply LinearEquiv.toLinearMap_injective
  apply (Pi.basisFun (ZMod 2) (Fin 8)).ext
  intro j
  funext i
  simp only [Pi.basisFun_apply]
  revert x j i
  decide +kernel

theorem cubic_conjugate (x : Coordinates) :
    cubicActor*embedding x*cubicActor⁻¹ = embedding (cubicConjugate x) := by
  calc
    _ = shortRoot * (weylS * embedding x * weylS⁻¹) * shortRoot⁻¹ := by
      unfold cubicActor
      group
    _ = _ := by rw [reflection_conjugate, short_conjugate]; rfl

theorem shortRoot_sq : shortRoot ^ 2 = 1 := by
  rw [shortRoot, pow_two, rootF_add, show (1 : ZMod 2)+1=0 by decide, rootF_zero]

theorem cubicActor_cube : cubicActor ^ 3 = 1 := by
  apply Subtype.ext
  apply LinearEquiv.toLinearMap_injective
  apply (Pi.basisFun (ZMod 2) (Fin 8)).ext
  intro j
  funext i
  simp only [Pi.basisFun_apply]
  revert j i
  decide +kernel

private theorem normalizes_of_involution (g : Model (ZMod 2)) (hg : g^2=1)
    (f : Coordinates → Coordinates)
    (hf : ∀ x, g*embedding x*g⁻¹ = embedding (f x)) :
    g ∈ Subgroup.normalizer (core : Set (Model (ZMod 2))) := by
  have hmem : ∀ a ∈ core, g*a*g⁻¹ ∈ core := by
    rintro _ ⟨x,rfl⟩
    exact ⟨f x, (hf x).symm⟩
  apply Subgroup.mem_normalizer_iff.mpr
  intro a
  constructor
  · exact hmem a
  · intro ha
    have hh := hmem _ ha
    have he : g*(g*a*g⁻¹)*g⁻¹ = a := by
      calc
        _ = (g*g)*a*(g*g)⁻¹ := by group
        _ = a := by rw [← pow_two, hg]; simp
    rwa [he] at hh

theorem shortRoot_normalizes_core :
    shortRoot ∈ Subgroup.normalizer (core : Set (Model (ZMod 2))) :=
  normalizes_of_involution shortRoot shortRoot_sq shortConjugate short_conjugate

theorem weylS_normalizes_core :
    (weylS : Model (ZMod 2)) ∈ Subgroup.normalizer (core : Set (Model (ZMod 2))) :=
  normalizes_of_involution weylS weylS_sq reflectionConjugate reflection_conjugate

theorem unipotent_eq_core_sup : unipotent (K := ZMod 2) =
    core ⊔ Subgroup.closure {shortRoot} := by
  apply le_antisymm
  · intro g hg
    rw [unipotent_eq_range] at hg
    obtain ⟨t,rfl⟩ := hg
    have he : unipotentProduct t = embedding ⟨t 0,t 1,t 2,t 3,t 4⟩ * rootF (t 5) := by
      simp [embedding, parameters, unipotentProduct]
    rw [he]
    apply Subgroup.mul_mem_sup (show embedding ⟨t 0,t 1,t 2,t 3,t 4⟩ ∈ core from ⟨_, rfl⟩)
    have hb : ∀ a : ZMod 2, a=0 ∨ a=1 := by decide +kernel
    rcases hb (t 5) with h | h
    · rw [h, rootF_zero]; exact Subgroup.one_mem _
    · rw [h]; exact Subgroup.subset_closure (by simp [shortRoot])
  · exact sup_le core_le_unipotent ((Subgroup.closure_le _).mpr (by
      simpa using shortRoot_mem_unipotent))

theorem firstParabolic_normalizes_core :
    firstParabolic ≤ Subgroup.normalizer (core : Set (Model (ZMod 2))) := by
  apply sup_le
  · rw [unipotent_eq_core_sup]
    exact sup_le core.le_normalizer ((Subgroup.closure_le _).mpr (by
      simpa using shortRoot_normalizes_core))
  · exact (Subgroup.closure_le _).mpr (by simpa using weylS_normalizes_core)

theorem core_le_firstParabolic : core ≤ firstParabolic :=
  core_le_unipotent.trans unipotent_le_firstParabolic

instance core_normal : (core.subgroupOf firstParabolic).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer firstParabolic_normalizes_core

theorem cubic_fixes_left (q : QuaternionGroup 2) :
    cubicActor * embedding (leftEmbedding q) * cubicActor⁻¹ = embedding (leftEmbedding q) := by
  rw [cubic_conjugate]
  congr 1
  revert q
  decide +kernel

theorem cubic_rightI : cubicActor * embedding rightI * cubicActor⁻¹ =
    embedding ((rightI*rightJ)⁻¹) := by
  rw [cubic_conjugate]
  congr 1

theorem cubic_rightJ : cubicActor * embedding rightJ * cubicActor⁻¹ = embedding rightI := by
  rw [cubic_conjugate]
  congr 1

theorem cubicActor_order : orderOf cubicActor = 3 := by
  apply orderOf_eq_prime cubicActor_cube
  intro h
  have he := cubic_rightJ
  rw [h, one_mul, inv_one, mul_one] at he
  have hi := embedding_injective he
  exact (by decide +kernel : rightJ ≠ rightI) hi

theorem cubicActor_residual :
    (⟨cubicActor, cubicActor_mem⟩ : firstParabolic) ∈ pResidual 2 firstParabolic := by
  apply Subgroup.mem_sInf.mpr
  rintro N ⟨hN,hP⟩
  let := hN
  let a : firstParabolic := ⟨cubicActor,cubicActor_mem⟩
  let b := QuotientGroup.mk' N a
  have hb3 : b^3=1 := by
    change (QuotientGroup.mk' N a)^3=1
    rw [← map_pow, show a^3=1 from Subtype.ext cubicActor_cube, map_one]
  obtain ⟨k,hk⟩ := hP b
  apply (QuotientGroup.eq_one_iff a).mp
  change b=1
  apply orderOf_eq_one_iff.mp
  exact Nat.eq_one_of_dvd_coprimes (show Nat.Coprime 3 (2^k) from
    (by decide : Nat.Coprime 3 2).pow_right k)
    (orderOf_dvd_of_pow_eq_one hb3) (orderOf_dvd_of_pow_eq_one hk)

theorem card_unipotent_binary : Nat.card (unipotent (K := ZMod 2)) = 64 := by
  rw [card_unipotent, Nat.card_eq_fintype_card, ZMod.card]
  norm_num

theorem index_unipotent_binary : (unipotent (K := ZMod 2)).index = 189 := by
  have hc := (unipotent (K := ZMod 2)).card_mul_index
  rw [card_unipotent_binary, card_Model, Nat.card_eq_fintype_card, ZMod.card] at hc
  omega

/-- The common ambient Sylow two-subgroup, with its original positive-root embedding. -/
noncomputable def commonSylow : Sylow 2 (Model (ZMod 2)) :=
  (IsPGroup.of_card (show Nat.card (unipotent (K := ZMod 2)) = 2^6 from
    card_unipotent_binary)).toSylow (by rw [index_unipotent_binary]; decide)

theorem commonSylow_eq : (commonSylow : Subgroup (Model (ZMod 2))) = unipotent := rfl

theorem commonSylow_le_first : (commonSylow : Subgroup (Model (ZMod 2))) ≤ firstParabolic :=
  unipotent_le_firstParabolic

theorem commonSylow_le_second : (commonSylow : Subgroup (Model (ZMod 2))) ≤ secondParabolic :=
  unipotent_le_parabolic

end Atlas.G2.BinaryParabolicPair
