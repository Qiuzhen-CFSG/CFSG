public import Theory.AtlasPort.LinearGroups.G2.ShortRootProducts.CentralizerCore.Block

/-!
# The short-root centralizer inside the long parabolic

The parabolic factorization writes an element as a scalar torus element,
a five-root element, and an SL₂ block. Commutation with a nonzero C root
forces the scalar to be one and the D and F coordinates to vanish.
Consequently the relative centralizer is generated by the embedded affine
block and the C root group. These two subgroups commute, the C root group
is a two-group, and the block is perfect when the field has more than two
elements. Its image is therefore exactly the relative centralizer's
two-residual. All normality assertions are relative to that centralizer.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), 16.1.4(1), printed p.1171, and the final case (a),
printed pp.1202–1203. Containment of the full centralizer in this parabolic
is a separate geometric assertion; it is not assumed as a conclusion here.
-/

@[expose] public section

open Subgroup Atlas.SplitOctonion
open scoped MatrixGroups Pointwise
namespace Atlas.G2.ShortRootProducts.CentralizerCore
open LieParabolicSetup PairStabilizer Explicit
variable {F : Type*} [Field F] [CharP F 2]

theorem block_commute_rootC (M : SL(2,F)) (a : F) : Commute (blockHom M) (rootC a) := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  funext i
  fin_cases i <;> simp [blockHom, blockEquiv, blockLinear,
    rootC, rootCEquiv, rootCLinear, rootCApply, CharTwo.neg_eq, CharTwo.sub_eq_add] <;> ring

private theorem longRoot_commute_rootC (p : Multiplicative (F × F)) (a : F) :
    Commute (longRootHom p) (rootC a) := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  funext i
  fin_cases i <;> simp [longRootHom, rootA, rootB, rootC, rootAEquiv, rootBEquiv, rootCEquiv,
    rootALinear, rootBLinear, rootCLinear, rootAApply, rootBApply, rootCApply,
    CharTwo.neg_eq, CharTwo.sub_eq_add] <;> ring

theorem residualBlock_le_centralizer_rootC (a : F) :
    residualBlock (F := F) ≤ centralizer ({rootC a} : Set (Model F)) := by
  apply sup_le
  · rintro _ ⟨p,rfl⟩
    exact mem_centralizer_singleton_iff.mpr (longRoot_commute_rootC p a).eq
  · rintro _ ⟨M,rfl⟩
    exact mem_centralizer_singleton_iff.mpr (block_commute_rootC M a).eq

private theorem parabolic_factor (g : parabolic₂ (F := F)) :
    ∃ (l : Fˣ) (t : Fin 6 → F) (M : SL(2,F)), t 4 = 0 ∧
      g.val = torus l 1 * (unipotentProduct t * blockHom M) := by
  let gp : pointStabilizer (K := F) :=
    ⟨g.val, by rw [← parabolic_eq_pointStabilizer]; exact g.property⟩
  let h : fixingFirstVector (K := F) := normalizePoint gp
  have hl : h.val ∈ local₂ := by rw [local₂_eq_fixingFirstVector]; exact h.property
  rw [← SetLike.mem_coe, local₂_eq_radical₂_mul_fixingPair] at hl
  obtain ⟨u, ⟨t, ht, rfl⟩, m, hm, he⟩ := hl
  refine ⟨lineScalar gp, t, imageSL ⟨m, hm⟩, ht, ?_⟩
  have hb := congrArg Subtype.val (block_imageSL ⟨m, hm⟩)
  change blockHom (imageSL ⟨m, hm⟩) = m at hb
  change unipotentProduct t * m = h.val at he
  rw [hb, he]
  change g.val = torus (lineScalar gp) 1 * ((torus (lineScalar gp) 1)⁻¹ * g.val)
  exact (mul_inv_cancel_left _ _).symm

set_option maxHeartbeats 800000 in
private theorem factor_scalar (a : F) (ha : a ≠ 0) (l : Fˣ) (t : Fin 6 → F)
    (M : SL(2,F)) (ht : t 4 = 0)
    (hc : Commute (torus l 1 * (unipotentProduct t * blockHom M)) (rootC a)) : l = 1 := by
  have h := congrArg (fun g : Model F => g.val (basisVector 7) 3) hc.eq
  simp [unipotentProduct, rootA, rootB, rootC, rootD, rootE, rootF,
    rootAEquiv, rootBEquiv, rootCEquiv, rootDEquiv, rootEEquiv, rootFEquiv,
    rootALinear, rootBLinear, rootCLinear, rootDLinear, rootELinear, rootFLinear,
    rootAApply, rootBApply, rootCApply, rootDApply, rootEApply, rootFApply,
    torus, torusEquiv, torusLinear, torusWeights, blockHom, blockEquiv, blockLinear,
    basisVector, ht, CharTwo.neg_eq, CharTwo.sub_eq_add] at h
  apply Units.ext
  apply inv_eq_one.mp
  apply (mul_left_cancel₀ ha)
  simp only [mul_one]
  linear_combination -h

private theorem unipotent_centralizer_coordinates (a : F) (ha : a ≠ 0)
    (t : Fin 6 → F) (ht : t 4 = 0) (hc : Commute (unipotentProduct t) (rootC a)) :
    t 3 = 0 ∧ t 5 = 0 := by
  have hC : rootC a = unipotentProduct ![0,0,a,0,0,0] := by simp [unipotentProduct]
  have he := hc.eq
  rw [hC, unipotentProduct_mul, unipotentProduct_mul] at he
  have he' := unipotentProduct_injective he
  have h0 := congrFun he' 0
  have h1 := congrFun he' 1
  have h3 : (3 : F) = 1 := by
    have h := CharTwo.add_self_eq_zero (1 : F)
    linear_combination h
  simp [unipotentProductParameters, ht, h3, CharTwo.sub_eq_add] at h0 h1
  exact ⟨h0.resolve_left ha, h1.resolve_left ha⟩

theorem parabolic_centralizer_factor (a : F) (ha : a ≠ 0) {g : Model F}
    (hg : g ∈ parabolic₂) (hc : g ∈ centralizer ({rootC a} : Set (Model F))) :
    ∃ (p : Multiplicative (F × F)) (c : F) (M : SL(2,F)),
      g = longRootHom p * rootC c * blockHom M := by
  obtain ⟨l,t,M,ht,he⟩ := parabolic_factor ⟨g,hg⟩
  change g = _ at he
  have hcomm : Commute g (rootC a) := mem_centralizer_singleton_iff.mp hc
  have hl : l = 1 := factor_scalar a ha l t M ht (he ▸ hcomm)
  rw [hl, show torus (1 : Fˣ) 1 = 1 from torus_identity, one_mul] at he
  have hu : Commute (unipotentProduct t) (rootC a) := by
    have hh := (he ▸ hcomm).mul_left (block_commute_rootC M a).inv_left
    simpa only [mul_inv_cancel_right] using hh
  obtain ⟨h3,h5⟩ := unipotent_centralizer_coordinates a ha t ht hu
  refine ⟨Multiplicative.ofAdd (t 0,t 1), t 2, M, ?_⟩
  simpa [unipotentProduct, longRootHom, ht, h3, h5] using he

omit [CharP F 2] in
def shortRootHom : Multiplicative F →* Model F where
  toFun c := rootC c.toAdd
  map_one' := rootC_zero
  map_mul' c d := (Atlas.G2.rootC_add c.toAdd d.toAdd).symm

def shortRootGroup : Subgroup (Model F) := shortRootHom.range

def centralizerProduct : Subgroup (Model F) := residualBlock ⊔ shortRootGroup

omit [CharP F 2] in
theorem shortRootGroup_le_unipotent : shortRootGroup (F := F) ≤ unipotent := by
  rintro _ ⟨c,rfl⟩
  exact subset_closure (by simp [shortRootHom])

omit [CharP F 2] in
theorem shortRootGroup_le_centralizer_rootC (a : F) :
    shortRootGroup (F := F) ≤ centralizer ({rootC a} : Set (Model F)) := by
  rintro _ ⟨c,rfl⟩
  apply mem_centralizer_singleton_iff.mpr
  change rootC c.toAdd * rootC a = rootC a * rootC c.toAdd
  rw [Atlas.G2.rootC_add, Atlas.G2.rootC_add, add_comm]

theorem shortRootGroup_isTwoGroup : IsPGroup 2 (shortRootGroup (F := F)) := by
  rintro ⟨g,⟨c,rfl⟩⟩
  refine ⟨1, Subtype.ext ?_⟩
  change (rootC c.toAdd) ^ (2 ^ 1) = 1
  rw [pow_one, pow_two, Atlas.G2.rootC_add, CharTwo.add_self_eq_zero, rootC_zero]

theorem centralizerProduct_le_parabolic : centralizerProduct (F := F) ≤ parabolic₂ :=
  sup_le (residualBlock_le_local.trans local₂_le_parabolic₂)
    (shortRootGroup_le_unipotent.trans (unipotent_le_local₂.trans local₂_le_parabolic₂))

theorem centralizerProduct_le_centralizer (a : F) :
    centralizerProduct (F := F) ≤ centralizer ({rootC a} : Set (Model F)) :=
  sup_le (residualBlock_le_centralizer_rootC a) (shortRootGroup_le_centralizer_rootC a)

theorem parabolic_inf_centralizer_rootC (a : F) (ha : a ≠ 0) :
    parabolic₂ ⊓ centralizer ({rootC a} : Set (Model F)) = centralizerProduct := by
  apply le_antisymm
  · intro g hg
    obtain ⟨p,c,M,rfl⟩ := parabolic_centralizer_factor a ha hg.1 hg.2
    apply mul_mem
    · exact mul_mem (mem_sup_left (mem_sup_left ⟨p,rfl⟩))
        (mem_sup_right ⟨Multiplicative.ofAdd c, rfl⟩)
    · exact mem_sup_left (mem_sup_right ⟨M,rfl⟩)
  · exact le_inf centralizerProduct_le_parabolic (centralizerProduct_le_centralizer a)

theorem shortRootGroup_le_blockNormalizer :
    shortRootGroup (F := F) ≤ normalizer (residualBlock (F := F) : Set (Model F)) := by
  apply le_trans ?_ (centralizer_le_normalizer _)
  rintro _ ⟨c,rfl⟩
  apply mem_centralizer_iff.mpr
  intro g hg
  exact mem_centralizer_singleton_iff.mp (residualBlock_le_centralizer_rootC c.toAdd hg)

instance residualBlock_normal_in_product :
    ((residualBlock (F := F)).subgroupOf centralizerProduct).Normal := by
  apply (normal_subgroupOf_iff_le_normalizer (show residualBlock ≤ centralizerProduct (F := F)
    from le_sup_left)).mpr
  exact sup_le (residualBlock (F := F)).le_normalizer shortRootGroup_le_blockNormalizer

theorem centralizerProduct_twoResidual [Finite F] (hq : 2 < Nat.card F) :
    (pResidual 2 (centralizerProduct (F := F))).map centralizerProduct.subtype = residualBlock := by
  have hle : residualBlock ≤ centralizerProduct (F := F) := le_sup_left
  have he := pResidual_eq_of_isPPerfect_sup
    ((residualBlock (F := F)).subgroupOf centralizerProduct)
    ((shortRootGroup (F := F)).subgroupOf centralizerProduct)
    ((residualBlock_isTwoPerfect (F := F) hq).of_surjective
      (subgroupOfEquivOfLe hle).symm.toMonoidHom (subgroupOfEquivOfLe hle).symm.surjective)
    shortRootGroup_isTwoGroup.comap_subtype (codisjoint_subgroupOf_sup _ _).eq_top
  rw [he, map_subgroupOf_eq_of_le hle]

end Atlas.G2.ShortRootProducts.CentralizerCore
