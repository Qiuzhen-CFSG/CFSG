module

public import Theory.AtlasPort.OtherSporadic.Codes.TernaryGolayQuotient
public import Mathlib.LinearAlgebra.Dimension.Finite

/-!
# TernaryGlobalConstants

Constant codewords form the scalar line generated by the all-one word.
The span characterization and dimension formula give its three elements.

Source: Gerald Höhn, ATLAS, `Atlas/Codes/TernaryGlobalConstants.lean`, revision
`8eabb35afe2b5e45bf913a2d05c53e558d2e2917`.
Adapted to CFSG Lean 4.33.0 with public imports and exposed computational definitions.
-/

@[expose] public section


namespace Atlas.Codes

theorem ternaryConstants_mem_iff (t : ternaryGolay) :
    t ∈ ternaryConstants ↔ ∃ b : ZMod 3,∀ i,t.val i=b := by
  rw [ternaryConstants,Submodule.mem_span_singleton]
  constructor
  · rintro ⟨b,hb⟩
    refine ⟨b,?_⟩
    intro i
    have h := congrArg (fun w : ternaryGolay => w.val i) hb
    change b*1=t.val i at h
    simpa using h.symm
  · rintro ⟨b,hb⟩
    refine ⟨b,Subtype.ext (funext fun i => ?_)⟩
    change b*1=t.val i
    simpa using (hb i).symm

theorem ternaryConstants_card : Nat.card ternaryConstants=3 := by
  classical
  let := Fintype.ofFinite ternaryConstants
  rw [Nat.card_eq_fintype_card,Module.card_eq_pow_finrank (K := ZMod 3),ternaryConstants_finrank]
  norm_num

end Atlas.Codes
