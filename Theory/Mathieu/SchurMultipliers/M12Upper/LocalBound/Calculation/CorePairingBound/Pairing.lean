module

public import Theory.Mathieu.SchurMultipliers.M12Upper.LocalBound.Calculation.CorePairingBound.Coordinates

/-!
# The invariant binary pairing on the marked M₁₂ core

For an alternating exponent-two pairing into any commutative group, invariance
under the two actual parabolic actors forces its six coefficients to be
`(s,1,c,c,1,t)`. Vanishing on the marked pair `(v,third)` gives `t=s`.
Generation by the four quaternion generators then proves that every value
belongs to the subgroup generated by `s,c`.

This is the finite pairing calculation for the local upper bound in
Aschbacher–Smith I.1.3(1), using the concrete core from 14.2.21.
-/

public section

open Subgroup
namespace Sporadic.Mathieu.SchurMultipliers.M12Upper.CorePairingBound
open M12SmallPair
variable {A : Type*} [CommGroup A]
variable (B : core →* (core →* A))

theorem pairing_symmetric (hp : ∀ x y, B x y ^ 2 = 1) (ha : ∀ x, B x x = 1)
    (x y : core) : B x y = B y x := by
  have h : B y x * B x y = 1 := by
    simpa only [map_mul, MonoidHom.mul_apply, ha, one_mul, mul_one] using ha (x*y)
  have hxx : B x y * B x y = 1 := by simpa only [pow_two] using hp x y
  exact (mul_right_cancel (h.trans hxx.symm)).symm

theorem pairing_z_left (hp : ∀ x y, B x y ^ 2 = 1) (x : core) : B zz x = 1 := by
  simpa only [zz_eq, map_pow, MonoidHom.pow_apply] using hp li x

theorem pairing_z_right (hp : ∀ x y, B x y ^ 2 = 1) (x : core) : B x zz = 1 := by
  simpa only [zz_eq, map_pow] using hp x li

/-- The mixed coefficients of the invariant pairing. -/
theorem coefficient_relations (hp : ∀ x y, B x y ^ 2 = 1)
    (hi : ∀ (g : firstParabolic) (x y : core),
      B (firstParabolicCoreAction g x) (firstParabolicCoreAction g y) = B x y) :
    B li ri = 1 ∧ B lj rj = 1 ∧ B lj ri = B li rj := by
  have hz := pairing_z_left B hp
  have hzr := pairing_z_right B hp
  have hc : B lj ri = B li rj := by
    simpa only [swap_li, swap_rj, map_mul, hzr, one_mul] using
      hi ⟨FirstCore.secondSwap, FirstCore.secondSwap_mem⟩ li rj
  have h24 : B lj rj = 1 := by
    have h := hi ⟨cubicActor,cubicActor_mem⟩ li rj
    simp only [cubic_li, cubic_rj, map_mul, MonoidHom.mul_apply, hz, one_mul] at h
    rw [hc] at h
    exact mul_left_cancel (h.trans (mul_one _).symm)
  refine ⟨?_,h24,hc⟩
  have h := hi ⟨cubicActor,cubicActor_mem⟩ li ri
  simpa only [cubic_li, cubic_ri, map_mul, MonoidHom.mul_apply, hz, hzr,
    one_mul, h24] using h.symm

/-- The marked commuting relation identifies the two quaternion coefficients. -/
theorem marked_coefficient (hp : ∀ x y, B x y ^ 2 = 1) (ha : ∀ x, B x x = 1)
    (hi : ∀ (g : firstParabolic) (x y : core),
      B (firstParabolicCoreAction g x) (firstParabolicCoreAction g y) = B x y)
    (hvt : B vv tt = 1) : B ri rj = B li lj := by
  obtain ⟨_,h24,h23⟩ := coefficient_relations B hp hi
  have hs := pairing_symmetric B hp ha
  have hz := pairing_z_left B hp
  have h12 := hs lj li
  have h34 := hs rj ri
  have h14 := hs rj li
  have h42 : B rj lj = 1 := (hs rj lj).trans h24
  have he : B li rj * B li rj = 1 := by simpa only [pow_two] using hp li rj
  have hcc (a : A) : B li rj * (B li rj * a) = a := by rw [← mul_assoc, he, one_mul]
  have ht : B li lj * B ri rj = 1 := by
    simpa only [vv_eq, tt_eq, map_mul, MonoidHom.mul_apply, hz,
      one_mul, h12, h34, h14, h42, h23, ha, mul_one,
      mul_assoc, mul_left_comm (B li rj), hcc] using hvt
  have hh : B li lj * B li lj = 1 := by simpa only [pow_two] using hp li lj
  exact mul_left_cancel (ht.trans hh.symm)

/-- Bilinearity and the actual core generation exhaust all pairing values. -/
theorem pairing_mem_span (hp : ∀ x y, B x y ^ 2 = 1) (ha : ∀ x, B x x = 1)
    (hi : ∀ (g : firstParabolic) (x y : core),
      B (firstParabolicCoreAction g x) (firstParabolicCoreAction g y) = B x y)
    (hvt : B vv tt = 1) (x y : core) :
    B x y ∈ closure ({B li lj, B li rj} : Set A) := by
  let N := closure ({B li lj, B li rj} : Set A)
  have hN1 : (1 : A) ∈ N := N.one_mem
  have hNs : B li lj ∈ N := subset_closure (by simp)
  have hNc : B li rj ∈ N := subset_closure (by simp)
  obtain ⟨h13,h24,h23⟩ := coefficient_relations B hp hi
  have h34 := marked_coefficient B hp ha hi hvt
  have hs := pairing_symmetric B hp ha
  have row (a : core) (h1 : B a li ∈ N) (h2 : B a lj ∈ N)
      (h3 : B a ri ∈ N) (h4 : B a rj ∈ N) (b : core) : B a b ∈ N :=
    generators (N.comap (B a)) h1 h2 h3 h4 b
  have hl (b : core) : B li b ∈ N :=
    row li (by rw [ha]; exact hN1) hNs (by rw [h13]; exact hN1) hNc b
  have hj (b : core) : B lj b ∈ N :=
    row lj (by rw [hs lj li]; exact hNs) (by rw [ha]; exact hN1)
      (by rw [h23]; exact hNc) (by rw [h24]; exact hN1) b
  have hr (b : core) : B ri b ∈ N :=
    row ri (by rw [hs ri li, h13]; exact hN1) (by rw [hs ri lj, h23]; exact hNc)
      (by rw [ha]; exact hN1) (by rw [h34]; exact hNs) b
  have hk (b : core) : B rj b ∈ N :=
    row rj (by rw [hs rj li]; exact hNc) (by rw [hs rj lj, h24]; exact hN1)
      (by rw [hs rj ri, h34]; exact hNs) (by rw [ha]; exact hN1) b
  exact generators (N.comap (B.flip y)) (hl y) (hj y) (hr y) (hk y) x

/-- The full value span is generated by the two indicated coefficients. -/
theorem pairing_span_eq (hp : ∀ x y, B x y ^ 2 = 1) (ha : ∀ x, B x x = 1)
    (hi : ∀ (g : firstParabolic) (x y : core),
      B (firstParabolicCoreAction g x) (firstParabolicCoreAction g y) = B x y)
    (hvt : B vv tt = 1) :
    closure {w : A | ∃ x y : core, B x y = w} =
      closure ({B li lj, B li rj} : Set A) := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨x,y,rfl⟩
    exact pairing_mem_span B hp ha hi hvt x y
  · apply (closure_le _).mpr
    rintro _ (rfl | rfl)
    · exact subset_closure ⟨li,lj,rfl⟩
    · exact subset_closure ⟨li,rj,rfl⟩

end Sporadic.Mathieu.SchurMultipliers.M12Upper.CorePairingBound
