module
public import Theory.GroupTheory.PCoreLocalSetup
public import Theory.GroupAction.PerfectCentralQuotient
public import Theory.GroupTheory.PCoreQuotientInnerJoin
public import Theory.Mathieu.SchurMultipliers.SourceCovers
public import Theory.Mathieu.M23.Properties.Automorphisms
public import Theory.Mathieu.M24.Properties.OuterRestriction

/-!
# Inner Mathieu core joins

When a two-group normalizes a subgroup whose two-core quotient has marked
central quotient M₂₃ or M₂₄, the join is generated by that subgroup and its
own two-core. The proved multiplier calculation removes the center of the
original core quotient; innerness then fills the literal join quotient.
No splitting of the original group or replacement of its core map is used.

Source: Aschbacher--Smith 4.2.13, printed p.612, for the M₂₄ row.
-/

public section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace Sporadic.Mathieu

private theorem join_factor_of_inner {G : Type*} [Group G]
    (L U : Subgroup G) (hn : U ≤ normalizer (L : Set G)) (hu : IsPGroup 2 U)
    (hz : center (L ⧸ pCore 2 L) = ⊥)
    (hi : ∀ a : MulAut (L ⧸ pCore 2 L), ∃ x, a = MulAut.conj x) :
    L ⊔ U = L ⊔ (L ⊔ U).pCoreIn 2 := by
  have hm := map_subgroupOf_pCoreJoin_eq_top_of_inner L U hn hu hz
    (fun r => by obtain ⟨x,hx⟩ := hi (pCoreJoinAction 2 hn (inclusion le_sup_right r)); exact ⟨x,hx.symm⟩)
  have hc := congrArg (Subgroup.comap (QuotientGroup.mk' (pCore 2 (L ⊔ U : Subgroup G)))) hm
  rw [comap_map_eq,QuotientGroup.ker_mk',comap_top] at hc
  have hh := congrArg (Subgroup.map (L ⊔ U).subtype) hc
  rw [Subgroup.map_sup,map_subgroupOf_eq_of_le (show L ≤ L ⊔ U from le_sup_left),
    ←MonoidHom.range_eq_map,range_subtype] at hh
  exact hh.symm

/-- The marked M23 or M24 central quotient gives inner action on the full core quotient. -/
theorem m23_or_m24_core_join {G : Type*} [Group G] [Finite G]
    (L U : Subgroup G) (hn : U ≤ normalizer (L : Set G)) (hu : IsPGroup 2 U)
    [IsQuasisimple (L ⧸ pCore 2 L)]
    (hm : Nonempty (((L ⧸ pCore 2 L) ⧸ center (L ⧸ pCore 2 L)) ≃* Sporadic.Mathieu.M23) ∨
      Nonempty (((L ⧸ pCore 2 L) ⧸ center (L ⧸ pCore 2 L)) ≃* Sporadic.Mathieu.M24)) :
    L ⊔ U = L ⊔ (L ⊔ U).pCoreIn 2 := by
  rcases hm with ⟨⟨e⟩⟩ | ⟨⟨e⟩⟩
  · apply join_factor_of_inner L U hn hu
      (Sporadic.Mathieu.SchurMultipliers.m23_center_eq_bot_of_centralQuotientEquiv e)
    intro a
    apply (MulAut.centralQuotientAction_inner_iff e a).mp
    obtain ⟨x,hx⟩ := Sporadic.Mathieu.m23_conj_surjective (MulAut.centralQuotientAction e a)
    exact ⟨x,hx.symm⟩
  · apply join_factor_of_inner L U hn hu
      (Sporadic.Mathieu.SchurMultipliers.m24_center_eq_bot_of_centralQuotientEquiv e)
    intro a
    apply (MulAut.centralQuotientAction_inner_iff e a).mp
    obtain ⟨x,hx⟩ := Sporadic.Mathieu.M24OuterRestriction.conj_surjective (MulAut.centralQuotientAction e a)
    exact ⟨x,hx.symm⟩
end Sporadic.Mathieu
