def generatorPerm (t : Fin 24) : Equiv.Perm (Fin 23) :=
  (generatorPoint_involutive t).toPerm

theorem generatorPoint_labels : ∀ t i,
    generatorPoint t (pointLabel i) = pointLabel (generatorRow t i) := by decide +kernel

theorem generatorPoint_pair : ∀ t, generatorPoint t 11 = 11 ∧ generatorPoint t 17 = 17 := by
  decide +kernel

theorem generator_vector : ∀ t i,
    generatorScale t i • vector (pointRow (generatorRow t i)) =
      (Matrix.transvection (generatorFirst t) (generatorSecond t) (generatorCoeff t)) *ᵥ
        vector (pointRow i) := by decide +kernel

