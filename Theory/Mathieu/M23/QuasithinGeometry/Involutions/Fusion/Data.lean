/-- Standard ambient generators and their inverses, all already known to lie in M23. -/
@[expose] public def ambientGen : Fin 6 → Equiv.Perm (Fin 23) :=
  ![m23M22GeneratorA, m23M22GeneratorB, m23Standard23Cycle,
    m23M22GeneratorA⁻¹, m23M22GeneratorB⁻¹, m23Standard23Cycle⁻¹]

public theorem ambientGen_mem (i : Fin 6) : ambientGen i ∈ M23 := by
  fin_cases i
  · exact m23M22GeneratorA_mem_M23
  · exact m23M22GeneratorB_mem_M23
  · exact m23Standard23Cycle_mem_M23
  · exact M23.inv_mem m23M22GeneratorA_mem_M23
  · exact M23.inv_mem m23M22GeneratorB_mem_M23
  · exact M23.inv_mem m23Standard23Cycle_mem_M23

@[expose] public def generatorWord : Fin 3 → List (Fin 6) :=
  ![[5, 4, 0, 2, 2, 1, 0, 2, 0, 1, 0],
    [2, 0, 1, 0, 4, 2, 2, 2, 2, 4, 2, 1],
    [5, 4, 5, 1, 0, 2, 0, 1, 2, 4, 2, 1, 2]]

private theorem generatorWord_eval : ∀ i : Fin 3,
    gen i.castSucc.castSucc.castSucc = evalWord ambientGen (generatorWord i) := by
  decide +kernel

private theorem ambient_word_mem (w : List (Fin 6)) : evalWord ambientGen w ∈ M23 := by
  induction w with
  | nil => exact M23.one_mem
  | cons i w ih => exact M23.mul_mem (ambientGen_mem i) ih

private theorem first_gen_mem (i : Fin 3) : gen i.castSucc.castSucc.castSucc ∈ M23 := by
  rw [generatorWord_eval]
  exact ambient_word_mem _

public theorem gen_mem (i : Fin 6) : gen i ∈ M23 := by
  fin_cases i
  · exact first_gen_mem 0
  · exact first_gen_mem 1
  · exact first_gen_mem 2
  · change gen (invOf 0) ∈ M23
    rw [gen_inv]
    exact M23.inv_mem (first_gen_mem 0)
  · change gen (invOf 1) ∈ M23
    rw [gen_inv]
    exact M23.inv_mem (first_gen_mem 1)
  · change gen (invOf 2) ∈ M23
    rw [gen_inv]
    exact M23.inv_mem (first_gen_mem 2)

end Sporadic.Mathieu.M23Geometry.FusionCertificate
