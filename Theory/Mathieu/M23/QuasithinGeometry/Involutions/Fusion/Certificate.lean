module

public import Theory.Mathieu.M23.QuasithinGeometry.Involutions.Fusion.Checks
public import Theory.Mathieu.M23.Properties.Order
public import Theory.GroupTheory.SylowElementConjugacy

/-!
# An enumerated Sylow 2-subgroup of M23 and its involution fusion

The word subgroup consists exactly of the 128 permutations in the checked
list. Its order is the full 2-part of the already proved order of M23.
The checked conjugating words lie in M23 because they use certified ambient
generators. Thus all involutions of this Sylow subgroup have one ambient
conjugacy class, the finite step in Aschbacher--Smith, Lemma 5.2.21.
-/

namespace Sporadic.Mathieu.M23Geometry.FusionCertificate
open Theory.GroupTheory

set_option maxRecDepth 100000

/-- The subgroup generated by the three certified design automorphisms. -/
@[expose] public def rawSubgroup : Subgroup (Equiv.Perm (Fin 23)) :=
  wordSubgroup gen invOf gen_inv

public theorem perm_mem (i : Fin 128) : perm i ∈ rawSubgroup :=
  ⟨representativeWord i, representativeWord_eval i⟩

public theorem rawSubgroup_le : rawSubgroup ≤ M23 := by
  rintro p ⟨w, rfl⟩
  induction w with
  | nil => exact M23.one_mem
  | cons i w ih => exact M23.mul_mem (gen_mem i) ih

public theorem exists_perm (p : rawSubgroup) : ∃ i, perm i = p.val := by
  obtain ⟨w, hw⟩ := p.property
  suffices ∃ i, perm i = evalWord gen w by simpa only [hw] using this
  clear hw p
  induction w with
  | nil => exact ⟨0, initial⟩
  | cons a w ih =>
    obtain ⟨i, hi⟩ := ih
    exact ⟨step a i, by rw [← step_correct, hi]⟩

public theorem rawSubgroup_card : Nat.card rawSubgroup = 128 := by
  let f : Fin 128 → rawSubgroup := fun i => ⟨perm i, perm_mem i⟩
  have hf : Function.Bijective f := by
    constructor
    · intro i j h
      exact perm_injective (congrArg Subtype.val h)
    · intro p
      obtain ⟨i, hi⟩ := exists_perm p
      exact ⟨i, Subtype.ext hi⟩
  exact (Nat.card_congr (Equiv.ofBijective f hf).symm).trans (Nat.card_fin 128)

/-- The enumerated subgroup viewed inside the actual design automorphism group. -/
@[expose] public noncomputable def subgroup : Subgroup M23 := rawSubgroup.subgroupOf M23

public theorem subgroup_card : Nat.card subgroup = 128 := by
  exact (Nat.card_congr (Subgroup.subgroupOfEquivOfLe rawSubgroup_le).toEquiv).trans
    rawSubgroup_card

/-- Its order is the full 2-part of the order of M23. -/
@[expose] public noncomputable def sylow : Sylow 2 M23 :=
  Sylow.ofCard subgroup (by
    rw [subgroup_card, m23_order,
      show Nat.factorization 10200960 2 = 7 by decide +kernel]
    norm_num)

private theorem ambient_word_mem (w : List (Fin 6)) : evalWord ambientGen w ∈ M23 := by
  induction w with
  | nil => exact M23.one_mem
  | cons i w ih => exact M23.mul_mem (ambientGen_mem i) ih

/-- The fixed representative to which all involutions will be conjugated. -/
@[expose] public noncomputable def representative : M23 :=
  ⟨m23M22GeneratorA, m23M22GeneratorA_mem_M23⟩

public theorem local_fusion (x : subgroup) (hx : orderOf (x : M23) = 2) :
    IsConj (x : M23) representative := by
  obtain ⟨i, hi⟩ := exists_perm ⟨x.val.val, x.property⟩
  have hsq : perm i * perm i = 1 := by
    rw [hi]
    have h := pow_orderOf_eq_one (x : M23)
    rw [hx, pow_two] at h
    exact congrArg (fun z : M23 => z.val) h
  have hne : perm i ≠ 1 := by
    intro he
    have hxe : (x : M23) = 1 := Subtype.ext (hi.symm.trans he)
    simp [hxe] at hx
  let w : M23 := ⟨evalWord ambientGen (conjugatingWord i), ambient_word_mem _⟩
  apply IsConj.symm
  apply isConj_iff.mpr
  refine ⟨w, ?_⟩
  apply Subtype.ext
  exact (conjugation_check i hsq hne).trans hi

end Sporadic.Mathieu.M23Geometry.FusionCertificate
