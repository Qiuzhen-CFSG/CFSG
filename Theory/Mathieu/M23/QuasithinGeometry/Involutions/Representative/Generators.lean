private theorem generator_block_bits (j : Fin 7) (i : Fin 253) (x : Fin 23) :
    (m23BlockMask i).testBit ((involutionCentralizerGeneratorPerm j).symm x).val =
      (m23BlockMask (generatorBlockIndex j i)).testBit x.val := by
  fin_cases j <;> (revert i x; decide +kernel)

private theorem generator_blockAt (j : Fin 7) (i : Fin 253) :
    involutionCentralizerGeneratorPerm j • m23BlockAt i =
      m23BlockAt (generatorBlockIndex j i) :=
  m23Perm_smul_blockAt_of_bits _ _ _ (generator_block_bits j i)

private theorem generatorBlockIndex_injective (j : Fin 7) :
    Function.Injective (generatorBlockIndex j) := by
  intro i k hik
  apply m23BlockAt_injective
  apply (MulAction.injective (involutionCentralizerGeneratorPerm j) :
    Function.Injective (fun B : Finset (Fin 23) => involutionCentralizerGeneratorPerm j • B))
  change involutionCentralizerGeneratorPerm j • m23BlockAt i =
    involutionCentralizerGeneratorPerm j • m23BlockAt k
  rw [generator_blockAt, generator_blockAt, hik]

public theorem involutionCentralizerGeneratorPerm_mem (j : Fin 7) :
    involutionCentralizerGeneratorPerm j ∈ M23 := by
  rw [mem_M23_iff]
  have h := m23Blocks_smul_of_reindex (involutionCentralizerGeneratorPerm j)
    (generatorBlockIndex j) (Finite.surjective_of_injective (generatorBlockIndex_injective j))
    (generator_blockAt j)
  have hs := congrArg (fun s : Finset (Finset (Fin 23)) => (s : Set (Finset (Fin 23)))) h
  simpa only [Finset.coe_smul_finset] using hs

public theorem involutionCentralizerGeneratorPerm_commutes (j : Fin 7) :
    involutionCentralizerGeneratorPerm j * involutionPerm =
      involutionPerm * involutionCentralizerGeneratorPerm j := by
  revert j
  decide +kernel

@[expose] public def involutionCentralizerGenerator (j : Fin 7) :
    Subgroup.centralizer ({involutionRepresentative} : Set M23) :=
  ⟨⟨involutionCentralizerGeneratorPerm j, involutionCentralizerGeneratorPerm_mem j⟩, by
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    apply Subtype.ext
    exact involutionCentralizerGeneratorPerm_commutes j⟩

