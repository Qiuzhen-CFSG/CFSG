private theorem generator_left (j : Fin 7) (x : Fin 23) :
    involutionCentralizerGeneratorInvTable j (involutionCentralizerGeneratorTable j x) = x := by
  revert j x
  decide +kernel

private theorem generator_right (j : Fin 7) (x : Fin 23) :
    involutionCentralizerGeneratorTable j (involutionCentralizerGeneratorInvTable j x) = x := by
  revert j x
  decide +kernel

@[expose] public def involutionCentralizerGeneratorPerm (j : Fin 7) : Equiv.Perm (Fin 23) where
  toFun := involutionCentralizerGeneratorTable j
  invFun := involutionCentralizerGeneratorInvTable j
  left_inv := by exact generator_left j
  right_inv := by exact generator_right j

