private theorem cycleWord_spec : ∀ a b c : Fin 7, a ≠ b → b ≠ c → a ≠ c →
    ((cycleWord a b c).map letter).prod = Equiv.swap a b * Equiv.swap b c := by
  decide +kernel

/-- A subgroup containing the two displayed cycles contains the full alternating group. -/
theorem alternating_le_of_cycles (H : Subgroup (Equiv.Perm (Fin 7)))
    (hc : labelCycle ∈ H) (hr : labelRotation ∈ H) : alternatingGroup (Fin 7) ≤ H := by
  rw [← Equiv.Perm.closure_three_cycles_eq_alternating, Subgroup.closure_le]
  intro g hg
  obtain ⟨a, ha⟩ := hg.isCycle.nonempty_support
  have he := (hg.eq_swap_mul_swap_iff_mem_support).mpr ha
  have hn := (hg.nodup_iff_mem_support).mpr ha
  have hab : a ≠ g a := by simpa using (Equiv.Perm.mem_support.mp ha).symm
  have hbc : g a ≠ g (g a) := g.injective.ne hab
  have hac : a ≠ g (g a) := by
    intro heq
    exact (List.nodup_cons.mp hn).1 (List.mem_cons.mpr (Or.inr (List.mem_singleton.mpr heq)))
  rw [he, ← cycleWord_spec a (g a) (g (g a)) hab hbc hac]
  apply H.list_prod_mem
  intro p hp
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hp
  fin_cases i
  · exact hc
  · exact hr
  · exact H.inv_mem hc
  · exact H.inv_mem hr

end Sporadic.Mathieu.M23Geometry.AlternatingSection
