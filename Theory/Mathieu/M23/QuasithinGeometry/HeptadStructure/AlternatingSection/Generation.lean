module

public import Theory.Mathieu.M23.QuasithinGeometry.HeptadStructure.AlternatingSection.Data

/-!
# Generating the alternating action on the heptad

Every three-cycle is certified as a word in the three-cycle (0 1 2), the
seven-cycle (0 1 2 3 4 5 6), and their inverses. Mathlib's generation theorem
for three-cycles then gives the required range inclusion. The finite word
certificates do not assume a presentation or an abstract group identification.
-/

@[expose] public section
namespace Sporadic.Mathieu.M23Geometry.AlternatingSection
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

private def letter : Fin 4 → Equiv.Perm (Fin 7) :=
  ![labelCycle, labelRotation, labelCycle⁻¹, labelRotation⁻¹]

