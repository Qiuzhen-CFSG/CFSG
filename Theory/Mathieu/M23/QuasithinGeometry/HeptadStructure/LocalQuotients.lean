module
public import Theory.Mathieu.M23.QuasithinGeometry.HeptadStructure.Basic
public import Theory.Mathieu.M23.QuasithinGeometry.HeptadStructure.Local
public import Theory.Mathieu.M23.QuasithinGeometry.HeptadStructure.LocalQuotients.Labelled
public import Theory.Mathieu.M23.QuasithinGeometry.HeptadStructure.LocalQuotients.FinitePartition
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# Ambient transport of the labelled heptad intersections

The actual pair stabilizer acts on the source partition of sizes 3,2,2.
Assuming the heptad action has alternating image, this action surjects onto
its even partition stabilizer. Its kernel is precisely the ambient heptad
kernel restricted to the pair stabilizer, giving a compatible quotient
isomorphism and the induced map into the full heptad quotient.

For a section of the alternating action, the cyclic subgroup generated by
its specified three-cycle lies in the two-pair intersection. Exhausting the
labelled four-point fixer by powers of that cycle then proves the ambient
intersection is the join of this cyclic subgroup and the heptad kernel.

Source: Aschbacher--Smith, Lemma 5.2.20(2--3), printed pp. 656--657.
-/

@[expose] public section
namespace Sporadic.Mathieu.M23Geometry
open scoped Pointwise

theorem heptadAction_smul_labels (g : heptadStabilizer) (S : Finset (Fin 7)) :
    (heptadAction g • S).image label = (g : M23) • S.image label := by
  simp only [Finset.smul_finset_def, Finset.image_image]
  congr 1
  funext i
  exact heptadAction_apply g i

theorem heptadAction_stabilizes_labels (g : heptadStabilizer) (S : Finset (Fin 7)) :
    heptadAction g • S = S ↔ (g : M23) • S.image label = S.image label := by
  rw [← heptadAction_smul_labels, Finset.image_inj label.injective]

theorem mem_fourPairStabilizer_iff_labelled (g : heptadStabilizer) :
    (g : M23) ∈ fourPairStabilizer ↔ heptadAction g ∈ heptadPartitionStabilizer := by
  rw [mem_fourPairStabilizer_iff_partition, mem_heptadPartitionStabilizer]
  have h3 : heptadTripleLabels.image label = omega \ lambda := by decide +kernel
  have h2 : heptadMiddleLabels.image label = lambda \ x.val := by decide +kernel
  have hx : heptadPairLabels.image label = x.val := by decide +kernel
  simp only [heptadAction_stabilizes_labels, h3, h2, hx, g.property, true_and]

theorem fourPairStabilizer_le_heptad : fourPairStabilizer ≤ heptadStabilizer :=
  inf_le_left.trans fourStabilizer_le

noncomputable def fourPairHeptadInclusion : fourPairStabilizer →* heptadStabilizer :=
  Subgroup.inclusion fourPairStabilizer_le_heptad

noncomputable def fourPairLabelAction : fourPairStabilizer →* Equiv.Perm (Fin 7) :=
  heptadAction.comp fourPairHeptadInclusion

@[simp] theorem fourPairLabelAction_apply (g : fourPairStabilizer) (i : Fin 7) :
    label (fourPairLabelAction g i) = (g : M23) • label i :=
  heptadAction_apply (fourPairHeptadInclusion g) i

theorem mem_heptadKernelAmbient_iff_action (g : heptadStabilizer) :
    (g : M23) ∈ heptadKernelAmbient ↔ heptadAction g = 1 := by
  change (g : M23) ∈ heptadKernel.map heptadStabilizer.subtype ↔ g ∈ heptadKernel
  constructor
  · rintro ⟨h, hh, he⟩
    have : h = g := Subtype.ext he
    rwa [← this]
  · intro hg
    exact ⟨g, hg, rfl⟩

theorem fourPairLabelAction_ker :
    fourPairLabelAction.ker = heptadKernelAmbient.subgroupOf fourPairStabilizer := by
  ext g
  exact (mem_heptadKernelAmbient_iff_action (fourPairHeptadInclusion g)).symm

instance heptadKernelAmbient_normal_fourPair :
    (heptadKernelAmbient.subgroupOf fourPairStabilizer).Normal := by
  rw [← fourPairLabelAction_ker]
  infer_instance

theorem fourPairLabelAction_range
    (hA : heptadAction.range = alternatingGroup (Fin 7)) :
    fourPairLabelAction.range = heptadEvenPartition := by
  ext p
  constructor
  · rintro ⟨g, rfl⟩
    refine ⟨?_, ?_⟩
    · rw [← hA]
      exact ⟨fourPairHeptadInclusion g, rfl⟩
    · exact (mem_fourPairStabilizer_iff_labelled (fourPairHeptadInclusion g)).mp g.property
  · rintro ⟨hpA, hpP⟩
    rw [← hA] at hpA
    obtain ⟨g, rfl⟩ := hpA
    have hg := (mem_fourPairStabilizer_iff_labelled g).mpr hpP
    exact ⟨⟨g, hg⟩, rfl⟩

noncomputable def fourPairPartitionAction
    (hA : heptadAction.range = alternatingGroup (Fin 7)) :
    fourPairStabilizer →* heptadEvenPartition :=
  fourPairLabelAction.codRestrict _ (fun g => by
    rw [← fourPairLabelAction_range hA]
    exact ⟨g, rfl⟩)

@[simp] theorem fourPairPartitionAction_coe
    (hA : heptadAction.range = alternatingGroup (Fin 7)) (g : fourPairStabilizer) :
    (fourPairPartitionAction hA g : Equiv.Perm (Fin 7)) = fourPairLabelAction g := rfl

theorem fourPairPartitionAction_surjective
    (hA : heptadAction.range = alternatingGroup (Fin 7)) :
    Function.Surjective (fourPairPartitionAction hA) := by
  intro p
  have hp : (p : Equiv.Perm (Fin 7)) ∈ fourPairLabelAction.range := by
    rw [fourPairLabelAction_range hA]
    exact p.property
  obtain ⟨g, hg⟩ := hp
  exact ⟨g, Subtype.ext hg⟩

theorem fourPairPartitionAction_ker
    (hA : heptadAction.range = alternatingGroup (Fin 7)) :
    (fourPairPartitionAction hA).ker =
      heptadKernelAmbient.subgroupOf fourPairStabilizer := by
  rw [fourPairPartitionAction, MonoidHom.ker_codRestrict, fourPairLabelAction_ker]

noncomputable def fourPairQuotientPartitionEquiv
    (hA : heptadAction.range = alternatingGroup (Fin 7)) :
    fourPairStabilizer ⧸ heptadKernelAmbient.subgroupOf fourPairStabilizer ≃*
      heptadEvenPartition :=
    (QuotientGroup.quotientMulEquivOfEq (fourPairPartitionAction_ker hA).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective _ (fourPairPartitionAction_surjective hA))

/-- The local quotient is concretely the product of the first-block permutation
and the swap coordinate on the last pair. -/
noncomputable def fourPairQuotientS3C2Equiv
    (hA : heptadAction.range = alternatingGroup (Fin 7)) :
    fourPairStabilizer ⧸ heptadKernelAmbient.subgroupOf fourPairStabilizer ≃*
      (Equiv.Perm (Fin 3) × Multiplicative (ZMod 2)) :=
  (fourPairQuotientPartitionEquiv hA).trans heptadEvenPartitionEquiv

@[simp] theorem fourPairQuotientPartitionEquiv_mk
    (hA : heptadAction.range = alternatingGroup (Fin 7)) (g : fourPairStabilizer) :
    fourPairQuotientPartitionEquiv hA (QuotientGroup.mk g) =
      fourPairPartitionAction hA g := rfl

/-- Inclusion of the local quotient in the quotient of the heptad stabilizer. -/
noncomputable def fourPairQuotientHeptadMap :
    fourPairStabilizer ⧸ heptadKernelAmbient.subgroupOf fourPairStabilizer →*
      heptadStabilizer ⧸ heptadKernel :=
  QuotientGroup.map _ _ fourPairHeptadInclusion (by
    intro g hg
    exact (mem_heptadKernelAmbient_iff_action (fourPairHeptadInclusion g)).mp hg)

@[simp] theorem fourPairQuotientHeptadMap_mk (g : fourPairStabilizer) :
    fourPairQuotientHeptadMap (QuotientGroup.mk g) =
      QuotientGroup.mk (fourPairHeptadInclusion g) := rfl

/-- The local identification and ambient inclusion induce the same labelled permutation. -/
theorem fourPairQuotientPartitionEquiv_ambient
    (hA : heptadAction.range = alternatingGroup (Fin 7))
    (q : fourPairStabilizer ⧸ heptadKernelAmbient.subgroupOf fourPairStabilizer) :
    (fourPairQuotientPartitionEquiv hA q : Equiv.Perm (Fin 7)) =
      QuotientGroup.kerLift heptadAction (fourPairQuotientHeptadMap q) := by
  induction q using Quotient.inductionOn' with
  | h g => rfl

@[simp] theorem fourPairQuotientS3C2Equiv_mk
    (hA : heptadAction.range = alternatingGroup (Fin 7)) (g : fourPairStabilizer) :
    fourPairQuotientS3C2Equiv hA (QuotientGroup.mk g) =
      heptadEvenPartitionEquiv (fourPairPartitionAction hA g) := rfl

/-- Fixing the four-set is exactly fixing its four source labels. -/
theorem mem_fourTwoPairStabilizer_iff_labels (g : heptadStabilizer) :
    (g : M23) ∈ fourTwoPairStabilizer ↔
      ∀ i ∈ heptadFourLabels, heptadAction g i = i := by
  rw [fourTwoPairStabilizer_eq_kernel, mem_fourKernelAmbient]
  have hL : heptadFourLabels.image label = lambda := by decide +kernel
  constructor
  · intro h i hi
    apply label.injective
    rw [heptadAction_apply]
    apply h
    rw [← hL]
    exact Finset.mem_image.mpr ⟨i, hi, rfl⟩
  · intro h a ha
    rw [← hL] at ha
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ha
    rw [← heptadAction_apply, h i hi]

/-- Membership in the alternating four-point fixer is the two-pair condition. -/
theorem mem_fourTwoPairStabilizer_iff_labelled
    (hA : heptadAction.range = alternatingGroup (Fin 7)) (g : heptadStabilizer) :
    (g : M23) ∈ fourTwoPairStabilizer ↔ heptadAction g ∈ heptadEvenFourFixer := by
  rw [mem_heptadEvenFourFixer, mem_fourTwoPairStabilizer_iff_labels]
  have hg : heptadAction g ∈ alternatingGroup (Fin 7) := by
    rw [← hA]
    exact ⟨g, rfl⟩
  exact (and_iff_right hg).symm

/-- The actual cyclic subgroup B specified by a section and the source three-cycle. -/
noncomputable def heptadSectionThreeSubgroup
    (s : alternatingGroup (Fin 7) →* heptadStabilizer) : Subgroup M23 :=
  Subgroup.zpowers (heptadStabilizer.subtype (s heptadTripleCycle))

instance heptadSectionThreeSubgroup_isCyclic
    (s : alternatingGroup (Fin 7) →* heptadStabilizer) :
    IsCyclic (heptadSectionThreeSubgroup s) :=
  Subgroup.isCyclic_zpowers (heptadStabilizer.subtype (s heptadTripleCycle))

theorem heptadSectionThreeSubgroup_le_twoPair
    (s : alternatingGroup (Fin 7) →* heptadStabilizer)
    (hs : ∀ a, heptadAction (s a) = (a : Equiv.Perm (Fin 7))) :
    heptadSectionThreeSubgroup s ≤ fourTwoPairStabilizer := by
  apply Subgroup.zpowers_le.mpr
  apply (mem_fourTwoPairStabilizer_iff_labels (s heptadTripleCycle)).mpr
  rw [hs]
  intro i hi
  have h : ∀ i ∈ heptadFourLabels, (heptadTripleCycle : Equiv.Perm (Fin 7)) i = i :=
    by decide +kernel
  exact h i hi

/-- A finite labelled calculation suffices to identify the ambient intersection. -/
theorem fourTwoPairStabilizer_eq_kernel_sup_of_labelled
    (hfix : heptadEvenFourFixer ≤
      Subgroup.zpowers (heptadTripleCycle : Equiv.Perm (Fin 7)))
    (hA : heptadAction.range = alternatingGroup (Fin 7))
    (s : alternatingGroup (Fin 7) →* heptadStabilizer)
    (hs : ∀ a, heptadAction (s a) = (a : Equiv.Perm (Fin 7))) :
    fourTwoPairStabilizer = heptadKernelAmbient ⊔ heptadSectionThreeSubgroup s := by
  apply le_antisymm
  · intro g hg
    have hgH : g ∈ heptadStabilizer := fourPairStabilizer_le_heptad hg.1
    let a : heptadStabilizer := ⟨g, hgH⟩
    have hga : heptadAction a ∈ heptadEvenFourFixer :=
      (mem_fourTwoPairStabilizer_iff_labelled hA a).mp hg
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hfix hga)
    let b : heptadStabilizer := (s heptadTripleCycle) ^ n
    have hb : heptadAction b = heptadAction a := by
      dsimp [b]
      rw [map_zpow, hs, hn]
    have hk : ((a * b⁻¹ : heptadStabilizer) : M23) ∈ heptadKernelAmbient := by
      apply (mem_heptadKernelAmbient_iff_action (a * b⁻¹)).mpr
      rw [map_mul, map_inv, hb, mul_inv_cancel]
    have hbB : (b : M23) ∈ heptadSectionThreeSubgroup s := by
      exact Subgroup.mem_zpowers_iff.mpr ⟨n, (map_zpow heptadStabilizer.subtype _ n).symm⟩
    have hprod := (heptadKernelAmbient ⊔ heptadSectionThreeSubgroup s).mul_mem
      (Subgroup.mem_sup_left hk) (Subgroup.mem_sup_right hbB)
    simpa only [Subgroup.coe_mul, Subgroup.coe_inv, inv_mul_cancel_right] using hprod
  · exact sup_le heptadKernelAmbient_le_twoPair
      (heptadSectionThreeSubgroup_le_twoPair s hs)

theorem fourKernelAmbient_eq_kernel_sup_of_labelled
    (hfix : heptadEvenFourFixer ≤
      Subgroup.zpowers (heptadTripleCycle : Equiv.Perm (Fin 7)))
    (hA : heptadAction.range = alternatingGroup (Fin 7))
    (s : alternatingGroup (Fin 7) →* heptadStabilizer)
    (hs : ∀ a, heptadAction (s a) = (a : Equiv.Perm (Fin 7))) :
    fourKernelAmbient = heptadKernelAmbient ⊔ heptadSectionThreeSubgroup s := by
  rw [← fourTwoPairStabilizer_eq_kernel]
  exact fourTwoPairStabilizer_eq_kernel_sup_of_labelled hfix hA s hs

/-- The finite labelled calculation discharges the fixer hypothesis. -/
theorem fourTwoPairStabilizer_eq_kernel_sup
    (hA : heptadAction.range = alternatingGroup (Fin 7))
    (s : alternatingGroup (Fin 7) →* heptadStabilizer)
    (hs : ∀ a, heptadAction (s a) = (a : Equiv.Perm (Fin 7))) :
    fourTwoPairStabilizer = heptadKernelAmbient ⊔ heptadSectionThreeSubgroup s := by
  apply fourTwoPairStabilizer_eq_kernel_sup_of_labelled
    (hfix := ?_) (hA := hA) (s := s) hs
  rw [heptadEvenFourFixer_eq_zpowers]

/-- The same concrete join description for the ambient four-point kernel. -/
theorem fourKernelAmbient_eq_kernel_sup
    (hA : heptadAction.range = alternatingGroup (Fin 7))
    (s : alternatingGroup (Fin 7) →* heptadStabilizer)
    (hs : ∀ a, heptadAction (s a) = (a : Equiv.Perm (Fin 7))) :
    fourKernelAmbient = heptadKernelAmbient ⊔ heptadSectionThreeSubgroup s := by
  rw [← fourTwoPairStabilizer_eq_kernel]
  exact fourTwoPairStabilizer_eq_kernel_sup hA s hs

end Sporadic.Mathieu.M23Geometry
