theorem square_cover : ∀ i,
    point i (point i (squareWitness i)) = squareWitness i →
      bucket (slot i).1 (slot i).2 = i := by
  decide +kernel

theorem commuting_unique : ∀ c a b,
    bucket c a = bucket c b ∨
      ∃ x : Fin 24, point (bucket c a) (point (bucket c b) x) ≠
        point (bucket c b) (point (bucket c a) x) := by
  decide +kernel

