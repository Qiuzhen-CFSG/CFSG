module

public import Theory.Mathieu.M22.TripleCover.CubicFacts
public import Theory.GroupTheory.PrimeOrderClosure
public import Theory.GroupTheory.PrimeRankAutomorphismOrder

/-!
# Cubic generation of the Mathieu triple cover

The normal subgroup generated by elements of order three has the full
three-rank of the cover. Its rank is at least two, whereas the central
scalar subgroup has rank one. Quasisimplicity therefore makes this cubic
closure the whole cover, which is not solvable.

This supplies the terminal Mathieu-section obstruction in the proof of
Aschbacher--Smith 15.2.15, printed p.1118, without identifying an ambient
prime-complement residual.
-/

public section
open Subgroup Theory.GroupTheory
namespace Sporadic.Mathieu.M22TripleCover

/-- The actual triple cover is generated by its elements of order three. -/
theorem cubic_closure_eq_top :
    closure {x : M22TripleCover | orderOf x = 3} = ⊤ := by
  let C := closure {x : M22TripleCover | orderOf x = 3}
  have hn : (⊤ : Subgroup M22TripleCover) ≤ normalizer (C : Set M22TripleCover) := by
    apply le_normalizer_closure_iff.mpr
    intro g _ x hx
    exact subset_closure ((MulAut.conj g).orderOf_eq x |>.trans hx)
  let : C.Normal := normalizer_eq_top_iff.mp (top_unique hn)
  rcases IsQuasisimple.normal_le_center_or_eq_top C with hc | ht
  · have hr : primeRank 3 C = primeRank 3 M22TripleCover := by
      have hh := primeRank_primeOrderClosure 3 (⊤ : Subgroup M22TripleCover)
      have he : {x : M22TripleCover | x ∈ (⊤ : Subgroup M22TripleCover) ∧ orderOf x = 3} =
          {x : M22TripleCover | orderOf x = 3} := by ext; simp
      rwa [he, primeRank_congr 3 Subgroup.topEquiv] at hh
    have hz : primeRank 3 (center M22TripleCover) ≤ 1 := by
      apply primeRank_le_of_card_le_prime_pow (n := 1)
      rw [center_card]
      decide
    have hu := (primeRank_mono 3 hc).trans hz
    rw [hr] at hu
    have hl := two_le_threeRank
    omega
  · exact ht

/-- The cubic-generated subgroup of the triple cover is not solvable. -/
theorem cubic_closure_not_solvable :
    ¬ Group.IsSolvable (closure {x : M22TripleCover | orderOf x = 3}) := by
  rw [cubic_closure_eq_top]
  intro hs
  let := hs
  let : Nontrivial M22TripleCover := Finite.one_lt_card_iff_nontrivial.mp (by
    rw [card]
    decide)
  have hg : Group.IsSolvable M22TripleCover :=
    Group.isSolvable_of_surjective
      (f := (Subgroup.topEquiv : (⊤ : Subgroup M22TripleCover) ≃* M22TripleCover).toMonoidHom)
      Subgroup.topEquiv.surjective
  exact Group.IsPerfect.not_isSolvable M22TripleCover hg

end Sporadic.Mathieu.M22TripleCover
