module
public import Theory.Mathieu.M22.CentralCover.QuintetRestriction
public import Theory.Mathieu.M22.ChapterHLocalClassification.Quintet.Structure
public import Theory.GroupTheory.Commutator.PerfectSmallIndex
public import Theory.GroupTheory.SylowKernelCore
public import Theory.GroupTheory.CentralCoverNormalCoreLift
public import Theory.GroupTheory.PerfectCentralCoverExistence

/-!
# The native quintet core and the original selected commutator lift

The native affine actor is normal of index four in the outer quintet.
Its translation core is exactly the commutator of that actor with the
outer quintet's order-32 kernel. Both the degree-22 embedding and its
original outer-pair image are retained in the core comparison.

A mutually normalized pair with these exact images therefore has a
literal commutator lifting the native translations. In a central double
cover this lift is normal in the full local preimage. If its original
selected kernel is killed, it misses the covering involution, contrary
to the full local core being generated by commutators. This is the exact
local-preimage comparison in Aschbacher--Smith 8.2.10(3), printed p.721;
the source pair must supply the displayed images and kernel condition.
-/

public noncomputable section
open Subgroup Representation Atlas.Codes MathieuCode
open scoped Pointwise
namespace Sporadic.Mathieu.M22ChapterH.Quintet
open MathieuCode.M22Quintet

private theorem actor_index : naturalActor.index = 4 := by
  have hQ : Nat.card Q = 3840 := by
    have hk : Nat.card (pCore 2 Q) = 32 :=
      (card_map_of_injective Q.subtype_injective).symm.trans core_card
    have hq : Nat.card (Q ⧸ pCore 2 Q) = 120 :=
      (Nat.card_congr quotientEquiv.toEquiv).trans (by
        simp [Nat.card_eq_fintype_card,Fintype.card_perm,Nat.factorial])
    rw [card_eq_card_quotient_mul_card_subgroup (pCore 2 Q),hq,hk]
  have ha : Nat.card naturalActor = 960 := by
    rw [←Nat.card_congr naturalActorEquiv.toEquiv]
    exact Atlas.Codes.tetradPointAffine_card _
  have hh := naturalActor.card_mul_index
  rw [ha,hQ] at hh
  omega

private theorem actor_perfect : Group.IsPerfect naturalActor :=
  Matrix.SL2.isPerfect_of_equiv_affine _ (by rw [Matrix.PSL3Four.card_F])
    naturalActorAffineEquiv

private theorem actor_normal : naturalActor.Normal := by
  let : Group.IsPerfect naturalActor := actor_perfect
  refine ⟨fun x hx g => ?_⟩
  let : Group.IsPerfect (naturalActor.map (MulAut.conj g).toMonoidHom) :=
    Group.IsPerfect.map _
  exact le_of_isPerfect_of_index_le_four _ naturalActor actor_index.le
    (mem_map_of_mem (MulAut.conj g).toMonoidHom hx)

/-- The full affine translation core is generated by its native actor commutators. -/
theorem naturalActor_core_commutator :
    ⁅pCore 2 naturalActor, (⊤ : Subgroup naturalActor)⁆ = pCore 2 naturalActor := by
  let F := Matrix.PSL3Four.F
  let e := naturalActorAffineEquiv
  let : Group.IsPerfect (Matrix.SL2.Affine F) := Matrix.SL2.affine_isPerfect F
    (by rw [Matrix.PSL3Four.card_F])
  let : IsElementaryAbelian 2 (pCore 2 (Matrix.SL2.Affine F)) :=
    (Matrix.SL2.affine_twoCore_eq F).symm ▸ inferInstance
  have hc := Matrix.PSL3Four.ElementaryParabolic.affine_core_commutator
    (MonoidHom.id (Matrix.SL2.Affine F)) Function.surjective_id
    (by rw [MonoidHom.ker_id]; exact IsPGroup.of_bot)
    (fun x hx => hx)
  apply map_injective (f := e.toMonoidHom) e.injective
  rw [map_commutator,pCore_map_iso,map_top_of_surjective _ e.surjective]
  exact hc

/-- In the literal outer quintet, commutators of its order-32 kernel with
the native actor give exactly the actor's actual translation core. -/
theorem naturalActor_outer_core_commutator :
    ⁅pCore 2 Q,naturalActor⁆ = naturalActor.pCoreIn 2 := by
  let : naturalActor.Normal := actor_normal
  have hc : naturalActor.pCoreIn 2 = pCore 2 Q ⊓ naturalActor := by
    apply le_antisymm
    · refine le_inf ?_ (pCoreIn_le 2 naturalActor)
      exact le_sSup ⟨by change ((pCore 2 naturalActor).map naturalActor.subtype).Normal; infer_instance,
        pCore_isPGroup.map naturalActor.subtype⟩
    · have hsub : (pCore 2 Q).subgroupOf naturalActor ≤ pCore 2 naturalActor :=
        le_sSup ⟨inferInstance,pCore_isPGroup.comap_subtype⟩
      rintro x hx
      exact mem_map_of_mem naturalActor.subtype (hsub (show
        (⟨x,hx.2⟩ : naturalActor) ∈ (pCore 2 Q).subgroupOf naturalActor from hx.1))
  apply le_antisymm
  · rw [hc]
    exact le_inf (commutator_le_left _ _) (commutator_le_right _ _)
  · have hm := congrArg (map naturalActor.subtype) naturalActor_core_commutator
    rw [map_commutator,←MonoidHom.range_eq_map,range_subtype] at hm
    change (pCore 2 naturalActor).map naturalActor.subtype ≤ _
    exact hm.ge.trans (commutator_mono (hc.trans_le inf_le_left) le_rfl)

/-- The native degree-22 and outer-quintet maps identify the same literal
translation core, retaining both embeddings. -/
theorem nativeActor_core_map_pair :
    (nativeActor.pCoreIn 2).map m22ToPairStabilizer =
      (naturalActor.pCoreIn 2).map Q.subtype := by
  have hi : Function.Injective m22ToPairStabilizer := by
    intro x y he
    exact m22Embedding_injective (congrArg Subtype.val he)
  rw [map_pCoreIn_of_injective 2 nativeActor m22ToPairStabilizer hi,nativeActor_map_pair,
    ←map_pCoreIn_of_injective 2 naturalActor Q.subtype Q.subtype_injective]

end Sporadic.Mathieu.M22ChapterH.Quintet



namespace Sporadic.Mathieu.M22ChapterH.Quintet
variable {E : Type*} [Group E] [Finite E]

/-- The actual local core in a central double cover admits no invariant
lift of the native translations disjoint from the covering kernel. -/
theorem nativeActor_no_normal_core_section
    (c : PerfectCentralCovering.Cover E M22) (hk : Nat.card c.toMonoidHom.ker = 2)
    (H : Subgroup (nativeActor.comap c.toMonoidHom)) [H.Normal]
    (hmap : H.map (c.toMonoidHom.subgroupComap nativeActor) = pCore 2 nativeActor)
    (hdis : H ⊓ (c.toMonoidHom.subgroupComap nativeActor).ker = ⊥) : False := by
  let P := nativeActor.comap c.toMonoidHom
  let q : P →* nativeActor := c.toMonoidHom.subgroupComap nativeActor
  have hq : Function.Surjective q :=
    c.toMonoidHom.subgroupComap_surjective_of_surjective nativeActor c.surjective
  have hker : q.ker = c.toMonoidHom.ker.subgroupOf P := by
    ext x
    exact Subtype.ext_iff
  have hcard : Nat.card q.ker = 2 := by
    rw [hker,Nat.card_congr (subgroupOfEquivOfLe
      (c.toMonoidHom.ker_le_comap nativeActor)).toEquiv]
    exact hk
  have hc : q.ker ≤ center P := by
    intro x hx
    apply mem_center_iff.mpr
    intro y
    exact Subtype.ext (mem_center_iff.mp
      (c.ker_le_center (show x.val ∈ c.toMonoidHom.ker from
        congrArg Subtype.val (show q x = 1 from hx))) y.val)
  have hle := PerfectCentralCovering.kernel_le_normal_core_lift q hq hc
    (IsPGroup.of_card (n := 1) (by simpa using hcard))
    (nativeActor_preimage_core c hk).2.1 H hmap
  have hzero : q.ker = ⊥ := by
    apply bot_unique
    intro x hx
    exact hdis ▸ (show x ∈ H ⊓ q.ker from ⟨hle hx,hx⟩)
  have hone : Nat.card q.ker = 1 := (eq_bot_iff_card q.ker).mp hzero
  omega

end Sporadic.Mathieu.M22ChapterH.Quintet

namespace Sporadic.Mathieu.M22ChapterH.Quintet
open MathieuCode.M22Quintet
variable {G E : Type*} [Group G] [Finite G] [Group E] [Finite E]

omit [Finite G] in
/-- The literal mutually normalized source pair cannot lift to a central
double cover when its commutator has the original selected kernel. -/
theorem nativeActor_no_selected_commutator_lift
    (A R : Subgroup G) (hAR : A ≤ normalizer (R : Set G))
    (hRA : R ≤ normalizer (A : Set G))
    (q : G →* MathieuCode.m22PairStabilizer)
    (hA : A.map q = (pCore 2 Q).map Q.subtype)
    (hR : R.map q = naturalActor.map Q.subtype)
    (c : PerfectCentralCovering.Cover E M22) (hk : Nat.card c.toMonoidHom.ker = 2)
    (g : R →* nativeActor.comap c.toMonoidHom)
    (hcompat : ∀ r, m22ToPairStabilizer (c.toMonoidHom (g r).val) = q r.val)
    (hkill : ∀ r : R, (r : G) ∈ A → q r.val = 1 → g r = 1) : False := by
  let P := nativeActor.comap c.toMonoidHom
  let f : P →* nativeActor := c.toMonoidHom.subgroupComap nativeActor
  have hi : Function.Injective m22ToPairStabilizer := by
    intro x y he
    exact m22Embedding_injective (congrArg Subtype.val he)
  have hfg : Function.Surjective (f.comp g) := by
    intro b
    have hb : m22ToPairStabilizer b.val ∈ R.map q := by
      rw [hR,←nativeActor_map_pair]
      exact mem_map_of_mem m22ToPairStabilizer b.property
    obtain ⟨x,hx,he⟩ := hb
    exact ⟨⟨x,hx⟩,Subtype.ext (hi ((hcompat ⟨x,hx⟩).trans he))⟩
  have hfc : f.ker ≤ center P := by
    intro x hx
    apply mem_center_iff.mpr
    intro y
    exact Subtype.ext (mem_center_iff.mp
      (c.ker_le_center (show x.val ∈ c.toMonoidHom.ker from
        congrArg Subtype.val (show f x = 1 from hx))) y.val)
  let : Group.IsPerfect P := nativeActor_preimage_isPerfect c hk
  have hg : Function.Surjective g :=
    PerfectCentralCovering.surjective_of_comp_surjective_of_ker_le_center_of_isPerfect f g hfg hfc
  let W := ⁅A,R⁆
  have hWR : W ≤ R := le_normalizer_iff_commutator_le_right.mp hAR
  have hWA : W ≤ A := le_normalizer_iff_commutator_le_left.mp hRA
  let D := W.subgroupOf R
  let : D.Normal := normal_subgroupOf_of_le_normalizer (normalizer_commutator_ge_right A R)
  let H := D.map g
  let : H.Normal := Normal.map inferInstance g hg
  have hmap : H.map f = pCore 2 nativeActor := by
    let j := m22ToPairStabilizer.comp nativeActor.subtype
    apply map_injective (f := j) (hi.comp nativeActor.subtype_injective)
    calc
      (H.map f).map j = D.map (q.comp R.subtype) := by
        rw [map_map]
        change (D.map g).map (j.comp f) = _
        rw [map_map]
        congr 1
        exact MonoidHom.ext hcompat
      _ = (naturalActor.pCoreIn 2).map Q.subtype := by
        rw [←map_map,map_subgroupOf_eq_of_le hWR,map_commutator,hA,hR,←map_commutator,
          naturalActor_outer_core_commutator]
      _ = (pCore 2 nativeActor).map j := by
        simpa only [Subgroup.pCoreIn,map_map] using nativeActor_core_map_pair.symm
  have hdis : H ⊓ f.ker = ⊥ := by
    apply bot_unique
    rintro x ⟨⟨r,hr,he⟩,hx⟩
    have hq : q r.val = 1 := by
      rw [←hcompat,he]
      exact (congrArg m22ToPairStabilizer
        (congrArg Subtype.val (show f x = 1 from hx))).trans (map_one _)
    exact mem_bot.mpr (he.symm.trans (hkill r (hWA hr) hq))
  exact nativeActor_no_normal_core_section c hk H hmap hdis

end Sporadic.Mathieu.M22ChapterH.Quintet
