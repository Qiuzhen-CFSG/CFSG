module
public import Theory.GroupTheory.PerfectCentralCoverIndexTwoRestriction
public import Theory.Mathieu.M22.CentralDoubleExtension
public import Theory.SpecificGroups.PSL3Four.CentralCover.ElementaryParabolic.Commutator
public import Theory.SpecificGroups.SL2.Affine.Structure
public import Theory.Mathieu.M22.Properties.PairCoreIncidence

/-!
# The affine half of a pair stabilizer in a central double cover of M₂₂

A perfect subgroup of order 960 inside an actual order-1920 pair stabilizer
has perfect full inverse image in every perfect central double cover of M₂₂.
This follows from the odd index 231 and the index-two restriction theorem.
For its natural affine marking, the M₂₂ involution-lifting theorem makes the
lifted two-core elementary; the affine commutator theorem makes that entire
core generated by its commutators with the local group. Counting retains
its order 32 and the original covering map throughout.

Source: Aschbacher--Smith I.2.2(3b),(6), printed pp.410,412, as used in
8.2.10(3), printed p.721. Native quintet placement is a separate geometric
application of the actual subgroup form.
-/

public section
namespace Sporadic.Mathieu.M22CentralCover
open Subgroup PerfectCentralCovering Matrix.PSL3Four
variable {K : Type*} [Group K] [Finite K]

/-- The whole preimage of the actual perfect half of an M22 pair stabilizer
is perfect, including the covering involution. -/
theorem perfect_pair_half_preimage (c : Cover K M22)
    (hk : Nat.card c.toMonoidHom.ker = 2)
    (J B : Subgroup M22) (hJ : Nat.card J = 1920) (hB : Nat.card B = 960)
    (hBJ : B ≤ J) [Group.IsPerfect B] :
    Group.IsPerfect (B.comap c.toMonoidHom) := by
  apply c.perfect_preimage_of_index_two hk J B hBJ
  · have hi : J.index = 231 := by
      have hh := J.card_mul_index
      rw [hJ, m22_order] at hh
      omega
    rw [hi]
    decide
  · have hc : Nat.card (B.subgroupOf J) = 960 :=
      (Nat.card_congr (subgroupOfEquivOfLe hBJ).toEquiv).trans hB
    have hh := (B.subgroupOf J).card_mul_index
    rw [hc,hJ] at hh
    omega

/-- The native disjoint-pair stabilizer retains its original subgroup map. -/
theorem perfect_disjoint_pair_half_preimage (c : Cover K M22)
    (hk : Nat.card c.toMonoidHom.ker = 2)
    (B : Subgroup M22) (hB : Nat.card B = 960)
    (hBJ : B ≤ m22DisjointPairStabilizer) [Group.IsPerfect B] :
    Group.IsPerfect (B.comap c.toMonoidHom) :=
  perfect_pair_half_preimage c hk _ B m22DisjointPairStabilizer_card hB hBJ

/-- The actual affine restriction of the original central cover has elementary
two-core, and that entire core is generated by its local action commutators. -/
theorem affine_pair_half_preimage_core (c : Cover K M22)
    (hk : Nat.card c.toMonoidHom.ker = 2)
    (J B : Subgroup M22) (hJ : Nat.card J = 1920) (hB : Nat.card B = 960)
    (hBJ : B ≤ J) (e : B ≃* Matrix.SL2.Affine F) :
    let P := B.comap c.toMonoidHom
    IsElementaryAbelian 2 (pCore 2 P) ∧
      ⁅pCore 2 P, (⊤ : Subgroup P)⁆ = pCore 2 P ∧ Nat.card (pCore 2 P) = 32 := by
  let f := c.toMonoidHom
  let P := B.comap f
  let q : P →* B := f.subgroupComap B
  let g : P →* Matrix.SL2.Affine F := e.toMonoidHom.comp q
  have hq : Function.Surjective q := f.subgroupComap_surjective_of_surjective B c.surjective
  have hg : Function.Surjective g := e.surjective.comp hq
  have hker : g.ker = f.ker.subgroupOf P := by
    ext x
    change e (q x) = 1 ↔ f x.val = 1
    rw [←e.map_one, e.injective.eq_iff]
    exact Subtype.ext_iff
  have hcard : Nat.card g.ker = 2 := by
    rw [hker,Nat.card_congr (subgroupOfEquivOfLe (f.ker_le_comap B)).toEquiv]
    exact hk
  have hkg : IsPGroup 2 g.ker := IsPGroup.of_card (n := 1) (by simpa using hcard)
  let : Group.IsPerfect B := Matrix.SL2.isPerfect_of_equiv_affine F (by rw [card_F]) e
  let : Group.IsPerfect P := perfect_pair_half_preimage c hk J B hJ hB hBJ
  have hlift (x : P) (hx : (g x)^2 = 1) : x^2 = 1 := by
    have hx' : (e (q x))^2 = 1 := hx
    have hb : (q x)^2 = 1 := e.injective (by simpa only [map_pow,map_one] using hx')
    exact Subtype.ext (square_eq_one_of_central_double_extension f c.surjective hk
      c.ker_le_center x.val (congrArg Subtype.val hb))
  have hpre := g.comap_pCore_of_ker_isPGroup hg hkg
  let : IsElementaryAbelian 2 (pCore 2 (Matrix.SL2.Affine F)) :=
    (Matrix.SL2.affine_twoCore_eq F).symm ▸ inferInstance
  have hs (x : pCore 2 P) : x^2 = 1 := by
    have hx : g x.val ∈ pCore 2 (Matrix.SL2.Affine F) :=
      show x.val ∈ (pCore 2 (Matrix.SL2.Affine F)).comap g from hpre.symm ▸ x.property
    exact Subtype.ext (hlift x.val (elemPow_eq_one_of_isElementaryAbelian _ hx))
  let hE : IsElementaryAbelian 2 (pCore 2 P) :=
    { toIsMulCommutative := ⟨⟨fun a b => (Commute.of_orderOf_dvd_two
        (fun x => orderOf_dvd_of_pow_eq_one (hs x)) a b).eq⟩⟩
      exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hs }
  refine ⟨hE, ElementaryParabolic.affine_core_commutator g hg hkg hlift, ?_⟩
  rw [g.card_pCore_of_ker_isPGroup hg hkg,hcard,Matrix.SL2.affine_twoCore_eq,
    ←Nat.card_congr (Matrix.SL2.translationsEquiv F).toEquiv,
    Nat.card_congr (Multiplicative.toAdd : Multiplicative (Fin 2 → F) ≃ (Fin 2 → F)),
    Nat.card_fun,Nat.card_fin,card_F]
  norm_num

end Sporadic.Mathieu.M22CentralCover
