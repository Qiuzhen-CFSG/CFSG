module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.SpecificGroups.Alternating
public import Theory.Mathieu.M22.Block
public import Theory.Mathieu.M22.Generators

open Theory.GroupTheory

namespace Sporadic.Mathieu

open scoped Pointwise
set_option maxRecDepth 100000

/-- The full automorphism group of the hexad design; GLS identifies this with `Aut(M22)`. -/
@[expose] public noncomputable def m22DesignAut : Subgroup (Equiv.Perm (Fin 22)) :=
  m22WittDesign.aut

/-- The Atlas two-generator subgroup, retained as the computational model for order certificates. -/
@[expose] public def m22Atlas : Subgroup (Equiv.Perm (Fin 22)) :=
  Subgroup.closure {m22GeneratorA, m22GeneratorB}

/-- The Atlas computational subgroup is generated by the two standard degree-22 generators. -/
public theorem m22Atlas_eq_closure :
    m22Atlas = Subgroup.closure {m22GeneratorA, m22GeneratorB} := rfl

/-- The Mathieu group M22 is the even part of the hexad-design automorphism group. -/
@[expose] public noncomputable def M22 : Subgroup (Equiv.Perm (Fin 22)) :=
  m22DesignAut ⊓ alternatingGroup (Fin 22)

/-- M22 is finite as a subgroup of a finite permutation group. -/
public noncomputable instance : Fintype M22 := Fintype.ofFinite _

/-- The Atlas computational subgroup is finite. -/
public noncomputable instance : Fintype m22Atlas := Fintype.ofFinite _

/-- Every block of the degree-22 design has size six. -/
public theorem m22Blocks_card (B : Finset (Fin 22)) (hB : B ∈ m22Blocks) : B.card = 6 :=
  m22Block_card B hB

/-- Every three-set lies in exactly one hexad. -/
public theorem m22Blocks_unique_block (S : Finset (Fin 22)) (hS : S.card = 3) :
    (m22Blocks.filter (fun B => S ⊆ B)).card = 1 := by
  simpa only [m22WittDesign, SteinerSystem.ofPairwiseIntersection_blocks] using
    m22WittDesign.steiner S hS


/-- The first standard generator belongs to the full hexad-design automorphism group. -/
public theorem m22GeneratorA_designAut : m22GeneratorA ∈ m22DesignAut := by
  rw [m22DesignAut, SteinerSystem.mem_aut_iff]
  have h := congrArg (fun s : Finset (Finset (Fin 22)) => (s : Set (Finset (Fin 22))))
    m22GeneratorA_blocks_smul
  simpa only [m22WittDesign, SteinerSystem.ofPairwiseIntersection_blocks,
    Finset.coe_smul_finset] using h

/-- The second standard generator belongs to the full hexad-design automorphism group. -/
public theorem m22GeneratorB_designAut : m22GeneratorB ∈ m22DesignAut := by
  rw [m22DesignAut, SteinerSystem.mem_aut_iff]
  have h := congrArg (fun s : Finset (Finset (Fin 22)) => (s : Set (Finset (Fin 22))))
    m22GeneratorB_blocks_smul
  simpa only [m22WittDesign, SteinerSystem.ofPairwiseIntersection_blocks,
    Finset.coe_smul_finset] using h

/-- The first Atlas generator is an even permutation. -/
public theorem m22GeneratorA_alternating :
    m22GeneratorA ∈ alternatingGroup (Fin 22) := by
  rw [Equiv.Perm.mem_alternatingGroup]
  simp [m22GeneratorA, Equiv.Perm.sign_swap']

/-- The second Atlas generator is an even permutation. -/
public theorem m22GeneratorB_alternating :
    m22GeneratorB ∈ alternatingGroup (Fin 22) := by
  rw [Equiv.Perm.mem_alternatingGroup]
  simp [m22GeneratorB, List.formPerm, Equiv.Perm.sign_swap']

/-- The first Atlas generator belongs to the Steiner-defined M22. -/
public theorem m22GeneratorA_mem_M22 : m22GeneratorA ∈ M22 :=
  ⟨m22GeneratorA_designAut, m22GeneratorA_alternating⟩

/-- The second Atlas generator belongs to the Steiner-defined M22. -/
public theorem m22GeneratorB_mem_M22 : m22GeneratorB ∈ M22 :=
  ⟨m22GeneratorB_designAut, m22GeneratorB_alternating⟩

/-- The Atlas computational subgroup is contained in the Steiner-defined M22. -/
public theorem m22Atlas_le_M22 : m22Atlas ≤ M22 := by
  rw [m22Atlas, Subgroup.closure_le]
  intro g hg
  rcases hg with (rfl | rfl)
  · exact m22GeneratorA_mem_M22
  · exact m22GeneratorB_mem_M22

/-- The Steiner-defined M22 is contained in the full design automorphism group. -/
public theorem M22_le_m22DesignAut : M22 ≤ m22DesignAut :=
  inf_le_left

/-- The Steiner-defined M22 consists of even permutations. -/
public theorem M22_le_alternatingGroup : M22 ≤ alternatingGroup (Fin 22) :=
  inf_le_right

/-- The Atlas computational subgroup preserves the hexad design. -/
public theorem m22Atlas_le_m22DesignAut : m22Atlas ≤ m22DesignAut :=
  m22Atlas_le_M22.trans M22_le_m22DesignAut

end Sporadic.Mathieu
