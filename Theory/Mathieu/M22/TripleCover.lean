module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.LinearNormalizer.CoreRecognition
public import Theory.Mathieu.M22.Properties.Simplicity
public import Theory.GroupTheory.Covering

/-!
# A genuine triple cover of M₂₂

We use the perfect even-word subgroup of the explicit binary ATLAS matrices.
Its action on the 22 endpoint stars identifies its central quotient with the
native Mathieu group. Its center is generated by the certified scalar word
of order three. Thus this is a quasisimple triple cover, with no split-product
interpretation.

The construction and finite certificates are reused from the J₄ local matrix
development; the original ATLAS data and attribution are retained in
`Theory/SpecificGroups/Janko4/Model/AutomorphismReduction/FixedGenerator/NormalizerSquares/LocalAction/TwoCoreNormalizer/LinearModel/source/`.
This subject-level interface is used for the module in Aschbacher–Smith,
H.12.1, printed pp.393–394. Recognition of an arbitrary triple cover as this
one is a separate theorem obligation.
-/

@[expose] public section

namespace Sporadic.Mathieu

open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel

/-- The concrete perfect binary matrix group with central quotient M₂₂. -/
abbrev M22TripleCover := derivedGroup

namespace M22TripleCover

/-- The distinguished order-three central scalar. -/
abbrev scalar : M22TripleCover := coreScalar

/-- The native central quotient, not merely an equality of group orders. -/
noncomputable def centralQuotientEquiv :
    M22TripleCover ⧸ Subgroup.center M22TripleCover ≃* M22 :=
  derivedQuotientEquivM22

instance quasisimple : Theory.GroupTheory.IsQuasisimple M22TripleCover where
  toIsPerfect := inferInstance
  simple := by
    let : IsSimpleGroup M22 := m22_isSimpleGroup
    exact centralQuotientEquiv.isSimpleGroup

theorem scalar_order : orderOf scalar = 3 :=
  orderOf_eq_prime coreScalar_pow_three coreScalar_ne_one

theorem scalar_mem_center : scalar ∈ Subgroup.center M22TripleCover :=
  coreScalar_mem_center

theorem center_eq_zpowers : Subgroup.center M22TripleCover = Subgroup.zpowers scalar :=
  center_derivedGroup_eq_zpowers

theorem center_card : Nat.card (Subgroup.center M22TripleCover) = 3 := by
  rw [center_eq_zpowers, Nat.card_zpowers, scalar_order]

theorem card : Nat.card M22TripleCover = 1330560 := by
  have h := (Subgroup.center M22TripleCover).card_mul_index
  rw [center_card, Subgroup.index_eq_card,
    Nat.card_congr centralQuotientEquiv.toEquiv, m22_order] at h
  exact h.symm

/-- Perfectness rules out the split product with a central factor of order three. -/
theorem not_equiv_split : ¬ Nonempty (M22TripleCover ≃* M22 × Multiplicative (ZMod 3)) := by
  rintro ⟨e⟩
  let f := (MonoidHom.snd M22 (Multiplicative (ZMod 3))).comp e.toMonoidHom
  have hf : Function.Surjective f := by
    intro z
    obtain ⟨x, hx⟩ := e.surjective (1, z)
    exact ⟨x, congrArg Prod.snd hx⟩
  let : Group.IsPerfect (Multiplicative (ZMod 3)) := Group.IsPerfect.ofSurjective hf
  have : Subsingleton (Multiplicative (ZMod 3)) := inferInstance
  exact not_subsingleton (Multiplicative (ZMod 3)) inferInstance

end M22TripleCover
end Sporadic.Mathieu
