module
public import Theory.Mathieu.M22.ValueBoundParabolics.OddCoverLifting.SymmetricSplitting
public import Theory.Mathieu.M22.ValueBoundParabolics.OddCoverLifting.CanonicalComplement
import all Theory.Mathieu.M22.ValueBoundParabolics.OddCoverLifting.SymmetricSplitting

/-! Internal companion to the existing Coxeter splitting proof: its relation
argument is reused for degree four without changing the shared source module.
The exposed conclusion is a characteristic actual S4 complement. The odd
central kernel contributes no two-elements, so the complement is exactly the
subgroup generated by two-elements and hence is characteristic.
Source: the rank-three Coxeter presentation of S4, as used in the source
A7/triple-A7 exclusion of Aschbacher--Smith 2.5.2, printed p.551. -/
public section
namespace Sporadic.Mathieu.M22ValueBound.OddCoverLifting
open Subgroup
universe u

theorem symmetricOddCentralSplitting_four : SymmetricOddCentralSplitting.{u} 4 := by
  apply symmetricOddCentralSplitting_of_relations 3
  unfold CoxeterMatrix.IsLiftable
  decide

theorem exists_characteristic_symmetric_four_complement
    {E : Type u} [Group E] [Finite E] (f : E →* Equiv.Perm (Fin 4))
    (hf : Function.Surjective f) (hc : f.ker ≤ center E) (ho : Odd (Nat.card f.ker)) :
    ∃ D : Subgroup E, D.Characteristic ∧ f.ker.IsComplement' D ∧
      ∃ e : D ≃* Equiv.Perm (Fin 4), ∀ d, e d = f d := by
  obtain ⟨D,hD⟩ := symmetricOddCentralSplitting_four E f hf hc ho
  let e : D ≃* Equiv.Perm (Fin 4) := hD.symm.QuotientMulEquiv.symm.trans
    (QuotientGroup.quotientKerEquivOfSurjective f hf)
  refine ⟨D,characteristic_complement_of_twoGenerated_quotient f hf hc ho
    (twoGenerated_perm 4) D hD,hD,e,?_⟩
  intro d
  rfl

end Sporadic.Mathieu.M22ValueBound.OddCoverLifting
