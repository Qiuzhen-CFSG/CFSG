module

public import Theory.Mathieu.M22.ValueBoundParabolics.OddCoverLifting.Basic
public import Mathlib.GroupTheory.Perm.Sign

/-!
# Canonical complements to odd central kernels

If a group is generated by elements of two-power order, any complement to
an odd central kernel in a finite central extension is characteristic.
Indeed the complement is normal, its quotient has odd order, and hence it
contains every two-element of the cover. Its own two-elements generate it,
so it is exactly the characteristic subgroup generated by all two-elements.

Generation by two-elements lifts across a two-group kernel. Since
transpositions generate a symmetric group, the invariance criterion applies
to every group whose intrinsic two-core quotient is symmetric. Existence
of the complement is a separate assertion and is not assumed to follow
from this uniqueness argument.

This is the invariance step for the local lifts in Aschbacher–Smith,
E.4.3(2), printed pp. 241–242, combined manuscript of 1 March 2004.
-/

public section
open Subgroup
namespace Sporadic.Mathieu.M22ValueBound.OddCoverLifting

/-- The characteristic subgroup generated by all elements of two-power order. -/
@[expose] def twoGenerated (E : Type*) [Group E] : Subgroup E :=
  closure {x : E | ∃ n : ℕ, x ^ (2 ^ n) = 1}

/-- Homomorphisms preserve the subgroup generated by two-elements. -/
theorem twoGenerated_map_le {E F : Type*} [Group E] [Group F] (f : E →* F) :
    (twoGenerated E).map f ≤ twoGenerated F := by
  rw [twoGenerated, MonoidHom.map_closure]
  apply (closure_le _).mpr
  rintro _ ⟨x, ⟨n, hn⟩, rfl⟩
  exact subset_closure ⟨n, by rw [← map_pow, hn, map_one]⟩

instance twoGenerated_characteristic (E : Type*) [Group E] :
    (twoGenerated E).Characteristic :=
  characteristic_iff_map_le.mpr (fun e => twoGenerated_map_le e.toMonoidHom)

/-- Isomorphisms transport the subgroup generated by two-elements exactly. -/
theorem twoGenerated_map_equiv {E F : Type*} [Group E] [Group F] (e : E ≃* F) :
    (twoGenerated E).map e.toMonoidHom = twoGenerated F := by
  apply le_antisymm (twoGenerated_map_le _)
  have h := map_mono (f := e.toMonoidHom) (twoGenerated_map_le e.symm.toMonoidHom)
  have hi : e.toMonoidHom.comp e.symm.toMonoidHom = MonoidHom.id F := by
    ext x
    exact e.apply_symm_apply x
  simpa only [map_map, hi, map_id] using h

/-- Every two-subgroup lies in the subgroup generated by two-elements. -/
theorem isPGroup_le_twoGenerated {E : Type*} [Group E]
    (P : Subgroup E) (hP : IsPGroup 2 P) : P ≤ twoGenerated E := by
  intro x hx
  obtain ⟨n, hn⟩ := hP ⟨x, hx⟩
  exact subset_closure ⟨n, congrArg Subtype.val hn⟩

/-- Across a two-group kernel, every quotient two-element lifts to a two-element. -/
theorem twoGenerated_map_of_ker_isPGroup
    {E F : Type*} [Group E] [Group F] (f : E →* F)
    (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker) :
    (twoGenerated E).map f = twoGenerated F := by
  apply le_antisymm (twoGenerated_map_le f)
  apply (closure_le _).mpr
  rintro y ⟨n, hn⟩
  obtain ⟨x, rfl⟩ := hf y
  have hx : x ^ (2 ^ n) ∈ f.ker := by
    rw [MonoidHom.mem_ker, map_pow, hn]
  obtain ⟨k, hk⟩ := hk ⟨x ^ (2 ^ n), hx⟩
  apply mem_map.mpr
  refine ⟨x, subset_closure ⟨n + k, ?_⟩, rfl⟩
  have hkval : (x ^ (2 ^ n)) ^ (2 ^ k) = 1 := congrArg Subtype.val hk
  simpa only [pow_add, pow_mul] using hkval

/-- Generation by two-elements lifts across a two-group kernel. -/
theorem twoGenerated_eq_top_of_ker_isPGroup
    {E F : Type*} [Group E] [Group F] (f : E →* F)
    (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker)
    (hgen : twoGenerated F = ⊤) : twoGenerated E = ⊤ := by
  apply map_injective_of_ker_le f (isPGroup_le_twoGenerated f.ker hk) le_top
  rw [twoGenerated_map_of_ker_isPGroup f hf hk, hgen, map_top_of_surjective _ hf]

/-- Transpositions generate every finite symmetric group. -/
theorem twoGenerated_perm (n : ℕ) : twoGenerated (Equiv.Perm (Fin n)) = ⊤ := by
  apply top_unique
  rw [← Equiv.Perm.closure_isSwap]
  apply closure_mono
  rintro x ⟨a, b, hab, rfl⟩
  exact ⟨1, by simp [pow_two]⟩

/-- A group with symmetric two-core quotient is generated by two-elements. -/
theorem twoGenerated_of_symmetric_twoCore
    {F : Type*} [Group F] {n : ℕ}
    (e : (F ⧸ pCore 2 F) ≃* Equiv.Perm (Fin n)) :
    twoGenerated F = ⊤ := by
  apply twoGenerated_eq_top_of_ker_isPGroup (QuotientGroup.mk' (pCore 2 F))
    (QuotientGroup.mk'_surjective _)
  · rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  · apply map_injective (f := e.toMonoidHom) e.injective
    rw [twoGenerated_map_equiv e, twoGenerated_perm,
      map_top_of_surjective _ e.surjective]

/-- A complement generated by two-elements to an odd central subgroup is
exactly the subgroup generated by all two-elements of the ambient group. -/
theorem complement_eq_twoGenerated {E : Type*} [Group E] [Finite E]
    (C D : Subgroup E) (hc : C ≤ center E) (hodd : Odd (Nat.card C))
    (hcomp : C.IsComplement' D) (hgen : twoGenerated D = ⊤) :
    D = twoGenerated E := by
  have hn : (⊤ : Subgroup E) ≤ normalizer (D : Set E) := by
    rw [← hcomp.sup_eq_top]
    exact sup_le (hc.trans (center_le_normalizer _)) D.le_normalizer
  let : D.Normal := normalizer_eq_top_iff.mp (top_unique hn)
  have hoddQ : Odd (Nat.card (E ⧸ D)) := by
    rw [Nat.card_congr hcomp.QuotientMulEquiv.toEquiv]
    exact hodd
  apply le_antisymm
  · have h := twoGenerated_map_le D.subtype
    rwa [hgen, ← MonoidHom.range_eq_map, range_subtype] at h
  · apply (closure_le _).mpr
    rintro x ⟨n, hn⟩
    apply (QuotientGroup.eq_one_iff x).mp
    apply (hoddQ.coprime_two_right.pow_right n).pow_left_bijective.injective
    change (QuotientGroup.mk' D x) ^ (2 ^ n) = 1 ^ (2 ^ n)
    rw [← map_pow, hn, map_one, one_pow]

/-- A complement to an odd central kernel is characteristic whenever the
quotient is generated by two-elements. This requires no ambient splitting model. -/
theorem characteristic_complement_of_twoGenerated_quotient
    {E F : Type*} [Group E] [Group F] [Finite E]
    (f : E →* F) (hf : Function.Surjective f)
    (hc : f.ker ≤ center E) (hodd : Odd (Nat.card f.ker))
    (hgen : twoGenerated F = ⊤)
    (D : Subgroup E) (hcomp : f.ker.IsComplement' D) :
    D.Characteristic := by
  let e : D ≃* F := hcomp.symm.QuotientMulEquiv.symm.trans
    (QuotientGroup.quotientKerEquivOfSurjective f hf)
  have hDgen : twoGenerated D = ⊤ := by
    apply map_injective (f := e.toMonoidHom) e.injective
    rw [twoGenerated_map_equiv e, hgen, map_top_of_surjective _ e.surjective]
  rw [complement_eq_twoGenerated f.ker D hc hodd hcomp hDgen]
  infer_instance

/-- The invariance needed to adjoin outer automorphisms in the local lifting
argument follows from the intrinsic symmetric quotient. -/
theorem characteristic_complement_of_symmetric_twoCore
    {E F : Type*} [Group E] [Group F] [Finite E]
    (f : E →* F) (hf : Function.Surjective f)
    (hc : f.ker ≤ center E) (hodd : Odd (Nat.card f.ker))
    {n : ℕ} (e : (F ⧸ pCore 2 F) ≃* Equiv.Perm (Fin n))
    (D : Subgroup E) (hcomp : f.ker.IsComplement' D) : D.Characteristic :=
  characteristic_complement_of_twoGenerated_quotient f hf hc hodd
    (twoGenerated_of_symmetric_twoCore e) D hcomp

end Sporadic.Mathieu.M22ValueBound.OddCoverLifting
