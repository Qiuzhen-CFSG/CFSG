def rowTable (i : Fin 128) : Fin 22 → Fin 22 := tableApply (rowCode i)

def rowInvTable (i : Fin 128) : Fin 22 → Fin 22 := tableApply (rowInvCode i)

def permutationKey (f : Fin 22 → Fin 22) : Nat :=
  (f 0).val * 22 ^ 2 + (f 1).val * 22 + (f 3).val

def fiveKey (i : Fin 128) : Fin 5 → Nat :=
  Fin.cases (permutationKey id) fun j =>
    let k := conjugatorIndex i j
    permutationKey (fun x => rowTable k (rowTable i (rowInvTable k x)))

end Sporadic.Mathieu.M22FourNormalizers.FixedSylow
