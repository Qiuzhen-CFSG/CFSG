public import Theory.Mathieu.M22.Properties.FourNormalizers.FixedSylow.Generators
public import Mathlib.Order.Fin.Basic

/-!
# Witnesses for the marked M₂₂ Sylow subgroup

The 128 words have distinct images of the triple (0,1,3), exhausting the
Sylow subgroup once their membership is proved. Every involution outside
the pointwise hexad kernel has four distinct Sylow conjugates. Together
with the identity these cannot lie in a subgroup of order four.

`source/generate.py` produces these witnesses from the three permutations;
`Checks` proves their identities using kernel reduction. This is the finite
coverage step in the M₂₂ case of Aschbacher–Smith 15.3.43, printed p.1140.
-/

@[expose] public section
namespace Sporadic.Mathieu.M22FourNormalizers.FixedSylow
set_option maxRecDepth 100000

def tableApply (n : Nat) (x : Fin 22) : Fin 22 :=
  ⟨((n >>> (5 * x.val)) % 32) % 22, Nat.mod_lt _ (by decide)⟩

def wordAction : List (Fin 3) → Fin 22 → Fin 22
  | [] => id
  | j :: w => fun x => generatorTable j (wordAction w x)

