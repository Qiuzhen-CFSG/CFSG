module

public import Theory.Mathieu.M22.Properties.Order
public import Mathlib.GroupTheory.Sylow
import Mathlib.Tactic.FinCases

/-!
# Eleven-by-five Frobenius configurations in M22

A word in the degree-22 ATLAS generators gives an element `y` of order five
normalizing the cyclic group generated by `x = a * b`, of order eleven.
Conjugation by `y` sends `x` to its cube. The permutation tables are checked
against the words, so both elements belong to the actual Steiner-system M22.
A kernel-checked calculation on the 55 pairs of powers verifies that every
nonidentity element of the complement acts without nonidentity fixed points.

The known order 443520 makes every order-five subgroup Sylow. Sylow conjugacy
therefore transports the concrete configuration to each order-five element.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, H.12.1,
printed p.394 / PDF p.405 (combined manuscript of 1 March 2004), the Frobenius
subgroup of order 55 used in the proof of the order-five displacement bound.
The ATLAS generators and their Steiner-model membership are supplied by
`Theory.Mathieu.M22.Properties.Order`.
-/

namespace Sporadic.Mathieu
noncomputable section
open Subgroup
set_option maxRecDepth 100000

private def frobA : M22 := ⟨m22GeneratorA, m22GeneratorA_mem_M22⟩
private def frobB : M22 := ⟨m22GeneratorB, m22GeneratorB_mem_M22⟩
private def frobXWord : M22 := frobA * frobB
private def frobYWord : M22 :=
  frobB * frobA * frobB * frobA * frobB⁻¹ * frobA * frobB⁻¹ * frobA * frobB⁻¹ *
  frobA * frobB * frobB * frobA * frobB⁻¹ * frobA * frobB * frobA * frobB * frobB *
  frobA * frobB⁻¹

private def frobXPerm : Equiv.Perm (Fin 22) where
  toFun := ![16, 6, 18, 21, 1, 4, 14, 15, 11, 10, 2, 17, 5, 8, 20, 0, 3, 19, 12, 7, 9, 13]
  invFun := ![15, 4, 10, 16, 5, 12, 1, 19, 13, 20, 9, 8, 18, 21, 6, 7, 0, 11, 2, 17, 14, 3]
  left_inv := by decide +kernel
  right_inv := by decide +kernel
private def frobYPerm : Equiv.Perm (Fin 22) where
  toFun := ![7, 5, 10, 13, 2, 20, 6, 21, 3, 4, 14, 8, 1, 15, 9, 11, 16, 19, 12, 0, 18, 17]
  invFun := ![19, 12, 4, 8, 9, 1, 6, 0, 11, 14, 2, 15, 18, 3, 10, 13, 16, 21, 20, 17, 5, 7]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

private theorem frobXPerm_eq_word : frobXPerm = (frobXWord : Equiv.Perm (Fin 22)) := by
  ext i
  fin_cases i <;> decide +kernel
private theorem frobYPerm_eq_word : frobYPerm = (frobYWord : Equiv.Perm (Fin 22)) := by
  ext i
  fin_cases i <;> decide +kernel

private def frobX : M22 := ⟨frobXPerm, frobXPerm_eq_word.symm ▸ frobXWord.property⟩
private def frobY : M22 := ⟨frobYPerm, frobYPerm_eq_word.symm ▸ frobYWord.property⟩

private theorem frobX_order : orderOf frobX = 11 := by
  let : Fact (Nat.Prime 11) := ⟨Nat.prime_eleven⟩
  apply orderOf_eq_prime
  · apply Subtype.ext
    decide +kernel
  · intro h
    have hne : (frobX : Equiv.Perm (Fin 22)) ≠ 1 := by decide +kernel
    exact hne (congrArg Subtype.val h)

private theorem frobY_order : orderOf frobY = 5 := by
  let : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  apply orderOf_eq_prime
  · apply Subtype.ext
    decide +kernel
  · intro h
    have hne : (frobY : Equiv.Perm (Fin 22)) ≠ 1 := by decide +kernel
    exact hne (congrArg Subtype.val h)

private theorem frob_relation : frobY * frobX * frobY⁻¹ = frobX ^ 3 := by
  apply Subtype.ext
  decide +kernel

private theorem frob_fixed_point_check : ∀ (i : Fin 5) (j : Fin 11), i ≠ 0 →
    (frobYPerm ^ i.val * frobXPerm ^ j.val * (frobYPerm ^ i.val)⁻¹) 0 =
      (frobXPerm ^ j.val) 0 → j = 0 := by
  decide +kernel

private theorem frob_normalizes : zpowers frobY ≤ normalizer (zpowers frobX : Set M22) := by
  apply zpowers_le.mpr
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [MonoidHom.map_zpowers]
  change zpowers (frobY * frobX * frobY⁻¹) = zpowers frobX
  rw [frob_relation]
  apply le_antisymm
  · exact zpowers_le.mpr (npow_mem_zpowers _ _)
  · apply zpowers_le.mpr
    rw [mem_zpowers_pow_iff, frobX_order]
    decide

private theorem frob_free : ∀ a ∈ zpowers frobY, a ≠ 1 →
    ∀ k ∈ zpowers frobX, a * k * a⁻¹ = k → k = 1 := by
  intro a ha ha1 k hk heq
  rw [mem_zpowers_iff_mem_range_orderOf, frobY_order] at ha
  rw [mem_zpowers_iff_mem_range_orderOf, frobX_order] at hk
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ha
  obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hk
  have hi0 : (⟨i, Finset.mem_range.mp hi⟩ : Fin 5) ≠ 0 := by
    intro h
    have : i = 0 := congrArg Fin.val h
    exact ha1 (by simp [this])
  have hj0 := frob_fixed_point_check ⟨i, Finset.mem_range.mp hi⟩
    ⟨j, Finset.mem_range.mp hj⟩ hi0
    (congrArg (fun g : M22 => (g : Equiv.Perm (Fin 22)) 0) heq)
  have : j = 0 := congrArg Fin.val hj0
  simp [this]


private def frobFiveSylow (P : Subgroup M22) (hP : Nat.card P = 5) : Sylow 5 M22 := by
  let : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  apply (IsPGroup.of_card (p := 5) (n := 1) (by simpa using hP)).toSylow
  have hc := P.card_mul_index
  rw [hP, m22_order] at hc
  have hi : P.index = 88704 := by omega
  rw [hi]
  decide

private theorem frob_transport (y : M22) (hy : orderOf y = 5) (K : Subgroup M22)
    (hK : Nat.card K = 11) (hn : zpowers y ≤ normalizer (K : Set M22))
    (hfree : ∀ a ∈ zpowers y, a ≠ 1 → ∀ k ∈ K, a * k * a⁻¹ = k → k = 1)
    (v : M22) (hv : orderOf v = 5) :
    ∃ L : Subgroup M22, Nat.card L = 11 ∧
      zpowers v ≤ normalizer (L : Set M22) ∧
      ∀ a ∈ zpowers v, a ≠ 1 → ∀ k ∈ L, a * k * a⁻¹ = k → k = 1 := by
  let : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  let P := frobFiveSylow (zpowers y) (by rwa [Nat.card_zpowers])
  let Q := frobFiveSylow (zpowers v) (by rwa [Nat.card_zpowers])
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq M22 P Q
  let e := MulAut.conj g
  have hmap : (zpowers y).map e.toMonoidHom = zpowers v :=
    congrArg Sylow.toSubgroup hg
  refine ⟨K.map e.toMonoidHom, ?_, ?_, ?_⟩
  · exact (Nat.card_congr (e.subgroupMap K).toEquiv).symm.trans hK
  · rw [← hmap]
    exact (map_mono hn).trans (K.le_normalizer_map e.toMonoidHom)
  · intro a ha ha1 k hk heq
    rw [← hmap, mem_map_equiv] at ha
    rw [mem_map_equiv] at hk
    have ha1' : e.symm a ≠ 1 := by
      simpa only [ne_eq, e.symm.map_eq_one_iff] using ha1
    have hfix : e.symm a * e.symm k * (e.symm a)⁻¹ = e.symm k := by
      simpa only [map_mul, map_inv] using congrArg e.symm heq
    exact e.symm.map_eq_one_iff.mp (hfree _ ha ha1' _ hk hfix)


/-- Every order-five element of the actual M22 normalizes an order-eleven subgroup,
with its nonidentity powers acting fixed-point-freely on the nonidentity elements. -/
public theorem m22_exists_eleven_five (v : M22) (hv : orderOf v = 5) :
    ∃ K : Subgroup M22, Nat.card K = 11 ∧
      zpowers v ≤ normalizer (K : Set M22) ∧
      ∀ a ∈ zpowers v, a ≠ 1 → ∀ k ∈ K, a * k * a⁻¹ = k → k = 1 := by
  exact frob_transport frobY frobY_order (zpowers frobX)
    (by rw [Nat.card_zpowers, frobX_order]) frob_normalizes frob_free v hv

end
end Sporadic.Mathieu
