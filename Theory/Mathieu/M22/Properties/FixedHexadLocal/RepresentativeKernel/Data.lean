def hexad : Finset (Fin 22) := {5, 15, 18, 19, 20, 21}

theorem fixedPoints_eq_hexad : m22FixedPoints m22GeneratorAInM22 = hexad := by
  ext x
  rw [mem_m22FixedPoints]
  change m22GeneratorA x = x ↔ x ∈ hexad
  revert x
  decide +kernel

theorem representative_order : orderOf m22GeneratorAInM22 = 2 := by
  rw [← Subgroup.orderOf_coe]
  exact m22GeneratorA_order

theorem hexad_mem : hexad ∈ m22Blocks :=
  fixedPoints_eq_hexad ▸ m22FixedPoints_mem_blocks _ representative_order

