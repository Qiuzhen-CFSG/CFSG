/-!
# Words and tables for the standard M22 involution centralizer

All elements are words in the two certified ATLAS generators in the actual
22-point group. The tables and words below are finite witnesses; their
identities are proved by kernel reduction in `Certificates`.

The application convention is function composition: the rightmost letter
acts first. Letter 0 is the first generator, 1 is the second, and 2 is its
inverse. This supports the fixed-hexad local calculation used for
Aschbacher--Smith 2.3.9(7)(f), printed pp.525--526.
-/

@[expose] public section
namespace Sporadic.Mathieu.M22RepresentativeKernel
open Subgroup
set_option maxRecDepth 100000

noncomputable abbrev C := centralizer ({m22GeneratorAInM22} : Set M22)

noncomputable def letter : Fin 3 → M22 :=
  ![m22GeneratorAInM22, m22GeneratorBInM22, m22GeneratorBInM22⁻¹]

/-- Read a five-bit coordinate from a packed permutation table. -/
def tableApply (n : Nat) (x : Fin 22) : Fin 22 :=
  ⟨((n >>> (5 * x.val)) % 32) % 22, Nat.mod_lt _ (by decide)⟩

def letterTableCode : Fin 3 → Nat :=
  ![
    877989440828400952245927392321958,
    53920470971190699499378863425539,
    140118235930317324908718624618145]

def letterTable (i : Fin 3) : Fin 22 → Fin 22 := tableApply (letterTableCode i)

theorem letter_apply (j : Fin 3) (x : Fin 22) :
    (letter j).val x = letterTable j x := by
  revert j x
  decide +kernel

noncomputable def wordElement : List (Fin 3) → M22
  | [] => 1
  | j :: w => letter j * wordElement w

def wordAction : List (Fin 3) → Fin 22 → Fin 22
  | [] => id
  | j :: w => fun x => letterTable j (wordAction w x)

theorem wordElement_apply (w : List (Fin 3)) (x : Fin 22) :
    (wordElement w).val x = wordAction w x := by
  induction w with
  | nil => rfl
  | cons j w ih =>
    change (letter j).val ((wordElement w).val x) = _
    rw [letter_apply, ih]
    rfl

