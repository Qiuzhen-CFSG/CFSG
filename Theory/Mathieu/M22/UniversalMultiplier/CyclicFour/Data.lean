public import Mathlib.GroupTheory.Perm.List
public import Mathlib.Data.Fintype.Perm

/-!
# The ATLAS degree-4928 candidate for 4.M₂₂

These are the two literal standard-generator permutations from the ATLAS
representation `4M22G1-p4928aB0`. Each is defined as a product of cycles,
so bijectivity follows from the permutation operations themselves.
No order, perfectness, kernel or recognition assertion is assumed here.

Source: https://brauer.maths.qmul.ac.uk/Atlas/v3/permrep/4M22G1-p4928aB0
The original files, attribution and conversion script are retained in `source/`.
-/

namespace Sporadic.Mathieu.M22CyclicFour.Data

set_option maxRecDepth 10000

/-- Interpret zero-based numerical cycles as actual permutations. -/
@[expose] public def ofCycles (cs : List (List ℕ)) : Equiv.Perm (Fin 4928) :=
  (cs.map fun c => List.formPerm (c.map fun i => (⟨i % 4928, Nat.mod_lt _ (by decide)⟩ : Fin 4928))).prod

