module

public import Theory.Mathieu.M22.UniversalMultiplier.CyclicFour.Kernel
public import Theory.Mathieu.M22.UniversalMultiplier

/-!
# Assembly for the explicit cyclic-four-cover candidate

The carrier is the actual subgroup generated by paired ATLAS permutations,
with the proved surjection onto native Steiner-design M₂₂. Word certificates
for perfectness and the central element, together with an independent order
bound, construct a perfect central cover with literal cyclic-four kernel.
Quasisimplicity then follows from the native target's quasisimplicity.

The final theorem applies this very cover to the existing multiplier assembly.
The finite word and order certificates remain explicit inputs: this module
is not yet an unconditional cyclic-four-cover construction or a proof of
Aschbacher–Smith I.1.3(4), printed p.407.
-/

namespace Sporadic.Mathieu.M22CyclicFour
open Theory.GroupTheory

/-- Construct a perfect central cover from the precise remaining certificates
of the fixed finite permutation model. -/
@[expose] public noncomputable def coverOfCertificates
    (hp : Group.IsPerfect Model) (hz : orderOf centralWord = 4)
    (hc : centralWord ∈ Subgroup.center Model) (hbound : Nat.card Model ≤ 1774080) :
    PerfectCentralCovering.Cover Model M22 where
  toMonoidHom := projection
  surjective := projection_surjective
  isPerfect := hp
  ker_le_center := kernel_le_center_of_order_bound hz hbound hc

public theorem model_isQuasisimple_of_certificates
    (hp : Group.IsPerfect Model) (hz : orderOf centralWord = 4)
    (hc : centralWord ∈ Subgroup.center Model) (hbound : Nat.card Model ≤ 1774080) :
    IsQuasisimple Model := (coverOfCertificates hp hz hc hbound).isQuasisimple

/-- The kernel equivalence belongs to the same literal covering homomorphism. -/
public theorem coverOfCertificates_kernel_equiv_four
    (hp : Group.IsPerfect Model) (hz : orderOf centralWord = 4)
    (hc : centralWord ∈ Subgroup.center Model) (hbound : Nat.card Model ≤ 1774080) :
    Nonempty ((coverOfCertificates hp hz hc hbound).toMonoidHom.ker ≃*
      Multiplicative (ZMod 4)) :=
  kernel_equiv_four_of_order_bound hz hbound

/-- Actual consumer of the constructed candidate cover, preserving the parent's
independent two-primary upper bound. The word/order certificates must be proved
before this supplies an unconditional multiplier theorem. -/
public theorem universal_kernel_equiv_twelve_of_certificates
    {L : Type*} [Group L] [Finite L] [IsQuasisimple L]
    (f : Covering L M22) (hf : Covering.IsUniversal.{0, _, 0} f)
    (h8 : ¬ 8 ∣ Nat.card f.toMonoidHom.ker)
    (hp : Group.IsPerfect Model) (hz : orderOf centralWord = 4)
    (hc : centralWord ∈ Subgroup.center Model) (hbound : Nat.card Model ≤ 1774080) :
    Nonempty (f.toMonoidHom.ker ≃* Multiplicative (ZMod 12)) := by
  let g := coverOfCertificates hp hz hc hbound
  let : IsQuasisimple Model := g.isQuasisimple
  exact M22UniversalMultiplier.kernel_equiv_twelve_of_not_eight_and_cyclic_four_cover
    f hf h8 g.toCovering (coverOfCertificates_kernel_equiv_four hp hz hc hbound)

end Sporadic.Mathieu.M22CyclicFour
