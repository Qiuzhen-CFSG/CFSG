module

public import Theory.Mathieu.M24.Properties.Simplicity
public import Theory.Mathieu.WordSubgroup

/-!
# Generating the native large Mathieu groups through point stabilizers

The two relabelled M22 generators generate the full point-9 stabilizer in M23.
A 23-cycle lies outside that maximal subgroup, so these three elements generate
M23. Extending them to the point-24 stabilizer in M24 and adjoining the first
M24 standard generator similarly generates the full Witt-design automorphism
group. This connects the later word certificates to the native carriers.

Source: Guralnick--Malle, *Classification of 2F-modules I*, Proposition 5.1,
manuscript pp.16--17; the point-stabilizer identifications are in the imports.
-/

public section
open Subgroup
namespace Sporadic.Mathieu.LargeInvolutionGeneration
@[expose] noncomputable def a23 : M23 := ⟨m23M22GeneratorA, m23M22GeneratorA_mem_M23⟩
@[expose] noncomputable def b23 : M23 := ⟨m23M22GeneratorB, m23M22GeneratorB_mem_M23⟩
@[expose] noncomputable def embedding : M23 →* M24 :=
  (MulAction.stabilizer M24 (24 : Fin 24)).subtype.comp m23SimplicityExtendHom

theorem m23_eq_top_of_generators (H : Subgroup M23)
    (ha : a23 ∈ H) (hb : b23 ∈ H) (hz : m23Standard23 ∈ H) : H = ⊤ := by
  let f : M22 →* M23 := (MulAction.stabilizer M23 (9 : Fin 23)).subtype.comp
    m23EquivM22PointStabilizer.toMonoidHom
  have hfa : f m22GeneratorAInM22 = a23 := by
    apply Subtype.ext
    exact m22M23RelabelHom_generatorA
  have hfb : f m22GeneratorBInM22 = b23 := by
    apply Subtype.ext
    exact m22M23RelabelHom_generatorB
  have htop : H.comap f = ⊤ := by
    apply top_unique
    rw [← m22_generators_closure_eq_top, closure_le]
    rintro x (rfl | rfl)
    · change f m22GeneratorAInM22 ∈ H
      rw [hfa]
      exact ha
    · change f m22GeneratorBInM22 ∈ H
      rw [hfb]
      exact hb
  have hs : MulAction.stabilizer M23 (9 : Fin 23) ≤ H := by
    intro x hx
    obtain ⟨y, hy⟩ := m23EquivM22PointStabilizer.surjective ⟨x, hx⟩
    have he : f y = x := congrArg Subtype.val hy
    rw [← he]
    change y ∈ H.comap f
    rw [htop]
    trivial
  have hc := (MulAction.isCoatom_stabilizer_iff_preprimitive M23 (9 : Fin 23)).mpr
    m23_isPreprimitive
  apply hc.lt_iff.mp
  refine lt_of_le_not_ge hs ?_
  intro h
  have hfix := h hz
  change m23Standard23Cycle (9 : Fin 23) = 9 at hfix
  exact (by decide : m23Standard23Cycle (9 : Fin 23) ≠ 9) hfix

theorem m24_eq_top_of_generators (H : Subgroup M24)
    (ha : embedding a23 ∈ H) (hb : embedding b23 ∈ H)
    (hz : embedding m23Standard23 ∈ H) (hm : m24GeneratorAInM24 ∈ H) : H = ⊤ := by
  have htop : H.comap embedding = ⊤ := m23_eq_top_of_generators _ ha hb hz
  have hs : MulAction.stabilizer M24 (24 : Fin 24) ≤ H := by
    intro x hx
    obtain ⟨y, hy⟩ := m23SimplicityExtendHom_bijective.surjective ⟨x, hx⟩
    have he : embedding y = x := congrArg Subtype.val hy
    rw [← he]
    change y ∈ H.comap embedding
    rw [htop]
    trivial
  have hc := (MulAction.isCoatom_stabilizer_iff_preprimitive M24 (24 : Fin 24)).mpr
    m24_isPreprimitive
  apply hc.lt_iff.mp
  refine lt_of_le_not_ge hs ?_
  intro h
  have hfix := h hm
  change m24GeneratorA (24 : Fin 24) = 24 at hfix
  exact (by decide +kernel : m24GeneratorA (24 : Fin 24) ≠ 24) hfix

theorem conjugate_generation_of_isConj {G : Type*} [Group G] {t r : G} {n : ℕ}
    (h : IsConj t r)
    (hr : ∃ c : Fin n → G, closure (Set.range fun i => c i * r * (c i)⁻¹) = ⊤) :
    ∃ c : Fin n → G, closure (Set.range fun i => c i * t * (c i)⁻¹) = ⊤ := by
  obtain ⟨g, hg⟩ := isConj_iff.mp h
  obtain ⟨c, hc⟩ := hr
  refine ⟨fun i => c i * g, ?_⟩
  have he : (fun i => (c i * g) * t * (c i * g)⁻¹) =
      (fun i => c i * r * (c i)⁻¹) := by
    funext i
    rw [← hg]
    group
  rw [he, hc]
/-- Evaluate a word in point maps using right-to-left composition. -/
@[expose] def wordPoint {n d : ℕ} (f : Fin n → Fin d → Fin d) :
    List (Fin n) → Fin d → Fin d
  | [], x => x
  | i :: w, x => f i (wordPoint f w x)

/-- Pointwise evaluation avoids reducing subgroup membership certificates. -/
theorem evalWord_apply {n d : ℕ} {H : Subgroup (Equiv.Perm (Fin d))}
    (f : Fin n → H) (F : Fin n → Fin d → Fin d)
    (hf : ∀ i x, (f i).val x = F i x) (w : List (Fin n)) (x : Fin d) :
    (evalWord f w).val x = wordPoint F w x := by
  induction w with
  | nil => rfl
  | cons i w ih =>
    change (f i).val ((evalWord f w).val x) = _
    rw [hf, ih]
    rfl

/-- Each certified word belongs to the subgroup generated by its letters. -/
theorem evalWord_mem_closure {G : Type*} [Group G] {n : ℕ}
    (f : Fin n → G) (w : List (Fin n)) : evalWord f w ∈ closure (Set.range f) := by
  induction w with
  | nil => exact (closure _).one_mem
  | cons i w ih => exact (closure _).mul_mem (subset_closure ⟨i, rfl⟩) ih

end Sporadic.Mathieu.LargeInvolutionGeneration
