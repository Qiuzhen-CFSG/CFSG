/-!
# Short obstruction words for the proposed M₂₄ double cosets

The five letters are the four certified Sylow generators and one proposed
representative. The tabulated words have length at most nine. Their orders or
geometric alternatives are proved separately in `Obstructions`; this file
contains data and the word-membership proof only.

Source context: Aschbacher–Smith, printed p.511; GLS3 Table 5.3e.
The untrusted word search is recorded in `source/generate.py`.
-/

@[expose] public section
namespace Sporadic.Mathieu.M24LocalGeometry.PairOvergroups.Placement.TransitiveCoverage
open SylowNormalizer
set_option maxRecDepth 1000000

def generatorInverses : Array (Fin 24 → Fin 24) := #[
  ![21,6,23,11,9,18,20,12,19,3,13,4,7,10,2,1,17,16,5,0,15,8,14,22],
  ![19,1,2,11,8,15,7,6,4,21,14,3,12,13,10,5,16,23,18,0,20,9,22,17],
  ![8,1,2,19,21,5,23,7,0,11,10,9,13,12,15,14,18,17,16,3,20,4,22,6],
  ![0,1,22,3,21,15,7,6,9,8,23,11,18,13,17,5,16,14,12,19,20,4,2,10]]

/-- Fast tables for exactly the four native Sylow generators. -/
def fastGenerator (i : Fin 4) : Equiv.Perm (Fin 24) where
  toFun := generatorPoint i
  invFun := generatorInverses[i.val]!
  left_inv := (by decide +kernel : ∀ j : Fin 4, ∀ x : Fin 24,
    generatorInverses[j.val]! (generatorPoint j x) = x) i
  right_inv := (by decide +kernel : ∀ j : Fin 4, ∀ x : Fin 24,
    generatorPoint j (generatorInverses[j.val]! x) = x) i

theorem fastGenerator_eq (i : Fin 4) : fastGenerator i = generatorPerm i := by
  apply Equiv.ext
  intro x
  exact (generatorPerm_apply i x).symm

def localLetter (i : Fin 510) (j : Fin 5) : Equiv.Perm (Fin 24) :=
  ![fastGenerator 0, fastGenerator 1, fastGenerator 2, fastGenerator 3,
    representativePerm i] j

def localWord (i : Fin 510) : List (Fin 5) → Equiv.Perm (Fin 24)
  | [] => 1
  | j :: w => localLetter i j * localWord i w

/-- The word belongs to the native subgroup's permutation image whenever
its representative does. -/
theorem localWord_mem (H : Subgroup M24) (hS : candidate ≤ H)
    (i : Fin 510) (hi : representativePerm i ∈ H.map M24.subtype)
    (w : List (Fin 5)) : localWord i w ∈ H.map M24.subtype := by
  have hgen (j : Fin 4) : fastGenerator j ∈ H.map M24.subtype := by
    rw [fastGenerator_eq]
    exact Subgroup.mem_map_of_mem M24.subtype (hS (generator_mem j))
  have hletter (j : Fin 5) : localLetter i j ∈ H.map M24.subtype := by
    fin_cases j
    · exact hgen 0
    · exact hgen 1
    · exact hgen 2
    · exact hgen 3
    · exact hi
  induction w with
  | nil => exact (H.map M24.subtype).one_mem
  | cons j w ih => exact (H.map M24.subtype).mul_mem (hletter j) ih

