def rowMessage (i : Fin 510) (j : Fin 12) : Fin 4096 :=
  ⟨(OrderEnumeration.lookup 9 rowMessagesTable i.val >>> (12 * j.val)) % 4096,
    Nat.mod_lt _ (by decide)⟩

private def rowBlock (a : Fin 10) (b : Fin 51) : Fin 510 :=
  ⟨a.val * 51 + b.val, by omega⟩

private theorem rows_0 : ∀ (b : Fin 51) (j : Fin 12),
    m24PermuteMask (representativePerm (rowBlock 0 b)) (m24GolayRow j) =
      m24GolayCode (rowMessage (rowBlock 0 b) j) := by
  decide +kernel

private theorem rows_1 : ∀ (b : Fin 51) (j : Fin 12),
    m24PermuteMask (representativePerm (rowBlock 1 b)) (m24GolayRow j) =
      m24GolayCode (rowMessage (rowBlock 1 b) j) := by
  decide +kernel

