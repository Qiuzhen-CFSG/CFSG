private theorem row_checks (i : Fin 510) (j : Fin 12) :
    m24PermuteMask (representativePerm i) (m24GolayRow j) = m24GolayCode (rowMessage i j) := by
  have h (a : Fin 10) : ∀ (b : Fin 51) (k : Fin 12),
      m24PermuteMask (representativePerm (rowBlock a b)) (m24GolayRow k) =
        m24GolayCode (rowMessage (rowBlock a b) k) := by
    fin_cases a
    · exact rows_0
    · exact rows_1
    · exact rows_2
    · exact rows_3
    · exact rows_4
    · exact rows_5
    · exact rows_6
    · exact rows_7
    · exact rows_8
    · exact rows_9
  let a : Fin 10 := ⟨i.val / 51, by omega⟩
  let b : Fin 51 := ⟨i.val % 51, Nat.mod_lt _ (by decide)⟩
  have hi : rowBlock a b = i := by
    apply Fin.ext
    dsimp [rowBlock, a, b]
    omega
  rw [← hi]
  exact h a b j

/-- Every proposed representative preserves the native Golay code and Witt design. -/
theorem representativePerm_mem (i : Fin 510) : representativePerm i ∈ M24 := by
  apply QuotientConstruction.AffineLiftConstruction.mem_M24_of_rows
  intro j
  exact ⟨rowMessage i j, row_checks i j⟩

/-- Proposed double-coset representatives on the actual native carrier. -/
noncomputable def representative (i : Fin 510) : M24 :=
  ⟨representativePerm i, representativePerm_mem i⟩

