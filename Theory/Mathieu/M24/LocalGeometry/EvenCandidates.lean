theorem generatorPoint_spec : ∀ k i x,
    generatorPoint k i x = SylowNormalizer.OrderEnumeration.point (generatorIndex k i) x := by
  decide +kernel

theorem generator_apply (k : Fin 2) (i : Fin 6) (x : Fin 24) :
    (generator k i).val x = generatorPoint k i x := by
  rw [generatorPoint_spec]
  exact SylowNormalizer.OrderEnumeration.element_apply _ _

theorem generatorPoint_commute : ∀ k i j x,
    generatorPoint k i (generatorPoint k j x) =
      generatorPoint k j (generatorPoint k i x) := by decide +kernel

theorem generatorPoint_square : ∀ k i x,
    generatorPoint k i (generatorPoint k i x) = x := by decide +kernel

theorem generator_commute (k : Fin 2) (i j : Fin 6) :
    generator k i * generator k j = generator k j * generator k i := by
  apply Subtype.ext
  apply Equiv.ext
  intro x
  simp only [Subgroup.coe_mul, Equiv.Perm.mul_apply, generator_apply]
  exact generatorPoint_commute k i j x

theorem generator_square (k : Fin 2) (i : Fin 6) : (generator k i) ^ 2 = 1 := by
  apply Subtype.ext
  apply Equiv.ext
  intro x
  simp only [pow_two, Subgroup.coe_mul, Equiv.Perm.mul_apply, generator_apply,
    Subgroup.coe_one, Equiv.Perm.one_apply]
  exact generatorPoint_square k i x

instance elementary_commutative (k : Fin 2) : IsMulCommutative (elementary k) := by
  apply isMulCommutative_closure
  rintro x ⟨i, rfl⟩ y ⟨j, rfl⟩
  exact generator_commute k i j

theorem elementary_square (k : Fin 2) (g : elementary k) : g ^ 2 = 1 := by
  apply Subtype.ext
  change (g.val : M24) ^ 2 = 1
  apply closure_induction (k := Set.range (generator k))
    (p := fun x _ => x ^ 2 = 1) ?_ ?_ ?_ ?_ g.property
  · rintro x ⟨i, rfl⟩
    exact generator_square k i
  · exact one_pow 2
  · intro x y hx hy hx2 hy2
    have hc : Commute x y := by
      exact congrArg Subtype.val (mul_comm (⟨x, hx⟩ : elementary k) ⟨y, hy⟩)
    rw [hc.mul_pow, hx2, hy2, one_mul]
  · intro x hx hx2
    rw [inv_pow, hx2, inv_one]

instance elementary_isElementaryAbelian (k : Fin 2) : IsElementaryAbelian 2 (elementary k) :=
  { is_comm := (inferInstance : IsMulCommutative (elementary k)).is_comm
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (elementary_square k) }

theorem elementary_ne_bot (k : Fin 2) : elementary k ≠ ⊥ := by
  intro he
  have hg : generator k 0 = 1 := Subgroup.mem_bot.mp (he ▸ generator_mem k 0)
  have hp := congrArg (fun g : M24 => g.val 0) hg
  rw [generator_apply] at hp
  have hn : ∀ k : Fin 2, generatorPoint k 0 0 ≠ 0 := by decide +kernel
  exact hn k hp

def evaluatePoint (k : Fin 2) : List (Fin 6) → Fin 24 → Fin 24
  | [], x => x
  | i :: w, x => generatorPoint k i (evaluatePoint k w x)

