def witnessWord (k : Fin 2) (x y : Fin 24) : List (Fin 6) :=
  (List.finRange 6).filter (fun i => (witnessMask k x y).val.testBit i.val)

theorem witness_transport_or_separate : ∀ k x y,
    evaluatePoint k (witnessWord k x y) x = y ∨
      (evaluatePoint k (witnessWord k x y) x = x ∧
        evaluatePoint k (witnessWord k x y) y ≠ y) := by decide +kernel

theorem witness_square : ∀ k x y,
    evaluatePoint k (witnessWord k x y) (evaluatePoint k (witnessWord k x y) x) = x := by
  decide +kernel

private theorem commute_evaluatePoint (k : Fin 2) (g : Equiv.Perm (Fin 24))
    (h : ∀ i x, g (generatorPoint k i x) = generatorPoint k i (g x))
    (w : List (Fin 6)) (x : Fin 24) :
    g (evaluatePoint k w x) = evaluatePoint k w (g x) := by
  induction w with
  | nil => rfl
  | cons i w ih => rw [evaluatePoint, h, ih, evaluatePoint]

/-- The full permutation centralizer has exponent two. -/
theorem square_eq_one_of_commute (k : Fin 2) (g : Equiv.Perm (Fin 24))
    (h : ∀ i x, g (generatorPoint k i x) = generatorPoint k i (g x)) : g ^ 2 = 1 := by
  apply Equiv.ext
  intro x
  change g (g x) = x
  have he := commute_evaluatePoint k g h (witnessWord k x (g x)) x
  rcases witness_transport_or_separate k x (g x) with ht | hs
  · rw [ht] at he
    calc
      g (g x) = evaluatePoint k (witnessWord k x (g x)) (g x) := he
      _ = evaluatePoint k (witnessWord k x (g x))
          (evaluatePoint k (witnessWord k x (g x)) x) :=
        congrArg (evaluatePoint k (witnessWord k x (g x))) ht.symm
      _ = x := witness_square k x (g x)
  · exact (hs.2 (by simpa only [hs.1] using he.symm)).elim

/-- The centralizer in the native M₂₄ is a two-group. -/
theorem centralizer_isPGroup (k : Fin 2) :
    IsPGroup 2 (centralizer (elementary k : Set M24)) := by
  intro g
  refine ⟨1, ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  change (g.val.val : Equiv.Perm (Fin 24)) ^ 2 = 1
  apply square_eq_one_of_commute k
  intro i x
  have hc := g.property (generator k i) (generator_mem k i)
  have hp := congrArg (fun a : M24 => a.val x) hc
  simpa only [Subgroup.coe_mul, Equiv.Perm.mul_apply, generator_apply] using hp.symm

/-- Each candidate normalizer has a self-centralizing intrinsic two-core. -/
theorem localGroup_core_selfCentralizing (k : Fin 2) :
    centralizer (pCore 2 (localGroup k) : Set (localGroup k)) ≤ pCore 2 (localGroup k) := by
  obtain ⟨Q, hn, hp, hc⟩ :=
    Theory.GroupTheory.exists_normal_selfCentralizing_pSubgroup_of_abelian_centralizer
      (elementary k) (centralizer_isPGroup k)
  have hQ : Q ≤ pCore 2 (localGroup k) := le_sSup ⟨hn, hp⟩
  exact (centralizer_le hQ).trans (hc.trans hQ)

