/-!
# Two explicit elementary candidates for M₂₄ condition E

The subgroups are generated by six entries of the certified Sylow enumeration.
Commuting involution checks show they are elementary abelian. A permutation
centralizing either subgroup must preserve each of its point orbits: a short
word separates distinct orbits by fixing one point and moving the other.
Within an orbit, an involutory word transports any point to its image under
the centralizing permutation. Commutation then makes the permutation square
to the identity. Thus even their centralizers in the full symmetric group
have exponent two, and their native M₂₄ normalizers have characteristic two.

The two candidates are intended for the trio and sextet cases of GLS3,
Table 5.3e. Their geometric identification and exhaustive local coverage are
not asserted here. Source: Aschbacher–Smith, condition E, printed pp.3–4.
All finite checks use the Lean kernel; the generator script is untrusted.
-/

@[expose] public section
namespace Sporadic.Mathieu.M24LocalGeometry.EvenCandidates
open Subgroup
open scoped IsMulCommutative

/-- Positions in the existing, certified order-1024 enumeration. -/
def generatorIndex : Fin 2 → Fin 6 → Fin 1024
  | 0 => ![642,106,129,624,481,758]
  | 1 => ![642,512,744,502,2,112]

noncomputable def generator (k : Fin 2) (i : Fin 6) : M24 :=
  (SylowNormalizer.OrderEnumeration.element (generatorIndex k i)).val

/-- The two subgroups of the actual Witt-design automorphism carrier. -/
noncomputable def elementary (k : Fin 2) : Subgroup M24 :=
  closure (Set.range (generator k))

noncomputable def localGroup (k : Fin 2) : Subgroup M24 :=
  normalizer (elementary k : Set M24)

theorem generator_mem (k : Fin 2) (i : Fin 6) : generator k i ∈ elementary k :=
  subset_closure ⟨i, rfl⟩

theorem elementary_le_candidate (k : Fin 2) : elementary k ≤ SylowNormalizer.candidate := by
  apply (closure_le (K := SylowNormalizer.candidate)).mpr
  rintro g ⟨i, rfl⟩
  exact (SylowNormalizer.OrderEnumeration.element (generatorIndex k i)).property

