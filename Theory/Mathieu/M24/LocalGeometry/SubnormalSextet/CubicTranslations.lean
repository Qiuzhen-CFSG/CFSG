module

public import Theory.AtlasPort.OtherSporadic.Mathieu.Mathieu24Nonabelian
public import Theory.GroupTheory.Commutator.SubnormalAbsorption
public import Mathlib.GroupTheory.FixedPointFree

/-!
# A cubic affine image forces all sextet translations

The order-three hexacode scalar fixes no nonzero translation. Its commutator
map is therefore surjective on the finite translation group. Conjugation by
any affine lift of that scalar has exactly the same action, so translations
are generated by their commutators with the subgroup containing the lift.
Subnormal commutator absorption puts all 64 translations in that subgroup.
In particular its order is greater than twelve.

The consumer is the cubic branch of `SubnormalSextet.atlas_orders`.
Source: the local-group argument for Aschbacher–Smith 2.3.9(7), printed p.526,
and GLS3 Table 5.3e. The actual affine model and fixed-point-free scalar are
from Gerald Höhn and ATLAS contributors, revision
`8eabb35afe2b5e45bf913a2d05c53e558d2e2917`, under the ATLAS Research and
Attribution License 1.0; see `LICENSES/ATLAS.txt`.
-/

public section

open Subgroup
open scoped commutatorElement
namespace Sporadic.Mathieu.M24LocalGeometry.SubnormalSextet
open Atlas.Codes

/-- An arbitrary affine lift has the indicated action on translations. -/
theorem translation_conjugation (a : SextetStabilizer) (t : Multiplicative hexacode) :
    a * sextetTranslation t * a⁻¹ =
      sextetTranslation (hexAffineAction (sextetQuotient a) t) := by
  apply (mul_inv_eq_iff_eq_mul).mpr
  apply sextetAffineEquiv.symm.injective
  rw [map_mul, map_mul]
  have ht (u : Multiplicative hexacode) :
      sextetAffineEquiv.symm (sextetTranslation u) = SemidirectProduct.inl u :=
    sextetAffineEquiv.symm_apply_apply _
  rw [ht, ht]
  change sextetAffineEquiv.symm a * SemidirectProduct.inl t =
    SemidirectProduct.inl (hexAffineAction (sextetAffineEquiv.symm a).right t) *
      sextetAffineEquiv.symm a
  apply SemidirectProduct.ext
  · simp only [SemidirectProduct.mul_left, SemidirectProduct.left_inl,
      SemidirectProduct.right_inl, map_one, MulAut.one_apply]
    exact mul_comm _ _
  · simp only [SemidirectProduct.mul_right, SemidirectProduct.right_inl, mul_one, one_mul]

private theorem scalar_fixedPointFree : MonoidHom.FixedPointFree (hexAffineAction hexZ) := by
  intro t ht
  by_contra hn
  apply hexZ_moves_nonzero t.toAdd hn
  exact congrArg Multiplicative.toAdd ht

/-- A subnormal subgroup whose affine image contains the cubic scalar contains
all 64 translations. No normality of the subgroup in the stabilizer is assumed. -/
theorem translations_le_of_scalar_mem (E : Subgroup SextetStabilizer)
    (hE : E.IsSubnormal) (hz : hexZ ∈ E.map sextetQuotient) :
    sextetQuotient.ker ≤ E := by
  obtain ⟨a, ha, hqa⟩ := hz
  apply le_of_isSubnormal_of_le_commutator sextetQuotient.ker E hE
  intro x hx
  rw [sextetQuotient_kernel] at hx
  obtain ⟨t, rfl⟩ := hx
  obtain ⟨u, hu⟩ := scalar_fixedPointFree.commutatorMap_surjective t
  have hc : sextetTranslation (MonoidHom.commutatorMap (hexAffineAction hexZ) u) =
      ⁅sextetTranslation u, a⁆ := by
    rw [MonoidHom.commutatorMap_apply, map_div, ← hqa, ← translation_conjugation]
    simp only [div_eq_mul_inv, mul_inv_rev, inv_inv, commutatorElement_def]
    group
  rw [← hu, hc]
  exact commutator_mem_commutator (sextetQuotient_translation u) ha

/-- The cubic image cannot be carried by a group of order at most twelve. -/
theorem twelve_lt_card_of_scalar_mem (E : Subgroup SextetStabilizer)
    (hE : E.IsSubnormal) (hz : hexZ ∈ E.map sextetQuotient) : 12 < Nat.card E := by
  have hc := Nat.card_le_card_of_injective
    (Subgroup.inclusion (translations_le_of_scalar_mem E hE hz))
    (Subgroup.inclusion_injective _)
  rw [sextetQuotient_kernel_card] at hc
  omega

end Sporadic.Mathieu.M24LocalGeometry.SubnormalSextet
