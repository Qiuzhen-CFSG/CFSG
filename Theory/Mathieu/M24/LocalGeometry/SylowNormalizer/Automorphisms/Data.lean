/-!
# Finite coordinates for the marked M₂₄ two-subgroup

Six squares give 64 Frattini representatives; four generator bits give the
16 outer representatives. The tables record their action on the 24 Witt
points, multiplication by the six squares, squares of all 1024 words, and
products of the outer representatives. Each table is checked against word
evaluation in the accompanying theorems. No external computation is trusted.

Source context: Aschbacher–Smith, printed p.511; GLS3, Table 5.3e.
The reproducible enumeration is in `source/generate.py` beside this module.
-/

@[expose] public section
namespace Sporadic.Mathieu.M24LocalGeometry.SylowNormalizer.AutomorphismData
open Theory.GroupTheory

/-- Increasing list of the set bits, with bit zero first. -/
def bitWord (n m : ℕ) : List (Fin n) :=
  (List.finRange n).filter (fun i => m.testBit i.val)

def rootWord : Fin 6 → List (Fin 4) := ![[0], [1,0], [0,1], [2,1], [2,0], [3,1,0]]

def phiWord (i : Fin 64) : List (Fin 4) :=
  (bitWord 6 i.val).flatMap (fun j => rootWord j ++ rootWord j)

def outerWord (i : Fin 16) : List (Fin 4) := bitWord 4 i.val

def point (code : ℕ) (x : Fin 24) : Fin 24 :=
