module
public import Theory.Mathieu.M24.LocalGeometry.SylowNormalizer.Automorphisms.Data
public import Theory.Frattini.BinarySquares

/-!
# The actual Frattini coordinates

The finite point certificates identify a subgroup generated by six squares.
Every group element is one of the 1024 certified words, using the assumed
cardinality. The square table then proves that this subgroup is precisely the
Frattini subgroup. All coordinates are on the original Witt-design carrier.

Source context: Aschbacher–Smith, printed p.511; GLS3, Table 5.3e.
-/

@[expose] public section
namespace Sporadic.Mathieu.M24LocalGeometry.SylowNormalizer.AutomorphismData
open Theory.GroupTheory

noncomputable def phiGen (i : Fin 6) : candidate :=
  evalWord markedGenerator (rootWord i) ^ 2
noncomputable def phi (i : Fin 64) : candidate :=
  evalWord phiGen (bitWord 6 i.val)
noncomputable def outer (i : Fin 16) : candidate :=
  evalWord markedGenerator (outerWord i)
noncomputable def full (i : Fin 16 × Fin 64) : candidate := outer i.1 * phi i.2
noncomputable def phiSubgroup : Subgroup candidate := Subgroup.closure (Set.range phiGen)

theorem candidate_ext {g h : candidate}
    (he : ∀ x : Fin 24, g.val.val x = h.val.val x) : g = h :=
  Subtype.ext (Subtype.ext (Equiv.ext he))

theorem word_apply (w : List (Fin 4)) (x : Fin 24) :
    (evalWord markedGenerator w).val.val x = evaluatePoint w x := by
  induction w with
  | nil => rfl
  | cons i w ih =>
    change generatorPerm i ((evalWord markedGenerator w).val.val x) = _
    rw [generatorPerm_apply, ih]
    rfl

theorem phi_word (i : Fin 64) : phi i = evalWord markedGenerator (phiWord i) := by
  unfold phi phiWord
  generalize bitWord 6 i.val = w
  induction w with
  | nil => rfl
  | cons j w ih =>
    simp only [List.flatMap_cons, evalWord, evalWord_append, ← ih, phiGen, pow_two]

theorem phi_apply (i : Fin 64) (x : Fin 24) : (phi i).val.val x = phiPoint i x := by
  rw [phi_word, word_apply, phiPoint_eq]
theorem outer_apply (i : Fin 16) (x : Fin 24) : (outer i).val.val x = outerPoint i x := by
  exact (word_apply _ x).trans (outerPoint_eq i x)
theorem full_apply (i : Fin 16 × Fin 64) (x : Fin 24) :
    (full i).val.val x = fullPoint i.1 i.2 x := by
  change (outer i.1).val.val ((phi i.2).val.val x) = _
  rw [outer_apply, phi_apply]
  rfl

theorem phi_zero : phi 0 = 1 := by
  apply candidate_ext
  intro x
  rw [phi_apply]
  exact (by decide +kernel : ∀ x, phiPoint 0 x = x) x
theorem outer_zero : outer 0 = 1 := by
  apply candidate_ext
  intro x
  rw [outer_apply]
  exact (by decide +kernel : ∀ x, outerPoint 0 x = x) x

theorem full_injective : Function.Injective full := by
  intro i j hij
  have h := congrArg (fun g : candidate => decode (fun x => g.val.val x)) hij
  simp only [full_apply] at h
  simpa only [decode_fullPoint] using h

theorem full_bijective (hcard : Nat.card candidate = 1024) : Function.Bijective full := by
  apply (Nat.bijective_iff_injective_and_card full).mpr
  exact ⟨full_injective, by simp [hcard]⟩

theorem phi_injective : Function.Injective phi := by
  intro i j hij
  have h : full (0,i) = full (0,j) := by
    simpa only [full] using congrArg (outer 0 * ·) hij
  exact congrArg Prod.snd (full_injective h)

theorem phi_eq_one (i : Fin 64) : phi i = 1 ↔ i = 0 := by
  rw [← phi_zero]
  exact phi_injective.eq_iff

theorem phiGen_apply (i : Fin 6) (x : Fin 24) :
    (phiGen i).val.val x = evaluatePoint (rootWord i ++ rootWord i) x := by
  rw [← word_apply, evalWord_append]
  rfl

theorem phi_step (i : Fin 6) (j : Fin 64) : phiGen i * phi j = phi (step i j) := by
  apply candidate_ext
  intro x
  change (phiGen i).val.val ((phi j).val.val x) = _
  rw [phiGen_apply, phi_apply, phi_apply]
  exact step_check i j x

theorem phi_invStep (i : Fin 6) (j : Fin 64) :
    phiGen i * phi (invStep i j) = phi j := by
  apply candidate_ext
  intro x
  change (phiGen i).val.val ((phi (invStep i j)).val.val x) = _
  rw [phiGen_apply, phi_apply, phi_apply]
  exact invStep_check i j x

theorem phi_mem (i : Fin 64) : phi i ∈ phiSubgroup := by
  unfold phi
  generalize bitWord 6 i.val = w
  induction w with
  | nil => exact phiSubgroup.one_mem
  | cons j w ih => exact phiSubgroup.mul_mem (Subgroup.subset_closure ⟨j,rfl⟩) ih

theorem mem_phiSubgroup (g : candidate) : g ∈ phiSubgroup ↔ ∃ i, phi i = g := by
  constructor
  · intro hg
    apply Subgroup.closure_induction_left (p := fun g _ => ∃ i, phi i = g) ?_ ?_ ?_ hg
    · exact ⟨0, phi_zero⟩
    · rintro _ ⟨i,rfl⟩ _ _ ⟨j,rfl⟩
      exact ⟨step i j, (phi_step i j).symm⟩
    · rintro _ ⟨i,rfl⟩ _ _ ⟨j,rfl⟩
      refine ⟨invStep i j, ?_⟩
      apply (eq_inv_mul_iff_mul_eq).mpr
      exact phi_invStep i j
  · rintro ⟨i,rfl⟩
    exact phi_mem i

theorem full_square (i : Fin 16) (j : Fin 64) :
    full (i,j) ^ 2 = phi (squareIndex i j) := by
  apply candidate_ext
  intro x
  change (full (i,j)).val.val ((full (i,j)).val.val x) = _
  rw [full_apply, full_apply, phi_apply]
  exact square_check i j x

theorem phiSubgroup_eq_frattini (hcard : Nat.card candidate = 1024) :
    phiSubgroup = frattini candidate := by
  have hG : IsPGroup 2 candidate := IsPGroup.of_card (n := 10) hcard
  let : Fact (IsPGroup 2 candidate) := ⟨hG⟩
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i,rfl⟩
    exact pth_power_mem_frattini_of_isPGroup (p := 2) _
  · rw [hG.frattini_eq_closure_squares]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨g,rfl⟩
    obtain ⟨⟨i,j⟩,rfl⟩ := (full_bijective hcard).surjective g
    change full (i,j) ^ 2 ∈ phiSubgroup
    rw [full_square]
    exact phi_mem _

theorem outer_mul (i j : Fin 16) :
    outer i * outer j = outer (xor i j) * phi (factor i j) := by
  apply candidate_ext
  intro x
  change (outer i).val.val ((outer j).val.val x) =
    (outer (xor i j)).val.val ((phi (factor i j)).val.val x)
  rw [outer_apply, outer_apply, outer_apply, phi_apply]
  exact factor_check i j x

end Sporadic.Mathieu.M24LocalGeometry.SylowNormalizer.AutomorphismData
