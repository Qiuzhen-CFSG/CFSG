def step (a : Fin 4) (i : Fin 1024) : Fin 1024 := lookup 10 (transitionTable a) i.val

/-- Every table transition agrees on all 24 points with left multiplication. -/
theorem point_step : ∀ a i x, point (step a i) x = generatorPoint a (point i x) := by
  decide +kernel

/-- The position of the empty word in the sorted enumeration. -/
def identityIndex : Fin 1024 := 0

theorem words_identityIndex : words identityIndex = [] := by decide +kernel

