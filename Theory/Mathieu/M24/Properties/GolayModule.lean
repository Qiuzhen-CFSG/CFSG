module

public import Theory.Mathieu.M24.Block

namespace Sporadic.Mathieu

set_option maxRecDepth 100000
set_option maxHeartbeats 800000

/-!
# The binary Golay module and the action of `M24`

The certified extended binary Golay code is the set `m24GolayCode u` (u : Fin 4096).
The two standard generators act on the 24 coordinates by permuting them; we verify
that each generator maps the twelve basis rows of the code into the code, and that
the permutation action is linear over the bitwise xor (so the whole code is a
module for the subgroup generated by the standard generators).
-/

/-- The permutation action commutes with the bitwise xor of codewords. -/
public theorem m24PermuteMask_xor (g : Equiv.Perm (Fin 24)) (x y : BitVec 24) :
    m24PermuteMask g (x ^^^ y) = m24PermuteMask g x ^^^ m24PermuteMask g y := by
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  unfold m24PermuteMask
  simp [hi]

/-- The permutation action is linear over the zero word. -/
public theorem m24PermuteMask_zero (g : Equiv.Perm (Fin 24)) :
    m24PermuteMask g 0 = 0 := by
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  unfold m24PermuteMask
  simp [hi]

/-- The message sent to row `i` by the first generator. -/
@[expose] public def m24GeneratorA_row_message : Fin 12 → Fin 4096
  | 0 => 265
  | 1 => 280
  | 2 => 1160
  | 3 => 1033
  | 4 => 266
  | 5 => 3080
  | 6 => 1537
  | 7 => 261
  | 8 => 1281
  | 9 => 1089
  | 10 => 1288
  | 11 => 289

/-- The message sent to row `i` by the second generator. -/
@[expose] public def m24GeneratorB_row_message : Fin 12 → Fin 4096
  | 0 => 12
  | 1 => 57
  | 2 => 36
  | 3 => 2593
  | 4 => 2157
  | 5 => 2053
  | 6 => 3
  | 7 => 2216
  | 8 => 301
  | 9 => 2084
  | 10 => 3080
  | 11 => 2061

/-- The first generator maps the twelve basis rows of the Golay code into the code. -/
public theorem m24GeneratorA_row_images (i : Fin 12) :
    m24PermuteMask m24GeneratorA (m24GolayRow i) =
      m24GolayCode (m24GeneratorA_row_message i) := by
  fin_cases i <;> decide +kernel

/-- The second generator maps the twelve basis rows of the Golay code into the code. -/
public theorem m24GeneratorB_row_images (i : Fin 12) :
    m24PermuteMask m24GeneratorB (m24GolayRow i) =
      m24GolayCode (m24GeneratorB_row_message i) := by
  fin_cases i <;> decide +kernel

/-- The zero message encodes the zero codeword. -/
public theorem m24GolayCode_zero : m24GolayCode 0 = 0 := by
  simp [m24GolayCode, m24GolaySelect]

/-- Selecting a row-image by a message bit is the code of the selected message. -/
public theorem m24GolaySelect_code (b : Bool) (v : Fin 4096) :
    m24GolaySelect b (m24GolayCode v) = m24GolayCode (if b then v else 0) := by
  cases b <;> simp [m24GolaySelect, m24GolayCode_zero]

end Sporadic.Mathieu
