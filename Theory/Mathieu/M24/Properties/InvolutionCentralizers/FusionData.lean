module

public import Theory.Mathieu.M24.Properties.InvolutionCentralizers.Defs
public import Theory.Mathieu.M24.LocalGeometry.SylowNormalizer.Order.Enumeration

/-!
# Kernel-checked fusion witnesses in the marked M₂₄ Sylow subgroup

The existing 1024-element enumeration is reused without alteration. For each
nonidentity element whose square is one, a word in the two standard M₂₄
generators conjugates one of the marked involutions to that element. For every
other nonidentity entry, a point witnesses that its square is not one.
The generator `source/generate_fusion.py` is untrusted; all point identities are
checked by the kernel. No table of centralizer orders is assumed.

Source context: Aschbacher–Smith 16.1.5(7), printed p.1171; GLS3, Table 5.3e.
-/

@[expose] public section
namespace Sporadic.Mathieu.M24InvolutionCentralizers.FusionData
open M24LocalGeometry.SylowNormalizer.OrderEnumeration
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

def letterPerm : Fin 3 → Equiv.Perm (Fin 24)
  | 0 => m24GeneratorA
  | 1 => m24GeneratorB
  | _ => m24GeneratorB⁻¹

def letterPoint : Fin 3 → Fin 24 → Fin 24
  | 0 => ![20,4,7,17,1,13,9,2,15,6,19,18,21,5,16,8,14,3,11,10,0,12,23,22]
  | 1 => ![23,4,21,9,6,18,1,7,8,15,5,11,12,17,2,3,13,16,10,0,20,14,22,19]
  | _ => ![19,6,14,15,1,10,4,7,8,3,18,11,12,16,21,9,17,13,5,23,20,2,22,0]

theorem letterPoint_spec : ∀ i x, letterPerm i x = letterPoint i x := by
  decide +kernel

def wordPoint : List (Fin 3) → Fin 24 → Fin 24
  | [], x => x
  | i :: w, x => letterPoint i (wordPoint w x)

def basePerm (a : Bool) : Equiv.Perm (Fin 24) :=
  if a then m24Involution2A else m24Involution2B

def basePoint (a : Bool) : Fin 24 → Fin 24 :=
  if a then ![0,1,2,3,4,5,7,6,23,12,18,11,9,22,20,19,21,17,10,15,14,16,13,8] else ![20,4,7,17,1,13,9,2,15,6,19,18,21,5,16,8,14,3,11,10,0,12,23,22]

theorem basePoint_spec : ∀ a x, basePerm a x = basePoint a x := by
  decide +kernel

