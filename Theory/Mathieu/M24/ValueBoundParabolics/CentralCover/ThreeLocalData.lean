module

public import Theory.GroupTheory.PerfectCentralCover

/-!
# A local configuration for excluding a central three-kernel

The data consist of a Sylow three-subgroup generated by two elements of order
three, with a nonidentity commutator commuting with both generators, and an
ambient involution inverting both generators. They refer to actual elements
and an actual Sylow subgroup of the given group.

In a perfect central cover, Sylow transfer puts the three-part of the kernel
in the derived subgroup of a Sylow subgroup upstairs. The inverting involution
can then control the weight-three commutators of lifted generators. This
interface records only the local configuration; it assumes no conclusion
about central extensions or Schur multipliers.

Source application: Aschbacher--Smith, *The Classification of Quasithin
Groups*, E.4.3(2), printed pp.241--242, and I.1.1--I.1.4, printed pp.407--408.
-/

public section

namespace PerfectCentralCovering

open scoped commutatorElement

/-- A two-generator, class-two Sylow three-subgroup and a simultaneous
inverting involution in the ambient group. -/
structure InvertedHeisenbergSylowThree (G : Type*) [Group G] where
  sylow : Sylow 3 G
  a : G
  b : G
  inverter : G
  generate : Subgroup.closure ({a, b} : Set G) = (sylow : Subgroup G)
  a_cube : a ^ 3 = 1
  b_cube : b ^ 3 = 1
  commutator_a : Commute ⁅a, b⁆ a
  commutator_b : Commute ⁅a, b⁆ b
  commutator_ne_one : ⁅a, b⁆ ≠ 1
  inverter_sq : inverter ^ 2 = 1
  conjugate_a : inverter * a * inverter⁻¹ = a⁻¹
  conjugate_b : inverter * b * inverter⁻¹ = b⁻¹

end PerfectCentralCovering

end
