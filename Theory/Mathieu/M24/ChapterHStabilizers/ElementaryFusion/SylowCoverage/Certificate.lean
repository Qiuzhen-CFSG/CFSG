theorem clique_coverage (s : Finset (Fin 192)) (hcard : 32 ≤ s.card)
    (hc : ∀ v ∈ s, ∀ w ∈ s, compatible v w = true) :
    ∃ k : Fin 6, ∀ v ∈ s, (largeMask k).testBit v.val = true :=
  check_sound certificate (List.finRange 192) certificate_checked s
    (fun v _ => List.mem_finRange v) hcard hc

