module

public import Theory.GroupTheory.PResidual.AbelianSquareObstruction
public import Theory.Mathieu.M12.ValueBoundParabolics.SecondQuotient

/-!
# The square obstruction in the second M₁₂ parabolic

Two explicit elements in the marked Sylow subgroup commute and square to
z and v. They generate an abelian two-subgroup R. A small kernel-checked
certificate places each of their conjugates by the five existing local
generators in R; induction on the established word catalogue proves that
R is normal in the whole second parabolic.

Its squares contain the natural four. The literal action on that four
therefore puts the centralizer of R² in the two-core. This constructs
`AbelianSquareControl` for the actual parabolic and supplies the obstruction
to short subnormal groups after central-cover and component-orbit transport.
No quotient or action is replaced by an order label.

Source: Aschbacher–Smith, 2.3.9(7), printed p.526; GLS3, Table 5.3b,
the (4 × 4).D₁₂ entry. The permutations, membership words and complete local
word catalogue are reused from `SmallParabolicPair`, with their original
source attribution. The earlier marked quaternion-core construction is
unchanged.
-/

public section

open Subgroup Theory.GroupTheory
namespace Sporadic.Mathieu.M12SmallPair.SecondSquareControl
open SylowEnumeration ValueBoundParabolics
noncomputable section

/-- A square root of the distinguished involution in the common Sylow subgroup. -/
@[expose] def rootOne : M12 := (movingActor * leftI * movingActor) ^ 2
/-- A commuting square root of the second generator of the natural four. -/
@[expose] def rootTwo : M12 := leftI * (movingActor * leftI * movingActor)
/-- The actual abelian subgroup generated by the two marked square roots. -/
@[expose] def radical : Subgroup M12 := closure ({rootOne, rootTwo} : Set M12)

theorem rootOne_square : rootOne ^ 2 = z := by decide +kernel
theorem rootTwo_square : rootTwo ^ 2 = v := by decide +kernel

private theorem root_mem_sylow : rootOne ∈ sylowCandidate ∧ rootTwo ∈ sylowCandidate := by
  constructor <;> constructor
  · exact (mem_firstParabolic_iff _).mpr (by decide +kernel)
  · exact (mem_secondParabolic_iff _).mpr (by decide +kernel)
  · exact (mem_firstParabolic_iff _).mpr (by decide +kernel)
  · exact (mem_secondParabolic_iff _).mpr (by decide +kernel)

/-- In particular this radical is a two-group. -/
theorem radical_le_sylow : radical ≤ sylowCandidate := by
  apply (closure_le _).mpr
  rintro x (rfl | rfl)
  · exact root_mem_sylow.1
  · exact root_mem_sylow.2

instance radical_abelian : IsMulCommutative radical := by
  apply isMulCommutative_closure
  rintro x (rfl | rfl) y (rfl | rfl) <;> decide +kernel

private theorem coordinate_mem (i j : Fin 4) : rootOne ^ i.val * rootTwo ^ j.val ∈ radical :=
  radical.mul_mem (radical.pow_mem (subset_closure (by simp)) _)
    (radical.pow_mem (subset_closure (by simp)) _)

private theorem generator_conjugates_roots : ∀ i : Fin 5,
    (∃ a b : Fin 4, rootOne ^ a.val * rootTwo ^ b.val =
      localGenerator i * rootOne * (localGenerator i)⁻¹) ∧
    (∃ a b : Fin 4, rootOne ^ a.val * rootTwo ^ b.val =
      localGenerator i * rootTwo * (localGenerator i)⁻¹) := by
  decide +kernel

private theorem generator_stable (i : Fin 5) : radical ≤ radical.comap
    (MulAut.conj (localGenerator i)).toMonoidHom := by
  apply (closure_le _).mpr
  rintro x (rfl | rfl)
  · obtain ⟨a,b,he⟩ := (generator_conjugates_roots i).1
    change _ * _ * _ ∈ radical
    rw [← he]
    exact coordinate_mem a b
  · obtain ⟨a,b,he⟩ := (generator_conjugates_roots i).2
    change _ * _ * _ ∈ radical
    rw [← he]
    exact coordinate_mem a b

private theorem word_stable (w : List (Fin 5)) (x : M12) (hx : x ∈ radical) :
    localWord w * x * (localWord w)⁻¹ ∈ radical := by
  induction w with
  | nil => simpa only [localWord, inv_one, one_mul, mul_one] using hx
  | cons i w ih =>
    have he := generator_stable i ih
    change localGenerator i * (localWord w * x * (localWord w)⁻¹) *
      (localGenerator i)⁻¹ ∈ radical at he
    simpa only [localWord, mul_inv_rev, mul_assoc] using he

private theorem word_of_second (g : M12) (hg : g ∈ secondParabolic) :
    ∃ i : Fin 192, wordElement i = g := by
  have h := (mem_wordCarrier_iff g.val).mpr
    ⟨(mem_M12_iff_preservesBlocks _).mp g.property, (mem_secondParabolic_iff g).mp hg⟩
  obtain ⟨i,_,hi⟩ := Finset.mem_image.mp h
  exact ⟨i,Subtype.ext hi⟩

/-- Normality is relative to the second parabolic. -/
instance radical_normal : (radical.subgroupOf secondParabolic).Normal where
  conj_mem := by
    intro x hx g
    obtain ⟨i, hi⟩ := word_of_second g g.property
    change (g : M12) * (x : M12) * (g : M12)⁻¹ ∈ radical
    rw [← hi]
    exact word_stable _ _ hx

/-- The square subgroup detects the full natural-four action. -/
theorem natural_le_squares : natural ≤ radical.squareClosure := by
  apply (closure_le _).mpr
  rintro x (rfl | rfl)
  · rw [← rootOne_square]
    exact square_mem_squareClosure (subset_closure (by simp))
  · rw [← rootTwo_square]
    exact square_mem_squareClosure (subset_closure (by simp))

private theorem intrinsic_centralizer_le_core :
    centralizer ((radical.subgroupOf secondParabolic).squareClosure : Set secondParabolic) ≤
      pCore 2 secondParabolic := by
  intro g hg
  have hz : z * (g : M12) = (g : M12) * z := by
    have hm : (⟨rootOne, root_mem_sylow.1.2⟩ : secondParabolic) ^ 2 ∈
        (radical.subgroupOf secondParabolic).squareClosure := by
      exact square_mem_squareClosure (show rootOne ∈ radical from subset_closure (by simp))
    have he := hg _ hm
    simpa only [Subgroup.coe_mul, Subgroup.coe_pow, rootOne_square] using congrArg Subtype.val he
  have hv : v * (g : M12) = (g : M12) * v := by
    have hm : (⟨rootTwo, root_mem_sylow.2.2⟩ : secondParabolic) ^ 2 ∈
        (radical.subgroupOf secondParabolic).squareClosure := by
      exact square_mem_squareClosure (show rootTwo ∈ radical from subset_closure (by simp))
    have he := hg _ hm
    simpa only [Subgroup.coe_mul, Subgroup.coe_pow, rootTwo_square] using congrArg Subtype.val he
  have hC : (g : M12) ∈ centralizer (natural : Set M12) := by
    rw [natural, centralizer_closure]
    rintro _ (rfl | rfl)
    · exact hz
    · exact hv
  rw [second_pCore_eq_kernel, MonoidHom.mem_ker]
  apply secondQuotientMap_eq
  intro i
  have he := hC (naturalLabel i) ((mem_natural_iff_label _).mpr (Or.inr ⟨i,rfl⟩))
  change (g : M12) * naturalLabel i * (g : M12)⁻¹ = naturalLabel i
  rw [← he, mul_inv_cancel_right]

/-- The concrete normal radical and its square-centralizer obstruction. -/
def control : AbelianSquareControl secondParabolic where
  radical := radical.subgroupOf secondParabolic
  normal := radical_normal
  abelian := inferInstance
  two_group := (commonSylow.isPGroup'.to_le radical_le_sylow).comap_subtype
  centralizer_two_group := pCore_isPGroup.to_le intrinsic_centralizer_le_core
end
end Sporadic.Mathieu.M12SmallPair.SecondSquareControl

end
