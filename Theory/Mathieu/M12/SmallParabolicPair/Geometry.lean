module

public import Theory.Mathieu.M12.SmallParabolicPair.Core
public import Theory.GroupAction.ResidualMovingPointTransport

/-!
# Marked elementary geometry and residual actors for M₁₂

Binary coordinates certify the elementary eight inside the quaternion core.
An explicit cubic normalizes the natural four, cycles its nonzero points,
and belongs to the two-residual of its normalizer. Thus this natural four
really is generated by the conjugates of the distinguished involution.
A second cubic belongs to the first parabolic's two-residual; its action on
both embedded quaternion factors is recorded on their generators.

Source: Aschbacher–Smith, Hypothesis 14.2.1 and Lemma 14.2.21, pp.981, 988.
-/

@[expose] public section
namespace Sporadic.Mathieu.M12SmallPair
open scoped IsMulCommutative
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

abbrev ElementaryCoordinates := Multiplicative (Fin 3 → ZMod 2)

noncomputable def elementaryEmbedding : ElementaryCoordinates →* M12 where
  toFun x := z ^ (x.toAdd 0).val * v ^ (x.toAdd 1).val * third ^ (x.toAdd 2).val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

theorem elementaryEmbedding_injective : Function.Injective elementaryEmbedding := by
  decide +kernel

theorem elementary_eq_range : elementary = elementaryEmbedding.range := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro x hx
    rcases hx with rfl | rfl | rfl
    · exact ⟨Multiplicative.ofAdd ![1,0,0], by decide +kernel⟩
    · exact ⟨Multiplicative.ofAdd ![0,1,0], by decide +kernel⟩
    · exact ⟨Multiplicative.ofAdd ![0,0,1], by decide +kernel⟩
  · rintro _ ⟨x,rfl⟩
    exact elementary.mul_mem
      (elementary.mul_mem
        (elementary.pow_mem (Subgroup.subset_closure (by simp)) _)
        (elementary.pow_mem (Subgroup.subset_closure (by simp)) _))
      (elementary.pow_mem (Subgroup.subset_closure (by simp)) _)

noncomputable def elementaryEquiv : ElementaryCoordinates ≃* elementary :=
  (MonoidHom.ofInjective elementaryEmbedding_injective).trans
    (MulEquiv.subgroupCongr elementary_eq_range.symm)

theorem card_elementary : Nat.card elementary = 8 := by
  rw [← Nat.card_congr elementaryEquiv.toEquiv, Nat.card_eq_fintype_card]
  decide +kernel

instance elementary_isElementaryAbelian : IsElementaryAbelian 2 elementary where
  is_comm := ⟨by
    intro x y
    obtain ⟨a,rfl⟩ := elementaryEquiv.surjective x
    obtain ⟨b,rfl⟩ := elementaryEquiv.surjective y
    rw [← map_mul, ← map_mul, mul_comm]⟩
  exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (by
    intro x
    obtain ⟨a,rfl⟩ := elementaryEquiv.surjective x
    rw [← map_pow]
    have h : ∀ a : ElementaryCoordinates, a ^ 2 = 1 := by decide +kernel
    rw [h, map_one])

theorem elementary_le_secondParabolic : elementary ≤ secondParabolic := by
  apply le_trans ?_ (Subgroup.centralizer_le_normalizer (natural : Set M12))
  intro x hx w hw
  exact congrArg Subtype.val (mul_comm (⟨w,natural_le_elementary hw⟩ : elementary) ⟨x,hx⟩)

theorem movingActor_mem : movingActor ∈ secondParabolic := by
  rw [secondParabolic, Subgroup.mem_set_normalizer_iff]
  intro g
  have hforward : ∀ w : M12, w ∈ natural → movingActor * w * movingActor⁻¹ ∈ natural := by
    intro w hw
    rw [mem_natural] at hw ⊢
    rcases hw with rfl | rfl | rfl | rfl <;> decide +kernel
  have hbackward : ∀ w : M12, w ∈ natural → movingActor⁻¹ * w * movingActor ∈ natural := by
    intro w hw
    rw [mem_natural] at hw ⊢
    rcases hw with rfl | rfl | rfl | rfl <;> decide +kernel
  constructor
  · exact hforward g
  · intro hg
    simpa [mul_assoc] using hbackward _ hg

private theorem cube_mem_residual {G : Type*} [Group G] (a : G) (ha : a ^ 3 = 1) :
    a ∈ pResidual 2 G := by
  apply Subgroup.mem_sInf.mpr
  rintro N ⟨hN,hP⟩
  let := hN
  let b := QuotientGroup.mk' N a
  have hb3 : b ^ 3 = 1 := by
    change (QuotientGroup.mk' N a) ^ 3 = 1
    rw [← map_pow, ha, map_one]
  obtain ⟨k,hk⟩ := hP b
  apply (QuotientGroup.eq_one_iff a).mp
  change b = 1
  apply orderOf_eq_one_iff.mp
  exact Nat.eq_one_of_dvd_coprimes (show Nat.Coprime 3 (2^k) from
    (by decide : Nat.Coprime 3 2).pow_right k)
    (orderOf_dvd_of_pow_eq_one hb3) (orderOf_dvd_of_pow_eq_one hk)

theorem movingActor_residual :
    (⟨movingActor,movingActor_mem⟩ : secondParabolic) ∈ pResidual 2 secondParabolic := by
  apply cube_mem_residual
  apply Subtype.ext
  decide +kernel

theorem cubicActor_residual :
    (⟨cubicActor,cubicActor_mem⟩ : firstParabolic) ∈ pResidual 2 firstParabolic := by
  apply cube_mem_residual
  apply Subtype.ext
  decide +kernel

theorem cubicActor_quaternion_action :
    cubicActor * leftI * cubicActor⁻¹ = leftJ * leftI ^ 2 ∧
    cubicActor * leftJ * cubicActor⁻¹ = leftJ * leftI ^ 3 ∧
    cubicActor * rightI * cubicActor⁻¹ = rightJ * rightI ^ 2 ∧
    cubicActor * rightJ * cubicActor⁻¹ = rightJ * rightI ^ 3 := by
  decide +kernel

theorem natural_eq_conjugateClosure : natural = Subgroup.closure
    {w : M12 | ∃ a ∈ secondParabolic, a * z * a⁻¹ = w} := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro w hw
    apply Subgroup.subset_closure
    rcases hw with rfl | rfl
    · exact ⟨1, secondParabolic.one_mem, by simp⟩
    · exact ⟨movingActor, movingActor_mem, movingActor_conjugates_z⟩
  · apply (Subgroup.closure_le _).mpr
    rintro w ⟨a,ha,rfl⟩
    exact (Subgroup.mem_set_normalizer_iff.mp ha z).mp z_mem_natural

end Sporadic.Mathieu.M12SmallPair
