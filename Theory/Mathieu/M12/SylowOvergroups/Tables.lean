def obstructionPerm (i : Fin 44) : Equiv.Perm (Fin 12) where
  toFun := obstructionImages[i.val]!
  invFun := obstructionInverses[i.val]!
  left_inv := (by decide +kernel : ∀ j : Fin 44, ∀ x : Fin 12,
    obstructionInverses[j.val]! (obstructionImages[j.val]! x) = x) i
  right_inv := (by decide +kernel : ∀ j : Fin 44, ∀ x : Fin 12,
    obstructionImages[j.val]! (obstructionInverses[j.val]! x) = x) i

theorem obstruction_perm : ∀ i : Fin 44, (obstruction i).val = obstructionPerm i := by
  decide +kernel

end Sporadic.Mathieu.M12SmallPair.SylowOvergroups
