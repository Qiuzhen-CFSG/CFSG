module

public import Theory.Mathieu.M12.SmallParabolicPair.FirstCore
public import Theory.Mathieu.M12.SmallParabolicPair.SylowGeometry

/-!
# The concrete marked M₁₂ parabolic pair

Inside the degree-twelve Witt-design automorphism group, the centralizer of
`z` and the normalizer of its conjugate-generated natural four have order 192
and intersect in a common Sylow two-subgroup of order 64. Its first omega
center is the distinguished line generated by `z`.

The first parabolic's two-core is the embedded central product of two
quaternion eights, of order 32 and extraspecial plus type. Its full
two-residual action preserves both marked factors and includes the specified
cubic. The marked elementary eight is normal in the second parabolic, whose
specified residual cubic moves `z`. The common Sylow action on this eight
has kernel the eight itself and image of order eight.

The order and normality calculations are proved in `FirstCore` and
`SylowGeometry`. This assembly relates their intrinsic and ambient subgroups,
centers, quotients and conjugation actions without changing the embeddings.

Source: Aschbacher–Smith, Hypothesis 14.2.1 and the M₁₂ model used in
Lemma 14.2.21, pp.981, 988. The source-theorem recognition and enlarged-local
argument use these concrete data in the chapter assembly.
-/

public section
noncomputable section
namespace Sporadic.Mathieu.M12SmallPair

/-- The intrinsic two-core identified with its actual embedded quaternion product. -/
def firstCoreEquiv : pCore 2 firstParabolic ≃* core :=
  (MulEquiv.subgroupCongr core_subgroupOf_eq_pCore.symm).trans
    (Subgroup.subgroupOfEquivOfLe core_le_firstParabolic)

theorem firstCoreEquiv_apply (q : pCore 2 firstParabolic) :
    (firstCoreEquiv q : M12) = (q.val : M12) := by rfl

/-- The actual two-core quotient, via the action on three matchings. -/
def firstCoreQuotient : firstParabolic ⧸ pCore 2 firstParabolic ≃* Equiv.Perm (Fin 3) :=
  (QuotientGroup.quotientMulEquivOfEq core_subgroupOf_eq_pCore.symm).trans
    firstParabolicCoreQuotient

theorem core_center_image :
    (Subgroup.center core).map core.subtype = distinguished := by
  apply le_antisymm
  · rintro g ⟨q, hq, rfl⟩
    change (q : M12) ∈ distinguished
    rcases (core_center_mem q).mp hq with h | h
    · rw [h]
      exact distinguished.one_mem
    · rw [h]
      exact Subgroup.mem_zpowers z
  · apply Subgroup.zpowers_le.mpr
    exact ⟨⟨z, z_mem_core⟩, (core_center_mem _).mpr (Or.inr rfl), rfl⟩

theorem firstParabolic_eq_centralizer_distinguished :
    firstParabolic = Subgroup.centralizer (distinguished : Set M12) := by
  rw [distinguished, Subgroup.zpowers_eq_closure, Subgroup.centralizer_closure]
  rfl

theorem natural_eq_distinguished_conjugateClosure : natural = Subgroup.closure
    {w : M12 | ∃ a ∈ secondParabolic, ∃ x ∈ distinguished, a * x * a⁻¹ = w} := by
  apply le_antisymm
  · rw [natural_eq_conjugateClosure]
    apply Subgroup.closure_mono
    rintro w ⟨a, ha, rfl⟩
    exact ⟨a, ha, z, Subgroup.mem_zpowers z, rfl⟩
  · apply (Subgroup.closure_le _).mpr
    rintro w ⟨a, ha, x, hx, rfl⟩
    exact (Subgroup.mem_set_normalizer_iff.mp ha x).mp (distinguished_le_natural hx)

theorem secondParabolic_normalizes_elementary :
    secondParabolic ≤ Subgroup.normalizer (elementary : Set M12) :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer elementary_le_secondParabolic).mp
    elementary_normal_secondParabolic

theorem sylowCandidate_normalizes_elementary :
    sylowCandidate ≤ Subgroup.normalizer (elementary : Set M12) :=
  inf_le_right.trans secondParabolic_normalizes_elementary

/-- Conjugation of the common Sylow subgroup on the marked elementary eight. -/
def sylowElementaryAction : sylowCandidate →* MulAut elementary :=
  elementary.normalizerMonoidHom.comp (Subgroup.inclusion sylowCandidate_normalizes_elementary)

theorem sylowElementaryAction_apply (t : sylowCandidate) (e : elementary) :
    (sylowElementaryAction t e : M12) = (t : M12) * e * (t : M12)⁻¹ := by rfl

theorem sylowElementaryAction_ker :
    sylowElementaryAction.ker = elementary.subgroupOf sylowCandidate := by
  ext t
  change Subgroup.inclusion sylowCandidate_normalizes_elementary t ∈
    elementary.normalizerMonoidHom.ker ↔ (t : M12) ∈ elementary
  rw [Subgroup.normalizerMonoidHom_ker]
  change (t : M12) ∈ Subgroup.centralizer (elementary : Set M12) ↔ (t : M12) ∈ elementary
  conv_rhs => rw [← sylowCandidate_centralizer_elementary]
  simp only [Subgroup.mem_inf, t.property, true_and]

theorem card_sylowElementaryAction_range : Nat.card sylowElementaryAction.range = 8 := by
  have h := sylowElementaryAction.ker.index_mul_card
  rw [Subgroup.index_ker, sylowElementaryAction_ker,
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe elementary_le_sylowCandidate).toEquiv,
    card_elementary, card_sylowCandidate] at h
  omega

/-- The two-core is self-centralizing in the first parabolic, with center the marked line. -/
theorem firstParabolic_centralizer_core :
    firstParabolic ⊓ Subgroup.centralizer (core : Set M12) = distinguished := by
  apply le_antisymm
  · rintro g ⟨hg, hc⟩
    have hA : g ∈ secondParabolic :=
      Subgroup.centralizer_le_normalizer (natural : Set M12)
        (Subgroup.centralizer_le natural_le_core hc)
    have hE : g ∈ elementary := by
      rw [← sylowCandidate_centralizer_elementary]
      exact ⟨⟨hg, hA⟩, Subgroup.centralizer_le elementary_le_core hc⟩
    rw [← core_center_image]
    refine ⟨⟨g, elementary_le_core hE⟩, ?_, rfl⟩
    apply Subgroup.mem_center_iff.mpr
    intro q
    exact Subtype.ext (hc q q.property)
  · intro g hg
    have hC : g ∈ (Subgroup.center core).map core.subtype := by
      rw [core_center_image]
      exact hg
    obtain ⟨q, hq, rfl⟩ := hC
    refine ⟨core_le_firstParabolic q.property, ?_⟩
    intro x hx
    exact congrArg (fun a : core => (a : M12)) (Subgroup.mem_center_iff.mp hq ⟨x, hx⟩)

theorem commonSylow_intersection :
    firstParabolic ⊓ secondParabolic = (commonSylow : Subgroup M12) := rfl

theorem commonSylow_omega_center :
    ((omega₁ (Subgroup.center commonSylow) (p := 2)).map
      (Subgroup.center commonSylow).subtype).map
        (commonSylow : Subgroup M12).subtype = distinguished := omega_center_image

/-- The source definition of the natural four, generated from the actual Sylow omega center. -/
theorem natural_eq_omega_center_conjugateClosure : natural = Subgroup.closure
    {w : M12 | ∃ a ∈ secondParabolic,
      ∃ x ∈ ((omega₁ (Subgroup.center commonSylow) (p := 2)).map
        (Subgroup.center commonSylow).subtype).map (commonSylow : Subgroup M12).subtype,
      a * x * a⁻¹ = w} := by
  rw [commonSylow_omega_center]
  exact natural_eq_distinguished_conjugateClosure

end Sporadic.Mathieu.M12SmallPair
