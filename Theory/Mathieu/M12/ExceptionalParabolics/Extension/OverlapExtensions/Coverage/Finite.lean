    multiply (blockIndex 6 i) j =
      step (multiply (blockIndex 6 i) (parent j)) (lastLetter j) := by
  intro i
  fin_cases i <;> decide +kernel

private theorem multiply_recurrence_7 : ∀ (i : Fin 16) (j : Fin 128), j ≠ 0 →
    multiply (blockIndex 7 i) j =
      step (multiply (blockIndex 7 i) (parent j)) (lastLetter j) := by
  intro i
  fin_cases i <;> decide +kernel

theorem multiply_recurrence (i j : Fin 128) (hj : j ≠ 0) :
    multiply i j = step (multiply i (parent j)) (lastLetter j) := by
  have check (b : Fin 8) (k : Fin 16) : ∀ j : Fin 128, j ≠ 0 →
      multiply (blockIndex b k) j =
        step (multiply (blockIndex b k) (parent j)) (lastLetter j) := by
    fin_cases b
    · exact multiply_recurrence_0 k
    · exact multiply_recurrence_1 k
    · exact multiply_recurrence_2 k
    · exact multiply_recurrence_3 k
    · exact multiply_recurrence_4 k
    · exact multiply_recurrence_5 k
    · exact multiply_recurrence_6 k
    · exact multiply_recurrence_7 k
  let b : Fin 8 := ⟨i.val / 16, by omega⟩
  let k : Fin 16 := ⟨i.val % 16, Nat.mod_lt _ (by decide)⟩
  have hi : blockIndex b k = i := by
    apply Fin.ext
    change 16 * (i.val / 16) + i.val % 16 = i.val
    omega
  simpa only [hi] using check b k j hj

theorem inverse_check : ∀ i, multiply i (Data.inverse i) = 0 := by decide +kernel

theorem order_check_two : ∀ i,
    orderNumber i = 2 ↔ power i 2 = 0 ∧ power i 1 ≠ 0 := by decide +kernel

theorem order_check_four : ∀ i,
    orderNumber i = 4 ↔ power i 4 = 0 ∧ power i 2 ≠ 0 := by decide +kernel

theorem order_check_eight : ∀ i,
    orderNumber i = 8 ↔ power i 8 = 0 ∧ power i 4 ≠ 0 := by decide +kernel

private def firstPairTest (a c : Fin 128) : Prop :=
  orderNumber c = 2 ∧ orderNumber (multiply a c) = 8 ∧
  orderNumber (multiply (multiply a a) c) = 2
private instance (a c : Fin 128) : Decidable (firstPairTest a c) :=
  inferInstanceAs (Decidable (_ ∧ _))

private def lastTest (a b c : Fin 128) : Prop :=
  orderNumber b = 2 ∧ orderNumber (multiply a b) = 4 ∧
  orderNumber (multiply (multiply a a) b) = 2 ∧
  orderNumber (multiply b c) = 4 ∧
  orderNumber (multiply (multiply a b) c) = 4 ∧
  orderNumber (multiply (multiply (multiply (multiply a b) c) b) c) = 4
private instance (a b c : Fin 128) : Decidable (lastTest a b c) :=
  inferInstanceAs (Decidable (_ ∧ _))

private theorem coverage_check : ∀ a : Fin 128, orderNumber a = 4 →
    ∀ c : Fin 128, firstPairTest a c → ∀ b : Fin 128, lastTest a b c →
    let w := witness a b c
    ∀ j : Fin 3, ![a,b,c] j = indexImage w.1 w.2.1 w.2.2 j := by
  intro a
  fin_cases a <;> decide +kernel

theorem coverage_indices (a b c : Fin 128) (h : admissible a b c) :
    ∃ u : Fin 128, ∃ p q : Bool, ∀ j : Fin 3, ![a,b,c] j = indexImage u p q j := by
  rcases h with ⟨ha, hb, hc, hab, hac, hbc, haab, haac, habc, habcbc⟩
  exact ⟨(witness a b c).1, (witness a b c).2.1, (witness a b c).2.2,
    coverage_check a ha c ⟨hc, hac, haac⟩ b ⟨hb, hab, haab, hbc, habc, habcbc⟩⟩

