def power : Fin 128 → ℕ → Fin 128
  | _, 0 => 0
  | x, n + 1 => multiply (power x n) x

def admissible (a b c : Fin 128) : Prop :=
  orderNumber a = 4 ∧ orderNumber b = 2 ∧ orderNumber c = 2 ∧
  orderNumber (multiply a b) = 4 ∧
  orderNumber (multiply a c) = 8 ∧
  orderNumber (multiply b c) = 4 ∧
  orderNumber (multiply (multiply a a) b) = 2 ∧
  orderNumber (multiply (multiply a a) c) = 2 ∧
  orderNumber (multiply (multiply a b) c) = 4 ∧
  orderNumber (multiply (multiply (multiply (multiply a b) c) b) c) = 4

instance admissibleDecidable (a b c : Fin 128) : Decidable (admissible a b c) :=
  inferInstanceAs (Decidable (_ ∧ _))

def indexImage (u : Fin 128) (p q : Bool) (j : Fin 3) : Fin 128 :=
  multiply (multiply u
    (multiply (if (j = 1 ∧ p = true) ∨ (j = 2 ∧ q = true) then 4 else 0)
      ⟨j.val + 1, by omega⟩)) (Data.inverse u)

