theorem parent_lt : ∀ j : Fin 128, j ≠ 0 → (parent j).val < j.val := by
  decide +kernel

theorem parent_step : ∀ j : Fin 128, j ≠ 0 → step (parent j) (lastLetter j) = j := by
  decide +kernel

theorem multiply_zero : ∀ i, multiply i 0 = i := by decide +kernel

private def blockIndex (b : Fin 8) (i : Fin 16) : Fin 128 :=
  ⟨16 * b.val + i.val, by omega⟩

private theorem multiply_recurrence_0 : ∀ (i : Fin 16) (j : Fin 128), j ≠ 0 →
    multiply (blockIndex 0 i) j =
      step (multiply (blockIndex 0 i) (parent j)) (lastLetter j) := by
  intro i
  fin_cases i <;> decide +kernel

private theorem multiply_recurrence_1 : ∀ (i : Fin 16) (j : Fin 128), j ≠ 0 →
    multiply (blockIndex 1 i) j =
      step (multiply (blockIndex 1 i) (parent j)) (lastLetter j) := by
  intro i
  fin_cases i <;> decide +kernel

private theorem multiply_recurrence_2 : ∀ (i : Fin 16) (j : Fin 128), j ≠ 0 →
    multiply (blockIndex 2 i) j =
