module
public import Theory.Mathieu.M12.ExceptionalParabolics.Extension.OverlapExtensions.Basic
/-!
# Coordinates on the genuine first outer M₁₂ endpoint

The overlap triple and the marked cubic actor give 384 positive words in the
literal degree-24 centralizer of `z`. Three-point signatures distinguish them;
the proved endpoint order makes the enumeration exhaustive. Bare point maps
and blocks of sixteen keep the kernel checks small. No split replacement for
the nonsplit two-core is used.

Source context: Aschbacher--Smith, E.2.16 (p.228), F.1.11--12 (pp.262--263),
and 14.2.21 (p.988), `refs/quasithin.pdf`. The permutation data retain the ATLAS
attribution of `Extension.Seeds`; the candidate word tables are generated by
`OverlapExtensions/source/generate.py` and acquire meaning only through these proofs.
-/
@[expose] public section
namespace Sporadic.Mathieu.M12ExceptionalExtension.OverlapExtensions
set_option maxRecDepth 100000
-- Sequential checking bounds memory used by the finite certificates.
set_option Elab.async false
namespace Endpoint
def cubicPerm : Equiv.Perm (Fin 24) where
  toFun := ![16, 1, 7, 3, 4, 11, 6, 13, 19, 8, 17, 20, 12, 2, 14, 10, 21, 15, 23, 9, 5, 0, 18, 22]
  invFun := ![21, 1, 13, 3, 4, 20, 6, 2, 9, 19, 15, 5, 12, 7, 14, 17, 0, 10, 22, 8, 11, 16, 23, 18]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

theorem cubic_val : cubicActor.val = cubicPerm := by decide +kernel

def generator (i : Fin 4) : firstParabolic :=
  ⟨![leftI, SecondCoordinates.swap, SecondCoordinates.extra, cubicActor] i, by
    fin_cases i
    · exact (Overlap.generator 0).property.1
    · exact (Overlap.generator 1).property.1
    · exact (Overlap.generator 2).property.1
    · obtain ⟨x, _, hx⟩ := FirstParabolic.cubicActor_mem_residual_image innerModel
      exact hx ▸ x.property⟩

def element (i : Fin 384) : firstParabolic :=
  FiniteWords.evaluate generator (Data.endpointWords i)

def signature (x : firstParabolic) : Nat × Nat × Nat :=
  ((x.val.val 0).val, (x.val.val 1).val, (x.val.val 2).val)
def indexSignature (i : Fin 384) : Nat × Nat × Nat := Data.endpointSignatures[i.val]!
def generatorPerm : Fin 4 → Equiv.Perm (Fin 24) :=
  ![FirstParabolic.leftIPerm, SecondCoordinates.swapPerm, SecondCoordinates.extraPerm, cubicPerm]

theorem generator_val (j : Fin 4) : (generator j).val.val = generatorPerm j := by
  fin_cases j
  · exact FirstParabolic.leftI_val
  · rfl
  · rfl
  · exact cubic_val

theorem element_val (i : Fin 384) : (element i).val.val =
    FiniteWords.evaluate generatorPerm (Data.endpointWords i) := by
  have h := FiniteWords.map_evaluate (group.subtype.comp firstParabolic.subtype)
    generator (Data.endpointWords i)
  change (element i).val.val = _ at h
  rw [show (fun j => (group.subtype.comp firstParabolic.subtype) (generator j)) =
    generatorPerm from funext generator_val] at h
  exact h

/-- Bare point maps keep the finite checks independent of permutation structure proofs. -/
def generatorMap (j : Fin 4) (x : Nat) : Nat :=
  (#[
    #[16, 13, 7, 3, 21, 10, 15, 23, 8, 9, 17, 6, 11, 14, 18, 12, 0, 20, 1, 19, 5, 4, 2, 22],
    #[9, 6, 10, 4, 3, 18, 1, 15, 21, 0, 2, 22, 14, 17, 12, 7, 19, 13, 5, 16, 23, 8, 11, 20],
    #[0, 1, 23, 3, 4, 11, 12, 18, 19, 9, 10, 5, 6, 22, 14, 17, 21, 15, 7, 8, 20, 16, 13, 2],
    #[16, 1, 7, 3, 4, 11, 6, 13, 19, 8, 17, 20, 12, 2, 14, 10, 21, 15, 23, 9, 5, 0, 18, 22]][j.val]!)[x]!

theorem generatorMap_spec : ∀ (j : Fin 4) (x : Fin 24),
    (generatorPerm j x).val = generatorMap j x.val := by decide +kernel

def evaluatePoint : List (Fin 4) → Nat → Nat
  | [], x => x
  | j :: w, x => generatorMap j (evaluatePoint w x)

theorem evaluatePoint_spec (w : List (Fin 4)) (x : Fin 24) :
    (FiniteWords.evaluate generatorPerm w x).val = evaluatePoint w x.val := by
  induction w with
  | nil => rfl
  | cons j w ih =>
    change (generatorPerm j (FiniteWords.evaluate generatorPerm w x)).val = _
    rw [generatorMap_spec, ih]
    rfl

private def signatureCorrect (i : Fin 384) : Prop :=
  let w := Data.endpointWords i
  (evaluatePoint w 0, evaluatePoint w 1, evaluatePoint w 2) = indexSignature i
private instance (i : Fin 384) : Decidable (signatureCorrect i) :=
  inferInstanceAs (Decidable ((evaluatePoint (Data.endpointWords i) 0,
    evaluatePoint (Data.endpointWords i) 1, evaluatePoint (Data.endpointWords i) 2) =
    indexSignature i))

private theorem signature_0 : ∀ i : Fin 16,
    signatureCorrect ⟨0 + i.val, by omega⟩ := by decide +kernel

private theorem signature_1 : ∀ i : Fin 16,
    signatureCorrect ⟨16 + i.val, by omega⟩ := by decide +kernel

