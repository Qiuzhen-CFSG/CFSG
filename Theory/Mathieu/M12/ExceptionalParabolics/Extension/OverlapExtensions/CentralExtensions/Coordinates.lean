    signatureCorrect ⟨352 + i.val, by omega⟩ := by decide +kernel

private theorem signature_23 : ∀ i : Fin 16,
    signatureCorrect ⟨368 + i.val, by omega⟩ := by decide +kernel

private theorem signature_block (b : Fin 24) : ∀ i : Fin 16,
    signatureCorrect ⟨16 * b.val + i.val, by omega⟩ := by
  fin_cases b
  · exact signature_0
  · exact signature_1
  · exact signature_2
  · exact signature_3
  · exact signature_4
  · exact signature_5
  · exact signature_6
  · exact signature_7
  · exact signature_8
  · exact signature_9
  · exact signature_10
  · exact signature_11
  · exact signature_12
  · exact signature_13
  · exact signature_14
  · exact signature_15
  · exact signature_16
  · exact signature_17
  · exact signature_18
  · exact signature_19
  · exact signature_20
  · exact signature_21
  · exact signature_22
  · exact signature_23

private theorem signature_check (i : Fin 384) : signatureCorrect i := by
  have h := signature_block ⟨i.val / 16, by omega⟩ ⟨i.val % 16, by omega⟩
  have e : (⟨16 * (i.val / 16) + i.val % 16, by omega⟩ : Fin 384) = i := by
    apply Fin.ext
    change 16 * (i.val / 16) + i.val % 16 = i.val
    omega
  exact e ▸ h

theorem signature_element (i : Fin 384) : signature (element i) = indexSignature i := by
  unfold signature
  rw [element_val]
  simp only [evaluatePoint_spec]
  exact signature_check i

private theorem decode_index : ∀ i : Fin 384,
    Data.endpointDecodeSignature (indexSignature i) = i.val := by decide +kernel

theorem indexSignature_injective : Function.Injective indexSignature := by
  intro i j h
  apply Fin.ext
  rw [← decode_index i, ← decode_index j, h]

theorem element_injective : Function.Injective element := by
  intro i j h
  apply indexSignature_injective
  rw [← signature_element, ← signature_element, h]

theorem element_surjective : Function.Surjective element :=
  ((Nat.bijective_iff_injective_and_card element).mpr
    ⟨element_injective, by rw [Nat.card_fin, FirstParabolic.card_firstParabolic innerModel]⟩).2

theorem signature_injective : Function.Injective signature := by
  intro x y h
  obtain ⟨i, rfl⟩ := element_surjective x
  obtain ⟨j, rfl⟩ := element_surjective y
  apply congrArg element
  apply indexSignature_injective
  simpa only [signature_element] using h

noncomputable def coordinates : Fin 384 ≃ firstParabolic :=
  Equiv.ofBijective element ⟨element_injective, element_surjective⟩

theorem element_zero : element 0 = 1 := rfl

theorem element_generator (j : Fin 4) :
    element ⟨j.val + 1, by omega⟩ = generator j := by
  fin_cases j <;> exact mul_one _

end Endpoint
end Sporadic.Mathieu.M12ExceptionalExtension.OverlapExtensions
