private theorem signature_16 : ∀ i : Fin 16,
    signatureCorrect ⟨256 + i.val, by omega⟩ := by decide +kernel

private theorem signature_17 : ∀ i : Fin 16,
    signatureCorrect ⟨272 + i.val, by omega⟩ := by decide +kernel

private theorem signature_18 : ∀ i : Fin 16,
    signatureCorrect ⟨288 + i.val, by omega⟩ := by decide +kernel

private theorem signature_19 : ∀ i : Fin 16,
    signatureCorrect ⟨304 + i.val, by omega⟩ := by decide +kernel

