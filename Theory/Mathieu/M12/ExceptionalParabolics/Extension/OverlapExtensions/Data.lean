def overlapWords (i : Fin 128) : List (Fin 3) :=
  (overlapWordTable[i.val]!).map (fun j => ⟨j % 3, Nat.mod_lt _ (by decide)⟩)
def endpointWords (i : Fin 384) : List (Fin 4) :=
  (endpointWordTable[i.val]!).map (fun j => ⟨j % 4, Nat.mod_lt _ (by decide)⟩)
def multiply (i j : Fin 128) : Fin 128 :=
  ⟨(overlapMultiplyTable[i.val]!)[j.val]! % 128, Nat.mod_lt _ (by decide)⟩
