def distinguished : Subgroup Carrier := Subgroup.zpowers z
def natural : Subgroup Carrier := Subgroup.closure ({z,v} : Set Carrier)
def firstParabolic : Subgroup Carrier := Subgroup.centralizer ({z} : Set Carrier)
def secondParabolic : Subgroup Carrier := Subgroup.normalizer (natural : Set Carrier)
def overlap : Subgroup Carrier := firstParabolic ⊓ secondParabolic

/-- The precise inner-model prerequisite. It identifies the whole subgroup
generated by the two fixed lifts, and asserts index two in the fixed carrier.
No local core, quotient, overlap or automorphism-coverage conclusion is an input. -/
structure InnerModel where
  equiv : M12 ≃* inner
  generatorA_eq : (equiv originalA : Carrier) = innerA
  generatorB_eq : (equiv originalB : Carrier) = innerB
  index : inner.index = 2

namespace InnerModel
variable (m : InnerModel)

/-- The literal embedding determined by the marked inner-model comparison. -/
noncomputable def embedding : M12 →* Carrier := inner.subtype.comp m.equiv.toMonoidHom

theorem embedding_injective : Function.Injective m.embedding :=
  inner.subtype_injective.comp m.equiv.injective

theorem embedding_originalA : m.embedding originalA = innerA := m.generatorA_eq
theorem embedding_originalB : m.embedding originalB = innerB := m.generatorB_eq

theorem embedding_range : m.embedding.range = inner := by
  ext g
  constructor
  · rintro ⟨x,rfl⟩
    exact (m.equiv x).property
  · intro hg
    obtain ⟨x,hx⟩ := m.equiv.surjective ⟨g,hg⟩
    exact ⟨x,congrArg Subtype.val hx⟩

include m in
theorem card_carrier : Nat.card Carrier = 190080 := by
  have h := inner.index_mul_card
  rw [m.index, ← Nat.card_congr m.equiv.toEquiv, m12_order] at h
  omega

end InnerModel

end Sporadic.Mathieu.M12ExceptionalExtension
