def rightJ : Carrier := evaluate innerA innerB [true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, true, false, true, true, false, true, true, false, true, false]

theorem map_rightJ (f : M12 →* Carrier)
    (ha : f originalA = innerA) (hb : f originalB = innerB) :
    f M12SmallPair.rightJ = rightJ := by
  have h : M12SmallPair.rightJ = evaluate originalA originalB [true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, true, false, true, true, false, true, true, false, true, false] := by
