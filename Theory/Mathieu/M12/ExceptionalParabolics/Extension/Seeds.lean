def leftJ : Carrier := evaluate innerA innerB [true, false, true, true, false, true, false, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, true, false, true, true, false, true, false]

theorem map_leftJ (f : M12 →* Carrier)
    (ha : f originalA = innerA) (hb : f originalB = innerB) :
    f M12SmallPair.leftJ = leftJ := by
  have h : M12SmallPair.leftJ = evaluate originalA originalB [true, false, true, true, false, true, false, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, true, false, true, true, false, true, false] := by
