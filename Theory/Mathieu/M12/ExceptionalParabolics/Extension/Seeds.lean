module

public import Theory.Mathieu.M12.SmallParabolicPair.Seeds
public import Theory.Mathieu.M12.Properties.Order

/-!
# Fixed degree-24 coordinates for the M₁₂ outer extension

The carrier is the permutation group generated by the ATLAS degree-24 pair
`M12d2G1-p24B0`. Two explicitly word-certified elements give candidate lifts
of the existing degree-12 generators. All original parabolic marks are
lifted by their existing words. The transport equations hold for any actual
homomorphism with the specified generator images.

Only membership and these conditional word-transport equations are asserted
here. Identification of the inner subgroup with the Witt-design M₁₂, and
identification of this entire carrier with MulAut(M₁₂), require proofs.
The displayed lift words were found with GAP and are checked by Lean's
kernel. The numerical group-order and isomorphism reports from GAP are not
used as proofs.

Sources: ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/v3/permrep/M12d2G1-p24B0,
with permutation data at /Atlas/spor/M12/gap/M12d2G1-p24B0.g1 and .g2;
Aschbacher--Smith, F.1.12(I)(13), printed p.263, and 14.2.21, printed p.988.
The degree-12 marked words are those in M12/SmallParabolicPair/Seeds.lean.
The ATLAS point numbered 24 is represented by 0 in Fin 24, as point 12 is
represented by 0 in the existing degree-12 generators.
-/

@[expose] public section
namespace Sporadic.Mathieu.M12ExceptionalExtension
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

/-- First generator of the ATLAS degree-24 extension representation. -/
def generatorA : Equiv.Perm (Fin 24) :=
  List.formPerm [1,4] * List.formPerm [2,17] * List.formPerm [3,15] *
  List.formPerm [5,18] * List.formPerm [6,19] * List.formPerm [7,12] *
  List.formPerm [8,10] * List.formPerm [9,21] * List.formPerm [11,13] *
  List.formPerm [14,16] * List.formPerm [20,23] * List.formPerm [22,0]

/-- Second generator of the ATLAS degree-24 extension representation. -/
def generatorB : Equiv.Perm (Fin 24) :=
  List.formPerm [2,18,23] * List.formPerm [3,19,14] * List.formPerm [4,11,21] *
  List.formPerm [5,10,16] * List.formPerm [7,22,13] * List.formPerm [17,0,20]

def group : Subgroup (Equiv.Perm (Fin 24)) :=
  Subgroup.closure ({generatorA, generatorB} : Set (Equiv.Perm (Fin 24)))

/-- A literal permutation carrier, before proving its automorphism interpretation. -/
abbrev Carrier := group

private def wordPerm : List (Fin 3) → Equiv.Perm (Fin 24)
  | [] => 1
  | i :: w => (if i = 0 then generatorA else if i = 1 then generatorB else generatorB⁻¹) *
      wordPerm w

private theorem wordPerm_mem (w : List (Fin 3)) : wordPerm w ∈ group := by
  have ha : generatorA ∈ group := Subgroup.subset_closure (by simp)
  have hb : generatorB ∈ group := Subgroup.subset_closure (by simp)
  induction w with
  | nil => exact group.one_mem
  | cons i w ih =>
    apply group.mul_mem _ ih
    split_ifs
    · exact ha
    · exact hb
    · exact group.inv_mem hb

def innerAPerm : Equiv.Perm (Fin 24) :=
  List.formPerm [1,3] * List.formPerm [2,23] * List.formPerm [4,20] *
  List.formPerm [5,12] * List.formPerm [6,11] * List.formPerm [8,22] *
  List.formPerm [13,19] * List.formPerm [15,17]

def innerBPerm : Equiv.Perm (Fin 24) :=
  List.formPerm [1,2,3] * List.formPerm [4,5,12] * List.formPerm [6,10,16] *
  List.formPerm [7,19,23] * List.formPerm [8,13,18] * List.formPerm [9,22,14] *
  List.formPerm [11,0,15] * List.formPerm [17,21,20]

theorem innerAPerm_mem : innerAPerm ∈ group := by
  have h : innerAPerm = wordPerm [0, 2, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0, 2, 0, 2, 0, 1, 0, 1, 0, 2, 0, 2, 0, 1, 1, 0, 1, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0] := by decide +kernel
  rw [h]
  exact wordPerm_mem _

def innerA : Carrier := ⟨innerAPerm, innerAPerm_mem⟩

theorem innerBPerm_mem : innerBPerm ∈ group := by
  have h : innerBPerm = wordPerm [0, 2, 0, 2, 0, 1, 0, 1, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0, 2, 0, 2, 0, 1, 0, 2, 0, 2, 0, 2, 0, 1, 0, 1, 0, 2, 0, 2, 0, 1, 0, 1, 0, 2, 0, 1, 0, 1, 0, 1, 0, 1, 0, 2, 0, 1, 0, 1, 0, 1, 0, 2, 0, 1, 1, 0, 1, 0, 1] := by decide +kernel
  rw [h]
  exact wordPerm_mem _

def innerB : Carrier := ⟨innerBPerm, innerBPerm_mem⟩

/-- The degree-12 block on which the two lifts have the original marked action. -/
def blockLabel : Fin 12 → Fin 24 := ![4,6,0,15,11,12,20,21,10,16,17,5]

theorem blockLabel_injective : Function.Injective blockLabel := by decide +kernel

theorem innerA_block (i : Fin 12) :
    innerAPerm (blockLabel i) = blockLabel (m12GeneratorA i) := by
  have h : ∀ i, innerAPerm (blockLabel i) = blockLabel (m12GeneratorA i) := by
    decide +kernel
  exact h i

theorem innerB_block (i : Fin 12) :
    innerBPerm (blockLabel i) = blockLabel (m12GeneratorB i) := by
  have h : ∀ i, innerBPerm (blockLabel i) = blockLabel (m12GeneratorB i) := by
    decide +kernel
  exact h i

/-- The subgroup whose marked equivalence with the original M₁₂ remains to be proved. -/
def inner : Subgroup Carrier := Subgroup.closure ({innerA, innerB} : Set Carrier)

/-- Evaluate the same positive word in any specified pair of group elements. -/
def evaluate {G : Type*} [Group G] (a b : G) : List Bool → G
  | [] => 1
  | c :: w => (if c then b else a) * evaluate a b w

theorem map_evaluate {G H : Type*} [Group G] [Group H] (f : G →* H)
    (a b : G) (w : List Bool) : f (evaluate a b w) = evaluate (f a) (f b) w := by
  induction w with
  | nil => exact map_one f
  | cons c w ih => cases c <;> simp only [evaluate, Bool.false_eq_true, ↓reduceIte, map_mul, ih]

/-- The existing first generator as an element of the Witt-design group. -/
noncomputable def originalA : M12 := ⟨m12GeneratorA, m12GeneratorA_mem⟩
/-- The existing second generator as an element of the Witt-design group. -/
noncomputable def originalB : M12 := ⟨m12GeneratorB, m12GeneratorB_mem⟩

def z : Carrier := evaluate innerA innerB [false, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, true, false, true, false, true, true]

theorem map_z (f : M12 →* Carrier)
    (ha : f originalA = innerA) (hb : f originalB = innerB) :
    f M12SmallPair.z = z := by
  have h : M12SmallPair.z = evaluate originalA originalB [false, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, true, false, true, false, true, true] := by
    decide +kernel
  rw [h, map_evaluate, ha, hb]
  rfl

def v : Carrier := evaluate innerA innerB [true, true, false, true, false, true, false, true, true, false, true, true, false, true]

theorem map_v (f : M12 →* Carrier)
    (ha : f originalA = innerA) (hb : f originalB = innerB) :
    f M12SmallPair.v = v := by
  have h : M12SmallPair.v = evaluate originalA originalB [true, true, false, true, false, true, false, true, true, false, true, true, false, true] := by
    decide +kernel
  rw [h, map_evaluate, ha, hb]
  rfl

