def movingActor : Carrier := evaluate innerA innerB [false, true, true, false, true, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true]

theorem map_movingActor (f : M12 →* Carrier)
    (ha : f originalA = innerA) (hb : f originalB = innerB) :
    f M12SmallPair.movingActor = movingActor := by
  have h : M12SmallPair.movingActor = evaluate originalA originalB [false, true, true, false, true, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true] := by
