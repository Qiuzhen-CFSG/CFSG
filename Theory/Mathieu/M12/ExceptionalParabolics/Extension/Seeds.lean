def rightI : Carrier := evaluate innerA innerB [true, true, false, true, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, true]

theorem map_rightI (f : M12 →* Carrier)
    (ha : f originalA = innerA) (hb : f originalB = innerB) :
    f M12SmallPair.rightI = rightI := by
  have h : M12SmallPair.rightI = evaluate originalA originalB [true, true, false, true, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, true] := by
    decide +kernel
