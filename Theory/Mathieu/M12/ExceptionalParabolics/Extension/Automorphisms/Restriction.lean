module

public import Theory.Mathieu.M12.ExceptionalParabolics.Extension.Seeds
public import Theory.Mathieu.M12.Properties.SylowAutomorphisms
public import Theory.Mathieu.M12.Properties.SylowAutomorphismGroup.Coordinates

/-!
# Restriction of the fixed degree-24 inner subgroup

The marked block defines an epimorphism from the subgroup generated by the
fixed lifts onto the original Witt-design M₁₂. Generation is established using
the marked Sylow subgroup and its two cubic actors. An upper bound of 190080
for the full degree-24 carrier then proves faithfulness and index two: the
outer generator moves the block, whereas the inner subgroup preserves it.

The numerical upper bound is an explicit premise here, not a claim about the
ATLAS group. Source: ATLAS M12d2G1-p24B0 and Aschbacher–Smith F.1.12(I)(13).
-/

public section
namespace Sporadic.Mathieu.M12ExceptionalExtension
open Subgroup
set_option maxRecDepth 100000
set_option maxHeartbeats 100000

private theorem evaluate_mem {G : Type*} [Group G] (K : Subgroup G)
    {a b : G} (ha : a ∈ K) (hb : b ∈ K) (w : List Bool) :
    evaluate a b w ∈ K := by
  induction w with
  | nil => exact K.one_mem
  | cons c w ih => exact K.mul_mem (by cases c <;> assumption) ih

/-- The exact original marked pair generates the full Witt-design group. -/
theorem original_pair_generates (K : Subgroup M12)
    (ha : originalA ∈ K) (hb : originalB ∈ K) : K = ⊤ := by
  have hl : M12SmallPair.leftI ∈ K := by
    have he : M12SmallPair.leftI = evaluate originalA originalB [false, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, true, false, true] := by decide +kernel
    rw [he]
    exact evaluate_mem K ha hb _
  have hr : M12SmallPair.rightI ∈ K := by
    have he : M12SmallPair.rightI = evaluate originalA originalB [true, true, false, true, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, true] := by decide +kernel
    rw [he]
    exact evaluate_mem K ha hb _
  have hm : M12SmallPair.movingActor ∈ K := by
    have he : M12SmallPair.movingActor = evaluate originalA originalB [false, true, true, false, true, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true] := by decide +kernel
    rw [he]
    exact evaluate_mem K ha hb _
  have hc : M12SmallPair.cubicActor ∈ K := by
    have he : M12SmallPair.cubicActor = evaluate originalA originalB [false, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true, false, true, false, true, true] := by decide +kernel
    rw [he]
    exact evaluate_mem K ha hb _
  apply M12SmallPair.SylowAutomorphisms.eq_top_of_contains_sylow_and_cubics K _ hc hm
  have hg (j : Fin 3) : (M12SmallPair.SylowAutomorphismGroup.generator j : M12) ∈ K := by
    fin_cases j
    · exact hl
    · exact hr
    · exact K.mul_mem (K.mul_mem hm hl) hm
  have hw (w : List (Fin 3)) :
      (M12SmallPair.SylowAutomorphismGroup.evaluate w : M12) ∈ K := by
    induction w with
    | nil => exact K.one_mem
    | cons j w ih => exact K.mul_mem (hg j) ih
  intro x hx
  obtain ⟨i, hi⟩ := M12SmallPair.SylowAutomorphismGroup.element_surjective ⟨x,hx⟩
  have hh := hw (M12SmallPair.SylowAutomorphismGroup.words i)
  change (M12SmallPair.SylowAutomorphismGroup.element i : M12) ∈ K at hh
  simpa only [hi] using hh

private def Matches (g : Carrier) (h : M12) : Prop :=
  ∀ i, g.val (blockLabel i) = blockLabel (h.val i)

private theorem matches_one : Matches 1 1 := fun _ => rfl

private theorem matches_mul {g g' : Carrier} {h h' : M12}
    (he : Matches g h) (he' : Matches g' h') : Matches (g*g') (h*h') := by
  intro i
  change g.val (g'.val (blockLabel i)) = blockLabel (h.val (h'.val i))
  rw [he', he]

private theorem matches_inv {g : Carrier} {h : M12}
    (he : Matches g h) : Matches g⁻¹ h⁻¹ := by
  intro i
  apply g.val.injective
  change g.val (g.val⁻¹ (blockLabel i)) = g.val (blockLabel (h.val⁻¹ i))
  rw [he]
  simp

private theorem matches_unique {g : Carrier} {h k : M12}
    (hh : Matches g h) (hk : Matches g k) : h = k := by
  apply Subtype.ext
  apply Equiv.ext
  intro i
  apply blockLabel_injective
  exact (hh i).symm.trans (hk i)

private def compatibleBlock : Subgroup Carrier where
  carrier := {g | ∃ h : M12, Matches g h}
  one_mem' := ⟨1, matches_one⟩
  mul_mem' := by
    rintro g g' ⟨h,hh⟩ ⟨h',hh'⟩
    exact ⟨h*h', matches_mul hh hh'⟩
  inv_mem' := by
    rintro g ⟨h,hh⟩
    exact ⟨h⁻¹, matches_inv hh⟩

private theorem inner_le_compatibleBlock : inner ≤ compatibleBlock := by
  apply (closure_le compatibleBlock).mpr
  intro g hg
  rcases Set.mem_insert_iff.mp hg with rfl | hg
  · exact ⟨originalA, innerA_block⟩
  · have : g = innerB := Set.mem_singleton_iff.mp hg
    subst g
    exact ⟨originalB, innerB_block⟩

/-- Restriction to the labeled block, with values in the actual design group. -/
noncomputable def blockRestriction : inner →* M12 where
  toFun g := Classical.choose (inner_le_compatibleBlock g.property)
  map_one' := matches_unique (Classical.choose_spec (inner_le_compatibleBlock (1 : inner).property)) matches_one
  map_mul' g h := matches_unique
    (Classical.choose_spec (inner_le_compatibleBlock (g*h).property))
    (matches_mul (Classical.choose_spec (inner_le_compatibleBlock g.property))
      (Classical.choose_spec (inner_le_compatibleBlock h.property)))

theorem blockRestriction_spec (g : inner) (i : Fin 12) :
    g.val.val (blockLabel i) = blockLabel ((blockRestriction g).val i) :=
  Classical.choose_spec (inner_le_compatibleBlock g.property) i

/-- The original first generator is recovered exactly. -/
theorem blockRestriction_innerA :
    blockRestriction ⟨innerA, subset_closure (by simp)⟩ = originalA :=
  matches_unique (blockRestriction_spec _) innerA_block

/-- The original second generator is recovered exactly. -/
theorem blockRestriction_innerB :
    blockRestriction ⟨innerB, subset_closure (by simp)⟩ = originalB :=
  matches_unique (blockRestriction_spec _) innerB_block

theorem blockRestriction_surjective : Function.Surjective blockRestriction := by
  have h := original_pair_generates blockRestriction.range
    ⟨_, blockRestriction_innerA⟩ ⟨_, blockRestriction_innerB⟩
  exact (MonoidHom.range_eq_top).mp h

/-- The ATLAS outer generator does not preserve the marked block. -/
theorem inner_ne_top : inner ≠ ⊤ := by
  intro he
  let a : Carrier := ⟨generatorA, subset_closure (by simp)⟩
  have ha : a ∈ inner := he ▸ mem_top a
  obtain ⟨h,hh⟩ := inner_le_compatibleBlock ha
  have hi := hh 0
  have hn : ∀ i : Fin 12, generatorA (blockLabel 0) ≠ blockLabel i := by decide +kernel
  exact hn (h.val 0) hi

/-- A certified upper bound on the literal carrier gives its exact order,
the inner index, and the order needed to prove restriction faithful. -/
theorem orders_of_carrier_bound (hbound : Nat.card Carrier ≤ 190080) :
    Nat.card inner = 95040 ∧ inner.index = 2 := by
  have hlo : 95040 ≤ Nat.card inner := by
    rw [← m12_order]
    exact Nat.card_le_card_of_surjective blockRestriction blockRestriction_surjective
  have hi : 1 < inner.index := one_lt_index_of_ne_top inner_ne_top
  have he := inner.card_mul_index
  have hcardUpper : Nat.card inner ≤ 95040 := by
    have hh : Nat.card inner * 2 ≤ Nat.card Carrier := by
      rw [← he]
      exact Nat.mul_le_mul_left _ hi
    omega
  have hcard : Nat.card inner = 95040 := Nat.le_antisymm hcardUpper hlo
  refine ⟨hcard, ?_⟩
  rw [hcard] at he
  omega

/-- Restriction is faithful once the finite upper bound is certified. -/
theorem blockRestriction_bijective_of_carrier_bound (hbound : Nat.card Carrier ≤ 190080) :
    Function.Bijective blockRestriction := by
  apply blockRestriction_surjective.bijective_of_nat_card_le
  rw [(orders_of_carrier_bound hbound).1, m12_order]

private noncomputable def restrictionEquiv (hbound : Nat.card Carrier ≤ 190080) :
    inner ≃* M12 := MulEquiv.ofBijective blockRestriction
      (blockRestriction_bijective_of_carrier_bound hbound)

private theorem inverse_val {G : Type*} [Group G] (H : Subgroup G)
    {K : Type*} [Group K] (e : H ≃* K) (x : H) (y : K) (he : e x = y) :
    (e.symm y : G) = x.val := by
  exact congrArg (fun z : H => z.val) (e.symm_apply_eq.mpr he.symm)

set_option maxHeartbeats 20000 in
private theorem restrictionEquiv_A (hbound : Nat.card Carrier ≤ 190080) :
    ((restrictionEquiv hbound).symm originalA : Carrier) = innerA :=
  inverse_val inner (restrictionEquiv hbound)
    ⟨innerA, subset_closure (by simp)⟩ originalA blockRestriction_innerA

set_option maxHeartbeats 20000 in
private theorem restrictionEquiv_B (hbound : Nat.card Carrier ≤ 190080) :
    ((restrictionEquiv hbound).symm originalB : Carrier) = innerB :=
  inverse_val inner (restrictionEquiv hbound)
    ⟨innerB, subset_closure (by simp)⟩ originalB blockRestriction_innerB

/-- The actual marked model, conditional only on a finite order upper bound.
The bound must be discharged in the final automorphism identification. -/
noncomputable def innerModelOfCarrierBound (hbound : Nat.card Carrier ≤ 190080) : InnerModel where
  equiv := (restrictionEquiv hbound).symm
  generatorA_eq := restrictionEquiv_A hbound
  generatorB_eq := restrictionEquiv_B hbound
  index := (orders_of_carrier_bound hbound).2

end Sporadic.Mathieu.M12ExceptionalExtension
