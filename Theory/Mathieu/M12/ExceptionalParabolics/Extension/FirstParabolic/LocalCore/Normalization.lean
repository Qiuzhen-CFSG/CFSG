module
public import Theory.Mathieu.M12.ExceptionalParabolics.Extension.FirstParabolic.Core

/-!
# Normality of the first outer parabolic's concrete cores

The inner centralizer and the nonsplit swap generate the outer centralizer.
The inner centralizer is generated by its quaternion kernel and the two
certified matching-action lifts. Their commutators with the nonsplit swap
belong to the quaternion core, so both concrete cores are normal in the
whole centralizer. All new word identities are checked on the degree-24
permutations.

Source: Aschbacher--Smith, F.1.12(I)(13), p.263, and 14.2.21, p.988.
-/

@[expose] public section
noncomputable section
namespace Sporadic.Mathieu.M12ExceptionalExtension.FirstParabolic
open Subgroup
open scoped commutatorElement
set_option maxRecDepth 100000

private def secondCycleLift : Carrier := evaluate innerA innerB [true, false, true, true, false, true, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, true, false]

private theorem map_secondCycle (m : InnerModel) :
    m.embedding M12SmallPair.FirstCore.secondCycle = secondCycleLift := by
  have h : M12SmallPair.FirstCore.secondCycle = evaluate originalA originalB [true, false, true, true, false, true, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, false, true, true, false, true, true, false, true, false, true, false, true, true, false] := by
    decide +kernel
  rw [h, map_evaluate, m.embedding_originalA, m.embedding_originalB]
  rfl

private def secondSwapLift : Carrier := evaluate innerA innerB [true, false, true, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, false]

private theorem map_secondSwap (m : InnerModel) :
    m.embedding M12SmallPair.FirstCore.secondSwap = secondSwapLift := by
  have h : M12SmallPair.FirstCore.secondSwap = evaluate originalA originalB [true, false, true, true, false, true, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, true, false, true, false, true, false, true, false, true, true, false, true, false, true, false] := by
    decide +kernel
  rw [h, map_evaluate, m.embedding_originalA, m.embedding_originalB]
  rfl

private theorem cycle_swap_commutator :
    ⁅secondCycleLift, nonsplitSwap⁆ = leftJ * (rightJ * rightI ^ 2) := by
  apply Subtype.ext
  decide +kernel

private theorem swap_swap_commutator :
    ⁅secondSwapLift, nonsplitSwap⁆ = rightI ^ 2 := by
  apply Subtype.ext
  decide +kernel

attribute [local irreducible] leftI leftJ rightI rightJ nonsplitSwap

/-- The inner intersection and the certified outer lift generate the centralizer. -/
theorem firstParabolic_le_of_inner_swap (m : InnerModel) (N : Subgroup Carrier)
    (hi : inner ⊓ firstParabolic ≤ N) (hs : nonsplitSwap ∈ N) :
    firstParabolic ≤ N := by
  intro g hg
  by_cases hgi : g ∈ inner
  · exact hi ⟨hgi,hg⟩
  · have hx : g * nonsplitSwap⁻¹ ∈ inner :=
      (inner.mul_mem_iff_of_index_two m.index).mpr (by
        simp only [hgi, inner.inv_mem_iff, nonsplitSwap_not_mem_inner])
    have hn := N.mul_mem (hi ⟨hx,firstParabolic.mul_mem hg
      (firstParabolic.inv_mem nonsplitSwap_mem_firstParabolic)⟩) hs
    simpa only [inv_mul_cancel_right] using hn

/-- Relative normality of the quaternion core, in the actual outer centralizer. -/
theorem firstParabolic_normalizes_quaternionCore (m : InnerModel) :
    firstParabolic ≤ normalizer (quaternionCore : Set Carrier) := by
  apply firstParabolic_le_of_inner_swap m _ _ nonsplitSwap_normalizes_quaternionCore
  rw [← firstParabolic_inner_image m, quaternionCore_eq_map m]
  exact (map_mono M12SmallPair.firstParabolic_normalizes_core).trans
    (le_normalizer_map _)

private theorem quaternion_marks_mem :
    leftI ∈ quaternionCore ∧ leftJ ∈ quaternionCore ∧
    rightI ∈ quaternionCore ∧ rightJ ∈ quaternionCore := by
  rw [quaternionCore_eq_closure]
  exact ⟨subset_closure (by simp), subset_closure (by simp),
    subset_closure (by simp), subset_closure (by simp)⟩

private theorem normalizes_outerCore_of_commutator (g : Carrier)
    (hq : g ∈ normalizer (quaternionCore : Set Carrier))
    (hs : ⁅g,nonsplitSwap⁆ ∈ quaternionCore) :
    g ∈ normalizer (outerCore : Set Carrier) := by
  apply mem_normalizer_fintype
  intro x hx
  have hmap : outerCore.map (MulAut.conj g).toMonoidHom ≤ outerCore := by
    rw [outerCore, Subgroup.map_sup]
    apply sup_le
    · have he := mem_normalizer_iff_map_conj_eq.mp hq
      change quaternionCore.map (MulAut.conj g).toMonoidHom = quaternionCore at he
      rw [he]
      exact le_sup_left
    · rw [MonoidHom.map_zpowers]
      apply zpowers_le.mpr
      have hc : ⁅g,nonsplitSwap⁆ * nonsplitSwap ∈ outerCore :=
        outerCore.mul_mem ((show quaternionCore ≤ outerCore from le_sup_left) hs) ((show zpowers nonsplitSwap ≤ outerCore from le_sup_right) (mem_zpowers _))
      change g * nonsplitSwap * g⁻¹ ∈ outerCore
      simpa only [commutatorElement_def, inv_mul_cancel_right] using hc
  exact hmap ⟨x,hx,rfl⟩

/-- Relative normality of the concrete order-64 subgroup. -/
theorem firstParabolic_normalizes_outerCore (m : InnerModel) :
    firstParabolic ≤ normalizer (outerCore : Set Carrier) := by
  apply firstParabolic_le_of_inner_swap m _ ?_
    (outerCore.le_normalizer ((show zpowers nonsplitSwap ≤ outerCore from le_sup_right) (mem_zpowers _)))
  rw [← firstParabolic_inner_image m, map_le_iff_le_comap]
  apply M12SmallPair.FirstCore.firstParabolic_le_of_core_cycle_swap
  · intro x hx
    apply outerCore.le_normalizer
    apply (show quaternionCore ≤ outerCore from le_sup_left)
    rw [quaternionCore_eq_map m]
    exact ⟨x,hx,rfl⟩
  · change m.embedding M12SmallPair.FirstCore.secondCycle ∈ normalizer (outerCore : Set Carrier)
    apply normalizes_outerCore_of_commutator
    · apply firstParabolic_normalizes_quaternionCore m
      change M12SmallPair.FirstCore.secondCycle ∈ firstParabolic.comap m.embedding
      rw [firstParabolic_comap m]
      exact M12SmallPair.FirstCore.secondCycle_mem
    · rw [map_secondCycle, cycle_swap_commutator]
      exact quaternionCore.mul_mem quaternion_marks_mem.2.1
        (quaternionCore.mul_mem quaternion_marks_mem.2.2.2
          (quaternionCore.pow_mem quaternion_marks_mem.2.2.1 2))
  · change m.embedding M12SmallPair.FirstCore.secondSwap ∈ normalizer (outerCore : Set Carrier)
    apply normalizes_outerCore_of_commutator
    · apply firstParabolic_normalizes_quaternionCore m
      change M12SmallPair.FirstCore.secondSwap ∈ firstParabolic.comap m.embedding
      rw [firstParabolic_comap m]
      exact M12SmallPair.FirstCore.secondSwap_mem
    · rw [map_secondSwap, swap_swap_commutator]
      exact quaternionCore.pow_mem quaternion_marks_mem.2.2.1 2

theorem quaternionCore_normal_firstParabolic (m : InnerModel) :
    (quaternionCore.subgroupOf firstParabolic).Normal :=
  (normal_subgroupOf_iff_le_normalizer (quaternionCore_le_firstParabolic m)).mpr
    (firstParabolic_normalizes_quaternionCore m)

theorem outerCore_normal_firstParabolic (m : InnerModel) :
    (outerCore.subgroupOf firstParabolic).Normal :=
  (normal_subgroupOf_iff_le_normalizer (outerCore_le_firstParabolic m)).mpr
    (firstParabolic_normalizes_outerCore m)

end Sporadic.Mathieu.M12ExceptionalExtension.FirstParabolic
