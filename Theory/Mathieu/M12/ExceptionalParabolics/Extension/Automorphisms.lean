module

public import Theory.Mathieu.M12.ExceptionalParabolics.Extension.Automorphisms.Restriction
public import Theory.Mathieu.M12.ExceptionalParabolics.Extension.Automorphisms.Action
public import Theory.Mathieu.M12.ExceptionalParabolics.Extension.Automorphisms.OrderBound

/-!
# The fixed degree-24 model of the full automorphism group of M₁₂

Restriction to the marked block constructs the original Witt-design M₁₂
inside the literal ATLAS carrier. The kernel-checked finite order certificate
proves this restriction faithful and the inner subgroup of index two.
Conjugation is faithful and covers the full abstract automorphism group,
using the independently proved outer-index bound. Both original generators
and every inner automorphism are preserved by the resulting identifications.

This supplies the ambient automorphism model for the exceptional amalgam;
the source's local parabolic calculations are separate results.
Source: ATLAS M12d2G1-p24B0; Aschbacher–Smith F.1.12(I)(13), printed p.263.
-/

public section
namespace Sporadic.Mathieu.M12ExceptionalExtension

/-- Once the literal carrier's order bound is certified, both the marked inner
model and the full automorphism equivalence follow, with the original inner
automorphisms preserved exactly. -/
theorem automorphismIdentification_of_carrier_bound
    (hbound : Nat.card Carrier ≤ 190080) :
    ∃ m : InnerModel, ∃ e : Carrier ≃* MulAut M12,
      ∀ g : M12, e (m.embedding g) = MulAut.conj g := by
  let m := innerModelOfCarrierBound hbound
  exact ⟨m, m.automorphismEquiv, m.automorphismEquiv_embedding⟩

/-- Restriction to the marked block is a faithful, surjective comparison with
the original Witt-design M₁₂. -/
theorem blockRestriction_bijective : Function.Bijective blockRestriction :=
  blockRestriction_bijective_of_carrier_bound carrier_order_le

/-- The actual marked inner model, with the finite order premise discharged. -/
noncomputable def innerModel : InnerModel :=
  innerModelOfCarrierBound carrier_order_le

/-- The literal subgroup generated by the two fixed lifts has index two. -/
theorem inner_index : inner.index = 2 := innerModel.index

/-- The fixed degree-24 carrier has order 190080. -/
theorem carrier_order : Nat.card Carrier = 190080 := innerModel.card_carrier

/-- The literal carrier is the full automorphism group of the Witt-design M₁₂. -/
noncomputable def automorphismEquiv : Carrier ≃* MulAut M12 :=
  innerModel.automorphismEquiv

/-- Every abstract automorphism is induced by an element of the fixed carrier. -/
theorem automorphismEquiv_surjective : Function.Surjective automorphismEquiv :=
  automorphismEquiv.surjective

/-- The identification preserves every original inner automorphism. -/
theorem automorphismEquiv_embedding (g : M12) :
    automorphismEquiv (innerModel.embedding g) = MulAut.conj g :=
  innerModel.automorphismEquiv_embedding g

/-- The first literal lift induces conjugation by the exact original generator. -/
theorem automorphismEquiv_innerA :
    automorphismEquiv innerA = MulAut.conj originalA := by
  rw [← innerModel.embedding_originalA, automorphismEquiv_embedding]

/-- The second literal lift induces conjugation by the exact original generator. -/
theorem automorphismEquiv_innerB :
    automorphismEquiv innerB = MulAut.conj originalB := by
  rw [← innerModel.embedding_originalB, automorphismEquiv_embedding]

/-- Unconditional full automorphism identification with the marked inner model. -/
theorem automorphismIdentification :
    ∃ m : InnerModel, ∃ e : Carrier ≃* MulAut M12,
      ∀ g : M12, e (m.embedding g) = MulAut.conj g :=
  ⟨innerModel, automorphismEquiv, automorphismEquiv_embedding⟩

end Sporadic.Mathieu.M12ExceptionalExtension
