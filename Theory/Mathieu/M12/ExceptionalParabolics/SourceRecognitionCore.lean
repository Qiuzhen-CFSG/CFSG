module

public import Theory.Mathieu.M12.ExceptionalParabolics.SecondCore
public import Theory.GroupTheory.ThreeInvolutionFourCommutators.Structure

/-!
# Source generators for the second M₁₂ parabolic core

Three explicit involutions generate the actual second parabolic two-core.
Their pairwise commutators are the three nonidentity elements of the marked
natural four. The abstract three-involution order theorem makes their subgroup
have order thirty-two, so the existing core order proves generation.

These are concrete coordinates for the group generated by the radius-three
labels in Goldschmidt, *Automorphisms of trivalent graphs* (1980), (6.12),
pp.405–406. The final recognition theorem identifies any source triple with
these relations with the actual two-core; extension recognition is separate.
-/

public section
noncomputable section
namespace Sporadic.Mathieu.M12SmallPair.ExceptionalParabolics.SourceRecognition
open Subgroup
open scoped commutatorElement

abbrev SecondCore := pCore 2 secondParabolic

private theorem mem_core_of_commutes {g : M12}
    (hz : Commute g M12SmallPair.z) (hv : Commute g v) :
    ∃ hg : g ∈ secondParabolic, (⟨g, hg⟩ : secondParabolic) ∈ SecondCore := by
  have hc : g ∈ centralizer (natural : Set M12) := by
    intro w hw
    rcases (mem_natural w).mp hw with rfl | rfl | rfl | rfl
    · simp
    · exact hz.symm.eq
    · exact hv.symm.eq
    · exact (hz.mul_right hv).symm.eq
  exact ⟨centralizer_le_normalizer _ hc,
    (secondCore_mem_iff_centralizes _).mpr hc⟩

private def coreElement (g : M12) (hz : Commute g M12SmallPair.z)
    (hv : Commute g v) : SecondCore :=
  ⟨⟨g, (mem_core_of_commutes hz hv).choose⟩,
    (mem_core_of_commutes hz hv).choose_spec⟩

/-- First source involution in the actual second two-core. -/
def coreX : SecondCore := coreElement (leftI * rightI) (by unfold Commute SemiconjBy; decide +kernel) (by unfold Commute SemiconjBy; decide +kernel)

/-- Second source involution in the actual second two-core. -/
def coreY : SecondCore := coreElement (leftI * leftJ * rightI)
  (by unfold Commute SemiconjBy; decide +kernel) (by unfold Commute SemiconjBy; decide +kernel)

/-- Third source involution in the actual second two-core. -/
def coreZ : SecondCore := coreElement (rightI * movingActor * leftI * movingActor)
  (by unfold Commute SemiconjBy; decide +kernel) (by unfold Commute SemiconjBy; decide +kernel)

/-- The first central commutator is the distinguished involution. -/
def coreA : SecondCore := coreElement M12SmallPair.z (Commute.refl _) z_v_commute

/-- The second central commutator is the other marked point of the natural four. -/
def coreB : SecondCore := coreElement v z_v_commute.symm (Commute.refl _)

/-- The concrete permutation value of the first marked involution. -/
@[simp] theorem coreX_val : (coreX.val : M12) = leftI * rightI := by rfl
/-- The concrete permutation value of the second marked involution. -/
@[simp] theorem coreY_val : (coreY.val : M12) = leftI * leftJ * rightI := by rfl
/-- The concrete permutation value of the third marked involution. -/
@[simp] theorem coreZ_val : (coreZ.val : M12) = rightI * movingActor * leftI * movingActor := by rfl
/-- The concrete permutation value of the first central commutator. -/
@[simp] theorem coreA_val : (coreA.val : M12) = M12SmallPair.z := by rfl
/-- The concrete permutation value of the second central commutator. -/
@[simp] theorem coreB_val : (coreB.val : M12) = v := by rfl

/-- Literal model realization of the source three-involution relations. -/
theorem core_relations :
    ThreeInvolutionFourCommutators.Relations coreX coreY coreZ coreA coreB where
  x_sq := by apply Subtype.ext; apply Subtype.ext; decide +kernel
  y_sq := by apply Subtype.ext; apply Subtype.ext; decide +kernel
  z_sq := by apply Subtype.ext; apply Subtype.ext; decide +kernel
  a_order := by apply orderOf_eq_prime <;> decide +kernel
  b_order := by apply orderOf_eq_prime <;> decide +kernel
  a_ne_b := by decide +kernel
  xy := by apply Subtype.ext; apply Subtype.ext; decide +kernel
  xz := by apply Subtype.ext; apply Subtype.ext; decide +kernel
  yz := by apply Subtype.ext; apply Subtype.ext; decide +kernel
  bx := by change coreB * coreX = coreX * coreB; apply Subtype.ext; apply Subtype.ext; decide +kernel
  by_ := by change coreB * coreY = coreY * coreB; apply Subtype.ext; apply Subtype.ext; decide +kernel
  bz := by change coreB * coreZ = coreZ * coreB; apply Subtype.ext; apply Subtype.ext; decide +kernel

/-- The source relations account for the whole concrete second core. -/
theorem core_generation : closure ({coreX, coreY, coreZ} : Set SecondCore) = ⊤ := by
  apply eq_top_of_card_eq
  exact core_relations.card.trans secondCore_card.symm

/-- An intrinsic source triple gives an equivalence with the concrete core.
No endpoint or core isomorphism is among the assumptions. -/
theorem secondCore_equiv_of_relations {G : Type*} [Group G]
    (x y z a b : G) (r : ThreeInvolutionFourCommutators.Relations x y z a b) :
    Nonempty (closure ({x,y,z} : Set G) ≃* SecondCore) := by
  obtain ⟨e, _, _, _⟩ := r.equiv_closure core_relations
  exact ⟨e.trans ((MulEquiv.subgroupCongr core_generation).trans (Subgroup.topEquiv))⟩

end Sporadic.Mathieu.M12SmallPair.ExceptionalParabolics.SourceRecognition
