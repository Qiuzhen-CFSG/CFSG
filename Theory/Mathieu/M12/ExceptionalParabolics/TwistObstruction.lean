module
public import Theory.Mathieu.M12.ExceptionalParabolics
public import Theory.Mathieu.M12.SmallParabolicPair.ElementaryNormalizerCover
public import Theory.GroupTheory.Amalgam.SylowRigidity

/-!
# The elementary-eight obstruction to a faithful M₁₂ twist

The elementary eight generated by z, v and leftI * rightI is normal in the
first marked parabolic. The checked classification of normal elementary
subgroups of the common Sylow group shows that an overlap automorphism maps
this eight either to itself or to the marked eight normal in the second
parabolic. The latter possibility gives a nontrivial common normal subgroup
of the twisted amalgam. Hence every faithful twist preserves the first eight.

Normalization is checked on the three existing Sylow generators and the cubic
actor. The orders 64 and 3 show that these generate the first parabolic of
order 192. This avoids enumerating its whole automorphism group. The remaining
extension of an eight-preserving overlap automorphism to that endpoint is a
separate obligation, consumed by the Chapter F MathieuTwelve rigidity module.

Sources: the marked permutations and finite Sylow coordinates in
`SmallParabolicPair` and `Properties.SylowAutomorphismGroup.Coordinates`;
Aschbacher--Smith, F.1.11--12, printed pp.262--263, and 14.2.21, p.988.
No Fan--Goldschmidt classification or uniqueness statement is assumed here.
-/

@[expose] public section
noncomputable section
namespace Sporadic.Mathieu.M12SmallPair.ExceptionalParabolics.TwistObstruction
open Subgroup Theory.GroupTheory RankTwoAmalgam SylowAutomorphismGroup
open scoped IsMulCommutative
set_option maxRecDepth 1000000
-- Bound simultaneous kernel reductions of the small permutation certificates.
set_option Elab.async false

def leftEightEmbedding : ElementaryCoordinates →* M12 where
  toFun x := z ^ (x.toAdd 0).val * v ^ (x.toAdd 1).val *
    (leftI * rightI) ^ (x.toAdd 2).val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

def leftEight : Subgroup M12 := leftEightEmbedding.range

theorem leftEightEmbedding_injective : Function.Injective leftEightEmbedding := by
  decide +kernel

def leftEightEquiv : ElementaryCoordinates ≃* leftEight :=
  MonoidHom.ofInjective leftEightEmbedding_injective

theorem card_leftEight : Nat.card leftEight = 8 := by
  rw [← Nat.card_congr leftEightEquiv.toEquiv, Nat.card_eq_fintype_card]
  decide +kernel

instance leftEight_elementary : IsElementaryAbelian 2 leftEight where
  is_comm := ⟨by
    intro x y
    obtain ⟨a, rfl⟩ := leftEightEquiv.surjective x
    obtain ⟨b, rfl⟩ := leftEightEquiv.surjective y
    rw [← map_mul, ← map_mul, mul_comm]⟩
  exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (by
    intro x
    obtain ⟨a, rfl⟩ := leftEightEquiv.surjective x
    rw [← map_pow]
    have h : ∀ a : ElementaryCoordinates, a ^ 2 = 1 := by decide +kernel
    rw [h, map_one])

theorem leftEight_le_sylow : leftEight ≤ sylowCandidate := by
  rintro x ⟨a, rfl⟩
  have h : ∀ a : ElementaryCoordinates, leftEightEmbedding a ∈ sylowCandidate := by
    intro a
    rw [SylowEnumeration.mem_sylowCandidate_iff]
    revert a
    decide +kernel
  exact h a

theorem sylow_normalizes_leftEight : sylowCandidate ≤ normalizer (leftEight : Set M12) := by
  have hg (j : Fin 3) : (generator j : M12) ∈ normalizer (leftEight : Set M12) := by
    apply mem_normalizer_fintype
    rintro x ⟨a, rfl⟩
    have chk : ∀ j : Fin 3, ∀ a : ElementaryCoordinates,
        ∃ b : ElementaryCoordinates,
          (generator j : M12) * leftEightEmbedding a * (generator j : M12)⁻¹ =
            leftEightEmbedding b := by decide +kernel
    obtain ⟨b, hb⟩ := chk j a
    exact ⟨b, hb.symm⟩
  have hw (w : List (Fin 3)) :
      (evaluate w : M12) ∈ normalizer (leftEight : Set M12) := by
    induction w with
    | nil => exact one_mem _
    | cons j w ih => exact mul_mem (hg j) ih
  intro s hs
  obtain ⟨i, hi⟩ := element_surjective ⟨s, hs⟩
  have he : (element i : M12) = s := congrArg Subtype.val hi
  exact he ▸ (show (element i : M12) ∈ normalizer (leftEight : Set M12) from hw (words i))

theorem cubic_normalizes_leftEight : cubicActor ∈ normalizer (leftEight : Set M12) := by
  apply mem_normalizer_fintype
  rintro x ⟨a, rfl⟩
  have chk : ∀ a : ElementaryCoordinates, ∃ b : ElementaryCoordinates,
      cubicActor * leftEightEmbedding a * cubicActor⁻¹ = leftEightEmbedding b := by
    decide +kernel
  obtain ⟨b, hb⟩ := chk a
  exact ⟨b, hb.symm⟩

theorem sylow_cubic_generate_first : sylowCandidate ⊔ zpowers cubicActor = firstParabolic := by
  have hle : sylowCandidate ⊔ zpowers cubicActor ≤ firstParabolic :=
    sup_le inf_le_left (zpowers_le.mpr cubicActor_mem)
  apply eq_of_le_of_card_ge hle
  have h64 := card_dvd_of_le (show sylowCandidate ≤ sylowCandidate ⊔ zpowers cubicActor
    from le_sup_left)
  have h3 := card_dvd_of_le (show zpowers cubicActor ≤ sylowCandidate ⊔ zpowers cubicActor
    from le_sup_right)
  rw [card_sylowCandidate] at h64
  rw [Nat.card_zpowers, cubicActor_order] at h3
  have hd := Nat.lcm_dvd h64 h3
  norm_num at hd
  rw [card_firstParabolic]
  exact Nat.le_of_dvd Nat.card_pos hd

theorem first_normalizes_leftEight : firstParabolic ≤ normalizer (leftEight : Set M12) := by
  rw [← sylow_cubic_generate_first]
  exact sup_le sylow_normalizes_leftEight (zpowers_le.mpr cubic_normalizes_leftEight)

instance leftEight_normal_first : (leftEight.subgroupOf firstParabolic).Normal :=
  (normal_subgroupOf_iff_le_normalizer (leftEight_le_sylow.trans inf_le_left)).mpr
    first_normalizes_leftEight

theorem leftEight_ne_elementary : leftEight ≠ elementary := by
  intro h
  have hx : leftI * rightI ∈ leftEight :=
    ⟨Multiplicative.ofAdd ![0,0,1], by decide +kernel⟩
  rw [h, elementary_eq_range] at hx
  have chk : ∀ a : ElementaryCoordinates, elementaryEmbedding a ≠ leftI * rightI := by
    decide +kernel
  obtain ⟨a, ha⟩ := hx
  exact chk a ha

theorem leftEight_eq_pure : leftEight = EvenLocal.pureElementary := by
  have hne : leftEight ≠ ⊥ := by
    intro h
    have hc := card_leftEight
    simp [h] at hc
  rcases EvenLocal.normal_elementary_cases leftEight leftEight_le_sylow hne
      sylow_normalizes_leftEight with h | h | h | h
  · have hc := card_leftEight
    rw [h, card_distinguished] at hc
    omega
  · have hc := card_leftEight
    rw [h, card_natural] at hc
    omega
  · exact h
  · exact (leftEight_ne_elementary h).elim

def overlapEight : Subgroup sylowCandidate := leftEight.subgroupOf sylowCandidate

theorem card_overlapEight : Nat.card overlapEight = 8 := by
  rw [overlapEight, Nat.card_congr (subgroupOfEquivOfLe leftEight_le_sylow).toEquiv, card_leftEight]

instance overlapEight_elementary : IsElementaryAbelian 2 overlapEight :=
  IsElementaryAbelian.subgroupOf leftEight_le_sylow

instance overlapEight_normal : overlapEight.Normal :=
  (normal_subgroupOf_iff_le_normalizer leftEight_le_sylow).mpr sylow_normalizes_leftEight

def imageEight (d : MulAut sylowCandidate) : Subgroup M12 :=
  (overlapEight.map d.toMonoidHom).map sylowCandidate.subtype

theorem imageEight_le_sylow (d : MulAut sylowCandidate) : imageEight d ≤ sylowCandidate :=
  map_subtype_le _

theorem card_imageEight (d : MulAut sylowCandidate) : Nat.card (imageEight d) = 8 := by
  rw [imageEight, card_map_of_injective sylowCandidate.subtype_injective,
    card_map_of_injective d.injective, card_overlapEight]

instance imageEight_elementary (d : MulAut sylowCandidate) :
    IsElementaryAbelian 2 (imageEight d) := by
  let : IsElementaryAbelian 2 (overlapEight.map d.toMonoidHom) :=
    IsElementaryAbelian.map d.toMonoidHom
  exact IsElementaryAbelian.map sylowCandidate.subtype

theorem imageEight_normalized (d : MulAut sylowCandidate) :
    sylowCandidate ≤ normalizer (imageEight d : Set M12) := by
  apply (normal_subgroupOf_iff_le_normalizer (imageEight_le_sylow d)).mp
  have he : (imageEight d).subgroupOf sylowCandidate = overlapEight.map d.toMonoidHom := by
    apply Subgroup.map_injective sylowCandidate.subtype_injective
    exact map_subgroupOf_eq_of_le (imageEight_le_sylow d)
  rw [he]
  exact Normal.map inferInstance d.toMonoidHom d.surjective

/-- An overlap automorphism can only preserve or interchange the two marked eights. -/
theorem imageEight_cases (d : MulAut sylowCandidate) :
    imageEight d = leftEight ∨ imageEight d = elementary := by
  have hne : imageEight d ≠ ⊥ := by
    intro h
    have hc := card_imageEight d
    simp [h] at hc
  rcases EvenLocal.normal_elementary_cases (imageEight d) (imageEight_le_sylow d)
      hne (imageEight_normalized d) with h | h | h | h
  · have hc := card_imageEight d
    rw [h, card_distinguished] at hc
    omega
  · have hc := card_imageEight d
    rw [h, card_natural] at hc
    omega
  · exact Or.inl (h.trans leftEight_eq_pure.symm)
  · exact Or.inr h

theorem overlapEight_left_image : overlapEight.map amalgam.left =
    leftEight.subgroupOf firstParabolic := by
  apply Subgroup.map_injective firstParabolic.subtype_injective
  rw [map_map, map_subgroupOf_eq_of_le (leftEight_le_sylow.trans inf_le_left)]
  exact map_subgroupOf_eq_of_le leftEight_le_sylow

theorem overlapEight_right_image (d : MulAut sylowCandidate) :
    overlapEight.map (twistRight amalgam d).right =
      (imageEight d).subgroupOf secondParabolic := by
  apply Subgroup.map_injective secondParabolic.subtype_injective
  rw [map_subgroupOf_eq_of_le ((imageEight_le_sylow d).trans inf_le_right)]
  simp only [twistRight, map_map, imageEight]
  rfl

/-- Mapping the first endpoint's normal eight onto the second one's destroys faithfulness. -/
theorem not_faithful_of_imageEight_eq (d : MulAut sylowCandidate)
    (h : imageEight d = elementary) : ¬ Faithful (twistRight amalgam d) := by
  intro hf
  have hL : (overlapEight.map (twistRight amalgam d).left).Normal := by
    change (overlapEight.map amalgam.left).Normal
    rw [overlapEight_left_image]
    infer_instance
  have hR : (overlapEight.map (twistRight amalgam d).right).Normal := by
    rw [overlapEight_right_image, h]
    infer_instance
  have he := hf overlapEight hL hR
  have hc := card_overlapEight
  simp [he] at hc

/-- The faithfulness hypothesis forces stabilization of the specific first normal eight. -/
theorem preserves_overlapEight_of_faithful (d : MulAut sylowCandidate)
    (hf : Faithful (twistRight amalgam d)) :
    overlapEight.map d.toMonoidHom = overlapEight := by
  have h := (imageEight_cases d).resolve_right (fun h => not_faithful_of_imageEight_eq d h hf)
  apply Subgroup.map_injective sylowCandidate.subtype_injective
  change imageEight d = overlapEight.map sylowCandidate.subtype
  rw [h, overlapEight, map_subgroupOf_eq_of_le leftEight_le_sylow]

end Sporadic.Mathieu.M12SmallPair.ExceptionalParabolics.TwistObstruction
