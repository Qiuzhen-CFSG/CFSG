module
public import Theory.Alternating.theorem_5_2_1_2
public import Theory.GroupTheory.BinaryCollection
public import Mathlib.GroupTheory.Coset.Card
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# A cardinal bound for the first exceptional M₁₂ endpoint

The three commuting involutions `e`, `f`, and `z` generate a subgroup of
order at most eight. The prescribed conjugation formulas make it normal
in the group generated by all six marked elements. Modulo this subgroup,
`A`, `B`, and `C` satisfy the type-A₃ Coxeter relations, giving a quotient
of order at most 24 and hence the bound 192.

Source: Goldschmidt, “Automorphisms of trivalent graphs” (1980), (6.12.6)
and the following identification paragraph, p.405; compare the model (3.8),
p.390. This is the first endpoint of Aschbacher–Smith F.1.12(I)(12).
-/

public section
namespace Sporadic.Mathieu.M12SmallPair.ExceptionalParabolics.SourceRecognition
open Subgroup
variable {G H : Type*} [Group G] [Group H]

structure FirstRelations (e f A B C z : G) : Prop where
  e_sq : e ^ 2 = 1
  f_sq : f ^ 2 = 1
  A_sq : A ^ 2 = 1
  B_sq : B ^ 2 = 1
  C_sq : C ^ 2 = 1
  z_sq : z ^ 2 = 1
  ef : Commute e f
  ze : Commute z e
  zf : Commute z f
  zA : Commute z A
  zB : Commute z B
  zC : Commute z C
  AB : (A * B) ^ 3 = 1
  BC : (B * C) ^ 3 = 1
  AC : (A * C) ^ 2 = z
  Ae : A * e * A⁻¹ = f
  Af : A * f * A⁻¹ = e
  Be : B * e * B⁻¹ = e
  Bf : B * f * B⁻¹ = e * f
  Ce : C * e * C⁻¹ = z * f
  Cf : C * f * C⁻¹ = z * e

private theorem binary_product_mem (l : List G) (n : ℕ) :
    Theory.GroupTheory.BinaryCollection.product l n ∈ closure {x | x ∈ l} := by
  induction l generalizing n with
  | nil => exact (Subgroup.closure _).one_mem
  | cons a l ih =>
    exact (Subgroup.closure _).mul_mem
      ((Subgroup.closure _).pow_mem (subset_closure (by simp)) _)
      ((Subgroup.closure_mono (by intro x hx; exact List.mem_cons_of_mem a hx)) (ih _))

private theorem core_card_le (e f z : G)
    (he : e ^ 2 = 1) (hf : f ^ 2 = 1) (hz : z ^ 2 = 1)
    (hef : Commute e f) (hze : Commute z e) (hzf : Commute z f) :
    Nat.card (closure ({e,f,z} : Set G)) ≤ 8 := by
  let l := [e,f,z]
  have ht : Theory.GroupTheory.BinaryCollection.triangular l := by
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, trivial⟩
    · rw [← pow_two, he]
      exact one_mem _
    · intro b hb
      simp at hb
      rcases hb with hbf | hbz
      · rw [hbf, hef.inv_mul_cancel]
        exact subset_closure (by simp)
      · rw [hbz, hze.symm.inv_mul_cancel]
        exact subset_closure (by simp)
    · rw [← pow_two, hf]
      exact one_mem _
    · intro b hb
      simp at hb
      subst b
      have hh : f⁻¹ * z * f = z := hzf.symm.inv_mul_cancel
      rw [hh]
      exact subset_closure (by simp)
    · rw [← pow_two, hz]
      exact one_mem _
    · simp
  have hset : {x : G | x ∈ l} = ({e,f,z} : Set G) := by
    ext x
    simp [l]
  let q : Fin 8 → closure ({e,f,z} : Set G) := fun n =>
    ⟨Theory.GroupTheory.BinaryCollection.product l n,
      by rw [← hset]; exact binary_product_mem l n⟩
  have hq : Function.Surjective q := by
    intro x
    obtain ⟨n, hn, heq⟩ := Theory.GroupTheory.BinaryCollection.cover l ht x.val
      (by rw [hset]; exact x.property)
    exact ⟨⟨n, by simpa [l] using hn⟩, Subtype.ext heq⟩
  simpa only [Nat.card_fin] using Nat.card_le_card_of_surjective q hq

private theorem core_normal [Finite G] {e f A B C z : G}
    (h : FirstRelations e f A B C z)
    (hg : closure ({e,f,A,B,C,z} : Set G) = ⊤) :
    (closure ({e,f,z} : Set G)).Normal := by
  let N := closure ({e,f,z} : Set G)
  have he : e ∈ N := subset_closure (by simp)
  have hf : f ∈ N := subset_closure (by simp)
  have hz : z ∈ N := subset_closure (by simp)
  have ha : A ∈ normalizer N := by
    apply mem_normalizer_fintype
    intro x hx
    have hle : N ≤ N.comap (MulAut.conj A).toMonoidHom := by
      apply (closure_le _).mpr
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hxe | hxf | hxz
      · rw [hxe]
        change A * e * A⁻¹ ∈ N
        rw [h.Ae]
        exact hf
      · rw [hxf]
        change A * f * A⁻¹ ∈ N
        rw [h.Af]
        exact he
      · rw [hxz]
        change A * z * A⁻¹ ∈ N
        simpa only [h.zA.symm.eq, mul_assoc, mul_inv_cancel, mul_one] using hz
    exact hle hx
  have hb : B ∈ normalizer N := by
    apply mem_normalizer_fintype
    intro x hx
    have hle : N ≤ N.comap (MulAut.conj B).toMonoidHom := by
      apply (closure_le _).mpr
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hxe | hxf | hxz
      · rw [hxe]
        change B * e * B⁻¹ ∈ N
        rw [h.Be]
        exact he
      · rw [hxf]
        change B * f * B⁻¹ ∈ N
        rw [h.Bf]
        exact N.mul_mem he hf
      · rw [hxz]
        change B * z * B⁻¹ ∈ N
        simpa only [h.zB.symm.eq, mul_assoc, mul_inv_cancel, mul_one] using hz
    exact hle hx
  have hc : C ∈ normalizer N := by
    apply mem_normalizer_fintype
    intro x hx
    have hle : N ≤ N.comap (MulAut.conj C).toMonoidHom := by
      apply (closure_le _).mpr
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hxe | hxf | hxz
      · rw [hxe]
        change C * e * C⁻¹ ∈ N
        rw [h.Ce]
        exact N.mul_mem hz hf
      · rw [hxf]
        change C * f * C⁻¹ ∈ N
        rw [h.Cf]
        exact N.mul_mem hz he
      · rw [hxz]
        change C * z * C⁻¹ ∈ N
        simpa only [h.zC.symm.eq, mul_assoc, mul_inv_cancel, mul_one] using hz
    exact hle hx
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← hg]
  apply (closure_le _).mpr
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with hxe | hxf | hxA | hxB | hxC | hxz
  · rw [hxe]; exact N.le_normalizer he
  · rw [hxf]; exact N.le_normalizer hf
  · rw [hxA]; exact ha
  · rw [hxB]; exact hb
  · rw [hxC]; exact hc
  · rw [hxz]; exact N.le_normalizer hz



open GLS3.Chapter5.SchurPresentation

private theorem coxeter_finite : Finite (CoxeterMatrix.A 3).Group :=
  TypeANormalForm.group_finite 3

private theorem coxeter_card_le : Nat.card (CoxeterMatrix.A 3).Group ≤ 24 :=
  TypeANormalForm.natCard_group_le_factorial 3


private theorem finite_and_card_le_of_liftable (f : Fin 3 → G)
    (hf : (CoxeterMatrix.A 3).IsLiftable f)
    (hgen : closure (Set.range f) = ⊤) : Finite G ∧ Nat.card G ≤ 24 := by
  let p : (CoxeterMatrix.A 3).Group →* G :=
    (CoxeterMatrix.A 3).toCoxeterSystem.lift ⟨f, hf⟩
  have hp (i : Fin 3) : p ((CoxeterMatrix.A 3).simple i) = f i :=
    (CoxeterMatrix.A 3).toCoxeterSystem.lift_apply_simple hf i
  have hsurj : Function.Surjective p := by
    apply MonoidHom.range_eq_top.mp
    apply top_unique
    rw [← hgen]
    apply (closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨(CoxeterMatrix.A 3).simple i, hp i⟩
  let : Finite (CoxeterMatrix.A 3).Group := coxeter_finite
  exact ⟨Finite.of_surjective p hsurj,
    (Nat.card_le_card_of_surjective p hsurj).trans coxeter_card_le⟩

private theorem card_le_of_three_involutions (a b c : G)
    (ha : a ^ 2 = 1) (hb : b ^ 2 = 1) (hc : c ^ 2 = 1)
    (hab : (a * b) ^ 3 = 1) (hbc : (b * c) ^ 3 = 1) (hac : Commute a c)
    (hgen : closure ({a, b, c} : Set G) = ⊤) : Nat.card G ≤ 24 := by
  let f : Fin 3 → G := ![a,b,c]
  have hba : (b * a) ^ 3 = 1 := by
    have hh := congrArg (fun x => a⁻¹ * x * a) hab
    simpa [pow_succ, mul_assoc] using hh
  have hcb : (c * b) ^ 3 = 1 := by
    have hh := congrArg (fun x => b⁻¹ * x * b) hbc
    simpa [pow_succ, mul_assoc] using hh
  have hac2 : (a * c) ^ 2 = 1 := by rw [hac.mul_pow, ha, hc, one_mul]
  have hca2 : (c * a) ^ 2 = 1 := by rw [hac.symm.mul_pow, hc, ha, one_mul]
  have hf : (CoxeterMatrix.A 3).IsLiftable f := by
    intro i j
    fin_cases i <;> fin_cases j <;>
      simpa [CoxeterMatrix.A, f, ← pow_two] using
        (by first | exact ha | exact hb | exact hc | exact hab | exact hba |
          exact hbc | exact hcb | exact hac2 | exact hca2)
  have hrange : Set.range f = ({a,b,c} : Set G) := by
    ext x
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp [f]
    · rintro (rfl | rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
      · exact ⟨2, rfl⟩
  exact (finite_and_card_le_of_liftable f hf (by simpa only [hrange] using hgen)).2


private theorem card_le_of_top [Finite G] {e f A B C z : G}
    (h : FirstRelations e f A B C z)
    (hg : closure ({e,f,A,B,C,z} : Set G) = ⊤) : Nat.card G ≤ 192 := by
  let N := closure ({e,f,z} : Set G)
  let _ : N.Normal := core_normal h hg
  let q := QuotientGroup.mk' N
  have qe : q e = 1 := (QuotientGroup.eq_one_iff e).mpr (subset_closure (by simp))
  have qf : q f = 1 := (QuotientGroup.eq_one_iff f).mpr (subset_closure (by simp))
  have qz : q z = 1 := (QuotientGroup.eq_one_iff z).mpr (subset_closure (by simp))
  have qA : (q A)^2 = 1 := by rw [← map_pow, h.A_sq, map_one]
  have qB : (q B)^2 = 1 := by rw [← map_pow, h.B_sq, map_one]
  have qC : (q C)^2 = 1 := by rw [← map_pow, h.C_sq, map_one]
  have qAB : (q A * q B)^3 = 1 := by rw [← map_mul, ← map_pow, h.AB, map_one]
  have qBC : (q B * q C)^3 = 1 := by rw [← map_mul, ← map_pow, h.BC, map_one]
  have qAC : (q A * q C)^2 = 1 := by rw [← map_mul, ← map_pow, h.AC, qz]
  have hc : Commute (q A) (q C) := by
    change q A * q C = q C * q A
    have hiA : (q A)⁻¹ = q A := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using qA)
    have hiC : (q C)⁻¹ = q C := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using qC)
    have hiAC : (q A * q C)⁻¹ = q A * q C := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using qAC)
    simpa only [mul_inv_rev, hiA, hiC] using hiAC.symm
  have hqgen : closure ({q A,q B,q C} : Set (G ⧸ N)) = ⊤ := by
    apply (eq_top_iff' _).mpr
    intro x
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N x
    have hgmem : g ∈ closure ({e,f,A,B,C,z} : Set G) := hg ▸ mem_top g
    refine closure_induction (p := fun a _ => q a ∈ closure ({q A,q B,q C} : Set (G ⧸ N))) ?_ ?_ ?_ ?_ hgmem
    · rintro a (rfl | rfl | rfl | rfl | rfl | rfl)
      · rw [qe]; exact one_mem _
      · rw [qf]; exact one_mem _
      · exact subset_closure (by simp)
      · exact subset_closure (by simp)
      · exact subset_closure (by simp)
      · rw [qz]; exact one_mem _
    · rw [map_one]; exact one_mem _
    · intro a b _ _ ha hb
      rw [map_mul]
      exact mul_mem ha hb
    · intro a _ ha
      rw [map_inv]
      exact inv_mem ha
  have hquot := card_le_of_three_involutions (q A) (q B) (q C) qA qB qC qAB qBC hc hqgen
  have hcore := core_card_le e f z h.e_sq h.f_sq h.z_sq h.ef h.ze h.zf
  calc
    Nat.card G = Nat.card (G ⧸ N) * Nat.card N := card_eq_card_quotient_mul_card_subgroup N
    _ ≤ 24 * 8 := Nat.mul_le_mul hquot hcore
    _ = 192 := rfl

/-- The compact first exceptional parabolic relations give at most 192 elements. -/
theorem FirstRelations.card_le [Finite G] {e f A B C z : G}
    (h : FirstRelations e f A B C z) :
    Nat.card (closure ({e,f,A,B,C,z} : Set G)) ≤ 192 := by
  let K := closure ({e,f,A,B,C,z} : Set G)
  let ee : K := ⟨e, subset_closure (by simp)⟩
  let ff : K := ⟨f, subset_closure (by simp)⟩
  let AA : K := ⟨A, subset_closure (by simp)⟩
  let BB : K := ⟨B, subset_closure (by simp)⟩
  let CC : K := ⟨C, subset_closure (by simp)⟩
  let zz : K := ⟨z, subset_closure (by simp)⟩
  have hh : FirstRelations ee ff AA BB CC zz := {
    e_sq := by
      change ee ^ 2 = 1
      apply Subtype.ext
      change e ^ 2 = 1
      exact h.e_sq
    f_sq := by
      change ff ^ 2 = 1
      apply Subtype.ext
      change f ^ 2 = 1
      exact h.f_sq
    A_sq := by
      change AA ^ 2 = 1
      apply Subtype.ext
      change A ^ 2 = 1
      exact h.A_sq
    B_sq := by
      change BB ^ 2 = 1
      apply Subtype.ext
      change B ^ 2 = 1
      exact h.B_sq
    C_sq := by
      change CC ^ 2 = 1
      apply Subtype.ext
      change C ^ 2 = 1
      exact h.C_sq
    z_sq := by
      change zz ^ 2 = 1
      apply Subtype.ext
      change z ^ 2 = 1
      exact h.z_sq
    ef := by
      change ee * ff = ff * ee
      apply Subtype.ext
      change e * f = f * e
      exact h.ef.eq
    ze := by
      change zz * ee = ee * zz
      apply Subtype.ext
      change z * e = e * z
      exact h.ze.eq
    zf := by
      change zz * ff = ff * zz
      apply Subtype.ext
      change z * f = f * z
      exact h.zf.eq
    zA := by
      change zz * AA = AA * zz
      apply Subtype.ext
      change z * A = A * z
      exact h.zA.eq
    zB := by
      change zz * BB = BB * zz
      apply Subtype.ext
      change z * B = B * z
      exact h.zB.eq
    zC := by
      change zz * CC = CC * zz
      apply Subtype.ext
      change z * C = C * z
      exact h.zC.eq
    AB := by
      change (AA * BB) ^ 3 = 1
      apply Subtype.ext
      change (A * B) ^ 3 = 1
      exact h.AB
    BC := by
      change (BB * CC) ^ 3 = 1
      apply Subtype.ext
      change (B * C) ^ 3 = 1
      exact h.BC
    AC := by
      change (AA * CC) ^ 2 = zz
      apply Subtype.ext
      change (A * C) ^ 2 = z
      exact h.AC
    Ae := by
      change AA * ee * AA⁻¹ = ff
      apply Subtype.ext
      change A * e * A⁻¹ = f
      exact h.Ae
    Af := by
      change AA * ff * AA⁻¹ = ee
      apply Subtype.ext
      change A * f * A⁻¹ = e
      exact h.Af
    Be := by
      change BB * ee * BB⁻¹ = ee
      apply Subtype.ext
      change B * e * B⁻¹ = e
      exact h.Be
    Bf := by
      change BB * ff * BB⁻¹ = ee * ff
      apply Subtype.ext
      change B * f * B⁻¹ = e * f
      exact h.Bf
    Ce := by
      change CC * ee * CC⁻¹ = zz * ff
      apply Subtype.ext
      change C * e * C⁻¹ = z * f
      exact h.Ce
    Cf := by
      change CC * ff * CC⁻¹ = zz * ee
      apply Subtype.ext
      change C * f * C⁻¹ = z * e
      exact h.Cf
  }
  apply card_le_of_top hh
  apply Subgroup.map_injective K.subtype_injective
  rw [MonoidHom.map_closure]
  simp only [Set.image_insert_eq, Set.image_singleton, Subgroup.coe_subtype]
  rw [← MonoidHom.range_eq_map, range_subtype]

end Sporadic.Mathieu.M12SmallPair.ExceptionalParabolics.SourceRecognition
