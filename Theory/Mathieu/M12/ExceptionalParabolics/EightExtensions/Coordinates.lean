def step (i : Fin 192) (j : Fin 4) : Fin 192 := (stepTable[i.val]!)[j.val]!

private theorem point_step : ∀ i j x,
    point (step i j) x = point i (point (generatorIndex j) x) := by
  decide +kernel

theorem element_step (i : Fin 192) (j : Fin 4) :
    element (step i j) = element i * generator j := by
  rw [← element_generator j]
  apply Subtype.ext
  apply Subtype.ext
  apply Equiv.ext
  intro x
  change ((element (step i j) : M12) : Equiv.Perm (Fin 12)) x =
    ((element i : M12) : Equiv.Perm (Fin 12))
      (((element (generatorIndex j) : M12) : Equiv.Perm (Fin 12)) x)
  simp only [element_point, point_step]

def rightWord (i : Fin 192) : List (Fin 4) → Fin 192
  | [] => i
  | j :: w => rightWord (step i j) w

theorem element_rightWord (i : Fin 192) (w : List (Fin 4)) :
    element (rightWord i w) = element i * evaluate w := by
  induction w generalizing i with
  | nil => simp only [rightWord, evaluate, mul_one]
  | cons j w ih => rw [rightWord, ih, element_step, evaluate, mul_assoc]

