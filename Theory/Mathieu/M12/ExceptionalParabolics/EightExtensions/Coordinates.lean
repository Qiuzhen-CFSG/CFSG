set_option maxRecDepth 1000000
set_option Elab.async false

def embedding : sylowCandidate →* firstParabolic := Subgroup.inclusion inf_le_left

def generator (j : Fin 4) : firstParabolic :=
  if h : j.val < 3 then embedding (SylowAutomorphismGroup.generator ⟨j.val, h⟩)
  else ⟨cubicActor, cubicActor_mem⟩

