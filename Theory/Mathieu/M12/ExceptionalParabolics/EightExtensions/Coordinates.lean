private def decode (n : ℕ) : Fin 192 := decoderTable[n]!

private theorem decode_key : ∀ i, decode (key i) = i := by decide +kernel

theorem element_injective : Function.Injective element := by
  intro i j h
  have hp (x : Fin 12) : point i x = point j x := by
    rw [← element_point, ← element_point, h]
  have hk : key i = key j := by simp only [key, hp]
  exact (decode_key i).symm.trans ((congrArg decode hk).trans (decode_key j))

theorem element_surjective : Function.Surjective element :=
  ((Nat.bijective_iff_injective_and_card element).mpr
    ⟨element_injective, by rw [Nat.card_fin, card_firstParabolic]⟩).2

def equiv : Fin 192 ≃ firstParabolic := Equiv.ofBijective element
  ⟨element_injective, element_surjective⟩

theorem element_zero : element 0 = 1 := by decide +kernel

def overlapIndex (i : Fin 64) : Fin 192 := ⟨i.val, by omega⟩

theorem element_overlap : ∀ i : Fin 64,
    element (overlapIndex i) = embedding (SylowAutomorphismGroup.element i) := by
  decide +kernel

def generatorIndex (j : Fin 4) : Fin 192 := ![1,2,3,64] j

theorem element_generator : ∀ j, element (generatorIndex j) = generator j := by
  decide +kernel

