module

public import Theory.Mathieu.M12.ExceptionalParabolics
public import Theory.Mathieu.M12.ExceptionalParabolics.EightExtensions.Coordinates

/-!
# Faithful restriction for the first M₁₂ parabolic

An automorphism of the actual first parabolic fixing its marked Sylow subgroup
pointwise fixes the quaternion core. Its discrepancy on the cubic actor then
centralizes that core, so lies in the distinguished subgroup of order two.
The actor has order three, which removes the nontrivial discrepancy. The
existing word coordinates, generated by the Sylow subgroup and this actor,
give the identity on the entire parabolic.

Consequently a compatible automorphism of the marked amalgam is determined
by its second endpoint. This is the faithful-restriction argument in
Goldschmidt, Automorphisms of trivalent graphs, §3.8, used in the M₁₂ branch
of Aschbacher--Smith F.1.12. The literal parabolics and inclusions are retained.
-/

public section
noncomputable section

namespace Sporadic.Mathieu.M12SmallPair.ExceptionalParabolics.AmalgamAutomorphisms
open Subgroup Theory.GroupTheory
set_option maxRecDepth 1000000

private theorem fixes_first_cubic (f : MulAut firstParabolic)
    (hf : ∀ s : sylowCandidate, f (amalgam.left s) = amalgam.left s) :
    f ⟨cubicActor, cubicActor_mem⟩ = ⟨cubicActor, cubicActor_mem⟩ := by
  let a : firstParabolic := ⟨cubicActor, cubicActor_mem⟩
  have hfix (q : firstParabolic) (hq : (q : M12) ∈ core) : f q = q :=
    hf ⟨q, core_le_sylowCandidate hq⟩
  have hnorm : firstParabolic ≤ normalizer (core : Set M12) :=
    (normal_subgroupOf_iff_le_normalizer core_le_firstParabolic).mp inferInstance
  have hconj (q : firstParabolic) (hq : (q : M12) ∈ core) :
      f a * q * (f a)⁻¹ = a * q * a⁻¹ := by
    have hn : ((a * q * a⁻¹ : firstParabolic) : M12) ∈ core :=
      (mem_set_normalizer_iff.mp (hnorm a.property) q.val).mp hq
    have he := hfix (a * q * a⁻¹) hn
    simpa only [map_mul, map_inv, hfix q hq] using he
  have hc : ((a⁻¹ * f a : firstParabolic) : M12) ∈ centralizer (core : Set M12) := by
    intro q hq
    let q' : firstParabolic := ⟨q, core_le_firstParabolic hq⟩
    have he : (a⁻¹ * f a) * q' * (a⁻¹ * f a)⁻¹ = q' := by
      calc
        _ = a⁻¹ * (f a * q' * (f a)⁻¹) * a := by group
        _ = a⁻¹ * (a * q' * a⁻¹) * a := by rw [hconj q' hq]
        _ = q' := by group
    exact congrArg Subtype.val (mul_inv_eq_iff_eq_mul.mp he).symm
  have hd : ((a⁻¹ * f a : firstParabolic) : M12) ∈ distinguished := by
    rw [← firstParabolic_centralizer_core]
    exact ⟨(a⁻¹ * f a).property, hc⟩
  have hcore : ((a⁻¹ * f a : firstParabolic) : M12) ∈ core :=
    natural_le_core (distinguished_le_natural hd)
  have hz := (core_center_mem ⟨_, hcore⟩).mp
    (mem_center_iff.mpr (fun q => Subtype.ext (hc q q.property)))
  rcases hz with he | he
  · have he' : a⁻¹ * f a = 1 := Subtype.ext he
    exact (inv_mul_eq_one.mp he').symm
  · have he' : (f a : M12) = cubicActor * z := inv_mul_eq_iff_eq_mul.mp he
    have ha : a ^ 3 = 1 := by
      apply Subtype.ext
      change cubicActor ^ 3 = 1
      simpa only [cubicActor_order] using pow_orderOf_eq_one cubicActor
    have hp : (f a) ^ 3 = 1 := by rw [← map_pow, ha, map_one]
    have hp' : (f a : M12) ^ 3 = 1 := congrArg Subtype.val hp
    rw [he'] at hp'
    have hbad : (cubicActor * z) ^ 3 ≠ 1 := by decide +kernel
    exact (hbad hp').elim

/-- An automorphism of the first parabolic fixing the literal overlap is trivial. -/
theorem first_eq_one_of_fixes_overlap (f : MulAut firstParabolic)
    (hf : ∀ s : sylowCandidate, f (amalgam.left s) = amalgam.left s) : f = 1 := by
  have ha := fixes_first_cubic f hf
  have hg (j : Fin 4) :
      f (EightExtensions.Coordinates.generator j) = EightExtensions.Coordinates.generator j := by
    fin_cases j
    · exact hf (SylowAutomorphismGroup.generator 0)
    · exact hf (SylowAutomorphismGroup.generator 1)
    · exact hf (SylowAutomorphismGroup.generator 2)
    · exact ha
  have hw (w : List (Fin 4)) :
      f (EightExtensions.Coordinates.evaluate w) = EightExtensions.Coordinates.evaluate w := by
    induction w with
    | nil => exact map_one f
    | cons j w ih => simp only [EightExtensions.Coordinates.evaluate, map_mul, hg, ih]
  apply MulEquiv.ext
  intro x
  obtain ⟨i, rfl⟩ := EightExtensions.Coordinates.element_surjective x
  exact hw (EightExtensions.Coordinates.words i)

/-- Two automorphisms of the first parabolic agree if they agree on the overlap. -/
theorem first_eq_of_eq_on_overlap (f g : MulAut firstParabolic)
    (h : ∀ s : sylowCandidate, f (amalgam.left s) = g (amalgam.left s)) : f = g := by
  have he : f.trans g.symm = 1 := first_eq_one_of_fixes_overlap _ (by
    intro s
    change g.symm (f (amalgam.left s)) = amalgam.left s
    rw [h s, g.symm_apply_apply])
  apply MulEquiv.ext
  intro x
  have hx := congrArg (fun e : MulAut firstParabolic => e x) he
  change g.symm (f x) = x at hx
  have hh := congrArg g hx
  simpa only [g.apply_symm_apply] using hh

/-- Restriction along the actual inclusion of the common Sylow subgroup is injective. -/
theorem first_restriction_injective : Function.Injective
    (fun f : MulAut firstParabolic => f.toMonoidHom.comp amalgam.left) := by
  intro f g h
  exact first_eq_of_eq_on_overlap f g (fun s =>
    congrArg (fun k : sylowCandidate →* firstParabolic => k s) h)

/-- The second endpoint determines a compatible automorphism of the marked amalgam. -/
theorem iso_right_injective : Function.Injective
    (fun e : RankTwoAmalgam.Iso amalgam amalgam => e.right) := by
  intro e f hright
  change e.right = f.right at hright
  have hmiddle : e.middle = f.middle := by
    apply MulEquiv.ext
    intro s
    apply amalgam_right_injective
    rw [← e.right_commutes, ← f.right_commutes, hright]
  have hleft : e.left = f.left := first_eq_of_eq_on_overlap e.left f.left (by
    intro s
    rw [e.left_commutes, f.left_commutes, hmiddle])
  cases e with
  | mk e hle hre =>
    cases f with
    | mk f hlf hrf =>
      cases e with
      | mk el em er =>
        cases f with
        | mk fl fm fr =>
          cases hleft
          cases hmiddle
          cases hright
          rfl

end Sporadic.Mathieu.M12SmallPair.ExceptionalParabolics.AmalgamAutomorphisms
