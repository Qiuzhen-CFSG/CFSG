module

public import Mathlib.GroupTheory.Sylow
public import Mathlib.Algebra.Group.Defs
public import Theory.Mathieu.M12.Properties.Order

set_option maxHeartbeats 800000
set_option maxRecDepth 100000

namespace Sporadic.Mathieu

/-!
This file gives a finite certificate for the Atlas description
`Sylow_3(M12) ≅ 3^{1+2}`.  The source group is the order-three Heisenberg
group, and its image is generated by explicit words in the standard M12
generators.
-/

public noncomputable def m12AInM12 : M12 :=
  ⟨m12GeneratorA, m12GeneratorA_mem⟩

public noncomputable def m12BInM12 : M12 :=
  ⟨m12GeneratorB, m12GeneratorB_mem⟩

@[expose]
public noncomputable def m12Sylow3GenX : M12 :=
  m12BInM12 * m12AInM12 * m12BInM12⁻¹ * m12AInM12 *
    m12BInM12 * m12AInM12 * m12BInM12⁻¹ * m12AInM12 *
    m12BInM12⁻¹ * m12AInM12 * m12BInM12⁻¹ * m12AInM12 *
    m12BInM12 * m12AInM12 * m12BInM12⁻¹ * m12AInM12 *
    m12BInM12⁻¹ * m12AInM12 * m12BInM12⁻¹ * m12AInM12 *
    m12BInM12 * m12AInM12 * m12BInM12 * m12AInM12 *
    m12BInM12⁻¹ * m12AInM12

@[expose]
public noncomputable def m12Sylow3GenZ : M12 :=
  m12BInM12 * m12Sylow3GenX * m12BInM12⁻¹ * m12Sylow3GenX⁻¹

/-- The order-three Heisenberg group in coordinates `(i,j,k)`. -/
@[ext]
public structure M12Heisenberg where
  i : ZMod 3
  j : ZMod 3
  k : ZMod 3
deriving DecidableEq

public def m12HeisenbergTripleEquiv :
    (ZMod 3 × ZMod 3 × ZMod 3) ≃ M12Heisenberg where
  toFun a := ⟨a.1, a.2.1, a.2.2⟩
  invFun a := (a.i, a.j, a.k)
  left_inv _ := rfl
  right_inv _ := rfl

public instance instFintypeM12Heisenberg : Fintype M12Heisenberg :=
  Fintype.ofEquiv (ZMod 3 × ZMod 3 × ZMod 3) m12HeisenbergTripleEquiv

/-- Multiplication `(i,j,k)(i',j',k') = (i+i',j+j',k+k'-ji')`. -/
public def m12HeisenbergMul (a b : M12Heisenberg) : M12Heisenberg :=
  ⟨a.i + b.i, a.j + b.j, a.k + b.k - a.j * b.i⟩

public def m12HeisenbergInv (a : M12Heisenberg) : M12Heisenberg :=
  ⟨-a.i, -a.j, -a.k - a.j * a.i⟩

public def m12HeisenbergOne : M12Heisenberg := ⟨0, 0, 0⟩

public def m12HeisenbergPow : Nat → M12Heisenberg → M12Heisenberg
  | 0, _ => m12HeisenbergOne
  | n + 1, a => m12HeisenbergMul (m12HeisenbergPow n a) a

public def m12HeisenbergZPow : Int → M12Heisenberg → M12Heisenberg
  | Int.ofNat n, a => m12HeisenbergPow n a
  | Int.negSucc n, a => m12HeisenbergInv (m12HeisenbergPow (n + 1) a)

public def m12HeisenbergDiv (a b : M12Heisenberg) : M12Heisenberg :=
  m12HeisenbergMul a (m12HeisenbergInv b)

public instance instGroupM12Heisenberg : Group M12Heisenberg where
  mul := m12HeisenbergMul
  one := m12HeisenbergOne
  npow := m12HeisenbergPow
  npow_zero := by intro a; rfl
  npow_succ := by intro n a; rfl
  mul_assoc := by
    intro a b c
    change m12HeisenbergMul (m12HeisenbergMul a b) c =
      m12HeisenbergMul a (m12HeisenbergMul b c)
    apply M12Heisenberg.ext <;> simp [m12HeisenbergMul] <;> ring
  one_mul := by
    intro a
    change m12HeisenbergMul m12HeisenbergOne a = a
    apply M12Heisenberg.ext <;> simp [m12HeisenbergMul, m12HeisenbergOne]
  mul_one := by
    intro a
    change m12HeisenbergMul a m12HeisenbergOne = a
    apply M12Heisenberg.ext <;> simp [m12HeisenbergMul, m12HeisenbergOne]
  inv := m12HeisenbergInv
  div := m12HeisenbergDiv
  div_eq_mul_inv := by intro a b; change m12HeisenbergDiv a b = _; rfl
  zpow := m12HeisenbergZPow
  zpow_zero' := by intro a; rfl
  zpow_succ' := by intro n a; rfl
  zpow_neg' := by intro n a; rfl
  inv_mul_cancel := by
    intro a
    change m12HeisenbergMul (m12HeisenbergInv a) a = m12HeisenbergOne
    apply M12Heisenberg.ext
    · simp [m12HeisenbergMul, m12HeisenbergInv, m12HeisenbergOne]
    · simp [m12HeisenbergMul, m12HeisenbergInv, m12HeisenbergOne]
    · simp [m12HeisenbergMul, m12HeisenbergInv, m12HeisenbergOne]
      ring

public theorem m12Heisenberg_card : Nat.card M12Heisenberg = 27 := by
  rw [Nat.card_eq_fintype_card, ← Fintype.card_congr m12HeisenbergTripleEquiv]
  simp

public theorem m12Heisenberg_cube_eq_one (a : M12Heisenberg) : a ^ 3 = 1 := by
  change m12HeisenbergPow 3 a = m12HeisenbergOne
  have h3 : (3 : ZMod 3) = 0 := ZMod.natCast_self 3
  apply M12Heisenberg.ext <;>
    simp [m12HeisenbergPow, m12HeisenbergMul, m12HeisenbergOne] <;> ring_nf <;> simp [h3]

/-- Every nonidentity element of the Heisenberg model has order three. -/
public theorem m12Heisenberg_orderOf_eq_three {a : M12Heisenberg} (ha : a ≠ 1) :
    orderOf a = 3 := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact orderOf_eq_prime (m12Heisenberg_cube_eq_one a) ha

public theorem m12Heisenberg_center_card :
    Nat.card (Subgroup.center M12Heisenberg) = 3 := by
  rw [Nat.card_eq_fintype_card]
  decide +kernel

-- Compute with small permutation tables after checking them against the original
-- words. Repeated kernel reduction of the nested words is much more expensive.
private def m12Sylow3GenXPerm : Equiv.Perm (Fin 12) where
  toFun := ![11, 5, 2, 3, 4, 9, 8, 6, 7, 1, 0, 10]
  invFun := ![10, 9, 2, 3, 4, 1, 7, 8, 6, 5, 11, 0]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

private def m12Sylow3GenZPerm : Equiv.Perm (Fin 12) where
  toFun := ![9, 6, 2, 3, 4, 8, 11, 0, 10, 7, 5, 1]
  invFun := ![7, 11, 2, 3, 4, 10, 1, 9, 5, 0, 8, 6]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

private theorem m12Sylow3GenX_perm :
    (m12Sylow3GenX : Equiv.Perm (Fin 12)) = m12Sylow3GenXPerm := by
  decide +kernel

private theorem m12Sylow3GenZ_perm :
    (m12Sylow3GenZ : Equiv.Perm (Fin 12)) = m12Sylow3GenZPerm := by
  change m12GeneratorB * (m12Sylow3GenX : Equiv.Perm (Fin 12)) *
    m12GeneratorB⁻¹ * (m12Sylow3GenX : Equiv.Perm (Fin 12))⁻¹ = _
  rw [m12Sylow3GenX_perm]
  decide +kernel

private def m12HeisenbergPermEval (a : M12Heisenberg) : Equiv.Perm (Fin 12) :=
  m12GeneratorB ^ a.i.val *
    m12Sylow3GenXPerm ^ a.j.val *
    m12Sylow3GenZPerm ^ a.k.val

public noncomputable def m12HeisenbergEval (a : M12Heisenberg) : M12 :=
  m12BInM12 ^ a.i.val * m12Sylow3GenX ^ a.j.val * m12Sylow3GenZ ^ a.k.val

private theorem m12HeisenbergEval_perm (a : M12Heisenberg) :
    (m12HeisenbergEval a : Equiv.Perm (Fin 12)) = m12HeisenbergPermEval a := by
  change
    (m12BInM12 : Equiv.Perm (Fin 12)) ^ a.i.val *
      (m12Sylow3GenX : Equiv.Perm (Fin 12)) ^ a.j.val *
      (m12Sylow3GenZ : Equiv.Perm (Fin 12)) ^ a.k.val = _
  rw [m12Sylow3GenX_perm, m12Sylow3GenZ_perm]
  rfl

private theorem m12Sylow3GenBPerm_order_three : m12GeneratorB ^ 3 = 1 := by
  decide +kernel

private theorem m12Sylow3GenXPerm_order_three : m12Sylow3GenXPerm ^ 3 = 1 := by
  decide +kernel

private theorem m12Sylow3GenZPerm_order_three : m12Sylow3GenZPerm ^ 3 = 1 := by
  decide +kernel

private theorem m12Sylow3GenXPerm_mul_B :
    m12Sylow3GenXPerm * m12GeneratorB =
      m12GeneratorB * m12Sylow3GenXPerm * m12Sylow3GenZPerm⁻¹ := by
  decide +kernel

private theorem m12Sylow3GenZPerm_mul_B :
    m12Sylow3GenZPerm * m12GeneratorB =
      m12GeneratorB * m12Sylow3GenZPerm := by
  decide +kernel

private theorem m12Sylow3GenZPerm_mul_X :
    m12Sylow3GenZPerm * m12Sylow3GenXPerm =
      m12Sylow3GenXPerm * m12Sylow3GenZPerm := by
  decide +kernel

private theorem m12GeneratorB_pow_add (a b : ZMod 3) :
    m12GeneratorB ^ (a + b).val =
      m12GeneratorB ^ a.val * m12GeneratorB ^ b.val := by
  fin_cases a <;> fin_cases b <;> decide +kernel

private theorem m12Sylow3GenXPerm_pow_add (a b : ZMod 3) :
    m12Sylow3GenXPerm ^ (a + b).val =
      m12Sylow3GenXPerm ^ a.val * m12Sylow3GenXPerm ^ b.val := by
  fin_cases a <;> fin_cases b <;> decide +kernel

private theorem m12Sylow3GenZPerm_pow_add (a b : ZMod 3) :
    m12Sylow3GenZPerm ^ (a + b).val =
      m12Sylow3GenZPerm ^ a.val * m12Sylow3GenZPerm ^ b.val := by
  fin_cases a <;> fin_cases b <;> decide +kernel

private theorem m12Sylow3GenZPerm_pow_comm_B (a b : ZMod 3) :
    m12Sylow3GenZPerm ^ a.val * m12GeneratorB ^ b.val =
      m12GeneratorB ^ b.val * m12Sylow3GenZPerm ^ a.val := by
  fin_cases a <;> fin_cases b <;> decide +kernel

private theorem m12Sylow3GenZPerm_pow_comm_X (a b : ZMod 3) :
    m12Sylow3GenZPerm ^ a.val * m12Sylow3GenXPerm ^ b.val =
      m12Sylow3GenXPerm ^ b.val * m12Sylow3GenZPerm ^ a.val := by
  fin_cases a <;> fin_cases b <;> decide +kernel

private theorem m12Sylow3GenXPerm_pow_mul_B_pow (a b : ZMod 3) :
    m12Sylow3GenXPerm ^ a.val * m12GeneratorB ^ b.val =
      m12GeneratorB ^ b.val * m12Sylow3GenXPerm ^ a.val *
        m12Sylow3GenZPerm ^ (-a * b).val := by
  fin_cases a <;> fin_cases b <;> decide +kernel

/-!
Proof route for multiplicativity:
1. certify the three order-three generator relations above;
2. derive the nine-case power-add and commutation tables;
3. move the central `Z` powers past the `B` and `X` powers;
4. use `X^j B^i = B^i X^j Z^{-ji}`;
5. collect the three coordinates with no 27² permutation expansion.
-/
private theorem m12HeisenbergPermEval_mul (a b : M12Heisenberg) :
    m12HeisenbergPermEval (m12HeisenbergMul a b) =
      m12HeisenbergPermEval a * m12HeisenbergPermEval b := by
  rcases a with ⟨ai, aj, ak⟩
  rcases b with ⟨bi, bj, bk⟩
  change
    m12GeneratorB ^ (ai + bi).val *
        m12Sylow3GenXPerm ^ (aj + bj).val *
        m12Sylow3GenZPerm ^ (ak + bk - aj * bi).val =
      (m12GeneratorB ^ ai.val * m12Sylow3GenXPerm ^ aj.val *
          m12Sylow3GenZPerm ^ ak.val) *
        (m12GeneratorB ^ bi.val * m12Sylow3GenXPerm ^ bj.val *
          m12Sylow3GenZPerm ^ bk.val)
  let t : ZMod 3 := -aj * bi
  have hcoord : ak + bk - aj * bi = ak + bk + t := by
    dsimp [t]
    ring
  rw [hcoord, m12GeneratorB_pow_add ai bi,
    m12Sylow3GenXPerm_pow_add aj bj,
    m12Sylow3GenZPerm_pow_add (ak + bk) t,
    m12Sylow3GenZPerm_pow_add ak bk]
  have hZB := m12Sylow3GenZPerm_pow_comm_B ak bi
  have hZX := m12Sylow3GenZPerm_pow_comm_X ak bj
  have hTX := m12Sylow3GenZPerm_pow_comm_X t bj
  have htwist := m12Sylow3GenXPerm_pow_mul_B_pow aj bi
  have hTCX :
      (m12Sylow3GenZPerm ^ t.val * m12Sylow3GenZPerm ^ ak.val) *
          m12Sylow3GenXPerm ^ bj.val =
        m12Sylow3GenXPerm ^ bj.val *
          (m12Sylow3GenZPerm ^ t.val * m12Sylow3GenZPerm ^ ak.val) := by
    calc
      (m12Sylow3GenZPerm ^ t.val * m12Sylow3GenZPerm ^ ak.val) *
          m12Sylow3GenXPerm ^ bj.val =
          m12Sylow3GenZPerm ^ t.val *
            (m12Sylow3GenZPerm ^ ak.val * m12Sylow3GenXPerm ^ bj.val) := by group
      _ = m12Sylow3GenZPerm ^ t.val *
            (m12Sylow3GenXPerm ^ bj.val * m12Sylow3GenZPerm ^ ak.val) := by
          rw [hZX]
      _ = (m12Sylow3GenZPerm ^ t.val * m12Sylow3GenXPerm ^ bj.val) *
            m12Sylow3GenZPerm ^ ak.val := by group
      _ = (m12Sylow3GenXPerm ^ bj.val * m12Sylow3GenZPerm ^ t.val) *
            m12Sylow3GenZPerm ^ ak.val := by rw [hTX]
      _ = m12Sylow3GenXPerm ^ bj.val *
            (m12Sylow3GenZPerm ^ t.val * m12Sylow3GenZPerm ^ ak.val) := by group
  have hZreorder :
      (m12Sylow3GenZPerm ^ t.val * m12Sylow3GenZPerm ^ ak.val) *
          m12Sylow3GenZPerm ^ bk.val =
        (m12Sylow3GenZPerm ^ ak.val * m12Sylow3GenZPerm ^ bk.val) *
          m12Sylow3GenZPerm ^ t.val := by
    rw [← m12Sylow3GenZPerm_pow_add t ak,
      ← m12Sylow3GenZPerm_pow_add (t + ak) bk]
    rw [show t + ak + bk = ak + bk + t by ring]
    rw [m12Sylow3GenZPerm_pow_add (ak + bk) t,
      m12Sylow3GenZPerm_pow_add ak bk]
  symm
  calc
    (m12GeneratorB ^ ai.val * m12Sylow3GenXPerm ^ aj.val *
          m12Sylow3GenZPerm ^ ak.val) *
        (m12GeneratorB ^ bi.val * m12Sylow3GenXPerm ^ bj.val *
          m12Sylow3GenZPerm ^ bk.val) =
      m12GeneratorB ^ ai.val * m12Sylow3GenXPerm ^ aj.val *
        (m12Sylow3GenZPerm ^ ak.val * m12GeneratorB ^ bi.val) *
        m12Sylow3GenXPerm ^ bj.val * m12Sylow3GenZPerm ^ bk.val := by group
    _ = m12GeneratorB ^ ai.val * m12Sylow3GenXPerm ^ aj.val *
        (m12GeneratorB ^ bi.val * m12Sylow3GenZPerm ^ ak.val) *
        m12Sylow3GenXPerm ^ bj.val * m12Sylow3GenZPerm ^ bk.val := by rw [hZB]
    _ = m12GeneratorB ^ ai.val *
        (m12Sylow3GenXPerm ^ aj.val * m12GeneratorB ^ bi.val) *
        m12Sylow3GenZPerm ^ ak.val * m12Sylow3GenXPerm ^ bj.val *
        m12Sylow3GenZPerm ^ bk.val := by group
    _ = m12GeneratorB ^ ai.val *
        (m12GeneratorB ^ bi.val * m12Sylow3GenXPerm ^ aj.val *
          m12Sylow3GenZPerm ^ t.val) *
        m12Sylow3GenZPerm ^ ak.val * m12Sylow3GenXPerm ^ bj.val *
        m12Sylow3GenZPerm ^ bk.val := by rw [htwist]
    _ = (m12GeneratorB ^ ai.val * m12GeneratorB ^ bi.val) *
        m12Sylow3GenXPerm ^ aj.val *
        ((m12Sylow3GenZPerm ^ t.val * m12Sylow3GenZPerm ^ ak.val) *
          m12Sylow3GenXPerm ^ bj.val) *
        m12Sylow3GenZPerm ^ bk.val := by group
    _ = (m12GeneratorB ^ ai.val * m12GeneratorB ^ bi.val) *
        m12Sylow3GenXPerm ^ aj.val *
        (m12Sylow3GenXPerm ^ bj.val *
          (m12Sylow3GenZPerm ^ t.val * m12Sylow3GenZPerm ^ ak.val)) *
        m12Sylow3GenZPerm ^ bk.val := by rw [hTCX]
    _ = (m12GeneratorB ^ ai.val * m12GeneratorB ^ bi.val) *
        (m12Sylow3GenXPerm ^ aj.val * m12Sylow3GenXPerm ^ bj.val) *
        ((m12Sylow3GenZPerm ^ t.val * m12Sylow3GenZPerm ^ ak.val) *
          m12Sylow3GenZPerm ^ bk.val) := by group
    _ = (m12GeneratorB ^ ai.val * m12GeneratorB ^ bi.val) *
        (m12Sylow3GenXPerm ^ aj.val * m12Sylow3GenXPerm ^ bj.val) *
        ((m12Sylow3GenZPerm ^ ak.val * m12Sylow3GenZPerm ^ bk.val) *
          m12Sylow3GenZPerm ^ t.val) := by rw [hZreorder]

private theorem m12HeisenbergPermEval_one :
    m12HeisenbergPermEval m12HeisenbergOne = 1 := by
  decide +kernel

private theorem m12HeisenbergPermEval_eq_one (a : M12Heisenberg)
    (h : m12HeisenbergPermEval a = 1) : a = 1 := by
  have h0 : m12HeisenbergPermEval a 0 = 0 := DFunLike.congr_fun h 0
  have h1 : m12HeisenbergPermEval a 1 = 1 := DFunLike.congr_fun h 1
  clear h
  rcases a with ⟨i,j,k⟩
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    first | rfl | (exfalso; revert h0 h1; decide +kernel)

private theorem m12HeisenbergPermEval_injective :
    Function.Injective m12HeisenbergPermEval := by
  intro a b hab
  apply inv_mul_eq_one.mp
  apply m12HeisenbergPermEval_eq_one
  change m12HeisenbergPermEval (m12HeisenbergMul a⁻¹ b) = 1
  rw [m12HeisenbergPermEval_mul, ← hab, ← m12HeisenbergPermEval_mul]
  change m12HeisenbergPermEval (a⁻¹ * a) = 1
  rw [inv_mul_cancel]
  exact m12HeisenbergPermEval_one

public noncomputable def m12HeisenbergHom : M12Heisenberg →* M12 where
  toFun := m12HeisenbergEval
  map_one' := by
    apply Subtype.ext
    change (m12HeisenbergEval 1 : Equiv.Perm (Fin 12)) = 1
    rw [m12HeisenbergEval_perm]
    exact m12HeisenbergPermEval_one
  map_mul' a b := by
    apply Subtype.ext
    change (m12HeisenbergEval (a * b) : Equiv.Perm (Fin 12)) =
      (m12HeisenbergEval a : Equiv.Perm (Fin 12)) *
        (m12HeisenbergEval b : Equiv.Perm (Fin 12))
    rw [m12HeisenbergEval_perm, m12HeisenbergEval_perm, m12HeisenbergEval_perm]
    exact m12HeisenbergPermEval_mul a b

private theorem m12HeisenbergHom_injective :
    Function.Injective m12HeisenbergHom := by
  intro a b hab
  apply m12HeisenbergPermEval_injective
  rw [← m12HeisenbergEval_perm a, ← m12HeisenbergEval_perm b]
  change m12HeisenbergEval a = m12HeisenbergEval b at hab
  exact congrArg (fun g : M12 => (g : Equiv.Perm (Fin 12))) hab

/-- An explicit Sylow 3-subgroup, as the image of the Heisenberg group. -/
@[expose]
public noncomputable def m12Sylow3Subgroup : Subgroup M12 :=
  m12HeisenbergHom.range

public theorem m12Sylow3Subgroup_card : Nat.card m12Sylow3Subgroup = 27 := by
  change Nat.card m12HeisenbergHom.range = 27
  have hbij : Function.Bijective m12HeisenbergHom.rangeRestrict :=
    ⟨(MonoidHom.rangeRestrict_injective_iff).2 m12HeisenbergHom_injective,
      MonoidHom.rangeRestrict_surjective _⟩
  calc
    Nat.card m12HeisenbergHom.range = Nat.card M12Heisenberg :=
      (Nat.card_congr
        (Equiv.ofBijective m12HeisenbergHom.rangeRestrict hbij)).symm
    _ = 27 := m12Heisenberg_card

private theorem m12_factorization_three : Nat.factorization 95040 3 = 3 := by
  have hzero : padicValNat 3 3520 = 0 :=
    padicValNat.eq_zero_iff.mpr (Or.inr (Or.inr (by norm_num)))
  rw [Nat.factorization_def 95040 Nat.prime_three,
    show (95040 : Nat) = 3 ^ 3 * 3520 by norm_num,
    padicValNat_base_pow_mul (by norm_num) (by norm_num) 3, hzero]

@[expose]
public noncomputable def m12Sylow3 : Sylow 3 M12 := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact Sylow.ofCard m12Sylow3Subgroup (by
    rw [m12Sylow3Subgroup_card, m12_order, m12_factorization_three]
    norm_num)

public theorem m12Sylow3_coe :
    (m12Sylow3 : Subgroup M12) = m12Sylow3Subgroup := by
  rfl

public noncomputable def m12Sylow3Subgroup_mulEquiv_heisenberg :
    m12Sylow3Subgroup ≃* M12Heisenberg := by
  exact MulEquiv.ofBijective m12HeisenbergHom.rangeRestrict
    ⟨(MonoidHom.rangeRestrict_injective_iff).2 m12HeisenbergHom_injective,
      MonoidHom.rangeRestrict_surjective _⟩ |>.symm

public theorem m12Heisenberg_isNonabelian :
    ¬ IsMulCommutative M12Heisenberg := by
  intro h
  have hcomm := (isMulCommutative_iff.mp h)
    (⟨1, 0, 0⟩ : M12Heisenberg) (⟨0, 1, 0⟩ : M12Heisenberg)
  change
    m12HeisenbergMul ⟨1, 0, 0⟩ ⟨0, 1, 0⟩ =
      m12HeisenbergMul ⟨0, 1, 0⟩ ⟨1, 0, 0⟩ at hcomm
  have hk := congrArg M12Heisenberg.k hcomm
  norm_num [m12HeisenbergMul] at hk

public theorem m12Sylow3Subgroup_isNonabelian :
    ¬ IsMulCommutative m12Sylow3Subgroup := by
  intro h
  apply m12Heisenberg_isNonabelian
  rw [isMulCommutative_iff] at h ⊢
  intro a b
  apply m12Sylow3Subgroup_mulEquiv_heisenberg.symm.injective
  simpa using h
    (m12Sylow3Subgroup_mulEquiv_heisenberg.symm a)
    (m12Sylow3Subgroup_mulEquiv_heisenberg.symm b)

/-- Every nonidentity element of the concrete Sylow 3-subgroup has order three. -/
public theorem m12Sylow3Subgroup_orderOf_eq_three
    {g : m12Sylow3Subgroup} (hg : g ≠ 1) : orderOf g = 3 := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  apply orderOf_eq_prime
  · apply m12Sylow3Subgroup_mulEquiv_heisenberg.injective
    simpa using m12Heisenberg_cube_eq_one
      (m12Sylow3Subgroup_mulEquiv_heisenberg g)
  · exact hg

end Sporadic.Mathieu
