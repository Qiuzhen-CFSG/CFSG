def evaluate : List (Fin 3) → Equiv.Perm (Fin 24)
  | [] => 1
  | i :: w => generators i * evaluate w
def conjugate (i : Fin 640) : Equiv.Perm (Fin 24) :=
  evaluate words[i.val]! * representative * (evaluate words[i.val]!)⁻¹
def key (g : Equiv.Perm (Fin 24)) : ℕ :=
  ([4,6,0,15,11] : List (Fin 24)).foldl (fun z i => z * 24 + (g i).val) 0


def blockIndex (k : Fin 20) (j : Fin 32) : Fin 640 :=
  ⟨k.val * 32 + j.val, by omega⟩

private theorem block_check_first (k : Fin 10) : ∀ j : Fin 32,
    key (conjugate (blockIndex ⟨k.val, by omega⟩ j)) =
      keys[(blockIndex ⟨k.val, by omega⟩ j).val]! := by
  fin_cases k <;> decide +kernel

private theorem block_check_second (k : Fin 10) : ∀ j : Fin 32,
    key (conjugate (blockIndex ⟨10 + k.val, by omega⟩ j)) =
      keys[(blockIndex ⟨10 + k.val, by omega⟩ j).val]! := by
  fin_cases k <;> decide +kernel

private theorem block_check (k : Fin 20) (j : Fin 32) :
    key (conjugate (blockIndex k j)) = keys[(blockIndex k j).val]! := by
  by_cases hk : k.val < 10
  · exact block_check_first ⟨k.val, hk⟩ j
  · have h : 10 + (k.val - 10) = k.val := by omega
    simpa only [h] using block_check_second ⟨k.val - 10, by omega⟩ j

theorem key_check (i : Fin 640) : key (conjugate i) = keys[i.val]! := by
  let b : Fin 20 := ⟨i.val / 32, by omega⟩
  let j : Fin 32 := ⟨i.val % 32, Nat.mod_lt _ (by decide)⟩
  have hi : blockIndex b j = i := by
    apply Fin.ext
    dsimp [blockIndex, b, j]
    omega
  simpa only [hi] using block_check b j

theorem keys_size : keys.size = 640 := by decide +kernel
theorem keys_chain : keys.toList.IsChain (· < ·) := by decide +kernel
theorem keys_strictMono : StrictMono (fun i : Fin 640 => keys[i.val]!) := by
  apply Fin.strictMono_iff_lt_succ.mpr
  intro i
  have hi : i.val + 1 < keys.toList.length := by
    rw [Array.length_toList, keys_size]
    exact i.succ.isLt
  have h := (List.isChain_iff_getElem.mp keys_chain) i.val hi
  have h0 : i.val < keys.size := by rw [keys_size]; omega
  have h1 : i.val + 1 < keys.size := by simpa using hi
  simpa only [Fin.val_castSucc, Fin.val_succ, Array.getElem_toList,
    getElem!_pos keys i.val h0, getElem!_pos keys (i.val + 1) h1] using h

theorem conjugate_injective : Function.Injective conjugate := by
  intro i j h
  apply keys_strictMono.injective
  change keys[i.val]! = keys[j.val]!
  rw [← key_check i, ← key_check j, h]
end Sporadic.Mathieu.M12FixedOrders.Outer
