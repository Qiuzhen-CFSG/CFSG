def multiply (i j : Fin 64) : Fin 64 := (multiplicationTable[i.val]!)[j.val]!

def step (i : Fin 64) (j : Fin 3) : Fin 64 := multiply i ⟨j.val + 1, by omega⟩

theorem element_step : ∀ i j, element (step i j) = element i * generator j := by
  decide +kernel

def rightMultiplyWord (i : Fin 64) (w : List (Fin 3)) : Fin 64 :=
  match w with
  | [] => i
  | j :: w => rightMultiplyWord (step i j) w
termination_by structural w

theorem element_rightMultiplyWord (i : Fin 64) (w : List (Fin 3)) :
    element (rightMultiplyWord i w) = element i * evaluate w := by
  induction w generalizing i with
  | nil => simp only [rightMultiplyWord, evaluate, mul_one]
  | cons j w ih => rw [rightMultiplyWord, ih, element_step, evaluate, mul_assoc]

theorem multiply_eq_rightMultiplyWord : ∀ i j,
    multiply i j = rightMultiplyWord i (words j) := by decide +kernel

theorem element_multiply (i j : Fin 64) : element (multiply i j) = element i * element j := by
  rw [multiply_eq_rightMultiplyWord, element_rightMultiplyWord]
  rfl


theorem element_surjective : Function.Surjective element :=
  ((Nat.bijective_iff_injective_and_card element).mpr
    ⟨element_injective, by rw [Nat.card_fin, intersection_card]⟩).2

theorem hom_ext {G : Type*} [Group G] (f g : sylowCandidate →* G)
    (h : ∀ i, f (generator i) = g (generator i)) : f = g := by
  have hw (w : List (Fin 3)) : f (evaluate w) = g (evaluate w) := by
    induction w with
    | nil => simp only [evaluate, map_one]
    | cons i w ih => simp only [evaluate, map_mul, h, ih]
  apply MonoidHom.ext
  intro x
  obtain ⟨i, rfl⟩ := element_surjective x
  exact hw (words i)

end Sporadic.Mathieu.M12SmallPair.SylowAutomorphismGroup
