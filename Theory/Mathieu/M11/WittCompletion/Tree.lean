explicit Witt design. The finite completion tree is checked in the kernel. -/
public theorem completion (D : SteinerSystem (Fin 11) 4 5)
    (hseed : m11CompletionSeed ⊆ D.blocks) :
    ∃ e : Equiv.Perm (Fin 11), e • (D.blocks : Set (Finset (Fin 11))) =
      (m11WittDesign.blocks : Set (Finset (Fin 11))) := by
  apply node0 D
  have heq : initial = start0 := by decide +kernel
  rw [← heq]
  exact initial_bounds D hseed

