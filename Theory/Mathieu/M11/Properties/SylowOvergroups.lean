module
public import Theory.Mathieu.M11.Properties.AutomorphismCentralizers
public import Theory.SpecificGroups.AlternatingSix.M10.SylowRecognition
public import Theory.Mathieu.M11.Properties.SylowTwo
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.GroupTheory.GeneralizedFitting.SemisimpleCenter
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.PCoreSurjective
/-!
# Full Sylow overgroups of A₆ in M₁₁

A normal M₁₁ admits a literal retraction because it is centerless and all
automorphisms are inner. In M₁₁ an overgroup of a full Sylow with normal
A₆ has order720: its order is divisible by720 and divides7920, and the
whole simple group is impossible. Its semidihedral Sylow identifies the
overgroup with the canonical M₁₀. For a source generated by A₆ and a
two-subgroup, the retraction kernel is a two-group and exactly the two-core.
Source: Aschbacher–Smith 2.5.6(2), printed p.554.
-/
public section
open Subgroup Theory.GroupTheory
namespace Sporadic.Mathieu
variable {G:Type*} [Group G]
theorem exists_normal_m11_projection (C:Subgroup G) [C.Normal] (e:C≃*M11) :
    ∃ q:G→*M11, Function.Surjective q ∧ ∀ c:C, q c=e c := by
  let a : M11≃*MulAut M11 := MulEquiv.ofBijective MulAut.conj
    ⟨MulAut.conj_injective_of_center_eq_bot m11_center_eq_bot,
      fun x=>by obtain ⟨g,hg⟩:=m11_automorphism_inner x; exact ⟨g,hg⟩⟩
  let q : G→*M11 := a.symm.toMonoidHom.comp ((MulAut.congr e).toMonoidHom.comp
    (MulAut.conjNormal (H:=C)))
  have hq (c:C) : q c=e c := by
    apply a.injective
    change a (a.symm (MulAut.congr e (MulAut.conjNormal (c:G))))=a (e c)
    rw [a.apply_symm_apply]
    change MulAut.congr e (MulAut.conjNormal (c:G))=MulAut.conj (e c)
    have he : MulAut.conjNormal (c:G)=MulAut.conj c := by ext x; rfl
    rw [he,MulAut.congr_conj]
  exact ⟨q,fun x=>⟨e.symm x,by rw [hq,e.apply_symm_apply]⟩,hq⟩

variable [Finite G]
theorem sylow_overgroup_with_normal_six
    (e:G≃*M11) (S:Sylow 2 G) (W:Subgroup G) (hSW:(S:Subgroup G)≤W)
    (N:Subgroup W) [N.Normal] (eN:N≃*alternatingGroup (Fin 6)) :
    Nonempty (W≃*AlternatingSix.M10.extension) ∧ pCore 2 W=⊥ := by
  have hGcard : Nat.card G=7920 := (Nat.card_congr e.toEquiv).trans m11_order
  have hNcard : Nat.card N=360 := (Nat.card_congr eN.toEquiv).trans
    AlternatingSix.ShadowLocal.card_A6
  have hScard : Nat.card S=16 := by rw [S.card_eq_multiplicity,hGcard]; decide +kernel
  have hdN : 360∣Nat.card W := hNcard ▸ N.card_subgroup_dvd_card
  have hdS : 16∣Nat.card W := hScard ▸ card_dvd_of_le hSW
  have hdW : Nat.card W∣7920 := hGcard ▸ W.card_subgroup_dvd_card
  have h720 : 720∣Nat.card W := by
    have hh:=Nat.lcm_dvd hdN hdS
    norm_num [Nat.lcm] at hh
    exact hh
  have hproper : W≠⊤ := by
    intro he
    let : IsSimpleGroup M11 := m11_isSimpleGroup
    let : IsSimpleGroup G := e.isSimpleGroup
    have : IsSimpleGroup W := by rw [he]; exact Subgroup.topEquiv.isSimpleGroup
    rcases (inferInstance:N.Normal).eq_bot_or_eq_top with h | h
    · rw [h,Subgroup.card_bot] at hNcard; omega
    · rw [h,Subgroup.card_top,he,Subgroup.card_top] at hNcard
      rw [hGcard] at hNcard
      omega
  have hWcard : Nat.card W=720 := by
    obtain ⟨n,hn⟩ := h720
    have hd : n∣11 := by
      rw [hn] at hdW
      have h7920 : 7920=720*11 := by norm_num
      rw [h7920] at hdW
      exact (Nat.mul_dvd_mul_iff_left (by decide : 0<720)).mp hdW
    rcases (Nat.dvd_prime (by decide : Nat.Prime 11)).mp hd with h | h
    · simpa [h] using hn
    · have he : W=⊤ := eq_of_le_of_card_ge le_top (by rw [Subgroup.card_top,hGcard,hn,h])
      exact (hproper he).elim
  have hi : N.index=2 := by
    have hh:=N.card_mul_index
    rw [hNcard,hWcard] at hh
    omega
  let Q := S.subtype hSW
  have eQ : Nonempty (Q≃*Semidihedral.StandardModel 4 (by decide)) := by
    obtain ⟨T,a,b,ha,hb,hab,hgen⟩ := m11_exists_semidihedral_sylow
    have hT : Nat.card T=16 := by rw [T.card_eq_multiplicity,m11_order]; decide +kernel
    obtain ⟨s⟩ := Semidihedral.standardModel_equiv_of_presentation (by omega : 4≤4)
      a b ha hb hab hgen hT
    let R := S.mapSurjective (f:=e.toMonoidHom) e.surjective
    let eS : S≃*R := (S:Subgroup G).equivMapOfInjective e.toMonoidHom e.injective
    have hmap : (Q:Subgroup W).map W.subtype=(S:Subgroup G) := by
      simp only [Q,Sylow.coe_subtype,map_subgroupOf_eq_of_le hSW]
    let eQS : Q≃*S := ((Q:Subgroup W).equivMapOfInjective W.subtype W.subtype_injective).trans
      (MulEquiv.subgroupCongr hmap)
    exact ⟨eQS.trans (eS.trans ((R.equiv T).trans s))⟩
  obtain ⟨s⟩ := eQ
  obtain ⟨a,_⟩ := AlternatingSix.M10.SylowRecognition.exists_marked_equiv N hi eN Q s
  refine ⟨⟨a⟩,?_⟩
  let : IsQuasisimple N := IsQuasisimple.of_mulEquiv eN.symm
  have hN : IsComponent W N := ⟨(inferInstance:N.Normal).isSubnormal,inferInstance⟩
  let : Group.IsNilpotent (pCore 2 W) := pCore_isNilpotent
  have hc : pCore 2 W≤centralizer (N:Set W) :=
    le_centralizer_iff.mp (hN.le_centralizer_of_solvable_normal (pCore 2 W))
  have hi := AlternatingSix.M10.SylowRecognition.conjugation_injective N hi eN Q s
  apply eq_bot_iff.mpr
  intro x hx
  apply mem_bot.mpr
  apply hi
  have he : (MulAut.conjNormal (H:=N)) x=1 := by
    change x∈(MulAut.conjNormal (H:=N)).ker
    rw [MulAut.conjNormal_ker_eq_centralizer]
    exact hc hx
  change MulAut.congr eN ((MulAut.conjNormal (H:=N)) x)=_
  rw [he,map_one,map_one]
end Sporadic.Mathieu
namespace Sporadic.Mathieu
open Subgroup Theory.GroupTheory
variable {H:Type*} [Group H] [Finite H]
theorem quotient_m10_of_full_sylow_image
    (K:Subgroup H) [K.Normal] (eK:K≃*alternatingGroup (Fin 6))
    (S:Sylow 2 H) (hgen:K⊔(S:Subgroup H)=⊤)
    (f:H→*M11) (hfK:Function.Injective (f.comp K.subtype))
    (P:Sylow 2 M11) (hP:(P:Subgroup M11)=(S:Subgroup H).map f) :
    Nonempty ((H⧸pCore 2 H)≃*AlternatingSix.M10.extension) := by
  let W := f.range
  let g : H→*W := f.rangeRestrict
  have hg : Function.Surjective g := f.rangeRestrict_surjective
  let N := K.map g
  let : N.Normal := (inferInstance:K.Normal).map g hg
  have hgi : Function.Injective (g.comp K.subtype) := by
    intro x y h
    exact hfK (congrArg Subtype.val h)
  have hkr : (g.comp K.subtype).range=N := by
    rw [MonoidHom.range_comp,range_subtype]
  let eN : N≃*alternatingGroup (Fin 6) :=
    (MulEquiv.subgroupCongr hkr.symm).trans ((MonoidHom.ofInjective hgi).symm.trans eK)
  have hPW : (P:Subgroup M11)≤W := by rw [hP]; exact map_le_range _ _
  obtain ⟨⟨a⟩,hcore⟩ := sylow_overgroup_with_normal_six (MulEquiv.refl M11) P W hPW N eN
  have hquot : IsPGroup 2 (H⧸K) := isPGroup_quotient_of_sup_eq_top K S S.isPGroup' hgen
  let r : g.ker→*H⧸K := (QuotientGroup.mk' K).comp g.ker.subtype
  have hr : Function.Injective r := by
    rw [injective_iff_map_eq_one]
    intro x hx
    have hxK : (x:H)∈K := (QuotientGroup.eq_one_iff _).mp hx
    have hxg : g (x:H)=1 := x.property
    have he : (⟨x,hxK⟩:K)=1 := hgi (by simpa using hxg)
    exact Subtype.ext (congrArg (fun y:K=>(y:H)) he)
  have hk : IsPGroup 2 g.ker := hquot.of_injective r hr
  have hp : pCore 2 H=g.ker := by
    have hh := g.comap_pCore_of_ker_isPGroup hg hk
    rw [hcore] at hh
    change g.ker=pCore 2 H at hh
    exact hh.symm
  exact ⟨(QuotientGroup.quotientMulEquivOfEq hp).trans
    ((QuotientGroup.quotientKerEquivOfSurjective g hg).trans a)⟩
end Sporadic.Mathieu
