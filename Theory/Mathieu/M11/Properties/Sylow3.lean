public import Theory.Mathieu.M11.Properties.Centralizer
public import Theory.Mathieu.M11.Properties.PowersetStabilizer
public import Theory.Mathieu.M11.Properties.Transitivity

set_option maxHeartbeats 800000
set_option maxRecDepth 100000

namespace Sporadic.Mathieu

/-!
## An explicit Sylow 3-subgroup

The finite certificates below only inspect the nine products `V^i * Y^j`.
They do not enumerate M11.
-/

public abbrev M11E9 := Multiplicative (Fin 3 × Fin 3)

/-- A second order-three generator for an elementary abelian subgroup of M11. -/
@[expose]
public noncomputable def m11Sylow3GenY : M11 :=
  (m11GeneratorAInM11 * m11GeneratorBInM11 *
    m11GeneratorAInM11 * m11GeneratorBInM11⁻¹) ^ 2

/-- Point table for the second Sylow-3 generator. -/
public theorem m11Sylow3GenY_perm :
    (m11Sylow3GenY : Equiv.Perm (Fin 11)) =
      List.formPerm [0, 4, 3] * List.formPerm [1, 7, 5] *
        List.formPerm [2, 10, 6] := by
  change
    ((m11GeneratorAInM11 : Equiv.Perm (Fin 11)) *
      (m11GeneratorBInM11 : Equiv.Perm (Fin 11)) *
      (m11GeneratorAInM11 : Equiv.Perm (Fin 11)) *
      (m11GeneratorBInM11 : Equiv.Perm (Fin 11))⁻¹) ^ 2 = _
  rw [show (m11GeneratorAInM11 : Equiv.Perm (Fin 11)) =
      m11GeneratorA by rfl,
    show (m11GeneratorBInM11 : Equiv.Perm (Fin 11)) =
      m11GeneratorB by rfl]
  ext x
  fin_cases x <;> rfl

private def m11Sylow3VPerm : Equiv.Perm (Fin 11) :=
  List.formPerm [1, 3, 6] * List.formPerm [2, 7, 11] *
    List.formPerm [4, 10, 5]

private def m11Sylow3YPerm : Equiv.Perm (Fin 11) :=
  List.formPerm [0, 4, 3] * List.formPerm [1, 7, 5] *
    List.formPerm [2, 10, 6]

private noncomputable def m11E9Eval (a : M11E9) : M11 :=
  m11CentralizerV ^ ((Multiplicative.toAdd a).1 : Nat) *
    m11Sylow3GenY ^ ((Multiplicative.toAdd a).2 : Nat)

private def m11E9PermEval (a : M11E9) : Equiv.Perm (Fin 11) :=
  m11Sylow3VPerm ^ ((Multiplicative.toAdd a).1 : Nat) *
    m11Sylow3YPerm ^ ((Multiplicative.toAdd a).2 : Nat)

private theorem m11E9Eval_perm (a : M11E9) :
    (m11E9Eval a : Equiv.Perm (Fin 11)) = m11E9PermEval a := by
  change
    (m11CentralizerV : Equiv.Perm (Fin 11)) ^
        ((Multiplicative.toAdd a).1 : Nat) *
      (m11Sylow3GenY : Equiv.Perm (Fin 11)) ^
        ((Multiplicative.toAdd a).2 : Nat) = _
  rw [m11CentralizerV_perm, m11Sylow3GenY_perm]
  rfl

private theorem m11E9PermEval_one :
    m11E9PermEval 1 = 1 := by
  decide

private theorem m11E9PermEval_mul :
    ∀ a b : M11E9,
      m11E9PermEval (a * b) = m11E9PermEval a * m11E9PermEval b := by
  decide

private theorem m11E9PermEval_injective :
    Function.Injective m11E9PermEval := by
  decide

private noncomputable def m11E9Hom : M11E9 →* M11 where
  toFun := m11E9Eval
  map_one' := by
    apply Subtype.ext
    change (m11E9Eval 1 : Equiv.Perm (Fin 11)) = 1
    rw [m11E9Eval_perm, m11E9PermEval_one]
  map_mul' a b := by
    apply Subtype.ext
    change
      (m11E9Eval (a * b) : Equiv.Perm (Fin 11)) =
        (m11E9Eval a : Equiv.Perm (Fin 11)) *
          (m11E9Eval b : Equiv.Perm (Fin 11))
    rw [m11E9Eval_perm (a * b), m11E9Eval_perm a, m11E9Eval_perm b]
    exact m11E9PermEval_mul a b

private theorem m11E9Hom_injective : Function.Injective m11E9Hom := by
  intro a b hab
  change m11E9Eval a = m11E9Eval b at hab
  apply m11E9PermEval_injective
  rw [← m11E9Eval_perm a, ← m11E9Eval_perm b]
  exact congrArg (fun g : M11 => (g : Equiv.Perm (Fin 11))) hab

/-- The explicit elementary abelian subgroup generated by the two order-three words. -/
public noncomputable def m11Sylow3Subgroup : Subgroup M11 :=
  m11E9Hom.range

/-- The explicit subgroup has order nine. -/
public theorem m11Sylow3Subgroup_card :
    Nat.card m11Sylow3Subgroup = 9 := by
  change Nat.card m11E9Hom.range = 9
  have hbij : Function.Bijective m11E9Hom.rangeRestrict :=
    ⟨(MonoidHom.rangeRestrict_injective_iff).2 m11E9Hom_injective,
      MonoidHom.rangeRestrict_surjective _⟩
  calc
    Nat.card m11E9Hom.range = Nat.card M11E9 :=
      (Nat.card_congr
        (Equiv.ofBijective m11E9Hom.rangeRestrict hbij)).symm
    _ = Nat.card (Fin 3 × Fin 3) :=
      Nat.card_congr Multiplicative.toAdd
    _ = 9 := by
      norm_num [Nat.card_prod, Nat.card_fin]

private theorem m11_factorization_three :
    Nat.factorization 7920 3 = 2 := by
  have hzero : padicValNat 3 880 = 0 :=
    padicValNat.eq_zero_iff.mpr (Or.inr (Or.inr (by norm_num)))
  rw [Nat.factorization_def 7920 Nat.prime_three,
    show (7920 : Nat) = 3 ^ 2 * 880 by norm_num,
    padicValNat_base_pow_mul (by norm_num) (by norm_num) 2, hzero]

/-- A Sylow 3-subgroup of M11, represented by the explicit order-nine range. -/
@[expose]
public noncomputable def m11Sylow3 : Sylow 3 M11 := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  exact Sylow.ofCard m11Sylow3Subgroup (by
    rw [m11Sylow3Subgroup_card, m11_order, m11_factorization_three]
    norm_num)

/-- The underlying subgroup of `m11Sylow3` is the explicit order-nine range. -/
public theorem m11Sylow3_coe :
    (m11Sylow3 : Subgroup M11) = m11Sylow3Subgroup := by
  rfl

public noncomputable def m11E9MulEquiv :
    M11E9 ≃* m11Sylow3Subgroup :=
  MulEquiv.ofBijective m11E9Hom.rangeRestrict
    ⟨(MonoidHom.rangeRestrict_injective_iff).2 m11E9Hom_injective,
      MonoidHom.rangeRestrict_surjective _⟩

/-- The chosen Sylow 3-subgroup of M11 is isomorphic to E9 = C3 x C3. -/
@[expose]
public noncomputable def m11Sylow3_mulEquiv_e9 :
    m11Sylow3 ≃* Multiplicative (Fin 3 × Fin 3) := by
  change m11Sylow3Subgroup ≃* M11E9
  exact m11E9MulEquiv.symm



/-!
## The Sylow 3-normalizer

The normalizer is identified with the setwise stabilizer of the two common
fixed points of the explicit E9. Its normal form has only 9 * 8 * 2
parameters.
-/

private abbrev M11PairSet := Set.powersetCard (Fin 11) 2

private def m11Sylow3FixedPair : M11PairSet :=
  ⟨{8, 9}, by change ({8, 9} : Finset (Fin 11)).card = 2; decide⟩

private noncomputable abbrev m11Sylow3PairStabilizer : Subgroup M11 :=
  MulAction.stabilizer M11 m11Sylow3FixedPair

private theorem m11E9PermEval_fixed_iff (x : Fin 11) :
    (∀ a : M11E9, m11E9PermEval a x = x) ↔ x = 8 ∨ x = 9 := by
  fin_cases x <;> decide

private theorem m11Sylow3_fixedPoints :
    MulAction.fixedPoints m11Sylow3Subgroup (Fin 11) =
      (m11Sylow3FixedPair : Set (Fin 11)) := by
  ext x
  rw [MulAction.mem_fixedPoints]
  constructor
  · intro hx
    have hall : ∀ a : M11E9, m11E9PermEval a x = x := by
      intro a
      have ha := hx
        ⟨m11E9Eval a, show m11E9Eval a ∈ m11Sylow3Subgroup from ⟨a, rfl⟩⟩
      change (m11E9Eval a : Equiv.Perm (Fin 11)) x = x at ha
      rwa [m11E9Eval_perm] at ha
    have h := (m11E9PermEval_fixed_iff x).mp hall
    simpa [m11Sylow3FixedPair] using h
  · intro hx p
    rcases p with ⟨p, hp⟩
    change p ∈ m11E9Hom.range at hp
    rcases hp with ⟨a, rfl⟩
    change (m11E9Eval a : Equiv.Perm (Fin 11)) x = x
    rw [m11E9Eval_perm]
    have h : x = 8 ∨ x = 9 := by
      simpa [m11Sylow3FixedPair] using hx
    rcases h with rfl | rfl <;> fin_cases a <;> decide

open scoped Pointwise in
private theorem m11Sylow3_normalizer_le_pairStabilizer :
    Subgroup.normalizer (m11Sylow3Subgroup : Set M11) ≤ m11Sylow3PairStabilizer := by
  intro g hg
  apply m11_mem_powersetCard_stabilizer_of_set_eq (g : M11) m11Sylow3FixedPair
  rw [← m11Sylow3_fixedPoints]
  ext x
  rw [Set.mem_smul_set_iff_inv_smul_mem]
  constructor
  · intro hx
    rw [MulAction.mem_fixedPoints] at hx ⊢
    intro p
    have hpconj :
        g⁻¹ * (p : M11) * g ∈ m11Sylow3Subgroup :=
      ((Subgroup.mem_normalizer_iff'').mp hg (p : M11)).mp p.property
    let q : m11Sylow3Subgroup :=
      ⟨g⁻¹ * (p : M11) * g, hpconj⟩
    have hq := hx q
    have hq' := congrArg (fun y : Fin 11 => g • y) hq
    change (p : M11) • x = x
    simpa [q, mul_smul] using hq'
  · intro hx
    rw [MulAction.mem_fixedPoints] at hx ⊢
    intro p
    have hpconj :
        g * (p : M11) * g⁻¹ ∈ m11Sylow3Subgroup :=
      ((Subgroup.mem_normalizer_iff).mp hg (p : M11)).mp p.property
    let q : m11Sylow3Subgroup :=
      ⟨g * (p : M11) * g⁻¹, hpconj⟩
    have hq := hx q
    have hq' := congrArg (fun y : Fin 11 => g⁻¹ • y) hq
    change (p : M11) • g⁻¹ • x = g⁻¹ • x
    simpa [q, mul_smul] using hq'

private theorem m11Sylow3PairStabilizer_card :
    Nat.card m11Sylow3PairStabilizer = 144 := by
  let : MulAction.IsMultiplyPretransitive M11 (Fin 11) 4 :=
    m11_isFourPretransitive
  let : MulAction.IsMultiplyPretransitive M11 (Fin 11) 2 :=
    MulAction.isMultiplyPretransitive_of_le
      (m := 2) (n := 4) (by norm_num) (by norm_num)
  let : MulAction.IsPretransitive M11 M11PairSet :=
    Set.powersetCard.isPretransitive_of_isMultiplyPretransitive
      (G := M11) (α := Fin 11) (n := 2) inferInstance
  have hmul := Subgroup.card_mul_index m11Sylow3PairStabilizer
  rw [MulAction.index_stabilizer_of_transitive M11 m11Sylow3FixedPair,
    Set.powersetCard.card, Nat.card_fin, m11_order] at hmul
  norm_num [Nat.choose] at hmul ⊢
  omega

/-- An order-eight complement word used in the Sylow 3-normalizer:
A B B A B A B B. -/
@[expose]
public noncomputable def m11Sylow3ComplementU : M11 :=
  m11GeneratorAInM11 * m11GeneratorBInM11 *
    m11GeneratorBInM11 * m11GeneratorAInM11 *
    m11GeneratorBInM11 * m11GeneratorAInM11 *
    m11GeneratorBInM11 * m11GeneratorBInM11

private def m11Sylow3ComplementUPerm : Equiv.Perm (Fin 11) :=
  m11GeneratorA * m11GeneratorB * m11GeneratorB * m11GeneratorA *
    m11GeneratorB * m11GeneratorA * m11GeneratorB * m11GeneratorB

private theorem m11Sylow3ComplementU_perm :
    (m11Sylow3ComplementU : Equiv.Perm (Fin 11)) =
      m11Sylow3ComplementUPerm := by
  rfl

private def m11Sylow3UAct (a : M11E9) : M11E9 :=
  let z := Multiplicative.toAdd a
  Multiplicative.ofAdd (z.1 + 2 * z.2, z.1 + z.2)

private def m11Sylow3UInvAct (a : M11E9) : M11E9 :=
  let z := Multiplicative.toAdd a
  Multiplicative.ofAdd (-z.1 - z.2, z.1 - z.2)

private def m11Sylow3AAct (a : M11E9) : M11E9 :=
  let z := Multiplicative.toAdd a
  Multiplicative.ofAdd (z.1, -z.2)

private theorem m11Sylow3ComplementU_conj_perm :
    ∀ a : M11E9,
      m11Sylow3ComplementUPerm * m11E9PermEval a *
          m11Sylow3ComplementUPerm⁻¹ =
        m11E9PermEval (m11Sylow3UAct a) := by
  decide

private theorem m11Sylow3ComplementU_inv_conj_perm :
    ∀ a : M11E9,
      m11Sylow3ComplementUPerm⁻¹ * m11E9PermEval a *
          m11Sylow3ComplementUPerm =
        m11E9PermEval (m11Sylow3UInvAct a) := by
  decide

private theorem m11Sylow3GeneratorA_conj_perm :
    ∀ a : M11E9,
      m11GeneratorA * m11E9PermEval a * m11GeneratorA⁻¹ =
        m11E9PermEval (m11Sylow3AAct a) := by
  decide

private theorem m11Sylow3GeneratorA_inv_conj_perm :
    ∀ a : M11E9,
      m11GeneratorA⁻¹ * m11E9PermEval a * m11GeneratorA =
        m11E9PermEval (m11Sylow3AAct a) := by
  decide

private theorem m11Sylow3ComplementU_conj (a : M11E9) :
    m11Sylow3ComplementU * m11E9Eval a * m11Sylow3ComplementU⁻¹ =
      m11E9Eval (m11Sylow3UAct a) := by
  apply Subtype.ext
  change
    (m11Sylow3ComplementU : Equiv.Perm (Fin 11)) *
        (m11E9Eval a : Equiv.Perm (Fin 11)) *
        (m11Sylow3ComplementU : Equiv.Perm (Fin 11))⁻¹ =
      (m11E9Eval (m11Sylow3UAct a) : Equiv.Perm (Fin 11))
  rw [m11Sylow3ComplementU_perm, m11E9Eval_perm,
    m11E9Eval_perm]
  exact m11Sylow3ComplementU_conj_perm a

private theorem m11Sylow3ComplementU_inv_conj (a : M11E9) :
    m11Sylow3ComplementU⁻¹ * m11E9Eval a * m11Sylow3ComplementU =
      m11E9Eval (m11Sylow3UInvAct a) := by
  apply Subtype.ext
  change
    (m11Sylow3ComplementU : Equiv.Perm (Fin 11))⁻¹ *
        (m11E9Eval a : Equiv.Perm (Fin 11)) *
        (m11Sylow3ComplementU : Equiv.Perm (Fin 11)) =
      (m11E9Eval (m11Sylow3UInvAct a) : Equiv.Perm (Fin 11))
  rw [m11Sylow3ComplementU_perm, m11E9Eval_perm,
    m11E9Eval_perm]
  exact m11Sylow3ComplementU_inv_conj_perm a

private theorem m11Sylow3GeneratorA_conj (a : M11E9) :
    m11GeneratorAInM11 * m11E9Eval a * m11GeneratorAInM11⁻¹ =
      m11E9Eval (m11Sylow3AAct a) := by
  apply Subtype.ext
  change
    m11GeneratorA * (m11E9Eval a : Equiv.Perm (Fin 11)) *
        m11GeneratorA⁻¹ =
      (m11E9Eval (m11Sylow3AAct a) : Equiv.Perm (Fin 11))
  rw [m11E9Eval_perm, m11E9Eval_perm]
  exact m11Sylow3GeneratorA_conj_perm a

private theorem m11Sylow3GeneratorA_inv_conj (a : M11E9) :
    m11GeneratorAInM11⁻¹ * m11E9Eval a * m11GeneratorAInM11 =
      m11E9Eval (m11Sylow3AAct a) := by
  apply Subtype.ext
  change
    m11GeneratorA⁻¹ * (m11E9Eval a : Equiv.Perm (Fin 11)) *
        m11GeneratorA =
      (m11E9Eval (m11Sylow3AAct a) : Equiv.Perm (Fin 11))
  rw [m11E9Eval_perm, m11E9Eval_perm]
  exact m11Sylow3GeneratorA_inv_conj_perm a

private theorem m11_mem_sylow3_normalizer_of_e9_conj
    (g : M11) (act invAct : M11E9 → M11E9)
    (hact : ∀ a, g * m11E9Eval a * g⁻¹ = m11E9Eval (act a))
    (hinv : ∀ a, g⁻¹ * m11E9Eval a * g = m11E9Eval (invAct a)) :
    g ∈ Subgroup.normalizer (m11Sylow3Subgroup : Set M11) := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  change x ∈ m11E9Hom.range ↔ g * x * g⁻¹ ∈ m11E9Hom.range
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨act a, (hact a).symm⟩
  · intro hx
    rcases hx with ⟨a, ha⟩
    change m11E9Eval a = g * x * g⁻¹ at ha
    refine ⟨invAct a, ?_⟩
    change m11E9Eval (invAct a) = x
    calc
      m11E9Eval (invAct a) = g⁻¹ * m11E9Eval a * g :=
        (hinv a).symm
      _ = g⁻¹ * (g * x * g⁻¹) * g := by rw [ha]
      _ = x := by simp [mul_assoc]

private theorem m11Sylow3ComplementU_mem_normalizer :
    m11Sylow3ComplementU ∈ Subgroup.normalizer (m11Sylow3Subgroup : Set M11) :=
  m11_mem_sylow3_normalizer_of_e9_conj
    m11Sylow3ComplementU m11Sylow3UAct m11Sylow3UInvAct
    m11Sylow3ComplementU_conj m11Sylow3ComplementU_inv_conj

private theorem m11GeneratorAInM11_mem_sylow3_normalizer :
    m11GeneratorAInM11 ∈ Subgroup.normalizer (m11Sylow3Subgroup : Set M11) :=
  m11_mem_sylow3_normalizer_of_e9_conj
    m11GeneratorAInM11 m11Sylow3AAct m11Sylow3AAct
    m11Sylow3GeneratorA_conj m11Sylow3GeneratorA_inv_conj

private abbrev M11PairNFParam := M11E9 × Fin 8 × Fin 2

private noncomputable def m11PairQ (p : Fin 8 × Fin 2) : M11 :=
  m11Sylow3ComplementU ^ (p.1 : Nat) *
    m11GeneratorAInM11 ^ (p.2 : Nat)

private def m11PairQPerm (p : Fin 8 × Fin 2) :
    Equiv.Perm (Fin 11) :=
  m11Sylow3ComplementUPerm ^ (p.1 : Nat) *
    m11GeneratorA ^ (p.2 : Nat)

private theorem m11PairQ_perm (p : Fin 8 × Fin 2) :
    (m11PairQ p : Equiv.Perm (Fin 11)) = m11PairQPerm p := by
  simp [m11PairQ, m11PairQPerm, m11Sylow3ComplementU_perm, m11GeneratorAInM11]

private noncomputable def m11PairNF (p : M11PairNFParam) : M11 :=
  m11E9Eval p.1 * m11PairQ p.2

private def m11PairNFPerm (p : M11PairNFParam) :
    Equiv.Perm (Fin 11) :=
  m11E9PermEval p.1 * m11PairQPerm p.2

private theorem m11PairNF_perm (p : M11PairNFParam) :
    (m11PairNF p : Equiv.Perm (Fin 11)) = m11PairNFPerm p := by
  simp [m11PairNF, m11PairNFPerm, m11E9Eval_perm, m11PairQ_perm]

private theorem m11PairQPerm_six :
    ∀ p : Fin 8 × Fin 2, m11PairQPerm p 6 = 6 := by
  decide

private theorem m11PairQPerm_injective :
    Function.Injective m11PairQPerm := by
  decide

private theorem m11E9PermEval_at_six_injective :
    Function.Injective (fun a : M11E9 => m11E9PermEval a 6) := by
  decide

private theorem m11PairNFPerm_six (p : M11PairNFParam) :
    m11PairNFPerm p 6 = m11E9PermEval p.1 6 := by
  rw [m11PairNFPerm, Equiv.Perm.mul_apply, m11PairQPerm_six]

private theorem m11PairNF_injective :
    Function.Injective m11PairNF := by
  rintro ⟨a, ⟨i, e⟩⟩ ⟨b, ⟨j, f⟩⟩ h
  have hperm :
      m11PairNFPerm (a, i, e) = m11PairNFPerm (b, j, f) := by
    rw [← m11PairNF_perm, ← m11PairNF_perm]
    exact congrArg (fun z : M11 => (z : Equiv.Perm (Fin 11))) h
  have hsix := congrArg (fun z : Equiv.Perm (Fin 11) => z 6) hperm
  rw [m11PairNFPerm_six, m11PairNFPerm_six] at hsix
  have hab : a = b := m11E9PermEval_at_six_injective hsix
  subst b
  have hq : m11PairQPerm (i, e) = m11PairQPerm (j, f) := by
    rw [m11PairNFPerm, m11PairNFPerm] at hperm
    exact mul_left_cancel hperm
  have hij : (i, e) = (j, f) := m11PairQPerm_injective hq
  cases hij
  rfl

private theorem m11E9Eval_mem_pairStabilizer (a : M11E9) :
    m11E9Eval a ∈ m11Sylow3PairStabilizer := by
  rw [MulAction.mem_stabilizer_iff]
  change (m11E9Eval a : Equiv.Perm (Fin 11)) • m11Sylow3FixedPair =
    m11Sylow3FixedPair
  rw [m11E9Eval_perm]
  have h : ∀ z : M11E9,
      m11E9PermEval z • m11Sylow3FixedPair =
        m11Sylow3FixedPair := by
    decide
  exact h a

private theorem m11Sylow3ComplementU_mem_pairStabilizer :
    m11Sylow3ComplementU ∈ m11Sylow3PairStabilizer := by
  rw [MulAction.mem_stabilizer_iff]
  change
    (m11Sylow3ComplementU : Equiv.Perm (Fin 11)) •
      m11Sylow3FixedPair = m11Sylow3FixedPair
  rw [m11Sylow3ComplementU_perm]
  decide

private theorem m11GeneratorAInM11_mem_pairStabilizer :
    m11GeneratorAInM11 ∈ m11Sylow3PairStabilizer := by
  rw [MulAction.mem_stabilizer_iff]
  change m11GeneratorA • m11Sylow3FixedPair =
    m11Sylow3FixedPair
  decide

private theorem m11PairNF_mem_pairStabilizer (p : M11PairNFParam) :
    m11PairNF p ∈ m11Sylow3PairStabilizer := by
  apply m11Sylow3PairStabilizer.mul_mem
  · exact m11E9Eval_mem_pairStabilizer p.1
  · apply m11Sylow3PairStabilizer.mul_mem
    · exact m11Sylow3PairStabilizer.pow_mem
        m11Sylow3ComplementU_mem_pairStabilizer p.2.1
    · exact m11Sylow3PairStabilizer.pow_mem
        m11GeneratorAInM11_mem_pairStabilizer p.2.2

private noncomputable abbrev m11Sylow3Normalizer : Subgroup M11 :=
  Subgroup.normalizer (m11Sylow3Subgroup : Set M11)

private theorem m11PairNF_mem_normalizer (p : M11PairNFParam) :
    m11PairNF p ∈ m11Sylow3Normalizer := by
  change m11E9Eval p.1 * m11PairQ p.2 ∈ m11Sylow3Normalizer
  apply m11Sylow3Normalizer.mul_mem
  · exact m11Sylow3Subgroup.le_normalizer
      (show m11E9Eval p.1 ∈ m11Sylow3Subgroup from ⟨p.1, rfl⟩)
  · apply m11Sylow3Normalizer.mul_mem
    · exact m11Sylow3Normalizer.pow_mem
        m11Sylow3ComplementU_mem_normalizer p.2.1
    · exact m11Sylow3Normalizer.pow_mem
        m11GeneratorAInM11_mem_sylow3_normalizer p.2.2
private theorem m11PairNFParam_card :
    Nat.card M11PairNFParam = 144 := by
  have hE9 : Nat.card M11E9 = 9 := by
    calc
      Nat.card M11E9 = Nat.card (Fin 3 × Fin 3) :=
        Nat.card_congr Multiplicative.toAdd
      _ = 9 := by norm_num [Nat.card_prod, Nat.card_fin]
  rw [Nat.card_prod, Nat.card_prod, hE9, Nat.card_fin, Nat.card_fin]

private noncomputable def m11PairNFInNormalizer
    (p : M11PairNFParam) : m11Sylow3Normalizer :=
  ⟨m11PairNF p, m11PairNF_mem_normalizer p⟩

private theorem m11PairNFInNormalizer_injective :
    Function.Injective m11PairNFInNormalizer := by
  intro p q h
  apply m11PairNF_injective
  exact congrArg (fun z : m11Sylow3Normalizer => (z : M11)) h

private theorem m11Sylow3_normalizer_card_ge :
    144 ≤ Nat.card m11Sylow3Normalizer := by
  rw [← m11PairNFParam_card]
  exact Nat.card_le_card_of_injective m11PairNFInNormalizer
    m11PairNFInNormalizer_injective

private theorem m11Sylow3_normalizer_eq_pairStabilizer :
    Subgroup.normalizer (m11Sylow3Subgroup : Set M11) = m11Sylow3PairStabilizer := by
  apply Subgroup.eq_of_le_of_card_ge
    m11Sylow3_normalizer_le_pairStabilizer
  rw [m11Sylow3PairStabilizer_card]
  exact m11Sylow3_normalizer_card_ge

/-- The normalizer of the chosen Sylow 3-subgroup has order 144. -/
public theorem m11Sylow3_normalizer_card :
    Nat.card (Subgroup.normalizer (m11Sylow3Subgroup : Set M11)) = 144 := by
  rw [m11Sylow3_normalizer_eq_pairStabilizer,
    m11Sylow3PairStabilizer_card]

private noncomputable def m11PairNFInPairStabilizer
    (p : M11PairNFParam) : m11Sylow3PairStabilizer :=
  ⟨m11PairNF p, m11PairNF_mem_pairStabilizer p⟩

private theorem m11PairNFInPairStabilizer_injective :
    Function.Injective m11PairNFInPairStabilizer := by
  intro p q h
  apply m11PairNF_injective
  exact congrArg (fun z : m11Sylow3PairStabilizer => (z : M11)) h

private noncomputable def m11PairNFEquiv :
    M11PairNFParam ≃ m11Sylow3PairStabilizer :=
  Equiv.ofBijective m11PairNFInPairStabilizer
    (m11PairNFInPairStabilizer_injective.bijective_of_nat_card_le (by
      rw [m11Sylow3PairStabilizer_card, m11PairNFParam_card]))

private def m11PairOrbitRep : Fin 3 → M11PairSet := ![
  m11Sylow3FixedPair,
  ⟨{8, 0}, by change ({8, 0} : Finset (Fin 11)).card = 2; decide⟩,
  ⟨{0, 1}, by change ({0, 1} : Finset (Fin 11)).card = 2; decide⟩
]

private theorem m11PairOrbit_cover :
    ∀ t : M11PairSet,
      ∃ p : M11PairNFParam, ∃ i : Fin 3,
        m11PairNFPerm p • t = m11PairOrbitRep i := by
  intro t
  rcases t with ⟨s, hs⟩
  change s.card = 2 at hs
  obtain ⟨a, b, hab, hs⟩ := Finset.card_eq_two.mp hs
  subst s
  simp only [Subtype.ext_iff]
  change ∃ (p : M11PairNFParam) (i : Fin 3),
    ({a, b} : Finset (Fin 11)).image (m11PairNFPerm p) =
      (m11PairOrbitRep i : Finset (Fin 11))
  have habv : a.val ≠ b.val := by
    intro h
    exact hab (Fin.ext h)
  fin_cases a <;> fin_cases b <;> simp_all <;> decide

private abbrev M11PairFixParam (t : M11PairSet) : Type :=
  {p : M11PairNFParam // m11PairNFPerm p • t = t}

private noncomputable def m11PairFixParamEquiv (t : M11PairSet) :
    M11PairFixParam t ≃
      ((m11Sylow3PairStabilizer ⊓ MulAction.stabilizer M11 t) : Subgroup M11) := by
  let e₁ : M11PairFixParam t ≃
      {h : m11Sylow3PairStabilizer //
        (h : M11) ∈ MulAction.stabilizer M11 t} :=
    m11PairNFEquiv.subtypeEquiv (fun p => by
      rw [MulAction.mem_stabilizer_iff]
      change
        (m11PairNFPerm p • t = t) ↔
          (m11PairNF p : Equiv.Perm (Fin 11)) • t = t
      rw [m11PairNF_perm])
  let e₂ :
      {h : m11Sylow3PairStabilizer //
        (h : M11) ∈ MulAction.stabilizer M11 t} ≃
        ((m11Sylow3PairStabilizer ⊓ MulAction.stabilizer M11 t) : Subgroup M11) := {
    toFun h := ⟨h.1.1, ⟨h.1.2, h.2⟩⟩
    invFun h := ⟨⟨h.1, h.2.1⟩, h.2.2⟩
    left_inv _ := rfl
    right_inv _ := rfl
  }
  exact e₁.trans e₂

private theorem m11PairFixParam_card_share :
    Nat.card (M11PairFixParam (m11PairOrbitRep 1)) = 8 := by
  rw [Nat.card_eq_fintype_card]
  decide

private theorem m11PairFixParam_card_disjoint :
    Nat.card (M11PairFixParam (m11PairOrbitRep 2)) = 4 := by
  rw [Nat.card_eq_fintype_card]
  decide

private theorem m11PairIntersection_card_share :
    Nat.card
        ((m11Sylow3PairStabilizer ⊓
          MulAction.stabilizer M11 (m11PairOrbitRep 1)) : Subgroup M11) = 8 := by
  rw [← m11PairFixParam_card_share]
  exact Nat.card_congr (m11PairFixParamEquiv (m11PairOrbitRep 1)).symm

private theorem m11PairIntersection_card_disjoint :
    Nat.card
        ((m11Sylow3PairStabilizer ⊓
          MulAction.stabilizer M11 (m11PairOrbitRep 2)) : Subgroup M11) = 4 := by
  rw [← m11PairFixParam_card_disjoint]
  exact Nat.card_congr (m11PairFixParamEquiv (m11PairOrbitRep 2)).symm

private noncomputable def m11PairIntersectionConjEquiv
    (q : m11Sylow3PairStabilizer) (t : M11PairSet) :
    ((m11Sylow3PairStabilizer ⊓ MulAction.stabilizer M11 t) : Subgroup M11) ≃*
      ((m11Sylow3PairStabilizer ⊓
        MulAction.stabilizer M11 ((q : M11) • t)) : Subgroup M11) where
  toFun x := by
    refine ⟨(q : M11) * (x : M11) * (q : M11)⁻¹, ?_⟩
    constructor
    · exact m11Sylow3PairStabilizer.mul_mem
        (m11Sylow3PairStabilizer.mul_mem q.property x.property.1)
        (m11Sylow3PairStabilizer.inv_mem q.property)
    · change (q : M11) * (x : M11) * (q : M11)⁻¹ ∈
        MulAction.stabilizer M11 ((q : M11) • t)
      rw [MulAction.mem_stabilizer_iff]
      have hx := MulAction.mem_stabilizer_iff.mp x.property.2
      simpa [mul_smul] using
        congrArg (fun z : M11PairSet => (q : M11) • z) hx
  invFun x := by
    refine ⟨(q : M11)⁻¹ * (x : M11) * (q : M11), ?_⟩
    constructor
    · exact m11Sylow3PairStabilizer.mul_mem
        (m11Sylow3PairStabilizer.mul_mem
          (m11Sylow3PairStabilizer.inv_mem q.property) x.property.1)
        q.property
    · change (q : M11)⁻¹ * (x : M11) * (q : M11) ∈
        MulAction.stabilizer M11 t
      rw [MulAction.mem_stabilizer_iff]
      have hx := MulAction.mem_stabilizer_iff.mp x.property.2
      simpa [mul_smul] using
        congrArg (fun z : M11PairSet => (q : M11)⁻¹ • z) hx
  left_inv x := by
    apply Subtype.ext
    simp [mul_assoc]
  right_inv x := by
    apply Subtype.ext
    simp [mul_assoc]
  map_mul' x y := by
    apply Subtype.ext
    simp [mul_assoc]

private theorem m11PairStabilizer_inf_card_of_ne
    (t : M11PairSet) (ht : t ≠ m11Sylow3FixedPair) :
    Nat.card
        ((m11Sylow3PairStabilizer ⊓ MulAction.stabilizer M11 t) : Subgroup M11) = 8 ∨
      Nat.card
        ((m11Sylow3PairStabilizer ⊓ MulAction.stabilizer M11 t) : Subgroup M11) = 4 := by
  obtain ⟨p, i, hpi⟩ := m11PairOrbit_cover t
  let q : m11Sylow3PairStabilizer :=
    ⟨m11PairNF p, m11PairNF_mem_pairStabilizer p⟩
  have hqt : (q : M11) • t = m11PairOrbitRep i := by
    change (m11PairNF p : Equiv.Perm (Fin 11)) • t =
      m11PairOrbitRep i
    rw [m11PairNF_perm]
    exact hpi
  have hcard := Nat.card_congr
    (m11PairIntersectionConjEquiv q t).toEquiv
  rw [hqt] at hcard
  fin_cases i
  · exfalso
    apply ht
    have hqF :
        (q : M11) • m11Sylow3FixedPair =
          m11Sylow3FixedPair :=
      MulAction.mem_stabilizer_iff.mp q.property
    calc
      t = (q : M11)⁻¹ • ((q : M11) • t) :=
        (inv_smul_smul (q : M11) t).symm
      _ = (q : M11)⁻¹ • m11Sylow3FixedPair := by
        rw [hqt]
        rfl
      _ = (q : M11)⁻¹ • ((q : M11) • m11Sylow3FixedPair) := by
        rw [hqF]
      _ = m11Sylow3FixedPair := inv_smul_smul (q : M11) _
  · left
    calc
      Nat.card
          ((m11Sylow3PairStabilizer ⊓ MulAction.stabilizer M11 t) : Subgroup M11) =
          Nat.card
            ((m11Sylow3PairStabilizer ⊓
              MulAction.stabilizer M11 (m11PairOrbitRep 1)) : Subgroup M11) := hcard
      _ = 8 := m11PairIntersection_card_share
  · right
    calc
      Nat.card
          ((m11Sylow3PairStabilizer ⊓ MulAction.stabilizer M11 t) : Subgroup M11) =
          Nat.card
            ((m11Sylow3PairStabilizer ⊓
              MulAction.stabilizer M11 (m11PairOrbitRep 2)) : Subgroup M11) := hcard
      _ = 4 := m11PairIntersection_card_disjoint

/-- A subgroup is strongly p-embedded when it contains p-torsion, is proper,
and its intersection with every distinct conjugate has p-prime order. -/
public def IsStronglyPEmbedded {G : Type*} [Group G] [Finite G]
    (p : ℕ) (H : Subgroup G) : Prop :=
  H ≠ ⊤ ∧ p ∣ Nat.card H ∧
    ∀ g : G, g ∉ H →
      ¬p ∣ Nat.card
        ((H ⊓ H.map (MulAut.conj g).toMonoidHom) : Subgroup G)

/-- The normalizer of the explicit Sylow 3-subgroup of M11 is strongly
3-embedded. -/
public theorem m11Sylow3_normalizer_isStrongly3Embedded :
    IsStronglyPEmbedded 3 (Subgroup.normalizer (m11Sylow3Subgroup : Set M11)) := by
  constructor
  · intro htop
    have hcard := congrArg
      (fun H : Subgroup M11 => Nat.card H) htop
    rw [m11Sylow3_normalizer_card, Subgroup.card_top, m11_order] at hcard
    norm_num at hcard
  constructor
  · rw [m11Sylow3_normalizer_card]
    norm_num
  · intro g hg
    have hgH : g ∉ m11Sylow3PairStabilizer := by
      simpa [m11Sylow3_normalizer_eq_pairStabilizer] using hg
    have ht : g • m11Sylow3FixedPair ≠ m11Sylow3FixedPair := by
      intro h
      apply hgH
      exact MulAction.mem_stabilizer_iff.mpr h
    have hcard :=
      m11PairStabilizer_inf_card_of_ne
        (g • m11Sylow3FixedPair) ht
    rw [MulAction.stabilizer_smul_eq_stabilizer_map_conj] at hcard
    have hcard' :
        Nat.card
            ((Subgroup.normalizer (m11Sylow3Subgroup : Set M11) ⊓
              (Subgroup.normalizer (m11Sylow3Subgroup : Set M11)).map
                (MulAut.conj g).toMonoidHom) : Subgroup M11) = 8 ∨
          Nat.card
            ((Subgroup.normalizer (m11Sylow3Subgroup : Set M11) ⊓
              (Subgroup.normalizer (m11Sylow3Subgroup : Set M11)).map
                (MulAut.conj g).toMonoidHom) : Subgroup M11) = 4 := by
      simpa [m11Sylow3PairStabilizer,
        m11Sylow3_normalizer_eq_pairStabilizer] using hcard
    rcases hcard' with hcard | hcard <;> rw [hcard] <;> norm_num

end Sporadic.Mathieu
