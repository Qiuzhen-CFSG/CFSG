/-- The finite identities force simultaneous conjugacy of the generating pair. -/
public theorem image_rigidity (y : M11)
    (hy4 : y ^ 4 = 1) (hay : (m11GeneratorAInM11 * y) ^ 11 = 1)
    (hw : rigidityWord m11GeneratorAInM11 y ^ 3 = 1) :
    ∃ c : M11, c * m11GeneratorAInM11 * c⁻¹ = m11GeneratorAInM11 ∧
      c * m11GeneratorBInM11 * c⁻¹ = y := by
  obtain ⟨p, rfl⟩ := element_surjective y
  have h1 : perm p ^ 4 = 1 := congrArg Subtype.val hy4
  have h2 : (m11GeneratorA * perm p) ^ 11 = 1 := congrArg Subtype.val hay
  have h3 : rigidityWord m11GeneratorA (perm p) ^ 3 = 1 := congrArg Subtype.val hw
  rw [m11GeneratorA_eq_m11L0G0] at h2 h3
  have hh := check_all p
  simp only [checkBool, h1, h2, h3, Equiv.Perm.one_apply, beq_self_eq_true,
    Bool.not_true] at hh
  split at hh <;> try cases hh
  simp only [Bool.and_eq_true] at hh
  obtain ⟨ha,hb⟩ := hh
  have ha' := (eqPerm_iff _ _).mp ha
  have hb' := (eqPerm_iff _ _).mp hb
  rw [← m11GeneratorA_eq_m11L0G0] at ha'
  rw [← m11GeneratorB_eq_m11L0G1] at hb'
  exact ⟨element (conjugatorIndex p), Subtype.ext ha', Subtype.ext hb'⟩

