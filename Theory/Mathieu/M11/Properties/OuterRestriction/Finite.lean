/-- A short word separating the allowed images of the second generator. -/
@[expose] public def rigidityWord {G : Type*} [Group G] (a b : G) : G :=
  a * b * a * b * b * a * b⁻¹

private def eqPerm (p q : Equiv.Perm (Fin 11)) : Bool :=
  (List.finRange 11).all (fun i => p i == q i)

private theorem eqPerm_iff (p q : Equiv.Perm (Fin 11)) :
    eqPerm p q = true ↔ p = q := by
  simp only [eqPerm, List.all_eq_true, List.mem_finRange, forall_const, beq_iff_eq]
  exact Equiv.ext_iff.symm

private def checkBool (p : Index) : Bool :=
  let y := perm p
  let c := perm (conjugatorIndex p)
  let r := rejectionCode p.1 p.2.1 p.2.2.1 p.2.2.2
  let x : Fin 11 := ⟨r.val % 11, Nat.mod_lt _ (by decide)⟩
  match r.val / 11 with
  | 0 => !((y ^ 4) x == x)
  | 1 => !(((m11L0G0 * y) ^ 11) x == x)
  | 2 => !((rigidityWord m11L0G0 y ^ 3) x == x)
  | _ => eqPerm (c * m11L0G0 * c⁻¹) m11L0G0 && eqPerm (c * m11L0G1 * c⁻¹) y

