module

public import Theory.SpecificGroups.GL2.InvolutionLocalResidual
public import Theory.Mathieu.M11.Properties.AutomorphismCentralizers

/-!
# The involution-centralizer residual in M₁₁

The established involution-centralizer equivalence transports the GL₂(3)
residual calculation to the actual Witt-design model. Its embedded residual
is SL₂(3), its centralizer is generated by the original involution, and its
full automorphism group is induced by the original involution centralizer.
Source: Aschbacher--Smith, Lemma 2.5.15, printed pp.558--559.
-/

public section
open Subgroup Theory.GroupTheory
namespace Sporadic.Mathieu

/-- The full centralizer of any actual M₁₁ involution is GL₂(3). -/
noncomputable def m11InvolutionCentralizerEquivGL (z : M11) (hz : orderOf z = 2) :
    centralizer ({z} : Set M11) ≃* Matrix.GeneralLinearGroup (Fin 2) (ZMod 3) :=
  (MulEquiv.subgroupCongr (MulAut.fixedSubgroup_conj z).symm).trans
    (m11InvolutoryAutFixedEquiv (MulAut.conj z)
      ((orderOf_injective MulAut.conj
        (MulAut.conj_injective_of_center_eq_bot m11_center_eq_bot) z).trans hz))

/-- The three actual local facts used in 2.5.15, with no model premise. -/
theorem m11_involution_residual_structure (z : M11) (hz : orderOf z = 2) :
    Nonempty (GLTwoThreeLocal.residual z ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3)) ∧
    centralizer (GLTwoThreeLocal.residual z : Set M11) = zpowers z ∧
    Function.Surjective (GLTwoThreeLocal.action z) := by
  let e := m11InvolutionCentralizerEquivGL z hz
  exact ⟨⟨GLTwoThreeLocal.residualEquivSL z e⟩,
    GLTwoThreeLocal.centralizer_residual z e hz, GLTwoThreeLocal.action_surjective z e⟩

end Sporadic.Mathieu
