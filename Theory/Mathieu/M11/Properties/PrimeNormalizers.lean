module

public import Mathlib.GroupTheory.Complement
public import Mathlib.GroupTheory.Perm.Centralizer
public import Mathlib.GroupTheory.SemidirectProduct
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.GroupTheory.Sylow
public import Theory.Mathieu.M11.Properties.Centralizer
public import Theory.Mathieu.M11.Properties.Parity

set_option maxHeartbeats 800000
set_option maxRecDepth 100000

namespace Sporadic.Mathieu

@[expose]
public noncomputable def m11Sylow5Generator : M11 :=
  m11CentralizerWordRight

private theorem m11Sylow5Generator_cycleType :
    (m11Sylow5Generator : Equiv.Perm (Fin 11)).cycleType = {5, 5} := by
  rw [m11Sylow5Generator, m11CentralizerWordRight_perm]
  decide +kernel

/-- The chosen order-five generator for the prime normalizer in M11. -/
public theorem m11Sylow5Generator_order :
    orderOf m11Sylow5Generator = 5 := by
  rw [← Subgroup.orderOf_coe m11Sylow5Generator,
    ← Equiv.Perm.lcm_cycleType, m11Sylow5Generator_cycleType]
  norm_num

/-- The explicit cyclic subgroup generated by `m11Sylow5Generator`. -/
public noncomputable def m11Sylow5Subgroup : Subgroup M11 :=
  Subgroup.zpowers m11Sylow5Generator

/-- The explicit cyclic subgroup has order five. -/
public theorem m11Sylow5Subgroup_card :
    Nat.card m11Sylow5Subgroup = 5 := by
  rw [m11Sylow5Subgroup, Nat.card_zpowers, m11Sylow5Generator_order]

private theorem m11_factorization_five :
    Nat.factorization 7920 5 = 1 := by
  have hzero : padicValNat 5 1584 = 0 :=
    padicValNat.eq_zero_iff.mpr (Or.inr (Or.inr (by norm_num)))
  rw [Nat.factorization_def 7920 Nat.prime_five,
    show (7920 : Nat) = 5 ^ 1 * 1584 by norm_num,
    padicValNat_base_pow_mul (by norm_num) (by norm_num) 1, hzero]

/-- A Sylow 5-subgroup of M11 represented by the explicit cyclic subgroup. -/
@[expose]
public noncomputable def m11Sylow5 : Sylow 5 M11 := by
  let : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  exact Sylow.ofCard m11Sylow5Subgroup (by
    rw [m11Sylow5Subgroup_card, m11_order, m11_factorization_five]
    norm_num)

/-- The underlying subgroup of `m11Sylow5` is the explicit cyclic subgroup. -/
public theorem m11Sylow5_coe :
    (m11Sylow5 : Subgroup M11) = m11Sylow5Subgroup := by
  rfl

/-- The order-four cyclic complement generated by the second standard generator. -/
public noncomputable def m11Sylow5Complement : Subgroup M11 :=
  Subgroup.zpowers m11GeneratorBInM11

private theorem m11GeneratorBInM11_order :
    orderOf m11GeneratorBInM11 = 4 := by
  rw [← Subgroup.orderOf_coe m11GeneratorBInM11]
  exact m11GeneratorB_order

/-- The explicit complement has order four. -/
public theorem m11Sylow5Complement_card :
    Nat.card m11Sylow5Complement = 4 := by
  rw [m11Sylow5Complement, Nat.card_zpowers, m11GeneratorBInM11_order]

private abbrev m11Sylow5AmbientCentralizer : Subgroup (Equiv.Perm (Fin 11)) :=
  Subgroup.centralizer {(m11Sylow5Generator : Equiv.Perm (Fin 11))}

private theorem m11Sylow5AmbientCentralizer_card :
    Nat.card m11Sylow5AmbientCentralizer = 50 := by
  rw [Equiv.Perm.nat_card_centralizer, m11Sylow5Generator_cycleType]
  norm_num

private def m11Sylow5OddCentralizer : Equiv.Perm (Fin 11) :=
  Equiv.swap (1 : Fin 11) 2 * Equiv.swap (4 : Fin 11) 5 *
    Equiv.swap (8 : Fin 11) 9 * Equiv.swap (3 : Fin 11) 6 *
      Equiv.swap (10 : Fin 11) 7

private theorem m11Sylow5OddCentralizer_mem :
    m11Sylow5OddCentralizer ∈ m11Sylow5AmbientCentralizer := by
  rw [Subgroup.mem_centralizer_singleton_iff]
  rw [m11Sylow5Generator, m11CentralizerWordRight_perm]
  ext x
  fin_cases x <;> rfl

private theorem m11Sylow5OddCentralizer_sign :
    Equiv.Perm.sign m11Sylow5OddCentralizer = -1 := by
  simp [m11Sylow5OddCentralizer]

private noncomputable def m11Sylow5AmbientSignHom :
    m11Sylow5AmbientCentralizer →* ℤˣ :=
  Equiv.Perm.sign.comp m11Sylow5AmbientCentralizer.subtype

private theorem m11Sylow5AmbientSignHom_surjective :
    Function.Surjective m11Sylow5AmbientSignHom := by
  intro u
  rcases Int.units_eq_one_or u with rfl | rfl
  · exact ⟨1, rfl⟩
  · exact ⟨⟨m11Sylow5OddCentralizer, m11Sylow5OddCentralizer_mem⟩,
      m11Sylow5OddCentralizer_sign⟩

private theorem m11Sylow5AmbientEvenCentralizer_card :
    Nat.card m11Sylow5AmbientSignHom.ker = 25 := by
  have hrange : m11Sylow5AmbientSignHom.range = ⊤ :=
    MonoidHom.range_eq_top.mpr m11Sylow5AmbientSignHom_surjective
  have hindex : m11Sylow5AmbientSignHom.ker.index = 2 := by
    rw [Subgroup.index_ker, hrange]
    norm_num
  have hmul := Subgroup.card_mul_index m11Sylow5AmbientSignHom.ker
  rw [hindex, m11Sylow5AmbientCentralizer_card] at hmul
  omega

private noncomputable def m11Sylow5EvenAmbientCentralizer :
    Subgroup (Equiv.Perm (Fin 11)) :=
  m11Sylow5AmbientCentralizer ⊓
    (Equiv.Perm.sign : Equiv.Perm (Fin 11) →* ℤˣ).ker

private theorem m11Sylow5EvenAmbientCentralizer_card :
    Nat.card m11Sylow5EvenAmbientCentralizer = 25 := by
  have heq :
      m11Sylow5EvenAmbientCentralizer.subgroupOf m11Sylow5AmbientCentralizer =
        m11Sylow5AmbientSignHom.ker := by
    ext x
    change (((x : Equiv.Perm (Fin 11)) ∈ m11Sylow5AmbientCentralizer) ∧
      Equiv.Perm.sign (x : Equiv.Perm (Fin 11)) = 1) ↔
      Equiv.Perm.sign (x : Equiv.Perm (Fin 11)) = 1
    constructor
    · exact And.right
    · intro hx
      exact ⟨x.property, hx⟩
  calc
    Nat.card m11Sylow5EvenAmbientCentralizer =
        Nat.card (m11Sylow5EvenAmbientCentralizer.subgroupOf
          m11Sylow5AmbientCentralizer) := by
      exact Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe inf_le_left).symm.toEquiv
    _ = Nat.card m11Sylow5AmbientSignHom.ker := by rw [heq]
    _ = 25 := m11Sylow5AmbientEvenCentralizer_card

private noncomputable abbrev m11Sylow5Centralizer : Subgroup M11 :=
  Subgroup.centralizer {(m11Sylow5Generator : M11)}

private theorem m11Sylow5Centralizer_eq_subgroupCentralizer :
    Subgroup.centralizer (m11Sylow5Subgroup : Set M11) =
      m11Sylow5Centralizer := by
  rw [m11Sylow5Subgroup, Subgroup.zpowers_eq_closure,
    Subgroup.centralizer_closure]

private noncomputable def m11Sylow5CentralizerToEvenAmbient :
    m11Sylow5Centralizer →* m11Sylow5EvenAmbientCentralizer :=
  (M11.subtype.comp m11Sylow5Centralizer.subtype).codRestrict
      m11Sylow5EvenAmbientCentralizer (fun g => by
        change (((g : M11) : Equiv.Perm (Fin 11)) ∈ m11Sylow5AmbientCentralizer) ∧
          Equiv.Perm.sign ((g : M11) : Equiv.Perm (Fin 11)) = 1
        constructor
        · apply (Subgroup.mem_centralizer_singleton_iff).2
          have hg := (Subgroup.mem_centralizer_singleton_iff).1 g.property
          have hmap := congrArg M11.subtype hg
          simpa only [map_mul, Subgroup.subtype_apply] using hmap
        · exact m11_sign_eq_one g)

private theorem m11Sylow5CentralizerToEvenAmbient_injective :
    Function.Injective m11Sylow5CentralizerToEvenAmbient := by
  intro g h hgh
  have hp := congrArg
    (fun q : m11Sylow5EvenAmbientCentralizer =>
      (q : Equiv.Perm (Fin 11))) hgh
  have hperm :
      ((g : M11) : Equiv.Perm (Fin 11)) =
        ((h : M11) : Equiv.Perm (Fin 11)) := by
    simpa only [m11Sylow5CentralizerToEvenAmbient,
      MonoidHom.codRestrict_apply, MonoidHom.comp_apply,
      Subgroup.subtype_apply] using hp
  exact Subtype.ext (Subtype.ext hperm)

private theorem m11Sylow5Centralizer_card :
    Nat.card m11Sylow5Centralizer = 5 := by
  have hdvd25 : Nat.card m11Sylow5Centralizer ∣ 25 := by
    rw [← m11Sylow5EvenAmbientCentralizer_card]
    exact Subgroup.card_dvd_of_injective
      m11Sylow5CentralizerToEvenAmbient
      m11Sylow5CentralizerToEvenAmbient_injective
  have hdvd7920 : Nat.card m11Sylow5Centralizer ∣ 7920 := by
    rw [← m11_order]
    exact Subgroup.card_subgroup_dvd_card m11Sylow5Centralizer
  have hPcentralizer : m11Sylow5Subgroup ≤ m11Sylow5Centralizer := by
    rw [← m11Sylow5Centralizer_eq_subgroupCentralizer]
    let : IsMulCommutative m11Sylow5Subgroup :=
      Subgroup.zpowers_isMulCommutative m11Sylow5Generator
    exact Subgroup.le_centralizer m11Sylow5Subgroup
  have hdvd5 : 5 ∣ Nat.card m11Sylow5Centralizer := by
    rw [← m11Sylow5Subgroup_card]
    exact Subgroup.card_dvd_of_injective
      (Subgroup.inclusion hPcentralizer)
      (Subgroup.inclusion_injective _)
  have hdvdGcd :
      Nat.card m11Sylow5Centralizer ∣ Nat.gcd 25 7920 :=
    Nat.dvd_gcd hdvd25 hdvd7920
  norm_num at hdvdGcd
  exact Nat.dvd_antisymm hdvdGcd hdvd5

private theorem m11Sylow5Complement_conj_generator :
    m11GeneratorBInM11 * m11Sylow5Generator * m11GeneratorBInM11⁻¹ =
      m11Sylow5Generator ^ 2 := by
  apply Subtype.ext
  change
    m11GeneratorB * (m11CentralizerWordRight : Equiv.Perm (Fin 11)) *
        m11GeneratorB⁻¹ =
      (m11CentralizerWordRight : Equiv.Perm (Fin 11)) ^ 2
  rw [m11CentralizerWordRight_perm]
  ext x
  fin_cases x <;> rfl

private theorem m11Sylow5Complement_inv_conj_generator :
    m11GeneratorBInM11⁻¹ * m11Sylow5Generator * m11GeneratorBInM11 =
      m11Sylow5Generator ^ 3 := by
  apply Subtype.ext
  change
    m11GeneratorB⁻¹ * (m11CentralizerWordRight : Equiv.Perm (Fin 11)) *
        m11GeneratorB =
      (m11CentralizerWordRight : Equiv.Perm (Fin 11)) ^ 3
  rw [m11CentralizerWordRight_perm]
  ext x
  fin_cases x <;> rfl

private theorem m11Sylow5ComplementGenerator_mem_normalizer :
    m11GeneratorBInM11 ∈
      Subgroup.normalizer (m11Sylow5Subgroup : Set M11) := by
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh
    change h ∈ Subgroup.zpowers m11Sylow5Generator at hh
    rcases Subgroup.mem_zpowers_iff.mp hh with ⟨k, hk⟩
    change
      m11GeneratorBInM11 * h * m11GeneratorBInM11⁻¹ ∈
        Subgroup.zpowers m11Sylow5Generator
    rw [← hk, ← conj_zpow, m11Sylow5Complement_conj_generator]
    exact (Subgroup.zpowers m11Sylow5Generator).zpow_mem
      (Subgroup.npow_mem_zpowers m11Sylow5Generator 2) k
  · intro hh
    change
      m11GeneratorBInM11 * h * m11GeneratorBInM11⁻¹ ∈
        Subgroup.zpowers m11Sylow5Generator at hh
    rcases Subgroup.mem_zpowers_iff.mp hh with ⟨k, hk⟩
    change h ∈ Subgroup.zpowers m11Sylow5Generator
    have heq :
        h = (m11GeneratorBInM11⁻¹ * m11Sylow5Generator *
          m11GeneratorBInM11) ^ k := by
      calc
        h = m11GeneratorBInM11⁻¹ *
            (m11GeneratorBInM11 * h * m11GeneratorBInM11⁻¹) *
              m11GeneratorBInM11 := by simp [mul_assoc]
        _ = m11GeneratorBInM11⁻¹ * m11Sylow5Generator ^ k *
              m11GeneratorBInM11 := by rw [← hk]
        _ = (m11GeneratorBInM11⁻¹ * m11Sylow5Generator *
              m11GeneratorBInM11) ^ k := by
              simpa using (conj_zpow (a := m11GeneratorBInM11⁻¹)
                (b := m11Sylow5Generator) (i := k)).symm
    rw [heq, m11Sylow5Complement_inv_conj_generator]
    exact (Subgroup.zpowers m11Sylow5Generator).zpow_mem
      (Subgroup.npow_mem_zpowers m11Sylow5Generator 3) k

/-- The explicit order-four complement normalizes the chosen Sylow 5-subgroup. -/
public theorem m11Sylow5Complement_normalizes :
    m11Sylow5Complement ≤
      Subgroup.normalizer (m11Sylow5Subgroup : Set M11) := by
  rw [m11Sylow5Complement, Subgroup.zpowers_le]
  exact m11Sylow5ComplementGenerator_mem_normalizer

/-- The normalizer of the chosen Sylow 5-subgroup. -/
public noncomputable abbrev m11Sylow5Normalizer : Subgroup M11 :=
  Subgroup.normalizer (m11Sylow5Subgroup : Set M11)

private theorem m11Sylow5Normalizer_ker_card :
    Nat.card m11Sylow5Subgroup.normalizerMonoidHom.ker = 5 := by
  rw [Subgroup.normalizerMonoidHom_ker]
  have hle : m11Sylow5Centralizer ≤ m11Sylow5Normalizer := by
    rw [← m11Sylow5Centralizer_eq_subgroupCentralizer]
    exact Subgroup.centralizer_le_normalizer (m11Sylow5Subgroup : Set M11)
  calc
    Nat.card
        ((Subgroup.centralizer (m11Sylow5Subgroup : Set M11)).subgroupOf
          m11Sylow5Normalizer) = Nat.card m11Sylow5Centralizer := by
      rw [m11Sylow5Centralizer_eq_subgroupCentralizer]
      exact Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe hle).toEquiv
    _ = 5 := m11Sylow5Centralizer_card

private theorem m11Sylow5MulAut_card :
    Nat.card (MulAut m11Sylow5Subgroup) = 4 := by
  let : IsCyclic m11Sylow5Subgroup :=
    Subgroup.isCyclic_zpowers m11Sylow5Generator
  rw [IsCyclic.card_mulAut m11Sylow5Subgroup, m11Sylow5Subgroup_card]
  decide +kernel

private theorem m11Sylow5Normalizer_card_dvd_twenty :
    Nat.card m11Sylow5Normalizer ∣ 20 := by
  let f := m11Sylow5Subgroup.normalizerMonoidHom
  have hrange : Nat.card f.range ∣ 4 := by
    rw [← m11Sylow5MulAut_card]
    exact Subgroup.card_subgroup_dvd_card f.range
  have hmul : 5 * Nat.card f.range = Nat.card m11Sylow5Normalizer := by
    have h := Subgroup.card_mul_index f.ker
    rw [Subgroup.index_ker, m11Sylow5Normalizer_ker_card] at h
    exact h
  rcases hrange with ⟨k, hk⟩
  refine ⟨k, ?_⟩
  calc
    20 = 5 * 4 := by norm_num
    _ = 5 * (Nat.card f.range * k) := by rw [hk]
    _ = (5 * Nat.card f.range) * k := by rw [mul_assoc]
    _ = Nat.card m11Sylow5Normalizer * k := by rw [hmul]

private theorem m11Sylow5Normalizer_twenty_dvd_card :
    20 ∣ Nat.card m11Sylow5Normalizer := by
  have hgen : m11Sylow5Generator ∈ m11Sylow5Subgroup := by
    rw [m11Sylow5Subgroup]
    exact Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩
  let x : m11Sylow5Normalizer :=
    ⟨m11Sylow5Generator, Subgroup.le_normalizer hgen⟩
  let y : m11Sylow5Normalizer :=
    ⟨m11GeneratorBInM11, m11Sylow5ComplementGenerator_mem_normalizer⟩
  have hx : orderOf x = 5 := by
    rw [← Subgroup.orderOf_coe x]
    exact m11Sylow5Generator_order
  have hy : orderOf y = 4 := by
    rw [← Subgroup.orderOf_coe y]
    exact m11GeneratorBInM11_order
  have hxDvd : 5 ∣ Nat.card m11Sylow5Normalizer := by
    rw [← hx]
    exact orderOf_dvd_natCard x
  have hyDvd : 4 ∣ Nat.card m11Sylow5Normalizer := by
    rw [← hy]
    exact orderOf_dvd_natCard y
  exact Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) hxDvd hyDvd

/-- The normalizer of the chosen Sylow 5-subgroup has order 20. -/
public theorem m11Sylow5_normalizer_card :
    Nat.card m11Sylow5Normalizer = 20 :=
  Nat.dvd_antisymm m11Sylow5Normalizer_card_dvd_twenty
    m11Sylow5Normalizer_twenty_dvd_card
/-- The normal cyclic subgroup inside its order-twenty normalizer. -/
public noncomputable abbrev m11Sylow5NormalizerKernel :
    Subgroup m11Sylow5Normalizer :=
  m11Sylow5Subgroup.subgroupOf m11Sylow5Normalizer

/-- The order-four subgroup inside the Sylow-5 normalizer. -/
public noncomputable def m11Sylow5NormalizerComplement :
    Subgroup m11Sylow5Normalizer :=
  m11Sylow5Complement.subgroupOf m11Sylow5Normalizer

public theorem m11Sylow5NormalizerKernel_card :
    Nat.card m11Sylow5NormalizerKernel = 5 := by
  calc
    Nat.card m11Sylow5NormalizerKernel = Nat.card m11Sylow5Subgroup :=
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe Subgroup.le_normalizer).toEquiv
    _ = 5 := m11Sylow5Subgroup_card

public theorem m11Sylow5NormalizerComplement_card :
    Nat.card m11Sylow5NormalizerComplement = 4 := by
  calc
    Nat.card m11Sylow5NormalizerComplement = Nat.card m11Sylow5Complement :=
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe m11Sylow5Complement_normalizes).toEquiv
    _ = 4 := m11Sylow5Complement_card

private noncomputable instance m11Sylow5NormalizerKernel_normal :
    m11Sylow5NormalizerKernel.Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer
    (H := m11Sylow5Normalizer) (N := m11Sylow5Subgroup) le_rfl

/-- The cyclic order-five kernel and cyclic order-four subgroup complement each other. -/
public theorem m11Sylow5_normalizer_isComplement :
    m11Sylow5NormalizerKernel.IsComplement'
      m11Sylow5NormalizerComplement := by
  apply Subgroup.isComplement'_of_coprime
  · rw [m11Sylow5NormalizerKernel_card,
      m11Sylow5NormalizerComplement_card, m11Sylow5_normalizer_card]
  · rw [m11Sylow5NormalizerKernel_card,
      m11Sylow5NormalizerComplement_card]
    norm_num

/-- The Sylow-5 normalizer is the Frobenius semidirect product C5 : C4. -/
@[expose]
public noncomputable def m11Sylow5_normalizer_mulEquiv_frobenius :
    m11Sylow5NormalizerKernel ⋊[
      m11Sylow5NormalizerKernel.normalizerMonoidHom.comp
        (Subgroup.inclusion
          (m11Sylow5NormalizerKernel.normalizer_eq_top ▸ le_top))]
      m11Sylow5NormalizerComplement ≃* m11Sylow5Normalizer :=
  SemidirectProduct.mulEquivSubgroup m11Sylow5_normalizer_isComplement
/-- The explicit order-eleven generator `AB` in the natural M11 model. -/
@[expose]
public noncomputable def m11Sylow11Generator : M11 :=
  m11GeneratorAInM11 * m11GeneratorBInM11

/-- The chosen order-eleven generator has order eleven. -/
public theorem m11Sylow11Generator_order :
    orderOf m11Sylow11Generator = 11 := by
  rw [← Subgroup.orderOf_coe m11Sylow11Generator]
  change orderOf (m11GeneratorA * m11GeneratorB) = 11
  exact m11GeneratorAB_order

/-- The explicit cyclic subgroup generated by the order-eleven element. -/
public noncomputable def m11Sylow11Subgroup : Subgroup M11 :=
  Subgroup.zpowers m11Sylow11Generator

/-- The selected eleven-element belongs to its explicitly generated subgroup. -/
public theorem m11Sylow11Generator_mem_subgroup :
    m11Sylow11Generator ∈ m11Sylow11Subgroup :=
  Subgroup.mem_zpowers _

/-- The explicit cyclic order-eleven subgroup has cardinality eleven. -/
public theorem m11Sylow11Subgroup_card :
    Nat.card m11Sylow11Subgroup = 11 := by
  rw [m11Sylow11Subgroup, Nat.card_zpowers, m11Sylow11Generator_order]

private theorem m11_factorization_eleven :
    Nat.factorization 7920 11 = 1 := by
  have hzero : padicValNat 11 720 = 0 :=
    padicValNat.eq_zero_iff.mpr (Or.inr (Or.inr (by norm_num)))
  rw [Nat.factorization_def 7920 Nat.prime_eleven,
    show (7920 : Nat) = 11 ^ 1 * 720 by norm_num,
    padicValNat_base_pow_mul (by norm_num) (by norm_num) 1, hzero]

/-- A Sylow eleven-subgroup represented by the explicit cyclic subgroup. -/
@[expose]
public noncomputable def m11Sylow11 : Sylow 11 M11 := by
  let : Fact (Nat.Prime 11) := ⟨Nat.prime_eleven⟩
  exact Sylow.ofCard m11Sylow11Subgroup (by
    rw [m11Sylow11Subgroup_card, m11_order, m11_factorization_eleven]
    norm_num)

/-- The underlying subgroup of `m11Sylow11` is the explicit cyclic subgroup. -/
public theorem m11Sylow11_coe :
    (m11Sylow11 : Subgroup M11) = m11Sylow11Subgroup := by
  rfl
/-- The explicit order-five complement for the Sylow-eleven normalizer. -/
@[expose]
public noncomputable def m11Sylow11Complement : M11 :=
  m11GeneratorAInM11 * m11GeneratorBInM11⁻¹ * m11GeneratorAInM11 *
    m11GeneratorBInM11 * m11GeneratorBInM11 * m11GeneratorAInM11 *
      m11GeneratorBInM11⁻¹ * m11GeneratorAInM11 * m11GeneratorBInM11 *
        m11GeneratorBInM11 * m11GeneratorAInM11 * m11GeneratorBInM11⁻¹ *
          m11GeneratorAInM11 * m11GeneratorBInM11⁻¹ * m11GeneratorAInM11 *
            m11GeneratorBInM11⁻¹

private def m11Sylow11ComplementPerm : Equiv.Perm (Fin 11) :=
  m11GeneratorA * m11GeneratorB⁻¹ * m11GeneratorA *
    m11GeneratorB * m11GeneratorB * m11GeneratorA * m11GeneratorB⁻¹ *
      m11GeneratorA * m11GeneratorB * m11GeneratorB * m11GeneratorA *
        m11GeneratorB⁻¹ * m11GeneratorA * m11GeneratorB⁻¹ * m11GeneratorA *
          m11GeneratorB⁻¹

private theorem m11Sylow11Complement_perm :
    (m11Sylow11Complement : Equiv.Perm (Fin 11)) = m11Sylow11ComplementPerm :=
  rfl

/-- The explicit complement has order five. -/
public theorem m11Sylow11Complement_order : orderOf m11Sylow11Complement = 5 := by
  let : Fact (Nat.Prime 5) := ⟨Nat.prime_five⟩
  apply orderOf_eq_prime
  · apply Subtype.ext
    change m11Sylow11ComplementPerm ^ 5 = 1
    ext x
    fin_cases x <;> rfl
  · intro h
    have h0 := congrArg (fun z : M11 => (z : Equiv.Perm (Fin 11)) 0) h
    rw [m11Sylow11Complement_perm] at h0
    change m11Sylow11ComplementPerm 0 = 0 at h0
    have hne : m11Sylow11ComplementPerm 0 ≠ 0 := by decide +kernel
    exact hne h0

/-- The order-five complement acts on the order-eleven generator by multiplier four. -/
public theorem m11Sylow11Complement_conj_generator :
    m11Sylow11Complement * m11Sylow11Generator * m11Sylow11Complement⁻¹ =
      m11Sylow11Generator ^ 4 := by
  apply Subtype.ext
  change (m11Sylow11Complement : Equiv.Perm (Fin 11)) *
      (m11Sylow11Generator : Equiv.Perm (Fin 11)) *
      (m11Sylow11Complement : Equiv.Perm (Fin 11))⁻¹ =
      (m11Sylow11Generator : Equiv.Perm (Fin 11)) ^ 4
  rw [m11Sylow11Complement_perm]
  rw [show (m11Sylow11Generator : Equiv.Perm (Fin 11)) =
      List.formPerm [0, 4, 3, 9, 10, 2, 7, 5, 6, 8, 1] by
        ext x
        fin_cases x <;> rfl]
  ext x
  fin_cases x <;> rfl

private def m11Sylow11Inversion : Equiv.Perm (Fin 11) :=
  Equiv.swap (1 : Fin 11) 4 * Equiv.swap (3 : Fin 11) 8 *
    Equiv.swap (9 : Fin 11) 6 * Equiv.swap (10 : Fin 11) 5 *
      Equiv.swap (2 : Fin 11) 7

private theorem m11Sylow11Generator_perm :
    (m11Sylow11Generator : Equiv.Perm (Fin 11)) =
      List.formPerm [0, 4, 3, 9, 10, 2, 7, 5, 6, 8, 1] := by
  ext x
  fin_cases x <;> rfl

private theorem m11Sylow11Inversion_conj :
    m11Sylow11Inversion * (m11Sylow11Generator : Equiv.Perm (Fin 11)) *
        m11Sylow11Inversion⁻¹ = (m11Sylow11Generator : Equiv.Perm (Fin 11))⁻¹ := by
  rw [m11Sylow11Generator_perm]
  ext x
  fin_cases x <;> rfl

private theorem m11Sylow11Inversion_inv_conj :
    m11Sylow11Inversion⁻¹ * (m11Sylow11Generator : Equiv.Perm (Fin 11)) *
        m11Sylow11Inversion = (m11Sylow11Generator : Equiv.Perm (Fin 11))⁻¹ := by
  rw [m11Sylow11Generator_perm]
  ext x
  fin_cases x <;> rfl

private theorem m11Sylow11Inversion_sign :
    Equiv.Perm.sign m11Sylow11Inversion = -1 := by
  simp [m11Sylow11Inversion]

private noncomputable abbrev m11Sylow11AmbientSubgroup :
    Subgroup (Equiv.Perm (Fin 11)) :=
  Subgroup.zpowers (m11Sylow11Generator : Equiv.Perm (Fin 11))

private noncomputable abbrev m11Sylow11AmbientNormalizer :
    Subgroup (Equiv.Perm (Fin 11)) :=
  Subgroup.normalizer (m11Sylow11AmbientSubgroup : Set (Equiv.Perm (Fin 11)))

private theorem m11Sylow11AmbientGenerator_cycleType :
    (m11Sylow11Generator : Equiv.Perm (Fin 11)).cycleType = {11} := by
  rw [m11Sylow11Generator_perm]
  decide +kernel

private theorem m11Sylow11AmbientCentralizer_card :
    Nat.card (Subgroup.centralizer
      (m11Sylow11AmbientSubgroup : Set (Equiv.Perm (Fin 11)))) = 11 := by
  rw [m11Sylow11AmbientSubgroup, Subgroup.zpowers_eq_closure,
    Subgroup.centralizer_closure, Equiv.Perm.nat_card_centralizer,
    m11Sylow11AmbientGenerator_cycleType]
  norm_num

private theorem m11Sylow11AmbientMulAut_card :
    Nat.card (MulAut m11Sylow11AmbientSubgroup) = 10 := by
  let : IsCyclic m11Sylow11AmbientSubgroup :=
    Subgroup.isCyclic_zpowers (m11Sylow11Generator : Equiv.Perm (Fin 11))
  rw [IsCyclic.card_mulAut]
  have hPcard : Nat.card m11Sylow11AmbientSubgroup = 11 := by
    rw [m11Sylow11AmbientSubgroup, Nat.card_zpowers]
    exact (Subgroup.orderOf_coe m11Sylow11Generator).trans m11Sylow11Generator_order
  rw [hPcard, Nat.totient_prime Nat.prime_eleven]

private theorem m11Sylow11Inversion_mem_normalizer :
    m11Sylow11Inversion ∈ m11Sylow11AmbientNormalizer := by
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh
    change h ∈ Subgroup.zpowers (m11Sylow11Generator : Equiv.Perm (Fin 11)) at hh
    rcases Subgroup.mem_zpowers_iff.mp hh with ⟨k, hk⟩
    change m11Sylow11Inversion * h * m11Sylow11Inversion⁻¹ ∈
      Subgroup.zpowers (m11Sylow11Generator : Equiv.Perm (Fin 11))
    rw [← hk, ← conj_zpow, m11Sylow11Inversion_conj]
    simp
  · intro hh
    change m11Sylow11Inversion * h * m11Sylow11Inversion⁻¹ ∈
      Subgroup.zpowers (m11Sylow11Generator : Equiv.Perm (Fin 11)) at hh
    rcases Subgroup.mem_zpowers_iff.mp hh with ⟨k, hk⟩
    change h ∈ Subgroup.zpowers (m11Sylow11Generator : Equiv.Perm (Fin 11))
    have heq : h = (m11Sylow11Inversion⁻¹ *
        (m11Sylow11Generator : Equiv.Perm (Fin 11)) * m11Sylow11Inversion) ^ k := by
      calc
        h = m11Sylow11Inversion⁻¹ *
            (m11Sylow11Inversion * h * m11Sylow11Inversion⁻¹) *
              m11Sylow11Inversion := by simp [mul_assoc]
        _ = m11Sylow11Inversion⁻¹ *
            (m11Sylow11Generator : Equiv.Perm (Fin 11)) ^ k *
              m11Sylow11Inversion := by rw [← hk]
        _ = (m11Sylow11Inversion⁻¹ *
            (m11Sylow11Generator : Equiv.Perm (Fin 11)) *
              m11Sylow11Inversion) ^ k := by
          simpa using (conj_zpow (a := m11Sylow11Inversion⁻¹)
            (b := (m11Sylow11Generator : Equiv.Perm (Fin 11))) (i := k)).symm
    rw [heq, m11Sylow11Inversion_inv_conj]
    simp

private theorem m11Sylow11AmbientNormalizer_card_dvd_110 :
    Nat.card m11Sylow11AmbientNormalizer ∣ 110 := by
  let f := m11Sylow11AmbientSubgroup.normalizerMonoidHom
  have hker : Nat.card f.ker = 11 := by
    rw [Subgroup.normalizerMonoidHom_ker]
    have hle : Subgroup.centralizer
        (m11Sylow11AmbientSubgroup : Set (Equiv.Perm (Fin 11))) ≤
          m11Sylow11AmbientNormalizer := Subgroup.centralizer_le_normalizer _
    calc
      Nat.card ((Subgroup.centralizer
          (m11Sylow11AmbientSubgroup : Set (Equiv.Perm (Fin 11)))).subgroupOf
            m11Sylow11AmbientNormalizer) =
          Nat.card (Subgroup.centralizer
            (m11Sylow11AmbientSubgroup : Set (Equiv.Perm (Fin 11)))) :=
        Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv
      _ = 11 := m11Sylow11AmbientCentralizer_card
  have hrange : Nat.card f.range ∣ 10 := by
    rw [← m11Sylow11AmbientMulAut_card]
    exact Subgroup.card_subgroup_dvd_card f.range
  have hmul : 11 * Nat.card f.range = Nat.card m11Sylow11AmbientNormalizer := by
    have h := Subgroup.card_mul_index f.ker
    rw [Subgroup.index_ker, hker] at h
    exact h
  rcases hrange with ⟨k, hk⟩
  refine ⟨k, ?_⟩
  calc
    110 = 11 * 10 := by norm_num
    _ = 11 * (Nat.card f.range * k) := by rw [hk]
    _ = (11 * Nat.card f.range) * k := by rw [mul_assoc]
    _ = Nat.card m11Sylow11AmbientNormalizer * k := by rw [hmul]

private theorem m11Sylow11AmbientEvenKernel_card_le :
    Nat.card ((Equiv.Perm.sign.comp m11Sylow11AmbientNormalizer.subtype).ker) ≤ 55 := by
  let s : m11Sylow11AmbientNormalizer →* ℤˣ :=
    Equiv.Perm.sign.comp m11Sylow11AmbientNormalizer.subtype
  have hs : Function.Surjective s := by
    intro u
    rcases Int.units_eq_one_or u with rfl | rfl
    · exact ⟨1, rfl⟩
    · exact ⟨⟨m11Sylow11Inversion, m11Sylow11Inversion_mem_normalizer⟩,
        m11Sylow11Inversion_sign⟩
  have hindex : s.ker.index = 2 := by
    rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hs]
    norm_num
  have hmul := Subgroup.card_mul_index s.ker
  rw [hindex] at hmul
  rcases m11Sylow11AmbientNormalizer_card_dvd_110 with ⟨k, hk⟩
  have hEq : 2 * 55 = 2 * (Nat.card s.ker * k) := by
    calc
      2 * 55 = 110 := by norm_num
      _ = Nat.card m11Sylow11AmbientNormalizer * k := hk
      _ = (Nat.card s.ker * 2) * k := by rw [← hmul]
      _ = 2 * (Nat.card s.ker * k) := by ac_rfl
  have hEq2 : 55 = Nat.card s.ker * k := Nat.mul_left_cancel (by norm_num) hEq
  have hdiv : Nat.card s.ker ∣ 55 := ⟨k, hEq2⟩
  exact Nat.le_of_dvd (by norm_num) hdiv

private theorem m11Sylow11Complement_inv_conj_generator :
    m11Sylow11Complement⁻¹ * m11Sylow11Generator * m11Sylow11Complement =
      m11Sylow11Generator ^ 3 := by
  apply Subtype.ext
  change m11Sylow11ComplementPerm⁻¹ *
      (m11Sylow11Generator : Equiv.Perm (Fin 11)) *
      m11Sylow11ComplementPerm =
      (m11Sylow11Generator : Equiv.Perm (Fin 11)) ^ 3
  rw [show (m11Sylow11Generator : Equiv.Perm (Fin 11)) =
      List.formPerm [0, 4, 3, 9, 10, 2, 7, 5, 6, 8, 1] by
        ext x
        fin_cases x <;> rfl]
  ext x
  fin_cases x <;> rfl

/-- The explicit order-five complement for the Sylow-eleven normalizer. -/
@[expose]
public noncomputable def m11Sylow11ComplementSubgroup : Subgroup M11 :=
  Subgroup.zpowers m11Sylow11Complement

/-- The explicit complement subgroup has order five. -/
public theorem m11Sylow11ComplementSubgroup_card :
    Nat.card m11Sylow11ComplementSubgroup = 5 := by
  rw [m11Sylow11ComplementSubgroup, Nat.card_zpowers,
    m11Sylow11Complement_order]

private theorem m11Sylow11Complement_mem_normalizer :
    m11Sylow11Complement ∈
      Subgroup.normalizer (m11Sylow11Subgroup : Set M11) := by
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh
    change h ∈ Subgroup.zpowers m11Sylow11Generator at hh
    rcases Subgroup.mem_zpowers_iff.mp hh with ⟨k, hk⟩
    change m11Sylow11Complement * h * m11Sylow11Complement⁻¹ ∈
      Subgroup.zpowers m11Sylow11Generator
    rw [← hk, ← conj_zpow, m11Sylow11Complement_conj_generator]
    exact (Subgroup.zpowers m11Sylow11Generator).zpow_mem
      (Subgroup.npow_mem_zpowers m11Sylow11Generator 4) k
  · intro hh
    change m11Sylow11Complement * h * m11Sylow11Complement⁻¹ ∈
      Subgroup.zpowers m11Sylow11Generator at hh
    rcases Subgroup.mem_zpowers_iff.mp hh with ⟨k, hk⟩
    change h ∈ Subgroup.zpowers m11Sylow11Generator
    have heq :
        h = (m11Sylow11Complement⁻¹ * m11Sylow11Generator *
          m11Sylow11Complement) ^ k := by
      calc
        h = m11Sylow11Complement⁻¹ *
            (m11Sylow11Complement * h * m11Sylow11Complement⁻¹) *
              m11Sylow11Complement := by simp [mul_assoc]
        _ = m11Sylow11Complement⁻¹ * m11Sylow11Generator ^ k *
              m11Sylow11Complement := by rw [← hk]
        _ = (m11Sylow11Complement⁻¹ * m11Sylow11Generator *
              m11Sylow11Complement) ^ k := by
          simpa using (conj_zpow (a := m11Sylow11Complement⁻¹)
            (b := m11Sylow11Generator) (i := k)).symm
    rw [heq, m11Sylow11Complement_inv_conj_generator]
    exact (Subgroup.zpowers m11Sylow11Generator).zpow_mem
      (Subgroup.npow_mem_zpowers m11Sylow11Generator 3) k

/-- The explicit order-five subgroup normalizes the chosen Sylow-eleven subgroup. -/
public theorem m11Sylow11Complement_normalizes :
    m11Sylow11ComplementSubgroup ≤
      Subgroup.normalizer (m11Sylow11Subgroup : Set M11) := by
  rw [m11Sylow11ComplementSubgroup, Subgroup.zpowers_le]
  exact m11Sylow11Complement_mem_normalizer

/-- The normalizer of the chosen Sylow-eleven subgroup. -/
public noncomputable abbrev m11Sylow11Normalizer : Subgroup M11 :=
  Subgroup.normalizer (m11Sylow11Subgroup : Set M11)

private theorem m11Sylow11Subgroup_map_subtype :
    m11Sylow11Subgroup.map M11.subtype = m11Sylow11AmbientSubgroup := by
  rw [m11Sylow11Subgroup, MonoidHom.map_zpowers]
  change Subgroup.zpowers ((m11Sylow11Generator : M11) : Equiv.Perm (Fin 11)) =
    Subgroup.zpowers ((m11Sylow11Generator : M11) : Equiv.Perm (Fin 11))
  rfl

private theorem m11Sylow11Normalizer_map_le_ambient :
    m11Sylow11Normalizer.map M11.subtype ≤ m11Sylow11AmbientNormalizer := by
  calc
    m11Sylow11Normalizer.map M11.subtype ≤
        Subgroup.normalizer (m11Sylow11Subgroup.map M11.subtype :
          Set (Equiv.Perm (Fin 11))) :=
      Subgroup.le_normalizer_map M11.subtype
    _ = m11Sylow11AmbientNormalizer := by
      rw [m11Sylow11Subgroup_map_subtype]

private noncomputable def m11Sylow11NormalizerToAmbient :
    m11Sylow11Normalizer →* m11Sylow11AmbientNormalizer :=
  (M11.subtype.comp m11Sylow11Normalizer.subtype).codRestrict
    m11Sylow11AmbientNormalizer (fun g =>
      m11Sylow11Normalizer_map_le_ambient ⟨g, g.property, rfl⟩)

private noncomputable def m11Sylow11NormalizerToAmbientEven :
    m11Sylow11Normalizer →*
      (Equiv.Perm.sign.comp m11Sylow11AmbientNormalizer.subtype).ker :=
  m11Sylow11NormalizerToAmbient.codRestrict
    (Equiv.Perm.sign.comp m11Sylow11AmbientNormalizer.subtype).ker (fun g => by
      change Equiv.Perm.sign ((g : M11) : Equiv.Perm (Fin 11)) = 1
      exact m11_sign_eq_one g)

private theorem m11Sylow11NormalizerToAmbientEven_injective :
    Function.Injective m11Sylow11NormalizerToAmbientEven := by
  intro g h hh
  have hp := congrArg
    (fun q : (Equiv.Perm.sign.comp m11Sylow11AmbientNormalizer.subtype).ker =>
      ((q : m11Sylow11AmbientNormalizer) : Equiv.Perm (Fin 11))) hh
  have hperm :
      ((g : M11) : Equiv.Perm (Fin 11)) =
        ((h : M11) : Equiv.Perm (Fin 11)) := by
    simpa only [m11Sylow11NormalizerToAmbientEven,
      MonoidHom.codRestrict_apply, m11Sylow11NormalizerToAmbient,
      MonoidHom.comp_apply, Subgroup.subtype_apply] using hp
  exact Subtype.ext (Subtype.ext hperm)

private theorem m11Sylow11_normalizer_card_le :
    Nat.card m11Sylow11Normalizer ≤ 55 := by
  have hdiv : Nat.card m11Sylow11Normalizer ∣
      Nat.card ((Equiv.Perm.sign.comp m11Sylow11AmbientNormalizer.subtype).ker) :=
    Subgroup.card_dvd_of_injective m11Sylow11NormalizerToAmbientEven
      m11Sylow11NormalizerToAmbientEven_injective
  exact (Nat.le_of_dvd Nat.card_pos hdiv).trans
    m11Sylow11AmbientEvenKernel_card_le

private theorem m11Sylow11_normalizer_fiftyfive_dvd_card :
    55 ∣ Nat.card m11Sylow11Normalizer := by
  have hgen : m11Sylow11Generator ∈ m11Sylow11Subgroup := by
    rw [m11Sylow11Subgroup]
    exact Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩
  let x : m11Sylow11Normalizer :=
    ⟨m11Sylow11Generator, Subgroup.le_normalizer hgen⟩
  let y : m11Sylow11Normalizer :=
    ⟨m11Sylow11Complement, m11Sylow11Complement_mem_normalizer⟩
  have hx : orderOf x = 11 := by
    rw [← Subgroup.orderOf_coe x]
    exact m11Sylow11Generator_order
  have hy : orderOf y = 5 := by
    rw [← Subgroup.orderOf_coe y]
    exact m11Sylow11Complement_order
  have hxDvd : 11 ∣ Nat.card m11Sylow11Normalizer := by
    have h := orderOf_dvd_natCard x
    simpa only [hx] using h
  have hyDvd : 5 ∣ Nat.card m11Sylow11Normalizer := by
    have h := orderOf_dvd_natCard y
    simpa only [hy] using h
  exact Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) hxDvd hyDvd

/-- The normalizer of the chosen Sylow-eleven subgroup has order fifty-five. -/
public theorem m11Sylow11_normalizer_card :
    Nat.card m11Sylow11Normalizer = 55 := by
  have hge : 55 ≤ Nat.card m11Sylow11Normalizer :=
    Nat.le_of_dvd Nat.card_pos m11Sylow11_normalizer_fiftyfive_dvd_card
  exact Nat.le_antisymm m11Sylow11_normalizer_card_le hge

/-- The normal cyclic subgroup inside the Sylow-eleven normalizer. -/
public noncomputable abbrev m11Sylow11NormalizerKernel :
    Subgroup m11Sylow11Normalizer :=
  m11Sylow11Subgroup.subgroupOf m11Sylow11Normalizer

/-- The cyclic order-five complement inside the Sylow-eleven normalizer. -/
public noncomputable def m11Sylow11NormalizerComplement :
    Subgroup m11Sylow11Normalizer :=
  m11Sylow11ComplementSubgroup.subgroupOf m11Sylow11Normalizer

public theorem m11Sylow11NormalizerKernel_card :
    Nat.card m11Sylow11NormalizerKernel = 11 := by
  calc
    Nat.card m11Sylow11NormalizerKernel = Nat.card m11Sylow11Subgroup :=
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe Subgroup.le_normalizer).toEquiv
    _ = 11 := m11Sylow11Subgroup_card

public theorem m11Sylow11NormalizerComplement_card :
    Nat.card m11Sylow11NormalizerComplement = 5 := by
  calc
    Nat.card m11Sylow11NormalizerComplement =
        Nat.card m11Sylow11ComplementSubgroup :=
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe m11Sylow11Complement_normalizes).toEquiv
    _ = 5 := m11Sylow11ComplementSubgroup_card

private noncomputable instance m11Sylow11NormalizerKernel_normal :
    m11Sylow11NormalizerKernel.Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer
    (H := m11Sylow11Normalizer) (N := m11Sylow11Subgroup) le_rfl

/-- The cyclic order-eleven kernel and cyclic order-five subgroup complement each other. -/
public theorem m11Sylow11_normalizer_isComplement :
    m11Sylow11NormalizerKernel.IsComplement'
      m11Sylow11NormalizerComplement := by
  apply Subgroup.isComplement'_of_coprime
  · rw [m11Sylow11NormalizerKernel_card,
      m11Sylow11NormalizerComplement_card, m11Sylow11_normalizer_card]
  · rw [m11Sylow11NormalizerKernel_card,
      m11Sylow11NormalizerComplement_card]
    norm_num

/-- The Sylow-eleven normalizer is the Frobenius semidirect product C11 : C5. -/
@[expose]
public noncomputable def m11Sylow11_normalizer_mulEquiv_frobenius :
    m11Sylow11NormalizerKernel ⋊[
      m11Sylow11NormalizerKernel.normalizerMonoidHom.comp
        (Subgroup.inclusion
          (m11Sylow11NormalizerKernel.normalizer_eq_top ▸ le_top))]
      m11Sylow11NormalizerComplement ≃* m11Sylow11Normalizer :=
  SemidirectProduct.mulEquivSubgroup m11Sylow11_normalizer_isComplement
end Sporadic.Mathieu
