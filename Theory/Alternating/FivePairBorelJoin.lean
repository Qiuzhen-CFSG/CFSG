module
public import Theory.Alternating.FivePairBorelTorus
public import Theory.GroupTheory.NormalizedSupCard

/-!
# The Borel generated by a cubic plane and a Sylow in an A₅ square

The prescribed Sylow two-subgroup has order sixteen and its normalizer
has order 144. A normalizing three-subgroup of order nine is disjoint from
the Sylow, so their join fills this normalizer. The equivalence with the
actual alternating-five square and both prescribed subgroups are retained.

Source application: Aschbacher--Smith 8.3.10(1), printed pp.725--726.
The original tensor point-centralizer application is QuietTensorFiveBorel.
-/

public noncomputable section
open Subgroup
namespace Theory.AlternatingFive

/-- A prescribed cubic plane fills the odd part of the actual square Borel. -/
theorem sylow_normalizer_eq_cubic_join {A : Type*} [Group A] [Finite A]
    (e : A ≃* alternatingGroup (Fin 5) × alternatingGroup (Fin 5))
    (S : Sylow 2 A) (P : Subgroup A) (hP : IsPGroup 3 P) (hcP : Nat.card P = 9)
    (hPN : P ≤ normalizer (S : Set A)) :
    P ⊔ (S : Subgroup A) = normalizer (S : Set A) := by
  let R := S.mapSurjective (f := e.toMonoidHom) e.surjective
  have hN : Nat.card (normalizer (S : Set A)) = 144 := by
    rw [←card_map_of_injective (f := e.toMonoidHom) e.injective]
    change Nat.card ((normalizer ((S : Subgroup A) : Set A)).map e.toMonoidHom) = _
    rw [map_equiv_normalizer_eq]
    exact Theory.AlternatingFive.pair_sylow_normalizer_card R
  have hA : Nat.card A = 3600 := by
    rw [Nat.card_congr e.toEquiv,Nat.card_prod,nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  have hS : Nat.card S = 16 := by
    rw [S.card_eq_multiplicity,hA]
    decide +kernel
  apply eq_of_le_of_card_ge (sup_le hPN (S : Subgroup A).le_normalizer)
  rw [hN,sup_comm,card_sup_eq_mul_of_normalizes_of_disjoint _ _ hPN
    (S.isPGroup'.disjoint_of_coprime hP (by decide)),hS,hcP]

end Theory.AlternatingFive
