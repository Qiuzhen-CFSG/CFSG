module

public import Theory.SpecificGroups.G2Five.AtlasOctonionPair
public import Theory.AtlasPort.LinearGroups.G2.Torus

/-!
# Matrix certificates for the explicit octonion pair

A matrix is certified when it is the image of an element of the subgroup
generated by the fixed pair. Multiplication and certified inverse matrices
preserve this property. Faithfulness then transfers a certificate to any
specified octonion automorphism. This permits small, independently checked
matrix products to certify long words without unfolding their entire action.

Sources: `AtlasOctonionPair` and the word candidates retained in
`AtlasOctonionSource/generator_words.json`. The octonion formulas are from the
ATLAS port; see `LICENSES/ATLAS.txt` and `LICENSES/ATLAS-CITATION.cff`.
-/

@[expose] public section

namespace G2Five.AtlasPresentation.OctonionGeneration

abbrev Mat := Matrix (Fin 8) (Fin 8) (ZMod 5)

/-- The subgroup whose generation is to be certified. -/
def pairClosure : Subgroup (Atlas.G2.Model (ZMod 5)) :=
  Subgroup.closure {octonionGenerator false, octonionGenerator true}

/-- The chosen generator of the units of the prime field. -/
def twoUnit : (ZMod 5)ˣ := Units.mk0 2 (by decide)

/-- A matrix realized by a word in the fixed pair. -/
def MatrixInClosure (M : Mat) : Prop :=
  ∃ g ∈ pairClosure, octonionMatrix g = M

theorem matrixInClosure_a : MatrixInClosure octonionMatrixA :=
  ⟨octonionGenerator false, Subgroup.subset_closure (by simp), octonionMatrix_false⟩

theorem matrixInClosure_b : MatrixInClosure octonionMatrixB :=
  ⟨octonionGenerator true, Subgroup.subset_closure (by simp), octonionMatrix_true⟩

theorem matrixInClosure_mul {M N P : Mat} (hM : MatrixInClosure M)
    (hN : MatrixInClosure N) (hP : M * N = P) : MatrixInClosure P := by
  obtain ⟨g,hg,rfl⟩ := hM
  obtain ⟨h,hh,rfl⟩ := hN
  exact ⟨g*h, pairClosure.mul_mem hg hh, (map_mul _ _ _).trans hP⟩

theorem matrixInClosure_inv {M N : Mat} (hM : MatrixInClosure M)
    (hN : M * N = 1) : MatrixInClosure N := by
  obtain ⟨g,hg,rfl⟩ := hM
  refine ⟨g⁻¹, pairClosure.inv_mem hg, ?_⟩
  calc
    octonionMatrix g⁻¹ = octonionMatrix g⁻¹ * (octonionMatrix g * N) := by
      rw [hN, mul_one]
    _ = N := by
      rw [← mul_assoc, ← map_mul, inv_mul_cancel, map_one, one_mul]

theorem mem_of_matrixInClosure {g : Atlas.G2.Model (ZMod 5)} {M : Mat}
    (hM : MatrixInClosure M) (hg : octonionMatrix g = M) : g ∈ pairClosure := by
  obtain ⟨h,hh,he⟩ := hM
  have : g = h := octonionMatrix_injective (hg.trans he.symm)
  simpa only [this] using hh

end G2Five.AtlasPresentation.OctonionGeneration
