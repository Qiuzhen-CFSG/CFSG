module

public import Theory.SpecificGroups.G2Five.AtlasBoundSubgroup

/-!
# A replacement candidate presentation for the fixed word subgroup

These thirty literal relators use `a` and `b` for the two local generators,
which are to map to `boundGenerator false` and `boundGenerator true`.
They were extracted from GAP's fast presentation algorithm on the exact fixed
permutation pair, simplified while protecting both generators, and selected
as the first thirty relators. The retained words are the mathematical definition.

An independent GAP enumeration from these thirty words reports index 150000
for the cyclic subgroup generated by `a`; the first relation is `a^10`.
It also reports index 48 for the subgroup generated by `a` and `b^4`.
These observations guide a prospective certified subgroup-chain proof only.
Neither a finite bound nor validity of these relations in the ambient abstract
presentation is asserted here. Both must be proved before using the transfer
lemma in `AtlasBoundSubgroupOrder`.

The earlier seven-relator candidate is preserved: `AtlasBoundLocalOrder`
proves that it cannot satisfy the desired bound. No declarations from that
candidate are used here.

Source: ATLAS permutation data retained in `AtlasPresentationSource/` and the
fixed words in `AtlasBoundSubgroup`. See `AtlasBoundThirtySource/` for the exact
signed syllables, attribution, and reproducible discovery/checking scripts.
-/

namespace G2Five.AtlasPresentation

/-- Literal relators on the two local generators, using the usual a/A/b/B encoding. -/
@[expose] public def boundThirtyWord : Fin 30 → String
  | 0 => "aaaaaaaaaa"
  | 1 => "bAAAbbAbAbaaBA"
  | 2 => "bbbaBAABBABBBBA"
  | 3 => "AbbAABAbAbbAABAb"
  | 4 => "babbbabbbabbbabb"
  | 5 => "baabbaBabaabbaBa"
  | 6 => "bbbAbaaBABBabAbAb"
  | 7 => "BabAAbAbbabbbABBa"
  | 8 => "abbAbaaBBBaBABaBaB"
  | 9 => "AbbABABAbbabaaBBBA"
  | 10 => "aaababbbbABAAAbbbb"
  | 11 => "baaabaaaBababbABab"
  | 12 => "BaBAAbbaBABaaaBaaB"
  | 13 => "AbbabbABabbbAABaaaB"
  | 14 => "BaaababAABaBAABaBBA"
  | 15 => "abABaabbABAAbabbbAB"
  | 16 => "aBBABAAAbaaaBBBABBB"
  | 17 => "aaaBBBBababbaBaBaaB"
  | 18 => "BAAbbAbaBBaaBABAbbA"
  | 19 => "ABaBABaBababAAABABA"
  | 20 => "BBBAAAABBAAbbbaBaaB"
  | 21 => "aaabbbAbbAbABABABab"
  | 22 => "bAAAbaBBaabAAABAAAA"
  | 23 => "aaBaBAbbaaBBBBAbAAB"
  | 24 => "baabABaBABAbbaBBAba"
  | 25 => "aBAbbaaabbbbaaBaBAb"
  | 26 => "BaaaaabAAbbAAAAABBaa"
  | 27 => "bABaaBaaBBABaabaaaBa"
  | 28 => "BAbaaBBBBAABaaBaBaBa"
  | _ => "AAAbAAbbaBBAbAbbbABA"

/-- The exact thirty-relator replacement candidate. -/
@[expose] public def boundThirtyRelator (i : Fin 30) : FreeGroup Bool :=
  FreeGroup.mk (boundLetters (boundThirtyWord i))

/-- The cyclic subgroup used at the bottom of the direct enumeration has
exponent dividing ten. This is an identity of free-group words. -/
public theorem boundThirtyRelator_zero :
    boundThirtyRelator 0 = FreeGroup.of false ^ 10 := by
  rw [FreeGroup.of, FreeGroup.pow_mk]
  rfl

/-- This abstract presentation carries no assumed order or ambient identification. -/
@[expose] public def BoundThirtyPresentation :=
  PresentedGroup (Set.range boundThirtyRelator)
  deriving Group

end G2Five.AtlasPresentation
