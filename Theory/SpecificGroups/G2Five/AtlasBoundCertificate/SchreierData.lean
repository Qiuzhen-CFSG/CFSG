module

public import Theory.SpecificGroups.G2Five.AtlasBoundCertificate.SchreierParents
public import Theory.SpecificGroups.G2Five.AtlasBoundCertificate.SchreierDestinations
public import Theory.SpecificGroups.G2Five.AtlasBoundCertificate.SchreierEdgeCodes
public import Theory.SpecificGroups.G2Five.AtlasBoundCertificate.SchreierChoices
public import Theory.GroupTheory.CosetWordCertificate.Schreier

/-!
# Data and contracts for a Schreier reduction of the fixed-subgroup cover

The candidate table has 3906 vertices and a breadth-first representative tree.
A recorded reduction identifies its non-tree edge elements with 259 labels;
the first two labels name the fixed subgroup generators. These are data only.
In particular `reducedGenerators` does not assert that the reduction is sound.

Two independent proofs can use these data. The first proves `edge_sound` and
`ReducedRelations reducedGenerators` in the original presentation. The second
proves, in an arbitrary group satisfying `ReducedRelations`, that the 259 labels
belong to the subgroup generated by the first two. `transitionsOfMembership`
then constructs actual `Holds` equations, by the Schreier membership criterion.
Neither a permutation table nor its inverse consistency is a premise of that
criterion.

Source: the retained ATLAS pair, and the untrusted reduction recorded in
`SchreierSource/`. Final assembly belongs to `AtlasBoundCertificate.Transitions`.
-/

@[expose] public section
namespace G2Five.AtlasPresentation.SchreierBoundData
open Subgroup.CosetWordCertificate

abbrev ReducedAlphabet := Fin 259

def originalLetter (n : Nat) : Letter Bool := (n / 2 % 2 == 1, n % 2 == 0)

def originalCode (a : Letter Bool) : Nat :=
  (if a.1 then 2 else 0) + (if a.2 then 0 else 1)

def liftLetter (a : Letter Bool) : Letter BoundCertificate.Alphabet := (.inl a.1, a.2)

/-- The minimum makes the infinite extension acyclic without a table assumption. -/
def definitions : Definitions BoundCertificate.Alphabet where
  parent n := min (parents n).1 (n - 1)
  letter n := liftLetter (originalLetter (parents n).2)
  parent_lt n := by
    have := Nat.min_le_right (parents (n + 1)).1 (n + 1 - 1)
    omega

def representative : Nat → Model := definitions.repr BoundCertificate.generators

def next (i : Nat) (a : Letter Bool) : Nat :=
  destinations (4 * i + originalCode a) % 3906

def dest (i : Fin 3906) (a : Letter Bool) : Fin 3906 :=
  ⟨next i a, Nat.mod_lt _ (by decide)⟩

/-- Zero encodes an empty edge word; other codes encode a signed reduced label. -/
def decodeEdge (c : Nat) : Word ReducedAlphabet :=
  if c = 0 then [] else [(⟨((c - 1) / 2) % 259, Nat.mod_lt _ (by decide)⟩, c % 2 == 1)]

def edgeWord (i : Nat) (a : Letter Bool) : Word ReducedAlphabet :=
  decodeEdge (edgeCodes (4 * i + originalCode a))

def reducedTrace (i : Nat) : Word Bool → Word ReducedAlphabet
  | [] => []
  | a :: w => edgeWord i a ++ reducedTrace (next i a) w

def protectedLabel (b : Bool) : ReducedAlphabet :=
  ⟨if b then 1 else 0, by cases b <;> decide⟩

/-- The equations used by the abstract generation proof. Their validity in the
original model is a separate obligation, not inferred from the table. -/
def ReducedRelations {G : Type*} [Group G] (x : ReducedAlphabet → G) : Prop :=
  (∀ (i : Fin 3906) (r : Fin 22),
    eval x (reducedTrace i (boundLetters (word r))) = 1) ∧
  (∀ b : Bool, eval x (reducedTrace 0 (boundLetters (boundWord b))) = x (protectedLabel b))

/-- Actual group elements selected by the recorded collapse representatives. -/
def reducedGenerators (k : ReducedAlphabet) : Model :=
  if k.val = 0 then boundGenerator false else
  if k.val = 1 then boundGenerator true else
    let c := choices k.val
    let i := c.1 / 4
    let a := originalLetter (c.1 % 4)
    let x := edgeElement representative BoundCertificate.generators i (liftLetter a) (next i a)
    if c.2 = 0 then x else x⁻¹

theorem reducedGenerators_protected (b : Bool) :
    reducedGenerators (protectedLabel b) = boundGenerator b := by
  cases b <;> rfl

/-- A checked equality between the selected labels and every actual edge is the
first half of the reduction. It entails no membership claim on its own. -/
def EdgeSound : Prop := ∀ (i : Fin 3906) (a : Letter Bool),
  eval reducedGenerators (edgeWord i a) =
    edgeElement representative BoundCertificate.generators i (liftLetter a) (next i a)

/-- Final assembly needs genuine subgroup membership of the reduced labels. -/
def transitionsOfMembership (hedge : EdgeSound)
    (hmem : ∀ k, reducedGenerators k ∈ boundSubgroup) : BoundCosetTransitions where
  definitions := definitions
  index i := i.val
  initial := 0
  initial_zero := rfl
  dest := dest
  transitions i a := by
    apply (holds_iff_schreier_mem boundSubgroup BoundCertificate.generators representative _).mpr
    change edgeElement representative BoundCertificate.generators i (liftLetter a) (next i a) ∈ _
    rw [← hedge i a]
    exact eval_mem_of_generators_mem boundSubgroup reducedGenerators hmem _

/-- The abstract two-generator conclusion specializes to the fixed subgroup. -/
theorem membership_of_reduced_generation
    (h : ∀ k, reducedGenerators k ∈
      Subgroup.closure (Set.range fun b => reducedGenerators (protectedLabel b))) :
    ∀ k, reducedGenerators k ∈ boundSubgroup := by
  simpa only [reducedGenerators_protected, boundSubgroup] using h

end G2Five.AtlasPresentation.SchreierBoundData
