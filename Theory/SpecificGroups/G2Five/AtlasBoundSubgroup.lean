module

public import Theory.SpecificGroups.G2Five.AtlasPresentation

/-!
# An explicit subgroup for bounding the ATLAS presentation

The subgroup below is generated by two fixed words of lengths 28 and 37.
Their images in the retained degree-3906 permutation pair generate the
stabilizer of point 1. This observation only motivates the words: the definition
and theorems here make no claim of identification with that stabilizer.

The intended order argument separately certifies a 3906-coset cover and proves
that this subgroup is finite of order at most 1500000. Both certificates must
hold in the abstract presentation, using its original 22 relators.

Source: the ATLAS pair retained in `AtlasPresentationSource/`; see
`AtlasBoundSource/README.md` for the untrusted discovery computation.
-/

namespace G2Five.AtlasPresentation

/-- Decode words using precisely the convention of `relator`. -/
@[expose] public def boundLetters (s : String) : List (Bool × Bool) :=
  s.toList.map fun c =>
    if c = 'a' then (false, true) else
    if c = 'A' then (false, false) else
    if c = 'b' then (true, true) else (true, false)

/-- Two literal words specifying the subgroup used in the order bound. -/
@[expose] public def boundWord : Bool → String
  | false => "babaBabaBababaBAbABABAbABABA"
  | true => "baBabaBabaBaBabaBabAbABAbABAbAbABABAb"

/-- The two word values in the abstract presented group. -/
@[expose] public def boundGenerator (b : Bool) : Model :=
  FreeGroup.lift generator (FreeGroup.mk (boundLetters (boundWord b)))

/-- The subgroup generated by the two explicitly specified words. -/
@[expose] public def boundSubgroup : Subgroup Model :=
  Subgroup.closure (Set.range boundGenerator)

public theorem boundGenerator_mem (b : Bool) : boundGenerator b ∈ boundSubgroup :=
  Subgroup.subset_closure ⟨b, rfl⟩

/-- Evaluation at the canonical generators is the presentation quotient map. -/
public theorem lift_generator_eq_mk (w : FreeGroup Bool) :
    FreeGroup.lift generator w = PresentedGroup.mk (Set.range relator) w :=
  (FreeGroup.lift_unique (PresentedGroup.mk (Set.range relator)) (fun _ => rfl)).symm

/-- Every retained relator holds in the abstract presentation itself. -/
public theorem relator_eq_one (i : Fin 22) :
    FreeGroup.lift generator (relator i) = 1 := by
  rw [lift_generator_eq_mk]
  exact PresentedGroup.one_of_mem ⟨i, rfl⟩

/-- The word-list form consumed by coset-word certificate checkers. -/
public theorem boundLetters_relator_eq_one (i : Fin 22) :
    FreeGroup.lift generator (FreeGroup.mk (boundLetters (word i))) = 1 :=
  relator_eq_one i

end G2Five.AtlasPresentation
