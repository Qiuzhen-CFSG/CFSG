module

public import Theory.Alternating.theorem_5_2_1_2

/-!
# Generation of A₇ by two three-cycle centralizers

There are disjoint three-cycles on {0, 1, 2} and {3, 4, 5} whose centralizers
generate A₇. The centralizer of each contains the alternating group on the
complementary four letters. We use two three-cycles from each of these copies
of A₄, with common letter 6, and express every star three-cycle
(0 1)(0 c) as a short word in these four elements. The existing star-cycle
generation theorem then gives the result. All word identities are checked
pointwise on `Fin 7`.

Reference: the centralizer-generation input to Aschbacher--Smith,
*The Classification of Quasithin Groups*, Lemma I.1.6(8),
printed p.408/PDF p.419.
-/

namespace alternatingGroup

open Equiv

private def sevenCentralizerCycle (i j k : Fin 7) (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    alternatingGroup (Fin 7) :=
  ⟨swap i j * swap i k,
    (Perm.isThreeCycle_swap_mul_swap_same hij hik hjk).mem_alternatingGroup⟩

private def sevenCentralizerA : alternatingGroup (Fin 7) := sevenCentralizerCycle 0 1 2 (by decide) (by decide) (by decide)
private def sevenCentralizerB : alternatingGroup (Fin 7) := sevenCentralizerCycle 3 4 5 (by decide) (by decide) (by decide)
private def sevenCentralizerG₀ : alternatingGroup (Fin 7) := sevenCentralizerCycle 6 0 1 (by decide) (by decide) (by decide)
private def sevenCentralizerG₁ : alternatingGroup (Fin 7) := sevenCentralizerCycle 6 0 2 (by decide) (by decide) (by decide)
private def sevenCentralizerG₂ : alternatingGroup (Fin 7) := sevenCentralizerCycle 6 3 4 (by decide) (by decide) (by decide)
private def sevenCentralizerG₃ : alternatingGroup (Fin 7) := sevenCentralizerCycle 6 3 5 (by decide) (by decide) (by decide)

/-- A₇ is generated by the centralizers of two commuting three-cycles. -/
public theorem exists_commuting_threeCycles_centralizer_sup_eq_top_seven : ∃ a b : alternatingGroup (Fin 7),
    Perm.IsThreeCycle (a : Perm (Fin 7)) ∧
    Perm.IsThreeCycle (b : Perm (Fin 7)) ∧ Commute a b ∧
    Subgroup.centralizer ({a} : Set (alternatingGroup (Fin 7))) ⊔
      Subgroup.centralizer ({b} : Set (alternatingGroup (Fin 7))) = ⊤ := by
  refine ⟨sevenCentralizerA, sevenCentralizerB, ?_, ?_, ?_, ?_⟩
  · exact Perm.isThreeCycle_swap_mul_swap_same (by decide) (by decide) (by decide)
  · exact Perm.isThreeCycle_swap_mul_swap_same (by decide) (by decide) (by decide)
  · change sevenCentralizerA * sevenCentralizerB = sevenCentralizerB * sevenCentralizerA
    apply Subtype.ext
    ext i
    fin_cases i <;> decide
  let H := Subgroup.centralizer ({sevenCentralizerA} : Set (alternatingGroup (Fin 7))) ⊔
    Subgroup.centralizer ({sevenCentralizerB} : Set (alternatingGroup (Fin 7)))
  have h₀ : sevenCentralizerG₀ ∈ H := by
    apply (show Subgroup.centralizer {sevenCentralizerB} ≤ H from le_sup_right)
    rw [Subgroup.mem_centralizer_singleton_iff]
    apply Subtype.ext
    ext i
    fin_cases i <;> decide
  have h₁ : sevenCentralizerG₁ ∈ H := by
    apply (show Subgroup.centralizer {sevenCentralizerB} ≤ H from le_sup_right)
    rw [Subgroup.mem_centralizer_singleton_iff]
    apply Subtype.ext
    ext i
    fin_cases i <;> decide
  have h₂ : sevenCentralizerG₂ ∈ H := by
    apply (show Subgroup.centralizer {sevenCentralizerA} ≤ H from le_sup_left)
    rw [Subgroup.mem_centralizer_singleton_iff]
    apply Subtype.ext
    ext i
    fin_cases i <;> decide
  have h₃ : sevenCentralizerG₃ ∈ H := by
    apply (show Subgroup.centralizer {sevenCentralizerA} ≤ H from le_sup_left)
    rw [Subgroup.mem_centralizer_singleton_iff]
    apply Subtype.ext
    ext i
    fin_cases i <;> decide
  apply top_unique
  rw [← GLS3.Chapter5.starThreeCycles_closure_eq_top
    (a := (0 : Fin 7)) (b := (1 : Fin 7)) (by decide), Subgroup.closure_le]
  rintro g ⟨c, hc0, hc1, hg⟩
  have identify (w : alternatingGroup (Fin 7))
      (hw : (w : Perm (Fin 7)) = swap 0 1 * swap 0 c) : g = w :=
    Subtype.ext (hg.trans hw.symm)
  fin_cases c
  · exact (hc0 rfl).elim
  · exact (hc1 rfl).elim
  · rw [identify (sevenCentralizerG₀ * sevenCentralizerG₁ * sevenCentralizerG₁) (by ext i; fin_cases i <;> decide)]
    exact H.mul_mem (H.mul_mem h₀ h₁) h₁
  · rw [identify (sevenCentralizerG₂ * sevenCentralizerG₂ * sevenCentralizerG₀ * sevenCentralizerG₂) (by ext i; fin_cases i <;> decide)]
    exact H.mul_mem (H.mul_mem (H.mul_mem h₂ h₂) h₀) h₂
  · rw [identify (sevenCentralizerG₂ * sevenCentralizerG₀ * sevenCentralizerG₂ * sevenCentralizerG₂) (by ext i; fin_cases i <;> decide)]
    exact H.mul_mem (H.mul_mem (H.mul_mem h₂ h₀) h₂) h₂
  · rw [identify (sevenCentralizerG₃ * sevenCentralizerG₀ * sevenCentralizerG₃ * sevenCentralizerG₃) (by ext i; fin_cases i <;> decide)]
    exact H.mul_mem (H.mul_mem (H.mul_mem h₃ h₀) h₃) h₃
  · rw [identify sevenCentralizerG₀ (by ext i; fin_cases i <;> decide)]
    exact h₀

end alternatingGroup
