module
public import Theory.SpecificGroups.GL2.DeterminantTwoPower
public import Mathlib.FieldTheory.Finite.Basic

/-!
# Scalar decomposition of determinant two-power subgroups

Over a finite odd field F, if 2^(m+1) divides |F|-1, the determinant level m
is generated by the scalar roots of unity of order dividing 2^(m+1) together
with the determinant-one kernel. These are the actual matrix subgroups, and
the divisibility hypothesis is precisely what the source range m<n supplies
when 2^n is the exact two-part of |F|-1.

A determinant of order dividing 2^m is a square by the finite-field square
criterion. Its square root has order dividing 2^(m+1); dividing the matrix
by that scalar leaves determinant one. Conversely the determinant of a
two-by-two scalar matrix is its scalar squared, so both generating subgroups
lie in the stated determinant level.

This proves the generation step of ABG II.2 Lemma 1(v), article pp.17--18,
used in II.3 Proposition 3 (article p.26). Scalar centrality is intrinsic;
the cyclic scalar order and center-intersection counts are separate model facts.
-/

namespace Matrix.GeneralLinearGroup

public theorem determinantTwoPower_eq_scalar_sup_kernel
    (F : Type*) [Field F] [Finite F] (hodd : Odd (Nat.card F))
    (m : ℕ) (hdiv : 2 ^ (m + 1) ∣ Nat.card F - 1) :
    determinantTwoPower F m =
      (rootsOfUnity (2 ^ (m + 1)) F).map (scalar (Fin 2)) ⊔
        (det : GL (Fin 2) F →* Fˣ).ker := by
  classical
  let : Fintype F := Fintype.ofFinite F
  have hchar : ringChar F ≠ 2 := by
    intro h
    have heven := FiniteField.even_card_of_char_two (F := F) h
    have hodd' : Odd (Fintype.card F) := by simpa [Nat.card_eq_fintype_card] using hodd
    exact (Nat.not_even_iff_odd.mpr hodd') (Nat.even_iff.mpr heven)
  have hpow : 2 ^ m ∣ Nat.card F / 2 := by
    obtain ⟨k, hk⟩ := hdiv
    rw [pow_succ] at hk
    have hk' : Nat.card F - 1 = 2 * (2 ^ m * k) := by
      rw [hk]
      ring
    have hpos : 0 < Nat.card F := Nat.card_pos
    refine ⟨k, ?_⟩
    omega
  apply le_antisymm
  · intro A hA
    have hdet : det A ^ (Nat.card F / 2) = 1 :=
      orderOf_dvd_iff_pow_eq_one.mp
        (((mem_determinantTwoPower_iff_orderOf_dvd m A).mp hA).trans hpow)
    have hsquare : IsSquare (det A) :=
      (FiniteField.unit_isSquare_iff hchar (det A)).mpr
        (by simpa [Nat.card_eq_fintype_card] using hdet)
    obtain ⟨c, hc⟩ := hsquare
    have hc2 : det A = c ^ 2 := by simpa only [pow_two] using hc
    have hcroots : c ∈ rootsOfUnity (2 ^ (m + 1)) F := by
      rw [mem_rootsOfUnity, pow_succ, mul_comm, pow_mul, ← hc2]
      exact (mem_determinantTwoPower m A).mp hA
    let B := (scalar (Fin 2) c)⁻¹ * A
    have hB : B ∈ (det : GL (Fin 2) F →* Fˣ).ker := by
      rw [MonoidHom.mem_ker]
      simp only [B, map_mul, map_inv, det_scalar, Fintype.card_fin, hc2, inv_mul_cancel]
    have hcS : scalar (Fin 2) c ∈
        (rootsOfUnity (2 ^ (m + 1)) F).map (scalar (Fin 2)) :=
      ⟨c, hcroots, rfl⟩
    have h := (show Subgroup (GL (Fin 2) F) from
      (rootsOfUnity (2 ^ (m + 1)) F).map (scalar (Fin 2)) ⊔
        (det : GL (Fin 2) F →* Fˣ).ker).mul_mem
          ((show (rootsOfUnity (2 ^ (m + 1)) F).map (scalar (Fin 2)) ≤ _
            from le_sup_left) hcS)
          ((show (det : GL (Fin 2) F →* Fˣ).ker ≤ _ from le_sup_right) hB)
    simpa only [B, mul_inv_cancel_left] using h
  · apply sup_le
    · rintro A ⟨c, hc, rfl⟩
      rw [mem_determinantTwoPower, det_scalar, Fintype.card_fin, ← pow_mul,
        ← pow_succ']
      exact (mem_rootsOfUnity _ c).mp hc
    · intro A hA
      rw [mem_determinantTwoPower, MonoidHom.mem_ker.mp hA, one_pow]

end Matrix.GeneralLinearGroup

