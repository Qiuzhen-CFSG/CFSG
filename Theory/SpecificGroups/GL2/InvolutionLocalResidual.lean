module
public import Theory.SpecificGroups.GL2.ThreeResidualAutomorphisms
public import Theory.GroupTheory.CentralizerSmallKernelTransport
/-!
# Residuals at involutions with GL₂(3) centralizer

The literal embedded two-residual is SL₂(3). Its centralizer is the subgroup
generated by the original involution, and the original element-centralizer
induces every automorphism of the residual. The scalar marking follows from
uniqueness of the central involution in GL₂(3). In particular an automorphism
fixing the original involution can be adjusted by an element of its centralizer
to fix the residual pointwise.

Source application: Aschbacher--Smith, Lemma 2.5.15, printed pp.558--559.
-/

public section
open Subgroup Matrix.GeneralLinearGroup
namespace Theory.GroupTheory.GLTwoThreeLocal
variable {G : Type*} [Group G]

@[expose] def residual (z : G) : Subgroup G :=
  (pResidual 2 (centralizer ({z} : Set G))).map (centralizer ({z} : Set G)).subtype

theorem residual_le (z : G) : residual z ≤ centralizer ({z} : Set G) := map_subtype_le _

theorem centralizer_le_normalizer_residual (z : G) :
    centralizer ({z} : Set G) ≤ normalizer (residual z : Set G) := by
  have h := (pResidual 2 (centralizer ({z} : Set G))).le_normalizer_map
    (centralizer ({z} : Set G)).subtype
  simpa only [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype, residual] using h

@[expose] def action (z : G) : centralizer ({z} : Set G) →* MulAut (residual z) :=
  (residual z).normalizerMonoidHom.comp
    (inclusion (centralizer_le_normalizer_residual z))

theorem action_apply (z : G) (g : centralizer ({z} : Set G)) (r : residual z) :
    (action z g r : G) = (g : G) * (r : G) * (g : G)⁻¹ := rfl

variable (z : G) (e : centralizer ({z} : Set G) ≃* (GL (Fin 2) (ZMod 3)))

theorem image_residual : (pResidual 2 (centralizer ({z} : Set G))).map e.toMonoidHom =
    threeSpecialLinear := (map_pResidual 2 e).trans three_twoResidual

private theorem mem_residual_iff (c : centralizer ({z} : Set G)) :
    c ∈ pResidual 2 (centralizer ({z} : Set G)) ↔ e c ∈ threeSpecialLinear := by
  rw [← image_residual z e]
  exact ⟨fun hc => mem_map.mpr ⟨c, hc, rfl⟩,
    fun ⟨d, hd, hdc⟩ => e.injective hdc ▸ hd⟩

@[expose] noncomputable def residualEquivSpecial (e : centralizer ({z} : Set G) ≃* (GL (Fin 2) (ZMod 3))) : residual z ≃* threeSpecialLinear where
  toFun r := ⟨e ⟨r.val, residual_le z r.property⟩, by
    apply (mem_residual_iff z e _).mp
    obtain ⟨c, hc, he⟩ := r.property
    exact (show c = ⟨r.val, residual_le z r.property⟩ from Subtype.ext he) ▸ hc⟩
  invFun s := ⟨(e.symm s.val).val, mem_map.mpr
    ⟨e.symm s.val, by exact (mem_residual_iff z e _).mpr (by simpa only [e.apply_symm_apply] using s.property), rfl⟩⟩
  left_inv r := by
    apply Subtype.ext
    change (e.symm (e ⟨r.val, residual_le z r.property⟩)).val = r.val
    exact congrArg Subtype.val (e.symm_apply_apply ⟨r.val, residual_le z r.property⟩)
  right_inv s := Subtype.ext (e.apply_symm_apply s.val)
  map_mul' r s := by
    apply Subtype.ext
    exact e.map_mul ⟨r.val, residual_le z r.property⟩ ⟨s.val, residual_le z s.property⟩

noncomputable def residualEquivSL (e : centralizer ({z} : Set G) ≃* (GL (Fin 2) (ZMod 3))) : residual z ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3) :=
  (residualEquivSpecial z e).trans threeSpecialLinearEquiv

private def centralElement : centralizer ({z} : Set G) :=
  ⟨z, mem_centralizer_singleton_iff.mpr rfl⟩

private theorem image_centralElement (hz : orderOf z = 2) : e (centralElement z) = threeCentral := by
  apply three_central_involution_eq
  · rw [mem_center_iff]
    intro y
    obtain ⟨x, rfl⟩ := e.surjective y
    rw [← map_mul, ← map_mul]
    apply congrArg e
    exact Subtype.ext (mem_centralizer_singleton_iff.mp x.property)
  · exact (e.orderOf_eq _).trans ((Subgroup.orderOf_coe _).symm.trans hz)

include e in
theorem centralElement_mem_residual (hz : orderOf z = 2) : z ∈ residual z := by
  refine mem_map.mpr ⟨centralElement z, (mem_residual_iff z e _).mpr ?_, rfl⟩
  rw [image_centralElement z e hz]
  exact threeCentral_mem_specialLinear

include e in
theorem centralizer_residual (hz : orderOf z = 2) :
    centralizer (residual z : Set G) = zpowers z := by
  apply le_antisymm
  · intro x hx
    have hxc : x ∈ centralizer ({z} : Set G) :=
      mem_centralizer_singleton_iff.mpr (hx z (centralElement_mem_residual z e hz)).symm
    have hec : e ⟨x, hxc⟩ ∈ centralizer (threeSpecialLinear : Set (GL (Fin 2) (ZMod 3))) := by
      intro s hs
      obtain ⟨c, rfl⟩ := e.surjective s
      have hc : c.val ∈ residual z := mem_map.mpr
        ⟨c, (mem_residual_iff z e c).mpr hs, rfl⟩
      rw [← map_mul, ← map_mul]
      exact congrArg e (Subtype.ext (hx c.val hc))
    rw [three_specialLinear_centralizer, ← image_centralElement z e hz] at hec
    obtain ⟨n, hn⟩ := mem_zpowers_iff.mp hec
    apply mem_zpowers_iff.mpr
    refine ⟨n, ?_⟩
    have he : (centralElement z) ^ n = ⟨x, hxc⟩ := e.injective (by simpa using hn)
    exact congrArg Subtype.val he
  · apply zpowers_le.mpr
    intro x hx
    exact mem_centralizer_singleton_iff.mp (residual_le z hx)

include e in
theorem action_surjective : Function.Surjective (action z) := by
  let d := residualEquivSpecial z e
  intro a
  obtain ⟨g, hg⟩ := three_specialLinear_aut_surjective (MulAut.congr d a)
  refine ⟨e.symm g, ?_⟩
  apply (MulAut.congr d).injective
  rw [← hg]
  apply MulEquiv.ext
  intro s
  apply Subtype.ext
  change e ⟨((e.symm g : centralizer ({z} : Set G)) : G) *
      (d.symm s : residual z).val * ((e.symm g : centralizer ({z} : Set G)) : G)⁻¹, _⟩ =
    g * s.val * g⁻¹
  change e (e.symm g * ⟨(d.symm s : residual z).val, residual_le z (d.symm s).property⟩ * (e.symm g)⁻¹) = _
  rw [map_mul, map_mul, map_inv, e.apply_symm_apply]
  have hd : e ⟨(d.symm s : residual z).val, residual_le z (d.symm s).property⟩ = s.val :=
    congrArg Subtype.val (d.apply_symm_apply s)
  rw [hd]

/-- The local residual is functorial under an actual group equivalence. -/
theorem map_residual {H : Type*} [Group H] (f : G ≃* H) :
    (residual z).map f.toMonoidHom = residual (f z) := by
  let c := (f.subgroupMap (centralizer ({z} : Set G))).trans
    (MulEquiv.subgroupCongr (CentralizerSmallKernelTransport.map_centralizer f z))
  have hf : f.toMonoidHom.comp (centralizer ({z} : Set G)).subtype =
      (centralizer ({f z} : Set H)).subtype.comp c.toMonoidHom := by
    ext x
    rfl
  change ((pResidual 2 (centralizer ({z} : Set G))).map _).map _ = _
  rw [map_map, hf, ← map_map, map_pResidual]
  rfl

include e in
/-- An automorphism fixing z can be adjusted by its actual centralizer
so that it fixes the local residual pointwise. -/
theorem adjust_to_fix_residual (a : MulAut G) (ha : a z = z) :
    ∃ c : centralizer ({z} : Set G),
      ∀ r ∈ residual z, (MulAut.conj (c.val⁻¹) * a) r = r := by
  have hR : (residual z).map a.toMonoidHom = residual z := by
    rw [map_residual, ha]
  let b : MulAut (residual z) := (a.subgroupMap (residual z)).trans (MulEquiv.subgroupCongr hR)
  obtain ⟨c, hc⟩ := action_surjective z e b
  refine ⟨c, ?_⟩
  intro r hr
  have hb : a r = c.val * r * c.val⁻¹ := by
    have h := congrArg (fun f : MulAut (residual z) => (f ⟨r, hr⟩ : G)) hc
    exact h.symm
  change c.val⁻¹ * a r * (c.val⁻¹)⁻¹ = r
  rw [hb]
  group

end Theory.GroupTheory.GLTwoThreeLocal
