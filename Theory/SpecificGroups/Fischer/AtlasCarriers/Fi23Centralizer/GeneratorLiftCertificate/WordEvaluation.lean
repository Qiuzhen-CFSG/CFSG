private theorem eval1
    (ha : ∀ x, generatorA x = sourceA x)
    (x : Fin 31671) : inclusion word1 x = value1 x :=
  (ha x).trans (checked1 x).symm

private theorem eval2
    (hb : ∀ x, generatorB x = sourceB x)
    (x : Fin 31671) : inclusion word2 x = value2 x :=
  (hb x).trans (checked2 x).symm

private theorem eval3
    (ha : ∀ x, generatorA x = sourceA x)
    (x : Fin 31671) : inclusion word3 x = value3 x :=
  inv_eval_of_eq inclusion word3 word1 value1 value3 rfl
    (eval1 ha) checked3 x

