def maskA20 : Nat := 

set_option maxRecDepth 4000 in
theorem supportA20 : Supported cyclesA20.flatten maskA20 := by
  exact ⟨nodup_of_checkFreshPoints _ (by decide +kernel), by decide +kernel⟩

set_option maxRecDepth 4000 in
theorem actionA20 :
    (cyclesA20.all fun c => c.all fun x => decide (c.formPerm (aMap x) = x)) = true := by
  rfl

