/-!
# Numerical predicates for the Fi23 certificate

The support masks describe the generator cycle supports. The combined check
verifies the two fixed complements, the defining word, its seventh power,
square one, and exactly the existing fixed-coordinate image. These are data
predicates, with their universal certificates in the range modules.
Source: ATLAS F23G1-p31671B0; application: GLS3 Table 5.3u.
-/

@[expose] public section
namespace Sporadic.Fischer.Fi23.CentralizerSection.CandidateCertificate
def supportMaskA : Nat := 

def generatorFixedCheckA (i : Nat) : Bool :=
  supportMaskA.testBit i || (aMap (Fin.ofNat 31671 i) == Fin.ofNat 31671 i)

def supportMaskB : Nat := 

def generatorFixedCheckB (i : Nat) : Bool :=
  supportMaskB.testBit i || (bMap (Fin.ofNat 31671 i) == Fin.ofNat 31671 i)

def pointCheck (i : Nat) : Bool := if i < 31671 then
  wordCheck i && candidateCheck i && involutionCheck i && fixedCheck i &&
  generatorFixedCheckA i && generatorFixedCheckB i else true

end Sporadic.Fischer.Fi23.CentralizerSection.CandidateCertificate
