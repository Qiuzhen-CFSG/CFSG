/-!
# Fi23 generator B: cycle block certificates 2

Certificates for the inverse cycles in ATLAS F23G1-p31671B0.
Support masks certify disjointness; the individual cycle checks certify the
lookup action, including its orientation. All numerical checks use the kernel.
The consumer is the GLS3 Table 5.3u Fi23 candidate.
-/

@[expose] public section
namespace Sporadic.Fischer.Fi23.CentralizerSection.CandidateCertificate
open AtlasCarriers KernelCertificate
open Sporadic.Fischer.Fi22.KernelCertificate
set_option Elab.async false

def maskB20 : Nat := 

set_option maxRecDepth 4000 in
theorem supportB20 : Supported cyclesB20.flatten maskB20 := by
  exact ⟨nodup_of_checkFreshPoints _ (by decide +kernel), by decide +kernel⟩

set_option maxRecDepth 4000 in
theorem actionB20 :
    (cyclesB20.all fun c => c.all fun x => decide (c.formPerm (bMap x) = x)) = true := by
  rfl

