set_option Elab.async false

def maskB10 : Nat := 

set_option maxRecDepth 4000 in
theorem supportB10 : Supported cyclesB10.flatten maskB10 := by
  exact ⟨nodup_of_checkFreshPoints _ (by decide +kernel), by decide +kernel⟩

set_option maxRecDepth 4000 in
theorem actionB10 :
    (cyclesB10.all fun c => c.all fun x => decide (c.formPerm (bMap x) = x)) = true := by
  rfl

