set_option Elab.async false

def maskB30 : Nat := 

set_option maxRecDepth 4000 in
theorem supportB30 : Supported cyclesB30.flatten maskB30 := by
  exact ⟨nodup_of_checkFreshPoints _ (by decide +kernel), by decide +kernel⟩

set_option maxRecDepth 4000 in
theorem actionB30 :
    (cyclesB30.all fun c => c.all fun x => decide (c.formPerm (bMap x) = x)) = true := by
  rfl

