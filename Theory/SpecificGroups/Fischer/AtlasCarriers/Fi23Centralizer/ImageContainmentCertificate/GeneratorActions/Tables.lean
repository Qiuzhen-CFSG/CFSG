def imageTable1 : Nat :=


def imageTable2 : Nat :=


def imageTable3 : Nat :=


def imageTable4 : Nat :=


def imageTable5 : Nat :=


def imageTable6 : Nat :=


def imageTable7 : Nat :=


def imageTable : Fin 8 → Nat
  | 0 => imageTable0
  | 1 => imageTable1
  | 2 => imageTable2
  | 3 => imageTable3
  | 4 => imageTable4
  | 5 => imageTable5
  | 6 => imageTable6
  | 7 => imageTable7

/-- Proposed image action; agreement with an actual word is a separate theorem. -/
def imageAction (j : Fin 8) : Fin 3510 → Fin 3510 := tableAction (imageTable j)

end Sporadic.Fischer.Fi23.CentralizerSection.ImageContainmentCertificate.GeneratorActions
