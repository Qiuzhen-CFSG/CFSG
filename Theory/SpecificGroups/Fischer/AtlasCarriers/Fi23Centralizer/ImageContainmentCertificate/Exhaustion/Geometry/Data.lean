def evaluationEntry (x : Fin 31671) : Nat := lookup evaluationBlocks 45 x.val

def parent (x : Fin 31671) : Fin 31671 := Fin.ofNat 31671 (evaluationEntry x % 2^15)
def imageZero (x : Fin 31671) : Fin 31671 := Fin.ofNat 31671 ((evaluationEntry x >>> 15) % 2^15)
