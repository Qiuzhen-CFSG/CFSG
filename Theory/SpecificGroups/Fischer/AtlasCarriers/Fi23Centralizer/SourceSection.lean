module
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.Candidate
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.GeneratorLifts
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.GeneratorLiftCertificate.WordEvaluation
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.Image
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23InFi24Prime.Comparison.SourceActions
/-!
# A concrete Fi22 quotient of a Fi23 involution-centralizer subgroup

The two certified lifts of the exact Fi22 generators generate a subgroup of
the literal involution centralizer. Restriction to its certified fixed letters
has exactly the image generated by those two permutations. This gives the
required surjection without identifying the whole centralizer or its kernel.
Source: GLS3 Table 5.3u and its explanatory Fischer paragraph; A.2.19,
Aschbacher--Smith, printed pp.40--41.
-/

public section
namespace Sporadic.Fischer.Fi23.CentralizerSection
open Subgroup Theory.GroupAction.PermutationImageComparison
open GeneratorLiftCertificate
open Fi24Prime.Fi23Lift.Certificate (generatorA_apply_eq_sourceA generatorB_apply_eq_sourceB)

theorem exists_generator_lifts :
    ∃ u v : numerator,
      (∀ i : Option (Fin 3510), inclusion u.val (ImageData.point i) =
        ImageData.point (Option.map Fi22.generatorA i)) ∧
      (∀ i : Option (Fin 3510), inclusion v.val (ImageData.point i) =
        ImageData.point (Option.map Fi22.generatorB i)) :=
  exists_generator_lifts_of_word_tables generatorA_apply_eq_sourceA
    generatorB_apply_eq_sourceB
    (liftWordA_apply_eq_liftA generatorA_apply_eq_sourceA generatorB_apply_eq_sourceB)
    (liftWordB_apply_eq_liftB generatorA_apply_eq_sourceA generatorB_apply_eq_sourceB)

theorem exists_source_section :
    ∃ (t : Carrier) (L : Subgroup Carrier) (f : L →* Fi22.Carrier),
      orderOf t = 2 ∧ L ≤ centralizer ({t} : Set Carrier) ∧
      Function.Surjective f := by
  obtain ⟨u,v,hu,hv⟩ := exists_generator_lifts
  let e := fixedPointRelabeling candidate_fixed_iff
  let i := withFixedPoint e
  have hau : fixedPointAction u = i Fi22.generatorA :=
    (eq_withFixedPoint_iff e _ _).mpr
      (fixedPointRelabeling_action_of_points candidate_fixed_iff u Fi22.generatorA hu)
  have hbv : fixedPointAction v = i Fi22.generatorB :=
    (eq_withFixedPoint_iff e _ _).mpr
      (fixedPointRelabeling_action_of_points candidate_fixed_iff v Fi22.generatorB hv)
  let L : Subgroup Carrier := closure {u.val,v.val}
  have hL : L ≤ numerator := (closure_le _).mpr (by
    intro x hx
    rcases hx with rfl | rfl
    · exact u.property
    · exact v.property)
  let f : L →* Equiv.Perm FixedLetters := fixedPointAction.comp (Subgroup.inclusion hL)
  have hc : L ≤ ((Fi22.generated.map i).comap fixedPointAction).map numerator.subtype := by
    apply (closure_le _).mpr
    intro x hx
    rcases hx with rfl | rfl
    · exact ⟨u, ⟨Fi22.generatorA, subset_closure (by simp), hau.symm⟩, rfl⟩
    · exact ⟨v, ⟨Fi22.generatorB, subset_closure (by simp), hbv.symm⟩, rfl⟩
  have hf : ∀ x, f x ∈ Fi22.generated.map i := by
    intro x
    obtain ⟨y,hy,hyx⟩ := hc x.property
    have heq : y = Subgroup.inclusion hL x := Subtype.ext hyx
    change fixedPointAction y ∈ Fi22.generated.map i at hy
    rw [heq] at hy
    exact hy
  have ha : i Fi22.generatorA ∈ f.range := by
    refine ⟨⟨u.val,subset_closure (by simp)⟩, ?_⟩
    exact hau
  have hb : i Fi22.generatorB ∈ f.range := by
    refine ⟨⟨v.val,subset_closure (by simp)⟩, ?_⟩
    exact hbv
  let E : f.range ≃* Fi22.Carrier := rangeEquivClosurePair f i
    (withFixedPoint_injective e) Fi22.generatorA Fi22.generatorB hf ha hb
  exact ⟨candidate,L,E.toMonoidHom.comp f.rangeRestrict,candidate_order,hL,
    E.surjective.comp f.rangeRestrict_surjective⟩
end Sporadic.Fischer.Fi23.CentralizerSection
