def secondNetwork : Fin 6 → List Stage
  | 0 => network0
  | 1 => network1
  | 2 => network2
  | 3 => network3
  | 4 => network4
  | 5 => network5

def signedNetwork : Fin 14 → List Stage
  | 0 => network6
  | 1 => network7
  | 2 => network8
  | 3 => network9
  | 4 => network10
  | 5 => network11
  | 6 => network12
  | 7 => network6.reverse
  | 8 => network7.reverse
  | 9 => network8.reverse
  | 10 => network9.reverse
  | 11 => network10.reverse
  | 12 => network11.reverse
  | 13 => network12.reverse

theorem secondNetwork_valid (a : Fin 6) : Valid (secondNetwork a) := by
  fin_cases a
  · exact network0_valid
  · exact network1_valid
  · exact network2_valid
  · exact network3_valid
  · exact network4_valid
  · exact network5_valid

theorem signedNetwork_valid (a : Fin 14) : Valid (signedNetwork a) := by
  fin_cases a
  · exact network6_valid
  · exact network7_valid
  · exact network8_valid
  · exact network9_valid
  · exact network10_valid
  · exact network11_valid
  · exact network12_valid
  · intro s hs; exact network6_valid s (List.mem_reverse.mp hs)
  · intro s hs; exact network7_valid s (List.mem_reverse.mp hs)
  · intro s hs; exact network8_valid s (List.mem_reverse.mp hs)
  · intro s hs; exact network9_valid s (List.mem_reverse.mp hs)
  · intro s hs; exact network10_valid s (List.mem_reverse.mp hs)
  · intro s hs; exact network11_valid s (List.mem_reverse.mp hs)
  · intro s hs; exact network12_valid s (List.mem_reverse.mp hs)

