module

public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.KernelUpper.Data.One0
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.KernelUpper.Data.One1
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.KernelUpper.Data.Two0
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.KernelUpper.Data.Two1
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.KernelUpper.Data.Two2
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.KernelUpper.Data.Two3
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.KernelUpper.Data.Two4
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.KernelUpper.Data.Two5
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23Centralizer.KernelData
import Mathlib.Tactic.FinCases

/-!
# Two explicit auxiliary groups for the Fi23 prefix bound

The first group is generated by two packed permutations fixing letter 1.
The second is generated by six packed permutations fixing letters 1 and 13.
Their permutation laws and fixed-letter assertions are proved below and in
the data modules. No equality with a point stabilizer is assumed.

The three still-required inclusions have these groups as their endpoints:
the stabilizer of 1 in the actual carrier lies in `first`; the stabilizer of
13 in `first` lies in `second`; the stabilizer of 27 in `second` lies in the
unchanged seven-generator `KernelData.intermediate`.

The witnesses come from the seeded search in `source/Generate.g`, using the
exact ATLAS F23G1-p31671B0 input. The target is the prefix bound needed for
the centralizer construction of GLS3 Table 5.3u.
-/

@[expose] public section
namespace Sporadic.Fischer.Fi23.CentralizerSection.KernelUpperData

def firstGenerator : Fin 2 → Equiv.Perm (Fin 31671)
  | 0 => One0.permutation
  | 1 => One1.permutation

def secondGenerator : Fin 6 → Equiv.Perm (Fin 31671)
  | 0 => Two0.permutation
  | 1 => Two1.permutation
  | 2 => Two2.permutation
  | 3 => Two3.permutation
  | 4 => Two4.permutation
  | 5 => Two5.permutation

/-- Candidate overgroup for the actual one-point stabilizer. -/
def first : Subgroup (Equiv.Perm (Fin 31671)) :=
  Subgroup.closure (Set.range firstGenerator)

/-- Candidate overgroup for the actual two-point stabilizer. -/
def second : Subgroup (Equiv.Perm (Fin 31671)) :=
  Subgroup.closure (Set.range secondGenerator)

theorem firstGenerator_fixes (i : Fin 2) : firstGenerator i 1 = 1 := by
  fin_cases i
  · exact One0.fixes_1
  · exact One1.fixes_1

theorem secondGenerator_fixes (i : Fin 6) :
    secondGenerator i 1 = 1 ∧ secondGenerator i 13 = 13 := by
  fin_cases i
  · exact ⟨Two0.fixes_1, Two0.fixes_13⟩
  · exact ⟨Two1.fixes_1, Two1.fixes_13⟩
  · exact ⟨Two2.fixes_1, Two2.fixes_13⟩
  · exact ⟨Two3.fixes_1, Two3.fixes_13⟩
  · exact ⟨Two4.fixes_1, Two4.fixes_13⟩
  · exact ⟨Two5.fixes_1, Two5.fixes_13⟩

private theorem closure_fixes {n : Nat} (gen : Fin n → Equiv.Perm (Fin 31671))
    (x : Fin 31671) (h : ∀ i, gen i x = x)
    {p : Equiv.Perm (Fin 31671)} (hp : p ∈ Subgroup.closure (Set.range gen)) :
    p x = x := by
  have hle : Subgroup.closure (Set.range gen) ≤
      MulAction.stabilizer (Equiv.Perm (Fin 31671)) x := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact h i
  exact hle hp

/-- Every element of the first auxiliary group fixes the first base letter. -/
theorem first_fixes {p : Equiv.Perm (Fin 31671)} (hp : p ∈ first) : p 1 = 1 :=
  closure_fixes firstGenerator 1 firstGenerator_fixes hp

/-- Every element of the second auxiliary group fixes the first two base letters. -/
theorem second_fixes {p : Equiv.Perm (Fin 31671)} (hp : p ∈ second) :
    p 1 = 1 ∧ p 13 = 13 :=
  ⟨closure_fixes secondGenerator 1 (fun i => (secondGenerator_fixes i).1) hp,
   closure_fixes secondGenerator 13 (fun i => (secondGenerator_fixes i).2) hp⟩

end Sporadic.Fischer.Fi23.CentralizerSection.KernelUpperData
