def loopPoint (i : Fin 722) : Fin 31671 := Fin.ofNat 31671 (lookup pointBlocks 15 i.val)
def pathLength (i : Fin 722) : Nat := lookup pathLengthBlocks 6 i.val
def pathBits (i : Fin 722) : Nat := lookup pathBitsBlocks 57 i.val
def factorLength (i : Fin 722) : Nat := lookup factorLengthBlocks 5 i.val
def factorBits (i : Fin 722) : Nat := lookup factorBitsBlocks 200 i.val
def loopIndex (x : Fin 31671) : Fin 722 := Fin.ofNat 722 (lookup indexBlocks 10 x.val)

def pathOK : Nat → Nat → Fin 31671 → Bool
  | 0, _, x => decide (x = 1)
  | d + 1, w, x => decide (x ≠ 1) && (isB x == (w % 2 == 1)) &&
      pathOK d (w / 2) (parent x)

def loopGenerator (i : Fin 722) : Equiv.Perm (Fin 31671) :=
  if i.val < 695 then generatorA else generatorB

def sourceGenerator (i : Fin 722) (x : Fin 31671) : Fin 31671 :=
  if i.val < 695 then sourceA x else sourceB x

def pathTest (n : Nat) : Bool :=
  let i := Fin.ofNat 722 n
  pathOK (pathLength i) (pathBits i) (loopPoint i) &&
    decide (sourceGenerator i (loopPoint i) = loopPoint i)

def coverageTest (n : Nat) : Bool :=
  let x := Fin.ofNat 31671 n
  decide ((sourceA x = x → (loopIndex x).val < 695 ∧ loopPoint (loopIndex x) = x) ∧
    (sourceB x = x → 695 ≤ (loopIndex x).val ∧ loopPoint (loopIndex x) = x))

