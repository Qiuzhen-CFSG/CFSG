def code (x : Fin 31671) : Nat := lookup blocks 26 x.val

def rank (x : Fin 31671) : Nat := code x % 8192

def relationIndex (x : Fin 31671) : Fin 11 := Fin.ofNat 11 ((code x / 8192) % 16)

def cut (x : Fin 31671) : Nat := (code x / 131072) % 256

def start (x : Fin 31671) : Fin 31671 :=
  if code x / 33554432 == 0 then x else sourceA x

def rotated (x : Fin 31671) : List (Fin 3) :=
  (relator (relationIndex x)).drop (cut x) ++ (relator (relationIndex x)).take (cut x)

def zeroTest (x : Fin 31671) : Bool :=
  decide (sourceA x = x) || aTree x || seed x || seed (sourceA x)

def positiveTest (x : Fin 31671) : Bool :=
  match rotated x with
  | [] => false
  | s :: w => decide (s = 0) && pathBelow rank (rank x) w (sourceA (start x))

def pointTest (n : Nat) : Bool :=
  let x := Fin.ofNat 31671 n
  if rank x = 0 then zeroTest x else positiveTest x

