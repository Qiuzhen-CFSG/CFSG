def code (x : Fin 31671) : Nat := lookup treeBlocks 22 x.val

def parent (x : Fin 31671) : Fin 31671 := Fin.ofNat 31671 (code x % 32768)

def isB (x : Fin 31671) : Bool := (code x / 32768) % 2 == 1

def depth (x : Fin 31671) : Nat := code x / 65536

/-- Either direction of a defining edge carrying the first generator. -/
def aTree (x : Fin 31671) : Bool :=
  decide (sourceA x ≠ 1 ∧ parent (sourceA x) = x ∧ isB (sourceA x) = false) ||
    decide (x ≠ 1 ∧ parent x = sourceA x ∧ isB x = false)

def pointTest (n : Nat) : Bool :=
  let x := Fin.ofNat 31671 n
  decide ((x ≠ 1 → depth (parent x) < depth x ∧
      (if isB x then sourceB (parent x) else sourceA (parent x)) = x) ∧
    sourceA (sourceA x) = x ∧ sourceB (sourceB (sourceB x)) = x ∧
    (sourceB x = x ∨
      (sourceB x ≠ 1 ∧ parent (sourceB x) = x ∧ isB (sourceB x) = true) ∨
      (x ≠ 1 ∧ parent x ≠ 1 ∧ isB x = true ∧ isB (parent x) = true ∧
        parent (parent x) = sourceB x)))

end Sporadic.Fischer.Fi23.CentralizerSection.FirstTree
