def signedGenerator : Fin 4 → Equiv.Perm (Fin 31671)
  | 0 => KernelUpperData.One0.permutation
  | 1 => KernelUpperData.One1.permutation
  | 2 => KernelUpperData.One0.permutation⁻¹
  | 3 => KernelUpperData.One1.permutation⁻¹

def signedApply : Fin 4 → Fin 31671 → Fin 31671
  | 0 => KernelUpperData.One0.forward
  | 1 => KernelUpperData.One1.forward
  | 2 => KernelUpperData.One0.backward
  | 3 => KernelUpperData.One1.backward

theorem signedGenerator_apply (a : Fin 4) (x : Fin 31671) :
    signedGenerator a x = signedApply a x := by
  fin_cases a <;> rfl

