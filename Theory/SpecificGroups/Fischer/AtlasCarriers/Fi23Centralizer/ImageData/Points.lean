private theorem checkRange_spec (f : Nat → Bool) (d start : Nat) :
    checkRange f d start = true ↔
      ∀ i, start ≤ i → i < start + 2^d → f i = true := by
  induction d generalizing start with
  | zero =>
    simp only [checkRange, pow_zero]
    constructor
    · intro h i hi hi'
      have : i = start := by omega
      simpa [this] using h
    · intro h
      exact h start le_rfl (by omega)
  | succ d ih =>
    rw [checkRange, Bool.and_eq_true, ih, ih, pow_succ]
    constructor
    · rintro ⟨hl, hr⟩ i hi hi'
      by_cases h : i < start + 2^d
      · exact hl i hi h
      · exact hr i (by omega) (by omega)
    · intro h
      constructor
      · intro i hi hi'
        exact h i hi (by omega)
      · intro i hi hi'
        exact h i (by omega) (by omega)

private theorem index_checks (b : Fin 28) :
    checkRange indexCheck 7 (128 * b.val) = true := by
  rcases b with ⟨b, hb⟩
  interval_cases b
  · exact index_check_0
  · exact index_check_1
  · exact index_check_2
  · exact index_check_3
  · exact index_check_4
  · exact index_check_5
  · exact index_check_6
  · exact index_check_7
  · exact index_check_8
  · exact index_check_9
