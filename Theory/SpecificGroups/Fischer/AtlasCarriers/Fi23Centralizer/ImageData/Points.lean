def pointIndex (i : Fin 3511) : Fin 31671 :=
  Fin.ofNat 31671 (pointTable.get i.val)

def index (x : Fin 31671) : Fin 3511 :=
  Fin.ofNat 3511 (indexTable.get x.val)

private def checkRange (f : Nat → Bool) : Nat → Nat → Bool
  | 0, start => f start
  | d + 1, start => checkRange f d start && checkRange f d (start + 2^d)

private def indexCheck (i : Nat) : Bool := if i < 3511 then
  index (pointIndex (Fin.ofNat 3511 i)) == Fin.ofNat 3511 i else true

-- The numerical checks are intentionally sequential: elaborating all of them
