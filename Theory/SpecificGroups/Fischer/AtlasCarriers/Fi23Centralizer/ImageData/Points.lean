/-- The numerical decoder is a left inverse of the 3511-letter table. -/
theorem index_pointIndex (i : Fin 3511) : index (pointIndex i) = i := by
  have hb : i.val / 128 < 28 := by omega
  have hi := (checkRange_spec indexCheck 7 (128 * (i.val / 128))).mp
    (index_checks ⟨i.val / 128, hb⟩) i.val (by omega) (by norm_num; omega)
  have hcast : Fin.ofNat 3511 i.val = i := by
    apply Fin.ext
    exact Nat.mod_eq_of_lt i.isLt
  simpa only [indexCheck, if_pos i.isLt, beq_iff_eq, hcast] using hi

/-- The Fi23 letter labelled by a Fi22 point, or by the extra fixed point. -/
def point (i : Option (Fin 3510)) : Fin 31671 :=
  pointIndex (finSuccEquivLast.symm i)

/-- Decode a proposed fixed letter; no fixed-point assertion is made here. -/
def coordinate (x : Fin 31671) : Option (Fin 3510) :=
  finSuccEquivLast (index x)

@[simp] theorem coordinate_point (i : Option (Fin 3510)) :
    coordinate (point i) = i := by
  simp only [coordinate, point, index_pointIndex, Equiv.apply_symm_apply]

/-- All 3511 proposed fixed letters are distinct. -/
theorem point_injective : Function.Injective point :=
  Function.LeftInverse.injective coordinate_point

/-- The additional letter in the fixed-point action (zero-based). -/
theorem point_none : point none = 15181 := by rfl

