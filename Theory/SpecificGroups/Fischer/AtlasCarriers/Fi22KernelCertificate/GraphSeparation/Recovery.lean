module

public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22KernelCertificate.GraphData
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22KernelCertificate.GeneratorMaps

/-!
# Recovery data for Fi22 fixed-point signatures

The 27 selected related-values form a binary integer. A binary search in the
packed sorted keys returns a pair of point labels. The table and search are only
data: `Certificate.lean` proves for every point that the returned pair consists
of that point and its `fastA` image, in either order. Thus the search needs no
assumed sorting, injectivity or group-theoretic property.

Source: ATLAS F22G1-p3510B0 and the kernel application of GLS3 Table 5.3t.
Reproduce this module with `GraphSeparation/source/generate.py`. The producer
reads the existing Lean graph and point-map data; Lean checks every recovery.
-/

@[expose] public section
namespace Sporadic.Fischer.Fi22.KernelCertificate.GraphSeparation

/-- The related-values on the specified 27-point list, packed in list order. -/
def signature (x : Fin 3510) : Nat :=
  separatingPoints.foldr (fun f n => (related x f).toNat + 2 * n) 0

/-- Sorted signature keys, in 27-bit slots. -/
def keysPacked : Nat := 

/-- Two 12-bit point labels for each key, in 24-bit slots. -/
def pairsPacked : Nat := 

/-- Twelve bisections suffice for the 2102 slots; correctness is checked pointwise. -/
def recoverIndex (s : Nat) : Nat → Nat → Nat → Nat
  | 0, lo, _ => lo
  | fuel + 1, lo, hi =>
    let mid := (lo + hi) / 2
    if s < ((keysPacked >>> (27 * mid)) % 134217728) then
      recoverIndex s fuel lo mid
    else
      recoverIndex s fuel mid hi

/-- A candidate pair of labels recovered from a signature. -/
def recover (s : Nat) : Nat × Nat :=
  let pair := (pairsPacked >>> (24 * recoverIndex s 12 0 2102)) % 16777216
  (pair % 4096, pair / 4096)

/-- The recovery specification allows either ordering of the two labels. -/
def RecoveryCorrect (x : Fin 3510) : Prop :=
  recover (signature x) = (x.val, (fastA x).val) ∨
  recover (signature x) = ((fastA x).val, x.val)

instance (x : Fin 3510) : Decidable (RecoveryCorrect x) :=
  inferInstanceAs (Decidable (_ ∨ _))

/-- Modulo indexing allows uniform blocks, including the final short block. -/
def CorrectAt (n : Nat) : Prop :=
  RecoveryCorrect ⟨n % 3510, Nat.mod_lt _ (by decide)⟩

instance (n : Nat) : Decidable (CorrectAt n) :=
  inferInstanceAs (Decidable (RecoveryCorrect _))

end Sporadic.Fischer.Fi22.KernelCertificate.GraphSeparation
