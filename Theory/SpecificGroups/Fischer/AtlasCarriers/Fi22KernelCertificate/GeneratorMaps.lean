module

public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22

/-!
# Packed point maps for the Fi22 kernel certificates

The numerical maps are computed from the ATLAS cycle strings, with each cycle
inverted to match the left action in `Fi22.lean`. The maps are data only; their
equalities with the actual generators must be proved in `GraphInvariance`.
This common data module lets invariance and signature separation be certified
independently, without changing the carrier or its action.

Source: ATLAS F22G1-p3510B0. Reproduce with `source/generate_maps.py`.
-/

@[expose] public section
namespace Sporadic.Fischer.Fi22.KernelCertificate

def fastAPacked : Nat := 

/-- Candidate point map; comparison with `generatorA` is a certificate obligation. -/
def fastA (x : Fin 3510) : Fin 3510 :=
  ⟨(fastAPacked >>> (12 * x.val)) % 4096 % 3510, Nat.mod_lt _ (by decide)⟩

def fastBPacked : Nat := 

/-- Candidate point map; comparison with `generatorB` is a certificate obligation. -/
def fastB (x : Fin 3510) : Fin 3510 :=
  ⟨(fastBPacked >>> (12 * x.val)) % 4096 % 3510, Nat.mod_lt _ (by decide)⟩

end Sporadic.Fischer.Fi22.KernelCertificate
