private theorem rowCheckB_all : BitNetwork.check rowCheckB 0 3510 = true :=
  (BitNetwork.check_append rowCheckB 0 256 3254 rowCheckB0 (BitNetwork.check_append rowCheckB 256 256 2998 rowCheckB1 (BitNetwork.check_append rowCheckB 512 256 2742 rowCheckB2 (BitNetwork.check_append rowCheckB 768 256 2486 rowCheckB3 (BitNetwork.check_append rowCheckB 1024 256 2230 rowCheckB4 (BitNetwork.check_append rowCheckB 1280 256 1974 rowCheckB5 (BitNetwork.check_append rowCheckB 1536 256 1718 rowCheckB6 (BitNetwork.check_append rowCheckB 1792 256 1462 rowCheckB7 (BitNetwork.check_append rowCheckB 2048 256 1206 rowCheckB8 (BitNetwork.check_append rowCheckB 2304 256 950 rowCheckB9 (BitNetwork.check_append rowCheckB 2560 256 694 rowCheckB10 (BitNetwork.check_append rowCheckB 2816 256 438 rowCheckB11 (BitNetwork.check_append rowCheckB 3072 256 182 rowCheckB12 rowCheckB13)))))))))))))

theorem networkB_rows (x : Fin 3510) :
    rowMask (fastB x) = BitNetwork.apply networkB (rowMask x) := by
  have h := BitNetwork.check_sound rowCheckB 0 3510 rowCheckB_all x.val
    (Nat.zero_le _) x.isLt
  simpa only [rowCheckB, Nat.mod_eq_of_lt x.isLt, decide_eq_true_eq] using h

theorem related_fastB (x y : Fin 3510) :
    related (fastB x) (fastB y) = related x y := by
  unfold related
  rw [networkB_rows]
  exact BitNetwork.sound networkB _ _ _ (networkB_routes y)

