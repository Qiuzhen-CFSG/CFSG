private theorem routeCheckB_all : BitNetwork.check routeCheckB 0 3510 = true :=
  (BitNetwork.check_append routeCheckB 0 256 3254 routeCheckB0 (BitNetwork.check_append routeCheckB 256 256 2998 routeCheckB1 (BitNetwork.check_append routeCheckB 512 256 2742 routeCheckB2 (BitNetwork.check_append routeCheckB 768 256 2486 routeCheckB3 (BitNetwork.check_append routeCheckB 1024 256 2230 routeCheckB4 (BitNetwork.check_append routeCheckB 1280 256 1974 routeCheckB5 (BitNetwork.check_append routeCheckB 1536 256 1718 routeCheckB6 (BitNetwork.check_append routeCheckB 1792 256 1462 routeCheckB7 (BitNetwork.check_append routeCheckB 2048 256 1206 routeCheckB8 (BitNetwork.check_append routeCheckB 2304 256 950 routeCheckB9 (BitNetwork.check_append routeCheckB 2560 256 694 routeCheckB10 (BitNetwork.check_append routeCheckB 2816 256 438 routeCheckB11 (BitNetwork.check_append routeCheckB 3072 256 182 routeCheckB12 routeCheckB13)))))))))))))

theorem networkB_routes (x : Fin 3510) :
    BitNetwork.route networkB (fastB x).val = some x.val := by
  have h := BitNetwork.check_sound routeCheckB 0 3510 routeCheckB_all x.val
    (Nat.zero_le _) x.isLt
  simpa only [routeCheckB, Nat.mod_eq_of_lt x.isLt, decide_eq_true_eq] using h

private def rowCheckB (i : Nat) : Bool := decide (rowMask (fastB ⟨i % 3510, Nat.mod_lt _ (by decide)⟩) =
