  ⟨2, , , ⟩,
  ⟨1, , , ⟩
]

private def routeCheckA (i : Nat) : Bool := decide (BitNetwork.route networkA (fastA ⟨i % 3510, Nat.mod_lt _ (by decide)⟩).val = some i)

set_option maxRecDepth 100000 in
private theorem routeCheckA0 : BitNetwork.check routeCheckA 0 256 = true := by
