private theorem rowCheckA_all : BitNetwork.check rowCheckA 0 3510 = true :=
  (BitNetwork.check_append rowCheckA 0 256 3254 rowCheckA0 (BitNetwork.check_append rowCheckA 256 256 2998 rowCheckA1 (BitNetwork.check_append rowCheckA 512 256 2742 rowCheckA2 (BitNetwork.check_append rowCheckA 768 256 2486 rowCheckA3 (BitNetwork.check_append rowCheckA 1024 256 2230 rowCheckA4 (BitNetwork.check_append rowCheckA 1280 256 1974 rowCheckA5 (BitNetwork.check_append rowCheckA 1536 256 1718 rowCheckA6 (BitNetwork.check_append rowCheckA 1792 256 1462 rowCheckA7 (BitNetwork.check_append rowCheckA 2048 256 1206 rowCheckA8 (BitNetwork.check_append rowCheckA 2304 256 950 rowCheckA9 (BitNetwork.check_append rowCheckA 2560 256 694 rowCheckA10 (BitNetwork.check_append rowCheckA 2816 256 438 rowCheckA11 (BitNetwork.check_append rowCheckA 3072 256 182 rowCheckA12 rowCheckA13)))))))))))))

theorem networkA_rows (x : Fin 3510) :
    rowMask (fastA x) = BitNetwork.apply networkA (rowMask x) := by
  have h := BitNetwork.check_sound rowCheckA 0 3510 rowCheckA_all x.val
    (Nat.zero_le _) x.isLt
  simpa only [rowCheckA, Nat.mod_eq_of_lt x.isLt, decide_eq_true_eq] using h

theorem related_fastA (x y : Fin 3510) :
    related (fastA x) (fastA y) = related x y := by
  unfold related
  rw [networkA_rows]
  exact BitNetwork.sound networkA _ _ _ (networkA_routes y)

