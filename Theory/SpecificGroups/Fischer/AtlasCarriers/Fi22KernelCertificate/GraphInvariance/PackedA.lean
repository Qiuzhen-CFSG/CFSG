private theorem routeCheckA_all : BitNetwork.check routeCheckA 0 3510 = true :=
  (BitNetwork.check_append routeCheckA 0 256 3254 routeCheckA0 (BitNetwork.check_append routeCheckA 256 256 2998 routeCheckA1 (BitNetwork.check_append routeCheckA 512 256 2742 routeCheckA2 (BitNetwork.check_append routeCheckA 768 256 2486 routeCheckA3 (BitNetwork.check_append routeCheckA 1024 256 2230 routeCheckA4 (BitNetwork.check_append routeCheckA 1280 256 1974 routeCheckA5 (BitNetwork.check_append routeCheckA 1536 256 1718 routeCheckA6 (BitNetwork.check_append routeCheckA 1792 256 1462 routeCheckA7 (BitNetwork.check_append routeCheckA 2048 256 1206 routeCheckA8 (BitNetwork.check_append routeCheckA 2304 256 950 routeCheckA9 (BitNetwork.check_append routeCheckA 2560 256 694 routeCheckA10 (BitNetwork.check_append routeCheckA 2816 256 438 routeCheckA11 (BitNetwork.check_append routeCheckA 3072 256 182 routeCheckA12 routeCheckA13)))))))))))))

theorem networkA_routes (x : Fin 3510) :
    BitNetwork.route networkA (fastA x).val = some x.val := by
  have h := BitNetwork.check_sound routeCheckA 0 3510 routeCheckA_all x.val
    (Nat.zero_le _) x.isLt
  simpa only [routeCheckA, Nat.mod_eq_of_lt x.isLt, decide_eq_true_eq] using h

private def rowCheckA (i : Nat) : Bool := decide (rowMask (fastA ⟨i % 3510, Nat.mod_lt _ (by decide)⟩) =
    BitNetwork.apply networkA (rowMask ⟨i % 3510, Nat.mod_lt _ (by decide)⟩))

