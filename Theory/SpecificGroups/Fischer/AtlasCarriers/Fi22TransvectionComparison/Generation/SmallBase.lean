module

public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22TransvectionComparison.Generation.Evaluation
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22KernelCertificate.GraphInvariance
/-!
# A 48-point equality test in the actual Fi22 carrier

The first 48 entries of every row of the certified invariant graph form a
signature. A kernel-checked recovery table shows that these signatures are
injective on all 3510 points. An element fixing the first 48 points preserves
every signature, hence fixes every point and is the identity.

This is a faithful-coordinate certificate, not an order or simplicity argument.
`schreierEdge_eq_of_first48` applies it to the literal shared transporters, and
`Generation.Seeds` uses it to certify commuting conjugates for edge words.

Source: ATLAS F22G1-p3510B0 and the conjugation action in GLS3 Table 5.3t,
`refs/KGroup/GLS3/Chapter5(sec3-).tex`. The graph's invariance is already proved
in `Fi22KernelCertificate.GraphInvariance`. Reproduce the auxiliary recovery
data with `Generation/source/generate.py --check`.
-/

@[expose] public section

namespace Sporadic.Fischer.Fi22.TransvectionComparison.Generation.SmallBase
open KernelCertificate

def signature (x : Fin 3510) : Nat := rowMask x % 2 ^ 48

def keysPacked : Nat := 

def indicesPacked : Nat := 

def recoverIndex (s : Nat) : Nat → Nat → Nat → Nat
  | 0, lo, _ => lo
  | fuel + 1, lo, hi =>
    let mid := (lo + hi) / 2
    if s < ((keysPacked >>> (48 * mid)) % 2^48) then
      recoverIndex s fuel lo mid
    else
      recoverIndex s fuel mid hi

def recover (s : Nat) : Nat :=
  (indicesPacked >>> (12 * recoverIndex s 12 0 3510)) % 4096

private def recoveryCheck (i : Nat) : Bool :=
  let x : Fin 3510 := ⟨i % 3510, Nat.mod_lt _ (by decide)⟩
  decide (recover (signature x) = x.val)

set_option maxRecDepth 4096 in
private theorem recoveryCheck0 : BitNetwork.check recoveryCheck 0 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck1 : BitNetwork.check recoveryCheck 256 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck2 : BitNetwork.check recoveryCheck 512 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck3 : BitNetwork.check recoveryCheck 768 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck4 : BitNetwork.check recoveryCheck 1024 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck5 : BitNetwork.check recoveryCheck 1280 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck6 : BitNetwork.check recoveryCheck 1536 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck7 : BitNetwork.check recoveryCheck 1792 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck8 : BitNetwork.check recoveryCheck 2048 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck9 : BitNetwork.check recoveryCheck 2304 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck10 : BitNetwork.check recoveryCheck 2560 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck11 : BitNetwork.check recoveryCheck 2816 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck12 : BitNetwork.check recoveryCheck 3072 256 = true := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem recoveryCheck13 : BitNetwork.check recoveryCheck 3328 182 = true := by
  decide +kernel

private theorem recoveryCheck_all : BitNetwork.check recoveryCheck 0 3510 = true :=
  (BitNetwork.check_append recoveryCheck 0 256 3254 recoveryCheck0
    (BitNetwork.check_append recoveryCheck 256 256 2998 recoveryCheck1
    (BitNetwork.check_append recoveryCheck 512 256 2742 recoveryCheck2
    (BitNetwork.check_append recoveryCheck 768 256 2486 recoveryCheck3
    (BitNetwork.check_append recoveryCheck 1024 256 2230 recoveryCheck4
    (BitNetwork.check_append recoveryCheck 1280 256 1974 recoveryCheck5
    (BitNetwork.check_append recoveryCheck 1536 256 1718 recoveryCheck6
    (BitNetwork.check_append recoveryCheck 1792 256 1462 recoveryCheck7
    (BitNetwork.check_append recoveryCheck 2048 256 1206 recoveryCheck8
    (BitNetwork.check_append recoveryCheck 2304 256 950 recoveryCheck9
    (BitNetwork.check_append recoveryCheck 2560 256 694 recoveryCheck10
    (BitNetwork.check_append recoveryCheck 2816 256 438 recoveryCheck11
    (BitNetwork.check_append recoveryCheck 3072 256 182 recoveryCheck12
    recoveryCheck13)))))))))))))

theorem recover_signature (x : Fin 3510) : recover (signature x) = x.val := by
  have hx := BitNetwork.check_sound recoveryCheck 0 3510 recoveryCheck_all x.val
    (Nat.zero_le _) x.isLt
  simpa only [recoveryCheck, Nat.mod_eq_of_lt x.isLt, decide_eq_true_eq] using hx

theorem signature_injective : Function.Injective signature := by
  intro x y hxy
  apply Fin.ext
  rw [← recover_signature x, ← recover_signature y, hxy]

theorem related_inclusion (g : Carrier) (x y : Fin 3510) :
    related (inclusion g x) (inclusion g y) = related x y := by
  have hp (p : Equiv.Perm (Fin 3510)) (h : p ∈ generated) :
      ∀ x y, related (p x) (p y) = related x y := by
    induction h using Subgroup.closure_induction with
    | mem p hp =>
      rcases hp with rfl | hp
      · exact related_generatorA
      · have he : p = generatorB := hp
        subst p
        exact related_generatorB
    | one => intro x y; rfl
    | mul p q _ _ hp hq =>
      intro x y
      simp only [Equiv.Perm.mul_apply, hp, hq]
    | inv p _ hp =>
      intro x y
      simpa using (hp (p⁻¹ x) (p⁻¹ y)).symm
  exact hp g.val g.property x y

/-- Inclusion of the first 48 coordinates into the degree-3510 action. -/
def basePoint (i : Fin 48) : Fin 3510 := ⟨i.val, lt_trans i.isLt (by decide)⟩

theorem signature_eq_of_fixed (g : Carrier)
    (hg : ∀ i : Fin 48, inclusion g (basePoint i) = basePoint i) (x : Fin 3510) :
    signature (inclusion g x) = signature x := by
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [signature, Nat.testBit_mod_two_pow]
  by_cases hi : i < 48
  · have h := related_inclusion g x (basePoint ⟨i, hi⟩)
    rw [hg] at h
    simpa only [related, basePoint, hi, decide_true, Bool.true_and] using h
  · simp only [hi, decide_false, Bool.false_and]

theorem eq_one_of_fixed
    (g : Carrier) (hg : ∀ i : Fin 48, inclusion g (basePoint i) = basePoint i) : g = 1 := by
  apply inclusion_injective
  apply Equiv.ext
  intro x
  change inclusion g x = x
  exact signature_injective (signature_eq_of_fixed g hg x)

theorem ext_of_first48
    (g h : Carrier) (heq : ∀ i : Fin 48, inclusion g (basePoint i) = inclusion h (basePoint i)) :
    g = h := by
  have hid : h⁻¹ * g = 1 := eq_one_of_fixed _ (fun i => by
    simp only [map_mul, map_inv, Equiv.Perm.mul_apply, heq i,
      Equiv.Perm.inv_def, Equiv.symm_apply_apply])
  exact (inv_mul_eq_one.mp hid).symm

/-- The literal Schreier edge can be checked on just these 48 coordinates. -/
theorem schreierEdge_eq_of_first48
    (s : Carrier) (x : Fin 3510) (w : Carrier)
    (h : ∀ i : Fin 48,
      inclusion w (basePoint i) =
        transportInverseAction (inclusion s x)
          (inclusion s (transportAction x (basePoint i)))) :
    (pointTransport (inclusion s x))⁻¹ * s * pointTransport x = w := by
  apply ext_of_first48
  intro i
  simpa only [map_mul, Equiv.Perm.mul_apply, transportInverseAction_eq,
    transportAction_eq] using (h i).symm

end Sporadic.Fischer.Fi22.TransvectionComparison.Generation.SmallBase
