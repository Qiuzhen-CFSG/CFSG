def codeBlockB (n : Nat) : Array Nat :=
  (if n < 27 then (if n < 13 then (if n < 6 then (if n < 3 then (if n < 1 then codesB00 else (if n < 2 then codesB01 else codesB02)) else (if n < 4 then codesB03 else (if n < 5 then codesB04 else codesB05))) else (if n < 9 then (if n < 7 then codesB06 else (if n < 8 then codesB07 else codesB08)) else (if n < 11 then (if n < 10 then codesB09 else codesB10) else (if n < 12 then codesB11 else codesB12)))) else (if n < 20 then (if n < 16 then (if n < 14 then codesB13 else (if n < 15 then codesB14 else codesB15)) else (if n < 18 then (if n < 17 then codesB16 else codesB17) else (if n < 19 then codesB18 else codesB19))) else (if n < 23 then (if n < 21 then codesB20 else (if n < 22 then codesB21 else codesB22)) else (if n < 25 then (if n < 24 then codesB23 else codesB24) else (if n < 26 then codesB25 else codesB26))))) else (if n < 41 then (if n < 34 then (if n < 30 then (if n < 28 then codesB27 else (if n < 29 then codesB28 else codesB29)) else (if n < 32 then (if n < 31 then codesB30 else codesB31) else (if n < 33 then codesB32 else codesB33))) else (if n < 37 then (if n < 35 then codesB34 else (if n < 36 then codesB35 else codesB36)) else (if n < 39 then (if n < 38 then codesB37 else codesB38) else (if n < 40 then codesB39 else codesB40)))) else (if n < 48 then (if n < 44 then (if n < 42 then codesB41 else (if n < 43 then codesB42 else codesB43)) else (if n < 46 then (if n < 45 then codesB44 else codesB45) else (if n < 47 then codesB46 else codesB47))) else (if n < 51 then (if n < 49 then codesB48 else (if n < 50 then codesB49 else codesB50)) else (if n < 53 then (if n < 52 then codesB51 else codesB52) else (if n < 54 then codesB53 else codesB54))))))

def edgeWord (b : Bool) (x : Fin 3510) : List (Entry × Bool) :=
  let block := if b then codeBlockB (x.val / 64) else codeBlockA (x.val / 64)
  decodeWord 18 block[x.val % 64]!

def edgeCoordinateCheck (b : Bool) (x : Fin 3510) (n : Nat) : Bool :=
  let i : Fin 48 := ⟨n % 48, Nat.mod_lt _ (by decide)⟩
  decide (wordAction (edgeWord b x) (basePoint i) =
    transportInverseAction (forwardLetter b x)
      (forwardLetter b (transportAction x (basePoint i))))

def edgeCheck (b : Bool) (n : Nat) : Bool :=
  let x : Fin 3510 := ⟨n % 3510, Nat.mod_lt _ (by decide)⟩
  treeCheck b x || BitNetwork.check (edgeCoordinateCheck b x) 0 48

theorem edgeCheck_mem (b : Bool)
    (h : BitNetwork.check (edgeCheck b) 0 3510 = true) (x : Fin 3510) :
    (pointTransport (inclusion (if b then atlasB else atlasA) x))⁻¹ *
      (if b then atlasB else atlasA) * pointTransport x ∈ commutingConjugateSubgroup := by
  have hs (y : Fin 3510) :
      inclusion (if b then atlasB else atlasA) y = forwardLetter b y := by
    cases b
    · exact generatorA_apply_eq_fastA y
    · exact generatorB_apply_eq_fastB y
  have hx := BitNetwork.check_sound _ _ _ h x.val (Nat.zero_le _) x.isLt
  have hx' : (treeCheck b x || BitNetwork.check (edgeCoordinateCheck b x) 0 48) = true := by
    simpa only [edgeCheck, Nat.mod_eq_of_lt x.isLt] using hx
  simp only [Bool.or_eq_true] at hx'
  rcases hx' with ht | hx'
  · exact treeCheck_mem b x ht
  rw [schreierEdge_eq_of_first48 _ x (wordElement (edgeWord b x)) (fun i => by
    have hi := BitNetwork.check_sound _ _ _ hx' i.val (Nat.zero_le _) i.isLt
    have hi' : wordAction (edgeWord b x) (basePoint i) =
        transportInverseAction (forwardLetter b x)
          (forwardLetter b (transportAction x (basePoint i))) := by
      simpa only [edgeCoordinateCheck, Nat.mod_eq_of_lt i.isLt, decide_eq_true_eq] using hi
    simpa only [wordAction_eq, hs] using hi')]
  exact wordElement_mem _

