module

public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22TransvectionComparison.RootWords
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22KernelCertificate.GraphInvariance.ComparisonA
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22KernelCertificate.GraphInvariance.ComparisonB
/-!
# Evaluation of the shared Fi22 conjugate words

The existing checked packed maps evaluate the two defining ATLAS generators.
A checked inverse table for B and the involution equation for A evaluate their
inverses. Folding these maps evaluates `pointTransport`, its inverse, and
`conjugateAt` on an arbitrary point, with proofs against the literal carrier.

Application: `Generation.Fiber` certifies the distinguished conjugate fiber;
Schreier word certificates can use the same evaluators. In particular, inverse
letters are retained when converting the published right action to Lean's
left action. This module asserts no centralizer identification.

Source: ATLAS F22G1-p3510B0 and GLS3 Table 5.3t, including its conjugation-action
paragraph in `refs/KGroup/GLS3/Chapter5(sec3-).tex`. The inverse table is
reproduced by `Generation/source/generate.py --check`; all checks are in Lean.
-/

@[expose] public section

namespace Sporadic.Fischer.Fi22.TransvectionComparison.Generation
open KernelCertificate

/-- Packed forward images in the original ATLAS right-action B table. -/
def inverseBPacked : Nat := 

/-- A candidate inverse of the Lean generator B, certified below. -/
def inverseB (x : Fin 3510) : Fin 3510 :=
  ⟨(inverseBPacked >>> (12 * x.val)) % 4096 % 3510, Nat.mod_lt _ (by decide)⟩

private def inverseCheck (i : Nat) : Bool :=
  let x : Fin 3510 := ⟨i % 3510, Nat.mod_lt _ (by decide)⟩
  decide (fastB (inverseB x) = x)

set_option maxRecDepth 16384 in
private theorem inverseCheck_all : BitNetwork.check inverseCheck 0 3510 = true := by
  decide +kernel

def forwardLetter (b : Bool) (x : Fin 3510) : Fin 3510 :=
  if b then fastB x else fastA x

def backwardLetter (b : Bool) (x : Fin 3510) : Fin 3510 :=
  if b then inverseB x else fastA x

def transportAction (x y : Fin 3510) : Fin 3510 :=
  ((rootWordCode x).bits.dropLast).foldr backwardLetter y

def transportInverseAction (x y : Fin 3510) : Fin 3510 :=
  ((rootWordCode x).bits.dropLast).foldl (fun y b => forwardLetter b y) y

def rootAction (x y : Fin 3510) : Fin 3510 :=
  transportAction x (fastA (transportInverseAction x y))

theorem inverseB_eq (x : Fin 3510) : inverseB x = generatorB⁻¹ x := by
  have h := BitNetwork.check_sound inverseCheck 0 3510 inverseCheck_all x.val
    (Nat.zero_le _) x.isLt
  have hx : fastB (inverseB x) = x := by
    simpa only [inverseCheck, Nat.mod_eq_of_lt x.isLt, decide_eq_true_eq] using h
  apply generatorB.injective
  rw [Equiv.Perm.inv_def, Equiv.apply_symm_apply, generatorB_apply_eq_fastB]
  exact hx

theorem inclusion_atlasB : inclusion atlasB = generatorB := rfl

theorem backwardLetter_eq (b : Bool) (x : Fin 3510) :
    backwardLetter b x = inclusion (inverseLetter b) x := by
  have hA : generatorA⁻¹ = generatorA := inv_eq_of_mul_eq_one_right
    (by simpa only [pow_two] using generatorA_sq)
  cases b
  · simpa only [backwardLetter, inverseLetter, Bool.false_eq_true, if_false,
      map_inv, inclusion_atlasA, hA] using (generatorA_apply_eq_fastA x).symm
  · simpa only [backwardLetter, inverseLetter, if_true, map_inv, inclusion_atlasB] using inverseB_eq x

theorem forwardLetter_eq (b : Bool) (x : Fin 3510) :
    forwardLetter b x = inclusion (inverseLetter b)⁻¹ x := by
  cases b
  · simpa only [forwardLetter, inverseLetter, Bool.false_eq_true, if_false,
      inv_inv, inclusion_atlasA] using (generatorA_apply_eq_fastA x).symm
  · simpa only [forwardLetter, inverseLetter, if_true, inv_inv, inclusion_atlasB] using
      (generatorB_apply_eq_fastB x).symm

theorem foldr_backwardLetter (bs : List Bool) (y : Fin 3510) :
    bs.foldr backwardLetter y = inclusion ((bs.map inverseLetter).prod) y := by
  induction bs with
  | nil => rfl
  | cons b bs ih =>
    simpa only [List.foldr_cons, List.map_cons, List.prod_cons, map_mul,
      Equiv.Perm.mul_apply, backwardLetter_eq] using congrArg (inclusion (inverseLetter b)) ih

theorem foldl_forwardLetter (bs : List Bool) (y : Fin 3510) :
    bs.foldl (fun y b => forwardLetter b y) y =
      inclusion ((bs.map inverseLetter).prod)⁻¹ y := by
  induction bs generalizing y with
  | nil => rfl
  | cons b bs ih =>
    simpa only [List.foldl_cons, List.map_cons, List.prod_cons, mul_inv_rev,
      map_mul, Equiv.Perm.mul_apply, forwardLetter_eq] using ih (forwardLetter b y)

theorem transportAction_eq (x y : Fin 3510) :
    transportAction x y = inclusion (pointTransport x) y :=
  foldr_backwardLetter _ y

theorem transportInverseAction_eq (x y : Fin 3510) :
    transportInverseAction x y = inclusion (pointTransport x)⁻¹ y :=
  foldl_forwardLetter _ y

theorem rootAction_eq (x y : Fin 3510) :
    rootAction x y = inclusion (conjugateAt x) y := by
  simp only [rootAction, transportAction_eq, transportInverseAction_eq,
    conjugateAt, map_mul, Equiv.Perm.mul_apply, inclusion_atlasA,
    generatorA_apply_eq_fastA]
end Sporadic.Fischer.Fi22.TransvectionComparison.Generation
