/-- Binary code of the original right-action word, indexed by a zero-based point. -/
def rootWordCode (x : Fin 3510) : Nat := (WordData.rootWordBlock (x.val / 64))[x.val % 64]!

/-- Invert a letter while passing from the right-action word to its transporter. -/
def inverseLetter (b : Bool) : Carrier := if b then atlasB⁻¹ else atlasA⁻¹

/-- A candidate left-action transporter to the specified point. -/
def pointTransport (x : Fin 3510) : Carrier :=
  (((rootWordCode x).bits.dropLast).map inverseLetter).prod

/-- The conjugate given by the actual word, with no geometric identification assumed. -/
def conjugateAt (x : Fin 3510) : Carrier :=
  pointTransport x * atlasA * (pointTransport x)⁻¹

theorem conjugateAt_isConj (x : Fin 3510) : IsConj atlasA (conjugateAt x) :=
  isConj_iff.mpr ⟨pointTransport x, rfl⟩

theorem pointTransport_base : pointTransport rootBase = 1 := by
  have hcode : rootWordCode rootBase = 1 := by decide +kernel
  simp [pointTransport, hcode]

theorem conjugateAt_base : conjugateAt rootBase = atlasA := by
  simp only [conjugateAt, pointTransport_base, one_mul, inv_one, mul_one]

/-- Restrict the fixed conjugate words once their centralizing certificate is supplied. -/
def fixedPointRoot
    (hcentral : ∀ i : FixedPointsA, conjugateAt i.val ∈ centralizerA)
    (i : FixedPointsA) : centralizerA := ⟨conjugateAt i.val, hcentral i⟩

theorem fixedPointRoot_mem
    (hcentral : ∀ i : FixedPointsA, conjugateAt i.val ∈ centralizerA)
    (i : FixedPointsA) : fixedPointRoot hcentral i ∈ commutingConjugates :=
  conjugateAt_isConj i.val

end Sporadic.Fischer.Fi22.TransvectionComparison
