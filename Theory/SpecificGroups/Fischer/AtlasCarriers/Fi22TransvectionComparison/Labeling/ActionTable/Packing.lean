module
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22TransvectionComparison.Labeling.Data

/-!
# Packed lookup for the Fi22 coordinate-action certificate

Twelve-bit coordinate and label tables and a ten-bit inverse index avoid repeated
array reduction in the complete action certificate. Kernel checks compare every
coordinate with the published table and prove that the 694 enumerated labels
cover every fixed point, including the distinguished zero-vector label 1982.
The packed numbers are only data; the comparisons below are their certificates.

Source: the published `Labeling/source/coordinates.json`, ATLAS F22G1-p3510B0,
and GLS3 Table 5.3t. See `AtlasCarriers/source/README.md` for attribution.
-/

@[expose] public section
namespace Sporadic.Fischer.Fi22.TransvectionComparison.Labeling.ActionTable
open KernelCertificate

def coordinatesPacked : Nat := 
def labelsPacked : Nat := 
def indicesPacked : Nat := 

def packedCoordinate (x : Fin 3510) : Nat :=
  (coordinatesPacked >>> (12 * x.val)) % 4096

def label (i : Nat) : Fin 3510 :=
  ⟨(labelsPacked >>> (12 * i)) % 4096 % 3510, Nat.mod_lt _ (by decide)⟩

def labelIndex (x : Fin 3510) : Fin 694 :=
  ⟨(indicesPacked >>> (10 * x.val)) % 1024 % 694, Nat.mod_lt _ (by decide)⟩

private def packingCheck (n : Nat) : Bool :=
  let x : Fin 3510 := ⟨n % 3510, Nat.mod_lt _ (by decide)⟩
  decide (packedCoordinate x = coordinateCode x ∧
    (fastA x = x → label (labelIndex x).val = x))

set_option maxRecDepth 2048 in
private theorem packingCheck0 : BitNetwork.check packingCheck 0 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck1 : BitNetwork.check packingCheck 256 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck2 : BitNetwork.check packingCheck 512 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck3 : BitNetwork.check packingCheck 768 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck4 : BitNetwork.check packingCheck 1024 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck5 : BitNetwork.check packingCheck 1280 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck6 : BitNetwork.check packingCheck 1536 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck7 : BitNetwork.check packingCheck 1792 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck8 : BitNetwork.check packingCheck 2048 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck9 : BitNetwork.check packingCheck 2304 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck10 : BitNetwork.check packingCheck 2560 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck11 : BitNetwork.check packingCheck 2816 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck12 : BitNetwork.check packingCheck 3072 256 = true := by
  decide +kernel

set_option maxRecDepth 2048 in
private theorem packingCheck13 : BitNetwork.check packingCheck 3328 182 = true := by
  decide +kernel

private theorem packingCheck_all : BitNetwork.check packingCheck 0 3510 = true :=
  (BitNetwork.check_append packingCheck 0 256 3254 packingCheck0
    (BitNetwork.check_append packingCheck 256 256 2998 packingCheck1
    (BitNetwork.check_append packingCheck 512 256 2742 packingCheck2
    (BitNetwork.check_append packingCheck 768 256 2486 packingCheck3
    (BitNetwork.check_append packingCheck 1024 256 2230 packingCheck4
    (BitNetwork.check_append packingCheck 1280 256 1974 packingCheck5
    (BitNetwork.check_append packingCheck 1536 256 1718 packingCheck6
    (BitNetwork.check_append packingCheck 1792 256 1462 packingCheck7
    (BitNetwork.check_append packingCheck 2048 256 1206 packingCheck8
    (BitNetwork.check_append packingCheck 2304 256 950 packingCheck9
    (BitNetwork.check_append packingCheck 2560 256 694 packingCheck10
    (BitNetwork.check_append packingCheck 2816 256 438 packingCheck11
    (BitNetwork.check_append packingCheck 3072 256 182 packingCheck12
    packingCheck13)))))))))))))

private theorem packing_spec (x : Fin 3510) :
    packedCoordinate x = coordinateCode x ∧ (fastA x = x → label (labelIndex x).val = x) := by
  have h := BitNetwork.check_sound packingCheck 0 3510 packingCheck_all x.val
    (Nat.zero_le _) x.isLt
  simpa only [packingCheck, Nat.mod_eq_of_lt x.isLt, decide_eq_true_eq] using h

theorem packedCoordinate_eq (x : Fin 3510) : packedCoordinate x = coordinateCode x :=
  (packing_spec x).1

theorem label_labelIndex (x : Fin 3510) (hx : fastA x = x) : label (labelIndex x).val = x :=
  (packing_spec x).2 hx

end Sporadic.Fischer.Fi22.TransvectionComparison.Labeling.ActionTable
