/-- Base-four coordinates of an ambient ATLAS label. -/
def coordinateCode (x : Fin 3510) : Nat :=
  (Data.forward (x.val / 64))[x.val % 64]!

/-- Its explicit vector over the computable quadratic field. -/
def representative (x : Fin 3510) : Fin 6 → Four := vector (coordinateCode x)

/-- Reverse lookup on normalized isotropic vector codes. -/
def decodeLabel (n : Nat) : Fin 3510 :=
  ⟨(Data.backward (n / 64))[n % 64]! % 3510, Nat.mod_lt _ (by decide)⟩

