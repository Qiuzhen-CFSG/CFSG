module
public import Theory.GroupAction.PackedPermutation.Literal
public import Theory.GroupAction.PackedPermutation.Layer
/-!
# Literal orbit labels and induced permutations

The 3510 original Fi24 letters are labeled by the original Fi22 generator
convention. Packed tables also specify the two induced Bray actions and
candidate inverses. The subsequent checks prove every action and inverse
identity; these data alone assert no group-theoretic property.
-/
@[expose] public section
namespace Sporadic.Fischer.Fi24Prime.CentralizerSection.Orbit
open Theory.GroupAction.PackedPermutation
noncomputable def packedPoint : Nat := packed_nat% ""
noncomputable def packedSmallH0 : Nat := packed_nat% ""
noncomputable def packedSmallH1 : Nat := packed_nat% ""
noncomputable def packedSmallInv0 : Nat := packed_nat% ""
noncomputable def packedSmallInv1 : Nat := packed_nat% ""
noncomputable def packedPointInverse : Nat := packed_nat% ""
noncomputable def point (i : Fin 3510) : Fin 306936 :=
  ⟨get 19 packedPoint i % 306936, Nat.mod_lt _ (by decide)⟩
noncomputable def pointInverse (i : Fin 306936) : Fin 3510 :=
  ⟨get 12 packedPointInverse i % 3510, Nat.mod_lt _ (by decide)⟩
noncomputable def small0 (i : Fin 3510) : Fin 3510 :=
  ⟨get 12 packedSmallH0 i % 3510, Nat.mod_lt _ (by decide)⟩
noncomputable def small1 (i : Fin 3510) : Fin 3510 :=
  ⟨get 12 packedSmallH1 i % 3510, Nat.mod_lt _ (by decide)⟩
noncomputable def smallInv0 (i : Fin 3510) : Fin 3510 :=
  ⟨get 12 packedSmallInv0 i % 3510, Nat.mod_lt _ (by decide)⟩
noncomputable def smallInv1 (i : Fin 3510) : Fin 3510 :=
  ⟨get 12 packedSmallInv1 i % 3510, Nat.mod_lt _ (by decide)⟩
end Sporadic.Fischer.Fi24Prime.CentralizerSection.Orbit
