namespace Sporadic.Fischer.Fi24Prime.Fi23Lift.FirstFourModel.StagesTwoFour.Edges

def factorCode (i a : Fin 2) (j : Fin (size i)) : Nat :=
  if i = 0 then FactorData.code2 (2 * j.val + a.val)
  else FactorData.code3 (2 * j.val + a.val)

def decodeFactor (code : Nat) : List (Fin 4 × Bool) :=
  List.ofFn fun k : Fin (code % 64) =>
    let c := code >>> (6 + 3 * k.val)
    (⟨c / 2 % 4, Nat.mod_lt _ (by decide)⟩, c % 2 == 0)

def factors (i a : Fin 2) (j : Fin (size i)) : List (Fin 4 × Bool) :=
  decodeFactor (factorCode i a j)

end Sporadic.Fischer.Fi24Prime.Fi23Lift.FirstFourModel.StagesTwoFour.Edges
