module

public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23InFi24Prime.WordSetup

/-!
# Orbit witnesses for the Fi₂₃ lift base

Each of eight points is defined by applying a word in the actual lifted
generators to label 508. Consequently all eight points belong to the actual
orbit, without a numerical table comparison. The intended zero-based labels
are 508, 509, 510, 511, 512, 518, 538, 1163. Identifying the word images with
these labels is a separate finite computation and is not asserted here.

The words come from the retained Schreier search for the ATLAS representation
F24G1-p306936B0. The source motivation is GLS3 Table 5.3v and its Fi₂₄′ paragraph
in `refs/KGroup/GLS3/Chapter5(sec3-).tex`, line 1053. This module certifies orbit
membership only; it does not assert that the points are a base.
-/

@[expose] public section
namespace Sporadic.Fischer.Fi24Prime.Fi23Lift

/-- Evaluate a word inside the subgroup generated by the two candidate lifts.
The alphabet agrees with `WordSetup.evaluateWord`: 0, 1, 2, 3 mean the first
generator, second generator, and their respective inverses. -/
def evaluateLiftWord (word : List (Fin 4)) : liftedGroup :=
  (word.map fun i => if i = 0 then aLift else if i = 1 then bLift
    else if i = 2 then aLift⁻¹ else bLift⁻¹).prod

/-- Words taking 508 to the eight proposed base points. -/
def baseWord : Fin 8 → List (Fin 4)
  | 0 => []
  | 1 => [2, 3, 2, 3, 2, 3, 2, 3, 2, 1, 2, 1, 2, 3, 2, 3, 2, 1, 2, 1, 2, 3, 2, 3, 2]
  | 2 => [3, 2, 3, 2, 1, 2, 3, 2, 3, 2, 1, 2, 3, 2, 3, 2, 1, 2]
  | 3 => [2, 1, 2, 3, 2, 1, 2, 1, 2, 1, 2, 3, 2, 1, 2, 1, 2, 3, 2, 1, 2, 1, 2, 3]
  | 4 => [2, 3, 2, 1, 2, 1, 2, 3, 2, 3, 2, 1, 2, 3, 2, 3, 2, 1, 2, 1, 2, 1, 2, 3, 2, 1, 2, 3, 2]
  | 5 => [3, 2, 3, 2, 1, 2, 1, 2, 3, 2, 3, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 3, 2, 3, 2, 3, 2]
  | 6 => [3, 2, 3, 2, 1, 2, 1, 2, 3, 2, 3, 2, 1, 2, 1, 2, 3, 2, 1, 2, 1, 2, 1, 2, 3, 2, 1, 2]
  | 7 => [3, 2, 1, 2, 1, 2, 3, 2, 1, 2, 3, 2, 3, 2, 1, 2, 1, 2, 1, 2]

/-- Proposed base points as actual images under elements of the lifted subgroup. -/
def basePoint (i : Fin 8) : Fin 306936 :=
  (evaluateLiftWord (baseWord i)).val.val 508

/-- Orbit membership is certified by the defining word, independently of any
numeric label identification. -/
theorem basePoint_mem_suborbit (i : Fin 8) : basePoint i ∈ suborbit :=
  MulAction.mem_orbit (508 : Fin 306936) (evaluateLiftWord (baseWord i))

/-- The same points in the literal domain of the restricted action. -/
def baseLetter (i : Fin 8) : Letters := ⟨basePoint i, basePoint_mem_suborbit i⟩

/-- Every restriction-kernel element fixes every word-defined base point. -/
theorem fixes_basePoint_of_mem_action_ker (g : liftedGroup) (hg : g ∈ action.ker)
    (i : Fin 8) : g.val.val (basePoint i) = basePoint i :=
  (mem_action_ker_iff g).mp hg (baseLetter i)

end Sporadic.Fischer.Fi24Prime.Fi23Lift
