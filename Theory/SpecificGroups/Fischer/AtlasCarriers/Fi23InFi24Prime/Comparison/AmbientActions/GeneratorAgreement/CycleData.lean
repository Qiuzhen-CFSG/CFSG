/-- Decode a short cycle from consecutive 19-bit fields. -/
def readCycle : Nat → Nat → List (Fin 306936)
  | 0, _ => []
  | k + 1, v => Fin.ofNat 306936 (v % 2 ^ 19) :: readCycle k (v >>> 19)

/-- Decode a block of cycles of the specified common length. -/
def readCycles (arity : Nat) : Nat → Nat → List (List (Fin 306936))
  | 0, _ => []
  | k + 1, v => readCycle arity v :: readCycles arity k (v >>> (19 * arity))

