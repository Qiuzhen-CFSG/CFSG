module

public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi23InFi24Prime.Comparison.AmbientActions.GeneratorAgreement.SourceCertificates.A.Aggregation

/-!
# Complete source certificate for the Fi24' A generator

All 593 original blocks decode exactly to the shared packed witness.
The 303424 letters are distinct and have precisely the declared support.
This discharges the source premise of signed_maps_correct for generator A;
the independent packed-action checks remain with their own assembly owner.

Source: R. A. Wilson et al., ATLAS F24G1-p306936B0.g1, retained with
attribution in AtlasCarriers/source/. Generated by A/source/generate.py;
the Python witnesses are checked by Lean's kernel.
-/

@[expose] public section
namespace Sporadic.Fischer.Fi24Prime.Fi23Lift.Certificate.Ambient.GeneratorAgreement
open AtlasCarriers
open Fi23.CentralizerSection.KernelCertificate.FixedLetterCheck

/-- Exact source decoding and full disjoint support for all 151712 transpositions. -/
theorem sourceA_certificate : SourceCertificate cycleBlocksA cyclesA maskA := by
  constructor
  · apply decode_of_blocks
    rw [← SourceA.blocks_spec, ← SourceA.parts_spec]
    exact SourceA.Node6_0.decoded
  · change Certificate partsA.flatten.flatten maskA
    rw [← SourceA.parts_spec, ← SourceA.mask_spec]
    exact SourceA.Node6_0.support

/-- Apply the source certificate to the literal packed maps, with only their
independent action certificate still required. -/
theorem sourceA_signed_maps
    (ha : ActionCertificate aMap aInvMap cyclesA maskA) :
    (∀ x, aMap x = generatorA x) ∧ (∀ x, aInvMap x = generatorA⁻¹ x) :=
  signed_maps_correct cycleBlocksA cyclesA maskA aMap aInvMap sourceA_certificate ha

end Sporadic.Fischer.Fi24Prime.Fi23Lift.Certificate.Ambient.GeneratorAgreement
