private theorem pair_reverse (a b x : Fin 306936) :
    cycleInv [a, b].reverse x = cycleInv [a, b] x := by
  by_cases ha : x = a <;> by_cases hb : x = b <;> simp_all [cycleInv]

private theorem mem_readPairs (k v : Nat) (c : List (Fin 306936))
    (hc : c ∈ readCycles 2 k v) : ∃ a b, c = [a, b] := by
  induction k generalizing v with
  | zero => simp [readCycles] at hc
  | succ k ih =>
    simp only [readCycles, List.mem_cons] at hc
    rcases hc with rfl | hc
    · exact ⟨_, _, rfl⟩
    · exact ih _ hc

theorem forward_of_inverse_pairs (f : Fin 306936 → Fin 306936) (k v : Nat)
    (h : cycleTest f false (readCycles 2 k v) = true) :
    cycleTest f true (readCycles 2 k v) = true := by
  simp only [cycleTest, List.all_eq_true, beq_iff_eq]
  intro c hc x hx
  obtain ⟨a, b, rfl⟩ := mem_readPairs k v c hc
  change cycleInv [a, b].reverse x = f x
  rw [pair_reverse]
  exact cycleTest_sound f false (readCycles 2 k v) h [a, b] hc x hx

