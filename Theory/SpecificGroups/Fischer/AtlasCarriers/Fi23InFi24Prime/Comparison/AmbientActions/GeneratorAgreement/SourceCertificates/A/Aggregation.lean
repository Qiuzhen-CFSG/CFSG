private theorem append_support
    {ps qs : List (List (List (Fin 306936)))} {a b m : Nat}
    (ha : Certificate ps.flatten.flatten a) (hb : Certificate qs.flatten.flatten b)
    (hd : a &&& b = 0) (hm : a ||| b = m) :
    Certificate (ps ++ qs).flatten.flatten m := by
  rw [← hm]
  simpa only [List.flatten_append] using ha.append hb hd

