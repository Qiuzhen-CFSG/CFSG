/-- Proposed generators at each stage; no stabilizer recognition is assumed. -/
def generators : Fin 9 → List liftedGroup
  | 0 => [aLift, bLift]
  | 1 => [word5, word8]
  | 2 => [word11, word14]
  | 3 => [word17, word20]
  | 4 => [word23, word26, word29, word32]
  | 5 => [word35, word38, word41]
  | 6 => [word44, word47]
  | 7 => [word50]
  | 8 => []

end StabilizerWords

/-- The actual subgroup of the ambient carrier generated by the proposed words
at a stage. Only the word definitions, not GAP's subgroup identifications,
enter this definition. -/
def wordStage (i : Fin 9) : Subgroup Carrier :=
  Subgroup.closure {g | g ∈ (StabilizerWords.generators i).map Subtype.val}

/-- Every stage consists of actual elements of the original lifted subgroup. -/
theorem wordStage_le_liftedGroup (i : Fin 9) : wordStage i ≤ liftedGroup := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  obtain ⟨w, _, rfl⟩ := List.mem_map.mp hg
  exact w.property

/-- The initial word group is the exact subgroup in `WordSetup`. -/
theorem wordStage_zero : wordStage 0 = liftedGroup := by
  unfold wordStage
  apply congrArg Subgroup.closure
  ext g
  simp only [Set.mem_ofPred_eq, StabilizerWords.generators, List.map_cons, List.map_nil,
    List.mem_cons, List.not_mem_nil, or_false, Set.mem_insert_iff, Set.mem_singleton_iff,
    aLift, bLift]

/-- The last word list is empty, hence its generated subgroup is trivial. -/
theorem wordStage_last : wordStage (Fin.last 8) = ⊥ := by
  simp [wordStage, StabilizerWords.generators, Fin.last]

end Sporadic.Fischer.Fi24Prime.Fi23Lift
