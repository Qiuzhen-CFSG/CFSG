module

public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22CentralizerAction
public import Theory.SpecificGroups.ClassicalUnitary.SixDimensionalBinaryTransvections
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22TransvectionComparison.RootWords
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22TransvectionComparison.Generation
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22TransvectionComparison.Labeling

/-!
# The Fi22 fixed-point image as the unitary transvection permutation group

A point labeling and a point-indexed family covering all commuting
conjugates supply the generators of the relabeled action. The pointwise
intertwining identities identify their images with the specified unitary
transvection permutations, together with the identity. Taking closures
therefore proves both image inclusions. The checked Schreier-edge and coordinate
certificates supply centralizer generation, root coverage, and the action table.

`labelingEquiv_image_eq` proves the concrete image equality for the explicit
labeling, and `exists_image_eq` gives its existential form without any extra
premises. This is the permutation-action comparison used for GLS3 Table 5.3t
(`refs/KGroup/GLS3/Chapter5(sec3-).tex`). Generation of the full matrix group is
a separate result; the parent `Fi22UnitaryComparison` owns that final assembly.
-/

@[expose] public section

namespace Sporadic.Fischer.Fi22.TransvectionComparison
open Theory.SpecificGroups

/-- The actual image equality follows from centralizer generation and the
pointwise action table of its commuting conjugates. The hypotheses are the
two independent concrete certificate obligations, not a centralizer isomorphism. -/
theorem image_eq_of_root_actions
    (e : FixedPointsA ≃ U6Two.PointWithSingleton)
    (root : FixedPointsA → centralizerA)
    (hroot : Set.range root = commutingConjugates)
    (hgen : Subgroup.closure commutingConjugates = ⊤)
    (haction : ∀ i j, e (fixedPointAction (root i) j) =
      pointTransvection (e i) (e j)) :
    fixedPointAction.range.map e.permCongrHom.toMonoidHom =
      U6Two.transvectionPermutationSubgroup := by
  let f := e.permCongrHom.toMonoidHom.comp fixedPointAction
  have hf (i : FixedPointsA) : f (root i) = pointTransvection (e i) := by
    apply Equiv.ext
    intro q
    obtain ⟨j, rfl⟩ := e.surjective q
    change e (fixedPointAction (root i) (e.symm (e j))) = _
    rw [e.symm_apply_apply]
    exact haction i j
  have hrange : f '' Set.range root = Set.range pointTransvection := by
    ext q
    constructor
    · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
      exact ⟨e i, (hf i).symm⟩
    · rintro ⟨p, rfl⟩
      obtain ⟨i, rfl⟩ := e.surjective p
      exact ⟨root i, ⟨i, rfl⟩, hf i⟩
  calc
    fixedPointAction.range.map e.permCongrHom.toMonoidHom = f.range :=
      (MonoidHom.range_comp _ _).symm
    _ = (Subgroup.closure (Set.range root)).map f := by
      rw [hroot, hgen, ← MonoidHom.range_eq_map]
    _ = Subgroup.closure (Set.range pointTransvection) := by
      rw [MonoidHom.map_closure, hrange]
    _ = U6Two.transvectionPermutationSubgroup := pointTransvection_closure

/-- Assemble the two certificate branches using the same fixed ATLAS words.
The labeling branch may take centralizing membership as an explicit premise;
the centralizer branch must construct that premise and prove coverage and generation. -/
theorem exists_image_eq_of_word_certificates
    (hcentral : ∀ i : FixedPointsA, conjugateAt i.val ∈ centralizerA)
    (hcoverage : Set.range (fixedPointRoot hcentral) = commutingConjugates)
    (hgen : Subgroup.closure commutingConjugates = ⊤)
    (hlabel : ∀ hc : ∀ i : FixedPointsA, conjugateAt i.val ∈ centralizerA,
      ∃ e : FixedPointsA ≃ U6Two.PointWithSingleton,
        ∀ i j, e (fixedPointAction (fixedPointRoot hc i) j) =
          pointTransvection (e i) (e j)) :
    ∃ e : FixedPointsA ≃ U6Two.PointWithSingleton,
      fixedPointAction.range.map e.permCongrHom.toMonoidHom =
        U6Two.transvectionPermutationSubgroup := by
  obtain ⟨e, he⟩ := hlabel hcentral
  exact ⟨e, image_eq_of_root_actions e (fixedPointRoot hcentral) hcoverage hgen he⟩

/-- The explicit labeling identifies the image of the actual ATLAS centralizer
with the subgroup generated by the unitary permutations `I + v vᴴ`.
The Schreier and coordinate certificates discharge every premise. -/
theorem labelingEquiv_image_eq :
    fixedPointAction.range.map Labeling.labelingEquiv.permCongrHom.toMonoidHom =
      U6Two.transvectionPermutationSubgroup := by
  obtain ⟨hc, hcoverage, hgen⟩ := exists_commutingConjugate_certificate
  exact image_eq_of_root_actions Labeling.labelingEquiv (fixedPointRoot hc)
    hcoverage hgen (labelingEquiv_action hc)

/-- The Fi22 fixed-point action is, under an actual bijective labeling, precisely
the permutation group generated by the specified isotropic transvections. -/
theorem exists_image_eq :
    ∃ e : FixedPointsA ≃ U6Two.PointWithSingleton,
      fixedPointAction.range.map e.permCongrHom.toMonoidHom =
        U6Two.transvectionPermutationSubgroup :=
  ⟨Labeling.labelingEquiv, labelingEquiv_image_eq⟩

end Sporadic.Fischer.Fi22.TransvectionComparison
