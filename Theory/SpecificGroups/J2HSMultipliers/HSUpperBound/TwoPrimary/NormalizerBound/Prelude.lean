module

public import Theory.SpecificGroups.J2HSMultipliers.HSUpperBound.TwoPrimary.Reduction

/-!
# The split core preimage in an arbitrary HS normalizer cover

Write A for the full inverse image of the actual C₄³ two-core and R=[A,D].
An order-seven actor on the concrete core proves that R maps onto that core,
hence A=R ker(g). A group-homomorphic core section, together with centrality
of ker(g), makes A abelian. Replacing a commutator argument by its section
lift then proves that every generator of R, and hence R itself, has fourth
power one. No invariance of the chosen section is asserted or needed.

These are the shared group-theoretic inputs to the remaining central module
bound in `NormalizerBound`. The kernel itself may still have arbitrary
order and exponent at this stage; only its intersection with R inherits
the fourth-power bound. Source: the HS normalizer calculation in
Aschbacher–Smith I.2.2(5), printed p.412, generalized to the explicit
core-section hypotheses used for I.1.3(1), printed p.407.
-/

public section

open Subgroup
open scoped commutatorElement IsMulCommutative
namespace Theory.SpecificGroups.J2HSMultipliers.HS.TwoPrimary.NormalizerBound
open Sporadic.LeechRelated.HS BlockNormalizer

variable {D : Type*} [Group D]

/-- The full inverse image of the literal normalizer two-core. -/
@[expose] def corePreimage (g : D →* baseNormalizer) : Subgroup D :=
  (pCore 2 baseNormalizer).comap g

/-- The subgroup generated by displacements of the core preimage. -/
@[expose] def coreDisplacements (g : D →* baseNormalizer) : Subgroup D :=
  ⁅corePreimage g, ⊤⁆

instance corePreimage_normal (g : D →* baseNormalizer) : (corePreimage g).Normal :=
  inferInstanceAs ((pCore 2 baseNormalizer).comap g).Normal

instance coreDisplacements_normal (g : D →* baseNormalizer) : (coreDisplacements g).Normal :=
  inferInstanceAs (⁅corePreimage g, ⊤⁆ : Subgroup D).Normal

theorem coreDisplacements_le (g : D →* baseNormalizer) :
    coreDisplacements g ≤ corePreimage g := commutator_le_left _ _

theorem core_displacement_eq : ⁅pCore 2 baseNormalizer, ⊤⁆ = pCore 2 baseNormalizer := by
  refine le_antisymm (commutator_le_left _ _) ?_
  obtain ⟨y, _, hfree⟩ := CoreGeometry.exists_seven_fixedPointFree
  intro q hq
  obtain ⟨a, ha⟩ := hfree.commutatorMap_surjective (⟨q, hq⟩ : pCore 2 baseNormalizer)
  have heq : (a : baseNormalizer) / (y * (a : baseNormalizer) * y⁻¹) = q :=
    congrArg Subtype.val ha
  rw [← heq]
  have hc := commutator_mem_commutator a.property (mem_top y)
  simpa only [commutatorElement_def, div_eq_mul_inv, mul_inv_rev, inv_inv, mul_assoc] using hc

theorem coreDisplacements_map (g : D →* baseNormalizer) (hg : Function.Surjective g) :
    (coreDisplacements g).map g = pCore 2 baseNormalizer := by
  rw [coreDisplacements, map_commutator, corePreimage,
    map_comap_eq_self (by rw [MonoidHom.range_eq_top.mpr hg]; exact le_top),
    ← MonoidHom.range_eq_map, MonoidHom.range_eq_top.mpr hg, core_displacement_eq]

theorem corePreimage_eq (g : D →* baseNormalizer) (hg : Function.Surjective g) :
    corePreimage g = coreDisplacements g ⊔ g.ker := by
  have h := congrArg (Subgroup.comap g) (coreDisplacements_map g hg)
  rw [comap_map_eq] at h
  exact h.symm

theorem corePreimage_commutative (g : D →* baseNormalizer) (hk : g.ker ≤ center D)
    (s : pCore 2 baseNormalizer →* D)
    (hs : g.comp s = (pCore 2 baseNormalizer).subtype) :
    IsMulCommutative (corePreimage g) := by
  apply IsMulCommutative.of_comm
  intro x y
  apply Subtype.ext
  apply commutatorElement_eq_one_iff_mul_comm.mp
  let a : pCore 2 baseNormalizer := ⟨g x, x.property⟩
  let b : pCore 2 baseNormalizer := ⟨g y, y.property⟩
  have hsec (q : pCore 2 baseNormalizer) : g (s q) = q := DFunLike.congr_fun hs q
  rw [CentralExtension.commutator_eq_of_image_eq g hk
    (x := (x : D)) (x' := s a) (y := (y : D)) (y' := s b)
    (hsec a).symm (hsec b).symm]
  exact (Commute.map (show Commute a b from mul_comm a b) s).commutator_eq

theorem coreDisplacements_fourth (g : D →* baseNormalizer) (hk : g.ker ≤ center D)
    (s : pCore 2 baseNormalizer →* D)
    (hs : g.comp s = (pCore 2 baseNormalizer).subtype)
    (z : coreDisplacements g) : z ^ 4 = 1 := by
  let := corePreimage_commutative g hk s hs
  have hc (x y : D) (hx : x ∈ corePreimage g) (hy : y ∈ corePreimage g) : Commute x y :=
    congrArg Subtype.val (mul_comm (⟨x,hx⟩ : corePreimage g) ⟨y,hy⟩)
  have hsec (q : pCore 2 baseNormalizer) : g (s q) = q := DFunLike.congr_fun hs q
  have hgen (x : D) (hx : x ∈ corePreimage g) (d : D) : ⁅x,d⁆ ^ 4 = 1 := by
    let q : pCore 2 baseNormalizer := ⟨g x, hx⟩
    have hsQ : s q ∈ corePreimage g := by change g (s q) ∈ pCore 2 baseNormalizer; rw [hsec]; exact q.property
    have hs4 : s q ^ 4 = 1 := by rw [← map_pow, CoreGeometry.core_fourth_power, map_one]
    rw [CentralExtension.commutator_eq_of_image_eq g hk (hsec q).symm rfl]
    have ht : d * (s q)⁻¹ * d⁻¹ ∈ corePreimage g :=
      (inferInstance : (corePreimage g).Normal).conj_mem _ ((corePreimage g).inv_mem hsQ) d
    rw [commutatorElement_def, mul_assoc, mul_assoc,
      ← mul_assoc d, (hc (s q) (d * (s q)⁻¹ * d⁻¹) hsQ ht).mul_pow]
    have ht4 : (d * (s q)⁻¹ * d⁻¹) ^ 4 = 1 := by
      calc
        _ = d * ((s q)⁻¹ ^ 4) * d⁻¹ := (map_pow (MulAut.conj d) (s q)⁻¹ 4).symm
        _ = 1 := by rw [inv_pow, hs4, inv_one]; group
    rw [hs4, ht4, one_mul]
  suffices hpow : ∀ x : D, x ∈ coreDisplacements g → x ^ 4 = 1 from
    Subtype.ext (hpow z z.property)
  intro x hx
  have hz : x ∈ closure {c | ∃ a ∈ corePreimage g, ∃ b ∈ (⊤ : Subgroup D), ⁅a,b⁆ = c} := hx
  clear hx
  induction hz using closure_induction with
  | mem x hx => obtain ⟨a, ha, b, _, rfl⟩ := hx; exact hgen a ha b
  | one => exact one_pow 4
  | mul x y hx hy hx4 hy4 =>
    rw [(hc x y (coreDisplacements_le g hx) (coreDisplacements_le g hy)).mul_pow, hx4, hy4, one_mul]
  | inv x hx hx4 => rw [inv_pow, hx4, inv_one]

end Theory.SpecificGroups.J2HSMultipliers.HS.TwoPrimary.NormalizerBound
