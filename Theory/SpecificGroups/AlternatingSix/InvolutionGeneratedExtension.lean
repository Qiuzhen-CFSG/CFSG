module

public import Theory.SpecificGroups.AlternatingSix.LocalNormalizers
public import Theory.GroupTheory.SolvableOuterQuotient
public import Theory.GroupTheory.GeneralizedFitting.InvolutionGenerated

/-!
# Involutory actions on an A₆ socle

An involutory automorphism of A₆ whose fixed subgroup is a two-group is
inner. This exports the actual marked-carrier criterion using the standard
fixed-subgroup and inner-automorphism APIs, for the involution-generated
extension argument in Aschbacher--Smith E.2.7, printed p.220.
If a finite group with this socle is generated by involutions and all
involution centralizers are two-groups, those generators are inner and
the entire group equals its socle. Possible outer extensions are removed
by the fixed-subgroup criterion, not by a containment assumption.
-/

public section
namespace AlternatingSix
variable {L : Type*} [Group L]

/-- The marked A₆ model supplies innerness with the standard automorphism
fixed-subgroup API. -/
theorem involution_inner_of_fixed_twoGroup
    (e : L ≃* alternatingGroup (Fin 6)) (α : MulAut L)
    (hα : orderOf α = 2) (hp : IsPGroup 2 α.fixedSubgroup) :
    α ∈ MulAut.innerSubgroup L := by
  have hf : α.fixedSubgroup = GLS3.Chapter5.automorphismFixedSubgroup α := by
    ext x
    rw [MulAut.mem_fixedSubgroup]
    rfl
  exact ShadowLocal.involution_inner_of_equiv_fixed_isTwoGroup e α hα (hf ▸ hp)

open Subgroup Theory.GroupTheory

/-- An involution-generated finite group with A₆ generalized Fitting
subgroup and two-group involution centralizers is itself A₆. -/
theorem equiv_of_involution_generated_socle
    {G : Type*} [Group G] [Finite G]
    (e : generalizedFitting G ≃* alternatingGroup (Fin 6))
    (hgen : closure {g : G | g ^ 2 = 1} = ⊤)
    (hC : ∀ t : G, orderOf t = 2 → IsPGroup 2 (centralizer ({t} : Set G))) :
    Nonempty (G ≃* alternatingGroup (Fin 6)) := by
  let : IsSimpleGroup (alternatingGroup (Fin 6)) :=
    alternatingGroup.isSimpleGroup (by simp)
  let : Group.IsPerfect (alternatingGroup (Fin 6)) :=
    ⟨commutator_alternatingGroup_eq_top (by simp)⟩
  let : IsSimpleGroup (generalizedFitting G) := e.isSimpleGroup
  let : Group.IsPerfect (generalizedFitting G) :=
    Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  have ht := generalizedFitting_eq_top_of_involution_inner hgen hC
    (involution_inner_of_fixed_twoGroup e)
  exact ⟨Subgroup.topEquiv.symm.trans ((MulEquiv.subgroupCongr ht.symm).trans e)⟩

end AlternatingSix
