module
public import Theory.SpecificGroups.AlternatingSix.AlternatingFourActions
public import Theory.SpecificGroups.AlternatingSix.ShadowLocal.Identification
public import Theory.SpecificGroups.AlternatingSix.OuterInvolutionExtension.ActionTransport
public import Theory.GroupTheory.NormalizingInvolutionCard
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.SpecificGroups.DihedralProduct.CentralFactorQuotient
public import Mathlib.GroupTheory.NoncommCoprod
public import Theory.GroupTheory.InvolutionCentralizerControl

/-!
# A₆ extensions with Sylow group E₄ × D₈

A normal A₆ supplemented by an E₄ × D₈ Sylow subgroup has order 1440.
An involution with nontrivial action fixing an A₄ acts in the natural S₆.
The conjugation image cannot be all of Aut(A₆), because its Sylow subgroup
contains an element of order eight whereas the supplied Sylow has exponent
four. Thus the action has image S₆ and central kernel of order two.

The subgroup generated by the original A₆ and the original involution maps
faithfully onto S₆. Multiplication by the central kernel constructs the direct
product, retaining both factor kernels and the literal conjugation map.

Source: Aschbacher–Smith, F.5.5, printed p.302, the Aut(A₆) consequence for
the quotient of the graph centralizer by its graph involution.
-/

public noncomputable section
open Subgroup
open AlternatingSix.ShadowLocal
namespace AlternatingSix.FourDihedralExtension
abbrev C2 := Multiplicative (ZMod 2)
abbrev E4 := C2 × C2
abbrev S6 := Equiv.Perm (Fin 6)
variable {H : Type*} [Group H] [Finite H]

private theorem sylow_model_fourth : ∀ x : E4 × DihedralGroup 4, x^4=1 := by
  decide +kernel

private theorem not_surjective_of_sylow_fourth (S : Sylow 2 H)
    (hS : ∀ x : S, x^4=1) (f : H →* AutA6) : ¬ Function.Surjective f := by
  intro hf
  let P := S.mapSurjective hf
  let x : P := Identification.sylowEquiv P Holomorph.rotation
  have hx : orderOf x=8 := (Identification.sylowEquiv P).orderOf_eq _ |>.trans Holomorph.rotation_order
  obtain ⟨y,hy,he⟩ := x.property
  have hpow : x^4=1 := by
    apply Subtype.ext
    change (x : AutA6)^4=1
    rw [←he,←map_pow]
    have hy4 : y^4=1 := congrArg Subtype.val (hS ⟨y,hy⟩)
    rw [hy4,map_one]
  have hd := orderOf_dvd_of_pow_eq_one hpow
  rw [hx] at hd
  norm_num at hd

private theorem inner_sup_involution_eq_natural (a : AutA6)
    (ha : a^2=1) (hn : a∈natural) (hout : a∉ShadowLocal.inner) :
    ShadowLocal.inner ⊔ zpowers a=natural := by
  apply eq_of_le_of_card_ge (sup_le inner_le_natural (zpowers_le.mpr hn))
  rw [card_sup_zpowers_of_normalizing_involution ShadowLocal.inner a ha hout
    (by rw [normalizer_eq_top]; exact mem_top _),card_inner,card_natural]

/-- An exponent-four Sylow prevents the conjugation image from being all of Aut(A6).
A natural outer involution then forces the image to be precisely the natural S6. -/
theorem action_range (K : Subgroup H) [K.Normal] (e : K≃*A6)
    (S : Sylow 2 H) (eS : S≃*E4×DihedralGroup 4) (a : H)
    (ha : a^2=1) (hn : conjugationAction K e a∈natural)
    (hout : conjugationAction K e a∉ShadowLocal.inner) :
    (conjugationAction K e).range=natural := by
  let f := conjugationAction K e
  have hfn : ShadowLocal.inner ⊔ zpowers (f a)=natural :=
    inner_sup_involution_eq_natural _ (by rw [←map_pow,ha,map_one]) hn hout
  have hle : natural≤f.range := by
    rw [←hfn]
    exact sup_le (by rw [←conjugationAction_map_inner K e]; exact map_le_range _ _)
      (zpowers_le.mpr ⟨a,rfl⟩)
  by_contra hne
  have hi := index_strictAnti (lt_of_le_of_ne hle (Ne.symm hne))
  rw [GLS3.Chapter5.naturalAlternatingAutomorphismSubgroup_index] at hi
  have hp : f.range.index≠0 := index_ne_zero_of_finite
  have ht : f.range=⊤ := index_eq_one.mp (by omega)
  exact not_surjective_of_sylow_fourth S (fun x => eS.injective (by
      rw [map_pow,map_one]; exact sylow_model_fourth _)) f (MonoidHom.range_eq_top.mp ht)

/-- The normal A6 and the prescribed Sylow have total order 1440. -/
theorem card_eq (K : Subgroup H) [K.Normal] (e : K≃*A6)
    (S : Sylow 2 H) (eS : S≃*E4×DihedralGroup 4)
    (hgen : K ⊔ (S:Subgroup H)=⊤) : Nat.card H=1440 := by
  have hK : Nat.card K=360 := (Nat.card_congr e.toEquiv).trans card_A6
  have hS : Nat.card S=32 := by
    rw [Nat.card_congr eS.toEquiv]
    rw [Nat.card_prod,DihedralGroup.nat_card]
    norm_num [E4,C2,Nat.card_prod]
  obtain ⟨P,hP⟩ := S.exists_subgroupOf_eq_of_normal K
  have hPcard : Nat.card P=8 := by
    rw [P.card_eq_multiplicity,hK]
    rw [show 360=2^3*45 by decide,
      Nat.factorization_mul (by decide) (by decide),Finsupp.add_apply,
      Nat.prime_two.factorization_pow,Finsupp.single_eq_same,
      Nat.factorization_eq_zero_of_not_dvd (by decide : ¬2∣45)]
    rfl
  have hI : Nat.card (K⊓(S:Subgroup H):Subgroup H)=8 := by
    rw [inf_comm,←Nat.card_congr (subgroupOfEquivOfLe (H:= (S:Subgroup H)⊓K) (K:=K) inf_le_right).toEquiv]
    simpa only [inf_subgroupOf_right,←hP] using hPcard
  have hc := card_mul_eq_card_inf_mul_card_sup_of_normalizes K (S:Subgroup H)
    (by rw [normalizer_eq_top]; exact le_top)
  rw [hK,hS,hI,hgen,card_top] at hc
  omega

/-- The original involution generates the S6 direct factor with K. Both the
K coordinates and the ambient conjugation homomorphism are preserved. -/
theorem exists_marked_product_of_natural
    (K : Subgroup H) [K.Normal] (e : K≃*A6)
    (S : Sylow 2 H) (eS : S≃*E4×DihedralGroup 4)
    (hgen : K ⊔ (S:Subgroup H)=⊤) (a : H) (ha : a^2=1)
    (hn : conjugationAction K e a∈natural)
    (hout : conjugationAction K e a∉ShadowLocal.inner) :
    Nat.card (centralizer (K:Set H))=2 ∧
    ∃ (q : (K⊔zpowers a:Subgroup H)≃*S6) (E : H≃*C2×S6),
      (∀ x:K, q ⟨x,mem_sup_left x.property⟩=(e x:S6)) ∧
      (∀ d:(K⊔zpowers a:Subgroup H), E d=(1,q d)) ∧
      (∀ x:H, permutationAction (E x).2=conjugationAction K e x) ∧
      (∀ x:H, (E x).1=1 ↔ x∈K⊔zpowers a) ∧
      (∀ x:H, (E x).2=1 ↔ x∈centralizer (K:Set H)) := by
  let f := conjugationAction K e
  let C := centralizer (K:Set H)
  let D := K⊔zpowers a
  have hG : Nat.card H=1440 := card_eq K e S eS hgen
  have hr : f.range=natural := action_range K e S eS a ha hn hout
  have hC : Nat.card C=2 := by
    have hh := f.ker.card_mul_index
    rw [index_ker,hr,card_natural,conjugationAction_ker,hG] at hh
    change Nat.card C * 720=1440 at hh
    omega
  have hCZ : C≤center H := by
    have hh := normalizer_le_centralizer_of_card_two C hC
    have : C.Normal := by dsimp only [C]; infer_instance
    rw [normalizer_eq_top] at hh
    intro c hc
    exact mem_center_iff.mpr (fun x => (hh (mem_top x) c hc).symm)
  have han : a∈normalizer (K:Set H) := by rw [normalizer_eq_top]; exact mem_top a
  have hao : orderOf a=2 := orderOf_eq_prime ha (by
    intro he
    apply hout
    rw [he,map_one]
    exact one_mem _)
  have hao' : a∉centralizer (K:Set H)⊔K := by
    intro he
    apply hout
    change a∈ShadowLocal.inner.comap f
    rw [conjugationAction_preimage_inner,sup_comm]
    exact he
  let q0 := OuterInvolutionExtension.extensionEquiv e han hao hao'
  have hnD : ShadowLocal.inner ⊔
      zpowers (OuterInvolutionExtension.normalizerAction e ⟨a,han⟩)=natural :=
    inner_sup_involution_eq_natural (f a) (by rw [←map_pow,ha,map_one]) hn hout
  let n := MonoidHom.ofInjective permutationAction_injective
  let q : D≃*S6 := q0.trans ((MulEquiv.subgroupCongr hnD).trans n.symm)
  have hq (d:D) : permutationAction (q d)=f d := by
    exact congrArg Subtype.val (n.apply_symm_apply (MulEquiv.subgroupCongr hnD (q0 d)))
  have hd : Disjoint C D := by
    apply disjoint_def.mpr
    intro x hxC hxD
    have hx : f x=1 := by
      change x∈centralizer (K:Set H) at hxC
      rw [←conjugationAction_ker K e] at hxC
      exact hxC
    have hqx : q ⟨x,hxD⟩=1 := permutationAction_injective ((hq ⟨x,hxD⟩).trans hx |>.trans permutationAction.map_one.symm)
    exact congrArg Subtype.val (q.injective (hqx.trans q.map_one.symm))
  have hcomm (c:C) (d:D) : Commute (c:H) (d:H) :=
    (mem_center_iff.mp (hCZ c.property) d).symm
  let m : C×D →* H := C.subtype.noncommCoprod D.subtype hcomm
  have hmi : Function.Injective m := mul_injective_of_disjoint hd
  have hD : Nat.card D=720 := by
    rw [Nat.card_congr q.toEquiv]
    norm_num [S6,Nat.card_eq_fintype_card,Fintype.card_perm,Nat.factorial]
  have hmc : Nat.card (C×D)=Nat.card H := by rw [Nat.card_prod,hC,hD,hG]
  let em : C×D≃*H := MulEquiv.ofBijective m
    ((Nat.bijective_iff_injective_and_card m).mpr ⟨hmi,hmc⟩)
  let eC : C≃*C2 := mulEquivOfPrimeCardEq hC (by simp [C2])
  let E : H≃*C2×S6 := em.symm.trans (eC.prodCongr q)
  have hE (c:C) (d:D) : E ((c:H)*(d:H))=(eC c,q d) := by
    change (eC.prodCongr q) (em.symm (em (c,d)))=_
    rw [em.symm_apply_apply]
    rfl
  have hEc (d:D) : E d=(1,q d) := by
    simpa only [coe_one,one_mul,map_one] using hE 1 d
  have hEa (x:H) : permutationAction (E x).2=f x := by
    obtain ⟨⟨c,d⟩,rfl⟩ := em.surjective x
    change permutationAction (E ((c:H)*(d:H))).2=f ((c:H)*(d:H))
    rw [hE,map_mul,show f c=1 from (by
      have hc : (c:H)∈centralizer (K:Set H) := c.property
      rwa [←conjugationAction_ker K e] at hc),one_mul]
    exact hq d
  refine ⟨hC,q,E,?_,hEc,hEa,?_,?_⟩
  · intro x
    apply permutationAction_injective
    rw [hq,conjugationAction_on_inner,permutationAction_coe]
  · intro x
    obtain ⟨⟨c,d⟩,rfl⟩ := em.surjective x
    change (E ((c:H)*(d:H))).1=1 ↔ (c:H)*(d:H)∈D
    rw [hE]
    constructor
    · intro hc
      have hc1 : c=1 := eC.injective (hc.trans eC.map_one.symm)
      simpa only [hc1,coe_one,one_mul] using d.property
    · intro hx
      have hc : (c:H)∈D := by
        have hh:=D.mul_mem hx (D.inv_mem d.property)
        simpa only [mul_inv_cancel_right] using hh
      have hc1 : c=1 := Subtype.ext (disjoint_def.mp hd c.property hc)
      rw [hc1,map_one]
  · intro x
    rw [←conjugationAction_ker K e]
    change (E x).2=1 ↔ f x=1
    rw [←hEa,←permutationAction.map_one]
    exact permutationAction_injective.eq_iff.symm

/-- The source-facing form: a fixed A₄ and nontrivial action turn the given
involution into the natural outer actor, so the preceding marked extension
applies directly. -/
theorem exists_marked_product_of_fixed_four
    (K : Subgroup H) [K.Normal] (e : K≃*A6)
    (S : Sylow 2 H) (eS : S≃*E4×DihedralGroup 4)
    (hgen : K ⊔ (S:Subgroup H)=⊤) (a : H) (ha : orderOf a=2)
    (L : Subgroup A6) (eL : L≃*alternatingGroup (Fin 4))
    (hf : ∀ l∈L, (conjugationAction K e a) l=l)
    (hne : conjugationAction K e a ≠1) :
    Nat.card (centralizer (K:Set H))=2 ∧
    ∃ (q : (K⊔zpowers a:Subgroup H)≃*S6) (E : H≃*C2×S6),
      (∀ x:K, q ⟨x,mem_sup_left x.property⟩=(e x:S6)) ∧
      (∀ d:(K⊔zpowers a:Subgroup H), E d=(1,q d)) ∧
      (∀ x:H, permutationAction (E x).2=conjugationAction K e x) ∧
      (∀ x:H, (E x).1=1 ↔ x∈K⊔zpowers a) ∧
      (∀ x:H, (E x).2=1 ↔ x∈centralizer (K:Set H)) := by
  have ha2 : a^2=1 := ha ▸ pow_orderOf_eq_one a
  have hfix0 : (conjugationAction K e a)^2=1 := by
    rw [←map_pow, ha2, map_one]
  have hfix : orderOf (conjugationAction K e a)=2 :=
    orderOf_eq_prime hfix0 hne
  have hnat := alternatingFour_fixed_involution_natural_outer
    L eL (conjugationAction K e a) hfix hf
  exact exists_marked_product_of_natural K e S eS hgen a
    (ha ▸ pow_orderOf_eq_one a) hnat.1 hnat.2

/-- The same actual complement, in coordinates sending its distinguished
involution to a transposition. Changing A6 coordinates does not change any
ambient subgroup or either direct-factor kernel. -/
theorem exists_transposition_product_of_fixed_four
    (K : Subgroup H) [K.Normal] (e : K≃*A6)
    (S : Sylow 2 H) (eS : S≃*E4×DihedralGroup 4)
    (hgen : K ⊔ (S:Subgroup H)=⊤) (a : H) (ha : orderOf a=2)
    (L : Subgroup A6) (eL : L≃*alternatingGroup (Fin 4))
    (hf : ∀ l∈L, (conjugationAction K e a) l=l)
    (hne : conjugationAction K e a ≠1) :
    Nat.card (centralizer (K:Set H))=2 ∧
    ∃ (e' : K≃*A6) (q : (K⊔zpowers a:Subgroup H)≃*S6) (E : H≃*C2×S6)
      (s : S6), s.IsSwap ∧ E a=(1,s) ∧
      (∀ x:K, q ⟨x,mem_sup_left x.property⟩=(e' x:S6)) ∧
      (∀ d:(K⊔zpowers a:Subgroup H), E d=(1,q d)) ∧
      (∀ x:H, permutationAction (E x).2=conjugationAction K e' x) ∧
      (∀ x:H, (E x).1=1 ↔ x∈K⊔zpowers a) ∧
      (∀ x:H, (E x).2=1 ↔ x∈centralizer (K:Set H)) := by
  have ha2 : a^2=1 := ha ▸ pow_orderOf_eq_one a
  have hβ : orderOf (conjugationAction K e a)=2 := orderOf_eq_prime
    (by rw [←map_pow,ha2,map_one]) hne
  obtain ⟨u,s,hs,hu⟩ := alternatingFour_fixed_involution_coordinates L eL _ hβ hf
  let e' := e.trans u
  have hact : conjugationAction K e' a=permutationAction s := by
    rw [←hu]
    ext x
    rfl
  have hout : conjugationAction K e' a∉ShadowLocal.inner := by
    rw [hact]
    rintro ⟨x,hx⟩
    have he : (x:S6)=s := permutationAction_injective ((permutationAction_coe x).trans hx)
    have hxalt := x.property
    rw [Equiv.Perm.mem_alternatingGroup,he,hs.sign_eq] at hxalt
    norm_num at hxalt
  obtain ⟨hc,q,E,hq,hE,hf,hfirst,hsecond⟩ := exists_marked_product_of_natural
    K e' S eS hgen a ha2 (by rw [hact]; exact ⟨s,rfl⟩) hout
  refine ⟨hc,e',q,E,s,hs,?_,hq,hE,hf,hfirst,hsecond⟩
  have hqactor : q ⟨a,mem_sup_right (mem_zpowers a)⟩=s := by
    apply permutationAction_injective
    have he := hf a
    rw [hE ⟨a,mem_sup_right (mem_zpowers a)⟩,hact] at he
    exact he
  rw [hE ⟨a,mem_sup_right (mem_zpowers a)⟩,hqactor]

end AlternatingSix.FourDihedralExtension
