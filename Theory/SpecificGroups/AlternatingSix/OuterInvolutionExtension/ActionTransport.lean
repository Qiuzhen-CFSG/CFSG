module

public import Theory.SpecificGroups.AlternatingSix.ShadowLocal.Basic
public import Theory.GroupAction.AutomorphismFixedTransport


/-!
# Faithful transport of an outer-involution extension of A₆

Transport normalizer conjugation through a specified equivalence L ≃ A₆.
If r normalizes L, has order two, and lies outside C_G(L)L, then L⟨r⟩
embeds into Aut(A₆) with image generated by Inn(A₆) and the action of r.
The normal form l or lr and the injectivity of A₆'s inner action prove
faithfulness; no ambient normality of L or product-model hypothesis is used.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
proof of 16.4.9(2), printed p.1192, the extension LR.
-/

@[expose] public section

open Subgroup
open AlternatingSix.ShadowLocal
open scoped Pointwise

namespace AlternatingSix.OuterInvolutionExtension

variable {G : Type*} [Group G] {L : Subgroup G} {r : G}

/-- The actual normalizer action in the supplied A₆ coordinates. -/
def normalizerAction (e : L ≃* A6) : normalizer (L : Set G) →* AutA6 :=
  (MulAut.congr e).toMonoidHom.comp L.normalizerMonoidHom

theorem normalizerAction_on_inner (e : L ≃* A6) (l : L) :
    normalizerAction e ⟨l, L.le_normalizer l.property⟩ = MulAut.conj (e l) := by
  have h : L.normalizerMonoidHom ⟨l, L.le_normalizer l.property⟩ = MulAut.conj l := by
    apply MulEquiv.ext
    intro x
    rfl
  change MulAut.congr e (L.normalizerMonoidHom _) = _
  rw [h, MulAut.congr_conj]

theorem normalizerAction_not_inner (e : L ≃* A6)
    (hrN : r ∈ normalizer (L : Set G))
    (hrout : r ∉ centralizer (L : Set G) ⊔ L) :
    normalizerAction e ⟨r, hrN⟩ ∉ ShadowLocal.inner := by
  rintro ⟨a, ha⟩
  let l := e.symm a
  let lN : normalizer (L : Set G) := ⟨l, L.le_normalizer l.property⟩
  have hl : L.normalizerMonoidHom ⟨r, hrN⟩ = MulAut.conj l := by
    apply (MulAut.congr e).injective
    rw [MulAut.congr_conj, e.apply_symm_apply]
    exact ha.symm
  have hlN : L.normalizerMonoidHom lN = MulAut.conj l := by
    apply MulEquiv.ext
    intro x
    rfl
  have hk : (⟨r, hrN⟩ : normalizer (L : Set G)) * lN⁻¹ ∈
      L.normalizerMonoidHom.ker := by
    change L.normalizerMonoidHom (_ * _) = 1
    rw [map_mul, map_inv, hlN, hl, mul_inv_cancel]
  rw [normalizerMonoidHom_ker] at hk
  have hmem := (centralizer (L : Set G) ⊔ L).mul_mem
    (mem_sup_left (show r * (l : G)⁻¹ ∈ centralizer (L : Set G) from hk))
    (mem_sup_right l.property)
  exact hrout (by simpa using hmem)

theorem normalizerAction_sq (e : L ≃* A6)
    (hrN : r ∈ normalizer (L : Set G)) (hr2 : r ^ 2 = 1) :
    normalizerAction e ⟨r, hrN⟩ ^ 2 = 1 := by
  rw [← map_pow, show (⟨r, hrN⟩ : normalizer (L : Set G)) ^ 2 = 1 from
    Subtype.ext hr2, map_one]

/-- Conjugation by the generated extension, with its actual ambient elements. -/
def extensionAction (e : L ≃* A6) (hrN : r ∈ normalizer (L : Set G)) :
    ↥(L ⊔ zpowers r) →* AutA6 :=
  (normalizerAction e).comp
    (inclusion (sup_le L.le_normalizer (zpowers_le.mpr hrN)))

theorem extensionAction_on_inner (e : L ≃* A6)
    (hrN : r ∈ normalizer (L : Set G)) (l : L) :
    extensionAction e hrN ⟨l, mem_sup_left l.property⟩ = MulAut.conj (e l) :=
  normalizerAction_on_inner e l

theorem extensionAction_on_generator (e : L ≃* A6)
    (hrN : r ∈ normalizer (L : Set G)) :
    extensionAction e hrN ⟨r, mem_sup_right (mem_zpowers r)⟩ =
      normalizerAction e ⟨r, hrN⟩ := rfl

private theorem extension_normal_form [Finite G]
    (hrN : r ∈ normalizer (L : Set G)) (hr2 : orderOf r = 2)
    (x : ↥(L ⊔ zpowers r)) :
    ∃ l : L, (x : G) = l ∨ (x : G) = (l : G) * r := by
  classical
  have hx : (x : G) ∈ (L : Set G) * (zpowers r : Set G) := by
    rw [← coe_mul_of_right_le_normalizer_left L (zpowers r) (zpowers_le.mpr hrN)]
    exact x.property
  obtain ⟨l, hl, t, ht, hlt⟩ := hx
  change t ∈ zpowers r at ht
  rw [mem_zpowers_iff_mem_range_orderOf, hr2] at ht
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ht
  have hi' : i < 2 := Finset.mem_range.mp hi
  refine ⟨⟨l, hl⟩, ?_⟩
  interval_cases i
  · exact Or.inl (by simpa using hlt.symm)
  · exact Or.inr (by simpa using hlt.symm)

/-- An outer involution gives a faithful extension action; there is no
unaccounted central kernel in `L⟨r⟩`. -/
theorem extensionAction_injective [Finite G] (e : L ≃* A6)
    (hrN : r ∈ normalizer (L : Set G)) (hr2 : orderOf r = 2)
    (hrout : r ∉ centralizer (L : Set G) ⊔ L) :
    Function.Injective (extensionAction e hrN) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply bot_unique
  intro x hx
  have hx1 : extensionAction e hrN x = 1 := hx
  obtain ⟨l, hl | hl⟩ := extension_normal_form hrN hr2 x
  · have hx' : x = ⟨l, mem_sup_left l.property⟩ := Subtype.ext hl
    rw [hx', extensionAction_on_inner] at hx1
    have he : e l = 1 := inner_injective (hx1.trans (map_one MulAut.conj).symm)
    have hl1 : l = 1 := e.injective (he.trans e.map_one.symm)
    exact mem_bot.mpr (by rw [hx', hl1]; rfl)
  · have hx' : x = (⟨l, mem_sup_left l.property⟩ : ↥(L ⊔ zpowers r)) *
        ⟨r, mem_sup_right (mem_zpowers r)⟩ := Subtype.ext hl
    rw [hx', map_mul, extensionAction_on_inner, extensionAction_on_generator] at hx1
    apply False.elim
    apply normalizerAction_not_inner e hrN hrout
    refine ⟨(e l)⁻¹, ?_⟩
    rw [map_inv]
    exact inv_eq_of_mul_eq_one_right hx1

/-- The image retains precisely the inner automorphisms and the given actor. -/
theorem extensionAction_range [Finite G] (e : L ≃* A6)
    (hrN : r ∈ normalizer (L : Set G)) (hr2 : orderOf r = 2) :
    (extensionAction e hrN).range =
      ShadowLocal.inner ⊔ zpowers (normalizerAction e ⟨r, hrN⟩) := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    obtain ⟨l, hl | hl⟩ := extension_normal_form hrN hr2 x
    · have hx' : x = ⟨l, mem_sup_left l.property⟩ := Subtype.ext hl
      rw [hx', extensionAction_on_inner]
      exact mem_sup_left ⟨e l, rfl⟩
    · have hx' : x = (⟨l, mem_sup_left l.property⟩ : ↥(L ⊔ zpowers r)) *
          ⟨r, mem_sup_right (mem_zpowers r)⟩ := Subtype.ext hl
      rw [hx', map_mul, extensionAction_on_inner, extensionAction_on_generator]
      exact mul_mem (mem_sup_left ⟨e l, rfl⟩) (mem_sup_right (mem_zpowers _))
  · apply sup_le
    · rintro _ ⟨a, rfl⟩
      refine ⟨⟨e.symm a, mem_sup_left (e.symm a).property⟩, ?_⟩
      rw [extensionAction_on_inner, e.apply_symm_apply]
    · exact zpowers_le.mpr ⟨⟨r, mem_sup_right (mem_zpowers r)⟩, rfl⟩

/-- The generated ambient extension is the actual subgroup of Aut(A₆)
obtained from its conjugation action. -/
noncomputable def extensionEquiv [Finite G] (e : L ≃* A6)
    (hrN : r ∈ normalizer (L : Set G)) (hr2 : orderOf r = 2)
    (hrout : r ∉ centralizer (L : Set G) ⊔ L) :
    ↥(L ⊔ zpowers r) ≃*
      ↥(ShadowLocal.inner ⊔ zpowers (normalizerAction e ⟨r, hrN⟩)) :=
  (MonoidHom.ofInjective (extensionAction_injective e hrN hr2 hrout)).trans
    (MulEquiv.subgroupCongr (extensionAction_range e hrN hr2))

end AlternatingSix.OuterInvolutionExtension
