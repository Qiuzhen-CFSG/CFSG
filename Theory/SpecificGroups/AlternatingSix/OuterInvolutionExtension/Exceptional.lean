module

public import Theory.SpecificGroups.AlternatingSix.ShadowLocal.Basic
public import Theory.Alternating.proposition_5_2_7_8
public import Theory.GroupAction.AutomorphismFixedTransport


/-!
# The canonical exceptional involution extension of A₆

Changing coordinates transports the subgroup generated by Inn(A₆) and an
actor. The existing exceptional-involution conjugacy calculation therefore
identifies every extension coming from outside the natural S₆ with one
concrete subgroup of Aut(A₆). Its identification with the matrix group
PGL₂(9) is a separate obligation, not part of the definition.

Sources: GLS, Volume 3, Proposition 5.2.7(a), for exceptional conjugacy;
Aschbacher–Smith, combined manuscript of 1 March 2004, proof of 16.4.9(2),
printed p.1192, for the extension alternative.
-/

@[expose] public section

open Subgroup GLS3.Chapter5
open AlternatingSix.ShadowLocal

namespace AlternatingSix.OuterInvolutionExtension

/-- The concrete automorphism subgroup generated by A₆ and its canonical
exceptional involution. Identification with PGL₂(9) is a separate model theorem. -/
noncomputable def canonicalExtension : Subgroup AutA6 :=
  ShadowLocal.inner ⊔ zpowers canonicalExceptionalAut

private theorem map_inner (a : MulAut A6) :
    ShadowLocal.inner.map (MulAut.congr a).toMonoidHom = ShadowLocal.inner := by
  ext β
  constructor
  · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
    exact ⟨a x, (MulAut.congr_conj a x).symm⟩
  · rintro ⟨x, rfl⟩
    refine ⟨MulAut.conj (a.symm x), ⟨a.symm x, rfl⟩, ?_⟩
    simp only [MulEquiv.coe_toMonoidHom, MulAut.congr_conj, a.apply_symm_apply]

/-- Changing coordinates preserves the whole extension subgroup. -/
noncomputable def autExtensionCongr (a : MulAut A6) (β : AutA6) :
    ↥(ShadowLocal.inner ⊔ zpowers β) ≃*
      ↥(ShadowLocal.inner ⊔ zpowers (MulAut.congr a β)) :=
  ((ShadowLocal.inner ⊔ zpowers β).equivMapOfInjective
    (MulAut.congr a).toMonoidHom (MulAut.congr a).injective).trans
    (MulEquiv.subgroupCongr (by rw [Subgroup.map_sup, map_inner, MonoidHom.map_zpowers]; rfl))

/-- Every involution outside the natural S₆ gives the same concrete extension,
by the proved exceptional automorphism conjugacy calculation. -/
theorem exceptional_extension_equiv_canonical (β : AutA6)
    (hβ : β ^ 2 = 1) (hn : β ∉ natural) :
    Nonempty (↥(ShadowLocal.inner ⊔ zpowers β) ≃* canonicalExtension) := by
  obtain ⟨σ, hσ⟩ := exceptionalAut_eq_twist β hn
  obtain ⟨τ, hτ⟩ := exceptionalTwistAut_conjugate_canonical σ (hσ ▸ hβ)
  have hb : β = MulAut.congr (MulAut.conjNormal τ) canonicalExceptionalAut := by
    rw [hσ, hτ]
    apply MulEquiv.ext
    intro x
    rfl
  rw [hb]
  exact ⟨(autExtensionCongr (MulAut.conjNormal τ) canonicalExceptionalAut).symm⟩

end AlternatingSix.OuterInvolutionExtension
