module

public import Theory.SpecificGroups.AlternatingSix.ShadowLocal.Holomorph
public import Mathlib.GroupTheory.SpecificGroups.Dihedral
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.SpecificGroups.KleinFour

/-!
# Coordinates for the local holomorph calculation

Explicit injective homomorphisms identify the marked dihedral and cyclic
subgroups of C₈ ⋊ (Z/8)ˣ. Their finite ranges provide membership tests for
subsequent centralizer and quotient calculations. Every finite table is
checked by the Lean kernel.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
printed pp.568–570. These are intrinsic calculations in the concrete model;
the identification with a Sylow subgroup of Aut(A₆) is separate.
-/

@[expose] public section
namespace AlternatingSix.ShadowLocal.Holomorph
open Subgroup

set_option maxRecDepth 10000
set_option maxHeartbeats 2000000

abbrev C2 := Multiplicative (ZMod 2)
abbrev C4 := Multiplicative (ZMod 4)
abbrev E4 := C2 × C2

/-- The central subgroup generated by the fourth power of the rotation. -/
def centralTwo : Subgroup Model := zpowers (rotation ^ 4)

/-- The embedding sends the dihedral rotation to `r²` and reflection to `c`. -/
def innerEmbedding : DihedralGroup 4 →* Model where
  toFun
    | .r i => (rotation ^ 2) ^ i.val
    | .sr i => reflection * (rotation ^ 2) ^ i.val
  map_one' := rfl
  map_mul' := by decide +kernel

theorem innerEmbedding_injective : Function.Injective innerEmbedding := by decide +kernel

theorem innerEmbedding_range : innerEmbedding.range = innerD := by
  apply le_antisymm
  · rintro x ⟨d, rfl⟩
    cases d with
    | r i => exact Subgroup.pow_mem _ (subset_closure (by simp)) _
    | sr i =>
      exact Subgroup.mul_mem _ (subset_closure (by simp))
        (Subgroup.pow_mem _ (subset_closure (by simp)) _)
  · apply (closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨.r 1, by decide +kernel⟩
    · exact ⟨.sr 0, by decide +kernel⟩

noncomputable def innerEquiv : innerD ≃* DihedralGroup 4 :=
  (MulEquiv.subgroupCongr innerEmbedding_range.symm).trans
    (MonoidHom.ofInjective innerEmbedding_injective).symm

theorem mem_innerD (x : Model) : x ∈ innerD ↔ ∃ d, innerEmbedding d = x := by
  rw [← innerEmbedding_range, MonoidHom.mem_range]

instance innerD_normal : innerD.Normal := by
  constructor
  simp only [mem_innerD]
  decide +kernel

/-- The cyclic-four factor, with generator `r²`. -/
def fourEmbedding : C4 →* Model where
  toFun i := (rotation ^ 2) ^ i.toAdd.val
  map_one' := rfl
  map_mul' := by decide +kernel

theorem fourEmbedding_injective : Function.Injective fourEmbedding := by decide +kernel

theorem fourEmbedding_range : fourEmbedding.range = cyclicFour := by
  apply le_antisymm
  · rintro x ⟨i, rfl⟩
    exact Subgroup.pow_mem _ (mem_zpowers _) _
  · exact zpowers_le.mpr ⟨.ofAdd 1, by decide +kernel⟩

noncomputable def fourEquiv : cyclicFour ≃* C4 :=
  (MulEquiv.subgroupCongr fourEmbedding_range.symm).trans
    (MonoidHom.ofInjective fourEmbedding_injective).symm

theorem mem_cyclicFour (x : Model) : x ∈ cyclicFour ↔ ∃ i, fourEmbedding i = x := by
  rw [← fourEmbedding_range, MonoidHom.mem_range]

instance cyclicFour_normal : cyclicFour.Normal := by
  constructor
  simp only [mem_cyclicFour]
  decide +kernel

/-- The transposition factor. -/
def transpositionEmbedding : C2 →* Model where
  toFun i := transposition ^ i.toAdd.val
  map_one' := rfl
  map_mul' := by decide +kernel

theorem transpositionEmbedding_injective : Function.Injective transpositionEmbedding := by
  decide +kernel

theorem transpositionEmbedding_range : transpositionEmbedding.range = transpositionSubgroup := by
  apply le_antisymm
  · rintro x ⟨i, rfl⟩
    exact Subgroup.pow_mem _ (mem_zpowers _) _
  · exact zpowers_le.mpr ⟨.ofAdd 1, by decide +kernel⟩

theorem mem_transpositionSubgroup (x : Model) :
    x ∈ transpositionSubgroup ↔ ∃ i, transpositionEmbedding i = x := by
  rw [← transpositionEmbedding_range, MonoidHom.mem_range]

/-- The central involution factor. -/
def centralEmbedding : C2 →* Model where
  toFun i := (rotation ^ 4) ^ i.toAdd.val
  map_one' := rfl
  map_mul' := by decide +kernel

theorem centralEmbedding_injective : Function.Injective centralEmbedding := by decide +kernel

theorem centralEmbedding_range : centralEmbedding.range = centralTwo := by
  apply le_antisymm
  · rintro x ⟨i, rfl⟩
    exact Subgroup.pow_mem _ (mem_zpowers _) _
  · exact zpowers_le.mpr ⟨.ofAdd 1, by decide +kernel⟩

theorem mem_centralTwo (x : Model) : x ∈ centralTwo ↔ ∃ i, centralEmbedding i = x := by
  rw [← centralEmbedding_range, MonoidHom.mem_range]

theorem centralTwo_eq_pair (x : Model) : x ∈ centralTwo ↔ x = 1 ∨ x = rotation ^ 4 := by
  rw [mem_centralTwo]
  revert x
  decide +kernel

/-- The direct product generated by the central involution and transposition. -/
def centralTranspositionEmbedding : E4 →* Model where
  toFun i := centralEmbedding i.1 * transpositionEmbedding i.2
  map_one' := rfl
  map_mul' := by decide +kernel

theorem centralTranspositionEmbedding_injective :
    Function.Injective centralTranspositionEmbedding := by decide +kernel

theorem centralTranspositionEmbedding_range :
    centralTranspositionEmbedding.range = centralTwo ⊔ transpositionSubgroup := by
  apply le_antisymm
  · rintro x ⟨i, rfl⟩
    exact Subgroup.mul_mem_sup
      ((mem_centralTwo _).mpr ⟨i.1, rfl⟩)
      ((mem_transpositionSubgroup _).mpr ⟨i.2, rfl⟩)
  · apply sup_le
    · exact zpowers_le.mpr ⟨(.ofAdd 1, 1), by decide +kernel⟩
    · exact zpowers_le.mpr ⟨(1, .ofAdd 1), by decide +kernel⟩

theorem mem_centralTwo_sup_transposition (x : Model) :
    x ∈ centralTwo ⊔ transpositionSubgroup ↔ ∃ i, centralTranspositionEmbedding i = x := by
  rw [← centralTranspositionEmbedding_range, MonoidHom.mem_range]

/-- The abelian subgroup generated by `r²` and `b`. -/
def fourTranspositionEmbedding : C4 × C2 →* Model where
  toFun i := fourEmbedding i.1 * transpositionEmbedding i.2
  map_one' := rfl
  map_mul' := by decide +kernel

theorem fourTranspositionEmbedding_injective :
    Function.Injective fourTranspositionEmbedding := by decide +kernel

theorem fourTranspositionEmbedding_range :
    fourTranspositionEmbedding.range = cyclicFour ⊔ transpositionSubgroup := by
  apply le_antisymm
  · rintro x ⟨i, rfl⟩
    exact Subgroup.mul_mem_sup
      ((mem_cyclicFour _).mpr ⟨i.1, rfl⟩)
      ((mem_transpositionSubgroup _).mpr ⟨i.2, rfl⟩)
  · apply sup_le
    · exact zpowers_le.mpr ⟨(.ofAdd 1, 1), by decide +kernel⟩
    · exact zpowers_le.mpr ⟨(1, .ofAdd 1), by decide +kernel⟩

theorem mem_cyclicFour_sup_transposition (x : Model) :
    x ∈ cyclicFour ⊔ transpositionSubgroup ↔ ∃ i, fourTranspositionEmbedding i = x := by
  rw [← fourTranspositionEmbedding_range, MonoidHom.mem_range]

/-- The product of the transposition factor and the inner dihedral group. -/
def naturalEmbedding : C2 × DihedralGroup 4 →* Model where
  toFun i := transpositionEmbedding i.1 * innerEmbedding i.2
  map_one' := rfl
  map_mul' := by decide +kernel

theorem naturalEmbedding_injective : Function.Injective naturalEmbedding := by decide +kernel

theorem naturalEmbedding_range : naturalEmbedding.range = natural := by
  apply le_antisymm
  · rintro x ⟨i, rfl⟩
    apply Subgroup.mul_mem
    · exact Subgroup.pow_mem _ (subset_closure (by simp)) _
    · have hd : innerD ≤ natural := closure_mono (by intro x; simp; tauto)
      exact hd ((mem_innerD _).mpr ⟨i.2, rfl⟩)
  · apply (closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact ⟨(1, .r 1), by decide +kernel⟩
    · exact ⟨(.ofAdd 1, 1), by decide +kernel⟩
    · exact ⟨(1, .sr 0), by decide +kernel⟩

noncomputable def naturalEquiv : natural ≃* (C2 × DihedralGroup 4) :=
  (MulEquiv.subgroupCongr naturalEmbedding_range.symm).trans
    (MonoidHom.ofInjective naturalEmbedding_injective).symm

theorem mem_natural (x : Model) : x ∈ natural ↔ ∃ i, naturalEmbedding i = x := by
  rw [← naturalEmbedding_range, MonoidHom.mem_range]

end AlternatingSix.ShadowLocal.Holomorph
