module

public import Theory.SpecificGroups.AlternatingSix.ShadowLocal.Identification.Generators
public import Mathlib.GroupTheory.GroupAction.MultipleTransitivity
public import Mathlib.GroupTheory.DoubleCoset
public import Mathlib.GroupTheory.SpecificGroups.Quaternion

/-!
# A concrete subgroup of Aut(A₆) and its marked nine-group geometry

The subgroup `extension` is generated by Inn(A₆) and the product of the
marked eighth-root automorphism and the natural transposition. In the
holomorph coordinates these generators select the semidihedral extension,
the M₁₀ in Aschbacher's argument. The definition alone asserts none of its
order or action properties.

`Marking` retains a nine-group in the actual S₆, two actual transpositions,
and their action on that group. `ActionFacts` and `LocalFacts` separate the
degree-ten action calculation from the semidihedral complement calculation.
They are explicit proof obligations, not existence assertions. In particular
the local contract requires an actual quaternion isomorphism and an involution
outside the literal nine-group normalizer.

Source: M. Aschbacher, “A 2-local characterization of M12”, Illinois J.
Math. 47 (2003), after 4.8, the beginning of 4.9 and the choice of r in 4.10,
pp.41–42. The marked automorphisms come from `ShadowLocal.Identification`.
-/

@[expose] public section

namespace AlternatingSix.M10

open Subgroup DoubleCoset ShadowLocal

/-- The specific extension, as a subgroup of the genuine automorphism group. -/
noncomputable def extension : Subgroup AutA6 :=
  inner ⊔ zpowers (Identification.rotation * Identification.transposition)

/-- The image of a nine-group in the natural symmetric subgroup. -/
def nine (D : Subgroup (Equiv.Perm (Fin 6))) : Subgroup AutA6 :=
  D.map permutationAction

/-- The literal normalizer inside the specified extension. -/
noncomputable def stabilizer (D : Subgroup (Equiv.Perm (Fin 6))) : Subgroup AutA6 :=
  extension ⊓ normalizer (nine D : Set AutA6)

/-- The source markings before any choice of complement. -/
structure Marking where
  D : Subgroup (Equiv.Perm (Fin 6))
  card_D : Nat.card D = 9
  z : Equiv.Perm (Fin 6)
  u : Equiv.Perm (Fin 6)
  z_swap : z.IsSwap
  u_swap : u.IsSwap
  commute : Commute u z
  z_normalizes : z ∈ normalizer (D : Set (Equiv.Perm (Fin 6)))
  b_inverts : ∀ x ∈ D, (u * z) * x * (u * z)⁻¹ = x⁻¹

/-- The global extension and its degree-ten action. This contract does not
include any semidihedral complement, so its producer is independent of the
local calculation. -/
structure ActionFacts (D : Subgroup (Equiv.Perm (Fin 6))) : Prop where
  normal : extension.Normal
  card : Nat.card extension = 720
  nine_le : nine D ≤ extension
  swap_not_mem : ∀ t : Equiv.Perm (Fin 6), t.IsSwap → permutationAction t ∉ extension
  card_stabilizer : Nat.card (stabilizer D) = 72
  transitive : MulAction.IsMultiplyPretransitive extension
    (extension ⧸ (stabilizer D).subgroupOf extension) 3
  cover : ∀ r ∈ extension, r ∉ stabilizer D → ∀ l ∈ extension,
    l ∈ stabilizer D ∨ l ∈ doubleCoset r (stabilizer D) (stabilizer D)

/-- The complement and involution for the fixed concrete extension.
Its producer can proceed without the degree-ten action theorem. -/
structure LocalFacts (m : Marking) where
  P : Subgroup AutA6
  card_P : Nat.card P = 16
  semidihedral : ∃ p q : P, orderOf p = 8 ∧ orderOf q = 2 ∧
    q * p * q⁻¹ = p ^ 3 ∧ zpowers p ⊔ zpowers q = ⊤
  normalizer_eq : normalizer (nine m.D : Set AutA6) = nine m.D ⊔ P
  disjoint : Disjoint (nine m.D) P
  z_mem : permutationAction m.z ∈ P
  center_P : (center P).map P.subtype = zpowers (permutationAction (m.u * m.z))
  quaternion : Nonempty (↥(P ⊓ extension) ≃* QuaternionGroup 2)
  b_mem : permutationAction (m.u * m.z) ∈ stabilizer m.D
  r : AutA6
  r_mem : r ∈ extension
  r_sq : r * r = 1
  r_not_mem_P : r ∉ P
  r_not_mem_stabilizer : r ∉ stabilizer m.D
  r_normalizes_P : r ∈ normalizer (P : Set AutA6)

end AlternatingSix.M10
