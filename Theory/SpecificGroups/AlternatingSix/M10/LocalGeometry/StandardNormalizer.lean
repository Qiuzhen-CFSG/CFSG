module
public import Theory.SpecificGroups.AlternatingSix.M10.LocalGeometry.Canonical

/-!
# The full normalizer of the standard nine-group

Every permutation normalizing the group generated by (024) and (135) is a
word in that nine-group, the marked dihedral rotation, and (02). To prove
coverage, conjugation determines a permutation on each three-point orbit
from its starting point and one of two orientations. The finite certificate
checks these 144 choices, without enumerating the automorphism group.

The natural S₆ has index two in Aut(A₆). Multiplication by the exceptional
rotation moves the other coset into S₆ and preserves the nine-group
normalizer. Since that rotation belongs to the published semidihedral
complement, the same product bound holds in the full automorphism group.

Source: M. Aschbacher, A 2-local characterization of M12 (2003), beginning
of the proof of Lemma 4.9, p.41. This is the calculation inside Aut(A₆),
not the subsequent normalizer calculation in the larger ambient group.
-/

@[expose] public section
namespace AlternatingSix.M10.LocalGeometry
open Subgroup ShadowLocal

/-- The two possible orientations of either three-point orbit. -/
private def step (d : Fin 2) : Equiv.Perm (Fin 6) := (cycle₀ * cycle₁) ^ (d.val + 1)

private theorem orbit_step : ∀ (i : NineCoordinates) (a : Fin 6),
    nineEmbedding i a ≠ a → ∃ d : Fin 2,
      nineEmbedding i a = step d a ∧
      nineEmbedding i (nineEmbedding i a) = step d (step d a) := by
  decide +kernel

private def candidate (a b : Fin 6) (r s : Fin 2) : Fin 6 → Fin 6 :=
  ![a, b, step r a, step s b, step r (step r a), step s (step s b)]

/-- Every injective orbit assignment is a word in the literal generators. -/
private theorem coverage : ∀ (a b : Fin 6) (r s : Fin 2),
    Function.Injective (candidate a b r s) →
    ∃ (n : NineCoordinates) (u : Fin 4) (v : Fin 2),
      ∀ x, candidate a b r s x =
        (nineEmbedding n * dihedralRotation.1 ^ u.val * standardZ ^ v.val) x := by
  decide +kernel

private theorem permutation_coverage (σ : Equiv.Perm (Fin 6))
    (hi : ∃ i : NineCoordinates, nineEmbedding i = σ * cycle₀ * σ⁻¹)
    (hj : ∃ j : NineCoordinates, nineEmbedding j = σ * cycle₁ * σ⁻¹) :
    ∃ (n : NineCoordinates) (u : Fin 4) (v : Fin 2),
      σ = nineEmbedding n * dihedralRotation.1 ^ u.val * standardZ ^ v.val := by
  obtain ⟨i, hi⟩ := hi
  obtain ⟨j, hj⟩ := hj
  have h₀ := mul_inv_eq_iff_eq_mul.mp hi.symm
  have h₁ := mul_inv_eq_iff_eq_mul.mp hj.symm
  have h02 : σ 2 = nineEmbedding i (σ 0) := by
    simpa only [Equiv.Perm.mul_apply, show cycle₀ 0 = (2 : Fin 6) by decide +kernel]
      using congrArg (fun p : Equiv.Perm (Fin 6) => p 0) h₀
  have h24 : σ 4 = nineEmbedding i (σ 2) := by
    simpa only [Equiv.Perm.mul_apply, show cycle₀ 2 = (4 : Fin 6) by decide +kernel]
      using congrArg (fun p : Equiv.Perm (Fin 6) => p 2) h₀
  have h13 : σ 3 = nineEmbedding j (σ 1) := by
    simpa only [Equiv.Perm.mul_apply, show cycle₁ 1 = (3 : Fin 6) by decide +kernel]
      using congrArg (fun p : Equiv.Perm (Fin 6) => p 1) h₁
  have h35 : σ 5 = nineEmbedding j (σ 3) := by
    simpa only [Equiv.Perm.mul_apply, show cycle₁ 3 = (5 : Fin 6) by decide +kernel]
      using congrArg (fun p : Equiv.Perm (Fin 6) => p 3) h₁
  have hi_move : nineEmbedding i (σ 0) ≠ σ 0 := by
    rw [← h02]
    exact σ.injective.ne (by decide)
  have hj_move : nineEmbedding j (σ 1) ≠ σ 1 := by
    rw [← h13]
    exact σ.injective.ne (by decide)
  obtain ⟨r, hr2, hr4⟩ := orbit_step i (σ 0) hi_move
  obtain ⟨s, hs3, hs5⟩ := orbit_step j (σ 1) hj_move
  have h04 := h24.trans (congrArg (nineEmbedding i) h02)
  have h15 := h35.trans (congrArg (nineEmbedding j) h13)
  have he : candidate (σ 0) (σ 1) r s = (σ : Fin 6 → Fin 6) := by
    funext x
    fin_cases x
    · rfl
    · rfl
    · exact hr2.symm.trans h02.symm
    · exact hs3.symm.trans h13.symm
    · exact hr4.symm.trans h04.symm
    · exact hs5.symm.trans h15.symm
  have hinj : Function.Injective (candidate (σ 0) (σ 1) r s) := by
    rw [he]
    exact σ.injective
  obtain ⟨n, u, v, h⟩ := coverage (σ 0) (σ 1) r s hinj
  exact ⟨n, u, v, Equiv.ext fun x => (congrFun he x).symm.trans (h x)⟩

/-- Explicit coverage of the normalizer in the natural six-letter group. -/
theorem standardNine_normalizer_normal_form (σ : Equiv.Perm (Fin 6))
    (hσ : σ ∈ normalizer (standardNine : Set (Equiv.Perm (Fin 6)))) :
    ∃ (i : NineCoordinates) (j : Fin 4) (k : Fin 2),
      σ = nineEmbedding i * dihedralRotation.1 ^ j.val * standardZ ^ k.val := by
  have h₀ : cycle₀ ∈ standardNine := ⟨(.ofAdd 1, 1), by decide +kernel⟩
  have h₁ : cycle₁ ∈ standardNine := ⟨(1, .ofAdd 1), by decide +kernel⟩
  exact permutation_coverage σ ((mem_normalizer_iff.mp hσ cycle₀).mp h₀)
    ((mem_normalizer_iff.mp hσ cycle₁).mp h₁)

private theorem rotation_mem_complement : Identification.rotation ∈ standardComplement := by
  rw [← Identification.embedding_rotation]
  exact mem_map_of_mem _ Coordinates.rotation_mem

private theorem natural_normalizer_le (a : AutA6)
    (ha : a ∈ normalizer (nine standardNine : Set AutA6)) (hn : a ∈ natural) :
    a ∈ nine standardNine ⊔ standardComplement := by
  obtain ⟨σ, rfl⟩ := hn
  have hcomap : (normalizer (nine standardNine : Set AutA6)).comap permutationAction =
      normalizer (standardNine : Set (Equiv.Perm (Fin 6))) := by
    rw [nine, comap_normalizer_eq_of_le_range (standardNine.map_le_range permutationAction),
      comap_map_eq_self_of_injective permutationAction_injective]
  have hσ : σ ∈ normalizer (standardNine : Set (Equiv.Perm (Fin 6))) := by
    rw [← hcomap]
    exact ha
  change permutationAction σ ∈ nine standardNine ⊔ standardComplement
  obtain ⟨i, j, k, rfl⟩ := standardNine_normalizer_normal_form σ hσ
  rw [map_mul, map_mul, map_pow, map_pow, ← Identification.rotation_sq]
  apply Subgroup.mul_mem
  · exact mul_mem_sup (mem_map_of_mem _ ⟨i, rfl⟩)
      (standardComplement.pow_mem (standardComplement.pow_mem rotation_mem_complement 2) j.val)
  · exact mem_sup_right (standardComplement.pow_mem standardZ_mem_complement k.val)

/-- The full automorphism normalizer lies in the product with the marked
semidihedral complement. -/
theorem standardNormalizer_upper :
    normalizer (nine standardNine : Set AutA6) ≤ nine standardNine ⊔ standardComplement := by
  intro a ha
  by_cases hn : a ∈ natural
  · exact natural_normalizer_le a ha hn
  · have har : a * Identification.rotation ∈ natural := by
      rw [Subgroup.mul_mem_iff_of_index_two
        GLS3.Chapter5.naturalAlternatingAutomorphismSubgroup_index]
      exact iff_of_false hn Identification.rotation_not_mem_natural
    have han : a * Identification.rotation ∈ normalizer (nine standardNine : Set AutA6) :=
      Subgroup.mul_mem _ ha rotation_normalizes_nine
    have hm := (nine standardNine ⊔ standardComplement).mul_mem
      (natural_normalizer_le _ han har)
      (mem_sup_right (standardComplement.inv_mem rotation_mem_complement))
    simpa only [mul_inv_cancel_right] using hm

/-- The literal standard nine-group normalizer in Aut(A₆). -/
theorem standardNormalizer_eq :
    normalizer (nine standardNine : Set AutA6) = nine standardNine ⊔ standardComplement :=
  le_antisymm standardNormalizer_upper standardNormalizer_lower

end AlternatingSix.M10.LocalGeometry
