module

public import Theory.GroupAction.ComponentRankAction.OuterTwo
public import Theory.SpecificGroups.AlternatingSix.CentralOuterLocal
public import Theory.SpecificGroups.AlternatingSix.OuterSolvable
public import Theory.SpecificGroups.Alternating.QuasithinBounds
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.PResidual.PrimeToMonotone
public import Theory.SpecificGroups.SymmetricTwoResidual
public import Theory.GroupTheory.DisjointCommutingProduct
public import Theory.GroupTheory.NonsolvableTwoLocal
public import Theory.Quasithin.EmbeddedNormalTwoLocalRank

/-!
# The residual and maximality step in the paired A₈ contradiction

An A₆ component of full cubic rank in an involution centralizer is its
prime-to-three residual. Thus every commuting A₄ lies in that component.
Two A₄ subgroups whose join contains an S₄ generated by the first A₄ and
an element of the second generate A₆: otherwise the second A₄ would lie
in the unique A₄ of that S₄. The resulting commuting A₄ and A₆ give a
genuine two-local subgroup of cubic rank three.

Source: Aschbacher–Smith, proof of 2.4.36, printed p.549, using A.3.18.
The actual complementary A₄ and its S₄ marking remain source geometry
inputs. No marking of an arbitrary A₄ inside A₆ is asserted here.
-/

public section
open Subgroup Theory.GroupTheory
namespace AlternatingSix.PairedCubicResidual
local notation "A4" => alternatingGroup (Fin 4)
local notation "A6" => alternatingGroup (Fin 6)
local notation "S4" => Equiv.Perm (Fin 4)

theorem alternatingFour_primeToResidual : primeToResidual 3 A4 = ⊤ := by
  apply top_unique
  rw [← alternatingGroup.closure_isThreeCycles_eq_top, closure_le]
  intro x hx
  apply mem_primeToResidual_of_pow (n := 1)
  apply Subtype.ext
  change x.val ^ 3 = 1
  rw [← hx.orderOf]
  exact pow_orderOf_eq_one x.val

theorem primeToResidual_eq_top_of_alternatingFour {J : Type*} [Group J]
    (e : J ≃* A4) : primeToResidual 3 J = ⊤ := by
  apply map_injective (f := e.toMonoidHom) e.injective
  rw [map_primeToResidual, alternatingFour_primeToResidual,
    map_top_of_surjective _ e.surjective]

private theorem alternatingFour_twoPerfect {J : Type*} [Group J]
    (e : J ≃* A4) : IsPPerfect 2 J := by
  have hp : IsPPerfect 2 A4 := by
    rw [← Equiv.Perm.twoResidual_eq_alternating]
    exact isPPerfect_pResidual 2
  exact hp.of_surjective e.symm.toMonoidHom e.symm.surjective

/-- The genuine A.3.18 residual equality at the original full-rank local group. -/
theorem component_cubic_residual {J : Type*} [Group J] [Finite J]
    (K : Subgroup J) (hK : IsComponent J K) (eK : K ≃* A6)
    (hr : primeRank 3 J ≤ 2) : K = primeToResidual 3 J := by
  have hc : center K = ⊥ := by
    apply eq_bot_iff.mpr
    intro k hk
    have he := (centerCongr eK ⟨k, hk⟩).property
    change eK k ∈ center A6 at he
    rw [alternatingGroup.center_eq_bot (by simp), mem_bot] at he
    exact eK.injective (he.trans eK.map_one.symm)
  have htwo : 2 ≤ primeRank 3 K := by
    rw [primeRank_equiv 3 eK,
      GLS3.Chapter5.PRank.alternating_primeRank_of_odd_prime 6 3 (by decide) (by decide)]
  let e : (K ⧸ center K) ≃* A6 :=
    ((QuotientGroup.quotientMulEquivOfEq hc).trans QuotientGroup.quotientBot).trans eK
  exact (Theory.GroupAction.ComponentRankAction.component_eq_primeClosure_and_residual_of_outer_twoGroup
    hK (by rw [hc]; simp) htwo hr e (by decide)
      (IsPGroup.of_card (n := 2) AlternatingSix.ShadowLocal.outer_card)).2

variable {G : Type*} [Group G] [Finite G]

/-- The ambient centralizing A₄ lies in the actual A₆ component, by its
intrinsic prime-to-three residual and the full involution-centralizer rank. -/
theorem alternatingFour_le_component (hG : IsQuasithin G)
    (K L B : Subgroup G) (z : G) (hz : orderOf z = 2) (hzL : z ∈ L)
    (hKZ : K ≤ centralizer ({z} : Set G))
    (hK : IsComponent (centralizer ({z} : Set G))
      (K.subgroupOf (centralizer ({z} : Set G))))
    (eK : K ≃* A6) (eB : B ≃* A4)
    (hBC : B ≤ centralizer (L : Set G)) : B ≤ K := by
  let C := centralizer ({z} : Set G)
  have hr : primeRank 3 C ≤ 2 :=
    Theory.GroupTheory.isQuasithin_iff_twoLocal.mp hG C (isTwoLocal_involution_centralizer hz)
      3 Nat.prime_three (by decide)
  have he := component_cubic_residual (K.subgroupOf C) hK
    ((subgroupOfEquivOfLe hKZ).trans eK) hr
  have hBC' : B ≤ C := by
    intro b hb
    exact mem_centralizer_singleton_iff.mpr (hBC hb z hzL).symm
  have hmap := embedded_primeToResidual_mono 3 hBC'
  rw [primeToResidual_eq_top_of_alternatingFour eB,
    ← MonoidHom.range_eq_map, range_subtype, ← he,
    map_subgroupOf_eq_of_le hKZ] at hmap
  exact hmap

omit [Finite G] in
private theorem twoPerfect_le_embedded_residual (B S : Subgroup G)
    (hBS : B ≤ S) (hB : IsPPerfect 2 B) : B ≤ (pResidual 2 S).map S.subtype := by
  have h := embedded_pResidual_mono 2 hBS
  rw [(pResidual_eq_top_iff 2 B).mpr hB,
    ← MonoidHom.range_eq_map, range_subtype] at h
  exact h

private theorem embedded_symmetricFour_residual_card (S : Subgroup G) (eS : S ≃* S4) :
    Nat.card ((pResidual 2 S).map S.subtype) = 12 := by
  rw [card_map_of_injective S.subtype_injective]
  rw [← card_map_of_injective (f := eS.toMonoidHom) eS.injective,
    map_pResidual_of_surjective 2 eS.toMonoidHom eS.surjective,
    Equiv.Perm.twoResidual_eq_alternating]
  exact alternatingGroup.card_of_card_eq_four (by simp)

/-- Two A₄ subgroups of an S₄ are equal, using the literal two-residual. -/
theorem alternatingFour_eq_of_le_symmetricFour (B D S : Subgroup G)
    (eB : B ≃* A4) (eD : D ≃* A4) (eS : S ≃* S4)
    (hBS : B ≤ S) (hDS : D ≤ S) : B = D := by
  have hcardB : Nat.card B = 12 :=
    (Nat.card_congr eB.toEquiv).trans (alternatingGroup.card_of_card_eq_four (by simp))
  have hcardD : Nat.card D = 12 :=
    (Nat.card_congr eD.toEquiv).trans (alternatingGroup.card_of_card_eq_four (by simp))
  have hB := eq_of_le_of_card_ge
    (twoPerfect_le_embedded_residual B S hBS (alternatingFour_twoPerfect eB))
    (by rw [embedded_symmetricFour_residual_card S eS, hcardB])
  have hD := eq_of_le_of_card_ge
    (twoPerfect_le_embedded_residual D S hDS (alternatingFour_twoPerfect eD))
    (by rw [embedded_symmetricFour_residual_card S eS, hcardD])
  exact hB.trans hD.symm

/-- S₄ maximality forces the actual A₆ into the centralizer. The element
adjoined to B belongs to the second A₄, so that A₄ escapes the S₄. -/
theorem component_centralizes_of_symmetricFour (K L B D : Subgroup G)
    (eK : K ≃* A6) (eB : B ≃* A4) (eD : D ≃* A4)
    (hBK : B ≤ K) (hDK : D ≤ K)
    (hBC : B ≤ centralizer (L : Set G)) (hDC : D ≤ centralizer (L : Set G))
    (t : G) (ht : t ∈ D) (eS : (B ⊔ zpowers t : Subgroup G) ≃* S4) :
    K ≤ centralizer (L : Set G) := by
  let S := B ⊔ zpowers t
  have hSK : S ≤ K := sup_le hBK (zpowers_le.mpr (hDK ht))
  have hSC : S ≤ centralizer (L : Set G) :=
    sup_le hBC (zpowers_le.mpr (hDC ht))
  have htnB : t ∉ B := by
    intro h
    have he : S = B := sup_eq_left.mpr (zpowers_le.mpr h)
    have hc : Nat.card S = 24 := by
      rw [Nat.card_congr eS.toEquiv, Nat.card_eq_fintype_card, Fintype.card_perm]
      decide
    rw [he, Nat.card_congr eB.toEquiv,
      alternatingGroup.card_of_card_eq_four (by simp)] at hc
    omega
  have hDnot : ¬ D ≤ S := by
    intro hDS
    exact htnB ((alternatingFour_eq_of_le_symmetricFour B D S eB eD eS le_sup_left hDS).symm ▸ ht)
  let SK := S.subgroupOf K
  let CK := (centralizer (L : Set G)).subgroupOf K
  let S' := SK.map eK.toMonoidHom
  let C' := CK.map eK.toMonoidHom
  let es : S' ≃* S4 :=
    (SK.equivMapOfInjective eK.toMonoidHom eK.injective).symm.trans
      ((subgroupOfEquivOfLe hSK).trans eS)
  have hle : S' ≤ C' := map_mono (fun _ hs => hSC hs)
  have hlt : S' < C' := lt_of_le_of_ne hle (by
    intro he
    have he' : SK = CK := map_injective eK.injective he
    apply hDnot
    intro d hd
    have hmem : (⟨d, hDK hd⟩ : K) ∈ CK := hDC hd
    rwa [← he'] at hmem)
  have htop := (AlternatingSix.ShadowLocal.CentralOuterLocal.symmetric_four_isCoatom S' es).2 C' hlt
  have hCK : CK = ⊤ := by
    apply map_injective (f := eK.toMonoidHom) eK.injective
    rw [map_top_of_surjective _ eK.surjective]
    exact htop
  intro k hk
  exact (hCK.symm ▸ (mem_top (⟨k, hk⟩ : K)) : (⟨k, hk⟩ : K) ∈ CK)

/-- Commuting A₄ and A₆ subgroups violate the genuine two-local cubic bound. -/
theorem not_commuting_alternatingFour_six (hG : IsQuasithin G)
    (L K : Subgroup G) (eL : L ≃* A4) (eK : K ≃* A6) :
    ¬ K ≤ centralizer (L : Set G) := by
  intro hc
  have hd : Disjoint L K := by
    apply disjoint_iff_inf_le.mpr
    intro x hx
    have hxz : (⟨x, hx.2⟩ : K) ∈ center K := by
      rw [mem_center_iff]
      intro k
      exact Subtype.ext (hc k.property x hx.1).symm
    have he := (centerCongr eK ⟨⟨x, hx.2⟩, hxz⟩).property
    change eK ⟨x, hx.2⟩ ∈ center A6 at he
    rw [alternatingGroup.center_eq_bot (by simp), mem_bot] at he
    exact congrArg Subtype.val (eK.injective (he.trans eK.map_one.symm))
  let f : L × K →* G := L.subtype.noncommCoprod K.subtype
    (fun l k => hc k.property l l.property)
  have hf : Function.Injective f := mul_injective_of_disjoint hd
  let e := eL.prodCongr eK
  let g := f.comp e.symm.toMonoidHom
  have hg : Function.Injective g := hf.comp e.symm.injective
  let V := alternatingGroup.kleinFour (Fin 4)
  let : V.Normal := alternatingGroup.normal_kleinFour (by simp)
  let Q : Subgroup (A4 × A6) := V.prod ⊥
  have hQc : Nat.card Q = 4 := by
    rw [Nat.card_congr (Subgroup.prodEquiv _ _).toEquiv, Nat.card_prod, card_bot, mul_one]
    exact alternatingGroup.kleinFour_card_of_card_eq_four (by simp)
  have hQne : Q ≠ ⊥ := by
    intro he
    rw [he, card_bot] at hQc
    omega
  have hr := Theory.Quasithin.primeRank_le_twoLocalPrimeRank_of_embedding g hg Q hQne
    (IsPGroup.of_card (n := 2) hQc) 3
  rw [alternatingGroup.four_prod_six_primeRank] at hr
  have hb := isQuasithin_iff_twoLocalPrimeRank.mp hG 3 Nat.prime_three (by decide)
  omega

/-- The source 2.4.36 contradiction once the actual complementary A₄ and
its S₄ marking have been constructed in the A₈ overcomponent. -/
theorem paired_cubic_a8_false (hG : IsQuasithin G)
    (K L B D : Subgroup G) (z : G) (hz : orderOf z = 2) (hzL : z ∈ L)
    (hKZ : K ≤ centralizer ({z} : Set G))
    (hK : IsComponent (centralizer ({z} : Set G))
      (K.subgroupOf (centralizer ({z} : Set G))))
    (eK : K ≃* A6) (eL : L ≃* A4) (eB : B ≃* A4) (eD : D ≃* A4)
    (hDK : D ≤ K) (hBC : B ≤ centralizer (L : Set G))
    (hDC : D ≤ centralizer (L : Set G))
    (t : G) (ht : t ∈ D) (eS : (B ⊔ zpowers t : Subgroup G) ≃* S4) : False := by
  have hBK := alternatingFour_le_component hG K L B z hz hzL hKZ hK eK eB hBC
  exact not_commuting_alternatingFour_six hG L K eL eK
    (component_centralizes_of_symmetricFour K L B D eK eB eD hBK hDK hBC hDC t ht eS)

end AlternatingSix.PairedCubicResidual

