module
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.EightCells
import Mathlib.Tactic.Group

/-!
# Faithfulness from collected Borel coordinates and Weyl separation

The abstract eight-cell theorem puts a kernel element in a double coset.
Its image forces the Weyl representative into the model Borel; separated
pivots make that representative the identity. Injective collected Borel
coordinates then kill the kernel. This isolates the faithful-evaluation
step of Steinberg's presentation proof (Lectures on Chevalley Groups,
Theorem 4 and the proof of Theorem 9). The evaluation map and the two
matrix checks remain explicit here and are supplied by the concrete
presentation construction; no presentation is assumed faithful.
-/
@[expose] public section
namespace Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
variable {G M RA RD RC RB H : Type*} [Group G] [Group M]
variable [Group RA] [Group RD] [Group RC] [Group RB] [Group H]
namespace PositiveMaps.TorusLaws
variable {r : PositiveMaps G RA RD RC RB} {h : H →* G}

theorem injective_on_borel (ht : r.TorusLaws h) (hc : r.Collects) (f : G →* M)
    (hf : Function.Injective (fun p : RA × RD × RC × RB × H =>
      f (r.word p.1 p.2.1 p.2.2.1 p.2.2.2.1*h p.2.2.2.2))) :
    Function.Injective (f.comp (r.borel h).subtype) := by
  intro x y hxy
  obtain ⟨a,d,c,b,k,hx⟩ := ht.exists_word hc x.property
  obtain ⟨a',d',c',b',k',hy⟩ := ht.exists_word hc y.property
  have he : (a,d,c,b,k)=(a',d',c',b',k') := hf (by
    simpa only [MonoidHom.comp_apply,Subgroup.coe_subtype,hx,hy] using hxy)
  cases he
  exact Subtype.ext (hx.trans hy.symm)
end PositiveMaps.TorusLaws
namespace ReflectionLaws
variable {r : PositiveMaps G RA RD RC RB} {h : H →* G} {s t : G}

/-- A map with faithful Borel coordinates and separated Weyl pivots is
faithful on the whole group generated by the presentation generators. -/
theorem injective_on_fullGenerated (e : ReflectionLaws r h s t)
    (hc : r.Collects) (ht : r.TorusLaws h)
    (hsh : ∀ k, ∃ l, s*h k*s=h l) (hth : ∀ k, ∃ l, t*h k*t=h l) (hst : (s*t)^4=1)
    (f : G →* M) (B : Subgroup M) (hB : r.borel h≤B.comap f)
    (hcoords : Function.Injective (fun p : RA × RD × RC × RB × H =>
      f (r.word p.1 p.2.1 p.2.2.1 p.2.2.2.1*h p.2.2.2.2)))
    (hweyl : ∀ w : WeylWord, f (w.eval s t)∈B → w=.one) :
    Function.Injective (f.comp (fullGenerated r h s t).subtype) := by
  have hker {g : G} (hg : g∈fullGenerated r h s t) (hfg : f g=1) : g=1 := by
    obtain ⟨w,l,hl,v,hv,heq⟩ := e.exists_cell hc ht hsh hth hst hg
    have hfn : f (w.eval s t)∈B := by
      have hn : w.eval s t=l⁻¹*g*v⁻¹ := by rw [heq]; group
      rw [hn,map_mul,map_mul,map_inv,map_inv,hfg,mul_one]
      exact B.mul_mem (B.inv_mem (hB hl)) (B.inv_mem (hB hv))
    have hw := hweyl w hfn
    subst w
    have hgB : g∈r.borel h := InCell.mem_of_one ⟨l,hl,v,hv,heq⟩
    have hid : (⟨g,hgB⟩ : r.borel h)=1 := ht.injective_on_borel hc f hcoords (by
      change f g=f 1
      simpa only [map_one] using hfg)
    exact congrArg Subtype.val hid
  intro x y hxy
  apply Subtype.ext
  apply mul_inv_eq_one.mp
  apply hker ((fullGenerated r h s t).mul_mem x.property
    ((fullGenerated r h s t).inv_mem y.property))
  change f x.val=f y.val at hxy
  rw [map_mul,map_inv,hxy,mul_inv_cancel]
end ReflectionLaws
end Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
