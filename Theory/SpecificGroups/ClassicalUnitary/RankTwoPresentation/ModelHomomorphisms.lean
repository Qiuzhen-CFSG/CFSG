module
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FourPresentation
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FivePresentation
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FourGeneration

/-!
# Homomorphisms constructed from unitary presentation equations

The U₄ evaluation is an equivalence with all of SU₄, so its inverse and the
presentation's universal property construct a homomorphism into any group
satisfying the same equations. Generation in that target gives surjectivity.
For U₅ the same construction has the explicitly named matrix-generated
subgroup as domain; general-q whole-SU₅ generation is still required before
that domain can be enlarged. Every root, torus, and Weyl generator has its
prescribed image. Source: Steinberg, Lectures on Chevalley Groups, the proof
mechanism of Theorem 9, adapted to the relative roots of Theorem 33.
-/
@[expose] public noncomputable section
open Matrix Subgroup BenderSuzuki.MatrixGroups
namespace Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
namespace FourPresentation
open UnitaryFourFlag UnitaryFourSylow FourPositive FourWeyl
variable (E : Type*) [Field E] [Finite E] [CharP E 2]
variable (σ : E ≃+* E) (hσ : Function.Involutive σ)
local notation "J" => form E σ hσ
local notation "P" => parameters E σ hσ
local notation "Gen" => Presentation.Generator (Multiplicative E) (Multiplicative (FixedField E σ))
  (Multiplicative E) (Multiplicative (FixedField E σ)) (torusParameters E σ)

theorem evaluate_surjective : Function.Surjective (evaluate E σ hσ) := by
  apply (P).evaluate_surjective (model_satisfies E σ hσ)
  rw [model_roots,model_torus]
  exact FourCells.fullGenerated_eq_top E σ hσ

/-- The explicit relations present the whole literal SU₄ group. -/
def equiv : (P).Carrier ≃* SU E J :=
  MulEquiv.ofBijective (evaluate E σ hσ) ⟨evaluate_injective E σ hσ,evaluate_surjective E σ hσ⟩

@[simp] theorem equiv_generator (j : Gen) : equiv E σ hσ (PresentedGroup.of j)=modelGenerators E σ hσ j :=
  (P).evaluate_generator (model_satisfies E σ hσ) j

variable {Y : Type*} [Group Y]
/-- Construct a model homomorphism from the unitary equations in any group. -/
def lift {g : Gen → Y} (hg : (P).Satisfies g) : SU E J →* Y :=
  ((P).evaluate hg).comp (equiv E σ hσ).symm.toMonoidHom

@[simp] theorem lift_generator {g : Gen → Y} (hg : (P).Satisfies g) (j : Gen) :
    lift E σ hσ hg (modelGenerators E σ hσ j)=g j := by
  rw [←equiv_generator E σ hσ j]
  change (P).evaluate hg ((equiv E σ hσ).symm (equiv E σ hσ (PresentedGroup.of j)))=g j
  rw [MulEquiv.symm_apply_apply,(P).evaluate_generator]

theorem lift_surjective {g : Gen → Y} (hg : (P).Satisfies g)
    (hgen : ReflectionLaws.fullGenerated hg.roots hg.torus (g .s) (g .t)=⊤) :
    Function.Surjective (lift E σ hσ hg) :=
  ((P).evaluate_surjective hg hgen).comp (equiv E σ hσ).symm.surjective
end FourPresentation

namespace FivePresentation
open FivePositive FiveWeyl
variable {E : Type*} [Field E] [CharP E 2]
variable (J : HermitianForm 5 E) (κ : E) (hκ : κ+J.conj κ=1) (hJ : J.form=1)
local notation "P" => parameters J
local notation "Gen" => Presentation.Generator (Multiplicative E) (Parameter J)
  (Multiplicative E) (Parameter J) (Eˣ × Eˣ)

/-- The actual subgroup generated by all positive roots, torus, and Weyl matrices. -/
def matrixGenerated : Subgroup J.specialSubgroup :=
  ReflectionLaws.fullGenerated (roots J κ hκ hJ) (h J κ hκ hJ) (s J κ hκ hJ) (t J κ hκ hJ)

theorem evaluate_range : (evaluate J κ hκ hJ).range=matrixGenerated J κ hκ hJ := by
  change ((P).evaluate (model_satisfies J κ hκ hJ)).range=_
  rw [(P).evaluate_range,model_roots,model_torus]
  rfl

/-- This equivalence retains the explicit generated-subgroup boundary until
whole-SU₅ generation is proved. -/
def equivGenerated : (P).Carrier ≃* matrixGenerated J κ hκ hJ :=
  (MonoidHom.ofInjective (evaluate_injective J κ hκ hJ)).trans
    (MulEquiv.subgroupCongr (evaluate_range J κ hκ hJ))

@[simp] theorem equivGenerated_coe (x : (P).Carrier) :
    (equivGenerated J κ hκ hJ x).val=evaluate J κ hκ hJ x := rfl

def markedGenerator (j : Gen) : matrixGenerated J κ hκ hJ :=
  equivGenerated J κ hκ hJ (PresentedGroup.of j)

@[simp] theorem markedGenerator_val (j : Gen) :
    (markedGenerator J κ hκ hJ j).val=modelGenerators J κ hκ hJ j :=
  (P).evaluate_generator (model_satisfies J κ hκ hJ) j

variable {Y : Type*} [Group Y]
def liftGenerated {g : Gen → Y} (hg : (P).Satisfies g) : matrixGenerated J κ hκ hJ →* Y :=
  ((P).evaluate hg).comp (equivGenerated J κ hκ hJ).symm.toMonoidHom

@[simp] theorem liftGenerated_generator {g : Gen → Y} (hg : (P).Satisfies g) (j : Gen) :
    liftGenerated J κ hκ hJ hg (markedGenerator J κ hκ hJ j)=g j := by
  change (P).evaluate hg ((equivGenerated J κ hκ hJ).symm
    (equivGenerated J κ hκ hJ (PresentedGroup.of j)))=g j
  rw [MulEquiv.symm_apply_apply,(P).evaluate_generator]

theorem liftGenerated_surjective {g : Gen → Y} (hg : (P).Satisfies g)
    (hgen : ReflectionLaws.fullGenerated hg.roots hg.torus (g .s) (g .t)=⊤) :
    Function.Surjective (liftGenerated J κ hκ hJ hg) :=
  ((P).evaluate_surjective hg hgen).comp (equivGenerated J κ hκ hJ).symm.surjective
end FivePresentation
end Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
