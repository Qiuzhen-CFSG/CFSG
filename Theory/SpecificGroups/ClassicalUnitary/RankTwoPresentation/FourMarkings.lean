module
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FourGeneration
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.ModelSeparation
import Mathlib.Tactic.Group

/-!
# Both unitary-four endpoints from the full Bruhat decomposition

The literal permutation matrices select point and plane among the eight
Bruhat cells. Consequently the entire point and plane stabilizers are
generated by their full common Borel and the prescribed t or s reflection.
The calculation includes q=2 and uses no simplicity assumption.
Source: Steinberg, Lectures on Chevalley Groups, Theorems 4 and 33;
DGS, Groups and Graphs, the unitary quadrangles on printed p.209.
-/
@[expose] public noncomputable section
open Matrix Subgroup BenderSuzuki.MatrixGroups
namespace Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FourCells
open UnitaryFourFlag UnitaryFourGeneration FourPositive FourWeyl
variable (E : Type*) [Field E] [Finite E] [CharP E 2]
variable (σ : E ≃+* E) (hσ : Function.Involutive σ)
local notation "J" => form E σ hσ
local notation "BB" => borelSU E J

theorem weyl_mem_point_iff (w : WeylWord) :
    w.eval (s E σ hσ) (t E σ hσ)∈pointParabolicSU E J ↔ w=.one ∨ w=.t := by
  rw [mem_pointParabolicSU]
  change ((evaluate E σ hσ (w.eval (s E σ hσ) (t E σ hσ))) 1 0=0 ∧
    (evaluate E σ hσ (w.eval (s E σ hσ) (t E σ hσ))) 2 0=0 ∧
    (evaluate E σ hσ (w.eval (s E σ hσ) (t E σ hσ))) 3 0=0) ↔ _
  have hs : evaluate E σ hσ (s E σ hσ)=Matrix4.S := s_val E σ hσ
  have ht : evaluate E σ hσ (t E σ hσ)=Matrix4.T := t_val E σ hσ
  simp only [WeylWord.map_eval,hs,ht]
  cases w <;> simp [WeylWord.eval,Matrix4.S,Matrix4.T,Matrix.mul_apply,Fin.sum_univ_succ]

theorem weyl_mem_plane_iff (w : WeylWord) :
    w.eval (s E σ hσ) (t E σ hσ)∈planeParabolicSU E J ↔ w=.one ∨ w=.s := by
  rw [mem_planeParabolicSU]
  change ((evaluate E σ hσ (w.eval (s E σ hσ) (t E σ hσ))) 2 0=0 ∧
    (evaluate E σ hσ (w.eval (s E σ hσ) (t E σ hσ))) 3 0=0 ∧
    (evaluate E σ hσ (w.eval (s E σ hσ) (t E σ hσ))) 2 1=0 ∧
    (evaluate E σ hσ (w.eval (s E σ hσ) (t E σ hσ))) 3 1=0) ↔ _
  have hs : evaluate E σ hσ (s E σ hσ)=Matrix4.S := s_val E σ hσ
  have ht : evaluate E σ hσ (t E σ hσ)=Matrix4.T := t_val E σ hσ
  simp only [WeylWord.map_eval,hs,ht]
  cases w <;> simp [WeylWord.eval,Matrix4.S,Matrix4.T,Matrix.mul_apply,Fin.sum_univ_succ]

/-- The full literal point stabilizer, including q=2. -/
theorem point_eq_generated : pointParabolicSU E J=BB ⊔ closure {t E σ hσ} := by
  apply le_antisymm
  · intro g hg
    obtain ⟨w,l,hl,v,hv,he⟩ := all_eight_cells E σ hσ g
    have hB : BB≤pointParabolicSU E J := inf_le_left
    have hn : w.eval (s E σ hσ) (t E σ hσ)∈pointParabolicSU E J := by
      have hh : w.eval (s E σ hσ) (t E σ hσ)=l⁻¹*g*v⁻¹ := by rw [he]; group
      rw [hh]
      exact (pointParabolicSU E J).mul_mem
        ((pointParabolicSU E J).mul_mem ((pointParabolicSU E J).inv_mem (hB hl)) hg)
        ((pointParabolicSU E J).inv_mem (hB hv))
    have hW : w.eval (s E σ hσ) (t E σ hσ)∈BB ⊔ closure {t E σ hσ} := by
      rcases (weyl_mem_point_iff E σ hσ w).mp hn with rfl|rfl
      · exact (BB ⊔ closure {t E σ hσ}).one_mem
      · exact Subgroup.mem_sup_right (subset_closure (Set.mem_singleton _))
    rw [he]
    exact (BB ⊔ closure {t E σ hσ}).mul_mem
      ((BB ⊔ closure {t E σ hσ}).mul_mem (Subgroup.mem_sup_left hl) hW) (Subgroup.mem_sup_left hv)
  · apply sup_le inf_le_left
    apply (Subgroup.closure_le _).2
    rintro x rfl
    exact middleSwap_mem_point E σ hσ

/-- The entire other endpoint is generated by the same Borel and s. -/
theorem plane_eq_generated : planeParabolicSU E J=BB ⊔ closure {s E σ hσ} := by
  apply le_antisymm
  · intro g hg
    obtain ⟨w,l,hl,v,hv,he⟩ := all_eight_cells E σ hσ g
    have hB : BB≤planeParabolicSU E J := inf_le_right
    have hn : w.eval (s E σ hσ) (t E σ hσ)∈planeParabolicSU E J := by
      have hh : w.eval (s E σ hσ) (t E σ hσ)=l⁻¹*g*v⁻¹ := by rw [he]; group
      rw [hh]
      exact (planeParabolicSU E J).mul_mem
        ((planeParabolicSU E J).mul_mem ((planeParabolicSU E J).inv_mem (hB hl)) hg)
        ((planeParabolicSU E J).inv_mem (hB hv))
    have hW : w.eval (s E σ hσ) (t E σ hσ)∈BB ⊔ closure {s E σ hσ} := by
      rcases (weyl_mem_plane_iff E σ hσ w).mp hn with rfl|rfl
      · exact (BB ⊔ closure {s E σ hσ}).one_mem
      · exact Subgroup.mem_sup_right (subset_closure (Set.mem_singleton _))
    rw [he]
    exact (BB ⊔ closure {s E σ hσ}).mul_mem
      ((BB ⊔ closure {s E σ hσ}).mul_mem (Subgroup.mem_sup_left hl) hW) (Subgroup.mem_sup_left hv)
  · apply sup_le inf_le_right
    apply (Subgroup.closure_le _).2
    rintro x rfl
    exact pairSwap_mem_plane E σ hσ
end Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FourCells
