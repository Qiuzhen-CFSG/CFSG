module
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FourBruhat
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FiveBruhat
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FourTorus
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FiveTorus
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.BorelCells
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination

/-!
# Both unitary model two-cell calculations

The explicit model equations discharge every premise of the abstract
rank-one collection argument. The subgroup here is the one generated by
the four positive roots and the entire diagonal torus. Its identification
with the full matrix Borel, the eight-cell induction and presentation
faithfulness are later steps; none is assumed by these calculations.
Source: Steinberg, Lectures on Chevalley Groups, Lemmas 21–24 and 63–64.
-/
@[expose] public noncomputable section
open Matrix Subgroup BenderSuzuki.MatrixGroups
namespace Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
namespace FourCells
open UnitaryFourFlag UnitaryFourSylow FourPositive FourWeyl
variable (E : Type*) [Field E] [Finite E] [CharP E 2]
variable (σ : E ≃+* E) (hσ : Function.Involutive σ)
local notation "J" => form E σ hσ

def swapParameter (p : torusParameters E σ) : torusParameters E σ :=
  ⟨(p.val.2,p.val.1),by
    have hp := p.property
    change σ ((p.val.1:E)*(p.val.2:E))=(p.val.1:E)*(p.val.2:E) at hp
    change σ ((p.val.2:E)*(p.val.1:E))=(p.val.2:E)*(p.val.1:E)
    simpa only [mul_comm] using hp⟩

def turnParameter (p : torusParameters E σ) : torusParameters E σ :=
  ⟨(p.val.1,(Units.map σ.toMonoidHom p.val.2)⁻¹),by
    have hp := p.property
    change σ ((p.val.1:E)*(p.val.2:E))=(p.val.1:E)*(p.val.2:E) at hp
    change σ ((p.val.1:E)*↑((Units.map σ.toMonoidHom p.val.2)⁻¹))=
      (p.val.1:E)*↑((Units.map σ.toMonoidHom p.val.2)⁻¹)
    simp only [Units.val_inv_eq_inv_val,Units.coe_map]
    change σ ((p.val.1:E)*(σ (p.val.2:E))⁻¹)=(p.val.1:E)*(σ (p.val.2:E))⁻¹
    simp only [map_mul,map_inv₀,hσ (p.val.2:E)]
    field_simp
    simpa only [map_mul,mul_comm] using hp⟩

theorem s_h (p : torusParameters E σ) :
    s E σ hσ*h E σ hσ p*s E σ hσ=h E σ hσ (swapParameter E σ p) := by
  apply Subtype.ext; apply Units.ext
  change (s E σ hσ).val.val*(h E σ hσ p).val.val*(s E σ hσ).val.val=
    (h E σ hσ _).val.val
  rw [s_val,h_val,h_val]
  exact Matrix4.S_H σ _ _

theorem t_h (p : torusParameters E σ) :
    t E σ hσ*h E σ hσ p*t E σ hσ=h E σ hσ (turnParameter E σ hσ p) := by
  apply Subtype.ext; apply Units.ext
  change (t E σ hσ).val.val*(h E σ hσ p).val.val*(t E σ hσ).val.val=
    (h E σ hσ _).val.val
  rw [t_val,h_val,h_val]
  simp only [turnParameter,Units.val_inv_eq_inv_val,Units.coe_map]
  exact Matrix4.T_H σ hσ _ _

/-- Both U₄ two-cell alternatives, with all concrete equations discharged. -/
theorem both_cells {x : SU E J} (hx : x∈(roots E σ hσ).borel (hHom E σ hσ)) :
    (s E σ hσ*x*s E σ hσ∈(roots E σ hσ).borel (hHom E σ hσ) ∨
      ∃ l∈(roots E σ hσ).borel (hHom E σ hσ),
        ∃ v∈(roots E σ hσ).borel (hHom E σ hσ), s E σ hσ*x*s E σ hσ=l*s E σ hσ*v) ∧
    (t E σ hσ*x*t E σ hσ∈(roots E σ hσ).borel (hHom E σ hσ) ∨
      ∃ l∈(roots E σ hσ).borel (hHom E σ hσ),
        ∃ v∈(roots E σ hσ).borel (hHom E σ hσ), t E σ hσ*x*t E σ hσ=l*t E σ hσ*v) := by
  exact ⟨(FourBruhat.reflectionLaws E σ hσ).s_borel (collects E σ hσ)
      (FourTorus.torusLaws E σ hσ) (fun p => ⟨swapParameter E σ p,s_h E σ hσ p⟩) hx,
    (FourBruhat.reflectionLaws E σ hσ).t_borel (collects E σ hσ)
      (FourTorus.torusLaws E σ hσ) (fun p => ⟨turnParameter E σ hσ p,t_h E σ hσ p⟩) hx⟩

end FourCells
namespace FiveCells
open FivePositive FiveWeyl
variable {E : Type*} [Field E] [CharP E 2]
variable (J : HermitianForm 5 E) (κ : E) (hκ : κ+J.conj κ=1) (hJ : J.form=1)

/-- Both general-q U₅ two-cell alternatives in the original matrix carrier. -/
theorem both_cells {x : J.specialSubgroup} (hx : x∈(roots J κ hκ hJ).borel (h J κ hκ hJ)) :
    (s J κ hκ hJ*x*s J κ hκ hJ∈(roots J κ hκ hJ).borel (h J κ hκ hJ) ∨
      ∃ l∈(roots J κ hκ hJ).borel (h J κ hκ hJ),
        ∃ v∈(roots J κ hκ hJ).borel (h J κ hκ hJ), s J κ hκ hJ*x*s J κ hκ hJ=l*s J κ hκ hJ*v) ∧
    (t J κ hκ hJ*x*t J κ hκ hJ∈(roots J κ hκ hJ).borel (h J κ hκ hJ) ∨
      ∃ l∈(roots J κ hκ hJ).borel (h J κ hκ hJ),
        ∃ v∈(roots J κ hκ hJ).borel (h J κ hκ hJ), t J κ hκ hJ*x*t J κ hκ hJ=l*t J κ hκ hJ*v) := by
  exact ⟨(FiveBruhat.reflectionLaws J κ hκ hJ).s_borel (collects J κ hκ hJ)
      (FiveTorus.torusLaws J κ hκ hJ) (fun p => ⟨(p.2,p.1),s_h J κ hκ hJ p⟩) hx,
    (FiveBruhat.reflectionLaws J κ hκ hJ).t_borel (collects J κ hκ hJ)
      (FiveTorus.torusLaws J κ hκ hJ)
      (fun p => ⟨(p.1,(Units.map J.conj.toMonoidHom p.2)⁻¹),t_h J κ hκ hJ p⟩) hx⟩

end FiveCells
end Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
