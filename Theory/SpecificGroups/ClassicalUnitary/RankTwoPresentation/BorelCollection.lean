module
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.Collection
import Mathlib.Tactic.Group

/-!
# Positive roots and torus collection

A torus normalizing each positive root normalizes their generated subgroup.
The product U H is then a subgroup, and positive collection gives its complete
ordered coordinate form. No faithfulness or pre-existing BN-pair is assumed.
Source: Steinberg, Lectures on Chevalley Groups, Lemmas 21–24.
-/
@[expose] public section
namespace Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
variable {G RA RD RC RB H : Type*} [Group G] [Group RA] [Group RD] [Group RC] [Group RB] [Group H]

namespace PositiveMaps
variable (r : PositiveMaps G RA RD RC RB) (h : H →* G)

/-- A torus's four root actions, stated without assuming injectivity. -/
structure TorusLaws : Prop where
  A : ∀ k a, ∃ a', h k*r.A a*(h k)⁻¹=r.A a'
  D : ∀ k d, ∃ d', h k*r.D d*(h k)⁻¹=r.D d'
  C : ∀ k c, ∃ c', h k*r.C c*(h k)⁻¹=r.C c'
  B : ∀ k b, ∃ b', h k*r.B b*(h k)⁻¹=r.B b'

/-- The Borel generated by the four positive parameter groups and the torus. -/
def borel : Subgroup G := r.generated ⊔ h.range

namespace TorusLaws
variable {r h} (e : r.TorusLaws h)

private theorem conj_mem (e : r.TorusLaws h) (k : H) {u : G} (hu : u∈r.generated) :
    h k*u*(h k)⁻¹∈r.generated := by
  induction hu using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with ((⟨a,rfl⟩|⟨d,rfl⟩)|⟨c,rfl⟩)|⟨b,rfl⟩
    · obtain ⟨a',ha'⟩ := e.A k a
      rw [ha']
      exact Subgroup.subset_closure (Or.inl (Or.inl (Or.inl ⟨a',rfl⟩)))
    · obtain ⟨d',hd'⟩ := e.D k d
      rw [hd']
      exact Subgroup.subset_closure (Or.inl (Or.inl (Or.inr ⟨d',rfl⟩)))
    · obtain ⟨c',hc'⟩ := e.C k c
      rw [hc']
      exact Subgroup.subset_closure (Or.inl (Or.inr ⟨c',rfl⟩))
    · obtain ⟨b',hb'⟩ := e.B k b
      rw [hb']
      exact Subgroup.subset_closure (Or.inr ⟨b',rfl⟩)
  | one => simp
  | mul a b ha hb ia ib =>
    have he : h k*(a*b)*(h k)⁻¹=(h k*a*(h k)⁻¹)*(h k*b*(h k)⁻¹) := by group
    rw [he]
    exact r.generated.mul_mem ia ib
  | inv a ha ia =>
    have he : h k*a⁻¹*(h k)⁻¹=(h k*a*(h k)⁻¹)⁻¹ := by group
    rw [he]
    exact r.generated.inv_mem ia

/-- Every Borel element is a positive word followed by one full torus parameter. -/
theorem exists_word (e : r.TorusLaws h) (hc : r.Collects) {g : G} (hg : g∈r.borel h) :
    ∃ a d c b k, g=r.word a d c b*h k := by
  have hfac : ∀ g∈r.borel h, ∃ u∈r.generated, ∃ k, g=u*h k := by
    intro g hg
    rw [borel,Subgroup.sup_eq_closure] at hg
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with hx|hx
      · exact ⟨x,hx,1,by simp⟩
      · obtain ⟨k,rfl⟩:=hx; exact ⟨1,r.generated.one_mem,k,by simp⟩
    | one => exact ⟨1,r.generated.one_mem,1,by simp⟩
    | mul x y hx hy ix iy =>
      obtain ⟨u,hu,k,rfl⟩:=ix
      obtain ⟨v,hv,l,rfl⟩:=iy
      refine ⟨u*(h k*v*(h k)⁻¹),r.generated.mul_mem hu (e.conj_mem k hv),k*l,?_⟩
      rw [map_mul]
      group
    | inv x hx ix =>
      obtain ⟨u,hu,k,rfl⟩:=ix
      refine ⟨h k⁻¹*u⁻¹*(h k⁻¹)⁻¹,e.conj_mem k⁻¹ (r.generated.inv_mem hu),k⁻¹,?_⟩
      rw [map_inv]
      group
  obtain ⟨u,hu,k,rfl⟩ := hfac g hg
  obtain ⟨a,d,c,b,rfl⟩ := PositiveMaps.exists_word hc hu
  exact ⟨a,d,c,b,k,rfl⟩

end TorusLaws
end PositiveMaps
end Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
