module
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.EightCells
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.ModelCells

/-!
# Eight Bruhat cells in the unitary matrix-generated subgroups

The model matrix equations discharge all the premises of the abstract
Bruhat induction. Coverage is first asserted on the subgroup generated by
these literal roots, full torus, and both Weyl matrices. Whole-SU generation
is a separate obligation. Both dimensions retain their original parameter
groups. Source: Steinberg, Lectures on Chevalley Groups, Theorems 4 and 33.
-/
@[expose] public noncomputable section
open Matrix Subgroup BenderSuzuki.MatrixGroups
namespace Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
namespace FourCells
open UnitaryFourFlag UnitaryFourSylow FourPositive FourWeyl
variable (E : Type*) [Field E] [Finite E] [CharP E 2]
variable (σ : E ≃+* E) (hσ : Function.Involutive σ)
local notation "J" => form E σ hσ

theorem eight_cells {x : SU E J}
    (hx : x∈ReflectionLaws.fullGenerated (roots E σ hσ) (hHom E σ hσ) (s E σ hσ) (t E σ hσ)) :
    ∃ w : WeylWord, InCell ((roots E σ hσ).borel (hHom E σ hσ))
      (w.eval (s E σ hσ) (t E σ hσ)) x :=
  (FourBruhat.reflectionLaws E σ hσ).exists_cell (collects E σ hσ)
    (FourTorus.torusLaws E σ hσ) (fun p => ⟨swapParameter E σ p,s_h E σ hσ p⟩)
    (fun p => ⟨turnParameter E σ hσ p,t_h E σ hσ p⟩) (st_four E σ hσ) hx
end FourCells
namespace FiveCells
open FivePositive FiveWeyl
variable {E : Type*} [Field E] [CharP E 2]
variable (J : HermitianForm 5 E) (κ : E) (hκ : κ+J.conj κ=1) (hJ : J.form=1)

theorem eight_cells {x : J.specialSubgroup}
    (hx : x∈ReflectionLaws.fullGenerated (roots J κ hκ hJ) (h J κ hκ hJ) (s J κ hκ hJ) (t J κ hκ hJ)) :
    ∃ w : WeylWord, InCell ((roots J κ hκ hJ).borel (h J κ hκ hJ))
      (w.eval (s J κ hκ hJ) (t J κ hκ hJ)) x :=
  (FiveBruhat.reflectionLaws J κ hκ hJ).exists_cell (collects J κ hκ hJ)
    (FiveTorus.torusLaws J κ hκ hJ) (fun p => ⟨(p.2,p.1),s_h J κ hκ hJ p⟩)
    (fun p => ⟨(p.1,(Units.map J.conj.toMonoidHom p.2)⁻¹),t_h J κ hκ hJ p⟩)
    (st_four J κ hκ hJ) hx
end FiveCells
end Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation
