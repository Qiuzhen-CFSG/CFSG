module
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.Presentation
public import Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.ModelSeparation

/-!
# FivePresentation

The full nonabelian Hermitian groups and determinant-correcting diagonal
torus instantiate the abstract presentation at arbitrary q. Matrix Borel
coordinates and Weyl pivots prove canonical evaluation is injective. Its
image is the group generated by those matrices; whole-SU₅ generation is a
separate remaining obligation. The basis change is the same one used by
FivePositive. Source: Steinberg, Lectures on Chevalley Groups, Theorem 33
and Lemmas 63–64, with the Bruhat proof mechanism of Lemmas 21–26.
-/
@[expose] public noncomputable section
open Matrix Subgroup BenderSuzuki.MatrixGroups
namespace Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FivePresentation
open FivePositive FiveWeyl
variable {E : Type*} [Field E] [CharP E 2]
variable (J : HermitianForm 5 E) (κ : E) (hκ : κ+J.conj κ=1) (hJ : J.form=1)

def parameters : Presentation.Parameters (Multiplicative E) (Parameter J)
    (Multiplicative E) (Parameter J) (Eˣ × Eˣ) where
  ca c a := traceParameter J a.toAdd c.toAdd
  bd b d := Multiplicative.ofAdd (d.val.1*J.conj b.val.1)
  baD b a := normParameter J a.toAdd b
  baC b a := Multiplicative.ofAdd (a.toAdd*J.conj b.val.2)
  hA k a := Multiplicative.ofAdd (((k.1:E)/(k.2:E))*a.toAdd)
  hD k d := FiveTorus.scale J k k.1 d
  hC k c := Multiplicative.ofAdd (((k.1:E)*J.conj (k.2:E))*c.toAdd)
  hB k b := FiveTorus.scale J k k.2 b
  sh k := (k.2,k.1)
  th k := (k.1,(Units.map J.conj.toMonoidHom k.2)⁻¹)
  sD := id
  sC c := Multiplicative.ofAdd (J.conj c.toAdd)
  sB := id
  tA := id
  tD := id
  tC := id
  rankA a ha := (Multiplicative.ofAdd a.toAdd⁻¹,
    FiveBruhat.aTorus a.toAdd (by simpa using ha),Multiplicative.ofAdd a.toAdd⁻¹)
  rankB b hb := (FiveBruhat.leftParameter J b (FiveBruhat.snd_ne_zero J hb),
    FiveBruhat.bTorus J b (FiveBruhat.snd_ne_zero J hb),
    FiveBruhat.rightParameter J b (FiveBruhat.snd_ne_zero J hb))

def modelGenerators := Presentation.Generator.ofMaps (roots J κ hκ hJ) (h J κ hκ hJ) (s J κ hκ hJ) (t J κ hκ hJ)

private theorem flip {G : Type*} [Group G] {w x y : G} (hw : w*w=1) (he : w*x*w=y) : w*y*w=x := by
  rw [←he]
  calc
    w*(w*x*w)*w=(w*w)*x*(w*w) := by simp only [mul_assoc]
    _ = x := by rw [hw,one_mul,mul_one]

theorem model_satisfies : (parameters J).Satisfies (modelGenerators J κ hκ hJ) := by
  intro x y he
  cases he <;> simp only [Presentation.a,Presentation.d,Presentation.c,Presentation.b,
    Presentation.h,Presentation.s,Presentation.t,map_one,map_mul,map_inv,map_pow,
    FreeGroup.lift_apply_of,modelGenerators,Presentation.Generator.ofMaps]
  case ad a d => exact (A_D J κ hκ hJ a.toAdd d).eq
  case cd c d => exact (C_D J κ hJ c.toAdd d).eq
  case bc b c => exact (B_C J κ hJ b c.toAdd).eq
  case ca c a => exact C_A J κ hκ hJ a.toAdd c.toAdd
  case bd b d => exact B_D J κ hJ b d
  case ba b a => exact B_A J κ hκ hJ a.toAdd b
  case ha k a =>
    change h J κ hκ hJ k*A J κ hκ hJ a.toAdd*(h J κ hκ hJ k)⁻¹=_
    rw [FiveTorus.h_A,mul_assoc,mul_inv_cancel,mul_one]
    rfl
  case hd k d =>
    change h J κ hκ hJ k*D J hJ d*(h J κ hκ hJ k)⁻¹=_
    rw [FiveTorus.h_D,mul_assoc,mul_inv_cancel,mul_one]
    rfl
  case hc k c =>
    change h J κ hκ hJ k*C J hJ c.toAdd*(h J κ hκ hJ k)⁻¹=_
    rw [FiveTorus.h_C,mul_assoc,mul_inv_cancel,mul_one]
    rfl
  case hb k b =>
    change h J κ hκ hJ k*B J hJ b*(h J κ hκ hJ k)⁻¹=_
    rw [FiveTorus.h_B,mul_assoc,mul_inv_cancel,mul_one]
    rfl
  case ss => exact (FiveBruhat.reflectionLaws J κ hκ hJ).ss
  case tt => exact (FiveBruhat.reflectionLaws J κ hκ hJ).tt
  case st => exact st_four J κ hκ hJ
  case sh k => exact s_h J κ hκ hJ k
  case th k => exact t_h J κ hκ hJ k
  case sd d => exact flip (FiveBruhat.reflectionLaws J κ hκ hJ).ss (s_B J κ hκ hJ d)
  case sc c => exact s_C J κ hκ hJ c.toAdd
  case sb b => exact s_B J κ hκ hJ b
  case ta a => exact t_A J κ hκ hJ a.toAdd
  case td d => exact t_D J κ hκ hJ d
  case tc c => exact flip (FiveBruhat.reflectionLaws J κ hκ hJ).tt (t_A J κ hκ hJ c.toAdd)
  case sa a ha => exact FiveBruhat.s_A J κ hκ hJ a.toAdd (by simpa using ha)
  case tb b hb => exact FiveBruhat.t_B J κ hκ hJ b (FiveBruhat.snd_ne_zero J hb)

theorem model_roots : (model_satisfies J κ hκ hJ).roots=roots J κ hκ hJ :=
  (parameters J).roots_ofMaps (r := roots J κ hκ hJ) (h := h J κ hκ hJ)
    (s := s J κ hκ hJ) (t := t J κ hκ hJ) (model_satisfies J κ hκ hJ)

theorem model_torus : (model_satisfies J κ hκ hJ).torus=h J κ hκ hJ :=
  (parameters J).torus_ofMaps (r := roots J κ hκ hJ) (h := h J κ hκ hJ)
    (s := s J κ hκ hJ) (t := t J κ hκ hJ) (model_satisfies J κ hκ hJ)

/-- Evaluation into the original five-dimensional special-unitary carrier. -/
def evaluate : (parameters J).Carrier →* J.specialSubgroup :=
  (parameters J).evaluate (model_satisfies J κ hκ hJ)

/-- The full nonabelian Hermitian root presentation evaluates faithfully. -/
theorem evaluate_injective : Function.Injective (evaluate J κ hκ hJ) := by
  apply (parameters J).evaluate_injective (model_satisfies J κ hκ hJ)
  · rw [model_roots,model_torus]
    exact FiveCells.borel_coordinates_injective J κ hκ hJ
  · intro w hw
    apply (FiveCells.weyl_mem_borel_iff J κ hκ hJ w).mp
    exact hw
end Theory.SpecificGroups.ClassicalUnitary.RankTwoPresentation.FivePresentation
