module

public import Theory.SpecificGroups.ClassicalUnitary.SixDimensionalBinaryGeometry
public import Mathlib.LinearAlgebra.Matrix.SchurComplement

/-!
# Explicit unitary transvections for U₆(2)

For an isotropic vector `v`, the matrix `I + v vᴴ` sends `x` to
`x + (vᴴ x) v`. Its rank-one summand squares to zero and is self-adjoint,
so the matrix is an involutory isometry in characteristic two. The matrix
determinant lemma gives determinant one. Every nonzero GF(4) scalar has
Hermitian norm one, so the matrix depends only on the projective point.

We define the subgroup generated by these projective matrices and its
permutation image on isotropic lines with an additional fixed point. Their
generation of all of U₆(2), and comparison with the ATLAS Fi22 centralizer,
are separate theorems, not assumptions in the definitions.

Application: the unitary quotient in GLS3 Table 5.3t
(`refs/KGroup/GLS3/Chapter5(sec3-).tex`). This module supplies the explicit
matrix family used in the action comparison, without asserting that source
identification.
-/

@[expose] public section

open Matrix
open scoped MatrixGroups LinearAlgebra.Projectivization
namespace Theory.SpecificGroups.U6Two

/-- The rank-one perturbation `I + v vᴴ` of the identity. -/
noncomputable def transvectionMatrix (v : Vector) : Matrix (Fin 6) (Fin 6) Field :=
  1 + vecMulVec v (fun i => conjugation (v i))

/-- The vector action of the displayed matrix. -/
theorem transvectionMatrix_mulVec (v x : Vector) :
    transvectionMatrix v *ᵥ x = x + ((fun i => conjugation (v i)) ⬝ᵥ x) • v := by
  simp [transvectionMatrix, add_mulVec, vecMulVec_mulVec]

/-- Nonzero rescaling does not change this matrix over GF(4). -/
theorem transvectionMatrix_smul (c : Field) (hc : c ≠ 0) (v : Vector) :
    transvectionMatrix (c • v) = transvectionMatrix v := by
  ext i j
  simp only [transvectionMatrix, Matrix.add_apply, vecMulVec_apply, Pi.smul_apply,
    smul_eq_mul, map_mul]
  congr 1
  calc
    c * v i * (conjugation c * conjugation (v j)) =
        (conjugation c * c) * (v i * conjugation (v j)) := by ring
    _ = v i * conjugation (v j) := by rw [conjugation_mul_self_of_ne_zero c hc, one_mul]

/-- An isotropic direction gives an involution. -/
theorem transvectionMatrix_mul_self (v : Vector) (hv : hermitianNorm v = 0) :
    transvectionMatrix v * transvectionMatrix v = 1 := by
  have hN : vecMulVec v (fun i => conjugation (v i)) *
      vecMulVec v (fun i => conjugation (v i)) = 0 := by
    rw [vecMulVec_mul_vecMulVec]
    change vecMulVec v (hermitianNorm v • (fun i => conjugation (v i))) = 0
    simp [hv]
  simp only [transvectionMatrix, add_mul, mul_add, one_mul, mul_one, hN, add_zero, add_assoc]
  ext i j
  simp [CharTwo.add_self_eq_zero]

/-- The transvection matrix is self-adjoint. -/
theorem transvectionMatrix_adjoint (v : Vector) :
    form.conjTranspose (transvectionMatrix v) = transvectionMatrix v := by
  ext i j
  simp only [BenderSuzuki.MatrixGroups.HermitianForm.conjTranspose, transvectionMatrix,
    Matrix.add_apply, vecMulVec_apply, map_add, map_mul]
  change conjugation ((1 : Matrix (Fin 6) (Fin 6) Field) j i) +
    conjugation (v j) * conjugation (conjugation (v i)) = _
  rw [conjugation_involutive]
  by_cases hij : i = j <;> simp [Matrix.one_apply, hij, Ne.symm, mul_comm]

/-- Isotropy makes the rank-one determinant correction vanish. -/
theorem transvectionMatrix_det (v : Vector) (hv : hermitianNorm v = 0) :
    (transvectionMatrix v).det = 1 := by
  rw [transvectionMatrix, vecMulVec_eq Unit,
    Matrix.det_one_add_replicateCol_mul_replicateRow]
  change 1 + hermitianNorm v = 1
  rw [hv, add_zero]

/-- The displayed transvection as an element of the exact special unitary group. -/
noncomputable def unitaryTransvection (v : Vector) (hv : hermitianNorm v = 0) :
    form.specialSubgroup := by
  let A : GL (Fin 6) Field := ⟨transvectionMatrix v, transvectionMatrix v,
    transvectionMatrix_mul_self v hv, transvectionMatrix_mul_self v hv⟩
  refine ⟨A, (form.mem_specialSubgroup_iff A).mpr ⟨?_, ?_⟩⟩
  · change form.conjTranspose (transvectionMatrix v) * 1 * transvectionMatrix v = 1
    rw [transvectionMatrix_adjoint, mul_one, transvectionMatrix_mul_self v hv]
  · apply Units.val_injective
    simp only [Matrix.GeneralLinearGroup.val_det_apply, Units.val_one]
    exact transvectionMatrix_det v hv

/-- The underlying matrix is the displayed rank-one perturbation. -/
theorem unitaryTransvection_val (v : Vector) (hv : hermitianNorm v = 0) :
    (unitaryTransvection v hv).val.val = transvectionMatrix v := rfl

/-- The action of the special unitary element on vectors. -/
theorem unitaryTransvection_smul (v x : Vector) (hv : hermitianNorm v = 0) :
    (unitaryTransvection v hv).val • x =
      x + ((fun i => conjugation (v i)) ⬝ᵥ x) • v :=
  transvectionMatrix_mulVec v x

/-- The projective transvection associated to an isotropic line. -/
noncomputable def isotropicTransvection (p : IsotropicPoint) : Carrier :=
  project (unitaryTransvection p.val.rep p.property)

/-- A transvection can be evaluated using any nonzero isotropic representative. -/
theorem isotropicTransvection_mk (v : Vector) (hv : v ≠ 0) (hi : hermitianNorm v = 0) :
    isotropicTransvection (mkIsotropicPoint v hv hi) = project (unitaryTransvection v hi) := by
  unfold isotropicTransvection
  congr 1
  apply Subtype.ext
  apply Units.ext
  change transvectionMatrix (Projectivization.mk Field v hv).rep = transvectionMatrix v
  obtain ⟨c, hc⟩ := Projectivization.exists_smul_eq_mk_rep Field v hv
  rw [← hc]
  exact transvectionMatrix_smul c.val c.ne_zero v

/-- The subgroup generated by the specified projective transvections. -/
noncomputable def transvectionSubgroup : Subgroup Carrier :=
  Subgroup.closure (Set.range isotropicTransvection)

/-- The actual transvection permutation, fixing the additional point. -/
noncomputable def transvectionPermutation (p : IsotropicPoint) : Equiv.Perm PointWithSingleton :=
  isotropicActionWithSingleton (isotropicTransvection p)

/-- The permutation group generated by the transvection family. -/
def transvectionPermutationSubgroup : Subgroup (Equiv.Perm PointWithSingleton) :=
  Subgroup.closure (Set.range transvectionPermutation)

/-- Taking the action image commutes with generation by this family. -/
theorem transvectionSubgroup_map :
    transvectionSubgroup.map isotropicActionWithSingleton = transvectionPermutationSubgroup := by
  rw [transvectionSubgroup, MonoidHom.map_closure]
  congr 1
  exact Set.range_comp isotropicActionWithSingleton isotropicTransvection |>.symm

/-- Every transvection permutation belongs to the full unitary action image. -/
theorem transvectionPermutationSubgroup_le :
    transvectionPermutationSubgroup ≤ isotropicActionWithSingleton.range := by
  rw [transvectionPermutationSubgroup, Subgroup.closure_le]
  rintro _ ⟨p, rfl⟩
  exact ⟨isotropicTransvection p, rfl⟩

/-- Matrix-group generation implies equality of the permutation images. -/
theorem transvectionPermutationSubgroup_eq_range_of_generation
    (hgen : transvectionSubgroup = ⊤) :
    transvectionPermutationSubgroup = isotropicActionWithSingleton.range := by
  rw [← transvectionSubgroup_map, hgen, ← MonoidHom.range_eq_map]

end Theory.SpecificGroups.U6Two
