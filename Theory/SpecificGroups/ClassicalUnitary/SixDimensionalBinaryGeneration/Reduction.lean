module

public import Theory.SpecificGroups.ClassicalUnitary.SixDimensionalBinaryTransvections

/-!
# Unitary column reduction over GF(4)

In the identity Hermitian form, the transvection with direction `x + y`
exchanges orthogonal unit vectors `x` and `y`. A tail with at least four
coordinates contains a unit vector perpendicular both to a prescribed vector
and to the first coordinate vector of the tail. If a suitable zero coordinate
is unavailable, three nonzero coordinates and `1 + ω + ω² = 0` construct it.
Two transvections therefore reduce a unit column while fixing all earlier
coordinate vectors.

The subgroup used throughout is the inverse image of the specified projective
transvection subgroup under the actual map `U6Two.project`. The first two
column operations reduce generation of the exact SU₆ image to its embedded
four-dimensional special unitary block. This last block-generation assertion
is stated separately as `FourSpaceGeneration`; it is not assumed as an
instance or asserted to follow from column reduction.

Application: the matrix-generation premise for the Fi22 comparison in GLS3,
Table 5.3t (`refs/KGroup/GLS3/Chapter5(sec3-).tex`). No Fischer recognition or
simplicity assertion is used here.
-/

@[expose] public section

open Matrix
open scoped MatrixGroups
namespace Theory.SpecificGroups.U6Two.Generation

/-- The Hermitian pairing, conjugate-linear in its first variable. -/
noncomputable def pairing (x y : Vector) : Field :=
  (fun i => conjugation (x i)) ⬝ᵥ y

/-- The coordinate unit vector in the fixed six-dimensional model. -/
noncomputable def basisVector (i : Fin 6) : Vector := Pi.single i 1

/-- Special unitary matrices whose projective images are generated by transvections. -/
noncomputable def generatedSpecial : Subgroup form.specialSubgroup :=
  transvectionSubgroup.comap project

theorem pairing_self (x : Vector) : pairing x x = hermitianNorm x := rfl

theorem pairing_add_left (x y z : Vector) :
    pairing (x + y) z = pairing x z + pairing y z := by
  simp only [pairing, Pi.add_apply, map_add]
  exact add_dotProduct _ _ _

theorem pairing_add_right (x y z : Vector) :
    pairing x (y + z) = pairing x y + pairing x z := by
  exact dotProduct_add _ _ _

theorem pairing_conjugate (x y : Vector) :
    conjugation (pairing x y) = pairing y x := by
  unfold pairing dotProduct
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_mul, conjugation_involutive, mul_comm]

theorem pairing_zero_symm {x y : Vector} (h : pairing x y = 0) : pairing y x = 0 := by
  rw [← pairing_conjugate, h, map_zero]

theorem pairing_basis_left (i : Fin 6) (x : Vector) : pairing (basisVector i) x = x i := by
  have h : (fun j => conjugation (basisVector i j)) = Pi.single i 1 := by
    ext j
    simp [basisVector, Pi.single_apply]
  simp only [pairing, h, single_dotProduct, one_mul]

theorem pairing_basis_right (i : Fin 6) (x : Vector) :
    pairing x (basisVector i) = conjugation (x i) := by
  simp [pairing, basisVector, dotProduct_single]

theorem basisVector_norm (i : Fin 6) : hermitianNorm (basisVector i) = 1 := by
  rw [← pairing_self, pairing_basis_left]
  simp [basisVector]

theorem pairing_smul (A : form.specialSubgroup) (x y : Vector) :
    pairing (A.val • x) (A.val • y) = pairing x y := by
  have hA := (form.mem_specialSubgroup_iff A.val).mp A.property
  have hAA : form.conjTranspose A.val.val * A.val.val = 1 := by
    simpa only [show form.form = 1 from rfl, mul_one] using hA.1
  have hc : (fun i => conjugation ((A.val.val *ᵥ x) i)) =
      (fun i => conjugation (x i)) ᵥ* form.conjTranspose A.val.val := by
    ext i
    simp only [mulVec, vecMul, dotProduct, map_sum, map_mul,
      BenderSuzuki.MatrixGroups.HermitianForm.conjTranspose]
    apply Finset.sum_congr rfl
    intro j _
    exact mul_comm _ _
  change ((fun i => conjugation ((A.val.val *ᵥ x) i)) ⬝ᵥ (A.val.val *ᵥ y)) = _
  rw [hc, dotProduct_mulVec, vecMul_vecMul, hAA, vecMul_one]
  rfl

theorem smul_basis_coordinate_eq_zero (A : form.specialSubgroup) (i j : Fin 6)
    (hfix : A.val • basisVector i = basisVector i) (hji : j ≠ i) :
    (A.val • basisVector j) i = 0 := by
  have h := pairing_smul A (basisVector i) (basisVector j)
  rw [hfix, pairing_basis_left, pairing_basis_left] at h
  simpa [basisVector, Pi.single_apply, hji.symm] using h

theorem unitaryTransvection_mem (v : Vector) (hv : hermitianNorm v = 0) :
    unitaryTransvection v hv ∈ generatedSpecial := by
  change project (unitaryTransvection v hv) ∈ transvectionSubgroup
  by_cases hz : v = 0
  · subst v
    have ht : unitaryTransvection 0 hv = 1 := by
      apply Subtype.ext
      apply Units.ext
      change transvectionMatrix 0 = 1
      simp [transvectionMatrix]
    rw [ht, map_one]
    exact transvectionSubgroup.one_mem
  · rw [← isotropicTransvection_mk v hz hv]
    exact Subgroup.subset_closure ⟨mkIsotropicPoint v hz hv, rfl⟩

theorem sum_isotropic_of_orthogonal_unit {x y : Vector}
    (hx : hermitianNorm x = 1) (hy : hermitianNorm y = 1)
    (hxy : pairing x y = 0) : hermitianNorm (x + y) = 0 := by
  rw [← pairing_self, pairing_add_left, pairing_add_right, pairing_add_right,
    pairing_self, pairing_self, hx, hy, hxy, pairing_zero_symm hxy]
  simp [CharTwo.add_self_eq_zero]

theorem transvection_exchanges_orthogonal_unit {x y : Vector}
    (hx : hermitianNorm x = 1) (hy : hermitianNorm y = 1)
    (hxy : pairing x y = 0) :
    (unitaryTransvection (x + y) (sum_isotropic_of_orthogonal_unit hx hy hxy)).val • x = y := by
  rw [unitaryTransvection_smul]
  change x + pairing (x + y) x • (x + y) = y
  rw [pairing_add_left, pairing_self, hx, pairing_zero_symm hxy, add_zero, one_smul]
  ext i
  change x i + (x i + y i) = y i
  rw [← add_assoc, CharTwo.add_self_eq_zero, zero_add]

theorem transvection_fixes_basis {v : Vector} (hv : hermitianNorm v = 0)
    (i : Fin 6) (hi : v i = 0) :
    (unitaryTransvection v hv).val • basisVector i = basisVector i := by
  rw [unitaryTransvection_smul]
  change basisVector i + pairing v (basisVector i) • v = basisVector i
  rw [pairing_basis_right, hi, map_zero, zero_smul, add_zero]

/-- Two transvections move a unit vector through a common orthogonal unit vector. -/
theorem reduction_of_perpendicular (i : Fin 6) (x y : Vector)
    (hx : hermitianNorm x = 1) (hy : hermitianNorm y = 1)
    (hxy : pairing x y = 0) (hyi : y i = 0)
    (hxprev : ∀ j : Fin 6, j.val < i.val → x j = 0)
    (hyprev : ∀ j : Fin 6, j.val < i.val → y j = 0) :
    ∃ A : form.specialSubgroup, A ∈ generatedSpecial ∧
      (∀ j : Fin 6, j.val < i.val → A.val • basisVector j = basisVector j) ∧
      A.val • x = basisVector i := by
  have hye : pairing y (basisVector i) = 0 := by rw [pairing_basis_right, hyi, map_zero]
  let T := unitaryTransvection (x + y) (sum_isotropic_of_orthogonal_unit hx hy hxy)
  let S := unitaryTransvection (y + basisVector i)
    (sum_isotropic_of_orthogonal_unit hy (basisVector_norm i) hye)
  refine ⟨S * T, generatedSpecial.mul_mem (unitaryTransvection_mem _ _)
    (unitaryTransvection_mem _ _), ?_, ?_⟩
  · intro j hj
    have hji : j ≠ i := by intro h; subst j; exact (Nat.lt_irrefl _ hj)
    have hT : T.val • basisVector j = basisVector j :=
      transvection_fixes_basis _ j (by simp only [Pi.add_apply, hxprev j hj, hyprev j hj, add_zero])
    have hS : S.val • basisVector j = basisVector j :=
      transvection_fixes_basis _ j (by simp [basisVector, hyprev j hj, hji])
    rw [Subgroup.coe_mul, mul_smul, hT, hS]
  · rw [Subgroup.coe_mul, mul_smul]
    change S.val • (T.val • x) = _
    rw [show T.val • x = y from transvection_exchanges_orthogonal_unit hx hy hxy]
    exact transvection_exchanges_orthogonal_unit hy (basisVector_norm i) hye

private theorem exists_primitive_scalar :
    ∃ w : Field, w ≠ 0 ∧ w ≠ 1 ∧ 1 + w + w ^ 2 = 0 := by
  classical
  let := Fintype.ofFinite Field
  obtain ⟨w, hw0, hw1⟩ : ∃ w : Field, w ≠ 0 ∧ w ≠ 1 := by
    by_contra h
    push Not at h
    have hs : (Finset.univ : Finset Field) ⊆ {0, 1} := by
      intro c _
      by_cases hc : c = 0
      · simp [hc]
      · simp [h c hc]
    have hc := Finset.card_le_card hs
    have hcard : Fintype.card Field = 4 := by
      simpa only [Nat.card_eq_fintype_card] using field_card
    simp [hcard] at hc
  refine ⟨w, hw0, hw1, ?_⟩
  have hp : w ^ 3 = 1 := by
    simpa only [conjugation_apply, ← pow_succ] using conjugation_mul_self_of_ne_zero w hw0
  have hz : (w - 1) * (1 + w + w ^ 2) = 0 := by
    calc
      _ = w ^ 3 - 1 := by ring
      _ = 0 := by rw [hp, sub_self]
  exact (mul_eq_zero.mp hz).resolve_left (sub_ne_zero.mpr hw1)

/-- In each tail of dimension at least four there is a common perpendicular
unit vector to a given unit vector and the first coordinate vector of the tail. -/
theorem exists_perpendicular_unit (i : Fin 6) (hi : i.val < 3) (x : Vector) :
    ∃ y : Vector, hermitianNorm y = 1 ∧ pairing x y = 0 ∧ y i = 0 ∧
      ∀ j : Fin 6, j.val < i.val → y j = 0 := by
  classical
  by_cases hz : ∃ j : Fin 6, i.val ≤ j.val ∧ j ≠ i ∧ x j = 0
  · obtain ⟨j, hij, hji, hxj⟩ := hz
    refine ⟨basisVector j, basisVector_norm j, ?_, ?_, ?_⟩
    · rw [pairing_basis_right, hxj, map_zero]
    · simp [basisVector, hji.symm]
    · intro k hk
      have hkj : k ≠ j := by intro h; subst k; omega
      simp [basisVector, hkj]
  · have hn (j : Fin 6) (hj : i.val < j.val) : x j ≠ 0 := by
      intro hxj
      apply hz
      exact ⟨j, Nat.le_of_lt hj, (fun h => by subst j; omega), hxj⟩
    have hx3 : x 3 ≠ 0 := hn 3 (by omega)
    have hx4 : x 4 ≠ 0 := hn 4 (by omega)
    have hx5 : x 5 ≠ 0 := hn 5 (by omega)
    obtain ⟨w, hw0, _, hw⟩ := exists_primitive_scalar
    let y : Vector := Pi.single 3 (x 3) + Pi.single 4 (w * x 4) +
      Pi.single 5 (w ^ 2 * x 5)
    have hy3 : y 3 ≠ 0 := by simpa [y] using hx3
    have hy4 : y 4 ≠ 0 := by simpa [y] using mul_ne_zero hw0 hx4
    have hy5 : y 5 ≠ 0 := by simpa [y] using mul_ne_zero (pow_ne_zero 2 hw0) hx5
    have hy0 : y 0 = 0 := by simp [y]
    have hy1 : y 1 = 0 := by simp [y]
    have hy2 : y 2 = 0 := by simp [y]
    refine ⟨y, ?_, ?_, ?_, ?_⟩
    · simp only [hermitianNorm, dotProduct, Fin.sum_univ_succ]
      change conjugation (y 0) * y 0 + (conjugation (y 1) * y 1 +
        (conjugation (y 2) * y 2 + (conjugation (y 3) * y 3 +
        (conjugation (y 4) * y 4 + (conjugation (y 5) * y 5 + 0))))) = 1
      rw [hy0, hy1, hy2, conjugation_mul_self_of_ne_zero _ hy3,
        conjugation_mul_self_of_ne_zero _ hy4, conjugation_mul_self_of_ne_zero _ hy5]
      simp [CharTwo.add_self_eq_zero]
    · simp only [pairing, y, dotProduct_add, dotProduct_single]
      have h3 := conjugation_mul_self_of_ne_zero _ hx3
      have h4 := conjugation_mul_self_of_ne_zero _ hx4
      have h5 := conjugation_mul_self_of_ne_zero _ hx5
      calc
        _ = conjugation (x 3) * x 3 + w * (conjugation (x 4) * x 4) +
            w ^ 2 * (conjugation (x 5) * x 5) := by ring
        _ = 0 := by rw [h3, h4, h5, mul_one, mul_one, hw]
    · have hin : i = 0 ∨ i = 1 ∨ i = 2 := by omega
      rcases hin with rfl | rfl | rfl <;> assumption
    · intro j hj
      have hjn : j = 0 ∨ j = 1 ∨ j = 2 := by omega
      rcases hjn with rfl | rfl | rfl <;> assumption

/-- The two column operations needed before reaching the four-dimensional block. -/
def UnitVectorReduction : Prop :=
  ∀ (i : Fin 6), i.val < 2 → ∀ x : Vector, hermitianNorm x = 1 →
    (∀ j : Fin 6, j.val < i.val → x j = 0) →
    ∃ A : form.specialSubgroup, A ∈ generatedSpecial ∧
      (∀ j : Fin 6, j.val < i.val → A.val • basisVector j = basisVector j) ∧
      A.val • x = basisVector i

/-- The required unit-vector reduction is realized by two explicit transvections. -/
theorem unitVectorReduction : UnitVectorReduction := by
  intro i hi x hx hxprev
  obtain ⟨y, hy, hxy, hyi, hyprev⟩ := exists_perpendicular_unit i (by omega) x
  exact reduction_of_perpendicular i x y hx hy hxy hyi hxprev hyprev

/-- Generation of the literal embedded SU₄, fixing the first two basis vectors. -/
def FourSpaceGeneration : Prop :=
  ∀ A : form.specialSubgroup,
    A.val • basisVector 0 = basisVector 0 →
    A.val • basisVector 1 = basisVector 1 → A ∈ generatedSpecial

end Theory.SpecificGroups.U6Two.Generation
