module
public import Theory.SpecificGroups.ClassicalUnitary.SmallCompletion.FourRootRigidity
public import Theory.SpecificGroups.ClassicalUnitary.UnitaryFourPointGeometry

/-!
# Native root, Cartan and Weyl generation in Hermitian four-space

The point radical is an explicit word in the two simple roots and their
marked Weyl conjugates. The middle SL₂ quotient then recovers every upper
unipotent. The literal diagonal torus accounts for the full Borel quotient;
local point-cell maximality and the coordinate swaps give all of SU₄.
Projection gives rigidity of automorphisms fixing these native generators.

This supplies the generation step of the Cartan route in Aschbacher–Smith
F.4.10,16–17, printed pp.279,282–283. No abstract BN-pair recognition or
automorphism classification is assumed.
-/

@[expose] public noncomputable section
open Matrix Subgroup BenderSuzuki.MatrixGroups
namespace Theory.SpecificGroups.ClassicalUnitary.SmallCompletion.FourRootGeneration
open UnitaryFourFlag UnitaryFourGeneration UnitaryFourSylow UnitaryFourPointLocal
open UnitaryFourPointQuotient FourRoots FourRootRigidity
variable (F : Type*) [Field F] [Finite F] [CharP F 2]
variable (σ : F ≃+* F) (hσ : Function.Involutive σ)
local notation "J" => form F σ hσ
local notation "K" => FixedField F σ
local notation "B" => borelSU F J
local notation "P" => pointParabolicSU F J
local notation "U" => upper F σ hσ

private theorem radical_word (c : RadicalCoordinates F σ) :
    radicalElement F σ hσ c =
      shortRoot F σ hσ c.y *
        (middleSwap F σ hσ*shortRoot F σ hσ c.x*(middleSwap F σ hσ)⁻¹)*
        (pairSwap F σ hσ*longRoot F σ hσ (radicalParametersEquiv F σ hσ c).2.2*
          (pairSwap F σ hσ)⁻¹) := by
  have hs : (middleSwap F σ hσ)⁻¹=middleSwap F σ hσ :=
    inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using FourCartan.middleSwap_sq F σ hσ)
  have ht : (pairSwap F σ hσ)⁻¹=pairSwap F σ hσ :=
    inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using FourCartan.pairSwap_sq F σ hσ)
  rw [hs,ht]
  apply Subtype.ext
  apply Units.ext
  change (radicalElement F σ hσ c).val.val=
    (shortRoot F σ hσ c.y).val.val *
      ((middleSwap F σ hσ).val.val*(shortRoot F σ hσ c.x).val.val*(middleSwap F σ hσ).val.val)*
      ((pairSwap F σ hσ).val.val*(leviSL F σ hσ _).val.val.val*(pairSwap F σ hσ).val.val)
  rw [leviSL_val]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [shortRoot,radicalElement,radicalMatrix,middleSwap,pairSwap,involutionElement,
      middleSwapMatrix,pairSwapMatrix,leviMatrix,SpecialLinearGroup.upperUnipotentHom,
      SpecialLinearGroup.transvection_coe,radicalParametersEquiv,Matrix.mul_apply,
      Fin.sum_univ_succ,add_assoc,mul_comm,CharTwo.add_self_eq_zero]

/-- The actual upper Sylow is generated by the two simple roots and their
conjugates under the two marked reflections. -/
theorem upper_le (H : Subgroup (SU F J))
    (hr : ∀ x : F, shortRoot F σ hσ x∈H)
    (hl : ∀ x : K, longRoot F σ hσ x∈H)
    (hs : middleSwap F σ hσ∈H) (ht : pairSwap F σ hσ∈H) : U ≤ H := by
  have hR (c : RadicalCoordinates F σ) : radicalElement F σ hσ c∈H := by
    rw [radical_word]
    exact H.mul_mem (H.mul_mem (hr _) (H.mul_mem (H.mul_mem hs (hr _)) (H.inv_mem hs)))
      (H.mul_mem (H.mul_mem ht (hl _)) (H.inv_mem ht))
  rintro g ⟨u,hu,rfl⟩
  obtain ⟨t,ht⟩ := (SpecialLinearGroup.mem_upperUnipotent K _).mp hu
  let v := leviSL F σ hσ (SpecialLinearGroup.upperUnipotentHom K (Multiplicative.ofAdd t))
  have hv : middleSL F σ hσ v=middleSL F σ hσ u := by
    rw [middleSL_leviSL]
    exact ht
  have hrad : u*v⁻¹∈radical F σ hσ := by
    rw [←middleSL_ker]
    change middleSL F σ hσ (u*v⁻¹)=1
    rw [map_mul,map_inv,hv,mul_inv_cancel]
  obtain ⟨c,hc⟩ := (radicalCoordinatesEquiv F σ hσ).surjective ⟨u*v⁻¹,hrad⟩
  have he : radicalElement F σ hσ c=u.val*v.val⁻¹ :=
    congrArg (fun r : radical F σ hσ => r.val.val) hc
  have heq : u.val=radicalElement F σ hσ c*v.val := by rw [he]; group
  change u.val∈H
  rw [heq]
  exact H.mul_mem (hR c) (hl t)

/-- Upper unipotents and all native diagonal matrices generate the whole Borel. -/
theorem borel_le_of_upper_and_diagonal (H : Subgroup (SU F J)) (hU : U≤H)
    (hD : ∀ g, FourDiagonal.IsDiagonal F σ hσ g → g∈H) : B≤H := by
  intro g hg
  let b : B := ⟨g,hg⟩
  let a : Fˣ := (torusCharacter F σ hσ b).1
  let k : Kˣ := (torusCharacter F σ hσ b).2
  let t : B := ⟨shortTorus F σ hσ (Units.map σ.toMonoidHom a),
    FourDiagonal.mem_borel F σ hσ _ ⟨_,shortTorus_val F σ hσ _⟩⟩
  let d : B := t*FourFixed.torus F σ hσ 1 k
  have hd : FourDiagonal.IsDiagonal F σ hσ d.val := by
    change ∃ z, (shortTorus F σ hσ (Units.map σ.toMonoidHom a)).val.val*
      (FourFixed.torus F σ hσ 1 k).val.val.val=Matrix.diagonal z
    rw [shortTorus_val,FourFixed.torus_val,Matrix.diagonal_mul_diagonal]
    exact ⟨_,rfl⟩
  have hchar : torusCharacter F σ hσ d=torusCharacter F σ hσ b := by
    apply Prod.ext
    · apply Units.ext
      rw [torusCharacter_fst_val]
      change (t.val.val.val*(FourFixed.torus F σ hσ 1 k).val.val.val) 0 0=(a:F)
      dsimp only [t]
      rw [shortTorus_val,FourFixed.torus_val]
      simp [hσ (a:F)]
    · apply Units.ext
      apply Subtype.ext
      rw [torusCharacter_snd_val]
      change (t.val.val.val*(FourFixed.torus F σ hσ 1 k).val.val.val) 0 0*
        (t.val.val.val*(FourFixed.torus F σ hσ 1 k).val.val.val) 1 1=((k:K):F)
      dsimp only [t]
      rw [shortTorus_val,FourFixed.torus_val]
      simp [hσ (a:F),a.ne_zero]
  have hu : g*d.val⁻¹∈U := by
    have hk : b*d⁻¹∈(torusCharacter F σ hσ).ker := by
      change torusCharacter F σ hσ (b*d⁻¹)=1
      rw [map_mul,map_inv,hchar,mul_inv_cancel]
    rw [torusCharacter_ker] at hk
    exact hk
  have he : g=(g*d.val⁻¹)*d.val := by group
  rw [he]
  exact H.mul_mem (hU hu) (hD _ hd)

/-- The literal simple roots, Cartan and marked Weyl elements generate SU₄. -/
theorem eq_top (H : Subgroup (SU F J))
    (hr : ∀ x : F, shortRoot F σ hσ x∈H)
    (hl : ∀ x : K, longRoot F σ hσ x∈H)
    (hs : middleSwap F σ hσ∈H) (ht : pairSwap F σ hσ∈H)
    (hD : ∀ g, FourDiagonal.IsDiagonal F σ hσ g → g∈H) : H=⊤ := by
  have hB : B≤H := borel_le_of_upper_and_diagonal F σ hσ H (upper_le F σ hσ H hr hl hs ht) hD
  have hP : P≤H := by
    have hb : (B).subgroupOf P≤H.subgroupOf P := fun _ hx => hB hx
    have hn : H.subgroupOf P≠(B).subgroupOf P := by
      intro he
      have hh : (⟨middleSwap F σ hσ,middleSwap_mem_point F σ hσ⟩ : P)∈H.subgroupOf P := hs
      rw [he] at hh
      exact middleSwap_not_mem_plane F σ hσ hh.2
    have he := (UnitaryFourPointGeometry.borel_subgroupOf_point_isCoatom F σ hσ).ne_iff_eq_top hb
    exact Subgroup.subgroupOf_eq_top.mp (he.mp hn)
  exact eq_top_of_point_and_pairSwap F σ hσ H hP ht

/-- Pointwise Cartan, root and Weyl fixation determines the native projective automorphism. -/
theorem projective_aut_eq_one (a : MulAut (PSU F J))
    (hr : ∀ x : F, a (project F J (shortRoot F σ hσ x))=project F J (shortRoot F σ hσ x))
    (hl : ∀ x : K, a (project F J (longRoot F σ hσ x))=project F J (longRoot F σ hσ x))
    (hs : a (project F J (middleSwap F σ hσ))=project F J (middleSwap F σ hσ))
    (ht : a (project F J (pairSwap F σ hσ))=project F J (pairSwap F σ hσ))
    (hD : ∀ g, FourDiagonal.IsDiagonal F σ hσ g → a (project F J g)=project F J g) : a=1 := by
  let H : Subgroup (SU F J) := (a.toMonoidHom.comp (project F J)).eqLocus (project F J)
  have hH : H=⊤ := eq_top F σ hσ H hr hl hs ht hD
  apply DFunLike.ext
  intro b
  change a b=b
  obtain ⟨g,rfl⟩ := project_surjective F J b
  have hg : g∈H := hH ▸ Subgroup.mem_top g
  exact hg
end Theory.SpecificGroups.ClassicalUnitary.SmallCompletion.FourRootGeneration
