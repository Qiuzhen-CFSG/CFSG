module

public import Theory.SpecificGroups.ClassicalUnitary.StandardForm
public import Mathlib.Algebra.Module.Submodule.Pointwise
public import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.Tactic.FinCases
public import Mathlib.Algebra.Pointwise.Stabilizer

/-!
# An explicit isotropic flag for the five-dimensional unitary group

Over a field of characteristic two with the identity Hermitian matrix, the
vectors `(a,a,b,b,0)` form a totally isotropic plane. Its line `b = 0` gives
an explicit flag of dimensions one and two. We define the two projective
parabolics as the images of the exact special-unitary stabilizers in PGL.

The finite-field existence lemma uses the Frobenius involution on a field
of order `q²`; here `q` is the fixed-field parameter. No rank, Levi-factor,
or unipotent-radical calculation is assumed or claimed in this construction.

Source: the standard isotropic-subspace construction of unitary parabolics,
GLS3, §2.7; Aschbacher--Smith, *The Classification of Quasithin Groups*,
A.2.18 and F.1.12(7), printed pp. 40 and 263--264.
-/

@[expose] public section

open BenderSuzuki.MatrixGroups Matrix
open scoped Pointwise

namespace Theory.SpecificGroups.UnitaryFive

/-- Identity Hermitian matrix for a specified involution. -/
def identityForm {F : Type*} [Field F] (σ : F ≃+* F)
    (hσ : Function.Involutive σ) : HermitianForm 5 F where
  conj := σ
  conj_involutive := hσ
  form := 1
  form_hermitian := by
    intro i j
    by_cases h : i = j <;> simp [Matrix.one_apply, h, Ne.symm]
  form_nondegenerate := by simp

/-- An actual matrix field and identity Hermitian form for every even prime power. -/
theorem exists_field (q : ℕ) (hq : IsPrimePow q) (heven : Even q) :
    ∃ (F : Type) (_ : Field F) (_ : Finite F) (_ : CharP F 2)
      (J : HermitianForm 5 F),
      Nat.card F = q ^ 2 ∧ (∀ x, J.conj x = x ^ q) ∧ J.form = 1 := by
  obtain ⟨p, e, hp, he, hq⟩ := (isPrimePow_nat_iff q).mp hq
  have htwo : 2 = p := Nat.prime_eq_prime_of_dvd_pow Nat.prime_two hp
    (hq ▸ even_iff_two_dvd.mp heven)
  subst p
  let F := GaloisField 2 (e * 2)
  let : Fintype F := Fintype.ofFinite F
  have hcard : Nat.card F = q ^ 2 := by
    rw [GaloisField.card 2 (e * 2) (by omega), pow_mul, hq]
  let σ : F ≃+* F := iterateFrobeniusEquiv F 2 e
  have hσ (x : F) : σ x = x ^ q := by
    change x ^ (2 ^ e) = x ^ q
    rw [hq]
  have hinv : Function.Involutive σ := by
    intro x
    rw [hσ, hσ, ← pow_mul, ← pow_two, ← hcard, Nat.card_eq_fintype_card]
    exact FiniteField.pow_card x
  exact ⟨F, inferInstance, inferInstance, inferInstance, identityForm σ hinv,
    hcard, hσ, rfl⟩

variable (F : Type*) [Field F]

/-- The line generated by `(1,1,0,0,0)`. -/
def line : Submodule F (Fin 5 → F) where
  carrier := {v | v 1 = v 0 ∧ v 2 = 0 ∧ v 3 = 0 ∧ v 4 = 0}
  zero_mem' := by simp
  add_mem' := by rintro x y ⟨h1,h2,h3,h4⟩ ⟨k1,k2,k3,k4⟩; simp_all
  smul_mem' := by rintro c x ⟨h1,h2,h3,h4⟩; simp_all

/-- The plane generated by `(1,1,0,0,0)` and `(0,0,1,1,0)`. -/
def plane : Submodule F (Fin 5 → F) where
  carrier := {v | v 1 = v 0 ∧ v 3 = v 2 ∧ v 4 = 0}
  zero_mem' := by simp
  add_mem' := by rintro x y ⟨h1,h2,h3⟩ ⟨k1,k2,k3⟩; simp_all
  smul_mem' := by rintro c x ⟨h1,h2,h3⟩; simp_all

/-- The two subspaces form a flag. -/
theorem line_le_plane : line F ≤ plane F := by
  rintro v ⟨h1,h2,h3,h4⟩
  exact ⟨h1, h3.trans h2.symm, h4⟩

/-- The first coordinate parametrizes the chosen line. -/
def lineEquiv : line F ≃ₗ[F] F where
  toFun v := v.val 0
  invFun a := ⟨![a,a,0,0,0], by simp [line]⟩
  left_inv v := by
    apply Subtype.ext
    funext i
    have h := v.property
    change v.val 1 = v.val 0 ∧ v.val 2 = 0 ∧ v.val 3 = 0 ∧ v.val 4 = 0 at h
    fin_cases i <;> simp_all
  right_inv a := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The first and third coordinates parametrize the chosen plane. -/
def planeEquiv : plane F ≃ₗ[F] (Fin 2 → F) where
  toFun v := ![v.val 0, v.val 2]
  invFun a := ⟨![a 0,a 0,a 1,a 1,0], by simp [plane]⟩
  left_inv v := by
    apply Subtype.ext
    funext i
    have h := v.property
    change v.val 1 = v.val 0 ∧ v.val 3 = v.val 2 ∧ v.val 4 = 0 at h
    fin_cases i <;> simp_all
  right_inv a := by funext i; fin_cases i <;> rfl
  map_add' _ _ := by ext i; fin_cases i <;> rfl
  map_smul' _ _ := by ext i; fin_cases i <;> rfl

/-- The smaller flag member has dimension one. -/
theorem finrank_line : Module.finrank F (line F) = 1 := by
  rw [(lineEquiv F).finrank_eq]; simp

/-- The larger flag member has dimension two. -/
theorem finrank_plane : Module.finrank F (plane F) = 2 := by
  rw [(planeEquiv F).finrank_eq]; simp

/-- Coordinate form of total isotropy in characteristic two. -/
theorem plane_isotropic [CharP F 2] (σ : F ≃+* F)
    (v w : plane F) : ∑ i, σ (v.val i) * w.val i = 0 := by
  have hv := v.property
  have hw := w.property
  change v.val 1 = v.val 0 ∧ v.val 3 = v.val 2 ∧ v.val 4 = 0 at hv
  change w.val 1 = w.val 0 ∧ w.val 3 = w.val 2 ∧ w.val 4 = 0 at hw
  simp [Fin.sum_univ_succ, hv.1, hv.2.1, hv.2.2, hw.1, hw.2.1, hw.2.2,
    CharTwo.add_self_eq_zero]

/-- Total isotropy for the actual stored identity Hermitian matrix. -/
theorem plane_totallyIsotropic [CharP F 2] (J : HermitianForm 5 F)
    (hJ : J.form = 1) (v w : plane F) :
    dotProduct (fun i => J.conj (v.val i)) (J.form.mulVec w.val) = 0 := by
  rw [hJ, Matrix.one_mulVec]
  exact plane_isotropic F J.conj v w

variable {F}

/-- The canonical surjection from SU to its image in PGL. -/
def project (J : HermitianForm 5 F) : J.specialSubgroup →*
    ProjectiveSpecialUnitaryMatrixGroup J :=
  (Matrix.ProjGenLinGroup.mk.comp J.specialSubgroup.subtype).codRestrict _
    (fun a => ⟨a.val, a.property, rfl⟩)

/-- The natural matrix action of SU on the vector space. -/
def linearAction (J : HermitianForm 5 F) : J.specialSubgroup →*
    ((Fin 5 → F) ≃ₗ[F] (Fin 5 → F)) :=
  ((LinearMap.GeneralLinearGroup.generalLinearEquiv F (Fin 5 → F)).toMonoidHom.comp
    Matrix.GeneralLinearGroup.toLin.toMonoidHom).comp J.specialSubgroup.subtype

/-- Exact stabilizer of a subspace inside the special unitary group. -/
def specialStabilizer (J : HermitianForm 5 F) (W : Submodule F (Fin 5 → F)) :
    Subgroup J.specialSubgroup :=
  (MulAction.stabilizer ((Fin 5 → F) ≃ₗ[F] (Fin 5 → F)) W).comap (linearAction J)

/-- Stabilizer membership is the usual preservation condition on matrix vectors. -/
theorem mem_specialStabilizer_iff (J : HermitianForm 5 F)
    (W : Submodule F (Fin 5 → F)) (A : J.specialSubgroup) :
    A ∈ specialStabilizer J W ↔
      ∀ v, (A.val : Matrix (Fin 5) (Fin 5) F) *ᵥ v ∈ W ↔ v ∈ W := by
  change linearAction J A ∈ MulAction.stabilizer _ W ↔ _
  rw [Submodule.stabilizer_coe, MulAction.mem_stabilizer_set]
  rfl

/-- Projective image of a subspace stabilizer; isotropic lines and planes give parabolics. -/
def parabolic (J : HermitianForm 5 F) (W : Submodule F (Fin 5 → F)) :
    Subgroup (ProjectiveSpecialUnitaryMatrixGroup J) :=
  (specialStabilizer J W).map (project J)

/-- Every element of PSU has a special-unitary representative. -/
theorem project_surjective (J : HermitianForm 5 F) :
    Function.Surjective (project J) := by
  rintro ⟨g, A, hA, rfl⟩
  exact ⟨⟨A,hA⟩, rfl⟩

/-- The projective stabilizer associated to the chosen isotropic line. -/
def lineParabolic (J : HermitianForm 5 F) := parabolic J (line F)
/-- The projective stabilizer associated to the chosen isotropic plane. -/
def planeParabolic (J : HermitianForm 5 F) := parabolic J (plane F)

/-- Scalar special-unitary matrices fix every subspace. -/
theorem ker_project_le_specialStabilizer (J : HermitianForm 5 F)
    (W : Submodule F (Fin 5 → F)) : (project J).ker ≤ specialStabilizer J W := by
  intro A hA
  have h : Matrix.ProjGenLinGroup.mk A.val = 1 :=
    congrArg Subtype.val (MonoidHom.mem_ker.mp hA)
  rw [Matrix.ProjGenLinGroup.mk_eq_one,
    Matrix.GeneralLinearGroup.center_eq_range_scalar] at h
  obtain ⟨u, hu⟩ := h
  rw [mem_specialStabilizer_iff]
  intro v
  rw [← hu]
  change (Matrix.diagonal (fun _ : Fin 5 => u.val)) *ᵥ v ∈ W ↔ v ∈ W
  rw [Matrix.diagonal_const_mulVec]
  exact W.smul_mem_iff u.ne_zero

/-- The common projective stabilizer is exactly the image of the common SU stabilizer. -/
theorem parabolic_inf (J : HermitianForm 5 F)
    (V W : Submodule F (Fin 5 → F)) :
    (specialStabilizer J V ⊓ specialStabilizer J W).map (project J) =
      parabolic J V ⊓ parabolic J W := by
  apply le_antisymm (Subgroup.map_inf_le _ _ _)
  rintro x ⟨⟨a, ha, hax⟩, ⟨b, hb, hbx⟩⟩
  have hab : a⁻¹ * b ∈ (project J).ker := by
    simp only [MonoidHom.mem_ker, map_mul, map_inv, hax, hbx, inv_mul_cancel]
  have hak : a⁻¹ * b ∈ specialStabilizer J W :=
    ker_project_le_specialStabilizer J W hab
  have haw : a ∈ specialStabilizer J W := by
    have h := (specialStabilizer J W).mul_mem hb ((specialStabilizer J W).inv_mem hak)
    simpa only [_root_.mul_inv_rev, inv_inv, ← mul_assoc, mul_inv_cancel, one_mul] using h
  exact ⟨a, ⟨ha, haw⟩, hax⟩

end Theory.SpecificGroups.UnitaryFive
