module

public import Theory.SpecificGroups.ClassicalUnitary.OddFundamental.CentralizerResidual.SmallGeneration

/-!
# Reduction of odd-unitary generation to norm-one vectors

Take the subgroup of the actual identity-form SUₙ generated by all homomorphic
images of its SU₂ over the same coefficient field. The checked SU₂–SL₂
comparison puts this subgroup in the defining-prime residual, including q = 3.

A special unitary matrix fixing the first coordinate vector has zero mixed
blocks and an actual SUₙ₋₁ tail. Thus transitivity of the generated subgroup
on norm-one vectors proves equality with the full matrix group by induction.
`UnitVectorReduction` states only this geometric input in dimensions at least
three. Its proof is still required; none of the conditional results below
asserts unconditional higher-dimensional generation.

Source application: Aschbacher–Smith, combined manuscript (1 March 2004),
A.2.17, printed pp.38–39 of `refs/quasithin.pdf`, the complementary SU_{N-2}(q).
-/

@[expose] public noncomputable section
open Matrix BenderSuzuki.MatrixGroups Subgroup
namespace Theory.SpecificGroups.ClassicalUnitary.OddFundamental.Generation
variable {F : Type*} [Field F] (σ : F ≃+* F) (hσ : Function.Involutive σ)

noncomputable def twoSpaceGenerated (n : ℕ) : Subgroup (form σ hσ n).specialSubgroup :=
  ⨆ f : (form σ hσ 2).specialSubgroup →* (form σ hσ n).specialSubgroup, f.range

theorem hom_mem_twoSpaceGenerated {n : ℕ}
    (f : (form σ hσ 2).specialSubgroup →* (form σ hσ n).specialSubgroup)
    (a : (form σ hσ 2).specialSubgroup) : f a ∈ twoSpaceGenerated σ hσ n :=
  (le_iSup (fun f : (form σ hσ 2).specialSubgroup →*
    (form σ hσ n).specialSubgroup => f.range) f) ⟨a, rfl⟩

theorem twoSpaceGenerated_le_primeToResidual [Finite F] {r e n : ℕ} [Fact r.Prime]
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e)) :
    twoSpaceGenerated σ hσ n ≤ primeToResidual r (form σ hσ n).specialSubgroup := by
  apply iSup_le
  intro f
  have hh := map_primeToResidual_le_of_hom r f
  rw [specialTwo_primeToResidual_eq_top σ hσ hr he hc hj, ← MonoidHom.range_eq_map] at hh
  exact hh

theorem map_twoSpaceGenerated_le {m n : ℕ}
    (f : (form σ hσ m).specialSubgroup →* (form σ hσ n).specialSubgroup) :
    (twoSpaceGenerated σ hσ m).map f ≤ twoSpaceGenerated σ hσ n := by
  rw [Subgroup.map_le_iff_le_comap]
  apply iSup_le
  intro a
  rintro _ ⟨b, rfl⟩
  exact hom_mem_twoSpaceGenerated σ hσ (f.comp a) b

def norm {n : ℕ} (x : Fin n → F) : F := ∑ i, σ (x i) * x i

theorem norm_mulVec {n : ℕ} (a : (form σ hσ n).specialSubgroup) (x : Fin n → F) :
    norm σ (a.val.val *ᵥ x) = norm σ x := by
  have hu : (form σ hσ n).conjTranspose a.val.val * a.val.val = 1 := by
    simpa [form] using a.property.1
  have hc : (fun i => σ ((a.val.val *ᵥ x) i)) =
      (fun i => σ (x i)) ᵥ* (form σ hσ n).conjTranspose a.val.val := by
    ext i
    simp only [mulVec, vecMul, dotProduct, map_sum, map_mul,
      HermitianForm.conjTranspose, form]
    apply Finset.sum_congr rfl
    intro j _
    exact mul_comm _ _
  change ((fun i => σ ((a.val.val *ᵥ x) i)) ⬝ᵥ (a.val.val *ᵥ x)) = _
  rw [hc, dotProduct_mulVec, vecMul_vecMul, hu, vecMul_one]
  rfl

theorem column_norm {n : ℕ} (g : (form σ hσ n).specialSubgroup) (j : Fin n) :
    norm σ (fun i => g.val.val i j) = 1 := by
  have hg := g.property.1
  change (form σ hσ n).conjTranspose g.val.val * 1 * g.val.val = 1 at hg
  rw [mul_one] at hg
  have hh := congrArg (fun M : Matrix (Fin n) (Fin n) F => M j j) hg
  simpa [norm, Matrix.mul_apply, HermitianForm.conjTranspose, form] using hh

def tailMatrix {n : ℕ} (A : Matrix (Fin n) (Fin n) F) :
    Matrix (Fin (n+1)) (Fin (n+1)) F :=
  Fin.cases (Fin.cases 1 (fun _ => 0)) (fun i => Fin.cases 0 (A i))

@[simp] theorem tailMatrix_zero_zero {n : ℕ} (A : Matrix (Fin n) (Fin n) F) :
    tailMatrix A 0 0 = 1 := rfl
@[simp] theorem tailMatrix_zero_succ {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (j : Fin n) :
    tailMatrix A 0 j.succ = 0 := rfl
@[simp] theorem tailMatrix_succ_zero {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (i : Fin n) :
    tailMatrix A i.succ 0 = 0 := rfl
@[simp] theorem tailMatrix_succ_succ {n : ℕ} (A : Matrix (Fin n) (Fin n) F) (i j : Fin n) :
    tailMatrix A i.succ j.succ = A i j := rfl

theorem tailMatrix_one (n : ℕ) : tailMatrix (1 : Matrix (Fin n) (Fin n) F) = 1 := by
  ext i j
  refine Fin.cases ?_ (fun i => ?_) i <;> refine Fin.cases ?_ (fun j => ?_) j <;>
    simp [Matrix.one_apply, eq_comm]

theorem tailMatrix_mul {n : ℕ} (A B : Matrix (Fin n) (Fin n) F) :
    tailMatrix (A * B) = tailMatrix A * tailMatrix B := by
  ext i j
  refine Fin.cases ?_ (fun i => ?_) i <;> refine Fin.cases ?_ (fun j => ?_) j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_succ]

theorem tailMatrix_adj {n : ℕ} (A : Matrix (Fin n) (Fin n) F) :
    (form σ hσ (n+1)).conjTranspose (tailMatrix A) =
      tailMatrix ((form σ hσ n).conjTranspose A) := by
  ext i j
  refine Fin.cases ?_ (fun i => ?_) i <;> refine Fin.cases ?_ (fun j => ?_) j <;>
    simp [HermitianForm.conjTranspose, form]

theorem tailMatrix_det {n : ℕ} (A : Matrix (Fin n) (Fin n) F) :
    (tailMatrix A).det = A.det := by
  rw [Matrix.det_succ_row_zero, Fin.sum_univ_succ]
  simp only [tailMatrix_zero_zero, tailMatrix_zero_succ, Fin.val_zero, pow_zero, one_mul,
    mul_zero, zero_mul, Finset.sum_const_zero, add_zero, Fin.succAbove_zero]
  rfl

noncomputable def tailEmbedding (n : ℕ) :
    (form σ hσ n).specialSubgroup →* (form σ hσ (n+1)).specialSubgroup :=
  let f : (form σ hσ n).specialSubgroup →* Matrix (Fin (n+1)) (Fin (n+1)) F :=
    { toFun := fun a => tailMatrix a.val.val
      map_one' := tailMatrix_one n
      map_mul' := fun a b => tailMatrix_mul a.val.val b.val.val }
  f.toHomUnits.codRestrict _ fun a => by
    rw [HermitianForm.mem_specialSubgroup_iff]
    constructor
    · change (form σ hσ (n+1)).conjTranspose (tailMatrix a.val.val) * 1 *
        tailMatrix a.val.val = 1
      rw [mul_one, tailMatrix_adj, ← tailMatrix_mul]
      have ha : (form σ hσ n).conjTranspose a.val.val * a.val.val = 1 := by
        simpa [form] using a.property.1
      rw [ha, tailMatrix_one]
    · apply Units.ext
      change (tailMatrix a.val.val).det = 1
      rw [tailMatrix_det]
      exact congrArg Units.val a.property.2

@[simp] theorem tailEmbedding_val {n : ℕ} (a : (form σ hσ n).specialSubgroup) :
    (tailEmbedding σ hσ n a).val.val = tailMatrix a.val.val := rfl

theorem exists_tail_of_first_column {n : ℕ} (g : (form σ hσ (n+1)).specialSubgroup)
    (hcol : ∀ i, g.val.val i 0 = if i = 0 then 1 else 0) :
    ∃ a : (form σ hσ n).specialSubgroup, tailEmbedding σ hσ n a = g := by
  classical
  have hu := g.property.1
  change (form σ hσ (n+1)).conjTranspose g.val.val * 1 * g.val.val = 1 at hu
  rw [mul_one] at hu
  have hrow (j : Fin n) : g.val.val 0 j.succ = 0 := by
    have hh := congrArg (fun M : Matrix (Fin (n+1)) (Fin (n+1)) F => M 0 j.succ) hu
    simpa [Matrix.mul_apply, HermitianForm.conjTranspose, form, hcol,
      Fin.sum_univ_succ, Matrix.one_apply, eq_comm] using hh
  let A : Matrix (Fin n) (Fin n) F := g.val.val.submatrix Fin.succ Fin.succ
  have hA : (form σ hσ n).conjTranspose A * A = 1 := by
    ext i j
    have hh := congrArg (fun M : Matrix (Fin (n+1)) (Fin (n+1)) F => M i.succ j.succ) hu
    simpa [A, Matrix.mul_apply, HermitianForm.conjTranspose, form,
      Fin.sum_univ_succ, hrow, Matrix.one_apply] using hh
  have hblock : tailMatrix A = g.val.val := by
    ext i j
    refine Fin.cases ?_ (fun i => ?_) i <;> refine Fin.cases ?_ (fun j => ?_) j <;>
      simp [A, hcol, hrow]
  let aGL : GL (Fin n) F :=
    ⟨A, (form σ hσ n).conjTranspose A, mul_eq_one_comm.mp hA, hA⟩
  have hd : A.det = 1 := by
    rw [← tailMatrix_det A, hblock]
    exact congrArg Units.val g.property.2
  let a : (form σ hσ n).specialSubgroup := ⟨aGL, by
    rw [HermitianForm.mem_specialSubgroup_iff]
    exact ⟨by simpa [form] using hA, Units.ext hd⟩⟩
  refine ⟨a, ?_⟩
  apply Subtype.ext
  apply Units.ext
  exact hblock

/-- The geometric input for dimensions at least three. -/
def UnitVectorReduction (k : ℕ) : Prop :=
  ∀ x : Fin (k+3) → F, norm σ x = 1 →
    ∃ a : (form σ hσ (k+3)).specialSubgroup,
      a ∈ twoSpaceGenerated σ hσ (k+3) ∧ a.val.val *ᵥ x = Pi.single 0 1

theorem twoSpaceGenerated_eq_top_of_reduction
    (hred : ∀ k, UnitVectorReduction σ hσ k) {n : ℕ} (hn : 0 < n) :
    twoSpaceGenerated σ hσ n = ⊤ := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | n
    · omega
    rcases n with _ | n
    · apply top_unique
      intro a _
      rw [specialOne_eq_one σ hσ a]
      exact (twoSpaceGenerated σ hσ 1).one_mem
    rcases n with _ | k
    · apply top_unique
      intro a _
      exact hom_mem_twoSpaceGenerated σ hσ (MonoidHom.id _) a
    have ht : twoSpaceGenerated σ hσ (k+2) = ⊤ :=
      ih (k+2) (by omega) (by omega)
    apply top_unique
    intro g _
    obtain ⟨a, ha, hx⟩ := hred k (fun i => g.val.val i 0) (column_norm σ hσ g 0)
    have hcol : ∀ i, (a*g).val.val i 0 = if i = 0 then 1 else 0 := by
      intro i
      have hh := congrFun hx i
      simpa [Matrix.mul_apply, Matrix.mulVec, dotProduct, Pi.single_apply, eq_comm] using hh
    obtain ⟨b, hb⟩ := exists_tail_of_first_column σ hσ (a*g) hcol
    have hbr : b ∈ twoSpaceGenerated σ hσ (k+2) := by
      rw [ht]
      trivial
    have hab := map_twoSpaceGenerated_le σ hσ (tailEmbedding σ hσ (k+2))
      (Subgroup.mem_map_of_mem _ hbr)
    rw [hb] at hab
    exact (Subgroup.mul_mem_cancel_left _ ha).mp hab

theorem special_primeToResidual_eq_top_of_reduction [Finite F] {r e : ℕ} [Fact r.Prime]
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e))
    (hred : ∀ k, UnitVectorReduction σ hσ k) {n : ℕ} (hn : 0 < n) :
    primeToResidual r (form σ hσ n).specialSubgroup = ⊤ := by
  have hh := twoSpaceGenerated_le_primeToResidual σ hσ hr he hc hj (n := n)
  rw [twoSpaceGenerated_eq_top_of_reduction σ hσ hred hn] at hh
  exact top_unique hh

end Theory.SpecificGroups.ClassicalUnitary.OddFundamental.Generation
