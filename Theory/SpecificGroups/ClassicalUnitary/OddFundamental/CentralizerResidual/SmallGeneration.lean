module

public import Theory.SpecificGroups.ClassicalUnitary.OddFundamental.ResidualSetup
public import Theory.GroupTheory.PResidual.PrimeToMonotone

/-!
# Small complementary unitary groups and residual generation

SU₁ is trivial. SU₂ over an odd quadratic field is generated by elements of
the defining prime order, by its actual comparison with SL₂ over the fixed
field. Thus both are their own prime-to-r residual, also when q = 3.

The general generation implication is applied to the literal complementary
embedding in the marked projective centralizer. Higher-dimensional generation
is a separate obligation; no perfectness assertion is used here.

Source: Aschbacher–Smith, A.2.17, printed pp.38–39 of `refs/quasithin.pdf`.
-/

public section
open Matrix BenderSuzuki.MatrixGroups Subgroup
namespace Theory.SpecificGroups.ClassicalUnitary.OddFundamental
variable {F : Type*} [Field F] (σ : F ≃+* F) (hσ : Function.Involutive σ)

/-- Every determinant-one one-dimensional matrix is the identity. -/
theorem specialOne_eq_one (a : (form σ hσ 1).specialSubgroup) : a = 1 := by
  have hd := congrArg Units.val a.property.2
  change a.val.val.det = 1 at hd
  rw [Matrix.det_fin_one] at hd
  apply Subtype.ext
  apply Units.ext
  ext i j
  have hi : i = 0 := Subsingleton.elim _ _
  have hj : j = 0 := Subsingleton.elim _ _
  subst i
  subst j
  simpa using hd

/-- The complementary dimension-one case of defining-prime generation. -/
theorem specialOne_primeToResidual_eq_top (r : ℕ) :
    primeToResidual r (form σ hσ 1).specialSubgroup = ⊤ := by
  apply top_unique
  intro a _
  rw [specialOne_eq_one σ hσ a]
  exact (primeToResidual r _).one_mem

/-- SU₂ is generated by defining-prime elements, including q = 3. -/
theorem specialTwo_primeToResidual_eq_top [Finite F] {r e : ℕ} [Fact r.Prime]
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e)) :
    primeToResidual r (form σ hσ 2).specialSubgroup = ⊤ := by
  have hq : IsPrimePow (r ^ e) := (isPrimePow_nat_iff _).mpr
    ⟨r, e, Fact.out, he, rfl⟩
  have ho : Odd (r ^ e) := ((Fact.out : r.Prime).odd_of_ne_two hr).pow
  obtain ⟨a⟩ := nonempty_specialTwoEquiv_odd σ hσ hq ho hc hj
  have hk : Nat.card (FixedBy.subfield F σ) = r ^ e :=
    (form σ hσ 2).fixed_card_prime_power hq hc hj
  let : Fintype (FixedBy.subfield F σ) := Fintype.ofFinite _
  let : CharP (FixedBy.subfield F σ) r := charP_of_card_eq_prime_pow
    (by simpa only [← Nat.card_eq_fintype_card] using hk)
  apply top_unique
  intro b _
  simpa using Matrix.SL2.map_mem_primeToResidual r a.symm.toMonoidHom (a b)

/-- Intrinsic generation puts the actual complementary image in the residual. -/
theorem complement_le_residual_of_generation {n r : ℕ}
    (hgen : primeToResidual r (form σ hσ n).specialSubgroup = ⊤) :
    (complementInCentralizer σ hσ (n := n)).range ≤ residual σ hσ r := by
  have hh := map_primeToResidual_le_of_hom r (complementInCentralizer σ hσ (n := n))
  rw [hgen, ← MonoidHom.range_eq_map] at hh
  exact hh

/-- The full complementary SU₂ lies in the marked projective residual. -/
theorem complementaryTwo_le_residual [Finite F] {r e : ℕ} [Fact r.Prime]
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e)) :
    (complementInCentralizer σ hσ (n := 2)).range ≤ residual σ hσ r :=
  complement_le_residual_of_generation σ hσ
    (specialTwo_primeToResidual_eq_top σ hσ hr he hc hj)

/-- The complementary image is trivial in dimension one. -/
theorem complementaryOne_range_eq_bot :
    (complementInCentralizer σ hσ (n := 1)).range = ⊥ := by
  apply bot_unique
  rintro _ ⟨a, rfl⟩
  rw [specialOne_eq_one σ hσ a, map_one]
  exact one_mem _

end Theory.SpecificGroups.ClassicalUnitary.OddFundamental
