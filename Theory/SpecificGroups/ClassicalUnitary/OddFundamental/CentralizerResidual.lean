module

public import Theory.SpecificGroups.ClassicalUnitary.OddFundamental.CentralizerResidual.Lifting
public import Theory.SpecificGroups.ClassicalUnitary.OddFundamental.CentralizerResidual.SmallGeneration
public import Theory.SpecificGroups.ClassicalUnitary.OddFundamental.CentralizerResidual.CoveringCharacter
public import Theory.SpecificGroups.ClassicalUnitary.OddFundamental.CentralizerResidual.Generation
public import Theory.GroupTheory.QuasithinBasic

/-!
# The unitary fundamental centralizer residual

Two independent structural facts finish the residual calculation: the covering
centralizer has a scalar character whose kernel is the complementary SUₙ,
and SUₙ is generated by defining-prime elements. The scalar character kills
the covering residual because the field-unit group has prime-to-r order.
The proved centralizer lifting then gives the upper inclusion downstairs;
intrinsic generation gives the lower inclusion on the original embedding.

The matrix calculation in `CoveringCharacter` and the plane-rotation generation
in `Generation` discharge both inputs. Thus the residual is exactly the image
of the original complementary SUₙ embedding for every n > 0, including n = 1
and q = 3. Its inverse embedding gives the actual residual–SUₙ equivalence
and transports every prime rank. The conditional assembly remains available
as a separate interface.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), A.2.17,
printed pp.38–39 of `refs/quasithin.pdf`, the unitary case of J* ≅ SLᵋ_{N-2}(q).
-/

@[expose] public noncomputable section
open Matrix BenderSuzuki.MatrixGroups Subgroup
namespace Theory.SpecificGroups.ClassicalUnitary.OddFundamental
variable {F : Type*} [Field F] (σ : F ≃+* F) (hσ : Function.Involutive σ)
variable {n : ℕ} [Finite F] {r e : ℕ} [Fact r.Prime]

omit [Finite F] in
private theorem fieldUnits_card_coprime (he : 0 < e)
    (hc : Nat.card F = (r ^ e) ^ 2) : Nat.Coprime r (Nat.card Fˣ) := by
  rw [Nat.card_units, hc, ← pow_mul]
  apply (Nat.coprime_pow_left_iff (by omega : 0 < e * 2) r _).mp
  exact (Nat.coprime_self_sub_right
    (Nat.one_le_pow _ _ (Fact.out : r.Prime).pos)).mpr (Nat.coprime_one_right _)

/-- Assemble the two structural inputs on the literal covering and projective maps. -/
theorem residual_eq_complement_of_covering_character
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e))
    (χ : coveringCentralizer σ hσ (n := n) →* Fˣ)
    (hχ : χ.ker = (complementInCoveringCentralizer σ hσ).range)
    (hgen : primeToResidual r (form σ hσ n).specialSubgroup = ⊤) :
    residual σ hσ (n := n) r = (complementInCentralizer σ hσ).range := by
  have hu : primeToResidual r (coveringCentralizer σ hσ (n := n)) ≤
      (complementInCoveringCentralizer σ hσ).range := by
    rw [← hχ]
    exact primeToResidual_le_ker χ (fieldUnits_card_coprime he hc)
  apply le_antisymm
  · rw [← map_covering_primeToResidual σ hσ hr he hc hj]
    have hm := Subgroup.map_mono (f := centralizerProjection σ hσ) hu
    rwa [← MonoidHom.range_comp, centralizerProjection_comp_complement] at hm
  · exact complement_le_residual_of_generation σ hσ hgen

/-- The resulting equivalence uses the original faithful complementary embedding. -/
def residualEquivOfCoveringCharacter
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e))
    (χ : coveringCentralizer σ hσ (n := n) →* Fˣ)
    (hχ : χ.ker = (complementInCoveringCentralizer σ hσ).range)
    (hgen : primeToResidual r (form σ hσ n).specialSubgroup = ⊤) :
    residual σ hσ (n := n) r ≃* (form σ hσ n).specialSubgroup :=
  (MulEquiv.subgroupCongr
    (residual_eq_complement_of_covering_character σ hσ hr he hc hj χ hχ hgen)).trans
    (MonoidHom.ofInjective (complementInCentralizer_injective σ hσ)).symm

/-- The inverse equivalence is precisely the marked complementary matrix map. -/
@[simp] theorem residualEquivOfCoveringCharacter_symm_coe
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e))
    (χ : coveringCentralizer σ hσ (n := n) →* Fˣ)
    (hχ : χ.ker = (complementInCoveringCentralizer σ hσ).range)
    (hgen : primeToResidual r (form σ hσ n).specialSubgroup = ⊤)
    (a : (form σ hσ n).specialSubgroup) :
    ((residualEquivOfCoveringCharacter σ hσ hr he hc hj χ hχ hgen).symm a).val =
      complementInCentralizer σ hσ a := rfl

/-- Prime rank is transported along that same equivalence, for any prime parameter. -/
theorem primeRank_residual_of_covering_character
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e))
    (χ : coveringCentralizer σ hσ (n := n) →* Fˣ)
    (hχ : χ.ker = (complementInCoveringCentralizer σ hσ).range)
    (hgen : primeToResidual r (form σ hσ n).specialSubgroup = ⊤) (s : ℕ) :
    primeRank s (residual σ hσ (n := n) r) =
      primeRank s (form σ hσ n).specialSubgroup := by
  let : Finite (ProjGenLinGroup (Fin (2+n)) F) :=
    Finite.of_surjective ProjGenLinGroup.mk ProjGenLinGroup.mk_surjective
  exact Theory.GroupTheory.primeRank_equiv s
    (residualEquivOfCoveringCharacter σ hσ hr he hc hj χ hχ hgen)

/-- The defining-prime residual of the marked projective centralizer is exactly
the original complementary SUₙ image. Both structural inputs are discharged. -/
theorem residual_eq_complement
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e)) (hn : 0 < n) :
    residual σ hσ (n := n) r = (complementInCentralizer σ hσ).range := by
  obtain ⟨χ, hχ⟩ := exists_covering_character σ hσ (n := n) he hc hj
  exact residual_eq_complement_of_covering_character σ hσ hr he hc hj χ hχ
    (special_primeToResidual_eq_top σ hσ hr he hc hj hn)

/-- Identify the literal residual with SUₙ using the faithful complementary map. -/
def residualEquiv
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e)) (hn : 0 < n) :
    residual σ hσ (n := n) r ≃* (form σ hσ n).specialSubgroup :=
  (MulEquiv.subgroupCongr (residual_eq_complement σ hσ hr he hc hj hn)).trans
    (MonoidHom.ofInjective (complementInCentralizer_injective σ hσ)).symm

/-- The inverse equivalence is the original complementary embedding. -/
@[simp] theorem residualEquiv_symm_coe
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e)) (hn : 0 < n)
    (a : (form σ hσ n).specialSubgroup) :
    ((residualEquiv σ hσ hr he hc hj hn).symm a).val =
      complementInCentralizer σ hσ a := rfl

/-- Recovering the complementary matrix preserves the original centralizer element. -/
@[simp] theorem complementInCentralizer_residualEquiv
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e)) (hn : 0 < n)
    (g : residual σ hσ (n := n) r) :
    complementInCentralizer σ hσ (residualEquiv σ hσ hr he hc hj hn g) = g.val :=
  congrArg Subtype.val ((residualEquiv σ hσ hr he hc hj hn).symm_apply_apply g)

/-- Every prime rank of the literal residual is the rank of the complementary SUₙ. -/
theorem primeRank_residual
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e)) (hn : 0 < n) (s : ℕ) :
    primeRank s (residual σ hσ (n := n) r) =
      primeRank s (form σ hσ n).specialSubgroup := by
  let : Finite (ProjGenLinGroup (Fin (2+n)) F) :=
    Finite.of_surjective ProjGenLinGroup.mk ProjGenLinGroup.mk_surjective
  exact Theory.GroupTheory.primeRank_equiv s (residualEquiv σ hσ hr he hc hj hn)

/-- In total dimension three the fundamental centralizer has trivial residual. -/
theorem residual_one_eq_bot
    (hr : r ≠ 2) (he : 0 < e) (hc : Nat.card F = (r ^ e) ^ 2)
    (hj : ∀ x, σ x = x ^ (r ^ e)) :
    residual σ hσ (n := 1) r = ⊥ := by
  rw [residual_eq_complement σ hσ hr he hc hj (by decide : 0 < 1),
    complementaryOne_range_eq_bot]

end Theory.SpecificGroups.ClassicalUnitary.OddFundamental
