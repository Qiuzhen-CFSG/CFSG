module

public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.Levi.Restriction
public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.Levi.Conjugation.Geometry
public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.Levi.Conjugation.Faithfulness
public import Mathlib.GroupTheory.SemidirectProduct

/-!
# The geometric plane-unipotent–SL₂ semidirect product

The SL₂ Levi conjugates the unipotent coordinates by
`(x,z) ↦ (A*x,A*z*A*)`, as proved by actual matrix conjugation in
`Conjugation.Geometry`. Multiplication of the two faithful geometric
embeddings identifies this semidirect product with `planeRadicalLevi`, the
specified subgroup generated by their images. The projection to SL₂ is
surjective and its kernel is exactly the relative unipotent subgroup.

The scalar-kernel argument uses the fixed anisotropic coordinate and restriction to the
marked plane. It does not require exhaustion of the full parabolic restriction
kernel. Perfection, the solvable residual, and normality in the full parabolic
are separate results.

Source: the standard unitary plane-parabolic calculation underlying
Aschbacher--Smith, *The Classification of Quasithin Groups*, F.1.12(7),
printed pp.263--264.
-/

@[expose] public section

open BenderSuzuki.MatrixGroups Matrix
namespace Theory.SpecificGroups.UnitaryFive.PlaneCore
variable {F : Type*} [Field F] [CharP F 2] (J : HermitianForm 5 F)

abbrev PlaneSemidirect :=
  Parameters J ⋊[Parameters.planeAction] Matrix.SpecialLinearGroup (Fin 2) F

/-- Multiply the geometric unipotent and special-linear embeddings. -/
def planeSemidirectToParabolic (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    PlaneSemidirect J →* planeParabolic J :=
  SemidirectProduct.lift (Parameters.toParabolic hJ) (planeSLParabolic J c hc hJ)
    (by
      intro A
      apply MonoidHom.ext
      intro u
      exact (Parameters.planeSLParabolic_conjugation c hc hJ A u).symm)

@[simp] theorem planeSemidirectToParabolic_apply (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) (p : PlaneSemidirect J) :
    planeSemidirectToParabolic J c hc hJ p =
      Parameters.toParabolic hJ p.left * planeSLParabolic J c hc hJ p.right := rfl

@[simp] theorem planeSemidirectToParabolic_inl (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) (u : Parameters J) :
    planeSemidirectToParabolic J c hc hJ (SemidirectProduct.inl u) =
      Parameters.toParabolic hJ u := by simp

@[simp] theorem planeSemidirectToParabolic_inr (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) (A : Matrix.SpecialLinearGroup (Fin 2) F) :
    planeSemidirectToParabolic J c hc hJ (SemidirectProduct.inr A) =
      planeSLParabolic J c hc hJ A := by simp

theorem planeSemidirectToParabolic_injective (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) : Function.Injective (planeSemidirectToParabolic J c hc hJ) := by
  apply (injective_iff_map_eq_one _).mpr
  intro p hp
  obtain ⟨hu, hA⟩ := unipotent_mul_SL_eq_one J c hc hJ p.left p.right hp
  exact SemidirectProduct.ext hu hA

theorem planeSemidirectToParabolic_range (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) :
    (planeSemidirectToParabolic J c hc hJ).range = planeRadicalLevi J c hc hJ := by
  apply le_antisymm
  · rintro _ ⟨p, rfl⟩
    exact (planeRadicalLevi J c hc hJ).mul_mem
      ((show projectiveUnipotent J hJ ≤ planeRadicalLevi J c hc hJ from
        le_sup_left) ⟨p.left, rfl⟩)
      ((show (planeSLParabolic J c hc hJ).range ≤ planeRadicalLevi J c hc hJ from
        le_sup_right) ⟨p.right, rfl⟩)
  · apply sup_le
    · rintro _ ⟨u, rfl⟩
      exact ⟨SemidirectProduct.inl u, planeSemidirectToParabolic_inl J c hc hJ u⟩
    · rintro _ ⟨A, rfl⟩
      exact ⟨SemidirectProduct.inr A, planeSemidirectToParabolic_inr J c hc hJ A⟩

/-- The generated subgroup is the actual geometric semidirect product. -/
noncomputable def planeRadicalLeviEquiv (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) : PlaneSemidirect J ≃* planeRadicalLevi J c hc hJ :=
  (MonoidHom.ofInjective (planeSemidirectToParabolic_injective J c hc hJ)).trans
    (MulEquiv.subgroupCongr (planeSemidirectToParabolic_range J c hc hJ))

@[simp] theorem planeRadicalLeviEquiv_val (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) (p : PlaneSemidirect J) :
    (planeRadicalLeviEquiv J c hc hJ p).val =
      Parameters.toParabolic hJ p.left * planeSLParabolic J c hc hJ p.right := rfl

/-- The SL₂ projection on the generated subgroup, in geometric coordinates. -/
noncomputable def planeRadicalLeviProjection (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) :
    planeRadicalLevi J c hc hJ →* Matrix.SpecialLinearGroup (Fin 2) F :=
  SemidirectProduct.rightHom.comp (planeRadicalLeviEquiv J c hc hJ).symm.toMonoidHom

@[simp] theorem planeRadicalLeviProjection_equiv (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) (p : PlaneSemidirect J) :
    planeRadicalLeviProjection J c hc hJ (planeRadicalLeviEquiv J c hc hJ p) = p.right := by
  simp [planeRadicalLeviProjection]

theorem planeRadicalLeviProjection_surjective (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) : Function.Surjective (planeRadicalLeviProjection J c hc hJ) := by
  intro A
  exact ⟨planeRadicalLeviEquiv J c hc hJ (SemidirectProduct.inr A),
    planeRadicalLeviProjection_equiv J c hc hJ _⟩

/-- The kernel is the unipotent subgroup relative to the generated subgroup. -/
theorem planeRadicalLeviProjection_ker (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) :
    (planeRadicalLeviProjection J c hc hJ).ker =
      (projectiveUnipotent J hJ).subgroupOf (planeRadicalLevi J c hc hJ) := by
  ext g
  obtain ⟨p, rfl⟩ := (planeRadicalLeviEquiv J c hc hJ).surjective g
  rw [MonoidHom.mem_ker, planeRadicalLeviProjection_equiv]
  change p.right = 1 ↔ (planeRadicalLeviEquiv J c hc hJ p).val ∈ projectiveUnipotent J hJ
  rw [planeRadicalLeviEquiv_val]
  constructor
  · intro h
    exact ⟨p.left, by simp [h]⟩
  · rintro ⟨u, hu⟩
    have h : planeSemidirectToParabolic J c hc hJ (SemidirectProduct.inl u) =
        planeSemidirectToParabolic J c hc hJ p := by
      rw [planeSemidirectToParabolic_inl, planeSemidirectToParabolic_apply]
      exact hu
    have he := planeSemidirectToParabolic_injective J c hc hJ h
    exact (congrArg SemidirectProduct.right he).symm

/-- Normality is asserted inside `planeRadicalLevi`, not the full parabolic. -/
theorem planeRadicalLevi_unipotent_normal (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) :
    ((projectiveUnipotent J hJ).subgroupOf (planeRadicalLevi J c hc hJ)).Normal := by
  rw [← planeRadicalLeviProjection_ker]
  infer_instance

end Theory.SpecificGroups.UnitaryFive.PlaneCore
