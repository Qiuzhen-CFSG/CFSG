module

public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.Levi.Quotient
public import Mathlib.GroupTheory.Index

/-!
# The normal index-three radical--SL₂ subgroup

Determinant modulo fifth roots descends through the full projective Levi
quotient. Its kernel is exactly the subgroup generated by the unipotents and
the embedded SL₂: if the determinant is a fifth root d, the scalar d³ has square
d and removes that determinant. Over F₁₆ the target has order 15/5 = 3.

Thus the generated subgroup is normal of index three in the actual plane
parabolic. This calculation does not identify it with the solvable residual;
that requires the separate perfection argument.

Source: the unitary parabolic calculation underlying Aschbacher--Smith,
*The Classification of Quasithin Groups*, F.1.12(7), printed pp.263--264.
-/

@[expose] public section

open BenderSuzuki.MatrixGroups Matrix
namespace Theory.SpecificGroups.UnitaryFive.PlaneCore
variable {F : Type*} [Field F] [CharP F 2] (J : HermitianForm 5 F)

/-- Determinant descends through the scalar fifth roots. -/
def planeLeviDetQuotient :
    (GL (Fin 2) F ⧸ planeScalarRoots (F := F)) →* (Fˣ ⧸ rootsOfUnity 5 F) :=
  QuotientGroup.lift _ ((QuotientGroup.mk' (rootsOfUnity 5 F)).comp
    GeneralLinearGroup.det) (by
      rintro _ ⟨a, rfl⟩
      change QuotientGroup.mk (GeneralLinearGroup.det
        (GeneralLinearGroup.scalar (Fin 2) a.val)) = (1 : Fˣ ⧸ rootsOfUnity 5 F)
      apply (QuotientGroup.eq_one_iff _).mpr
      rw [GeneralLinearGroup.det_scalar]
      exact (rootsOfUnity 5 F).pow_mem a.property _)

omit [CharP F 2] in
@[simp] theorem planeLeviDetQuotient_mk (A : GL (Fin 2) F) :
    planeLeviDetQuotient (QuotientGroup.mk A) =
      QuotientGroup.mk (GeneralLinearGroup.det A) := rfl

omit [CharP F 2] in
theorem planeLeviDetQuotient_surjective :
    Function.Surjective (planeLeviDetQuotient (F := F)) := by
  intro q
  obtain ⟨d, rfl⟩ := QuotientGroup.mk'_surjective (rootsOfUnity 5 F) q
  obtain ⟨A, rfl⟩ := GeneralLinearGroup.det_surjective (n := Fin 2) d
  exact ⟨QuotientGroup.mk A, rfl⟩

/-- The determinant of plane restriction, modulo the projective scalar ambiguity. -/
noncomputable def planeParabolicDeterminant : planeParabolic J →* (Fˣ ⧸ rootsOfUnity 5 F) :=
  planeLeviDetQuotient.comp (planeProjectiveRestriction J)

@[simp] theorem planeParabolicDeterminant_unipotent (hJ : J.form = 1) (u : Parameters J) :
    planeParabolicDeterminant J (Parameters.toParabolic hJ u) = 1 := by
  simp [planeParabolicDeterminant]

@[simp] theorem planeParabolicDeterminant_levi (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) (A : GL (Fin 2) F) :
    planeParabolicDeterminant J (planeLeviParabolic J c hc hJ A) =
      QuotientGroup.mk (GeneralLinearGroup.det A) := by
  simp [planeParabolicDeterminant]

theorem planeParabolicDeterminant_surjective (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) : Function.Surjective (planeParabolicDeterminant J) :=
  planeLeviDetQuotient_surjective.comp (planeProjectiveRestriction_surjective J c hc hJ)

omit [CharP F 2] in
/-- A determinant in the fifth roots can be removed by a scalar fifth root. -/
theorem planeGL_factorization_of_det_mem_roots (A : GL (Fin 2) F)
    (hA : GeneralLinearGroup.det A ∈ rootsOfUnity 5 F) :
    ∃ (a : rootsOfUnity 5 F) (B : SpecialLinearGroup (Fin 2) F),
      A = GeneralLinearGroup.scalar (Fin 2) a.val * planeSLtoGL B := by
  let d := GeneralLinearGroup.det A
  let a : rootsOfUnity 5 F := ⟨d ^ 3, (rootsOfUnity 5 F).pow_mem hA 3⟩
  have hd : d ^ 5 = 1 := (mem_rootsOfUnity 5 d).mp hA
  have ha : a.val ^ 2 = d := by
    change (d ^ 3) ^ 2 = d
    rw [← pow_mul]
    calc
      d ^ (3 * 2) = d ^ 5 * d := by rw [← pow_succ]
      _ = d := by rw [hd, one_mul]
  let C := GeneralLinearGroup.scalar (Fin 2) a.val⁻¹ * A
  have hC : GeneralLinearGroup.det C = 1 := by
    change GeneralLinearGroup.det (GeneralLinearGroup.scalar (Fin 2) a.val⁻¹ * A) = 1
    rw [map_mul, GeneralLinearGroup.det_scalar]
    change (a.val⁻¹) ^ 2 * d = 1
    rw [inv_pow, ha, inv_mul_cancel]
  let B : SpecialLinearGroup (Fin 2) F := ⟨C.val, congrArg Units.val hC⟩
  have hB : planeSLtoGL B = C := by apply Units.ext; rfl
  refine ⟨a, B, ?_⟩
  rw [hB]
  dsimp only [C]
  rw [← mul_assoc, ← map_mul, mul_inv_cancel, map_one, one_mul]

theorem planeParabolicDeterminant_ker (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) (hconj : ∀ x, J.conj x = x ^ 4) :
    (planeParabolicDeterminant J).ker = planeRadicalLevi J c hc hJ := by
  apply le_antisymm
  · intro g hg
    obtain ⟨u, A, rfl⟩ := planeParabolic_factorization J c hc hJ g
    have hA : GeneralLinearGroup.det A ∈ rootsOfUnity 5 F := by
      apply (QuotientGroup.eq_one_iff _).mp
      simpa only [MonoidHom.mem_ker, map_mul, planeParabolicDeterminant_unipotent,
        planeParabolicDeterminant_levi, one_mul] using hg
    obtain ⟨a, B, hB⟩ := planeGL_factorization_of_det_mem_roots A hA
    have ha : planeLeviParabolic J c hc hJ (GeneralLinearGroup.scalar (Fin 2) a.val) = 1 := by
      apply MonoidHom.mem_ker.mp
      rw [planeLeviParabolic_ker J c hc hJ hconj]
      exact ⟨a, rfl⟩
    rw [hB, map_mul, ha, one_mul]
    exact (planeRadicalLevi J c hc hJ).mul_mem
      ((show projectiveUnipotent J hJ ≤ planeRadicalLevi J c hc hJ from le_sup_left)
        ⟨u, rfl⟩)
      ((show (planeSLParabolic J c hc hJ).range ≤ planeRadicalLevi J c hc hJ from
        le_sup_right) ⟨B, rfl⟩)
  · apply sup_le
    · rintro _ ⟨u, rfl⟩
      exact planeParabolicDeterminant_unipotent J hJ u
    · rintro _ ⟨B, rfl⟩
      change planeParabolicDeterminant J (planeLeviParabolic J c hc hJ (planeSLtoGL B)) = 1
      rw [planeParabolicDeterminant_levi]
      have hB : GeneralLinearGroup.det (planeSLtoGL B) = 1 :=
        Units.ext (planeSLtoGL_det B)
      rw [hB]
      rfl

/-- Normality in the full projective plane parabolic. -/
theorem planeRadicalLevi_normal (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) (hconj : ∀ x, J.conj x = x ^ 4) :
    (planeRadicalLevi J c hc hJ).Normal := by
  rw [← planeParabolicDeterminant_ker J c hc hJ hconj]
  infer_instance

omit [CharP F 2] in
/-- Over the field of order sixteen, units modulo fifth roots have order three. -/
theorem planeDeterminantQuotient_card [Finite F] (hcard : Nat.card F = 16) :
    Nat.card (Fˣ ⧸ rootsOfUnity 5 F) = 3 := by
  have hr : Nat.card (rootsOfUnity 5 F) = 5 := by
    apply FiniteField.card_rootsOfUnity_of_dvd
    rw [hcard]
    decide
  have h := (rootsOfUnity 5 F).card_mul_index
  rw [hr, Nat.card_units, hcard, Subgroup.index_eq_card] at h
  omega

/-- The radical--SL₂ subgroup has exactly three cosets in the full parabolic. -/
theorem planeRadicalLevi_index [Finite F] (hcard : Nat.card F = 16)
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1)
    (hconj : ∀ x, J.conj x = x ^ 4) : (planeRadicalLevi J c hc hJ).index = 3 := by
  rw [← planeParabolicDeterminant_ker J c hc hJ hconj, Subgroup.index_eq_card,
    Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective (planeParabolicDeterminant J)
      (planeParabolicDeterminant_surjective J c hc hJ)).toEquiv]
  exact planeDeterminantQuotient_card hcard

end Theory.SpecificGroups.UnitaryFive.PlaneCore
