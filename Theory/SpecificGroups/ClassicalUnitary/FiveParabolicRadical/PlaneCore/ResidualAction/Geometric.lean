module

public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.ResidualAction
public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.Levi.Conjugation

/-!
# Perfection of the geometric plane radical–Levi subgroup

The geometric equivalence uses exactly `Parameters.planeAction`, so the
coordinate perfection theorem transports to the subgroup generated by the
actual projective unipotent and SL₂ embeddings. This discharges perfection
for that subgroup. Its identification with the full parabolic's solvable
residual is a separate assertion of the plane-parabolic assembly.

Source: the unitary-five plane-parabolic calculation underlying
Aschbacher--Smith, *The Classification of Quasithin Groups*, F.1.12(I)(7)
and (II), printed pp.263--264.
-/

public section

open BenderSuzuki.MatrixGroups
namespace Theory.SpecificGroups.UnitaryFive.PlaneCore.ResidualAction
variable {F : Type*} [Field F] [CharP F 2] [Finite F] (J : HermitianForm 5 F)

/-- The genuine subgroup generated by the two matrix embeddings is perfect. -/
theorem planeRadicalLevi_isPerfect (hcard : Nat.card F = 16)
    (hconj : ∀ a, J.conj a = a ^ 4) (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) : Group.IsPerfect (planeRadicalLevi J c hc hJ) := by
  let : Group.IsPerfect (PlaneSemidirect J) := semidirect_isPerfect J hcard hconj
  exact Group.IsPerfect.ofSurjective
    (f := (planeRadicalLeviEquiv J c hc hJ).toMonoidHom)
    (planeRadicalLeviEquiv J c hc hJ).surjective

end Theory.SpecificGroups.UnitaryFive.PlaneCore.ResidualAction
