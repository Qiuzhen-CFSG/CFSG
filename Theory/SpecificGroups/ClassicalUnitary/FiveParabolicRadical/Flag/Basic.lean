module

public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.Levi
public import Theory.SpecificGroups.SL2.UpperUnipotent

/-!
# Unipotent matrices in the unitary-five flag stabilizer

The plane radical fixes the marked isotropic plane pointwise. The upper
unitriangular SL₂ Levi fixes its first coordinate line pointwise. Thus their
join lies in the actual line--plane overlap and is a two-group. These are
literal projective matrix subgroups, with the ordered plane coordinates of
`FiveFlag`; no Sylow or normality conclusion is assumed.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*,
F.1.3 and F.1.12(7), printed pp.260 and 263--264.
-/

@[expose] public section

open BenderSuzuki.MatrixGroups Matrix
namespace Theory.SpecificGroups.UnitaryFive.Flag
variable {F : Type*} [Field F] [CharP F 2] (J : HermitianForm 5 F)
open PlaneCore

theorem unipotent_le_line (hJ : J.form = 1) :
    projectiveUnipotent J hJ ≤ (lineParabolic J).subgroupOf (planeParabolic J) := by
  rintro _ ⟨u, rfl⟩
  change project J (Parameters.toSU hJ u) ∈ lineParabolic J
  apply Subgroup.mem_map.mpr
  refine ⟨Parameters.toSU hJ u, ?_, rfl⟩
  rw [mem_specialStabilizer_iff]
  intro v
  constructor
  · intro hv
    have hf := Parameters.toSU_fixes_plane hJ u _ (line_le_plane F hv)
    change linearAction J (Parameters.toSU hJ u)
      (linearAction J (Parameters.toSU hJ u) v) = _ at hf
    exact (linearAction J (Parameters.toSU hJ u)).injective hf ▸ hv
  · intro hv
    change linearAction J (Parameters.toSU hJ u) v ∈ line F
    rw [Parameters.toSU_fixes_plane hJ u _ (line_le_plane F hv)]
    exact hv

theorem upperLevi_le_line (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    (SpecialLinearGroup.upperUnipotent F).map (planeSLParabolic J c hc hJ) ≤
      (lineParabolic J).subgroupOf (planeParabolic J) := by
  rintro _ ⟨A, hA, rfl⟩
  obtain ⟨t, rfl⟩ := (SpecialLinearGroup.mem_upperUnipotent F A).mp hA
  let A := SpecialLinearGroup.transvection (i := (0 : Fin 2)) (j := 1) zero_ne_one t
  have hfix (v : Fin 5 → F) (hv : v ∈ line F) :
      linearAction J (planeLeviSU J c hc hJ (planeSLtoGL A)) v = v := by
    let w : plane F := ⟨v, line_le_plane F hv⟩
    have he : (planeSLtoGL A).val *ᵥ (planeEquiv F w) = planeEquiv F w := by
      have hv2 : v 2 = 0 := hv.2.1
      ext i
      fin_cases i <;>
        simp [A, planeSLtoGL, SpecialLinearGroup.transvection_coe,
          Matrix.mulVec, dotProduct, Fin.sum_univ_two, planeEquiv, w, hv2]
    change (planeLeviGL J c (planeSLtoGL A)).val *ᵥ v = v
    have hh := planeLeviGL_plane J c (planeSLtoGL A) (planeEquiv F w)
    rw [he, LinearEquiv.symm_apply_apply] at hh
    exact hh
  change project J (planeLeviSU J c hc hJ (planeSLtoGL A)) ∈ lineParabolic J
  apply Subgroup.mem_map.mpr
  refine ⟨_, ?_, rfl⟩
  rw [mem_specialStabilizer_iff]
  intro v
  constructor
  · intro hv
    have hh := hfix _ hv
    exact (linearAction J (planeLeviSU J c hc hJ (planeSLtoGL A))).injective hh ▸ hv
  · intro hv
    change linearAction J (planeLeviSU J c hc hJ (planeSLtoGL A)) v ∈ line F
    rw [hfix v hv]
    exact hv
/-- The flag unipotents, generated by the plane radical and upper SL₂ root. -/
def unipotent (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    Subgroup (planeParabolic J) :=
  projectiveUnipotent J hJ ⊔
    (SpecialLinearGroup.upperUnipotent F).map (planeSLParabolic J c hc hJ)

/-- Both matrix factors preserve the marked line. -/
theorem unipotent_le_lineParabolic (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) :
    unipotent J c hc hJ ≤ (lineParabolic J).subgroupOf (planeParabolic J) :=
  sup_le (unipotent_le_line J hJ) (upperLevi_le_line J c hc hJ)

/-- The join is a two-group because its plane-radical factor is normal. -/
theorem unipotent_isPGroup [Finite F] (c : F) (hc : c + J.conj c = 1)
    (hJ : J.form = 1) : IsPGroup 2 (unipotent J c hc hJ) :=
  (projectiveUnipotent_isPGroup J hJ).to_sup_of_normal_left
    ((SpecialLinearGroup.upperUnipotentSylow F 2).isPGroup'.map
      (planeSLParabolic J c hc hJ))

end Theory.SpecificGroups.UnitaryFive.Flag
