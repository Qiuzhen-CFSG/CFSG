module
public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.Levi.Conjugation.Coordinates
public import Mathlib.GroupTheory.Commutator.Basic
public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.Levi.Conjugation
public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.Flag.Basic
public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.PlaneCore.Counting
public import Theory.GroupTheory.SylowFrattiniBounds
public import Theory.GroupTheory.FrattiniInvolutionPoints

/-!
# The invariant Frattini flag of the unitary-five unipotent group

The plane radical and the upper unipotent root in its SL₂ Levi give explicit
coordinates for the literal projective flag subgroup. The two simple-root
coordinates identify its Frattini quotient with the additive group of F².
The images of square-one elements span exactly the first root axis, so every
automorphism of the original group preserves that axis. Both flag factors
have cardinality |F|. No characteristic-subgroup claim is made for the full
abstract elementary quotient.

This supplies the invariant sections used in the unitary-five Sylow argument
underlying Aschbacher--Smith 4.4.10--11, printed p.621. The literal matrices
are those of F.1.12(7), printed pp.263--264.
-/

@[expose] public section

open BenderSuzuki.MatrixGroups Matrix Subgroup
open scoped commutatorElement IsMulCommutative
namespace Theory.SpecificGroups.UnitaryFive.PlaneCore.Parameters
variable {F : Type*} [Field F] [CharP F 2] (J : HermitianForm 5 F)

private def liftVector (c : F) (hc : c + J.conj c = 1) (v : Fin 2 → F) : Parameters J where
  x := v
  z := !![c * v 0 * J.conj (v 0),v 0 * J.conj (v 1);0,c * v 1 * J.conj (v 1)]
  relation := by
    intro i j
    fin_cases i <;> fin_cases j <;> simp [map_mul] <;>
      first | (solve | ring) | (solve | linear_combination v 0 * J.conj (v 0) * hc) |
        (solve | linear_combination v 1 * J.conj (v 1) * hc)

private theorem commutator_x (u v : Parameters J) : ⁅u,v⁆.x = 0 := by
  ext i
  simp only [commutatorElement_def, mul_x, inv_x, Pi.add_apply, Pi.zero_apply]
  linear_combination (u.x i + v.x i) * (CharTwo.two_eq_zero : (2 : F) = 0)

private theorem commutator_z (u v : Parameters J) (i j : Fin 2) :
    ⁅u,v⁆.z i j = u.x i * J.conj (v.x j) + v.x i * J.conj (u.x j) := by
  simp only [commutatorElement_def, mul_z, mul_x, inv_x, inv_z, Pi.add_apply]
  linear_combination (u.z i j + v.z i j + u.x i * J.conj (u.x j) +
    v.x i * J.conj (v.x j) + u.x i * J.conj (v.x j)) * (CharTwo.two_eq_zero : (2 : F) = 0)

/-- The kernel of the vector map is generated by three explicit commutators. -/
theorem vector_zero_eq_commutator_product (c : F) (hc : c + J.conj c = 1)
    (u : Parameters J) (hu : u.x = 0) :
    ∃ a b d e f g : Parameters J, u = ⁅a,b⁆ * ⁅d,e⁆ * ⁅f,g⁆ := by
  have hfix (i : Fin 2) : J.conj (u.z i i) = u.z i i := by
    have h := u.relation i i
    rw [hu, Pi.zero_apply, zero_mul] at h
    exact add_left_cancel (h.trans (CharTwo.add_self_eq_zero (u.z i i)).symm)
  have h01 : J.conj (u.z 0 1) = u.z 1 0 := by
    have h := u.relation 1 0
    rw [hu, Pi.zero_apply, zero_mul] at h
    exact add_left_cancel (h.trans (CharTwo.add_self_eq_zero (u.z 1 0)).symm)
  refine ⟨liftVector J c hc ![c * u.z 0 0,0],liftVector J c hc ![1,0],
    liftVector J c hc ![0,c * u.z 1 1],liftVector J c hc ![0,1],
    liftVector J c hc ![u.z 0 1,0],liftVector J c hc ![0,1],?_⟩
  apply Parameters.ext
  · simp [hu,commutator_x]
  · ext i j
    rw [mul_z, mul_z, mul_x, commutator_x, commutator_x, commutator_x]
    simp only [Pi.zero_apply, Pi.add_apply, add_zero, map_zero, mul_zero]
    rw [commutator_z,commutator_z,commutator_z]
    fin_cases i <;> fin_cases j <;> simp [liftVector, map_mul, hfix, h01]
    all_goals first | (solve | linear_combination -(u.z 0 0) * hc) |
      (solve | linear_combination -(u.z 1 1) * hc)

/-- The vector coordinates give the full abelianization of the plane radical. -/
def vectorHom : Parameters J →* Multiplicative (Fin 2 → F) where
  toFun u := Multiplicative.ofAdd u.x
  map_one' := rfl
  map_mul' _ _ := rfl

theorem vectorHom_surjective (c : F) (hc : c + J.conj c = 1) :
    Function.Surjective (vectorHom J) := fun v => ⟨liftVector J c hc v.toAdd,rfl⟩

theorem vectorHom_ker_le_commutator (c : F) (hc : c + J.conj c = 1) :
    (vectorHom J).ker ≤ commutator (Parameters J) := by
  intro u hu
  obtain ⟨a,b,d,e,f,g,rfl⟩ := vector_zero_eq_commutator_product J c hc u
    (congrArg Multiplicative.toAdd hu)
  exact mul_mem (mul_mem (commutator_mem_commutator (mem_top a) (mem_top b))
    (commutator_mem_commutator (mem_top d) (mem_top e)))
      (commutator_mem_commutator (mem_top f) (mem_top g))
end Theory.SpecificGroups.UnitaryFive.PlaneCore.Parameters

open Theory.SpecificGroups.UnitaryFive
open PlaneCore
namespace Theory.SpecificGroups.UnitaryFive.Flag
variable {F : Type*} [Field F] [CharP F 2] (J : HermitianForm 5 F)

abbrev Coordinates := Parameters J ⋊[Parameters.planeAction.comp
  (SpecialLinearGroup.upperUnipotentHom F)] Multiplicative F

omit [CharP F 2] in
private theorem action_x_one (t : Multiplicative F) (u : Parameters J) :
    ((Parameters.planeAction.comp (SpecialLinearGroup.upperUnipotentHom F)) t u).x 1 = u.x 1 := by
  simp [SpecialLinearGroup.upperUnipotentHom, SpecialLinearGroup.transvection_coe,
    Parameters.planeAction_x, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

omit [CharP F 2] in
private theorem action_z_one_one (t : Multiplicative F) (u : Parameters J) :
    ((Parameters.planeAction.comp (SpecialLinearGroup.upperUnipotentHom F)) t u).z 1 1 = u.z 1 1 := by
  simp [SpecialLinearGroup.upperUnipotentHom, SpecialLinearGroup.transvection_coe,
    Parameters.planeAction_z, Matrix.mul_apply, planeAdjoint, Fin.sum_univ_two]

/-- The two simple-root coordinates in the literal unitary flag group. -/
def rootCoordinates : Coordinates J →* Multiplicative (F × F) where
  toFun u := Multiplicative.ofAdd (u.right.toAdd, u.left.x 1)
  map_one' := rfl
  map_mul' u v := by
    apply Multiplicative.toAdd.injective
    apply Prod.ext
    · rfl
    · change (u.left * ((Parameters.planeAction.comp
        (SpecialLinearGroup.upperUnipotentHom F)) u.right v.left)).x 1 = _
      rw [Parameters.mul_x, Pi.add_apply, action_x_one]
      rfl

private def secondRoot (c : F) (hc : c + J.conj c = 1) (y : F) : Parameters J where
  x := ![0,y]
  z := !![0,0;0,c * y * J.conj y]
  relation := by
    intro i j
    fin_cases i <;> fin_cases j <;> simp [map_mul]
    linear_combination y * J.conj y * hc

/-- The simple-root map is onto over every field with a trace-one element. -/
theorem rootCoordinates_surjective (c : F) (hc : c + J.conj c = 1) :
    Function.Surjective (rootCoordinates J) := by
  intro z
  refine ⟨⟨secondRoot J c hc z.toAdd.2, Multiplicative.ofAdd z.toAdd.1⟩, ?_⟩
  rfl

/-- A square-one element has zero second simple-root coordinate. -/
theorem involution_secondRoot_zero (u : Coordinates J) (hu : u ^ 2 = 1) :
    u.left.x 1 = 0 := by
  have hz := congrArg (fun v : Coordinates J => v.left.z 1 1) hu
  rw [pow_two] at hz
  change (u.left * ((Parameters.planeAction.comp
    (SpecialLinearGroup.upperUnipotentHom F)) u.right u.left)).z 1 1 = 0 at hz
  rw [Parameters.mul_z, action_x_one, action_z_one_one,
    CharTwo.add_self_eq_zero, zero_add] at hz
  rcases mul_eq_zero.mp hz with h | h
  · exact h
  · exact J.conj.injective (by simpa using h)

/-- Every vector on the first root axis has a square-one representative. -/
theorem rootCoordinates_involution_image :
    rootCoordinates J '' {u : Coordinates J | u ^ 2 = 1} =
      {v : Multiplicative (F × F) | v.toAdd.2 = 0} := by
  ext v
  constructor
  · rintro ⟨u,hu,rfl⟩
    exact involution_secondRoot_zero J u hu
  · intro hv
    refine ⟨SemidirectProduct.inr (Multiplicative.ofAdd v.toAdd.1), ?_, ?_⟩
    · change (SemidirectProduct.inr (Multiplicative.ofAdd v.toAdd.1) : Coordinates J) ^ 2 = 1
      rw [← map_pow]
      have h : (Multiplicative.ofAdd v.toAdd.1 : Multiplicative F) ^ 2 = 1 := by
        rw [pow_two]
        change v.toAdd.1 + v.toAdd.1 = 0
        exact CharTwo.add_self_eq_zero _
      rw [h, map_one]
    · apply Multiplicative.toAdd.injective
      exact Prod.ext rfl hv.symm

/-- The upper-root coordinate group inside the full plane Levi product. -/
def coordinatesInPlane : Coordinates J →* PlaneSemidirect J :=
  SemidirectProduct.map (MonoidHom.id _) (SpecialLinearGroup.upperUnipotentHom F)
    (by intro t; rfl)

theorem coordinatesInPlane_injective : Function.Injective (coordinatesInPlane J) := by
  intro u v h
  apply SemidirectProduct.ext
  · exact congrArg (fun p : PlaneSemidirect J => p.left) h
  · exact SpecialLinearGroup.upperUnipotentHom_injective F
      (congrArg (fun p : PlaneSemidirect J => p.right) h)

/-- The literal projective matrix realization of the coordinates. -/
def coordinatesToParabolic (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    Coordinates J →* planeParabolic J :=
  (planeSemidirectToParabolic J c hc hJ).comp (coordinatesInPlane J)

theorem coordinatesToParabolic_injective
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    Function.Injective (coordinatesToParabolic J c hc hJ) :=
  (planeSemidirectToParabolic_injective J c hc hJ).comp (coordinatesInPlane_injective J)

theorem coordinatesToParabolic_range
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    (coordinatesToParabolic J c hc hJ).range = unipotent J c hc hJ := by
  apply le_antisymm
  · rintro _ ⟨u,rfl⟩
    exact (unipotent J c hc hJ).mul_mem
      (mem_sup_left ⟨u.left,rfl⟩)
      (mem_sup_right ⟨SpecialLinearGroup.upperUnipotentHom F u.right,
        ⟨u.right,rfl⟩,rfl⟩)
  · apply sup_le
    · rintro _ ⟨u,rfl⟩
      refine ⟨SemidirectProduct.inl u, ?_⟩
      simp [coordinatesToParabolic, coordinatesInPlane]
    · rintro _ ⟨A,⟨t,rfl⟩,rfl⟩
      refine ⟨SemidirectProduct.inr t, ?_⟩
      simp [coordinatesToParabolic, coordinatesInPlane]

/-- These are coordinates for the already defined flag unipotents. -/
noncomputable def coordinatesEquivUnipotent
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    Coordinates J ≃* unipotent J c hc hJ :=
  (MonoidHom.ofInjective (coordinatesToParabolic_injective J c hc hJ)).trans
    (MulEquiv.subgroupCongr (coordinatesToParabolic_range J c hc hJ))

private theorem image_radical {A : Type*} [CommGroup A] (φ : Coordinates J →* A)
    (c : F) (hc : c + J.conj c = 1) (u : Parameters J) :
    φ (SemidirectProduct.inl u) = φ (SemidirectProduct.inl (secondRoot J c hc (u.x 1))) := by
  let γ : Parameters J →* A := φ.comp SemidirectProduct.inl
  have hker : (Parameters.vectorHom J).ker ≤ γ.ker :=
    (Parameters.vectorHom_ker_le_commutator J c hc).trans (Abelianization.commutator_subset_ker γ)
  let δ := (Parameters.vectorHom J).liftOfSurjective
    (Parameters.vectorHom_surjective J c hc) ⟨γ,hker⟩
  have hδ (v : Parameters J) : δ (Parameters.vectorHom J v) = γ v := by simp [δ]
  have hx (x : F) : δ (Multiplicative.ofAdd ![x,0]) = 1 := by
    let v := secondRoot J c hc x
    let t : Multiplicative F := Multiplicative.ofAdd 1
    let av := ((Parameters.planeAction.comp (SpecialLinearGroup.upperUnipotentHom F)) t) v
    have hev : Parameters.vectorHom J av = Multiplicative.ofAdd ![x,x] := by
      apply Multiplicative.toAdd.injective
      ext i
      fin_cases i <;> simp [Parameters.vectorHom, av, v, t, secondRoot,
        SpecialLinearGroup.upperUnipotentHom, SpecialLinearGroup.transvection_coe,
        Parameters.planeAction_x, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
    have hav : δ (Multiplicative.ofAdd ![x,x]) = δ (Multiplicative.ofAdd ![0,x]) := by
      rw [← hev, hδ, ← show Parameters.vectorHom J v = Multiplicative.ofAdd ![0,x] from rfl, hδ]
      change φ (SemidirectProduct.inl av) = φ (SemidirectProduct.inl v)
      rw [show SemidirectProduct.inl av =
        (SemidirectProduct.inr t : Coordinates J) * SemidirectProduct.inl v *
          (SemidirectProduct.inr t)⁻¹ from by simpa only [map_inv] using (SemidirectProduct.inl_aut t v)]
      simp
    have heq : (Multiplicative.ofAdd ![x,x] : Multiplicative (Fin 2 → F)) =
      Multiplicative.ofAdd ![x,0] * Multiplicative.ofAdd ![0,x] := by
      apply Multiplicative.toAdd.injective
      ext i
      fin_cases i <;> simp
    rw [heq,map_mul] at hav
    exact mul_right_cancel (hav.trans (one_mul _).symm)
  change γ u = γ (secondRoot J c hc (u.x 1))
  rw [← hδ, ← hδ]
  have heq : Parameters.vectorHom J u =
      Multiplicative.ofAdd ![u.x 0,0] * Multiplicative.ofAdd ![0,u.x 1] := by
    apply Multiplicative.toAdd.injective
    ext i
    fin_cases i <;> simp [Parameters.vectorHom]
  rw [heq, map_mul, hx, one_mul]
  rfl

private theorem coordinates_isPGroup [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) : IsPGroup 2 (Coordinates J) :=
  (unipotent_isPGroup J c hc hJ).of_equiv (coordinatesEquivUnipotent J c hc hJ).symm

private theorem frattini_card_le [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    Nat.card (Coordinates J ⧸ frattini (Coordinates J)) ≤ Nat.card F ^ 2 := by
  let : Finite (Parameters J) := Finite.of_injective (fun u : Parameters J => (u.x,u.z))
    (fun _ _ h => Parameters.ext (congrArg Prod.fst h) (congrArg Prod.snd h))
  let : Finite (Coordinates J) := Finite.of_equiv _ SemidirectProduct.equivProd.symm
  let : Fact (IsPGroup 2 (Coordinates J)) := ⟨coordinates_isPGroup J c hc hJ⟩
  let : IsElementaryAbelian 2 (Coordinates J ⧸ frattini (Coordinates J)) :=
    isElementaryAbelian_quotient_frattini
  let φ := QuotientGroup.mk' (frattini (Coordinates J))
  let f : F × F → Coordinates J ⧸ frattini (Coordinates J) := fun v =>
    φ (SemidirectProduct.inl (secondRoot J c hc v.2)) *
      φ (SemidirectProduct.inr (Multiplicative.ofAdd v.1))
  have hf : Function.Surjective f := by
    intro v
    obtain ⟨u,rfl⟩ := QuotientGroup.mk'_surjective (frattini (Coordinates J)) v
    refine ⟨(u.right.toAdd,u.left.x 1),?_⟩
    change _ = φ u
    calc
      _ = φ (SemidirectProduct.inl u.left) * φ (SemidirectProduct.inr u.right) := by
        rw [image_radical J φ c hc u.left]
        rfl
      _ = φ u := by rw [← map_mul, SemidirectProduct.inl_left_mul_inr_right]
  simpa only [Nat.card_prod, pow_two] using Nat.card_le_card_of_surjective f hf


/-- The kernel of the two root coordinates is exactly the Frattini subgroup. -/
theorem rootCoordinates_ker [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    (rootCoordinates J).ker = frattini (Coordinates J) := by
  let : Finite (Parameters J) := Finite.of_injective (fun u : Parameters J => (u.x,u.z))
    (fun _ _ h => Parameters.ext (congrArg Prod.fst h) (congrArg Prod.snd h))
  let : Finite (Coordinates J) := Finite.of_equiv _ SemidirectProduct.equivProd.symm
  let : Fact (IsPGroup 2 (Coordinates J)) := ⟨coordinates_isPGroup J c hc hJ⟩
  let : IsElementaryAbelian 2 (Multiplicative (F × F)) := {
    toIsMulCommutative := inferInstance
    exponent_dvd_p := Monoid.exponent_dvd_of_forall_pow_eq_one (by
      intro v
      rw [pow_two]
      change v.toAdd + v.toAdd = 0
      exact CharTwo.add_self_eq_zero _) }
  let : Fact (IsPGroup 2 (Multiplicative (F × F))) :=
    ⟨IsElementaryAbelian.isPGroup 2 _⟩
  have hle : frattini (Coordinates J) ≤ (rootCoordinates J).ker := by
    have h := frattini_le_comap_frattini_of_surjective (rootCoordinates_surjective J c hc)
    simpa only [frattini_eq_bot_of_isElementaryAbelian (p := 2), MonoidHom.comap_bot] using h
  let q := QuotientGroup.lift (frattini (Coordinates J)) (rootCoordinates J) hle
  have hq : Function.Surjective q := by
    intro v
    obtain ⟨u,rfl⟩ := rootCoordinates_surjective J c hc v
    exact ⟨QuotientGroup.mk' _ u,rfl⟩
  have hi : Function.Injective q := (hq.bijective_of_nat_card_le (by
    change Nat.card (Coordinates J ⧸ frattini (Coordinates J)) ≤ Nat.card (F × F)
    simpa only [Nat.card_prod, pow_two] using frattini_card_le J c hc hJ)).1
  apply le_antisymm _ hle
  intro u hu
  apply (QuotientGroup.eq_one_iff (N := frattini (Coordinates J)) u).mp
  apply hi
  change rootCoordinates J u = q 1
  rw [map_one]
  exact hu

/-- Literal root coordinates for the Frattini quotient. -/
noncomputable def frattiniEquiv [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    (Coordinates J ⧸ frattini (Coordinates J)) ≃* Multiplicative (F × F) :=
  (QuotientGroup.quotientMulEquivOfEq (rootCoordinates_ker J c hc hJ).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (rootCoordinates J)
      (rootCoordinates_surjective J c hc))


/-- The first root axis in the elementary quotient coordinates. -/
def firstRoot : Subgroup (Multiplicative (F × F)) where
  carrier := {v | v.toAdd.2 = 0}
  one_mem' := rfl
  mul_mem' := by intro x y hx hy; change x.toAdd.2 + y.toAdd.2 = 0; rw [hx,hy,add_zero]
  inv_mem' := by intro x hx; change -x.toAdd.2 = 0; rw [hx,neg_zero]

/-- The first axis, pulled back to the literal Frattini quotient. -/
noncomputable def involutionAxis [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    Subgroup (Coordinates J ⧸ frattini (Coordinates J)) :=
  (firstRoot (F := F)).comap (frattiniEquiv J c hc hJ).toMonoidHom

/-- The root-axis definition is intrinsic: it is generated by involution cosets. -/
theorem involutionAxis_eq_closure [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    involutionAxis J c hc hJ = closure (frattiniInvolutionPoints (Coordinates J)) := by
  apply le_antisymm
  · intro v hv
    by_cases hone : v = 1
    · exact hone ▸ one_mem _
    · apply Subgroup.subset_closure
      apply (mem_frattiniInvolutionPoints v).mpr
      refine ⟨hone, ?_⟩
      have he : frattiniEquiv J c hc hJ v ∈
          rootCoordinates J '' {u : Coordinates J | u ^ 2 = 1} := by
        rw [rootCoordinates_involution_image]
        exact hv
      obtain ⟨u,hu,he⟩ := he
      exact ⟨u,hu,(frattiniEquiv J c hc hJ).injective he⟩
  · apply (closure_le _).mpr
    intro v hv
    obtain ⟨_,u,hu,rfl⟩ := (mem_frattiniInvolutionPoints v).mp hv
    exact involution_secondRoot_zero J u hu

/-- Every automorphism of the flag group preserves this quotient axis. -/
theorem involutionAxis_invariant [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1)
    (a : MulAut (Coordinates J)) :
    (involutionAxis J c hc hJ).map
      (quotientAut (frattini (Coordinates J)) a).toMonoidHom = involutionAxis J c hc hJ := by
  rw [involutionAxis_eq_closure, MonoidHom.map_closure]
  congr 1
  ext v
  constructor
  · rintro ⟨w,hw,rfl⟩
    exact (quotientAut_mem_frattiniInvolutionPoints_iff a w).mpr hw
  · intro hv
    refine ⟨quotientAut (frattini (Coordinates J)) a⁻¹ v,
      (quotientAut_mem_frattiniInvolutionPoints_iff a⁻¹ v).mpr hv,?_⟩
    simp

/-- The axis is one copy of the additive field. -/
def firstRootEquiv : firstRoot (F := F) ≃* Multiplicative F where
  toFun v := Multiplicative.ofAdd v.val.toAdd.1
  invFun x := ⟨Multiplicative.ofAdd (x.toAdd,0),rfl⟩
  left_inv v := by
    apply Subtype.ext
    apply Multiplicative.toAdd.injective
    exact Prod.ext rfl v.property.symm
  right_inv _ := rfl
  map_mul' _ _ := rfl

/-- Each factor of the invariant root flag has the field's cardinality. -/
theorem involutionAxis_card [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    Nat.card (involutionAxis J c hc hJ) = Nat.card F ∧
      Nat.card ((Coordinates J ⧸ frattini (Coordinates J)) ⧸
        involutionAxis J c hc hJ) = Nat.card F := by
  let : Finite (Parameters J) := Finite.of_injective (fun u : Parameters J => (u.x,u.z))
    (fun _ _ h => Parameters.ext (congrArg Prod.fst h) (congrArg Prod.snd h))
  let : Finite (Coordinates J) := Finite.of_equiv _ SemidirectProduct.equivProd.symm
  have haxis : Nat.card (involutionAxis J c hc hJ) = Nat.card F := by
    let f : involutionAxis J c hc hJ →* firstRoot (F := F) :=
      (frattiniEquiv J c hc hJ).toMonoidHom.subgroupComap (firstRoot (F := F))
    have hi : Function.Injective f := by
      intro x y h
      exact Subtype.ext ((frattiniEquiv J c hc hJ).injective (congrArg Subtype.val h))
    have hs : Function.Surjective f :=
      MonoidHom.subgroupComap_surjective_of_surjective _ _ (frattiniEquiv J c hc hJ).surjective
    exact Nat.card_congr ((MulEquiv.ofBijective f ⟨hi,hs⟩).trans firstRootEquiv).toEquiv
  refine ⟨haxis,?_⟩
  have hfull : Nat.card (Coordinates J ⧸ frattini (Coordinates J)) = Nat.card F ^ 2 := by
    rw [Nat.card_congr (frattiniEquiv J c hc hJ).toEquiv]
    change Nat.card (F × F) = _
    rw [Nat.card_prod,pow_two]
  have hh := (involutionAxis J c hc hJ).card_mul_index
  rw [haxis,hfull,pow_two] at hh
  exact Nat.eq_of_mul_eq_mul_left Nat.card_pos hh


/-- Group equivalences preserve the intrinsic involution span in the Frattini quotient. -/
private theorem involutionSpan_map_equiv
    {P R : Type*} [Group P] [Group R] (e : P ≃* R) :
    (closure (frattiniInvolutionPoints P)).map
      (QuotientGroup.congr _ _ e (frattini_map_equiv e)).toMonoidHom =
        closure (frattiniInvolutionPoints R) := by
  let q := QuotientGroup.congr _ _ e (frattini_map_equiv e)
  rw [MonoidHom.map_closure]
  congr 1
  ext v
  constructor
  · rintro ⟨w,hw,rfl⟩
    obtain ⟨hne,x,hx,rfl⟩ := (mem_frattiniInvolutionPoints w).mp hw
    apply (mem_frattiniInvolutionPoints _).mpr
    refine ⟨fun h => hne (q.map_eq_one_iff.mp h),e x,by rw [← map_pow,hx,map_one],rfl⟩
  · intro hv
    obtain ⟨hne,x,hx,rfl⟩ := (mem_frattiniInvolutionPoints v).mp hv
    refine ⟨QuotientGroup.mk' (frattini P) (e.symm x),?_,?_⟩
    · apply (mem_frattiniInvolutionPoints _).mpr
      refine ⟨?_,e.symm x,by rw [← map_pow,hx,map_one],rfl⟩
      intro h
      apply hne
      have h' := congrArg q h
      change QuotientGroup.mk' (frattini R) (e (e.symm x)) = q 1 at h'
      simpa using h'
    · change QuotientGroup.mk' (frattini R) (e (e.symm x)) = _
      rw [e.apply_symm_apply]

/-- Any group in these literal flag coordinates inherits the invariant
Frattini flag, with both factors having the cardinality of the field. -/
theorem invariant_frattini_flag_of_equiv [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1)
    {P : Type*} [Group P] (e : P ≃* Coordinates J) :
    ∃ Q : Subgroup (P ⧸ frattini P),
      (∀ a : MulAut P, Q.map (quotientAut (frattini P) a).toMonoidHom = Q) ∧
      Nat.card Q = Nat.card F ∧ Nat.card ((P ⧸ frattini P) ⧸ Q) = Nat.card F := by
  let : Finite (Parameters J) := Finite.of_injective (fun u : Parameters J => (u.x,u.z))
    (fun _ _ h => Parameters.ext (congrArg Prod.fst h) (congrArg Prod.snd h))
  let : Finite (Coordinates J) := Finite.of_equiv _ SemidirectProduct.equivProd.symm
  let : Finite P := Finite.of_equiv _ e.toEquiv.symm
  let : Fact (IsPGroup 2 (Coordinates J)) := ⟨coordinates_isPGroup J c hc hJ⟩
  let : IsElementaryAbelian 2 (Coordinates J ⧸ frattini (Coordinates J)) :=
    isElementaryAbelian_quotient_frattini
  let : Fact (IsPGroup 2 P) := ⟨(coordinates_isPGroup J c hc hJ).of_equiv e.symm⟩
  let : IsElementaryAbelian 2 (P ⧸ frattini P) := isElementaryAbelian_quotient_frattini
  let q := QuotientGroup.congr _ _ e (frattini_map_equiv e)
  let Q := closure (frattiniInvolutionPoints P)
  have he : Q.map q.toMonoidHom = involutionAxis J c hc hJ := by
    rw [involutionAxis_eq_closure]
    exact involutionSpan_map_equiv e
  have hcard := involutionAxis_card J c hc hJ
  refine ⟨Q,?_,?_,?_⟩
  · intro a
    rw [MonoidHom.map_closure]
    congr 1
    ext v
    constructor
    · rintro ⟨w,hw,rfl⟩
      exact (quotientAut_mem_frattiniInvolutionPoints_iff a w).mpr hw
    · intro hv
      refine ⟨quotientAut (frattini P) a⁻¹ v,
        (quotientAut_mem_frattiniInvolutionPoints_iff a⁻¹ v).mpr hv,?_⟩
      simp
  · exact (Nat.card_congr (Q.equivMapOfInjective q.toMonoidHom q.injective).toEquiv).trans
      (he ▸ hcard.1)
  · exact (Nat.card_congr (QuotientGroup.congr Q (involutionAxis J c hc hJ) q he).toEquiv).trans
      hcard.2

/-- The invariant Frattini flag belongs to the actual projective flag subgroup. -/
theorem unipotent_invariant_frattini_flag [Finite F]
    (c : F) (hc : c + J.conj c = 1) (hJ : J.form = 1) :
    ∃ Q : Subgroup (unipotent J c hc hJ ⧸ frattini (unipotent J c hc hJ)),
      (∀ a : MulAut (unipotent J c hc hJ),
        Q.map (quotientAut (frattini (unipotent J c hc hJ)) a).toMonoidHom = Q) ∧
      Nat.card Q = Nat.card F ∧
        Nat.card ((unipotent J c hc hJ ⧸ frattini (unipotent J c hc hJ)) ⧸ Q) = Nat.card F :=
  invariant_frattini_flag_of_equiv J c hc hJ (coordinatesEquivUnipotent J c hc hJ).symm

end Theory.SpecificGroups.UnitaryFive.Flag
