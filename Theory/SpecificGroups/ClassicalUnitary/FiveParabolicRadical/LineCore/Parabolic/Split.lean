module

public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.LineCore.Parabolic.LeviAction
public import Mathlib.GroupTheory.SemidirectProduct

/-!
# The radical and special-unitary Levi as an actual split subgroup

Multiplication of the faithful radical and SU₃ embeddings realizes their
semidirect product inside the projective line parabolic. Matrix entries show
that its projective kernel is trivial. The projection to SU₃ therefore has
exactly the radical coordinates as kernel, normal in this split subgroup.

This does not identify the subgroup with the solvable residual or assert its
index in the entire parabolic. Those conclusions require the torus character
and the commutator action calculation.

Source: the unitary line-parabolic calculation used in Aschbacher--Smith,
*The Classification of Quasithin Groups*, F.1.12(7), printed pp.263--264.
-/

@[expose] public section

open BenderSuzuki.MatrixGroups Matrix
namespace Theory.SpecificGroups.UnitaryFive.LineCore.Parabolic
variable {F : Type*} [Field F] [CharP F 2] (J : HermitianForm 5 F)

abbrev RadicalLevi := Coord J ⋊[leviAction J] (middleForm J).specialSubgroup

def radicalLeviMap (hJ : J.form = 1) : RadicalLevi J →* lineParabolic J :=
  SemidirectProduct.lift (toParabolic J hJ) (leviParabolic J hJ) (by
    intro A
    apply MonoidHom.ext
    intro u
    exact toParabolic_leviAction J hJ A u)

@[simp] theorem radicalLeviMap_apply (hJ : J.form = 1) (x : RadicalLevi J) :
    radicalLeviMap J hJ x = toParabolic J hJ x.left * leviParabolic J hJ x.right := rfl

/-- No scalar matrix identifies two different radical-Levi coordinates. -/
theorem radicalLeviMap_injective (hJ : J.form = 1) :
    Function.Injective (radicalLeviMap J hJ) := by
  apply (injective_iff_map_eq_one _).mpr
  intro x hx
  have hp : project J (toSU J hJ x.left * leviSU J hJ x.right) = 1 := by
    rw [map_mul]
    exact congrArg Subtype.val hx
  have hs : Matrix.ProjGenLinGroup.mk (ambientGL J x.left * leviGL x.right.val) = 1 :=
    congrArg Subtype.val hp
  rw [Matrix.ProjGenLinGroup.mk_eq_one,
    Matrix.GeneralLinearGroup.center_eq_range_scalar] at hs
  obtain ⟨a, ha⟩ := hs
  have hm : Matrix.diagonal (fun _ : Fin 5 => a.val) =
      ambientMatrix J x.left * leviMatrix x.right.val.val := by
    have h := congrArg Units.val ha
    change Matrix.diagonal (fun _ : Fin 5 => a.val) =
      (ambientGL J x.left).val * leviMatrix x.right.val.val at h
    rwa [ambientGL_val] at h
  have he (i j : Fin 5) := congrArg (fun B : Matrix (Fin 5) (Fin 5) F => B i j) hm
  have ht : x.left.scalar = 0 := by
    simpa [ambientMatrix, leviMatrix, Matrix.mul_apply, Fin.sum_univ_succ] using (he 1 0).symm
  have hu : x.left = 1 := by
    apply Coord.ext
    · ext i
      fin_cases i
      · simpa [ambientMatrix, leviMatrix, Matrix.mul_apply, Fin.sum_univ_succ] using (he 2 0).symm
      · simpa [ambientMatrix, leviMatrix, Matrix.mul_apply, Fin.sum_univ_succ] using (he 3 0).symm
      · simpa [ambientMatrix, leviMatrix, Matrix.mul_apply, Fin.sum_univ_succ] using (he 4 0).symm
    · exact ht
  have hA : x.right = 1 := by
    apply leviParabolic_injective J hJ
    simpa [hu] using hx
  exact SemidirectProduct.ext hu hA

/-- The actual projective subgroup generated by the radical and the SU₃ Levi. -/
def radicalLeviSubgroup (hJ : J.form = 1) : Subgroup (lineParabolic J) :=
  (radicalLeviMap J hJ).range

noncomputable def radicalLeviEquiv (hJ : J.form = 1) :
    RadicalLevi J ≃* radicalLeviSubgroup J hJ :=
  MonoidHom.ofInjective (radicalLeviMap_injective J hJ)

@[simp] theorem radicalLeviEquiv_val (hJ : J.form = 1) (x : RadicalLevi J) :
    (radicalLeviEquiv J hJ x).val = radicalLeviMap J hJ x := rfl

theorem projectiveUnipotent_le_radicalLeviSubgroup (hJ : J.form = 1) :
    projectiveUnipotent J hJ ≤ radicalLeviSubgroup J hJ := by
  rintro g ⟨u, rfl⟩
  exact ⟨SemidirectProduct.inl u, by simp [radicalLeviMap]⟩

/-- The projection on this actual subgroup, prior to identifying it with the residual. -/
noncomputable def radicalLeviProjection (hJ : J.form = 1) :
    radicalLeviSubgroup J hJ →* (middleForm J).specialSubgroup :=
  SemidirectProduct.rightHom.comp (radicalLeviEquiv J hJ).symm.toMonoidHom

@[simp] theorem radicalLeviProjection_equiv (hJ : J.form = 1) (x : RadicalLevi J) :
    radicalLeviProjection J hJ (radicalLeviEquiv J hJ x) = x.right := by
  simp [radicalLeviProjection]

theorem radicalLeviProjection_surjective (hJ : J.form = 1) :
    Function.Surjective (radicalLeviProjection J hJ) :=
  SemidirectProduct.rightHom_surjective.comp (radicalLeviEquiv J hJ).symm.surjective

/-- The split projection has exactly the coordinate group as kernel. -/
noncomputable def radicalLeviProjectionKernelEquiv (hJ : J.form = 1) :
    (radicalLeviProjection J hJ).ker ≃* Coord J :=
  (MulEquiv.subgroupCongr
    (SemidirectProduct.rightHom.ker_comp_mulEquiv (radicalLeviEquiv J hJ).symm)).trans
    (((radicalLeviEquiv J hJ).subgroupMap SemidirectProduct.rightHom.ker).symm.trans
      ((MulEquiv.subgroupCongr SemidirectProduct.range_inl_eq_ker_rightHom.symm).trans
        (MonoidHom.ofInjective SemidirectProduct.inl_injective).symm))

theorem radicalLeviProjection_ker (hJ : J.form = 1) :
    (radicalLeviProjection J hJ).ker =
      (projectiveUnipotent J hJ).subgroupOf (radicalLeviSubgroup J hJ) := by
  ext g
  obtain ⟨x, rfl⟩ := (radicalLeviEquiv J hJ).surjective g
  change radicalLeviProjection J hJ (radicalLeviEquiv J hJ x) = 1 ↔
    radicalLeviMap J hJ x ∈ projectiveUnipotent J hJ
  rw [radicalLeviProjection_equiv]
  constructor
  · intro hx
    exact ⟨x.left, by simp [hx]⟩
  · rintro ⟨u, hu⟩
    have he : radicalLeviMap J hJ (SemidirectProduct.inl u) = radicalLeviMap J hJ x := by
      simpa [radicalLeviMap] using hu
    exact (congrArg SemidirectProduct.right (radicalLeviMap_injective J hJ he)).symm

instance projectiveUnipotent_normal_in_radicalLeviSubgroup (hJ : J.form = 1) :
    ((projectiveUnipotent J hJ).subgroupOf (radicalLeviSubgroup J hJ)).Normal := by
  rw [← radicalLeviProjection_ker]
  infer_instance

end Theory.SpecificGroups.UnitaryFive.LineCore.Parabolic
