module

public import Theory.SpecificGroups.HaradaNorton.Construction
public import Theory.SpecificGroups.HaradaNorton.Generators.ASquare
public import Theory.SpecificGroups.HaradaNorton.Generators.BSquare
public import Theory.SpecificGroups.HaradaNorton.Generators.BInverse

/-!
# Certified generators of the Harada–Norton matrix construction

The explicit ATLAS matrices lift to units of their generated monoid: A is its
own inverse, and the supplied inverse candidate for B is certified to be B².
The three matrix products are checked by kernel reduction in the certificate
modules, using certified sparse row supports. Associativity gives the remaining
inverse identity.

The image of the subgroup generated by these units contains the entire matrix
monoid. Faithfulness of `matrixHom` therefore proves that they generate `HN`.
The noncommuting matrix entry from `Construction` proves that `HN` is nonabelian.
No claimed order or simplicity of the ATLAS group is used here.

Source: ATLAS representation `HNG1-f5r133B0`; see `MatrixSources.md`.
`Generators/GenerateCertificates.py` reproducibly generates the checked rows.
-/

namespace HaradaNorton

set_option maxRecDepth 10000

/-- The reverse inverse identity follows from B² = B⁻¹ and associativity. -/
public theorem bInvMatrix_mul_bMatrix : bInvMatrix * bMatrix = 1 := by
  calc
    bInvMatrix * bMatrix = (bMatrix * bMatrix) * bMatrix :=
      congrArg (· * bMatrix) bMatrix_mul_self.symm
    _ = bMatrix * (bMatrix * bMatrix) := mul_assoc bMatrix bMatrix bMatrix
    _ = 1 := (congrArg (bMatrix * ·) bMatrix_mul_self).trans bMatrix_mul_inv

/-- The certified inverse of B belongs to the generated matrix monoid. -/
public theorem bInvMatrix_mem : bInvMatrix ∈ matrixMonoid := by
  rw [← bMatrix_mul_self]
  exact matrixMonoid.mul_mem bMatrix_mem bMatrix_mem

/-- The first ATLAS generator, with its certified inverse in the matrix monoid. -/
@[expose] public def a : HN where
  val := ⟨aMatrix, aMatrix_mem⟩
  inv := ⟨aMatrix, aMatrix_mem⟩
  val_inv := Subtype.ext aMatrix_mul_self
  inv_val := Subtype.ext aMatrix_mul_self

/-- The second ATLAS generator, with its certified inverse in the matrix monoid. -/
@[expose] public def b : HN where
  val := ⟨bMatrix, bMatrix_mem⟩
  inv := ⟨bInvMatrix, bInvMatrix_mem⟩
  val_inv := Subtype.ext bMatrix_mul_inv
  inv_val := Subtype.ext bInvMatrix_mul_bMatrix

/-- The first generator has the prescribed ATLAS matrix. -/
@[simp] public theorem matrixHom_a : matrixHom a = aMatrix := rfl
/-- The second generator has the prescribed ATLAS matrix. -/
@[simp] public theorem matrixHom_b : matrixHom b = bMatrix := rfl

/-- The first generator is an involution in the sense that its square is one. -/
public theorem a_sq : a ^ 2 = 1 := by
  rw [pow_two]
  apply matrixHom_injective
  rw [map_mul, matrixHom_a, map_one]
  exact aMatrix_mul_self

/-- The second generator has cube one. -/
public theorem b_cube : b ^ 3 = 1 := by
  rw [pow_succ, pow_two]
  apply matrixHom_injective
  rw [map_mul, map_mul, matrixHom_b, map_one]
  exact (congrArg (· * bMatrix) bMatrix_mul_self).trans bInvMatrix_mul_bMatrix

/-- The two certified generators generate the fixed finite group HN. -/
public theorem closure_generators : Subgroup.closure ({a, b} : Set HN) = ⊤ := by
  let S := Subgroup.closure ({a, b} : Set HN)
  have hle : matrixMonoid ≤ S.toSubmonoid.map matrixHom := by
    apply Submonoid.closure_le.mpr
    intro x hx
    rcases hx with rfl | hx
    · exact ⟨a, Subgroup.subset_closure (Set.mem_insert _ _), matrixHom_a⟩
    · rcases hx with rfl
      exact ⟨b, Subgroup.subset_closure
        (Set.mem_insert_of_mem _ (Set.mem_singleton _)), matrixHom_b⟩
  apply top_unique
  intro g _
  obtain ⟨x, hx, he⟩ := hle (matrixHom_mem g)
  exact matrixHom_injective he ▸ hx

/-- The fixed group HN is noncommutative. -/
public theorem not_isMulCommutative : ¬ IsMulCommutative HN := by
  intro h
  have he := congrArg matrixHom (h.is_comm.comm a b)
  simp only [map_mul, matrixHom_a, matrixHom_b] at he
  exact aMatrix_mul_bMatrix_ne he

end HaradaNorton
