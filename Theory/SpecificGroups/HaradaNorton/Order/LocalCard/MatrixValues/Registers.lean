/-!
# Images of the shared local word registers

Generated by `Generate.py` from the unchanged positive words in `../Words.lean`.
Every numerical product is checked by kernel reduction via the sound
packed-row checker; the external evaluator only proposes witnesses.
Matrix source and attribution: `../../../MatrixSources.md`.
-/

public section
namespace HaradaNorton.OrderCertificate.LocalMatrixValues

open HaradaNorton.WordCertificates

set_option maxRecDepth 10000

private instance entriesDecidable (A B : Matrix133) :
    Decidable (∀ i j : Fin 133, A i j = B i j) :=
  @Nat.decidableForallFin 133 _ (fun i =>
    @Nat.decidableForallFin 133 _ (fun j => ZMod.decidableEq 5 (A i j) (B i j)))

set_option maxHeartbeats 2000000 in
theorem image_a : matrixHom a = decode aPacked := by
  rw [matrixHom_a]
  symm
  apply Matrix.ext
  decide +kernel

set_option maxHeartbeats 2000000 in
theorem image_b : matrixHom b = decode bPacked := by
  rw [matrixHom_b]
  symm
  apply Matrix.ext
  decide +kernel

