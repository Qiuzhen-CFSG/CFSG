module

public import Theory.SpecificGroups.HaradaNorton.Generators

/-!
# A concrete word subgroup of the Harada–Norton matrix group

The ATLAS program `HNG1-max1W1` leaves its first input unchanged and replaces
its second input by the fifth power of a word of length 17. We transcribe that
word in the certified generators of the fixed matrix carrier. The last three
instructions of the program are verified by associativity below.

ATLAS labels the resulting subgroup `A₁₂`. This module defines the actual
subgroup, but does not assume that identification or either of the counts
listed with it. Those are the independent inputs to the order assembly.

Source: https://brauer.maths.qmul.ac.uk/Atlas/v3/subgroup/HNG1-max1W1 .
The original straight-line program and transcription notes are in `source/`.
-/

namespace HaradaNorton.OrderCertificate

/-- Register 10 of the ATLAS subgroup program, before its final powers. -/
@[expose] public def localBBase : HN :=
  let r3 := a * b
  let r4 := r3 * b
  let r5 := r3 * r4
  let r6 := r3 * r5
  let r8 := r6 * r5
  let r9 := r3 * r8
  r9 * r4

/-- The second output of the program; its first output is `a`. -/
@[expose] public def localB : HN := localBBase ^ 5

/-- The three final register assignments give exactly the stated fifth power. -/
public theorem localB_program :
    (let r10 := localBBase
     let r9 := r10 * r10
     let r8 := r10 * r9
     r9 * r8) = localB := by
  simp only [localB, pow_succ, pow_zero, one_mul, mul_assoc]

/-- The actual subgroup generated by the two outputs, with no order assumed. -/
@[expose] public def localSubgroup : Subgroup HN :=
  Subgroup.closure {a, localB}

public theorem a_mem_localSubgroup : a ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

public theorem localB_mem_localSubgroup : localB ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

end HaradaNorton.OrderCertificate
