module

public import Theory.SpecificGroups.HaradaNorton.MatrixData
public import Mathlib.Algebra.Group.Submonoid.Units
public import Mathlib.Data.Fintype.Pi

/-!
# A fixed finite matrix construction for Harada–Norton

Take the submonoid generated by the two explicit ATLAS matrices and then its
group of units. This defines a fixed finite group without an existence
certificate or any classification predicate. Once the generator inverse
identities have been certified, both matrices lift to this group and it is
the usual matrix group generated by them.

Finiteness follows by injection into the finite matrix algebra. The faithful
matrix homomorphism is exposed for subsequent order and simplicity proofs.
Those proofs and the generator inverse certificates are separate obligations;
this module does not infer them from the ATLAS designation or claimed order.

Source: ATLAS representation `HNG1-f5r133B0`; see `MatrixSources.md` and
`MatrixData`. The use of units of a generated monoid is an intrinsic algebraic
construction and does not require choosing an ambient abstract simple group.
-/

namespace HaradaNorton

/-- The concrete matrix monoid generated by the two ATLAS matrices. -/
@[expose] public def matrixMonoid : Submonoid Matrix133 :=
  Submonoid.closure {aMatrix, bMatrix}

/-- The fixed finite group of units of the ATLAS matrix monoid. -/
@[expose] public def HN : Type := matrixMonoidˣ
  deriving Group, Finite

/-- The first ATLAS matrix is in the generating monoid. -/
public theorem aMatrix_mem : aMatrix ∈ matrixMonoid :=
  Submonoid.subset_closure (Set.mem_insert _ _)

/-- The second ATLAS matrix is in the generating monoid. -/
public theorem bMatrix_mem : bMatrix ∈ matrixMonoid :=
  Submonoid.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The faithful interpretation of the fixed carrier as matrices. -/
@[expose] public def matrixHom : HN →* Matrix133 :=
  matrixMonoid.subtype.comp (Units.coeHom matrixMonoid)

/-- Distinct elements of the fixed carrier are distinct matrices. -/
public theorem matrixHom_injective : Function.Injective matrixHom := by
  intro x y h
  apply Units.ext
  exact Subtype.ext h

/-- Every matrix in the image is a product of the two fixed generators. -/
public theorem matrixHom_mem (g : HN) : matrixHom g ∈ matrixMonoid :=
  g.val.property

/-- The raw generator matrices do not commute, witnessed by entry `(0,1)`.
Lifting this fact to `HN` also requires the generator inverse certificates. -/
public theorem aMatrix_mul_bMatrix_ne : aMatrix * bMatrix ≠ bMatrix * aMatrix := by
  intro h
  have hentry := congrArg (fun m : Matrix133 => m 0 1) h
  have hne : (aMatrix * bMatrix) 0 1 ≠ (bMatrix * aMatrix) 0 1 := by decide +kernel
  exact hne hentry

end HaradaNorton
