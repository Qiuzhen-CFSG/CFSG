module

public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.Quotients
public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.QuadraticSpace
/-!
# The homomorphism to the twisted quadratic coordinates

The unique normal form defines a function on the concrete subgroup `Q1`.
The exact word product proves it is a homomorphism for the prescribed twisted
addition. Its kernel consists precisely of the four words generated by `z1N`
and `k1`; every coordinate has a word representative. Thus it induces an
isomorphism from the actual quotient by this kernel.

Source: Aschbacher, *Sporadic Groups*, Exercise 4.6(3), p. 64, and the
coordinate homomorphism used in Section 27, pp. 144–145. Products here use
left composition, and the code and cocode corrections are both retained.
-/

@[expose] public section
open Atlas.Fischer Atlas.Codes
noncomputable section
namespace Sporadic.Monster.Construction.TrialitySpin

theorem psi1N_sign (s : ParkerBit) (d : ParkerLoop) :
    psi1N (parkerSign s d) = z1N ^ s.val * psi1N d := by
  have hs : s = 0 ∨ s = 1 := by revert s; decide
  rcases hs with rfl | rfl
  · simp
  · apply Subtype.ext
    ext ⟨a,b,c⟩ : 1
    change psi1 (parkerSign 1 d) (a,b,c) = z1 (psi1 d (a,b,c))
    cases a <;> cases b <;> cases c <;>
      simp [loopInverse_sign,parkerLoopMultiply_sign_left,parkerLoopMultiply_sign_right,parkerSign_add]

theorem q1Word_sign (s : ParkerBit) (d : ParkerLoop) (t : ParkerBit) (c : Cocode) :
    (q1Word (parkerSign s d) t c).val = z1N ^ s.val * (q1Word d t c).val := by
  change (psiAut1N (parkerCocodeStandard c) * psi2N (0,t)) *
    psi1N (parkerSign s d) = _
  rw [psi1N_sign, ← mul_assoc]
  have hc : Commute (psiAut1N (parkerCocodeStandard c) * psi2N (0,t)) z1N :=
    Subgroup.mem_centralizer_singleton_iff.mp
      (N1.mul_mem (psiAut1N_mem_N1 _) (psi2N_mem_N1 _))
  rw [(hc.pow_right s.val).eq,mul_assoc]
  rfl

theorem q1Word_zero : (q1Word (0,0) 0 0).val = 1 := by
  have hc : parkerCocodeStandard 0 = 1 := parkerCocodeHom.map_one
  have h1 : psi1N loopOne = 1 := by
    apply Subtype.ext
    ext ⟨a,b,c⟩ : 1
    simp [psi1N]
  have h2 : psi2N loopOne = 1 := by
    apply Subtype.ext
    ext ⟨a,b,c⟩ : 1
    simp [psi2N]
  have ha : psiAut1N 1 = 1 := by
    apply Subtype.ext
    ext ⟨a,b,c⟩ : 1
    simp [psiAut1N,psiAut1,diagonal]
  change psiAut1N (parkerCocodeStandard 0) * psi2N loopOne * psi1N loopOne = 1
  rw [hc,ha,h1,h2,mul_one,mul_one]

def q1CoordinatesFn (q : Q1) : QuadraticCoordinates :=
  let p := q1WordEquiv.symm q
  q1WordCoordinates p.1 p.2.1 p.2.2

@[simp] theorem q1CoordinatesFn_param (d : ParkerLoop) (t : ParkerBit) (c : Cocode) :
    q1CoordinatesFn (q1Param (d,t,c)) = q1WordCoordinates d t c := by
  change q1CoordinatesFn (q1WordEquiv (d,t,c)) = _
  simp [q1CoordinatesFn]

theorem q1Param_mul (d e : ParkerLoop) (t s : ParkerBit) (c f : Cocode) :
    q1Param (d,t,c) * q1Param (e,s,f) =
      q1Param (parkerSign (q1WordProductSign d e t f) (d.1+e.1,0),
        t+s+golayHalfOverlap d.1 e.1, c+f+intersectionCocode d.1 e.1) := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul,q1Param_val,q1Word_sign,q1Word_mul]

def q1Coordinates : Q1 →* Multiplicative QuadraticCoordinates where
  toFun q := Multiplicative.ofAdd (q1CoordinatesFn q)
  map_one' := by
    have h : (1 : Q1) = q1Param ((0,0),0,0) := Subtype.ext q1Word_zero.symm
    rw [h,q1CoordinatesFn_param]
    rfl
  map_mul' a b := by
    obtain ⟨⟨d,t,c⟩,rfl⟩ := q1Param_bijective.surjective a
    obtain ⟨⟨e,s,f⟩,rfl⟩ := q1Param_bijective.surjective b
    simp only [q1Param_mul,q1CoordinatesFn_param]
    change q1WordCoordinates (parkerSign _ (d.1+e.1,0)) _ _ =
      coordinateSum (q1WordCoordinates d t c) (q1WordCoordinates e s f)
    exact q1WordCoordinates_sum d e t s c f

@[simp] theorem q1Coordinates_param (d : ParkerLoop) (t : ParkerBit) (c : Cocode) :
    q1Coordinates (q1Param (d,t,c)) = Multiplicative.ofAdd (q1WordCoordinates d t c) :=
  q1CoordinatesFn_param d t c

theorem q1Coordinates_surjective : Function.Surjective q1Coordinates := by
  intro x
  refine ⟨q1Param ((x.toAdd.code,0),0,x.toAdd.cocode),?_⟩
  rw [q1Coordinates_param]
  change q1WordCoordinates (x.toAdd.code,0) 0 x.toAdd.cocode = x.toAdd
  apply QuadraticCoordinates.ext <;> simp [q1WordCoordinates]

theorem q1Word_cocode_zero (d : ParkerLoop) (t : ParkerBit) :
    (q1Word d t 0).val = psi2N (0,t) * psi1N d := by
  have hc : parkerCocodeStandard 0 = 1 := parkerCocodeHom.map_one
  have ha : psiAut1N 1 = 1 := by
    apply Subtype.ext
    ext ⟨a,b,c⟩ : 1
    simp [psiAut1N,psiAut1,diagonal]
  change psiAut1N (parkerCocodeStandard 0) * psi2N (0,t) * psi1N d = _
  rw [hc,ha,one_mul]

theorem q1Word_omega : (q1Word parkerOmega 1 0).val = k1 := by
  rw [q1Word_cocode_zero,k1_eq_z2_mul_psi1_omega]
  rfl

theorem q1Coordinates_z1 : q1Coordinates ⟨z1N,z1N_mem_Q1⟩ = 1 := by
  have h : (⟨z1N,z1N_mem_Q1⟩ : Q1) = q1Param (loopPi,0,0) := by
    apply Subtype.ext
    have hs := q1Word_sign 1 (0,0) 0 0
    simpa [q1Word_zero,parkerSign,loopPi,show (1 : ParkerBit).val = 1 from rfl] using hs.symm
  rw [h,q1Coordinates_param]
  rfl

theorem q1Coordinates_k1 :
    q1Coordinates ⟨k1,K1_le_Q1 (Subgroup.mem_zpowers k1)⟩ = 1 := by
  have h : (⟨k1,K1_le_Q1 (Subgroup.mem_zpowers k1)⟩ : Q1) =
      q1Param (parkerOmega,1,0) := Subtype.ext q1Word_omega.symm
  rw [h,q1Coordinates_param]
  change q1WordCoordinates parkerOmega 1 0 = (0 : QuadraticCoordinates)
  apply QuadraticCoordinates.ext <;> simp [q1WordCoordinates,parkerOmega,
    quadraticCoordinates_zero_eq,coordinateZero,parkerGolay_add_self]

theorem q1Coordinates_kernel_map : q1Coordinates.ker.map Q1.subtype = Q1CentralKernel := by
  apply le_antisymm
  · rintro g ⟨q,hq,rfl⟩
    obtain ⟨⟨⟨a,b⟩,t,c⟩,rfl⟩ := q1Param_bijective.surjective q
    change q1Coordinates (q1Param ((a,b),t,c)) = 1 at hq
    rw [q1Coordinates_param] at hq
    change q1WordCoordinates (a,b) t c = (0 : QuadraticCoordinates) at hq
    have ha : a + t • golayOne = 0 := congrArg QuadraticCoordinates.code hq
    have hc : c = 0 := congrArg QuadraticCoordinates.cocode hq
    subst c
    have ht : t = 0 ∨ t = 1 := (by decide : ∀ t : ParkerBit, t = 0 ∨ t = 1) t
    have hz : z1N ∈ Q1CentralKernel := Subgroup.subset_closure (by simp)
    have hk : k1 ∈ Q1CentralKernel := Subgroup.subset_closure (by simp)
    rcases ht with rfl | rfl
    · simp only [zero_smul,add_zero] at ha
      subst a
      change (q1Word (0,b) 0 0).val ∈ Q1CentralKernel
      rw [show (0,b) = parkerSign b (0,0) by simp [parkerSign],q1Word_sign,
        q1Word_zero,mul_one]
      exact Q1CentralKernel.pow_mem hz _
    · simp only [one_smul] at ha
      have ha' : a = golayOne := by
        have h := congrArg (· + golayOne) ha
        simpa [add_assoc,parkerGolay_add_self] using h
      subst a
      change (q1Word (golayOne,b) 1 0).val ∈ Q1CentralKernel
      rw [show (golayOne,b) = parkerSign b parkerOmega by simp [parkerSign,parkerOmega],
        q1Word_sign,q1Word_omega]
      exact Q1CentralKernel.mul_mem (Q1CentralKernel.pow_mem hz _) hk
  · apply (Subgroup.closure_le _).mpr
    rintro g (rfl | rfl)
    · exact ⟨⟨z1N,z1N_mem_Q1⟩,q1Coordinates_z1,rfl⟩
    · exact ⟨⟨k1,K1_le_Q1 (Subgroup.mem_zpowers k1)⟩,q1Coordinates_k1,rfl⟩

theorem q1Coordinates_kernel : q1Coordinates.ker = Q1CentralKernel.subgroupOf Q1 := by
  rw [← q1Coordinates_kernel_map]
  exact (Subgroup.comap_map_eq_self_of_injective Q1.subtype_injective _).symm

instance Q1CentralKernel_normal_in_Q1 : (Q1CentralKernel.subgroupOf Q1).Normal :=
  q1Coordinates_kernel ▸ q1Coordinates.normal_ker

/-- The actual quadratic quotient, not the ordinary product addition. -/
def q1QuadraticQuotientEquiv : (Q1 ⧸ Q1CentralKernel.subgroupOf Q1) ≃*
    Multiplicative QuadraticCoordinates :=
  QuotientGroup.liftEquiv _ q1Coordinates_surjective q1Coordinates_kernel.symm

end Sporadic.Monster.Construction.TrialitySpin
