module

public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.Quotients
/-!
# The local quotient and its intrinsic centralizer

The quotient `N1/K` is identified with the image of `N1` inside `N/K` by the
canonical quotient map. Relative normality of `Q1` descends to this image,
and its centralizer is precisely the cyclic subgroup generated by `z1 K`.

Source: Aschbacher, *Sporadic Groups*, Lemma 14.4(1–2), pp. 61–62.
-/

@[expose] public section
noncomputable section
namespace Sporadic.Monster.Construction.TrialitySpin

def n1ImageMap : N1 →* N1Image :=
  (nQuotientMap.comp N1.subtype).codRestrict N1Image
    (fun g => ⟨g.val,g.prop,rfl⟩)

theorem n1ImageMap_surjective : Function.Surjective n1ImageMap := by
  rintro ⟨x,g,hg,rfl⟩
  exact ⟨⟨g,hg⟩,rfl⟩

theorem n1ImageMap_ker : n1ImageMap.ker = K.subgroupOf N1 := by
  ext g
  change n1ImageMap g = 1 ↔ g.val ∈ K
  rw [Subtype.ext_iff]
  exact nQuotientMap_eq_one g.val

abbrev N1Quotient := N1 ⧸ K.subgroupOf N1

/-- The literal local quotient is the local subgroup of `N/K`. -/
def n1QuotientEquivImage : N1Quotient ≃* N1Image :=
  QuotientGroup.liftEquiv _ n1ImageMap_surjective n1ImageMap_ker.symm

@[simp] theorem n1QuotientEquivImage_mk (g : N1) :
    n1QuotientEquivImage (QuotientGroup.mk' (K.subgroupOf N1) g) =
      n1ImageMap g := rfl

theorem Q1_subgroupOf_image : (Q1.subgroupOf N1).map n1ImageMap =
    Q1Image.subgroupOf N1Image := by
  ext x
  constructor
  · rintro ⟨g,hg,rfl⟩
    exact ⟨g.val,hg,rfl⟩
  · rintro ⟨q,hq,hqx⟩
    exact ⟨⟨q,Q1_le_N1 hq⟩,hq,Subtype.ext hqx⟩

theorem Q1Image_normal_in_N1Image : (Q1Image.subgroupOf N1Image).Normal := by
  rw [← Q1_subgroupOf_image]
  exact Q1_normal_in_N1.map n1ImageMap n1ImageMap_surjective

def n1ImageCenterGenerator : N1Image :=
  ⟨z1Image,Q1Image_le_N1Image z1Image_mem_Q1Image⟩

/-- The centralizer inside `N1/K`, expressed via its canonical image. -/
theorem Q1Image_centralizer_in_N1Image :
    Subgroup.centralizer (Q1Image.subgroupOf N1Image : Set N1Image) =
      Subgroup.zpowers n1ImageCenterGenerator := by
  ext x
  have hc : x ∈ Subgroup.centralizer (Q1Image.subgroupOf N1Image : Set N1Image) ↔
      x.val ∈ Subgroup.centralizer (Q1Image : Set NQuotient) := by
    constructor
    · intro h q hq
      exact congrArg Subtype.val (h ⟨q,Q1Image_le_N1Image hq⟩ hq)
    · intro h q hq
      exact Subtype.ext (h q.val hq)
  rw [hc]
  have hc' : x.val ∈ Subgroup.centralizer (Q1Image : Set NQuotient) ↔
      x.val ∈ N1Image ⊓ Subgroup.centralizer (Q1Image : Set NQuotient) :=
    ⟨fun h => ⟨x.prop,h⟩,fun h => h.2⟩
  rw [hc',Q1Image_centralizer]
  change x.val ∈ Subgroup.zpowers (N1Image.subtype n1ImageCenterGenerator) ↔ _
  rw [← MonoidHom.map_zpowers]
  constructor
  · rintro ⟨y,hy,he⟩
    exact (Subtype.ext he : y = x) ▸ hy
  · intro hx
    exact ⟨x,hx,rfl⟩

end Sporadic.Monster.Construction.TrialitySpin
