module

public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.NormalForms.Coordinates

/-!
# Relations for collecting Parker triality words

The first-family multiplication law and the cross-family interchange law are
proved on each coordinate from the loop associator and the polarizations of
Golay weight. Their correction factors are the actual associator automorphism
and the third sign permutation. The octads indexed by `0` and `8` have odd
half-overlap, so the first law puts `z3N`, and hence `z2N`, in the source `Q1`.
The three-family product and first-family inverse formulas are also proved.

`collectionSubgroup` is generated by the three loop families and the first
standard-automorphism family. Its containment in the actual centralizer `N1`
is proved here. The reverse containment and collection of all its elements
into normal-form words remain separate obligations.

Source: Aschbacher, *Sporadic Groups*, Remark 14.1 and Lemmas 14.2(3,7,10),
14.3(1), and 14.4(4), printed pp. 58–62 (PDF pp. 35–37).
The source uses right actions; the multiplication and conjugation formulas
below reverse the source products to use Lean's left composition.
-/

@[expose] public section
open Atlas.Fischer Atlas.Codes
noncomputable section
namespace Sporadic.Monster.Construction.TrialitySpin

private theorem triple_add_right (a b c d : BinaryWord) :
    parkerTripleIntersection a b (c + d) =
      parkerTripleIntersection a b c + parkerTripleIntersection a b d := by
  simp only [parkerTripleIntersection, Pi.add_apply, mul_add, Finset.sum_add_distrib]

private theorem triple_swap_left (a b c : golay) :
    parkerTripleIntersection a b c = parkerTripleIntersection b a c := by
  rw [parkerTripleIntersection_swap, parkerTripleIntersection_cycle]

private theorem triple_repeat_first (a b : golay) :
    parkerTripleIntersection a b a = 0 := by
  rw [triple_swap_left, parkerTripleIntersection_repeat]

private theorem triple_sum (a b c : golay) :
    parkerTripleIntersection a b (b + a + c) = parkerTripleIntersection a b c := by
  rw [triple_add_right, triple_add_right, parkerTripleIntersection_repeat,
    triple_repeat_first, zero_add, zero_add]

private theorem sign_mul_left (s : ParkerBit) (a : ParkerLoop) :
    parkerLoopMultiply (0,s) a = parkerSign s a := by
  simp [parkerLoopMultiply, parkerMultiply, parkerSign, add_comm]

private theorem sign_mul_right (s : ParkerBit) (a : ParkerLoop) :
    parkerLoopMultiply a (0,s) = parkerSign s a := by
  simp [parkerLoopMultiply, parkerMultiply, parkerSign]

/-- Aschbacher 14.2(7), in left-composition order. -/
theorem psi1N_mul_collection (d e : ParkerLoop) :
    psi1N e * psi1N d =
      psiAut1N (associatorAutomorphism e.1 d.1) *
        psi3N (0, golayHalfOverlap e.1 d.1) * psi1N (parkerLoopMultiply d e) := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, psi1N, psi3N, psiAut1N]
  rw [psiAut1, if_pos (associatorAutomorphism_even e.1 d.1)]
  ext ⟨a,b,c⟩ : 1
  simp only [Equiv.Perm.mul_apply, diagonal, Equiv.prodCongr_apply,
    psi1_apply, psi3_apply]
  apply Prod.ext
  · cases a with
    | none => rfl
    | some a =>
      simp only [leftZero_some, rightZero_some,
        normalForm_sandwich, sign_mul_left,
        parkerSign_add]
      apply congrArg some
      rw [associatorAutomorphism_apply, parkerSign_add]
      change parkerSign (golayQuarterWeight e.1 + golayHalfOverlap e.1 a.1 +
          (golayQuarterWeight d.1 + golayHalfOverlap d.1 a.1)) a =
        parkerSign (parkerTripleIntersection e.1 d.1 a.1 +
          (golayHalfOverlap e.1 d.1 +
            (golayQuarterWeight (d.1+e.1) + golayHalfOverlap (d.1+e.1) a.1))) a
      rw [golayQuarterWeight_add, golayHalfOverlap_add_left,
        triple_swap_left e.1 d.1 a.1, golayHalfOverlap_symmetric e.1 d.1]
      apply congrArg (fun s : ParkerBit => parkerSign s a)
      ring_nf
      simp
  · apply Prod.ext
    · cases b with
      | none => rfl
      | some b =>
        simp only [leftZero_some, rightZero_some,
          sign_mul_right]
        apply congrArg some
        rw [associatorAutomorphism_apply, parkerSign_add]
        have ht : parkerTripleIntersection e.1 d.1
            (parkerSign (golayHalfOverlap e.1 d.1)
              (parkerLoopMultiply (parkerLoopMultiply d e) b)).1 =
            parkerTripleIntersection e.1 d.1 b.1 := triple_sum e.1 d.1 b.1
        rw [ht]
        have h := parkerLoopMultiply_associator e d b
        rw [parkerLoopMultiply_commutator e d, parkerLoopMultiply_sign_left] at h
        have hh := congrArg (parkerSign (parkerTripleIntersection e.1 d.1 b.1)) h
        simpa only [parkerSign_add, CharTwo.add_self_eq_zero, parkerSign_zero] using hh.symm
    · cases c with
      | none => rfl
      | some c =>
        simp only [leftZero_some, rightZero_some,
          normalForm_sandwich, golayQuarterWeight_zero, golayHalfOverlap_zero_left,
          zero_add, parkerSign_zero]
        apply congrArg some
        rw [associatorAutomorphism_apply]
        change parkerLoopMultiply (parkerLoopMultiply c d) e =
          parkerSign (parkerTripleIntersection e.1 d.1 (c.1+(d.1+e.1)))
            (parkerLoopMultiply c (parkerLoopMultiply d e))
        rw [add_comm (c.1 : BinaryWord), triple_sum, parkerLoopMultiply_associator,
          parkerTripleIntersection_cycle c.1 d.1 e.1,
          parkerTripleIntersection_swap e.1 c.1 d.1]

private theorem leftZero_inverse_left (d : ParkerLoop) (a : LoopZero) :
    leftZero (loopInverse d) (leftZero d a) = a := by
  cases a <;> simp

private theorem leftZero_inverse_right (d : ParkerLoop) (a : LoopZero) :
    leftZero d (leftZero (loopInverse d) a) = a := by
  simpa only [loopInverse_inverse] using leftZero_inverse_left (loopInverse d) a

private theorem rightZero_inverse_left (d : ParkerLoop) (a : LoopZero) :
    rightZero (loopInverse d) (rightZero d a) = a := by
  cases a <;> simp

private theorem rightZero_inverse_right (d : ParkerLoop) (a : LoopZero) :
    rightZero d (rightZero (loopInverse d) a) = a := by
  simpa only [loopInverse_inverse] using rightZero_inverse_left (loopInverse d) a

/-- Aschbacher 14.3(1), with the source factors reversed. -/
theorem psi3N_mul_psi2N_mul_psi1N (d : ParkerLoop) :
    psi3N d * psi2N d * psi1N d = 1 := by
  apply Subtype.ext
  ext ⟨a,b,c⟩ : 1
  change psi3 d (psi2 d (psi1 d (a,b,c))) = (a,b,c)
  simp only [psi1_apply, psi2_apply, psi3_apply,
    leftZero_inverse_left, leftZero_inverse_right,
    rightZero_inverse_left, rightZero_inverse_right]

private theorem golay_halfOverlap_basis_pair :
    golayHalfOverlap (golayBasis 0) (golayBasis 8) = 1 := by
  unfold golayHalfOverlap
  rw [golayBasis_coe, golayBasis_coe]
  decide

/-- Every standard automorphism in the Golay-action kernel gives a `Q1` generator. -/
theorem psiAut1N_mem_Q1_of_sign (α : ParkerStandardGroup)
    (hα : IsSignAutomorphism α.val) : psiAut1N α ∈ Q1 :=
  Subgroup.subset_closure (Or.inr ⟨α.val,hα,rfl⟩)

/-- The associator correction is one of the sign-automorphism generators. -/
theorem associatorAut_mem_Q1 (a b : golay) :
    psiAut1N (associatorAutomorphism a b) ∈ Q1 :=
  psiAut1N_mem_Q1_of_sign _ ((parkerStandardProjection_eq_one_iff _).mp
    (parkerCocodeStandard_projection (intersectionCocode a b)))

/-- The third sign involution is forced by the loop-generator multiplication law. -/
theorem z3N_mem_Q1 : z3N ∈ Q1 := by
  let d : ParkerLoop := (golayBasis 8,0)
  let e : ParkerLoop := (golayBasis 0,0)
  have h := psi1N_mul_collection d e
  have hc : golayHalfOverlap e.1 d.1 = 1 := golay_halfOverlap_basis_pair
  rw [hc] at h
  have hm (x : ParkerLoop) : psi1N x ∈ Q1 :=
    Subgroup.subset_closure (Or.inl ⟨x,rfl⟩)
  have hh : psiAut1N (associatorAutomorphism e.1 d.1) * z3N ∈ Q1 := by
    apply (Q1.mul_mem_cancel_right (hm (parkerLoopMultiply d e))).mp
    exact h ▸ Q1.mul_mem (hm e) (hm d)
  exact (Q1.mul_mem_cancel_left (associatorAut_mem_Q1 e.1 d.1)).mp hh

/-- The second sign involution belongs to the source subgroup, unconditionally. -/
theorem z2N_mem_Q1 : z2N ∈ Q1 := by
  have hz1 : z1N ∈ Q1 := Subgroup.subset_closure (Or.inl ⟨loopPi,rfl⟩)
  have hh : z1N * z2N ∈ Q1 := by
    apply (Q1.mul_mem_cancel_right z3N_mem_Q1).mp
    rw [z1N_z2N_z3N]
    exact Q1.one_mem
  exact (Q1.mul_mem_cancel_left hz1).mp hh


private theorem overlap_add_right (a b c : golay) :
    golayHalfOverlap a (b+c) = golayHalfOverlap a b + golayHalfOverlap a c +
      parkerTripleIntersection a b c := by
  rw [golayHalfOverlap_symmetric a (b+c), golayHalfOverlap_add_left,
    golayHalfOverlap_symmetric b a, golayHalfOverlap_symmetric c a,
    parkerTripleIntersection_cycle b c a]

/-- The multiplication version of Aschbacher 14.2(10).
Multiplication by `(psi2N e)⁻¹` on the right recovers the printed conjugation formula. -/
theorem psi2N_mul_psi1N_collection (d e : ParkerLoop) :
    psi2N e * psi1N d =
      psiAut1N (associatorAutomorphism e.1 d.1) *
        psi3N (0, golayHalfOverlap e.1 d.1) * psi1N d * psi2N e := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, psi1N, psi2N, psi3N, psiAut1N]
  rw [psiAut1, if_pos (associatorAutomorphism_even e.1 d.1)]
  ext ⟨a,b,c⟩ : 1
  simp only [Equiv.Perm.mul_apply, diagonal, Equiv.prodCongr_apply,
    psi1_apply, psi2_apply, psi3_apply]
  apply Prod.ext
  · cases a with
    | none => rfl
    | some a =>
      simp only [leftZero_some, rightZero_some, normalForm_sandwich,
        parkerLoopMultiply_sign_left, sign_mul_left]
      apply congrArg some
      rw [associatorAutomorphism_apply]
      simp only [parkerSign_add]
      change parkerSign (golayQuarterWeight d.1 + golayHalfOverlap d.1 a.1)
          (parkerLoopMultiply a e) =
        parkerSign (parkerTripleIntersection e.1 d.1 (a.1+e.1) +
          (golayHalfOverlap e.1 d.1 +
            (golayQuarterWeight d.1 + golayHalfOverlap d.1 (a.1+e.1))))
          (parkerLoopMultiply a e)
      rw [overlap_add_right, triple_add_right, triple_repeat_first,
        add_zero, golayHalfOverlap_symmetric d.1 e.1,
        parkerTripleIntersection_cycle d.1 a.1 e.1]
      apply congrArg (fun s : ParkerBit => parkerSign s (parkerLoopMultiply a e))
      ring_nf
      simp
  · apply Prod.ext
    · cases b with
      | none => rfl
      | some b =>
        simp only [leftZero_some, rightZero_some, normalForm_sandwich,
          parkerLoopMultiply_sign_right, sign_mul_right]
        apply congrArg some
        rw [associatorAutomorphism_apply]
        simp only [parkerSign_add]
        change parkerSign (golayQuarterWeight e.1 + golayHalfOverlap e.1 (d.1+b.1))
            (parkerLoopMultiply d b) =
          parkerSign (parkerTripleIntersection e.1 d.1 (d.1+b.1) +
            (golayHalfOverlap e.1 d.1 +
              (golayQuarterWeight e.1 + golayHalfOverlap e.1 b.1)))
            (parkerLoopMultiply d b)
        rw [overlap_add_right, triple_add_right, parkerTripleIntersection_repeat, zero_add]
        apply congrArg (fun s : ParkerBit => parkerSign s (parkerLoopMultiply d b))
        ring
    · cases c with
      | none => rfl
      | some c =>
        simp only [leftZero_some, rightZero_some, normalForm_sandwich,
          golayQuarterWeight_zero, golayHalfOverlap_zero_left, zero_add, parkerSign_zero]
        apply congrArg some
        rw [associatorAutomorphism_apply]
        change parkerLoopMultiply e (parkerLoopMultiply c d) =
          parkerSign (parkerTripleIntersection e.1 d.1 (e.1+c.1+d.1))
            (parkerLoopMultiply (parkerLoopMultiply e c) d)
        rw [triple_add_right, triple_add_right, triple_repeat_first,
          parkerTripleIntersection_repeat, zero_add, add_zero,
          parkerTripleIntersection_swap e.1 d.1 c.1]
        have h := congrArg (parkerSign (parkerTripleIntersection e.1 c.1 d.1))
          (parkerLoopMultiply_associator e c d)
        simpa only [parkerSign_add, CharTwo.add_self_eq_zero, parkerSign_zero] using h.symm


/-- Aschbacher 14.2(10), with conjugation translated to left composition. -/
theorem psi2N_conj_psi1N (d e : ParkerLoop) :
    psi2N e * psi1N d * (psi2N e)⁻¹ =
      psiAut1N (associatorAutomorphism e.1 d.1) *
        psi3N (0, golayHalfOverlap e.1 d.1) * psi1N d := by
  rw [psi2N_mul_psi1N_collection, mul_inv_cancel_right]

/-- The inverse-property formula for the first family, from Aschbacher 14.2(3). -/
theorem psi1N_inv (d : ParkerLoop) : (psi1N d)⁻¹ = psi1N (loopInverse d) := by
  apply inv_eq_of_mul_eq_one_left
  apply Subtype.ext
  simp only [Subgroup.coe_mul, psi1N, Subgroup.coe_one]
  ext ⟨a,b,c⟩ : 1
  simp only [Equiv.Perm.mul_apply, psi1_apply,
    leftZero_inverse_left, rightZero_inverse_left, Equiv.Perm.one_apply]
  refine Prod.ext ?_ rfl
  cases a with
  | none => rfl
  | some a =>
    simp only [leftZero_some, rightZero_some, normalForm_sandwich, parkerSign_add]
    apply congrArg some
    change parkerSign ((golayQuarterWeight d.1 + golayHalfOverlap d.1 a.1) +
      (golayQuarterWeight d.1 + golayHalfOverlap d.1 a.1)) a = a
    rw [CharTwo.add_self_eq_zero, parkerSign_zero]

/-- The subgroup generated by the four families that already centralize `z1N`.
Its equality with `N1` is a generation theorem, not part of this definition. -/
def collectionSubgroup : Subgroup N := Subgroup.closure
  (Set.range psi1N ∪ Set.range psi2N ∪ Set.range psi3N ∪ Set.range psiAut1N)

theorem collectionSubgroup_le_N1 : collectionSubgroup ≤ N1 := by
  apply (Subgroup.closure_le _).mpr
  rintro g (((⟨d,rfl⟩ | ⟨e,rfl⟩) | ⟨f,rfl⟩) | ⟨α,rfl⟩)
  · exact psi1N_mem_N1 d
  · exact psi2N_mem_N1 e
  · exact psi3N_mem_N1 f
  · exact psiAut1N_mem_N1 α

theorem normalForm_mem_collectionSubgroup (d e : ParkerLoop) (α : ParkerStandardGroup) :
    (normalForm d e α).val ∈ collectionSubgroup := by
  apply collectionSubgroup.mul_mem
  · apply collectionSubgroup.mul_mem
    · exact Subgroup.subset_closure (Or.inr ⟨α,rfl⟩)
    · exact Subgroup.subset_closure (Or.inl (Or.inl (Or.inr ⟨e,rfl⟩)))
  · exact Subgroup.subset_closure (Or.inl (Or.inl (Or.inl ⟨d,rfl⟩)))

end Sporadic.Monster.Construction.TrialitySpin
