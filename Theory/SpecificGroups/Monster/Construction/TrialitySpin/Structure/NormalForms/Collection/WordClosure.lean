module

public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.NormalForms.Collection.Relations

/-!
# Collection in the subgroup generated by the four triality families

Every element of `collectionSubgroup` is an actual word
`psiAut1N α * psi2N e * psi1N d`, with precisely the existing `normalForm`
parameters. This proves the collection part of the normal-form existence
argument; identifying this subgroup with `N1` is a separate generation result.

The loop multiplication law is transported by cyclic coordinate permutation.
Together with the interchange law and the sign corrections, it shows that
words with even automorphism parameter are stable under the loop families.
For a finite set, injective left multiplication preserving the set also has
an inverse preserving it. Finally, the even/odd automorphism identities move
any loop generator past an arbitrary standard automorphism, so subgroup
closure induction collects all four generating families.

Source: Aschbacher, *Sporadic Groups*, Section 14, Remark 14.1 and
Lemmas 14.2–14.4, printed pp. 58–62 (PDF pp. 35–37). The source acts on the
right; all products here use Lean's left-composition convention.
-/

@[expose] public section

open Atlas.Fischer Atlas.Codes
noncomputable section
namespace Sporadic.Monster.Construction.TrialitySpin

private theorem inverse_product (d e : ParkerLoop) :
    loopInverse (parkerLoopMultiply d e) =
      parkerLoopMultiply (loopInverse e) (loopInverse d) := by
  rw [loopInverse, loopInverse, loopInverse, parkerLoopMultiply_sign_left,
    parkerLoopMultiply_sign_right, parkerLoopMultiply_commutator e d,
    parkerSign_add, parkerSign_add]
  change parkerSign (golayQuarterWeight (d.1 + e.1)) _ = _
  rw [golayQuarterWeight_add, golayHalfOverlap_symmetric e.1 d.1,
    add_comm (golayQuarterWeight d.1) (golayQuarterWeight e.1)]

private theorem diagonal_mul (α β : ParkerStandardGroup) :
    diagonal (α * β).val = diagonal α.val * diagonal β.val := by
  ext ⟨a,b,c⟩ : 1
  cases a <;> cases b <;> cases c <;> rfl

private theorem diagonal_flip (α : ParkerStandardGroup) :
    diagonal α.val * flip1 = flip1 * diagonal α.val := by
  ext ⟨a,b,c⟩ : 1
  have hi (a : LoopZero) : (inverseZero a).map α.val = inverseZero (a.map α.val) := by
    cases a with
    | none => rfl
    | some a => exact congrArg some (parkerStandard_preserves_inverse α a)
  exact Prod.ext (hi a) (Prod.ext (hi c) (hi b))

private theorem flip_sq : flip1 * flip1 = 1 := by
  ext ⟨a,b,c⟩ : 1
  simp [flip1, Equiv.Perm.mul_apply]

private theorem even_mul_iff (α β : ParkerStandardGroup) :
    (α * β).val parkerOmega = parkerOmega ↔
      (α.val parkerOmega = parkerOmega ↔ β.val parkerOmega = parkerOmega) := by
  have hs : ∀ s : Bit, s = 0 ∨ s = 1 := by decide
  have h (γ : ParkerStandardGroup) :
      γ.val parkerOmega = parkerOmega ↔ (γ.val parkerOmega).2 = 0 :=
    (parkerStandardPlus_iff γ).symm
  rw [h, h, h]
  have hm := congrArg Multiplicative.toAdd (map_mul parkerStandardParity α β)
  change ((α * β).val parkerOmega).2 = (α.val parkerOmega).2 + (β.val parkerOmega).2 at hm
  rw [hm]
  rcases hs (α.val parkerOmega).2 with ha | ha <;>
    rcases hs (β.val parkerOmega).2 with hb | hb <;> simp [ha,hb]

private theorem aut_mul (α β : ParkerStandardGroup) :
    psiAut1N (α * β) = psiAut1N α * psiAut1N β := by
  apply Subtype.ext
  change psiAut1 (α * β).val = psiAut1 α.val * psiAut1 β.val
  have ht (e : Equiv.Perm ParkerLoop) : flip1.trans (diagonal e) = diagonal e * flip1 := rfl
  simp only [psiAut1, ht, even_mul_iff]
  by_cases ha : α.val parkerOmega = parkerOmega <;>
    by_cases hb : β.val parkerOmega = parkerOmega <;>
    simp only [ha, hb, iff_true, iff_false, not_true_eq_false, ↓reduceIte, diagonal_mul]
  · rw [mul_assoc]
  · rw [mul_assoc, diagonal_flip, ← mul_assoc]
  · calc
      _ = diagonal α.val * (diagonal β.val * (flip1 * flip1)) := by rw [flip_sq, mul_one]
      _ = diagonal α.val * ((diagonal β.val * flip1) * flip1) := by rw [mul_assoc]
      _ = diagonal α.val * ((flip1 * diagonal β.val) * flip1) := by rw [diagonal_flip]
      _ = _ := by simp only [mul_assoc]

private theorem aut_one : psiAut1N 1 = 1 := by
  apply Subtype.ext
  change psiAut1 (1 : ParkerStandardGroup).val = 1
  simp only [psiAut1, Subgroup.coe_one, Equiv.Perm.one_apply, ↓reduceIte]
  ext ⟨a,b,c⟩ : 1
  cases a <;> cases b <;> cases c <;> rfl

private theorem diagonal_left (α : ParkerStandardGroup) (d : ParkerLoop) (a : LoopZero) :
    (leftZero d a).map α.val = leftZero (α.val d) (a.map α.val) := by
  cases a with
  | none => rfl
  | some a => exact congrArg some (α.prop.1 d a)

private theorem diagonal_right (α : ParkerStandardGroup) (d : ParkerLoop) (a : LoopZero) :
    (rightZero d a).map α.val = rightZero (α.val d) (a.map α.val) := by
  cases a with
  | none => rfl
  | some a => exact congrArg some (α.prop.1 a d)

private theorem diagonal_psi1 (α : ParkerStandardGroup) (d : ParkerLoop) :
    diagonal α.val * psi1 d = psi1 (α.val d) * diagonal α.val := by
  ext ⟨a,b,c⟩ : 1
  simp only [Equiv.Perm.mul_apply, psi1_apply, diagonal, Equiv.prodCongr_apply, Prod.map_apply, Equiv.optionCongr_apply,
    diagonal_left, diagonal_right, parkerStandard_preserves_inverse]

private theorem diagonal_psi2 (α : ParkerStandardGroup) (d : ParkerLoop) :
    diagonal α.val * psi2 d = psi2 (α.val d) * diagonal α.val := by
  ext ⟨a,b,c⟩ : 1
  simp only [Equiv.Perm.mul_apply, psi2_apply, diagonal, Equiv.prodCongr_apply, Prod.map_apply, Equiv.optionCongr_apply,
    diagonal_left, diagonal_right, parkerStandard_preserves_inverse]

private theorem diagonal_psi3 (α : ParkerStandardGroup) (d : ParkerLoop) :
    diagonal α.val * psi3 d = psi3 (α.val d) * diagonal α.val := by
  ext ⟨a,b,c⟩ : 1
  simp only [Equiv.Perm.mul_apply, psi3_apply, diagonal, Equiv.prodCongr_apply, Prod.map_apply, Equiv.optionCongr_apply,
    diagonal_left, diagonal_right, parkerStandard_preserves_inverse]

private theorem inverse_left (d : ParkerLoop) (a : LoopZero) :
    inverseZero (leftZero d a) = rightZero (loopInverse d) (inverseZero a) := by
  cases a with
  | none => rfl
  | some a => exact congrArg some (inverse_product d a)

private theorem inverse_right (d : ParkerLoop) (a : LoopZero) :
    inverseZero (rightZero d a) = leftZero (loopInverse d) (inverseZero a) := by
  cases a with
  | none => rfl
  | some a => exact congrArg some (inverse_product a d)

private theorem sandwich_flexible (d : ParkerLoop) (a : LoopZero) :
    leftZero d (rightZero d a) = rightZero d (leftZero d a) := by
  cases a with
  | none => rfl
  | some a =>
    simp only [leftZero_some, rightZero_some]
    rw [parkerLoopMultiply_associator, parkerTripleIntersection_cycle,
      parkerTripleIntersection_cycle, parkerTripleIntersection_repeat, parkerSign_zero]

private theorem flip_psi1 (d : ParkerLoop) :
    flip1 * psi1 d = psi1 (loopInverse d) * flip1 := by
  ext ⟨a,b,c⟩ : 1
  simp only [Equiv.Perm.mul_apply, psi1_apply, flip1, Equiv.coe_fn_mk,
    inverse_left, inverse_right, loopInverse_inverse, sandwich_flexible]

private theorem flip_psi2 (d : ParkerLoop) :
    flip1 * psi2 d = psi3 (loopInverse d) * flip1 := by
  ext ⟨a,b,c⟩ : 1
  simp only [Equiv.Perm.mul_apply, psi2_apply, psi3_apply, flip1, Equiv.coe_fn_mk,
    inverse_left, inverse_right, loopInverse_inverse, sandwich_flexible]

private theorem flip_psi3 (d : ParkerLoop) :
    flip1 * psi3 d = psi2 (loopInverse d) * flip1 := by
  ext ⟨a,b,c⟩ : 1
  simp only [Equiv.Perm.mul_apply, psi2_apply, psi3_apply, flip1, Equiv.coe_fn_mk,
    inverse_left, inverse_right, loopInverse_inverse, sandwich_flexible]


private theorem aut_psi1_even (α : ParkerStandardGroup)
    (hα : α.val parkerOmega = parkerOmega) (d : ParkerLoop) :
    psiAut1N α * psi1N d = psi1N (α.val d) * psiAut1N α := by
  apply Subtype.ext
  change psiAut1 α.val * psi1 d = psi1 (α.val d) * psiAut1 α.val
  simpa only [psiAut1, if_pos hα] using diagonal_psi1 α d

private theorem aut_psi2_even (α : ParkerStandardGroup)
    (hα : α.val parkerOmega = parkerOmega) (d : ParkerLoop) :
    psiAut1N α * psi2N d = psi2N (α.val d) * psiAut1N α := by
  apply Subtype.ext
  change psiAut1 α.val * psi2 d = psi2 (α.val d) * psiAut1 α.val
  simpa only [psiAut1, if_pos hα] using diagonal_psi2 α d

private theorem aut_psi3_even (α : ParkerStandardGroup)
    (hα : α.val parkerOmega = parkerOmega) (d : ParkerLoop) :
    psiAut1N α * psi3N d = psi3N (α.val d) * psiAut1N α := by
  apply Subtype.ext
  change psiAut1 α.val * psi3 d = psi3 (α.val d) * psiAut1 α.val
  simpa only [psiAut1, if_pos hα] using diagonal_psi3 α d

private theorem aut_psi1_odd (α : ParkerStandardGroup)
    (hα : α.val parkerOmega ≠ parkerOmega) (d : ParkerLoop) :
    psiAut1N α * psi1N d = psi1N (α.val (loopInverse d)) * psiAut1N α := by
  apply Subtype.ext
  change psiAut1 α.val * psi1 d = psi1 (α.val (loopInverse d)) * psiAut1 α.val
  rw [psiAut1, if_neg hα]
  change diagonal α.val * flip1 * psi1 d = _
  rw [mul_assoc, flip_psi1, ← mul_assoc, diagonal_psi1, mul_assoc]
  rfl

private theorem aut_psi2_odd (α : ParkerStandardGroup)
    (hα : α.val parkerOmega ≠ parkerOmega) (d : ParkerLoop) :
    psiAut1N α * psi2N d = psi3N (α.val (loopInverse d)) * psiAut1N α := by
  apply Subtype.ext
  change psiAut1 α.val * psi2 d = psi3 (α.val (loopInverse d)) * psiAut1 α.val
  rw [psiAut1, if_neg hα]
  change diagonal α.val * flip1 * psi2 d = _
  rw [mul_assoc, flip_psi2, ← mul_assoc, diagonal_psi3, mul_assoc]
  rfl

private theorem aut_psi3_odd (α : ParkerStandardGroup)
    (hα : α.val parkerOmega ≠ parkerOmega) (d : ParkerLoop) :
    psiAut1N α * psi3N d = psi2N (α.val (loopInverse d)) * psiAut1N α := by
  apply Subtype.ext
  change psiAut1 α.val * psi3 d = psi2 (α.val (loopInverse d)) * psiAut1 α.val
  rw [psiAut1, if_neg hα]
  change diagonal α.val * flip1 * psi3 d = _
  rw [mul_assoc, flip_psi3, ← mul_assoc, diagonal_psi2, mul_assoc]
  rfl

private abbrev rotate : MulAut (Equiv.Perm Triple) := MulAut.conj cycle

private theorem rotate_psi1 (d : ParkerLoop) : rotate (psi1 d) = psi2 d := by
  ext ⟨a,b,c⟩ : 1
  rfl

private theorem rotate_psi3 (d : ParkerLoop) : rotate (psi3 d) = psi1 d := by
  ext ⟨a,b,c⟩ : 1
  rfl

private theorem rotate_diagonal (α : ParkerStandardGroup) :
    rotate (diagonal α.val) = diagonal α.val := by
  ext ⟨a,b,c⟩ : 1
  rfl

private theorem psi2_mul (d e : ParkerLoop) :
    psi2N e * psi2N d =
      psiAut1N (associatorAutomorphism e.1 d.1) *
        psi1N (0, golayHalfOverlap e.1 d.1) * psi2N (parkerLoopMultiply d e) := by
  have h := congrArg (fun g : N => rotate g.val) (psi1N_mul_collection d e)
  apply Subtype.ext
  simp only [Subgroup.coe_mul, psi1N, psi2N, psi3N, psiAut1N] at h ⊢
  simpa only [map_mul, rotate_psi1, rotate_psi3, psiAut1,
    if_pos (associatorAutomorphism_even e.1 d.1), rotate_diagonal] using h

private theorem psi1_one : psi1N loopOne = 1 := by
  apply Subtype.ext
  ext ⟨a,b,c⟩ : 1
  simp [psi1N]

private theorem psi2_one : psi2N loopOne = 1 := by
  apply Subtype.ext
  ext ⟨a,b,c⟩ : 1
  simp [psi2N]

private theorem sign_mul_left (s : ParkerBit) (a : ParkerLoop) :
    parkerLoopMultiply (0,s) a = parkerSign s a := by
  simp [parkerLoopMultiply, parkerMultiply, parkerSign, add_comm]

private theorem sign_mul_right (s : ParkerBit) (a : ParkerLoop) :
    parkerLoopMultiply a (0,s) = parkerSign s a := by
  simp [parkerLoopMultiply, parkerMultiply, parkerSign]

private theorem sign_code (t : ParkerBit) (d : ParkerLoop) :
    (parkerSign t d).1 = d.1 := rfl

private theorem sign3_absorb (t : ParkerBit) (d e : ParkerLoop) :
    psi3N (0,t) * (psi2N e * psi1N d) =
      psi2N (parkerSign t e) * psi1N (parkerSign t d) := by
  apply Subtype.ext
  ext ⟨a,b,c⟩ : 1
  change psi3 (0,t) (psi2 e (psi1 d (a,b,c))) =
    psi2 (parkerSign t e) (psi1 (parkerSign t d) (a,b,c))
  cases a <;> cases b <;> cases c <;>
    simp [normalForm_sandwich, sign_mul_left, sign_mul_right,
      parkerLoopMultiply_sign_left, parkerLoopMultiply_sign_right, parkerSign_add,
      sign_code, add_comm]

private theorem sign1_absorb (t : ParkerBit) (d e : ParkerLoop) :
    psi1N (0,t) * (psi2N e * psi1N d) = psi2N e * psi1N (parkerSign t d) := by
  apply Subtype.ext
  ext ⟨a,b,c⟩ : 1
  change psi1 (0,t) (psi2 e (psi1 d (a,b,c))) =
    psi2 e (psi1 (parkerSign t d) (a,b,c))
  cases a <;> cases b <;> cases c <;>
    simp [normalForm_sandwich, sign_mul_left, sign_mul_right,
      parkerLoopMultiply_sign_left, parkerLoopMultiply_sign_right, parkerSign_add,
      sign_code, add_comm]

private theorem sign3_commutes_psi2 (t : ParkerBit) (e : ParkerLoop) :
    psi2N e * psi3N (0,t) = psi3N (0,t) * psi2N e := by
  apply Subtype.ext
  ext ⟨a,b,c⟩ : 1
  change psi2 e (psi3 (0,t) (a,b,c)) = psi3 (0,t) (psi2 e (a,b,c))
  cases a <;> cases b <;> cases c <;>
    simp [normalForm_sandwich, sign_mul_left, sign_mul_right,
      parkerLoopMultiply_sign_left, parkerLoopMultiply_sign_right, parkerSign_add,
      add_comm]


/-- Left multiplication on a finite invariant set is a permutation of that set. -/
private theorem inverse_closed (P : N → Prop) (a : N)
    (ha : ∀ g, P g → P (a * g)) : ∀ g, P g → P (a⁻¹ * g) := by
  let f : {g : N // P g} → {g : N // P g} := fun g => ⟨a * g.val, ha g.val g.prop⟩
  have hf : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    exact mul_left_cancel (congrArg Subtype.val h)
  intro g hg
  obtain ⟨x, hx⟩ := Finite.surjective_of_injective hf ⟨g, hg⟩
  have hx' : a * x.val = g := congrArg Subtype.val hx
  have heq : x.val = a⁻¹ * g := by rw [← hx', inv_mul_cancel_left]
  exact heq ▸ x.prop

private def EvenWord (g : N) : Prop :=
  ∃ d e : ParkerLoop, ∃ α : ParkerStandardGroup,
    α.val parkerOmega = parkerOmega ∧ psiAut1N α * psi2N e * psi1N d = g

private theorem evenWord_base (d e : ParkerLoop) : EvenWord (psi2N e * psi1N d) := by
  exact ⟨d, e, 1, rfl, by rw [aut_one, one_mul]⟩

private theorem evenWord_aut (β : ParkerStandardGroup)
    (hβ : β.val parkerOmega = parkerOmega) {g : N} (hg : EvenWord g) :
    EvenWord (psiAut1N β * g) := by
  obtain ⟨d,e,α,hα,rfl⟩ := hg
  refine ⟨d,e,β*α, (even_mul_iff β α).mpr (iff_of_true hβ hα), ?_⟩
  rw [aut_mul]
  simp only [mul_assoc]

private theorem move_psi2_even (α : ParkerStandardGroup)
    (hα : α.val parkerOmega = parkerOmega) (e : ParkerLoop) :
    psi2N e * psiAut1N α = psiAut1N α * psi2N (α.val.symm e) := by
  simpa only [Equiv.apply_symm_apply] using (aut_psi2_even α hα (α.val.symm e)).symm

private theorem evenWord_sign3 (t : ParkerBit) {g : N} (hg : EvenWord g) :
    EvenWord (psi3N (0,t) * g) := by
  obtain ⟨d,e,α,hα,rfl⟩ := hg
  have hc : psi3N (0,t) * psiAut1N α = psiAut1N α * psi3N (0,t) := by
    simpa only [α.prop.2.1] using (aut_psi3_even α hα (0,t)).symm
  refine ⟨parkerSign t d, parkerSign t e, α, hα, ?_⟩
  calc
    _ = psiAut1N α * (psi3N (0,t) * (psi2N e * psi1N d)) := by
      rw [sign3_absorb]; simp only [mul_assoc]
    _ = _ := by rw [← mul_assoc, ← hc]; simp only [mul_assoc]

private theorem evenWord_right_psi1 (f : ParkerLoop) {g : N} (hg : EvenWord g) :
    EvenWord (g * psi1N f) := by
  obtain ⟨d,e,α,hα,rfl⟩ := hg
  let σ := associatorAutomorphism d.1 f.1
  let t := golayHalfOverlap d.1 f.1
  let e' := σ.val.symm e
  have hσ : σ.val parkerOmega = parkerOmega := associatorAutomorphism_even _ _
  refine ⟨parkerSign t (parkerLoopMultiply f d), parkerSign t e', α*σ,
    (even_mul_iff α σ).mpr (iff_of_true hα hσ), ?_⟩
  calc
    _ = (psiAut1N α * psiAut1N σ) *
        (psi3N (0,t) * (psi2N e' * psi1N (parkerLoopMultiply f d))) := by
      rw [aut_mul, sign3_absorb]; simp only [mul_assoc]
    _ = psiAut1N α * ((psiAut1N σ * psi2N e') *
        (psi3N (0,t) * psi1N (parkerLoopMultiply f d))) := by
      rw [← mul_assoc (psi3N (0,t)), ← sign3_commutes_psi2 t e']
      simp only [mul_assoc]
    _ = psiAut1N α * ((psi2N e * psiAut1N σ) *
        (psi3N (0,t) * psi1N (parkerLoopMultiply f d))) := by
      rw [← move_psi2_even σ hσ e]
    _ = psiAut1N α * (psi2N e * (psi1N d * psi1N f)) := by
      rw [psi1N_mul_collection f d]; simp only [σ, t, mul_assoc]
    _ = _ := by simp only [mul_assoc]

private theorem evenWord_left_psi2 (f : ParkerLoop) {g : N} (hg : EvenWord g) :
    EvenWord (psi2N f * g) := by
  obtain ⟨d,e,α,hα,rfl⟩ := hg
  let f' := α.val.symm f
  let σ := associatorAutomorphism f'.1 e.1
  let t := golayHalfOverlap f'.1 e.1
  have hσ : σ.val parkerOmega = parkerOmega := associatorAutomorphism_even _ _
  refine ⟨parkerSign t d, parkerLoopMultiply e f', α*σ,
    (even_mul_iff α σ).mpr (iff_of_true hα hσ), ?_⟩
  calc
    _ = (psiAut1N α * psiAut1N σ) *
        (psi1N (0,t) * (psi2N (parkerLoopMultiply e f') * psi1N d)) := by
      rw [aut_mul, sign1_absorb]; simp only [mul_assoc]
    _ = psiAut1N α * ((psi2N f' * psi2N e) * psi1N d) := by
      rw [psi2_mul e f']; simp only [σ, t, mul_assoc]
    _ = (psiAut1N α * psi2N f') * (psi2N e * psi1N d) := by
      simp only [mul_assoc]
    _ = _ := by rw [← move_psi2_even α hα f]; simp only [mul_assoc]

private theorem evenWord_left_psi1 (f : ParkerLoop) {g : N} (hg : EvenWord g) :
    EvenWord (psi1N f * g) := by
  obtain ⟨d,e,α,hα,rfl⟩ := hg
  let f' := α.val.symm f
  let σ := associatorAutomorphism e.1 f'.1
  let t := golayHalfOverlap e.1 f'.1
  let C := psiAut1N σ * psi3N (0,t)
  have hσ : σ.val parkerOmega = parkerOmega := associatorAutomorphism_even _ _
  have hC : ∀ x, EvenWord x → EvenWord (C * x) := by
    intro x hx
    exact (mul_assoc _ _ x).symm ▸ evenWord_aut σ hσ (evenWord_sign3 t hx)
  have hx := inverse_closed EvenWord C hC _
    (evenWord_right_psi1 d (evenWord_base f' e))
  have hc : psi2N e * psi1N f' = C * (psi1N f' * psi2N e) := by
    simpa only [C, σ, t, mul_assoc] using psi2N_mul_psi1N_collection f' e
  rw [hc, mul_assoc, inv_mul_cancel_left] at hx
  have ha := evenWord_aut α hα hx
  have hm : psiAut1N α * psi1N f' = psi1N f * psiAut1N α := by
    simpa only [f', Equiv.apply_symm_apply] using aut_psi1_even α hα f'
  simpa only [← mul_assoc, hm] using ha

private theorem evenWord_left_psi3 (f : ParkerLoop) {g : N} (hg : EvenWord g) :
    EvenWord (psi3N f * g) := by
  have h : ∀ x, EvenWord x → EvenWord ((psi2N f * psi1N f) * x) := by
    intro x hx
    exact (mul_assoc _ _ x).symm ▸ evenWord_left_psi2 f (evenWord_left_psi1 f hx)
  have heq : psi3N f = (psi2N f * psi1N f)⁻¹ := by
    apply eq_inv_of_mul_eq_one_left
    simpa only [mul_assoc] using psi3N_mul_psi2N_mul_psi1N f
  rw [heq]
  exact inverse_closed EvenWord _ h g hg

private def LoopFamily (g : N) : Prop :=
  ∃ d : ParkerLoop, g = psi1N d ∨ g = psi2N d ∨ g = psi3N d

private theorem evenWord_loop (x : N) (hx : LoopFamily x) {g : N} (hg : EvenWord g) :
    EvenWord (x * g) := by
  obtain ⟨d, rfl | rfl | rfl⟩ := hx
  · exact evenWord_left_psi1 d hg
  · exact evenWord_left_psi2 d hg
  · exact evenWord_left_psi3 d hg

private theorem aut_loop (α : ParkerStandardGroup) (g : N) (hg : LoopFamily g) :
    ∃ h : N, LoopFamily h ∧ psiAut1N α * g = h * psiAut1N α := by
  by_cases hα : α.val parkerOmega = parkerOmega
  · obtain ⟨d, rfl | rfl | rfl⟩ := hg
    · exact ⟨_, ⟨α.val d, Or.inl rfl⟩, aut_psi1_even α hα d⟩
    · exact ⟨_, ⟨α.val d, Or.inr (Or.inl rfl)⟩, aut_psi2_even α hα d⟩
    · exact ⟨_, ⟨α.val d, Or.inr (Or.inr rfl)⟩, aut_psi3_even α hα d⟩
  · obtain ⟨d, rfl | rfl | rfl⟩ := hg
    · exact ⟨_, ⟨α.val (loopInverse d), Or.inl rfl⟩, aut_psi1_odd α hα d⟩
    · exact ⟨_, ⟨α.val (loopInverse d), Or.inr (Or.inr rfl)⟩, aut_psi2_odd α hα d⟩
    · exact ⟨_, ⟨α.val (loopInverse d), Or.inr (Or.inl rfl)⟩, aut_psi3_odd α hα d⟩

private theorem aut_inv (α : ParkerStandardGroup) : psiAut1N α⁻¹ = (psiAut1N α)⁻¹ := by
  apply eq_inv_of_mul_eq_one_left
  rw [← aut_mul, inv_mul_cancel, aut_one]

private theorem move_loop_aut (α : ParkerStandardGroup) (g : N) (hg : LoopFamily g) :
    ∃ h : N, LoopFamily h ∧ g * psiAut1N α = psiAut1N α * h := by
  obtain ⟨h,hh,heq⟩ := aut_loop α⁻¹ g hg
  rw [aut_inv] at heq
  refine ⟨h,hh,?_⟩
  calc
    g * psiAut1N α = psiAut1N α * ((psiAut1N α)⁻¹ * g) * psiAut1N α := by
      simp only [mul_inv_cancel_left]
    _ = psiAut1N α * (h * (psiAut1N α)⁻¹) * psiAut1N α := by rw [heq]
    _ = _ := by simp only [mul_assoc, inv_mul_cancel, mul_one]

private def Collected (g : N) : Prop :=
  ∃ d e : ParkerLoop, ∃ α : ParkerStandardGroup, psiAut1N α * psi2N e * psi1N d = g

private theorem collected_even {g : N} (hg : EvenWord g) : Collected g := by
  obtain ⟨d,e,α,_,h⟩ := hg
  exact ⟨d,e,α,h⟩

private theorem collected_aut (β : ParkerStandardGroup) {g : N} (hg : Collected g) :
    Collected (psiAut1N β * g) := by
  obtain ⟨d,e,α,rfl⟩ := hg
  refine ⟨d,e,β*α,?_⟩
  rw [aut_mul]
  simp only [mul_assoc]

private theorem collected_loop (x : N) (hx : LoopFamily x) {g : N} (hg : Collected g) :
    Collected (x * g) := by
  obtain ⟨d,e,α,rfl⟩ := hg
  obtain ⟨y,hy,heq⟩ := move_loop_aut α x hx
  have h := collected_aut α (collected_even (evenWord_loop y hy (evenWord_base d e)))
  rw [← mul_assoc, ← heq] at h
  simpa only [mul_assoc] using h

/-- Every element generated by the three loop families and the first standard
    automorphism family has the source normal form, in left-composition order. -/
theorem collectionSubgroup_normalForm (g : N) (hg : g ∈ collectionSubgroup) :
    ∃ d e : ParkerLoop, ∃ α : ParkerStandardGroup, (normalForm d e α).val = g := by
  have hm : ∀ x : N,
      x ∈ Set.range psi1N ∪ Set.range psi2N ∪ Set.range psi3N ∪ Set.range psiAut1N →
      ∀ y, Collected y → Collected (x * y) := by
    rintro x (((⟨d,rfl⟩ | ⟨d,rfl⟩) | ⟨d,rfl⟩) | ⟨α,rfl⟩) y hy
    · exact collected_loop _ ⟨d,Or.inl rfl⟩ hy
    · exact collected_loop _ ⟨d,Or.inr (Or.inl rfl)⟩ hy
    · exact collected_loop _ ⟨d,Or.inr (Or.inr rfl)⟩ hy
    · exact collected_aut α hy
  change Collected g
  change g ∈ Subgroup.closure _ at hg
  apply Subgroup.closure_induction_left (p := fun x _ => Collected x) ?_ ?_ ?_ hg
  · have h := collected_even (evenWord_base loopOne loopOne)
    simpa only [psi1_one, psi2_one, one_mul] using h
  · intro x hx y _ hy
    exact hm x hx y hy
  · intro x hx y _ hy
    exact inverse_closed Collected x (hm x hx) y hy

end Sporadic.Monster.Construction.TrialitySpin
