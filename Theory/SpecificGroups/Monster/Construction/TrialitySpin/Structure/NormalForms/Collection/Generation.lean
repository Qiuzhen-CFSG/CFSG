module

public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.NormalForms.Collection.Relations
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Generation of the first triality centralizer

The centralizer `N1` is exactly the subgroup generated by the three loop
families and the first standard-automorphism family. This is proved directly
from the six generating families of the concrete permutation group `N`.

Write `c` for the coordinate cycle. For each generator `g` and each
`i = 0, 1, 2`, coordinate calculation gives `c^i g = h c^j`, where `h` is
in `collectionSubgroup` and `j = 0, 1, 2`. The loop families rotate, even
diagonal automorphisms commute with `c`, and odd automorphisms reverse it.
This property is closed under multiplication. Finiteness of the permutation
group identifies subgroup generation with positive-word generation, giving a
cover by three ambient right cosets. The two nonidentity powers of `c` do not
centralize `z1`, so a member of `N1` belongs to the identity coset.

The argument uses the coordinate cycle in the ambient permutation group;
no membership witness for the cycle in `N` is needed. It is independent of
collection of words inside `collectionSubgroup` and of normal-form existence.

Source: Aschbacher, *Sporadic Groups*, Section 14, printed pp. 58–62
(PDF pp. 35–37), especially Lemmas 14.2(1,2,4,5), 14.3(2,3), and 14.4(1).
All products below use Lean's left-composition convention.
-/

@[expose] public section
open Atlas.Fischer Atlas.Codes
noncomputable section
namespace Sporadic.Monster.Construction.TrialitySpin

private def CollectsCycles (g : Equiv.Perm Triple) : Prop :=
  ∀ i : Fin 3, ∃ h : N, h ∈ collectionSubgroup ∧
    ∃ j : Fin 3, cycle ^ i.val * g = h.val * cycle ^ j.val

private theorem collectsCycles_one : CollectsCycles 1 := by
  intro i
  exact ⟨1, collectionSubgroup.one_mem, i, by simp⟩

private theorem collectsCycles_mul {g k : Equiv.Perm Triple}
    (hg : CollectsCycles g) (hk : CollectsCycles k) : CollectsCycles (g * k) := by
  intro i
  obtain ⟨a, ha, j, hj⟩ := hg i
  obtain ⟨b, hb, l, hl⟩ := hk j
  refine ⟨a * b, collectionSubgroup.mul_mem ha hb, l, ?_⟩
  simp only [Subgroup.coe_mul]
  rw [← mul_assoc, hj, mul_assoc, hl, mul_assoc]

private theorem collectsCycles_psi1 (d : ParkerLoop) : CollectsCycles (psi1 d) := by
  intro i
  fin_cases i
  · exact ⟨psi1N d, Subgroup.subset_closure (Or.inl (Or.inl (Or.inl ⟨d,rfl⟩))), 0, rfl⟩
  · exact ⟨psi2N d, Subgroup.subset_closure (Or.inl (Or.inl (Or.inr ⟨d,rfl⟩))), 1, rfl⟩
  · exact ⟨psi3N d, Subgroup.subset_closure (Or.inl (Or.inr ⟨d,rfl⟩)), 2, rfl⟩

private theorem collectsCycles_psi2 (d : ParkerLoop) : CollectsCycles (psi2 d) := by
  intro i
  fin_cases i
  · exact ⟨psi2N d, Subgroup.subset_closure (Or.inl (Or.inl (Or.inr ⟨d,rfl⟩))), 0, rfl⟩
  · exact ⟨psi3N d, Subgroup.subset_closure (Or.inl (Or.inr ⟨d,rfl⟩)), 1, rfl⟩
  · exact ⟨psi1N d, Subgroup.subset_closure (Or.inl (Or.inl (Or.inl ⟨d,rfl⟩))), 2, rfl⟩

private theorem collectsCycles_psi3 (d : ParkerLoop) : CollectsCycles (psi3 d) := by
  intro i
  fin_cases i
  · exact ⟨psi3N d, Subgroup.subset_closure (Or.inl (Or.inr ⟨d,rfl⟩)), 0, rfl⟩
  · exact ⟨psi1N d, Subgroup.subset_closure (Or.inl (Or.inl (Or.inl ⟨d,rfl⟩))), 1, rfl⟩
  · exact ⟨psi2N d, Subgroup.subset_closure (Or.inl (Or.inl (Or.inr ⟨d,rfl⟩))), 2, rfl⟩

private theorem collectsCycles_psiAut1 (α : ParkerStandardGroup) :
    CollectsCycles (psiAut1 α.val) := by
  intro i
  have hm : psiAut1N α ∈ collectionSubgroup := Subgroup.subset_closure (Or.inr ⟨α,rfl⟩)
  by_cases he : α.val parkerOmega = parkerOmega
  · refine ⟨psiAut1N α, hm, i, ?_⟩
    change cycle ^ i.val * psiAut1 α.val = psiAut1 α.val * cycle ^ i.val
    rw [psiAut1, if_pos he]
    fin_cases i <;> rfl
  · fin_cases i
    · refine ⟨psiAut1N α, hm, 0, ?_⟩
      rfl
    · refine ⟨psiAut1N α, hm, 2, ?_⟩
      change cycle ^ 1 * psiAut1 α.val = psiAut1 α.val * cycle ^ 2
      rw [psiAut1, if_neg he]
      rfl
    · refine ⟨psiAut1N α, hm, 1, ?_⟩
      change cycle ^ 2 * psiAut1 α.val = psiAut1 α.val * cycle ^ 1
      rw [psiAut1, if_neg he]
      rfl

private theorem collectsCycles_psiAut2 (α : ParkerStandardGroup) :
    CollectsCycles (psiAut2 α.val) := by
  intro i
  have hm : psiAut1N α ∈ collectionSubgroup := Subgroup.subset_closure (Or.inr ⟨α,rfl⟩)
  by_cases he : α.val parkerOmega = parkerOmega
  · refine ⟨psiAut1N α, hm, i, ?_⟩
    change cycle ^ i.val * psiAut2 α.val = psiAut1 α.val * cycle ^ i.val
    simp only [psiAut1, psiAut2, if_pos he]
    fin_cases i <;> rfl
  · fin_cases i
    · refine ⟨psiAut1N α, hm, 1, ?_⟩
      change cycle ^ 0 * psiAut2 α.val = psiAut1 α.val * cycle ^ 1
      simp only [psiAut1, psiAut2, if_neg he]
      rfl
    · refine ⟨psiAut1N α, hm, 0, ?_⟩
      change cycle ^ 1 * psiAut2 α.val = psiAut1 α.val * cycle ^ 0
      simp only [psiAut1, psiAut2, if_neg he]
      rfl
    · refine ⟨psiAut1N α, hm, 2, ?_⟩
      change cycle ^ 2 * psiAut2 α.val = psiAut1 α.val * cycle ^ 2
      simp only [psiAut1, psiAut2, if_neg he]
      rfl

private theorem collectsCycles_psiAut3 (α : ParkerStandardGroup) :
    CollectsCycles (psiAut3 α.val) := by
  intro i
  have hm : psiAut1N α ∈ collectionSubgroup := Subgroup.subset_closure (Or.inr ⟨α,rfl⟩)
  by_cases he : α.val parkerOmega = parkerOmega
  · refine ⟨psiAut1N α, hm, i, ?_⟩
    change cycle ^ i.val * psiAut3 α.val = psiAut1 α.val * cycle ^ i.val
    simp only [psiAut1, psiAut3, if_pos he]
    fin_cases i <;> rfl
  · fin_cases i
    · refine ⟨psiAut1N α, hm, 2, ?_⟩
      change cycle ^ 0 * psiAut3 α.val = psiAut1 α.val * cycle ^ 2
      simp only [psiAut1, psiAut3, if_neg he]
      rfl
    · refine ⟨psiAut1N α, hm, 1, ?_⟩
      change cycle ^ 1 * psiAut3 α.val = psiAut1 α.val * cycle ^ 1
      simp only [psiAut1, psiAut3, if_neg he]
      rfl
    · refine ⟨psiAut1N α, hm, 0, ?_⟩
      change cycle ^ 2 * psiAut3 α.val = psiAut1 α.val * cycle ^ 0
      simp only [psiAut1, psiAut3, if_neg he]
      rfl

private theorem collectsCycles_generators {g : Equiv.Perm Triple}
    (hg : g ∈ generators) : CollectsCycles g := by
  rcases hg with (((⟨d,rfl⟩ | ⟨d,rfl⟩) | ⟨d,rfl⟩) | ⟨α,hα,rfl | rfl | rfl⟩)
  · exact collectsCycles_psi1 d
  · exact collectsCycles_psi2 d
  · exact collectsCycles_psi3 d
  · exact collectsCycles_psiAut1 ⟨α,hα⟩
  · exact collectsCycles_psiAut2 ⟨α,hα⟩
  · exact collectsCycles_psiAut3 ⟨α,hα⟩

private theorem collectsCycles_N (g : N) : CollectsCycles g.val := by
  have hg : g.val ∈ Submonoid.closure generators := by
    rw [← Subgroup.closure_toSubmonoid_of_finite]
    exact g.prop
  exact Submonoid.closure_induction (motive := fun g _ => CollectsCycles g)
    (fun _ hx => collectsCycles_generators hx) collectsCycles_one
    (fun _ _ _ _ hx hy => collectsCycles_mul hx hy) hg

/-- Every element of `N` lies in one of the three ambient right cosets of
`collectionSubgroup` represented by powers of the coordinate cycle. -/
theorem exists_collectionSubgroup_cycle (g : N) :
    ∃ h : N, h ∈ collectionSubgroup ∧ ∃ i : Fin 3,
      g.val = h.val * cycle ^ i.val := by
  simpa only [Fin.val_zero, pow_zero, one_mul] using collectsCycles_N g 0

private theorem cycle_pow_centralizes_z1_iff (i : Fin 3) :
    cycle ^ i.val * z1 = z1 * cycle ^ i.val ↔ i = 0 := by
  constructor
  · intro hi
    fin_cases i
    · rfl
    · have h := congrArg (fun p : Equiv.Perm Triple => (p (axis1 loopOne)).2.1) hi
      have hs : loopOne = parkerSign 1 loopOne := by
        simpa [pow_succ, Equiv.Perm.mul_apply, cycle, axis1] using h
      exact False.elim (parkerSign_one_ne loopOne hs.symm)
    · have h := congrArg (fun p : Equiv.Perm Triple => (p (axis1 loopOne)).2.2) hi
      have hs : loopOne = parkerSign 1 loopOne := by
        simpa [pow_succ, Equiv.Perm.mul_apply, cycle, axis1] using h
      exact False.elim (parkerSign_one_ne loopOne hs.symm)
  · rintro rfl
    simp

/-- The centralizer of the first sign involution is generated by the three loop
families and the first standard-automorphism family, without a normal-form assumption. -/
theorem N1_le_collectionSubgroup : N1 ≤ collectionSubgroup := by
  intro g hg
  obtain ⟨h, hh, i, hi⟩ := exists_collectionSubgroup_cycle g
  have hc : h.val * z1 = z1 * h.val :=
    congrArg Subtype.val (Subgroup.mem_centralizer_singleton_iff.mp
      (collectionSubgroup_le_N1 hh))
  have hg' : g.val * z1 = z1 * g.val :=
    congrArg Subtype.val (Subgroup.mem_centralizer_singleton_iff.mp hg)
  rw [hi, mul_assoc, ← mul_assoc z1, ← hc, mul_assoc] at hg'
  have hz := (cycle_pow_centralizes_z1_iff i).mp (mul_left_cancel hg')
  subst i
  have hgh : g = h := Subtype.ext (by simpa using hi)
  rw [hgh]
  exact hh

/-- The four concrete centralizing families generate the full centralizer. -/
theorem collectionSubgroup_eq_N1 : collectionSubgroup = N1 :=
  le_antisymm collectionSubgroup_le_N1 N1_le_collectionSubgroup

end Sporadic.Monster.Construction.TrialitySpin
