module

public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.NormalForms.Collection.Relations
public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.NormalForms.Collection.Generation
public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.NormalForms.Collection.WordClosure

/-!
# Assembly of triality word collection

Every element of the actual centralizer `N1 = C_N(z1N)` has a normal form
`psiAut1N α * psi2N e * psi1N d`. This is the existence assertion in
Lemma 14.4(4): the source word `ψ₁(d)ψ₂(e)ψ₁(α)` is reversed for Lean's
left composition. These are words in `N1` itself, before quotienting by `K`.

The generation argument covers `N` by three ambient cosets of the subgroup
generated by the four centralizing families, and centralizing `z1N` forces
the identity coset. The word-closure argument collects that subgroup using
the loop multiplication, interchange, and automorphism identities. Combining
these proved inputs gives unconditional surjectivity. The imported relations
also prove `z2N ∈ Q1` using two Golay octads with odd half-overlap.

Source: Aschbacher, *Sporadic Groups*, Lemmas 14.2–14.4, printed pp. 58–62.
-/

@[expose] public section
open Atlas.Fischer Atlas.Codes
noncomputable section
namespace Sporadic.Monster.Construction.TrialitySpin

/-- Combine centralizer generation with collection in the generated subgroup.
This is conditional assembly, not the unconditional source normal-form theorem. -/
theorem normalForm_surjective_of_generation_and_collection
    (hgen : N1 ≤ collectionSubgroup)
    (hcollect : ∀ g : N, g ∈ collectionSubgroup →
      ∃ d e : ParkerLoop, ∃ α : ParkerStandardGroup, (normalForm d e α).val = g) :
    Function.Surjective
      (fun x : ParkerLoop × ParkerLoop × ParkerStandardGroup =>
        normalForm x.1 x.2.1 x.2.2) := by
  intro g
  obtain ⟨d,e,α,h⟩ := hcollect g.val (hgen g.prop)
  exact ⟨(d,e,α), Subtype.ext h⟩

/-- The existence assertion of Aschbacher 14.4(4): every element of the
centralizer `N1` has the source normal form, in left-composition order. -/
theorem normalForm_surjective :
    Function.Surjective
      (fun x : ParkerLoop × ParkerLoop × ParkerStandardGroup =>
        normalForm x.1 x.2.1 x.2.2) :=
  normalForm_surjective_of_generation_and_collection
    N1_le_collectionSubgroup collectionSubgroup_normalForm

end Sporadic.Monster.Construction.TrialitySpin
