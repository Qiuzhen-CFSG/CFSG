module

public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Permutations
public import Theory.AtlasPort.OtherSporadic.Mathieu.GolayAutomorphisms
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# The concrete generated Parker triality group

`N` is the subgroup of permutations of the actual Parker triples generated by
Section 14's three loop permutations and three standard-automorphism
permutations. Standard automorphisms preserve loop multiplication and signs
and induce an actual permutation of the marked Golay coordinates. The
subgroups `N1`, `Q1`, `K`, and `Z` are defined inside this fixed carrier.
These definitions assume no group-structure conclusions: in particular,
normality of `K` and the extraspecial structure of `Q1 / ⟨k1⟩` remain theorem
obligations before constructing the quotient or the spin representation.

Source: Aschbacher, *Sporadic Groups*, Section 14, pp. 58–62, specialized in
Section 27, pp. 143–146. The source's `K` is normal in `N` and central in `N+`,
not central in `N`. Permutation products here use left function composition.
The factors in the displayed `ki` are composed in reverse order to match the
source's right-action convention exactly.
-/

@[expose] public section

noncomputable section

open Atlas.Fischer Atlas.Codes

namespace Sporadic.Monster.Construction.TrialitySpin

/-- Loop automorphisms lying over the actual marked Golay permutation group.
This is a property of concrete permutations, not an assumed existence record. -/
def IsStandard (e : Equiv.Perm ParkerLoop) : Prop :=
  (∀ x y, e (parkerLoopMultiply x y) = parkerLoopMultiply (e x) (e y)) ∧
  (∀ s : ParkerBit, e (0, s) = (0, s)) ∧
  ∃ g : Mathieu24CodeModel, ∀ x : ParkerLoop,
    (e x).1.val = coordinatePermutation g.val x.1.val

/-- The kernel of the action of the standard automorphisms on the Golay code. -/
def IsSignAutomorphism (e : Equiv.Perm ParkerLoop) : Prop :=
  IsStandard e ∧ ∀ x, (e x).1 = x.1

/-- All six families of generators in Section 14. -/
def generators : Set (Equiv.Perm Triple) :=
  Set.range psi1 ∪ Set.range psi2 ∪ Set.range psi3 ∪
    {g | ∃ e, IsStandard e ∧ (g = psiAut1 e ∨ g = psiAut2 e ∨ g = psiAut3 e)}

/-- The Parker triality group, acting faithfully on the fixed triple carrier. -/
def N : Subgroup (Equiv.Perm Triple) := Subgroup.closure generators

/-- The subgroup generated by the loop elements and even standard automorphisms. -/
def NPlus : Subgroup N := Subgroup.closure
  {g | (∃ d, g.val = psi1 d ∨ g.val = psi2 d ∨ g.val = psi3 d) ∨
    ∃ e, IsStandard e ∧ e parkerOmega = parkerOmega ∧ g.val = diagonal e}

theorem psi1_mem_N (d : ParkerLoop) : psi1 d ∈ N :=
  Subgroup.subset_closure (Or.inl (Or.inl (Or.inl ⟨d, rfl⟩)))

theorem psi2_mem_N (d : ParkerLoop) : psi2 d ∈ N :=
  Subgroup.subset_closure (Or.inl (Or.inl (Or.inr ⟨d, rfl⟩)))

theorem psi3_mem_N (d : ParkerLoop) : psi3 d ∈ N :=
  Subgroup.subset_closure (Or.inl (Or.inr ⟨d, rfl⟩))

theorem psiAut1_mem_N (e : Equiv.Perm ParkerLoop) (he : IsStandard e) : psiAut1 e ∈ N :=
  Subgroup.subset_closure (Or.inr ⟨e, he, Or.inl rfl⟩)

theorem psiAut2_mem_N (e : Equiv.Perm ParkerLoop) (he : IsStandard e) : psiAut2 e ∈ N :=
  Subgroup.subset_closure (Or.inr ⟨e, he, Or.inr (Or.inl rfl)⟩)

theorem psiAut3_mem_N (e : Equiv.Perm ParkerLoop) (he : IsStandard e) : psiAut3 e ∈ N :=
  Subgroup.subset_closure (Or.inr ⟨e, he, Or.inr (Or.inr rfl)⟩)

/-- The loop generators as elements of the generated group. -/
def psi1N (d : ParkerLoop) : N := ⟨psi1 d, psi1_mem_N d⟩
def psi2N (d : ParkerLoop) : N := ⟨psi2 d, psi2_mem_N d⟩
def psi3N (d : ParkerLoop) : N := ⟨psi3 d, psi3_mem_N d⟩

/-- The distinguished involutions, now in their actual ambient group. -/
def z1N : N := psi1N loopPi
def z2N : N := psi2N loopPi
def z3N : N := psi3N loopPi

/-- The three central-kernel generators; the products encode the source right action. -/
def k1 : N := psi2N (parkerSign 1 parkerOmega) * psi3N parkerOmega
def k2 : N := psi3N (parkerSign 1 parkerOmega) * psi1N parkerOmega
def k3 : N := psi1N (parkerSign 1 parkerOmega) * psi2N parkerOmega

/-- The specified subgroup, without assuming its normality. -/
def K : Subgroup N := Subgroup.closure {k1, k2, k3}

/-- The distinguished four-group; its order is a subsequent structure theorem. -/
def Z : Subgroup N := Subgroup.closure {z1N, z2N, z3N}

/-- The centralizer is taken inside `N`, as in the source. -/
def N1 : Subgroup N := Subgroup.centralizer {z1N}

/-- The source subgroup generated by `ψ₁(L)` and `ψ₁(E)`, inside `N`. -/
def Q1 : Subgroup N := Subgroup.closure
  (Set.range psi1N ∪ {g | ∃ e, IsSignAutomorphism e ∧ g.val = psiAut1 e})

/-- The actual faithful permutation representation of the triality group. -/
def trialityAction : N →* Equiv.Perm Triple := N.subtype

theorem trialityAction_injective : Function.Injective trialityAction := Subtype.val_injective

theorem N_finite : Finite N := inferInstance

theorem z1N_sq : z1N ^ 2 = 1 := by
  apply Subtype.ext
  exact z1_sq

theorem z2N_sq : z2N ^ 2 = 1 := by
  apply Subtype.ext
  exact z2_sq

theorem z3N_sq : z3N ^ 2 = 1 := by
  apply Subtype.ext
  exact z3_sq

theorem z1N_z2N_z3N : z1N * z2N * z3N = 1 := by
  apply Subtype.ext
  exact z1_z2_z3

end Sporadic.Monster.Construction.TrialitySpin
