module

public import Theory.SpecificGroups.Monster.Construction.NOctad.LocalStructure.Parameters
public import Theory.SpecificGroups.Monster.Construction.NOctad.LocalStructure.Transport
public import Theory.SpecificGroups.Monster.Construction.NOctad.LocalStructure.QuotientAction

/-!
# The source radical and its even cocode subgroups

All groups here are subgroups of the actual Parker triality permutation group,
or their images under the existing quotient by `K`. The radical is generated
by the two relative intersections in 14.5. The even cocode condition is
annihilation of the all-one Golay word; it is proved equivalent to fixing the
distinguished loop element. The subgroup attached to an octad imposes the
additional annihilation of that octad. In particular it excludes odd cocodes.

Source: Aschbacher, *Sporadic Groups*, 14.4–14.5, Section 27's bar convention,
and 29.13(2),(4), printed pp. 60–62, 144, 160–161. Equality of the radical
with the setwise product, and its structure, are subsequent obligations.
-/

@[expose] public section
noncomputable section
namespace Sporadic.Monster.Construction.NOctad.LocalStructure.Radical
open TrialitySpin Atlas.Codes Atlas.Fischer

/-- The literal second local centralizer. -/
def N2 : Subgroup N := Subgroup.centralizer {z2N}

/-- The second family of the source local two-subgroups. -/
def Q2 : Subgroup N := Subgroup.closure
  (Set.range psi2N ∪ {g | ∃ a, IsSignAutomorphism a ∧ g.val = psiAut2 a})

/-- The subgroup generated by the two source factors in 14.5. -/
def R : Subgroup N := (Q1 ⊓ N2) ⊔ (Q2 ⊓ N1)

/-- Evenness of a cocode is intrinsic, hence independent of a subset representative. -/
def EvenCocode (a : Cocode) : Prop := cocodePairing golayOne a = 0

theorem evenCocode_iff (a : Cocode) : EvenCocode a ↔
    (parkerCocodeStandard a).val parkerOmega = parkerOmega := by
  change cocodePairing golayOne a = 0 ↔
    (golayOne, 0 + cocodePairing golayOne a) = (golayOne, 0)
  simp

/-- The noncentral generators of the source `E⁺`. -/
def evenCocodeGenerators : Set N :=
  {g | ∃ a : Cocode, EvenCocode a ∧ g = psiAut1N (parkerCocodeStandard a)}

/-- The source subgroup generated by `Z` and even sign automorphisms. -/
def EPlus : Subgroup N := Z ⊔ Subgroup.closure evenCocodeGenerators

/-- The octad annihilator inside the even cocode generators. -/
def octadCocodeGenerators (c : Octad) : Set N :=
  {g | ∃ a : Cocode, EvenCocode a ∧ cocodePairing c.val a = 0 ∧
    g = psiAut1N (parkerCocodeStandard a)}

/-- The unbarred preimage generators for `E_c⁺` in 29.13(2). -/
def EcPlus (c : Octad) : Subgroup N := Z ⊔ Subgroup.closure (octadCocodeGenerators c)

theorem R_le_N1 : R ≤ N1 := sup_le (inf_le_left.trans Q1_le_N1) inf_le_right

theorem EcPlus_le_EPlus (c : Octad) : EcPlus c ≤ EPlus := by
  apply sup_le_sup_left
  apply Subgroup.closure_mono
  rintro g ⟨a, ha, _, rfl⟩
  exact ⟨a, ha, rfl⟩

theorem psi1N_mem_N2 (d : ParkerLoop) : psi1N d ∈ N2 := by
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  apply Subtype.ext
  ext ⟨a,b,c⟩ : 1
  change psi1 d (z2 (a,b,c)) = z2 (psi1 d (a,b,c))
  simp

theorem psi2N_mem_N2 (d : ParkerLoop) : psi2N d ∈ N2 := by
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  apply Subtype.ext
  ext ⟨a,b,c⟩ : 1
  change psi2 d (z2 (a,b,c)) = z2 (psi2 d (a,b,c))
  simp

theorem psi3N_mem_N2 (d : ParkerLoop) : psi3N d ∈ N2 := by
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  apply Subtype.ext
  ext ⟨a,b,c⟩ : 1
  change psi3 d (z2 (a,b,c)) = z2 (psi3 d (a,b,c))
  simp

theorem evenCocode_mem_N2 (a : Cocode) (ha : EvenCocode a) :
    psiAut1N (parkerCocodeStandard a) ∈ N2 := by
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  apply Subtype.ext
  ext ⟨u,v,w⟩ : 1
  change psiAut1 (parkerCocodeStandard a).val (z2 (u,v,w)) =
    z2 (psiAut1 (parkerCocodeStandard a).val (u,v,w))
  simp [psiAut1, (evenCocode_iff a).mp ha, diagonal]

theorem cocode_mem_Q1 (a : Cocode) : psiAut1N (parkerCocodeStandard a) ∈ Q1 :=
  psiAut1N_mem_Q1_of_sign _ ((parkerStandardProjection_eq_one_iff _).mp
    (parkerCocodeStandard_projection a))

theorem Z_le_R : Z ≤ R := by
  apply (Subgroup.closure_le _).mpr
  rintro g (rfl | rfl | rfl)
  · exact (show Q1 ⊓ N2 ≤ R from le_sup_left) ⟨z1N_mem_Q1, psi1N_mem_N2 _⟩
  · exact (show Q1 ⊓ N2 ≤ R from le_sup_left) ⟨z2N_mem_Q1, psi2N_mem_N2 _⟩
  · exact (show Q1 ⊓ N2 ≤ R from le_sup_left) ⟨z3N_mem_Q1, psi3N_mem_N2 _⟩

theorem EPlus_le_R : EPlus ≤ R := by
  refine sup_le Z_le_R ((Subgroup.closure_le _).mpr ?_)
  rintro g ⟨a, ha, rfl⟩
  exact (show Q1 ⊓ N2 ≤ R from le_sup_left) ⟨cocode_mem_Q1 a, evenCocode_mem_N2 a ha⟩

theorem EcPlus_le_R (c : Octad) : EcPlus c ≤ R := (EcPlus_le_EPlus c).trans EPlus_le_R

def RImage : Subgroup NQuotient := R.map nQuotientMap
def EPlusImage : Subgroup NQuotient := EPlus.map nQuotientMap
def EcPlusImage (c : Octad) : Subgroup NQuotient := (EcPlus c).map nQuotientMap

theorem psi1N_mem_R (d : ParkerLoop) : psi1N d ∈ R :=
  (show Q1 ⊓ N2 ≤ R from le_sup_left) ⟨Subgroup.subset_closure (Or.inl ⟨d, rfl⟩), psi1N_mem_N2 d⟩

theorem psi2N_mem_R (e : ParkerLoop) : psi2N e ∈ R :=
  (show Q2 ⊓ N1 ≤ R from le_sup_right) ⟨Subgroup.subset_closure (Or.inl ⟨e, rfl⟩), psi2N_mem_N1 e⟩

theorem psi3N_mem_R (d : ParkerLoop) : psi3N d ∈ R := by
  apply (R.mul_mem_cancel_right (R.mul_mem (psi2N_mem_R d) (psi1N_mem_R d))).mp
  rw [← mul_assoc, psi3N_mul_psi2N_mul_psi1N]
  exact R.one_mem

/-- The quotient kernel really lies in the radical before applying the bar convention. -/
theorem K_le_R : TrialitySpin.K ≤ R := by
  apply (Subgroup.closure_le _).mpr
  rintro g (rfl | rfl | rfl)
  · exact R.mul_mem (psi2N_mem_R _) (psi3N_mem_R _)
  · exact R.mul_mem (psi3N_mem_R _) (psi1N_mem_R _)
  · exact R.mul_mem (psi1N_mem_R _) (psi2N_mem_R _)

theorem evenCocode_mem_R (a : Cocode) (ha : EvenCocode a) :
    psiAut1N (parkerCocodeStandard a) ∈ R :=
  (show Q1 ⊓ N2 ≤ R from le_sup_left) ⟨cocode_mem_Q1 a, evenCocode_mem_N2 a ha⟩

/-- Every literal collected word with even cocode belongs to the source radical. -/
theorem normalForm_mem_R (d e : ParkerLoop) (a : Cocode) (ha : EvenCocode a) :
    (normalForm d e (parkerCocodeStandard a)).val ∈ R :=
  R.mul_mem (R.mul_mem (evenCocode_mem_R a ha) (psi2N_mem_R e)) (psi1N_mem_R d)

theorem RImage_le_N1Image : RImage ≤ N1Image := Subgroup.map_mono R_le_N1

theorem EcPlusImage_le_RImage (c : Octad) : EcPlusImage c ≤ RImage :=
  Subgroup.map_mono (EcPlus_le_R c)

/-- The barred radical, now inside the actor of `imageRepresentation`. -/
def barredR : Subgroup N1Image := (R.subgroupOf N1).map n1ImageMap

/-- The literal barred octad annihilator, inside the same actor. -/
def barredEcPlus (c : Octad) : Subgroup N1Image :=
  ((EcPlus c).subgroupOf N1).map n1ImageMap

theorem barredR_eq : barredR = RImage.subgroupOf N1Image := by
  ext x
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact ⟨g.val, hg, rfl⟩
  · rintro ⟨g, hg, hx⟩
    exact ⟨⟨g, R_le_N1 hg⟩, hg, Subtype.ext hx⟩

theorem barredEcPlus_eq (c : Octad) :
    barredEcPlus c = (EcPlusImage c).subgroupOf N1Image := by
  ext x
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact ⟨g.val, hg, rfl⟩
  · rintro ⟨g, hg, hx⟩
    exact ⟨⟨g, R_le_N1 (EcPlus_le_R c hg)⟩, hg, Subtype.ext hx⟩

/-- The fixed space uses the actual descended action, not an abstract model. -/
def fixedSpace (c : Octad) : Submodule ℝ Space :=
  ⨅ g : barredEcPlus c, LinearMap.ker (imageRepresentation g.val - LinearMap.id)

theorem mem_fixedSpace (c : Octad) (v : Space) :
    v ∈ fixedSpace c ↔ ∀ g : barredEcPlus c, imageRepresentation g.val v = v := by
  simp [fixedSpace, sub_eq_zero]

end Sporadic.Monster.Construction.NOctad.LocalStructure.Radical
