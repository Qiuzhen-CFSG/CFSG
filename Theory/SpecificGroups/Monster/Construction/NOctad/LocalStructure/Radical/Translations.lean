module
public import Theory.SpecificGroups.Monster.Construction.NOctad.LocalStructure.Radical.Kernel
public import Theory.AtlasPort.OtherSporadic.Conway.GolayOctadRestriction

/-!
# Diagonal weights and all even-subset translations

Golay restriction onto an octad realizes every even subset. Applied to the
symmetric difference of two subsets, it gives a literal second-family
translation between their source vectors, with the exact half-intersection
sign. The first-family action is diagonal with its epsilon-plus-half-overlap
weight. Both calculations are applied to the actual radical restriction of
the existing block representation.

Source: Aschbacher, *Sporadic Groups*, 29.12 and the weight/translation argument
in 30.1, printed pp. 160 and 162–163. This proves full translation coverage;
coverage by the subgroup generated by zero-half-overlap translations and
identification of the common eigenspaces remain separate obligations.
-/

@[expose] public section
noncomputable section
namespace Sporadic.Monster.Construction.NOctad.LocalStructure.Radical
open TrialitySpin LocalC.ShortFamilies Atlas.Codes Atlas.Fischer Atlas.Lattices
open scoped BigOperators
attribute [local instance] Classical.propDecidable

theorem subsetWord_add (c : Octad) (J K : EvenSubset c) :
    subsetWord c (J + K) = subsetWord c J + subsetWord c K := by
  funext i
  by_cases hi : c.val.val i = 0 <;> simp [subsetWord, hi]

/-- Every even subset of the actual octad is the intersection with a Golay word. -/
theorem exists_golay_intersection (c : Octad) (J : EvenSubset c) :
    ∃ e : golay, c.val.val * e.val = subsetWord c J := by
  have hs : supportWord (support c.val.val) = c.val.val :=
    binarySupportEquiv.left_inv c.val.val
  have hw : (∑ i ∈ support c.val.val, subsetWord c J i) = 0 := by
    change (∑ i ∈ Finset.univ.filter (fun i => c.val.val i ≠ 0), subsetWord c J i) = 0
    rw [Finset.sum_subtype (p := fun i => c.val.val i ≠ 0)
      (F := (inferInstance : Fintype (Support c))) _ (by intro i; simp)]
    simpa only [subsetWord_support] using (show (∑ i, J.val i) = 0 from J.prop)
  obtain ⟨e, he⟩ := Atlas.Conway.golay_octad_restriction (support c.val.val) c.prop
    (by rw [hs]; exact c.val.prop) (subsetWord c J) hw
  refine ⟨e, ?_⟩
  funext i
  by_cases hi : c.val.val i = 0
  · simp [subsetWord, hi]
  · have hc : c.val.val i = 1 := (bit_cases _).resolve_left hi
    have hm : i ∈ support c.val.val := by simp [support, hi]
    simp only [Pi.mul_apply, hc, one_mul, he i hm]

/-- The translation covers all even subsets before passage to complement classes,
with precisely the half-intersection sign from 29.12(3). -/
theorem exists_psi2_parameters (c : Octad) (J K : EvenSubset c) (s : ParkerBit) :
    ∃ e : ParkerLoop, psi2Parameters e (parameters c J s) =
      parameters c K (s + golayHalfOverlap e.1 c.val) := by
  obtain ⟨e, he⟩ := exists_golay_intersection c (J + K)
  refine ⟨(e, 0), ?_⟩
  apply parameters_ext
  · rfl
  · change subsetWord c J + c.val.val * e.val = subsetWord c K
    rw [he, subsetWord_add]
    funext i
    change subsetWord c J i + (subsetWord c J i + subsetWord c K i) = subsetWord c K i
    rw [← add_assoc, CharTwo.add_self_eq_zero, zero_add]

/-- Actual second-family elements translate every source basis line to every other,
retaining their determined sign. -/
theorem representation_translation (h : GeneratorLaws) (c : Octad)
    (J K : EvenSubset c) (s : ParkerBit) :
    ∃ e : ParkerLoop,
      representation ⟨psi2N e, psi2N_mem_N1 e⟩ (vector (parameters c J s)) =
        vector (parameters c K (s + golayHalfOverlap e.1 c.val)) := by
  obtain ⟨e, he⟩ := exists_psi2_parameters c J K s
  exact ⟨e, (h.second e _).trans (congrArg vector he)⟩

theorem vector_sign_bit (p : OctadParameters) (s : ParkerBit) :
    vector (p.sign s) = (if s = 0 then (1 : ℝ) else -1) • vector p := by
  rcases bit_cases s with rfl | rfl
  · have hp : p.sign 0 = p := parameters_ext (parkerSign_zero p.c) rfl
    rw [hp, if_pos rfl, one_smul]
  · rw [vector_sign, if_neg one_ne_zero, neg_one_smul]

/-- The exact diagonal first-family weights on the literal signed vectors. -/
theorem representation_first_weight (h : GeneratorLaws) (d : ParkerLoop)
    (p : OctadParameters) :
    representation ⟨psi1N d, psi1N_mem_N1 d⟩ (vector p) =
      (if binaryDot p.J d.1.val + golayHalfOverlap p.c.1 d.1 = 0
        then (1 : ℝ) else -1) • vector p := by
  rw [h.first]
  exact vector_sign_bit p _

theorem first_mem_blockStabilizer (h : GeneratorLaws) (d : ParkerLoop) (c : Octad) :
    (⟨psi1N d, psi1N_mem_N1 d⟩ : N1) ∈ blockStabilizer c := by
  let g : N1 := ⟨psi1N d, psi1N_mem_N1 d⟩
  let p := parameters c 0 0
  obtain ⟨q, hq, hqc⟩ := representation_vector_transport g p
  have he : vector q = vector (psi1Parameters d p) := hq.symm.trans (h.first d p)
  have hc : parameterOctad q = c :=
    Subtype.ext (congrArg Prod.fst ((vector_eq_iff q _).mp he).1)
  exact hqc.symm.trans hc

theorem second_mem_blockStabilizer (h : GeneratorLaws) (e : ParkerLoop) (c : Octad) :
    (⟨psi2N e, psi2N_mem_N1 e⟩ : N1) ∈ blockStabilizer c := by
  let g : N1 := ⟨psi2N e, psi2N_mem_N1 e⟩
  let p := parameters c 0 0
  obtain ⟨q, hq, hqc⟩ := representation_vector_transport g p
  have he : vector q = vector (psi2Parameters e p) := hq.symm.trans (h.second e p)
  have hc : parameterOctad q = c :=
    Subtype.ext (congrArg Prod.fst ((vector_eq_iff q _).mp he).1)
  exact hqc.symm.trans hc

def firstActor (h : GeneratorLaws) (d : ParkerLoop) (c : Octad) : blockActor c :=
  ⟨⟨⟨psi1N d, psi1N_mem_N1 d⟩, first_mem_blockStabilizer h d c⟩, psi1N_mem_R d⟩

def secondActor (h : GeneratorLaws) (e : ParkerLoop) (c : Octad) : blockActor c :=
  ⟨⟨⟨psi2N e, psi2N_mem_N1 e⟩, second_mem_blockStabilizer h e c⟩, psi2N_mem_R e⟩

/-- The diagonal weights, applied in the actual radical block representation. -/
theorem blockAction_first_weight (h : GeneratorLaws) (d : ParkerLoop)
    (c : Octad) (p : OctadParameters) (hp : p.c.1 = c.val) :
    blockAction c (firstActor h d c)
      ⟨vector p, Submodule.subset_span ⟨p, hp, rfl⟩⟩ =
      (if binaryDot p.J d.1.val + golayHalfOverlap p.c.1 d.1 = 0 then (1 : ℝ) else -1) •
        (⟨vector p, Submodule.subset_span ⟨p, hp, rfl⟩⟩ : block c) := by
  apply Subtype.ext
  exact representation_first_weight h d p

/-- Translation coverage in the published action restricted to actual radical actors. -/
theorem blockAction_translation (h : GeneratorLaws) (c : Octad)
    (J K : EvenSubset c) (s : ParkerBit) :
    ∃ e : ParkerLoop,
      (blockAction c (secondActor h e c)
        ⟨vector (parameters c J s), Submodule.subset_span ⟨parameters c J s, rfl, rfl⟩⟩).val =
        vector (parameters c K (s + golayHalfOverlap e.1 c.val)) :=
  representation_translation h c J K s

end Sporadic.Monster.Construction.NOctad.LocalStructure.Radical
