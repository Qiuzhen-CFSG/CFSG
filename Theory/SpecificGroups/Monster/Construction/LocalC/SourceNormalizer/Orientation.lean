module

public import Theory.SpecificGroups.Monster.Construction.LocalC.SourceNormalizer.Forms
public import Theory.SpecificGroups.Monster.Construction.LocalC.SourceNormalizer.Orientation.QuarterTurns
public import Theory.SpecificGroups.Monster.Construction.LocalC.SourceNormalizer.Orientation.QuarterTurnGeneration
public import Mathlib.Analysis.Real.Sqrt

/-!
# Orientation of the actual spin normalizer

An extraspecial element `q` with square the central involution acts as a complex
structure `J = ρ(q)`. The operator `1 + J` is invertible and has positive
real determinant: for `a = 1 + √2`, its positive scalar multiple
`2a (1 + J)` is the square of `a + J`. It implements the quarter-turn
formula on the actual group `Q1Image`.

Automorphisms admitting positive-determinant intertwiners form a subgroup.
Two intertwiners inducing the same automorphism differ by a real scalar,
because the spin operators span all endomorphisms. In dimension 4096 this
scalar cannot change the determinant sign. Consequently a form-preserving
intertwiner inducing an automorphism generated by quarter turns has determinant
one, using the already proved determinant-square identity.

Quarter turns generate the full automorphism group of the actual `Q1Image`,
by the separate central-quotient geometry and inner-kernel argument. Applying
that generation theorem gives `det_one_of_form` with only the intertwining
and form-preservation hypotheses.

Source: Aschbacher, *Sporadic Groups*, Section 14, Exercise 4.4, printed
p. 64, and the spin normalizer on printed pp. 147–148.
-/

public section
noncomputable section
open Module
open scoped commutatorElement
namespace Sporadic.Monster.Construction.LocalC.SourceNormalizer
open TrialitySpin

private theorem det_one_add_pos {V : Type*} [AddCommGroup V] [Module ℝ V]
    [FiniteDimensional ℝ V] (J : End ℝ V) (hJ : J * J = -1) :
    0 < LinearMap.det (1 + J) := by
  let a : ℝ := 1 + Real.sqrt 2
  have ha : 0 < a := by dsimp [a]; positivity
  have ha2 : a ^ 2 - 1 = 2 * a := by
    dsimp [a]
    have hs := Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)
    nlinarith
  have hroot : (a • (1 : End ℝ V) + J) * (a • 1 + J) =
      (2 * a) • (1 + J) := by
    simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
      one_mul, mul_one, smul_add, smul_smul, hJ]
    have haeq : a * a = 2 * a + 1 := by nlinarith [ha2]
    rw [haeq]
    module
  have hn : LinearMap.det (1 + J) ≠ 0 := by
    have hprod : (1 + J) * (1 - J) = (2 : ℝ) • (1 : End ℝ V) := by
      noncomm_ring [hJ]
      module
    have hd := congrArg (LinearMap.det (A := ℝ)) hprod
    simp only [map_mul, LinearMap.det_smul, map_one, mul_one] at hd
    intro hzero
    rw [hzero, zero_mul] at hd
    exact (pow_ne_zero _ (by norm_num : (2 : ℝ) ≠ 0)) hd.symm
  have hd := congrArg (LinearMap.det (A := ℝ)) hroot
  simp only [map_mul, LinearMap.det_smul] at hd
  have hc : 0 < (2 * a) ^ finrank ℝ V := pow_pos (by positivity) _
  have hnonneg : 0 ≤ LinearMap.det (1 + J) := by
    nlinarith only [mul_self_nonneg (LinearMap.det (a • (1 : End ℝ V) + J)), hd, hc]
  exact lt_of_le_of_ne hnonneg (Ne.symm hn)

private theorem representation_anticommute {K V : Type*} [Group K]
    [AddCommGroup V] [Module ℝ V] (ρ : Representation ℝ K V) (q x z : K)
    (hz : ρ z = -1) (h : q * x = z * (x * q)) : ρ q * ρ x = -(ρ x * ρ q) := by
  rw [← map_mul, h, map_mul, hz, map_mul, neg_mul, one_mul]

private theorem one_add_intertwines {R : Type*} [Ring R] (J A : R)
    (hJ : J * J = -1) (hA : J * A = -(A * J)) :
    (1 + J) * A = (J * A) * (1 + J) := by
  have htriple : J * A * J = A := by rw [hA, neg_mul, mul_assoc, hJ]; simp
  rw [add_mul, one_mul, mul_add, mul_one, htriple, add_comm]

private def complexRotation {V : Type*} [AddCommGroup V] [Module ℝ V]
    (J : End ℝ V) (hJ : J * J = -1) : V ≃ₗ[ℝ] V :=
  LinearEquiv.ofLinearMap (1 + J) ((1 / 2 : ℝ) • (1 - J)) (by
    change (1 + J) * ((1 / 2 : ℝ) • (1 - J)) = 1
    have h : (1 + J) * (1 - J) = (2 : ℝ) • (1 : End ℝ V) := by
      noncomm_ring [hJ]
      module
    rw [mul_smul_comm, h, smul_smul]
    norm_num) (by
    change ((1 / 2 : ℝ) • (1 - J)) * (1 + J) = 1
    have h : (1 - J) * (1 + J) = (2 : ℝ) • (1 : End ℝ V) := by
      noncomm_ring [hJ]
      module
    rw [smul_mul_assoc, h, smul_smul]
    norm_num)
private theorem image_anticommute (q x : Q1Image) (h : ¬ Commute q x) :
    SpinAction.imageRepresentation q * SpinAction.imageRepresentation x =
      -(SpinAction.imageRepresentation x * SpinAction.imageRepresentation q) := by
  have hcom : ⁅q, x⁆ ∈ Subgroup.center Q1Image := by
    let : IsMulCommutative (Q1Image ⧸ Subgroup.center Q1Image) :=
      Q1Image_central_quotient_elementary.toIsMulCommutative
    have hle := (Subgroup.Normal.quotient_commutative_iff_commutator_le
      (N := Subgroup.center Q1Image)).mp inferInstance
    exact hle (Subgroup.commutator_mem_commutator
      (H₁ := ⊤) (H₂ := ⊤) (by trivial) (by trivial))
  have hc : ⁅q, x⁆ = q1ImageCenterGenerator := by
    obtain ⟨w, _, hw⟩ := (Nat.card_eq_two_iff' (1 : Subgroup.center Q1Image)).mp
      Q1Image_center_card
    have h₁ : (⟨⁅q, x⁆, hcom⟩ : Subgroup.center Q1Image) ≠ 1 := by
      intro he
      exact h (commutatorElement_eq_one_iff_commute.mp (congrArg Subtype.val he))
    have hz : q1ImageCenterGenerator ∈ Subgroup.center Q1Image := by
      rw [Q1Image_center]; exact Subgroup.mem_zpowers _
    have h₂ : (⟨q1ImageCenterGenerator, hz⟩ : Subgroup.center Q1Image) ≠ 1 := by
      intro he
      exact q1ImageCenterGenerator_ne_one (congrArg Subtype.val he)
    exact congrArg Subtype.val ((hw _ h₁).trans (hw _ h₂).symm)
  have he : q * x = q1ImageCenterGenerator * (x * q) := by
    rw [← hc, commutatorElement_def]
    group
  exact representation_anticommute SpinAction.imageRepresentation q x
    q1ImageCenterGenerator SpinAction.imageRepresentation_center he

private theorem quarterTurn_intertwines {α : MulAut Q1Image} {q : Q1Image}
    (hq : q ^ 2 = q1ImageCenterGenerator)
    (hα : ∀ x : Q1Image, (Commute q x → α x = x) ∧
      (¬ Commute q x → α x = q * x)) (x : Q1Image) :
    (1 + SpinAction.imageRepresentation q) * SpinAction.imageRepresentation x =
      SpinAction.imageRepresentation (α x) * (1 + SpinAction.imageRepresentation q) := by
  have hJ : SpinAction.imageRepresentation q * SpinAction.imageRepresentation q = -1 := by
    rw [← map_mul, ← pow_two, hq, SpinAction.imageRepresentation_center]
  by_cases hc : Commute q x
  · rw [(hα x).1 hc]
    have hm := (hc.map SpinAction.imageRepresentation).eq
    simp only [add_mul, mul_add, one_mul, mul_one, hm]
  · rw [(hα x).2 hc, map_mul]
    exact one_add_intertwines (R := End ℝ SpinSpace)
      (SpinAction.imageRepresentation q) (SpinAction.imageRepresentation x)
      hJ (image_anticommute q x hc)

private theorem intertwiners_differ_by_scalar (F G : SpinSpace ≃ₗ[ℝ] SpinSpace)
    (α : MulAut Q1Image)
    (hF : ∀ q v, F (SpinAction.imageRepresentation q v) =
      SpinAction.imageRepresentation (α q) (F v))
    (hG : ∀ q v, G (SpinAction.imageRepresentation q v) =
      SpinAction.imageRepresentation (α q) (G v)) :
    ∃ c : ℝ, F.toLinearMap = c • G.toLinearMap := by
  let T : End ℝ SpinSpace := G.symm.toLinearMap * F.toLinearMap
  have hcomm (q : Q1Image) : T * SpinAction.imageRepresentation q =
      SpinAction.imageRepresentation q * T := by
    apply LinearMap.ext
    intro v
    apply G.injective
    change G (G.symm (F (SpinAction.imageRepresentation q v))) =
      G (SpinAction.imageRepresentation q (G.symm (F v)))
    rw [G.apply_symm_apply, hG, G.apply_symm_apply, hF]
  have hcomm_all (S : End ℝ SpinSpace) : T * S = S * T := by
    have hS : S ∈ Submodule.span ℝ (Set.range
        (SpinAction.imageRepresentation : Q1Image → End ℝ SpinSpace)) := by
      rw [spin_span]; trivial
    induction hS using Submodule.span_induction with
    | mem S h => obtain ⟨q, rfl⟩ := h; exact hcomm q
    | zero => simp
    | add S U _ _ hS hU => simp only [mul_add, add_mul, hS, hU]
    | smul c S _ hS => simp only [mul_smul_comm, smul_mul_assoc, hS]
  have hcenter : T ∈ Subalgebra.center ℝ (End ℝ SpinSpace) := by
    rw [Subalgebra.mem_center_iff]
    intro S
    exact (hcomm_all S).symm
  obtain ⟨c, hc⟩ := (Algebra.IsCentral.mem_center_iff ℝ).mp hcenter
  refine ⟨c, ?_⟩
  apply LinearMap.ext
  intro v
  have h := congrArg (fun S : End ℝ SpinSpace => G (S v)) hc
  simpa [T] using h

private theorem det_nonneg_of_positive_intertwiner (F G : SpinSpace ≃ₗ[ℝ] SpinSpace)
    (α : MulAut Q1Image)
    (hF : ∀ q v, F (SpinAction.imageRepresentation q v) =
      SpinAction.imageRepresentation (α q) (F v))
    (hG : ∀ q v, G (SpinAction.imageRepresentation q v) =
      SpinAction.imageRepresentation (α q) (G v))
    (hdet : 0 < LinearMap.det G.toLinearMap) : 0 ≤ LinearMap.det F.toLinearMap := by
  obtain ⟨c, hc⟩ := intertwiners_differ_by_scalar F G α hF hG
  rw [hc, LinearMap.det_smul, finrank_spinSpace]
  exact mul_nonneg (by positivity) hdet.le

private def positiveIntertwinerAutomorphisms : Subgroup (MulAut Q1Image) where
  carrier α := ∃ F : SpinSpace ≃ₗ[ℝ] SpinSpace,
    (∀ q v, F (SpinAction.imageRepresentation q v) =
      SpinAction.imageRepresentation (α q) (F v)) ∧ 0 < LinearMap.det F.toLinearMap
  one_mem' := by
    refine ⟨LinearEquiv.refl ℝ SpinSpace, fun _ _ => rfl, ?_⟩
    simp
  mul_mem' := by
    rintro α β ⟨F, hF, hFd⟩ ⟨G, hG, hGd⟩
    refine ⟨F * G, ?_, ?_⟩
    · intro q v
      change F (G (SpinAction.imageRepresentation q v)) =
        SpinAction.imageRepresentation (α (β q)) (F (G v))
      rw [hG, hF]
    · change 0 < LinearMap.det (F.toLinearMap * G.toLinearMap)
      rw [map_mul]
      exact mul_pos hFd hGd
  inv_mem' := by
    rintro α ⟨F, hF, hFd⟩
    refine ⟨F.symm, ?_, ?_⟩
    · intro q v
      apply F.injective
      rw [F.apply_symm_apply, hF, F.apply_symm_apply]
      simp
    · have h := F.det_mul_det_symm
      nlinarith

private theorem quarterTurn_positive_intertwiner {α : MulAut Q1Image}
    (hα : α ∈ quarterTurnAutomorphisms) : α ∈ positiveIntertwinerAutomorphisms := by
  obtain ⟨q, hq, hα⟩ := hα
  let J : End ℝ SpinSpace := SpinAction.imageRepresentation q
  have hJ : J * J = -1 := by
    change SpinAction.imageRepresentation q * SpinAction.imageRepresentation q = -1
    rw [← map_mul, ← pow_two, hq, SpinAction.imageRepresentation_center]
  let G : SpinSpace ≃ₗ[ℝ] SpinSpace := complexRotation J hJ
  refine ⟨G, ?_, det_one_add_pos J hJ⟩
  intro x v
  exact LinearMap.congr_fun (quarterTurn_intertwines hq hα x) v

/-- Quarter-turn generation suffices to exclude the negative determinant sign. -/
theorem det_one_of_form_of_mem_quarterTurn_closure
    (F : SpinSpace ≃ₗ[ℝ] SpinSpace) (α : MulAut Q1Image)
    (hα : α ∈ Subgroup.closure quarterTurnAutomorphisms)
    (hF : ∀ q v, F (SpinAction.imageRepresentation q v) =
      SpinAction.imageRepresentation (α q) (F v))
    (hform : ∀ v w, bothAxesDomain.form (F v) (F w) = bothAxesDomain.form v w) :
    LinearMap.det F.toLinearMap = 1 := by
  have hle : Subgroup.closure quarterTurnAutomorphisms ≤
      positiveIntertwinerAutomorphisms :=
    (Subgroup.closure_le _).mpr fun _ h => quarterTurn_positive_intertwiner h
  obtain ⟨G, hG, hGd⟩ := hle hα
  have hn := det_nonneg_of_positive_intertwiner F G α hF hG hGd
  have hs := det_sq_of_form F hform
  nlinarith

/-- The orientation theorem reduced to generation of the actual extraspecial automorphism group. -/
theorem det_one_of_form_of_quarterTurn_generation
    (hgen : Subgroup.closure quarterTurnAutomorphisms = ⊤)
    (F : SpinSpace ≃ₗ[ℝ] SpinSpace) (α : MulAut Q1Image)
    (hF : ∀ q v, F (SpinAction.imageRepresentation q v) =
      SpinAction.imageRepresentation (α q) (F v))
    (hform : ∀ v w, bothAxesDomain.form (F v) (F w) = bothAxesDomain.form v w) :
    LinearMap.det F.toLinearMap = 1 :=
  det_one_of_form_of_mem_quarterTurn_closure F α (by rw [hgen]; trivial) hF hform

/-- Every form-preserving intertwiner of the actual extraspecial spin action
preserves orientation. -/
theorem det_one_of_form (F : SpinSpace ≃ₗ[ℝ] SpinSpace) (α : MulAut Q1Image)
    (hF : ∀ q v, F (SpinAction.imageRepresentation q v) =
      SpinAction.imageRepresentation (α q) (F v))
    (hform : ∀ v w, bothAxesDomain.form (F v) (F w) = bothAxesDomain.form v w) :
    LinearMap.det F.toLinearMap = 1 :=
  det_one_of_form_of_quarterTurn_generation quarterTurnAutomorphisms_generate F α hF hform

end Sporadic.Monster.Construction.LocalC.SourceNormalizer
