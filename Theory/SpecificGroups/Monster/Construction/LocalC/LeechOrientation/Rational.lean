module

public import Theory.AtlasPort.OtherSporadic.Conway.MinimalVectorOrder
public import Theory.AtlasPort.OtherSporadic.Mathieu.Mathieu24Alternating
public import Mathlib.LinearAlgebra.Matrix.Permutation

/-!
# Orientation of the rational Leech action

The full integral Leech isometry group is generated by its Golay monomial
subgroup and the sextet isometry. Golay sign changes have determinant one
because their supports have even size, and the Mathieu coordinate permutations
are even. The sextet map has six four-dimensional reflection blocks, with one
block negated; each block has determinant minus one. The generation theorem
then proves determinant one for the rational extension of every isometry.

Source: Aschbacher, *Sporadic Groups*, Section 22, especially 22.5, 22.10–22.12,
and the determinant-one Leech factor in Section 27, printed pp. 147–148.
The actual lattice, generators, and full-group generation theorem are the
attributed ATLAS constructions of Gerald Höhn, imported above.
-/

public section
noncomputable section
open Atlas.Codes Atlas.Conway
open scoped BigOperators Matrix
namespace Atlas.Lattices

private theorem sign_det (c : golay) :
    LinearMap.det (rationalExtension (signIsometry c).val).toLinearMap = 1 := by
  classical
  let D : Matrix Omega Omega ℚ := Matrix.diagonal (fun i => if c.val i = 0 then 1 else -1)
  have he : Matrix.toLin' D = (rationalExtension (signIsometry c).val).toLinearMap := by
    apply rationalExtension_unique
    intro x
    ext i
    by_cases hi : c.val i = 0 <;>
      simp [D, Matrix.toLin'_apply, Matrix.mulVec_diagonal, rationalEmbedding,
        signIsometry, signChange, hi]
  rw [← he, LinearMap.det_toLin', Matrix.det_diagonal, Finset.prod_ite]
  simp only [Finset.prod_const_one, one_mul, Finset.prod_const]
  change (-1 : ℚ) ^ hammingNorm c.val = 1
  exact (even_iff_two_dvd.mpr (dvd_trans (by decide : 2 ∣ 4)
    (golay_doublyEven c.val c.prop))).neg_one_pow

private theorem permutation_det (g : Mathieu24CodeModel) :
    LinearMap.det (rationalExtension (permutationEmbedding g).val).toLinearMap = 1 := by
  have he : Matrix.toLin' (Equiv.Perm.permMatrix ℚ g.val.symm) =
      (rationalExtension (permutationEmbedding g).val).toLinearMap := by
    apply rationalExtension_unique
    intro x
    ext i
    simp [Matrix.toLin'_apply, Matrix.permMatrix_mulVec, rationalEmbedding,
      permutationEmbedding, permutationIsometry, integerPermutation]
  rw [← he, LinearMap.det_toLin', Matrix.det_permutation]
  have hg : Equiv.Perm.sign g.val.symm = 1 := by
    exact mathieu24_even g⁻¹
  rw [hg]
  norm_num

private def tetradMatrix (i : HexIndex) : Matrix Tetrad Tetrad ℚ :=
  fun j k => sextetBlockSign i * ((if j = k then 1 else 0) - 1 / 2)

private theorem tetrad_det : ∀ i : HexIndex, (tetradMatrix i).det = -1 := by
  decide +kernel

private theorem sextet_det : LinearMap.det sextetReflection = 1 := by
  have hm : LinearMap.toMatrix' sextetReflection =
      (Matrix.blockDiagonal tetradMatrix).submatrix
        (Equiv.prodComm HexIndex Tetrad) (Equiv.prodComm HexIndex Tetrad) := by
    ext ⟨i,j⟩ ⟨k,l⟩
    by_cases hik : i = k
    · subst k
      simp [LinearMap.toMatrix'_apply, sextetReflection_apply,
        Matrix.blockDiagonal_apply, tetradMatrix, Pi.single_apply, eq_comm]
    · simp [LinearMap.toMatrix'_apply, sextetReflection_apply,
        Matrix.blockDiagonal_apply, hik]
  rw [← LinearMap.det_toMatrix', hm, Matrix.det_submatrix_equiv_self,
    Matrix.det_blockDiagonal]
  norm_num [tetrad_det, HexIndex]

private theorem zeta_det :
    LinearMap.det (rationalExtension zeta.val).toLinearMap = 1 := by
  have he : sextetReflection = (rationalExtension zeta.val).toLinearMap := by
    apply rationalExtension_unique
    intro x
    exact (zeta_agrees x).symm
  rw [← he]
  exact sextet_det

private def rationalDet : LeechIsometryGroup →* ℚˣ :=
  LinearEquiv.det.comp (rationalLatticeIsometries.subtype.comp fullIsometryExtension)

private theorem monomial_det (g : GolayMonomialGroup) : rationalDet (monomialEmbedding g) = 1 := by
  rw [← SemidirectProduct.inl_left_mul_inr_right g, map_mul, map_mul]
  have hs : monomialEmbedding (SemidirectProduct.inl g.left) = signIsometry g.left.toAdd :=
    DFunLike.congr_fun monomial_inl g.left
  have hp : monomialEmbedding (SemidirectProduct.inr g.right) = permutationEmbedding g.right :=
    DFunLike.congr_fun monomial_inr g.right
  rw [hs, hp]
  have h₁ : rationalDet (signIsometry g.left.toAdd) = 1 := by
    apply Units.ext
    simpa [rationalDet, fullIsometryExtension] using sign_det g.left.toAdd
  have h₂ : rationalDet (permutationEmbedding g.right) = 1 := by
    apply Units.ext
    simpa [rationalDet, fullIsometryExtension] using permutation_det g.right
  rw [h₁, h₂, one_mul]

/-- Every isometry of the full integral Leech lattice has rational determinant one. -/
theorem rationalExtension_det_one (g : LeechIsometryGroup) :
    LinearMap.det (rationalExtension g.val).toLinearMap = 1 := by
  have hle : generatedConwayGroup ≤ rationalDet.ker := by
    apply sup_le
    · rintro x ⟨y,rfl⟩
      exact monomial_det y
    · apply (Subgroup.closure_le _).mpr
      rintro x (rfl : x = zeta)
      apply Units.ext
      simpa [rationalDet, fullIsometryExtension] using zeta_det
  have hg : rationalDet g = 1 := hle (generatedConwayGroup_eq_full ▸ Subgroup.mem_top g)
  simpa [rationalDet, fullIsometryExtension] using congrArg Units.val hg

end Atlas.Lattices
