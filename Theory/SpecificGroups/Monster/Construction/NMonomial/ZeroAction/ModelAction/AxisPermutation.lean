module

public import Theory.SpecificGroups.Monster.Construction.NMonomial.ZeroAction.ModelAction.AxisPermutation.Transport
public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.NormalForms.Collection
public import Mathlib.GroupTheory.Perm.Sign

/-!
# The triality permutation, its kernel and its first-axis stabilizer

The halfspace and involution transport constructs a homomorphism on the literal
Parker group `N`. Distinctness of the three sign involutions identifies the
first-axis stabilizer with the source centralizer `N1`. The centralizer normal
form then identifies its permutation kernel with `NPlus`: fixing the second
axis forces the standard-automorphism factor to be even. Finally a Golay
coordinate functional supplies an actual odd cocode automorphism; its three
families realize all transpositions and hence the full symmetric group.

Together with `axisTransportData`, these results supply the group inputs for
the model-space action of 29.7.5, including its restrictions to `NPlus` and
`N1`. Source: Aschbacher, *Sporadic Groups*, 14.3–14.4, Sections 27 and 29,
the paragraph before 29.5 on printed p. 155, and formula 29.7.5 on p. 156.
-/

public section
noncomputable section
open Atlas.Fischer Atlas.Codes
namespace Sporadic.Monster.Construction.NMonomial.ZeroAction.ModelAction
open TrialitySpin SignedModules Natural

private theorem axisZ_injective : Function.Injective axisZ := by
  intro i j h
  have ht := congrArg (fun g : N => g.val (some loopOne, some loopOne, some loopOne)) h
  fin_cases i <;> fin_cases j
  all_goals first
    | rfl
    | simp [axisZ, z1N, z2N, z3N, psi1N, psi2N, psi3N, loopOne, parkerSign] at ht

/-- The first-axis stabilizer is the literal centralizer `C_N(z1N)`. -/
theorem axisPermutation_zero_iff (g : N) : axisPermutation g 0 = 0 ↔ g ∈ N1 := by
  have hc : g * axisZ 0 = axisZ (axisPermutation g 0) * g :=
    (mul_inv_eq_iff_eq_mul).mp (axisTransportData.conjugate_z g 0)
  constructor
  · intro h
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    simpa only [h, axisZ] using hc
  · intro h
    apply axisZ_injective
    apply mul_right_cancel (b := g)
    exact hc.symm.trans (Subgroup.mem_centralizer_singleton_iff.mp h)

private theorem NPlus_le_axisPermutation_ker : NPlus ≤ axisPermutation.ker := by
  apply (Subgroup.closure_le _).mpr
  rintro g (⟨d, hg | hg | hg⟩ | ⟨e, he, heven, hg⟩)
  · have h : g = psi1N d := Subtype.ext hg
    simp [h]
  · have h : g = psi2N d := Subtype.ext hg
    simp [h]
  · have h : g = psi3N d := Subtype.ext hg
    simp [h]
  · have h : g = psiAut1N ⟨e,he⟩ := by
      apply Subtype.ext
      simpa [psiAut1N, psiAut1, heven] using hg
    change axisPermutation g = 1
    rw [h]
    ext i : 1
    simp [autTarget, heven]

/-- The kernel is exactly the subgroup generated by loops and even standard automorphisms. -/
theorem axisPermutation_ker : axisPermutation.ker = NPlus := by
  apply le_antisymm _ NPlus_le_axisPermutation_ker
  intro g hg
  have hp : axisPermutation g = 1 := hg
  have hg1 : g ∈ N1 := (axisPermutation_zero_iff g).mp (by rw [hp]; rfl)
  obtain ⟨⟨d,e,α⟩, hw⟩ := normalForm_surjective ⟨g,hg1⟩
  have hv : (normalForm d e α).val = g := congrArg Subtype.val hw
  rw [← hv] at hp ⊢
  apply (normalForm_mem_NPlus_iff d e α).mpr
  have h1 := Equiv.congr_fun hp 1
  change axisPermutation (psiAut1N α * psi2N e * psi1N d) 1 = 1 at h1
  simp only [map_mul, axisPermutation_psi1N, axisPermutation_psi2N, mul_one,
    axisPermutation_psiAut1N] at h1
  by_contra ha
  simp [autTarget, ha, oddAxis] at h1

@[simp] theorem axisPermutation_eq_one_iff (g : N) : axisPermutation g = 1 ↔ g ∈ NPlus := by
  change g ∈ axisPermutation.ker ↔ _
  rw [axisPermutation_ker]

private theorem exists_odd_standard : ∃ α : ParkerStandardGroup, α.val parkerOmega ≠ parkerOmega := by
  let f : Module.Dual Bit golay :=
    { toFun := fun d => d.val ((0,0),0)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  obtain ⟨c, hc⟩ := cocodeDualEquiv.surjective f
  refine ⟨parkerCocodeStandard c, ?_⟩
  intro he
  have he' := congrArg Prod.snd he
  change 0 + cocodeDualEquiv c golayOne = 0 at he'
  rw [hc, zero_add] at he'
  exact one_ne_zero he'

/-- Actual odd cocode automorphisms realize all three transpositions. -/
theorem axisPermutation_surjective : Function.Surjective axisPermutation := by
  obtain ⟨α, hα⟩ := exists_odd_standard
  have h01 : axisPermutation (psiAut3N α) = Equiv.swap 0 1 := by
    ext k : 1
    fin_cases k <;> simp [autTarget, hα, oddAxis, Equiv.swap_apply_def]
  have h02 : axisPermutation (psiAut2N α) = Equiv.swap 0 2 := by
    ext k : 1
    fin_cases k <;> simp [autTarget, hα, oddAxis, Equiv.swap_apply_def]
  have h12 : axisPermutation (psiAut1N α) = Equiv.swap 1 2 := by
    ext k : 1
    fin_cases k <;> simp [autTarget, hα, oddAxis, Equiv.swap_apply_def]
  have hswap (i j : Axis) : Equiv.swap i j ∈ axisPermutation.range := by
    fin_cases i <;> fin_cases j
    · simpa only [Equiv.swap_self, ← Equiv.Perm.one_def] using axisPermutation.range.one_mem
    · exact ⟨_, h01⟩
    · exact ⟨_, h02⟩
    · rw [Equiv.swap_comm]; exact ⟨_, h01⟩
    · simpa only [Equiv.swap_self, ← Equiv.Perm.one_def] using axisPermutation.range.one_mem
    · exact ⟨_, h12⟩
    · rw [Equiv.swap_comm]; exact ⟨_, h02⟩
    · rw [Equiv.swap_comm]; exact ⟨_, h12⟩
    · simpa only [Equiv.swap_self, ← Equiv.Perm.one_def] using axisPermutation.range.one_mem
  intro p
  have hp : p ∈ axisPermutation.range := by
    induction p using Equiv.Perm.swap_induction_on with
    | one => exact axisPermutation.range.one_mem
    | swap_mul p i j _ ih => exact axisPermutation.range.mul_mem (hswap i j) ih
  exact hp

end Sporadic.Monster.Construction.NMonomial.ZeroAction.ModelAction
