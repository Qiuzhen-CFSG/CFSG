module

public import Theory.SpecificGroups.Monster.Construction.NMonomial.ZeroAction.ModelAction.TransportData
public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.SignedModules.Natural.StandardActions
public import Theory.SpecificGroups.Monster.Construction.TrialitySpin.Structure.OrbitKernels.Actions

/-!
# The actual Parker axis transport

The generator formulas carry each coordinate-halfspace family to the indicated
axis and intertwine both distinguished triples of involutions. These three
properties are closed under multiplication and inversion. Induction on the
concrete subgroup generated by the Parker permutations supplies them for every
element of `N`. Disjointness of the literal axes makes the resulting index
permutation unique and proves its homomorphism law.

This constructs the geometric witness used by the six oriented tensor spaces
in formula 29.7.5. Kernel, stabilizer and surjectivity are proved in the parent
`AxisPermutation` module.

Source: Aschbacher, *Sporadic Groups*, Section 14 (especially 14.2–14.3),
Section 27 (especially 27.4), and the paragraph before 29.5, printed p. 155.
Products and conjugation use left composition on the actual Parker triples.
-/

public section

noncomputable section
open Atlas.Fischer Atlas.Codes
namespace Sporadic.Monster.Construction.NMonomial.ZeroAction.ModelAction
open TrialitySpin SignedModules Natural

private theorem point_index_eq {i j : Axis} {d e : ParkerLoop}
    (h : point i d = point j e) : i = j := by
  fin_cases i <;> fin_cases j <;> simp_all [point, axis1, axis2, axis3]

private theorem axis_range_injective : Function.Injective (fun i : Axis => Set.range (point i)) := by
  intro i j h
  change Set.range (point i) = Set.range (point j) at h
  have hm : point i loopOne ∈ Set.range (point j) := by
    rw [← h]
    exact Set.mem_range_self loopOne
  obtain ⟨d, hd⟩ := hm
  exact point_index_eq hd.symm

private theorem carries_unique {i j k : Axis} (g : Equiv.Perm Triple)
    (hj : Carries i j g) (hk : Carries i k g) : j = k :=
  axis_range_injective ((image_axis g hj).symm.trans (image_axis g hk))

private theorem carries_one (i : Axis) : Carries i i 1 := by
  intro l
  exact ⟨l, by simp⟩

private theorem carries_mul {i j k : Axis} {g h : Equiv.Perm Triple}
    (hg : Carries j k g) (hh : Carries i j h) : Carries i k (g * h) := by
  intro l
  obtain ⟨m, hm⟩ := hh l
  obtain ⟨n, hn⟩ := hg m
  refine ⟨n, ?_⟩
  change (g ∘ h) '' halfspace i l = _
  rw [Set.image_comp, hm, hn]

private theorem carries_inv {i j : Axis} {g : Equiv.Perm Triple}
    (hg : Carries i j g) : Carries j i g⁻¹ := by
  intro l
  obtain ⟨m, hm⟩ := (labelEquiv g hg).surjective l
  have hi : g '' halfspace i m = halfspace j l :=
    (image_halfspace g hg m).trans (congrArg (halfspace j) hm)
  refine ⟨m, ?_⟩
  change g.symm '' halfspace j l = _
  rw [← hi, Equiv.symm_image_image]

private theorem autTarget_involutive (i : Axis) (e : Equiv.Perm ParkerLoop) :
    Function.Involutive (autTarget i e) := by
  intro j
  by_cases h : e parkerOmega = parkerOmega
  · simp [autTarget, h]
  · fin_cases i <;> fin_cases j <;> simp [autTarget, h, oddAxis]

private def autPermutation (i : Axis) (e : Equiv.Perm ParkerLoop) : Equiv.Perm Axis where
  toFun := autTarget i e
  invFun := autTarget i e
  left_inv := autTarget_involutive i e
  right_inv := autTarget_involutive i e

private structure Compatible (g : Equiv.Perm Triple) (p : Equiv.Perm Axis) : Prop where
  halfspaces : ∀ i, Carries i (p i) g
  orbit : ∀ i, g * (axisK i).val = (axisK (p i)).val * g
  signs : ∀ i, g * (axisZ i).val = (axisZ (p i)).val * g

private theorem Compatible.one : Compatible 1 1 where
  halfspaces := carries_one
  orbit := by intro i; simp
  signs := by intro i; simp

private theorem Compatible.mul {g h : Equiv.Perm Triple} {p q : Equiv.Perm Axis}
    (hg : Compatible g p) (hh : Compatible h q) : Compatible (g * h) (p * q) where
  halfspaces i := carries_mul (hg.halfspaces (q i)) (hh.halfspaces i)
  orbit i := by
    change (g * h) * (axisK i).val = (axisK (p (q i))).val * (g * h)
    rw [mul_assoc, hh.orbit i, ← mul_assoc, hg.orbit (q i), mul_assoc]
  signs i := by
    change (g * h) * (axisZ i).val = (axisZ (p (q i))).val * (g * h)
    rw [mul_assoc, hh.signs i, ← mul_assoc, hg.signs (q i), mul_assoc]

private theorem Compatible.inv {g : Equiv.Perm Triple} {p : Equiv.Perm Axis}
    (hg : Compatible g p) : Compatible g⁻¹ p⁻¹ where
  halfspaces i := by
    have hi := carries_inv (hg.halfspaces (p⁻¹ i))
    simpa using hi
  orbit i := by
    have hi := hg.orbit (p⁻¹ i)
    simp only [Equiv.Perm.inv_def, Equiv.apply_symm_apply] at hi
    rw [← Equiv.Perm.inv_def] at hi
    calc
      g⁻¹ * (axisK i).val = g⁻¹ * ((axisK i).val * g) * g⁻¹ := by simp [mul_assoc]
      _ = g⁻¹ * (g * (axisK (p⁻¹ i)).val) * g⁻¹ := by rw [← hi]
      _ = (axisK (p⁻¹ i)).val * g⁻¹ := by simp
  signs i := by
    have hi := hg.signs (p⁻¹ i)
    simp only [Equiv.Perm.inv_def, Equiv.apply_symm_apply] at hi
    rw [← Equiv.Perm.inv_def] at hi
    calc
      g⁻¹ * (axisZ i).val = g⁻¹ * ((axisZ i).val * g) * g⁻¹ := by simp [mul_assoc]
      _ = g⁻¹ * (g * (axisZ (p⁻¹ i)).val) * g⁻¹ := by rw [← hi]
      _ = (axisZ (p⁻¹ i)).val * g⁻¹ := by simp

private theorem loop_orbit (i j : Axis) (d : ParkerLoop) :
    psiAt i d * (axisK j).val = (axisK j).val * psiAt i d := by
  fin_cases i <;> fin_cases j <;> ext ⟨a,b,c⟩ : 1
  all_goals simp [psiAt, axisK, k1_apply, k2_apply, k3_apply]

private theorem loop_signs (i j : Axis) (d : ParkerLoop) :
    psiAt i d * (axisZ j).val = (axisZ j).val * psiAt i d := by
  fin_cases i <;> fin_cases j <;> ext ⟨a,b,c⟩ : 1
  all_goals simp [psiAt, axisZ, z1N, z2N, z3N, psi1N, psi2N, psi3N]

private theorem standard_orbit (i j : Axis) (α : ParkerStandardGroup) :
    psiAutAt i α.val * (axisK j).val =
      (axisK (autTarget i α.val j)).val * psiAutAt i α.val := by
  by_cases ha : α.val parkerOmega = parkerOmega
  · fin_cases i <;> fin_cases j <;> ext ⟨a,b,c⟩ : 1
    all_goals simp [psiAutAt, autTarget, psiAut1, psiAut2, psiAut3, ha,
      axisK, diagonal, k1_apply, k2_apply, k3_apply]
  · have ho := parkerStandard_omega_odd α ha
    fin_cases i <;> fin_cases j
    all_goals simp only [psiAutAt, autTarget, psiAut1, psiAut2, psiAut3, if_neg ha, oddAxis]
    all_goals ext ⟨a,b,c⟩ : 1
    all_goals simp [axisK, diagonal, flip1, flip2, flip3, k1_apply, k2_apply, k3_apply, ho,
      ← signZero_inverseZero, ← signZero_optionMap]

private theorem standard_signs (i j : Axis) (α : ParkerStandardGroup) :
    psiAutAt i α.val * (axisZ j).val =
      (axisZ (autTarget i α.val j)).val * psiAutAt i α.val := by
  by_cases ha : α.val parkerOmega = parkerOmega
  all_goals fin_cases i <;> fin_cases j <;> ext ⟨a,b,c⟩ : 1
  all_goals simp [psiAutAt, autTarget, oddAxis, psiAut1, psiAut2, psiAut3, ha,
    axisZ, diagonal, flip1, flip2, flip3, z1N, z2N, z3N, psi1N, psi2N, psi3N]

private theorem Compatible.loop (i : Axis) (d : ParkerLoop) : Compatible (psiAt i d) 1 where
  halfspaces j := psi_carries i j d
  orbit j := loop_orbit i j d
  signs j := loop_signs i j d

private theorem Compatible.standard (i : Axis) (α : ParkerStandardGroup) :
    Compatible (psiAutAt i α.val) (autPermutation i α.val) where
  halfspaces j := standard_carries i j α
  orbit j := standard_orbit i j α
  signs j := standard_signs i j α

private theorem exists_compatible (g : N) : ∃ p, Compatible g.val p := by
  rcases g with ⟨g,hg⟩
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with (((⟨d,rfl⟩ | ⟨d,rfl⟩) | ⟨d,rfl⟩) | ⟨α,hα,hg⟩)
    · exact ⟨1, Compatible.loop 0 d⟩
    · exact ⟨1, Compatible.loop 1 d⟩
    · exact ⟨1, Compatible.loop 2 d⟩
    · rcases hg with rfl | rfl | rfl
      · exact ⟨_, Compatible.standard 0 ⟨α,hα⟩⟩
      · exact ⟨_, Compatible.standard 1 ⟨α,hα⟩⟩
      · exact ⟨_, Compatible.standard 2 ⟨α,hα⟩⟩
  | one => exact ⟨1, Compatible.one⟩
  | mul g h _ _ ihg ihh =>
    obtain ⟨p, hp⟩ := ihg
    obtain ⟨q, hq⟩ := ihh
    exact ⟨p * q, hp.mul hq⟩
  | inv g _ ih =>
    obtain ⟨p, hp⟩ := ih
    exact ⟨p⁻¹, hp.inv⟩

private def chosenPermutation (g : N) : Equiv.Perm Axis := (exists_compatible g).choose

private theorem chosen_compatible (g : N) : Compatible g.val (chosenPermutation g) :=
  (exists_compatible g).choose_spec

/-- The permutation of the three literal Parker axes, induced by their halfspaces. -/
def axisPermutation : N →* Equiv.Perm Axis where
  toFun := chosenPermutation
  map_one' := by
    ext i : 1
    exact carries_unique _ ((chosen_compatible 1).halfspaces i) (carries_one i)
  map_mul' g h := by
    ext i : 1
    exact carries_unique _ ((chosen_compatible (g * h)).halfspaces i)
      (((chosen_compatible g).mul (chosen_compatible h)).halfspaces i)

/-- The same actual group element transports halfspaces and both involution triples. -/
@[expose] def axisTransportData : AxisTransportData where
  permutation := axisPermutation
  halfspaces g := by exact (chosen_compatible g).halfspaces
  conjugate_k g i := by
    apply Subtype.ext
    change (g.val * (axisK i).val) * g.val⁻¹ = _
    rw [(chosen_compatible g).orbit i, mul_assoc, mul_inv_cancel, mul_one]
    rfl
  conjugate_z g i := by
    apply Subtype.ext
    change (g.val * (axisZ i).val) * g.val⁻¹ = _
    rw [(chosen_compatible g).signs i, mul_assoc, mul_inv_cancel, mul_one]
    rfl

/-- Recognition by a computed action on the actual halfspaces. -/
theorem axisPermutation_eq_of_carries (g : N) (i j : Axis)
    (h : Carries i j g.val) : axisPermutation g i = j :=
  carries_unique _ (axisTransportData.halfspaces g i) h

@[simp] theorem axisPermutation_psi1N (d : ParkerLoop) : axisPermutation (psi1N d) = 1 := by
  ext i : 1
  exact axisPermutation_eq_of_carries (psi1N d) i i (psi_carries 0 i d)

@[simp] theorem axisPermutation_psi2N (d : ParkerLoop) : axisPermutation (psi2N d) = 1 := by
  ext i : 1
  exact axisPermutation_eq_of_carries (psi2N d) i i (psi_carries 1 i d)

@[simp] theorem axisPermutation_psi3N (d : ParkerLoop) : axisPermutation (psi3N d) = 1 := by
  ext i : 1
  exact axisPermutation_eq_of_carries (psi3N d) i i (psi_carries 2 i d)

@[simp] theorem axisPermutation_psiAut1N (α : ParkerStandardGroup) (j : Axis) :
    axisPermutation (psiAut1N α) j = autTarget 0 α.val j :=
  axisPermutation_eq_of_carries (psiAut1N α) j _ (standard_carries 0 j α)

@[simp] theorem axisPermutation_psiAut2N (α : ParkerStandardGroup) (j : Axis) :
    axisPermutation (psiAut2N α) j = autTarget 1 α.val j :=
  axisPermutation_eq_of_carries (psiAut2N α) j _ (standard_carries 1 j α)

@[simp] theorem axisPermutation_psiAut3N (α : ParkerStandardGroup) (j : Axis) :
    axisPermutation (psiAut3N α) j = autTarget 2 α.val j :=
  axisPermutation_eq_of_carries (psiAut3N α) j _ (standard_carries 2 j α)

end Sporadic.Monster.Construction.NMonomial.ZeroAction.ModelAction
