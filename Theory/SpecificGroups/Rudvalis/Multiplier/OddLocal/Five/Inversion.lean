/-!
# The simultaneous inverter for the marked Rudvalis 5-subgroup

An explicit word in the original ATLAS generators inverts the two local
generators and fixes their nontrivial central commutator. All equalities are
checked on every point using packed permutations. The subgroup and enumeration
are the previously checked converse witnesses, preserved at the Theory layer.
Source: ATLAS RuG1-p4060B0 and GLS3 Table 5.3r, p.279; the central-cover
application is Aschbacher–Smith I.1.3(1), printed p.407. The untrusted discovery
and generation scripts and exact words are retained in `../source/`.
-/

namespace Rudvalis.Multiplier.OddLocal.FiveCertificate
open Theory.GroupTheory
open scoped commutatorElement

set_option maxRecDepth 100000
set_option Elab.async false

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def rMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def rMap (x : Fin 4060) : Fin 4060 :=
  ⟨(rMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def rInvMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def rInvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(rInvMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem r_left : ∀ i, rInvMap (rMap i) = i := by
  apply Data.allFin
  decide +kernel

@[expose] public def rPerm : Equiv.Perm (Fin 4060) :=
  tablePerm rMap rInvMap (by exact r_left) (by exact rightInverse_of_leftInverse_fin r_left)

