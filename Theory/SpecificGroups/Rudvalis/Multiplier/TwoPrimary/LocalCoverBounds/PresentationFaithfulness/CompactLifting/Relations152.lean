private noncomputable def certificate (i : Fin 7) : Certificate :=
  (if i.val < 3 then (if i.val < 1 then certificate0 else (if i.val < 2 then certificate1 else certificate2)) else (if i.val < 5 then (if i.val < 4 then certificate3 else certificate4) else (if i.val < 6 then certificate5 else certificate6)))

set_option maxRecDepth 10000 in
private theorem checked : ∀ i : Fin 7,
    checkCertificate (certificate i)
      ((compactRelator (index i)).map (fun a => (compactIndex a.1, a.2))) = true := by
  decide +kernel

theorem holds (r : Fin 159) (_hlo : 152 ≤ r.val) (_hhi : r.val < 159) :
    eval compactImage (compactRelator r) = 1 := by
  let i : Fin 7 := ⟨r.val - 152, by omega⟩
  have he : index i = r := by
    apply Fin.ext
    exact Nat.sub_add_cancel _hlo
  have h := certificate_valid (certificate i) _
    (fun j _ => elimination_sound j.1) (checked i)
  rw [eval_map_letters, he] at h
  exact h

