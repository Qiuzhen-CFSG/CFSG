/-- The JSON edge numbering with zero-based finite indices. -/
def numberedEdge (i : Fin 336) : Edge := (⟨i.val / 2, by omega⟩, i.val % 2 == 1)

set_option maxRecDepth 10000 in
private theorem expansion_checked : ∀ i : Fin 336,
    checkReplay elimination (expansionSteps i) [(numberedEdge i, true)]
      ((expansionWord i).map (fun a => (compactIndex a.1, a.2))) = true := by
  decide +kernel

theorem expansion_sound (i : Fin 336) :
    rawImage (numberedEdge i) = eval compactImage (expansionWord i) := by
  have h := eval_of_checkReplay rawImage elimination (expansionSteps i)
    [(numberedEdge i, true)] _ (fun j _ => elimination_sound j.1) (expansion_checked i)
  rw [eval_map_letters, eval_letter] at h
  exact h.symm

private theorem numberedEdge_surjective : Function.Surjective numberedEdge := by
  rintro ⟨i, b⟩
  cases b
  · refine ⟨⟨2 * i.val, by omega⟩, ?_⟩
    apply Prod.ext
    · apply Fin.ext
      dsimp [numberedEdge]
      omega
    · simp [numberedEdge]
  · refine ⟨⟨2 * i.val + 1, by omega⟩, ?_⟩
    apply Prod.ext
    · apply Fin.ext
      dsimp [numberedEdge]
      omega
    · simp [numberedEdge, Nat.add_mod]

end Rudvalis.Multiplier.TwoPrimary.LocalPresentation.PresentationFaithfulness.CompactReplay
namespace Rudvalis.Multiplier.TwoPrimary.LocalPresentation.PresentationFaithfulness
open Subgroup.CosetWordCertificate CompactReplay

/-- The eleven prescribed retained edges generate the entire raw presentation. -/
theorem compactImage_generates : Subgroup.closure (Set.range compactImage) = ⊤ := by
  apply top_unique
  intro x _
  apply PresentedGroup.generated_by _ _ ?_ x
  intro e
  obtain ⟨i, rfl⟩ := numberedEdge_surjective e
  change rawImage (numberedEdge i) ∈ Subgroup.closure (Set.range compactImage)
  rw [expansion_sound]
  exact eval_mem_of_generators_mem _ compactImage
    (fun a => Subgroup.subset_closure (k := Set.range compactImage) ⟨a, rfl⟩) _

end Rudvalis.Multiplier.TwoPrimary.LocalPresentation.PresentationFaithfulness
