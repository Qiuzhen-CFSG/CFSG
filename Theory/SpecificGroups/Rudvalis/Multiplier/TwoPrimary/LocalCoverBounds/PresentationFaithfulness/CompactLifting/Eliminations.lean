private theorem elimination_acyclic : ∀ i : Fin 325,
    ∀ j ∈ (eliminationCertificate i).steps, j.1.val < i.val := by decide +kernel

set_option maxRecDepth 10000 in
private theorem elimination_checked : ∀ i : Fin 325,
    checkCertificate (eliminationCertificate i)
      ([((elimination i).1, true)] ++ FreeGroup.invRev (elimination i).2) = true := by
  decide +kernel

/-- Each recorded replacement is an equality in the literal raw presentation. -/
theorem elimination_sound (i : Fin 325) :
    rawImage (elimination i).1 = eval rawImage (elimination i).2 := by
  have h : ∀ n (hn : n < 325), rawImage (elimination ⟨n, hn⟩).1 =
      eval rawImage (elimination ⟨n, hn⟩).2 := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn
      apply eq_of_eval_relation
      apply certificate_valid (eliminationCertificate ⟨n, hn⟩) _ ?_
        (elimination_checked ⟨n, hn⟩)
      intro j hj
      exact ih j.1.val (elimination_acyclic ⟨n, hn⟩ j hj) j.1.isLt
  exact h i.val i.isLt

end Rudvalis.Multiplier.TwoPrimary.LocalPresentation.PresentationFaithfulness.CompactReplay
