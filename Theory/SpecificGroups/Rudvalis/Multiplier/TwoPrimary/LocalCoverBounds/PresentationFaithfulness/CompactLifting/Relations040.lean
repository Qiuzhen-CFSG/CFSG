    checkCertificate (certificate i)
      ((compactRelator (index i)).map (fun a => (compactIndex a.1, a.2))) = true := by
  decide +kernel

theorem holds (r : Fin 159) (_hlo : 40 ≤ r.val) (hhi : r.val < 48) :
    eval compactImage (compactRelator r) = 1 := by
  let i : Fin 8 := ⟨r.val - 40, by omega⟩
  have he : index i = r := by
    apply Fin.ext
    exact Nat.sub_add_cancel _hlo
  have h := certificate_valid (certificate i) _
    (fun j _ => elimination_sound j.1) (checked i)
  rw [eval_map_letters, he] at h
  exact h

