  (if i.val < 4 then (if i.val < 2 then (if i.val < 1 then certificate0 else certificate1) else (if i.val < 3 then certificate2 else certificate3)) else (if i.val < 6 then (if i.val < 5 then certificate4 else certificate5) else (if i.val < 7 then certificate6 else certificate7)))

