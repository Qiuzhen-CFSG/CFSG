/-! Kernel-checked coset certificate for the compact Rudvalis max4 auxiliary presentation, the subgroup generated by compact generators 3 and 9.
Generated from `source/compact.json` by `source/generate.py`.
The data are untrusted; `Scan.chunk_sound` supplies actual subgroup witnesses. -/

@[expose] public section
namespace Rudvalis.Multiplier.TwoPrimary.LocalPresentation.PresentationFaithfulness.CompactOrder
open Subgroup.CosetWordCertificate

def output (n : Nat) : Nat := min (outputCode n) 11810

def destination (n : Nat) : Fin 512 :=
  ⟨min (destCode n) 511, by omega⟩

def shapeAt (n : Nat) : Bool :=
  factBEq (facts (output n)) ⟨repCode (n / 22), [decode (n % 22)], repCode (destination n).val⟩

def shapeChunk (start count : Nat) : Bool :=
  (List.range count).all fun k => shapeAt (start+k)

theorem shapeChunk_sound {start count : Nat} (h : shapeChunk start count = true)
    (n : Nat) (hlo : start ≤ n) (hhi : n < start+count) : shapeAt n = true := by
  have hm : n-start ∈ List.range count := by simp only [List.mem_range]; omega
  have hs := List.all_eq_true.mp h (n-start) hm
  have he : start + (n-start) = n := by omega
  rwa [he] at hs

theorem output_lt (n : Nat) : output n < 11811 :=
  Nat.lt_of_le_of_lt (Nat.min_le_right _ _) (by decide)

end Rudvalis.Multiplier.TwoPrimary.LocalPresentation.PresentationFaithfulness.CompactOrder
