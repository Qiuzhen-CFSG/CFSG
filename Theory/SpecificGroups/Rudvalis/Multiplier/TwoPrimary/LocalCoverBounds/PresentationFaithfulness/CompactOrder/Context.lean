module

public import Theory.SpecificGroups.Rudvalis.Multiplier.TwoPrimary.LocalCoverBounds.PresentationFaithfulness.CompactOrder.defCode
public import Theory.SpecificGroups.Rudvalis.Multiplier.TwoPrimary.LocalCoverBounds.PresentationFaithfulness.CompactOrder.Setup

/-! Kernel-checked coset certificate for the compact Rudvalis max4 auxiliary presentation, the subgroup generated by compact generators 3 and 9.
Generated from `source/compact.json` by `source/generate.py`.
The data are untrusted; `Scan.chunk_sound` supplies actual subgroup witnesses. -/

@[expose] public section
namespace Rudvalis.Multiplier.TwoPrimary.LocalPresentation.PresentationFaithfulness.CompactOrder
open Subgroup.CosetWordCertificate

def definitions : Definitions (Fin 11) where
  parent n := min (defCode n / 22) (n - 1)
  letter n := decode (defCode n % 22)
  parent_lt n := by
    have := Nat.min_le_right (defCode (n+1) / 22) (n+1-1)
    omega

/-- All rotations of a source relator or its inverse remain actual relations. -/
def rotatedRelator (r : Nat) : Word (Fin 11) :=
  (if r % 128 < 64 then compactRelator ⟨r / 128 % 159, Nat.mod_lt _ (by decide)⟩
   else FreeGroup.invRev (compactRelator ⟨r / 128 % 159, Nat.mod_lt _ (by decide)⟩)).rotate (r % 64)

theorem eval_rotate {G α : Type*} [Group G] (g : α → G)
    (w : Word α) (hw : eval g w = 1) (k : Nat) : eval g (w.rotate k) = 1 := by
  simp only [eval, FreeGroup.lift_mk] at hw ⊢
  rw [List.map_rotate]
  exact List.prod_rotate_eq_one_of_prod_eq_one hw k

theorem rotatedRelator_valid (r : Nat) : eval generator (rotatedRelator r) = 1 := by
  apply eval_rotate
  split
  · exact generator_relators _
  · rw [eval_invRev, generator_relators, inv_one]

def context : Context (Fin 11) :=
  ⟨definitions.parent, definitions.letter, rotatedRelator, allowed⟩

theorem context_valid : Valid context smallSubgroup generator (definitions.repr generator) :=
  definitions.valid rotatedRelator allowed allowed_mem rotatedRelator_valid

end Rudvalis.Multiplier.TwoPrimary.LocalPresentation.PresentationFaithfulness.CompactOrder
