@[expose] def lineVector (i : Fin 4060) : Vec :=
  fun j => ((((lineBlocks[i.val / 128]!)[i.val % 128]! >>> (3 * j.val)) % 8 : ℕ) : ZMod 5)

/-- The two literal generator equations needed for projective propagation. -/
@[expose] def OrbitEquivariance : Prop :=
  (∀ i : Fin 4060, ∃ u : (ZMod 5)ˣ,
    matrixA.mulVec (lineVector i) = (u : ZMod 5) • lineVector (Rudvalis.aPerm i)) ∧
  (∀ i : Fin 4060, ∃ u : (ZMod 5)ˣ,
    matrixB.mulVec (lineVector i) = (u : ZMod 5) • lineVector (Rudvalis.bPerm i))

/-- The concrete frame determines any invertible matrix fixing all its lines
up to a scalar. Its proof uses only the first 28 vectors and vector 658. -/
@[expose] def FrameRigidity : Prop :=
  ∀ M : Matˣ, (∀ i : Fin 4060, ∃ u : (ZMod 5)ˣ,
    (M : Mat).mulVec (lineVector i) = (u : ZMod 5) • lineVector i) →
    ∃ u : (ZMod 5)ˣ, M = Matrix.GeneralLinearGroup.scalar (Fin 28) u

end
