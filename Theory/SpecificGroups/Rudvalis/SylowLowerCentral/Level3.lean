      (CatalogueCertificate.localPermutation 0)⁻¹ = (perm3 0)⁻¹ := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  apply modelSubgroup.subtype_injective
  change modelSubgroup.subtype (localGenerators 0) * modelSubgroup.subtype (gen3 0) *
    (modelSubgroup.subtype (localGenerators 0))⁻¹ = (modelSubgroup.subtype (gen3 0))⁻¹
  simp only [CatalogueCertificate.localPermutation_eq,perm3_eq] at he
  exact he
