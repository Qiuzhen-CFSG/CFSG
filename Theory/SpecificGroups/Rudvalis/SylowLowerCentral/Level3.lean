theorem perm3_eq (j : Fin 5) :
    perm3 j = modelSubgroup.subtype (gen3 j) := by
  fin_cases j
  · exact g3_0_eq
  · exact g3_1_eq
  · exact g3_2_eq
  · exact g3_3_eq
  · exact g3_4_eq
theorem gen3_mem_lower (j : Fin 5) :
    gen3 j ∈ localP.lowerCentralSeries 3 := by
  fin_cases j
  · exact commutator_mem_commutator (gen2_mem_lower 0) (localGenerators_mem 2)
  · exact commutator_mem_commutator (gen2_mem_lower 0) (localGenerators_mem 3)
  · exact commutator_mem_commutator (gen2_mem_lower 1) (localGenerators_mem 3)
  · exact commutator_mem_commutator (gen2_mem_lower 3) (localGenerators_mem 1)
  · exact commutator_mem_commutator (gen2_mem_lower 3) (localGenerators_mem 2)
