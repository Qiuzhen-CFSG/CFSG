module
public import Theory.SpecificGroups.Rudvalis.SylowLowerCentral.Level2
public import Mathlib.GroupTheory.Nilpotent
/-!
# Checked lower-central words in the Rudvalis Sylow group

Short nested commutators define each next family. Cached permutations are
compared on all 4060 points with those exact words. Conjugation and commutator
identities give the successive subgroup bounds; no GAP claim is trusted.

Source: the unchanged ATLAS Ru generators and conventions in LocalCover.Data;
GLS3 Table 5.3r and Aschbacher--Smith 15.1.22, printed p.1100. The adjacent
source generator records the independent certificate discovery.
-/

public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
namespace Rudvalis.SylowLowerCentral
open Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover
set_option maxRecDepth 30000
set_option Elab.async false
@[expose] def gen3 : Fin 5 → Model :=
  ![⁅gen2 0,localGenerators 2⁆, ⁅gen2 0,localGenerators 3⁆, ⁅gen2 1,localGenerators 3⁆, ⁅gen2 3,localGenerators 1⁆, ⁅gen2 3,localGenerators 2⁆]
@[expose] def g3_0MapPacked : Nat := 
@[expose] def g3_0Map (x : Fin 4060) : Fin 4060 :=
  ⟨(g3_0MapPacked >>> (12*x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩
@[expose] def g3_0InvPacked : Nat := 
@[expose] def g3_0Inv (x : Fin 4060) : Fin 4060 :=
  ⟨(g3_0InvPacked >>> (12*x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩
private theorem g3_0_left : ∀ x, g3_0Inv (g3_0Map x) = x := by
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel
@[expose] def g3_0Perm : Equiv.Perm (Fin 4060) :=
  tablePerm g3_0Map g3_0Inv (by exact g3_0_left)
    (by exact rightInverse_of_leftInverse_fin g3_0_left)
private theorem g3_0_eq : g3_0Perm = modelSubgroup.subtype (gen3 0) := by
  have he : g3_0Perm = ⁅perm2 0,CatalogueCertificate.localPermutation 2⁆ := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  simp only [perm2_eq, CatalogueCertificate.localPermutation_eq] at he
  exact he
