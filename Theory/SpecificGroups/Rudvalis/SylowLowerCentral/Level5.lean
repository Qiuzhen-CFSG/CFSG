theorem perm5_eq (j : Fin 3) :
    perm5 j = modelSubgroup.subtype (gen5 j) := by
  fin_cases j
  · exact g5_0_eq
  · exact g5_1_eq
  · exact g5_2_eq
theorem gen5_mem_lower (j : Fin 3) :
    gen5 j ∈ localP.lowerCentralSeries 5 := by
  fin_cases j
  · exact commutator_mem_commutator (gen4_mem_lower 1) (localGenerators_mem 0)
  · exact commutator_mem_commutator (gen4_mem_lower 1) (localGenerators_mem 2)
  · exact commutator_mem_commutator (gen4_mem_lower 3) (localGenerators_mem 3)
