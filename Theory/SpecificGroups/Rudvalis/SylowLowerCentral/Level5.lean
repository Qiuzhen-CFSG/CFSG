public import Theory.SpecificGroups.Rudvalis.SylowLowerCentral.Level4
public import Mathlib.GroupTheory.Nilpotent
/-!
# Checked lower-central words in the Rudvalis Sylow group

Short nested commutators define each next family. Cached permutations are
compared on all 4060 points with those exact words. Conjugation and commutator
identities give the successive subgroup bounds; no GAP claim is trusted.

Source: the unchanged ATLAS Ru generators and conventions in LocalCover.Data;
GLS3 Table 5.3r and Aschbacher--Smith 15.1.22, printed p.1100. The adjacent
source generator records the independent certificate discovery.
-/

public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
namespace Rudvalis.SylowLowerCentral
open Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover
set_option maxRecDepth 30000
set_option Elab.async false
@[expose] def gen5 : Fin 3 → Model :=
  ![⁅gen4 1,localGenerators 0⁆, ⁅gen4 1,localGenerators 2⁆, ⁅gen4 3,localGenerators 3⁆]
@[expose] def g5_0MapPacked : Nat := 
@[expose] def g5_0Map (x : Fin 4060) : Fin 4060 :=
  ⟨(g5_0MapPacked >>> (12*x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩
@[expose] def g5_0InvPacked : Nat := 
@[expose] def g5_0Inv (x : Fin 4060) : Fin 4060 :=
  ⟨(g5_0InvPacked >>> (12*x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩
private theorem g5_0_left : ∀ x, g5_0Inv (g5_0Map x) = x := by
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel
@[expose] def g5_0Perm : Equiv.Perm (Fin 4060) :=
  tablePerm g5_0Map g5_0Inv (by exact g5_0_left)
    (by exact rightInverse_of_leftInverse_fin g5_0_left)
private theorem g5_0_eq : g5_0Perm = modelSubgroup.subtype (gen5 0) := by
  have he : g5_0Perm = ⁅perm4 1,CatalogueCertificate.localPermutation 0⁆ := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  simp only [perm4_eq, CatalogueCertificate.localPermutation_eq] at he
  exact he
