      (CatalogueCertificate.localPermutation 0)⁻¹ = (perm2 1)⁻¹ * perm2 0 * perm2 1 := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  apply modelSubgroup.subtype_injective
  change modelSubgroup.subtype (localGenerators 0) * modelSubgroup.subtype (gen2 0) *
    (modelSubgroup.subtype (localGenerators 0))⁻¹ = (modelSubgroup.subtype (gen2 1))⁻¹ * modelSubgroup.subtype (gen2 0) * modelSubgroup.subtype (gen2 1)
  simp only [CatalogueCertificate.localPermutation_eq,perm2_eq] at he
  exact he
