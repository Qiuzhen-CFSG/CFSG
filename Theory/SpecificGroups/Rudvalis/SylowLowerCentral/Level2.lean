theorem perm2_eq (j : Fin 5) :
    perm2 j = modelSubgroup.subtype (gen2 j) := by
  fin_cases j
  · exact g2_0_eq
  · exact g2_1_eq
  · exact g2_2_eq
  · exact g2_3_eq
  · exact g2_4_eq
theorem gen2_mem_lower (j : Fin 5) :
    gen2 j ∈ localP.lowerCentralSeries 2 := by
  fin_cases j
  · exact commutator_mem_commutator (gen1_mem_lower 0) (localGenerators_mem 1)
  · exact commutator_mem_commutator (gen1_mem_lower 0) (localGenerators_mem 2)
  · exact commutator_mem_commutator (gen1_mem_lower 0) (localGenerators_mem 3)
  · exact commutator_mem_commutator (gen1_mem_lower 1) (localGenerators_mem 3)
  · exact commutator_mem_commutator (gen1_mem_lower 2) (localGenerators_mem 2)
