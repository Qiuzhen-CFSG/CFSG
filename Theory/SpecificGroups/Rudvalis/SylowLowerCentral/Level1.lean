@[expose] def perm1 : Fin 5 → Equiv.Perm (Fin 4060) :=
  ![g1_0Perm, g1_1Perm, g1_2Perm, g1_3Perm, g1_4Perm]
theorem perm1_eq (j : Fin 5) :
    perm1 j = modelSubgroup.subtype (gen1 j) := by
  fin_cases j
  · exact g1_0_eq
  · exact g1_1_eq
  · exact g1_2_eq
  · exact g1_3_eq
  · exact g1_4_eq
theorem gen1_mem_lower (j : Fin 5) :
    gen1 j ∈ localP.lowerCentralSeries 1 := by
  fin_cases j
  · exact commutator_mem_commutator (localGenerators_mem 0) (localGenerators_mem 3)
  · exact commutator_mem_commutator (localGenerators_mem 1) (localGenerators_mem 2)
  · exact commutator_mem_commutator (localGenerators_mem 1) (localGenerators_mem 3)
  · exact commutator_mem_commutator (localGenerators_mem 2) (localGenerators_mem 3)
  · exact (mem_normalizer_iff.mp
      (localP.self_le_normalizer_lowerCentralSeries 1 (localGenerators_mem 2)) _).mp
      (commutator_mem_commutator (localGenerators_mem 1) (localGenerators_mem 3))
