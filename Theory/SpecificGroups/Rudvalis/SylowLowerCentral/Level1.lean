module
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.RankOneEightCharacteristic
public import Mathlib.GroupTheory.Nilpotent
/-!
# Checked lower-central words in the Rudvalis Sylow group

Short nested commutators define each next family. Cached permutations are
compared on all 4060 points with those exact words. Conjugation and commutator
identities give the successive subgroup bounds; no GAP claim is trusted.

Source: the unchanged ATLAS Ru generators and conventions in LocalCover.Data;
GLS3 Table 5.3r and Aschbacher--Smith 15.1.22, printed p.1100. The adjacent
source generator records the independent certificate discovery.
-/

public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
namespace Rudvalis.SylowLowerCentral
open Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover
set_option maxRecDepth 30000
set_option Elab.async false
@[expose] def gen1 : Fin 5 → Model :=
  ![⁅localGenerators 0,localGenerators 3⁆, ⁅localGenerators 1,localGenerators 2⁆, ⁅localGenerators 1,localGenerators 3⁆, ⁅localGenerators 2,localGenerators 3⁆, localGenerators 2 * ⁅localGenerators 1,localGenerators 3⁆ * (localGenerators 2)⁻¹]
@[expose] def g1_0MapPacked : Nat := 
@[expose] def g1_0Map (x : Fin 4060) : Fin 4060 :=
  ⟨(g1_0MapPacked >>> (12*x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩
@[expose] def g1_0InvPacked : Nat := 
@[expose] def g1_0Inv (x : Fin 4060) : Fin 4060 :=
  ⟨(g1_0InvPacked >>> (12*x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩
private theorem g1_0_left : ∀ x, g1_0Inv (g1_0Map x) = x := by
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel
@[expose] def g1_0Perm : Equiv.Perm (Fin 4060) :=
  tablePerm g1_0Map g1_0Inv (by exact g1_0_left)
    (by exact rightInverse_of_leftInverse_fin g1_0_left)
private theorem g1_0_eq : g1_0Perm = modelSubgroup.subtype (gen1 0) := by
  have he : g1_0Perm = ⁅CatalogueCertificate.localPermutation 0,CatalogueCertificate.localPermutation 3⁆ := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  simp only [CatalogueCertificate.localPermutation_eq, CatalogueCertificate.localPermutation_eq] at he
  exact he
