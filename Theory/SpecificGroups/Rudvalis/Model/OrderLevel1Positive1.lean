/-!
# The second positive Rudvalis level-1 transition

Left multiplication by the second positive generator sends each of the 1755
representatives to its specified orbit representative times the specified word
in the level-2 generators. The nine kernel-checked block certificates cover all
351 batches of five representatives; `positiveStep_of_blocks` assembles them.

Source: the ATLAS degree-4060 witnesses in `OrderLevel1Data` and `OrderChainData`,
generated by `OrderCertificate/GenerateChain.g` and `OrderCertificate/GenerateFactors.g`.
-/

namespace Rudvalis.OrderCertificate
open Theory.GroupTheory OrderLevel1Positive1

/-- The positive transition for generator 1 and every level-1 representative. -/
public theorem L1PositiveStep1 (r : Fin 1755) :
    L1Gen 1 * L1Rep r = L1Rep (L1Act 1 r) * evalWord L2Gen (L1Factor 1 r) := by
  apply positiveStep_of_blocks
  intro k
  fin_cases k
  · exact block0
  · exact block1
  · exact block2
  · exact block3
  · exact block4
  · exact block5
  · exact block6
  · exact block7
  · exact block8

end Rudvalis.OrderCertificate
