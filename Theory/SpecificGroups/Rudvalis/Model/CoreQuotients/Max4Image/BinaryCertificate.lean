/-- Images of the three binary basis vectors. -/
@[expose] public def signature (i : Fin 168) : Fin 8 × Fin 8 × Fin 8 :=
  (act (words i) 1, act (words i) 2, act (words i) 4)

private def encode (t : Fin 8 × Fin 8 × Fin 8) : Nat :=
  t.1.val * 64 + t.2.1.val * 8 + t.2.2.val

private theorem adjacent : ∀ i : Fin 167,
    encode (signature i.castSucc) < encode (signature i.succ) := by
  decide +kernel

/-- The 168 words have pairwise distinct triples of basis images. -/
public theorem signature_injective : Function.Injective signature := by
  intro i j h
  have hm : StrictMono (fun i : Fin 168 => encode (signature i)) :=
    Fin.strictMono_iff_lt_succ.mpr adjacent
  exact hm.injective (congrArg encode h)

end Rudvalis.CoreQuotients.Max4Image.BinaryCertificate
