module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.Sylow.LocalOrder.Data
public import Theory.SpecificGroups.Rudvalis.Model.OrderCheck

/-!
# Labels for the involutions in the concrete Rudvalis Sylow subgroup

The table assigns 64 labels (including the identity) to candidate normal forms.
Each label has at most 21 entries; repeated entries pad shorter rows. These
untrusted data are checked against the original point action in `Checks`.
They do not change the group carrier or assert normality of elementary subgroups.

Source: the ATLAS degree-4060 action and the preserved max4 word coordinates
in `Sylow.Candidate`. This finite certificate proves the upper bound in
GLS3, Section 5.6, printed p.307; see `source/README.md` for regeneration.
-/

namespace Rudvalis.TwoRankSix
open SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder

@[expose] public def addressData : Nat := 

@[expose] public def entryData : Nat := 

/-- A proposed position in the labelled table. Non-involutions may map anywhere. -/
@[expose] public def address (n : Fin 16384) : Nat :=
  (addressData >>> (11 * n.val)) % 2048

@[expose] public def label (n : Fin 16384) : Fin 64 :=
  ⟨address n / 21 % 64, Nat.mod_lt _ (by decide)⟩

@[expose] public def slot (n : Fin 16384) : Fin 21 :=
  ⟨address n % 21, Nat.mod_lt _ (by decide)⟩

/-- A normal-form index at a specified label and slot. -/
@[expose] public def entry (c : Fin 64) (s : Fin 21) : Fin 16384 :=
  ⟨(entryData >>> (14 * (21 * c.val + s.val))) % 16384,
    Nat.mod_lt _ (by decide)⟩

/-- Either the entry is listed or its square moves one of the two base points. -/
@[expose] public def Covered (n : Fin 16384) : Prop :=
  entry (label n) (slot n) = n ∨
    normalMap n (normalMap n 0) ≠ 0 ∨ normalMap n (normalMap n 1) ≠ 1

/-- Distinct entries at one label fail to commute at a base point. -/
@[expose] public def Separated (c : Fin 64) (s t : Fin 21) : Prop :=
  entry c s = entry c t ∨
    normalMap (entry c s) (normalMap (entry c t) 0) ≠
      normalMap (entry c t) (normalMap (entry c s) 0) ∨
    normalMap (entry c s) (normalMap (entry c t) 1) ≠
      normalMap (entry c t) (normalMap (entry c s) 1)

public instance (n : Fin 16384) : Decidable (Covered n) :=
  inferInstanceAs (Decidable (_ ∨ _ ∨ _))

public instance (c : Fin 64) (s t : Fin 21) : Decidable (Separated c s t) :=
  inferInstanceAs (Decidable (_ ∨ _ ∨ _))

end Rudvalis.TwoRankSix
