/-- Every binary normal form is listed, or its square moves a base point. -/
public theorem covered (n : Fin 16384) : Covered n := by
  let b : Fin 64 := ⟨n.val / 256, by omega⟩
  let i : Fin 256 := ⟨n.val % 256, Nat.mod_lt _ (by decide)⟩
  have h : blockIndex b i = n := by
    apply Fin.ext
    dsimp [blockIndex, b, i]
    omega
  rw [← h]
  exact covered_blocks b i

