module

public import Theory.SpecificGroups.Rudvalis.Model.TwoRankSix.Data
import Mathlib.Tactic.FinCases

/-!
# Kernel certificates for the Rudvalis two-rank bound

The first checks cover all 16384 normal forms in blocks of 256. The second
checks separate distinct commuting entries within each of the 64 label classes.
Only the images of the points 0 and 1 are used as negative witnesses; no
assumption that these points form a base is needed here.

The measured representative blocks take about three seconds each. Declaration
checks are sequential to bound kernel memory independently of the number of
blocks. The tables and this file are generated by `source/Generate.py` from the
preserved ATLAS max4 coordinates; all assertions are kernel-checked.
-/

namespace Rudvalis.TwoRankSix

set_option Elab.async false
set_option maxRecDepth 30000

@[expose] public def blockIndex (b : Fin 64) (i : Fin 256) : Fin 16384 :=
  ⟨256 * b.val + i.val, by omega⟩

