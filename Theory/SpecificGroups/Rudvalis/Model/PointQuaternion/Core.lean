module
public import Theory.SpecificGroups.Rudvalis.Model.PointQuaternion.Embedding
import all Theory.SpecificGroups.Rudvalis.Model.PointQuaternion.Embedding
import all Theory.SpecificGroups.Rudvalis.Model.PointCoreBound

/-!
# The quaternion lies in the Rudvalis point two-core

The quaternion's eight native elements preserve the five sixteen-point
blocks of the actual max6 quotient. Injectivity of the block labelling puts
them in its kernel, already identified with O₂(max6). The original
conjugator transports this to the literal ambient involution centralizer.
The proof checks images of the small blocks, without enumerating all points.

An explicit involution in that core fails to commute with a quaternion
generator. Thus centralization of the source's E₃₂ must not be replaced by
centralization of every core involution. This diagnoses the intermediate
Ω₁ wording on printed p.612; it is not a counterexample to the ambient
source theorem or to the needed placement of its particular three-space.

The import-all edges are an intentional internal split of the native
certificate, retaining private coordinate and alignment boundaries.
Source: Aschbacher--Smith J.2.3(7), p.433, and 4.2.13, pp.611--612;
original ATLAS attribution and conventions are retained in Embedding.
-/

public section
namespace Rudvalis.PointQuaternion
open Subgroup SylowOvergroups
open SylowOvergroups.RadicalCoverage.SylowCertificate
open SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder
open SylowOvergroups.RadicalCoverage.LocalCover
open Max6Certificate CoreQuotients.Max6Blocks PointCoreBound
set_option maxRecDepth 30000

private theorem blocks_check : ∀ a : QuaternionGroup 2, ∀ i : Fin 5,
    (alignedBlock i).image (normalMap (index a)) = alignedBlock i := by
  decide +kernel



private theorem mem_core_of_blocks (v : Model) (hv : v ∈ candidate)
    (hb : ∀ i : Fin 5, ∀ x ∈ alignedBlock i, v • x ∈ alignedBlock i) :
    v ∈ (centralizer ({elementaryGenerator 0} : Set Model)).pCoreIn 2 := by
  let t := MulAut.conj conjugator
  have he : v ∈ centralizer ({elementaryGenerator 0} : Set Model) :=
    candidate_le_point_centralizer hv
  have hm : t.symm v ∈ max6 := by
    rw [←aligned_max6_eq] at he
    obtain ⟨x,hx,hxe⟩ := he
    have h : x = t.symm v := t.injective (by rw [t.apply_symm_apply]; exact hxe)
    exact h ▸ hx
  let u : max6 := ⟨t.symm v,hm⟩
  have hu : u ∈ CoreQuotients.max6FiveAction.ker := by
    apply MonoidHom.mem_ker.mpr
    apply Equiv.ext
    intro i
    have hsub : (block i).map u.val.val.toEmbedding ⊆ block i := by
      intro y hy
      obtain ⟨x,hx,rfl⟩ := Finset.mem_map.mp hy
      have hax : AlignmentData.gapPerm.symm x ∈ alignedBlock i :=
        Finset.mem_map.mpr ⟨x,hx,rfl⟩
      have hh := hb i (AlignmentData.gapPerm.symm x) hax
      obtain ⟨y,hy,hye⟩ := Finset.mem_map.mp hh
      have hpoint : u.val.val x = y := by
        change (t.symm v).val x = y
        change (conjugator.val⁻¹ * v.val * conjugator.val) x = y
        rw [conjugator_val]
        have hp := congrArg AlignmentData.gapPerm hye
        change AlignmentData.gapPerm (v • (AlignmentData.gapPerm.symm x)) = y
        change AlignmentData.gapPerm (AlignmentData.gapPerm.symm y) =
          AlignmentData.gapPerm (v • (AlignmentData.gapPerm.symm x)) at hp
        rw [Equiv.apply_symm_apply] at hp
        exact hp.symm
      exact hpoint.symm ▸ hy
    have heq : (block i).map u.val.val.toEmbedding = block i :=
      Finset.eq_of_subset_of_card_le hsub (by rw [Finset.card_map])
    exact block_injective ((CoreQuotients.max6FiveAction_blocks u i).symm.trans heq)
  rw [CoreQuotients.max6FiveAction_ker] at hu
  have hmap := map_pCoreIn_of_injective 2 max6 t.toMonoidHom t.injective
  rw [aligned_max6_eq] at hmap
  rw [←hmap]
  exact ⟨u,⟨u,hu,rfl⟩,t.apply_symm_apply _⟩

/-- The quaternion lies in the literal two-core, by the actual five-block map. -/
theorem embedding_mem_core (a : QuaternionGroup 2) :
    embedding a ∈ (centralizer ({elementaryGenerator 0} : Set Model)).pCoreIn 2 := by
  apply mem_core_of_blocks _ (candidateNormalForm_mem _)
  intro i x hx
  rw [normal_smul,←blocks_check a i]
  exact Finset.mem_image.mpr ⟨x,hx,rfl⟩

/-- The quaternion does not centralize every involution of the point core.
Thus its centralization of the source's E₃₂ cannot be replaced by a statement
about the subgroup generated by all core involutions. This does not refute
the ambient source theorem. -/
theorem exists_core_involution_not_centralized :
    ∃ u : Model,
      u ∈ (centralizer ({elementaryGenerator 0} : Set Model)).pCoreIn 2 ∧
      u ^ 2 = 1 ∧ ¬ Commute (embedding (.a 1)) u := by
  refine ⟨candidateNormalForm 1,?_,?_,?_⟩
  · apply mem_core_of_blocks _ (candidateNormalForm_mem _)
    have ht : ∀ i : Fin 5, (alignedBlock i).image (normalMap 1) = alignedBlock i := by
      decide +kernel
    intro i x hx
    rw [normal_smul,←ht i]
    exact Finset.mem_image.mpr ⟨x,hx,rfl⟩
  · apply candidate_ext _ _ (candidate.pow_mem (candidateNormalForm_mem _) 2) candidate.one_mem
    · rw [pow_two,mul_smul,normal_smul,normal_smul,one_smul]; decide +kernel
    · rw [pow_two,mul_smul,normal_smul,normal_smul,one_smul]; decide +kernel
  · intro h
    have hh := congrArg (fun x : Model => x • (0 : Fin 4060)) h.eq
    simp only [mul_smul,embedding_smul,normal_smul] at hh
    exact (by decide +kernel :
      normalMap (index (.a 1)) (normalMap 1 0) ≠
        normalMap 1 (normalMap (index (.a 1)) 0)) hh

/-- The original max6 marking gives the full centralizer after conjugation. -/
theorem marked_centralizer_eq : max6.map (MulAut.conj conjugator).toMonoidHom =
    centralizer ({elementaryGenerator 0} : Set Model) := aligned_max6_eq

end Rudvalis.PointQuaternion
