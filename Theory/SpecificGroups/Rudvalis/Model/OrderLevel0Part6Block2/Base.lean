/-!
# Cached word evaluation for Rudvalis block 2

Composition certificates reuse repeated subwords in the long factor witnesses.
The witnesses come from `OrderLevel0Data`, `PermutationData`, and
`OrderChainData`. Generated by `OrderCertificate/GenerateLevel0Part6Block2Cached.py`; Python supplies
only witnesses, and Lean's kernel verifies every finite equality.
-/
namespace Rudvalis.OrderCertificate.ForwardReduction.Part6Block2.Cache
set_option maxRecDepth 30000
set_option Elab.async false
@[expose] public def force (f : Nat → Nat) : Nat → Nat
  | 0 => f 0
  | n + 1 => f (n + 1)

private theorem force_eq (f : Nat → Nat) (n : Nat) : force f n = f n := by
  cases n <;> rfl

public theorem compose {t a b : Nat → Nat} {p q : Equiv.Perm (Fin 4060)}
    (h : ∀ x : Fin 4060, t x.val = force a (b x.val))
    (ha : ∀ x : Fin 4060, a x.val = (p x).val)
    (hb : ∀ x : Fin 4060, b x.val = (q x).val)
    (x : Fin 4060) : t x.val = ((p * q) x).val := by
  rw [h x, force_eq, hb x, ha (q x)]
  rfl

