module

public import Theory.SpecificGroups.Rudvalis.Model.OrderLevel0Part4Group0Maps4

/-!
# Shared word maps for the first Rudvalis part-4 group

These tables compress repeated subwords in the fixed ATLAS transitions for
part-4 batches 1 through 14. Each table is proved equal to the composition
of two earlier tables by a finite kernel check. Induction through the word
identities identifies every table with its original permutation word.

Witness source: `OrderLevel0Data`, `OrderChainData`, and `PermutationData`.
Generated by `OrderCertificate/GenerateLevel0Part4Group0Compression.py`;
the generator supplies witnesses only, and Lean checks all identities.
-/

namespace Rudvalis.OrderCertificate.ForwardReduction.Part4Certificates.Group0Compression
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option Elab.async false

@[expose] public def word108 : List (Fin 8) := word6 ++ word67
@[expose] public def packed108 : Nat := 
@[expose] public def map108 (x : Fin 4060) : Fin 4060 :=
  ⟨(packed108 >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem map108_check :
    checkFin (fun x => decide (map108 x = map6 (map67 x))) = true := by
  decide +kernel

public theorem map108_spec (x : Fin 4060) :
    map108 x = evalWord gen word108 x := by
  have h := allFin _ map108_check x
  simp only [map6_spec, map67_spec] at h
  simpa only [word108, evalWord_append, Equiv.Perm.mul_apply] using h

