module

public import Theory.SpecificGroups.Rudvalis.Model.Basic
public import Mathlib.GroupTheory.Index
public import Mathlib.Order.Atoms

/-!
# Two concrete candidates for the Sylow overgroups of Rudvalis

The two pairs of words below are translations of the ATLAS subgroup programs
`RuG1-max4W1` and `RuG1-max6W1`. They define subgroups of the existing
degree-4060 model, with no change of carrier. Inverting the original GAP
point maps in `Model.PermutationData` means that word order is preserved.

The ATLAS labels these subgroups `2^(3+8):L₃(2)` and `2^(1+4+6).S₅`.
These labels motivate the definitions; neither their structure nor their
orders, maximality, or exhaustiveness is asserted here. The separate
`OddIndexMaximalCover` proposition specifies the exhaustive calculation
needed by a consumer, using actual group equivalences.

Source: Wilson–Nickerson–Bray, ATLAS of Finite Group Representations,
<https://brauer.maths.qmul.ac.uk/Atlas/v3/subgroup/RuG1-max4W1> and
<https://brauer.maths.qmul.ac.uk/Atlas/v3/subgroup/RuG1-max6W1>.
The contributor fields are unrecorded. Unmodified straight-line programs
are retained in `source/`; the modification here is their translation into
Lean group expressions. GLS3, Table 5.3r, printed p.279, gives the local
structures. Exhaustiveness requires the Sylow-overgroup analysis of
Aschbacher, *Overgroups of Sylow subgroups in sporadic groups* (1986).
-/

namespace Rudvalis.SylowOvergroups

/-- Outputs in registers 1 and 2 of the ATLAS program `RuG1-max4W1`. -/
@[expose] public def max4Generators : Model × Model :=
  let r3 := a * b
  let r4 := r3 * b
  let r5 := r3 * r4
  let r6 := r3 * r5
  let r8 := r6 * r5
  let r1 := b * b
  let r2 := r8 ^ 5
  let r7 := r6⁻¹
  let r4' := r7 * r2
  let r2' := r4' * r6
  let r9 := r3 * r8
  let r8' := r9 * r9
  let r7' := r8'⁻¹
  let r3' := r7' * r1
  (r3' * r8', r2')

/-- Outputs in registers 1 and 2 of the ATLAS program `RuG1-max6W1`. -/
@[expose] public def max6Generators : Model × Model :=
  let r3 := a * b
  let r4 := r3 * b
  let r5 := r3 * r4
  let r6 := r3 * r5
  let r7 := r6 * r3
  let r8 := r7 * r4
  let r6' := r5⁻¹
  let r9 := r6' * a
  let r10 := r9 * r5
  let r1 := r3 * r8
  let r9' := r1 ^ 10
  let r8' := r9' * r10
  let r11 := r8' ^ 6
  let r8'' := r7 * r7
  let r7' := r8''⁻¹
  let r6'' := r7' * r10
  let r10' := r6'' * r8''
  let r8''' := r9' * r10'
  let r12 := r8''' ^ 4
  (r1, r11 * r12)

/-- The subgroup generated by the fourth ATLAS maximal-subgroup program. -/
@[expose] public def max4 : Subgroup Model :=
  Subgroup.closure {max4Generators.1, max4Generators.2}

/-- The subgroup generated by the sixth ATLAS maximal-subgroup program. -/
@[expose] public def max6 : Subgroup Model :=
  Subgroup.closure {max6Generators.1, max6Generators.2}

/-- The exhaustive odd-index maximal-subgroup calculation, stated separately
from the concrete definitions. This module supplies no witness of it. -/
@[expose] public def OddIndexMaximalCover : Prop :=
  ∀ M : Subgroup Model, IsCoatom M → ¬ 2 ∣ M.index →
    Nonempty (M ≃* max4) ∨ Nonempty (M ≃* max6)

end Rudvalis.SylowOvergroups
