private theorem c2s3_facts : ∀ x : Fin 4060,
    (x ∈ c2s3Cell ↔ c2s2 x = 1764) ∧
      c2s3 x = c2s2 x * 7 + bitCount c2s3Rows x :=
  allFinBlocks c2s3Facts c2s3_blocks

public theorem c2s3_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s3 (p x) = c2s3 x :=
  refine_preserved p hp c2s2 c2s3 c2s3Cell 1764 7
    c2s3_nodup (fun x => (c2s3_facts x).1)
    (fun x => ((c2s3_facts x).2).trans
      (congrArg (fun n => c2s2 x * 7 + n)
        (bitCount_eq c2s3Cell c2s3Rows c2s3_rows x)))
    (c2s2_preserved p hp hz hf)

