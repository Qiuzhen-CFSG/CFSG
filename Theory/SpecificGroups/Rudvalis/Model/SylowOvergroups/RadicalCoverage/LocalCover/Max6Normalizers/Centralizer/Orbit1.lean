@[expose] public def pointInv1 (x : Fin 4060) : Fin 60 :=
  ⟨((pointInv1Data[x.val / 64]! >>> (6 * (x.val % 64))) % 64) % 60, Nat.mod_lt _ (by decide)⟩

public theorem rep1_point : ∀ i : Fin 60, (rep1 i).val 1 = point1 i := by
  decide +kernel

public theorem rep1_fix : ∀ i : Fin 60, ∀ x : Fin 4060, x.val < 1 → (rep1 i).val x = x := by
  have h0 : ∀ i : Fin 60, (rep1 i).val 0 = 0 := by decide +kernel
  intro i x hx
  have h : x.val = 0 := by omega
  have he : x = 0 := Fin.ext h
  subst x
  exact h0 i


