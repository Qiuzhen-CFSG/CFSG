private theorem c2s2_facts : ∀ x : Fin 4060,
    (x ∈ c2s2Cell ↔ c2s1 x = 32) ∧
      c2s2 x = c2s1 x * 25 + bitCount c2s2Rows x :=
  allFinBlocks c2s2Facts c2s2_blocks

public theorem c2s2_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s2 (p x) = c2s2 x :=
  refine_preserved p hp c2s1 c2s2 c2s2Cell 32 25
    c2s2_nodup (fun x => (c2s2_facts x).1)
    (fun x => ((c2s2_facts x).2).trans
      (congrArg (fun n => c2s1 x * 25 + n)
        (bitCount_eq c2s2Cell c2s2Rows c2s2_rows x)))
    (c2s1_preserved p hp hz hf)

