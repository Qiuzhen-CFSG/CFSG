module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.FiveNormalizer.Algebra

/-!
# The marked involution is fixed by the normalizer of elementary 5

Let E be the subgroup generated by the fixed elementary words with indices
0, 1, 2, 3, and 5. Its 32 binary words cover E. On the original 4060-point
carrier, the union of E-orbits of size at most four has pointwise kernel
{1, elementaryGenerator 0} inside E. Every ambient normalizer preserves that
intrinsic union and its kernel, hence fixes the nonidentity kernel element.

The finite certificate uses two small orbits to bound the kernel. To show
that the marked element fixes all small orbits, it checks that every point
moved by that element has at least five distinct images under the identity
and the five generators. No enumeration of the ambient group is needed.

Source: the unchanged words and ATLAS attribution in LocalCover.Data and
SylowOvergroups.Definitions; GLS3 Table 5.3r and [Asc86b] as used in
Aschbacher--Smith, printed p.511. The reproducible discovery script is
FiveNormalizer/source/Explore.py; all facts used below are kernel checked.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max6Certificate

open Subgroup
namespace Five

set_option maxRecDepth 30000
set_option Elab.async false

private theorem gen_mem (i : Fin 5) : gen i ∈ elementary 5 := by
  rw [gen_eq]
  fin_cases i <;> apply subset_closure <;> simp

private theorem elementary_eq : elementary 5 = closure (Set.range gen) := by
  change closure {elementaryGenerator 0, elementaryGenerator 1, elementaryGenerator 2,
    elementaryGenerator 3, elementaryGenerator 5} = closure (Set.range gen)
  congr 1
  rw [gen_eq]
  ext x
  simp [or_comm, or_assoc]

private theorem word_zero : word 0 = 1 := by simp [word, factor]
private theorem word_one : word 1 = gen 0 := by
  change gen 0 * 1 * 1 * 1 * 1 = gen 0
  simp only [mul_one]

/-- The binary words cover the subgroup generated by precisely the five fixed words. -/
private theorem word_cover {x : Model} (hx : x ∈ elementary 5) :
    ∃ n : Fin 32, x = word n := by
  rw [elementary_eq] at hx
  induction hx using Subgroup.closure_induction_left with
  | one => exact ⟨0, word_zero.symm⟩
  | mul_left x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hx
    obtain ⟨n, rfl⟩ := ih
    exact ⟨toggle i n, gen_mul_word i n⟩
  | inv_mul_cancel x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hx
    obtain ⟨n, rfl⟩ := ih
    exact ⟨toggle i n, by rw [gen_inv, gen_mul_word]⟩

/-- A finite-cover formulation of having an elementary-5 orbit of size at most four. -/
private def Small (p : Fin 4060) : Prop :=
  ∃ s : Finset (Fin 4060), s.card ≤ 4 ∧ ∀ h ∈ elementary 5, h • p ∈ s

private theorem small_normalizer {g : Model}
    (hg : g ∈ normalizer (elementary 5 : Set Model)) {p : Fin 4060}
    (hp : Small p) : Small (g • p) := by
  obtain ⟨s, hs, hcover⟩ := hp
  refine ⟨s.image (fun q => g • q), (Finset.card_image_le).trans hs, ?_⟩
  intro h hh
  have hc : g⁻¹ * h * g ∈ elementary 5 := (mem_normalizer_iff''.mp hg h).mp hh
  refine Finset.mem_image.mpr ⟨(g⁻¹ * h * g) • p, hcover _ hc, ?_⟩
  simp only [mul_smul, smul_inv_smul]

/-- Six certified members of each orbit suffice to detect every point moved by gen 0. -/
private def sample (p : Fin 4060) : Finset (Fin 4060) :=
  {p, gen 0 • p, gen 1 • p, gen 2 • p, gen 3 • p, gen 4 • p}

private theorem sample_check : ∀ p : Fin 4060,
    (sample p).card ≤ 4 → gen 0 • p = p := by
  apply Rudvalis.Data.allFin
  decide +kernel

private theorem small_fixed {p : Fin 4060} (hp : Small p) : gen 0 • p = p := by
  obtain ⟨s, hs, hcover⟩ := hp
  apply sample_check
  apply (Finset.card_le_card ?_).trans hs
  intro q hq
  simp only [sample, Finset.mem_insert, Finset.mem_singleton] at hq
  rcases hq with rfl | rfl | rfl | rfl | rfl | rfl
  · simpa only [one_smul] using hcover 1 (one_mem _)
  all_goals exact hcover _ (gen_mem _)

private theorem small_125 : Small 125 := by
  refine ⟨{125, 2774, 3613, 3146}, by decide, ?_⟩
  intro h hh
  obtain ⟨n, rfl⟩ := word_cover hh
  have hc : ∀ n : Fin 32,
      word n • (125 : Fin 4060) ∈ ({125, 2774, 3613, 3146} : Finset (Fin 4060)) := by
    decide +kernel
  exact hc n

private theorem small_128 : Small 128 := by
  refine ⟨{128, 337, 3696, 840}, by decide, ?_⟩
  intro h hh
  obtain ⟨n, rfl⟩ := word_cover hh
  have hc : ∀ n : Fin 32,
      word n • (128 : Fin 4060) ∈ ({128, 337, 3696, 840} : Finset (Fin 4060)) := by
    decide +kernel
  exact hc n

private theorem kernel_check : ∀ n : Fin 32,
    word n • (125 : Fin 4060) = 125 → word n • (128 : Fin 4060) = 128 →
      n = 0 ∨ n = 1 := by
  decide +kernel

private theorem kernel_eq {h : Model} (hh : h ∈ elementary 5)
    (hfix : ∀ p, Small p → h • p = p) : h = 1 ∨ h = gen 0 := by
  obtain ⟨n, rfl⟩ := word_cover hh
  rcases kernel_check n (hfix _ small_125) (hfix _ small_128) with rfl | rfl
  · exact Or.inl word_zero
  · exact Or.inr word_one

private theorem gen_zero_ne_one : gen 0 ≠ 1 := by
  rw [gen_eq]
  change elementaryGenerator 0 ≠ 1
  intro h
  have ho := elementary_zero_order
  rw [h, orderOf_one] at ho
  contradiction

private theorem conjugate_zero_eq {g : Model}
    (hg : g ∈ normalizer (elementary 5 : Set Model)) :
    g * gen 0 * g⁻¹ = gen 0 := by
  have hmem : g * gen 0 * g⁻¹ ∈ elementary 5 :=
    (mem_normalizer_iff.mp hg (gen 0)).mp (gen_mem 0)
  have hfix : ∀ p, Small p → (g * gen 0 * g⁻¹) • p = p := by
    intro p hp
    have hi := small_normalizer ((normalizer _).inv_mem hg) hp
    have hz := small_fixed hi
    simp only [mul_smul, hz, smul_inv_smul]
  rcases kernel_eq hmem hfix with hone | hzero
  · exfalso
    apply gen_zero_ne_one
    have he := congrArg (fun h : Model => g⁻¹ * h * g) hone
    simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one, one_mul] using he
  · exact hzero

end Five

/-- The ambient normalizer of elementary 5 fixes its marked involution.
Its two-element kernel on the intrinsic union of orbits of size at most four
is preserved by every normalizer element. -/
public theorem five_normalizer_le_centralizer :
    normalizer (elementary 5 : Set Model) ≤
      centralizer ({elementaryGenerator 0} : Set Model) := by
  intro g hg
  apply mem_centralizer_singleton_iff.mpr
  have he := Five.conjugate_zero_eq hg
  rw [Five.gen_eq] at he
  change g * elementaryGenerator 0 * g⁻¹ = elementaryGenerator 0 at he
  exact (mul_inv_eq_iff_eq_mul).mp he

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max6Certificate
