private theorem c2s4_facts : ∀ x : Fin 4060,
    (x ∈ c2s4Cell ↔ c2s3 x = 12468) ∧
      c2s4 x = c2s3 x * 5 + bitCount c2s4Rows x :=
  allFinBlocks c2s4Facts c2s4_blocks

public theorem c2s4_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s4 (p x) = c2s4 x :=
  refine_preserved p hp c2s3 c2s4 c2s4Cell 12468 5
    c2s4_nodup (fun x => (c2s4_facts x).1)
    (fun x => ((c2s4_facts x).2).trans
      (congrArg (fun n => c2s3 x * 5 + n)
        (bitCount_eq c2s4Cell c2s4Rows c2s4_rows x)))
    (c2s3_preserved p hp hz hf)

