private theorem c3s10_facts : ∀ x : Fin 4060,
    (x ∈ c3s10Cell ↔ c3s9 x = 1603623) ∧
      c3s10 x = c3s9 x * 2 + bitCount c3s10Rows x :=
  allFinBlocks c3s10Facts c3s10_blocks

public theorem c3s10_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 3 → p x = x) :
    ∀ x, c3s10 (p x) = c3s10 x :=
  refine_preserved p hp c3s9 c3s10 c3s10Cell 1603623 2
    c3s10_nodup (fun x => (c3s10_facts x).1)
    (fun x => ((c3s10_facts x).2).trans
      (congrArg (fun n => c3s9 x * 2 + n)
        (bitCount_eq c3s10Cell c3s10Rows c3s10_rows x)))
    (c3s9_preserved p hp hz hf)

