private theorem c1s3_facts : ∀ x : Fin 4060,
    (x ∈ c1s3Cell ↔ c1s2 x = 1093) ∧
      c1s3 x = c1s2 x * 16 + bitCount c1s3Rows x :=
  allFinBlocks c1s3Facts c1s3_blocks

public theorem c1s3_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 1 → p x = x) :
    ∀ x, c1s3 (p x) = c1s3 x :=
  refine_preserved p hp c1s2 c1s3 c1s3Cell 1093 16
    c1s3_nodup (fun x => (c1s3_facts x).1)
    (fun x => ((c1s3_facts x).2).trans
      (congrArg (fun n => c1s2 x * 16 + n)
        (bitCount_eq c1s3Cell c1s3Rows c1s3_rows x)))
    (c1s2_preserved p hp hz hf)

