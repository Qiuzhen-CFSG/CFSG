module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.WordData

/-!
# Point maps for the recorded Rudvalis alignment

These permutations have kernel-checked inverse laws. Their equality to the
original group words is proved separately in Words; the tables alone assert
no membership or conjugation property in Rudvalis.Model.

Source: the preserved ATLAS permutations and subgroup programs attributed in
SylowOvergroups.Definitions, and LocalCover/source/Conjugator.json.
The generator source/GenerateAlignmentData.py is untrusted.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max6Certificate.AlignmentData

set_option maxRecDepth 30000
set_option Elab.async false

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def gapMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def gapMap (x : Fin 4060) : Fin 4060 :=
  ⟨(gapMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def gapInvMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def gapInvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(gapInvMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def involutionMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def involutionMap (x : Fin 4060) : Fin 4060 :=
  ⟨(involutionMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def zeroMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def zeroMap (x : Fin 4060) : Fin 4060 :=
  ⟨(zeroMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def gapPerm : Equiv.Perm (Fin 4060) where
  toFun := gapMap
  invFun := gapInvMap
  left_inv := Rudvalis.Data.allFin _ (by decide +kernel)
  right_inv := Rudvalis.Data.allFin _ (by decide +kernel)

@[expose] public def involutionPerm : Equiv.Perm (Fin 4060) where
  toFun := involutionMap
  invFun := involutionMap
  left_inv := Rudvalis.Data.allFin _ (by decide +kernel)
  right_inv := Rudvalis.Data.allFin _ (by decide +kernel)

@[expose] public def zeroPerm : Equiv.Perm (Fin 4060) where
  toFun := zeroMap
  invFun := zeroMap
  left_inv := Rudvalis.Data.allFin _ (by decide +kernel)
  right_inv := Rudvalis.Data.allFin _ (by decide +kernel)

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max6Certificate.AlignmentData
