module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.Words
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.Centralizer.Level0
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.Centralizer.Level1
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.Centralizer.Level2
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.Centralizer.Level3

/-!
# The ambient centralizer of the marked max6 involution

For the original degree-4060 Rudvalis model, every element centralizing the
fixed word `max6Generators.1 ^ 10` belongs to the subgroup generated by the
unchanged ATLAS max6 words. The certified orbital colors restrict successive
point images to sets of sizes 2048, 60, and 2. Actual max6 word representatives
cover these sets and fix all earlier points. Adjusting by their inverses leaves
a centralizing relation automorphism fixing three points, which is the identity
by color refinement. Both max6 generators are checked to commute with the word.

No ambient order or simplicity assumption enters the proof.
Source: the preserved ATLAS RuG1-max6W1 program and degree-4060 permutations,
attributed in SylowOvergroups.Definitions and Model.PermutationData; GLS3
Table 5.3r, and [Asc86b] as cited on quasithin printed p.511.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max6Certificate
open Rudvalis.OuterNormalizer
open CentralizerCertificate

private theorem preserves_relation (g : Model) : g.val ∈ relationAut :=
  model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut g.property

set_option maxRecDepth 30000 in
private theorem point_commutes (g : Model)
    (hg : g ∈ Subgroup.centralizer ({centralInvolution} : Set Model))
    (x : Fin 4060) :
    g.val (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (g.val x) := by
  have h := congrArg (fun t : Model => t.val x)
    (Subgroup.mem_centralizer_singleton_iff.mp hg)
  change g.val (centralInvolution.val x) = centralInvolution.val (g.val x) at h
  simpa only [centralInvolution_val] using h

private theorem adjust (k : Nat) (hk : k < 4060) (p : Model)
    (hp : p ∈ Subgroup.centralizer ({centralInvolution} : Set Model))
    (hf : ∀ x : Fin 4060, x.val < k → p.val x = x)
    (g : Model) (hg : g ∈ max6)
    (hgf : ∀ x : Fin 4060, x.val < k → g.val x = x)
    (hgk : g.val ⟨k, hk⟩ = p.val ⟨k, hk⟩)
    (hnext : ∀ q : Model,
      q ∈ Subgroup.centralizer ({centralInvolution} : Set Model) →
      (∀ x : Fin 4060, x.val < k + 1 → q.val x = x) → q ∈ max6) :
    p ∈ max6 := by
  let q : Model := g⁻¹ * p
  have hq : q ∈ Subgroup.centralizer ({centralInvolution} : Set Model) :=
    (Subgroup.centralizer _).mul_mem
      ((Subgroup.centralizer _).inv_mem (max6_le_centralizer hg)) hp
  have hqf (x : Fin 4060) (hx : x.val < k + 1) : q.val x = x := by
    change g⁻¹ • (p • x) = x
    apply inv_smul_eq_iff.mpr
    by_cases hlt : x.val < k
    · change p.val x = g.val x
      rw [hf x hlt, hgf x hlt]
    · have he : x = ⟨k, hk⟩ := Fin.ext (by change x.val = k; omega)
      subst x
      exact hgk.symm
  have hm := max6.mul_mem hg (hnext q hq hqf)
  simpa only [q, mul_inv_cancel_left] using hm

private theorem fix_three_mem (p : Model)
    (hp : p ∈ Subgroup.centralizer ({centralInvolution} : Set Model))
    (hf : ∀ x : Fin 4060, x.val < 3 → p.val x = x) : p ∈ max6 := by
  have h : p.val = 1 := fix_three_eq_one p.val (preserves_relation p) (point_commutes p hp) hf
  have he : p = 1 := Subtype.ext h
  rw [he]
  exact max6.one_mem

private theorem fix_two_mem (p : Model)
    (hp : p ∈ Subgroup.centralizer ({centralInvolution} : Set Model))
    (hf : ∀ x : Fin 4060, x.val < 2 → p.val x = x) : p ∈ max6 := by
  obtain ⟨i, hi⟩ := image2_mem_range p.val (preserves_relation p) (point_commutes p hp) hf
  exact adjust 2 (by decide) p hp hf (rep2 i) (rep2_mem i) (rep2_fix i)
    ((rep2_point i).trans hi) fix_three_mem

private theorem fix_one_mem (p : Model)
    (hp : p ∈ Subgroup.centralizer ({centralInvolution} : Set Model))
    (hf : ∀ x : Fin 4060, x.val < 1 → p.val x = x) : p ∈ max6 := by
  obtain ⟨i, hi⟩ := image1_mem_range p.val (preserves_relation p) (point_commutes p hp) hf
  exact adjust 1 (by decide) p hp hf (rep1 i) (rep1_mem i) (rep1_fix i)
    ((rep1_point i).trans hi) fix_two_mem

/-- The centralizer in the original Rudvalis model of the specified max6
involution lies in the actual subgroup generated by the fixed max6 words. -/
public theorem centralizer_le_max6 :
    Subgroup.centralizer ({centralInvolution} : Set Rudvalis.Model) ≤
      Rudvalis.SylowOvergroups.max6 := by
  intro p hp
  have hf : ∀ x : Fin 4060, x.val < 0 → p.val x = x := by intro x hx; omega
  obtain ⟨i, hi⟩ := image0_mem_range p.val (preserves_relation p) (point_commutes p hp) hf
  exact adjust 0 (by decide) p hp hf (rep0 i) (rep0_mem i) (rep0_fix i)
    ((rep0_point i).trans hi) fix_one_mem

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max6Certificate
