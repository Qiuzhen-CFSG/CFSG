private theorem c2s9_facts : ∀ x : Fin 4060,
    (x ∈ c2s9Cell ↔ c2s8 x = 2218696) ∧
      c2s9 x = c2s8 x * 2 + bitCount c2s9Rows x :=
  allFinBlocks c2s9Facts c2s9_blocks

public theorem c2s9_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s9 (p x) = c2s9 x :=
  refine_preserved p hp c2s8 c2s9 c2s9Cell 2218696 2
    c2s9_nodup (fun x => (c2s9_facts x).1)
    (fun x => ((c2s9_facts x).2).trans
      (congrArg (fun n => c2s8 x * 2 + n)
        (bitCount_eq c2s9Cell c2s9Rows c2s9_rows x)))
    (c2s8_preserved p hp hz hf)

