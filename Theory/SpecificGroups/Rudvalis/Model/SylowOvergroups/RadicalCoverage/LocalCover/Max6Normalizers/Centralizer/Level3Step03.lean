private theorem c3s3_facts : ∀ x : Fin 4060,
    (x ∈ c3s3Cell ↔ c3s2 x = 121) ∧
      c3s3 x = c3s2 x * 11 + bitCount c3s3Rows x :=
  allFinBlocks c3s3Facts c3s3_blocks

public theorem c3s3_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 3 → p x = x) :
    ∀ x, c3s3 (p x) = c3s3 x :=
  refine_preserved p hp c3s2 c3s3 c3s3Cell 121 11
    c3s3_nodup (fun x => (c3s3_facts x).1)
    (fun x => ((c3s3_facts x).2).trans
      (congrArg (fun n => c3s2 x * 11 + n)
        (bitCount_eq c3s3Cell c3s3Rows c3s3_rows x)))
    (c3s2_preserved p hp hz hf)

