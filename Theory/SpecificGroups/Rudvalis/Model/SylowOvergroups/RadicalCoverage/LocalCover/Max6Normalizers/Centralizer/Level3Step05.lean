private theorem c3s5_facts : ∀ x : Fin 4060,
    (x ∈ c3s5Cell ↔ c3s4 x = 22038) ∧
      c3s5 x = c3s4 x * 3 + bitCount c3s5Rows x :=
  allFinBlocks c3s5Facts c3s5_blocks

public theorem c3s5_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 3 → p x = x) :
    ∀ x, c3s5 (p x) = c3s5 x :=
  refine_preserved p hp c3s4 c3s5 c3s5Cell 22038 3
    c3s5_nodup (fun x => (c3s5_facts x).1)
    (fun x => ((c3s5_facts x).2).trans
      (congrArg (fun n => c3s4 x * 3 + n)
        (bitCount_eq c3s5Cell c3s5Rows c3s5_rows x)))
    (c3s4_preserved p hp hz hf)

