private theorem c2s8_facts : ∀ x : Fin 4060,
    (x ∈ c2s8Cell ↔ c2s7 x = 729564) ∧
      c2s8 x = c2s7 x * 2 + bitCount c2s8Rows x :=
  allFinBlocks c2s8Facts c2s8_blocks

public theorem c2s8_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s8 (p x) = c2s8 x :=
  refine_preserved p hp c2s7 c2s8 c2s8Cell 729564 2
    c2s8_nodup (fun x => (c2s8_facts x).1)
    (fun x => ((c2s8_facts x).2).trans
      (congrArg (fun n => c2s7 x * 2 + n)
        (bitCount_eq c2s8Cell c2s8Rows c2s8_rows x)))
    (c2s7_preserved p hp hz hf)

