private theorem c2s7_facts : ∀ x : Fin 4060,
    (x ∈ c2s7Cell ↔ c2s6 x = 375354) ∧
      c2s7 x = c2s6 x * 2 + bitCount c2s7Rows x :=
  allFinBlocks c2s7Facts c2s7_blocks

public theorem c2s7_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s7 (p x) = c2s7 x :=
  refine_preserved p hp c2s6 c2s7 c2s7Cell 375354 2
    c2s7_nodup (fun x => (c2s7_facts x).1)
    (fun x => ((c2s7_facts x).2).trans
      (congrArg (fun n => c2s6 x * 2 + n)
        (bitCount_eq c2s7Cell c2s7Rows c2s7_rows x)))
    (c2s6_preserved p hp hz hf)

