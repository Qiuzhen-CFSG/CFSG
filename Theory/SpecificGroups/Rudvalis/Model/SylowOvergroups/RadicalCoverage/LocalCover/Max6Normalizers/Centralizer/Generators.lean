/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def firstMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def firstMap (x : Fin 4060) : Fin 4060 :=
  ⟨(firstMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def firstInvMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def firstInvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(firstInvMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private def firstInverseFacts (x : Fin 4060) : Prop :=
  firstInvMap (firstMap x) = x ∧ firstMap (firstInvMap x) = x

private instance (x : Fin 4060) : Decidable (firstInverseFacts x) :=
  inferInstanceAs (Decidable (_ ∧ _))

