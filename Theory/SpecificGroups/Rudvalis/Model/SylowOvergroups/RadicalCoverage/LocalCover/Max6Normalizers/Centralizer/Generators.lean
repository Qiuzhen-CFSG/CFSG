@[expose] public def firstPerm : Equiv.Perm (Fin 4060) where
  toFun := firstMap
  invFun := firstInvMap
  left_inv := by
    intro x
    exact (firstInverse_facts x).1
  right_inv := by
    intro x
    exact (firstInverse_facts x).2

