private def secondShort : Equiv.Perm (Fin 4060) :=
  let r3 := aPerm * bPerm
  let r4 := r3 * bPerm
  let r5 := r3 * r4
  let r6 := r3 * r5
  let r7 := r6 * r3
  let u := r5⁻¹ * aPerm * r5
  let t := r7 * r7
  (AlignmentData.involutionPerm * u) ^ 6 *
    (AlignmentData.involutionPerm * (t⁻¹ * u * t)) ^ 4

private theorem second_short_eq : max6Generators.2.val = secondShort := by
  let r3 : Model := a * b
  let r4 := r3 * b
  let r5 := r3 * r4
  let r6 := r3 * r5
  let r7 := r6 * r3
  let u := r5⁻¹ * a * r5
  let t := r7 * r7
  change (centralInvolution.val * u.val) ^ 6 *
    (centralInvolution.val * (t⁻¹ * u * t).val) ^ 4 = secondShort
  rw [centralInvolution_val]
  rfl

