public theorem first_eq : max6Generators.1.val = firstPerm := by
  apply Equiv.ext
  exact allFinBlocks firstEqFacts firstEq_blocks

@[expose] public def first : Model :=
  ⟨firstPerm, first_eq ▸ max6Generators.1.property⟩

public theorem first_model_eq : first = max6Generators.1 :=
  Subtype.ext first_eq.symm

public theorem first_mem : first ∈ max6 := by
  rw [first_model_eq]
  apply Subgroup.subset_closure
  simp

