private theorem commutation_facts : ∀ x, commutationFacts x :=
  allFinBlocks commutationFacts commutation_blocks

/-- Both fixed generators commute with the marked involution. -/
public theorem first_commutes : first * centralInvolution = centralInvolution * first := by
  apply Subtype.ext
  change firstPerm * centralInvolution.val = centralInvolution.val * firstPerm
  rw [centralInvolution_val]
  apply Equiv.ext
  exact fun x => (commutation_facts x).1

public theorem second_commutes : second * centralInvolution = centralInvolution * second := by
  apply Subtype.ext
  change secondPerm * centralInvolution.val = centralInvolution.val * secondPerm
  rw [centralInvolution_val]
  apply Equiv.ext
  exact fun x => (commutation_facts x).2

public theorem max6_le_centralizer :
    max6 ≤ Subgroup.centralizer ({centralInvolution} : Set Model) := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  rcases Set.mem_insert_iff.mp hg with rfl | hg
  · apply Subgroup.mem_centralizer_singleton_iff.mpr
    simpa only [first_model_eq] using first_commutes
  · have hg' : g = max6Generators.2 := Set.mem_singleton_iff.mp hg
    subst g
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    simpa only [second_model_eq] using second_commutes

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max6Certificate.CentralizerCertificate
