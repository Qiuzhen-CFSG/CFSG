private theorem c2s6_facts : ∀ x : Fin 4060,
    (x ∈ c2s6Cell ↔ c2s5 x = 87533) ∧
      c2s6 x = c2s5 x * 2 + bitCount c2s6Rows x :=
  allFinBlocks c2s6Facts c2s6_blocks

public theorem c2s6_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s6 (p x) = c2s6 x :=
  refine_preserved p hp c2s5 c2s6 c2s6Cell 87533 2
    c2s6_nodup (fun x => (c2s6_facts x).1)
    (fun x => ((c2s6_facts x).2).trans
      (congrArg (fun n => c2s5 x * 2 + n)
        (bitCount_eq c2s6Cell c2s6Rows c2s6_rows x)))
    (c2s5_preserved p hp hz hf)

