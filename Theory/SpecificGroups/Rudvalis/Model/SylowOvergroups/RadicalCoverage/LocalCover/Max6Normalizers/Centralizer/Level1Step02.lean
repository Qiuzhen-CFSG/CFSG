private theorem c1s2_facts : ∀ x : Fin 4060,
    (x ∈ c1s2Cell ↔ c1s1 x = 15) ∧
      c1s2 x = c1s1 x * 37 + bitCount c1s2Rows x :=
  allFinBlocks c1s2Facts c1s2_blocks

public theorem c1s2_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut)
    (hz : ∀ x, p (AlignmentData.involutionPerm x) = AlignmentData.involutionPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 1 → p x = x) :
    ∀ x, c1s2 (p x) = c1s2 x :=
  refine_preserved p hp c1s1 c1s2 c1s2Cell 15 37
    c1s2_nodup (fun x => (c1s2_facts x).1)
    (fun x => ((c1s2_facts x).2).trans
      (congrArg (fun n => c1s1 x * 37 + n)
        (bitCount_eq c1s2Cell c1s2Rows c1s2_rows x)))
    (c1s1_preserved p hp hz hf)

