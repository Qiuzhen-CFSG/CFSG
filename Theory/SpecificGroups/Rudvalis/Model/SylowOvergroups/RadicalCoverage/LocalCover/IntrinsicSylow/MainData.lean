module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.IntrinsicSylow.Framework
import Mathlib.Tactic.FinCases

/-!
# Cached fourth ATLAS generator pair for the intrinsic Sylow calculation

Schreier witnesses for the ATLAS subgroup programs in
`SylowOvergroups/source/`, using the inverse point-action convention.
The tables are shared values with the independent cardinality calculation;
all their equations are checked again here, with no cardinality dependency.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.IntrinsicSylow.Main
open Theory.GroupTheory Rudvalis.OrderCertificate
set_option Elab.async false

@[expose] public def packed0 : Nat := 

@[expose] public def map0 (x : Fin 4060) : Fin 4060 :=
  ⟨(packed0 >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def packed1 : Nat := 

@[expose] public def map1 (x : Fin 4060) : Fin 4060 :=
  ⟨(packed1 >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def packed2 : Nat := 

@[expose] public def map2 (x : Fin 4060) : Fin 4060 :=
  ⟨(packed2 >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def packed3 : Nat := 

@[expose] public def map3 (x : Fin 4060) : Fin 4060 :=
  ⟨(packed3 >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def pointMap : Fin 4 → Fin 4060 → Fin 4060
  | 0 => map0
  | 1 => map1
  | 2 => map2
  | _ => map3

@[expose] public def invOf : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
  | _ => 1

private theorem inv_inv (i : Fin 4) : invOf (invOf i) = i := by
  revert i
  decide +kernel

set_option maxRecDepth 30000 in
private theorem left0 : ∀ x, map2 (map0 x) = x := by
  apply Rudvalis.Data.allFin
  decide +kernel

set_option maxRecDepth 30000 in
private theorem left1 : ∀ x, map3 (map1 x) = x := by
  apply Rudvalis.Data.allFin
  decide +kernel

public theorem left (i : Fin 4) (x : Fin 4060) :
    pointMap (invOf i) (pointMap i x) = x := by
  fin_cases i
  · exact left0 x
  · exact left1 x
  · exact rightInverse_of_leftInverse_fin left0 x
  · exact rightInverse_of_leftInverse_fin left1 x

@[expose] public def gen (i : Fin 4) : Equiv.Perm (Fin 4060) :=
  tablePerm (pointMap i) (pointMap (invOf i)) (left i)
    (rightInverse_of_leftInverse_fin (left i))

public theorem gen_inv (i : Fin 4) : gen (invOf i) = (gen i)⁻¹ := by
  apply Equiv.ext
  intro x
  rfl

@[expose] public def subgroup := wordSubgroup gen invOf gen_inv

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.IntrinsicSylow.Main
