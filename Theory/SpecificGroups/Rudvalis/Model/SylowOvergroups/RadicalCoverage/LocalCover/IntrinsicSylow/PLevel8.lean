private theorem next_mem (i : Fin 0) : nextGen i ∈ subgroup := Fin.elim0 i

private theorem next_le : nextSubgroup ≤ subgroup :=
  wordSubgroup_le_of_gen_mem next_mem

set_option maxRecDepth 30000 in
private theorem step0 : ∀ r,
    gen 0 * rep r = rep (act 0 r) * evalWord nextGen (factor 0 r) := by
  have h : ∀ (r : Fin 2) (x : Fin 4060),
      (gen 0 * rep r) x = (rep (act 0 r) * evalWord nextGen (factor 0 r)) x := by
    apply allFin₂
    decide +kernel
  intro r
  exact Equiv.ext (h r)

private theorem step1 (r : Fin 2) :
    gen 1 * rep r = rep (act 1 r) * evalWord nextGen (factor 1 r) := by
  have ha : ∀ r, act 0 (act 1 r) = r := by decide +kernel
  have hf : ∀ r, factor 1 r = (factor 0 (act 1 r)).reverse.map nextInv := by
    decide +kernel
  have hi : gen 1 = (gen 0)⁻¹ := gen_inv 0
  have h := reverse_step (step0 (act 1 r))
  rw [ha] at h
  rw [hi, hf, evalWord_reverse_map_inv nextGen nextInv nextInvProof]
  exact h

private theorem step (i : Fin 2) (r : Fin 2) :
    gen i * rep r = rep (act i r) * evalWord nextGen (factor i r) := by
  fin_cases i
  · exact step0 r
  · exact step1 r

/-- The certified index of this stabilizer-chain step. -/
public theorem card_step : Nat.card subgroup = 2 * Nat.card nextSubgroup := by
  apply wordSubgroup_card_eq_mul_next gen invOf gen_inv nextGen nextInv nextInvProof
    rep act factor base point 0
  · intro r
    exact ⟨repWord r, rfl⟩
  · exact next_le
  · rfl
  · decide +kernel
  · decide +kernel
  · apply wordSubgroup_fix_of_gen_fix
    decide +kernel
  · exact step

