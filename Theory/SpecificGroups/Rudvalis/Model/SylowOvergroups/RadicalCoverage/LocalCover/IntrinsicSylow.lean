module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Reduction
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.IntrinsicSylow.POrder
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.IntrinsicSylow.Index

/-!
# Intrinsic Sylow status of the fixed Rudvalis word subgroup

The exact subgroup generated by the four preserved local words has order
2^14 and index 21 inside the fourth ATLAS candidate. Its intrinsic two-group
and odd-index properties therefore make it a Sylow two-subgroup there.
Mapping this Sylow subgroup into the original model recovers precisely localP.

All finite identities and completeness claims are kernel-checked. The proof
uses neither a candidate cardinality bound nor the ambient Rudvalis order.
Source: the ATLAS words attributed in `SylowOvergroups.Definitions`, GLS3
Table 5.3r, and the [Asc86b] application in Aschbacher--Smith, printed p.511
(PDF p.528). The unconditional radical-cover assembly remains separate.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover

/-- The fixed local word subgroup is Sylow inside max4. -/
public theorem intrinsicSylow : IntrinsicSylow := by
  have hP : IsPGroup 2 (localP.subgroupOf max4) :=
    IntrinsicSylow.localP_isPGroup.comap_subtype
  have hindex : ¬ 2 ∣ (localP.subgroupOf max4).index := by
    rw [IntrinsicSylow.localP_intrinsic_index]
    decide
  refine ⟨hP.toSylow hindex, ?_⟩
  exact Subgroup.map_subgroupOf_eq_of_le localP_le_max4

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover
