@[expose] public def c2s8 (x : Fin 4060) : Nat :=
  (c2s8Data[x.val / 64]! >>> (15 * (x.val % 64))) % 32768

@[expose] public def c2s8Cell : List (Fin 4060) := [1434]

@[expose] public def c2s8Rows : List Nat := [
]

private theorem rows_eq : c2s8Rows = c2s8Cell.map InvarianceCertificate.row := by decide +kernel

private theorem cell_nodup : c2s8Cell.Nodup := by decide +kernel

private theorem facts : ∀ x : Fin 4060,
    (x ∈ c2s8Cell ↔ c2s7 x = 8090) ∧
    c2s8 x = c2s7 x * 2 + bitCount c2s8Rows x := by
  apply Rudvalis.Data.allFin
  decide +kernel

public theorem c2s8_preserved (g : Model) (hg : g ∈ pointSetStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, c2s8 (g • x) = c2s8 x :=
  refine_preserved g.val (model_relation g) c2s7 c2s8 c2s8Cell 8090 2
    cell_nodup (fun x => (facts x).1)
    (fun x => ((facts x).2).trans (congrArg (fun n => c2s7 x * 2 + n)
      (bitCount_eq c2s8Cell c2s8Rows rows_eq x)))
    (c2s7_preserved g hg hf)

