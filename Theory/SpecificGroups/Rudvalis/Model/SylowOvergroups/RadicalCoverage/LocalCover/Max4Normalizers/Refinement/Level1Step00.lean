@[expose] public def c1s0 (x : Fin 4060) : Nat :=
  (c1s0Data[x.val / 64]! >>> (3 * (x.val % 64))) % 8

@[expose] public def c1s0Cell : List (Fin 4060) := [0]

@[expose] public def c1s0Rows : List Nat := [
]

private theorem rows_eq : c1s0Rows = c1s0Cell.map InvarianceCertificate.row := by decide +kernel

private theorem cell_nodup : c1s0Cell.Nodup := by decide +kernel

private theorem facts : ∀ x : Fin 4060,
    (x ∈ c1s0Cell ↔ (initialColor 1) x = 0) ∧
    c1s0 x = (initialColor 1) x * 2 + bitCount c1s0Rows x := by
  apply Rudvalis.Data.allFin
  decide +kernel

public theorem c1s0_preserved (g : Model) (hg : g ∈ pointSetStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 1 → g • x = x) :
    ∀ x, c1s0 (g • x) = c1s0 x :=
  refine_preserved g.val (model_relation g) (initialColor 1) c1s0 c1s0Cell 0 2
    cell_nodup (fun x => (facts x).1)
    (fun x => ((facts x).2).trans (congrArg (fun n => (initialColor 1) x * 2 + n)
      (bitCount_eq c1s0Cell c1s0Rows rows_eq x)))
    (initialColor_preserved 1 g hg hf)

