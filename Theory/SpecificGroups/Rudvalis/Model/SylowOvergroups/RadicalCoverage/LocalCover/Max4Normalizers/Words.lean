@[expose] public def secondEdge (x : Fin 4060) : Fin 4 :=
  ⟨((secondEdgeData[x.val / 64]! >>> (2 * (x.val % 64))) % 4) % 4, Nat.mod_lt _ (by decide)⟩

private theorem first_edges : ∀ x : Fin 4060, x ∈ firstImages →
    x = 0 ∨ firstDepth (firstParent x) < firstDepth x ∧
      firstParent x ∈ firstImages ∧ GeneratorMaps.gen (firstEdge x) (firstParent x) = x := by
  apply Data.allFin
  decide +kernel

private theorem first_reachable (x : Fin 4060) (hx : x ∈ firstImages) :
    ∃ g : Model, g ∈ max4 ∧ g • (0 : Fin 4060) = x := by
  induction x using (measure firstDepth).wf.induction with
  | h x ih =>
    rcases first_edges x hx with rfl | ⟨hd, hp, he⟩
    · exact ⟨1, max4.one_mem, one_smul _ _⟩
    obtain ⟨g, hg, hg0⟩ := ih (firstParent x) hd hp
    refine ⟨letter (firstEdge x) * g, max4.mul_mem (letter_mem _) hg, ?_⟩
    rw [mul_smul, hg0]
    change permutation (letter (firstEdge x)) (firstParent x) = x
    rw [letter_perm]
    exact he

@[expose] public def stabilizerWords : Fin 4 → List (Fin 4) :=
  ![[3, 2, 1, 2, 3, 2, 3, 2, 3, 0, 1, 0, 1, 0, 1, 0, 3, 0, 1],
    [2, 3, 2, 1, 2, 3, 2, 3, 2, 1, 2, 1, 0, 3, 0, 3, 0, 1, 0, 1, 0, 3, 0, 1, 0],
    [1, 2, 3, 2, 3, 2, 1, 2, 1, 2, 3, 2, 3, 0, 1, 0, 1, 0, 3, 0, 3, 0, 1, 0, 1, 0, 3],
    [2, 1, 2, 1, 2, 3, 2, 3, 2, 1, 2, 1, 2, 1, 0, 3, 0, 3, 0, 1, 0, 1, 0, 3, 0, 3, 0, 1, 0]]

private theorem stabilizer_fix (i : Fin 4) :
    word (stabilizerWords i) • (0 : Fin 4060) = 0 := by
  change permutation (word (stabilizerWords i)) 0 = 0
  rw [word_perm]
  fin_cases i <;> decide +kernel

private theorem second_edges : ∀ x : Fin 4060, x ∈ secondImages →
    x = 1 ∨ secondDepth (secondParent x) < secondDepth x ∧
      secondParent x ∈ secondImages ∧
      evalWord GeneratorMaps.gen (stabilizerWords (secondEdge x)) (secondParent x) = x := by
  apply Data.allFin
  decide +kernel

private theorem second_reachable (x : Fin 4060) (hx : x ∈ secondImages) :
    ∃ g : Model, g ∈ max4 ∧ g • (0 : Fin 4060) = 0 ∧ g • (1 : Fin 4060) = x := by
  induction x using (measure secondDepth).wf.induction with
  | h x ih =>
    rcases second_edges x hx with rfl | ⟨hd, hp, he⟩
    · exact ⟨1, max4.one_mem, one_smul _ _, one_smul _ _⟩
    obtain ⟨g, hg, hg0, hg1⟩ := ih (secondParent x) hd hp
    let w := stabilizerWords (secondEdge x)
    refine ⟨word w * g, max4.mul_mem (word_mem _) hg, ?_, ?_⟩
    · rw [mul_smul, hg0]
      exact stabilizer_fix _
    · rw [mul_smul, hg1]
      change permutation (word w) (secondParent x) = x
      rw [word_perm]
      exact he

end WordCertificate

/-- The two image lists have witnesses in the unchanged ATLAS max4. -/
public theorem wordReachability : WordReachability :=
  ⟨WordCertificate.first_reachable, WordCertificate.second_reachable⟩

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max4Normalizers
