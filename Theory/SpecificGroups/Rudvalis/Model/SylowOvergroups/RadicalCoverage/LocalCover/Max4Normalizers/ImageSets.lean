module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max4Normalizers.Geometry

/-!
# Proposed point-image sets for the max4 stabilizer calculation

These explicit subsets are discovered by word forests starting at 0 and 1.
Their definitions make no completeness assertion. The separate reachability
certificate supplies elements of the unchanged max4 taking the base points
to each listed image. The separate rigidity certificate must show that every
element preserving the common 28-point set has its images in these lists.

Source: the ATLAS max4 words, with witness discovery in
`Max4Normalizers/source/geometry.py`. The two contracts below are genuine
remaining proof obligations, not assertions of a completed normalizer bound.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max4Normalizers

@[expose] public def firstImageMask : Nat := 

@[expose] public def firstImages : Set (Fin 4060) :=
  {x | firstImageMask.testBit x.val = true}

public instance (x : Fin 4060) : Decidable (x ∈ firstImages) :=
  inferInstanceAs (Decidable (firstImageMask.testBit x.val = true))

@[expose] public def secondImageMask : Nat := 

@[expose] public def secondImages : Set (Fin 4060) :=
  {x | secondImageMask.testBit x.val = true}

public instance (x : Fin 4060) : Decidable (x ∈ secondImages) :=
  inferInstanceAs (Decidable (secondImageMask.testBit x.val = true))

/-- Actual max4 word witnesses for the two successive proposed image sets. -/
@[expose] public def WordReachability : Prop :=
  (∀ x ∈ firstImages, ∃ g : Model, g ∈ max4 ∧ g • (0 : Fin 4060) = x) ∧
  (∀ x ∈ secondImages, ∃ g : Model, g ∈ max4 ∧
    g • (0 : Fin 4060) = 0 ∧ g • (1 : Fin 4060) = x)

/-- Upper bounds for successive images, and triviality after two points are fixed.
These quantify over the full ambient set stabilizer, not displayed generators. -/
@[expose] public def ImageRigidity : Prop :=
  (∀ g ∈ pointSetStabilizer, g • (0 : Fin 4060) ∈ firstImages) ∧
  (∀ g ∈ pointSetStabilizer, g • (0 : Fin 4060) = 0 →
    g • (1 : Fin 4060) ∈ secondImages) ∧
  (∀ g ∈ pointSetStabilizer, g • (0 : Fin 4060) = 0 →
    g • (1 : Fin 4060) = 1 → g = 1)

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max4Normalizers
