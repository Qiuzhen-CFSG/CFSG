module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Reduction
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max4Normalizers.GeneratorMaps
import Mathlib.Tactic.FinCases

/-!
# Certified point actions of the fixed Rudvalis local words

The tables cache the eight local letters and six elementary generators.
Their pointwise equations are checked against the unchanged ATLAS max4 words.
Only the two already certified generator-table comparisons are reused from
`Cardinality`; no cardinality bound or Schreier decomposition is imported.
This separates finite point checks from repeated expansion of the long words.

Source: the preserved ATLAS programs in `SylowOvergroups/source/`, and the
fixed local words in `LocalCover.Data`. Witnesses are generated by
`Max4Normalizers/source/actions.py`; Python output is not trusted.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max4Normalizers

open LocalCardinality.Max4

set_option maxRecDepth 30000
set_option Elab.async false

/-- A bounded finite check, so the kernel need not retain all point reductions. -/
@[expose] public def checkChunk (P : Fin 4060 → Prop) [DecidablePred P] (b : Nat) : Bool :=
  Data.checkNat (fun k => decide (P ⟨(256 * b + k) % 4060,
    Nat.mod_lt _ (by decide)⟩)) 256

private theorem checkNat_sound (f : Nat → Bool) (n : Nat)
    (h : Data.checkNat f n = true) (k : Nat) (hk : k < n) : f k = true := by
  induction n with
  | zero => omega
  | succ n ih =>
    rw [Data.checkNat, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk | rfl
    · exact ih h.1 hk
    · exact h.2

/-- Soundness of the sixteen bounded checks, including the wrapped final chunk. -/
public theorem allFinChunks (P : Fin 4060 → Prop) [DecidablePred P]
    (h : ∀ b : Fin 16, checkChunk P b.val = true) : ∀ x, P x := by
  intro x
  have hb : x.val / 256 < 16 := by omega
  have h' := checkNat_sound _ 256 (h ⟨x.val / 256, hb⟩)
    (x.val % 256) (Nat.mod_lt _ (by decide))
  have hx : 256 * (x.val / 256) + x.val % 256 = x.val := by omega
  simpa only [hx, Nat.mod_eq_of_lt x.isLt, Fin.eta] using of_decide_eq_true h'

@[expose] public def tableLocalGenerators : Fin 4 → Equiv.Perm (Fin 4060) :=
  let x := GeneratorMaps.gen 0
  let y := GeneratorMaps.gen 1
  ![y * x * y⁻¹,
    x * y * x * y⁻¹ * x,
    y⁻¹ * x * y⁻¹ * x * y * x * y,
    x * y⁻¹ * x * y * x * y * x * y⁻¹ * x * y]

private theorem tableLocalGenerators_eq (i : Fin 4) :
    tableLocalGenerators i = modelSubgroup.subtype (localGenerators i) := by
  simp only [tableLocalGenerators, GeneratorMaps.gen_eq, generator0_eq, generator1_eq]
  fin_cases i <;> rfl

@[expose] public def tableLocalLetter : Fin 8 → Equiv.Perm (Fin 4060) :=
  ![tableLocalGenerators 0, tableLocalGenerators 1,
    tableLocalGenerators 2, tableLocalGenerators 3,
    (tableLocalGenerators 0)⁻¹, (tableLocalGenerators 1)⁻¹,
    (tableLocalGenerators 2)⁻¹, (tableLocalGenerators 3)⁻¹]

public theorem tableLocalLetter_eq (i : Fin 8) :
    tableLocalLetter i = modelSubgroup.subtype (localLetter i) := by
  simp only [tableLocalLetter, tableLocalGenerators_eq]
  fin_cases i <;> rfl

