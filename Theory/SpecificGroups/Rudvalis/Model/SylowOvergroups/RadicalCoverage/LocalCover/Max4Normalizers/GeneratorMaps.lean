@[expose] public def pointMap (i : Fin 4) (x : Fin 4060) : Fin 4060 :=
  let data := (![data0, data1, data2, data3] : Fin 4 → Array Nat) i
  ⟨((data[x.val / 64]! >>> (12 * (x.val % 64))) % 4096) % 4060,
    Nat.mod_lt _ (by decide)⟩

private theorem point_eq_0 : ∀ x : Fin 4060, pointMap 0 x = L0.gen 0 x := by
  apply Data.allFin
  decide +kernel

private theorem point_eq_1 : ∀ x : Fin 4060, pointMap 1 x = L0.gen 1 x := by
  apply Data.allFin
  decide +kernel

private theorem point_eq_2 : ∀ x : Fin 4060, pointMap 2 x = L0.gen 2 x := by
  apply Data.allFin
  decide +kernel

private theorem point_eq_3 : ∀ x : Fin 4060, pointMap 3 x = L0.gen 3 x := by
  apply Data.allFin
  decide +kernel

private theorem point_eq (i : Fin 4) : ∀ x : Fin 4060, pointMap i x = L0.gen i x := by
  fin_cases i
  · exact point_eq_0
  · exact point_eq_1
  · exact point_eq_2
  · exact point_eq_3

@[expose] public def gen (i : Fin 4) : Equiv.Perm (Fin 4060) where
  toFun := pointMap i
  invFun := pointMap (L0.invOf i)
  left_inv := by
    intro x
    simp only [point_eq, L0.gen_inv]
    exact (L0.gen i).symm_apply_apply x
  right_inv := by
    intro x
    simp only [point_eq, L0.gen_inv]
    exact (L0.gen i).apply_symm_apply x

/-- The bounded cache represents exactly the original max4 signed generators. -/
public theorem gen_eq (i : Fin 4) : gen i = L0.gen i := Equiv.ext (point_eq i)

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max4Normalizers.GeneratorMaps
