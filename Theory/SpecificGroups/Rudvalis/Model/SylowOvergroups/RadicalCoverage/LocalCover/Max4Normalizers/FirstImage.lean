private theorem bad_injective : ∀ i : Fin 7, Function.Injective (badPoint i) := by
  decide +kernel

private theorem bad_codes : ∀ (i : Fin 7) (j : Fin 17),
    profileCode (badRepresentative i) = profileCode (badPoint i j) := by
  decide +kernel

private theorem bad_cover : ∀ x : Fin 4060,
    x ∉ firstImages → x ∉ pointSet →
    profileCode x = profileCode (badRepresentative (badIndex x)) := by
  apply Rudvalis.Data.allFin
  decide +kernel

public theorem outside_profileFiber_ge (x : Fin 4060)
    (hx : x ∉ firstImages) (hp : x ∉ pointSet) : 17 ≤ (profileFiber x).ncard := by
  let i := badIndex x
  have hsub : Set.range (badPoint i) ⊆ profileFiber x := by
    rintro y ⟨j, rfl⟩
    exact (sameProfile_iff x _).mpr ((bad_cover x hx hp).trans (bad_codes i j))
  have hc := Set.ncard_le_ncard hsub
  rw [Set.ncard_range_of_injective (bad_injective i)] at hc
  simpa using hc

end ProfileCertificate

/-- The full ambient marked-set stabilizer sends 0 into the certified first image set. -/
public theorem first_image (g : Model) (hg : g ∈ pointSetStabilizer) :
    g • (0 : Fin 4060) ∈ firstImages := by
  by_contra hx
  have hp : g • (0 : Fin 4060) ∉ pointSet := by
    rw [(mem_pointSetStabilizer g).mp hg]
    decide +kernel
  have hlow := ProfileCertificate.outside_profileFiber_ge _ hx hp
  rw [profileFiber_card_smul g hg] at hlow
  have hupp := ProfileCertificate.profileFiber_zero_le
  omega

