private theorem bits (x : Fin 4060) (j : Fin 28) :
    (profileCode x).getLsbD j.val = (row (point j)).testBit x.val := by
  have h := allFinBlocks bitsFact bits_blocks x j
  rw [profileRows_eq] at h
  simpa only [List.getElem!_eq_getElem?_getD, List.getElem?_map,
    List.getElem?_eq_getElem (show j.val < points.length from j.isLt),
    Option.map_some, Option.getD_some, point] using h

public theorem sameProfile_iff (x y : Fin 4060) :
    sameProfile x y ↔ profileCode x = profileCode y := by
  constructor
  · intro h
    apply BitVec.eq_of_getLsbD_eq_iff.mpr
    intro i hi
    have hx := bits x ⟨i, hi⟩
    have hy := bits y ⟨i, hi⟩
    rw [hx, hy]
    apply Bool.eq_iff_iff.mpr
    exact (cachedAdj_iff_adj _ _).trans
      ((h _ (point_mem ⟨i, hi⟩)).trans (cachedAdj_iff_adj _ _).symm)
  · intro h z hz
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hz
    have hb := congrArg (fun c : BitVec 28 => c.getLsbD i) h
    rw [bits x ⟨i, hi⟩, bits y ⟨i, hi⟩] at hb
    exact (cachedAdj_iff_adj _ _).symm.trans
      ((Bool.eq_iff_iff.mp hb).trans (cachedAdj_iff_adj _ _))

@[expose] public def smallFiber : Finset (Fin 4060) :=
  [0, 19, 683, 707, 881, 1028, 1162, 1334, 1738, 2249, 2433, 2519, 3601, 3612, 3975, 4005].toFinset

private theorem smallFiber_card : smallFiber.card = 16 := by decide +kernel

private theorem zero_upper : ∀ y : Fin 4060,
    profileCode 0 = profileCode y → y ∈ smallFiber := by
  apply Rudvalis.Data.allFin
  decide +kernel

public theorem profileFiber_zero_le : (profileFiber 0).ncard ≤ 16 := by
  rw [← smallFiber_card, ← Set.ncard_coe_finset]
  refine Set.ncard_le_ncard ?_ smallFiber.finite_toSet
  intro y hy
  exact zero_upper y ((sameProfile_iff 0 y).mp hy)

