@[expose] public def bad3 (x : Fin 4060) : Nat :=
  (bad3Data[x.val / 64]! >>> (6 * (x.val % 64))) % 64

@[expose] public def bad3A (x : Fin 4060) : Fin 6 :=
  ⟨(bad3 x % 8) % 6, Nat.mod_lt _ (by decide)⟩

@[expose] public def bad3B (x : Fin 4060) : Fin 6 :=
  ⟨(bad3 x / 8) % 6, Nat.mod_lt _ (by decide)⟩

@[expose] public def mate3 (x : Fin 4060) : Fin 4060 := elementMap 3 x

private theorem pair3_checked : ∀ x : Fin 4060, x ∈ pointSet →
    ∀ j : Fin 6, j.val ≤ 3 →
      (elementMap j x = x ∨ elementMap j x = mate3 x) ∧
      (elementMap j (mate3 x) = x ∨ elementMap j (mate3 x) = mate3 x) := by
  apply allFinChunks
  intro b
  fin_cases b <;> decide +kernel

private theorem negative3_chunk0 : checkChunk (fun x : Fin 4060 => x ∉ pointSet →
    (bad3A x).val ≤ 3 ∧ (bad3B x).val ≤ 3 ∧
    elementMap (bad3A x) x ≠ x ∧ elementMap (bad3B x) x ≠ x ∧
    elementMap (bad3A x) x ≠ elementMap (bad3B x) x) 0 = true := by
  decide +kernel

