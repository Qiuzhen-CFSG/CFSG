/-!
# Four normalizers preserve the common 28-point set

For indices 1 and 2, check exactly the common fixed points of the displayed
generators. For indices 3 and 4, exhibit an invariant pair at each of the 28
points; at every other point two displayed generators give three distinct
orbit points. Closure gives the assertions for the whole generated subgroup.
Thus no elementary-subgroup enumeration or order certificate is needed.
All finite equations use the certified point tables in `Actions`.

Source: the original ATLAS max4 words and the fixed words in `LocalCover.Data`;
see GLS3 Table 5.3r and the [Asc86b] application on printed p.511.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max4Normalizers

open scoped Pointwise
open Subgroup

set_option maxRecDepth 30000
set_option Elab.async false

private theorem first_mem (i : Fin 5) (j : Fin 6) (hj : j.val ≤ i.val) :
    elementaryGenerator j ∈ elementary i.castSucc := by
  fin_cases i <;> fin_cases j
  all_goals norm_num at hj
  all_goals apply Subgroup.subset_closure; simp

private theorem first_le (i : Fin 5) (H : Subgroup Model)
    (h : ∀ j : Fin 6, j.val ≤ i.val → elementaryGenerator j ∈ H) :
    elementary i.castSucc ≤ H := by
  fin_cases i
  all_goals
    apply (Subgroup.closure_le _).mpr
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
    repeat' constructor
    all_goals apply h; decide

private theorem pair_mem_stabilizer (g : Model) (x y : Fin 4060)
    (hx : g • x = x ∨ g • x = y) (hy : g • y = x ∨ g • y = y) :
    g ∈ MulAction.stabilizer Model ({x, y} : Set (Fin 4060)) := by
  change g • ({x, y} : Set (Fin 4060)) = {x, y}
  have hi : Function.Injective (fun z : Fin 4060 => g • z) := MulAction.injective g
  rw [Set.smul_set_insert, Set.smul_set_singleton]
  rcases hx with hx | hx <;> rcases hy with hy | hy
  · have he : x = y := hi (hx.trans hy.symm)
    simp [hy, he]
  · rw [hx, hy]
  · rw [hx, hy, Set.pair_comm]
  · have he : x = y := hi (hx.trans hy.symm)
    simp [hy, he]

private theorem fixed1_checked : ∀ x : Fin 4060,
    (∀ j : Fin 6, j.val ≤ 1 → elementMap j x = x) ↔ x ∈ pointSet := by
  apply allFinChunks
  intro b
  fin_cases b <;> decide +kernel

/-- The exact common fixed point set of candidate 1. -/
public theorem fixed1_iff (x : Fin 4060) :
    elementary 1 ≤ MulAction.stabilizer Model x ↔ x ∈ pointSet := by
  rw [← fixed1_checked]
  constructor
  · intro h j hj
    rw [elementMap_eq]
    exact h (first_mem 1 j hj)
  · intro h
    exact first_le 1 _ (fun j hj => by
      change elementaryGenerator j • x = x
      rw [← elementMap_eq]
      exact h j hj)

private theorem fixed2_checked : ∀ x : Fin 4060,
    (∀ j : Fin 6, j.val ≤ 2 → elementMap j x = x) ↔ x ∈ pointSet := by
  apply allFinChunks
  intro b
  fin_cases b <;> decide +kernel

/-- The exact common fixed point set of candidate 2. -/
public theorem fixed2_iff (x : Fin 4060) :
    elementary 2 ≤ MulAction.stabilizer Model x ↔ x ∈ pointSet := by
  rw [← fixed2_checked]
  constructor
  · intro h j hj
    rw [elementMap_eq]
    exact h (first_mem 2 j hj)
  · intro h
    exact first_le 2 _ (fun j hj => by
      change elementaryGenerator j • x = x
      rw [← elementMap_eq]
      exact h j hj)

