@[expose] public def bad4 (x : Fin 4060) : Nat :=
  (bad4Data[x.val / 64]! >>> (6 * (x.val % 64))) % 64

@[expose] public def bad4A (x : Fin 4060) : Fin 6 :=
  ⟨(bad4 x % 8) % 6, Nat.mod_lt _ (by decide)⟩

@[expose] public def bad4B (x : Fin 4060) : Fin 6 :=
  ⟨(bad4 x / 8) % 6, Nat.mod_lt _ (by decide)⟩

@[expose] public def mate4 (x : Fin 4060) : Fin 4060 := if elementMap 3 x = x then elementMap 4 x else elementMap 3 x

private theorem pair4_checked : ∀ x : Fin 4060, x ∈ pointSet →
    ∀ j : Fin 6, j.val ≤ 4 →
      (elementMap j x = x ∨ elementMap j x = mate4 x) ∧
      (elementMap j (mate4 x) = x ∨ elementMap j (mate4 x) = mate4 x) := by
  apply allFinChunks
  intro b
  fin_cases b <;> decide +kernel

private theorem negative4_chunk0 : checkChunk (fun x : Fin 4060 => x ∉ pointSet →
    (bad4A x).val ≤ 4 ∧ (bad4B x).val ≤ 4 ∧
    elementMap (bad4A x) x ≠ x ∧ elementMap (bad4B x) x ≠ x ∧
    elementMap (bad4A x) x ≠ elementMap (bad4B x) x) 0 = true := by
  decide +kernel

