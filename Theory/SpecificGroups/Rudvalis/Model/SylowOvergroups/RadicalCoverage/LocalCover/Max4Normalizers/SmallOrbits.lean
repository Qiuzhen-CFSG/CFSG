/-- Exactly the 28 marked points have orbit size at most two under candidate 4. -/
public theorem small4_iff (x : Fin 4060) :
    smallOrbit (elementary 4) x ↔ x ∈ pointSet := by
  constructor
  · intro h
    by_contra hx
    obtain ⟨ha, hb, han, hbn, habn⟩ := negative4_checked x hx
    simp only [elementMap_eq] at han hbn habn
    rcases h _ (first_mem 4 _ ha) _ (first_mem 4 _ hb) with h | h | h
    · exact han h
    · exact hbn h
    · exact habn h
  · intro hx
    apply smallOrbit_of_pair (elementary 4) x (mate4 x)
    apply first_le 4
    intro j hj
    obtain ⟨ha, hb⟩ := pair4_checked x hx j hj
    simp only [elementMap_eq] at ha hb
    exact pair_mem_stabilizer _ _ _ ha hb

/-- An unconditional ambient normalizer bound in the common set stabilizer. -/
public theorem normalizer_le_pointSetStabilizer (i : Fin 6) (hi0 : i ≠ 0) (hi5 : i ≠ 5) :
    normalizer (elementary i : Set Model) ≤ pointSetStabilizer := by
  fin_cases i
  · exact (hi0 rfl).elim
  · exact normalizer_le_pointSetStabilizer_of_fixed _ fixed1_iff
  · exact normalizer_le_pointSetStabilizer_of_fixed _ fixed2_iff
  · exact normalizer_le_pointSetStabilizer_of_smallOrbit _ small3_iff
  · exact normalizer_le_pointSetStabilizer_of_smallOrbit _ small4_iff
  · exact (hi5 rfl).elim

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.Max4Normalizers
