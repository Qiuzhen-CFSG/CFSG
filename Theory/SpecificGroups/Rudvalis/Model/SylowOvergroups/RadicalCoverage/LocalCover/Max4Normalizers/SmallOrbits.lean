/-- Exactly the 28 marked points have orbit size at most two under candidate 3. -/
public theorem small3_iff (x : Fin 4060) :
    smallOrbit (elementary 3) x ↔ x ∈ pointSet := by
  constructor
  · intro h
    by_contra hx
    obtain ⟨ha, hb, han, hbn, habn⟩ := negative3_checked x hx
    simp only [elementMap_eq] at han hbn habn
    rcases h _ (first_mem 3 _ ha) _ (first_mem 3 _ hb) with h | h | h
    · exact han h
    · exact hbn h
    · exact habn h
  · intro hx
    apply smallOrbit_of_pair (elementary 3) x (mate3 x)
    apply first_le 3
    intro j hj
    obtain ⟨ha, hb⟩ := pair3_checked x hx j hj
    simp only [elementMap_eq] at ha hb
    exact pair_mem_stabilizer _ _ _ ha hb

