@[expose] public def c2s0 (x : Fin 4060) : Nat :=
  (c2s0Data[x.val / 64]! >>> (3 * (x.val % 64))) % 8

@[expose] public def c2s0Cell : List (Fin 4060) := [0]

@[expose] public def c2s0Rows : List Nat := [
]

private theorem rows_eq : c2s0Rows = c2s0Cell.map InvarianceCertificate.row := by decide +kernel

private theorem cell_nodup : c2s0Cell.Nodup := by decide +kernel

private theorem facts : ∀ x : Fin 4060,
    (x ∈ c2s0Cell ↔ (initialColor 2) x = 0) ∧
    c2s0 x = (initialColor 2) x * 2 + bitCount c2s0Rows x := by
  apply Rudvalis.Data.allFin
  decide +kernel

public theorem c2s0_preserved (g : Model) (hg : g ∈ pointSetStabilizer)
    (hf : ∀ x : Fin 4060, x.val < 2 → g • x = x) :
    ∀ x, c2s0 (g • x) = c2s0 x :=
  refine_preserved g.val (model_relation g) (initialColor 2) c2s0 c2s0Cell 0 2
    cell_nodup (fun x => (facts x).1)
    (fun x => ((facts x).2).trans (congrArg (fun n => (initialColor 2) x * 2 + n)
      (bitCount_eq c2s0Cell c2s0Rows rows_eq x)))
    (initialColor_preserved 2 g hg hf)

