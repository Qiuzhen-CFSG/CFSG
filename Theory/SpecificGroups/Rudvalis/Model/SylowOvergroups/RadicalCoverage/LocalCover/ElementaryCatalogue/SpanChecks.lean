public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.ElementaryCatalogue.ElementaryComparison

/-!
# Five normal-span steps and the terminal incompatibility

Five explicit conjugation identities connect every marked generator to the
preceding chain. A single point separates the two terminal products. These
are full word identities and an inequality on the original carrier.

Source: the fixed ATLAS words and inverse point convention documented in
`LocalCover.Data`; the intended local application is the [Asc86b] analysis
cited on quasithin printed p.511 and GLS3 Table 5.3r. Generated by
`source/GenerateLean.py` from the untrusted `source/Generate.g` output.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option Elab.async false

private theorem step0 :
    (elementaryPermutation (successor 0))⁻¹ *
      (wordPermutation (spanWord 0) * elementaryPermutation (successor 0) *
        (wordPermutation (spanWord 0))⁻¹) = elementaryPermutation (predecessor 0) := by
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

private theorem step1 :
    (elementaryPermutation (successor 1))⁻¹ *
      (wordPermutation (spanWord 1) * elementaryPermutation (successor 1) *
        (wordPermutation (spanWord 1))⁻¹) = elementaryPermutation (predecessor 1) := by
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

private theorem step2 :
    (elementaryPermutation (successor 2))⁻¹ *
      (wordPermutation (spanWord 2) * elementaryPermutation (successor 2) *
        (wordPermutation (spanWord 2))⁻¹) = elementaryPermutation (predecessor 2) := by
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

private theorem step3 :
    (elementaryPermutation (successor 3))⁻¹ *
      (wordPermutation (spanWord 3) * elementaryPermutation (successor 3) *
        (wordPermutation (spanWord 3))⁻¹) = elementaryPermutation (predecessor 3) := by
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

private theorem step4 :
    (elementaryPermutation (successor 4))⁻¹ *
      (wordPermutation (spanWord 4) * elementaryPermutation (successor 4) *
        (wordPermutation (spanWord 4))⁻¹) = elementaryPermutation (predecessor 4) := by
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

/-- Normal containment of a top marked generator forces its predecessor. -/
public theorem normalSpan_step (i : Fin 5) :
    (elementaryGenerator (successor i))⁻¹ *
      (localWord (spanWord i) * elementaryGenerator (successor i) *
        (localWord (spanWord i))⁻¹) = elementaryGenerator (predecessor i) := by
  have h : (elementaryPermutation (successor i))⁻¹ *
      (wordPermutation (spanWord i) * elementaryPermutation (successor i) *
        (wordPermutation (spanWord i))⁻¹) = elementaryPermutation (predecessor i) := by
    fin_cases i
    · exact step0
    · exact step1
    · exact step2
    · exact step3
    · exact step4

  apply modelSubgroup.subtype_injective
  change (modelSubgroup.subtype (elementaryGenerator (successor i)))⁻¹ *
      (modelSubgroup.subtype (localWord (spanWord i)) *
        modelSubgroup.subtype (elementaryGenerator (successor i)) *
        (modelSubgroup.subtype (localWord (spanWord i)))⁻¹) =
      modelSubgroup.subtype (elementaryGenerator (predecessor i))
  simpa only [← elementaryPermutation_eq, ← wordPermutation_eq] using h

/-- The two terminal marked generators cannot belong to one abelian subgroup. -/
public theorem terminal_not_commute :
    ¬ Commute (elementaryGenerator 4) (elementaryGenerator 5) := by
  intro h
  have he := congrArg modelSubgroup.subtype h.eq
  change modelSubgroup.subtype (elementaryGenerator 4) *
      modelSubgroup.subtype (elementaryGenerator 5) =
    modelSubgroup.subtype (elementaryGenerator 5) *
      modelSubgroup.subtype (elementaryGenerator 4) at he
  simp only [← elementaryPermutation_eq] at he
  have hp := congrArg (fun p : Equiv.Perm (Fin 4060) => p 0) he
  exact (by decide +kernel :
    (elementaryPermutation 4 * elementaryPermutation 5) 0 ≠
      (elementaryPermutation 5 * elementaryPermutation 4) 0) hp

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate
