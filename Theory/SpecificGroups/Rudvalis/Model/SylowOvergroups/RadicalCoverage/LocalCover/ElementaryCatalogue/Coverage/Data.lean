public theorem squareWord_tail (i k : Fin 14) (h : k ∈ squareWord i) : i < k := by
  have ht : ∀ i k : Fin 14, k ∈ squareWord i → i < k := by decide +kernel
  exact ht i k h

public theorem conjugateWord_tail (i j k : Fin 14) (h : k ∈ conjugateWord i j) :
    i < k := by
  have ht : ∀ i j k : Fin 14, k ∈ conjugateWord i j → i < k := by decide +kernel
  exact ht i j k h

/-- Evaluation of a coordinate word agrees with the original model embedding. -/
public theorem pcWordPermutation_eq (w : List (Fin 14)) :
    (w.map pcPermutation).prod = modelSubgroup.subtype ((w.map pcGenerator).prod) := by
  induction w with
  | nil => rfl
  | cons i w ih =>
    change pcPermutation i * (w.map pcPermutation).prod =
      modelSubgroup.subtype (pcGenerator i * (w.map pcGenerator).prod)
    rw [pcPermutation_eq, ih]
    rfl

public theorem square_of_permutation (i : Fin 14)
    (h : pcPermutation i * pcPermutation i = ((squareWord i).map pcPermutation).prod) :
    pcGenerator i * pcGenerator i = ((squareWord i).map pcGenerator).prod := by
  apply modelSubgroup.subtype_injective
  change modelSubgroup.subtype (pcGenerator i) * modelSubgroup.subtype (pcGenerator i) =
    modelSubgroup.subtype ((squareWord i).map pcGenerator).prod
  simpa only [← pcPermutation_eq, ← pcWordPermutation_eq] using h

public theorem conjugate_of_permutation (i j : Fin 14)
    (h : (pcPermutation i)⁻¹ * pcPermutation j * pcPermutation i =
      ((conjugateWord i j).map pcPermutation).prod) :
    (pcGenerator i)⁻¹ * pcGenerator j * pcGenerator i =
      ((conjugateWord i j).map pcGenerator).prod := by
  apply modelSubgroup.subtype_injective
  change (modelSubgroup.subtype (pcGenerator i))⁻¹ * modelSubgroup.subtype (pcGenerator j) *
    modelSubgroup.subtype (pcGenerator i) =
      modelSubgroup.subtype ((conjugateWord i j).map pcGenerator).prod
  simpa only [← pcPermutation_eq, ← pcWordPermutation_eq] using h

