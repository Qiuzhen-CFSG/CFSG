/-!
# Collection identities for coordinate 13

All equalities are checked on the 4060 points and transferred to the fixed
word-defined model. Conjugation is by the inverse of the earlier generator.

Generated by `Coverage/source/Generate.py` from the untrusted
`ElementaryCatalogue/source/certificates.json`. The fixed ATLAS words and
inverse point convention are documented in `ElementaryCatalogue/source/README.md`.
The intended application is [Asc86b], quasithin printed p.511, and GLS3 Table 5.3r.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate.Coverage
set_option maxRecDepth 30000
set_option Elab.async false

public theorem square_13 :
    pcGenerator 13 * pcGenerator 13 = ((squareWord 13).map pcGenerator).prod := by
  apply square_of_permutation
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

public theorem conjugate_13 (j : Fin 14) (h : (13 : Fin 14) < j) :
    (pcGenerator 13)⁻¹ * pcGenerator j * pcGenerator 13 =
      ((conjugateWord 13 j).map pcGenerator).prod := by
  fin_cases j
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (0 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (1 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (2 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (3 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (4 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (5 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (6 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (7 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (8 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (9 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (10 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (11 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (12 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (13 : Fin 14) < (13 : Fin 14)) h)

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate.Coverage
