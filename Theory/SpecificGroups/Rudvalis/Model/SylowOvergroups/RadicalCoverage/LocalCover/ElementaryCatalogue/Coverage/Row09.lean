public theorem conjugate_9 (j : Fin 14) (h : (9 : Fin 14) < j) :
    (pcGenerator 9)⁻¹ * pcGenerator j * pcGenerator 9 =
      ((conjugateWord 9 j).map pcGenerator).prod := by
  fin_cases j
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (0 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (1 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (2 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (3 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (4 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (5 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (6 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (7 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (8 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (9 : Fin 14) < (9 : Fin 14)) h)
  · exact conjugate_9_10
  · exact conjugate_9_11
  · exact conjugate_9_12
  · exact conjugate_9_13

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate.Coverage
