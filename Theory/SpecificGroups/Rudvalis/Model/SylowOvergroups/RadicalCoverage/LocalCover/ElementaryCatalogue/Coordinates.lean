module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Reduction
public import Theory.GroupTheory.WordSubgroup

/-!
# Coordinates and finite obligations for the elementary catalogue

All words lie in the unchanged `localP`. The two certificate propositions
below keep enumeration separate from the pointwise test; neither is asserted
by this data module.

Source: the fixed ATLAS words and inverse point convention documented in
`LocalCover.Data`; the intended local application is the [Asc86b] analysis
cited on quasithin printed p.511 and GLS3 Table 5.3r. Generated by
`source/GenerateLean.py` from the untrusted `source/Generate.g` output.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option Elab.async false

/-- Fourteen words for prospective binary coordinates in the fixed subgroup.
Completeness is the separate `NormalFormCover` obligation. -/
@[expose] public def pcWords : Fin 14 → List (Fin 8) :=
  ![[3],
    [4, 3, 6, 7, 4, 3, 5, 6, 3, 6, 5],
    [6],
    [7, 7, 5, 3, 3],
    [6, 5, 3, 2, 3],
    [5],
    [4, 6, 5, 3, 5, 6, 4, 3, 4],
    [7, 5, 7, 4, 3, 5, 3],
    [4, 3, 4, 7, 4],
    [3, 5, 3, 4, 7, 5, 4, 7, 4],
    [7, 4, 3],
    [4],
    [4, 3, 4, 7, 4, 3, 4, 7],
    [4, 5, 3, 4, 7, 4, 3, 4, 7, 5]]

@[expose] public def pcGenerator (i : Fin 14) : Model := localWord (pcWords i)

/-- Earlier generators occur on the left; bit zero chooses generator zero. -/
@[expose] public def normalForm (n : Fin 16384) : Model :=
  (List.ofFn (fun i : Fin 14 => pcGenerator i ^ (n.val / 2 ^ i.val % 2))).prod

public theorem pcGenerator_mem (i : Fin 14) : pcGenerator i ∈ localP := localWord_mem _

public theorem normalForm_mem (n : Fin 16384) : normalForm n ∈ localP := by
  apply localP.list_prod_mem
  intro x hx
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hx
  exact localP.pow_mem (pcGenerator_mem i) _

/-- Surjectivity only: neither uniqueness nor the order of the ambient group
is needed for the elementary catalogue. -/
@[expose] public def NormalFormCover : Prop :=
  ∀ x ∈ localP, ∃ n : Fin 16384, normalForm n = x

/-- Every possible element of a normal elementary subgroup is either the
identity or lies in a marked candidate and is locally conjugate to its top
marked generator. Both equalities are on the original degree-4060 carrier. -/
@[expose] public def ElementTestResult (x : Model) : Prop :=
  x = 1 ∨ ∃ (i : Fin 6) (w : List (Fin 8)),
    x ∈ elementary i ∧ localWord w * x * (localWord w)⁻¹ = elementaryGenerator i

/-- Only four conjugates are tested. Normal elementary subgroups pass this
necessary test; sufficiency here is a separate finite calculation. -/
@[expose] public def PassesElementTest (x : Model) : Prop :=
  x ^ 2 = 1 ∧ ∀ j : Fin 4,
    Commute x (localGenerators j * x * (localGenerators j)⁻¹)

/-- A finite pointwise certificate, independent of normal-form completeness. -/
@[expose] public def NormalFormTest : Prop :=
  ∀ n : Fin 16384, PassesElementTest (normalForm n) → ElementTestResult (normalForm n)

/-- Conjugators taking each top generator to itself times its predecessor. -/
@[expose] public def spanWord : Fin 5 → List (Fin 8) :=
  ![[5, 3, 6, 7, 4, 3, 5, 6, 3, 5, 3, 5],
    [5, 3, 6, 7, 4, 3, 5, 5, 3, 4],
    [1, 3, 1, 7, 7, 2, 1, 2, 1],
    [2, 1, 3, 0, 2, 3, 2, 3, 1],
    [0, 3, 1, 3, 2, 3, 2, 1, 0]]

@[expose] public def predecessor : Fin 5 → Fin 6 := ![0, 1, 2, 3, 3]

@[expose] public def successor (i : Fin 5) : Fin 6 := ⟨i.val + 1, by omega⟩

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate
