public theorem conjugate_2 (j : Fin 14) (h : (2 : Fin 14) < j) :
    (pcGenerator 2)⁻¹ * pcGenerator j * pcGenerator 2 =
      ((conjugateWord 2 j).map pcGenerator).prod := by
  fin_cases j
  · exact False.elim ((by decide : ¬ (2 : Fin 14) < (0 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (2 : Fin 14) < (1 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (2 : Fin 14) < (2 : Fin 14)) h)
  · exact conjugate_2_3
  · exact conjugate_2_4
  · exact conjugate_2_5
  · exact conjugate_2_6
  · exact conjugate_2_7
  · exact conjugate_2_8
  · exact conjugate_2_9
  · exact conjugate_2_10
  · exact conjugate_2_11
  · exact conjugate_2_12
  · exact conjugate_2_13

