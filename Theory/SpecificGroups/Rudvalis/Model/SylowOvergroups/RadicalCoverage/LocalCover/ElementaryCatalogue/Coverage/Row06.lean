public theorem conjugate_6 (j : Fin 14) (h : (6 : Fin 14) < j) :
    (pcGenerator 6)⁻¹ * pcGenerator j * pcGenerator 6 =
      ((conjugateWord 6 j).map pcGenerator).prod := by
  fin_cases j
  · exact False.elim ((by decide : ¬ (6 : Fin 14) < (0 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (6 : Fin 14) < (1 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (6 : Fin 14) < (2 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (6 : Fin 14) < (3 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (6 : Fin 14) < (4 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (6 : Fin 14) < (5 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (6 : Fin 14) < (6 : Fin 14)) h)
  · exact conjugate_6_7
  · exact conjugate_6_8
  · exact conjugate_6_9
  · exact conjugate_6_10
  · exact conjugate_6_11
  · exact conjugate_6_12
  · exact conjugate_6_13

