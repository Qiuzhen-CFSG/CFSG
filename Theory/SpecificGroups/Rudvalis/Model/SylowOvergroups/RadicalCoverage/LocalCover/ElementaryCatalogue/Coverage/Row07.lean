public theorem conjugate_7 (j : Fin 14) (h : (7 : Fin 14) < j) :
    (pcGenerator 7)⁻¹ * pcGenerator j * pcGenerator 7 =
      ((conjugateWord 7 j).map pcGenerator).prod := by
  fin_cases j
  · exact False.elim ((by decide : ¬ (7 : Fin 14) < (0 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (7 : Fin 14) < (1 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (7 : Fin 14) < (2 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (7 : Fin 14) < (3 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (7 : Fin 14) < (4 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (7 : Fin 14) < (5 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (7 : Fin 14) < (6 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (7 : Fin 14) < (7 : Fin 14)) h)
  · exact conjugate_7_8
  · exact conjugate_7_9
  · exact conjugate_7_10
  · exact conjugate_7_11
  · exact conjugate_7_12
  · exact conjugate_7_13

