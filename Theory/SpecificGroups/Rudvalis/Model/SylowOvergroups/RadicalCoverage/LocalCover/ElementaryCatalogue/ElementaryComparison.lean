/-- The six cached involutions are the exact six fixed elementary words. -/
public theorem elementaryPermutation_eq (i : Fin 6) :
    elementaryPermutation i = modelSubgroup.subtype (elementaryGenerator i) := by
  fin_cases i
  · exact c0_eq
  · exact c1_eq
  · exact c2_eq
  · exact c3_eq
  · exact c4_eq
  · exact c5_eq

