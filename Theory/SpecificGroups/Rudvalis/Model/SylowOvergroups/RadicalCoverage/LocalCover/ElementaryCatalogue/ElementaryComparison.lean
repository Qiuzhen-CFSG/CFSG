namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option Elab.async false

private theorem c0_eq : elementaryPermutation 0 =
    modelSubgroup.subtype (elementaryGenerator 0) := by
  have h : elementaryPermutation 0 = wordPermutation (elementaryWords 0) := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  exact h.trans (wordPermutation_eq _)

