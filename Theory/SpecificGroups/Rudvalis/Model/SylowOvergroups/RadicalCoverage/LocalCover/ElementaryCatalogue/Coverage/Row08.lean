public theorem conjugate_8 (j : Fin 14) (h : (8 : Fin 14) < j) :
    (pcGenerator 8)⁻¹ * pcGenerator j * pcGenerator 8 =
      ((conjugateWord 8 j).map pcGenerator).prod := by
  fin_cases j
  · exact False.elim ((by decide : ¬ (8 : Fin 14) < (0 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (8 : Fin 14) < (1 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (8 : Fin 14) < (2 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (8 : Fin 14) < (3 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (8 : Fin 14) < (4 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (8 : Fin 14) < (5 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (8 : Fin 14) < (6 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (8 : Fin 14) < (7 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (8 : Fin 14) < (8 : Fin 14)) h)
  · exact conjugate_8_9
  · exact conjugate_8_10
  · exact conjugate_8_11
  · exact conjugate_8_12
  · exact conjugate_8_13

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate.Coverage
