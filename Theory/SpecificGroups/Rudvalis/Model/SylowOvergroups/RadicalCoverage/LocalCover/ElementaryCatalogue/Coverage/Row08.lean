/-!
# Collection identities for coordinate 8

All equalities are checked on the 4060 points and transferred to the fixed
word-defined model. Conjugation is by the inverse of the earlier generator.

Generated by `Coverage/source/Generate.py` from the untrusted
`ElementaryCatalogue/source/certificates.json`. The fixed ATLAS words and
inverse point convention are documented in `ElementaryCatalogue/source/README.md`.
The intended application is [Asc86b], quasithin printed p.511, and GLS3 Table 5.3r.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate.Coverage
set_option maxRecDepth 30000
set_option Elab.async false

public theorem square_8 :
    pcGenerator 8 * pcGenerator 8 = ((squareWord 8).map pcGenerator).prod := by
  apply square_of_permutation
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

private theorem conjugate_8_9 :
    (pcGenerator 8)⁻¹ * pcGenerator 9 * pcGenerator 8 =
      ((conjugateWord 8 9).map pcGenerator).prod := by
