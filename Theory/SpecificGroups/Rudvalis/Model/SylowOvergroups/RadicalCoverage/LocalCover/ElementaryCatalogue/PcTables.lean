public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.ElementaryCatalogue.LocalComparison

/-!
# Cached permutations for the binary normal forms

The inverse laws are checked here; `PcComparison` connects all fourteen
maps to the published local words. No collection or coverage is inferred
from this definition of the normal forms.

Source: the fixed ATLAS words and inverse point convention documented in
`LocalCover.Data`; the intended local application is the [Asc86b] analysis
cited on quasithin printed p.511 and GLS3 Table 5.3r. Generated by
`source/GenerateLean.py` from the untrusted `source/Generate.g` output.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option Elab.async false

@[expose] public def pc0MapPacked : Nat := 

@[expose] public def pc0Map (x : Fin 4060) : Fin 4060 :=
  ⟨(pc0MapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def pc0InvMapPacked : Nat := 

@[expose] public def pc0InvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(pc0InvMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem pc0_left : ∀ x, pc0InvMap (pc0Map x) = x := by
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

@[expose] public def pc0Perm : Equiv.Perm (Fin 4060) :=
  tablePerm pc0Map pc0InvMap (by exact pc0_left)
    (by exact rightInverse_of_leftInverse_fin pc0_left)

