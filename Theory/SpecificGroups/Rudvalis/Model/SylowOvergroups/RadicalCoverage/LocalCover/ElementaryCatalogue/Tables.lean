  ⟨(p0InvMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem p0_left : ∀ x, p0InvMap (p0Map x) = x := by
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

@[expose] public def p0Perm : Equiv.Perm (Fin 4060) :=
  tablePerm p0Map p0InvMap (by exact p0_left) (by exact rightInverse_of_leftInverse_fin p0_left)

