@[expose] public def p0MapPacked : Nat := 

@[expose] public def p0Map (x : Fin 4060) : Fin 4060 :=
  ⟨(p0MapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

