/-- The fourteen coordinate words generate exactly the fixed local subgroup.
Four of them are the original local generators or their inverses. -/
public theorem closure_pcGenerator_eq : Subgroup.closure (Set.range pcGenerator) = localP := by
  let H := Subgroup.closure (Set.range pcGenerator)
  have hm (i : Fin 14) : pcGenerator i ∈ H := Subgroup.subset_closure ⟨i, rfl⟩
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact pcGenerator_mem i
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · simpa [pcGenerator, pcWords, localWord, localLetter] using H.inv_mem (hm 11)
    · simpa [pcGenerator, pcWords, localWord, localLetter] using H.inv_mem (hm 5)
    · simpa [pcGenerator, pcWords, localWord, localLetter] using H.inv_mem (hm 2)
    · simpa [pcGenerator, pcWords, localWord, localLetter] using hm 0

/-- Each binary-coordinate map is the published word in the fixed subgroup. -/
public theorem pcPermutation_eq (i : Fin 14) :
    pcPermutation i = modelSubgroup.subtype (pcGenerator i) := by
  fin_cases i
  · exact pc0_eq
  · exact pc1_eq
  · exact pc2_eq
  · exact pc3_eq
  · exact pc4_eq
  · exact pc5_eq
  · exact pc6_eq
  · exact pc7_eq
  · exact pc8_eq
  · exact pc9_eq
  · exact pc10_eq
  · exact pc11_eq
  · exact pc12_eq
  · exact pc13_eq

private theorem pcProduct_eq (w : List (Fin 14 × ℕ)) :
    (w.map (fun x => pcPermutation x.1 ^ x.2)).prod =
      modelSubgroup.subtype ((w.map (fun x => pcGenerator x.1 ^ x.2)).prod) := by
  induction w with
  | nil => rfl
  | cons x w ih =>
    change pcPermutation x.1 ^ x.2 * (w.map (fun x => pcPermutation x.1 ^ x.2)).prod =
      modelSubgroup.subtype (pcGenerator x.1 ^ x.2 *
        (w.map (fun x => pcGenerator x.1 ^ x.2)).prod)
    rw [pcPermutation_eq, ih]
    rfl

/-- Finite checks on these cached permutations prove facts about the actual
normal forms, without any unproved alternative-model isomorphism. -/
public theorem normalFormPermutation_eq (n : Fin 16384) :
    normalFormPermutation n = modelSubgroup.subtype (normalForm n) := by
  simpa only [List.map_ofFn, Function.comp_def, normalFormPermutation, normalForm] using
    pcProduct_eq (List.ofFn (fun i : Fin 14 => (i, n.val / 2 ^ i.val % 2)))

