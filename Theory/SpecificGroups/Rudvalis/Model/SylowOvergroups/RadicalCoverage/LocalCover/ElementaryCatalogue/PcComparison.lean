module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.ElementaryCatalogue.PcTables

/-!
# Comparison of all binary coordinates with the model

Each of the fourteen coordinate words is compared on all 4060 points.
Multiplication then transfers every normal form without further enumeration.
This provides a shared interface for independent coverage and point-test
certificates.

Source: the fixed ATLAS words and inverse point convention documented in
`LocalCover.Data`; the intended local application is the [Asc86b] analysis
cited on quasithin printed p.511 and GLS3 Table 5.3r. Generated by
`source/GenerateLean.py` from the untrusted `source/Generate.g` output.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option Elab.async false

private theorem pc0_eq : pcPermutation 0 =
    modelSubgroup.subtype (pcGenerator 0) := by
  have h : pcPermutation 0 = wordPermutation (pcWords 0) := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  exact h.trans (wordPermutation_eq _)

