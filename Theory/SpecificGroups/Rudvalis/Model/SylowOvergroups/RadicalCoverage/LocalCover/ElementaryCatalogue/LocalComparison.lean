module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.ElementaryCatalogue.Tables
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.Cardinality.Max4Comparison
public import Mathlib.Tactic.FinCases

/-!
# Comparison with the four fixed local words

Each cached local generator is checked against its preserved max4 word on
all 4060 points. Arbitrary word evaluation then transfers algebraically.

Source: the fixed ATLAS words and inverse point convention documented in
`LocalCover.Data`; the intended local application is the [Asc86b] analysis
cited on quasithin printed p.511 and GLS3 Table 5.3r. Generated by
`source/GenerateLean.py` from the untrusted `source/Generate.g` output.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option Elab.async false

local notation "x" => LocalCardinality.Max4.L0.gen 0
local notation "y" => LocalCardinality.Max4.L0.gen 1

private theorem p0_eq : localPermutation 0 =
    modelSubgroup.subtype (localGenerators 0) := by
  have h : localPermutation 0 = y * x * y⁻¹ := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  rw [LocalCardinality.Max4.generator0_eq, LocalCardinality.Max4.generator1_eq] at h
  exact h

private theorem p1_eq : localPermutation 1 =
    modelSubgroup.subtype (localGenerators 1) := by
  have h : localPermutation 1 = x * y * x * y⁻¹ * x := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  rw [LocalCardinality.Max4.generator0_eq, LocalCardinality.Max4.generator1_eq] at h
  exact h

private theorem p2_eq : localPermutation 2 =
    modelSubgroup.subtype (localGenerators 2) := by
  have h : localPermutation 2 = y⁻¹ * x * y⁻¹ * x * y * x * y := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  rw [LocalCardinality.Max4.generator0_eq, LocalCardinality.Max4.generator1_eq] at h
  exact h

private theorem p3_eq : localPermutation 3 =
    modelSubgroup.subtype (localGenerators 3) := by
  have h : localPermutation 3 = x * y⁻¹ * x * y * x * y * x * y⁻¹ * x * y := by
    apply Equiv.ext
    apply Rudvalis.OrderCertificate.allFin
    decide +kernel
  rw [LocalCardinality.Max4.generator0_eq, LocalCardinality.Max4.generator1_eq] at h
  exact h

/-- All four cached permutations represent the exact fixed generators. -/
public theorem localPermutation_eq (i : Fin 4) :
    localPermutation i = modelSubgroup.subtype (localGenerators i) := by
  fin_cases i
  · exact p0_eq
  · exact p1_eq
  · exact p2_eq
  · exact p3_eq

private theorem letterPermutation_eq (i : Fin 8) :
    letterPermutation i = modelSubgroup.subtype (localLetter i) := by
  fin_cases i
  · exact p0_eq
  · exact p1_eq
  · exact p2_eq
  · exact p3_eq
  · exact congrArg Inv.inv p0_eq
  · exact congrArg Inv.inv p1_eq
  · exact congrArg Inv.inv p2_eq
  · exact congrArg Inv.inv p3_eq

/-- Cached word evaluation agrees with multiplication in the actual model. -/
public theorem wordPermutation_eq (w : List (Fin 8)) :
    wordPermutation w = modelSubgroup.subtype (localWord w) := by
  induction w with
  | nil => rfl
  | cons i w ih =>
    change letterPermutation i * wordPermutation w =
      modelSubgroup.subtype (localLetter i * localWord w)
    rw [letterPermutation_eq, ih]
    rfl

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate
