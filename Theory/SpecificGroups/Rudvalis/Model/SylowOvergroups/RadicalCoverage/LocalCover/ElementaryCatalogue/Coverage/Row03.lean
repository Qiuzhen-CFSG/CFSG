public theorem conjugate_3 (j : Fin 14) (h : (3 : Fin 14) < j) :
    (pcGenerator 3)⁻¹ * pcGenerator j * pcGenerator 3 =
      ((conjugateWord 3 j).map pcGenerator).prod := by
  fin_cases j
  · exact False.elim ((by decide : ¬ (3 : Fin 14) < (0 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (3 : Fin 14) < (1 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (3 : Fin 14) < (2 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (3 : Fin 14) < (3 : Fin 14)) h)
  · exact conjugate_3_4
  · exact conjugate_3_5
  · exact conjugate_3_6
  · exact conjugate_3_7
  · exact conjugate_3_8
  · exact conjugate_3_9
  · exact conjugate_3_10
  · exact conjugate_3_11
  · exact conjugate_3_12
  · exact conjugate_3_13

