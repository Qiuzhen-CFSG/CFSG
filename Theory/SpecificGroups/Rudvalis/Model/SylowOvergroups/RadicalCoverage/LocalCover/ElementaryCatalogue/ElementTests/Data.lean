/-- Eight bits per row: kind in bits 0–1; generator in bits 2–3 and
point from bit 4 for obstructions; positive-row index from bit 2 for kind 3. -/
@[expose] public def witnessPacked : Nat := 

@[expose] public def witness (n : Fin 16384) : Nat :=
  (witnessPacked >>> (8 * n.val)) % 256

@[expose] public def witnessPoint (n : Fin 16384) : Fin 4060 :=
  ⟨witness n / 16 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def witnessGenerator (n : Fin 16384) : Fin 4 :=
  ⟨witness n / 4 % 4, Nat.mod_lt _ (by decide)⟩

@[expose] public def witnessPositive (n : Fin 16384) : Fin 47 :=
  ⟨witness n / 4 % 47, Nat.mod_lt _ (by decide)⟩

/-- The exact pointwise obstruction or reference to a positive row. -/
@[expose] public def RowCheck (n : Fin 16384) : Prop :=
  if witness n % 4 = 0 then n = 0
  else if witness n % 4 = 1 then
    (normalFormPermutation n ^ 2) (witnessPoint n) ≠ witnessPoint n
  else if witness n % 4 = 2 then
    let x := normalFormPermutation n
    let g := localPermutation (witnessGenerator n)
    (x * (g * x * g⁻¹)) (witnessPoint n) ≠
      ((g * x * g⁻¹) * x) (witnessPoint n)
  else n = (positiveRows (witnessPositive n)).form

public instance (n : Fin 16384) : Decidable (RowCheck n) := by
  unfold RowCheck
  infer_instance

/-- Each of sixteen blocks checks 1024 consecutive indices. -/
@[expose] public def blockIndex (b : Fin 16) (r : Fin 1024) : Fin 16384 :=
  ⟨1024 * b.val + r.val, by omega⟩

