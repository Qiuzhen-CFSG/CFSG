public theorem conjugate_5 (j : Fin 14) (h : (5 : Fin 14) < j) :
    (pcGenerator 5)⁻¹ * pcGenerator j * pcGenerator 5 =
      ((conjugateWord 5 j).map pcGenerator).prod := by
  fin_cases j
  · exact False.elim ((by decide : ¬ (5 : Fin 14) < (0 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (5 : Fin 14) < (1 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (5 : Fin 14) < (2 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (5 : Fin 14) < (3 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (5 : Fin 14) < (4 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (5 : Fin 14) < (5 : Fin 14)) h)
  · exact conjugate_5_6
  · exact conjugate_5_7
  · exact conjugate_5_8
  · exact conjugate_5_9
  · exact conjugate_5_10
  · exact conjugate_5_11
  · exact conjugate_5_12
  · exact conjugate_5_13

