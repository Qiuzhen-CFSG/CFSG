module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.ElementaryCatalogue.Coverage.Data

/-!
# Collection identities for coordinate 11

All equalities are checked on the 4060 points and transferred to the fixed
word-defined model. Conjugation is by the inverse of the earlier generator.

Generated by `Coverage/source/Generate.py` from the untrusted
`ElementaryCatalogue/source/certificates.json`. The fixed ATLAS words and
inverse point convention are documented in `ElementaryCatalogue/source/README.md`.
The intended application is [Asc86b], quasithin printed p.511, and GLS3 Table 5.3r.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate.Coverage
set_option maxRecDepth 30000
set_option Elab.async false

public theorem square_11 :
    pcGenerator 11 * pcGenerator 11 = ((squareWord 11).map pcGenerator).prod := by
  apply square_of_permutation
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

private theorem conjugate_11_12 :
    (pcGenerator 11)⁻¹ * pcGenerator 12 * pcGenerator 11 =
      ((conjugateWord 11 12).map pcGenerator).prod := by
  apply conjugate_of_permutation
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

private theorem conjugate_11_13 :
    (pcGenerator 11)⁻¹ * pcGenerator 13 * pcGenerator 11 =
      ((conjugateWord 11 13).map pcGenerator).prod := by
  apply conjugate_of_permutation
  apply Equiv.ext
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

public theorem conjugate_11 (j : Fin 14) (h : (11 : Fin 14) < j) :
    (pcGenerator 11)⁻¹ * pcGenerator j * pcGenerator 11 =
      ((conjugateWord 11 j).map pcGenerator).prod := by
  fin_cases j
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (0 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (1 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (2 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (3 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (4 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (5 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (6 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (7 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (8 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (9 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (10 : Fin 14)) h)
  · exact False.elim ((by decide : ¬ (11 : Fin 14) < (11 : Fin 14)) h)
  · exact conjugate_11_12
  · exact conjugate_11_13

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate.Coverage
