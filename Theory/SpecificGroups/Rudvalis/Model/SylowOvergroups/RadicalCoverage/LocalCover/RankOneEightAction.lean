module
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.RankOneEightAction.Identities

/-!
# The Rudvalis max4 action on the marked eight-group and plane

Both max4 generators normalize the subgroup generated by the first three
marked elementary words: the conjugation identities in `Identities` send
each generator back into that subgroup, and finiteness gives equality.

The first max4 generator moves the plane generated by the first two words.
Two commuting involutions give exactly four plane words. Their images of
point zero are 0, 1028, 1738 and 2249, whereas the conjugate of the second
plane generator sends zero to 2519. These values are kernel checked on the
original degree-4060 model via the certified permutation comparisons.

Source: the sporadic inspection in Aschbacher–Smith, 15.3.43, printed p.1140,
with the list in 1.1.5(3)(f), p.502, and GLS3 Table 5.3r. The ATLAS
Wilson–Nickerson–Bray programs, original words and attribution are preserved
in `SylowOvergroups.Definitions` and `LocalCover.Data`.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.RankOneEightAction
open Subgroup CatalogueCertificate
set_option Elab.async false

private theorem mem_normalizer_of_generators {G : Type*} [Group G] [Finite G]
    (s : Set G) (g : G) (h : ∀ a ∈ s, g * a * g⁻¹ ∈ closure s) :
    g ∈ normalizer (closure s : Set G) := by
  apply mem_normalizer_iff_map_conj_eq.mpr
  apply eq_of_le_of_card_ge
  · rw [map_le_iff_le_comap, closure_le]
    exact h
  · exact (Nat.card_congr ((MulAut.conj g).subgroupMap (closure s)).toEquiv).le

private theorem mem_pair_closure {G : Type*} [Group G] (a b : G)
    (ha : a * a = 1) (hb : b * b = 1) (hab : a * b = b * a) (z : G) :
    z ∈ closure {a, b} ↔ z = 1 ∨ z = a ∨ z = b ∨ z = a * b := by
  have haa (x : G) : a * (a * x) = x := by rw [← mul_assoc, ha, one_mul]
  have hba (x : G) : b * (a * x) = a * (b * x) := by rw [← mul_assoc, ← hab, mul_assoc]
  have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha
  have hbi : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb
  let H : Subgroup G := {
    carrier := {z | z = 1 ∨ z = a ∨ z = b ∨ z = a * b}
    one_mem' := Or.inl rfl
    mul_mem' := by
      intro x y hx hy
      rcases hx with rfl | rfl | rfl | rfl <;>
        rcases hy with rfl | rfl | rfl | rfl <;>
        simp [mul_assoc, ha, hb, ← hab, haa, hba]
    inv_mem' := by
      intro x hx
      rcases hx with rfl | rfl | rfl | rfl <;> simp [mul_inv_rev, hai, hbi, ← hab] }
  constructor
  · exact fun hz => ((closure_le H).mpr (by simp [H, Set.insert_subset_iff])) hz
  · intro hz
    have ha' : a ∈ closure {a, b} := subset_closure (by simp)
    have hb' : b ∈ closure {a, b} := subset_closure (by simp)
    rcases hz with rfl | rfl | rfl | rfl
    · exact one_mem _
    · exact ha'
    · exact hb'
    · exact mul_mem ha' hb'


private theorem basis_mem (i : Fin 3) :
    elementaryGenerator (Fin.castLE (by decide) i) ∈ elementary 2 := by
  fin_cases i <;> exact subset_closure (by simp)

/-- The actual fourth ATLAS subgroup normalizes the marked eight-group. -/
public theorem max4_le_normalizer_eight :
    max4 ≤ normalizer (elementary 2 : Set Model) := by
  change closure {max4Generators.1, max4Generators.2} ≤ _
  apply (closure_le _).mpr
  intro g hg
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl
  · apply mem_normalizer_of_generators
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl | rfl
    · rw [first_conj_zero]
      exact basis_mem 0
    · rw [first_conj_one]
      exact mul_mem (mul_mem (basis_mem 0) (basis_mem 1)) (basis_mem 2)
    · rw [first_conj_two]
      exact basis_mem 2
  · apply mem_normalizer_of_generators
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl | rfl
    · rw [second_conj_zero]
      exact mul_mem (basis_mem 0) (basis_mem 1)
    · rw [second_conj_one]
      exact mul_mem (basis_mem 1) (basis_mem 2)
    · rw [second_conj_two]
      exact basis_mem 1

private theorem plane_mem_iff (z : Model) : z ∈ elementary 1 ↔
    z = 1 ∨ z = elementaryGenerator 0 ∨ z = elementaryGenerator 1 ∨
      z = elementaryGenerator 0 * elementaryGenerator 1 :=
  mem_pair_closure _ _ elementary_zero_sq elementary_one_sq elementary_zero_one_commute z

set_option maxRecDepth 30000 in
private theorem point_zero_values :
    (elementaryGenerator 0 * elementaryGenerator 1 * elementaryGenerator 2).val 0 = 2519 ∧
    (1 : Model).val 0 = 0 ∧
    (elementaryGenerator 0).val 0 = 1028 ∧
    (elementaryGenerator 1).val 0 = 1738 ∧
    (elementaryGenerator 0 * elementaryGenerator 1).val 0 = 2249 := by
  have ht : (elementaryGenerator 0 * elementaryGenerator 1 * elementaryGenerator 2).val =
      elementaryPermutation 0 * elementaryPermutation 1 * elementaryPermutation 2 := by
    simp only [elementaryPermutation_eq]
    rfl
  have hp : (elementaryGenerator 0 * elementaryGenerator 1).val =
      elementaryPermutation 0 * elementaryPermutation 1 := by
    simp only [elementaryPermutation_eq]
    rfl
  have h0 : (elementaryGenerator 0).val = elementaryPermutation 0 :=
    (elementaryPermutation_eq 0).symm
  have h1 : (elementaryGenerator 1).val = elementaryPermutation 1 :=
    (elementaryPermutation_eq 1).symm
  rw [ht, hp, h0, h1]
  decide +kernel

private theorem triple_not_mem_plane :
    elementaryGenerator 0 * elementaryGenerator 1 * elementaryGenerator 2 ∉ elementary 1 := by
  intro hz
  rcases (plane_mem_iff _).mp hz with hz | hz | hz | hz
  · have hp := congrArg (fun z : Model => z.val (0 : Fin 4060)) hz
    rw [point_zero_values.1, point_zero_values.2.1] at hp
    exact (by decide : (2519 : Fin 4060) ≠ 0) hp
  · have hp := congrArg (fun z : Model => z.val (0 : Fin 4060)) hz
    rw [point_zero_values.1, point_zero_values.2.2.1] at hp
    exact (by decide : (2519 : Fin 4060) ≠ 1028) hp
  · have hp := congrArg (fun z : Model => z.val (0 : Fin 4060)) hz
    rw [point_zero_values.1, point_zero_values.2.2.2.1] at hp
    exact (by decide : (2519 : Fin 4060) ≠ 1738) hp
  · have hp := congrArg (fun z : Model => z.val (0 : Fin 4060)) hz
    rw [point_zero_values.1, point_zero_values.2.2.2.2] at hp
    exact (by decide : (2519 : Fin 4060) ≠ 2249) hp

/-- The actual fourth ATLAS subgroup does not normalize the marked plane. -/
public theorem max4_not_le_normalizer_plane :
    ¬ max4 ≤ normalizer (elementary 1 : Set Model) := by
  intro h
  have hx : max4Generators.1 ∈ max4 := subset_closure (by simp)
  have hc : elementaryGenerator 1 ∈ elementary 1 := subset_closure (by simp)
  have hm := (mem_normalizer_iff.mp (h hx) (elementaryGenerator 1)).mp hc
  rw [first_conj_one] at hm
  exact triple_not_mem_plane hm

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover.RankOneEightAction
