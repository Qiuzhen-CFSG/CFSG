module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Reduction
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.Words
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.Centralizer
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.Max6Normalizers.FiveNormalizer
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# A common conjugate of max6 contains two Rudvalis elementary normalizers

The normalizer of elementary 0 equals the centralizer of its marked
involution. The checked conjugator transports a bound on the centralizer of
the explicit max6 involution to this centralizer. The normalizer of
elementary 5 fixes the marked involution because it preserves the two-element
kernel on the union of its small orbits. Thus the same conjugate contains
both ambient normalizers.

The centralizer bound is certified by orbital color refinement and actual
max6 word representatives. Together with the checked word alignment and
small-orbit kernel certificate, it proves `max6NormalizerBounds` without
Sylow, catalogue, or ambient-order premises.

Source: the preserved ATLAS programs and conjugator in LocalCover/source/;
the local overgroup analysis cited as [Asc86b] in Aschbacher--Smith, printed
p.511, with the candidate structures in GLS3 Table 5.3r.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover

open Subgroup

namespace Max6Certificate

/-- The first elementary subgroup is generated by an actual involution,
so its ambient normalizer fixes that involution. -/
public theorem zero_normalizer_eq_centralizer :
    normalizer (elementary 0 : Set Model) =
      centralizer ({elementaryGenerator 0} : Set Model) := by
  change normalizer (closure {elementaryGenerator 0} : Set Model) = _
  rw [← zpowers_eq_closure]
  exact normalizer_zpowers_eq_centralizer_of_order_two _ elementary_zero_order

/-- Transport a centralizer bound using the certified word alignment.
The witness is the inverse of the recorded GAP conjugator. -/
public theorem centralizer_le_conjugate
    (hC : centralizer ({centralInvolution} : Set Model) ≤ max6) :
    centralizer ({elementaryGenerator 0} : Set Model) ≤
      max6.map (MulAut.conj conjugator).toMonoidHom := by
  let e := MulAut.conj conjugator
  intro x hx
  refine ⟨e.symm x, hC ?_, e.apply_symm_apply x⟩
  apply mem_centralizer_singleton_iff.mpr
  apply e.injective
  simp only [map_mul, MulEquiv.apply_symm_apply]
  change x * MulAut.conj conjugator centralInvolution =
    MulAut.conj conjugator centralInvolution * x
  rw [conjugator_alignment]
  exact mem_centralizer_singleton_iff.mp hx

end Max6Certificate

/-- The two independent centralizer certificates imply the max6 bounds. -/
public theorem max6NormalizerBounds_of_centralizers
    (hC : centralizer ({Max6Certificate.centralInvolution} : Set Model) ≤ max6)
    (h5 : normalizer (elementary 5 : Set Model) ≤
      centralizer ({elementaryGenerator 0} : Set Model)) :
    Max6NormalizerBounds := by
  intro i hi
  refine ⟨Max6Certificate.conjugator, ?_⟩
  have hc := Max6Certificate.centralizer_le_conjugate hC
  rcases hi with rfl | rfl
  · rw [Max6Certificate.zero_normalizer_eq_centralizer]
    exact hc
  · exact h5.trans hc

/-- Both ambient normalizers lie in the conjugate of max6 given by the inverse
of the recorded GAP word, with all centralizer premises discharged. -/
public theorem max6NormalizerBounds : Max6NormalizerBounds :=
  max6NormalizerBounds_of_centralizers Max6Certificate.centralizer_le_max6
    Max6Certificate.five_normalizer_le_centralizer

end Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover
