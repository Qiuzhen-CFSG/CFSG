namespace Rudvalis.SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder

private theorem fourth_map (i : Fin 14) (x : Fin 4060) : (generatorMap i)^[4] x = x := by
  fin_cases i
  · exact fourth_map_0 x
  · exact fourth_map_1 x
  · exact fourth_map_2 x
  · exact fourth_map_3 x
  · exact fourth_map_4 x
  · exact fourth_map_5 x
  · exact fourth_map_6 x
  · exact fourth_map_7 x
  · exact fourth_map_8 x
  · exact fourth_map_9 x
  · exact fourth_map_10 x
  · exact fourth_map_11 x
  · exact fourth_map_12 x
  · exact fourth_map_13 x

private theorem collect_map (i j : Fin 14) (h : i < j) (x : Fin 4060) :
    generatorMap i (generatorMap j x) =
      evalWord generatorMap (conjugateWord i j) (generatorMap i x) := by
  fin_cases i
  · exact collect_map_0 j h x
  · exact collect_map_1 j h x
  · exact collect_map_2 j h x
  · exact collect_map_3 j h x
  · exact collect_map_4 j h x
  · exact collect_map_5 j h x
  · exact collect_map_6 j h x
  · exact collect_map_7 j h x
  · exact collect_map_8 j h x
  · exact collect_map_9 j h x
  · exact collect_map_10 j h x
  · exact collect_map_11 j h x
  · exact collect_map_12 j h x
  · exact collect_map_13 j h x

/-- Every actual generator has order dividing four. -/
public theorem generator_fourth (i : Fin 14) : candidateGenerator i ^ 4 = 1 := by
  apply eq_of_smul_eq_smul (α := Fin 4060)
  intro x
  rw [generator_pow_smul, one_smul]
  exact fourth_map i x

/-- Conjugation by an earlier generator is the displayed word in the tail. -/
public theorem generator_conjugate (i j : Fin 14) (h : i < j) :
    candidateGenerator i * candidateGenerator j * (candidateGenerator i)⁻¹ =
      ((conjugateWord i j).map candidateGenerator).prod := by
  apply mul_inv_eq_iff_eq_mul.mpr
  apply eq_of_smul_eq_smul (α := Fin 4060)
  intro x
  simp only [mul_smul, generator_smul,
    prod_smul candidateGenerator generatorMap generator_smul]
  exact collect_map i j h x

end Rudvalis.SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder
