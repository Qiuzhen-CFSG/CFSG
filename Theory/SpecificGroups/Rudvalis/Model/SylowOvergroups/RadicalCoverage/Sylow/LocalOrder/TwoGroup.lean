module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.Sylow.LocalOrder.Collection
public import Mathlib.GroupTheory.PGroup

/-!
# The candidate is a two-group

The subgroup generated by the last generators is normalized by the next
one, by the certified collection equations. Each new cyclic subgroup has
order dividing four. Descending induction therefore proves that every tail,
and hence the candidate, is a two-group. Normality is used only inside each
successive join, not in the ambient Rudvalis group.

The collection data concern the preserved ATLAS max4 words on the degree-4060
carrier; see `Candidate.lean` and `LocalOrder/source/Generate.py`.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder

private def tail (k : Nat) : Subgroup Model :=
  Subgroup.closure {g | ∃ i : Fin 14, k ≤ i.val ∧ candidateGenerator i = g}
private theorem tail_mem {k : Nat} (i : Fin 14) (hi : k ≤ i.val) :
    candidateGenerator i ∈ tail k := Subgroup.subset_closure ⟨i, hi, rfl⟩
private theorem tail_step (k : Nat) (hk : k < 14) :
    tail k = Subgroup.zpowers (candidateGenerator ⟨k, hk⟩) ⊔ tail (k + 1) := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨i, hi, rfl⟩
    by_cases he : i.val = k
    · have he' : i = ⟨k, hk⟩ := Fin.ext he
      subst i
      exact (show Subgroup.zpowers (candidateGenerator ⟨k, hk⟩) ≤ _ from le_sup_left)
        (Subgroup.mem_zpowers _)
    · exact (show tail (k + 1) ≤ _ from le_sup_right) (tail_mem i (by omega))
  · apply sup_le
    · exact Subgroup.zpowers_le.mpr (tail_mem _ (by rfl))
    · apply (Subgroup.closure_le _).mpr
      rintro g ⟨i, hi, rfl⟩
      exact tail_mem i (by omega)
private theorem pgroup_of_collection
    (hpow : ∀ i, candidateGenerator i ^ 4 = 1)
    (hconj : ∀ i j : Fin 14, i < j →
      candidateGenerator i * candidateGenerator j * (candidateGenerator i)⁻¹ ∈ tail (i.val + 1)) :
    IsPGroup 2 candidate := by
  have hp (k : Nat) (hk : k ≤ 14) : IsPGroup 2 (tail k) := by
    induction hk using Nat.decreasingInduction with
    | self =>
      have ht : tail 14 = ⊥ := by
        apply le_bot_iff.mp
        apply (Subgroup.closure_le _).mpr
        rintro g ⟨i, hi, rfl⟩
        omega
      rw [ht]
      exact IsPGroup.of_bot
    | of_succ k hk ih =>
      rw [tail_step k hk]
      refine IsPGroup.to_sup_of_normal_right' ?_ ih ?_
      · apply isPGroup_iff_card_dvd_pow.mpr
        exact ⟨2, by rw [Nat.card_zpowers]; exact orderOf_dvd_of_pow_eq_one (hpow ⟨k, hk⟩)⟩
      · apply Subgroup.zpowers_le.mpr
        apply Subgroup.mem_normalizer_fintype
        have hc : tail (k + 1) ≤ (tail (k + 1)).comap
            (MulAut.conj (candidateGenerator ⟨k, hk⟩)).toMonoidHom := by
          apply (Subgroup.closure_le _).mpr
          rintro g ⟨j, hj, rfl⟩
          exact hconj ⟨k, hk⟩ j (by exact hj)
        exact fun x hx => hc hx
  have ht : tail 0 = candidate := by
    change Subgroup.closure _ = Subgroup.closure _
    congr 1
    ext g
    exact ⟨fun ⟨i, _, hi⟩ => ⟨i, hi⟩, fun ⟨i, hi⟩ => ⟨i, Nat.zero_le _, hi⟩⟩
  rw [← ht]
  exact hp 0 (by omega)

/-- The concrete word-generated candidate is a two-group. -/
public theorem candidate_isTwoGroup : IsPGroup 2 candidate := by
  apply pgroup_of_collection generator_fourth
  intro i j hij
  rw [generator_conjugate i j hij]
  apply (tail (i.val + 1)).list_prod_mem
  intro g hg
  obtain ⟨k, hk, rfl⟩ := List.mem_map.mp hg
  exact tail_mem k (conjugateWord_tail i j k hk)

end Rudvalis.SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder
