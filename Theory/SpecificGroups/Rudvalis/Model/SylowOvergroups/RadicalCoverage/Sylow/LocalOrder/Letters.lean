module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.Sylow.LocalOrder.Letter0
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.Sylow.LocalOrder.Letter1
public import Mathlib.Tactic.FinCases

/-!
# The four max4 letter maps

Kernel checks identify the tables with the preserved max4 words and inverses.

Generated by `source/Generate.py`; see that file and `Candidate.lean` for
the preserved ATLAS sources and point-action convention.
-/

namespace Rudvalis.SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder

set_option maxRecDepth 30000

private theorem inverse_map_0 : ∀ x, letterMap 0 (letterMap 2 x) = x := by
  apply Rudvalis.Data.allFin
  decide +kernel

public theorem letter_smul_2 (x : Fin 4060) : candidateLetter 2 • x = letterMap 2 x := by
  change (candidateLetter 0)⁻¹ • x = letterMap 2 x
  apply inv_smul_eq_iff.mpr
  rw [letter_smul_0]
  exact (inverse_map_0 x).symm

private theorem inverse_map_1 : ∀ x, letterMap 1 (letterMap 3 x) = x := by
  apply Rudvalis.Data.allFin
  decide +kernel

public theorem letter_smul_3 (x : Fin 4060) : candidateLetter 3 • x = letterMap 3 x := by
  change (candidateLetter 1)⁻¹ • x = letterMap 3 x
  apply inv_smul_eq_iff.mpr
  rw [letter_smul_1]
  exact (inverse_map_1 x).symm

public theorem letter_smul (i : Fin 4) (x : Fin 4060) :
    candidateLetter i • x = letterMap i x := by
  fin_cases i
  · exact letter_smul_0 x
  · exact letter_smul_1 x
  · exact letter_smul_2 x
  · exact letter_smul_3 x

public theorem prod_smul {n : Nat} (g : Fin n → Model)
    (f : Fin n → Fin 4060 → Fin 4060) (h : ∀ i x, g i • x = f i x)
    (l : List (Fin n)) (x : Fin 4060) :
    (l.map g).prod • x = evalWord f l x := by
  induction l generalizing x with
  | nil => exact one_smul Model x
  | cons i l ih =>
    change (g i * (l.map g).prod) • x = f i (evalWord f l x)
    rw [mul_smul, ih, h]

end Rudvalis.SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder
