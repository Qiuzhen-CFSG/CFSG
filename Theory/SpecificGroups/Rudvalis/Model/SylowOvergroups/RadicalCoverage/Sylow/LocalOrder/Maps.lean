namespace Rudvalis.SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder

public theorem generator_smul (i : Fin 14) (x : Fin 4060) :
    candidateGenerator i • x = generatorMap i x := by
  fin_cases i
  · exact generator_smul_0 x
  · exact generator_smul_1 x
  · exact generator_smul_2 x
  · exact generator_smul_3 x
  · exact generator_smul_4 x
  · exact generator_smul_5 x
  · exact generator_smul_6 x
  · exact generator_smul_7 x
  · exact generator_smul_8 x
  · exact generator_smul_9 x
  · exact generator_smul_10 x
  · exact generator_smul_11 x
  · exact generator_smul_12 x
  · exact generator_smul_13 x

public theorem generator_pow_smul (i : Fin 14) (n : Nat) (x : Fin 4060) :
    candidateGenerator i ^ n • x = (generatorMap i)^[n] x := by
  induction n generalizing x with
  | zero => exact one_smul Model x
  | succ n ih =>
    rw [pow_succ', mul_smul, ih, generator_smul, Function.iterate_succ_apply']

public theorem normal_smul (n : Fin 16384) (x : Fin 4060) :
    candidateNormalForm n • x = normalMap n x := by
  have h := prod_smul (fun i : Fin 14 => candidateGenerator i ^ (n.val / 2 ^ i.val % 2))
    (fun i => (generatorMap i)^[n.val / 2 ^ i.val % 2])
    (fun i x => generator_pow_smul i _ x) (List.ofFn id) x
  simpa only [candidateNormalForm, normalMap, List.map_ofFn, Function.comp_def, id_eq] using h

end Rudvalis.SylowOvergroups.RadicalCoverage.SylowCertificate.LocalOrder
