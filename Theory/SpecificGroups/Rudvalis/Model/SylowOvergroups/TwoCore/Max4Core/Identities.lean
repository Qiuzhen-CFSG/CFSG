module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.Definitions

/-!
# A normal elementary abelian seed in the fourth Rudvalis local subgroup

Write x and y for the actual ATLAS max4 generators and put
z = (x y² x y x y)⁸, z₁ = y² z y, z₂ = x z₁ x. The three elements are
commuting involutions; conjugation by x and y preserves their generated
subgroup. The next module uses these identities to give a nontrivial intrinsic
two-core, without needing an order calculation for max4.

All identities below are checked on the degree-4060 carrier. The packed maps
are computational intermediates, proved equal to the displayed words before
use. They were discovered using GAP and the unmodified ATLAS inputs retained
in Model and SylowOvergroups/source; GAP output is not a proof premise.

Source application: Aschbacher--Smith, Proposition 1.3.4, printed p.511
(PDF p.528), citing [Asc86b]. The ATLAS source attribution and inverse-action
convention are in Model.PermutationData and SylowOvergroups.Definitions.
-/

namespace Rudvalis.SylowOvergroups.TwoCore.Max4Core

@[expose] public def x : Model := max4Generators.1
@[expose] public def y : Model := max4Generators.2
@[expose] public def z : Model := (x * y ^ 2 * x * y * x * y) ^ 8
@[expose] public def z₁ : Model := y ^ 2 * z * y
@[expose] public def z₂ : Model := x * z₁ * x

private def xMap (i : Fin 4060) : Fin 4060 :=
  ⟨(( : Nat) >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private def yMap (i : Fin 4060) : Fin 4060 :=
  ⟨(( : Nat) >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private def zMap (i : Fin 4060) : Fin 4060 :=
  ⟨(( : Nat) >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 20000 in
private theorem xMap_eq : ∀ i, xMap i = x • i := by
  apply Data.allFin
  decide +kernel

set_option maxRecDepth 20000 in
private theorem yMap_eq : ∀ i, yMap i = y • i := by
  apply Data.allFin
  decide +kernel

private def seedMap (i : Fin 4060) : Fin 4060 :=
  xMap (yMap (yMap (xMap (yMap (xMap (yMap i))))))

set_option maxRecDepth 20000 in
private theorem zMap_word : ∀ i, zMap i = seedMap^[8] i := by
  apply Data.allFin
  decide +kernel

private theorem zMap_eq (i : Fin 4060) : zMap i = z • i := by
  have hs : seedMap = fun j : Fin 4060 => (x * y ^ 2 * x * y * x * y) • j := by
    funext j
    simp only [seedMap, xMap_eq, yMap_eq, pow_two, mul_smul]
  rw [zMap_word, hs, smul_iterate_apply]
  rfl

private def z₁Map (i : Fin 4060) : Fin 4060 := yMap (yMap (zMap (yMap i)))
private def z₂Map (i : Fin 4060) : Fin 4060 := xMap (z₁Map (xMap i))

private theorem z₁Map_eq (i : Fin 4060) : z₁Map i = z₁ • i := by
  simp only [z₁Map, yMap_eq, zMap_eq, z₁, pow_two, mul_smul]

private theorem z₂Map_eq (i : Fin 4060) : z₂Map i = z₂ • i := by
  simp only [z₂Map, xMap_eq, z₁Map_eq, z₂, mul_smul]

set_option maxRecDepth 20000 in
public theorem x_sq : x ^ 2 = 1 := by
  have hh : ∀ i, xMap (xMap i) = i := by
    apply Data.allFin
    decide +kernel
  apply FaithfulSMul.eq_of_smul_eq_smul (α := Fin 4060)
  intro i
  simpa only [pow_succ, pow_zero, one_smul, one_mul, mul_smul,
    ← xMap_eq, ← yMap_eq, ← zMap_eq, ← z₁Map_eq, ← z₂Map_eq] using hh i

set_option maxRecDepth 20000 in
public theorem y_cube : y ^ 3 = 1 := by
  have hh : ∀ i, yMap (yMap (yMap i)) = i := by
    apply Data.allFin
    decide +kernel
  apply FaithfulSMul.eq_of_smul_eq_smul (α := Fin 4060)
  intro i
  simpa only [pow_succ, pow_zero, one_smul, one_mul, mul_smul,
    ← xMap_eq, ← yMap_eq, ← zMap_eq, ← z₁Map_eq, ← z₂Map_eq] using hh i

set_option maxRecDepth 20000 in
public theorem z_sq : z ^ 2 = 1 := by
  have hh : ∀ i, zMap (zMap i) = i := by
    apply Data.allFin
    decide +kernel
  apply FaithfulSMul.eq_of_smul_eq_smul (α := Fin 4060)
  intro i
  simpa only [pow_succ, pow_zero, one_smul, one_mul, mul_smul,
    ← xMap_eq, ← yMap_eq, ← zMap_eq, ← z₁Map_eq, ← z₂Map_eq] using hh i

set_option maxRecDepth 20000 in
public theorem z_comm_z₁ : Commute z z₁ := by
  have hh : ∀ i, zMap (z₁Map i) = z₁Map (zMap i) := by
    apply Data.allFin
    decide +kernel
  change _ * _ = _ * _
  apply FaithfulSMul.eq_of_smul_eq_smul (α := Fin 4060)
  intro i
  simpa only [pow_succ, pow_zero, one_smul, one_mul, mul_smul,
    ← xMap_eq, ← yMap_eq, ← zMap_eq, ← z₁Map_eq, ← z₂Map_eq] using hh i

set_option maxRecDepth 20000 in
public theorem z_comm_z₂ : Commute z z₂ := by
  have hh : ∀ i, zMap (z₂Map i) = z₂Map (zMap i) := by
    apply Data.allFin
    decide +kernel
  change _ * _ = _ * _
  apply FaithfulSMul.eq_of_smul_eq_smul (α := Fin 4060)
  intro i
  simpa only [pow_succ, pow_zero, one_smul, one_mul, mul_smul,
    ← xMap_eq, ← yMap_eq, ← zMap_eq, ← z₁Map_eq, ← z₂Map_eq] using hh i

set_option maxRecDepth 20000 in
public theorem z₁_comm_z₂ : Commute z₁ z₂ := by
  have hh : ∀ i, z₁Map (z₂Map i) = z₂Map (z₁Map i) := by
    apply Data.allFin
    decide +kernel
  change _ * _ = _ * _
  apply FaithfulSMul.eq_of_smul_eq_smul (α := Fin 4060)
  intro i
  simpa only [pow_succ, pow_zero, one_smul, one_mul, mul_smul,
    ← xMap_eq, ← yMap_eq, ← zMap_eq, ← z₁Map_eq, ← z₂Map_eq] using hh i

set_option maxRecDepth 20000 in
public theorem x_z_x : x * z * x = z := by
  have hh : ∀ i, xMap (zMap (xMap i)) = zMap i := by
    apply Data.allFin
    decide +kernel
  apply FaithfulSMul.eq_of_smul_eq_smul (α := Fin 4060)
  intro i
  simpa only [pow_succ, pow_zero, one_smul, one_mul, mul_smul,
    ← xMap_eq, ← yMap_eq, ← zMap_eq, ← z₁Map_eq, ← z₂Map_eq] using hh i

set_option maxRecDepth 20000 in
public theorem y_z_y_sq : y * z * y ^ 2 = z * z₁ := by
  have hh : ∀ i, yMap (zMap (yMap (yMap i))) = zMap (z₁Map i) := by
    apply Data.allFin
    decide +kernel
  apply FaithfulSMul.eq_of_smul_eq_smul (α := Fin 4060)
  intro i
  simpa only [pow_succ, pow_zero, one_smul, one_mul, mul_smul,
    ← xMap_eq, ← yMap_eq, ← zMap_eq, ← z₁Map_eq, ← z₂Map_eq] using hh i

set_option maxRecDepth 20000 in
public theorem y_z₂_y_sq : y * z₂ * y ^ 2 = z₁ * z₂ := by
  have hh : ∀ i, yMap (z₂Map (yMap (yMap i))) = z₁Map (z₂Map i) := by
    apply Data.allFin
    decide +kernel
  apply FaithfulSMul.eq_of_smul_eq_smul (α := Fin 4060)
  intro i
  simpa only [pow_succ, pow_zero, one_smul, one_mul, mul_smul,
    ← xMap_eq, ← yMap_eq, ← zMap_eq, ← z₁Map_eq, ← z₂Map_eq] using hh i

public theorem z_ne_one : z ≠ 1 := by
  intro h
  have he := zMap_eq (0 : Fin 4060)
  rw [h, one_smul] at he
  have hn : zMap 0 ≠ 0 := by decide +kernel
  exact hn he

end Rudvalis.SylowOvergroups.TwoCore.Max4Core
