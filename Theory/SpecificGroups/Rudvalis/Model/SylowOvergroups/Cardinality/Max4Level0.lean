private theorem next_mem (i : Fin 6) : nextGen i ∈ subgroup := by
  fin_cases i
  · exact ⟨nextWord 0, next_eq0⟩
  · exact ⟨nextWord 1, next_eq1⟩
  · exact ⟨nextWord 2, next_eq2⟩
  · have hi : nextGen 3 = (nextGen 0)⁻¹ := nextInvProof 0
    exact hi.symm ▸ subgroup.inv_mem ⟨nextWord 0, next_eq0⟩
  · have hi : nextGen 4 = (nextGen 1)⁻¹ := nextInvProof 1
    exact hi.symm ▸ subgroup.inv_mem ⟨nextWord 1, next_eq1⟩
  · have hi : nextGen 5 = (nextGen 2)⁻¹ := nextInvProof 2
    exact hi.symm ▸ subgroup.inv_mem ⟨nextWord 2, next_eq2⟩

private theorem next_le : nextSubgroup ≤ subgroup :=
  wordSubgroup_le_of_gen_mem next_mem

