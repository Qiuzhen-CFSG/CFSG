  · exact Equiv.ext step1_point27

private theorem step2 (r : Fin 28) :
    gen 2 * rep r = rep (act 2 r) * evalWord nextGen (factor 2 r) := by
  have ha : ∀ r, act 0 (act 2 r) = r := by decide +kernel
  have hf : ∀ r, factor 2 r = (factor 0 (act 2 r)).reverse.map nextInv := by
    decide +kernel
  have hi : gen 2 = (gen 0)⁻¹ := gen_inv 0
  have h := reverse_step (step0 (act 2 r))
  rw [ha] at h
  rw [hi, hf, evalWord_reverse_map_inv nextGen nextInv nextInvProof]
  exact h

private theorem step3 (r : Fin 28) :
    gen 3 * rep r = rep (act 3 r) * evalWord nextGen (factor 3 r) := by
  have ha : ∀ r, act 1 (act 3 r) = r := by decide +kernel
  have hf : ∀ r, factor 3 r = (factor 1 (act 3 r)).reverse.map nextInv := by
    decide +kernel
  have hi : gen 3 = (gen 1)⁻¹ := gen_inv 1
  have h := reverse_step (step1 (act 3 r))
  rw [ha] at h
  rw [hi, hf, evalWord_reverse_map_inv nextGen nextInv nextInvProof]
  exact h

private theorem step (i : Fin 4) (r : Fin 28) :
    gen i * rep r = rep (act i r) * evalWord nextGen (factor i r) := by
  fin_cases i
  · exact step0 r
  · exact step1 r
  · exact step2 r
  · exact step3 r

/-- The certified index of this stabilizer-chain step. -/
public theorem card_step : Nat.card subgroup = 28 * Nat.card nextSubgroup := by
  apply wordSubgroup_card_eq_mul_next gen invOf gen_inv nextGen nextInv nextInvProof
    rep act factor base point 0
  · intro r
    exact ⟨repWord r, rfl⟩
  · exact next_le
  · rfl
  · decide +kernel
  · decide +kernel
  · apply wordSubgroup_fix_of_gen_fix
    decide +kernel
  · exact step

end Rudvalis.SylowOvergroups.LocalCardinality.Max4.L0
