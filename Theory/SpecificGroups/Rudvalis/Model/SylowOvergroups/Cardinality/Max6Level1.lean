  · exact ⟨nextWord 0, next_eq0⟩
  · exact ⟨nextWord 1, next_eq1⟩
  · exact ⟨nextWord 2, next_eq2⟩
  · have hi : nextGen 3 = (nextGen 0)⁻¹ := nextInvProof 0
