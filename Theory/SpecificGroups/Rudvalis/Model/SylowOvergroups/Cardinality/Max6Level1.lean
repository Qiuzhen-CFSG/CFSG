    exact hi.symm ▸ subgroup.inv_mem ⟨nextWord 1, next_eq1⟩
  · have hi : nextGen 5 = (nextGen 2)⁻¹ := nextInvProof 2
    exact hi.symm ▸ subgroup.inv_mem ⟨nextWord 2, next_eq2⟩

