  have hf : ∀ r, factor 3 r = (factor 0 (act 3 r)).reverse.map nextInv := by
    decide +kernel
  have hi : gen 3 = (gen 0)⁻¹ := gen_inv 0
  have h := reverse_step (step0 (act 3 r))
  rw [ha] at h
  rw [hi, hf, evalWord_reverse_map_inv nextGen nextInv nextInvProof]
  exact h

