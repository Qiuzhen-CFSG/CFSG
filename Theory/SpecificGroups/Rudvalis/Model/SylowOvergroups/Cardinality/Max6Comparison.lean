module

public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.Cardinality.Max6Level0Data

/-!
# Comparison of the sixth local subgroup with the ATLAS words

Three packed intermediate permutations avoid expanding the long second ATLAS
word at every point. Their inverse laws and their expressions in the original
generators are all checked by kernel reduction. The final algebraic substitution
identifies the tables with the unchanged subgroup definition in `Model`.

Source: the ATLAS `RuG1-max6W1` program retained in `SylowOvergroups/source/`;
see the attribution in `SylowOvergroups.Definitions`. `GenerateComparison.py`
only emits witnesses from the existing ATLAS point tables.
-/

namespace Rudvalis.SylowOvergroups.LocalCardinality.Max6
open Theory.GroupTheory
set_option Elab.async false

private def conjugatePacked : Nat := 

private def conjugateMap (x : Fin 4060) : Fin 4060 :=
  ⟨(conjugatePacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private def conjugateInvPacked : Nat := 

private def conjugateInvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(conjugateInvPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 30000 in
private theorem conjugate_left : ∀ x, conjugateInvMap (conjugateMap x) = x := by
  apply Rudvalis.Data.allFin
  decide +kernel

private def conjugate : Equiv.Perm (Fin 4060) :=
  tablePerm conjugateMap conjugateInvMap conjugate_left
    (rightInverse_of_leftInverse_fin conjugate_left)

private def squarePacked : Nat := 

private def squareMap (x : Fin 4060) : Fin 4060 :=
  ⟨(squarePacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private def squareInvPacked : Nat := 

private def squareInvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(squareInvPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 30000 in
private theorem square_left : ∀ x, squareInvMap (squareMap x) = x := by
  apply Rudvalis.Data.allFin
  decide +kernel

private def square : Equiv.Perm (Fin 4060) :=
  tablePerm squareMap squareInvMap square_left
    (rightInverse_of_leftInverse_fin square_left)

private def tenthPacked : Nat := 

private def tenthMap (x : Fin 4060) : Fin 4060 :=
  ⟨(tenthPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private def tenthInvPacked : Nat := 

private def tenthInvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(tenthInvPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 30000 in
private theorem tenth_left : ∀ x, tenthInvMap (tenthMap x) = x := by
  apply Rudvalis.Data.allFin
  decide +kernel

private def tenth : Equiv.Perm (Fin 4060) :=
  tablePerm tenthMap tenthInvMap tenth_left
    (rightInverse_of_leftInverse_fin tenth_left)

set_option maxRecDepth 30000 in
public theorem generator0_eq : L0.gen 0 =
    modelSubgroup.subtype max6Generators.1 := by
  apply Equiv.ext
  apply Rudvalis.Data.allFin
  decide +kernel

set_option maxRecDepth 30000 in
private theorem conjugate_eq : conjugate =
    let r3 := aPerm * bPerm
    let r4 := r3 * bPerm
    let r5 := r3 * r4
    (r5⁻¹ * aPerm) * r5 := by
  apply Equiv.ext
  apply Rudvalis.Data.allFin
  decide +kernel

set_option maxRecDepth 30000 in
private theorem square_eq : square =
    let r3 := aPerm * bPerm
    let r4 := r3 * bPerm
    let r5 := r3 * r4
    let r6 := r3 * r5
    let r7 := r6 * r3
    r7 * r7 := by
  apply Equiv.ext
  apply Rudvalis.Data.allFin
  decide +kernel

set_option maxRecDepth 30000 in
private theorem tenth_eq : tenth = (L0.gen 0) ^ 10 := by
  apply Equiv.ext
  apply Rudvalis.Data.allFin
  decide +kernel

set_option maxRecDepth 30000 in
private theorem generator1_cached : L0.gen 1 =
    (tenth * conjugate) ^ 6 * (tenth * ((square⁻¹ * conjugate) * square)) ^ 4 := by
  apply Equiv.ext
  apply Rudvalis.Data.allFin
  decide +kernel

public theorem generator1_eq : L0.gen 1 =
    modelSubgroup.subtype max6Generators.2 := by
  rw [generator1_cached, tenth_eq, generator0_eq, conjugate_eq, square_eq]
  rfl

end Rudvalis.SylowOvergroups.LocalCardinality.Max6
