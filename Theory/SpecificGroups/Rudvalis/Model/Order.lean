module

public import Theory.SpecificGroups.Rudvalis.Model.Basic
public import Theory.SpecificGroups.Rudvalis.Model.OrderLevel0
public import Theory.SpecificGroups.Rudvalis.Model.OrderLevel1
public import Theory.SpecificGroups.Rudvalis.Model.OrderLevel2
public import Theory.SpecificGroups.Rudvalis.Model.OrderTail

/-!
# Cardinality of the explicit Rudvalis model

The subgroup chain starts at the subgroup generated by the ATLAS permutations
and terminates in the certified subgroup of order 20. The kernel-checked
transition certificates give successive indices 4060, 1755, and 1024.
Multiplying these indices by 20 proves that the model has order 145926144000.
Source: the degree-4060 ATLAS generators cited in `Model.Basic`.
-/

namespace Rudvalis

/-- The remaining three chain steps suffice to certify the model order. -/
public theorem model_card_of_chain_steps
    (h0 : Nat.card OrderCertificate.H0 = 4060 * Nat.card OrderCertificate.H1)
    (h1 : Nat.card OrderCertificate.H1 = 1755 * Nat.card OrderCertificate.H2)
    (h2 : Nat.card OrderCertificate.H2 = 1024 * Nat.card OrderCertificate.H3) :
    Nat.card Model = 145926144000 := by
  change Nat.card modelSubgroup = 145926144000
  rw [← OrderCertificate.H0_eq_model, h0, h1, h2, OrderCertificate.H3_card]

/-- The order of the concrete group generated by the ATLAS permutations. -/
public theorem model_card : Nat.card Model = 145926144000 :=
  model_card_of_chain_steps OrderCertificate.H0_card_step
    OrderCertificate.H1_card_step OrderCertificate.H2_card_step

end Rudvalis
