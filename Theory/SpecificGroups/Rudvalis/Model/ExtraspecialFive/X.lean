module
public import Theory.SpecificGroups.Rudvalis.Model.ExtraspecialFive.Letters

/-!
# Certified Rudvalis five-local word x

Successive cached permutations evaluate eight original ATLAS letters at a time.
Each step checks its inverse and its multiplication on every one of the 4060
letters by kernel reduction. Membership follows along the same word chain.
This bounds peak memory without replacing any group identity by an assumption.

Source: the retained ATLAS RuG1-p4060B0 generators. `source/words.json` records
the word and `source/Generate.py` regenerates this file; see `source/README.md`.
-/

namespace Rudvalis.ExtraspecialFive
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option Elab.async false

@[expose] public def x0MapPacked : Nat := 
@[expose] public def x0Map (i : Fin 4060) : Fin 4060 :=
  ⟨(x0MapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def x0InvMapPacked : Nat := 
@[expose] public def x0InvMap (i : Fin 4060) : Fin 4060 :=
  ⟨(x0InvMapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem x0_left : ∀ i, x0InvMap (x0Map i) = i := by
  apply Data.allFin
  decide +kernel

@[expose] public def x0Perm : Equiv.Perm (Fin 4060) :=
  tablePerm x0Map x0InvMap (by exact x0_left) (by exact rightInverse_of_leftInverse_fin x0_left)

private theorem x0_step : x0Perm = evalWord permutationLetter [1, 2, 3, 2, 3, 2, 3, 2] := by
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

private theorem x0_mem : x0Perm ∈ modelSubgroup := by
  rw [x0_step, word_eq]
  exact (evalWord letter [1, 2, 3, 2, 3, 2, 3, 2]).property

@[expose] public def x0 : Model := ⟨x0Perm, by exact x0_mem⟩

