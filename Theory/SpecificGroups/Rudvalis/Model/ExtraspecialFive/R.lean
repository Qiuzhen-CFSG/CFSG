module
public import Theory.SpecificGroups.Rudvalis.Model.ExtraspecialFive.Letters

/-!
# Certified Rudvalis five-local word r

Successive cached permutations evaluate eight original ATLAS letters at a time.
Each step checks its inverse and its multiplication on every one of the 4060
letters by kernel reduction. Membership follows along the same word chain.
This bounds peak memory without replacing any group identity by an assumption.

Source: the retained ATLAS RuG1-p4060B0 generators. `source/words.json` records
the word and `source/Generate.py` regenerates this file; see `source/README.md`.
-/

namespace Rudvalis.ExtraspecialFive
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option Elab.async false

@[expose] public def r0MapPacked : Nat := 
@[expose] public def r0Map (i : Fin 4060) : Fin 4060 :=
  ⟨(r0MapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def r0InvMapPacked : Nat := 
@[expose] public def r0InvMap (i : Fin 4060) : Fin 4060 :=
  ⟨(r0InvMapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem r0_left : ∀ i, r0InvMap (r0Map i) = i := by
  apply Data.allFin
  decide +kernel

@[expose] public def r0Perm : Equiv.Perm (Fin 4060) :=
  tablePerm r0Map r0InvMap (by exact r0_left) (by exact rightInverse_of_leftInverse_fin r0_left)

private theorem r0_step : r0Perm = evalWord permutationLetter [0, 1, 0, 1, 0, 1, 0, 1] := by
  apply Equiv.ext
  change ∀ i, r0Map i = Data.aMap (Data.bMap (Data.aMap (Data.bMap (Data.aMap (Data.bMap (Data.aMap (Data.bMap (i))))))))
  apply Data.allFin
  decide +kernel

private theorem r0_mem : r0Perm ∈ modelSubgroup := by
  rw [r0_step, word_eq]
  exact (evalWord letter [0, 1, 0, 1, 0, 1, 0, 1]).property

@[expose] public def r0 : Model := ⟨r0Perm, by exact r0_mem⟩

