module
public import Theory.SpecificGroups.Rudvalis.Model.ExtraspecialFive.Letters

/-!
# Certified Rudvalis five-local word y

Successive cached permutations evaluate eight original ATLAS letters at a time.
Each step checks its inverse and its multiplication on every one of the 4060
letters by kernel reduction. Membership follows along the same word chain.
This bounds peak memory without replacing any group identity by an assumption.

Source: the retained ATLAS RuG1-p4060B0 generators. `source/words.json` records
the word and `source/Generate.py` regenerates this file; see `source/README.md`.
-/

namespace Rudvalis.ExtraspecialFive
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option Elab.async false

@[expose] public def y0MapPacked : Nat := 
@[expose] public def y0Map (i : Fin 4060) : Fin 4060 :=
  ⟨(y0MapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def y0InvMapPacked : Nat := 
@[expose] public def y0InvMap (i : Fin 4060) : Fin 4060 :=
  ⟨(y0InvMapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem y0_left : ∀ i, y0InvMap (y0Map i) = i := by
  apply Data.allFin
  decide +kernel

@[expose] public def y0Perm : Equiv.Perm (Fin 4060) :=
  tablePerm y0Map y0InvMap (by exact y0_left) (by exact rightInverse_of_leftInverse_fin y0_left)

private theorem y0_step : y0Perm = evalWord permutationLetter [2, 1, 2, 1, 2, 1, 2, 3] := by
  apply Equiv.ext
  change ∀ i, y0Map i = Data.aMap (Data.bMap (Data.aMap (Data.bMap (Data.aMap (Data.bMap (Data.aMap (Data.bMap (Data.bMap (Data.bMap (i))))))))))
  apply Data.allFin
  decide +kernel

private theorem y0_mem : y0Perm ∈ modelSubgroup := by
  rw [y0_step, word_eq]
  exact (evalWord letter [2, 1, 2, 1, 2, 1, 2, 3]).property

@[expose] public def y0 : Model := ⟨y0Perm, by exact y0_mem⟩

