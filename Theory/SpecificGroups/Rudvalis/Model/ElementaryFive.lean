module

public import Theory.SpecificGroups.Rudvalis.Model.ElementaryFive.Generators
public import Theory.GroupTheory.PrimeRankFixedJoin

/-!+# An elementary abelian subgroup of order 25 in the Rudvalis carrier

The two certified words in `ElementaryFive.Generators` commute, have order
five, and generate disjoint cyclic subgroups. Their join is therefore
elementary abelian of order 25. This is an intrinsic fact about the actual
degree-4060 ATLAS carrier, independent of its ambient order or simplicity.

Source: the ATLAS RuG1-p4060B0 generators, with attribution and retained
word discovery data in `ElementaryFive/Generators.lean` and its `source/`.
-/

namespace Rudvalis.ElementaryFive
open Subgroup

/-- The subgroup generated by the two independent five-elements. -/
@[expose] public def subgroup : Subgroup Model := zpowers x ⊔ zpowers y

/-- The explicit subgroup is elementary abelian of order 25. -/
public theorem subgroup_elementary_and_card :
    IsElementaryAbelian 5 subgroup ∧ Nat.card subgroup = 5 ^ 2 := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  let : IsElementaryAbelian 5 (zpowers x) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one x_fifth
  exact IsElementaryAbelian.fixed_join_card (n := 1)
    (zpowers x) y y_order
    ((zpowers x).disjoint_zpowers_of_prime_order_not_mem y y_order y_not_mem_x)
    (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr x_commute_y.eq))
    (by rw [Nat.card_zpowers, x_order]; norm_num)

/-- The explicit order-25 subgroup is a noncyclic five-group. -/
public theorem subgroup_pGroup_and_not_cyclic :
    IsPGroup 5 subgroup ∧ ¬ IsCyclic subgroup := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  obtain ⟨helem, hcard⟩ := subgroup_elementary_and_card
  let := helem
  exact ⟨IsElementaryAbelian.isPGroup 5 _,
    IsElementaryAbelian.not_isCyclic_of_card_eq_prime_sq hcard⟩

end Rudvalis.ElementaryFive
