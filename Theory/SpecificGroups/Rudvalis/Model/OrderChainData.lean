module

public import Theory.SpecificGroups.Rudvalis.Model.OrderCheck
import Mathlib.Tactic.FinCases

/-!
# The Rudvalis word-subgroup chain

The witnesses derive from the ATLAS degree-4060 generators stored in
`RuG1-p4060B0.g1` and `RuG1-p4060B0.g2` beside `Model.Basic`.
The inverse point convention preserves the order of word multiplication.
GAP is an untrusted witness generator; all asserted equalities are checked
by Lean's kernel. See `OrderCertificate/GenerateChain.g`.
Successive subgroups have explicit signed generators, with checked inclusion
and fixed-point witnesses. No assertion of a full stabilizer occurs here.
-/

namespace Rudvalis.OrderCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 1600000
set_option Elab.async false

@[expose] public def L0G0 : Equiv.Perm (Fin 4060) := aPerm

@[expose] public def L0G1 : Equiv.Perm (Fin 4060) := bPerm

@[expose] public def L0Gen : Fin 4 → Equiv.Perm (Fin 4060)
  | 0 => L0G0
  | 1 => L0G1
  | 2 => L0G0⁻¹
  | 3 => L0G1⁻¹

@[expose] public def L0Inv : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
  | 3 => 1

public theorem L0Inv_spec (i : Fin 4) : L0Gen (L0Inv i) = (L0Gen i)⁻¹ := by
  fin_cases i <;> simp only [L0Inv, L0Gen, inv_inv]

@[expose] public def H0 : Subgroup (Equiv.Perm (Fin 4060)) :=
  wordSubgroup L0Gen L0Inv L0Inv_spec

@[expose] public def L1G0MapPacked : Nat := 

@[expose] public def L1G0Map (x : Fin 4060) : Fin 4060 :=
  ⟨(L1G0MapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def L1G0InvMapPacked : Nat := 

@[expose] public def L1G0InvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(L1G0InvMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem L1G0_left : ∀ x, L1G0InvMap (L1G0Map x) = x := by
  apply Data.allFin
  decide +kernel

@[expose] public def L1G0 : Equiv.Perm (Fin 4060) :=
  tablePerm L1G0Map L1G0InvMap (by exact L1G0_left)
    (by exact rightInverse_of_leftInverse_fin L1G0_left)

@[expose] public def L1G1MapPacked : Nat := 

@[expose] public def L1G1Map (x : Fin 4060) : Fin 4060 :=
  ⟨(L1G1MapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def L1G1InvMapPacked : Nat := 

@[expose] public def L1G1InvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(L1G1InvMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem L1G1_left : ∀ x, L1G1InvMap (L1G1Map x) = x := by
  apply Data.allFin
  decide +kernel

@[expose] public def L1G1 : Equiv.Perm (Fin 4060) :=
  tablePerm L1G1Map L1G1InvMap (by exact L1G1_left)
    (by exact rightInverse_of_leftInverse_fin L1G1_left)

@[expose] public def L1Gen : Fin 4 → Equiv.Perm (Fin 4060)
  | 0 => L1G0
  | 1 => L1G1
  | 2 => L1G0⁻¹
  | 3 => L1G1⁻¹

@[expose] public def L1Inv : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
  | 3 => 1

public theorem L1Inv_spec (i : Fin 4) : L1Gen (L1Inv i) = (L1Gen i)⁻¹ := by
  fin_cases i <;> simp only [L1Inv, L1Gen, inv_inv]

@[expose] public def H1 : Subgroup (Equiv.Perm (Fin 4060)) :=
  wordSubgroup L1Gen L1Inv L1Inv_spec

@[expose] public def L1GenWordBlock0 (x : Fin 4) : List (Fin 4) :=
  (if x.val < 2 then (if x.val < 1 then unpackWord 3 315 5 else unpackWord 3 827090681 15) else (if x.val < 3 then unpackWord 3 283 5 else unpackWord 3 827123449 15))

@[expose] public def L1GenWord (x : Fin 4) : List (Fin 4) :=
  L1GenWordBlock0 x

private theorem L1G0_eq_word :
    L1Gen 0 = evalWord L0Gen (L1GenWord 0) := by
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

private theorem L1G1_eq_word :
    L1Gen 1 = evalWord L0Gen (L1GenWord 1) := by
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

public theorem L1Gen_eq_word (i : Fin 4) :
    L1Gen i = evalWord L0Gen (L1GenWord i) := by
  fin_cases i
  · exact L1G0_eq_word
  · exact L1G1_eq_word
  · change (L1Gen 0)⁻¹ = _
    rw [L1G0_eq_word]
    exact (evalWord_reverse_map_inv L0Gen L0Inv L0Inv_spec (L1GenWord 0)).symm
  · change (L1Gen 1)⁻¹ = _
    rw [L1G1_eq_word]
    exact (evalWord_reverse_map_inv L0Gen L0Inv L0Inv_spec (L1GenWord 1)).symm
public theorem H1_le : H1 ≤ H0 :=
  wordSubgroup_le_of_gen_mem (fun i => by
    rw [L1Gen_eq_word i]
    exact evalWord_mem_wordSubgroup L0Gen L0Inv L0Inv_spec _)

public theorem H1_fix : ∀ k : H1, (k : Equiv.Perm (Fin 4060)) 0 = 0 :=
  wordSubgroup_fix_of_gen_fix L1Gen L1Inv L1Inv_spec (by decide +kernel)

