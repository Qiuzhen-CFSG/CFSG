public theorem H0_eq_model : H0 = modelSubgroup := by
  apply le_antisymm
  · intro g hg
    obtain ⟨w, rfl⟩ := hg
    have hgen (i : Fin 4) : L0Gen i ∈ modelSubgroup := by
      fin_cases i <;> simp only [L0Gen, L0G0, L0G1]
      · exact aPerm_mem
      · exact bPerm_mem
      · exact modelSubgroup.inv_mem aPerm_mem
      · exact modelSubgroup.inv_mem bPerm_mem
    induction w with
    | nil => exact modelSubgroup.one_mem
    | cons i w ih => exact modelSubgroup.mul_mem (hgen i) ih
  · apply (Subgroup.closure_le H0).mpr
    intro g hg
    rcases hg with rfl | hg
    · exact ⟨[0], by simp [evalWord, L0Gen, L0G0]⟩
    · have hg' : g = bPerm := hg
      subst g
      exact ⟨[1], by simp [evalWord, L0Gen, L0G1]⟩

