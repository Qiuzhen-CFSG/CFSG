/-!
# Permutation tables for the ten Parrott generators

Generated by `Relations/source/generate.py` from the witnesses documented in
`TitsEmbedding.Words`. Source: Parrott (1972), §5, p.683, and GLS3 Table 5.3r,
p.279. All finite computations below are checked by Lean's kernel.
-/

namespace Rudvalis.OuterStabilizer.TitsEmbedding.RelationCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option Elab.async false

/- The maps have twelve-bit entries, in increasing point order. Seven
generators are involutions, so their forward tables also supply their inverses.
The remaining three have separate inverse tables. The inverse laws below
certify that each pair of tables defines a permutation. -/

@[expose] public def r1MapPacked : Nat := 

@[expose] public def r1Map (x : Fin 4060) : Fin 4060 :=
  ⟨(r1MapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

public theorem r1_left (x : Fin 4060) :
    r1Map (r1Map x) = x := by
  revert x
  apply OrderCertificate.allFin
  decide +kernel

@[expose] public def r1Perm : Equiv.Perm (Fin 4060) :=
  tablePerm r1Map r1Map r1_left
    (rightInverse_of_leftInverse_fin r1_left)

