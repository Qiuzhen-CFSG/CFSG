module

public import Theory.SpecificGroups.Rudvalis.Model.OuterStabilizer.TitsEmbedding.Words
public import Theory.SpecificGroups.Rudvalis.Model.OrderCheck
public import Mathlib.Tactic.FinCases

/-!
# Certified primitive letters for the Parrott words

Generated by `Relations/source/generate.py` from the witnesses documented in
`TitsEmbedding.Words`. Source: Parrott (1972), §5, p.683, and GLS3 Table 5.3r,
p.279. All finite computations below are checked by Lean's kernel.
-/

namespace Rudvalis.OuterStabilizer.TitsEmbedding.RelationCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option Elab.async false

@[expose] public def sInvMapPacked : Nat := 

@[expose] public def sInvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(sInvMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

public theorem s_left (x : Fin 4060) :
    sInvMap (PrimitiveData.sMap x) = x := by
  revert x
  apply OrderCertificate.allFin
  decide +kernel

@[expose] public def sPerm : Equiv.Perm (Fin 4060) :=
  tablePerm PrimitiveData.sMap sInvMap s_left
    (rightInverse_of_leftInverse_fin s_left)

private theorem sPerm_eq : sPerm = modelSubgroup.subtype PrimitiveData.s := by
  apply Equiv.ext
  exact PrimitiveData.sMap_eq

@[expose] public def tInvMapPacked : Nat := 

@[expose] public def tInvMap (x : Fin 4060) : Fin 4060 :=
  ⟨(tInvMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

public theorem t_left (x : Fin 4060) :
    tInvMap (PrimitiveData.tMap x) = x := by
  revert x
  apply OrderCertificate.allFin
  decide +kernel

@[expose] public def tPerm : Equiv.Perm (Fin 4060) :=
  tablePerm PrimitiveData.tMap tInvMap t_left
    (rightInverse_of_leftInverse_fin t_left)

private theorem tPerm_eq : tPerm = modelSubgroup.subtype PrimitiveData.t := by
  apply Equiv.ext
  exact PrimitiveData.tMap_eq

@[expose] public def permutationLetter : Fin 4 → Equiv.Perm (Fin 4060)
  | 0 => sPerm
  | 1 => tPerm
  | 2 => sPerm⁻¹
  | 3 => tPerm⁻¹

private theorem permutationLetter_eq (i : Fin 4) :
    permutationLetter i = modelSubgroup.subtype (letter i) := by
  fin_cases i
  · exact sPerm_eq
  · exact tPerm_eq
  · exact congrArg Inv.inv sPerm_eq
  · exact congrArg Inv.inv tPerm_eq

/-- Evaluation in the cached primitive permutations agrees with evaluation
in the actual Rudvalis carrier, for every word. -/
public theorem word_eq (w : List (Fin 4)) :
    evalWord permutationLetter w = modelSubgroup.subtype (evalWord letter w) := by
  induction w with
  | nil => exact (map_one modelSubgroup.subtype).symm
  | cons i w ih =>
    simp only [evalWord, permutationLetter_eq, ih]
    rfl

end Rudvalis.OuterStabilizer.TitsEmbedding.RelationCertificate
