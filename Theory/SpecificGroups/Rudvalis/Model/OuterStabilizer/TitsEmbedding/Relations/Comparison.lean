/-!
# The ten tables represent the published Rudvalis assignment

Generated by `Relations/source/generate.py` from the witnesses documented in
`TitsEmbedding.Words`. Source: Parrott (1972), §5, p.683, and GLS3 Table 5.3r,
p.279. All finite computations below are checked by Lean's kernel.
-/

namespace Rudvalis.OuterStabilizer.TitsEmbedding.RelationCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 2000000
set_option Elab.async false

/-- All ten cached permutations equal the corresponding elements of
the published assignment in the actual degree-4060 Rudvalis model. -/
public theorem permutation_eq (i : Tits.ParrottGenerator) :
    permutation i = modelSubgroup.subtype (assignment i) := by
  calc
    permutation i = evalWord permutationLetter (word i) := by
      cases i
      · exact r1_word
      · exact r8_word
      · exact s1_word
      · exact s2_word
      · exact s3_word
      · exact s4_word
      · exact s5_word
      · exact s6_word
      · exact s7_word
      · exact s8_word
    _ = modelSubgroup.subtype (assignment i) := word_eq (word i)

end Rudvalis.OuterStabilizer.TitsEmbedding.RelationCertificate
