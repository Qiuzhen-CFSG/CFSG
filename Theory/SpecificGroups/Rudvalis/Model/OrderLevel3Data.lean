module

public import Theory.SpecificGroups.Rudvalis.Model.OrderChainData
import Mathlib.Tactic.FinCases

/-!
# Level 3 witnesses for the Rudvalis order certificate

The witnesses derive from the ATLAS degree-4060 generators stored in
`RuG1-p4060B0.g1` and `RuG1-p4060B0.g2` beside `Model.Basic`.
The inverse point convention preserves the order of word multiplication.
GAP is an untrusted witness generator; all asserted equalities are checked
by Lean's kernel. See `OrderCertificate/GenerateChain.g`.
The 5 representatives are words in the level-3 generators.
Their distinct images of base point 3 are checked here. Transition words
are witness data only: their permutation identities are checked separately.
-/

namespace Rudvalis.OrderCertificate
open Theory.GroupTheory
set_option maxRecDepth 30000
set_option maxHeartbeats 1600000
set_option Elab.async false

@[expose] public def L3RepWordBlock0 (x : Fin 5) : List (Fin 4) :=
  (if x.val < 2 then (if x.val < 1 then [] else unpackWord 3 0 1) else (if x.val < 3 then unpackWord 3 1 1 else (if x.val < 4 then unpackWord 3 2 1 else unpackWord 3 3 1)))

@[expose] public def L3RepWord (x : Fin 5) : List (Fin 4) :=
  L3RepWordBlock0 x

@[expose] public def L3Rep (r : Fin 5) : Equiv.Perm (Fin 4060) :=
  evalWord L3Gen (L3RepWord r)

public theorem L3Rep_mem (r : Fin 5) : L3Rep r ∈ H3 :=
  evalWord_mem_wordSubgroup L3Gen L3Inv L3Inv_spec _

@[expose] public def L3PointPacked : Nat := 20194632658153475

@[expose] public def L3Point (x : Fin 5) : Fin 4060 :=
  ⟨(L3PointPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

@[expose] public def L3PointInvPacked : Nat := 

@[expose] public def L3PointInv (x : Fin 4060) : Fin 5 :=
  ⟨(L3PointInvPacked >>> (3 * x.val)) % 8 % 5, Nat.mod_lt _ (by decide)⟩

@[expose] public def L3Act0Packed : Nat := 12449

@[expose] public def L3Act0 (x : Fin 5) : Fin 5 :=
  ⟨(L3Act0Packed >>> (3 * x.val)) % 8 % 5, Nat.mod_lt _ (by decide)⟩

@[expose] public def L3Factor0Block0 (x : Fin 5) : List (Fin 2) :=
  (if x.val < 2 then (if x.val < 1 then [] else unpackWord 1 0 1) else (if x.val < 3 then unpackWord 1 0 1 else (if x.val < 4 then [] else unpackWord 1 1 1)))

@[expose] public def L3Factor0 (x : Fin 5) : List (Fin 2) :=
  L3Factor0Block0 x

@[expose] public def L3Act1Packed : Nat := 1634

@[expose] public def L3Act1 (x : Fin 5) : Fin 5 :=
  ⟨(L3Act1Packed >>> (3 * x.val)) % 8 % 5, Nat.mod_lt _ (by decide)⟩

@[expose] public def L3Factor1Block0 (x : Fin 5) : List (Fin 2) :=
  (if x.val < 2 then (if x.val < 1 then [] else unpackWord 1 1 1) else (if x.val < 3 then unpackWord 1 0 1 else (if x.val < 4 then unpackWord 1 1 1 else [])))

@[expose] public def L3Factor1 (x : Fin 5) : List (Fin 2) :=
  L3Factor1Block0 x

@[expose] public def L3Act2Packed : Nat := 6275

@[expose] public def L3Act2 (x : Fin 5) : Fin 5 :=
  ⟨(L3Act2Packed >>> (3 * x.val)) % 8 % 5, Nat.mod_lt _ (by decide)⟩

@[expose] public def L3Factor2Block0 (x : Fin 5) : List (Fin 2) :=
  (if x.val < 2 then (if x.val < 1 then [] else []) else (if x.val < 3 then unpackWord 1 1 1 else (if x.val < 4 then unpackWord 1 0 1 else unpackWord 1 1 1)))

@[expose] public def L3Factor2 (x : Fin 5) : List (Fin 2) :=
  L3Factor2Block0 x

@[expose] public def L3Act3Packed : Nat := 5652

@[expose] public def L3Act3 (x : Fin 5) : Fin 5 :=
  ⟨(L3Act3Packed >>> (3 * x.val)) % 8 % 5, Nat.mod_lt _ (by decide)⟩

@[expose] public def L3Factor3Block0 (x : Fin 5) : List (Fin 2) :=
  (if x.val < 2 then (if x.val < 1 then [] else unpackWord 1 1 1) else (if x.val < 3 then [] else (if x.val < 4 then unpackWord 1 0 1 else unpackWord 1 0 1)))

@[expose] public def L3Factor3 (x : Fin 5) : List (Fin 2) :=
  L3Factor3Block0 x

@[expose] public def L3Act : Fin 4 → Fin 5 → Fin 5
  | 0 => L3Act0
  | 1 => L3Act1
  | 2 => L3Act2
  | 3 => L3Act3

@[expose] public def L3Factor : Fin 4 → Fin 5 → List (Fin 2)
  | 0 => L3Factor0
  | 1 => L3Factor1
  | 2 => L3Factor2
  | 3 => L3Factor3

public theorem L3Rep_base : L3Rep 0 = 1 := rfl

public theorem L3Rep_point : ∀ r, L3Rep r 3 = L3Point r := by
  apply allFin
  decide +kernel

public theorem L3Point_injective : Function.Injective L3Point := by
  have h : ∀ r, L3PointInv (L3Point r) = r := by
    apply allFin
    decide +kernel
  exact Function.LeftInverse.injective h

end Rudvalis.OrderCertificate
