module

public import Theory.SpecificGroups.Rudvalis.Model.OrderLevel0Part6Nat
import Mathlib.Tactic.FinCases

/-!
# Packed natural-number evaluation for Rudvalis part-5 residual group 0

Packed generator tables avoid the branching cost of the small-table evaluator.
Each generator is compared on all 4060 points with the already certified tables;
induction on words then transfers twenty-point checks to the original transition.
Source: the ATLAS data in `PermutationData` and `OrderChainData`, documented in
`OrderCertificate/GenerateChain.g`. The inverse table is a witness only: its
comparison, like every numerical check here, is checked by Lean's kernel.
-/

namespace Rudvalis.OrderCertificate.ForwardReduction.Part5Residual.Residual0Checks
set_option maxRecDepth 30000
set_option Elab.async false

@[expose] public def bInvPacked : Nat := 

@[expose] public def gen0 : Fin 4 → Nat → Nat
  | 0, x => (Data.aMapPacked >>> (12*x)) % 4096 % 4060
  | 1, x => (Data.bMapPacked >>> (12*x)) % 4096 % 4060
  | 2, x => (Data.aMapPacked >>> (12*x)) % 4096 % 4060
  | 3, x => (bInvPacked >>> (12*x)) % 4096 % 4060

set_option maxHeartbeats 1600000 in
private theorem gen0_0 : ∀ x : Fin 4060,
    gen0 0 x.val = (Part6Tables.gen0 0 x).val := by
  apply allFin
  decide +kernel

set_option maxHeartbeats 1600000 in
private theorem gen0_1 : ∀ x : Fin 4060,
    gen0 1 x.val = (Part6Tables.gen0 1 x).val := by
  apply allFin
  decide +kernel

set_option maxHeartbeats 1600000 in
private theorem gen0_2 : ∀ x : Fin 4060,
    gen0 2 x.val = (Part6Tables.gen0 2 x).val := by
  apply allFin
  decide +kernel

set_option maxHeartbeats 1600000 in
private theorem gen0_3 : ∀ x : Fin 4060,
    gen0 3 x.val = (Part6Tables.gen0 3 x).val := by
  apply allFin
  decide +kernel

private theorem gen0_eq (i : Fin 4) (x : Fin 4060) :
    gen0 i x.val = (Part6Tables.gen0 i x).val := by
  fin_cases i
  · exact gen0_0 x
  · exact gen0_1 x
  · exact gen0_2 x
  · exact gen0_3 x

@[expose] public def gen1 : Fin 4 → Nat → Nat
  | 0, x => (L1G0MapPacked >>> (12*x)) % 4096 % 4060
  | 1, x => (L1G1MapPacked >>> (12*x)) % 4096 % 4060
  | 2, x => (L1G0InvMapPacked >>> (12*x)) % 4096 % 4060
  | 3, x => (L1G1InvMapPacked >>> (12*x)) % 4096 % 4060

set_option maxHeartbeats 1600000 in
private theorem gen1_0 : ∀ x : Fin 4060,
    gen1 0 x.val = (Part6Tables.gen1 0 x).val := by
  apply allFin
  decide +kernel

set_option maxHeartbeats 1600000 in
private theorem gen1_1 : ∀ x : Fin 4060,
    gen1 1 x.val = (Part6Tables.gen1 1 x).val := by
  apply allFin
  decide +kernel

set_option maxHeartbeats 1600000 in
private theorem gen1_2 : ∀ x : Fin 4060,
    gen1 2 x.val = (Part6Tables.gen1 2 x).val := by
  apply allFin
  decide +kernel

set_option maxHeartbeats 1600000 in
private theorem gen1_3 : ∀ x : Fin 4060,
    gen1 3 x.val = (Part6Tables.gen1 3 x).val := by
  apply allFin
  decide +kernel

private theorem gen1_eq (i : Fin 4) (x : Fin 4060) :
    gen1 i x.val = (Part6Tables.gen1 i x).val := by
  fin_cases i
  · exact gen1_0 x
  · exact gen1_1 x
  · exact gen1_2 x
  · exact gen1_3 x

private theorem force_eq (f : Nat → Nat) (n : Nat) : Part6Nat.force f n = f n := by
  cases n <;> rfl

private theorem eval_eq (g : Fin 4 → Nat → Nat)
    (G : Fin 4 → Fin 4060 → Fin 4060) (h : ∀ i x, g i x.val = (G i x).val)
    (w : List (Fin 4)) (x : Fin 4060) :
    Part6Nat.eval g w x.val = (Part6Tables.eval G w x).val := by
  induction w with
  | nil => rfl
  | cons i w ih =>
    simpa only [Part6Nat.eval, force_eq, Part6Tables.eval, ih] using h i (Part6Tables.eval G w x)

@[expose] public def slice (i : Fin 2) (u v w : List (Fin 4)) (c : Fin 203) : Bool :=
  checkFin (fun x : Fin 20 => decide
    (gen0 (i.castLE (by decide)) (Part6Nat.eval gen0 u (20*c.val+x.val)) =
      Part6Nat.eval gen0 v (Part6Nat.eval gen1 w (20*c.val+x.val))))

/-- Checked expanded words and all slices recover the exact source transition. -/
public theorem ofWords (i : Fin 2) (r : Fin 4060) (u v w : List (Fin 4))
    (hu : L0RepWord r = u)
    (hv : L0RepWord (L0Act (i.castLE (by decide)) r) = v)
    (hw : L0Factor (i.castLE (by decide)) r = w)
    (h : ∀ c : Fin 203, slice i u v w c = true) : stepCheck i r := by
  have ht : Part6Tables.check i r = true := by
    apply (checkFin_spec _).mpr
    intro x
    have hx := (checkFin_spec _).mp (h ⟨x.val / 20, by omega⟩) ⟨x.val % 20, by omega⟩
    change decide (gen0 (i.castLE (by decide))
      (Part6Nat.eval gen0 u (20*(x.val/20)+x.val%20)) =
      Part6Nat.eval gen0 v (Part6Nat.eval gen1 w (20*(x.val/20)+x.val%20))) = true at hx
    have hxval : 20*(x.val/20)+x.val%20 = x.val := by omega
    rw [hxval] at hx
    simp only [decide_eq_true_eq] at hx ⊢
    apply Fin.ext
    simpa only [hu, hv, hw, eval_eq _ _ gen0_eq, eval_eq _ _ gen1_eq, gen0_eq] using hx
  right
  apply (checkFin_spec _).mpr
  intro x
  simpa only [decide_eq_true_eq] using
    congrArg (fun p : Equiv.Perm (Fin 4060) => p x) (Part6Tables.ofCheck i r ht)

end Rudvalis.OrderCertificate.ForwardReduction.Part5Residual.Residual0Checks
