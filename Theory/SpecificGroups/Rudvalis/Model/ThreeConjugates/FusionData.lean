@[expose] public def entry (n : Fin 16384) : Nat :=
  (forestData[n.val / 64]! >>> (25 * (n.val % 64))) % 2^25

@[expose] public def parent (n : Fin 16384) : Fin 16384 :=
  ⟨entry n % 16384, Nat.mod_lt _ (by decide)⟩

@[expose] public def letter (n : Fin 16384) : Fin 14 :=
  ⟨(entry n >>> 14) % 16 % 14, Nat.mod_lt _ (by decide)⟩

@[expose] public def height (n : Fin 16384) : Nat :=
  (entry n >>> 18) % 16

@[expose] public def obstruction (n : Fin 16384) : Fin 4060 :=
  ⟨(entry n >>> 22) % 8, (Nat.mod_lt _ (by decide)).trans (by decide)⟩

@[expose] public def roots : List (Fin 16384) :=
  [1, 2, 4, 12, 36, 64, 126, 152, 192, 256, 294, 1536, 2048, 6144, 10240]

/-- Each entry either excludes an involution or supplies a strictly descending
conjugacy step. The point equations are interpreted only for actual model elements. -/
@[expose] public def Test (n : Fin 16384) : Prop :=
  n = 0 ∨ normalMap n (normalMap n (obstruction n)) ≠ obstruction n ∨
    n ∈ roots ∨ (height (parent n) < height n ∧ ∀ i : Fin 5,
      normalMap n (generatorMap (letter n) (i.castLE (by decide))) =
        generatorMap (letter n) (normalMap (parent n) (i.castLE (by decide))))

public instance (n : Fin 16384) : Decidable (Test n) :=
  inferInstanceAs (Decidable (_ ∨ _ ∨ _ ∨ _))

@[expose] public def checkBlock (b : Nat) : Bool :=
  Data.checkNat (fun k => decide
    (Test ⟨(64*b+k) % 16384, Nat.mod_lt _ (by decide)⟩)) 64

end Rudvalis.ThreeConjugates.FusionCertificate
