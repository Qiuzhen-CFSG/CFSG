module
public import Theory.SpecificGroups.Rudvalis.Model.SylowInvariantPair.Definitions
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.RadicalCoverage.LocalCover.ElementaryCatalogue
public import Theory.ElementaryAbelian.BinaryExpansion


/-!
# Large elementary subgroups in Rudvalis have even-index normalizers

The checked catalogue of elementary subgroups normal in the fixed Sylow has
six rows, each generated by at most five involutions. Binary expansion bounds
each elementary row by 32. Sylow conjugacy transports this bound to every
ambient Sylow. Consequently an elementary subgroup of order greater than 32
cannot have an odd-index normalizer: a Sylow of such a normalizer would be
ambient Sylow and normalize the subgroup.

This is a boundary needed for the native binary-three inspection in
Aschbacher–Smith 4.4.3, printed pp.622–623 of `refs/quasithin.pdf`. The actual
natural-dual orbit has order 64, so the existing odd-index Sylow-overgroup
cover cannot discharge its native local alternative. This does not assert
that the full source configuration exists or exclude it. The finite Sylow
and catalogue certificates are reused, with their original ATLAS attribution
and carrier; no new finite enumeration is performed.
-/

public section

open Subgroup
open scoped IsMulCommutative
namespace Rudvalis.BinaryThreeModules
open SylowOvergroups RadicalCoverage.LocalCover
attribute [local irreducible] elementaryGenerator

private theorem generated_card_le {H : Type*} [Group H] [Finite H]
    [IsElementaryAbelian 2 H] (g : Fin 5 → H)
    (hg : closure (Set.range g) = ⊤) : Nat.card H ≤ 32 := by
  classical
  let f : (Fin 5 → Bool) → H := fun b => ∏ i, if b i then g i else 1
  have hf : Function.Surjective f := by
    intro x
    have hs (i : Fin 5) : g i * g i = 1 := by
      simpa only [pow_two] using Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 H) (g i)
    obtain ⟨b,hb⟩ := Theory.GroupTheory.exists_bool_prod_of_mem_closure_range g hs
      (show x ∈ closure (Set.range g) by rw [hg]; trivial)
    exact ⟨b,hb.symm⟩
  simpa using Nat.card_le_card_of_surjective f hf

private def generators : Fin 6 → Fin 5 → Model :=
  let c := elementaryGenerator
  ![![c 0,c 0,c 0,c 0,c 0], ![c 0,c 1,c 1,c 1,c 1],
    ![c 0,c 1,c 2,c 2,c 2], ![c 0,c 1,c 2,c 3,c 3],
    ![c 0,c 1,c 2,c 3,c 4], ![c 0,c 1,c 2,c 3,c 5]]

private theorem generators_closure (i : Fin 6) :
    closure (Set.range (generators i)) = elementary i := by
  fin_cases i <;> simp [generators,elementary]
  all_goals
    apply congrArg (closure (G := Model))
    apply Set.ext
    intro x
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff]
    tauto

private theorem catalogue_card_le (i : Fin 6) [IsElementaryAbelian 2 (elementary i)] :
    Nat.card (elementary i) ≤ 32 := by
  let g : Fin 5 → elementary i := fun j =>
    ⟨generators i j,generators_closure i ▸ subset_closure ⟨j,rfl⟩⟩
  apply generated_card_le g
  apply map_injective (elementary i).subtype_injective
  rw [MonoidHom.map_closure,←Set.range_comp,←MonoidHom.range_eq_map,range_subtype]
  exact generators_closure i

/-- Every elementary subgroup normalized by an ambient Sylow has order at most 32. -/
theorem sylow_normalized_elementary_card_le (S : Sylow 2 Model)
    (W : Subgroup Model) [IsElementaryAbelian 2 W]
    (hn : (S : Subgroup Model) ≤ normalizer (W : Set Model)) : Nat.card W ≤ 32 := by
  by_cases hW : W = ⊥
  · simp [hW]
  have hWS : W ≤ S := by
    have hh := S.is_maximal' (S.isPGroup'.to_sup_of_normal_right'
      (IsElementaryAbelian.isPGroup 2 W) hn) le_sup_left
    exact sup_eq_left.mp hh
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq Model S SylowInvariantPair.sylow
  let e := MulAut.conj g
  let U := W.map e.toMonoidHom
  have hUP : U ≤ localP := by
    have hh := map_mono (f := e.toMonoidHom) hWS
    change W.map e.toMonoidHom ≤ (g • S : Sylow 2 Model) at hh
    rw [hg] at hh
    exact hh
  have hPU : localP ≤ normalizer (U : Set Model) := by
    have hh := (map_mono (f := e.toMonoidHom) hn).trans (le_normalizer_map e.toMonoidHom)
    change ((g • S : Sylow 2 Model) : Subgroup Model) ≤ _ at hh
    rw [hg] at hh
    exact hh
  have hUne : U ≠ ⊥ := fun hh => hW ((W.map_eq_bot_iff_of_injective e.injective).mp hh)
  let : IsElementaryAbelian 2 U := IsElementaryAbelian.map e.toMonoidHom
  obtain ⟨i,hi⟩ := elementaryCatalogue U hUne hUP hPU inferInstance
  have hei : IsElementaryAbelian 2 (elementary i) := hi ▸ inferInstance
  have hb := @catalogue_card_le i hei
  rw [←hi,show Nat.card U = Nat.card W from card_map_of_injective e.injective] at hb
  exact hb

/-- A larger elementary subgroup has normalizer of even index in the actual model. -/
theorem elementary_normalizer_even_index (W : Subgroup Model)
    [IsElementaryAbelian 2 W] (hcard : 32 < Nat.card W) :
    2 ∣ (normalizer (W : Set Model)).index := by
  by_contra hn
  let N := normalizer (W : Set Model)
  let S : Sylow 2 N := Sylow.nonempty.some
  have hi : ¬ 2 ∣ ((S : Subgroup N).map N.subtype).index := by
    rw [index_map_subtype]
    exact Nat.prime_two.not_dvd_mul S.not_dvd_index hn
  let P : Sylow 2 Model := (S.isPGroup'.map N.subtype).toSylow hi
  have hb := sylow_normalized_elementary_card_le P W (map_subtype_le _)
  omega

end Rudvalis.BinaryThreeModules
