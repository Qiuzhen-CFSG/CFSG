module

public import Theory.SpecificGroups.Rudvalis.Model.SylowInvariantPair
public import Theory.SpecificGroups.Rudvalis.Model.LowCentralizers
public import Theory.SpecificGroups.Rudvalis.Model.DirectDisplacementWords
public import Theory.SpecificGroups.Rudvalis.Model.ThreeConjugates.Fusion
public import Theory.SpecificGroups.Rudvalis.Model.OuterStabilizer.TitsEmbedding
public import Theory.SpecificGroups.Tits.MarkedStrongClosure

/-!+# Noncommuting returning conjugates of the central Rudvalis involution

The actual marked Sylow has center generated by elementaryGenerator 0.
Two certified conjugator alignments place that generator in the class of
b². Thus every original Sylow-central involution belongs to this class.

The actual point stabilizer contains the simple Tits group. Its proved
noncommuting pair lies in one two-subgroup, and both involutions fix a point
in the degree-4060 action. Neither can belong to the fixed-point-free class
of a, so both belong to the b² class. Embedding the two-subgroup in an
ambient Sylow and conjugating that Sylow transports the pair to any supplied
Sylow subgroup. The two Rudvalis involution classes remain distinct.

Source: Aschbacher--Smith 1.1.5(3)(f), pp.501--503, and Proposition 2.2.2,
pp.519--520, combined 1 March 2004 manuscript. The imported certificates
retain the original ATLAS permutations and the actual Tits presentation.
-/

public section
open Subgroup
open scoped Pointwise
namespace Rudvalis.MarkedStrongClosure
open SylowOvergroups.RadicalCoverage.LocalCover

/-- The original central marker belongs to the b² class. No assertion is
made about arbitrary noncentral involutions in the supplied Sylow. -/
theorem sylow_central_isConj_b_sq (R : Sylow 2 Model) (v : Model)
    (hvR : v ∈ R) (hv : orderOf v = 2)
    (hc : ∀ x ∈ R, Commute v x) : IsConj v (Rudvalis.b ^ 2) := by
  classical
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq Model R SylowInvariantPair.sylow
  let e := MulAut.conj g
  have hm : (R : Subgroup Model).map e.toMonoidHom = localP := by
    have hh := congrArg Sylow.toSubgroup hg
    rw [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def] at hh
    exact hh
  have hmem : e v ∈ (center localP).map localP.subtype := by
    have heR : e v ∈ localP := by
      rw [← hm]
      exact mem_map_of_mem e.toMonoidHom hvR
    refine mem_map.mpr ⟨⟨e v, heR⟩, ?_, rfl⟩
    apply mem_center_iff.mpr
    intro x
    apply Subtype.ext
    have hx : (x : Model) ∈ (R : Subgroup Model).map e.toMonoidHom :=
      hm.symm ▸ x.property
    obtain ⟨y, hy, he⟩ := mem_map.mp hx
    change (x : Model) * e v = e v * (x : Model)
    rw [← he]
    exact ((hc y hy).symm.map e.toMonoidHom).eq
  rw [← SylowInvariantPair.elementary_zero_eq_center] at hmem
  change e v ∈ closure {elementaryGenerator 0} at hmem
  rw [← zpowers_eq_closure, mem_zpowers_iff_mem_range_orderOf,
    Max6Certificate.elementary_zero_order] at hmem
  have hne : e v ≠ 1 := by
    intro he
    have ho := (e.orderOf_eq v).trans hv
    rw [he, orderOf_one] at ho
    norm_num at ho
  obtain ⟨n, hn, heq⟩ := Finset.mem_image.mp hmem
  have hn2 := Finset.mem_range.mp hn
  have hmark : e v = elementaryGenerator 0 := by
    interval_cases n
    · exact (hne (by simpa using heq.symm)).elim
    · simpa using heq.symm
  have hvmark : IsConj v (elementaryGenerator 0) :=
    isConj_iff.mpr ⟨g, hmark⟩
  have hlocal : IsConj Max6Certificate.centralInvolution (elementaryGenerator 0) :=
    isConj_iff.mpr ⟨Max6Certificate.conjugator, Max6Certificate.conjugator_alignment⟩
  have hsquare : IsConj Max6Certificate.centralInvolution (Rudvalis.b ^ 2) :=
    isConj_iff.mpr ⟨LowCentralizers.squareConjugator,
      LowCentralizers.squareConjugator_alignment⟩
  exact hvmark.trans (hlocal.symm.trans hsquare)

/-- A point fixed by an involution excludes the separate class of a. -/
theorem fixed_point_involution_isConj_b_sq (v : Model) (hv : orderOf v = 2)
    (i : Fin 4060) (hfix : v • i = i) : IsConj v (Rudvalis.b ^ 2) := by
  rcases involution_isConj_a_or_b_sq v hv with h | h
  · obtain ⟨g, hg⟩ := isConj_iff.mp h
    exact (DirectDisplacementWords.a_no_fixed_point (g • i)) (by
      rw [← hg]
      simp only [mul_smul, inv_smul_smul, hfix]) |>.elim
  · exact h

private theorem base_pair :
    ∃ Q : Sylow 2 Model, ∃ x y : Q,
      IsConj (Rudvalis.b ^ 2) (x : Model) ∧
      IsConj (Rudvalis.b ^ 2) (y : Model) ∧ ¬Commute x y := by
  have hroot : Tits.InvolutionRootGeometry.IsLongRoot (Tits.parrottGenerator .s1) :=
    (Tits.InvolutionRootGeometry.isLongRoot_iff _).mpr (IsConj.refl _)
  obtain ⟨_, P, hs, hc⟩ :=
    (Tits.InvolutionRootGeometry.isLongRoot_iff_twoCentral _).mp hroot
  obtain ⟨x, y, hx, hy, hxy⟩ :=
    Tits.MarkedStrongClosure.sylow_noncommuting_conjugates P
      (Tits.parrottGenerator .s1) hs Tits.InvolutionRootGeometry.s1_order
      (fun z hz => (mem_centralizer_iff.mp hc z hz).symm)
  have ho (z : Tits.ParrottGroup) (hz : IsConj (Tits.parrottGenerator .s1) z) :
      orderOf z = 2 := by
    obtain ⟨g, hg⟩ := isConj_iff.mp hz
    rw [← hg]
    exact ((MulAut.conj g).orderOf_eq _).trans Tits.InvolutionRootGeometry.s1_order
  obtain ⟨K, hK, _, ⟨e⟩⟩ := outer_stabilizer_tits_subgroup
  let j : Tits.ParrottGroup ≃* K := Tits.parrottFiniteImageEquiv.trans e
  let ι : Tits.ParrottGroup →* Model := K.subtype.comp j.toMonoidHom
  have hi : Function.Injective ι := K.subtype_injective.comp j.injective
  obtain ⟨Q, hQ⟩ := (P.isPGroup'.map ι).exists_le_sylow
  have hmem (z : P) : ι (z : Tits.ParrottGroup) ∈ Q :=
    hQ (mem_map_of_mem ι z.property)
  have hclass (z : P) (hz : IsConj (Tits.parrottGenerator .s1) (z : Tits.ParrottGroup)) :
      IsConj (ι (z : Tits.ParrottGroup)) (Rudvalis.b ^ 2) :=
    fixed_point_involution_isConj_b_sq _
      ((orderOf_injective ι hi _).trans (ho z hz)) 0 (hK (j z).property)
  refine ⟨Q, ⟨ι x, hmem x⟩, ⟨ι y, hmem y⟩,
    (hclass x hx).symm, (hclass y hy).symm, ?_⟩
  intro h
  apply hxy
  have hh := h.map (Q : Subgroup Model).subtype
  change Commute (ι (x : Tits.ParrottGroup)) (ι (y : Tits.ParrottGroup)) at hh
  exact Subtype.ext (Commute.of_map hi hh).eq

/-- Every original Sylow-central Ru marker has two noncommuting returning
conjugates in its supplied Sylow, using the actual embedded Tits pair. -/
theorem sylow_noncommuting_conjugates (R : Sylow 2 Model) (v : Model)
    (hvR : v ∈ R) (hv : orderOf v = 2)
    (hc : ∀ x ∈ R, Commute v x) :
    ∃ x y : R, IsConj v (x : Model) ∧ IsConj v (y : Model) ∧ ¬Commute x y := by
  have hmarker := sylow_central_isConj_b_sq R v hvR hv hc
  obtain ⟨Q, x, y, hx, hy, hxy⟩ := base_pair
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq Model Q R
  let e := MulAut.conj g
  have hm : (Q : Subgroup Model).map e.toMonoidHom = (R : Subgroup Model) := by
    have hh := congrArg Sylow.toSubgroup hg
    rw [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def] at hh
    exact hh
  have hmem (z : Q) : e (z : Model) ∈ R := by
    change e (z : Model) ∈ (R : Subgroup Model)
    rw [← hm]
    exact mem_map_of_mem e.toMonoidHom z.property
  refine ⟨⟨e x, hmem x⟩, ⟨e y, hmem y⟩,
    hmarker.trans (hx.trans (isConj_iff.mpr ⟨g, rfl⟩)),
    hmarker.trans (hy.trans (isConj_iff.mpr ⟨g, rfl⟩)), ?_⟩
  intro h
  apply hxy
  have hh := h.map (R : Subgroup Model).subtype
  change Commute (e (x : Model)) (e (y : Model)) at hh
  exact Subtype.ext (Commute.of_map e.injective hh).eq

end Rudvalis.MarkedStrongClosure
