public theorem c2s3_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s3 (p x) = c2s3 x :=
  refine_preserved p hp c2s2 c2s3 c2s3Cell 129 2
    c2s3_nodup (fun x => (c2s3Facts_all x).1)
