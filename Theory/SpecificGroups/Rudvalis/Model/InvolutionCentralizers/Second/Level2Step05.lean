public theorem c2s5_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s5 (p x) = c2s5 x :=
  refine_preserved p hp c2s4 c2s5 c2s5Cell 19971 2
    c2s5_nodup (fun x => (c2s5Facts_all x).1)
    (fun x => ((c2s5Facts_all x).2).trans
      (congrArg (fun n => c2s4 x * 2 + n)
        (bitCount_eq c2s5Cell c2s5Rows c2s5_rows x)))
    (c2s4_preserved p hp ha hf)

