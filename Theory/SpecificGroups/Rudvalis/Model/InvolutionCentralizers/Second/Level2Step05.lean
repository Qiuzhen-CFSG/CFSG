private theorem c2s5_rows : c2s5Rows = c2s5Cell.map row := by decide +kernel

private theorem c2s5_nodup : c2s5Cell.Nodup := by decide +kernel

private def c2s5Facts (x : Fin 4060) : Prop :=
  (x ∈ c2s5Cell ↔ c2s4 x = 19971) ∧ c2s5 x = c2s4 x * 2 + bitCount c2s5Rows x

private instance (x : Fin 4060) : Decidable (c2s5Facts x) := inferInstanceAs (Decidable ((x ∈ c2s5Cell ↔ c2s4 x = 19971) ∧ c2s5 x = c2s4 x * 2 + bitCount c2s5Rows x))

