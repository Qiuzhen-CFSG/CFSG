public theorem c1s0_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 1 → p x = x) :
    ∀ x, c1s0 (p x) = c1s0 x :=
  refine_preserved p hp (seed 1) c1s0 c1s0Cell 5 2
    c1s0_nodup (fun x => (c1s0Facts_all x).1)
    (fun x => ((c1s0Facts_all x).2).trans
      (congrArg (fun n => (seed 1) x * 2 + n)
        (bitCount_eq c1s0Cell c1s0Rows c1s0_rows x)))
    (seed_preserved 1 p hp ha hf)

