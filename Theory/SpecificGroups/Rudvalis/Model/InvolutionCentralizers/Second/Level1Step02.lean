public theorem c1s2_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 1 → p x = x) :
    ∀ x, c1s2 (p x) = c1s2 x :=
  refine_preserved p hp c1s1 c1s2 c1s2Cell 47 365
    c1s2_nodup (fun x => (c1s2Facts_all x).1)
    (fun x => ((c1s2Facts_all x).2).trans
      (congrArg (fun n => c1s1 x * 365 + n)
        (bitCount_eq c1s2Cell c1s2Rows c1s2_rows x)))
    (c1s1_preserved p hp ha hf)

