private theorem c2s7_rows : c2s7Rows = c2s7Cell.map row := by decide +kernel

private theorem c2s7_nodup : c2s7Cell.Nodup := by decide +kernel

private def c2s7Facts (x : Fin 4060) : Prop :=
  (x ∈ c2s7Cell ↔ c2s6 x = 79586) ∧ c2s7 x = c2s6 x * 2 + bitCount c2s7Rows x

private instance (x : Fin 4060) : Decidable (c2s7Facts x) := inferInstanceAs (Decidable ((x ∈ c2s7Cell ↔ c2s6 x = 79586) ∧ c2s7 x = c2s6 x * 2 + bitCount c2s7Rows x))

