public theorem c2s7_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s7 (p x) = c2s7 x :=
  refine_preserved p hp c2s6 c2s7 c2s7Cell 79586 2
    c2s7_nodup (fun x => (c2s7Facts_all x).1)
    (fun x => ((c2s7Facts_all x).2).trans
      (congrArg (fun n => c2s6 x * 2 + n)
        (bitCount_eq c2s7Cell c2s7Rows c2s7_rows x)))
    (c2s6_preserved p hp ha hf)

