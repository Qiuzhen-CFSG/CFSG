public theorem c2s1_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s1 (p x) = c2s1 x :=
  refine_preserved p hp c2s0 c2s1 c2s1Cell 29 2
    c2s1_nodup (fun x => (c2s1Facts_all x).1)
    (fun x => ((c2s1Facts_all x).2).trans
      (congrArg (fun n => c2s0 x * 2 + n)
        (bitCount_eq c2s1Cell c2s1Rows c2s1_rows x)))
    (c2s0_preserved p hp ha hf)

