public theorem c1s4_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 1 → p x = x) :
    ∀ x, c1s4 (p x) = c1s4 x :=
  refine_preserved p hp c1s3 c1s4 c1s4Cell 145264 3
    c1s4_nodup (fun x => (c1s4Facts_all x).1)
    (fun x => ((c1s4Facts_all x).2).trans
      (congrArg (fun n => c1s3 x * 3 + n)
        (bitCount_eq c1s4Cell c1s4Rows c1s4_rows x)))
    (c1s3_preserved p hp ha hf)

