private def c1s4Facts (x : Fin 4060) : Prop :=
  (x ∈ c1s4Cell ↔ c1s3 x = 145264) ∧ c1s4 x = c1s3 x * 3 + bitCount c1s4Rows x

private instance (x : Fin 4060) : Decidable (c1s4Facts x) := inferInstanceAs (Decidable ((x ∈ c1s4Cell ↔ c1s3 x = 145264) ∧ c1s4 x = c1s3 x * 3 + bitCount c1s4Rows x))

