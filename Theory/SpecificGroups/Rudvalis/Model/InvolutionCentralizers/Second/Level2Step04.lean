public theorem c2s4_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s4 (p x) = c2s4 x :=
  refine_preserved p hp c2s3 c2s4 c2s4Cell 287 73
    c2s4_nodup (fun x => (c2s4Facts_all x).1)
    (fun x => ((c2s4Facts_all x).2).trans
      (congrArg (fun n => c2s3 x * 73 + n)
        (bitCount_eq c2s4Cell c2s4Rows c2s4_rows x)))
    (c2s3_preserved p hp ha hf)

