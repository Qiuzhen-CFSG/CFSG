public theorem c2s0_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, c2s0 (p x) = c2s0 x :=
  refine_preserved p hp (seed 2) c2s0 c2s0Cell 11 2
    c2s0_nodup (fun x => (c2s0Facts_all x).1)
    (fun x => ((c2s0Facts_all x).2).trans
      (congrArg (fun n => (seed 2) x * 2 + n)
        (bitCount_eq c2s0Cell c2s0Rows c2s0_rows x)))
    (seed_preserved 2 p hp ha hf)

