private theorem c2s6_rows : c2s6Rows = c2s6Cell.map row := by decide +kernel

private theorem c2s6_nodup : c2s6Cell.Nodup := by decide +kernel

private def c2s6Facts (x : Fin 4060) : Prop :=
  (x ∈ c2s6Cell ↔ c2s5 x = 39906) ∧ c2s6 x = c2s5 x * 2 + bitCount c2s6Rows x

private instance (x : Fin 4060) : Decidable (c2s6Facts x) := inferInstanceAs (Decidable ((x ∈ c2s6Cell ↔ c2s5 x = 39906) ∧ c2s6 x = c2s5 x * 2 + bitCount c2s6Rows x))

