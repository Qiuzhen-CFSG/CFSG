public theorem c1s3_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 1 → p x = x) :
    ∀ x, c1s3 (p x) = c1s3 x :=
  refine_preserved p hp c1s2 c1s3 c1s3Cell 10757 14
    c1s3_nodup (fun x => (c1s3Facts_all x).1)
    (fun x => ((c1s3Facts_all x).2).trans
      (congrArg (fun n => c1s2 x * 14 + n)
        (bitCount_eq c1s3Cell c1s3Rows c1s3_rows x)))
    (c1s2_preserved p hp ha hf)

