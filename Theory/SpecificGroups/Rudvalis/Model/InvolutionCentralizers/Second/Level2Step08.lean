private theorem c2s8_rows : c2s8Rows = c2s8Cell.map row := by decide +kernel

private theorem c2s8_nodup : c2s8Cell.Nodup := by decide +kernel

private def c2s8Facts (x : Fin 4060) : Prop :=
  (x ∈ c2s8Cell ↔ c2s7 x = 159090) ∧ c2s8 x = c2s7 x * 2 + bitCount c2s8Rows x

private instance (x : Fin 4060) : Decidable (c2s8Facts x) := inferInstanceAs (Decidable ((x ∈ c2s8Cell ↔ c2s7 x = 159090) ∧ c2s8 x = c2s7 x * 2 + bitCount c2s8Rows x))

