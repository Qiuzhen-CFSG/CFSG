public theorem c1s5_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 1 → p x = x) :
    ∀ x, c1s5 (p x) = c1s5 x :=
  refine_preserved p hp c1s4 c1s5 c1s5Cell 435829 14
    c1s5_nodup (fun x => (c1s5Facts_all x).1)
    (fun x => ((c1s5Facts_all x).2).trans
      (congrArg (fun n => c1s4 x * 14 + n)
        (bitCount_eq c1s5Cell c1s5Rows c1s5_rows x)))
    (c1s4_preserved p hp ha hf)

