public theorem c1s1_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (ha : ∀ x, p (aPerm x) = aPerm (p x))
    (hf : ∀ x : Fin 4060, x.val < 1 → p x = x) :
    ∀ x, c1s1 (p x) = c1s1 x :=
  refine_preserved p hp c1s0 c1s1 c1s1Cell 12 2
    c1s1_nodup (fun x => (c1s1Facts_all x).1)
    (fun x => ((c1s1Facts_all x).2).trans
      (congrArg (fun n => c1s0 x * 2 + n)
        (bitCount_eq c1s1Cell c1s1Rows c1s1_rows x)))
    (c1s0_preserved p hp ha hf)

