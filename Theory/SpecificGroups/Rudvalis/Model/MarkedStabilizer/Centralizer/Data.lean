module
public import Theory.SpecificGroups.Rudvalis.Model.OuterStabilizer.TitsEmbedding.Relations.Comparison
public import Theory.GroupAction.PackedPermutation.Literal
/-!
# Short centralizer witnesses for the Rudvalis point stabilizer

The ten retained Parrott images have orbits based at 0,1,6. The parent tree
and six short words below are untrusted data. The next certificate checks
all tree edges and the exact common fixed sets of the two triples of words.
Their permutation actions are the already checked original Rudvalis images.
Source: GLS3 Table 5.3r and Aschbacher--Smith J.5.1, pp.445--446.
-/
@[expose] public section
namespace Rudvalis.MarkedStabilizer.CentralizerCertificate
open OuterStabilizer.TitsEmbedding.RelationCertificate Theory.GroupTheory

def generator : Fin 10 → Tits.ParrottGenerator
  | 0 => .r1 | 1 => .r8 | 2 => .s1 | 3 => .s2 | 4 => .s3
  | 5 => .s4 | 6 => .s5 | 7 => .s6 | 8 => .s7 | 9 => .s8

def letter (i : Fin 20) : Equiv.Perm (Fin 4060) :=
  let p := permutation (generator ⟨i.val%10, Nat.mod_lt _ (by decide)⟩)
  if i.val<10 then p else p⁻¹
noncomputable def parentPacked : Nat := packed_nat% ""
noncomputable def labelPacked : Nat := packed_nat% ""
noncomputable def depthPacked : Nat := packed_nat% ""

noncomputable def parent (x : Fin 4060) : Fin 4060 :=
  ⟨(parentPacked >>> (12*x.val))%4096%4060, Nat.mod_lt _ (by decide)⟩
noncomputable def label (x : Fin 4060) : Fin 10 :=
  ⟨(labelPacked >>> (4*x.val))%16%10, Nat.mod_lt _ (by decide)⟩
noncomputable def depth (x : Fin 4060) : Nat := (depthPacked >>> (4*x.val))%16
def pins1 : Fin 3 → List (Fin 20)
  | 0 => [1]
  | 1 => [18, 11, 5, 8]
  | 2 => [19, 18, 5, 6, 0]
def pin1 (i : Fin 3) := evalWord letter (pins1 i)
def pins6 : Fin 3 → List (Fin 20)
  | 0 => [12, 3]
  | 1 => [12, 4, 5]
  | 2 => [10, 12, 1, 2, 0]
def pin6 (i : Fin 3) := evalWord letter (pins6 i)
end Rudvalis.MarkedStabilizer.CentralizerCertificate
