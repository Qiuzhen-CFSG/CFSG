/-- Each unwanted class has a square-one element failing to centralize its
centralizer. The identity is among these classes. -/
public theorem badChecked : ∀ r : Fin 16,
    r = 3 ∨ r = 4 ∨ r = 7 ∨ BadCheck r (badX r) (badY r) := by
  apply Rudvalis.OrderCertificate.allFin
  decide +kernel

