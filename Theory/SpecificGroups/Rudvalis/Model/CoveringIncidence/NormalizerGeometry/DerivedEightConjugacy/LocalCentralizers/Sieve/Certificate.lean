public theorem checkedBlock (b : Fin 16) : ∀ n : Fin 1024,
    RowCheck (blockIndex b n) (rowRep b n) (rowConj b n) := by
  fin_cases b
  · exact checked00
  · exact checked01
  · exact checked02
  · exact checked03
  · exact checked04
  · exact checked05
  · exact checked06
