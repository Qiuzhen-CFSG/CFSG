/-!
# Two-point decoder for the eleven fixed max4 words

Evaluate the words structurally using the existing fourteen coordinate maps.
The first point selects one of 512 rows; each row records four second-point
images with their eleven-bit product indices. Two comparisons select an entry.
These definitions assert no separation until `Separation.lean` checks the
decoder on every index, and no model identity until `Generation.lean` proves
the action bridge using `pcPermutation_eq` and `Max4Special.generator_eq`.

Generated by `source/Generate.py` from ElementaryCatalogue's existing data.
The Wilson--Nickerson--Bray ATLAS attribution and inverse point convention
are retained from LocalCover.Data; no SylowCertificate candidate is identified
with these words. Source application: GLS3 Table 5.3r, pp.291--292, and
Aschbacher--Smith I.2.2(7), printed pp.412--413.
-/

namespace Rudvalis.CoveringIncidence.Max4Special.Generation
open SylowOvergroups.RadicalCoverage.LocalCover.CatalogueCertificate

@[expose] public def wordMap (w : List (Fin 14)) (x : Fin 4060) : Fin 4060 :=
  w.foldr (fun i y => pcPermutation i y) x

@[expose] public def generatorMap (i : Fin 11) (x : Fin 4060) : Fin 4060 :=
  wordMap (word i) x

@[expose] public def binaryMap (n : Fin 2048) (x : Fin 4060) : Fin 4060 :=
  (List.ofFn (fun i : Fin 11 => i)).foldr
    (fun i y => (generatorMap i)^[n.val / 2 ^ i.val % 2] y) x

@[expose] public def rowData : Nat := 

@[expose] public def decoderData : Nat := 

@[expose] public def decoderEntry (row col : Nat) : Nat :=
  (decoderData >>> (23 * (4 * row + col))) % 8388608

@[expose] public def locate (row y : Nat) : Nat → Nat → Nat
  | 0, lo => lo
  | k + 1, lo =>
    let mid := lo + 2 ^ k
    locate row y k (if decoderEntry row mid >>> 11 ≤ y then mid else lo)

@[expose] public def decode (x y : Fin 4060) : Nat :=
  let row := (rowData >>> (9 * x.val)) % 512
  decoderEntry row (locate row y.val 2 0) % 2048

end Rudvalis.CoveringIncidence.Max4Special.Generation
