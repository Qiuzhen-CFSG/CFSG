/-!
# Checked-map data for max4 involution fusion

A forest on the 16384 local normal forms has fifteen roots. Twelve roots
centralize the marked eight-group; three have explicit ambient conjugators
to its first generator. Every other row has a square obstruction or a
descending conjugacy edge. The data below assert none of these obligations.

Source: Aschbacher--Smith J.2.6(2), printed pp.434--435. The concrete
certificate uses the unchanged ATLAS words and inverse point-action convention
in `LocalCover.ElementaryCatalogue`. See `Involutions/source/README.md`.
-/

namespace Rudvalis.CoveringIncidence.Max4InvolutionCertificate
open SylowOvergroups.RadicalCoverage.LocalCover
open CatalogueCertificate

@[expose] public def normalMap (n : Fin 16384) (x : Fin 4060) : Fin 4060 :=
  normalFormPermutation n x

@[expose] public def generatorMap (j : Fin 14) (x : Fin 4060) : Fin 4060 :=
  pcPermutation j x

public theorem normal_smul (n : Fin 16384) (x : Fin 4060) :
    normalForm n • x = normalMap n x := by
  exact (congrArg (fun p : Equiv.Perm (Fin 4060) => p x)
    (normalFormPermutation_eq n)).symm

public theorem generator_smul (j : Fin 14) (x : Fin 4060) :
    pcGenerator j • x = generatorMap j x := by
  exact (congrArg (fun p : Equiv.Perm (Fin 4060) => p x)
    (pcPermutation_eq j)).symm

public theorem elementary_smul (j : Fin 6) (x : Fin 4060) :
    elementaryGenerator j • x = elementaryPermutation j x := by
  exact (congrArg (fun p : Equiv.Perm (Fin 4060) => p x)
    (elementaryPermutation_eq j)).symm

