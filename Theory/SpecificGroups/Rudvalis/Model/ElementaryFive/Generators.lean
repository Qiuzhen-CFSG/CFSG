module

public import Theory.SpecificGroups.Rudvalis.Model.OuterStabilizer.TitsEmbedding.Relations.Letters

/-!
# Two independent commuting elements of order five in Rudvalis

The two packed permutations are certified words in the existing stabilizer
words `PrimitiveData.s` and `PrimitiveData.t`, hence in the distinguished
ATLAS generators `a` and `b` of the degree-4060 carrier. Kernel reduction
checks the words, their fifth powers, commutation, and separation of `y`
from all powers of `x` on point 1. No ambient order or identification is used.

Source: R. A. Wilson, S. J. Nickerson and J. N. Bray, ATLAS of Finite Group
Representations, RuG1-p4060B0. The original source files and inverse-action
convention remain in `Model.PermutationData`. The retained GAP discovery
words and regeneration script are in `ElementaryFive/source/`.
-/

namespace Rudvalis.ElementaryFive
open Theory.GroupTheory
open OuterStabilizer.TitsEmbedding RelationCertificate
set_option maxRecDepth 30000
set_option Elab.async false

@[expose] public def xMapPacked : Nat := 

@[expose] public def xMap (i : Fin 4060) : Fin 4060 :=
  ⟨(xMapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem x_left : ∀ i, xMap^[4] (xMap i) = i := by
  apply Data.allFin
  decide +kernel

@[expose] public def xPerm : Equiv.Perm (Fin 4060) :=
  tablePerm xMap (xMap^[4]) (by exact x_left)
    (by exact rightInverse_of_leftInverse_fin x_left)

@[expose] public def xWord : List (Fin 4) := [1, 2, 3, 2, 3, 0, 1, 2, 2, 2, 1, 2, 2, 3, 2, 2, 3, 0, 1, 0, 1, 2, 3, 3, 3, 3, 2, 1, 1, 1, 0, 0, 0, 0, 3, 3, 2, 1]

public theorem xPerm_eq_word :
    xPerm = evalWord permutationLetter xWord := by
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

public theorem xPerm_mem : xPerm ∈ modelSubgroup := by
  rw [xPerm_eq_word, word_eq]
  exact (evalWord letter xWord).property

@[expose] public def x : Model := ⟨xPerm, xPerm_mem⟩

public theorem x_fifth : x ^ 5 = 1 := by
  apply Subtype.ext
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

public theorem x_ne_one : x ≠ 1 := by
  intro h
  have hh := congrArg (fun g : Model => (modelSubgroup.subtype g) 1) h
  have hn : xMap 1 ≠ 1 := by decide +kernel
  exact hn hh

public theorem x_order : orderOf x = 5 := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  exact orderOf_eq_prime x_fifth x_ne_one

@[expose] public def yMapPacked : Nat := 

@[expose] public def yMap (i : Fin 4060) : Fin 4060 :=
  ⟨(yMapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem y_left : ∀ i, yMap^[4] (yMap i) = i := by
  apply Data.allFin
  decide +kernel

@[expose] public def yPerm : Equiv.Perm (Fin 4060) :=
  tablePerm yMap (yMap^[4]) (by exact y_left)
    (by exact rightInverse_of_leftInverse_fin y_left)

@[expose] public def yWord : List (Fin 4) := [1, 0, 3, 0, 0, 3, 3, 0, 1, 1, 0, 3, 2, 2, 1, 0, 1, 0, 1, 0, 1, 1]

public theorem yPerm_eq_word :
    yPerm = evalWord permutationLetter yWord := by
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

public theorem yPerm_mem : yPerm ∈ modelSubgroup := by
  rw [yPerm_eq_word, word_eq]
  exact (evalWord letter yWord).property

@[expose] public def y : Model := ⟨yPerm, yPerm_mem⟩

public theorem y_fifth : y ^ 5 = 1 := by
  apply Subtype.ext
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

public theorem y_ne_one : y ≠ 1 := by
  intro h
  have hh := congrArg (fun g : Model => (modelSubgroup.subtype g) 1) h
  have hn : yMap 1 ≠ 1 := by decide +kernel
  exact hn hh

public theorem y_order : orderOf y = 5 := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  exact orderOf_eq_prime y_fifth y_ne_one

public theorem x_commute_y : Commute x y := by
  apply Subtype.ext
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

public theorem y_not_mem_x : y ∉ Subgroup.zpowers x := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, x_order]
  intro h
  obtain ⟨i, hi, he⟩ := Finset.mem_image.mp h
  have hh : ∀ i : Fin 5,
      yPerm 1 ≠ (xPerm ^ i.val) 1 := by
    decide +kernel
  exact hh ⟨i, Finset.mem_range.mp hi⟩
    (congrArg (fun g : Model => (modelSubgroup.subtype g) 1) he).symm

end Rudvalis.ElementaryFive
