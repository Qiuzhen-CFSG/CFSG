module

public import Theory.SpecificGroups.Rudvalis.Model.OuterNormalizer.Reduction
public import Theory.SpecificGroups.Rudvalis.Model.OuterNormalizer.Invariance
public import Theory.SpecificGroups.Rudvalis.Model.OuterNormalizer.Rigidity

/-!
# Assembly of the concrete Rudvalis permutation-normalizer calculation

The candidate orbital on the actual 4060 letters reduces the calculation to
two independent finite problems: invariance under the ATLAS generators, and
rigidity of the relation. Unequal subdegrees force the full normalizer to
preserve the relation; rigidity then puts every normalizing permutation in
the original model subgroup.

The kernel-checked invariance and rigidity calculations discharge every
premise of the final theorem. It needs neither simplicity nor perfectness of
the model. This is the concrete permutation-normalizer calculation used in
the proof of `Out(Ru) = 1` from GLS3, Table 5.3r, printed p.279; realizing all
abstract automorphisms in this action is a separate step. The source
application is Aschbacher–Smith, printed pp.33 and 510.
-/

namespace Rudvalis
open OuterNormalizer

/-- Generator invariance and relation rigidity imply self-normalization of
the actual ATLAS subgroup. Both finite calculations must be discharged. -/
public theorem outer_permutation_normalizer_eq_of_relation
    (ha : aPerm ∈ relationAut) (hb : bPerm ∈ relationAut)
    (hrigid : relationAut ≤ modelSubgroup) :
    Subgroup.normalizer (modelSubgroup : Set (Equiv.Perm (Fin 4060))) = modelSubgroup := by
  exact le_antisymm ((normalizer_le_relationAut (model_le_relationAut ha hb)).trans hrigid)
    Subgroup.le_normalizer

/-- The subgroup generated by the actual degree-4060 ATLAS permutations is its
own full permutation normalizer. Generator invariance identifies the full
suborbits, and their unequal sizes force every normalizer element to preserve
the orbital; the certified relation rigidity then puts it in the subgroup. -/
public theorem outer_permutation_normalizer_eq :
    Subgroup.normalizer (modelSubgroup : Set (Equiv.Perm (Fin 4060))) = modelSubgroup := by
  have hG := model_le_relationAut aPerm_mem_relationAut bPerm_mem_relationAut
  exact outer_permutation_normalizer_eq_of_relation aPerm_mem_relationAut bPerm_mem_relationAut
    (relationAut_le_model hG)

end Rudvalis
