module

public import Theory.SpecificGroups.Rudvalis.Model.PrimitiveCertificates

/-!
# Primitivity of the Rudvalis permutation model

A checked spanning tree proves transitivity. Two explicit words fixing 0
connect every point to one of 0, 1, and 6. Thus a block containing 0 is a
union of the three certified components. The intermediate unions have sizes
1756 and 2305, neither of which divides 4060. The block is therefore a
singleton or the whole set, proving primitivity independently of group order.

The ATLAS reports suborbit sizes 1, 1755, and 2304 for this representation:
https://brauer.maths.qmul.ac.uk/Atlas/v3/permrep/RuG1-p4060B0 .
Only the explicit witnesses checked in `PrimitiveCertificates` enter the proof;
we do not need to identify the subgroup generated by the two words with the
full point stabilizer.
-/

namespace Rudvalis
open PrimitiveData MulAction
open scoped Pointwise

private theorem reachable (x : Fin 4060) : ∃ g : Model, g • (0 : Fin 4060) = x := by
  induction x using (measure transDepth).wf.induction with
  | h x ih =>
    rcases trans_edge x with rfl | ⟨hd, he⟩
    · exact ⟨1, one_smul _ _⟩
    obtain ⟨g, hg⟩ := ih (transParent x) hd
    rcases he with ha | hb
    · exact ⟨a * g, by rw [mul_smul, hg]; exact ha⟩
    · exact ⟨b * g, by rw [mul_smul, hg]; exact hb⟩

/-- The concrete Rudvalis action is transitive on its 4060 letters. -/
public theorem model_isPretransitive : IsPretransitive Model (Fin 4060) := by
  constructor
  intro x y
  obtain ⟨g, hg⟩ := reachable x
  obtain ⟨h, hh⟩ := reachable y
  refine ⟨h * g⁻¹, ?_⟩
  rw [mul_smul, ← hg, inv_smul_smul, hh]

private theorem root_reachable (x : Fin 4060) :
    ∃ g : Model, g • (0 : Fin 4060) = 0 ∧ g • root x = x := by
  induction x using (measure stabDepth).wf.induction with
  | h x ih =>
    rcases stab_edge x with hr | ⟨hd, hr, he⟩
    · exact ⟨1, one_smul _ _, (one_smul _ _).trans hr.symm⟩
    obtain ⟨g, hg0, hg⟩ := ih (stabParent x) hd
    rw [hr] at hg
    rcases he with hs | ht
    · exact ⟨s * g, by rw [mul_smul, hg0, s_fix],
        by rw [mul_smul, hg, ← sMap_eq]; exact hs⟩
    · exact ⟨t * g, by rw [mul_smul, hg0, t_fix],
        by rw [mul_smul, hg, ← tMap_eq]; exact ht⟩

private theorem block_mem_iff {B : Set (Fin 4060)} (h0 : (0 : Fin 4060) ∈ B)
    (hB : IsBlock Model B) (x : Fin 4060) : x ∈ B ↔ root x ∈ B := by
  obtain ⟨g, hg0, hg⟩ := root_reachable x
  have he : g • B = B := hB.smul_eq_of_mem h0 (hg0.symm ▸ h0)
  calc
    x ∈ B ↔ g • root x ∈ g • B := by rw [he, hg]
    _ ↔ root x ∈ B := Set.smul_mem_smul_set_iff

/-- The concrete Rudvalis action is primitive on its 4060 letters. -/
public theorem model_isPreprimitive : IsPreprimitive Model (Fin 4060) := by
  let := model_isPretransitive
  apply IsPreprimitive.of_isTrivialBlock_base (0 : Fin 4060)
  intro B h0 hB
  have hm := block_mem_iff h0 hB
  have hd : B.ncard ∣ 4060 := by simpa using hB.ncard_dvd_card ⟨0, h0⟩
  by_cases h1 : (1 : Fin 4060) ∈ B <;> by_cases h6 : (6 : Fin 4060) ∈ B
  · right
    apply Set.eq_univ_of_forall
    intro x
    apply (hm x).mpr
    rcases root_cases x with h | h | h <;> simp [h, h0, h1, h6]
  · have he : B = {x | root x = 0 ∨ root x = 1} := by
      ext x
      rw [hm x]
      rcases root_cases x with h | h | h <;> simp [h, h0, h1, h6]
    rw [he, first_union_card] at hd
    exact False.elim ((by decide : ¬1756 ∣ 4060) hd)
  · have he : B = {x | root x = 0 ∨ root x = 6} := by
      ext x
      rw [hm x]
      rcases root_cases x with h | h | h <;> simp [h, h0, h1, h6]
    rw [he, second_union_card] at hd
    exact False.elim ((by decide : ¬2305 ∣ 4060) hd)
  · left
    have he : B = {0} := by
      ext x
      rw [hm x]
      rw [Set.mem_singleton_iff, ← root_zero x]
      rcases root_cases x with h | h | h <;> simp [h, h0, h1, h6]
    rw [he]
    exact Set.subsingleton_singleton
end Rudvalis
