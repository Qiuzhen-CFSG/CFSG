public instance (x : Fin 4060) : Decidable (r5s5Facts x) :=
  inferInstanceAs (Decidable (_ ∧ _))

private theorem r5s5_facts : ∀ x, r5s5Facts x := by
  apply Data.allFin
  decide +kernel

public theorem r5s5_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (hf : ∀ x : Fin 4060, x.val < 5 → p x = x) :
    ∀ x, r5s5 (p x) = r5s5 x :=
  refine_preserved p hp r5s4 r5s5 r5s5Cell 189 53
    r5s5_nodup (fun x => (r5s5_facts x).1) (fun x => ((r5s5_facts x).2).trans (congrArg (fun n => r5s4 x * 53 + n) (bitCount_eq r5s5Cell r5s5Rows r5s5_rows x)))
    (r5s4_preserved p hp hf)

end Rudvalis.OuterNormalizer.RigidityCertificate
