    ∀ x, r3s0 (p x) = r3s0 x :=
  refine_preserved p hp (initial 3) r3s0 r3s0Cell 0 2
    r3s0_nodup (fun x => (r3s0_facts x).1) (fun x => ((r3s0_facts x).2).trans (congrArg (fun n => (initial 3) x * 2 + n) (bitCount_eq r3s0Cell r3s0Rows r3s0_rows x)))
    (initial_preserved 3 p hf)

