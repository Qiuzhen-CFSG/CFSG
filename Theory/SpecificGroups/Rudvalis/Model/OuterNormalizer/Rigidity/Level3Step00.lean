private theorem r3s0_nodup : r3s0Cell.Nodup := by decide +kernel

@[expose] public def r3s0Facts (x : Fin 4060) : Prop :=
  (x ∈ r3s0Cell ↔ (initial 3) x = 0) ∧
  r3s0 x = (initial 3) x * 2 + bitCount r3s0Rows x

public instance (x : Fin 4060) : Decidable (r3s0Facts x) :=
  inferInstanceAs (Decidable (_ ∧ _))

private theorem r3s0_facts : ∀ x, r3s0Facts x := by
  apply Data.allFin
  decide +kernel

public theorem r3s0_preserved (p : Equiv.Perm (Fin 4060))
