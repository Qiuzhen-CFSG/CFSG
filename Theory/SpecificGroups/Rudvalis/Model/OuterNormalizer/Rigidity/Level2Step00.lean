]

private theorem r2s0_rows : r2s0Rows = r2s0Cell.map InvarianceCertificate.row := by decide +kernel

private theorem r2s0_nodup : r2s0Cell.Nodup := by decide +kernel

@[expose] public def r2s0Facts (x : Fin 4060) : Prop :=
  (x ∈ r2s0Cell ↔ (initial 2) x = 0) ∧
  r2s0 x = (initial 2) x * 2 + bitCount r2s0Rows x

public instance (x : Fin 4060) : Decidable (r2s0Facts x) :=
  inferInstanceAs (Decidable (_ ∧ _))

private theorem r2s0_facts : ∀ x, r2s0Facts x := by
  apply Data.allFin
  decide +kernel

public theorem r2s0_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (hf : ∀ x : Fin 4060, x.val < 2 → p x = x) :
    ∀ x, r2s0 (p x) = r2s0 x :=
  refine_preserved p hp (initial 2) r2s0 r2s0Cell 0 2
    r2s0_nodup (fun x => (r2s0_facts x).1) (fun x => ((r2s0_facts x).2).trans (congrArg (fun n => (initial 2) x * 2 + n) (bitCount_eq r2s0Cell r2s0Rows r2s0_rows x)))
    (initial_preserved 2 p hf)

