  InvarianceCertificate.allFinBlocks r3s3Facts r3s3_blocks

public theorem r3s3_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (hf : ∀ x : Fin 4060, x.val < 3 → p x = x) :
    ∀ x, r3s3 (p x) = r3s3 x :=
  refine_preserved p hp r3s2 r3s3 r3s3Cell 31 316
    r3s3_nodup (fun x => (r3s3_facts x).1) (fun x => ((r3s3_facts x).2).trans (congrArg (fun n => r3s2 x * 316 + n) (bitCount_eq r3s3Cell r3s3Rows r3s3_rows x)))
    (r3s2_preserved p hp hf)

