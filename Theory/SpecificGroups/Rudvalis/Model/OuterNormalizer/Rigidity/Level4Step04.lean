private theorem r4s4_rows : r4s4Rows = r4s4Cell.map InvarianceCertificate.row := by decide +kernel

private theorem r4s4_nodup : r4s4Cell.Nodup := by decide +kernel

@[expose] public def r4s4Facts (x : Fin 4060) : Prop :=
  (x ∈ r4s4Cell ↔ r4s3 x = 71) ∧
  r4s4 x = r4s3 x * 145 + bitCount r4s4Rows x

public instance (x : Fin 4060) : Decidable (r4s4Facts x) :=
  inferInstanceAs (Decidable (_ ∧ _))

private theorem r4s4_facts : ∀ x, r4s4Facts x := by
  apply Data.allFin
  decide +kernel

public theorem r4s4_preserved (p : Equiv.Perm (Fin 4060))
    (hp : p ∈ relationAut) (hf : ∀ x : Fin 4060, x.val < 4 → p x = x) :
    ∀ x, r4s4 (p x) = r4s4 x :=
  refine_preserved p hp r4s3 r4s4 r4s4Cell 71 145
    r4s4_nodup (fun x => (r4s4_facts x).1) (fun x => ((r4s4_facts x).2).trans (congrArg (fun n => r4s3 x * 145 + n) (bitCount_eq r4s4Cell r4s4Rows r4s4_rows x)))
    (r4s3_preserved p hp hf)

end Rudvalis.OuterNormalizer.RigidityCertificate
