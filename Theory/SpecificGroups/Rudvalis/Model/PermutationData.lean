module

public import Mathlib.GroupTheory.Perm.Finite

/-!
# Explicit ATLAS permutations for the Rudvalis group

Source: Wilson–Nickerson–Bray, ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/v3/permrep/RuG1-p4060B0 .
The unmodified source files `RuG1-p4060B0.g1` and `RuG1-p4060B0.g2`
are stored beside this module. `Generate.py` produces these tables.

Labels are shifted from 1–4060 to 0–4059. Inverting both point maps
converts GAP's right action to Lean's left action without reversing words.
Twelve-bit table entries are packed into natural numbers, then decoded by
shifts and remainders using the kernel's natural-number arithmetic.
The subsequent construction checks inverse laws; these data alone make
no claim about order, simplicity, or recognition of an ambient group.
-/

namespace Rudvalis.Data

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def aMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def aMap (x : Fin 4060) : Fin 4060 :=
  ⟨(aMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def bMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def bMap (x : Fin 4060) : Fin 4060 :=
  ⟨(bMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def abMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def abMap (x : Fin 4060) : Fin 4060 :=
  ⟨(abMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

/-- Twelve-bit entries, least significant entry first. -/
@[expose] public def wMapPacked : Nat := 

/-- The inverse-convention ATLAS word map, with zero-based labels. -/
@[expose] public def wMap (x : Fin 4060) : Fin 4060 :=
  ⟨(wMapPacked >>> (12 * x.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

end Rudvalis.Data
