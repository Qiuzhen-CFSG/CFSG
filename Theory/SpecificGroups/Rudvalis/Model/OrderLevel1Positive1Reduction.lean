module

public import Theory.SpecificGroups.Rudvalis.Model.OrderLevel1Reduction

/-!
# Bounded certificates for the second Rudvalis level-1 generator

The 351 batches partition into nine blocks of 39 batches. Each block can be
certified independently, and their assembly proves the positive transition for
all 1755 representatives. The listed batches require only free cancellation;
their inclusion in this list and their word identities are kernel checked.

Source: the ATLAS witnesses in `OrderLevel1Data`, generated by
`OrderCertificate/GenerateChain.g` and `OrderCertificate/GenerateFactors.g`.
-/

namespace Rudvalis.OrderCertificate.OrderLevel1Positive1
open Theory.GroupTheory Level1Reduction
set_option Elab.async false

@[expose] public def blockBatch (k : Fin 9) (b : Fin 39) : Fin 351 :=
  ⟨39 * k.val + b.val, by omega⟩

@[expose] public def block (k : Fin 9) : Prop :=
  ∀ b : Fin 39, stepBatch 1 (blockBatch k b)

/-- Assemble the nine bounded certificates into the required transition. -/
public theorem positiveStep_of_blocks (h : ∀ k, block k) (r : Fin 1755) :
    L1Gen 1 * L1Rep r = L1Rep (L1Act 1 r) * evalWord L2Gen (L1Factor 1 r) := by
  apply positiveStep_of_batches 1
  intro b
  let k : Fin 9 := ⟨b.val / 39, by omega⟩
  let s : Fin 39 := ⟨b.val % 39, by omega⟩
  have hbs : blockBatch k s = b := by
    apply Fin.ext
    dsimp [blockBatch, k, s]
    omega
  simpa only [hbs] using h k s

@[expose] public def algebraicBatch (b : Fin 351) : Prop :=
  b.val ∈ [0, 2, 6, 8, 9, 10, 11, 12, 14, 18, 19, 20, 23, 27, 31, 38,
    42, 46, 50, 52, 54, 57, 65, 66, 89, 99, 106, 124, 145, 152, 155]

public instance (b : Fin 351) : Decidable (algebraicBatch b) :=
  inferInstanceAs (Decidable (_ ∈ _))

set_option maxRecDepth 30000 in
private theorem algebraic_checks : ∀ b : Fin 351, algebraicBatch b →
    ∀ r : Fin 5, algebraic 1 (batchRep b r) := by
  apply allFin
  decide +kernel

/-- The 31 batches whose transitions follow solely by free cancellation. -/
public theorem algebraic_batches (b : Fin 351) (h : algebraicBatch b) :
    stepBatch 1 b := by
  apply ofStepBatchCheck
  intro r
  exact Or.inl (algebraic_checks b h r)

end Rudvalis.OrderCertificate.OrderLevel1Positive1
