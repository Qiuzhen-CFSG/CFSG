module

public import Theory.SpecificGroups.Rudvalis.Model.Permutations

/-!
# The concrete Rudvalis carrier

The model is the subgroup generated by the two ATLAS permutations in their
degree-4060 representation, so its group and finiteness instances follow from
the ambient finite symmetric group. See the source and action convention in
`PermutationData`. Certification of order and simplicity is separate from
this construction, as is recognition of an arbitrary ambient group.
-/

namespace Rudvalis

/-- The subgroup generated by the explicit ATLAS permutations. -/
@[expose] public def modelSubgroup : Subgroup (Equiv.Perm (Fin 4060)) :=
  Subgroup.closure {aPerm, bPerm}

/-- The concrete degree-4060 permutation model for the Rudvalis group. -/
@[expose] public def Model : Type := modelSubgroup
  deriving Group, Finite

/-- The natural faithful action on the 4060 letters. -/
public instance : MulAction Model (Fin 4060) :=
  inferInstanceAs (MulAction modelSubgroup (Fin 4060))

public instance : FaithfulSMul Model (Fin 4060) :=
  inferInstanceAs (FaithfulSMul modelSubgroup (Fin 4060))

public theorem aPerm_mem : aPerm ∈ modelSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

public theorem bPerm_mem : bPerm ∈ modelSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- First standard generator as an element of the model. -/
@[expose] public def a : Model := ⟨aPerm, aPerm_mem⟩

/-- Second standard generator as an element of the model. -/
@[expose] public def b : Model := ⟨bPerm, bPerm_mem⟩

/-- The standard word of order 29. -/
@[expose] public def w : Model := a * b * a * b * b

public theorem a_sq : a ^ 2 = 1 := Subtype.ext aPerm_sq

public theorem b_fourth : b ^ 4 = 1 := Subtype.ext bPerm_fourth

public theorem ab_thirteenth : (a * b) ^ 13 = 1 := Subtype.ext abPerm_thirteenth

public theorem w_twentyNinth : w ^ 29 = 1 := Subtype.ext ababbPerm_twentyNinth

/-- It suffices for a subgroup of the model to contain the two generators. -/
public theorem eq_top_of_a_mem_of_b_mem (H : Subgroup Model) (ha : a ∈ H) (hb : b ∈ H) :
    H = ⊤ := by
  have hle : modelSubgroup ≤ H.map modelSubgroup.subtype := by
    apply (Subgroup.closure_le _).mpr
    rintro x (rfl | hx)
    · exact ⟨a, ha, rfl⟩
    · obtain rfl := Set.mem_singleton_iff.mp hx
      exact ⟨b, hb, rfl⟩
  apply top_le_iff.mp
  intro x _
  obtain ⟨y, hy, hxy⟩ := hle x.property
  exact (Subtype.ext hxy : y = x) ▸ hy


public theorem a_ne_one : a ≠ 1 := by
  intro h
  have hn : aPerm 0 ≠ (0 : Fin 4060) := by decide +kernel
  exact hn (congrArg (fun g : Model => g • (0 : Fin 4060)) h)

public instance : Nontrivial Model := ⟨⟨a, 1, a_ne_one⟩⟩

public theorem orderOf_a : orderOf a = 2 := orderOf_eq_prime a_sq a_ne_one

public theorem orderOf_b : orderOf b = 4 := by
  apply orderOf_eq_prime_pow (p := 2) (n := 1) _ b_fourth
  intro h
  have hn : (bPerm ^ 2) 0 ≠ (0 : Fin 4060) := by decide +kernel
  exact hn (congrArg (fun g : Model => g • (0 : Fin 4060)) h)

public theorem orderOf_ab : orderOf (a * b) = 13 := by
  let : Fact (Nat.Prime 13) := ⟨by decide⟩
  apply orderOf_eq_prime ab_thirteenth
  intro h
  have hn : (aPerm * bPerm) 0 ≠ (0 : Fin 4060) := by decide +kernel
  exact hn (congrArg (fun g : Model => g • (0 : Fin 4060)) h)

public theorem orderOf_w : orderOf w = 29 := by
  let : Fact (Nat.Prime 29) := ⟨by decide⟩
  apply orderOf_eq_prime w_twentyNinth
  intro h
  have hn : (aPerm * bPerm * aPerm * bPerm * bPerm) 0 ≠ (0 : Fin 4060) :=
    by decide +kernel
  exact hn (congrArg (fun g : Model => g • (0 : Fin 4060)) h)


end Rudvalis
