module

public import Theory.SpecificGroups.Janko3.Model.ThreePrimary.Generators
public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Thompson.Enumeration

/-!
# Collection data for the J₃ three-subgroup

The five generators are `d,e,c,x,y`, with relative orders three. The tables
specify powers and conjugates in earlier generators. A left inverse on the
orbit of one letter separates the 243 normal forms. These are certificate
data only; `Certificate` checks the equations and `Structure` derives the
order and generating-pair interface. See GLS III, Table 5.3h.
-/

namespace Sporadic.Janko3.ThreePrimary
open TwoLocal.ThompsonCertificate

@[expose] public def gen (i : ℕ) : Model :=
  if i = 0 then d else if i = 1 then e else if i = 2 then c else
    if i = 3 then x else y

@[expose] public def radix (_ : ℕ) : ℕ := 3
@[expose] public def width (n : ℕ) : ℕ := NormalForm.size radix n
@[expose] public def representative (n r : ℕ) : Model := NormalForm.rep gen radix n r
@[expose] public def chain (n : ℕ) : Subgroup Model := NormalForm.series gen n

@[expose] public def powerCode : Fin 5 → ℕ := ![0, 0, 0, 5, 8]

@[expose] public def conjugateCode (k i : ℕ) : ℕ :=
  match k, i with
  | 1, 0 => 1
  | 2, 0 => 1
  | 2, 1 => 3
  | 3, 0 => 1
  | 3, 1 => 3
  | 3, 2 => 11
  | 4, 0 => 1
  | 4, 1 => 3
  | 4, 2 => 15
  | 4, 3 => 47
  | _, _ => 0

@[expose] public def inverseConjugateCode (k i : ℕ) : ℕ :=
  match k, i with
  | 1, 0 => 1
  | 2, 0 => 1
  | 2, 1 => 3
  | 3, 0 => 1
  | 3, 1 => 3
  | 3, 2 => 10
  | 4, 0 => 1
  | 4, 1 => 3
  | 4, 2 => 12
  | 4, 3 => 40
  | _, _ => 0

@[expose] public def separatingPoint : Fin 6156 := 0

@[expose] public def pointInversePacked : Nat := 

@[expose] public def pointInverse (i : Fin 6156) : Fin 243 :=
  ⟨(pointInversePacked >>> (8 * i.val)) % 256 % 243, Nat.mod_lt _ (by decide)⟩

end Sporadic.Janko3.ThreePrimary
