module

public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators
public import Theory.SpecificGroups.Janko3.Model.Order.Level2Generators
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# A marked generating pair for the J₃ Sylow-three calculation

These are the third and fourth permutations in the retained
`ThreeRank/source/sylow-and-elementary.json`. Their membership is checked
against the original ATLAS subgroup-chain words. Three additional packed
permutations represent their commutator and its two iterated commutators.
All identities are checked by Lean's kernel, with no presentation assumption.

Source: GLS III, Table 5.3h, and the ATLAS J3G1-p6156B0 permutation model.
The generator is retained in `ThreePrimary/source/generate.py`.
-/

namespace Sporadic.Janko3.ThreePrimary
open Theory.GroupTheory OrderCertificate
open scoped commutatorElement
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def xMapPacked : Nat := 

@[expose] public def xMap (i : Fin 6156) : Fin 6156 :=
  ⟨(xMapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def xInvMapPacked : Nat := 

@[expose] public def xInvMap (i : Fin 6156) : Fin 6156 :=
  ⟨(xInvMapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem x_left : ∀ i, xInvMap (xMap i) = i := by
  apply allLetters
  decide +kernel

@[expose] public def xPerm : Equiv.Perm (Fin 6156) :=
  tablePerm xMap xInvMap x_left
    (rightInverse_of_leftInverse_fin x_left)

@[expose] public def xWord0 : List (Fin 4) := [1, 0, 3, 0, 3, 0, 1, 0, 3, 0, 1, 0, 3, 0, 3, 0, 1, 0, 3]

@[expose] public def xWord1 : List (Fin 4) := [1, 2, 1, 0, 1, 0, 1, 2, 1]

@[expose] public def xWord2 : List (Fin 6) := [1, 2, 0]

public theorem xPerm_eq_word : xPerm =
    evalWord L0Gen xWord0 * evalWord L1Gen xWord1 * evalWord L2Gen xWord2 := by
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

public theorem xPerm_mem : xPerm ∈ modelSubgroup := by
  rw [xPerm_eq_word, ← H0_eq_modelSubgroup]
  exact H0.mul_mem (H0.mul_mem ⟨xWord0, rfl⟩ (H1_le ⟨xWord1, rfl⟩))
    (H1_le (H2_le ⟨xWord2, rfl⟩))

@[expose] public def x : Model := ⟨xPerm, xPerm_mem⟩

@[expose] public def yMapPacked : Nat := 

@[expose] public def yMap (i : Fin 6156) : Fin 6156 :=
  ⟨(yMapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def yInvMapPacked : Nat := 

@[expose] public def yInvMap (i : Fin 6156) : Fin 6156 :=
