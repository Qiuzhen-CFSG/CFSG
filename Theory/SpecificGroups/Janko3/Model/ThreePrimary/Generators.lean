@[expose] public def d : Model := ⟨dPerm, dPerm_mem⟩

public theorem d_eq : d = ⁅c, x⁆ := Subtype.ext dPerm_eq_commutator

@[expose] public def eMapPacked : Nat := 

@[expose] public def eMap (i : Fin 6156) : Fin 6156 :=
  ⟨(eMapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def eInvMapPacked : Nat := 

@[expose] public def eInvMap (i : Fin 6156) : Fin 6156 :=
