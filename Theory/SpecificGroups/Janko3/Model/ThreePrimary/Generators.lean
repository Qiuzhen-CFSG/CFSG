  decide +kernel

@[expose] public def yPerm : Equiv.Perm (Fin 6156) :=
  tablePerm yMap yInvMap y_left
    (rightInverse_of_leftInverse_fin y_left)

@[expose] public def yWord0 : List (Fin 4) := [0, 1, 0, 3, 0, 3, 0, 1, 0, 1, 0, 3, 0, 1, 0, 3]

@[expose] public def yWord1 : List (Fin 4) := [2, 1, 0, 1, 2, 1, 0, 0, 1, 2, 1, 0, 0, 1, 0]

@[expose] public def yWord2 : List (Fin 6) := [2, 0, 0]

public theorem yPerm_eq_word : yPerm =
    evalWord L0Gen yWord0 * evalWord L1Gen yWord1 * evalWord L2Gen yWord2 := by
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

public theorem yPerm_mem : yPerm ∈ modelSubgroup := by
  rw [yPerm_eq_word, ← H0_eq_modelSubgroup]
  exact H0.mul_mem (H0.mul_mem ⟨yWord0, rfl⟩ (H1_le ⟨yWord1, rfl⟩))
    (H1_le (H2_le ⟨yWord2, rfl⟩))

@[expose] public def y : Model := ⟨yPerm, yPerm_mem⟩

@[expose] public def cMapPacked : Nat := 

@[expose] public def cMap (i : Fin 6156) : Fin 6156 :=
  ⟨(cMapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def cInvMapPacked : Nat := 

@[expose] public def cInvMap (i : Fin 6156) : Fin 6156 :=
  ⟨(cInvMapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem c_left : ∀ i, cInvMap (cMap i) = i := by
  apply allLetters
  decide +kernel

@[expose] public def cPerm : Equiv.Perm (Fin 6156) :=
  tablePerm cMap cInvMap c_left
    (rightInverse_of_leftInverse_fin c_left)

public theorem cPerm_eq_commutator : cPerm = ⁅xPerm, yPerm⁆ := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

public theorem cPerm_mem : cPerm ∈ modelSubgroup := by
  rw [cPerm_eq_commutator]
  exact modelSubgroup.mul_mem
    (modelSubgroup.mul_mem (modelSubgroup.mul_mem xPerm_mem yPerm_mem)
      (modelSubgroup.inv_mem xPerm_mem)) (modelSubgroup.inv_mem yPerm_mem)

@[expose] public def c : Model := ⟨cPerm, cPerm_mem⟩

public theorem c_eq : c = ⁅x, y⁆ := Subtype.ext cPerm_eq_commutator

