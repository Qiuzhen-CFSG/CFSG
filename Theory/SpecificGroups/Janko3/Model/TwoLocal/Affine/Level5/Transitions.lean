@[expose] public def act5 : Fin 2 → Fin 2 → Fin 2
  | 0 => ![1, 0]
  | 1 => ![1, 0]

@[expose] public def factor5 : Fin 2 → Fin 2 → List (Fin 1)
  | 0 => ![[], []]
  | 1 => ![[0], [0]]

set_option maxHeartbeats 4000000 in
public theorem next5_fix : ∀ g : H6, (g : Equiv.Perm (Fin 6156)) 73 = 73 := by
  apply wordSubgroup_fix_of_gen_fix
  decide +kernel

@[expose] public def stepCheck5 : Fin 2 → Bool :=
  fun i => checkFin (fun r : Fin 2 => checkLetters (fun x => decide
    ((gen5 i * rep5 r) x = (rep5 (act5 i r) * evalWord gen6 (factor5 i r)) x)))

public theorem step5_of_check (i : Fin 2) (h : stepCheck5 i = true) :
    ∀ r, gen5 i * rep5 r = rep5 (act5 i r) * evalWord gen6 (factor5 i r) := by
  have hr := allFin (fun r : Fin 2 => checkLetters (fun x => decide
    ((gen5 i * rep5 r) x = (rep5 (act5 i r) * evalWord gen6 (factor5 i r)) x)) = true) (by
      simpa only [stepCheck5, Bool.decide_eq_true] using h)
  intro r
  apply Equiv.ext
  exact allLetters _ (hr r)

