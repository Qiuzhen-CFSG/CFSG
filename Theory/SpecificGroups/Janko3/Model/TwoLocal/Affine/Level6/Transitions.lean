@[expose] public def act6 : Fin 1 → Fin 2 → Fin 2
  | 0 => ![1, 0]

@[expose] public def factor6 : Fin 1 → Fin 2 → List (Fin 0)
  | 0 => ![[], []]

set_option maxHeartbeats 4000000 in
public theorem next6_fix : ∀ g : H7, (g : Equiv.Perm (Fin 6156)) 0 = 0 := by
  apply wordSubgroup_fix_of_gen_fix
  intro i
  exact Fin.elim0 i

@[expose] public def stepCheck6 : Fin 1 → Bool :=
  fun i => checkFin (fun r : Fin 2 => checkLetters (fun x => decide
    ((gen6 i * rep6 r) x = (rep6 (act6 i r) * evalWord gen7 (factor6 i r)) x)))

public theorem step6_of_check (i : Fin 1) (h : stepCheck6 i = true) :
    ∀ r, gen6 i * rep6 r = rep6 (act6 i r) * evalWord gen7 (factor6 i r) := by
  have hr := allFin (fun r : Fin 2 => checkLetters (fun x => decide
    ((gen6 i * rep6 r) x = (rep6 (act6 i r) * evalWord gen7 (factor6 i r)) x)) = true) (by
      simpa only [stepCheck6, Bool.decide_eq_true] using h)
  intro r
  apply Equiv.ext
  exact allLetters _ (hr r)

end Sporadic.Janko3.TwoLocal.AffineCertificate
