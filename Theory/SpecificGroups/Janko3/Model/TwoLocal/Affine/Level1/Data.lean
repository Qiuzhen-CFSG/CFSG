@[expose] public def gen1 : Fin 8 → Equiv.Perm (Fin 6156)
  | 0 => G0
  | 1 => G1
  | 2 => G2
  | 3 => G3
  | 4 => G7
  | 5 => G8
  | 6 => G7⁻¹
  | 7 => G8⁻¹

@[expose] public def inv1 : Fin 8 → Fin 8
  | 0 => 0
  | 1 => 1
  | 2 => 2
  | 3 => 3
  | 4 => 6
  | 5 => 7
  | 6 => 4
  | 7 => 5

public theorem inv1_spec (i : Fin 8) : gen1 (inv1 i) = (gen1 i)⁻¹ := by
  fin_cases i <;> simp only [inv1, gen1, inv_inv] <;> rfl

@[expose] public def H1 : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup gen1 inv1 inv1_spec

public theorem H1_le : H1 ≤ H0 := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change G0 ∈ H0
    exact ⟨[0], by simp only [evalWord, gen0, mul_one]⟩
  · change G1 ∈ H0
    exact ⟨[1], by simp only [evalWord, gen0, mul_one]⟩
  · change G2 ∈ H0
    exact ⟨[2], by simp only [evalWord, gen0, mul_one]⟩
  · change G3 ∈ H0
    exact ⟨[3], by simp only [evalWord, gen0, mul_one]⟩
  · change G7 ∈ H0
    rw [G7_eq]
    exact ⟨[5, 4], rfl⟩
  · change G8 ∈ H0
    rw [G8_eq]
    exact ⟨[4, 6, 4], rfl⟩
  · change G7⁻¹ ∈ H0
    apply H0.inv_mem
    rw [G7_eq]
    exact ⟨[5, 4], rfl⟩
  · change G8⁻¹ ∈ H0
    apply H0.inv_mem
    rw [G8_eq]
    exact ⟨[4, 6, 4], rfl⟩

