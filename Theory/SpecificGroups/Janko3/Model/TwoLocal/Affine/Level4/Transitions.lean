@[expose] public def act4 : Fin 3 → Fin 2 → Fin 2
  | 0 => ![0, 1]
  | 1 => ![1, 0]
  | 2 => ![1, 0]

@[expose] public def factor4 : Fin 3 → Fin 2 → List (Fin 2)
  | 0 => ![[0], [0]]
  | 1 => ![[], []]
  | 2 => ![[1], [1]]

set_option maxHeartbeats 4000000 in
public theorem next4_fix : ∀ g : H5, (g : Equiv.Perm (Fin 6156)) 754 = 754 := by
  apply wordSubgroup_fix_of_gen_fix
  decide +kernel

@[expose] public def stepCheck4 : Fin 3 → Bool :=
  fun i => checkFin (fun r : Fin 2 => checkLetters (fun x => decide
    ((gen4 i * rep4 r) x = (rep4 (act4 i r) * evalWord gen5 (factor4 i r)) x)))

public theorem step4_of_check (i : Fin 3) (h : stepCheck4 i = true) :
    ∀ r, gen4 i * rep4 r = rep4 (act4 i r) * evalWord gen5 (factor4 i r) := by
  have hr := allFin (fun r : Fin 2 => checkLetters (fun x => decide
    ((gen4 i * rep4 r) x = (rep4 (act4 i r) * evalWord gen5 (factor4 i r)) x)) = true) (by
      simpa only [stepCheck4, Bool.decide_eq_true] using h)
  intro r
  apply Equiv.ext
  exact allLetters _ (hr r)

end Sporadic.Janko3.TwoLocal.AffineCertificate
