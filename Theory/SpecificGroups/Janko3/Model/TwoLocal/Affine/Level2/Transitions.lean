public theorem next2_fix : ∀ g : H3, (g : Equiv.Perm (Fin 6156)) 2827 = 2827 := by
  apply wordSubgroup_fix_of_gen_fix
  decide +kernel

@[expose] public def stepCheck2 : Fin 6 → Bool :=
  fun i => checkFin (fun r : Fin 2 => checkLetters (fun x => decide
    ((gen2 i * rep2 r) x = (rep2 (act2 i r) * evalWord gen3 (factor2 i r)) x)))

public theorem step2_of_check (i : Fin 6) (h : stepCheck2 i = true) :
    ∀ r, gen2 i * rep2 r = rep2 (act2 i r) * evalWord gen3 (factor2 i r) := by
  have hr := allFin (fun r : Fin 2 => checkLetters (fun x => decide
    ((gen2 i * rep2 r) x = (rep2 (act2 i r) * evalWord gen3 (factor2 i r)) x)) = true) (by
      simpa only [stepCheck2, Bool.decide_eq_true] using h)
  intro r
  apply Equiv.ext
  exact allLetters _ (hr r)

