namespace Sporadic.Janko3.TwoLocal.AffineCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 40000
set_option Elab.async false

@[expose] public def gen2 : Fin 6 → Equiv.Perm (Fin 6156)
  | 0 => G0
  | 1 => G1
  | 2 => G2
  | 3 => G3
  | 4 => G7
  | 5 => G7⁻¹

@[expose] public def inv2 : Fin 6 → Fin 6
  | 0 => 0
  | 1 => 1
  | 2 => 2
  | 3 => 3
  | 4 => 5
  | 5 => 4

public theorem inv2_spec (i : Fin 6) : gen2 (inv2 i) = (gen2 i)⁻¹ := by
  fin_cases i <;> simp only [inv2, gen2, inv_inv] <;> rfl

@[expose] public def H2 : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup gen2 inv2 inv2_spec

public theorem H2_le : H2 ≤ H1 := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change G0 ∈ H1
    exact ⟨[0], by simp only [evalWord, gen1, mul_one]⟩
  · change G1 ∈ H1
    exact ⟨[1], by simp only [evalWord, gen1, mul_one]⟩
  · change G2 ∈ H1
    exact ⟨[2], by simp only [evalWord, gen1, mul_one]⟩
  · change G3 ∈ H1
    exact ⟨[3], by simp only [evalWord, gen1, mul_one]⟩
  · change G7 ∈ H1
    exact ⟨[4], by simp only [evalWord, gen1, mul_one]⟩
  · change G7⁻¹ ∈ H1
    apply H1.inv_mem
    exact ⟨[4], by simp only [evalWord, gen1, mul_one]⟩

@[expose] public def repWord2 : Fin 2 → List (Fin 6)
  | 0 => []
  | 1 => [4]

@[expose] public def rep2 : Fin 2 → Equiv.Perm (Fin 6156) :=
  fun r => evalWord gen2 (repWord2 r)

public theorem rep2_mem (r : Fin 2) : rep2 r ∈ H2 := ⟨repWord2 r, rfl⟩

@[expose] public def point2 : Fin 2 → Fin 6156
  | 0 => 2827
  | 1 => 4776

public theorem rep2_base : rep2 0 = 1 := rfl

set_option maxHeartbeats 4000000 in
public theorem rep2_point : ∀ r, rep2 r 2827 = point2 r := by
  apply allFin
  decide +kernel

set_option maxHeartbeats 4000000 in
public theorem point2_injective : Function.Injective point2 := by
  have h : ∀ i j : Fin 2, point2 i = point2 j → i = j := by decide +kernel
  exact h


end Sporadic.Janko3.TwoLocal.AffineCertificate
