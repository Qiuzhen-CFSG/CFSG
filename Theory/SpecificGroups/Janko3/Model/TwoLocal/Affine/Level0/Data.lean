@[expose] public def rep0 : Fin 6 → Equiv.Perm (Fin 6156) :=
  fun r => evalWord gen0 (repWord0 r)

public theorem rep0_mem (r : Fin 6) : rep0 r ∈ H0 := ⟨repWord0 r, rfl⟩

@[expose] public def point0 : Fin 6 → Fin 6156
