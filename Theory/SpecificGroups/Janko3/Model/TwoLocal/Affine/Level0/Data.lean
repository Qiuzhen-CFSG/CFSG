  | 2 => 5970
  | 3 => 2827
  | 4 => 5536
  | 5 => 2431

public theorem rep0_base : rep0 0 = 1 := rfl

set_option maxHeartbeats 4000000 in
public theorem rep0_point : ∀ r, rep0 r 1453 = point0 r := by
  apply allFin
  decide +kernel

set_option maxHeartbeats 4000000 in
public theorem point0_injective : Function.Injective point0 := by
  have h : ∀ i j : Fin 6, point0 i = point0 j → i = j := by decide +kernel
  exact h


