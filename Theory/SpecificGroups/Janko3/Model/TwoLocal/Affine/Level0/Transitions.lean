@[expose] public def stepCheck0 : Fin 10 → Bool :=
  fun i => checkFin (fun r : Fin 6 => checkLetters (fun x => decide
    ((gen0 i * rep0 r) x = (rep0 (act0 i r) * evalWord gen1 (factor0 i r)) x)))

public theorem step0_of_check (i : Fin 10) (h : stepCheck0 i = true) :
    ∀ r, gen0 i * rep0 r = rep0 (act0 i r) * evalWord gen1 (factor0 i r) := by
  have hr := allFin (fun r : Fin 6 => checkLetters (fun x => decide
    ((gen0 i * rep0 r) x = (rep0 (act0 i r) * evalWord gen1 (factor0 i r)) x)) = true) (by
      simpa only [stepCheck0, Bool.decide_eq_true] using h)
  intro r
  apply Equiv.ext
  exact allLetters _ (hr r)

