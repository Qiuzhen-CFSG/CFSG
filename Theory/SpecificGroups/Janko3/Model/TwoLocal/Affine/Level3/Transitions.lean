namespace Sporadic.Janko3.TwoLocal.AffineCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 40000
set_option Elab.async false

@[expose] public def act3 : Fin 6 → Fin 6 → Fin 6
  | 0 => ![1, 0, 2, 5, 4, 3]
  | 1 => ![1, 0, 4, 3, 2, 5]
  | 2 => ![1, 0, 2, 5, 4, 3]
  | 3 => ![1, 0, 2, 5, 4, 3]
  | 4 => ![2, 4, 3, 0, 5, 1]
  | 5 => ![3, 5, 0, 2, 1, 4]

@[expose] public def factor3 : Fin 6 → Fin 6 → List (Fin 3)
  | 0 => ![[], [], [2, 1, 0], [2, 1, 0], [2, 1, 0], [2, 1, 0]]
  | 1 => ![[0], [0], [2], [2, 0], [2], [2, 0]]
  | 2 => ![[1], [1], [0], [1, 0], [0], [1, 0]]
  | 3 => ![[2], [2], [2, 0], [0], [2, 0], [0]]
  | 4 => ![[], [], [], [], [], []]
  | 5 => ![[], [], [], [], [], []]

set_option maxHeartbeats 4000000 in
public theorem next3_fix : ∀ g : H4, (g : Equiv.Perm (Fin 6156)) 175 = 175 := by
  apply wordSubgroup_fix_of_gen_fix
  decide +kernel

@[expose] public def stepCheck3 : Fin 6 → Bool :=
  fun i => checkFin (fun r : Fin 6 => checkLetters (fun x => decide
    ((gen3 i * rep3 r) x = (rep3 (act3 i r) * evalWord gen4 (factor3 i r)) x)))

public theorem step3_of_check (i : Fin 6) (h : stepCheck3 i = true) :
    ∀ r, gen3 i * rep3 r = rep3 (act3 i r) * evalWord gen4 (factor3 i r) := by
  have hr := allFin (fun r : Fin 6 => checkLetters (fun x => decide
    ((gen3 i * rep3 r) x = (rep3 (act3 i r) * evalWord gen4 (factor3 i r)) x)) = true) (by
      simpa only [stepCheck3, Bool.decide_eq_true] using h)
  intro r
  apply Equiv.ext
  exact allLetters _ (hr r)

end Sporadic.Janko3.TwoLocal.AffineCertificate
