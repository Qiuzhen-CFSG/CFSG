@[expose] public def gen3 : Fin 6 → Equiv.Perm (Fin 6156)
  | 0 => G0
  | 1 => G1
  | 2 => G2
  | 3 => G3
  | 4 => G9
  | 5 => G9⁻¹

@[expose] public def inv3 : Fin 6 → Fin 6
  | 0 => 0
  | 1 => 1
  | 2 => 2
  | 3 => 3
  | 4 => 5
  | 5 => 4

public theorem inv3_spec (i : Fin 6) : gen3 (inv3 i) = (gen3 i)⁻¹ := by
  fin_cases i <;> simp only [inv3, gen3, inv_inv] <;> rfl

@[expose] public def H3 : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup gen3 inv3 inv3_spec

public theorem H3_le : H3 ≤ H2 := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change G0 ∈ H2
    exact ⟨[0], by simp only [evalWord, gen2, mul_one]⟩
  · change G1 ∈ H2
    exact ⟨[1], by simp only [evalWord, gen2, mul_one]⟩
  · change G2 ∈ H2
    exact ⟨[2], by simp only [evalWord, gen2, mul_one]⟩
  · change G3 ∈ H2
    exact ⟨[3], by simp only [evalWord, gen2, mul_one]⟩
  · change G9 ∈ H2
    rw [G9_eq]
    exact ⟨[4, 4], rfl⟩
  · change G9⁻¹ ∈ H2
    apply H2.inv_mem
    rw [G9_eq]
    exact ⟨[4, 4], rfl⟩

@[expose] public def repWord3 : Fin 6 → List (Fin 6)
