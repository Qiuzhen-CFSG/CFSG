set_option maxHeartbeats 4000000 in
public theorem G9_left : ∀ x, G9InvMap (G9Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def G9 : Equiv.Perm (Fin 6156) :=
  tablePerm G9Map G9InvMap G9_left
    (rightInverse_of_leftInverse_fin G9_left)

set_option maxHeartbeats 4000000 in
public theorem G9_eq : G9 = evalWord gen2 [4, 4] := by
