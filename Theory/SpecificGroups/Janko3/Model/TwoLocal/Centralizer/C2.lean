module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.C1

import Mathlib.Tactic.FinCases

/-!
# Generators at level 2 of the C chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def C2G0MapPacked : Nat := 

@[expose] public def C2G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C2G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C2G0InvMapPacked : Nat := 

@[expose] public def C2G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C2G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C2G0_left : ∀ x, C2G0InvMap (C2G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C2G0 : Equiv.Perm (Fin 6156) :=
  tablePerm C2G0Map C2G0InvMap C2G0_left
    (rightInverse_of_leftInverse_fin C2G0_left)

public theorem C2G0_eq_word : C2G0 = evalWord C1Gen [0, 0, 0, 1] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def C2G1MapPacked : Nat := 

@[expose] public def C2G1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C2G1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C2G1InvMapPacked : Nat := 

@[expose] public def C2G1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C2G1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C2G1_left : ∀ x, C2G1InvMap (C2G1Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C2G1 : Equiv.Perm (Fin 6156) :=
  tablePerm C2G1Map C2G1InvMap C2G1_left
    (rightInverse_of_leftInverse_fin C2G1_left)

public theorem C2G1_eq_word : C2G1 = evalWord C1Gen [1, 0] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def C2Gen : Fin 4 → Equiv.Perm (Fin 6156)
  | 0 => C2G0
  | 1 => C2G1
  | 2 => C2G0⁻¹
  | 3 => C2G1⁻¹

@[expose] public def C2Inv : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
  | 3 => 1

public theorem C2Inv_spec (i : Fin 4) :
    C2Gen (C2Inv i) = (C2Gen i)⁻¹ := by
  fin_cases i <;> simp only [C2Gen, C2Inv, inv_inv]

@[expose] public def C2H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup C2Gen C2Inv C2Inv_spec

public theorem C2H_le : C2H ≤ C1H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change C2G0 ∈ C1H
    rw [C2G0_eq_word]
    exact ⟨_, rfl⟩
  · change C2G1 ∈ C1H
    rw [C2G1_eq_word]
    exact ⟨_, rfl⟩
  · change (C2G0)⁻¹ ∈ C1H
    apply C1H.inv_mem
    rw [C2G0_eq_word]
    exact ⟨_, rfl⟩
  · change (C2G1)⁻¹ ∈ C1H
    apply C1H.inv_mem
    rw [C2G1_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
