module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.C0

import Mathlib.Tactic.FinCases

/-!
# Generators at level 1 of the C chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def C1G0MapPacked : Nat := 

@[expose] public def C1G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C1G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C1G0InvMapPacked : Nat := 

@[expose] public def C1G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C1G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C1G0_left : ∀ x, C1G0InvMap (C1G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C1G0 : Equiv.Perm (Fin 6156) :=
  tablePerm C1G0Map C1G0InvMap C1G0_left
    (rightInverse_of_leftInverse_fin C1G0_left)

public theorem C1G0_eq_word : C1G0 = evalWord C0Gen [3, 4, 4, 2] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def C1G1MapPacked : Nat := 

@[expose] public def C1G1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C1G1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C1G1InvMapPacked : Nat := 

@[expose] public def C1G1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C1G1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C1G1_left : ∀ x, C1G1InvMap (C1G1Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C1G1 : Equiv.Perm (Fin 6156) :=
  tablePerm C1G1Map C1G1InvMap C1G1_left
    (rightInverse_of_leftInverse_fin C1G1_left)

public theorem C1G1_eq_word : C1G1 = evalWord C0Gen [3, 3, 2, 4, 2] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def C1Gen : Fin 4 → Equiv.Perm (Fin 6156)
  | 0 => C1G0
  | 1 => C1G1
  | 2 => C1G0⁻¹
  | 3 => C1G1⁻¹

@[expose] public def C1Inv : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
  | 3 => 1

public theorem C1Inv_spec (i : Fin 4) :
    C1Gen (C1Inv i) = (C1Gen i)⁻¹ := by
  fin_cases i <;> simp only [C1Gen, C1Inv, inv_inv]

@[expose] public def C1H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup C1Gen C1Inv C1Inv_spec

public theorem C1H_le : C1H ≤ C0H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change C1G0 ∈ C0H
    rw [C1G0_eq_word]
    exact ⟨_, rfl⟩
  · change C1G1 ∈ C0H
    rw [C1G1_eq_word]
    exact ⟨_, rfl⟩
  · change (C1G0)⁻¹ ∈ C0H
    apply C0H.inv_mem
    rw [C1G0_eq_word]
    exact ⟨_, rfl⟩
  · change (C1G1)⁻¹ ∈ C0H
    apply C0H.inv_mem
    rw [C1G1_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
