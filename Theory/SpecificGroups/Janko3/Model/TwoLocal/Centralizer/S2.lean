  apply allLetters
  decide +kernel

@[expose] public def S2Gen : Fin 8 → Equiv.Perm (Fin 6156)
  | 0 => S2G0
  | 1 => S2G1
  | 2 => S2G2
  | 3 => S2G3
  | 4 => S2G0⁻¹
  | 5 => S2G1⁻¹
  | 6 => S2G2⁻¹
  | 7 => S2G3⁻¹

@[expose] public def S2Inv : Fin 8 → Fin 8
  | 0 => 4
  | 1 => 5
  | 2 => 6
  | 3 => 7
  | 4 => 0
  | 5 => 1
  | 6 => 2
  | 7 => 3

public theorem S2Inv_spec (i : Fin 8) :
    S2Gen (S2Inv i) = (S2Gen i)⁻¹ := by
  fin_cases i <;> simp only [S2Gen, S2Inv, inv_inv]

@[expose] public def S2H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup S2Gen S2Inv S2Inv_spec

public theorem S2H_le : S2H ≤ S1H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change S2G0 ∈ S1H
    rw [S2G0_eq_word]
    exact ⟨_, rfl⟩
  · change S2G1 ∈ S1H
    rw [S2G1_eq_word]
    exact ⟨_, rfl⟩
  · change S2G2 ∈ S1H
    rw [S2G2_eq_word]
    exact ⟨_, rfl⟩
  · change S2G3 ∈ S1H
    rw [S2G3_eq_word]
    exact ⟨_, rfl⟩
  · change (S2G0)⁻¹ ∈ S1H
    apply S1H.inv_mem
    rw [S2G0_eq_word]
    exact ⟨_, rfl⟩
  · change (S2G1)⁻¹ ∈ S1H
    apply S1H.inv_mem
    rw [S2G1_eq_word]
    exact ⟨_, rfl⟩
  · change (S2G2)⁻¹ ∈ S1H
    apply S1H.inv_mem
    rw [S2G2_eq_word]
    exact ⟨_, rfl⟩
  · change (S2G3)⁻¹ ∈ S1H
    apply S1H.inv_mem
    rw [S2G3_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
