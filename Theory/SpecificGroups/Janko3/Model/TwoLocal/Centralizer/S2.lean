public theorem S2G1_eq_word : S2G1 = evalWord S1Gen [2] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S2G2MapPacked : Nat := 

@[expose] public def S2G2Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S2G2MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S2G2InvMapPacked : Nat := 

@[expose] public def S2G2InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S2G2InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

