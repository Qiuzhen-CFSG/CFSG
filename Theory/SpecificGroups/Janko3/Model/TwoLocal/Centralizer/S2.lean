  apply allLetters
  decide +kernel

@[expose] public def S2G3MapPacked : Nat := 

@[expose] public def S2G3Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S2G3MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S2G3InvMapPacked : Nat := 

@[expose] public def S2G3InvMap (x : Fin 6156) : Fin 6156 :=
