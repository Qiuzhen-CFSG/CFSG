module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.S1

import Mathlib.Tactic.FinCases

/-!
# Generators at level 2 of the S chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def S2G0MapPacked : Nat := 

@[expose] public def S2G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S2G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S2G0InvMapPacked : Nat := 

@[expose] public def S2G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S2G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S2G0_left : ∀ x, S2G0InvMap (S2G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S2G0 : Equiv.Perm (Fin 6156) :=
  tablePerm S2G0Map S2G0InvMap S2G0_left
    (rightInverse_of_leftInverse_fin S2G0_left)

public theorem S2G0_eq_word : S2G0 = evalWord S1Gen [1] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S2G1MapPacked : Nat := 

@[expose] public def S2G1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S2G1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S2G1InvMapPacked : Nat := 

@[expose] public def S2G1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S2G1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S2G1_left : ∀ x, S2G1InvMap (S2G1Map x) = x := by
