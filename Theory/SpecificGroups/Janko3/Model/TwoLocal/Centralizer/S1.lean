module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.S0

import Mathlib.Tactic.FinCases

/-!
# Generators at level 1 of the S chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def S1G0MapPacked : Nat := 

@[expose] public def S1G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S1G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S1G0InvMapPacked : Nat := 

@[expose] public def S1G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S1G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S1G0_left : ∀ x, S1G0InvMap (S1G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S1G0 : Equiv.Perm (Fin 6156) :=
  tablePerm S1G0Map S1G0InvMap S1G0_left
    (rightInverse_of_leftInverse_fin S1G0_left)

public theorem S1G0_eq_word : S1G0 = evalWord S0Gen [3, 2] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S1G1MapPacked : Nat := 

@[expose] public def S1G1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S1G1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S1G1InvMapPacked : Nat := 

@[expose] public def S1G1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S1G1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S1G1_left : ∀ x, S1G1InvMap (S1G1Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S1G1 : Equiv.Perm (Fin 6156) :=
  tablePerm S1G1Map S1G1InvMap S1G1_left
    (rightInverse_of_leftInverse_fin S1G1_left)

public theorem S1G1_eq_word : S1G1 = evalWord S0Gen [4] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S1G2MapPacked : Nat := 

@[expose] public def S1G2Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S1G2MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S1G2InvMapPacked : Nat := 

@[expose] public def S1G2InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S1G2InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S1G2_left : ∀ x, S1G2InvMap (S1G2Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S1G2 : Equiv.Perm (Fin 6156) :=
  tablePerm S1G2Map S1G2InvMap S1G2_left
    (rightInverse_of_leftInverse_fin S1G2_left)

public theorem S1G2_eq_word : S1G2 = evalWord S0Gen [2, 1, 2] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S1Gen : Fin 6 → Equiv.Perm (Fin 6156)
  | 0 => S1G0
  | 1 => S1G1
  | 2 => S1G2
  | 3 => S1G0⁻¹
  | 4 => S1G1⁻¹
  | 5 => S1G2⁻¹

@[expose] public def S1Inv : Fin 6 → Fin 6
  | 0 => 3
  | 1 => 4
  | 2 => 5
  | 3 => 0
  | 4 => 1
  | 5 => 2

public theorem S1Inv_spec (i : Fin 6) :
    S1Gen (S1Inv i) = (S1Gen i)⁻¹ := by
  fin_cases i <;> simp only [S1Gen, S1Inv, inv_inv]

@[expose] public def S1H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup S1Gen S1Inv S1Inv_spec

public theorem S1H_le : S1H ≤ S0H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change S1G0 ∈ S0H
    rw [S1G0_eq_word]
    exact ⟨_, rfl⟩
  · change S1G1 ∈ S0H
    rw [S1G1_eq_word]
    exact ⟨_, rfl⟩
  · change S1G2 ∈ S0H
    rw [S1G2_eq_word]
    exact ⟨_, rfl⟩
  · change (S1G0)⁻¹ ∈ S0H
    apply S0H.inv_mem
    rw [S1G0_eq_word]
    exact ⟨_, rfl⟩
  · change (S1G1)⁻¹ ∈ S0H
    apply S0H.inv_mem
    rw [S1G1_eq_word]
    exact ⟨_, rfl⟩
  · change (S1G2)⁻¹ ∈ S0H
    apply S0H.inv_mem
    rw [S1G2_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
