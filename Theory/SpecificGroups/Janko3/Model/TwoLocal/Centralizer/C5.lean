module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.C4

import Mathlib.Tactic.FinCases

/-!
# Generators at level 5 of the C chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def C5G0MapPacked : Nat := 

@[expose] public def C5G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C5G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C5G0InvMapPacked : Nat := 

@[expose] public def C5G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C5G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C5G0_left : ∀ x, C5G0InvMap (C5G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C5G0 : Equiv.Perm (Fin 6156) :=
  tablePerm C5G0Map C5G0InvMap C5G0_left
    (rightInverse_of_leftInverse_fin C5G0_left)

public theorem C5G0_eq_word : C5G0 = evalWord C4Gen [0] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def C5Gen : Fin 2 → Equiv.Perm (Fin 6156)
  | 0 => C5G0
  | 1 => C5G0⁻¹

@[expose] public def C5Inv : Fin 2 → Fin 2
  | 0 => 1
  | 1 => 0

public theorem C5Inv_spec (i : Fin 2) :
    C5Gen (C5Inv i) = (C5Gen i)⁻¹ := by
  fin_cases i <;> simp only [C5Gen, C5Inv, inv_inv]

@[expose] public def C5H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup C5Gen C5Inv C5Inv_spec

public theorem C5H_le : C5H ≤ C4H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change C5G0 ∈ C4H
    rw [C5G0_eq_word]
    exact ⟨_, rfl⟩
  · change (C5G0)⁻¹ ∈ C4H
    apply C4H.inv_mem
    rw [C5G0_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
