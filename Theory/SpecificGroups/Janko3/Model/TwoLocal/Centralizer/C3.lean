module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.C2

import Mathlib.Tactic.FinCases

/-!
# Generators at level 3 of the C chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def C3G0MapPacked : Nat := 

@[expose] public def C3G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C3G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C3G0InvMapPacked : Nat := 

@[expose] public def C3G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C3G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C3G0_left : ∀ x, C3G0InvMap (C3G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C3G0 : Equiv.Perm (Fin 6156) :=
  tablePerm C3G0Map C3G0InvMap C3G0_left
    (rightInverse_of_leftInverse_fin C3G0_left)

public theorem C3G0_eq_word : C3G0 = evalWord C2Gen [0, 0] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def C3G1MapPacked : Nat := 

@[expose] public def C3G1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C3G1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C3G1InvMapPacked : Nat := 

@[expose] public def C3G1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C3G1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C3G1_left : ∀ x, C3G1InvMap (C3G1Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C3G1 : Equiv.Perm (Fin 6156) :=
  tablePerm C3G1Map C3G1InvMap C3G1_left
    (rightInverse_of_leftInverse_fin C3G1_left)

public theorem C3G1_eq_word : C3G1 = evalWord C2Gen [1, 0] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def C3Gen : Fin 4 → Equiv.Perm (Fin 6156)
  | 0 => C3G0
  | 1 => C3G1
  | 2 => C3G0⁻¹
  | 3 => C3G1⁻¹

@[expose] public def C3Inv : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
  | 3 => 1

public theorem C3Inv_spec (i : Fin 4) :
    C3Gen (C3Inv i) = (C3Gen i)⁻¹ := by
  fin_cases i <;> simp only [C3Gen, C3Inv, inv_inv]

@[expose] public def C3H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup C3Gen C3Inv C3Inv_spec

public theorem C3H_le : C3H ≤ C2H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change C3G0 ∈ C2H
    rw [C3G0_eq_word]
    exact ⟨_, rfl⟩
  · change C3G1 ∈ C2H
    rw [C3G1_eq_word]
    exact ⟨_, rfl⟩
  · change (C3G0)⁻¹ ∈ C2H
    apply C2H.inv_mem
    rw [C3G0_eq_word]
    exact ⟨_, rfl⟩
  · change (C3G1)⁻¹ ∈ C2H
    apply C2H.inv_mem
    rw [C3G1_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
