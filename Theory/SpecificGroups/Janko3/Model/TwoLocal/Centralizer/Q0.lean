@[expose] public def Q0Gen : Fin 10 → Equiv.Perm (Fin 6156)
  | 0 => Q0G0
  | 1 => Q0G1
  | 2 => Q0G2
  | 3 => Q0G3
  | 4 => Q0G4
  | 5 => Q0G0⁻¹
  | 6 => Q0G1⁻¹
  | 7 => Q0G2⁻¹
  | 8 => Q0G3⁻¹
  | 9 => Q0G4⁻¹

@[expose] public def Q0Inv : Fin 10 → Fin 10
  | 0 => 5
  | 1 => 6
  | 2 => 7
  | 3 => 8
  | 4 => 9
  | 5 => 0
  | 6 => 1
  | 7 => 2
  | 8 => 3
  | 9 => 4

public theorem Q0Inv_spec (i : Fin 10) :
    Q0Gen (Q0Inv i) = (Q0Gen i)⁻¹ := by
  fin_cases i <;> simp only [Q0Gen, Q0Inv, inv_inv]

@[expose] public def Q0H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup Q0Gen Q0Inv Q0Inv_spec

public theorem Q0H_le : Q0H ≤ C0H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change Q0G0 ∈ C0H
    rw [Q0G0_eq_word]
    exact ⟨_, rfl⟩
  · change Q0G1 ∈ C0H
    rw [Q0G1_eq_word]
    exact ⟨_, rfl⟩
  · change Q0G2 ∈ C0H
    rw [Q0G2_eq_word]
    exact ⟨_, rfl⟩
  · change Q0G3 ∈ C0H
    rw [Q0G3_eq_word]
    exact ⟨_, rfl⟩
  · change Q0G4 ∈ C0H
    rw [Q0G4_eq_word]
    exact ⟨_, rfl⟩
  · change (Q0G0)⁻¹ ∈ C0H
    apply C0H.inv_mem
    rw [Q0G0_eq_word]
    exact ⟨_, rfl⟩
  · change (Q0G1)⁻¹ ∈ C0H
    apply C0H.inv_mem
    rw [Q0G1_eq_word]
    exact ⟨_, rfl⟩
  · change (Q0G2)⁻¹ ∈ C0H
    apply C0H.inv_mem
    rw [Q0G2_eq_word]
    exact ⟨_, rfl⟩
  · change (Q0G3)⁻¹ ∈ C0H
    apply C0H.inv_mem
    rw [Q0G3_eq_word]
    exact ⟨_, rfl⟩
  · change (Q0G4)⁻¹ ∈ C0H
    apply C0H.inv_mem
    rw [Q0G4_eq_word]
    exact ⟨_, rfl⟩

