import Mathlib.Tactic.FinCases

/-!
# Generators at level 0 of the C chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def C0G0MapPacked : Nat := 

@[expose] public def C0G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C0G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C0G0InvMapPacked : Nat := 

@[expose] public def C0G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C0G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C0G0_left : ∀ x, C0G0InvMap (C0G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C0G0 : Equiv.Perm (Fin 6156) :=
  tablePerm C0G0Map C0G0InvMap C0G0_left
    (rightInverse_of_leftInverse_fin C0G0_left)

public theorem C0G0_eq_generator : C0G0 =
    (centralizerGenerator 0 : Equiv.Perm (Fin 6156)) := by
  change C0G0 = evalWord L0Gen (centralizerWord0 0) *
    evalWord L1Gen (centralizerWord1 0) * evalWord L2Gen (centralizerWord2 0)
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

