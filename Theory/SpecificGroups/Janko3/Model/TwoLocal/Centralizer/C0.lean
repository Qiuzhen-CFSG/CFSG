@[expose] public def C0Gen : Fin 10 → Equiv.Perm (Fin 6156)
  | 0 => C0G0
  | 1 => C0G1
  | 2 => C0G2
  | 3 => C0G3
  | 4 => C0G4
  | 5 => C0G0⁻¹
  | 6 => C0G1⁻¹
  | 7 => C0G2⁻¹
  | 8 => C0G3⁻¹
  | 9 => C0G4⁻¹

@[expose] public def C0Inv : Fin 10 → Fin 10
  | 0 => 5
  | 1 => 6
  | 2 => 7
  | 3 => 8
  | 4 => 9
  | 5 => 0
  | 6 => 1
  | 7 => 2
  | 8 => 3
  | 9 => 4

public theorem C0Inv_spec (i : Fin 10) :
    C0Gen (C0Inv i) = (C0Gen i)⁻¹ := by
  fin_cases i <;> simp only [C0Gen, C0Inv, inv_inv]

@[expose] public def C0H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup C0Gen C0Inv C0Inv_spec

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
