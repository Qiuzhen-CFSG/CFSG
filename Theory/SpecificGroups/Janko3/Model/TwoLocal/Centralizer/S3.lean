module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.S2

import Mathlib.Tactic.FinCases

/-!
# Generators at level 3 of the S chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def S3G0MapPacked : Nat := 

@[expose] public def S3G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S3G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S3G0InvMapPacked : Nat := 

@[expose] public def S3G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S3G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S3G0_left : ∀ x, S3G0InvMap (S3G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S3G0 : Equiv.Perm (Fin 6156) :=
  tablePerm S3G0Map S3G0InvMap S3G0_left
    (rightInverse_of_leftInverse_fin S3G0_left)

public theorem S3G0_eq_word : S3G0 = evalWord S2Gen [3] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S3G1MapPacked : Nat := 

@[expose] public def S3G1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S3G1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S3G1InvMapPacked : Nat := 

@[expose] public def S3G1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S3G1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S3G1_left : ∀ x, S3G1InvMap (S3G1Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S3G1 : Equiv.Perm (Fin 6156) :=
  tablePerm S3G1Map S3G1InvMap S3G1_left
    (rightInverse_of_leftInverse_fin S3G1_left)

public theorem S3G1_eq_word : S3G1 = evalWord S2Gen [1, 0] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S3G2MapPacked : Nat := 

@[expose] public def S3G2Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S3G2MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S3G2InvMapPacked : Nat := 

@[expose] public def S3G2InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S3G2InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S3G2_left : ∀ x, S3G2InvMap (S3G2Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S3G2 : Equiv.Perm (Fin 6156) :=
  tablePerm S3G2Map S3G2InvMap S3G2_left
    (rightInverse_of_leftInverse_fin S3G2_left)

public theorem S3G2_eq_word : S3G2 = evalWord S2Gen [2, 0] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S3Gen : Fin 6 → Equiv.Perm (Fin 6156)
  | 0 => S3G0
  | 1 => S3G1
  | 2 => S3G2
  | 3 => S3G0⁻¹
  | 4 => S3G1⁻¹
  | 5 => S3G2⁻¹

@[expose] public def S3Inv : Fin 6 → Fin 6
  | 0 => 3
  | 1 => 4
  | 2 => 5
  | 3 => 0
  | 4 => 1
  | 5 => 2

public theorem S3Inv_spec (i : Fin 6) :
    S3Gen (S3Inv i) = (S3Gen i)⁻¹ := by
  fin_cases i <;> simp only [S3Gen, S3Inv, inv_inv]

@[expose] public def S3H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup S3Gen S3Inv S3Inv_spec

public theorem S3H_le : S3H ≤ S2H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change S3G0 ∈ S2H
    rw [S3G0_eq_word]
    exact ⟨_, rfl⟩
  · change S3G1 ∈ S2H
    rw [S3G1_eq_word]
    exact ⟨_, rfl⟩
  · change S3G2 ∈ S2H
    rw [S3G2_eq_word]
    exact ⟨_, rfl⟩
  · change (S3G0)⁻¹ ∈ S2H
    apply S2H.inv_mem
    rw [S3G0_eq_word]
    exact ⟨_, rfl⟩
  · change (S3G1)⁻¹ ∈ S2H
    apply S2H.inv_mem
    rw [S3G1_eq_word]
    exact ⟨_, rfl⟩
  · change (S3G2)⁻¹ ∈ S2H
    apply S2H.inv_mem
    rw [S3G2_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
