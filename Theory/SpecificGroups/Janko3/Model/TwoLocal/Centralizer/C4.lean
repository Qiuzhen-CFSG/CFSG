module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.C3

import Mathlib.Tactic.FinCases

/-!
# Generators at level 4 of the C chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def C4G0MapPacked : Nat := 

@[expose] public def C4G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C4G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C4G0InvMapPacked : Nat := 

@[expose] public def C4G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C4G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C4G0_left : ∀ x, C4G0InvMap (C4G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C4G0 : Equiv.Perm (Fin 6156) :=
  tablePerm C4G0Map C4G0InvMap C4G0_left
    (rightInverse_of_leftInverse_fin C4G0_left)

public theorem C4G0_eq_word : C4G0 = evalWord C3Gen [1, 0] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def C4G1MapPacked : Nat := 

@[expose] public def C4G1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(C4G1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def C4G1InvMapPacked : Nat := 

@[expose] public def C4G1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(C4G1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem C4G1_left : ∀ x, C4G1InvMap (C4G1Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def C4G1 : Equiv.Perm (Fin 6156) :=
  tablePerm C4G1Map C4G1InvMap C4G1_left
    (rightInverse_of_leftInverse_fin C4G1_left)

public theorem C4G1_eq_word : C4G1 = evalWord C3Gen [0, 1] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def C4Gen : Fin 4 → Equiv.Perm (Fin 6156)
  | 0 => C4G0
  | 1 => C4G1
  | 2 => C4G0⁻¹
  | 3 => C4G1⁻¹

@[expose] public def C4Inv : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
  | 3 => 1

public theorem C4Inv_spec (i : Fin 4) :
    C4Gen (C4Inv i) = (C4Gen i)⁻¹ := by
  fin_cases i <;> simp only [C4Gen, C4Inv, inv_inv]

@[expose] public def C4H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup C4Gen C4Inv C4Inv_spec

public theorem C4H_le : C4H ≤ C3H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change C4G0 ∈ C3H
    rw [C4G0_eq_word]
    exact ⟨_, rfl⟩
  · change C4G1 ∈ C3H
    rw [C4G1_eq_word]
    exact ⟨_, rfl⟩
  · change (C4G0)⁻¹ ∈ C3H
    apply C3H.inv_mem
    rw [C4G0_eq_word]
    exact ⟨_, rfl⟩
  · change (C4G1)⁻¹ ∈ C3H
    apply C3H.inv_mem
    rw [C4G1_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
