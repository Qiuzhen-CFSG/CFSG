module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.Q0

import Mathlib.Tactic.FinCases

/-!
# Generators at level 1 of the Q chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def Q1G0MapPacked : Nat := 

@[expose] public def Q1G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(Q1G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def Q1G0InvMapPacked : Nat := 

@[expose] public def Q1G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(Q1G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem Q1G0_left : ∀ x, Q1G0InvMap (Q1G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def Q1G0 : Equiv.Perm (Fin 6156) :=
  tablePerm Q1G0Map Q1G0InvMap Q1G0_left
    (rightInverse_of_leftInverse_fin Q1G0_left)

public theorem Q1G0_eq_word : Q1G0 = evalWord Q0Gen [4, 2] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def Q1G1MapPacked : Nat := 

@[expose] public def Q1G1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(Q1G1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def Q1G1InvMapPacked : Nat := 

@[expose] public def Q1G1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(Q1G1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem Q1G1_left : ∀ x, Q1G1InvMap (Q1G1Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def Q1G1 : Equiv.Perm (Fin 6156) :=
  tablePerm Q1G1Map Q1G1InvMap Q1G1_left
    (rightInverse_of_leftInverse_fin Q1G1_left)

public theorem Q1G1_eq_word : Q1G1 = evalWord Q0Gen [1] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def Q1Gen : Fin 4 → Equiv.Perm (Fin 6156)
  | 0 => Q1G0
  | 1 => Q1G1
  | 2 => Q1G0⁻¹
  | 3 => Q1G1⁻¹

@[expose] public def Q1Inv : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
  | 3 => 1

public theorem Q1Inv_spec (i : Fin 4) :
    Q1Gen (Q1Inv i) = (Q1Gen i)⁻¹ := by
  fin_cases i <;> simp only [Q1Gen, Q1Inv, inv_inv]

@[expose] public def Q1H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup Q1Gen Q1Inv Q1Inv_spec

public theorem Q1H_le : Q1H ≤ Q0H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change Q1G0 ∈ Q0H
    rw [Q1G0_eq_word]
    exact ⟨_, rfl⟩
  · change Q1G1 ∈ Q0H
    rw [Q1G1_eq_word]
    exact ⟨_, rfl⟩
  · change (Q1G0)⁻¹ ∈ Q0H
    apply Q0H.inv_mem
    rw [Q1G0_eq_word]
    exact ⟨_, rfl⟩
  · change (Q1G1)⁻¹ ∈ Q0H
    apply Q0H.inv_mem
    rw [Q1G1_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
