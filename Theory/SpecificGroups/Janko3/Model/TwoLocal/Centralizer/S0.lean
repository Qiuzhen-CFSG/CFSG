@[expose] public def S0Gen : Fin 10 → Equiv.Perm (Fin 6156)
  | 0 => S0G0
  | 1 => S0G1
  | 2 => S0G2
  | 3 => S0G3
  | 4 => S0G4
  | 5 => S0G0⁻¹
  | 6 => S0G1⁻¹
  | 7 => S0G2⁻¹
  | 8 => S0G3⁻¹
  | 9 => S0G4⁻¹

@[expose] public def S0Inv : Fin 10 → Fin 10
  | 0 => 5
  | 1 => 6
  | 2 => 7
  | 3 => 8
  | 4 => 9
  | 5 => 0
  | 6 => 1
  | 7 => 2
  | 8 => 3
  | 9 => 4

public theorem S0Inv_spec (i : Fin 10) :
    S0Gen (S0Inv i) = (S0Gen i)⁻¹ := by
  fin_cases i <;> simp only [S0Gen, S0Inv, inv_inv]

@[expose] public def S0H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup S0Gen S0Inv S0Inv_spec

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
