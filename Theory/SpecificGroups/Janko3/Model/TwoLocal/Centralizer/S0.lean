module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Generators
public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators

import Mathlib.Tactic.FinCases

/-!
# Generators at level 0 of the S chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def S0G0MapPacked : Nat := 

@[expose] public def S0G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S0G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S0G0InvMapPacked : Nat := 

@[expose] public def S0G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S0G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S0G0_left : ∀ x, S0G0InvMap (S0G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S0G0 : Equiv.Perm (Fin 6156) :=
  tablePerm S0G0Map S0G0InvMap S0G0_left
    (rightInverse_of_leftInverse_fin S0G0_left)

public theorem S0G0_eq_generator : S0G0 =
    (sylowGenerator 0 : Equiv.Perm (Fin 6156)) := by
  change S0G0 = evalWord L0Gen (sylowWord0 0) *
    evalWord L1Gen (sylowWord1 0) * evalWord L2Gen (sylowWord2 0)
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

