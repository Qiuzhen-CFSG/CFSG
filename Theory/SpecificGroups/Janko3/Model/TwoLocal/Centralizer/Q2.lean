module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.Q1

import Mathlib.Tactic.FinCases

/-!
# Generators at level 2 of the Q chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def Q2G0MapPacked : Nat := 

@[expose] public def Q2G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(Q2G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def Q2G0InvMapPacked : Nat := 

@[expose] public def Q2G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(Q2G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem Q2G0_left : ∀ x, Q2G0InvMap (Q2G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def Q2G0 : Equiv.Perm (Fin 6156) :=
  tablePerm Q2G0Map Q2G0InvMap Q2G0_left
    (rightInverse_of_leftInverse_fin Q2G0_left)

public theorem Q2G0_eq_word : Q2G0 = evalWord Q1Gen [1, 0] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def Q2Gen : Fin 2 → Equiv.Perm (Fin 6156)
  | 0 => Q2G0
  | 1 => Q2G0⁻¹

@[expose] public def Q2Inv : Fin 2 → Fin 2
  | 0 => 1
  | 1 => 0

public theorem Q2Inv_spec (i : Fin 2) :
    Q2Gen (Q2Inv i) = (Q2Gen i)⁻¹ := by
  fin_cases i <;> simp only [Q2Gen, Q2Inv, inv_inv]

@[expose] public def Q2H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup Q2Gen Q2Inv Q2Inv_spec

public theorem Q2H_le : Q2H ≤ Q1H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change Q2G0 ∈ Q1H
    rw [Q2G0_eq_word]
    exact ⟨_, rfl⟩
  · change (Q2G0)⁻¹ ∈ Q1H
    apply Q1H.inv_mem
    rw [Q2G0_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
