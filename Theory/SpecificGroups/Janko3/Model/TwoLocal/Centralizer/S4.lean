module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.S3

import Mathlib.Tactic.FinCases

/-!
# Generators at level 4 of the S chain

Finite permutation certificates for the fixed word-generated J₃ two-local
candidates. The retained ATLAS action is on 6156 letters. Packed maps are
checked against words in the preceding generators; all transition identities
are checked by the Lean kernel on every letter. The generating Python script
is discovery and code generation only, and contributes no proof premise.

Source: GLS, volume 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.TwoLocal.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def S4G0MapPacked : Nat := 

@[expose] public def S4G0Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S4G0MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S4G0InvMapPacked : Nat := 

@[expose] public def S4G0InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S4G0InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S4G0_left : ∀ x, S4G0InvMap (S4G0Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S4G0 : Equiv.Perm (Fin 6156) :=
  tablePerm S4G0Map S4G0InvMap S4G0_left
    (rightInverse_of_leftInverse_fin S4G0_left)

public theorem S4G0_eq_word : S4G0 = evalWord S3Gen [2] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S4G1MapPacked : Nat := 

@[expose] public def S4G1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(S4G1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def S4G1InvMapPacked : Nat := 

@[expose] public def S4G1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(S4G1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem S4G1_left : ∀ x, S4G1InvMap (S4G1Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def S4G1 : Equiv.Perm (Fin 6156) :=
  tablePerm S4G1Map S4G1InvMap S4G1_left
    (rightInverse_of_leftInverse_fin S4G1_left)

public theorem S4G1_eq_word : S4G1 = evalWord S3Gen [1, 0] := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def S4Gen : Fin 4 → Equiv.Perm (Fin 6156)
  | 0 => S4G0
  | 1 => S4G1
  | 2 => S4G0⁻¹
  | 3 => S4G1⁻¹

@[expose] public def S4Inv : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
  | 3 => 1

public theorem S4Inv_spec (i : Fin 4) :
    S4Gen (S4Inv i) = (S4Gen i)⁻¹ := by
  fin_cases i <;> simp only [S4Gen, S4Inv, inv_inv]

@[expose] public def S4H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup S4Gen S4Inv S4Inv_spec

public theorem S4H_le : S4H ≤ S3H := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  fin_cases i
  · change S4G0 ∈ S3H
    rw [S4G0_eq_word]
    exact ⟨_, rfl⟩
  · change S4G1 ∈ S3H
    rw [S4G1_eq_word]
    exact ⟨_, rfl⟩
  · change (S4G0)⁻¹ ∈ S3H
    apply S3H.inv_mem
    rw [S4G0_eq_word]
    exact ⟨_, rfl⟩
  · change (S4G1)⁻¹ ∈ S3H
    apply S3H.inv_mem
    rw [S4G1_eq_word]
    exact ⟨_, rfl⟩

end Sporadic.Janko3.TwoLocal.CentralizerCertificate
