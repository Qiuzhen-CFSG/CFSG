module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Generators
public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators

/-!
# A packed generator for the order-1152 J₃ local candidate

The packed map is checked on every letter against the original word-defined
model element. The table is computational data, not a proof premise.
Source: ATLAS J3G1-p6156B0; GLS 3, Table 5.3h, printed p.269.
-/

namespace Sporadic.Janko3.TwoLocal.ThompsonCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def g4MapPacked : Nat := 

@[expose] public def g4Map (x : Fin 6156) : Fin 6156 :=
  ⟨(g4MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def g4InvMapPacked : Nat := 

@[expose] public def g4InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(g4InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

private theorem g4_left : ∀ x, g4InvMap (g4Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def g4Perm : Equiv.Perm (Fin 6156) :=
  tablePerm g4Map g4InvMap (by exact g4_left) (by exact rightInverse_of_leftInverse_fin g4_left)

private theorem g4Perm_eq : g4Perm = (thompsonNormalizerGenerator 2 : Equiv.Perm (Fin 6156)) := by
  change g4Perm = evalWord L0Gen (thompsonNormalizerWord0 2) *
    evalWord L1Gen (thompsonNormalizerWord1 2) * evalWord L2Gen (thompsonNormalizerWord2 2)
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def g4 : Model :=
  ⟨g4Perm, by exact g4Perm_eq.symm ▸ (thompsonNormalizerGenerator 2).property⟩

public theorem g4_eq : g4 = thompsonNormalizerGenerator 2 :=
  Subtype.ext g4Perm_eq

end Sporadic.Janko3.TwoLocal.ThompsonCertificate
