module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Generators
public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators

/-!
# A packed generator for the order-1152 J₃ local candidate

The packed map is checked on every letter against the original word-defined
model element. The table is computational data, not a proof premise.
Source: ATLAS J3G1-p6156B0; GLS 3, Table 5.3h, printed p.269.
-/

namespace Sporadic.Janko3.TwoLocal.ThompsonCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def g6MapPacked : Nat := 

@[expose] public def g6Map (x : Fin 6156) : Fin 6156 :=
  ⟨(g6MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def g6InvMapPacked : Nat := 

@[expose] public def g6InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(g6InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

private theorem g6_left : ∀ x, g6InvMap (g6Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def g6Perm : Equiv.Perm (Fin 6156) :=
  tablePerm g6Map g6InvMap (by exact g6_left) (by exact rightInverse_of_leftInverse_fin g6_left)

private theorem g6Perm_eq : g6Perm = (thompsonNormalizerGenerator 7 : Equiv.Perm (Fin 6156)) := by
  change g6Perm = evalWord L0Gen (thompsonNormalizerWord0 7) *
    evalWord L1Gen (thompsonNormalizerWord1 7) * evalWord L2Gen (thompsonNormalizerWord2 7)
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def g6 : Model :=
  ⟨g6Perm, by exact g6Perm_eq.symm ▸ (thompsonNormalizerGenerator 7).property⟩

public theorem g6_eq : g6 = thompsonNormalizerGenerator 7 :=
  Subtype.ext g6Perm_eq

end Sporadic.Janko3.TwoLocal.ThompsonCertificate
