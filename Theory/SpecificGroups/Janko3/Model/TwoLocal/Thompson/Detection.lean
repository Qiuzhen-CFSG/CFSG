module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Thompson.Data

/-!
# Separating and centralizer-detecting letters for the J₃ local normal forms

The image of letter 29 separates the 1152 normal forms. For every form outside
the first 64, an explicit generator among the first six and an explicit letter
witness failure to commute. These checks need only individual images, since a
single unequal image disproves equality of permutations.
Source: ATLAS J3G1-p6156B0; GLS 3, Table 5.3h, printed p.269.
-/

namespace Sporadic.Janko3.TwoLocal.ThompsonCertificate
open OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000
set_option Elab.async false

@[expose] public def pointInversePacked : Nat := 

@[expose] public def pointInverse (x : Fin 6156) : Fin 1152 :=
  ⟨(pointInversePacked >>> (11 * x.val)) % 2048 % 1152, Nat.mod_lt _ (by decide)⟩

@[expose] public def detectGeneratorPacked : Nat := 

@[expose] public def detectGenerator (x : Fin 1152) : Fin 6 :=
  ⟨(detectGeneratorPacked >>> (3 * x.val)) % 8 % 6, Nat.mod_lt _ (by decide)⟩

@[expose] public def detectPointPacked : Nat := 0

@[expose] public def detectPoint (x : Fin 1152) : Fin 6156 :=
  ⟨(detectPointPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem representative_injective :
    Function.Injective (fun r : Fin 1152 => representative 9 r.val) := by
  have h : ∀ r : Fin 1152,
      pointInverse ((representative 9 r.val : Equiv.Perm (Fin 6156)) 29) = r := by
    apply allFin
    decide +kernel
  intro a b hab
  change representative 9 a.val = representative 9 b.val at hab
  rw [← h a, ← h b, hab]

public theorem core_representative_injective :
    Function.Injective (fun r : Fin 64 => representative 6 r.val) := by
  have h : ∀ r : Fin 64,
      (pointInverse ((representative 6 r.val : Equiv.Perm (Fin 6156)) 29)).val = r.val := by
    apply allFin
    decide +kernel
  intro a b hab
  change representative 6 a.val = representative 6 b.val at hab
  apply Fin.ext
  rw [← h a, ← h b, hab]

public theorem core_representative_agrees (r : Fin 64) :
    representative 9 r.val = representative 6 r.val := by
  have h : ∀ r : Fin 64,
      r.val / width 8 = 0 ∧ r.val % width 8 = r.val ∧
      r.val / width 7 = 0 ∧ r.val % width 7 = r.val ∧
      r.val / width 6 = 0 ∧ r.val % width 6 = r.val := by
    decide +kernel
  obtain ⟨h8, h8', h7, h7', h6, h6'⟩ := h r
  change gen 8 ^ (r.val / width 8) *
    NormalForm.rep gen radix 8 (r.val % width 8) = representative 6 r.val
  rw [h8, h8', pow_zero, one_mul]
  change gen 7 ^ (r.val / width 7) *
    NormalForm.rep gen radix 7 (r.val % width 7) = representative 6 r.val
  rw [h7, h7', pow_zero, one_mul]
  change gen 6 ^ (r.val / width 6) *
    NormalForm.rep gen radix 6 (r.val % width 6) = representative 6 r.val
  rw [h6, h6', pow_zero, one_mul]
  rfl

public theorem outside_core_noncommuting (r : Fin 1152) (hr : 64 ≤ r.val) :
    ((representative 9 r.val * gen (detectGenerator r).val : Model) :
      Equiv.Perm (Fin 6156)) (detectPoint r) ≠
    ((gen (detectGenerator r).val * representative 9 r.val : Model) :
      Equiv.Perm (Fin 6156)) (detectPoint r) := by
  have h : ∀ r : Fin 1152, 64 ≤ r.val →
      ((representative 9 r.val * gen (detectGenerator r).val : Model) :
        Equiv.Perm (Fin 6156)) (detectPoint r) ≠
      ((gen (detectGenerator r).val * representative 9 r.val : Model) :
        Equiv.Perm (Fin 6156)) (detectPoint r) := by
    apply allFin
    decide +kernel
  exact h r hr

end Sporadic.Janko3.TwoLocal.ThompsonCertificate
