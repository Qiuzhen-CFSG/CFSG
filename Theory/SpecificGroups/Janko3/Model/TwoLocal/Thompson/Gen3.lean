module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Generators
public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators

/-!
# A packed generator for the order-1152 J₃ local candidate

The packed map is checked on every letter against the original word-defined
model element. The table is computational data, not a proof premise.
Source: ATLAS J3G1-p6156B0; GLS 3, Table 5.3h, printed p.269.
-/

namespace Sporadic.Janko3.TwoLocal.ThompsonCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def g3MapPacked : Nat := 

@[expose] public def g3Map (x : Fin 6156) : Fin 6156 :=
  ⟨(g3MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def g3InvMapPacked : Nat := 

@[expose] public def g3InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(g3InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

private theorem g3_left : ∀ x, g3InvMap (g3Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def g3Perm : Equiv.Perm (Fin 6156) :=
  tablePerm g3Map g3InvMap (by exact g3_left) (by exact rightInverse_of_leftInverse_fin g3_left)

private theorem g3Perm_eq : g3Perm = (thompsonNormalizerGenerator 3 : Equiv.Perm (Fin 6156)) := by
  change g3Perm = evalWord L0Gen (thompsonNormalizerWord0 3) *
    evalWord L1Gen (thompsonNormalizerWord1 3) * evalWord L2Gen (thompsonNormalizerWord2 3)
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def g3 : Model :=
  ⟨g3Perm, by exact g3Perm_eq.symm ▸ (thompsonNormalizerGenerator 3).property⟩

public theorem g3_eq : g3 = thompsonNormalizerGenerator 3 :=
  Subtype.ext g3Perm_eq

end Sporadic.Janko3.TwoLocal.ThompsonCertificate
