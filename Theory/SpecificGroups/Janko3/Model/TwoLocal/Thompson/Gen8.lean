module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Generators
public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators

/-!
# A packed generator for the order-1152 J₃ local candidate

The packed map is checked on every letter against the original word-defined
model element. The table is computational data, not a proof premise.
Source: ATLAS J3G1-p6156B0; GLS 3, Table 5.3h, printed p.269.
-/

namespace Sporadic.Janko3.TwoLocal.ThompsonCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def g8MapPacked : Nat := 

@[expose] public def g8Map (x : Fin 6156) : Fin 6156 :=
  ⟨(g8MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def g8InvMapPacked : Nat := 

@[expose] public def g8InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(g8InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

private theorem g8_left : ∀ x, g8InvMap (g8Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def g8Perm : Equiv.Perm (Fin 6156) :=
  tablePerm g8Map g8InvMap (by exact g8_left) (by exact rightInverse_of_leftInverse_fin g8_left)

private theorem g8Perm_eq : g8Perm = (thompsonNormalizerGenerator 6 : Equiv.Perm (Fin 6156)) := by
  change g8Perm = evalWord L0Gen (thompsonNormalizerWord0 6) *
    evalWord L1Gen (thompsonNormalizerWord1 6) * evalWord L2Gen (thompsonNormalizerWord2 6)
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def g8 : Model :=
  ⟨g8Perm, by exact g8Perm_eq.symm ▸ (thompsonNormalizerGenerator 6).property⟩

public theorem g8_eq : g8 = thompsonNormalizerGenerator 6 :=
  Subtype.ext g8Perm_eq

end Sporadic.Janko3.TwoLocal.ThompsonCertificate
