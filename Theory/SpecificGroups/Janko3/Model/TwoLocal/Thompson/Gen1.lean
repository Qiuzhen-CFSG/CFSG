module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Generators
public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators

/-!
# A packed generator for the order-1152 J₃ local candidate

The packed map is checked on every letter against the original word-defined
model element. The table is computational data, not a proof premise.
Source: ATLAS J3G1-p6156B0; GLS 3, Table 5.3h, printed p.269.
-/

namespace Sporadic.Janko3.TwoLocal.ThompsonCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def g1MapPacked : Nat := 

@[expose] public def g1Map (x : Fin 6156) : Fin 6156 :=
  ⟨(g1MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def g1InvMapPacked : Nat := 

@[expose] public def g1InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(g1InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

private theorem g1_left : ∀ x, g1InvMap (g1Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def g1Perm : Equiv.Perm (Fin 6156) :=
  tablePerm g1Map g1InvMap (by exact g1_left) (by exact rightInverse_of_leftInverse_fin g1_left)

private theorem g1Perm_eq : g1Perm = (thompsonNormalizerGenerator 0 : Equiv.Perm (Fin 6156)) := by
  change g1Perm = evalWord L0Gen (thompsonNormalizerWord0 0) *
    evalWord L1Gen (thompsonNormalizerWord1 0) * evalWord L2Gen (thompsonNormalizerWord2 0)
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def g1 : Model :=
  ⟨g1Perm, by exact g1Perm_eq.symm ▸ (thompsonNormalizerGenerator 0).property⟩

public theorem g1_eq : g1 = thompsonNormalizerGenerator 0 :=
  Subtype.ext g1Perm_eq

end Sporadic.Janko3.TwoLocal.ThompsonCertificate
