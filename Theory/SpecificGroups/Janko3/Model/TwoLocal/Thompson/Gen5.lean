module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Generators
public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators

/-!
# A packed generator for the order-1152 J₃ local candidate

The packed map is checked on every letter against the original word-defined
model element. The table is computational data, not a proof premise.
Source: ATLAS J3G1-p6156B0; GLS 3, Table 5.3h, printed p.269.
-/

namespace Sporadic.Janko3.TwoLocal.ThompsonCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def g5MapPacked : Nat := 

@[expose] public def g5Map (x : Fin 6156) : Fin 6156 :=
  ⟨(g5MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def g5InvMapPacked : Nat := 

@[expose] public def g5InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(g5InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

private theorem g5_left : ∀ x, g5InvMap (g5Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def g5Perm : Equiv.Perm (Fin 6156) :=
  tablePerm g5Map g5InvMap (by exact g5_left) (by exact rightInverse_of_leftInverse_fin g5_left)

private theorem g5Perm_eq : g5Perm = (thompsonNormalizerGenerator 1 : Equiv.Perm (Fin 6156)) := by
  change g5Perm = evalWord L0Gen (thompsonNormalizerWord0 1) *
    evalWord L1Gen (thompsonNormalizerWord1 1) * evalWord L2Gen (thompsonNormalizerWord2 1)
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def g5 : Model :=
  ⟨g5Perm, by exact g5Perm_eq.symm ▸ (thompsonNormalizerGenerator 1).property⟩

public theorem g5_eq : g5 = thompsonNormalizerGenerator 1 :=
  Subtype.ext g5Perm_eq

end Sporadic.Janko3.TwoLocal.ThompsonCertificate
