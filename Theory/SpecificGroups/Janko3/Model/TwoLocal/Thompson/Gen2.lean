module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Generators
public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators

/-!
# A packed generator for the order-1152 J₃ local candidate

The packed map is checked on every letter against the original word-defined
model element. The table is computational data, not a proof premise.
Source: ATLAS J3G1-p6156B0; GLS 3, Table 5.3h, printed p.269.
-/

namespace Sporadic.Janko3.TwoLocal.ThompsonCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

@[expose] public def g2MapPacked : Nat := 

@[expose] public def g2Map (x : Fin 6156) : Fin 6156 :=
  ⟨(g2MapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def g2InvMapPacked : Nat := 

@[expose] public def g2InvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(g2InvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

private theorem g2_left : ∀ x, g2InvMap (g2Map x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def g2Perm : Equiv.Perm (Fin 6156) :=
  tablePerm g2Map g2InvMap (by exact g2_left) (by exact rightInverse_of_leftInverse_fin g2_left)

private theorem g2Perm_eq : g2Perm = (thompsonNormalizerGenerator 4 : Equiv.Perm (Fin 6156)) := by
  change g2Perm = evalWord L0Gen (thompsonNormalizerWord0 4) *
    evalWord L1Gen (thompsonNormalizerWord1 4) * evalWord L2Gen (thompsonNormalizerWord2 4)
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def g2 : Model :=
  ⟨g2Perm, by exact g2Perm_eq.symm ▸ (thompsonNormalizerGenerator 4).property⟩

public theorem g2_eq : g2 = thompsonNormalizerGenerator 4 :=
  Subtype.ext g2Perm_eq

end Sporadic.Janko3.TwoLocal.ThompsonCertificate
