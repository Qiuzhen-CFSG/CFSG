module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Generators
public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Affine.Certificate
public import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.Tactic.FinCases

/-!
# The order of the fixed J₃ affine candidate

The seven certified model words generate a subgroup of order 2880. We prove
this by a finite permutation certificate: seven successive orbit factors have
sizes 6, 5, 2, 6, 2, 2, 2, and the terminal subgroup is trivial. Representatives
are words, their orbit points are distinct, and the complete Schreier equations
are checked on all 6156 letters. The injective inclusion of the concrete model
into its permutation group identifies the certificate with `affineCandidate`.

Source: GLS, Number 3, Table 5.3h, printed p.269, lists the affine local
`V ⋊ GL(V)` for `V = F₄ ⊕ F₄`, of order 16 · 15 · 12 = 2880. This module
establishes the cardinality needed by the consumer. The candidate's normalizer
identification and exhaustive local coverage are separate mathematical claims.
The retained maps, words, and reproducible untrusted generator are documented
under `TwoLocal/source` and `Affine/source`.
-/

namespace Sporadic.Janko3.TwoLocal
open Theory.GroupTheory AffineCertificate

private theorem affine_image :
    affineCandidate.map modelSubgroup.subtype = H0 := by
  have hbase (i : Fin 7) :
      (affineGenerator i : Equiv.Perm (Fin 6156)) ∈
        affineCandidate.map modelSubgroup.subtype :=
    Subgroup.mem_map_of_mem _ (affineGenerator_mem i)
  have hgen (i : Fin 10) :
      gen0 i ∈ affineCandidate.map modelSubgroup.subtype := by
    fin_cases i
    · change G0 ∈ _
      rw [G0_eq]
      exact hbase 0
    · change G1 ∈ _
      rw [G1_eq]
      exact hbase 1
    · change G2 ∈ _
      rw [G2_eq]
      exact hbase 2
    · change G3 ∈ _
      rw [G3_eq]
      exact hbase 3
    · change G4 ∈ _
      rw [G4_eq]
      exact hbase 4
    · change G5 ∈ _
      rw [G5_eq]
      exact hbase 5
    · change G6 ∈ _
      rw [G6_eq]
      exact hbase 6
    · change G4⁻¹ ∈ _
      apply Subgroup.inv_mem
      rw [G4_eq]
      exact hbase 4
    · change G5⁻¹ ∈ _
      apply Subgroup.inv_mem
      rw [G5_eq]
      exact hbase 5
    · change G6⁻¹ ∈ _
      apply Subgroup.inv_mem
      rw [G6_eq]
      exact hbase 6
  apply le_antisymm
  · rw [affineCandidate, MonoidHom.map_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨g, ⟨i, rfl⟩, rfl⟩
    fin_cases i
    · change (affineGenerator 0 : Equiv.Perm (Fin 6156)) ∈ H0
      rw [← G0_eq]
      exact ⟨[0], by simp only [evalWord, gen0, mul_one]⟩
    · change (affineGenerator 1 : Equiv.Perm (Fin 6156)) ∈ H0
      rw [← G1_eq]
      exact ⟨[1], by simp only [evalWord, gen0, mul_one]⟩
    · change (affineGenerator 2 : Equiv.Perm (Fin 6156)) ∈ H0
      rw [← G2_eq]
      exact ⟨[2], by simp only [evalWord, gen0, mul_one]⟩
    · change (affineGenerator 3 : Equiv.Perm (Fin 6156)) ∈ H0
      rw [← G3_eq]
      exact ⟨[3], by simp only [evalWord, gen0, mul_one]⟩
    · change (affineGenerator 4 : Equiv.Perm (Fin 6156)) ∈ H0
      rw [← G4_eq]
      exact ⟨[4], by simp only [evalWord, gen0, mul_one]⟩
    · change (affineGenerator 5 : Equiv.Perm (Fin 6156)) ∈ H0
      rw [← G5_eq]
      exact ⟨[5], by simp only [evalWord, gen0, mul_one]⟩
    · change (affineGenerator 6 : Equiv.Perm (Fin 6156)) ∈ H0
      rw [← G6_eq]
      exact ⟨[6], by simp only [evalWord, gen0, mul_one]⟩
  · rintro g ⟨w, rfl⟩
    induction w with
    | nil => exact Subgroup.one_mem _
    | cons i w ih => exact Subgroup.mul_mem _ (hgen i) ih

/-- The fixed subgroup generated by the seven affine model words has order 2880. -/
public theorem affineCandidate_card : Nat.card affineCandidate = 2880 := by
  calc
    Nat.card affineCandidate = Nat.card H0 := by
      rw [← affine_image]
      exact (Subgroup.card_map_of_injective modelSubgroup.subtype_injective).symm
    _ = 2880 := H0_card

/-- The middle member of the concrete local family has the required affine order. -/
public theorem localFamily_one_card : Nat.card (localFamily 1) = 2880 :=
  affineCandidate_card

end Sporadic.Janko3.TwoLocal
