module

public import Theory.SpecificGroups.Janko3.Model.Order.Base
import Mathlib.Tactic.FinCases

/-!
# Packed copies of the original J3 generators

The packed point maps are kernel-checked copies of the public ATLAS generators.
They accelerate word certificates without changing the concrete model.
Source: ATLAS J3G1-p6156B0, retained under `Model/data/`.
Generated by `Order/data/generate.py`; the generator is not trusted.
-/

namespace Sporadic.Janko3.OrderCertificate
open Theory.GroupTheory
set_option maxRecDepth 40000
set_option maxHeartbeats 4000000
set_option Elab.async false

@[expose] public def fastAMapPacked : Nat := 

@[expose] public def fastAMap (x : Fin 6156) : Fin 6156 :=
  ⟨(fastAMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def fastAInvMapPacked : Nat := 

@[expose] public def fastAInvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(fastAInvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem fastA_left : ∀ x, fastAInvMap (fastAMap x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def fastA : Equiv.Perm (Fin 6156) :=
  tablePerm fastAMap fastAInvMap fastA_left
    (rightInverse_of_leftInverse_fin fastA_left)

public theorem fastA_eq_atlas : fastA = atlasA := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def fastBMapPacked : Nat := 

@[expose] public def fastBMap (x : Fin 6156) : Fin 6156 :=
  ⟨(fastBMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def fastBInvMapPacked : Nat := 

@[expose] public def fastBInvMap (x : Fin 6156) : Fin 6156 :=
  ⟨(fastBInvMapPacked >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

public theorem fastB_left : ∀ x, fastBInvMap (fastBMap x) = x := by
  apply allLetters
  decide +kernel

@[expose] public def fastB : Equiv.Perm (Fin 6156) :=
  tablePerm fastBMap fastBInvMap fastB_left
    (rightInverse_of_leftInverse_fin fastB_left)

public theorem fastB_eq_atlas : fastB = atlasB := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def fastL0Gen : Fin 4 → Equiv.Perm (Fin 6156)
  | 0 => fastA
  | 1 => fastB
  | 2 => fastA⁻¹
  | 3 => fastB⁻¹

public theorem fastL0Gen_eq : fastL0Gen = L0Gen := by
  funext i
  fin_cases i <;> simp only [fastL0Gen, L0Gen, fastA_eq_atlas, fastB_eq_atlas]

end Sporadic.Janko3.OrderCertificate
