module

public import Theory.SpecificGroups.Janko3.Model.Order.Level0.Forward

/-!
# B-cycle witnesses for the first J3 Schreier step

The 936 transitions not settled by A² = B³ = 1 occupy 421 nontrivial
B-cycles and 36 fixed points. Keep all but one exceptional transition in
each nontrivial cycle, leaving 515 seed transitions. The remaining transition
follows from B³ = 1 and cancellation of its three stabilizer factors.
The masks below only select proof cases; the coverage, cyclic index identity,
and two-point factor identities are checked independently by Lean's kernel.
Source: `Order/data/witnesses.json`, ATLAS J3G1-p6156B0.
-/

namespace Sporadic.Janko3.OrderCertificate.Level0.ForwardB
open Theory.GroupTheory
set_option Elab.async false

@[expose] public def Seed (r : Fin 6156) : Prop :=
  ( >>> r.val) % 2 = 1

public instance (r : Fin 6156) : Decidable (Seed r) :=
  inferInstanceAs (Decidable (_ = _))

@[expose] public def Omitted (r : Fin 6156) : Prop :=
  ( >>> r.val) % 2 = 1

public instance (r : Fin 6156) : Decidable (Omitted r) :=
  inferInstanceAs (Decidable (_ = _))

@[expose] public def Known (r : Fin 6156) : Prop := algebraic 1 r ∨ Seed r

public instance (r : Fin 6156) : Decidable (Known r) :=
  inferInstanceAs (Decidable (_ ∨ _))

set_option maxRecDepth 40000 in
public theorem act_cube : ∀ r, L0Act 1 (L0Act 1 (L0Act 1 r)) = r := by
  apply allFin
  decide +kernel

set_option maxRecDepth 40000 in
public theorem coverage : ∀ r, Known r ∨
    (Omitted r ∧ Known (L0Act 1 r) ∧ Known (L0Act 1 (L0Act 1 r))) := by
  apply allFin
  decide +kernel

set_option maxRecDepth 40000 in
public theorem cycle_fix : ∀ r, Omitted r → ∀ j : Fin 2,
    (evalWord L1Gen (L0Factor 1 (L0Act 1 (L0Act 1 r))) *
      evalWord L1Gen (L0Factor 1 (L0Act 1 r)) * evalWord L1Gen (L0Factor 1 r))
      (if j = 0 then 1 else 2) = (if j = 0 then 1 else 2) := by
  have h : ∀ r, ∀ j : Fin 2, Omitted r →
      (evalWord L1Gen (L0Factor 1 (L0Act 1 (L0Act 1 r))) *
        evalWord L1Gen (L0Factor 1 (L0Act 1 r)) * evalWord L1Gen (L0Factor 1 r))
        (if j = 0 then 1 else 2) = (if j = 0 then 1 else 2) := by
    apply allFin₂
    decide +kernel
  exact fun r hr j => h r j hr

end Sporadic.Janko3.OrderCertificate.Level0.ForwardB
