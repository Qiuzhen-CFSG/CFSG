@[expose] public def lookup (p : Nat) : Nat → Nat
 | 0 => p % 8192 % 6156
 | x + 1 => (p >>> (13 * (x+1))) % 8192 % 6156

public theorem lookup_eq (p x : Nat) : lookup p x = (p >>> (13*x)) % 8192 % 6156 := by
 cases x <;> rfl

@[expose] public def gen : Fin 8 → Equiv.Perm (Fin 6156)
 | 0 => fastL0Gen 0
 | 1 => fastL0Gen 1
 | 2 => fastL0Gen 2
 | 3 => fastL0Gen 3
 | 4 => L1Gen 0
 | 5 => L1Gen 1
 | 6 => L1Gen 2
 | 7 => L1Gen 3

@[expose] public def rawGen : Fin 8 → Nat → Nat
 | 0 => lookup fastAMapPacked
 | 1 => lookup fastBMapPacked
 | 2 => lookup fastAInvMapPacked
 | 3 => lookup fastBInvMapPacked
 | 4 => lookup L1G0MapPacked
 | 5 => lookup L1G1MapPacked
 | 6 => lookup L1G0InvMapPacked
 | 7 => lookup L1G1InvMapPacked

public theorem rawGen_spec (i : Fin 8) (x : Fin 6156) : rawGen i x.val = (gen i x).val := by
 fin_cases i <;> simp only [rawGen, lookup_eq] <;> rfl

@[expose] public def ev {n : Nat} (g : Fin n → Nat → Nat) : List (Fin n) → Nat → Nat
 | [], x => x
 | i::w, x => g i (ev g w x)

public theorem ev_spec {n : Nat} (g : Fin n → Nat → Nat) (G : Fin n → Equiv.Perm (Fin 6156))
 (h : ∀ i x, g i x.val = (G i x).val) (w : List (Fin n)) (x : Fin 6156) :
 ev g w x.val = (evalWord G w x).val := by
 induction w with
 | nil => rfl
 | cons i w ih => rw [ev, ih, h]; rfl

public theorem ev_flatMap {n : Nat} (ws : Fin n → List (Fin 8)) (w : List (Fin n)) :
 evalWord (fun i => evalWord gen (ws i)) w = evalWord gen (w.flatMap ws) := by
 induction w with
 | nil => rfl
 | cons i w ih => simp only [evalWord, List.flatMap_cons, evalWord_append, ih]

@[expose] public def up0 (i : Fin 4) : Fin 8 := ⟨i.val, by omega⟩
@[expose] public def up1 (i : Fin 4) : Fin 8 := ⟨4+i.val, by omega⟩

public theorem gen_up0 (i : Fin 4) : gen (up0 i) = L0Gen i := by
 rw [← fastL0Gen_eq]
 fin_cases i <;> rfl

public theorem gen_up1 (i : Fin 4) : gen (up1 i) = L1Gen i := by
 fin_cases i <;> rfl

public theorem eval_map0 (w : List (Fin 4)) : evalWord gen (w.map up0) = evalWord L0Gen w := by
 induction w with
 | nil => rfl
 | cons i w ih => simp only [List.map_cons, evalWord, gen_up0, ih]

public theorem eval_map1 (w : List (Fin 4)) : evalWord gen (w.map up1) = evalWord L1Gen w := by
 induction w with
 | nil => rfl
 | cons i w ih => simp only [List.map_cons, evalWord, gen_up1, ih]


