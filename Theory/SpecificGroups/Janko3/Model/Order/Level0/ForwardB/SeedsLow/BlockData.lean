@[expose] public def rawBlock (i : Fin 76) := lookup (blockPacked i)

@[expose] public def evPacked : List Nat → Nat → Nat
 | [], x => x
 | p::w, x => lookup p (evPacked w x)
public theorem evPacked_map (w : List (Fin 76)) (x : Nat) :
    evPacked (w.map blockPacked) x = ev rawBlock w x := by
  induction w with
  | nil => rfl
  | cons i w ih => simp only [List.map_cons, evPacked, ev, ih, rawBlock]

public theorem step_of_packed_check
    (hspec : ∀ i (x : Fin 6156), rawBlock i x.val = (evalWord gen (blockWord i) x).val)
    (r : Fin 6156) (l u : List (Fin 76)) (lp up : List Nat)
    (hl : l.flatMap blockWord = (1 :: L0RepWord r).map up0)
    (hu : u.flatMap blockWord = (L0RepWord (L0Act 1 r)).map up0 ++
      (L0Factor 1 r).map up1)
    (hlp : lp = l.map blockPacked) (hup : up = u.map blockPacked)
    (hcheck : (List.range 6156).all (fun x => evPacked lp x == evPacked up x) = true) :
    L0Gen 1 * L0Rep r = L0Rep (L0Act 1 r) * evalWord L1Gen (L0Factor 1 r) := by
  have he : evalWord gen (l.flatMap blockWord) = evalWord gen (u.flatMap blockWord) := by
    apply Equiv.ext
    intro x
    apply Fin.ext
    have hh := List.all_eq_true.mp hcheck x.val (List.mem_range.mpr x.isLt)
    have hh' : evPacked lp x.val = evPacked up x.val := of_decide_eq_true hh
    rw [hlp, hup, evPacked_map, evPacked_map,
      ev_spec rawBlock _ hspec, ev_spec rawBlock _ hspec,
      ev_flatMap, ev_flatMap] at hh'
    exact hh'
  rw [hl, hu, evalWord_append, eval_map0, eval_map0, eval_map1] at he
  exact he

