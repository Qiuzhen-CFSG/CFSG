  let p : Fin 4 := ⟨k.val / 140, by omega⟩
  let j : Fin 140 := ⟨k.val % 140, by omega⟩
  have he : (⟨140 * p.val + j.val, by omega⟩ : Fin 560) = k := by
    apply Fin.ext
    dsimp [p, j]
    omega
  simpa only [he] using h p j

/-- Complete the A row from one certified transition in each exceptional orbit. -/
public theorem forwardRow0_of_exceptional
    (hstab : H2 = H1 ⊓ MulAction.stabilizer (Equiv.Perm (Fin 6156)) (1 : Fin 6156))
    (h : ∀ k, forwardAStep (exceptionalARep k)) : ForwardRow 0 := by
  intro r
  rcases exceptionalA_cover r with hr | hr | hr | hr | hr
  · rw [hr]
    exact h _
  · exact forwardAStep_of_partner hstab r (by rw [hr]; exact h _)
  · exact forwardAStep_of_tree r hr
  · subst r
    exact algebraic_step 0 131 (by decide +kernel)
  · subst r
    exact algebraic_step 0 167 (by decide +kernel)

end Sporadic.Janko3.OrderCertificate.Level0
