module

public import Theory.SpecificGroups.Janko3.Model.Order.Transitivity
public import Theory.SpecificGroups.Janko3.Model.Order.Terminal
public import Theory.SpecificGroups.Janko3.Model.Order.Level1Data
public import Theory.SpecificGroups.Janko3.Model.Order.Level0Certificate
public import Theory.SpecificGroups.Janko3.Model.Order.TerminalStructure

/-!
# Assembly of the concrete J₃ order certificate

The certified stabilizer chain at the zero-based points 0, 1, and 2 has
successive indices 6156, 510, and 16, and its final pointwise stabilizer is
trivial. Multiplying these indices gives the order 50232960 of the concrete
subgroup generated by the two ATLAS permutations. The imported certificates
identify the full relative point stabilizers `H1` and `H2`, give their explicit
word generators, and prove transitivity on all 6156 letters.
The two-point stabilizer `H2` is explicitly isomorphic to C₂ × D₈.

Source: ATLAS J3G1-p6156B0, retained under `Model/data/`.
-/

namespace Sporadic.Janko3
open OrderCertificate

/-- Assemble the order from the two nonterminal chain steps. -/
public theorem model_card_of_chain_steps
    (h0 : Nat.card H0 = 6156 * Nat.card H1)
    (h1 : Nat.card H1 = 510 * Nat.card H2) :
    Nat.card Model = 50232960 := by
  change Nat.card modelSubgroup = 50232960
  rw [← H0_eq_modelSubgroup, h0, h1, H2_card]

/-- The subgroup generated by the degree-6156 ATLAS permutations has order 50232960. -/
public theorem model_card : Nat.card Model = 50232960 :=
  model_card_of_chain_steps H0_card_step H1_card_step

/-- Every model element is a product of the three certified transversal representatives. -/
public theorem model_decomposition (g : Model) :
    ∃ (r : Fin 6156) (s : Fin 510) (t : Fin 16),
      (g : Equiv.Perm (Fin 6156)) = L0Rep r * (L1Rep s * L2Rep t) := by
  have hg : (g : Equiv.Perm (Fin 6156)) ∈ H0 := by
    rw [H0_eq_modelSubgroup]
    exact g.property
  obtain ⟨r, k, hk⟩ := Level0.decompose L0Step ⟨g, hg⟩
  obtain ⟨s, l, hl⟩ := Level1.decomposition_of_step L1Step k
  obtain ⟨t, ht⟩ := H2_rep l
  exact ⟨r, s, t, hk.trans (congrArg (L0Rep r * ·)
    (hl.trans (congrArg (L1Rep s * ·) ht)))⟩

/-- The three zero-based points 0, 1, and 2 form a base for the concrete model. -/
public theorem model_base_trivial (g : Model)
    (h0 : (g : Equiv.Perm (Fin 6156)) 0 = 0)
    (h1 : (g : Equiv.Perm (Fin 6156)) 1 = 1)
    (h2 : (g : Equiv.Perm (Fin 6156)) 2 = 2) : g = 1 := by
  have hg : (g : Equiv.Perm (Fin 6156)) ∈ H1 := by
    rw [H1_eq_stabilizer, H0_eq_modelSubgroup]
    exact ⟨g.property, h0⟩
  exact Subtype.ext (congrArg (fun k : H1 => (k : Equiv.Perm (Fin 6156)))
    (Level0.H1_base_trivial H2_eq_stabilizer ⟨g, hg⟩ h1 h2))

end Sporadic.Janko3
