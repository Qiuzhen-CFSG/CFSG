module

public import Theory.SpecificGroups.Janko3.Model.ThreeCoverLocalConfiguration.RightSupport.Relations

import Mathlib.Tactic.FinCases

/-!
# The 60 representatives of the right support

The signed generating alphabet and representatives are literal words in the
certified degree-6156 generators. Their images of zero are all distinct.

Source: GLS3 Table 5.3h, printed p.269; the affine configuration for
Aschbacher--Smith A.2.19 and I.2.1. Generated by `source/generate.py`
from retained ATLAS data and the parent discovery file. The script and
its data are not trusted; Lean checks all identities.
-/

namespace Sporadic.Janko3.ThreeCoverConfig.RightCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 40000
set_option maxHeartbeats 4000000
set_option Elab.async false

@[expose] public def gen : Fin 4 → Equiv.Perm (Fin 6156)
  | 0 => d0Perm
  | 1 => d1Perm
  | 2 => d0Perm⁻¹
  | 3 => d1Perm⁻¹

@[expose] public def invIndex : Fin 4 → Fin 4 := ![2, 3, 0, 1]

public theorem inv_spec (i : Fin 4) : gen (invIndex i) = (gen i)⁻¹ := by
  fin_cases i <;> simp [gen, invIndex]

@[expose] public def H : Subgroup (Equiv.Perm (Fin 6156)) :=
  wordSubgroup gen invIndex inv_spec

