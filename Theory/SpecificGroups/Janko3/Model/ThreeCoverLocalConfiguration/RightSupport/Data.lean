    [0, 1, 2, 3, 0, 1]]

@[expose] public def rep (r : Fin 60) : Equiv.Perm (Fin 6156) :=
  evalWord gen (repWord r)

@[expose] public def act : Fin 4 → Fin 60 → Fin 60
  | 0 => ![1, 3, 5, 0, 6, 9, 10, 13, 14, 2, 4, 15, 16, 21, 22, 23, 24, 29, 30, 31, 32, 7, 8, 11, 12, 33, 34, 35, 36, 43, 44, 45, 38, 46, 40, 47, 48, 53, 20, 42, 26, 50, 54, 17, 18, 19, 25, 27, 28, 51, 55, 56, 37, 52, 39, 41, 49, 58, 59, 57]
  | 1 => ![2, 7, 4, 8, 0, 17, 18, 11, 12, 19, 20, 1, 3, 37, 36, 38, 39, 25, 26, 27, 28, 40, 41, 42, 30, 5, 6, 9, 10, 53, 52, 16, 35, 22, 45, 57, 49, 47, 50, 31, 51, 33, 43, 23, 46, 55, 58, 13, 29, 14, 15, 21, 24, 48, 56, 34, 59, 32, 44, 54]
  | 2 => ![3, 0, 9, 1, 10, 2, 4, 21, 22, 5, 6, 23, 24, 7, 8, 11, 12, 43, 44, 45, 38, 13, 14, 15, 16, 46, 40, 47, 48, 17, 18, 19, 20, 25, 26, 27, 28, 52, 32, 54, 34, 55, 39, 29, 30, 31, 33, 35, 36, 56, 41, 49, 53, 37, 42, 50, 51, 59, 57, 58]
