public theorem rep_mem (r : Fin 60) : rep r ∈ H := ⟨repWord r, rfl⟩

public theorem rep_base : rep 0 = 1 := rfl

@[expose] public def point : Fin 60 → Fin 6156 :=
  ![0, 4583, 1229, 5995, 3403, 45, 5222, 345, 2444, 3154, 5207, 2214, 5832, 2467, 5246, 795, 3966, 365, 406, 4237, 984, 1558, 3279, 5454, 3505, 2409, 244, 2602, 5231, 5335, 1012, 3856, 2162, 17, 584, 5752, 1747, 5339, 5764, 5636, 4624, 3051, 5576, 3621, 161, 5577, 2131, 676, 2202, 3315, 5665, 1652, 655, 229, 5108, 347, 2506, 2922, 5718, 1563]

public theorem rep_point : ∀ r, rep r 0 = point r := by
  apply allFin
  decide +kernel

public theorem point_injective : Function.Injective point := by
  have h : ∀ i j, point i = point j → i = j := by
    apply allFin₂
    decide +kernel
  exact h

/-- The inverse-letter table reverses the corresponding positive-letter table. -/
public theorem act_inverse : ∀ (i : Fin 2) r,
    act i.castSucc.castSucc (act ⟨i.val + 2, by omega⟩ r) = r := by
  apply allFin₂
  decide +kernel

end Sporadic.Janko3.ThreeCoverConfig.RightCertificate
