module

public import Theory.SpecificGroups.Janko3.Model.ThreeCoverLocalConfiguration.RightSupport.Row0
public import Theory.SpecificGroups.Janko3.Model.ThreeCoverLocalConfiguration.RightSupport.Row1
import Mathlib.Tactic.FinCases

/-!
# Exact order of the literal right support

The checked transition table reduces every signed word to one of 60
representatives. Evaluation at zero separates them, giving a bijection.
We identify this word subgroup with the image of the literal closure of
`{d0, d1}` under the faithful degree-6156 model embedding, so the order
calculation applies to the subgroup used by the configuration consumer.

Source: GLS3 Table 5.3h, printed p.269; Aschbacher--Smith A.2.19 and I.2.1.
-/

namespace Sporadic.Janko3.ThreeCoverConfig.RightCertificate
open Theory.GroupTheory OrderCertificate

public theorem step (i : Fin 4) (r : Fin 60) : gen i * rep r = rep (act i r) := by
  fin_cases i
  · exact step0 r
  · exact step1 r
  · change d0Perm⁻¹ * rep r = rep (act 2 r)
    have h := step0 (act 2 r)
    rw [show act 0 (act 2 r) = r from act_inverse 0 r] at h
    rw [← h]
    exact inv_mul_cancel_left _ _
  · change d1Perm⁻¹ * rep r = rep (act 3 r)
    have h := step1 (act 3 r)
    rw [show act 1 (act 3 r) = r from act_inverse 1 r] at h
    rw [← h]
    exact inv_mul_cancel_left _ _

public theorem H_card : Nat.card H = 60 := by
  have hcover : ∀ w : List (Fin 4), ∃ r, evalWord gen w = rep r := by
    intro w
    induction w with
    | nil => exact ⟨0, rep_base.symm⟩
    | cons i w ih =>
      obtain ⟨r, hr⟩ := ih
      exact ⟨act i r, by change gen i * evalWord gen w = _; rw [hr, step]⟩
  let f : Fin 60 → H := fun r => ⟨rep r, rep_mem r⟩
  have hf : Function.Bijective f := by
    constructor
    · intro i j hij
      apply point_injective
      have h := congrArg (fun g : H => (g : Equiv.Perm (Fin 6156)) 0) hij
      simpa only [f, rep_point] using h
    · rintro ⟨g, w, rfl⟩
      obtain ⟨r, hr⟩ := hcover w
      exact ⟨r, Subtype.ext hr.symm⟩
  exact (Nat.card_congr (Equiv.ofBijective f hf).symm).trans (Nat.card_fin 60)

public theorem H_eq_map : H = rightSupport.map modelSubgroup.subtype := by
  apply le_antisymm
  · have hgen : ∀ i, gen i ∈ rightSupport.map modelSubgroup.subtype := by
      intro i
      fin_cases i
      · change d0Perm ∈ _
        rw [d0Perm_eq]
        exact Subgroup.mem_map.mpr ⟨d0, d0_mem, rfl⟩
      · change d1Perm ∈ _
        rw [d1Perm_eq]
        exact Subgroup.mem_map.mpr ⟨d1, d1_mem, rfl⟩
      · change d0Perm⁻¹ ∈ _
        apply (rightSupport.map modelSubgroup.subtype).inv_mem
        rw [d0Perm_eq]
        exact Subgroup.mem_map.mpr ⟨d0, d0_mem, rfl⟩
      · change d1Perm⁻¹ ∈ _
        apply (rightSupport.map modelSubgroup.subtype).inv_mem
        rw [d1Perm_eq]
        exact Subgroup.mem_map.mpr ⟨d1, d1_mem, rfl⟩
    rintro g ⟨w, rfl⟩
    induction w with
    | nil => exact (rightSupport.map modelSubgroup.subtype).one_mem
    | cons i w ih => exact (rightSupport.map modelSubgroup.subtype).mul_mem (hgen i) ih
  · rw [rightSupport, MonoidHom.map_closure]
    apply (Subgroup.closure_le H).mpr
    rintro _ ⟨g, hg, rfl⟩
    rcases hg with rfl | hg
    · change (d0 : Equiv.Perm (Fin 6156)) ∈ H
      rw [← d0Perm_eq]
      exact ⟨[0], mul_one _⟩
    · have he : g = d1 := hg
      subst g
      change (d1 : Equiv.Perm (Fin 6156)) ∈ H
      rw [← d1Perm_eq]
      exact ⟨[1], mul_one _⟩

end Sporadic.Janko3.ThreeCoverConfig.RightCertificate

namespace Sporadic.Janko3.ThreeCoverConfig
open RightCertificate

/-- The subgroup literally generated by the two marked words has order 60. -/
public theorem rightSupport_card : Nat.card rightSupport = 60 := by
  have h := Subgroup.card_map_of_injective (K := rightSupport) modelSubgroup.subtype_injective
  rw [← H_eq_map, H_card] at h
  exact h.symm

end Sporadic.Janko3.ThreeCoverConfig
