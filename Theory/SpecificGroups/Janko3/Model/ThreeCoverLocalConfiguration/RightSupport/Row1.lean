module

public import Theory.SpecificGroups.Janko3.Model.ThreeCoverLocalConfiguration.RightSupport.Data

import Mathlib.Tactic.FinCases

/-!
# Right-support transitions for generator 1

Cubic relations and cancellation settle the short transitions. The remaining
identities are checked on all 6156 letters. Inverse-generator transitions
will follow algebraically, without repeating these finite computations.

Source: GLS3 Table 5.3h, printed p.269; the affine configuration for
Aschbacher--Smith A.2.19 and I.2.1. Generated by `source/generate.py`
from retained ATLAS data and the parent discovery file. The script and
its data are not trusted; Lean checks all identities.
-/

namespace Sporadic.Janko3.ThreeCoverConfig.RightCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 40000
set_option maxHeartbeats 4000000
set_option Elab.async false

public theorem step1 (r : Fin 60) : gen 1 * rep r = rep (act 1 r) := by
  fin_cases r
  · change d1Perm * evalWord gen [] = evalWord gen [1]
    rfl
  · change d1Perm * evalWord gen [0] = evalWord gen [1, 0]
    rfl
  · change d1Perm * evalWord gen [1] = evalWord gen [3]
    change d1Perm * (d1Perm * evalWord gen []) = d1Perm⁻¹ * evalWord gen []
    rw [← mul_assoc, d1Perm_square]
  · change d1Perm * evalWord gen [2] = evalWord gen [1, 2]
    rfl
  · change d1Perm * evalWord gen [3] = evalWord gen []
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [0, 1] = evalWord gen [1, 0, 1]
    rfl
  · change d1Perm * evalWord gen [0, 3] = evalWord gen [1, 0, 3]
    rfl
  · change d1Perm * evalWord gen [1, 0] = evalWord gen [3, 0]
    change d1Perm * (d1Perm * evalWord gen [0]) = d1Perm⁻¹ * evalWord gen [0]
    rw [← mul_assoc, d1Perm_square]
  · change d1Perm * evalWord gen [1, 2] = evalWord gen [3, 2]
    change d1Perm * (d1Perm * evalWord gen [2]) = d1Perm⁻¹ * evalWord gen [2]
    rw [← mul_assoc, d1Perm_square]
  · change d1Perm * evalWord gen [2, 1] = evalWord gen [1, 2, 1]
    rfl
  · change d1Perm * evalWord gen [2, 3] = evalWord gen [1, 2, 3]
    rfl
  · change d1Perm * evalWord gen [3, 0] = evalWord gen [0]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [3, 2] = evalWord gen [2]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [0, 1, 0] = evalWord gen [1, 0, 1, 0]
    rfl
  · change d1Perm * evalWord gen [0, 1, 2] = evalWord gen [0, 3, 2, 3]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 3, 0] = evalWord gen [1, 0, 3, 0]
    rfl
  · change d1Perm * evalWord gen [0, 3, 2] = evalWord gen [1, 0, 3, 2]
    rfl
  · change d1Perm * evalWord gen [1, 0, 1] = evalWord gen [3, 0, 1]
    change d1Perm * (d1Perm * evalWord gen [0, 1]) = d1Perm⁻¹ * evalWord gen [0, 1]
    rw [← mul_assoc, d1Perm_square]
  · change d1Perm * evalWord gen [1, 0, 3] = evalWord gen [3, 0, 3]
    change d1Perm * (d1Perm * evalWord gen [0, 3]) = d1Perm⁻¹ * evalWord gen [0, 3]
    rw [← mul_assoc, d1Perm_square]
  · change d1Perm * evalWord gen [1, 2, 1] = evalWord gen [3, 2, 1]
    change d1Perm * (d1Perm * evalWord gen [2, 1]) = d1Perm⁻¹ * evalWord gen [2, 1]
    rw [← mul_assoc, d1Perm_square]
  · change d1Perm * evalWord gen [1, 2, 3] = evalWord gen [3, 2, 3]
    change d1Perm * (d1Perm * evalWord gen [2, 3]) = d1Perm⁻¹ * evalWord gen [2, 3]
    rw [← mul_assoc, d1Perm_square]
  · change d1Perm * evalWord gen [2, 1, 0] = evalWord gen [1, 2, 1, 0]
    rfl
  · change d1Perm * evalWord gen [2, 1, 2] = evalWord gen [1, 2, 1, 2]
    rfl
  · change d1Perm * evalWord gen [2, 3, 0] = evalWord gen [1, 2, 3, 0]
    rfl
  · change d1Perm * evalWord gen [2, 3, 2] = evalWord gen [0, 1, 0, 3]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [3, 0, 1] = evalWord gen [0, 1]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [3, 0, 3] = evalWord gen [0, 3]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [3, 2, 1] = evalWord gen [2, 1]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [3, 2, 3] = evalWord gen [2, 3]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [0, 1, 0, 1] = evalWord gen [0, 1, 0, 1, 0]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 1, 0, 3] = evalWord gen [3, 2, 3, 2]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 1, 2, 1] = evalWord gen [0, 3, 2]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 1, 2, 3] = evalWord gen [0, 3, 2, 1]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 3, 0, 1] = evalWord gen [2, 1, 2]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 3, 0, 3] = evalWord gen [2, 1, 2, 1]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 3, 2, 1] = evalWord gen [1, 0, 3, 2, 1]
    rfl
  · change d1Perm * evalWord gen [0, 3, 2, 3] = evalWord gen [3, 0, 1, 2]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [1, 0, 1, 0] = evalWord gen [2, 3, 2, 1]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [1, 0, 3, 0] = evalWord gen [3, 0, 3, 0]
    change d1Perm * (d1Perm * evalWord gen [0, 3, 0]) = d1Perm⁻¹ * evalWord gen [0, 3, 0]
    rw [← mul_assoc, d1Perm_square]
  · change d1Perm * evalWord gen [1, 0, 3, 2] = evalWord gen [0, 1, 2, 1]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [1, 2, 1, 0] = evalWord gen [3, 2, 1, 0]
    change d1Perm * (d1Perm * evalWord gen [2, 1, 0]) = d1Perm⁻¹ * evalWord gen [2, 1, 0]
    rw [← mul_assoc, d1Perm_square]
  · change d1Perm * evalWord gen [1, 2, 1, 2] = evalWord gen [0, 3, 0, 1]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [1, 2, 3, 0] = evalWord gen [2, 1, 0, 1]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [2, 1, 0, 1] = evalWord gen [2, 3, 0]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [2, 1, 0, 3] = evalWord gen [2, 3, 0, 1]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [2, 1, 2, 1] = evalWord gen [0, 3, 0, 3, 0]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [2, 3, 0, 1] = evalWord gen [1, 2, 3, 0, 1]
    rfl
  · change d1Perm * evalWord gen [2, 3, 2, 1] = evalWord gen [0, 1, 0]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [2, 3, 2, 3] = evalWord gen [0, 1, 0, 1]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [3, 0, 1, 2] = evalWord gen [0, 1, 2]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [3, 0, 3, 0] = evalWord gen [0, 3, 0]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [3, 2, 1, 0] = evalWord gen [2, 1, 0]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [3, 2, 3, 2] = evalWord gen [2, 3, 2]
    exact mul_inv_cancel_left _ _
  · change d1Perm * evalWord gen [0, 1, 0, 1, 0] = evalWord gen [2, 3, 2, 3]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 1, 2, 3, 0] = evalWord gen [0, 3, 2, 1, 0]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 3, 0, 3, 0] = evalWord gen [0, 3, 0, 3]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 3, 2, 1, 0] = evalWord gen [0, 1, 2, 3, 0, 1]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [1, 0, 3, 2, 1] = evalWord gen [0, 1, 2, 3]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [1, 2, 3, 0, 1] = evalWord gen [2, 1, 0, 3]
    apply Equiv.ext
    apply allLetters
    decide +kernel
  · change d1Perm * evalWord gen [0, 1, 2, 3, 0, 1] = evalWord gen [0, 1, 2, 3, 0]
    apply Equiv.ext
    apply allLetters
    decide +kernel

end Sporadic.Janko3.ThreeCoverConfig.RightCertificate
