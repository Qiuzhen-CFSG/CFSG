module

public import Theory.SpecificGroups.Janko3.Model.TwoLocal.Centralizer.C0
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Cached basic commutators for the J₃ left support

Each packed map is checked against the commutator of two already certified
centralizer generators. Caching these three products keeps subsequent word
verification small. The original CFSG script `source/generate_commutators.py`
is only a certificate generator; every identity is checked by the kernel.
Source: GLS3, Table 5.3h, printed p.269; retained ATLAS J3G1-p6156B0 data.
-/

namespace Sporadic.Janko3.ThreeCoverConfig.LeftSupportCertificate
open Theory.GroupTheory OrderCertificate TwoLocal.CentralizerCertificate
open scoped commutatorElement
set_option maxRecDepth 40000
set_option Elab.async false

@[expose] public def c23MapPacked : Nat := 

@[expose] public def c23Map (i : Fin 6156) : Fin 6156 :=
  ⟨(c23MapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def c23InvMapPacked : Nat := 

@[expose] public def c23InvMap (i : Fin 6156) : Fin 6156 :=
  ⟨(c23InvMapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 4000000 in
public theorem c23_left : ∀ i, c23InvMap (c23Map i) = i := by
  apply allLetters
  decide +kernel

@[expose] public def c23Perm : Equiv.Perm (Fin 6156) :=
  tablePerm c23Map c23InvMap c23_left
    (rightInverse_of_leftInverse_fin c23_left)

set_option maxHeartbeats 4000000 in
public theorem c23Perm_eq : c23Perm = ⁅C0G2, C0G3⁆ := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

