module

public import Theory.SpecificGroups.Janko3.Model.ThreeCoverLocalConfiguration.Words
public import Theory.SpecificGroups.Janko3.Model.Order.FastGenerators

/-!
# Certified conjugator for the J₃ left support

The packed permutation is identified with the literal stabilizer-chain word
`conjugator` on every letter. Its table and inverse come from the retained
ATLAS degree-6156 model; neither the discovery data nor the generating script
is a proof premise. Source: GLS3, Table 5.3h, printed p.269.
-/

namespace Sporadic.Janko3.ThreeCoverConfig.LeftSupportCertificate
open Theory.GroupTheory OrderCertificate TwoLocal
set_option maxRecDepth 40000
set_option Elab.async false

@[expose] public def conjugatorMapPacked : Nat := 

@[expose] public def conjugatorMap (i : Fin 6156) : Fin 6156 :=
  ⟨(conjugatorMapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

@[expose] public def conjugatorInvMapPacked : Nat := 

@[expose] public def conjugatorInvMap (i : Fin 6156) : Fin 6156 :=
  ⟨(conjugatorInvMapPacked >>> (13 * i.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 4000000 in
public theorem conjugator_left : ∀ i, conjugatorInvMap (conjugatorMap i) = i := by
  apply allLetters
  decide +kernel

@[expose] public def conjugatorPerm : Equiv.Perm (Fin 6156) :=
  tablePerm conjugatorMap conjugatorInvMap conjugator_left
    (rightInverse_of_leftInverse_fin conjugator_left)

set_option maxHeartbeats 4000000 in
public theorem conjugatorPerm_eq :
    conjugatorPerm = (conjugator : Equiv.Perm (Fin 6156)) := by
  change conjugatorPerm =
    evalWord L0Gen [0, 1, 0, 1, 0, 3, 0, 1, 0, 3, 0, 1, 0, 3, 0, 1, 0, 1, 0] *
    evalWord L1Gen [1, 0, 1, 2, 1, 0, 0, 1, 2, 1, 0, 1, 0, 0, 1] *
    evalWord L2Gen [2, 0, 0]
  rw [← fastL0Gen_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

end Sporadic.Janko3.ThreeCoverConfig.LeftSupportCertificate
