module

public import Theory.SpecificGroups.Janko3.Model.Generators
public import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# A concrete permutation model for J₃

`Sporadic.Janko3.Model` is the subgroup of the symmetric group on 6156 letters
generated by the two explicitly tabulated ATLAS permutations. Its group and
finiteness instances come from this construction. Recognition can therefore
have conclusion `Nonempty (G ≃* Sporadic.Janko3.Model)` without encoding an
order condition or a classification property in the carrier.

Source: R. A. Wilson et al., ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/v3/permrep/J3G1-p6156B0 .
Order and simplicity require further intrinsic certification; neither is
assumed or asserted by this construction module.
-/

namespace Sporadic.Janko3

/-- The concrete ATLAS subgroup on 6156 letters. -/
@[expose] public def modelSubgroup : Subgroup (Equiv.Perm (Fin 6156)) :=
  Subgroup.closure {atlasA, atlasB}

/-- The degree-6156 permutation construction of the third Janko group. -/
public abbrev Model := modelSubgroup

public instance model_finite : Finite Model := inferInstanceAs (Finite modelSubgroup)

public theorem atlasA_mem : atlasA ∈ modelSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

public theorem atlasB_mem : atlasB ∈ modelSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The standard involution as an element of the model. -/
@[expose] public def a : Model := ⟨atlasA, atlasA_mem⟩

/-- The standard element of order three as an element of the model. -/
@[expose] public def b : Model := ⟨atlasB, atlasB_mem⟩

/-- The faithful permutation realization of the model. -/
@[expose] public def embedding : Model →* Equiv.Perm (Fin 6156) :=
  modelSubgroup.subtype

public theorem embedding_injective : Function.Injective embedding :=
  Subtype.val_injective

public theorem generators_closure : Subgroup.closure ({a, b} : Set Model) = ⊤ := by
  have h : Subgroup.closure (modelSubgroup.subtype ⁻¹' {atlasA, atlasB}) = ⊤ :=
    Subgroup.closure_preimage_eq_top _
  have hs : modelSubgroup.subtype ⁻¹' {atlasA, atlasB} = ({a, b} : Set Model) := by
    ext x
    change (x.val = a.val ∨ x.val = b.val) ↔ (x = a ∨ x = b)
    simp only [Subtype.ext_iff]
  rwa [hs] at h

public theorem a_sq : a ^ 2 = 1 := Subtype.ext atlasA_sq

public theorem b_cube : b ^ 3 = 1 := Subtype.ext atlasB_cube

public theorem a_ne_one : a ≠ 1 := by
  intro h
  have hp := congrArg (fun g : Model => (g : Equiv.Perm (Fin 6156)) 0) h
  have hn : atlasAFun 0 ≠ 0 := by decide +kernel
  exact hn hp

public instance model_nontrivial : Nontrivial Model := ⟨⟨a, 1, a_ne_one⟩⟩

public theorem a_mul_b_ne_b_mul_a : a * b ≠ b * a := by
  intro h
  have hp := congrArg (fun g : Model => (g : Equiv.Perm (Fin 6156)) 0) h
  have hn : atlasAFun (atlasBFun 0) ≠ atlasBFun (atlasAFun 0) := by decide +kernel
  exact hn hp

/-- An explicit witness that the constructed model is nonabelian. -/
public theorem exists_mul_ne_mul : ∃ x y : Model, x * y ≠ y * x :=
  ⟨a, b, a_mul_b_ne_b_mul_a⟩

end Sporadic.Janko3
