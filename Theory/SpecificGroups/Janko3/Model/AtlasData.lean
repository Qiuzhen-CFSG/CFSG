public import Mathlib.GroupTheory.Perm.Finite

/-!
# The ATLAS degree-6156 generators for J₃

Source: R. A. Wilson et al., ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/v3/permrep/J3G1-p6156B0 .
The original factual permutation tables are retained in `Model/data/`.
We subtract one from every letter and invert the GAP permutations to convert
right actions to Lean's left-action convention. This preserves group words.
Balanced lookup trees implement the tables; the inverse laws are proved by
kernel reduction in `Generators.lean`. No external computation is trusted.
-/

namespace Sporadic.Janko3

/-- Branch of the balanced lookup tree for the ATLAS permutation tables. -/
@[expose] public def atlasBranch (cutoff : Nat)
    (left right : Fin 6156 → Fin 6156) (i : Fin 6156) : Fin 6156 :=
  if i.val < cutoff then left i else right i

