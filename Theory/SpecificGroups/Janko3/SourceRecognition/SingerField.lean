module
public import Theory.Representation.CentralCubicNaturalFour
public import Theory.GroupTheory.NormalizingInvolutionCard

/-!
# The faithful field-affine subgroup 16:(15:2) of AGL₂(4)

Let K = F₄[α], with α² = α + ω. The polynomial has no root in F₄,
so K is a field of order sixteen. Multiplication embeds its cyclic unit
group in GL₂(4). Quadratic conjugation is literally fourth-power Frobenius;
it normalizes the scalar group and lies outside it, giving order thirty.
The resulting affine group embeds faithfully in the natural affine plane,
with its translations and both conjugation actions explicitly marked.

This constructs the local field subgroup used after the natural-normalizer
statement of Aschbacher, *Sporadic Groups* (1994), 46.14(5a), pp.257–258,
in the J₃ recognition route of Aschbacher–Smith I.4.7(2), p.418.
No opposite root, ambient Weyl element or ambient recognition is assumed.
-/

@[expose] public noncomputable section
namespace Sporadic.Janko3.SourceRecognition.SingerField
open Representation.SL2FourNatural (F V card_field)
open Representation.CentralCubicNaturalFour
open Subgroup

/-- A primitive cubic scalar in F₄. -/
abbrev omega : F := ⟨0, 1⟩
/-- The quadratic field extension of the marked F₄ scalars. -/
abbrev K := QuadraticAlgebra F omega 1
instance noRootK : Fact (∀ r : F, r ^ 2 ≠ omega + 1 * r) := ⟨by decide +kernel⟩
instance fintypeK : Fintype K := Fintype.ofEquiv (F × F) (QuadraticAlgebra.equivProd _ _).symm

instance charPK : CharP K 2 := charP_of_injective_algebraMap (algebraMap F K).injective 2

theorem field_card : Fintype.card K = 16 := by decide +kernel

def coordinates : K ≃ₗ[F] V := QuadraticAlgebra.linearEquivTuple _ _

/-- Scalar multiplication on K, regarded as an F₄-plane. -/
def multiplication : Kˣ →* (K ≃ₗ[F] K) where
  toFun u :=
    { toFun x := (u : K) * x
      invFun x := (↑u⁻¹ : K) * x
      left_inv x := by simp
      right_inv x := by simp
      map_add' x y := mul_add _ _ _
      map_smul' c x := by simp [Algebra.smul_def, mul_left_comm] }
  map_one' := by apply LinearEquiv.ext; intro x; exact one_mul x
  map_mul' u v := by apply LinearEquiv.ext; intro x; exact mul_assoc (u : K) (v : K) x

theorem multiplication_injective : Function.Injective multiplication := by
  intro u v h
  apply Units.ext
  have hh := LinearEquiv.congr_fun h 1
  change (u : K) * 1 = (v : K) * 1 at hh
  simpa only [mul_one] using hh

/-- The F₄-linear quadratic conjugation; `frobenius_apply` identifies its fourth power. -/
def frobenius : K ≃ₗ[F] K where
  toFun := star
  invFun := star
  left_inv := star_star
  right_inv := star_star
  map_add' := star_add
  map_smul' c x := by
    apply QuadraticAlgebra.ext
    · simp only [QuadraticAlgebra.re_star,QuadraticAlgebra.re_smul,
        QuadraticAlgebra.im_smul,RingHom.id_apply,smul_eq_mul]
      ring
    · simp only [QuadraticAlgebra.im_star,QuadraticAlgebra.im_smul,
        RingHom.id_apply,smul_eq_mul,mul_neg]

theorem frobenius_apply (x : K) : frobenius x = x ^ 4 := by
  revert x
  decide +kernel

theorem frobenius_square : frobenius ^ 2 = 1 := by
  apply LinearEquiv.ext
  intro x
  exact star_star x

theorem frobenius_ne_one : frobenius ≠ 1 := by
  intro h
  have hh := LinearEquiv.congr_fun h (⟨0,1⟩ : K)
  exact (by decide +kernel : frobenius (⟨0,1⟩ : K) ≠ ⟨0,1⟩) hh

theorem frobenius_conjugation (u : Kˣ) :
    frobenius * multiplication u * frobenius⁻¹ = multiplication (u ^ 4) := by
  apply LinearEquiv.ext
  intro x
  change star ((u : K) * star x) = (u : K) ^ 4 * x
  rw [star_mul,star_star,mul_comm]
  exact congrArg (· * x) (frobenius_apply (u : K))

/-- The actual cyclic scalar subgroup in the F₄-linear group. -/
def torus : Subgroup (K ≃ₗ[F] K) := multiplication.range

/-- The subgroup generated by scalars and fourth-power Frobenius. -/
def normalizer : Subgroup (K ≃ₗ[F] K) := torus ⊔ zpowers frobenius

theorem torus_card : Nat.card torus = 15 := by
  change Nat.card multiplication.range = 15
  rw [← Nat.card_congr (MonoidHom.ofInjective multiplication_injective).toEquiv,
    Nat.card_eq_fintype_card, Fintype.card_units, field_card]

theorem frobenius_not_mem_torus : frobenius ∉ torus := by
  rintro ⟨u, hu⟩
  have he := LinearEquiv.congr_fun hu 1
  have hu1 : u = 1 := by
    apply Units.ext
    change (u : K) * 1 = star (1 : K) at he
    simpa only [mul_one, star_one, Units.val_one] using he
  rw [hu1, map_one] at hu
  exact frobenius_ne_one hu.symm

theorem frobenius_normalizes : frobenius ∈ Subgroup.normalizer (torus : Set (K ≃ₗ[F] K)) := by
  rw [mem_normalizer_iff]
  intro x
  constructor
  · rintro ⟨u, rfl⟩
    exact ⟨u ^ 4, (frobenius_conjugation u).symm⟩
  · rintro ⟨u, hu⟩
    have he : frobenius * (frobenius * x * frobenius⁻¹) * frobenius⁻¹ = x := by
      have hs : frobenius * frobenius = 1 := by simpa only [pow_two] using frobenius_square
      calc
        _ = (frobenius * frobenius) * x * (frobenius * frobenius)⁻¹ := by group
        _ = x := by rw [hs]; simp
    refine ⟨u ^ 4, ?_⟩
    rw [← frobenius_conjugation, hu, he]

theorem normalizer_card : Nat.card normalizer = 30 := by
  rw [normalizer, card_sup_zpowers_of_normalizing_involution torus frobenius
    frobenius_square frobenius_not_mem_torus frobenius_normalizes, torus_card]

/-- The fifteen-element scalar group is cyclic. -/
instance torus_cyclic : IsCyclic torus :=
  isCyclic_of_surjective multiplication.rangeRestrict multiplication.rangeRestrict_surjective

/-- The original F₄-plane coordinates, regarded as multiplicative additive groups. -/
def rootCoordinates : Multiplicative K ≃* Plane := coordinates.toAddEquiv.toMultiplicative

/-- Change coordinates on linear automorphisms, preserving their actual action. -/
def coordinateConjugation : (K ≃ₗ[F] K) ≃* (V ≃ₗ[F] V) where
  toFun l := coordinates.symm.trans (l.trans coordinates)
  invFun l := coordinates.trans (l.trans coordinates.symm)
  left_inv l := by
    apply LinearEquiv.ext
    intro x
    simp only [LinearEquiv.trans_apply,LinearEquiv.symm_apply_apply]
  right_inv l := by
    apply LinearEquiv.ext
    intro x
    simp only [LinearEquiv.trans_apply,LinearEquiv.apply_symm_apply]
  map_mul' l m := by
    apply LinearEquiv.ext
    intro x
    simp only [LinearEquiv.trans_apply,LinearEquiv.mul_apply,
      LinearEquiv.symm_apply_apply]

/-- Transport the K-coordinate linear transformations to the actual F₄-plane. -/
def matrixEquiv : (K ≃ₗ[F] K) ≃* LinearGroup :=
  coordinateConjugation.trans Representation.SL2FourNatural.SemilinearNormalizer.glEquiv.symm

/-- The faithful action of the order-thirty Singer normalizer. -/
def action : normalizer →* MulAut (Multiplicative K) where
  toFun g := g.val.toAddEquiv.toMultiplicative
  map_one' := by apply MulEquiv.ext; intro x; rfl
  map_mul' g h := by apply MulEquiv.ext; intro x; rfl

/-- The genuine affine group 16:(15:2) with the prescribed field involution. -/
abbrev Model := Multiplicative K ⋊[action] normalizer

/-- The additive field as the translation subgroup. -/
def root : Multiplicative K →* Model := SemidirectProduct.inl

/-- Nonzero field scalars, with their actual multiplication action. -/
def scalar : Kˣ →* Model := SemidirectProduct.inr.comp
  (multiplication.codRestrict normalizer (fun u => (show torus ≤ normalizer from le_sup_left) ⟨u,rfl⟩))

/-- Fourth-power Frobenius in the affine group. -/
def fieldElement : Model := SemidirectProduct.inr
  ⟨frobenius,(show zpowers frobenius ≤ normalizer from le_sup_right) (mem_zpowers _)⟩

theorem fieldElement_order : orderOf fieldElement = 2 := by
  rw [fieldElement, orderOf_injective SemidirectProduct.inr
    SemidirectProduct.inr_injective, Subgroup.orderOf_mk]
  exact orderOf_eq_prime frobenius_square frobenius_ne_one

theorem scalar_injective : Function.Injective scalar := by
  intro u v h
  apply multiplication_injective
  exact congrArg (fun x : Model => (x.right : K ≃ₗ[F] K)) h

theorem scalar_conjugation (u : Kˣ) (x : Multiplicative K) :
    scalar u * root x * (scalar u)⁻¹ =
      root (Multiplicative.ofAdd ((u : K) * x.toAdd)) := by
  have hs : SemidirectProduct.inr (scalar u).right = scalar u := rfl
  have ht := (SemidirectProduct.inl_aut (φ := action) (scalar u).right x).symm
  rw [map_inv,hs] at ht
  exact ht

theorem fieldElement_conjugation (x : Multiplicative K) :
    fieldElement * root x * fieldElement⁻¹ = root (Multiplicative.ofAdd (x.toAdd ^ 4)) := by
  exact (SemidirectProduct.inl_aut (φ := action)
    ⟨frobenius,(show zpowers frobenius ≤ normalizer from le_sup_right) (mem_zpowers _)⟩ x).symm.trans
      (congrArg root (congrArg Multiplicative.ofAdd (frobenius_apply x.toAdd)))

theorem fieldElement_scalar (u : Kˣ) :
    fieldElement * scalar u * fieldElement⁻¹ = scalar (u ^ 4) := by
  change SemidirectProduct.inr _ * SemidirectProduct.inr _ *
    (SemidirectProduct.inr _)⁻¹ = SemidirectProduct.inr _
  rw [← map_inv,← map_mul,← map_mul]
  apply congrArg SemidirectProduct.inr
  exact Subtype.ext (frobenius_conjugation u)

theorem model_card : Nat.card Model = 480 := by
  rw [SemidirectProduct.card,Nat.card_congr (Multiplicative.toAdd : Multiplicative K ≃ K),
    Nat.card_eq_fintype_card,field_card,normalizer_card]

/-- Embed the field affine group in the naturally marked whole plane normalizer. -/
def affineEmbedding : Model →* Plane ⋊[naturalAction] LinearGroup :=
  SemidirectProduct.map rootCoordinates.toMonoidHom
    (matrixEquiv.toMonoidHom.comp normalizer.subtype) (by
      intro g
      apply MonoidHom.ext
      intro x
      change coordinates (g.val x.toAdd) =
        Representation.SL2FourNatural.SemilinearNormalizer.glEquiv
          (matrixEquiv g.val) (coordinates x.toAdd)
      rw [matrixEquiv,MulEquiv.trans_apply,MulEquiv.apply_symm_apply]
      change _ = coordinates (g.val (coordinates.symm (coordinates x.toAdd)))
      rw [coordinates.symm_apply_apply])

theorem affineEmbedding_injective : Function.Injective affineEmbedding := by
  intro x y h
  apply SemidirectProduct.ext
  · exact rootCoordinates.injective (congrArg SemidirectProduct.left h)
  · apply Subtype.ext
    exact matrixEquiv.injective (congrArg SemidirectProduct.right h)

@[simp] theorem affineEmbedding_root (x : Multiplicative K) :
    affineEmbedding (root x) = SemidirectProduct.inl (rootCoordinates x) := by
  exact SemidirectProduct.map_inl _ _ _ x

end Sporadic.Janko3.SourceRecognition.SingerField
