module
public import Theory.SpecificGroups.Janko3.SourceRecognition.Seventeen.Universal

/-!
# Corollary 2.8 for faithful three-group completions

A completion is initially generated by all three local groups. The
intersections of orders 24 and 12 generate H₃, whose order is 120:
otherwise the order-twelve intersection would lie in the order-thirty
H₁–H₂ intersection. Consequently H₁ and H₂ already generate the
completion. Lemma 2.7 and the graph-of-maps argument then give its order
and universal mapping property.

Source: Baumeister, *A geometry for groups of J₃-type* (2007),
Corollary 2.8, printed p.498.
-/

@[expose] public noncomputable section
open Subgroup
namespace Sporadic.Janko3.SourceRecognition.Seventeen

/-- A faithful three-group completion, generated by all three actual local subgroups. -/
structure CompletionData (G : Type*) [Group G] where
  H1 : Subgroup G
  H2 : Subgroup G
  H3 : Subgroup G
  generated : H1 ⊔ H2 ⊔ H3 = ⊤
  action : Complement →* MulAut Plane
  pointEquiv : H1 ≃* Plane ⋊[action] Complement
  core_centralizer : centralizer (pCore 2 H1 : Set H1) = pCore 2 H1
  pairEquiv : H2 ≃* PairGroup
  triangleEquiv : H3 ≃* TriangleGroup
  overlap12 : (H1 ⊓ H2 : Subgroup G) ≃* Complement
  overlap13 : (H1 ⊓ H3 : Subgroup G) ≃*
    (alternatingGroup (Fin 4) × Multiplicative (ZMod 2))
  overlap23 : (H2 ⊓ H3 : Subgroup G) ≃*
    (Equiv.Perm (Fin 3) × Multiplicative (ZMod 2))

namespace CompletionData
variable {G : Type*} [Group G] (C : CompletionData G)

private theorem third_relative_generated :
    C.H1.subgroupOf C.H3 ⊔ C.H2.subgroupOf C.H3 = ⊤ := by
  have h3 : Nat.card C.H3 = 120 := by
    rw [Nat.card_congr C.triangleEquiv.toEquiv, Nat.card_prod, nat_card_alternatingGroup]
    norm_num [Nat.card_fin, Nat.factorial, Nat.card_eq_fintype_card,
      Fintype.card_multiplicative]
  have h13 : Nat.card (C.H1 ⊓ C.H3 : Subgroup G) = 24 := by
    rw [Nat.card_congr C.overlap13.toEquiv, Nat.card_prod, nat_card_alternatingGroup]
    norm_num [Nat.card_fin, Nat.factorial, Nat.card_eq_fintype_card,
      Fintype.card_multiplicative]
  have h23 : Nat.card (C.H2 ⊓ C.H3 : Subgroup G) = 12 := by
    rw [Nat.card_congr C.overlap23.toEquiv]
    norm_num [Nat.card_prod, Nat.card_eq_fintype_card, Fintype.card_multiplicative,
      Fintype.card_perm, Nat.factorial]
  have h12 : Nat.card (C.H1 ⊓ C.H2 : Subgroup G) = 30 := by
    rw [Nat.card_congr C.overlap12.toEquiv]
    norm_num [Complement, Nat.card_prod, Nat.card_eq_fintype_card,
      Fintype.card_multiplicative, DihedralGroup.card]
  let : Finite C.H3 := Nat.finite_of_card_ne_zero (by rw [h3]; decide)
  let A := C.H1.subgroupOf C.H3
  let B := C.H2.subgroupOf C.H3
  have ha : Nat.card A = 24 := by
    change Nat.card (C.H1.subgroupOf C.H3) = 24
    rw [← inf_subgroupOf_right, Nat.card_congr (subgroupOfEquivOfLe
      (show C.H1 ⊓ C.H3 ≤ C.H3 from inf_le_right)).toEquiv]
    exact h13
  have hi : A.index = 5 := by
    have hh := A.card_mul_index
    rw [ha, h3] at hh
    omega
  have hd : (A ⊔ B).index ∣ 5 := hi ▸ index_dvd_of_le (show A ≤ A ⊔ B from le_sup_left)
  rcases (Nat.dvd_prime (by decide : Nat.Prime 5)).mp hd with h | h
  · exact index_eq_one.mp h
  · have he : A ⊔ B = A := by
      apply (eq_of_le_of_card_ge (show A ≤ A ⊔ B from le_sup_left) ?_).symm
      have hm := (A ⊔ B).card_mul_index
      rw [h, h3] at hm
      omega
    have hBA : B ≤ A := he ▸ (show B ≤ A ⊔ B from le_sup_right)
    have hle : C.H2 ⊓ C.H3 ≤ C.H1 ⊓ C.H2 := by
      intro x hx
      exact ⟨hBA (show (⟨x, hx.2⟩ : C.H3) ∈ B from hx.1), hx.1⟩
    have hh := card_dvd_of_le hle
    rw [h23, h12] at hh
    norm_num at hh

theorem third_le : C.H3 ≤ C.H1 ⊔ C.H2 := by
  have hh := congrArg (Subgroup.map C.H3.subtype) (third_relative_generated C)
  rw [Subgroup.map_sup, subgroupOf_map_subtype, subgroupOf_map_subtype,
    ← MonoidHom.range_eq_map, range_subtype] at hh
  rw [← hh]
  exact sup_le (inf_le_left.trans le_sup_left) (inf_le_left.trans le_sup_right)

theorem pair_generated : C.H1 ⊔ C.H2 = ⊤ := by
  rw [← C.generated, sup_eq_left.mpr C.third_le]

/-- The missing two-generator premise follows from the local overlap geometry. -/
def source : SourceData G where
  H1 := C.H1
  H2 := C.H2
  H3 := C.H3
  generated := C.pair_generated
  action := C.action
  pointEquiv := C.pointEquiv
  core_centralizer := C.core_centralizer
  pairEquiv := C.pairEquiv
  triangleEquiv := C.triangleEquiv
  overlap12 := C.overlap12
  overlap13 := C.overlap13
  overlap23 := C.overlap23

/-- Corollary 2.8 for completions initially generated by all three local groups. -/
theorem corollary_2_8 {K : Type*} [Group K] (F : CompatibleMaps C.source K) :
    Nat.card G = 8160 ∧
      ∃! f : G →* K, ∀ (i : Fin 3) (x : C.source.family i), f x = F.map i x :=
  C.source.corollary_2_8 F

end CompletionData
end Sporadic.Janko3.SourceRecognition.Seventeen
