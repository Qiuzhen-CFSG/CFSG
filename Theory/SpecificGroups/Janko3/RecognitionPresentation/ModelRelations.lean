private theorem fast_relator_2 : relator fastA fastB 2 = 1 := by
  apply Equiv.ext
  apply allBlocks
  intro j
  fin_cases j
  · exact relator2_block0
  · exact relator2_block1
  · exact relator2_block2
  · exact relator2_block3
  · exact relator2_block4
  · exact relator2_block5
  · exact relator2_block6
  · exact relator2_block7
  · exact relator2_block8
  · exact relator2_block9
  · exact relator2_block10
  · exact relator2_block11

private theorem model_relator_2 : relator a b 2 = 1 := by
  apply embedding_injective
  rw [map_relator, map_one]
  change relator atlasA atlasB 2 = 1
  rw [← fastA_eq_atlas, ← fastB_eq_atlas]
  exact fast_relator_2

