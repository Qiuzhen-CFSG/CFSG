/-- All eight literal ATLAS relators hold on the public model generators. -/
public theorem model_satisfies : Satisfies a b := by
  intro i
  fin_cases i
  · exact a_sq
  · exact b_cube
  · exact model_relator_2
  · exact ab_pow
  · exact model_relator_4
  · exact model_relator_5
  · exact model_relator_6
  · exact model_relator_7

/-- The abstract presentation maps onto the actual permutation model. -/
public theorem model_evaluation_surjective :
    Function.Surjective (evaluation model_satisfies) :=
  evaluation_surjective model_satisfies generators_closure

/-- The ATLAS pair generates the model and satisfies this presentation. -/
public theorem model_hasGenerators : HasGenerators Model :=
  ⟨a, b, generators_closure, model_satisfies⟩

