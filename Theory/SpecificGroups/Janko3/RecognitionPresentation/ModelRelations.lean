/-!
# The concrete J₃ permutations satisfy the ATLAS presentation

We check the five remaining word identities of `J3G1-P1` on every letter
of the actual degree-6156 representation. The packed generators are already
proved equal to `atlasA` and `atlasB`. Blocks of 513 letters keep kernel
reduction bounded; declarations are elaborated sequentially to bound memory.
The universal property then gives a surjection from the abstract presentation
onto the independently constructed model. It does not yet give injectivity.

Source: R. A. Wilson et al., ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/spor/J3/mag/J3G1-P1.M .
Generated by `source/generate_relations.py`; the generator is not trusted.
-/

namespace Sporadic.Janko3.RecognitionPresentation
open OrderCertificate

set_option Elab.async false

private def blockLetter (j : Fin 12) (i : Fin 513) : Fin 6156 :=
  ⟨513 * j.val + i.val, by omega⟩

private theorem allBlocks (P : Fin 6156 → Prop)
    (h : ∀ j i, P (blockLetter j i)) : ∀ i, P i := by
  intro i
  let j : Fin 12 := ⟨i.val / 513, by omega⟩
  let k : Fin 513 := ⟨i.val % 513, Nat.mod_lt _ (by decide)⟩
  have he : blockLetter j k = i := by
    apply Fin.ext
    dsimp [blockLetter, j, k]
    omega
  exact he ▸ h j k

private theorem relator2_block0 : ∀ i : Fin 513,
    relator fastA fastB 2 (blockLetter 0 i) = blockLetter 0 i := by
  apply allFin
  decide +kernel

