/-!
# Finiteness of the six-relator local presentation

The complete Todd–Coxeter certificate gives 2040 representatives for right
cosets of the cyclic subgroup generated by `z`. Every one of its 137102
deductions and all 8160 signed output transitions are checked by Lean's kernel.
The six-rule calculus supplies actual subgroup witnesses, so word induction
gives a cover of the presented group, without assuming that it is finite.
The fourth-power relation bounds the cyclic subgroup by four and hence the
whole local presentation by 8160.

This proves the local-presentation input of the ATLAS J3G1-P1 subgroup argument.
The independent four word identities in the original eight-relator group remain
the explicit premise of the final theorem below. Data provenance, reproduction
commands and measurements are in `LocalBound/source/README.md`.
-/

namespace Sporadic.Janko3.RecognitionPresentation.OrderBound.M1Finite.LocalPresentation
open Subgroup.CosetWordCertificate

/-- A complete cover with actual coset witnesses in the six-relator group. -/
public def cosetCover : Subgroup.GeneratorCosetCover cyclicSubgroup generator (Fin 2040) := by
  have hzero : Certificate.definitions.repr generator
      (Certificate.survivor (0 : Fin 2040)) = 1 := by
    rw [Certificate.survivor_zero]
    exact Certificate.definitions.repr_zero _
  exact coverOfFacts Certificate.facts Certificate.survivor 0 hzero
    Certificate.dest Certificate.output Certificate.shape
    (fun i a => Certificate.sound_137102 _ (Certificate.output_lt i a))

/-- The separate six-relator presentation is finite of order at most 8160. -/
public theorem finite_card : Finite Carrier ∧ Nat.card Carrier ≤ 8160 :=
  finite_card_of_cover cosetCover

end Sporadic.Janko3.RecognitionPresentation.OrderBound.M1Finite.LocalPresentation

namespace Sporadic.Janko3.RecognitionPresentation.OrderBound

/-- The checked local certificate discharges the local finiteness premise in
the literal M₁ consumer. Only the independently owned word relations remain. -/
public theorem m1_finite_card_of_remaining_relations (hrel : M1Finite.RemainingRelations) :
    Finite M1 ∧ Nat.card M1 ≤ 8160 :=
  m1_finite_card_of_local_relations hrel M1Finite.LocalPresentation.finite_card

end Sporadic.Janko3.RecognitionPresentation.OrderBound
