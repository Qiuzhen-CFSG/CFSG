noncomputable def ap1 : Letter (Fin 3) := (0, true)
noncomputable def am1 : Letter (Fin 3) := (0, false)
noncomputable def ap2 : Letter (Fin 3) := (1, true)
noncomputable def am2 : Letter (Fin 3) := (1, false)

/-- Four base-four digits encode the signed ambient letters. -/
noncomputable def decodeAmbient : Nat → Nat → Word (Fin 3)
  | 0, _ => []
  | n + 1, c =>
      (if c % 4 = 0 then ap1 else if c % 4 = 1 then am1
       else if c % 4 = 2 then ap2 else am2) :: decodeAmbient n (c / 4)

/-- A base-16384 digit stores twice the label plus the negative-sign bit. -/
noncomputable def decodeWord : Nat → Nat → Word Nat
  | 0, _ => []
  | n + 1, c => (c % 16384 / 2, c % 2 == 0) :: decodeWord n (c / 16384)

