module
public import Theory.SpecificGroups.Janko3.RecognitionPresentation.OrderBound.M1Finite.Relations.LongWords.WordCalculus

/-!
# The literal third generator in the retained J₃ Schreier presentation

The RRS generator `s8` has the word `auxiliaryWord` below. Three short relations
for this literal element follow from the original source relators. The separate
coordinate and seventeen-letter identities remain explicit bridge premises.

Source: ATLAS J3G1-P1,
https://brauer.maths.qmul.ac.uk/Atlas/spor/J3/mag/J3G1-P1.M .
-/

@[expose] public section
namespace Sporadic.Janko3.RecognitionPresentation.OrderBound.M1Finite.Relations.LongWords

variable {G : Type*} [Group G]

def auxiliaryWord (a b : G) : G :=
  a⁻¹ * b * (a * b⁻¹) ^ 5 * (a⁻¹ * b) ^ 4 * a⁻¹ * b⁻¹

def coordinateWord (a c : G) : G :=
  c ^ 2 * a * c⁻¹ * a * c * a * c ^ 2 * a * c ^ 2 * a

def seventeenWord (a c t : G) : G :=
  c⁻¹ * a * t⁻¹ * a * t⁻¹ * c * a * c⁻¹ * t * a * c * a *
    c⁻¹ * t * a * c * a

def letters (a b : G) : Nat → G
  | 0 => a
  | 1 => b
  | 2 => b⁻¹
  | _ => 1

theorem letters_inverse (a b : G) (hx : a ^ 2 = 1) :
    ∀ n, letters a b (inverseLetter n) = (letters a b n)⁻¹ := by
  have hxx : a * a = 1 := by simpa only [pow_two] using hx
  have hxi : a⁻¹ = a := inv_eq_of_mul_eq_one_right hxx
  intro n
  rcases n with _ | (_ | (_ | (_ | (_ | n)))) <;> simp [letters, inverseLetter, hxi]

private theorem unrotate_one (g : Nat → G) (w : List Nat) (n : Nat)
    (h : readWord g (rotate w n) = 1) : readWord g w = 1 := by
  rw [rotate, readWord_append, mul_eq_one_comm, ← readWord_append,
    List.take_append_drop] at h
  exact h

theorem short_three (a b : G) (h : Satisfies a b) :
    (a * (auxiliaryWord a b)⁻¹) ^ 3 = 1 := by
  let g := letters a b
  have hx : a ^ 2 = 1 := h 0
  have hy : b ^ 3 = 1 := h 1
  have hxx : a * a = 1 := by simpa only [pow_two] using hx
  have hxi : a⁻¹ = a := inv_eq_of_mul_eq_one_right hxx
  have hyy : b * b = b⁻¹ := by
    have hh := congrArg (fun t => t * b⁻¹) hy
    simpa [pow_succ, mul_assoc] using hh
  have hi := letters_inverse a b hx
  have base_aa : readWord g [0, 0] = readWord g [] := by simp [g, letters, hxx]
  have base_bB : readWord g [1, 2] = readWord g [] := by simp [g, letters]
  have base_Bb : readWord g [2, 1] = readWord g [] := by simp [g, letters]
  have base_bb : readWord g [1, 1] = readWord g [2] := by simp [g, letters, hyy]
  have base_BB : readWord g [2, 2] = readWord g [1] := by
    simpa [g, letters, mul_inv_rev] using congrArg Inv.inv hyy
  have step_end : readWord g [] = 1 := rfl
  have step_34 : readWord g [0, 0] = 1 :=
    (context g [] [] [0, 0] [] base_aa).trans step_end
  have step_33 : readWord g [0, 1, 2, 0] = 1 :=
    (context g [0] [0] [1, 2] [] base_bB).trans step_34
  have step_32 : readWord g [0, 1, 0, 0, 2, 0] = 1 :=
