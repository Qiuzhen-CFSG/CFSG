  have step_29 : readWord g [0, 1, 0, 2, 0, 2, 1, 0, 1, 0, 2, 0] = 1 :=
    (context g [0, 1, 0, 2, 0] [0, 1, 0, 2, 0] [2, 1] [] base_Bb).trans step_30
