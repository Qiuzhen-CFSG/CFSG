module

public import Theory.SpecificGroups.Janko3.RecognitionPresentation.Basic
public import Theory.GroupTheory.CosetWordCertificate
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Group

/-!
# Literal inputs for the J₃ presentation order certificate

The ATLAS subgroup M₁ is generated by `x` and `(y*x)^5*y⁻¹*x*y*x*y`.
We give that second word an auxiliary generator label and append its defining
relation to the eight original relations. All nine signed words are verified
in an arbitrary group satisfying the original relations. Thus a coset trace
using this interface yields equations in the abstract presentation itself.

The representative tree and the subgroup loops are realized here independently
of both the enumeration and finiteness. The two remaining mathematical inputs
are a 6156-representative cover and a finite bound of 8160 for this literal M₁.

Source: ATLAS J3G1-P1,
https://brauer.maths.qmul.ac.uk/Atlas/spor/J3/mag/J3G1-P1.M .
-/

@[expose] public section
namespace Sporadic.Janko3.RecognitionPresentation.OrderBound
open Subgroup.CosetWordCertificate

/-- The second generator in the ATLAS definition of M₁. -/
def m1Word {G : Type*} [Group G] (a b : G) : G :=
  (b * a) ^ 5 * b⁻¹ * a * b * a * b

/-- The fourth-power relation for the literal M₁ generator follows from
source relator indexed seven by conjugation with the order-three generator. -/
theorem m1Word_four {G : Type*} [Group G] {a b : G} (h : Satisfies a b) : m1Word a b ^ 4 = 1 := by
  have hb : b ^ 3 = 1 := h 1
  have hb2 : b ^ 2 = b⁻¹ := by
    have he := congrArg (fun t => t * b⁻¹) hb
    simpa [pow_succ, mul_assoc] using he
  have he : m1Word a b = b * ((a * b) ^ 3 * (a * b * a * b⁻¹) ^ 2) * b⁻¹ := by
    calc
      m1Word a b = b * ((a * b) ^ 3 * (a * b * a * b⁻¹) ^ 2) * b ^ 2 := by
        simp only [m1Word, pow_succ, pow_zero]
        group
      _ = _ := by rw [hb2]
  rw [he, conj_pow]
  have hu : ((a * b) ^ 3 * (a * b * a * b⁻¹) ^ 2) ^ 4 = 1 := h 7
  rw [hu]
  simp

/-- The actual subgroup of the abstract eight-relator presentation. -/
def M1 : Subgroup Presentation := Subgroup.closure ({x, m1Word x y} : Set Presentation)

/-- The auxiliary label is a specified word, not a new group assumption. -/
def extendedPair {G : Type*} [Group G] (a b : G) : Fin 3 → G
  | 0 => a
  | 1 => b
  | 2 => m1Word a b

def generator : Fin 3 → Presentation := extendedPair x y

/-- The fourth-power relation holds in the actual abstract presentation. -/
theorem m1_generator_four : generator 2 ^ 4 = 1 :=
  m1Word_four presentation_satisfies

/-- The eight source words, followed by the defining relation for label two. -/
def relatorWord : Fin 9 → Word (Fin 3)
  | 0 => [(0, true), (0, true)]
  | 1 => [(1, true), (1, true), (1, true)]
  | 2 => [(0, false), (1, false), (0, true), (1, true), (0, false), (1, false), (0, true), (1, true), (0, false), (1, false), (0, true), (1, true), (0, false), (1, false), (0, true), (1, true), (0, false), (1, false), (0, true), (1, true), (0, false), (1, false), (0, true), (1, true), (0, false), (1, false), (0, true), (1, true), (0, false), (1, false), (0, true), (1, true), (0, false), (1, false), (0, true), (1, true)]
  | 3 => [(0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true)]
  | 4 => [(0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, false), (0, true), (1, false), (0, true), (1, false), (0, true), (1, false), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, false), (0, true), (1, false), (0, true), (1, false), (0, true), (1, false)]
  | 5 => [(0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false)]
  | 6 => [(0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false)]
  | 7 => [(0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, false)]
  | 8 => [(1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, true), (0, true), (1, false), (0, true), (1, true), (0, true), (1, true), (2, false)]

/-- Literal transcription: no permutation calculation is involved. -/
theorem relatorWord_source {G : Type*} [Group G] (a b : G) (i : Fin 8) :
    eval (extendedPair a b) (relatorWord i.castSucc) = relator a b i := by
  fin_cases i <;>
    simp [relatorWord, eval_cons, extendedPair, relator, pow_succ, mul_assoc]

/-- The last relation merely names the specified subgroup word. -/
theorem relatorWord_auxiliary {G : Type*} [Group G] (a b : G) :
    eval (extendedPair a b) (relatorWord 8) = 1 := by
  simp [relatorWord, eval_cons, extendedPair, m1Word, pow_succ, mul_assoc]

/-- Natural-number indexing expected by the certificate checker. -/
def relatorWords (r : Nat) : Word (Fin 3) :=
  if h : r < 9 then relatorWord ⟨r, h⟩ else []

theorem relatorWords_satisfied {G : Type*} [Group G] {a b : G}
    (h : Satisfies a b) (r : Nat) : eval (extendedPair a b) (relatorWords r) = 1 := by
  by_cases hr : r < 8
  · rw [relatorWords, dif_pos (by omega)]
    exact (relatorWord_source a b ⟨r, hr⟩).trans (h ⟨r, hr⟩)
  · by_cases he : r = 8
    · subst r
      exact relatorWord_auxiliary a b
    · simp [relatorWords, show ¬ r < 9 by omega]

theorem generator_relators (r : Nat) : eval generator (relatorWords r) = 1 :=
  relatorWords_satisfied presentation_satisfies r

theorem generator_generates : Subgroup.closure (Set.range generator) = ⊤ := by
  apply top_unique
  rw [← PresentedGroup.closure_range_of rels]
  apply Subgroup.closure_mono
  rintro _ ⟨b, rfl⟩
  cases b
  · exact ⟨0, rfl⟩
  · exact ⟨1, rfl⟩

/-- A two-generator trace suffices: word induction extends its covering
transitions to the auxiliary label as well. -/
def extendCosetCover {ι : Type*}
    (C : Subgroup.GeneratorCosetCover M1 (PresentedGroup.of : Bool → Presentation) ι) :
    Subgroup.GeneratorCosetCover M1 generator ι where
  repr := C.repr
  initial := C.initial
  initial_eq := C.initial_eq
  step i a := C.covers (PresentedGroup.closure_range_of rels) (C.repr i * generator a)
  inv_step i a := C.covers (PresentedGroup.closure_range_of rels) (C.repr i * (generator a)⁻¹)

theorem x_mem_M1 : x ∈ M1 := Subgroup.subset_closure (by simp)

theorem m1Word_mem_M1 : m1Word x y ∈ M1 := Subgroup.subset_closure (by simp)

/-- Only the two advertised subgroup generators supply initial loops. -/
def allowed (a : Letter (Fin 3)) : Bool := decide (a = (0, true) ∨ a = (2, true))

theorem allowed_mem (a : Letter (Fin 3)) (ha : allowed a = true) :
    eval generator [a] ∈ M1 := by
  have ha' : a = (0, true) ∨ a = (2, true) := by simpa [allowed] using ha
  rcases ha' with rfl | rfl
  · exact x_mem_M1
  · exact m1Word_mem_M1

/-- Every acyclic representative tree has a sound interpretation in Presentation.
The actual enumeration must still certify its output transitions. -/
theorem certificate_valid (D : Definitions (Fin 3)) :
    Valid ⟨D.parent, D.letter, relatorWords, allowed⟩ M1 generator (D.repr generator) :=
  D.valid relatorWords allowed allowed_mem generator_relators

end Sporadic.Janko3.RecognitionPresentation.OrderBound
