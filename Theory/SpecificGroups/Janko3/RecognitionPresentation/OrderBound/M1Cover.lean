module

public import Theory.SpecificGroups.Janko3.RecognitionPresentation.OrderBound.M1Cover.Checked
public import Theory.SpecificGroups.Janko3.RecognitionPresentation.OrderBound.M1Cover.Shape
public import Theory.GroupTheory.GeneratorCosetCoverFiniteIndex

/-!
# The 6156-coset cover of the abstract J₃ presentation

Starting from the literal subgroup M₁ generated by `x` and
`(y*x)^5*y⁻¹*x*y*x*y`, a checked Todd–Coxeter trace gives subgroup-witness
transitions for both signs of the two canonical generators on 6156
representatives. Word induction extends this cover to the auxiliary generator.
The resulting finite-index and index-bound conclusions require no finiteness,
simplicity, cardinality, or recognition hypothesis on the presented group.

The trace checks 277281 deductions, including 33523 compact relator scans.
`M1Cover/source/README.md` records the data conventions and reproduction.

Source: ATLAS J3G1-P1, https://brauer.maths.qmul.ac.uk/Atlas/spor/J3/mag/J3G1-P1.M .
-/

namespace Sporadic.Janko3.RecognitionPresentation.OrderBound
namespace M1Certificate
open Subgroup.CosetWordCertificate

private theorem transitions (i : Fin 6156) (a : Fin 4) :
    Holds M1 generator (definitions.repr generator)
      ⟨i.val, [decode a.val], (destination (4*i.val+a.val)).val⟩ := by
  have hs := (factBEq_eq_true_iff _ _).mp (all_shapes (4*i.val+a.val) (by omega))
  have hd : (4*i.val+a.val) / 4 = i.val := by omega
  have hm : (4*i.val+a.val) % 4 = a.val := by omega
  change facts (output (4*i.val+a.val)) = _ at hs
  rw [hd, hm] at hs
  rw [← hs]
  exact all_hold _ (output_lt _)

private def canonicalCover :
    Subgroup.GeneratorCosetCover M1 (PresentedGroup.of : Bool → Presentation) (Fin 6156) where
  repr i := definitions.repr generator i.val
  initial := 0
  initial_eq := definitions.repr_zero generator
  step i a := by
    cases a
    · obtain ⟨h, hh⟩ := transitions i 0
      refine ⟨h, destination (4*i.val+0), ?_⟩
      simpa [decode, generator, extendedPair, x, y] using hh
    · obtain ⟨h, hh⟩ := transitions i 2
      refine ⟨h, destination (4*i.val+2), ?_⟩
      simpa [decode, generator, extendedPair, x, y] using hh
  inv_step i a := by
    cases a
    · obtain ⟨h, hh⟩ := transitions i 1
      refine ⟨h, destination (4*i.val+1), ?_⟩
      simpa [decode, generator, extendedPair, x, y] using hh
    · obtain ⟨h, hh⟩ := transitions i 3
      refine ⟨h, destination (4*i.val+3), ?_⟩
      simpa [decode, generator, extendedPair, x, y] using hh

end M1Certificate

/-- Certified coverage of the literal ATLAS subgroup by 6156 representatives. -/
public def m1Cover : Subgroup.GeneratorCosetCover M1 generator (Fin 6156) :=
  extendCosetCover M1Certificate.canonicalCover

/-- Finiteness of the quotient follows from actual covering equations. -/
public theorem m1_finiteIndex : M1.FiniteIndex :=
  ⟨(m1Cover.index_pos generator_generates).ne'⟩

/-- The requested bound for the index of the actual abstract subgroup M₁. -/
public theorem m1_index_le : M1.index ≤ 6156 := by
  simpa using m1Cover.index_le_card generator_generates

end Sporadic.Janko3.RecognitionPresentation.OrderBound
