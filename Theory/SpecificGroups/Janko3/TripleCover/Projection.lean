module

public import Theory.SpecificGroups.Janko3.TripleCover.Presentation
public import Theory.SpecificGroups.Janko3.RecognitionPresentation.ModelRelations
public import Theory.SpecificGroups.Janko3.Model.Perfect
public import Theory.GroupTheory.PerfectCentralCoverKernelLowerBound

/-!
# The marked projection of the cubic J₃ presentation

The candidate maps onto the actual degree-6156 model, sending its two
generators to the already certified model generators. Its quotient by the
central cyclic subgroup generated by `(x*y)^19` is exactly the original
eight-relator presentation. Consequently faithfulness of that presentation
identifies the kernel of the actual model projection. The candidate is then
finite and perfect, and a representation detecting the marked central element
makes its kernel have order three.

Both outstanding mathematical inputs are explicit: injectivity of the
original model evaluation, and nontriviality of the marked cubic element.
The latter can be established using ATLAS `3J3G1-f4r9aB0`. No group-order or
multiplier claim from ATLAS is used as a proof.

Source: ATLAS `J3G1-P1` and `3J3G1-P1`; Aschbacher--Smith I.1.4(2), p.408.
-/

namespace Sporadic.Janko3.TripleCover

open Subgroup PerfectCentralCovering

/-- Every pair satisfying the simple presentation satisfies the cover relators
with trivial marked central element. -/
public theorem satisfies_of_base {G : Type*} [Group G] {a b : G}
    (h : RecognitionPresentation.Satisfies a b) : Satisfies a b := by
  have h19 : (a * b) ^ 19 = 1 := h 3
  change ∀ i : Fin 8, RecognitionPresentation.relator a b i = 1 at h
  intro i
  fin_cases i <;> simp only [relator, h, h19, one_pow, one_mul, mul_one,
    inv_one, mul_inv_cancel]

/-- The canonical epimorphism to the original eight-relator presentation. -/
@[expose] public def baseProjection : Presentation →* RecognitionPresentation.Presentation :=
  evaluation (satisfies_of_base RecognitionPresentation.presentation_satisfies)

@[simp] public theorem baseProjection_x : baseProjection x = RecognitionPresentation.x :=
  evaluation_x _

@[simp] public theorem baseProjection_y : baseProjection y = RecognitionPresentation.y :=
  evaluation_y _

@[simp] public theorem baseProjection_z : baseProjection z = 1 := by
  change evaluation _ z = 1
  rw [evaluation_z]
  exact RecognitionPresentation.presentation_satisfies 3

public theorem baseProjection_surjective : Function.Surjective baseProjection := by
  apply MonoidHom.range_eq_top.mp
  apply top_unique
  intro g _
  apply PresentedGroup.generated_by RecognitionPresentation.rels
  intro t
  cases t
  · exact ⟨x, baseProjection_x⟩
  · exact ⟨y, baseProjection_y⟩

private theorem base_relator_mem (i : Fin 8) :
    RecognitionPresentation.relator x y i ∈ zpowers z := by
  have h0 : RecognitionPresentation.relator x y 0 = 1 := presentation_satisfies 0
  have h1 : RecognitionPresentation.relator x y 1 = 1 := presentation_satisfies 1
  have h2 : RecognitionPresentation.relator x y 2 = 1 := presentation_satisfies 2
  have h4 : RecognitionPresentation.relator x y 4 = 1 := presentation_satisfies 3
  have h5 : RecognitionPresentation.relator x y 5 = 1 := presentation_satisfies 4
  have h6 : RecognitionPresentation.relator x y 6 = 1 := presentation_satisfies 5
  have h7 : RecognitionPresentation.relator x y 7 = z⁻¹ :=
    eq_inv_of_mul_eq_one_left (presentation_satisfies 6)
  fin_cases i
  · exact h0.symm ▸ one_mem (zpowers z)
  · exact h1.symm ▸ one_mem (zpowers z)
  · exact h2.symm ▸ one_mem (zpowers z)
  · exact mem_zpowers z
  · exact h4.symm ▸ one_mem (zpowers z)
  · exact h5.symm ▸ one_mem (zpowers z)
  · exact h6.symm ▸ one_mem (zpowers z)
  · exact h7.symm ▸ inv_mem (mem_zpowers z)

private theorem quotient_satisfies : RecognitionPresentation.Satisfies
    (QuotientGroup.mk' (zpowers z) x) (QuotientGroup.mk' (zpowers z) y) := by
  intro i
  rw [← RecognitionPresentation.map_relator]
  exact (QuotientGroup.eq_one_iff _).mpr (base_relator_mem i)

private def quotientLift : RecognitionPresentation.Presentation →*
    Presentation ⧸ zpowers z := RecognitionPresentation.evaluation quotient_satisfies

private theorem quotientLift_comp : quotientLift.comp baseProjection =
    QuotientGroup.mk' (zpowers z) := by
  apply PresentedGroup.ext
  intro t
  cases t
  · change quotientLift (baseProjection x) = QuotientGroup.mk' (zpowers z) x
    rw [baseProjection_x]
    exact RecognitionPresentation.evaluation_x _
  · change quotientLift (baseProjection y) = QuotientGroup.mk' (zpowers z) y
    rw [baseProjection_y]
    exact RecognitionPresentation.evaluation_y _

/-- No finiteness or recognition premise is needed for the kernel above the
original abstract J₃ presentation. -/
public theorem baseProjection_ker : baseProjection.ker = zpowers z := by
  apply le_antisymm
  · intro g hg
    apply (QuotientGroup.eq_one_iff g).mp
    have h := DFunLike.congr_fun quotientLift_comp g
    rw [MonoidHom.comp_apply, (MonoidHom.mem_ker.mp hg), map_one] at h
    exact h.symm
  · exact zpowers_le.mpr baseProjection_z

/-- The central quotient is genuinely isomorphic to the original presentation;
this does not yet identify either group with the finite permutation model. -/
public noncomputable def quotientEquivPresentation :
    (Presentation ⧸ zpowers z) ≃* RecognitionPresentation.Presentation :=
  (QuotientGroup.quotientMulEquivOfEq baseProjection_ker.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective baseProjection baseProjection_surjective)

/-- Explicit projection onto the actual permutation model. -/
@[expose] public def projection : Presentation →* Model :=
  (RecognitionPresentation.evaluation RecognitionPresentation.model_satisfies).comp
    baseProjection

@[simp] public theorem projection_x : projection x = a := by
  rw [projection, MonoidHom.comp_apply, baseProjection_x,
    RecognitionPresentation.evaluation_x]

@[simp] public theorem projection_y : projection y = b := by
  rw [projection, MonoidHom.comp_apply, baseProjection_y,
    RecognitionPresentation.evaluation_y]

@[simp] public theorem projection_z : projection z = 1 := by
  rw [projection, MonoidHom.comp_apply, baseProjection_z, map_one]

public theorem projection_surjective : Function.Surjective projection :=
  RecognitionPresentation.model_evaluation_surjective.comp baseProjection_surjective

/-- Faithfulness of the existing J₃ presentation identifies the literal kernel
of the explicit model map. -/
public theorem projection_ker
    (hinj : Function.Injective
      (RecognitionPresentation.evaluation RecognitionPresentation.model_satisfies)) :
    projection.ker = zpowers z := by
  rw [projection, MonoidHom.ker_comp_of_injective _ _ hinj, baseProjection_ker]

/-- Finiteness follows from the finite actual model and the central cyclic
kernel of exponent dividing three. Nontriviality of the kernel is not needed. -/
public theorem finite_presentation
    (hinj : Function.Injective
      (RecognitionPresentation.evaluation RecognitionPresentation.model_satisfies)) :
    Finite Presentation := by
  have hz : IsOfFinOrder z := isOfFinOrder_iff_pow_eq_one.mpr ⟨3, by decide, z_cube⟩
  have hfin : Finite (zpowers z) := hz.finite_zpowers.to_subtype
  have hk : Finite projection.ker := (projection_ker hinj).symm ▸ hfin
  exact projection.finite_iff_finite_ker_range.mpr ⟨hk, inferInstance⟩

/-- The genuine central-cover structure once the independent recognition
input is supplied; perfectness was proved directly from the cover relators. -/
@[expose] public def cover
    (hinj : Function.Injective
      (RecognitionPresentation.evaluation RecognitionPresentation.model_satisfies)) :
    Cover Presentation Model where
  toMonoidHom := projection
  surjective := projection_surjective
  isPerfect := presentation_perfect
  ker_le_center := (projection_ker hinj).le.trans zpowers_z_le_center

/-- Detecting the cubic element makes the literal projection kernel have
exact order three. -/
public theorem projection_kernel_card
    (hinj : Function.Injective
      (RecognitionPresentation.evaluation RecognitionPresentation.model_satisfies))
    (hz : z ≠ 1) : Nat.card projection.ker = 3 := by
  rw [projection_ker hinj, Nat.card_zpowers]
  exact orderOf_eq_prime z_cube hz

/-- The constructed cover supplies the lower bound for the canonical universal
kernel. Both remaining concrete inputs are displayed in the statement. -/
public theorem three_dvd_universal_kernel
    (hinj : Function.Injective
      (RecognitionPresentation.evaluation RecognitionPresentation.model_satisfies))
    (hz : z ≠ 1) : 3 ∣ Nat.card (universalProjection Model).ker := by
  have h := (cover hinj).kernel_card_dvd_universal
  change Nat.card projection.ker ∣ _ at h
  rwa [projection_kernel_card hinj hz] at h

end Sporadic.Janko3.TripleCover
