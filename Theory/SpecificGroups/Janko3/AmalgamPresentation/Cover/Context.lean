module

public import Theory.SpecificGroups.Janko3.AmalgamPresentation.Cover.defCode

/-! Relation-derived certificate for the literal universal J₃ amalgam.
Generated by `source/generate.py`; every deduction is checked in Lean's kernel.
The model table supplied only the initial words, never a proof of covering. -/

@[expose] public section
namespace Sporadic.Janko3.AmalgamPresentation.Cover
open Subgroup.CosetWordCertificate

def definitions : Definitions (Fin 6) where
  parent n := min (defCode n / 16) (n - 1)
  letter n := decode (defCode n % 16)
  parent_lt n := by
    have := Nat.min_le_right (defCode (n+1) / 16) (n+1-1)
    omega

def relatorWords (r : Nat) : Word (Fin 6) :=
  if h : r < 22 then relatorWord ⟨r,h⟩ else []

theorem generator_relators (r : Nat) : eval generator (relatorWords r) = 1 := by
  by_cases h : r < 22
  · rw [relatorWords,dif_pos h]
    exact generator_satisfies ⟨r,h⟩
  · simp [relatorWords,h]

def rotatedRelator (r : Nat) : Word (Fin 6) :=
  (if r % 128 < 64 then relatorWords (r / 128)
   else FreeGroup.invRev (relatorWords (r / 128))).rotate (r % 64)

theorem eval_rotate {G α : Type*} [Group G] (g : α → G)
    (w : Word α) (hw : eval g w = 1) (k : Nat) : eval g (w.rotate k) = 1 := by
  simp only [eval, FreeGroup.lift_mk] at hw ⊢
  rw [List.map_rotate]
  exact List.prod_rotate_eq_one_of_prod_eq_one hw k

theorem rotatedRelator_valid (r : Nat) : eval generator (rotatedRelator r) = 1 := by
  apply eval_rotate
  split
  · exact generator_relators _
  · rw [eval_invRev, generator_relators, inv_one]

def allowed (a : Letter (Fin 6)) : Bool := decide (a = (0,true) ∨ a = (1,true))

theorem allowed_mem (a : Letter (Fin 6)) (h : allowed a = true) :
    eval generator [a] ∈ firstLocal := by
  have ha : a = (0,true) ∨ a = (1,true) := by simpa [allowed] using h
  rcases ha with rfl | rfl
  all_goals simp only [eval_letter, ↓reduceIte]; exact Subgroup.subset_closure (by simp)

def context : Context (Fin 6) :=
  ⟨definitions.parent, definitions.letter, rotatedRelator, allowed⟩

theorem context_valid : Valid context firstLocal generator (definitions.repr generator) :=
  definitions.valid rotatedRelator allowed allowed_mem rotatedRelator_valid

end Sporadic.Janko3.AmalgamPresentation.Cover
