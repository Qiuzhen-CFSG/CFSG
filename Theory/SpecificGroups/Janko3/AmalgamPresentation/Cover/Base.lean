/-! Relation-derived certificate for the literal universal J₃ amalgam.
Generated by `source/generate.py`; every deduction is checked in Lean's kernel.
The model table supplied only the initial words, never a proof of covering. -/

@[expose] public section
namespace Sporadic.Janko3.AmalgamPresentation.Cover
open Subgroup.CosetWordCertificate

def branch {α : Type*} (cutoff : Nat) (left right : Nat → α) (i : Nat) : α :=
  if i < cutoff then left i else right i

def unpack (pages : Nat → Nat) (bits i : Nat) : Nat :=
  (pages (i / 128) >>> (bits * (i % 128))) % (2 ^ bits)

def decode (a : Nat) : Letter (Fin 6) :=
  (⟨(a / 2) % 6, Nat.mod_lt _ (by decide)⟩, a % 2 == 0)

end Sporadic.Janko3.AmalgamPresentation.Cover
