module

public import Theory.SpecificGroups.Janko3.AmalgamPresentation.LocalBound.Shape

/-!
# The first local amalgam group has order at most 8160

A complete six-rule certificate proves 1632 right cosets of the subgroup
generated by the first generator. Its fifth-power relator bounds that subgroup
by five. This is a bound on the abstract presentation and every satisfying
pair, without a finiteness or faithfulness premise.
-/

namespace Sporadic.Janko3.AmalgamPresentation.LocalBound
open Subgroup.CosetWordCertificate

/-- A certified cover of the exact six-relator local presentation. -/
public def cosetCover : Subgroup.GeneratorCosetCover cyclicSubgroup generator (Fin 1632) := by
  have hzero : Certificate.definitions.repr generator
      (Certificate.survivor (0 : Fin 1632)) = 1 := by
    rw [Certificate.survivor_zero]
    exact Certificate.definitions.repr_zero _
  exact coverOfFacts Certificate.facts Certificate.survivor 0 hzero
    Certificate.dest Certificate.output Certificate.shape
    (fun i a => Certificate.sound_28458 _ (Certificate.output_lt i a))

/-- The abstract first local group is finite of order at most 8160. -/
public theorem finite_card : Finite Carrier ∧ Nat.card Carrier ≤ 8160 :=
  finite_card_of_cover cosetCover

/-- The same bound holds for the literal subgroup generated by any pair
satisfying the exact first six amalgam relators. -/
public theorem closure_finite_card {G : Type*} [Group G] {u v : G}
    (h : Satisfies u v) :
    Finite (Subgroup.closure ({u, v} : Set G)) ∧
      Nat.card (Subgroup.closure ({u, v} : Set G)) ≤ 8160 :=
  closure_finite_card_of_local h finite_card

end Sporadic.Janko3.AmalgamPresentation.LocalBound
