module

public import Theory.SpecificGroups.Janko3.AmalgamPresentation.Coordinates.Nine.Presentation.Shape

/-!
# The third local amalgam group has order at most 2160

A complete six-rule certificate proves 216 right cosets of the subgroup
generated by the first generator. Its tenth-power relator bounds that subgroup
by ten. This is a bound on the abstract presentation and every satisfying
pair, without a finiteness or faithfulness premise.
-/

namespace Sporadic.Janko3.AmalgamPresentation.Coordinates.Nine.Presentation
open Subgroup.CosetWordCertificate

/-- A certified cover of the exact five-relator local presentation. -/
public def cosetCover : Subgroup.GeneratorCosetCover cyclicSubgroup generator (Fin 216) := by
  have hzero : Certificate.definitions.repr generator
      (Certificate.survivor (0 : Fin 216)) = 1 := by
    rw [Certificate.survivor_zero]
    exact Certificate.definitions.repr_zero _
  exact coverOfFacts Certificate.facts Certificate.survivor 0 hzero
    Certificate.dest Certificate.output Certificate.shape
    (fun i a => Certificate.sound_4436 _ (Certificate.output_lt i a))

/-- The abstract third local group is finite of order at most 2160. -/
public theorem finite_card : Finite Carrier ∧ Nat.card Carrier ≤ 2160 :=
  finite_card_of_cover cosetCover

/-- The same bound holds for the literal subgroup generated by any pair
satisfying the exact third-local five amalgam relators. -/
public theorem closure_finite_card {G : Type*} [Group G] {u v : G}
    (h : Satisfies u v) :
    Finite (Subgroup.closure ({u, v} : Set G)) ∧
      Nat.card (Subgroup.closure ({u, v} : Set G)) ≤ 2160 :=
  closure_finite_card_of_local h finite_card

end Sporadic.Janko3.AmalgamPresentation.Coordinates.Nine.Presentation
