module

public import Theory.SpecificGroups.Janko3.AmalgamPresentation.Coordinates.Four.Presentation.Shape

/-!
# The second local amalgam group has order at most 2880

A complete six-rule certificate proves 480 right cosets of the subgroup
generated by the first generator. Its sixth-power relator bounds that subgroup
by six. This is a bound on the abstract presentation and every satisfying
pair, without a finiteness or faithfulness premise.
-/

namespace Sporadic.Janko3.AmalgamPresentation.FourCoordinates.Presentation
open Subgroup.CosetWordCertificate

/-- A certified cover of the exact five-relator local presentation. -/
public def cosetCover : Subgroup.GeneratorCosetCover cyclicSubgroup generator (Fin 480) := by
  have hzero : Certificate.definitions.repr generator
      (Certificate.survivor (0 : Fin 480)) = 1 := by
    rw [Certificate.survivor_zero]
    exact Certificate.definitions.repr_zero _
  exact coverOfFacts Certificate.facts Certificate.survivor 0 hzero
    Certificate.dest Certificate.output Certificate.shape
    (fun i a => Certificate.sound_10506 _ (Certificate.output_lt i a))

/-- The abstract second local group is finite of order at most 2880. -/
public theorem finite_card : Finite Carrier ∧ Nat.card Carrier ≤ 2880 :=
  finite_card_of_cover cosetCover

/-- The same bound holds for the literal subgroup generated by any pair
satisfying the exact second five amalgam relators. -/
public theorem closure_finite_card {G : Type*} [Group G] {u v : G}
    (h : Satisfies u v) :
    Finite (Subgroup.closure ({u, v} : Set G)) ∧
      Nat.card (Subgroup.closure ({u, v} : Set G)) ≤ 2880 :=
  closure_finite_card_of_local h finite_card

end Sporadic.Janko3.AmalgamPresentation.FourCoordinates.Presentation
