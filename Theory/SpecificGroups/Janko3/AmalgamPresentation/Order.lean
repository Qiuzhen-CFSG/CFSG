module

public import Theory.SpecificGroups.Janko3.AmalgamPresentation.Cover
public import Theory.SpecificGroups.Janko3.AmalgamPresentation.FirstLocal

/-!
# The universal rank-three J₃ amalgam has order at most 150698880

The first local subgroup is bounded by 8160 from its exact six relations.
The independent global relation certificate bounds its index by 18468.
Together these prove finiteness of the universal carrier and the 3·|J₃| bound.
-/

public section
namespace Sporadic.Janko3.AmalgamPresentation

/-- Finiteness is proved by the certificates, rather than assumed of a completion. -/
theorem finite_card : Finite Carrier ∧ Nat.card Carrier ≤ 150698880 := by
  let : Finite firstLocal := firstLocal_finite_card.1
  obtain ⟨hfin,hcard⟩ := firstLocalCover.finite_card_le generator_generates
  refine ⟨hfin,hcard.trans ?_⟩
  simpa using Nat.mul_le_mul_right 18468 firstLocal_finite_card.2

/-- Any group generated by a satisfying marked six-tuple obeys the same bound. -/
theorem finite_card_of_satisfies {G : Type*} [Group G] {g : Fin 6 → G}
    (h : Satisfies g) (hgen : Subgroup.closure (Set.range g) = ⊤) :
    Finite G ∧ Nat.card G ≤ 150698880 := by
  let : Finite Carrier := finite_card.1
  have hs := evaluation_surjective h hgen
  exact ⟨Finite.of_surjective _ hs,(Nat.card_le_card_of_surjective _ hs).trans finite_card.2⟩

end Sporadic.Janko3.AmalgamPresentation
