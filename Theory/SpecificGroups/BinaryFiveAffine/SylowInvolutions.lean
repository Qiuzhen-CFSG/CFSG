module
public import Theory.SpecificGroups.BinaryFiveAffine.SylowMarking
public import Theory.SpecificGroups.SymmetricFourWreath.NormalElementaryGeometry
/-!
# The marked pair and central involutions in the affine Sylow model

The standard Sylow subgroup is the dihedral wreath group of order 128.
Its base is the Thompson subgroup and the centralizer of the marked pair
vector. Swapping the two dihedral factors carries that pair vector to its
complementary pair; their product is the unique central involution.
The center of the base is the four-group generated by these two marks.

The pair vector is a Sylow square, so it lies in the intrinsic normal
extraspecial core. Only the 128-element Sylow model is checked, not the
whole affine group.
Source: Aschbacher–Smith (2.4.29), printed p.545.
-/
@[expose] public section
namespace BinaryFiveAffine
open Subgroup Stellmacher
open BinaryPermutation.AlternatingFiveExtension.SylowModel
private instance : Fintype PlaneWreath := Fintype.ofEquiv _ (RegularWreathProduct.equivProd PlaneGroup Bit).symm
private instance : DecidableEq PlaneWreath := (RegularWreathProduct.equivProd PlaneGroup Bit).injective.decidableEq

private instance : DecidablePred (·∈(RegularWreathProduct.rightHom : PlaneWreath →* Bit).ker) := fun x=>inferInstanceAs (Decidable (x.right=1))
def planeBase : Subgroup PlaneWreath := (RegularWreathProduct.rightHom : PlaneWreath →* Bit).ker

theorem thompson_planeWreath : elementaryAbelianMaxJ (⊤:Subgroup PlaneWreath)=planeBase := by
  apply map_injective (f:=wreathEquiv.toMonoidHom) wreathEquiv.injective
  rw [←elementaryAbelianMaxJ_map_injective _ wreathEquiv.injective,
    map_top_of_surjective _ wreathEquiv.surjective,SymmetricFourWreath.thompson_P_eq_pair]
  ext p
  rw [SymmetricFourWreath.mem_pair_range]
  constructor
  · intro hp
    exact ⟨wreathEquiv.symm p,hp,wreathEquiv.apply_symm_apply p⟩
  · rintro ⟨x,hx,rfl⟩
    exact hx

def sylowEmbedding : PlaneWreath →* W := embedding
theorem sylowEmbedding_injective : Function.Injective sylowEmbedding := embedding_injective

def sylowBase : Subgroup W := planeBase.map sylowEmbedding

theorem thompson_standardSylow : elementaryAbelianMaxJ (standardSylow:Subgroup W)=sylowBase := by
  change elementaryAbelianMaxJ (standardSylow:Subgroup W)=planeBase.map sylowEmbedding
  rw [←thompson_planeWreath]
  have h := elementaryAbelianMaxJ_map_injective embedding embedding_injective (⊤:Subgroup PlaneWreath)
  rw [←MonoidHom.range_eq_map] at h
  exact h

private instance : DecidablePred (·∈planeBase) := fun x=>inferInstanceAs (Decidable (x.right=1))
private instance : DecidableEq W := SemidirectProduct.equivProd.injective.decidableEq

def pairLift : PlaneWreath := ⟨fun i=>if i=1 then ⟨(.ofAdd 1,.ofAdd 1),1⟩ else 1,1⟩
def swapLift : PlaneWreath := RegularWreathProduct.inl (.ofAdd 1)
def standardSwap : W := sylowEmbedding swapLift
def standardZ : W := t * standardSwap * t * standardSwap⁻¹

theorem embedding_pairLift : sylowEmbedding pairLift=t := by decide +kernel

theorem t_mem_sylowBase : t∈sylowBase := ⟨pairLift,rfl,embedding_pairLift⟩
theorem standardSwap_mem : standardSwap∈(standardSylow:Subgroup W) := ⟨swapLift,rfl⟩
theorem standardSwap_not_mem_base : standardSwap∉sylowBase := by
  rintro ⟨x,hx,hxe⟩
  have he := sylowEmbedding_injective hxe
  have hn : swapLift∉planeBase := by decide +kernel
  exact hn (he ▸ hx)

theorem standardSylow_centralizer_t :
    (standardSylow:Subgroup W) ⊓ centralizer = sylowBase := by
  have htest : ∀x:PlaneWreath, sylowEmbedding x * t=t*sylowEmbedding x ↔ x∈planeBase := by decide +kernel
  ext w
  constructor
  · rintro ⟨⟨x,rfl⟩,hc⟩
    exact ⟨x,(htest x).mp (mem_centralizer_singleton_iff.mp hc),rfl⟩
  · rintro ⟨x,hx,rfl⟩
    exact ⟨⟨x,rfl⟩,mem_centralizer_singleton_iff.mpr ((htest x).mpr hx)⟩

theorem standardZ_central : standardZ∈(center (standardSylow:Subgroup W)).map (standardSylow:Subgroup W).subtype := by
  have hz : standardZ∈(standardSylow:Subgroup W) := by
    have ht : t∈(standardSylow:Subgroup W) := ⟨pairLift,embedding_pairLift⟩
    exact mul_mem (mul_mem (mul_mem ht standardSwap_mem) ht) (inv_mem standardSwap_mem)
  refine ⟨⟨standardZ,hz⟩,mem_center_iff.mpr ?_,rfl⟩
  intro x
  apply Subtype.ext
  obtain ⟨y,hy⟩ := x.property
  change (x:W)*standardZ=standardZ*(x:W)
  rw [←hy]
  exact (by decide +kernel : ∀y:PlaneWreath,sylowEmbedding y*standardZ=standardZ*sylowEmbedding y) y

theorem standardZ_ne_one : standardZ≠1 := by decide +kernel
theorem t_order : orderOf t=2 := by
  exact (orderOf_eq_prime_iff).mpr ⟨by decide +kernel,by decide +kernel⟩
theorem t_ne_standardZ : t≠standardZ := by decide +kernel

theorem center_standardSylow_card : Nat.card (center (standardSylow:Subgroup W))=2 := by
  let e := (MonoidHom.ofInjective sylowEmbedding_injective).symm.trans wreathEquiv
  change Nat.card (center sylowEmbedding.range)=2
  rw [Nat.card_congr (centerCongr e).toEquiv,SymmetricFourWreath.center_P,SymmetricFourWreath.card_centralLine]

theorem standardZ_order : orderOf standardZ=2 :=
  (orderOf_eq_prime_iff).mpr ⟨by decide +kernel,standardZ_ne_one⟩

theorem center_standardSylow_eq_zpowers :
    (center (standardSylow:Subgroup W)).map (standardSylow:Subgroup W).subtype=zpowers standardZ := by
  symm
  apply eq_of_le_of_card_ge (zpowers_le.mpr standardZ_central)
  rw [card_map_of_injective Subtype.val_injective,center_standardSylow_card,
    Nat.card_zpowers,standardZ_order]


theorem t_mem_vectorGroup : t∈vectorGroup := ⟨pair01,rfl⟩

theorem t_mem_center_sylowBase : t∈(center sylowBase).map sylowBase.subtype := by
  refine ⟨⟨t,t_mem_sylowBase⟩,mem_center_iff.mpr ?_,rfl⟩
  intro x
  apply Subtype.ext
  have hx : (x:W)∈(standardSylow:Subgroup W) ⊓ centralizer := by
    rw [standardSylow_centralizer_t]; exact x.property
  exact mem_centralizer_singleton_iff.mp hx.2

theorem t_not_mem_sylowCenter :
    t∉(center (standardSylow:Subgroup W)).map (standardSylow:Subgroup W).subtype := by
  rw [center_standardSylow_eq_zpowers]
  intro ht
  rw [mem_zpowers_iff_mem_range_orderOf,standardZ_order] at ht
  obtain ⟨n,hn,he⟩ := Finset.mem_image.mp ht
  have hn' : n=0 ∨ n=1 := by have := Finset.mem_range.mp hn; omega
  rcases hn' with rfl|rfl
  · have ht1 : t≠1 := by decide +kernel
    exact ht1 he.symm
  · exact t_ne_standardZ (by simpa using he.symm)

theorem standardSwap_order : orderOf standardSwap=2 :=
  (orderOf_eq_prime_iff).mpr ⟨by decide +kernel,by decide +kernel⟩

theorem standardZ_value : standardZ=SemidirectProduct.inl
    (Multiplicative.ofAdd ⟨![1,1,1,1,0],by decide +kernel⟩ : V) := by decide +kernel


theorem standardZ_mem_center_base : standardZ∈(center sylowBase).map sylowBase.subtype := by
  have hzbase : standardZ∈sylowBase := by
    refine ⟨pairLift * swapLift * pairLift * swapLift⁻¹,?_,?_⟩
    · change (pairLift * swapLift * pairLift * swapLift⁻¹).right=1
      decide +kernel
    · simp only [map_mul,map_inv,embedding_pairLift]; rfl
  refine ⟨⟨standardZ,hzbase⟩,mem_center_iff.mpr ?_,rfl⟩
  intro x
  apply Subtype.ext
  have hx : (x:W)∈(standardSylow:Subgroup W) := by
    have hh : (x:W)∈(standardSylow:Subgroup W) ⊓ centralizer := by
      rw [standardSylow_centralizer_t]; exact x.property
    exact hh.1
  obtain ⟨z,hz,hze⟩ := standardZ_central
  have hh := congrArg Subtype.val ((mem_center_iff.mp hz) ⟨x,hx⟩)
  change (x:W)*(z:W)=(z:W)*(x:W) at hh
  change (x:W)*standardZ=standardZ*(x:W)
  change (z:W)=standardZ at hze
  rw [hze] at hh
  exact hh

theorem center_base_eq : (center sylowBase).map sylowBase.subtype =
    zpowers t ⊔ zpowers standardZ := by
  apply le_antisymm
  · rintro w ⟨x,hx,rfl⟩
    obtain ⟨y,hy,he⟩ := x.property
    have hc : ∀v:PlaneWreath,v∈planeBase→v*y=y*v := by
      intro v hv
      apply sylowEmbedding_injective
      have hh := congrArg Subtype.val ((mem_center_iff.mp hx)
        ⟨sylowEmbedding v,⟨v,hv,rfl⟩⟩)
      change sylowEmbedding v*(x:W)=(x:W)*sylowEmbedding v at hh
      simpa only [map_mul,he] using hh
    have htest : ∀y:PlaneWreath,y∈planeBase→
        (∀v:PlaneWreath,v∈planeBase→v*y=y*v)→
        sylowEmbedding y=1 ∨ sylowEmbedding y=t ∨ sylowEmbedding y=standardZ ∨
        sylowEmbedding y=t*standardZ := by decide +kernel
    change (x:W)∈_
    rcases htest y hy hc with h|h|h|h <;> rw [←he,h]
    · exact one_mem _
    · exact mem_sup_left (mem_zpowers t)
    · exact mem_sup_right (mem_zpowers standardZ)
    · exact mul_mem (mem_sup_left (mem_zpowers t)) (mem_sup_right (mem_zpowers standardZ))
  · exact sup_le (zpowers_le.mpr t_mem_center_sylowBase) (zpowers_le.mpr standardZ_mem_center_base)


private theorem center_base_members (w:W) : w∈(center sylowBase).map sylowBase.subtype ↔
    w=1 ∨ w=t ∨ w=standardZ ∨ w=t*standardZ := by
  constructor
  · rintro ⟨x,hx,rfl⟩
    obtain ⟨y,hy,he⟩ := x.property
    have hc : ∀v:PlaneWreath,v∈planeBase→v*y=y*v := by
      intro v hv
      apply sylowEmbedding_injective
      have hh := congrArg Subtype.val ((mem_center_iff.mp hx)
        ⟨sylowEmbedding v,⟨v,hv,rfl⟩⟩)
      change sylowEmbedding v*(x:W)=(x:W)*sylowEmbedding v at hh
      simpa only [map_mul,he] using hh
    have htest : ∀y:PlaneWreath,y∈planeBase→
        (∀v:PlaneWreath,v∈planeBase→v*y=y*v)→
        sylowEmbedding y=1 ∨ sylowEmbedding y=t ∨ sylowEmbedding y=standardZ ∨
        sylowEmbedding y=t*standardZ := by decide +kernel
    change (x:W)=1 ∨ (x:W)=t ∨ (x:W)=standardZ ∨ (x:W)=t*standardZ
    rw [←he]
    exact htest y hy hc
  · intro h
    rcases h with rfl|rfl|rfl|rfl
    · exact one_mem _
    · exact t_mem_center_sylowBase
    · exact standardZ_mem_center_base
    · exact mul_mem t_mem_center_sylowBase standardZ_mem_center_base

theorem center_base_card : Nat.card (center sylowBase)=4 := by
  classical
  let C := (center sylowBase).map sylowBase.subtype
  let vs : Fin 4→W := ![1,t,standardZ,t*standardZ]
  have hm (i:Fin 4) : vs i∈C := by
    rw [center_base_members]
    fin_cases i <;> simp [vs]
  let f : Fin 4→C := fun i=>⟨vs i,hm i⟩
  have hi : Function.Injective f := by
    have hv : Function.Injective vs := by decide +kernel
    intro i j h
    exact hv (congrArg Subtype.val h)
  have hs : Function.Surjective f := by
    intro w
    rcases (center_base_members w).mp w.property with h|h|h|h
    · exact ⟨0,Subtype.ext h.symm⟩
    · exact ⟨1,Subtype.ext h.symm⟩
    · exact ⟨2,Subtype.ext h.symm⟩
    · exact ⟨3,Subtype.ext h.symm⟩
  rw [←card_map_of_injective sylowBase.subtype_injective]
  exact (Nat.card_congr (Equiv.ofBijective f ⟨hi,hs⟩)).symm.trans (by simp)

theorem center_base_elementary : IsElementaryAbelian 2 (center sylowBase) := by
  refine {exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_}
  intro x
  apply Subtype.ext
  apply Subtype.ext
  have hm : ((x:sylowBase):W)∈(center sylowBase).map sylowBase.subtype :=
    mem_map_of_mem _ x.property
  have ht : ∀w:W,(w=1 ∨ w=t ∨ w=standardZ ∨ w=t*standardZ)→w^2=1 := by
    intro w h
    rcases h with rfl|rfl|rfl|rfl <;> decide +kernel
  exact ht _ ((center_base_members _).mp hm)

def pairSquareRoot : PlaneWreath := ⟨fun i=>if i=1 then rotation else 1,1⟩
theorem pairSquareRoot_square : sylowEmbedding pairSquareRoot^2=t := by decide +kernel

theorem square_mem_normal_extraspecial_of_equiv {R:Type*} [Group R] [Finite R]
    (eR:R≃*(standardSylow:Subgroup W)) (Q:Subgroup R)
    [Q.Normal] [IsExtraspecial 2 Q] (hQ:Nat.card Q=32) (x:R) : x^2∈Q := by
  let e : R ≃* SymmetricFourWreath.P := eR.trans
    ((MonoidHom.ofInjective sylowEmbedding_injective).symm.trans wreathEquiv)
  let ep : R ≃* SymmetricFourWreath.P×PUnit :=
    e.trans MulEquiv.prodUnique.symm
  let : IsElementaryAbelian 2 PUnit := {exponent_dvd_p := by simp}
  have hh := SymmetricFourWreath.core_sup_factor_eq_comap_of_equiv_prod ep Q hQ
  have hk : ((MonoidHom.fst SymmetricFourWreath.P PUnit).comp ep.toMonoidHom).ker=⊥ := by
    exact MonoidHom.ker_eq_bot _ e.injective
  rw [hk,sup_bot_eq] at hh
  rw [hh]
  change e (x^2)∈SymmetricFourWreath.coreInP
  rw [map_pow]
  exact SymmetricFourWreath.square_mem_coreInP (e x)

end BinaryFiveAffine
