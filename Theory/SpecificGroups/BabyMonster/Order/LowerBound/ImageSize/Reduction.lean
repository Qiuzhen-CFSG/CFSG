module

public import Theory.SpecificGroups.BabyMonster.Order.LowerBound.MatrixWords
public import Mathlib.GroupTheory.Coset.Card
public import Mathlib.Algebra.Group.End

/-!
# Divisibility certificates for the Baby Monster matrix image

The standard generators and the eleven presentation words define different
subgroups until a bridge is proved. The recovered words below are exactly
Breuer–Magaard–Wilson, *Verification of the ordinary character table of the
Baby Monster*, §3.4, https://arxiv.org/abs/1902.07758.

A simultaneous conjugacy certificate embeds the standard subgroup into the
eleven-generator image. Lagrange then transfers certified divisors. Four
coprime blocks, containing all the required prime powers, give the target
lower bound. All concrete matrix computations remain explicit premises of the
assembly theorem; this module does not assume identification with a named group.
-/

@[expose] public section

namespace BabyMonster.OrderLowerBound

/-- The subgroup generated by the two fixed ATLAS units. -/
def standardImage (ha : atlasA ^ 2 = 1) (hb : atlasB ^ 3 = 1) : Subgroup MatrixGroup :=
  Subgroup.closure ({standardA ha, standardB hb} : Set MatrixGroup)

variable {G : Type*} [Group G]

/-- The product `r = t₁ ⋯ t₈` of §3.4, in zero-based indexing. -/
def recoveredR (t : Generator → G) : G :=
  t 0 * t 1 * t 2 * t 3 * t 4 * t 5 * t 6 * t 7

/-- The product `s = t₅ t₉ t₁₀ t₁₁` of §3.4. -/
def recoveredS (t : Generator → G) : G :=
  t 4 * t 8 * t 9 * t 10

/-- The recovered candidate `a′ = (r⁷ s)¹⁵`. -/
def recoveredA (t : Generator → G) : G :=
  (recoveredR t ^ 7 * recoveredS t) ^ 15

/-- The recovered candidate `b′ = (t₁ t₂)^((s r)¹⁰)`, with right conjugation. -/
def recoveredB (t : Generator → G) : G :=
  wordConjugate (t 0 * t 1) ((recoveredS t * recoveredR t) ^ 10)

/-- Both recovered candidates belong to the subgroup generated by the eleven words. -/
theorem recovered_mem (t : Generator → G) :
    recoveredA t ∈ Subgroup.closure (Set.range t) ∧
    recoveredB t ∈ Subgroup.closure (Set.range t) := by
  have ht (i : Generator) : t i ∈ Subgroup.closure (Set.range t) :=
    Subgroup.subset_closure ⟨i, rfl⟩
  constructor <;> simp only [recoveredA, recoveredB, recoveredR, recoveredS, wordConjugate]
  all_goals repeat' first | apply Subgroup.pow_mem | apply Subgroup.mul_mem |
    apply Subgroup.inv_mem | exact ht _

private theorem conjugate_pair_card_dvd (a b u : G) (H : Subgroup G)
    (hA : wordConjugate a u ∈ H) (hB : wordConjugate b u ∈ H) :
    Nat.card (Subgroup.closure ({a, b} : Set G)) ∣ Nat.card H := by
  let e : G ≃* G := (MulAut.conj u).symm
  have hle : Subgroup.closure ({a, b} : Set G) ≤ H.comap e.toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact hA
    · have hx' : x = b := Set.mem_singleton_iff.mp hx
      subst x
      exact hB
  let f : Subgroup.closure ({a, b} : Set G) →* H :=
    { toFun := fun x => ⟨e x, hle x.property⟩
      map_one' := by apply Subtype.ext; exact e.map_one
      map_mul' := fun x y => by apply Subtype.ext; exact e.map_mul x y }
  apply Subgroup.card_dvd_of_injective f
  intro x y h
  apply Subtype.ext
  exact e.injective (congrArg Subtype.val h)

/-- A checked common conjugator transfers the entire standard subgroup order. -/
theorem standardImage_card_dvd_matrixImage_of_conjugacy
    (ha : atlasA ^ 2 = 1) (hb : atlasB ^ 3 = 1)
    (u : MatrixGroup)
    (hA : wordConjugate (standardA ha) u = recoveredA (matrixGenerators ha hb))
    (hB : wordConjugate (standardB hb) u = recoveredB (matrixGenerators ha hb)) :
    Nat.card (standardImage ha hb) ∣ Nat.card (matrixImage ha hb) := by
  apply conjugate_pair_card_dvd (standardA ha) (standardB hb) u (matrixImage ha hb)
  · rw [hA]
    exact (recovered_mem _).1
  · rw [hB]
    exact (recovered_mem _).2

/-- The remaining prime powers, all coprime to 30. -/
def remainingOrderFactor : ℕ := 7 ^ 2 * 11 * 13 * 17 * 19 * 23 * 31 * 47

/-- Assemble all prime-power divisors without any group recognition. -/
theorem expectedOrder_dvd_of_factors {n : ℕ}
    (h2 : 2 ^ 41 ∣ n) (h3 : 3 ^ 13 ∣ n) (h5 : 5 ^ 6 ∣ n)
    (hrest : remainingOrderFactor ∣ n) : expectedOrder ∣ n := by
  have h23 : 2 ^ 41 * 3 ^ 13 ∣ n :=
    (show Nat.Coprime (2 ^ 41) (3 ^ 13) by decide).mul_dvd_of_dvd_of_dvd h2 h3
  have h235 : 2 ^ 41 * 3 ^ 13 * 5 ^ 6 ∣ n :=
    (show Nat.Coprime (2 ^ 41 * 3 ^ 13) (5 ^ 6) by decide).mul_dvd_of_dvd_of_dvd h23 h5
  have hfull := (show Nat.Coprime (2 ^ 41 * 3 ^ 13 * 5 ^ 6) remainingOrderFactor by
    decide).mul_dvd_of_dvd_of_dvd h235 hrest
  simpa only [expectedOrder, remainingOrderFactor, mul_assoc] using hfull

/-- Conditional assembly of the cardinality certificate. The simultaneous
conjugacy and each of the four divisibility premises must be proved for the
fixed matrices before this yields the requested unconditional lower bound. -/
theorem matrixImage_card_ge_of_standard_certificates
    (ha : atlasA ^ 2 = 1) (hb : atlasB ^ 3 = 1)
    (hconj : ∃ u : MatrixGroup,
      wordConjugate (standardA ha) u = recoveredA (matrixGenerators ha hb) ∧
      wordConjugate (standardB hb) u = recoveredB (matrixGenerators ha hb))
    (h2 : 2 ^ 41 ∣ Nat.card (standardImage ha hb))
    (h3 : 3 ^ 13 ∣ Nat.card (standardImage ha hb))
    (h5 : 5 ^ 6 ∣ Nat.card (standardImage ha hb))
    (hrest : remainingOrderFactor ∣ Nat.card (standardImage ha hb)) :
    expectedOrder ≤ Nat.card (matrixImage ha hb) := by
  obtain ⟨u, huA, huB⟩ := hconj
  exact Nat.le_of_dvd Nat.card_pos ((expectedOrder_dvd_of_factors h2 h3 h5 hrest).trans
    (standardImage_card_dvd_matrixImage_of_conjugacy ha hb u huA huB))

end BabyMonster.OrderLowerBound
