module

public import Theory.SpecificGroups.BabyMonster.Order.LowerBound.ImageSize.Reduction
public import Theory.SpecificGroups.BabyMonster.Order.LowerBound.ImageSize.FivePart.MatrixOrbit

/-!
# The five-part of the fixed standard matrix image

The local ATLAS program has been transcribed, and its subgroup containment is
proved in `FivePart.Words`. A complete finite orbit for words in the standard
image supplies divisibility by its size. In particular, any certified orbit
whose size is divisible by `5^6` proves the required five-part, with no need to
identify the local subgroup or construct a named sporadic group.

This module currently supplies conditional assembly only. Concrete distinct
vectors, transition identities, and reachability must still be supplied; no
unconditional five-part assertion is made.

Source for the candidate local subgroup: ATLAS `BG1-max21W1`, preserved in
`ImageSize/source/` with attribution and source hash.
-/

@[expose] public section
namespace BabyMonster.OrderLowerBound

/-- An orbit inside any subgroup generated by words in the fixed standard
matrices transfers its five-part to the standard image. -/
theorem standardImage_fivePart_dvd_of_matrixOrbit
    (ha : atlasA ^ 2 = 1) (hb : atlasB ^ 3 = 1)
    {J : Type*} (g : J → MatrixGroup) (hg : ∀ j, g j ∈ standardImage ha hb)
    (d : FivePart.MatrixOrbitData J) (hc : FivePart.MatrixOrbitCertificate g d)
    (hsize : 5 ^ 6 ∣ d.size) : 5 ^ 6 ∣ Nat.card (standardImage ha hb) := by
  have hle : Subgroup.closure (Set.range g) ≤ standardImage ha hb := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨j, rfl⟩
    exact hg j
  exact hsize.trans (hc.card_dvd.trans (Subgroup.card_dvd_of_le hle))

/-- The same assembly for any certified divisor of the ATLAS local image. -/
theorem standardImage_fivePart_dvd_of_localImage
    (ha : atlasA ^ 2 = 1) (hb : atlasB ^ 3 = 1)
    (hlocal : 5 ^ 6 ∣ Nat.card (FivePart.image ha hb)) :
    5 ^ 6 ∣ Nat.card (standardImage ha hb) :=
  hlocal.trans (FivePart.image_card_dvd_standardImage ha hb)

end BabyMonster.OrderLowerBound
