module

public import Theory.SpecificGroups.BabyMonster.Order.LowerBound.ImageSize.RemainingFactors.SevenSquare.Witness.Packed

/-!
# The concrete fourteen vectors of the seven-square witness

The two seven-cycles were generated by averaging the first coordinate vector
over one candidate seven-element and acting by the other. Here the resulting
packed vectors are constants. The coordinate checks prove that their 49 sums
are distinct, independently of the still-separate row-transition checks.

Bit zero is column zero, as in the unchanged ATLAS matrices documented in
`LowerBound/source/README.md`. The producing search is not a proof premise.
-/

@[expose] public section
namespace BabyMonster.OrderLowerBound.RemainingFactors.SevenSquare
namespace Concrete
open LargePrimes

def u (i : ZMod 7) : ℕ :=
  match i.val with
  | 0 => 
  | 1 => 
  | 2 => 
  | 3 => 
  | 4 => 
  | 5 => 
  | _ => 

def w (i : ZMod 7) : ℕ :=
  match i.val with
  | 0 => 
  | 1 => 
  | 2 => 
  | 3 => 
  | 4 => 
  | 5 => 
  | _ => 

def coordinate (k : Fin 7) : Fin 4370 :=
  match k.val with
  | 0 => ⟨0, by decide⟩
  | 1 => ⟨1, by decide⟩
  | 2 => ⟨2, by decide⟩
  | 3 => ⟨3, by decide⟩
  | 4 => ⟨32, by decide⟩
  | 5 => ⟨58, by decide⟩
  | _ => ⟨7, by decide⟩

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
/-- A small fixed collection of coordinates separates all 49 sums. -/
theorem separates : ∀ p q : ZMod 7 × ZMod 7, p ≠ q →
    ∃ k : Fin 4370, bit (u p.1 ^^^ w p.2) k.val ≠ bit (u q.1 ^^^ w q.2) k.val := by
  have h : ∀ p q : ZMod 7 × ZMod 7, p ≠ q →
      ∃ k : Fin 7, bit (u p.1 ^^^ w p.2) (coordinate k).val ≠
        bit (u q.1 ^^^ w q.2) (coordinate k).val := by decide
  intro p q hpq
  obtain ⟨k, hk⟩ := h p q hpq
  exact ⟨coordinate k, hk⟩

end Concrete
end BabyMonster.OrderLowerBound.RemainingFactors.SevenSquare
