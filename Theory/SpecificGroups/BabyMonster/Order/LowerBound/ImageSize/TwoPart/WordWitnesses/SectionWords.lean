/-- Membership-certified lifts; this is a 16-term starting family, not the
required final 41-term family. -/
def sectionGenerator (ha : atlasA ^ 2 = 1) (hb : atlasB ^ 3 = 1)
    (i : Fin 16) : standardImage ha hb := (sectionWords.get i).element ha hb

def sectionRows (i : Fin 16) : Vector Nat 4370 := (sectionWords.get i).rows false

/-- Exact full-matrix entries of each of the sixteen lifted words. -/
theorem sectionGenerator_entry (ha : atlasA ^ 2 = 1) (hb : atlasB ^ 3 = 1)
    (i : Fin 16) (r c : Fin 4370) : matrix ha hb (sectionGenerator ha hb i) r c =
      if ((sectionRows i).get r).testBit c.val then 1 else 0 :=
  (sectionWords.get i).matrix_entry ha hb r c

end BabyMonster.OrderLowerBound.TwoPart.WordWitnesses
