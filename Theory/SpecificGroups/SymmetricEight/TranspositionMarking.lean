module

public import Theory.SpecificGroups.SymmetricEight.A6ShadowTwoLocals.TreeSylow
public import Mathlib.GroupTheory.Perm.Centralizer
public import Mathlib.GroupTheory.SpecificGroups.Alternating

/-!
# Compatible markings of a transposition centralizer in S₈

The centralizer of (01) has a Sylow two-subgroup generated by (01), (23),
and the binary-tree D₈ on the remaining four letters. Its 32 normal forms
are extracted from the tree Sylow subgroup of S₈. The double transposition
(01)(23) belongs to, and centralizes, this subgroup. Sylow conjugacy inside
the transposition centralizer provides a compatible marking of any Sylow.
Such conjugations preserve the alternating group on the other six letters.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, the marking
preceding Lemma 16.3.12, printed p.1181 / PDF p.1198.
-/

@[expose] public section
open Subgroup
open Theory.SpecificGroups.SymmetricEight.A6ShadowTwoLocals
namespace Theory.SpecificGroups.SymmetricEight.TranspositionMarking

abbrev transposition : S8 := Equiv.swap 0 1
abbrev doubleTransposition : S8 := Equiv.swap 0 1 * Equiv.swap 2 3
abbrev swapCentralizer : Subgroup S8 := centralizer {transposition}

private def wordIndex (i : Fin 32) : Fin 128 := ⟨i.val % 16 + 32 * (i.val / 16), by omega⟩

private theorem word_centralizes : ∀ i,
    treeWord (wordIndex i) * transposition = transposition * treeWord (wordIndex i) := by
  decide +kernel

private theorem index_injective : Function.Injective wordIndex := by
  intro i j h
  have hh := congrArg Fin.val h
  dsimp [wordIndex] at hh
  have hi := i.isLt
  have hj := j.isLt
  apply Fin.ext
  omega
private theorem covers : ∀ j,
    treeWord j * transposition = transposition * treeWord j → ∃ i, wordIndex i = j := by
  decide +kernel

/-- The intersection of the binary-tree Sylow with the transposition centralizer. -/
def standard : Subgroup swapCentralizer := treeGroup.subgroupOf swapCentralizer

private noncomputable def wordEquiv : Fin 32 ≃ standard := Equiv.ofBijective
  (fun i => ⟨⟨treeWord (wordIndex i), mem_centralizer_singleton_iff.mpr (word_centralizes i)⟩,
    treeWord_mem _⟩) (by
      constructor
      · intro i j h
        exact index_injective (treeWord_injective (congrArg (fun x : standard => (x : S8)) h))
      · rintro ⟨⟨x, hx⟩, ht⟩
        obtain ⟨j, rfl⟩ := (mem_treeGroup x).mp ht
        obtain ⟨i, rfl⟩ := covers j (mem_centralizer_singleton_iff.mp hx)
        exact ⟨i, rfl⟩)

theorem card_standard : Nat.card standard = 32 := by
  rw [← Nat.card_congr wordEquiv]
  simp

theorem card_swapCentralizer : Nat.card swapCentralizer = 1440 := by
  rw [Equiv.Perm.nat_card_centralizer]
  have ht : transposition.cycleType = {2} := by decide +kernel
  rw [ht]
  norm_num [Nat.factorial]

/-- The standard Sylow in C₂ × S₆, identified inside S₈. -/
noncomputable def standardSylow : Sylow 2 swapCentralizer := Sylow.ofCard standard (by
  rw [card_standard, card_swapCentralizer, show 1440 = 2 ^ 5 * 45 from rfl,
    Nat.factorization_mul (by decide) (by decide), Nat.factorization_pow]
  norm_num [Nat.prime_two.factorization, Nat.factorization_eq_zero_of_not_dvd (by decide : ¬ 2 ∣ 45)])

theorem delta_mem :
    doubleTransposition ∈ (standardSylow : Subgroup swapCentralizer).map swapCentralizer.subtype := by
  refine ⟨⟨doubleTransposition, by apply mem_centralizer_singleton_iff.mpr; decide +kernel⟩, ?_, rfl⟩
  exact treeGroup.mul_mem (treeGenerator_mem 0) (treeGenerator_mem 1)

/-- The double transposition centralizes the whole standard Sylow. -/
theorem delta_centralizes : doubleTransposition ∈
    centralizer (((standardSylow : Subgroup swapCentralizer).map swapCentralizer.subtype) : Set S8) := by
  rintro x ⟨⟨x, hx⟩, ht, rfl⟩
  obtain ⟨j, rfl⟩ := (mem_treeGroup x).mp ht
  obtain ⟨i, rfl⟩ := covers j (mem_centralizer_singleton_iff.mp hx)
  exact (by decide +kernel : ∀ i, treeWord (wordIndex i) * doubleTransposition =
    doubleTransposition * treeWord (wordIndex i)) i

/-- The alternating group on the six letters outside the marked pair. -/
def sixPointAlternating : Subgroup S8 := alternatingGroup (Fin 8) ⊓
  (MulAction.stabilizer S8 (0 : Fin 8) ⊓ MulAction.stabilizer S8 (1 : Fin 8))

private theorem preserves_pair {a : S8} (ha : a ∈ swapCentralizer) (k : Fin 8)
    (hk : k = 0 ∨ k = 1) : a k = 0 ∨ a k = 1 := by
  apply Equiv.eq_or_eq_of_swap_apply_ne_self
  have hc := congrArg (fun p : S8 => p k) (mem_centralizer_singleton_iff.mp ha)
  change a (transposition k) = transposition (a k) at hc
  rw [← hc]
  apply a.injective.ne
  rcases hk with rfl | rfl <;> decide

private theorem conj_mem_six {a x : S8} (ha : a ∈ swapCentralizer) (hx : x ∈ sixPointAlternating) :
    (MulAut.conj a) x ∈ sixPointAlternating := by
  refine ⟨(inferInstance : (alternatingGroup (Fin 8)).Normal).conj_mem x hx.1 a, ?_, ?_⟩
  · change a (x (a⁻¹ 0)) = 0
    have hxfix : x (a⁻¹ 0) = a⁻¹ 0 := by
      rcases preserves_pair (swapCentralizer.inv_mem ha) 0 (Or.inl rfl) with h | h
      · rw [h]; exact hx.2.1
      · rw [h]; exact hx.2.2
    rw [hxfix]
    exact a.apply_symm_apply 0
  · change a (x (a⁻¹ 1)) = 1
    have hxfix : x (a⁻¹ 1) = a⁻¹ 1 := by
      rcases preserves_pair (swapCentralizer.inv_mem ha) 1 (Or.inr rfl) with h | h
      · rw [h]; exact hx.2.1
      · rw [h]; exact hx.2.2
    rw [hxfix]
    exact a.apply_symm_apply 1

/-- Conjugation in the transposition centralizer preserves the marked A₆. -/
theorem conj_six {a : S8} (ha : a ∈ swapCentralizer) :
    sixPointAlternating.map (MulAut.conj a).toMonoidHom = sixPointAlternating := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    exact conj_mem_six ha hx
  · intro x hx
    refine ⟨(MulAut.conj a⁻¹) x, conj_mem_six (swapCentralizer.inv_mem ha) hx, ?_⟩
    simp [MulAut.conj_apply, mul_assoc]

/-- Conjugate any supplied Sylow to the standard one without changing (01). -/
theorem exists_conjugating_marking (S : Sylow 2 swapCentralizer) :
    ∃ a : S8, a ∈ swapCentralizer ∧
      ((S : Subgroup swapCentralizer).map swapCentralizer.subtype).map (MulAut.conj a).toMonoidHom =
        (standardSylow : Subgroup swapCentralizer).map swapCentralizer.subtype := by
  obtain ⟨a, ha⟩ := MulAction.exists_smul_eq swapCentralizer S standardSylow
  refine ⟨a, a.property, ?_⟩
  have h := congrArg (fun P : Sylow 2 swapCentralizer =>
    (P : Subgroup swapCentralizer).map swapCentralizer.subtype) ha
  change ((S : Subgroup swapCentralizer).map (MulAut.conj a).toMonoidHom).map
    swapCentralizer.subtype = _ at h
  rw [map_map] at h ⊢
  exact h

end Theory.SpecificGroups.SymmetricEight.TranspositionMarking
