private def extensionWord (g : P8) : List (Fin 5) :=
  ((escapeRows[fixRank g / 24]?).getD [])[fixRank g % 24]?.getD []

private def extensionValue (g : P8) : P8 :=
  eval ![r,s,cubic 2,cubic 1,g] (extensionWord g)

private def ExtensionTest (g : P8) : Prop :=
  modelWord (modelIndex g) = g ∨
    TreeTest (extensionValue g) ∧ extensionValue g ∉ twoGroup

private instance (g : P8) : Decidable (ExtensionTest g) :=
  inferInstanceAs (Decidable (_ ∨ _ ∧ _))

private def ExtensionCertificate : Prop :=
  ∀ g ∈ permsOfList ([2,3,4,5,6,7] : List (Fin 8)), ExtensionTest g

private instance : Decidable ExtensionCertificate := List.decidableBAll _ _

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
private theorem extension_certificate : ExtensionCertificate := by
  decide +kernel

/-- The concrete compatible pair generates every ambient overgroup in which
the displayed regular D₈ is Sylow. -/
theorem overgroup_eq_model {X : Subgroup P8} (hX : MaximalTwo X)
    (hM : modelGroup ≤ X) : X = modelGroup := by
  apply le_antisymm ?_ hM
  intro g hg
  let t := modelWord (transportCode (g 0) (g 1))
  have ht : t ∈ modelGroup := modelWord_mem _
  have hp := transport_points (g 0) (g 1) (g.injective.ne (by decide))
  have hfix0 : (t * g) 0 = 0 := hp.1
  have hfix1 : (t * g) 1 = 1 := hp.2
  have hlist : t * g ∈ permsOfList ([2,3,4,5,6,7] : List (Fin 8)) := by
    apply mem_permsOfList_of_mem
    intro x hx
    fin_cases x <;> simp_all
  rcases extension_certificate (t * g) hlist with hm | he
  · have htg : t * g ∈ modelGroup := hm ▸ modelWord_mem _
    exact (modelGroup.mul_mem_cancel_left ht).mp htg
  · have htg := X.mul_mem (hM ht) hg
    have hev : extensionValue (t * g) ∈ X := by
      change eval ![r,s,cubic 2,cubic 1,t * g] (extensionWord (t * g)) ∈ X
      apply eval_mem X
      intro i
      fin_cases i
      · exact hM (model_generator_mem 0)
      · exact hM (model_generator_mem 1)
      · exact hM (model_generator_mem 2)
      · exact hM (model_generator_mem 3)
      · exact htg
    exact False.elim (he.2 (mem_twoGroup_of_obstruction hX hev (treeTest_mem he.1)))

end Theory.SpecificGroups.SymmetricEight.RegularDihedralPair
