private def extensionRows : List (List (List (Fin 4 × List (Fin 4)))) :=
  [extensionRows0,extensionRows1,extensionRows2,extensionRows3,extensionRows4,extensionRows5,extensionRows6]

private def extensionRank (g : P8) : ℕ :=
  let digit (i : Fin 8) := ((List.finRange 8).filter (fun j => i < j ∧ g j < g i)).length
  720 * digit 1 + 120 * digit 2 + 24 * digit 3 + 6 * digit 4 +
    2 * digit 5 + digit 6

private def extensionRow (g : P8) : Fin 4 × List (Fin 4) :=
  let n := extensionRank g
  (((extensionRows[n / 720]?).getD [])[n / 24 % 30]?.getD [])[n % 24]?.getD (0,[])

private def extensionEval (g : P8) : P8 := eval ![r,s,cubic 0,g] (extensionRow g).2

private def ExtensionResult (g : P8) : Prop :=
  g = 1 ∨ g = cubic 0 ∨ g = cubic 0 ^ 2 ∨
    ((extensionRow g).1 ≠ 0 ∧ extensionEval g = cubic (extensionRow g).1) ∨
    (TreeTest (extensionEval g) ∧ extensionEval g ∉ twoGroup)

private instance (g : P8) : Decidable (ExtensionResult g) :=
  inferInstanceAs (Decidable (_ ∨ _ ∨ _ ∨ (_ ∧ _) ∨ (_ ∧ _)))

private def ExtensionBlock (i : Fin 7) : Prop :=
  ∀ g ∈ permsOfList ([2,3,4,5,6,7] : List (Fin 8)),
    ExtensionResult (swap 1 i.succ * g)

private instance (i : Fin 7) : Decidable (ExtensionBlock i) := List.decidableBAll _ _

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
private theorem extension_blocks (i : Fin 7) : ExtensionBlock i := by
  fin_cases i <;> decide +kernel

private theorem fixed_zero_extension (g : P8) (hg : g 0 = 0) : ExtensionResult g := by
  let i := g 1
  have hi : i ≠ 0 := fun he => (by decide : (1 : Fin 8) ≠ 0) (g.injective (he.trans hg.symm))
  obtain ⟨j, hj⟩ := Fin.eq_succ_of_ne_zero hi
  let b := swap 1 j.succ * g
  have hb : b ∈ permsOfList ([2,3,4,5,6,7] : List (Fin 8)) := by
    apply mem_permsOfList_of_mem
    have hb0 : b 0 = 0 := by
      change swap 1 j.succ (g 0) = 0
      rw [hg]
      exact swap_apply_of_ne_of_ne (by decide) (Ne.symm (Fin.succ_ne_zero j))
    have hb1 : b 1 = 1 := by
      change swap 1 j.succ (g 1) = 1
      rw [show g 1 = j.succ from hj]
      exact swap_apply_right _ _
    intro x hx
    fin_cases x <;> simp_all
  have he : swap 1 j.succ * b = g := by simp [b]
  exact he ▸ extension_blocks j b hb

/-- Exhaustive fixed-zero permutation sieve. The returned words use only
r, s, the first local cubic, and the given permutation. -/
theorem fixed_zero_extension_certificate (g : P8) (hg : g 0 = 0) :
    g = 1 ∨ g = cubic 0 ∨ g = cubic 0 ^ 2 ∨
      (∃ j : Fin 4, j ≠ 0 ∧ ∃ w : List (Fin 4), eval ![r,s,cubic 0,g] w = cubic j) ∨
      (∃ w : List (Fin 4), TreeTest (eval ![r,s,cubic 0,g] w) ∧
        eval ![r,s,cubic 0,g] w ∉ twoGroup) := by
  rcases fixed_zero_extension g hg with h | h | h | ⟨hj, he⟩ | ⟨ht, hn⟩
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨(extensionRow g).1, hj, (extensionRow g).2, he⟩)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr ⟨(extensionRow g).2, ht, hn⟩)))

