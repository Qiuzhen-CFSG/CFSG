module

public import Theory.SpecificGroups.SymmetricEight.RegularDihedralPair.InvariantSubspaces
import all Theory.SpecificGroups.SymmetricEight.RegularDihedralPair.PairRecognition
import all Theory.SpecificGroups.SymmetricEight.RegularDihedralPair.InvariantSubspaces

/-!
# The local fixed line lies in a proper invariant plane

The checked pair transporters preserve the literal regular Sylow. Thus the
image of the original local remains one of the four checked locals. Its
fixed line lies in one of the two native singular three-spaces, which is
invariant under the whole order-168 image. Its orbit cannot span six-space.
The local `import all` reuses the frozen private transport and plane
certificates without changing their public boundaries.
-/

public noncomputable section
open Equiv Subgroup
namespace Theory.SpecificGroups.SymmetricEight.RegularDihedralPair
open SquareModule ClassicalOrthogonal BinaryD3Comparison

private theorem marked_pair_two_conjugate {X : Subgroup P8} (hX : MaximalTwo X)
    (A B : Subgroup P8) (hAX : A ≤ X) (hBX : B ≤ X)
    (hTA : twoGroup ≤ A) (hTB : twoGroup ≤ B)
    (eA : A ≃* Perm (Fin 4)) (eB : B ≃* Perm (Fin 4)) (hne : A ≠ B) :
    ∃ p : P8, X.map (MulAut.conj p).toMonoidHom = modelGroup ∧
      twoGroup.map (MulAut.conj p).toMonoidHom = twoGroup := by
  obtain ⟨i, rfl⟩ := symmetricFour_classification hX A hAX hTA eA
  obtain ⟨j, rfl⟩ := symmetricFour_classification hX B hBX hTB eB
  have hij : i ≠ j := fun h => hne (congrArg localGroup h)
  have hgen (k : Fin 4) : pairGenerators i j k ∈ X := by
    fin_cases k
    · exact hX.1 r_mem
    · exact hX.1 s_mem
    · exact hAX (cubic_mem_localGroup i)
    · exact hBX (cubic_mem_localGroup j)
  have hc : Compatible i j = true := by
    cases hh : Compatible i j with
    | true => rfl
    | false =>
      have he := pair_escape i j hij hh
      have hm := eval_mem X (pairGenerators i j) hgen (pairEscape i j)
      exact False.elim (he.2 (mem_twoGroup_of_obstruction hX hm (treeTest_mem he.1)))
  let f := MulAut.conj (pairMarking i j)
  have hmodel : modelGroup ≤ X.map f.toMonoidHom := by
    apply (closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    exact ⟨_, eval_mem _ _ hgen (pairBack i j k), pair_back i j k hc⟩
  exact ⟨pairMarking i j,
    overgroup_eq_model (maximalTwo_map hX f (pair_map_twoGroup i j)) hmodel,
    pair_map_twoGroup i j⟩

private def localFixedVector (j : Fin 4) : D :=
  if j.val % 2 = 0 then Sum.elim ![0,0,1] ![0,1,0]
  else Sum.elim ![0,0,0] ![1,1,0]

private theorem local_fixed_line (j : Fin 4) (v : D)
    (hr : nativeAction r v = v) (hs : nativeAction s v = v)
    (hc : nativeAction (cubic j) v = v) :
    v = 0 ∨ v = localFixedVector j := by
  revert v
  fin_cases j <;> decide +kernel

private def localPlane (j : Fin 4) : Submodule F D :=
  if j.val % 2 = 0 then graphPlane else rightPlane

private theorem fixedVector_mem_plane (j : Fin 4) : localFixedVector j ∈ localPlane j := by
  fin_cases j
  all_goals
    refine ⟨![1,1,0], ?_⟩
    decide +kernel

private theorem plane_invariant (j : Fin 4) (g : P8) (hg : g ∈ modelGroup)
    (v : D) (hv : v ∈ localPlane j) : nativeAction g v ∈ localPlane j := by
  obtain ⟨i, rfl⟩ := (mem_modelGroup g).mp hg
  dsimp only [localPlane] at hv ⊢
  split_ifs at hv ⊢ with hj
  · obtain ⟨x, rfl⟩ := hv
    obtain ⟨y, hy⟩ := graph_stable i x
    exact ⟨y, hy.symm⟩
  · obtain ⟨x, rfl⟩ := hv
    obtain ⟨y, hy⟩ := right_stable i x
    exact ⟨y, hy.symm⟩

private theorem plane_proper (j : Fin 4) : localPlane j ≠ ⊤ := by
  intro he
  by_cases hj : j.val % 2 = 0
  · have he' : graphPlane = ⊤ := (show localPlane j = graphPlane from if_pos hj).symm.trans he
    have hr := graphPlane_finrank
    rw [he', finrank_top] at hr
    norm_num [D, VectorD, Index, Module.finrank_fintype_fun_eq_card] at hr
  · have he' : rightPlane = ⊤ := (show localPlane j = rightPlane from if_neg hj).symm.trans he
    have hr := rightPlane_finrank
    rw [he', finrank_top] at hr
    norm_num [D, VectorD, Index, Module.finrank_fintype_fun_eq_card] at hr

private theorem action_conjugate (p g : P8) (v : D) :
    (symmetricEquiv ((MulAut.conj p) g)).val ((symmetricEquiv p).val v) =
      (symmetricEquiv p).val ((symmetricEquiv g).val v) := by
  simp [MulAut.conj_apply, map_mul, map_inv]

/-- A vector fixed by one actual local S4 cannot have a spanning orbit under
the actual group generated by the compatible pair. -/
theorem marked_pair_local_fixed_span_ne_top {X : Subgroup P8} (hX : MaximalTwo X)
    (A B : Subgroup P8) (hAX : A ≤ X) (hBX : B ≤ X)
    (hTA : twoGroup ≤ A) (hTB : twoGroup ≤ B)
    (eA : A ≃* Perm (Fin 4)) (eB : B ≃* Perm (Fin 4)) (hne : A ≠ B)
    (x : D) (hfix : ∀ g ∈ A, (symmetricEquiv g).val x = x) :
    Submodule.span F (Set.range (fun g : X => (symmetricEquiv g.val).val x)) ≠ ⊤ := by
  obtain ⟨p, hp, hpT⟩ := marked_pair_two_conjugate hX A B hAX hBX hTA hTB eA eB hne
  let f := MulAut.conj p
  let e := (symmetricEquiv p).val
  let A' := A.map f.toMonoidHom
  have hX' : MaximalTwo (X.map f.toMonoidHom) := maximalTwo_map hX f hpT
  have hA' : A' ≤ X.map f.toMonoidHom := map_mono hAX
  have hTA' : twoGroup ≤ A' := hpT ▸ map_mono hTA
  let eA' : A' ≃* Perm (Fin 4) :=
    (A.equivMapOfInjective f.toMonoidHom f.injective).symm.trans eA
  obtain ⟨j, hj⟩ := symmetricFour_classification hX' A' hA' hTA' eA'
  have hfix' (g : P8) (hg : g ∈ localGroup j) : nativeAction g (e x) = e x := by
    rw [← hj] at hg
    obtain ⟨a, ha, rfl⟩ := hg
    rw [nativeAction_eq]
    exact (action_conjugate p a x).trans (congrArg e (hfix a ha))
  have hx : e x ∈ localPlane j := by
    rcases local_fixed_line j (e x)
      (hfix' r (twoGroup_le_localGroup j r_mem))
      (hfix' s (twoGroup_le_localGroup j s_mem))
      (hfix' (cubic j) (cubic_mem_localGroup j)) with he | he
    · rw [he]; exact (localPlane j).zero_mem
    · rw [he]; exact fixedVector_mem_plane j
  have hspan : Submodule.span F (Set.range (fun g : X => (symmetricEquiv g.val).val x)) ≤
      (localPlane j).comap e.toLinearMap := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g, rfl⟩
    change e ((symmetricEquiv g.val).val x) ∈ localPlane j
    have hg : f g.val ∈ modelGroup := hp ▸ mem_map_of_mem f.toMonoidHom g.property
    have hh := plane_invariant j (f g.val) hg (e x) hx
    rw [nativeAction_eq] at hh
    exact action_conjugate p g.val x ▸ hh
  intro ht
  have hall : (localPlane j).comap e.toLinearMap = ⊤ := top_unique (ht ▸ hspan)
  apply plane_proper j
  apply top_unique
  intro v _
  have hv : e.symm v ∈ (localPlane j).comap e.toLinearMap := hall ▸ Submodule.mem_top
  change e (e.symm v) ∈ localPlane j at hv
  simpa only [e.apply_symm_apply] using hv

end Theory.SpecificGroups.SymmetricEight.RegularDihedralPair
