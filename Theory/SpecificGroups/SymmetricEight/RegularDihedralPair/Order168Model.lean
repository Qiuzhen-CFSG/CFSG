private theorem model_next (i : Fin 168) (j : Fin 4) :
    modelWord i * modelGenerators j = modelWord (modelNext i j) := by
  decide +revert +kernel

set_option maxRecDepth 10000 in
private theorem model_prev (i : Fin 168) (j : Fin 4) :
    modelWord i * (modelGenerators j)⁻¹ = modelWord (modelPrev i j) := by
  decide +revert +kernel

set_option maxRecDepth 10000 in
private theorem model_index (i : Fin 168) : modelIndex (modelWord i) = i := by
  decide +revert +kernel

theorem model_generator_mem (j : Fin 4) : modelGenerators j ∈ modelGroup :=
  subset_closure ⟨j, rfl⟩

theorem modelWord_mem (i : Fin 168) : modelWord i ∈ modelGroup :=
  eval_mem modelGroup modelGenerators model_generator_mem _

theorem mem_modelGroup (g : P8) : g ∈ modelGroup ↔ ∃ i : Fin 168, modelWord i = g := by
  constructor
  · intro hg
    induction hg using Subgroup.closure_induction_right with
    | one => exact ⟨0, rfl⟩
    | mul_right x hx y hy ih =>
      obtain ⟨i, rfl⟩ := ih
      obtain ⟨j, rfl⟩ := hy
      exact ⟨modelNext i j, (model_next i j).symm⟩
    | mul_inv_cancel x hx y hy ih =>
      obtain ⟨i, rfl⟩ := ih
      obtain ⟨j, rfl⟩ := hy
      exact ⟨modelPrev i j, (model_prev i j).symm⟩
  · rintro ⟨i, rfl⟩
    exact modelWord_mem i

theorem model_card : Nat.card modelGroup = 168 := by
  have hi : Function.Injective modelWord := by
    intro i j h
    simpa only [model_index] using congrArg modelIndex h
  have e : modelGroup ≃ Set.range modelWord :=
    Equiv.setCongr (by ext g; exact mem_modelGroup g)
  rw [Nat.card_congr e, ← Nat.card_congr (Equiv.ofInjective modelWord hi)]
  simp

theorem model_eq_join : modelGroup = localGroup 2 ⊔ localGroup 1 := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact (le_sup_left : localGroup 2 ≤ localGroup 2 ⊔ localGroup 1)
        (twoGroup_le_localGroup 2 r_mem)
    · exact (le_sup_left : localGroup 2 ≤ localGroup 2 ⊔ localGroup 1)
        (twoGroup_le_localGroup 2 s_mem)
    · exact (le_sup_left : localGroup 2 ≤ localGroup 2 ⊔ localGroup 1)
        (cubic_mem_localGroup 2)
    · exact (le_sup_right : localGroup 1 ≤ localGroup 2 ⊔ localGroup 1)
        (cubic_mem_localGroup 1)
  · have ht : twoGroup ≤ modelGroup := by
      rintro _ ⟨i, rfl⟩
      exact modelGroup.mul_mem (modelGroup.pow_mem (model_generator_mem 0) _)
        (modelGroup.pow_mem (model_generator_mem 1) _)
    exact sup_le (localGroup_le 2 ht (model_generator_mem 2))
      (localGroup_le 1 ht (model_generator_mem 3))

