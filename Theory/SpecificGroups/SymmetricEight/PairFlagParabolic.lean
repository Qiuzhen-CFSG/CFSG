public import Theory.SpecificGroups.SymmetricEight.PairFlagParabolic.Deleted
public import Theory.SpecificGroups.SymmetricEight.PairFlagParabolic.Exterior
import all Theory.SpecificGroups.SymmetricEight.FourBlockParabolic.Geometry

/-!
# A simultaneous A₈–GL₄(2) marking of two partition stabilizers

The existing `FourBlockParabolic.equiv` sends the even stabilizer of
{0123,4567} to the stabilizer of span(e₀,e₁). For the same equivalence,
the deleted-module pencil generated by 11110000 and 11001100 corresponds
to the bivector pencil through the line e₀+e₁ in the hyperplane x₂=x₃.
The two stabilizer calculations identify the even stabilizer of {01,23,45,67}
with the middle-node minimal parabolic for the basis
(e₀+e₁,e₁,e₂+e₃,e₃). Its middle cut is the original coordinate two-plane.

`middle` and `ends` use this single equivalence and this single basis.
`simultaneous_comparison` packages the two actual subgroup identities without
additional premises. The internal geometry import unfolds only the existing
marked equivalence; action compatibility uses the public ATLAS specification
`psl4TwoEquivAlt8_orthogonal`.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
15.3.28(3) and 15.3.32(4), printed pp.1131–1133 (PDF pp.1148–1150).
-/

open Atlas.Order20160A8 Atlas.Comparisons.Exceptional
open BinaryLinear.InvariantNodeActions
open Theory.SpecificGroups.SymmetricEight.A6ShadowTwoLocals
open scoped MatrixGroups
namespace Theory.SpecificGroups.SymmetricEight.PairFlagParabolic
noncomputable section

def coordinateComparison : W ≃ₗ[ZMod 2] DeletedEight.W :=
  Exterior.coordinates.trans DeletedEight.splitEquiv

theorem first_mark : coordinateComparison firstVector = Submodule.Quotient.mk firstWord := by
  change Submodule.Quotient.mk (DeletedEight.intoEven _) = Submodule.Quotient.mk firstWord
  congr 1
  apply Subtype.ext
  decide +kernel

theorem second_mark : coordinateComparison secondVector = Submodule.Quotient.mk secondWord := by
  change Submodule.Quotient.mk (DeletedEight.intoEven _) = Submodule.Quotient.mk secondWord
  congr 1
  apply Subtype.ext
  decide +kernel

theorem map_pencil : pencil.map coordinateComparison.toLinearMap = deletedPencil := by
  rw [pencil_eq_span, Submodule.map_span]
  simp only [Set.image_pair, LinearEquiv.coe_coe, first_mark, second_mark, deletedPencil]

theorem mem_coordinateComparison (w : W) : coordinateComparison w ∈ deletedPencil ↔
    w ∈ pencil := by
  rw [← map_pencil, Submodule.mem_map]
  constructor
  · rintro ⟨v, hv, he⟩
    exact coordinateComparison.injective he ▸ hv
  · intro hw
    exact ⟨w, hw, rfl⟩

theorem action_compare (a : alternatingGroup (Fin 8)) (w : W) :
    DeletedEight.quotientPerm a.val (coordinateComparison w) =
      coordinateComparison
        (Exterior.exteriorAction (sl4TwoEquivPSL.symm (alt8EquivPSL4Two a)) w) := by
  have h := psl4TwoEquivAlt8_orthogonal
    (sl4TwoEquivPSL.symm (alt8EquivPSL4Two a))
  rw [sl4TwoEquivPSL.apply_symm_apply] at h
  change DeletedEight.orthogonalHom (psl4TwoEquivAlt8 (psl4TwoEquivAlt8.symm a)).val = _ at h
  rw [psl4TwoEquivAlt8.apply_symm_apply] at h
  have hh := congrArg (fun t => t.val (Exterior.coordinates w)) h
  change DeletedEight.splitEquiv.symm
      (DeletedEight.quotientPerm a.val (coordinateComparison w)) =
    Exterior.coordinates (Bivectors.exteriorMap
      (sl4TwoEquivPSL.symm (alt8EquivPSL4Two a)).val
      (Exterior.coordinates.symm (Exterior.coordinates w))) at hh
  rw [LinearEquiv.symm_apply_apply] at hh
  simpa [coordinateComparison, Exterior.exteriorAction] using congrArg DeletedEight.splitEquiv hh

/-- The same exceptional equivalence as the four-block marking. -/
public abbrev equiv := FourBlockParabolic.equiv

public theorem pair_comap : (minimalParabolic basis 1).comap equiv.toMonoidHom =
    pairStabilizer.subgroupOf (alternatingGroup (Fin 8)) := by
  ext a
  change BinaryLinear.OuterCyclic.slEquivLinear 4
    (sl4TwoEquivPSL.symm (alt8EquivPSL4Two a)) ∈ minimalParabolic basis 1 ↔
      a.val ∈ pairStabilizer
  rw [← exterior_parabolic_iff, ← deleted_parabolic_iff]
  constructor
  · intro h q
    obtain ⟨w, rfl⟩ := coordinateComparison.surjective q
    rw [action_compare, mem_coordinateComparison, mem_coordinateComparison]
    exact h w
  · intro h w
    rw [← mem_coordinateComparison, ← action_compare, h, mem_coordinateComparison]

public theorem middle : (pairStabilizer.subgroupOf (alternatingGroup (Fin 8))).map
    equiv.toMonoidHom = minimalParabolic basis 1 := by
  rw [← pair_comap]
  exact Subgroup.map_comap_eq_self (fun x _ => ⟨equiv.symm x, equiv.apply_symm_apply x⟩)

public theorem ends : (fourStabilizer.subgroupOf (alternatingGroup (Fin 8))).map
    equiv.toMonoidHom = cutStabilizer basis {1} := by
  have he : cutStabilizer basis ({1} : Set (Fin 3)) =
      BinaryLinear.parabolic FourBlockParabolic.plane := by
    simp [cutStabilizer, cut_one]
  rw [he, ← FourBlockParabolic.parabolic_comap]
  exact Subgroup.map_comap_eq_self (fun x _ => ⟨equiv.symm x, equiv.apply_symm_apply x⟩)

/-- One equivalence and one basis simultaneously mark the two literal partitions. -/
public theorem simultaneous_comparison :
    ∃ (e : alternatingGroup (Fin 8) ≃* BinaryLinear.OuterCyclic.LinearGroup 4)
      (b : Basis 3),
      (pairStabilizer.subgroupOf (alternatingGroup (Fin 8))).map e.toMonoidHom =
          minimalParabolic b 1 ∧
        (fourStabilizer.subgroupOf (alternatingGroup (Fin 8))).map e.toMonoidHom =
          cutStabilizer b {1} := ⟨equiv, basis, middle, ends⟩

end
end Theory.SpecificGroups.SymmetricEight.PairFlagParabolic
