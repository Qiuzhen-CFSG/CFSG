module
public import Theory.SpecificGroups.SymmetricFourWreath.Core.Coordinates
public import Theory.GroupTheory.QuaternionCentralProductIntrinsic
public import Theory.GroupTheory.QuaternionCentralProductTransport

/-!
# The marked quaternion central product

The coordinate embeddings form two commuting quaternion groups with their
common involution as intersection. Their join is the actual order-32 core,
and its center is the cyclic subgroup generated by the diagonal involution.

Source: Aschbacher–Smith 13.9.6, printed p.971 (PDF p.988).
-/

public section
namespace SymmetricFourWreath
open Subgroup
private instance : DecidableEq P := (RegularWreathProduct.equivProd D8 C2).injective.decidableEq
private instance : Fintype P := Fintype.ofEquiv _ (RegularWreathProduct.equivProd D8 C2).symm
private instance (side : Bool) : DecidablePred (·∈(quaternionEmbedding side).range) :=
  fun x=>inferInstanceAs (Decidable (∃y,quaternionEmbedding side y=x))
private instance : DecidablePred (·∈((quaternionEmbedding false).range ⊓ (quaternionEmbedding true).range : Subgroup P)) :=
  fun x=>inferInstanceAs (Decidable (x∈(quaternionEmbedding false).range ∧ x∈(quaternionEmbedding true).range))

theorem coreInP_eq_sup : coreInP = (quaternionEmbedding false).range ⊔ (quaternionEmbedding true).range := by
  apply le_antisymm
  · rintro _ ⟨⟨a,b⟩,rfl⟩
    change quaternionEmbedding false a * quaternionEmbedding true b ∈
      (quaternionEmbedding false).range ⊔ (quaternionEmbedding true).range
    exact Subgroup.mul_mem _ (mem_sup_left (show quaternionEmbedding false a ∈ (quaternionEmbedding false).range from ⟨a,rfl⟩))
      (mem_sup_right (show quaternionEmbedding true b ∈ (quaternionEmbedding true).range from ⟨b,rfl⟩))
  · apply sup_le
    · rintro _ ⟨a,rfl⟩
      exact ⟨(a,1),by simp [quaternionProduct]⟩
    · rintro _ ⟨b,rfl⟩
      exact ⟨(1,b),by simp [quaternionProduct]⟩

theorem quaternion_le_coreInP (side : Bool) : (quaternionEmbedding side).range ≤ coreInP := by
  rw [coreInP_eq_sup]
  cases side
  · exact le_sup_left
  · exact le_sup_right

theorem quaternion_intersection_card :
    Nat.card ((quaternionEmbedding false).range ⊓ (quaternionEmbedding true).range : Subgroup P) = 2 := by
  rw [Nat.card_eq_fintype_card]
  decide +kernel

@[expose] noncomputable def coreInPQuaternionData : QuaternionCentralProductData coreInP where
  left := (quaternionEmbedding false).range.subgroupOf coreInP
  right := (quaternionEmbedding true).range.subgroupOf coreInP
  left_model := ⟨(subgroupOfEquivOfLe (quaternion_le_coreInP false)).trans
    (MonoidHom.ofInjective (quaternionEmbedding_injective false)).symm⟩
  right_model := ⟨(subgroupOfEquivOfLe (quaternion_le_coreInP true)).trans
    (MonoidHom.ofInjective (quaternionEmbedding_injective true)).symm⟩
  intersection_card := by
    change Nat.card (((quaternionEmbedding false).range ⊓ (quaternionEmbedding true).range).subgroupOf coreInP) = 2
    rw [Nat.card_congr (subgroupOfEquivOfLe (inf_le_left.trans (quaternion_le_coreInP false))).toEquiv]
    exact quaternion_intersection_card
  commute := by
    intro b hb c hc
    obtain ⟨a,ha⟩ := hb
    obtain ⟨d,hd⟩ := hc
    change quaternionEmbedding false a = (b:P) at ha
    change quaternionEmbedding true d = (c:P) at hd
    apply Subtype.ext
    change (b:P)*(c:P)=(c:P)*(b:P)
    rw [←ha,←hd]
    exact (quaternionEmbedding_commute a d).eq
  span := by
    rw [←subgroupOf_sup (quaternion_le_coreInP false) (quaternion_le_coreInP true),←coreInP_eq_sup]
    exact subgroupOf_self coreInP

theorem coreInP_extraspecial : IsExtraspecial 2 coreInP := coreInPQuaternionData.extraspecial

@[expose] def centralInP : P := pair (DihedralGroup.r 2,DihedralGroup.r 2)

theorem centralInP_ne_one : centralInP ≠ 1 := by decide +kernel

theorem centralInP_sq : centralInP * centralInP = 1 := by decide +kernel

theorem centralInP_mem_coreInP : centralInP∈coreInP := by rw [mem_coreInP]; decide +kernel

theorem centralInP_central (x : P) : x*centralInP=centralInP*x := by
  revert x
  decide +kernel

theorem center_coreInP : (center coreInP).map coreInP.subtype = zpowers centralInP := by
  symm
  apply eq_of_le_of_card_ge
  · apply zpowers_le.mpr
    refine ⟨⟨centralInP,centralInP_mem_coreInP⟩,?_,rfl⟩
    exact mem_center_iff.mpr (fun x=>Subtype.ext (centralInP_central x))
  · rw [card_map_of_injective coreInP.subtype_injective,coreInPQuaternionData.center_card]
    have h : orderOf centralInP = 2 := orderOf_eq_prime (by simpa only [pow_two] using centralInP_sq) centralInP_ne_one
    rw [Nat.card_zpowers,h]
end SymmetricFourWreath
