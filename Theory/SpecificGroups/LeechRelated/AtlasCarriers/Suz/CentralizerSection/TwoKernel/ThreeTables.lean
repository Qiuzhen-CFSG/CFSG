module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Suz.CentralizerSection.Checks

/-!
# Tables for an elementary abelian three-subgroup of the Suz centralizer

The numerical maps describe `x = d⁴`, `h = c⁻¹ d c d c²`, `k = c d³ c⁻¹`,
and the conjugates `y = h x h⁻¹`, `t = k x k⁻¹`. They are candidate data;
`ThreeCertificates` checks each identity against the original maps for `c,d`.
This gives a direct rank witness for the local obstruction of
Aschbacher--Smith A.2.19 and I.1.3, with no claim about the pair-action kernel.
See `source/README.md` for reproduction and conventions.
-/

@[expose] public section
namespace Sporadic.LeechRelated.Suz.CentralizerSection.ThreeWitness
open Tables

def ciPacked : Nat := 

def ciMap : Fin 1782 → Fin 1782 := lookup ciPacked

def hPacked : Nat := 

def hMap : Fin 1782 → Fin 1782 := lookup hPacked

def hiPacked : Nat := 

def hiMap : Fin 1782 → Fin 1782 := lookup hiPacked

def kPacked : Nat := 

def kMap : Fin 1782 → Fin 1782 := lookup kPacked

def kiPacked : Nat := 

def kiMap : Fin 1782 → Fin 1782 := lookup kiPacked

def xPacked : Nat := 

def xMap : Fin 1782 → Fin 1782 := lookup xPacked

def yPacked : Nat := 

def yMap : Fin 1782 → Fin 1782 := lookup yPacked

def tPacked : Nat := 

def tMap : Fin 1782 → Fin 1782 := lookup tPacked

def pointCheck (i : Nat) : Bool :=
  if i < 1782 then
    let a := Fin.ofNat 1782 i
    (cMap (ciMap a) == a) &&
    (hMap a == ciMap (dMap (cMap (dMap (cMap (cMap a)))))) &&
    (kMap a == cMap (dMap (dMap (dMap (ciMap a))))) &&
    (hMap (hiMap a) == a) && (kMap (kiMap a) == a) &&
    (xMap a == dMap (dMap (dMap (dMap a)))) &&
    (yMap a == hMap (xMap (hiMap a))) &&
    (tMap a == kMap (xMap (kiMap a))) &&
    (xMap (xMap (xMap a)) == a) &&
    (yMap (yMap (yMap a)) == a) &&
    (tMap (tMap (tMap a)) == a) &&
    (xMap (yMap a) == yMap (xMap a)) &&
    (xMap (tMap a) == tMap (xMap a)) &&
    (yMap (tMap a) == tMap (yMap a))
  else true

end Sporadic.LeechRelated.Suz.CentralizerSection.ThreeWitness
