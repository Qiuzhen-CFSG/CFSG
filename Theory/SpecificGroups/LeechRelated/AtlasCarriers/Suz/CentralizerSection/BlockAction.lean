module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Suz.CentralizerSection.Action
public import Theory.GroupAction.PermutationLiftSubgroup
public import Mathlib.Algebra.Group.Subgroup.Ker
/-!
# The surjective action of a Suz centralizing subgroup on 27 pairs

The checked words `c` and `d` generate a subgroup of the literal involution
centralizer. Their action on the 27 labelled pairs extends uniquely to a
homomorphism because distinct labels denote distinct pairs. Both defining
permutations of `BlockGroup` lift, so that homomorphism is surjective.
The kernel is relatively normal in this numerator; neither splitting nor
normality in the whole sporadic group is assumed.
Source: ATLAS SuzG1-p1782B0; GLS3 Table 5.3o; Aschbacher--Smith A.2.19.
-/

public section
namespace Sporadic.LeechRelated.Suz.CentralizerSection

private def pairPermHom : Carrier →* Equiv.Perm (Finset (Fin 1782)) where
  toFun g := (inclusion g).finsetCongr
  map_one' := Equiv.finsetCongr_refl
  map_mul' g h := (Equiv.finsetCongr_trans (inclusion h) (inclusion g)).symm

private theorem pairPerm_apply (g : Carrier) (s : Finset (Fin 1782)) :
    pairPermHom g s = s.image (inclusion g) := by
  change (inclusion g).finsetCongr s = _
  simp only [Equiv.finsetCongr_apply, Finset.map_eq_image, Equiv.coe_toEmbedding]

/-- The subgroup generated by the two checked centralizing words. -/
def numerator : Subgroup Carrier := Subgroup.closure {c, d}

/-- Actual centralizer containment in the fixed Suz carrier. -/
theorem numerator_centralizes : numerator ≤ Subgroup.centralizer ({involution} : Set Carrier) := by
  apply (Subgroup.closure_le _).mpr
  intro x hx
  rcases Set.mem_insert_iff.mp hx with rfl | hx
  · exact Subgroup.mem_centralizer_singleton_iff.mpr c_commutes
  · have : x = d := Set.mem_singleton_iff.mp hx
    subst x
    exact Subgroup.mem_centralizer_singleton_iff.mpr d_commutes

private theorem numerator_lifts : numerator ≤
    (Theory.GroupAction.permutationLiftSubgroup point blockGroup).comap pairPermHom := by
  apply (Subgroup.closure_le _).mpr
  intro x hx
  rcases Set.mem_insert_iff.mp hx with rfl | hx
  · refine ⟨blockC, Subgroup.subset_closure (by simp), ?_⟩
    intro i
    simpa only [pairPerm_apply] using c_point i
  · have : x = d := Set.mem_singleton_iff.mp hx
    subst x
    refine ⟨blockD, Subgroup.subset_closure (by simp), ?_⟩
    intro i
    simpa only [pairPerm_apply] using d_point i

private theorem exists_induced (g : numerator) :
    ∃ p : BlockGroup, ∀ i, pairPermHom g.val (point i) = point (p.val i) := by
  obtain ⟨p, hp, h⟩ := numerator_lifts g.property
  exact ⟨⟨p, hp⟩, h⟩

private noncomputable def induced (g : numerator) : BlockGroup := (exists_induced g).choose

private theorem induced_spec (g : numerator) (i : Fin 27) :
    pairPermHom g.val (point i) = point ((induced g).val i) :=
  (exists_induced g).choose_spec i

private theorem induced_unique (g : numerator) (p : BlockGroup)
    (hp : ∀ i, pairPermHom g.val (point i) = point (p.val i)) : induced g = p := by
  apply Subtype.ext
  apply Equiv.ext
  intro i
  exact point_injective ((induced_spec g i).symm.trans (hp i))

/-- The uniquely induced action on the exact 27 pairs. -/
noncomputable def blockAction : numerator →* BlockGroup where
  toFun := induced
  map_one' := by
    apply induced_unique
    intro i
    change pairPermHom 1 (point i) = point i
    rw [map_one]
    rfl
  map_mul' g h := by
    apply induced_unique
    intro i
    change pairPermHom (g.val * h.val) (point i) = _
    rw [map_mul, Equiv.Perm.mul_apply, induced_spec, induced_spec]
    rfl

private theorem blockAction_spec (g : numerator) (i : Fin 27) :
    pairPermHom g.val (point i) = point ((blockAction g).val i) := induced_spec g i

def cInNumerator : numerator := ⟨c, Subgroup.subset_closure (by simp)⟩
def dInNumerator : numerator := ⟨d, Subgroup.subset_closure (by simp)⟩

theorem blockAction_c : (blockAction cInNumerator).val = blockC := by
  apply Equiv.ext
  intro i
  apply point_injective
  rw [← blockAction_spec, pairPerm_apply]
  exact c_point i

theorem blockAction_d : (blockAction dInNumerator).val = blockD := by
  apply Equiv.ext
  intro i
  apply point_injective
  rw [← blockAction_spec, pairPerm_apply]
  exact d_point i

/-- Each target generator is the image of its original centralizing word. -/
theorem blockAction_surjective : Function.Surjective blockAction := by
  let f := blockGroup.subtype.comp blockAction
  have hf : blockGroup ≤ f.range := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact ⟨cInNumerator, blockAction_c⟩
    · have : x = blockD := Set.mem_singleton_iff.mp hx
      subst x
      exact ⟨dInNumerator, blockAction_d⟩
  intro x
  obtain ⟨g, hg⟩ := hf x.property
  exact ⟨g, Subtype.ext hg⟩

end Sporadic.LeechRelated.Suz.CentralizerSection
