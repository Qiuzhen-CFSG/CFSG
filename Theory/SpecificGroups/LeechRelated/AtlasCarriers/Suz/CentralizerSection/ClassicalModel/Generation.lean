module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Suz.CentralizerSection.ClassicalModel.SchreierData
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Suz.CentralizerSection.ClassicalModel.Derived
public import Mathlib.GroupTheory.Index

/-!
# The Suz block matrices generate the orthogonal commutator subgroup

Successively correct the first five basis images with the certified transversal
words. An isometry fixing these vectors is either the identity or the displayed
last-coordinate symmetry. Thus the subgroup generated by the two matrices has
index dividing two in the full quadratic isometry group, so it contains every
commutator. The word relations in `Derived` prove the reverse containment.

This is a concrete generation proof. It uses neither a classification or
simplicity assumption, an order-recognition theorem, nor the exceptional
unitary isomorphism. Source: GLS3 Table 5.3o, interpreted with the quadratic
commutator convention in GLS3 section 2.7; Aschbacher--Smith A.2.19,
printed pp.40--41.
-/

@[expose] public section
namespace Sporadic.LeechRelated.Suz.CentralizerSection.ClassicalModel

def fixesPrefix (k : ℕ) (g : O) : Prop :=
  ∀ j : Fin 6, j.val < k → g.val (basisVector j) = basisVector j

private theorem basis_ne_zero : ∀ j : Fin 6, basisVector j ≠ 0 := by decide +kernel
private theorem basis_singular : ∀ j : Fin 6, form (basisVector j) = 0 := by decide +kernel
private theorem basis_injective : Function.Injective basisVector := by decide +kernel

theorem polar_preserves (g : O) (v w : V) :
    polar (g.val v) (g.val w) = polar v w := by
  unfold polar
  rw [← map_add, isometry_preserves, isometry_preserves, isometry_preserves]

theorem admissible_image (k : Fin 6) (g : O) (hg : fixesPrefix k.val g) :
    admissible k (g.val (basisVector k)) := by
  refine ⟨?_, (isometry_preserves g _).trans (basis_singular k), ?_⟩
  · intro h
    exact basis_ne_zero k (g.val.injective (h.trans (map_zero g.val).symm))
  · intro j hj
    constructor
    · intro he
      have hkj := basis_injective (g.val.injective (he.trans (hg j hj).symm))
      have : k.val = j.val := congrArg Fin.val hkj
      omega
    · calc
        polar (g.val (basisVector k)) (basisVector j) =
            polar (g.val (basisVector k)) (g.val (basisVector j)) :=
          congrArg (polar (g.val (basisVector k))) (hg j hj).symm
        _ = _ := polar_preserves g _ _

theorem correction (k : Fin 5) (g : O) (hg : fixesPrefix k.val g) :
    ∃ t : O, t ∈ generated ∧ fixesPrefix (k.val + 1) (t⁻¹ * g) := by
  have ha := admissible_image k.castSucc g hg
  obtain ⟨i, hi⟩ := pointVector_exhausts _ ha.1 ha.2.1
  have had : admissible k.castSucc (pointVector i) := by rw [hi]; exact ha
  have ht := transversal_spec k i had
  let t := wordEval (transversal k i)
  have hm : t.val (basisVector k.castSucc) = pointVector i := by
    have he := orthogonalAction_pointVector t (basisIndex k.castSucc)
    rw [wordEval_action, ht.1, pointVector_basis] at he
    exact he.symm
  have hf (j : Fin 6) (hj : j.val < k.val) : t.val (basisVector j) = basisVector j := by
    have he := orthogonalAction_pointVector t (basisIndex j)
    rw [wordEval_action, ht.2 j hj, pointVector_basis] at he
    exact he.symm
  refine ⟨t, wordEval_mem _, ?_⟩
  intro j hj
  change t.val.symm (g.val (basisVector j)) = basisVector j
  by_cases hjk : j.val < k.val
  · calc
      t.val.symm (g.val (basisVector j)) = t.val.symm (t.val (basisVector j)) :=
        congrArg t.val.symm ((hg j hjk).trans (hf j hjk).symm)
      _ = _ := t.val.symm_apply_apply _
  · have heq : j = k.castSucc := Fin.ext (by change j.val = k.val; omega)
    subst j
    rw [← hi, ← hm, t.val.symm_apply_apply]

theorem normalize (k : ℕ) (hk : k ≤ 5) (g : O) :
    ∃ h : O, h ∈ generated ∧ fixesPrefix k (h * g) := by
  induction k with
  | zero =>
    refine ⟨1, generated.one_mem, ?_⟩
    intro j hj
    omega
  | succ k ih =>
    obtain ⟨h, hh, hfix⟩ := ih (by omega)
    obtain ⟨t, ht, hnext⟩ := correction ⟨k, by omega⟩ (h*g) hfix
    refine ⟨t⁻¹*h, generated.mul_mem (generated.inv_mem ht) hh, ?_⟩
    simpa only [mul_assoc] using hnext

def tailMatrix := columns ![1,2,4,8,16,58]
private theorem tail_square : tailMatrix * tailMatrix = 1 := by decide +kernel

def tailLinear : V ≃ₗ[K] V := Matrix.toLin'OfInv (M := tailMatrix) (M' := tailMatrix)
  (by exact tail_square) (by exact tail_square)

theorem tail_preserves : ∀ v, form (tailLinear v) = form v := by decide +kernel

def tailIsometry : O := ⟨tailLinear,
  (Theory.AlgebraicGroup.mem_quadraticIsometrySubgroup form _).mpr tail_preserves⟩

private theorem tail_fixes : fixesPrefix 5 tailIsometry := by
  unfold fixesPrefix
  decide +kernel
private theorem tail_last : tailLinear (basisVector 5) = pointVector 26 := by decide +kernel
private theorem basis_last : basisVector 5 = pointVector 7 := by decide +kernel

private theorem isometry_ext (g h : O)
    (hp : ∀ j : Fin 6, g.val (basisVector j) = h.val (basisVector j)) : g = h := by
  apply Subtype.ext
  apply LinearEquiv.toLinearMap_injective
  apply (Pi.basisFun K (Fin 6)).ext
  intro j
  change g.val ((Pi.basisFun K (Fin 6)) j) = h.val ((Pi.basisFun K (Fin 6)) j)
  rw [Pi.basisFun_apply]
  exact hp j

theorem terminal_isometry (g : O) (hg : fixesPrefix 5 g) : g = 1 ∨ g = tailIsometry := by
  have ha := admissible_image 5 g hg
  obtain ⟨i, hi⟩ := pointVector_exhausts _ ha.1 ha.2.1
  have had : admissible 5 (pointVector i) := by rw [hi]; exact ha
  rcases terminal_vectors i had with rfl | rfl
  · left
    apply isometry_ext
    intro j
    change g.val (basisVector j) = basisVector j
    by_cases hj : j.val < 5
    · exact hg j hj
    · have he : j = 5 := Fin.ext (by omega)
      subst j
      exact hi.symm.trans basis_last.symm
  · right
    apply isometry_ext
    intro j
    by_cases hj : j.val < 5
    · exact (hg j hj).trans (tail_fixes j hj).symm
    · have he : j = 5 := Fin.ext (by omega)
      subst j
      exact hi.symm.trans tail_last.symm

theorem two_cosets (g : O) : g * tailIsometry⁻¹ ∈ generated ∨ g ∈ generated := by
  obtain ⟨h, hh, hfix⟩ := normalize 5 (by omega) g
  rcases terminal_isometry (h*g) hfix with he | he
  · right
    have heq : g = h⁻¹ := by
      have := congrArg (fun x : O => h⁻¹*x) he
      simpa only [inv_mul_cancel_left, mul_one] using this
    rw [heq]
    exact generated.inv_mem hh
  · left
    rw [← he]
    simpa only [mul_inv_rev, mul_inv_cancel_left] using generated.inv_mem hh

theorem commutator_le_generated : commutator O ≤ generated := by
  have hidx : generated.index ∣ 2 := Subgroup.index_dvd_two_iff.mpr
    ⟨tailIsometry⁻¹, two_cosets⟩
  have hcases : generated.index = 1 ∨ generated.index = 2 := (Nat.dvd_prime Nat.prime_two).mp hidx
  rcases hcases with h | h
  · rw [Subgroup.index_eq_one.mp h]
    exact le_top
  · rw [_root_.commutator_def]
    apply Subgroup.commutator_le.mpr
    intro x _ y _
    simp only [commutatorElement_def, Subgroup.mul_mem_iff_of_index_two h, Subgroup.inv_mem_iff]
    tauto

theorem generated_eq_commutator : generated = commutator O :=
  le_antisymm generated_le_commutator commutator_le_generated

end Sporadic.LeechRelated.Suz.CentralizerSection.ClassicalModel
