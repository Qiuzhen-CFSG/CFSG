module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Suz.CentralizerSection.ClassicalModel.Coordinates

/-!
# The faithful action of the quadratic isometries on the 27 Suz pairs

The labelled singular vectors give an actual permutation action of the full
orthogonal group. It is faithful because six of the labelled vectors form a
basis. The two certified isometries act as the literal block permutations, so
restriction gives an isomorphism from their generated subgroup to `BlockGroup`.
This identifies the concrete actions without presuming any generation theorem.

Source: GLS3 Table 5.3o and Aschbacher--Smith A.2.19, printed pp.40--41;
see `Coordinates` for the fixed numerical data.
-/

@[expose] public section
open ClassicalOrthogonal.Minus Theory.AlgebraicGroup
namespace Sporadic.LeechRelated.Suz.CentralizerSection.ClassicalModel

abbrev Singular := {v : V // v ≠ 0 ∧ form v = 0}

noncomputable def pointEquiv : Fin 27 ≃ Singular := Equiv.ofBijective
  (fun i => ⟨pointVector i, pointVector_singular i⟩)
  ⟨fun _ _ h => pointVector_injective (congrArg Subtype.val h), by
    intro v
    obtain ⟨i, hi⟩ := pointVector_exhausts v.val v.property.1 v.property.2
    exact ⟨i, Subtype.ext hi⟩⟩

theorem isometry_preserves (g : O) (v : V) : form (g.val v) = form v :=
  (mem_quadraticIsometrySubgroup form g.val).mp g.property v

def singularPerm (g : O) : Equiv.Perm Singular where
  toFun v := ⟨g.val v.val,
    fun h => v.property.1 (g.val.injective (h.trans (map_zero g.val).symm)),
    (isometry_preserves g v.val).trans v.property.2⟩
  invFun v := ⟨g⁻¹.val v.val,
    fun h => v.property.1 (g⁻¹.val.injective (h.trans (map_zero g⁻¹.val).symm)),
    (isometry_preserves g⁻¹ v.val).trans v.property.2⟩
  left_inv v := Subtype.ext (g.val.symm_apply_apply v.val)
  right_inv v := Subtype.ext (g.val.apply_symm_apply v.val)

def singularAction : O →* Equiv.Perm Singular where
  toFun := singularPerm
  map_one' := by ext v; rfl
  map_mul' g h := by ext v; rfl

noncomputable def orthogonalAction : O →* Equiv.Perm (Fin 27) := by
  exact pointEquiv.symm.permCongrHom.toMonoidHom.comp singularAction

theorem orthogonalAction_pointVector (g : O) (i : Fin 27) :
    pointVector (orthogonalAction g i) = g.val (pointVector i) := by
  exact congrArg Subtype.val (pointEquiv.apply_symm_apply (singularPerm g (pointEquiv i)))

theorem orthogonalAction_injective : Function.Injective orthogonalAction := by
  intro g h he
  have hp (i : Fin 27) : g.val (pointVector i) = h.val (pointVector i) := by
    rw [← orthogonalAction_pointVector, ← orthogonalAction_pointVector, he]
  apply Subtype.ext
  apply LinearEquiv.toLinearMap_injective
  apply (Pi.basisFun K (Fin 6)).ext
  intro j
  change g.val ((Pi.basisFun K (Fin 6)) j) = h.val ((Pi.basisFun K (Fin 6)) j)
  rw [Pi.basisFun_apply, ← pointVector_basis]
  exact hp (basisIndex j)

theorem orthogonalAction_c : orthogonalAction cIsometry = blockC := by
  apply Equiv.ext
  intro i
  apply pointVector_injective
  rw [orthogonalAction_pointVector]
  exact c_pointVector i

theorem orthogonalAction_d : orthogonalAction dIsometry = blockD := by
  apply Equiv.ext
  intro i
  apply pointVector_injective
  rw [orthogonalAction_pointVector]
  exact d_pointVector i

/-- The subgroup generated by the two literal six-dimensional isometries. -/
def generated : Subgroup O := Subgroup.closure {cIsometry, dIsometry}

theorem generated_map : generated.map orthogonalAction = blockGroup := by
  rw [generated, MonoidHom.map_closure]
  simp only [Set.image_insert_eq, Set.image_singleton, orthogonalAction_c, orthogonalAction_d]
  rfl

noncomputable def generatedBlockEquiv : generated ≃* BlockGroup :=
  (generated.equivMapOfInjective orthogonalAction orthogonalAction_injective).trans
    (MulEquiv.subgroupCongr generated_map)

end Sporadic.LeechRelated.Suz.CentralizerSection.ClassicalModel
