theorem matrixA_square : matrixA * matrixA = 1 := by decide +kernel

theorem matrixB_cube : matrixB * matrixB * matrixB = 1 := by decide +kernel

/-- The first published generator with its certified inverse. -/
def generatorA : Ambient :=
  ⟨matrixA, matrixA, matrixA_square, matrixA_square⟩

/-- The second published generator with its certified inverse. -/
def generatorB : Ambient :=
  ⟨matrixB, matrixB * matrixB, by simpa only [mul_assoc] using matrixB_cube,
    matrixB_cube⟩

/-- The subgroup generated by the two published invertible matrices. -/
def generated : Subgroup Ambient := Subgroup.closure {generatorA, generatorB}

/-- The actual carrier of the published binary matrix representation. -/
abbrev Carrier : Type := generated

instance carrierFinite : Finite Carrier := inferInstanceAs (Finite generated)

/-- Faithful inclusion in the defining general linear group. -/
def inclusion : Carrier →* Ambient := generated.subtype

theorem inclusion_injective : Function.Injective inclusion := Subtype.val_injective

end Sporadic.LeechRelated.Co1
