/-!
# Explicit witnesses for the order-11 overgroup calculation

These are elements of `OrderCertificate.H1`, the auxiliary stabilizer-chain
subgroup of permutations of 100 letters. Each is defined by a word in its
certified generators, so membership is intrinsic. This module does not identify
H1 with the actual HS point stabilizer or assert completeness of the witnesses.

The intended certificate uses 150 double cosets of `normalizerCandidate`.
The exceptional subgroup is generated by two conjugate cyclic subgroups.
The coverage, generation, normalizer and index assertions require separate proofs.
The retained GAP/Python discovery in `source/` is untrusted. It uses precisely
ATLAS HSG1-p100B0 with the inverse-action convention of `HS.lean`.
Source context: GLS3 Table 5.3m, printed p.274, and Aschbacher–Smith p.510.
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.SmallIndex
open Theory.GroupTheory

/-- The existing auxiliary point-stabilizer group; comparison is still required. -/
abbrev CertifiedStabilizer := OrderCertificate.H1

/-- A generator as an element of the auxiliary stabilizer. -/
def generator (i : Fin 17) : CertifiedStabilizer :=
  ⟨OrderCertificate.gen1 i, ⟨[i], mul_one _⟩⟩

/-- Word evaluation within the auxiliary stabilizer. -/
def word (w : List (Fin 17)) : CertifiedStabilizer := evalWord generator w

/-- Candidate element of order eleven, given by an explicit word. -/
def elevenElement : CertifiedStabilizer := word [10, 0, 6, 16, 7, 13, 15]

/-- Candidate order-five normalizing element. -/
def normalizerElement : CertifiedStabilizer := word [3, 0, 5, 9, 12, 7, 13, 12]

/-- The cyclic subgroup whose proper overgroups control small indices. -/
def primeSubgroup : Subgroup CertifiedStabilizer := Subgroup.zpowers elevenElement

/-- An explicit candidate for the normalizer of `primeSubgroup`. -/
def normalizerCandidate : Subgroup CertifiedStabilizer :=
  primeSubgroup ⊔ Subgroup.zpowers normalizerElement

