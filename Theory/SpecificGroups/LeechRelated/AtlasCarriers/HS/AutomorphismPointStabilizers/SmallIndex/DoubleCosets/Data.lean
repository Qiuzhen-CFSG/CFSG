def pivot (k : Fin 3) : Fin 100 := if k = 0 then 1 else if k = 1 then 6 else 13

def rowCode (k : Fin 3) (i : Fin 5760) : Nat :=
  if k = 0 then rowCode0 i else if k = 1 then rowCode1 i else rowCode2 i

def rowRepresentative (k : Fin 3) (i : Fin 5760) : Fin 150 :=
  ⟨(rowCode k i >>> 12) % 150, Nat.mod_lt _ (by decide)⟩

def rowLeft (k : Fin 3) (i : Fin 5760) : Fin 55 :=
  ⟨(rowCode k i >>> 6) % 64 % 55, Nat.mod_lt _ (by decide)⟩

def rowRight (k : Fin 3) (i : Fin 5760) : Fin 55 :=
  ⟨rowCode k i % 64 % 55, Nat.mod_lt _ (by decide)⟩

/-- Every row is intrinsically in one of the required double cosets. -/
def rowElement (k : Fin 3) (i : Fin 5760) : CertifiedStabilizer :=
  normalWord (rowLeft k i) * representative (rowRepresentative k i) *
    normalWord (rowRight k i)

def rowMap (k : Fin 3) (i : Fin 5760) (x : Fin 100) : Fin 100 :=
  normalMap (rowLeft k i)
    (representativeMap (rowRepresentative k i) (normalMap (rowRight k i) x))

/-- A numerical key; only distinctness of keys is used, not base faithfulness. -/
def key (f : Fin 100 → Fin 100) : Nat :=
  (((f 4).val * 100 + (f 2).val) * 100 + (f 14).val) * 100 + (f 3).val

def rowKey (k : Fin 3) (i : Fin 5760) : Nat := key (rowMap k i)

/-- The pivot and translating factor for each of the 77 distinct images. -/
def orbitSlice (j : Fin 77) : Fin 3 :=
  if j.val < 55 then 0 else if j.val < 66 then 1 else 2

def orbitFactor (j : Fin 77) : Fin 55 :=
  ⟨(if j.val < 55 then j.val else if j.val < 66 then 5 * (j.val - 55)
    else 5 * (j.val - 66)) % 55, Nat.mod_lt _ (by decide)⟩

def orbitPoint (j : Fin 77) : Fin 100 :=
  normalMap (orbitFactor j) (pivot (orbitSlice j))

