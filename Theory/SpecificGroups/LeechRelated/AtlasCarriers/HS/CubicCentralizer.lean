private theorem normalForm_fused (t : Fin 9) (ht : t ≠ 0) : IsConj x (normalForm t) := by
  have h : ∀ t : Fin 9, t = 0 ∨ t = 1 ∨ t = 2 ∨ t = 3 ∨ t = 4 ∨ t = 5 ∨ t = 6 ∨ t = 7 ∨ t = 8 := by
    apply allFin
    decide +kernel
  rcases h t with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact (ht rfl).elim
  · exact isConj_iff.mpr ⟨f1,fusion1⟩
  · exact isConj_iff.mpr ⟨f2,fusion2⟩
  · exact isConj_iff.mpr ⟨f3,fusion3⟩
  · exact isConj_iff.mpr ⟨f4,fusion4⟩
  · exact isConj_iff.mpr ⟨f5,fusion5⟩
  · exact isConj_iff.mpr ⟨f6,fusion6⟩
  · exact isConj_iff.mpr ⟨f7,fusion7⟩
  · exact isConj_iff.mpr ⟨f8,fusion8⟩

private theorem all_cubics_fused (v : Carrier) (hv : orderOf v = 3) : IsConj x v := by
  have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  have hi : ¬3 ∣ P.index := by
    have hc := P.card_mul_index
    rw [card_P,NormalizerIndex.card_carrier] at hc
    have he : P.index = 4928000 := by omega
    rw [he]
    decide
  let Q : Sylow 3 Carrier := (IsPGroup.of_card card_P).toSylow hi
  have hvP : IsPGroup 3 (zpowers v) := IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers,hv]; rfl)
  obtain ⟨R,hR⟩ := hvP.exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq Carrier R Q
  let e := MulAut.conj g
  have hm : (R:Subgroup Carrier).map e.toMonoidHom = P := congrArg Sylow.toSubgroup hg
  have hmem : e v ∈ P := hm ▸ mem_map_of_mem e.toMonoidHom (hR (mem_zpowers v))
  obtain ⟨t,ht⟩ := normalForm_cover hmem
  have ht0 : t ≠ 0 := by
    intro hz
    have he : e v = 1 := ht.symm.trans (by simp [hz,normalForm])
    have hv1 : v = 1 := e.injective (he.trans (map_one e).symm)
    simp only [hv1,orderOf_one] at hv
    omega
  have hf := normalForm_fused t ht0
  have he : IsConj v (e v) := isConj_iff.mpr ⟨g,rfl⟩
  exact (ht ▸ hf).trans he.symm

private theorem seed_centralizer_card_le : Nat.card (centralizer ({x} : Set Carrier)) ≤ 720 := by
  let f : centralizer ({x} : Set Carrier) → H := fun g =>
    ⟨(g.val:Perm),generated_le_graphGroup g.val.property,by
      apply mem_centralizer_singleton_iff.mpr
      exact congrArg (fun z : Carrier => (z:Perm)) (mem_centralizer_singleton_iff.mp g.property)⟩
  exact (Nat.card_le_card_of_injective f (by
    intro a b h
    have hh : (a.val : Perm) = (b.val : Perm) := congrArg (fun z : H => (z : Perm)) h
    exact Subtype.ext (Subtype.ext hh))).trans H_card_le

/-- Every cubic centralizer in the literal HS carrier has order at most 720.
The bound is for its graph-preserving overgroup, whose true order is 720. -/
theorem centralizer_card_le (v : Carrier) (hv : orderOf v = 3) :
    Nat.card (centralizer ({v} : Set Carrier)) ≤ 720 := by
  obtain ⟨g,hg⟩ := isConj_iff.mp (all_cubics_fused v hv)
  let e := MulAut.conj g
  have he : (centralizer ({x} : Set Carrier)).map e.toMonoidHom = centralizer ({v} : Set Carrier) := by
    have hx : e x = v := hg
    rw [←hx]
    ext w
    rw [mem_map_equiv, mem_centralizer_singleton_iff, mem_centralizer_singleton_iff]
    constructor
    · intro hw
      simpa only [map_mul, e.apply_symm_apply] using congrArg e hw
    · intro hw
      apply e.injective
      simpa only [map_mul, e.apply_symm_apply] using hw
  rw [←he,card_map_of_injective e.injective]
  exact seed_centralizer_card_le

