private abbrev Perm := Equiv.Perm (Fin 100)
private def H : Subgroup Perm := graphGroup ⊓ centralizer ({xPerm} : Set Perm)
private def fixing (xs : List (Fin 100)) : Subgroup Perm where
  carrier := {g | g ∈ H ∧ ∀ x ∈ xs, g x = x}
  one_mem' := ⟨H.one_mem, fun _ _ => rfl⟩
  mul_mem' := by
    rintro g h ⟨hg,hx⟩ ⟨hh,hy⟩
    exact ⟨H.mul_mem hg hh, fun x hm => by
      change g (h x) = x
      rw [hy x hm,hx x hm]⟩
  inv_mem' := by
    rintro g ⟨hg,hx⟩
    exact ⟨H.inv_mem hg,fun x hm => by
      apply g.injective
      simpa only [Equiv.Perm.inv_def,Equiv.apply_symm_apply] using (hx x hm).symm⟩
private def Preserves (xs : List (Fin 100)) (c : Fin 100 → ℕ) : Prop :=
  ∀ g ∈ fixing xs, ∀ x, c (g x) = c x
private theorem commute_point {xs} (g : Perm) (hg : g ∈ fixing xs) (v : Fin 100) :
    g (xPerm v) = xPerm (g v) :=
  congrArg (fun p : Perm => p v) (mem_centralizer_singleton_iff.mp hg.1.2)
private theorem preserves_refine {xs} {c d s : Fin 100 → ℕ}
    (hc : Preserves xs c) (hs : ∀ x, GraphOrder.signature c x = s x)
    (hd : ∀ u v, c u = c v → c (xPerm u) = c (xPerm v) → s u = s v → d u = d v) :
    Preserves xs d := by
  intro g hg v
  apply hd (g v) v (hc g hg v)
  · rw [←commute_point g hg v]
    exact hc g hg (xPerm v)
  · rw [←hs,←hs]
    exact GraphOrder.signature_invariant c g hg.1.1 (hc g hg) v
private theorem preserves_individualize {xs} {c d : Fin 100 → ℕ}
    (hc : Preserves xs c) (v : Fin 100)
    (hd : ∀ x y, c x = c y → (x = v ↔ y = v) → d x = d y) :
    Preserves (v::xs) d := by
  intro g hg x
  have hfix : g v = v := hg.2 v (by simp)
  have hxs : g ∈ fixing xs := ⟨hg.1,fun y hy => hg.2 y (by simp [hy])⟩
  apply hd (g x) x (hc g hxs x)
  exact ⟨fun h => g.injective (h.trans hfix.symm),fun h => h ▸ hfix⟩
private theorem card_fixing_le {xs} {c : Fin 100 → ℕ}
    (hc : Preserves xs c) (v : Fin 100) :
    Nat.card (fixing xs) ≤ GraphOrder.cellSize c v * Nat.card (fixing (v::xs)) := by
  classical
  let e : MulAction.stabilizer (fixing xs) v ≃ fixing (v::xs) := {
    toFun := fun g => ⟨g.val.val,g.val.property.1,by
      intro x hx
      rcases List.mem_cons.mp hx with h | h
      · subst x; exact g.property
      · exact g.val.property.2 x h⟩
    invFun := fun g => ⟨⟨g.val,g.property.1,fun x hx =>
      g.property.2 x (List.mem_cons_of_mem v hx)⟩,
      g.property.2 v (List.mem_cons_self)⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }
  have horbit : Nat.card (MulAction.orbit (fixing xs) v) ≤ GraphOrder.cellSize c v := by
    let f : MulAction.orbit (fixing xs) v → {x : Fin 100 // c x = c v} := fun x =>
      ⟨x.val,by obtain ⟨g,hg⟩ := x.property; rw [←hg]; exact hc g.val g.property v⟩
    have h := Nat.card_le_card_of_injective f (by
      intro x y h; exact Subtype.ext (congrArg (fun z : {x : Fin 100 // c x = c v} => z.val) h))
    simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype,GraphOrder.cellSize] using h
  calc
    Nat.card (fixing xs) = Nat.card (MulAction.orbit (fixing xs) v) *
      Nat.card (MulAction.stabilizer (fixing xs) v) :=
        (Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup (fixing xs) v)).symm.trans (Nat.card_prod _ _)
    _ ≤ GraphOrder.cellSize c v * Nat.card (fixing (v::xs)) := by
      rw [Nat.card_congr e]
      exact Nat.mul_le_mul_right _ horbit
private theorem card_fixing_eq_one {xs} {c : Fin 100 → ℕ}
    (hc : Preserves xs c) (hi : Function.Injective c) : Nat.card (fixing xs) = 1 := by
  apply Nat.card_eq_one_iff_exists.mpr
  refine ⟨1,fun g => ?_⟩
  apply Subtype.ext
  apply Equiv.ext
  intro x
  exact hi (hc g.val g.property x)
