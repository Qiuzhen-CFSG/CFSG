theorem p0_left : ∀ x, p0Map (p0Map x) = x := by
  apply allFin
  decide +kernel

def p0 : Equiv.Perm (Fin 100) :=
  tablePerm p0Map p0Map p0_left
    (rightInverse_of_leftInverse_fin p0_left)

theorem p0_inv : p0⁻¹ = p0 := rfl

