def stepCheck0 : Fin 20 → Bool :=
  fun i => checkFin (fun r : Fin 100 => checkFin (fun x : Fin 100 => decide
    ((gen0 i * rep0 r) x = (rep0 (act0 i r) * evalWord gen1 (factor0 i r)) x)))

theorem step0_of_check (i : Fin 20) (h : stepCheck0 i = true) :
    ∀ r, gen0 i * rep0 r = rep0 (act0 i r) * evalWord gen1 (factor0 i r) := by
  have hr := allFin (fun r : Fin 100 => checkFin (fun x : Fin 100 => decide
    ((gen0 i * rep0 r) x = (rep0 (act0 i r) * evalWord gen1 (factor0 i r)) x)) = true) (by
      simpa only [stepCheck0, Bool.decide_eq_true] using h)
  intro r
  exact Equiv.ext (allFin _ (hr r))

