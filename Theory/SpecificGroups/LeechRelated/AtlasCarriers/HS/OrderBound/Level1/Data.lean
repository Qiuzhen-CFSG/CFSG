public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.OrderBound.Generators
import Mathlib.Tactic.FinCases

/-!
# HS stabilizer level 1: representatives and transition witnesses

Part of the order-divisibility certificate for the exact ATLAS HS carrier.
Source: GLS volume 3, Table 5.3m, printed p.274; ATLAS HSG1-p100B0.
The generator in `OrderBound/source/` supplies witnesses only. Every finite
identity is checked by Lean's kernel.
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.OrderCertificate
open Theory.GroupTheory
set_option maxRecDepth 100000
set_option Elab.async false

def repWord1 (x : Fin 22) : List (Fin 17) :=
  match x.val with
  | 0 => []
  | 1 => [0]
  | 2 => [1]
  | 3 => [2]
  | 4 => [1, 0]
  | 5 => [2, 0]
  | 6 => [3, 0]
  | 7 => [4, 0]
  | 8 => [5, 0]
  | 9 => [6, 0]
  | 10 => [10, 0]
  | 11 => [12, 0]
  | 12 => [14, 0]
  | 13 => [1, 1]
  | 14 => [6, 1]
  | 15 => [9, 1]
  | 16 => [10, 1]
  | 17 => [0, 2]
  | 18 => [3, 2]
  | 19 => [4, 2]
  | 20 => [7, 1, 0]
  | _ => [5, 3, 0]

def rep1 : Fin 22 → Equiv.Perm (Fin 100) :=
  fun r => evalWord gen1 (repWord1 r)

def point1 (x : Fin 22) : Fin 100 :=
  match x.val with
  | 0 => 4
  | 1 => 66
  | 2 => 70
  | 3 => 40
  | 4 => 49
  | 5 => 26
  | 6 => 32
  | 7 => 52
  | 8 => 10
  | 9 => 44
  | 10 => 91
  | 11 => 50
  | 12 => 28
  | 13 => 67
  | 14 => 47
  | 15 => 39
  | 16 => 12
  | 17 => 9
  | 18 => 8
  | 19 => 11
  | 20 => 38
  | _ => 71

theorem rep1_mem (r : Fin 22) : rep1 r ∈ H1 := ⟨repWord1 r, rfl⟩

theorem rep1_base : rep1 0 = 1 := rfl

theorem rep1_point : ∀ r, rep1 r 4 = point1 r := by
  apply allFin
  decide +kernel

theorem point1_injective : Function.Injective point1 := by
  have h : ∀ i j : Fin 22, point1 i = point1 j → i = j := by decide +kernel
  exact h

theorem next1_fix : ∀ g : H2, (g : Equiv.Perm (Fin 100)) 4 = 4 := by
  apply wordSubgroup_fix_of_gen_fix
  apply allFin
  decide +kernel

