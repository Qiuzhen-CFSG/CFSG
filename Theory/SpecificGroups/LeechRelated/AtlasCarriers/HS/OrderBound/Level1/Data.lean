def stepCheck1 : Fin 17 → Bool :=
  fun i => checkFin (fun r : Fin 22 => checkFin (fun x : Fin 100 => decide
    ((gen1 i * rep1 r) x = (rep1 (act1 i r) * evalWord gen2 (factor1 i r)) x)))

theorem step1_of_check (i : Fin 17) (h : stepCheck1 i = true) :
    ∀ r, gen1 i * rep1 r = rep1 (act1 i r) * evalWord gen2 (factor1 i r) := by
  have hr := allFin (fun r : Fin 22 => checkFin (fun x : Fin 100 => decide
    ((gen1 i * rep1 r) x = (rep1 (act1 i r) * evalWord gen2 (factor1 i r)) x)) = true) (by
      simpa only [stepCheck1, Bool.decide_eq_true] using h)
  intro r
  exact Equiv.ext (allFin _ (hr r))

end Sporadic.LeechRelated.HS.OrderCertificate
