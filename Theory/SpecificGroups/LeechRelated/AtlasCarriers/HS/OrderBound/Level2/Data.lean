def stepCheck2 : Fin 14 → Bool :=
  fun i => checkFin (fun r : Fin 21 => checkFin (fun x : Fin 100 => decide
    ((gen2 i * rep2 r) x = (rep2 (act2 i r) * evalWord gen3 (factor2 i r)) x)))

theorem step2_of_check (i : Fin 14) (h : stepCheck2 i = true) :
    ∀ r, gen2 i * rep2 r = rep2 (act2 i r) * evalWord gen3 (factor2 i r) := by
  have hr := allFin (fun r : Fin 21 => checkFin (fun x : Fin 100 => decide
    ((gen2 i * rep2 r) x = (rep2 (act2 i r) * evalWord gen3 (factor2 i r)) x)) = true) (by
      simpa only [stepCheck2, Bool.decide_eq_true] using h)
  intro r
  exact Equiv.ext (allFin _ (hr r))

end Sporadic.LeechRelated.HS.OrderCertificate
