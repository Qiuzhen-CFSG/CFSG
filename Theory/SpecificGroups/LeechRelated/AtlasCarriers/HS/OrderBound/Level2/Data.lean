module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.OrderBound.Generators
import Mathlib.Tactic.FinCases

/-!
# HS stabilizer level 2: representatives and transition witnesses

Part of the order-divisibility certificate for the exact ATLAS HS carrier.
Source: GLS volume 3, Table 5.3m, printed p.274; ATLAS HSG1-p100B0.
The generator in `OrderBound/source/` supplies witnesses only. Every finite
identity is checked by Lean's kernel.
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.OrderCertificate
open Theory.GroupTheory
set_option maxRecDepth 100000
set_option Elab.async false

def repWord2 (x : Fin 21) : List (Fin 14) :=
  match x.val with
  | 0 => []
  | 1 => [0]
  | 2 => [1]
  | 3 => [2]
  | 4 => [3]
  | 5 => [2, 0]
  | 6 => [3, 0]
  | 7 => [5, 0]
  | 8 => [6, 0]
  | 9 => [7, 0]
  | 10 => [1, 1]
  | 11 => [2, 1]
  | 12 => [4, 1]
  | 13 => [6, 1]
  | 14 => [9, 1]
  | 15 => [12, 1]
  | 16 => [5, 2]
  | 17 => [7, 2]
  | 18 => [12, 2]
  | 19 => [1, 2, 0]
  | _ => [5, 6, 0]

def rep2 : Fin 21 → Equiv.Perm (Fin 100) :=
  fun r => evalWord gen2 (repWord2 r)

def point2 (x : Fin 21) : Fin 100 :=
  match x.val with
  | 0 => 2
  | 1 => 14
  | 2 => 59
  | 3 => 20
  | 4 => 63
  | 5 => 97
  | 6 => 33
  | 7 => 54
  | 8 => 86
  | 9 => 18
  | 10 => 93
  | 11 => 43
  | 12 => 64
  | 13 => 35
  | 14 => 42
  | 15 => 82
  | 16 => 68
  | 17 => 72
  | 18 => 83
  | 19 => 79
  | _ => 25

theorem rep2_mem (r : Fin 21) : rep2 r ∈ H2 := ⟨repWord2 r, rfl⟩

theorem rep2_base : rep2 0 = 1 := rfl

theorem rep2_point : ∀ r, rep2 r 2 = point2 r := by
  apply allFin
  decide +kernel

theorem point2_injective : Function.Injective point2 := by
  have h : ∀ i j : Fin 21, point2 i = point2 j → i = j := by decide +kernel
  exact h

theorem next2_fix : ∀ g : H3, (g : Equiv.Perm (Fin 100)) 2 = 2 := by
  apply wordSubgroup_fix_of_gen_fix
  apply allFin
  decide +kernel

