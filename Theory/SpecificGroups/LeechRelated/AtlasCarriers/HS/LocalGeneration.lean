module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.BlockNormalizer.Concrete
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.EvenLocalCandidates.CentralNormalizerThreePart.PairQuotient
public import Theory.GroupTheory.CharacteristicCentralizerFusion
public import Theory.SpecificGroups.SymmetricFive.AutomorphismRank
public import Theory.SpecificGroups.PSL3Even.AutomorphismTwoRank
public import Theory.GroupTheory.PCoreSurjective

/-!
# An invariant generating pair of HS locals

The exact degree-100 ATLAS carrier is generated by the centralizer of `e0`
and the normalizer of the characteristic elementary eight in its marked
Sylow two-subgroup. Both locals contain that Sylow and are invariant under
every automorphism stabilizing it. For the first local, the unique central
Sylow involution forces `e0` to be fixed; the second invariance follows from
the characteristic elementary-eight calculation.

The first local's checked pair kernel is its intrinsic two-core, because its
actual quotient is S₅ and O₂(S₅) is trivial. The normalizer calculation gives
SL₃(2) for the second quotient. Both are centerless; their full automorphism
groups have two-rank at most two. Consequently these locals support the
rank-two generating cover even after adjoining an ambient two-group.

Sources: Aschbacher–Smith E.1.14(5), printed p.214, A.3.12(18), p.47,
and the local descriptions in I.4.8, p.418; GLS3 Table 5.3m.
The concrete generation, quotient actions and permutation conventions are
proved in the imported exact-carrier extensions. No alternate HS model is used.
-/

public section
open Subgroup
namespace Sporadic.LeechRelated.HS.LocalGeneration
open EvenLocalCandidates BlockNormalizer
open EvenLocalCandidates.CentralInvolutionCore

private theorem e0_order : orderOf e0 = 2 :=
  orderOf_eq_prime_iff.mpr ⟨by simpa [pow_two] using e0_mul, e0_nontrivial⟩

private theorem first_eq_centralizer : localGroup 0 = centralizer ({e0} : Set Carrier) := by
  have he : elementary 0 = zpowers e0 := by
    rw [zpowers_eq_closure]
    unfold elementary
    congr 1
    ext x
    constructor
    · rintro ⟨j, hj, rfl⟩
      have hj0 : j = 0 := Fin.ext (by simpa using hj)
      subst j
      rfl
    · rintro rfl
      exact ⟨0, by simp, rfl⟩
  rw [localGroup, he]
  exact normalizer_zpowers_eq_centralizer_of_order_two e0 e0_order

private theorem baseSylow_le_centralizer : subgroup ≤ centralizer ({e0} : Set Carrier) := by
  apply (closure_le _).mpr
  rintro x ⟨i, rfl⟩
  apply mem_centralizer_singleton_iff.mpr
  apply mul_inv_eq_iff_eq_mul.mp
  have h := baseSylow_conjugation i 0
  fin_cases i <;> exact h

private theorem e0_fixed (β : MulAut Carrier) (hβ : subgroup.map β.toMonoidHom = subgroup) :
    β e0 = e0 := by
  apply MulAut.conj_injective_of_center_eq_bot center_carrier_eq_bot
  apply base_inner_eq_conj_e0
  · rw [← MulAut.congr_conj β, (MulAut.congr β).orderOf_eq]
    exact (orderOf_injective MulAut.conj
      (MulAut.conj_injective_of_center_eq_bot center_carrier_eq_bot) e0).trans e0_order
  · exact ⟨β e0, rfl⟩
  · intro r hr
    have hs : subgroup.map β.symm.toMonoidHom = subgroup := by
      apply map_injective (f := β.toMonoidHom) β.injective
      rw [map_map]
      simpa using hβ.symm
    have hpre : β.symm r ∈ subgroup := hs ▸ mem_map_of_mem β.symm.toMonoidHom hr
    have hc := mem_centralizer_singleton_iff.mp (baseSylow_le_centralizer hpre)
    change β e0 * r * (β e0)⁻¹ = r
    have he := congrArg β (mul_inv_eq_iff_eq_mul.mpr hc.symm)
    simpa using he

/-- The two full normalizers in the fixed permutation carrier. -/
abbrev member (i : Fin 2) : Subgroup Carrier := ![localGroup 0, baseNormalizer] i

/-- Both locals contain the marked Sylow subgroup. -/
theorem sylow_le_member (i : Fin 2) : subgroup ≤ member i := by
  fin_cases i
  · change subgroup ≤ localGroup 0
    rw [first_eq_centralizer]
    exact baseSylow_le_centralizer
  · exact baseSylow_le_normalizer

/-- The actual centralizer and elementary-eight normalizer generate HS. -/
theorem members_sup_eq_top : member 0 ⊔ member 1 = ⊤ := by
  change localGroup 0 ⊔ baseNormalizer = ⊤
  rw [first_eq_centralizer]
  exact centralizer_sup_baseNormalizer_eq_top

/-- Each local is invariant under the full stabilizer of the marked Sylow in Aut(HS). -/
theorem member_invariant (i : Fin 2) (β : MulAut Carrier)
    (hβ : subgroup.map β.toMonoidHom = subgroup) :
    (member i).map β.toMonoidHom = member i := by
  fin_cases i
  · change (localGroup 0).map β.toMonoidHom = localGroup 0
    rw [first_eq_centralizer]
    apply le_antisymm
    · rintro x ⟨y, hy, rfl⟩
      apply mem_centralizer_singleton_iff.mpr
      have h := congrArg β (mem_centralizer_singleton_iff.mp hy)
      simpa only [map_mul, MulEquiv.coe_toMonoidHom, e0_fixed β hβ] using h
    · intro x hx
      refine ⟨β.symm x, ?_, β.apply_symm_apply x⟩
      apply mem_centralizer_singleton_iff.mpr
      apply β.injective
      simpa only [map_mul, β.apply_symm_apply, e0_fixed β hβ] using
        mem_centralizer_singleton_iff.mp hx
  · exact baseNormalizer_invariant β hβ

open Theory.GroupTheory
open EvenLocalCandidates.CentralNormalizerThreePart.PairQuotient

private theorem center_bot_of_equiv {A B : Type*} [Group A] [Group B] [Finite A] [Finite B]
    (e : A ≃* B) (hc : center B = ⊥) : center A = ⊥ := by
  apply Subgroup.card_eq_one.mp
  rw [Nat.card_congr (centerCongr e).toEquiv, hc]
  simp

private theorem linearThree_automorphism_rank :
    primeRank 2 (MulAut Matrix.PSL3Two.SL) ≤ 2 := by
  rw [primeRank_equiv 2 (MulAut.congr Matrix.PSL3Two.equiv)]
  exact (Matrix.PSL3Even.automorphism_two_rank_eq_of_card_two (ZMod 2) (by simp)).le

private theorem first_core_eq : core = pCore 2 (localGroup 0) := by
  have h := fiveHom.comap_pCore_of_ker_isPGroup fiveHom_surjective
    (show IsPGroup 2 fiveHom.ker by rw [fiveHom_kernel]; exact core_isPGroup)
  rwa [Theory.SpecificGroups.SymmetricFive.pCore_two_eq_bot, MonoidHom.comap_bot,
    fiveHom_kernel] at h

attribute [local instance] core_normal

/-- The centralizer modulo its intrinsic two-core is the actual S₅. -/
noncomputable def firstQuotient :
    (localGroup 0 ⧸ pCore 2 (localGroup 0)) ≃* Equiv.Perm (Fin 5) :=
  (QuotientGroup.quotientMulEquivOfEq first_core_eq.symm).trans quotientEquiv

/-- The elementary-eight normalizer modulo its two-core is SL₃(2). -/
noncomputable def secondQuotient :
    (baseNormalizer ⧸ pCore 2 baseNormalizer) ≃* Matrix.PSL3Two.SL :=
  (baseNormalizer_quotient_of_surjective baseNormalizer_action_surjective).some

/-- Both intrinsic two-core quotients are centerless. -/
theorem quotient_center (i : Fin 2) : center (member i ⧸ pCore 2 (member i)) = ⊥ := by
  fin_cases i
  · exact center_bot_of_equiv firstQuotient
      Theory.SpecificGroups.SymmetricFive.center_eq_bot
  · exact center_bot_of_equiv secondQuotient
      Matrix.PSL3Two.center_eq_bot

/-- Full automorphism groups of the local quotients have two-rank at most two. -/
theorem quotient_automorphism_rank (i : Fin 2) :
    primeRank 2 (MulAut (member i ⧸ pCore 2 (member i))) ≤ 2 := by
  fin_cases i
  · change primeRank 2 (MulAut (localGroup 0 ⧸ pCore 2 (localGroup 0))) ≤ 2
    rw [primeRank_equiv 2 (MulAut.congr firstQuotient)]
    exact Theory.SpecificGroups.SymmetricFive.automorphism_primeRank_two_le
  · change primeRank 2 (MulAut (baseNormalizer ⧸ pCore 2 baseNormalizer)) ≤ 2
    rw [primeRank_equiv 2 (MulAut.congr secondQuotient)]
    exact linearThree_automorphism_rank

end Sporadic.LeechRelated.HS.LocalGeneration
