module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.BlockNormalizer.Concrete.Structure
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Normal elementary subgroups of the HS four-group centralizer

The ambient centralizer of the marked four-group is a two-group normalized
by the marked Sylow subgroup, hence lies in it. Among its 512 enumerated
Sylow elements, every element outside the elementary eight either has a
nonidentity square or fails to commute with a conjugate by an element of
this centralizer. The four conjugating words are checked to centralize the
four-group. Consequently its elementary eight is characteristic in the
centralizer, and the normalizer of the four-group preserves that eight.

The exhaustive rejection table is generated by `source/generate.py` from
the attributed degree-100 ATLAS data and checked by the Lean kernel.
Sources: GLS3, Table 5.3m; Aschbacher–Smith, proof of 15.3.43, p.1140.
-/

namespace Sporadic.LeechRelated.HS.RankOneFourNormalizer
open Subgroup EvenLocalCandidates EvenLocalCandidates.SylowCatalogueData BlockNormalizer
set_option maxRecDepth 100000
set_option maxHeartbeats 800000
set_option Elab.async false

private def smallRow : Fin 8 → Fin 512 := ![0, 10, 480, 494, 32, 128, 303, 143]
private def smallCode (i : Fin 512) : Fin 8 :=
  ⟨( >>> (3 * i.val)) % 8, Nat.mod_lt _ (by decide)⟩
private def badPoint (i : Fin 512) : Fin 100 :=
  ⟨( >>> (7 * i.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩
private def actorRow : Fin 4 → Fin 512 := ![0, 2, 5, 12]
private def badActor (i : Fin 512) : Fin 4 :=
  ⟨( >>> (2 * i.val)) % 4, Nat.mod_lt _ (by decide)⟩

private theorem actor_commutes (i : Fin 4) (j : Fin 3) (hj : j ≤ 1) :
    elementaryGenerator j * element (actorRow i) =
      element (actorRow i) * elementaryGenerator j := by
  have h : ∀ (i : Fin 4) (j : Fin 3) (x : Fin 100), j ≤ 1 →
      ((elementaryGenerator j * element (actorRow i) : Carrier) : Equiv.Perm (Fin 100)) x =
      ((element (actorRow i) * elementaryGenerator j : Carrier) : Equiv.Perm (Fin 100)) x := by
    apply allFin₃
    decide +kernel
  exact Subtype.ext (Equiv.ext (fun x => h i j x hj))

private theorem actor_mem (i : Fin 4) :
    element (actorRow i) ∈ centralizer (elementary 1 : Set Carrier) := by
  rw [elementary, centralizer_closure]
  rintro x ⟨j, hj, rfl⟩
  exact actor_commutes i j hj

private theorem smallRow_point : ∀ (j : Fin 8) (x : Fin 100),
    point (smallRow j) x = (small j : Equiv.Perm (Fin 100)) x := by
  apply allFin₂
  decide +kernel

private theorem smallRow_element (j : Fin 8) : element (smallRow j) = small j := by
  apply Subtype.ext
  apply Equiv.ext
  intro x
  rw [element_point]
  exact smallRow_point j x

private theorem rejection : ∀ i : Fin 512,
    i = smallRow (smallCode i) ∨
    point i (point i (badPoint i)) ≠ badPoint i ∨
    point i ((element (actorRow (badActor i)) : Equiv.Perm (Fin 100))
      (point i (((element (actorRow (badActor i)))⁻¹ : Equiv.Perm (Fin 100)) (badPoint i)))) ≠
    (element (actorRow (badActor i)) : Equiv.Perm (Fin 100))
      (point i (((element (actorRow (badActor i)))⁻¹ : Equiv.Perm (Fin 100)) (point i (badPoint i)))) := by
  apply allFin
  decide +kernel

/-- The exhaustive Sylow rejection test, using only conjugators in the four-group centralizer. -/
public theorem small_of_centralizer_normal_element (x : Carrier) (hx : x ∈ subgroup)
    (hsq : x ^ 2 = 1)
    (hc : ∀ g ∈ centralizer (elementary 1 : Set Carrier),
      x * (g * x * g⁻¹) = (g * x * g⁻¹) * x) :
    ∃ j : Fin 8, small j = x := by
  obtain ⟨i, rfl⟩ := element_surjective hx
  rcases rejection i with hi | hsqbad | hcbad
  · exact ⟨smallCode i, (smallRow_element _).symm.trans (congrArg element hi.symm)⟩
  · exfalso
    apply hsqbad
    have he := congrArg (fun g : Carrier => (g : Equiv.Perm (Fin 100)) (badPoint i)) hsq
    change (element i : Equiv.Perm (Fin 100))
      ((element i : Equiv.Perm (Fin 100)) (badPoint i)) = badPoint i at he
    simpa only [element_point] using he
  · exfalso
    apply hcbad
    have he := congrArg (fun g : Carrier => (g : Equiv.Perm (Fin 100)) (badPoint i))
      (hc (element (actorRow (badActor i))) (actor_mem _))
    change (element i : Equiv.Perm (Fin 100))
        ((element (actorRow (badActor i)) : Equiv.Perm (Fin 100))
          ((element i : Equiv.Perm (Fin 100))
            (((element (actorRow (badActor i)))⁻¹ : Equiv.Perm (Fin 100)) (badPoint i)))) =
      (element (actorRow (badActor i)) : Equiv.Perm (Fin 100))
        ((element i : Equiv.Perm (Fin 100))
          (((element (actorRow (badActor i)))⁻¹ : Equiv.Perm (Fin 100))
            ((element i : Equiv.Perm (Fin 100)) (badPoint i)))) at he
    simpa only [element_point] using he

end Sporadic.LeechRelated.HS.RankOneFourNormalizer
