theorem gen_left : ∀ i : Fin 3, ∀ x,
    packedMap (genInvCode i) (packedMap (genCode i) x) = x := by
  apply allFin
  decide +kernel

def gen (i : Fin 3) : Equiv.Perm (Fin 100) :=
