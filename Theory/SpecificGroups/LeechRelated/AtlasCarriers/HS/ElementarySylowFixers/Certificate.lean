theorem candidate_graph_screen : ∀ i,
    (adjacency (candidate i (testPair (indexCode i)).1)
      (candidate i (testPair (indexCode i)).2) ↔
      adjacency (testPair (indexCode i)).1 (testPair (indexCode i)).2) →
    candidate i = 1 ∨ candidate i = (e0 : Equiv.Perm (Fin 100)) := by
  decide +kernel

/-- The graph condition leaves precisely inner permutations in the restriction kernel. -/
theorem centralizer_mem (p : Equiv.Perm (Fin 100)) (hp : ∀ i, Commute p (gen i))
    (hg : p ∈ graphGroup) : p ∈ Sporadic.LeechRelated.HS.generated := by
  obtain ⟨i, rfl⟩ := centralizer_cover p hp
  rcases candidate_graph_screen i ((mem_graphGroup_iff _).mp hg _ _) with he | he
  · rw [he]
    exact Subgroup.one_mem _
  · rw [he]
    exact e0.property

