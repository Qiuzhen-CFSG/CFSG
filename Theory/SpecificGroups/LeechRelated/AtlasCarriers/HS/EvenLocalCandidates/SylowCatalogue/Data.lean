/-- Packed candidate point images of each word. -/
def point (i : Fin 512) (x : Fin 100) : Fin 100 :=
  ⟨(pointBlocks ⟨i.val / 32 % 16, Nat.mod_lt _ (by decide)⟩ >>>
    (7 * (100 * (i.val % 32) + x.val))) % 128 % 100, Nat.mod_lt _ (by decide)⟩

def transitions : Nat := 

/-- Rows reached by left multiplication by a generator or its inverse. -/
def next (j : Fin 6) (i : Fin 512) : Fin 512 :=
  ⟨(transitions >>> (9 * (512 * j.val + i.val))) % 512, Nat.mod_lt _ (by decide)⟩

def decoder : Nat := 

/-- Candidate left inverse from the images of points 1 and 4. -/
def decode (x y : Fin 100) : Nat :=
  (decoder >>> (9 * (100 * x.val + y.val))) % 512

/-- Kernel-friendly finite universal quantification. -/
def checkFin {n : ℕ} (f : Fin n → Bool) : Bool :=
  (List.range n).all (fun i => if h : i < n then f ⟨i, h⟩ else true)

theorem allFin {n : ℕ} (P : Fin n → Prop) [DecidablePred P]
    (h : checkFin (fun i => decide (P i)) = true) : ∀ i, P i := by
  intro i
  have hi := List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt)
  simpa only [dif_pos i.isLt, decide_eq_true_eq] using hi

theorem checkFin_spec {n : ℕ} (f : Fin n → Bool) (h : checkFin f = true) : ∀ i, f i = true := by
  intro i
  have hi := List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt)
  simpa only [dif_pos i.isLt] using hi

theorem allFin₂ {n m : ℕ} (P : Fin n → Fin m → Prop) [∀ i, DecidablePred (P i)]
    (h : checkFin (fun i => checkFin (fun j => decide (P i j))) = true) : ∀ i j, P i j :=
  fun i => allFin _ (checkFin_spec _ h i)

theorem allFin₃ {n m l : ℕ} (P : Fin n → Fin m → Fin l → Prop)
    [∀ i j, DecidablePred (P i j)]
    (h : checkFin (fun i => checkFin (fun j => checkFin (fun k => decide (P i j k)))) = true) :
    ∀ i j k, P i j k :=
  fun i => allFin₂ _ (checkFin_spec _ h i)

end Sporadic.LeechRelated.HS.EvenLocalCandidates.SylowCatalogueData
