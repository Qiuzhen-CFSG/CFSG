module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.EvenLocalCandidates

/-!
# Finite word data for the concrete HS two-subgroup

The 512 rows are words in the three generators of `EvenLocalCandidates.subgroup`.
The packed point maps, generator transitions, and inverse lookup are candidate
computations; their correctness is proved in `Enumeration`. No group structure
or order is assumed for these data.

Source: the fixed degree-100 ATLAS permutations in
`EvenLocalCandidates/source/data.json`; see `source/generate.py` for reproduction.
The application is GLS volume 3, Table 5.3m, and condition E on printed pp.3–4
of Aschbacher–Smith. All permutations use Lean's left action convention.
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.EvenLocalCandidates.SylowCatalogueData

set_option maxRecDepth 100000

def wordData : Nat := 

def decodeWord : Nat → Nat → List (Fin 3)
  | 0, _ => []
  | k + 1, n => if n = 0 then [] else
      ⟨(n % 4 - 1) % 3, Nat.mod_lt _ (by decide)⟩ :: decodeWord k (n / 4)

/-- The fixed word attached to a row. -/
def word (i : Fin 512) : List (Fin 3) :=
  decodeWord 12 ((wordData >>> (24 * i.val)) % 16777216)

/-- Row values in the original carrier, not a replacement group. -/
def element (i : Fin 512) : Carrier :=
  Theory.GroupTheory.evalWord sylowGenerator (word i)

def pointBlocks : Fin 16 → Nat := ![,
