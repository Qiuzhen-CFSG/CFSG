module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.EvenLocalCandidates.LargeElementaryCentralizers
public import Theory.GroupTheory.SmallNonabelianTwoGroupAutomorphismOrderCoarse
public import Mathlib.GroupTheory.Schreier

/-!
# Three-parts of the two larger HS local normalizers

The three elementary candidates are generated by at most three involutions,
so each has order at most eight. Their automorphism orders divide 168 by
counting bases over the binary field. For the two larger candidates the
certified ambient centralizers are two-groups. The kernel of the normalizer
conjugation action is that centralizer, so nine cannot divide the normalizer
order. No exhaustive local catalogue or Sylow-order assumption is used.

Source: GLS volume 3, Table 5.3m, printed p.274; the HS exclusion in
Aschbacher–Smith, Proposition 1.3.4, printed p.511 (PDF p.528).
-/

open Subgroup
open scoped IsMulCommutative
namespace Sporadic.LeechRelated.HS.EvenLocalCandidates

/-- Each actual elementary candidate has order at most eight. -/
public theorem elementary_card_le_eight (i : Fin 3) : Nat.card (elementary i) ≤ 8 := by
  classical
  let _ := elementary_isElementaryAbelian i
  let F : Finset Carrier := (Finset.univ.filter (fun j : Fin 3 => j ≤ i)).image elementaryGenerator
  have hF : closure (F : Set Carrier) = elementary i := by
    simp [F, elementary]
  have hrank : Group.rank (elementary i) ≤ 3 := by
    have h := rank_closure_finset_le_card F
    calc
      Group.rank (elementary i) = Group.rank (closure (F : Set Carrier)) :=
        (Subgroup.rank_congr hF).symm
      _ ≤ F.card := h
      _ ≤ 3 := (Finset.card_image_le.trans (Finset.card_filter_le _ _)).trans (by simp)
  have hd : Nat.card (elementary i) ∣ 2 ^ Group.rank (elementary i) :=
    card_dvd_exponent_pow_rank' (elementary i) (fun x =>
      Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 (elementary i)) x)
  exact (Nat.le_of_dvd (by positivity) hd).trans (Nat.pow_le_pow_right (by decide) hrank)

private theorem small_elementary_aut_card_dvd {E : Type*} [Group E] [Finite E] [IsElementaryAbelian 2 E]
    (hE : Nat.card E ≤ 8) : Nat.card (MulAut E) ∣ 168 := by
  obtain ⟨n, hn⟩ := (IsElementaryAbelian.isPGroup 2 E).exists_card_eq
  have hnle : n ≤ 3 := by
    apply (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp
    simpa only [← hn] using hE
  rw [SmallNonabelianTwoGroup.card_mulAut_elementary_two_pow E n hn]
  interval_cases n <;> norm_num [Fin.prod_univ_succ]

private theorem normalizer_nine_not_dvd {G : Type*} [Group G] [Finite G] (E : Subgroup G)
    (hC : IsPGroup 2 (centralizer (E : Set G)))
    (hA : ¬ 9 ∣ Nat.card (MulAut E)) :
    ¬ 9 ∣ Nat.card (normalizer (E : Set G)) := by
  let f := E.normalizerMonoidHom
  have hk : IsPGroup 2 f.ker := by
    rw [normalizerMonoidHom_ker]
    exact hC.of_equiv
      (subgroupOfEquivOfLe (centralizer_le_normalizer (E : Set G))).symm
  obtain ⟨n, hn⟩ := hk.exists_card_eq
  have hcop : Nat.Coprime 9 (Nat.card f.ker) := by
    rw [hn]
    exact (by decide : Nat.Coprime 9 2).pow_right n
  intro hd
  apply hA
  have hprod := f.ker.card_mul_index
  rw [index_ker] at hprod
  rw [← hprod] at hd
  exact (hcop.dvd_of_dvd_mul_left hd).trans f.range.card_subgroup_dvd_card

/-- The two larger actual local normalizers have three-part at most three. -/
public theorem large_localGroup_nine_not_dvd (i : Fin 3) (hi : i ≠ 0) :
    ¬ 9 ∣ Nat.card (localGroup i) := by
  let _ := elementary_isElementaryAbelian i
  apply normalizer_nine_not_dvd (elementary i)
    (large_elementary_centralizer_isPGroup i hi)
  intro hd
  exact (by decide : ¬ 9 ∣ 168)
    (hd.trans (small_elementary_aut_card_dvd (elementary_card_le_eight i)))

end Sporadic.LeechRelated.HS.EvenLocalCandidates
