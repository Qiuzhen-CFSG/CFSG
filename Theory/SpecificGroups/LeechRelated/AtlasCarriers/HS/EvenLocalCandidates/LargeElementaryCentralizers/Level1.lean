/-!
# Centralizer search, residual level 1

Finite witnesses for the centralizer of the first two HS elementary generators.
The existing HS order certificate supplies a stabilizer chain. Orbit colors
of its residual groups restrict each successive representative. All finite
identities are checked by Lean's kernel; the generator supplies no trusted facts.

Source: ATLAS HSG1-p100B0; GLS volume 3, Table 5.3m, printed p.274;
Aschbacher–Smith, condition E, printed pp.3–4.
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.EvenLocalCandidates.LargeElementaryCentralizers
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option Elab.async false

def color1 (x : Fin 100) : Nat :=
  (41418392925577745862419088953836031128631004128342899271956265149142926051163498089240484839572999360774192165443225751715459671895288617203655387591727665591682913439639858561399814930559449919003490529591424 >>> (7 * x.val)) % 128

def base1 : List (Fin 100) := [0]

theorem residual1_spec {h : Perm} (hh : h ∈ H1) :
    (∀ b ∈ base1, h b = b) ∧ (∀ x, color1 (h x) = color1 x) := by
  exact word_properties gen1 inv1 inv1_spec color1 base1
    (by apply allFin; decide +kernel) hh

