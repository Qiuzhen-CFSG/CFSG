module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.GeneratorPair
public import Theory.GroupTheory.WordSubgroup
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.GroupTheory.SpecificGroups.Alternating
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Marked subgroups for the concrete Hall–Janko recognition graph

All elements below are words in the exact ATLAS degree-100 carrier. The
vertex generator is the fourth power of the standard commutator word; the
other vertex is its conjugate by `b⁻¹*a*b`. The dihedral candidate is fixed
by two further words, and the local group is its literal full centralizer.
The order-three claims are proved here. The adjacency, dihedral structure,
and local identifications are proved separately, not assumed in the definitions.

Source: Aschbacher, *Sporadic Groups* (1994), 47.3, 47.5 and 47.10,
pp.261–267. ATLAS J2G1-p100B0 provenance is retained in
`AtlasCarriers/source/`; `source/` here records the marking discovery.
-/

@[expose] public section
namespace Sporadic.LeechRelated.J2.RecognitionGeometry
open Subgroup GeneratorPair Theory.GroupTheory

/-- The marked order-three element, centralizing the first parabolic involution. -/
def x : Carrier := (a * b * a * b⁻¹) ^ 4

def X : Subgroup Carrier := zpowers x

/-- The short involution conjugating the two distinguished vertices. -/
def conjugator : Carrier := b⁻¹ * a * b

def y : Carrier := MulAut.conj conjugator x

def Y : Subgroup Carrier := zpowers y

/-- The literal vertex normalizer. -/
def M : Subgroup Carrier := normalizer (X : Set Carrier)

/-- The literal pointwise edge fixer. -/
def E : Subgroup Carrier := M ⊓ normalizer (Y : Set Carrier)

/-- The marked reversal in the group generated by the endpoints. -/
def t : Carrier := x * (x * y⁻¹) * x⁻¹

theorem x_cube : x ^ 3 = 1 := by
  simpa only [x, ← pow_mul] using comm_word_pow_twelve

theorem x_ne_one : x ≠ 1 := comm_word_pow_four_ne

theorem orderOf_x : orderOf x = 3 := orderOf_eq_prime x_cube x_ne_one

theorem card_X : Nat.card X = 3 := by
  rw [X, Nat.card_zpowers, orderOf_x]

theorem Y_eq_map : Y = X.map (MulAut.conj conjugator).toMonoidHom := by
  exact (MonoidHom.map_zpowers (MulAut.conj conjugator).toMonoidHom x).symm

theorem card_Y : Nat.card Y = 3 := by
  rw [Y_eq_map]
  exact (card_map_of_injective (K := X)
    (f := (MulAut.conj conjugator).toMonoidHom) (MulAut.conj conjugator).injective).trans card_X

def rotationWord : List (Fin 3) := [2, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 1, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 2, 0, 2, 0, 1, 0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 2, 0, 2, 0, 1, 0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0, 2, 0, 2, 0, 2, 0, 1, 0, 1, 0, 2, 0, 2, 0, 1, 0]

def rotation : Carrier := evalWord ![a, b, b⁻¹] rotationWord

def reflectionWord : List (Fin 3) := [0, 1, 0, 2, 0, 1, 0, 2, 0, 1, 0, 1, 0, 2, 0, 2, 0, 2, 0, 2, 0, 1, 0, 1, 0, 2, 0, 1, 0, 2]

def reflection : Carrier := evalWord ![a, b, b⁻¹] reflectionWord

/-- The fixed two-generator subgroup used for the dihedral marking. -/
def B : Subgroup Carrier := zpowers rotation ⊔ zpowers reflection

/-- The local group of 47.10 is the full centralizer of the marked subgroup. -/
def K : Subgroup Carrier := centralizer (B : Set Carrier)

end Sporadic.LeechRelated.J2.RecognitionGeometry
