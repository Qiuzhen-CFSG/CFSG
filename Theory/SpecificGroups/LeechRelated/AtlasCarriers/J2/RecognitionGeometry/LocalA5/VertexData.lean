  | 19 => 341511904760246058467864756352257536319268886906811015337758229686978923857433592186374600626665712571308238158821540776889561366764018428352224103560262721939277449257850800570126136881843707968161959019637586
  | 21 => 4100094770554042515533122004313285236735003534074830538881045787921142082201184208296423565880205964959118971074454247199955378650214568923506906026203450061729621922836307612900092799561144844784840892852764800
  | _ => 0

def value (p : Equiv.Perm (Fin 3)) : Fin 100 → Fin 100 := LocalIndexed.unpack (row p)

def letterValue (j : Fin 2) : Fin 100 → Fin 100 :=
  LocalIndexed.letterValue (if j.val = 0 then 0 else 2)

def wordValue : List (Fin 2) → Fin 100 → Fin 100
  | [], i => i
  | j :: w, i => letterValue j (wordValue w i)

def modelX : Equiv.Perm (Fin 3) :=
  tablePerm ![1, 2, 0] ![2, 0, 1] (by decide) (by decide)

def modelS : Equiv.Perm (Fin 3) :=
  tablePerm ![1, 0, 2] ![1, 0, 2] (by decide) (by decide)

def model : Fin 2 → Equiv.Perm (Fin 3) := ![modelX, modelS]

end Sporadic.LeechRelated.J2.RecognitionGeometry.LocalA5.VertexData
