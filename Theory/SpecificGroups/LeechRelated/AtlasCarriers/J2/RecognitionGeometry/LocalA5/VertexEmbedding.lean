module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.VertexData
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.Elements
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.LocalChecks
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.WordEmbedding
import Mathlib.Tactic.FinCases

/-!
# The marked symmetric subgroup on three letters

The two model generators map to the fixed endpoint generator and inverter.
Checked scalar word tables prove the homomorphism and injectivity; its range
is the literal subgroup generated by these elements. The full intersection
identification is proved separately by filtering the local A₅.
Source: Aschbacher, *Sporadic Groups*, 47.10, pp.266–267.
-/

public section
namespace Sporadic.LeechRelated.J2.RecognitionGeometry.LocalA5
open Subgroup Theory.GroupTheory VertexData

private def letters : Fin 2 → Carrier := ![x, inverter]

private theorem letterValue_eq (j : Fin 2) (i : Fin 100) :
    letterValue j i = inclusion (letters j) i := by
  fin_cases j
  · exact (LocalChecks.letterValue_eq 0 i).trans (congrArg (fun p => p i) inclusion_x.symm)
  · exact (LocalChecks.letterValue_eq 2 i).trans (congrArg (fun p => p i) inclusion_inverter.symm)

private theorem wordValue_eq (w : List (Fin 2)) (i : Fin 100) :
    wordValue w i = inclusion (evalWord letters w) i := by
  induction w with
  | nil => rfl
  | cons j w ih =>
    rw [wordValue, ih, letterValue_eq, evalWord, map_mul, Equiv.Perm.mul_apply]

private theorem words_checked : ∀ (p : Equiv.Perm (Fin 3)) (i : Fin 100),
    wordValue (word p) i = value p i := by decide +kernel

private theorem steps_checked : ∀ (j : Fin 2) (p : Equiv.Perm (Fin 3)) (i : Fin 100),
    value (model j * p) i = letterValue j (value p i) := by decide +kernel

private def element (p : Equiv.Perm (Fin 3)) : Carrier := evalWord letters (word p)

private theorem element_value (p : Equiv.Perm (Fin 3)) (i : Fin 100) :
    inclusion (element p) i = value p i :=
  (wordValue_eq (word p) i).symm.trans (words_checked p i)

/-- A marked embedding of S₃ into the concrete carrier. -/
def vertexHom : Equiv.Perm (Fin 3) →* Carrier :=
  homOfWordTransitions model letters word element (by decide +kernel) (by rfl) (by
    intro j p
    apply inclusion_injective
    apply Equiv.ext
    intro i
    rw [map_mul]
    change inclusion (element (model j * p)) i =
      inclusion (letters j) (inclusion (element p) i)
    rw [element_value, element_value, ← letterValue_eq]
    exact steps_checked j p i)

theorem vertexHom_value (p : Equiv.Perm (Fin 3)) (i : Fin 100) :
    inclusion (vertexHom p) i = value p i := element_value p i

theorem vertexHom_injective : Function.Injective vertexHom := by
  have h : Function.Injective (fun p : Equiv.Perm (Fin 3) => (value p 0, value p 1)) := by
    decide +kernel
  intro p q hpq
  apply h
  exact Prod.ext
    (by simpa only [vertexHom_value] using congrArg (fun g => inclusion g 0) hpq)
    (by simpa only [vertexHom_value] using congrArg (fun g => inclusion g 1) hpq)

theorem vertexHom_modelX : vertexHom modelX = x := by change x * 1 = x; exact mul_one _
theorem vertexHom_modelS : vertexHom modelS = inverter := by
  change inverter * 1 = inverter; exact mul_one _

theorem vertexHom_range : vertexHom.range = vertexCandidate := by
  apply le_antisymm
  · rintro _ ⟨p, rfl⟩
    change evalWord letters (word p) ∈ vertexCandidate
    have hw (w : List (Fin 2)) : evalWord letters w ∈ vertexCandidate := by
      induction w with
      | nil => exact vertexCandidate.one_mem
      | cons j w ih =>
        apply vertexCandidate.mul_mem _ ih
        fin_cases j
        · exact mem_sup_left (mem_zpowers x)
        · exact mem_sup_right (mem_zpowers inverter)
    exact hw _
  · exact sup_le (zpowers_le.mpr ⟨modelX, vertexHom_modelX⟩)
      (zpowers_le.mpr ⟨modelS, vertexHom_modelS⟩)

noncomputable def vertexCandidateEquiv : vertexCandidate ≃* Equiv.Perm (Fin 3) :=
  ((MonoidHom.ofInjective vertexHom_injective).trans
    (MulEquiv.subgroupCongr vertexHom_range)).symm

/-- The inverse is the actual checked word embedding, after subgroup inclusion. -/
theorem vertexCandidateEquiv_symm_coe (p : Equiv.Perm (Fin 3)) :
    (vertexCandidateEquiv.symm p : Carrier) = vertexHom p := by rfl

theorem card_vertexCandidate : Nat.card vertexCandidate = 6 := by
  rw [Nat.card_congr vertexCandidateEquiv.toEquiv, Nat.card_perm, Nat.card_fin]
  decide

end Sporadic.LeechRelated.J2.RecognitionGeometry.LocalA5
