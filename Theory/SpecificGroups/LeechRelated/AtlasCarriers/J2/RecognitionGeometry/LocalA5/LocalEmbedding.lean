module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.Elements
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.WordEmbedding
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.LocalChecks
import Mathlib.Tactic.FinCases

/-!
# The explicit local A₅ embedding

The chosen words are checked against their degree-100 tables, and left
multiplication by each generator is checked on the certified sixty-element
A₅ enumeration. Word induction supplies the full multiplication law.
Evaluation on the actual letters 0 and 1 proves injectivity. The range is the
literal subgroup generated by the marked words, without a coverage assumption.
Source: Aschbacher, *Sporadic Groups*, 47.5 and 47.10, pp.263, 266–267;
ATLAS J2G1-p100B0 and the candidate reproduction script in `source/`.
-/

public section
namespace Sporadic.LeechRelated.J2.RecognitionGeometry.LocalA5
open Subgroup Theory.GroupTheory
open Sporadic.LeechRelated.J2.RecognitionGeometry.LocalA5.LocalData
open InnerInvolutionCores.NoncentralData
open GeneratorPair.SecondOrbitCertificate

set_option Elab.async false

private def letters : Fin 3 → Carrier := ![x, y, inverter]

private theorem letters_inclusion (i : Fin 3) : inclusion (letters i) = table i := by
  fin_cases i
  · exact inclusion_x
  · exact inclusion_y
  · exact inclusion_inverter

private theorem words_checked (p : alternatingGroup (Fin 5)) (i : Fin 100) :
    evalWord table (word p) i = value p i := by
  obtain ⟨j, rfl⟩ := simpleEquiv.surjective p
  change evalWord table (word (simpleEnum j)) i = value (simpleEnum j) i
  rw [LocalChecks.word_eq, LocalChecks.value_eq, ← LocalChecks.wordValue_eq]
  exact LocalChecks.words_checked j i

private theorem steps_checked (s : Fin 3) (p : alternatingGroup (Fin 5)) (i : Fin 100) :
    value (model s * p) i = table s (value p i) := by
  obtain ⟨j, rfl⟩ := simpleEquiv.surjective p
  change value (model s * simpleEnum j) i = table s (value (simpleEnum j) i)
  rw [LocalChecks.model_step, LocalChecks.value_eq, LocalChecks.value_eq,
    ← LocalChecks.letterValue_eq]
  exact LocalChecks.steps_checked s j i

private theorem model_words (p : alternatingGroup (Fin 5)) : evalWord model (word p) = p := by
  obtain ⟨j, rfl⟩ := simpleEquiv.surjective p
  change evalWord model (word (simpleEnum j)) = simpleEnum j
  rw [LocalChecks.word_eq]
  exact LocalChecks.model_words j

private def element (p : alternatingGroup (Fin 5)) : Carrier := evalWord letters (word p)

private theorem element_value (p : alternatingGroup (Fin 5)) (i : Fin 100) :
    inclusion (element p) i = value p i := by
  have hw (w : List (Fin 3)) :
      inclusion (evalWord letters w) = evalWord table w := by
    induction w with
    | nil => rfl
    | cons j w ih => rw [evalWord, map_mul, ih, letters_inclusion, evalWord]
  rw [element, hw]
  exact words_checked p i

/-- The word-defined embedding of the genuine alternating group. -/
def localHom : alternatingGroup (Fin 5) →* Carrier :=
  homOfWordTransitions model letters word element model_words (by rfl) (by
    intro s p
    apply inclusion_injective
    apply Equiv.ext
    intro i
    rw [map_mul]
    change inclusion (element (model s * p)) i =
      inclusion (letters s) (inclusion (element p) i)
    rw [element_value, letters_inclusion, element_value]
    exact steps_checked s p i)

theorem localHom_value (p : alternatingGroup (Fin 5)) (i : Fin 100) :
    inclusion (localHom p) i = value p i := element_value p i

theorem localHom_injective : Function.Injective localHom := by
  intro p q hpq
  obtain ⟨i, rfl⟩ := simpleEquiv.surjective p
  obtain ⟨j, rfl⟩ := simpleEquiv.surjective q
  apply congrArg simpleEquiv
  apply LocalChecks.pair_injective
  · have h := congrArg (fun g => inclusion g 0) hpq
    change inclusion (localHom (simpleEnum i)) _ = inclusion (localHom (simpleEnum j)) _ at h
    simpa only [localHom_value, LocalChecks.value_eq] using h
  · have h := congrArg (fun g => inclusion g 1) hpq
    change inclusion (localHom (simpleEnum i)) _ = inclusion (localHom (simpleEnum j)) _ at h
    simpa only [localHom_value, LocalChecks.value_eq] using h

theorem localHom_model0 : localHom model0 = x := by
  change x * 1 = x
  exact mul_one _

theorem localHom_model1 : localHom model1 = y := by
  change y * 1 = y
  exact mul_one _

theorem localHom_model2 : localHom model2 = inverter := by
  change inverter * 1 = inverter
  exact mul_one _

theorem localHom_range : localHom.range = localCandidate := by
  apply le_antisymm
  · rintro _ ⟨p, rfl⟩
    change evalWord letters (word p) ∈ localCandidate
    have hw (w : List (Fin 3)) : evalWord letters w ∈ localCandidate := by
      induction w with
      | nil => exact localCandidate.one_mem
      | cons i w ih =>
        apply localCandidate.mul_mem _ ih
        fin_cases i
        · exact mem_sup_left (mem_sup_left (mem_zpowers x))
        · exact mem_sup_left (mem_sup_right (mem_zpowers y))
        · exact mem_sup_right (mem_zpowers inverter)
    exact hw _
  · apply sup_le
    · apply sup_le
      · exact zpowers_le.mpr ⟨model0, localHom_model0⟩
      · exact zpowers_le.mpr ⟨model1, localHom_model1⟩
    · exact zpowers_le.mpr ⟨model2, localHom_model2⟩

/-- The isomorphism on the literal word-generated candidate. -/
noncomputable def localCandidateEquiv : localCandidate ≃* alternatingGroup (Fin 5) :=
  ((MonoidHom.ofInjective localHom_injective).trans
    (MulEquiv.subgroupCongr localHom_range)).symm

/-- The inverse is the actual checked word embedding, after subgroup inclusion. -/
theorem localCandidateEquiv_symm_coe (p : alternatingGroup (Fin 5)) :
    (localCandidateEquiv.symm p : Carrier) = localHom p := by rfl

theorem card_localCandidate : Nat.card localCandidate = 60 := by
  rw [Nat.card_congr localCandidateEquiv.toEquiv, nat_card_alternatingGroup, Nat.card_fin]
  decide

end Sporadic.LeechRelated.J2.RecognitionGeometry.LocalA5
