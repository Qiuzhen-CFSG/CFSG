module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.Elements
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.WordEmbedding
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.LocalA5.EdgeChecks
import Mathlib.Tactic.FinCases

/-!
# The explicit edge A₅ embedding

The chosen words are checked against their degree-100 tables, and left
multiplication by each generator is checked on the certified sixty-element
A₅ enumeration. Word induction supplies the full multiplication law.
Evaluation on the actual letters 0 and 1 proves injectivity. The range is the
literal subgroup generated by the marked words, without a coverage assumption.
Source: Aschbacher, *Sporadic Groups*, 47.5 and 47.10, pp.263, 266–267;
ATLAS J2G1-p100B0 and the candidate reproduction script in `source/`.
-/

public section
namespace Sporadic.LeechRelated.J2.RecognitionGeometry.LocalA5
open Subgroup Theory.GroupTheory
open Sporadic.LeechRelated.J2.RecognitionGeometry.LocalA5.EdgeData
open InnerInvolutionCores.NoncentralData
open GeneratorPair.SecondOrbitCertificate

set_option Elab.async false

private def letters : Fin 2 → Carrier := ![rotation, edgeExtra]

private theorem letters_inclusion (i : Fin 2) : inclusion (letters i) = table i := by
  fin_cases i
  · exact inclusion_rotation
  · exact inclusion_edgeExtra

private theorem words_checked (p : alternatingGroup (Fin 5)) (i : Fin 100) :
    evalWord table (word p) i = value p i := by
  obtain ⟨j, rfl⟩ := simpleEquiv.surjective p
  change evalWord table (word (simpleEnum j)) i = value (simpleEnum j) i
  rw [EdgeChecks.word_eq, EdgeChecks.value_eq, ← EdgeChecks.wordValue_eq]
  exact EdgeChecks.words_checked j i

private theorem steps_checked (s : Fin 2) (p : alternatingGroup (Fin 5)) (i : Fin 100) :
    value (model s * p) i = table s (value p i) := by
  obtain ⟨j, rfl⟩ := simpleEquiv.surjective p
  change value (model s * simpleEnum j) i = table s (value (simpleEnum j) i)
  rw [EdgeChecks.model_step, EdgeChecks.value_eq, EdgeChecks.value_eq,
    ← EdgeChecks.letterValue_eq]
  exact EdgeChecks.steps_checked s j i

private theorem model_words (p : alternatingGroup (Fin 5)) : evalWord model (word p) = p := by
  obtain ⟨j, rfl⟩ := simpleEquiv.surjective p
  change evalWord model (word (simpleEnum j)) = simpleEnum j
  rw [EdgeChecks.word_eq]
  exact EdgeChecks.model_words j

private def element (p : alternatingGroup (Fin 5)) : Carrier := evalWord letters (word p)

private theorem element_value (p : alternatingGroup (Fin 5)) (i : Fin 100) :
    inclusion (element p) i = value p i := by
  have hw (w : List (Fin 2)) :
      inclusion (evalWord letters w) = evalWord table w := by
    induction w with
    | nil => rfl
    | cons j w ih => rw [evalWord, map_mul, ih, letters_inclusion, evalWord]
  rw [element, hw]
  exact words_checked p i

/-- The word-defined embedding of the genuine alternating group. -/
def edgeHom : alternatingGroup (Fin 5) →* Carrier :=
  homOfWordTransitions model letters word element model_words (by rfl) (by
    intro s p
    apply inclusion_injective
    apply Equiv.ext
    intro i
    rw [map_mul]
    change inclusion (element (model s * p)) i =
      inclusion (letters s) (inclusion (element p) i)
    rw [element_value, letters_inclusion, element_value]
    exact steps_checked s p i)

theorem edgeHom_value (p : alternatingGroup (Fin 5)) (i : Fin 100) :
    inclusion (edgeHom p) i = value p i := element_value p i

theorem edgeHom_injective : Function.Injective edgeHom := by
  intro p q hpq
  obtain ⟨i, rfl⟩ := simpleEquiv.surjective p
  obtain ⟨j, rfl⟩ := simpleEquiv.surjective q
  apply congrArg simpleEquiv
  apply EdgeChecks.pair_injective
  · have h := congrArg (fun g => inclusion g 0) hpq
    change inclusion (edgeHom (simpleEnum i)) _ = inclusion (edgeHom (simpleEnum j)) _ at h
    simpa only [edgeHom_value, EdgeChecks.value_eq] using h
  · have h := congrArg (fun g => inclusion g 1) hpq
    change inclusion (edgeHom (simpleEnum i)) _ = inclusion (edgeHom (simpleEnum j)) _ at h
    simpa only [edgeHom_value, EdgeChecks.value_eq] using h

theorem edgeHom_model0 : edgeHom model0 = rotation := by
  change rotation * 1 = rotation
  exact mul_one _

theorem edgeHom_model1 : edgeHom model1 = edgeExtra := by
  change edgeExtra * 1 = edgeExtra
  exact mul_one _

theorem edgeHom_range : edgeHom.range = edgeCandidate := by
  apply le_antisymm
  · rintro _ ⟨p, rfl⟩
    change evalWord letters (word p) ∈ edgeCandidate
    have hw (w : List (Fin 2)) : evalWord letters w ∈ edgeCandidate := by
      induction w with
      | nil => exact edgeCandidate.one_mem
      | cons i w ih =>
        apply edgeCandidate.mul_mem _ ih
        fin_cases i
        · exact mem_sup_left (mem_zpowers rotation)
        · exact mem_sup_right (mem_zpowers edgeExtra)
    exact hw _
  · apply sup_le
    · exact zpowers_le.mpr ⟨model0, edgeHom_model0⟩
    · exact zpowers_le.mpr ⟨model1, edgeHom_model1⟩

/-- The isomorphism on the literal word-generated candidate. -/
noncomputable def edgeCandidateEquiv : edgeCandidate ≃* alternatingGroup (Fin 5) :=
  ((MonoidHom.ofInjective edgeHom_injective).trans
    (MulEquiv.subgroupCongr edgeHom_range)).symm

/-- The inverse is the actual checked word embedding, after subgroup inclusion. -/
theorem edgeCandidateEquiv_symm_coe (p : alternatingGroup (Fin 5)) :
    (edgeCandidateEquiv.symm p : Carrier) = edgeHom p := by rfl

theorem card_edgeCandidate : Nat.card edgeCandidate = 60 := by
  rw [Nat.card_congr edgeCandidateEquiv.toEquiv, nat_card_alternatingGroup, Nat.card_fin]
  decide

end Sporadic.LeechRelated.J2.RecognitionGeometry.LocalA5
