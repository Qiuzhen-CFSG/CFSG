module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.VertexExtension.Basic
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.VertexExtension.Eight
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.VertexExtension.CentralCover
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.VertexExtension.ProjectiveComparison

/-!
# Marked structure at the concrete J₂ vertex

For the published order-three subgroup X, let C be its full centralizer and
M its full normalizer. Under |M| = 2160, the ten-point action and central
commutator prove that C is a perfect central cover of A₆ with center X.
The involutory ATLAS splitter and the order-eight quotient element identify
M/X with the genuine PGL₂ over the fixed nine-element field.

This module assembles those two proofs, discharging the perfectness and
central-quotient inputs of the projective comparison. The A₆ coordinates
are adjusted to make the actual inclusion C/X → M/X commute with the
standard PSL₂(9) inclusion. Both surjections, their literal marked kernels,
the quotient-map diagram and conjugation by the splitter are retained.
The re-exported `splitting` is the actual isomorphism C ⋊ S ≃ M, where
S is generated by the standard ATLAS involution. X is central in C and
is inverted by that involution in M.

Source: Aschbacher, *Sporadic Groups* (1994), 47.3(1) and the vertex
extension used in 47.10, pp.261–267. The only remaining input is the
permitted |M| = 2160; its concrete orbit calculation and the full graph
uniqueness assembly belong to the recognition-system consumer.
-/

@[expose] public section
namespace Sporadic.LeechRelated.J2.RecognitionGeometry.VertexExtension
open Subgroup Atlas.Comparisons.Exceptional GorensteinWalter

/-- The full vertex quotient, with all structural comparison inputs proved. -/
noncomputable def vertexQuotientEquivPGL2Nine (hM : Nat.card M = 2160) :
    VertexQuotient ≃* PGL2 Nine.F :=
  (vertexQuotient_equiv_pgl2 (centralQuotientEquivAlt6 hM) (C_isPerfect hM)).some

/-- A₆ coordinates chosen compatibly with the full vertex comparison. -/
noncomputable def compatibleCentralQuotientEquivAlt6 (hM : Nat.card M = 2160) :
    CentralQuotient ≃* alternatingGroup (Fin 6) :=
  compatibleCentralEquiv (centralQuotientEquivAlt6 hM) (C_isPerfect hM)
    (vertexQuotientEquivPGL2Nine hM)

/-- The comparison commutes with the actual inclusion of the marked quotients. -/
theorem markedComparison_commutes (hM : Nat.card M = 2160) (q : CentralQuotient) :
    vertexQuotientEquivPGL2Nine hM (quotientInclusion q) =
      Matrix.ProjectiveSpecialLinearGroup.toPGL
        (psl2NineCoordinatesEquivAlt6.symm (compatibleCentralQuotientEquivAlt6 hM q)) :=
  compatibleCentralEquiv_commutes (centralQuotientEquivAlt6 hM) (C_isPerfect hM)
    (vertexQuotientEquivPGL2Nine hM) q

/-- The full normalizer surjects onto the genuine projective linear group. -/
noncomputable def vertexCoverHom (hM : Nat.card M = 2160) : M →* PGL2 Nine.F :=
  (vertexQuotientEquivPGL2Nine hM).toMonoidHom.comp vertexQuotientMap

theorem vertexCoverHom_surjective (hM : Nat.card M = 2160) :
    Function.Surjective (vertexCoverHom hM) :=
  (vertexQuotientEquivPGL2Nine hM).surjective.comp (QuotientGroup.mk'_surjective XM)

theorem vertexCoverHom_ker (hM : Nat.card M = 2160) : (vertexCoverHom hM).ker = XM := by
  ext m
  change vertexQuotientEquivPGL2Nine hM (vertexQuotientMap m) = 1 ↔ m ∈ XM
  rw [← (vertexQuotientEquivPGL2Nine hM).map_one,
    (vertexQuotientEquivPGL2Nine hM).injective.eq_iff]
  exact QuotientGroup.eq_one_iff _

/-- The central-cover surjection in the compatible A₆ coordinates. -/
noncomputable def compatibleCentralCoverHom (hM : Nat.card M = 2160) :
    C →* alternatingGroup (Fin 6) :=
  (compatibleCentralQuotientEquivAlt6 hM).toMonoidHom.comp centralQuotientMap

theorem compatibleCentralCoverHom_surjective (hM : Nat.card M = 2160) :
    Function.Surjective (compatibleCentralCoverHom hM) :=
  (compatibleCentralQuotientEquivAlt6 hM).surjective.comp (QuotientGroup.mk'_surjective XC)

theorem compatibleCentralCoverHom_ker (hM : Nat.card M = 2160) :
    (compatibleCentralCoverHom hM).ker = XC := by
  ext c
  change compatibleCentralQuotientEquivAlt6 hM (centralQuotientMap c) = 1 ↔ c ∈ XC
  rw [← (compatibleCentralQuotientEquivAlt6 hM).map_one,
    (compatibleCentralQuotientEquivAlt6 hM).injective.eq_iff]
  exact QuotientGroup.eq_one_iff _

/-- Compatibility before passage to quotient representatives. -/
theorem markedComparison_quotient_maps (hM : Nat.card M = 2160) (c : C) :
    vertexCoverHom hM (centralInclusion c) = Matrix.ProjectiveSpecialLinearGroup.toPGL
      (psl2NineCoordinatesEquivAlt6.symm (compatibleCentralCoverHom hM c)) :=
  markedComparison_commutes hM (centralQuotientMap c)

/-- Conjugation by every element of the literal normalizer is respected. -/
theorem markedComparison_conjugation (hM : Nat.card M = 2160) (m : M) (c : C) :
    vertexCoverHom hM m * Matrix.ProjectiveSpecialLinearGroup.toPGL
        (psl2NineCoordinatesEquivAlt6.symm (compatibleCentralCoverHom hM c)) *
        (vertexCoverHom hM m)⁻¹ =
      Matrix.ProjectiveSpecialLinearGroup.toPGL
        (psl2NineCoordinatesEquivAlt6.symm
          (compatibleCentralCoverHom hM (normalizerCentralAction m c))) := by
  rw [← markedComparison_quotient_maps, ← markedComparison_quotient_maps,
    ← map_inv, ← map_mul, ← map_mul]
  apply congrArg (vertexCoverHom hM)
  apply Subtype.ext
  rfl

/-- The actual splitter remains an involution modulo the marked subgroup. -/
theorem orderOf_splitterQuotient : orderOf (vertexQuotientMap splitterM) = 2 := by
  apply orderOf_eq_prime
  · rw [← map_pow, show splitterM ^ 2 = 1 from Subtype.ext splitter_square, map_one]
  · intro h
    exact splitter_not_mem_C (X_le_C ((QuotientGroup.eq_one_iff splitterM).mp h))

theorem splitterQuotient_not_mem_inclusion_range :
    vertexQuotientMap splitterM ∉ quotientInclusion.range := by
  rintro ⟨q, hq⟩
  obtain ⟨c, rfl⟩ := QuotientGroup.mk'_surjective XC q
  change vertexQuotientMap (centralInclusion c) = vertexQuotientMap splitterM at hq
  have hx : (centralInclusion c)⁻¹ * splitterM ∈ XM := QuotientGroup.eq.mp hq
  change (c : Carrier)⁻¹ * splitter ∈ X at hx
  apply splitter_not_mem_C
  have hc := C.mul_mem c.property (X_le_C hx)
  simpa only [mul_inv_cancel_left] using hc

/-- The marked projective involution is the image of the ATLAS splitter. -/
noncomputable def projectiveSplitter (hM : Nat.card M = 2160) : PGL2 Nine.F :=
  vertexCoverHom hM splitterM

theorem orderOf_projectiveSplitter (hM : Nat.card M = 2160) :
    orderOf (projectiveSplitter hM) = 2 :=
  ((vertexQuotientEquivPGL2Nine hM).orderOf_eq _).trans orderOf_splitterQuotient

/-- The literal complement acts outside the canonical PSL₂ subgroup. -/
theorem projectiveSplitter_not_mem_psl2 (hM : Nat.card M = 2160) :
    projectiveSplitter hM ∉
      (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := Nine.F)).range := by
  intro h
  rw [← projectiveComparison_range (centralQuotientEquivAlt6 hM) (C_isPerfect hM)
    (vertexQuotientEquivPGL2Nine hM)] at h
  obtain ⟨q, hq⟩ := h
  exact splitterQuotient_not_mem_inclusion_range
    ⟨q, (vertexQuotientEquivPGL2Nine hM).injective hq⟩

/-- The marked splitting's conjugation action in the compatible model. -/
theorem projectiveSplitter_action (hM : Nat.card M = 2160) (c : C) :
    projectiveSplitter hM * Matrix.ProjectiveSpecialLinearGroup.toPGL
        (psl2NineCoordinatesEquivAlt6.symm (compatibleCentralCoverHom hM c)) *
        (projectiveSplitter hM)⁻¹ =
      Matrix.ProjectiveSpecialLinearGroup.toPGL
        (psl2NineCoordinatesEquivAlt6.symm
          (compatibleCentralCoverHom hM (splitterAction c))) :=
  markedComparison_conjugation hM splitterM c

/-- The marked vertex extension used in 47.10, under only the permitted
normalizer-order input. The equivalences and splitting have the actual
inclusions and conjugation formulas proved above and in `Basic`. -/
theorem marked_vertex_extension (hM : Nat.card M = 2160) :
    Theory.GroupTheory.IsQuasisimple C ∧ center C = XC ∧
      (center C).map C.subtype = X ∧ CM.IsComplement' S ∧ Nat.card S = 2 ∧
      ∃ (eC : CentralQuotient ≃* alternatingGroup (Fin 6))
        (eM : VertexQuotient ≃* PGL2 Nine.F),
        (∀ q, eM (quotientInclusion q) = Matrix.ProjectiveSpecialLinearGroup.toPGL
          (psl2NineCoordinatesEquivAlt6.symm (eC q))) ∧
        (∀ c : C, eM (vertexQuotientMap splitterM) *
            Matrix.ProjectiveSpecialLinearGroup.toPGL
              (psl2NineCoordinatesEquivAlt6.symm (eC (centralQuotientMap c))) *
            (eM (vertexQuotientMap splitterM))⁻¹ =
          Matrix.ProjectiveSpecialLinearGroup.toPGL
            (psl2NineCoordinatesEquivAlt6.symm
              (eC (centralQuotientMap (splitterAction c))))) :=
  ⟨C_isQuasisimple hM, center_C_eq_XC hM, map_center_C hM, complement, card_S,
    compatibleCentralQuotientEquivAlt6 hM, vertexQuotientEquivPGL2Nine hM,
    markedComparison_commutes hM, projectiveSplitter_action hM⟩

end Sporadic.LeechRelated.J2.RecognitionGeometry.VertexExtension
