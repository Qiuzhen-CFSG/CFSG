module
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.VertexExtension.Basic
public import Theory.SpecificGroups.AlternatingSix.ShadowLocal.Basic
public import Theory.GroupAction.PerfectCentralQuotient
/-!
# Faithful action of the marked J₂ vertex quotient on A₆

Assume an identification C/X ≃ A₆ and perfectness of the literal centralizer C.
The injective inner action of A₆ first shows Z(C) = X. Automorphisms of C
therefore descend through the marked subgroup, and perfectness makes that
descent faithful. The kernel of normalizer conjugation on C/X is exactly X:
an element acting trivially must centralize the marked generator and hence
belong to C, where the centerless A₆ quotient detects its image.

This gives a faithful action of the actual quotient M/X on A₆. Its image
is generated by Inn(A₆) and the action of the literal ATLAS splitter. The
quotient inclusion and the two-coset normal form remain explicit throughout.

Source: Aschbacher, *Sporadic Groups* (1994), 47.3(1) and 47.10,
pp.261–267. The central-cover inputs are kept explicit for the independent
cover construction; this module proves their action-theoretic consequence.
-/

@[expose] public section
namespace Sporadic.LeechRelated.J2.RecognitionGeometry.VertexExtension
open Subgroup AlternatingSix.ShadowLocal

/-- The supplied A₆ quotient detects the whole center of the literal centralizer. -/
theorem center_C_eq_XC_of_equiv (e0 : CentralQuotient ≃* A6) : center C = XC := by
  apply le_antisymm _ XC_le_center
  intro c hc
  have he : MulAut.conj (e0 (centralQuotientMap c)) = 1 := by
    apply MulEquiv.ext
    intro y
    obtain ⟨q, rfl⟩ := e0.surjective y
    obtain ⟨d, rfl⟩ := QuotientGroup.mk'_surjective XC q
    change e0 (centralQuotientMap c) * e0 (centralQuotientMap d) *
      (e0 (centralQuotientMap c))⁻¹ = e0 (centralQuotientMap d)
    rw [← map_inv, ← map_mul, ← map_mul, ← map_inv, ← map_mul, ← map_mul]
    rw [← Subgroup.mem_center_iff.mp hc d, mul_assoc, mul_inv_cancel, mul_one]
  have hq := inner_injective (he.trans (map_one MulAut.conj).symm)
  have hq1 : centralQuotientMap c = 1 := e0.injective (hq.trans e0.map_one.symm)
  exact (QuotientGroup.eq_one_iff _).mp hq1

/-- Descent through the actual marked central subgroup. -/
def markedQuotientAction (e0 : CentralQuotient ≃* A6) :
    MulAut C →* MulAut CentralQuotient := by
  letI : XC.Characteristic := (center_C_eq_XC_of_equiv e0) ▸ inferInstance
  exact Subgroup.quotientAut XC

theorem markedQuotientAction_apply (e0 : CentralQuotient ≃* A6)
    (a : MulAut C) (c : C) :
    markedQuotientAction e0 a (centralQuotientMap c) = centralQuotientMap (a c) := by
  let : XC.Characteristic := (center_C_eq_XC_of_equiv e0) ▸ inferInstance
  change Subgroup.quotientAut XC a (QuotientGroup.mk' XC c) = _
  exact Subgroup.quotientAut_apply_mk XC a c

theorem markedQuotientAction_injective (e0 : CentralQuotient ≃* A6)
    (hperfect : Group.IsPerfect C) : Function.Injective (markedQuotientAction e0) := by
  let := hperfect
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply bot_unique
  intro a ha
  apply MulAut.eq_one_of_central_displacement a
  intro c
  apply XC_le_center
  have he := DFunLike.congr_fun ha (centralQuotientMap c)
  rw [markedQuotientAction_apply] at he
  exact QuotientGroup.eq.mp he.symm

/-- Conjugation on C by elements of the literal normalizer M. -/
def normalizerCentralAction : M →* MulAut C :=
  C.normalizerMonoidHom.comp (Subgroup.inclusion M_le_normalizer_C)

theorem normalizerCentralAction_apply (m : M) (c : C) :
    ((normalizerCentralAction m c : C) : Carrier) =
      (m : Carrier) * (c : Carrier) * (m : Carrier)⁻¹ := rfl

theorem normalizerCentralAction_inclusion (c : C) :
    normalizerCentralAction (centralInclusion c) = MulAut.conj c := by
  ext d
  rfl

theorem normalizerCentralAction_splitter :
    normalizerCentralAction splitterM = splitterAction := rfl

/-- The quotient action expressed in the supplied alternating-group coordinates. -/
def normalizerAlternatingAction (e0 : CentralQuotient ≃* A6) : M →* AutA6 :=
  (MulAut.congr e0).toMonoidHom.comp
    ((markedQuotientAction e0).comp normalizerCentralAction)

theorem normalizerAlternatingAction_apply (e0 : CentralQuotient ≃* A6)
    (m : M) (c : C) :
    normalizerAlternatingAction e0 m (e0 (centralQuotientMap c)) =
      e0 (centralQuotientMap (normalizerCentralAction m c)) := by
  change e0 (markedQuotientAction e0 (normalizerCentralAction m)
    (e0.symm (e0 (centralQuotientMap c)))) = _
  rw [e0.symm_apply_apply, markedQuotientAction_apply]

theorem normalizerAlternatingAction_inclusion (e0 : CentralQuotient ≃* A6) (c : C) :
    normalizerAlternatingAction e0 (centralInclusion c) =
      MulAut.conj (e0 (centralQuotientMap c)) := by
  apply MulEquiv.ext
  intro y
  obtain ⟨q, rfl⟩ := e0.surjective y
  obtain ⟨d, rfl⟩ := QuotientGroup.mk'_surjective XC q
  change normalizerAlternatingAction e0 (centralInclusion c) (e0 (centralQuotientMap d)) = _
  rw [normalizerAlternatingAction_apply, normalizerCentralAction_inclusion]
  simp only [MulAut.conj_apply, map_mul, map_inv]
  rfl

theorem XM_le_action_ker (e0 : CentralQuotient ≃* A6) :
    XM ≤ (normalizerAlternatingAction e0).ker := by
  intro m hm
  let c : C := ⟨m, X_le_C hm⟩
  have hm' : m = centralInclusion c := rfl
  change normalizerAlternatingAction e0 m = 1
  rw [hm', normalizerAlternatingAction_inclusion]
  have hc : centralQuotientMap c = 1 := (QuotientGroup.eq_one_iff _).mpr hm
  rw [hc, map_one, map_one]

/-- Faithful conjugation of the literal vertex quotient on its A₆ subgroup. -/
def vertexAlternatingAction (e0 : CentralQuotient ≃* A6) : VertexQuotient →* AutA6 :=
  QuotientGroup.lift XM (normalizerAlternatingAction e0) (XM_le_action_ker e0)

theorem vertexAlternatingAction_mk (e0 : CentralQuotient ≃* A6) (m : M) :
    vertexAlternatingAction e0 (vertexQuotientMap m) = normalizerAlternatingAction e0 m := rfl

theorem vertexAlternatingAction_inclusion (e0 : CentralQuotient ≃* A6)
    (q : CentralQuotient) :
    vertexAlternatingAction e0 (quotientInclusion q) = MulAut.conj (e0 q) := by
  obtain ⟨c, rfl⟩ := QuotientGroup.mk'_surjective XC q
  exact normalizerAlternatingAction_inclusion e0 c

theorem vertexAlternatingAction_injective (e0 : CentralQuotient ≃* A6)
    (hperfect : Group.IsPerfect C) : Function.Injective (vertexAlternatingAction e0) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply bot_unique
  intro q hq
  obtain ⟨m, rfl⟩ := QuotientGroup.mk'_surjective XM q
  have hm : normalizerAlternatingAction e0 m = 1 := hq
  have ha : normalizerCentralAction m = 1 := by
    apply markedQuotientAction_injective e0 hperfect
    apply (MulAut.congr e0).injective
    simpa only [normalizerAlternatingAction, MonoidHom.comp_apply,
      MulEquiv.coe_toMonoidHom, map_one] using hm
  have hmx := congrArg (fun c : C => (c : Carrier))
    (DFunLike.congr_fun ha (⟨x, X_le_C (mem_zpowers x)⟩ : C))
  have hmc : (m : Carrier) ∈ C := by
    apply (mem_C_iff _).mpr
    exact (mul_inv_eq_iff_eq_mul).mp hmx
  let c : C := ⟨m, hmc⟩
  have hm' : m = centralInclusion c := rfl
  rw [hm', normalizerAlternatingAction_inclusion] at hm
  have he := inner_injective (hm.trans (map_one MulAut.conj).symm)
  have hc : centralQuotientMap c = 1 := e0.injective (he.trans e0.map_one.symm)
  apply mem_bot.mpr
  have hcX : c ∈ XC := (QuotientGroup.eq_one_iff c).mp hc
  exact (QuotientGroup.eq_one_iff m).mpr hcX

/-- The two-coset form survives the literal quotient maps. -/
theorem quotient_normal_form (q : VertexQuotient) :
    ∃ c : CentralQuotient, q = quotientInclusion c ∨
      q = quotientInclusion c * vertexQuotientMap splitterM := by
  obtain ⟨m, rfl⟩ := QuotientGroup.mk'_surjective XM q
  obtain ⟨c, hc | hc⟩ := normal_form m
  · exact ⟨centralQuotientMap c, Or.inl (congrArg vertexQuotientMap (Subtype.ext hc))⟩
  · refine ⟨centralQuotientMap c, Or.inr ?_⟩
    rw [quotientInclusion_mk, ← map_mul]
    exact congrArg vertexQuotientMap (Subtype.ext hc)

theorem vertexAlternatingAction_range (e0 : CentralQuotient ≃* A6) :
    (vertexAlternatingAction e0).range =
      AlternatingSix.ShadowLocal.inner ⊔ zpowers (normalizerAlternatingAction e0 splitterM) := by
  apply le_antisymm
  · rintro _ ⟨q, rfl⟩
    obtain ⟨c, rfl | rfl⟩ := quotient_normal_form q
    · rw [vertexAlternatingAction_inclusion]
      exact mem_sup_left ⟨e0 c, rfl⟩
    · rw [map_mul, vertexAlternatingAction_inclusion, vertexAlternatingAction_mk]
      exact mul_mem (mem_sup_left ⟨e0 c, rfl⟩) (mem_sup_right (mem_zpowers _))
  · apply sup_le
    · rintro _ ⟨c, rfl⟩
      refine ⟨quotientInclusion (e0.symm c), ?_⟩
      rw [vertexAlternatingAction_inclusion, e0.apply_symm_apply]
    · exact zpowers_le.mpr ⟨vertexQuotientMap splitterM, rfl⟩

end Sporadic.LeechRelated.J2.RecognitionGeometry.VertexExtension
