module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.RecognitionGeometry.EdgeData
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import Mathlib.Tactic.FinCases

/-!
# The actual A₄ generated by the marked Hall–Janko vertices

The homomorphism evaluates short words in the two endpoint generators.
Kernel-checked tables verify multiplication, while restriction to an actual
four-point orbit proves injectivity. Its image is precisely the literal join
of the two cyclic subgroups. The same map certifies an edge-reversing involution.

Source: Aschbacher, *Sporadic Groups* (1994), 47.5 and 47.10, pp.263–267.
The ATLAS data and left-action convention are those of `J2.lean`.
-/

public section
namespace Sporadic.LeechRelated.J2.RecognitionGeometry
open Subgroup Theory.GroupTheory GeneratorPair EdgeData

private def xPerm : Equiv.Perm (Fin 100) := (tableA * tableB * tableA * tableB⁻¹) ^ 4
private def cPerm : Equiv.Perm (Fin 100) := tableB⁻¹ * tableA * tableB
private def yPerm : Equiv.Perm (Fin 100) := cPerm * xPerm * cPerm⁻¹

private theorem inclusion_x : inclusion x = xPerm := by
  simp only [x, xPerm, map_pow, map_mul, map_inv, (show inclusion a = tableA from generatorA_eq_table),
    (show inclusion b = tableB from generatorB_eq_table)]

private theorem inclusion_y : inclusion y = yPerm := by
  change inclusion (conjugator * x * conjugator⁻¹) = _
  simp only [conjugator, yPerm, cPerm, map_mul, map_inv, inclusion_x,
    (show inclusion a = tableA from generatorA_eq_table),
    (show inclusion b = tableB from generatorB_eq_table)]

private theorem words_checked : ∀ (p : alternatingGroup (Fin 4)) (i : Fin 100),
    evalWord ![xPerm, yPerm] (word p) i = value p i := by
  decide +kernel

private theorem multiplication_checked : ∀ (p q : alternatingGroup (Fin 4)) (i : Fin 100),
    value (p * q) i = value p (value q i) := by
  decide +kernel

private theorem orbit_checked : ∀ (p : alternatingGroup (Fin 4)) (i : Fin 4),
    value p (orbit i) = orbit (p.val i) := by
  decide +kernel

private def edgeElement (p : alternatingGroup (Fin 4)) : Carrier :=
  evalWord ![x, y] (word p)

private theorem edgeElement_value (p : alternatingGroup (Fin 4)) (i : Fin 100) :
    inclusion (edgeElement p) i = value p i := by
  have hw (w : List (Fin 2)) : inclusion (evalWord ![x, y] w) =
      evalWord ![xPerm, yPerm] w := by
    induction w with
    | nil => rfl
    | cons j w ih =>
      rw [evalWord, map_mul, ih, evalWord]
      congr 1
      fin_cases j
      · exact inclusion_x
      · exact inclusion_y
  rw [edgeElement, hw]
  exact words_checked p i

/-- A word-defined embedding of the genuine A₄ into the concrete carrier. -/
def edgeHom : alternatingGroup (Fin 4) →* Carrier where
  toFun := edgeElement
  map_one' := by
    apply inclusion_injective
    apply Equiv.ext
    intro i
    rw [edgeElement_value, map_one]
    exact (by decide +kernel : ∀ j : Fin 100, value 1 j = j) i
  map_mul' p q := by
    apply inclusion_injective
    apply Equiv.ext
    intro i
    rw [map_mul]
    change inclusion (edgeElement (p * q)) i =
      inclusion (edgeElement p) (inclusion (edgeElement q) i)
    rw [edgeElement_value, edgeElement_value, edgeElement_value]
    exact multiplication_checked p q i

/-- The embedding restricts on a literal four-point orbit to its defining action. -/
theorem edgeHom_action (p : alternatingGroup (Fin 4)) (i : Fin 4) :
    inclusion (edgeHom p) (orbit i) = orbit (p.val i) :=
  (edgeElement_value p (orbit i)).trans (orbit_checked p i)

theorem edgeHom_injective : Function.Injective edgeHom := by
  have ho : Function.Injective orbit := by decide +kernel
  intro p q hpq
  apply Subtype.ext
  apply Equiv.ext
  intro i
  apply ho
  rw [← edgeHom_action, ← edgeHom_action, hpq]

theorem edgeHom_modelX : edgeHom modelX = x := by
  change evalWord ![x, y] (word modelX) = x
  change x * 1 = x
  exact mul_one x

theorem edgeHom_modelY : edgeHom modelY = y := by
  change evalWord ![x, y] (word modelY) = y
  change y * 1 = y
  exact mul_one y

theorem edgeHom_range : edgeHom.range = X ⊔ Y := by
  apply le_antisymm
  · rintro _ ⟨p, rfl⟩
    change evalWord ![x, y] (word p) ∈ X ⊔ Y
    have hw (w : List (Fin 2)) : evalWord ![x, y] w ∈ X ⊔ Y := by
      induction w with
      | nil => exact (X ⊔ Y).one_mem
      | cons j w ih =>
        apply (X ⊔ Y).mul_mem _ ih
        fin_cases j
        · exact mem_sup_left (mem_zpowers x)
        · exact mem_sup_right (mem_zpowers y)
    exact hw _
  · apply sup_le
    · exact zpowers_le.mpr ⟨modelX, edgeHom_modelX⟩
    · exact zpowers_le.mpr ⟨modelY, edgeHom_modelY⟩

/-- Adjacency is certified by a multiplicative equivalence on the literal join. -/
noncomputable def edgeEquiv : (X ⊔ Y : Subgroup Carrier) ≃* alternatingGroup (Fin 4) :=
  ((MonoidHom.ofInjective edgeHom_injective).trans (MulEquiv.subgroupCongr edgeHom_range)).symm

private def modelT : alternatingGroup (Fin 4) :=
  modelX * (modelX * modelY⁻¹) * modelX⁻¹

private theorem edgeHom_modelT : edgeHom modelT = t := by
  simp only [modelT, map_mul, map_inv, edgeHom_modelX, edgeHom_modelY, t]

/-- The marked reversal is an involution, checked in the embedded A₄. -/
theorem t_square : t ^ 2 = 1 := by
  have ht : modelT ^ 2 = 1 := by decide +kernel
  have h := congrArg edgeHom ht
  simpa only [map_pow, map_one, edgeHom_modelT] using h

/-- Left conjugation by the reversal carries the chosen generator to its neighbor. -/
theorem t_conj_x : MulAut.conj t x = y := by
  have ht : modelT * modelX * modelT⁻¹ = modelY := by decide +kernel
  have h := congrArg edgeHom ht
  simpa only [map_mul, map_inv, edgeHom_modelT, edgeHom_modelX, edgeHom_modelY,
    MulAut.conj_apply] using h

theorem t_conj_y : MulAut.conj t y = x := by
  have ht : modelT * modelY * modelT⁻¹ = modelX := by decide +kernel
  have h := congrArg edgeHom ht
  simpa only [map_mul, map_inv, edgeHom_modelT, edgeHom_modelX, edgeHom_modelY,
    MulAut.conj_apply] using h

end Sporadic.LeechRelated.J2.RecognitionGeometry
