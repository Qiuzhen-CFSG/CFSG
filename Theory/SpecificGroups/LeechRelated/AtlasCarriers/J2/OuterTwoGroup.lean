module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.Automorphisms
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.GeneratorPair.FirstFusion
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.GeneratorPair.SecondOrbits
public import Theory.GroupTheory.SolvableOuterQuotient
public import Mathlib.GroupTheory.PGroup

/-!
# The outer group of the concrete J₂ is a two-group

The checked first-generator and second-generator orbit calculations make the
concrete permutation extension surject onto the full automorphism group.
That extension is generated by the carrier and one normalizing involution.
After passing to outer automorphisms the carrier vanishes, so the remaining
quotient is generated by an element of order dividing two.

This uses the existing kernel-checked ATLAS generator calculations without
adding any order, simplicity, or automorphism-coverage assumption. It proves
exactly the outer bound needed for quasithin Lemma 13.6.27.

Sources: GLS3, Table 5.3g; Aschbacher–Smith, combined manuscript
(1 March 2004), printed pp.934–935. The underlying ATLAS J2G1-p100B0
attribution and certificates are retained in the imported model modules.
-/

public section

open Subgroup
namespace Sporadic.LeechRelated.J2
open ExceptionalParabolics GeneratorPair

/-- The full outer automorphism group of the exact degree-100 carrier is a two-group. -/
theorem outer_isTwoGroup : IsPGroup 2 (MulAut.Outer Carrier) := by
  let q := QuotientGroup.mk' (MulAut.innerSubgroup Carrier)
  let f := q.comp extensionAction
  have hs : Function.Surjective f := (QuotientGroup.mk'_surjective _).comp
    (extensionAction_surjective_of_pair_calculations first_generator_conjugate
      second_generator_orbits)
  let N := generated.subgroupOf extension
  have hgen : N ⊔ zpowers extensionInvolution = ⊤ := by
    apply (map_injective extension.subtype_injective)
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le (show generated ≤ extension from le_sup_left),
      MonoidHom.map_zpowers, ← MonoidHom.range_eq_map, range_subtype]
    rfl
  have hN : N.map f = ⊥ := by
    apply (Subgroup.map_eq_bot_iff _).mpr
    intro x hx
    change q (extensionAction x) = 1
    apply (QuotientGroup.eq_one_iff _).mpr
    refine ⟨⟨x, hx⟩, ?_⟩
    exact (extensionAction_inner ⟨x, hx⟩).symm
  have himg := congrArg (map f) hgen
  rw [Subgroup.map_sup, hN, bot_sup_eq,
    map_top_of_surjective f hs] at himg
  have hp : IsPGroup 2 (zpowers extensionInvolution) :=
    IsPGroup.of_card_dvd_pow (n := 1) (by
      rw [Nat.card_zpowers, pow_one]
      apply orderOf_dvd_of_pow_eq_one
      apply Subtype.ext
      change involution ^ 2 = 1
      simpa only [pow_two] using involution_mul_self)
  have hp' : IsPGroup 2 (⊤ : Subgroup (MulAut.Outer Carrier)) := himg ▸ hp.map f
  exact hp'.of_equiv topEquiv

end Sporadic.LeechRelated.J2

