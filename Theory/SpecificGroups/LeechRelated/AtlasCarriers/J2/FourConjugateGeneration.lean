module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.FourConjugateGeneration.Certificates
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.SimpleFittingExtensions
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.InnerInvolutionCores.Fusion
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.OuterInvolutionFusion
public import Theory.Representation.BinaryOffender.CubicConjugateDimension
public import Theory.GroupTheory.SubgroupEnumeration
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Group

/-!
# Four-conjugate generation for the actual Hall--Janko actor

Checked words place both defining generators in the subgroup generated by
four conjugates of each involution representative. Exhaustive inner and outer
fusion covers every involution. Conjugation on the actual generalized Fitting
subgroup embeds the ambient group into the full permutation extension.
Inner involutions use conjugators in the component; an outer involution forces
the ambient image to be the whole index-two extension, so its conjugators lift.

Source: Guralnick--Malle, Classification of 2F-modules I, (2.5)--(2.6) and
Proposition 5.1, J₂ paragraph. That paragraph states the inner bound; the
outer certificate proves the additional uniform bound needed here.
-/

public section
namespace Sporadic.LeechRelated.J2.FourConjugateGeneration
open Subgroup Theory.GroupTheory
open GeneratorPair GeneratorPair.FirstFusion ExceptionalParabolics SimpleFittingExtensions

/-- Each certified quadruple contains the entire inner carrier. -/
theorem representative_generation (j : Fin 3) :
    intoExtension.range ≤ closure (Set.range (conjugate j)) := by
  let H := closure (Set.range (conjugate j))
  have hw (k : Fin 2) : intoExtension (![a, b] k) ∈ H := by
    rw [← generator_word j k]
    exact SubgroupEnumeration.evalWord_mem _ H (fun i => subset_closure ⟨i, rfl⟩) _
  have h : (⊤ : Subgroup Carrier) ≤ H.comap intoExtension := by
    rw [← closure_pair_eq_top]
    apply (closure_le _).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact hw 0
    · rw [Set.mem_singleton_iff] at hx
      subst x
      exact hw 1
  rintro x ⟨y, rfl⟩
  exact h (mem_top y)

private theorem map_conjugate_closure {G H : Type*} [Group G] [Group H]
    (f : G →* H) (x : G) (c : Fin 4 → G) :
    (closure (Set.range fun i => c i * x * (c i)⁻¹)).map f =
      closure (Set.range fun i => f (c i) * f x * (f (c i))⁻¹) := by
  rw [MonoidHom.map_closure]
  have he : f '' Set.range (fun i => c i * x * (c i)⁻¹) =
      Set.range (fun i => f (c i) * f x * (f (c i))⁻¹) := by
    ext z
    constructor
    · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, by simp only [map_mul, map_inv]⟩
    · rintro ⟨i, rfl⟩
      exact ⟨_, ⟨i, rfl⟩, by simp only [map_mul, map_inv]⟩
  rw [he]

private theorem pullback_bound {G H : Type*} [Group G] [Group H]
    (f : G →* H) (hf : Function.Injective f) (L : Subgroup G) (M : Subgroup H)
    (x : G) (c : Fin 4 → G) (d : Fin 4 → H)
    (hLM : ∀ z, z ∈ L → f z ∈ M) (hc : ∀ i, f (c i) = d i)
    (hM : M ≤ closure (Set.range fun i => d i * f x * (d i)⁻¹)) :
    L ≤ closure (Set.range fun i => c i * x * (c i)⁻¹) := by
  intro z hz
  have hm := hM (hLM z hz)
  have he : (closure (Set.range fun i => c i * x * (c i)⁻¹)).map f =
      closure (Set.range fun i => d i * f x * (d i)⁻¹) := by
    rw [map_conjugate_closure]
    simp only [hc]
  rw [← he] at hm
  obtain ⟨y, hy, hyz⟩ := hm
  exact hf hyz ▸ hy

private theorem carrier_representative_generation (j : Fin 2) :
    (⊤ : Subgroup Carrier) ≤ closure (Set.range fun i =>
      conjugator (Fin.castLE (by decide) j) i * (![a, t] j) *
        (conjugator (Fin.castLE (by decide) j) i)⁻¹) := by
  let k : Fin 3 := Fin.castLE (by decide) j
  have hr : intoExtension (![a, t] j) = representative k := by
    fin_cases j <;> rfl
  apply pullback_bound intoExtension SecondParabolic.intoExtension_injective
    ⊤ intoExtension.range _ _ (fun i => intoExtension (conjugator k i))
    (fun z _ => ⟨z, rfl⟩) (fun _ => rfl)
  rw [hr]
  exact representative_generation k

private theorem bound_conjugacy {H : Type*} [Group H] {M : Subgroup H} {r x : H}
    (hr : ∃ c : Fin 4 → H, M ≤ closure (Set.range fun i => c i * r * (c i)⁻¹))
    (hx : IsConj r x) :
    ∃ c : Fin 4 → H, M ≤ closure (Set.range fun i => c i * x * (c i)⁻¹) := by
  obtain ⟨c, hc⟩ := hr
  obtain ⟨g, hg⟩ := isConj_iff.mp hx
  refine ⟨fun i => c i * g⁻¹, ?_⟩
  have he : (fun i => (c i * g⁻¹) * x * (c i * g⁻¹)⁻¹) =
      (fun i => c i * r * (c i)⁻¹) := by
    funext i
    rw [← hg]
    group
  rw [he]
  exact hc

/-- Four inner conjugates generate the actual carrier for every inner involution. -/
theorem carrier_bound (x : Carrier) (hx : x ≠ 1) (hx2 : x ^ 2 = 1) :
    ∃ c : Fin 4 → Carrier,
      (⊤ : Subgroup Carrier) ≤ closure (Set.range fun i => c i * x * (c i)⁻¹) := by
  rcases InnerInvolutionCores.involution_fusion x (orderOf_eq_prime hx2 hx)
      with ha | ht
  · exact bound_conjugacy ⟨conjugator 0, carrier_representative_generation 0⟩ ha
  · exact bound_conjugacy ⟨conjugator 1, carrier_representative_generation 1⟩ ht

/-- Inner involutions in the extension still use conjugators from the inner carrier. -/
theorem extension_inner_bound (x : Extension) (hx : x ≠ 1) (hx2 : x ^ 2 = 1)
    (hi : x ∈ intoExtension.range) :
    ∃ c : Fin 4 → Carrier, intoExtension.range ≤
      closure (Set.range fun i => intoExtension (c i) * x * (intoExtension (c i))⁻¹) := by
  obtain ⟨z, rfl⟩ := hi
  have hz : z ≠ 1 := by intro h; exact hx (h ▸ intoExtension.map_one)
  have hz2 : z ^ 2 = 1 := SecondParabolic.intoExtension_injective (by
    simpa only [map_pow, map_one] using hx2)
  obtain ⟨c, hc⟩ := carrier_bound z hz hz2
  refine ⟨c, ?_⟩
  have hm : (⊤ : Subgroup Carrier).map intoExtension ≤
      (closure (Set.range fun i => c i * z * (c i)⁻¹)).map intoExtension :=
    Subgroup.map_mono hc
  simpa only [← MonoidHom.range_eq_map, map_conjugate_closure] using hm

/-- The outer involution class also has a four-conjugate subgroup containing J₂. -/
theorem extension_outer_bound (x : Extension) (hx : x ≠ 1) (hx2 : x ^ 2 = 1)
    (hi : x ∉ intoExtension.range) :
    ∃ c : Fin 4 → Extension, intoExtension.range ≤
      closure (Set.range fun i => c i * x * (c i)⁻¹) := by
  apply bound_conjugacy
    ⟨fun i => intoExtension (conjugator 2 i), representative_generation 2⟩
  exact OuterInvolutionFusion.extension_outer_involution_fusion x
    (orderOf_eq_prime hx2 hx) hi

private theorem inner_index : intoExtension.range.index = 2 := by
  have hc : Nat.card intoExtension.range = 604800 :=
    (Nat.card_congr (MonoidHom.ofInjective SecondParabolic.intoExtension_injective).toEquiv).symm.trans
      (SecondParabolic.card_carrier FirstParabolic.card_l₁)
  have h := intoExtension.range.card_mul_index
  rw [hc, SecondParabolic.card_extension FirstParabolic.card_l₁] at h
  omega

private theorem ambient_range_cases {G : Type*} [Group G] [Finite G]
    (e : generalizedFitting G ≃* Carrier) :
    (ambientAction e).range = intoExtension.range ∨ (ambientAction e).range = ⊤ := by
  have hd : (ambientAction e).range.index ∣ 2 :=
    inner_index ▸ Subgroup.index_dvd_of_le (inner_le_ambientAction_range e)
  rcases (Nat.dvd_prime Nat.prime_two).mp hd with h | h
  · exact Or.inr (Subgroup.index_eq_one.mp h)
  · have hm := Subgroup.relIndex_mul_index (inner_le_ambientAction_range e)
    rw [h, inner_index] at hm
    have hr : intoExtension.range.relIndex (ambientAction e).range = 1 := by omega
    exact Or.inl (le_antisymm (Subgroup.relIndex_eq_one.mp hr)
      (inner_le_ambientAction_range e))

/-- Every nonidentity involution of the actual ambient group has four conjugates
whose generated subgroup contains its Hall--Janko generalized Fitting subgroup. -/
theorem involution_conjugate_generation_bound {G : Type*} [Group G] [Finite G]
    [IsSimpleGroup (generalizedFitting G)] (e : generalizedFitting G ≃* Carrier) :
    Representation.BinaryOffender.InvolutionConjugateGenerationBound
      (generalizedFitting G) 4 := by
  intro x hx hx2
  let f := ambientAction e
  have hf : Function.Injective f := ambientAction_injective e
  have hne : f x ≠ 1 := by
    intro h
    exact hx (hf (h.trans f.map_one.symm))
  have hsq : (f x) ^ 2 = 1 := by rw [← map_pow, hx2, map_one]
  have hLM (z : G) (hz : z ∈ generalizedFitting G) : f z ∈ intoExtension.range := by
    rw [show f z = intoExtension (e ⟨z, hz⟩) from ambientAction_on_fitting e ⟨z, hz⟩]
    exact ⟨e ⟨z, hz⟩, rfl⟩
  classical
  by_cases hi : f x ∈ intoExtension.range
  · obtain ⟨c, hc⟩ := extension_inner_bound (f x) hne hsq hi
    refine ⟨fun i => (e.symm (c i) : G), ?_⟩
    apply pullback_bound f hf (generalizedFitting G) intoExtension.range x _
      (fun i => intoExtension (c i)) hLM _ hc
    intro i
    exact (ambientAction_on_fitting e (e.symm (c i))).trans
      (congrArg intoExtension (e.apply_symm_apply (c i)))
  · have hr : f.range = ⊤ := by
      rcases ambient_range_cases e with hr | hr
      · exact (hi (hr ▸ (show f x ∈ f.range from ⟨x, rfl⟩))).elim
      · exact hr
    obtain ⟨d, hd⟩ := extension_outer_bound (f x) hne hsq hi
    have hc (i : Fin 4) : ∃ c : G, f c = d i := by
      have hm : d i ∈ f.range := by rw [hr]; exact mem_top _
      exact hm
    choose c hc using hc
    exact ⟨c, pullback_bound f hf (generalizedFitting G) intoExtension.range x c d hLM hc hd⟩

end Sporadic.LeechRelated.J2.FourConjugateGeneration
