module
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.GeneratorPair.FirstFusion.LocalFusion.Evaluation

/-!
# Finite identities for the J₂ centralizer enumeration

The kernel checks the spanning tree of the published 1920 words, their
right-multiplication table, and the placement of every Schreier factor.
For each nonidentity row, either one point disproves its square being the
identity, or a word over the carrier generators conjugates it to `a` or `t`.
The conjugation check uses `g * z = base * g`, avoiding inverse-table assumptions.
`Soundness` transports all these point identities to the actual carrier.

Source: retained ATLAS `J2G1-p100B0`; GLS3, Table 5.3g. The candidate data
are generated by the untrusted adjacent `generate.py`.
-/

@[expose] public section
namespace Sporadic.LeechRelated.J2.GeneratorPair.FirstFusion.LocalCertificate
set_option maxRecDepth 100000
set_option Elab.async false

theorem word_data : ∀ i : Fin 1920, i ≠ 0 →
    (parent i).val < i.val ∧
    CentralizerData.words i = CentralizerData.words (parent i) ++ [parentLetter i] ∧
    next (parent i) (parentLetter i) = i := by
  apply allFin
  decide +kernel

theorem value_zero : ∀ p : Fin 100, value 0 p = p := by
  apply allFin
  decide +kernel

theorem steps_checked : checkFin (fun i : Fin 1920 =>
    checkFin (fun s : Fin 3 => checkFin (fun p : Fin 100 => decide
      (value (next i s) p = value i (localLetterValue s p))))) = true := by
  decide +kernel

theorem value_step (i : Fin 1920) (s : Fin 3) (p : Fin 100) :
    value (next i s) p = value i (localLetterValue s p) := by
  exact of_decide_eq_true (checkedAt (checkedAt (checkedAt steps_checked i) s) p)

theorem reps_checked : checkFin (fun i : Fin 315 =>
    checkFin (fun p : Fin 100 => decide
      (repValue i p = wordValue (OrbitData.words i) p))) = true := by
  decide +kernel

theorem repValue_eq (i : Fin 315) (p : Fin 100) :
    repValue i p = inclusion (rep i) p := by
  rw [rep, ← wordValue_spec]
  exact of_decide_eq_true (checkedAt (checkedAt reps_checked i) p)

theorem schreier_checked : checkFin (fun i : Fin 315 =>
    checkFin (fun s : Fin 3 => checkFin (fun p : Fin 100 => decide
      (value (schreierIndex i s) (repValue (OrbitData.next i s) p) =
        repValue i (letterValue s p))))) = true := by
  decide +kernel

theorem schreier_value (i : Fin 315) (s : Fin 3) (p : Fin 100) :
    value (schreierIndex i s) (repValue (OrbitData.next i s) p) =
        repValue i (letterValue s p) := by
  exact of_decide_eq_true (checkedAt (checkedAt (checkedAt schreier_checked i) s) p)

def baseValue (i : Fin 1920) (p : Fin 100) : Fin 100 :=
   if fusionA i then letterValue 0 p else OrbitData.value 0 p

theorem fusion_checked : checkFin (fun i : Fin 1920 => decide (i ≠ 0 →
    value i (value i (badPoint i)) = badPoint i →
    checkFin (fun p : Fin 100 => decide
      (wordValue (fusionWord i) (value i p) =
        baseValue i (wordValue (fusionWord i) p))) = true)) = true := by
  decide +kernel

theorem fusion_value (i : Fin 1920) (hi : i ≠ 0)
    (hsq : value i (value i (badPoint i)) = badPoint i) (p : Fin 100) :
    wordValue (fusionWord i) (value i p) =
      baseValue i (wordValue (fusionWord i) p) := by
  have h := of_decide_eq_true (checkedAt fusion_checked i)
  exact of_decide_eq_true (checkedAt (h hi hsq) p)

end Sporadic.LeechRelated.J2.GeneratorPair.FirstFusion.LocalCertificate
