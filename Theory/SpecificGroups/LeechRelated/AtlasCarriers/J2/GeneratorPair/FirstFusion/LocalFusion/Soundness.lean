module
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.GeneratorPair.FirstFusion.LocalFusion.Checks
import Mathlib.Tactic.FinCases

/-!
# Soundness of the J₂ centralizer certificates

Spanning-tree induction identifies each packed row with its published carrier
word. The multiplication and Schreier checks then identify `C(t)` with the
subgroup generated by `a,c`; induction on this generating set proves coverage.
Finally each involution's checked conjugating word is evaluated in `Carrier`,
so the conjugacy conclusion holds inside the actual degree-100 group.

Source: ATLAS `J2G1-p100B0`; the two involution types are those in GLS3,
Table 5.3g. No group order or simplicity result is used.
-/

@[expose] public section
namespace Sporadic.LeechRelated.J2.GeneratorPair.FirstFusion
open Theory.GroupTheory
namespace LocalCertificate

theorem element_zero : centralizerElement 0 = 1 := rfl

theorem value_spec (i : Fin 1920) (p : Fin 100) :
    inclusion (centralizerElement i) p = value i p := by
  have aux : ∀ (n : Nat) (j : Fin 1920), j.val = n → ∀ q : Fin 100,
      inclusion (centralizerElement j) q = value j q := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro j hj q
      by_cases hzero : j = 0
      · subst j
        simpa only [element_zero, map_one, Equiv.Perm.one_apply] using (value_zero q).symm
      obtain ⟨hlt, hw, hn⟩ := word_data j hzero
      have hp := ih (parent j).val (hj ▸ hlt) (parent j) rfl
      have he : centralizerElement j =
          centralizerElement (parent j) * centralizerLetter (parentLetter j) := by
        simp only [centralizerElement, hw, evalWord_append, evalWord, mul_one]
      rw [he, map_mul]
      change inclusion (centralizerElement (parent j))
        (inclusion (centralizerLetter (parentLetter j)) q) = value j q
      rw [hp, ← localLetterValue_eq, ← value_step, hn]
  exact aux i.val i rfl p

theorem element_step (i : Fin 1920) (s : Fin 3) :
    centralizerElement i * centralizerLetter s = centralizerElement (next i s) := by
  apply inclusion_injective
  apply Equiv.ext
  intro p
  rw [map_mul]
  change inclusion (centralizerElement i) (inclusion (centralizerLetter s) p) =
    inclusion (centralizerElement (next i s)) p
  rw [value_spec, value_spec, ← localLetterValue_eq, value_step]

theorem schreier_eq (i : Fin 315) (s : Fin 3) :
    schreier (i, s) = centralizerElement (schreierIndex i s) := by
  have he : centralizerElement (schreierIndex i s) * rep (OrbitData.next i s) =
      rep i * letter s := by
    apply inclusion_injective
    apply Equiv.ext
    intro p
    simp only [map_mul, Equiv.Perm.mul_apply, value_spec, ← repValue_eq,
      inclusion_letter, ← letterValue_eq]
    exact schreier_value i s p
  rw [schreier, ← he, mul_inv_cancel_right]

theorem centralizerLetter_inv (s : Fin 3) :
    centralizerLetter (invLetter s) = (centralizerLetter s)⁻¹ := by
  have ha : a = a⁻¹ := eq_inv_of_mul_eq_one_left (by simpa only [pow_two] using a_pow_two)
  fin_cases s
  · exact ha
  · rfl
  · exact (inv_inv c).symm

theorem centralizer_eq_closure_letters :
    centralizer = Subgroup.closure (Set.range centralizerLetter) := by
  apply le_antisymm
  · rw [centralizer_eq_closure_schreier]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨i, s⟩, rfl⟩
    rw [schreier_eq]
    have hw (w : List (Fin 3)) :
        evalWord centralizerLetter w ∈ Subgroup.closure (Set.range centralizerLetter) := by
      induction w with
      | nil => exact Subgroup.one_mem _
      | cons j w ih => exact Subgroup.mul_mem _ (Subgroup.subset_closure ⟨j, rfl⟩) ih
    exact hw _
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨s, rfl⟩
    exact centralizerLetter_mem s

theorem cover (z : Carrier) (hz : z ∈ centralizer) :
    ∃ i : Fin 1920, z = centralizerElement i := by
  rw [centralizer_eq_closure_letters] at hz
  induction hz using Subgroup.closure_induction_right with
  | one => exact ⟨0, element_zero.symm⟩
  | mul_right x _ y hy ih =>
    obtain ⟨s, rfl⟩ := hy
    obtain ⟨i, rfl⟩ := ih
    exact ⟨next i s, element_step i s⟩
  | mul_inv_cancel x _ y hy ih =>
    obtain ⟨s, rfl⟩ := hy
    obtain ⟨i, rfl⟩ := ih
    rw [← centralizerLetter_inv]
    exact ⟨next i (invLetter s), element_step i (invLetter s)⟩

def base (i : Fin 1920) : Carrier := if fusionA i then a else t

theorem baseValue_eq (i : Fin 1920) (p : Fin 100) :
    baseValue i p = inclusion (base i) p := by
  by_cases hi : fusionA i = true
  · simp only [baseValue, base, hi, ↓reduceIte, letterValue_eq]
    exact congrFun (congrArg DFunLike.coe (inclusion_letter 0).symm) p
  · simp [baseValue, base, hi, FirstFusion.value_zero, inclusion_t]

theorem fusion (i : Fin 1920) (hsq : centralizerElement i ^ 2 = 1)
    (hne : centralizerElement i ≠ 1) : IsConj (base i) (centralizerElement i) := by
  have hi : i ≠ 0 := by
    intro he
    exact hne (he ▸ element_zero)
  have hp : value i (value i (badPoint i)) = badPoint i := by
    have hh := congrArg (fun g : Carrier => inclusion g (badPoint i)) hsq
    simpa only [pow_two, map_mul, map_one, Equiv.Perm.mul_apply,
      Equiv.Perm.one_apply, value_spec] using hh
  let g : Carrier := evalWord letter (fusionWord i)
  have he : g * centralizerElement i = base i * g := by
    apply inclusion_injective
    apply Equiv.ext
    intro p
    simp only [map_mul, Equiv.Perm.mul_apply]
    change inclusion (evalWord letter (fusionWord i)) (inclusion (centralizerElement i) p) =
      inclusion (base i) (inclusion (evalWord letter (fusionWord i)) p)
    rw [← wordValue_spec, ← wordValue_spec, value_spec, ← baseValue_eq]
    exact fusion_value i hi hp p
  apply isConj_iff.mpr
  refine ⟨g⁻¹, ?_⟩
  rw [inv_inv, mul_assoc, ← he, inv_mul_cancel_left]

end LocalCertificate
end Sporadic.LeechRelated.J2.GeneratorPair.FirstFusion
