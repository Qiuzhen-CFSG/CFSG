private def checkFin {n : Nat} (f : Fin n → Bool) : Bool :=
  (List.range n).all (fun i => if h : i < n then f ⟨i, h⟩ else true)

private theorem allFin {n : Nat} (P : Fin n → Prop) [DecidablePred P]
    (h : checkFin (fun i => decide (P i)) = true) : ∀ i, P i := by
  intro i
  have hi := List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt)
  simpa only [dif_pos i.isLt, decide_eq_true_eq] using hi

set_option maxRecDepth 100000 in
private theorem decode_element : ∀ i : Fin 336,
    decode (element i 0) (element i 3) (element i 4) = i := by
  apply allFin
  decide +kernel

theorem element_injective : Function.Injective element := by
  intro i j h
  have hh := congrArg (fun p : Equiv.Perm (Fin 14) => decode (p 0) (p 3) (p 4)) h
  simpa only [decode_element] using hh

theorem element_mem (i : Fin 336) : element i ∈ model := by
  have hg : ∀ j : Fin 3, (![modelA, modelB, modelB⁻¹] j : Equiv.Perm (Fin 14)) ∈ model := by
    intro j
    fin_cases j
    · exact modelA_mem
    · exact modelB_mem
    · exact model.inv_mem modelB_mem
  unfold element
  induction word i with
  | nil => exact model.one_mem
  | cons j ws ih => exact model.mul_mem (hg j) ih

end ModelLowerBound

/-- The generated model contains at least 336 distinct permutations. -/
theorem card_model_ge : 336 ≤ Nat.card model := by
  let f : Fin 336 → model := fun i => ⟨ModelLowerBound.element i, ModelLowerBound.element_mem i⟩
  have hf : Function.Injective f := by
    intro i j h
    exact ModelLowerBound.element_injective (congrArg Subtype.val h)
  simpa only [Nat.card_fin] using Nat.card_le_card_of_injective f hf

end Sporadic.LeechRelated.J2.OuterInvolutionCentralizer
