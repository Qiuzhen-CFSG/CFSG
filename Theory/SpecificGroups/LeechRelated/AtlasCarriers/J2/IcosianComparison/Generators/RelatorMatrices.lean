/-!
# Exact quaternion matrix certificates for the five relators

The tables store eight rational coefficients, with common denominator eight,
for each quaternion entry. Each multiplication is checked separately by the
kernel, so long words do not repeatedly unfold earlier arithmetic. These are
coefficient calculations only; `Relations` connects them to the actual lattice
pair. Root data originate in Gerald Höhn's ATLAS construction; the words are
ATLAS `J2G1-P2`.
-/

set_option Elab.async false

@[expose] public section
namespace Sporadic.LeechRelated.J2.IcosianComparison.Generators.RelatorMatrices
open Atlas.Algebra
open scoped Matrix

local instance : DecidableEq IcosianQuaternion := fun a b =>
  decidable_of_iff (a.re = b.re ∧ a.imI = b.imI ∧ a.imJ = b.imJ ∧ a.imK = b.imK)
    QuaternionAlgebra.ext_iff.symm

abbrev QMatrix := Matrix (Fin 3) (Fin 3) IcosianQuaternion

def ofData (d : Fin 3 → Fin 3 → Fin 8 → ℤ) : QMatrix := fun i j =>
  ⟨⟨(d i j 0 : ℚ) / 8, (d i j 1 : ℚ) / 8⟩,
   ⟨(d i j 2 : ℚ) / 8, (d i j 3 : ℚ) / 8⟩,
   ⟨(d i j 4 : ℚ) / 8, (d i j 5 : ℚ) / 8⟩,
   ⟨(d i j 6 : ℚ) / 8, (d i j 7 : ℚ) / 8⟩⟩

