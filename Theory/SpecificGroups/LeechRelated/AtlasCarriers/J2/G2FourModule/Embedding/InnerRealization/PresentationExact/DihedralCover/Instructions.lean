@[expose] public section
namespace Sporadic.LeechRelated.J2.G2FourModule.Embedding.InnerRealization.PresentationExact.DihedralCertificate
open Subgroup.CosetWordCertificate

def refs : Nat → Nat → List Nat
  | 0, _ => []
  | n+1, c => if c == 0 then [] else (c % 1048576 - 1) :: refs n (c >>> 20)

def instructions (n : Nat) : Scan.Op Nat :=
  let c := opCode n
  let a := c / 8 % 1048576
  let b := c / 8388608
  match c % 8 with
  | 0 => .basic (.refl a)
  | 1 => .basic (.defining a)
  | 2 => .basic (.subgroup (decodeLetter a))
  | 3 => .basic (.relator a b)
  | 4 => .basic (.reverse a)
  | 5 => .basic (.compose a b)
  | _ => .scan (scanHeader a / 1024) (scanHeader a % 1024)
      (refs 60 (scanLeft a)) (refs 60 (scanRight a))

end Sporadic.LeechRelated.J2.G2FourModule.Embedding.InnerRealization.PresentationExact.DihedralCertificate
