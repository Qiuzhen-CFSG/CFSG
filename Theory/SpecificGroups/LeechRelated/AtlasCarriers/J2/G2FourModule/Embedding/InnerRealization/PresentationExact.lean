module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.G2FourModule.Embedding.InnerRealization.PresentationExact.Core
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.G2FourModule.Embedding.InnerRealization.PresentationExact.DihedralCover
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.FirstParabolic.Order

/-!
# Exactness of the Hall--Janko presentation

The abstract subgroup generated by `a` and `b⁻¹ab` has order at most 24.
A certified cover by 25200 representatives therefore bounds the abstract
presentation by 604800. The existing surjection onto the literal degree-100
carrier, whose order is already proved to be 604800, is then injective.

The imported `dihedralCover` certifies every transition in the abstract group.
Applying the conditional bounds below to that cover proves unconditional
injectivity of `Presentation.toCarrier`, with its original generator marking.

Source: ATLAS J2G1-P2 and Aschbacher--Smith K.4.5, printed p.460/PDF p.471.
-/

public section
namespace Sporadic.LeechRelated.J2.G2FourModule.Embedding.InnerRealization.PresentationExact
open Presentation

/-- An actual cover bounds the presentation using the dihedral subgroup. -/
theorem finite_card_le_of_cosetCover
    (C : Subgroup.GeneratorCosetCover dihedral
      (PresentedGroup.of : Fin 2 → UniversalGroup) (Fin 25200)) :
    Finite UniversalGroup ∧ Nat.card UniversalGroup ≤ 604800 := by
  obtain ⟨hf, hb⟩ := dihedral_bound
  let : Finite dihedral := hf
  obtain ⟨hG, hcard⟩ := PresentedGroup.finite_card_le_of_cosetCover dihedral C
  refine ⟨hG, hcard.trans ?_⟩
  simpa only [Nat.card_fin] using Nat.mul_le_mul_right 25200 hb

/-- The order comparison uses the published literal-carrier map and cardinality. -/
theorem toCarrier_injective_of_bound
    (h : Finite UniversalGroup ∧ Nat.card UniversalGroup ≤ 604800) :
    Function.Injective toCarrier := by
  let : Finite UniversalGroup := h.1
  apply (toCarrier_surjective.bijective_of_nat_card_le _).1
  rw [ExceptionalParabolics.FirstParabolic.card_carrier]
  exact h.2

/-- Consumer of the certified coset transitions, preserving both generator images. -/
theorem toCarrier_injective_of_cosetCover
    (C : Subgroup.GeneratorCosetCover dihedral
      (PresentedGroup.of : Fin 2 → UniversalGroup) (Fin 25200)) :
    Function.Injective toCarrier :=
  toCarrier_injective_of_bound (finite_card_le_of_cosetCover C)

/-- The certified cover bounds the original five-relator presented group. -/
theorem finite_card_le : Finite UniversalGroup ∧ Nat.card UniversalGroup ≤ 604800 :=
  finite_card_le_of_cosetCover dihedralCover

/-- The five ATLAS relators present the literal carrier with its original marking. -/
theorem toCarrier_injective : Function.Injective toCarrier :=
  toCarrier_injective_of_bound finite_card_le

end Sporadic.LeechRelated.J2.G2FourModule.Embedding.InnerRealization.PresentationExact
