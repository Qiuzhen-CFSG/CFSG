/-!
# Word data for four-conjugate generation in J₂

The three rows describe the two inner involution representatives and the outer
involution. Each gives four conjugating words in the original generators and
words expressing both original generators in those four conjugates.
The companion Certificates module checks every point of every identity.
Source: retained ATLAS J2G1-p100B0; Guralnick--Malle, Classification of
2F-modules I, (2.5)--(2.6), Proposition 5.1 (J₂ paragraph).
-/

@[expose] public section
namespace Sporadic.LeechRelated.J2.FourConjugateGeneration.Data
open Theory.GroupTheory GeneratorPair GeneratorPair.FirstFusion ExceptionalParabolics

def unpack (r : Nat) (p : Fin 100) : Fin 100 :=
  ⟨(r >>> (7 * p.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

def wordValue {n : Nat} (gen : Fin n → Fin 100 → Fin 100) :
    List (Fin n) → Fin 100 → Fin 100
  | [], p => p
  | j :: w, p => gen j (wordValue gen w p)

