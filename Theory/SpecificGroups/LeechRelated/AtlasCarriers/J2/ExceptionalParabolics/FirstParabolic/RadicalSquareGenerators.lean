module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.FirstParabolic.IntrinsicStructure

/-!
# Square-root generators of the first Hall--Janko radical

Four of the 32 already certified radical elements generate the radical.
Each has square the marked involution, as does the product of any two
distinct generators. These small permutation identities are checked in
Lean's kernel. They turn the common-square orbit argument in a perfect
double cover into an elementary-abelian quotient argument.

Source: Aschbacher--Smith I.2.2(5), printed pp.411--412. The permutations
are the retained ATLAS J2G1-p100B0 data, with the attribution of
`RadicalStructure`. No external computation is used as a proof.
-/

@[expose] public section
namespace Sporadic.LeechRelated.J2.ExceptionalParabolics.FirstParabolic
open Subgroup Theory.GroupTheory GeneratorPair Seed RadicalStructureData

/-- Indices in the certified radical enumeration. -/
def squareIndex : Fin 4 → Fin 32 := ![4, 5, 6, 29]

/-- Four marked square roots in the literal centralizer. -/
def squareGenerator (i : Fin 4) : l₁ :=
  ⟨radicalElement (squareIndex i), radical_le_l₁ (radicalElement_mem _)⟩

theorem squareGenerator_mem_core (i : Fin 4) : squareGenerator i ∈ pCore 2 l₁ := by
  rw [l₁_core_eq]
  exact radicalElement_mem _

set_option maxRecDepth 100000 in
private theorem square_check : ∀ i : Fin 4,
    RadicalStructureData.tablePerm (squareIndex i) ^ 2 = FirstFusion.tPerm := by
  decide +kernel

set_option maxRecDepth 100000 in
private theorem pair_check : ∀ i j : Fin 4, i ≠ j →
    (RadicalStructureData.tablePerm (squareIndex i) *
      RadicalStructureData.tablePerm (squareIndex j)) ^ 2 = FirstFusion.tPerm := by
  decide +kernel

theorem squareGenerator_square (i : Fin 4) :
    (squareGenerator i).val ^ 2 = z := by
  apply inclusion_injective
  rw [map_pow, show inclusion z = FirstFusion.tPerm from FirstFusion.inclusion_t]
  exact (congrArg (fun x => x ^ 2) (radicalElement_inclusion _)).trans (square_check i)

theorem squareGenerator_mul_square (i j : Fin 4) (hij : i ≠ j) :
    ((squareGenerator i).val * (squareGenerator j).val) ^ 2 = z := by
  apply inclusion_injective
  rw [map_pow, map_mul, show inclusion z = FirstFusion.tPerm from FirstFusion.inclusion_t]
  change (inclusion (radicalElement _) * inclusion (radicalElement _)) ^ 2 = _
  rw [radicalElement_inclusion, radicalElement_inclusion]
  exact pair_check i j hij

private def generatorWord : Fin 4 → List (Fin 4) :=
  ![[3, 2, 1, 0], [2, 3, 0], [3, 1, 0], [0]]

set_option maxRecDepth 100000 in
private theorem generator_check : ∀ i : Fin 4,
    evalWord (fun j => RadicalStructureData.tablePerm (squareIndex j)) (generatorWord i) =
      generatorTable i := by
  decide +kernel

private theorem evalWord_inclusion (w : List (Fin 4)) :
    inclusion ((evalWord squareGenerator w).val) =
      evalWord (fun j => RadicalStructureData.tablePerm (squareIndex j)) w := by
  induction w with
  | nil => exact map_one inclusion
  | cons i w ih =>
    change inclusion ((squareGenerator i).val * (evalWord squareGenerator w).val) = _
    rw [map_mul, ih]
    change inclusion (radicalElement _) * _ = _
    rw [radicalElement_inclusion]

/-- The literal two-core is generated by these four square roots. -/
theorem core_eq_closure_squareGenerator :
    pCore 2 l₁ = closure (Set.range squareGenerator) := by
  apply le_antisymm
  · have hrad : radical ≤ (closure (Set.range squareGenerator)).map l₁.subtype := by
      apply (closure_le _).mpr
      rintro _ ⟨i, rfl⟩
      refine ⟨evalWord squareGenerator (generatorWord i), ?_, ?_⟩
      · have hw (w : List (Fin 4)) :
            evalWord squareGenerator w ∈ closure (Set.range squareGenerator) := by
          induction w with
          | nil => exact one_mem _
          | cons j w ih => exact mul_mem (subset_closure ⟨j, rfl⟩) ih
        exact hw _
      · apply inclusion_injective
        exact (evalWord_inclusion _).trans
          ((generator_check i).trans (radicalGenerator_inclusion i).symm)
    intro x hx
    rw [l₁_core_eq] at hx
    obtain ⟨y, hy, he⟩ := hrad hx
    exact (Subtype.ext he : y = x) ▸ hy
  · exact (closure_le _).mpr (by rintro _ ⟨i, rfl⟩; exact squareGenerator_mem_core i)

end Sporadic.LeechRelated.J2.ExceptionalParabolics.FirstParabolic
