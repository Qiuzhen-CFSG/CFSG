module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.FirstParabolic.RadicalStructure.Data

/-!
# Order of the first Hall--Janko radical candidate

The 32 short words are compared with the certified Sylow enumeration.
Generator and inverse-generator transitions prove coverage by subgroup
induction, while the Sylow indices distinguish the words. This gives the
order of the subgroup generated by the unchanged four radical words.

Source: Aschbacher--Smith F.1.12(I)(10)--(11), printed p.263 (PDF p.274).
The finite witnesses from `source/Generate.py` are all checked by the kernel.
-/

@[expose] public section
namespace Sporadic.LeechRelated.J2.ExceptionalParabolics.FirstParabolic
open Theory.GroupTheory GeneratorPair Seed RadicalStructureData
open GeneratorPair.SecondOrbitCertificate

set_option maxRecDepth 100000 in
private theorem generator_check : ∀ i,
    evalWord PairNormalizer.SylowData.sGenTable (radicalWord i) = generatorTable i := by
  apply allFin
  decide +kernel

theorem radicalGenerator_inclusion (i : Fin 4) :
    inclusion (radicalGenerator i) = generatorTable i := by
  have hw (w : List (Fin 7)) : inclusion (evalWord sGenerator w) =
      evalWord PairNormalizer.SylowData.sGenTable w := by
    induction w with
    | nil => exact map_one inclusion
    | cons j w ih =>
      rw [evalWord, map_mul, PairNormalizer.sGenerator_inclusion, ih, evalWord]
  exact (hw (radicalWord i)).trans (generator_check i)

set_option maxRecDepth 100000 in
private theorem word_check : ∀ i,
    evalWord generatorTable (word i) = RadicalStructureData.tablePerm i := by
  apply allFin
  decide +kernel

set_option maxRecDepth 100000 in
private theorem step_check : ∀ j i,
    generatorTable j * RadicalStructureData.tablePerm i =
      RadicalStructureData.tablePerm (step j i) := by
  apply allFin
  decide +kernel

set_option maxRecDepth 100000 in
private theorem invStep_check : ∀ j i,
    (generatorTable j)⁻¹ * RadicalStructureData.tablePerm i =
      RadicalStructureData.tablePerm (invStep j i) := by
  apply allFin
  decide +kernel

/-- The 32 enumerated words in the fixed radical generators. -/
def radicalElement (i : Fin 32) : Carrier := evalWord radicalGenerator (word i)

theorem radicalElement_inclusion (i : Fin 32) :
    inclusion (radicalElement i) = RadicalStructureData.tablePerm i := by
  have hw (w : List (Fin 4)) : inclusion (evalWord radicalGenerator w) =
      evalWord generatorTable w := by
    induction w with
    | nil => exact map_one inclusion
    | cons j w ih => rw [evalWord, map_mul, radicalGenerator_inclusion, ih, evalWord]
  exact (hw (word i)).trans (word_check i)

theorem radicalElement_mem (i : Fin 32) : radicalElement i ∈ radical := by
  have hw (w : List (Fin 4)) : evalWord radicalGenerator w ∈ radical := by
    induction w with
    | nil => exact radical.one_mem
    | cons j w ih => exact radical.mul_mem (Subgroup.subset_closure ⟨j, rfl⟩) ih
  exact hw _

/-- Every element of the actual subgroup occurs in the word list. -/
theorem exists_radicalElement {x : Carrier} (hx : x ∈ radical) :
    ∃ i, radicalElement i = x := by
  induction hx using Subgroup.closure_induction_left with
  | one => exact ⟨0, rfl⟩
  | mul_left x hx y hy ih =>
    obtain ⟨j, rfl⟩ := hx
    obtain ⟨i, rfl⟩ := ih
    refine ⟨step j i, inclusion_injective ?_⟩
    rw [map_mul, radicalElement_inclusion, radicalElement_inclusion,
      radicalGenerator_inclusion]
    exact (step_check j i).symm
  | inv_mul_cancel x hx y hy ih =>
    obtain ⟨j, rfl⟩ := hx
    obtain ⟨i, rfl⟩ := ih
    refine ⟨invStep j i, inclusion_injective ?_⟩
    rw [map_mul, map_inv, radicalElement_inclusion, radicalElement_inclusion,
      radicalGenerator_inclusion]
    exact (invStep_check j i).symm

private theorem sylowIndex_injective : Function.Injective sylowIndex := by decide +kernel

theorem radicalElement_injective : Function.Injective radicalElement := by
  intro i j hij
  apply sylowIndex_injective
  apply PairNormalizer.sElement_injective
  apply inclusion_injective
  rw [PairNormalizer.sElement_inclusion, PairNormalizer.sElement_inclusion]
  exact (radicalElement_inclusion i).symm.trans
    ((congrArg inclusion hij).trans (radicalElement_inclusion j))

/-- A certified enumeration of the first radical as a subtype. -/
def radicalEnum (i : Fin 32) : radical := ⟨radicalElement i, radicalElement_mem i⟩

theorem radicalEnum_injective : Function.Injective radicalEnum :=
  fun _ _ h => radicalElement_injective (congrArg Subtype.val h)

theorem radicalEnum_surjective : Function.Surjective radicalEnum := by
  intro x
  obtain ⟨i, hi⟩ := exists_radicalElement x.property
  exact ⟨i, Subtype.ext hi⟩

noncomputable def radicalEquivFin : radical ≃ Fin 32 :=
  (Equiv.ofBijective radicalEnum ⟨radicalEnum_injective, radicalEnum_surjective⟩).symm

/-- The fixed radical candidate has order 32. -/
theorem card_radical : Nat.card radical = 32 := by
  simpa using Nat.card_congr radicalEquivFin

end Sporadic.LeechRelated.J2.ExceptionalParabolics.FirstParabolic
