module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.FaithfulAction

/-!
# A concrete permutation extension of the Hall--Janko carrier

The displayed involution conjugates the original generator `a` to itself
and `b` to its inverse. Kernel-checked permutation equalities establish these
facts and hence normalization of the generated group. The faithful normalizer
action supplies an embedding of the resulting permutation extension into
`MulAut Carrier`.

The final equivalence is explicitly conditional on two finite standard-pair
orbit calculations: first-generator fusion, and the two orbits of possible
second generators. Those calculations imply that every automorphism is an
inner automorphism, possibly followed by the displayed involution. Their
independent proof owners must discharge both premises before this extension
is identified with the full automorphism group.

Source: R. A. Wilson et al., ATLAS of Finite Group Representations,
`J2G1-p100B0` (original data in `AtlasCarriers/source/`); Aschbacher--Smith,
F.1.12(I)(11), printed p.263; GLS, Volume 3, Table 5.3g. The involution is
computed from the published generators and verified here, rather than
accepted from a group-computation oracle.
-/

@[expose] public section

namespace Sporadic.LeechRelated.J2.ExceptionalParabolics
open GeneratorPair
set_option maxRecDepth 20000
set_option maxHeartbeats 800000

/-- Lookup table for the explicitly constructed normalizing involution. -/
def involutionValues : Fin 100 → Fin 100 :=
  ![0, 8, 28, 22, 50, 44, 35, 7, 1, 9, 10, 80, 73, 32, 93, 15, 51, 17, 71, 34,
    33, 79, 3, 29, 37, 98, 59, 57, 2, 23, 74, 72, 13, 20, 19, 6, 68, 24, 60,
    39, 40, 67, 90, 43, 5, 99, 61, 89, 53, 49, 4, 16, 54, 48, 52, 91, 96, 27,
    97, 26, 38, 46, 63, 62, 69, 87, 85, 41, 36, 64, 86, 18, 31, 12, 30, 75, 94,
    77, 84, 21, 11, 95, 88, 83, 78, 66, 70, 65, 82, 47, 42, 55, 92, 14, 76, 81,
    56, 58, 25, 45]

/-- The concrete permutation fixing `a` and inverting `b` by conjugation. -/
def involution : Equiv.Perm (Fin 100) where
  toFun := involutionValues
  invFun := involutionValues
  left_inv := by decide +kernel
  right_inv := by decide +kernel

@[simp] theorem involution_inv : involution⁻¹ = involution := by
  ext i
  rfl
@[simp] theorem involution_mul_self : involution * involution = 1 := by
  decide +kernel

theorem involution_conj_a :
    involution * generatorA * involution⁻¹ = generatorA := by
  rw [generatorA_eq_table]
  decide +kernel

theorem involution_conj_b :
    involution * generatorB * involution⁻¹ = generatorB⁻¹ := by
  rw [generatorB_eq_table]
  decide +kernel

/-- The word checks imply normalization of the generated group. -/
theorem involution_mem_normalizer : involution ∈ (Subgroup.normalizer (generated : Set _)) := by
  have hmap : generated.map (MulAut.conj involution).toMonoidHom ≤ generated := by
    apply Subgroup.map_le_iff_le_comap.mpr
    change Subgroup.closure {generatorA, generatorB} ≤ _
    apply (Subgroup.closure_le _).mpr
    intro x hx
    change involution * x * involution⁻¹ ∈ generated
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · rw [involution_conj_a]
      exact a.property
    · rw [Set.mem_singleton_iff] at hx
      subst x
      rw [involution_conj_b]
      exact generated.inv_mem b.property
  apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
  apply le_antisymm hmap
  intro x hx
  refine Subgroup.mem_map.mpr ⟨(MulAut.conj involution) x,
    hmap (Subgroup.mem_map_of_mem _ hx), ?_⟩
  change involution * (involution * x * involution⁻¹) * involution⁻¹ = x
  simp [mul_assoc, ← mul_assoc involution involution]

/-- The checked permutation acts on the actual carrier. -/
def involutionAut : MulAut Carrier :=
  generated.normalizerMonoidHom ⟨involution, involution_mem_normalizer⟩

@[simp] theorem involutionAut_a : involutionAut a = a := by
  apply Subtype.ext
  exact involution_conj_a

@[simp] theorem involutionAut_b : involutionAut b = b⁻¹ := by
  apply Subtype.ext
  exact involution_conj_b

@[simp] theorem involutionAut_sq : involutionAut ^ 2 = 1 := by
  have h : (⟨involution, involution_mem_normalizer⟩ : Subgroup.normalizer (generated : Set _)) ^ 2 = 1 := by
    apply Subtype.ext
    change involution ^ 2 = 1
    simpa only [pow_two] using involution_mul_self
  rw [involutionAut, ← map_pow, h, map_one]

theorem involutionAut_ne_one : involutionAut ≠ 1 := by
  intro h
  have hb : b⁻¹ = b := by simpa only [involutionAut_b, MulAut.one_apply] using congrArg (fun f : MulAut Carrier => f b) h
  have hh : tableB⁻¹ = tableB := by
    have hv := congrArg Subtype.val hb
    change generatorB⁻¹ = generatorB at hv
    simpa only [generatorB_eq_table] using hv
  exact (by decide +kernel : tableB⁻¹ ≠ tableB) hh

/-- The permutation extension generated by the sourced carrier and the checked involution. -/
def extension : Subgroup (Equiv.Perm (Fin 100)) :=
  generated ⊔ Subgroup.zpowers involution

abbrev Extension : Type := extension

theorem extension_le_normalizer : extension ≤ (Subgroup.normalizer (generated : Set _)) :=
  sup_le generated.le_normalizer (Subgroup.zpowers_le.mpr involution_mem_normalizer)

/-- Faithful conjugation from the concrete permutation extension to the full automorphism group. -/
def extensionAction : Extension →* MulAut Carrier :=
  generated.normalizerMonoidHom.comp (Subgroup.inclusion extension_le_normalizer)

theorem extensionAction_injective : Function.Injective extensionAction :=
  normalizer_action_injective.comp (Subgroup.inclusion_injective extension_le_normalizer)

/-- The natural inclusion of the original degree-100 carrier in the extension. -/
def intoExtension : Carrier →* Extension := Subgroup.inclusion le_sup_left

@[simp] theorem extensionAction_inner (g : Carrier) :
    extensionAction (intoExtension g) = MulAut.conj g := by
  ext x
  rfl

def extensionInvolution : Extension := ⟨involution, Subgroup.mem_sup_right (Subgroup.mem_zpowers _)⟩

@[simp] theorem extensionAction_involution :
    extensionAction extensionInvolution = involutionAut := rfl

/-- Every automorphism belongs to the permutation extension once the two
independent standard-pair orbit calculations have been discharged. -/
theorem extensionAction_surjective_of_pair_calculations
    (hfirst : ∀ x y : Carrier, PairProfile x y → ∃ g : Carrier, x = MulAut.conj g a)
    (hsecond : ∀ y : Carrier, PairProfile a y → ∃ c : Carrier,
      MulAut.conj c a = a ∧ (y = MulAut.conj c b ∨ y = MulAut.conj c b⁻¹)) :
    Function.Surjective extensionAction := by
  intro f
  obtain ⟨g, hga⟩ := hfirst (f a) (f b) (pair_profile.map f)
  let k : MulAut Carrier := (MulAut.conj g)⁻¹ * f
  have hka : k a = a := by simp [k, MulAut.mul_apply, hga, mul_assoc]
  have hk : PairProfile a (k b) := by simpa only [hka] using pair_profile.map k
  obtain ⟨c, hca, hcb⟩ := hsecond (k b) hk
  have hf (x : Carrier) : f x = MulAut.conj g (k x) := by
    simp [k, MulAut.mul_apply, mul_assoc]
  have eq_on_pair (e : MulAut Carrier) (ha : e a = f a) (hb : e b = f b) : e = f := by
    apply MulEquiv.toMonoidHom_injective
    apply MonoidHom.eq_of_eqOn_dense closure_pair_eq_top
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact ha
    · rw [Set.mem_singleton_iff] at hx
      subst x
      exact hb
  rcases hcb with hcb | hcb
  · refine ⟨intoExtension (g * c), ?_⟩
    rw [extensionAction_inner]
    apply eq_on_pair
    · rw [hf a, hka, map_mul, MulAut.mul_apply, hca]
    · rw [hf b, hcb, map_mul, MulAut.mul_apply]
  · refine ⟨intoExtension (g * c) * extensionInvolution, ?_⟩
    rw [map_mul, extensionAction_inner, extensionAction_involution]
    apply eq_on_pair
    · rw [MulAut.mul_apply, involutionAut_a, hf a, hka, map_mul,
        MulAut.mul_apply, hca]
    · rw [MulAut.mul_apply, involutionAut_b, hf b, hcb, map_mul, MulAut.mul_apply]

/-- An actual group equivalence, conditional only on the two concrete pair calculations. -/
noncomputable def extensionEquivAut_of_pair_calculations
    (hfirst : ∀ x y : Carrier, PairProfile x y → ∃ g : Carrier, x = MulAut.conj g a)
    (hsecond : ∀ y : Carrier, PairProfile a y → ∃ c : Carrier,
      MulAut.conj c a = a ∧ (y = MulAut.conj c b ∨ y = MulAut.conj c b⁻¹)) :
    Extension ≃* MulAut Carrier :=
  MulEquiv.ofBijective extensionAction
    ⟨extensionAction_injective, extensionAction_surjective_of_pair_calculations hfirst hsecond⟩

end Sporadic.LeechRelated.J2.ExceptionalParabolics
