open GeneratorPair.SecondOrbitCertificate
open Overlap

set_option maxRecDepth 100000 in
def bTable (i : Fin 384) : Equiv.Perm (Fin 100) :=
  sTable ⟨i.val % 128, Nat.mod_lt _ (by decide)⟩ * (oddTable 1) ^ (i.val / 128)

def extensionTable (i : Fin 768) : Equiv.Perm (Fin 100) :=
  bTable ⟨i.val % 384, Nat.mod_lt _ (by decide)⟩ * outerTable ^ (i.val / 384)

def xTable : Equiv.Perm (Fin 100) := sTable 71

