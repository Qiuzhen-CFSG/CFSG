module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.McL.ThreeRank.Elementary

/-!
# A concrete candidate Sylow three-subgroup of McL

Adjoin the two additional certified words to the elementary subgroup of order
81. This fixes the shared subgroup for two independent calculations: its
internal structure and the three-part of the ambient permutation group's order.
No assertion that the candidate is Sylow, or even a three-group, is used here.

Source guidance: GLS volume 3, Table 5.3n, `N(J(S₃)) = E₈₁.M₁₀`.
Discovery words and unproved structural observations are retained in `source/`.
-/

namespace Sporadic.LeechRelated.McL
open Subgroup ThreeRank

/-- The subgroup generated by the elementary witness and the two additional words. -/
@[expose] public def threeCandidate : Subgroup Carrier :=
  (threeElementary ⊔ zpowers u) ⊔ zpowers v

public theorem threeElementary_le_threeCandidate : threeElementary ≤ threeCandidate :=
  le_trans le_sup_left le_sup_left

public theorem u_mem_threeCandidate : u ∈ threeCandidate := by
  exact (le_sup_left : threeElementary ⊔ zpowers u ≤ threeCandidate)
    ((le_sup_right : zpowers u ≤ threeElementary ⊔ zpowers u) (mem_zpowers u))

public theorem v_mem_threeCandidate : v ∈ threeCandidate := by
  exact (le_sup_right : zpowers v ≤ threeCandidate) (mem_zpowers v)

end Sporadic.LeechRelated.McL
