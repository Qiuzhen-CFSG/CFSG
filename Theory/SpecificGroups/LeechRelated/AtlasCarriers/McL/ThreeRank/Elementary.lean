module
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.McL.ThreeRank.Elements
public import Theory.GroupTheory.PrimeRankFixedJoin
public import Theory.ElementaryAbelian.Quotient
public import Mathlib.GroupTheory.NoncommCoprod

/-!
# An elementary subgroup of order 81 in the degree-275 McL carrier

Four certified commuting words define a homomorphism from four copies of the
additive group of `ZMod 3`. Its kernel is trivial: evaluation on letter 2
distinguishes the 81 coordinate products. Its range is therefore elementary
abelian of order 81 and gives the unconditional ordinary three-rank lower bound.

Source: GLS volume 3, Tables 5.3n and 5.6.1; Aschbacher–Smith,
*The Classification of Quasithin Groups*, printed p. 41 (PDF p. 52).
This uses only the original permutation generators, with no ambient order,
simplicity, local-structure, or covering-group assumption.
-/

namespace Sporadic.LeechRelated.McL.ThreeRank

set_option maxRecDepth 100000

private def cyclicHom (g : Carrier) (hg : g ^ 3 = 1) :
    Multiplicative (ZMod 3) →* Carrier where
  toFun v := g ^ v.toAdd.val
  map_one' := by simp
  map_mul' u v := by
    change g ^ (u.toAdd + v.toAdd).val = g ^ u.toAdd.val * g ^ v.toAdd.val
    rw [ZMod.val_add, ← pow_eq_pow_mod _ hg, pow_add]

/-- Four ternary coordinates for the explicit elementary abelian subgroup. -/
public abbrev Coordinates :=
  (Multiplicative (ZMod 3) × Multiplicative (ZMod 3)) ×
    (Multiplicative (ZMod 3) × Multiplicative (ZMod 3))

/-- The product of the four certified commuting generators. -/
public def embedding : Coordinates →* Carrier :=
  ((cyclicHom x x_cube).noncommCoprod (cyclicHom y y_cube)
    (fun u v => xy.pow_pow u.toAdd.val v.toAdd.val)).noncommCoprod
  ((cyclicHom z z_cube).noncommCoprod (cyclicHom t t_cube)
    (fun u v => zt.pow_pow u.toAdd.val v.toAdd.val))
  (fun u v => ((xz.pow_pow u.1.toAdd.val v.1.toAdd.val).mul_left
    (yz.pow_pow u.2.toAdd.val v.1.toAdd.val)).mul_right
    ((xt.pow_pow u.1.toAdd.val v.2.toAdd.val).mul_left
    (yt.pow_pow u.2.toAdd.val v.2.toAdd.val)))

/-- The coordinate formula, independent of the homomorphism implementation. -/
public theorem embedding_apply (w : Coordinates) :
    embedding w = (x ^ w.1.1.toAdd.val * y ^ w.1.2.toAdd.val) *
      (z ^ w.2.1.toAdd.val * t ^ w.2.2.toAdd.val) := by rfl

public theorem embedding_injective : Function.Injective embedding := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply (Subgroup.eq_bot_iff_forall _).mpr
  intro v hv
  have h : ∀ w : Coordinates, (embedding w : Equiv.Perm (Fin 275)) 2 = 2 → w = 1 := by
    decide +kernel
  exact h v (congrArg (fun g : Carrier => (g : Equiv.Perm (Fin 275)) 2) hv)

public instance coordinates_elementary : IsElementaryAbelian 3 Coordinates where
  toIsMulCommutative := inferInstance
  exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (by decide +kernel)

end Sporadic.LeechRelated.McL.ThreeRank

namespace Sporadic.LeechRelated.McL

/-- A concrete elementary abelian subgroup generated by four words in the
published degree-275 ATLAS generators. -/
@[expose] public def threeElementary : Subgroup Carrier := ThreeRank.embedding.range

public instance threeElementary_elementary : IsElementaryAbelian 3 threeElementary :=
  IsElementaryAbelian.of_surjective ThreeRank.embedding.rangeRestrict
    ThreeRank.embedding.rangeRestrict_surjective

/-- The explicit isomorphism from four ternary coordinates onto the witness. -/
public noncomputable def threeElementaryEquiv : ThreeRank.Coordinates ≃* threeElementary :=
  MonoidHom.ofInjective ThreeRank.embedding_injective

/-- The subgroup has order 81, with all four independent generators certified. -/
public theorem threeElementary_card : Nat.card threeElementary = 3 ^ 4 := by
  change Nat.card ThreeRank.embedding.range = 3 ^ 4
  rw [← Nat.card_congr (MonoidHom.ofInjective ThreeRank.embedding_injective).toEquiv]
  rw [Nat.card_eq_fintype_card]
  decide +kernel

/-- The explicit order-81 witness gives the lower bound in the McL rank calculation. -/
public theorem four_le_primeRank_three : 4 ≤ primeRank 3 Carrier :=
  IsElementaryAbelian.primeRank_ge_of_card threeElementary threeElementary_card

/-- The ordinary-rank obstruction consumed by the strongly quasithin branch. -/
public theorem two_lt_primeRank_three : 2 < primeRank 3 Carrier :=
  lt_of_lt_of_le (by decide : 2 < 4) four_le_primeRank_three

end Sporadic.LeechRelated.McL
