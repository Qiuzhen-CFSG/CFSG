def aMap (i : Fin 275) : Fin 275 :=
  ⟨(aMapPacked >>> (9 * i.val)) % 512 % 275, Nat.mod_lt _ (by decide)⟩

def aInvMapPacked : Nat := 

def aInvMap (i : Fin 275) : Fin 275 :=
  ⟨(aInvMapPacked >>> (9 * i.val)) % 512 % 275, Nat.mod_lt _ (by decide)⟩

theorem aLeft : ∀ i, aInvMap (aMap i) = i := by
  apply allFin
  decide +kernel

def aPerm : Equiv.Perm (Fin 275) :=
  Theory.GroupTheory.tablePerm aMap aInvMap aLeft
    (Theory.GroupTheory.rightInverse_of_leftInverse_fin aLeft)

theorem aPerm_eq_generator : aPerm = generatorA := by
  apply Equiv.ext
  apply allFin
  decide +kernel

def a : Carrier := ⟨aPerm, aPerm_eq_generator.symm ▸
  Subgroup.subset_closure (by simp)⟩

