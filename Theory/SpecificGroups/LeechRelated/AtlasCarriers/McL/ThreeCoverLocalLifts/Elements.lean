theorem xPerm_eq_word : xPerm = (xWord : Equiv.Perm (Fin 275)) := by
  apply Equiv.ext
  apply allFin
  decide +kernel

def x : Carrier := ⟨xPerm, xPerm_eq_word.symm ▸ xWord.property⟩

