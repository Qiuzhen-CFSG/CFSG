module
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.McL.ThreeRank.Elements

/-!
# A marked elementary nine in an involution centralizer of McL

The elements below are words in the exact degree-275 ATLAS generators.
Packed point maps certify membership and the relations needed to split
this elementary nine across a central three-extension. The generators
`x`, `y` centralize `t`; `r` inverts only `x` and `s` inverts only `y`.

Source: ATLAS McLG1-p275B0, with original data and conventions in the
carrier module. This supplies a direct two-local construction for
Aschbacher--Smith A.2.19, printed p.41; unlike the ordinary-rank statement
I.2.1, it retains a nonidentity involution. GAP is used only for discovery;
Lean's kernel verifies all word identities and relations.
-/

@[expose] public section
namespace Sporadic.LeechRelated.McL.ThreeCoverLocal
open ThreeRank (a b allFin)
set_option maxRecDepth 100000
set_option Elab.async false

abbrev t : Carrier := a

def xMapPacked : Nat := 

def xMap (i : Fin 275) : Fin 275 :=
  ⟨(xMapPacked >>> (9 * i.val)) % 512 % 275, Nat.mod_lt _ (by decide)⟩

def xInvMapPacked : Nat := 

def xInvMap (i : Fin 275) : Fin 275 :=
  ⟨(xInvMapPacked >>> (9 * i.val)) % 512 % 275, Nat.mod_lt _ (by decide)⟩

theorem xLeft : ∀ i, xInvMap (xMap i) = i := by
  apply allFin
  decide +kernel

def xPerm : Equiv.Perm (Fin 275) :=
  Theory.GroupTheory.tablePerm xMap xInvMap xLeft
    (Theory.GroupTheory.rightInverse_of_leftInverse_fin xLeft)

