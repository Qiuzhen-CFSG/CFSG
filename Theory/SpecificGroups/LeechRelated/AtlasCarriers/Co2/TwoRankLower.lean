module
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co2.CentralizerSection.Words
public import Theory.GroupTheory.WordSubgroup
public import Theory.GroupTheory.PrimeRankWitness
public import Mathlib.GroupTheory.NoncommCoprod

/-!
# An elementary eight in the Co₂ carrier

Three short words in the certified centralizing generators are commuting
involutions, independently detected on a marked point. All identities are
checked on the literal 2300-point ATLAS action. The local generator action
is reused, so the new certificate does not unfold the long ambient words.
Source: ATLAS Co2G1-p2300B0; Aschbacher–Smith A.2.12, printed p.36.
-/

namespace Sporadic.LeechRelated.Co2.TwoRank
open CentralizerSection Theory.GroupTheory
set_option maxRecDepth 20000
private abbrev c : Carrier := localGenerator 0
private abbrev d : Carrier := localGenerator 1
private def checkFin {n : Nat} (f : Fin n → Bool) : Bool :=
  (List.range n).all (fun i => if h : i < n then f ⟨i, h⟩ else true)
private theorem allFin {n : Nat} (P : Fin n → Prop) [DecidablePred P]
    (h : checkFin (fun i => decide (P i)) = true) : ∀ i, P i := by
  intro i
  have hi := List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt)
  simpa only [dif_pos i.isLt, decide_eq_true_eq] using hi
private def packedMap (v : Nat) (i : Fin 2300) : Fin 2300 :=
  ⟨(v >>> (12 * i.val)) % 4096 % 2300, Nat.mod_lt _ (by decide)⟩
private def fastA : Equiv.Perm (Fin 2300) :=
  tablePerm (packedMap ) (packedMap )
    (by apply allFin; decide +kernel) (by apply allFin; decide +kernel)
private theorem inclusion_c : inclusion c = fastA := by
  apply Equiv.ext
  intro i
  rw [show inclusion c = localTable 0 from localGenerator_inclusion 0, localTable_apply]
  exact (by apply allFin; decide +kernel : ∀ j, localFast 0 j = fastA j) i
private def fastB : Equiv.Perm (Fin 2300) :=
  tablePerm (packedMap ) (packedMap )
    (by apply allFin; decide +kernel) (by apply allFin; decide +kernel)
private theorem inclusion_d : inclusion d = fastB := by
  apply Equiv.ext
  intro i
  rw [show inclusion d = localTable 1 from localGenerator_inclusion 1, localTable_apply]
  exact (by apply allFin; decide +kernel : ∀ j, localFast 1 j = fastB j) i
private theorem inclusion_word (w : List (Fin 4)) :
    inclusion (evalWord ![c,d,d⁻¹,c⁻¹] w) = evalWord ![fastA,fastB,fastB⁻¹,fastA⁻¹] w := by
  induction w with
  | nil => exact map_one inclusion
  | cons i w ih =>
    rw [evalWord, map_mul, ih, evalWord]
    congr 1
    fin_cases i <;> simp [inclusion_c, inclusion_d]
private abbrev C2 := Multiplicative (ZMod 2)
private abbrev E := (C2 × C2) × C2

private def binaryHom {H : Type*} [Group H] (g : H) (hg : g ^ 2 = 1) : C2 →* H where
  toFun a := if a = 1 then 1 else g
  map_one' := by simp
  map_mul' a b := by
    have cases2 : ∀ x : C2, x = 1 ∨ x = Multiplicative.ofAdd 1 := by decide +kernel
    have hsum : (Multiplicative.ofAdd (1 : ZMod 2)) * Multiplicative.ofAdd 1 = 1 := rfl
    have hone : Multiplicative.ofAdd (1 : ZMod 2) ≠ 1 := by decide +kernel
    rcases cases2 a with rfl | rfl <;> rcases cases2 b with rfl | rfl <;>
      simp [hsum, hone, ← pow_two, hg]

private theorem binary_commute {H : Type*} [Group H] {a b : H}
    (ha : a ^ 2 = 1) (hb : b ^ 2 = 1) (hab : Commute a b) (x y : C2) :
    Commute (binaryHom a ha x) (binaryHom b hb y) := by
  change Commute (if x = 1 then 1 else a) (if y = 1 then 1 else b)
  split_ifs <;> simp [hab]

private def tripleHom {H : Type*} [Group H] (a b c : H)
    (ha : a ^ 2 = 1) (hb : b ^ 2 = 1) (hc : c ^ 2 = 1)
    (hab : Commute a b) (hac : Commute a c) (hbc : Commute b c) : E →* H :=
  ((binaryHom a ha).noncommCoprod (binaryHom b hb) (binary_commute ha hb hab)).noncommCoprod
    (binaryHom c hc) (fun x y =>
      (binary_commute ha hc hac x.1 y).mul_left (binary_commute hb hc hbc x.2 y))

private def xWord : List (Fin 4) := [2, 2, 2, 0, 2, 0, 1, 0, 1, 0, 0, 2, 0, 0, 2, 0, 0, 2, 0, 0, 1, 3, 1, 0, 1, 3, 1, 1, 1, 3, 2, 2, 2, 2, 0]
private def x : Carrier := evalWord ![c,d,d⁻¹,c⁻¹] xWord
private def xTable : Equiv.Perm (Fin 2300) :=
  tablePerm (packedMap ) (packedMap )
    (by apply allFin; decide +kernel) (by apply allFin; decide +kernel)
private theorem x_table : inclusion x = xTable := by
  rw [x, inclusion_word]
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem x_sq : x ^ 2 = 1 := by
  apply inclusion_injective
  rw [map_pow, map_one, x_table]
  apply Equiv.ext
  apply allFin
  decide +kernel
private def yWord : List (Fin 4) := [1, 0, 2, 0, 1, 0, 1, 0, 0, 2, 0, 0, 2, 0, 0, 2, 0, 0, 2, 3, 2, 3, 1, 0, 1, 1, 3, 2, 2, 3, 2, 0, 2, 2, 2, 0, 2, 2, 2, 0, 1, 3, 2, 3, 3, 2, 0, 1, 1, 3]
private def y : Carrier := evalWord ![c,d,d⁻¹,c⁻¹] yWord
private def yTable : Equiv.Perm (Fin 2300) :=
  tablePerm (packedMap ) (packedMap )
    (by apply allFin; decide +kernel) (by apply allFin; decide +kernel)
private theorem y_table : inclusion y = yTable := by
  rw [y, inclusion_word]
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem y_sq : y ^ 2 = 1 := by
  apply inclusion_injective
  rw [map_pow, map_one, y_table]
  apply Equiv.ext
  apply allFin
  decide +kernel
private def zWord : List (Fin 4) := [2, 2, 2, 2, 2, 2, 0, 1, 0, 1, 0, 0, 0, 0, 0, 0, 2, 3, 2, 2, 3, 2, 0, 2, 3, 1, 0, 0, 1, 1, 1, 1, 3, 3, 3, 1, 1, 1, 1, 0, 2, 3, 1, 0, 0, 0, 1, 0, 1, 3, 2, 2, 3, 3, 3, 2, 0, 2, 3, 2, 0]
private def z : Carrier := evalWord ![c,d,d⁻¹,c⁻¹] zWord
private def zTable : Equiv.Perm (Fin 2300) :=
  tablePerm (packedMap ) (packedMap )
    (by apply allFin; decide +kernel) (by apply allFin; decide +kernel)
private theorem z_table : inclusion z = zTable := by
  rw [z, inclusion_word]
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem z_sq : z ^ 2 = 1 := by
  apply inclusion_injective
  rw [map_pow, map_one, z_table]
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem xy : Commute x y := by
  apply inclusion_injective
  rw [map_mul, map_mul, x_table, y_table]
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem xz : Commute x z := by
  apply inclusion_injective
  rw [map_mul, map_mul, x_table, z_table]
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem yz : Commute y z := by
  apply inclusion_injective
  rw [map_mul, map_mul, y_table, z_table]
  apply Equiv.ext
  apply allFin
  decide +kernel
private def embedding : E →* Carrier := tripleHom x y z x_sq y_sq z_sq xy xz yz
private theorem image (a : E) :
    inclusion (embedding a) =
      (if a.1.1 = 1 then 1 else xTable) *
      (if a.1.2 = 1 then 1 else yTable) *
      (if a.2 = 1 then 1 else zTable) := by
  simp only [embedding, tripleHom, MonoidHom.noncommCoprod_apply, binaryHom,
    MonoidHom.coe_mk, OneHom.coe_mk, map_mul]
  split_ifs <;> simp [x_table, y_table, z_table]
private theorem detected : ∀ a : E,
    ((if a.1.1 = 1 then 1 else xTable) *
      (if a.1.2 = 1 then 1 else yTable) *
      (if a.2 = 1 then 1 else zTable)) 1 = 1 → a = 1 := by
  decide +kernel
private theorem embedding_injective : Function.Injective embedding := by
  rw [injective_iff_map_eq_one]
  intro a ha
  apply detected
  have he := congrArg (fun g => inclusion g 1) ha
  simpa only [image, map_one, Equiv.Perm.one_apply] using he
/-- The literal Co₂ carrier contains an elementary eight. -/
public theorem three_le_twoRank : 3 ≤ primeRank 2 Carrier := by
  apply primeRank_ge_of_elementary_embedding (f := embedding)
  · exact (by decide +kernel : ∀ a : E, a ^ 2 = 1)
  · simp [E, C2, Nat.card_eq_fintype_card]
  · exact embedding_injective
end Sporadic.LeechRelated.Co2.TwoRank
