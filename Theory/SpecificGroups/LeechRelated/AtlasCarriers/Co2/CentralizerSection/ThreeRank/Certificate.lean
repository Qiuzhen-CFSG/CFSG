private theorem pointCheck_true (x : Fin 2300) : pointCheck x = true := by
  have hx := Sporadic.Fischer.Fi22.KernelCertificate.BitNetwork.check_sound
    _ 0 2300 checks x.val (Nat.zero_le _) x.isLt
  simpa only [Nat.mod_eq_of_lt x.isLt] using hx

theorem inverse_check (i : Fin 2) (x : Fin 2300) :
    localFast i (inverseFast i x) = x :=
  (of_decide_eq_true (pointCheck_true x)).1 i

theorem word_check (i : Fin 3) (x : Fin 2300) :
    evalFast (words i) x = elementFast i x :=
  (of_decide_eq_true (pointCheck_true x)).2.1 i

theorem cube_check (i : Fin 3) (x : Fin 2300) :
    elementFast i (elementFast i (elementFast i x)) = x :=
  (of_decide_eq_true (pointCheck_true x)).2.2.1 i

theorem commute_check (i j : Fin 3) (x : Fin 2300) :
    elementFast i (elementFast j x) = elementFast j (elementFast i x) :=
  (of_decide_eq_true (pointCheck_true x)).2.2.2 i j


