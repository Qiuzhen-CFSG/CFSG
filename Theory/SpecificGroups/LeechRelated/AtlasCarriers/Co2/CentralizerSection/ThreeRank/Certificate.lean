private theorem checks : checkRange 0 2300 = true :=
  checkRange_append 0 100 2200 check00
  (checkRange_append 100 100 2100 check01
    (checkRange_append 200 100 2000 check02
      (checkRange_append 300 100 1900 check03
        (checkRange_append 400 100 1800 check04
          (checkRange_append 500 100 1700 check05
            (checkRange_append 600 100 1600 check06
              (checkRange_append 700 100 1500 check07
                (checkRange_append 800 100 1400 check08
                  (checkRange_append 900 100 1300 check09
                    (checkRange_append 1000 100 1200 check10
                      (checkRange_append 1100 100 1100 check11
                        (checkRange_append 1200 100 1000 check12
                          (checkRange_append 1300 100 900 check13
                            (checkRange_append 1400 100 800 check14
                              (checkRange_append 1500 100 700 check15
                                (checkRange_append 1600 100 600 check16
