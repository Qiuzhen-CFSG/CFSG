/-!
# Checked cubic words in the fixed Co₂ centralizing subgroup

The finite certificate evaluates three words in the existing two generators
and their inverses, checks their cubes and pairwise commutation, and exposes
their literal point maps. The word interpretation in `ThreeRank.Words` uses
these identities to construct an elementary subgroup in the original numerator.

Every numerical identity is checked by Lean's kernel. Checks are divided into
100-point ranges to bound normalization memory; `BitNetwork.check_append` and
`check_sound` assemble all 2300 points. See `source/README.md` for measurements,
reproduction, and the retained discovery words.

Source: ATLAS Co2G1-p2300B0; GLS3 Table 5.3k; Aschbacher–Smith A.2.19.
-/

@[expose] public section
namespace Sporadic.LeechRelated.Co2.CentralizerSection.ThreeRank

-- BEGIN GENERATED NUMERICAL DATA
def words : Fin 3 → List (Fin 4) := ![[2, 3, 3, 0, 3, 2, 1, 1, 0, 3, 2, 3, 2, 2, 2, 3, 0, 0, 0, 3, 3, 3, 3, 2, 2, 2, 3, 3, 3, 2, 2, 1, 2, 2, 1, 2, 2, 3, 2, 3, 2, 1, 2, 1], [3, 3, 0, 1, 0, 0, 0, 0, 3, 0, 3, 2, 3, 3, 3, 2, 2, 2, 2, 3, 3, 2, 1, 1, 1, 0, 1, 0, 0, 1, 2, 3, 2, 1, 2], [2, 3, 0, 1, 2, 2, 2, 3, 2, 2, 1, 0, 3, 3, 2, 2, 3, 0, 1, 1, 0, 3, 3, 0, 0, 0, 0, 0, 3, 0, 0, 3, 2, 3, 0, 1, 2, 1, 0, 1, 1, 0, 1, 2, 2, 2, 2, 2, 2, 3, 2, 3, 2]]

def inversePacked : Fin 2 → Nat := ![, ]

def inverseFast (i : Fin 2) (x : Fin 2300) : Fin 2300 :=
  ⟨((inversePacked i) >>> (12 * x.val)) % 4096 % 2300, Nat.mod_lt _ (by decide)⟩

def elementPacked : Fin 3 → Nat := ![, , ]

def elementFast (i : Fin 3) (x : Fin 2300) : Fin 2300 :=
  ⟨((elementPacked i) >>> (12 * x.val)) % 4096 % 2300, Nat.mod_lt _ (by decide)⟩

def letterFast : Fin 4 → Fin 2300 → Fin 2300 :=
  ![localFast 0, localFast 1, inverseFast 0, inverseFast 1]

def evalFast : List (Fin 4) → Fin 2300 → Fin 2300
  | [], x => x
  | i :: w, x => letterFast i (evalFast w x)

-- END GENERATED NUMERICAL DATA

private def pointCheck (x : Fin 2300) : Bool := decide (
    (∀ i : Fin 2, localFast i (inverseFast i x) = x) ∧
    (∀ i : Fin 3, evalFast (words i) x = elementFast i x) ∧
    (∀ i : Fin 3, elementFast i (elementFast i (elementFast i x)) = x) ∧
    (∀ i j : Fin 3, elementFast i (elementFast j x) = elementFast j (elementFast i x)))

private def checkRange (start count : Nat) : Bool :=
  Sporadic.Fischer.Fi22.KernelCertificate.BitNetwork.check
    (fun k => pointCheck ⟨k % 2300, Nat.mod_lt _ (by decide)⟩) start count

private theorem checkRange_append (start a b : Nat)
    (ha : checkRange start a = true) (hb : checkRange (start + a) b = true) :
    checkRange start (a + b) = true :=
  Sporadic.Fischer.Fi22.KernelCertificate.BitNetwork.check_append _ start a b ha hb

