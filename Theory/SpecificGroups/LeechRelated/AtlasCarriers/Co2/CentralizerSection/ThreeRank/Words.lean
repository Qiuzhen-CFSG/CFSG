module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co2.CentralizerSection.ThreeRank.Certificate

/-!
# Three commuting cubic words in the actual Co₂ numerator

Interpret the checked word lists in the existing subgroup generated by the two
centralizing words. The inclusion in the fixed degree-2300 permutation carrier
is injective, so the numerical cube and commutation identities are identities
of these actual group elements. No abstract presentation or model comparison
is used. The next module proves independence on a 27-point orbit.

Source: ATLAS Co2G1-p2300B0; GLS3 Table 5.3k, the 2A involution centralizer;
Aschbacher–Smith A.2.19. The new word witnesses are retained in `source/`.
-/

@[expose] public section
namespace Sporadic.LeechRelated.Co2.CentralizerSection.ThreeRank

/-- The four letters are the two existing centralizing words and their inverses. -/
def letter : Fin 4 → numerator :=
  ![numeratorGenerator 0, numeratorGenerator 1,
    (numeratorGenerator 0)⁻¹, (numeratorGenerator 1)⁻¹]

/-- The three certified commuting cubic words, inside the actual numerator. -/
def element (i : Fin 3) : numerator := Theory.GroupTheory.evalWord letter (words i)

def permutation : numerator →* Equiv.Perm (Fin 2300) := inclusion.comp numerator.subtype

theorem permutation_injective : Function.Injective permutation :=
  inclusion_injective.comp Subtype.val_injective

private theorem permutation_generator (i : Fin 2) :
    permutation (numeratorGenerator i) = localTable i := localGenerator_inclusion i

private def letterTable : Fin 4 → Equiv.Perm (Fin 2300) :=
  ![localTable 0, localTable 1, (localTable 0)⁻¹, (localTable 1)⁻¹]

private theorem permutation_letter (i : Fin 4) :
    permutation (letter i) = letterTable i := by
  fin_cases i
  · exact permutation_generator 0
  · exact permutation_generator 1
  · exact (map_inv permutation _).trans (congrArg Inv.inv (permutation_generator 0))
  · exact (map_inv permutation _).trans (congrArg Inv.inv (permutation_generator 1))

private theorem letterTable_apply (i : Fin 4) (x : Fin 2300) :
    letterTable i x = letterFast i x := by
  have hi (j : Fin 2) : (localTable j)⁻¹ x = inverseFast j x := by
    apply (localTable j).symm_apply_eq.mpr
    rw [localTable_apply]
    exact (inverse_check j x).symm
  fin_cases i
  · exact localTable_apply 0 x
  · exact localTable_apply 1 x
  · exact hi 0
  · exact hi 1

/-- The numerical map is the action of the literal word, not a replacement carrier. -/
theorem element_apply (i : Fin 3) (x : Fin 2300) :
    permutation (element i) x = elementFast i x := by
  have hw (w : List (Fin 4)) (y : Fin 2300) :
      permutation (Theory.GroupTheory.evalWord letter w) y = evalFast w y := by
    induction w generalizing y with
    | nil => rfl
    | cons j w ih =>
      rw [Theory.GroupTheory.evalWord, map_mul, Equiv.Perm.mul_apply,
        permutation_letter, letterTable_apply, ih]
      rfl
  exact (hw _ _).trans (word_check i x)

/-- Each of the three actual words has cube one. -/
theorem element_cube (i : Fin 3) : element i ^ 3 = 1 := by
  apply permutation_injective
  rw [map_pow, map_one]
  apply Equiv.ext
  intro x
  simp only [pow_succ, pow_zero, Equiv.Perm.mul_apply]
  rw [element_apply, element_apply, element_apply]
  exact cube_check i x

/-- The actual words commute pairwise. -/
theorem element_commute (i j : Fin 3) : Commute (element i) (element j) := by
  change element i * element j = element j * element i
  apply permutation_injective
  rw [map_mul, map_mul]
  apply Equiv.ext
  intro x
  simp only [Equiv.Perm.mul_apply, element_apply]
  exact commute_check i j x

end Sporadic.LeechRelated.Co2.CentralizerSection.ThreeRank
