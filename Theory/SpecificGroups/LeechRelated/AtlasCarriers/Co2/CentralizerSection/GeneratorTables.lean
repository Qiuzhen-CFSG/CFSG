module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co2
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22KernelCertificate.GraphInvariance.CycleCheck
public import Theory.SpecificGroups.Fischer.AtlasCarriers.Fi22KernelCertificate.GraphInvariance.BitNetwork

/-!
# Checked lookup maps for the fixed Co2 generators

Each packed map is compared with the individual disjoint source cycles and
with their fixed complement. This avoids evaluating the entire cycle product
at every point. The comparison includes inversion of the source right action.
All numerical equalities are checked by the Lean kernel.

Source: ATLAS Co2G1-p2300B0, original files and attribution in
`AtlasCarriers/source/`; reproducible generation in `source/generate.py`.
-/

@[expose] public section
namespace Sporadic.LeechRelated.Co2.CentralizerSection
open Sporadic.Fischer.AtlasCarriers
open Sporadic.Fischer.Fi22.KernelCertificate

def packedA : Nat := 

def fastA (x : Fin 2300) : Fin 2300 :=
  ⟨(packedA >>> (12 * x.val)) % 4096 % 2300, Nat.mod_lt _ (by decide)⟩

def packedB : Nat := 

def fastB (x : Fin 2300) : Fin 2300 :=
  ⟨(packedB >>> (12 * x.val)) % 4096 % 2300, Nat.mod_lt _ (by decide)⟩

def packedBInv : Nat := 

def fastBInv (x : Fin 2300) : Fin 2300 :=
  ⟨(packedBInv >>> (12 * x.val)) % 4096 % 2300, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 20000 in
private theorem cyclesA_nodup : cyclesA.flatten.Nodup := by
  apply nodup_of_checkFreshPoints
  decide +kernel

set_option maxRecDepth 20000 in
private theorem cycleCheckA :
    (cyclesA.all fun c => c.all fun x => decide (c.formPerm (fastA x) = x)) = true := by
  decide +kernel

set_option maxRecDepth 20000 in
private theorem fixedCheckA :
    BitNetwork.check (fun i => (CycleCheck.mask cyclesA.flatten).testBit i ||
      decide (fastA ⟨i % 2300, Nat.mod_lt _ (by decide)⟩ =
        ⟨i % 2300, Nat.mod_lt _ (by decide)⟩)) 0 2300 = true := by
  decide +kernel

/-- The lookup map evaluates the literal inverse ATLAS cycle product. -/
theorem generatorA_apply (x : Fin 2300) : generatorA x = fastA x := by
  apply CycleCheck.inverse_prod_eq cyclesA fastA cyclesA_nodup
  · simpa only [List.all_eq_true, decide_eq_true_eq] using cycleCheckA
  · intro y hy
    have h := BitNetwork.check_sound _ 0 2300 fixedCheckA y.val (Nat.zero_le _) y.isLt
    simpa only [hy, Bool.false_or, Nat.mod_eq_of_lt y.isLt, decide_eq_true_eq] using h

set_option maxRecDepth 20000 in
private theorem cyclesB_nodup : cyclesB.flatten.Nodup := by
  apply nodup_of_checkFreshPoints
  decide +kernel

set_option maxRecDepth 20000 in
private theorem cycleCheckB :
    (cyclesB.all fun c => c.all fun x => decide (c.formPerm (fastB x) = x)) = true := by
  decide +kernel

set_option maxRecDepth 20000 in
private theorem fixedCheckB :
    BitNetwork.check (fun i => (CycleCheck.mask cyclesB.flatten).testBit i ||
      decide (fastB ⟨i % 2300, Nat.mod_lt _ (by decide)⟩ =
        ⟨i % 2300, Nat.mod_lt _ (by decide)⟩)) 0 2300 = true := by
  decide +kernel

/-- The lookup map evaluates the literal inverse ATLAS cycle product. -/
theorem generatorB_apply (x : Fin 2300) : generatorB x = fastB x := by
  apply CycleCheck.inverse_prod_eq cyclesB fastB cyclesB_nodup
  · simpa only [List.all_eq_true, decide_eq_true_eq] using cycleCheckB
  · intro y hy
    have h := BitNetwork.check_sound _ 0 2300 fixedCheckB y.val (Nat.zero_le _) y.isLt
    simpa only [hy, Bool.false_or, Nat.mod_eq_of_lt y.isLt, decide_eq_true_eq] using h

set_option maxRecDepth 20000 in
private theorem fastA_involutive : ∀ x, fastA (fastA x) = x := by decide +kernel

set_option maxRecDepth 20000 in
private theorem fastB_left_inv : ∀ x, fastBInv (fastB x) = x := by decide +kernel

set_option maxRecDepth 20000 in
private theorem fastB_right_inv : ∀ x, fastB (fastBInv x) = x := by decide +kernel

def tableA : Equiv.Perm (Fin 2300) where
  toFun := fastA
  invFun := fastA
  left_inv := by exact fastA_involutive
  right_inv := by exact fastA_involutive

def tableB : Equiv.Perm (Fin 2300) where
  toFun := fastB
  invFun := fastBInv
  left_inv := by exact fastB_left_inv
  right_inv := by exact fastB_right_inv

theorem generatorA_eq_table : generatorA = tableA := Equiv.ext generatorA_apply

theorem generatorB_eq_table : generatorB = tableB := Equiv.ext generatorB_apply

end Sporadic.LeechRelated.Co2.CentralizerSection
