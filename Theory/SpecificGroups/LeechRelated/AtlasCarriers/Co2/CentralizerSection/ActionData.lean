module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co2.CentralizerSection.Words
public import Theory.SpecificGroups.PSp4Three.Transvections
public import Mathlib.Data.ZMod.Basic

/-!
# The six-dimensional binary action of the centralizing Co2 words

A coloring of the 2300 letters assigns each of 63 blocks a distinct nonzero
binary vector and assigns zero to their complement. Every binary vector has
a representative. The two literal centralizing words respect this coloring
through the displayed symplectic matrices. These are checked identities,
not a recognition based on group orders or family names.

Source: ATLAS Co2G1-p2300B0 and GLS3 Table 5.3k. Reproduce the finite data
with `source/geometry.g` and `source/generate.py`.
-/

@[expose] public section
namespace Sporadic.LeechRelated.Co2.CentralizerSection
open Matrix Matrix.PSp4Three

abbrev V := Vector 3 (ZMod 2)
abbrev S := Sp 3 (ZMod 2)

/-- The coordinate numbering is e₁,e₂,e₃,f₁,f₂,f₃. -/
def coordinate : Index 3 → Fin 6 := Sum.elim (fun i => ⟨i.val, by omega⟩)
  (fun i => ⟨3 + i.val, by omega⟩)

def vector (i : Fin 64) : V := fun j => if i.val.testBit (coordinate j).val then 1 else 0

set_option maxRecDepth 20000 in
theorem vector_surjective : Function.Surjective vector := by decide +kernel

def colorPacked : Nat := 

/-- Zero is the unused color; the nonzero fibers are the 63 chosen blocks. -/
def colorIndex (x : Fin 2300) : Fin 64 :=
  ⟨(colorPacked >>> (6 * x.val)) % 64, Nat.mod_lt _ (by decide)⟩

def color (x : Fin 2300) : V := vector (colorIndex x)

def basePoint : Fin 64 → Fin 2300 := ![19, 0, 3, 202, 12, 24, 124, 193, 1, 9, 150, 122, 10, 44, 14, 177, 5, 74, 129, 31, 16, 66, 36, 311, 7, 189, 73, 156, 151, 56, 277, 60, 27, 40, 75, 267, 102, 78, 17, 41, 85, 4, 13, 45, 37, 39, 34, 149, 208, 136, 52, 26, 63, 20, 15, 172, 67, 70, 92, 55, 23, 2, 18, 29]

set_option maxRecDepth 20000 in
theorem color_basePoint : ∀ i, color (basePoint i) = vector i := by decide +kernel

theorem color_surjective : Function.Surjective color := by
  intro v
  obtain ⟨i, rfl⟩ := vector_surjective v
  exact ⟨basePoint i, color_basePoint i⟩

def column0 : Fin 6 → Fin 64 := ![57, 25, 35, 13, 53, 16]

def column1 : Fin 6 → Fin 64 := ![55, 35, 34, 53, 10, 12]

def actionMatrix (i : Fin 2) : Matrix (Index 3) (Index 3) (ZMod 2) :=
  fun row col => vector ((![column0, column1] i) (coordinate col)) row

set_option maxRecDepth 20000 in
private theorem actionMatrix_mem : ∀ i,
    actionMatrix i ∈ Matrix.symplecticGroup (Fin 3) (ZMod 2) := by
  change ∀ i, actionMatrix i * Matrix.J (Fin 3) (ZMod 2) * (actionMatrix i).transpose =
    Matrix.J (Fin 3) (ZMod 2)
  decide +kernel

/-- The exact symplectic matrices acting on the block colors. -/
def matrixGenerator (i : Fin 2) : S := ⟨actionMatrix i, by exact actionMatrix_mem i⟩

/-- The two matrix actions as six-bit vector lookup tables. -/
def matrixPacked : Fin 2 → Nat := ![26653917752799743781071378081828629891334047585236940674900366554574664037881563026202257794685683547153465681747520, 3565016276190824032825685685667220565243772959193906284612347982458825636674850509372558677260970644003560772222400]

def matrixImage (i : Fin 2) (v : Fin 64) : Fin 64 :=
  ⟨(matrixPacked i >>> (6 * v.val)) % 64, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 20000 in
theorem matrixGenerator_image : ∀ i v,
    matrixGenerator i • vector v = vector (matrixImage i v) := by decide +kernel

set_option maxRecDepth 20000 in
private theorem colorIndex_localFast : ∀ i x,
    colorIndex (localFast i x) = matrixImage i (colorIndex x) := by decide +kernel

/-- Equivariance for each actual centralizing word. -/
theorem color_localGenerator (i : Fin 2) (x : Fin 2300) :
    color (inclusion (localGenerator i) x) = matrixGenerator i • color x := by
  rw [localGenerator_inclusion, localTable_apply]
  change vector (colorIndex (localFast i x)) = matrixGenerator i • vector (colorIndex x)
  rw [colorIndex_localFast, matrixGenerator_image]

end Sporadic.LeechRelated.Co2.CentralizerSection
