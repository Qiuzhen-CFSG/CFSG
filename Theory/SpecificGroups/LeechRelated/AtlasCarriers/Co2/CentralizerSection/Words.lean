module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co2.CentralizerSection.GeneratorTables
public import Theory.GroupTheory.WordSubgroup
public import Mathlib.Tactic.FinCases
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Data.Fin.VecNotation

/-!
# An involution and two centralizing words in the fixed Co2 carrier

The first generator is a nonidentity involution. Two explicit words in the
published generators commute with it, as certified on all 2300 letters.
Their closure is the numerator for the symplectic quotient action. No full
centralizer equality or ambient order assertion is used.

Source: ATLAS Co2G1-p2300B0 and GLS3 Table 5.3k. The word search and all
numerical data are retained in `source/`; only Lean kernel checks are proofs.
-/

@[expose] public section
namespace Sporadic.LeechRelated.Co2.CentralizerSection
open Theory.GroupTheory

/-- The distinguished actual involution. -/
def z : Carrier := ⟨generatorA, Subgroup.subset_closure (by simp)⟩

def b : Carrier := ⟨generatorB, Subgroup.subset_closure (by simp)⟩

theorem z_inclusion : inclusion z = tableA := generatorA_eq_table

theorem z_sq : z ^ 2 = 1 := by
  apply Subtype.ext
  change generatorA ^ 2 = 1
  rw [generatorA_eq_table]
  apply Equiv.ext
  intro x
  exact tableA.left_inv x

theorem z_ne_one : z ≠ 1 := by
  intro h
  have hx := congrArg (fun g : Carrier => inclusion g 0) h
  change generatorA 0 = 0 at hx
  rw [generatorA_apply] at hx
  exact (by decide +kernel : fastA 0 ≠ 0) hx

theorem z_order : orderOf z = 2 := orderOf_eq_prime z_sq z_ne_one

def localWord : Fin 2 → List (Fin 3) := ![[0, 1, 1, 0, 2, 0, 1, 0, 2, 2, 0, 1, 1, 0, 2, 0], [1, 1, 0, 1, 1, 0, 2, 2, 0, 2, 2, 0, 1, 1, 0, 1, 1]]

/-- The two chosen words as elements of the original subgroup. -/
def localGenerator (i : Fin 2) : Carrier := evalWord ![z, b, b⁻¹] (localWord i)

def localTable (i : Fin 2) : Equiv.Perm (Fin 2300) :=
  evalWord ![tableA, tableB, tableB⁻¹] (localWord i)

theorem localGenerator_inclusion (i : Fin 2) : inclusion (localGenerator i) = localTable i := by
  have hw (w : List (Fin 3)) : inclusion (evalWord ![z, b, b⁻¹] w) =
      evalWord ![tableA, tableB, tableB⁻¹] w := by
    induction w with
    | nil => exact map_one inclusion
    | cons j w ih =>
      rw [evalWord, map_mul, ih, evalWord]
      congr 1
      fin_cases j <;>
        simp [z, b, inclusion, generatorA_eq_table, generatorB_eq_table]
  exact hw _

def localPacked0 : Nat := 

def localPacked1 : Nat := 

def localFast (i : Fin 2) (x : Fin 2300) : Fin 2300 :=
  ⟨((![localPacked0, localPacked1] i) >>> (12 * x.val)) % 4096 % 2300,
    Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 20000 in
theorem localTable_apply : ∀ i x, localTable i x = localFast i x := by decide +kernel

set_option maxRecDepth 20000 in
private theorem localFast_commutes : ∀ i x,
    localFast i (fastA x) = fastA (localFast i x) := by decide +kernel

theorem localGenerator_commutes (i : Fin 2) : localGenerator i * z = z * localGenerator i := by
  apply inclusion_injective
  rw [map_mul, map_mul, localGenerator_inclusion, z_inclusion]
  apply Equiv.ext
  intro x
  change localTable i (fastA x) = fastA (localTable i x)
  rw [localTable_apply, localTable_apply]
  exact localFast_commutes i x

/-- An actual subgroup of Co2 contained in the involution centralizer. -/
def numerator : Subgroup Carrier := Subgroup.closure (Set.range localGenerator)

theorem numerator_centralizes : numerator ≤ Subgroup.centralizer ({z} : Set Carrier) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  exact Subgroup.mem_centralizer_singleton_iff.mpr (localGenerator_commutes i)

/-- The generators regarded as elements of the quotient numerator. -/
def numeratorGenerator (i : Fin 2) : numerator :=
  ⟨localGenerator i, Subgroup.subset_closure ⟨i, rfl⟩⟩

end Sporadic.LeechRelated.Co2.CentralizerSection
