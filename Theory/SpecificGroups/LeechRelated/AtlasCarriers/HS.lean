module

public import Mathlib.GroupTheory.Perm.List
public import Mathlib.GroupTheory.Perm.Finite
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# The ATLAS permutation carrier for HS

The subgroup generated by the exact `HSG1-p100B0` permutations.
Source: R. A. Wilson et al., ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/v3/permrep/HSG1-p100B0 .
Original files, provenance, and reproducible transcription are in `source/`.

Letters are shifted from 1-based to 0-based. Each generator is inverted to
convert the source's right action to Lean's left action, preserving words.
`List.formPerm` constructs cycles as products of swaps, so the group laws
follow from the permutation group construction without any computation oracle.
This is an alternate sourced representation, not an asserted comparison with
the lattice model in the separate ATLAS Lean port. No order or simplicity
assertion, or assumption about a semi-presentation, is used here.
-/

@[expose] public section

namespace Sporadic.LeechRelated.HS

set_option maxRecDepth 20000

/-- Disjoint cycles in the source order, with zero-based letters. -/
def cyclesA : List (List (Fin 100)) :=
  [[0, 59],
   [1, 71],
   [2, 80],
   [3, 42],
   [4, 10],
   [5, 86],
   [6, 33],
   [8, 62],
   [11, 45],
   [12, 27],
   [13, 70],
   [14, 41],
   [15, 96],
   [17, 56],
   [18, 51],
   [20, 31],
   [22, 46],
   [23, 53],
   [24, 82],
   [25, 77],
   [28, 88],
   [29, 38],
   [32, 60],
   [34, 55],
   [36, 66],
   [43, 75],
   [44, 87],
   [47, 58],
   [48, 85],
   [49, 73],
   [50, 65],
   [52, 98],
   [54, 74],
   [61, 72],
   [64, 78],
   [67, 81],
   [76, 91],
   [83, 89],
   [84, 97],
   [93, 99]]

/-- The inverse of the source right-action generator, acting on the left. -/
def generatorA : Equiv.Perm (Fin 100) :=
  ((cyclesA.map List.formPerm).prod)⁻¹

/-- Disjoint cycles in the source order, with zero-based letters. -/
def cyclesB : List (List (Fin 100)) :=
  [[0, 85, 12, 9, 46],
   [1, 52, 29, 7, 37],
   [2, 39, 47, 24, 16],
   [3, 28, 91, 87, 42],
   [4, 97, 65, 53, 64],
   [5, 26, 50, 72, 23],
   [6, 82, 15, 19, 27],
   [8, 22, 88, 94, 60],
   [10, 41, 45, 90, 31],
   [11, 13, 80, 54, 67],
   [14, 89, 30, 55, 36],
   [17, 68, 44, 83, 75],
   [18, 58, 78, 34, 92],
   [20, 21, 63, 38, 99],
   [25, 57, 95, 84, 76],
   [32, 51, 93, 74, 43],
   [33, 61, 86, 77, 49],
   [35, 81, 59, 73, 71],
   [40, 79, 69, 48, 66],
   [56, 62, 70, 98, 96]]

/-- The inverse of the source right-action generator, acting on the left. -/
def generatorB : Equiv.Perm (Fin 100) :=
  ((cyclesB.map List.formPerm).prod)⁻¹

/-- The subgroup generated by the two published permutations. -/
def generated : Subgroup (Equiv.Perm (Fin 100)) :=
  Subgroup.closure {generatorA, generatorB}

/-- The actual carrier of the published permutation representation. -/
abbrev Carrier : Type := generated

instance carrierFinite : Finite Carrier := inferInstanceAs (Finite generated)

/-- Faithful inclusion in the defining symmetric group. -/
def inclusion : Carrier →* Equiv.Perm (Fin 100) := generated.subtype

theorem inclusion_injective : Function.Injective inclusion := Subtype.val_injective

end Sporadic.LeechRelated.HS
