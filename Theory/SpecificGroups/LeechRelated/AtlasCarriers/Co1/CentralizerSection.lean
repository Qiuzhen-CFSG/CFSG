module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co1.CentralizerSection.Words
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co1.CentralizerSection.Small
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# A quotient of a centralizing subgroup in the fixed Co₁ carrier

The ATLAS maximal-subgroup words x and y commute with the certified involution
z = (x*y^3)^14. Their matrices preserve the explicit eight-dimensional
coordinate injection and induce `smallX` and `smallY`. We form the subgroup
generated by these paired matrices. The coordinate injection has a checked
left inverse, so the first projection is injective. The second projection
surjects onto the group generated by the two smaller matrices. Transport
through the first projection gives an actual homomorphism from a subgroup of
the fixed Co₁ carrier, with no splitting or ambient normality assumption.

The classical identification is a separate requirement: this module proves
a quotient onto `SmallCarrier`, not an identification with Ω₈⁺(2).

Source: R. A. Wilson et al., ATLAS of Finite Group Representations,
`Co1G1-f2r24B0` and `Co1G1-max5W1`, and GLS3 Table 5.3l
(`refs/KGroup/GLS3/Chapter5(sec3-).tex`). The source data and checked matrix
certificates are in the descendants of this module.
-/

@[expose] public section

namespace Sporadic.LeechRelated.Co1.CentralizerSection
open Packed

def coordinateMatrix : Matrix (Fin 24) (Fin 8) (ZMod 2) := decode Matrices.basisRows

def localPairs : Subgroup (Carrier × SmallAmbient) :=
  Subgroup.closure {(x, smallX), (y, smallY)}

private lemma inv_intertwines (A : Ambient) (B : SmallAmbient)
    (h : A.val * coordinateMatrix = coordinateMatrix * B.val) :
    (A⁻¹).val * coordinateMatrix = coordinateMatrix * (B⁻¹).val := by
  calc
    (A⁻¹).val * coordinateMatrix =
        (A⁻¹).val * (coordinateMatrix * (B.val * (B⁻¹).val)) := by
      rw [B.mul_inv, Matrix.mul_one]
    _ = ((A⁻¹).val * (coordinateMatrix * B.val)) * (B⁻¹).val := by
      simp only [Matrix.mul_assoc]
    _ = ((A⁻¹).val * (A.val * coordinateMatrix)) * (B⁻¹).val := by rw [h]
    _ = coordinateMatrix * (B⁻¹).val := by
      rw [← Matrix.mul_assoc, A.inv_mul, Matrix.one_mul]

private def intertwiningPairs : Subgroup (Carrier × SmallAmbient) where
  carrier := {g | g.1.val.val * coordinateMatrix = coordinateMatrix * g.2.val}
  one_mem' := by
    change (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) * coordinateMatrix =
      coordinateMatrix * (1 : Matrix (Fin 8) (Fin 8) (ZMod 2))
    rw [Matrix.one_mul, Matrix.mul_one]
  mul_mem' := by
    intro g h hg hh
    change (g.1.val.val * h.1.val.val) * coordinateMatrix =
      coordinateMatrix * (g.2.val * h.2.val)
    calc
      _ = g.1.val.val * (h.1.val.val * coordinateMatrix) := Matrix.mul_assoc _ _ _
      _ = g.1.val.val * (coordinateMatrix * h.2.val) := by rw [hh]
      _ = (g.1.val.val * coordinateMatrix) * h.2.val := (Matrix.mul_assoc _ _ _).symm
      _ = _ := by rw [hg, Matrix.mul_assoc]
  inv_mem' := by
    intro g hg
    exact inv_intertwines g.1.val g.2 hg

theorem localPairs_intertwine (g : localPairs) :
    g.val.1.val.val * coordinateMatrix = coordinateMatrix * g.val.2.val := by
  have h : localPairs ≤ intertwiningPairs := by
    apply (Subgroup.closure_le _).mpr
    intro p hp
    rcases Set.mem_insert_iff.mp hp with rfl | hp
    · change x.val.val * coordinateMatrix = coordinateMatrix * smallX.val
      rw [x_matrix]
      exact Matrices.x_intertwines
    · rcases Set.mem_singleton_iff.mp hp with rfl
      change y.val.val * coordinateMatrix = coordinateMatrix * smallY.val
      rw [y_matrix]
      exact Matrices.y_intertwines
  exact h g.property

def firstProjection : localPairs →* Carrier :=
  (MonoidHom.fst Carrier SmallAmbient).comp localPairs.subtype

def secondProjection : localPairs →* SmallAmbient :=
  (MonoidHom.snd Carrier SmallAmbient).comp localPairs.subtype

theorem firstProjection_injective : Function.Injective firstProjection := by
  intro p q hpq
  change p.val.1 = q.val.1 at hpq
  have hmatrix : coordinateMatrix * p.val.2.val = coordinateMatrix * q.val.2.val := by
    rw [← localPairs_intertwine p, ← localPairs_intertwine q, hpq]
  have hsmall := congrArg (fun M =>
    (decode Matrices.leftInverseRows : Matrix (Fin 8) (Fin 24) (ZMod 2)) * M) hmatrix
  have hs : p.val.2.val = q.val.2.val := by
    simpa only [← Matrix.mul_assoc, coordinateMatrix, Matrices.leftInverse_basis,
      Matrix.one_mul] using hsmall
  exact Subtype.ext (Prod.ext hpq (Units.ext hs))

theorem secondProjection_range : secondProjection.range = smallGenerated := by
  rw [secondProjection, MonoidHom.range_comp]
  simp only [Subgroup.range_subtype]
  rw [localPairs, MonoidHom.map_closure]
  rw [Set.image_pair]
  rfl

/-- The subgroup generated by the two concrete centralizing words. -/
def numerator : Subgroup Carrier := firstProjection.range

theorem numerator_eq : numerator = Subgroup.closure {x, y} := by
  rw [numerator, firstProjection, MonoidHom.range_comp, Subgroup.range_subtype,
    localPairs, MonoidHom.map_closure, Set.image_pair]
  rfl

theorem numerator_centralizes : numerator ≤ Subgroup.centralizer ({z} : Set Carrier) := by
  have h : localPairs ≤
      (Subgroup.centralizer ({z} : Set Carrier)).comap (MonoidHom.fst Carrier SmallAmbient) := by
    apply (Subgroup.closure_le _).mpr
    intro p hp
    rcases Set.mem_insert_iff.mp hp with rfl | hp
    · exact Subgroup.mem_centralizer_singleton_iff.mpr x_commutes_z.eq
    · rcases Set.mem_singleton_iff.mp hp with rfl
      exact Subgroup.mem_centralizer_singleton_iff.mpr y_commutes_z.eq
  rintro g ⟨p, rfl⟩
  exact h p.property

def secondToImage : localPairs →* SmallCarrier :=
  secondProjection.codRestrict smallGenerated (fun g => by
    rw [← secondProjection_range]
    exact ⟨g, rfl⟩)

theorem secondToImage_surjective : Function.Surjective secondToImage := by
  intro s
  have hs : s.val ∈ secondProjection.range := secondProjection_range ▸ s.property
  obtain ⟨g, hg⟩ := hs
  exact ⟨g, Subtype.ext hg⟩

noncomputable def graphEquiv : localPairs ≃* numerator :=
  MonoidHom.ofInjective firstProjection_injective

/-- The actual quotient action on the eight-dimensional invariant subspace. -/
noncomputable def quotientMap : numerator →* SmallCarrier :=
  secondToImage.comp graphEquiv.symm.toMonoidHom

theorem quotientMap_surjective : Function.Surjective quotientMap :=
  secondToImage_surjective.comp graphEquiv.symm.surjective

/-- The quotient map is the literal action through the checked coordinate injection. -/
theorem quotientMap_intertwines (g : numerator) :
    g.val.val.val * coordinateMatrix = coordinateMatrix * (quotientMap g).val.val := by
  have h := localPairs_intertwine (graphEquiv.symm g)
  have hf : (graphEquiv.symm g).val.1 = g.val :=
    MonoidHom.apply_ofInjective_symm firstProjection_injective g
  rw [hf] at h
  exact h

end Sporadic.LeechRelated.Co1.CentralizerSection
