module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co1.Involution
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co1.CentralizerSection.Matrices

/-!
# Centralizing words in the fixed ATLAS Co₁ carrier

The literal `Co1G1-max5W1` program defines x and y in the group generated by
the fixed published matrices. Checked intermediate products prove that
z = (x*y^3)^14 is an involution and that both words commute with z.
This certifies an actual centralizing subgroup, without assuming a class label
or the claimed maximal-subgroup structure from the ATLAS table.

Source: R. A. Wilson et al., ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/v3/subgroup/Co1G1-max5W1 .
-/

public section
namespace Sporadic.LeechRelated.Co1.CentralizerSection
open Packed

private def a : Carrier := involution
private def b : Carrier := ⟨generatorB, Subgroup.subset_closure (by simp)⟩

private theorem a_matrix : a.val.val = decode Matrices.aRows := by decide +kernel
private theorem b_matrix : b.val.val = decode Matrices.bRows := by decide +kernel

private def step01 : Carrier := a * b

private theorem step01_matrix : step01.val.val = decode Matrices.step01Rows := by
  change a.val.val * b.val.val = _
  rw [a_matrix, b_matrix]
  exact Matrices.step01_product

private def step02 : Carrier := step01 * b

private theorem step02_matrix : step02.val.val = decode Matrices.step02Rows := by
  change step01.val.val * b.val.val = _
  rw [step01_matrix, b_matrix]
  exact Matrices.step02_product

private def step03 : Carrier := step01 * step02

private theorem step03_matrix : step03.val.val = decode Matrices.step03Rows := by
  change step01.val.val * step02.val.val = _
  rw [step01_matrix, step02_matrix]
  exact Matrices.step03_product

private def step04 : Carrier := step03 * step03

private theorem step04_matrix : step04.val.val = decode Matrices.step04Rows := by
  change step03.val.val * step03.val.val = _
  rw [step03_matrix]
  exact Matrices.step04_product

private def step05 : Carrier := step04 * step03

private theorem step05_matrix : step05.val.val = decode Matrices.step05Rows := by
  change step04.val.val * step03.val.val = _
  rw [step04_matrix, step03_matrix]
  exact Matrices.step05_product

private def step06 : Carrier := step02 * step03

private theorem step06_matrix : step06.val.val = decode Matrices.step06Rows := by
  change step02.val.val * step03.val.val = _
  rw [step02_matrix, step03_matrix]
  exact Matrices.step06_product

private def step07 : Carrier := step02 * step06

private theorem step07_matrix : step07.val.val = decode Matrices.step07Rows := by
  change step02.val.val * step06.val.val = _
  rw [step02_matrix, step06_matrix]
  exact Matrices.step07_product

private def step08 : Carrier := step07 * step06

private theorem step08_matrix : step08.val.val = decode Matrices.step08Rows := by
  change step07.val.val * step06.val.val = _
  rw [step07_matrix, step06_matrix]
  exact Matrices.step08_product

private def step09 : Carrier := step01 * step01

private theorem step09_matrix : step09.val.val = decode Matrices.step09Rows := by
  change step01.val.val * step01.val.val = _
  rw [step01_matrix]
  exact Matrices.step09_product

private def step10 : Carrier := step08 * step09

private theorem step10_matrix : step10.val.val = decode Matrices.step10Rows := by
  change step08.val.val * step09.val.val = _
  rw [step08_matrix, step09_matrix]
  exact Matrices.step10_product

private def step11 : Carrier := step10 * step03

private theorem step11_matrix : step11.val.val = decode Matrices.step11Rows := by
  change step10.val.val * step03.val.val = _
  rw [step10_matrix, step03_matrix]
  exact Matrices.step11_product

private def step12 : Carrier := step11 * step01

private theorem step12_matrix : step12.val.val = decode Matrices.step12Rows := by
  change step11.val.val * step01.val.val = _
  rw [step11_matrix, step01_matrix]
  exact Matrices.step12_product

/-- First word of the published maximal-subgroup program. -/
def x : Carrier := step05
/-- Second word of the published maximal-subgroup program. -/
def y : Carrier := step12

theorem x_matrix : x.val.val = decode Matrices.step05Rows := step05_matrix
theorem y_matrix : y.val.val = decode Matrices.step12Rows := step12_matrix

private def y2 : Carrier := y * y

private theorem y2_matrix : y2.val.val = decode Matrices.y2Rows := by
  change y.val.val * y.val.val = _
  rw [y_matrix]
  exact Matrices.y2_product

private def y3 : Carrier := y2 * y

private theorem y3_matrix : y3.val.val = decode Matrices.y3Rows := by
  change y2.val.val * y.val.val = _
  rw [y2_matrix, y_matrix]
  exact Matrices.y3_product

private def w : Carrier := x * y3

private theorem w_matrix : w.val.val = decode Matrices.wRows := by
  change x.val.val * y3.val.val = _
  rw [x_matrix, y3_matrix]
  exact Matrices.w_product

private def w2 : Carrier := w * w

private theorem w2_matrix : w2.val.val = decode Matrices.w2Rows := by
  change w.val.val * w.val.val = _
  rw [w_matrix]
  exact Matrices.w2_product

private def w4 : Carrier := w2 * w2

private theorem w4_matrix : w4.val.val = decode Matrices.w4Rows := by
  change w2.val.val * w2.val.val = _
  rw [w2_matrix]
  exact Matrices.w4_product

private def w6 : Carrier := w4 * w2

private theorem w6_matrix : w6.val.val = decode Matrices.w6Rows := by
  change w4.val.val * w2.val.val = _
  rw [w4_matrix, w2_matrix]
  exact Matrices.w6_product

private def w7 : Carrier := w6 * w

private theorem w7_matrix : w7.val.val = decode Matrices.w7Rows := by
  change w6.val.val * w.val.val = _
  rw [w6_matrix, w_matrix]
  exact Matrices.w7_product

/-- The central involution word (x*y^3)^14. -/
def z : Carrier := w7 * w7

theorem z_word : z = (x * y ^ 3) ^ 14 := by
  simp only [z, w7, w6, w4, w2, w, y3, y2, pow_succ, pow_zero, one_mul,
    mul_assoc]

theorem z_matrix : z.val.val = decode Matrices.zRows := by
  change w7.val.val * w7.val.val = _
  rw [w7_matrix]
  exact Matrices.z_product

theorem z_sq : z ^ 2 = 1 := by
  rw [pow_two]
  apply Subtype.ext
  apply Units.ext
  change z.val.val * z.val.val = 1
  rw [z_matrix]
  exact Matrices.z_square

theorem z_ne_one : z ≠ 1 := by
  intro h
  have he := congrArg (fun g : Carrier => g.val.val (0 : Fin 24) (1 : Fin 24)) h
  rw [z_matrix] at he
  have hn : (decode Matrices.zRows : Matrix (Fin 24) (Fin 24) (ZMod 2)) 0 1 ≠ 0 := by
    decide +kernel
  exact hn he

theorem z_order : orderOf z = 2 := orderOf_eq_prime z_sq z_ne_one

theorem x_commutes_z : Commute x z := by
  apply Subtype.ext
  apply Units.ext
  change x.val.val * z.val.val = z.val.val * x.val.val
  rw [x_matrix, z_matrix]
  exact Matrices.x_commutes

theorem y_commutes_z : Commute y z := by
  apply Subtype.ext
  apply Units.ext
  change y.val.val * z.val.val = z.val.val * y.val.val
  rw [y_matrix, z_matrix]
  exact Matrices.y_commutes

end Sporadic.LeechRelated.Co1.CentralizerSection
