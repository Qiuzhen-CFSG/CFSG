module

public import Theory.SpecificGroups.ONan.MatrixGenerators
public import Theory.LinearAlgebra.FiniteProjectiveMatrixGroup
public import Mathlib.Algebra.Group.Subgroup.Basic

/-!
# A concrete projective matrix construction of O'Nan's group

Take the subgroup of PGL(45,7) generated by the images of the two published
ATLAS 45a matrices for 3.O'N. The carrier is fixed by those matrices; it has
no existence, order, recognition, or classification hypothesis. Finiteness
comes from the finite ambient matrix group.

The two projective generators do not commute: the (0,0) entry of AB is zero,
whereas that of BA is four. Consequently AB and BA cannot differ by a scalar.
This certifies nonabelianness independently of order and simplicity.

Source: ATLAS of Finite Group Representations, representation 3ONG1-f7r45aB0;
see the preserved source and attribution in `refs/original/onan/README.md`.
The order and simplicity of this specific generated subgroup are separate
mathematical obligations.
-/

namespace ONan

/-- The first projective ATLAS generator. -/
@[expose] public def projectiveA : Matrix.ProjGenLinGroup (Fin 45) (ZMod 7) :=
  Matrix.ProjGenLinGroup.mk linearA

/-- The second projective ATLAS generator. -/
@[expose] public def projectiveB : Matrix.ProjGenLinGroup (Fin 45) (ZMod 7) :=
  Matrix.ProjGenLinGroup.mk linearB

/-- The subgroup determined by the two projective ATLAS matrices. -/
@[expose] public def matrixSubgroup : Subgroup (Matrix.ProjGenLinGroup (Fin 45) (ZMod 7)) :=
  Subgroup.closure {projectiveA, projectiveB}

/-- The fixed projective matrix carrier for O'Nan's group. -/
@[expose] public def Model : Type := matrixSubgroup
  deriving Group, Finite

public theorem projectiveA_mem : projectiveA ∈ matrixSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

public theorem projectiveB_mem : projectiveB ∈ matrixSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The first generator as an element of the model. -/
@[expose] public def generatorA : Model := ⟨projectiveA, projectiveA_mem⟩

/-- The second generator as an element of the model. -/
@[expose] public def generatorB : Model := ⟨projectiveB, projectiveB_mem⟩

public theorem projectiveA_mul_projectiveB_ne :
    projectiveA * projectiveB ≠ projectiveB * projectiveA := by
  intro h
  have h' : Matrix.ProjGenLinGroup.mk (linearA * linearB) =
      Matrix.ProjGenLinGroup.mk (linearB * linearA) := by
    simpa only [map_mul, projectiveA, projectiveB] using h
  obtain ⟨u, hu⟩ := Matrix.ProjGenLinGroup.mk_eq_mk_iff.mp h'
  have he := congrArg (fun g : Matrix.GeneralLinearGroup (Fin 45) (ZMod 7) =>
    (g : Matrix (Fin 45) (Fin 45) (ZMod 7)) 0 0) hu
  change ((matrixA * matrixB) * Matrix.scalar (Fin 45) u.val) 0 0 =
    (matrixB * matrixA) 0 0 at he
  rw [Matrix.scalar_apply, Matrix.mul_diagonal, matrixAB_zero, zero_mul,
    matrixBA_four] at he
  exact (by decide : (0 : ZMod 7) ≠ 4) he

public theorem generatorA_mul_generatorB_ne :
    generatorA * generatorB ≠ generatorB * generatorA := by
  intro h
  exact projectiveA_mul_projectiveB_ne (congrArg Subtype.val h)

public theorem exists_mul_ne_mul : ∃ g h : Model, g * h ≠ h * g :=
  ⟨generatorA, generatorB, generatorA_mul_generatorB_ne⟩

end ONan
