private instance coordinateDecidableEq : DecidableEq Coordinates := fun s t =>
    if h : s.a = t.a ∧ s.b = t.b ∧ s.c = t.c then
      isTrue (Coordinates.ext h.1 h.2.1 h.2.2)
    else isFalse (fun he => h (by cases he; exact ⟨rfl, rfl, rfl⟩))

set_option maxHeartbeats 0 in
/-- Every nonidentity normal form is reached by its listed path. -/
theorem walk_pathTable : ∀ t : Coordinates, t ≠ 1 →
    walk (origin (pathTable (index t)).1) (pathTable (index t)).2 = t := by
  decide +kernel

