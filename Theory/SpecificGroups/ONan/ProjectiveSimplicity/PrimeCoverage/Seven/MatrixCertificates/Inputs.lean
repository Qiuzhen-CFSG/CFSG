module

public import Theory.SpecificGroups.ONan.ProjectiveSimplicity.PrimeCoverage.Seven.MatrixCertificates.Data

/-!
Explicit GF(7) certificates for the fixed seven-subgroup words.
Every table is checked by kernel reduction in the accompanying product proofs.
Sources: ATLAS 45a matrices, preserved in `refs/original/onan/`; local words
from `ProjectiveOrder/Setup.lean`. Generated by `source/Generate.py`.
-/

namespace ONan.Simplicity.Seven.Certificate

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem encoded_a_eq : encoded_a = matrixA := by
  have h : ∀ q : Fin 45 × Fin 45, encoded_a q.1 q.2 = (matrixA : Matrix (Fin 45) (Fin 45) (ZMod 7)) q.1 q.2 := by
    unfold encoded_a decodeMatrix entryNat
    decide +kernel
  exact Matrix.ext (fun i j => h (i, j))

