set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem encoded_one_eq : encoded_one = 1 := by
  have h : ∀ q : Fin 45 × Fin 45, encoded_one q.1 q.2 = (1 : Matrix (Fin 45) (Fin 45) (ZMod 7)) q.1 q.2 := by
