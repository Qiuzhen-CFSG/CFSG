module

public import Theory.SpecificGroups.ONan.ProjectiveSimplicity.PrimeCoverage.Seven.MatrixCertificates.Inputs

/-!
Explicit GF(7) certificates for the fixed seven-subgroup words.
Every table is checked by kernel reduction in the accompanying product proofs.
Sources: ATLAS 45a matrices, preserved in `refs/original/onan/`; local words
from `ProjectiveOrder/Setup.lean`. Generated by `source/Generate.py`.
-/

namespace ONan.Simplicity.Seven.Certificate

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem check_bb : matrixB * matrixB = bb := by
  rw [← encoded_b_eq]
  unfold bb encoded_b
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem check_ab2 : matrixA * bb = ab2 := by
  rw [← encoded_a_eq]
  unfold bb ab2 encoded_a
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem check_c : ab2 * ab2 = c := by
  unfold ab2 c
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem check_ci : c * ci = 1 := by
  rw [← encoded_one_eq]
  unfold c ci encoded_one
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem check_m4 : matrixBInv * matrixA = m4 := by
  rw [← encoded_a_eq]
  rw [← encoded_bi_eq]
  unfold m4 encoded_a encoded_bi
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem check_la : m4 * matrixB = la := by
  rw [← encoded_b_eq]
  unfold m4 la encoded_b
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem check_m6 : ci * matrixB = m6 := by
  rw [← encoded_b_eq]
  unfold ci m6 encoded_b
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
public theorem check_lb : m6 * c = lb := by
  unfold m6 c lb
  exact checkProduct_sound _ _ _ (by decide +kernel)

end ONan.Simplicity.Seven.Certificate
