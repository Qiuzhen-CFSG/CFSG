private theorem inverse_value (g : LinearGroup) (m : Mat) (h : (g : Mat) * m = 1) :
    ((g⁻¹ : LinearGroup) : Mat) = m := by
  calc
    ((g⁻¹ : LinearGroup) : Mat) = ((g⁻¹ : LinearGroup) : Mat) * 1 := (mul_one _).symm
    _ = ((g⁻¹ : LinearGroup) : Mat) * ((g : Mat) * m) := by rw [h]
    _ = m := by rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]

