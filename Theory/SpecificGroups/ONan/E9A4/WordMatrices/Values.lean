private theorem inverse_value (g : Linear) (m : Mat) (h : (g : Mat) * m = 1) :
    ((g⁻¹ : Linear) : Mat) = m := by
  calc
    ((g⁻¹ : Linear) : Mat) = ((g⁻¹ : Linear) : Mat) * 1 := (mul_one _).symm
    _ = ((g⁻¹ : Linear) : Mat) * ((g : Mat) * m) := by rw [h]
    _ = m := by rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]

