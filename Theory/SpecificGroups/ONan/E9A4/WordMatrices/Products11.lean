/-!
# Certificates for the fixed O'Nan E₉ × A₄ words

The balanced matrix products and inverse witnesses are checked by the Lean
kernel using the proved GF(7) checker. The corresponding group expressions
retain the literal ATLAS max5 program and the four signed local words.
Source: ATLAS 45a matrices in `refs/original/onan/` and `../source/ONG1-max5W1`,
with the local words in `../source/words.json`. See `source/README.md`.
Generated by `source/Generate.py`; Python only produces certificate data.
-/

namespace ONan.E9A4.WordCertificate

open ONan.Simplicity.Seven.Certificate
  (checkProduct_sound encoded_a encoded_b encoded_one
    encoded_a_eq encoded_b_eq encoded_one_eq)

set_option maxRecDepth 4096 in
public theorem check_part6 : w13 * part5 = part6 := by
  simp only [w13, part5, part6]
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
public theorem check_part7 : part4 * part6 = part7 := by
  simp only [part4, part6, part7]
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
public theorem check_part8 : part3 * part7 = part8 := by
  simp only [part3, part7, part8]
  exact checkProduct_sound _ _ _ (by decide +kernel)

set_option maxRecDepth 4096 in
public theorem check_part9 : local0Inv * local1Inv = part9 := by
  simp only [local0Inv, local1Inv, part9]
  exact checkProduct_sound _ _ _ (by decide +kernel)

end ONan.E9A4.WordCertificate
