module

public import Theory.SpecificGroups.ONan.MatrixModel
public import Theory.GroupTheory.CoveringKernelCard
public import Theory.GroupTheory.PerfectCentralCoverExistence
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.Algebra.GroupWithZero.Units.Fintype

/-!
# The scalar kernel of the linear O'Nan construction

The two published matrices generate a subgroup of GL(45,7) projecting onto
`ONan.Model`. Its projective kernel embeds in the ambient scalar group F₇ˣ,
so its order divides six. Any compatible map to a perfect central cover is
surjective and transfers this bound to that cover's center.

These statements do not assert that the linear group is a universal cover.
Constructing a compatible lift for an arbitrary O'Nan cover remains a separate
obligation. The scalar calculation needs no order or simplicity certificate
for the projective model.

Sources: the ATLAS matrices and attribution in `refs/original/onan/README.md`;
GLS3, Table 5.3s, records M(O'N) = C₃ and the 45-dimensional representation.
The cardinality argument here only uses the explicit projective construction.
-/

namespace ONan.Cover

/-- The subgroup generated by the actual two linear ATLAS matrices. -/
@[expose] public def linearSubgroup : Subgroup (Matrix.GeneralLinearGroup (Fin 45) (ZMod 7)) :=
  Subgroup.closure {linearA, linearB}

/-- The linear subgroup projects onto the fixed projective model. -/
public theorem map_linearSubgroup :
    linearSubgroup.map Matrix.ProjGenLinGroup.mk = matrixSubgroup := by
  rw [linearSubgroup, MonoidHom.map_closure]
  simp only [Set.image_insert_eq, Set.image_singleton]
  rfl

/-- The projective quotient map restricted to the linear matrix group. -/
@[expose] public def projection : linearSubgroup →* Model :=
  (Matrix.ProjGenLinGroup.mk.comp linearSubgroup.subtype).codRestrict matrixSubgroup
    (fun x => map_linearSubgroup ▸ Subgroup.mem_map.mpr ⟨x, x.property, rfl⟩)

public theorem projection_surjective : Function.Surjective projection := by
  intro x
  have hx : x.val ∈ linearSubgroup.map Matrix.ProjGenLinGroup.mk :=
    map_linearSubgroup.symm ▸ x.property
  obtain ⟨y, hy, hxy⟩ := hx
  exact ⟨⟨y, hy⟩, Subtype.ext hxy⟩

/-- The projective kernel embeds in the scalar matrices over F₇. -/
public theorem projection_ker_card_dvd_six : Nat.card projection.ker ∣ 6 := by
  have : Fact (Nat.Prime 7) := ⟨by decide⟩
  let j : projection.ker →* Subgroup.center (Matrix.GeneralLinearGroup (Fin 45) (ZMod 7)) :=
    (linearSubgroup.subtype.comp projection.ker.subtype).codRestrict _ (by
      intro x
      apply Matrix.ProjGenLinGroup.mk_eq_one.mp
      exact congrArg Subtype.val x.property)
  have hj : Function.Injective j := by
    intro x y h
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun z : Subgroup.center (Matrix.GeneralLinearGroup (Fin 45) (ZMod 7)) => z.val) h
  have hd := Subgroup.card_dvd_of_injective j hj
  have hs : Nat.card (Subgroup.center (Matrix.GeneralLinearGroup (Fin 45) (ZMod 7))) ∣
      Nat.card ((ZMod 7)ˣ) := by
    rw [Matrix.GeneralLinearGroup.center_eq_range_scalar]
    exact Subgroup.card_range_dvd _
  have hcard : Nat.card ((ZMod 7)ˣ) = 6 := by
    rw [Nat.card_units, Nat.card_zmod]
  exact hd.trans (hcard ▸ hs)

/-- A compatible surjection from the linear model bounds the center of a cover. -/
public theorem center_card_dvd_six_of_lift
    {G : Type*} [Group G]
    (e : G ⧸ Subgroup.center G ≃* Model)
    (f : linearSubgroup →* G) (hf : Function.Surjective f)
    (hfac : (e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center G))).comp f =
      projection) :
    Nat.card (Subgroup.center G) ∣ 6 := by
  have hker : (e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center G))).ker =
      Subgroup.center G := by
    ext x
    change e (QuotientGroup.mk' (Subgroup.center G) x) = 1 ↔ x ∈ Subgroup.center G
    rw [e.map_eq_one_iff]
    exact QuotientGroup.eq_one_iff x
  have h := Theory.GroupTheory.kernel_card_dvd_of_surjective_factor projection
    (e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center G))) f hf hfac
  rw [hker] at h
  exact h.trans projection_ker_card_dvd_six

/-- A compatible lift into a perfect cover is automatically onto. -/
public theorem lift_surjective
    {G : Type*} [Group G] [Group.IsPerfect G]
    (e : G ⧸ Subgroup.center G ≃* Model)
    (f : linearSubgroup →* G)
    (hfac : (e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center G))).comp f =
      projection) : Function.Surjective f := by
  apply PerfectCentralCovering.surjective_of_comp_surjective_of_ker_le_center_of_isPerfect
    (e.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center G))) f
  · rw [hfac]
    exact projection_surjective
  · intro x hx
    apply (QuotientGroup.eq_one_iff x).mp
    apply e.map_eq_one_iff.mp
    exact hx

end ONan.Cover
