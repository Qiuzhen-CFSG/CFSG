    (fun i => MatrixCheck.checkRow (left 8) (transposed 8) (result 8) (Fin.ofNat 45 i)) = true := by
  decide +kernel
private theorem check_9 : allBelow 45
    (fun i => MatrixCheck.checkRow (left 9) (transposed 9) (result 9) (Fin.ofNat 45 i)) = true := by
  decide +kernel
private theorem product_checks (k : Fin 10) : allBelow 45
    (fun i => MatrixCheck.checkRow (left k) (transposed k) (result k) (Fin.ofNat 45 i)) = true := by
  fin_cases k
  · exact check_0
  · exact check_1
  · exact check_2
  · exact check_3
  · exact check_4
  · exact check_5
  · exact check_6
  · exact check_7
  · exact check_8
  · exact check_9
private theorem products (k : Fin 10) : decode (left k) * decode (right k) = decode (result k) := by
  apply MatrixCheck.mul_sound _ _ _ _ (transpose_right k)
  apply allRows_sound
  exact product_checks k

theorem decode_unit : decode unit = (1 : Mat) := by decide +kernel
theorem a_sq : decode a * decode a = 1 := (products 0).trans decode_unit
theorem b_sq : decode b * decode b = 1 := (products 1).trans decode_unit
theorem c_sq : decode c * decode c = 1 := (products 2).trans decode_unit
theorem mul_ab : decode a * decode b = decode ab := products 3
theorem mul_ba : decode b * decode a = decode ab := products 4
theorem mul_ac : decode a * decode c = decode ac := products 5
theorem mul_ca : decode c * decode a = decode ac := products 6
theorem mul_bc : decode b * decode c = decode bc := products 7
theorem mul_cb : decode c * decode b = decode bc := products 8
theorem mul_abc : decode ab * decode c = decode abc := products 9

theorem linear_a : (linearGenerators 6 : Mat) = decode a := by
  rw [linearGenerators_eq_basisMatrices]
  decide +kernel
theorem linear_b : (linearGenerators 7 : Mat) = decode b := by
  rw [linearGenerators_eq_basisMatrices]
  decide +kernel
theorem linear_c : (linearGenerators 8 : Mat) = decode c := by
  rw [linearGenerators_eq_basisMatrices]
  decide +kernel
