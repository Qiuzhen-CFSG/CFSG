private def left : Fin 10 → Packed := ![a,b,c,a,b,a,c,b,c,ab]
private def right : Fin 10 → Packed := ![a,b,c,b,a,c,a,c,b,c]
private def transposed : Fin 10 → Packed := ![aT,bT,cT,bT,aT,cT,aT,cT,bT,cT]
private def result : Fin 10 → Packed := ![unit,unit,unit,ab,ab,ac,ac,bc,bc,abc]
private theorem transpose_right : ∀ k, (decode (transposed k)).transpose = decode (right k) := by
  decide +kernel
private theorem check_0 : allBelow 45
    (fun i => MatrixCheck.checkRow (left 0) (transposed 0) (result 0) (Fin.ofNat 45 i)) = true := by
  decide +kernel
private theorem check_1 : allBelow 45
    (fun i => MatrixCheck.checkRow (left 1) (transposed 1) (result 1) (Fin.ofNat 45 i)) = true := by
  decide +kernel
private theorem check_2 : allBelow 45
    (fun i => MatrixCheck.checkRow (left 2) (transposed 2) (result 2) (Fin.ofNat 45 i)) = true := by
  decide +kernel
