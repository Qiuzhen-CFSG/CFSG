@[expose] public def rep2 (r : Fin 6) : G :=
  evalWord gen2 (if r.val = 0 then [] else decodeWord 8 (repWords2.getD r.val []))

@[expose] public def act2 (i : Fin 8) (r : Fin 6) : Fin 6 :=
  Fin.ofNat 6 ((actions2.getD i.val #[]).getD r.val 0)

@[expose] public def factor2 (i : Fin 8) (r : Fin 6) : List (Fin 4) :=
  decodeWord 4
    (factorWords2.getD ((factorIds2.getD i.val #[]).getD r.val 0) [])

/-- The matrix equalities required for this level, including inverse generators. -/
@[expose] public def Step2 : Prop := ∀ (i : Fin 8) (r : Fin 6),
  gen2 i * rep2 r = rep2 (act2 i r) * evalWord gen3 (factor2 i r)

public theorem rep2_mem (r : Fin 6) : rep2 r ∈ group2 :=
  evalWord_mem_wordSubgroup gen2 (invIndex 4) (signed_inv positive2)
    (if r.val = 0 then [] else decodeWord 8 (repWords2.getD r.val []))

public theorem rep2_zero : rep2 0 = 1 := rfl

public theorem card_le_of_step2 (h : Step2) :
    Nat.card group2 ≤ 6 * Nat.card group3 :=
  wordSubgroup_card_le_mul_next gen2 (invIndex 4) (signed_inv positive2)
    gen3 (invIndex 2) (signed_inv positive3) rep2 act2 factor2 0
    rep2_mem group3_le rep2_zero h

