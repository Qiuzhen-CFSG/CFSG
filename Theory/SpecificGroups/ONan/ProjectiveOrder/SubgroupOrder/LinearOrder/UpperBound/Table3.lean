/-!
# Level 3 of the concrete linear subgroup cover

The 2 representatives and the signed transition table are candidate data.
`Step3` states all required equalities in GL(45,7); `card_le_of_step3`
proves their cardinality consequence using the generic word-cover theorem.
No numerical computation outside Lean is accepted as a proof.

Generated by `source/GenerateTables.py` from `source/chain-witness.json`.
Source matrices and attribution: `refs/original/onan/`.
-/

namespace ONan.OrderCertificate.LinearUpperBound

open Theory.GroupTheory

@[expose] public def repWords3 : Array (List Nat) :=
  #[[],
    [0]]

@[expose] public def actionRow3_0 : Array (Nat) :=
  #[1,
    0]
@[expose] public def actionRow3_1 : Array (Nat) :=
  #[0,
    1]
@[expose] public def actionRow3_2 : Array (Nat) :=
  #[1,
    0]
@[expose] public def actionRow3_3 : Array (Nat) :=
  #[0,
    1]

@[expose] public def actions3 : Array (Array Nat) :=
  #[actionRow3_0,
    actionRow3_1,
    actionRow3_2,
    actionRow3_3]

@[expose] public def factorWords3 : Array (List Nat) :=
  #[[],
    [0]]

@[expose] public def factorRow3_0 : Array (Nat) :=
  #[0,
    0]
@[expose] public def factorRow3_1 : Array (Nat) :=
  #[1,
    1]
@[expose] public def factorRow3_2 : Array (Nat) :=
  #[0,
    0]
@[expose] public def factorRow3_3 : Array (Nat) :=
  #[1,
    1]

@[expose] public def factorIds3 : Array (Array Nat) :=
  #[factorRow3_0,
    factorRow3_1,
    factorRow3_2,
    factorRow3_3]

@[expose] public def rep3 (r : Fin 2) : G :=
  evalWord gen3 (if r.val = 0 then [] else decodeWord 4 (repWords3.getD r.val []))

@[expose] public def act3 (i : Fin 4) (r : Fin 2) : Fin 2 :=
  Fin.ofNat 2 ((actions3.getD i.val #[]).getD r.val 0)

@[expose] public def factor3 (i : Fin 4) (r : Fin 2) : List (Fin 2) :=
  decodeWord 2
    (factorWords3.getD ((factorIds3.getD i.val #[]).getD r.val 0) [])

/-- The matrix equalities required for this level, including inverse generators. -/
@[expose] public def Step3 : Prop := ∀ (i : Fin 4) (r : Fin 2),
  gen3 i * rep3 r = rep3 (act3 i r) * evalWord gen4 (factor3 i r)

public theorem rep3_mem (r : Fin 2) : rep3 r ∈ group3 :=
  evalWord_mem_wordSubgroup gen3 (invIndex 2) (signed_inv positive3)
    (if r.val = 0 then [] else decodeWord 4 (repWords3.getD r.val []))

public theorem rep3_zero : rep3 0 = 1 := rfl

public theorem card_le_of_step3 (h : Step3) :
    Nat.card group3 ≤ 2 * Nat.card group4 :=
  wordSubgroup_card_le_mul_next gen3 (invIndex 2) (signed_inv positive3)
    gen4 (invIndex 1) (signed_inv positive4) rep3 act3 factor3 0
    rep3_mem group4_le rep3_zero h

end ONan.OrderCertificate.LinearUpperBound
