/-!
# Level 4 of the concrete linear subgroup cover

The 2 representatives and the signed transition table are candidate data.
`Step4` states all required equalities in GL(45,7); `card_le_of_step4`
proves their cardinality consequence using the generic word-cover theorem.
No numerical computation outside Lean is accepted as a proof.

Generated by `source/GenerateTables.py` from `source/chain-witness.json`.
Source matrices and attribution: `refs/original/onan/`.
-/

namespace ONan.OrderCertificate.LinearUpperBound

open Theory.GroupTheory

@[expose] public def repWords4 : Array (List Nat) :=
  #[[],
    [0]]

@[expose] public def actionRow4_0 : Array (Nat) :=
  #[1,
    0]
@[expose] public def actionRow4_1 : Array (Nat) :=
  #[1,
    0]

@[expose] public def actions4 : Array (Array Nat) :=
  #[actionRow4_0,
    actionRow4_1]

@[expose] public def factorWords4 : Array (List Nat) :=
  #[[]]

@[expose] public def factorRow4_0 : Array (Nat) :=
  #[0,
    0]
@[expose] public def factorRow4_1 : Array (Nat) :=
  #[0,
    0]

@[expose] public def factorIds4 : Array (Array Nat) :=
  #[factorRow4_0,
    factorRow4_1]

@[expose] public def rep4 (r : Fin 2) : G :=
  evalWord gen4 (if r.val = 0 then [] else decodeWord 2 (repWords4.getD r.val []))

@[expose] public def act4 (i : Fin 2) (r : Fin 2) : Fin 2 :=
  Fin.ofNat 2 ((actions4.getD i.val #[]).getD r.val 0)

@[expose] public def factor4 (i : Fin 2) (r : Fin 2) : List (Fin 0) :=
  decodeWord 0
    (factorWords4.getD ((factorIds4.getD i.val #[]).getD r.val 0) [])

/-- The matrix equalities required for this level, including inverse generators. -/
@[expose] public def Step4 : Prop := ∀ (i : Fin 2) (r : Fin 2),
  gen4 i * rep4 r = rep4 (act4 i r) * evalWord gen5 (factor4 i r)

public theorem rep4_mem (r : Fin 2) : rep4 r ∈ group4 :=
  evalWord_mem_wordSubgroup gen4 (invIndex 1) (signed_inv positive4)
    (if r.val = 0 then [] else decodeWord 2 (repWords4.getD r.val []))

public theorem rep4_zero : rep4 0 = 1 := rfl

public theorem card_le_of_step4 (h : Step4) :
    Nat.card group4 ≤ 2 * Nat.card group5 :=
  wordSubgroup_card_le_mul_next gen4 (invIndex 1) (signed_inv positive4)
    gen5 (invIndex 0) (signed_inv positive5) rep4 act4 factor4 0
    rep4_mem group5_le rep4_zero h

end ONan.OrderCertificate.LinearUpperBound
