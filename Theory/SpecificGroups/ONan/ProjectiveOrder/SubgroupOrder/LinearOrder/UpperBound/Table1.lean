@[expose] public def rep1 (r : Fin 56) : G :=
  evalWord gen1 (if r.val = 0 then [] else decodeWord 6 (repWords1.getD r.val []))

@[expose] public def act1 (i : Fin 6) (r : Fin 56) : Fin 56 :=
  Fin.ofNat 56 ((actions1.getD i.val #[]).getD r.val 0)

@[expose] public def factor1 (i : Fin 6) (r : Fin 56) : List (Fin 8) :=
  decodeWord 8
    (factorWords1.getD ((factorIds1.getD i.val #[]).getD r.val 0) [])

/-- The matrix equalities required for this level, including inverse generators. -/
@[expose] public def Step1 : Prop := ∀ (i : Fin 6) (r : Fin 56),
  gen1 i * rep1 r = rep1 (act1 i r) * evalWord gen2 (factor1 i r)

public theorem rep1_mem (r : Fin 56) : rep1 r ∈ group1 :=
  evalWord_mem_wordSubgroup gen1 (invIndex 3) (signed_inv positive1)
    (if r.val = 0 then [] else decodeWord 6 (repWords1.getD r.val []))

public theorem rep1_zero : rep1 0 = 1 := rfl

public theorem card_le_of_step1 (h : Step1) :
    Nat.card group1 ≤ 56 * Nat.card group2 :=
  wordSubgroup_card_le_mul_next gen1 (invIndex 3) (signed_inv positive1)
    gen2 (invIndex 4) (signed_inv positive2) rep1 act1 factor1 0
    rep1_mem group2_le rep1_zero h

