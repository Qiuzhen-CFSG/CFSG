module

public import Theory.SpecificGroups.ONan.ProjectiveOrder.Setup

/-!
# Linear lifts of the O'Nan local subgroup

The two ATLAS subgroup words can be evaluated in GL(45,7) before taking their
projective images. Their generated subgroup maps onto exactly the subgroup
specified in `ProjectiveOrder/Setup.lean`. The kernel is its intersection with
the scalar matrices; the cardinality formula retains this kernel explicitly.
If the only scalar in the linear subgroup is the identity, projection preserves
its order.

The proof uses functoriality of subgroup closure and the first isomorphism
cardinality formula, without assuming any O'Nan order or group identification.
The words and their source attribution are preserved in
`ProjectiveOrder/source/README.md`; the matrices are from the ATLAS 45a
representation in `refs/original/onan/`.
-/

namespace ONan.OrderCertificate

/-- The first subgroup word evaluated before projectivizing. -/
@[expose] public def linearLocalA : Matrix.GeneralLinearGroup (Fin 45) (ZMod 7) :=
  linearB⁻¹ * linearA * linearB

/-- The second subgroup word evaluated before projectivizing. -/
@[expose] public def linearLocalB : Matrix.GeneralLinearGroup (Fin 45) (ZMod 7) :=
  ((linearA * linearB ^ 2) ^ 2)⁻¹ * linearB * (linearA * linearB ^ 2) ^ 2

/-- The linear subgroup generated by the two lifted words. -/
@[expose] public def linearLocalSubgroup :
    Subgroup (Matrix.GeneralLinearGroup (Fin 45) (ZMod 7)) :=
  Subgroup.closure {linearLocalA, linearLocalB}

public theorem linearLocalA_mem : linearLocalA ∈ linearLocalSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

public theorem linearLocalB_mem : linearLocalB ∈ linearLocalSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

public theorem mk_linearLocalA : Matrix.ProjGenLinGroup.mk linearLocalA = localA.val := by
  change Matrix.ProjGenLinGroup.mk (linearB⁻¹ * linearA * linearB) =
    (Matrix.ProjGenLinGroup.mk linearB)⁻¹ * Matrix.ProjGenLinGroup.mk linearA *
      Matrix.ProjGenLinGroup.mk linearB
  simp only [map_mul, map_inv]

public theorem mk_linearLocalB : Matrix.ProjGenLinGroup.mk linearLocalB = localB.val := by
  change Matrix.ProjGenLinGroup.mk
      (((linearA * linearB ^ 2) ^ 2)⁻¹ * linearB * (linearA * linearB ^ 2) ^ 2) =
    ((Matrix.ProjGenLinGroup.mk linearA * Matrix.ProjGenLinGroup.mk linearB ^ 2) ^ 2)⁻¹ *
      Matrix.ProjGenLinGroup.mk linearB *
      (Matrix.ProjGenLinGroup.mk linearA * Matrix.ProjGenLinGroup.mk linearB ^ 2) ^ 2
  simp only [map_mul, map_inv, map_pow]

/-- Ambient inclusion with the fixed model's group instance. -/
@[expose] public def modelInclusion : Model →*
    Matrix.ProjGenLinGroup (Fin 45) (ZMod 7) where
  toFun := fun g => g.val
  map_one' := rfl
  map_mul' _ _ := rfl

/-- Projectivization restricted to the linear word subgroup. -/
@[expose] public def linearLocalProjection :
    linearLocalSubgroup →* Matrix.ProjGenLinGroup (Fin 45) (ZMod 7) :=
  Matrix.ProjGenLinGroup.mk.comp linearLocalSubgroup.subtype

/-- The image is the specified local subgroup in the ambient projective group. -/
public theorem linearLocalProjection_range :
    linearLocalProjection.range = localSubgroup.map modelInclusion := by
  rw [linearLocalProjection, MonoidHom.range_comp, Subgroup.range_subtype]
  rw [linearLocalSubgroup, MonoidHom.map_closure]
  simp only [Set.image_insert_eq, Set.image_singleton, mk_linearLocalA, mk_linearLocalB]
  symm
  exact (MonoidHom.map_closure modelInclusion ({localA, localB} : Set Model)).trans
    (congrArg Subgroup.closure (Set.image_pair (fun g : Model => g.val) localA localB))

/-- Projection kills exactly the central (scalar) elements of the linear subgroup. -/
public theorem linearLocalProjection_ker :
    linearLocalProjection.ker =
      (Subgroup.center (Matrix.GeneralLinearGroup (Fin 45) (ZMod 7))).subgroupOf
        linearLocalSubgroup := by
  ext g
  change Matrix.ProjGenLinGroup.mk g.val = 1 ↔ g.val ∈ Subgroup.center _
  exact Matrix.ProjGenLinGroup.mk_eq_one

/-- The exact order formula, retaining the scalar kernel factor. -/
public theorem linearLocalSubgroup_card_eq :
    Nat.card linearLocalSubgroup =
      Nat.card linearLocalProjection.ker * Nat.card localSubgroup := by
  have h := linearLocalProjection.ker.card_mul_index
  rw [Subgroup.index_ker, linearLocalProjection_range] at h
  rw [← Nat.card_congr (localSubgroup.equivMapOfInjective modelInclusion
    Subtype.val_injective).toEquiv] at h
  exact h.symm

/-- Excluding nonidentity scalars makes the restricted projection faithful. -/
public theorem linearLocalProjection_injective_of_scalar
    (hscalar : ∀ u : (ZMod 7)ˣ,
      Matrix.GeneralLinearGroup.scalar (Fin 45) u ∈ linearLocalSubgroup → u = 1) :
    Function.Injective linearLocalProjection := by
  rw [← MonoidHom.ker_eq_bot_iff]
  apply bot_unique
  intro g hg
  have hc : g.val ∈ Subgroup.center (Matrix.GeneralLinearGroup (Fin 45) (ZMod 7)) :=
    Matrix.ProjGenLinGroup.mk_eq_one.mp hg
  rw [Matrix.GeneralLinearGroup.center_eq_range_scalar] at hc
  obtain ⟨u, hu⟩ := hc
  have hu1 := hscalar u (hu ▸ g.property)
  apply Subtype.ext
  change g.val = 1
  rw [← hu, hu1, map_one]

/-- Transfer of order after certifying the scalar kernel is trivial. -/
public theorem localSubgroup_card_eq_linear_of_scalar
    (hscalar : ∀ u : (ZMod 7)ˣ,
      Matrix.GeneralLinearGroup.scalar (Fin 45) u ∈ linearLocalSubgroup → u = 1) :
    Nat.card localSubgroup = Nat.card linearLocalSubgroup := by
  calc
    Nat.card localSubgroup = Nat.card (localSubgroup.map modelInclusion) :=
      Nat.card_congr (localSubgroup.equivMapOfInjective modelInclusion
        Subtype.val_injective).toEquiv
    _ = Nat.card linearLocalProjection.range := by rw [linearLocalProjection_range]
    _ = Nat.card linearLocalSubgroup :=
      (Nat.card_congr (MonoidHom.ofInjective
        (linearLocalProjection_injective_of_scalar hscalar)).toEquiv).symm

end ONan.OrderCertificate
