  apply Matrix.ext
  exact @of_decide_eq_true _ (entryDecidable _ _) (by decide +kernel)

/-- The local A word preserves the displayed row space. -/
public theorem fixedPlaneRows_localA :
    fixedPlaneRows * ((linearB⁻¹ * linearA * linearB :
      Matrix.GeneralLinearGroup (Fin 45) (ZMod 7)) :
      Matrix (Fin 45) (Fin 45) (ZMod 7)) =
      fixedPlaneActionA * fixedPlaneRows := by
  change fixedPlaneRows * (matrixBInv * matrixA * matrixB) = fixedPlaneActionA * fixedPlaneRows
  simp only [← Matrix.mul_assoc]
  rw [stepA0, stepA1, stepA2]

