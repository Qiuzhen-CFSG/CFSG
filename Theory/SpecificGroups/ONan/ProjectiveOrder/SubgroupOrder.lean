module

public import Theory.SpecificGroups.ONan.ProjectiveOrder.SubgroupOrder.LinearSetup

/-!
# Linear certificates for the O'Nan local subgroup order

The desired projective order follows from two concrete certificates: the order
of the subgroup generated by the lifted ATLAS words, and the absence of
nonidentity scalar matrices in that subgroup. `SubgroupOrder/LinearSetup.lean`
proves the image and kernel identifications used in this transfer. Neither
certificate is assumed as an axiom or inferred from the ATLAS subgroup label.

See `ProjectiveOrder/source/README.md` for the source words and attribution.
-/

namespace ONan.OrderCertificate

/-- Assemble the projective subgroup order from linear order and scalar certificates. -/
public theorem localSubgroup_card_of_linear_certificates
    (horder : Nat.card linearLocalSubgroup = 3753792)
    (hscalar : ∀ u : (ZMod 7)ˣ,
      Matrix.GeneralLinearGroup.scalar (Fin 45) u ∈ linearLocalSubgroup → u = 1) :
    Nat.card localSubgroup = 3753792 := by
  rw [localSubgroup_card_eq_linear_of_scalar hscalar, horder]

end ONan.OrderCertificate
