module

public import Theory.SpecificGroups.ONan.MatrixModel
public import Mathlib.GroupTheory.Index

/-!
# A concrete subgroup for the O'Nan order calculation

Inside the fixed projective matrix model, take the subgroup generated by
`b⁻¹ * a * b` and `(a * b²)⁻² * b * (a * b²)²`. These are the words for the
first subgroup labelled L₃(7):2 in the ATLAS O'Nan group page. The definitions
make sense without assuming that identification, its order, or its index.

The order calculation will certify the subgroup order and index separately,
then use Lagrange's equality. All subgroups here are in the projective model:
an argument using the linear lifts must account for its scalar kernel.

Source: ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/spor/ON/ and its `words/ONG1-max1W1`.
The original straight-line program and attribution are preserved in `source/`.
-/

namespace ONan.OrderCertificate

/-- First word from the ATLAS subgroup straight-line program. -/
@[expose] public def localA : Model := generatorB⁻¹ * generatorA * generatorB

/-- Second word from the ATLAS subgroup straight-line program. -/
@[expose] public def localB : Model :=
  ((generatorA * generatorB ^ 2) ^ 2)⁻¹ * generatorB *
    (generatorA * generatorB ^ 2) ^ 2

/-- The actual word-generated subgroup; no abstract identification is assumed. -/
@[expose] public def localSubgroup : Subgroup Model :=
  Subgroup.closure {localA, localB}

public theorem localA_mem : localA ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

public theorem localB_mem : localB ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The ambient projective generators generate the whole model. -/
public theorem closure_generators :
    Subgroup.closure ({generatorA, generatorB} : Set Model) = ⊤ := by
  have hs : ({generatorA, generatorB} : Set Model) =
      matrixSubgroup.subtype ⁻¹' ({projectiveA, projectiveB} : Set _) := by
    ext x
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Subgroup.coe_subtype]
    change (x = generatorA ∨ x = generatorB) ↔
      (x.val = generatorA.val ∨ x.val = generatorB.val)
    exact or_congr Subtype.ext_iff Subtype.ext_iff
  rw [hs]
  exact Subgroup.closure_preimage_eq_top _

/-- Lagrange's equality for the specified concrete subgroup. -/
public theorem card_model_eq :
    Nat.card Model = Nat.card localSubgroup * localSubgroup.index :=
  localSubgroup.card_mul_index.symm

end ONan.OrderCertificate
