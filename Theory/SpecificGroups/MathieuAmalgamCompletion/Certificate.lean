private def definitions : Definitions (Fin 4) where
  parent n := min (defCode n / 8) (n - 1)
  letter n := decode (defCode n % 8)
  parent_lt n := by
    have := Nat.min_le_right (defCode (n+1) / 8) (n+1-1)
    omega

private def rotatedRelator (r : Nat) : Word (Fin 4) :=
  (if r % 128 < 64 then relator ⟨r / 128 % 27, Nat.mod_lt _ (by decide)⟩
   else FreeGroup.invRev (relator ⟨r / 128 % 27, Nat.mod_lt _ (by decide)⟩)).rotate (r % 64)

private def allowed (a : Letter (Fin 4)) : Bool := a.2 && (a.1.val < 3)

private def context : Context (Fin 4) :=
  ⟨definitions.parent,definitions.letter,rotatedRelator,allowed⟩

private def facts (n : Nat) : FactData (Fin 4) :=
  let c := factCode n
  let a := c / 1024 % 16
  ⟨c % 1024,if a == 0 then [] else [decode (a-1)],c / 16384⟩

private def refs : Nat → Nat → List Nat
  | 0, _ => []
  | n+1, c => if c == 0 then [] else (c % 8192 - 1) :: refs n (c >>> 13)

private def instructions (n : Nat) : Scan.Op (Fin 4) :=
  let c := opCode n
  let a := c / 8 % 8192
  let b := c / 65536
  match c % 8 with
  | 0 => .basic (.refl a)
  | 1 => .basic (.defining a)
  | 2 => .basic (.subgroup (decode a))
  | 3 => .basic (.relator a b)
  | 4 => .basic (.reverse a)
  | 5 => .basic (.compose a b)
  | _ => .scan (scanHeader a / 4096) (scanHeader a % 4096)
      (refs 19 (scanLeft a)) (refs 19 (scanRight a))

