private def repCode (i : Nat) : Nat :=
  unpack (fun _ => 0x17445104370b028090230781a0641805c160540d0200500c0200400) 10 i

private def outputCode (i : Nat) : Nat :=
  unpack (branch 1 (fun _ => ) (fun _ => 0x93c49a25472a20aa4a824cf2a591f47e41d60ef90505563f026a8c14ac22e60e28ce45fa2e116f923490e31b18c4d6c62a31118692fca2a3b11d68ea48fc3fb1d291bc8da4692328f908323df1ec)) 13 i

private def destCode (i : Nat) : Nat :=
  unpack (branch 1 (fun _ => 0x62473919c93a8eaac52fa41043ce344be0b4ad109a19062aaa71dc75a5757b285531ee5cc8d99e0c5394e434d2318417c24729534084a5211a82102318e6f108810802618c42008c2294641040000000) (fun _ => 0x8cab5a394b834a98d5b142de36a273ac65283ce6956317528d6d16c34988)) 5 i

private def output (n : Nat) : Nat := min (outputCode n) 4786

private def destination (n : Nat) : Fin 22 := ⟨min (destCode n) 21,by omega⟩

private def shapeAt (n : Nat) : Bool :=
  factBEq (facts (output n))
    ⟨repCode (n / 8),[decode (n % 8)],repCode (destination n).val⟩

set_option maxRecDepth 4096 in
private theorem shape_checked : (List.range 176).all shapeAt = true := by decide +kernel

private theorem context_valid {G : Type*} [Group G] (g : Fin 4 → G) (H : Subgroup G)
    (hs : ∀ i : Fin 4, i.val < 3 → g i ∈ H)
    (hr : ∀ i, eval g (relator i) = 1) :
    Valid context H g (definitions.repr g) := by
  apply definitions.valid
  · intro a ha
    have h : a.2 = true ∧ a.1.val < 3 := by simpa [allowed] using ha
    rw [eval_letter,if_pos h.1]
    exact hs _ h.2
  · intro r
    have rotate (w : Word (Fin 4)) (hw : eval g w = 1) (k : Nat) :
        eval g (w.rotate k) = 1 := by
      simp only [eval,FreeGroup.lift_mk] at hw ⊢
      rw [List.map_rotate]
      exact List.prod_rotate_eq_one_of_prod_eq_one hw k
    apply rotate
    split
    · exact hr _
    · rw [eval_invRev,hr,inv_one]

private theorem all_hold {G : Type*} [Group G] (g : Fin 4 → G) (H : Subgroup G)
    (hs : ∀ i : Fin 4, i.val < 3 → g i ∈ H)
    (hr : ∀ i, eval g (relator i) = 1) :
    ∀ n, n < 4787 → Holds H g (definitions.repr g) (facts n) := by
  have hv := context_valid g H hs hr
  have h512 := Scan.chunk_sound hv facts instructions 0 512 (fun n hn => (Nat.not_lt_zero n hn).elim) checked_0
  have h1024 := Scan.chunk_sound hv facts instructions 512 512 h512 checked_512
  have h1536 := Scan.chunk_sound hv facts instructions 1024 512 h1024 checked_1024
  have h2048 := Scan.chunk_sound hv facts instructions 1536 512 h1536 checked_1536
  have h2560 := Scan.chunk_sound hv facts instructions 2048 512 h2048 checked_2048
  have h3072 := Scan.chunk_sound hv facts instructions 2560 512 h2560 checked_2560
  have h3584 := Scan.chunk_sound hv facts instructions 3072 512 h3072 checked_3072
  have h4096 := Scan.chunk_sound hv facts instructions 3584 512 h3584 checked_3584
  have h4608 := Scan.chunk_sound hv facts instructions 4096 512 h4096 checked_4096
  have h4787 := Scan.chunk_sound hv facts instructions 4608 179 h4608 checked_4608
  exact h4787

private theorem transitions {G : Type*} [Group G] (g : Fin 4 → G) (H : Subgroup G)
    (hs : ∀ i : Fin 4, i.val < 3 → g i ∈ H)
    (hr : ∀ i, eval g (relator i) = 1) (i : Fin 22) (a : Fin 8) :
    Holds H g (definitions.repr g)
      ⟨repCode i.val,[decode a.val],repCode (destination (8*i.val+a.val)).val⟩ := by
  have hm : 8*i.val+a.val ∈ List.range 176 := by simp only [List.mem_range]; omega
  have hh := (factBEq_eq_true_iff _ _).mp (List.all_eq_true.mp shape_checked _ hm)
  have hd : (8*i.val+a.val) / 8 = i.val := by omega
  have hx : (8*i.val+a.val) % 8 = a.val := by omega
  change facts (output (8*i.val+a.val)) = _ at hh
  rw [hd,hx] at hh
  rw [← hh]
  exact all_hold g H hs hr _ (Nat.lt_of_le_of_lt (Nat.min_le_right _ _) (by decide))

private theorem decode_even (a : Fin 4) : decode (2*a.val) = (a,true) := by
  apply Prod.ext
  · apply Fin.ext
    dsimp [decode]
    omega
  · simp [decode]

private theorem decode_odd (a : Fin 4) : decode (2*a.val+1) = (a,false) := by
  apply Prod.ext
  · apply Fin.ext
    dsimp [decode]
    omega
  · simp [decode,Nat.add_mod]

private def cover {G : Type*} [Group G] (g : Fin 4 → G) (H : Subgroup G)
    (hs : ∀ i : Fin 4, i.val < 3 → g i ∈ H)
    (hr : ∀ i, eval g (relator i) = 1) : GeneratorCosetCover H g (Fin 22) where
  repr i := definitions.repr g (repCode i.val)
  initial := 0
  initial_eq := by
    have he : repCode 0 = 0 := by decide +kernel
    change definitions.repr g (repCode 0) = 1
    rw [he]
    exact definitions.repr_zero g
  step i a := by
    obtain ⟨h,hh⟩ := transitions g H hs hr i ⟨2*a.val,by omega⟩
    refine ⟨h,destination (8*i.val+2*a.val),?_⟩
    simpa [decode_even] using hh
  inv_step i a := by
    obtain ⟨h,hh⟩ := transitions g H hs hr i ⟨2*a.val+1,by omega⟩
    refine ⟨h,destination (8*i.val+(2*a.val+1)),?_⟩
    simpa [decode_odd] using hh

/-- The exact27 relations force index at most22 in every actual generated group. -/
public theorem index_le_twenty_two {G : Type*} [Group G] (g : Fin 4 → G) (H : Subgroup G)
    (hs : ∀ i : Fin 4, i.val < 3 → g i ∈ H)
    (hr : ∀ i, eval g (relator i) = 1)
    (hgen : closure (Set.range g) = ⊤) : H.index ≤ 22 := by
  let C := cover g H hs hr
  have hsurj : Function.Surjective (fun i : Fin 22 => (QuotientGroup.mk (C.repr i)⁻¹ : G ⧸ H)) := by
    intro q
    refine Quotient.inductionOn q fun x => ?_
    obtain ⟨h,i,hi⟩ := C.covers hgen x⁻¹
    refine ⟨i,?_⟩
    have hh : x = (C.repr i)⁻¹ * (h : G)⁻¹ := by
      simpa only [inv_inv,mul_inv_rev] using congrArg Inv.inv hi
    rw [hh]
    exact (QuotientGroup.mk_mul_of_mem _ (H.inv_mem h.property)).symm
  rw [index_eq_card]
  exact (Nat.card_le_card_of_surjective _ hsurj).trans_eq (Nat.card_fin 22)

private theorem eval_subtype {G : Type*} [Group G] (K : Subgroup G)
    (g : Fin 4 → K) (w : Word (Fin 4)) :
    ((eval g w : K) : G) = eval (fun i => (g i : G)) w := by
  induction w with
  | nil => simp
  | cons a w ih =>
    rw [eval_cons,eval_cons]
    cases a with
    | mk i sign => cases sign <;> simp only [Bool.false_eq_true,↓reduceIte,
        Subgroup.coe_mul,Subgroup.coe_inv,ih]

/-- The same checked bound retains the literal generated subgroup of any
ambient group; no generation or finiteness hypothesis on that ambient group. -/
public theorem relative_index_le_twenty_two {G : Type*} [Group G]
    (g : Fin 4 → G) (H : Subgroup G)
    (hs : ∀ i : Fin 4, i.val < 3 → g i ∈ H)
    (hr : ∀ i, eval g (relator i) = 1) :
    H.relIndex (closure (Set.range g)) ≤ 22 := by
  let K := closure (Set.range g)
  let f : Fin 4 → K := fun i => ⟨g i,subset_closure (Set.mem_range_self i)⟩
  have hf : closure (Set.range f) = ⊤ := by
    apply map_injective K.subtype_injective
    rw [MonoidHom.map_closure,← MonoidHom.range_eq_map,range_subtype,← Set.range_comp]
    rfl
  apply index_le_twenty_two f (H.subgroupOf K) (fun i hi => hs i hi) ?_ hf
  intro i
  apply Subtype.ext
  exact (eval_subtype K f (relator i)).trans (hr i)

end Theory.SpecificGroups.MathieuAmalgamCompletion
