module

public import Theory.SpecificGroups.Tits.Atlas1600Parrott

/-!
# The distinguished Parrott word in the Atlas model

The word `r5 = s1 * s5²` is the nonidentity central element of the subgroup
generated by the eight `s` generators. This module names the word independently
of its center and normal-generation properties.

Source: Parrott (1972), transcribed in
`refs/original/n-group-global/parrott-tits-presentation.md`.
-/

namespace Tits

/-- Parrott's distinguished central word in the degree-1600 Atlas model. -/
public def atlas1600R5 : Atlas1600Group :=
  atlas1600ParrottAssignment .s1 * atlas1600ParrottAssignment .s5 ^ 2

public theorem atlas1600R5_eq : atlas1600R5 =
    atlas1600ParrottAssignment .s1 * atlas1600ParrottAssignment .s5 ^ 2 := by rfl

end Tits
