module

public import Theory.SpecificGroups.Tits.Atlas1600OrderData

/-!
# Connectivity certificate for the four stabilizer orbits

These breadth-first trees connect every point to one of 0, 1, 9, and 64 using
level-one generators. The data are witnesses extracted from the permutations in
`refs/original/n-group-global/atlas-tits-p1600-{a,b}.g`; Lean checks every edge.
Only connectivity is needed: an invariant set is a union of the four trees.
-/

namespace Tits.Atlas1600PrimitiveCertificate
open Atlas1600OrderCertificate
set_option maxRecDepth 20000
set_option maxHeartbeats 1600000

@[expose] public def colorPacked : Nat := 

@[expose] public def color (x : Fin 1600) : Fin 4 :=
  ⟨(colorPacked >>> (2 * x.val)) % 4 % 4, Nat.mod_lt _ (by decide)⟩

@[expose] public def depthPacked : Nat := 

@[expose] public def depth (x : Fin 1600) : Fin 16 :=
  ⟨(depthPacked >>> (4 * x.val)) % 16 % 16, Nat.mod_lt _ (by decide)⟩

@[expose] public def parentPacked : Nat := 

@[expose] public def parent (x : Fin 1600) : Fin 1600 :=
  ⟨(parentPacked >>> (11 * x.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

@[expose] public def edgePacked : Nat := 

@[expose] public def edge (x : Fin 1600) : Fin 6 :=
  ⟨(edgePacked >>> (3 * x.val)) % 8 % 6, Nat.mod_lt _ (by decide)⟩

@[expose] public def root : Fin 4 → Fin 1600
  | 0 => 0
  | 1 => 1
  | 2 => 9
  | 3 => 64

public theorem tree (x : Fin 1600) :
    x = root (color x) ∨
      ((depth (parent x)).val < (depth x).val ∧ color (parent x) = color x ∧
        L1Gen (edge x) (parent x) = x) := by
  revert x
  apply allFin
  decide +kernel

public theorem color_zero : color 0 = 0 := by decide +kernel

@[expose] public def selected (a b c : Bool) : Fin 4 → Bool
  | 0 => true
  | 1 => a
  | 2 => b
  | 3 => c

@[expose] public def candidate (a b c : Bool) : Finset (Fin 1600) :=
  Finset.univ.filter (fun x => selected a b c (color x) = true)

/-- The eight unions containing the singleton pass the block divisibility test
only when their cardinality is 1 or 1600. -/
public theorem candidate_card : ∀ a b c : Bool,
    (candidate a b c).card ∣ 1600 →
      (candidate a b c).card = 1 ∨ (candidate a b c).card = 1600 := by
  decide +kernel

end Tits.Atlas1600PrimitiveCertificate
