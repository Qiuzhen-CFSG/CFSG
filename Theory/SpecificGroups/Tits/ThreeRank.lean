private theorem x_conj_z : x * z * x⁻¹ = z := by
  apply Subtype.ext
  change x.val * z.val * x.val⁻¹ = z.val
  rw [x_val, z_val]
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem y_conj_z : y * z * y⁻¹ = z := by
  apply Subtype.ext
  change y.val * z.val * y.val⁻¹ = z.val
  rw [y_val, z_val]
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem x_conj_y : x * y * x⁻¹ = z⁻¹ * y := by
  dsimp [z]
  group

private def normalForm (n : Fin 27) : Atlas1600Group :=
  z ^ (n.val % 3) * y ^ (n.val / 3 % 3) * x ^ (n.val / 9)
/-- The subgroup generated by the two cubic words and their commutator. -/
public def sylowSubgroup : Subgroup Atlas1600Group := closure {x, y, z}
private theorem normalForm_mem (n : Fin 27) : normalForm n ∈ sylowSubgroup := by
  apply mul_mem
  · apply mul_mem
    · exact pow_mem (subset_closure (by simp : z ∈ ({x,y,z} : Set Atlas1600Group))) _
    · exact pow_mem (subset_closure (by simp : y ∈ ({x,y,z} : Set Atlas1600Group))) _
  · exact pow_mem (subset_closure (by simp : x ∈ ({x,y,z} : Set Atlas1600Group))) _
private theorem normalForm_surjective {a : Atlas1600Group} (ha : a ∈ sylowSubgroup) :
    ∃ n : Fin 27, normalForm n = a := by
  have hx : ∀ b ∈ ({y,z} : Set Atlas1600Group), x * b * x⁻¹ ∈ closure {y,z} := by
    rintro b (rfl | rfl)
    · rw [x_conj_y]
      exact mul_mem (inv_mem (subset_closure (by simp))) (subset_closure (by simp))
    · rw [x_conj_z]
      exact subset_closure (by simp)
  have hy : ∀ b ∈ ({z} : Set Atlas1600Group), y * b * y⁻¹ ∈ closure {z} := by
    rintro b (rfl : b = z)
    rw [y_conj_z]
    exact subset_closure (by simp)
  obtain ⟨a₂, h₂, i, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert {y,z} x 3 (by decide) x_cube hx ha
  obtain ⟨a₁, h₁, j, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert {z} y 3 (by decide) y_cube hy h₂
  obtain ⟨a₀, h₀, k, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert ∅ z 3 (by decide) z_cube
      (by simp) (by simpa using h₁)
  simp only [closure_empty, mem_bot] at h₀
  subst a₀
  let n : Fin 27 := ⟨k.val + 3*j.val + 9*i.val, by omega⟩
  refine ⟨n, ?_⟩
  have hk : n.val % 3 = k.val := by dsimp [n]; omega
  have hj : n.val / 3 % 3 = j.val := by dsimp [n]; omega
  have hi : n.val / 9 = i.val := by dsimp [n]; omega
  simp only [normalForm, hk, hj, hi, one_mul]
private theorem normalForm_injective : Function.Injective normalForm := by
  have h : Function.Injective (fun n : Fin 27 =>
      (zp ^ (n.val % 3) * yp ^ (n.val / 3 % 3) * xp ^ (n.val / 9)) 0) := by
    decide +kernel
  intro i j he
  apply h
  have hv := congrArg (fun a : Atlas1600Group => a.val 0) he
  change (z.val ^ (i.val % 3) * y.val ^ (i.val / 3 % 3) * x.val ^ (i.val / 9)) 0 =
    (z.val ^ (j.val % 3) * y.val ^ (j.val / 3 % 3) * x.val ^ (j.val / 9)) 0 at hv
  simpa only [z_val, y_val, x_val] using hv

/-- The word enumeration is complete and irredundant. -/
public theorem sylowSubgroup_card : Nat.card sylowSubgroup = 27 := by
  let e : Fin 27 ≃ sylowSubgroup := Equiv.ofBijective
    (fun n => ⟨normalForm n, normalForm_mem n⟩)
    ⟨fun _ _ h => normalForm_injective (congrArg Subtype.val h), fun a => by
      obtain ⟨n, hn⟩ := normalForm_surjective a.property
      exact ⟨n, Subtype.ext hn⟩⟩
  rw [← Nat.card_congr e]
  exact Nat.card_fin 27

/-- The two cubic generators already fail to commute at point zero. -/
public theorem sylowSubgroup_nonabelian : ¬ IsMulCommutative sylowSubgroup := by
  intro h
  have hx : x ∈ sylowSubgroup := subset_closure (by simp)
  have hy : y ∈ sylowSubgroup := subset_closure (by simp)
  have he := (isMulCommutative_iff.mp h) (⟨x,hx⟩ : sylowSubgroup) ⟨y,hy⟩
  have hn : (xp * yp) 0 ≠ (yp * xp) 0 := by decide +kernel
  apply hn
  have hv := congrArg (fun a : sylowSubgroup => a.val.val 0) he
  change (x.val * y.val) 0 = (y.val * x.val) 0 at hv
  simpa only [x_val,y_val] using hv

private theorem factorization_three : Nat.factorization 17971200 3 = 3 := by
  have hz : padicValNat 3 665600 = 0 :=
    padicValNat.eq_zero_iff.mpr (Or.inr (Or.inr (by norm_num)))
  rw [Nat.factorization_def 17971200 Nat.prime_three,
    show (17971200 : ℕ) = 3 ^ 3 * 665600 by norm_num,
    padicValNat_base_pow_mul (by norm_num) (by norm_num) 3, hz]

/-- Its order is the entire three-part of the certified ambient order. -/
public def sylow : Sylow 3 Atlas1600Group := Sylow.ofCard sylowSubgroup (by
  rw [sylowSubgroup_card, atlas1600Group_card, factorization_three]
  norm_num)

/-- The three-rank bound holds in the whole concrete Tits group. -/
public theorem rank_le_two : primeRank 3 Atlas1600Group ≤ 2 :=
  primeRank_le_two_of_nonabelian_sylow_cube sylow
    (by change Nat.card sylowSubgroup = _; rw [sylowSubgroup_card]; norm_num)
    sylowSubgroup_nonabelian

end Tits.ThreeRank
