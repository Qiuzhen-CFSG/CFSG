private theorem zpMap_cube : ∀ i, zpMap (zpMap (zpMap i)) = i := by
  apply allFin
  decide +kernel
private def zp : Equiv.Perm (Fin 1600) where
  toFun := zpMap
  invFun i := zpMap (zpMap i)
  left_inv := zpMap_cube
  right_inv := zpMap_cube

private theorem yp_eq : yp = gp⁻¹ * xp * gp := by
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem zp_eq : zp = yp * xp * yp⁻¹ * xp⁻¹ := by
  apply Equiv.ext
  apply allFin
  decide +kernel

private theorem x_val : x.val = xp := by
  change (atlas1600ParrottAssignment .r8).val * (atlas1600ParrottAssignment .s8).val = _
  simp only [atlas1600ParrottAssignment_val, permutation, xp]
private theorem g_val : conjugator.val = gp := by
  change (atlas1600ParrottAssignment .r1).val * (atlas1600ParrottAssignment .s3).val *
    (atlas1600ParrottAssignment .r8).val *
    (atlas1600ParrottAssignment .r1).val * (atlas1600ParrottAssignment .s8).val *
    (atlas1600ParrottAssignment .s1).val = _
  simp only [atlas1600ParrottAssignment_val, permutation, gp]
private theorem y_val : y.val = yp := by
  change conjugator.val⁻¹ * x.val * conjugator.val = _
  rw [g_val, x_val, yp_eq]
private theorem z_val : z.val = zp := by
  change y.val * x.val * y.val⁻¹ * x.val⁻¹ = _
  rw [y_val, x_val, zp_eq]
private theorem x_cube : x ^ 3 = 1 := by
  apply Subtype.ext
  change x.val ^ 3 = 1
  rw [x_val]
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem y_cube : y ^ 3 = 1 := by
  change (conjugator⁻¹ * x * conjugator) ^ 3 = 1
  calc
    _ = conjugator⁻¹ * x ^ 3 * conjugator := by simp only [pow_succ, pow_zero]; group
    _ = 1 := by rw [x_cube]; group
private theorem z_cube : z ^ 3 = 1 := by
  apply Subtype.ext
  change z.val ^ 3 = 1
  rw [z_val]
  apply Equiv.ext
  apply allFin
