public theorem L0G0_eq_atlas : L0G0 = atlas1600A := by
  apply Equiv.ext
  apply allFin
  decide +kernel

public theorem L0G1_eq_atlas : L0G1 = atlas1600B := by
  apply Equiv.ext
  apply allFin
  decide +kernel

public theorem H0_eq_atlas : H0 = atlas1600Subgroup := by
  apply le_antisymm
  · intro g hg
    obtain ⟨w, rfl⟩ := hg
    have hgen (i : Fin 4) : L0Gen i ∈ atlas1600Subgroup := by
      fin_cases i <;> simp only [L0Gen, L0G0_eq_atlas, L0G1_eq_atlas]
      · exact atlas1600A_mem
      · exact atlas1600B_mem
      · exact atlas1600Subgroup.inv_mem atlas1600A_mem
      · exact atlas1600Subgroup.inv_mem atlas1600B_mem
    induction w with
    | nil => exact atlas1600Subgroup.one_mem
    | cons i w ih => exact atlas1600Subgroup.mul_mem (hgen i) ih
  · apply (Subgroup.closure_le H0).mpr
    intro g hg
    rcases hg with rfl | hg
    · exact ⟨[0], by simp [evalWord, L0Gen, L0G0_eq_atlas]⟩
    · have hg' : g = atlas1600B := hg
      subst g
      exact ⟨[1], by simp [evalWord, L0Gen, L0G1_eq_atlas]⟩

