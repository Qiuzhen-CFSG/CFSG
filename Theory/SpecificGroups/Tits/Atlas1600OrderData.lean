@[expose] public def H1 : Subgroup (Equiv.Perm (Fin 1600)) :=
  wordSubgroup L1Gen L1Inv L1Inv_spec

@[expose] public def L1GenWordBlock0 (x : Fin 6) : List (Fin 4) :=
  (if x.val < 3 then (if x.val < 1 then [2, 1] else (if x.val < 2 then [1, 2, 1, 2, 1, 2, 3, 2, 1, 2, 1, 2, 1, 2, 3, 0, 3, 0, 1, 0, 1, 0, 1, 0, 3, 0, 1, 0, 1, 0, 3] else [1, 2, 3, 2, 1, 2, 3, 2, 3, 2, 1, 2, 3, 2, 1, 0, 1, 0, 3, 0, 1, 0, 1, 0, 1, 0, 3, 0, 1, 0, 3])) else (if x.val < 4 then [3, 0] else (if x.val < 5 then [1, 2, 3, 2, 3, 2, 1, 2, 3, 2, 3, 2, 3, 2, 1, 2, 1, 0, 3, 0, 3, 0, 3, 0, 1, 0, 3, 0, 3, 0, 3] else [1, 2, 3, 2, 1, 2, 3, 2, 3, 2, 3, 2, 1, 2, 3, 2, 3, 0, 1, 0, 3, 0, 1, 0, 1, 0, 3, 0, 1, 0, 3])))

@[expose] public def L1GenWord (x : Fin 6) : List (Fin 4) :=
  L1GenWordBlock0 x

public theorem L1Gen_eq_word (i : Fin 6) :
    L1Gen i = evalWord L0Gen (L1GenWord i) := by
  apply Equiv.ext
  revert i
  apply allFin₂
  decide +kernel

public theorem H1_le : H1 ≤ H0 :=
  wordSubgroup_le_of_gen_mem (fun i => by
    rw [L1Gen_eq_word i]
    exact evalWord_mem_wordSubgroup L0Gen L0Inv L0Inv_spec _)

public theorem H1_fix : ∀ k : H1, (k : Equiv.Perm (Fin 1600)) 0 = 0 :=
  wordSubgroup_fix_of_gen_fix L1Gen L1Inv L1Inv_spec (by decide +kernel)

