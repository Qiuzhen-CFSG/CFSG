@[expose] public def L0Gen : Fin 4 → Equiv.Perm (Fin 1600)
  | 0 => L0G0
  | 1 => L0G1
  | 2 => L0G0⁻¹
  | 3 => L0G1⁻¹

@[expose] public def L0Inv : Fin 4 → Fin 4
  | 0 => 2
  | 1 => 3
  | 2 => 0
