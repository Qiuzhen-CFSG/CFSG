/-!
# Explicit data for the Atlas degree-1600 order certificate

The permutations come from `refs/original/n-group-global/atlas-tits-p1600-{a,b}.g`.
A Schreier chain with base 0, 1, 2 has candidate orbit lengths 1600, 351, 32.
GAP only produces the witnesses; the statements below are checked by the kernel.
Inverse GAP point maps preserve the order of word multiplication. Point maps are
packed integer tables, decoded by shifts and remainders in the kernel. Word tables
use balanced blocks of 64 entries to keep kernel substitution local.
-/

namespace Tits.Atlas1600OrderCertificate

open Theory.GroupTheory
set_option maxRecDepth 20000
set_option maxHeartbeats 1600000

@[expose] public def checkNat (f : Nat → Bool) : Nat → Bool
  | 0 => true
  | n + 1 => checkNat f n && f n

private theorem checkNat_spec (f : Nat → Bool) (n : Nat) :
    checkNat f n = true ↔ ∀ i, i < n → f i = true := by
  induction n with
  | zero => simp [checkNat]
  | succ n ih =>
    rw [checkNat, Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h, h'⟩ i hi
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | rfl
      · exact h i hlt
      · exact h'
    · intro h
      exact ⟨fun i hi => h i (Nat.lt_succ_of_lt hi), h n (Nat.lt_succ_self n)⟩

@[expose] public def checkFin {n : Nat} (f : Fin n → Bool) : Bool :=
  checkNat (fun k => if h : k < n then f ⟨k, h⟩ else true) n

public theorem checkFin_spec {n : Nat} (f : Fin n → Bool) :
    checkFin f = true ↔ ∀ i, f i = true := by
  rw [checkFin, checkNat_spec]
  constructor
  · intro h ⟨i, hi⟩
    simpa only [dif_pos hi] using h i hi
  · intro h i hi
    simpa only [dif_pos hi] using h ⟨i, hi⟩

public theorem allFin {n : Nat} (P : Fin n → Prop) [DecidablePred P]
    (h : checkFin (fun i => decide (P i)) = true) : ∀ i, P i := by
  intro i
  exact of_decide_eq_true ((checkFin_spec _).mp h i)

public theorem allFin₂ {n m : Nat} (P : Fin n → Fin m → Prop)
    [∀ i j, Decidable (P i j)]
    (h : checkFin (fun i => checkFin (fun j => decide (P i j))) = true) :
    ∀ i j, P i j := by
  intro i
  exact allFin _ ((checkFin_spec _).mp h i)

public theorem allFin₃ {n m p : Nat} (P : Fin n → Fin m → Fin p → Prop)
    [∀ i j k, Decidable (P i j k)]
    (h : checkFin (fun i => checkFin (fun j => checkFin (fun k => decide (P i j k)))) = true) :
    ∀ i j k, P i j k := by
  intro i
  exact allFin₂ _ ((checkFin_spec _).mp h i)

@[expose] public def L0G0MapPacked : Nat := 

@[expose] public def L0G0Map (x : Fin 1600) : Fin 1600 :=
  ⟨(L0G0MapPacked >>> (11 * x.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

@[expose] public def L0G0InvMapPacked : Nat := 

@[expose] public def L0G0InvMap (x : Fin 1600) : Fin 1600 :=
  ⟨(L0G0InvMapPacked >>> (11 * x.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

private theorem L0G0_left : ∀ x, L0G0InvMap (L0G0Map x) = x := by
  apply allFin
  decide +kernel

@[expose] public def L0G0 : Equiv.Perm (Fin 1600) :=
  tablePerm L0G0Map L0G0InvMap (by exact L0G0_left)
    (by exact rightInverse_of_leftInverse_fin L0G0_left)

