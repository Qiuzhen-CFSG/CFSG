theorem model : Models parrottGenerator parrottR1Subgroup input where
  zero := rfl
  relators := by
    intro w hw
    change w ∈ (relatorIndices.map parrottRelatorWord).toArray at hw
    simp only [List.mem_toArray, List.mem_map] at hw
    obtain ⟨r, _, rfl⟩ := hw
    have bridge (v : Word ParrottGenerator) :
        eval parrottGenerator v = FreeGroup.lift parrottGenerator (FreeGroup.mk v) := by
      rw [FreeGroup.lift_mk]
      unfold eval
      congr 2
      funext a
      unfold letterValue
      cases a.2 <;> rfl
    rw [bridge]
    exact parrottRelatorWord_eval r
  subgroup := by
    intro a ha
    have h : a.2 = true ∧ a.1 ≠ ParrottGenerator.r8 := by
      rcases a with ⟨a, b⟩
      cases a <;> cases b <;> simp_all [input]
    simp only [letterValue, h.1, ↓reduceIte]
    exact Subgroup.subset_closure ⟨a.1, h.2, rfl⟩

theorem relator_mem (r : ParrottRelatorIndex) :
    parrottRelatorWord r ∈ input.relators := by
  change parrottRelatorWord r ∈ (relatorIndices.map parrottRelatorWord).toArray
  apply List.mem_toArray.mpr
  apply List.mem_map.mpr
  refine ⟨r, ?_, rfl⟩
  cases r <;> simp [relatorIndices]

