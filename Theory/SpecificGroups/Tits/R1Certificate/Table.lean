/-- The surviving immutable representative number for each table row. -/
noncomputable def index (i : Fin 1755) : Nat := (entry i.val).1

/-- The empty representative is the first surviving row. -/
def initial : Fin 1755 := 0

theorem initial_index : index initial = 0 := rfl

/-- The signed transition table. Bounds are enforced by the codomain; the
