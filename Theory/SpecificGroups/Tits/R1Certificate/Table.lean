/-- Assemble two adjacent intervals without enumerating a large disjunction. -/
theorem interval_join {P : Fin 1755 → Prop} {lo mid hi : Nat}
    (left : ∀ i, lo ≤ i.val → i.val < mid → P i)
    (right : ∀ i, mid ≤ i.val → i.val < hi → P i) :
    ∀ i, lo ≤ i.val → i.val < hi → P i := by
  intro i hlo hhi
  by_cases hm : i.val < mid
  · exact left i hlo hm
  · exact right i (Nat.le_of_not_gt hm) hhi

theorem interval_singleton {P : Fin 1755 → Prop} {lo : Nat} (bound : lo < 1755)
    (h : P ⟨lo, bound⟩) : ∀ i, lo ≤ i.val → i.val < lo + 1 → P i := by
  intro i hlo hhi
  have he : i = ⟨lo, bound⟩ :=
    Fin.ext (Nat.le_antisymm (Nat.lt_succ_iff.mp hhi) hlo)
  exact he ▸ h

