module

public import Theory.SpecificGroups.Tits.R1Presentation
public import Theory.GroupTheory.DihedralPresentation

/-!
# The two-involution subgroup of the local Parrott presentation

Relations I and VI(ii) give `r1² = s1² = (s1 * r1)⁵ = 1`.
The subgroup generated by these two involutions is therefore an image of the
dihedral group of order ten. This proves finiteness and the upper bound without
assuming that the local presented group is finite.

Source: Parrott, “A Characterization of the Tits' Simple Group” (1972), §5,
p. 683; see `refs/original/n-group-global/parrott-tits-presentation.md`.
-/

namespace Tits

/-- The local subgroup generated by `r1` and `s1` has at most ten elements. -/
public theorem parrottR1DihedralSubgroup_finite_card_le :
    Finite parrottR1DihedralSubgroup ∧ Nat.card parrottR1DihedralSubgroup ≤ 10 := by
  have hr : parrottR1Generator .r1 ^ 2 = 1 := by
    simpa [parrottR1Relator, parrottR1RelatorInclusion, parrottRelator,
      parrottR1Delete] using parrottR1_generators_satisfy_relations .i_r1
  have hs : parrottR1Generator .s1 ^ 2 = 1 := by
    simpa [parrottR1Relator, parrottR1RelatorInclusion, parrottRelator,
      parrottR1Delete] using parrottR1_generators_satisfy_relations .i_s1
  have hsr : (parrottR1Generator .s1 * parrottR1Generator .r1) ^ 5 = 1 := by
    simpa [parrottR1Relator, parrottR1RelatorInclusion, parrottRelator,
      parrottR1Delete] using parrottR1_generators_satisfy_relations .vi_s1_r1
  exact Subgroup.closure_pair_finite_card_le_of_involutions (by decide : 0 < 5)
    (parrottR1Generator .r1) (parrottR1Generator .s1) hr hs hsr

end Tits
