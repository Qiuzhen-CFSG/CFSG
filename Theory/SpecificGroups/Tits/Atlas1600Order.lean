module

public import Theory.SpecificGroups.Tits.Atlas1600OrderLevel0
public import Theory.SpecificGroups.Tits.Atlas1600OrderLevel1
public import Theory.SpecificGroups.Tits.Atlas1600OrderLevel2

/-!
# Order of the Atlas degree-1600 permutation group

The certified stabilizer chain at points 0, 1, and 2 has successive indices
1600, 351, and 32, with trivial terminal subgroup. Multiplying these indices
gives the order of the subgroup generated by the two Atlas permutations.

The permutation witnesses come from
`refs/original/n-group-global/atlas-tits-p1600-{a,b}.g`; all identities used by
the chain are checked in Lean by the imported certificates.
-/

namespace Tits

/-- The concrete Atlas permutation group has order `17971200`. -/
public theorem atlas1600Group_card : Nat.card Atlas1600Group = 17971200 := by
  change Nat.card atlas1600Subgroup = 17971200
  rw [← Atlas1600OrderCertificate.H0_eq_atlas,
    Atlas1600OrderCertificate.H0_card_step,
    Atlas1600OrderCertificate.H1_card_step,
    Atlas1600OrderCertificate.H2_card]

end Tits
