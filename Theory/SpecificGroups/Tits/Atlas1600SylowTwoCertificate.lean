/-- The concrete permutation normal form used in pointwise certificates. -/
@[expose] public def normalForm (n : Fin 2048) : Equiv.Perm (Fin 1600) :=
  s1Perm ^ (n.val % 2) *
    s2Perm ^ (n.val / 2 % 2) *
    s3Perm ^ (n.val / 4 % 4) *
    s4Perm ^ (n.val / 16 % 2) *
    s5Perm ^ (n.val / 32 % 4) *
    s6Perm ^ (n.val / 128 % 2) *
    s7Perm ^ (n.val / 256 % 4) *
    s8Perm ^ (n.val / 1024 % 2)

-- Three 11-bit fields at each first-point image: the two candidate
-- indices and the second-point image that selects the first candidate.
private def decoderData : Nat := 

private def decode (x y : Fin 1600) : Nat :=
  let entry := (decoderData >>> (33 * x.val)) % 8589934592
  if y.val = entry >>> 22 then entry % 2048 else (entry >>> 11) % 2048

private theorem allIndices (P : Fin 2048 → Prop) [DecidablePred P]
    (h : checkNat (fun k => decide (P ⟨k % 2048, Nat.mod_lt _ (by decide)⟩)) 2048 = true) :
    ∀ i, P i := by
  have hcheck (f : Nat → Bool) (n : Nat) :
      checkNat f n = true → ∀ k < n, f k = true := by
    induction n with
    | zero => simp
    | succ n ih =>
      simp only [checkNat, Bool.and_eq_true]
      rintro ⟨hn, hfn⟩ k hk
      rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hlt | rfl
      · exact ih hn k hlt
      · exact hfn
  rintro ⟨k, hk⟩
  have hp := of_decide_eq_true (hcheck _ _ h k hk)
  simpa only [Nat.mod_eq_of_lt hk] using hp

private theorem decode_normalForm :
    ∀ n : Fin 2048, decode (normalForm n 0) (normalForm n 930) = n.val := by
  apply allIndices
  decide +kernel

/-- The two point images distinguish the 2048 concrete normal forms. -/
public theorem pair_injective :
    Function.Injective (fun n : Fin 2048 => (normalForm n 0, normalForm n 930)) := by
  intro i j h
  apply Fin.ext
  calc
    i.val = decode (normalForm i 0) (normalForm i 930) := (decode_normalForm i).symm
    _ = decode (normalForm j 0) (normalForm j 930) :=
      congrArg (fun p : Fin 1600 × Fin 1600 => decode p.1 p.2) h
    _ = j.val := decode_normalForm j

/-- The ordered products are distinct as permutations. -/
public theorem normalForm_injective : Function.Injective normalForm := by
  intro i j h
  exact pair_injective (congrArg (fun p : Equiv.Perm (Fin 1600) => (p 0, p 930)) h)

