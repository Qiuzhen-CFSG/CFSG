module

public import Theory.SpecificGroups.Tits.SharpOuterBound.LocalRestrictions
public import Theory.SpecificGroups.Tits.SharpOuterBound.LocalImageBound.PairCandidates
public import Theory.SpecificGroups.Tits.SharpOuterBound.LocalImageBound.FusionConstraints
public import Theory.SpecificGroups.Tits.SharpOuterBound.LocalImageBound.SylowPairExhaustion
public import Theory.SpecificGroups.Tits.SharpOuterBound.LocalImageBound.FusionElimination

/-!
# Counting compatible restrictions by two generator images

The actual marked Sylow subgroup is generated by `s3` and `s8`. Compatible
parabolic extensions preserve two certified internal conjugacies. An explicit
mask selects 2048 pairs from a rectangular family of candidate image indices.
The certified exhaustion covers every Sylow automorphism, and the certified
fusion elimination places every compatible pair in the mask. Injectivity of
the two-generator images therefore bounds all compatible restrictions by 2048.
The unconditional bound discharges the local counting premise of the outer-group
assembly.

Source: Parrott (1972), §5, p.683, and Aschbacher–Smith F.1.12, pp.263–264.
-/

namespace Tits.SharpOuterBound
open ExceptionalParabolics LocalImageBound

/-- Exhaustion of Sylow image pairs and elimination by the two local conjugacies
suffice for the desired compatible-restriction count. -/
public theorem compatibleSylowRestrictions_card_le_of_pair_certificates
    (hexhaust : ∀ f : MulAut S, ∃ i : Fin 8192, candidatePair i = generatorPair f)
    (heliminate : ∀ i : Fin 8192, FirstFusionCondition (candidatePair i) →
      SecondFusionCondition (candidatePair i) → allowedIndex i = true) :
    Nat.card CompatibleSylowRestrictions ≤ 2048 := by
  let e : CompatibleSylowRestrictions ↪ allowedPairs :=
    { toFun := fun f => ⟨generatorPair f.val, by
        obtain ⟨i, hi⟩ := hexhaust f.val
        obtain ⟨hfirst, hsecond⟩ := compatible_fusionConditions f.val f.property
        rw [← hi] at hfirst hsecond ⊢
        exact candidatePair_mem_allowedPairs (heliminate i hfirst hsecond)⟩
      inj' := by
        intro f g h
        exact Subtype.ext (generatorPair_injective (congrArg Subtype.val h)) }
  have h := Nat.card_le_card_of_injective e e.injective
  rw [Nat.card_eq_finsetCard] at h
  exact h.trans allowedPairs_card_le

/-- At most 2048 automorphisms of the actual marked Sylow subgroup extend
compatibly to both parabolics along their subgroup inclusions. -/
public theorem compatibleSylowRestrictions_card_le :
    Nat.card CompatibleSylowRestrictions ≤ 2048 :=
  compatibleSylowRestrictions_card_le_of_pair_certificates
    generatorPair_exhaustive candidatePair_allowed_of_fusion

end Tits.SharpOuterBound
