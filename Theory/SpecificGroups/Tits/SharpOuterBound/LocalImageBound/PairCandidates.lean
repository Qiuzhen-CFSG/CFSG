module

public import Theory.SpecificGroups.Tits.SharpOuterBound.LocalImageBound.TwoGenerators

/-!
# Finite candidate indices for Tits Sylow automorphisms

The two tables give 128 possible first indices and 64 possible second
indices. A bit mask selects 2048 of their pairs. This module certifies only
the size of that selection. It does not assert that every Sylow automorphism
occurs in the tables or that local extensions force the mask condition.
Those are separate exhaustion and fusion obligations.

The data were discovered with GAP on the actual Atlas permutations, using
Parrott's §5 marking and the existing ordered normal forms. No GAP result
is used as a proof. See `source/generate_candidates.py` for the data format.
-/

@[expose] public section
namespace Tits.SharpOuterBound.LocalImageBound

/-- Candidate normal-form indices for the image of `s3`. -/
def firstIndices : Fin 128 → Fin 2048 :=
  ![4, 6, 13, 15, 20, 22, 29, 31, 32, 34, 41, 43, 48, 50, 57, 59, 69, 71, 76, 78, 85, 87, 92, 94, 97, 99, 104, 106, 113, 115, 120, 122, 132, 134, 141, 143, 148, 150, 157, 159, 160, 162, 169, 171, 176, 178, 185, 187, 197, 199, 204, 206, 213, 215, 220, 222, 225, 227, 232, 234, 241, 243, 248, 250, 768, 770, 777, 779, 784, 786, 793, 795, 805, 807, 812, 814, 821, 823, 828, 830, 833, 835, 840, 842, 849, 851, 856, 858, 868, 870, 877, 879, 884, 886, 893, 895, 896, 898, 905, 907, 912, 914, 921, 923, 933, 935, 940, 942, 949, 951, 956, 958, 961, 963, 968, 970, 977, 979, 984, 986, 996, 998, 1005, 1007, 1012, 1014, 1021, 1023]

/-- Candidate normal-form indices for the image of `s8`. -/
def secondIndices : Fin 64 → Fin 2048 :=
  ![1024, 1040, 1070, 1077, 1089, 1105, 1135, 1140, 1152, 1168, 1189, 1214, 1217, 1233, 1252, 1279, 1284, 1300, 1321, 1330, 1349, 1365, 1384, 1395, 1423, 1439, 1449, 1458, 1486, 1502, 1512, 1523, 1546, 1562, 1572, 1599, 1611, 1627, 1637, 1662, 1674, 1690, 1711, 1716, 1739, 1755, 1774, 1781, 1797, 1813, 1832, 1843, 1860, 1876, 1897, 1906, 1934, 1950, 1960, 1971, 1999, 2015, 2025, 2034]

/-- The rectangular family of 8192 candidate image pairs. -/
def candidatePair (i : Fin 8192) : Fin 2048 × Fin 2048 :=
  (firstIndices ⟨i.val / 64, by omega⟩, secondIndices ⟨i.val % 64, by omega⟩)

/-- A finite mask selecting the expected compatible pairs. -/
def allowedMask : Nat := 

def allowedIndex (i : Fin 8192) : Bool := (allowedMask >>> i.val) % 2 == 1

def allowedIndices : Finset (Fin 8192) := Finset.univ.filter (fun i => allowedIndex i = true)

set_option maxRecDepth 40000 in
set_option maxHeartbeats 1600000 in
/-- The selected family contains exactly 2048 indices; this is only a data check. -/
theorem allowedIndices_card : allowedIndices.card = 2048 := by
  decide +kernel

/-- Image pairs selected by the mask. -/
def allowedPairs : Finset (Fin 2048 × Fin 2048) := allowedIndices.image candidatePair

theorem allowedPairs_card_le : allowedPairs.card ≤ 2048 :=
  (Finset.card_image_le).trans_eq allowedIndices_card

theorem candidatePair_mem_allowedPairs {i : Fin 8192} (h : allowedIndex i = true) :
    candidatePair i ∈ allowedPairs := by
  apply Finset.mem_image.mpr
  exact ⟨i, by simp [allowedIndices, h], rfl⟩

end Tits.SharpOuterBound.LocalImageBound
end
