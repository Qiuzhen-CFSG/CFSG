module
public import Theory.SpecificGroups.Tits.SharpOuterBound.LocalImageBound.FusionElimination.Coordinates
public import Theory.SpecificGroups.Tits.SharpOuterBound.LocalImageBound.PairCandidates

/-!
# Finite label checks for the Tits parabolic fusion constraints

Two label tables are invariant under Sylow conjugation. The five and three
coset rotations preserve their respective labels whenever the conjugate
could belong to the Sylow subgroup, as detected on the two separating points.
The labels are computed by connected components of precisely these finite
relations; no external conjugacy-class computation is trusted.

Source: the Parrott §5 marking, p.683. See `source/generate_certificate.py`.
-/

@[expose] public section
namespace Tits.SharpOuterBound.LocalImageBound.FusionElimination
open OuterOddSubgroups.OverlapCentralizers

def firstLabelData : Nat := 

def secondLabelData : Nat := 

def label (k : Fin 2) (n : Fin 2048) : Nat :=
  ((![firstLabelData, secondLabelData] k) >>> (5 * n.val)) % 32

def fastGenerator : Fin 2 → Equiv.Perm (Fin 1600) := ![Packed.perm 4, Packed.perm 9]
def fastGeneratorInv : Fin 2 → Equiv.Perm (Fin 1600) := ![Packed.perm 4 ^ 3, Packed.perm 9]
def fastRotation : Fin 2 → Equiv.Perm (Fin 1600) :=
  ![Packed.perm 2 * Packed.perm 0, Packed.perm 9 * Packed.perm 1]
def fastRotationInv : Fin 2 → Equiv.Perm (Fin 1600) :=
  ![Packed.perm 0 * Packed.perm 2, Packed.perm 1 * Packed.perm 9]

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
theorem fastGeneratorInv_eq (j : Fin 2) : fastGeneratorInv j = (fastGenerator j)⁻¹ := by
  apply eq_inv_iff_mul_eq_one.mpr
  have h : ∀ (j : Fin 2) (p : Fin 1600),
      (fastGeneratorInv j * fastGenerator j) p = p := by
    apply Atlas1600OrderCertificate.allFin₂
    decide +kernel
  exact Equiv.ext (h j)

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
theorem fastRotationInv_eq (k : Fin 2) : fastRotationInv k = (fastRotation k)⁻¹ := by
  apply eq_inv_iff_mul_eq_one.mpr
  have h : ∀ (k : Fin 2) (p : Fin 1600),
      (fastRotationInv k * fastRotation k) p = p := by
    apply Atlas1600OrderCertificate.allFin₂
    decide +kernel
  exact Equiv.ext (h k)

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
theorem label_generator_check (k j : Fin 2) (n : Fin 2048) :
    label k (coordinate (fastGenerator j * fastNormalForm n * fastGeneratorInv j)) = label k n := by
  fin_cases k <;> fin_cases j <;>
    revert n <;> apply Atlas1600OrderCertificate.allFin <;> decide +kernel

def pairValidData : Nat := 

def pairValid (a b : Fin 1600) : Prop :=
  let row := pairValidData >>> (22 * a.val)
  row % 2048 = b.val + 1 ∨ (row >>> 11) % 2048 = b.val + 1

instance instDecidablePairValid (a b : Fin 1600) : Decidable (pairValid a b) := by
  unfold pairValid
  infer_instance

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
theorem pairValid_nf (n : Fin 2048) :
    pairValid (fastNormalForm n 0) (fastNormalForm n 930) := by
  revert n
  apply Atlas1600OrderCertificate.allFin
  decide +kernel

def rotationCheck (k : Fin 2) (j : Nat) (n : Fin 2048) : Prop :=
  let p := fastRotation k ^ j * fastNormalForm n * fastRotationInv k ^ j
  let a := coordinate p
  pairValid (p 0) (p 930) → label k a = label k n

instance instDecidableRotationCheck (k : Fin 2) (j : Nat) (n : Fin 2048) : Decidable (rotationCheck k j n) := by
  unfold rotationCheck
  infer_instance

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
theorem first_rotation_check (j : Fin 5) (n : Fin 2048) : rotationCheck 0 j.val n := by
  fin_cases j <;>
    revert n <;> apply Atlas1600OrderCertificate.allFin <;> decide +kernel

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
theorem second_rotation_check (j : Fin 3) (n : Fin 2048) : rotationCheck 1 j.val n := by
  fin_cases j <;>
    revert n <;> apply Atlas1600OrderCertificate.allFin <;> decide +kernel

end Tits.SharpOuterBound.LocalImageBound.FusionElimination
end
