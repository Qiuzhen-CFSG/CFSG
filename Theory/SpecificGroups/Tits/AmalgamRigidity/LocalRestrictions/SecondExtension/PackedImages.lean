module

public import Theory.SpecificGroups.Tits.AmalgamRigidity.LocalRestrictions.SecondExtension.Images

/-!
# Certified packed maps for the nine proposed images

These 11-bit point tables are only witnesses. Their equality with the specified
normal-form words is checked on all 1600 points before they are used in any
relation certificate. Reusing the certified tables keeps nested word evaluation
out of the subsequent kernel checks.
Source and generator conventions: `Images` and Parrott (1972), §5, p.683.
-/

@[expose] public section
namespace Tits.AmalgamRigidity.SecondExtension
open Atlas1600OrderCertificate

def imageData0 : Nat := 

def imageData1 : Nat := 

def imageData2 : Nat := 

def imageData3 : Nat := 

def imageData4 : Nat := 

def imageData5 : Nat := 

def imageData6 : Nat := 

def imageData7 : Nat := 

def imageData8 : Nat := 

def imageData : Fin 9 → Nat := ![imageData0, imageData1, imageData2, imageData3, imageData4, imageData5, imageData6, imageData7, imageData8]

def imagePoint (a : Fin 9) (p : Fin 1600) : Fin 1600 :=
  ⟨((imageData a >>> (11 * p.val)) % 2048) % 1600, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
theorem imagePoint_eq (a : Fin 9) (p : Fin 1600) :
    imagePoint a p = images packedGen a p := by
  revert a p
  apply allFin₂
  decide +kernel

def packedImage (a : Fin 9) : Equiv.Perm (Fin 1600) where
  toFun := imagePoint a
  invFun := (images packedGen a).symm
  left_inv p := by rw [imagePoint_eq]; exact (images packedGen a).left_inv p
  right_inv p := by rw [imagePoint_eq]; exact (images packedGen a).right_inv p

theorem packedImage_eq (a : Fin 9) : packedImage a = images packedGen a :=
  Equiv.ext (imagePoint_eq a)

theorem perm_images (a : Fin 9) : perm (images gen a) = packedImage a := by
  rw [packedImage_eq]
  simp only [images, map_mul, map_word, map_rep]
  congr 2 <;> exact funext perm_gen

end Tits.AmalgamRigidity.SecondExtension
