module

public import Theory.SpecificGroups.Tits.RelativeSecondBlockLayers.SecondOrder
public import Theory.GroupTheory.CyclicExtension

/-!
# Collection relations for the additional second-parabolic automorphism

Eight power and 28 conjugation equations collect the Sylow words. The checked
three-coset transitions then collect the entire second parabolic. These lemmas
apply to the finite subgroup generated by pairs of original and proposed image
generators; uniqueness in the first coordinate will prove multiplicativity.

The cyclic collection proof is adapted from `Atlas1600SylowTwoEnumeration`.
The equations and coset conventions are Parrott (1972), §5, p.683, and
`RelativeSecondBlockLayers.SecondOrderCertificate`.
-/

@[expose] public section
namespace Tits.AmalgamRigidity.SecondExtension
open Theory.GroupTheory
open RelativeSecondBlockLayers
variable {G : Type*} [Group G]

variable (g : Fin 9 → G)

local notation "s₁" => g 1
local notation "s₂" => g 2
local notation "s₃" => g 3
local notation "s₄" => g 4
local notation "s₅" => g 5
local notation "s₆" => g 6
local notation "s₇" => g 7
local notation "s₈" => g 8

def word (g : Fin 9 → G) (n : Fin 2048) : G :=
  g 1 ^ (n.val % 2) * g 2 ^ (n.val / 2 % 2) *
  g 3 ^ (n.val / 4 % 4) * g 4 ^ (n.val / 16 % 2) *
  g 5 ^ (n.val / 32 % 4) * g 6 ^ (n.val / 128 % 2) *
  g 7 ^ (n.val / 256 % 4) * g 8 ^ (n.val / 1024 % 2)

def sylowClosure (g : Fin 9 → G) : Subgroup G :=
  Subgroup.closure {g 8, g 7, g 6, g 5, g 4, g 3, g 2, g 1}

def rep (g : Fin 9 → G) (i : Fin 3) : G := (g 8 * g 0) ^ i.val

/-- Concrete equations, not an assumed homomorphism or extension. -/
structure SylowRelations : Prop where
  power_1 : g 1 ^ 2 = 1
  power_2 : g 2 ^ 2 = 1
  power_3 : g 3 ^ 4 = 1
  power_4 : g 4 ^ 2 = 1
  power_5 : g 5 ^ 4 = 1
  power_6 : g 6 ^ 2 = 1
  power_7 : g 7 ^ 4 = 1
  power_8 : g 8 ^ 2 = 1
  conjugate_2_1 :
    s₂ * s₁ * s₂⁻¹ =
      s₁
  conjugate_3_1 :
    s₃ * s₁ * s₃⁻¹ =
      s₁
  conjugate_3_2 :
    s₃ * s₂ * s₃⁻¹ =
      s₂
  conjugate_4_1 :
    s₄ * s₁ * s₄⁻¹ =
      s₁
  conjugate_4_2 :
    s₄ * s₂ * s₄⁻¹ =
      s₂
  conjugate_4_3 :
    s₄ * s₃ * s₄⁻¹ =
      s₁ * s₂ * s₃ ^ 3
  conjugate_5_1 :
    s₅ * s₁ * s₅⁻¹ =
      s₁
  conjugate_5_2 :
    s₅ * s₂ * s₅⁻¹ =
      s₁ * s₃ ^ 2
  conjugate_5_3 :
    s₅ * s₃ * s₅⁻¹ =
      s₁ * s₃ ^ 3 * s₄
  conjugate_5_4 :
    s₅ * s₄ * s₅⁻¹ =
      s₁ * s₂ * s₃ ^ 2 * s₄
  conjugate_6_1 :
    s₆ * s₁ * s₆⁻¹ =
      s₂ * s₃ ^ 2
  conjugate_6_2 :
    s₆ * s₂ * s₆⁻¹ =
      s₂
  conjugate_6_3 :
    s₆ * s₃ * s₆⁻¹ =
      s₁ * s₂ * s₃ ^ 3 * s₄
  conjugate_6_4 :
    s₆ * s₄ * s₆⁻¹ =
      s₄
  conjugate_6_5 :
    s₆ * s₅ * s₆⁻¹ =
      s₁ * s₄ * s₅ ^ 3
  conjugate_7_1 :
    s₇ * s₁ * s₇⁻¹ =
      s₂ * s₄ * s₅ ^ 2
  conjugate_7_2 :
    s₇ * s₂ * s₇⁻¹ =
      s₁ * s₃ ^ 2 * s₄
  conjugate_7_3 :
    s₇ * s₃ * s₇⁻¹ =
      s₅
  conjugate_7_4 :
    s₇ * s₄ * s₇⁻¹ =
      s₂ * s₃ ^ 2 * s₄ * s₅ ^ 2
  conjugate_7_5 :
    s₇ * s₅ * s₇⁻¹ =
      s₃ ^ 3 * s₅ ^ 2 * s₆
  conjugate_7_6 :
    s₇ * s₆ * s₇⁻¹ =
      s₁ * s₂ * s₃ ^ 2 * s₄ * s₆
  conjugate_8_1 :
    s₈ * s₁ * s₈⁻¹ =
      s₂ * s₃ ^ 2 * s₄ * s₅ ^ 2 * s₇ ^ 2
  conjugate_8_2 :
    s₈ * s₂ * s₈⁻¹ =
      s₂ * s₄ * s₆
  conjugate_8_3 :
    s₈ * s₃ * s₈⁻¹ =
      s₁ * s₃ ^ 3 * s₅ ^ 3 * s₇ ^ 3
  conjugate_8_4 :
    s₈ * s₄ * s₈⁻¹ =
      s₄
  conjugate_8_5 :
    s₈ * s₅ * s₈⁻¹ =
      s₂ * s₄ * s₇ ^ 3
  conjugate_8_6 :
    s₈ * s₆ * s₈⁻¹ =
      s₆
  conjugate_8_7 :
    s₈ * s₇ * s₈⁻¹ =
      s₁ * s₃ ^ 2 * s₅ ^ 3 * s₆

/-- The three-coset table, using precisely the existing right-generator convention. -/
def CosetRelations (g : Fin 9 → G) : Prop :=
  ∀ (a : Fin 9) (i : Fin 3), rep g i * g a =
    word g (SecondOrder.factor a i) * rep g (SecondOrder.dest a i)


theorem map_word {H : Type*} [Group H] (f : G →* H) (n : Fin 2048) :
    f (word g n) = word (f ∘ g) n := by
  simp only [word, Function.comp_apply, map_mul, map_pow]

theorem map_rep {H : Type*} [Group H] (f : G →* H) (i : Fin 3) :
    f (rep g i) = rep (f ∘ g) i := by
  simp only [rep, Function.comp_apply, map_mul, map_pow]


end Tits.AmalgamRigidity.SecondExtension
