module
public import Theory.SpecificGroups.Tits.AmalgamRigidity.FullRee.SecondSeparator.Candidate

/-!
# The coordinate subgroup used for the full Ree second endpoint

The first core coordinate defines a binary character of the verified Sylow
model. Its kernel has order 2048 and is generated by rootOne and roots 1–9.
The short separator preserves this kernel. These results supply the small
factor in the graph collection argument; no identification by abstract order
with an ambient root radical is assumed.

Source: Shinoda (1975), (2.3), pp.81–83; the marked comparison used by the
consumer is Parrott (1972), p.683 and Aschbacher–Smith F.1.11–12, pp.262–263.
-/

@[expose] public section
namespace Tits.AmalgamRigidity.FullRee.SecondExtension
open ReeTwo

private theorem action_b0 (t : FiveFour.Cyclic 4) (x : Core) :
    (SylowModel.Collected.cyclicAction t x).b0 = x.b0 := by
  unfold SylowModel.Collected.cyclicAction
  generalize t.toAdd.val = n
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply, ih]
    rfl

/-- The first binary root coordinate, independent of cyclic-four parity. -/
def radicalCharacter : SylowModel →* FiveFour.Cyclic 2 where
  toFun x := Multiplicative.ofAdd x.left.b0
  map_one' := rfl
  map_mul' x y := by
    rw [← SylowModel.Collected.collectedMul_eq]
    change Multiplicative.ofAdd (x.left.b0 +
      (SylowModel.Collected.cyclicAction x.right y.left).b0) = _
    rw [action_b0]
    rfl

def radical : Subgroup SylowModel := radicalCharacter.ker

@[simp] theorem mem_radical (x : SylowModel) : x ∈ radical ↔ x.left.b0 = 0 := Iff.rfl

/-- The ten generators of the second unipotent radical. -/
def radicalGenerator (i : Fin 10) : SylowModel :=
  ![SylowModel.rootOne, SylowModel.root 1, SylowModel.root 2,
    SylowModel.root 3, SylowModel.root 4, SylowModel.root 5,
    SylowModel.root 6, SylowModel.root 7, SylowModel.root 8, SylowModel.root 9] i

theorem radicalGenerator_mem (i : Fin 10) : radicalGenerator i ∈ radical := by
  exact (by decide +kernel : ∀ i : Fin 10, (radicalGenerator i).left.b0 = 0) i

theorem radical_generated : Subgroup.closure (Set.range radicalGenerator) = radical := by
  apply le_antisymm
  · exact (Subgroup.closure_le _).mpr (by rintro _ ⟨i, rfl⟩; exact radicalGenerator_mem i)
  · intro x hx
    let H := Subgroup.closure (Set.range radicalGenerator)
    have hu : SylowModel.rootOne ∈ H := Subgroup.subset_closure ⟨0, rfl⟩
    have hr (i : CoreRoot) (hi : i ≠ 0) : SylowModel.root i ∈ H := by
      have he : radicalGenerator i = SylowModel.root i := by
        fin_cases i <;> simp_all [radicalGenerator]
      rw [← he]
      exact Subgroup.subset_closure ⟨i, rfl⟩
    have hc : (SemidirectProduct.inl x.left : SylowModel) ∈ H := by
      have he := congrArg (SemidirectProduct.inl : Core →* SylowModel) (Core.normal_form x.left)
      have h0 : x.left.b0 = 0 := hx
      rw [← he]
      simp only [map_mul, map_pow, h0, ZMod.val_zero, pow_zero, one_mul]
      change SylowModel.root 1 ^ _ * SylowModel.root 2 ^ _ * SylowModel.root 3 ^ _ *
        SylowModel.root 4 ^ _ * SylowModel.root 5 ^ _ * SylowModel.root 6 ^ _ *
        SylowModel.root 7 ^ _ * SylowModel.root 8 ^ _ * SylowModel.root 9 ^ _ ∈ H
      repeat first | apply H.mul_mem | apply H.pow_mem | exact hr _ (by decide)
    have ht : (SemidirectProduct.inr x.right : SylowModel) ∈ H := by
      have he : (SemidirectProduct.inr x.right : SylowModel) =
          (SylowModel.rootOne⁻¹) ^ x.right.toAdd.val := by
        rw [SylowModel.rootOne, ← map_inv, inv_inv, ← map_pow, FiveFour.generator_pow_val]
      rw [he]
      exact H.pow_mem (H.inv_mem hu) _
    rw [← SemidirectProduct.inl_left_mul_inr_right x]
    exact H.mul_mem hc ht

theorem radicalCharacter_surjective : Function.Surjective radicalCharacter := by
  intro t
  refine ⟨SylowModel.root 0 ^ t.toAdd.val, ?_⟩
  rw [map_pow]
  change FiveFour.generator 2 ^ t.toAdd.val = t
  exact FiveFour.generator_pow_val t

theorem radical_card : Nat.card radical = 2048 := by
  have h := radical.card_mul_index
  have hi : radical.index = 2 := by
    rw [radical, Subgroup.index_ker, MonoidHom.range_eq_top.mpr radicalCharacter_surjective,
      Subgroup.card_top]
    change Nat.card (ZMod 2) = 2
    simp
  rw [hi, SylowModel.card] at h
  omega

/-- Every Sylow element is a radical element followed by the first root. -/
theorem sylow_split (x : SylowModel) :
    ∃ k : radical, ∃ i : Fin 2, (k : SylowModel) * SylowModel.root 0 ^ i.val = x := by
  let i : Fin 2 := ⟨x.left.b0.val, ZMod.val_lt x.left.b0⟩
  let k := x * (SylowModel.root 0 ^ i.val)⁻¹
  have he : radicalCharacter (SylowModel.root 0 ^ i.val) = radicalCharacter x := by
    rw [map_pow]
    exact FiveFour.generator_pow_val (radicalCharacter x)
  have hk : k ∈ radical := by
    change radicalCharacter k = 1
    simp only [k, map_mul, map_inv, he, mul_inv_cancel]
  exact ⟨⟨k, hk⟩, i, inv_mul_cancel_right x _⟩

/-- The old core and cyclic-four factor give a generator criterion for the Sylow group. -/
theorem sylow_hom_ext {G : Type*} [Group G] (f g : SylowModel →* G)
    (hu : f SylowModel.rootOne = g SylowModel.rootOne)
    (hr : ∀ i, f (SylowModel.root i) = g (SylowModel.root i)) : f = g := by
  apply SemidirectProduct.hom_ext
  · apply Core.hom_ext
    exact hr
  · apply FiveFour.cyclicHom_ext
    have hh := congrArg Inv.inv hu
    simpa only [SylowModel.rootOne, map_inv, inv_inv, MonoidHom.comp_apply] using hh

theorem radicalCharacter_separator (x : SylowModel) :
    radicalCharacter (SecondSeparator.separator x) = radicalCharacter x := by
  have hh : radicalCharacter.comp SecondSeparator.separator.toMonoidHom = radicalCharacter := by
    apply sylow_hom_ext
    · rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, SecondSeparator.separator_rootOne,
        map_mul]
      rfl
    · intro i
      rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, SecondSeparator.separator_root]
      rfl
  exact DFunLike.congr_fun hh x

/-- Restriction of the already proved involution to the actual coordinate radical. -/
def radicalSeparator : MulAut radical where
  toFun x := ⟨SecondSeparator.separator x, by
    change radicalCharacter (SecondSeparator.separator x) = 1
    rw [radicalCharacter_separator]
    exact x.property⟩
  invFun x := ⟨SecondSeparator.separator x, by
    change radicalCharacter (SecondSeparator.separator x) = 1
    rw [radicalCharacter_separator]
    exact x.property⟩
  left_inv x := Subtype.ext (SecondSeparator.separator_involutive x)
  right_inv x := Subtype.ext (SecondSeparator.separator_involutive x)
  map_mul' x y := Subtype.ext (map_mul SecondSeparator.separator (x : SylowModel) (y : SylowModel))

end Tits.AmalgamRigidity.FullRee.SecondExtension
