private theorem product0 : (Binary.simpleMatrix true 2) * (Binary.simpleMatrix false 2) = matrix4 :=
  decode_mul 52 (Binary.simpleRows true 2) (Binary.simpleRows false 2) rows4 (by decide +kernel)

private theorem product1 : (Binary.simpleMatrix false 2) * matrix4 = matrix5 :=
  decode_mul 52 (Binary.simpleRows false 2) rows4 rows5 (by decide +kernel)

private theorem product2 : (Binary.simpleMatrix false 1) * matrix5 = matrix6 :=
  decode_mul 52 (Binary.simpleRows false 1) rows5 rows6 (by decide +kernel)

private theorem product3 : (Binary.simpleMatrix false 2) * matrix6 = matrix7 :=
  decode_mul 52 (Binary.simpleRows false 2) rows6 rows7 (by decide +kernel)

private theorem product4 : (Binary.simpleMatrix true 2) * matrix7 = matrix8 :=
  decode_mul 52 (Binary.simpleRows true 2) rows7 rows8 (by decide +kernel)

private theorem product5 : (Binary.simpleMatrix false 2) * matrix8 = matrix9 :=
  decode_mul 52 (Binary.simpleRows false 2) rows8 rows9 (by decide +kernel)

private theorem product6 : (Binary.simpleMatrix false 2) * matrix9 = matrix8 :=
  decode_mul 52 (Binary.simpleRows false 2) rows9 rows8 (by decide +kernel)

private theorem product7 : (Binary.simpleMatrix false 1) * matrix8 = matrix10 :=
  decode_mul 52 (Binary.simpleRows false 1) rows8 rows10 (by decide +kernel)

private theorem product16 : (Binary.generatorMatrix .s7) * matrix10 = matrix38 :=
  decode_mul 52 (Binary.generatorRows .s7) rows10 rows38 (by decide +kernel)

private theorem rootOne_word : rootOne =
    Binary.simpleAssignment false 1 * Binary.simpleAssignment false 2 *
      (Products.weyl 2 * Binary.simpleAssignment false 1 * Products.weyl 2) := by
  change Products.root 8 * Products.root 9 * Products.root 11 = _
  rw [show Products.root 11 = Products.weyl 2 * Products.root 8 * Products.weyl 2 from
    Products.transported_cons 2 (routeWord 8) (routeSimple 8)]
  rw [show Products.root 8 = Binary.simpleAssignment false 1 from Products.transported_nil 1,
    show Products.root 9 = Binary.simpleAssignment false 2 from Products.transported_nil 2]

@[simp] private theorem rootOne_val : rootOne.val = matrix10 := by
  rw [rootOne_word]
  simp only [Products.weyl, Units.val_mul, Binary.simpleAssignment, mul_assoc]
  rw [product0, product1, product2, product3, product4, product5, product6, product7]

private def conjugateTailRows : Array ℕ := #[3, 17592186044418, 175921860444164, 12, 268435456, 536870912, 268501248, 537002496, 32832, 16512, 33856, 18560, 158329675448323, 246290606718990, 211106239873038, 140737497792515, 16777216, 33558528, 67108928, 134217728, 268439552, 536879104, 16384, 32768, 268505088, 537010176, 280576, 558080, 73014444048, 146028888096, 4294967296, 8589934592, 8814346633216, 4434553733120, 8813272891392, 4432406249472, 158329674399744, 246290604621824, 211106232532992, 140737488355328, 281474976710656, 564049465049088, 1125917086711808, 2251799813685248, 1172526071808, 2345052143616, 4675071901696, 9346922577920, 1103806595072, 2207613190144, 4398046511104, 8796093022208]

private theorem conjugate_tail :
    matrix10 * Binary.inverseMatrix .r8 = decode 52 conjugateTailRows :=
  decode_mul 52 rows10 (Binary.inverseRows .r8) conjugateTailRows (by decide +kernel)

private theorem conjugate_product :
    Binary.generatorMatrix .r8 * decode 52 conjugateTailRows = matrix38 :=
  decode_mul 52 (Binary.generatorRows .r8) conjugateTailRows rows38 (by decide +kernel)

/-- The single extra relation involving the full Sylow generator outside Tits. -/
theorem reflection_rootOne :
    Binary.assignment .r8 * rootOne * (Binary.assignment .r8)⁻¹ =
      Binary.assignment .s7 * rootOne := by
  apply Units.ext
  simp only [Units.val_mul, Binary.assignment_val, Binary.assignment_inv_val,
    rootOne_val, mul_assoc]
  rw [conjugate_tail, conjugate_product, product16]

end Tits.AmalgamRigidity.FullRee.SecondExtension.WeylVerification.BinaryCheck
