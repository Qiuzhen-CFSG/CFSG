module
public import Theory.SpecificGroups.ReeTwo.ParabolicMarkedComparison.Verified
public import Theory.SpecificGroups.Tits.RelativeParabolicNormalizers.SecondCenter
public import Theory.GroupTheory.CentralInvolutionMarking

/-!
# No central involution at the binary Ree and Tits cubic vertices

The specified Sylow omega-center is generated by Parrott's r5 in both
models. The cubic reflection moves r5, as the existing permutation
certificate shows. Every local central involution would generate that
same omega-center, giving a contradiction. The full Ree calculation uses
the fixed Atlas embedding and the verified root marking.

These intrinsic endpoint facts are used in the centered H-star branch of
Aschbacher--Smith 15.2.8, printed pp.1109--1110. The concrete models and
root conventions are those of F.1.12, pp.262--264, and Parrott (1972), p.683.
No recognition of an arbitrary amalgam is asserted.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
namespace Tits.ExceptionalParabolics

private theorem val_mul (a b : Atlas1600Group) : (a * b).val = a.val * b.val := rfl
private theorem val_pow (a : Atlas1600Group) (n : ℕ) : (a ^ n).val = a.val ^ n := rfl

private theorem no_central_involution_of_moving
    {G : Type*} [Group G] [Finite G]
    (T : Sylow 2 G) (H : Subgroup G) (hTH : (T : Subgroup G) ≤ H)
    (hc : Nat.card (omegaOneCenterAmbient (T : Subgroup G)) = 2)
    (z a : G) (hz : z ∈ omegaOneCenterAmbient (T : Subgroup G))
    (ha : a ∈ H) (hm : a * z * a⁻¹ ≠ z) :
    ¬ ∃ t : H, t ∈ center H ∧ orderOf t = 2 := by
  rintro ⟨t,ht,ho⟩
  have he := central_involution_marking T H hTH hc t ht ho
  have htC : (t : G) ∈ centralizer (H : Set G) := by
    intro x hx
    exact congrArg H.subtype (mem_center_iff.mp ht ⟨x,hx⟩)
  have hzC : z ∈ centralizer (H : Set G) :=
    (zpowers_le.mpr htC) (he.symm ▸ hz)
  apply hm
  rw [hzC a ha,mul_inv_cancel_right]

private theorem r5_order : orderOf atlas1600R5 = 2 := by
  apply orderOf_eq_prime _ atlas1600R5_ne_one
  apply FullRee.atlasEmbedding_injective
  rw [map_pow,map_one,ReeTwo.ParabolicMarkedComparison.Verified.atlas_last_root]
  exact ReeTwo.ParabolicMarkedComparison.last_root_square
    ReeTwo.ParabolicMarkedComparison.RootVerification.relations

private theorem reflection_moves_r5 :
    atlas1600ParrottAssignment .r8 * atlas1600R5 *
      (atlas1600ParrottAssignment .r8)⁻¹ ≠ atlas1600R5 := by
  intro he
  have hv := congrArg (fun x : Atlas1600Group => x.val 0) he
  change ((atlas1600ParrottAssignment .r8).val * atlas1600R5.val *
    (atlas1600ParrottAssignment .r8).val⁻¹) 0 = atlas1600R5.val 0 at hv
  have hr : atlas1600R5.val = RelativeParabolicNormalizers.SecondCenterCertificate.x := by
    simp only [atlas1600R5_eq, val_mul, val_pow,
      atlas1600ParrottAssignment_val, Atlas1600ParrottData.permutation,
      RelativeParabolicNormalizers.SecondCenterCertificate.x]
  rw [hr,atlas1600ParrottAssignment_val] at hv
  change (Atlas1600ParrottData.r8Perm * RelativeParabolicNormalizers.SecondCenterCertificate.x *
    Atlas1600ParrottData.r8Perm⁻¹) 0 = RelativeParabolicNormalizers.SecondCenterCertificate.x 0 at hv
  rw [RelativeParabolicNormalizers.SecondCenterCertificate.reflection_x] at hv
  exact (by decide : RelativeParabolicNormalizers.SecondCenterCertificate.y 0 ≠
    RelativeParabolicNormalizers.SecondCenterCertificate.x 0) hv

private theorem omega_center_eq : omegaOneCenterAmbient S = zpowers atlas1600R5 := by
  change ((omega₁ (center S) (p := 2)).map (center S).subtype).map S.subtype = _
  rw [map_map]
  exact ReeTwo.ParabolicMarkedComparison.Verified.tits_sylow_omega_center

/-- The cubic Tits parabolic has no central involution. -/
theorem second_no_central_involution :
    ¬ ∃ z : second, z ∈ center second ∧ orderOf z = 2 := by
  apply no_central_involution_of_moving atlas1600SylowTwo second
    (atlas1600SylowTwo_coe ▸ sylow_le_second)
    (by rw [atlas1600SylowTwo_coe,omega_center_eq,Nat.card_zpowers,r5_order])
    atlas1600R5 (atlas1600ParrottAssignment .r8)
  · rw [atlas1600SylowTwo_coe,omega_center_eq]
    exact mem_zpowers _
  · exact reflection_mem_second
  · exact reflection_moves_r5

private theorem full_omega_center_eq :
    omegaOneCenterAmbient FullRee.S = zpowers (FullRee.atlasEmbedding atlas1600R5) := by
  change ((omega₁ (center FullRee.S) (p := 2)).map (center FullRee.S).subtype).map FullRee.S.subtype = _
  rw [map_map,ReeTwo.ParabolicMarkedComparison.Verified.atlas_last_root]
  exact ReeTwo.ParabolicMarkedComparison.Verified.sylow_omega_center

/-- The same marked reflection excludes a central involution in the full
binary Ree cubic parabolic. -/
theorem FullRee.second_no_central_involution :
    ¬ ∃ z : FullRee.second, z ∈ center FullRee.second ∧ orderOf z = 2 := by
  have ho : orderOf (FullRee.atlasEmbedding atlas1600R5) = 2 :=
    (orderOf_injective FullRee.atlasEmbedding FullRee.atlasEmbedding_injective _).trans r5_order
  apply no_central_involution_of_moving FullRee.sylow FullRee.second
    (FullRee.sylow_coe ▸ FullRee.sylow_le_second)
    (by rw [FullRee.sylow_coe,full_omega_center_eq,Nat.card_zpowers,ho])
    (FullRee.atlasEmbedding atlas1600R5)
    (FullRee.atlasEmbedding (atlas1600ParrottAssignment .r8))
  · rw [FullRee.sylow_coe,full_omega_center_eq]
    exact mem_zpowers _
  · exact FullRee.atlas_second_map_le (mem_map_of_mem _ reflection_mem_second)
  · intro he
    apply reflection_moves_r5
    apply FullRee.atlasEmbedding_injective
    simpa only [map_mul,map_inv] using he

end Tits.ExceptionalParabolics
