/-- The q-action keeps the exact earlier root marking. -/
theorem q_conjugates_root (i:Fin 7) :
    q*atlasEmbedding (root i)*q⁻¹=atlasEmbedding (actionWord i) := by
  apply mul_inv_eq_of_eq_mul
  obtain ⟨e,h⟩ := exists_simpleMatrixComparison
  fin_cases i
  · change q*atlasEmbedding (Atlas.a .s1)=atlasEmbedding (Atlas.a .s1)*q
    apply toSplitGroup_injective 0
    apply Subtype.ext
    apply renumber_injective e
    simpa only [map_mul,Subgroup.coe_mul,q_compare e h,root_compare e h] using
      congrArg extendScalars binary_0
  · change q*atlasEmbedding (Atlas.a .s2)=atlasEmbedding (Atlas.a .s2)*q
    apply toSplitGroup_injective 0
    apply Subtype.ext
    apply renumber_injective e
    simpa only [map_mul,Subgroup.coe_mul,q_compare e h,root_compare e h] using
      congrArg extendScalars binary_1
  · change q*atlasEmbedding (Atlas.a .s3)=atlasEmbedding (Atlas.a .s2*Atlas.a .s3)*q
    apply toSplitGroup_injective 0
    apply Subtype.ext
    apply renumber_injective e
    simpa only [map_mul,Subgroup.coe_mul,q_compare e h,root_compare e h] using
      congrArg extendScalars binary_2
  · change q*atlasEmbedding (Atlas.a .s4)=atlasEmbedding (Atlas.a .s1*Atlas.a .s2*Atlas.a .s3*Atlas.a .s3*Atlas.a .s4)*q
    apply toSplitGroup_injective 0
    apply Subtype.ext
    apply renumber_injective e
    simpa only [map_mul,Subgroup.coe_mul,q_compare e h,root_compare e h] using
      congrArg extendScalars binary_3
  · change q*atlasEmbedding (Atlas.a .s5)=atlasEmbedding (Atlas.a .s5)*q
