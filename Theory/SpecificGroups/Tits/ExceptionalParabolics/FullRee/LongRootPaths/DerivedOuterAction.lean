/-!
# The outer root on the seven positive radical generators

Seven small binary matrix products retain conjugation by the actual outer
root q, in the original faithful Parrott marking. Intermediate rows are
checked by the kernel and transported through the fixed simple-root comparison.
Source: the root calculation in J.4.7, printed p.444.
-/

@[expose] public section
noncomputable section
namespace Tits.ExceptionalParabolics.FullRee.LongRootPaths.DerivedOuterAction
open ReeF4 ReeF4.DerivedTits.Realization
open InvolutionRootGeometry.BinaryDerivedFusion RootRelations
open TransportComparison Thompson.BinaryMatrix

/-- The seven positive derived roots of the linear radical. -/
def root (i:Fin 7) : Atlas1600Group := ![Atlas.a .s1,Atlas.a .s2,Atlas.a .s3,
  Atlas.a .s4,Atlas.a .s5,Atlas.a .s6,Atlas.a .s7] i

/-- Their literal q-conjugates. -/
def actionWord (i:Fin 7) : Atlas1600Group :=
  ![Atlas.a .s1,
    Atlas.a .s2,
    Atlas.a .s2*Atlas.a .s3,
    Atlas.a .s1*Atlas.a .s2*Atlas.a .s3*Atlas.a .s3*Atlas.a .s4,
    Atlas.a .s5,
    Atlas.a .s1*Atlas.a .s4*Atlas.a .s5*Atlas.a .s5*Atlas.a .s6,
    Atlas.a .s1*Atlas.a .s3*Atlas.a .s3*Atlas.a .s3*Atlas.a .s4*Atlas.a .s5*Atlas.a .s5*Atlas.a .s5*Atlas.a .s7] i

