private theorem root_compare (e:Theory.AlgebraicGroup.F4Chevalley.BasisIndex≃Fin 52)
    (h:SimpleMatrixComparison e) (i:ParrottGenerator) :
    renumber e (toSplitGroup 0 (atlasEmbedding (Atlas.a i))).val=
      extendScalars (Products.generator i) := by
  rw [Atlas.a,atlasEmbedding_generator_matrix]
  exact compare_generator e h i

