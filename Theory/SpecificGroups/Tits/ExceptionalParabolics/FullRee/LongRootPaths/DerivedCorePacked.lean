/-!
# Checked packed maps for the six collected derived-core words

Caching these six finite point maps avoids repeatedly expanding nested root
words in later small certificates. Every map is first compared on all 1600
points with its original faithful Atlas word. No multiplication table or
mathematical assertion is supplied by the generator script.
-/

@[expose] public section
namespace Tits.ExceptionalParabolics.FullRee.LongRootPaths.DerivedCorePacked
open OuterOddSubgroups.OverlapCentralizers

def data0:Nat := 

def data1:Nat := 

def data2:Nat := 

def data3:Nat := 

def data4:Nat := 

def data5:Nat := 

def point (i:Fin 6) (k:Fin 1600) : Fin 1600 :=
  ⟨((![data0,data1,data2,data3,data4,data5] i >>> (11*k.val))%2048)%1600,
    Nat.mod_lt _ (by decide)⟩

def original (i:Fin 6) : Equiv.Perm (Fin 1600) :=
  ![Packed.perm 2*Packed.perm 3*(Packed.perm 4)^2,Packed.perm 5,
    Packed.perm 2*(Packed.perm 6)^2,Packed.perm 3,Packed.perm 7,
    (Packed.perm 4)^3*Packed.perm 6] i

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
theorem point_eq (i:Fin 6) (k:Fin 1600) : point i k=original i k := by
  revert i k
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

/-- The original six word actions with a certified packed forward map. -/
def packedGen (i:Fin 6) : Equiv.Perm (Fin 1600) where
  toFun:=point i
  invFun:=(original i).symm
  left_inv k:=by rw [point_eq]; exact (original i).left_inv k
  right_inv k:=by rw [point_eq]; exact (original i).right_inv k

theorem packedGen_eq (i:Fin 6) : packedGen i=original i := Equiv.ext (point_eq i)

end Tits.ExceptionalParabolics.FullRee.LongRootPaths.DerivedCorePacked
