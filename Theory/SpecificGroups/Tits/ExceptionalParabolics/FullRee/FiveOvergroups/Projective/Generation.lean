module

public import Theory.SpecificGroups.PSL2.PrimeQuadraticMaximal

/-! In PSL₂ over a field of order25, divisibility by4 and13 excludes every proper Dickson alternative. This identifies the group generated by the concrete matrix images. -/

public section
open Subgroup BenderSuzuki.MatrixGroups
namespace Tits.Max4Projective
private instance : Fact (Nat.Prime 5) := ⟨by decide⟩
theorem psl25_card {F : Type*} [Field F] [Finite F] (hF : Nat.card F=25) :
    Nat.card (PSL2MatrixGroup F)=7800 := by
  have ho : Odd (Nat.card F) := by rw [hF];decide
  have h := Matrix.ProjectiveSpecialLinearGroup.psl2_card_twice (F:=F) ho
  rw [hF] at h
  exact Nat.eq_of_mul_eq_mul_right (by decide : 0<2) (by
    simpa only [Nat.reducePow,Nat.reduceSub,Nat.reduceMul] using h)

theorem psl25_eq_top_of_divisors {F : Type*} [Field F] [Finite F] (hF : Nat.card F=25)
    (H : Subgroup (PSL2MatrixGroup F)) (h4 : 4 ∣ Nat.card H) (h13 : 13 ∣ Nat.card H) : H=⊤ := by
  have hF' : Nat.card F=5^2 := hF
  rcases Glauberman.Dickson.huppert_II_8_27_dickson_psl2_subgroup_classification hF' H with
    hE|hC|hD|hA4|hS4|hA5|hB|hPSL|hPGL
  · let : IsElementaryAbelian 5 H := hE
    obtain ⟨m,hm⟩ := (IsElementaryAbelian.isPGroup 5 H).exists_card_eq
    rw [hm] at h13
    have hh := (by decide : Nat.Coprime 13 5).pow_right m
    exact (by have := hh.eq_one_of_dvd h13; omega)
  · obtain ⟨z,hz,hc,_⟩ := hC
    rw [hF] at hz
    norm_num at hz
    rw [hc] at h4 h13
    rcases hz with hz|hz
    · have := h13.trans hz; norm_num at this
    · have := h4.trans hz; norm_num at this
  · obtain ⟨z,hz,hc,_⟩ := hD
    rw [hF] at hz
    norm_num at hz
    rcases hz with hz|hz
    · have hh : Nat.card H ∣ 24 := by rw [hc];exact Nat.mul_dvd_mul_left 2 hz
      have := h13.trans hh; norm_num at this
    · have hh : Nat.card H ∣ 26 := by rw [hc];exact Nat.mul_dvd_mul_left 2 hz
      have := h4.trans hh; norm_num at this
  · obtain ⟨_,⟨f⟩⟩ := hA4
    have hc := Nat.card_congr f.toEquiv
    rw [nat_card_alternatingGroup,Nat.card_fin] at hc
    norm_num at hc
    rw [hc] at h13
    norm_num at h13
  · obtain ⟨_,⟨f⟩⟩ := hS4
    have hc := Nat.card_congr f.toEquiv
    rw [Nat.card_perm,Nat.card_fin] at hc
    norm_num at hc
    rw [hc] at h13
    norm_num at h13
  · obtain ⟨_,⟨f⟩⟩ := hA5
    have hc := Nat.card_congr f.toEquiv
    rw [nat_card_alternatingGroup,Nat.card_fin] at hc
    norm_num at hc
    rw [hc] at h13
    norm_num at h13
  · obtain ⟨m,t,_,ht,N,C,hN,_,hcN,_,hcC,hdisj,hsup⟩ := hB
    let : N.Normal := hN
    have hc : Nat.card H=5^m*t := by
      have hh := card_sup_eq_mul_of_normalizes_of_disjoint N C
        (by rw [N.normalizer_eq_top];exact le_top) hdisj
      simpa [hsup,hcN,hcC] using hh
    rw [hc] at h13
    have hd := ((by decide : Nat.Coprime 13 5).pow_right m).dvd_of_dvd_mul_left h13
    norm_num at ht
    have := hd.trans ht; norm_num at this
  · obtain ⟨m,hm0,hmd,⟨f⟩⟩ := hPSL
    have hm := (Nat.dvd_prime Nat.prime_two).mp hmd
    rcases hm with hm|hm
    · subst m
      have hc := Matrix.ProjectiveSpecialLinearGroup.psl2_card_twice
        (F:=GaloisField 5 1) (by rw [GaloisField.card 5 1 (by decide)];decide)
      rw [GaloisField.card 5 1 (by decide),← Nat.card_congr f.toEquiv] at hc
      norm_num at hc
      have h60 : Nat.card H=60 := by omega
      rw [h60] at h13;norm_num at h13
    · subst m
      apply eq_top_of_card_eq
      rw [Nat.card_congr f.toEquiv,psl25_card (GaloisField.card 5 2 (by decide)),psl25_card hF]
  · obtain ⟨m,hm0,hmd,⟨f⟩⟩ := hPGL
    have hm : m=1 := by
      have hh := Nat.le_of_dvd (by decide : 0<2) hmd
      omega
    subst m
    have hc := GorensteinWalter.pgl2_card_formula (GaloisField 5 1)
    rw [GaloisField.card 5 1 (by decide),← Nat.card_congr f.toEquiv] at hc
    norm_num at hc
    rw [hc] at h13;norm_num at h13
end Tits.Max4Projective
