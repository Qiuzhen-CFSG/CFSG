module

public import Theory.SpecificGroups.Tits.ExceptionalParabolics.FullRee.FiveOvergroups.Projective.Paired
public import Theory.SpecificGroups.Tits.ExceptionalParabolics.FullRee.FiveOvergroups.Projective.Generators
public import Theory.SpecificGroups.Tits.ExceptionalParabolics.FullRee.FiveOvergroups.Projective.Source

/-!
# The literal ATLAS max4 subgroup is PSL₂(25)

A kernel-checked paired Schreier cover bounds the subgroup generated by the
native permutation and matrix pairs by7800. The projective matrix projection
is onto PSL₂(F25), since the explicit generators have orders4 and13. Equal
orders make this projection an equivalence. Simplicity of PSL₂ makes the
nontrivial native projection injective, and its image is exactly the original
max4 subgroup. Thus both original SLP generators receive specified matrices.

No universal presentation or unproved subgroup identification is used. GAP
supplies only raw determinant-one witnesses; all transitions and generation
conditions are checked independently by Lean. The coefficient field is the
actual quadratic algebra F₅[z]/(z²-z-3), with cardinal25.
Source: original ATLAS max4 SLP; Aschbacher–Smith J.5.4, pp.445–446.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
noncomputable section
namespace Tits.Max4Projective
open MinimumIndexCandidates OrderCertificate.Max4

private theorem word_eq_closure {H:Type*}[Group H]{n:Nat}(g:Fin n→H)(v:Fin n→Fin n)
    (hv : ∀ i, g (v i) = (g i)⁻¹) : wordSubgroup g v hv=closure (Set.range g) := by
  apply le_antisymm
  · rintro x ⟨w,rfl⟩
    induction w with
    | nil => exact one_mem _
    | cons i w ih => exact (Subgroup.closure _).mul_mem (subset_closure ⟨i,rfl⟩) ih
  · apply (closure_le _).mpr
    rintro x ⟨i,rfl⟩
    exact ⟨[i],mul_one _⟩

def targetProjection : paired0 →* PSL :=
  (MonoidHom.snd (Equiv.Perm (Fin 1600)) PSL).comp paired0.subtype

def sourceProjection : paired0 →* Equiv.Perm (Fin 1600) :=
  (MonoidHom.fst (Equiv.Perm (Fin 1600)) PSL).comp paired0.subtype

def pairGen (i:Fin 4) : paired0 := ⟨(L0Gen i,target0Gen i),⟨[i],mul_one _⟩⟩

theorem targetProjection_surjective : Function.Surjective targetProjection := by
  rw [← MonoidHom.range_eq_top]
  apply top_unique
  rw [← target_range_top]
  apply (closure_le _).mpr
  rintro x ⟨i,rfl⟩
  exact ⟨pairGen i,rfl⟩

def pairedEquiv : paired0 ≃* PSL := MulEquiv.ofBijective targetProjection
  (targetProjection_surjective.bijective_of_nat_card_le (by
    rw [projective_card];exact paired_card_bound))

theorem sourceProjection_injective : Function.Injective sourceProjection := by
  let : IsSimpleGroup paired0 := pairedEquiv.isSimpleGroup
  rcases (inferInstance : sourceProjection.ker.Normal).eq_bot_or_eq_top with hb|ht
  · exact (MonoidHom.ker_eq_bot_iff _).mp hb
  · have h : pairGen 0∈sourceProjection.ker := by rw [ht];exact mem_top _
    exact (packed0_ne_one h).elim

theorem sourceProjection_range : sourceProjection.range=max4.map sourceEmbedding := by
  have hs : Set.range L0Gen=sourceEmbedding '' Set.range sourceGen := by
    ext x
    constructor
    · rintro ⟨i,rfl⟩; exact ⟨sourceGen i,⟨i,rfl⟩,(sourceGen_spec i).symm⟩
    · rintro ⟨y,⟨i,rfl⟩,rfl⟩;exact ⟨i,sourceGen_spec i⟩
  rw [sourceProjection,MonoidHom.range_comp,paired0.range_subtype,
    paired0,word_eq_closure,MonoidHom.map_closure]
  have he : (MonoidHom.fst (Equiv.Perm (Fin 1600)) PSL) ''
      Set.range (fun i => (L0Gen i,target0Gen i)) = Set.range L0Gen := by
    ext x
    simp only [Set.mem_image,Set.mem_range]
    constructor
    · rintro ⟨_,⟨i,rfl⟩,rfl⟩;exact ⟨i,rfl⟩
    · rintro ⟨i,rfl⟩; exact ⟨_,⟨i,rfl⟩,rfl⟩
  rw [he,hs,← MonoidHom.map_closure,sourceGen_closure]

def nativeEquiv : max4 ≃* PSL :=
  (equivMapOfInjective max4 sourceEmbedding sourceEmbedding_injective).trans
    ((MulEquiv.subgroupCongr sourceProjection_range.symm).trans
      ((MonoidHom.ofInjective sourceProjection_injective).symm.trans pairedEquiv))

theorem nativeEquiv_generator (i:Fin 4) : nativeEquiv ⟨sourceGen i,sourceGen_mem i⟩=target0Gen i := by
  let e := (equivMapOfInjective max4 sourceEmbedding sourceEmbedding_injective).trans
    (MulEquiv.subgroupCongr sourceProjection_range.symm)
  have he : e ⟨sourceGen i,sourceGen_mem i⟩ =
      MonoidHom.ofInjective sourceProjection_injective (pairGen i) := by
    apply Subtype.ext
    exact (sourceGen_spec i).symm
  change pairedEquiv ((MonoidHom.ofInjective sourceProjection_injective).symm
    (e ⟨sourceGen i,sourceGen_mem i⟩))=target0Gen i
  rw [he,MulEquiv.symm_apply_apply]
  rfl

theorem max4_card : Nat.card max4=7800 :=
  (Nat.card_congr nativeEquiv.toEquiv).trans projective_card
theorem nativeEquiv_first : nativeEquiv ⟨max4Generators.1,sourceGen_mem 0⟩=pi a :=
  nativeEquiv_generator 0

theorem nativeEquiv_second : nativeEquiv ⟨max4Generators.2,sourceGen_mem 1⟩=pi b :=
  nativeEquiv_generator 1

theorem a_matrix : (a:Matrix (Fin 2) (Fin 2) F) =
    !![⟨2,2⟩,⟨1,3⟩;⟨0,2⟩,⟨3,3⟩] := rfl

theorem b_matrix : (b:Matrix (Fin 2) (Fin 2) F) =
    !![⟨1,3⟩,⟨4,2⟩;⟨0,0⟩,⟨2,1⟩] := rfl

instance max4_simple : IsSimpleGroup max4 := nativeEquiv.isSimpleGroup
end Tits.Max4Projective
