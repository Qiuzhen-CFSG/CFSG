/-!
# Finite generator-image sieve for the actual second Tits core

The checked normal-form indices and short words restrict the images of the
two core generators. This certificate is consumed by `AutomorphismExhaustion`;
its assertions use the actual Atlas1600 permutations and the five certified
normal-form automorphisms, not untrusted enumeration results.

Source and marking: Parrott (1972), §5, p.683; see `CoreGenerators`.
-/

@[expose] public section
namespace Tits.ExceptionalParabolics.SecondCoreAction.SecondImageCertificate
open CoreAutomorphismCertificate
open AmalgamRigidity.SecondExtension
def indexData : Nat := 2278981636482907565685010487700144680389889589090803610615057651983689241254063757658941113449204012420127529415217196505888601325593770490676146431886243380029032736624752923834558234454395136
def indices (j : Fin 64) : Fin 1024 := ⟨(indexData >>> (10*j.val)) % 1024, Nat.mod_lt _ (by decide)⟩
def decodeData : Nat := 
def decode (n : Fin 1024) : Fin 64 := ⟨(decodeData >>> (6*n.val)) % 64, Nat.mod_lt _ (by decide)⟩
def wordData : Nat := 
def letter (j : Fin 64) (k : Fin 12) : Fin 6 :=
  ⟨((wordData >>> (36*j.val+3*k.val))%8)%6, Nat.mod_lt _ (by decide)⟩
def step (g : Fin 6) (n : Fin 1024) : Fin 1024 :=
  if h : g.val < 5 then image ⟨g.val,h⟩ n else n
def evaluate (j : Fin 64) (n : Fin 1024) : Fin 1024 :=
  (List.finRange 12).foldl (fun x k => step (letter j k) x) n
set_option maxRecDepth 10000 in
theorem second_candidates : ∀ n : Fin 1024,
    (n.val/256)%2=0 ∨ (form n ^ 4) 0 ≠ 0 ∨
    ((packedGen 3 * form n)^4) 0 ≠ 0 ∨
    (packedGen 3 * CoreGenerators.generatorWord (packedGen 3) (form n) 0) 0 ≠
      (CoreGenerators.generatorWord (packedGen 3) (form n) 0 * packedGen 3) 0 ∨
    indices (decode n) = n := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel
set_option maxRecDepth 10000 in
theorem word_images : ∀ j : Fin 64,
    evaluate j 4 = 4 ∧ evaluate j 256 = indices j := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel
end Tits.ExceptionalParabolics.SecondCoreAction.SecondImageCertificate
