module
public import Theory.SpecificGroups.Tits.ExceptionalParabolics.SecondCoreActionCensus.CoreGenerators
/-!
# Finite tables for actual core automorphisms
The tables are untrusted normal-form permutations found in the actual Tits
core. The kernel verifies the two original right transitions, bijectivity,
and preservation of both transitions for each of five candidate assignments.
Only the already separating points 0 and 930 are needed for group equalities.
`CoreAutomorphisms.ofTransitions` turns these certificates into automorphisms.
No quotient identification or automorphism exhaustion is asserted here.
Source and marking: Parrott (1972), §5, p.683; see `CoreGenerators`.
-/
@[expose] public section
namespace Tits.ExceptionalParabolics.SecondCoreAction.CoreAutomorphismCertificate
open AmalgamRigidity.SecondExtension
def lookup (data : Nat) (n : Fin 1024) : Fin 1024 :=
  ⟨(data >>> (10*n.val)) % 1024, Nat.mod_lt _ (by decide)⟩
def nextData0 : Nat := 
def nextData1 : Nat := 
def mapData0 : Nat := 
def invData0 : Nat := 
def mapData1 : Nat := 
def invData1 : Nat := 
def mapData2 : Nat := 
def invData2 : Nat := 
def mapData3 : Nat := 
def invData3 : Nat := 
def mapData4 : Nat := 
def invData4 : Nat := 
def next (n : Fin 1024) (i : Fin 2) : Fin 1024 := lookup (![nextData0,nextData1] i) n
def image (a : Fin 5) (n : Fin 1024) : Fin 1024 := lookup (![mapData0,mapData1,mapData2,mapData3,mapData4] a) n
def inverse (a : Fin 5) (n : Fin 1024) : Fin 1024 := lookup (![invData0,invData1,invData2,invData3,invData4] a) n
def form (n : Fin 1024) : Equiv.Perm (Fin 1600) := word packedGen ⟨n.val, by omega⟩
set_option maxRecDepth 10000 in
theorem transitions : ∀ (n : Fin 1024) (i : Fin 2),
  form (next n i) 0 = (form n * ![packedGen 3,packedGen 7] i) 0 ∧
  form (next n i) 930 = (form n * ![packedGen 3,packedGen 7] i) 930 := by
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel
set_option maxRecDepth 10000 in
theorem image_transitions (a : Fin 5) : ∀ (n : Fin 1024) (i : Fin 2),
  form (image a (next n i)) 0 =
    (form (image a n) * form (image a (![4,256] i))) 0 ∧
  form (image a (next n i)) 930 =
    (form (image a n) * form (image a (![4,256] i))) 930 := by
  fin_cases a <;> apply Atlas1600OrderCertificate.allFin₂ <;> decide +kernel
set_option maxRecDepth 10000 in
theorem image_left_inverse : ∀ (a : Fin 5) (n : Fin 1024),
    inverse a (image a n) = n := by
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel
theorem image_zero : ∀ a : Fin 5, image a 0 = 0 := by decide +kernel
def generatorImages : Fin 5 → Fin 1024 × Fin 1024 :=
  ![(161,404),(262,840),(161,415),(69,449),(69,272)]
theorem generatorImages_eq : ∀ a : Fin 5,
    image a 4 = (generatorImages a).1 ∧ image a 256 = (generatorImages a).2 := by
  decide +kernel
end Tits.ExceptionalParabolics.SecondCoreAction.CoreAutomorphismCertificate
