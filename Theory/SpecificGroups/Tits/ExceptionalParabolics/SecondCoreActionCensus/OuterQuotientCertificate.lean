module
public import Theory.SpecificGroups.Tits.ExceptionalParabolics.SecondCoreActionCensus.OuterGenerators
public import Theory.SpecificGroups.Tits.ExceptionalParabolics.SecondCoreActionCensus.OuterModel

/-!
# Checked transitions for the marked outer quotient

Ninety-six short words in the five actual core automorphisms represent the
proposed outer classes. Each left-generator transition differs from the
specified next representative by conjugation by a concrete core element.
Only the two generating images and their separating permutation points are
checked. `OuterQuotient` supplies the group-theoretic construction.

Source and marking: Parrott (1972), §5, p.683; `CoreGenerators`.
-/

@[expose] public section
namespace Tits.ExceptionalParabolics.SecondCoreAction.OuterQuotientCertificate
open CoreAutomorphismCertificate
open AmalgamRigidity.SecondExtension


def wordData : Nat := 

def letter (j : Fin 96) (k : Fin 12) : Fin 6 :=
  ⟨((wordData >>> (36*j.val+3*k.val))%8)%6, Nat.mod_lt _ (by decide)⟩
def word (j : Fin 96) : List (Fin 6) := (List.finRange 12).map (letter j)
def step (g : Fin 6) (n : Fin 1024) : Fin 1024 :=
  if h : g.val < 5 then image ⟨g.val,h⟩ n else n
def evaluate (j : Fin 96) (n : Fin 1024) : Fin 1024 :=
  (word j).foldl (fun x k => step k x) n
def labelGenerator : Fin 5 → OuterModel :=
  ![(1,Equiv.swap 0 1),(1,Equiv.swap 1 2),(1,Equiv.swap 2 3),
    (Multiplicative.ofAdd (1,0),1),(Multiplicative.ofAdd (0,1),1)]
def labelLetter (g : Fin 6) : OuterModel :=
  if h : g.val < 5 then labelGenerator ⟨g.val,h⟩ else 1
def label (j : Fin 96) : OuterModel :=
  (word j).foldl (fun x k => labelLetter k * x) 1

def indexData : Nat := 

def index (x : OuterModel) : Fin 96 :=
  ⟨((indexData >>> (7*(x.1.toAdd.1.val+2*x.1.toAdd.2.val +
    4*(x.2 0).val+16*(x.2 1).val+64*(x.2 2).val+256*(x.2 3).val))) % 128)%96,
    Nat.mod_lt _ (by decide)⟩

def nextData : Nat := 

def next (j : Fin 96) (a : Fin 5) : Fin 96 :=
  ⟨((nextData >>> (7*(5*j.val+a.val)))%128)%96, Nat.mod_lt _ (by decide)⟩

def correctionData : Nat := 

def correction (j : Fin 96) (a : Fin 5) : Fin 1024 :=
  ⟨(correctionData >>> (10*(5*j.val+a.val)))%1024, Nat.mod_lt _ (by decide)⟩
set_option maxRecDepth 10000 in
theorem index_label : ∀ j : Fin 96, index (label j) = j := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel
set_option maxRecDepth 10000 in
theorem label_index : ∀ x : OuterModel, label (index x) = x := by
  decide +kernel
set_option maxRecDepth 10000 in
theorem label_next : ∀ (j : Fin 96) (a : Fin 5),
    label (next j a) = labelGenerator a * label j := by
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel
set_option maxRecDepth 10000 in
theorem transitions : ∀ (j : Fin 96) (a : Fin 5) (i : Fin 2),
    let n : Fin 1024 := ![4,256] i
    form (image a (evaluate j n)) 0 =
      (form (correction j a) * form (evaluate (next j a) n) * (form (correction j a))⁻¹) 0 ∧
    form (image a (evaluate j n)) 930 =
      (form (correction j a) * form (evaluate (next j a) n) * (form (correction j a))⁻¹) 930 := by
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel
end Tits.ExceptionalParabolics.SecondCoreAction.OuterQuotientCertificate
