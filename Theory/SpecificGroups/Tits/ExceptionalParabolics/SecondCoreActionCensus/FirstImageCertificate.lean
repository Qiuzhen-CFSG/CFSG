module
public import Theory.SpecificGroups.Tits.ExceptionalParabolics.SecondCoreActionCensus.CoreAutomorphismCertificate
public import Theory.SpecificGroups.Tits.ExceptionalParabolics.SecondCoreActionCensus.FrattiniReduction

/-!
# Finite generator-image sieve for the actual second Tits core

The checked normal-form indices and short words restrict the images of the
two core generators. This certificate is consumed by `AutomorphismExhaustion`;
its assertions use the actual Atlas1600 permutations and the five certified
normal-form automorphisms, not untrusted enumeration results.

Source and marking: Parrott (1972), §5, p.683; see `CoreGenerators`.
-/

@[expose] public section
namespace Tits.ExceptionalParabolics.SecondCoreAction.FirstImageCertificate
open CoreAutomorphismCertificate
def indexData : Nat := 
def indices (j : Fin 384) : Fin 1024 := ⟨(indexData >>> (10*j.val)) % 1024, Nat.mod_lt _ (by decide)⟩
def decodeData : Nat := 
def decode (n : Fin 1024) : Fin 384 := ⟨((decodeData >>> (9*n.val)) % 512)%384, Nat.mod_lt _ (by decide)⟩
def wordData : Nat := 
def letter (j : Fin 384) (k : Fin 12) : Fin 6 :=
  ⟨((wordData >>> (36*j.val+3*k.val))%8)%6, Nat.mod_lt _ (by decide)⟩
def step (g : Fin 6) (n : Fin 1024) : Fin 1024 :=
  if h : g.val < 5 then image ⟨g.val,h⟩ n else n
def evaluate (j : Fin 384) (n : Fin 1024) : Fin 1024 :=
  (List.finRange 12).foldl (fun x k => step (letter j k) x) n
set_option maxRecDepth 10000 in
theorem first_candidates : ∀ n : Fin 1024,
    (form n ^ 4) 0 ≠ 0 ∨
    ((n.val/4+n.val/32)%2=0 ∧ (n.val/256)%2=0) ∨
    indices (decode n) = n := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel
set_option maxRecDepth 10000 in
theorem word_images : ∀ j : Fin 384, evaluate j 4 = indices j := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel
end Tits.ExceptionalParabolics.SecondCoreAction.FirstImageCertificate
