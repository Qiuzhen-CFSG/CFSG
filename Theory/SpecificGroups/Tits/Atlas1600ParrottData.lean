/-!
# Concrete Parrott permutation data

These inverse point maps, with zero-based labels, are candidate Parrott
generators found by a coset-action comparison in GAP. The kernel checks that
each table defines a permutation. Membership, the original presentation
relations, and generation are certified separately in Atlas1600ParrottCertificate.
The source presentation is Parrott (1972), p. 683; the Atlas input files and
scan-checked conventions are in `refs/original/n-group-global`.

Each balanced table is split into blocks of 64 entries, so kernel substitution
does not traverse all 1600 entries for every lookup. Bodies are exposed solely
for the computational certificates that consume these explicit permutations.
-/

namespace Tits.Atlas1600ParrottData

set_option maxRecDepth 20000

@[expose] public def checkNat (f : Nat → Bool) : Nat → Bool
  | 0 => true
  | n + 1 => checkNat f n && f n

private theorem checkNat_spec (f : Nat → Bool) (n : Nat) :
    checkNat f n = true ↔ ∀ i, i < n → f i = true := by
  induction n with
  | zero => simp [checkNat]
  | succ n ih =>
    rw [checkNat, Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h, h'⟩ i hi
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | rfl
      · exact h i hlt
      · exact h'
    · intro h
      exact ⟨fun i hi => h i (Nat.lt_succ_of_lt hi), h n (Nat.lt_succ_self n)⟩

public theorem allFin (P : Fin 1600 → Prop) [DecidablePred P]
    (h : checkNat (fun k => decide (P ⟨k % 1600, Nat.mod_lt _ (by decide)⟩)) 1600 = true) :
    ∀ i, P i := by
  rintro ⟨k, hk⟩
  have h' := (checkNat_spec _ _).mp h k hk
  have hp := of_decide_eq_true h'
  simpa only [Nat.mod_eq_of_lt hk] using hp

