module

public import Theory.SpecificGroups.Tits.Atlas1600SylowTwoCertificate
public import Theory.SpecificGroups.Tits.Atlas1600OrderData

/-!
# Packed point maps for the overlap-centralizer calculation

These are the existing Atlas1600 Parrott point maps encoded as 11-bit
entries. The equality with each original permutation is kernel checked
on every point. Packing avoids repeated evaluation of an argument in a
nested conditional table when evaluating long Sylow words.
Source: Parrott (1972), p.683, and `Atlas1600ParrottData`.
-/

@[expose] public section
namespace Tits.OuterOddSubgroups.OverlapCentralizers.Packed
open Atlas1600ParrottData

def r1Data : Nat := 

def r8Data : Nat := 

def s1Data : Nat := 

def s2Data : Nat := 

def s3Data : Nat := 

def s4Data : Nat := 

def s5Data : Nat := 

def s6Data : Nat := 

def s7Data : Nat := 

def s8Data : Nat := 

def pointMap (i : Fin 10) (p : Fin 1600) : Fin 1600 :=
  ⟨((![r1Data, r8Data, s1Data, s2Data, s3Data, s4Data, s5Data, s6Data, s7Data, s8Data] i
    >>> (11 * p.val)) % 2048) % 1600, Nat.mod_lt _ (by decide)⟩

def generator : Fin 10 → Equiv.Perm (Fin 1600) :=
  ![r1Perm, r8Perm, s1Perm, s2Perm, s3Perm, s4Perm, s5Perm, s6Perm, s7Perm, s8Perm]

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
theorem pointMap_eq (i : Fin 10) (p : Fin 1600) : pointMap i p = generator i p := by
  revert i p
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

/-- The original permutation, with a certified packed forward map. -/
def perm (i : Fin 10) : Equiv.Perm (Fin 1600) where
  toFun := pointMap i
  invFun := (generator i).symm
  left_inv p := by rw [pointMap_eq]; exact (generator i).left_inv p
  right_inv p := by rw [pointMap_eq]; exact (generator i).right_inv p

theorem perm_eq (i : Fin 10) : perm i = generator i := Equiv.ext (pointMap_eq i)

end Tits.OuterOddSubgroups.OverlapCentralizers.Packed
end
