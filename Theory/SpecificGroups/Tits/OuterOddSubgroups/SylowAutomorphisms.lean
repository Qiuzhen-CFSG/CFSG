module

public import Theory.SpecificGroups.Tits.RelativeParabolicNormalizers.SecondNormalizer.Characteristic
public import Theory.Frattini.PGroup
public import Theory.GroupTheory.PGroup.FrattiniAutomorphismKernel

/-!
# Automorphisms of the Tits Sylow two-subgroup

The actual certified subgroup generated by Parrott's eight `s` generators
has a two-group automorphism group. In its elementary abelian Frattini
quotient, six of the existing conjugation relations reduce the generator
images to `1`, `s3`, and `s8`. The normal-form enumeration therefore gives
four representatives: `1`, `s3`, `s8`, and `s3*s8`.

The centralizer of the intrinsic second center is characteristic, contains
`s3`, and excludes `s8`. Its image in the Frattini quotient is proper by
the nongenerating property of the Frattini subgroup. Consequently every
induced automorphism fixes the image of `s3` and either fixes the image of
`s8` or multiplies it by that of `s3`. Its square is the identity. The
Frattini automorphism kernel theorem now proves the asserted two-group
property, without computing the full automorphism group.

Source: Parrott (1972), p.683, transcribed in
`refs/original/n-group-global/parrott-tits-presentation.md`. This is the
Sylow automorphism input to the outer-group reduction used for
Aschbacher–Smith, printed p.510; compare GLS3, Theorem 2.5.15.
-/

open Subgroup
open scoped IsMulCommutative
namespace Tits.OuterOddSubgroups.SylowAutomorphisms
local notation "S" => atlas1600SylowTwoSubgroup
private def label : Fin 8 → ParrottGenerator :=
  ![.s1, .s2, .s3, .s4, .s5, .s6, .s7, .s8]

private def s (i : Fin 8) : S := ⟨atlas1600ParrottAssignment (label i), by
  rw [atlas1600SylowTwoSubgroup_eq]
  apply subset_closure
  fin_cases i <;> simp [label]⟩

private def perm : S →* Equiv.Perm (Fin 1600) :=
  { toFun := fun x => x.val.val
    map_one' := rfl
    map_mul' := fun _ _ => rfl }

private theorem perm_injective : Function.Injective perm := by
  intro x y h
  exact Subtype.ext (Subtype.ext h)

private theorem s_perm (i : Fin 8) :
    perm (s i) = Atlas1600SylowTwoCenterCertificate.generator i := by
  change (atlas1600ParrottAssignment (label i)).val = _
  fin_cases i <;> simp [label, atlas1600ParrottAssignment_val,
    Atlas1600ParrottData.permutation, Atlas1600SylowTwoCenterCertificate.generator]

private theorem rel_6_1 : s 5 * s 0 * (s 5)⁻¹ = s 1 * s 2 ^ 2 := by
  apply perm_injective
  simpa only [map_mul, map_inv, map_pow, s_perm,
    Atlas1600SylowTwoCenterCertificate.generator] using
    Atlas1600SylowTwoCertificate.conjugate_6_1

private theorem rel_5_3 : s 4 * s 2 * (s 4)⁻¹ = s 0 * s 2 ^ 3 * s 3 := by
  apply perm_injective
  simpa only [map_mul, map_inv, map_pow, s_perm,
    Atlas1600SylowTwoCenterCertificate.generator] using
    Atlas1600SylowTwoCertificate.conjugate_5_3

private theorem rel_7_1 : s 6 * s 0 * (s 6)⁻¹ = s 1 * s 3 * s 4 ^ 2 := by
  apply perm_injective
  simpa only [map_mul, map_inv, map_pow, s_perm,
    Atlas1600SylowTwoCenterCertificate.generator] using
    Atlas1600SylowTwoCertificate.conjugate_7_1

private theorem rel_7_3 : s 6 * s 2 * (s 6)⁻¹ = s 4 := by
  apply perm_injective
  simpa only [map_mul, map_inv, map_pow, s_perm,
    Atlas1600SylowTwoCenterCertificate.generator] using
    Atlas1600SylowTwoCertificate.conjugate_7_3

private theorem rel_7_5 : s 6 * s 4 * (s 6)⁻¹ = s 2 ^ 3 * s 4 ^ 2 * s 5 := by
  apply perm_injective
  simpa only [map_mul, map_inv, map_pow, s_perm,
    Atlas1600SylowTwoCenterCertificate.generator] using
    Atlas1600SylowTwoCertificate.conjugate_7_5

private theorem rel_8_3 : s 7 * s 2 * (s 7)⁻¹ = s 0 * s 2 ^ 3 * s 4 ^ 3 * s 6 ^ 3 := by
  apply perm_injective
  simpa only [map_mul, map_inv, map_pow, s_perm,
    Atlas1600SylowTwoCenterCertificate.generator] using
    Atlas1600SylowTwoCertificate.conjugate_8_3

private theorem two_group : IsPGroup 2 S :=
  IsPGroup.of_card (n := 11) (by simpa using atlas1600SylowTwoSubgroup_card)

local instance : Fact (IsPGroup 2 S) := ⟨two_group⟩
local notation "V" => S ⧸ frattini S
local instance : IsElementaryAbelian 2 V := isElementaryAbelian_quotient_frattini
local notation "q" => QuotientGroup.mk' (frattini S)

private theorem sq (v : V) : v ^ 2 = 1 :=
  Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
    (IsElementaryAbelian.exponent_dvd_p 2 V) v

private theorem cube (v : V) : v ^ 3 = v := by rw [pow_succ, sq, one_mul]

private theorem q_relations :
    q (s 0) = 1 ∧ q (s 1) = 1 ∧ q (s 3) = 1 ∧ q (s 5) = 1 ∧
      q (s 4) = q (s 2) ∧ q (s 6) = q (s 2) := by
  have h61 := congrArg q rel_6_1
  have h53 := congrArg q rel_5_3
  have h71 := congrArg q rel_7_1
  have h73 := congrArg q rel_7_3
  have h75 := congrArg q rel_7_5
  have h83 := congrArg q rel_8_3
  simp only [map_mul, map_inv, map_pow, sq, cube, mul_one,
    mul_inv_cancel_comm] at h61 h53 h71 h73 h75 h83
  have h0 : q (s 0) = 1 := by
    have h3 : q (s 3) = 1 := by
      apply mul_left_cancel (a := q (s 1))
      simpa only [← h61, mul_one] using h71.symm
    have he : q (s 2) = q (s 0) * q (s 2) := by simpa only [h3, mul_one] using h53
    exact mul_right_cancel (b := q (s 2)) (by simpa using he.symm)
  have h1 : q (s 1) = 1 := h61.symm.trans h0
  have h3 : q (s 3) = 1 := by simpa only [h0, h1, one_mul] using h71.symm
  have h5 : q (s 5) = 1 := by
    apply mul_left_cancel (a := q (s 2))
    simpa only [h73, mul_one] using h75.symm
  have h6 : q (s 6) = q (s 2) := by
    have he : 1 = q (s 4) * q (s 6) := by
      apply mul_left_cancel (a := q (s 2))
      simpa only [h0, one_mul, mul_one, mul_assoc] using h83
    calc
      q (s 6) = q (s 4) * (q (s 4) * q (s 6)) := by rw [← mul_assoc, ← pow_two, sq, one_mul]
      _ = q (s 4) := by rw [← he, mul_one]
      _ = q (s 2) := h73.symm
  exact ⟨h0, h1, h3, h5, h73.symm, h6⟩

private theorem normal_form (n : Fin 2048) :
    atlas1600SylowTwoEquiv n =
    s 0 ^ (n.val % 2) * s 1 ^ (n.val / 2 % 2) * s 2 ^ (n.val / 4 % 4) *
    s 3 ^ (n.val / 16 % 2) * s 4 ^ (n.val / 32 % 4) * s 5 ^ (n.val / 128 % 2) *
    s 6 ^ (n.val / 256 % 4) * s 7 ^ (n.val / 1024 % 2) := by
  apply Subtype.ext
  rw [atlas1600SylowTwoEquiv_apply]
  exact atlas1600SylowTwoNormalForm_eq n

private theorem pow_cases (v : V) (n : ℕ) : v ^ n = 1 ∨ v ^ n = v := by
  have he : v ^ n = v ^ (n % 2) := by
    conv_lhs => rw [← Nat.mod_add_div n 2]
    rw [pow_add, pow_mul, sq, one_pow, mul_one]
  rcases Nat.mod_two_eq_zero_or_one n with h | h <;> simp [he, h]

/-- The Frattini quotient is represented by 1, s3, s8, and s3*s8. -/
private theorem quotient_cases (v : V) :
    v = 1 ∨ v = q (s 2) ∨ v = q (s 7) ∨ v = q (s 2) * q (s 7) := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (frattini S) v
  obtain ⟨n, rfl⟩ := atlas1600SylowTwoEquiv.surjective g
  obtain ⟨h0, h1, h3, h5, h4, h6⟩ := q_relations
  rw [normal_form]
  simp only [map_mul, map_pow, h0, h1, h3, h5, h4, h6,
    one_pow, one_mul, mul_one, ← pow_add]
  rcases pow_cases (q (s 2)) (n.val / 4 % 4 + n.val / 32 % 4 + n.val / 256 % 4)
    with h | h <;>
    rcases pow_cases (q (s 7)) (n.val / 1024 % 2) with h' | h' <;>
    rw [h, h'] <;> simp

open RelativeParabolicNormalizers
local notation "Z₂" => secondCenter.subgroupOf S
local instance : (Z₂).Characteristic := secondCenter_characteristic
private def C : Subgroup S := centralizer (Z₂ : Set S)
local instance : C.Characteristic := inferInstanceAs (centralizer (Z₂ : Set S)).Characteristic

private theorem mate_perm : secondCenterMate.val = SecondCenterCertificate.y := by
  change (atlas1600ParrottAssignment .s1).val * (atlas1600ParrottAssignment .s2).val *
    (atlas1600ParrottAssignment .s3).val ^ 2 = _
  simp only [atlas1600ParrottAssignment_val, Atlas1600ParrottData.permutation,
    SecondCenterCertificate.y]

private theorem r5_perm : atlas1600R5.val = SecondCenterCertificate.x := by
  rw [atlas1600R5_eq]
  change (atlas1600ParrottAssignment .s1).val * (atlas1600ParrottAssignment .s5).val ^ 2 = _
  simp only [atlas1600ParrottAssignment_val, Atlas1600ParrottData.permutation,
    SecondCenterCertificate.x]

private theorem s3_commutes_mate :
    (s 2).val * secondCenterMate = secondCenterMate * (s 2).val := by
  have hc : (s 2).val * secondCenterMate * ((s 2).val)⁻¹ = secondCenterMate := by
    apply Subtype.ext
    change perm (s 2) * secondCenterMate.val * (perm (s 2))⁻¹ = secondCenterMate.val
    simpa only [s_perm, mate_perm, if_false, show (2 : Fin 8) ≠ 7 by decide] using
      SecondCenterCertificate.sylow_y 2
  exact (mul_inv_eq_iff_eq_mul).mp hc

private theorem s3_mem_C : s 2 ∈ C := by
  have hx : (s 2).val * atlas1600R5 = atlas1600R5 * (s 2).val :=
    congrArg Subtype.val (mem_center_iff.mp atlas1600R5_mem_center_sylowTwo (s 2))
  intro w hw
  change w.val ∈ secondCenter at hw
  apply Subtype.ext
  rcases mem_secondCenter_iff.mp hw with he | he | he | he
  · change w.val * (s 2).val = (s 2).val * w.val
    simp only [he, one_mul, mul_one]
  · change w.val * (s 2).val = (s 2).val * w.val
    rw [he, s3_commutes_mate]
  · change w.val * (s 2).val = (s 2).val * w.val
    rw [he, hx]
  · change w.val * (s 2).val = (s 2).val * w.val
    rw [he, mul_assoc, ← s3_commutes_mate, ← mul_assoc, ← hx, mul_assoc]

private theorem s8_not_mem_C : s 7 ∉ C := by
  intro h
  have hm : secondCenterMate ∈ secondCenter := mem_sup_right (mem_zpowers _)
  let y : S := ⟨secondCenterMate, secondCenter_le_sylow hm⟩
  have hh := congrArg Subtype.val (h y hm)
  change secondCenterMate * (s 7).val = (s 7).val * secondCenterMate at hh
  have hc : (s 7).val * secondCenterMate * ((s 7).val)⁻¹ =
      atlas1600R5 * secondCenterMate := by
    apply Subtype.ext
    change perm (s 7) * secondCenterMate.val * (perm (s 7))⁻¹ =
      atlas1600R5.val * secondCenterMate.val
    simpa only [s_perm, mate_perm, r5_perm, if_true] using SecondCenterCertificate.sylow_y 7
  have he : atlas1600R5 * secondCenterMate = secondCenterMate := by
    rw [← hc, ← hh, mul_assoc, mul_inv_cancel, mul_one]
  exact atlas1600R5_ne_one (mul_right_cancel (he.trans (one_mul _).symm))

private theorem C_ne_top : C ≠ ⊤ := by
  intro h
  exact s8_not_mem_C (h ▸ mem_top _)

private def W : Subgroup V := C.map q

private theorem a_mem_W : q (s 2) ∈ W := mem_map_of_mem _ s3_mem_C

private theorem W_ne_top : W ≠ ⊤ := by
  intro h
  apply C_ne_top
  apply frattini_nongenerating
  have he := congrArg (Subgroup.comap q) h
  simpa only [W, comap_map_eq, QuotientGroup.ker_mk', comap_top] using he

private theorem b_not_mem_W : q (s 7) ∉ W := by
  intro h
  apply W_ne_top
  apply top_unique
  intro v _
  rcases quotient_cases v with rfl | rfl | rfl | rfl
  · exact W.one_mem
  · exact a_mem_W
  · exact h
  · exact W.mul_mem a_mem_W h

private theorem ab_not_mem_W : q (s 2) * q (s 7) ∉ W := by
  intro h
  exact b_not_mem_W ((W.mul_mem_cancel_left a_mem_W).mp h)

private theorem maps_W (f : MulAut S) {v : V} (hv : v ∈ W) :
    quotientAut (frattini S) f v ∈ W := by
  obtain ⟨x, hx, rfl⟩ := hv
  rw [quotientAut_apply_mk]
  apply mem_map_of_mem
  exact (characteristic_iff_le_comap.mp inferInstance f) hx

private theorem fixes_a (f : MulAut S) :
    quotientAut (frattini S) f (q (s 2)) = q (s 2) := by
  let α := quotientAut (frattini S) f
  have hm : α (q (s 2)) ∈ W := maps_W f a_mem_W
  rcases quotient_cases (α (q (s 2))) with h | h | h | h
  · have ha : q (s 2) = 1 := α.injective (h.trans (map_one α).symm)
    exact h.trans ha.symm
  · exact h
  · exact (b_not_mem_W (h ▸ hm)).elim
  · exact (ab_not_mem_W (h ▸ hm)).elim

private theorem image_b_cases (f : MulAut S) :
    quotientAut (frattini S) f (q (s 7)) = q (s 7) ∨
    quotientAut (frattini S) f (q (s 7)) = q (s 2) * q (s 7) := by
  let α := quotientAut (frattini S) f
  have hm : α (q (s 7)) ∉ W := by
    intro h
    have he := maps_W (f⁻¹) h
    rw [map_inv] at he
    exact b_not_mem_W (by simpa [α] using he)
  rcases quotient_cases (α (q (s 7))) with h | h | h | h
  · exact (hm (h.symm ▸ W.one_mem)).elim
  · exact (hm (h.symm ▸ a_mem_W)).elim
  · exact Or.inl h
  · exact Or.inr h

/-- The square of each induced automorphism of the Frattini quotient is the identity. -/
public theorem quotientAut_sq (f : MulAut S) :
    quotientAut (frattini S) f ^ 2 = 1 := by
  let α := quotientAut (frattini S) f
  have ha : α (q (s 2)) = q (s 2) := fixes_a f
  have hb : α (α (q (s 7))) = q (s 7) := by
    rcases image_b_cases f with h | h
    · change α (q (s 7)) = q (s 7) at h
      rw [h, h]
    · change α (q (s 7)) = q (s 2) * q (s 7) at h
      rw [h, map_mul, ha, h, ← mul_assoc, ← pow_two, sq, one_mul]
  apply MulEquiv.ext
  intro v
  change α (α v) = v
  rcases quotient_cases v with rfl | rfl | rfl | rfl
  · rw [map_one, map_one]
  · rw [ha, ha]
  · exact hb
  · rw [map_mul, map_mul, ha, ha, hb]

/-- The automorphism group of the certified Tits Sylow two-subgroup is a two-group. -/
public theorem isPGroup_mulAut : IsPGroup 2 (MulAut S) := by
  intro f
  have hmem : f ^ 2 ∈ (quotientAut (frattini S)).ker := by
    change quotientAut (frattini S) (f ^ 2) = 1
    rw [map_pow, quotientAut_sq]
  obtain ⟨n, hn⟩ := isPGroup_quotientAut_frattini_kernel two_group ⟨f ^ 2, hmem⟩
  refine ⟨1 + n, ?_⟩
  rw [pow_add, pow_one, pow_mul]
  exact congrArg Subtype.val hn

end Tits.OuterOddSubgroups.SylowAutomorphisms
