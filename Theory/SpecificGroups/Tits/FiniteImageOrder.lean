module

public import Theory.SpecificGroups.Tits.Atlas1600Parrott
public import Theory.SpecificGroups.Tits.Atlas1600Order

/-!
# A finite quotient of Parrott's presentation of order 17971200

The finite group `Atlas1600Group` is the subgroup generated by the two Atlas
degree-1600 permutations. The assignment `atlas1600ParrottAssignment` realizes
all ten Parrott generators, and `atlas1600ParrottAssignment_relations` checks
all 37 relators. The assigned elements generate the Atlas group, giving the
surjective homomorphism `parrottFiniteImageMap` below. The independent stabilizer
chain certificate proves `atlas1600Group_card` by multiplying the indices
1600, 351, and 32.

Thus this module supplies a concrete finite quotient of the presented group;
faithfulness of the presentation and simplicity are separate results.

Sources: Parrott (1972), §5, p. 683, transcribed in
`refs/original/n-group-global/parrott-tits-presentation.md`, and the Atlas
permutations `refs/original/n-group-global/atlas-tits-p1600-{a,b}.g`.
-/

namespace Tits

/-- The quotient map induced by the ten certified Parrott generator images. -/
public def parrottFiniteImageMap : ParrottGroup →* Atlas1600Group :=
  parrottLift atlas1600ParrottAssignment atlas1600ParrottAssignment_relations

/-- Each presented generator maps to its concrete Atlas permutation. -/
@[simp] public theorem parrottFiniteImageMap_generator (i : ParrottGenerator) :
    parrottFiniteImageMap (parrottGenerator i) = atlas1600ParrottAssignment i :=
  parrottLift_generator _ _ i

/-- Every element of the concrete finite group is in the image. -/
public theorem parrottFiniteImageMap_surjective :
    Function.Surjective parrottFiniteImageMap :=
  atlas1600ParrottLift_surjective

/-- Parrott's presented group has the concrete quotient of order `17971200`. -/
public theorem exists_parrott_finite_quotient :
    ∃ φ : ParrottGroup →* Atlas1600Group,
      Function.Surjective φ ∧ Nat.card Atlas1600Group = 17971200 :=
  ⟨parrottFiniteImageMap, parrottFiniteImageMap_surjective, atlas1600Group_card⟩

end Tits
