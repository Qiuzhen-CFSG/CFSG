module

public import Theory.SpecificGroups.Tits.Presentation
public import Theory.GroupTheory.PresentedGroupBounds

/-!
# Subgroups for bounds on Parrott's presentation

The subgroup generated by every canonical generator except `r8` is Parrott's
local subgroup `R₁`. Its finite order bound is a separate theorem: the definition
here assumes neither finiteness of the subgroup nor of the presented group.

Source: Parrott, “A Characterization of the Tits' Simple Group” (1972), §5,
p. 683; see `refs/original/n-group-global/parrott-tits-presentation.md`.
-/

namespace Tits

/-- The subgroup generated by the nine canonical generators other than `r8`. -/
@[expose] public def parrottR1Subgroup : Subgroup ParrottGroup :=
  Subgroup.closure (parrottGenerator '' {a | a ≠ ParrottGenerator.r8})

/-- A certified 1755-element covering for the right cosets of Parrott's `R₁`.
The transition equations hold in the actual presented group. -/
public structure ParrottR1CosetCover where
  rep : Fin 1755 → ParrottGroup
  initial : Fin 1755
  initial_eq : rep initial = 1
  step : ParrottGenerator → Equiv.Perm (Fin 1755)
  transition : ∀ i a, ∃ h ∈ parrottR1Subgroup,
    rep i * parrottGenerator a = h * rep (step a i)

/-- The inverse permutations provide the inverse-generator transitions. -/
public def ParrottR1CosetCover.toGeneratorCosetCover (C : ParrottR1CosetCover) :
    Subgroup.GeneratorCosetCover parrottR1Subgroup parrottGenerator (Fin 1755) where
  repr := C.rep
  initial := C.initial
  initial_eq := C.initial_eq
  step i a := by
    obtain ⟨h, hh, he⟩ := C.transition i a
    exact ⟨⟨h, hh⟩, C.step a i, he⟩
  inv_step i a := by
    obtain ⟨h, hh, he⟩ := C.transition ((C.step a).symm i) a
    rw [Equiv.apply_symm_apply] at he
    refine ⟨⟨h⁻¹, parrottR1Subgroup.inv_mem hh⟩, (C.step a).symm i, ?_⟩
    have he' := congrArg (fun x => h⁻¹ * x * (parrottGenerator a)⁻¹) he
    simpa only [mul_assoc, mul_inv_cancel, mul_one, inv_mul_cancel_left] using he'.symm

/-- The certified coset equations cover every element of the presentation. -/
public theorem ParrottR1CosetCover.covers (C : ParrottR1CosetCover) (x : ParrottGroup) :
    ∃ h : parrottR1Subgroup, ∃ i, x = h.val * C.rep i :=
  C.toGeneratorCosetCover.covers (PresentedGroup.closure_range_of parrottRelatorSet) x

/-- The subgroup order bound and the coset certificate can be proved independently. -/
public theorem ParrottR1CosetCover.finite_card_le [Finite parrottR1Subgroup]
    (C : ParrottR1CosetCover) :
    Finite ParrottGroup ∧ Nat.card ParrottGroup ≤ Nat.card parrottR1Subgroup * 1755 := by
  simpa only [Nat.card_eq_fintype_card, Fintype.card_fin] using
    C.toGeneratorCosetCover.finite_card_le
      (PresentedGroup.closure_range_of parrottRelatorSet)

end Tits
