module

public import Theory.SpecificGroups.Tits.MinimumIndex.FiveOvergroups.KernelNormalizer
public import Theory.SpecificGroups.Tits.ConverseLocalCoverage.DoubleCosetCover.Base
public import Mathlib.Tactic.FinCases

/-!
# Packed generators for the five-overgroup recovery certificates

Four packed point maps are checked against the literal Atlas generators and the
marked five-kernel generators. Their certified inverses keep long word checks
from repeatedly reducing nested conditional maps. This changes only computation,
not the permutations or the subgroup model.

Source: the primary ATLAS degree-1600 permutations and max8 words documented in
`MinimumIndex/source/` and `FiveFrobenius/Tables.lean`.
-/

@[expose] public section
namespace Tits.MinimumIndexFiveOvergroups.RepresentativeGeneration.Packed
open FiveFrobenius

def data0 : Nat := 

def data1 : Nat := 

def data2 : Nat := 

def data3 : Nat := 

def pointMap (i : Fin 4) (p : Fin 1600) : Fin 1600 :=
  ⟨((![data0, data1, data2, data3] i >>> (11 * p.val)) % 2048) % 1600,
    Nat.mod_lt _ (by decide)⟩

def original : Fin 4 → Equiv.Perm (Fin 1600) := ![atlas1600A, atlas1600B, vp, up]

set_option maxRecDepth 20000 in
theorem pointMap_eq (i : Fin 4) (p : Fin 1600) : pointMap i p = original i p := by
  revert i p
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

def inversePoint : Fin 4 → Fin 1600 → Fin 1600 :=
  ![pointMap 0, fun p => pointMap 1 (pointMap 1 p),
    fun p => pointMap 2 (pointMap 2 (pointMap 2 (pointMap 2 p))),
    fun p => pointMap 3 (pointMap 3 (pointMap 3 (pointMap 3 p)))]

theorem inversePoint_eq (i : Fin 4) (p : Fin 1600) :
    inversePoint i p = (original i).symm p := by
  fin_cases i
  · exact pointMap_eq 0 p
  · change pointMap 1 (pointMap 1 p) = _
    simp only [pointMap_eq]
    rfl
  · change pointMap 2 (pointMap 2 (pointMap 2 (pointMap 2 p))) = _
    simp only [pointMap_eq]
    rfl
  · change pointMap 3 (pointMap 3 (pointMap 3 (pointMap 3 p))) = _
    simp only [pointMap_eq]
    rfl

def perm (i : Fin 4) : Equiv.Perm (Fin 1600) where
  toFun := pointMap i
  invFun := inversePoint i
  left_inv p := by rw [inversePoint_eq, pointMap_eq]; exact (original i).left_inv p
  right_inv p := by rw [pointMap_eq, inversePoint_eq]; exact (original i).right_inv p

theorem perm_eq (i : Fin 4) : perm i = original i := Equiv.ext (pointMap_eq i)

end Tits.MinimumIndexFiveOvergroups.RepresentativeGeneration.Packed
end
