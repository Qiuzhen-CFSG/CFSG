module

public import Theory.SpecificGroups.Tits.MinimumIndex.FiveOvergroups.DoubleCosetCover.Encoding
import Mathlib.Tactic.FinCases

/-!
# Packed maps for the max4 certificate

These point tables are checked against the literal generator words;
they carry no group-order or coset-coverage assumptions.
Source: primary ATLAS Tits max4/max8 programs and the fixed words in
`FiveOvergroups/Representatives`. See `DoubleCosetCover/source/` for generation.
-/

namespace Tits.MinimumIndexFiveOvergroups.DoubleCosetCertificate.Max4

open Atlas1600OrderCertificate MinimumIndexCandidates
set_option maxRecDepth 20000

@[expose] public def genData0 : Nat := 

@[expose] public def genData1 : Nat := 

@[expose] public def genData2 : Nat := 

@[expose] public def genData3 : Nat := 

@[expose] public def genMaps (i : Fin 4) : Fin 1600 → Fin 1600 :=
  point (![genData0, genData1, genData2, genData3] i)

@[expose] public def repData0 : Nat := 

@[expose] public def repData1 : Nat := 

@[expose] public def repData2 : Nat := 

@[expose] public def repData3 : Nat := 

@[expose] public def repData4 : Nat := 

@[expose] public def repData5 : Nat := 

@[expose] public def repData6 : Nat := 

@[expose] public def repMaps (i : Fin 7) : Fin 1600 → Fin 1600 :=
  point (![repData0, repData1, repData2, repData3, repData4, repData5, repData6] i)

@[expose] public def packedPair : Equiv.Perm (Fin 1600) × Equiv.Perm (Fin 1600) :=
  let a := L0G0
  let b := L0G1
  let w0 := a * b
  let w1 := b * w0
  let w2 := w1 * a
  let w3 := w2⁻¹
  let w4 := a * w1
  let w5 := w3 * w4
  let w6 := w5 * w5
  let w7 := w0 * b
  let w8 := w0 * w7
  let w9 := w0 * w8
  let w10 := w9 ^ 3
  (w6, w10)

@[expose] public def packedGen : Fin 4 → Equiv.Perm (Fin 1600) :=
  ![packedPair.1, packedPair.2, packedPair.1⁻¹, packedPair.2⁻¹]

public theorem packedGen_spec (i : Fin 4) : packedGen i = (gen max4Generators i).val := by
  have h1 : packedPair.1 = max4Generators.1.val := by
    simp only [packedPair, L0G0_eq_atlas, L0G1_eq_atlas]
    rfl
  have h2 : packedPair.2 = max4Generators.2.val := by
    simp only [packedPair, L0G0_eq_atlas, L0G1_eq_atlas]
    rfl
  fin_cases i <;> simp only [packedGen, gen, h1, h2] <;> rfl

end Tits.MinimumIndexFiveOvergroups.DoubleCosetCertificate.Max4
