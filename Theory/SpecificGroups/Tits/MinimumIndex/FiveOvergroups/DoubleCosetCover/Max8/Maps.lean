@[expose] public def packedPair : Equiv.Perm (Fin 1600) × Equiv.Perm (Fin 1600) :=
  let a := L0G0
  let b := L0G1
  let w0 := a * b
  let w1 := w0 * b
  let w2 := w0 * w1
  let w3 := w2 * w2
  let w4 := w2 * w3
  let w5 := w4⁻¹
  let w6 := w5 * b
  let w7 := w6 * w4
  (a, w7)

@[expose] public def packedGen : Fin 4 → Equiv.Perm (Fin 1600) :=
  ![packedPair.1, packedPair.2, packedPair.1⁻¹, packedPair.2⁻¹]

public theorem packedGen_spec (i : Fin 4) : packedGen i = (gen max8Generators i).val := by
  have h1 : packedPair.1 = max8Generators.1.val := by
    simp only [packedPair, L0G0_eq_atlas, L0G1_eq_atlas]
    rfl
  have h2 : packedPair.2 = max8Generators.2.val := by
    simp only [packedPair, L0G0_eq_atlas, L0G1_eq_atlas]
    rfl
  fin_cases i <;> simp only [packedGen, gen, h1, h2] <;> rfl

end Tits.MinimumIndexFiveOvergroups.DoubleCosetCertificate.Max8
