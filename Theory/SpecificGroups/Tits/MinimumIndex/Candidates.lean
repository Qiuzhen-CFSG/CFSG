module

public import Theory.SpecificGroups.Tits.Atlas1600

/-!
# Concrete candidate overgroups for the Tits minimum-index argument

These four subgroups are generated by the final two registers of the primary
ATLAS straight-line programs max1, max2, max4 and max8. The unmodified programs
and provenance are in `source/`. The inverse-point-map convention in
`Atlas1600` preserves their multiplication order.

These definitions assert no abstract group identification, order bound or
exhaustiveness. The minimum-index assembly needs separate proofs of the
candidate order bounds and coverage of subgroups with orders divisible by
13 or 25. Shared definitions let those proofs proceed independently.
-/

@[expose] public section
namespace Tits.MinimumIndexCandidates

/-- Final generator registers of primary ATLAS program max1. -/
def max1Generators : Atlas1600Group × Atlas1600Group :=
  let a : Atlas1600Group := ⟨atlas1600A, atlas1600A_mem⟩
  let b : Atlas1600Group := ⟨atlas1600B, atlas1600B_mem⟩
  let w0 := a * b
  let w1 := b * w0
  let w2 := w1 * a
  let w3 := w2⁻¹
  let w4 := a * w1
  let w5 := w3 * w4
  let w6 := w5 * w5
  let w7 := w0 * b
  let w8 := w0 * w7
  let w9 := w0 * w8
  let w10 := w9 ^ 3
  let w11 := w7 ^ 6
  let w12 := w11⁻¹
  let w13 := w12 * w10
  let w14 := w13 * w11
  let w15 := w0 ^ 4
  let w16 := w15⁻¹
  let w17 := w16 * w6
  let w18 := w17 * w15
  (w18, w14)

/-- The actual subgroup generated by program max1; its source label is not an assumption. -/
def max1 : Subgroup Atlas1600Group :=
  Subgroup.closure {max1Generators.1, max1Generators.2}

/-- Final generator registers of primary ATLAS program max2. -/
def max2Generators : Atlas1600Group × Atlas1600Group :=
  let a : Atlas1600Group := ⟨atlas1600A, atlas1600A_mem⟩
  let b : Atlas1600Group := ⟨atlas1600B, atlas1600B_mem⟩
  let w0 := a * b
  let w1 := b * w0
  let w2 := w1 * a
  let w3 := w2⁻¹
  let w4 := a * w1
  let w5 := w3 * w4
  let w6 := w5 * w5
  let w7 := w0 * b
  let w8 := w0 * w7
  let w9 := w0 * w8
  let w10 := w9 ^ 3
  let w11 := w7 ^ 6
  let w12 := w11⁻¹
  let w13 := w12 * w10
  let w14 := w13 * w11
  let w15 := w0 ^ 2
  let w16 := w15⁻¹
  let w17 := w16 * w6
  let w18 := w17 * w15
  (w18, w14)

/-- The actual subgroup generated by program max2; its source label is not an assumption. -/
def max2 : Subgroup Atlas1600Group :=
  Subgroup.closure {max2Generators.1, max2Generators.2}

/-- Final generator registers of primary ATLAS program max4. -/
def max4Generators : Atlas1600Group × Atlas1600Group :=
  let a : Atlas1600Group := ⟨atlas1600A, atlas1600A_mem⟩
  let b : Atlas1600Group := ⟨atlas1600B, atlas1600B_mem⟩
  let w0 := a * b
  let w1 := b * w0
  let w2 := w1 * a
  let w3 := w2⁻¹
  let w4 := a * w1
  let w5 := w3 * w4
  let w6 := w5 * w5
  let w7 := w0 * b
  let w8 := w0 * w7
  let w9 := w0 * w8
  let w10 := w9 ^ 3
  (w6, w10)

/-- The actual subgroup generated by program max4; its source label is not an assumption. -/
def max4 : Subgroup Atlas1600Group :=
  Subgroup.closure {max4Generators.1, max4Generators.2}

/-- Final generator registers of primary ATLAS program max8. -/
def max8Generators : Atlas1600Group × Atlas1600Group :=
  let a : Atlas1600Group := ⟨atlas1600A, atlas1600A_mem⟩
  let b : Atlas1600Group := ⟨atlas1600B, atlas1600B_mem⟩
  let w0 := a * b
  let w1 := w0 * b
  let w2 := w0 * w1
  let w3 := w2 * w2
  let w4 := w2 * w3
  let w5 := w4⁻¹
  let w6 := w5 * b
  let w7 := w6 * w4
  (a, w7)

/-- The actual subgroup generated by program max8; its source label is not an assumption. -/
def max8 : Subgroup Atlas1600Group :=
  Subgroup.closure {max8Generators.1, max8Generators.2}

end Tits.MinimumIndexCandidates
end
