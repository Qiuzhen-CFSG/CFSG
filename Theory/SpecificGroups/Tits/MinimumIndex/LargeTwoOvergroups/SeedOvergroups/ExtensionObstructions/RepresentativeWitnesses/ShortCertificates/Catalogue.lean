/-!
# Shared order-thirteen catalogue data

These fifteen masks are the candidate normal forms in `short-catalogue.json`,
indexed by the actual double-coset number minus three. The masks are data only;
`OrderCertificates` in `Contracts` states their remaining mathematical check.
Source: Parrott (1972), section 5, p.683; the parent `source/README.md`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates.ShortCertificates

def shortIndex (c : Fin 15) : Fin 18 := ⟨c.val + 3, by omega⟩

def catalogueMask : Fin 15 → Nat :=
  ![,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ]

def inCatalogue (n : Fin 2048) (c : Fin 15) : Bool :=
  (catalogueMask c).testBit n.val

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates.ShortCertificates
