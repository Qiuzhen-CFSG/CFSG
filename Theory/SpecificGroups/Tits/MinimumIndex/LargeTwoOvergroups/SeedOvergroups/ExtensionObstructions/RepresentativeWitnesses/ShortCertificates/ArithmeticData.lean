/-!
# Two-point decoder for the 2048 marked Sylow normal forms

The image of point zero leaves two possible normal forms. The image of 930
selects between them. The packed data below propose those candidates and the
two images of each normal form; `NormalForms` verifies the entire decoder.
No multiplication or membership assertion is encoded as a hypothesis.
Source: the certified Atlas normal forms, Parrott (1972), p.683.
Reproduce the proposed tables with `source/generate_arithmetic.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates.ShortCertificates

def decoderData : Nat := 

def fingerprintData : Nat := 

def fingerprint (n : Fin 2048) (second : Bool) : Fin 1600 :=
  ⟨((fingerprintData >>> (22 * n.val + if second then 11 else 0)) % 2048) % 1600,
    Nat.mod_lt _ (by decide)⟩

def decode (x y : Fin 1600) : Fin 2048 :=
  let row := decoderData >>> (33 * x.val)
  ⟨(if (row >>> 22) % 2048 == y.val then row else row >>> 11) % 2048,
    Nat.mod_lt _ (by decide)⟩

def arithmeticTest (n : Fin 2048) : Bool :=
  (fingerprint n false == normalMap n 0) &&
  (fingerprint n true == normalMap n 930) &&
  (decode (fingerprint n false) (fingerprint n true) == n)

def blockIndex (b : Fin 32) (j : Fin 64) : Fin 2048 :=
  ⟨64 * b.val + j.val, by omega⟩

/-- Multiplication, computed with two forward normal-form evaluations. -/
def normalMul (a b : Fin 2048) : Fin 2048 :=
  decode (normalMap a (fingerprint b false)) (normalMap a (fingerprint b true))

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates.ShortCertificates
