/-!
# Numeric short-recovery coverage for seeds zero through thirty-nine

Each seed proof checks the original short-case selector against all fifteen
catalogues and the literal mixed-radix walk. Splitting the restricted seed
index assembles those proofs into the low range. Certified generator moves
then recover an actual seed factor and the original left-product equation.

This discharges the first premise of `recoveryCertificates_of_coverageRanges`;
the other ranges and the final assembly remain with its owner. No seed-order,
catalogue-order, placement or seed-exhaustiveness premise is used here.

Source: Parrott (1972), section 5, p.683; `RecoveryChecks/source/README.md`
and the two parent source READMEs.
-/

public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates.ShortCertificates.RecoveryAction

/-- Every literal short case for seeds 0–39 has a catalogue walk to its target. -/
theorem numericCoverageLow : CoverageOn 0 40 := by
  intro i _ hi
  fin_cases i <;> norm_num at hi
  · exact coverage000
  · exact coverage001
  · exact coverage002
  · exact coverage003
  · exact coverage004
  · exact coverage005
  · exact coverage006
  · exact coverage007
  · exact coverage008
  · exact coverage009
  · exact coverage010
  · exact coverage011
  · exact coverage012
  · exact coverage013
  · exact coverage014
  · exact coverage015
  · exact coverage016
  · exact coverage017
  · exact coverage018
  · exact coverage019
  · exact coverage020
  · exact coverage021
  · exact coverage022
  · exact coverage023
  · exact coverage024
  · exact coverage025
  · exact coverage026
  · exact coverage027
  · exact coverage028
  · exact coverage029
  · exact coverage030
  · exact coverage031
  · exact coverage032
  · exact coverage033
  · exact coverage034
  · exact coverage035
  · exact coverage036
  · exact coverage037
  · exact coverage038
  · exact coverage039

/-- The actual recovery certificates for the low range, with no extra premise. -/
theorem recoveryCertificatesLow (i : Fin 122) (hi : i.val < 40)
    (a b : Fin 32) (c : Fin 15) (hs : witnessCase i a b c = .short) :
    ∃ q n : Fin 2048, RecoveryCertificate i a b c q n := by
  obtain ⟨n, hn, hw⟩ := numericCoverageLow i (Nat.zero_le _) hi a b c hs
  obtain ⟨q, hq⟩ := recovery_of_walk i (stepData i) (moveSound i) a b c n hn hw
  exact ⟨q, n, hq⟩

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates.ShortCertificates.RecoveryAction
