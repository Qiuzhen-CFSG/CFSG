/-- Actual seed recovery certificates for the high range, with no order premise. -/
theorem recoveryCertificatesHigh (i : Fin 122) (hlo : 80 ≤ i.val)
    (hhi : i.val < 122) (a b : Fin 32) (c : Fin 15)
    (hs : witnessCase i a b c = .short) :
    ∃ q n : Fin 2048, RecoveryCertificate i a b c q n := by
  obtain ⟨n, hn, hw⟩ := numericCoverageHigh i hlo hhi a b c hs
  obtain ⟨q, hq⟩ := recovery_of_walk i (stepData i) (moveSound i) a b c n hn hw
  exact ⟨q, n, hq⟩

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates.ShortCertificates.RecoveryAction
