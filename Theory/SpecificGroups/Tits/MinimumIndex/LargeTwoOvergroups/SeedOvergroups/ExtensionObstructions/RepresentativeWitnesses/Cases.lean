/-- A computational split, not a claim that any candidate has a witness. -/
def witnessCase (i : Fin 122) (a b : Fin 32) (c : Fin 15) : WitnessCase :=
  if (productMasks (productSelector i)).testBit (candidateIndex a b c) then .product
  else if (placeMasks (placeSelector i)).testBit (candidateIndex a b c) then .place
  else .short

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates
