abbrev Certificate := Nat × Nat × Nat

def word (d : Nat) : List (Fin 2048) :=
  (List.range (d % 16)).map fun j =>
    ⟨(d >>> (4 + 11*j)) % 2048, Nat.mod_lt _ (by decide)⟩
def certOrder (e : Certificate) : Fin 475 :=
  ⟨e.1 % 512 % 475, Nat.mod_lt _ (by decide)⟩
def certA (e : Certificate) : Fin 32 :=
  ⟨e.1 / 16384 % 32, Nat.mod_lt _ (by decide)⟩
def certB (e : Certificate) : Fin 32 :=
  ⟨e.1 / 512 % 32, Nat.mod_lt _ (by decide)⟩
def certC (e : Certificate) : Fin 15 :=
  ⟨e.1 / 524288 % 15, Nat.mod_lt _ (by decide)⟩
def certK (e : Certificate) : Fin 18 := ⟨(certC e).val + 3, by omega⟩

def certificateTest (i : Fin 122) (e : Certificate) : Bool :=
  let r := certOrder e
  let u := transversalPattern (seedTransversalPattern i) (certA e)
  let v := transversalPattern (seedTransversalPattern i) (certB e)
  decide (catalogueK r = certK e) &&
  (word e.2.1).all (fun n => decide (n ∈ seedIndices i)) &&
  (word e.2.2).all (fun n => decide (n ∈ seedIndices i)) &&
  recoverTest (word e.2.1) u v (catalogueN₁ r) &&
  recoverTest (word e.2.2) u v (catalogueN₂ r)

def mask (es : List Certificate) : Nat :=
  es.foldr (fun e bits => 2 ^ candidateIndex (certA e) (certB e) (certC e) ||| bits) 0

