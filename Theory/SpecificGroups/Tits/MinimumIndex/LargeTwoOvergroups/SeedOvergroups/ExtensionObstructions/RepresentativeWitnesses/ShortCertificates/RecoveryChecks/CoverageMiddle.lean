/-!
# Short-recovery coverage for seeds 40–79

Each seed module checks all fifteen catalogues and all pairs of transversal
indices against the original short-case selector. The range theorem gathers
these checked walks. Certified generator transitions then turn each walk into
an actual seed member and the literal normal-form recovery equation.

This supplies the middle-range premise of
`recoveryCertificates_of_coverageRanges`; it uses no order or placement premise.
Source: Parrott (1972), section 5, p.683; `RecoveryChecks/source/README.md`
and the two parent source READMEs. The per-seed proposals are generated by
`RecoveryChecks/source/generate_coverage.py` and checked by Lean's kernel.
-/

public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates.ShortCertificates.RecoveryAction

private theorem coverageMiddleAt (j : Fin 40) :
    Coverage ⟨j.val + 40, by omega⟩ (stepData ⟨j.val + 40, by omega⟩) := by
  fin_cases j
  · exact coverage040
  · exact coverage041
  · exact coverage042
  · exact coverage043
  · exact coverage044
  · exact coverage045
  · exact coverage046
  · exact coverage047
  · exact coverage048
  · exact coverage049
  · exact coverage050
  · exact coverage051
  · exact coverage052
  · exact coverage053
  · exact coverage054
  · exact coverage055
  · exact coverage056
  · exact coverage057
  · exact coverage058
  · exact coverage059
  · exact coverage060
  · exact coverage061
  · exact coverage062
  · exact coverage063
  · exact coverage064
  · exact coverage065
  · exact coverage066
  · exact coverage067
  · exact coverage068
  · exact coverage069
  · exact coverage070
  · exact coverage071
  · exact coverage072
  · exact coverage073
  · exact coverage074
  · exact coverage075
  · exact coverage076
  · exact coverage077
  · exact coverage078
  · exact coverage079

/-- Every literal short case in the middle forty seeds has a catalogue walk. -/
theorem numericCoverageMiddle : CoverageOn 40 40 := by
  intro i hlo hhi
  let j : Fin 40 := ⟨i.val - 40, by omega⟩
  have hij : (⟨j.val + 40, by omega⟩ : Fin 122) = i := by
    apply Fin.ext
    dsimp [j]
    omega
  have h := coverageMiddleAt j
  rwa [hij] at h

/-- Actual seed recovery for every short tuple with seed index in [40, 80). -/
theorem recoveryCertificatesMiddle (i : Fin 122)
    (hlo : 40 ≤ i.val) (hhi : i.val < 80)
    (a b : Fin 32) (c : Fin 15) (hs : witnessCase i a b c = .short) :
    ∃ q n : Fin 2048, RecoveryCertificate i a b c q n := by
  obtain ⟨n, hn, hw⟩ := numericCoverageMiddle i hlo hhi a b c hs
  obtain ⟨q, hq⟩ := recovery_of_walk i (stepData i) (moveSound i) a b c n hn hw
  exact ⟨q, n, hq⟩

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.RepresentativeCertificates.ShortCertificates.RecoveryAction
