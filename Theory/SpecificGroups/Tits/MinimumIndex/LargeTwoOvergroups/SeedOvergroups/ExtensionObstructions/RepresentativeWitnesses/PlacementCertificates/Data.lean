def certificateTest (d : Tile × Nat) : Bool :=
  tileTest d.1 && decide (d.2 = tileMask d.1)

def available (i : Fin 122) : List (Tile × Nat) :=
  (certificates (seedTransversalPattern i)).filter fun d =>
    decide (d.1.pattern = seedTransversalPattern i ∧ d.1.placeId ∈ placeIds i)

def coverMask (i : Fin 122) : Nat := maskUnion ((available i).map Prod.snd)

