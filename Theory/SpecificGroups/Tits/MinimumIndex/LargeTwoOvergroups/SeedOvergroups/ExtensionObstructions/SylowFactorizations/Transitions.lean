/-!
# Shared Sylow transition data

Each 36-bit entry records t, a generator number, q and u for the proposed
equation normalForm(t) * s = normalForm(q) * normalForm(u). These entries
are witnesses only; `TransitionChecks` certifies every equation.

Source: Parrott (1972), section 5, p.683; the candidate JSON in
`ExtensionObstructions/source/`. Reproduce with `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.SylowFactorizationCertificate

def transitionData : Nat := 

def transitionCode (k : Fin 5940) : Nat :=
  (transitionData >>> (36 * k.val)) % 68719476736

def transitionIndex (b : Fin 93) (j : Fin 64) : Fin 5940 :=
  ⟨(64 * b.val + j.val) % 5940, Nat.mod_lt _ (by decide)⟩

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.ExtensionObstructions.SylowFactorizationCertificate
