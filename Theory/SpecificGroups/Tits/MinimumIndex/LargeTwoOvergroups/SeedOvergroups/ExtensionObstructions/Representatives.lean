/-- Representatives to which the extension obstruction reduces. -/
def representative (i : Fin 122) (a b : Fin 32) (k : Fin 18) : Atlas1600Group :=
  transversal i a * ConverseLocalCoverage.doubleCosetRep k * (transversal i b)⁻¹

