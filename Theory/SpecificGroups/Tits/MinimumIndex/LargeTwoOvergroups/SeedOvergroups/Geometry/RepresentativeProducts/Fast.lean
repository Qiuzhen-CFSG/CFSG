module

public import Theory.SpecificGroups.Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.Evaluation
/-!
# Packed inverse evaluation of the representative fingerprints

The forward maps are the existing certified Parrott maps. The inverse maps
below are checked on every point against those forward maps. This avoids
repeated traversal of the original conditional permutation tables and avoids
replacing an inverse by three generator applications.

The representative words retain precisely the mixed-radix decoding and
multiplication order of Geometry.Evaluation. Source: Parrott (1972), p.683.
The accompanying original Python generator only proposes inverse tables;
`pointMap_inverse` certifies them in Lean's kernel.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.RepresentativeProducts
open OuterOddSubgroups.OverlapCentralizers
set_option Elab.async false
def r1InverseData : Nat := 

def r8InverseData : Nat := 

def s1InverseData : Nat := 

def s2InverseData : Nat := 

def s3InverseData : Nat := 

def s4InverseData : Nat := 

def s5InverseData : Nat := 

def s6InverseData : Nat := 

def s7InverseData : Nat := 

def s8InverseData : Nat := 

def inversePoint (i : Fin 10) (p : Fin 1600) : Fin 1600 :=
  ⟨((![r1InverseData, r8InverseData, s1InverseData, s2InverseData, s3InverseData, s4InverseData, s5InverseData, s6InverseData, s7InverseData, s8InverseData] i >>> (11 * p.val)) % 2048) % 1600, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 10000 in
private theorem pointMap_inverse (i : Fin 10) (p : Fin 1600) :
    Packed.pointMap i (inversePoint i p) = p := by
  revert i p
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

/-- Both point maps are packed; equality below links this to the original map. -/
def generator (i : Fin 10) : Equiv.Perm (Fin 1600) where
  toFun := Packed.pointMap i
  invFun := inversePoint i
  left_inv p := by exact (Packed.perm i).injective (pointMap_inverse i (Packed.pointMap i p))
  right_inv := by exact pointMap_inverse i

theorem generator_eq (i : Fin 10) : generator i = Packed.perm i := Equiv.ext (fun _ => rfl)

def assignment : ParrottGenerator → Equiv.Perm (Fin 1600)
  | .r1 => generator 0
  | .r8 => generator 1
  | .s1 => generator 2
  | .s2 => generator 3
  | .s3 => generator 4
  | .s4 => generator 5
  | .s5 => generator 6
  | .s6 => generator 7
  | .s7 => generator 8
  | .s8 => generator 9

theorem assignment_eq (s : ParrottGenerator) : assignment s = fastAssignment s := by
  cases s <;> simp only [assignment, fastAssignment, generator_eq]

def conjugator (j : Fin 38) : Equiv.Perm (Fin 1600) :=
  ((placeWord j).map assignment).prod

theorem conjugator_eq (j : Fin 38) : conjugator j = fastConjugator j := by
  simp only [conjugator, fastConjugator, show assignment = fastAssignment from funext assignment_eq]

def normalForm (n : Fin 2048) : Equiv.Perm (Fin 1600) :=
  assignment .s1 ^ (n.val % 2) *
    assignment .s2 ^ (n.val / 2 % 2) *
    assignment .s3 ^ (n.val / 4 % 4) *
    assignment .s4 ^ (n.val / 16 % 2) *
    assignment .s5 ^ (n.val / 32 % 4) *
    assignment .s6 ^ (n.val / 128 % 2) *
    assignment .s7 ^ (n.val / 256 % 4) *
    assignment .s8 ^ (n.val / 1024 % 2)

theorem normalForm_eq (n : Fin 2048) : normalForm n = fastNormalForm n := by
  simp only [normalForm, fastNormalForm, assignment_eq]

def representative (r : Row) : Equiv.Perm (Fin 1600) :=
  let j : Fin 38 := ⟨r.1 % 38, Nat.mod_lt _ (by decide)⟩
  let n : Fin 2048 := ⟨r.1 / 38 % 2048, Nat.mod_lt _ (by decide)⟩
  let rotation := if j.val < 17 then assignment .s1 * assignment .r1
    else assignment .s8 * assignment .r8
  let w := conjugator j
  w * (normalForm n * rotation ^ (r.1 / (38 * 2048))) * w⁻¹

theorem representative_eq (r : Row) : representative r = rowPerm r := by
  simp only [representative, rowPerm, assignment_eq, conjugator_eq, normalForm_eq]

def pointSignature (g : Equiv.Perm (Fin 1600)) : Nat :=
  (g 0).val + 1600 * (g 1).val + 1600^2 * (g 2).val

def key (r : Row) (j : Fin 38) : Nat :=
  let g := (conjugator j)⁻¹ * representative r
  let z := assignment .s1 * assignment .s5 ^ 2
  let v := assignment .s1 * assignment .s2 * assignment .s3 ^ 2
  if j.val < 17 then pointSignature (g⁻¹ * z * g)
  else pointSignature (g⁻¹ * z * g) + pointSignature (g⁻¹ * v * g) +
    pointSignature (g⁻¹ * (z * v) * g)
end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.RepresentativeProducts
