module

public import Theory.SpecificGroups.Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.RepresentativeMasks.PointData
import Mathlib.Tactic.FinCases

/-!
# Reusable point actions of the two short rotations

The five powers of s1*r1 and three powers of s8*r8 used by the row codes
are checked against the literal permutations on all 1600 points. These are
point-action certificates; no assertion of the rotations' orders is needed.
Source: Parrott (1972), p.683, and Geometry/Data.lean.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.RepresentativeMasks
set_option Elab.async false

def firstRotationData0 : Nat := 

def firstRotationData1 : Nat := 

def firstRotationData2 : Nat := 

def firstRotationData3 : Nat := 

def firstRotationData4 : Nat := 

def firstRotationData (i : Fin 5) : Nat :=
  ![firstRotationData0, firstRotationData1, firstRotationData2, firstRotationData3, firstRotationData4] i

set_option maxRecDepth 10000 in
private theorem first_0 : ∀ p : Fin 1600,
    tableMap (firstRotationData 0) p =
      ((fastAssignment .s1 * fastAssignment .r1) ^ 0) p := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel

set_option maxRecDepth 10000 in
private theorem first_1 : ∀ p : Fin 1600,
    tableMap (firstRotationData 1) p =
      ((fastAssignment .s1 * fastAssignment .r1) ^ 1) p := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel

set_option maxRecDepth 10000 in
private theorem first_2 : ∀ p : Fin 1600,
    tableMap (firstRotationData 2) p =
      ((fastAssignment .s1 * fastAssignment .r1) ^ 2) p := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel

set_option maxRecDepth 10000 in
private theorem first_3 : ∀ p : Fin 1600,
    tableMap (firstRotationData 3) p =
      ((fastAssignment .s1 * fastAssignment .r1) ^ 3) p := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel

set_option maxRecDepth 10000 in
private theorem first_4 : ∀ p : Fin 1600,
    tableMap (firstRotationData 4) p =
      ((fastAssignment .s1 * fastAssignment .r1) ^ 4) p := by
  apply Atlas1600OrderCertificate.allFin
  decide +kernel

theorem firstRotation_correct (i : Fin 5) (p : Fin 1600) :
    tableMap (firstRotationData i) p =
      ((fastAssignment .s1 * fastAssignment .r1) ^ i.val) p := by
  fin_cases i
  · exact first_0 p
  · exact first_1 p
  · exact first_2 p
  · exact first_3 p
  · exact first_4 p

