theorem cover (j : Fin 38) (hj : j ∈ placePattern 6) (k : Fin 32)
    (e : Nat) (he : e < rotationCount j) :
    ∃ q ∈ factors 6, ∃ r ∈ rows 6,
      conjugate j (atlas1600SylowTwoNormalForm (sylowRepresentatives 6 j k) *
        rotation j ^ e) = q * rowElement r := by
  have hj' : j ∈ ([0, 1, 17, 24, 29, 30, 3, 31] : List (Fin 38)) := hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj'
  rcases hj' with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact cover_0 k e he
  · exact cover_1 k e he
  · exact cover_17 k e he
  · exact cover_24 k e he
  · exact cover_29 k e he
  · exact cover_30 k e he
  · exact cover_3 k e he
  · exact cover_31 k e he

