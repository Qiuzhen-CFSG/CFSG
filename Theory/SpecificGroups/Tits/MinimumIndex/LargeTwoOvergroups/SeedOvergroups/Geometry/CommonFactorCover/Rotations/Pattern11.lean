theorem cover (j : Fin 38) (hj : j ∈ placePattern 11) (k : Fin 32)
    (e : Nat) (he : e < rotationCount j) :
    ∃ q ∈ factors 11, ∃ r ∈ rows 11,
      conjugate j (atlas1600SylowTwoNormalForm (sylowRepresentatives 11 j k) *
        rotation j ^ e) = q * rowElement r := by
  have hj' : j ∈ ([7, 12, 17, 18, 20, 21, 0, 22] : List (Fin 38)) := hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj'
  rcases hj' with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact cover_7 k e he
  · exact cover_12 k e he
  · exact cover_17 k e he
  · exact cover_18 k e he
  · exact cover_20 k e he
  · exact cover_21 k e he
  · exact cover_0 k e he
  · exact cover_22 k e he

