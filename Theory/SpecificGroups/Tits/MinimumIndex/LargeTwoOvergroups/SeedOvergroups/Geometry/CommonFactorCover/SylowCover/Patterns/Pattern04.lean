theorem sylow_covered_04 (j : Fin 38) (hj : j ∈ placePattern 4) (n : Fin 2048) :
    Covered 4 j (conjugate j (atlas1600SylowTwoNormalForm n)) := by
  have he : placePattern 4 = [0, 1, 3, 17] := by decide +kernel
  rw [he] at hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with rfl | rfl | rfl | rfl
  · exact covered_00 n
  · exact covered_01 n
  · exact covered_03 n
  · exact covered_17 n

