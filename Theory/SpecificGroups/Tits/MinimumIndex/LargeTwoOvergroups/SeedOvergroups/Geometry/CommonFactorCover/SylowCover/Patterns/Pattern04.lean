/-!
# Factor closure and Sylow covers for pattern 4

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 4 closureData g k = true := by
  have hf : factorIndices 4 = [0, 1, 2, 3, 8, 9, 10, 11, 16, 17, 18, 19, 24, 25, 26, 27, 64, 65, 66, 67, 72, 73, 74, 75, 80, 81, 82, 83, 88, 89, 90, 91, 512, 513, 514, 515, 520, 521, 522, 523, 528, 529, 530, 531, 536, 537, 538, 539, 576, 577, 578, 579, 584, 585, 586, 587, 592, 593, 594, 595, 600, 601, 602, 603] := by decide +kernel
  have hg : generatorIndices 4 = [1, 2, 8, 16, 64, 512] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_04 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 4) : q ∈ factors 4 :=
  closure_sound productCode product_checks 4 closureData closure_checked q hq

private def rowData00 : Nat := 

private theorem row_checked_00 : ∀ a g, rowTest productCode conjCode 4 0 rowData00 a g = true := by
  have hf : factorIndices 4 = [0, 1, 2, 3, 8, 9, 10, 11, 16, 17, 18, 19, 24, 25, 26, 27, 64, 65, 66, 67, 72, 73, 74, 75, 80, 81, 82, 83, 88, 89, 90, 91, 512, 513, 514, 515, 520, 521, 522, 523, 528, 529, 530, 531, 536, 537, 538, 539, 576, 577, 578, 579, 584, 585, 586, 587, 592, 593, 594, 595, 600, 601, 602, 603] := by decide +kernel
  have hr : sylowRepresentatives 4 0 = ![0, 4, 32, 36, 128, 132, 160, 164, 256, 260, 288, 292, 384, 388, 416, 420, 1024, 1028, 1056, 1060, 1152, 1156, 1184, 1188, 1280, 1284, 1312, 1316, 1408, 1412, 1440, 1444] := by
    funext k
    revert k
    apply Atlas1600OrderCertificate.allFin
    decide +kernel
  simp only [rowTest, factorAt, hf, hr]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

private theorem covered_00 (n : Fin 2048) :
    Covered 4 0 (conjugate 0 (atlas1600SylowTwoNormalForm n)) := by
  apply all_covered 4 0 (by decide +kernel)
  exact fun a g => row_sound productCode conjCode product_checks conj_checks
    4 0 rowData00 a g (row_checked_00 a g)

