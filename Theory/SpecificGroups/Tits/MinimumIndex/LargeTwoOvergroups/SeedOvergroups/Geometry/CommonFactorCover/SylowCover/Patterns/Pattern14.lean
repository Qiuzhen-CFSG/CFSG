/-!
# Factor closure and Sylow covers for pattern 14

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 14 closureData g k = true := by
  have hf : factorIndices 14 = [0, 11, 16, 27, 65, 74, 81, 90, 128, 139, 144, 155, 193, 202, 209, 218, 548, 559, 564, 575, 613, 622, 629, 638, 676, 687, 692, 703, 741, 750, 757, 766, 1312, 1323, 1328, 1339, 1377, 1386, 1393, 1402, 1440, 1451, 1456, 1467, 1505, 1514, 1521, 1530, 1799, 1804, 1815, 1820, 1862, 1869, 1878, 1885, 1927, 1932, 1943, 1948, 1990, 1997, 2006, 2013] := by decide +kernel
  have hg : generatorIndices 14 = [11, 16, 65, 128, 548, 1312] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_14 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 14) : q ∈ factors 14 :=
  closure_sound productCode product_checks 14 closureData closure_checked q hq

