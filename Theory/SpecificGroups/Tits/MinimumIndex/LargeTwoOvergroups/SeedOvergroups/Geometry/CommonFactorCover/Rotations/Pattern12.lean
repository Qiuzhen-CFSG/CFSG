theorem cover (j : Fin 38) (hj : j ∈ placePattern 12) (k : Fin 32)
    (e : Nat) (he : e < rotationCount j) :
    ∃ q ∈ factors 12, ∃ r ∈ rows 12,
      conjugate j (atlas1600SylowTwoNormalForm (sylowRepresentatives 12 j k) *
        rotation j ^ e) = q * rowElement r := by
  have hj' : j ∈ ([2, 5, 6, 11, 17, 18, 20, 21, 0, 22] : List (Fin 38)) := hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj'
