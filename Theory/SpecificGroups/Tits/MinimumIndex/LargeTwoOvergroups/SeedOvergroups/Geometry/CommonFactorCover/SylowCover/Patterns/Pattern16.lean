module

public import Theory.SpecificGroups.Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover.Equations

/-!
# Factor closure and Sylow covers for pattern 16

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 16 closureData g k = true := by
  have hf : factorIndices 16 = [0, 27, 65, 90, 139, 144, 202, 209, 288, 315, 353, 378, 416, 443, 481, 506, 559, 575, 622, 638, 687, 703, 750, 766, 780, 796, 845, 861, 903, 919, 966, 982, 1033, 1042, 1096, 1107, 1154, 1177, 1219, 1240, 1321, 1330, 1384, 1395, 1449, 1458, 1512, 1523, 1574, 1590, 1639, 1655, 1702, 1718, 1767, 1783, 1797, 1813, 1860, 1876, 1934, 1950, 1999, 2015] := by decide +kernel
  have hg : generatorIndices 16 = [27, 65, 139, 288, 1033] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_16 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 16) : q ∈ factors 16 :=
  closure_sound productCode product_checks 16 closureData closure_checked q hq

