/-!
# Factor closure and Sylow covers for pattern 11

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 11 closureData g k = true := by
  have hf : factorIndices 11 = [0, 11, 16, 27, 37, 46, 53, 62, 65, 74, 81, 90, 100, 111, 116, 127, 128, 139, 144, 155, 165, 174, 181, 190, 193, 202, 209, 218, 228, 239, 244, 255, 1797, 1806, 1813, 1822, 1825, 1834, 1841, 1850, 1860, 1871, 1876, 1887, 1888, 1899, 1904, 1915, 1925, 1934, 1941, 1950, 1953, 1962, 1969, 1978, 1988, 1999, 2004, 2015, 2016, 2027, 2032, 2043] := by decide +kernel
  have hg : generatorIndices 11 = [11, 16, 37, 128, 1797] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_11 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 11) : q ∈ factors 11 :=
  closure_sound productCode product_checks 11 closureData closure_checked q hq

