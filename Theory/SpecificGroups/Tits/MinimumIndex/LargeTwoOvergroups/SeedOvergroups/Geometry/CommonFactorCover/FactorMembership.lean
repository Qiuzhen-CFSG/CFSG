/-- Strong induction on normal-form indices proves the whole factor list. -/
theorem factors_generated (t : Fin 18)
    (P : Subgroup Atlas1600Group)
    (hg : ∀ n ∈ generatorIndices t, atlas1600SylowTwoNormalForm n ∈ P) :
    ∀ n ∈ factorIndices t, atlas1600SylowTwoNormalForm n ∈ P := by
  have hshape := shape_checked t
  have hsteps := steps_checked t
  have hz : atlas1600SylowTwoNormalForm 0 = 1 := by
    norm_num [atlas1600SylowTwoNormalForm_eq]
  have main : ∀ k : Nat, ∀ n : Fin 2048, n.val = k → n ∈ factorIndices t →
      atlas1600SylowTwoNormalForm n ∈ P := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro n hn hmem
      obtain ⟨r, hr, rfl⟩ := List.mem_map.mp (hshape.symm ▸ hmem)
      have hc := List.all_eq_true.mp hsteps r hr
      simp only [factorStepTest, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq,
        decide_eq_true_eq] at hc
      rcases hc with hzero | ⟨⟨⟨hlt, hp⟩, hgen⟩, he⟩
      · rw [hzero, hz]; exact P.one_mem
      · have hid : atlas1600SylowTwoNormalForm r.1 =
            atlas1600SylowTwoNormalForm r.2.2 * atlas1600SylowTwoNormalForm r.2.1 := by
          apply (sameBase_iff _ _).mp
          change sameBase (atlas1600SylowTwoNormalForm r.1).val
            ((atlas1600SylowTwoNormalForm r.2.2).val *
              (atlas1600SylowTwoNormalForm r.2.1).val) = true
          simpa only [fastNormalForm_eq] using he
        rw [hid]
        exact P.mul_mem (hg _ hgen) (ih _ (by omega) _ rfl hp)
  intro n hn
  exact main n.val n rfl hn

/-- Membership of the small generating set in every literal place. -/
theorem generators_mem_places (t : Fin 18) (n : Fin 2048)
    (hn : n ∈ generatorIndices t) (j : Fin 38) (hj : j ∈ placePattern t) :
    atlas1600SylowTwoNormalForm n ∈ place j := by
  apply (test_iff _ _).mp
  rw [← fastNormalForm_eq]
  exact List.all_eq_true.mp (List.all_eq_true.mp (generators_checked t) n hn) j hj

/-- The actual subgroup generated by the source words. -/
def factorSubgroup (t : Fin 18) : Subgroup Atlas1600Group :=
  Subgroup.closure {x | x ∈ (generatorIndices t).map atlas1600SylowTwoNormalForm}

theorem factors_mem_factorSubgroup (t : Fin 18) (q : Atlas1600Group) (hq : q ∈ factors t) :
    q ∈ factorSubgroup t := by
  obtain ⟨n, hn, rfl⟩ := List.mem_map.mp hq
  apply factors_generated t (factorSubgroup t) ?_ n hn
  intro a ha
  exact Subgroup.subset_closure (List.mem_map.mpr ⟨a, ha, rfl⟩)

theorem factorSubgroup_le_place (t : Fin 18) (j : Fin 38) (hj : j ∈ placePattern t) :
    factorSubgroup t ≤ place j := by
  apply (Subgroup.closure_le _).mpr
  intro x hx
  obtain ⟨n, hn, rfl⟩ := List.mem_map.mp hx
  exact generators_mem_places t n hn j hj

end CommonFactorCover

/-- Every literal common factor belongs to every place in its pattern. This
also holds for pattern 9, although the final geometry does not require it. -/
theorem factors_mem_places (t : Fin 18) (q : Atlas1600Group) (hq : q ∈ factors t)
    (j : Fin 38) (hj : j ∈ placePattern t) : q ∈ place j :=
  CommonFactorCover.factorSubgroup_le_place t j hj
    (CommonFactorCover.factors_mem_factorSubgroup t q hq)

