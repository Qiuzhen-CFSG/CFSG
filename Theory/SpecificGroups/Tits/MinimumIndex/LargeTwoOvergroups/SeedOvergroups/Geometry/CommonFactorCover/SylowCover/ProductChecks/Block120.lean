theorem product_checks_120 (b : Fin 11) (k : Fin 64) :
    productTest (productCode (productIndex ⟨120 + b.val, by omega⟩ k)) = true := by
  fin_cases b
  · exact check_120 k
  · exact check_121 k
  · exact check_122 k
  · exact check_123 k
  · exact check_124 k
  · exact check_125 k
  · exact check_126 k
