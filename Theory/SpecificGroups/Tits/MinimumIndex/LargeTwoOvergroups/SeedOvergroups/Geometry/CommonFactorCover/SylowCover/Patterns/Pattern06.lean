module

public import Theory.SpecificGroups.Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover.Equations

/-!
# Factor closure and Sylow covers for pattern 6

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 6 closureData g k = true := by
  have hf : factorIndices 6 = [0, 2, 9, 11, 16, 18, 25, 27, 65, 67, 72, 74, 81, 83, 88, 90, 128, 130, 137, 139, 144, 146, 153, 155, 193, 195, 200, 202, 209, 211, 216, 218, 512, 514, 521, 523, 528, 530, 537, 539, 577, 579, 584, 586, 593, 595, 600, 602, 640, 642, 649, 651, 656, 658, 665, 667, 705, 707, 712, 714, 721, 723, 728, 730] := by decide +kernel
  have hg : generatorIndices 6 = [2, 9, 16, 65, 128, 512] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_06 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 6) : q ∈ factors 6 :=
  closure_sound productCode product_checks 6 closureData closure_checked q hq

private def rowData00 : Nat := 

private theorem row_checked_00 : ∀ a g, rowTest productCode conjCode 6 0 rowData00 a g = true := by
  have hf : factorIndices 6 = [0, 2, 9, 11, 16, 18, 25, 27, 65, 67, 72, 74, 81, 83, 88, 90, 128, 130, 137, 139, 144, 146, 153, 155, 193, 195, 200, 202, 209, 211, 216, 218, 512, 514, 521, 523, 528, 530, 537, 539, 577, 579, 584, 586, 593, 595, 600, 602, 640, 642, 649, 651, 656, 658, 665, 667, 705, 707, 712, 714, 721, 723, 728, 730] := by decide +kernel
  have hr : sylowRepresentatives 6 0 = ![0, 1, 4, 5, 32, 33, 36, 37, 256, 257, 260, 261, 288, 289, 292, 293, 1024, 1025, 1028, 1029, 1056, 1057, 1060, 1061, 1280, 1281, 1284, 1285, 1312, 1313, 1316, 1317] := by
    funext k
    revert k
    apply Atlas1600OrderCertificate.allFin
    decide +kernel
  simp only [rowTest, factorAt, hf, hr]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

private theorem covered_00 (n : Fin 2048) :
    Covered 6 0 (conjugate 0 (atlas1600SylowTwoNormalForm n)) := by
  apply all_covered 6 0 (by decide +kernel)
  exact fun a g => row_sound productCode conjCode product_checks conj_checks
    6 0 rowData00 a g (row_checked_00 a g)

