theorem sylow_covered_06 (j : Fin 38) (hj : j ∈ placePattern 6) (n : Fin 2048) :
    Covered 6 j (conjugate j (atlas1600SylowTwoNormalForm n)) := by
  have he : placePattern 6 = [0, 1, 17, 24, 29, 30, 3, 31] := by decide +kernel
  rw [he] at hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact covered_00 n
  · exact covered_01 n
  · exact covered_17 n
  · exact covered_24 n
  · exact covered_29 n
  · exact covered_30 n
  · exact covered_03 n
  · exact covered_31 n

