theorem sylow_covered_01 (j : Fin 38) (hj : j ∈ placePattern 1) (n : Fin 2048) :
    Covered 1 j (conjugate j (atlas1600SylowTwoNormalForm n)) := by
  have he : placePattern 1 = [0, 3, 14, 16, 17, 19, 23, 25, 1, 26] := by decide +kernel
  rw [he] at hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact covered_00 n
  · exact covered_03 n
  · exact covered_14 n
  · exact covered_16 n
  · exact covered_17 n
  · exact covered_19 n
  · exact covered_23 n
  · exact covered_25 n
  · exact covered_01 n
  · exact covered_26 n

