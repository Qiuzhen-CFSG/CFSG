  have hr : sylowRepresentatives 1 0 = ![0, 32, 64, 96, 256, 288, 320, 352, 512, 544, 576, 608, 768, 800, 832, 864, 1024, 1056, 1088, 1120, 1280, 1312, 1344, 1376, 1536, 1568, 1600, 1632, 1792, 1824, 1856, 1888] := by
    funext k
    revert k
    apply Atlas1600OrderCertificate.allFin
