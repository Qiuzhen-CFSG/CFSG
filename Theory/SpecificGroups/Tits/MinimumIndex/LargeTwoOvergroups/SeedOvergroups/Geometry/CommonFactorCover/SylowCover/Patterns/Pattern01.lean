  decide +kernel

private theorem covered_00 (n : Fin 2048) :
    Covered 1 0 (conjugate 0 (atlas1600SylowTwoNormalForm n)) := by
  apply all_covered 1 0 (by decide +kernel)
  exact fun a g => row_sound productCode conjCode product_checks conj_checks
    1 0 rowData00 a g (row_checked_00 a g)

