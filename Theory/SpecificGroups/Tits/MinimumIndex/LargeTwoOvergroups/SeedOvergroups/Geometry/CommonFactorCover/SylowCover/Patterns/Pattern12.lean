theorem sylow_covered_12 (j : Fin 38) (hj : j ∈ placePattern 12) (n : Fin 2048) :
    Covered 12 j (conjugate j (atlas1600SylowTwoNormalForm n)) := by
  have he : placePattern 12 = [2, 5, 6, 11, 17, 18, 20, 21, 0, 22] := by decide +kernel
  rw [he] at hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact covered_02 n
  · exact covered_05 n
  · exact covered_06 n
  · exact covered_11 n
  · exact covered_17 n
  · exact covered_18 n
  · exact covered_20 n
  · exact covered_21 n
  · exact covered_00 n
  · exact covered_22 n

