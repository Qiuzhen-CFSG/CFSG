/-!
# Factor closure and Sylow covers for pattern 12

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 12 closureData g k = true := by
  have hf : factorIndices 12 = [0, 11, 16, 27, 39, 44, 55, 60, 65, 74, 81, 90, 102, 109, 118, 125, 128, 139, 144, 155, 167, 172, 183, 188, 193, 202, 209, 218, 230, 237, 246, 253, 1799, 1804, 1815, 1820, 1825, 1834, 1841, 1850, 1862, 1869, 1878, 1885, 1888, 1899, 1904, 1915, 1927, 1932, 1943, 1948, 1953, 1962, 1969, 1978, 1990, 1997, 2006, 2013, 2016, 2027, 2032, 2043] := by decide +kernel
  have hg : generatorIndices 12 = [11, 16, 39, 128, 1799] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_12 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 12) : q ∈ factors 12 :=
  closure_sound productCode product_checks 12 closureData closure_checked q hq

