/-!
# Factor closure and Sylow covers for pattern 17

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 17 closureData g k = true := by
  have hf : factorIndices 17 = [0, 27, 65, 90, 139, 144, 202, 209, 290, 313, 355, 376, 418, 441, 483, 504, 559, 575, 622, 638, 687, 703, 750, 766, 782, 798, 847, 863, 901, 917, 964, 980, 1026, 1049, 1091, 1112, 1161, 1170, 1224, 1235, 1312, 1339, 1377, 1402, 1440, 1467, 1505, 1530, 1581, 1597, 1644, 1660, 1709, 1725, 1772, 1788, 1804, 1820, 1869, 1885, 1927, 1943, 1990, 2006] := by decide +kernel
  have hg : generatorIndices 17 = [27, 65, 139, 290, 1026] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_17 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 17) : q ∈ factors 17 :=
  closure_sound productCode product_checks 17 closureData closure_checked q hq

