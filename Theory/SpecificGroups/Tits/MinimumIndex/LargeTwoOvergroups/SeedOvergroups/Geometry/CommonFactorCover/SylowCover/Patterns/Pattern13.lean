private theorem closure_checked : ∀ g k, closureTest productCode 13 closureData g k = true := by
  have hf : factorIndices 13 = [0, 11, 16, 27, 65, 74, 81, 90, 128, 139, 144, 155, 193, 202, 209, 218, 290, 297, 306, 313, 355, 360, 371, 376, 418, 425, 434, 441, 483, 488, 499, 504, 548, 559, 564, 575, 613, 622, 629, 638, 676, 687, 692, 703, 741, 750, 757, 766, 773, 782, 789, 798, 836, 847, 852, 863, 901, 910, 917, 926, 964, 975, 980, 991] := by decide +kernel
