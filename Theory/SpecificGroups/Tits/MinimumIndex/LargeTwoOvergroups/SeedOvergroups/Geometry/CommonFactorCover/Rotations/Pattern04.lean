/-- The literal rotation cover for pattern 4, with no coverage premise. -/
theorem cover (j : Fin 38) (hj : j ∈ placePattern 4) (k : Fin 32)
    (e : Nat) (he : e < rotationCount j) :
    ∃ q ∈ factors 4, ∃ r ∈ rows 4,
      conjugate j (atlas1600SylowTwoNormalForm (sylowRepresentatives 4 j k) *
        rotation j ^ e) = q * rowElement r := by
  have hj' : j ∈ ([0, 1, 3, 17] : List (Fin 38)) := hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj'
  rcases hj' with rfl | rfl | rfl | rfl
  · exact cover_0 k e he
  · exact cover_1 k e he
  · exact cover_3 k e he
  · exact cover_17 k e he

