/-!
# Exhaustive factors and the literal Sylow coset covers

Generator closure proves that the literal factor list exhausts its generated
subgroup. The checked representative transitions then give all 2,048 Sylow
words in every listed place, with no additional hypotheses. These two
exports discharge the factor and Sylow premises of
`Geometry.commonFactorCover_of_sylow_covers`; its rotation premise is separate.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover

/-- The common factors exhaust the subgroup generated by the source words. -/
theorem factorSubgroup_mem_factors (t : Fin 18) (ht : t ≠ 9)
    (q : Atlas1600Group) (hq : q ∈ factorSubgroup t) : q ∈ factors t := by
  fin_cases t
  · exact SylowCover.factor_closed_00 q hq
  · exact SylowCover.factor_closed_01 q hq
  · exact SylowCover.factor_closed_02 q hq
  · exact SylowCover.factor_closed_03 q hq
  · exact SylowCover.factor_closed_04 q hq
  · exact SylowCover.factor_closed_05 q hq
  · exact SylowCover.factor_closed_06 q hq
  · exact SylowCover.factor_closed_07 q hq
  · exact SylowCover.factor_closed_08 q hq
  · exact False.elim (ht rfl)
  · exact SylowCover.factor_closed_10 q hq
  · exact SylowCover.factor_closed_11 q hq
  · exact SylowCover.factor_closed_12 q hq
  · exact SylowCover.factor_closed_13 q hq
  · exact SylowCover.factor_closed_14 q hq
  · exact SylowCover.factor_closed_15 q hq
  · exact SylowCover.factor_closed_16 q hq
  · exact SylowCover.factor_closed_17 q hq

/-- Every conjugated Sylow word is a common factor times one of the exact
32 published representatives, using left multiplication. -/
theorem sylowFactorCover (t : Fin 18) (ht : t ≠ 9)
    (j : Fin 38) (hj : j ∈ placePattern t) (n : Fin 2048) :
    ∃ q : Atlas1600Group, q ∈ factorSubgroup t ∧ ∃ k : Fin 32,
      conjugate j (atlas1600SylowTwoNormalForm n) =
        q * conjugate j (atlas1600SylowTwoNormalForm (sylowRepresentatives t j k)) := by
  fin_cases t
  · exact SylowCover.sylow_covered_00 j hj n
  · exact SylowCover.sylow_covered_01 j hj n
  · exact SylowCover.sylow_covered_02 j hj n
  · exact SylowCover.sylow_covered_03 j hj n
  · exact SylowCover.sylow_covered_04 j hj n
  · exact SylowCover.sylow_covered_05 j hj n
  · exact SylowCover.sylow_covered_06 j hj n
  · exact SylowCover.sylow_covered_07 j hj n
  · exact SylowCover.sylow_covered_08 j hj n
  · exact False.elim (ht rfl)
  · exact SylowCover.sylow_covered_10 j hj n
  · exact SylowCover.sylow_covered_11 j hj n
  · exact SylowCover.sylow_covered_12 j hj n
  · exact SylowCover.sylow_covered_13 j hj n
  · exact SylowCover.sylow_covered_14 j hj n
  · exact SylowCover.sylow_covered_15 j hj n
  · exact SylowCover.sylow_covered_16 j hj n
  · exact SylowCover.sylow_covered_17 j hj n

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover
