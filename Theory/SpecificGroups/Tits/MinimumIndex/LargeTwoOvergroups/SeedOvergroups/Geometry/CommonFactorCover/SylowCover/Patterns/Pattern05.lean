theorem sylow_covered_05 (j : Fin 38) (hj : j ∈ placePattern 5) (n : Fin 2048) :
    Covered 5 j (conjugate j (atlas1600SylowTwoNormalForm n)) := by
  have he : placePattern 5 = [18, 19, 20, 21, 22, 0, 23, 24, 25, 26, 1, 17, 29, 30, 3, 31] := by decide +kernel
  rw [he] at hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact covered_18 n
  · exact covered_19 n
  · exact covered_20 n
  · exact covered_21 n
  · exact covered_22 n
  · exact covered_00 n
  · exact covered_23 n
  · exact covered_24 n
  · exact covered_25 n
  · exact covered_26 n
  · exact covered_01 n
  · exact covered_17 n
  · exact covered_29 n
  · exact covered_30 n
  · exact covered_03 n
  · exact covered_31 n

