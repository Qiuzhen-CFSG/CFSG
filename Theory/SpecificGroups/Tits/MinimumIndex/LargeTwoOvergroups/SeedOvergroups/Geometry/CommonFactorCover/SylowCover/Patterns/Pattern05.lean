/-!
# Factor closure and Sylow covers for pattern 5

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 5 closureData g k = true := by
  have hf : factorIndices 5 = [0, 2, 9, 11, 16, 18, 25, 27, 37, 39, 44, 46, 53, 55, 60, 62, 65, 67, 72, 74, 81, 83, 88, 90, 100, 102, 109, 111, 116, 118, 125, 127, 128, 130, 137, 139, 144, 146, 153, 155, 165, 167, 172, 174, 181, 183, 188, 190, 193, 195, 200, 202, 209, 211, 216, 218, 228, 230, 237, 239, 244, 246, 253, 255] := by decide +kernel
  have hg : generatorIndices 5 = [2, 9, 16, 37, 128] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_05 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 5) : q ∈ factors 5 :=
  closure_sound productCode product_checks 5 closureData closure_checked q hq

