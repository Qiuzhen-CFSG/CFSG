/-!
# Factor closure and Sylow covers for pattern 10

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 10 closureData g k = true := by
  have hf : factorIndices 10 = [0, 11, 16, 27, 37, 46, 53, 62, 65, 74, 81, 90, 100, 111, 116, 127, 128, 139, 144, 155, 165, 174, 181, 190, 193, 202, 209, 218, 228, 239, 244, 255, 513, 522, 529, 538, 548, 559, 564, 575, 576, 587, 592, 603, 613, 622, 629, 638, 641, 650, 657, 666, 676, 687, 692, 703, 704, 715, 720, 731, 741, 750, 757, 766] := by decide +kernel
  have hg : generatorIndices 10 = [11, 16, 37, 128, 513] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_10 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 10) : q ∈ factors 10 :=
  closure_sound productCode product_checks 10 closureData closure_checked q hq

