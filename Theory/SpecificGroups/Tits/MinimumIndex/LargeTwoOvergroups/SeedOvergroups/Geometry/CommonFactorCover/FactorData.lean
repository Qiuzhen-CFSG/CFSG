/-- A bounded check of one descent identity, including every lookup condition. -/
def factorStepTest (t : Fin 18) (r : FactorStep) : Bool :=
  r.1 == 0 || (decide (r.2.1.val < r.1.val) &&
    decide (r.2.1 ∈ factorIndices t) && decide (r.2.2 ∈ generatorIndices t) &&
    sameBase (fastNormalForm r.1) (fastNormalForm r.2.2 * fastNormalForm r.2.1))

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover
