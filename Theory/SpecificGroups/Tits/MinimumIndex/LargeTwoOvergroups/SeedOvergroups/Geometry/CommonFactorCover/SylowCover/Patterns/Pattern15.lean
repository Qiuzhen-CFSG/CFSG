/-!
# Factor closure and Sylow covers for pattern 15

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 15 closureData g k = true := by
  have hf : factorIndices 15 = [0, 16, 37, 62, 65, 81, 100, 127, 139, 155, 174, 181, 202, 218, 239, 244, 260, 287, 288, 304, 325, 350, 353, 369, 399, 404, 427, 443, 462, 469, 490, 506, 513, 529, 548, 575, 576, 592, 613, 638, 641, 657, 676, 703, 704, 720, 741, 766, 780, 791, 803, 819, 845, 854, 866, 882, 908, 919, 931, 947, 973, 982, 994, 1010] := by decide +kernel
  have hg : generatorIndices 15 = [16, 37, 139, 260] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_15 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 15) : q ∈ factors 15 :=
  closure_sound productCode product_checks 15 closureData closure_checked q hq

