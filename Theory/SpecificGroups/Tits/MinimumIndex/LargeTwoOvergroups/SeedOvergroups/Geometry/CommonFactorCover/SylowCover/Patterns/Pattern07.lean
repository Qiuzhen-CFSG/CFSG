  have hr : sylowRepresentatives 7 1 = ![0, 1, 4, 5, 256, 257, 260, 261, 512, 513, 516, 517, 768, 769, 772, 773, 1024, 1025, 1028, 1029, 1280, 1281, 1284, 1285, 1536, 1537, 1540, 1541, 1792, 1793, 1796, 1797] := by
    funext k
    revert k
    apply Atlas1600OrderCertificate.allFin
