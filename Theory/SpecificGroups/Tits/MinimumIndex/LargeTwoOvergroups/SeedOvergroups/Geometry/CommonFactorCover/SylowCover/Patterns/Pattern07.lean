private theorem covered_01 (n : Fin 2048) :
    Covered 7 1 (conjugate 1 (atlas1600SylowTwoNormalForm n)) := by
  apply all_covered 7 1 (by decide +kernel)
  exact fun a g => row_sound productCode conjCode product_checks conj_checks
    7 1 rowData01 a g (row_checked_01 a g)

