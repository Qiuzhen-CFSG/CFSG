/-!
# Factor closure and Sylow covers for pattern 7

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 7 closureData g k = true := by
  have hf : factorIndices 7 = [0, 2, 9, 11, 16, 18, 25, 27, 65, 67, 72, 74, 81, 83, 88, 90, 128, 130, 137, 139, 144, 146, 153, 155, 193, 195, 200, 202, 209, 211, 216, 218, 513, 515, 520, 522, 529, 531, 536, 538, 576, 578, 585, 587, 592, 594, 601, 603, 641, 643, 648, 650, 657, 659, 664, 666, 704, 706, 713, 715, 720, 722, 729, 731] := by decide +kernel
  have hg : generatorIndices 7 = [2, 9, 16, 65, 128, 513] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_07 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 7) : q ∈ factors 7 :=
  closure_sound productCode product_checks 7 closureData closure_checked q hq

