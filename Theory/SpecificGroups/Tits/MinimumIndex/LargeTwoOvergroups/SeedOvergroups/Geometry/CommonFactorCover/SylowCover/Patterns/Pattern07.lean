theorem sylow_covered_07 (j : Fin 38) (hj : j ∈ placePattern 7) (n : Fin 2048) :
    Covered 7 j (conjugate j (atlas1600SylowTwoNormalForm n)) := by
  have he : placePattern 7 = [1, 3, 17, 18, 20, 21, 0, 22] := by decide +kernel
  rw [he] at hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact covered_01 n
  · exact covered_03 n
  · exact covered_17 n
  · exact covered_18 n
  · exact covered_20 n
  · exact covered_21 n
  · exact covered_00 n
  · exact covered_22 n

