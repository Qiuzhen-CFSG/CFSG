theorem sylow_covered_02 (j : Fin 38) (hj : j ∈ placePattern 2) (n : Fin 2048) :
    Covered 2 j (conjugate j (atlas1600SylowTwoNormalForm n)) := by
  have he : placePattern 2 = [0, 3, 17, 19, 23, 25, 1, 26] := by decide +kernel
  rw [he] at hj
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
  rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact covered_00 n
  · exact covered_03 n
  · exact covered_17 n
  · exact covered_19 n
  · exact covered_23 n
  · exact covered_25 n
  · exact covered_01 n
  · exact covered_26 n

