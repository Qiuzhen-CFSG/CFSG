/-!
# Factor closure and Sylow covers for pattern 8

Reference checks connect the shared equalities to the unchanged generator,
factor and representative lists. They preserve the left factor convention;
the structural induction in `Basic` supplies every normal form.

Source: Parrott (1972), §5, p.683; the original seed and place witnesses.
These certificates are generated by `source/generate.py`.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.CommonFactorCover.SylowCover

set_option Elab.async false

private def closureData : Nat := 

private theorem closure_checked : ∀ g k, closureTest productCode 8 closureData g k = true := by
  have hf : factorIndices 8 = [0, 2, 9, 11, 16, 18, 25, 27, 65, 67, 72, 74, 81, 83, 88, 90, 128, 130, 137, 139, 144, 146, 153, 155, 193, 195, 200, 202, 209, 211, 216, 218, 1797, 1799, 1804, 1806, 1813, 1815, 1820, 1822, 1860, 1862, 1869, 1871, 1876, 1878, 1885, 1887, 1925, 1927, 1932, 1934, 1941, 1943, 1948, 1950, 1988, 1990, 1997, 1999, 2004, 2006, 2013, 2015] := by decide +kernel
  have hg : generatorIndices 8 = [2, 9, 16, 65, 128, 1797] := by decide +kernel
  simp only [closureTest, generatorAt, factorAt, hf, hg]
  apply Atlas1600OrderCertificate.allFin₂
  decide +kernel

theorem factor_closed_08 (q : Atlas1600Group) (hq : q ∈ factorSubgroup 8) : q ∈ factors 8 :=
  closure_sound productCode product_checks 8 closureData closure_checked q hq

