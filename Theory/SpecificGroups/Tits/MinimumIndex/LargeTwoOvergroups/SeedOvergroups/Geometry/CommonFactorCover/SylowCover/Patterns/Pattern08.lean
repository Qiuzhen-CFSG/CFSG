private theorem covered_17 (n : Fin 2048) :
    Covered 8 17 (conjugate 17 (atlas1600SylowTwoNormalForm n)) := by
  apply all_covered 8 17 (by decide +kernel)
  exact fun a g => row_sound productCode conjCode product_checks conj_checks
    8 17 rowData17 a g (row_checked_17 a g)

