module

public import Theory.SpecificGroups.Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.FiniteCover

/-!
# Common-factor witnesses for the eighteen place geometries

The rows encode literal conjugates of Sylow normal forms times rotations.
The code j + 38 * (n + 2048 * e) means place j, normal form n, exponent e.
The second entry is a candidate membership mask, with bit j referring to
place j. Only bits in the current pattern are intended to be used.

These are witness definitions, not coverage or membership theorems. The
factor lists need no subgroup or order certification. Their original data
and derivation are in ../source/geometry-representatives.json, ../../source/
seeds.json, and Geometry/source/emit_data.py. Multiplication acts on the left.
Source: Parrott (1972), section 5, p.683.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry

/-- A compact word code and its proposed place-membership mask. -/
abbrev Row := Nat × Nat

/-- Decode the literal conjugate represented by a row. -/
def rowElement (r : Row) : Atlas1600Group :=
  let j : Fin 38 := ⟨r.1 % 38, Nat.mod_lt _ (by decide)⟩
  let n : Fin 2048 := ⟨r.1 / 38 % 2048, Nat.mod_lt _ (by decide)⟩
  let rotation := if j.val < 17 then
    atlas1600ParrottAssignment .s1 * atlas1600ParrottAssignment .r1
    else atlas1600ParrottAssignment .s8 * atlas1600ParrottAssignment .r8
  let w := placeConjugator j
  w * (atlas1600SylowTwoNormalForm n * rotation ^ (r.1 / (38 * 2048))) * w⁻¹

/-- Read one candidate support bit. -/
def rowMember (r : Row) (j : Fin 38) : Bool := r.2.testBit j.val

