module

public import Theory.SpecificGroups.Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry.Evaluation
public import Theory.SpecificGroups.Tits.RelativeParabolicNormalizers.FirstCentralizer
public import Theory.SpecificGroups.Tits.RelativeParabolicNormalizers.SecondNormalizer
public import Theory.SpecificGroups.Tits.ConverseLocalCoverage.DoubleCosetCover.Base

/-!
# Exactness of the executable place tests

The first parabolic is the full centralizer of r5. The second is the
normalizer of the four-group generated by r5 and s1*s2*s3². Conjugation
preserves its cardinality, so testing the images of its two generators
suffices. The certified three-point base turns the point tests into actual
group equalities. Inverse conjugation matches the literal map in `place`.
Source: Parrott (1972), pp.672,683–684, and the intrinsic normalizer proofs.
-/

@[expose] public section
namespace Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry
open Subgroup ExceptionalParabolics RelativeParabolicNormalizers
open ConverseLocalCoverage.DoubleCosetCertificate

private theorem val_mul (x y : Atlas1600Group) : (x * y).val = x.val * y.val := rfl
private theorem val_inv (x : Atlas1600Group) : x⁻¹.val = x.val⁻¹ := rfl
private theorem val_pow (x : Atlas1600Group) (n : Nat) : (x ^ n).val = x.val ^ n := rfl

theorem centralPerm_eq : centralPerm = atlas1600R5.val := by
  simp only [centralPerm, fastAssignment_eq, atlas1600R5_eq, val_mul, val_pow]

theorem matePerm_eq : matePerm = secondCenterMate.val := by
  simp only [matePerm, fastAssignment_eq, secondCenterMate, val_mul, val_pow]

/-- Three comparisons give equality for elements of the literal Atlas group. -/
theorem sameBase_iff (a b : Atlas1600Group) :
    sameBase a.val b.val = true ↔ a = b := by
  simp only [sameBase, Bool.and_eq_true, beq_iff_eq]
  constructor
  · rintro ⟨⟨h0, h1⟩, h2⟩
    exact threePoint_ext h0 h1 h2
  · rintro rfl
    exact ⟨⟨rfl, rfl⟩, rfl⟩

private theorem centerImageTest_iff (g z : Atlas1600Group) :
    centerImageTest g.val z.val = true ↔ g * z * g⁻¹ ∈ secondCenter := by
  have hid : sameBase (g.val * z.val) g.val = true ↔ g * z * g⁻¹ = 1 := by
    change sameBase (g * z).val g.val = true ↔ _
    rw [sameBase_iff, mul_inv_eq_iff_eq_mul, one_mul]
  have he (a : Atlas1600Group) :
      sameBase (g.val * z.val) (a.val * g.val) = true ↔ g * z * g⁻¹ = a := by
    change sameBase (g * z).val (a * g).val = true ↔ _
    rw [sameBase_iff, mul_inv_eq_iff_eq_mul]
  simp only [centerImageTest, Bool.or_eq_true, centralPerm_eq, matePerm_eq]
  rw [hid, he atlas1600R5, he secondCenterMate,
    ← val_mul atlas1600R5 secondCenterMate, he (atlas1600R5 * secondCenterMate),
    mem_secondCenter_iff]
  tauto

private theorem normalizer_iff_images (g : Atlas1600Group) :
    g ∈ normalizer (secondCenter : Set Atlas1600Group) ↔
      g * atlas1600R5 * g⁻¹ ∈ secondCenter ∧
      g * secondCenterMate * g⁻¹ ∈ secondCenter := by
  have hx : atlas1600R5 ∈ secondCenter := mem_sup_left (mem_zpowers _)
  have hy : secondCenterMate ∈ secondCenter := mem_sup_right (mem_zpowers _)
  constructor
  · intro hg
    have h (a : Atlas1600Group) (ha : a ∈ secondCenter) :
        g * a * g⁻¹ ∈ secondCenter := by
      rw [← mem_normalizer_iff_map_conj_eq.mp hg]
      exact mem_map_of_mem (MulAut.conj g).toMonoidHom ha
    exact ⟨h _ hx, h _ hy⟩
  · rintro ⟨hgx, hgy⟩
    apply mem_normalizer_iff_map_conj_eq.mpr
    apply eq_of_le_of_card_ge
    · rw [secondCenter, Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]
      exact sup_le (zpowers_le.mpr hgx) (zpowers_le.mpr hgy)
    · rw [card_map_of_injective (MulAut.conj g).injective]

private theorem mem_place_iff (g : Atlas1600Group) (j : Fin 38) :
    g ∈ place j ↔
      (placeConjugator j)⁻¹ * g * placeConjugator j ∈ placeBase j := by
  constructor
  · rintro ⟨a, ha, rfl⟩
    change (placeConjugator j)⁻¹ *
      (placeConjugator j * a * (placeConjugator j)⁻¹) * placeConjugator j ∈ placeBase j
    have he : (placeConjugator j)⁻¹ *
        (placeConjugator j * a * (placeConjugator j)⁻¹) * placeConjugator j = a := by group
    rw [he]
    exact ha
  · intro h
    refine ⟨(placeConjugator j)⁻¹ * g * placeConjugator j, h, ?_⟩
    change placeConjugator j * ((placeConjugator j)⁻¹ * g * placeConjugator j) *
      (placeConjugator j)⁻¹ = g
    group

/-- The computational test is equivalent to membership in the literal place. -/
theorem placeTest_iff (g : Atlas1600Group) (j : Fin 38) :
    placeTest g.val j = true ↔ g ∈ place j := by
  rw [mem_place_iff]
  let a := (placeConjugator j)⁻¹ * g * placeConjugator j
  have he : (fastConjugator j)⁻¹ * g.val * fastConjugator j = a.val := by
    simp only [a, fastConjugator_eq, val_mul, val_inv]
  simp only [placeTest, he, placeBase]
  split_ifs with hj
  · rw [first_eq_centralizer, mem_centralizer_singleton_iff, centralPerm_eq]
    exact sameBase_iff (a * atlas1600R5) (atlas1600R5 * a)
  · rw [Bool.and_eq_true, centralPerm_eq, matePerm_eq, centerImageTest_iff,
      centerImageTest_iff, second_eq_normalizer_secondCenter first_eq_centralizer]
    exact (normalizer_iff_images a).symm

end Tits.MinimumIndex.LargeTwoOvergroups.SeedOvergroups.Geometry
