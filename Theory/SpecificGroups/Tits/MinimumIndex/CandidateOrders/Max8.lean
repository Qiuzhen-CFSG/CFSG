module

public import Theory.SpecificGroups.Tits.MinimumIndex.CandidateOrders.Max8.Checked
public import Mathlib.Algebra.Group.Subgroup.Finite

/-!
# Order bound for the literal ATLAS max8 candidate

The packed generators are checked against the actual final SLP registers of
`max8Generators`. The generated subgroup then embeds into the word subgroup
bounded by the finite-map certificate. Thus this is a bound for the literal
subgroup of `Atlas1600Group`, with no abstract identification assumption.
Source: primary ATLAS program `MinimumIndex/source/TF42G1-max8W1`.
-/

namespace Tits.MinimumIndexCandidates
open Theory.GroupTheory Atlas1600OrderCertificate OrderCertificate.Max8
set_option maxRecDepth 20000
set_option Elab.async false

private def inclusion : Atlas1600Group →* Equiv.Perm (Fin 1600) where
  toFun g := g.val
  map_one' := rfl
  map_mul' _ _ := rfl

private theorem inclusion_injective : Function.Injective inclusion :=
  fun _ _ h => Subtype.ext h

private def packedWords : Equiv.Perm (Fin 1600) × Equiv.Perm (Fin 1600) :=
  let a := Tits.Atlas1600OrderCertificate.L0G0
  let b := Tits.Atlas1600OrderCertificate.L0G1
  let w0 := a * b
  let w1 := w0 * b
  let w2 := w0 * w1
  let w3 := w2 * w2
  let w4 := w2 * w3
  let w5 := w4⁻¹
  let w6 := w5 * b
  let w7 := w6 * w4
  (a, w7)

private theorem generator0 : OrderCertificate.Max8.L0Gen 0 =
    max8Generators.1.val := by
  have h : OrderCertificate.Max8.L0Gen 0 = packedWords.1 := by
    apply Equiv.ext
    apply allFin
    decide +kernel
  rw [h, packedWords, L0G0_eq_atlas, L0G1_eq_atlas]
  rfl

private theorem generator1 : OrderCertificate.Max8.L0Gen 1 =
    max8Generators.2.val := by
  have h : OrderCertificate.Max8.L0Gen 1 = packedWords.2 := by
    apply Equiv.ext
    apply allFin
    decide +kernel
  rw [h, packedWords, L0G0_eq_atlas, L0G1_eq_atlas]
  rfl

/-- Kernel-certified upper bound for the subgroup generated by ATLAS max8. -/
public theorem max8_card_le : Nat.card max8 ≤ 1200 := by
  have hmap : max8.map inclusion ≤ OrderCertificate.Max8.L0H := by
    rw [max8, MonoidHom.map_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨g, hg, rfl⟩
    rcases hg with rfl | hg
    · change max8Generators.1.val ∈ _
      rw [← generator0]
      exact ⟨[0], by simp only [evalWord, mul_one]⟩
    · have hg' : g = max8Generators.2 := hg
      subst g
      change max8Generators.2.val ∈ _
      rw [← generator1]
      exact ⟨[1], by simp only [evalWord, mul_one]⟩
  have hc := Subgroup.card_le_of_le hmap
  rw [Subgroup.card_map_of_injective inclusion_injective] at hc
  exact hc.trans OrderCertificate.Max8.card_bound

end Tits.MinimumIndexCandidates
