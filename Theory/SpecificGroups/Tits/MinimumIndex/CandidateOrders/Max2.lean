module

public import Theory.SpecificGroups.Tits.MinimumIndex.CandidateOrders.Max2.Checked
public import Mathlib.Algebra.Group.Subgroup.Finite

/-!
# Order bound for the literal ATLAS max2 candidate

The packed generators are checked against the actual final SLP registers of
`max2Generators`. The generated subgroup then embeds into the word subgroup
bounded by the finite-map certificate. Thus this is a bound for the literal
subgroup of `Atlas1600Group`, with no abstract identification assumption.
Source: primary ATLAS program `MinimumIndex/source/TF42G1-max2W1`.
-/

namespace Tits.MinimumIndexCandidates
open Theory.GroupTheory Atlas1600OrderCertificate OrderCertificate.Max2
set_option maxRecDepth 20000
set_option Elab.async false

private def inclusion : Atlas1600Group →* Equiv.Perm (Fin 1600) where
  toFun g := g.val
  map_one' := rfl
  map_mul' _ _ := rfl

private theorem inclusion_injective : Function.Injective inclusion :=
  fun _ _ h => Subtype.ext h

private def packedWords : Equiv.Perm (Fin 1600) × Equiv.Perm (Fin 1600) :=
  let a := Tits.Atlas1600OrderCertificate.L0G0
  let b := Tits.Atlas1600OrderCertificate.L0G1
  let w0 := a * b
  let w1 := b * w0
  let w2 := w1 * a
  let w3 := w2⁻¹
  let w4 := a * w1
  let w5 := w3 * w4
  let w6 := w5 * w5
  let w7 := w0 * b
  let w8 := w0 * w7
  let w9 := w0 * w8
  let w10 := w9 ^ 3
  let w11 := w7 ^ 6
  let w12 := w11⁻¹
  let w13 := w12 * w10
  let w14 := w13 * w11
  let w15 := w0 ^ 2
  let w16 := w15⁻¹
  let w17 := w16 * w6
  let w18 := w17 * w15
  (w18, w14)

private theorem generator0 : OrderCertificate.Max2.L0Gen 0 =
    max2Generators.1.val := by
  have h : OrderCertificate.Max2.L0Gen 0 = packedWords.1 := by
    apply Equiv.ext
    apply allFin
    decide +kernel
  rw [h, packedWords, L0G0_eq_atlas, L0G1_eq_atlas]
  rfl

private theorem generator1 : OrderCertificate.Max2.L0Gen 1 =
    max2Generators.2.val := by
  have h : OrderCertificate.Max2.L0Gen 1 = packedWords.2 := by
    apply Equiv.ext
    apply allFin
    decide +kernel
  rw [h, packedWords, L0G0_eq_atlas, L0G1_eq_atlas]
  rfl

/-- Kernel-certified upper bound for the subgroup generated by ATLAS max2. -/
public theorem max2_card_le : Nat.card max2 ≤ 11232 := by
  have hmap : max2.map inclusion ≤ OrderCertificate.Max2.L0H := by
    rw [max2, MonoidHom.map_closure]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨g, hg, rfl⟩
    rcases hg with rfl | hg
    · change max2Generators.1.val ∈ _
      rw [← generator0]
      exact ⟨[0], by simp only [evalWord, mul_one]⟩
    · have hg' : g = max2Generators.2 := hg
      subst g
      change max2Generators.2.val ∈ _
      rw [← generator1]
      exact ⟨[1], by simp only [evalWord, mul_one]⟩
  have hc := Subgroup.card_le_of_le hmap
  rw [Subgroup.card_map_of_injective inclusion_injective] at hc
  exact hc.trans OrderCertificate.Max2.card_bound

end Tits.MinimumIndexCandidates
