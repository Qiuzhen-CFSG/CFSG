module

public import Theory.SpecificGroups.Tits.MinimumIndex.Candidates
public import Theory.SpecificGroups.Tits.Atlas1600OrderData
public import Theory.SpecificGroups.Tits.Atlas1600Action
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Data.ZMod.QuotientGroup

/-!
# The marked thirteen-subgroup and candidate derived subgroups

The standard product `ab` has order thirteen and fixes exactly point zero in
the actual degree-1600 permutation model. Both assertions are checked using
the existing packed permutation tables. Its cyclic subgroup's normalizer
therefore fixes zero as well.

The three candidate derived subgroups below are literal ambient commutator
subgroups of the shared ATLAS candidates. These definitions assert neither
abstract identifications nor exhaustive overgroup coverage. They give a
common interface for generation by two cyclic thirteen-subgroups and the
independent proper-overgroup rigidity certificates.

Source: the standard generators and maximal-subgroup programs in the primary
ATLAS Tits entry, https://brauer.maths.qmul.ac.uk/Atlas/exc/TF42/.
Unmodified programs and attribution are in `MinimumIndex/source/`.
-/

namespace Tits.MinimumIndexThirteen
open Subgroup

/-- The product of the two actual standard ATLAS generators. -/
@[expose] public def generator : Atlas1600Group :=
  let a : Atlas1600Group := ⟨atlas1600A, atlas1600A_mem⟩
  let b : Atlas1600Group := ⟨atlas1600B, atlas1600B_mem⟩
  a * b

/-- The marked cyclic subgroup generated by `ab`. -/
@[expose] public def thirteenSubgroup : Subgroup Atlas1600Group := zpowers generator

/-- Its normalizer in the actual ATLAS carrier. -/
@[expose] public def thirteenNormalizer : Subgroup Atlas1600Group :=
  Subgroup.normalizer (thirteenSubgroup : Set Atlas1600Group)

/-- Indices zero, one and two refer to the exact max1, max2 and max4 programs. -/
@[expose] public def candidate (i : Fin 3) : Subgroup Atlas1600Group :=
  ![MinimumIndexCandidates.max1, MinimumIndexCandidates.max2, MinimumIndexCandidates.max4] i

/-- The derived subgroup of the selected candidate, as an ambient subgroup. -/
@[expose] public def candidateDerived (i : Fin 3) : Subgroup Atlas1600Group :=
  ⁅candidate i, candidate i⁆

/-- The subgroup generated by the marked cyclic subgroup and its conjugate.
Lean uses left conjugation: `x * y * x⁻¹`. -/
@[expose] public def pairSubgroup (x : Atlas1600Group) : Subgroup Atlas1600Group :=
  thirteenSubgroup ⊔ thirteenSubgroup.map (MulAut.conj x).toMonoidHom

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
private theorem generator_pow_thirteen : generator ^ 13 = 1 := by
  apply Subtype.ext
  change (atlas1600A * atlas1600B) ^ 13 = 1
  rw [← Atlas1600OrderCertificate.L0G0_eq_atlas, ← Atlas1600OrderCertificate.L0G1_eq_atlas]
  apply Equiv.ext
  apply Atlas1600OrderCertificate.allFin
  decide +kernel

private theorem generator_ne_one : generator ≠ 1 := by
  intro h
  have hh := congrArg (fun g : Atlas1600Group => g.val (1 : Fin 1600)) h
  change (atlas1600A * atlas1600B) 1 = 1 at hh
  have hn : (atlas1600A * atlas1600B) 1 ≠ 1 := by decide +kernel
  exact hn hh

/-- The marked ATLAS product has order exactly thirteen. -/
public theorem generator_order : orderOf generator = 13 := by
  let : Fact (Nat.Prime 13) := ⟨by decide⟩
  exact orderOf_eq_prime generator_pow_thirteen generator_ne_one

/-- The marked cyclic subgroup has the full thirteen-part of the group order. -/
public theorem thirteenSubgroup_card : Nat.card thirteenSubgroup = 13 :=
  (Nat.card_zpowers generator).trans generator_order

set_option maxRecDepth 20000 in
/-- The marked generator has the unique fixed point zero. -/
public theorem generator_fixed_iff (x : Fin 1600) : generator.val x = x ↔ x = 0 := by
  change (atlas1600A * atlas1600B) x = x ↔ x = 0
  rw [← Atlas1600OrderCertificate.L0G0_eq_atlas, ← Atlas1600OrderCertificate.L0G1_eq_atlas]
  revert x
  apply Atlas1600OrderCertificate.allFin
  decide +kernel

/-- Normalizing the marked cyclic subgroup forces fixation of point zero. -/
public theorem normalizer_fixes_zero (g : Atlas1600Group)
    (hg : g ∈ thirteenNormalizer) : g.val 0 = 0 := by
  have hP : thirteenSubgroup ≤ MulAction.stabilizer Atlas1600Group (0 : Fin 1600) := by
    apply Subgroup.zpowers_le.mpr
    exact (generator_fixed_iff 0).mpr rfl
  have hginv := thirteenNormalizer.inv_mem hg
  have hz : g⁻¹ * generator * g ∈ thirteenSubgroup := by
    simpa only [inv_inv] using
      (Subgroup.mem_normalizer_iff.mp hginv generator).mp (Subgroup.mem_zpowers generator)
  have hf : (g⁻¹ * generator * g) • (0 : Fin 1600) = 0 := hP hz
  have he := congrArg (fun x : Fin 1600 => g • x) hf
  simp only [mul_smul, smul_inv_smul] at he
  have hh : generator.val (g.val 0) = g.val 0 := by
    simpa only [atlas1600_smul] using he
  exact (generator_fixed_iff _).mp hh

end Tits.MinimumIndexThirteen
