module

public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.Seeds
public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.PairGeneration.Coverage
public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.PairGeneration.ExceptionalGeneration
public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.PairGeneration.GenericGeneration
public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.PairGeneration.SeedChecks
public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.PairGeneration.Transport

/-!
# Generation by two distinct cyclic thirteen-subgroups

The subgroup generated by the marked cyclic thirteen-subgroup and any distinct
conjugate contains a conjugate of one of the literal max1, max2 or max4 derived
subgroups. Normalizer double-coset transport reduces this to the fixed 3010
representatives. The identity representative is excluded by distinctness;
the other representatives are covered by the checked whole-group generation
and exceptional candidate-derived containment certificates.

`Tits.MinimumIndexThirteen.pair_generation` discharges the exact generation
premise of thirteen-overgroup coverage without additional certificate inputs.
The conditional reductions are retained below for their existing consumers.

Source: the primary ATLAS Tits entry and actual candidate words in
`MinimumIndex/source/`. The fixed candidate representatives and their
untrusted discovery programs are in `PairGeneration/source/`.
-/

namespace Tits.MinimumIndexThirteen.PairGeneration

/-- The two finite certificates imply generation for every distinct pair of
cyclic thirteen-subgroups, with the exact published candidate derived subgroups. -/
public theorem generation_of_certificates
    (hcover : ∀ x : Atlas1600Group, ∃ (a b : thirteenNormalizer) (k : Fin 3010),
      x = a.val * representative k * b.val)
    (hrep : ∀ k : Fin 3010, representative k ∈ thirteenNormalizer ∨
      ∃ (i : Fin 3) (g : Atlas1600Group),
        candidateDerived i ≤ (pairSubgroup (representative k)).map
          (MulAut.conj g).toMonoidHom)
    (x : Atlas1600Group) (hx : x ∉ thirteenNormalizer) :
    ∃ (i : Fin 3) (g : Atlas1600Group),
      candidateDerived i ≤ (pairSubgroup x).map (MulAut.conj g).toMonoidHom :=
  generation_of_doubleCoset_cover representative hcover hrep x hx


/-- Separate the finite generation input into whole-group recoveries and the
27 candidate exceptional cases. Coverage is independent of both inputs. -/
public theorem generation_of_three_certificates
    (hcover : ∀ x : Atlas1600Group, ∃ (a b : thirteenNormalizer) (k : Fin 3010),
      x = a.val * representative k * b.val)
    (hgeneric : ∀ k : Fin 3010, k ≠ 0 → k ∉ exceptionalIndices →
      pairSubgroup (representative k) = ⊤)
    (hexception : ∀ k : Fin 3010, k ∈ exceptionalIndices →
      ∃ (i : Fin 3) (g : Atlas1600Group),
        candidateDerived i ≤ (pairSubgroup (representative k)).map
          (MulAut.conj g).toMonoidHom)
    (x : Atlas1600Group) (hx : x ∉ thirteenNormalizer) :
    ∃ (i : Fin 3) (g : Atlas1600Group),
      candidateDerived i ≤ (pairSubgroup x).map (MulAut.conj g).toMonoidHom := by
  apply generation_of_certificates hcover ?_ x hx
  intro k
  by_cases hzero : k = 0
  · subst k
    exact Or.inl representative_zero_mem
  · by_cases he : k ∈ exceptionalIndices
    · exact Or.inr (hexception k he)
    · exact Or.inr (generation_of_pairSubgroup_eq_top (hgeneric k hzero he))

end Tits.MinimumIndexThirteen.PairGeneration

namespace Tits.MinimumIndexThirteen

/-- Two distinct conjugates of the marked cyclic thirteen-subgroup generate a
subgroup containing a conjugate of one of the literal candidate derived
subgroups. This supplies `hgenerate` in
`coverage_of_generation_and_rigidity`. -/
public theorem pair_generation (x : Atlas1600Group) (hx : x ∉ thirteenNormalizer) :
    ∃ (i : Fin 3) (g : Atlas1600Group),
      candidateDerived i ≤ (pairSubgroup x).map (MulAut.conj g).toMonoidHom :=
  PairGeneration.generation_of_three_certificates
    PairGeneration.normalizer_doubleCoset_cover
    PairGeneration.pairSubgroup_representative_eq_top
    PairGeneration.exceptional_generation x hx

end Tits.MinimumIndexThirteen
