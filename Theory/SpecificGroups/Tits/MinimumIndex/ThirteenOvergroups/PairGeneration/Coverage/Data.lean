@[expose] public def pointOrbit (p : Fin 1600) : Fin 32 :=
  ⟨pointEntry p % 32, Nat.mod_lt _ (by decide)⟩

@[expose] public def pointNormal (p : Fin 1600) : Fin 78 :=
  ⟨pointEntry p / 32 % 78, Nat.mod_lt _ (by decide)⟩

@[expose] public def transitionEntry (i : Fin 6) (j : Fin 144) : Nat :=
  (transitionRow i >>> (14 * j.val)) % 16384

@[expose] public def transitionRep (i : Fin 6) (j : Fin 144) : Fin 144 :=
  ⟨transitionEntry i j % 144, Nat.mod_lt _ (by decide)⟩

@[expose] public def transitionNormal (i : Fin 6) (j : Fin 144) : Fin 78 :=
  ⟨transitionEntry i j / 144 % 78, Nat.mod_lt _ (by decide)⟩

@[expose] public def factorEntry (i : Fin 32) (j : Fin 144) : Nat :=
  (factorRow i >>> (25 * j.val)) % 33554432

@[expose] public def factorLeft (i : Fin 32) (j : Fin 144) : Fin 78 :=
  ⟨factorEntry i j % 78, Nat.mod_lt _ (by decide)⟩

@[expose] public def factorRight (i : Fin 32) (j : Fin 144) : Fin 78 :=
  ⟨factorEntry i j / 78 % 78, Nat.mod_lt _ (by decide)⟩

@[expose] public def factorRep (i : Fin 32) (j : Fin 144) : Fin 3010 :=
  ⟨factorEntry i j / 6084 % 3010, Nat.mod_lt _ (by decide)⟩

/-- Equality at the certified permutation base. -/
@[expose] public def baseTest (x y : Equiv.Perm (Fin 1600)) : Bool :=
  (x 0 == y 0) && (x 1 == y 1) && (x 2 == y 2)

@[expose] public def pointTest (p : Fin 1600) : Bool :=
  fastNormalWord (pointNormal p) (fastWord (orbitCode (pointOrbit p)) 0) == p

@[expose] public def transitionTest (i : Fin 6) (j : Fin 144) : Bool :=
  baseTest (L1Gen i * fastStabilizerRep j)
    (fastStabilizerRep (transitionRep i j) * fastNormalWord (transitionNormal i j))

@[expose] public def factorTest (i : Fin 32) (j : Fin 144) : Bool :=
  baseTest (fastWord (orbitCode i) * fastStabilizerRep j)
    (fastNormalWord (factorLeft i j) * fastWord (representativeCode (factorRep i j)) *
      fastNormalWord (factorRight i j))

end Tits.MinimumIndexThirteen.PairGeneration.CoverageCertificate
