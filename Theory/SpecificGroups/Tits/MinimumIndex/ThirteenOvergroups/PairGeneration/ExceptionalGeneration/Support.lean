module

public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.PairGeneration.Representatives
public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.CandidateRigidity.Words

/-!
# Recovering literal candidate derived subgroups from two elements

For the max1 and max2 programs, the first generator `x` is an involution.
The subgroup generated by `xy` and `yx` is normalized by both `x` and `y`,
and the quotient of the candidate by this subgroup is cyclic. Thus it contains
the candidate's derived subgroup. For max4, recovering its two original
generators is sufficient. No order or abstract group identification is used.

The finite word checker uses the certified three-point base of the actual
ATLAS degree-1600 group. The source programs are the unchanged
`MinimumIndex/source/TF42G1-max{1,2,4}W1`; attribution and reproducible witness
search are documented in `ExceptionalGeneration/source/README.md`.
-/

namespace Tits.MinimumIndexThirteen.PairGeneration.ExceptionalGeneration
open Subgroup
open scoped commutatorElement

/-- The derived subgroup of an involution-generated pair lies in its even-word subgroup. -/
private theorem even_pair {G : Type*} [Group G] (x y : G) (hx : x * x = 1) :
    ⁅closure ({x, y} : Set G), closure ({x, y} : Set G)⁆ ≤
      closure ({x * y, y * x} : Set G) := by
  let H := closure ({x, y} : Set G)
  let N := closure ({x * y, y * x} : Set G)
  have hxi : x⁻¹ = x := inv_eq_of_mul_eq_one_right hx
  have hxy : x * y ∈ N := subset_closure (by simp)
  have hyx : y * x ∈ N := subset_closure (by simp)
  have hxn : x ∈ normalizer N := by
    rw [mem_normalizer_iff_map_conj_eq]
    change (closure _).map _ = closure _
    rw [MonoidHom.map_closure]
    congr 1
    ext z
    simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨w, rfl | rfl, rfl⟩
      · exact Or.inr (by simp [hxi, ← mul_assoc, hx])
      · exact Or.inl (by simp [hxi, mul_assoc, hx])
    · rintro (rfl | rfl)
      · exact ⟨y * x, Or.inr rfl, by simp [hxi, mul_assoc, hx]⟩
      · exact ⟨x * y, Or.inl rfl, by simp [hxi, ← mul_assoc, hx]⟩
  have hyn : y ∈ normalizer N := by
    have : x⁻¹ * (x * y) ∈ normalizer (N : Set G) :=
      (normalizer (N : Set G)).mul_mem ((normalizer (N : Set G)).inv_mem hxn)
        (N.le_normalizer hxy)
    simpa using this
  have hHN : H ≤ normalizer N := by
    apply (closure_le _).mpr
    intro z hz
    rcases hz with rfl | rfl
    · exact hxn
    · exact hyn
  let : (N.subgroupOf H).Normal := normal_subgroupOf_of_le_normalizer hHN
  let xH : H := ⟨x, subset_closure (by simp)⟩
  let C := zpowers xH
  have hsup : N.subgroupOf H ⊔ C = ⊤ := by
    apply (map_injective H.subtype_injective)
    rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, H.range_subtype]
    apply le_antisymm
    · exact sup_le (map_subtype_le _) (map_subtype_le _)
    · apply (closure_le _).mpr
      intro z hz
      have hxC : x ∈ C.map H.subtype := ⟨xH, mem_zpowers xH, rfl⟩
      rcases hz with rfl | hz
      · exact mem_sup_right hxC
      · have hz' : z = y := hz
        subst z
        have hxyH : x * y ∈ H := H.mul_mem (subset_closure (by simp))
          (subset_closure (by simp))
        have hm : x * y ∈ (N.subgroupOf H).map H.subtype := ⟨⟨x*y,hxyH⟩,hxy,rfl⟩
        simpa using ((N.subgroupOf H).map H.subtype ⊔ C.map H.subtype).mul_mem
          (inv_mem (mem_sup_right hxC)) (mem_sup_left hm)
  have hcomm : _root_.commutator H ≤ N.subgroupOf H :=
    Subgroup.Normal.commutator_le_of_self_sup_commutative_eq_top hsup inferInstance
  rw [← H.map_subtype_commutator]
  exact (map_mono hcomm).trans (by intro z hz; obtain ⟨w, hw, rfl⟩ := hz; exact hw)

open Atlas1600OrderCertificate CandidateRigidity
open ConverseLocalCoverage.DoubleCosetCertificate

@[expose] public def target (i : Fin 3) (b : Bool) : Atlas1600Group :=
  let p := candidatePair i
  if i = 2 then (if b then p.2 else p.1)
  else (if b then p.2 * p.1 else p.1 * p.2)

@[expose] public def packedTarget (i : Fin 3) (b : Bool) : Equiv.Perm (Fin 1600) :=
  let p := program L0G0 L0G1 i
  if i = 2 then (if b then p.2 else p.1)
  else (if b then p.2 * p.1 else p.1 * p.2)

public theorem packedTarget_eq (i : Fin 3) (b : Bool) :
    packedTarget i b = (target i b).val := by
  unfold packedTarget target
  rw [packed_pair]
  fin_cases i <;> cases b <;> rfl

set_option maxRecDepth 20000 in
private theorem involution_table : ∀ (i : Fin 2) (p : Fin 3),
    ((program L0G0 L0G1 (i.castLE (by decide))).1 *
      (program L0G0 L0G1 (i.castLE (by decide))).1) (p.castLE (by decide)) =
        p.castLE (by decide) := by
  apply allFin₂
  decide +kernel

private theorem candidate_involution (i : Fin 2) :
    (candidatePair (i.castLE (by decide))).1 *
      (candidatePair (i.castLE (by decide))).1 = 1 := by
  have h (p : Fin 3) := involution_table i p
  simp only [packed_pair] at h
  exact threePoint_ext (h 0) (h 1) (h 2)

public theorem derived_le_targets (i : Fin 3) :
    candidateDerived i ≤ closure {target i false, target i true} := by
  fin_cases i
  · change ⁅candidate 0, candidate 0⁆ ≤
      closure {(candidatePair 0).1 * (candidatePair 0).2,
        (candidatePair 0).2 * (candidatePair 0).1}
    rw [candidate_eq_closure]
    exact even_pair _ _ (candidate_involution 0)
  · change ⁅candidate 1, candidate 1⁆ ≤
      closure {(candidatePair 1).1 * (candidatePair 1).2,
        (candidatePair 1).2 * (candidatePair 1).1}
    rw [candidate_eq_closure]
    exact even_pair _ _ (candidate_involution 1)
  · change ⁅candidate 2, candidate 2⁆ ≤ closure {(candidatePair 2).1, (candidatePair 2).2}
    rw [← candidate_eq_closure]
    exact commutator_le_self _

@[expose] public def recoveryTest (k : Fin 3010) (g : Nat) (i : Fin 3) (b : Bool)
    (w : List (Bool × Int)) : Bool :=
  let z := fastWord g * fastPairWord (representativeCode k) w * (fastWord g)⁻¹
  (z 0 == packedTarget i b 0) &&
  (z 1 == packedTarget i b 1) && (z 2 == packedTarget i b 2)

private theorem pairWord_map {G H : Type*} [Group G] [Group H]
    (f : G →* H) (u v : G) (w : List (Bool × Int)) :
    f (pairWord u v w) = pairWord (f u) (f v) w := by
  simp only [pairWord, map_list_prod, List.map_map]
  congr 1
  apply List.map_congr_left
  rintro ⟨b, n⟩ _
  cases b <;> exact map_zpow f _ _

private theorem fastPairWord_val (k : Fin 3010) (w : List (Bool × Int)) :
    fastPairWord (representativeCode k) w =
      (pairWord generator (MulAut.conj (representative k) generator) w).val := by
  let f : Atlas1600Group →* Equiv.Perm (Fin 1600) := atlas1600Subgroup.subtype
  change _ = f (pairWord _ _ w)
  rw [pairWord_map]
  simp only [fastPairWord, L0G0_eq_atlas, L0G1_eq_atlas, fastWord_eq]
  rfl

public theorem recoveryTest_sound (k : Fin 3010) (g : Nat) (i : Fin 3) (b : Bool)
    (w : List (Bool × Int)) (h : recoveryTest k g i b w = true) :
    target i b ∈ (pairSubgroup (representative k)).map
      (MulAut.conj (standardWord g)).toMonoidHom := by
  have he : MulAut.conj (standardWord g)
      (pairWord generator (MulAut.conj (representative k) generator) w) = target i b := by
    simp only [recoveryTest, Bool.and_eq_true, beq_iff_eq, fastWord_eq,
      fastPairWord_val, packedTarget_eq] at h
    exact threePoint_ext h.1.1 h.1.2 h.2
  exact he ▸ Subgroup.mem_map_of_mem _ (pairWord_mem _ w)

public theorem derived_le_map_of_recovery (k : Fin 3010) (g : Nat) (i : Fin 3)
    (wa wb : List (Bool × Int))
    (ha : recoveryTest k g i false wa = true)
    (hb : recoveryTest k g i true wb = true) :
    candidateDerived i ≤ (pairSubgroup (representative k)).map
      (MulAut.conj (standardWord g)).toMonoidHom := by
  apply (derived_le_targets i).trans
  apply (closure_le _).mpr
  intro z hz
  rcases hz with rfl | hz
  · exact recoveryTest_sound k g i false wa ha
  · have hz' : z = target i true := hz
    subst z
    exact recoveryTest_sound k g i true wb hb

end Tits.MinimumIndexThirteen.PairGeneration.ExceptionalGeneration
