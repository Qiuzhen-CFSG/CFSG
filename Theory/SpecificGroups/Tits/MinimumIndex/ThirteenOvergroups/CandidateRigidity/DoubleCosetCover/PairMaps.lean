module

public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.CandidateRigidity.DoubleCosetCover.PackedData

/-!
# Packed point maps of the literal core generators

The constants are candidate point maps obtained by evaluating the original
ATLAS max1 and max2 programs, with inverse point maps for the left action.
Every equality is checked on all 1600 points in the sibling checking module.
Source authors: R. A. Wilson, R. A. Parker and J. N. Bray; see
`MinimumIndex/source/README.md`. Discovery code is in `DoubleCosetCover/source/`.
-/

namespace Tits.MinimumIndexThirteen.CandidateRigidity.CoreCover
open Theory.GroupTheory Atlas1600OrderCertificate

set_option Elab.async false

@[expose] public def pairX0MapData : Nat := 
@[expose] public def pairX0Map (p : Fin 1600) : Fin 1600 :=
  ⟨(pairX0MapData >>> (11 * p.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

@[expose] public def pairX0InvMapData : Nat := 
@[expose] public def pairX0InvMap (p : Fin 1600) : Fin 1600 :=
  ⟨(pairX0InvMapData >>> (11 * p.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

private theorem pairX0_left : ∀ p, pairX0InvMap (pairX0Map p) = p := by
  apply allFin
  decide +kernel

@[expose] public def pairX0 : Equiv.Perm (Fin 1600) :=
  tablePerm pairX0Map pairX0InvMap (by exact pairX0_left)
    (by exact rightInverse_of_leftInverse_fin pairX0_left)

@[expose] public def pairX1MapData : Nat := 
@[expose] public def pairX1Map (p : Fin 1600) : Fin 1600 :=
  ⟨(pairX1MapData >>> (11 * p.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

@[expose] public def pairX1InvMapData : Nat := 
@[expose] public def pairX1InvMap (p : Fin 1600) : Fin 1600 :=
  ⟨(pairX1InvMapData >>> (11 * p.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

private theorem pairX1_left : ∀ p, pairX1InvMap (pairX1Map p) = p := by
  apply allFin
  decide +kernel

@[expose] public def pairX1 : Equiv.Perm (Fin 1600) :=
  tablePerm pairX1Map pairX1InvMap (by exact pairX1_left)
    (by exact rightInverse_of_leftInverse_fin pairX1_left)

@[expose] public def pairYMapData : Nat := 
@[expose] public def pairYMap (p : Fin 1600) : Fin 1600 :=
  ⟨(pairYMapData >>> (11 * p.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

@[expose] public def pairYInvMapData : Nat := 
@[expose] public def pairYInvMap (p : Fin 1600) : Fin 1600 :=
  ⟨(pairYInvMapData >>> (11 * p.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

private theorem pairY_left : ∀ p, pairYInvMap (pairYMap p) = p := by
  apply allFin
  decide +kernel

@[expose] public def pairY : Equiv.Perm (Fin 1600) :=
  tablePerm pairYMap pairYInvMap (by exact pairY_left)
    (by exact rightInverse_of_leftInverse_fin pairY_left)

set_option maxRecDepth 20000 in
public theorem pairX0_eq : pairX0 = (program L0G0 L0G1 0).1 := by
  apply Equiv.ext
  apply allFin
  decide +kernel

set_option maxRecDepth 20000 in
public theorem pairX1_eq : pairX1 = (program L0G0 L0G1 1).1 := by
  apply Equiv.ext
  apply allFin
  decide +kernel

set_option maxRecDepth 20000 in
public theorem pairY_eq : pairY = (program L0G0 L0G1 0).2 := by
  apply Equiv.ext
  apply allFin
  decide +kernel

end Tits.MinimumIndexThirteen.CandidateRigidity.CoreCover
