module

public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.CandidateRigidity.DoubleCosetCover.Checker

/-!
# Packed point maps of the literal core generators

The constants are candidate point maps obtained by evaluating the original
ATLAS max1 and max2 programs, with inverse point maps for the left action.
Every equality is checked on all 1600 points in the sibling checking module.
Source authors: R. A. Wilson, R. A. Parker and J. N. Bray; see
`MinimumIndex/source/README.md`. Discovery code is in `DoubleCosetCover/source/`.
-/

namespace Tits.MinimumIndexThirteen.CandidateRigidity.CoreCover
open Theory.GroupTheory Atlas1600OrderCertificate

@[expose] public def coreMapData00 : Nat := 

@[expose] public def coreMapData01 : Nat := 

@[expose] public def coreMapData02 : Nat := 

@[expose] public def coreMapData03 : Nat := 

@[expose] public def coreMapData04 : Nat := 

@[expose] public def coreMapData05 : Nat := 

@[expose] public def coreMapData10 : Nat := 

@[expose] public def coreMapData11 : Nat := 

@[expose] public def coreMapData12 : Nat := 

@[expose] public def coreMapData13 : Nat := 

@[expose] public def coreMapData14 : Nat := 

@[expose] public def coreMapData15 : Nat := 

@[expose] public def coreMapData (i : Fin 2) (k : Fin 6) : Nat :=
  ![![coreMapData00, coreMapData01, coreMapData02, coreMapData03, coreMapData04, coreMapData05],
    ![coreMapData10, coreMapData11, coreMapData12, coreMapData13, coreMapData14, coreMapData15]] i k

@[expose] public def coreMap (i : Fin 2) (k : Fin 6) (p : Fin 1600) : Fin 1600 :=
  ⟨(coreMapData i k >>> (11 * p.val)) % 2048 % 1600, Nat.mod_lt _ (by decide)⟩

@[expose] public def packedSignedCore (i : Fin 2) : Fin 6 → Equiv.Perm (Fin 1600) :=
  let c := seeds (program L0G0 L0G1 (i.castLE (by decide)))
  ![c 0, c 1, c 2, (c 0)⁻¹, (c 1)⁻¹, (c 2)⁻¹]

public theorem packedSignedCore_eq (i : Fin 2) (k : Fin 6) :
    packedSignedCore i k = (signedCore i k).val := by
  unfold packedSignedCore signedCore
  simp only [packed_seeds]
  fin_cases k <;> rfl

end Tits.MinimumIndexThirteen.CandidateRigidity.CoreCover
