module

public import Theory.SpecificGroups.Tits.MinimumIndex.ThirteenOvergroups.Seeds
import Mathlib.Tactic.FinCases

/-!
# Words for the candidate-derived rigidity certificates

For each literal ATLAS candidate, use the commutator of its two generators
and the conjugates of that commutator by those generators. Their generated
subgroup lies in the ambient derived subgroup. Six short candidate double-coset
representatives are provided for each of max1 and max2. This module does not
assert that those representatives cover the group.

The parametric word interpreter also permits efficient checking with the
certified packed standard generators, without changing multiplication order.
Source: the primary ATLAS Tits entry and the original programs and attribution
preserved in `MinimumIndex/source/`.
-/

namespace Tits.MinimumIndexThirteen.CandidateRigidity
open Theory.GroupTheory Subgroup Atlas1600OrderCertificate
open scoped commutatorElement

/-- The standard generators and their inverses, in word order. -/
@[expose] public def standard : Fin 4 → Atlas1600Group :=
  let a : Atlas1600Group := ⟨atlas1600A, atlas1600A_mem⟩
  let b : Atlas1600Group := ⟨atlas1600B, atlas1600B_mem⟩
  ![a, b, a⁻¹, b⁻¹]

/-- The three literal pairs of candidate generators. -/
@[expose] public def candidatePair (i : Fin 3) : Atlas1600Group × Atlas1600Group :=
  ![MinimumIndexCandidates.max1Generators, MinimumIndexCandidates.max2Generators,
    MinimumIndexCandidates.max4Generators] i

/-- The common prefix and the three final branches of the original ATLAS programs. -/
@[expose] public def program {G : Type*} [Group G] (a b : G) (i : Fin 3) : G × G :=
  let w0 := a * b
  let w1 := b * w0
  let w2 := w1 * a
  let w3 := w2⁻¹
  let w4 := a * w1
  let w5 := w3 * w4
  let w6 := w5 * w5
  let w7 := w0 * b
  let w8 := w0 * w7
  let w9 := w0 * w8
  let w10 := w9 ^ 3
  let y := (w7 ^ 6)⁻¹ * w10 * w7 ^ 6
  ![((w0 ^ 4)⁻¹ * w6 * w0 ^ 4, y),
    ((w0 ^ 2)⁻¹ * w6 * w0 ^ 2, y), (w6, w10)] i

public theorem candidate_eq_closure (i : Fin 3) :
    candidate i = closure {(candidatePair i).1, (candidatePair i).2} := by
  fin_cases i <;> rfl

public theorem candidatePair_mem (i : Fin 3) :
    (candidatePair i).1 ∈ candidate i ∧ (candidatePair i).2 ∈ candidate i := by
  rw [candidate_eq_closure]
  exact ⟨subset_closure (by simp), subset_closure (by simp)⟩

/-- A commutator and its two marked conjugates. -/
@[expose] public def seeds {G : Type*} [Group G] (p : G × G) : Fin 3 → G :=
  let c := ⁅p.1, p.2⁆
  ![c, p.1 * c * p.1⁻¹, p.2 * c * p.2⁻¹]

@[expose] public def coreGen (i : Fin 3) : Fin 3 → Atlas1600Group :=
  seeds (candidatePair i)

/-- The subgroup generated by the three explicit commutator words. -/
@[expose] public def core (i : Fin 3) : Subgroup Atlas1600Group :=
  closure (Set.range (coreGen i))

public theorem coreGen_mem_derived (i j : Fin 3) : coreGen i j ∈ candidateDerived i := by
  obtain ⟨hx, hy⟩ := candidatePair_mem i
  have hc (z : Atlas1600Group) (hz : z ∈ candidate i) :
      z * ⁅(candidatePair i).1, (candidatePair i).2⁆ * z⁻¹ ∈ candidateDerived i := by
    rw [conjugate_commutatorElement]
    exact commutator_mem_commutator
      ((candidate i).mul_mem ((candidate i).mul_mem hz hx) ((candidate i).inv_mem hz))
      ((candidate i).mul_mem ((candidate i).mul_mem hz hy) ((candidate i).inv_mem hz))
  fin_cases j
  · exact commutator_mem_commutator hx hy
  · exact hc _ hx
  · exact hc _ hy

public theorem core_le_derived (i : Fin 3) : core i ≤ candidateDerived i := by
  apply (closure_le _).mpr
  rintro x ⟨j, rfl⟩
  exact coreGen_mem_derived i j

/-- The two short representative lists. Letter 2 is the first candidate generator. -/
@[expose] public def representativeWord (i : Fin 2) : Fin 6 → List (Fin 3) :=
  ![![[], [2], [0], [1], [1, 0, 1], [1, 0, 1, 0, 1, 0]],
    ![[], [2], [0], [1], [1, 0, 1], [1, 1, 0, 1]]] i

@[expose] public def representative (i : Fin 2) (j : Fin 6) : Atlas1600Group :=
  evalWord ![standard 0, standard 1, (candidatePair (i.castLE (by decide))).1]
    (representativeWord i j)

public theorem representative_zero (i : Fin 2) : representative i 0 = 1 := by
  fin_cases i <;> rfl

public theorem representative_one (i : Fin 2) :
    representative i 1 = (candidatePair (i.castLE (by decide))).1 := by
  fin_cases i <;> exact mul_one _

public theorem representative_small_mem (i : Fin 2) (j : Fin 6) (hj : j.val < 2) :
    representative i j ∈ candidate (i.castLE (by decide)) := by
  have hj' : j = 0 ∨ j = 1 := by omega
  rcases hj' with rfl | rfl
  · rw [representative_zero]
    exact (candidate _).one_mem
  · rw [representative_one]
    exact (candidatePair_mem _).1

/-- The faithful permutation inclusion, with the actual carrier's group instance. -/
@[expose] public def inclusion : Atlas1600Group →* Equiv.Perm (Fin 1600) where
  toFun g := g.val
  map_one' := rfl
  map_mul' _ _ := rfl

public theorem inclusion_injective : Function.Injective inclusion :=
  fun _ _ h => Subtype.ext h

public theorem evalWord_val {n : Nat} (f : Fin n → Atlas1600Group) (w : List (Fin n)) :
    (evalWord f w).val = evalWord (fun i => (f i).val) w := by
  induction w with
  | nil => rfl
  | cons i w ih => change (f i).val * (evalWord f w).val = _; rw [ih]

public theorem packed_standard (i : Fin 4) : L0Gen i = (standard i).val := by
  fin_cases i <;> simp only [L0Gen, L0G0_eq_atlas, L0G1_eq_atlas] <;> rfl

public theorem packed_pair (i : Fin 3) :
    program L0G0 L0G1 i = ((candidatePair i).1.val, (candidatePair i).2.val) := by
  rw [L0G0_eq_atlas, L0G1_eq_atlas]
  fin_cases i <;> rfl

public theorem packed_seeds (i j : Fin 3) :
    seeds (program L0G0 L0G1 i) j = (coreGen i j).val := by
  rw [packed_pair]
  fin_cases j <;> rfl

/-- Signed inputs for recovering standard generators: the three core words,
the double-coset representative, and their inverses. -/
@[expose] public def inputs {G : Type*} [Group G] (p : G × G) (r : G) : Fin 8 → G :=
  ![seeds p 0, seeds p 1, seeds p 2, r,
    (seeds p 0)⁻¹, (seeds p 1)⁻¹, (seeds p 2)⁻¹, r⁻¹]

public theorem packed_inputs (i : Fin 3) (r : Atlas1600Group) (j : Fin 8) :
    inputs (program L0G0 L0G1 i) r.val j = (inputs (candidatePair i) r j).val := by
  rw [packed_pair]
  fin_cases j <;> rfl

public theorem packed_eval (i : Fin 3) (r : Atlas1600Group) (w : List (Fin 8)) :
    (evalWord (inputs (candidatePair i) r) w).val =
      evalWord (inputs (program L0G0 L0G1 i) r.val) w := by
  rw [evalWord_val]
  congr 1
  funext j
  exact (packed_inputs i r j).symm

@[expose] public def packedRepresentative (i : Fin 2) (j : Fin 6) : Equiv.Perm (Fin 1600) :=
  evalWord ![L0G0, L0G1, (program L0G0 L0G1 (i.castLE (by decide))).1]
    (representativeWord i j)

public theorem packed_representative (i : Fin 2) (j : Fin 6) :
    packedRepresentative i j = (representative i j).val := by
  rw [representative, evalWord_val]
  unfold packedRepresentative
  congr 1
  funext k
  rw [packed_pair, L0G0_eq_atlas, L0G1_eq_atlas]
  fin_cases k <;> rfl

public theorem inputs_mem (i : Fin 3) (r : Atlas1600Group) (L : Subgroup Atlas1600Group)
    (hD : candidateDerived i ≤ L) (hr : r ∈ L) (j : Fin 8) :
    inputs (candidatePair i) r j ∈ L := by
  have hs (k : Fin 3) : coreGen i k ∈ L := hD (coreGen_mem_derived i k)
  fin_cases j
  · exact hs 0
  · exact hs 1
  · exact hs 2
  · exact hr
  · exact L.inv_mem (hs 0)
  · exact L.inv_mem (hs 1)
  · exact L.inv_mem (hs 2)
  · exact L.inv_mem hr

public theorem eval_inputs_mem (i : Fin 3) (r : Atlas1600Group) (L : Subgroup Atlas1600Group)
    (hD : candidateDerived i ≤ L) (hr : r ∈ L) (w : List (Fin 8)) :
    evalWord (inputs (candidatePair i) r) w ∈ L := by
  induction w with
  | nil => exact L.one_mem
  | cons j w ih => exact L.mul_mem (inputs_mem i r L hD hr j) ih

end Tits.MinimumIndexThirteen.CandidateRigidity
