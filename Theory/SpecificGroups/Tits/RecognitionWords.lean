module

public import Theory.SpecificGroups.Tits.Presentation

/-!
# The generator words in Parrott's recognition argument

Parrott's local construction uses elements `z, t, v, u, w, a, b, c, d,
x, y, r, s`. The ten words below give the correspondence with his
presentation, in exactly the printed factor order. The element `t` is
needed in the seventh word; its identification with the word `r₃` is a
subsequent consequence of the local relations.

The equation `x² = yz`, together with `y² = 1`, identifies `r₅` with the
prescribed involution `z`. We also isolate the eighth-power relation from
the other 36 relators, since its proof uses both involution centralizers.
These are word identities in an arbitrary group; the existence of suitable
local elements remains the responsibility of the recognition theorem.

Once `r₃ = t` and `rtr = wuvz` have also been established, the ten words
recover all thirteen local elements inside any subgroup. This lets the
recognition proof identify the subgroup generated by the presentation with
the one generated by its two local centralizer configurations.

Source: D. Parrott, *A characterization of the Tits' simple group* (1972),
§6, printed p.684. See `refs/original/n-group-global/parrott-tits-presentation.md`
for the scan-checked conventions and correspondence.
-/

namespace Tits

/-- The ten words in the generator correspondence on Parrott's p.684. -/
@[expose] public def parrottRecognitionWords {G : Type*} [Group G]
    (z t v u w a b c d x y r s : G) : ParrottGenerator → G
  | .r1 => r
  | .r8 => s
  | .s1 => y
  | .s2 => a * v * z
  | .s3 => b * x * v
  | .s4 => v * z
  | .s5 => x
  | .s6 => u * v * z
  | .s7 => x⁻¹ * c * a * w * t * z
  | .s8 => d * v * z

/-- The prescribed involution is recovered from the named word `r₅`. -/
public theorem parrottRecognitionWords_anchor {G : Type*} [Group G]
    (z t v u w a b c d x y r s : G) (hy : y ^ 2 = 1) (hx : x ^ 2 = y * z) :
    parrottRecognitionWords z t v u w a b c d x y r s .s1 *
      (parrottRecognitionWords z t v u w a b c d x y r s .s5) ^ 2 = z := by
  change y * x ^ 2 = z
  rw [hx, ← mul_assoc, ← pow_two, hy, one_mul]

/-- Evaluating the named free-group word `r₅` recovers the same involution. -/
public theorem parrottRecognitionWords_r5 {G : Type*} [Group G]
    (z t v u w a b c d x y r s : G) (hy : y ^ 2 = 1) (hx : x ^ 2 = y * z) :
    FreeGroup.lift (parrottRecognitionWords z t v u w a b c d x y r s)
      parrottR5 = z := by
  simpa only [parrottR5, map_mul, map_pow, FreeGroup.lift_apply_of] using
    parrottRecognitionWords_anchor z t v u w a b c d x y r s hy hx

/-- The full presentation consists of the 36 local equations and VI(i). -/
public theorem satisfiesParrottRelations_iff_except_braid {G : Type*} [Group G]
    (g : ParrottGenerator → G) :
    SatisfiesParrottRelations g ↔
      (∀ i : ParrottRelatorIndex, i ≠ .vi_r1_r8 →
        FreeGroup.lift g (parrottRelator i) = 1) ∧
      (g .r1 * g .r8) ^ 8 = 1 := by
  constructor
  · intro h
    refine ⟨fun i _ => h i, ?_⟩
    simpa only [parrottRelator, map_pow, map_mul, FreeGroup.lift_apply_of] using
      h .vi_r1_r8
  · rintro ⟨hlocal, hbraid⟩ i
    by_cases hi : i = .vi_r1_r8
    · subst i
      simpa only [parrottRelator, map_pow, map_mul, FreeGroup.lift_apply_of] using hbraid
    · exact hlocal i hi

/-- The correspondence loses none of the local generators once its named
word identities have been proved. -/
public theorem parrottRecognitionWords_mem_iff {G : Type*} [Group G]
    (L : Subgroup G) (z t v u w a b c d x y r s : G)
    (hy : y ^ 2 = 1) (hx : x ^ 2 = y * z)
    (ht : y * (a * v * z) * (b * x * v) ^ 2 = t)
    (hr : r * t * r = w * u * v * z) :
    (∀ i, parrottRecognitionWords z t v u w a b c d x y r s i ∈ L) ↔
      z ∈ L ∧ t ∈ L ∧ v ∈ L ∧ u ∈ L ∧ w ∈ L ∧ a ∈ L ∧ b ∈ L ∧
        c ∈ L ∧ d ∈ L ∧ x ∈ L ∧ y ∈ L ∧ r ∈ L ∧ s ∈ L := by
  constructor
  · intro hg
    have hyL : y ∈ L := hg .s1
    have hxL : x ∈ L := hg .s5
    have hrL : r ∈ L := hg .r1
    have hsL : s ∈ L := hg .r8
    have hzL : z ∈ L := by
      rw [← parrottRecognitionWords_anchor z t v u w a b c d x y r s hy hx]
      exact L.mul_mem (hg .s1) (L.pow_mem (hg .s5) 2)
    have hvL : v ∈ L := (L.mul_mem_cancel_right hzL).mp (hg .s4)
    have haL : a ∈ L := (L.mul_mem_cancel_right hvL).mp
      ((L.mul_mem_cancel_right hzL).mp (hg .s2))
    have huL : u ∈ L := (L.mul_mem_cancel_right hvL).mp
      ((L.mul_mem_cancel_right hzL).mp (hg .s6))
    have hdL : d ∈ L := (L.mul_mem_cancel_right hvL).mp
      ((L.mul_mem_cancel_right hzL).mp (hg .s8))
    have hbL : b ∈ L := (L.mul_mem_cancel_right hxL).mp
      ((L.mul_mem_cancel_right hvL).mp (hg .s3))
    have htL : t ∈ L := by
      rw [← ht]
      exact L.mul_mem (L.mul_mem hyL (hg .s2)) (L.pow_mem (hg .s3) 2)
    have hwuvzL : w * u * v * z ∈ L := by
      rw [← hr]
      exact L.mul_mem (L.mul_mem hrL htL) hrL
    have hwL : w ∈ L := (L.mul_mem_cancel_right huL).mp
      ((L.mul_mem_cancel_right hvL).mp ((L.mul_mem_cancel_right hzL).mp hwuvzL))
    have hcL : c ∈ L := (L.mul_mem_cancel_left (L.inv_mem hxL)).mp
      ((L.mul_mem_cancel_right haL).mp ((L.mul_mem_cancel_right hwL).mp
        ((L.mul_mem_cancel_right htL).mp ((L.mul_mem_cancel_right hzL).mp (hg .s7)))))
    exact ⟨hzL, htL, hvL, huL, hwL, haL, hbL, hcL, hdL, hxL, hyL, hrL, hsL⟩
  · rintro ⟨hzL, htL, hvL, huL, hwL, haL, hbL, hcL, hdL, hxL, hyL, hrL, hsL⟩ i
    cases i <;> dsimp only [parrottRecognitionWords]
    all_goals repeat first | assumption | apply L.mul_mem | apply L.inv_mem

end Tits
