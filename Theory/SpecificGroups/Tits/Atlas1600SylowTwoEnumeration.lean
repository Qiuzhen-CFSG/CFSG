/-!
# The 2048 normal forms in the Parrott Sylow-two subgroup

The subgroup generated by `s1, …, s8` is enumerated in that order with
exponent bounds `2, 2, 4, 2, 4, 2, 4, 2`. Eight power relations and 28
conjugation certificates allow collection through the successive cyclic
extensions. The images of the two zero-based points 0 and 930 distinguish
all 2048 words, as certified by a checked left inverse.

Only these small word certificates are checked on all 1600 points; no full
multiplication table is used. The generators and source conventions come
from Parrott (1972), p. 683, transcribed in
`refs/original/n-group-global/parrott-tits-presentation.md`.
-/

namespace Tits

open Atlas1600ParrottData Theory.GroupTheory

set_option maxRecDepth 20000
set_option maxHeartbeats 1600000

local notation "s₁" => atlas1600ParrottAssignment ParrottGenerator.s1
local notation "s₂" => atlas1600ParrottAssignment ParrottGenerator.s2
local notation "s₃" => atlas1600ParrottAssignment ParrottGenerator.s3
local notation "s₄" => atlas1600ParrottAssignment ParrottGenerator.s4
local notation "s₅" => atlas1600ParrottAssignment ParrottGenerator.s5
local notation "s₆" => atlas1600ParrottAssignment ParrottGenerator.s6
local notation "s₇" => atlas1600ParrottAssignment ParrottGenerator.s7
local notation "s₈" => atlas1600ParrottAssignment ParrottGenerator.s8

-- The derived group instance is definitionally the subgroup instance. These
-- local equations let the simplifier project it without unfolding generators.
private theorem val_mul (a b : Atlas1600Group) : (a * b).val = a.val * b.val := by rfl
private theorem val_inv (a : Atlas1600Group) : (a⁻¹).val = a.val⁻¹ := by rfl
private theorem val_pow (a : Atlas1600Group) (n : Nat) : (a ^ n).val = a.val ^ n := by rfl

/-- The subgroup generated by the eight Parrott `s` generators. -/
public def atlas1600SylowTwoSubgroup : Subgroup Atlas1600Group :=
  Subgroup.closure {s₈, s₇, s₆, s₅, s₄, s₃, s₂, s₁}

/-- The generators of the subgroup, stated without exposing its implementation. -/
public theorem atlas1600SylowTwoSubgroup_eq :
    atlas1600SylowTwoSubgroup = Subgroup.closure {s₈, s₇, s₆, s₅, s₄, s₃, s₂, s₁} := by rfl

/-- Ordered mixed-radix normal forms, with `s1` the least significant digit. -/
public def atlas1600SylowTwoNormalForm (n : Fin 2048) : Atlas1600Group :=
  s₁ ^ (n.val % 2) *
    s₂ ^ (n.val / 2 % 2) *
    s₃ ^ (n.val / 4 % 4) *
    s₄ ^ (n.val / 16 % 2) *
    s₅ ^ (n.val / 32 % 4) *
    s₆ ^ (n.val / 128 % 2) *
    s₇ ^ (n.val / 256 % 4) *
    s₈ ^ (n.val / 1024 % 2)

/-- The normal-form equation in the Atlas group. -/
public theorem atlas1600SylowTwoNormalForm_eq (n : Fin 2048) :
    atlas1600SylowTwoNormalForm n =
    s₁ ^ (n.val % 2) *
    s₂ ^ (n.val / 2 % 2) *
    s₃ ^ (n.val / 4 % 4) *
    s₄ ^ (n.val / 16 % 2) *
    s₅ ^ (n.val / 32 % 4) *
    s₆ ^ (n.val / 128 % 2) *
    s₇ ^ (n.val / 256 % 4) *
    s₈ ^ (n.val / 1024 % 2) := by rfl

/-- Concrete permutation projection for subsequent kernel-checked certificates. -/
public theorem atlas1600SylowTwoNormalForm_val (n : Fin 2048) :
    (atlas1600SylowTwoNormalForm n).val =
    s1Perm ^ (n.val % 2) *
    s2Perm ^ (n.val / 2 % 2) *
    s3Perm ^ (n.val / 4 % 4) *
    s4Perm ^ (n.val / 16 % 2) *
    s5Perm ^ (n.val / 32 % 4) *
    s6Perm ^ (n.val / 128 % 2) *
    s7Perm ^ (n.val / 256 % 4) *
    s8Perm ^ (n.val / 1024 % 2) := by
  simp only [atlas1600SylowTwoNormalForm, val_mul, val_pow,
    atlas1600ParrottAssignment_val, permutation]

