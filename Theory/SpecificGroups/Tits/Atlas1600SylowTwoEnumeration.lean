private theorem conjugates_2 :
    ∀ b ∈ ({s₁} : Set Atlas1600Group),
      s₂ * b * s₂⁻¹ ∈ Subgroup.closure {s₁} := by
  intro b hb
  simp only [Set.mem_singleton_iff] at hb
  subst b
  rw [conjugate_2_1]
  repeat first
    | apply Subgroup.mul_mem
    | apply Subgroup.pow_mem
    | exact Subgroup.subset_closure (by simp)

