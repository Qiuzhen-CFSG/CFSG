/-- Each enumerated word belongs to the generated subgroup. -/
public theorem atlas1600SylowTwoNormalForm_mem (n : Fin 2048) :
    atlas1600SylowTwoNormalForm n ∈ atlas1600SylowTwoSubgroup := by
  rw [atlas1600SylowTwoSubgroup_eq, atlas1600SylowTwoNormalForm_eq]
  repeat first
    | apply Subgroup.mul_mem
    | apply Subgroup.pow_mem
    | exact Subgroup.subset_closure (by simp)

/-- Every element of the generated subgroup has an ordered normal form. -/
public theorem atlas1600SylowTwoNormalForm_surjective
    {x : Atlas1600Group} (hx : x ∈ atlas1600SylowTwoSubgroup) :
    ∃ n : Fin 2048, atlas1600SylowTwoNormalForm n = x := by
  rw [atlas1600SylowTwoSubgroup_eq] at hx
  obtain ⟨y7, hy7, a8, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert {s₇, s₆, s₅, s₄, s₃, s₂, s₁}
      s₈ 2 (by decide) power_8 conjugates_8 hx
  obtain ⟨y6, hy6, a7, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert {s₆, s₅, s₄, s₃, s₂, s₁}
      s₇ 4 (by decide) power_7 conjugates_7 hy7
  obtain ⟨y5, hy5, a6, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert {s₅, s₄, s₃, s₂, s₁}
      s₆ 2 (by decide) power_6 conjugates_6 hy6
  obtain ⟨y4, hy4, a5, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert {s₄, s₃, s₂, s₁}
      s₅ 4 (by decide) power_5 conjugates_5 hy5
  obtain ⟨y3, hy3, a4, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert {s₃, s₂, s₁}
      s₄ 2 (by decide) power_4 conjugates_4 hy4
  obtain ⟨y2, hy2, a3, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert {s₂, s₁}
      s₃ 4 (by decide) power_3 conjugates_3 hy3
  obtain ⟨y1, hy1, a2, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert {s₁}
      s₂ 2 (by decide) power_2 conjugates_2 hy2
  obtain ⟨y0, hy0, a1, rfl⟩ :=
    exists_mul_pow_of_mem_closure_insert (∅ : Set Atlas1600Group)
      s₁ 2 (by decide) power_1 conjugates_1 (by simpa using hy1)
  simp only [Subgroup.closure_empty, Subgroup.mem_bot] at hy0
  subst y0
  let n : Fin 2048 :=
    ⟨a1.val + 2 * a2.val + 4 * a3.val + 16 * a4.val + 32 * a5.val +
      128 * a6.val + 256 * a7.val + 1024 * a8.val, by omega⟩
  refine ⟨n, ?_⟩
  have h1 : n.val % 2 = a1.val := by dsimp [n]; omega
  have h2 : n.val / 2 % 2 = a2.val := by dsimp [n]; omega
  have h3 : n.val / 4 % 4 = a3.val := by dsimp [n]; omega
  have h4 : n.val / 16 % 2 = a4.val := by dsimp [n]; omega
  have h5 : n.val / 32 % 4 = a5.val := by dsimp [n]; omega
  have h6 : n.val / 128 % 2 = a6.val := by dsimp [n]; omega
  have h7 : n.val / 256 % 4 = a7.val := by dsimp [n]; omega
  have h8 : n.val / 1024 % 2 = a8.val := by dsimp [n]; omega
  simp only [atlas1600SylowTwoNormalForm_eq, h1, h2, h3, h4, h5, h6, h7, h8, one_mul]

/-- The two point images already distinguish all the normal forms. -/
public theorem atlas1600SylowTwoNormalForm_pair_injective :
    Function.Injective (fun n : Fin 2048 =>
      ((atlas1600SylowTwoNormalForm n).val 0,
        (atlas1600SylowTwoNormalForm n).val 930)) := by
  intro i j h
  apply Atlas1600SylowTwoCertificate.pair_injective
  simpa only [atlas1600SylowTwoNormalForm_val,
    Atlas1600SylowTwoCertificate.normalForm] using h

/-- Distinct mixed-radix indices give distinct group elements. -/
public theorem atlas1600SylowTwoNormalForm_injective :
    Function.Injective atlas1600SylowTwoNormalForm := by
  intro i j h
  exact atlas1600SylowTwoNormalForm_pair_injective
    (congrArg (fun g : Atlas1600Group => (g.val 0, g.val 930)) h)

/-- Membership is exactly representability by one of the 2048 normal forms. -/
public theorem mem_atlas1600SylowTwoSubgroup_iff (x : Atlas1600Group) :
    x ∈ atlas1600SylowTwoSubgroup ↔
      ∃ n : Fin 2048, atlas1600SylowTwoNormalForm n = x := by
  constructor
  · exact atlas1600SylowTwoNormalForm_surjective
  · rintro ⟨n, rfl⟩
    exact atlas1600SylowTwoNormalForm_mem n

/-- An equivalence packages the complete, irredundant enumeration. -/
public noncomputable def atlas1600SylowTwoEquiv : Fin 2048 ≃ atlas1600SylowTwoSubgroup :=
  Equiv.ofBijective
    (fun n => ⟨atlas1600SylowTwoNormalForm n, atlas1600SylowTwoNormalForm_mem n⟩)
    ⟨fun _ _ h => atlas1600SylowTwoNormalForm_injective (congrArg Subtype.val h),
      fun x => by
        obtain ⟨n, hn⟩ := atlas1600SylowTwoNormalForm_surjective x.property
        exact ⟨n, Subtype.ext hn⟩⟩

/-- The equivalence evaluates to the specified ordered product. -/
@[simp] public theorem atlas1600SylowTwoEquiv_apply (n : Fin 2048) :
    (atlas1600SylowTwoEquiv n).val = atlas1600SylowTwoNormalForm n := by rfl

/-- The subgroup generated by the eight `s` generators has order 2048. -/
public theorem atlas1600SylowTwoSubgroup_card : Nat.card atlas1600SylowTwoSubgroup = 2048 := by
  rw [← Nat.card_congr atlas1600SylowTwoEquiv]
  exact Nat.card_fin 2048

end Tits
