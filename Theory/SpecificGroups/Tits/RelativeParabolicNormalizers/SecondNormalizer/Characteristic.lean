module

public import Theory.SpecificGroups.Tits.RelativeParabolicNormalizers.SecondCenter
public import Theory.SpecificGroups.Tits.RelativeParabolicNormalizers.SecondNormalizer.Certificate
public import Theory.GroupTheory.NilpotentSecondCenter

/-!
# The intrinsic second center of the Tits Sylow subgroup

The known center is generated by r5. Commuting modulo this center forces
a normal form into the four certified candidates 1, r5, s1*s2*s3², and
their product. The Sylow subgroup is a nonabelian finite two-group, so
its second center strictly contains its center. Thus one of the two
noncentral candidates belongs to it; either candidate generates the
same subgroup together with r5. This identifies the explicit subgroup
with the upper central series and proves that it is characteristic.

Source: Parrott (1972), p.683, with the existing Atlas marking; this is
the intrinsic Sylow calculation used for Aschbacher–Smith 2.3.9(7), p.526.
-/

@[expose] public section

open Subgroup
open scoped commutatorElement
namespace Tits.RelativeParabolicNormalizers
open ExceptionalParabolics
local notation "x" => atlas1600R5
local notation "y" => secondCenterMate
local notation "Z₂" => Subgroup.upperCentralSeries S 2

private theorem val_mul (a b : Atlas1600Group) : (a * b).val = a.val * b.val := rfl
private theorem val_inv (a : Atlas1600Group) : (a⁻¹).val = a.val⁻¹ := rfl
private theorem val_pow (a : Atlas1600Group) (n : ℕ) : (a ^ n).val = a.val ^ n := rfl
private theorem x_val : (x).val = SecondCenterCertificate.x := by
  simp only [atlas1600R5_eq, val_mul, val_pow, atlas1600ParrottAssignment_val,
    Atlas1600ParrottData.permutation, SecondCenterCertificate.x]
private theorem y_val : (y).val = SecondCenterCertificate.y := by
  simp only [secondCenterMate, val_mul, val_pow, atlas1600ParrottAssignment_val,
    Atlas1600ParrottData.permutation, SecondCenterCertificate.y]

private theorem form_zero : atlas1600SylowTwoNormalForm 0 = 1 := by
  norm_num [atlas1600SylowTwoNormalForm_eq]
private theorem form_eleven : atlas1600SylowTwoNormalForm 11 = y := by
  norm_num [atlas1600SylowTwoNormalForm_eq, secondCenterMate]
private theorem form_sixty_five : atlas1600SylowTwoNormalForm 65 = x := by
  norm_num [atlas1600SylowTwoNormalForm_eq, atlas1600R5_eq]
private theorem form_seventy_four : atlas1600SylowTwoNormalForm 74 = x * y := by
  apply Subtype.ext
  simpa only [atlas1600SylowTwoNormalForm_val, val_mul, x_val, y_val,
    Atlas1600SylowTwoCertificate.normalForm] using SecondNormalizerCertificate.form_74

private theorem x_mem : x ∈ secondCenter := mem_sup_left (mem_zpowers _)
private theorem y_mem : y ∈ secondCenter := mem_sup_right (mem_zpowers _)
private def sx : S := ⟨x, atlas1600R5_mem_sylowTwo⟩
private def sy : S := ⟨y, secondCenter_le_sylow y_mem⟩

private theorem second_test (w : S) (hw : w ∈ Z₂) :
    SecondNormalizerCertificate.testSecond w.val.val = true := by
  have hpoint (i : ParrottGenerator)
      (hi : atlas1600ParrottAssignment i ∈
        ({atlas1600ParrottAssignment .s8, atlas1600ParrottAssignment .s7,
          atlas1600ParrottAssignment .s6, atlas1600ParrottAssignment .s5,
          atlas1600ParrottAssignment .s4, atlas1600ParrottAssignment .s3,
          atlas1600ParrottAssignment .s2, atlas1600ParrottAssignment .s1} : Set Atlas1600Group)) :
      SecondNormalizerCertificate.testPair w.val.val
        (Atlas1600ParrottData.permutation i) = true := by
    have hmem : atlas1600ParrottAssignment i ∈ S := by
      rw [S, atlas1600SylowTwoSubgroup_eq]
      exact subset_closure hi
    let g : S := ⟨atlas1600ParrottAssignment i, hmem⟩
    have hc : ⁅w, g⁆ ∈ center S := by
      simpa only [Subgroup.upperCentralSeries_one] using Subgroup.mem_upperCentralSeries_succ_iff.mp hw g
    have hmul : w * g = ⁅w, g⁆ * g * w := by simp [commutatorElement_def, mul_assoc]
    have he := congrArg (fun a : S => a.val) hmul
    change w.val * atlas1600ParrottAssignment i =
      (⁅w, g⁆ : S).val * atlas1600ParrottAssignment i * w.val at he
    rcases (atlas1600SylowTwo_mem_center_iff _).mp hc with hc | hc
    · have he' : w.val * atlas1600ParrottAssignment i =
          atlas1600ParrottAssignment i * w.val := by simpa only [hc, one_mul] using he
      have hp := congrArg (fun a : Atlas1600Group => a.val 0) he'
      simp only [val_mul, atlas1600ParrottAssignment_val, Equiv.Perm.mul_apply] at hp
      simp only [SecondNormalizerCertificate.testPair, Bool.or_eq_true, beq_iff_eq]
      exact Or.inl hp
    · have he' : w.val * atlas1600ParrottAssignment i =
          x * atlas1600ParrottAssignment i * w.val := by simpa only [hc] using he
      have hp := congrArg (fun a : Atlas1600Group => a.val 0) he'
      simp only [val_mul, atlas1600ParrottAssignment_val, x_val, Equiv.Perm.mul_apply] at hp
      simp only [SecondNormalizerCertificate.testPair, Bool.or_eq_true, beq_iff_eq]
      exact Or.inr hp
  simp only [SecondNormalizerCertificate.testSecond, Bool.and_eq_true]
  repeat' apply And.intro
  · exact hpoint .s1 (by simp)
  · exact hpoint .s2 (by simp)
  · exact hpoint .s3 (by simp)
  · exact hpoint .s4 (by simp)
  · exact hpoint .s5 (by simp)
  · exact hpoint .s6 (by simp)
  · exact hpoint .s7 (by simp)
  · exact hpoint .s8 (by simp)

private theorem second_cases (w : S) (hw : w ∈ Z₂) :
    w.val = 1 ∨ w.val = y ∨ w.val = x ∨ w.val = x * y := by
  obtain ⟨n, hn⟩ := atlas1600SylowTwoNormalForm_surjective w.property
  have ht := second_test w hw
  rw [← hn, atlas1600SylowTwoNormalForm_val] at ht
  change SecondNormalizerCertificate.testSecond (Atlas1600SylowTwoCertificate.normalForm n) = true at ht
  rcases SecondNormalizerCertificate.candidates n ht with rfl | rfl | rfl | rfl
  · exact Or.inl (hn.symm.trans form_zero)
  · exact Or.inr (Or.inl (hn.symm.trans form_eleven))
  · exact Or.inr (Or.inr (Or.inl (hn.symm.trans form_sixty_five)))
  · exact Or.inr (Or.inr (Or.inr (hn.symm.trans form_seventy_four)))

private theorem sx_second : sx ∈ Z₂ := by
  apply (Subgroup.upperCentralSeries_mono S (show 1 ≤ 2 by omega))
  simpa only [Subgroup.upperCentralSeries_one, sx] using atlas1600R5_mem_center_sylowTwo

private theorem sy_second : sy ∈ Z₂ := by
  have hnoncomm : ¬ IsMulCommutative S := by
    intro hc
    have hz : sy ∈ center S := by rw [center_eq_top_iff.mpr hc]; trivial
    rcases (atlas1600SylowTwo_mem_center_iff sy).mp hz with hz | hz
    · have hf := atlas1600SylowTwoNormalForm_injective (form_eleven.trans (hz.trans form_zero.symm))
      exact (by decide : (11 : Fin 2048) ≠ 0) hf
    · have hf := atlas1600SylowTwoNormalForm_injective (form_eleven.trans (hz.trans form_sixty_five.symm))
      exact (by decide : (11 : Fin 2048) ≠ 65) hf
  have hp : IsPGroup 2 S := IsPGroup.of_card (n := 11)
    (by simpa using sylow_card)
  let : Group.IsNilpotent S := hp.isNilpotent
  obtain ⟨w, hw, hn⟩ := Group.exists_mem_upperCentralSeries_two_not_mem_center hnoncomm
  rcases second_cases w hw with he | he | he | he
  · exact (hn ((atlas1600SylowTwo_mem_center_iff w).mpr (Or.inl he))).elim
  · exact (show w = sy from Subtype.ext he) ▸ hw
  · exact (hn ((atlas1600SylowTwo_mem_center_iff w).mpr (Or.inr he))).elim
  · have hxy : sx * sy ∈ Z₂ := (show w = sx * sy from Subtype.ext he) ▸ hw
    exact ((Z₂).mul_mem_cancel_left sx_second).mp hxy

/-- The intrinsic second center of the marked Sylow subgroup. -/
theorem secondCenter_subgroupOf_eq_upperCentralSeries :
    secondCenter.subgroupOf S = Z₂ := by
  apply le_antisymm
  · have he : secondCenter ≤ (Z₂).map S.subtype := by
      exact sup_le (zpowers_le.mpr (mem_map_of_mem _ sx_second))
        (zpowers_le.mpr (mem_map_of_mem _ sy_second))
    intro w hw
    obtain ⟨v, hv, heq⟩ := he hw
    exact (show v = w from Subtype.ext heq) ▸ hv
  · intro w hw
    change w.val ∈ secondCenter
    rcases second_cases w hw with he | he | he | he
    · rw [he]; exact secondCenter.one_mem
    · rw [he]; exact y_mem
    · rw [he]; exact x_mem
    · rw [he]; exact secondCenter.mul_mem x_mem y_mem

/-- The subgroup defining the second parabolic is characteristic in the marked Sylow subgroup. -/
theorem secondCenter_characteristic : (secondCenter.subgroupOf S).Characteristic := by
  rw [secondCenter_subgroupOf_eq_upperCentralSeries]
  infer_instance

/-- The four explicit elements of the second center. -/
theorem mem_secondCenter_iff {a : Atlas1600Group} :
    a ∈ secondCenter ↔ a = 1 ∨ a = y ∨ a = x ∨ a = x * y := by
  constructor
  · intro ha
    have h : (⟨a, secondCenter_le_sylow ha⟩ : S) ∈ Z₂ := by
      rw [← secondCenter_subgroupOf_eq_upperCentralSeries]
      exact ha
    exact second_cases _ h
  · rintro (rfl | rfl | rfl | rfl)
    · exact secondCenter.one_mem
    · exact y_mem
    · exact x_mem
    · exact secondCenter.mul_mem x_mem y_mem

end Tits.RelativeParabolicNormalizers

end
