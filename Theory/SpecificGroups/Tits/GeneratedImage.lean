module

public import Theory.SpecificGroups.Tits.Presentation

/-!+# Images of Parrott's presentation

The image of the universal homomorphism is exactly the subgroup generated by
the assigned elements. Thus a concrete assignment gives a quotient onto its
target precisely when those elements generate the target. This follows by
mapping the canonical generating set of the presented group; it uses no
finiteness or recognition theorem. The presentation is Parrott (1972), §5.
-/

namespace Tits

/-- The image of the universal map is generated by the ten assigned elements. -/
public theorem parrottLift_range {G : Type*} [Group G]
    (g : ParrottGenerator → G) (h : SatisfiesParrottRelations g) :
    (parrottLift g h).range = Subgroup.closure (Set.range g) := by
  have hgen : Subgroup.closure (Set.range parrottGenerator) = ⊤ :=
    PresentedGroup.closure_range_of parrottRelatorSet
  have himage : (parrottLift g h) '' Set.range parrottGenerator = Set.range g := by
    rw [← Set.range_comp]
    congr 1
    funext a
    exact parrottLift_generator g h a
  rw [MonoidHom.range_eq_map, ← hgen, MonoidHom.map_closure, himage]

/-- Surjectivity is exactly the assertion that the assigned generators generate. -/
public theorem parrottLift_surjective_iff {G : Type*} [Group G]
    (g : ParrottGenerator → G) (h : SatisfiesParrottRelations g) :
    Function.Surjective (parrottLift g h) ↔ Subgroup.closure (Set.range g) = ⊤ := by
  rw [← MonoidHom.range_eq_top, parrottLift_range]

end Tits
