module
public import Theory.SpecificGroups.SymmetricFiveInvolutions
public import Theory.Alternating.Aut
public import Mathlib.GroupTheory.Sylow
public import Mathlib.Tactic

/-!
# Sylow-normalized subgroups in a marked A₅ extension

A subgroup disjoint from A₅ injects into the sign group. If nontrivial,
it is generated by a transposition. Normalization by a Sylow two-group
would centralize that transposition, whose centralizer has order twelve,
contradicting the Sylow order eight. The result is transported through a
faithful marked embedding of an arbitrary A₅ extension into S₅.

Source application: the full-Sylow inspection in Aschbacher--Smith 13.3.12,
printed pp.889--890. No permutation-subgroup enumeration is used.
-/

public section

open Subgroup
namespace Theory.SpecificGroups.SymmetricFive.SylowNormalIntersection

private theorem card_centralizer_swap (x : Equiv.Perm (Fin 5)) (hx : x.IsSwap) :
    Nat.card (centralizer ({x} : Set (Equiv.Perm (Fin 5)))) = 12 := by
  rw [Equiv.Perm.nat_card_centralizer, Equiv.Perm.isSwap_iff_cycleType.mp hx]
  norm_num

/-- Every nontrivial subgroup normalized by a Sylow two-subgroup of S₅ meets A₅. -/
theorem inf_alternating_ne_bot (S : Sylow 2 (Equiv.Perm (Fin 5)))
    (R : Subgroup (Equiv.Perm (Fin 5))) (hne : R ≠ ⊥)
    (hn : (S : Subgroup (Equiv.Perm (Fin 5))) ≤ normalizer (R : Set (Equiv.Perm (Fin 5)))) :
    R ⊓ alternatingGroup (Fin 5) ≠ ⊥ := by
  intro hbot
  have hi : Function.Injective (Equiv.Perm.sign.comp R.subtype) := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    apply eq_bot_iff.mpr
    intro x hx
    have h : (x : Equiv.Perm (Fin 5)) ∈ R ⊓ alternatingGroup (Fin 5) := ⟨x.property,hx⟩
    rw [hbot,mem_bot] at h
    exact Subtype.ext h
  obtain ⟨x,hx,hx1⟩ := SetLike.not_le_iff_exists.mp (show ¬ R ≤ ⊥ from fun h => hne (bot_unique h))
  have hout : x ∉ alternatingGroup (Fin 5) := by
    intro hxA
    have hm : x ∈ R ⊓ alternatingGroup (Fin 5) := ⟨hx,hxA⟩
    rw [hbot] at hm
    exact hx1 hm
  have hx2 : x ^ 2 = 1 := by
    have he : (⟨x,hx⟩ : R)^2 = 1 := hi (by simp)
    exact congrArg Subtype.val he
  have hs : x.IsSwap := Equiv.Perm.five_isSwap_of_outer_involution x
    (orderOf_eq_prime_iff.mpr ⟨hx2,hx1⟩) hout
  have hSC : (S : Subgroup (Equiv.Perm (Fin 5))) ≤ centralizer ({x} : Set (Equiv.Perm (Fin 5))) := by
    intro y hy
    have hconj : y*x*y⁻¹ ∈ R := ((hn hy) x).mp hx
    have he : (⟨y*x*y⁻¹,hconj⟩ : R) = ⟨x,hx⟩ := hi (by
      change (y*x*y⁻¹).sign = x.sign
      simp only [map_mul,map_inv]
      rw [mul_comm (Equiv.Perm.sign y) (Equiv.Perm.sign x),mul_inv_cancel_right])
    apply mem_centralizer_singleton_iff.mpr
    exact mul_inv_eq_iff_eq_mul.mp (congrArg Subtype.val he)
  have h8 : Nat.card S = 8 := by
    rw [S.card_eq_multiplicity,Nat.card_eq_fintype_card,Fintype.card_perm]
    decide +kernel
  have hd := card_dvd_of_le hSC
  rw [h8,card_centralizer_swap x hs] at hd
  norm_num at hd
/-- A self-centralizing normal A₅ subgroup gives a faithful, marked S₅ embedding. -/
theorem exists_marked_embedding {E : Type*} [Group E] (A : Subgroup E) [A.Normal]
    (e : A ≃* alternatingGroup (Fin 5))
    (hself : centralizer (A : Set E) ≤ A) :
    ∃ f : E →* Equiv.Perm (Fin 5), Function.Injective f ∧
      ∀ a : A, f a = (e a : Equiv.Perm (Fin 5)) := by
  let a : Equiv.Perm (Fin 5) ≃* MulAut (alternatingGroup (Fin 5)) :=
    MulEquiv.ofBijective _ (GroupTheory.AutAlternating.aut_alternatingGroup_bijective_conj 5 (by decide) (by decide))
  let f : E →* Equiv.Perm (Fin 5) := a.symm.toMonoidHom.comp
    ((MulAut.congr e).toMonoidHom.comp (MulAut.conjNormal : E →* MulAut A))
  have hf (k : A) : f k = (e k : Equiv.Perm (Fin 5)) := by
    apply a.injective
    change a (a.symm (MulAut.congr e (MulAut.conjNormal (k : E)))) = _
    rw [a.apply_symm_apply]
    apply MulEquiv.ext
    intro z
    apply Subtype.ext
    change (e (k * e.symm z * k⁻¹) : Equiv.Perm (Fin 5)) =
      (e k : Equiv.Perm (Fin 5)) * z * (e k : Equiv.Perm (Fin 5))⁻¹
    simp only [map_mul,map_inv,e.apply_symm_apply,Subgroup.coe_mul,Subgroup.coe_inv]
  refine ⟨f,?_,hf⟩
  apply (MonoidHom.ker_eq_bot_iff f).mp
  apply bot_unique
  intro x hx
  have hc : x ∈ centralizer (A : Set (E)) := by
    have hh : a.symm (MulAut.congr e (MulAut.conjNormal x)) = 1 := hx
    rw [←map_one a.symm,a.symm.injective.eq_iff,
      ←map_one (MulAut.congr e),(MulAut.congr e).injective.eq_iff] at hh
    apply mem_centralizer_iff.mpr
    intro y hy
    have he := congrArg (fun b : MulAut A => ((b ⟨y,hy⟩ : A) : E)) hh
    change x*y*x⁻¹ = y at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  have hxA : x ∈ A := hself hc
  have hz : (⟨x,hxA⟩ : A) ∈ center A := by
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    exact mem_centralizer_iff.mp hc y y.property
  have hez : e ⟨x,hxA⟩ ∈ center (alternatingGroup (Fin 5)) :=
    (centerCongr e ⟨⟨x,hxA⟩,hz⟩).property
  rw [alternatingGroup.center_eq_bot (by simp)] at hez
  have hh : (⟨x,hxA⟩ : A) = 1 := e.injective (by simpa using mem_bot.mp hez)
  exact mem_bot.mpr (congrArg Subtype.val hh)

/-- The same intersection statement in an arbitrary faithfully marked A₅ extension. -/
theorem subgroupOf_ne_bot_of_marked_extension
    {E : Type*} [Group E] [Finite E] (C : Subgroup E)
    (e : C ≃* alternatingGroup (Fin 5))
    (f : E →* Equiv.Perm (Fin 5)) (hf : Function.Injective f)
    (he : ∀ c : C, f c = (e c : Equiv.Perm (Fin 5)))
    (P : Sylow 2 E) (R : Subgroup E) (hne : R ≠ ⊥)
    (hn : (P : Subgroup E) ≤ normalizer (R : Set E)) : R.subgroupOf C ≠ ⊥ := by
  intro hbot
  have hC (x : E) : f x ∈ alternatingGroup (Fin 5) ↔ x ∈ C := by
    constructor
    · intro hx
      obtain ⟨c,hc⟩ := e.surjective ⟨f x,hx⟩
      have hh : f c = f x := (he c).trans (congrArg Subtype.val hc)
      exact hf hh ▸ c.property
    · intro hx
      rw [he ⟨x,hx⟩]
      exact (e ⟨x,hx⟩).property
  have hRC : R ⊓ C = ⊥ := by
    have hh := congrArg (map C.subtype) hbot
    simpa only [subgroupOf_map_subtype,Subgroup.map_bot] using hh
  obtain ⟨x,hx,hx1⟩ := SetLike.not_le_iff_exists.mp
    (show ¬ R ≤ ⊥ from fun h => hne (bot_unique h))
  have hout : f x ∉ alternatingGroup (Fin 5) := by
    intro ha
    have hh : x ∈ R ⊓ C := ⟨hx,(hC x).mp ha⟩
    rw [hRC] at hh
    exact hx1 hh
  have heven (a : Equiv.Perm (Fin 5)) (ha : a ∈ alternatingGroup (Fin 5)) :
      ∃ y : E, f y = a := by
    obtain ⟨c,hc⟩ := e.surjective ⟨a,ha⟩
    exact ⟨c,(he c).trans (congrArg Subtype.val hc)⟩
  have hsurj : Function.Surjective f := by
    intro a
    by_cases ha : a ∈ alternatingGroup (Fin 5)
    · exact heven a ha
    · have hprod : a * (f x)⁻¹ ∈ alternatingGroup (Fin 5) := by
        rw [mul_mem_iff_of_index_two alternatingGroup.index_eq_two,inv_mem_iff]
        exact iff_of_false ha hout
      obtain ⟨y,hy⟩ := heven _ hprod
      exact ⟨y*x,by rw [map_mul,hy,inv_mul_cancel_right]⟩
  have hne' : R.map f ≠ ⊥ := fun hh => hne ((R.map_eq_bot_iff_of_injective hf).mp hh)
  apply inf_alternating_ne_bot (P.mapSurjective hsurj) (R.map f) hne'
    ((map_mono hn).trans (R.le_normalizer_map f))
  apply eq_bot_iff.mpr
  rintro z ⟨⟨y,hy,rfl⟩,hz⟩
  have hh : y ∈ R ⊓ C := ⟨hy,(hC y).mp hz⟩
  rw [hRC,mem_bot] at hh
  simp only [hh,map_one,mem_bot]
end Theory.SpecificGroups.SymmetricFive.SylowNormalIntersection
