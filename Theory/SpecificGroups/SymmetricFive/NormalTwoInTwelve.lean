module
public import Theory.GroupTheory.InvolutionCentralizerControl
public import Mathlib.GroupTheory.Perm.Centralizer
public import Mathlib.GroupTheory.Perm.Cycle.Type
import Mathlib.Tactic

/-!
# Normal subgroups of order two in a twelve-element subgroup of S₅

An involution other than a transposition has cycle type (2,2), whose
centralizer has order eight. It cannot be centralized by a subgroup of
order twelve. A normalized subgroup of order two is centralized, so it is
generated by a transposition. The finite check inspects only 120 permutations.

The original point-core calculation in Chapter 13 applies this to the
literal images of G₂ and O₂(G₂), providing the intermediate R in C.1.24.
Source: Aschbacher--Smith 13.2.12, printed p.882.
-/

public section
open Subgroup
namespace Theory.SpecificGroups.SymmetricFive
private theorem involution_inspection : ∀ r : Equiv.Perm (Fin 5),
    r^2=1 → r=1 ∨ r.cycleType={2} ∨ r.cycleType={2,2} := by
  decide +kernel

theorem swap_of_involution_of_cubic_centralizer (r : Equiv.Perm (Fin 5))
    (hr : orderOf r = 2)
    (hc : 3 ∣ Nat.card (centralizer ({r} : Set (Equiv.Perm (Fin 5))))) : r.IsSwap := by
  by_contra hn
  have hcy : r.cycleType = {2,2} := by
    rcases involution_inspection r (hr ▸ pow_orderOf_eq_one r) with he | he | he
    · rw [he,orderOf_one] at hr
      omega
    · exact (hn (Equiv.Perm.isSwap_iff_cycleType.mpr he)).elim
    · exact he
  have hcard : Nat.card (centralizer ({r} : Set (Equiv.Perm (Fin 5)))) = 8 := by
    rw [Equiv.Perm.nat_card_centralizer,hcy]
    norm_num [Nat.factorial]
  rw [hcard] at hc
  norm_num at hc

theorem swap_of_normalized_two_in_twelve
    (A B : Subgroup (Equiv.Perm (Fin 5))) (hA : Nat.card A = 12)
    (hB : Nat.card B = 2) (hn : A ≤ normalizer (B : Set (Equiv.Perm (Fin 5)))) :
    ∃ r : Equiv.Perm (Fin 5), r.IsSwap ∧ B = zpowers r := by
  obtain ⟨r,hr⟩ := exists_prime_orderOf_dvd_card' (G := B) 2 (by rw [hB])
  have hrG : orderOf (r : Equiv.Perm (Fin 5)) = 2 :=
    (orderOf_injective B.subtype B.subtype_injective r).trans hr
  have hcent : A ≤ centralizer ({(r : Equiv.Perm (Fin 5))} : Set (Equiv.Perm (Fin 5))) :=
    (hn.trans (normalizer_le_centralizer_of_card_two B hB)).trans
      (centralizer_le (Set.singleton_subset_iff.mpr r.property))
  have hc : 3 ∣ Nat.card (centralizer ({(r : Equiv.Perm (Fin 5))} : Set (Equiv.Perm (Fin 5)))) :=
    dvd_trans (by rw [hA]; decide : 3 ∣ Nat.card A) (card_dvd_of_le hcent)
  refine ⟨r,swap_of_involution_of_cubic_centralizer r hrG hc,?_⟩
  symm
  apply eq_of_le_of_card_ge (zpowers_le.mpr r.property)
  rw [hB,Nat.card_zpowers,hrG]
end Theory.SpecificGroups.SymmetricFive
