module
public import Theory.SpecificGroups.ClassicalOrthogonal.Minus.BinarySixObstruction.Basic
public import Theory.SpecificGroups.ClassicalOrthogonal.SplitOdd.ReflectionGeneration.JointGeneration
public import Theory.SpecificGroups.ClassicalOrthogonal.SplitOdd.ReflectionGeneration.SiegelReflections

/-!
# Reflection generation for the binary six-dimensional minus form

We remove the hyperbolic pairs using their actual perpendicular complements.
The coordinate isometry retains the final anisotropic plane, so pair transport
and complement lifting prove joint generation by Siegel transformations and
reflections. At the endpoint, each nonzero vector of the binary anisotropic
plane is carried to any other by a reflection, and the stabilizer of one such
vector is generated by its reflection. Only the four vectors of this plane
are checked by finite computation.

In dimension six the nonsingular polar form supplies the stable Siegel
factorization into reflections. Thus the literal reflection subgroup is the
entire isometry group, with no generation, simplicity or perfectness premise.
This is the reflection-generation input to `BinarySixObstruction.Generation`.

Source: GLS3 §2.7 (`refs/KGroup/GLS3/chapter2.tex`), for the orthogonal model in
Table 5.3o and Aschbacher--Smith A.2.19. The complement induction follows the
ATLAS-derived split argument in `SplitOdd.ReflectionGeneration.JointGeneration`;
the anisotropic-plane endpoint and minus coordinate isometry are supplied here.
-/

@[expose] public noncomputable section
open Theory.AlgebraicGroup
open ClassicalOrthogonal.Quadratic ClassicalOrthogonal.ReflectionGeneration
namespace ClassicalOrthogonal.Minus.BinarySixObstruction

private def firstE (n : ℕ) : Space F (n+1) := (Fin.cons (1,0) 0, 0)
private def firstF (n : ℕ) : Space F (n+1) := (Fin.cons (0,1) 0, 0)

private theorem form_firstE (n : ℕ) : form F (n+1) 1 (firstE n) = 0 := by
  simp [firstE, Fin.sum_univ_succ]
private theorem form_firstF (n : ℕ) : form F (n+1) 1 (firstF n) = 0 := by
  simp [firstF, Fin.sum_univ_succ]
private theorem polar_firstE (n : ℕ) (x : Space F (n+1)) :
    (form F (n+1) 1).polarBilin x (firstE n) = (x.1 0).2 := by
  rw [form_polar]
  simp [firstE, Fin.sum_univ_succ]
private theorem polar_firstF (n : ℕ) (x : Space F (n+1)) :
    (form F (n+1) 1).polarBilin x (firstF n) = (x.1 0).1 := by
  rw [form_polar]
  simp [firstF, Fin.sum_univ_succ]
private theorem polar_firstEF (n : ℕ) :
    (form F (n+1) 1).polarBilin (firstE n) (firstF n) = 1 := by
  rw [polar_firstF]
  rfl

/-- Removing the first hyperbolic pair preserves the complete minus form. -/
private def minusComplement (n : ℕ) :
    (complementForm (form F (n+1) 1) (firstE n) (firstF n)).IsometryEquiv
      (form F n 1) where
  toFun x := ((fun i => x.val.1 i.succ), x.val.2)
  invFun x := ⟨(Fin.cons 0 x.1, x.2), by
    rw [mem_complement, polar_firstE, polar_firstF]
    exact ⟨rfl, rfl⟩⟩
  left_inv x := by
    apply Subtype.ext
    have hx := x.prop
    rw [mem_complement, polar_firstE, polar_firstF] at hx
    apply Prod.ext
    · funext i
      refine Fin.cases ?_ (fun j => rfl) i
      exact Prod.ext hx.2.symm hx.1.symm
    · rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  map_app' x := by
    have hx := x.prop
    rw [mem_complement, polar_firstE, polar_firstF] at hx
    change form F n 1 _ = form F (n+1) 1 x.val
    simp [form_apply, Fin.sum_univ_succ, hx.1, hx.2]

private abbrev planeE : Space F 0 := (0, (1,0))
private abbrev planeF : Space F 0 := (0, (0,1))

private theorem plane_expansion (v : Space F 0) :
    v = v.2.1 • planeE + v.2.2 • planeF := by
  revert v
  decide

private theorem plane_ext (g h : quadraticIsometrySubgroup (form F 0 1))
    (he : g.val planeE = h.val planeE) (hf : g.val planeF = h.val planeF) : g = h := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro v
  rw [plane_expansion v]
  simp only [map_add, map_smul, he, hf]

/-- On the anisotropic plane, reflection in the sum interchanges distinct
nonzero vectors. Over the binary field all these vectors have value one. -/
private theorem plane_transport (u : Space F 0) (hu : u ≠ 0) :
    ∃ a : quadraticIsometrySubgroup (form F 0 1),
      a ∈ reflectionSubgroup (form F 0 1) ∧ a.val planeE = u := by
  by_cases he : u = planeE
  · exact ⟨1, (reflectionSubgroup _).one_mem, he.symm⟩
  · have hh : form F 0 1 (planeE + u) = 1 ∧
        planeE - (form F 0 1).polarBilin planeE (planeE + u) • (planeE + u) = u := by
      have h : ∀ u : Space F 0, u ≠ 0 → u ≠ planeE →
          form F 0 1 (planeE + u) = 1 ∧
          planeE - (form F 0 1).polarBilin planeE (planeE + u) • (planeE + u) = u := by
        simp only [form_polar, plane_polar]
        decide
      exact h u hu he
    have hq : form F 0 1 (planeE + u) ≠ 0 := by rw [hh.1]; exact one_ne_zero
    refine ⟨reflectionElement _ _ hq, reflectionElement_mem _ _ _, ?_⟩
    change reflectionLinear _ _ hq planeE = u
    rw [reflectionLinear_apply, hh.1, inv_one, one_mul]
    exact hh.2

/-- The two possible images of the second basis vector give the identity
and the reflection in the first basis vector. -/
private theorem plane_fixing_mem (g : quadraticIsometrySubgroup (form F 0 1))
    (he : g.val planeE = planeE) : g ∈ reflectionSubgroup (form F 0 1) := by
  have hne0 : g.val planeF ≠ 0 := by
    intro h
    have := g.val.injective (h.trans (map_zero _).symm)
    exact (by decide : planeF ≠ 0) this
  have hneE : g.val planeF ≠ planeE := by
    intro h
    have := g.val.injective (h.trans he.symm)
    exact (by decide : planeF ≠ planeE) this
  have h : ∀ v : Space F 0, v ≠ 0 → v ≠ planeE →
      v = planeF ∨ v = planeE + planeF := by
    rintro ⟨v, x, y⟩
    have hv : v = 0 := Subsingleton.elim _ _
    subst v
    revert x y
    decide
  have hf := h (g.val planeF) hne0 hneE
  rcases hf with hf | hf
  · have hg : g = 1 := plane_ext g 1 he hf
    rw [hg]
    exact (reflectionSubgroup _).one_mem
  · have hq : form F 0 1 planeE ≠ 0 := by decide
    have hg : g = reflectionElement _ planeE hq := by
      apply plane_ext
      · rw [he]
        change planeE = reflectionLinear _ planeE hq planeE
        rw [reflectionLinear_apply, show form F 0 1 planeE = 1 from by decide, inv_one,
          one_mul, form_polar, plane_polar]
        decide
      · rw [hf]
        change planeE + planeF = reflectionLinear _ planeE hq planeF
        rw [reflectionLinear_apply, show form F 0 1 planeE = 1 from by decide, inv_one,
          one_mul, form_polar, plane_polar]
        decide
    rw [hg]
    exact reflectionElement_mem _ _ _

private theorem plane_reflections : reflectionSubgroup (form F 0 1) = ⊤ := by
  apply top_unique
  intro g _
  have hne : g.val planeE ≠ 0 := by
    intro h
    exact (by decide : planeE ≠ 0) (g.val.injective (h.trans (map_zero _).symm))
  obtain ⟨a, ha, hae⟩ := plane_transport (g.val planeE) hne
  have hfix : (a⁻¹ * g).val planeE = planeE := by
    change a.val.symm (g.val planeE) = planeE
    rw [← hae, a.val.symm_apply_apply]
  have hmem := (reflectionSubgroup (form F 0 1)).mul_mem ha (plane_fixing_mem _ hfix)
  simpa only [mul_inv_cancel_left] using hmem

private theorem minus_radical (n : ℕ) : (form F n 1).radical = ⊥ := by
  apply bot_unique
  intro x hx
  rw [Submodule.mem_bot]
  apply (form_nonsingular F n 1 (by decide)).1
  intro w
  exact LinearMap.congr_fun hx.2 w

/-- Pair transport reduces every isometry to an isometry of the actual smaller
minus complement, ending at the binary anisotropic plane. -/
private theorem joint_minus (n : ℕ) : elementaryReflectionSubgroup (form F n 1) = ⊤ := by
  induction n with
  | zero => rw [elementaryReflectionSubgroup, plane_reflections, sup_top_eq]
  | succ n ih =>
    apply top_unique
    intro g _
    let Q := form F (n+1) 1
    obtain ⟨a, ha, hae, haf⟩ := elementaryReflection_pair_transport Q (minus_radical (n+1))
      (firstE n) (firstF n) (g.val (firstE n)) (g.val (firstF n))
      (form_firstE n) (form_firstF n)
      ((isometry_preserves Q g _).trans (form_firstE n))
      ((isometry_preserves Q g _).trans (form_firstF n)) (polar_firstEF n)
      ((isometry_polar Q (isometryCarrierEquiv Q g) _ _).trans (polar_firstEF n))
    let k := a⁻¹ * g
    have hke : k.val (firstE n) = firstE n := by
      change a.val.symm (g.val (firstE n)) = firstE n
      rw [← hae, a.val.symm_apply_apply]
    have hkf : k.val (firstF n) = firstF n := by
      change a.val.symm (g.val (firstF n)) = firstF n
      rw [← haf, a.val.symm_apply_apply]
    let t : pairStabilizer Q (firstE n) (firstF n) := ⟨k, hke, hkf⟩
    let c := pairRestriction Q (firstE n) (firstF n) t
    let i := minusComplement n
    have hc : c ∈ elementaryReflectionSubgroup (complementForm Q (firstE n) (firstF n)) := by
      have hcn : isometryGroupTransport i c ∈ elementaryReflectionSubgroup (form F n 1) := by
        rw [ih]
        trivial
      have hback := isometryTransport_mem_elementaryReflection i.symm _ hcn
      have heq : isometryGroupTransport i.symm (isometryGroupTransport i c) = c := by
        apply Subtype.ext
        apply LinearEquiv.ext
        intro x
        change i.symm (i (c.val (i.symm (i x)))) = c.val x
        rw [i.symm_apply_apply, i.symm_apply_apply]
      rwa [heq] at hback
    have hk := complementLift_mem_elementaryReflection Q (firstE n) (firstF n)
      (form_firstE n) (form_firstF n) (polar_firstEF n) c hc
    have heq : complementLift Q (firstE n) (firstF n)
        (form_firstE n) (form_firstF n) (polar_firstEF n) c = k :=
      congrArg Subtype.val ((pairStabilizerEquiv Q (firstE n) (firstF n)
        (form_firstE n) (form_firstF n) (polar_firstEF n)).symm_apply_apply t)
    rw [heq] at hk
    have hg := (elementaryReflectionSubgroup Q).mul_mem ha hk
    change a * (a⁻¹ * g) ∈ elementaryReflectionSubgroup Q at hg
    simpa only [mul_inv_cancel_left] using hg

/-- The full isometry group of the literal binary minus-six form is generated
by its nonsingular reflections. -/
theorem reflectionSubgroup_eq_top : reflectionSubgroup naturalForm = ⊤ := by
  have hj := joint_minus 2
  rw [← naturalForm_eq] at hj
  have he := elementary_le_reflections_stable naturalForm (quadraticForm_nonsingular F 3)
    (by rw [space_finrank]; decide)
  rwa [elementaryReflectionSubgroup, sup_eq_right.mpr he] at hj

end ClassicalOrthogonal.Minus.BinarySixObstruction
