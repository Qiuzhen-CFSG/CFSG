module

public import Theory.SpecificGroups.ClassicalOrthogonal.TheoremDRootNormalizer.MinusThreeComparison.CommutatorImage.Normality.SingularLines
public import Theory.SpecificGroups.ClassicalOrthogonal.TheoremDRootNormalizer.MinusThreeComparison.CommutatorImage.Perfectness
public import Mathlib.GroupTheory.Subgroup.Simple
import Mathlib.Tactic.Group

/-!
# Normality of the descended minus-six exterior image

The unitary plane radical lifts every Siegel transformation along the first
singular line. Explicit singular-line transitivity and Siegel covariance then
lift every Siegel transformation of the norm-model six-space. Their generated
subgroup is nontrivial and normal in the full orthogonal group, and is contained
in the genuine descended exterior image. The already proved perfectness puts
that image inside the literal full-group commutator.

With the permitted inherited simplicity of this commutator, the elementary
subgroup exhausts it. The exterior image therefore equals that normal subgroup,
giving both ambient normality and exactly the relative normality consumed by
`orthogonalAction_range_eq_commutator_of_normal` in `CommutatorImage`. Neither parent
assembly is imported here. No orthogonal order, reflection-generation, or
split-form image identification is needed.

Sources: GLS3 §2.7, printed pp.85–89; Aschbacher–Smith A.2.18 and Theorem D.
The actual form, descent, and full-group commutator conventions are retained.
-/

public noncomputable section
namespace ClassicalOrthogonal.TheoremDRootNormalizer.MinusThreeComparison
open Theory.SpecificGroups.ClassicalUnitary
namespace Normality
variable (n : ℕ) [NeZero n]

/-- Every full quadratic isometry preserves the unhalved polar pairing. -/
theorem polar_preserved (g : FullOrthogonal n) (u v : Space n) :
    (form n).polarBilin (g.val u) (g.val v) = (form n).polarBilin u v := by
  have hg (x : Space n) : form n (g.val x) = form n x := form_preserved n g x
  simp only [QuadraticMap.polarBilin_apply_apply, QuadraticMap.polar,
    ← map_add, hg]

/-- Conjugation transports both actual Siegel parameters. -/
theorem siegel_conj (g : FullOrthogonal n) (u v : Space n)
    (hu : form n u = 0) (huv : (form n).polarBilin u v = 0) :
    g * siegelElement (form n) u v hu huv * g⁻¹ =
      siegelElement (form n) (g.val u) (g.val v)
        ((form_preserved n g u).trans hu) ((polar_preserved n g u v).trans huv) := by
  let e : (form n).IsometryEquiv (form n) := { g.val with map_app' := form_preserved n g }
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  change g.val (Quadratic.siegel (form n) u v (g.val.symm x)) =
    Quadratic.siegel (form n) (g.val u) (g.val v) x
  have he := Quadratic.siegel_covariant (form n) e u v (g.val.symm x)
  change g.val (Quadratic.siegel (form n) u v (g.val.symm x)) =
    Quadratic.siegel (form n) (g.val u) (g.val v) (g.val (g.val.symm x)) at he
  simpa only [LinearEquiv.apply_symm_apply] using he

/-- The subgroup generated by the actual Siegel maps is ambient normal. -/
theorem elementary_normal : (elementarySubgroup (form n)).Normal := by
  constructor
  intro x hx g
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨u, v, hu, huv, rfl⟩ := hx
    rw [siegel_conj]
    exact siegelElement_mem _ _ _ _ _
  | one => simp
  | mul x y _ _ ihx ihy =>
    have he : g * (x*y) * g⁻¹ = (g*x*g⁻¹) * (g*y*g⁻¹) := by group
    rw [he]
    exact (elementarySubgroup (form n)).mul_mem ihx ihy
  | inv x _ ih =>
    have he : g * x⁻¹ * g⁻¹ = (g*x*g⁻¹)⁻¹ := by group
    rw [he]
    exact (elementarySubgroup (form n)).inv_mem ih

/-- Every actual Siegel transformation has a special unitary exterior lift. -/
theorem siegel_mem_range (hD : Descends n) (u v : Space n)
    (hu : form n u = 0) (huv : (form n).polarBilin u v = 0) :
    siegelElement (form n) u v hu huv ∈ (orthogonalAction n hD).range := by
  by_cases hu0 : u = 0
  · subst u
    have he : siegelElement (form n) 0 v hu huv = 1 := by
      apply Subtype.ext
      apply LinearEquiv.ext
      intro x
      change Quadratic.siegel (form n) 0 v x = x
      simp [Quadratic.siegel]
    rw [he]
    exact Subgroup.one_mem _
  obtain ⟨a, b, hb, ha⟩ := singular_line_transport n hD u hu hu0
  let g := orthogonalAction n hD a
  have hgu : form n (g.val u) = 0 := (form_preserved n g u).trans hu
  have hguv : (form n).polarBilin (g.val u) (g.val v) = 0 :=
    (polar_preserved n g u v).trans huv
  have hv' : (form n).polarBilin (direction n) (b • g.val v) = 0 := by
    rw [ha, map_smul, LinearMap.smul_apply, smul_eq_mul] at hguv
    simpa only [map_smul, smul_eq_mul] using hguv
  have ht : siegelElement (form n) (g.val u) (g.val v) hgu hguv =
      siegelElement (form n) (direction n) (b • g.val v) (direction_singular n) hv' := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
    change Quadratic.siegel (form n) (g.val u) (g.val v) x = _
    rw [ha, Quadratic.siegel_scale]
    rfl
  have htmem : siegelElement (form n) (g.val u) (g.val v) hgu hguv ∈
      (orthogonalAction n hD).range := by
    rw [ht]
    exact ⟨rootLift n (b • g.val v), rootLift_action n hD _ hv'⟩
  have hconj : g * siegelElement (form n) u v hu huv * g⁻¹ ∈
      (orthogonalAction n hD).range := by
    rw [siegel_conj]
    exact htmem
  have hg : g ∈ (orthogonalAction n hD).range := ⟨a, rfl⟩
  have hm := (orthogonalAction n hD).range.mul_mem
    ((orthogonalAction n hD).range.mul_mem
      ((orthogonalAction n hD).range.inv_mem hg) hconj) hg
  convert hm using 1
  group

/-- The entire elementary subgroup lies in the genuine descended image. -/
theorem elementary_le_range (hD : Descends n) :
    elementarySubgroup (form n) ≤ (orthogonalAction n hD).range := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨u, v, hu, huv, rfl⟩
  exact siegel_mem_range n hD u v hu huv

/-- A coordinate root is nontrivial, as seen in its faithful unitary lift. -/
theorem elementary_ne_bot (hD : Descends n) : elementarySubgroup (form n) ≠ ⊥ := by
  let v : Space n := (![(0,0),(1,0)],0)
  have hv : (form n).polarBilin (direction n) v = 0 := by rw [polar_direction]; rfl
  have hs : rootLift n v ≠ 1 := by
    intro he
    have he03 := congrArg (fun g : SU n => g.val.val 0 3) he
    simp [rootLift, parameterMatrix, UnitaryFourPlaneRadical.unipotentSU,
      UnitaryFourPlaneRadical.unipotentMatrix, v] at he03
  intro he
  have hm := siegelElement_mem (form n) (direction n) v (direction_singular n) hv
  rw [he, Subgroup.mem_bot, ← rootLift_action n hD v hv] at hm
  exact hs (orthogonalAction_injective n hD (hm.trans (map_one _).symm))

end Normality

variable (n : ℕ) [NeZero n]

/-- Inherited simplicity makes the genuine exterior image ambient normal. -/
theorem orthogonalAction_range_normal (hn : 1 < n) (hD : Descends n)
    [IsSimpleGroup (Omega n)] : (orthogonalAction n hD).range.Normal := by
  have hER := Normality.elementary_le_range n hD
  have hRO := orthogonalAction_range_le_commutator n hn hD
  have hEO := hER.trans hRO
  have hN := Normality.elementary_normal n
  have hsimple : IsSimpleGroup ↥(commutator (FullOrthogonal n)) := inferInstance
  have hE : elementarySubgroup (form n) = commutator (FullOrthogonal n) :=
    ((Subgroup.isSimpleGroup_iff.mp hsimple).2 _ hEO
      (hN.subgroupOf _)).resolve_left (Normality.elementary_ne_bot n hD)
  have hR : (orthogonalAction n hD).range = elementarySubgroup (form n) :=
    le_antisymm (by rw [hE]; exact hRO) hER
  rw [hR]
  exact hN

/-- The exact relative normality input for the commutator-image assembly. -/
theorem orthogonalAction_range_subgroupOf_commutator_normal (hn : 1 < n)
    (hD : Descends n) [IsSimpleGroup (Omega n)] :
    ((orthogonalAction n hD).range.subgroupOf (commutator (FullOrthogonal n))).Normal :=
  (orthogonalAction_range_normal n hn hD).subgroupOf _

end ClassicalOrthogonal.TheoremDRootNormalizer.MinusThreeComparison
