module

public import Theory.SpecificGroups.ClassicalOrthogonal.SplitOdd.ReflectionGeneration.JointGeneration
public import Theory.SpecificGroups.ClassicalOrthogonal.SplitOdd.ReflectionGeneration.SiegelReflections
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Algebra.Field.ZMod

/-!
# Nonsingular symmetries generate the binary split orthogonal group

Adapted from `Atlas/LinearGroups/Orthogonal/StableReflectionGenerationD.lean`
and the inclusion theorem in `DicksonElementaryD.lean`. Joint generation is
proved in every smaller rank, and elementary transformations are converted
into reflections only in the final space of dimension at least six. Thus the
exceptional four-dimensional case is never used as an induction hypothesis.
Only reflection generation is retained, without Dickson-invariant machinery.
Imports, namespaces and public boundaries are adapted for CFSG / Lean 4.33.

The final binary specialization converts subgroup membership into a literal
list of quadratic symmetries. Over `ZMod 2`, every nonzero quadratic value is
one, subtraction is addition, and each reflection is its own inverse. The
24-dimensional theorem uses exactly `VectorD 12 (ZMod 2)` and `formD 12 (ZMod 2)`.
-/

@[expose] public noncomputable section
universe u
open Theory.AlgebraicGroup
namespace ClassicalOrthogonal.ReflectionGeneration
open ClassicalOrthogonal.Quadratic

variable {F : Type u} [Field F]

/-- The stable-rank elementary subgroup is contained in the reflection subgroup,
including in characteristic two. -/
theorem elementaryD_le_reflections_stable (n : ℕ) :
    elementarySubgroup (formD (n + 3) F) ≤ reflectionSubgroup (formD (n + 3) F) := by
  apply elementary_le_reflections_stable _ polarD_nondegenerate
  rw [vectorD_finrank]
  omega

/-- Full split orthogonal groups in dimension at least six are generated by
nonsingular reflections, in every characteristic. -/
theorem reflectionSubgroupD_eq_top_stable (n : ℕ) :
    reflectionSubgroup (formD (n + 3) F) = ⊤ := by
  have h := elementary_sup_reflectionsD_eq_top (F := F) (n + 3)
  change elementarySubgroup (formD (n + 3) F) ⊔
    reflectionSubgroup (formD (n + 3) F) = ⊤ at h
  rwa [sup_eq_right.mpr (elementaryD_le_reflections_stable n)] at h

section Binary
variable {V : Type} [AddCommGroup V] [Module (ZMod 2) V]
variable (Q : QuadraticForm (ZMod 2) V)

/-- Over the binary field the quadratic reflection is the usual nonsingular symmetry. -/
theorem reflectionElement_binary_apply (a : V) (ha : Q a ≠ 0) (v : V) :
    (reflectionElement Q a ha).val v = v + Q.polarBilin a v • a := by
  have hbin : ∀ c : ZMod 2, c ≠ 0 → c = 1 := by decide
  change reflectionLinear Q a ha v = _
  rw [reflectionLinear_apply, hbin _ ha, inv_one, one_mul,
    ZModModule.sub_eq_add, polar_swap]

/-- Membership in the binary reflection subgroup gives an explicit list of
nonsingular vectors, with the order of composition recorded by `foldr`. -/
theorem binary_symmetry_factorization_of_mem (g : quadraticIsometrySubgroup Q)
    (hg : g ∈ reflectionSubgroup Q) :
    ∃ as : List {a : V // Q a = 1}, ∀ v,
      g.val v = as.foldr (fun a w => w + Q.polarBilin a.val w • a.val) v := by
  have step (a : V) (ha : Q a ≠ 0) (g : quadraticIsometrySubgroup Q)
      (ih : ∃ as : List {a : V // Q a = 1}, ∀ v,
        g.val v = as.foldr (fun a w => w + Q.polarBilin a.val w • a.val) v) :
      ∃ as : List {a : V // Q a = 1}, ∀ v,
        (reflectionElement Q a ha * g).val v =
          as.foldr (fun a w => w + Q.polarBilin a.val w • a.val) v := by
    obtain ⟨as,has⟩ := ih
    have hbin : ∀ c : ZMod 2, c ≠ 0 → c = 1 := by decide
    refine ⟨⟨a,hbin _ ha⟩ :: as, ?_⟩
    intro v
    change (reflectionElement Q a ha).val (g.val v) = _
    rw [reflectionElement_binary_apply,has]
    rfl
  induction hg using Subgroup.closure_induction_left with
  | one => exact ⟨[],fun _ => rfl⟩
  | mul_left r hr g _ ih =>
    obtain ⟨a,ha,rfl⟩ := hr
    exact step a ha g ih
  | inv_mul_cancel r hr g _ ih =>
    obtain ⟨a,ha,rfl⟩ := hr
    have hinv : (reflectionElement Q a ha)⁻¹ = reflectionElement Q a ha :=
      Subtype.ext (Module.reflection_inv (reflectionFunctional_self Q a ha))
    rw [hinv]
    exact step a ha g ih

/-- Every isometry of a binary split quadratic space of dimension at least six
is a product of its nonsingular symmetries. -/
theorem binary_split_symmetry_factorization (n : ℕ)
    (f : VectorD (n + 3) (ZMod 2) ≃ₗ[ZMod 2] VectorD (n + 3) (ZMod 2))
    (hf : ∀ v, formD (n + 3) (ZMod 2) (f v) = formD (n + 3) (ZMod 2) v) :
    ∃ as : List {a : VectorD (n + 3) (ZMod 2) // formD (n + 3) (ZMod 2) a = 1},
      ∀ v, f v = as.foldr
        (fun a w => w + (formD (n + 3) (ZMod 2)).polarBilin a.val w • a.val) v := by
  let g : quadraticIsometrySubgroup (formD (n + 3) (ZMod 2)) :=
    ⟨f,(mem_quadraticIsometrySubgroup _ _).mpr hf⟩
  exact binary_symmetry_factorization_of_mem _ g
    (by rw [reflectionSubgroupD_eq_top_stable]; trivial)

/-- The precise 24-dimensional binary split specialization: every linear
equivalence preserving the actual split form factors into nonsingular symmetries. -/
theorem binary_split_24_symmetry_factorization
    (f : VectorD 12 (ZMod 2) ≃ₗ[ZMod 2] VectorD 12 (ZMod 2))
    (hf : ∀ v, formD 12 (ZMod 2) (f v) = formD 12 (ZMod 2) v) :
    ∃ as : List {a : VectorD 12 (ZMod 2) // formD 12 (ZMod 2) a = 1},
      ∀ v, f v = as.foldr
        (fun a w => w + (formD 12 (ZMod 2)).polarBilin a.val w • a.val) v :=
  binary_split_symmetry_factorization 9 f hf

end Binary
end ClassicalOrthogonal.ReflectionGeneration
