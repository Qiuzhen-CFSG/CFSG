    fastQ (decode n.val) = 0 → checkPath 1 n.val (allPaths n) = true := by
  decide +kernel

private theorem perpPaths_checked : ∀ n : Byte, n ≠ 0 → n ≠ 1 →
    fastQ (decode n.val) = 0 → decode n.val (.inr 0) = 0 →
    checkPath 2 n.val (perpPaths n) = true ∧ checkFixed (perpPaths n) = true := by
  decide +kernel

private theorem nonperpPaths_checked : ∀ n : Byte,
    fastQ (decode n.val) = 0 → decode n.val (.inr 0) ≠ 0 →
    checkPath 16 n.val (nonperpPaths n) = true ∧ checkFixed (nonperpPaths n) = true := by
  decide +kernel

private theorem encode_ne_zero (v : V) (hv : v ≠ 0) : encode v ≠ 0 := by
  intro h
  apply hv
  rw [← decode_encode v, h]
  exact decode_zero

/-- Every nonzero singular vector is reached from `e₀` by actual Siegel roots. -/
theorem singular_transport (v : V) (hv : v ≠ 0) (hq : Q v = 0) :
    ∃ g : E, linear g (e 0) = v := by
  have hc := allPaths_checked (encode v) (encode_ne_zero v hv)
    (by rw [decode_encode, fastQ_eq]; exact hq)
  refine ⟨pathElement (allPaths (encode v)), ?_⟩
  have h := path_action 1 (encode v).val (allPaths (encode v)) hc
  rw [decode_one, decode_encode] at h
  exact h

/-- The `e₀`-stabilizer carries `e₁` to every other perpendicular singular vector. -/
theorem perpendicular_transport (v : V) (hv : v ≠ 0) (hq : Q v = 0)
    (he : v ≠ e 0) (hp : v (.inr 0) = 0) :
    ∃ g : E, linear g (e 0) = e 0 ∧ linear g (e 1) = v := by
  have hn : encode v ≠ 1 := by
    intro h
    apply he
    rw [← decode_encode v, h]
    exact decode_one
  have hc := perpPaths_checked (encode v) (encode_ne_zero v hv) hn
    (by rw [decode_encode, fastQ_eq]; exact hq) (by rw [decode_encode]; exact hp)
  refine ⟨pathElement (perpPaths (encode v)), ?_, ?_⟩
  · simpa only [decode_one] using path_fixes (perpPaths (encode v)) hc.2
  · have h := path_action 2 (encode v).val (perpPaths (encode v)) hc.1
    rw [decode_two, decode_encode] at h
    exact h

/-- The `e₀`-stabilizer carries `f₀` to every nonperpendicular singular vector. -/
theorem nonperpendicular_transport (v : V) (hq : Q v = 0) (hp : v (.inr 0) ≠ 0) :
    ∃ g : E, linear g (e 0) = e 0 ∧ linear g (f 0) = v := by
  have hc := nonperpPaths_checked (encode v)
    (by rw [decode_encode, fastQ_eq]; exact hq) (by rw [decode_encode]; exact hp)
  refine ⟨pathElement (nonperpPaths (encode v)), ?_, ?_⟩
  · simpa only [decode_one] using path_fixes (nonperpPaths (encode v)) hc.2
  · have h := path_action 16 (encode v).val (nonperpPaths (encode v)) hc.1
    rw [decode_sixteen, decode_encode] at h
    exact h

end ClassicalOrthogonal.BinaryEightObstruction.Simplicity.Geometry
