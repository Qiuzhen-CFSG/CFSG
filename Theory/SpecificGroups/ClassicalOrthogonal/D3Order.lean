private def paths (n : Code) : Trace :=
  pathsTable (Fin.ofNat 27 (n.val / 27)) (Fin.ofNat 27 n.val)

private theorem paths_checked : ∀ n : Code, n ≠ 0 →
    fastQ (decode n) = 0 → checkPath 1 n (paths n) = true := by
  decide +kernel

/-- Exact transport of every nonzero singular vector by an actual SL₄(3) exterior square. -/
theorem singular_transport (v : V) (hv : v ≠ 0) (hq : Q v = 0) :
    ∃ a : SL, (toOrthogonal a).val (e 0) = v := by
  have hn : encode v ≠ 0 := by
    intro h
    apply hv
    rw [← decode_encode v, h, decode_zero]
  have hc := paths_checked (encode v) hn (by rw [decode_encode, fastQ_eq]; exact hq)
  refine ⟨pathElement (paths (encode v)), ?_⟩
  have h := path_action 1 (encode v) (paths (encode v)) hc
  rw [decode_one, decode_encode] at h
  exact h

end ClassicalOrthogonal.D3ExteriorComparison.Ternary

namespace ClassicalOrthogonal.D3ExteriorComparison
open Theory.AlgebraicGroup Atlas.Order20160A8.Exterior

/-- Every elementary ternary split-six isometry is an exterior square. -/
theorem ternary_toElementary_surjective : Function.Surjective toElementary := by
  have hle : elementarySubgroup Q ≤ (toOrthogonal (F := ZMod 3)).range := by
    apply elementary_le_of_siegel_and_transport Q _ (e 0) (formD_e 0)
    · intro v hv
      exact ⟨Ternary.upper v, Ternary.upper_action v hv⟩
    · intro u hu hq
      obtain ⟨a, ha⟩ := Ternary.singular_transport u hu hq
      exact ⟨toOrthogonal a, ⟨a, rfl⟩, ha⟩
  intro g
  obtain ⟨a, ha⟩ := hle g.prop
  exact ⟨a, Subtype.ext ha⟩

/-- The coordinate certificates discharge surjectivity without using any orthogonal order. -/
theorem ternary_projectiveHom_surjective : Function.Surjective projectiveHom := by
  intro x
  obtain ⟨g, rfl⟩ := projectiveElementaryMap_surjective Q x
  obtain ⟨a, rfl⟩ := ternary_toElementary_surjective g
  exact ⟨QuotientGroup.mk a, projectiveHom_projection a⟩

/-- The exact order of the actual Siegel-generated projective split-D3 carrier over F₃. -/
theorem pomegaPlus_three_card : Nat.card (POmegaPlus 3 (ZMod 3)) = 6065280 := by
  rw [← Nat.card_congr (Equiv.ofBijective projectiveHom
    ⟨projectiveHom_injective, ternary_projectiveHom_surjective⟩)]
  exact psl4_three_card

end ClassicalOrthogonal.D3ExteriorComparison
