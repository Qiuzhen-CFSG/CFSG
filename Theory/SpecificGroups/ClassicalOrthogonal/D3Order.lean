public import Theory.SpecificGroups.ClassicalOrthogonal.D3ExteriorComparison.Projective
public import Theory.SpecificGroups.ClassicalOrthogonal.SplitOdd.LineTransport

/-!
# Exact ternary split-D3 order

The six explicit transvections in `SL₄(3)` act through the exterior-square
model on the literal split six-dimensional form.  A kernel-checked finite
certificate reaches every nonzero singular vector from the first coordinate
vector.  The singular-vector transport lemma then puts every Siegel generator
of the elementary split-D3 group in the exterior-square image.  The already
proved scalar kernel and the order of `PSL₄(3)` consequently give the exact
order of the projective carrier.

This is a finite coordinate verification of the D₃ exterior comparison; it
does not assume an order formula for an orthogonal group or a simplicity
theorem.  The coordinate certificate is generated from the six transvections
and checked by `decide +kernel` in the declarations below.

Source: GLS3 §2.7 and the ATLAS D3 exterior comparison port.
-/

open ClassicalOrthogonal Atlas.Order20160A8.Exterior Atlas.Order20160A8.Bivectors Matrix
namespace ClassicalOrthogonal.D3ExteriorComparison.Ternary
abbrev K := ZMod 3
abbrev V := VectorD 3 K
abbrev Q := formD 3 K
abbrev SL := SpecialLinearGroup (Fin 4) K
abbrev Code := Fin 729

def encode (x : V) : Code :=
  ⟨(x (.inl 0)).val + 3*(x (.inl 1)).val + 9*(x (.inl 2)).val +
    27*(x (.inr 0)).val + 81*(x (.inr 1)).val + 243*(x (.inr 2)).val, by
    have h0 := ZMod.val_lt (x (.inl 0)); have h1 := ZMod.val_lt (x (.inl 1))
    have h2 := ZMod.val_lt (x (.inl 2)); have h3 := ZMod.val_lt (x (.inr 0))
    have h4 := ZMod.val_lt (x (.inr 1)); have h5 := ZMod.val_lt (x (.inr 2))
    omega⟩

def decode (n : Code) : V :=
  Sum.elim ![(n.val : K), ((n.val / 3 : ℕ) : K), ((n.val / 9 : ℕ) : K)]
    ![((n.val / 27 : ℕ) : K), ((n.val / 81 : ℕ) : K), ((n.val / 243 : ℕ) : K)]

theorem decode_encode : ∀ v : V, decode (encode v) = v := by decide +kernel

theorem decode_one : decode 1 = e 0 := by decide +kernel
theorem decode_zero : decode 0 = 0 := by decide +kernel

def fastQ (x : V) : K :=
  x (.inl 0)*x (.inr 0) + x (.inl 1)*x (.inr 1) + x (.inl 2)*x (.inr 2)

theorem fastQ_eq (x : V) : fastQ x = Q x := by
  simp [fastQ, Q, formD_apply, Fin.sum_univ_succ, add_assoc]

noncomputable def generator : Fin 6 → SL := ![
  SpecialLinearGroup.transvection (show (0 : Fin 4) ≠ 1 by decide) 1,
  SpecialLinearGroup.transvection (show (1 : Fin 4) ≠ 2 by decide) 1,
  SpecialLinearGroup.transvection (show (2 : Fin 4) ≠ 3 by decide) 1,
  SpecialLinearGroup.transvection (show (1 : Fin 4) ≠ 0 by decide) 1,
  SpecialLinearGroup.transvection (show (2 : Fin 4) ≠ 1 by decide) 1,
  SpecialLinearGroup.transvection (show (3 : Fin 4) ≠ 2 by decide) 1]

def step (r : Fin 6) (x : V) : V :=
  let a := x (.inl 0); let b := x (.inl 1); let c := x (.inl 2)
  let d := x (.inr 0); let e := x (.inr 1); let f := x (.inr 2)
  ![Sum.elim ![a,b+f,c-e] ![d,e,f],
    Sum.elim ![a+b,b,c] ![d,e-d,f],
    Sum.elim ![a,b+c,c] ![d,e,f-e],
    Sum.elim ![a,b,c] ![d,e-c,f+b],
    Sum.elim ![a,b+a,c] ![d-e,e,f],
    Sum.elim ![a,b,c+b] ![d,e-f,f]] r

def stepLinear (r : Fin 6) : V →ₗ[K] V where
  toFun := step r
  map_add' x y := by
    funext i
    fin_cases r <;> rcases i with i | i <;> fin_cases i <;>
      simp [step, add_add_add_comm, add_sub_add_comm]
  map_smul' c x := by
    funext i
    fin_cases r <;> rcases i with i | i <;> fin_cases i <;>
      simp [step, mul_add, mul_sub]

private theorem generator_basis : ∀ (r : Fin 6) (i : Index 3),
    coordinates (exteriorMap (generator r).val (coordinates.symm (Pi.single i 1))) =
      step r (Pi.single i 1) := by
  decide +kernel

theorem generator_action (r : Fin 6) (x : V) :
    (toOrthogonal (generator r)).val x = step r x := by
  have h : (toOrthogonal (generator r)).val.toLinearMap = stepLinear r := by
    apply (Pi.basisFun K (Index 3)).ext
    intro i
    rw [Pi.basisFun_apply]
    change coordinates (exteriorMap (generator r).val (coordinates.symm (Pi.single i 1))) = step r (Pi.single i 1)
    exact generator_basis r i
  exact congrArg (fun f : V →ₗ[K] V => f x) h

abbrev Trace := List (Fin 6 × Code)

def checkPath : Code → Code → Trace → Bool
  | start, target, [] => decide (start = target)
  | start, target, (r, next) :: tail =>
    decide (step r (decode start) = decode next) && checkPath next target tail

noncomputable def pathElement : Trace → SL
  | [] => 1
  | (r, _) :: tail => pathElement tail * generator r

theorem path_action (start target : Code) (trace : Trace) (h : checkPath start target trace = true) :
    (toOrthogonal (pathElement trace)).val (decode start) = decode target := by
  induction trace generalizing start with
  | nil =>
    have he : start = target := of_decide_eq_true h
    subst target
    simp [pathElement]
  | cons s tail ih =>
    obtain ⟨hs, ht⟩ := Bool.and_eq_true_iff.mp h
    have hs' : step s.1 (decode start) = decode s.2 := of_decide_eq_true hs
    change (toOrthogonal (pathElement tail * generator s.1)).val (decode start) = _
    rw [map_mul]
    change (toOrthogonal (pathElement tail)).val
      ((toOrthogonal (generator s.1)).val (decode start)) = _
    rw [generator_action, hs']
    exact ih s.2 ht

noncomputable def upper (v : V) : SL :=
  ⟨!![1,0,-v (.inl 2),v (.inl 1);
       0,1,v (.inr 1),v (.inr 2);
       0,0,1,0;
       0,0,0,1], by
    simp [Matrix.det_succ_row_zero, Fin.sum_univ_succ,
      Matrix.submatrix_apply, Fin.succAbove]⟩

theorem upper_action (v : V) (hv : Q.polarBilin (e 0) v = 0) :
    toOrthogonal (upper v) = siegelElement Q (e 0) v (formD_e 0) hv := by
  have hv0 : v (.inr 0) = 0 := by
    rw [Quadratic.polar_swap, polarD_e] at hv
    exact hv
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  change coordinates (exteriorMap (upper v).val (coordinates.symm x)) = Quadratic.siegel Q (e 0) v x
  ext i
  rcases i with i | i <;> fin_cases i <;>
    simp [-QuadraticMap.polarBilin_apply_apply, upper, coordinates, exteriorMap, compound, first, second, Matrix.toLin'_apply,
      Matrix.mulVec, dotProduct, Fin.sum_univ_succ, Quadratic.siegel,
      Q, formD_apply, polarD_apply, e, hv0] <;> ring


