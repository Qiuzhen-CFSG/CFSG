module

public import Theory.SpecificGroups.OrthogonalFourBinary.IndexTwoNormalizer
public import Theory.SpecificGroups.ClassicalOrthogonal.SplitOdd.Elementary

/-!
# The intrinsic Ω-subgroup for the binary plus-four space

The actor in the Section 15.3 natural action is the full quadratic-isometry
subgroup.  In characteristic two the corresponding Ω-subgroup is the
(elementary) orthogonal subgroup generated by the Siegel isometries of the
same quadratic form.  This definition is intrinsic to the existing quadratic
space; it does not identify Ω with an arbitrary subgroup having the expected
order.

The finite Sylow/line calculation is recorded separately by the Section 15.3
owner, where it can be transported through an actual compatible action.
-/

@[expose] public noncomputable section

namespace OrthogonalFourBinary

open Theory.AlgebraicGroup

/-- The full quadratic-isometry group of the fixed binary plus-four space. -/
abbrev IsometryGroup := quadraticIsometrySubgroup (k := F) (V := Space) form

/-- The genuine characteristic-two Ω-subgroup of the fixed quadratic space. -/
noncomputable abbrev omega : Subgroup IsometryGroup :=
  ClassicalOrthogonal.elementarySubgroup form

@[simp] theorem mem_omega_iff (g : IsometryGroup) :
    g ∈ omega ↔ g ∈ ClassicalOrthogonal.elementarySubgroup form := Iff.rfl

end OrthogonalFourBinary
