module

public import Theory.SpecificGroups.OrthogonalFourBinary.SylowGeometry.Coordinates

/-!
# Genuine Ω in the binary plus-four isometry group

Siegel transformations preserve each ruling of the singular lines. Conversely,
equal reflection parity on the two definite planes gives a word in their two
rotations, simultaneous reflection, and interchange. Each of these four factors
is explicitly a Siegel transformation or a product of two such transformations.
Thus the parity test identifies the subgroup generated by the actual Siegel
formulas, and only then yields its order 36 and index two.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), the quadratic
space on pp.1121--1122 and 15.3.66(1), printed p.1152. The Siegel convention is
that of ClassicalOrthogonal.SplitOdd.Siegel (unhalved polar pairing).
-/

@[expose] public section

open Subgroup Theory.AlgebraicGroup
namespace OrthogonalFourBinary.SylowGeometry
open TerminalLines
set_option synthInstance.maxSize 10000

def rulingPair (a b : Space) : Prop :=
  ∃ i : Fin 3, a.2 = planeEval (i,0) a.1 ∧ b.2 = planeEval (i,0) b.1
instance (a b : Space) : Decidable (rulingPair a b) :=
  inferInstanceAs (Decidable (∃ _i : Fin 3, _))
def ruling : Subgroup OrthogonalFourBinary.IsometryGroup where
  carrier g := ∀ a b, rulingPair (g.val a) (g.val b) ↔ rulingPair a b
  one_mem' := fun _ _ => Iff.rfl
  mul_mem' := fun ha hb a b => (ha _ _).trans (hb a b)
  inv_mem' := by
    intro g hg a b
    have h := hg (g⁻¹.val a) (g⁻¹.val b)
    have ha : g.val (g⁻¹.val a) = a := by
      change (g*g⁻¹).val a = a
      rw [mul_inv_cancel]
      rfl
    have hb : g.val (g⁻¹.val b) = b := by
      change (g*g⁻¹).val b = b
      rw [mul_inv_cancel]
      rfl
    rw [ha,hb] at h
    exact h.symm

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
private theorem eval_ruling : ∀ i : Code,
    (∀ a b, rulingPair (eval i a) (eval i b) ↔ rulingPair a b) ↔
      i.1.2 = i.2.1.2 := by decide +kernel

theorem codeMap_mem_ruling (i : Code) : codeMap i ∈ ruling ↔ i.1.2 = i.2.1.2 := by
  change (∀ a b, rulingPair (candidate i a) (candidate i b) ↔ rulingPair a b) ↔ _
  simp only [candidate_eval]
  exact eval_ruling i

def polarEval (u v : Space) : F := q (u+v) - q u - q v

theorem polar_eval (u v : Space) : form.polarBilin u v = polarEval u v := rfl

def siegelEval (u v x : Space) : Space :=
  x + polarEval x v • u - polarEval x u • v - (q v * polarEval x u) • u

theorem siegel_eval (u v x : Space) :
    ClassicalOrthogonal.Quadratic.siegel form u v x = siegelEval u v x := rfl

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
private theorem siegel_balanced : ∀ u v : Space, q u = 0 → polarEval u v = 0 →
    ∃ i : Code, i.1.2 = i.2.1.2 ∧ ∀ x : Space, siegelEval u v x = eval i x := by
  decide +kernel

theorem omega_le_ruling : omega ≤ ruling := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨u,v,hu,huv,rfl⟩
  obtain ⟨i,hi,h⟩ := siegel_balanced u v hu huv
  have he : ClassicalOrthogonal.siegelElement form u v hu huv = codeMap i := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
    change ClassicalOrthogonal.Quadratic.siegel form u v x = candidate i x
    rw [siegel_eval, candidate_eval]
    exact h x
  rw [he]
  exact (codeMap_mem_ruling i).mpr hi

private def s0 : OrthogonalFourBinary.IsometryGroup :=
  ClassicalOrthogonal.siegelElement form ((0,1),(0,1)) ((0,1),(0,0))
    (by decide +kernel) (by decide +kernel)
private def s1 : OrthogonalFourBinary.IsometryGroup :=
  ClassicalOrthogonal.siegelElement form ((1,1),(0,1)) ((1,1),(0,0))
    (by decide +kernel) (by decide +kernel)
private def s2 : OrthogonalFourBinary.IsometryGroup :=
  ClassicalOrthogonal.siegelElement form ((0,1),(1,1)) ((0,1),(0,0))
    (by decide +kernel) (by decide +kernel)
private def s3 : OrthogonalFourBinary.IsometryGroup :=
  ClassicalOrthogonal.siegelElement form ((1,1),(1,1)) ((1,1),(0,0))
    (by decide +kernel) (by decide +kernel)
private def s4 : OrthogonalFourBinary.IsometryGroup :=
  ClassicalOrthogonal.siegelElement form ((1,1),(1,1)) ((1,0),(1,0))
    (by decide +kernel) (by decide +kernel)

def leftRotation : Code := ((1,0),(0,0),false)
def rightRotation : Code := ((0,0),(1,0),false)
def doubleFlip : Code := ((0,1),(0,1),false)
def interchange : Code := ((0,0),(0,0),true)

private theorem leftRotation_siegel : codeMap leftRotation = s0*s1 := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  change candidate leftRotation x =
    ClassicalOrthogonal.Quadratic.siegel form ((0,1),(0,1)) ((0,1),(0,0))
      (ClassicalOrthogonal.Quadratic.siegel form ((1,1),(0,1)) ((1,1),(0,0)) x)
  simp only [candidate_eval, siegel_eval]
  exact (show ∀ x : Space, eval leftRotation x =
    siegelEval ((0,1),(0,1)) ((0,1),(0,0))
      (siegelEval ((1,1),(0,1)) ((1,1),(0,0)) x) by decide +kernel) x

private theorem rightRotation_siegel : codeMap rightRotation = s0*s2 := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  change candidate rightRotation x =
    ClassicalOrthogonal.Quadratic.siegel form ((0,1),(0,1)) ((0,1),(0,0))
      (ClassicalOrthogonal.Quadratic.siegel form ((0,1),(1,1)) ((0,1),(0,0)) x)
  simp only [candidate_eval, siegel_eval]
  exact (show ∀ x : Space, eval rightRotation x =
    siegelEval ((0,1),(0,1)) ((0,1),(0,0))
      (siegelEval ((0,1),(1,1)) ((0,1),(0,0)) x) by decide +kernel) x

private theorem doubleFlip_siegel : codeMap doubleFlip = s3 := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  change candidate doubleFlip x =
    ClassicalOrthogonal.Quadratic.siegel form ((1,1),(1,1)) ((1,1),(0,0)) x
  simp only [candidate_eval, siegel_eval]
  exact (show ∀ x : Space, eval doubleFlip x =
    siegelEval ((1,1),(1,1)) ((1,1),(0,0)) x by decide +kernel) x

private theorem interchange_siegel : codeMap interchange = s4 := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  change candidate interchange x =
    ClassicalOrthogonal.Quadratic.siegel form ((1,1),(1,1)) ((1,0),(1,0)) x
  simp only [candidate_eval, siegel_eval]
  exact (show ∀ x : Space, eval interchange x =
    siegelEval ((1,1),(1,1)) ((1,0),(1,0)) x by decide +kernel) x

theorem generators_mem_omega : codeMap leftRotation ∈ omega ∧
    codeMap rightRotation ∈ omega ∧ codeMap doubleFlip ∈ omega ∧
    codeMap interchange ∈ omega := by
  rw [leftRotation_siegel, rightRotation_siegel, doubleFlip_siegel, interchange_siegel]
  have h0 : s0 ∈ omega := ClassicalOrthogonal.siegelElement_mem _ _ _ _ _
  have h1 : s1 ∈ omega := ClassicalOrthogonal.siegelElement_mem _ _ _ _ _
  have h2 : s2 ∈ omega := ClassicalOrthogonal.siegelElement_mem _ _ _ _ _
  have h3 : s3 ∈ omega := ClassicalOrthogonal.siegelElement_mem _ _ _ _ _
  have h4 : s4 ∈ omega := ClassicalOrthogonal.siegelElement_mem _ _ _ _ _
  exact ⟨omega.mul_mem h0 h1, omega.mul_mem h0 h2, h3, h4⟩

private theorem codeMap_pow_apply (i : Code) (n : ℕ) (x : Space) :
    ((codeMap i)^n).val x = (eval i)^[n] x := by
  change (candidate i ^ n) x = _
  rw [LinearEquiv.pow_apply]
  have h : (candidate i : Space → Space) = eval i := funext (candidate_eval i)
  rw [h]

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
private theorem finite_factorization : ∀ i : Code, i.1.2 = i.2.1.2 → ∀ x : Space,
    eval i x = (eval leftRotation)^[i.1.1.val]
      ((eval rightRotation)^[i.2.1.1.val]
        ((eval doubleFlip)^[i.1.2.val]
          ((eval interchange)^[if i.2.2 then 1 else 0] x))) := by decide +kernel

theorem balanced_factorization (i : Code) (hi : i.1.2 = i.2.1.2) :
    codeMap i = codeMap leftRotation ^ i.1.1.val * codeMap rightRotation ^ i.2.1.1.val *
      codeMap doubleFlip ^ i.1.2.val * codeMap interchange ^ (if i.2.2 then 1 else 0) := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  change candidate i x = ((codeMap leftRotation)^i.1.1.val).val
    (((codeMap rightRotation)^i.2.1.1.val).val
      (((codeMap doubleFlip)^i.1.2.val).val
        (((codeMap interchange)^(if i.2.2 then 1 else 0)).val x)))
  simp only [candidate_eval, codeMap_pow_apply]
  exact finite_factorization i hi x

theorem ruling_le_omega : ruling ≤ omega := by
  intro g hg
  obtain ⟨i,rfl⟩ := codeMap_bijective.surjective g
  rw [balanced_factorization i ((codeMap_mem_ruling i).mp hg)]
  obtain ⟨hL,hR,hD,hI⟩ := generators_mem_omega
  exact omega.mul_mem
    (omega.mul_mem (omega.mul_mem (omega.pow_mem hL _) (omega.pow_mem hR _))
      (omega.pow_mem hD _)) (omega.pow_mem hI _)

/-- Siegel-generated Ω is exactly the subgroup preserving either ruling. -/
theorem omega_eq_ruling : omega = ruling := le_antisymm omega_le_ruling ruling_le_omega

/-- An isometry belongs to genuine Ω exactly when its two plane permutations
have the same reflection parity; interchange of the planes is allowed. -/
theorem codeMap_mem_omega (i : Code) : codeMap i ∈ omega ↔ i.1.2 = i.2.1.2 := by
  rw [omega_eq_ruling, codeMap_mem_ruling]

/-- Ω has order 36, computed after identification with the actual generators. -/
theorem omega_card : Nat.card omega = 36 := by
  let e : {i : Code // i.1.2 = i.2.1.2} ≃ omega :=
    codeEquiv.subtypeEquiv (fun i => (codeMap_mem_omega i).symm)
  rw [← Nat.card_congr e, Nat.card_eq_fintype_card]
  decide +kernel

/-- The Siegel-generated Ω-subgroup has index two in the full isometry group. -/
theorem omega_index : omega.index = 2 := by
  have h := omega.card_mul_index
  rw [omega_card, isometryGroup_card] at h
  omega

end OrthogonalFourBinary.SylowGeometry
