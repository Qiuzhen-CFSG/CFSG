module
public import Theory.SpecificGroups.OrthogonalFourBinary.SylowGeometry.Coordinates
public import Mathlib.GroupTheory.IndexNormal

/-!
# Marking the order-36 elementary-nine actor

The binary plus-four isometry model supplies the marked vector needed by the
order-36 elementary-nine source row. An order-four generator interchanges the
two definite planes; its square fixes a nonsingular vector in one plane. The
plane rotations fixing that vector, together with the generator, generate the
full order-nine residual. Orbit-stabilizer then gives a point stabilizer of
order six, and its intersection with the cyclic Sylow subgroup is the
order-two subgroup generated by the square.

All statements retain the literal vector action and the prescribed subgroup.
Source: Aschbacher--Smith 15.1.16b and the natural O₄⁺(2) coordinates,
printed pp.1092 and 1121--1122.
-/

@[expose] public section
open Subgroup
namespace OrthogonalFourBinary.MarkedNine
open TerminalLines SylowGeometry
set_option synthInstance.maxSize 10000

def rotEval (i : RotationCode) (v : Space) : Space :=
  (planeEval (⟨i.toAdd.1.val,ZMod.val_lt _⟩,0) v.1,
    planeEval (⟨i.toAdd.2.val,ZMod.val_lt _⟩,0) v.2)

private theorem rotation_eval : ∀ i : RotationCode, ∀ v : Space,
    rotation i v = rotEval i v := by decide +kernel

private def b0 : Space := ((1,0),(0,0))
private def b1 : Space := ((0,1),(0,0))
private def b2 : Space := ((0,0),(1,0))
private def b3 : Space := ((0,0),(0,1))
private def samples (f : Space → Space) := (f b0,f b1,f b2,f b3)

private theorem samples_injective (e f : Space ≃ₗ[F] Space)
    (h : samples e = samples f) : e = f := by
  have h0 := congrArg (fun x => x.1) h
  have h1 := congrArg (fun x => x.2.1) h
  have h2 := congrArg (fun x => x.2.2.1) h
  have h3 := congrArg (fun x => x.2.2.2) h
  apply LinearEquiv.ext
  intro w
  have hw : w = w.1.1 • b0 + w.1.2 • b1 + w.2.1 • b2 + w.2.2 • b3 := by
    exact (show ∀ w : Space,
      w = w.1.1 • b0 + w.1.2 • b1 + w.2.1 • b2 + w.2.2 • b3 by decide +kernel) w
  rw [hw]
  change e _ = f _
  simp only [map_add,map_smul]
  exact congrArg₂ (· + ·) (congrArg₂ (· + ·) (congrArg₂ (· + ·)
    (congrArg (w.1.1 • ·) h0) (congrArg (w.1.2 • ·) h1))
    (congrArg (w.2.1 • ·) h2)) (congrArg (w.2.2 • ·) h3)

private def FourCode (k : Code) : Prop :=
  samples (fun v => eval k (eval k (eval k (eval k v)))) = samples id ∧
    samples (fun v => eval k (eval k v)) ≠ samples id

private instance (k : Code) : Decidable (FourCode k) :=
  inferInstanceAs (Decidable (_ ∧ _))

private theorem finite_fixed : ∀ k : Code, FourCode k → k.2.2 = true ∧
    ∃ z : Plane, z ≠ 0 ∧ eval k (eval k (z,0)) = (z,0) := by
  decide +kernel

private theorem finite_nonsingular : ∀ z : Space,
    z.1 ≠ 0 → z.2 = 0 → q z = 1 := by decide +kernel

private theorem finite_not_fixed : ∀ k : Code, k.2.2 = true → ∀ z : Space,
    z.1 ≠ 0 → z.2 = 0 → eval k z ≠ z := by decide +kernel

private theorem finite_rotation_fixes : ∀ j : ZMod 3, ∀ z : Space,
    z.2 = 0 → rotEval (Multiplicative.ofAdd (0,j)) z = z := by decide +kernel

private theorem finite_rotation_split : ∀ k : Code, k.2.2 = true → ∀ i : RotationCode,
    ∀ v : Space,
      rotEval i (eval k v) = rotEval (Multiplicative.ofAdd (0,i.toAdd.2))
        (eval k (rotEval (Multiplicative.ofAdd
          (0,if k.1.2 = 0 then i.toAdd.1 else -i.toAdd.1)) v)) := by decide +kernel

private theorem finite_swapped_zero : ∀ k : Code, k.2.2 = true → ∀ z : Space,
    z.2 = 0 → (eval k z).1 = 0 := by decide +kernel

private theorem finite_plane_orbit : ∀ x y : Space, q x = 1 → q y = 1 →
    (x.1 = 0 ↔ y.1 = 0) → ∃ i : RotationCode, rotEval i x = y := by decide +kernel

private theorem fourCode_of_order (k : Code) (h : orderOf (codeMap k) = 4) : FourCode k := by
  constructor
  · have hh : codeMap k ^ 4 = 1 := h ▸ pow_orderOf_eq_one (codeMap k)
    have hv := congrArg (fun a : IsometryGroup => samples a.val) hh
    change samples (fun v => candidate k (candidate k (candidate k (candidate k v)))) = samples id at hv
    simpa only [candidate_eval] using hv
  · intro he
    have hh : codeMap k ^ 2 = 1 := by
      apply Subtype.ext
      apply samples_injective
      change samples (fun v => candidate k (candidate k v)) = samples id
      simpa only [candidate_eval] using he
    have hd := orderOf_dvd_of_pow_eq_one hh
    rw [h] at hd
    norm_num at hd

/-- An order-four isometry selects a nonsingular vector in one definite plane.
Its fixing rotations and the isometry generate the full rotation residual. -/
theorem order_four_vector_geometry (r : IsometryGroup) (hr : orderOf r = 4) :
    ∃ z : Space, form z = 1 ∧ (r ^ 2).val z = z ∧ r.val z ≠ z ∧
      rotations ≤ (rotations ⊓ MulAction.stabilizer IsometryGroup z) ⊔ zpowers r ∧
      ∀ y : Space, form y = 1 → ∃ a ∈ rotations, a.val z = y ∨ a.val (r.val z) = y := by
  obtain ⟨k,rfl⟩ := codeMap_bijective.surjective r
  have hk := fourCode_of_order k hr
  obtain ⟨hs,z₀,hz₀,hfix⟩ := finite_fixed k hk
  let z : Space := (z₀,0)
  have hz : z.1 ≠ 0 := hz₀
  have hzero : z.2 = 0 := rfl
  refine ⟨z,finite_nonsingular z hz hzero,?_,?_,?_,?_⟩
  · change candidate k (candidate k z) = z
    simpa only [candidate_eval] using hfix
  · change candidate k z ≠ z
    rw [candidate_eval]
    exact finite_not_fixed k hs z hz hzero
  · rintro _ ⟨i,rfl⟩
    let a := i.toAdd.2
    let b := if k.1.2 = 0 then i.toAdd.1 else -i.toAdd.1
    have hab := finite_rotation_split k hs i
    let a' := rotationHom (Multiplicative.ofAdd (0,a))
    let b' := rotationHom (Multiplicative.ofAdd (0,b))
    have ha : a' ∈ rotations ⊓ MulAction.stabilizer IsometryGroup z :=
      ⟨⟨_,rfl⟩, by
        change rotation (Multiplicative.ofAdd (0,a)) z = z
        rw [rotation_eval]
        exact finite_rotation_fixes a z hzero⟩
    have hb : b' ∈ rotations ⊓ MulAction.stabilizer IsometryGroup z :=
      ⟨⟨_,rfl⟩, by
        change rotation (Multiplicative.ofAdd (0,b)) z = z
        rw [rotation_eval]
        exact finite_rotation_fixes b z hzero⟩
    have he : rotationHom i = a' * codeMap k * b' * (codeMap k)⁻¹ := by
      apply eq_mul_inv_iff_mul_eq.mpr
      apply Subtype.ext
      apply LinearEquiv.ext
      intro v
      change rotation i (candidate k v) =
        rotation (Multiplicative.ofAdd (0,a))
          (candidate k (rotation (Multiplicative.ofAdd (0,b)) v))
      simpa only [rotation_eval,candidate_eval] using hab v
    rw [he]
    let L := (rotations ⊓ MulAction.stabilizer IsometryGroup z) ⊔ zpowers (codeMap k)
    have hL1 : rotations ⊓ MulAction.stabilizer IsometryGroup z ≤ L := le_sup_left
    have hL2 : zpowers (codeMap k) ≤ L := le_sup_right
    exact L.mul_mem (L.mul_mem (L.mul_mem (hL1 ha) (hL2 (mem_zpowers _)))
      (hL1 hb)) (L.inv_mem (hL2 (mem_zpowers _)))
  · intro y hy
    by_cases hy0 : y.1 = 0
    · have hqkz : q (eval k z) = 1 := by
        rw [← candidate_eval,← form_eval,candidate_form]
        exact finite_nonsingular z hz hzero
      obtain ⟨i,hi⟩ := finite_plane_orbit (eval k z) y hqkz hy
        (iff_of_true (finite_swapped_zero k hs z hzero) hy0)
      exact ⟨rotationHom i,⟨i,rfl⟩,Or.inr
        (by change rotation i (candidate k z) = y
            simpa only [rotation_eval,candidate_eval] using hi)⟩
    · obtain ⟨i,hi⟩ := finite_plane_orbit z y (finite_nonsingular z hz hzero) hy
        (iff_of_false hz hy0)
      exact ⟨rotationHom i,⟨i,rfl⟩,Or.inl
        (by change rotation i z = y
            simpa only [rotation_eval] using hi)⟩

/-- The actual stabilizer for an injective isometry action. -/
def pointStabilizer {D : Type*} [Group D] (f : D →* IsometryGroup) (z : Space) : Subgroup D :=
  (MulAction.stabilizer IsometryGroup z).comap f

private theorem rotations_card : Nat.card rotations = 9 := by
  rw [← residual_eq_rotations,← Nat.card_congr residualEquiv.toEquiv]
  change Nat.card (Multiplicative (ZMod 3 × ZMod 3)) = 9
  rw [Nat.card_congr (Multiplicative.toAdd (α := ZMod 3 × ZMod 3)),Nat.card_prod,Nat.card_zmod]

private theorem rotations_le_range {D : Type*} [Group D] [Finite D]
    (f : D →* IsometryGroup) (hf : Function.Injective f) (hc : Nat.card D = 36) :
    rotations ≤ f.range := by
  have hrange : Nat.card f.range = 36 := (Nat.card_congr (MonoidHom.ofInjective hf).toEquiv).symm.trans hc
  have hi : f.range.index = 2 := by
    have hh := f.range.index_mul_card
    rw [hrange,isometryGroup_card] at hh
    omega
  let _ := Subgroup.normal_of_index_eq_two hi
  rintro _ ⟨i,rfl⟩
  have h2 : rotationHom i ^ 2 ∈ f.range := by
    simpa [hi] using f.range.pow_index_mem (rotationHom i)
  have h4 : rotationHom i ^ 4 = rotationHom i := by
    rw [show (4 : ℕ) = 3+1 from rfl,pow_succ,rotation_cube,one_mul]
  have hh := f.range.pow_mem h2 2
  rw [← pow_mul,show 2*2=4 from rfl,h4] at hh
  exact hh

private theorem square_fixed_in_cyclic_four {D : Type*} [Group D] [Finite D]
    (r a : D) (hr : orderOf r = 4) (ha : a ∈ zpowers r) (ha2 : a ^ 2 = 1) :
    a = 1 ∨ a = r ^ 2 := by
  classical
  obtain ⟨n,hn,he⟩ := Finset.mem_image.mp (mem_zpowers_iff_mem_range_orderOf.mp ha)
  have hn4 : n < 4 := by simpa [hr] using Finset.mem_range.mp hn
  have hd : 4 ∣ n*2 := by
    have hh : r ^ (n*2) = 1 := by rw [pow_mul,he,ha2]
    simpa [hr] using orderOf_dvd_of_pow_eq_one hh
  have hn02 : n=0 ∨ n=2 := by omega
  rcases hn02 with rfl | rfl
  · exact Or.inl (by simpa using he.symm)
  · exact Or.inr he.symm

/-- A cyclic-four Sylow in the actual order36 image admits the marked vector. -/
theorem exists_marked_vector {D : Type*} [Group D] [Finite D]
    (f : D →* IsometryGroup) (hf : Function.Injective f) (hc : Nat.card D = 36)
    (S : Subgroup D) [IsCyclic S] (hS : Nat.card S = 4) :
    ∃ z : Space, z ≠ 0 ∧
      (∀ a ∈ S, a ^ 2 = 1 → (f a).val z = z) ∧
      pointStabilizer f z ⊔ S = ⊤ ∧
      Nat.card (pointStabilizer f z) = 6 ∧
      ∃ P : Sylow 2 (pointStabilizer f z),
        (P : Subgroup (pointStabilizer f z)).map (pointStabilizer f z).subtype =
          S ⊓ pointStabilizer f z := by
  classical
  obtain ⟨r,hrgen⟩ := IsCyclic.exists_generator (α := S)
  have hr : orderOf (r : D) = 4 := (Subgroup.orderOf_coe r).trans
    ((orderOf_eq_card_of_forall_mem_zpowers hrgen).trans hS)
  have hrS : zpowers (r : D) = S := by
    apply le_antisymm (zpowers_le.mpr r.property)
    intro a ha
    obtain ⟨n,hn⟩ := hrgen ⟨a,ha⟩
    exact ⟨n,congrArg Subtype.val hn⟩
  obtain ⟨z,hqz,hfix,hnfix,hgen,horbit⟩ :=
    order_four_vector_geometry (f r) ((orderOf_injective f hf r).trans hr)
  let K := pointStabilizer f z
  have hrot := rotations_le_range f hf hc
  have hJ : rotations ≤ (K ⊔ S).map f := by
    apply hgen.trans
    apply sup_le
    · rintro a ⟨ha,haz⟩
      obtain ⟨b,hb⟩ := hrot ha
      have hdK : b ∈ K := by
        change (f b).val z = z
        rw [hb]
        exact haz
      have hh : b ∈ K ⊔ S := (show K ≤ K ⊔ S from le_sup_left) hdK
      exact ⟨b,hh,hb⟩
    · apply zpowers_le.mpr
      exact mem_map_of_mem f ((show S ≤ K ⊔ S from le_sup_right) r.property)
  have hJgen : K ⊔ S = ⊤ := by
    have h9 : 9 ∣ Nat.card (K ⊔ S : Subgroup D) := by
      have hh := card_dvd_of_le hJ
      rwa [rotations_card,card_map_of_injective hf] at hh
    have h4 : 4 ∣ Nat.card (K ⊔ S : Subgroup D) := by
      simpa [hS] using card_dvd_of_le (show S ≤ K ⊔ S from le_sup_right)
    apply eq_top_of_card_eq
    rw [hc]
    apply Nat.dvd_antisymm
    · simpa [hc] using (K ⊔ S).card_subgroup_dvd_card
    · exact (show Nat.Coprime 9 4 by decide).mul_dvd_of_dvd_of_dvd h9 h4
  let _ : MulAction D Space := MulAction.compHom Space f
  have horbitEq : MulAction.orbit D z = {y : Space | form y = 1} := by
    ext y
    constructor
    · rintro ⟨g,rfl⟩
      exact ((Theory.AlgebraicGroup.mem_quadraticIsometrySubgroup form _).mp (f g).property z).trans hqz
    · intro hy
      obtain ⟨a,ha,haz | haz⟩ := horbit y hy
      · obtain ⟨b,hb⟩ := hrot ha
        exact ⟨b, by
          change (f b).val z = y
          rw [hb]
          exact haz⟩
      · obtain ⟨b,hb⟩ := hrot ha
        exact ⟨b * r, by
          change (f (b * r)).val z = y
          rw [map_mul, hb]
          exact haz⟩
  have hKcard : Nat.card K = 6 := by
    have hh := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup D z)
    have hset : Nat.card ({y : Space | form y = 1} : Set Space) = 6 := by
      change Nat.card {y : Space // form y = 1} = 6
      exact nonsingular_card
    rw [Nat.card_prod,horbitEq,hset,hc] at hh
    change 6 * Nat.card K = 36 at hh
    omega
  have hr2K : (r : D)^2 ∈ K := by
    change (f ((r : D)^2)).val z = z
    simpa only [map_pow] using hfix
  have hrnotK : (r : D) ∉ K := hnfix
  have hHcard : Nat.card (S ⊓ K : Subgroup D) = 2 := by
    have h4 : Nat.card (S ⊓ K : Subgroup D) ∣ 4 := by
      simpa [hS] using card_dvd_of_le (show S ⊓ K ≤ S from inf_le_left)
    have h6 : Nat.card (S ⊓ K : Subgroup D) ∣ 6 := by
      simpa [hKcard] using card_dvd_of_le (show S ⊓ K ≤ K from inf_le_right)
    have h2 : 2 ∣ Nat.card (S ⊓ K : Subgroup D) := by
      have hh := card_dvd_of_le (zpowers_le.mpr
        (show (r : D)^2 ∈ S ⊓ K from ⟨S.pow_mem r.property 2,hr2K⟩))
      convert hh using 1
      norm_num [Nat.card_zpowers,orderOf_pow,hr]
    have hdiv := Nat.dvd_gcd h4 h6
    norm_num at hdiv
    exact Nat.dvd_antisymm hdiv h2
  have hHcard' : Nat.card ((S ⊓ K).subgroupOf K) = 2 :=
    (Nat.card_congr (subgroupOfEquivOfLe (show S ⊓ K ≤ K from inf_le_right)).toEquiv).trans hHcard
  have hPgroup : IsPGroup 2 ((S ⊓ K).subgroupOf K) := by
    exact IsPGroup.of_card (n := 1) (by simpa only [pow_one] using hHcard')
  have hPindex : ((S ⊓ K).subgroupOf K).index = 3 := by
    have hi := ((S ⊓ K).subgroupOf K).index_mul_card
    rw [hHcard',hKcard] at hi
    omega
  let P : Sylow 2 K := hPgroup.toSylow (by rw [hPindex]; decide)
  refine ⟨z,?_,?_,hJgen,hKcard,⟨P,?_⟩⟩
  · intro hzero
    simp [hzero] at hqz
  · intro a ha ha2
    rcases square_fixed_in_cyclic_four (r : D) a hr (hrS.symm ▸ ha) ha2 with rfl | rfl
    · simp
    · simpa only [map_pow] using hfix
  · exact map_subgroupOf_eq_of_le inf_le_right

end OrthogonalFourBinary.MarkedNine
