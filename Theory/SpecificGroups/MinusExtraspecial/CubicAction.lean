module

public import Theory.SpecificGroups.MinusExtraspecial.CentralStructure
public import Theory.SpecificGroups.SL2.BinaryTetrahedral

/-!
# Coordinates for a cubic action on the minus extraspecial group

The standard action cycles the quaternion factor and fixes the dihedral
factor. Two commutators with this action suffice to express each quaternion
element. These are small calculations on the already constructed factors.

`HasCubicNormalForm` states the remaining automorphism conjugacy problem;
it is not asserted here. Its consumer transports these coordinates to the
actual core of an involution centralizer and identifies the closure of an
order-three subgroup with the binary tetrahedral group.

Source: Aschbacher, *Sporadic Groups* (1994), the local construction in
47.5, p.263, and the quaternion--dihedral coordinates on p.265.
-/

@[expose] public section

namespace MinusExtraspecial.CubicAction
open GLS3.Chapter5.SchurPresentation

/-- The cubic automorphism fixes the two dihedral coordinates. -/
def cycle : MulAut Model where
  toFun x := ⟨q8Cycle x.q, x.r, x.s⟩
  invFun x := ⟨q8Cycle.symm x.q, x.r, x.s⟩
  left_inv x := by cases x; simp
  right_inv x := by cases x; simp
  map_mul' := by
    intro x y
    apply Model.ext
    · change q8Cycle (x.q * y.q * (if x.s && y.r then z else 1)) =
        q8Cycle x.q * q8Cycle y.q * (if x.s && y.r then z else 1)
      rw [map_mul, map_mul]
      congr 1
      split <;> decide
    · rfl
    · rfl

theorem cycle_quaternion (q : QuaternionGroup 2) :
    cycle (quaternion q) = quaternion (q8Cycle q) := rfl

theorem cycle_dihedral (d : DihedralGroup 4) : cycle (dihedral d) = dihedral d := by
  revert d
  decide +kernel

theorem cycle_cube : cycle ^ 3 = 1 := by
  apply DFunLike.ext
  intro x
  exact (show ∀ x : Model, cycle (cycle (cycle x)) = x from by decide +kernel) x

theorem cycle_ne_one : cycle ≠ 1 := by
  intro h
  have := DFunLike.congr_fun h (quaternion (.a 1))
  contradiction

/-- The moved quaternion factor is generated by actual cubic commutators. -/
theorem quaternion_commutators (q : QuaternionGroup 2) :
    ∃ a b : QuaternionGroup 2,
      (a * q8Cycle a⁻¹) * (b * q8Cycle b⁻¹) = q := by
  revert q
  decide +kernel

/-- A precise finite automorphism problem, with no local group conclusion. -/
def HasCubicNormalForm : Prop :=
  ∀ a : MulAut Model, a ^ 3 = 1 → a ≠ 1 →
    ∃ e : Model ≃* Model, ∀ q : Model, e (a q) = cycle (e q)

end MinusExtraspecial.CubicAction
