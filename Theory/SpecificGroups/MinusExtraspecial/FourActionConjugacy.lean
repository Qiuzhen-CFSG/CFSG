module
public import Theory.SpecificGroups.MinusExtraspecial.FivePointLifts
public import Theory.Representation.BinaryAlternatingFiveBorel
public import Theory.Representation.BinaryAlternatingNaturalCohomology
import Mathlib.Tactic.LinearCombination

/-!
# Inner conjugacy of the marked four-point actions on the minus core

Two A₄ actions inducing the same original permutations of four of the five
singular central cosets differ by an inner automorphism of the core. The sign
difference on those four lifts is a full binary permutation-module cocycle.
Its principal vector extends to an even five-vector, and the commutator
pairing realizes that vector by an actual core element. The fifth lift is
fixed because A₄ is generated by cubics.

This is the marked point-subgroup correction needed after Gaschütz in
Baumeister, A geometry for groups of J₃-type (2007), Lemma 2.6, p.496.
-/

public noncomputable section
open scoped BigOperators
namespace MinusExtraspecial.FourActionConjugacy
open FivePointLifts FixedFourCalculation.Outside
open Representation.OneCohomology BinaryPermutation.AlternatingFiveBorel

private def bit (c : ZMod 2) : Model := if c = 0 then 1 else quaternion z

private theorem bit_add (c d : ZMod 2) : bit (c+d) = bit c * bit d := by
  revert c d; decide +kernel

private theorem bit_injective : Function.Injective bit := by decide +kernel

private theorem bit_apply (a : MulAut Model) (c : ZMod 2) : a (bit c) = bit c := by
  unfold bit
  split_ifs <;> simp only [map_one,central_fixed]

private def signs (a : MulAut Model) (i : Fin 5) : ZMod 2 :=
  if a (lift ((fivePointAction a).symm i)) = lift i then 0 else 1

private theorem signs_spec (a : MulAut Model) (i : Fin 5) :
    a (lift ((fivePointAction a).symm i)) =
      bit (signs a i) * lift i := by
  rcases lift_image a ((fivePointAction a).symm i) with h | h
  · simp only [Equiv.apply_symm_apply] at h
    simp only [signs,h,↓reduceIte]
    exact (one_mul _).symm
  · simp only [Equiv.apply_symm_apply] at h
    have hn : a (lift ((fivePointAction a).symm i)) ≠ lift i := by
      rw [h]
      intro he
      have hz := mul_right_cancel (he.trans (one_mul _).symm)
      exact (show quaternion z ≠ 1 by decide +kernel) hz
    simp only [signs,if_neg hn]
    exact h

private theorem signs_mul (a b : MulAut Model) (i : Fin 5) :
    signs (a*b) i = signs b ((fivePointAction a).symm i) + signs a i := by
  apply bit_injective
  apply mul_right_cancel (b := lift i)
  rw [←signs_spec]
  change a (b (lift ((fivePointAction (a*b)).symm i))) = _
  rw [map_mul]
  change a (b (lift ((fivePointAction b).symm ((fivePointAction a).symm i)))) = _
  rw [signs_spec,map_mul,bit_apply,signs_spec,←mul_assoc]
  rw [←bit_add]

private theorem ext_lifts {a b : MulAut Model} (h : ∀ i, a (lift i) = b (lift i)) : a = b := by
  have hc : ∀ x : Model, ∃ i j k l : Fin 5, lift i * lift j * lift k * lift l = x := by
    decide +kernel
  apply MulEquiv.ext
  intro x
  obtain ⟨i,j,k,l,rfl⟩ := hc x
  simp only [map_mul,h]

private theorem inner_signs (w : Fin 5 → ZMod 2) (hw : ∑ i, w i = 0) :
    ∃ n : Model, ∀ i, MulAut.conj n (lift i) =
      bit (w i) * lift i := by
  revert w
  decide +kernel


private theorem fixed_fifth
    (φ : alternatingGroup (Fin 4) →* MulAut Model)
    (hφ : ∀ g, fivePointAction (φ g) = (marking g).val.val)
    (g : alternatingGroup (Fin 4)) : φ g (lift 4) = lift 4 := by
  have hprod : ∀ g : alternatingGroup (Fin 4),
      ∃ h k : alternatingGroup (Fin 4), h^3=1 ∧ k^3=1 ∧ h*k=g := by
    decide +kernel
  obtain ⟨h,k,hh,hk,rfl⟩ := hprod g
  have hfix (u : alternatingGroup (Fin 4)) (hu : u^3=1) :
      φ u (lift 4) = lift 4 := by
    apply cubic_fixed (φ u)
    · rw [←map_pow,hu,map_one]
    · rw [hφ]
      exact (marking u).property
  rw [map_mul]
  change φ h (φ k (lift 4)) = lift 4
  rw [hfix k hk,hfix h hh]

private theorem marking_symm_cast (g : alternatingGroup (Fin 4)) (i : Fin 4) :
    (marking g).val.val.symm i.castSucc = (g.val.symm i).castSucc := by
  apply (Equiv.symm_apply_eq _).mpr
  rw [marking_cast,g.val.apply_symm_apply]

set_option maxHeartbeats 800000 in
/-- The same marked A₄ action on the five singular cosets has a conjugator
inside the original minus core. The actor and its permutation marking remain fixed. -/
theorem exists_inner_conjugacy
    (φ ψ : alternatingGroup (Fin 4) →* MulAut Model)
    (hφ : ∀ g, fivePointAction (φ g) = (marking g).val.val)
    (hψ : ∀ g, fivePointAction (ψ g) = (marking g).val.val) :
    ∃ n : Model, ∀ g, MulAut.conj n * φ g = ψ g * MulAut.conj n := by
  let f : cocycles (BinaryPermutation.alternatingRepresentation (Fin 4)) :=
    ⟨fun g i => signs (φ g) i.castSucc - signs (ψ g) i.castSucc, by
      intro g h
      funext i
      change signs (φ (g*h)) i.castSucc - signs (ψ (g*h)) i.castSucc =
        (signs (φ h) (g.val.symm i).castSucc - signs (ψ h) (g.val.symm i).castSucc) +
          (signs (φ g) i.castSucc - signs (ψ g) i.castSucc)
      rw [map_mul,map_mul,signs_mul,signs_mul,hφ,hψ,marking_symm_cast]
      abel⟩
  obtain ⟨v,hv⟩ := BinaryPermutation.alternating_principal_surjective (Fin 4) (by simp) f
  let w : Fin 5 → ZMod 2 := Fin.lastCases (∑ i, v i) v
  have hw : ∑ i, w i = 0 := by
    rw [Fin.sum_univ_castSucc]
    simp only [w,Fin.lastCases_castSucc,Fin.lastCases_last]
    exact CharTwo.add_self_eq_zero _
  obtain ⟨n,hn⟩ := inner_signs w hw
  refine ⟨n,fun g => ext_lifts (fun i => ?_)⟩
  induction i using Fin.lastCases with
  | last =>
    change MulAut.conj n (φ g (lift 4)) = ψ g (MulAut.conj n (lift 4))
    rw [fixed_fifth φ hφ g,hn,map_mul,bit_apply,fixed_fifth ψ hψ g]
  | cast i =>
    have hd := congrArg (fun c : cocycles (BinaryPermutation.alternatingRepresentation (Fin 4)) =>
      c.val g (g.val i)) hv
    change v (g.val.symm (g.val i)) - v (g.val i) =
      signs (φ g) (g.val i).castSucc - signs (ψ g) (g.val i).castSucc at hd
    rw [g.val.symm_apply_apply] at hd
    have hsφ := signs_spec (φ g) (g.val i).castSucc
    have hsψ := signs_spec (ψ g) (g.val i).castSucc
    rw [hφ,marking_symm_cast,g.val.symm_apply_apply] at hsφ
    rw [hψ,marking_symm_cast,g.val.symm_apply_apply] at hsψ
    change MulAut.conj n (φ g (lift i.castSucc)) = ψ g (MulAut.conj n (lift i.castSucc))
    rw [hsφ,map_mul,bit_apply,hn,hn,map_mul,bit_apply,hsψ,←mul_assoc,←mul_assoc]
    congr 1
    rw [←bit_add,←bit_add]
    congr 1
    simp only [w,Fin.lastCases_castSucc]
    linear_combination -hd

end MinusExtraspecial.FourActionConjugacy
