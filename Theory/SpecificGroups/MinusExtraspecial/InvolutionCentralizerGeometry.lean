module

public import Theory.SpecificGroups.MinusExtraspecial.CentralStructure
public import Mathlib.Data.Fintype.Card

/-!
# Centralizers of noncentral involutions in the minus group of order 32

A noncentral involution has centralizer of order sixteen. Its commuting
square-one elements are precisely the four-group generated by it and the
central involution. A single calculation on the quaternion–dihedral model
proves these assertions; the transport lemmas keep the central involution
marked under an actual group isomorphism.

Source: Aschbacher, *Sporadic Groups* (1994), 46.1–46.2, printed p.251,
for the minus-extraspecial group in the case w = 2.
-/

namespace MinusExtraspecial

private theorem involution_centralizer_calculation : ∀ u : Model,
    u ^ 2 = 1 → u ≠ 1 → u ≠ quaternion z →
      Fintype.card {x : Model // x * u = u * x} = 16 ∧
      ∀ x : Model, x * u = u * x → x ^ 2 = 1 →
        x = 1 ∨ x = quaternion z ∨ x = u ∨ x = quaternion z * u := by
  decide +kernel

variable {K : Type*} [Group K]

private theorem image_central_involution (e : K ≃* Model) {c : K}
    (hc : c ∈ Subgroup.center K) (hc1 : c ≠ 1) : e c = quaternion z := by
  have hec : e c ∈ Subgroup.center Model := by
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨x, rfl⟩ := e.surjective y
    simpa only [map_mul] using congrArg e (Subgroup.mem_center_iff.mp hc x)
  exact (mem_center_iff _).mp hec |>.resolve_left (by simpa using hc1)

public theorem square_eq_one_or_of_equiv (e : K ≃* Model) {c : K}
    (hc : c ∈ Subgroup.center K) (hc1 : c ≠ 1) (x : K) :
    x ^ 2 = 1 ∨ x ^ 2 = c := by
  have hec := image_central_involution e hc hc1
  rcases (mem_center_iff _).mp (square_mem_center (e x)) with h | h
  · exact Or.inl (e.injective (by simpa only [map_pow, map_one] using h))
  · exact Or.inr (e.injective (by simpa only [map_pow, hec] using h))

public theorem centralizer_card_of_equiv (e : K ≃* Model) {c u : K}
    (hc : c ∈ Subgroup.center K) (hc1 : c ≠ 1)
    (hu : u ^ 2 = 1) (hu1 : u ≠ 1) (huc : u ≠ c) :
    Nat.card (Subgroup.centralizer ({u} : Set K)) = 16 := by
  have hec := image_central_involution e hc hc1
  have heu : e u ^ 2 = 1 := by simpa only [map_pow, map_one] using congrArg e hu
  have heu1 : e u ≠ 1 := by simpa using hu1
  have heuc : e u ≠ quaternion z := by simpa only [← hec, e.injective.ne_iff] using huc
  let f : Subgroup.centralizer ({u} : Set K) ≃ {x : Model // x * e u = e u * x} :=
    { toFun := fun x => ⟨e x, by
        simpa only [map_mul] using congrArg e
          (Subgroup.mem_centralizer_singleton_iff.mp x.property)⟩
      invFun := fun x => ⟨e.symm x, Subgroup.mem_centralizer_singleton_iff.mpr (by
        simpa only [map_mul, e.symm_apply_apply] using congrArg e.symm x.property)⟩
      left_inv := fun x => Subtype.ext (e.symm_apply_apply x)
      right_inv := fun x => Subtype.ext (e.apply_symm_apply x) }
  rw [Nat.card_congr f, Nat.card_eq_fintype_card]
  exact (involution_centralizer_calculation (e u) heu heu1 heuc).1

public theorem commuting_square_one_of_equiv (e : K ≃* Model) {c u x : K}
    (hc : c ∈ Subgroup.center K) (hc1 : c ≠ 1)
    (hu : u ^ 2 = 1) (hu1 : u ≠ 1) (huc : u ≠ c)
    (hxu : x * u = u * x) (hx : x ^ 2 = 1) :
    x = 1 ∨ x = c ∨ x = u ∨ x = c * u := by
  have hec := image_central_involution e hc hc1
  have heu : e u ^ 2 = 1 := by simpa only [map_pow, map_one] using congrArg e hu
  have heu1 : e u ≠ 1 := by simpa using hu1
  have heuc : e u ≠ quaternion z := by simpa only [← hec, e.injective.ne_iff] using huc
  have h := (involution_centralizer_calculation (e u) heu heu1 heuc).2 (e x)
    (by simpa only [map_mul] using congrArg e hxu)
    (by simpa only [map_pow, map_one] using congrArg e hx)
  simpa only [← hec, ← map_mul, ← e.map_one, e.injective.eq_iff] using h

end MinusExtraspecial
