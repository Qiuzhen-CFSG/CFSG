module
public import Theory.SpecificGroups.AffineEight.Basic
public import Mathlib.GroupTheory.Abelianization.Defs
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Transfer obstruction in the affine group over Z/8

The multiplier-five involution of the actual affine model lies outside its
derived subgroup, and its commutators and square lie in the subgroup
generated by translation by four. That subgroup lies in the derived
subgroup of every index-two subgroup of the model.

The coefficient projection detects the first assertion. Finite arithmetic
computes the involution and its commutators. For the last assertion, write
`a` for translation by one and `b` for multiplier seven. The square `a²`
lies in every index-two subgroup. Four membership cases produce one of the
commutators `[a²,b]`, `[a²,ab]`, `[a,t]`, or `[a²,bt]`, each translation by
four. This supplies the concrete local hypotheses of ordinary Sylow
transfer vanishing; it asserts no identification of an ambient group with
the affine model.

This is an explicit finite-model calculation for the transfer argument in
Andersen–Oliver–Ventura, `Fusion systems and amalgams`, Proposition 2.3(b),
author manuscript p.6, as applied to the holomorph of C8.
-/

open scoped commutatorElement

namespace AffineEight

public theorem transfer_obstruction_data :
    let t : Model := SemidirectProduct.inr five
    let z : Model := SemidirectProduct.inl (Multiplicative.ofAdd (4 : ZMod 8))
    let U : Subgroup Model := Subgroup.zpowers z
    t ∉ commutator Model ∧ t ^ 2 ∈ U ∧
      (∀ v : Model, ⁅t, v⁆ ∈ U) ∧
      (∀ M : Subgroup Model, M.index = 2 → U ≤ ⁅M, M⁆) := by
  classical
  dsimp only
  let t : Model := SemidirectProduct.inr five
  let z : Model := SemidirectProduct.inl (Multiplicative.ofAdd (4 : ZMod 8))
  let a : Model := SemidirectProduct.inl (Multiplicative.ofAdd (1 : ZMod 8))
  let b : Model := SemidirectProduct.inr seven
  change t ∉ commutator Model ∧ t ^ 2 ∈ Subgroup.zpowers z ∧
    (∀ v : Model, ⁅t, v⁆ ∈ Subgroup.zpowers z) ∧
    (∀ M : Subgroup Model, M.index = 2 → Subgroup.zpowers z ≤ ⁅M, M⁆)
  have ht : t ^ 2 = 1 := by decide
  have hcomm : ∀ v : Model, ⁅t, v⁆ = 1 ∨ ⁅t, v⁆ = z := by decide
  have hab : ⁅a ^ 2, b⁆ = z := by decide
  have haab : ⁅a ^ 2, a * b⁆ = z := by decide
  have hat : ⁅a, t⁆ = z := by decide
  have habt : ⁅a ^ 2, b * t⁆ = z := by decide
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro hmem
    have hzero := Abelianization.commutator_subset_ker
      (SemidirectProduct.rightHom : Model →* (ZMod 8)ˣ) hmem
    have hfive : five = 1 := hzero
    exact (by decide : five ≠ 1) hfive
  · rw [ht]
    exact (Subgroup.zpowers z).one_mem
  · intro v
    rcases hcomm v with h | h
    · rw [h]
      exact (Subgroup.zpowers z).one_mem
    · rw [h]
      exact Subgroup.mem_zpowers z
  · intro M hM
    apply Subgroup.zpowers_le.mpr
    have ha2 : a ^ 2 ∈ M := M.sq_mem_of_index_two hM a
    by_cases hb : b ∈ M
    · rw [← hab]
      exact Subgroup.commutator_mem_commutator ha2 hb
    · by_cases ha : a ∈ M
      · by_cases htm : t ∈ M
        · rw [← hat]
          exact Subgroup.commutator_mem_commutator ha htm
        · have hbt : b * t ∈ M :=
            (M.mul_mem_iff_of_index_two hM).mpr (by simp [hb, htm])
          rw [← habt]
          exact Subgroup.commutator_mem_commutator ha2 hbt
      · have habm : a * b ∈ M :=
          (M.mul_mem_iff_of_index_two hM).mpr (by simp [ha, hb])
        rw [← haab]
        exact Subgroup.commutator_mem_commutator ha2 habm

end AffineEight
