def certificateWord (c : Certificate) : Word Edge :=
  reduce (c.conjugator ++ (if c.positive then c.result
    else FreeGroup.invRev c.result) ++ FreeGroup.invRev c.conjugator)

/-- Every intermediate word and the final conjugation are checked separately. -/
def checkCertificate (c : Certificate) (v : Word Edge) : Bool :=
  checkReplay elimination c.steps (rawRelator c.source) c.result &&
    decide (certificateWord c = v)

