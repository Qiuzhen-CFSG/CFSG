/-! Kernel-checked deductions for the literal compact ATLAS S62G1-P1 subgroup presentation.
Chunks bound the reduction cache; each scan uses previously proved equations. -/

public section
namespace Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness.SubgroupBound.CompactOrder
open Subgroup.CosetWordCertificate

set_option Elab.async false

/-- Every retained deduction has an actual witness in the subgroup generated by compact generators 1, 2, 4. -/
theorem all_hold : ∀ n, n < 99983 →
    Holds smallSubgroup generator (definitions.repr generator) (facts n) := by
  have h0 := sound_0 (fun n hn => (Nat.not_lt_zero n hn).elim)
  have h16384 := sound_16384 h0
  have h32768 := sound_32768 h16384
  have h49152 := sound_49152 h32768
  have h65536 := sound_65536 h49152
  have h81920 := sound_81920 h65536
  have h98304 := sound_98304 h81920
  exact h98304

end Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness.SubgroupBound.CompactOrder
