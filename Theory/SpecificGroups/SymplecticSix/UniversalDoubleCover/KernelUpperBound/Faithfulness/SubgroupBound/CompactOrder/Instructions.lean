/-! Kernel-checked coset certificate for the compact ATLAS S62G1-P1 subgroup presentation, the subgroup generated by compact generators 1, 2, 4.
Generated from `source/compact.json` by `source/generate.py`.
The data are untrusted; `Scan.chunk_sound` supplies actual subgroup witnesses. -/

@[expose] public section
namespace Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness.SubgroupBound.CompactOrder
open Subgroup.CosetWordCertificate

def refs : Nat → Nat → List Nat
  | 0, _ => []
  | n+1, c => if c == 0 then [] else (c % 131072 - 1) :: refs n (c >>> 17)

def instructions (n : Nat) : Scan.Op (Fin 8) :=
  let c := opCode n
  let a := c / 8 % 131072
  let b := c / 1048576
  match c % 8 with
  | 0 => .basic (.refl a)
  | 1 => .basic (.defining a)
  | 2 => .basic (.subgroup (decode a))
  | 3 => .basic (.relator a b)
  | 4 => .basic (.reverse a)
  | 5 => .basic (.compose a b)
  | _ => .scan (scanHeader a / 8192) (scanHeader a % 8192)
      (refs 35 (scanLeft a)) (refs 35 (scanRight a))

end Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness.SubgroupBound.CompactOrder
