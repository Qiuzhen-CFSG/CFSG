/-! Kernel-checked coset certificate for the compact ATLAS S62G1-P1 subgroup presentation, the subgroup generated by compact generators 1, 2, 4.
Generated from `source/compact.json` by `source/generate.py`.
The data are untrusted; `Scan.chunk_sound` supplies actual subgroup witnesses. -/

@[expose] public section
namespace Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness.SubgroupBound.CompactOrder
open Subgroup.CosetWordCertificate

def output (n : Nat) : Nat := min (outputCode n) 99982

def destination (n : Nat) : Fin 5040 :=
  ⟨min (destCode n) 5039, by omega⟩

def shapeAt (n : Nat) : Bool :=
  factBEq (facts (output n)) ⟨repCode (n / 16), [decode (n % 16)], repCode (destination n).val⟩

def shapeChunk (start count : Nat) : Bool :=
  (List.range count).all fun k => shapeAt (start+k)

theorem shapeChunk_sound {start count : Nat} (h : shapeChunk start count = true)
    (n : Nat) (hlo : start ≤ n) (hhi : n < start+count) : shapeAt n = true := by
  have hm : n-start ∈ List.range count := by simp only [List.mem_range]; omega
  have hs := List.all_eq_true.mp h (n-start) hm
  have he : start + (n-start) = n := by omega
  rwa [he] at hs

theorem output_lt (n : Nat) : output n < 99983 :=
  Nat.lt_of_le_of_lt (Nat.min_le_right _ _) (by decide)

end Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness.SubgroupBound.CompactOrder
