module

public import Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelUpperBound.Faithfulness.SubgroupBound.SchreierLifting
public import Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelUpperBound.Faithfulness.SubgroupBound.CompactData
public import Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelUpperBound.Faithfulness.SubgroupBound.CompactRelations
public import Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelUpperBound.Faithfulness.SubgroupBound.CompactOrder

/-!
# The actual ATLAS M2 subgroup bound

`SchreierLifting` proves all relations of the raw edge presentation in the literal
seven-relator group and proves that its image contains the source subgroup.
`CompactRelations` proves that the eight retained edges satisfy the 51 compact
relations and generate the raw presentation. `CompactOrder` bounds the literal
compact presentation using a checked coset-word certificate. This module
preserves the conditional assembly interfaces and combines all three proofs to
establish finiteness and order at most 40320 for the actual source subgroup.

Source: ATLAS `S62G1-P1.M`, M2. See `SubgroupBound/source/README.md`.
-/

public section
namespace Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness.SubgroupBound
open Subgroup.CosetWordCertificate

/-- The eight-generator relation lifting and generation, together with its
independent order bound, imply the precise bound consumed by `Faithfulness`. -/
theorem s8Subgroup_bound_of_compact
    (hrel : ∀ r : Fin 51, eval compactImage (compactRelator r) = 1)
    (hgen : Subgroup.closure (Set.range compactImage) = ⊤)
    (hbound : Finite CompactPresentation ∧ Nat.card CompactPresentation ≤ 40320) :
    Finite s8Subgroup ∧ Nat.card s8Subgroup ≤ 40320 := by
  let f : CompactPresentation →* RawPresentation :=
    PresentedGroup.toGroup (f := compactImage)
      (by rintro _ ⟨r, rfl⟩; exact hrel r)
  have hf : Function.Surjective f := by
    apply MonoidHom.range_eq_top.mp
    apply top_unique
    rw [← hgen]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨PresentedGroup.of i, PresentedGroup.toGroup.of _⟩
  let : Finite CompactPresentation := hbound.1
  exact s8Subgroup_bound_of_raw_bound
    ⟨Finite.of_surjective f hf,
      (Nat.card_le_card_of_surjective f hf).trans hbound.2⟩

/-- The checked compact relations and generation discharge the presentation
premises; only the independent finite order bound remains. -/
theorem s8Subgroup_bound_of_compact_bound
    (hbound : Finite CompactPresentation ∧ Nat.card CompactPresentation ≤ 40320) :
    Finite s8Subgroup ∧ Nat.card s8Subgroup ≤ 40320 :=
  s8Subgroup_bound_of_compact compactRelator_eval compactImage_generates hbound

/-- The checked compact order bound discharges the order premise independently
of the relation lifting and generation. -/
theorem s8Subgroup_bound_of_compact_lifting
    (hrel : ∀ r : Fin 51, eval compactImage (compactRelator r) = 1)
    (hgen : Subgroup.closure (Set.range compactImage) = ⊤) :
    Finite s8Subgroup ∧ Nat.card s8Subgroup ≤ 40320 :=
  s8Subgroup_bound_of_compact hrel hgen compactPresentation_bound

/-- The actual subgroup generated by the ATLAS M2 words is finite of order at
most 40320, with all compact-presentation premises discharged. -/
theorem s8Subgroup_bound :
    Finite s8Subgroup ∧ Nat.card s8Subgroup ≤ 40320 :=
  s8Subgroup_bound_of_compact_bound compactPresentation_bound

end Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness.SubgroupBound
