module

public import Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelUpperBound.MatrixGeneration
public import Theory.GroupTheory.CosetWordCertificateBoolean
public import Mathlib.Algebra.BigOperators.Group.List.Lemmas

/-!
# The subgroup for the 36-coset presentation bound

Inside the literal seven-relator presentation, take H = ⟨a, bab³⟩.
The source calls this subgroup S₈. Here the name only fixes its two words;
neither its isomorphism type nor its order is assumed. A checked coset
cover and a separate finite bound on H will bound the full presentation.
The third trace generator is the redundant generator c = bab³.

Source: Wilson–Nickerson–Bray, ATLAS, `S62G1-P1.M`, subgroup M2,
https://brauer.maths.qmul.ac.uk/Atlas/clas/S62/mag/S62G1-P1.M.
-/

@[expose] public section
namespace Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness
open Subgroup.CosetWordCertificate

def s8Generator : Bool → Presented
  | false => generator false
  | true => generator true * generator false * generator true ^ 3

/-- The actual subgroup generated by the two M2 words in the source. -/
def s8Subgroup : Subgroup Presented := Subgroup.closure (Set.range s8Generator)

theorem s8Generator_mem (i : Bool) : s8Generator i ∈ s8Subgroup :=
  Subgroup.subset_closure (Set.mem_range_self i)

/-- A redundant third generator makes subgroup loops single-letter facts. -/
def traceGenerator : Nat → Presented
  | 0 => generator false
  | 1 => generator true
  | _ => s8Generator true

theorem relator_eval (i : Fin 7) :
    word (generator false) (generator true) i = 1 := by
  have h := toPresented_relator i
  change toPresented (word (FreeGroup.of false) (FreeGroup.of true) i) = 1 at h
  rw [map_word] at h
  exact h

def variant (w : Word Nat) (inv : Bool) (offset : Nat) : Word Nat :=
  (if inv then FreeGroup.invRev w else w).rotate offset

theorem eval_variant (w : Word Nat) (hw : eval traceGenerator w = 1)
    (inv : Bool) (offset : Nat) : eval traceGenerator (variant w inv offset) = 1 := by
  have h : eval traceGenerator (if inv then FreeGroup.invRev w else w) = 1 := by
    cases inv <;> simp [hw, eval_invRev]
  simpa [eval, FreeGroup.lift_mk, variant, List.map_rotate] using
    List.prod_rotate_eq_one_of_prod_eq_one
      (by simpa [eval, FreeGroup.lift_mk] using h) offset

end Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation.Faithfulness
