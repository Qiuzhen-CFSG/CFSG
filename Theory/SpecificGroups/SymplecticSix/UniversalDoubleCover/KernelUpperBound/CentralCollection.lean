module

public import Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelUpperBound.CentralCollection.Basic
public import Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelUpperBound.CentralCollection.CommutatorIdentities
public import Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelUpperBound.CentralCollection.PowerIdentities

/-!
# Collection of the central derived kernel into one involution

The exponent matrix of the seven ATLAS relators has integral kernel
spanned by (-63,-18,14,0,0,0,0), (-15,-6,2,1,0,0,0), and the last three
coordinate vectors. Normal-closure generation therefore puts every
central derived-kernel element in the group generated by their five images.

The checked commutator and power identities identify the first four images
with the specified last relator, whose square is one by `Basic`. Thus
`derived_kernel_eq_one_or_defect` puts every element of the derived kernel
in `{1, defect}` in the genuine free central extension F/[F,R]. The proof
requires neither finiteness nor faithfulness of the presented group.
The conditional interface `collection_of_four_identities` is retained.

Source: the seven words of Wilson–Nickerson–Bray's ATLAS `S62G1-P1.M`;
see `KernelUpperBound/source/README.md` for attribution and conventions.
-/

@[expose] public section
namespace Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation
namespace CentralCollection
open scoped IsMulCommutative
theorem exponent_lattice (n : Fin 7 → ℤ)
    (ha : 2 * n 0 + 9 * n 2 + 12 * n 3 = 0)
    (hb : 7 * n 1 + 9 * n 2 + 24 * n 3 = 0) :
    ∃ u v : ℤ,
      n 0 = (-15) * u + (-63) * v ∧ n 1 = (-6) * u + (-18) * v ∧
      n 2 = 2 * u + 14 * v ∧ n 3 = u := by
  refine ⟨n 3, (n 2 - 2 * n 3) / 14, ?_, ?_, ?_, rfl⟩ <;> omega

theorem collect_zero_exponent (n : Fin 7 → ℤ)
    (ha : 2 * n 0 + 9 * n 2 + 12 * n 3 = 0)
    (hb : 7 * n 1 + 9 * n 2 + 24 * n 3 = 0) :
    ∃ u v : ℤ, collect n = powerDefect ^ v * mixedDefect ^ u *
      centralRelator 4 ^ n 4 * centralRelator 5 ^ n 5 * centralRelator 6 ^ n 6 := by
  obtain ⟨u, v, h0, h1, h2, h3⟩ := exponent_lattice n ha hb
  refine ⟨u, v, ?_⟩
  dsimp [collect, powerDefect, mixedDefect, powerCycle, mixedCycle]
  rw [h0, h1, h2, h3]
  simp only [mul_zpow, ← zpow_mul, zpow_add, one_mul, zpow_zero, mul_one]
  ac_rfl

theorem derived_kernel_five_generator_form {x : Central} (hxD : x ∈ commutator Central)
    (hx : centralProjection x = 1) :
    ∃ u v e₄ e₅ e₆ : ℤ, x =
      ((powerDefect ^ v * mixedDefect ^ u * centralRelator 4 ^ e₄ *
        centralRelator 5 ^ e₅ * centralRelator 6 ^ e₆ : Subgroup.center Central) : Central) := by
  obtain ⟨n, rfl, ha, hb⟩ := kernel_derived_normal_form hxD hx
  obtain ⟨u, v, he⟩ := collect_zero_exponent n ha hb
  exact ⟨u, v, n 4, n 5, n 6, congrArg Subtype.val he⟩

theorem collection_of_four_identities
    (hpower : powerDefect = centralRelator 6)
    (hmixed : mixedDefect = centralRelator 6)
    (hfour : centralRelator 4 = centralRelator 6)
    (hfive : centralRelator 5 = centralRelator 6)
    (x : Central) (hxD : x ∈ commutator Central) (hx : centralProjection x = 1) :
    x = 1 ∨ x = defect := by
  obtain ⟨u, v, e₄, e₅, e₆, rfl⟩ := derived_kernel_five_generator_form hxD hx
  rw [hpower, hmixed, hfour, hfive]
  simp only [← zpow_add]
  rw [zpow_eq_zpow_emod (v + u + e₄ + e₅ + e₆)
    (show centralRelator 6 ^ (2 : ℤ) = 1 from centralRelator_six_sq)]
  have hr : (v + u + e₄ + e₅ + e₆) % 2 = 0 ∨ (v + u + e₄ + e₅ + e₆) % 2 = 1 := by omega
  rcases hr with h | h
  · left; simp [h]
  · right; simpa [h] using centralRelator_six

/-- Every element of the derived subgroup above the identity of F/R is either
the identity or the image of the literal source word `[a,b²]²`.
This discharges the collection premise of `kernel_card_le_two_of_presentation`. -/
theorem derived_kernel_eq_one_or_defect
    (x : Central) (hxD : x ∈ commutator Central) (hx : centralProjection x = 1) :
    x = 1 ∨ x = defect :=
  collection_of_four_identities powerDefect_eq_centralRelator_six
    mixedDefect_eq_centralRelator_six centralRelator_four_eq_six
    centralRelator_five_eq_six x hxD hx

end CentralCollection
end Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.KernelPresentation
