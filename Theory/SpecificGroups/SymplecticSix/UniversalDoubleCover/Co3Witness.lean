module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.Co3.CentralizerSection.Quotient
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# A concrete commutator in the kernel of the Co₃ symplectic quotient

For the published degree-276 permutations b,c,d, put z=b² and t=c⁻¹dbd.
A kernel-checked identity on the 276 letters proves [b,t]=z. Thus the
nontrivial central involution belongs to both the derived subgroup of the
numerator and the kernel of its surjection onto the literal Sp₆(2) matrices.
The map uses the already proved faithful 36-point action and matrix generation.

This does not assert that the entire kernel is central or has order two.
Once its centrality is proved, `UniversalDoubleCover.Basic` uses this witness
to prove that the canonical universal kernel is nontrivial.

Source motivation: the 2Sp₆(2) centralizer in GLS3 Table 5.3j and
Aschbacher–Smith A.2.19, printed pp.40–41. The permutations and their ATLAS
attribution are retained in `LeechRelated/AtlasCarriers/source/`; this module
adds only a short word and its checked equality, not new external data.
-/

@[expose] public section

open scoped commutatorElement
namespace Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.Co3Witness
open Sporadic.LeechRelated.Co3
open Sporadic.LeechRelated.Co3.CentralizerSection

/-- The subgroup generated by the three published Co₃ centralizer words. -/
abbrev ExtensionGroup := numerator
/-- The fixed-point action followed by the proved isomorphism to Sp₆(2). -/
noncomputable def matrixProjection : ExtensionGroup →*
    Matrix.symplecticGroup (Fin 3) (ZMod 2) :=
  pointGroupSymplecticEquiv.toMonoidHom.comp pointQuotient

theorem matrixProjection_surjective : Function.Surjective matrixProjection :=
  pointGroupSymplecticEquiv.surjective.comp pointQuotient_surjective

theorem matrixProjection_ker : matrixProjection.ker = pointQuotient.ker := by
  ext x
  change pointGroupSymplecticEquiv (pointQuotient x) = 1 ↔ pointQuotient x = 1
  exact pointGroupSymplecticEquiv.map_eq_one_iff

/-- The actual central involution b², now inside the numerator. -/
def z : ExtensionGroup := numeratorGenerator 0 ^ 2

theorem z_val : z.val = involution := rfl

theorem z_ne_one : z ≠ 1 := by
  intro h
  have hz := congrArg Subtype.val h
  change z.val = 1 at hz
  rw [z_val] at hz
  exact involution_ne_one hz

theorem z_sq : z ^ 2 = 1 := by
  apply Subtype.ext
  change z.val ^ 2 = 1
  rw [z_val]
  exact involution_sq

theorem z_mem_center : z ∈ Subgroup.center ExtensionGroup := by
  rw [Subgroup.mem_center_iff]
  intro y
  apply Subtype.ext
  change y.val * z.val = z.val * y.val
  rw [z_val]
  exact Subgroup.mem_centralizer_singleton_iff.mp (numerator_centralizes y.property)

theorem z_mem_kernel : z ∈ matrixProjection.ker := by
  rw [matrixProjection_ker]
  have hf : fixedAction z = 1 := by
    apply Equiv.ext
    intro x
    apply Subtype.ext
    change inclusion z.val x.val = x.val
    rw [z_val]
    exact x.property
  have hp : pointAction z = 1 := by
    change fixedPointsEquiv.symm.permCongrHom (fixedAction z) = 1
    rw [hf, map_one]
  change pointQuotient z = 1
  apply Subtype.ext
  exact hp

/-- The short word c⁻¹dbd whose commutator with b is b². -/
def commutatorWitness : ExtensionGroup :=
  (numeratorGenerator 1)⁻¹ * numeratorGenerator 2 * numeratorGenerator 0 * numeratorGenerator 2

set_option maxRecDepth 20000 in
private theorem table_commutator :
    ⁅Tables.tableB, Tables.tableC⁻¹ * Tables.tableD * Tables.tableB * Tables.tableD⁆ =
      Tables.tableZ := by
  apply Equiv.ext
  apply Tables.allFin
  decide +kernel

/-- The nontrivial central involution is an explicit commutator. -/
theorem commutator_eq_z : ⁅numeratorGenerator 0, commutatorWitness⁆ = z := by
  apply Subtype.ext
  change ⁅generator 0, (generator 1)⁻¹ * generator 2 * generator 0 * generator 2⁆ = z.val
  rw [z_val]
  apply inclusion_injective
  simp only [map_commutatorElement, map_mul, map_inv, inclusion_generator, inclusion_involution]
  exact table_commutator

theorem z_mem_commutator : z ∈ commutator ExtensionGroup := by
  rw [← commutator_eq_z]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

end Theory.SpecificGroups.SymplecticSix.UniversalDoubleCover.Co3Witness
