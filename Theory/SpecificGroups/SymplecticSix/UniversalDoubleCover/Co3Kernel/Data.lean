/-- Boolean traversal with a small proof of soundness. -/
theorem allFinBool {n : ℕ} (f : Fin n → Bool)
    (h : Tables.checkFin f = true) (i : Fin n) : f i = true := by
  have hi := List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt)
  simpa only [dif_pos i.isLt] using hi

theorem allFin₂ {m n : ℕ} (P : Fin m → Fin n → Prop) [DecidableRel P]
    (h : Tables.checkFin (fun x => Tables.checkFin (fun y => decide (P x y))) = true) :
    ∀ x y, P x y := by
  intro x y
  exact Tables.allFin (P x) (allFinBool _ h x) y

