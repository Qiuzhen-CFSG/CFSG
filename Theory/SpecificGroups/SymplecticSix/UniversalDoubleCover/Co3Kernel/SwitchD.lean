    (_hhi : x.val < 16) (y : Fin 276) : adjacent (Tables.tableD x) (Tables.tableD y) =
      ((adjacent x y ^^ adjacent (Tables.tableD 4) (Tables.tableD x)) ^^
        adjacent (Tables.tableD 4) (Tables.tableD y)) := by
  have checked : ∀ (j : Fin 16) (y : Fin 276),
      let x : Fin 276 := ⟨0 + j.val, Nat.lt_of_lt_of_le (Nat.add_lt_add_left j.isLt 0) (by decide)⟩
      adjacent (Tables.tableD x) (Tables.tableD y) =
      ((adjacent x y ^^ adjacent (Tables.tableD 4) (Tables.tableD x)) ^^
        adjacent (Tables.tableD 4) (Tables.tableD y)) := by
    apply allFin₂
    decide +kernel
  have h := checked ⟨x.val - 0, by omega⟩ y
  have he : (⟨0 + (x.val - 0), by omega⟩ : Fin 276) = x := by
    apply Fin.ext
    dsimp
    omega
  exact he ▸ h

