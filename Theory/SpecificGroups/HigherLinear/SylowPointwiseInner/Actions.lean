module

public import Theory.AtlasPort.ExceptionalIsomorphisms.FieldTransportLaws
public import Mathlib.GroupTheory.Sylow

/-!
# Standard matrix actions in arbitrary projective dimension

Conjugation by an invertible matrix, coefficient automorphisms, and inverse
transpose act on the literal quotient SLₙ(F)/Z(SLₙ(F)). The upper root subgroup
is generated by the images of the positive transvections. These definitions
make no assertion that every automorphism is standard or that this subgroup
is Sylow.

The constructions generalize `PSL3.OuterSolvable.Actions`. Field transport
uses the attributed ATLAS construction imported above. Source: GLS III,
Theorem 2.5.1 and §2.7 (`refs/KGroup/GLS3/chapter2.tex`), for the type-A
calculation used in Aschbacher–Smith B.1.13, printed p.74.
-/

@[expose] public section

open scoped MatrixGroups commutatorElement

namespace Matrix.HigherLinear.SylowPointwiseInner

variable (d : ℕ) (F : Type*) [Field F]

/-- The induced action on the actual central quotient of SLₙ. -/
def centerAction : MulAut SL(d,F) →* MulAut PSL(d,F) where
  toFun a := QuotientGroup.congr _ _ a
    (Subgroup.characteristic_iff_map_eq.mp inferInstance a)
  map_one' := by
    ext x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center SL(d,F)) x
    rfl
  map_mul' a b := by
    ext x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center SL(d,F)) x
    rfl

theorem centerAction_mk (a : MulAut SL(d,F)) (x : SL(d,F)) :
    centerAction d F a (QuotientGroup.mk x) = QuotientGroup.mk (a x) := rfl

/-- The determinant kernel in GLₙ is the actual special linear group. -/
def slEquivDetKernel : SL(d,F) ≃*
    (GeneralLinearGroup.det : GL (Fin d) F →* Fˣ).ker where
  toFun x := ⟨SpecialLinearGroup.toGL x, SpecialLinearGroup.coeToGL_det x⟩
  invFun x := ⟨x.val.val, congrArg Units.val x.property⟩
  left_inv _ := rfl
  right_inv _ := Subtype.ext (Units.ext rfl)
  map_mul' x y := Subtype.ext (SpecialLinearGroup.toGL.map_mul x y)

theorem slEquivDetKernel_symm_toGL
    (x : (GeneralLinearGroup.det : GL (Fin d) F →* Fˣ).ker) :
    SpecialLinearGroup.toGL ((slEquivDetKernel d F).symm x) = x.val := Units.ext rfl

/-- Conjugation by GLₙ, transported from its normal determinant kernel. -/
def linearConjSL : GL (Fin d) F →* MulAut SL(d,F) :=
  (MulAut.congr (slEquivDetKernel d F).symm).toMonoidHom.comp MulAut.conjNormal

theorem linearConjSL_toGL (g : GL (Fin d) F) (x : SL(d,F)) :
    SpecialLinearGroup.toGL (linearConjSL d F g x) =
      g * SpecialLinearGroup.toGL x * g⁻¹ := by
  change SpecialLinearGroup.toGL ((slEquivDetKernel d F).symm
    (MulAut.conjNormal g (slEquivDetKernel d F x))) = _
  rw [slEquivDetKernel_symm_toGL, MulAut.conjNormal_apply]
  rfl

/-- The inner-diagonal action of GLₙ on PSLₙ. -/
def linearConj : GL (Fin d) F →* MulAut PSL(d,F) :=
  (centerAction d F).comp (linearConjSL d F)

theorem linearConj_mk (g : GL (Fin d) F) (x : SL(d,F)) :
    linearConj d F g (QuotientGroup.mk x) =
      QuotientGroup.mk (linearConjSL d F g x) := rfl

/-- A determinant-one conjugating matrix induces an inner automorphism. -/
theorem linearConj_toGL (x : SL(d,F)) :
    linearConj d F (SpecialLinearGroup.toGL x) =
      MulAut.conj (QuotientGroup.mk x) := by
  ext y
  obtain ⟨z, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center SL(d,F)) y
  simp only [QuotientGroup.mk'_apply]
  rw [linearConj_mk]
  have h : linearConjSL d F (SpecialLinearGroup.toGL x) z = x * z * x⁻¹ := by
    apply SpecialLinearGroup.toGL_injective
    rw [linearConjSL_toGL, map_mul, map_mul, map_inv]
  rw [h]
  rfl

/-- Entrywise coefficient automorphisms, descended through the scalar center. -/
def fieldAction : (F ≃+* F) →* MulAut PSL(d,F) where
  toFun := Atlas.fieldEquivPSL d
  map_one' := by
    ext x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center SL(d,F)) x
    rw [Atlas.fieldEquivPSL_mk]
    rfl
  map_mul' a b := by
    ext x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center SL(d,F)) x
    simp only [MulAut.mul_apply]
    simp only [Atlas.fieldEquivPSL_mk]
    rfl

theorem fieldAction_mk (a : F ≃+* F) (x : SL(d,F)) :
    fieldAction d F a (QuotientGroup.mk x) =
      QuotientGroup.mk (SpecialLinearGroup.map a.toRingHom x) :=
  Atlas.fieldEquivPSL_mk d a x

private theorem transpose_mul (x y : SL(d,F)) :
    SpecialLinearGroup.transpose (x * y) =
      SpecialLinearGroup.transpose y * SpecialLinearGroup.transpose x := by
  apply Subtype.ext
  exact Matrix.transpose_mul _ _

private theorem transpose_transpose (x : SL(d,F)) :
    SpecialLinearGroup.transpose (SpecialLinearGroup.transpose x) = x := by
  apply Subtype.ext
  exact Matrix.transpose_transpose _

private theorem transpose_inv (x : SL(d,F)) :
    SpecialLinearGroup.transpose x⁻¹ = (SpecialLinearGroup.transpose x)⁻¹ := by
  apply eq_inv_of_mul_eq_one_left
  rw [← transpose_mul, mul_inv_cancel]
  apply Subtype.ext
  exact Matrix.transpose_one

/-- The inverse-transpose automorphism of SLₙ. -/
def graphSL : MulAut SL(d,F) where
  toFun x := (SpecialLinearGroup.transpose x)⁻¹
  invFun x := (SpecialLinearGroup.transpose x)⁻¹
  left_inv x := by
    dsimp only
    rw [transpose_inv, transpose_transpose, inv_inv]
  right_inv x := by
    dsimp only
    rw [transpose_inv, transpose_transpose, inv_inv]
  map_mul' x y := by rw [transpose_mul, _root_.mul_inv_rev]

/-- Inverse transpose on the actual projective quotient. -/
def graph : MulAut PSL(d,F) := centerAction d F (graphSL d F)

theorem graph_mk (x : SL(d,F)) :
    graph d F (QuotientGroup.mk x) =
      QuotientGroup.mk (SpecialLinearGroup.transpose x)⁻¹ := rfl

/-- The graph representative has order dividing two. -/
theorem graph_sq : graph d F ^ 2 = 1 := by
  have h : graphSL d F ^ 2 = 1 := by
    apply MulEquiv.ext
    intro x
    change (SpecialLinearGroup.transpose (SpecialLinearGroup.transpose x)⁻¹)⁻¹ = x
    rw [transpose_inv, transpose_transpose, inv_inv]
  rw [graph, ← map_pow, h, map_one]


/-- Positive root elements in the actual central quotient. -/
def root {i j : Fin d} (hij : i ≠ j) (c : F) : PSL(d,F) :=
  QuotientGroup.mk (SpecialLinearGroup.transvection hij c)

/-- The subgroup generated by all positive root groups. -/
def upperRoots : Subgroup PSL(d,F) :=
  Subgroup.closure {x | ∃ (i j : Fin d) (h : i < j) (c : F),
    x = root d F (ne_of_lt h) c}

theorem root_mem_upperRoots {i j : Fin d} (h : i < j) (c : F) :
    root d F (ne_of_lt h) c ∈ upperRoots d F :=
  Subgroup.subset_closure ⟨i, j, h, c, rfl⟩

/-- The precise standard normal forms, without a coverage assertion. -/
def HasStandardForm (a : MulAut PSL(d,F)) : Prop :=
  ∃ (m : GL (Fin d) F) (σ : F ≃+* F),
    a = linearConj d F m * fieldAction d F σ ∨
    a = linearConj d F m * fieldAction d F σ * graph d F

end Matrix.HigherLinear.SylowPointwiseInner
