module

public import Theory.SpecificGroups.PSL3Two.Automorphisms
public import GorensteinWalter.PGL2CanonicalOuterInvolutionFusion
public import GorensteinWalter.PGL2ConcreteSplitTorusCentralizer
public import GorensteinWalter.PGL2DeterminantSquare
public import GorensteinWalter.DihedralGenerators
public import Theory.GroupTheory.CentralizerSmallKernelTransport

/-!
# The outer-involution centralizer quotient in Aut(SL₃(2))

Every exterior involution in PGL₂(7) is conjugate to the projective class of
`diag(-1,1)`. Its centralizer is generated by the cyclic split torus of order
six and an inverting reflection, hence is the dihedral group of order twelve.
Sending the rotation to a three-cycle and the reflection to a transposition
constructs an epimorphism onto S₃ with kernel of order two.

The checked exceptional isomorphism and automorphism comparison transport this
homomorphism to the full centralizer in Aut(SL₃(2)). The comparison explicitly
sends the canonical PSL₂(7) image into the inner automorphisms, so an outer
involution has the required exterior preimage. No centralizer structure is
assumed of the original automorphism.

This is the concrete quotient calculation used by
`binaryCentralizerGeometry_of_model_calculations` in the binary L₃ branch of
Aschbacher--Smith E.1.14(1), printed p.214. That consumer uses it to establish
the E1 clauses of E.1.1--5, printed pp.209--210; the separate generation
calculation and final source assembly remain with their respective owners.
-/

public section

open Subgroup GorensteinWalter
open scoped MatrixGroups
namespace Matrix.PSL3Two.Automorphisms.OuterCentralizerQuotient
local instance : Fact (Nat.Prime 7) := ⟨by decide⟩
local instance : Finite (PGL2 (ZMod 7)) :=
  Finite.of_surjective Matrix.ProjGenLinGroup.mk Matrix.ProjGenLinGroup.mk_surjective

private theorem seven_prime_power : IsOddPrimePower (Nat.card (ZMod 7)) := by
  refine ⟨7, 1, by decide, by decide, by decide, ?_⟩
  norm_num

private def dihedralQuotient : DihedralGroup 6 →* Equiv.Perm (Fin 3) where
  toFun d := match d with
    | .r i => (Equiv.swap 0 1 * Equiv.swap 1 2) ^ i.val
    | .sr i => Equiv.swap 0 1 * (Equiv.swap 0 1 * Equiv.swap 1 2) ^ i.val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

private theorem dihedralQuotient_surjective : Function.Surjective dihedralQuotient := by
  decide +kernel

private theorem dihedralQuotient_kernel : Nat.card dihedralQuotient.ker = 2 := by
  have h := dihedralQuotient.ker.index_mul_card
  rw [index_ker, dihedralQuotient.range_eq_top_of_surjective dihedralQuotient_surjective,
    card_top, DihedralGroup.nat_card] at h
  have hc : Nat.card (Equiv.Perm (Fin 3)) = 6 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin]
    decide
  rw [hc] at h
  omega

private theorem reflected_six_model {G : Type*} [Group G] [Finite G]
    (U : Subgroup G) (w : G) (hU : IsCyclic U) (hcard : Nat.card U = 6)
    (hw : w ∉ U) (hsq : w * w = 1)
    (hinv : ∀ x ∈ U, w * x * w⁻¹ = x⁻¹) :
    Nonempty ((U ⊔ zpowers w : Subgroup G) ≃* DihedralGroup 6) := by
  obtain ⟨r, hr⟩ := (Subgroup.isCyclic_iff_exists_zpowers_eq_top U).mp hU
  let D := U ⊔ zpowers w
  have hrU : r ∈ U := by rw [← hr]; exact mem_zpowers r
  let ρ : D := ⟨r, (le_sup_left : U ≤ D) hrU⟩
  let σ : D := ⟨w, (le_sup_right : zpowers w ≤ D) (mem_zpowers w)⟩
  have hgen : (⊤ : Subgroup D) = zpowers ρ ⊔ zpowers σ := by
    symm
    apply top_unique
    intro x _
    have hx : (x : G) ∈ (zpowers ρ ⊔ zpowers σ).map D.subtype := by
      rw [Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]
      change (x : G) ∈ zpowers r ⊔ zpowers w
      rw [hr]
      exact x.property
    obtain ⟨y, hy, he⟩ := hx
    exact (Subtype.ext he : y = x) ▸ hy
  have hσ2 : σ ^ 2 = 1 := Subtype.ext (by simpa [pow_two] using hsq)
  have hrel : σ * ρ * σ⁻¹ = ρ⁻¹ := Subtype.ext (hinv r hrU)
  have hσρ : σ ∉ zpowers ρ := by
    intro h
    apply hw
    rw [← hr]
    obtain ⟨k, hk⟩ := mem_zpowers_iff.mp h
    exact ⟨k, congrArg Subtype.val hk⟩
  have hord : orderOf ρ = 6 := by
    rw [← orderOf_injective D.subtype D.subtype_injective ρ]
    change orderOf r = 6
    rw [← Nat.card_zpowers, hr, hcard]
  have he := dihedral_of_generators_of_not_mem ρ σ hgen hσ2 hrel hσρ
  rwa [hord] at he

private abbrev standardInvolution : PGL2 (ZMod 7) :=
  pGammaL2FullSplitTorus (ZMod 7) (-1)

private theorem standardInvolution_outer : standardInvolution ∉
    (ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := ZMod 7)).range := by
  intro h
  have hs := (pgl2_mk_mem_psl2_range_iff_det_isSquare
    (pGammaL2FullSplitTorusGL (ZMod 7) (-1))).mp h
  have hn : ¬ IsSquare (-1 : ZMod 7) := by decide
  apply hn
  simpa [pGammaL2FullSplitTorusGL, Matrix.det_diagonal, Fin.prod_univ_two] using hs

private theorem standard_quotient :
    IsInvolution standardInvolution ∧
      ∃ π : centralizer ({standardInvolution} : Set (PGL2 (ZMod 7))) →* Equiv.Perm (Fin 3),
        Function.Surjective π ∧ Nat.card π.ker = 2 := by
  obtain ⟨w, hcyc, hcard, _, hs, hw, hsq, hinv, hcentral, _, _⟩ :=
    pgl2_fullSplitTorus_centralizer_data (ZMod 7) seven_prime_power
  have hc : Nat.card (pGammaL2FullSplitTorus (ZMod 7)).range = 6 := by
    simpa using hcard
  obtain ⟨e⟩ := reflected_six_model _ w hcyc hc hw hsq hinv
  let c : centralizer ({standardInvolution} : Set (PGL2 (ZMod 7))) ≃* DihedralGroup 6 :=
    (MulEquiv.subgroupCongr hcentral).trans e
  refine ⟨hs, dihedralQuotient.comp c.toMonoidHom,
    dihedralQuotient_surjective.comp c.surjective, ?_⟩
  rw [MulEquiv.toMonoidHom_eq_coe, MonoidHom.ker_comp_mulEquiv]
  exact (Nat.card_congr (c.symm.subgroupMap dihedralQuotient.ker).toEquiv).symm.trans
    dihedralQuotient_kernel

private theorem pgl_quotient (a : PGL2 (ZMod 7)) (ha : a ^ 2 = 1)
    (hout : a ∉ (ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := ZMod 7)).range) :
    ∃ π : centralizer ({a} : Set (PGL2 (ZMod 7))) →* Equiv.Perm (Fin 3),
      Function.Surjective π ∧ Nat.card π.ker = 2 := by
  have hs := standard_quotient.1
  have haI : IsInvolution a := ⟨fun h => hout (h ▸ one_mem _), by simpa [pow_two] using ha⟩
  have hconj := pgl2_outer_involutions_conjugate_of_odd_prime_power (ZMod 7)
    seven_prime_power haI hs hout standardInvolution_outer
  obtain ⟨g, hg⟩ := isConj_iff.mp hconj
  have hg' : (MulAut.conj g) a = standardInvolution := hg
  have hquot := standard_quotient.2
  rw [← hg'] at hquot
  obtain ⟨π, hπ, hk⟩ := hquot
  exact Theory.GroupTheory.CentralizerSmallKernelTransport.exists_quotient_of_equiv
    (MulAut.conj g) a π hπ hk

-- Keep the canonical conjugation map visible locally. The existing abstract
-- equivalence certifies its surjectivity by finite equipotence.
private noncomputable def comparisonPSL2 : PGL2 (ZMod 7) ≃* MulAut (PSL2 (ZMod 7)) := by
  let f := pgl2InnerAutPSL2 (ZMod 7) seven_prime_power (by norm_num)
  have hf : Function.Injective f := pgl2InnerAutPSL2_injective _ _ _
  apply MulEquiv.ofBijective f
  refine ⟨hf, ?_⟩
  have hs := Finite.surjective_of_injective
    (pgl2SevenEquivAutPSL2.symm.injective.comp hf)
  intro a
  obtain ⟨x, hx⟩ := hs (pgl2SevenEquivAutPSL2.symm a)
  exact ⟨x, pgl2SevenEquivAutPSL2.symm.injective hx⟩

private noncomputable def comparison : PGL2 (ZMod 7) ≃* MulAut SL :=
  (comparisonPSL2.trans
    (MulAut.congr Atlas.Comparisons.Exceptional.psl2SevenEquivPsl3Two)).trans
      (MulAut.congr Matrix.PSL3Two.equiv.symm)

private theorem comparison_inner (x : PSL2 (ZMod 7)) :
    comparison (ProjectiveSpecialLinearGroup.toPGL x) =
      MulAut.conj (Matrix.PSL3Two.equiv.symm
        (Atlas.Comparisons.Exceptional.psl2SevenEquivPsl3Two x)) := by
  change (MulAut.congr Matrix.PSL3Two.equiv.symm)
    ((MulAut.congr Atlas.Comparisons.Exceptional.psl2SevenEquivPsl3Two)
      (pgl2InnerAutPSL2 (ZMod 7) seven_prime_power (by norm_num)
        (ProjectiveSpecialLinearGroup.toPGL x))) = _
  rw [pgl2InnerAutPSL2_toPGL, MulAut.congr_conj, MulAut.congr_conj]

/-- Every outer involution of the actual binary matrix automorphism group has
an S₃ quotient of its full centralizer, with kernel of order two. -/
theorem exists_outer_centralizer_symmetricThree_quotient
    (z : MulAut SL) (hz : z ^ 2 = 1) (hout : z ∉ MulAut.innerSubgroup SL) :
    ∃ π : centralizer ({z} : Set (MulAut SL)) →* Equiv.Perm (Fin 3),
      Function.Surjective π ∧ Nat.card π.ker = 2 := by
  have ha : comparison.symm z ^ 2 = 1 := by rw [← map_pow, hz, map_one]
  have ho : comparison.symm z ∉
      (ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := ZMod 7)).range := by
    rintro ⟨x, hx⟩
    apply hout
    have he := congrArg comparison hx
    rw [comparison_inner, comparison.apply_symm_apply] at he
    exact ⟨_, he⟩
  obtain ⟨π, hπ, hk⟩ := pgl_quotient (comparison.symm z) ha ho
  exact Theory.GroupTheory.CentralizerSmallKernelTransport.exists_quotient_of_equiv
    comparison.symm z π hπ hk

end Matrix.PSL3Two.Automorphisms.OuterCentralizerQuotient
