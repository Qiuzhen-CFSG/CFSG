private def witnessKey (a b c d e f : ZMod 2) : Fin 64 :=
  ⟨a.val + 2 * b.val + 4 * c.val + 8 * d.val + 16 * e.val + 32 * f.val, by
    have := a.val_lt
    have := b.val_lt
    have := c.val_lt
    have := d.val_lt
    have := e.val_lt
    have := f.val_lt
    omega⟩
