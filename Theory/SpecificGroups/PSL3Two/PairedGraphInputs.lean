private theorem witness_spec : ∀ a b c d e f : ZMod 2,
    (!![c,b,a; e,d,b; f,e,c] : Matrix (Fin 3) (Fin 3) (ZMod 2)).det = 1 →
    (witnesses (witnessKey a b c d e f)).val * !![c,b,a; e,d,b; f,e,c] =
      (diagram (witnesses (witnessKey a b c d e f))).val := by
  decide +kernel
private theorem mul_conj_inv_eq_one {G : Type*} [Group G] (g w t : G)
    (hg : g * (w * t⁻¹ * w⁻¹) = 1) : g = w * t * w⁻¹ := by
  have he := mul_eq_one_iff_eq_inv.mp hg
  simpa only [_root_.mul_inv_rev, inv_inv, mul_assoc] using he
private theorem cocycle_shape (g : SL) (hg : g * diagram g = 1) :
    g.val = !![g.val 0 0, g.val 0 1, g.val 0 2;
      g.val 1 0, g.val 1 1, g.val 0 1; g.val 2 0, g.val 1 0, g.val 0 0] := by
  have he : g = Bruhat.perm 5 * g.transpose * (Bruhat.perm 5)⁻¹ := by
    exact mul_conj_inv_eq_one g (Bruhat.perm 5) g.transpose hg
  have hw : (Bruhat.perm 5)⁻¹ = Bruhat.perm 5 := by decide
  rw [hw] at he
  have he' : g.val = !![0,0,1; 0,1,0; 1,0,0] * g.val.transpose *
      !![0,0,1; 0,1,0; 1,0,0] := congrArg Subtype.val he
  have h12 := congrFun (congrFun he' 1) 2
  have h21 := congrFun (congrFun he' 2) 1
  have h22 := congrFun (congrFun he' 2) 2
  simp [Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_three] at h12 h21 h22
  ext i j
  fin_cases i <;> fin_cases j <;> simp [h12, h21, h22]
/-- Conjugation within SL₃(2) removes every involutory twist of the chosen graph action. -/
theorem exists_coboundary (g : SL) (hg : g * diagram g = 1) :
    ∃ h : SL, h * g * (diagram h)⁻¹ = 1 := by
  let h := witnesses (witnessKey (g.val 0 2) (g.val 0 1) (g.val 0 0)
    (g.val 1 1) (g.val 1 0) (g.val 2 0))
  refine ⟨h, ?_⟩
  have he : h * g = diagram h := by
    apply Subtype.ext
    change h.val * g.val = (diagram h).val
    rw [cocycle_shape g hg]
    apply witness_spec
    rw [← cocycle_shape g hg]
    exact g.property
  rw [he, mul_inv_cancel]
private def basis : SL := ⟨!![1,1,0; 1,1,1; 0,1,1], by decide⟩
private theorem conj_intertwines {G : Type*} [Group G]
    (γ : MulAut G) (b w x : G) (hb : γ b = b*w) :
    MulAut.conj b (MulAut.conj w (γ x)) = γ (MulAut.conj b x) := by
  simp only [MulAut.conj_apply, map_mul, map_inv, hb]
  group
private theorem basis_compatible (x : SL) :
    MulAut.conj basis (diagram x) =
      PSL3.OuterSolvable.graphSL (ZMod 2) (MulAut.conj basis x) := by
  have hb : PSL3.OuterSolvable.graphSL (ZMod 2) basis = basis * Bruhat.perm 5 := by decide
  exact conj_intertwines (PSL3.OuterSolvable.graphSL (ZMod 2)) basis (Bruhat.perm 5) x hb
/-- The fixed subgroup of the literal diagram action is S₃. -/
noncomputable def fixedEquivSymmetricThree : diagram.fixedSubgroup ≃* Equiv.Perm (Fin 3) :=
  (MulAut.fixedSubgroupEquivOfCompatible (MulAut.conj basis) diagram
    (PSL3.OuterSolvable.graphSL (ZMod 2)) basis_compatible).trans
      ((PSL3Four.GraphFixed.graphSLFixedEquivSL2 (ZMod 2)).trans
        (Classical.choice SLTwoPermThree.sl2Two_equiv_perm_three))
theorem card_fixedSubgroup : Nat.card diagram.fixedSubgroup = 6 := by
  rw [Nat.card_congr fixedEquivSymmetricThree.toEquiv, Nat.card_perm, Nat.card_fin]
  decide
theorem diagram_mem_borel_iff (g : SL) : diagram g ∈ borelSL ↔ g ∈ borelSL := by
  change (diagram g ∈ pointParabolicSL ∧ diagram g ∈ lineParabolicSL) ↔
    (g ∈ pointParabolicSL ∧ g ∈ lineParabolicSL)
  rw [← diagram_point_line (diagram g), diagram_involutive, diagram_point_line, and_comm]
theorem map_borel : borelSL.map diagram.toMonoidHom = borelSL := by
  ext x
  constructor
  · rintro ⟨g,hg,rfl⟩
    exact (diagram_mem_borel_iff g).mpr hg
  · intro hx
    exact ⟨diagram x, (diagram_mem_borel_iff x).mpr hx, diagram_involutive x⟩
/-- The highest-root involution I + E₀₂. -/
@[expose] def highestRoot : SL := Bruhat.upper 2
@[simp] theorem highestRoot_val : highestRoot.val = !![1,0,1; 0,1,0; 0,0,1] := rfl
theorem highestRoot_sq : highestRoot ^ 2 = 1 := by decide
theorem highestRoot_ne_one : highestRoot ≠ 1 := by decide
theorem highestRoot_orderOf : orderOf highestRoot = 2 :=
  orderOf_eq_prime highestRoot_sq highestRoot_ne_one
theorem diagram_highestRoot : diagram highestRoot = highestRoot := by decide
theorem highestRoot_mem_borel : highestRoot ∈ borelSL := Bruhat.upper_mem 2
private theorem upper_surjective : Function.Surjective
    (fun i : Fin 8 => (⟨Bruhat.upper i, Bruhat.upper_mem i⟩ : borelSL)) := by
  apply ((Fintype.bijective_iff_injective_and_card _).mpr ⟨?_, ?_⟩).2
  · have hi : Function.Injective Bruhat.upper := by decide +kernel
    intro i j hij
    exact hi (congrArg Subtype.val hij)
  · rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, card_borelSL]
private theorem fixed_upper : ∀ i : Fin 8, diagram (Bruhat.upper i) = Bruhat.upper i →
    Bruhat.upper i = 1 ∨ Bruhat.upper i = highestRoot := by decide +kernel
theorem fixed_borel_eq_zpowers : diagram.fixedSubgroup ⊓ borelSL = zpowers highestRoot := by
  apply le_antisymm
  · intro x hx
    obtain ⟨i,hi⟩ := upper_surjective ⟨x,hx.2⟩
    have hi' : Bruhat.upper i = x := congrArg Subtype.val hi
    have hfix : diagram (Bruhat.upper i) = Bruhat.upper i := by
      rw [hi']
      exact (MulAut.mem_fixedSubgroup _ _).mp hx.1
    rcases fixed_upper i hfix with he | he
    · rw [← hi', he]
      exact (zpowers highestRoot).one_mem
    · rw [← hi', he]
      exact mem_zpowers highestRoot
  · apply zpowers_le.mpr
    exact ⟨(MulAut.mem_fixedSubgroup _ _).mpr diagram_highestRoot, highestRoot_mem_borel⟩
theorem card_fixed_borel : Nat.card (diagram.fixedSubgroup ⊓ borelSL : Subgroup SL) = 2 := by
  rw [fixed_borel_eq_zpowers, Nat.card_zpowers, highestRoot_orderOf]
/-- The same fixed subgroup viewed inside the literal Borel. -/
theorem card_fixed_subgroupOf_borel :
    Nat.card (diagram.fixedSubgroup.subgroupOf borelSL) = 2 := by
  rw [← inf_subgroupOf_right diagram.fixedSubgroup borelSL,
    Nat.card_congr (subgroupOfEquivOfLe
      (show diagram.fixedSubgroup ⊓ borelSL ≤ borelSL from inf_le_right)).toEquiv]
  exact card_fixed_borel
