module

public import Theory.SpecificGroups.PSL3Two.SplitBlockActions.SplitParabolic.NaturalIdentification.Cores

/-!
# Application to genuinely split natural extensions

A complement and an equivariant identification of its normal eight-group
with the natural module construct `blockEquiv`. Transporting the proved
unitriangular embedding through its inverse gives a faithful map with image
the literal Borel preimage under the given quotient isomorphism. The point
and line markings use that same quotient map throughout.

The image of U is the embedded two-core of both the point preimage and its
two-residual L₁. The source actor L₂T_L equals the marked line preimage and
is generated by the Sylow image and the transported cubic. Its normalization
and all three middle-module actions follow from the concrete construction;
no action-image or parabolic-generator hypothesis is added.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, Notation
12.8.2, Section 14.3, and proof of 14.4.4, printed p.1007. The full source
splitting exclusion and ambient ParabolicGenerators assembly remain in the
chapter consumer.
-/

@[expose] public section

namespace Matrix.PSL3Two.SplitParabolic.SplitNaturalData
open Subgroup Unitriangular
variable {L : Type*} [Group L] {V : Subgroup L} [V.Normal] (d : SplitNaturalData V)

/-- Preimages use the given isomorphism of the literal quotient L/V. -/
def markedPreimage (P : Subgroup SL) : Subgroup L :=
 P.comap (d.quotient.toMonoidHom.comp (QuotientGroup.mk' V))

theorem markedPreimage_eq_map (P : Subgroup SL) :
 d.markedPreimage P = (P.comap projection).map d.blockEquiv.symm.toMonoidHom := by
 ext x
 rw [mem_map_equiv]
 change d.quotient (QuotientGroup.mk' V x) ∈ P ↔ projection (d.blockEquiv x) ∈ P
 rw [d.blockEquiv_projection]

noncomputable def unitriangularMap : T →* L :=
 d.blockEquiv.symm.toMonoidHom.comp sylowMap

theorem unitriangularMap_injective : Function.Injective d.unitriangularMap :=
 d.blockEquiv.symm.injective.comp sylowMap_injective

theorem unitriangularMap_range : d.unitriangularMap.range = d.markedPreimage borelSL := by
 rw [unitriangularMap,MonoidHom.range_comp,sylowMap_range,d.markedPreimage_eq_map]
 rfl

noncomputable def flaggedSylowEquiv : T ≃* d.markedPreimage borelSL :=
 (MonoidHom.ofInjective d.unitriangularMap_injective).trans
  (MulEquiv.subgroupCongr d.unitriangularMap_range)

theorem flaggedSylowEquiv_apply (x : T) :
 (d.flaggedSylowEquiv x : L) = d.unitriangularMap x := rfl

theorem unitriangularMap_middle (v : BinaryFourSplitPair.E) :
 d.unitriangularMap (middle v) = d.blockEquiv.symm (middleMap v) := by
 change d.blockEquiv.symm (sylowMap (middle v)) = _
 rw [sylowMap_middle]

theorem unitriangularMap_row : d.unitriangularMap r = d.blockEquiv.symm rowLift := by
 change d.blockEquiv.symm (sylowMap r) = _
 rw [sylowMap_row]

theorem unitriangularMap_column : d.unitriangularMap q = d.blockEquiv.symm columnLift := by
 change d.blockEquiv.symm (sylowMap q) = _
 rw [sylowMap_column]

theorem middle_image : A.map d.unitriangularMap = middleGroup.map d.blockEquiv.symm.toMonoidHom := by
 rw [unitriangularMap,← Subgroup.map_map,SplitParabolic.middle_image]

/-- The transported U is O₂ of the actual first marked preimage. -/
theorem U_image : U.map d.unitriangularMap = (d.markedPreimage pointParabolicSL).pCoreIn 2 := by
 rw [unitriangularMap,← Subgroup.map_map,SplitParabolic.U_image,
  map_pCoreIn_of_injective 2 pointPreimage _ d.blockEquiv.symm.injective,
  d.markedPreimage_eq_map]
 rfl

/-- The same subgroup is O₂(L₁), with L₁ defined as the two-residual. -/
theorem U_image_residual_core : U.map d.unitriangularMap =
 ((pResidual 2 (d.markedPreimage pointParabolicSL)).map
  (d.markedPreimage pointParabolicSL).subtype).pCoreIn 2 := by
 rw [unitriangularMap,← Subgroup.map_map,SplitParabolic.U_image_residual_core,
  map_pCoreIn_of_injective 2 _ _ d.blockEquiv.symm.injective,
  map_embedded_pResidual,d.markedPreimage_eq_map]
 rfl

/-- This constructs the full actor from the Sylow and a specified cubic lift. -/
theorem line_generators : d.markedPreimage lineParabolicSL =
 d.unitriangularMap.range ⊔ zpowers (d.blockEquiv.symm cubicLift) := by
 rw [d.markedPreimage_eq_map]
 change linePreimage.map d.blockEquiv.symm.toMonoidHom = _
 rw [linePreimage_eq_sup,Subgroup.map_sup,MonoidHom.map_zpowers,
  unitriangularMap,MonoidHom.range_comp,sylowMap_range]
 rfl

/-- The source L₂T_L is exactly the full line preimage. -/
theorem line_residual_sup_sylow :
 (pResidual 2 (d.markedPreimage lineParabolicSL)).map
  (d.markedPreimage lineParabolicSL).subtype ⊔ d.unitriangularMap.range =
  d.markedPreimage lineParabolicSL := by
 have he := congrArg (fun K : Subgroup Block => K.map d.blockEquiv.symm.toMonoidHom)
  SplitParabolic.line_residual_sup_sylow
 rw [Subgroup.map_sup,map_embedded_pResidual] at he
 rw [d.markedPreimage_eq_map,unitriangularMap,MonoidHom.range_comp,sylowMap_range]
 exact he

theorem line_normalizes_middle : d.markedPreimage lineParabolicSL ≤
 normalizer (A.map d.unitriangularMap : Set L) := by
 rw [d.markedPreimage_eq_map,d.middle_image]
 exact (map_mono linePreimage_normalizes_middle).trans (le_normalizer_map _)

theorem row_action (v : BinaryFourSplitPair.E) :
 d.unitriangularMap r * d.unitriangularMap (middle v) * (d.unitriangularMap r)⁻¹ =
 d.unitriangularMap (middle (BinaryFourSplitPair.row v)) := by
 rw [← map_inv,← map_mul,← map_mul,Unitriangular.row_action]

theorem column_action (v : BinaryFourSplitPair.E) :
 d.unitriangularMap q * d.unitriangularMap (middle v) * (d.unitriangularMap q)⁻¹ =
 d.unitriangularMap (middle (BinaryFourSplitPair.column v)) := by
 rw [← map_inv,← map_mul,← map_mul,Unitriangular.column_action]

/-- The cubic action uses the same middle coordinates as the transported Sylow. -/
theorem cubic_action (v : BinaryFourSplitPair.E) :
 d.blockEquiv.symm cubicLift * d.unitriangularMap (middle v) *
  (d.blockEquiv.symm cubicLift)⁻¹ =
 d.unitriangularMap (middle (BinaryFourSplitPair.columnCubic v)) := by
 rw [d.unitriangularMap_middle,d.unitriangularMap_middle,← map_inv,← map_mul,← map_mul,
  cubicLift_action]

/-- All data apply simultaneously to the residual actor used in 14.4.4. -/
theorem residual_actor_generators :
 (pResidual 2 (d.markedPreimage lineParabolicSL)).map
  (d.markedPreimage lineParabolicSL).subtype ⊔ d.unitriangularMap.range =
 d.unitriangularMap.range ⊔ zpowers (d.blockEquiv.symm cubicLift) :=
 (d.line_residual_sup_sylow).trans d.line_generators

theorem residual_actor_normalizes :
 (pResidual 2 (d.markedPreimage lineParabolicSL)).map
  (d.markedPreimage lineParabolicSL).subtype ⊔ d.unitriangularMap.range ≤
 normalizer (A.map d.unitriangularMap : Set L) := by
 rw [d.line_residual_sup_sylow]
 exact d.line_normalizes_middle

end Matrix.PSL3Two.SplitParabolic.SplitNaturalData
