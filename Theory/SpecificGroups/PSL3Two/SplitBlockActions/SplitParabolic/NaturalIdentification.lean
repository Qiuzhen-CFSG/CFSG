module

public import Theory.SpecificGroups.PSL3Two.SplitBlockActions.SplitParabolic.Unitriangular
public import Theory.SpecificGroups.PSL3Two.SplitBlockActions.SplitParabolic.NaturalModel

/-!
# The naturally marked Sylow subgroup and the second parabolic

Inverse transpose and reversal identify UT₄(2) with the upper triangular
subgroup of E₈ ⋊ SL₃(2), in the incident flag e₀ ⊂ {v₂ = 0}. Multiplicativity
and the inverse coordinate formulas are polynomial identities in characteristic
two. A cubic column operation moves every line-stabilizing matrix into the
Borel, so the full line preimage is generated by that Sylow group and the
specified cubic. Both generators normalize the actual middle sixteen-group.

The point-core and residual identifications and their transport to arbitrary
split natural extensions are provided in the descendants of this module.
Source: Aschbacher–Smith, combined manuscript of 1 March 2004, 12.8.2 and
14.3 (flag conventions), and proof of 14.4.4, printed p.1007.
-/

@[expose] public section

namespace Matrix.PSL3Two.SplitParabolic
open Unitriangular
set_option synthInstance.maxSize 512

def sylowElement (x : T) : Block :=
 ⟨Multiplicative.ofAdd
   ![x.x14+x.x12*x.x24+x.x13*x.x34+x.x12*x.x23*x.x34,
     x.x13+x.x12*x.x23, x.x12],
  ⟨!![1,x.x34,x.x24+x.x23*x.x34;0,1,x.x23;0,0,1], by simp [Matrix.det_fin_three]⟩⟩

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
def sylowMap : T →* Block where
 toFun := sylowElement
 map_one' := by
  apply SemidirectProduct.ext
  · apply Multiplicative.toAdd.injective
    funext i; fin_cases i <;> rfl
  · apply Subtype.ext; decide +kernel
 map_mul' := by
  intro x y
  apply SemidirectProduct.ext
  · apply Multiplicative.toAdd.injective
    funext i
    change _ = ((sylowElement x).left.toAdd + (sylowElement x).right.val.mulVec (sylowElement y).left.toAdd) i
    fin_cases i <;>
      simp [sylowElement, show x*y=mulT x y from rfl, mulT,
        Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;> ring_nf <;> simp only [show (2 : ZMod 2)=0 from rfl, show (4 : ZMod 2)=0 from rfl, mul_zero, add_zero]
  · apply Subtype.ext
    change (sylowElement (x*y)).right.val = (sylowElement x).right.val * (sylowElement y).right.val
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [sylowElement, show x*y=mulT x y from rfl, mulT,
        Matrix.mul_apply, Fin.sum_univ_three] <;> ring_nf <;> simp only [show (2 : ZMod 2)=0 from rfl, show (4 : ZMod 2)=0 from rfl, mul_zero, add_zero]

def recover (g : Block) : T :=
 ⟨g.left.toAdd 2, g.left.toAdd 1 + g.left.toAdd 2 * g.right.val 1 2,
  g.left.toAdd 0 + g.left.toAdd 2 * g.right.val 0 2 +
    g.left.toAdd 1 * g.right.val 0 1 +
    g.left.toAdd 2 * g.right.val 1 2 * g.right.val 0 1,
  g.right.val 1 2, g.right.val 0 2 + g.right.val 1 2*g.right.val 0 1,
  g.right.val 0 1⟩
theorem recover_sylowMap (x : T) : recover (sylowMap x)=x := by
 change recover (sylowElement x) = x
 ext <;> simp [recover, sylowElement] <;> ring_nf <;>
  simp only [show (2 : ZMod 2)=0 from rfl, show (4 : ZMod 2)=0 from rfl, mul_zero, add_zero]

theorem sylowMap_injective : Function.Injective sylowMap :=
 Function.LeftInverse.injective recover_sylowMap

theorem sylowMap_middle : ∀ v, sylowMap (middle v) = middleMap v := by
 intro v
 apply SemidirectProduct.ext
 · apply Multiplicative.toAdd.injective
   funext i; revert v i; decide +kernel
 · apply Subtype.ext
   change (sylowMap (middle v)).right.val = (middleMap v).right.val
   revert v
   decide +kernel

theorem sylowMap_row : sylowMap r = rowLift := by
 apply SemidirectProduct.ext
 · apply Multiplicative.toAdd.injective; decide +kernel
 · apply Subtype.ext; decide +kernel

theorem sylowMap_column : sylowMap q = columnLift := by
 apply SemidirectProduct.ext
 · apply Multiplicative.toAdd.injective; decide +kernel
 · apply Subtype.ext; decide +kernel

open Subgroup

theorem sylowMap_mem (x : T) : sylowMap x ∈ standardSylow := by
 change (sylowElement x).right ∈ borelSL
 rw [mem_borelSL_iff]
 exact ⟨rfl,rfl,rfl⟩

private theorem borel_shape (g : SL) (hg : g ∈ borelSL) :
 g.val = !![1,g.val 0 1,g.val 0 2;0,1,g.val 1 2;0,0,1] := by
 obtain ⟨h10,h20,h21⟩ := (mem_borelSL_iff g).mp hg
 have hd : g.val 0 0 * g.val 1 1 * g.val 2 2 = 1 := by
  simpa only [Matrix.det_fin_three,h10,h20,h21,mul_zero,zero_mul,add_zero,sub_zero] using g.property
 have hdiag : g.val 0 0=1 ∧ g.val 1 1=1 ∧ g.val 2 2=1 :=
  (by decide : ∀ a b c : ZMod 2, a*b*c=1 → a=1 ∧ b=1 ∧ c=1) _ _ _ hd
 ext i j
 fin_cases i <;> fin_cases j <;> simp [h10,h20,h21,hdiag.1,hdiag.2.1,hdiag.2.2]

theorem sylowMap_recover (g : Block) (hg : g ∈ standardSylow) :
 sylowMap (recover g) = g := by
 have hs := borel_shape g.right hg
 apply SemidirectProduct.ext
 · apply Multiplicative.toAdd.injective
   funext i
   change (sylowElement (recover g)).left.toAdd i = g.left.toAdd i
   fin_cases i <;> simp [sylowElement,recover] <;> ring_nf <;>
    simp only [show (2 : ZMod 2)=0 from rfl, show (4 : ZMod 2)=0 from rfl, mul_zero, add_zero]
 · apply Subtype.ext
   change (sylowElement (recover g)).right.val = g.right.val
   conv_rhs => rw [hs]
   ext i j
   fin_cases i <;> fin_cases j <;> simp [sylowElement,recover] <;> ring_nf <;>
    simp only [show (2 : ZMod 2)=0 from rfl, show (4 : ZMod 2)=0 from rfl, mul_zero, add_zero]

theorem sylowMap_range : sylowMap.range = standardSylow := by
 ext g
 exact ⟨fun ⟨x,hx⟩ => hx ▸ sylowMap_mem x,
  fun hg => ⟨recover g, sylowMap_recover g hg⟩⟩

def sylowEquiv : T ≃* standardSylow where
 toFun x := ⟨sylowMap x,sylowMap_mem x⟩
 invFun x := recover x
 left_inv := recover_sylowMap
 right_inv x := Subtype.ext (sylowMap_recover x x.property)
 map_mul' x y := Subtype.ext (sylowMap.map_mul x y)

theorem middle_image : A.map sylowMap = middleGroup := by
 ext g
 constructor
 · rintro ⟨x,hx,rfl⟩
   refine ⟨coordinates ⟨x,hx⟩,?_⟩
   rw [← sylowMap_middle]
   exact congrArg sylowMap (congrArg Subtype.val (coordinates.symm_apply_apply ⟨x,hx⟩))
 · rintro ⟨v,rfl⟩
   exact ⟨middle v,⟨rfl,rfl⟩,sylowMap_middle v⟩

/-- A cubic column operation moves every line-stabilizing matrix into the Borel. -/
private theorem line_reduce (g : SL) (hg : g ∈ lineParabolicSL) :
 g ∈ borelSL ∨ g*cubicLift.right ∈ borelSL ∨ g*cubicLift.right^2 ∈ borelSL := by
 have hb : cubicLift.right.val = !![1,1,0;1,0,0;0,0,1] := rfl
 obtain ⟨h20,h21⟩ := (mem_lineParabolicSL_iff g).mp hg
 by_cases hc : g.val 1 0 = 0
 · exact Or.inl ((mem_borelSL_iff g).mpr ⟨hc,h20,h21⟩)
 have hc1 : g.val 1 0 = 1 := (by decide : ∀ t : ZMod 2, t ≠ 0 → t=1) _ hc
 by_cases hd : g.val 1 1 = 0
 · right; right
   rw [mem_borelSL_iff]
   change (g.val * (cubicLift.right.val * cubicLift.right.val)) 1 0 = 0 ∧
    (g.val * (cubicLift.right.val * cubicLift.right.val)) 2 0 = 0 ∧
    (g.val * (cubicLift.right.val * cubicLift.right.val)) 2 1 = 0
   simp [show (1+1 : ZMod 2)=0 from rfl,hb,Matrix.mul_apply,Fin.sum_univ_three,hd,h20,h21]
 · right; left
   have hd1 : g.val 1 1 = 1 := (by decide : ∀ t : ZMod 2, t ≠ 0 → t=1) _ hd
   rw [mem_borelSL_iff]
   change (g.val*cubicLift.right.val) 1 0=0 ∧
    (g.val*cubicLift.right.val) 2 0=0 ∧ (g.val*cubicLift.right.val) 2 1=0
   simp [show (1+1 : ZMod 2)=0 from rfl,hb,Matrix.mul_apply,Fin.sum_univ_three,hc1,hd1,h20,h21]

theorem standardSylow_le_line : standardSylow ≤ linePreimage :=
 comap_mono inf_le_right

theorem cubicLift_mem_line : cubicLift ∈ linePreimage := by
 change cubicLift.right ∈ lineParabolicSL
 rw [mem_lineParabolicSL_iff]
 exact ⟨rfl,rfl⟩

/-- This is the full second parabolic, which the source denotes by L₂T_L. -/
theorem linePreimage_eq_sup : linePreimage = standardSylow ⊔ zpowers cubicLift := by
 apply le_antisymm
 · intro g hg
   let H := standardSylow ⊔ zpowers cubicLift
   have hb : cubicLift ∈ H := (show zpowers cubicLift ≤ H from le_sup_right) (mem_zpowers _)
   rcases line_reduce g.right hg with h | h | h
   · exact (show standardSylow ≤ H from le_sup_left) h
   · have hgb : g*cubicLift ∈ H := (show standardSylow ≤ H from le_sup_left) h
     simpa only [mul_inv_cancel_right] using H.mul_mem hgb (H.inv_mem hb)
   · have hgb : g*cubicLift^2 ∈ H := (show standardSylow ≤ H from le_sup_left) h
     simpa only [mul_inv_cancel_right] using H.mul_mem hgb (H.inv_mem (H.pow_mem hb 2))
 · exact sup_le standardSylow_le_line (zpowers_le.mpr cubicLift_mem_line)

theorem standardSylow_normalizes_middle : standardSylow ≤ normalizer (middleGroup : Set Block) := by
 rw [← sylowMap_range,← middle_image]
 rintro _ ⟨x,rfl⟩
 exact le_normalizer_map sylowMap ⟨x,by rw [A.normalizer_eq_top]; trivial,rfl⟩

theorem cubicLift_normalizes_middle : cubicLift ∈ normalizer (middleGroup : Set Block) := by
 rw [mem_normalizer_iff]
 intro x
 constructor
 · rintro ⟨v,rfl⟩
   exact ⟨BinaryFourSplitPair.columnCubic v,(cubicLift_action v).symm⟩
 · rintro ⟨v,hv⟩
   refine ⟨BinaryFourSplitPair.columnCubic.symm v,?_⟩
   have he := cubicLift_action (BinaryFourSplitPair.columnCubic.symm v)
   rw [MulEquiv.apply_symm_apply,hv] at he
   exact mul_left_cancel (mul_right_cancel he)

theorem linePreimage_normalizes_middle : linePreimage ≤ normalizer (middleGroup : Set Block) := by
 rw [linePreimage_eq_sup]
 exact sup_le standardSylow_normalizes_middle (zpowers_le.mpr cubicLift_normalizes_middle)

end Matrix.PSL3Two.SplitParabolic
