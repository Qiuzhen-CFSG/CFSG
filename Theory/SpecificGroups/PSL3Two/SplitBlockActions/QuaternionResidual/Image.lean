module

public import Theory.GroupTheory.NormalizerAction
public import Theory.GroupTheory.NormalizedSupCard
public import Mathlib.GroupTheory.Sylow

/-!
# Extracting a cubic from a relative normalizer image

All images are in the literal normalizer/centralizer quotient. If an abelian
subgroup A supplements U in T, then T and U have the same action on A.
Normalization of U passes to this image. An image of order twelve containing
this normal four-group is generated by it and an actual element of order three,
by Cauchy's theorem and the normalized-product order formula.

This is the final group-theoretic step of the quaternion calculation in
Aschbacher–Smith, combined manuscript of 1 March 2004, proof of 14.4.4,
printed p.1007. The order-twelve premise is deliberately left explicit here.
-/

namespace Subgroup.QuaternionResidual

open Subgroup

variable {G : Type*} [Group G]

/-- The actor image in N(A)/C(A), with restriction to N(A) built in. -/
public abbrev image (A P : Subgroup G) : Subgroup (NormalizerAction.Star A) :=
  NormalizerAction.sylowImage A P

public theorem image_mono (A : Subgroup G) {P R : Subgroup G} (h : P ≤ R) :
    image A P ≤ image A R :=
  map_mono (comap_mono h)

/-- Intersecting the actor with N(A) does not change its image. -/
public theorem image_inf_normalizer (A P : Subgroup G) :
    image A (P ⊓ normalizer (A : Set G)) = image A P := by
  apply congrArg (fun P : Subgroup (normalizer (A : Set G)) =>
    P.map (NormalizerAction.quotient A))
  ext x
  exact and_iff_left x.property

/-- An abelian supplement A contributes no additional action on A. -/
public theorem image_sup_self (A U : Subgroup G) [IsMulCommutative A]
    (hU : U ≤ normalizer (A : Set G)) :
    image A (U ⊔ A) = image A U := by
  change ((U ⊔ A).subgroupOf (normalizer (A : Set G))).map _ = _
  rw [subgroupOf_sup hU A.le_normalizer, map_sup]
  have hA : (A.subgroupOf (normalizer (A : Set G))).map
      (NormalizerAction.quotient A) = ⊥ := by
    apply eq_bot_iff.mpr
    rintro _ ⟨a, ha, rfl⟩
    exact (NormalizerAction.quotient_eq_one_iff A a).mpr
      ((le_centralizer_iff_isMulCommutative.mpr inferInstance) ha)
  rw [hA, sup_bot_eq]
  rfl

/-- Normalization of the embedded core passes through the actual quotient. -/
public theorem image_le_normalizer (A U R : Subgroup G)
    (hU : U ≤ normalizer (A : Set G))
    (hR : R ≤ normalizer (U : Set G)) :
    image A R ≤ normalizer (image A U : Set (NormalizerAction.Star A)) := by
  apply le_trans ?_ ((U.subgroupOf (normalizer (A : Set G))).le_normalizer_map
    (NormalizerAction.quotient A))
  apply map_mono
  rw [← subgroupOf_normalizer_eq hU]
  exact comap_mono hR

/-- The action order counts the actual centralizer in the actor. -/
public theorem card_image_mul_centralizer [Finite G] (A U : Subgroup G)
    (hU : U ≤ normalizer (A : Set G)) :
    Nat.card (U ⊓ centralizer (A : Set G) : Subgroup G) *
      Nat.card (image A U) = Nat.card U := by
  let f : U →* NormalizerAction.Star A :=
    (NormalizerAction.quotient A).comp (inclusion hU)
  have hr : f.range = image A U := by
    ext x
    constructor
    · rintro ⟨u, rfl⟩
      exact ⟨inclusion hU u, u.property, rfl⟩
    · rintro ⟨u, hu, rfl⟩
      exact ⟨⟨u, hu⟩, rfl⟩
  let e : f.ker ≃* (U ⊓ centralizer (A : Set G) : Subgroup G) := {
    toFun := fun u => ⟨u.val.val, u.val.property,
      (NormalizerAction.quotient_eq_one_iff A (inclusion hU u.val)).mp u.property⟩
    invFun := fun u => ⟨⟨u, u.property.1⟩,
      (NormalizerAction.quotient_eq_one_iff A (inclusion hU ⟨u, u.property.1⟩)).mpr
        u.property.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl }
  have hc := f.ker.card_mul_index
  rwa [index_ker, hr, Nat.card_congr e.toEquiv] at hc

/-- The order of an actual action is its relative centralizer index. -/
public theorem card_image_eq_relIndex (A R : Subgroup G)
    (hR : R ≤ normalizer (A : Set G)) :
    Nat.card (image A R) = (centralizer (A : Set G)).relIndex R := by
  change Nat.card ((R.subgroupOf (normalizer (A : Set G))).map
    (NormalizerAction.quotient A)) = _
  rw [← relIndex_ker, show (NormalizerAction.quotient A).ker = NormalizerAction.C A
    from QuotientGroup.ker_mk' _]
  exact relIndex_subgroupOf hR

/-- Separate the two-core action from the outer normalizer calculation.
The centralizer containment ensures that these are indices in one tower. -/
public theorem card_image_of_two_indices (A R Q : Subgroup G)
    (hRN : R ≤ normalizer (A : Set G))
    (hCQ : R ⊓ centralizer (A : Set G) ≤ Q)
    (hfour : (centralizer (A : Set G)).relIndex (R ⊓ Q) = 4)
    (hthree : Q.relIndex R = 3) : Nat.card (image A R) = 12 := by
  rw [card_image_eq_relIndex A R hRN]
  have h := relIndex_mul_relIndex (R ⊓ centralizer (A : Set G)) (R ⊓ Q) R
    (le_inf inf_le_left hCQ) inf_le_left
  rw [inf_relIndex_left, hthree, inf_relIndex_left] at h
  have he : (R ⊓ centralizer (A : Set G)).relIndex (R ⊓ Q) =
      (centralizer (A : Set G)).relIndex (R ⊓ Q) := by
    rw [← inf_relIndex_right (centralizer (A : Set G)) (R ⊓ Q),
      ← inf_relIndex_right (R ⊓ centralizer (A : Set G)) (R ⊓ Q)]
    congr 1
    ext x
    simp only [mem_inf]
    tauto
  rw [he, hfour] at h
  exact h.symm

/-- A normal four-group in an order-twelve group has a cubic supplement.
No identification with A₄ or coordinate action is assumed. -/
public theorem exists_cubic_supplement [Finite G] (P R : Subgroup G)
    (hPR : P ≤ R) (hn : R ≤ normalizer (P : Set G))
    (hP : Nat.card P = 4) (hR : Nat.card R = 12) :
    ∃ c : G, c ^ 3 = 1 ∧ c ≠ 1 ∧ c ∈ normalizer (P : Set G) ∧
      R = P ⊔ zpowers c := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨c, hc⟩ := exists_prime_orderOf_dvd_card' (G := R) 3 (by rw [hR]; decide)
  have hc3 : (c : G) ^ 3 = 1 := by
    exact congrArg Subtype.val (hc ▸ pow_orderOf_eq_one c)
  have hc1 : (c : G) ≠ 1 := by
    intro h
    have h' : c = 1 := Subtype.ext h
    simp [h'] at hc
  have hcG : orderOf (c : G) = 3 := orderOf_eq_prime hc3 hc1
  have hdisj : Disjoint P (zpowers (c : G)) := by
    apply disjoint_iff.mpr
    apply (card_eq_one.mp ?_)
    have hdP := card_dvd_of_le (inf_le_left : P ⊓ zpowers (c : G) ≤ P)
    have hdC := card_dvd_of_le (inf_le_right : P ⊓ zpowers (c : G) ≤ zpowers (c : G))
    rw [hP] at hdP
    rw [Nat.card_zpowers, hcG] at hdC
    exact Nat.dvd_one.mp (by simpa using Nat.dvd_gcd hdP hdC)
  refine ⟨c, hc3, hc1, hn c.property, ?_⟩
  symm
  apply eq_of_le_of_card_ge (sup_le hPR (zpowers_le.mpr c.property))
  rw [card_sup_eq_mul_of_normalizes_of_disjoint P (zpowers (c : G))
    (zpowers_le.mpr (hn c.property)) hdisj, hP, Nat.card_zpowers, hcG, hR]

end Subgroup.QuaternionResidual
