module

public import Theory.SpecificGroups.PSL3Two.PairedGraphInputs
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Center and normalizer of the standard Borel in SL₃(2)

The upper triangular subgroup has center generated by the marked highest-root
involution. Its ambient centralizer and its normalizer are both the Borel.

The eight upper matrices determine the center. Commuting with the highest-root
matrix forces the three lower triangular entries to vanish. A normalizer
preserves the unique central involution, so the centralizer calculation gives
the normalizer as well.

These are the single-factor Sylow facts used in the paired-group calculation
of Aschbacher–Smith, Lemma 2.4.34, combined manuscript of 1 March 2004,
printed p.548.
-/

public section
open Matrix Subgroup
open Matrix.PSL3Two Matrix.PSL3Two.PairedGraphInputs
namespace Matrix.PSL3Two.BorelCenterNormalizer
private theorem upper_surjective : Function.Surjective
    (fun i : Fin 8 => (⟨Bruhat.upper i, Bruhat.upper_mem i⟩ : borelSL)) := by
  apply ((Fintype.bijective_iff_injective_and_card _).mpr ⟨?_, ?_⟩).2
  · have hi : Function.Injective Bruhat.upper := by decide +kernel
    intro i j hij
    exact hi (congrArg Subtype.val hij)
  · rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, card_borelSL]
private theorem central_upper : ∀ i : Fin 8,
    Bruhat.upper 1 * Bruhat.upper i = Bruhat.upper i * Bruhat.upper 1 →
    Bruhat.upper 4 * Bruhat.upper i = Bruhat.upper i * Bruhat.upper 4 →
    Bruhat.upper i = 1 ∨ Bruhat.upper i = highestRoot := by decide +kernel
private theorem highestRoot_commutes_upper : ∀ i : Fin 8,
    Bruhat.upper i * highestRoot = highestRoot * Bruhat.upper i := by decide +kernel

/-- The marked highest-root involution lies in the center of the actual Borel. -/
theorem highestRoot_mem_center :
    (⟨highestRoot, highestRoot_mem_borel⟩ : borelSL) ∈ center borelSL := by
  apply mem_center_iff.mpr
  intro x
  obtain ⟨i, rfl⟩ := upper_surjective x
  exact Subtype.ext (highestRoot_commutes_upper i)

/-- The Borel has exactly one nonidentity central element. -/
theorem center_mem_iff (x : borelSL) :
    x ∈ center borelSL ↔ (x : SL) = 1 ∨ (x : SL) = highestRoot := by
  constructor
  · intro hx
    obtain ⟨i, rfl⟩ := upper_surjective x
    apply central_upper
    · exact congrArg Subtype.val (mem_center_iff.mp hx ⟨Bruhat.upper 1, Bruhat.upper_mem 1⟩)
    · exact congrArg Subtype.val (mem_center_iff.mp hx ⟨Bruhat.upper 4, Bruhat.upper_mem 4⟩)
  · rintro (hx | hx)
    · have he : x = 1 := Subtype.ext hx
      rw [he]
      exact (center borelSL).one_mem
    · have he : x = ⟨highestRoot, highestRoot_mem_borel⟩ := Subtype.ext hx
      rw [he]
      exact highestRoot_mem_center

/-- The center, with its literal ambient embedding, is the highest-root subgroup. -/
theorem center_image_eq_zpowers :
    (center borelSL).map borelSL.subtype = zpowers highestRoot := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    rcases (center_mem_iff x).mp hx with he | he
    · change (x : SL) ∈ zpowers highestRoot
      rw [he]
      exact (zpowers highestRoot).one_mem
    · change (x : SL) ∈ zpowers highestRoot
      rw [he]
      exact mem_zpowers highestRoot
  · apply zpowers_le.mpr
    exact ⟨⟨highestRoot, highestRoot_mem_borel⟩, highestRoot_mem_center, rfl⟩

/-- The highest-root involution has the Borel as its whole ambient centralizer. -/
theorem centralizer_highestRoot : centralizer ({highestRoot} : Set SL) = borelSL := by
  apply le_antisymm
  · intro g hg
    have he : g.val * highestRoot.val = highestRoot.val * g.val :=
      congrArg (fun x : SL => x.val) (mem_centralizer_singleton_iff.mp hg)
    have h10 := congrFun (congrFun he 1) 2
    have h20 := congrFun (congrFun he 0) 0
    have h21 := congrFun (congrFun he 0) 1
    simp [highestRoot_val, Matrix.mul_apply, Fin.sum_univ_three] at h10 h20 h21
    exact (mem_borelSL_iff g).mpr ⟨h10,h20,h21⟩
  · intro g hg
    apply mem_centralizer_singleton_iff.mpr
    exact congrArg Subtype.val (mem_center_iff.mp highestRoot_mem_center ⟨g,hg⟩)

/-- The standard Borel of SL₃(2) is self-normalizing. -/
theorem normalizer_borel : normalizer (borelSL : Set SL) = borelSL := by
  apply le_antisymm ?_ borelSL.le_normalizer
  exact (normalizer_le_centralizer_of_characteristic_involution borelSL
    (center borelSL) highestRoot highestRoot_orderOf center_image_eq_zpowers).trans_eq
      centralizer_highestRoot
end Matrix.PSL3Two.BorelCenterNormalizer
