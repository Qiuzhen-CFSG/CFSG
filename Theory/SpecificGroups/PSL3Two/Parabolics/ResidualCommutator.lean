module

public import Theory.SpecificGroups.PSL3Two.Parabolics.ResidualRecognition
public import Theory.SpecificGroups.PSL3Two.Parabolics.MarkedAutomorphisms.TranslationCommutator

/-!
# Commutator generation of a binary parabolic residual

A two-perfect subgroup A of SL₃(2) with cubic two-core quotient, normalized
by a Sylow two-subgroup S, satisfies [A,S] = A. Residual recognition reduces
to the standard point and line parabolics. In the point parabolic the
translation four-group is generated by its cubic commutators, and a single
upper transvection inverts the cubic Levi element. These generate the
order-twelve residual. The fixed diagram automorphism handles the line.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), the final
paragraph of the proof of 13.6.20, printed p.931. The residual has order
twelve; the full normalizer is the order-twenty-four parabolic.
-/

public section
open Subgroup
open scoped commutatorElement
namespace Matrix.PSL3Two
open MarkedAutomorphisms

private theorem pointV_le_borel : pointV ≤ borelSL := by
  intro g hg
  rw [mem_borelSL_iff]
  exact ⟨hg.2.1, hg.2.2.1, hg.2.2.2.2.2.1⟩

private theorem point_residual_commutator :
    ⁅residual pointParabolicSL, borelSL⁆ = residual pointParabolicSL := by
  have hn : borelSL ≤ normalizer (pointA : Set SL) :=
    (show borelSL ≤ pointParabolicSL from inf_le_left).trans
      (le_normalizer_iff.mpr pointA_conj)
  rw [point_residual]
  let D := ⁅pointA, borelSL⁆
  have hDA : D ≤ pointA := le_normalizer_iff_commutator_le_left.mp hn
  have hVD : pointV ≤ D := by
    rw [pointV_eq_commutator_residual, point_residual, commutator_comm]
    exact commutator_mono le_rfl pointV_le_borel
  have hc : cubic ∈ D := by
    have hh : cubic ^ 2 ∈ D := by
      rw [show cubic ^ 2 = ⁅cubic, Bruhat.upper 4⁆ by decide +kernel]
      exact commutator_mem_commutator cubic_mem (Bruhat.upper_mem 4)
    have hh' := D.pow_mem hh 2
    rwa [show (cubic ^ 2) ^ 2 = cubic by decide +kernel] at hh'
  have h4 : 4 ∣ Nat.card D := card_pointV ▸ card_dvd_of_le hVD
  have h3 : 3 ∣ Nat.card D := by
    have ho : orderOf cubic = 3 := orderOf_eq_prime cubic_cube (by decide +kernel)
    have hh := card_dvd_of_le (zpowers_le.mpr hc)
    rwa [Nat.card_zpowers, ho] at hh
  apply eq_of_le_of_card_ge hDA
  rw [card_pointA]
  exact Nat.le_of_dvd (Nat.card_pos) ((by decide : Nat.Coprime 4 3).mul_dvd_of_dvd_of_dvd h4 h3)

private theorem diagram_borel : borelSL.map diagram.toMonoidHom = borelSL := by
  have hl : lineParabolicSL.map diagram.toMonoidHom = pointParabolicSL := by
    rw [← pointParabolic_map_diagram, Subgroup.map_map]
    have he : diagram.toMonoidHom.comp diagram.toMonoidHom = MonoidHom.id SL := by
      apply MonoidHom.ext
      exact diagram_involutive
    rw [he, Subgroup.map_id]
  change (pointParabolicSL ⊓ lineParabolicSL).map diagram.toMonoidHom = _
  rw [Subgroup.map_inf _ _ _ diagram.injective, pointParabolic_map_diagram, hl, inf_comm]
  rfl

private theorem line_residual_commutator :
    ⁅residual lineParabolicSL, borelSL⁆ = residual lineParabolicSL := by
  have hh := congrArg (Subgroup.map diagram.toMonoidHom) point_residual_commutator
  rw [map_commutator, diagram_borel] at hh
  have he : (residual pointParabolicSL).map diagram.toMonoidHom = residual lineParabolicSL := by
    rw [MarkedAutomorphisms.residual, map_embedded_pResidual, pointParabolic_map_diagram]
    rfl
  rwa [he] at hh

/-- The actual Sylow subgroup generates the entire parabolic two-residual by commutators. -/
theorem ResidualRecognition.commutator_sylow_eq (A : Subgroup SL) (S : Sylow 2 SL)
    (hA : IsPPerfect 2 A) (hc : Nat.card (A ⧸ pCore 2 A) = 3)
    (hn : (S : Subgroup SL) ≤ normalizer (A : Set SL)) :
    ⁅A, (S : Subgroup SL)⁆ = A := by
  obtain ⟨_, _, _, _, g, P, hP, _, hA', hS, _⟩ := ResidualRecognition.recognize A S hA hc hn
  apply Subgroup.map_injective (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective
  rw [map_commutator, hA', hS]
  rcases hP with rfl | rfl
  · exact point_residual_commutator
  · exact line_residual_commutator

end Matrix.PSL3Two
