module
public import Theory.SpecificGroups.PSL3Two.Parabolics.ResidualCommutator
public import Theory.GroupTheory.PCoreFrattiniTransport

/-!
# Sylow commutators above the binary linear-three quotient

A two-group cover of SL₃(2) preserves the intrinsic two-core quotient of
every subgroup. For a two-perfect cubic residual normalized by a Sylow
two-subgroup, residual recognition in the model says that its image is
generated by Sylow commutators. The original commutator subgroup therefore
cannot be a two-group: its image still has a quotient of order three.

Source application: Aschbacher–Smith, proof of 12.4.6, printed p.814.
The consumer supplies the actual marked quotient of L and the Sylow
intersection T∩L. The parabolic computation is in `ResidualCommutator`.
-/

@[expose] public section
open Subgroup
namespace Matrix.PSL3Two.ResidualRecognition
variable {H : Type*} [Group H] [Finite H]

/-- Sylow commutators of a covered cubic residual cannot lie in any two-group. -/
theorem commutator_not_two_of_cover
    (f : H →* SL) (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker)
    (A : Subgroup H) (S : Sylow 2 H) (hA : IsPPerfect 2 A)
    (hc : Nat.card (A ⧸ pCore 2 A) = 3)
    (hn : (S : Subgroup H) ≤ normalizer (A : Set H)) :
    ¬ IsPGroup 2 (⁅A, (S : Subgroup H)⁆ : Subgroup H) := by
  let B := A.map f
  have hp : IsPPerfect 2 B :=
    hA.of_surjective (f.subgroupMap A) (f.subgroupMap_surjective A)
  have hkA : IsPGroup 2 (f.subgroupMap A).ker := by
    rw [ker_subgroupMap]
    exact hk.comap_subtype
  have hb : Nat.card (B ⧸ pCore 2 B) = 3 :=
    (Nat.card_congr ((f.subgroupMap A).pCoreQuotientEquiv
      (f.subgroupMap_surjective A) hkA).toEquiv).symm.trans hc
  have hnB : ((S : Subgroup H).map f) ≤ normalizer (B : Set SL) :=
    (map_mono hn).trans (A.le_normalizer_map f)
  have hgen := commutator_sylow_eq B (S.mapSurjective hf) hp hb hnB
  change ⁅B, (S : Subgroup H).map f⁆ = B at hgen
  intro htwo
  have hBtwo : IsPGroup 2 B := by
    have hi := htwo.map f
    rw [map_commutator] at hi
    change IsPGroup 2 (⁅B, ((S : Subgroup H).map f)⁆ : Subgroup SL) at hi
    rwa [hgen] at hi
  have hqtwo := hBtwo.to_quotient (pCore 2 B)
  obtain ⟨n, hn⟩ := hqtwo.exists_card_eq
  rw [hb] at hn
  have hd : 3 ∣ 2 ^ n := hn ▸ dvd_refl 3
  have := Nat.prime_three.dvd_of_dvd_pow hd
  norm_num at this
end Matrix.PSL3Two.ResidualRecognition
