module

public import Theory.SpecificGroups.PSL3Two.Parabolics.Subgroups.Coordinates

/-!
# A binary Bruhat certificate

Every determinant-one binary matrix is an upper-triangular matrix times one of
six permutation matrices times another upper-triangular matrix. The table gives
these three indices for each nine-bit matrix code. Kernel reduction checks the
matrix equations, rather than trusting the table's generation. Short words also
recover each simple reflection from every Bruhat representative outside the
corresponding parabolic.

This proves the rank-two overgroup step in Aschbacher–Smith I.5.3–4.
-/

namespace Matrix.PSL3Two
namespace Bruhat

set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

@[expose] public def upper : Fin 8 → SL :=
  ![⟨!![1, 0, 0; 0, 1, 0; 0, 0, 1], by decide⟩,
    ⟨!![1, 1, 0; 0, 1, 0; 0, 0, 1], by decide⟩,
    ⟨!![1, 0, 1; 0, 1, 0; 0, 0, 1], by decide⟩,
    ⟨!![1, 1, 1; 0, 1, 0; 0, 0, 1], by decide⟩,
    ⟨!![1, 0, 0; 0, 1, 1; 0, 0, 1], by decide⟩,
    ⟨!![1, 1, 0; 0, 1, 1; 0, 0, 1], by decide⟩,
    ⟨!![1, 0, 1; 0, 1, 1; 0, 0, 1], by decide⟩,
    ⟨!![1, 1, 1; 0, 1, 1; 0, 0, 1], by decide⟩]

@[expose] public def perm : Fin 6 → SL :=
  ![⟨!![1, 0, 0; 0, 1, 0; 0, 0, 1], by decide⟩,
    ⟨!![1, 0, 0; 0, 0, 1; 0, 1, 0], by decide⟩,
    ⟨!![0, 1, 0; 1, 0, 0; 0, 0, 1], by decide⟩,
    ⟨!![0, 1, 0; 0, 0, 1; 1, 0, 0], by decide⟩,
    ⟨!![0, 0, 1; 1, 0, 0; 0, 1, 0], by decide⟩,
    ⟨!![0, 0, 1; 0, 1, 0; 1, 0, 0], by decide⟩]

public theorem upper_mem (i : Fin 8) : upper i ∈ borelSL := by
  rw [mem_borelSL_iff]
  revert i
  decide

private def matrixCodeEquiv : Matrix (Fin 3) (Fin 3) (ZMod 2) ≃ Fin 512 :=
  (Equiv.curry (Fin 3) (Fin 3) (Fin 2)).symm |>.trans
    ((Equiv.arrowCongr finProdFinEquiv (Equiv.refl (Fin 2))).trans finFunctionFinEquiv)

private def decode (c : Fin 512) : Matrix (Fin 3) (Fin 3) (ZMod 2) :=
  matrixCodeEquiv.symm c

