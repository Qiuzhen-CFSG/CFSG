    ⟨0, 0, 0⟩]

private theorem certificate : ∀ c : Fin 512, (decode c).det = 1 →
    decode c = (upper (factors c).1 * perm (factors c).2.1 * upper (factors c).2.2).val := by
  decide +kernel

public theorem decomposition (g : SL) : ∃ i j k, g = upper i * perm j * upper k := by
  let c := matrixCodeEquiv g.val
  have hc : decode c = g.val := matrixCodeEquiv.symm_apply_apply g.val
  refine ⟨(factors c).1, (factors c).2.1, (factors c).2.2, ?_⟩
  apply Subtype.ext
  exact hc.symm.trans (certificate c (hc.symm ▸ g.property))

private def generators (j : Fin 6) : Fin 3 → SL := ![upper 1, upper 4, perm j]
private def pointWords : Fin 6 → List (Fin 3) :=
  ![[],
    [],
    [2],
    [0, 1, 2, 0, 2, 0, 1, 2, 0],
    [0, 1, 2, 1, 0, 1, 2, 1, 2],
    [0, 2, 1, 2, 0]]
private def lineWords : Fin 6 → List (Fin 3) :=
  ![[],
    [2],
    [],
    [1, 0, 2, 0, 1, 0, 2, 0, 2],
    [1, 0, 2, 1, 2, 1, 0, 2, 1],
    [1, 2, 0, 2, 1]]

private theorem point_certificate : ∀ j : Fin 6,
    ((perm j).val 1 0 = 0 ∧ (perm j).val 2 0 = 0) ∨
      ((pointWords j).map (generators j)).prod = perm 2 := by decide +kernel
private theorem line_certificate : ∀ j : Fin 6,
    ((perm j).val 2 0 = 0 ∧ (perm j).val 2 1 = 0) ∨
      ((lineWords j).map (generators j)).prod = perm 1 := by decide +kernel

private theorem word_mem (H : Subgroup SL) (j : Fin 6) (hB : borelSL ≤ H)
    (hj : perm j ∈ H) (w : List (Fin 3)) : (w.map (generators j)).prod ∈ H := by
  apply H.list_prod_mem
  intro g hg
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hg
  fin_cases i
  · exact hB (upper_mem 1)
  · exact hB (upper_mem 4)
  · exact hj

public theorem point_reflection_mem (H : Subgroup SL) (hB : borelSL ≤ H)
    (j : Fin 6) (hj : perm j ∈ H) (hp : perm j ∉ pointParabolicSL) : perm 2 ∈ H := by
  rcases point_certificate j with h | h
  · exact (hp ((mem_pointParabolicSL_iff _).mpr h)).elim
  · rw [← h]
    exact word_mem H j hB hj _

public theorem line_reflection_mem (H : Subgroup SL) (hB : borelSL ≤ H)
    (j : Fin 6) (hj : perm j ∈ H) (hp : perm j ∉ lineParabolicSL) : perm 1 ∈ H := by
  rcases line_certificate j with h | h
  · exact (hp ((mem_lineParabolicSL_iff _).mpr h)).elim
  · rw [← h]
    exact word_mem H j hB hj _

private def permWords : Fin 6 → List (Fin 2) :=
  ![[],
    [0],
    [1],
    [0, 1],
    [1, 0],
    [0, 1, 0]]
private theorem perm_certificate : ∀ j : Fin 6,
    ((permWords j).map (![perm 1, perm 2])).prod = perm j := by decide +kernel

public theorem eq_top (H : Subgroup SL) (hB : borelSL ≤ H)
    (h1 : perm 1 ∈ H) (h2 : perm 2 ∈ H) : H = ⊤ := by
  apply top_unique
  intro g _
  obtain ⟨i, j, k, rfl⟩ := decomposition g
  apply H.mul_mem (H.mul_mem (hB (upper_mem i)) _) (hB (upper_mem k))
  rw [← perm_certificate j]
  apply H.list_prod_mem
  intro g hg
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hg
  fin_cases i
  · exact h1
  · exact h2

end Bruhat
end Matrix.PSL3Two
