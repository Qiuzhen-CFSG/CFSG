module

public import Theory.SpecificGroups.PSL3Two.Parabolics.MarkedAutomorphisms.Residuals

/-!
# The cubic action on the point radical

Every point translation is a commutator with the fixed cubic Levi element.
The calculation uses the four two-parameter translation matrices, followed by
normality of the radical in the explicit residual. Thus the radical equals its
commutator with the intrinsic two-residual of the point parabolic.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), the marked
actor calculation in the proof of 15.3.59, printed p.1150.
-/

namespace Matrix.PSL3Two.MarkedAutomorphisms
open Subgroup
open scoped commutatorElement

private def translation (a b : ZMod 2) : SL :=
  ⟨!![1,a,b; 0,1,0; 0,0,1], by simp [Matrix.det_fin_three]⟩

private theorem translation_eq (x : SL) (hx : x ∈ pointV) :
    x = translation (x.val 0 1) (x.val 0 2) := by
  rcases hx with ⟨h00, h10, h20, h11, h12, h21, h22⟩
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [translation, h00, h10, h20, h11, h12, h21, h22]

private theorem translation_cubic : ∀ a b : ZMod 2,
    ⁅cubic * translation a b * cubic⁻¹, cubic⁆ = translation a b := by
  decide +kernel

private theorem cubic_commutator (x : SL) (hx : x ∈ pointV) :
    ⁅cubic * x * cubic⁻¹, cubic⁆ = x := by
  rw [translation_eq x hx]
  exact translation_cubic _ _

/-- The point radical is generated by its commutators with the actual
two-residual of its parabolic. -/
public theorem pointV_eq_commutator_residual :
    pointV = ⁅pointV, residual pointParabolicSL⁆ := by
  rw [point_residual]
  apply le_antisymm
  · intro x hx
    rw [← cubic_commutator x hx]
    exact commutator_mem_commutator (pointV_conj cubic cubic_mem x hx) cubic_mem
  · apply commutator_le.mpr
    intro x hx y hy
    have hm := pointV.mul_mem hx (pointV.inv_mem (pointV_conj y hy x hx))
    convert hm using 1
    group

end Matrix.PSL3Two.MarkedAutomorphisms
