module
public import Theory.SpecificGroups.AlternatingSixNormalizer
public import Theory.SpecificGroups.QuinticTwoLocal
public import Theory.GroupTheory.ElementaryNormalizerThreeRank

/-!
# Quintic actors and even two-local normalizers in degrees seven and eight

The image of a cyclic-five extension by a two-group in A₇ or A₈ has order
five: a nontrivial image of the two-core would have a quintic normalizer.
A nontrivial permutation two-subgroup normalized by such a five-subgroup
is generated by a transposition. Its full even normalizer cannot normalize
the five-subgroup, by the permutation centralizer formula and the order-four
automizer bound.

Source application: Aschbacher--Smith 14.6.15, printed p.1035, in
Quintic.SourceComponent.PermutationRows. The actual star radical and
first-factor action are retained in that application.
-/

public section
open Subgroup
namespace Theory.SpecificGroups.QuinticPermutation

private theorem even_normalizer_five_free {n : ℕ} (hn : n = 7 ∨ n = 8)
    (Q : Subgroup (alternatingGroup (Fin n))) (hQ : IsPGroup 2 Q) (hne : Q ≠ ⊥) :
    ¬5 ∣ Nat.card (normalizer (Q : Set (alternatingGroup (Fin n)))) := by
  rcases hn with rfl | rfl
  · exact AlternatingSixNormalizer.seven_five_not_dvd_normalizer Q hQ hne
  · exact AlternatingSixNormalizer.eight_five_not_dvd_normalizer Q hQ hne

private theorem radical_card_two {n : ℕ} (hn : n = 7 ∨ n = 8)
    (Q P : Subgroup (Equiv.Perm (Fin n))) (hQ : IsPGroup 2 Q) (hne : Q ≠ ⊥)
    (hPe : P ≤ alternatingGroup (Fin n)) (hPQ : P ≤ normalizer (Q : Set (Equiv.Perm (Fin n))))
    (h5 : 5 ∣ Nat.card P) : Nat.card Q = 2 := by
  have he : Q.subgroupOf (alternatingGroup (Fin n)) = ⊥ := by
    by_contra he
    apply even_normalizer_five_free hn _ hQ.comap_subtype he
    have hN : P.subgroupOf (alternatingGroup (Fin n)) ≤
        normalizer (Q.subgroupOf (alternatingGroup (Fin n)) : Set (alternatingGroup (Fin n))) := by
      intro x hx
      apply mem_normalizer_iff.mpr
      intro y
      exact mem_normalizer_iff.mp (hPQ hx) y.val
    have hc := Nat.card_congr (subgroupOfEquivOfLe hPe).toEquiv
    exact (hc.symm ▸ h5).trans (card_dvd_of_le hN)
  let f := Equiv.Perm.sign.comp Q.subtype
  have hf : Function.Injective f := by
    apply (MonoidHom.ker_eq_bot_iff f).mp
    apply bot_unique
    intro x hx
    have hmem : (⟨x,Equiv.Perm.mem_alternatingGroup.mpr hx⟩ : alternatingGroup (Fin n)) ∈
        Q.subgroupOf (alternatingGroup (Fin n)) := x.property
    rw [he,mem_bot] at hmem
    exact Subtype.ext (congrArg (fun a : alternatingGroup (Fin n) => (a : Equiv.Perm (Fin n))) hmem)
  have hl := Nat.card_le_card_of_injective f hf
  have hgt : 1 < Nat.card Q := Finite.one_lt_card_iff_nontrivial.mpr
    ((nontrivial_iff_ne_bot Q).mpr hne)
  have hu : Nat.card (ℤˣ) = 2 := by simp [Nat.card_eq_fintype_card]
  rw [hu] at hl
  omega

private theorem swap_of_five {n : ℕ} (hn : n = 7 ∨ n = 8)
    (z : Equiv.Perm (Fin n)) (hz : z ^ 2 = 1) (hne : z ≠ 1)
    (h5 : 5 ∣ Nat.card (centralizer ({z} : Set (Equiv.Perm (Fin n))))) : z.IsSwap := by
  have ht := Equiv.Perm.cycleType_of_pow_prime_eq_one hz
  have hs := z.support.card_le_univ
  have hs' := z.sum_cycleType
  rw [ht,Multiset.sum_replicate] at hs'
  have hp : 0 < z.cycleType.card := by
    apply Nat.pos_of_ne_zero
    intro hh
    exact hne (Equiv.Perm.cycleType_eq_zero.mp (Multiset.card_eq_zero.mp hh))
  have hb : z.cycleType.card ≤ 4 := by
    simp only [Fintype.card_fin,nsmul_eq_mul,Nat.cast_id] at hs hs'
    omega
  have h1 : z.cycleType.card = 1 := by
    rw [Equiv.Perm.nat_card_centralizer,ht] at h5
    rcases hn with rfl | rfl <;>
      interval_cases hh : z.cycleType.card <;>
      first | rfl | norm_num [Nat.factorial] at h5
  apply Equiv.Perm.isSwap_iff_cycleType.mpr
  rw [ht,h1]
  rfl

private theorem five_normalizer_dvd {n : ℕ} (hn : n = 7 ∨ n = 8)
    (P : Subgroup (Equiv.Perm (Fin n))) (hP : Nat.card P = 5) :
    Nat.card (normalizer (P : Set (Equiv.Perm (Fin n)))) ∣ 20 * (n-5).factorial := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  let : IsCyclic P := isCyclic_of_prime_card hP
  obtain ⟨c,hc⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := P)
  have ho : orderOf (c : Equiv.Perm (Fin n)) = 5 := (orderOf_coe c).trans (hc.trans hP)
  have he : zpowers (c : Equiv.Perm (Fin n)) = P :=
    eq_of_le_of_card_ge (zpowers_le.mpr c.property) (by rw [Nat.card_zpowers,ho,hP])
  have hcent : centralizer (P : Set (Equiv.Perm (Fin n))) = centralizer ({(c : Equiv.Perm (Fin n))} : Set (Equiv.Perm (Fin n))) := by
    conv_lhs => rw [←he,zpowers_eq_closure,centralizer_closure]
  have hd := P.card_normalizer_dvd_card_centralizer_mul_card_mulAut
  rw [IsCyclic.card_mulAut,hP,hcent] at hd
  obtain ⟨k,hk⟩ := Equiv.Perm.cycleType_prime_order (σ := (c : Equiv.Perm (Fin n)))
    (ho ▸ (by decide : Nat.Prime 5))
  rw [ho] at hk
  have hb := (c : Equiv.Perm (Fin n)).support.card_le_univ
  rw [←Equiv.Perm.sum_cycleType,hk] at hb
  simp only [Multiset.sum_replicate,nsmul_eq_mul,Nat.cast_id,Fintype.card_fin] at hb
  have hk0 : k = 0 := by omega
  rw [hk0] at hk
  rw [Equiv.Perm.nat_card_centralizer,hk] at hd
  norm_num only [show Nat.totient 5 = 4 from rfl] at hd
  norm_num at hd
  convert hd using 1
  ring

/-- The cyclic-five quotient is preserved by a nontrivial alternating image:
the image of its two-core would have a quintic normalizer. -/
theorem range_card_five {E : Type*} [Group E] [Finite E]
    {n : ℕ} (hn : n = 7 ∨ n = 8)
    (f : E →* alternatingGroup (Fin n))
    (hc : Nat.card (E ⧸ pCore 2 E) = 5) (h5 : 5 ∣ Nat.card f.range) :
    Nat.card f.range = 5 := by
  have hQ : (pCore 2 E).map f = ⊥ := by
    by_contra hne
    apply even_normalizer_five_free hn _ (pCore_isPGroup.map f) hne
    have hN : f.range ≤ normalizer ((pCore 2 E).map f : Set (alternatingGroup (Fin n))) := by
      rintro _ ⟨x,rfl⟩
      apply (pCore 2 E).le_normalizer_map f
      exact mem_map_of_mem f (by rw [normalizer_eq_top]; trivial)
    exact h5.trans (card_dvd_of_le hN)
  let g := QuotientGroup.lift (pCore 2 E) f ((Subgroup.map_eq_bot_iff _).mp hQ)
  have hg : g.range = f.range := by
    ext x
    constructor
    · rintro ⟨y,rfl⟩
      obtain ⟨a,rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 E) y
      exact ⟨a,rfl⟩
    · rintro ⟨a,rfl⟩
      exact ⟨QuotientGroup.mk' (pCore 2 E) a,rfl⟩
  have hd := card_dvd_of_surjective g.rangeRestrict g.rangeRestrict_surjective
  rw [hg,hc] at hd
  exact Nat.dvd_antisymm hd h5

/-- A nontrivial two-subgroup and a five-subgroup cannot mutually normalize
in this direction, with the full even normalizer retained. -/
theorem no_mutual_normalizer {n : ℕ} (hn : n = 7 ∨ n = 8)
    (Q P : Subgroup (Equiv.Perm (Fin n))) (hQ : IsPGroup 2 Q) (hne : Q ≠ ⊥)
    (hP : Nat.card P = 5) (hPe : P ≤ alternatingGroup (Fin n))
    (hPQ : P ≤ normalizer (Q : Set (Equiv.Perm (Fin n))))
    (hN : alternatingGroup (Fin n) ⊓ normalizer (Q : Set (Equiv.Perm (Fin n))) ≤ normalizer (P : Set (Equiv.Perm (Fin n)))) :
    False := by
  have hc := radical_card_two hn Q P hQ hne hPe hPQ (hP ▸ dvd_rfl)
  obtain ⟨z,hz,hunique⟩ := (Nat.card_eq_two_iff' (1 : Q)).mp hc
  have hz0 : (z : Equiv.Perm (Fin n)) ≠ 1 := fun hh => hz (Subtype.ext hh)
  have hz2 : (z : Equiv.Perm (Fin n)) ^ 2 = 1 := by
    have hh : z ^ Nat.card Q = 1 := pow_card_eq_one'
    rw [hc] at hh
    exact congrArg Subtype.val hh
  have hNC : normalizer (Q : Set (Equiv.Perm (Fin n))) = centralizer ({(z : Equiv.Perm (Fin n))} : Set (Equiv.Perm (Fin n))) := by
    apply le_antisymm
    · exact (normalizer_le_centralizer_of_card_two Q hc).trans
        (centralizer_le (Set.singleton_subset_iff.mpr z.property))
    · intro g hg
      apply centralizer_le_normalizer (Q : Set (Equiv.Perm (Fin n)))
      apply mem_centralizer_iff.mpr
      intro x hx
      by_cases h1 : x = 1
      · simp [h1]
      have he : x = z := congrArg Subtype.val
        (hunique ⟨x,hx⟩ (fun hh => h1 (congrArg Subtype.val hh)))
      exact he ▸ (mem_centralizer_singleton_iff.mp hg).symm
  have hswap := swap_of_five hn z hz2 hz0
    ((show 5 ∣ Nat.card P by rw [hP]).trans (card_dvd_of_le (hPQ.trans hNC.le)))
  let N := normalizer (Q : Set (Equiv.Perm (Fin n)))
  let A := alternatingGroup (Fin n)
  have hcard : Nat.card N = 2 * (n-2).factorial := by
    dsimp only [N]
    rw [hNC,Equiv.Perm.nat_card_centralizer,Equiv.Perm.isSwap_iff_cycleType.mp hswap]
    simp [mul_comm]
  have hd : Nat.card (A.subgroupOf N) ∣ Nat.card (normalizer (P : Set (Equiv.Perm (Fin n)))) := by
    rw [←inf_subgroupOf_right A N]
    rw [Nat.card_congr (subgroupOfEquivOfLe (show A ⊓ N ≤ N from inf_le_right)).toEquiv]
    exact card_dvd_of_le hN
  let : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.mpr (by omega)
  have hi : (A.subgroupOf N).index ∣ 2 := by
    have := relIndex_dvd_index_of_normal (H := A) (K := N)
    have : A.index = 2 := alternatingGroup.index_eq_two
    exact this ▸ relIndex_dvd_index_of_normal A N
  have hdiv := Nat.mul_dvd_mul hd hi
  rw [(A.subgroupOf N).card_mul_index,hcard] at hdiv
  have hh := hdiv.trans (Nat.mul_dvd_mul (five_normalizer_dvd hn P hP) (dvd_rfl : 2 ∣ 2))
  rcases hn with rfl | rfl <;> norm_num [Nat.factorial] at hh

end Theory.SpecificGroups.QuinticPermutation
