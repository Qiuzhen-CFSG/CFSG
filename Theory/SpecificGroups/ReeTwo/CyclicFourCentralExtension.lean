module

public import Theory.SpecificGroups.ReeTwo.CoreMarkedCenter
public import Mathlib.Data.Fintype.Prod
public import Mathlib.Algebra.Group.MinimalAxioms

/-!
# Marked cyclic-four extensions of the Ree core

For an automorphism `beta` with fourth power one, the collected coordinates are
`Core × Fin 4`. Their multiplication acts on the second core coordinate by
`beta` and inserts the central mark when the actor exponents carry past four.
The mark is one for `epsilon = false` and the last root for `epsilon = true`.
Associativity follows from the fixed central mark and the carry identity;
the proof checks the 64 triples of actor coordinates, leaving the core arbitrary.

Every element is a core element followed by a power of the actor. Evaluation of
these words gives the universal homomorphism. If the target is generated by the
specified images and has order 4096, surjectivity and equality of orders give a
marked multiplicative equivalence. In particular, the usual additional
hypotheses that the core embedding is injective and has normal range need not
be assumed in this recognition theorem.

Source: the core coordinates and marked center derive from Shinoda (1975),
(2.3), pp.81–82, through `CoreMarkedCenter`. The extension construction is the
standard cyclic carry cocycle, proved directly here.
-/

@[expose] public section
namespace ReeTwo.CyclicFourCentralExtension

/-- The central value of the actor’s fourth power. -/
def mark (epsilon : Bool) : Core := if epsilon then Core.root 9 else 1

theorem mark_sq (epsilon : Bool) : mark epsilon * mark epsilon = 1 := by
  cases epsilon <;> decide +kernel

theorem mark_comm (epsilon : Bool) (x : Core) : mark epsilon * x = x * mark epsilon := by
  cases epsilon
  · simp [mark]
  · exact (Subgroup.mem_center_iff.mp Core.root_nine_mem_center x).symm

private theorem mark_mid (epsilon : Bool) (x y : Core) :
    mark epsilon * (x * y) = x * (mark epsilon * y) := by
  rw [← mul_assoc, mark_comm, mul_assoc]

theorem aut_mark (beta : MulAut Core) (epsilon : Bool) : beta (mark epsilon) = mark epsilon := by
  cases epsilon
  · exact map_one beta
  · exact Core.aut_root_nine beta

/-- Collected core and actor coordinates of the marked extension. -/
@[ext] structure Model (beta : MulAut Core) (hbeta : beta ^ 4 = 1) (epsilon : Bool) where
  core : Core
  idx : Fin 4

variable {beta : MulAut Core} {hbeta : beta ^ 4 = 1} {epsilon : Bool}

/-- Executable multiplication with the central carry term. -/
def coordinateMul (x y : Model beta hbeta epsilon) : Model beta hbeta epsilon :=
  ⟨x.core * (beta ^ x.idx.val) y.core * mark epsilon ^ ((x.idx.val + y.idx.val) / 4),
    ⟨(x.idx.val + y.idx.val) % 4, Nat.mod_lt _ (by decide)⟩⟩

def coordinateOne : Model beta hbeta epsilon := ⟨1, 0⟩

/-- Executable inversion in collected coordinates. -/
def coordinateInv (x : Model beta hbeta epsilon) : Model beta hbeta epsilon :=
  ⟨(beta ^ ((4 - x.idx.val) % 4)) x.core⁻¹ * mark epsilon ^ (if x.idx.val = 0 then 0 else 1),
    ⟨(4 - x.idx.val) % 4, Nat.mod_lt _ (by decide)⟩⟩

private theorem action_four (hbeta : beta ^ 4 = 1) (x : Core) : beta (beta (beta (beta x))) = x := by
  have h := DFunLike.congr_fun hbeta x
  simpa [pow_succ, MulAut.mul_apply] using h

set_option maxHeartbeats 2000000 in
private theorem assoc (x y z : Model beta hbeta epsilon) :
    coordinateMul (coordinateMul x y) z = coordinateMul x (coordinateMul y z) := by
  obtain ⟨x, i⟩ := x
  obtain ⟨y, j⟩ := y
  obtain ⟨z, k⟩ := z
  fin_cases i <;> fin_cases j <;> fin_cases k <;>
    apply Model.ext <;>
    simp [coordinateMul, pow_succ, MulAut.mul_apply, map_mul, aut_mark, mul_assoc,
      action_four (hbeta := hbeta), mark_mid, mark_sq] <;> exact mark_comm _ _

private theorem one_mul_aux (x : Model beta hbeta epsilon) : coordinateMul coordinateOne x = x := by
  obtain ⟨x, i⟩ := x
  fin_cases i <;> apply Model.ext <;> simp [coordinateMul, coordinateOne]

private theorem inv_mul (x : Model beta hbeta epsilon) :
    coordinateMul (coordinateInv x) x = coordinateOne := by
  obtain ⟨x, i⟩ := x
  fin_cases i <;> apply Model.ext <;>
    simp [coordinateMul, coordinateInv, coordinateOne, pow_succ, MulAut.mul_apply,
      mul_assoc, mark_mid, mark_sq]

instance instMul : Mul (Model beta hbeta epsilon) := ⟨coordinateMul⟩
instance instOne : One (Model beta hbeta epsilon) := ⟨coordinateOne⟩
instance instInv : Inv (Model beta hbeta epsilon) := ⟨coordinateInv⟩

instance instGroup : Group (Model beta hbeta epsilon) :=
  Group.ofLeftAxioms (by exact assoc) (by exact one_mul_aux) (by exact inv_mul)

theorem mul_def (x y : Model beta hbeta epsilon) : x * y = coordinateMul x y := rfl
theorem coordinateMul_eq_mul (x y : Model beta hbeta epsilon) :
    coordinateMul x y = x * y := rfl

theorem one_def : (1 : Model beta hbeta epsilon) = ⟨1, 0⟩ := rfl

/-- The computational coordinate equivalence. -/
def coordinates : Model beta hbeta epsilon ≃ Core × Fin 4 where
  toFun x := (x.core, x.idx)
  invFun x := ⟨x.1, x.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

instance instDecidableEq : DecidableEq (Model beta hbeta epsilon) := fun x y =>
  decidable_of_iff (coordinates x = coordinates y) coordinates.injective.eq_iff

instance instFintype : Fintype (Model beta hbeta epsilon) := Fintype.ofEquiv _ coordinates.symm

/-- Both choices of the marked relation have order 4096. -/
theorem card : Nat.card (Model beta hbeta epsilon) = 4096 := by
  rw [Nat.card_congr coordinates, Nat.card_prod, Core.card]
  simp

/-- The distinguished embedding of the entire core. -/
def embed : Core →* Model beta hbeta epsilon where
  toFun x := ⟨x, 0⟩
  map_one' := rfl
  map_mul' x y := by
    apply Model.ext <;> simp [mul_def, coordinateMul]

@[simp] theorem embed_apply (q : Core) : (embed q : Model beta hbeta epsilon) = ⟨q, 0⟩ := rfl

theorem embed_injective :
    Function.Injective (embed (beta := beta) (hbeta := hbeta) (epsilon := epsilon)) :=
  fun _ _ h => congrArg Model.core h

/-- The distinguished actor, with second coordinate one. -/
def actor : Model beta hbeta epsilon := ⟨1, 1⟩

theorem actor_pow (i : Fin 4) : (actor : Model beta hbeta epsilon) ^ i.val = ⟨1, i⟩ := by
  fin_cases i <;> apply Model.ext <;>
    simp [actor, pow_succ, mul_def, coordinateMul, one_def]

/-- Every element is a core element followed by an actor power below four. -/
theorem normal_form (x : Model beta hbeta epsilon) : embed x.core * actor ^ x.idx.val = x := by
  rw [actor_pow]
  obtain ⟨x, i⟩ := x
  fin_cases i <;> apply Model.ext <;> simp [mul_def, coordinateMul]

/-- The Boolean parameter records the actor’s fourth power. -/
theorem actor_four : (actor : Model beta hbeta epsilon) ^ 4 = embed (mark epsilon) := by
  apply Model.ext <;>
    simp [actor, pow_succ, mul_def, coordinateMul, one_def]

theorem actor_four_false : (actor : Model beta hbeta false) ^ 4 = 1 := by
  simpa [mark, one_def] using (actor_four (beta := beta) (hbeta := hbeta) (epsilon := false))

theorem actor_four_true : (actor : Model beta hbeta true) ^ 4 = embed (Core.root 9) :=
  actor_four

theorem actor_four_true_ne_one : (actor : Model beta hbeta true) ^ 4 ≠ 1 := by
  rw [actor_four_true, ← map_one (embed (beta := beta) (hbeta := hbeta) (epsilon := true))]
  exact fun h => (by decide +kernel : Core.root 9 ≠ 1) (embed_injective h)

theorem actor_conj (q : Core) :
    (actor : Model beta hbeta epsilon) * embed q * actor⁻¹ = embed (beta q) := by
  apply (mul_inv_eq_iff_eq_mul).mpr
  apply Model.ext <;> simp [actor, mul_def, coordinateMul]

theorem generate : (embed (beta := beta) (hbeta := hbeta) (epsilon := epsilon)).range ⊔
    Subgroup.zpowers actor = ⊤ := by
  apply top_unique
  intro x _
  rw [← normal_form x]
  apply Subgroup.mul_mem
  · exact (show embed.range ≤ embed.range ⊔ Subgroup.zpowers actor from le_sup_left)
      (show embed x.core ∈ embed.range from ⟨_, rfl⟩)
  · exact (show Subgroup.zpowers actor ≤ embed.range ⊔ Subgroup.zpowers actor from le_sup_right)
      (Subgroup.npow_mem_zpowers actor _)

theorem conj_embed (x : Model beta hbeta epsilon) (q : Core) :
    x * embed q * x⁻¹ = embed (x.core * (beta ^ x.idx.val) q * x.core⁻¹) := by
  apply mul_inv_eq_iff_eq_mul.mpr
  obtain ⟨x, i⟩ := x
  fin_cases i <;> apply Model.ext <;> simp [mul_def, coordinateMul, mul_assoc]

instance embed_range_normal :
    (embed (beta := beta) (hbeta := hbeta) (epsilon := epsilon)).range.Normal where
  conj_mem q hq x := by
    obtain ⟨q, rfl⟩ := hq
    rw [conj_embed]
    exact ⟨_, rfl⟩

/-- Maps from the model are determined by the core and the actor. -/
@[ext] theorem hom_ext {H : Type*} [Group H] {f g : Model beta hbeta epsilon →* H}
    (hcore : ∀ q, f (embed q) = g (embed q)) (hactor : f actor = g actor) : f = g := by
  apply MonoidHom.ext
  intro x
  rw [← normal_form x, map_mul, map_mul, map_pow, map_pow, hcore, hactor]

section Universal
variable {H : Type*} [Group H] (j : Core →* H) (s : H)
variable (hconj : ∀ q, s * j q * s⁻¹ = j (beta q)) (hfour : s ^ 4 = j (mark epsilon))

include hconj in
private theorem cross (q : Core) : s * j q = j (beta q) * s :=
  mul_inv_eq_iff_eq_mul.mp (hconj q)

include hconj in
private theorem cross_pow (n : ℕ) (q : Core) :
    s ^ n * j q = j ((beta ^ n) q) * s ^ n := by
  induction n generalizing q with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, pow_succ, MulAut.mul_apply, mul_assoc, cross j s hconj,
      ← mul_assoc, ih, mul_assoc]

include hfour in
private theorem carry_pow (n : ℕ) :
    j (mark epsilon) ^ (n / 4) * s ^ (n % 4) = s ^ n := by
  rw [← hfour, ← pow_mul, ← pow_add, Nat.div_add_mod]

/-- Evaluate collected words in any group satisfying the marked relations. -/
def lift : Model beta hbeta epsilon →* H where
  toFun x := j x.core * s ^ x.idx.val
  map_one' := by simp [one_def]
  map_mul' x y := by
    change j (x.core * (beta ^ x.idx.val) y.core * mark epsilon ^ ((x.idx.val + y.idx.val) / 4)) *
      s ^ ((x.idx.val + y.idx.val) % 4) =
      (j x.core * s ^ x.idx.val) * (j y.core * s ^ y.idx.val)
    rw [map_mul, map_mul, map_pow, mul_assoc, mul_assoc, carry_pow j s hfour,
      pow_add, ← mul_assoc (j ((beta ^ x.idx.val) y.core)), ← cross_pow j s hconj]
    simp only [mul_assoc]

@[simp] theorem lift_apply (x : Model beta hbeta epsilon) :
    lift j s hconj hfour x = j x.core * s ^ x.idx.val := rfl

@[simp] theorem lift_embed (q : Core) :
    lift j s hconj hfour (embed q : Model beta hbeta epsilon) = j q := by
  change j q * s ^ 0 = j q
  simp

@[simp] theorem lift_actor : lift j s hconj hfour (actor : Model beta hbeta epsilon) = s := by
  change j 1 * s ^ 1 = s
  simp

theorem lift_surjective (hgen : j.range ⊔ Subgroup.zpowers s = ⊤) :
    Function.Surjective (lift (hbeta := hbeta) j s hconj hfour) := by
  apply MonoidHom.range_eq_top.mp
  apply top_unique
  rw [← hgen]
  apply sup_le
  · rintro _ ⟨q, rfl⟩
    exact ⟨embed q, lift_embed j s hconj hfour q⟩
  · apply Subgroup.zpowers_le.mpr
    exact ⟨actor, lift_actor j s hconj hfour⟩

/-- A generated target of order 4096 has exactly the collected normal forms. -/
noncomputable def equiv [Finite H] (hcard : Nat.card H = 4096)
    (hgen : j.range ⊔ Subgroup.zpowers s = ⊤) : Model beta hbeta epsilon ≃* H :=
  MulEquiv.ofBijective (lift j s hconj hfour)
    ((lift_surjective j s hconj hfour hgen).bijective_of_nat_card_le (by rw [card, hcard]))

@[simp] theorem equiv_embed [Finite H] (hcard : Nat.card H = 4096)
    (hgen : j.range ⊔ Subgroup.zpowers s = ⊤) (q : Core) :
    equiv j s hconj hfour hcard hgen (embed q : Model beta hbeta epsilon) = j q :=
  lift_embed j s hconj hfour q

@[simp] theorem equiv_actor [Finite H] (hcard : Nat.card H = 4096)
    (hgen : j.range ⊔ Subgroup.zpowers s = ⊤) :
    equiv j s hconj hfour hcard hgen (actor : Model beta hbeta epsilon) = s :=
  lift_actor j s hconj hfour

@[simp] theorem equiv_root_nine [Finite H] (hcard : Nat.card H = 4096)
    (hgen : j.range ⊔ Subgroup.zpowers s = ⊤) :
    equiv j s hconj hfour hcard hgen (embed (Core.root 9) : Model beta hbeta epsilon) =
      j (Core.root 9) :=
  equiv_embed j s hconj hfour hcard hgen _

end Universal
end ReeTwo.CyclicFourCentralExtension
