module

public import Theory.SpecificGroups.ReeTwo.CoreFrame
public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Removing central errors from a cyclic-extension Ree frame

For an elementary derived layer D, commutation with an element of D is
multiplicative whenever [D,K] is central. A dual family of four tail roots
therefore realizes every binary central functional. Multiplying each upper
root by a triangular product of these tail roots corrects its square and
its commutators with the earlier upper roots independently. Such corrections
preserve the forced tails and all sixteen pairings.

The main theorem lifts a frame in a quotient with kernel generated by the
central involution, provided the actual antidiagonal pairing is known. It
constructs exact elements and all the equations of `FrameCoordinates`.
Existence of the quotient frame and its pairing from an order-five action
is a separate mathematical obligation, not asserted in this module.

The target table and right-commutator convention are Shinoda (1975),
(2.3), pp.81–82. The cyclic-extension application comes from Thompson VI,
pp.629–630 and the residual structure in Parrott (1972), pp.672–674.
The triangular correction below is an explicit algebraic lifting argument.
-/

open scoped commutatorElement IsMulCommutative
namespace ReeTwo
variable {K : Type*} [Group K]

private theorem rightComm_mem_derived (x y : K) : rightComm x y ∈ commutator K := by
  simpa [rightComm, commutatorElement_def, commutator] using
    (Subgroup.commutator_mem_commutator (Subgroup.mem_top x⁻¹) (Subgroup.mem_top y⁻¹))

private theorem rightComm_inv (x y : K) : (rightComm x y)⁻¹ = rightComm y x := by
  simp [rightComm, mul_assoc]

private theorem rightComm_one_of_commute {x y : K} (h : Commute x y) : rightComm x y = 1 := by
  simpa [rightComm, commutatorElement_def] using h.inv_inv.commutator_eq

private theorem rightComm_mul_left (x y w : K) :
    rightComm (x*y) w = y⁻¹ * rightComm x w * y * rightComm y w := by
  simp [rightComm, mul_assoc]

private theorem rightComm_mul_right (x y w : K) :
    rightComm x (y*w) = rightComm x w * (w⁻¹ * rightComm x y * w) := by
  simp [rightComm, mul_assoc]

private theorem rightComm_mul_right_central (x y w : K)
    (h : rightComm x y ∈ Subgroup.center K) :
    rightComm x (y*w) = rightComm x y * rightComm x w := by
  rw [rightComm_mul_right]
  have hc := Subgroup.mem_center_iff.mp h
  rw [hc w⁻¹]
  simpa only [mul_assoc, inv_mul_cancel, mul_one] using hc (rightComm x w)

private def centralRightCommHom (D : Subgroup K)
    (hcentral : ∀ (x : K) (d : D), rightComm x d ∈ Subgroup.center K)
    (x : K) : D →* Subgroup.center K where
  toFun d := ⟨rightComm x d, hcentral x d⟩
  map_one' := Subtype.ext (by simp [rightComm])
  map_mul' d e := Subtype.ext (rightComm_mul_right_central x d e (hcentral x d))

private theorem exists_pairing_correction {I : Type*} [Fintype I] [DecidableEq I]
    (D : Subgroup K) [IsElementaryAbelian 2 D]
    (hcentral : ∀ (x : K) (d : D), rightComm x d ∈ Subgroup.center K)
    (a : I → K) (d : I → D) (z : K)
    (hpair : ∀ i j, rightComm (a i) (d j) = if i = j then z else 1)
    (f : I → K) (hf : ∀ i, f i = 1 ∨ f i = z) :
    ∃ e : D, ∀ i, rightComm (a i) e = f i := by
  classical
  let u : I → D := fun j => if f j = 1 then 1 else d j
  refine ⟨∏ j, u j, ?_⟩
  intro i
  have hfactor (j : I) :
      centralRightCommHom D hcentral (a i) (u j) =
        if i = j then ⟨f i, by
          rcases hf i with h | h
          · rw [h]; exact (Subgroup.center K).one_mem
          · have hh := hcentral (a i) (d i)
            simpa only [h, hpair, if_true] using hh⟩ else 1 := by
    apply Subtype.ext
    by_cases hij : i = j
    · subst j
      rcases hf i with h | h
      · simp [u, h, centralRightCommHom, rightComm]
      · by_cases hz : z = 1
        · simp [u, h, hz, centralRightCommHom, rightComm]
        · simpa [u, h, hz, centralRightCommHom] using hpair i i
    · simp only [if_neg hij]
      by_cases hfj : f j = 1
      · simp [u, hfj, centralRightCommHom, rightComm]
      · simpa [u, hfj, hij, centralRightCommHom] using hpair i j
  have he := map_prod (centralRightCommHom D hcentral (a i)) u Finset.univ
  simp only [hfactor] at he
  have he' := congrArg (fun c : Subgroup.center K => (c : K)) he
  simp only [Finset.prod_ite_eq, Finset.mem_univ, if_true] at he'
  change rightComm (a i) (∏ j, u j : D) = f i at he'
  exact he'

private theorem derived_inv (D : Subgroup K) [IsElementaryAbelian 2 D]
    {d : K} (hd : d ∈ D) : d⁻¹ = d := by
  exact inv_eq_of_mul_eq_one_right (by
    simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) d hd)

private theorem derived_commute (D : Subgroup K) [IsElementaryAbelian 2 D]
    {d e : K} (hd : d ∈ D) (he : e ∈ D) : Commute d e := by
  exact congrArg Subtype.val (mul_comm (⟨d, hd⟩ : D) ⟨e, he⟩)

private theorem rightComm_mul_left_derived (D : Subgroup K) [IsElementaryAbelian 2 D]
    (hD : commutator K ≤ D) (x y : K) (d : D) :
    rightComm (x*d) y = rightComm x y * rightComm (d : K) y := by
  rw [rightComm_mul_left, (derived_commute D d.property (hD (rightComm_mem_derived x y))).inv_left.eq,
    inv_mul_cancel_right]

private theorem rightComm_mul_right_derived (D : Subgroup K) [IsElementaryAbelian 2 D]
    (hD : commutator K ≤ D) (x y : K) (e : D) :
    rightComm x (y*e) = rightComm x e * rightComm x y := by
  rw [rightComm_mul_right, (derived_commute D e.property (hD (rightComm_mem_derived x y))).inv_left.eq,
    inv_mul_cancel_right]

private theorem rightComm_twist (D : Subgroup K) [IsElementaryAbelian 2 D]
    (hD : commutator K ≤ D) (x y : K) (d e : D) :
    rightComm (x*d) (y*e) = rightComm x y * rightComm x e * rightComm y d := by
  rw [rightComm_mul_right_derived D hD, rightComm_mul_left_derived D hD,
    rightComm_mul_left_derived D hD, rightComm_one_of_commute (derived_commute D d.property e.property),
    mul_one, ← rightComm_inv y (d : K), derived_inv D (hD (rightComm_mem_derived y d))]
  rw [← mul_assoc, (derived_commute D (hD (rightComm_mem_derived x e)) (hD (rightComm_mem_derived x y))).eq]

private theorem square_twist (D : Subgroup K) [IsElementaryAbelian 2 D]
    (x : K) (d : D) : (x*d)*(x*d) = x*x*rightComm x d := by
  simp only [rightComm, derived_inv D d.property, mul_assoc, mul_inv_cancel_left]

private theorem exists_corrected_lifts {n : ℕ}
    (D : Subgroup K) [IsElementaryAbelian 2 D]
    (hD : commutator K ≤ D)
    (hcentral : ∀ (x : K) (d : D), rightComm x d ∈ Subgroup.center K)
    (a : Fin n → K) (d : Fin n → D) (z : K) (hz : z*z = 1)
    (hpair : ∀ i j, rightComm (a i) (d j) = if i = j then z else 1)
    (s : Fin n → K) (c : Fin n → Fin n → K)
    (hs : ∀ i, ∃ u, (u = 1 ∨ u = z) ∧ a i * a i = s i * u)
    (hc : ∀ i j, i < j → ∃ v, (v = 1 ∨ v = z) ∧ rightComm (a i) (a j) = c i j * v) :
    ∃ e : Fin n → D,
      (∀ i, (a i * e i) * (a i * e i) = s i) ∧
      (∀ i j, i < j → rightComm (a i * e i) (a j * e j) = c i j) := by
  classical
  choose u hu hsu using hs
  have hcv : ∀ i j, ∃ v, (v = 1 ∨ v = z) ∧
      (i < j → rightComm (a i) (a j) = c i j * v) := by
    intro i j
    by_cases hij : i < j
    · obtain ⟨v, hv, he⟩ := hc i j hij
      exact ⟨v, hv, fun _ => he⟩
    · exact ⟨1, Or.inl rfl, fun h => (hij h).elim⟩
  choose v hv hcv using hcv
  let f : Fin n → Fin n → K := fun i j => if j = i then u i else if j < i then v j i else 1
  have hf (i j) : f i j = 1 ∨ f i j = z := by
    dsimp only [f]
    split_ifs
    · exact hu i
    · exact hv j i
    · exact Or.inl rfl
  choose e he using fun i => exists_pairing_correction D hcentral a d z hpair (f i) (hf i)
  have hpow {w : K} (hw : w = 1 ∨ w = z) : w*w = 1 := by
    rcases hw with rfl | rfl
    · exact one_mul _
    · exact hz
  refine ⟨e, ?_, ?_⟩
  · intro i
    rw [square_twist D, he, show f i i = u i by simp [f], hsu, mul_assoc, hpow (hu i), mul_one]
  · intro i j hij
    rw [rightComm_twist D hD, he, he]
    have hijne : i ≠ j := ne_of_lt hij
    have hji : ¬ j < i := not_lt_of_ge hij.le
    simp only [f, if_neg hijne, if_neg hijne.symm, if_pos hij, if_neg hji,
      hcv i j hij, mul_one]
    rw [mul_assoc, hpow (hv i j), mul_one]

private theorem tail_mem (D : Subgroup K) (hD : commutator K ≤ D)
    (a : Fin 4 → K) (t : K) (i : Fin 4) : frameTail a t i ∈ D := by
  fin_cases i <;> exact hD (rightComm_mem_derived _ _)

private theorem frameTail_mul_derived (D : Subgroup K) [IsElementaryAbelian 2 D]
    (hD : commutator K ≤ D) (a : Fin 4 → K) (t : K)
    (htD : t ∈ Subgroup.centralizer (D : Set K)) (e : Fin 4 → D) :
    frameTail (fun i => a i * e i) t = frameTail a t := by
  have hc (d : D) : Commute t (d : K) := (Subgroup.mem_centralizer_iff.mp htD d d.property).symm
  funext i
  fin_cases i <;> simp [frameTail, rightComm_mul_left_derived D hD, rightComm_mul_right_derived D hD,
    rightComm_one_of_commute (hc _), rightComm_one_of_commute (hc _).symm]

variable {Q : Type*} [Finite K] [Group Q]

private theorem defect_of_eq_image (q : K →* Q) (z : K) (hz : orderOf z = 2)
    (hker : q.ker = Subgroup.zpowers z) {x y : K} (h : q x = q y) :
    ∃ u, (u = 1 ∨ u = z) ∧ x = y*u := by
  classical
  have hu : y⁻¹*x ∈ Subgroup.zpowers z := by
    rw [← hker, MonoidHom.mem_ker, map_mul, map_inv, h, inv_mul_cancel]
  have hcase : y⁻¹*x = 1 ∨ y⁻¹*x = z := by
    rw [mem_zpowers_iff_mem_range_orderOf, hz] at hu
    obtain ⟨n, hn, he⟩ := Finset.mem_image.mp hu
    have hnlt : n < 2 := Finset.mem_range.mp hn
    have hncase : n = 0 ∨ n = 1 := by omega
    rcases hncase with rfl | rfl
    · exact Or.inl (by simpa using he.symm)
    · exact Or.inr (by simpa using he.symm)
  exact ⟨y⁻¹*x, hcase, by group⟩

omit [Finite K] in
private theorem map_frameTail (q : K →* Q) (a : Fin 4 → K) (t : K) (i : Fin 4) :
    q (frameTail a t i) = frameTail (q ∘ a) (q t) i := by
  fin_cases i <;> simp [frameTail, rightComm, map_mul, map_inv]

/-- Central errors in a Ree frame can all be removed by derived-layer corrections.
The quotient coordinates and the nondegenerate pairing must first be constructed;
this theorem only lifts them to exact equations in the original group. -/
public theorem exists_frameCoordinates_of_quotient
    (D : Subgroup K) [IsElementaryAbelian 2 D]
    (hD : commutator K ≤ D)
    (hcentral : ⁅D, (⊤ : Subgroup K)⁆ ≤ Subgroup.center K)
    (q : K →* Q) (a : Fin 4 → K) (t z : K)
    (htD : t ∈ Subgroup.centralizer (D : Set K))
    (hz : orderOf z = 2) (hker : q.ker = Subgroup.zpowers z)
    (hquot : FrameCoordinates (q ∘ a) (q t) (q z))
    (hpair : ∀ i j, rightComm (a i) (frameTail a t j) =
      if i.val + j.val = 3 then z else 1) :
    ∃ a' : Fin 4 → K, FrameCoordinates a' t z ∧ frameTail a' t = frameTail a t := by
  classical
  have hcentral' (x : K) (d : D) : rightComm x d ∈ Subgroup.center K := by
    apply hcentral
    rw [Subgroup.commutator_comm]
    simpa [rightComm, commutatorElement_def] using
      Subgroup.commutator_mem_commutator (Subgroup.mem_top x⁻¹) (D.inv_mem d.property)
  let d : Fin 4 → D := fun j => ⟨frameTail a t j.rev, tail_mem D hD a t j.rev⟩
  have hdual (i j : Fin 4) : rightComm (a i) (d j) = if i = j then z else 1 := by
    change rightComm (a i) (frameTail a t j.rev) = _
    rw [hpair]
    have hij : i.val + j.rev.val = 3 ↔ i = j := by
      simp only [Fin.val_rev, Fin.ext_iff]
      omega
    simp only [hij]
  let s : Fin 4 → K := ![1, frameTail a t 0, frameTail a t 3, 1]
  let c : Fin 4 → Fin 4 → K := fun i j =>
    if i = 0 ∧ j = 2 then frameTail a t 0 * frameTail a t 1 * z
    else if i = 0 ∧ j = 3 then frameTail a t 1 * frameTail a t 2
    else if i = 1 ∧ j = 3 then frameTail a t 2 * frameTail a t 3 * z
    else 1
  have hs (i : Fin 4) : ∃ u, (u = 1 ∨ u = z) ∧ a i * a i = s i * u := by
    apply defect_of_eq_image q z hz hker
    rw [map_mul]
    have hh := hquot.square i
    fin_cases i <;> simpa [s, map_frameTail, Function.comp_apply] using hh
  have hc (i j : Fin 4) (hij : i < j) :
      ∃ v, (v = 1 ∨ v = z) ∧ rightComm (a i) (a j) = c i j * v := by
    apply defect_of_eq_image q z hz hker
    have hm (x y : K) : q (rightComm x y) = rightComm (q x) (q y) := by
      simp [rightComm]
    rw [hm]
    fin_cases i <;> fin_cases j <;> norm_num [Fin.lt_def] at hij
    · simpa [c, Function.comp_apply] using hquot.comm01
    · simpa [c, map_frameTail, Function.comp_apply] using hquot.comm02
    · simpa [c, map_frameTail, Function.comp_apply] using hquot.comm03
    · simpa [c, Function.comp_apply] using hquot.comm12
    · simpa [c, map_frameTail, Function.comp_apply] using hquot.comm13
    · simpa [c, Function.comp_apply] using hquot.comm23
  have hz2 : z*z = 1 := by simpa only [pow_two, hz] using pow_orderOf_eq_one z
  obtain ⟨e, heSquare, heComm⟩ := exists_corrected_lifts D hD hcentral' a d z hz2 hdual s c hs hc
  let a' : Fin 4 → K := fun i => a i * e i
  have ht : frameTail a' t = frameTail a t := frameTail_mul_derived D hD a t htD e
  refine ⟨a', ?_, ht⟩
  constructor
  · intro i
    rw [ht]
    exact heSquare i
  · simpa [c] using heComm 0 1 (by decide)
  · rw [ht]; simpa [c] using heComm 0 2 (by decide)
  · rw [ht]; simpa [c] using heComm 0 3 (by decide)
  · simpa [c] using heComm 1 2 (by decide)
  · rw [ht]; simpa [c] using heComm 1 3 (by decide)
  · simpa [c] using heComm 2 3 (by decide)
  · intro i j
    rw [ht]
    change rightComm (a i * e i) (frameTail a t j) = _
    rw [rightComm_mul_left_derived D hD,
      rightComm_one_of_commute (derived_commute D (e i).property (tail_mem D hD a t j)), mul_one, hpair]
end ReeTwo
