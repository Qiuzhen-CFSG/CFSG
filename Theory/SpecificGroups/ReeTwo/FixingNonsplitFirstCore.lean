module

public import Theory.SpecificGroups.ReeTwo.FixingModelReduction
public import Theory.SpecificGroups.ReeTwo.FixingModelNonsplitZero
public import Theory.SpecificGroups.ReeTwo.FixingModelNonsplitTwo

/-!
# First-core obstruction for nonsplit root-fixing Ree extensions

The mark is central in every extension generated by the core and one actor,
so it belongs to the centralizer of the second upper central term. The fixing
action census and marked model reduction reduce the requested fixed-point
property to the two nonsplit base models. In each base model, the mark has
768 fourth roots in the first core, whereas the other nonidentity central
elements have 256. These intrinsic counts force every automorphism to fix
the mark, and marked transport gives the arbitrary-extension obstruction.

Source: the verified Shinoda (1975), pp.81–83 coordinates, the cyclic carry
construction, and functoriality of the upper central series.
-/

namespace ReeTwo.FixingExtension

/-- The intrinsic first core of an extension. -/
@[expose] public def firstCore (H : Type*) [Group H] : Subgroup H :=
  Subgroup.centralizer (Subgroup.upperCentralSeries H 2 : Set H)

/-- The mark is central in any group generated by the core and an actor. -/
public theorem root_nine_mem_center {H : Type*} [Group H]
    (j : Core →* H) (s : H) (beta : MulAut Core)
    (hgen : j.range ⊔ Subgroup.zpowers s = ⊤)
    (hconj : ∀ q, s * j q * s⁻¹ = j (beta q)) :
    j (Core.root 9) ∈ Subgroup.center H := by
  have hc : j.range ⊔ Subgroup.zpowers s ≤
      Subgroup.centralizer ({j (Core.root 9)} : Set H) := by
    apply sup_le
    · rintro _ ⟨q, rfl⟩
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      simpa only [map_mul] using
        congrArg j (Subgroup.mem_center_iff.mp Core.root_nine_mem_center q)
    · apply Subgroup.zpowers_le.mpr
      apply Subgroup.mem_centralizer_singleton_iff.mpr
      have he := hconj (Core.root 9)
      rw [Core.aut_root_nine] at he
      have hm := congrArg (fun x => x * s) he
      simpa only [mul_assoc, inv_mul_cancel, mul_one] using hm
  rw [hgen] at hc
  apply Subgroup.mem_center_iff.mpr
  intro x
  exact Subgroup.mem_centralizer_singleton_iff.mp (hc (Subgroup.mem_top x))

/-- Membership holds for both action orbits and both fourth-power choices. -/
public theorem root_nine_mem_firstCore {H : Type*} [Group H]
    (j : Core →* H) (s : H) (beta : MulAut Core)
    (hgen : j.range ⊔ Subgroup.zpowers s = ⊤)
    (hconj : ∀ q, s * j q * s⁻¹ = j (beta q)) :
    j (Core.root 9) ∈ firstCore H :=
  Subgroup.center_le_centralizer _ (root_nine_mem_center j s beta hgen hconj)

/-- Transfer a fixed mark from any marked model of the whole extension. -/
public theorem root_nine_fixed_of_marked_equiv
    {H M : Type*} [Group H] [Group M]
    (j : Core →* H) (hz : j (Core.root 9) ∈ firstCore H)
    (e : H ≃* M) (z : firstCore M) (he : e (j (Core.root 9)) = z.val)
    (hfixed : ∀ b : MulAut (firstCore M), b z = z)
    (a : MulAut (firstCore H)) : a ⟨j (Core.root 9), hz⟩ = ⟨j (Core.root 9), hz⟩ := by
  let f : firstCore H ≃* firstCore M :=
    Subgroup.centralizerUpperCentralSeriesEquiv e 2
  let x : firstCore H := ⟨j (Core.root 9), hz⟩
  have hx : f x = z := Subtype.ext he
  apply f.injective
  have hf := hfixed (f.symm.trans (a.trans f))
  rw [← hx] at hf
  change f (a (f.symm (f x))) = f x at hf
  simpa only [f.symm_apply_apply] using hf

/-- Assemble the nonsplit obstruction from the two base-model certificates. -/
public theorem root_nine_firstCore_obstruction_of_base_certificates
    (hzero : ∀ a : MulAut (FixingModel.firstCore 0 true),
      a (FixingModel.centralInvolution 0 true) = FixingModel.centralInvolution 0 true)
    (htwo : ∀ a : MulAut (FixingModel.firstCore 2 true),
      a (FixingModel.centralInvolution 2 true) = FixingModel.centralInvolution 2 true)
    {H : Type*} [Group H] [Finite H]
    (hcard : Nat.card H = 4096) (j : Core →* H) (s : H) (beta : MulAut Core)
    (hgen : j.range ⊔ Subgroup.zpowers s = ⊤)
    (hbeta : beta ^ 4 = 1)
    (hc : beta * Core.c * beta⁻¹ = Core.c ^ 2)
    (hfix : beta (Core.root 2) = Core.root 2)
    (hconj : ∀ q, s * j q * s⁻¹ = j (beta q))
    (hfour : s ^ 4 = j (Core.root 9)) :
    ∃ hz : j (Core.root 9) ∈ firstCore H,
      ∀ a : MulAut (firstCore H),
        a ⟨j (Core.root 9), hz⟩ = ⟨j (Core.root 9), hz⟩ := by
  refine ⟨root_nine_mem_firstCore j s beta hgen hconj, ?_⟩
  intro a
  obtain ⟨i, rfl⟩ := Core.FixingActionCensus.exhaustive beta hbeta hc hfix
  have hε : s ^ 4 = j (CyclicFourCentralExtension.mark true) := hfour
  let e : FixingModel.Model i true ≃* H :=
    CyclicFourCentralExtension.equiv j s hconj hε hcard hgen
  apply root_nine_fixed_of_marked_equiv j _ e.symm
    (FixingModel.centralInvolution i true) ?_ ?_ a
  · apply e.injective
    rw [e.apply_symm_apply]
    exact (CyclicFourCentralExtension.equiv_root_nine j s hconj hε hcard hgen).symm
  · exact FixingModel.fixed_of_base_certificates hzero htwo i _

/-- Every automorphism of the intrinsic first core of a nonsplit root-fixing
extension fixes the embedded last root. -/
public theorem root_nine_firstCore_obstruction
    {H : Type*} [Group H] [Finite H]
    (hcard : Nat.card H = 4096) (j : Core →* H) (s : H) (beta : MulAut Core)
    (hgen : j.range ⊔ Subgroup.zpowers s = ⊤)
    (hbeta : beta ^ 4 = 1)
    (hc : beta * Core.c * beta⁻¹ = Core.c ^ 2)
    (hfix : beta (Core.root 2) = Core.root 2)
    (hconj : ∀ q, s * j q * s⁻¹ = j (beta q))
    (hfour : s ^ 4 = j (Core.root 9)) :
    ∃ hz : j (Core.root 9) ∈ firstCore H,
      ∀ a : MulAut (firstCore H),
        a ⟨j (Core.root 9), hz⟩ = ⟨j (Core.root 9), hz⟩ :=
  root_nine_firstCore_obstruction_of_base_certificates
    FixingModel.zero_true_fixed FixingModel.two_true_fixed
    hcard j s beta hgen hbeta hc hfix hconj hfour

end ReeTwo.FixingExtension
