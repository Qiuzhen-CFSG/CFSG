module

public import Theory.SpecificGroups.ReeTwo.RootAction
public import Theory.GroupTheory.SpecificGroups.FiveFour

/-!
# The specified Ree two complement

Shinoda's root-1 and Weyl actions (1975, pp. 81–83) generate the faithful
`C₅ : C₄` group. We identify that group through its specified generators,
using their exact orders and the relation `aca⁻¹ = c²`, where `c = a²r`.
The universal maps retain these generators. The final compatibility lemmas
use the inclusion action on the core and send the ambient root-1 generator
to the inverse of the four-element automorphism, as required for right
conjugation.
-/

@[expose] public section
namespace ReeTwo
namespace Core

/-- The specified faithful representation of the five-by-four complement. -/
def complementAction : FiveFour.Group →* MulAut Core :=
  FiveFour.lift c a c_five a_four a_conj_c

@[simp] theorem complementAction_a : complementAction FiveFour.a = a :=
  FiveFour.lift_a ..

@[simp] theorem complementAction_c : complementAction FiveFour.c = c :=
  FiveFour.lift_c ..

@[simp] theorem complementAction_r : complementAction FiveFour.r = r := by
  rw [FiveFour.r, map_mul, map_pow, complementAction_a, complementAction_c, c,
    ← _root_.mul_assoc, ← pow_add]
  norm_num only
  rw [a_four, _root_.one_mul]

theorem complementAction_injective : Function.Injective complementAction :=
  FiveFour.lift_injective c a c_five a_four a_conj_c orderOf_c orderOf_a

/-- The complement as an actual subgroup of the core automorphisms. -/
def complement : Subgroup (MulAut Core) := complementAction.range

/-- The image consists precisely of the automorphisms generated by the specified `a` and `r`. -/
theorem complement_eq_closure : complement = Subgroup.closure {a, r} := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    rw [← FiveFour.normal_form g, map_mul, map_pow, map_pow,
      complementAction_c, complementAction_a]
    have ha : a ∈ Subgroup.closure ({a, r} : Set (MulAut Core)) :=
      Subgroup.subset_closure (by simp)
    have hr : r ∈ Subgroup.closure ({a, r} : Set (MulAut Core)) :=
      Subgroup.subset_closure (by simp)
    exact Subgroup.mul_mem _ (Subgroup.pow_mem _ (Subgroup.mul_mem _
      (Subgroup.pow_mem _ ha 2) hr) _) (Subgroup.pow_mem _ ha _)
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases Set.mem_insert_iff.mp hg with rfl | hg
    · exact ⟨FiveFour.a, complementAction_a⟩
    · obtain rfl := Set.mem_singleton_iff.mp hg
      exact ⟨FiveFour.r, complementAction_r⟩

/-- Recognition by the faithful cyclic-five semidirect cyclic-four model. -/
noncomputable def complementEquiv : FiveFour.Group ≃* complement :=
  MonoidHom.ofInjective complementAction_injective

@[simp] theorem complementEquiv_coe (g : FiveFour.Group) :
    (complementEquiv g : MulAut Core) = complementAction g := rfl

theorem complement_card : Nat.card complement = 20 :=
  (Nat.card_congr complementEquiv.toEquiv.symm).trans FiveFour.card

instance : Finite complement := Finite.of_equiv FiveFour.Group complementEquiv.toEquiv

/-- The order-four generator, regarded as an element of the complement. -/
def complementA : complement := ⟨a, FiveFour.a, complementAction_a⟩

/-- The Weyl involution, regarded as an element of the complement. -/
def complementR : complement := ⟨r, FiveFour.r, complementAction_r⟩

@[simp] theorem complementEquiv_a : complementEquiv FiveFour.a = complementA :=
  Subtype.ext complementAction_a

@[simp] theorem complementEquiv_r : complementEquiv FiveFour.r = complementR :=
  Subtype.ext complementAction_r

/-- Every complement element is an ordered word in the specified generators. -/
theorem complement_normal_form (g : complement) :
    ∃ i : Fin 5, ∃ j : Fin 4, g = (complementA ^ 2 * complementR) ^ i.val *
      complementA ^ j.val := by
  obtain ⟨t, rfl⟩ := complementEquiv.surjective g
  refine ⟨⟨t.left.toAdd.val, ZMod.val_lt _⟩, ⟨t.right.toAdd.val, ZMod.val_lt _⟩, ?_⟩
  conv_lhs => rw [← FiveFour.normal_form t]
  rw [map_mul, map_pow, map_pow, FiveFour.c_eq, map_mul, map_pow,
    complementEquiv_a, complementEquiv_r]

/-- The universal map from the concrete complement, retaining the chosen generators. -/
noncomputable def complementLift {G : Type*} [Group G] (A R : G)
    (hc : (A ^ 2 * R) ^ 5 = 1) (ha : A ^ 4 = 1)
    (h : A * (A ^ 2 * R) * A⁻¹ = (A ^ 2 * R) ^ 2) : complement →* G :=
  (FiveFour.lift (A ^ 2 * R) A hc ha h).comp complementEquiv.symm.toMonoidHom

@[simp] theorem complementLift_a {G : Type*} [Group G] (A R : G)
    (hc : (A ^ 2 * R) ^ 5 = 1) (ha : A ^ 4 = 1)
    (h : A * (A ^ 2 * R) * A⁻¹ = (A ^ 2 * R) ^ 2) :
    complementLift A R hc ha h complementA = A := by
  rw [← complementEquiv_a]
  simp only [complementLift, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply, FiveFour.lift_a]

@[simp] theorem complementLift_r {G : Type*} [Group G] (A R : G)
    (hc : (A ^ 2 * R) ^ 5 = 1) (ha : A ^ 4 = 1)
    (h : A * (A ^ 2 * R) * A⁻¹ = (A ^ 2 * R) ^ 2) :
    complementLift A R hc ha h complementR = R := by
  rw [← complementEquiv_r]
  simp only [complementLift, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply, FiveFour.r, map_mul, map_pow, FiveFour.lift_a,
    FiveFour.lift_c, ← _root_.mul_assoc, ← pow_add]
  norm_num only
  rw [ha, _root_.one_mul]

theorem complement_hom_ext {G : Type*} [Group G] {f g : complement →* G}
    (ha : f complementA = g complementA) (hr : f complementR = g complementR) : f = g := by
  apply MonoidHom.ext
  intro t
  obtain ⟨i, j, rfl⟩ := complement_normal_form t
  simp only [map_mul, map_pow, ha, hr]

/-- The universal core map intertwines `a` with right conjugation by root 1. -/
theorem lift_a_compatible {G : Type*} [Group G] {x : CoreRoot → G}
    (hx : CoreRelations x) {s : G} (hs : RootOneRelations s x) :
    (lift hx).comp a.toMonoidHom =
      (MulAut.conj s⁻¹).toMonoidHom.comp (lift hx) := by
  apply hom_ext
  intro i
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, a_root,
    map_mul, map_inv, map_rootWord, lift_root]
  simpa only [map_inv] using (rightConj_of_rightComm (hs i)).symm

/-- Compatibility with the specified Weyl table can also be checked just on roots. -/
theorem lift_r_compatible {G : Type*} [Group G] {x : CoreRoot → G}
    (hx : CoreRelations x) {w : G}
    (hw : ∀ i, w * x i * w⁻¹ = x (weylRoot i)) :
    (lift hx).comp r.toMonoidHom =
      (MulAut.conj w).toMonoidHom.comp (lift hx) := by
  apply hom_ext
  intro i
  simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, r_root,
    lift_root, MulAut.conj_apply] using (hw i).symm

/-- Intertwining the two generators suffices to intertwine the entire complement. -/
theorem complement_compatible {G : Type*} [Group G]
    (fn : Core →* G) (fg : complement →* G)
    (ha : fn.comp a.toMonoidHom =
      (MulAut.conj (fg complementA)).toMonoidHom.comp fn)
    (hr : fn.comp r.toMonoidHom =
      (MulAut.conj (fg complementR)).toMonoidHom.comp fn)
    (t : complement) :
    fn.comp (complement.subtype t).toMonoidHom =
      (MulAut.conj (fg t)).toMonoidHom.comp fn := by
  let P (u : complement) : Prop := ∀ z : Core,
    fn ((u : MulAut Core) z) = MulAut.conj (fg u) (fn z)
  have hmul (u v : complement) (hu : P u) (hv : P v) : P (u * v) := by
    intro z
    change fn ((u : MulAut Core) ((v : MulAut Core) z)) = _
    rw [hu, hv, map_mul fg, map_mul (MulAut.conj), MulAut.mul_apply]
  have hpow (u : complement) (hu : P u) (k : ℕ) : P (u ^ k) := by
    induction k with
    | zero => intro z; simp
    | succ k ih => simpa only [pow_succ] using hmul (u ^ k) u ih hu
  have hA : P complementA := fun z => DFunLike.congr_fun ha z
  have hR : P complementR := fun z => DFunLike.congr_fun hr z
  obtain ⟨i, j, rfl⟩ := complement_normal_form t
  exact MonoidHom.ext (hmul _ _ (hpow _ (hmul _ _ (hpow _ hA 2) hR) i.val)
    (hpow _ hA j.val))

/-- Compatibility in the form required by `SemidirectProduct.lift`.
The ambient root-1 generator `s` is the image of `complementA⁻¹`. -/
theorem semidirect_compatible {G : Type*} [Group G] {x : CoreRoot → G}
    (hx : CoreRelations x) {s w : G} (hs : RootOneRelations s x)
    (hw : ∀ i, w * x i * w⁻¹ = x (weylRoot i))
    (fg : complement →* G) (ha : fg complementA = s⁻¹) (hr : fg complementR = w)
    (t : complement) :
    (lift hx).comp (complement.subtype t).toMonoidHom =
      (MulAut.conj (fg t)).toMonoidHom.comp (lift hx) := by
  apply complement_compatible
  · rw [ha]; exact lift_a_compatible hx hs
  · rw [hr]; exact lift_r_compatible hx hw

/-- The homomorphism into actual roots and complement generators, with the
right-conjugation convention built into the generator hypotheses. -/
noncomputable def semidirectLift {G : Type*} [Group G] {x : CoreRoot → G}
    (hx : CoreRelations x) {s w : G} (hs : RootOneRelations s x)
    (hw : ∀ i, w * x i * w⁻¹ = x (weylRoot i))
    (fg : complement →* G) (ha : fg complementA = s⁻¹) (hr : fg complementR = w) :
    Core ⋊[complement.subtype] complement →* G :=
  SemidirectProduct.lift (lift hx) fg (semidirect_compatible hx hs hw fg ha hr)

@[simp] theorem semidirectLift_root {G : Type*} [Group G] {x : CoreRoot → G}
    (hx : CoreRelations x) {s w : G} (hs : RootOneRelations s x)
    (hw : ∀ i, w * x i * w⁻¹ = x (weylRoot i))
    (fg : complement →* G) (ha : fg complementA = s⁻¹) (hr : fg complementR = w)
    (i : CoreRoot) :
    semidirectLift hx hs hw fg ha hr (SemidirectProduct.inl (root i)) = x i := by
  simp [semidirectLift]

@[simp] theorem semidirectLift_root_one {G : Type*} [Group G] {x : CoreRoot → G}
    (hx : CoreRelations x) {s w : G} (hs : RootOneRelations s x)
    (hw : ∀ i, w * x i * w⁻¹ = x (weylRoot i))
    (fg : complement →* G) (ha : fg complementA = s⁻¹) (hr : fg complementR = w) :
    semidirectLift hx hs hw fg ha hr (SemidirectProduct.inr complementA⁻¹) = s := by
  simp [semidirectLift, ha]

@[simp] theorem semidirectLift_weyl {G : Type*} [Group G] {x : CoreRoot → G}
    (hx : CoreRelations x) {s w : G} (hs : RootOneRelations s x)
    (hw : ∀ i, w * x i * w⁻¹ = x (weylRoot i))
    (fg : complement →* G) (ha : fg complementA = s⁻¹) (hr : fg complementR = w) :
    semidirectLift hx hs hw fg ha hr (SemidirectProduct.inr complementR) = w := by
  simp [semidirectLift, hr]

/-- Right conjugation by the root-1 coordinate is exactly the specified `a` action. -/
theorem rightConj_root_one (g : Core) :
    MulAut.conj ((SemidirectProduct.inr complementA⁻¹ :
      Core ⋊[complement.subtype] complement)⁻¹) (SemidirectProduct.inl g) =
      SemidirectProduct.inl (a g) := by
  simpa only [← map_inv, inv_inv, MulAut.conj_apply, Subgroup.subtype_apply,
    complementA] using (SemidirectProduct.inl_aut (φ := complement.subtype) complementA g).symm

end Core
end ReeTwo
