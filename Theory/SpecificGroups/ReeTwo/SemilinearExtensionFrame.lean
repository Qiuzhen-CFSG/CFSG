module

public import Theory.SpecificGroups.ReeTwo.SemilinearExtensionData
public import Theory.SpecificGroups.ReeTwo.CyclicExtensionFrame
public import Theory.SpecificGroups.ReeTwo.SemilinearOrbitPairing
public import Theory.SpecificGroups.ReeTwo.SemilinearOrbitQuotient

/-!
# Assembly of a semilinear Ree extension frame

For the explicit words in the generating five-orbit, quotient coordinates and
the actual antidiagonal pairing suffice for an exact frame with the prescribed
t and z. The center is generated by z, so the central-correction theorem applies
without an additional kernel hypothesis and preserves all four derived roots.

The native squaring symmetry determines the quotient coordinates and the
central pairing intrinsically. Combining these calculations with central
correction proves frame existence from the extension data, without recognition
or coordinate assumptions, even when the symmetry inverts t.

Sources: Thompson VI, pp.629–630; Parrott (1972), pp.672–674;
Shinoda (1975), (2.3), pp.81–82.
-/

namespace ReeTwo
open Subgroup
variable {K A : Type*} [Group K] [Group A]

/-- Final central correction for the explicit orbit words. The two intrinsic
obligations are their quotient coordinates and their actual central pairing;
neither is asserted by this reduction. -/
public theorem SemilinearExtensionData.lift_orbit_frame [Finite K]
    {ρ : A →* MulAut K} {R : Subgroup K} {t z : K} {b : R} {σ : MulAut K}
    (h : SemilinearExtensionData ρ R t z b σ) (g : A)
    (hquot : FrameCoordinates
      ((QuotientGroup.mk' (center K)) ∘ orbitFrame ρ b g t)
      (QuotientGroup.mk' (center K) t) (QuotientGroup.mk' (center K) z))
    (hpair : ∀ i j, rightComm (orbitFrame ρ b g t i)
      (frameTail (orbitFrame ρ b g t) t j) = if i.val + j.val = 3 then z else 1) :
    ∃ a : Fin 4 → K, FrameCoordinates a t z ∧
      frameTail a t = frameTail (orbitFrame ρ b g t) t := by
  let D := (commutator R).map R.subtype
  let _ : IsElementaryAbelian 2 D := h.derived_elementary
  apply exists_frameCoordinates_of_quotient D h.derived_eq.ge
    (by rw [h.derived_commutator, h.center_eq])
    (QuotientGroup.mk' (center K)) (orbitFrame ρ b g t) t z h.root_centralizes
    h.central_order _ hquot hpair
  rw [QuotientGroup.ker_mk', h.center_eq_zpowers]

/-- Normalize the explicit words of any nontrivial five-actor to an exact Ree
frame, retaining their derived roots and the prescribed t and z. -/
public theorem SemilinearExtensionData.exists_frameCoordinates_with_tail
    [Finite K] [Finite A]
    {ρ : A →* MulAut K} {R : Subgroup K} {t z : K} {b : R} {σ : MulAut K}
    (h : SemilinearExtensionData ρ R t z b σ) (g : A) (hg : g ≠ 1) :
    ∃ a : Fin 4 → K, FrameCoordinates a t z ∧
      frameTail a t = frameTail (orbitFrame ρ b g t) t := by
  exact h.lift_orbit_frame g (h.orbitFrame_quotient g hg) (h.orbitFrame_pairing g hg)

/-- The full five-normalizer symmetry supplies a normalized Ree frame with
the original root and central involution. No order condition on the symmetry
or choice of generator of the five-group is required. -/
public theorem SemilinearExtensionData.exists_frameCoordinates [Finite K] [Finite A]
    {ρ : A →* MulAut K} {R : Subgroup K} {t z : K} {b : R} {σ : MulAut K}
    (h : SemilinearExtensionData ρ R t z b σ) :
    ∃ a : Fin 4 → K, FrameCoordinates a t z := by
  let _ : Nontrivial A := Finite.one_lt_card_iff_nontrivial.mp (by
    rw [h.actor_card]
    decide)
  obtain ⟨g, hg⟩ := exists_ne (1 : A)
  obtain ⟨a, ha, _⟩ := h.exists_frameCoordinates_with_tail g hg
  exact ⟨a, ha⟩

end ReeTwo
