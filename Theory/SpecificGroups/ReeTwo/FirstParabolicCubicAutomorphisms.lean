module
public import Theory.SpecificGroups.ReeTwo.FirstParabolicCoordinates
public import Theory.Frattini.BinarySquares
public import Theory.GroupTheory.PGroup.FrattiniCubicConjugacy

/-!
# Cubic automorphisms of the binary Ree second core

The explicit three-coordinate projection is the actual Frattini quotient
map: its kernel was proved to be generated by squares. Thus the Frattini
quotient has order eight. The Burnside basis and Sylow argument gives
conjugacy, up to inversion, of all nontrivial cubic automorphisms.

Source: the verified Shinoda coordinates in `FirstParabolicCoordinates`,
and the binary Ree endpoint of Aschbacher–Smith, F.1.12 and J.4.5.
-/

public section
noncomputable section
namespace ReeTwo.SylowModel

theorem firstParabolicQuotient_ker_eq_frattini :
    firstParabolicQuotient.ker = frattini firstParabolicCore := by
  rw [firstParabolicQuotient_ker_eq_squares,
    (IsPGroup.of_card (p:=2) (n:=11) firstParabolicCore_card).frattini_eq_closure_squares]

theorem firstParabolic_frattini_quotient_card :
    Nat.card (firstParabolicCore ⧸ frattini firstParabolicCore) = 8 := by
  rw [← firstParabolicQuotient_ker_eq_frattini,
    Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective
      firstParabolicQuotient firstParabolicQuotient_surjective).toEquiv]
  change Nat.card (Fin 3 → ZMod 2) = 8
  simp

theorem firstParabolic_not_nine_dvd_card_mulAut :
    ¬9 ∣ Nat.card (MulAut firstParabolicCore) :=
  (IsPGroup.of_card (p:=2) (n:=11) firstParabolicCore_card).not_nine_dvd_card_mulAut_of_frattini_eight firstParabolic_frattini_quotient_card

theorem firstParabolic_cubic_conjugacy (a b : MulAut firstParabolicCore)
    (ha : orderOf a = 3) (hb : orderOf b = 3) :
    ∃ e : MulAut firstParabolicCore, e*a*e⁻¹=b ∨ e*a*e⁻¹=b⁻¹ :=
  (IsPGroup.of_card (p:=2) (n:=11) firstParabolicCore_card).cubic_mulAut_conjugate_or_inverse_of_frattini_eight
      firstParabolic_frattini_quotient_card a b ha hb

end ReeTwo.SylowModel
