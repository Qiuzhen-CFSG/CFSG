module

public import Theory.SpecificGroups.ReeTwo.ParabolicIndexTwo.Derived

/-!
# Five-fixed subgroups in the index-two Ree cores

For each concrete local kernel H, the subgroup computed here is C_Q(P), where
Q = O₂(H) and P is generated by the marked element of order five in H.
The actual core equivalences pull this subgroup back to the cyclic-four group
⟨v5⟩ in the parity case and to its intersection with omega in the other two
cases. The intersection is ⟨v12⟩, central of order two. The parity fixed subgroup
retains order four and is not central: v5 and v7 have nontrivial commutator.

The fixed-point calculation is transported from `centralizer_five_comap`,
which uses `Core.fixed_c_iff_mem_zpowers`; the intersection requires only the
four powers of v5 and the binary character. All centrality statements are
inside the intrinsic two-core, using its actual inclusion into H.

Sources: Aschbacher, *The Tits group as a standard subgroup* (1982), (3.2.7);
Parrott, *A characterization of the Tits' simple group* (1972), printed p.672;
Aschbacher--Smith, quasithin Lemma 14.2.21, printed p.989 (PDF p.1006).
Here `Core.root i` is source root v(i+3). Ambient parabolic identifications
remain the responsibility of the consuming theorem.
-/

@[expose] public section
open Subgroup
namespace ReeTwo.Centralizer.IndexTwo

/-- The marked five-element lies in the parity kernel. -/
theorem parity_five_mem : fiveGenerator ∈ parityLocal := character_fiveGenerator

private theorem mem_centralizer_zpowers_iff {G : Type*} [Group G] (g x : G) :
    x ∈ centralizer (zpowers g : Set G) ↔ g * x = x * g := by
  constructor
  · exact fun h => h g (mem_zpowers g)
  · intro h y hy
    obtain ⟨k,rfl⟩ := mem_zpowers_iff.mp hy
    exact (Commute.zpow_left h k).eq

/-- The centralizer of the marked five-subgroup inside the intrinsic two-core of a local kernel. -/
def fiveFixed (L : Subgroup Centralizer) (h5 : fiveGenerator ∈ L) :
    Subgroup (pCore 2 L) :=
  (centralizer (zpowers (⟨fiveGenerator,h5⟩ : L) : Set L)).subgroupOf (pCore 2 L)

private theorem mem_fiveFixed_iff (L : Subgroup Centralizer) (h5 : fiveGenerator ∈ L)
    (x : pCore 2 L) : x ∈ fiveFixed L h5 ↔
      ((x : L) : Centralizer) ∈ centralizer (zpowers fiveGenerator : Set Centralizer) := by
  change (x : L) ∈ centralizer (zpowers (⟨fiveGenerator,h5⟩ : L) : Set L) ↔ _
  rw [mem_centralizer_zpowers_iff, mem_centralizer_zpowers_iff]
  exact Subtype.ext_iff

/-- The actual omega coordinates identify the alternative fixed subgroup with the intersection
of omega and the existing cyclic-four fixed subgroup. -/
theorem alternative_fiveFixed_comap (χ : Centralizer →* FiveFour.Cyclic 2)
    (hχ : χ = coreCharacter ∨ χ = mixedCharacter) :
    (fiveFixed χ.ker (alternative_five_mem χ hχ)).comap (omegaEquiv χ hχ).toMonoidHom =
      (zpowers (Core.root 2)).subgroupOf (omega₁ Core (p := 2)) := by
  ext u
  rw [mem_comap, mem_fiveFixed_iff]
  change (u : Core) ∈ (centralizer (zpowers fiveGenerator : Set Centralizer)).comap
    (SemidirectProduct.inl : Core →* Centralizer) ↔ (u : Core) ∈ zpowers (Core.root 2)
  rw [centralizer_five_comap]

/-- The parity core retains the entire cyclic-four fixed subgroup under its actual coordinates. -/
theorem parity_fiveFixed_comap :
    (fiveFixed parityLocal parity_five_mem).comap parityCoreEquiv.toMonoidHom =
      zpowers (Core.root 2) := by
  ext u
  rw [mem_comap, mem_fiveFixed_iff]
  change u ∈ (centralizer (zpowers fiveGenerator : Set Centralizer)).comap
    (SemidirectProduct.inl : Core →* Centralizer) ↔ u ∈ zpowers (Core.root 2)
  rw [centralizer_five_comap]

private theorem last_root_mem_omega : Core.root 9 ∈ omega₁ Core (p := 2) := by
  rw [← Core.binaryCharacter_ker_eq_omega]
  exact (by decide +kernel : Core.binaryCharacter (Core.root 9) = 1)

/-- The intersection of omega with the cyclic-four fixed subgroup is its square subgroup. -/
theorem omega_inf_five_fixed :
    omega₁ Core (p := 2) ⊓ zpowers (Core.root 2) = zpowers (Core.root 9) := by
  apply le_antisymm
  · rintro x ⟨hx,hf⟩
    change x ∈ zpowers (Core.root 2) at hf
    change x ∈ omega₁ Core (p := 2) at hx
    rw [mem_zpowers_iff_mem_range_orderOf, Core.root_two_order] at hf
    obtain ⟨n,hn,rfl⟩ := Finset.mem_image.mp hf
    have h : Core.root 2 ^ n = 1 ∨ Core.root 2 ^ n = Core.root 9 :=
      (by decide +kernel : ∀ k : Fin 4, Core.binaryCharacter (Core.root 2 ^ k.val) = 1 →
        Core.root 2 ^ k.val = 1 ∨ Core.root 2 ^ k.val = Core.root 9)
        ⟨n,Finset.mem_range.mp hn⟩ (by
          rwa [← Core.binaryCharacter_ker_eq_omega] at hx)
    rcases h with h | h
    · rw [h]; exact one_mem _
    · rw [h]; exact mem_zpowers _
  · apply zpowers_le_of_mem
    refine ⟨last_root_mem_omega, ?_⟩
    have h : Core.root 9 = Core.root 2 ^ 2 := by decide +kernel
    rw [h]
    exact pow_mem (mem_zpowers _) _

/-- The last root, as an element of the characteristic omega core. -/
def omegaLastRoot : omega₁ Core (p := 2) := ⟨Core.root 9,by exact last_root_mem_omega⟩

private theorem omega_five_fixed_eq :
    (zpowers (Core.root 2)).subgroupOf (omega₁ Core (p := 2)) = zpowers omegaLastRoot := by
  have he : (zpowers (Core.root 2)).subgroupOf (omega₁ Core (p := 2)) =
      (zpowers (Core.root 9)).subgroupOf (omega₁ Core (p := 2)) := by
    ext u
    change (u : Core) ∈ zpowers (Core.root 2) ↔ (u : Core) ∈ zpowers (Core.root 9)
    rw [← omega_inf_five_fixed]
    exact ⟨fun h => ⟨u.property,h⟩,fun h => h.2⟩
  rw [he]
  apply Subgroup.map_injective (omega₁ Core (p := 2)).subtype_injective
  rw [Subgroup.map_subgroupOf_eq_of_le (zpowers_le_of_mem last_root_mem_omega),
    MonoidHom.map_zpowers]
  rfl

/-- In each alternative core the fixed subgroup is generated by the image of the last root. -/
theorem alternative_fiveFixed_eq (χ : Centralizer →* FiveFour.Cyclic 2)
    (hχ : χ = coreCharacter ∨ χ = mixedCharacter) :
    fiveFixed χ.ker (alternative_five_mem χ hχ) =
      zpowers (omegaEquiv χ hχ omegaLastRoot) := by
  apply Subgroup.comap_injective (f := (omegaEquiv χ hχ).toMonoidHom) (omegaEquiv χ hχ).surjective
  rw [alternative_fiveFixed_comap χ hχ, omega_five_fixed_eq]
  change zpowers omegaLastRoot =
    (zpowers ((omegaEquiv χ hχ).toMonoidHom omegaLastRoot)).comap (omegaEquiv χ hχ).toMonoidHom
  rw [← (omegaEquiv χ hχ).toMonoidHom.map_zpowers omegaLastRoot]
  exact (Subgroup.comap_map_eq_self_of_injective (omegaEquiv χ hχ).injective _).symm

/-- In the parity core the fixed subgroup is generated by the image of source root v5. -/
theorem parity_fiveFixed_eq : fiveFixed parityLocal parity_five_mem =
    zpowers (parityCoreEquiv (Core.root 2)) := by
  apply Subgroup.comap_injective (f := parityCoreEquiv.toMonoidHom) parityCoreEquiv.surjective
  rw [parity_fiveFixed_comap]
  change zpowers (Core.root 2) =
    (zpowers (parityCoreEquiv.toMonoidHom (Core.root 2))).comap parityCoreEquiv.toMonoidHom
  rw [← parityCoreEquiv.toMonoidHom.map_zpowers (Core.root 2)]
  exact (Subgroup.comap_map_eq_self_of_injective parityCoreEquiv.injective _).symm

/-- The five-fixed subgroup has order two in either alternative core. -/
theorem alternative_fiveFixed_card (χ : Centralizer →* FiveFour.Cyclic 2)
    (hχ : χ = coreCharacter ∨ χ = mixedCharacter) :
    Nat.card (fiveFixed χ.ker (alternative_five_mem χ hχ)) = 2 := by
  rw [alternative_fiveFixed_eq χ hχ, Nat.card_zpowers,
    (omegaEquiv χ hχ).orderOf_eq, ← Subgroup.orderOf_coe]
  exact orderOf_eq_prime (by decide +kernel) (by decide +kernel)

/-- The five-fixed subgroup is central in each alternative core. -/
theorem alternative_fiveFixed_le_center (χ : Centralizer →* FiveFour.Cyclic 2)
    (hχ : χ = coreCharacter ∨ χ = mixedCharacter) :
    fiveFixed χ.ker (alternative_five_mem χ hχ) ≤ center (pCore 2 χ.ker) := by
  rw [alternative_fiveFixed_eq χ hχ]
  apply zpowers_le_of_mem
  apply mem_center_iff.mpr
  intro x
  obtain ⟨u,rfl⟩ := (omegaEquiv χ hχ).surjective x
  rw [← map_mul, ← map_mul]
  congr 1
  apply Subtype.ext
  exact mem_center_iff.mp Core.root_nine_mem_center (u : Core)

/-- The parity fixed subgroup has order four. -/
theorem parity_fiveFixed_card : Nat.card (fiveFixed parityLocal parity_five_mem) = 4 := by
  rw [parity_fiveFixed_eq, Nat.card_zpowers, parityCoreEquiv.orderOf_eq]
  exact Core.root_two_order

/-- The parity fixed subgroup is cyclic. -/
theorem parity_fiveFixed_cyclic : IsCyclic (fiveFixed parityLocal parity_five_mem) := by
  rw [parity_fiveFixed_eq]
  infer_instance

/-- The parity cyclic-four fixed group is not central in its intrinsic two-core. -/
theorem parity_fiveFixed_not_le_center :
    ¬ fiveFixed parityLocal parity_five_mem ≤ center (pCore 2 parityLocal) := by
  intro h
  rw [parity_fiveFixed_eq] at h
  have hc := mem_center_iff.mp (h (mem_zpowers _)) (parityCoreEquiv (Core.root 4))
  have he : Core.root 4 * Core.root 2 = Core.root 2 * Core.root 4 :=
    parityCoreEquiv.injective (by simpa only [map_mul] using hc)
  exact (by decide +kernel : Core.root 4 * Core.root 2 ≠ Core.root 2 * Core.root 4) he

end ReeTwo.Centralizer.IndexTwo
