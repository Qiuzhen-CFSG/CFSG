module

public import Theory.SpecificGroups.ReeTwo.TailQuotientOrder16Nodes

/-!
# A finite membership certificate for the order-sixteen tail-quotient subgroups

A multiplicatively closed set of sixteen coordinate codes containing zero
contains the generators of one of the 27 checked nodes. The certificate below
branches on membership, propagates membership and nonmembership using the
actual coordinate multiplication, and closes impossible branches by exhibiting
seventeen members or forty-nine nonmembers. There are 208 binary splits and
27 successful leaves. Each branch is an ordinary kernel-checked Lean proof.

The final subgroup argument is in `TailQuotientOrder16Exhaustiveness`.

Source: direct finite enumeration of the Shinoda coordinate formulas from
`SylowTailQuotient`. The diagnostic enumeration guides the proof construction;
all multiplication, distinctness, cardinality and branching steps are checked
in this module.
-/

namespace ReeTwo.TailQuotient.Order16Certificate
open Order16Nodes
set_option maxRecDepth 10000
/-- Every element has a coordinate code in the six-bit range. -/
public theorem code_lt : ∀ q : Group, coordinateCode q < 64 := by decide +kernel
@[expose] public def code (q : Group) : Fin 64 := ⟨coordinateCode q, code_lt q⟩
@[expose] public def mulCode (a b : Fin 64) : Fin 64 :=
  code (coordinateElement a.val * coordinateElement b.val)
@[expose] public def Hits (s : Finset (Fin 64)) : Prop := ∃ i : Fin 27, ∀ j : Fin 4, code (generator i j) ∈ s
private theorem large (s : Finset (Fin 64)) (hc : s.card = 16)
    (t : Finset (Fin 64)) (ht : t.card = 17) (hs : t ⊆ s) : Hits s := by
  have := Finset.card_le_card hs
  omega
private theorem small (s : Finset (Fin 64)) (hc : s.card = 16)
    (t : Finset (Fin 64)) (ht : t.card = 49) (hs : t ⊆ sᶜ) : Hits s := by
  have := Finset.card_le_card hs
  rw [Finset.card_compl, Fintype.card_fin, hc, ht] at this
  omega

