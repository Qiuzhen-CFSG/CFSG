module
public import Theory.SpecificGroups.ReeTwo.ParityFrattiniCoordinates
public import Theory.Frattini.BinarySquares

/-!
# The Frattini kernel of the Ree two parity projection

The parity kernel is a two-group of order 2048, so its Frattini subgroup is
generated by squares. The elementary binary projection kills all squares.
Conversely, its kernel has the normal-form generators root 2 times root 3
and roots 4 through 9. Core squares and commutators supply roots 5 through 9;
commutators with rootOne² then supply root 4 and root 2 times root 3.
The verified core normal form completes the reverse inclusion.

Source: Shinoda (1975), (2.3), pp. 81–82, with core indices shifted by three,
as realized by `Core`, `RootAction`, and `Sylow`. The even complement identities
use the corrected root-2 relations verified in `Centralizer`.
-/

namespace ReeTwo.SylowModel
set_option maxRecDepth 8192
set_option maxHeartbeats 4000000
open scoped commutatorElement

private theorem parity_frattini_eq_squares :
    frattini ParityKernel = Subgroup.closure (Set.range (fun x : ParityKernel => x ^ 2)) :=
  (IsPGroup.of_card (p := 2) (n := 11)
    (maximalCharacter_ker_card 1 0 0 (Or.inl (by decide)))).frattini_eq_closure_squares

private theorem parity_square_mem (x : ParityKernel) : x ^ 2 ∈ frattini ParityKernel := by
  rw [parity_frattini_eq_squares]
  exact Subgroup.subset_closure ⟨x, rfl⟩

private theorem parity_comm_mem (x y : ParityKernel) :
    rightComm x y ∈ frattini ParityKernel := by
  rw [parity_frattini_eq_squares]
  apply commutator_le_closure_squares
  rw [commutator_def]
  simpa only [commutatorElement_def, inv_inv, rightComm] using
    (Subgroup.commutator_mem_commutator
      (show x⁻¹ ∈ (⊤ : Subgroup ParityKernel) from trivial)
      (show y⁻¹ ∈ (⊤ : Subgroup ParityKernel) from trivial))

private theorem parity_generators_mem :
    parityRoot 2 * parityRoot 3 ∈ frattini ParityKernel ∧
      ∀ i : CoreRoot, 4 ≤ i.val → parityRoot i ∈ frattini ParityKernel := by
  have h5 : parityRoot 5 ∈ frattini ParityKernel := by
    have h : parityRoot 1 ^ 2 = parityRoot 5 := by decide +kernel
    exact h ▸ parity_square_mem _
  have h8 : parityRoot 8 ∈ frattini ParityKernel := by
    have h : parityRoot 3 ^ 2 = parityRoot 8 := by decide +kernel
    exact h ▸ parity_square_mem _
  have h9 : parityRoot 9 ∈ frattini ParityKernel := by
    have h : parityRoot 2 ^ 2 = parityRoot 9 := by decide +kernel
    exact h ▸ parity_square_mem _
  have h6 : parityRoot 6 ∈ frattini ParityKernel := by
    have h : rightComm (parityRoot 1) (parityRoot 2) = parityRoot 6 := by decide +kernel
    exact h ▸ parity_comm_mem _ _
  have h7 : parityRoot 7 ∈ frattini ParityKernel := by
    have h : rightComm (parityRoot 2) (parityRoot 3) = parityRoot 7 := by decide +kernel
    exact h ▸ parity_comm_mem _ _
  have h4 : parityRoot 4 ∈ frattini ParityKernel := by
    have h : rightComm parityRootOneSquare (parityRoot 1) =
        parityRoot 4 * parityRoot 8 * parityRoot 9 := by decide +kernel
    have hh := h ▸ parity_comm_mem parityRootOneSquare (parityRoot 1)
    exact ((frattini ParityKernel).mul_mem_cancel_right h8).mp
      (((frattini ParityKernel).mul_mem_cancel_right h9).mp hh)
  constructor
  · have h : rightComm parityRootOneSquare (parityRoot 0) =
        parityRoot 2 * parityRoot 3 * parityRoot 4 * parityRoot 5 * parityRoot 6 :=
      by decide +kernel
    have hh := h ▸ parity_comm_mem parityRootOneSquare (parityRoot 0)
    exact ((frattini ParityKernel).mul_mem_cancel_right h4).mp
      (((frattini ParityKernel).mul_mem_cancel_right h5).mp
        (((frattini ParityKernel).mul_mem_cancel_right h6).mp hh))
  · intro i hi
    fin_cases i <;> norm_num at hi
    all_goals assumption

private def parityCoreEmbedding : Core →* ParityKernel where
  toFun x := ⟨SemidirectProduct.inl x, (mem_parityKernel _).mpr rfl⟩
  map_one' := Subtype.ext (map_one SemidirectProduct.inl)
  map_mul' x y := Subtype.ext (map_mul SemidirectProduct.inl x y)

private theorem parityCoreEmbedding_root (i : CoreRoot) :
    parityCoreEmbedding (Core.root i) = parityRoot i := rfl

/-- The explicit rank-four binary projection is the Frattini quotient map. -/
public theorem parityProjection_ker_eq_frattini :
    parityProjection.ker = frattini ParityKernel := by
  apply le_antisymm
  · intro x hx
    obtain ⟨hr, h0, h1, h23⟩ := (mem_parityProjection_ker x).mp hx
    have hpair (b : ZMod 2) :
        parityRoot 2 ^ b.val * parityRoot 3 ^ b.val = (parityRoot 2 * parityRoot 3) ^ b.val :=
      (by decide +kernel : ∀ b : ZMod 2,
        parityRoot 2 ^ b.val * parityRoot 3 ^ b.val = (parityRoot 2 * parityRoot 3) ^ b.val) b
    have hw := congrArg parityCoreEmbedding (Core.normal_form x.val.left)
    simp only [map_mul, map_pow, parityCoreEmbedding_root, h0, h1, h23,
      ZMod.val_zero, pow_zero, one_mul, hpair] at hw
    have he : parityCoreEmbedding x.val.left = x := by
      apply Subtype.ext
      apply SemidirectProduct.ext
      · rfl
      · exact hr.symm
    rw [he] at hw
    rw [← hw]
    obtain ⟨hpairmem, htail⟩ := parity_generators_mem
    repeat apply Subgroup.mul_mem
    · exact (frattini ParityKernel).pow_mem hpairmem _
    all_goals exact (frattini ParityKernel).pow_mem (htail _ (by decide)) _
  · rw [parity_frattini_eq_squares]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨x, rfl⟩
    change parityProjection (x ^ 2) = 1
    rw [map_pow]
    change Multiplicative.ofAdd (2 • (parityProjection x).toAdd) = 1
    congr 1
    funext i
    change (2 : ℕ) • (parityProjection x).toAdd i = 0
    simp [show (2 : ZMod 2) = 0 by decide]
end ReeTwo.SylowModel
