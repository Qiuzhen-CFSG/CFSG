set_option maxHeartbeats 4000000 in
public theorem normalWord_valid : ∀ i q, q ∈ node i →
    evalWord (generator i) (normalWord i q) = q := by
  intro i q hq
  apply coordinateCode_injective
  exact (by decide +kernel : ∀ i q, q ∈ node i →
    coordinateCode (evalWord (generator i) (normalWord i q)) = coordinateCode q) i q hq

/-- The supplied words prove generation, rather than just containment. -/
public theorem node_eq_closure (i : Fin 27) :
    node i = Subgroup.closure (Set.range (generator i)) := by
  apply le_antisymm
  · intro q hq
    rw [← normalWord_valid i q hq]
    exact evalWord_mem (generator i) (Subgroup.closure (Set.range (generator i)))
      (fun j => Subgroup.subset_closure (Set.mem_range_self j)) _
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨j, rfl⟩
    exact generator_mem i j

/-- Each checked node has exactly sixteen elements. -/
public theorem node_card (i : Fin 27) : Nat.card (node i) = 16 := by
  rw [Nat.card_eq_fintype_card]
  exact (by decide +kernel : ∀ i : Fin 27, Fintype.card (node i) = 16) i

end ReeTwo.TailQuotient.Order16Nodes
