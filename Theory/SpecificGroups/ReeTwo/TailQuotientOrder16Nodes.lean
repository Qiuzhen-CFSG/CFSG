module

public import Theory.SpecificGroups.ReeTwo.SylowTailQuotient
public import Theory.GroupTheory.SubgroupEnumeration

/-!
# Explicit order-sixteen subgroups of the Ree two tail quotient

The 27 coordinate masks below define subgroups of order sixteen in the
order-64 tail quotient. Each is supplied with four generators (padded by
the identity) and checked normal forms. This module proves that the data
are actual subgroups with the stated orders and generators. Exhaustiveness
and identification with the root-based representatives are separate results.

The integer encoding is that of `SylowTailQuotient`: low bits record the
four leading core coordinates and the high two bits record the cyclic-four
coordinate. All assertions about the data are checked by Lean's kernel.

Source: direct finite enumeration using the Shinoda coordinate formulas
in `SylowTailQuotient`; the data do not supply a proof oracle.
-/

namespace ReeTwo.TailQuotient.Order16Nodes
open Theory.GroupTheory Theory.GroupTheory.SubgroupEnumeration
set_option maxRecDepth 100000

@[expose] public def mask (i : Fin 27) : ℕ :=
  (#[65535, 263947215237135, 17523466629135, 56294136361779, 225176545407795, 66808216304835, 214662465469635, 93823560602965, 187647121184085, 99664716126885, 181805965662885, 5766102881665372165, 765617780493537285, 382893950820700165, 11532035637169377285, 168882409085337, 112588272736665, 165377715770985, 116092966049385, 1229782938247303441, 9838188445411971345, 4919075458852851985, 2459603407636795665, 1459470023989990465, 2918917778574545985, 4689395382496793665, 9378768495588152385] : Array ℕ).getD i.val 0

@[expose] public def member (i : Fin 27) (q : Group) : Prop :=
  (mask i).testBit (coordinateCode q) = true

public instance (i : Fin 27) (q : Group) : Decidable (member i q) :=
  inferInstanceAs (Decidable (_ = _))

set_option maxHeartbeats 8000000 in
private theorem closed : ∀ i : Fin 27,
    member i 1 ∧ (∀ a b : Group, member i a → member i b → member i (a * b)) ∧
      (∀ a : Group, member i a → member i a⁻¹) := by decide +kernel

@[expose] public def node (i : Fin 27) : Subgroup Group where
  carrier := member i
  one_mem' := by exact (closed i).1
  mul_mem' := by exact (closed i).2.1 _ _
  inv_mem' := by exact (closed i).2.2 _

public instance (i : Fin 27) (q : Group) : Decidable (q ∈ node i) :=
  inferInstanceAs (Decidable (member i q))

@[expose] public def generator (i : Fin 27) (j : Fin 4) : Group :=
  coordinateElement (((#[[1, 2, 4, 8], [1, 2, 32, 0], [1, 2, 36, 0], [1, 4, 32, 0], [1, 4, 34, 0], [1, 6, 32, 0], [1, 6, 34, 0], [2, 4, 8, 32], [2, 4, 33, 0], [2, 5, 32, 0], [2, 5, 33, 0], [2, 16, 0, 0], [2, 17, 0, 0], [2, 20, 0, 0], [2, 21, 0, 0], [3, 4, 32, 0], [3, 4, 33, 0], [3, 5, 32, 0], [3, 5, 33, 0], [4, 8, 16, 0], [4, 8, 17, 0], [4, 8, 18, 0], [4, 8, 19, 0], [6, 16, 0, 0], [6, 17, 0, 0], [6, 18, 0, 0], [6, 19, 0, 0]] : Array (List ℕ)).getD i.val []).getD j.val 0)

public theorem generator_mem : ∀ i j, generator i j ∈ node i := by decide +kernel

