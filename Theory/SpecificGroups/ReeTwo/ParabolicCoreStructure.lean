module

public import Theory.SpecificGroups.ReeTwo.ParabolicDerivedCentralizer
public import Theory.GroupTheory.PCoreSurjective
public import Theory.GroupTheory.SpecificGroups.FiveFourComplement
/-!
# Intrinsic two-core and quotient of the full Ree local model

The specified order-1024 core is the two-core: its quotient is the actual
faithful five-by-four complement, which has no nontrivial normal two-subgroup.
The derived tail and its centralizer are transported through the injective
core map, retaining their elementary structure and root marking.

These results concern `ReeTwo.Centralizer`; identification with a standard
parabolic in an ambient Ree group remains a separate obligation.
Source: Aschbacher (1982), Section 3, and the verified Shinoda (1975)
root-coordinate model. The quotient is identified by a group isomorphism.
-/

@[expose] public section
open Subgroup
namespace ReeTwo.Centralizer

private theorem complement_pCore : pCore 2 Core.complement = ⊥ := by
  have h := FiveFour.disjoint_range_of_normal_two_subgroup
    Core.complementEquiv.toMonoidHom Core.complementEquiv.injective
    (pCore 2 Core.complement) pCore_isPGroup
  have hr : Core.complementEquiv.toMonoidHom.range = ⊤ :=
    MonoidHom.range_eq_top.mpr Core.complementEquiv.surjective
  rw [hr] at h
  simpa using h.eq_bot

/-- The specified normal core is intrinsically the two-core. -/
theorem core_eq_pCore : core = pCore 2 Centralizer := by
  have hk : IsPGroup 2 (SemidirectProduct.rightHom (φ := Core.complement.subtype)).ker := by
    rw [← SemidirectProduct.range_inl_eq_ker_rightHom]
    exact IsPGroup.of_card (n := 10) core_card
  have h := MonoidHom.comap_pCore_of_ker_isPGroup
    (SemidirectProduct.rightHom (φ := Core.complement.subtype))
    SemidirectProduct.rightHom_surjective hk
  rw [complement_pCore, MonoidHom.comap_bot] at h
  exact (SemidirectProduct.range_inl_eq_ker_rightHom).trans h


/-- The embedded tail is the ambient commutator of the specified core. -/
theorem derived_eq_core_commutator : derived = ⁅core, core⁆ := by
  unfold derived
  rw [_root_.commutator_def, Subgroup.map_commutator,
    ← MonoidHom.range_eq_map]
  rfl

/-- The derived tail has order 32 in the local model. -/
theorem derived_card : Nat.card derived = 32 := by
  unfold derived
  rw [← Nat.card_congr ((commutator Core).equivMapOfInjective
    (SemidirectProduct.inl : Core →* Centralizer) SemidirectProduct.inl_injective).toEquiv]
  exact Core.derived_card

/-- The embedded derived tail is elementary abelian. -/
theorem derived_elementary : IsElementaryAbelian 2 derived := by
  let : IsElementaryAbelian 2 (commutator Core) := Core.derived_elementary
  exact IsElementaryAbelian.map (SemidirectProduct.inl : Core →* Centralizer)

/-- The centralizer of the tail in the whole local model has order 64. -/
theorem centralizer_derived_card : Nat.card (centralizer (derived : Set Centralizer)) = 64 := by
  rw [centralizer_derived_eq_map,
    ← Nat.card_congr ((centralizer (commutator Core : Set Core)).equivMapOfInjective
      (SemidirectProduct.inl : Core →* Centralizer) SemidirectProduct.inl_injective).toEquiv]
  exact Core.centralizer_derived_card

/-- The whole local centralizer is generated by the middle root and the tail. -/
theorem centralizer_derived_eq_sup : centralizer (derived : Set Centralizer) =
    zpowers (root 2) ⊔ derived := by
  rw [centralizer_derived_eq_map, Core.centralizer_derived_eq_sup, Subgroup.map_sup,
    MonoidHom.map_zpowers]
  rfl

/-- The quotient retains the actual specified five-by-four complement. -/
noncomputable def quotientCoreEquiv : Centralizer ⧸ core ≃* FiveFour.Group :=
  (QuotientGroup.quotientMulEquivOfEq
    (show core = (SemidirectProduct.rightHom (φ := Core.complement.subtype)).ker from
      SemidirectProduct.range_inl_eq_ker_rightHom)).trans
    ((QuotientGroup.quotientKerEquivOfSurjective _
      SemidirectProduct.rightHom_surjective).trans Core.complementEquiv.symm)

/-- The full local quotient has order twenty, with its specified model isomorphism. -/
theorem quotient_core_card : Nat.card (Centralizer ⧸ core) = 20 :=
  (Nat.card_congr quotientCoreEquiv.toEquiv).trans FiveFour.card

end ReeTwo.Centralizer
