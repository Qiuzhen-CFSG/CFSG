module

public import Theory.SpecificGroups.ReeTwo.Sylow
public import Theory.Frattini.IndexFour

/-!
# A tail contained in every index-four Ree two subgroup

The subgroup generated by Shinoda roots 7–12 lies in the second Frattini
subgroup of the Sylow model, and hence in every subgroup of index four.
Write A = [x₁,x₃], B = [x₁,x₄], and C = x₁², using right commutators.
These elements, and x₈ = x₄², belong to the first Frattini subgroup.
The identities [A,x₈] = x₁₂, [C,B] = x₁₁, B² = x₁₀,
[A,B] = x₉x₁₁x₁₂, A² = x₈x₉x₁₀, and [C,A] = x₇x₁₂
then put all six tail roots in the second Frattini subgroup, successively.

Source: the root and multiplication formulas of Shinoda (1975), (2.3),
pp. 81–82, verified in `ReeTwo.Core` and `ReeTwo.RootAction`. All the
concrete identities below are checked by Lean's kernel.
-/

open scoped commutatorElement
namespace ReeTwo.SylowModel
/-- The last six Shinoda root subgroups, with root indices shifted by three. -/
@[expose] public def tailSubgroup : Subgroup SylowModel :=
  Subgroup.closure (root '' {i : CoreRoot | 4 ≤ i.val})

private abbrev a := rootWord root [1, 2, 4, 8, 9]
private abbrev b := rootWord root [2, 3, 4, 6, 7, 8, 9]
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000

private theorem rightComm_mem_frattini {G : Type*} [Group G] [Finite G]
    [Fact (IsPGroup 2 G)] (x y : G) : rightComm x y ∈ frattini G := by
  apply commutator_le_frattini_of_isPGroup (p := 2)
  simpa only [commutatorElement_def, inv_inv, rightComm, commutator_def] using
    (Subgroup.commutator_mem_commutator (Subgroup.mem_top x⁻¹) (Subgroup.mem_top y⁻¹))

/-- Each of the last six roots lies in the second Frattini subgroup. -/
public theorem tail_root_mem_second_frattini : ∀ i : CoreRoot, 4 ≤ i.val → root i ∈
    (frattini (frattini SylowModel)).map (frattini SylowModel).subtype := by
  let F := frattini SylowModel
  let D := (frattini F).map F.subtype
  let : Fact (IsPGroup 2 SylowModel) := ⟨IsPGroup.of_card (n := 12) card⟩
  let : Fact (IsPGroup 2 F) := ⟨(Fact.out : IsPGroup 2 SylowModel).to_subgroup F⟩
  have ha : a ∈ F := by
    rw [← show rightComm rootOne (root 0) = a from by decide +kernel]
    exact rightComm_mem_frattini _ _
  have hb : b ∈ F := by
    rw [← show rightComm rootOne (root 1) = b from by decide +kernel]
    exact rightComm_mem_frattini _ _
  have hc : rootOne ^ 2 ∈ F := pth_power_mem_frattini_of_isPGroup (p := 2) _
  have h5 : root 5 ∈ F := by
    rw [← show (root 1) ^ 2 = root 5 from by decide +kernel]
    exact pth_power_mem_frattini_of_isPGroup (p := 2) _
  have hsquare (x : SylowModel) (hx : x ∈ F) : x ^ 2 ∈ D :=
    Subgroup.mem_map_of_mem F.subtype
      (pth_power_mem_frattini_of_isPGroup (p := 2) (⟨x, hx⟩ : F))
  have hcomm (x y : SylowModel) (hx : x ∈ F) (hy : y ∈ F) : rightComm x y ∈ D :=
    Subgroup.mem_map_of_mem F.subtype
      (rightComm_mem_frattini (⟨x, hx⟩ : F) ⟨y, hy⟩)
  have h9 : root 9 ∈ D := by
    rw [← show rightComm a (root 5) = root 9 from by decide +kernel]
    exact hcomm _ _ ha h5
  have h8 : root 8 ∈ D := by
    rw [← show rightComm (rootOne ^ 2) b = root 8 from by decide +kernel]
    exact hcomm _ _ hc hb
  have h7 : root 7 ∈ D := by
    rw [← show b ^ 2 = root 7 from by decide +kernel]
    exact hsquare _ hb
  have h6 : root 6 ∈ D := by
    have h := hcomm _ _ ha hb
    rw [show rightComm a b = root 6 * root 8 * root 9 from by decide +kernel] at h
    exact (D.mul_mem_cancel_right h8).mp ((D.mul_mem_cancel_right h9).mp h)
  have h5' : root 5 ∈ D := by
    have h := hsquare _ ha
    rw [show a ^ 2 = root 5 * root 6 * root 7 from by decide +kernel] at h
    exact (D.mul_mem_cancel_right h6).mp ((D.mul_mem_cancel_right h7).mp h)
  have h4 : root 4 ∈ D := by
    have h := hcomm _ _ hc ha
    rw [show rightComm (rootOne ^ 2) a = root 4 * root 9 from by decide +kernel] at h
    exact (D.mul_mem_cancel_right h9).mp h
  intro i hi
  fin_cases i <;> simp only at hi <;> first | omega | assumption

/-- The whole six-root tail lies in the second Frattini subgroup. -/
public theorem tailSubgroup_le_second_frattini : tailSubgroup ≤
    (frattini (frattini SylowModel)).map (frattini SylowModel).subtype := by
  apply (Subgroup.closure_le _).mpr
  rintro x ⟨i, hi, rfl⟩
  exact tail_root_mem_second_frattini i hi

/-- Every index-four subgroup contains the six-root tail; centricity is unnecessary. -/
public theorem tailSubgroup_le_of_index_eq_four (U : Subgroup SylowModel)
    (hU : U.index = 4) : tailSubgroup ≤ U :=
  tailSubgroup_le_second_frattini.trans
    (Subgroup.second_frattini_le_of_index_eq_four
      (IsPGroup.of_card (n := 12) card) U hU)

end ReeTwo.SylowModel
