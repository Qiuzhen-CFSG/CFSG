module
public import Theory.SpecificGroups.ReeTwo.FixingModelNonsplitCoordinates
/-!
# The first core of the nonsplit fixing extension

The second upper central term is generated by the last two roots. Its
centralizer consists exactly of elements with initial coordinate zero, and its
center is again contained in those last two roots. Finite necessary commutation
tests establish the upper bounds; root multiplication proves membership.

Source: Shinoda (1975), pp.81–83, via `SylowCollectedArithmetic`; the coordinate
argument is adapted here to the nonsplit central carry.
-/

open scoped commutatorElement
namespace ReeTwo.FixingModel.NonsplitZero

set_option maxRecDepth 10000 in
set_option maxHeartbeats 8000000 in
private theorem center_test : ∀ g : G,
    coordinateMul g (root 0) = coordinateMul (root 0) g →
    coordinateMul g (root 2) = coordinateMul (root 2) g →
    coordinateMul g actor = coordinateMul actor g → g = 1 ∨ g = root 9 := by
  decide +kernel

private theorem center_cases (g : G)
    (hg : g ∈ Subgroup.center G) : g = 1 ∨ g = root 9 :=
by
  have h := center_test g
  simp only [coordinateMul_eq_mul] at h
  exact h (Subgroup.mem_center_iff.mp hg _).symm
    (Subgroup.mem_center_iff.mp hg _).symm (Subgroup.mem_center_iff.mp hg _).symm

private def commuteModLast (x y : G) : Prop :=
  coordinateMul x y = coordinateMul y x ∨
    coordinateMul x y = coordinateMul (root 9) (coordinateMul y x)
private instance (x y : G) : Decidable (commuteModLast x y) := by
  unfold commuteModLast
  infer_instance

set_option maxRecDepth 10000 in
set_option maxHeartbeats 8000000 in
private theorem second_center_test : ∀ g : G,
    commuteModLast g (root 0) → commuteModLast g (root 2) →
    commuteModLast g actor →
    g = 1 ∨ g = root 8 ∨ g = root 9 ∨ g = root 8 * root 9 := by
  decide +kernel

private theorem commuteModLast_of_mem_second_center (g : G)
    (hg : g ∈ Subgroup.upperCentralSeries G 2) (y : G) :
    commuteModLast g y := by
  simp only [commuteModLast, coordinateMul_eq_mul]
  have h := Subgroup.mem_upperCentralSeries_succ_iff.mp hg y
  rw [Subgroup.upperCentralSeries_one] at h
  rcases center_cases _ h with h | h
  · left
    have he := congrArg (fun t => t * y * g) h
    simpa [commutatorElement_def, mul_assoc] using he
  · right
    have he := congrArg (fun t => t * y * g) h
    simpa [commutatorElement_def, mul_assoc] using he

/-- Elements of the second center are products of roots 11 and 12. -/
public theorem second_center_cases (g : G)
    (hg : g ∈ Subgroup.upperCentralSeries G 2) :
    g = 1 ∨ g = root 8 ∨ g = root 9 ∨ g = root 8 * root 9 :=
  second_center_test g (commuteModLast_of_mem_second_center g hg _)
    (commuteModLast_of_mem_second_center g hg _)
    (commuteModLast_of_mem_second_center g hg _)

private theorem action_last (t : Fin 4) (i : CoreRoot)
    (hi : i = 8 ∨ i = 9) :
    (Core.FixingActionCensus.representative 19 ^ t.val) (Core.root i) = Core.root i := by
  rw [← coordinateAction_eq]
  exact (by decide +kernel : ∀ t : Fin 4, ∀ i : CoreRoot,
    i = 8 ∨ i = 9 → coordinateAction t (Core.root i) = Core.root i) t i hi

private theorem mul_root (g : G) (i : CoreRoot) (hi : i = 8 ∨ i = 9) :
    g * root i = ⟨g.core * Core.root i, g.idx⟩ := by
  apply CyclicFourCentralExtension.Model.ext
  · change g.core * (Core.FixingActionCensus.representative 19 ^ g.idx.val) (Core.root i) *
      Core.root 9 ^ ((g.idx.val + 0) / 4) = _
    rw [action_last _ _ hi]
    simp [Nat.div_eq_of_lt g.idx.isLt]
  · apply Fin.ext
    change (g.idx.val + 0) % 4 = g.idx.val
    simp [Nat.mod_eq_of_lt g.idx.isLt]

private theorem root_mul (g : G) (i : CoreRoot) :
    root i * g = ⟨Core.root i * g.core, g.idx⟩ := by
  apply CyclicFourCentralExtension.Model.ext
  · change Core.root i * (Core.FixingActionCensus.representative 19 ^ 0) g.core *
      Core.root 9 ^ ((0 + g.idx.val) / 4) = _
    simp [Nat.div_eq_of_lt g.idx.isLt]
  · apply Fin.ext
    change (0 + g.idx.val) % 4 = g.idx.val
    simp [Nat.mod_eq_of_lt g.idx.isLt]

private theorem core_mul_eq (x y : Core) : x * y = Core.mul x y := rfl

private theorem root_nine_commute (g : G) : root 9 * g = g * root 9 :=
  (Subgroup.mem_center_iff.mp (mark_mem_center 19 true) g).symm

private theorem root_nine_mem_center : root 9 ∈ Subgroup.center G := mark_mem_center 19 true

private theorem root_eight_commute_iff (g : G) :
    g * root 8 = root 8 * g ↔ g.core.b0 = 0 := by
  rw [mul_root _ _ (Or.inl rfl), root_mul]
  constructor
  · intro h
    have he := congrArg (fun x : G => x.core.b9) h
    simpa [core_mul_eq, Core.mul, Core.root, Core.ofCoords, eq_comm] using he
  · intro h
    apply CyclicFourCentralExtension.Model.ext
    · apply Core.ext <;> simp [core_mul_eq, Core.mul, Core.root, Core.ofCoords, h]
      ring
    · rfl

private theorem root_eight_commuteModLast (g : G) : commuteModLast (root 8) g := by
  simp only [commuteModLast, coordinateMul_eq_mul]
  rcases (by decide : ∀ t : ZMod 2, t = 0 ∨ t = 1) g.core.b0 with h | h
  · exact Or.inl ((root_eight_commute_iff g).mpr h).symm
  · right
    rw [root_mul, mul_root _ _ (Or.inl rfl), root_mul]
    apply CyclicFourCentralExtension.Model.ext
    · apply Core.ext <;> simp [core_mul_eq, Core.mul, Core.root, Core.ofCoords, h]
      ring
    · rfl

private theorem root_eight_mem_second_center :
    root 8 ∈ Subgroup.upperCentralSeries G 2 := by
  apply Subgroup.mem_upperCentralSeries_succ_iff.mpr
  intro g
  rw [Subgroup.upperCentralSeries_one]
  have h := root_eight_commuteModLast g
  simp only [commuteModLast, coordinateMul_eq_mul] at h
  rcases h with h | h
  · have he : ⁅root 8, g⁆ = 1 := by rw [commutatorElement_def, h]; simp [mul_assoc]
    rw [he]
    exact (Subgroup.center G).one_mem
  · have he : ⁅root 8, g⁆ = root 9 := by rw [commutatorElement_def, h]; simp [mul_assoc]
    rw [he]
    exact root_nine_mem_center

/-- Membership in the intrinsic first core is the vanishing of `b0`. -/
@[simp] public theorem mem_K_iff (g : G) :
    g ∈ K ↔ g.core.b0 = 0 := by
  constructor
  · intro h
    apply (root_eight_commute_iff g).mp
    exact (Subgroup.mem_centralizer_iff.mp h _ root_eight_mem_second_center).symm
  · intro h
    apply Subgroup.mem_centralizer_iff.mpr
    intro x hx
    rcases second_center_cases x hx with rfl | rfl | rfl | rfl
    · simp
    · exact ((root_eight_commute_iff g).mpr h).symm
    · exact root_nine_commute g
    · rw [mul_assoc, root_nine_commute, ← mul_assoc,
        ((root_eight_commute_iff g).mpr h).symm, mul_assoc]


public abbrev Bits := ZMod 2 × ZMod 2 × ZMod 2 × ZMod 2 × ZMod 2 × ZMod 2 × ZMod 2 × ZMod 2 × ZMod 2
public abbrev Params := Bits × Fin 4
@[expose] public def elt (p : Params) : G :=
  ⟨⟨0, p.1.1, p.1.2.1, p.1.2.2.1, p.1.2.2.2.1, p.1.2.2.2.2.1,
    p.1.2.2.2.2.2.1, p.1.2.2.2.2.2.2.1, p.1.2.2.2.2.2.2.2.1, p.1.2.2.2.2.2.2.2.2⟩,p.2⟩
@[expose] public def parameterEquiv : K ≃ Params where
  toFun x := ((x.val.core.b1, x.val.core.b2, x.val.core.b3, x.val.core.b4,
    x.val.core.b5, x.val.core.b6, x.val.core.b7, x.val.core.b8, x.val.core.b9), x.val.idx)
  invFun p := ⟨elt p, (mem_K_iff _).mpr rfl⟩
  left_inv x := by
    apply Subtype.ext
    apply CyclicFourCentralExtension.Model.ext
    · exact Core.ext ((mem_K_iff _).mp x.property).symm rfl rfl rfl rfl rfl rfl rfl rfl rfl
    · rfl
  right_inv p := rfl

/-- The intrinsic first core has order 2048. -/
public theorem K_card : Nat.card K = 2048 := by
  rw [Nat.card_congr parameterEquiv, Nat.card_eq_fintype_card]
  decide +kernel

set_option maxRecDepth 20000 in
set_option maxHeartbeats 8000000 in
set_option synthInstance.maxSize 4096 in
private theorem K_center_test : ∀ p : Params,
    coordinateMul (elt p) (root 1) = coordinateMul (root 1) (elt p) →
    coordinateMul (elt p) (root 2) = coordinateMul (root 2) (elt p) →
    coordinateMul (elt p) (root 3) = coordinateMul (root 3) (elt p) →
    coordinateMul (elt p) (root 4) = coordinateMul (root 4) (elt p) →
    coordinateMul (elt p) actor = coordinateMul actor (elt p) →
    elt p = 1 ∨ elt p = root 8 ∨ elt p = root 9 ∨ elt p = root 8 * root 9 := by
  decide +kernel

private def inside (g : G) (h : g.core.b0 = 0) : K :=
  ⟨g, (mem_K_iff _).mpr h⟩

/-- The center of the first core is contained in the last two root coordinates. -/
public theorem K_center_cases (x : K) (hx : x ∈ Subgroup.center K) :
    x.val = 1 ∨ x.val = root 8 ∨ x.val = root 9 ∨ x.val = root 8 * root 9 := by
  have h (y : G) (hy : y.core.b0 = 0) :
      x.val * y = y * x.val :=
    congrArg Subtype.val (Subgroup.mem_center_iff.mp hx (inside y hy)).symm
  have he : elt (parameterEquiv x) = x.val := congrArg Subtype.val (parameterEquiv.symm_apply_apply x)
  have ht := K_center_test (parameterEquiv x)
  simp only [coordinateMul_eq_mul, he] at ht
  exact ht (h (root 1) rfl) (h (root 2) rfl) (h (root 3) rfl)
    (h (root 4) rfl) (h actor rfl)


end ReeTwo.FixingModel.NonsplitZero
