module

public import Theory.SpecificGroups.ReeTwo.ParabolicMarkedComparison.SecondCubicNormalizer.Quotient.Lines

/-!
# Actual order-48 overgroups of the native cubic inner core

The three quotient lines lift to precisely the subgroups generated by the
inner core and respectively the twist, reflection, or their product. The
first centralizes the cubic; each other case contains the literal native
actor needed by the endpoint consumer. Quotient correspondence keeps the
original automorphism subgroup and does not replace it by an abstract copy.

Source: the binary Ree endpoint argument in Aschbacher–Smith F.1.12/J.4.5.
-/

@[expose] public section
open Subgroup
namespace ReeTwo.SylowModel.CubicAction
noncomputable section

def normalizerActor : Fin 3 → MulAut A := ![twist,inverter,twist*inverter]

theorem normalizerActor_mem (i : Fin 3) : normalizerActor i ∈ cubicNormalizer := by
  fin_cases i
  · exact twist_mem_normalizer
  · exact inverter_mem_normalizer
  · exact cubicNormalizer.mul_mem twist_mem_normalizer inverter_mem_normalizer

def actorInNormalizer (i : Fin 3) : cubicNormalizer := ⟨normalizerActor i,normalizerActor_mem i⟩

theorem actor_quotient (i : Fin 3) :
    QuotientGroup.mk' innerCoreInNormalizer (actorInNormalizer i) = quotientGenerator i := by
  fin_cases i
  · rfl
  · rfl
  · exact map_mul (QuotientGroup.mk' innerCoreInNormalizer) twistInNormalizer inverterInNormalizer

theorem order48_subgroup_eq_generated (H : Subgroup (MulAut A))
    (hHN : H ≤ cubicNormalizer) (hKH : cubicInnerCore ≤ H) (hH : Nat.card H = 48) :
    ∃ i : Fin 3, H = cubicInnerCore ⊔ zpowers (normalizerActor i) := by
  let P := H.subgroupOf cubicNormalizer
  let q := QuotientGroup.mk' innerCoreInNormalizer
  have hKP : innerCoreInNormalizer ≤ P := comap_mono hKH
  have hP : Nat.card P = 48 :=
    (Nat.card_congr (subgroupOfEquivOfLe hHN).toEquiv).trans hH
  obtain ⟨i,hi⟩ := order48_subgroup_quotient_line P hKP hP
  let Q := innerCoreInNormalizer ⊔ zpowers (actorInNormalizer i)
  have hkmap : innerCoreInNormalizer.map q = ⊥ := by
    apply (Subgroup.map_eq_bot_iff _).mpr
    rw [QuotientGroup.ker_mk']
  have hQmap : Q.map q = quotientLine i := by
    rw [Subgroup.map_sup,hkmap,bot_sup_eq,MonoidHom.map_zpowers,actor_quotient]
    rfl
  have hkP : q.ker ≤ P := by rw [QuotientGroup.ker_mk']; exact hKP
  have hkQ : q.ker ≤ Q := by rw [QuotientGroup.ker_mk']; exact le_sup_left
  have hPQ : P = Q := by
    rw [← comap_map_eq_self hkP, ← comap_map_eq_self hkQ,hi,hQmap]
  have hm := congrArg (map cubicNormalizer.subtype) hPQ
  change (H.subgroupOf cubicNormalizer).map cubicNormalizer.subtype =
    (innerCoreInNormalizer ⊔ zpowers (actorInNormalizer i)).map cubicNormalizer.subtype at hm
  rw [map_subgroupOf_eq_of_le hHN,Subgroup.map_sup,MonoidHom.map_zpowers] at hm
  have hkm : innerCoreInNormalizer.map cubicNormalizer.subtype = cubicInnerCore :=
    map_subgroupOf_eq_of_le cubicInnerCore_le_normalizer
  rw [hkm] at hm
  exact ⟨i,hm⟩

theorem order48_subgroup_three_cases (H : Subgroup (MulAut A))
    (hHN : H ≤ cubicNormalizer) (hKH : cubicInnerCore ≤ H) (hH : Nat.card H = 48) :
    H = cubicInnerCore ⊔ zpowers twist ∨ H = cubicInnerCore ⊔ zpowers inverter ∨
      H = cubicInnerCore ⊔ zpowers (twist*inverter) := by
  obtain ⟨i,hi⟩ := order48_subgroup_eq_generated H hHN hKH hH
  fin_cases i
  · exact Or.inl hi
  · exact Or.inr (Or.inl hi)
  · exact Or.inr (Or.inr hi)

theorem twist_overgroup_le_centralizer :
    cubicInnerCore ⊔ zpowers twist ≤ cubicCentralizer :=
  sup_le cubicInnerCore_le_centralizer
    (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr twist_commutes_cubic.eq))

theorem order48_subgroup_centralizes_or_actors (H : Subgroup (MulAut A))
    (hHN : H ≤ cubicNormalizer) (hKH : cubicInnerCore ≤ H) (hH : Nat.card H = 48) :
    (∀ α ∈ H, Commute α cubic) ∨ inverter ∈ H ∨ twist*inverter ∈ H := by
  rcases order48_subgroup_three_cases H hHN hKH hH with rfl | rfl | rfl
  · exact Or.inl (fun α hα => mem_centralizer_singleton_iff.mp (twist_overgroup_le_centralizer hα))
  · exact Or.inr (Or.inl (mem_sup_right (mem_zpowers inverter)))
  · exact Or.inr (Or.inr (mem_sup_right (mem_zpowers (twist*inverter))))
end
end ReeTwo.SylowModel.CubicAction
