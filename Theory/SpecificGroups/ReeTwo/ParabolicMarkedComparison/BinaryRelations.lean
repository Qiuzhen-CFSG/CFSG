/-- The first relative-root word, in the published binary representation. -/
def rootOne : Products.BinaryUnit := Products.relative 0

private theorem rootOne_word : rootOne =
    Binary.simpleAssignment false 1 * Binary.simpleAssignment false 2 *
      (Products.weyl 2 * Binary.simpleAssignment false 1 * Products.weyl 2) := by
  change Products.root 8 * Products.root 9 * Products.root 11 = _
  rw [show Products.root 11 = Products.weyl 2 * Products.root 8 * Products.weyl 2 from
    Products.transported_cons 2 (routeWord 8) (routeSimple 8)]
  rw [show Products.root 8 = Binary.simpleAssignment false 1 from Products.transported_nil 1,
    show Products.root 9 = Binary.simpleAssignment false 2 from Products.transported_nil 2]

@[simp] private theorem rootOne_val : rootOne.val = matrix10 := by
  rw [rootOne_word]
  simp only [Products.weyl, Units.val_mul, Binary.simpleAssignment, mul_assoc]
  rw [product0, product1, product2, product3, product4, product5, product6, product7]

@[simp] private theorem rootOne_inv_val : (rootOne⁻¹).val = matrix17 := by
  rw [rootOne_word]
  simp only [mul_inv_rev, Products.weyl_inv, Products.simple_inv]
  simp only [Products.weyl, Units.val_mul, Binary.simpleAssignment, mul_assoc]
  rw [product8, product9, product10, product11, product12, product13, product14, product15]

/-- Core roots recovered from root 1 and the literal Parrott words. -/
def root : CoreRoot → Products.BinaryUnit :=
  ![Binary.assignment .s8,
    Binary.assignment .s7 * rootOne,
    rootOne⁻¹ * Binary.assignment .s5,
    rootOne⁻¹ * Binary.assignment .s3,
    Binary.assignment .s2,
    (Binary.assignment .s7 * rootOne) ^ 2,
    Binary.assignment .s6,
    Binary.assignment .s4,
    (rootOne⁻¹ * Binary.assignment .s3) ^ 2,
    (rootOne⁻¹ * Binary.assignment .s5) ^ 2]

