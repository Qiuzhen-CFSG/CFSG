module
public import Theory.GroupTheory.CubicInvolutionExtension
public import Theory.SpecificGroups.ReeTwo.ParabolicMarkedComparison.SecondCubicNormalizer

/-!
# Recognizing the full second endpoint from native core actions

The literal second endpoint is generated by its marked order-2048 core, cubic,
and reflection.  Their verified relations and the six-core-coset graph bound
compare it with any generated group of order 12288 carrying the same actions.
The resulting equivalence preserves the entire specified core and both actors.
This is the final presentation step for the binary Ree branch of F.1.12/J.4.5.
-/

@[expose] public section
noncomputable section
namespace ReeTwo.SylowModel.CubicAction
open Subgroup Tits.AmalgamRigidity.FullRee.SecondExtension

def coreInclusion : A→*Endpoint := inclusion.comp A.subtype

theorem endpoint_relations :
    CubicInvolutionExtension.Relations coreInclusion element reflection cubic inverter where
  cube:=weyl_relations.cube
  square:=weyl_relations.square
  invert:=by
    have hr:reflection⁻¹=reflection := inv_eq_of_mul_eq_one_right
      (by simpa only [pow_two] using weyl_relations.square)
    have hs:(inclusion (SylowModel.root 0))⁻¹=inclusion (SylowModel.root 0) := by
      rw [←map_inv]
      congr 1
    simp only [element,mul_inv_rev]
    calc
      reflection*(inclusion (SylowModel.root 0)*reflection)*reflection⁻¹=
          reflection*inclusion (SylowModel.root 0) := by group
      _ = reflection⁻¹*(inclusion (SylowModel.root 0))⁻¹ := by rw [hr,hs]
  cubic a:=action_inclusion element a
  involution a:=action_inclusion reflection a

theorem endpoint_core_cubic_inverter_generated :
    CubicInvolutionExtension.generated coreInclusion element reflection=⊤ := by
  let H:=CubicInvolutionExtension.generated coreInclusion element reflection
  have hb:reflection∈H:=subset_closure (Or.inl rfl)
  have hc:element∈H:=subset_closure (Or.inr (Or.inl rfl))
  have ha(a:A):coreInclusion a∈H:=subset_closure (Or.inr (Or.inr ⟨a,rfl⟩))
  have h0:inclusion (SylowModel.root 0)∈H := by
    have he:inclusion (SylowModel.root 0)=element*reflection⁻¹ := by
      simp only [element,mul_inv_cancel_right]
    rw [he]
    exact H.mul_mem hc (H.inv_mem hb)
  apply top_unique
  rw [←endpoint_generated]
  apply (closure_le _).mpr
  rintro x hx
  rcases hx with hx|⟨z,hz⟩
  · subst x
    exact hb
  · subst x
    obtain ⟨k,i,hki⟩:=sylow_split z
    rw [←hki,map_mul,map_pow]
    exact H.mul_mem (ha ⟨k,(mem_firstParabolicCore_iff _).mpr k.property⟩) (H.pow_mem h0 _)

theorem exists_endpoint_equiv_of_native_actions {H:Type*} [Group H] [Finite H]
    (j:A→*H) (c b:H)
    (hc:c^3=1) (hb:b^2=1) (hbc:b*c*b⁻¹=c⁻¹)
    (hjc:∀a,j (cubic a)=c*j a*c⁻¹)
    (hjb:∀a,j (inverter a)=b*j a*b⁻¹)
    (hgen:CubicInvolutionExtension.generated j c b=⊤)
    (hcard:Nat.card H=12288) :
    ∃e:Endpoint≃*H,(∀a,e (coreInclusion a)=j a)∧e element=c∧e reflection=b := by
  apply CubicInvolutionExtension.exists_equiv coreInclusion j element reflection c b cubic inverter
    endpoint_relations ⟨hc,hb,hbc,hjc,hjb⟩ endpoint_core_cubic_inverter_generated hgen
  · rw [Tits.ExceptionalParabolics.FullRee.second_card,firstParabolicCore_card]
  · rw [hcard,firstParabolicCore_card]

end ReeTwo.SylowModel.CubicAction
