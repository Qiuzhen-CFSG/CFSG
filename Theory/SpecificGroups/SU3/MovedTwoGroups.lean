module
public import Theory.SpecificGroups.SU3.OuterSolvable
public import Theory.SpecificGroups.SU3.CyclicNormalOuter.PrimeTwoActors
public import Theory.SpecificGroups.SU3.OddPrimeSylowAutomorphisms.NormalizedOuterInvolutions.FormTransport

/-!
# Innerness of moved two-subgroups in prime-field unitary automorphisms

Semilinear coverage puts every automorphism commutator in the unitary
conjugation image, since finite-field automorphisms commute. The diagonal
outer image has exponent three, so a unitary conjugation belonging to a
two-group is inner. Consequently a two-subgroup A satisfying [A,B] = A
is inner. Hermitian basis transport preserves the actual inner subgroup.

The application is the original R₂ = [R₂,Y] action in Aschbacher--Smith,
4.3.2, printed p.618. The matrix input is Steinberg, Theorem 36 and GLS3,
Theorem 2.5.12 and §2.7, as proved by the imported coverage modules.
-/

public section
open Matrix Subgroup BenderSuzuki.MatrixGroups
namespace BenderSuzuki.MatrixGroups.HermitianForm.PrimeTwoActors
variable {F : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)

/-- A two-subgroup generated by its commutators with another actor is inner. -/
theorem moved_twoGroup_le_inner
    [IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J)]
    (hJ : J.form = !![0,0,1;0,1,0;1,0,0])
    {p : ℕ} (hp : p.Prime) (ho : Odd p)
    (hcard : Nat.card F = p ^ 2)
    (hfixed : Nat.card {x : F // J.conj x = x} = p)
    (A B : Subgroup (MulAut (ProjectiveSpecialUnitaryMatrixGroup J)))
    (hA : IsPGroup 2 A) (hmove : ⁅A, B⁆ = A) :
    A ≤ MulAut.innerSubgroup (ProjectiveSpecialUnitaryMatrixGroup J) := by
  let := finiteFieldAut_isCyclic (E := F)
  let := IsCyclic.commGroup (α := F ≃+* F)
  have hcomm : ⁅A, B⁆ ≤ J.unitaryConjHom.range := by
    apply Subgroup.commutator_le.mpr
    intro a _ b _
    obtain ⟨σ, ha⟩ := OddPrimeSylow.NormalizedOuter.Coverage.semilinear_coverage_odd
      J hJ hp ho hcard hfixed a
    obtain ⟨τ, hb⟩ := OddPrimeSylow.NormalizedOuter.Coverage.semilinear_coverage_odd
      J hJ hp ho hcard hfixed b
    have h := ((ha.mul J hJ hb).mul J hJ (ha.inv J hJ)).mul J hJ (hb.inv J hJ)
    have hh : J.HasUnitarySemilinearForm (a * b * a⁻¹ * b⁻¹) 1 := by
      simpa [mul_comm, mul_left_comm, mul_assoc] using h
    obtain ⟨u, hu⟩ := (HasUnitarySemilinearForm.one_iff J).mp hh
    exact ⟨u, by simpa only [unitaryConjHom_apply, commutatorElement_def] using hu.symm⟩
  rw [hmove] at hcomm
  intro a ha
  obtain ⟨u, hu⟩ := hcomm ha
  simp only [unitaryConjHom_apply] at hu
  obtain ⟨x, hx⟩ := unitary_actor_inner J A hA u (by simpa only [← hu] using ha)
  exact ⟨x, hx.symm.trans hu⟩

/-- The innerness conclusion is independent of the Hermitian basis. -/
theorem moved_twoGroup_le_inner_of_prime
    [IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J)]
    {p : ℕ} (hp : p.Prime) (ho : Odd p)
    (hcard : Nat.card F = p ^ 2)
    (hfixed : Nat.card {x : F // J.conj x = x} = p)
    (A B : Subgroup (MulAut (ProjectiveSpecialUnitaryMatrixGroup J)))
    (hA : IsPGroup 2 A) (hmove : ⁅A, B⁆ = A) :
    A ≤ MulAut.innerSubgroup (ProjectiveSpecialUnitaryMatrixGroup J) := by
  obtain ⟨e⟩ := OddPrimeSylow.NormalizedOuter.FormTransport.exists_projectiveEquiv
    J p hcard hfixed
  let k := MulAut.congr e
  let : IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup
      (OddPrimeSylow.NormalizedOuter.FormTransport.standardForm J)) := e.symm.isSimpleGroup
  have hm := moved_twoGroup_le_inner
    (OddPrimeSylow.NormalizedOuter.FormTransport.standardForm J) rfl hp ho hcard hfixed
    (A.map k.toMonoidHom) (B.map k.toMonoidHom) (hA.map k.toMonoidHom) (by
      rw [← map_commutator, hmove])
  intro a ha
  have ht := hm (mem_map_of_mem k.toMonoidHom ha)
  rw [← MulAut.map_innerSubgroup_congr e] at ht
  obtain ⟨b, hb, he⟩ := ht
  exact k.injective he ▸ hb

end BenderSuzuki.MatrixGroups.HermitianForm.PrimeTwoActors
