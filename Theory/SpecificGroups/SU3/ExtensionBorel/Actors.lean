module
public import Theory.SpecificGroups.SU3.ExtensionBorel.Matrix
public import Theory.SpecificGroups.SU3.OuterSolvable

/-!
# The concrete semilinear Borel of projective SU₃

Entrywise field automorphisms act on the actual PSU image. Together with
conjugation by upper triangular unitary matrices they generate the actor Borel.
The matrix calculation identifies its elements with the root-preserving
semilinear actors and supplies explicit triangular semilinear coordinates.
The semilinear overgroup contains the original inner automorphisms.

Source: Aschbacher–Smith, Notation A.3.16 and Lemma A.3.18, printed pp.51–52,
and the Borel placement in 13.6.6, printed p.927; GLS3 §2.7.
-/

public section
open Matrix BenderSuzuki.External Subgroup
namespace BenderSuzuki.MatrixGroups.HermitianForm.ExtensionBorel
open BorelTorus BorelTorus.SemilinearActors
variable {E : Type*} [Field E] [Finite E] (J : HermitianForm 3 E)
variable (hJ : J.form = !![0, 0, 1; 0, 1, 0; 1, 0, 0])

include hJ in
private theorem field_special_mem (σ : E ≃+* E) (x : J.specialSubgroup) :
    GeneralLinearGroup.map σ.toRingHom x.val ∈ J.specialSubgroup := by
  obtain ⟨hx, hd⟩ := (J.mem_specialSubgroup_iff x.val).mp x.property
  apply (J.mem_specialSubgroup_iff _).mpr
  constructor
  · have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) E => M.map σ) hx
    have ht : (J.conjTranspose x.val.val).map σ =
        J.conjTranspose (x.val.val.map σ) := by
      ext i j
      exact field_conj_commute J σ _
    have hf : J.form.map σ = J.form := by
      rw [hJ]
      ext i j
      fin_cases i <;> fin_cases j <;> simp
    change J.conjTranspose (x.val.val.map σ) * J.form * x.val.val.map σ = J.form
    simpa only [Matrix.map_mul, ht, hf] using h
  · apply Units.ext
    change (σ.mapMatrix x.val.val).det = 1
    rw [← RingEquiv.map_det]
    have hd' : x.val.val.det = 1 := congrArg Units.val hd
    rw [hd', map_one]

private def fieldMap (σ : E ≃+* E) : ProjectiveSpecialUnitaryMatrixGroup J →*
    ProjectiveSpecialUnitaryMatrixGroup J :=
  ((ProjGenLinGroup.map σ.toRingHom).comp
    (ProjectiveSpecialUnitaryMatrixGroup J).subtype).codRestrict _ (by
      intro b
      obtain ⟨x, rfl⟩ := J.specialToProjective_surjective b
      change ProjGenLinGroup.map σ.toRingHom (J.specialToProjective x).val ∈ _
      rw [J.specialToProjective_apply_val, ProjGenLinGroup.map_mk]
      exact Subgroup.mem_map_of_mem _ (field_special_mem J hJ σ x))

/-- The genuine entrywise field actor on the actual projective carrier. -/
def fieldActor (σ : E ≃+* E) : MulAut (ProjectiveSpecialUnitaryMatrixGroup J) where
  toFun := fieldMap J hJ σ
  invFun := fieldMap J hJ σ.symm
  left_inv x := by
    apply Subtype.ext
    obtain ⟨g, hg⟩ := ProjGenLinGroup.mk_surjective x.val
    change ProjGenLinGroup.map σ.symm.toRingHom (ProjGenLinGroup.map σ.toRingHom x.val) = x.val
    rw [← hg, ProjGenLinGroup.map_mk, ProjGenLinGroup.map_mk]
    congr 1
    apply Units.ext
    ext i j
    exact σ.symm_apply_apply _
  right_inv x := by
    apply Subtype.ext
    obtain ⟨g, hg⟩ := ProjGenLinGroup.mk_surjective x.val
    change ProjGenLinGroup.map σ.toRingHom (ProjGenLinGroup.map σ.symm.toRingHom x.val) = x.val
    rw [← hg, ProjGenLinGroup.map_mk, ProjGenLinGroup.map_mk]
    congr 1
    apply Units.ext
    ext i j
    exact σ.apply_symm_apply _
  map_mul' := (fieldMap J hJ σ).map_mul

@[simp] theorem fieldActor_apply_val (σ : E ≃+* E)
    (x : ProjectiveSpecialUnitaryMatrixGroup J) :
    (fieldActor J hJ σ x).val = ProjGenLinGroup.map σ.toRingHom x.val := by rfl

/-- Entrywise field actors form a homomorphic image of the field automorphisms. -/
@[expose] def fieldActorHom : (E ≃+* E) →* MulAut (ProjectiveSpecialUnitaryMatrixGroup J) where
  toFun := fieldActor J hJ
  map_one' := by
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    change ProjGenLinGroup.map (RingHom.id E) x.val = x.val
    simp [ProjGenLinGroup.map_id]
  map_mul' σ τ := by
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    change ProjGenLinGroup.map (σ.toRingHom.comp τ.toRingHom) x.val =
      ProjGenLinGroup.map σ.toRingHom (ProjGenLinGroup.map τ.toRingHom x.val)
    rw [ProjGenLinGroup.map_comp]
    rfl

/-- The concrete Borel generated by triangular unitary and field actors.
The triangular unitary factor consists of root matrices times diagonal unitary
matrices. No normalizer is used in this definition. -/
@[expose] def actorBorel : Subgroup (MulAut (ProjectiveSpecialUnitaryMatrixGroup J)) :=
  (upperUnitary J).map J.unitaryConjHom ⊔ (fieldActorHom J hJ).range

/-- The actual subgroup of unitary-semilinear automorphisms. -/
@[expose] def semilinearGroup : Subgroup (MulAut (ProjectiveSpecialUnitaryMatrixGroup J)) where
  carrier := {a | ∃ σ : E ≃+* E, J.HasUnitarySemilinearForm a σ}
  one_mem' := ⟨1, (HasUnitarySemilinearForm.one_iff J).mpr
    ⟨1, by simpa only [J.unitaryConjHom_apply] using J.unitaryConjHom.map_one.symm⟩⟩
  mul_mem' := by
    rintro a b ⟨σ, ha⟩ ⟨τ, hb⟩
    exact ⟨σ * τ, ha.mul J hJ hb⟩
  inv_mem' := by
    rintro a ⟨σ, ha⟩
    exact ⟨σ⁻¹, ha.inv J hJ⟩

theorem unitary_mem_semilinear (u : J.unitarySubgroup) :
    J.unitaryConj u ∈ semilinearGroup J hJ :=
  ⟨1, (HasUnitarySemilinearForm.one_iff J).mpr ⟨u, rfl⟩⟩

theorem field_mem_semilinear (σ : E ≃+* E) :
    fieldActor J hJ σ ∈ semilinearGroup J hJ := by
  refine ⟨σ, 1, fun x => ?_⟩
  simp [fieldActor_apply_val]

/-- The natural inner embedding lies in the concrete semilinear group. -/
theorem inner_le_semilinear : MulAut.innerSubgroup (ProjectiveSpecialUnitaryMatrixGroup J) ≤
    semilinearGroup J hJ := by
  rintro a ⟨x, rfl⟩
  obtain ⟨u, rfl⟩ := J.specialToProjective_surjective x
  rw [← J.unitaryConj_special_is_inner]
  exact unitary_mem_semilinear J hJ _

private def subgroupFixer {G : Type*} [Group G] (U : Subgroup G) : Subgroup (MulAut G) where
  carrier := {a | ∀ x, a x ∈ U ↔ x ∈ U}
  one_mem' := fun _ => Iff.rfl
  mul_mem' := fun ha hb x => (ha _).trans (hb x)
  inv_mem' := by
    intro a ha x
    have h := ha (a.symm x)
    rw [a.apply_symm_apply] at h
    exact h.symm

private theorem mem_subgroupFixer {G : Type*} [Group G] (U : Subgroup G) (a : MulAut G) :
    a ∈ subgroupFixer U ↔ U.map a.toMonoidHom = U := by
  constructor
  · intro h
    ext x
    rw [Subgroup.mem_map_equiv]
    exact (h (a.symm x)).symm.trans (by rw [a.apply_symm_apply])
  · intro h x
    constructor
    · intro hx
      rw [← h, Subgroup.mem_map_equiv, a.symm_apply_apply] at hx
      exact hx
    · intro hx
      rw [← h]
      exact Subgroup.mem_map_of_mem _ hx

/-- Every actor in the concrete Borel preserves the root. -/
theorem actorBorel_preserves_root (a : MulAut (ProjectiveSpecialUnitaryMatrixGroup J))
    (ha : a ∈ actorBorel J hJ) :
    (projectiveRoot J hJ).map a.toMonoidHom = projectiveRoot J hJ := by
  apply (mem_subgroupFixer (projectiveRoot J hJ) a).mp
  apply (show actorBorel J hJ ≤ subgroupFixer (projectiveRoot J hJ) from ?_) ha
  apply sup_le
  · rintro _ ⟨u, hu, rfl⟩
    apply (mem_subgroupFixer _ _).mpr
    apply root_map_eq_of_upper_formula J hJ _ 1 u hu
    intro x
    rw [J.unitaryConjHom_apply]
    change (J.unitaryConj u x).val = _ * ProjGenLinGroup.map (RingHom.id E) _ * _
    rw [ProjGenLinGroup.map_id, MonoidHom.id_apply]
    exact J.unitaryConj_apply_val u x
  · rintro _ ⟨σ, rfl⟩
    apply (mem_subgroupFixer _ _).mpr
    apply root_map_eq_of_upper_formula J hJ _ σ 1 (upperUnitary J).one_mem
    intro x
    simp [fieldActorHom, fieldActor_apply_val]

/-- Within the actual semilinear group, the root stabilizer is precisely the
concrete triangular-unitary and field Borel. -/
theorem root_stabilizer_iff
    {q : ℕ} (hcard : Nat.card E = q ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = q)
    (a : MulAut (ProjectiveSpecialUnitaryMatrixGroup J))
    (ha : a ∈ semilinearGroup J hJ) :
    (projectiveRoot J hJ).map a.toMonoidHom = projectiveRoot J hJ ↔
      a ∈ actorBorel J hJ := by
  constructor
  · intro hr
    obtain ⟨σ, u, hu⟩ := ha
    have hupper := (root_map_eq_iff_upper J hJ hcard hfixed a σ u hu).mp hr
    have he : a = J.unitaryConjHom u * fieldActorHom J hJ σ := by
      apply MulEquiv.ext
      intro x
      apply Subtype.ext
      rw [MulAut.mul_apply, J.unitaryConjHom_apply, J.unitaryConj_apply_val]
      exact hu x
    rw [he]
    exact (actorBorel J hJ).mul_mem (Subgroup.mem_sup_left (Subgroup.mem_map_of_mem _ hupper))
      (Subgroup.mem_sup_right ⟨σ, rfl⟩)
  · exact actorBorel_preserves_root J hJ a

/-- All generators of the Borel are genuine semilinear actors. -/
theorem actorBorel_le_semilinear : actorBorel J hJ ≤ semilinearGroup J hJ := by
  apply sup_le
  · rintro _ ⟨u, _, rfl⟩
    simpa only [J.unitaryConjHom_apply] using unitary_mem_semilinear J hJ u
  · rintro _ ⟨σ, rfl⟩
    exact field_mem_semilinear J hJ σ

/-- Membership has explicit triangular semilinear coordinates, not merely
a description as generators of an abstract subgroup. -/
theorem mem_actorBorel_iff
    {q : ℕ} (hcard : Nat.card E = q ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = q)
    (a : MulAut (ProjectiveSpecialUnitaryMatrixGroup J)) :
    a ∈ actorBorel J hJ ↔ ∃ (σ : E ≃+* E) (u : J.unitarySubgroup),
      u ∈ upperUnitary J ∧ a = J.unitaryConjHom u * fieldActorHom J hJ σ := by
  constructor
  · intro ha
    obtain ⟨σ, u, hu⟩ := actorBorel_le_semilinear J hJ ha
    refine ⟨σ, u, (root_map_eq_iff_upper J hJ hcard hfixed a σ u hu).mp
      (actorBorel_preserves_root J hJ a ha), ?_⟩
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    rw [MulAut.mul_apply, J.unitaryConjHom_apply, J.unitaryConj_apply_val]
    exact hu x
  · rintro ⟨σ, u, hu, rfl⟩
    exact (actorBorel J hJ).mul_mem
      (Subgroup.mem_sup_left (Subgroup.mem_map_of_mem _ hu))
      (Subgroup.mem_sup_right ⟨σ, rfl⟩)

end BenderSuzuki.MatrixGroups.HermitianForm.ExtensionBorel
