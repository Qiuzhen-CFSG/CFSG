module
public import Theory.SpecificGroups.SU3.OrdinaryBorelGeometry
public import Theory.GroupTheory.ElementaryThompsonRelative
public import Theory.GroupTheory.PGroup.OmegaAmbient

/-!
# Fixed-field torus normalization of the unitary Thompson subgroup

Every involutory semilinear actor has coefficient one or the Hermitian
involution, so it fixes the fixed-field torus modulo the root group.
Consequently that torus preserves the subgroup generated by involutions
of S. Thompson heredity identifies its J with J(S), giving normalization
for the actual embedded root--torus subgroup. Its intrinsic automorphism
fixer calculation also gives the literal Sylow centralizer comparison.

Only the given model marking S∩L and relative normalization of L are used;
no Thompson-control premise occurs in the result. Source: Aschbacher--Smith
15.1.21(iii), printed pp.1097--1098.
-/

public section
open Subgroup Matrix BenderSuzuki.External Stellmacher
namespace BenderSuzuki.MatrixGroups.HermitianForm.OrdinaryBorel
open BorelTorus
variable {G E : Type*} [Group G] [Finite G] [Field E] [Finite E] [CharP E 2]
variable (J : HermitianForm 3 E) (hJ : J.form = !![0,0,1;0,1,0;1,0,0])

private theorem thompson_normalizes_of_square_one
    (S B : Subgroup G)
    (hb : ∀ b ∈ B, ∀ x ∈ S, x^2=1 → b*x*b⁻¹ ∈ S) :
    B ≤ normalizer (elementaryAbelianMaxJ S : Set G) := by
  have hJO : elementaryAbelianMaxJ S ≤ omegaOneAmbient S := by
    apply sSup_le
    intro A hA
    let : IsElementaryAbelian 2 A := hA.2.1
    rw [←omegaOneAmbient_eq_self A]
    exact omegaOneAmbient_mono hA.1
  have hJ := elementaryAbelianMaxJ_eq_of_intermediate S (omegaOneAmbient S) hJO (omegaOneAmbient_le S)
  rw [←hJ]
  apply le_trans _ (normalizer_le_normalizer_elementaryAbelianMaxJ _)
  intro b hbB
  rw [mem_normalizer_iff_map_conj_eq]
  apply eq_of_le_of_card_ge
  · apply map_le_iff_le_comap.mpr
    apply (omegaOneAmbient_le_iff _ _).mpr
    intro x hx hx2
    apply (omegaOneAmbient_le_iff S (omegaOneAmbient S)).mp le_rfl
      ((MulAut.conj b) x) (hb b hbB x hx hx2)
    rw [←map_pow,hx2,map_one]
  · rw [card_map_of_injective (MulAut.conj b).injective]

omit [CharP E 2] in
/-- Involutory root-preserving actors displace fixed torus elements into the root. -/
theorem involution_fixedTorus_displacement
    [IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J)]
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card E=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (a : MulAut (ProjectiveSpecialUnitaryMatrixGroup J)) (ha : a^2=1)
    (hroot : (projectiveRoot J hJ).map a.toMonoidHom=projectiveRoot J hJ)
    (k : (BorelTorus.EvenCenterAction.fixedField J)ˣ) :
    fixedTorus J hJ k * (a (fixedTorus J hJ k))⁻¹ ∈ projectiveRoot J hJ := by
  obtain ⟨σ,hσ⟩ := EvenSemilinear.semilinear_coverage J hJ hn hcard hconj a
  have hs : σ^2=1 := BorelCoprimeFieldAction.coefficient_pow J hJ hn hcard hconj hσ ha
  have hf := FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 n (by omega) hcard hconj
  have hfix : Units.map σ.toMonoidHom (fixedUnit J k⁻¹)=fixedUnit J k⁻¹ := by
    by_cases he : σ=1
    · subst σ
      rfl
    · rw [J.field_involution_eq_conj n hn hcard hf σ hs he]
      apply Units.ext
      exact (k⁻¹).val.property
  have hh := BorelCoprimeFieldAction.torus_displacement_of_fixed J hJ hn hcard hconj
    a hσ hroot (fixedUnit J k⁻¹) hfix
  change (fixedTorus J hJ k⁻¹)⁻¹ * a (fixedTorus J hJ k⁻¹) ∈ _ at hh
  simpa only [map_inv,inv_inv] using hh

omit [CharP E 2] in
/-- The concrete fixed-field torus subgroup normalizes the original J(S).
The model equivalence marks the literal intersection S∩L as the root group. -/
theorem rootFixedTorus_normalizes_thompson
    [IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J)]
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card E=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (L S : Subgroup G) (hSL : S ≤ normalizer (L:Set G))
    (e : L ≃* ProjectiveSpecialUnitaryMatrixGroup J)
    (hroot : (S.subgroupOf L).map e.toMonoidHom=projectiveRoot J hJ) :
    ((rootFixedTorus J hJ).map e.symm.toMonoidHom).map L.subtype ≤
      normalizer (elementaryAbelianMaxJ S : Set G) := by
  let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) := Finite.of_equiv L e.toEquiv
  have hpre (y) (hy : y ∈ projectiveRoot J hJ) : (e.symm y : G) ∈ S := by
    obtain ⟨l,hl,he⟩ := hroot.symm ▸ hy
    change (l:G) ∈ S at hl
    rw [←he]
    simpa only [MulEquiv.coe_toMonoidHom,e.symm_apply_apply] using hl
  have hU : ((projectiveRoot J hJ).map e.symm.toMonoidHom).map L.subtype ≤ S := by
    rintro _ ⟨l,⟨x,hx,rfl⟩,rfl⟩
    exact hpre x hx
  rw [rootFixedTorus,Subgroup.map_sup,Subgroup.map_sup]
  apply sup_le
  · exact hU.trans (S.le_normalizer.trans (normalizer_le_normalizer_elementaryAbelianMaxJ S))
  · apply thompson_normalizes_of_square_one
    rintro _ ⟨l,⟨t,⟨k,rfl⟩,rfl⟩,rfl⟩ x hx hx2
    let a₀ : MulAut L := L.normalizerMonoidHom ⟨x,hSL hx⟩
    let a := MulAut.congr e a₀
    have ha₀ : a₀^2=1 := by
      change (L.normalizerMonoidHom ⟨x,hSL hx⟩)^2=1
      rw [←map_pow]
      have he : (⟨x,hSL hx⟩:normalizer (L:Set G))^2=1 := Subtype.ext hx2
      rw [he,map_one]
    have ha : a^2=1 := by
      change (MulAut.congr e a₀)^2=1
      rw [←map_pow,ha₀,map_one]
    have haroot : (projectiveRoot J hJ).map a.toMonoidHom=projectiveRoot J hJ := by
      apply eq_of_le_of_card_ge
      · rintro _ ⟨y,hy,rfl⟩
        rw [←hroot]
        refine ⟨a₀ (e.symm y), ?_, rfl⟩
        exact S.mul_mem (S.mul_mem hx (hpre y hy)) (S.inv_mem hx)
      · rw [card_map_of_injective a.injective]
    have hd := involution_fixedTorus_displacement J hJ hn hcard hconj a ha haroot k
    have hm := hU (mem_map_of_mem L.subtype (mem_map_of_mem e.symm.toMonoidHom hd))
    change ((e.symm (fixedTorus J hJ k * (a (fixedTorus J hJ k))⁻¹) : L) : G) ∈ S at hm
    rw [map_mul,map_inv] at hm
    change (e.symm (fixedTorus J hJ k) : G) *
      ((e.symm (e (a₀ (e.symm (fixedTorus J hJ k))))) : L)⁻¹ ∈ S at hm
    rw [e.symm_apply_apply] at hm
    change (e.symm (fixedTorus J hJ k) : G) *
      (x*(e.symm (fixedTorus J hJ k):G)*x⁻¹)⁻¹ ∈ S at hm
    have hh := S.mul_mem hm hx
    change (e.symm (fixedTorus J hJ k) : G) * x * (e.symm (fixedTorus J hJ k) : G)⁻¹ ∈ S
    convert hh using 1
    group

omit [Finite G] in
/-- The literal embedded fixed-torus subgroup has the required centralizer comparison. -/
theorem rootFixedTorus_centralizers
    [IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J)]
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card E=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (L S : Subgroup G) (hSL : S ≤ normalizer (L:Set G))
    (e : L ≃* ProjectiveSpecialUnitaryMatrixGroup J) :
    S ⊓ centralizer (((rootFixedTorus J hJ).map e.symm.toMonoidHom).map L.subtype : Set G) ≤
      S ⊓ centralizer (L : Set G) := by
  rintro x ⟨hx,hc⟩
  refine ⟨hx,?_⟩
  let a₀ := L.normalizerMonoidHom ⟨x,hSL hx⟩
  have ha : MulAut.congr e a₀=1 := by
    apply rootFixedTorus_fixer J hJ hn hcard hconj
    intro y hy
    change e (a₀ (e.symm y))=y
    conv_rhs => rw [←e.apply_symm_apply y]
    apply congrArg e
    apply Subtype.ext
    change x*(e.symm y :G)*x⁻¹=(e.symm y:G)
    exact mul_inv_eq_iff_eq_mul.mpr (hc _
      (mem_map_of_mem L.subtype (mem_map_of_mem e.symm.toMonoidHom hy))).symm
  have ha₀ : a₀=1 := (MulAut.congr e).injective (ha.trans (map_one _).symm)
  intro l hl
  have he := congrArg (fun z : L => (z:G)) (DFunLike.congr_fun ha₀ ⟨l,hl⟩)
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

end BenderSuzuki.MatrixGroups.HermitianForm.OrdinaryBorel
