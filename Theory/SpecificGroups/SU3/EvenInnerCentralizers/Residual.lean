module

public import Theory.SpecificGroups.SU3.EvenInnerCentralizers.Torus
public import Theory.GroupTheory.QuaternionCentralProductResidualRecognition.Residual
public import Theory.NumberTheory.BinarySignedTorus

/-!
# Residual generation in the concrete binary unitary root–torus group

All groups here are subgroups of the actual projective SU₃ image. Odd torus
elements generate the entire two-residual: their cubic action generates first
root coordinates, and squares generate the central layer. A torus element of
prime order greater than three similarly generates the root group inside the
prime-to-p residual, even in a larger subgroup containing these matrices.

Source: Aschbacher–Smith 16.4.8, printed p.1188. Identifying this root–torus
group with an arbitrary involution centralizer is a separate geometric step.
-/

public section
open Matrix BenderSuzuki.External
namespace BenderSuzuki.MatrixGroups.HermitianForm.EvenInner
variable {E : Type*} [Field E] (J : HermitianForm 3 E)
variable (hJ : J.form = !![0, 0, 1; 0, 1, 0; 1, 0, 0])

/-- The image of the genuine Hermitian Heisenberg root group. -/
@[expose] def rootImage : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J) :=
  (hermitianUnipotentPSU J hJ).range

/-- The subgroup generated by the root group and the norm-one torus. -/
@[expose] def rootTorus : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J) :=
  rootImage J hJ ⊔ normOneImage J hJ

/-- A distinguished nonidentity central root element in characteristic two. -/
@[expose] def centralRoot [CharP E 2] : hermitianUnipotentCoord J :=
  ⟨(0, 1), by simp [CharTwo.add_self_eq_zero]⟩

/-- The distinguished projective root involution. -/
@[expose] def centralInvolution [CharP E 2] : ProjectiveSpecialUnitaryMatrixGroup J :=
  hermitianUnipotentPSU J hJ (centralRoot J)

theorem centralInvolution_sq [CharP E 2] : (centralInvolution J hJ) ^ 2 = 1 := by
  have h : (centralRoot J) ^ 2 = 1 := by
    apply Subtype.ext
    rw [square_coordinates]
    change (0, 0 * J.conj 0) = (0, 0)
    simp
  rw [centralInvolution, ← map_pow, h, map_one]

theorem centralInvolution_ne_one [CharP E 2] : centralInvolution J hJ ≠ 1 :=
  hermitianUnipotentPSU_ne_one_of_snd_ne_zero J hJ (centralRoot J) one_ne_zero

/-- The projective scalar quotient does not identify distinct root coordinates. -/
theorem root_injective : Function.Injective (hermitianUnipotentPSU J hJ) := by
  intro z w he
  have hp : ProjGenLinGroup.mk (hermitianUnipotentGL J z) =
      ProjGenLinGroup.mk (hermitianUnipotentGL J w) := congrArg Subtype.val he
  obtain ⟨c, hc⟩ := ProjGenLinGroup.mk_eq_mk_iff.mp hp
  have hc1 : c = 1 := by
    apply Units.ext
    have hh := congrArg (fun M : GL (Fin 3) E => M.val 0 0) hc
    simpa [GeneralLinearGroup.coe_scalar, Matrix.mul_diagonal,
      hermitianUnipotentGL, hermitianUnipotentMatrix] using hh
  rw [hc1, map_one, mul_one] at hc
  apply Subtype.ext
  exact Prod.ext (congrArg (fun M : GL (Fin 3) E => M.val 0 1) hc)
    (congrArg (fun M : GL (Fin 3) E => M.val 0 2) hc)

/-- The concrete projective root group has order q³. -/
theorem rootImage_card [Finite E] {q : ℕ}
    (hcard : Nat.card E = q ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = q) :
    Nat.card (rootImage J hJ) = q ^ 3 := by
  obtain ⟨_, _, _, _, _, _, hr, _⟩ := huppert_II_10_12 J q hcard hfixed hJ
  obtain ⟨R, _, _, _, _, _, _, _, hR, _, _, _, _, ⟨e, _⟩, _⟩ := hr
  let er : hermitianUnipotentCoord J ≃* rootImage J hJ :=
    MulEquiv.ofBijective (hermitianUnipotentPSU J hJ).rangeRestrict
      ⟨MonoidHom.rangeRestrict_injective_iff.mpr (root_injective J hJ),
        (hermitianUnipotentPSU J hJ).rangeRestrict_surjective⟩
  exact (Nat.card_congr er.toEquiv).symm.trans ((Nat.card_congr e).trans hR)

/-- In the binary case the root group is a two-group. -/
theorem rootImage_isTwoGroup [Finite E] {n : ℕ}
    (hcard : Nat.card E = (2 ^ n) ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = 2 ^ n) :
    IsPGroup 2 (rootImage J hJ) :=
  IsPGroup.of_card (by rw [rootImage_card J hJ hcard hfixed, ← pow_mul])

/-- The concrete root–torus group centralizes the distinguished involution.
The reverse inclusion is the full centralizer calculation. -/
theorem rootTorus_le_centralizer [CharP E 2] : rootTorus J hJ ≤
    Subgroup.centralizer ({centralInvolution J hJ} : Set (ProjectiveSpecialUnitaryMatrixGroup J)) := by
  apply sup_le
  · rintro _ ⟨z, rfl⟩
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    change hermitianUnipotentPSU J hJ z * hermitianUnipotentPSU J hJ (centralRoot J) =
      hermitianUnipotentPSU J hJ (centralRoot J) * hermitianUnipotentPSU J hJ z
    rw [← map_mul, ← map_mul]
    congr 1
    apply Subtype.ext
    apply Prod.ext
    · change z.val.1 + 0 = 0 + z.val.1
      simp
    · change z.val.2 + 1 - z.val.1 * J.conj 0 = 1 + z.val.2 - 0 * J.conj z.val.1
      simp [add_comm]
  · rintro _ ⟨k, rfl⟩
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    exact hermitianTorusPSU_commute_unipotent_of_sq_eq_one J hJ k.val k.property
      (centralRoot J) (centralInvolution_sq J hJ)

/-- Restrict the actual root matrices to any subgroup containing them. -/
def rootIn (C : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    (hR : rootImage J hJ ≤ C) : hermitianUnipotentCoord J →* C :=
  (hermitianUnipotentPSU J hJ).codRestrict C (fun z => hR ⟨z, rfl⟩)

private def torusIn (C : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    (hT : normOneImage J hJ ≤ C) : normOne J →* C :=
  (normOneMap J hJ).codRestrict C (fun z => hT ⟨z, rfl⟩)

private theorem actionIn
    (C : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    (hR : rootImage J hJ ≤ C) (hT : normOneImage J hJ ≤ C)
    (k : normOne J) (z : hermitianUnipotentCoord J) :
    torusIn J hJ C hT k * rootIn J hJ C hR z * (torusIn J hJ C hT k)⁻¹ =
      rootIn J hJ C hR (hermitianTorusAction J k.val z) := by
  apply Subtype.ext
  exact projective_torus_action J hJ k.val z

/-- Any prime greater than three dividing `q+1` supplies an actual torus actor
of that prime order, and hence all root matrices lie in the prime-to-p residual. -/
theorem rootIn_le_primeToResidual [Finite E] [CharP E 2] {q p : ℕ}
    (hcard : Nat.card E = q ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = q)
    (hp : p.Prime) (hp3 : 3 < p) (hpd : p ∣ q + 1)
    (C : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    (hR : rootImage J hJ ≤ C) (hT : normOneImage J hJ ≤ C) :
    (rootIn J hJ C hR).range ≤ Subgroup.primeToResidual p C := by
  let : Fact p.Prime := ⟨hp⟩
  have hc : p ∣ Nat.card (normOne J) := by
    rwa [normOne_card J hcard
      (huppert_II_10_4_conj_eq_frobenius J q hcard hfixed)]
  obtain ⟨k, hk⟩ := exists_prime_orderOf_dvd_card' p hc
  have hk3 : (k.val : E) ^ 3 ≠ 1 := by
    intro he
    have he' : k ^ 3 = 1 := Subtype.ext (Units.ext he)
    have hd : p ∣ 3 := hk ▸ orderOf_dvd_of_pow_eq_one he'
    have := Nat.le_of_dvd (by decide : 0 < 3) hd
    omega
  apply root_le_primeToResidual J hcard hfixed (rootIn J hJ C hR)
    p (torusIn J hJ C hT k) (r := 1) _ k.val k.property hk3 (actionIn J hJ C hR hT k)
  simp only [pow_one, ← map_pow, hk ▸ pow_orderOf_eq_one k, map_one]

/-- The concrete root–torus group has no nontrivial two-group quotient for q>2. -/
theorem rootTorus_twoResidual [Finite E] [CharP E 2] {q : ℕ}
    (hcard : Nat.card E = q ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = q)
    (hq : 2 < q) (hodd : Odd (q + 1)) :
    pResidual 2 (rootTorus J hJ) = ⊤ := by
  let C := rootTorus J hJ
  let N := pResidual 2 C
  let f := rootIn J hJ C le_sup_left
  let t := torusIn J hJ C le_sup_right
  have ht (k : normOne J) : t k ∈ N := by
    apply Subgroup.mem_pResidual_of_orderOf_coprime
    have hc : Nat.Coprime 2 (Nat.card (normOne J)) := by
      rw [normOne_card J hcard (huppert_II_10_4_conj_eq_frobenius J q hcard hfixed)]
      exact hodd.coprime_two_left
    exact hc.of_dvd_right ((orderOf_map_dvd t k).trans (orderOf_dvd_natCard k))
  obtain ⟨k, _, hk3, _, hk⟩ :=
    exists_hermitian_norm_one_torus_cube_ne_one J q hcard hfixed hJ hq
  have hroot : f.range ≤ N :=
    root_le_normal J hcard hfixed f N (t ⟨k, hk⟩) (ht ⟨k, hk⟩)
      k hk hk3 (actionIn J hJ C le_sup_left le_sup_right ⟨k, hk⟩)
  have hr : rootImage J hJ ≤ N.map C.subtype := by
    rintro _ ⟨z, rfl⟩
    exact ⟨f z, hroot ⟨z, rfl⟩, rfl⟩
  have htor : normOneImage J hJ ≤ N.map C.subtype := by
    rintro _ ⟨k, rfl⟩
    exact ⟨t k, ht k, rfl⟩
  apply top_unique
  intro c _
  obtain ⟨d, hd, he⟩ := (sup_le hr htor) c.property
  have hdc : d = c := Subtype.ext he
  exact hdc ▸ hd

/-- In the binary source range the prime required for residual generation
exists arithmetically, and works in every subgroup containing the actual roots
and norm-one torus. -/
theorem exists_prime_rootIn_le_residual [Finite E] [CharP E 2] {n : ℕ}
    (hcard : Nat.card E = (2 ^ n) ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = 2 ^ n)
    (hn : 3 < n) (hmod : 2 ^ n % 3 = 2)
    (C : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    (hR : rootImage J hJ ≤ C) (hT : normOneImage J hJ ≤ C) :
    ∃ p : ℕ, p.Prime ∧ 3 < p ∧ p ∣ Nat.card C ∧ p ∣ (2 ^ n + 1) / 3 ∧
      (rootIn J hJ C hR).range ≤ Subgroup.primeToResidual p C := by
  obtain ⟨_, p, hp, hp3, hpd⟩ := Nat.BinarySignedTorus.unitary_quotient hn hmod
  have hpc : p ∣ Nat.card C := by
    have hc := Subgroup.card_dvd_of_le hT
    rw [normOneImage_card_binary J hcard
      (huppert_II_10_4_conj_eq_frobenius J (2 ^ n) hcard hfixed) hJ hmod] at hc
    exact hpd.trans hc
  refine ⟨p, hp, hp3, hpc, hpd,
    rootIn_le_primeToResidual J hJ hcard hfixed hp hp3 ?_ C hR hT⟩
  exact hpd.trans (Nat.div_dvd_of_dvd (Nat.dvd_of_mod_eq_zero (by omega)))

end BenderSuzuki.MatrixGroups.HermitianForm.EvenInner
