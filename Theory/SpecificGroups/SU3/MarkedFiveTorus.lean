module

public import Theory.SpecificGroups.SU3.SylowOmega

/-!
# The norm-one torus attached to a marked unitary root pair

In PSU₃(4), the norm-one diagonal torus has order five. It fixes the
upper root center pointwise and commutes with the Weyl element, so it
centralizes the subgroup generated by the two opposite root centers.
It also normalizes the entire upper root group. These assertions retain
the actual projective matrix maps and the matrix-field order sixteen.

An elementary subgroup of order four in this model is the full center of
any Sylow two-subgroup containing it: the Sylow omega subgroup is its
center and has the same order. This is a placement assertion about the
given subgroup, rather than an abstract identification of its isomorphism type.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), the cocode
paragraph of Lemma 8.2.9, printed p.720; coordinates from Huppert II.10.12.
The source placement and simultaneous conjugation of an arbitrary pair
must still be supplied when applying the standard pair calculation.
-/

public section
open Subgroup BenderSuzuki.External
namespace BenderSuzuki.MatrixGroups.HermitianForm.MarkedFiveTorus
open BorelTorus BorelTorus.EvenCenterAction EvenInner

variable {E : Type*} [Field E] (J : HermitianForm 3 E)
  (hJ : J.form = !![0,0,1;0,1,0;1,0,0])

variable [CharP E 2]

/-- The marked pair consists of the actual upper and opposite central roots. -/
@[expose] def standardPair : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J) :=
  centralImage J hJ ⊔ (centralImage J hJ).map
    (MulAut.conj (hermitianWeylPSU J hJ)).toMonoidHom

/-- The norm-one condition makes the inverse-norm action trivial. -/
theorem normOne_centralizes_upper : normOneImage J hJ ≤
    centralizer (centralImage J hJ : Set (ProjectiveSpecialUnitaryMatrixGroup J)) := by
  rintro _ ⟨k, rfl⟩
  apply (torus_centralizer_iff J hJ k.val).mpr
  apply Units.ext
  apply Subtype.ext
  change ((k.val : E) * J.conj (k.val : E))⁻¹ = 1
  rw [k.property, mul_inv_cancel₀ (Units.ne_zero k.val), inv_one]

/-- The same torus fixes both marked root centers, hence their join. -/
theorem normOne_centralizes_pair : normOneImage J hJ ≤
    centralizer (standardPair J hJ : Set (ProjectiveSpecialUnitaryMatrixGroup J)) := by
  apply le_centralizer_iff.mpr
  apply sup_le
  · exact le_centralizer_iff.mp (normOne_centralizes_upper J hJ)
  · rintro _ ⟨z, hz, rfl⟩
    rintro _ ⟨k, rfl⟩
    have hc := normOne_centralizes_upper J hJ (show normOneMap J hJ k ∈
      normOneImage J hJ from ⟨k, rfl⟩) z hz
    have hw := hermitianTorusPSU_commute_weyl_of_conj_eq_inv J hJ k.val k.property
    change z * hermitianTorusPSU J hJ k.val = hermitianTorusPSU J hJ k.val * z at hc
    change hermitianTorusPSU J hJ k.val *
        (hermitianWeylPSU J hJ * z * (hermitianWeylPSU J hJ)⁻¹) =
      (hermitianWeylPSU J hJ * z * (hermitianWeylPSU J hJ)⁻¹) *
        hermitianTorusPSU J hJ k.val
    exact ((show Commute (hermitianTorusPSU J hJ k.val)
      (hermitianWeylPSU J hJ) from hw).mul_right hc.symm).mul_right
        (show Commute (hermitianTorusPSU J hJ k.val)
          (hermitianWeylPSU J hJ) from hw).inv_right

omit [CharP E 2] in
/-- The norm-one torus lies in the normalizer of the full upper root group. -/
theorem normOne_normalizes_root : normOneImage J hJ ≤
    normalizer (projectiveRoot J hJ : Set (ProjectiveSpecialUnitaryMatrixGroup J)) := by
  have hc (k : Eˣ) (x : ProjectiveSpecialUnitaryMatrixGroup J)
      (hx : x ∈ projectiveRoot J hJ) :
      hermitianTorusPSU J hJ k * x * (hermitianTorusPSU J hJ k)⁻¹ ∈
        projectiveRoot J hJ := by
    obtain ⟨z, rfl⟩ := hx
    rw [projective_torus_action]
    exact ⟨_, rfl⟩
  rintro _ ⟨k, rfl⟩
  apply mem_normalizer_iff.mpr
  intro x
  constructor
  · exact hc k.val x
  · intro hx
    have hh := hc k.val⁻¹ _ hx
    simpa only [normOneMap, MonoidHom.comp_apply, Subgroup.coe_subtype,
      map_inv, inv_inv, inv_mul_cancel_left, mul_inv_cancel_right,
      mul_assoc, inv_mul_cancel, mul_one] using hh

omit [CharP E 2] in
/-- At fixed-field order four the scalar kernel is trivial and the image has order five. -/
theorem normOne_card_five [Finite E] (hcard : Nat.card E = 16)
    (hconj : ∀ x : E, J.conj x = x ^ 4) : Nat.card (normOneImage J hJ) = 5 := by
  simpa using normOneImage_card J (q := 4) hcard hconj hJ

/-- The three intrinsic facts needed for transport into the source quotient. -/
theorem standard_five [Finite E] (hcard : Nat.card E = 16)
    (hconj : ∀ x : E, J.conj x = x ^ 4) :
    Nat.card (normOneImage J hJ) = 5 ∧
      normOneImage J hJ ≤ centralizer (standardPair J hJ : Set _) ∧
      normOneImage J hJ ≤ normalizer (projectiveRoot J hJ : Set _) :=
  ⟨normOne_card_five J hJ hcard hconj, normOne_centralizes_pair J hJ,
    normOne_normalizes_root J hJ⟩

variable [Finite E]

omit [CharP E 2] in
include hJ in
/-- Every marked elementary four-subgroup is an embedded Sylow center. -/
theorem elementary_four_eq_sylow_center
    (hcard : Nat.card E = 16)
    (hfixed : Nat.card {x : E // J.conj x = x} = 4)
    (A : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) [IsElementaryAbelian 2 A]
    (hA : Nat.card A = 4) :
    ∃ P : Sylow 2 (ProjectiveSpecialUnitaryMatrixGroup J),
      A = (center P).map (P : Subgroup _).subtype := by
  let : Finite (Matrix.ProjGenLinGroup (Fin 3) E) :=
    Finite.of_surjective Matrix.ProjGenLinGroup.mk Matrix.ProjGenLinGroup.mk_surjective
  obtain ⟨P, hP⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_le_sylow
  obtain ⟨hcenter, _, hsize⟩ :=
    SylowOmega.projective_sylow_omega J (n := 2) (by decide) hcard hfixed hJ P
  refine ⟨P, ?_⟩
  rw [← hcenter]
  apply eq_of_le_of_card_ge
  · exact (omegaOneAmbient_eq_self A).symm.le.trans (omegaOneAmbient_mono hP)
  · simpa only [hA, show 2 ^ 2 = 4 by decide] using hsize.le

omit [CharP E 2] in
include hJ in
/-- The center placement retains a specified equivalence with the actual model. -/
theorem elementary_four_eq_sylow_center_of_equiv
    {L : Type*} [Group L] [Finite L]
    (hcard : Nat.card E = 16)
    (hfixed : Nat.card {x : E // J.conj x = x} = 4)
    (e : L ≃* ProjectiveSpecialUnitaryMatrixGroup J)
    (A : Subgroup L) [IsElementaryAbelian 2 A] (hA : Nat.card A = 4) :
    ∃ P : Sylow 2 L, A = (center P).map (P : Subgroup L).subtype := by
  let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
    Finite.of_surjective e e.surjective
  let : IsElementaryAbelian 2 (A.map e.toMonoidHom) := IsElementaryAbelian.map _
  obtain ⟨P, hP⟩ := elementary_four_eq_sylow_center J hJ hcard hfixed
    (A.map e.toMonoidHom) (by rw [card_map_of_injective e.injective, hA])
  let Q := P.mapSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  refine ⟨Q, ?_⟩
  have he := congrArg (Subgroup.map e.symm.toMonoidHom) hP
  rw [map_embeddedCenter _ _ e.symm.injective] at he
  have hc : e.symm.toMonoidHom.comp e.toMonoidHom = MonoidHom.id L := by
    ext x
    exact e.symm_apply_apply x
  rw [map_map, hc, map_id] at he
  exact he

end BenderSuzuki.MatrixGroups.HermitianForm.MarkedFiveTorus
