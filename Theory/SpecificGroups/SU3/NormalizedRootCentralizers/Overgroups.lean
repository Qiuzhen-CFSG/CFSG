module

public import Theory.SpecificGroups.SU3.NormalizedRootCentralizers.Actions

/-!
# Root centralizers in a component and residual overgroup

For a faithful action on PSU₃, a subgroup generated by the inner component
and a residual D = [D,T] acts by inner-diagonal automorphisms. Its normalizer
of the positive Sylow therefore acts by scalars on the full Sylow center.
This proves uniformity in the whole relative Borel, even when the original
ambient automorphism group contains field automorphisms. No splitting of a
mixed field–diagonal extension is used.

Source: Aschbacher–Smith, proof of 13.6.6, printed p.927, and A.3.16–18.
-/

public section
open Subgroup BenderSuzuki.External
namespace BenderSuzuki.MatrixGroups.HermitianForm.NormalizedRootCentralizers
open BorelTorus ExtensionBorel
variable {E : Type*} [Field E] [Finite E] [CharP E 2] (J : HermitianForm 3 E)
    (hJ : J.form = !![0,0,1;0,1,0;1,0,0])
    {n : ℕ} (hn : 1 < n) (hcard : Nat.card E = (2^n)^2)
    (hfixed : Nat.card {x : E // J.conj x = x} = 2^n)
    {H : Type*} [Group H]
include hn hcard hfixed

/-- A unitary inner-diagonal actor normalizing the specified Sylow has
uniform centralizers on its entire center. -/
theorem normalizer_uniform_of_unitary_action
    (f : H →* MulAut (ProjectiveSpecialUnitaryMatrixGroup J))
    (hf : Function.Injective f) (U B : Subgroup H)
    (hU : U.map f = (projectiveRoot J hJ).map MulAut.conj)
    (hN : B ≤ normalizer (U : Set H)) (hD : B.map f ≤ J.unitaryConjHom.range)
    (r : H) (hr : r ∈ (center U).map U.subtype) (hne : r ≠ 1) :
    B ⊓ centralizer ({r} : Set H) =
      B ⊓ centralizer (((center U).map U.subtype : Subgroup H) : Set H) := by
  have hconj := huppert_II_10_4_conj_eq_frobenius J (2^n) hcard hfixed
  have hi := binary_inner_injective J hJ hn hcard hconj
  apply uniform_of_action J hJ hn hcard hfixed f hf U B hU _ hD r hr hne
  rintro _ ⟨b, hb, rfl⟩
  obtain ⟨u, hu⟩ := hD (mem_map_of_mem f hb)
  apply (root_stabilizer_iff J hJ hcard hfixed (f b) (by
    rw [← hu, J.unitaryConjHom_apply]
    exact unitary_mem_semilinear J hJ u)).mp
  have hnorm := U.le_normalizer_map f (mem_map_of_mem f (hN hb))
  rw [hU, mem_normalizer_iff_map_conj_eq] at hnorm
  have he : (MulAut.conj (f b) : MulAut (ProjectiveSpecialUnitaryMatrixGroup J) →*
      MulAut (ProjectiveSpecialUnitaryMatrixGroup J)).comp MulAut.conj =
        MulAut.conj.comp (f b).toMonoidHom := by
    ext x y
    simp
  rw [map_map, he, ← map_map] at hnorm
  exact map_injective hi hnorm

/-- The whole relative Borel in C D has uniform root centralizers when C
acts by inner automorphisms and D is generated by its commutators with T. -/
theorem commutator_generated_overgroup_uniform
    [IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J)]
    (f : H →* MulAut (ProjectiveSpecialUnitaryMatrixGroup J))
    (hf : Function.Injective f) (U C D T B : Subgroup H)
    (hU : U.map f = (projectiveRoot J hJ).map MulAut.conj)
    (hC : C.map f ≤ MulAut.innerSubgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    (hD : ⁅D,T⁆ = D) (hBC : B ≤ C ⊔ D) (hN : B ≤ normalizer (U : Set H))
    (r : H) (hr : r ∈ (center U).map U.subtype) (hne : r ≠ 1) :
    B ⊓ centralizer ({r} : Set H) =
      B ⊓ centralizer (((center U).map U.subtype : Subgroup H) : Set H) := by
  apply normalizer_uniform_of_unitary_action J hJ hn hcard hfixed f hf U B hU hN _ r hr hne
  apply (map_mono hBC).trans
  rw [Subgroup.map_sup]
  exact sup_le (hC.trans (inner_le_unitary J))
    (commutator_generated_unitary J hJ hn hcard
      (huppert_II_10_4_conj_eq_frobenius J (2^n) hcard hfixed) f D T hD)

end BenderSuzuki.MatrixGroups.HermitianForm.NormalizedRootCentralizers
