module

public import Theory.SpecificGroups.SU3.CyclicNormalOuter.OddCoverage
public import Theory.FieldTheory.QuadraticFrobeniusFixed.Transport
public import Theory.GroupTheory.SolvableOuterQuotient
public import Mathlib.GroupTheory.PGroup

/-!
# Two-subgroups of the prime-field projective unitary automorphism group

Every automorphism has a unitary-semilinear formula. Over a field of order
p² its field part is either identity or the stored Hermitian conjugation.
The diagonal outer image has exponent three, so a unitary conjugation in
a two-group is inner. A two-subgroup containing entrywise conjugation is
therefore generated by its literal inner preimage and that conjugation.
No commutativity or cyclicity assumption is needed for this decomposition.

Source: GLS3, Theorem 2.5.12 and §2.7, using the odd-prime coverage proof;
Aschbacher--Smith E.1.14(7), printed p.214, uses this actor reduction.
-/

public section
open Matrix Subgroup BenderSuzuki.MatrixGroups
namespace BenderSuzuki.MatrixGroups.HermitianForm.PrimeTwoActors
variable {F : Type*} [Field F] (J : HermitianForm 3 F)

/-- A unitary conjugation in a two-group is inner: its outer cube is one. -/
theorem unitary_actor_inner
    (U : Subgroup (MulAut (ProjectiveSpecialUnitaryMatrixGroup J)))
    (hU : IsPGroup 2 U) (u : J.unitarySubgroup) (hu : J.unitaryConj u ∈ U) :
    ∃ y, J.unitaryConj u = MulAut.conj y := by
  let q := QuotientGroup.mk' (MulAut.innerSubgroup (ProjectiveSpecialUnitaryMatrixGroup J))
  let a : U := ⟨J.unitaryConj u, hu⟩
  have hcop : (orderOf (q (J.unitaryConj u))).Coprime 3 :=
    (hU.orderOf_coprime (by decide : Nat.Coprime 2 3) a).coprime_dvd_left
      (orderOf_map_dvd (q.comp U.subtype) a)
  obtain ⟨y, hy⟩ := J.unitaryConj_cube_is_inner u
  have hcube : q (J.unitaryConj u) ^ 3 = 1 := by
    rw [← map_pow, hy]
    exact (QuotientGroup.eq_one_iff _).mpr ⟨y, rfl⟩
  have hq : q (J.unitaryConj u) = 1 := orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes hcop (dvd_refl _)
      (orderOf_dvd_of_pow_eq_one hcube))
  obtain ⟨z, hz⟩ := (QuotientGroup.eq_one_iff _).mp hq
  exact ⟨z, hz.symm⟩

/-- Every actor is inner, possibly followed by the specified entrywise action.
The conjugating element belongs to the literal inner preimage. -/
theorem actor_inner_or_inner_entrywise [Finite F]
    [IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J)]
    (hJ : J.form = !![0,0,1;0,1,0;1,0,0])
    {p : ℕ} (hp : p.Prime) (ho : Odd p)
    (hcard : Nat.card F = p ^ 2) (hc : ∀ x, J.conj x = x ^ p)
    (U : Subgroup (MulAut (ProjectiveSpecialUnitaryMatrixGroup J)))
    (hU : IsPGroup 2 U)
    (γ : MulAut (ProjectiveSpecialUnitaryMatrixGroup J))
    (hγ : J.IsEntrywiseConjugation γ) (hγU : γ ∈ U)
    (a : MulAut (ProjectiveSpecialUnitaryMatrixGroup J)) (ha : a ∈ U) :
    ∃ y ∈ U.comap MulAut.conj, a = MulAut.conj y ∨ a = MulAut.conj y * γ := by
  let : Fact p.Prime := ⟨hp⟩
  have hfixed : Nat.card {x : F // J.conj x = x} = p := by
    simpa only [pow_one] using
      FiniteField.card_fixed_of_quadratic_frobenius J.conj p 1 (by decide)
        (by simpa only [pow_one] using hcard) (by simpa only [pow_one] using hc)
  obtain ⟨σ, hσ⟩ := OddPrimeSylow.NormalizedOuter.Coverage.semilinear_coverage_odd
    J hJ hp ho hcard hfixed a
  rcases OddPrimeSylow.NormalizedOuter.fieldAut_eq_one_or_conj J hp hcard hfixed σ
      with rfl | rfl
  · obtain ⟨u, hu⟩ := (HasUnitarySemilinearForm.one_iff J).mp hσ
    obtain ⟨y, hy⟩ := unitary_actor_inner J U hU u (hu ▸ ha)
    have he : a = MulAut.conj y := hu.trans hy
    refine ⟨y, ?_, Or.inl he⟩
    change MulAut.conj y ∈ U
    rw [← he]
    exact ha
  · obtain ⟨u, hu⟩ := (HasUnitarySemilinearForm.conj_iff J hγ).mp hσ
    have hue : J.unitaryConj u = a * γ⁻¹ := by rw [hu, mul_inv_cancel_right]
    obtain ⟨y, hy⟩ := unitary_actor_inner J U hU u
      (hue ▸ U.mul_mem ha (U.inv_mem hγU))
    refine ⟨y, ?_, Or.inr (hu.trans (congrArg (· * γ) hy))⟩
    change MulAut.conj y ∈ U
    rw [← hy, hue]
    exact U.mul_mem ha (U.inv_mem hγU)

/-- The actual actor subgroup is the join of its inner image and the specified
entrywise involution. In particular this describes all actors, not only
involutory actors. -/
theorem actor_eq_inner_sup_entrywise [Finite F]
    [IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J)]
    (hJ : J.form = !![0,0,1;0,1,0;1,0,0])
    {p : ℕ} (hp : p.Prime) (ho : Odd p)
    (hcard : Nat.card F = p ^ 2) (hc : ∀ x, J.conj x = x ^ p)
    (U : Subgroup (MulAut (ProjectiveSpecialUnitaryMatrixGroup J)))
    (hU : IsPGroup 2 U)
    (γ : MulAut (ProjectiveSpecialUnitaryMatrixGroup J))
    (hγ : J.IsEntrywiseConjugation γ) (hγU : γ ∈ U) :
    U = (U.comap MulAut.conj).map MulAut.conj ⊔ zpowers γ := by
  apply le_antisymm
  · intro a ha
    obtain ⟨y, hy, rfl | rfl⟩ :=
      actor_inner_or_inner_entrywise J hJ hp ho hcard hc U hU γ hγ hγU a ha
    · exact mem_sup_left (mem_map_of_mem _ hy)
    · exact mul_mem (mem_sup_left (mem_map_of_mem _ hy))
        (mem_sup_right (mem_zpowers γ))
  · apply sup_le
    · exact (map_le_iff_le_comap).mpr le_rfl
    · exact zpowers_le.mpr hγU

end BenderSuzuki.MatrixGroups.HermitianForm.PrimeTwoActors
