module

public import Theory.SpecificGroups.SU3.EvenInnerCentralizers.Residual

/-!
# Binary unitary inner-centralizer geometry

The concrete subgroup generated by the Hermitian roots and the norm-one
torus centralizes the distinguished root involution. Its torus has the
projective scalar kernel of order three in the source congruence, and its
roots are generated in prime-to-p residuals by the actual torus action,
including their central layer. This module specializes the two-residual
calculation to fixed-field order `2^n`.

The full centralizer identification, transport from arbitrary inner
involutions, and the ambient odd-prime rank calculation are separate
geometric assertions. The root–torus results alone do not assert those
identifications.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, proof of
16.4.8, printed p.1188.
-/

open BenderSuzuki.External
namespace BenderSuzuki.MatrixGroups.HermitianForm.EvenInner
variable {E : Type*} [Field E] [Finite E] [CharP E 2] (J : HermitianForm 3 E)

/-- In the binary range of the source, the actual root–torus subgroup
is its own two-residual. -/
public theorem rootTorus_twoResidual_binary {n : ℕ} (hn : 2 ≤ n)
    (hcard : Nat.card E = (2 ^ n) ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = 2 ^ n)
    (hJ : J.form = !![0, 0, 1; 0, 1, 0; 1, 0, 0]) :
    pResidual 2 (rootTorus J hJ) = ⊤ := by
  have hq : 4 ≤ 2 ^ n := Nat.pow_le_pow_right (n := 2) (i := 2) (j := n) (by decide) hn
  apply rootTorus_twoResidual J hJ hcard hfixed (by omega)
  rw [Nat.odd_iff]
  have hd : 2 ∣ 2 ^ n := dvd_pow_self 2 (by omega)
  have := Nat.mod_eq_zero_of_dvd hd
  omega

end BenderSuzuki.MatrixGroups.HermitianForm.EvenInner
