module

public import Theory.GroupAction.PerfectCentralQuotient.ConjugateGeneration
public import Theory.GroupAction.AutomorphismFixedTransport
public import Mathlib.Order.Cover

/-!
# Adding one conjugate to a maximal subgroup

A nonidentity automorphism of a simple group normally generates the inner
image under conjugation by group elements. Indeed, the inverse image under
`conj` of its orbit closure is normal. If it were trivial, all displacements
`a(s) * s⁻¹` would be trivial, contradicting `a ≠ 1`. Simplicity therefore
makes that inverse image the whole group.

Consequently, if a finite tuple of inner conjugates generates a maximal
proper subgroup of the extension by the actor, a further inner conjugate
escapes it and completes generation. The inner-actor variant works directly
with a maximal subgroup of the simple group. Equivalences transport the
literal conjugators as well as the actor.

This is the elementary fourth-conjugate step in Guralnick–Malle,
*Classification of 2F-modules I*, Proposition 4.3, manuscript pp.10–11.
It supplies no maximal-subgroup existence assertion.
-/

@[expose] public section
open Subgroup
namespace MulAut
variable {S R : Type*} [Group S] [Group R]

/-- Closure of the actor's conjugates by elements of the underlying group. -/
def innerOrbitClosure (a : MulAut S) : Subgroup (MulAut S) :=
  closure (Set.range fun s : S => conj s * a * (conj s)⁻¹)

/-- The subgroup generated by the inner automorphisms and the actor. -/
def singleInnerExtension (a : MulAut S) : Subgroup (MulAut S) :=
  (conj : S →* MulAut S).range ⊔ closure {a}

private theorem conjugate_conj (a : MulAut S) (s : S) :
    a * conj s * a⁻¹ = conj (a s) := by
  ext x
  simp [mul_apply, conj_apply]

/-- Simplicity makes the complete inner orbit generate the actor's extension. -/
theorem innerOrbitClosure_eq [IsSimpleGroup S] (a : MulAut S) (ha : a ≠ 1) :
    innerOrbitClosure a = singleInnerExtension a := by
  let P := innerOrbitClosure a
  have han : a ∈ P := by
    exact subset_closure ⟨1, by simp⟩
  have hn : (conj : S →* MulAut S).range ≤ normalizer (P : Set (MulAut S)) := by
    apply le_normalizer_closure_iff.mpr
    rintro _ ⟨g, rfl⟩ _ ⟨s, rfl⟩
    apply subset_closure
    refine ⟨g * s, ?_⟩
    simp only [map_mul, mul_inv_rev]
    group
  let D := P.comap (conj : S →* MulAut S)
  have hD : D.Normal := by
    constructor
    intro d hd s
    change conj (s * d * s⁻¹) ∈ P
    rw [map_mul, map_mul, map_inv]
    exact (hn ⟨s, rfl⟩ _).mp hd
  have hDtop : D = ⊤ := by
    rcases hD.eq_bot_or_eq_top with he | he
    · exfalso
      apply ha
      ext s
      have hc : a * (conj s * a * (conj s)⁻¹)⁻¹ ∈ P :=
        P.mul_mem han (P.inv_mem (subset_closure ⟨s, rfl⟩))
      have hd : a s * s⁻¹ ∈ D := by
        change conj (a s * s⁻¹) ∈ P
        have hh : conj (a s * s⁻¹) = a * (conj s * a * (conj s)⁻¹)⁻¹ := by
          rw [map_mul, map_inv, ← conjugate_conj]
          group
        rwa [hh]
      rw [he, mem_bot] at hd
      exact mul_inv_eq_one.mp hd
    · exact he
  apply le_antisymm
  · apply (closure_le _).2
    rintro _ ⟨s, rfl⟩
    have hN : (conj : S →* MulAut S).range ≤ singleInnerExtension a := le_sup_left
    have hA : closure ({a} : Set (MulAut S)) ≤ singleInnerExtension a := le_sup_right
    exact (singleInnerExtension a).mul_mem
      ((singleInnerExtension a).mul_mem (hN ⟨s, rfl⟩)
        (hA (subset_closure (Set.mem_singleton a))))
      ((singleInnerExtension a).inv_mem (hN ⟨s, rfl⟩))
  · apply sup_le
    · rintro _ ⟨s, rfl⟩
      exact show s ∈ D from hDtop ▸ mem_top s
    · exact (closure_le _).2 (Set.singleton_subset_iff.mpr han)

/-- A maximal subgroup generated by `n` inner conjugates needs just one more. -/
theorem hasInnerConjugateCover_of_covBy [IsSimpleGroup S]
    (a : MulAut S) (ha : a ≠ 1) {n : ℕ} (s : Fin n → S)
    (hmax : closure (Set.range fun i => conj (s i) * a * (conj (s i))⁻¹) ⋖
      singleInnerExtension a) : HasInnerConjugateCover a (n + 1) := by
  classical
  let H := closure (Set.range fun i => conj (s i) * a * (conj (s i))⁻¹)
  obtain ⟨x, hx⟩ : ∃ x : S, conj x * a * (conj x)⁻¹ ∉ H := by
    by_contra hn
    push Not at hn
    have hh : innerOrbitClosure a ≤ H := (closure_le _).2 (by
      rintro _ ⟨g, rfl⟩
      exact hn g)
    rw [innerOrbitClosure_eq a ha] at hh
    exact hmax.lt.not_ge hh
  let t : Fin (n + 1) → S := Fin.cases x s
  let K := closure (Set.range fun i => conj (t i) * a * (conj (t i))⁻¹)
  have hHK : H ≤ K := closure_mono (by
    rintro _ ⟨i, rfl⟩
    exact ⟨i.succ, rfl⟩)
  have hKP : K ≤ singleInnerExtension a := by
    rw [← innerOrbitClosure_eq a ha]
    exact closure_mono (by
      rintro _ ⟨i, rfl⟩
      exact ⟨t i, rfl⟩)
  have hxK : conj x * a * (conj x)⁻¹ ∈ K := subset_closure ⟨0, rfl⟩
  have he : K = singleInnerExtension a := by
    rcases hmax.eq_or_eq hHK hKP with he | he
    · change K = H at he
      exact False.elim (hx (he ▸ hxK))
    · exact he
  refine ⟨t, ?_⟩
  change (conj : S →* MulAut S).range ≤ K
  rw [he]
  exact le_sup_left

/-- Transport a cover through a genuine group equivalence, including its conjugators. -/
theorem HasInnerConjugateCover.congr {a : MulAut S} {n : ℕ}
    (h : HasInnerConjugateCover a n) (e : S ≃* R) :
    HasInnerConjugateCover (MulAut.congr e a) n := by
  obtain ⟨s, hs⟩ := h
  refine ⟨fun i => e (s i), ?_⟩
  let K := closure (Set.range fun i =>
    conj (e (s i)) * MulAut.congr e a * (conj (e (s i)))⁻¹)
  have hk : closure (Set.range fun i => conj (s i) * a * (conj (s i))⁻¹) ≤
      K.comap (MulAut.congr e).toMonoidHom := by
    apply (closure_le _).2
    rintro _ ⟨i, rfl⟩
    change MulAut.congr e (conj (s i) * a * (conj (s i))⁻¹) ∈ K
    rw [map_mul, map_mul, map_inv, congr_conj]
    exact subset_closure ⟨i, rfl⟩
  rintro _ ⟨x, rfl⟩
  have hx := hk (hs (show conj (e.symm x) ∈ (conj : S →* MulAut S).range from
    ⟨e.symm x, rfl⟩))
  change MulAut.congr e (conj (e.symm x)) ∈ K at hx
  simpa only [congr_conj, e.apply_symm_apply] using hx

/-- The corresponding maximal-subgroup argument inside the simple group itself. -/
theorem hasInnerConjugateCover_conj_of_coatom [IsSimpleGroup S]
    (x : S) (hx : x ≠ 1) {n : ℕ} (s : Fin n → S)
    (hmax : IsCoatom (closure (Set.range fun i => s i * x * (s i)⁻¹))) :
    HasInnerConjugateCover (conj x) (n + 1) := by
  classical
  let H := closure (Set.range fun i => s i * x * (s i)⁻¹)
  have hn : normalClosure ({x} : Set S) = ⊤ := by
    rcases (inferInstance : (normalClosure ({x} : Set S)).Normal).eq_bot_or_eq_top
      with he | he
    · have hm := subset_normalClosure (Set.mem_singleton x)
      rw [he] at hm
      exact False.elim (hx (show x = 1 from hm))
    · exact he
  obtain ⟨y, hy⟩ : ∃ y : S, y * x * y⁻¹ ∉ H := by
    by_contra hn'
    push Not at hn'
    have hle : normalClosure ({x} : Set S) ≤ H := by
      apply (closure_le _).2
      intro b hb
      obtain ⟨z, hz, hzb⟩ := Group.mem_conjugatesOfSet_iff.mp hb
      obtain rfl := Set.mem_singleton_iff.mp hz
      obtain ⟨g, rfl⟩ := isConj_iff.mp hzb
      exact hn' g
    exact hmax.ne_top (top_le_iff.mp (hn ▸ hle))
  let t : Fin (n + 1) → S := Fin.cases y s
  let K := closure (Set.range fun i => t i * x * (t i)⁻¹)
  have hHK : H ≤ K := closure_mono (by
    rintro _ ⟨i, rfl⟩
    exact ⟨i.succ, rfl⟩)
  have hK : K = ⊤ := hmax.lt_iff.mp (lt_of_le_of_ne hHK (by
    intro he
    apply hy
    have hm : y * x * y⁻¹ ∈ K := subset_closure ⟨0, rfl⟩
    rwa [← he] at hm))
  refine ⟨t, ?_⟩
  have he : closure (Set.range fun i => conj (t i) * conj x * (conj (t i))⁻¹) =
      K.map (conj : S →* MulAut S) := by
    rw [MonoidHom.map_closure, ← Set.range_comp]
    congr 2
    funext i
    exact (map_mul conj (t i * x) (t i)⁻¹).trans (by rw [map_mul, map_inv]) |>.symm
  rw [he, hK]
  rintro _ ⟨g, rfl⟩
  exact mem_map_of_mem _ (mem_top g)
end MulAut
