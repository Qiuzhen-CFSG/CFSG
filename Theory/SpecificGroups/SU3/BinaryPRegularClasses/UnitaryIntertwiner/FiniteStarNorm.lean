module

public import Mathlib.Algebra.Star.Subalgebra
public import Mathlib.RingTheory.Nilpotent.Basic
public import Mathlib.Data.Nat.Factorization.Basic
public import Mathlib.Algebra.CharP.Two
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Algebra.CharP.Algebra
public import Mathlib.Algebra.CharP.Lemmas
import Mathlib.Tactic.Ring

/-!
# Norms of self-adjoint units in finite binary algebras

A scalar of trace one makes every self-adjoint unit in a finite commutative
ring of characteristic two a norm. The two-primary part is handled by
`u = 1 + t(a + 1)`: its norm differs from `a` by a square in the nilpotent
ideal, so the correction reduces the two-power exponent. The odd part is
handled by powers. No odd-order assumption on the form ratio is needed.

Applying this inside the star algebra generated by a self-adjoint unit
produces a norm preimage commuting with every element that commutes with
the original unit. This supplies the polar correction for finite unitary
intertwiners; source context is GLS III, Section 2.8.
-/

open scoped IsMulCommutative
namespace Theory.SpecificGroups.SU3.BinaryPRegularClasses.UnitaryIntertwiner
variable {R : Type*} [CommRing R] [StarRing R] [CharP R 2]

private theorem norm_approx (t a : R) (ht : star t + t = 1) (ha : star a = a) :
    star (1 + t * (a + 1)) * (1 + t * (a + 1)) =
      a + (star t * t) * (a + 1)^2 := by
  simp only [star_add, star_one, star_mul, ha]
  calc
    (1 + (a + 1) * star t) * (1 + t * (a + 1)) =
        1 + (star t + t) * (a + 1) + (star t * t) * (a + 1)^2 := by ring
    _ = _ := by rw [ht]; simp [CharTwo.add_self_eq_zero, add_left_comm]

private theorem norm_two_power (t : R) (ht : star t + t = 1) (k : ℕ)
    (a : Rˣ) (ha : star a = a) (hp : a ^ (2^k) = 1) :
    ∃ b : Rˣ, star b * b = a := by
  induction k generalizing a with
  | zero =>
    have : a = 1 := by simpa using hp
    exact ⟨1, by simp [this]⟩
  | succ k ih =>
    have hav : star (a : R) = (a : R) := congrArg Units.val ha
    have hnil : ((a : R) + 1) ^ (2^(k+1)) = 0 := by
      rw [add_pow_char_pow, one_pow]
      have hpv := congrArg Units.val hp
      simpa only [Units.val_pow_eq_pow_val, Units.val_one, CharTwo.add_self_eq_zero] using
        congrArg (fun z : R => z + 1) hpv
    have hu : IsUnit (1 + t * ((a : R) + 1)) :=
      (show IsNilpotent (t * ((a : R) + 1)) from
        ⟨2^(k+1), by rw [mul_pow, hnil, mul_zero]⟩).isUnit_one_add
    let u : Rˣ := hu.unit
    have huval : (u : R) = 1 + t * ((a : R) + 1) := hu.unit_spec
    let e : Rˣ := star u * u * a⁻¹
    have he : star e = e := by
      simp only [e, star_mul, star_star, star_inv, ha]
      ac_rfl
    have hep : e ^ (2^k) = 1 := by
      apply Units.ext
      change ((star (u : R) * (u : R)) * ((a⁻¹ : Rˣ) : R)) ^ (2^k) = 1
      rw [huval, norm_approx t _ ht hav, mul_pow, add_pow_char_pow, mul_pow]
      have hz : (((a : R) + 1)^2)^(2^k) = 0 := by
        rw [← pow_mul, show 2 * 2^k = 2^(k+1) by omega]
        exact hnil
      rw [hz, mul_zero, add_zero, ← mul_pow, Units.mul_inv, one_pow]
    obtain ⟨b, hb⟩ := ih e he hep
    refine ⟨u * b⁻¹, ?_⟩
    calc
      star (u * b⁻¹) * (u * b⁻¹) = (star u * u) * (star b * b)⁻¹ := by
        simp only [star_mul, star_inv, mul_inv_rev]
        simp only [mul_comm, mul_left_comm, mul_assoc]
      _ = a := by rw [hb]; dsimp [e]; simp [mul_comm, mul_left_comm, mul_assoc]

/-- Self-adjoint units are norms when the finite binary ring contains a trace-one element. -/
public theorem norm_surjective [Finite R] (t : R) (ht : star t + t = 1)
    (a : Rˣ) (ha : star a = a) : ∃ b : Rˣ, star b * b = a := by
  let : Finite Rˣ := Finite.of_injective Units.val Units.val_injective
  obtain ⟨k, m, hm, hn⟩ := Nat.exists_eq_two_pow_mul_odd (orderOf_pos a).ne'
  obtain ⟨b, hb⟩ := norm_two_power t ht k (a^m) (by rw [star_pow, ha]) (by
    rw [← pow_mul, mul_comm m, ← hn, pow_orderOf_eq_one])
  obtain ⟨r, hr⟩ := hm
  refine ⟨a^(r+1) * b⁻¹, ?_⟩
  calc
    star (a^(r+1) * b⁻¹) * (a^(r+1) * b⁻¹) =
        a^(2*(r+1)) * (star b * b)⁻¹ := by
      rw [mul_comm 2 (r+1), pow_mul, pow_two]
      simp only [star_mul, star_pow, ha, star_inv, mul_inv_rev]
      simp only [mul_comm, mul_left_comm, mul_assoc]
    _ = a := by
      rw [hb, show 2*(r+1) = m+1 by omega, pow_succ]
      simp [mul_comm, mul_assoc]

variable {F A : Type*} [CommRing F] [StarRing F] [Ring A] [StarRing A]
  [Algebra F A] [StarModule F A] [Finite A] [CharP A 2]

/-- A norm preimage may be chosen to preserve every commuting relation of the input. -/
public theorem norm_centralizer (t : F) (ht : star t + t = 1)
    (a : Aˣ) (ha : star a = a) :
    ∃ b : Aˣ, star b * b = a ∧
      ∀ g : A, Commute (a : A) g → Commute (b : A) g := by
  let : Finite Aˣ := Finite.of_injective Units.val Units.val_injective
  have hav : IsSelfAdjoint (a : A) := congrArg Units.val ha
  let : IsStarNormal (a : A) := hav.isStarNormal
  let S := StarAlgebra.adjoin F ({(a : A)} : Set A)
  let x : S := ⟨a, StarAlgebra.subset_adjoin F _ (Set.mem_singleton _)⟩
  have hxp : x ^ orderOf a = 1 := by
    apply Subtype.ext
    exact congrArg Units.val (pow_orderOf_eq_one a)
  have hx : IsUnit x := IsUnit.of_pow_eq_one hxp (orderOf_pos a).ne'
  have hxs : star hx.unit = hx.unit := by
    apply Units.ext
    change star (hx.unit : S) = (hx.unit : S)
    rw [show star (hx.unit : S) = star x by rw [hx.unit_spec], hx.unit_spec]
    exact Subtype.ext hav
  have htS : star (algebraMap F S t) + algebraMap F S t = 1 := by
    rw [← algebraMap_star_comm, ← map_add, ht, map_one]
  let : CharP S 2 := S.toSubalgebra.val.toRingHom.charP Subtype.val_injective 2
  obtain ⟨b, hb⟩ := norm_surjective (R := S) (algebraMap F S t) htS hx.unit hxs
  let c : Aˣ := Units.map S.toSubalgebra.val.toMonoidHom b
  refine ⟨c, ?_, ?_⟩
  · apply Units.ext
    have he := congrArg (fun u : Sˣ => (u.val : A)) hb
    change star (c : A) * (c : A) = (a : A)
    exact he.trans (congrArg Subtype.val hx.unit_spec)
  · intro g hg
    have hc : (c : A) ∈ Algebra.adjoin F ({(a : A)} : Set A) := by
      have hm := b.val.property
      change (c : A) ∈ Algebra.adjoin F ({(a : A)} ∪ star {(a : A)}) at hm
      simpa only [Set.star_singleton, hav.star_eq, Set.union_self] using hm
    exact (Algebra.commute_of_mem_adjoin_singleton_of_commute hc hg.symm).symm
end Theory.SpecificGroups.SU3.BinaryPRegularClasses.UnitaryIntertwiner
