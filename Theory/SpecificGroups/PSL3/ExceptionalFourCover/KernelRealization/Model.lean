module

public import Theory.SpecificGroups.PSL3.ExceptionalFourCover.Basic
public import Theory.SpecificGroups.PSL3.ExceptionalFourCover.KernelRealization.PermutationPowers
public import Theory.Representation.SL2FourNaturalOrbits.Model
public import Theory.GroupTheory.PerfectTriangle

/-!
# A concrete finite perfect group over matrix PSL₃(4)

Take the subgroup generated by two explicit triples in
`Sym(224) × Sym(224) × SL₃(F₄)`. The permutation coordinates come from two
diagonally related ATLAS fourfold covers; the third coordinate is an actual
determinant-one matrix. The (5,28,3) triangle relations prove perfectness.
Projection to the last factor, followed by field transport and the actual
projective quotient, defines the map used in the exceptional-kernel calculation.

This module asserts neither its kernel nor its order. Those finite calculations
are separate obligations; the numerical GAP discovery is not a Lean premise.
Source: Aschbacher–Smith I.1.3(6), printed p.407, and GLS3 §6.1.
ATLAS data attribution and the reproducible construction are in `Source/`.
-/

@[expose] public section
namespace Matrix.PSL3.ExceptionalFourCover.KernelModel

abbrev F := Representation.SL2FourNatural.F
abbrev SL := SpecialLinearGroup (Fin 3) F
def z : F := ⟨0, 1⟩

def matrixX : SL :=
  ⟨!![z + 1, 0, 1; z + 1, 1, z; 0, z + 1, 0], by decide +kernel⟩

def matrixY : SL :=
  ⟨!![1, 0, 1; 0, z + 1, z; z + 1, 1, z], by decide +kernel⟩

abbrev Ambient := (Equiv.Perm (Fin 224) × Equiv.Perm (Fin 224)) × SL
def x : Ambient := ((x1, x2), matrixX)
def y : Ambient := ((y1, y2), matrixY)

theorem matrixX_fifth : matrixX ^ 5 = 1 := by
  apply Subtype.ext
  decide +kernel

theorem matrixY_seventh : matrixY ^ 7 = 1 := by
  apply Subtype.ext
  decide +kernel

theorem matrixXY_cube : (matrixX * matrixY) ^ 3 = 1 := by
  apply Subtype.ext
  decide +kernel

theorem x_fifth : x ^ 5 = 1 := by
  refine Prod.ext (Prod.ext ?_ ?_) matrixX_fifth
  all_goals exact Equiv.ext (by decide +kernel)

theorem y_twentyEight : y ^ 28 = 1 := by
  have hm : matrixY ^ 28 = 1 := by
    rw [show 28 = 7 * 4 from rfl, pow_mul, matrixY_seventh, one_pow]
  exact Prod.ext (Prod.ext y1_twentyEight y2_twentyEight) hm

theorem xy_cube : (x * y) ^ 3 = 1 := by
  refine Prod.ext (Prod.ext ?_ ?_) matrixXY_cube
  all_goals exact Equiv.ext (by decide +kernel)

def subgroup : Subgroup Ambient := Subgroup.closure ({x, y} : Set Ambient)
abbrev Group := subgroup

instance group_isPerfect : _root_.Group.IsPerfect Group :=
  _root_.Group.isPerfect_closure_pair_of_coprime_triangle x y
    (by decide) (by decide) x_fifth y_twentyEight xy_cube

def generatorX : Group := ⟨x, Subgroup.subset_closure (Set.mem_insert _ _)⟩
def generatorY : Group :=
  ⟨y, Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)⟩

/-- Literal projection to the matrix coordinate. -/
def matrixProjection : Group →* SL :=
  (MonoidHom.snd _ _).comp subgroup.subtype

/-- Projection to matrix PSL after the proved identification of the fields. -/
noncomputable def projection : Group →* PSL3Four.PSL :=
  ((Atlas.fieldEquivPSL 3 Representation.SL2FourNatural.fieldEquiv).toMonoidHom.comp
    (QuotientGroup.mk' (Subgroup.center SL))).comp matrixProjection

theorem matrixProjection_generatorX : matrixProjection generatorX = matrixX := rfl
theorem matrixProjection_generatorY : matrixProjection generatorY = matrixY := rfl

end Matrix.PSL3.ExceptionalFourCover.KernelModel
