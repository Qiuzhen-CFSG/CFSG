module

public import Mathlib.Data.Fintype.CardEmbedding
public import Mathlib.SetTheory.Cardinal.Finite
public import Mathlib.Algebra.Group.Submonoid.Membership
public import Mathlib.Algebra.Group.End

/-!
# Finite monoid covers for the exceptional extension certificate

A finite family containing the identity covers the monoid generated by `gen`
if each product of a generator with a representative reduces to another
representative times a word in `next`. Induction on positive words and an
injection into the product give the cardinality bound. Representatives and
next generators need not lie in the original monoid: an upper bound only
requires the covering direction.

The certificate uses the product of two transformation monoids on 224 points
and one on the 64 column vectors. `Encoding` proves that the actual
permutation/matrix product embeds faithfully in this monoid.
Source application: Aschbacher–Smith I.1.3(6), printed p.407; GLS3 §6.1.
-/

@[expose] public section
namespace Matrix.PSL3.ExceptionalFourCover.KernelModel.OrderCertificate

abbrev M := (Function.End (Fin 224) × Function.End (Fin 224)) × Function.End (Fin 64)

instance : Finite M :=
  inferInstanceAs (Finite (((Fin 224 → Fin 224) × (Fin 224 → Fin 224)) × (Fin 64 → Fin 64)))

/-- Eight-bit entries, reduced into the required finite type. -/
def packed224 (p : Nat) (i : Fin 224) : Fin 224 :=
  ⟨(p >>> (8 * i.val)) % 256 % 224, Nat.mod_lt _ (by decide)⟩

/-- Six-bit entries for the 64 column vectors. -/
def packed64 (p : Nat) (i : Fin 64) : Fin 64 :=
  ⟨(p >>> (6 * i.val)) % 64, Nat.mod_lt _ (by decide)⟩

def word {T : Type*} [Monoid T] {n : Nat} (gen : Fin n → T) (w : List (Fin n)) : T :=
  (w.map gen).prod

theorem word_mem {T : Type*} [Monoid T] {n : Nat} (gen : Fin n → T) (w : List (Fin n)) :
    word gen w ∈ Submonoid.closure (Set.range gen) := by
  induction w with
  | nil => exact (Submonoid.closure _).one_mem
  | cons i w ih =>
    exact (Submonoid.closure _).mul_mem (Submonoid.subset_closure ⟨i, rfl⟩) ih

theorem closure_card_le {T : Type*} [Monoid T] [Finite T] {n m p : Nat}
    (gen : Fin n → T) (next : Fin p → T) (rep : Fin m → T)
    (act : Fin n → Fin m → Fin m) (factor : Fin n → Fin m → List (Fin p))
    (base : Fin m) (hbase : rep base = 1)
    (hstep : ∀ i r, gen i * rep r = rep (act i r) * word next (factor i r)) :
    Nat.card (Submonoid.closure (Set.range gen)) ≤
      m * Nat.card (Submonoid.closure (Set.range next)) := by
  classical
  let H := Submonoid.closure (Set.range gen)
  let K := Submonoid.closure (Set.range next)
  have hd : ∀ (h : T), h ∈ H → ∃ b : Fin m × K, rep b.1 * (b.2 : T) = h := by
    intro h hh
    induction hh using Submonoid.closure_induction_left with
    | one => exact ⟨(base, 1), by simp [hbase]⟩
    | mul_left a ha b hb ih =>
      obtain ⟨i, rfl⟩ := ha
      obtain ⟨⟨r, k⟩, hk⟩ := ih
      refine ⟨(act i r, ⟨word next (factor i r) * (k : T),
        K.mul_mem (word_mem next _) k.property⟩), ?_⟩
      dsimp only
      rw [← mul_assoc, ← hstep, mul_assoc, hk]
  have hd' (h : H) := hd h h.property
  choose f hf using hd'
  have hi : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    exact (hf a).symm.trans ((congrArg (fun c : Fin m × K => rep c.1 * (c.2 : T)) hab).trans (hf b))
  simpa only [Nat.card_prod, Nat.card_fin] using Nat.card_le_card_of_injective f hi


/-- Assemble bounded computational checks into a universal finite statement. -/
theorem forall_of_blocks {n k : Nat} [NeZero n] (P : Fin n → Prop)
    (hk : n ≤ 8 * k)
    (h : ∀ b : Fin k, ∀ r : Fin 8, P (Fin.ofNat n (8 * b.val + r.val)))
    (i : Fin n) : P i := by
  have hb : i.val / 8 < k := by have := i.isLt; omega
  have hh := h ⟨i.val / 8, hb⟩ ⟨i.val % 8, Nat.mod_lt _ (by decide)⟩
  have hi : Fin.ofNat n (8 * (i.val / 8) + i.val % 8) = i := by
    apply Fin.ext
    change (8 * (i.val / 8) + i.val % 8) % n = i.val
    have he : 8 * (i.val / 8) + i.val % 8 = i.val := by omega
    rw [he, Nat.mod_eq_of_lt i.isLt]
  exact hi ▸ hh

end Matrix.PSL3.ExceptionalFourCover.KernelModel.OrderCertificate
