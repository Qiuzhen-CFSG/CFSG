module

public import Theory.SpecificGroups.PSL3.ExceptionalFourCover.KernelBound.TwoGenerators.PresentationOrder.Checked
public import Theory.SpecificGroups.PSL3.ExceptionalFourCover.KernelBound.TwoGenerators.PresentationOrder.Shape

/-!
# Finiteness and order bound for the four-relator presentation of PSL₃(4)

The subgroup generated by `a` is finite of order at most five. A checked
Todd–Coxeter trace supplies 4032 right representatives modulo left multiplication
by this subgroup, including every signed generator transition. Word induction
therefore gives a surjection from the subgroup times `Fin 4032` onto the literal
presented group. This proves finiteness and the bound 5 · 4032 = 20160.

All 49400 retained deductions and 16128 output transitions are checked by Lean's
kernel. The enumerator is an untrusted proof producer; neither a permutation
action nor an externally reported order is used as mathematical evidence.
See `PresentationOrder/source/README.md` for reproduction and measurements.

Source: Campbell, Havas, Ramsay and Robertson, *Nice efficient presentations for
all small simple groups and their covers*, LMS J. Comput. Math. 7 (2004),
Table 2 and §5.11, https://staff.itee.uq.edu.au/havas/2004chrr.pdf.
-/

public section
namespace Matrix.PSL3.ExceptionalFourCover.TwoGeneratorPresentation
namespace OrderCertificate
open Subgroup.CosetWordCertificate

private theorem transitions (i : Fin 4032) (a : Fin 4) :
    Holds smallSubgroup generator (definitions.repr generator)
      ⟨repCode i.val, [decode a.val], repCode (destination (4*i.val+a.val)).val⟩ := by
  have hs := (factBEq_eq_true_iff _ _).mp (all_shapes (4*i.val+a.val) (by omega))
  have hd : (4*i.val+a.val) / 4 = i.val := by omega
  have hm : (4*i.val+a.val) % 4 = a.val := by omega
  change facts (output (4*i.val+a.val)) = _ at hs
  rw [hd, hm] at hs
  rw [← hs]
  exact all_hold _ (output_lt _)

private theorem decode_even (a : Fin 2) : decode (2*a.val) = (a, true) := by
  apply Prod.ext
  · apply Fin.ext
    dsimp [decode]
    omega
  · simp [decode]

private theorem decode_odd (a : Fin 2) : decode (2*a.val+1) = (a, false) := by
  apply Prod.ext
  · apply Fin.ext
    dsimp [decode]
    omega
  · simp [decode, Nat.add_mod]

/-- Certified coset witnesses for both distinguished generators and their inverses. -/
def presentationCover : Subgroup.GeneratorCosetCover smallSubgroup generator (Fin 4032) where
  repr i := definitions.repr generator (repCode i.val)
  initial := 0
  initial_eq := by
    have hr : repCode 0 = 0 := by decide +kernel
    change definitions.repr generator (repCode 0) = 1
    rw [hr]
    exact definitions.repr_zero generator
  step i a := by
    obtain ⟨h, hh⟩ := transitions i ⟨2*a.val, by omega⟩
    refine ⟨h, destination (4*i.val+2*a.val), ?_⟩
    simpa [decode_even] using hh
  inv_step i a := by
    obtain ⟨h, hh⟩ := transitions i ⟨2*a.val+1, by omega⟩
    refine ⟨h, destination (4*i.val+(2*a.val+1)), ?_⟩
    simpa [decode_odd] using hh

end OrderCertificate

/-- The literal published four-relator group is finite, of order at most 20160. -/
theorem finite_and_card_le : Finite Presentation ∧ Nat.card Presentation ≤ 20160 := by
  let : Finite OrderCertificate.smallSubgroup := OrderCertificate.small_bound.1
  have h := OrderCertificate.presentationCover.finite_card_le
    (PresentedGroup.closure_range_of relators)
  refine ⟨h.1, h.2.trans ?_⟩
  simpa only [Nat.card_fin] using Nat.mul_le_mul_right 4032 OrderCertificate.small_bound.2

end Matrix.PSL3.ExceptionalFourCover.TwoGeneratorPresentation
