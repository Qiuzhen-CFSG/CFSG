module

public import Theory.SpecificGroups.PSL3.ExceptionalFourCover.KernelBound.TwoGenerators.Presentation
public import Theory.SpecificGroups.PSL3.ExceptionalFourCover.KernelBound.TwoGenerators.PresentationOrder.Base
public import Mathlib.Data.ZMod.QuotientGroup

/-! The actual presentation relations validate all certificate loops. The subgroup
generated by the first marked generator is finite of order at most five.
Source: Campbell–Havas–Ramsay–Robertson (2004), Table 2 and §5.11. -/

@[expose] public section
namespace Matrix.PSL3.ExceptionalFourCover.TwoGeneratorPresentation.OrderCertificate
open Subgroup.CosetWordCertificate

def generator : Fin 2 → Presentation := PresentedGroup.of

def smallSubgroup : Subgroup Presentation := Subgroup.zpowers (generator 0)

theorem small_bound : Finite smallSubgroup ∧ Nat.card smallSubgroup ≤ 5 := by
  have hp : generator 0 ^ 5 = 1 := generator_pow_five 0
  have hfin : IsOfFinOrder (generator 0) :=
    isOfFinOrder_iff_pow_eq_one.mpr ⟨5, by decide, hp⟩
  refine ⟨hfin.finite_zpowers.to_subtype, ?_⟩
  rw [smallSubgroup, Nat.card_zpowers]
  exact orderOf_le_of_pow_eq_one (by decide) hp

def sourceRelator : Fin 4 → Subgroup.CosetWordCertificate.Word (Fin 2)
  | 0 => [decode 0, decode 0, decode 0, decode 0, decode 0]
  | 1 => [decode 2, decode 2, decode 2, decode 2, decode 2]
  | 2 => [decode 0, decode 2, decode 0, decode 2, decode 0, decode 2]
  | 3 => [decode 0, decode 0, decode 3, decode 3, decode 1, decode 3,
      decode 0, decode 3, decode 3, decode 0, decode 2, decode 1, decode 3]

theorem sourceRelator_valid (r : Fin 4) : eval generator (sourceRelator r) = 1 := by
  have hm (w : TwoGeneratorPresentation.Word) (hw : w ∈ relators) :
      (PresentedGroup.mk relators) w = 1 := PresentedGroup.one_of_mem hw
  have h0 := hm (a^5) (by simp [relators])
  have h1 := hm (b^5) (by simp [relators])
  have h2 := hm ((a*b)^3) (by simp [relators])
  have h3 := hm mixed (by simp [relators])
  simp only [map_pow, map_mul, map_inv, mixed] at h0 h1 h2 h3
  fin_cases r <;>
    simp only [sourceRelator, eval_cons, eval_nil, decode, generator] <;>
    simp [a, b, pow_succ, mul_assoc] at h0 h1 h2 h3 ⊢ <;>
    assumption

def allowed (x : Letter (Fin 2)) : Bool := x.1 == 0

theorem allowed_mem (x : Letter (Fin 2)) (hx : allowed x = true) :
    eval generator [x] ∈ smallSubgroup := by
  have hx0 : x.1 = 0 := by simpa [allowed] using hx
  rw [eval_letter, hx0]
  split
  · exact Subgroup.mem_zpowers _
  · exact Subgroup.inv_mem _ (Subgroup.mem_zpowers _)

end Matrix.PSL3.ExceptionalFourCover.TwoGeneratorPresentation.OrderCertificate
