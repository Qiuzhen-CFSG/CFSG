module
public import Theory.SpecificGroups.PSL3.LinearThreeLocalStructure

/-!
# Movement of the affine translation plane

Upper and lower transvections express the two coordinates of every translation
as action commutators. Thus the whole translation plane is moved over every
field, including the binary field. Transport through the actual affine marking
identifies the same commutator in the point local of SL₃.

The consumer is the original secondary root plane in Aschbacher--Smith,
4.3.11--16, printed pp.617--618. This calculation concerns the secondary
component's two-core, not a larger ambient radical.
-/

public section
open Subgroup Matrix
open scoped MatrixGroups commutatorElement
namespace Matrix.SL2
variable (F : Type*) [Field F]
theorem translations_moved : ⁅translations F, (⊤ : Subgroup (Affine F))⁆ = translations F := by
  apply le_antisymm (le_normalizer_iff_commutator_le_left.mp le_normalizer_of_normal)
  intro x hx
  obtain ⟨w,rfl⟩ := (range_inl_eq_translations F).ge hx
  have hc (g : SL(2,F)) (v : Multiplicative (Fin 2 → F)) :
      (SemidirectProduct.inl (naturalAction F g v * v⁻¹) : Affine F) ∈
        ⁅translations F, (⊤ : Subgroup (Affine F))⁆ := by
    have he : (SemidirectProduct.inl (naturalAction F g v * v⁻¹) : Affine F) =
        ⁅(SemidirectProduct.inr g : Affine F), SemidirectProduct.inl v⁆ := by
      rw [commutatorElement_def, conjugate_inl, map_mul, map_inv]
      rfl
    rw [he, commutator_comm]
    exact commutator_mem_commutator (mem_top _) ((range_inl_eq_translations F).le ⟨v,rfl⟩)
  let a : SL(2,F) := ⟨!![1,1;0,1], by simp [det_fin_two]⟩
  let b : SL(2,F) := ⟨!![1,0;1,1], by simp [det_fin_two]⟩
  let v : Multiplicative (Fin 2 → F) := Multiplicative.ofAdd ![0,w.toAdd 0]
  let z : Multiplicative (Fin 2 → F) := Multiplicative.ofAdd ![w.toAdd 1,0]
  have he : (naturalAction F a v * v⁻¹) * (naturalAction F b z * z⁻¹) = w := by
    apply Multiplicative.toAdd.injective
    change (a.val.mulVec v.toAdd + -v.toAdd) + (b.val.mulVec z.toAdd + -z.toAdd) = w.toAdd
    ext i
    fin_cases i <;> simp [a,b,v,z,Matrix.vecHead,Matrix.vecTail,Function.comp_def]
  rw [←he,map_mul]
  exact (⁅translations F, (⊤ : Subgroup (Affine F))⁆).mul_mem (hc a v) (hc b z)
end Matrix.SL2

namespace Matrix.PSL3.LinearThree
variable (F : Type*) [Field F] [Finite F] [CharP F 2]
/-- The intrinsic two-core of the point local is generated by its commutators. -/
theorem pointLocalSL_core_moved :
    ⁅pCore 2 (pointLocalSL F), (⊤ : Subgroup (pointLocalSL F))⁆ = pCore 2 (pointLocalSL F) := by
  apply Subgroup.map_injective (f := (pointLocalAffineEquiv F).toMonoidHom)
    (pointLocalAffineEquiv F).injective
  rw [map_commutator, pCore_map_iso, map_top_of_surjective _ (pointLocalAffineEquiv F).surjective,
    Matrix.SL2.affine_twoCore_eq, Matrix.SL2.translations_moved]
end Matrix.PSL3.LinearThree
