module

public import Theory.SpecificGroups.PSL3.OuterSolvable.Actions
public import Theory.SpecificGroups.PSL3.OuterSolvable.OddPrimeCoverage

/-!
# Standard automorphism coverage for Sylow-fixing actions on PSL₃

Over an odd prime field every automorphism of the actual quotient
`SL₃/Z(SL₃)` belongs to the subgroup generated by linear, field and graph
actions. In particular this holds for an involutory automorphism fixing a
Sylow two-subgroup when the prime is five modulo eight.

The existing opposite-unipotent normalization uses Sylow conjugacy and an
explicit open-cell matrix correction. The Borel normalizers then recover the
three diagonal involutions, whose centralizers recover the six root groups
up to the opposition graph action. Prime-field root rigidity supplies the
last diagonal correction. We assemble these geometric results directly,
without the extra simplicity and nonsolvability assumptions of the older
coverage wrapper.

Source: the generation assertion in GLS3, Theorem 2.5.12(a), with the concrete
matrix descriptions in §2.7, `refs/KGroup/GLS3/chapter2.tex`, lines 1111–1115.
The local specialization is used for Aschbacher–Smith F.6.18(10)–(11), printed
pp.309–310, in the component argument of 15.4.18, printed pp.1162–1163 of
`refs/quasithin.pdf`. The independent obstruction for standard Sylow-fixing
actions and its ambient assembly remain with their respective consumers.
-/

public section

open scoped MatrixGroups
open Matrix.PSL3.OuterSolvable Matrix.PSL3.OuterSolvable.OddPrimeCoverage

namespace Matrix.PSL3.SylowFixedActions

/-- Intrinsic odd-prime coverage, with every geometric premise discharged and
no assumption about simplicity, solvability, or a lift of the automorphism. -/
theorem standard_eq_top_of_odd_prime_card (F : Type*) [Field F] [Finite F]
    {p : ℕ} (hp : p.Prime) (hodd : Odd p) (hF : Nat.card F = p) :
    standard F = ⊤ := by
  have h2 : (2 : F) ≠ 0 := by
    let := Fintype.ofFinite F
    intro hz
    have hc : ringChar F = 2 := CharP.ringChar_of_prime_eq_zero Nat.prime_two hz
    have he := FiniteField.even_card_iff_char_two.mp hc
    rw [← Nat.card_eq_fintype_card, hF] at he
    have ho := Nat.odd_iff.mp hodd
    omega
  apply standard_eq_top_of_geometric_normalization hp hF
    (exists_inner_preserves_pair_of_prime_card F hp hF)
  intro α hα
  exact exists_oppositionGraph_of_sign_geometry α hα
    (exists_sign_permutation hp hF h2 α hα)
    (upper_inf_centralizer_sign h2) (lower_inf_centralizer_sign h2)
    positiveRoot_central_iff

/-- The precise local coverage input for the linear-three fixed-action
obstruction. The stronger coverage theorem makes the action restrictions
unnecessary for this conclusion. -/
theorem mem_standard_of_involutive_of_fixes_sylow
    (p : ℕ) [Fact p.Prime] (hp : p % 8 = 5)
    (P : Sylow 2 PSL(3, ZMod p)) (α : MulAut PSL(3, ZMod p))
    (_hinv : α ^ 2 = 1) (_hfixed : ∀ x : P, α x = x) :
    α ∈ standard (ZMod p) := by
  have hodd : Odd p := Nat.odd_iff.mpr (by omega)
  rw [standard_eq_top_of_odd_prime_card (ZMod p) (Fact.out : p.Prime) hodd
    (by simp)]
  exact Subgroup.mem_top α

end Matrix.PSL3.SylowFixedActions
