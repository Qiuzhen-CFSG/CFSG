module
public import Theory.SpecificGroups.PSL3.SmallCompletion.AffinePoints
/-!
# Generating the line parabolic by its Borel and reflection

A single elementary row operation reduces any line-parabolic matrix outside
its Borel into the other Bruhat cell. The calculation takes place in SL₃
before projection, retaining every central scalar.

Source: the rank-one Bruhat decomposition used in Aschbacher–Smith F.4.8.
-/

@[expose] public noncomputable section
open Matrix Subgroup
open scoped MatrixGroups
open Matrix.PSL3 Matrix.PSL3.LinearThree Matrix.PSL3.CartanActions Matrix.PSL3.SmallCompletion
namespace Matrix.PSL3.SmallCompletion.AffinePoints
variable (F : Type*) [Field F] [Finite F] [CharP F 2]
/-- The line parabolic is generated by its whole Borel and the marked reflection. -/
theorem line_le_of_borel_reflection (H : Subgroup PSL(3,F)) (hB : borel F ≤ H)
    (hw : reflection F true ∈ H) : lineParabolic F ≤ H := by
  rintro _ ⟨g,hg,rfl⟩
  obtain ⟨h20,h21⟩ := (mem_lineParabolicSL_iff F g).mp hg
  by_cases h10 : g.val 1 0=0
  · exact hB (mem_map_of_mem _ ((mem_borelSL_iff F g).mpr ⟨h10,h20,h21⟩))
  · let a := g.val 0 0 / g.val 1 0
    let u : SL(3,F) := ⟨!![1,a,0;0,1,0;0,0,1],by simp [Matrix.det_fin_three]⟩
    have hu : u ∈ borelSL F := (mem_borelSL_iff F u).mpr ⟨rfl,rfl,rfl⟩
    have hb : reflectionSL F true*u*g∈borelSL F := by
      rw [mem_borelSL_iff]
      change (((reflectionSL F true).val*u.val)*g.val) 1 0=0 ∧
        (((reflectionSL F true).val*u.val)*g.val) 2 0=0 ∧
        (((reflectionSL F true).val*u.val)*g.val) 2 1=0
      have ha : a*g.val 1 0=g.val 0 0 := div_mul_cancel₀ _ h10
      simp [reflectionSL,u,Matrix.mul_apply,Fin.sum_univ_three,h20,h21,ha,CharTwo.add_self_eq_zero]
    have hbH := hB (mem_map_of_mem (projection F) hb)
    have huH := hB (mem_map_of_mem (projection F) hu)
    have he : projection F g=(projection F u)⁻¹*(reflection F true)⁻¹*
        projection F (reflectionSL F true*u*g) := by
      rw [map_mul,map_mul]
      change projection F g=(projection F u)⁻¹*(projection F (reflectionSL F true))⁻¹*
        (projection F (reflectionSL F true)*projection F u*projection F g)
      group
    rw [he]
    exact H.mul_mem (H.mul_mem (H.inv_mem huH) (H.inv_mem hw)) hbH
end Matrix.PSL3.SmallCompletion.AffinePoints
