module

public import Theory.SpecificGroups.PSL3.SmallCompletion.BorelFourOppositeCorrection
public import Theory.GroupTheory.Amalgam.RestrictionProduct

/-!
# Literal whole-Borel inclusions in the two field-four endpoints

The original projective Borel is generated by its original unipotent map and
the full cubic torus. Both are retained in the two existing affine endpoints.
Consequently those local endpoints are the full parabolics at field four.
-/

public noncomputable section
open Subgroup Matrix
open scoped MatrixGroups
namespace Matrix.PSL3.SmallCompletion
open Matrix.PSL3.LinearThree Matrix.PSL3.CartanActions
open Matrix.PSL3.LinearAmbientGeometry Matrix.PSL3Even.UnipotentGeometry
open Representation.SL2FourNatural

/-- Factor every original Borel element through the literal U and full T. -/
theorem borel_four_factorization (b : borel F) :
    ∃ (u : U F) (t : Fˣ), b=borelUnipotent F u*simultaneousTorus F t := by
  obtain ⟨d,x,hx,hb⟩ := BorelQuotient.borel_factorization F b b.property
  obtain ⟨u,hu⟩ := (projective_range F).ge hx
  have ht : (⟨torusMap F d,torus_le_borel F ⟨d,rfl⟩⟩ : borel F)∈borelTorus F :=
    ⟨d,rfl⟩
  rw [←simultaneousTorus_range F (by rw [Nat.card_eq_fintype_card,card_field])] at ht
  obtain ⟨t,ht⟩ := ht
  refine ⟨u,t,Subtype.ext ?_⟩
  change b.val=projective F u*(simultaneousTorus F t : PSL(3,F))
  rw [hu,congrArg Subtype.val ht]
  exact hb

/-- The whole original Borel lies in the actual line endpoint. -/
theorem borel_four_le_lineLocal : borel F≤lineLocal F := by
  intro b hb
  obtain ⟨u,t,he⟩ := borel_four_factorization ⟨b,hb⟩
  have hv := congrArg Subtype.val he
  change b=projective F u*(simultaneousTorus F t : PSL(3,F)) at hv
  rw [hv,←lineUnipotent_val,←lineTorus_val]
  exact (lineLocal F).mul_mem (lineUnipotent u).property (lineTorus t).property

/-- The whole original Borel lies in the actual point endpoint. -/
theorem borel_four_le_pointLocal : borel F≤pointLocal F := by
  intro b hb
  obtain ⟨u,t,he⟩ := borel_four_factorization ⟨b,hb⟩
  have hv := congrArg Subtype.val he
  change b=projective F u*(simultaneousTorus F t : PSL(3,F)) at hv
  rw [hv,←pointUnipotent_val,←pointTorus_val]
  exact (pointLocal F).mul_mem (pointUnipotent u).property (pointTorus t).property

/-- At field four the existing local endpoints are the entire parabolics. -/
theorem field_four_parabolics : pointParabolic F=pointLocal F ∧
    lineParabolic F=lineLocal F := by
  constructor
  · rw [pointParabolic_eq_sup,sup_eq_left.mpr borel_four_le_pointLocal]
  · rw [lineParabolic_eq_sup,sup_eq_left.mpr borel_four_le_lineLocal]

/-- The actual point endpoint inclusion of the full common Borel. -/
@[expose] def pointBorelInclusion : borel F →* pointLocal F :=
  inclusion borel_four_le_pointLocal

/-- The actual line endpoint inclusion of the full common Borel. -/
@[expose] def lineBorelInclusion : borel F →* lineLocal F :=
  inclusion borel_four_le_lineLocal

/-- The native whole-Borel amalgam, retaining its literal two inclusions. -/
@[expose] def fieldFourBorelAmalgam :
    Theory.GroupTheory.RankTwoAmalgam (pointLocal F) (borel F) (lineLocal F) :=
  ⟨pointBorelInclusion,lineBorelInclusion⟩

end Matrix.PSL3.SmallCompletion
