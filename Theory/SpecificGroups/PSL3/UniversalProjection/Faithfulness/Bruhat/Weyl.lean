module

public import Theory.SpecificGroups.PSL3.UniversalProjection.Faithfulness.Bruhat.Tori

/-!
# The Weyl kernel in degree three

The literal torus subgroup is normal in the subgroup generated by the Weyl
words. Modulo the torus, parameters disappear, the two simple lifts become
involutions, and the signed conjugation formulas give the braid relation.
An elementary six-word collection then supplies representatives
`1, a, b, ab, ba, aba`. Every nonidentity representative has a zero diagonal
matrix entry. Left multiplication by a torus matrix preserves that zero,
so a matrix-kernel element must lie in the identity torus coset.

The lifts themselves need not be involutions: their inverse differs by the
torus word at `-1`. The proof uses the quotient only inside the literal
Weyl subgroup, and never assumes faithfulness of the presentation.

Source: Steinberg, *Lectures on Chevalley Groups*, §3, Lemma 22, printed
pp.32–33; §6, Lemmas 37–38 and Theorem 8(b), printed pp.69–71
(`refs/KGroup/GLS3/Chapter2St1.tex`); GLS3 §2.9, printed pp.97–98.
-/

@[expose] public section

open Theory.SpecificGroups.LinearHigher SteinbergWords
open Matrix.SpecialLinearGroup
namespace Matrix.PSL3.UniversalProjection.Faithfulness
variable {F : Type*} [Field F]

private theorem weyl_parameter (i j : Fin 3) (hij : i ≠ j) (t : Fˣ) :
    weylWord generator i j hij t =
      torus i j hij t * weylWord generator i j hij 1 := by
  simp [torus, torusWord, ← weylWord_inv generator_relations, mul_assoc]

private theorem conj_torus_mem (i j : Fin 3) (hij : i ≠ j)
    {g : SteinbergGroup 3 F} (hg : g ∈ torusSubgroup F) :
    MulAut.conj (weylWord generator i j hij 1) g ∈ torusSubgroup F := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨r, t, rfl⟩ := hg
    rw [weyl_conj_torus_formula]
    exact (torusSubgroup F).mul_mem
      ((torusSubgroup F).inv_mem (torus_mem_torusSubgroup _ _ _ _))
      (torus_mem_torusSubgroup _ _ _ _)
  | one => simp
  | mul g h _ _ ihg ihh => simpa using (torusSubgroup F).mul_mem ihg ihh
  | inv g _ ih => simpa only [map_inv] using (torusSubgroup F).inv_mem ih

private theorem weyl_one_normalizes (i j : Fin 3) (hij : i ≠ j) :
    weylWord generator i j hij (1 : Fˣ) ∈ Subgroup.normalizer (torusSubgroup F) := by
  rw [Subgroup.mem_normalizer_iff]
  intro g
  constructor
  · exact conj_torus_mem i j hij
  · intro hg
    have hi : (weylWord generator i j hij (1 : Fˣ))⁻¹ =
        torus i j hij (-1) * weylWord generator i j hij 1 := by
      rw [weylWord_inv generator_relations, weyl_parameter i j hij (-1)]
    have he : MulAut.conj (weylWord generator i j hij (1 : Fˣ))⁻¹
        (MulAut.conj (weylWord generator i j hij 1) g) = g := by
      simp [MulAut.conj_apply, mul_assoc]
    rw [← he, hi]
    simpa [MulAut.conj_apply, mul_inv_rev, mul_assoc] using
      (torusSubgroup F).mul_mem
        ((torusSubgroup F).mul_mem (torus_mem_torusSubgroup i j hij (-1))
          (conj_torus_mem i j hij hg))
        ((torusSubgroup F).inv_mem (torus_mem_torusSubgroup i j hij (-1)))

private theorem weyl_normalizes : weylSubgroup F ≤ Subgroup.normalizer (torusSubgroup F) := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨r, t, rfl⟩
  rw [weyl_parameter r.val.1 r.val.2 r.property t]
  apply Subgroup.mul_mem
  · exact (torusSubgroup F).le_normalizer
      (torus_mem_torusSubgroup r.val.1 r.val.2 r.property t)
  · exact weyl_one_normalizes (F := F) r.val.1 r.val.2 r.property

private theorem weyl_reverse (i j : Fin 3) (hij : i ≠ j) :
    weylWord generator j i hij.symm (1 : Fˣ) =
      (weylWord generator i j hij 1)⁻¹ := by
  have hc : MulAut.conj (weylWord generator i j hij (1 : Fˣ))
      (weylWord generator i j hij 1) = weylWord generator j i hij.symm (-1) := by
    conv_lhs => arg 2; unfold weylWord
    rw [map_mul, map_mul]
    rw [weylWord_conj_root generator_relations (by decide),
      weylWord_conj_opposite_root generator_relations (by decide)]
    simp [weylWord]
  have he : weylWord generator i j hij (1 : Fˣ) =
      weylWord generator j i hij.symm (-1) := by
    simpa [MulAut.conj_apply] using hc
  rw [he, weylWord_inv generator_relations, neg_neg]

private theorem conj_weyl_a_b :
    MulAut.conj (weylWord generator (0 : Fin 3) 1 (by decide) (1 : Fˣ))
      (weylWord generator (1 : Fin 3) 2 (by decide) 1) =
      weylWord generator (0 : Fin 3) 2 (by decide) 1 := by
  conv_lhs => arg 2; unfold weylWord
  rw [map_mul, map_mul,
    weylWord_conj_other_outgoing generator_relations (0 : Fin 3) 1 2 (by decide) (by decide) (by decide),
    weylWord_conj_incoming generator_relations (0 : Fin 3) 1 2 (by decide) (by decide) (by decide)]
  simp [weylWord]

private theorem conj_weyl_b_a :
    MulAut.conj (weylWord generator (1 : Fin 3) 2 (by decide) (1 : Fˣ))
      (weylWord generator (0 : Fin 3) 1 (by decide) 1) =
      weylWord generator (0 : Fin 3) 2 (by decide) (-1) := by
  conv_lhs => arg 2; unfold weylWord
  rw [map_mul, map_mul,
    weylWord_conj_other_incoming generator_relations (1 : Fin 3) 2 0 (by decide) (by decide) (by decide),
    weylWord_conj_outgoing generator_relations (1 : Fin 3) 2 0 (by decide) (by decide) (by decide)]
  simp [weylWord]

private instance torus_normal_in_weyl :
    ((torusSubgroup F).subgroupOf (weylSubgroup F)).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer weyl_normalizes

private abbrev WeylQuotient (F : Type*) [Field F] :=
  (weylSubgroup F) ⧸ (torusSubgroup F).subgroupOf (weylSubgroup F)

private def quotientMap : weylSubgroup F →* WeylQuotient F :=
  QuotientGroup.mk' _

private def liftW (i j : Fin 3) (hij : i ≠ j) (t : Fˣ) : weylSubgroup F :=
  ⟨weylWord generator i j hij t, weylWord_mem_weyl i j hij t⟩

private theorem quotient_parameter (i j : Fin 3) (hij : i ≠ j) (t : Fˣ) :
    quotientMap (liftW i j hij t) = quotientMap (liftW i j hij 1) := by
  apply QuotientGroup.eq_iff_div_mem.mpr
  change weylWord generator i j hij t / weylWord generator i j hij 1 ∈ torusSubgroup F
  rw [div_eq_mul_inv, weyl_parameter i j hij t, mul_inv_cancel_right]
  exact torus_mem_torusSubgroup i j hij t

private theorem quotient_involution (i j : Fin 3) (hij : i ≠ j) :
    (quotientMap (liftW i j hij (1 : Fˣ)))⁻¹ = quotientMap (liftW i j hij 1) := by
  rw [← map_inv]
  have hi : (liftW i j hij (1 : Fˣ))⁻¹ = liftW i j hij (-1) := by
    apply Subtype.ext
    exact weylWord_inv generator_relations i j hij 1
  rw [hi, quotient_parameter]

private theorem quotient_reverse (i j : Fin 3) (hij : i ≠ j) :
    quotientMap (liftW j i hij.symm (1 : Fˣ)) = quotientMap (liftW i j hij 1) := by
  rw [← quotient_involution i j hij, ← map_inv]
  congr 1
  exact Subtype.ext (weyl_reverse i j hij)

private abbrev liftA : weylSubgroup F := liftW 0 1 (by decide) 1
private abbrev liftB : weylSubgroup F := liftW 1 2 (by decide) 1

private theorem quotient_third :
    quotientMap (liftW 0 2 (by decide) (1 : Fˣ)) =
      quotientMap (liftA : weylSubgroup F) * quotientMap liftB * quotientMap liftA := by
  have he : liftW 0 2 (by decide) (1 : Fˣ) = liftA * liftB * liftA⁻¹ :=
    Subtype.ext (conj_weyl_a_b.symm)
  rw [he, map_mul, map_mul, map_inv, quotient_involution]

private theorem quotient_braid :
    quotientMap (liftA : weylSubgroup F) * quotientMap liftB * quotientMap liftA =
      quotientMap liftB * quotientMap liftA * quotientMap liftB := by
  have he : liftW 0 2 (by decide) (-1 : Fˣ) = liftB * liftA * liftB⁻¹ :=
    Subtype.ext (conj_weyl_b_a.symm)
  have hq := congrArg quotientMap he
  rw [quotient_parameter, quotient_third, map_mul, map_mul, map_inv,
    quotient_involution] at hq
  exact hq

private theorem six_words {G : Type*} [Group G] (a b : G)
    (ha : a⁻¹ = a) (hb : b⁻¹ = b) (hab : a * b * a = b * a * b)
    {g : G} (hg : g ∈ Subgroup.closure ({a, b} : Set G)) :
    g = 1 ∨ g = a ∨ g = b ∨ g = a * b ∨ g = b * a ∨ g = a * b * a := by
  let P := fun g : G => g = 1 ∨ g = a ∨ g = b ∨ g = a * b ∨ g = b * a ∨ g = a * b * a
  have haa : a * a = 1 := by simpa only [ha] using inv_mul_cancel a
  have hbb : b * b = 1 := by simpa only [hb] using inv_mul_cancel b
  have hA (g : G) (hg : P g) : P (a * g) := by
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl
    · exact Or.inr (Or.inl (mul_one a))
    · exact Or.inl haa
    · exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
    · exact Or.inr (Or.inr (Or.inl (by rw [← mul_assoc, haa, one_mul])))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (mul_assoc _ _ _).symm))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (by
        rw [← mul_assoc, ← mul_assoc, haa, one_mul])))))
  have hB (g : G) (hg : P g) : P (b * g) := by
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl
    · exact Or.inr (Or.inr (Or.inl (mul_one b)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
    · exact Or.inl hbb
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (by rw [← mul_assoc, ← hab])))))
    · exact Or.inr (Or.inl (by rw [← mul_assoc, hbb, one_mul]))
    · exact Or.inr (Or.inr (Or.inr (Or.inl (by
        rw [← mul_assoc, ← mul_assoc, ← hab, mul_assoc (a * b), haa, mul_one]))))
  change P g
  induction hg using Subgroup.closure_induction_left with
  | one => exact Or.inl rfl
  | mul_left x hx y _ ih =>
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact hA y ih
    · rcases Set.mem_singleton_iff.mp hx with rfl
      exact hB y ih
  | inv_mul_cancel x hx y _ ih =>
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · rw [ha]; exact hA y ih
    · rcases Set.mem_singleton_iff.mp hx with rfl
      rw [hb]; exact hB y ih

private theorem quotient_generator_mem (i j : Fin 3) (hij : i ≠ j) (t : Fˣ) :
    quotientMap (liftW i j hij t) ∈
      Subgroup.closure ({quotientMap (liftA : weylSubgroup F), quotientMap liftB} : Set _) := by
  rw [quotient_parameter i j hij t]
  have ha : quotientMap (liftA : weylSubgroup F) ∈
      Subgroup.closure ({quotientMap (liftA : weylSubgroup F), quotientMap liftB} : Set _) :=
    Subgroup.subset_closure (by simp)
  have hb : quotientMap (liftB : weylSubgroup F) ∈
      Subgroup.closure ({quotientMap (liftA : weylSubgroup F), quotientMap liftB} : Set _) :=
    Subgroup.subset_closure (by simp)
  have hc : quotientMap (liftW 0 2 (by decide) (1 : Fˣ)) ∈
      Subgroup.closure ({quotientMap (liftA : weylSubgroup F), quotientMap liftB} : Set _) := by
    rw [quotient_third]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ ha hb) ha
  fin_cases i <;> fin_cases j
  · exact (hij rfl).elim
  · exact ha
  · exact hc
  · exact (quotient_reverse (F := F) 0 1 (by decide)).symm ▸ ha
  · exact (hij rfl).elim
  · exact hb
  · exact (quotient_reverse (F := F) 0 2 (by decide)).symm ▸ hc
  · exact (quotient_reverse (F := F) 1 2 (by decide)).symm ▸ hb
  · exact (hij rfl).elim

private def representative (k : Fin 6) : weylSubgroup F :=
  ![1, liftA, liftB, liftA * liftB, liftB * liftA, liftA * liftB * liftA] k

private theorem quotient_exists_representative (w : weylSubgroup F) :
    ∃ k : Fin 6, quotientMap w = quotientMap (representative k) := by
  have hm {g : SteinbergGroup 3 F} (hg : g ∈ weylSubgroup F) :
      quotientMap ⟨g, hg⟩ ∈ Subgroup.closure
        ({quotientMap (liftA : weylSubgroup F), quotientMap liftB} : Set _) := by
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
      obtain ⟨r, t, rfl⟩ := hg
      exact quotient_generator_mem r.val.1 r.val.2 r.property t
    | one => exact Subgroup.one_mem _
    | mul g h hg hh ihg ihh =>
      change quotientMap (⟨g, hg⟩ * ⟨h, hh⟩) ∈ _
      rw [map_mul]
      exact Subgroup.mul_mem _ ihg ihh
    | inv g hg ih =>
      change quotientMap (⟨g, hg⟩⁻¹) ∈ _
      rw [map_inv]
      exact Subgroup.inv_mem _ ih
  have hs := six_words _ _ (quotient_involution (F := F) 0 1 (by decide))
    (quotient_involution (F := F) 1 2 (by decide)) quotient_braid (hm w.property)
  rcases hs with h | h | h | h | h | h
  · exact ⟨0, by simpa [representative] using h⟩
  · exact ⟨1, by simpa [representative] using h⟩
  · exact ⟨2, by simpa [representative] using h⟩
  · exact ⟨3, by simpa [representative] using h⟩
  · exact ⟨4, by simpa [representative] using h⟩
  · exact ⟨5, by simpa [representative] using h⟩


private theorem matrix_liftA :
    (matrixMap (liftA : weylSubgroup F).val : Matrix (Fin 3) (Fin 3) F) =
      !![0, 1, 0; -1, 0, 0; 0, 0, 1] := by
  simp only [liftA, liftW, weylWord, map_mul, matrixMap_generator,
    coe_mul, matrixRoot, transvection_coe]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [root, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.single, Matrix.one_apply]

private theorem matrix_liftB :
    (matrixMap (liftB : weylSubgroup F).val : Matrix (Fin 3) (Fin 3) F) =
      !![1, 0, 0; 0, 0, 1; 0, -1, 0] := by
  simp only [liftB, liftW, weylWord, map_mul, matrixMap_generator,
    coe_mul, matrixRoot, transvection_coe]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [root, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.single, Matrix.one_apply]

private theorem representative_zero_diagonal {k : Fin 6} (hk : k ≠ 0) :
    ∃ i : Fin 3,
      (matrixMap (representative k : weylSubgroup F).val : Matrix (Fin 3) (Fin 3) F) i i = 0 := by
  fin_cases k
  · exact (hk rfl).elim
  · exact ⟨0, by simp [representative, matrix_liftA]⟩
  · exact ⟨1, by simp [representative, matrix_liftB]⟩
  · exact ⟨0, by simp [representative, map_mul, coe_mul, matrix_liftA, matrix_liftB,
      Matrix.mul_apply, Fin.sum_univ_succ]⟩
  · exact ⟨0, by simp [representative, map_mul, coe_mul, matrix_liftA, matrix_liftB,
      Matrix.mul_apply, Fin.sum_univ_succ]⟩
  · exact ⟨0, by simp [representative, map_mul, coe_mul, matrix_liftA, matrix_liftB,
      Matrix.mul_apply, Fin.sum_univ_succ]⟩

private theorem torus_mul_ne_one (hC : TorusMultiplicative F)
    {t r : SteinbergGroup 3 F} (ht : t ∈ torusSubgroup F)
    (hr : ∃ i : Fin 3, (matrixMap r : Matrix (Fin 3) (Fin 3) F) i i = 0) :
    matrixMap (t * r) ≠ 1 := by
  obtain ⟨s, v, rfl⟩ := torusSubgroup_exists_pair hC ht
  obtain ⟨i, hi⟩ := hr
  intro he
  have hd := congrArg (fun g : Matrix.SpecialLinearGroup (Fin 3) F =>
    (g : Matrix (Fin 3) (Fin 3) F) i i) he
  simp only [map_mul, coe_mul, matrixMap_torus_zero_one, matrixMap_torus_one_two,
    Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul, hi, mul_zero, coe_one,
    Matrix.one_apply_eq] at hd
  exact zero_ne_one hd

/-- A matrix-kernel element of the literal Weyl subgroup lies in the literal
torus subgroup, assuming multiplicativity of the root torus words. -/
theorem weylKernelInTorus_of_torusMultiplicative (hC : TorusMultiplicative F) :
    WeylKernelInTorus F := by
  intro w hw hmap
  obtain ⟨k, hk⟩ := quotient_exists_representative (⟨w, hw⟩ : weylSubgroup F)
  have ht : w / (representative k : weylSubgroup F).val ∈ torusSubgroup F := by
    change (⟨w, hw⟩ / representative k : weylSubgroup F) ∈
      (torusSubgroup F).subgroupOf (weylSubgroup F)
    exact QuotientGroup.eq_iff_div_mem.mp hk
  by_cases hk0 : k = 0
  · simpa [hk0, representative] using ht
  · have hne := torus_mul_ne_one hC ht (representative_zero_diagonal hk0)
    exact (hne (by simpa using hmap)).elim

end Matrix.PSL3.UniversalProjection.Faithfulness
