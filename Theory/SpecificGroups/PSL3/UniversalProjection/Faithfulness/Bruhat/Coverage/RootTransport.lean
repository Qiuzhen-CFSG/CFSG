module

public import Theory.SpecificGroups.PSL3.UniversalProjection.Faithfulness.Bruhat.Setup

/-!
# Root transport and rank-one exchange for degree-three Bruhat collection

Each Weyl word permutes the root indices and multiplies each parameter by
a unit. Induction extends this to the subgroup generated by all Weyl words.
For a nonzero parameter, the rank-one exchange moves a positive root factor
past a simple Weyl word into an opposite root, two Weyl factors, and a
positive root. Both facts follow from the Steinberg relations over any field.

Source: Steinberg, *Lectures on Chevalley Groups*, §6, Lemma 37, printed
pp.69–70; the word-collection argument of GLS3 §2.9, printed pp.97–98.
These identities are consumed by `Coverage.lean`.
-/

@[expose] public section

open Theory.SpecificGroups.LinearHigher SteinbergWords
namespace Matrix.PSL3.UniversalProjection.Faithfulness.PositiveCollection
variable {F : Type*} [Field F]

def permuteRoot (σ : Equiv.Perm (Fin 3)) (r : Root 3) : Root 3 :=
  root (σ r.val.1) (σ r.val.2) (σ.injective.ne r.property)

theorem weylWord_transport (i j : Fin 3) (hij : i ≠ j) (t : Fˣ) (r : Root 3) :
    ∃ c : Fˣ, ∀ a : F,
      MulAut.conj (weylWord generator i j hij t) (generator r a) =
        generator (permuteRoot (Equiv.swap i j) r) ((c : F) * a) := by
  obtain ⟨⟨k,l⟩,hkl⟩ := r
  change ∃ c : Fˣ, ∀ a : F,
    MulAut.conj (weylWord generator i j hij t) (generator (root k l hkl) a) =
      generator (permuteRoot (Equiv.swap i j) (root k l hkl)) ((c : F)*a)
  by_cases hki : k = i
  · subst k
    by_cases hlj : l = j
    · subst l
      refine ⟨-t⁻¹*t⁻¹, ?_⟩
      intro a
      simpa [permuteRoot, root, mul_assoc, mul_comm, mul_left_comm] using
        weylWord_conj_root generator_relations (by decide) i j hij t a
    · refine ⟨-t⁻¹, ?_⟩
      intro a
      simpa [permuteRoot, root, Equiv.swap_apply_of_ne_of_ne hkl.symm hlj] using
        weylWord_conj_outgoing generator_relations i j l hij hkl (Ne.symm hlj) t a
  by_cases hkj : k = j
  · subst k
    by_cases hli : l = i
    · subst l
      refine ⟨-t*t, ?_⟩
      intro a
      simpa [permuteRoot, root, mul_assoc, mul_comm, mul_left_comm] using
        weylWord_conj_opposite_root generator_relations (by decide) i j hij t a
    · refine ⟨t, ?_⟩
      intro a
      simpa [permuteRoot, root, Equiv.swap_apply_of_ne_of_ne hli hkl.symm] using
        weylWord_conj_other_outgoing generator_relations i j l hij (Ne.symm hli) hkl t a
  by_cases hli : l = i
  · subst l
    refine ⟨-t, ?_⟩
    intro a
    simpa [permuteRoot, root, Equiv.swap_apply_of_ne_of_ne hki hkj, mul_comm] using
      weylWord_conj_other_incoming generator_relations i j k hij hki hkj t a
  by_cases hlj : l = j
  · subst l
    refine ⟨t⁻¹, ?_⟩
    intro a
    simpa [permuteRoot, root, Equiv.swap_apply_of_ne_of_ne hki hkj, mul_comm] using
      weylWord_conj_incoming generator_relations i j k hij hki hkj t a
  refine ⟨1, ?_⟩
  intro a
  have hd (b : F) := generator_relations.conj_distant
    (root i j hij) (root k l hkl) b a (Ne.symm hkj) hli
  have hd' (b : F) := generator_relations.conj_distant
    (root j i hij.symm) (root k l hkl) b a (Ne.symm hki) hlj
  simp only [weylWord, map_mul, MulAut.mul_apply, hd, hd']
  simp [permuteRoot, root, Equiv.swap_apply_of_ne_of_ne hki hkj,
    Equiv.swap_apply_of_ne_of_ne hli hlj]

theorem weyl_transport {w : SteinbergGroup 3 F} (hw : w ∈ weylSubgroup F) :
    ∃ σ : Equiv.Perm (Fin 3), ∀ r : Root 3, ∃ c : Fˣ, ∀ a : F,
      MulAut.conj w (generator r a) = generator (permuteRoot σ r) ((c : F) * a) := by
  have step (w : SteinbergGroup 3 F)
      (ih : ∃ σ : Equiv.Perm (Fin 3), ∀ r : Root 3, ∃ c : Fˣ, ∀ a : F,
        MulAut.conj w (generator r a) = generator (permuteRoot σ r) ((c : F) * a))
      (r : Root 3) (t : Fˣ) :
      ∃ σ : Equiv.Perm (Fin 3), ∀ q : Root 3, ∃ c : Fˣ, ∀ a : F,
        MulAut.conj (w * weylWord generator r.val.1 r.val.2 r.property t) (generator q a) =
          generator (permuteRoot σ q) ((c : F) * a) := by
    obtain ⟨σ,hσ⟩ := ih
    refine ⟨σ * Equiv.swap r.val.1 r.val.2, ?_⟩
    intro q
    obtain ⟨d,hd⟩ := weylWord_transport r.val.1 r.val.2 r.property t q
    obtain ⟨c,hc⟩ := hσ (permuteRoot (Equiv.swap r.val.1 r.val.2) q)
    refine ⟨c*d, ?_⟩
    intro a
    rw [map_mul, MulAut.mul_apply, hd, hc]
    simp only [Units.val_mul, mul_assoc]
    rfl
  induction hw using Subgroup.closure_induction_right with
  | one =>
    refine ⟨1, fun r => ⟨1, ?_⟩⟩
    intro a
    simp only [map_one, MulAut.one_apply, Units.val_one, one_mul]
    rfl
  | mul_right w _ y hy ih =>
    obtain ⟨r,t,rfl⟩ := hy
    exact step w ih r t
  | mul_inv_cancel w _ y hy ih =>
    obtain ⟨r,t,rfl⟩ := hy
    rw [weylWord_inv generator_relations]
    exact step w ih r (-t)

/-- Rank-one exchange, with the nonzero root parameter retained as a unit. -/
theorem rank_one_exchange (i j : Fin 3) (hij : i ≠ j) (a t : Fˣ) :
    generator (root i j hij) (a : F) * weylWord generator i j hij t =
      generator (root j i hij.symm) ((a⁻¹ : Fˣ) : F) *
        (weylWord generator i j hij a * weylWord generator i j hij t) *
          generator (root i j hij) (-(t : F) * ((a⁻¹ : Fˣ) : F) * (t : F)) := by
  have hconj := weylWord_conj_root generator_relations (by decide) i j hij a (-(a : F))
  have hcoeff : -((a⁻¹ : Fˣ) : F) * -(a : F) * ((a⁻¹ : Fˣ) : F) =
      ((a⁻¹ : Fˣ) : F) := by simp
  rw [hcoeff] at hconj
  have hx : generator (root i j hij) (a : F) =
      generator (root j i hij.symm) ((a⁻¹ : Fˣ) : F) *
        weylWord generator i j hij a *
          generator (root j i hij.symm) ((a⁻¹ : Fˣ) : F) := by
    have hm : weylWord generator i j hij a * generator (root i j hij) (-(a : F)) =
        generator (root j i hij.symm) ((a⁻¹ : Fˣ) : F) * weylWord generator i j hij a :=
      mul_inv_eq_iff_eq_mul.mp hconj
    rw [← hm, weylWord]
    simp only [generator_relations.neg]
    group
  have ht := weylWord_conj_opposite_root generator_relations (by decide)
    i j hij (-t) ((a⁻¹ : Fˣ) : F)
  rw [← weylWord_inv generator_relations] at ht
  simp only [Units.val_neg, neg_neg, mul_neg, ← neg_mul] at ht
  calc
    _ = (generator (root j i hij.symm) ((a⁻¹ : Fˣ) : F) *
        weylWord generator i j hij a *
          generator (root j i hij.symm) ((a⁻¹ : Fˣ) : F)) *
          weylWord generator i j hij t := congrArg (fun z => z * _) hx
    _ = _ := by rw [← ht]; simp only [MulAut.conj_apply, inv_inv]; group
end Matrix.PSL3.UniversalProjection.Faithfulness.PositiveCollection
