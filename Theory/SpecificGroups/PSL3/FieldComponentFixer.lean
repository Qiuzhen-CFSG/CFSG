module

public import Theory.SpecificGroups.PSL3.CartanActions.NormalizerForm
public import Mathlib.FieldTheory.Galois.IsGaloisGroup

/-!
# Pointwise fixers of subfield root groups in PSL₃

In characteristic two, trace removes the scalar ambiguity in conjugating an
elementary matrix in the projective quotient. Fixing the six binary elementary
matrices forces the linear factor to be scalar. Reversing all six directions
would force the conjugating matrix to vanish, so the graph factor is excluded.
The standard pointwise fixer is therefore the coefficient group fixing the
subfield. Finite fixed-field Galois theory identifies it with the cyclic group
generated by the given coefficient automorphism.

The final full-fixer cardinality theorem retains standard-automorphism coverage
as an explicit premise. No assertion about the placement of arbitrary components
is made here. This is the matrix calculation used in Aschbacher–Smith 16.3.5,
printed pp.1178–1179, with the field row of 16.1.4(4) and 16.1.7(3a), printed
pp.1171–1173, `refs/quasithin.pdf` (1 March 2004 manuscript). The concrete actions
are those of GLS3, Theorem 2.5.12 and §2.7, `refs/KGroup/GLS3/chapter2.tex`.
-/

@[expose] public section

open scoped MatrixGroups
open Matrix Subgroup
open Matrix.PSL3.OuterSolvable Matrix.PSL3.OuterSolvable.OddPrimeCoverage
namespace Matrix.PSL3.FieldComponentFixer
variable {F : Type*} [Field F]

/-- The embedded group generated by all six roots over the coefficient fixed field. -/
def fieldRoots (σ : F ≃+* F) : Subgroup PSL(3,F) :=
  Subgroup.closure {g | ∃ (i j : Fin 3) (hij : i ≠ j) (c : F),
    σ c = c ∧ g = rootElement hij c}

theorem root_mem_fieldRoots (σ : F ≃+* F) {i j : Fin 3} (hij : i ≠ j)
    (c : F) (hc : σ c = c) : rootElement hij c ∈ fieldRoots σ :=
  Subgroup.subset_closure ⟨i, j, hij, c, hc, rfl⟩

theorem fieldAction_rootElement (σ : F ≃+* F) {i j : Fin 3} (hij : i ≠ j) (c : F) :
    fieldAction F σ (rootElement hij c) = rootElement hij (σ c) := by
  rw [rootElement, fieldAction_mk]
  congr 1
  apply Subtype.ext
  ext k l
  change σ ((1 + Matrix.single i j c) k l) = (1 + Matrix.single i j (σ c)) k l
  simp only [Matrix.add_apply, Matrix.one_apply, Matrix.single_apply, map_add]
  split_ifs <;> simp

private theorem scalar_of_projective_eq (x y : SL(3,F))
    (h : (QuotientGroup.mk x : PSL(3,F)) = QuotientGroup.mk y) :
    ∃ r : F, x.val = r • y.val := by
  have hc : y⁻¹ * x ∈ Subgroup.center SL(3,F) := QuotientGroup.eq.mp h.symm
  obtain ⟨r, _, hr⟩ := SpecialLinearGroup.mem_center_iff.mp hc
  refine ⟨r, ?_⟩
  calc
    x.val = (y * (y⁻¹ * x)).val := by simp only [mul_inv_cancel_left]
    _ = y.val * Matrix.scalar (Fin 3) r := by rw [SpecialLinearGroup.coe_mul, ← hr]
    _ = r • y.val := by
      ext i j
      simp [Matrix.scalar, Matrix.mul_diagonal, mul_comm]

private theorem trace_transvection [CharP F 2] {i j : Fin 3} (hij : i ≠ j) (c : F) :
    Matrix.trace (SpecialLinearGroup.transvection hij c).val = 1 := by
  simp [SpecialLinearGroup.transvection_coe, Matrix.trace_add, hij, Matrix.trace_one]
  have htwo : (2 : F) = 0 := CharP.cast_eq_zero F 2
  linear_combination htwo

private theorem conjugate_transvection_eq [CharP F 2]
    (m : GL (Fin 3) F) {i j k l : Fin 3} (hij : i ≠ j) (hkl : k ≠ l)
    (a b : F) (h : linearConj F m (rootElement hij a) = rootElement hkl b) :
    m.val * (1 + Matrix.single i j a) = (1 + Matrix.single k l b) * m.val := by
  obtain ⟨r, hr⟩ := scalar_of_projective_eq
    (linearConjSL F m (SpecialLinearGroup.transvection hij a))
    (SpecialLinearGroup.transvection hkl b) h
  have hv (x : SL(3,F)) : (linearConjSL F m x).val = m.val * x.val * m.inv :=
    congrArg Units.val (linearConjSL_toGL F m x)
  have ht : Matrix.trace (linearConjSL F m (SpecialLinearGroup.transvection hij a)).val = 1 := by
    rw [hv, Matrix.trace_mul_cycle, m.inv_val, one_mul, trace_transvection]
  rw [hr, Matrix.trace_smul, trace_transvection, smul_eq_mul, mul_one] at ht
  have he : (linearConjSL F m (SpecialLinearGroup.transvection hij a)).val =
      (SpecialLinearGroup.transvection hkl b).val := by simpa [ht] using hr
  have he' := congrArg (fun M : Matrix (Fin 3) (Fin 3) F => M * m.val) he
  simpa only [hv, Matrix.mul_assoc, m.inv_val, mul_one,
    SpecialLinearGroup.transvection_coe] using he'

private theorem matrix_scalar_of_fixes_roots [CharP F 2]
    (m : GL (Fin 3) F)
    (h : ∀ (i j : Fin 3) (hij : i ≠ j),
      linearConj F m (rootElement hij 1) = rootElement hij 1) :
    m.val = Matrix.scalar (Fin 3) (m.val 0 0) := by
  have he (i j : Fin 3) (hij : i ≠ j) :
      m.val * Matrix.single i j 1 = Matrix.single i j 1 * m.val := by
    have hh := conjugate_transvection_eq m hij hij 1 1 (h i j hij)
    simpa only [mul_add, add_mul, mul_one, one_mul, add_right_inj] using hh
  have hz (k i : Fin 3) (hki : k ≠ i) : m.val k i = 0 := by
    obtain ⟨j, hij⟩ := exists_ne i
    have hh := congrArg (fun M : Matrix (Fin 3) (Fin 3) F => M k j) (he i j hij.symm)
    simpa [Matrix.mul_apply, Matrix.single_apply, hki, Ne.symm hki] using hh
  have hd (i j : Fin 3) : m.val i i = m.val j j := by
    by_cases hij : i = j
    · subst j; rfl
    · have hh := congrArg (fun M : Matrix (Fin 3) (Fin 3) F => M i j) (he i j hij)
      simpa [Matrix.mul_apply, Matrix.single_apply] using hh
  ext i j
  by_cases hij : i = j
  · subst j
    simpa [Matrix.scalar] using hd i 0
  · simp [Matrix.scalar, hij, hz i j hij]

/-- A linear factor fixing the binary elementary matrices acts trivially on PSL₃. -/
theorem linearConj_eq_one_of_fixes_roots [CharP F 2]
    (m : GL (Fin 3) F)
    (h : ∀ (i j : Fin 3) (hij : i ≠ j),
      linearConj F m (rootElement hij 1) = rootElement hij 1) :
    linearConj F m = 1 := by
  have hm := matrix_scalar_of_fixes_roots m h
  apply MulEquiv.ext
  intro x
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center SL(3,F)) x
  change QuotientGroup.mk (linearConjSL F m y) = QuotientGroup.mk y
  congr 1
  apply SpecialLinearGroup.toGL_injective
  rw [linearConjSL_toGL]
  apply Units.ext
  change m.val * y.val * m.inv = y.val
  have hc : m.val * y.val = y.val * m.val := by
    rw [hm]
    ext i j
    simp [Matrix.scalar, Matrix.diagonal_mul, Matrix.mul_diagonal, mul_comm]
  rw [hc, Matrix.mul_assoc, m.val_inv, mul_one]

/-- No linear factor can reverse every binary coordinate root pointwise. -/
theorem not_linearConj_reverses_roots [CharP F 2]
    (m : GL (Fin 3) F) :
    ¬ (∀ (i j : Fin 3) (hij : i ≠ j),
      linearConj F m (rootElement hij.symm 1) = rootElement hij 1) := by
  intro h
  have he (i j : Fin 3) (hij : i ≠ j) :
      m.val * Matrix.single j i 1 = Matrix.single i j 1 * m.val := by
    have hh := conjugate_transvection_eq m hij.symm hij 1 1 (h i j hij)
    simpa only [mul_add, add_mul, mul_one, one_mul, add_right_inj] using hh
  have hz : m.val = 0 := by
    ext j l
    obtain ⟨i, hij, hil⟩ := Fin.exists_ne_and_ne_of_two_lt j l (by decide : 2 < 3)
    have hh := congrArg (fun M : Matrix (Fin 3) (Fin 3) F => M i l) (he i j hij)
    simpa [Matrix.mul_apply, Matrix.single_apply, hil, Ne.symm hil] using hh.symm
  have := m.val_inv
  rw [hz, zero_mul] at this
  exact zero_ne_one this


private theorem fieldSL_toGL (τ : F ≃+* F) (x : SL(3,F)) :
    SpecialLinearGroup.toGL (SpecialLinearGroup.map τ.toRingHom x) =
      GeneralLinearGroup.map τ.toRingHom (SpecialLinearGroup.toGL x) := Units.ext rfl

private theorem field_linearConj (τ : F ≃+* F) (A : GL (Fin 3) F) :
    fieldAction F τ * linearConj F A =
      linearConj F (GeneralLinearGroup.map τ.toRingHom A) * fieldAction F τ := by
  apply MulEquiv.ext
  intro y
  induction y using QuotientGroup.induction_on with
  | H x =>
    simp only [MulAut.mul_apply, fieldAction_mk, linearConj_mk]
    congr 1
    apply SpecialLinearGroup.toGL_injective
    rw [fieldSL_toGL, linearConjSL_toGL, map_mul, map_mul, map_inv,
      linearConjSL_toGL, fieldSL_toGL]

private def inverseTransposeGL : GL (Fin 3) F →* GL (Fin 3) F where
  toFun g := {
    val := g.inv.transpose
    inv := g.val.transpose
    val_inv := by rw [← Matrix.transpose_mul, g.val_inv, Matrix.transpose_one]
    inv_val := by rw [← Matrix.transpose_mul, g.inv_val, Matrix.transpose_one] }
  map_one' := Units.ext Matrix.transpose_one
  map_mul' g h := Units.ext (Matrix.transpose_mul h.inv g.inv)

private theorem graphSL_toGL (x : SL(3,F)) :
    SpecialLinearGroup.toGL (graphSL F x) = inverseTransposeGL (SpecialLinearGroup.toGL x) := by
  apply Units.ext
  exact (Matrix.adjugate_transpose x.val).symm

private theorem graph_linearConj (A : GL (Fin 3) F) :
    graph F * linearConj F A = linearConj F (inverseTransposeGL A) * graph F := by
  apply MulEquiv.ext
  intro y
  induction y using QuotientGroup.induction_on with
  | H x =>
    change QuotientGroup.mk (graphSL F (linearConjSL F A x)) =
      QuotientGroup.mk (linearConjSL F (inverseTransposeGL A) (graphSL F x))
    congr 1
    apply SpecialLinearGroup.toGL_injective
    rw [graphSL_toGL, linearConjSL_toGL, map_mul, map_mul, map_inv,
      linearConjSL_toGL, graphSL_toGL]

private theorem field_commute_graph (τ : F ≃+* F) :
    Commute (fieldAction F τ) (graph F) := by
  apply MulEquiv.ext
  intro y
  induction y using QuotientGroup.induction_on with
  | H x =>
    simp only [MulAut.mul_apply, fieldAction_mk, graph_mk]
    rw [map_inv]
    congr 2

private theorem graph_root {i j : Fin 3} (hij : i ≠ j) (c : F) :
    graph F (rootElement hij c) = rootElement hij.symm (-c) := by
  rw [rootElement, graph_mk]
  have h : SpecialLinearGroup.transpose (SpecialLinearGroup.transvection hij c) =
      SpecialLinearGroup.transvection hij.symm c := by
    apply Subtype.ext
    simp [SpecialLinearGroup.transvection_coe, Matrix.transpose_add, Matrix.transpose_single]
  rw [h, SpecialLinearGroup.transvection_inv]
  rfl

/-- A standard automorphism fixing the coefficient-field roots is a pure
field action, and its coefficient action fixes the same field pointwise. -/
theorem standard_fixer_is_field [CharP F 2] (σ : F ≃+* F)
    (b : MulAut PSL(3,F)) (hb : b ∈ standard F)
    (hfix : b ∈ fixingSubgroup (MulAut PSL(3,F)) (fieldRoots σ : Set PSL(3,F))) :
    ∃ τ : F ≃+* F, b = fieldAction F τ ∧ ∀ c : F, σ c = c → τ c = c := by
  have hroot (i j : Fin 3) (hij : i ≠ j) (c : F) (hc : σ c = c) :
      b (rootElement hij c) = rootElement hij c :=
    hfix ⟨_, root_mem_fieldRoots σ hij c hc⟩
  obtain ⟨m, τ, he | he⟩ := CartanActions.NormalizerForm.standard_factorization F
    field_linearConj (fun A => ⟨inverseTransposeGL A, graph_linearConj A⟩)
    field_commute_graph b hb
  · have hm : linearConj F m = 1 := by
      apply linearConj_eq_one_of_fixes_roots
      intro i j hij
      have hh := hroot i j hij 1 (map_one σ)
      simpa only [he, MulAut.mul_apply, fieldAction_rootElement, map_one] using hh
    refine ⟨τ, by simpa [hm] using he, ?_⟩
    intro c hc
    have hh := hroot 0 1 (by decide) c hc
    rw [he, hm, one_mul, fieldAction_rootElement] at hh
    exact rootElement_injective (by decide : (0 : Fin 3) ≠ 1) hh
  · exfalso
    apply not_linearConj_reverses_roots m
    intro i j hij
    have hh := hroot i j hij 1 (map_one σ)
    simpa only [he, MulAut.mul_apply, graph_root, fieldAction_rootElement,
      map_neg, map_one, CharTwo.neg_eq] using hh

/-- The coefficient automorphisms fixing the field of σ are precisely its
powers. This is finite fixed-field Galois theory, independently of the matrix group. -/
theorem coefficient_fixer_eq_zpowers [Finite F] (σ : F ≃+* F) :
    fixingSubgroup (F ≃+* F) {c : F | σ c = c} = Subgroup.zpowers σ := by
  let : Finite (F ≃+* F) := Finite.of_injective (fun e : F ≃+* F => (e : F → F))
    (fun _ _ h => RingEquiv.ext (congrFun h))
  apply le_antisymm
  · intro τ hτ
    let R := FixedPoints.subfield (Subgroup.zpowers σ) F
    let a : F ≃ₐ[R] F :=
      { τ with commutes' := fun c => hτ ⟨c.val, c.property ⟨σ, Subgroup.mem_zpowers σ⟩⟩ }
    obtain ⟨g, hg⟩ := (FixedPoints.toAlgAutMulEquiv (Subgroup.zpowers σ) F).surjective a
    have he : (g : F ≃+* F) = τ := by
      apply RingEquiv.ext
      intro c
      exact congrArg (fun e : F ≃ₐ[R] F => e c) hg
    rw [← he]
    exact g.property
  · apply Subgroup.zpowers_le.mpr
    exact fun c => c.property

/-- The standard pointwise fixer of the embedded field roots is exactly the
cyclic group generated by the actual coefficient action. -/
theorem standard_fixer_eq [Finite F] [CharP F 2] (σ : F ≃+* F) :
    standard F ⊓ fixingSubgroup (MulAut PSL(3,F)) (fieldRoots σ : Set PSL(3,F)) =
      (Subgroup.zpowers σ).map (fieldAction F) := by
  apply le_antisymm
  · intro b hb
    obtain ⟨τ, rfl, hτ⟩ := standard_fixer_is_field σ b hb.1 hb.2
    refine ⟨τ, ?_, rfl⟩
    rw [← coefficient_fixer_eq_zpowers σ]
    exact fun c => hτ c c.property
  · rintro b ⟨τ, hτ, rfl⟩
    refine ⟨fieldAction_mem_standard F τ, ?_⟩
    have hτ' : τ ∈ fixingSubgroup (F ≃+* F) {c : F | σ c = c} := by
      rwa [coefficient_fixer_eq_zpowers σ]
    have hle : fieldRoots σ ≤ (fieldAction F τ).fixedSubgroup := by
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨i, j, hij, c, hc, rfl⟩
      apply (MulAut.mem_fixedSubgroup _ _).mpr
      have ht : τ c = c := hτ' ⟨c, hc⟩
      rw [fieldAction_rootElement, ht]
    exact fun c => (MulAut.mem_fixedSubgroup _ _).mp (hle c.property)

/-- Coefficient actions are faithful on the projective matrix group. -/
theorem fieldAction_injective : Function.Injective (fieldAction F) := by
  intro σ τ h
  apply RingEquiv.ext
  intro c
  have he := congrArg (fun b : MulAut PSL(3,F) => b (rootElement (by decide : (0 : Fin 3) ≠ 1) c)) h
  simp only [fieldAction_rootElement] at he
  exact rootElement_injective (by decide : (0 : Fin 3) ≠ 1) he

/-- Full automorphism coverage upgrades the coordinate calculation to the
full fixer. No restriction to standard actors remains in the conclusion. -/
theorem card_fixer_fieldRoots [Finite F] [CharP F 2]
    (hcover : standard F = ⊤) (σ : F ≃+* F) :
    Nat.card (fixingSubgroup (MulAut PSL(3,F)) (fieldRoots σ : Set PSL(3,F))) = orderOf σ := by
  have he := standard_fixer_eq σ
  rw [hcover, top_inf_eq] at he
  rw [he, Subgroup.card_map_of_injective fieldAction_injective, Nat.card_zpowers]

end Matrix.PSL3.FieldComponentFixer
