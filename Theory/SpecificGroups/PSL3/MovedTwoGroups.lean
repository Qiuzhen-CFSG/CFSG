module
public import Theory.SpecificGroups.PSL3.OuterSolvable.StandardQuotient
public import Theory.SpecificGroups.PSL3.CartanActions.ResidualInner

/-!
# Moved two-subgroups under standard PSL₃ automorphism coverage

The field--graph quotient by diagonal automorphisms is abelian, so movement
places the image in the diagonal subgroup. Cubing every linear actor gives
an inner automorphism. Its two-power order kills this remaining cubic image.
This extends the argument of OddMovedTwoGroups to any supplied standard
coverage, including the proved binary-field coverage.

Source: GLS3, Theorem 2.5.12 and §2.7; Aschbacher--Smith 4.3.16, p.618.
-/

public noncomputable section
open Subgroup
open scoped MatrixGroups
namespace Matrix.PSL3.MovedTwoGroups
open OuterSolvable
variable {F : Type*} [Field F] [Finite F]

/-- A two-subgroup generated by its commutators is inner. -/
theorem moved_twoGroup_le_inner_of_coverage
    (hcover : standard F = ⊤)
    (R Y : Subgroup (MulAut PSL(3,F))) (hR : IsPGroup 2 R)
    (hmove : ⁅R,Y⁆ = R) : R ≤ MulAut.innerSubgroup PSL(3,F) := by
  let := innerDiagonalOuter_normal_of_coverage F hcover
  let := outerDiagonalQuotient_isMulCommutative_of_coverage F hcover
  let q := QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F))
  let d := QuotientGroup.mk' (innerDiagonalOuter F)
  let f := d.comp q
  have hzero : R.map f = ⊥ := by
    rw [←hmove,map_commutator]
    apply bot_unique
    have hh : ⁅(⊤ : Subgroup (MulAut.Outer PSL(3,F) ⧸ innerDiagonalOuter F)),⊤⁆ = ⊥ :=
      commutator_self_eq_bot_iff.mpr inferInstance
    exact (commutator_mono le_top le_top).trans hh.le
  intro r hr
  have hd : q r ∈ innerDiagonalOuter F :=
    (QuotientGroup.eq_one_iff _).mp ((Subgroup.map_eq_bot_iff _).mp hzero hr)
  obtain ⟨g,hg⟩ := hd
  have hcube : q r ^ 3 = 1 := by
    rw [←hg]
    change q (linearConj F g) ^ 3 = 1
    rw [←map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (Matrix.PSL3.CartanActions.ResidualInner.linearConj_cube_inner g)
  have hcop : (orderOf (q r)).Coprime 3 :=
    (hR.orderOf_coprime (by decide : Nat.Coprime 2 3) ⟨r,hr⟩).coprime_dvd_left
      (orderOf_map_dvd (q.comp R.subtype) ⟨r,hr⟩)
  exact (QuotientGroup.eq_one_iff _).mp (orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes hcop (dvd_refl _) (orderOf_dvd_of_pow_eq_one hcube)))
end Matrix.PSL3.MovedTwoGroups


