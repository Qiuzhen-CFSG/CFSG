module
public import Theory.SpecificGroups.PSL3.UniversalProjection.Faithfulness
public import Theory.SpecificGroups.PSL3.UniversalProjection.Basic

/-!
# Recognition from the finite degree-three elementary presentation

A nontrivial centerless group generated by six root ranges satisfying the
Steinberg relations is the actual PSL₃. First use finite-field faithfulness
to pass from the Steinberg presentation to SL₃. Surjectivity kills the full
scalar center, and simplicity of the concrete projective group gives the
inverse equivalence. This includes fields of orders two and four.

Source: Steinberg, Lectures on Chevalley Groups, §6, pp.71–74.
-/

@[expose] public noncomputable section
open scoped MatrixGroups
open Theory.SpecificGroups.LinearHigher
open Matrix.PSL3.UniversalProjection
namespace Matrix.PSL3.RootPresentationRecognition
variable {F Y : Type*} [Field F] [Finite F] [Group Y]

/-- All finite fields, including the two exceptional universal-cover parameters. -/
def matrixEquiv : SteinbergGroup 3 F ≃* SL(3,F) :=
  MulEquiv.ofBijective matrixMap ⟨matrixMap_injective_of_kernel_torus
    (Faithfulness.kernelTorusReduction_of_torusMultiplicative
      (Faithfulness.torusMultiplicative (F := F))), matrixMap_surjective (by decide)⟩

omit [Finite F] in
/-- Generation by the literal root ranges makes the presentation map onto. -/
theorem lift_surjective {x : Root 3 → F → Y} (hx : Relations x)
    (hgen : Subgroup.closure {g | ∃ r a, g = x r a} = ⊤) :
    Function.Surjective (lift hx) := by
  apply MonoidHom.range_eq_top.mp
  apply top_unique
  rw [← hgen]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨r,a,rfl⟩
  exact ⟨generator r a, lift_generator hx r a⟩

/-- The SL₃ map before quotienting by its entire scalar center. -/
def linearMap {x : Root 3 → F → Y} (hx : Relations x) : SL(3,F) →* Y :=
  (lift hx).comp matrixEquiv.symm.toMonoidHom

@[simp] theorem linearMap_root {x : Root 3 → F → Y} (hx : Relations x)
    (r : Root 3) (a : F) : linearMap hx (matrixRoot r a) = x r a := by
  have h : matrixEquiv (generator r a) = matrixRoot r a := matrixMap_generator r a
  rw [← h]
  simp [linearMap]

theorem linearMap_surjective {x : Root 3 → F → Y} (hx : Relations x)
    (hgen : Subgroup.closure {g | ∃ r a, g = x r a} = ⊤) :
    Function.Surjective (linearMap hx) :=
  (lift_surjective hx hgen).comp matrixEquiv.symm.surjective

theorem center_le_kernel {x : Root 3 → F → Y} (hx : Relations x)
    (hgen : Subgroup.closure {g | ∃ r a, g = x r a} = ⊤)
    (hcenter : Subgroup.center Y = ⊥) :
    Subgroup.center SL(3,F) ≤ (linearMap hx).ker := by
  intro z hz
  have hc : linearMap hx z ∈ Subgroup.center Y := by
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨g,rfl⟩ := linearMap_surjective hx hgen y
    simpa only [← map_mul] using congrArg (linearMap hx)
      (Subgroup.mem_center_iff.mp hz g)
  simpa only [hcenter, Subgroup.mem_bot, MonoidHom.mem_ker] using hc

/-- Descent through the genuine scalar quotient, with no field-order exclusions. -/
def projectiveMap {x : Root 3 → F → Y} (hx : Relations x)
    (hgen : Subgroup.closure {g | ∃ r a, g = x r a} = ⊤)
    (hcenter : Subgroup.center Y = ⊥) : PSL(3,F) →* Y :=
  QuotientGroup.lift _ (linearMap hx) (center_le_kernel hx hgen hcenter)

@[simp] theorem projectiveMap_root {x : Root 3 → F → Y} (hx : Relations x)
    (hgen : Subgroup.closure {g | ∃ r a, g = x r a} = ⊤)
    (hcenter : Subgroup.center Y = ⊥) (r : Root 3) (a : F) :
    projectiveMap hx hgen hcenter (projectiveRoot r a) = x r a :=
  linearMap_root hx r a

theorem projectiveMap_surjective {x : Root 3 → F → Y} (hx : Relations x)
    (hgen : Subgroup.closure {g | ∃ r a, g = x r a} = ⊤)
    (hcenter : Subgroup.center Y = ⊥) :
    Function.Surjective (projectiveMap hx hgen hcenter) :=
  QuotientGroup.lift_surjective_of_surjective _ _ (linearMap_surjective hx hgen) _

/-- Only the known model is assumed simple; the unknown carrier is centerless
and nontrivial and is generated by the specified roots. -/
theorem projectiveMap_injective [Nontrivial Y] {x : Root 3 → F → Y}
    (hx : Relations x) (hgen : Subgroup.closure {g | ∃ r a, g = x r a} = ⊤)
    (hcenter : Subgroup.center Y = ⊥) :
    Function.Injective (projectiveMap hx hgen hcenter) := by
  let f := projectiveMap hx hgen hcenter
  let : IsSimpleGroup PSL(3,F) := Atlas.psl_simple_high_rank 3 (by decide)
  apply (MonoidHom.ker_eq_bot_iff _).mp
  rcases (inferInstance : f.ker.Normal).eq_bot_or_eq_top with h | h
  · exact h
  · obtain ⟨y, hy⟩ := exists_ne (1 : Y)
    obtain ⟨g, rfl⟩ := projectiveMap_surjective hx hgen hcenter y
    have hg : g ∈ f.ker := by rw [h]; exact Subgroup.mem_top g
    exact (hy hg).elim

/-- Recognition preserving every root and every parameter. -/
def equiv [Nontrivial Y] {x : Root 3 → F → Y} (hx : Relations x)
    (hgen : Subgroup.closure {g | ∃ r a, g = x r a} = ⊤)
    (hcenter : Subgroup.center Y = ⊥) : Y ≃* PSL(3,F) :=
  (MulEquiv.ofBijective (projectiveMap hx hgen hcenter)
    ⟨projectiveMap_injective hx hgen hcenter, projectiveMap_surjective hx hgen hcenter⟩).symm

@[simp] theorem equiv_root [Nontrivial Y] {x : Root 3 → F → Y} (hx : Relations x)
    (hgen : Subgroup.closure {g | ∃ r a, g = x r a} = ⊤)
    (hcenter : Subgroup.center Y = ⊥) (r : Root 3) (a : F) :
    equiv hx hgen hcenter (x r a) = projectiveRoot r a := by
  apply (equiv hx hgen hcenter).symm.injective
  rw [MulEquiv.symm_apply_apply]
  change x r a = projectiveMap hx hgen hcenter (projectiveRoot r a)
  exact (projectiveMap_root hx hgen hcenter r a).symm

end Matrix.PSL3.RootPresentationRecognition
