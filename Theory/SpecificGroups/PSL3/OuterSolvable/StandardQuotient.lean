module

public import Theory.SpecificGroups.PSL3.OuterSolvable.Actions
public import Theory.SpecificGroups.SU3.ProjectiveOuterInvolutions.NormalForm.Field
public import Mathlib.GroupTheory.NoncommCoprod

/-!
# The field–graph quotient of the standard PSL₃ outer image

Over every field, coefficient transport and inverse transpose normalize the
linear conjugations and commute with one another. Thus the diagonal outer
image is normal relative to the standard outer image. Over a finite field,
the quotient is generated by a cyclic field image and a commuting graph
involution, so it is abelian. The diagonal image is already abelian by the
determinant calculation, giving solvability of the standard outer image.

These statements do not require coverage of all automorphisms or a splitting.
Source: GLS3, Theorem 2.5.12(b,d,e,i) and the matrix descriptions in §2.7,
`refs/KGroup/GLS3/chapter2.tex`, lines 854 onward and 1111 onward. The matrix
compatibility proofs use the representative argument of
`CartanActions/ResidualLinear.lean`, placed here below its consumers.
-/

@[expose] public section
open scoped MatrixGroups
namespace Matrix.PSL3.OuterSolvable
variable {F : Type*} [Field F]

private theorem fieldSL_toGL (τ : F ≃+* F) (x : SL(3,F)) :
    SpecialLinearGroup.toGL (SpecialLinearGroup.map τ.toRingHom x) =
      GeneralLinearGroup.map τ.toRingHom (SpecialLinearGroup.toGL x) := Units.ext rfl

/-- Compatibility of coefficient transport with actual linear conjugation. -/
theorem field_linearConj (τ : F ≃+* F) (m : GL (Fin 3) F) :
    fieldAction F τ * linearConj F m =
      linearConj F (GeneralLinearGroup.map τ.toRingHom m) * fieldAction F τ := by
  apply MulEquiv.ext
  intro y
  induction y using QuotientGroup.induction_on with
  | H x =>
    simp only [MulAut.mul_apply, fieldAction_mk, linearConj_mk]
    congr 1
    apply SpecialLinearGroup.toGL_injective
    rw [fieldSL_toGL, linearConjSL_toGL, map_mul, map_mul, map_inv,
      linearConjSL_toGL, fieldSL_toGL]

/-- Inverse transpose on GL₃, with literal inverse and transpose representatives. -/
def inverseTransposeGL (F : Type*) [Field F] : GL (Fin 3) F →* GL (Fin 3) F where
  toFun g := {
    val := g.inv.transpose
    inv := g.val.transpose
    val_inv := by rw [← Matrix.transpose_mul, g.val_inv, Matrix.transpose_one]
    inv_val := by rw [← Matrix.transpose_mul, g.inv_val, Matrix.transpose_one] }
  map_one' := Units.ext Matrix.transpose_one
  map_mul' g h := Units.ext (Matrix.transpose_mul h.inv g.inv)

@[simp] theorem inverseTransposeGL_val (m : GL (Fin 3) F) :
    (inverseTransposeGL F m).val = m.inv.transpose := rfl

@[simp] theorem inverseTransposeGL_inv (m : GL (Fin 3) F) :
    (inverseTransposeGL F m).inv = m.val.transpose := rfl

private theorem graphSL_toGL (x : SL(3,F)) :
    SpecialLinearGroup.toGL (graphSL F x) = inverseTransposeGL F (SpecialLinearGroup.toGL x) := by
  apply Units.ext
  exact (Matrix.adjugate_transpose x.val).symm

/-- Inverse transpose transports the actual GL₃ conjugating matrix. -/
theorem graph_linearConj (m : GL (Fin 3) F) :
    graph F * linearConj F m = linearConj F (inverseTransposeGL F m) * graph F := by
  apply MulEquiv.ext
  intro y
  induction y using QuotientGroup.induction_on with
  | H x =>
    change QuotientGroup.mk (graphSL F (linearConjSL F m x)) =
      QuotientGroup.mk (linearConjSL F (inverseTransposeGL F m) (graphSL F x))
    congr 1
    apply SpecialLinearGroup.toGL_injective
    rw [graphSL_toGL, linearConjSL_toGL, map_mul, map_mul, map_inv,
      linearConjSL_toGL, graphSL_toGL]

/-- Coefficient transport commutes with inverse transpose on PSL₃. -/
theorem field_commute_graph (τ : F ≃+* F) :
    Commute (fieldAction F τ) (graph F) := by
  apply MulEquiv.ext
  intro y
  induction y using QuotientGroup.induction_on with
  | H x =>
    simp only [MulAut.mul_apply, fieldAction_mk, graph_mk]
    rw [map_inv]
    congr 2

/-- Existential form for normal-form consumers. -/
theorem graph_linearConj_exists (m : GL (Fin 3) F) :
    ∃ m' : GL (Fin 3) F, graph F * linearConj F m = linearConj F m' * graph F :=
  ⟨inverseTransposeGL F m, graph_linearConj m⟩

private theorem mem_normalizer_of_conjugates {G : Type*} [Group G]
    (H : Subgroup G) (a : G)
    (hf : ∀ x ∈ H, a * x * a⁻¹ ∈ H)
    (hb : ∀ x ∈ H, a⁻¹ * x * a ∈ H) : a ∈ Subgroup.normalizer H := by
  rw [Subgroup.mem_normalizer_iff]
  intro x
  exact ⟨hf x, fun hx => by simpa [mul_assoc] using hb _ hx⟩

theorem fieldAction_mem_normalizer_innerDiagonal (σ : F ≃+* F) :
    fieldAction F σ ∈ Subgroup.normalizer (innerDiagonal F) := by
  have h (τ : F ≃+* F) : ∀ x ∈ innerDiagonal F,
      fieldAction F τ * x * (fieldAction F τ)⁻¹ ∈ innerDiagonal F := by
    rintro _ ⟨m, rfl⟩
    rw [field_linearConj, mul_inv_cancel_right]
    exact ⟨_, rfl⟩
  apply mem_normalizer_of_conjugates _ _ (h σ)
  simpa only [map_inv, inv_inv] using h σ⁻¹

theorem graph_mem_normalizer_innerDiagonal :
    graph F ∈ Subgroup.normalizer (innerDiagonal F) := by
  have hi : (graph F)⁻¹ = graph F := by
    apply inv_eq_of_mul_eq_one_right
    simpa only [pow_two] using graph_sq F
  have h : ∀ x ∈ innerDiagonal F,
      graph F * x * (graph F)⁻¹ ∈ innerDiagonal F := by
    rintro _ ⟨m, rfl⟩
    rw [graph_linearConj, mul_inv_cancel_right]
    exact ⟨_, rfl⟩
  exact mem_normalizer_of_conjugates _ _ h (by simpa only [hi] using h)

theorem standard_le_normalizer_innerDiagonal :
    standard F ≤ Subgroup.normalizer (innerDiagonal F) := by
  refine sup_le (sup_le (innerDiagonal F).le_normalizer ?_) ?_
  · rintro _ ⟨σ, rfl⟩
    exact fieldAction_mem_normalizer_innerDiagonal σ
  · exact Subgroup.zpowers_le.mpr graph_mem_normalizer_innerDiagonal

theorem innerDiagonal_map_outer :
    (innerDiagonal F).map (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F))) =
      innerDiagonalOuter F := by
  exact (MonoidHom.range_comp _ _).symm

theorem standardOuter_le_normalizer_innerDiagonalOuter :
    standardOuter F ≤ Subgroup.normalizer (innerDiagonalOuter F) := by
  rw [standardOuter, ← innerDiagonal_map_outer]
  exact (Subgroup.map_mono standard_le_normalizer_innerDiagonal).trans
    (Subgroup.le_normalizer_map _)

/-- Normality is inside the standard image, with no ambient coverage premise. -/
instance innerDiagonalOuter_subgroupOf_standardOuter_normal :
    ((innerDiagonalOuter F).subgroupOf (standardOuter F)).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer
    standardOuter_le_normalizer_innerDiagonalOuter

variable (F)

/-- Field automorphisms, with codomain restricted to the standard subgroup. -/
def fieldActionStandard : (F ≃+* F) →* standard F :=
  (fieldAction F).codRestrict (standard F) (fieldAction_mem_standard F)

/-- The actual graph element in the standard subgroup. -/
def graphStandard : standard F := ⟨graph F, graph_mem_standard F⟩

private def linearConjStandard : GL (Fin 3) F →* standard F :=
  (linearConj F).codRestrict (standard F) (linearConj_mem_standard F)

private theorem standard_generators :
    (linearConjStandard F).range ⊔ (fieldActionStandard F).range ⊔
      Subgroup.zpowers (graphStandard F) = ⊤ := by
  apply Subgroup.map_injective (standard F).subtype_injective
  rw [Subgroup.map_sup, Subgroup.map_sup, ← MonoidHom.range_comp,
    ← MonoidHom.range_comp, MonoidHom.map_zpowers, ← MonoidHom.range_eq_map,
    Subgroup.range_subtype]
  rfl

/-- The projection from standard automorphisms onto their actual outer image. -/
def standardOuterMap : standard F →* standardOuter F :=
  (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F))).subgroupMap (standard F)

theorem standardOuterMap_surjective : Function.Surjective (standardOuterMap F) :=
  MonoidHom.subgroupMap_surjective _ _

/-- The relative field–graph quotient of the standard outer image. -/
abbrev StandardOuterQuotient :=
  standardOuter F ⧸ (innerDiagonalOuter F).subgroupOf (standardOuter F)

/-- Projection through the actual inner and diagonal images. -/
def standardQuotientMap : standard F →* StandardOuterQuotient F :=
  (QuotientGroup.mk' ((innerDiagonalOuter F).subgroupOf (standardOuter F))).comp
    (standardOuterMap F)

theorem standardQuotientMap_surjective : Function.Surjective (standardQuotientMap F) :=
  (QuotientGroup.mk'_surjective _).comp (standardOuterMap_surjective F)

/-- The genuine field action in the relative outer quotient. -/
def fieldStandardQuotient : (F ≃+* F) →* StandardOuterQuotient F :=
  (standardQuotientMap F).comp (fieldActionStandard F)

/-- The genuine inverse-transpose element in the relative outer quotient. -/
def graphStandardQuotient : StandardOuterQuotient F :=
  standardQuotientMap F (graphStandard F)

/-- The relative quotient is generated by its field and graph images. -/
theorem standardOuterQuotient_generators :
    (fieldStandardQuotient F).range ⊔ Subgroup.zpowers (graphStandardQuotient F) = ⊤ := by
  have hd : (linearConjStandard F).range.map (standardQuotientMap F) = ⊥ := by
    apply le_bot_iff.mp
    rintro _ ⟨_, ⟨m, rfl⟩, rfl⟩
    change standardQuotientMap F (linearConjStandard F m) = 1
    apply (QuotientGroup.eq_one_iff _).mpr
    exact ⟨m, rfl⟩
  have h := congrArg (Subgroup.map (standardQuotientMap F)) (standard_generators F)
  rw [Subgroup.map_sup, Subgroup.map_sup, hd, bot_sup_eq,
    ← MonoidHom.range_comp, MonoidHom.map_zpowers,
    Subgroup.map_top_of_surjective _ (standardQuotientMap_surjective F)] at h
  exact h

theorem fieldStandardQuotient_commute_graph (σ : F ≃+* F) :
    Commute (fieldStandardQuotient F σ) (graphStandardQuotient F) := by
  have h : Commute (fieldActionStandard F σ) (graphStandard F) :=
    Subtype.ext (field_commute_graph σ)
  exact h.map (standardQuotientMap F)

theorem graphStandardQuotient_sq : graphStandardQuotient F ^ 2 = 1 := by
  have h : graphStandard F ^ 2 = 1 := Subtype.ext (graph_sq F)
  change standardQuotientMap F (graphStandard F) ^ 2 = 1
  rw [← map_pow, h, map_one]

/-- The field image is cyclic for every finite field. -/
theorem fieldStandardQuotient_isCyclic [Finite F] :
    IsCyclic (fieldStandardQuotient F).range := by
  let := BenderSuzuki.MatrixGroups.HermitianForm.finiteFieldAut_isCyclic (E := F)
  exact isCyclic_of_surjective _ (fieldStandardQuotient F).rangeRestrict_surjective

private theorem isMulCommutative_of_surjective {G H : Type*} [Group G] [Group H]
    [IsMulCommutative G] (f : G →* H) (hf : Function.Surjective f) :
    IsMulCommutative H := by
  refine ⟨⟨fun x y => ?_⟩⟩
  obtain ⟨a, rfl⟩ := hf x
  obtain ⟨b, rfl⟩ := hf y
  rw [← map_mul, ← map_mul, IsMulCommutative.is_comm.comm a b]

/-- The actual relative quotient is abelian, without an automorphism-coverage
or ambient-normality hypothesis. -/
theorem standardOuterQuotient_isMulCommutative [Finite F] :
    IsMulCommutative (StandardOuterQuotient F) := by
  let := BenderSuzuki.MatrixGroups.HermitianForm.finiteFieldAut_isCyclic (E := F)
  let f := fieldStandardQuotient F
  let g := graphStandardQuotient F
  have hc : ∀ σ (z : Subgroup.zpowers g),
      Commute (f σ) ((Subgroup.zpowers g).subtype z) := by
    intro σ ⟨z, hz⟩
    obtain ⟨n, rfl⟩ := hz
    exact (fieldStandardQuotient_commute_graph F σ).zpow_right n
  let φ := f.noncommCoprod (Subgroup.zpowers g).subtype hc
  apply isMulCommutative_of_surjective φ
  apply MonoidHom.range_eq_top.mp
  exact (MonoidHom.noncommCoprod_range f (Subgroup.zpowers g).subtype hc).trans
    (by rw [Subgroup.range_subtype]; exact standardOuterQuotient_generators F)

/-- The concrete standard outer image of PSL₃ over every finite field is
solvable: its diagonal subgroup and its relative quotient are abelian. -/
theorem standardOuter_isSolvable [Finite F] : Group.IsSolvable (standardOuter F) := by
  let := innerDiagonalOuter_isMulCommutative F
  let := standardOuterQuotient_isMulCommutative F
  apply (Group.isSolvable_iff_subgroup_quotient
    ((innerDiagonalOuter F).subgroupOf (standardOuter F))).mpr
  exact ⟨Group.isSolvable_of_comm IsMulCommutative.is_comm.comm,
    Group.isSolvable_of_comm IsMulCommutative.is_comm.comm⟩

private theorem standardOuter_eq_top_of_coverage (hcover : standard F = ⊤) :
    standardOuter F = ⊤ := by
  rw [standardOuter, hcover, Subgroup.map_top_of_surjective _
    (QuotientGroup.mk'_surjective _)]

/-- Coverage upgrades relative diagonal normality to ambient normality. -/
theorem innerDiagonalOuter_normal_of_coverage (hcover : standard F = ⊤) :
    (innerDiagonalOuter F).Normal := by
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_unique
  rw [← standardOuter_eq_top_of_coverage F hcover]
  exact standardOuter_le_normalizer_innerDiagonalOuter

/-- With coverage, the ambient outer/diagonal quotient is the image of the
abelian relative quotient. The normality instance may be the one just proved. -/
theorem outerDiagonalQuotient_isMulCommutative_of_coverage [Finite F]
    (hcover : standard F = ⊤) [(innerDiagonalOuter F).Normal] :
    IsMulCommutative (MulAut.Outer PSL(3,F) ⧸ innerDiagonalOuter F) := by
  let := standardOuterQuotient_isMulCommutative F
  let N := (innerDiagonalOuter F).subgroupOf (standardOuter F)
  let φ := QuotientGroup.map N (innerDiagonalOuter F) (standardOuter F).subtype le_rfl
  apply isMulCommutative_of_surjective φ
  apply QuotientGroup.map_surjective_of_surjective
  intro x
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (innerDiagonalOuter F) x
  exact ⟨⟨y, by rw [standardOuter_eq_top_of_coverage F hcover]; trivial⟩, rfl⟩

end Matrix.PSL3.OuterSolvable
