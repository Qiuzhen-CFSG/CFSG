module

public import Theory.SpecificGroups.PSL3Even.AutomorphismTwoRank.Coverage
public import Theory.SpecificGroups.PSL3Even.AutomorphismTwoRank.Coverage.RootOrientation

/-!
# Standard automorphism coverage for PSL₃ over binary fields

The field-order hypothesis supplies characteristic two. Opposite-unipotent
normalization, the characteristic-two root orientation and root rigidity then
express every automorphism using the actual diagonal, field and graph actions.
The intrinsic result includes the fields of orders two and four; the source
adapter retains the consumer's inherited simplicity and nonsolvability inputs.

Source: GLS3, Theorem 2.5.12(a) and §2.7, in
`refs/KGroup/GLS3/chapter2.tex`. This supplies the concrete coverage input to
the outer-solvability calculation for recognized binary PSL₃ components.
-/

public section

open scoped MatrixGroups

namespace Matrix.PSL3.OuterSolvable

variable (F : Type*) [Field F] [Finite F]

/-- Every automorphism over a field of positive binary degree belongs to the
concrete subgroup generated by diagonal, field and graph automorphisms. -/
theorem standard_eq_top_of_two_power_card {m : ℕ}
    (hm : 0 < m) (hF : Nat.card F = 2 ^ m) : standard F = ⊤ := by
  let := Fintype.ofFinite F
  have hc : ringChar F = 2 := FiniteField.even_card_iff_char_two.mpr (by
    rw [← Nat.card_eq_fintype_card, hF]
    simp [Nat.pow_mod, Nat.ne_of_gt hm])
  let : CharP F 2 := ringChar.of_eq hc
  exact Matrix.PSL3Even.AutomorphismCoverage.standard_eq_top_of_root_orientation F hm hF
    (Matrix.PSL3Even.AutomorphismCoverage.exists_oppositionGraph_preserves_roots_of_charTwo F)

/-- The binary coverage input in the source consumer's inherited simple,
nonsolvable domain, including degrees one and two. -/
theorem standard_eq_top [IsSimpleGroup PSL(3,F)]
    (_hns : ¬ Group.IsSolvable PSL(3,F)) (m : ℕ)
    (hm : 0 < m) (hF : Nat.card F = 2 ^ m) : standard F = ⊤ :=
  standard_eq_top_of_two_power_card F hm hF

end Matrix.PSL3.OuterSolvable
