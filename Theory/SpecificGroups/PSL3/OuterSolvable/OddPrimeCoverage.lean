module

public import Theory.SpecificGroups.PSL3.OuterSolvable.Actions
public import Theory.SpecificGroups.PSL3.OuterSolvable.OddPrimeCoverage.RootRigidity
public import Theory.SpecificGroups.PSL3.OuterSolvable.OddPrimeCoverage.UnipotentGeometry
public import Theory.SpecificGroups.PSL3.OuterSolvable.OddPrimeCoverage.OppositePair
public import Theory.SpecificGroups.PSL3.OuterSolvable.OddPrimeCoverage.RootOrientation

/-!
# Standard automorphism coverage for PSL₃ over odd prime fields

An inner correction makes an arbitrary automorphism preserve the two opposite
unipotent subgroups. Their Borel normalizers and diagonal involutions then
recover the six coordinate roots, up to the explicit A₂ diagram symmetry.
Root rigidity identifies the corrected automorphism with diagonal conjugation.
Every correction belongs to the concrete standard subgroup, proving coverage.

The conditional assembly lemma is retained, and the final theorem discharges
both geometric premises. This proves the generation assertion in the odd-prime
A₂ specialization of GLS3, Theorem 2.5.12(a), with the actual quotient and
matrix actions from §2.7, `refs/KGroup/GLS3/chapter2.tex`, lines 1111–1115.
The prime three is included. Simplicity and nonsolvability are inherited from
the consumer; no automorphism lift or semilinearity is assumed.
-/

public section

open scoped MatrixGroups
namespace Matrix.PSL3.OuterSolvable.OddPrimeCoverage
variable {F : Type*} [Field F] [Finite F]

/-- Conditional assembly of actual standard-automorphism coverage. Both geometric
premises must be discharged before using this as the source coverage theorem. -/
theorem standard_eq_top_of_geometric_normalization {p : ℕ}
    (hp : p.Prime) (hF : Nat.card F = p)
    (normalize : ∀ α : MulAut PSL(3,F),
      ∃ g : PSL(3,F), PreservesUnipotentPair F (MulAut.conj g * α))
    (orient : ∀ α : MulAut PSL(3,F), PreservesUnipotentPair F α →
      ∃ ε : Fin 2, PreservesRootGroups ((oppositionGraph F ^ (ε : ℕ))⁻¹ * α)) :
    standard F = ⊤ := by
  apply top_unique
  intro α _
  obtain ⟨g, hg⟩ := normalize α
  obtain ⟨ε, hε⟩ := orient (MulAut.conj g * α) hg
  have hβ := mem_standard_of_preservesRootGroups hp hF _ hε
  have hγ := (standard F).pow_mem (oppositionGraph_mem_standard F) (ε : ℕ)
  have hδ : MulAut.conj g * α ∈ standard F := by
    simpa only [mul_inv_cancel_left] using (standard F).mul_mem hγ hβ
  have hi : MulAut.conj g ∈ standard F := inner_le_standard F ⟨g, rfl⟩
  simpa only [inv_mul_cancel_left] using (standard F).mul_mem ((standard F).inv_mem hi) hδ

end Matrix.PSL3.OuterSolvable.OddPrimeCoverage

namespace Matrix.PSL3.OuterSolvable
variable (F : Type*) [Field F] [Finite F] [IsSimpleGroup PSL(3,F)]

/-- Every automorphism of PSL₃ over an odd prime field belongs to the subgroup
generated by GL₃ conjugation, entrywise field automorphisms and inverse transpose.
This includes the prime three and discharges both geometric normalization steps. -/
theorem standard_eq_top_of_odd_prime_card
    (hns : ¬ Group.IsSolvable PSL(3,F)) {p : ℕ}
    (hp : p.Prime) (hodd : Odd p) (hF : Nat.card F = p) :
    standard F = ⊤ :=
  OddPrimeCoverage.standard_eq_top_of_geometric_normalization hp hF
    (OddPrimeCoverage.exists_inner_preserves_pair F hns hp hodd hF)
    (OddPrimeCoverage.exists_oppositionGraph_preserves_roots hns p hp hodd hF)

end Matrix.PSL3.OuterSolvable
