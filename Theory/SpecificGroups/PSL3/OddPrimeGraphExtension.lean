module

public import Theory.SpecificGroups.PSL3.OddInvolutionFixed.NormalForm
public import Theory.GroupTheory.GeneralizedFitting.CoprimeOuterSupplement
public import Theory.AtlasPort.ExceptionalIsomorphisms.Elementary

/-!
# Proper two-extensions of PSL₃ over odd prime fields

Let a finite group have simple generalized Fitting subgroup PSL₃(F), with F
of odd prime order, and be generated by that subgroup and a Sylow two-group.
If the extension is proper, it is isomorphic to the actual subgroup generated
by inner automorphisms and inverse transpose.

The proof uses the checked automorphism normal form. The diagonal image in
Aut/Inn has exponent three. The graph image consequently generates a Sylow
two-subgroup of this literal quotient: any larger two-subgroup would meet the
diagonal three-group trivially and so add no elements. Sylow conjugacy aligns
the entire outer image, and there is no intermediate subgroup above Inn in
the inner-and-graph join. Faithfulness follows from the centerless generalized
Fitting subgroup and the given Sylow supplement. No splitting, chosen outer
involution, or unproved automorphism coverage is used.

Source: GLS3, Theorem 2.5.12(a) and §2.7, and the extension reduction for
Aschbacher--Smith E.1.14(7), printed p.214. Perfectness is reused from the
attributed ATLAS port in `Theory/AtlasPort/ExceptionalIsomorphisms/Elementary.lean`;
its source attribution and license remain in the imported development.
-/

public section
open Subgroup
open scoped MatrixGroups Pointwise

namespace Matrix.PSL3.OddPrimeGraphExtension
variable {F : Type*} [Field F]
open OuterSolvable

/-- The literal subgroup of Aut(PSL₃(F)) generated by inner automorphisms and
inverse transpose. This definition does not assert a semidirect decomposition. -/
@[expose] def graphExtension (F : Type*) [Field F] : Subgroup (MulAut PSL(3,F)) :=
  MulAut.innerSubgroup PSL(3,F) ⊔ zpowers (graph F)

private theorem twoSylow_of_cubic_normal_form {Q : Type*} [Group Q]
    (D : Subgroup Q) (hD : IsPGroup 3 D) (b : Q) (hb : b ^ 2 = 1)
    (hnf : ∀ x : Q, ∃ d ∈ D, x = d ∨ x = d * b) :
    ∃ S : Sylow 2 Q, (S : Subgroup Q) = zpowers b := by
  have hC : IsPGroup 2 (zpowers b) := IsPGroup.of_card_dvd_pow (n := 1) (by
    simpa only [Nat.card_zpowers, pow_one] using orderOf_dvd_of_pow_eq_one hb)
  refine ⟨{ toSubgroup := zpowers b, isPGroup' := hC, is_maximal' := ?_ }, rfl⟩
  intro P hP hCP
  apply le_antisymm _ hCP
  intro x hx
  have hdis : ∀ {d : Q}, d ∈ D → d ∈ P → d = 1 := Subgroup.disjoint_def.mp (hD.disjoint_of_coprime hP (by decide))
  obtain ⟨d, hd, h | h⟩ := hnf x
  · have hd1 : d = 1 := hdis hd (h ▸ hx)
    simp [h, hd1]
  · have hbP : b ∈ P := hCP (mem_zpowers b)
    have hdP : d ∈ P := by
      have := P.mul_mem hx (P.inv_mem hbP)
      simpa only [h, mul_inv_cancel_right] using this
    have hd1 : d = 1 := hdis hd hdP
    simpa only [h, hd1, one_mul] using mem_zpowers b

/-- The graph image generates a Sylow two-subgroup of the actual outer quotient. -/
theorem exists_outer_sylow [Finite F] [IsSimpleGroup PSL(3,F)]
    (hns : ¬ Group.IsSolvable PSL(3,F)) {p : ℕ}
    (hp : p.Prime) (ho : Odd p) (hF : Nat.card F = p) :
    ∃ S : Sylow 2 (MulAut.Outer PSL(3,F)),
      (S : Subgroup (MulAut.Outer PSL(3,F))) =
        zpowers (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F)) (graph F)) := by
  let q := QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F))
  have hD : IsPGroup 3 (innerDiagonalOuter F) := by
    intro x
    refine ⟨1, Subtype.ext ?_⟩
    obtain ⟨g, hg⟩ := x.property
    change (x : MulAut.Outer PSL(3,F)) ^ (3 ^ 1) = 1
    rw [pow_one, ← hg]
    change (q (linearConj F g)) ^ 3 = 1
    rw [← map_pow]
    change QuotientGroup.mk (linearConj F g ^ 3) = 1
    rw [QuotientGroup.eq_one_iff]
    exact OddInvolutionFixed.linearConj_cube_inner g
  apply twoSylow_of_cubic_normal_form (innerDiagonalOuter F) hD (q (graph F))
  · rw [← map_pow, graph_sq, map_one]
  · intro x
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective _ x
    obtain ⟨g, h | h⟩ := OddInvolutionFixed.automorphism_normal_form hns hp ho hF a
    · exact ⟨q (linearConj F g), ⟨g, rfl⟩, Or.inl (congrArg q h)⟩
    · exact ⟨q (linearConj F g), ⟨g, rfl⟩, Or.inr (by rw [h, map_mul])⟩

/-- Every two-subgroup of the outer quotient can be aligned with the fixed graph
image. The lift is an actual automorphism of the projective matrix group. -/
theorem exists_conjugate_le_graphExtension [Finite F] [IsSimpleGroup PSL(3,F)]
    (hns : ¬ Group.IsSolvable PSL(3,F)) {p : ℕ}
    (hp : p.Prime) (ho : Odd p) (hF : Nat.card F = p)
    (H : Subgroup (MulAut PSL(3,F)))
    (hH : IsPGroup 2 (H.map (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F))))) :
    ∃ a : MulAut PSL(3,F), H.map (MulAut.conj a).toMonoidHom ≤ graphExtension F := by
  let q := QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F))
  obtain ⟨S, hS⟩ := exists_outer_sylow hns hp ho hF
  obtain ⟨P, hP⟩ := hH.exists_le_sylow
  obtain ⟨b, hb⟩ := MulAction.exists_smul_eq (MulAut.Outer PSL(3,F)) P S
  obtain ⟨a, ha⟩ := QuotientGroup.mk'_surjective (MulAut.innerSubgroup PSL(3,F)) b
  change q a = b at ha
  refine ⟨a, ?_⟩
  have hm : (H.map (MulAut.conj a).toMonoidHom).map q ≤ zpowers (q (graph F)) := by
    calc
      _ = (H.map q).map (MulAut.conj b).toMonoidHom := by
        rw [Subgroup.map_map, Subgroup.map_map]
        congr 1
        ext x
        simp [ha]
      _ ≤ (P : Subgroup _).map (MulAut.conj b).toMonoidHom := map_mono hP
      _ = (S : Subgroup _) := congrArg Sylow.toSubgroup hb
      _ = _ := hS
  have hc : (zpowers (q (graph F))).comap q = graphExtension F := by
    rw [← MonoidHom.map_zpowers, comap_map_eq, QuotientGroup.ker_mk', sup_comm]
    rfl
  exact hc ▸ map_le_iff_le_comap.mp hm

private theorem eq_one_or_eq_of_mem_zpowers {Q : Type*} [Group Q] [Finite Q]
    {b x : Q} (hb : b ^ 2 = 1) (hx : x ∈ zpowers b) : x = 1 ∨ x = b := by
  obtain ⟨n, rfl⟩ := (isOfFinOrder_of_finite b).mem_powers_iff_mem_zpowers.mpr hx
  clear hx
  induction n with
  | zero => exact Or.inl (pow_zero b)
  | succ n ih =>
    change b ^ n = 1 ∨ b ^ n = b at ih
    change b ^ (n + 1) = 1 ∨ b ^ (n + 1) = b
    rcases ih with h | h
    · exact Or.inr (by rw [pow_succ, h, one_mul])
    · exact Or.inl (by rw [pow_succ, h, ← pow_two, hb])

/-- There is no intermediate subgroup strictly between the inner group and
its join with the inverse-transpose involution. -/
theorem eq_graphExtension_of_inner_lt {H : Subgroup (MulAut PSL(3,F))}
    [Finite F] (hinner : MulAut.innerSubgroup PSL(3,F) < H)
    (hH : H ≤ graphExtension F) : H = graphExtension F := by
  apply le_antisymm hH
  apply sup_le hinner.le
  apply zpowers_le.mpr
  obtain ⟨x, hx, hxi⟩ := SetLike.exists_of_lt hinner
  obtain ⟨i, hi, c, hc, he⟩ := mem_sup_of_normal_left.mp (hH hx)
  rcases eq_one_or_eq_of_mem_zpowers (graph_sq F) hc with h | h
  · have : x = i := by simpa [h] using he.symm
    exact (hxi (this ▸ hi)).elim
  · have hic : i * graph F ∈ H := by
      rw [← he, h] at hx
      exact hx
    have := H.mul_mem (H.inv_mem (hinner.le hi)) hic
    simpa only [inv_mul_cancel_left] using this

/-- Any proper subgroup above the inner group with a two-group outer image
is conjugate to the concrete graph extension. -/
theorem exists_conjugate_eq_graphExtension [Finite F] [IsSimpleGroup PSL(3,F)]
    (hns : ¬ Group.IsSolvable PSL(3,F)) {p : ℕ}
    (hp : p.Prime) (ho : Odd p) (hF : Nat.card F = p)
    (H : Subgroup (MulAut PSL(3,F)))
    (hinner : MulAut.innerSubgroup PSL(3,F) < H)
    (hH : IsPGroup 2 (H.map (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F))))) :
    ∃ a : MulAut PSL(3,F), H.map (MulAut.conj a).toMonoidHom = graphExtension F := by
  obtain ⟨a, ha⟩ := exists_conjugate_le_graphExtension hns hp ho hF H hH
  refine ⟨a, eq_graphExtension_of_inner_lt ?_ ha⟩
  have hn := normal_iff_map_conj_eq.mp (inferInstance : (MulAut.innerSubgroup PSL(3,F)).Normal) a
  rw [← hn]
  refine lt_iff_le_not_ge.mpr ⟨map_mono hinner.le, ?_⟩
  intro he
  apply hinner.not_ge
  have he' := Subgroup.map_le_map_iff.mp he
  simpa only [(MulAut.conj a).toMonoidHom.ker_eq_bot (MulAut.conj a).injective,
    sup_bot_eq] using he'

/-- Every proper Sylow two-extension of a simple PSL₃(p) generalized Fitting
subgroup is isomorphic to the literal inner-and-graph automorphism subgroup. -/
theorem exists_mulEquiv_graphExtension {G : Type*} [Group G] [Finite G]
    [Finite F] [IsSimpleGroup (Theory.GroupTheory.generalizedFitting G)]
    (T : Sylow 2 G)
    (hgen : Theory.GroupTheory.generalizedFitting G ⊔ (T : Subgroup G) = ⊤)
    (hproper : Theory.GroupTheory.generalizedFitting G ≠ ⊤)
    {p : ℕ} (hp : p.Prime) (ho : Odd p) (hF : Nat.card F = p)
    (e : Theory.GroupTheory.generalizedFitting G ≃* PSL(3,F)) :
    Nonempty (G ≃* graphExtension F) := by
  let L := Theory.GroupTheory.generalizedFitting G
  let _ : IsSimpleGroup PSL(3,F) := e.symm.isSimpleGroup
  let _ : Group.IsPerfect PSL(3,F) := Atlas.psl_perfect 3 (by decide)
  have hns := Group.IsPerfect.not_isSolvable PSL(3,F)
  have hZ : center L = ⊥ := by
    rcases (inferInstance : (center L).Normal).eq_bot_or_eq_top with h | h
    · exact h
    · have hcomm : ∀ x y : L, x * y = y * x := by
        intro x y
        exact (mem_center_iff.mp (h ▸ mem_top x) y).symm
      let _ := Group.isSolvable_of_comm hcomm
      exact (hns (Group.isSolvable_of_surjective (f := e.toMonoidHom) e.surjective)).elim
  have hc := Theory.GroupTheory.centralizer_generalizedFitting_eq_bot_of_centerless_supplement
    T hgen hZ
  let f : G →* MulAut PSL(3,F) :=
    (MulAut.congr e).toMonoidHom.comp (MulAut.conjNormal : G →* MulAut L)
  have hf : Function.Injective f := (MulAut.congr e).injective.comp
    (MulAut.conjNormal_injective_of_centralizer_eq_bot L hc)
  have hmap : L.map f = MulAut.innerSubgroup PSL(3,F) := by
    have hn : L.map (MulAut.conjNormal : G →* MulAut L) = MulAut.innerSubgroup L := by
      ext a
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact ⟨⟨x, hx⟩, MulAut.conjNormal_val.symm⟩
      · rintro ⟨x, rfl⟩
        exact ⟨x, x.property, MulAut.conjNormal_val⟩
    dsimp only [f]
    rw [← Subgroup.map_map, hn, MulAut.map_innerSubgroup_congr]
  let H := f.range
  have hinner : MulAut.innerSubgroup PSL(3,F) < H := by
    refine lt_iff_le_not_ge.mpr ⟨?_, ?_⟩
    · rw [← hmap]
      exact L.map_le_range f
    · intro h
      apply hproper
      apply top_unique
      have hm : (⊤ : Subgroup G).map f ≤ L.map f := by
        rw [← MonoidHom.range_eq_map, hmap]
        exact h
      have ht := Subgroup.map_le_map_iff.mp hm
      simpa only [f.ker_eq_bot hf, sup_bot_eq] using ht
  have hH : H = MulAut.innerSubgroup PSL(3,F) ⊔ (T : Subgroup G).map f := by
    have hm := congrArg (Subgroup.map f) hgen
    rw [Subgroup.map_sup, hmap, ← MonoidHom.range_eq_map] at hm
    exact hm.symm
  have htwo : IsPGroup 2 (H.map (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F)))) := by
    rw [hH, Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq, Subgroup.map_map]
    exact T.isPGroup'.map _
  obtain ⟨a, ha⟩ := exists_conjugate_eq_graphExtension hns hp ho hF H hinner htwo
  exact ⟨(MonoidHom.ofInjective hf).trans
    ((H.equivMapOfInjective (MulAut.conj a).toMonoidHom (MulAut.conj a).injective).trans
      (MulEquiv.subgroupCongr ha))⟩

end Matrix.PSL3.OddPrimeGraphExtension
