module
public import Theory.SpecificGroups.PSL3.OddPrimeGraphExtension
public import Theory.SpecificGroups.OddThreeRank
public import Theory.GroupTheory.PrimeRankHom
public import Theory.GroupTheory.AutomorphismTowerSimple

/-!
# Two-rank of the odd-prime PSL₃ automorphism group

The inner group has two-rank at most two. The literal outer quotient has a
cyclic Sylow two-subgroup generated by the image of inverse transpose, so its
two-rank is at most one. Applying the kernel-and-image rank inequality to
Aut → Out proves the bound three. Simplicity and nonsolvability are inherited
from the actual central quotient in the source application.

Source: Guralnick–Malle, *Classification of 2F-modules I*, Proposition 4.2,
manuscript pp.9–10; Aschbacher–Smith K.2, printed p.453. The uniform odd-prime
bound also uses the proved standard automorphism coverage, GLS3 2.5.12(a).
-/

public section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
namespace Matrix.PSL3.OddPrimeActorRank
variable {F : Type*} [Field F] [Finite F] [IsSimpleGroup PSL(3,F)]

/-- The full automorphism group of an odd-prime PSL₃ has two-rank at most three. -/
theorem automorphism_two_rank
    (hns : ¬ Group.IsSolvable PSL(3,F)) {p : ℕ}
    (hp : p.Prime) (ho : Odd p) (hF : Nat.card F = p) :
    primeRank 2 (MulAut PSL(3,F)) ≤ 3 := by
  have hz : center PSL(3,F) = ⊥ := by
    rcases (inferInstance : (center PSL(3,F)).Normal).eq_bot_or_eq_top with h | h
    · exact h
    · have hcomm : ∀ x y : PSL(3,F), x * y = y * x := by
        intro x y
        exact (mem_center_iff.mp (h ▸ mem_top x) y).symm
      exact (hns (Group.isSolvable_of_comm hcomm)).elim
  let e : PSL(3,F) ≃* MulAut.innerSubgroup PSL(3,F) :=
    MonoidHom.ofInjective (MulAut.conj_injective_of_center_eq_bot hz)
  obtain ⟨P, hP⟩ := OddPrimeGraphExtension.exists_outer_sylow hns hp ho hF
  have hcyc : IsCyclic P := by
    rw [hP]
    infer_instance
  have hrout := P.primeRank_le_one_of_isCyclic hcyc
  change primeRank 2 (MulAut PSL(3,F) ⧸ MulAut.innerSubgroup PSL(3,F)) ≤ 1 at hrout
  have hr := primeRank_le_ker_add (p := 2)
    (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F)))
  rw [QuotientGroup.ker_mk', ← primeRank_equiv 2 e] at hr
  have hrin := Theory.SpecificGroups.OddThreeRank.psl3_primeRank_two_le hp ho hF
  omega
end Matrix.PSL3.OddPrimeActorRank
