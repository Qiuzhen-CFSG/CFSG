module

public import Theory.SpecificGroups.PSL3.CartanActions.BorelResidual

/-!
# Cubic elements generate the positive roots of a PSL₃ Borel

A nontrivial cube root of unity supplies two determinant-one diagonal
matrices of cube one. They scale the two simple root groups nontrivially.
The scalar commutator lemma places those roots in the normal closure of
the cubic elements inside the special linear Borel; their commutator
supplies the central positive root. Projecting retains each generator
or kills it, so the result descends to the exact order-three closure in PSL₃.

The proof applies whenever three divides q-1, including when nine divides
q-1. No condition on the three-part of the torus order is imposed.
Source: Aschbacher--Smith, combined manuscript (1 March 2004), final paragraph
of 15.3.37, printed p.1135, with the split torus discussion in A.3.18,
printed pp.52--53.
-/

public section

open scoped MatrixGroups
open Subgroup Matrix Matrix.PSL3.LinearThree Matrix.PSL3.CartanActions
open Matrix.PSL3.CartanActions.BorelQuotient Matrix.PSL3Even.UnipotentGeometry

namespace Matrix.PSL3.CubicBorel

private theorem cubicClosure_normal {G : Type*} [Group G] :
    (closure {z : G | orderOf z = 3}).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [le_normalizer_closure_iff]
  intro g _ z hz
  exact subset_closure ((MulAut.conj g).orderOf_eq z |>.trans hz)

private theorem cubic_mem {G : Type*} [Group G] (z : G) (hz : z ^ 3 = 1) :
    z ∈ closure {z : G | orderOf z = 3} := by
  by_cases h : z = 1
  · subst z; exact one_mem _
  · have : Fact (Nat.Prime 3) := ⟨by decide⟩
    exact subset_closure (orderOf_eq_prime hz h)

variable (F : Type*) [Field F] [Finite F]

/-- The two simple roots are commutators with cubic diagonal elements.
Their central commutator supplies the third positive root. -/
theorem unipotent_le_cubicClosure_of_three_dvd (hthree : 3 ∣ Nat.card F - 1) :
    unipotent F ≤ closure {z | z ∈ borel F ∧ orderOf z = 3} := by
  have : Fact (Nat.Prime 3) := ⟨by decide⟩
  obtain ⟨a, ha⟩ := exists_prime_orderOf_dvd_card' (G := Fˣ) 3 (by
    rwa [Nat.card_units])
  have ha3 : a ^ 3 = 1 := ha ▸ pow_orderOf_eq_one a
  have ha1 : a ≠ 1 := by intro h; simp [h] at ha
  let N : Subgroup (borelSL F) := closure {z | orderOf z = 3}
  have : N.Normal := cubicClosure_normal
  have ht (d : Fˣ × Fˣ) (hd : d ^ 3 = 1) : torusInBorelSL F d ∈ N :=
    cubic_mem _ (by rw [← map_pow, hd, map_one])
  have hU : (unipotentInBorelSL F).range ≤ N := by
    apply range_le_of_roots F (unipotentInBorelSL F)
    · apply scalar_root_le_normal N _ (torusInBorelSL F (1,a))
        (ht (1,a) (Prod.ext (one_pow 3) ha3)) (a : F)
        (fun h => ha1 (Units.ext h))
      exact torus_firstRoot F a
    · apply scalar_root_le_normal N _ (torusInBorelSL F (a,1))
        (ht (a,1) (Prod.ext ha3 (one_pow 3))) ((a⁻¹ : Fˣ) : F)
        (fun h => ha1 (inv_eq_one.mp (Units.ext h)))
      exact torus_secondRoot F a
  let f : borelSL F →* PSL(3,F) := (projection F).comp (borelSL F).subtype
  have hmap : N ≤ (closure {z | z ∈ borel F ∧ orderOf z = 3}).comap f := by
    apply (closure_le _).mpr
    intro x hx
    change f x ∈ Subgroup.closure _
    by_cases he : f x = 1
    · rw [he]; exact one_mem _
    · apply Subgroup.subset_closure
      refine ⟨mem_map_of_mem (projection F) x.property, orderOf_eq_prime ?_ he⟩
      have hx3 : x ^ 3 = 1 := by
        simpa only [show orderOf x = 3 from hx] using pow_orderOf_eq_one x
      rw [← map_pow, hx3, map_one]
  intro u hu
  obtain ⟨v, hv, rfl⟩ := hu
  obtain ⟨w, rfl⟩ := (specialLinear_range F).ge hv
  exact hmap (hU ⟨w, rfl⟩)

/-- All positive roots lie in the subgroup generated by cubic Borel elements
over every binary field of even degree, including degrees divisible by six. -/
theorem unipotent_le_cubicClosure {n : ℕ} (he : Even n) (hF : Nat.card F = 2 ^ n) :
    unipotent F ≤ closure {z | z ∈ borel F ∧ orderOf z = 3} := by
  apply unipotent_le_cubicClosure_of_three_dvd
  rw [hF, Nat.dvd_iff_mod_eq_zero]
  obtain ⟨k, rfl⟩ := he
  have hm : 2 ^ (k + k) % 3 = 1 := by
    rw [← two_mul, pow_mul, Nat.pow_mod]
    norm_num
  have hp : 0 < (2 : ℕ) ^ (k + k) := pow_pos (by decide) _
  omega

end Matrix.PSL3.CubicBorel
