module

public import Theory.SpecificGroups.PSL3Four.InnerInvolutionCentralizers.UnipotentCubic
public import Theory.GroupAction.CoprimeHall
public import Theory.Frattini.PGroup

/-!
# Intrinsic calculations in the Sylow coordinates

A noncentral element of a normal subgroup forces every central parameter
by commutators with a simple root. For a subgroup of order four this forces
it to be the centre. The cubic fixed-point calculation is transported from
the checked UT₃(F₄) model through an actual field isomorphism. Coprime
fixed-point generation and the central-root commutator formula then give
the full action commutator.

Source: Aschbacher--Smith, proof of 15.3.38, printed p.1136.
-/

@[expose] public section
open Subgroup
open scoped commutatorElement
open Matrix.PSL3Even.UnipotentGeometry
namespace Matrix.PSL3.LinearThree.CubicRootGeometry
variable {F : Type*} [Field F] [Finite F]

/-- A normal subgroup with the same order as the central root is that root. -/
theorem normal_four_coordinates (hF : Nat.card F = 4)
    (W : Subgroup (U F)) [W.Normal] (hW : Nat.card W = 4) : W = Z F := by
  have hcentral (a : U F) (ha : a ∈ W) (hn : a ∉ Z F) : Z F ≤ W := by
    intro z hz
    obtain ⟨hzx, hzy⟩ := (mem_Z F z).mp hz
    have hzform : z = ⟨0, 0, z.c⟩ := U.ext hzx hzy rfl
    rw [hzform]
    by_cases hx : a.x = 0
    · have hy : a.y ≠ 0 := fun hy => hn ((mem_Z F a).mpr ⟨hx, hy⟩)
      let b : U F := ⟨z.c / a.y, 0, 0⟩
      have he : b * a * b⁻¹ * a⁻¹ = ⟨0, 0, z.c⟩ := by
        apply U.ext <;> simp [b, mul_x, mul_y, mul_c, Inv.inv, hx, hy]
      rw [← he]
      exact W.mul_mem ((inferInstance : W.Normal).conj_mem a ha b) (W.inv_mem ha)
    · let b : U F := ⟨0, z.c / a.x, 0⟩
      have he : a * b * a⁻¹ * b⁻¹ = ⟨0, 0, z.c⟩ := by
        apply U.ext <;> simp [b, mul_x, mul_y, mul_c, Inv.inv]
        field_simp
        ring
      rw [show a * b * a⁻¹ * b⁻¹ = a * (b * a⁻¹ * b⁻¹) by group]
        at he
      rw [← he]
      exact W.mul_mem ha ((inferInstance : W.Normal).conj_mem a⁻¹ (W.inv_mem ha) b)
  have hle : W ≤ Z F := by
    intro a ha
    by_contra hn
    have he := eq_of_le_of_card_ge (hcentral a ha hn) (by rw [card_Z, hF, hW])
    exact hn (he.symm ▸ ha)
  exact eq_of_le_of_card_ge hle (by rw [card_Z, hF, hW])

/-- Entrywise transport of the literal unitriangular coordinates. -/
def coordinateEquiv {K : Type*} [Field K] (e : F ≃+* K) : U F ≃* U K where
  toFun a := ⟨e a.x, e a.y, e a.c⟩
  invFun a := ⟨e.symm a.x, e.symm a.y, e.symm a.c⟩
  left_inv a := by apply U.ext <;> simp
  right_inv a := by apply U.ext <;> simp
  map_mul' a b := by apply U.ext <;> simp

/-- Transport of the checked cubic calculation to any field of order four. -/
theorem cubic_fixed_coordinates (hF : Nat.card F = 4)
    (β : MulAut (U F)) (hne : β ≠ 1) (h3 : β ^ 3 = 1)
    (hZ : Z F ≤ β.fixedSubgroup) : β.fixedSubgroup = Z F := by
  let := Fintype.ofFinite F
  let := Fintype.ofFinite Matrix.PSL3Four.F
  let eF : F ≃+* Matrix.PSL3Four.F := FiniteField.ringEquivOfCardEq
    (by rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hF,
      Matrix.PSL3Four.card_F])
  let e := coordinateEquiv eF
  let γ := MulAut.congr e β
  have hγne : γ ≠ 1 := fun h => hne ((MulAut.congr e).injective
    (h.trans (map_one _).symm))
  have hγ3 : γ ^ 3 = 1 := by
    change (MulAut.congr e β) ^ 3 = 1
    rw [← map_pow, h3, map_one]
  have hγZ : γ ⟨0, 0, 1⟩ = ⟨0, 0, 1⟩ := by
    have hz : β ⟨0, 0, 1⟩ = ⟨0, 0, 1⟩ :=
      (MulAut.mem_fixedSubgroup _ _).mp (hZ ((mem_Z F _).mpr ⟨rfl, rfl⟩))
    change e (β (e.symm ⟨0, 0, 1⟩)) = _
    have he : e.symm ⟨0, 0, 1⟩ = ⟨0, 0, 1⟩ := by
      apply U.ext <;> simp [e, coordinateEquiv]
    rw [he, hz]
    apply U.ext <;> simp [e, coordinateEquiv]
  have hfix := Matrix.PSL3Four.InnerInvolutionCentralizers.UnipotentCubic.fixedSubgroup_eq_center
    γ hγne hγ3 hγZ
  apply le_antisymm _ hZ
  intro a ha
  have hea : e a ∈ γ.fixedSubgroup := by
    rw [MulAut.mem_fixedSubgroup]
    change e (β (e.symm (e a))) = e a
    rw [e.symm_apply_apply, (MulAut.mem_fixedSubgroup _ _).mp ha]
  rw [hfix, mem_Z] at hea
  apply (mem_Z F a).mpr
  exact ⟨eF.injective (hea.1.trans (map_zero eF).symm),
    eF.injective (hea.2.trans (map_zero eF).symm)⟩
omit [Finite F] in
/-- The highest root is generated by literal simple-root commutators. -/
theorem center_le_derived_coordinates : Z F ≤ _root_.commutator (U F) := by
  intro a ha
  obtain ⟨hx, hy⟩ := (mem_Z F a).mp ha
  have he : ⁅(⟨a.c,0,0⟩ : U F), (⟨0,1,0⟩ : U F)⁆ = a := by
    apply U.ext <;> simp [commutatorElement_def, mul_x, mul_y, mul_c, Inv.inv, hx, hy]
  rw [← he]
  exact commutator_mem_commutator (mem_top _) (mem_top _)

/-- Coprime fixed-point generation and the Frattini property give the full
commutator, including the central root fixed by the cubic. -/
theorem cubic_commutator_coordinates (hF : Nat.card F = 4)
    (β : MulAut (U F)) (hne : β ≠ 1) (h3 : β ^ 3 = 1)
    (hZ : Z F ≤ β.fixedSubgroup) :
    commutatorAction (zpowers β) (U F) = ⊤ := by
  have hp : IsPGroup 2 (U F) := IsPGroup.of_card (n := 6) (by rw [card_U, hF]; norm_num)
  let : Fact (IsPGroup 2 (U F)) := ⟨hp⟩
  let : Group.IsNilpotent (U F) := hp.isNilpotent
  have hfix : fixedPointSubgroup (zpowers β) (U F) = Z F := by
    rw [← cubic_fixed_coordinates hF β hne h3 hZ]
    ext a
    rw [MulAut.mem_fixedSubgroup]
    constructor
    · intro ha
      exact ha ⟨β, mem_zpowers β⟩
    · intro ha b
      exact smul_eq_self_of_mem_zpowers b.property ha
  have hcop : Nat.Coprime (Nat.card (zpowers β)) (Nat.card (U F)) := by
    rw [Nat.card_zpowers, card_U, hF]
    exact (show Nat.Coprime 3 (4 ^ 3) by decide).of_dvd_left
      (orderOf_dvd_of_pow_eq_one h3)
  have hsup := fixedPointSubgroup_sup_commutatorAction_eq_top_of_solvable_coprime
    (G := U F) (A := zpowers β) inferInstance hcop
  rw [hfix, sup_comm] at hsup
  apply frattini_nongenerating_of_isPGroup (p := 2)
  apply top_unique
  rw [← hsup]
  exact sup_le_sup_left
    (center_le_derived_coordinates.trans (commutator_le_frattini_of_isPGroup (p := 2))) _

end Matrix.PSL3.LinearThree.CubicRootGeometry
