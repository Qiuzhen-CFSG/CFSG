module

public import Theory.SpecificGroups.PSL3.ExtensionBorel.Linear

/-!
# Borels in actual linear-field extensions of PSL₃

The concrete actor Borel is generated by upper triangular linear actors and
coefficient-field actors. Coefficient transport normalizes the full linear
actor subgroup, so every actor has a linear-field expression. Since fields
preserve the upper-unitriangular group, its stabilizer consists exactly of
expressions with an upper triangular linear factor.

This calculation restricts to every actual subgroup between Inn(PSL₃) and
the inner-diagonal/field group. In particular it applies to the literal
preimage of ⟨f* d*⟩ under Aut → Out, preserving the component embedding and
without choosing a splitting. `MixedData` retains the linear source restriction
6 ∣ m and the independent commuting outer order-three actors. The source
specialization uses the existing upper-unitriangular Sylow for |F| = 2^m.

These identities discharge the intrinsic normalizer input of the Chapter 13
extension-Borel alignment. The source classification, compatible equivalence
on K*Lᵥ*, and Sylow alignment remain with its assembly owner.

Source: Aschbacher–Smith, `refs/quasithin.pdf`, Notation A.3.16 and Lemma A.3.18,
printed pp.51–52, and case (iii) and Borel placement in 13.6.6, printed p.927.
-/

@[expose] public section
open scoped MatrixGroups
open Subgroup Matrix Matrix.PSL3.LinearThree Matrix.PSL3.OuterSolvable
open Matrix.PSL3.CartanActions
namespace Matrix.PSL3.ExtensionBorel
variable (F : Type*) [Field F]
/-- The actual subgroup generated by inner-diagonal and coefficient actors. -/
def linearField : Subgroup (MulAut PSL(3,F)) := innerDiagonal F ⊔ (fieldAction F).range

/-- The concrete extension Borel, generated by triangular linear actors and fields. -/
def actorBorel : Subgroup (MulAut PSL(3,F)) := linearBorel F ⊔ (fieldAction F).range

private theorem field_normalizes_linear :
    (fieldAction F).range ≤ normalizer (innerDiagonal F) := by
  rintro _ ⟨σ,rfl⟩
  rw [mem_normalizer_iff]
  intro x
  constructor
  · rintro ⟨g,rfl⟩
    refine ⟨GeneralLinearGroup.map σ.toRingHom g, ?_⟩
    rw [ResidualLinear.field_linearConj, mul_inv_cancel_right]
  · intro hx
    have hi : fieldAction F σ⁻¹ * (fieldAction F σ * x * (fieldAction F σ)⁻¹) *
        (fieldAction F σ⁻¹)⁻¹ ∈ innerDiagonal F := by
      obtain ⟨g,hg⟩ := hx
      rw [← hg]
      refine ⟨GeneralLinearGroup.map σ⁻¹.toRingHom g, ?_⟩
      rw [ResidualLinear.field_linearConj, mul_inv_cancel_right]
    simpa [mul_assoc] using hi

/-- Every actor in the genuine generated subgroup has a linear-field expression. -/
theorem linearField_factorization (a : MulAut PSL(3,F)) (ha : a ∈ linearField F) :
    ∃ (g : GL (Fin 3) F) (σ : F ≃+* F), a = linearConj F g * fieldAction F σ := by
  change a ∈ (↑(innerDiagonal F ⊔ (fieldAction F).range) : Set _) at ha
  rw [Subgroup.coe_mul_of_right_le_normalizer_left _ _ (field_normalizes_linear F)] at ha
  obtain ⟨_,⟨g,rfl⟩,_,⟨σ,rfl⟩,rfl⟩ := ha
  exact ⟨g,σ,rfl⟩

private def preserving : Subgroup (MulAut PSL(3,F)) where
  carrier := {a | (unipotent F).map a.toMonoidHom = unipotent F}
  one_mem' := Subgroup.map_id _
  mul_mem' := by
    intro a b ha hb
    change (unipotent F).map (a.toMonoidHom.comp b.toMonoidHom) = _
    rw [← Subgroup.map_map, hb, ha]
  inv_mem' := by
    intro a ha
    change (unipotent F).map a⁻¹.toMonoidHom = _
    conv_lhs => rw [← ha]
    rw [Subgroup.map_map]
    have he : a⁻¹.toMonoidHom.comp a.toMonoidHom = MonoidHom.id _ := by
      apply MonoidHom.ext
      intro x
      exact a.symm_apply_apply x
    rw [he, Subgroup.map_id]

private theorem actorBorel_preserves : actorBorel F ≤ preserving F := by
  apply sup_le
  · rintro _ ⟨g,hg,rfl⟩
    exact linearConj_preserves F g hg
  · rintro _ ⟨σ,rfl⟩
    exact fieldAction_unipotent F σ

/-- The root stabilizer is calculated inside the actual linear-field subgroup. -/
theorem actor_preserves_iff [CharP F 2] (a : MulAut PSL(3,F)) (ha : a ∈ linearField F) :
    (unipotent F).map a.toMonoidHom = unipotent F ↔ a ∈ actorBorel F := by
  constructor
  · intro h
    obtain ⟨g,σ,rfl⟩ := linearField_factorization F a ha
    have hg : g ∈ glBorel F := ResidualLinear.linear_field_upperTriangular g σ h
    exact (actorBorel F).mul_mem (Subgroup.mem_sup_left (Subgroup.mem_map_of_mem _ hg))
      (Subgroup.mem_sup_right ⟨σ,rfl⟩)
  · intro h
    exact actorBorel_preserves F h

open Theory.GroupTheory.AutomorphismExtensionBorel

/-- The computed Borel in every actual intermediate automorphism extension. -/
theorem normalizer_extension_root [CharP F 2] (E : Subgroup (MulAut PSL(3,F)))
    (hinner : MulAut.innerSubgroup PSL(3,F) ≤ E) (hE : E ≤ linearField F) :
    normalizer (rootIn (unipotent F) E : Set E) = (actorBorel F).subgroupOf E :=
  normalizer_rootIn _ _ _ hinner (inner_injective F)
    (fun a => actor_preserves_iff F a.val (hE a.property))

/-- The diagonal-extension calculation with its literal inner embedding. -/
theorem normalizer_diagonal_root [CharP F 2] :
    normalizer (rootIn (unipotent F) (innerDiagonal F) : Set (innerDiagonal F)) =
      (linearBorel F).subgroupOf (innerDiagonal F) :=
  normalizer_rootIn _ _ _ (inner_le_innerDiagonal F) (inner_injective F)
    (fun a => linear_preserves_iff F a.val a.property)

/-- The literal outer quotient map used by A.3.16. -/
abbrev qOuter : MulAut PSL(3,F) →* MulAut.Outer PSL(3,F) :=
  QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F))

/-- The full mixed preimage; no splitting is chosen. -/
def mixedExtension (σ : F ≃+* F) (d : Fin 3 → Fˣ) : Subgroup (MulAut PSL(3,F)) :=
  outerPreimage (zpowers (qOuter F (fieldAction F σ) *
    qOuter F (linearConj F (OuterSolvable.OddPrimeCoverage.diagonalGL d))))

theorem inner_le_mixedExtension (σ : F ≃+* F) (d : Fin 3 → Fˣ) :
    MulAut.innerSubgroup PSL(3,F) ≤ mixedExtension F σ d := inner_le_outerPreimage _

/-- The actual field-diagonal preimage is an intermediate linear-field group. -/
theorem mixedExtension_le (σ : F ≃+* F) (d : Fin 3 → Fˣ) :
    mixedExtension F σ d ≤ linearField F :=
  mixed_outerPreimage_le _ ((inner_le_innerDiagonal F).trans le_sup_left) _ _
    (Subgroup.mem_sup_right ⟨σ,rfl⟩) (Subgroup.mem_sup_left ⟨_,rfl⟩)

/-- The normalizer identity on the literal mixed preimage. -/
theorem normalizer_mixed_root [CharP F 2] (σ : F ≃+* F) (d : Fin 3 → Fˣ) :
    normalizer (rootIn (unipotent F) (mixedExtension F σ d) : Set (mixedExtension F σ d)) =
      (actorBorel F).subgroupOf (mixedExtension F σ d) :=
  normalizer_extension_root F _ (inner_le_mixedExtension F σ d) (mixedExtension_le F σ d)

/-- The source's mixed order-three data, on actual coefficient and diagonal actors.
The degree restriction is retained even though the normalizer calculation is uniform. -/
structure MixedData (m : ℕ) where
  six_dvd : 6 ∣ m
  coefficient : F ≃+* F
  diagonal : Fin 3 → Fˣ
  field_order : orderOf (fieldAction F coefficient) = 3
  field_outer_order : orderOf (qOuter F (fieldAction F coefficient)) = 3
  diagonal_outer_order : orderOf
    (qOuter F (linearConj F (OuterSolvable.OddPrimeCoverage.diagonalGL diagonal))) = 3
  outer_commute : Commute (qOuter F (fieldAction F coefficient))
    (qOuter F (linearConj F (OuterSolvable.OddPrimeCoverage.diagonalGL diagonal)))
  outer_independent : Disjoint (zpowers (qOuter F (fieldAction F coefficient)))
    (zpowers (qOuter F (linearConj F (OuterSolvable.OddPrimeCoverage.diagonalGL diagonal))))

/-- A.3.16 specialization using the existing upper-unitriangular Sylow and
its actual component embedding into the mixed preimage. -/
theorem normalizer_source_mixed [Finite F] {m : ℕ} (hm : 1 < m)
    (hF : Nat.card F = 2 ^ m) (D : MixedData F m) :
    normalizer (((unipotentSylow F (by omega) hF : Subgroup PSL(3,F)).map
      (innerEmbedding (mixedExtension F D.coefficient D.diagonal)
        (inner_le_mixedExtension F D.coefficient D.diagonal))) :
        Set (mixedExtension F D.coefficient D.diagonal)) =
      (actorBorel F).subgroupOf (mixedExtension F D.coefficient D.diagonal) := by
  let := Fintype.ofFinite F
  have hc : ringChar F = 2 := FiniteField.even_card_iff_char_two.mpr (by
    rw [← Nat.card_eq_fintype_card, hF]
    simp [Nat.pow_mod, Nat.ne_of_gt (show 0 < m by omega)])
  let : CharP F 2 := ringChar.of_eq hc
  rw [coe_unipotentSylow, ← rootIn_eq_map]
  exact normalizer_mixed_root F D.coefficient D.diagonal

/-- The actual field-diagonal generator normalizes the embedded root group. -/
theorem mixed_generator_mem_normalizer [CharP F 2] (σ : F ≃+* F) (d : Fin 3 → Fˣ) :
    (⟨fieldAction F σ * linearConj F (OuterSolvable.OddPrimeCoverage.diagonalGL d),
      by change qOuter F (_ * _) ∈ zpowers _; rw [map_mul]; exact mem_zpowers _⟩ :
        mixedExtension F σ d) ∈ normalizer
          (rootIn (unipotent F) (mixedExtension F σ d) : Set (mixedExtension F σ d)) := by
  rw [normalizer_mixed_root]
  exact (actorBorel F).mul_mem (Subgroup.mem_sup_right ⟨σ,rfl⟩)
    (Subgroup.mem_sup_left (diagonal_mem_linearBorel F d))

/-- The mixed outer generator really has order three; independence rules out cancellation. -/
theorem mixed_outer_order {m : ℕ} (D : MixedData F m) :
    orderOf (qOuter F (fieldAction F D.coefficient) *
      qOuter F (linearConj F (OuterSolvable.OddPrimeCoverage.diagonalGL D.diagonal))) = 3 := by
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  apply orderOf_eq_prime
  · rw [D.outer_commute.mul_pow, (orderOf_eq_prime_iff.mp D.field_outer_order).1,
      (orderOf_eq_prime_iff.mp D.diagonal_outer_order).1, one_mul]
  · intro h
    have hf : qOuter F (fieldAction F D.coefficient) = 1 := by
      apply (Subgroup.disjoint_def.mp D.outer_independent)
        (mem_zpowers (qOuter F (fieldAction F D.coefficient)))
      rw [mul_eq_one_iff_eq_inv.mp h]
      exact Subgroup.inv_mem _ (mem_zpowers _)
    have hn := D.field_outer_order
    rw [hf, orderOf_one] at hn
    exact (by decide : (1 : ℕ) ≠ 3) hn

end Matrix.PSL3.ExtensionBorel
