private def globalForward (i : Fin 10) (x : Fin 100) : Fin 100 :=
  ⟨(globalForwardCode i >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩
private def globalBackward (i : Fin 10) (x : Fin 100) : Fin 100 :=
  ⟨(globalBackwardCode i >>> (7 * x.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩
private theorem globalLeft : ∀ i x, globalBackward i (globalForward i x) = x := by
  apply allFin
  decide +kernel
private theorem globalRight : ∀ i x, globalForward i (globalBackward i x) = x := by
  apply allFin
  decide +kernel
private def globalPermutation (i : Fin 10) : Equiv.Perm (Fin 100) where
  toFun := globalForward i
  invFun := globalBackward i
  left_inv := globalLeft i
  right_inv := globalRight i
private theorem globalGraph : ∀ i, globalPermutation i ∈ graphGroup := by
  change ∀ i : Fin 10, ∀ x y : Fin 100,
    adjacency (globalPermutation i x) (globalPermutation i y) ↔ adjacency x y
  apply allFin
  decide +kernel
private def globalConjugator (i : Fin 10) : PermutationNormalizer :=
  ⟨globalPermutation i, graphGroup_le_permutationNormalizer (globalGraph i)⟩
private def globalType (i : Fin 10) : Bool :=
  [true, false, true, false, true, false, false, true, false, false][i.val]!

private def localIndex (i : Fin 1024) : Fin 1024 :=
  ⟨( >>> (10 * i.val)) % 1024, Nat.mod_lt _ (by decide)⟩
private def classIndex (i : Fin 1024) : Fin 10 :=
  ⟨( >>> (4 * i.val)) % 16 % 10, Nat.mod_lt _ (by decide)⟩
private def marked (i : Fin 1024) : Bool :=
  (( >>> i.val) % 2 == 1)
private def squareWitness (i : Fin 1024) : Fin 100 :=
  ⟨( >>> (7 * i.val)) % 128 % 100, Nat.mod_lt _ (by decide)⟩

private def conjugator (i : Fin 1024) : PermutationNormalizer :=
  normalForm (localIndex i) * globalConjugator (classIndex i)

private def target (i : Fin 1024) : PermutationNormalizer :=
  if globalType (classIndex i) then symmetricNormalizer else elementaryNormalizer

private theorem conjugate_checks : ∀ i : Fin 1024, marked i = true → ∀ x : Fin 100,
    (conjugator i * target i * (conjugator i)⁻¹).val x = (normalForm i).val x := by
  apply allFin
  decide +kernel

private def signHom : PermutationNormalizer →* ℤˣ :=
  Equiv.Perm.sign.comp PermutationNormalizer.subtype

private theorem generator_sign : ∀ i : Fin 10,
    signHom (generator i) = if i.val < 2 then 1 else -1 := by
  apply allFin
  decide +kernel

private def parity (i : Fin 1024) : ℤˣ :=
  (List.ofFn (fun j : Fin 10 =>
    (if j.val < 2 then 1 else -1 : ℤˣ) ^ (i.val / 2 ^ j.val % 2))).prod

private theorem normalForm_sign (i : Fin 1024) :
    Equiv.Perm.sign (normalForm i).val = parity i := by
  change signHom (normalForm i) = parity i
  simp only [normalForm, map_list_prod, List.map_ofFn, parity]
  apply congrArg List.prod
  apply congrArg List.ofFn
  funext j
  simp only [Function.comp_apply, map_pow, generator_sign]

private theorem exclusion_checks : ∀ i : Fin 1024, parity i = -1 →
    marked i = true ∨
      (normalForm i).val ((normalForm i).val (squareWitness i)) ≠ squareWitness i := by
  apply allFin
  decide +kernel

/-- Every outer involution in the specified finite family is conjugate inside
the actual normalizer to one of the two representatives. -/
public theorem normalForm_fusion (i : Fin 1024) (hi : orderOf (normalForm i) = 2)
    (ho : (normalForm i).val ∉ generated) :
    IsConj (normalForm i) elementaryNormalizer ∨ IsConj (normalForm i) symmetricNormalizer := by
  have hp := sign_of_normalizer_not_mem (normalForm i) ho
  rw [normalForm_sign] at hp
  rcases exclusion_checks i hp with hf | he
  · have hc : conjugator i * target i * (conjugator i)⁻¹ = normalForm i :=
      Subtype.ext (Equiv.ext (conjugate_checks i hf))
    have hconj : IsConj (normalForm i) (target i) := (isConj_iff.mpr ⟨conjugator i, hc⟩).symm
    cases ht : globalType (classIndex i)
    · exact Or.inl (by simpa only [target, ht, Bool.false_eq_true, if_false] using hconj)
    · exact Or.inr (by simpa only [target, ht, if_true] using hconj)
  · have hs : normalForm i ^ 2 = 1 := hi ▸ pow_orderOf_eq_one (normalForm i)
    have hpoint := congrArg (fun n : PermutationNormalizer => n.val (squareWitness i)) hs
    exact (he hpoint).elim

