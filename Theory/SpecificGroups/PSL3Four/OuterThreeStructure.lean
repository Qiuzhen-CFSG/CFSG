/-!
# The three-prime residual in automorphism extensions of PSL₃(4)

The literal outer automorphism group has order dividing twelve. Indeed,
linear conjugations modulo inner automorphisms factor through the determinant,
so their order divides three. The quotient by all linear conjugations is
generated by the commuting field and graph images, each of order dividing two.
The existing binary automorphism-coverage theorem makes this the full quotient.

For any subgroup A of Aut(PSL₃(4)) containing the inner automorphisms,
O^{3′}(A) contains the inner subgroup by simplicity and divisibility of the
simple group's order by three. Its image lies in the inner-diagonal subgroup,
whose index divides four. The relative index of the inner subgroup in the
inner-diagonal subgroup divides three, giving the two possible literal images.

Finally, the kernel of GL₃ conjugation on PSL₃ is the scalar center. Perfectness
of SL₃ first lifts a trivial projective action to a trivial action on SL₃;
commuting with all transvections then forces a scalar matrix. This identifies
the actual PGL₃ quotient with the inner-diagonal subgroup and preserves its
embedding, also after restriction to the residual.

Source: GLS3, Theorem 2.5.12 and §2.7 (`refs/KGroup/GLS3/chapter2.tex`),
and Aschbacher–Smith, combined manuscript (1 March 2004), Lemma 13.6.27,
printed pp.934–935. The scalar-kernel argument is adapted downward from
`CFSG/Quasithin/Chapter15/Section03/ComponentUniqueness/Candidates/RankAlternatives/
SignedReduction/ExtensionModels/MatrixModels.lean`; there is no upward import.
The imported SL₃ perfectness and simplicity proofs retain their ATLAS attribution
and license in `Theory.AtlasPort.ExceptionalIsomorphisms`.
-/

public section

open Subgroup Matrix
open scoped MatrixGroups
namespace Matrix.PSL3Four.OuterThreeStructure
open Matrix.PSL3.OuterSolvable

private theorem linearConj_kernel : (PSL3.OuterSolvable.linearConj F).ker = center (GL (Fin 3) F) := by
  open PSL3.OuterSolvable in
  have hinj : Function.Injective (centerAction F) := by
    let : Group.IsPerfect SL(3,F) := Atlas.sl_perfect 3 (by decide)
    have he : centerAction F = Subgroup.quotientAut (center SL(3,F)) := by
      ext a x
      obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (center SL(3,F)) x
      rw [Subgroup.quotientAut_apply_mk]
      rfl
    rw [he]
    exact MulAut.quotient_center_injective
  ext g
  constructor
  · intro hg
    have hs : PSL3.OuterSolvable.linearConjSL F g = 1 :=
      hinj (hg.trans (map_one _).symm)
    have hc (x : SL(3,F)) : g * SpecialLinearGroup.toGL x = SpecialLinearGroup.toGL x * g := by
      have he := congrArg SpecialLinearGroup.toGL (DFunLike.congr_fun hs x)
      rw [PSL3.OuterSolvable.linearConjSL_toGL] at he
      exact mul_inv_eq_iff_eq_mul.mp he
    apply GeneralLinearGroup.mem_center_iff_val_mem_range_scalar.mpr
    apply Matrix.mem_range_scalar_of_commute_transvectionStruct
    intro t
    exact (congrArg Units.val (hc ⟨t.toMatrix, by simp⟩)).symm
  · intro hg
    change PSL3.OuterSolvable.linearConj F g = 1
    ext z
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (center SL(3,F)) z
    change PSL3.OuterSolvable.linearConj F g (QuotientGroup.mk x) = QuotientGroup.mk x
    rw [PSL3.OuterSolvable.linearConj_mk]
    change QuotientGroup.mk (PSL3.OuterSolvable.linearConjSL F g x) = QuotientGroup.mk x
    congr 1
    apply SpecialLinearGroup.toGL_injective
    rw [PSL3.OuterSolvable.linearConjSL_toGL, ← mem_center_iff.mp hg, mul_inv_cancel_right]

/-- PGL₃(4), as the literal scalar quotient, is the inner-diagonal subgroup. -/
noncomputable def pglEquiv : PGL(Fin 3,F) ≃* PSL3.OuterSolvable.innerDiagonal F :=
  (QuotientGroup.quotientMulEquivOfEq linearConj_kernel.symm).trans
    (QuotientGroup.quotientKerEquivRange (PSL3.OuterSolvable.linearConj F))

/-- The equivalence is induced by the given GL₃ conjugation action on PSL₃. -/
@[simp] theorem pglEquiv_mk (g : GL (Fin 3) F) :
    (pglEquiv (ProjGenLinGroup.mk g)).val = linearConj F g := by rfl

private theorem coverage : standard F = ⊤ :=
  standard_eq_top_of_two_power_card F (m := 2) (by decide) (by simpa using card_F)

private instance innerDiagonal_normal : (innerDiagonal F).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← coverage]
  exact standard_le_normalizer_innerDiagonal

private theorem fieldAut_card_dvd_two : Nat.card (F ≃+* F) ∣ 2 := by
  let f : (F ≃+* F) →* (F ≃ₐ[ZMod 2] F) :=
    { toFun := fun σ => AlgEquiv.ofRingEquiv (f := σ) (fun z => by
        exact congrArg (fun f : ZMod 2 →+* F => f z)
          (Subsingleton.elim (σ.toRingHom.comp (algebraMap (ZMod 2) F))
            (algebraMap (ZMod 2) F)))
      map_one' := by ext; rfl
      map_mul' := by intros; ext; rfl }
  have hf : Function.Injective f := fun σ τ h => RingEquiv.ext fun x =>
    congrArg (fun f : F ≃ₐ[ZMod 2] F => f x) h
  have hc : Nat.card (F ≃ₐ[ZMod 2] F) = 2 := by
    rw [IsGalois.card_aut_eq_finrank]
    exact GaloisField.finrank 2 (by decide)
  have h := card_dvd_of_injective f hf
  rwa [hc] at h

/-- The actual diagonal image in Aut/Inn has order dividing three. -/
theorem diagonalOuter_card_dvd_three : Nat.card (innerDiagonalOuter F) ∣ 3 := by
  let d : GL (Fin 3) F →* Fˣ := GeneralLinearGroup.det
  let f := (linearOuterAction F).rangeRestrict
  have hk : d.ker ≤ f.ker := by
    simpa only [f, d, MonoidHom.ker_rangeRestrict] using det_ker_le_linearOuterAction_ker F
  let l := QuotientGroup.lift d.ker f hk
  have hl : Function.Surjective l :=
    QuotientGroup.lift_surjective_of_surjective d.ker f
      (linearOuterAction F).rangeRestrict_surjective hk
  have hd : Nat.card (GL (Fin 3) F ⧸ d.ker) ∣ Nat.card Fˣ := by
    rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange d).toEquiv]
    exact d.range.card_subgroup_dvd_card
  have h := dvd_trans (card_dvd_of_surjective l hl) hd
  norm_num only [Nat.card_units, card_F, Nat.reduceSub] at h
  exact h

/-- The relative index uses the inner subgroup inside the actual linear image. -/
theorem inner_relIndex_diagonal_dvd_three :
    (MulAut.innerSubgroup PSL).relIndex (innerDiagonal F) ∣ 3 := by
  have h := relIndex_ker (innerDiagonal F)
    (QuotientGroup.mk' (MulAut.innerSubgroup PSL))
  rw [QuotientGroup.ker_mk', innerDiagonal_map_outer] at h
  rw [h]
  exact diagonalOuter_card_dvd_three

/-- The full automorphism group modulo inner-diagonal automorphisms has order dividing four. -/
theorem diagonal_index_dvd_four : (innerDiagonal F).index ∣ 4 := by
  let q := QuotientGroup.mk' (innerDiagonal F)
  let f := q.comp (Matrix.PSL3.OuterSolvable.fieldAction F)
  let g := q (graph F)
  have hgen : f.range ⊔ zpowers g = ⊤ := by
    have h := congrArg (Subgroup.map q) coverage
    rw [standard, Subgroup.map_sup, Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq,
      MonoidHom.map_zpowers, ← MonoidHom.range_comp,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] at h
    exact h
  have hc : ∀ σ (z : zpowers g), Commute (f σ) ((zpowers g).subtype z) := by
    intro σ ⟨z, hz⟩
    obtain ⟨n, rfl⟩ := hz
    exact ((field_commute_graph σ).map q).zpow_right n
  let φ := f.noncommCoprod (zpowers g).subtype hc
  have hs : Function.Surjective φ := by
    apply MonoidHom.range_eq_top.mp
    exact (MonoidHom.noncommCoprod_range f (zpowers g).subtype hc).trans
      (by rw [range_subtype]; exact hgen)
  have hg : Nat.card (zpowers g) ∣ 2 := by
    rw [Nat.card_zpowers]
    apply orderOf_dvd_of_pow_eq_one
    change q (graph F) ^ 2 = 1
    rw [← map_pow, graph_sq, map_one]
  have hh := card_dvd_of_surjective φ hs
  rw [Nat.card_prod] at hh
  exact hh.trans (Nat.mul_dvd_mul fieldAut_card_dvd_two hg)

/-- The outer-order input for the linear generation step in 13.6.27. -/
theorem outer_card_dvd_twelve : Nat.card (MulAut.Outer PSL) ∣ 12 := by
  change (MulAut.innerSubgroup PSL).index ∣ 12
  rw [← relIndex_mul_index (inner_le_innerDiagonal F)]
  exact Nat.mul_dvd_mul inner_relIndex_diagonal_dvd_three diagonal_index_dvd_four

private theorem psl_primeToResidual_eq_top : primeToResidual 3 PSL = ⊤ := by
  let _ : IsSimpleGroup PSL := Atlas.psl_simple_high_rank 3 (by decide)
  rcases (inferInstance : (primeToResidual 3 PSL).Normal).eq_bot_or_eq_top with h | h
  · have hc := primeToResidual_index_coprime (G := PSL) 3
    rw [h, index_bot, card_PSL] at hc
    norm_num at hc
  · exact h

private theorem inner_le_embedded_residual (A : Subgroup (MulAut PSL))
    (hA : MulAut.innerSubgroup PSL ≤ A) :
    MulAut.innerSubgroup PSL ≤ (primeToResidual 3 A).map A.subtype := by
  let f : PSL →* A := MulAut.conj.codRestrict A (fun x => hA ⟨x, rfl⟩)
  have hf := map_primeToResidual_le_of_hom 3 f
  rw [psl_primeToResidual_eq_top, ← MonoidHom.range_eq_map] at hf
  rintro _ ⟨x, rfl⟩
  exact ⟨f x, hf ⟨x, rfl⟩, rfl⟩

private theorem embedded_residual_le_diagonal (A : Subgroup (MulAut PSL)) :
    (primeToResidual 3 A).map A.subtype ≤ innerDiagonal F := by
  let f := (QuotientGroup.mk' (innerDiagonal F)).comp A.subtype
  have hc : Nat.Coprime 3 (Nat.card (MulAut PSL ⧸ innerDiagonal F)) :=
    (show Nat.Coprime 3 4 by decide).coprime_dvd_right diagonal_index_dvd_four
  have hf := primeToResidual_le_ker (p := 3) f hc
  rintro _ ⟨x, hx, rfl⟩
  exact (QuotientGroup.eq_one_iff _).mp (hf hx)

/-- The literal image of O^{3′}(A) is either the inner or the inner-diagonal subgroup. -/
theorem embedded_primeToResidual_eq_inner_or_diagonal (A : Subgroup (MulAut PSL))
    (hA : MulAut.innerSubgroup PSL ≤ A) :
    (primeToResidual 3 A).map A.subtype = MulAut.innerSubgroup PSL ∨
      (primeToResidual 3 A).map A.subtype = innerDiagonal F := by
  let R := (primeToResidual 3 A).map A.subtype
  let I := MulAut.innerSubgroup PSL
  let D := innerDiagonal F
  have hIR : I ≤ R := inner_le_embedded_residual A hA
  have hRD : R ≤ D := embedded_residual_le_diagonal A
  have hm := relIndex_mul_relIndex I R D hIR hRD
  have hb : I.relIndex R * R.relIndex D ≤ 3 := by
    rw [hm]
    exact Nat.le_of_dvd (by decide) inner_relIndex_diagonal_dvd_three
  have hx : 0 < I.relIndex R := Nat.card_pos
  have hy : 0 < R.relIndex D := Nat.card_pos
  have hor : I.relIndex R = 1 ∨ R.relIndex D = 1 := by
    by_contra! h
    have hx2 : 2 ≤ I.relIndex R := by omega
    have hy2 : 2 ≤ R.relIndex D := by omega
    nlinarith
  exact hor.imp (fun h => le_antisymm (relIndex_eq_one.mp h) hIR)
    (fun h => le_antisymm hRD (relIndex_eq_one.mp h))

/-- Restrict the actual PGL identification along the literal embedded residual. -/
noncomputable def residualEquivPGL (A : Subgroup (MulAut PSL))
    (h : (primeToResidual 3 A).map A.subtype = innerDiagonal F) :
    primeToResidual 3 A ≃* PGL(Fin 3,F) :=
  ((primeToResidual 3 A).equivMapOfInjective A.subtype A.subtype_injective).trans
    ((MulEquiv.subgroupCongr h).trans pglEquiv.symm)

/-- The residual identification preserves its given embedding in Aut(PSL₃(4)). -/
theorem residualEquivPGL_compatible (A : Subgroup (MulAut PSL))
    (h : (primeToResidual 3 A).map A.subtype = innerDiagonal F)
    (x : primeToResidual 3 A) :
    (pglEquiv (residualEquivPGL A h x)).val = A.subtype x.val := by
  simp only [residualEquivPGL, MulEquiv.trans_apply, MulEquiv.apply_symm_apply]
  rfl

end Matrix.PSL3Four.OuterThreeStructure
