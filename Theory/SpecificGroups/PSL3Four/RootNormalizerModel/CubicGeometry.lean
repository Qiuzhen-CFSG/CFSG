module

public import Theory.SpecificGroups.PSL3Four.RootNormalizerModel
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Algebra.GroupWithZero.Units.Fintype

/-!
# Cubic root geometry in the split UT₃(F₄) normalizer

The x-axis and central axis are four-groups. The diagonal tori (1, b) and
(a, a⁻¹) have order three, act transitively on the respective nonzero central
and x-axis coordinates, and have the centralizing relations used in the
source construction. The first torus fixes precisely the x-axis in the root
group. The plane generated by the two axes is elementary abelian.

All subgroups are literal images in `RootNormalizerModel.Model`; in
particular the center is the image of the center of the marked root subgroup.
These coordinate calculations supply the cubic-action part of Aschbacher,
*Sporadic Groups* (1994), 46.3 and the proof of 46.14, pp.251, 257–258.
-/

@[expose] public section
open Subgroup
open scoped IsMulCommutative
namespace Matrix.PSL3Four.RootNormalizerModel.Cubic
noncomputable section

def xAxis : Multiplicative F →* Root where
  toFun x := ⟨x.toAdd, 0, 0⟩
  map_one' := rfl
  map_mul' x y := by apply SylowModel.U.ext <;> simp

def uHom : Multiplicative F →* Model := SemidirectProduct.inl.comp xAxis
def eHom : Multiplicative F →* Model := SemidirectProduct.inl.comp SylowModel.central

def U : Subgroup Model := uHom.range
def E : Subgroup Model := eHom.range

def torus : Fˣ × Fˣ →* actor := diagonalHom.codRestrict actor (fun a =>
  (le_sup_left : diagonalHom.range ≤ actor) (show diagonalHom a ∈ diagonalHom.range from ⟨a, rfl⟩))

def torusIn : Fˣ × Fˣ →* Model := SemidirectProduct.inr.comp torus

def x1Hom : Fˣ →* Model := torusIn.comp
  { toFun := fun b => (1, b), map_one' := rfl, map_mul' := fun a b => by simp }
def x3Hom : Fˣ →* Model := torusIn.comp
  { toFun := fun a => (a, a⁻¹), map_one' := by simp, map_mul' := fun a b => by simp [mul_comm] }

def X1 : Subgroup Model := x1Hom.range
def X3 : Subgroup Model := x3Hom.range

theorem diagonalHom_injective : Function.Injective diagonalHom := by
  intro a b h
  have h1 := congrArg (fun f : MulAut Root => (f ⟨1, 0, 0⟩).x) h
  have h2 := congrArg (fun f : MulAut Root => (f ⟨0, 1, 0⟩).y) h
  apply Prod.ext <;> apply Units.ext
  · simpa [diagonalHom, diagonal] using h1
  · simpa [diagonalHom, diagonal] using h2

theorem torusIn_injective : Function.Injective torusIn := by
  intro a b h
  exact diagonalHom_injective (congrArg Subtype.val (SemidirectProduct.inr_injective h))

theorem uHom_injective : Function.Injective uHom := by
  intro a b h
  exact congrArg SylowModel.U.x (SemidirectProduct.inl_injective h)

theorem eHom_injective : Function.Injective eHom :=
  SemidirectProduct.inl_injective.comp SylowModel.central_injective

theorem U_card : Nat.card U = 4 := by
  rw [U, ← Nat.card_congr (MonoidHom.ofInjective uHom_injective).toEquiv]
  exact card_F

theorem E_card : Nat.card E = 4 := by
  rw [E, ← Nat.card_congr (MonoidHom.ofInjective eHom_injective).toEquiv]
  exact card_F

theorem X1_card : Nat.card X1 = 3 := by
  have hi : Function.Injective x1Hom := fun a b h =>
    congrArg Prod.snd (torusIn_injective h)
  rw [X1, ← Nat.card_congr (MonoidHom.ofInjective hi).toEquiv, Nat.card_units, card_F]

theorem X3_card : Nat.card X3 = 3 := by
  have hi : Function.Injective x3Hom := fun a b h =>
    congrArg Prod.fst (torusIn_injective h)
  rw [X3, ← Nat.card_congr (MonoidHom.ofInjective hi).toEquiv, Nat.card_units, card_F]

@[simp] theorem mem_root (g : Model) : g ∈ root ↔ g.right = 1 := by
  rw [root, SemidirectProduct.range_inl_eq_ker_rightHom]
  rfl

@[simp] theorem mem_U (g : Model) : g ∈ U ↔
    g.right = 1 ∧ g.left.y = 0 ∧ g.left.c = 0 := by
  constructor
  · rintro ⟨x, rfl⟩; exact ⟨rfl, rfl, rfl⟩
  · rintro ⟨hr, hy, hc⟩
    refine ⟨Multiplicative.ofAdd g.left.x, ?_⟩
    exact SemidirectProduct.ext (SylowModel.U.ext rfl hy.symm hc.symm) hr.symm

@[simp] theorem mem_E (g : Model) : g ∈ E ↔
    g.right = 1 ∧ g.left.x = 0 ∧ g.left.y = 0 := by
  constructor
  · rintro ⟨x, rfl⟩; exact ⟨rfl, rfl, rfl⟩
  · rintro ⟨hr, hx, hy⟩
    refine ⟨Multiplicative.ofAdd g.left.c, ?_⟩
    exact SemidirectProduct.ext (SylowModel.U.ext hx.symm hy.symm rfl) hr.symm

theorem U_le_root : U ≤ root := fun g hg => (mem_root g).mpr ((mem_U g).mp hg).1

theorem E_le_root : E ≤ root := fun g hg => (mem_root g).mpr ((mem_E g).mp hg).1

theorem disjoint : Disjoint E U := by
  rw [Subgroup.disjoint_def]
  intro g he hu
  obtain ⟨hr, hx, hy⟩ := (mem_E g).mp he
  obtain ⟨_, _, hc⟩ := (mem_U g).mp hu
  exact SemidirectProduct.ext (SylowModel.U.ext hx hy hc) hr

theorem E_center : (center root).map root.subtype = E := by
  apply (eq_of_le_of_card_ge ?_ ?_).symm
  · rintro g ⟨c, rfl⟩
    have he : eHom c ∈ E := by exact ⟨c, rfl⟩
    have hr : eHom c ∈ root := E_le_root he
    refine ⟨⟨eHom c, hr⟩, ?_, rfl⟩
    change (⟨eHom c, hr⟩ : root) ∈ center root
    rw [Subgroup.mem_center_iff]
    rintro ⟨h, q, rfl⟩
    apply Subtype.ext
    change SemidirectProduct.inl q * SemidirectProduct.inl (SylowModel.central c) =
      SemidirectProduct.inl (SylowModel.central c) * SemidirectProduct.inl q
    rw [← map_mul, ← map_mul]
    congr 1
    apply SylowModel.U.ext <;> simp [SylowModel.central, add_comm]
  · rw [card_map_of_injective root.subtype_injective, root_center_card, E_card]

def planeHom : Multiplicative (F × F) →* Model :=
  SemidirectProduct.inl.comp SylowModel.axis₁

theorem join_eq_plane : E ⊔ U = planeHom.range := by
  apply le_antisymm
  · apply sup_le
    · rintro g ⟨c, rfl⟩
      exact ⟨Multiplicative.ofAdd (0, c.toAdd), rfl⟩
    · rintro g ⟨x, rfl⟩
      exact ⟨Multiplicative.ofAdd (x.toAdd, 0), rfl⟩
  · rintro g ⟨p, rfl⟩
    have he : eHom (Multiplicative.ofAdd p.toAdd.2) ∈ E ⊔ U := (le_sup_left : E ≤ E ⊔ U) ⟨_, rfl⟩
    have hu : uHom (Multiplicative.ofAdd p.toAdd.1) ∈ E ⊔ U := (le_sup_right : U ≤ E ⊔ U) ⟨_, rfl⟩
    convert (E ⊔ U).mul_mem he hu using 1
    apply SemidirectProduct.ext
    · apply SylowModel.U.ext <;> simp [planeHom, eHom, uHom, SylowModel.axis₁, SylowModel.central, xAxis]
    · simp [planeHom, eHom, uHom]

theorem elementary : IsElementaryAbelian 2 (E ⊔ U : Subgroup Model) := by
  rw [join_eq_plane]
  let e : Multiplicative (F × F) ≃* planeHom.range :=
    MonoidHom.ofInjective (SemidirectProduct.inl_injective.comp SylowModel.axis₁_injective)
  refine {
    toIsMulCommutative := ⟨⟨fun a b => e.symm.injective (by simp [mul_comm])⟩⟩
    exponent_dvd_p := ?_ }
  apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
  intro a
  apply e.symm.injective
  rw [map_pow, map_one]
  exact Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
    (IsElementaryAbelian.exponent_dvd_p 2 (Multiplicative (F × F))) _

theorem join_le_root : E ⊔ U ≤ root := sup_le E_le_root U_le_root

@[simp] theorem torusIn_conj (a : Fˣ × Fˣ) (q : Root) :
    torusIn a * SemidirectProduct.inl q * (torusIn a)⁻¹ =
      SemidirectProduct.inl (diagonal a q) := by
  simpa [torusIn, torus, diagonalHom] using
    (SemidirectProduct.inl_aut (φ := actor.subtype) (torus a) q).symm

@[simp] theorem x1_conj_E (b : Fˣ) (c : Multiplicative F) :
    x1Hom b * eHom c * (x1Hom b)⁻¹ = eHom (Multiplicative.ofAdd (b * c.toAdd)) := by
  change torusIn (1, b) * SemidirectProduct.inl _ * (torusIn (1, b))⁻¹ = _
  rw [torusIn_conj]
  change SemidirectProduct.inl _ = SemidirectProduct.inl _
  congr 1
  apply SylowModel.U.ext <;> simp [diagonal, SylowModel.central]

@[simp] theorem x3_conj_U (a : Fˣ) (x : Multiplicative F) :
    x3Hom a * uHom x * (x3Hom a)⁻¹ = uHom (Multiplicative.ofAdd (a * x.toAdd)) := by
  change torusIn (a, a⁻¹) * SemidirectProduct.inl _ * (torusIn (a, a⁻¹))⁻¹ = _
  rw [torusIn_conj]
  change SemidirectProduct.inl _ = SemidirectProduct.inl _
  congr 1
  apply SylowModel.U.ext <;> simp [diagonal, xAxis]

theorem X1_normalizes : X1 ≤ normalizer (E : Set Model) := by
  rintro g ⟨b, rfl⟩
  rw [Subgroup.mem_normalizer_iff]
  intro g
  constructor
  · rintro ⟨c, rfl⟩
    rw [x1_conj_E]
    exact ⟨_, rfl⟩
  · intro hg
    have h : x1Hom b⁻¹ * (x1Hom b * g * (x1Hom b)⁻¹) * (x1Hom b⁻¹)⁻¹ ∈ E := by
      rcases hg with ⟨c, hc⟩
      rw [← hc, x1_conj_E]
      exact ⟨_, rfl⟩
    simpa only [map_inv, inv_inv, mul_assoc, inv_mul_cancel_left, mul_inv_cancel_left, inv_mul_cancel, mul_one] using h

theorem X3_normalizes : X3 ≤ normalizer (U : Set Model) := by
  rintro g ⟨a, rfl⟩
  rw [Subgroup.mem_normalizer_iff]
  intro g
  constructor
  · rintro ⟨x, rfl⟩
    rw [x3_conj_U]
    exact ⟨_, rfl⟩
  · intro hg
    have h : x3Hom a⁻¹ * (x3Hom a * g * (x3Hom a)⁻¹) * (x3Hom a⁻¹)⁻¹ ∈ U := by
      rcases hg with ⟨x, hx⟩
      rw [← hx, x3_conj_U]
      exact ⟨_, rfl⟩
    simpa only [map_inv, inv_inv, mul_assoc, inv_mul_cancel_left, mul_inv_cancel_left, inv_mul_cancel, mul_one] using h

theorem X1_transitive : ∀ e ∈ E, e ≠ 1 → ∀ f ∈ E, f ≠ 1 →
    ∃ x : X1, (x : Model) * e * (x : Model)⁻¹ = f := by
  rintro e ⟨c, rfl⟩ hc f ⟨d, rfl⟩ hd
  have hc0 : c.toAdd ≠ 0 := fun h => hc (by simpa using congrArg (fun x : F => eHom (Multiplicative.ofAdd x)) h)
  have hd0 : d.toAdd ≠ 0 := fun h => hd (by simpa using congrArg (fun x : F => eHom (Multiplicative.ofAdd x)) h)
  let b : Fˣ := Units.mk0 (d.toAdd / c.toAdd) (div_ne_zero hd0 hc0)
  refine ⟨⟨x1Hom b, ⟨b, rfl⟩⟩, ?_⟩
  change x1Hom b * _ * (x1Hom b)⁻¹ = _
  rw [x1_conj_E]
  congr 1
  exact div_mul_cancel₀ _ hc0

theorem X3_transitive : ∀ u ∈ U, u ≠ 1 → ∀ v ∈ U, v ≠ 1 →
    ∃ x : X3, (x : Model) * u * (x : Model)⁻¹ = v := by
  rintro u ⟨c, rfl⟩ hc v ⟨d, rfl⟩ hd
  have hc0 : c.toAdd ≠ 0 := fun h => hc (by simpa using congrArg (fun x : F => uHom (Multiplicative.ofAdd x)) h)
  have hd0 : d.toAdd ≠ 0 := fun h => hd (by simpa using congrArg (fun x : F => uHom (Multiplicative.ofAdd x)) h)
  let a : Fˣ := Units.mk0 (d.toAdd / c.toAdd) (div_ne_zero hd0 hc0)
  refine ⟨⟨x3Hom a, ⟨a, rfl⟩⟩, ?_⟩
  change x3Hom a * _ * (x3Hom a)⁻¹ = _
  rw [x3_conj_U]
  congr 1
  exact div_mul_cancel₀ _ hc0

theorem U_eq : root ⊓ centralizer (X1 : Set Model) = U := by
  apply le_antisymm
  · rintro g ⟨⟨q, rfl⟩, hg⟩
    obtain ⟨b, hb⟩ := exists_fieldFrobenius_ne
    have hb0 : b ≠ 0 := by intro h; subst b; simp at hb
    have hb1 : b ≠ 1 := by intro h; subst b; simp at hb
    let b' : Fˣ := Units.mk0 b hb0
    have h := hg (x1Hom b') (show x1Hom b' ∈ X1 from ⟨b', rfl⟩)
    have hc : torusIn (1, b') * SemidirectProduct.inl q * (torusIn (1, b'))⁻¹ =
        SemidirectProduct.inl q := mul_inv_eq_iff_eq_mul.mpr h
    rw [torusIn_conj] at hc
    have hq := SemidirectProduct.inl_injective hc
    have hy : b * q.y = q.y := by
      simpa [diagonal, b'] using congrArg SylowModel.U.y hq
    have hz : b * q.c = q.c := by
      simpa [diagonal, b'] using congrArg SylowModel.U.c hq
    exact (mem_U _).mpr ⟨rfl, eq_zero_of_mul_eq_self_left hb1 hy,
      eq_zero_of_mul_eq_self_left hb1 hz⟩
  · intro g hg
    refine ⟨U_le_root hg, ?_⟩
    rcases hg with ⟨x, rfl⟩
    rintro h ⟨b, rfl⟩
    apply mul_inv_eq_iff_eq_mul.mp
    change torusIn (1, b) * SemidirectProduct.inl _ * (torusIn (1, b))⁻¹ = _
    rw [torusIn_conj]
    change SemidirectProduct.inl _ = SemidirectProduct.inl _
    congr 1
    apply SylowModel.U.ext <;> simp [diagonal, xAxis]

theorem X3_centralizes : X3 ≤ centralizer (E ⊔ X1 : Set Model) := by
  rintro g ⟨a, rfl⟩ h (he | hx)
  · rcases he with ⟨c, rfl⟩
    symm
    apply mul_inv_eq_iff_eq_mul.mp
    change torusIn (a, a⁻¹) * SemidirectProduct.inl _ * (torusIn (a, a⁻¹))⁻¹ = _
    rw [torusIn_conj]
    change SemidirectProduct.inl _ = SemidirectProduct.inl _
    congr 1
    apply SylowModel.U.ext <;> simp [diagonal, SylowModel.central]
  · rcases hx with ⟨b, rfl⟩
    change torusIn (1, b) * torusIn (a, a⁻¹) = torusIn (a, a⁻¹) * torusIn (1, b)
    rw [← map_mul, ← map_mul, mul_comm]

end
end Matrix.PSL3Four.RootNormalizerModel.Cubic
