module

public import Theory.SpecificGroups.PSL3Four.CentralCover.FixedResiduals.ProjectiveGraphField.Monomial
public import Theory.SpecificGroups.PSL3Four.CentralCover.FixedResiduals.ProjectiveGraphField.NormalTwoQuotient
public import Theory.SpecificGroups.PSL3Four.CentralCover.FixedResiduals.ProjectiveGraphField.ElementaryImage

/-!
# The projective graph-field residual is elementary of order nine

Every fixed projective class lifts to an actual unitary matrix. The subgroup
H generated by the displayed diagonal and cyclic matrices lies in O²(SU₃(2)).
The concrete normality and two-group quotient calculation proves that H is
exactly this residual.
Surjective projectivization then identifies the projective residual with the
actual image of H. The independent projective coordinate calculation identifies
that image with E₉, giving an unconditional multiplicative equivalence.

The earlier conditional assembly remains available. The unconditional results
below discharge all its premises using the specified matrices over GF(4).

Source: Aschbacher--Smith 15.3.38, combined 1 March 2004 manuscript,
printed pp.1136--1137. This is the projective step; the perfect-four-cover
assembly is owned by `CentralCover.FixedResiduals`.
-/

public section

namespace Matrix.PSL3Four.ProjectiveGraphField

/-- Normality and a two-group quotient supply the reverse residual inclusion. -/
theorem unitary_residual_eq_of_two_quotient [heisenberg.Normal]
    (hQ : IsPGroup 2 (unitary ⧸ heisenberg)) : pResidual 2 unitary = heisenberg :=
  le_antisymm (sInf_le ⟨inferInstance, hQ⟩) heisenberg_le_residual

/-- Surjective projectivization transports the concrete residual equality. -/
theorem projective_residual_eq_of_two_quotient [heisenberg.Normal]
    (hQ : IsPGroup 2 (unitary ⧸ heisenberg)) :
    pResidual 2 projectiveAction.fixedSubgroup = projectiveHeisenberg := by
  rw [← Subgroup.map_pResidual_of_surjective 2 fixedProjection fixedProjection_surjective,
    unitary_residual_eq_of_two_quotient hQ]
  rfl

/-- The two-residual of the actual unitary fixed subgroup is generated by D and P. -/
theorem unitary_residual_eq : pResidual 2 unitary = heisenberg :=
  unitary_residual_eq_of_two_quotient unitary_quotient_isTwoGroup

/-- The projective graph-field two-residual is the actual image of the monomial subgroup. -/
theorem projective_residual_eq :
    pResidual 2 projectiveAction.fixedSubgroup = projectiveHeisenberg :=
  projective_residual_eq_of_two_quotient unitary_quotient_isTwoGroup

end Matrix.PSL3Four.ProjectiveGraphField

namespace Matrix.PSL3Four
open ProjectiveGraphField

/-- Conditional assembly from the two concrete subgroup calculations. -/
noncomputable def projectiveGraphFieldResidualEquivOfStructure [heisenberg.Normal]
    (hQ : IsPGroup 2 (unitary ⧸ heisenberg))
    (e : projectiveHeisenberg ≃* Multiplicative (Fin 2 → ZMod 3)) :
    pResidual 2 (PSL3.OuterSolvable.graph F * pslFrobenius).fixedSubgroup ≃*
      Multiplicative (Fin 2 → ZMod 3) :=
  (MulEquiv.subgroupCongr (projective_residual_eq_of_two_quotient hQ)).trans e

/-- The two-residual of the fixed subgroup of inverse transpose times entrywise
squaring on PSL₃(GF(4)) is the elementary abelian group E₉. -/
noncomputable def projectiveGraphFieldResidualEquiv :
    pResidual 2 (PSL3.OuterSolvable.graph F * pslFrobenius).fixedSubgroup ≃*
      Multiplicative (Fin 2 → ZMod 3) :=
  projectiveGraphFieldResidualEquivOfStructure unitary_quotient_isTwoGroup
    projectiveHeisenbergEquiv

end Matrix.PSL3Four
