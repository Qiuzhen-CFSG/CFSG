module
public import Theory.SpecificGroups.PSL3Four.CentralCover.FixedResiduals.ProjectiveGraphField.FixedRepresentatives

/-!
# Concrete monomial generators in SU₃(2)

Choose a nonbinary element ω in the actual matrix field GF(4). The matrices
D = diag(1, ω, ω²) and P = ((0,1,0),(0,0,1),(1,0,0)) have determinant one,
are unitary for entrywise squaring, and have cube one. Hence their generated
subgroup lies in the two-residual, as does its actual projective image.

These definitions do not assume the subgroup's order, normality, quotient
structure, or elementary abelian projective image. Those are the two remaining
matrix calculations needed for the residual identification.

Source: the matrix calculation underlying Aschbacher--Smith 15.3.38,
combined 1 March 2004 manuscript, printed pp.1136--1137.
-/

public section
namespace Matrix.PSL3Four.ProjectiveGraphField
noncomputable section
/-- A chosen nonbinary element of the specified field GF(4). -/
@[expose] noncomputable def omega : F := Classical.choose exists_fieldFrobenius_ne

theorem omega_not_fixed : fieldFrobenius omega ≠ omega :=
  Classical.choose_spec exists_fieldFrobenius_ne

theorem omega_ne_zero : omega ≠ 0 := by
  intro h
  exact omega_not_fixed (by simp [h])

theorem omega_ne_one : omega ≠ 1 := by
  intro h
  exact omega_not_fixed (by simp [h])

theorem omega_cube : omega ^ 3 = 1 := by
  apply mul_left_cancel₀ omega_ne_zero
  simpa only [← pow_succ', mul_one] using pow_four omega

/-- The determinant-one diagonal cubic matrix. -/
@[expose] def diagonalSL : SL :=
  ⟨Matrix.diagonal ![1, omega, omega ^ 2], by
    simpa [Matrix.det_diagonal, Fin.prod_univ_three, ← pow_succ'] using omega_cube⟩

/-- The cyclic permutation matrix, with the displayed orientation. -/
@[expose] def cycleSL : SL :=
  ⟨!![0, 1, 0; 0, 0, 1; 1, 0, 0], by
    norm_num [Matrix.det_fin_three, Matrix.cons_val_two, Matrix.vecHead, Matrix.vecTail]⟩

theorem diagonalSL_cube : diagonalSL ^ 3 = 1 := by
  apply Subtype.ext
  change (Matrix.diagonal ![1, omega, omega ^ 2]) ^ 3 = (1 : Matrix (Fin 3) (Fin 3) F)
  rw [Matrix.diagonal_pow]
  have hc : (omega ^ 2) ^ 3 = 1 := by
    rw [← pow_mul, show (2 : ℕ) * 3 = 3 * 2 from rfl, pow_mul, omega_cube, one_pow]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [omega_cube, hc]

theorem cycleSL_cube : cycleSL ^ 3 = 1 := by
  apply Subtype.ext
  change (!![0, 1, 0; 0, 0, 1; 1, 0, 0] : Matrix (Fin 3) (Fin 3) F) ^ 3 = 1
  norm_num [pow_succ, Matrix.mul_fin_three]
  exact Matrix.one_fin_three.symm

theorem diagonalSL_fixed : slAction diagonalSL = diagonalSL := by
  apply (MulAut.mem_fixedSubgroup _ _).mp
  apply (mem_unitary_iff _).mpr
  change ((Matrix.diagonal ![1, omega, omega ^ 2]).map fun x => x ^ 2).transpose *
    Matrix.diagonal ![1, omega, omega ^ 2] = 1
  have hc : omega ^ 4 * omega ^ 2 = 1 := by
    rw [pow_four, ← pow_succ', omega_cube]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three, ← pow_mul, ← pow_succ, omega_cube, hc]

theorem cycleSL_fixed : slAction cycleSL = cycleSL := by
  apply (MulAut.mem_fixedSubgroup _ _).mp
  apply (mem_unitary_iff _).mpr
  change ((!![0, 1, 0; 0, 0, 1; 1, 0, 0] : Matrix (Fin 3) (Fin 3) F).map
    fun x => x ^ 2).transpose * !![0, 1, 0; 0, 0, 1; 1, 0, 0] = 1
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [Matrix.mul_apply, Fin.sum_univ_succ]

@[expose] def diagonal : unitary := ⟨diagonalSL, (MulAut.mem_fixedSubgroup _ _).mpr diagonalSL_fixed⟩
@[expose] def cycle : unitary := ⟨cycleSL, (MulAut.mem_fixedSubgroup _ _).mpr cycleSL_fixed⟩

/-- The concrete subgroup generated by D and P; no structural property is assumed. -/
@[expose] def heisenberg : Subgroup unitary := Subgroup.closure {diagonal, cycle}

/-- Cubic generators vanish in every two-group quotient. -/
theorem heisenberg_le_residual : heisenberg ≤ pResidual 2 unitary := by
  apply (Subgroup.closure_le _).mpr
  intro x hx
  rcases hx with rfl | rfl
  · apply Subgroup.mem_pResidual_of_orderOf_coprime
    exact Nat.Coprime.of_dvd_right
      (orderOf_dvd_of_pow_eq_one (show diagonal ^ 3 = 1 from Subtype.ext diagonalSL_cube))
      (by decide : Nat.Coprime 2 3)
  · apply Subgroup.mem_pResidual_of_orderOf_coprime
    exact Nat.Coprime.of_dvd_right
      (orderOf_dvd_of_pow_eq_one (show cycle ^ 3 = 1 from Subtype.ext cycleSL_cube))
      (by decide : Nat.Coprime 2 3)

/-- Its image in the actual fixed projective subgroup. -/
@[expose] def projectiveHeisenberg : Subgroup projectiveAction.fixedSubgroup :=
  heisenberg.map fixedProjection

theorem projectiveHeisenberg_le_residual : projectiveHeisenberg ≤
    pResidual 2 projectiveAction.fixedSubgroup :=
  (Subgroup.map_mono heisenberg_le_residual).trans
    (Subgroup.map_pResidual_le 2 fixedProjection)

end
end Matrix.PSL3Four.ProjectiveGraphField
