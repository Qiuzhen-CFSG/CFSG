module

public import Theory.SpecificGroups.PSL3Four.CentralCover.FixedResiduals.ProjectiveGraphField.Monomial

/-!
# The concrete projective monomial subgroup is elementary of order nine

For the actual matrices D = diag(1, ω, ω²) and P cycling the three coordinates,
the identity PD = (ωI)DP makes their projective images commute. Their cubes
are one, so (a,b) ↦ [D]^a[P]^b defines a homomorphism from the additive plane
over ZMod 3. Comparing diagonal entries shows that D^a P^b can be scalar
only when both coordinates vanish. The homomorphism is therefore injective;
its range is exactly the projective image of the subgroup generated by D and P.

This proves the unconditional equivalence for the concrete image. Identifying
that image with the entire two-residual is the separate normal-quotient step.

Source: the matrix calculation used in Aschbacher--Smith 15.3.38,
combined 1 March 2004 manuscript, printed pp.1136--1137.
-/

public section
namespace Matrix.PSL3Four.ProjectiveGraphField
noncomputable section

private def scalarOmega : SL :=
  ⟨Matrix.scalar (Fin 3) omega, by
    simpa [Matrix.scalar, Matrix.det_diagonal, Fin.prod_univ_three, ← pow_succ'] using omega_cube⟩

private theorem scalarOmega_central : scalarOmega ∈ Subgroup.center SL :=
  SpecialLinearGroup.mem_center_iff.mpr ⟨omega, omega_cube, rfl⟩

private theorem cycle_diagonal_relation :
    cycleSL * diagonalSL = scalarOmega * (diagonalSL * cycleSL) := by
  apply Subtype.ext
  change (!![0, 1, 0; 0, 0, 1; 1, 0, 0] : Matrix (Fin 3) (Fin 3) F) *
      Matrix.diagonal ![1, omega, omega ^ 2] =
    Matrix.scalar (Fin 3) omega *
      (Matrix.diagonal ![1, omega, omega ^ 2] * !![0, 1, 0; 0, 0, 1; 1, 0, 0])
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three, Matrix.scalar, ← pow_succ', omega_cube]
  exact pow_two omega

/-- The two specified generators commute after actual projectivization. -/
theorem projective_diagonal_cycle_commute :
    Commute (fixedProjection diagonal) (fixedProjection cycle) := by
  apply (show Function.Injective (Subtype.val : projectiveAction.fixedSubgroup → PSL) from
    Subtype.val_injective)
  change (QuotientGroup.mk' (Subgroup.center SL)) (diagonalSL * cycleSL) =
    (QuotientGroup.mk' (Subgroup.center SL)) (cycleSL * diagonalSL)
  rw [cycle_diagonal_relation]
  have hs : (QuotientGroup.mk' (Subgroup.center SL)) scalarOmega = 1 :=
    (QuotientGroup.eq_one_iff scalarOmega).mpr scalarOmega_central
  simp only [map_mul, hs, one_mul]

private theorem omega_sq_ne_one : omega ^ 2 ≠ 1 := by
  intro h
  apply omega_ne_one
  simpa [pow_succ, h] using omega_cube

private theorem scalar_word_coordinates (a b : ZMod 3)
    (h : diagonalSL ^ a.val * cycleSL ^ b.val ∈ Subgroup.center SL) : a = 0 ∧ b = 0 := by
  obtain ⟨r, hr, he⟩ := SpecialLinearGroup.mem_center_iff.mp h
  change Matrix.scalar (Fin 3) r =
    (Matrix.diagonal ![1, omega, omega ^ 2]) ^ a.val *
      (!![0, 1, 0; 0, 0, 1; 1, 0, 0] : Matrix (Fin 3) (Fin 3) F) ^ b.val at he
  have h00 := congrArg (fun A : Matrix (Fin 3) (Fin 3) F => A 0 0) he
  have h11 := congrArg (fun A : Matrix (Fin 3) (Fin 3) F => A 1 1) he
  fin_cases a <;> fin_cases b <;>
    norm_num [ZMod.val, Matrix.scalar, Matrix.mul_apply, Fin.sum_univ_three,
      pow_succ, Matrix.cons_val_two, Matrix.one_apply, Matrix.diagonal_apply] at h00 h11 ⊢
  all_goals subst r
  all_goals first
    | rfl
    | solve | simp at hr
    | exact False.elim (omega_ne_one h11.symm)
    | exact False.elim (omega_sq_ne_one (by simpa [pow_two] using h11.symm))

private theorem projective_diagonal_cube : (fixedProjection diagonal) ^ 3 = 1 := by
  rw [← map_pow, show diagonal ^ 3 = 1 from Subtype.ext diagonalSL_cube, map_one]

private theorem projective_cycle_cube : (fixedProjection cycle) ^ 3 = 1 := by
  rw [← map_pow, show cycle ^ 3 = 1 from Subtype.ext cycleSL_cube, map_one]

/-- The concrete projective word with its two exponents taken modulo three. -/
def projectiveCoordinates : Multiplicative (Fin 2 → ZMod 3) →*
    projectiveAction.fixedSubgroup where
  toFun x := (fixedProjection diagonal) ^ (x.toAdd 0).val *
    (fixedProjection cycle) ^ (x.toAdd 1).val
  map_one' := by simp
  map_mul' x y := by
    change (fixedProjection diagonal) ^ (x.toAdd 0 + y.toAdd 0).val *
      (fixedProjection cycle) ^ (x.toAdd 1 + y.toAdd 1).val = _
    rw [ZMod.val_add, ZMod.val_add,
      ← pow_eq_pow_mod _ projective_diagonal_cube, ← pow_eq_pow_mod _ projective_cycle_cube,
      pow_add, pow_add]
    exact (projective_diagonal_cycle_commute.pow_pow
      (y.toAdd 0).val (x.toAdd 1).val).mul_mul_mul_comm _ _

@[simp] theorem projectiveCoordinates_apply (x : Multiplicative (Fin 2 → ZMod 3)) :
    projectiveCoordinates x = (fixedProjection diagonal) ^ (x.toAdd 0).val *
      (fixedProjection cycle) ^ (x.toAdd 1).val := by rfl

/-- Independence of the two projective generators, proved modulo scalar matrices. -/
theorem projectiveCoordinates_injective : Function.Injective projectiveCoordinates := by
  apply (MonoidHom.ker_eq_bot_iff projectiveCoordinates).mp
  apply bot_unique
  intro x hx
  change (fixedProjection diagonal) ^ (x.toAdd 0).val *
    (fixedProjection cycle) ^ (x.toAdd 1).val = 1 at hx
  have hc : diagonalSL ^ (x.toAdd 0).val * cycleSL ^ (x.toAdd 1).val ∈
      Subgroup.center SL := by
    apply (mem_fixedProjection_ker (diagonal ^ (x.toAdd 0).val *
      cycle ^ (x.toAdd 1).val)).mp
    change fixedProjection (diagonal ^ (x.toAdd 0).val * cycle ^ (x.toAdd 1).val) = 1
    simpa only [map_mul, map_pow] using hx
  obtain ⟨h0, h1⟩ := scalar_word_coordinates (x.toAdd 0) (x.toAdd 1) hc
  change x = 1
  apply Multiplicative.toAdd.injective
  funext i
  fin_cases i
  · exact h0
  · exact h1

/-- The coordinate homomorphism covers precisely the given projective image. -/
theorem projectiveCoordinates_range : projectiveCoordinates.range = projectiveHeisenberg := by
  have hd : fixedProjection diagonal ∈ projectiveHeisenberg :=
    ⟨diagonal, Subgroup.subset_closure (by simp), rfl⟩
  have hp : fixedProjection cycle ∈ projectiveHeisenberg :=
    ⟨cycle, Subgroup.subset_closure (by simp), rfl⟩
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact projectiveHeisenberg.mul_mem (projectiveHeisenberg.pow_mem hd _)
      (projectiveHeisenberg.pow_mem hp _)
  · change heisenberg.map fixedProjection ≤ projectiveCoordinates.range
    apply Subgroup.map_le_iff_le_comap.mpr
    apply (Subgroup.closure_le _).mpr
    intro x hx
    rcases hx with rfl | rfl
    · exact ⟨Multiplicative.ofAdd ![1, 0], by
        simp [projectiveCoordinates, ZMod.val_one_eq_one_mod]⟩
    · exact ⟨Multiplicative.ofAdd ![0, 1], by
        simp [projectiveCoordinates, ZMod.val_one_eq_one_mod]⟩

/-- The actual projective monomial image is the elementary abelian group E₉. -/
noncomputable def projectiveHeisenbergEquiv : projectiveHeisenberg ≃*
    Multiplicative (Fin 2 → ZMod 3) :=
  (MulEquiv.subgroupCongr projectiveCoordinates_range.symm).trans
    (MonoidHom.ofInjective projectiveCoordinates_injective).symm

/-- The inverse equivalence is the specified projective matrix word. -/
@[simp] theorem projectiveHeisenbergEquiv_symm_apply (x : Multiplicative (Fin 2 → ZMod 3)) :
    (projectiveHeisenbergEquiv.symm x : projectiveAction.fixedSubgroup) =
      projectiveCoordinates x := by rfl

end
end Matrix.PSL3Four.ProjectiveGraphField
