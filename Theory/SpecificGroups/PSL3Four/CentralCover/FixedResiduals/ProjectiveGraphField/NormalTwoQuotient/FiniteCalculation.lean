module

public import Mathlib.LinearAlgebra.Matrix.Notation
public import Mathlib.Data.Fintype.Pi

/-!
# Finite arithmetic for the normal subgroup of SU₃(2)

The four codes represent 0, 1, ω, ω², with ω² = ω + 1. The arithmetic tables
below are evaluated in the actual GF(4) by the parent module, which proves
that evaluation is bijective and preserves addition, multiplication and the
Hermitian adjoint. The code type's ordinary modular arithmetic is not used
for field operations.

For determinant-one unitary matrices the first two rows determine the third:
it is the squared cross product. `completeM` therefore gives only 4⁶ candidates.
The kernel-checked finite calculation proves that conjugating D and P, and
taking fourth powers, produces words CᵃDᵇPᶜ, where C = DPD²P². The parent
module transports these identities to the concrete subgroup generated by D,P.

Source: the unitary matrix calculation used in Aschbacher--Smith 15.3.38,
combined manuscript of 1 March 2004, printed pp.1136--1137. No order or
recognition assertion is assumed in this calculation.
-/

@[expose] public section

namespace Matrix.PSL3Four.ProjectiveGraphField.NormalTwoCalculation

abbrev Code := Fin 4
abbrev Mat := Matrix (Fin 3) (Fin 3) Code

def addC (a b : Code) : Code :=
  !![0,1,2,3; 1,0,3,2; 2,3,0,1; 3,2,1,0] a b

def mulC (a b : Code) : Code :=
  !![0,0,0,0; 0,1,2,3; 0,2,3,1; 0,3,1,2] a b

def sqC (a : Code) : Code := mulC a a

def mulM (a b : Mat) : Mat := fun i j =>
  addC (addC (mulC (a i 0) (b 0 j)) (mulC (a i 1) (b 1 j)))
    (mulC (a i 2) (b 2 j))

def oneM : Mat := !![1,0,0; 0,1,0; 0,0,1]

def starM (a : Mat) : Mat := fun i j => sqC (a j i)

def powM (a : Mat) : ℕ → Mat
  | 0 => oneM
  | n+1 => mulM (powM a n) a

def diagM : Mat := !![1,0,0; 0,2,0; 0,0,3]
def cycleM : Mat := !![0,1,0; 0,0,1; 1,0,0]
def commM : Mat := mulM (mulM (mulM diagM cycleM) (powM diagM 2)) (powM cycleM 2)
def formM (a b c : Fin 3) : Mat :=
  mulM (mulM (powM commM a.val) (powM diagM b.val)) (powM cycleM c.val)

def completeM (a b c d e f : Code) : Mat :=
  !![a,b,c; d,e,f;
    sqC (addC (mulC b f) (mulC c e)),
    sqC (addC (mulC c d) (mulC a f)),
    sqC (addC (mulC a e) (mulC b d))]


private def fastFormM (a b c : Fin 3) : Mat := fun i j =>
  if j.val = (i.val + c.val) % 3 then
    mulC (![1,3,2] a) (!![1,1,1; 1,2,3; 1,3,2] i b)
  else 0

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
private theorem formM_eq_fastFormM : ∀ a b c : Fin 3,
    formM a b c = fastFormM a b c := by
  decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
/-- The three finite matrix identities needed for normality and the two-group quotient. -/
private theorem fastChecks : ∀ a b c d e f : Code,
    let A := completeM a b c d e f
    mulM (starM A) A = oneM →
    (∃ i j k : Fin 3, mulM (mulM A diagM) (starM A) = fastFormM i j k) ∧
    (∃ i j k : Fin 3, mulM (mulM A cycleM) (starM A) = fastFormM i j k) ∧
    (∃ i j k : Fin 3, powM A 4 = fastFormM i j k) := by
  intro a b
  fin_cases a <;> fin_cases b <;> decide +kernel


/-- The three finite matrix identities needed for normality and the two-group quotient. -/
theorem checks : ∀ a b c d e f : Code,
    let A := completeM a b c d e f
    mulM (starM A) A = oneM →
    (∃ i j k : Fin 3, mulM (mulM A diagM) (starM A) = formM i j k) ∧
    (∃ i j k : Fin 3, mulM (mulM A cycleM) (starM A) = formM i j k) ∧
    (∃ i j k : Fin 3, powM A 4 = formM i j k) := by
  intro a b c d e f A h
  obtain ⟨⟨i,j,k,hd⟩,⟨l,m,n,hp⟩,⟨r,s,t,h4⟩⟩ := fastChecks a b c d e f h
  exact ⟨⟨i,j,k,hd.trans (formM_eq_fastFormM i j k).symm⟩,
    ⟨l,m,n,hp.trans (formM_eq_fastFormM l m n).symm⟩,
    ⟨r,s,t,h4.trans (formM_eq_fastFormM r s t).symm⟩⟩


end Matrix.PSL3Four.ProjectiveGraphField.NormalTwoCalculation
