module

public import Theory.SpecificGroups.PSL3Four.CentralCover.FixedResiduals.ProjectiveGraphField.Monomial
public import Theory.SpecificGroups.PSL3Four.CentralCover.FixedResiduals.ProjectiveGraphField.NormalTwoQuotient.FiniteCalculation

/-!
# The normal monomial subgroup and two-group quotient of SU₃(2)

The subgroup generated by D = diag(1,ω,ω²) and the cyclic permutation matrix P
is normal in the actual graph-field fixed subgroup of SL₃(GF(4)). Every element
of that fixed subgroup has fourth power in the generated subgroup. Consequently
the quotient is a two-group, supplying the two structural premises of
`unitary_residual_eq_of_two_quotient`.

The proof identifies the four coordinate codes with the actual GF(4), including
addition and multiplication. The unitary inverse equation and the adjugate
formula determine the last row from the first two. The finite calculation in
`FiniteCalculation` then expresses conjugates of D,P and fourth powers as words
in D,P. Subgroup closure gives normality, and the fourth-power identity descends
to the quotient. All finite identities are checked by the Lean kernel.

Source: Aschbacher--Smith 15.3.38, combined manuscript of 1 March 2004,
printed pp.1136--1137, the E₉ residual of the projective graph-field centralizer.
This module supplies its normal-quotient calculation on the specified SL carrier.
-/

public section

namespace Matrix.PSL3Four.ProjectiveGraphField
open NormalTwoCalculation

private noncomputable def evalC (x : Code) : F := ![0,1,omega,omega^2] x

private theorem omega_sq : omega ^ 2 = omega + 1 := by
  have hp : (omega - 1) * (omega ^ 2 + omega + 1) = 0 := by
    calc
      _ = omega ^ 3 - 1 := by ring
      _ = 0 := by rw [omega_cube, sub_self]
  have hs := (mul_eq_zero.mp hp).resolve_left (sub_ne_zero.mpr omega_ne_one)
  apply add_right_cancel (b := omega + 1)
  calc
    omega ^ 2 + (omega + 1) = 0 := by simpa only [add_assoc] using hs
    _ = (omega + 1) + (omega + 1) := (CharTwo.add_self_eq_zero _).symm

private theorem evalC_injective : Function.Injective evalC := by
  have h20 : omega ^ 2 ≠ 0 := pow_ne_zero _ omega_ne_zero
  have h21 : omega ^ 2 ≠ 1 := by rw [omega_sq]; simpa using omega_ne_zero
  have h22 : omega ^ 2 ≠ omega := omega_not_fixed
  intro x y h
  fin_cases x <;> fin_cases y <;>
    dsimp [evalC] at h <;>
    first | rfl
          | exact (zero_ne_one h).elim | exact (one_ne_zero h).elim
          | exact (omega_ne_zero h).elim | exact (omega_ne_zero h.symm).elim
          | exact (omega_ne_one h).elim | exact (omega_ne_one h.symm).elim
          | exact (h20 h).elim | exact (h20 h.symm).elim
          | exact (h21 h).elim | exact (h21 h.symm).elim
          | exact (h22 h).elim | exact (h22 h.symm).elim

private theorem evalC_surjective : Function.Surjective evalC := by
  let := Fintype.ofFinite F
  apply ((Fintype.bijective_iff_injective_and_card evalC).mpr ⟨evalC_injective, ?_⟩).surjective
  rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, card_F]

private theorem evalC_add (a b : Code) : evalC (addC a b) = evalC a + evalC b := by
  fin_cases a <;> fin_cases b <;>
    simp [addC, evalC, omega_sq, ← add_assoc, CharTwo.add_self_eq_zero,
      add_comm (1 : F) omega] <;>
    first | rw [add_assoc, CharTwo.add_self_eq_zero, add_zero]
          | rw [add_right_comm, CharTwo.add_self_eq_zero, zero_add]

private theorem evalC_mul (a b : Code) : evalC (mulC a b) = evalC a * evalC b := by
  fin_cases a <;> fin_cases b <;>
    simp [mulC, evalC, ← pow_succ, ← pow_succ', ← pow_add, omega_cube, pow_four]
  all_goals ring

private theorem evalC_sq (a : Code) : evalC (sqC a) = evalC a ^ 2 := by
  rw [sqC, evalC_mul, pow_two]

private noncomputable def evalM (a : Mat) : Matrix (Fin 3) (Fin 3) F := fun i j => evalC (a i j)

private theorem evalM_injective : Function.Injective evalM := by
  intro a b h
  funext i j
  exact evalC_injective (congrFun (congrFun h i) j)

private theorem evalM_mul (a b : Mat) : evalM (mulM a b) = evalM a * evalM b := by
  ext i j
  simp [evalM, mulM, evalC_add, evalC_mul, Matrix.mul_apply, Fin.sum_univ_three]

private theorem evalM_one : evalM oneM = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [evalM, evalC, oneM]

private theorem evalM_star (a : Mat) : evalM (starM a) =
    ((evalM a).map fun x => x ^ 2).transpose := by
  ext i j
  exact evalC_sq _

private theorem evalM_pow (a : Mat) (n : ℕ) : evalM (powM a n) = evalM a ^ n := by
  induction n with
  | zero => simp [powM, evalM_one]
  | succ n ih => rw [powM, evalM_mul, ih, pow_succ]

private theorem unitary_inv (g : unitary) :
    (g.val⁻¹).val = (g.val.val.map fun x => x ^ 2).transpose := by
  have h := (MulAut.mem_fixedSubgroup _ _).mp g.property
  rw [slAction_apply] at h
  have hh := congrArg (fun z : SL => z⁻¹) h
  simp only [inv_inv] at hh
  refine (congrArg Subtype.val hh).symm.trans ?_
  ext i j
  exact slFrobenius_apply g.val j i

private theorem unitary_third_row (g : unitary) :
    g.val.val 2 = ![
      (g.val.val 0 1 * g.val.val 1 2 + g.val.val 0 2 * g.val.val 1 1) ^ 2,
      (g.val.val 0 2 * g.val.val 1 0 + g.val.val 0 0 * g.val.val 1 2) ^ 2,
      (g.val.val 0 0 * g.val.val 1 1 + g.val.val 0 1 * g.val.val 1 0) ^ 2] := by
  have h := unitary_inv g
  rw [SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_three] at h
  funext i
  have hi := congrArg (fun A : Matrix (Fin 3) (Fin 3) F => (A i 2) ^ 2) h
  fin_cases i <;>
    simpa [Matrix.map_apply, Matrix.transpose_apply, CharTwo.sub_eq_add, CharTwo.neg_eq,
      ← pow_mul, pow_four, add_comm] using hi.symm

private theorem unitary_complete (g : unitary) :
    ∃ a b c d e f : Code, evalM (completeM a b c d e f) = g.val.val := by
  obtain ⟨a, ha⟩ := evalC_surjective (g.val.val 0 0)
  obtain ⟨b, hb⟩ := evalC_surjective (g.val.val 0 1)
  obtain ⟨c, hc⟩ := evalC_surjective (g.val.val 0 2)
  obtain ⟨d, hd⟩ := evalC_surjective (g.val.val 1 0)
  obtain ⟨e, he⟩ := evalC_surjective (g.val.val 1 1)
  obtain ⟨f, hf⟩ := evalC_surjective (g.val.val 1 2)
  refine ⟨a,b,c,d,e,f, ?_⟩
  have hrow := unitary_third_row g
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [evalM, completeM, evalC_sq, evalC_add, evalC_mul, ha, hb, hc, hd, he, hf,
      congrFun hrow 0, congrFun hrow 1, congrFun hrow 2]

private theorem unitary_gram {a : Mat} {g : unitary} (h : evalM a = g.val.val) :
    mulM (starM a) a = oneM := by
  apply evalM_injective
  rw [evalM_mul, evalM_star, evalM_one, h]
  exact (mem_unitary_iff _).mp g.property

private theorem evalM_diag : evalM diagM = diagonal.val.val := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [evalM, diagM, evalC, diagonal, diagonalSL]

private theorem evalM_cycle : evalM cycleM = cycle.val.val := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

private noncomputable def word (a b c : Fin 3) : unitary :=
  (diagonal * cycle * diagonal ^ 2 * cycle ^ 2) ^ a.val * diagonal ^ b.val * cycle ^ c.val

private theorem word_mem (a b c : Fin 3) : word a b c ∈ heisenberg := by
  have hd : diagonal ∈ heisenberg := Subgroup.subset_closure (by simp)
  have hp : cycle ∈ heisenberg := Subgroup.subset_closure (by simp)
  exact heisenberg.mul_mem (heisenberg.mul_mem
    (heisenberg.pow_mem (heisenberg.mul_mem
      (heisenberg.mul_mem (heisenberg.mul_mem hd hp) (heisenberg.pow_mem hd 2))
      (heisenberg.pow_mem hp 2)) _)
    (heisenberg.pow_mem hd _)) (heisenberg.pow_mem hp _)

private theorem evalM_form (a b c : Fin 3) : evalM (formM a b c) = (word a b c).val.val := by
  simp only [formM, commM, evalM_mul, evalM_pow, evalM_diag, evalM_cycle]
  rfl

private theorem mem_of_form (g : unitary) (a b c : Fin 3)
    (h : g.val.val = evalM (formM a b c)) : g ∈ heisenberg := by
  have he : g = word a b c := Subtype.ext (Subtype.ext (h.trans (evalM_form a b c)))
  rw [he]
  exact word_mem a b c

private theorem concrete_structure (g : unitary) :
    g * diagonal * g⁻¹ ∈ heisenberg ∧ g * cycle * g⁻¹ ∈ heisenberg ∧
      g ^ 4 ∈ heisenberg := by
  obtain ⟨a,b,c,d,e,f,hg⟩ := unitary_complete g
  obtain ⟨⟨i,j,k,hd⟩, ⟨l,m,n,hp⟩, ⟨r,s,t,h4⟩⟩ :=
    checks a b c d e f (unitary_gram hg)
  refine ⟨mem_of_form _ i j k ?_, mem_of_form _ l m n ?_, mem_of_form _ r s t ?_⟩
  · rw [← hd, evalM_mul, evalM_mul, evalM_diag, evalM_star, hg, ← unitary_inv]
    rfl
  · rw [← hp, evalM_mul, evalM_mul, evalM_cycle, evalM_star, hg, ← unitary_inv]
    rfl
  · rw [← h4, evalM_pow, hg]
    rfl

/-- The concrete subgroup generated by D and P is normal inside the unitary group. -/
instance heisenberg_normal : heisenberg.Normal where
  conj_mem n hn g := by
    have h : heisenberg ≤ heisenberg.comap (MulAut.conj g).toMonoidHom := by
      apply (Subgroup.closure_le _).mpr
      intro x hx
      rcases hx with rfl | rfl
      · exact (concrete_structure g).1
      · exact (concrete_structure g).2.1
    exact h hn

/-- Every determinant-one unitary matrix has fourth power in the monomial subgroup. -/
theorem unitary_pow_four_mem_heisenberg (g : unitary) : g ^ 4 ∈ heisenberg :=
  (concrete_structure g).2.2

/-- The quotient by the concrete monomial subgroup is a two-group. -/
theorem unitary_quotient_isTwoGroup : IsPGroup 2 (unitary ⧸ heisenberg) := by
  intro x
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective heisenberg x
  refine ⟨2, ?_⟩
  change (QuotientGroup.mk' heisenberg g) ^ 4 = 1
  rw [← map_pow]
  exact (QuotientGroup.eq_one_iff _).mpr (unitary_pow_four_mem_heisenberg g)

end Matrix.PSL3Four.ProjectiveGraphField
