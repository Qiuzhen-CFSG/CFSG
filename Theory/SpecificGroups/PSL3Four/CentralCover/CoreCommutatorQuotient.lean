module

public import Theory.GroupTheory.CoreCommutatorCentralCover
public import Theory.SpecificGroups.PSL3Four.CentralCover.ElementaryParabolic.Commutator

/-!
# The full parabolic cores above the Hermitian module

Pass from X to X/W using the literal component projection. The elementary
central kernel allows I.2.2(3b)'s parabolic commutator theorem to apply there.
Pulling it back gives [O₂(P),P] W = O₂(P) in the original X for both marked
parabolics, with the whole W and covering kernel preserved.

This is the covering-group input to Aschbacher–Smith 8.2.10(3), printed
p.721, using I.2.2(3b), pp.409–410, refs/quasithin.pdf. It does not assert
that the remaining central kernel is trivial.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
namespace Matrix.PSL3Four.ElementaryParabolic
open CoreCommutatorCover
variable {X : Type*} [Group X] [Finite X] [Group.IsPerfect X]
  (W : Subgroup X) [W.Normal]
  (f : X →* PSL) (hf : Function.Surjective f)
  (hW : W ≤ pCore 2 X) (hk : f.ker = pCore 2 X)
  (hcomm : ⁅pCore 2 X,(⊤ : Subgroup X)⁆ ≤ W)
  [IsElementaryAbelian 2 (pCore 2 X)]

include hf hW hk hcomm in
/-- The actual parabolic core is generated by its commutators and W. -/
theorem lifted_parabolic_core_structure (b : Bool) :
    let P := liftedParabolic f b
    ⁅P.pCoreIn 2,P⁆ ⊔ W = P.pCoreIn 2 ∧
      (⁅(solvableResidual P).pCoreIn 2,solvableResidual P⁆).map P.subtype ⊔ W =
        P.pCoreIn 2 := by
  let q := QuotientGroup.mk' W
  let g := CoreCommutatorCover.projection W f hW hk
  have hg : Function.Surjective g := projection_surjective W f hf hW hk
  have hc : g.ker ≤ center (X ⧸ W) := projection_central W f hW hk hcomm
  have hgs : ∀ z ∈ g.ker,z^2=1 := by
    rw [projection_ker]
    rintro _ ⟨x,hx,rfl⟩
    rw [←map_pow,elemPow_eq_one_of_isElementaryAbelian x hx,map_one]
  let : Group.IsPerfect (X ⧸ W) := Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective W)
  let P := liftedParabolic f b
  let Q := liftedParabolic g b
  let a : P →* Q := (q.comp P.subtype).codRestrict Q (by
    intro x
    exact x.property)
  have ha : Function.Surjective a := by
    intro y
    obtain ⟨x,hx⟩ := QuotientGroup.mk'_surjective W y.val
    refine ⟨⟨x,?_⟩,Subtype.ext hx⟩
    change g (q x) ∈ Matrix.PSL3.RootPlaneGeometry.parabolic F b
    rw [hx]
    exact y.property
  have hak : a.ker = W.subgroupOf P := by
    ext x
    change a x = 1 ↔ (x : X) ∈ W
    rw [Subtype.ext_iff]
    exact QuotientGroup.eq_one_iff x.val
  have hW2 : IsPGroup 2 W := pCore_isPGroup.to_le hW
  have ha2 : IsPGroup 2 a.ker := hak.symm ▸ hW2.comap_of_injective P.subtype P.subtype_injective
  have hh := a.core_commutator_sup_kernel ha ha2 (parabolicCore_commutator g hg hc hgs b)
  have hWP : W ≤ P := by
    intro x hx
    change f x ∈ Matrix.PSL3.RootPlaneGeometry.parabolic F b
    rw [show f x=1 from hk.ge (hW hx)]
    exact one_mem _
  have he := congrArg (Subgroup.map P.subtype) hh
  rw [Subgroup.map_sup,map_commutator,hak,map_subgroupOf_eq_of_le hWP,
    ←MonoidHom.range_eq_map,range_subtype] at he
  refine ⟨he,?_⟩
  have hg2 : IsPGroup 2 g.ker := by
    rw [CoreCommutatorCover.projection_ker]
    exact pCore_isPGroup.map _
  let : Group.IsPerfect Q := parabolic_isPerfect g hg hc hg2 b
  have hr := a.residual_core_commutator_sup_kernel ha ha2
    (parabolicCore_commutator g hg hc hgs b)
  have hr' := congrArg (Subgroup.map P.subtype) hr
  rw [Subgroup.map_sup,hak,map_subgroupOf_eq_of_le hWP] at hr'
  exact hr'

end Matrix.PSL3Four.ElementaryParabolic
