module

public import Theory.SpecificGroups.PSL3Four.CentralCover.ExtendedCentralizer.ResidualAction.CoverCentralizers.CoverAction.DiagonalCenter.UniversalKernel
public import Theory.SpecificGroups.PSL3Four.CentralCover.ExtendedCentralizer.ResidualAction.CoverCentralizers.CoverAction.DiagonalCenter.KernelGeneration.LinearReduction
public import Theory.SpecificGroups.PSL3Four.CentralCover.ExtendedCentralizer.ResidualAction.CoverCentralizers.CoverAction.DiagonalCenter.KernelGeneration.BinaryCoordinates
public import Theory.SpecificGroups.PSL3Four.CentralCover.ExtendedCentralizer.ResidualAction.CoverCentralizers.CoverAction.DiagonalCenter.KernelGeneration.CubicCoinvariants
public import Theory.SpecificGroups.PSL3Four.CentralCover.ExtendedCentralizer.ResidualAction.CoverCentralizers.CoverAction.DiagonalCenter.KernelGeneration.UniversalMovement
public import Theory.SpecificGroups.PSL3Four.CentralCover.ExtendedCentralizer.ResidualAction.CoverCentralizers.CoverAction.DiagonalCenter.KernelGeneration.ActorReduction

/-!
# Diagonal coinvariants of the universal PSL₃(4) kernel

The actual universal kernel is generated by its squares and its displacements
under every cubic standard outer automorphism. The concrete exceptional cover
has two permutation coordinates related by checked diagonal words. Perfectness
identifies the second coordinate with the first after the compatible lift;
one central generator consequently has a nonsquare displacement.

The universal comparison transports this moved class to the canonical kernel.
Its quotient by squares is a binary plane, where any nonidentity cubic action
has surjective displacement. The two powers of this diagonal actor exhaust
the nontrivial diagonal determinants, and inner factors fix the kernel.
The original conditional coordinate reductions are retained below.

Source: Aschbacher--Smith 15.3.38, printed pp.1136--1137, and I.1.3(6),
printed p.407, manuscript of 1 March 2004. Final assembly of the marked-element
application remains in the existing `DiagonalCenter` consumer.
-/

public section
open Subgroup PerfectCentralCovering
namespace Matrix.PSL3Four.ExtendedCentralizer.CoverCentralizers.DiagonalCenter

/-- Inner factors do not change the required kernel calculation. -/
theorem kernel_generation_of_diagonal_representatives
    (hdiag : ∀ u : Fˣ, u ≠ 1 → (universalProjection PSL).ker ≤
      kernelSquaresAndDisplacements (diagonalRepresentative u))
    (β : MulAut PSL) (hβ : β ∈ PSL3.OuterSolvable.standard F) (h3 : β ^ 3 = 1)
    (hout : β ∉ MulAut.innerSubgroup PSL) :
    (universalProjection PSL).ker ≤ kernelSquaresAndDisplacements β := by
  obtain ⟨u, g, hu, rfl⟩ := cubic_standard_eq_diagonal_mul_inner β hβ h3 hout
  rw [kernelSquaresAndDisplacements_mul_inner]
  exact hdiag u hu


/-- An equivariant model calculation also suffices for every standard outer
cubic actor, with no normalizer geometry or residual hypothesis. -/
theorem kernel_generation_of_equivariant_diagonals
    (hact : ∀ u : Fˣ, u ≠ 1 →
      ∃ e : (universalProjection PSL).ker ≃* ExceptionalMultiplierCoordinates,
        ∀ z, multiplierBinaryCoordinates (e (universalKernelMap (diagonalRepresentative u) z)) =
          binaryKernelRotation (multiplierBinaryCoordinates (e z)))
    (β : MulAut PSL) (hβ : β ∈ PSL3.OuterSolvable.standard F) (h3 : β ^ 3 = 1)
    (hout : β ∉ MulAut.innerSubgroup PSL) :
    (universalProjection PSL).ker ≤ kernelSquaresAndDisplacements β := by
  apply kernel_generation_of_diagonal_representatives _ β hβ h3 hout
  intro u hu
  obtain ⟨e, he⟩ := hact u hu
  exact kernel_generation_of_equivariant_multiplier_coordinates _ e he

/-- Every cubic standard outer automorphism generates the actual universal
kernel by squares and lift displacements. All model-action premises are
discharged by the concrete permutation-matrix covering calculation. -/
theorem kernel_generation (β : MulAut PSL)
    (hβ : β ∈ PSL3.OuterSolvable.standard F) (h3 : β ^ 3 = 1)
    (hout : β ∉ MulAut.innerSubgroup PSL) :
    (universalProjection PSL).ker ≤ kernelSquaresAndDisplacements β := by
  let a := PSL3.ExceptionalFourCover.KernelModel.DiagonalWords.actor
  have ha3 : a ^ 3 = 1 := actor_cube
  have ha23 : (a ^ 2) ^ 3 = 1 := by
    rw [← pow_mul, show 2 * 3 = 3 * 2 from rfl, pow_mul, ha3, one_pow]
  exact kernel_generation_of_concrete_actor
    (kernel_generation_of_moved_square_class a ha3
      PSL3.ExceptionalFourCover.canonicalKernelEquiv universal_actor_moves_modulo_squares)
    (kernel_generation_of_moved_square_class (a ^ 2) ha23
      PSL3.ExceptionalFourCover.canonicalKernelEquiv
      (exists_moved_square_class_square a ha3 universal_actor_moves_modulo_squares))
    β hβ h3 hout

end Matrix.PSL3Four.ExtendedCentralizer.CoverCentralizers.DiagonalCenter
