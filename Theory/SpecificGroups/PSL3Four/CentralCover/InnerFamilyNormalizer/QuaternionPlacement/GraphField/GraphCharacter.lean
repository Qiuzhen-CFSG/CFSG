module

public import Theory.SpecificGroups.PSL3Four.CentralCover.InnerFamilyNormalizer.QuaternionPlacement.GraphField.MarkedAction
public import Theory.SpecificGroups.PSL3.FieldComponentFixer

/-!
# A binary character of the graph-field centralizer

The subgroup generated by linear and field automorphisms has index two in
Aut(PSL₃(4)). Field transport normalizes linear conjugation, so its elements
have linear–field forms. Inverse transpose is outside this subgroup: field
automorphisms fix the binary elementary matrices, whereas no linear conjugation
can reverse all six root directions. Unconditional standard-form coverage
then supplies the two cosets. The index-two multiplication law makes their
indicator a homomorphism to C₂, independently of all choices of parameters.

Restricting this character to the full graph-field centralizer detects the
marked involution, since its Frobenius factor lies in the linear–field subgroup.
This supplies the binary input to the marked ternary matrix map; it does not
assume a centralizer model or quaternion placement.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, 16.1.4(5),
printed p.1171, and the quaternion-placement application in 16.4.9(2),
printed p.1192. Standard automorphism forms use GLS3, Theorem 2.5.12(a)
and §2.7, `refs/KGroup/GLS3/chapter2.tex`.
-/

public section

open scoped MatrixGroups
open Matrix.PSL3.OuterSolvable Matrix.PSL3.OuterSolvable.OddPrimeCoverage
open Subgroup
namespace Matrix.PSL3Four.InnerFamilyNormalizer.QuaternionPlacement.GraphField
open ExtendedCentralizer.ProjectiveFixer
noncomputable section

private def semilinear : Subgroup (MulAut PSL) :=
  innerDiagonal F ⊔ (PSL3.OuterSolvable.fieldAction F).range

private theorem field_linearConj (σ : F ≃+* F) (A : GL (Fin 3) F) :
    PSL3.OuterSolvable.fieldAction F σ * linearConj F A =
      linearConj F (GeneralLinearGroup.map σ.toRingHom A) *
        PSL3.OuterSolvable.fieldAction F σ := by
  have fieldSL_toGL (x : SL) :
      SpecialLinearGroup.toGL (SpecialLinearGroup.map σ.toRingHom x) =
        GeneralLinearGroup.map σ.toRingHom (SpecialLinearGroup.toGL x) := Units.ext rfl
  apply MulEquiv.ext
  intro y
  induction y using QuotientGroup.induction_on with
  | H x =>
    simp only [MulAut.mul_apply, fieldAction_mk, linearConj_mk]
    congr 1
    apply SpecialLinearGroup.toGL_injective
    rw [fieldSL_toGL, linearConjSL_toGL, map_mul, map_mul, map_inv,
      linearConjSL_toGL, fieldSL_toGL]

private theorem field_normalizes :
    (PSL3.OuterSolvable.fieldAction F).range ≤ normalizer (innerDiagonal F) := by
  rintro _ ⟨σ, rfl⟩
  rw [mem_normalizer_iff]
  intro x
  constructor
  · rintro ⟨A, rfl⟩
    refine ⟨GeneralLinearGroup.map σ.toRingHom A, ?_⟩
    rw [field_linearConj, mul_inv_cancel_right]
  · intro hx
    obtain ⟨A, hA⟩ := hx
    refine ⟨GeneralLinearGroup.map σ⁻¹.toRingHom A, ?_⟩
    have he := field_linearConj σ⁻¹ A
    rw [map_inv] at he
    rw [hA] at he
    have he' := congrArg (fun a : MulAut PSL => a * PSL3.OuterSolvable.fieldAction F σ) he
    simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using he'.symm

private theorem semilinear_form {a : MulAut PSL} (ha : a ∈ semilinear) :
    ∃ A σ, a = linearConj F A * PSL3.OuterSolvable.fieldAction F σ := by
  change a ∈ (↑(innerDiagonal F ⊔ (PSL3.OuterSolvable.fieldAction F).range) : Set _) at ha
  rw [coe_mul_of_right_le_normalizer_left _ _ field_normalizes] at ha
  obtain ⟨_, ⟨A, rfl⟩, _, ⟨σ, rfl⟩, rfl⟩ := ha
  exact ⟨A, σ, rfl⟩

private theorem graph_not_semilinear : graph F ∉ semilinear := by
  intro hg
  obtain ⟨A, σ, he⟩ := semilinear_form hg
  apply PSL3.FieldComponentFixer.not_linearConj_reverses_roots A
  intro i j hij
  have hh := congrArg (fun a : MulAut PSL => a (rootElement hij.symm 1)) he
  simpa only [MulAut.mul_apply, graph_rootElement,
    PSL3.FieldComponentFixer.fieldAction_rootElement, map_one, CharTwo.neg_eq] using hh.symm

private theorem semilinear_index : semilinear.index = 2 := by
  apply index_eq_two_iff_exists_notMem_and.mpr
  refine ⟨graph F, graph_not_semilinear, ?_⟩
  intro a
  obtain ⟨A, σ, t, rfl⟩ := QuaternionPlacement.exists_standardForm a
  have hlin : linearConj F A * PSL3.OuterSolvable.fieldAction F σ ∈ semilinear :=
    semilinear.mul_mem (mem_sup_left ⟨A, rfl⟩) (mem_sup_right ⟨σ, rfl⟩)
  have ht : t = 1 ∨ t = Multiplicative.ofAdd (1 : ZMod 2) := by
    exact (by decide : ∀ t : C2, t = 1 ∨ t = Multiplicative.ofAdd (1 : ZMod 2)) t
  rcases ht with rfl | rfl
  · exact Or.inr (by simpa only [standardForm, map_one, mul_one] using hlin)
  · apply Or.inl
    simpa only [standardForm, involutionHom_generator, mul_assoc, ← pow_two, graph_sq,
      mul_one] using hlin

private def graphCharacter : MulAut PSL →* C2 := by
  classical
  exact
    { toFun a := if a ∈ semilinear then 1 else Multiplicative.ofAdd (1 : ZMod 2)
      map_one' := by simp only [semilinear.one_mem, ↓reduceIte]
      map_mul' a b := by
        have hm := semilinear.mul_mem_iff_of_index_two semilinear_index (a := a) (b := b)
        by_cases ha : a ∈ semilinear <;> by_cases hb : b ∈ semilinear <;>
          simp only [hm, ha, hb, iff_true, iff_false, not_true_eq_false,
            ↓reduceIte, one_mul, mul_one]
        decide }

/-- The graph-factor character restricted to the full graph-field centralizer. -/
def binaryCharacter : automorphismCentralizer graphField →* C2 :=
  graphCharacter.comp (automorphismCentralizer graphField).subtype

private theorem graphField_not_semilinear : graphField ∉ semilinear := by
  intro h
  apply graph_not_semilinear
  have hf : pslFrobenius ∈ semilinear := by
    rw [frobenius_eq_fieldAction]
    exact mem_sup_right ⟨fieldFrobenius, rfl⟩
  have hg := semilinear.mul_mem h (semilinear.inv_mem hf)
  simpa only [graphField, mul_inv_cancel_right] using hg

/-- The character detects the distinguished graph-field involution. -/
theorem binaryCharacter_markedInvolution_ne_one : binaryCharacter markedInvolution ≠ 1 := by
  classical
  change (if graphField ∈ semilinear then (1 : C2) else Multiplicative.ofAdd (1 : ZMod 2)) ≠ 1
  rw [if_neg graphField_not_semilinear]
  decide

end
end Matrix.PSL3Four.InnerFamilyNormalizer.QuaternionPlacement.GraphField
