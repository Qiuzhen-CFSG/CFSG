module

public import Theory.SpecificGroups.PSL3Four.SylowModel

/-!
# A marked split extension of UT₃(F₄)

We use the existing UT₃(F₄) carrier, with its literal multiplication
(x,y,c)(x',y',c') = (x+x',y+y',c+c'+xy'). Diagonal units act as
(x,y,c) ↦ (ax,by,abc). The other actor is graph times Frobenius:
(x,y,c) ↦ (y²,x²,(xy-c)²). The subgroup generated by these automorphisms
acts on the root group; `Model` is that actual semidirect product.

This defines the coordinate target for the split extension in Aschbacher,
*Sporadic Groups* (1994), 46.3 and 46.14, printed pp.251 and 257–258.
No identification with an ambient normalizer is assumed or asserted here.
The marked `root` has order 64 and its center has order four, by transport
from the existing Sylow coordinates.
-/

@[expose] public section

open Subgroup
namespace Matrix.PSL3Four.RootNormalizerModel
noncomputable section

abbrev Root := SylowModel.U

/-- Diagonal scaling of the two simple root coordinates. -/
def diagonal (a : Fˣ × Fˣ) : MulAut Root where
  toFun q := ⟨a.1 * q.x, a.2 * q.y, (a.1 * a.2 : F) * q.c⟩
  invFun q := ⟨(↑a.1⁻¹ : F) * q.x, (↑a.2⁻¹ : F) * q.y,
    ((↑a.1⁻¹ : F) * (↑a.2⁻¹ : F)) * q.c⟩
  left_inv q := by
    apply SylowModel.U.ext
    · change (↑a.1⁻¹ : F) * ((a.1 : F) * q.x) = q.x
      simp
    · change (↑a.2⁻¹ : F) * ((a.2 : F) * q.y) = q.y
      simp
    · change ((↑a.1⁻¹ : F) * (↑a.2⁻¹ : F)) * (((a.1 : F) * a.2) * q.c) = q.c
      calc
        _ = ((↑a.1⁻¹ : F) * a.1) * ((↑a.2⁻¹ : F) * a.2) * q.c := by ring
        _ = q.c := by simp
  right_inv q := by
    apply SylowModel.U.ext
    · change (a.1 : F) * ((↑a.1⁻¹ : F) * q.x) = q.x
      simp
    · change (a.2 : F) * ((↑a.2⁻¹ : F) * q.y) = q.y
      simp
    · change ((a.1 : F) * a.2) * (((↑a.1⁻¹ : F) * (↑a.2⁻¹ : F)) * q.c) = q.c
      calc
        _ = ((a.1 : F) * (↑a.1⁻¹ : F)) * ((a.2 : F) * (↑a.2⁻¹ : F)) * q.c := by ring
        _ = q.c := by simp
  map_mul' q r := by
    apply SylowModel.U.ext
    · change (a.1 : F) * (q.x + r.x) = _
      exact mul_add _ _ _
    · change (a.2 : F) * (q.y + r.y) = _
      exact mul_add _ _ _
    · change ((a.1 : F) * a.2) * (q.c + r.c + q.x * r.y) =
        ((a.1 : F) * a.2) * q.c + ((a.1 : F) * a.2) * r.c +
          ((a.1 : F) * q.x) * ((a.2 : F) * r.y)
      ring

def diagonalHom : Fˣ × Fˣ →* MulAut Root where
  toFun := diagonal
  map_one' := by
    ext q
    · change (↑(1 : Fˣ) : F) * q.x = q.x
      simp
    · change (↑(1 : Fˣ) : F) * q.y = q.y
      simp
    · change ((↑(1 : Fˣ) : F) * (↑(1 : Fˣ) : F)) * q.c = q.c
      simp
  map_mul' a b := by
    ext q
    · change (↑(a.1 * b.1) : F) * q.x = (a.1 : F) * ((b.1 : F) * q.x)
      simp [mul_assoc]
    · change (↑(a.2 * b.2) : F) * q.y = (a.2 : F) * ((b.2 : F) * q.y)
      simp [mul_assoc]
    · change ((↑(a.1 * b.1) : F) * (↑(a.2 * b.2) : F)) * q.c =
        ((a.1 : F) * a.2) * (((b.1 : F) * b.2) * q.c)
      simp only [Units.val_mul]
      ring

/-- The graph automorphism interchanges the two simple root directions. -/
def graph : MulAut Root where
  toFun q := ⟨q.y, q.x, q.x * q.y - q.c⟩
  invFun q := ⟨q.y, q.x, q.x * q.y - q.c⟩
  left_inv q := by
    refine SylowModel.U.ext ?_ ?_ ?_
    · rfl
    · rfl
    · change q.y * q.x - (q.x * q.y - q.c) = q.c
      ring
  right_inv q := by
    refine SylowModel.U.ext ?_ ?_ ?_
    · rfl
    · rfl
    · change q.y * q.x - (q.x * q.y - q.c) = q.c
      ring
  map_mul' q r := by
    refine SylowModel.U.ext ?_ ?_ ?_
    · rfl
    · rfl
    · change (q.x + r.x) * (q.y + r.y) - (q.c + r.c + q.x * r.y) =
        (q.x * q.y - q.c) + (r.x * r.y - r.c) + q.y * r.x
      ring

/-- This involution combines the graph and field automorphisms. -/
def graphField : MulAut Root := SylowModel.frob * graph

def actor : Subgroup (MulAut Root) := diagonalHom.range ⊔ zpowers graphField

abbrev Model := Root ⋊[actor.subtype] actor

instance : Finite Model :=
  Finite.of_equiv (Root × actor) SemidirectProduct.equivProd.symm

/-- The marked normal root group in the split extension. -/
def root : Subgroup Model := (SemidirectProduct.inl : Root →* Model).range

def rootEquiv : Root ≃* root := MonoidHom.ofInjective SemidirectProduct.inl_injective

theorem root_card : Nat.card root = 64 := by
  rw [← Nat.card_congr rootEquiv.toEquiv]
  exact SylowModel.card_U

/-- The center has order four in these actual coordinates. -/
theorem root_center_card : Nat.card (center root) = 4 := by
  calc
    Nat.card (center root) = Nat.card (center SylowModel.S) :=
      Nat.card_congr (centerCongr (rootEquiv.symm.trans SylowModel.linearEquiv)).toEquiv
    _ = Nat.card ((center SylowModel.S).map SylowModel.S.subtype) :=
      (card_map_of_injective SylowModel.S.subtype_injective).symm
    _ = 4 := by rw [SylowModel.center_S, SylowModel.card_Z]

end
end Matrix.PSL3Four.RootNormalizerModel
