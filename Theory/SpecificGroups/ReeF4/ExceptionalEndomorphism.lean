module

public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.FrobeniusPowers
public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations

/-!
# The exceptional endomorphism of the concrete finite split F4 group

Over the field of order `2^(2*m+1)`, the exceptional endomorphism `σ` sends
`x_r(t)` to `x_(ρ r)(t)` for geometrically long roots and to
`x_(ρ r)(t²)` for geometrically short roots. The positive root involution
`ρ` reverses the numbered F4 diagram, as proved in `RootDuality`.

Free-word evaluation surjects onto the actual subgroup of matrix units
generated by the integral root curves. The unconditional kernel inclusion
in `WordRelations` therefore descends exceptional substitution to this
subgroup. Applying the root formula twice gives entrywise Frobenius on
generators, hence on the whole group. Frobenius is injective, so `σ` is
injective and finiteness makes it a multiplicative equivalence.

This is the characteristic-two F4 root formula of Steinberg, *Lectures on
Chevalley Groups*, Theorem 28 (`refs/KGroup/GLS3/Chapter2St1.tex`), and
GLS, Theorem 1.15.4(b) (`refs/KGroup/GLS3/Chapter1.tex`). The group and
field are the concrete finite ones used for the Ree family in
Aschbacher–Smith, Theorem 0.1.2 and Remark A.2.4 (`refs/quasithin.pdf`).
The odd-power identities prepare its fixed-point construction; no
algebraic-group existence theorem or additional compatibility premise is used.
-/

public section

namespace ReeF4

open Theory.AlgebraicGroup

private theorem eval_mem_splitGroup (m : ℕ) (w : FreeGroup (RootGeneratorIndex m)) :
    WordRelations.eval m w ∈ SplitGroup m := by
  rw [splitGroup_eq_closure]
  change WordRelations.eval m w ∈ Subgroup.closure (Set.range
    (fun rt : F4Chevalley.Root × CoefficientField m => F4Chevalley.rootCurve rt.1 rt.2))
  rw [← WordRelations.eval_range]
  exact ⟨w, rfl⟩

/-- Evaluation of root words in the concrete split carrier. -/
noncomputable def splitWordEval (m : ℕ) :
    FreeGroup (RootGeneratorIndex m) →* SplitGroup m :=
  (WordRelations.eval m).codRestrict (SplitGroup m) (eval_mem_splitGroup m)

@[simp] theorem splitWordEval_coe (m : ℕ) (w : FreeGroup (RootGeneratorIndex m)) :
    (splitWordEval m w : MatrixUnits m) = WordRelations.eval m w := by rfl

@[simp] theorem splitWordEval_of (m : ℕ) (r : F4Chevalley.Root)
    (t : CoefficientField m) :
    splitWordEval m (FreeGroup.of (r, t)) = rootGeneratorInGroup m r t := by
  apply Subtype.ext
  exact WordRelations.eval_of m r t

/-- Every element of the split carrier is represented by a root word. -/
theorem splitWordEval_surjective (m : ℕ) : Function.Surjective (splitWordEval m) := by
  intro x
  have hx : x.val ∈ (WordRelations.eval m).range := by
    rw [WordRelations.eval_range]
    exact x.property
  obtain ⟨w, hw⟩ := hx
  exact ⟨w, Subtype.ext hw⟩

private noncomputable def splitTwistedWordEval (m : ℕ) :
    FreeGroup (RootGeneratorIndex m) →* SplitGroup m :=
  (WordRelations.twistedEval m).codRestrict (SplitGroup m)
    (WordRelations.twistedEval_mem_closure m)

private theorem splitWordEval_ker_le (m : ℕ) :
    (splitWordEval m).ker ≤ (splitTwistedWordEval m).ker := by
  intro w hw
  apply Subtype.ext
  apply WordRelations.ker_eval_le_ker_twistedEval m
  exact congrArg Subtype.val hw

/-- The exceptional characteristic-two F4 endomorphism, obtained by descending
the proved root substitution through concrete word evaluation. -/
noncomputable def exceptionalEndomorphism (m : ℕ) : Monoid.End (SplitGroup m) :=
  (splitWordEval m).liftOfSurjective (splitWordEval_surjective m)
    ⟨splitTwistedWordEval m, splitWordEval_ker_le m⟩

/-- The descended endomorphism agrees with exceptional substitution on every word. -/
theorem exceptionalEndomorphism_word (m : ℕ) (w : FreeGroup (RootGeneratorIndex m)) :
    (exceptionalEndomorphism m (splitWordEval m w) : MatrixUnits m) =
      WordRelations.twistedEval m w := by
  change ((splitWordEval m).liftOfSurjective (splitWordEval_surjective m)
    ⟨splitTwistedWordEval m, splitWordEval_ker_le m⟩ (splitWordEval m w)).val = _
  rw [MonoidHom.liftOfRightInverse_comp_apply]
  rfl

@[simp] theorem exceptionalEndomorphism_rootGenerator (m : ℕ)
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    exceptionalEndomorphism m (rootGeneratorInGroup m r t) =
      rootGeneratorInGroup m (exceptionalRootPermutation r) (exceptionalParameter r t) := by
  apply Subtype.ext
  rw [← splitWordEval_of, exceptionalEndomorphism_word, WordRelations.twistedEval_of]
  rfl

/-- Long-root parameters are unchanged. -/
theorem exceptionalEndomorphism_rootGenerator_long (m : ℕ)
    (r : F4Chevalley.Root) (hr : IsLongRoot r) (t : CoefficientField m) :
    exceptionalEndomorphism m (rootGeneratorInGroup m r t) =
      rootGeneratorInGroup m (exceptionalRootPermutation r) t := by
  rw [exceptionalEndomorphism_rootGenerator, exceptionalParameter_of_long hr]

/-- Short-root parameters are squared. -/
theorem exceptionalEndomorphism_rootGenerator_short (m : ℕ)
    (r : F4Chevalley.Root) (hr : IsShortRoot r) (t : CoefficientField m) :
    exceptionalEndomorphism m (rootGeneratorInGroup m r t) =
      rootGeneratorInGroup m (exceptionalRootPermutation r) (t ^ 2) := by
  rw [exceptionalEndomorphism_rootGenerator, exceptionalParameter_of_short hr]

/-- The root formula in the ambient matrix-unit group. -/
theorem exceptionalEndomorphism_rootGenerator_coe (m : ℕ)
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    (exceptionalEndomorphism m (rootGeneratorInGroup m r t) : MatrixUnits m) =
      F4Chevalley.rootCurve (exceptionalRootPermutation r) (exceptionalParameter r t) := by
  rw [exceptionalEndomorphism_rootGenerator, rootGeneratorInGroup_coe]

/-- The root formula determines the exceptional endomorphism uniquely. -/
theorem exceptionalEndomorphism_unique (m : ℕ) (f : Monoid.End (SplitGroup m))
    (hf : ∀ (r : F4Chevalley.Root) (t : CoefficientField m),
      f (rootGeneratorInGroup m r t) =
        rootGeneratorInGroup m (exceptionalRootPermutation r) (exceptionalParameter r t)) :
    f = exceptionalEndomorphism m := by
  apply splitGroup_hom_ext
  intro r t
  exact (hf r t).trans (exceptionalEndomorphism_rootGenerator m r t).symm

/-- Applying exceptional duality twice is entrywise Frobenius on the whole group. -/
theorem exceptionalEndomorphism_comp_self (m : ℕ) :
    (exceptionalEndomorphism m).comp (exceptionalEndomorphism m) = splitFrobenius m := by
  apply splitGroup_hom_ext
  intro r t
  change exceptionalEndomorphism m (exceptionalEndomorphism m (rootGeneratorInGroup m r t)) = _
  rw [exceptionalEndomorphism_rootGenerator, exceptionalEndomorphism_rootGenerator,
    exceptionalParameter_twice, exceptionalRootPermutation_involutive r,
    splitFrobenius_rootGenerator]

theorem exceptionalEndomorphism_twice (m : ℕ) (x : SplitGroup m) :
    exceptionalEndomorphism m (exceptionalEndomorphism m x) = splitFrobenius m x :=
  DFunLike.congr_fun (exceptionalEndomorphism_comp_self m) x

/-- The square identity in the monoid of endomorphisms under composition. -/
theorem exceptionalEndomorphism_sq (m : ℕ) :
    exceptionalEndomorphism m ^ 2 = splitFrobeniusEnd m := by
  rw [pow_two]
  exact exceptionalEndomorphism_comp_self m

theorem exceptionalEndomorphism_twice_entry (m : ℕ) (x : SplitGroup m)
    (i j : F4Chevalley.BasisIndex) :
    ((exceptionalEndomorphism m (exceptionalEndomorphism m x)).val : MatrixCarrier m) i j =
      (x.val : MatrixCarrier m) i j ^ 2 := by
  rw [exceptionalEndomorphism_twice, splitFrobenius_entry]

theorem exceptionalEndomorphism_comp_frobenius (m : ℕ) :
    (exceptionalEndomorphism m).comp (splitFrobenius m) =
      (splitFrobenius m).comp (exceptionalEndomorphism m) := by
  rw [← exceptionalEndomorphism_comp_self]
  rfl

/-- Odd powers are the exceptional map followed by a power of Frobenius. -/
theorem exceptionalEndomorphism_odd_power (m n : ℕ) :
    exceptionalEndomorphism m ^ (2 * n + 1) =
      exceptionalEndomorphism m * splitFrobeniusEnd m ^ n := by
  rw [← exceptionalEndomorphism_sq, ← pow_mul, pow_succ']

/-- The odd power used to define the Ree fixed points is an involution. -/
theorem exceptionalEndomorphism_odd_power_sq (m : ℕ) :
    (exceptionalEndomorphism m ^ (2 * m + 1)) ^ 2 = 1 := by
  rw [← pow_mul, Nat.mul_comm (2 * m + 1) 2, pow_mul,
    exceptionalEndomorphism_sq, splitFrobenius_pow_fieldDegree]

theorem exceptionalEndomorphism_injective (m : ℕ) :
    Function.Injective (exceptionalEndomorphism m) := by
  intro x y h
  apply splitFrobenius_injective m
  simpa only [exceptionalEndomorphism_twice] using congrArg (exceptionalEndomorphism m) h

theorem exceptionalEndomorphism_bijective (m : ℕ) :
    Function.Bijective (exceptionalEndomorphism m) :=
  Finite.injective_iff_bijective.mp (exceptionalEndomorphism_injective m)

/-- The exceptional automorphism of the concrete finite split F4 group. -/
noncomputable def exceptionalAutomorphism (m : ℕ) : SplitGroup m ≃* SplitGroup m :=
  MulEquiv.ofBijective (exceptionalEndomorphism m) (exceptionalEndomorphism_bijective m)

@[simp] theorem exceptionalAutomorphism_apply (m : ℕ) (x : SplitGroup m) :
    exceptionalAutomorphism m x = exceptionalEndomorphism m x := by rfl

@[simp] theorem exceptionalAutomorphism_rootGenerator (m : ℕ)
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    exceptionalAutomorphism m (rootGeneratorInGroup m r t) =
      rootGeneratorInGroup m (exceptionalRootPermutation r) (exceptionalParameter r t) :=
  exceptionalEndomorphism_rootGenerator m r t

theorem exceptionalAutomorphism_twice (m : ℕ) (x : SplitGroup m) :
    exceptionalAutomorphism m (exceptionalAutomorphism m x) = splitFrobeniusEquiv m x :=
  exceptionalEndomorphism_twice m x

end ReeF4
