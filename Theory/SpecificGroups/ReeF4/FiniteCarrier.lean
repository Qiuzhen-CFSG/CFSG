module

public import Theory.SpecificGroups.ReeF4.Field
public import Theory.AlgebraicGroup.RootSystems.AlgebraicGroups.F4IntegralChevalleyRepresentation

/-!
# The finite split F4 carrier

Over the field of order `2^(2*m+1)`, the split group is the subgroup of matrix
units generated by all the integral F4 root curves. Its group structure and
finiteness are inherited from the ambient matrix units. Homomorphisms out of
this carrier are determined by their values on root generators, even when the
target is only a monoid: uniqueness of inverses handles the inverse step of
subgroup-closure induction.

This is the root-generated Chevalley group construction of Steinberg,
*Lectures on Chevalley Groups*, Theorem 1, using the integral representation
in `F4IntegralChevalleyRepresentation`. The field parameter follows
Aschbacher–Smith, *The Classification of Quasithin Groups*, Remark A.2.4
(`refs/quasithin.pdf`).
-/

open scoped Matrix

@[expose] public section

namespace ReeF4

open Theory.AlgebraicGroup

/-- The matrix algebra on the integral F4 Cartan-plus-root basis. -/
noncomputable abbrev MatrixCarrier (m : ℕ) :=
  Matrix F4Chevalley.BasisIndex F4Chevalley.BasisIndex (CoefficientField m)

noncomputable abbrev MatrixUnits (m : ℕ) := (MatrixCarrier m)ˣ

noncomputable abbrev RootGeneratorIndex (m : ℕ) :=
  F4Chevalley.Root × CoefficientField m

/-- An integral root curve specialized to the finite coefficient field. -/
noncomputable def rootGenerator (m : ℕ) (i : RootGeneratorIndex m) : MatrixUnits m :=
  F4Chevalley.rootCurve i.1 i.2

/-- The concrete split F4 group generated by all root curves. -/
noncomputable def SplitGroup (m : ℕ) : Subgroup (MatrixUnits m) :=
  Subgroup.closure (Set.range (rootGenerator m))

instance (m : ℕ) : Finite (MatrixCarrier m) := by
  dsimp [MatrixCarrier]
  infer_instance

instance (m : ℕ) : Finite (MatrixUnits m) := by
  dsimp [MatrixUnits]
  infer_instance

instance (m : ℕ) : Finite (SplitGroup m) := by
  dsimp [SplitGroup]
  infer_instance

noncomputable instance (m : ℕ) : Fintype (SplitGroup m) := Fintype.ofFinite _

@[simp] theorem rootGenerator_apply (m : ℕ)
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    rootGenerator m (r, t) = F4Chevalley.rootCurve r t := rfl

theorem rootGenerator_mem (m : ℕ) (i : RootGeneratorIndex m) :
    rootGenerator m i ∈ SplitGroup m := by
  exact Subgroup.subset_closure ⟨i, rfl⟩

/-- A root generator viewed as an element of the generated carrier. -/
noncomputable def rootGeneratorInGroup (m : ℕ)
    (r : F4Chevalley.Root) (t : CoefficientField m) : SplitGroup m :=
  ⟨rootGenerator m (r, t), rootGenerator_mem m (r, t)⟩

@[simp] theorem rootGeneratorInGroup_coe (m : ℕ)
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    (rootGeneratorInGroup m r t : MatrixUnits m) = F4Chevalley.rootCurve r t := rfl

theorem splitGroup_eq_closure (m : ℕ) :
    SplitGroup m = Subgroup.closure (Set.range (rootGenerator m)) := rfl

/-- Homomorphisms from the split group agree if they agree on every root curve. -/
theorem splitGroup_hom_ext {m : ℕ} {H : Type*} [Monoid H]
    (f g : SplitGroup m →* H)
    (h : ∀ (r : F4Chevalley.Root) (t : CoefficientField m),
      f (rootGeneratorInGroup m r t) = g (rootGeneratorInGroup m r t)) :
    f = g := by
  apply MonoidHom.ext
  intro x
  exact Subgroup.closure_induction
    (p := fun y hy => f ⟨y, hy⟩ = g ⟨y, hy⟩)
    (fun y hy => by
      rcases hy with ⟨i, rfl⟩
      exact h i.1 i.2)
    (by change f 1 = g 1; simp)
    (fun y z hym hzm hy hz => by
      change f ((⟨y, hym⟩ : SplitGroup m) * ⟨z, hzm⟩) =
        g ((⟨y, hym⟩ : SplitGroup m) * ⟨z, hzm⟩)
      simpa only [map_mul] using congrArg₂ (· * ·) hy hz)
    (fun y hy hfg => by
      let z : SplitGroup m := ⟨y, hy⟩
      change f z⁻¹ = g z⁻¹
      apply left_inv_eq_right_inv (a := f z)
      · rw [← map_mul, inv_mul_cancel, map_one]
      · change f z = g z at hfg
        rw [hfg, ← map_mul, mul_inv_cancel, map_one])
    x.property

end ReeF4
