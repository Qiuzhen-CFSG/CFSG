module
public import Theory.SpecificGroups.ReeF4.ElementaryTwoBound.RootSubgroups
public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.LinearCore.CommutatorGeneration.FixedGenerators

/-!
# Curves and supported coordinates in the Ree root sections

The central curves are additive, and the B₂ product formula puts each one
inside the subgroup generated by its main curve. Positive words are evaluated
in the literal fixed matrix group. The support predicates specify the sections
used in GLS3 Lemma 3.3.9, in the existing positive block order.

Source: GLS3 Table 2.4, 2.4.5(d), 2.4.6 and Lemma 3.3.9,
`refs/KGroup/GLS3/chapter2.tex` and `chapter3.tex`.
-/
@[expose] public section
noncomputable section
namespace ReeF4.ElementaryTwoBound.RootCalculations
open Subgroup Parabolics LargeLocalSeeds
open Parabolics.OuterLocal.SuzukiCommutators.NormalGeneration
open NormalizedRootCentralizers.CenterExponent
open Parabolics.RadicalCoordinates.FixedCoordinates

private theorem root_zero (m : ℕ) (r : Theory.AlgebraicGroup.F4Chevalley.Root) :
    rootGeneratorInGroup m r 0 = 1 :=
  Subtype.ext (Theory.AlgebraicGroup.F4Chevalley.rootCurve_zero r)

@[simp] theorem rootWord_zero (m : ℕ) (i : Fin 8) : rootWord m i 0 = 1 := by
  simp [rootWord, root_zero]

@[simp] theorem centralWord_zero (m : ℕ) (i : Fin 8) : centralWord m i 0 = 1 := by
  simp [centralWord, root_zero]

@[simp] theorem mainElement_zero (m : ℕ) (i : Fin 8) : mainElement m i 0 = 1 :=
  Subtype.ext (rootWord_zero m i)

@[simp] theorem centralElement_zero (m : ℕ) (i : Fin 8) : centralElement m i 0 = 1 :=
  Subtype.ext (centralWord_zero m i)

/-- Additivity for all the paired relative roots. -/
theorem mainElement_add (m : ℕ) (i : Fin 8) (hi : i.val % 2 ≠ 0)
    (a b : CoefficientField m) :
    mainElement m i (a + b) = mainElement m i a * mainElement m i b :=
  Subtype.ext (LinearCommutators.rootWord_odd_add m i hi a b)

/-- Additivity for each central B₂ curve. -/
theorem centralElement_add (m : ℕ) (i : Fin 8) (hi : i.val % 2 = 0)
    (a b : CoefficientField m) :
    centralElement m i (a + b) = centralElement m i a * centralElement m i b := by
  obtain ⟨j, rfl⟩ : ∃ j, positiveRootWordLayout.quartetIndex j = i := by
    rcases positiveRootWordLayout.positive_covers i with ⟨j, hj⟩ | h
    · exact False.elim ((positiveRootWordLayout.pair_odd j) (hj.symm ▸ hi))
    · exact h
  apply Subtype.ext
  change centralWord m _ (a + b) = centralWord m _ a * centralWord m _ b
  have hc := positiveRootWordLayout.quartet_top_commute m (mixedRootCommutation m) j
    b (rootFieldEnd m (longRoot (positiveRootWordLayout.quartetIndex j)) a)
  have root_add (r : Theory.AlgebraicGroup.F4Chevalley.Root) (u v : CoefficientField m) :
      rootGeneratorInGroup m r (u + v) = rootGeneratorInGroup m r u *
        rootGeneratorInGroup m r v :=
    Subtype.ext (Theory.AlgebraicGroup.F4Chevalley.rootCurve_add r u v)
  simp only [centralWord, map_add, root_add]
  exact hc.mul_mul_mul_comm _ _

def pairHom (m : ℕ) (i : Fin 8) (hi : i.val % 2 ≠ 0) :
    Multiplicative (CoefficientField m) →* Model m where
  toFun a := mainElement m i a.toAdd
  map_one' := mainElement_zero m i
  map_mul' a b := mainElement_add m i hi a.toAdd b.toAdd

def centralHom (m : ℕ) (i : Fin 8) (hi : i.val % 2 = 0) :
    Multiplicative (CoefficientField m) →* Model m where
  toFun a := centralElement m i a.toAdd
  map_one' := centralElement_zero m i
  map_mul' a b := centralElement_add m i hi a.toAdd b.toAdd

theorem X_eq_range (m : ℕ) (i : Fin 8) (hi : i.val % 2 ≠ 0) :
    X m i = (pairHom m i hi).range := by
  change closure ((pairHom m i hi).range : Set (Model m)) = _
  exact closure_eq _

theorem Y_eq_range (m : ℕ) (i : Fin 8) (hi : i.val % 2 = 0) :
    Y m i = (centralHom m i hi).range := by
  change closure ((centralHom m i hi).range : Set (Model m)) = _
  exact closure_eq _

theorem mem_X_iff (m : ℕ) (i : Fin 8) (hi : i.val % 2 ≠ 0) (x : Model m) :
    x ∈ X m i ↔ ∃ a, mainElement m i a = x := by
  rw [X_eq_range m i hi]
  rfl

theorem mem_Y_iff (m : ℕ) (i : Fin 8) (hi : i.val % 2 = 0) (x : Model m) :
    x ∈ Y m i ↔ ∃ a, centralElement m i a = x := by
  rw [Y_eq_range m i hi]
  rfl

theorem mainElement_mem_X (m : ℕ) (i : Fin 8) (a : CoefficientField m) :
    mainElement m i a ∈ X m i := subset_closure ⟨a, rfl⟩

theorem centralElement_mem_Y (m : ℕ) (i : Fin 8) (a : CoefficientField m) :
    centralElement m i a ∈ Y m i := subset_closure ⟨a, rfl⟩

/-- The generated main-root subgroup contains the entire central curve.
The B₂ law with first parameter one avoids needing a power-map argument. -/
theorem Y_le_X (m : ℕ) (i : Fin 8) (hi : i.val % 2 = 0) : Y m i ≤ X m i := by
  apply (closure_le _).mpr
  rintro _ ⟨a, rfl⟩
  have he : mainElement m i 1 * mainElement m i a =
      mainElement m i (1 + a) * centralElement m i a := by
    apply Subtype.ext
    change rootWord m i 1 * rootWord m i a = rootWord m i (1 + a) * centralWord m i a
    simpa only [map_one, one_mul] using MatrixRelations.rootWord_even_mul m i hi 1 a
  have hh := (X m i).mul_mem (mainElement_mem_X m i 1) (mainElement_mem_X m i a)
  rw [he] at hh
  exact (mul_mem_cancel_left (mainElement_mem_X m i (1 + a))).mp hh

/-- Evaluate the twelve positive coordinates in the fixed model. -/
def wordElement (m : ℕ) (p : PositiveParameters m) : Model m :=
  (List.ofFn fun j => mainElement m (positiveRootWordLayout.pairIndex j) (p.pair j)).prod *
    (List.ofFn fun j => mainElement m (positiveRootWordLayout.quartetIndex j) (p.main j) *
      centralElement m (positiveRootWordLayout.quartetIndex j) (p.central j)).prod

@[simp] theorem wordElement_coe (m : ℕ) (p : PositiveParameters m) :
    toSplitGroup m (wordElement m p) = positiveWord m p := by
  simp only [wordElement, positiveWord, map_mul, map_list_prod, List.map_ofFn,
    Function.comp_def, mainElement_coe, centralElement_coe]

theorem wordElement_injective (m : ℕ) : Function.Injective (wordElement m) := by
  intro p q h
  exact positiveWord_injective m (by simpa only [wordElement_coe] using congrArg (toSplitGroup m) h)

/-- D has no eighth pair and no first or seventh main coordinate. -/
def DSupport {m : ℕ} (p : PositiveParameters m) : Prop :=
  p.pair 0 = 0 ∧ p.main 0 = 0 ∧ p.main 2 = 0

def D₁Support {m : ℕ} (p : PositiveParameters m) : Prop :=
  DSupport p ∧ p.pair 2 = 0 ∧ p.central 2 = 0

def D₂Support {m : ℕ} (p : PositiveParameters m) : Prop :=
  DSupport p ∧ p.pair 1 = 0 ∧ p.central 0 = 0

def T₁Support {m : ℕ} (p : PositiveParameters m) : Prop :=
  D₁Support p ∧ p.main 1 = 0 ∧ p.main 3 = 0

def T₂Support {m : ℕ} (p : PositiveParameters m) : Prop :=
  D₂Support p ∧ p.main 1 = 0 ∧ p.main 3 = 0

def KSupport {m : ℕ} (p : PositiveParameters m) : Prop :=
  DSupport p ∧ p.central 2 = 0

end ReeF4.ElementaryTwoBound.RootCalculations
