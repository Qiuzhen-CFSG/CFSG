module

public import Theory.SpecificGroups.ReeF4.CentralCovers.TwoPrimary.RootBlocks
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.Geometry.FixedProducts

/-!
# Collecting lifted positive Ree blocks by normalization of later factors

The source order X₁,...,X₈ is the angular order of the relative positive
roots. A block may have a central curve occurring as the commutator of
other blocks, so a single strictly increasing height on whole blocks is
not the appropriate hypothesis. Instead each lifted block must normalize
the subgroup generated by the later blocks in this order.

For such a chain the order of the generated subgroup is at most the product
of the block orders, by repeated normalized-product counting. Every block
section has image of at most its original block order. The actual coordinate
bijection in RootBlocks identifies their product with |U|. Projection of the
lifted join onto U is surjective, and the order bound makes it bijective.
Its inverse gives a section of the literal inclusion U → Model m.

BlockSections supplies individual group homomorphisms, including the full
nonabelian B₂ multiplication laws. TorusEquivariant specifies conjugation
by the actual fixed coroot torus, using any lift of an actor. NormalizesTails
is a separate obligation on relations in the extension itself. Neither
existence of sections nor these lifted relations is asserted here.

Source: GLS3 §2.4, Table 2.4 and the commutator formula 2.4.5(d), in
`refs/KGroup/GLS3/chapter2.tex`; GLS3 §6.1 and Aschbacher–Smith I.1.3,
printed p.407, for the covering application.
-/

@[expose] public section
noncomputable section
namespace ReeF4.CentralCovers.TwoPrimary
open ElementaryTwoBound Subgroup
open NormalizedRootCentralizers.CenterExponent

/-- Position of each source-numbered root in the existing coordinate layout. -/
def sourceIndex : Fin 8 → BlockIndex :=
  ![.inr 0, .inl 1, .inr 3, .inl 3, .inr 1, .inl 2, .inr 2, .inl 0]

/-- The source convex order, rather than the split-coordinate layout order. -/
def sourceOrder : List BlockIndex := List.ofFn sourceIndex

theorem sourceIndex_rootIndex (i : BlockIndex) : sourceIndex (rootIndex i) = i := by
  cases i with
  | inl j =>
      fin_cases j <;> simp only [rootIndex, positive_pair_indices] <;> rfl
  | inr j =>
      fin_cases j <;> simp only [rootIndex, positive_quartet_indices] <;> rfl

theorem rootIndex_sourceIndex (i : Fin 8) : rootIndex (sourceIndex i) = i := by
  fin_cases i <;> simp [sourceIndex, rootIndex, positive_pair_indices, positive_quartet_indices]

def rootIndexEquiv : BlockIndex ≃ Fin 8 where
  toFun := rootIndex
  invFun := sourceIndex
  left_inv := sourceIndex_rootIndex
  right_inv := rootIndex_sourceIndex

theorem mem_sourceOrder (i : BlockIndex) : i ∈ sourceOrder :=
  List.mem_ofFn.mpr ⟨rootIndex i, sourceIndex_rootIndex i⟩

def blockOrder : List BlockIndex :=
  (List.ofFn fun i : Fin 4 => Sum.inl i) ++ (List.ofFn fun i : Fin 4 => Sum.inr i)

theorem blockOrder_nodup : blockOrder.Nodup := by decide

theorem mem_blockOrder (i : BlockIndex) : i ∈ blockOrder := by
  cases i with
  | inl j => exact List.mem_append_left _ (List.mem_ofFn.mpr ⟨j,rfl⟩)
  | inr j => exact List.mem_append_right _ (List.mem_ofFn.mpr ⟨j,rfl⟩)

variable (m : ℕ) {E : Type*} [Group E]

/-- Homomorphic lifts of the eight actual generated root subgroups. -/
structure BlockSections (f : E →* Model m) where
  lift : ∀ i : BlockIndex, X m (rootIndex i) →* E
  project : ∀ i x, f (lift i x) = x.val

namespace BlockSections
variable {m} {f : E →* Model m}

/-- Compatibility with the literal fixed torus, independent of actor lift choices. -/
def TorusEquivariant (L : BlockSections m f) : Prop :=
  ∀ (i : BlockIndex) (a b : X m (rootIndex i)) (g : E),
    f g ∈ Parabolics.fixedTorus m →
    f g * a.val * (f g)⁻¹ = b.val →
    g * L.lift i a * g⁻¹ = L.lift i b

def product (L : BlockSections m f) (a : Blocks m) : E :=
  (blockOrder.map fun i => L.lift i (a i)).prod

theorem product_one (L : BlockSections m f) : L.product 1 = 1 := by
  simp [product]

theorem project_product (L : BlockSections m f) (a : Blocks m) :
    f (L.product a) = blockProduct m a := by
  simp only [product, map_list_prod, List.map_map, Function.comp_def, L.project]
  simp only [blockOrder, List.map_append, List.map_ofFn, List.prod_append, blockProduct]
  rfl

def orderedJoin (L : BlockSections m f) (order : List BlockIndex) : Subgroup E :=
  order.foldr (fun i H => (L.lift i).range ⊔ H) ⊥

/-- Relative normalization of each later join; no ambient normality is assumed. -/
def NormalizesTails (L : BlockSections m f) : Prop :=
  ∀ (before : List BlockIndex) (i : BlockIndex) (after : List BlockIndex),
    sourceOrder = before ++ i :: after →
    (L.lift i).range ≤ normalizer (L.orderedJoin after : Set E)

private theorem card_orderedJoin_le [Finite E] (L : BlockSections m f)
    (order : List BlockIndex)
    (hn : ∀ before i after, order = before ++ i :: after →
      (L.lift i).range ≤ normalizer (L.orderedJoin after : Set E)) :
    Nat.card (L.orderedJoin order) ≤ (order.map fun i => Nat.card (L.lift i).range).prod := by
  induction order with
  | nil => simp [orderedJoin]
  | cons i rest ih =>
    have hnorm := hn [] i rest rfl
    have hrest := ih (by
      intro before j after he
      apply hn (i :: before) j after
      simp only [List.cons_append, he])
    have hc := card_mul_eq_card_inf_mul_card_sup_of_normalizes
      (L.orderedJoin rest) (L.lift i).range hnorm
    have hpos : 0 < Nat.card (L.orderedJoin rest ⊓ (L.lift i).range : Subgroup E) :=
      Nat.card_pos
    change Nat.card ((L.lift i).range ⊔ L.orderedJoin rest : Subgroup E) ≤
      Nat.card (L.lift i).range * (rest.map fun j => Nat.card (L.lift j).range).prod
    rw [sup_comm]
    calc
      _ ≤ Nat.card (L.orderedJoin rest ⊓ (L.lift i).range : Subgroup E) *
          Nat.card (L.orderedJoin rest ⊔ (L.lift i).range : Subgroup E) :=
        Nat.le_mul_of_pos_left _ hpos
      _ = Nat.card (L.orderedJoin rest) * Nat.card (L.lift i).range := hc.symm
      _ ≤ (rest.map fun j => Nat.card (L.lift j).range).prod * Nat.card (L.lift i).range :=
        Nat.mul_le_mul_right _ hrest
      _ = _ := Nat.mul_comm _ _

/-- Normalized block relations prevent the generated lift subgroup from gaining order. -/
theorem card_join_le [Finite E] (L : BlockSections m f) (hn : L.NormalizesTails) :
    Nat.card (L.orderedJoin sourceOrder) ≤ Nat.card (Parabolics.unipotent m) := by
  calc
    _ ≤ (sourceOrder.map fun i => Nat.card (L.lift i).range).prod :=
      L.card_orderedJoin_le sourceOrder hn
    _ ≤ (sourceOrder.map fun i => Nat.card (X m (rootIndex i))).prod := by
      apply List.prod_le_prod'
      intro i _
      exact Nat.card_le_card_of_surjective (L.lift i).rangeRestrict
        (L.lift i).rangeRestrict_surjective
    _ = Nat.card (Blocks m) := by
      simp only [sourceOrder, List.map_ofFn, List.prod_ofFn, Nat.card_pi]
      exact rootIndexEquiv.symm.prod_comp (fun i => Nat.card (X m (rootIndex i)))
    _ = Nat.card (Parabolics.unipotent m) := Nat.card_congr (positiveEquiv m)

private theorem range_le_orderedJoin (L : BlockSections m f)
    (order : List BlockIndex) (i : BlockIndex) (hi : i ∈ order) :
    (L.lift i).range ≤ L.orderedJoin order := by
  induction order with
  | nil => simp at hi
  | cons j rest ih =>
    rcases List.mem_cons.mp hi with rfl | hi
    · exact le_sup_left
    · exact (ih hi).trans le_sup_right

private theorem orderedJoin_le_comap (L : BlockSections m f) (order : List BlockIndex) :
    L.orderedJoin order ≤ (Parabolics.unipotent m).comap f := by
  induction order with
  | nil => exact bot_le
  | cons i rest ih =>
    apply sup_le _ ih
    rintro _ ⟨x,rfl⟩
    change f (L.lift i x) ∈ Parabolics.unipotent m
    rw [L.project]
    exact X_le_unipotent m _ x.property

private theorem product_mem_join (L : BlockSections m f) (a : Blocks m) :
    L.product a ∈ L.orderedJoin sourceOrder := by
  apply list_prod_mem
  intro x hx
  obtain ⟨i,_,rfl⟩ := List.mem_map.mp hx
  exact L.range_le_orderedJoin sourceOrder i (mem_sourceOrder i) ⟨a i,rfl⟩

/-- The original central-extension map restricted to the actual lifted join. -/
def projection (L : BlockSections m f) :
    L.orderedJoin sourceOrder →* Parabolics.unipotent m :=
  (f.comp (L.orderedJoin sourceOrder).subtype).codRestrict (Parabolics.unipotent m)
    (by
      intro x
      exact L.orderedJoin_le_comap sourceOrder x.property)

theorem projection_surjective (L : BlockSections m f) : Function.Surjective L.projection := by
  intro x
  obtain ⟨a,ha⟩ := blockProduct_surjective m x
  refine ⟨⟨L.product a,L.product_mem_join a⟩, ?_⟩
  apply Subtype.ext
  exact (L.project_product a).trans ha

/-- The lifted relations give a section of the original marked positive subgroup. -/
theorem exists_unipotent_section [Finite E] (L : BlockSections m f) (hn : L.NormalizesTails) :
    ∃ s : Parabolics.unipotent m →* E,
      f.comp s = (Parabolics.unipotent m).subtype := by
  let e := MulEquiv.ofBijective L.projection
    (L.projection_surjective.bijective_of_nat_card_le (L.card_join_le hn))
  refine ⟨(L.orderedJoin sourceOrder).subtype.comp e.symm.toMonoidHom, ?_⟩
  apply MonoidHom.ext
  intro x
  exact congrArg Subtype.val (e.apply_symm_apply x)

end BlockSections
end ReeF4.CentralCovers.TwoPrimary

