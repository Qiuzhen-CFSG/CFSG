module
public import Theory.SpecificGroups.ReeF4.CentralCovers.TwoPrimary.TailRelations.BaseIntervals.CurveRelations

/-!
# Normalization of the actual angular tails in the Ree group

The concrete curve commutators lie in the intervening root blocks. For each
main-curve generator of Xᵢ, these identities show that inverse conjugation
preserves the subgroup generated by every later curve. Finiteness turns this
inclusion into equality. Taking the closure of the earlier main curve then
retains the whole, possibly nonabelian, B₂ block as normalizing actor.

The source-order argument identifies precisely the literal foldr join used by
`BlockSections.normalizesTails_of_base_and_torus` in `TailRelations`. No central
cover, choice of lifted blocks, or torus-separation premise is used here.
The calculation holds also at m = 0.

Source: GLS3, 2.4.5(d) and Corollary 2.4.6,
`refs/KGroup/GLS3/chapter2.tex`; Aschbacher–Smith I.1.3, printed p.407.
-/
public section
noncomputable section
namespace ReeF4.CentralCovers.TwoPrimary.TailRelations.BaseIntervals
open Subgroup
private theorem normalizes_of_right_commutators {G : Type*} [Group G] [Finite G]
    (S : Set G) (a : G)
    (h : ∀ b ∈ S, a⁻¹ * b⁻¹ * a * b ∈ closure S) :
    a ∈ normalizer (closure S : Set G) := by
  have hc : closure S ≤ (closure S).comap (MulAut.conj a⁻¹).toMonoidHom := by
    apply (closure_le _).mpr
    intro b hb
    change a⁻¹ * b * (a⁻¹)⁻¹ ∈ closure S
    have he : a⁻¹ * b * (a⁻¹)⁻¹ = b * (a⁻¹ * b⁻¹ * a * b)⁻¹ := by group
    rw [he]
    exact mul_mem (subset_closure hb) (inv_mem (h b hb))
  let f : closure S → closure S := fun b => ⟨_, hc b.property⟩
  have hf : Function.Injective f := by
    intro b c he
    apply Subtype.ext
    exact (MulAut.conj a⁻¹).injective (congrArg Subtype.val he)
  have hs := Finite.surjective_of_injective hf
  apply inv_mem_iff.mp
  apply mem_normalizer_iff.mpr
  intro b
  constructor
  · exact fun hb => hc hb
  · intro hb
    obtain ⟨c, he⟩ := hs ⟨_, hb⟩
    have he' : c.val = b := (MulAut.conj a⁻¹).injective (congrArg Subtype.val he)
    exact he' ▸ c.property
open ElementaryTwoBound NormalizedRootCentralizers.CenterExponent
open ElementaryTwoBound.RootCalculations

private theorem sourceOrder_pairwise :
    sourceOrder.Pairwise (fun i j => rootIndex i < rootIndex j) := by
  apply List.pairwise_ofFn.mpr
  intro i j hij
  simpa only [rootIndex_sourceIndex] using hij

private theorem mem_after_of_lt {before after : List BlockIndex} {i : BlockIndex}
    (he : sourceOrder = before ++ i :: after) (k : Fin 8) (hk : rootIndex i < k) :
    sourceIndex k ∈ after := by
  have hp := sourceOrder_pairwise
  rw [he, List.pairwise_append] at hp
  have hm := mem_sourceOrder (sourceIndex k)
  rw [he, List.mem_append, List.mem_cons] at hm
  rcases hm with h | h | h
  · have hki := hp.2.2 _ h i (List.mem_cons_self ..)
    rw [rootIndex_sourceIndex] at hki
    exact False.elim ((lt_asymm hk hki))
  · have hki := congrArg rootIndex h
    rw [rootIndex_sourceIndex] at hki
    exact False.elim ((ne_of_lt hk) hki.symm)
  · exact h

private theorem root_le_join (m : ℕ) (order : List BlockIndex) (i : BlockIndex)
    (hi : i ∈ order) : X m (rootIndex i) ≤ baseOrderedJoin m order := by
  induction order with
  | nil => simp at hi
  | cons j rest ih =>
    rcases List.mem_cons.mp hi with rfl | hi
    · exact le_sup_left
    · exact (ih hi).trans le_sup_right

private def tailGenerators (m : ℕ) (order : List BlockIndex) : Set (Model m) :=
  {x | ∃ j ∈ order, ∃ t, mainElement m (rootIndex j) t = x}

private theorem join_eq_closure (m : ℕ) (order : List BlockIndex) :
    baseOrderedJoin m order = closure (tailGenerators m order) := by
  apply le_antisymm
  · have hgen (i : BlockIndex) (hi : i ∈ order) :
        X m (rootIndex i) ≤ closure (tailGenerators m order) := by
      apply (closure_le _).mpr
      rintro _ ⟨t, rfl⟩
      exact subset_closure ⟨i, hi, t, rfl⟩
    have aux (l : List BlockIndex) :
        (∀ i ∈ l, X m (rootIndex i) ≤ closure (tailGenerators m order)) →
        baseOrderedJoin m l ≤ closure (tailGenerators m order) := by
      induction l with
      | nil => exact fun _ => bot_le
      | cons j rest ih =>
        intro h
        exact sup_le (h j (List.mem_cons_self ..))
          (ih (fun i hi => h i (List.mem_cons_of_mem _ hi)))
    exact aux order hgen
  · apply (closure_le _).mpr
    rintro _ ⟨j, hj, t, rfl⟩
    exact root_le_join m order j hj (mainElement_mem_X m _ t)

/-- The source generator-interval law suffices for normalization of whole tails. -/
theorem baseNormalizesTails_of_intervals (m : ℕ)
    (hinterval : ∀ (i j : Fin 8), i < j → ∀ H : Subgroup (Model m),
      (∀ k : Fin 8, i < k → k < j → X m k ≤ H) →
      ∀ t u : CoefficientField m,
      (mainElement m i t)⁻¹ * (mainElement m j u)⁻¹ *
        mainElement m i t * mainElement m j u ∈ H) : BaseNormalizesTails m := by
  intro before i after he
  apply (closure_le _).mpr
  rintro _ ⟨t, rfl⟩
  rw [join_eq_closure]
  apply normalizes_of_right_commutators
  rintro _ ⟨j, hj, u, rfl⟩
  rw [← join_eq_closure]
  have hp := sourceOrder_pairwise
  rw [he, List.pairwise_append] at hp
  have hij := (List.pairwise_cons.mp hp.2.1).1 j hj
  apply hinterval _ _ hij
  intro k hk _
  have hm := mem_after_of_lt he k hk
  have hh := root_le_join m after (sourceIndex k) hm
  simpa only [rootIndex_sourceIndex] using hh

/-- Every earlier whole root block normalizes its actual later angular tail. -/
theorem baseNormalizesTails (m : ℕ) : BaseNormalizesTails m :=
  baseNormalizesTails_of_intervals m (main_commutator_mem m)

end ReeF4.CentralCovers.TwoPrimary.TailRelations.BaseIntervals
