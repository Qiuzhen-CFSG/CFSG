module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.Basic
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.SplitGeneration
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.PositiveFactors
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.WeylWords
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.WeylGeometry
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration

/-!
# Fixed collection for the Ree simple blocks

Every fixed positive element is a product of elements in the eight complete
relative root blocks. The checked Weyl orbits carry these blocks, including
every root of each B₂ quartet, to the two positive simple blocks. Conjugation
by fixed Weyl representatives descends to the actual fixed intersections.
Since both representatives lie in their signed fixed blocks, the four signed
simple blocks generate a subgroup containing the positive unipotent subgroup.

Each fixed seed is generated by its positive subgroup and its relative Weyl
representative, using the unique fixed Levi–radical factorization. The signed
Weyl expression therefore puts that seed in the join of the positive subgroup
and its negative simple block. This requires only `1 ≤ m`; positive collection
holds for every `m`. Neither inclusion needs simplicity, perfectness or odd
index, and neither uses preservation of joins by fixed points.

Source: GLS3, 2.3.6–8 and §2.4, `refs/KGroup/GLS3/chapter2.tex`.
-/

public section
noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.FixedCollection

open Subgroup LargeLocalSeeds
variable {m : ℕ}

/-- Conjugation by a fixed element transports fixed intersections. The
split inclusion is sufficient because its conjugating element is fixed. -/
theorem positiveBlock_le_of_split_conjugate (d : LocalBlockInput m)
    (K : Subgroup d.fixedGroup) (i : PositiveBlockIndex) (s : Side)
    (n : d.fixedGroup) (hn : n ∈ K) (hs : simpleBlock d s true ≤ K)
    (hconj : splitPositiveBlock m i ≤
      (splitSimpleBlock m s true).map (MulAut.conj n.val).toMonoidHom) :
    positiveBlock d i ≤ K := by
  intro x hx
  obtain ⟨y, hy, he⟩ := hconj hx
  change n.val * y * n.val⁻¹ = x.val at he
  let z : d.fixedGroup := n⁻¹ * x * n
  have hz : z.val = y := by
    change n.val⁻¹ * x.val * n.val = y
    rw [← he]
    group
  have hzmem : z ∈ simpleBlock d s true := by
    change z.val ∈ splitSimpleBlock m s true
    rwa [hz]
  have hprod : n * z * n⁻¹ ∈ K := mul_mem (mul_mem hn (hs hzmem)) (inv_mem hn)
  have heq : n * z * n⁻¹ = x := by dsimp [z]; group
  rwa [heq] at hprod

/-- Relative Weyl orbit calculations reduce positive collection to the two
rank-one expressions for the specified fixed Weyl representatives. -/
theorem positive_collection_of_weyl_orbits (d : LocalBlockInput m)
    (hweyl : ∀ s, relativeWeyl d s ∈ simpleBlock d s true ⊔ simpleBlock d s false)
    (horbit : ∀ i : PositiveBlockIndex, ∃ s, ∃ n : d.fixedGroup,
      n ∈ relativeWeylSubgroup d ∧ splitPositiveBlock m i ≤
        (splitSimpleBlock m s true).map (MulAut.conj n.val).toMonoidHom) :
    standardUnipotent d ≤ ⨆ s, ⨆ positive, simpleBlock d s positive := by
  let K := ⨆ s, ⨆ positive, simpleBlock d s positive
  have hs (s : Side) (positive : Bool) : simpleBlock d s positive ≤ K :=
    le_iSup_of_le s (le_iSup (fun positive => simpleBlock d s positive) positive)
  have hW : relativeWeylSubgroup d ≤ K :=
    relativeWeylSubgroup_le d K (fun s => (sup_le (hs s true) (hs s false)) (hweyl s))
  rw [standardUnipotent_eq_iSup_positiveBlock]
  apply iSup_le
  intro i
  obtain ⟨s, n, hn, hconj⟩ := horbit i
  exact positiveBlock_le_of_split_conjugate d K i s n (hW hn) (hs s true) hconj

/-- Once each fixed seed is generated by its positive subgroup and its
relative Weyl representative, the rank-one word gives fixed seed collection. -/
theorem seed_collection_of_weyl_generation (d : LocalBlockInput m)
    (hweyl : ∀ s, relativeWeyl d s ∈ simpleBlock d s true ⊔ simpleBlock d s false)
    (hseed : ∀ s, standardSeed d s ≤ standardUnipotent d ⊔ zpowers (relativeWeyl d s)) :
    ∀ s, standardSeed d s ≤ standardUnipotent d ⊔ simpleBlock d s false := by
  intro s
  apply (hseed s).trans
  apply sup_le le_sup_left
  apply zpowers_le.mpr
  exact (sup_le_sup_right (simpleBlock_positive_le d s) _) (hweyl s)

/-- Each actual fixed seed lies in the join of the positive fixed subgroup
and its negative simple block. Fixed Levi generation supplies the Weyl word,
whose signed fixed-block expression supplies the negative block. -/
theorem standardSeed_le_unipotent_sup_negativeBlock (hm : 1 ≤ m)
    (d : LocalBlockInput m) (s : Side) :
    standardSeed d s ≤ standardUnipotent d ⊔ simpleBlock d s false :=
  seed_collection_of_weyl_generation d (relativeWeyl_mem_simpleBlock_sup d)
    (SeedGeneration.standardSeed_le_unipotent_sup_zpowers hm d) s

/-- The four signed simple fixed blocks contain the whole positive fixed
subgroup. Collection uses all eight complete relative root blocks and their
conjugates under the specified fixed Weyl representatives. -/
theorem standardUnipotent_le_iSup_simpleBlock (d : LocalBlockInput m) :
    standardUnipotent d ≤ ⨆ s, ⨆ positive, simpleBlock d s positive :=
  positive_collection_of_weyl_orbits d (relativeWeyl_mem_simpleBlock_sup d)
    (positiveBlock_weyl_orbit d)

end ReeF4.LocalBlockInput.PairRigidity.FixedCollection
