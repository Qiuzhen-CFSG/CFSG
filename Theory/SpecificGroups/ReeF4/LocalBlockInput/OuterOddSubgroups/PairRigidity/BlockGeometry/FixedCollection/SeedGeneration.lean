module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.WeylWords
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.Normality
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.Separation
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.LinearLeviGeneration
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.SuzukiLeviGeneration

/-!
# Fixed Levi–radical factorization and generation of the Ree seeds

The original split seed is generated by the full signed subsystem Levi and
its specified positive radical. Relative normality gives a product expression;
matrix grading makes it unique. Both factors are twist-stable, so uniqueness
forces them to be fixed separately whenever their product is fixed. Thus each
actual fixed seed is the product of its actual fixed Levi and fixed radical.
All of these factorization statements hold for every coefficient field.

The two rank-one calculations generate each fixed Levi by its positive block
and its specified relative Weyl word: `[0,3]` on the linear side and
`[1,2,1,2]` on the Suzuki side. Since the radical lies in the positive
unipotent subgroup, this gives the requested seed inclusion for `1 ≤ m`,
without simplicity, perfectness or odd-index hypotheses. No claim that fixed
points preserve arbitrary subgroup joins is used, and the full Levi torus
is retained.

Source: GLS3, 2.3.4–8 and §2.4, `refs/KGroup/GLS3/chapter2.tex`, for the
local construction underlying Aschbacher–Smith F.1.12, printed pp.263–264.
-/

public section
noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
open Subgroup LargeLocalSeeds
variable {m : ℕ}

/-- Relative normality turns split generation into an actual product decomposition. -/
theorem exists_split_levi_radical_factors (m : ℕ) (s : Side)
    (x : SplitGroup m) (hx : x ∈ splitSeed m s) :
    ∃ l ∈ splitLevi m s, ∃ r ∈ splitRadical m s, l * r = x := by
  let L := (splitLevi m s).subgroupOf (splitSeed m s)
  let R := radicalInSplitSeed m s
  let : R.Normal := radicalInSplitSeed_normal m s
  have hR : splitRadical m s ≤ splitSeed m s :=
    (splitRadical_le_unipotent m s).trans (splitUnipotent_le_splitSeed m s)
  have hsup : L ⊔ R = ⊤ := by
    dsimp only [L, R, radicalInSplitSeed]
    rw [← subgroupOf_sup (splitLevi_le_seed m s) hR,
      ← splitSeed_eq_levi_sup_radical, subgroupOf_self]
  have hx' : (⟨x, hx⟩ : splitSeed m s) ∈ L ⊔ R := by
    rw [hsup]
    trivial
  obtain ⟨l, hl, r, hr, he⟩ := mem_sup_of_normal_right.mp hx'
  exact ⟨l.val, hl, r.val, hr, congrArg Subtype.val he⟩

/-- Uniqueness and twist stability force both factors of a fixed seed element
to be fixed separately. This is fixed factorization, not descent of a join. -/
theorem exists_fixed_levi_radical_factors (d : LocalBlockInput m) (s : Side)
    (x : d.fixedGroup) (hx : x ∈ standardSeed d s) :
    ∃ l ∈ fixedLevi d s, ∃ r ∈ standardRadical d s, l * r = x := by
  obtain ⟨l, hl, r, hr, he⟩ := exists_split_levi_radical_factors m s x.val hx
  have hl' : d.twist l ∈ splitLevi m s :=
    (splitLevi_twist d s).le (mem_map_of_mem _ hl)
  have hr' : d.twist r ∈ splitRadical m s :=
    (splitRadical_twist d s).le (mem_map_of_mem _ hr)
  have hproduct : d.twist l * d.twist r = l * r := by
    rw [← map_mul, he]
    exact x.property
  have hp := Subgroup.mul_injective_of_disjoint (splitLevi_disjoint_splitRadical m s)
    (a₁ := (⟨d.twist l, hl'⟩, ⟨d.twist r, hr'⟩))
    (a₂ := (⟨l, hl⟩, ⟨r, hr⟩)) hproduct
  have hlf : d.twist l = l := congrArg (fun z => z.1.val) hp
  have hrf : d.twist r = r := congrArg (fun z => z.2.val) hp
  exact ⟨⟨l, hlf⟩, hl, ⟨r, hrf⟩, hr, Subtype.ext he⟩

/-- The fixed seed is generated by its actual fixed Levi and fixed radical. -/
theorem standardSeed_eq_fixedLevi_sup_radical (d : LocalBlockInput m) (s : Side) :
    standardSeed d s = fixedLevi d s ⊔ standardRadical d s := by
  apply le_antisymm
  · intro x hx
    obtain ⟨l, hl, r, hr, rfl⟩ := exists_fixed_levi_radical_factors d s x hx
    exact mul_mem_sup hl hr
  · exact sup_le (fixedLevi_le_seed d s) (standardRadical_le_seed d s)

/-- Fixed rank-one Levi generation suffices for the requested seed inclusion.
The two subsystem calculations discharge its premise in the theorem below. -/
theorem standardSeed_le_unipotent_sup_zpowers_of_fixedLevi
    (d : LocalBlockInput m) (s : Side)
    (hL : fixedLevi d s ≤ simpleBlock d s true ⊔ zpowers (relativeWeyl d s)) :
    standardSeed d s ≤ standardUnipotent d ⊔ zpowers (relativeWeyl d s) := by
  rw [standardSeed_eq_fixedLevi_sup_radical]
  exact sup_le (hL.trans (sup_le_sup_right (simpleBlock_positive_le d s) _))
    ((standardRadical_le_unipotent d s).trans le_sup_left)

/-- Each actual fixed seed is generated by the positive fixed subgroup and
its prescribed relative Weyl word. The full fixed Levi, including its torus,
is supplied by the two rank-one calculations. -/
theorem standardSeed_le_unipotent_sup_zpowers (hm : 1 ≤ m)
    (d : LocalBlockInput m) (s : Side) :
    standardSeed d s ≤ standardUnipotent d ⊔ zpowers (relativeWeyl d s) := by
  apply standardSeed_le_unipotent_sup_zpowers_of_fixedLevi
  cases s with
  | suzuki => exact suzuki_fixedLevi_le d
  | linear => exact fixedLevi_linear_le hm d

end ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
