module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.Basic
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.SplitGeneration
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.RadicalOrders.FixedCoordinates
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.RadicalOrders.SplitCoordinates
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.RadicalOrders.SplitCoordinates.MatrixExchanges
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.RadicalOrders.SplitCoordinates.CartanEntries

/-!+# Collection into the eight positive fixed Ree root blocks

The concrete positive F₄ root partition consists of four orthogonal pairs
and four B₂ quartets. Adjacent matrix exchanges and triangular Cartan entries
give unique ordered split coordinates. The twist preserves each block, so
uniqueness forces every factor of a fixed product to be fixed separately.
This proves collection in the actual fixed intersections, without assuming
that taking fixed points preserves subgroup joins.

Source: GLS3, 2.3.6–7 and Table 2.4, types V and VI, in
`refs/KGroup/GLS3/chapter2.tex`. This is the positive-factor step; generation
by the four signed simple blocks requires additional relative Weyl geometry.
-/

@[expose] public section
noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.FixedCollection

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem Subgroup
open LargeLocalSeeds Parabolics.RadicalCoordinates
open Parabolics.RadicalCoordinates.FixedCoordinates
variable {m : ℕ}

/-- Four commuting pairs and four B₂ quartets, in the checked root-table order. -/
abbrev PositiveBlockIndex := Fin 4 ⊕ Fin 4

/-- The complete root set of a positive relative root block. -/
def positiveBlockRoots : PositiveBlockIndex → Set F4Chevalley.Root
  | .inl i => Set.range (fun j : Fin 2 => ((rootBlocks .positive).roots (.inl (i, j))).val)
  | .inr i => Set.range (fun j : Fin 4 => ((rootBlocks .positive).roots (.inr (i, j))).val)

/-- The subgroup of the split matrix carrier generated by one complete block. -/
def splitPositiveBlock (m : ℕ) (i : PositiveBlockIndex) : Subgroup (SplitGroup m) :=
  closure {x | ∃ (r : F4Chevalley.Root) (t : CoefficientField m),
    r ∈ positiveBlockRoots i ∧ x = rootGeneratorInGroup m r t}

/-- The actual twist-fixed intersection of a positive relative root block. -/
def positiveBlock (d : LocalBlockInput m) (i : PositiveBlockIndex) :
    Subgroup d.fixedGroup := (splitPositiveBlock m i).subgroupOf d.fixedGroup

theorem positiveBlockRoots_isPos (i : PositiveBlockIndex) {r : F4Chevalley.Root}
    (hr : r ∈ positiveBlockRoots i) : typeF4RootPairing_base.IsPos r := by
  cases i <;> obtain ⟨j, rfl⟩ := hr <;> exact ((rootBlocks .positive).roots _).property

theorem splitPositiveBlock_le_unipotent (m : ℕ) (i : PositiveBlockIndex) :
    splitPositiveBlock m i ≤ splitUnipotent m := by
  apply Subgroup.closure_mono
  rintro x ⟨r, t, hr, rfl⟩
  exact ⟨r, t, positiveBlockRoots_isPos i hr, rfl⟩

theorem positiveBlock_le_unipotent (d : LocalBlockInput m) (i : PositiveBlockIndex) :
    positiveBlock d i ≤ standardUnipotent d :=
  fun _ hx => splitPositiveBlock_le_unipotent m i hx

/-- The exceptional root permutation preserves each complete positive block. -/
theorem positiveBlockRoots_duality (i : PositiveBlockIndex) {r : F4Chevalley.Root}
    (hr : r ∈ positiveBlockRoots i) :
    exceptionalRootPermutation r ∈ positiveBlockRoots i := by
  let B := rootBlocks .positive
  have hback {r s : F4Chevalley.Root} (h : exceptionalRootPermutation r = s) :
      exceptionalRootPermutation s = r := by
    rw [← h, exceptionalRootPermutation_involutive]
  cases i with
  | inl i =>
    obtain ⟨j, rfl⟩ := hr
    fin_cases j
    · exact ⟨1, (B.pair_dual i).symm⟩
    · exact ⟨0, (hback (B.pair_dual i)).symm⟩
  | inr i =>
    obtain ⟨j, rfl⟩ := hr
    fin_cases j
    · exact ⟨1, (B.quartet_dual_zero i).symm⟩
    · exact ⟨0, (hback (B.quartet_dual_zero i)).symm⟩
    · exact ⟨3, (B.quartet_dual_two i).symm⟩
    · exact ⟨2, (hback (B.quartet_dual_two i)).symm⟩

theorem splitPositiveBlock_twist (d : LocalBlockInput m) (i : PositiveBlockIndex) :
    (splitPositiveBlock m i).map d.twist.toMonoidHom = splitPositiveBlock m i := by
  have hle : (splitPositiveBlock m i).map d.twist.toMonoidHom ≤ splitPositiveBlock m i := by
    rw [map_le_iff_le_comap]
    apply (closure_le _).mpr
    rintro x ⟨r, t, hr, rfl⟩
    change d.twist (rootGeneratorInGroup m r t) ∈ splitPositiveBlock m i
    rw [d.twist_root]
    exact subset_closure ⟨_, _, positiveBlockRoots_duality i hr, rfl⟩
  apply le_antisymm hle
  intro x hx
  refine ⟨d.twist x, hle (mem_map_of_mem _ hx), ?_⟩
  exact DFunLike.congr_fun d.twist_sq x

/-- The simple end-node block is the first pair; the simple middle-node block
is the first complete B₂ quartet. -/
def simplePositiveIndex : Side → PositiveBlockIndex
  | .linear => .inl 0
  | .suzuki => .inr 0

private theorem roots_val_eq_iff (a b : Slot .positive) :
    ((rootBlocks .positive).roots a).val = ((rootBlocks .positive).roots b).val ↔ a = b := by
  constructor
  · intro h
    exact (rootBlocks .positive).roots.injective (Subtype.ext h)
  · rintro rfl
    rfl

private theorem support_linear_iff (r : F4Chevalley.Root) :
    (∀ i, i ∉ leviNodes .linear → typeF4SimpleCoefficient r.val i = 0) ↔
      typeF4SimpleCoefficient r.val 1 = 0 ∧ typeF4SimpleCoefficient r.val 2 = 0 := by
  constructor
  · intro h
    exact ⟨h 1 (by simp [leviNodes, Fin.ext_iff]), h 2 (by simp [leviNodes, Fin.ext_iff])⟩
  · rintro ⟨h1, h2⟩ i hi
    fin_cases i
    · exact False.elim (hi (by simp [leviNodes]))
    · exact h1
    · exact h2
    · exact False.elim (hi (by simp [leviNodes]))

private theorem support_suzuki_iff (r : F4Chevalley.Root) :
    (∀ i, i ∉ leviNodes .suzuki → typeF4SimpleCoefficient r.val i = 0) ↔
      typeF4SimpleCoefficient r.val 0 = 0 ∧ typeF4SimpleCoefficient r.val 3 = 0 := by
  constructor
  · intro h
    exact ⟨h 0 (by simp [leviNodes, Fin.ext_iff]), h 3 (by simp [leviNodes, Fin.ext_iff])⟩
  · rintro ⟨h0, h3⟩ i hi
    fin_cases i
    · exact h0
    · exact False.elim (hi (by simp [leviNodes]))
    · exact False.elim (hi (by simp [leviNodes]))
    · exact h3

/-- The table definition agrees with the support definition of the two
positive simple blocks, including the nonsimple B₂ roots. -/
theorem positiveBlockRoots_simple_iff (s : Side) (r : F4Chevalley.Root) :
    r ∈ positiveBlockRoots (simplePositiveIndex s) ↔ IsSimpleBlockRoot s true r := by
  let : DecidableEq (Slot .positive) :=
    inferInstanceAs (DecidableEq ((Fin 4 × Fin 2) ⊕ (Fin 4 × Fin 4)))
  by_cases hp : typeF4RootPairing_base.IsPos r
  · obtain ⟨a, ha⟩ := (rootBlocks .positive).roots.surjective ⟨r, hp⟩
    have he : ((rootBlocks .positive).roots a).val = r := congrArg Subtype.val ha
    rw [← he]
    have hpos : typeF4RootPairing_base.IsPos ((rootBlocks .positive).roots a).val :=
      ((rootBlocks .positive).roots a).property
    simp only [IsSimpleBlockRoot, ↓reduceIte, hpos, and_true]
    cases s
    all_goals
      first | rw [support_suzuki_iff] | rw [support_linear_iff]
      simp only [rootBlocks_roots_val]
      cases a with
      | inl a =>
        rcases a with ⟨i, j⟩
        simp only [simplePositiveIndex, positiveBlockRoots, Set.mem_range, roots_val_eq_iff]
        dsimp only [Slot, pairCount, quartetCount]
        fin_cases i <;> fin_cases j <;>
          norm_num [RootPartition.index, RootPartition.pairRow,
            RootPartition.table, typeF4SimpleCoefficient, Prod.mk.injEq,
            Sum.inl.injEq, Sum.inr.injEq, Sum.inl_ne_inr, Sum.inr_ne_inl, Fin.ext_iff,
            Matrix.cons_val_two, Matrix.cons_val_three] <;> decide
      | inr a =>
        rcases a with ⟨i, j⟩
        simp only [simplePositiveIndex, positiveBlockRoots, Set.mem_range, roots_val_eq_iff]
        dsimp only [Slot, pairCount, quartetCount]
        fin_cases i <;> fin_cases j <;>
          norm_num [RootPartition.index, RootPartition.quartetRow,
            RootPartition.table, typeF4SimpleCoefficient, Prod.mk.injEq,
            Sum.inl.injEq, Sum.inr.injEq, Sum.inl_ne_inr, Sum.inr_ne_inl, Fin.ext_iff,
            Matrix.cons_val_two, Matrix.cons_val_three] <;> decide
  · exact iff_of_false (fun hr => hp (positiveBlockRoots_isPos _ hr)) (fun hr => hp hr.2)

theorem splitPositiveBlock_simple (m : ℕ) (s : Side) :
    splitPositiveBlock m (simplePositiveIndex s) = splitSimpleBlock m s true := by
  unfold splitPositiveBlock splitSimpleBlock
  congr 1
  ext x
  simp only [Set.mem_ofPred_eq, positiveBlockRoots_simple_iff]

theorem positiveBlock_simple (d : LocalBlockInput m) (s : Side) :
    positiveBlock d (simplePositiveIndex s) = simpleBlock d s true := by
  unfold positiveBlock simpleBlock
  rw [splitPositiveBlock_simple]

private theorem split_coordinates (m : ℕ) (e : RootOrder .positive) :
    Function.Bijective (wordInSubgroup m e) :=
  wordInSubgroup_bijective_of_matrix_relations m e
    (rootGenerator_exchange m) (wordCartanEntry_sub_of_lower_eq m e)

private theorem pair_mem (m : ℕ) (i : Fin 4) (t : Fin 2 → CoefficientField m) :
    pairWord m (fun j => ((rootBlocks .positive).roots (.inl (i, j))).val) t ∈
      splitPositiveBlock m (.inl i) := by
  apply mul_mem
  · exact subset_closure ⟨_, _, ⟨0, rfl⟩, rfl⟩
  · exact subset_closure ⟨_, _, ⟨1, rfl⟩, rfl⟩

private theorem quartet_mem (m : ℕ) (i : Fin 4) (t : Fin 4 → CoefficientField m) :
    quartetWord m (fun j => ((rootBlocks .positive).roots (.inr (i, j))).val) t ∈
      splitPositiveBlock m (.inr i) := by
  apply mul_mem
  · apply mul_mem
    · apply mul_mem
      · exact subset_closure ⟨_, _, ⟨0, rfl⟩, rfl⟩
      · exact subset_closure ⟨_, _, ⟨1, rfl⟩, rfl⟩
    · exact subset_closure ⟨_, _, ⟨2, rfl⟩, rfl⟩
  · exact subset_closure ⟨_, _, ⟨3, rfl⟩, rfl⟩

/-- Every fixed positive element is an ordered product of individually fixed
factors, one in each of the eight complete relative root blocks. -/
theorem exists_positiveBlock_factors (d : LocalBlockInput m)
    (x : d.fixedGroup) (hx : x ∈ standardUnipotent d) :
    ∃ a b : Fin 4 → d.fixedGroup,
      (∀ i, a i ∈ positiveBlock d (.inl i)) ∧
      (∀ i, b i ∈ positiveBlock d (.inr i)) ∧
      x = (List.ofFn a).prod * (List.ofFn b).prod := by
  let B := rootBlocks .positive
  obtain ⟨t, ht⟩ := (split_coordinates m B.order).2 ⟨x.val, hx⟩
  have hw : word m B.order t = x.val := congrArg Subtype.val ht
  let p := B.repack m t
  have htw (z : SplitGroup m) : d.twist z = reeTwist m z :=
    DFunLike.congr_fun d.twist_toMonoidHom_eq z
  have hfixed : blockTwist m p = p := by
    apply B.blockWord_injective m (split_coordinates m B.order)
    rw [← B.twist_blockWord m (mixedRootCommutation m) (b2RootSwap m)]
    change reeTwist m (B.blockWord m (B.repack m t)) = B.blockWord m (B.repack m t)
    rw [← B.word_eq_blockWord, hw, ← htw]
    exact x.property
  have hp (i : Fin 4) : pairTwist m (p.1 i) = p.1 i :=
    congrFun (congrArg Prod.fst hfixed) i
  have hq (i : Fin 4) : quartetTwist m (p.2 i) = p.2 i :=
    congrFun (congrArg Prod.snd hfixed) i
  let a : Fin 4 → d.fixedGroup := fun i =>
    ⟨pairWord m (fun j => (B.roots (.inl (i, j))).val) (p.1 i), by
      exact (htw _).trans ((B.twist_pair m (mixedRootCommutation m) i (p.1 i)).trans
        (congrArg (pairWord m _) (hp i)))⟩
  let b : Fin 4 → d.fixedGroup := fun i =>
    ⟨quartetWord m (fun j => (B.roots (.inr (i, j))).val) (p.2 i), by
      exact (htw _).trans
        ((B.twist_quartet m (mixedRootCommutation m) (b2RootSwap m) i (p.2 i)).trans
          (congrArg (quartetWord m _) (hq i)))⟩
  refine ⟨a, b, fun i => pair_mem m i _, fun i => quartet_mem m i _, ?_⟩
  apply Subtype.ext
  change x.val = d.fixedGroup.subtype ((List.ofFn a).prod * (List.ofFn b).prod)
  rw [map_mul, map_list_prod, map_list_prod, List.map_ofFn, List.map_ofFn]
  exact hw.symm.trans (B.word_eq_blockWord m t)

/-- The eight positive fixed relative root groups generate the full fixed
unipotent group. No Sylow, simplicity, or perfectness assumption is needed. -/
theorem standardUnipotent_eq_iSup_positiveBlock (d : LocalBlockInput m) :
    standardUnipotent d = ⨆ i, positiveBlock d i := by
  apply le_antisymm
  · intro x hx
    obtain ⟨a, b, ha, hb, rfl⟩ := exists_positiveBlock_factors d x hx
    apply mul_mem
    · apply list_prod_mem
      intro y hy
      obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hy
      exact (le_iSup (positiveBlock d) (.inl i)) (ha i)
    · apply list_prod_mem
      intro y hy
      obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hy
      exact (le_iSup (positiveBlock d) (.inr i)) (hb i)
  · exact iSup_le (positiveBlock_le_unipotent d)

end ReeF4.LocalBlockInput.PairRigidity.FixedCollection
