module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.Basic
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.SplitGeneration
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.WeylLifts

/-!
# Relative Weyl representatives for a supplied Ree twist

The longest words on the node orbits are `[0,3]` and `[1,2,1,2]`.
Their established integral braid identities prove fixedness under every
supplied local twist, since its root equations determine that twist uniquely.
The representatives lie in their corresponding fixed seeds. Membership in
the join of the two signed fixed simple blocks is a further rank-one calculation.

Source: GLS3, 2.3.2–4 and 2.3.8(b), `refs/KGroup/GLS3/chapter2.tex`.
-/

@[expose] public section
noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.FixedCollection

open LargeLocalSeeds Subgroup Parabolics.Binary.FixedGeometry
variable {m : ℕ}

/-- The actual fixed representative of the reflection on one relative simple root. -/
def relativeWeyl (d : LocalBlockInput m) (s : Side) : d.fixedGroup :=
  ⟨simpleWord m (sideWord s),
    (DFunLike.congr_fun d.twist_toMonoidHom_eq _).trans (sideWord_fixed m s)⟩

@[simp] theorem relativeWeyl_val (d : LocalBlockInput m) (s : Side) :
    (relativeWeyl d s).val = simpleWord m (sideWord s) := rfl

theorem relativeWeyl_mem_seed (d : LocalBlockInput m) (s : Side) :
    relativeWeyl d s ∈ standardSeed d s := by
  change simpleWord m (sideWord s) ∈ splitSeed m s
  have h := weylLift_mem_seed m s
  change toSplitGroup m (weylLift m s) ∈ splitSeed m s at h
  rwa [toSplitGroup_weylLift] at h

/-- The subgroup generated by the two specified relative Weyl representatives. -/
def relativeWeylSubgroup (d : LocalBlockInput m) : Subgroup d.fixedGroup :=
  closure (Set.range (relativeWeyl d))

theorem relativeWeyl_mem_subgroup (d : LocalBlockInput m) (s : Side) :
    relativeWeyl d s ∈ relativeWeylSubgroup d :=
  subset_closure (Set.mem_range_self s)

/-- To contain the relative Weyl subgroup it suffices to contain its two words. -/
theorem relativeWeylSubgroup_le (d : LocalBlockInput m) (K : Subgroup d.fixedGroup)
    (h : ∀ s, relativeWeyl d s ∈ K) : relativeWeylSubgroup d ≤ K := by
  apply (closure_le _).mpr
  rintro _ ⟨s, rfl⟩
  exact h s

end ReeF4.LocalBlockInput.PairRigidity.FixedCollection
