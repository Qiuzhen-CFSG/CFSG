module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.SuzukiLeviGeneration.Basic
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.SuzukiLeviGeneration.FixedNormalizer.Collection
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.SuzukiLeviGeneration.FixedNormalizer.Cosets

/-!
# The complete fixed middle-node normalizer

Every element of the normalizer generated by the nonzero rank-one words at
nodes 1 and 2 has a two-coroot factor and one of eight split B₂ representatives.
The representatives remain distinct after arbitrary torus multiplication.
Comparison with the Ree twist therefore leaves only the identity and the
literal longest word `[1,2,1,2]`. Uniqueness of the two coroot parameters then
forces `(a,b) = (titsEnd(b),b)`, exactly the published Suzuki torus factor.

Here `theta` is the power `2^m`, `titsEnd` is the power `2^(m+1)`, and
`theta (titsEnd t) = t`. The proof works also at `m = 0`. It neither requires
split Bruhat coverage nor an ambient Gauss identity. The converse confirms
membership and fixedness for every torus parameter and both Weyl choices.

Source: GLS3, 2.3.4–8 and §2.4, especially Table 2.4 type V and 2.4.8,
`refs/KGroup/GLS3/chapter2.tex`.
-/

public section
namespace ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
open SuzukiNormalizer LocalIndices.SuzukiGaussData
noncomputable section
variable {m : ℕ}

/-- The exact fixed-normalizer form, without a lower bound on `m`. -/
theorem suzuki_fixedNormalizerForm (d : LocalBlockInput m) : SuzukiFixedNormalizerForm d := by
  intro n hn hfix
  obtain ⟨a, b, k, rfl⟩ := splitForm m n hn
  rw [map_mul, twist_torus, twist_representative] at hfix
  have hk : twistIndex k = k := representative_unique hfix
  rw [hk] at hfix
  have ha := (torus_injective (mul_right_cancel hfix)).1
  rcases (twistIndex_fixed_iff k).mp hk with rfl | rfl
  · refine ⟨b, false, ?_⟩
    rw [← ha]
    rfl
  · refine ⟨b, true, ?_⟩
    rw [← ha]
    rfl

/-- Both factors in the normal form really belong to the fixed normalizer. -/
theorem suzuki_fixedNormalizer_iff (d : LocalBlockInput m) (n : SplitGroup m) :
    (n ∈ splitSuzukiNormalizer m ∧ d.twist n = n) ↔
      ∃ t : (CoefficientField m)ˣ, ∃ e : Bool,
        n = torusFactor t * (if e then (relativeWeyl d .suzuki).val else 1) := by
  constructor
  · rintro ⟨hn, hf⟩
    exact suzuki_fixedNormalizerForm d n hn hf
  · rintro ⟨t, e, rfl⟩
    refine ⟨(splitSuzukiNormalizer m).mul_mem (suzuki_torusFactor_mem_normalizer t) ?_, ?_⟩
    · cases e
      · exact (splitSuzukiNormalizer m).one_mem
      · exact suzuki_relativeWeyl_mem_normalizer d
    · rw [map_mul, torusFactor_fixed]
      congr 1
      cases e
      · exact map_one d.twist
      · exact (relativeWeyl d .suzuki).property

end
end ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
