module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.WeylWords
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.PositiveFactors
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.OppositionCell.FixedBruhatCover.NormalizerGeometry.RankOneTransport.SimpleConjugation

/-!
# Full subsystem Levis of the fixed Ree seeds

Use both complete signed blocks on the end-node or middle-node subsystem.
The longest subsystem word negates every supported root. Hence all negative
subsystem curves, including the nonsimple B₂ curves, lie in the original seed.
Partitioning the positive roots then gives generation by this full Levi and
the specified radical. Both factors are stable under the supplied twist.
The Levi includes the torus generated by its opposite root groups; no
complementary parabolic torus is adjoined.

These are split generation and stability results. Descent of their product
requires relative normality and trivial intersection, proved separately.
Source: GLS3, 2.3.4–8 and §2.4, `refs/KGroup/GLS3/chapter2.tex`; the local
construction underlying Aschbacher–Smith F.1.12, printed pp.263–264.
-/

@[expose] public section
noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem Subgroup
open LargeLocalSeeds Parabolics.Binary.FixedGeometry
open RootPairing.IntegralGeckConstruction
open PairNormalization.OppositionCell.FixedBruhatCover.NormalizerGeometry.RankOneTransport
private local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg
variable {m : ℕ}

/-- The full subsystem Levi, generated by both complete signed root blocks. -/
def splitLevi (m : ℕ) (s : Side) : Subgroup (SplitGroup m) :=
  splitSimpleBlock m s true ⊔ splitSimpleBlock m s false

/-- The actual fixed intersection of the full subsystem Levi. -/
def fixedLevi (d : LocalBlockInput m) (s : Side) : Subgroup d.fixedGroup :=
  (splitLevi m s).subgroupOf d.fixedGroup

/-- The specified split radical, viewed inside its seed. -/
def radicalInSplitSeed (m : ℕ) (s : Side) : Subgroup (splitSeed m s) :=
  (splitRadical m s).subgroupOf (splitSeed m s)

private def reflectWord : List (Fin 4) → F4Chevalley.Root → F4Chevalley.Root
  | [], r => r
  | i :: w, r => typeF4RootPairing.reflectionPerm (typeF4SimpleRootIndex i) (reflectWord w r)

private theorem reflection_val (i : Fin 4) (r : F4Chevalley.Root) :
    (typeF4RootPairing.reflectionPerm (typeF4SimpleRootIndex i) r).val =
      r.val - (typeF4CorootScale (typeF4SimpleRootIndex i) *
        dot r.val (typeF4SimpleRoot i)) • typeF4SimpleRoot i := by
  change typeF4RootPairing.root _ = _
  rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_root,
    typeF4RootPairing_pairing]
  rfl

private theorem neg_val (r : F4Chevalley.Root) : (-r).val = -r.val := by
  change typeF4RootPairing.root (-r) = -typeF4RootPairing.root r
  simp only [RootPairing.indexNeg_neg, RootPairing.root_reflectionPerm,
    RootPairing.reflection_apply_self]

private theorem reflectWord_side (s : Side) (r : F4Chevalley.Root)
    (hr : ∀ i, i ∉ leviNodes s → typeF4SimpleCoefficient r.val i = 0) :
    reflectWord (sideWord s) r = -r := by
  apply Subtype.ext
  rw [neg_val]
  cases s with
  | suzuki =>
    have h0 := hr 0 (by simp [leviNodes])
    have h3 := hr 3 (by simp [leviNodes])
    simp only [typeF4SimpleCoefficient] at h0 h3
    ext i
    fin_cases i <;>
      norm_num [sideWord, reflectWord, reflection_val, typeF4CorootScale_simpleRoot,
        typeF4SimpleRoot, dot, Fin.sum_univ_four, basisVector,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.vecHead, Matrix.vecTail, Fin.succ] <;> linarith!
  | linear =>
    have h1 := hr 1 (by simp [leviNodes])
    have h2 := hr 2 (by simp [leviNodes])
    simp only [typeF4SimpleCoefficient] at h1 h2
    ext i
    fin_cases i <;>
      norm_num [sideWord, reflectWord, reflection_val, typeF4CorootScale_simpleRoot,
        typeF4SimpleRoot, dot, Fin.sum_univ_four, basisVector,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.vecHead, Matrix.vecTail, Fin.succ] <;> linarith!

private theorem simpleWord_conj (m : ℕ) (w : List (Fin 4))
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    simpleWord m w * rootGeneratorInGroup m r t * (simpleWord m w)⁻¹ =
      rootGeneratorInGroup m (reflectWord w r) t := by
  induction w with
  | nil => simp [simpleWord, reflectWord]
  | cons i w ih =>
    have he : simpleWord m (i :: w) = simpleWord m [i] * simpleWord m w := by
      simp [simpleWord]
    have hs (q : F4Chevalley.Root) :
        simpleWord m [i] * rootGeneratorInGroup m q t * (simpleWord m [i])⁻¹ =
          rootGeneratorInGroup m (typeF4RootPairing.reflectionPerm (typeF4SimpleRootIndex i) q) t := by
      apply Subtype.ext
      simpa only [Subgroup.coe_mul, Subgroup.coe_inv, rootGeneratorInGroup_coe,
        simpleWord_coe, List.map_cons, List.map_nil, WordRelations.titsUnit, typeF4RootPairing_baseEquiv_val] using
        simple_conj (typeF4RootPairing_baseEquiv i) q t
    rw [he]
    calc
      _ = simpleWord m [i] *
          (simpleWord m w * rootGeneratorInGroup m r t * (simpleWord m w)⁻¹) *
          (simpleWord m [i])⁻¹ := by group
      _ = _ := by rw [ih, hs]; rfl

/-- The longest subsystem word reverses every subsystem root, including
both nonsimple positive roots in the B₂ subsystem. -/
theorem relativeWeyl_conj_block_root (d : LocalBlockInput m) (s : Side)
    (p : Bool) (r : F4Chevalley.Root) (t : CoefficientField m)
    (hr : IsSimpleBlockRoot s p r) :
    (relativeWeyl d s).val * rootGeneratorInGroup m r t *
      (relativeWeyl d s).val⁻¹ =
      rootGeneratorInGroup m (typeF4RootPairing.reflectionPerm r r) t := by
  rw [relativeWeyl_val, simpleWord_conj, reflectWord_side s r hr.1]
  rfl

private theorem splitPositiveBlock_le_seed (m : ℕ) (s : Side) :
    splitSimpleBlock m s true ≤ splitSeed m s := by
  apply Subgroup.closure_mono
  rintro _ ⟨r, t, hr, rfl⟩
  exact ⟨r, t, Or.inl hr.2, rfl⟩

/-- Both complete signed subsystem blocks belong to the original root-defined seed. -/
theorem splitLevi_le_seed (m : ℕ) (s : Side) : splitLevi m s ≤ splitSeed m s := by
  apply sup_le (splitPositiveBlock_le_seed m s)
  apply (closure_le _).mpr
  rintro _ ⟨r, t, hr, rfl⟩
  have hp : IsSimpleBlockRoot s true (-r) :=
    (isSimpleBlockRoot_neg_iff s false r).mpr hr
  have hw : simpleWord m (sideWord s) ∈ splitSeed m s := by
    exact relativeWeyl_mem_seed (canonicalLocalBlockInput m) s
  have he := simpleWord_conj m (sideWord s) (-r) t
  rw [reflectWord_side s (-r) hp.1, neg_neg] at he
  rw [← he]
  exact mul_mem (mul_mem hw (splitPositiveBlock_le_seed m s
    (subset_closure ⟨_, t, hp, rfl⟩))) (inv_mem hw)

/-- The original split seed is generated by the full subsystem Levi and
its specified positive-root radical. No fixed-point descent is used here. -/
theorem splitSeed_eq_levi_sup_radical (m : ℕ) (s : Side) :
    splitSeed m s = splitLevi m s ⊔ splitRadical m s := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨r, t, hr, rfl⟩
    rcases hr with hp | ⟨i, hi, rfl⟩
    · by_cases hR : IsRadicalRoot s r
      · exact mem_sup_right (subset_closure ⟨r, t, hR, rfl⟩)
      · apply mem_sup_left
        apply mem_sup_left
        apply Subgroup.subset_closure
        refine ⟨r, t, ⟨?_, hp⟩, rfl⟩
        intro i hi
        by_contra hn
        exact hR ⟨hp, i, hi, hn⟩
    · exact mem_sup_left (mem_sup_right (subset_closure
        ⟨_, t, isSimpleBlockRoot_neg_simple s i hi, rfl⟩))
  · exact sup_le (splitLevi_le_seed m s)
      ((splitRadical_le_unipotent m s).trans (splitUnipotent_le_splitSeed m s))


private theorem blockRoot_duality (s : Side) (p : Bool) (r : F4Chevalley.Root)
    (hr : IsSimpleBlockRoot s p r) :
    IsSimpleBlockRoot s p (exceptionalRootPermutation r) := by
  have hp (q : F4Chevalley.Root) (hq : IsSimpleBlockRoot s true q) :
      IsSimpleBlockRoot s true (exceptionalRootPermutation q) :=
    (positiveBlockRoots_simple_iff s _).mp
      (positiveBlockRoots_duality _ ((positiveBlockRoots_simple_iff s q).mpr hq))
  cases p with
  | true => exact hp r hr
  | false =>
    have hn := hp (-r) ((isSimpleBlockRoot_neg_iff s false r).mpr hr)
    rw [exceptionalRootPermutation_neg] at hn
    exact (isSimpleBlockRoot_neg_iff s false _).mp hn

/-- Each complete signed subsystem block is stable under the supplied twist. -/
theorem splitSimpleBlock_twist (d : LocalBlockInput m) (s : Side) (p : Bool) :
    (splitSimpleBlock m s p).map d.twist.toMonoidHom = splitSimpleBlock m s p := by
  have hle : (splitSimpleBlock m s p).map d.twist.toMonoidHom ≤ splitSimpleBlock m s p := by
    rw [map_le_iff_le_comap]
    apply (closure_le _).mpr
    rintro _ ⟨r, t, hr, rfl⟩
    change d.twist (rootGeneratorInGroup m r t) ∈ splitSimpleBlock m s p
    rw [d.twist_root]
    exact subset_closure ⟨_, _, blockRoot_duality s p r hr, rfl⟩
  apply le_antisymm hle
  intro x hx
  refine ⟨d.twist x, hle (mem_map_of_mem _ hx), ?_⟩
  exact DFunLike.congr_fun d.twist_sq x

/-- Stability concerns the actual split Levi, before intersecting with fixed points. -/
theorem splitLevi_twist (d : LocalBlockInput m) (s : Side) :
    (splitLevi m s).map d.twist.toMonoidHom = splitLevi m s := by
  rw [splitLevi, Subgroup.map_sup, splitSimpleBlock_twist, splitSimpleBlock_twist]

private theorem radicalRoot_duality (s : Side) (r : F4Chevalley.Root)
    (hr : IsRadicalRoot s r) : IsRadicalRoot s (exceptionalRootPermutation r) := by
  have hp := ((typeF4RootPairing.isPositiveRootDuality_iff
    typeF4RootPairing_base exceptionalRootPermutation).mp
      exceptionalRootPermutation_spec).2.1 r
  refine ⟨hp.mp hr.1, ?_⟩
  by_contra hn
  push Not at hn
  have hb : IsSimpleBlockRoot s true (exceptionalRootPermutation r) := ⟨hn, hp.mp hr.1⟩
  have hbb := blockRoot_duality s true _ hb
  rw [exceptionalRootPermutation_involutive] at hbb
  obtain ⟨i, hi, hne⟩ := hr.2
  exact hne (hbb.1 i hi)

/-- Both specified positive-root radicals are stable for every coefficient field. -/
theorem splitRadical_twist (d : LocalBlockInput m) (s : Side) :
    (splitRadical m s).map d.twist.toMonoidHom = splitRadical m s := by
  have hle : (splitRadical m s).map d.twist.toMonoidHom ≤ splitRadical m s := by
    rw [map_le_iff_le_comap]
    apply (closure_le _).mpr
    rintro _ ⟨r, t, hr, rfl⟩
    change d.twist (rootGeneratorInGroup m r t) ∈ splitRadical m s
    rw [d.twist_root]
    exact subset_closure ⟨_, _, radicalRoot_duality s r hr, rfl⟩
  apply le_antisymm hle
  intro x hx
  refine ⟨d.twist x, hle (mem_map_of_mem _ hx), ?_⟩
  exact DFunLike.congr_fun d.twist_sq x

theorem fixedLevi_le_seed (d : LocalBlockInput m) (s : Side) :
    fixedLevi d s ≤ standardSeed d s := fun _ hx => splitLevi_le_seed m s hx

theorem simpleBlock_le_fixedLevi (d : LocalBlockInput m) (s : Side) (p : Bool) :
    simpleBlock d s p ≤ fixedLevi d s := by
  intro x hx
  cases p
  · exact mem_sup_right hx
  · exact mem_sup_left hx

/-- The specified Weyl word is itself in the fixed subsystem Levi. -/
theorem relativeWeyl_mem_fixedLevi (d : LocalBlockInput m) (s : Side) :
    relativeWeyl d s ∈ fixedLevi d s := by
  change simpleWord m (sideWord s) ∈ splitLevi m s
  apply (splitLevi m s).list_prod_mem
  intro x hx
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hx
  have hi' : i ∈ leviNodes s := by
    cases s <;> simp_all [sideWord, leviNodes]
    tauto
  have hp : rootGeneratorInGroup m (typeF4SimpleRootIndex i) 1 ∈ splitLevi m s :=
    mem_sup_left (subset_closure ⟨_, _, isSimpleBlockRoot_simple s i hi', rfl⟩)
  have hn : rootGeneratorInGroup m (-typeF4SimpleRootIndex i) (-1) ∈ splitLevi m s :=
    mem_sup_right (subset_closure ⟨_, _, isSimpleBlockRoot_neg_simple s i hi', rfl⟩)
  simpa only [Parabolics.weylWord, inv_one] using mul_mem (mul_mem hp hn) hp

end ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
