module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.SuzukiLeviGeneration.Basic
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.SuzukiLeviGeneration.SplitNormalForm.Generation

/-!
# Split Bruhat normal form in the actual middle-node Levi

Every element of the subgroup generated by all signed B₂ subsystem roots has
an expression `u * n * v`. Both unipotent factors lie in the four-root positive
block; `n` lies in the normalizer generated by all nonzero rank-one words at
nodes 1 and 2. Moreover, `n * v * n⁻¹` lies in the full negative split unipotent
subgroup, as required for the existing ambient uniqueness theorem.

The proof first establishes subsystem `U N U` coverage by local exchange and
word induction. It then partitions the four positive roots by the signs of
their images under `n`, collects the positive images first, and absorbs those
factors on the left. Root transport preserves the signed middle support, so
this collection never enlarges the outer factors to the ambient F₄ subgroup.
No field-size restriction, fixed-normalizer classification, or Suzuki Gauss
identity is needed.

This is the split existence ingredient for GLS3 2.3.4–8 and Table 2.4 type V,
using the split root identities of 1.11.5 and 1.12.1; see
`refs/KGroup/GLS3/chapter2.tex` and `refs/KGroup/GLS3/Chapter1.tex`.
-/

@[expose] public noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open Subgroup LargeLocalSeeds BlockParameters.FieldRecovery.SuzukiChart
open PairNormalization.OppositionCell PairNormalization.OppositionCell.FixedBruhatCover

private theorem suzuki_positive_le_splitUnipotent (m : ℕ) :
    splitSimpleBlock m .suzuki true ≤ splitUnipotent m := by
  apply Subgroup.closure_mono
  rintro _ ⟨r, t, hr, rfl⟩
  exact ⟨r, t, hr.2, rfl⟩

/-- Bruhat normal form for the actual middle-node split Levi. Both outer
factors stay in its four-root positive block, and the right factor satisfies
the ambient inversion condition. The assertion also holds when `m = 0`. -/
theorem suzukiSplitLeviNormalForm (m : ℕ) : SuzukiSplitLeviNormalForm m := by
  intro g hg
  obtain ⟨u, hu, n, hn, c, hc, he⟩ := SuzukiSplitNormalForm.unrestricted_factors hg
  obtain ⟨rt⟩ := SuzukiSplitNormalForm.transport hn
  let U := splitSimpleBlock m .suzuki true
  let A := U ⊓ U.comap (MulAut.conj n).toMonoidHom
  let B := U ⊓ rightUnipotent n
  have hroot (j : Fin 4) : (∀ t, X j t ∈ A) ∨ (∀ t, X j t ∈ B) := by
    have hp (t : CoefficientField m) : X j t ∈ U :=
      subset_closure ⟨_, t, (simpleBlockRoot_iff _).mpr ⟨j, rfl⟩, rfl⟩
    by_cases hj : typeF4RootPairing_base.IsPos (rt.perm (roots j))
    · refine Or.inl (fun t => ⟨hp t, ?_⟩)
      change (MulAut.conj n) (X j t) ∈ U
      rw [rt.conj_root]
      exact subset_closure ⟨_, _, ⟨rt.supported _
        ((simpleBlockRoot_iff _).mpr ⟨j, rfl⟩).1, hj⟩, rfl⟩
    · refine Or.inr (fun t => ⟨hp t, suzuki_positive_le_splitUnipotent m (hp t), ?_⟩)
      change (MulAut.conj n) (X j t) ∈ splitNegativeUnipotent m
      rw [rt.conj_root]
      exact subset_closure ⟨_, _, hj, rfl⟩
  obtain ⟨b, hb, v, hv, hcv⟩ := SuzukiSplitNormalForm.positive_factorization A B hroot hc
  refine ⟨u * (n * b * n⁻¹), mul_mem hu hb.2, n, hn, v, hv.1, hv.2, ?_⟩
  rw [he, hcv]
  group

end ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
