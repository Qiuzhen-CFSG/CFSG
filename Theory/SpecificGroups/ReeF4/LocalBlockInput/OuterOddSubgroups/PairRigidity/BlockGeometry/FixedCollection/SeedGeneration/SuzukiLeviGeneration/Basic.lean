module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.Levi
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.ParabolicRecognition.LocalIndices.SuzukiCover.Gauss.Coordinates
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.OppositionCell.FixedBruhatCover.NormalizerGeometry

/-!
# Generation and normal-form reductions for the fixed B₂ Levi

Conjugation by the literal middle Weyl word sends every negative subsystem
root into the positive block. It therefore puts the entire negative fixed
block in the subgroup generated by the positive fixed block and that word.
The ambient Suzuki Gauss identity, when supplied, puts every prescribed
two-coroot factor there as well: its norm at `(0,n)` is exactly `n`.

The two remaining geometric obligations are separate. A restricted split
Bruhat form must retain both outer factors in the B₂ block and the middle
factor in the normalizer generated at nodes 1 and 2. A fixed element of this
normalizer must have the stated coroot and relative Weyl form. The established
global middle-factor uniqueness and unipotent separation then force all
three factors of a fixed Levi element to be fixed. This proves the conditional
generation reduction without assuming that fixed points preserve joins.

The normalizer contains all nonzero rank-one parameters, not just the
parameter-one Weyl generators. Thus the remaining normalizer obligation
includes identification of the entire fixed Levi torus.

Source: GLS3, 2.3.4–8 and §2.4, especially Table 2.4 type V,
`refs/KGroup/GLS3/chapter2.tex`. The scalar and ambient Gauss conventions
are those of `SuzukiCover.Gauss.Coordinates`.
-/

@[expose] public noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
open Subgroup LargeLocalSeeds BlockParameters.FieldRecovery
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open LocalIndices.SuzukiGaussData
open PairNormalization.OppositionCell.FixedBruhatCover
private local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg
variable {m : ℕ}

/-- The whole negative fixed block, including its central parameter, lies
in the subgroup generated by the positive block and the relative reflection. -/
theorem suzuki_negativeBlock_le_positive_sup_weyl (d : LocalBlockInput m) :
    simpleBlock d .suzuki false ≤
      simpleBlock d .suzuki true ⊔ zpowers (relativeWeyl d .suzuki) := by
  have hconj : splitSimpleBlock m .suzuki false ≤
      (splitSimpleBlock m .suzuki true).comap
        (MulAut.conj (relativeWeyl d .suzuki).val).toMonoidHom := by
    apply (closure_le _).mpr
    rintro _ ⟨r, t, hr, rfl⟩
    change (relativeWeyl d .suzuki).val * rootGeneratorInGroup m r t *
      (relativeWeyl d .suzuki).val⁻¹ ∈ splitSimpleBlock m .suzuki true
    rw [relativeWeyl_conj_block_root d .suzuki false r t hr]
    exact subset_closure ⟨_, t, (isSimpleBlockRoot_neg_iff .suzuki false r).mpr hr, rfl⟩
  intro x hx
  have hy : relativeWeyl d .suzuki * x * (relativeWeyl d .suzuki)⁻¹ ∈
      simpleBlock d .suzuki true := hconj hx
  have hw : relativeWeyl d .suzuki ∈
      simpleBlock d .suzuki true ⊔ zpowers (relativeWeyl d .suzuki) :=
    mem_sup_right (mem_zpowers _)
  convert mul_mem (mul_mem (inv_mem hw) (mem_sup_left hy)) hw using 1
  group

/-- The generated subgroup is contained in the actual fixed Levi. -/
theorem suzuki_generated_le_fixedLevi (d : LocalBlockInput m) :
    simpleBlock d .suzuki true ⊔ zpowers (relativeWeyl d .suzuki) ≤
      fixedLevi d .suzuki :=
  sup_le (simpleBlock_le_fixedLevi d .suzuki true)
    (zpowers_le.mpr (relativeWeyl_mem_fixedLevi d .suzuki))

/-- The ambient Gauss identity supplies every nonzero coroot parameter.
The witness lies in the fixed group, so this also proves fixedness of its
literal split torus factor under the stated identity. -/
theorem exists_suzuki_torusFactor_in_generated (d : LocalBlockInput m)
    (C : SuzukiCoordinates d) (hG : SplitIdentity m) (n : (CoefficientField m)ˣ) :
    ∃ z ∈ simpleBlock d .suzuki true ⊔ zpowers (relativeWeyl d .suzuki),
      z.val = torusFactor n := by
  let J := simpleBlock d .suzuki true ⊔ zpowers (relativeWeyl d .suzuki)
  have hm (p : Bool) (t u : CoefficientField m) : C.element p t u ∈ J := by
    cases p
    · exact suzuki_negativeBlock_le_positive_sup_weyl d (C.element_mem false t u)
    · exact mem_sup_left (C.element_mem true t u)
  have hw : relativeWeyl d .suzuki ∈ J := mem_sup_right (mem_zpowers _)
  have hn : norm (0 : CoefficientField m) n ≠ 0 := by
    simp [LocalIndices.SuzukiGaussData.norm]
  have hunit : Units.mk0 (norm (0 : CoefficientField m) n) hn = n := by
    ext
    simp [LocalIndices.SuzukiGaussData.norm]
  have he := hG 0 n hn
  rw [hunit] at he
  let z := (C.element false (negativeFirst 0 n) (negativeSecond 0 n))⁻¹ *
    (relativeWeyl d .suzuki * C.element false 0 n) *
      (C.element true (positiveFirst 0 n) (positiveSecond 0 n))⁻¹
  refine ⟨z, mul_mem (mul_mem (inv_mem (hm _ _ _)) (mul_mem hw (hm _ _ _)))
    (inv_mem (hm _ _ _)), ?_⟩
  change (suzukiWord m false (negativeFirst 0 n) (negativeSecond 0 n))⁻¹ *
    (Parabolics.Binary.FixedGeometry.simpleWord m [1,2,1,2] * suzukiWord m false 0 n) *
      (suzukiWord m true (positiveFirst 0 n) (positiveSecond 0 n))⁻¹ = torusFactor n
  rw [he]
  group

/-- All nonzero rank-one words at the two middle simple roots. -/
def splitSuzukiNormalizer (m : ℕ) : Subgroup (SplitGroup m) :=
  closure {n | ∃ (i : Fin 4), i ∈ leviNodes .suzuki ∧
    ∃ t : (CoefficientField m)ˣ, n = rankOneRepresentative m (typeF4SimpleRootIndex i) t}

theorem suzuki_weylWord_mem_normalizer (m : ℕ) (i : Fin 4)
    (hi : i ∈ leviNodes .suzuki) (t : (CoefficientField m)ˣ) :
    Parabolics.weylWord m (typeF4SimpleRootIndex i) t ∈ splitSuzukiNormalizer m := by
  have h : rankOneRepresentative m (typeF4SimpleRootIndex i) t ∈ splitSuzukiNormalizer m :=
    subset_closure ⟨i, hi, t, rfl⟩
  simpa only [Parabolics.weylWord, rankOneRepresentative, Units.val_inv_eq_inv_val] using h

theorem suzuki_torusWord_mem_normalizer (m : ℕ) (i : Fin 4)
    (hi : i ∈ leviNodes .suzuki) (t : (CoefficientField m)ˣ) :
    Parabolics.torusWord m (typeF4SimpleRootIndex i) t ∈ splitSuzukiNormalizer m := by
  exact mul_mem (suzuki_weylWord_mem_normalizer m i hi t)
    (suzuki_weylWord_mem_normalizer m i hi (-1))

theorem suzuki_torusFactor_mem_normalizer (n : (CoefficientField m)ˣ) :
    torusFactor n ∈ splitSuzukiNormalizer m :=
  mul_mem (suzuki_torusWord_mem_normalizer m 1 (by simp [leviNodes]) _)
    (suzuki_torusWord_mem_normalizer m 2 (by simp [leviNodes]) _)

theorem suzuki_relativeWeyl_mem_normalizer (d : LocalBlockInput m) :
    (relativeWeyl d .suzuki).val ∈ splitSuzukiNormalizer m := by
  change Parabolics.Binary.FixedGeometry.simpleWord m [1,2,1,2] ∈ splitSuzukiNormalizer m
  apply (splitSuzukiNormalizer m).list_prod_mem
  intro x hx
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hx
  have hi' : i ∈ leviNodes .suzuki := by
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    change i = 1 ∨ i = 2
    exact hi.elim Or.inl (fun h => h.elim Or.inr (fun h => h.elim Or.inl Or.inr))
  exact suzuki_weylWord_mem_normalizer m i hi' 1

theorem splitSuzukiNormalizer_le_normalizerWords (m : ℕ) :
    splitSuzukiNormalizer m ≤ splitNormalizerWords m := by
  apply (closure_le _).mpr
  rintro _ ⟨i, _, t, rfl⟩
  exact rankOneRepresentative_mem m _ t

theorem splitSuzukiNormalizer_le_splitLevi (m : ℕ) :
    splitSuzukiNormalizer m ≤ splitLevi m .suzuki := by
  apply (closure_le _).mpr
  rintro _ ⟨i, hi, t, rfl⟩
  have hp : rootGeneratorInGroup m (typeF4SimpleRootIndex i) t ∈ splitLevi m .suzuki :=
    mem_sup_left (subset_closure ⟨_, _, isSimpleBlockRoot_simple .suzuki i hi, rfl⟩)
  have hn : rootGeneratorInGroup m (-typeF4SimpleRootIndex i) (-(t⁻¹ : (CoefficientField m)ˣ)) ∈
      splitLevi m .suzuki :=
    mem_sup_right (subset_closure ⟨_, _, isSimpleBlockRoot_neg_simple .suzuki i hi, rfl⟩)
  exact mul_mem (mul_mem hp hn) hp

/-- The restricted split normal form keeps both positive factors in the B₂
subsystem and the middle factor in its own normalizer. The right factor has
the global inversion condition needed by the established uniqueness theorem. -/
def SuzukiSplitLeviNormalForm (m : ℕ) : Prop :=
  ∀ g : SplitGroup m, g ∈ splitLevi m .suzuki →
    ∃ u ∈ splitSimpleBlock m .suzuki true, ∃ n ∈ splitSuzukiNormalizer m,
      ∃ v ∈ splitSimpleBlock m .suzuki true, v ∈ rightUnipotent n ∧ g = u * n * v

/-- Fixed middle-node normalizer words have precisely the fixed coroot factor
and one of the two relative Weyl representatives. -/
def SuzukiFixedNormalizerForm (d : LocalBlockInput m) : Prop :=
  ∀ n : SplitGroup m, n ∈ splitSuzukiNormalizer m → d.twist n = n →
    ∃ t : (CoefficientField m)ˣ, ∃ e : Bool,
      n = torusFactor t * (if e then (relativeWeyl d .suzuki).val else 1)

/-- Coverage of the actual fixed intersection by the two relative Bruhat cells,
with the complete one-parameter Levi torus retained. -/
def SuzukiLeviBruhatCover (d : LocalBlockInput m) : Prop :=
  ∀ g : d.fixedGroup, g ∈ fixedLevi d .suzuki →
    ∃ a ∈ simpleBlock d .suzuki true, ∃ b ∈ simpleBlock d .suzuki true,
      ∃ n : (CoefficientField m)ˣ, ∃ e : Bool,
        g.val = a.val * torusFactor n *
          (if e then (relativeWeyl d .suzuki).val else 1) * b.val

/-- Uniqueness descends the restricted split form to the actual fixed Levi;
the separate normalizer calculation gives its two relative Bruhat cells. -/
theorem suzukiLeviBruhatCover_of_normalForms (d : LocalBlockInput m)
    (hS : SuzukiSplitLeviNormalForm m) (hN : SuzukiFixedNormalizerForm d) :
    SuzukiLeviBruhatCover d := by
  have hU : splitSimpleBlock m .suzuki true ≤ splitUnipotent m := by
    apply Subgroup.closure_mono
    rintro _ ⟨r, t, hr, rfl⟩
    exact ⟨r, t, hr.2, rfl⟩
  intro g hg
  obtain ⟨u, hu, n, hn, v, hv, hv', he⟩ := hS g.val hg
  have hn' := splitSuzukiNormalizer_le_normalizerWords m hn
  have hproduct : d.twist u * d.twist n * d.twist v = u * n * v := by
    rw [← map_mul, ← map_mul, ← he]
    exact g.property
  have hnfix : d.twist n = n := middle_representative_unique
    (twist_mem_splitUnipotent d (hU hu)) (twist_mem_splitNormalizerWords d hn')
    (twist_mem_rightUnipotent d hv') (hU hu) hn' hv' hproduct
  obtain ⟨hufix, hvfix⟩ := fixed_unipotent_factors d g.property hnfix (hU hu) hv' he
  obtain ⟨t, e, hne⟩ := hN n hn hnfix
  refine ⟨⟨u, hufix⟩, hu, ⟨v, hvfix⟩, hv, t, e, ?_⟩
  simpa only [hne, mul_assoc] using he

/-- The fixed Bruhat cover and ambient Gauss equation together generate
the whole fixed Levi, including its torus. Both premises remain explicit. -/
theorem suzuki_fixedLevi_le_of_bruhatCover (d : LocalBlockInput m)
    (C : SuzukiCoordinates d) (hG : SplitIdentity m) (hcover : SuzukiLeviBruhatCover d) :
    fixedLevi d .suzuki ≤ simpleBlock d .suzuki true ⊔ zpowers (relativeWeyl d .suzuki) := by
  intro g hg
  obtain ⟨a, ha, b, hb, n, e, he⟩ := hcover g hg
  obtain ⟨z, hz, hze⟩ := exists_suzuki_torusFactor_in_generated d C hG n
  have hw : relativeWeyl d .suzuki ∈
      simpleBlock d .suzuki true ⊔ zpowers (relativeWeyl d .suzuki) :=
    mem_sup_right (mem_zpowers _)
  have heq : g = a * z * (if e then relativeWeyl d .suzuki else 1) * b := by
    apply Subtype.ext
    simpa only [Subgroup.coe_mul, apply_ite, Subgroup.coe_one, hze] using he
  rw [heq]
  exact mul_mem (mul_mem (mul_mem (mem_sup_left ha) hz)
    (by cases e <;> simp only [Bool.false_eq_true, ↓reduceIte] <;> first | exact hw | exact one_mem _))
    (mem_sup_left hb)

end ReeF4.LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
