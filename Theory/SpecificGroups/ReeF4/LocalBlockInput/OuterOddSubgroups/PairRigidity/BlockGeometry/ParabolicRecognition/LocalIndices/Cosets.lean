module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.Basic
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.Parabolics
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.ParabolicRecognition.RootBorel
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockParameters.FieldRecovery.LinearCoordinates

/-!
# Counting the Borel cosets of the two Ree root parabolics

Let `P` be the subgroup generated by the root Borel `B` and a negative
simple block `X`. Disjointness of `X` and `B` embeds `X` into the actual
left-coset space `P / B`. A rank-one cover by `X` and one more representative
bounds that coset space above by `|X| + 1`. Since `B` contains the supplied
odd-index positive unipotent subgroup, `|P : B|` is odd. Thus, when `|X|`
is even, the two bounds force `|P : B| = |X| + 1`. No order for the whole
Ree group or its parabolics is assumed or calculated.

The checked type VI chart gives `|X| = q`, with `q = 2^(2*m+1)`.
The type V cardinal calculation takes the explicit `SuzukiCoordinates`
witness and gives `|X| = q^2`. The two final lemmas are conditional on
concrete rank-one coverage and block–Borel disjointness. Construction of
these covers and of the Suzuki chart remains separate; these reductions
do not assert the source index statements without those inputs.

For disjointness, the Borel lies in the positive unipotent normalizer when
the coroot torus lies in the diagonal torus. Odd index makes the positive
unipotent Sylow; the Sylow normalizer intersection lemma then reduces the
claim to disjointness of the two unipotent groups. The independent `LocalIndices.Separation` module proves the needed
disjointness directly from the split matrix grading and the torus hypothesis.

Source: GLS3, Theorems 2.3.4–8, Table 2.4 types V and VI, and 2.6.5,
`refs/KGroup/GLS3/chapter2.tex`. The book's Suzuki–Ree parameter in Table 2.4
has square equal to the field size denoted by `q` here.
-/

@[expose] public noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.LocalIndices
open Subgroup LargeLocalSeeds
open BlockParameters.FieldRecovery
variable {m : ℕ}

/-- Adjoin the negative simple block to the positive root Borel. -/
abbrev rootParabolic (d : LocalBlockInput m) (s : Side) : Subgroup d.fixedGroup :=
  rootBorel d ⊔ simpleBlock d s false

/-- The actual left-coset space inside the generated parabolic candidate. -/
abbrev BorelCosets (d : LocalBlockInput m) (s : Side) : Type :=
  rootParabolic d s ⧸ (rootBorel d).subgroupOf (rootParabolic d s)

/-- Include a negative block element and take its left Borel coset. -/
def blockCoset (d : LocalBlockInput m) (s : Side)
    (u : simpleBlock d s false) : BorelCosets d s :=
  QuotientGroup.mk (⟨u.val, (le_sup_right : simpleBlock d s false ≤ rootParabolic d s) u.property⟩ : rootParabolic d s)

/-- The root Borel normalizes the positive unipotent group under the torus containment. -/
theorem rootBorel_le_normalizer (d : LocalBlockInput m)
    (hT : Parabolics.splitTorus m ≤ Parabolics.diagonalTorus m) :
    rootBorel d ≤ normalizer (standardUnipotent d) := by
  have h : Parabolics.splitBorel m ≤ normalizer (splitUnipotent m) :=
    sup_le (splitUnipotent m).le_normalizer
      (hT.trans (Parabolics.diagonalTorus_le_unipotent_normalizer m))
  exact (Subgroup.comap_mono h).trans (le_normalizer_comap d.fixedGroup.subtype)

/-- Both signs of both simple blocks are two-groups. -/
theorem simpleBlock_isPGroup (d : LocalBlockInput m) (s : Side) (positive : Bool) :
    IsPGroup 2 (simpleBlock d s positive) := by
  have hp : IsPGroup 2 (simpleBlock d s true) :=
    (standardUnipotent_isPGroup d).to_le (simpleBlock_positive_le d s)
  cases positive
  · exact hp.of_equiv (simpleBlockOppositionEquiv d s)
  · exact hp

/-- Sylow normalizer intersection reduces block–Borel disjointness to opposition disjointness. -/
theorem negativeBlock_disjoint_borel_of_unipotents (d : LocalBlockInput m)
    (hindex : Odd (standardUnipotent d).index)
    (hT : Parabolics.splitTorus m ≤ Parabolics.diagonalTorus m)
    (hUV : Disjoint (standardUnipotent d) (oppositeUnipotent d)) (s : Side) :
    Disjoint (simpleBlock d s false) (rootBorel d) := by
  let U : Sylow 2 d.fixedGroup :=
    (standardUnipotent_isPGroup d).toSylow hindex.not_two_dvd_nat
  have h := (simpleBlock_isPGroup d s false).inf_normalizer_sylow U
  have hz : simpleBlock d s false ⊓ (U : Subgroup d.fixedGroup) = ⊥ :=
    (hUV.symm.mono_left (simpleBlock_negative_le d s)).eq_bot
  have hn : Disjoint (simpleBlock d s false) (normalizer (standardUnipotent d)) := by
    apply disjoint_iff.mpr
    exact h.trans hz
  exact hn.mono_right (rootBorel_le_normalizer d hT)

/-- Disjoint subgroups give distinct cosets for distinct block elements. -/
theorem blockCoset_injective (d : LocalBlockInput m) (s : Side)
    (hd : Disjoint (simpleBlock d s false) (rootBorel d)) :
    Function.Injective (blockCoset d s) := by
  intro u v huv
  have hrel := QuotientGroup.leftRel_apply.mp (Quotient.exact huv)
  change u.val⁻¹ * v.val ∈ rootBorel d at hrel
  have he : u.val⁻¹ * v.val = 1 :=
    Subgroup.disjoint_def.mp hd
      ((simpleBlock d s false).mul_mem ((simpleBlock d s false).inv_mem u.property) v.property)
      hrel
  exact Subtype.ext (inv_mul_eq_one.mp he)

/-- Coverage of a rank-one panel by the negative block and one extra representative.
This concerns actual left Borel cosets, without presupposing their number. -/
def RankOneCover (d : LocalBlockInput m) (s : Side) (n : rootParabolic d s) : Prop :=
  ∀ g : rootParabolic d s, n.val⁻¹ * g.val ∈ rootBorel d ∨
    ∃ u : simpleBlock d s false, u.val⁻¹ * g.val ∈ rootBorel d

/-- The negative block supplies the affine points; `none` supplies the remaining representative. -/
def cosetChart (d : LocalBlockInput m) (s : Side) (n : rootParabolic d s) :
    Option (simpleBlock d s false) → BorelCosets d s
  | none => QuotientGroup.mk n
  | some u => blockCoset d s u

theorem cosetChart_surjective (d : LocalBlockInput m) (s : Side)
    (n : rootParabolic d s) (hc : RankOneCover d s n) :
    Function.Surjective (cosetChart d s n) := by
  intro q
  induction q using Quotient.inductionOn with
  | h g =>
    rcases hc g with hg | ⟨u, hu⟩
    · exact ⟨none, Quotient.sound (QuotientGroup.leftRel_apply.mpr hg)⟩
    · exact ⟨some u, Quotient.sound (QuotientGroup.leftRel_apply.mpr hu)⟩

theorem cosetChart_bijective (d : LocalBlockInput m) (s : Side) (n : rootParabolic d s)
    (hd : Disjoint (simpleBlock d s false) (rootBorel d))
    (he : ∀ u : simpleBlock d s false, n.val⁻¹ * u.val ∉ rootBorel d)
    (hc : RankOneCover d s n) :
    Function.Bijective (cosetChart d s n) := by
  constructor
  · intro a b hab
    cases a with
    | none =>
      cases b with
      | none => rfl
      | some u =>
        have hrel := QuotientGroup.leftRel_apply.mp (Quotient.exact hab)
        exact False.elim (he u hrel)
    | some u =>
      cases b with
      | none =>
        have hrel := QuotientGroup.leftRel_apply.mp (Quotient.exact hab.symm)
        exact False.elim (he u hrel)
      | some v => exact congrArg some (blockCoset_injective d s hd hab)
  · exact cosetChart_surjective d s n hc

/-- A separated cover parametrizes the actual quotient set. -/
def cosetEquiv (d : LocalBlockInput m) (s : Side) (n : rootParabolic d s)
    (hd : Disjoint (simpleBlock d s false) (rootBorel d))
    (he : ∀ u : simpleBlock d s false, n.val⁻¹ * u.val ∉ rootBorel d)
    (hc : RankOneCover d s n) :
    Option (simpleBlock d s false) ≃ BorelCosets d s :=
  Equiv.ofBijective (cosetChart d s n) (cosetChart_bijective d s n hd he hc)

theorem relIndex_eq_block_card_add_one_of_separated_cover (d : LocalBlockInput m) (s : Side)
    (n : rootParabolic d s) (hd : Disjoint (simpleBlock d s false) (rootBorel d))
    (he : ∀ u : simpleBlock d s false, n.val⁻¹ * u.val ∉ rootBorel d)
    (hc : RankOneCover d s n) :
    (rootBorel d).relIndex (rootParabolic d s) = Nat.card (simpleBlock d s false) + 1 := by
  change Nat.card (BorelCosets d s) = _
  rw [← Nat.card_congr (cosetEquiv d s n hd he hc)]
  let := Fintype.ofFinite (simpleBlock d s false)
  simp only [Nat.card_eq_fintype_card, Fintype.card_option]

/-- Every local Borel index is odd because the Borel contains the supplied odd-index subgroup. -/
theorem relIndex_odd (d : LocalBlockInput m)
    (hindex : Odd (standardUnipotent d).index) (s : Side) :
    Odd ((rootBorel d).relIndex (rootParabolic d s)) := by
  have hUB : standardUnipotent d ≤ rootBorel d :=
    Subgroup.comap_mono (le_sup_left : splitUnipotent m ≤ Parabolics.splitBorel m)
  exact (hindex.of_dvd_nat (Subgroup.index_dvd_of_le hUB)).of_dvd_nat
    (Subgroup.relIndex_dvd_index_of_le (show rootBorel d ≤ rootParabolic d s from le_sup_left))

/-- Counting quotient classes and using oddness removes the need to separate the extra cell. -/
theorem relIndex_eq_block_card_add_one (d : LocalBlockInput m)
    (hindex : Odd (standardUnipotent d).index) (s : Side)
    (hcard : Even (Nat.card (simpleBlock d s false)))
    (n : rootParabolic d s) (hd : Disjoint (simpleBlock d s false) (rootBorel d))
    (hc : RankOneCover d s n) :
    (rootBorel d).relIndex (rootParabolic d s) = Nat.card (simpleBlock d s false) + 1 := by
  have hlo := Nat.card_le_card_of_injective (blockCoset d s) (blockCoset_injective d s hd)
  have hhi := Nat.card_le_card_of_surjective (cosetChart d s n) (cosetChart_surjective d s n hc)
  let := Fintype.ofFinite (simpleBlock d s false)
  have hopt : Nat.card (Option (simpleBlock d s false)) = Nat.card (simpleBlock d s false) + 1 := by
    simp only [Nat.card_eq_fintype_card, Fintype.card_option]
  rw [hopt] at hhi
  change Nat.card (simpleBlock d s false) ≤ (rootBorel d).relIndex (rootParabolic d s) at hlo
  change (rootBorel d).relIndex (rootParabolic d s) ≤ Nat.card (simpleBlock d s false) + 1 at hhi
  obtain ⟨a, ha⟩ := relIndex_odd d hindex s
  obtain ⟨b, hb⟩ := hcard
  omega

/-- The established type VI chart counts the whole signed fixed block. -/
theorem linearBlock_card (d : LocalBlockInput m) (positive : Bool) :
    Nat.card (simpleBlock d .linear positive) = 2 ^ (2 * m + 1) := by
  rw [← Nat.card_congr (linearEquiv d positive).toEquiv]
  exact field_card m

/-- The explicit type V chart covers the whole fixed intersection. -/
def suzukiBlockEquiv (d : LocalBlockInput m) (C : SuzukiCoordinates d) (positive : Bool) :
    (CoefficientField m × CoefficientField m) ≃ simpleBlock d .suzuki positive := by
  let f : (CoefficientField m × CoefficientField m) → simpleBlock d .suzuki positive :=
    fun p => ⟨⟨suzukiWord m positive p.1 p.2, C.suzuki_fixed positive p.1 p.2⟩,
      C.suzuki_mem positive p.1 p.2⟩
  apply Equiv.ofBijective f
  constructor
  · intro p q h
    exact C.suzuki_injective positive (congrArg
      (fun x : simpleBlock d .suzuki positive => x.val.val) h)
  · intro x
    obtain ⟨t, u, h⟩ := C.suzuki_cover positive x.val x.property
    exact ⟨(t, u), Subtype.ext (Subtype.ext h)⟩

/-- Both type V parameters range independently over the coefficient field. -/
theorem suzukiBlock_card (d : LocalBlockInput m) (C : SuzukiCoordinates d) (positive : Bool) :
    Nat.card (simpleBlock d .suzuki positive) = (2 ^ (2 * m + 1)) ^ 2 := by
  rw [← Nat.card_congr (suzukiBlockEquiv d C positive), Nat.card_prod, field_card, pow_two]

/-- Conditional type VI index calculation from actual coset coverage. -/
theorem linear_relIndex_of_cover (d : LocalBlockInput m)
    (hindex : Odd (standardUnipotent d).index)
    (n : rootParabolic d .linear)
    (hd : Disjoint (simpleBlock d .linear false) (rootBorel d))
    (hc : RankOneCover d .linear n) :
    (rootBorel d).relIndex (rootBorel d ⊔ simpleBlock d .linear false) =
      2 ^ (2 * m + 1) + 1 := by
  have he : Even (Nat.card (simpleBlock d .linear false)) := by
    rw [linearBlock_card]
    exact (even_two : Even (2 : ℕ)).pow_of_ne_zero (by omega)
  rw [relIndex_eq_block_card_add_one d hindex .linear he n hd hc, linearBlock_card]

/-- Conditional type V index calculation from actual coordinates and coset coverage. -/
theorem suzuki_relIndex_of_cover (d : LocalBlockInput m)
    (hindex : Odd (standardUnipotent d).index) (C : SuzukiCoordinates d)
    (n : rootParabolic d .suzuki)
    (hd : Disjoint (simpleBlock d .suzuki false) (rootBorel d))
    (hc : RankOneCover d .suzuki n) :
    (rootBorel d).relIndex (rootBorel d ⊔ simpleBlock d .suzuki false) =
      (2 ^ (2 * m + 1)) ^ 2 + 1 := by
  have he : Even (Nat.card (simpleBlock d .suzuki false)) := by
    rw [suzukiBlock_card d C]
    exact ((even_two : Even (2 : ℕ)).pow_of_ne_zero (by omega)).pow_of_ne_zero (by decide)
  rw [relIndex_eq_block_card_add_one d hindex .suzuki he n hd hc, suzukiBlock_card d C]

end ReeF4.LocalBlockInput.PairRigidity.LocalIndices
end
