module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.ParabolicRecognition.LocalIndices.SuzukiCover.RankOne
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.RadicalOrders.FixedCoordinates
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.RadicalOrders.SplitCoordinates
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.Geometry.FixedProducts
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.Geometry.DiagonalTorus

/-!
# Generation of the fixed Suzuki Ree Borel

Unique positive split coordinates collect into four pairs and four B₂
quartets. The Ree twist preserves each block word, so uniqueness makes
all eight factors of a fixed element individually fixed. The first quartet
contains all four positive roots supported on the middle nodes {1,2};
the remaining seven blocks lie in the prescribed Suzuki radical. This
proves generation of the actual fixed unipotent intersection by the
positive Suzuki block and the actual fixed radical intersection.

The supplied coroot-word torus identity gives oddness and normalization
through the diagonal torus. The fixed Borel product theorem then separates
the fixed unipotent and torus factors. No simplicity, perfectness, index,
Levi identification, or restriction on `m` is needed.

The coordinate argument follows `BlockGeometry/FixedCollection/PositiveFactors`
using its narrow coordinate dependencies. The fixed Borel transport follows
`LocalIndices/LinearCover/BorelGeneration`.
Source: GLS3, 2.3.4(c), 2.3.7, Table 2.4 type V, and 2.6.5(g),
`refs/KGroup/GLS3/chapter2.tex`.
-/

public noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.LocalIndices
open Subgroup LargeLocalSeeds Parabolics
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open Parabolics.RadicalCoordinates Parabolics.RadicalCoordinates.FixedCoordinates
variable {m : ℕ}

private theorem positive_pair_radical (i : Fin 4) (j : Fin 2) :
    IsRadicalRoot .suzuki ((rootBlocks .positive).roots (.inl (i, j))).val := by
  have he : ((rootBlocks .positive).roots (.inl (i, j))).val =
      ((rootBlocks (.radical .suzuki)).roots (.inl (i, j))).val := by
    apply Subtype.ext
    rw [rootBlocks_roots_val, rootBlocks_roots_val]
    rfl
  rw [he]
  exact ((rootBlocks (.radical .suzuki)).roots (.inl (i, j))).property

private theorem positive_quartet_succ_radical (i : Fin 3) (j : Fin 4) :
    IsRadicalRoot .suzuki ((rootBlocks .positive).roots (.inr (i.succ, j))).val := by
  have he : ((rootBlocks .positive).roots (.inr (i.succ, j))).val =
      ((rootBlocks (.radical .suzuki)).roots (.inr (i, j))).val := by
    apply Subtype.ext
    rw [rootBlocks_roots_val, rootBlocks_roots_val]
    rfl
  rw [he]
  exact ((rootBlocks (.radical .suzuki)).roots (.inr (i, j))).property

private theorem positive_quartet_zero_simple (j : Fin 4) :
    IsSimpleBlockRoot .suzuki true ((rootBlocks .positive).roots (.inr ((0 : Fin 4), j))).val := by
  refine ⟨?_, ((rootBlocks .positive).roots (.inr ((0 : Fin 4), j))).property⟩
  intro i hi
  rw [rootBlocks_roots_val]
  fin_cases i <;> fin_cases j <;>
    norm_num [leviNodes, Fin.ext_iff, RootPartition.index, RootPartition.quartetRow,
      RootPartition.table, typeF4SimpleCoefficient,
      Matrix.cons_val_two, Matrix.cons_val_three] at *

private theorem pairWord_mem_radical (i : Fin 4) (t : Fin 2 → CoefficientField m) :
    pairWord m (fun j => ((rootBlocks .positive).roots (.inl (i, j))).val) t ∈
      splitRadical m .suzuki :=
  mul_mem (subset_closure ⟨_, _, positive_pair_radical i 0, rfl⟩)
    (subset_closure ⟨_, _, positive_pair_radical i 1, rfl⟩)

private theorem quartetWord_mem_of_roots (H : Subgroup (SplitGroup m))
    (r : Fin 4 → F4Chevalley.Root) (t : Fin 4 → CoefficientField m)
    (h : ∀ j, rootGeneratorInGroup m (r j) (t j) ∈ H) : quartetWord m r t ∈ H :=
  mul_mem (mul_mem (mul_mem (h 0) (h 1)) (h 2)) (h 3)

/-- The positive fixed subgroup is generated by the complete Suzuki block and
the actual fixed intersection of the prescribed radical. -/
theorem standardUnipotent_le_suzukiBlock_sup_radical (d : LocalBlockInput m) :
    standardUnipotent d ≤ simpleBlock d .suzuki true ⊔ suzukiPanelRadical d := by
  intro x hx
  let B := rootBlocks .positive
  obtain ⟨t, ht⟩ := (wordInSubgroup_bijective m B.order).2 ⟨x.val, hx⟩
  have hw : word m B.order t = x.val := congrArg Subtype.val ht
  let p := B.repack m t
  have htw (z : SplitGroup m) : d.twist z = reeTwist m z :=
    DFunLike.congr_fun d.twist_toMonoidHom_eq z
  have hfixed : blockTwist m p = p := by
    apply B.blockWord_injective m (wordInSubgroup_bijective m B.order)
    rw [← B.twist_blockWord m (mixedRootCommutation m) (b2RootSwap m)]
    change reeTwist m (B.blockWord m (B.repack m t)) = B.blockWord m (B.repack m t)
    rw [← B.word_eq_blockWord, hw, ← htw]
    exact x.property
  have hp (i : Fin 4) : pairTwist m (p.1 i) = p.1 i :=
    congrFun (congrArg Prod.fst hfixed) i
  have hq (i : Fin 4) : quartetTwist m (p.2 i) = p.2 i :=
    congrFun (congrArg Prod.snd hfixed) i
  let a : Fin 4 → d.fixedGroup := fun i =>
    ⟨pairWord m (fun j => (B.roots (.inl (i, j))).val) (p.1 i), by
      exact (htw _).trans ((B.twist_pair m (mixedRootCommutation m) i (p.1 i)).trans
        (congrArg (pairWord m _) (hp i)))⟩
  let b : Fin 4 → d.fixedGroup := fun i =>
    ⟨quartetWord m (fun j => (B.roots (.inr (i, j))).val) (p.2 i), by
      exact (htw _).trans
        ((B.twist_quartet m (mixedRootCommutation m) (b2RootSwap m) i (p.2 i)).trans
          (congrArg (quartetWord m _) (hq i)))⟩
  have ha (i : Fin 4) : a i ∈ suzukiPanelRadical d := pairWord_mem_radical i _
  have hb0 : b 0 ∈ simpleBlock d .suzuki true := by
    change quartetWord m (fun j => (B.roots (.inr ((0 : Fin 4), j))).val) (p.2 (0 : Fin 4)) ∈
      splitSimpleBlock m .suzuki true
    apply quartetWord_mem_of_roots
    intro j
    exact subset_closure ⟨_, _, positive_quartet_zero_simple j, rfl⟩
  have hbs (i : Fin 3) : b i.succ ∈ suzukiPanelRadical d := by
    change quartetWord m (fun j => (B.roots (.inr (i.succ, j))).val) (p.2 i.succ) ∈
      splitRadical m .suzuki
    apply quartetWord_mem_of_roots
    intro j
    exact subset_closure ⟨_, _, positive_quartet_succ_radical i j, rfl⟩
  have he : x = (List.ofFn a).prod * (List.ofFn b).prod := by
    apply Subtype.ext
    change x.val = d.fixedGroup.subtype ((List.ofFn a).prod * (List.ofFn b).prod)
    rw [map_mul, map_list_prod, map_list_prod, List.map_ofFn, List.map_ofFn]
    exact hw.symm.trans (B.word_eq_blockWord m t)
  rw [he]
  apply mul_mem
  · apply list_prod_mem
    intro y hy
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hy
    exact mem_sup_right (ha i)
  · apply list_prod_mem
    intro y hy
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hy
    refine Fin.cases (mem_sup_left hb0) (fun j => mem_sup_right (hbs j)) i

private theorem modelEquiv_map_intersection (d : LocalBlockInput m)
    (H : Subgroup (SplitGroup m)) :
    (H.subgroupOf d.fixedGroup).map d.modelEquiv.toMonoidHom =
      H.comap (toSplitGroup m) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    change toSplitGroup m (d.modelEquiv y) ∈ H
    rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
    exact Subgroup.mem_subgroupOf.mp hy
  · intro hx
    refine ⟨d.modelEquiv.symm x, ?_, d.modelEquiv.apply_symm_apply x⟩
    change (d.modelEquiv.symm x).val ∈ H
    rw [Parabolics.modelEquiv_symm_coe]
    simpa only [Subgroup.mem_comap, toSplitGroup_apply] using hx

/-- Separating the fixed unipotent and torus factors of the root Borel. -/
theorem rootBorel_eq_standardUnipotent_sup_suzukiPanelTorus (d : LocalBlockInput m)
    (hT : splitTorus m = diagonalTorus m) :
    rootBorel d = standardUnipotent d ⊔ suzukiPanelTorus d := by
  apply (Subgroup.map_injective (f := d.modelEquiv.toMonoidHom) d.modelEquiv.injective)
  rw [rootBorel_map_modelEquiv, Subgroup.map_sup]
  change borel m =
    ((splitUnipotent m).subgroupOf d.fixedGroup).map d.modelEquiv.toMonoidHom ⊔
    ((splitTorus m).subgroupOf d.fixedGroup).map d.modelEquiv.toMonoidHom
  rw [modelEquiv_map_intersection, modelEquiv_map_intersection]
  exact borel_eq_unipotent_sup_fixedTorus_of_splitTorus m
    (splitTorus_le_unipotent_normalizer_of_le_diagonalTorus m hT.le)
    (splitTorus_odd_card_of_le_diagonalTorus m hT.le)

/-- The Borel generation input for the Suzuki parabolic coset cover. -/
theorem rootBorel_le_suzukiBlock_sup_radical_sup_torus (d : LocalBlockInput m)
    (hT : splitTorus m = diagonalTorus m) :
    rootBorel d ≤ (simpleBlock d .suzuki true ⊔ suzukiPanelRadical d) ⊔ suzukiPanelTorus d := by
  rw [rootBorel_eq_standardUnipotent_sup_suzukiPanelTorus d hT]
  exact sup_le_sup_right (standardUnipotent_le_suzukiBlock_sup_radical d) _

end ReeF4.LocalBlockInput.PairRigidity.LocalIndices
