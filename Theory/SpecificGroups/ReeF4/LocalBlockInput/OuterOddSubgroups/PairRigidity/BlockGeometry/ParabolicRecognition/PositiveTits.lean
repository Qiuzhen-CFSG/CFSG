/-!
# Both positive Ree block parabolics in the concrete Tits system

The relative simple reflections are exactly the classes of the fixed words
`[0,3]` (linear) and `[1,2,1,2]` (Suzuki). Their proved separation identifies
the two-element side type with the full set of simple generators.

Each singleton standard parabolic is generated by the Borel and its fixed Weyl
word. That word belongs to the join of its signed fixed blocks, and conjugates
the entire negative block into the positive block. Hence adjoining the word
to the root Borel is equivalent to adjoining the negative fixed block, for
both node orbits. This argument descends actual conjugation by a fixed element;
it does not commute fixed intersections with arbitrary joins.

The model equivalence preserves the underlying split matrices. Indeed, the
supplied fixed subgroup equals the model's fixed subgroup, which transports
the Tits system and all subgroup identifications together. The construction
works on the full fixed group for every parameter, without simplicity or an
index hypothesis. The final wrapper retains the positive-parameter consumer's
hypotheses. Identifying the root Borel with the intrinsic unipotent normalizer
remains a separate assertion.

Source: GLS3, Theorems 2.3.4–8 and 2.6.5, Definition 2.6.6,
`refs/KGroup/GLS3/chapter2.tex`.
-/

public section
noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem Subgroup LargeLocalSeeds
open FixedCollection FixedCollection.SeedGeneration
open Parabolics Parabolics.Binary.FixedGeometry SectionGeometry.BNPair
private local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg
attribute [local instance] borel_inf_normalizerWords_normal
variable {m : ℕ}

/-- The fixed relative Weyl word conjugates the complete negative block into
its positive block, on either exceptional node orbit. -/
theorem relativeWeyl_conj_negativeBlock (d : LocalBlockInput m) (s : Side)
    {x : d.fixedGroup} (hx : x ∈ simpleBlock d s false) :
    relativeWeyl d s * x * (relativeWeyl d s)⁻¹ ∈ simpleBlock d s true := by
  have h : splitSimpleBlock m s false ≤ (splitSimpleBlock m s true).comap
      (MulAut.conj (relativeWeyl d s).val).toMonoidHom := by
    apply (closure_le _).mpr
    rintro _ ⟨r, t, hr, rfl⟩
    change (relativeWeyl d s).val * rootGeneratorInGroup m r t *
      (relativeWeyl d s).val⁻¹ ∈ splitSimpleBlock m s true
    rw [relativeWeyl_conj_block_root d s false r t hr]
    exact subset_closure ⟨_, t, (isSimpleBlockRoot_neg_iff s false r).mpr hr, rfl⟩
  exact h hx

/-- The Borel joined with either negative fixed block is generated by the
Borel and the corresponding fixed Weyl word. -/
theorem rootBorel_sup_negativeBlock_eq_sup_relativeWeyl (d : LocalBlockInput m) (s : Side) :
    rootBorel d ⊔ simpleBlock d s false =
      rootBorel d ⊔ zpowers (relativeWeyl d s) := by
  have hpos : simpleBlock d s true ≤ rootBorel d :=
    (simpleBlock_positive_le d s).trans (comap_mono le_sup_left)
  apply le_antisymm
  · apply sup_le le_sup_left
    intro x hx
    let K := rootBorel d ⊔ zpowers (relativeWeyl d s)
    have hw : relativeWeyl d s ∈ K := mem_sup_right (mem_zpowers _)
    have hc : relativeWeyl d s * x * (relativeWeyl d s)⁻¹ ∈ K :=
      mem_sup_left (hpos (relativeWeyl_conj_negativeBlock d s hx))
    have hh := K.mul_mem (K.mul_mem (K.inv_mem hw) hc) hw
    simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using hh
  · exact sup_le le_sup_left (zpowers_le.mpr
      ((sup_le_sup_right hpos _) (relativeWeyl_mem_simpleBlock_sup d s)))

private theorem model_borel_sup_negativeBlock_eq (m : ℕ) (s : Side) :
    borel m ⊔ (splitSimpleBlock m s false).comap (toSplitGroup m) =
      borel m ⊔ zpowers (weylLift m s) := by
  let d := canonicalLocalBlockInput m
  have hb : (simpleBlock d s false).map d.modelEquiv.toMonoidHom =
      (splitSimpleBlock m s false).comap (toSplitGroup m) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      change toSplitGroup m (d.modelEquiv y) ∈ splitSimpleBlock m s false
      rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
      exact hy
    · intro hx
      refine ⟨d.modelEquiv.symm x, ?_, d.modelEquiv.apply_symm_apply x⟩
      change (d.modelEquiv.symm x).val ∈ splitSimpleBlock m s false
      rw [modelEquiv_symm_coe]
      simpa only [mem_comap, toSplitGroup_apply] using hx
  have h := congrArg (fun H : Subgroup d.fixedGroup => H.map d.modelEquiv.toMonoidHom)
    (rootBorel_sup_negativeBlock_eq_sup_relativeWeyl d s)
  simpa only [Subgroup.map_sup, rootBorel_map_modelEquiv, hb, MonoidHom.map_zpowers,
    MulEquiv.coe_toMonoidHom, modelEquiv_relativeWeyl] using h

/-- The two marked sides exhaust the concrete BN-pair's distinct simple generators. -/
@[expose] def modelSimpleEquiv (m : ℕ) : Side ≃ (titsSystem m).S :=
  Equiv.ofBijective (fun s => ⟨simpleReflection m s, simpleReflection_mem m s⟩) (by
    constructor
    · intro s t h
      have he := congrArg Subtype.val h
      have hne := simpleReflection_linear_ne_suzuki_of_separation m
        (weylLift_linear_inv_mul_suzuki_not_mem_borel m)
      cases s <;> cases t
      · rfl
      · exact (hne he.symm).elim
      · exact (hne he).elim
      · rfl
    · rintro ⟨w, s, rfl⟩
      exact ⟨s, rfl⟩)

/-- For both sides, the singleton standard parabolic is exactly the join of
the root Borel and the actual negative fixed block. -/
theorem model_standardParabolic_simpleBlock (m : ℕ) (s : Side) :
    (titsSystem m).standardParabolic {((modelSimpleEquiv m) s).val} =
      borel m ⊔ (splitSimpleBlock m s false).comap (toSplitGroup m) := by
  rw [model_borel_sup_negativeBlock_eq]
  let T := titsSystem m
  change T.standardParabolic {simpleReflection m s} = _
  have hc : weylLift m s ∈ T.bruhatCell (simpleReflection m s) :=
    T.representative_mem_bruhatCell _ (simpleLift m s) rfl
  apply le_antisymm
  · apply T.standardParabolic_le _ le_sup_left
    rintro w (rfl : w = simpleReflection m s)
    exact T.bruhatCell_subset_of_mem _ le_sup_left hc (mem_sup_right (mem_zpowers _))
  · exact sup_le (T.B_le_standardParabolic _)
      (zpowers_le.mpr (T.bruhatCell_subset_standardParabolic_of_mem
        (Set.mem_singleton _) hc))

/-- The concrete rank-two Tits system on any supplied local fixed group,
with both block parabolics identified. This holds on the full fixed group. -/
theorem exists_rootBorel_titsSystem (d : LocalBlockInput m) :
    ∃ T : TitsSystem (X := d.fixedGroup), ∃ e : Side ≃ T.S,
      T.B = rootBorel d ∧
        ∀ s, T.standardParabolic {(e s).val} = rootBorel d ⊔ simpleBlock d s false := by
  unfold rootBorel simpleBlock
  rw [d.fixedGroup_eq_fixedSubgroup]
  have hB : borel m = (splitBorel m).subgroupOf (fixedSubgroup m) := by
    ext x
    simp only [borel, mem_comap, mem_subgroupOf, toSplitGroup_apply]
  have hblock (s : Side) :
      (splitSimpleBlock m s false).comap (toSplitGroup m) =
        (splitSimpleBlock m s false).subgroupOf (fixedSubgroup m) := by
    ext x
    simp only [mem_comap, mem_subgroupOf, toSplitGroup_apply]
  refine ⟨titsSystem m, modelSimpleEquiv m, (titsSystem_B m).trans hB, ?_⟩
  intro s
  rw [model_standardParabolic_simpleBlock, hB, hblock]

/-- The positive-parameter interface for parabolic recognition. The stronger
construction above discharges this contract without using its extra hypotheses. -/
theorem exists_positive_titsSystem (_hm : 1 ≤ m) (d : LocalBlockInput m)
    [IsSimpleGroup d.fixedGroup] [Group.IsPerfect d.fixedGroup]
    (_hindex : Odd (standardUnipotent d).index)
    (_hT : splitTorus m = diagonalTorus m) :
    ∃ T : TitsSystem (X := d.fixedGroup), ∃ e : Side ≃ T.S,
      T.B = rootBorel d ∧
        ∀ s, T.standardParabolic {(e s).val} = rootBorel d ⊔ simpleBlock d s false :=
  exists_rootBorel_titsSystem d

end ReeF4.LocalBlockInput.PairRigidity
