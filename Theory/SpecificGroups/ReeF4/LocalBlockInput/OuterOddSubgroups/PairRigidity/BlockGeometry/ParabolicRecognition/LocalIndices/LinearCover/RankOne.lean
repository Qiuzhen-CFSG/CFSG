module
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.ParabolicRecognition.LocalIndices.Cosets
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.ParabolicRecognition.LocalIndices.Separation
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.OppositionCell.FixedBruhatCover.NormalizerGeometry.RankOneTransport.SimpleConjugation

/-!
# The paired linear Weyl words in the supplied Ree group

The type VI coordinates identify both signed fixed blocks with the additive
coefficient field. Their three-factor rank-one words lie in the actual
parabolic generated by the root Borel and the negative block. Orthogonality
of the two end roots writes each word as the product of its two split Weyl
words. Ratios are literal products of coroot words, hence lie in the root
Borel. The parameter-one word exchanges the two signed blocks; its action
on every split root is the product of the two end reflections.

The root radical and fixed torus are specified independently here for the
remaining Borel-generation and normalization calculations. No Levi model
identification, parabolic index, or coset coverage is assumed.

Source: GLS3, Theorems 2.3.4–8, Table 2.4 type VI, and 2.6.5,
`refs/KGroup/GLS3/chapter2.tex`. The end-root commutation proof follows the
existing calculation in `FieldRecovery/Relations/SuzukiRigidity/TorusGeometry`.
-/

@[expose] public noncomputable section
namespace ReeF4.LocalBlockInput.PairRigidity.LocalIndices
open Subgroup LargeLocalSeeds Parabolics BlockParameters.FieldRecovery
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
private local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg
variable {m : ℕ}

@[simp] theorem linearElement_zero (d : LocalBlockInput m) (p : Bool) :
    linearElement d p 0 = 1 :=
  congrArg Subtype.val ((linearEquiv d p).map_one)

theorem linearElement_self_mul (d : LocalBlockInput m) (p : Bool) (t : CoefficientField m) :
    linearElement d p t * linearElement d p t = 1 := by
  rw [← linearElement_add, CharTwo.add_self_eq_zero, linearElement_zero]

@[simp] theorem linearElement_inv (d : LocalBlockInput m) (p : Bool) (t : CoefficientField m) :
    (linearElement d p t)⁻¹ = linearElement d p t :=
  inv_eq_of_mul_eq_one_right (linearElement_self_mul d p t)

/-- The paired end-node Weyl word, inside the supplied fixed group. -/
def linearPanelWeyl (d : LocalBlockInput m) (t : (CoefficientField m)ˣ) : d.fixedGroup :=
  linearElement d true t * linearElement d false (t⁻¹ : (CoefficientField m)ˣ) *
    linearElement d true t

@[simp] theorem linearPanelWeyl_inv (d : LocalBlockInput m) (t : (CoefficientField m)ˣ) :
    (linearPanelWeyl d t)⁻¹ = linearPanelWeyl d t := by
  simp only [linearPanelWeyl, mul_inv_rev, linearElement_inv, mul_assoc]

theorem linearElement_positive_mem_borel (d : LocalBlockInput m) (t : CoefficientField m) :
    linearElement d true t ∈ rootBorel d :=
  (show standardUnipotent d ≤ rootBorel d from Subgroup.comap_mono le_sup_left)
    (simpleBlock_positive_le d .linear (linearElement_mem d true t))

theorem linearPanelWeyl_mem (d : LocalBlockInput m) (t : (CoefficientField m)ˣ) :
    linearPanelWeyl d t ∈ rootParabolic d .linear :=
  by
  have hp : ∀ a, linearElement d true a ∈ rootParabolic d .linear :=
    fun a => (le_sup_left : rootBorel d ≤ rootParabolic d .linear)
      (linearElement_positive_mem_borel d a)
  exact mul_mem (mul_mem (hp t)
    ((le_sup_right : simpleBlock d .linear false ≤ rootParabolic d .linear)
      (linearElement_mem d false _))) (hp t)

/-- The distinguished extra representative is an actual parabolic element. -/
def linearPanelRepresentative (d : LocalBlockInput m) : rootParabolic d .linear :=
  ⟨linearPanelWeyl d 1, linearPanelWeyl_mem d 1⟩

/-- The prescribed positive root radical, restricted to the supplied fixed group. -/
def linearPanelRadical (d : LocalBlockInput m) : Subgroup d.fixedGroup :=
  (splitRadical m .linear).subgroupOf d.fixedGroup

/-- The coroot-word torus, restricted to the supplied fixed group. -/
def linearPanelTorus (d : LocalBlockInput m) : Subgroup d.fixedGroup :=
  (splitTorus m).subgroupOf d.fixedGroup

theorem linearPanelRadical_le_borel (d : LocalBlockInput m) :
    linearPanelRadical d ≤ rootBorel d :=
  Subgroup.comap_mono ((splitRadical_le_unipotent m .linear).trans le_sup_left)

theorem linearPanelTorus_le_borel (d : LocalBlockInput m) :
    linearPanelTorus d ≤ rootBorel d := Subgroup.comap_mono le_sup_right

private theorem end_commute (p q : Bool) (t u : CoefficientField m) :
    Commute (rootGeneratorInGroup m (signedRoot p (typeF4SimpleRootIndex 0)) t)
      (rootGeneratorInGroup m (signedRoot q (typeF4SimpleRootIndex 3)) u) := by
  have hne : typeF4RootPairing_baseEquiv 0 ≠ typeF4RootPairing_baseEquiv 3 := by
    intro h
    have := typeF4RootPairing_baseEquiv.injective h
    contradiction
  have hc : typeF4RootPairing_base.cartanMatrix
      (typeF4RootPairing_baseEquiv 3) (typeF4RootPairing_baseEquiv 0) = 0 := by
    rw [typeF4RootPairing_base_cartan_apply]
    norm_num [typeF4CartanMatrix, Fin.ext_iff]
  apply Subtype.ext
  cases p <;> cases q
  all_goals
    simp only [signedRoot, Bool.false_eq_true, ↓reduceIte]
    change F4Chevalley.rootCurve _ t * F4Chevalley.rootCurve _ u =
      F4Chevalley.rootCurve _ u * F4Chevalley.rootCurve _ t
    simp only [F4Chevalley.rootCurve, F4Chevalley.integralOperators,
      ← typeF4RootPairing_baseEquiv_val, rootCurveUnit_simple, rootCurveUnit_neg_simple]
  · exact congrArg Subtype.val
      (RootPairing.SimpleGeckGroup.commute_negative_negative_of_cartan_eq_zero _ _ hne hc t u).eq
  · exact congrArg Subtype.val
      (RootPairing.SimpleGeckGroup.commute_positive_negative _ _ hne.symm u t).eq.symm
  · exact congrArg Subtype.val
      (RootPairing.SimpleGeckGroup.commute_positive_negative _ _ hne t u).eq
  · exact congrArg Subtype.val
      (RootPairing.SimpleGeckGroup.commute_positive_positive_of_cartan_eq_zero _ _ hne hc t u).eq

/-- The fixed Weyl word is literally the product of the two split end-node words. -/
theorem linearPanelWeyl_split (d : LocalBlockInput m) (t : (CoefficientField m)ˣ) :
    (linearPanelWeyl d t).val = weylWord m (typeF4SimpleRootIndex 0) t *
      weylWord m (typeF4SimpleRootIndex 3) (rootFieldEnd m (typeF4SimpleRootIndex 0) t) := by
  simp only [linearPanelWeyl, Subgroup.coe_mul, linearElement_positive,
    linearElement_negative, linearSplitWord, weylWord, CharTwo.neg_eq,
    Units.val_inv_eq_inv_val, map_inv₀]
  have h1 := (end_commute false true ((t : CoefficientField m)⁻¹)
    (rootFieldEnd m (typeF4SimpleRootIndex 0) t)).symm
  have h2 := (end_commute true false (t : CoefficientField m)
    ((rootFieldEnd m (typeF4SimpleRootIndex 0) t)⁻¹)).symm
  have h3 := (end_commute true true (t : CoefficientField m)
    (rootFieldEnd m (typeF4SimpleRootIndex 0) t)).symm
  simp only [signedRoot, Bool.false_eq_true, ↓reduceIte] at h1 h2 h3
  simp only [mul_assoc]
  rw [h1.left_comm, h2.left_comm, h3.left_comm]

private theorem root_inv (r : F4Chevalley.Root) (t : CoefficientField m) :
    (rootGeneratorInGroup m r t)⁻¹ = rootGeneratorInGroup m r t :=
  Subtype.ext ((F4Chevalley.rootCurve_inv r t).trans (congrArg _ (CharTwo.neg_eq t)))

private theorem weyl_inv (r : F4Chevalley.Root) (t : CoefficientField m) :
    (weylWord m r t)⁻¹ = weylWord m r t := by
  simp only [weylWord, mul_inv_rev, root_inv, mul_assoc]

private theorem end_root_weyl_commute (p : Bool) (a u : CoefficientField m) :
    Commute (rootGeneratorInGroup m (signedRoot p (typeF4SimpleRootIndex 0)) a)
      (weylWord m (typeF4SimpleRootIndex 3) u) := by
  simpa only [weylWord, signedRoot, Bool.false_eq_true, ↓reduceIte] using
    ((end_commute p true a u).mul_right (end_commute p false a (-u⁻¹))).mul_right
      (end_commute p true a u)

private theorem end_weyl_root_commute (q : Bool) (t a : CoefficientField m) :
    Commute (weylWord m (typeF4SimpleRootIndex 0) t)
      (rootGeneratorInGroup m (signedRoot q (typeF4SimpleRootIndex 3)) a) := by
  simpa only [weylWord, signedRoot, Bool.false_eq_true, ↓reduceIte] using
    ((end_commute true q t a).mul_left (end_commute false q (-t⁻¹) a)).mul_left
      (end_commute true q t a)

private theorem end_weyl_commute (t u : CoefficientField m) :
    Commute (weylWord m (typeF4SimpleRootIndex 0) t)
      (weylWord m (typeF4SimpleRootIndex 3) u) := by
  have h (p : Bool) (a : CoefficientField m) :
      Commute (rootGeneratorInGroup m (signedRoot p (typeF4SimpleRootIndex 0)) a)
        (weylWord m (typeF4SimpleRootIndex 3) u) :=
    ((end_commute p true a u).mul_right (end_commute p false a (-u⁻¹))).mul_right
      (end_commute p true a u)
  exact ((h true t).mul_left (h false (-t⁻¹))).mul_left (h true t)

private theorem weyl_mul_one_mem_torus (r : F4Chevalley.Root) (t : (CoefficientField m)ˣ) :
    weylWord m r t * weylWord m r 1 ∈ splitTorus m := by
  have ht : torusWord m r t ∈ splitTorus m := subset_closure ⟨r, t, rfl⟩
  change weylWord m r t * weylWord m r (-1) ∈ splitTorus m at ht
  simpa only [CharTwo.neg_eq] using ht

/-- All nonzero paired Weyl words differ by a literal coroot-torus element. -/
theorem linearPanelWeyl_ratio_mem_borel (d : LocalBlockInput m) (t : (CoefficientField m)ˣ) :
    (linearPanelWeyl d 1)⁻¹ * linearPanelWeyl d t ∈ rootBorel d := by
  change ((linearPanelWeyl d 1)⁻¹ * linearPanelWeyl d t).val ∈ splitBorel m
  apply (le_sup_right : splitTorus m ≤ splitBorel m)
  have ht : linearPanelWeyl d t * (linearPanelWeyl d 1)⁻¹ ∈
      (splitTorus m).subgroupOf d.fixedGroup := by
    change (linearPanelWeyl d t).val * ((linearPanelWeyl d 1).val)⁻¹ ∈ splitTorus m
    rw [linearPanelWeyl_split, linearPanelWeyl_split]
    simp only [Units.val_one, map_one, mul_inv_rev, weyl_inv]
    have h0 := weyl_mul_one_mem_torus (typeF4SimpleRootIndex 0) t
    have h3 := weyl_mul_one_mem_torus (typeF4SimpleRootIndex 3)
      (Units.map (rootFieldEnd m (typeF4SimpleRootIndex 0)).toMonoidHom t)
    change weylWord m (typeF4SimpleRootIndex 3) (rootFieldEnd m (typeF4SimpleRootIndex 0) t) *
      weylWord m (typeF4SimpleRootIndex 3) 1 ∈ splitTorus m at h3
    have hh := (splitTorus m).mul_mem h0 h3
    convert hh using 1
    rw [← (end_weyl_commute (m := m) 1 1).eq]
    exact (end_weyl_commute 1 _).symm.mul_mul_mul_comm _ _
  have hi := ((splitTorus m).subgroupOf d.fixedGroup).inv_mem ht
  change ((linearPanelWeyl d t * (linearPanelWeyl d 1)⁻¹)⁻¹).val ∈ splitTorus m at hi
  simpa only [mul_inv_rev, inv_inv, linearPanelWeyl_inv] using hi

private theorem simple_weyl_conj (i : Fin 4) (r : F4Chevalley.Root) (t : CoefficientField m) :
    weylWord m (typeF4SimpleRootIndex i) 1 * rootGeneratorInGroup m r t *
      (weylWord m (typeF4SimpleRootIndex i) 1)⁻¹ =
      rootGeneratorInGroup m (typeF4RootPairing.reflectionPerm (typeF4SimpleRootIndex i) r) t := by
  apply Subtype.ext
  have hw : (weylWord m (typeF4SimpleRootIndex i) 1).val =
      ReeF4.WordRelations.titsUnit [typeF4RootPairing_baseEquiv i] := by
    simp [weylWord, ReeF4.WordRelations.titsUnit_cons, ReeF4.WordRelations.titsUnit_nil,
      typeF4RootPairing_baseEquiv_val]
  change (weylWord m (typeF4SimpleRootIndex i) 1).val * F4Chevalley.rootCurve r t *
    ((weylWord m (typeF4SimpleRootIndex i) 1).val)⁻¹ = _
  rw [hw]
  exact PairNormalization.OppositionCell.FixedBruhatCover.NormalizerGeometry.RankOneTransport.simple_conj
    (typeF4RootPairing_baseEquiv i) r t

/-- The paired representative acts on every split root by the two end reflections. -/
theorem linearPanelWeyl_conj_root (d : LocalBlockInput m) (r : F4Chevalley.Root)
    (t : CoefficientField m) :
    (linearPanelWeyl d 1).val * rootGeneratorInGroup m r t * (linearPanelWeyl d 1).val⁻¹ =
      rootGeneratorInGroup m
        (typeF4RootPairing.reflectionPerm (typeF4SimpleRootIndex 0)
          (typeF4RootPairing.reflectionPerm (typeF4SimpleRootIndex 3) r)) t := by
  rw [linearPanelWeyl_split]
  simp only [Units.val_one, map_one]
  calc
    _ = weylWord m (typeF4SimpleRootIndex 0) 1 *
        (weylWord m (typeF4SimpleRootIndex 3) 1 * rootGeneratorInGroup m r t *
          (weylWord m (typeF4SimpleRootIndex 3) 1)⁻¹) *
        (weylWord m (typeF4SimpleRootIndex 0) 1)⁻¹ := by group
    _ = _ := by rw [simple_weyl_conj, simple_weyl_conj]

/-- The distinguished Weyl element exchanges the two full linear parameter groups. -/
theorem linearPanelWeyl_conj_positive (d : LocalBlockInput m) (t : CoefficientField m) :
    linearPanelWeyl d 1 * linearElement d true t * (linearPanelWeyl d 1)⁻¹ =
      linearElement d false t := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, linearPanelWeyl_split,
    linearElement_positive, linearElement_negative, linearSplitWord, Units.val_one, map_one]
  have h0 := simple_weyl_conj 0 (typeF4SimpleRootIndex 0) t
  have h3 := simple_weyl_conj 3 (typeF4SimpleRootIndex 3)
    (rootFieldEnd m (typeF4SimpleRootIndex 0) t)
  change weylWord m (typeF4SimpleRootIndex 0) 1 * rootGeneratorInGroup m (typeF4SimpleRootIndex 0) t *
    (weylWord m (typeF4SimpleRootIndex 0) 1)⁻¹ = rootGeneratorInGroup m (-typeF4SimpleRootIndex 0) t at h0
  change weylWord m (typeF4SimpleRootIndex 3) 1 * rootGeneratorInGroup m (typeF4SimpleRootIndex 3) _ *
    (weylWord m (typeF4SimpleRootIndex 3) 1)⁻¹ = rootGeneratorInGroup m (-typeF4SimpleRootIndex 3) _ at h3
  have hc := end_root_weyl_commute true t 1
  have hd := end_weyl_root_commute false 1 (rootFieldEnd m (typeF4SimpleRootIndex 0) t)
  simp only [signedRoot, Bool.false_eq_true, ↓reduceIte] at hc hd
  calc
    _ = (weylWord m (typeF4SimpleRootIndex 0) 1 * rootGeneratorInGroup m (typeF4SimpleRootIndex 0) t) *
        (weylWord m (typeF4SimpleRootIndex 3) 1 *
          rootGeneratorInGroup m (typeF4SimpleRootIndex 3) (rootFieldEnd m (typeF4SimpleRootIndex 0) t) *
          (weylWord m (typeF4SimpleRootIndex 3) 1)⁻¹) *
          (weylWord m (typeF4SimpleRootIndex 0) 1)⁻¹ := by
      rw [mul_inv_rev]
      simp only [mul_assoc]
      rw [hc.symm.left_comm]
    _ = _ := by
      rw [h3]
      rw [mul_assoc, hd.inv_left.symm.eq, ← mul_assoc, h0]

/-- The inverse root exchange, for the whole negative parameter group. -/
theorem linearPanelWeyl_conj_negative (d : LocalBlockInput m) (t : CoefficientField m) :
    linearPanelWeyl d 1 * linearElement d false t * (linearPanelWeyl d 1)⁻¹ =
      linearElement d true t := by
  calc
    _ = (linearPanelWeyl d 1)⁻¹ *
        (linearPanelWeyl d 1 * linearElement d true t * (linearPanelWeyl d 1)⁻¹) *
        linearPanelWeyl d 1 := by
      rw [linearPanelWeyl_conj_positive, linearPanelWeyl_inv]
    _ = _ := by group

end ReeF4.LocalBlockInput.PairRigidity.LocalIndices
