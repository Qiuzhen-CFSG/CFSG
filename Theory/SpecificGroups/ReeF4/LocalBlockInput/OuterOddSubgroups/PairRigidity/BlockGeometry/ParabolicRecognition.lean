/-!
# Recognition of the fixed Ree parabolics and simple blocks

In a rank-two Tits system the maximal overgroups of the Borel are exactly the
two parabolics generated by a single simple reflection. This follows from the
proved abstract parabolic lattice theorem. The concrete fixed-group Tits system
identifies these parabolics with the joins of the root Borel and each negative
simple block. Coroot realization and the fixed Bruhat normalizer bound identify
the root Borel with the intrinsic positive unipotent normalizer.

The two local indices `q² + 1` and `q + 1` imply distinct parabolic orders by
cancelling the common nonzero Borel order. No full group-order formula is used.
The split root-grading calculation recovers the complete negative simple block
by intersection with its positive parabolic. Explicit Weyl opposition transports
all three assertions to both signs.

The final theorems discharge every geometric premise of the retained reductions.
Maximality and intersection hold for every parameter; the order distinction uses
`1 ≤ m` and the supplied odd unipotent index. Simplicity and perfectness are
unnecessary. These results supply the three geometric inputs to fixed-block
recognition; the automorphism argument remains in its consumer.

Source: GLS3, Theorems 2.3.4–2.3.8, Table 2.4, Theorem 2.6.5 and
Definition 2.6.6, `refs/KGroup/GLS3/chapter2.tex`.
-/

public section
open Subgroup Theory.AlgebraicGroup

private theorem maximal_overgroup_iff (G : Type*) [Group G]
    (T : TitsSystem (X := G)) (P : Subgroup G) :
    IsCoatom P ∧ T.B ≤ P ↔
      ∃ s ∈ T.S, P = T.standardParabolic (T.S \ {s}) := by
  classical
  constructor
  · rintro ⟨hP, hBP⟩
    have hclass := T.subgroup_eq_standardParabolic_simpleIndices P hBP
    have hproper : ¬ T.S ⊆ T.simpleIndices P := by
      intro hS
      have he := Set.Subset.antisymm (T.simpleIndices_subset P) hS
      exact hP.ne_top (hclass.trans (by rw [he, T.standardParabolic_S]))
    obtain ⟨s, hs, hsP⟩ := Set.not_subset.mp hproper
    refine ⟨s, hs, ?_⟩
    have hle : P ≤ T.standardParabolic (T.S \ {s}) := by
      rw [hclass]
      apply T.standardParabolic_mono
      intro t ht
      exact ⟨T.simpleIndices_subset P ht, fun hts => hsP (hts ▸ ht)⟩
    exact ((hP.le_iff_eq (T.standardParabolic_isCoatom hs).ne_top).mp hle).symm
  · rintro ⟨s, hs, rfl⟩
    exact ⟨T.standardParabolic_isCoatom hs, T.B_le_standardParabolic _⟩

open ReeF4.LargeLocalSeeds

private def otherSide : Side → Side
  | .suzuki => .linear
  | .linear => .suzuki

private theorem otherSide_otherSide (s : Side) : otherSide (otherSide s) = s := by
  cases s <;> rfl

private theorem complement_simple {α : Type*} {S : Set α}
    (e : Side ≃ S) (s : Side) :
    S \ {(e s).val} = {(e (otherSide s)).val} := by
  classical
  have hinj : Function.Injective (fun s => (e s).val) :=
    fun _ _ h => e.injective (Subtype.ext h)
  have hmem (t : Side) (x : α) :
      x ∈ S \ {(e t).val} ↔
        ∃ u : Side, u ≠ t ∧ x = (e u).val := by
    constructor
    · rintro ⟨hx, hxt⟩
      obtain ⟨u, hu⟩ := e.surjective ⟨x, hx⟩
      have huv : (e u).val = x := congrArg Subtype.val hu
      exact ⟨u, fun hut => hxt (huv.symm.trans
        (congrArg (fun v => (e v).val) hut)), huv.symm⟩
    · rintro ⟨u, hut, rfl⟩
      exact ⟨(e u).property, fun h => hut (hinj h)⟩
  cases s
  · apply Set.ext
    intro x
    rw [hmem]
    constructor
    · rintro ⟨u, hu, hxu⟩
      cases u
      · exact False.elim (hu rfl)
      · exact hxu
    · intro hx
      exact ⟨.linear, by decide, hx⟩
  · apply Set.ext
    intro x
    rw [hmem]
    constructor
    · rintro ⟨u, hu, hxu⟩
      cases u
      · exact hxu
      · exact False.elim (hu rfl)
    · intro hx
      exact ⟨.suzuki, by decide, hx⟩

private theorem rankTwo_maximal_overgroups {G : Type*} [Group G]
    (T : TitsSystem (X := G)) (e : Side ≃ T.S) (P : Subgroup G) :
    IsCoatom P ∧ T.B ≤ P ↔
      ∃ s, P = T.standardParabolic {(e s).val} := by
  rw [maximal_overgroup_iff]
  constructor
  · rintro ⟨r, hr, hP⟩
    obtain ⟨s, hs⟩ := e.surjective ⟨r, hr⟩
    have he : (e s).val = r := congrArg Subtype.val hs
    refine ⟨otherSide s, ?_⟩
    rw [← he, complement_simple e s] at hP
    exact hP
  · rintro ⟨s, rfl⟩
    exact ⟨(e (otherSide s)).val, (e (otherSide s)).property, by
      rw [complement_simple e, otherSide_otherSide]⟩

namespace ReeF4.LocalBlockInput.PairRigidity
variable {m : ℕ}

/-- A rank-two Tits system with the genuine subgroup identifications proves
maximality and exhaustion for both signs. The Tits system and both subgroup
identifications are explicit inputs to this reduction. -/
theorem maximal_overgroups_of_positive_tits (d : LocalBlockInput m)
    (T : TitsSystem (X := d.fixedGroup)) (e : Side ≃ T.S)
    (hB : T.B = signedBorelNormalizer d true)
    (hP : ∀ s, T.standardParabolic {(e s).val} = signedParabolic d s true)
    (positive : Bool) (P : Subgroup d.fixedGroup) :
    IsCoatom P ∧ signedBorelNormalizer d positive ≤ P ↔
      ∃ s, P = signedParabolic d s positive := by
  apply maximal_overgroups_of_positive d _ positive P
  intro K
  simpa only [hB, hP] using rankTwo_maximal_overgroups T e K

/-- The two rank-one Borel indices distinguish the parabolic orders.
Their concrete coset calculations are explicit hypotheses of this reduction. -/
theorem parabolic_card_ne_of_local_indices (d : LocalBlockInput m) (positive : Bool)
    (hSuzuki : (signedBorelNormalizer d positive).relIndex
      (signedParabolic d .suzuki positive) = (2 ^ (2 * m + 1)) ^ 2 + 1)
    (hLinear : (signedBorelNormalizer d positive).relIndex
      (signedParabolic d .linear positive) = 2 ^ (2 * m + 1) + 1) :
    Nat.card (signedParabolic d .suzuki positive) ≠
      Nat.card (signedParabolic d .linear positive) := by
  have hcard (s : Side) : Nat.card (signedBorelNormalizer d positive) *
      (signedBorelNormalizer d positive).relIndex (signedParabolic d s positive) =
      Nat.card (signedParabolic d s positive) := by
    have hle : signedBorelNormalizer d positive ≤ signedParabolic d s positive := le_sup_left
    have h := ((signedBorelNormalizer d positive).subgroupOf
      (signedParabolic d s positive)).card_mul_index
    rwa [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv] at h
  intro he
  rw [← hcard .suzuki, ← hcard .linear, hSuzuki, hLinear] at he
  have hq : 1 < 2 ^ (2 * m + 1) := Nat.one_lt_pow (by omega) (by omega)
  have hind := Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := signedBorelNormalizer d positive)) he
  nlinarith

/-- Only the positive local indices need a separate calculation: opposition
supplies the cardinal distinction for the negative parabolics as well. -/
theorem parabolic_card_ne_of_positive_local_indices (d : LocalBlockInput m)
    (hSuzuki : (signedBorelNormalizer d true).relIndex
      (signedParabolic d .suzuki true) = (2 ^ (2 * m + 1)) ^ 2 + 1)
    (hLinear : (signedBorelNormalizer d true).relIndex
      (signedParabolic d .linear true) = 2 ^ (2 * m + 1) + 1)
    (positive : Bool) :
    Nat.card (signedParabolic d .suzuki positive) ≠
      Nat.card (signedParabolic d .linear positive) :=
  signedParabolic_card_ne_of_positive d
    (parabolic_card_ne_of_local_indices d true hSuzuki hLinear) positive

/-- The intrinsic positive unipotent normalizer is the actual fixed root Borel.
Both the coroot comparison and the fixed-group normalizer bound are discharged. -/
theorem signedBorelNormalizer_eq_rootBorel (d : LocalBlockInput m) :
    signedBorelNormalizer d true = rootBorel d :=
  signedBorelNormalizer_eq_rootBorel_of_splitTorus_and_bound d
    (Parabolics.splitTorus_eq_diagonalTorus m).le
    (Parabolics.Overlap.unipotent_normalizer_le_borel m
      (Parabolics.splitTorus_eq_diagonalTorus m))

/-- The intrinsic positive parabolic is the corresponding root-defined join. -/
theorem signedParabolic_positive_eq_rootBorel_sup_simpleBlock (d : LocalBlockInput m)
    (s : Side) :
    signedParabolic d s true = rootBorel d ⊔ simpleBlock d s false := by
  rw [signedParabolic, signedBorelNormalizer_eq_rootBorel, Bool.not_true]

/-- For either sign, the two signed parabolics are precisely the maximal
overgroups of the intrinsic unipotent normalizer. -/
theorem signedParabolic_maximal_overgroups (d : LocalBlockInput m)
    (positive : Bool) (P : Subgroup d.fixedGroup) :
    IsCoatom P ∧ signedBorelNormalizer d positive ≤ P ↔
      ∃ s, P = signedParabolic d s positive := by
  obtain ⟨T, e, hB, hP⟩ := exists_rootBorel_titsSystem d
  apply maximal_overgroups_of_positive_tits d T e
    (hB.trans (signedBorelNormalizer_eq_rootBorel d).symm) _ positive P
  intro s
  exact (hP s).trans (signedParabolic_positive_eq_rootBorel_sup_simpleBlock d s).symm

/-- The Suzuki and linear parabolics have distinct orders for either sign,
using their proved Borel indices `q² + 1` and `q + 1`. -/
theorem signedParabolic_card_ne (hm : 1 ≤ m) (d : LocalBlockInput m)
    (hindex : Odd (standardUnipotent d).index) (positive : Bool) :
    Nat.card (signedParabolic d .suzuki positive) ≠
      Nat.card (signedParabolic d .linear positive) := by
  apply parabolic_card_ne_of_positive_local_indices d _ _ positive
  · rw [signedParabolic_positive_eq_rootBorel_sup_simpleBlock,
      signedBorelNormalizer_eq_rootBorel]
    exact LocalIndices.suzuki_relIndex hm d hindex (Parabolics.splitTorus_eq_diagonalTorus m)
  · rw [signedParabolic_positive_eq_rootBorel_sup_simpleBlock,
      signedBorelNormalizer_eq_rootBorel]
    exact LocalIndices.linear_relIndex d hindex (Parabolics.splitTorus_eq_diagonalTorus m)

/-- Intersecting either unipotent subgroup with the opposite parabolic recovers
the entire simple block, including the nonsimple roots on the Suzuki side. -/
theorem signedUnipotent_inf_opposite_signedParabolic (d : LocalBlockInput m)
    (s : Side) (positive : Bool) :
    signedUnipotent d positive ⊓ signedParabolic d s (!positive) =
      simpleBlock d s positive := by
  apply opposite_parabolic_inf_of_negative d _ s positive
  intro t
  rw [signedParabolic_positive_eq_rootBorel_sup_simpleBlock]
  exact oppositeUnipotent_inf_rootBorel_sup_simpleBlock d
    (Parabolics.splitTorus_eq_diagonalTorus m) t

end ReeF4.LocalBlockInput.PairRigidity
end
