module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.FieldAction
public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.FixedGeometry.PositiveTwoGroup

/-!
# The standard opposite unipotent pair in a supplied Ree group

The positive subgroup is the existing root-generated fixed intersection.
The opposite subgroup uses all negative roots of the same F₄ base, then
intersects with the same supplied fixed group. Frobenius preserves both.

Once the positive subgroup has odd index, its proved two-group property
makes it Sylow. Sylow conjugacy then adjusts any automorphism by an inner
automorphism to preserve this positive subgroup. Simultaneous preservation
of the opposite subgroup, and rigidity of automorphisms preserving the pair,
are separate proof obligations.

Source: the standard root subgroups in GLS3, §§2.3–2.5, leading to
Steinberg's automorphism theorem 2.5.1 and its refinement 2.5.12.
-/

@[expose] public section
namespace ReeF4.LocalBlockInput
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem Subgroup
variable {m : ℕ}

/-- The split subgroup generated by every negative root curve. Here a root
is negative precisely when it is not positive in the fixed F₄ base. -/
noncomputable def splitNegativeUnipotent (m : ℕ) : Subgroup (SplitGroup m) :=
  closure {x | ∃ (r : F4Chevalley.Root) (t : CoefficientField m),
    ¬ typeF4RootPairing_base.IsPos r ∧ x = rootGeneratorInGroup m r t}

/-- The negative root subgroup intersected with the supplied twist-fixed group. -/
noncomputable def oppositeUnipotent (d : LocalBlockInput m) :
    Subgroup d.fixedGroup := (splitNegativeUnipotent m).subgroupOf d.fixedGroup

/-- Setwise preservation of each of the two specified, actual fixed subgroups. -/
def PreservesUnipotentPair (d : LocalBlockInput m) (a : MulAut d.fixedGroup) : Prop :=
  (LargeLocalSeeds.standardUnipotent d).map a.toMonoidHom =
    LargeLocalSeeds.standardUnipotent d ∧
  (oppositeUnipotent d).map a.toMonoidHom = oppositeUnipotent d

private theorem map_eq_self_of_mem {G : Type*} [Group G] [Finite G]
    (a : MulAut G) (H : Subgroup G) (h : ∀ x ∈ H, a x ∈ H) :
    H.map a.toMonoidHom = H := by
  let f : H →* H := (a.toMonoidHom.comp H.subtype).codRestrict H (fun x => h x x.property)
  have hf : Function.Injective f := fun x y hxy =>
    Subtype.ext (a.injective (congrArg Subtype.val hxy))
  have hs := Finite.injective_iff_bijective.mp hf |>.surjective
  apply le_antisymm
  · rintro x ⟨y, hy, rfl⟩
    exact h y hy
  · intro x hx
    obtain ⟨y, hy⟩ := hs ⟨x, hx⟩
    exact ⟨y, y.property, congrArg Subtype.val hy⟩

private theorem frobenius_mem_root_closure (P : F4Chevalley.Root → Prop)
    {x : SplitGroup m}
    (hx : x ∈ closure {x | ∃ (r : F4Chevalley.Root) (t : CoefficientField m),
      P r ∧ x = rootGeneratorInGroup m r t}) :
    splitFrobenius m x ∈ closure {x | ∃ (r : F4Chevalley.Root) (t : CoefficientField m),
      P r ∧ x = rootGeneratorInGroup m r t} := by
  let H := closure {x | ∃ (r : F4Chevalley.Root) (t : CoefficientField m),
      P r ∧ x = rootGeneratorInGroup m r t}
  have hH : H ≤ H.comap (splitFrobenius m) := by
    apply (closure_le _).mpr
    rintro y ⟨r, t, hr, rfl⟩
    change splitFrobenius m (rootGeneratorInGroup m r t) ∈ H
    rw [splitFrobenius_rootGenerator]
    exact subset_closure ⟨r, t ^ 2, hr, rfl⟩
  exact hH hx

/-- Entrywise Frobenius preserves both members of the standard pair. -/
theorem fieldAutomorphism_preservesUnipotentPair (d : LocalBlockInput m) :
    PreservesUnipotentPair d d.fieldAutomorphism := by
  constructor
  · apply map_eq_self_of_mem
    intro x hx
    exact frobenius_mem_root_closure typeF4RootPairing_base.IsPos hx
  · apply map_eq_self_of_mem
    intro x hx
    exact frobenius_mem_root_closure (fun r => ¬ typeF4RootPairing_base.IsPos r) hx

private theorem inner_adjustment_of_sylow {G : Type*} [Group G] [Finite G]
    (U : Sylow 2 G) (a : MulAut G) :
    ∃ g : G, (U : Subgroup G).map ((MulAut.conj g)⁻¹ * a).toMonoidHom = U := by
  let V := U.mapSurjective (f := a.toMonoidHom) a.surjective
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G V U
  have h : ((U : Subgroup G).map a.toMonoidHom).map (MulAut.conj g).toMonoidHom = U :=
    congrArg Sylow.toSubgroup hg
  refine ⟨g⁻¹, ?_⟩
  rw [map_inv, inv_inv]
  change (U : Subgroup G).map ((MulAut.conj g).toMonoidHom.comp a.toMonoidHom) = U
  rw [← Subgroup.map_map]
  exact h

/-- Sylow conjugacy gives the first normalization. The odd index is an explicit
input; preserving the opposite subgroup as well requires further geometry. -/
theorem exists_inner_adjustment_preserving_unipotent_of_odd_index
    (d : LocalBlockInput m) (hindex : Odd (LargeLocalSeeds.standardUnipotent d).index)
    (a : MulAut d.fixedGroup) :
    ∃ g : d.fixedGroup,
      (LargeLocalSeeds.standardUnipotent d).map ((MulAut.conj g)⁻¹ * a).toMonoidHom =
        LargeLocalSeeds.standardUnipotent d :=
  inner_adjustment_of_sylow
    ((LargeLocalSeeds.standardUnipotent_isPGroup d).toSylow hindex.not_two_dvd_nat) a

end ReeF4.LocalBlockInput
end

