module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.RootPair
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.OppositionCell.RootTransport
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.Disjoint

/-!
# Split normal-form factors for a supplied Ree twist

The prospective normalizer is generated by the actual rank-one words
`x_r(t) x_{-r}(-t⁻¹) x_r(t)` for nonzero parameters. In particular, it retains
torus words over every coefficient field. Its definition assumes neither a
normal form nor root transport. The exceptional twist preserves this subgroup
by its defining root equations.

The right factor at `n` is `U ∩ n⁻¹U⁻n`, using left conjugation. The proved
disjointness of the positive and negative split root closures makes the two
outer factors unique when `n` is specified. Hence a fixed product with fixed
middle factor has fixed outer factors. These statements work directly with
any `LocalBlockInput`, without comparison to `Model` or a simplicity premise.

Source: GLS3 1.11.5, 1.12.1, and 2.3.4–5 in
`refs/KGroup/GLS3/Chapter1.tex` and `refs/KGroup/GLS3/chapter2.tex`.
-/

@[expose] public section

open Subgroup
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem

namespace ReeF4.LocalBlockInput.PairNormalization.OppositionCell.FixedBruhatCover
open LargeLocalSeeds

noncomputable section
local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg

/-- A nonzero-parameter rank-one word in the actual split matrix group. -/
def rankOneRepresentative (m : ℕ) (r : F4Chevalley.Root)
    (t : (CoefficientField m)ˣ) : SplitGroup m :=
  rootGeneratorInGroup m r t * rootGeneratorInGroup m (-r) (-(t⁻¹ : (CoefficientField m)ˣ)) *
    rootGeneratorInGroup m r t

/-- All nonzero rank-one words generate the prospective split normalizer.
This definition retains the torus factors, and assumes no Bruhat assertion. -/
def splitNormalizerWords (m : ℕ) : Subgroup (SplitGroup m) :=
  closure {n | ∃ r t, n = rankOneRepresentative m r t}

/-- Each specified rank-one matrix belongs to the normalizer-word subgroup. -/
theorem rankOneRepresentative_mem (m : ℕ) (r : F4Chevalley.Root)
    (t : (CoefficientField m)ˣ) : rankOneRepresentative m r t ∈ splitNormalizerWords m :=
  subset_closure ⟨r, t, rfl⟩

/-- The coroot words in the convention of GLS3 1.12.1 are retained. -/
theorem corootWord_mem (m : ℕ) (r : F4Chevalley.Root) (t : (CoefficientField m)ˣ) :
    (rankOneRepresentative m r 1)⁻¹ * rankOneRepresentative m r t ∈
      splitNormalizerWords m :=
  (splitNormalizerWords m).mul_mem
    ((splitNormalizerWords m).inv_mem (rankOneRepresentative_mem m r 1))
    (rankOneRepresentative_mem m r t)

private def rootFieldEnd (m : ℕ) (r : F4Chevalley.Root) :
    CoefficientField m →+* CoefficientField m := by
  classical
  exact if IsLongRoot r then iterateFrobenius (CoefficientField m) 2 m else titsEnd m

private theorem rootFieldEnd_apply (m : ℕ) (r : F4Chevalley.Root)
    (t : CoefficientField m) :
    rootFieldEnd m r t = exceptionalParameter r (t ^ (2 ^ m)) := by
  classical
  by_cases hr : IsLongRoot r
  · simp [rootFieldEnd, hr, exceptionalParameter_of_long hr, iterateFrobenius_def]
  · simp only [rootFieldEnd, if_neg hr, exceptionalParameter_of_short hr, titsEnd_apply]
    rw [← pow_mul, ← pow_succ]

private theorem rootFieldEnd_neg (m : ℕ) (r : F4Chevalley.Root) :
    rootFieldEnd m (-r) = rootFieldEnd m r := by
  classical
  simp only [rootFieldEnd, isLongRoot_neg_iff]

private theorem twist_rankOneRepresentative {m : ℕ} (d : LocalBlockInput m)
    (r : F4Chevalley.Root) (t : (CoefficientField m)ˣ) :
    d.twist (rankOneRepresentative m r t) =
      rankOneRepresentative m (exceptionalRootPermutation r)
        (Units.map (rootFieldEnd m r) t) := by
  simp only [rankOneRepresentative, map_mul, d.twist_root, ← rootFieldEnd_apply,
    rootFieldEnd_neg, exceptionalRootPermutation_neg, map_neg, map_inv₀,
    Units.val_inv_eq_inv_val, Units.coe_map]
  rfl

/-- The supplied exceptional twist preserves all normalizer words. -/
theorem twist_mem_splitNormalizerWords {m : ℕ} (d : LocalBlockInput m)
    {n : SplitGroup m} (hn : n ∈ splitNormalizerWords m) :
    d.twist n ∈ splitNormalizerWords m := by
  induction hn using Subgroup.closure_induction with
  | mem n hn =>
    obtain ⟨r, t, rfl⟩ := hn
    rw [twist_rankOneRepresentative]
    exact rankOneRepresentative_mem _ _ _
  | one => simpa only [map_one] using (splitNormalizerWords m).one_mem
  | mul x y _ _ hx hy =>
    simpa only [map_mul] using (splitNormalizerWords m).mul_mem hx hy
  | inv x _ hx => simpa only [map_inv] using (splitNormalizerWords m).inv_mem hx

/-- Twist stability of the positive split root closure. -/
theorem twist_mem_splitUnipotent {m : ℕ} (d : LocalBlockInput m)
    {u : SplitGroup m} (hu : u ∈ splitUnipotent m) : d.twist u ∈ splitUnipotent m := by
  have h := mem_map_of_mem d.twist.toMonoidHom hu
  rw [splitUnipotent_twist] at h
  exact h

/-- Twist stability of the negative split root closure. -/
theorem twist_mem_splitNegativeUnipotent {m : ℕ} (d : LocalBlockInput m)
    {v : SplitGroup m} (hv : v ∈ splitNegativeUnipotent m) :
    d.twist v ∈ splitNegativeUnipotent m := by
  induction hv using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨r, t, hr, rfl⟩ := hx
    rw [d.twist_root]
    apply Subgroup.subset_closure
    refine ⟨_, _, ?_, rfl⟩
    exact fun h => hr ((((typeF4RootPairing.isPositiveRootDuality_iff
      typeF4RootPairing_base exceptionalRootPermutation).mp
        exceptionalRootPermutation_spec).2.1 r).mpr h)
  | one => simpa only [map_one] using (splitNegativeUnipotent m).one_mem
  | mul x y _ _ hx hy =>
    simpa only [map_mul] using (splitNegativeUnipotent m).mul_mem hx hy
  | inv x _ hx => simpa only [map_inv] using (splitNegativeUnipotent m).inv_mem hx

/-- The right inversion factor with the explicit left-conjugation convention. -/
def rightUnipotent {m : ℕ} (n : SplitGroup m) : Subgroup (SplitGroup m) :=
  splitUnipotent m ⊓ (splitNegativeUnipotent m).comap (MulAut.conj n).toMonoidHom

theorem mem_rightUnipotent {m : ℕ} (n v : SplitGroup m) :
    v ∈ rightUnipotent n ↔
      v ∈ splitUnipotent m ∧ n * v * n⁻¹ ∈ splitNegativeUnipotent m := Iff.rfl

/-- Twisting an inversion factor also twists its indexing representative. -/
theorem twist_mem_rightUnipotent {m : ℕ} (d : LocalBlockInput m)
    {n v : SplitGroup m} (hv : v ∈ rightUnipotent n) :
    d.twist v ∈ rightUnipotent (d.twist n) := by
  rw [mem_rightUnipotent] at hv ⊢
  refine ⟨twist_mem_splitUnipotent d hv.1, ?_⟩
  simpa only [map_mul, map_inv] using twist_mem_splitNegativeUnipotent d hv.2

private theorem factors_unique_of_disjoint {G : Type*} [Group G]
    {U V : Subgroup G} (hUV : Disjoint U V)
    {a b c d : G} (ha : a ∈ U) (hb : b ∈ V) (hc : c ∈ U) (hd : d ∈ V)
    (he : a * b = c * d) : a = c ∧ b = d := by
  have h : c⁻¹ * a = d * b⁻¹ := by
    calc
      c⁻¹ * a = c⁻¹ * (a * b) * b⁻¹ := by group
      _ = d * b⁻¹ := by rw [he]; group
  have hzero : c⁻¹ * a = 1 := (Subgroup.disjoint_def.mp hUV)
    (U.mul_mem (U.inv_mem hc) ha) (h ▸ V.mul_mem hd (V.inv_mem hb))
  have hac : a = c := (inv_mul_eq_one.mp hzero).symm
  exact ⟨hac, mul_left_cancel (hac ▸ he)⟩

/-- The outer factors are unique once the middle matrix is specified. -/
theorem unipotent_factors_unique {m : ℕ} {n u v u' v' : SplitGroup m}
    (hu : u ∈ splitUnipotent m) (hv : v ∈ rightUnipotent n)
    (hu' : u' ∈ splitUnipotent m) (hv' : v' ∈ rightUnipotent n)
    (he : u * n * v = u' * n * v') : u = u' ∧ v = v' := by
  have h := factors_unique_of_disjoint (splitUnipotent_disjoint_negative m)
    hu ((mem_rightUnipotent n v).mp hv).2
    hu' ((mem_rightUnipotent n v').mp hv').2
    (show u * (n * v * n⁻¹) = u' * (n * v' * n⁻¹) by
      simpa only [mul_assoc] using congrArg (fun x => x * n⁻¹) he)
  exact ⟨h.1, mul_left_cancel (mul_right_cancel h.2)⟩

/-- A fixed product with fixed middle matrix has fixed outer factors. -/
theorem fixed_unipotent_factors {m : ℕ} (d : LocalBlockInput m)
    {g n u v : SplitGroup m} (hg : d.twist g = g) (hn : d.twist n = n)
    (hu : u ∈ splitUnipotent m) (hv : v ∈ rightUnipotent n)
    (he : g = u * n * v) : d.twist u = u ∧ d.twist v = v := by
  apply unipotent_factors_unique (twist_mem_splitUnipotent d hu)
    (show d.twist v ∈ rightUnipotent n from hn ▸ twist_mem_rightUnipotent d hv) hu hv
  calc
    d.twist u * n * d.twist v = d.twist (u * n * v) := by rw [map_mul, map_mul, hn]
    _ = u * n * v := by rw [← he, hg]

end
end ReeF4.LocalBlockInput.PairNormalization.OppositionCell.FixedBruhatCover
