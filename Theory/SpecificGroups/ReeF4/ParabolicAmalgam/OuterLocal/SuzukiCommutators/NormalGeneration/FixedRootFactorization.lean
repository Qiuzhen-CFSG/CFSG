module

public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.OuterLocal.SuzukiCommutators.NormalGeneration.FixedRootFactorization.Reduction
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.OuterLocal.SuzukiCommutators.NormalGeneration.FixedRootFactorization.RootAlignment
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.OuterLocal.SuzukiCommutators.NormalGeneration.FixedRootFactorization.B2MainProduct
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.RadicalOrders.FixedCoordinates.MatrixRelations

/-!
# Fixed-root factorization for the Suzuki-side Ree radical

The concrete root layouts and matrix relations prove that all eight main
and central word families are fixed and lie in the Suzuki seed. The B₂
product at first parameter 1 expresses every central parameter as a product
of main parameters.

Unique split coordinates force each block of a fixed radical element to be
fixed separately. Its four pair blocks and three B₂ blocks therefore factor
into the seven main curves and their central parameters. Eliminating the
central parameters proves generation by the seven main curves. Only the
explicitly supplied split-coordinate bijectivity remains a premise; the
geometric matching, fixed equations and matrix identities are discharged.
These calculations hold for every `m`, including all source cases `1 ≤ m`.

The local-input versions apply in particular to `canonicalLocalBlockInput m`:
every local input has the same concrete Ree twist. They supply `hroot`,
`hcentral` and `hgen` of `radical_le_normalClosure_of_root_words` without
assuming normal generation, perfectness or radical commutator inclusion.

Source: GLS3 2.3.7 and Table 2.4; Aschbacher–Smith F.1.12(II)(i),
printed pp.263–264 of `refs/quasithin.pdf`.
-/

public section
noncomputable section

namespace ReeF4.Parabolics.OuterLocal.SuzukiCommutators.NormalGeneration
open LargeLocalSeeds RadicalCoordinates RadicalCoordinates.FixedCoordinates Subgroup

/-- The actual B₂ main-curve product from GLS3 Table 2.4, with all geometric
and matrix premises discharged. -/
theorem mainParameterProduct (m : ℕ) : MainParameterProduct m :=
  mainParameterProduct_of_block_relations m positiveRootWordLayout
    (mixedRootCommutation m) (b2RootSwap m)

/-- Every main word is fixed and belongs to the Suzuki seed, including the
middle Levi block at index zero. -/
theorem rootWord_fixed_mem_seed {m : ℕ} (d : LocalBlockInput m)
    (i : Fin 8) (t : CoefficientField m) :
    d.twist (rootWord m i t) = rootWord m i t ∧
      rootWord m i t ∈ splitSeed m .suzuki :=
  (words_fixed_mem_seed_of_blocks d positiveRootWordLayout
    positiveRootWordLayout.positive_covers (mixedRootCommutation m) (b2RootSwap m) i t).1

/-- Every central word is fixed and belongs to the Suzuki seed. At odd
indices it agrees with the corresponding main word. -/
theorem centralWord_fixed_mem_seed {m : ℕ} (d : LocalBlockInput m)
    (i : Fin 8) (t : CoefficientField m) :
    d.twist (centralWord m i t) = centralWord m i t ∧
      centralWord m i t ∈ splitSeed m .suzuki :=
  (words_fixed_mem_seed_of_blocks d positiveRootWordLayout
    positiveRootWordLayout.positive_covers (mixedRootCommutation m) (b2RootSwap m) i t).2

/-- Each radical B₂ central parameter is generated by its main curve, via
`centralWord(u) = rootWord(1+u)⁻¹ * (rootWord(1) * rootWord(u))`. -/
theorem centralWord_mem_closure (m : ℕ) (i : Fin 8) (hi : i ≠ 0)
    (he : i.val % 2 = 0) (u : CoefficientField m) :
    centralWord m i u ∈ closure {z | ∃ i : Fin 8, i ≠ 0 ∧
      ∃ t : CoefficientField m, z = rootWord m i t} :=
  centralWord_mem_closure_of_product m (mainParameterProduct m) i hi he u

/-- A fixed Suzuki radical element is an actual product of four pair words
and three main/central B₂ words. Split-coordinate bijectivity is the only
external premise. No subgroup-order comparison is used. -/
theorem fixed_radical_factorization (m : ℕ)
    (hsplit : ∀ e : RootOrder (.radical .suzuki), Function.Bijective (wordInSubgroup m e))
    (z : SplitGroup m) (hz : z ∈ splitRadical m .suzuki) (hf : reeTwist m z = z) :
    ∃ (a : Fin 4 → CoefficientField m) (b c : Fin 3 → CoefficientField m),
      z = (List.ofFn fun j => rootWord m (radicalRootWordLayout.pairIndex j) (a j)).prod *
        (List.ofFn fun j => rootWord m (radicalRootWordLayout.quartetIndex j) (b j) *
          centralWord m (radicalRootWordLayout.quartetIndex j) (c j)).prod :=
  fixed_radical_factorization_of_blocks m radicalRootWordLayout
    (mixedRootCommutation m) (b2RootSwap m) hsplit z hz hf

/-- The seven main curves generate every fixed element of the Suzuki
radical. For the canonical local input this discharges the factorization
premise of the normal-generation argument, conditional only on the split
coordinate theorem supplied by its assembly owner. -/
theorem fixed_radical_mem_closure {m : ℕ} (d : LocalBlockInput m)
    (hsplit : ∀ e : RootOrder (.radical .suzuki), Function.Bijective (wordInSubgroup m e))
    (z : SplitGroup m) (hz : z ∈ splitRadical m .suzuki) (hf : d.twist z = z) :
    z ∈ closure {z | ∃ i : Fin 8, i ≠ 0 ∧
      ∃ t : CoefficientField m, z = rootWord m i t} :=
  fixed_radical_mem_closure_of_block_inputs d radicalRootWordLayout
    radicalRootWordLayout.pairIndex_ne_zero radicalRootWordLayout.radical_quartetIndex_ne_zero
    (mixedRootCommutation m) (b2RootSwap m) (mainParameterProduct m) hsplit z hz hf

end ReeF4.Parabolics.OuterLocal.SuzukiCommutators.NormalGeneration
