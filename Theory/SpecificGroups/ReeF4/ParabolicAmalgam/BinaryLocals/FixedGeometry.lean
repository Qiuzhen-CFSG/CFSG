module

public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.WeylLifts
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.BruhatCoverage
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.WeylSeparation
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.LocalStructure

/-!
# Binary Ree geometry from fixed-point Bruhat factors

At q=2 the torus is trivial and the Borel is the positive subgroup `U`.
The two fixed Weyl representatives constructed in `WeylLifts` lie in the
marked seeds. A decomposition `g = u n v`, with `u,v ∈ U` and `n` in the
subgroup generated by these representatives, therefore proves seed generation.

The root-coordinate separation theorem makes every Weyl representative
normalizing `U` the identity. The same decomposition therefore makes `U`
self-normalizing. The action of the proved two-group `U` on its cosets then
has exactly one fixed coset, so its index is odd. This avoids a group-order
calculation and applies to the full nonsimple group `Model 0`.

`BruhatCoverage` proves the fixed-point decomposition by descending unique
split normal forms; `WeylSeparation` proves the required separation using
positive matrix coordinates. The final three theorems discharge the premises
of the conditional assembly and establish self-normalization, odd index and
fixed-seed generation at the binary endpoint of Aschbacher–Smith F.1.12(I)(5).
Source: `refs/quasithin.pdf`, printed pp.260–264, especially the q=2
discussion distinguishing ²F₄(2) from the Tits derived subgroup.
-/

public section
namespace ReeF4.Parabolics.Binary.FixedGeometry

open Subgroup

private theorem normalizer_eq_of_cover {G : Type*} [Group G] (U N : Subgroup G)
    (hcover : ∀ g : G, ∃ u ∈ U, ∃ n ∈ N, ∃ v ∈ U, g = u * n * v)
    (hsep : ∀ n ∈ N, n ∈ normalizer U → n ∈ U) : normalizer U = U := by
  apply le_antisymm _ le_normalizer
  intro g hg
  obtain ⟨u, hu, n, hn, v, hv, rfl⟩ := hcover g
  have hnN : n ∈ normalizer U := by
    have huN : u ∈ normalizer U := le_normalizer hu
    have hvN : v ∈ normalizer U := le_normalizer hv
    have h : u⁻¹ * (u * n * v) * v⁻¹ ∈ normalizer U :=
      (normalizer (U : Set G)).mul_mem
        ((normalizer (U : Set G)).mul_mem
          ((normalizer (U : Set G)).inv_mem huN) hg)
        ((normalizer (U : Set G)).inv_mem hvN)
    simpa only [mul_assoc, inv_mul_cancel_left, mul_inv_cancel, mul_one] using h
  exact U.mul_mem (U.mul_mem hu (hsep n hn hnN)) hv

/-- Fixed Bruhat coverage and Weyl separation identify the binary normalizer. -/
theorem unipotent_normalizer_eq_of_bruhat
    (hcover : ∀ g : Model 0, ∃ u ∈ unipotent 0, ∃ n ∈ weylSubgroup 0,
      ∃ v ∈ unipotent 0, g = u * n * v)
    (hsep : ∀ n ∈ weylSubgroup 0, n ∈ normalizer (unipotent 0) → n ∈ unipotent 0) :
    normalizer (unipotent 0) = unipotent 0 :=
  normalizer_eq_of_cover (unipotent 0) (weylSubgroup 0) hcover hsep

private theorem unipotent_index_odd_of_normalizer
    (hN : normalizer (unipotent 0) = unipotent 0) : Odd (unipotent 0).index := by
  obtain ⟨n, hn⟩ := (unipotent_isPGroup 0).exists_card_eq
  have hmod := Sylow.card_quotient_normalizer_modEq_card_quotient hn
  rw [hN] at hmod
  have hcomap : (unipotent 0).comap (unipotent 0).subtype = ⊤ := by
    ext x
    simp
  rw [hcomap, ← Subgroup.index_eq_card, Subgroup.index_top] at hmod
  change 1 % 2 = (unipotent 0).index % 2 at hmod
  exact Nat.odd_iff.mpr hmod.symm

/-- The two fixed Bruhat inputs imply odd index, without an order formula. -/
theorem unipotent_index_odd_of_bruhat
    (hcover : ∀ g : Model 0, ∃ u ∈ unipotent 0, ∃ n ∈ weylSubgroup 0,
      ∃ v ∈ unipotent 0, g = u * n * v)
    (hsep : ∀ n ∈ weylSubgroup 0, n ∈ normalizer (unipotent 0) → n ∈ unipotent 0) :
    Odd (unipotent 0).index :=
  unipotent_index_odd_of_normalizer (unipotent_normalizer_eq_of_bruhat hcover hsep)

/-- Fixed Bruhat coverage implies generation by the actual fixed seeds. -/
theorem seed_sup_eq_top_of_bruhat
    (hcover : ∀ g : Model 0, ∃ u ∈ unipotent 0, ∃ n ∈ weylSubgroup 0,
      ∃ v ∈ unipotent 0, g = u * n * v) :
    seed 0 .suzuki ⊔ seed 0 .linear = ⊤ := by
  apply top_unique
  intro g _
  obtain ⟨u, hu, n, hn, v, hv, rfl⟩ := hcover g
  have hU : unipotent 0 ≤ seed 0 .suzuki ⊔ seed 0 .linear :=
    (unipotent_le_seed 0 .suzuki).trans le_sup_left
  exact (seed 0 .suzuki ⊔ seed 0 .linear).mul_mem
    ((seed 0 .suzuki ⊔ seed 0 .linear).mul_mem (hU hu) (weylSubgroup_le_seeds 0 hn))
    (hU hv)

/-- The positive fixed subgroup is self-normalizing in the full binary Ree group. -/
theorem unipotent_normalizer_eq : normalizer (unipotent 0) = unipotent 0 :=
  unipotent_normalizer_eq_of_bruhat BruhatCoverage.exists_unipotent_weyl_unipotent
    WeylSeparation.weyl_mem_unipotent

/-- The positive fixed subgroup has odd index in the full group ²F₄(2). -/
theorem unipotent_index_odd : Odd (unipotent 0).index :=
  unipotent_index_odd_of_normalizer unipotent_normalizer_eq

/-- The actual Suzuki and linear fixed seeds generate the full group ²F₄(2). -/
theorem seed_sup_eq_top : seed 0 .suzuki ⊔ seed 0 .linear = ⊤ :=
  seed_sup_eq_top_of_bruhat BruhatCoverage.exists_unipotent_weyl_unipotent

end ReeF4.Parabolics.Binary.FixedGeometry
