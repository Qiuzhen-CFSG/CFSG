module

public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.WeylLifts
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.Disjoint

/-!
# Split coordinates for binary Ree Bruhat descent

The split Weyl subgroup is generated by the four actual simple matrix words.
For a prospective middle representative `n`, the right unipotent factor is
`U ∩ n⁻¹U⁻n`. The exceptional twist preserves both root closures and carries
this factor to the one indexed by the twisted representative.

The proved split intersection `U ∩ U⁻ = 1` gives uniqueness of the unipotent
factors at a fixed representative. Consequently, when the product and its
representative are twist-fixed, both unipotent factors are twist-fixed too.
Coverage and uniqueness of the middle representative are separate obligations;
neither follows merely from this equivariance argument.

Source: GLS3, Bruhat normal forms 1.11.5 and 2.3.5 in
`refs/KGroup/GLS3/Chapter1.tex` and `chapter2.tex`. The binary application is to
the full fixed group in Aschbacher–Smith F.1.12(I)(5), printed pp.263–264 of
`refs/quasithin.pdf`.
-/

@[expose] public section
namespace ReeF4.Parabolics.Binary.FixedGeometry.BruhatCoverage
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem Subgroup
open ReeF4.LargeLocalSeeds ReeF4.LocalBlockInput

noncomputable section

/-- The subgroup of the binary split matrix group generated by all four simple Weyl lifts. -/
def splitWeylSubgroup : Subgroup (SplitGroup 0) :=
  closure (Set.range fun i : Fin 4 => simpleWord 0 [i])

/-- Every numbered simple word belongs to the split Weyl subgroup. -/
theorem simpleWord_mem_splitWeylSubgroup (l : List (Fin 4)) :
    simpleWord 0 l ∈ splitWeylSubgroup := by
  induction l with
  | nil => exact splitWeylSubgroup.one_mem
  | cons i l ih =>
    have hi : simpleWord 0 [i] ∈ splitWeylSubgroup :=
      subset_closure (Set.mem_range_self i)
    simpa only [simpleWord, List.map_cons, List.map_nil, List.prod_cons,
      List.prod_nil, mul_one] using splitWeylSubgroup.mul_mem hi ih

/-- The fixed orbit-word subgroup embeds into the split Weyl subgroup. -/
theorem weylSubgroup_le_splitWeylSubgroup :
    weylSubgroup 0 ≤ splitWeylSubgroup.comap (toSplitGroup 0) := by
  apply (closure_le _).mpr
  rintro _ ⟨s, rfl⟩
  change toSplitGroup 0 (weylLift 0 s) ∈ splitWeylSubgroup
  rw [toSplitGroup_weylLift]
  exact simpleWord_mem_splitWeylSubgroup _

/-- Diagram reversal preserves the subgroup of split simple Weyl words. -/
theorem reeTwist_mem_splitWeylSubgroup {n : SplitGroup 0}
    (hn : n ∈ splitWeylSubgroup) : reeTwist 0 n ∈ splitWeylSubgroup := by
  induction hn using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    rw [reeTwist_simpleWord]
    exact subset_closure (Set.mem_range_self (Fin.revPerm i))
  | one => simpa only [map_one] using splitWeylSubgroup.one_mem
  | mul x y _ _ hx hy =>
    simpa only [map_mul] using splitWeylSubgroup.mul_mem hx hy
  | inv x _ hx => simpa only [map_inv] using splitWeylSubgroup.inv_mem hx

/-- The actual Ree twist preserves the positive root closure. -/
theorem reeTwist_mem_splitUnipotent {u : SplitGroup 0}
    (hu : u ∈ splitUnipotent 0) : reeTwist 0 u ∈ splitUnipotent 0 := by
  have h := mem_map_of_mem (canonicalLocalBlockInput 0).twist.toMonoidHom hu
  rw [splitUnipotent_twist] at h
  simpa only [LocalBlockInput.twist_eq_reeAutomorphism, MulEquiv.coe_toMonoidHom,
    reeAutomorphism_apply] using h

/-- The actual Ree twist also preserves the negative root closure. -/
theorem reeTwist_mem_splitNegativeUnipotent {v : SplitGroup 0}
    (hv : v ∈ splitNegativeUnipotent 0) : reeTwist 0 v ∈ splitNegativeUnipotent 0 := by
  induction hv using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨r, t, hr, rfl⟩ := hx
    rw [reeTwist_rootGenerator]
    apply Subgroup.subset_closure
    refine ⟨_, _, ?_, rfl⟩
    exact fun h => hr ((((typeF4RootPairing.isPositiveRootDuality_iff
      typeF4RootPairing_base exceptionalRootPermutation).mp
        exceptionalRootPermutation_spec).2.1 r).mpr h)
  | one => simpa only [map_one] using (splitNegativeUnipotent 0).one_mem
  | mul x y _ _ hx hy =>
    simpa only [map_mul] using (splitNegativeUnipotent 0).mul_mem hx hy
  | inv x _ hx => simpa only [map_inv] using (splitNegativeUnipotent 0).inv_mem hx

/-- The right inversion factor: `v ∈ U` and `n * v * n⁻¹ ∈ U⁻`.
This comap uses conjugation by `n`, so its carrier is `U ∩ n⁻¹U⁻n`. -/
def rightUnipotent (n : SplitGroup 0) : Subgroup (SplitGroup 0) :=
  splitUnipotent 0 ⊓ (splitNegativeUnipotent 0).comap (MulAut.conj n).toMonoidHom

/-- The explicit conjugation convention for the right inversion factor. -/
theorem mem_rightUnipotent (n v : SplitGroup 0) :
    v ∈ rightUnipotent n ↔
      v ∈ splitUnipotent 0 ∧ n * v * n⁻¹ ∈ splitNegativeUnipotent 0 := Iff.rfl

/-- Twisting a right inversion factor twists its Weyl representative as well. -/
theorem reeTwist_mem_rightUnipotent {n v : SplitGroup 0}
    (hv : v ∈ rightUnipotent n) : reeTwist 0 v ∈ rightUnipotent (reeTwist 0 n) := by
  rw [mem_rightUnipotent] at hv ⊢
  refine ⟨reeTwist_mem_splitUnipotent hv.1, ?_⟩
  simpa only [map_mul, map_inv] using reeTwist_mem_splitNegativeUnipotent hv.2

private theorem factors_unique_of_disjoint {G : Type*} [Group G]
    {U V : Subgroup G} (hUV : Disjoint U V)
    {a b c d : G} (ha : a ∈ U) (hb : b ∈ V) (hc : c ∈ U) (hd : d ∈ V)
    (he : a * b = c * d) : a = c ∧ b = d := by
  have h : c⁻¹ * a = d * b⁻¹ := by
    calc
      c⁻¹ * a = c⁻¹ * (a * b) * b⁻¹ := by group
      _ = d * b⁻¹ := by rw [he]; group
  have hzero : c⁻¹ * a = 1 := (Subgroup.disjoint_def.mp hUV)
    (U.mul_mem (U.inv_mem hc) ha) (h ▸ V.mul_mem hd (V.inv_mem hb))
  have hac : a = c := (inv_mul_eq_one.mp hzero).symm
  exact ⟨hac, mul_left_cancel (hac ▸ he)⟩

/-- At a specified representative, the two unipotent factors are unique.
No membership condition on the representative is needed. -/
theorem unipotent_factors_unique {n u v u' v' : SplitGroup 0}
    (hu : u ∈ splitUnipotent 0) (hv : v ∈ rightUnipotent n)
    (hu' : u' ∈ splitUnipotent 0) (hv' : v' ∈ rightUnipotent n)
    (he : u * n * v = u' * n * v') : u = u' ∧ v = v' := by
  have h := factors_unique_of_disjoint (PairNormalization.splitUnipotent_disjoint_negative 0)
    hu ((mem_rightUnipotent n v).mp hv).2
    hu' ((mem_rightUnipotent n v').mp hv').2
    (show u * (n * v * n⁻¹) = u' * (n * v' * n⁻¹) by
      simpa only [mul_assoc] using congrArg (fun x => x * n⁻¹) he)
  refine ⟨h.1, ?_⟩
  exact mul_left_cancel (mul_right_cancel h.2)


/-- A fixed product with fixed middle representative has fixed unipotent factors. -/
theorem fixed_unipotent_factors {g n u v : SplitGroup 0}
    (hg : reeTwist 0 g = g) (hn : reeTwist 0 n = n)
    (hu : u ∈ splitUnipotent 0) (hv : v ∈ rightUnipotent n)
    (he : g = u * n * v) : reeTwist 0 u = u ∧ reeTwist 0 v = v := by
  apply unipotent_factors_unique (reeTwist_mem_splitUnipotent hu)
    (show reeTwist 0 v ∈ rightUnipotent n from hn ▸ reeTwist_mem_rightUnipotent hv)
    hu hv
  calc
    reeTwist 0 u * n * reeTwist 0 v = reeTwist 0 (u * n * v) := by
      rw [map_mul, map_mul, hn]
    _ = u * n * v := by rw [← he, hg]

end
end ReeF4.Parabolics.Binary.FixedGeometry.BruhatCoverage
