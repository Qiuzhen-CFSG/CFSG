module

public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.WeylLifts
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.BruhatCoverage.SplitGeneration
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.BruhatCoverage.SplitCoverage
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.BruhatCoverage.SplitSeparation
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.BruhatCoverage.FixedWeyl

/-!
# Descent of binary split Bruhat normal forms to the full Ree fixed group

A split normal form of a fixed element and its twist have the same product.
Uniqueness of the split middle representative therefore makes it twist-fixed.
The positive/negative intersection argument in `Basic` then fixes both
unipotent factors. Identifying the fixed part of the split Weyl subgroup with
the subgroup generated by the two orbit words gives the requested fixed factors.

The conditional descent theorem records these three geometric inputs explicitly.
`SplitCoverage`, `SplitSeparation`, and `FixedWeyl` prove them for the actual
binary split matrices. Applying those results gives unconditional coverage in
`exists_unipotent_weyl_unipotent`. The ambient group throughout is the full
`Model 0`, including the nonsimple binary endpoint.

Source: GLS3 1.11.5 and 2.3.4–5 (`refs/KGroup/GLS3/Chapter1.tex` and
`chapter2.tex`); Aschbacher–Smith F.1.12(I)(5), printed pp.263–264 of
`refs/quasithin.pdf`.
-/

public section
namespace ReeF4.Parabolics.Binary.FixedGeometry.BruhatCoverage
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem Subgroup
open ReeF4.LargeLocalSeeds ReeF4.LocalBlockInput

noncomputable section

/-- Split normal forms descend to fixed Bruhat factors once all three
geometric inputs are supplied. This is conditional assembly. -/
theorem exists_unipotent_weyl_unipotent_of_split
    (hcover : ∀ g : SplitGroup 0,
      ∃ u ∈ splitUnipotent 0, ∃ n ∈ splitWeylSubgroup,
        ∃ v ∈ rightUnipotent n, g = u * n * v)
    (hseparate : ∀ {u n v u' n' v' : SplitGroup 0},
      u ∈ splitUnipotent 0 → n ∈ splitWeylSubgroup → v ∈ rightUnipotent n →
      u' ∈ splitUnipotent 0 → n' ∈ splitWeylSubgroup → v' ∈ rightUnipotent n' →
      u * n * v = u' * n' * v' → n = n')
    (hweyl : splitWeylSubgroup.comap (toSplitGroup 0) ≤ weylSubgroup 0)
    (g : Model 0) : ∃ u ∈ unipotent 0, ∃ n ∈ weylSubgroup 0,
      ∃ v ∈ unipotent 0, g = u * n * v := by
  obtain ⟨u, hu, n, hn, v, hv, he⟩ := hcover (toSplitGroup 0 g)
  have hproduct : reeTwist 0 u * reeTwist 0 n * reeTwist 0 v = u * n * v := by
    rw [← map_mul, ← map_mul, ← he, reeTwist_toSplitGroup, he]
  have hnfix : reeTwist 0 n = n := hseparate
    (reeTwist_mem_splitUnipotent hu) (reeTwist_mem_splitWeylSubgroup hn)
    (reeTwist_mem_rightUnipotent hv) hu hn hv hproduct
  obtain ⟨hufix, hvfix⟩ := fixed_unipotent_factors (reeTwist_toSplitGroup 0 g)
    hnfix hu hv he
  let u₀ : Model 0 := ⟨u, (mem_fixedSubgroup 0 u).mpr hufix⟩
  let n₀ : Model 0 := ⟨n, (mem_fixedSubgroup 0 n).mpr hnfix⟩
  let v₀ : Model 0 := ⟨v, (mem_fixedSubgroup 0 v).mpr hvfix⟩
  have hu₀ : u₀ ∈ unipotent 0 := by
    change toSplitGroup 0 u₀ ∈ splitUnipotent 0
    simpa only [toSplitGroup_apply] using hu
  have hn₀ : n₀ ∈ weylSubgroup 0 := by
    apply hweyl
    change toSplitGroup 0 n₀ ∈ splitWeylSubgroup
    simpa only [toSplitGroup_apply] using hn
  have hv₀ : v₀ ∈ unipotent 0 := by
    change toSplitGroup 0 v₀ ∈ splitUnipotent 0
    rw [toSplitGroup_apply]
    exact ((mem_rightUnipotent n v).mp hv).1
  refine ⟨u₀, hu₀, n₀, hn₀, v₀, hv₀, ?_⟩
  apply toSplitGroup_injective 0
  simpa only [map_mul, toSplitGroup_apply] using he

/-- Every element of the full binary Ree group has fixed Bruhat factors, with
the middle factor generated by the actual orbit words `[0,3]` and `[1,2,1,2]`. -/
theorem exists_unipotent_weyl_unipotent (g : Model 0) :
    ∃ u ∈ unipotent 0, ∃ n ∈ weylSubgroup 0,
      ∃ v ∈ unipotent 0, g = u * n * v :=
  exists_unipotent_weyl_unipotent_of_split exists_split_normal_form
    middle_representative_unique splitWeylSubgroup_comap_le_weylSubgroup g

end
end ReeF4.Parabolics.Binary.FixedGeometry.BruhatCoverage
