module
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.WeylSeparation.Coordinates

/-!
# The actual Weyl action on binary Ree root coordinates

The integral Tits formula sends each root basis vector to its reflected root
vector, since every integral sign becomes one in characteristic two. Tits
words preserve the Cartan subspace. Together these facts also identify the
root rows. Closure induction then gives both formulas for every element of
the subgroup generated by the two fixed orbit representatives.

This uses the actual representatives from `WeylLifts`, not an abstract family
tag or a Bruhat decomposition. Source: Geck's integral Tits construction;
Steinberg, *Lectures on Chevalley Groups*.
-/

@[expose] public section
noncomputable section
namespace ReeF4.Parabolics.Binary.FixedGeometry.WeylSeparation
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
open scoped Matrix
private local instance rootActionIndexNeg : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg

/-- The root columns and root coordinates of the actual matrix carry the same Weyl action. -/
structure RootAction (n : Model 0) (w : typeF4RootPairing.weylGroup) : Prop where
  onRoot : ∀ r : F4Chevalley.Root,
    matrix n *ᵥ Pi.single (Sum.inr r) 1 =
      Pi.single (Sum.inr (typeF4RootPairing.weylGroupToPerm w r)) 1
  onCoordinate : ∀ (v : F4Chevalley.BasisIndex → CoefficientField 0) (r : F4Chevalley.Root),
    (matrix n *ᵥ v) (Sum.inr (typeF4RootPairing.weylGroupToPerm w r)) = v (Sum.inr r)

private theorem cast_single (j : F4Chevalley.BasisIndex) :
    (Int.castRingHom (CoefficientField 0)) ∘ Pi.single j (1 : ℤ) = Pi.single j 1 := by
  classical
  ext x
  simp [Pi.single_apply]

private theorem wordSign_cast (word : List typeF4RootPairing_base.support) (r : F4Chevalley.Root) :
    (titsWordSign (P := typeF4RootPairing) word r : CoefficientField 0) = 1 := by
  induction word with
  | nil => simp [titsWordSign]
  | cons i word ih => simp [titsWordSign, ih, CharTwo.neg_eq]

private theorem reflectionWord_eq (word : List typeF4RootPairing_base.support)
    (r : F4Chevalley.Root) :
    reflectionWord (P := typeF4RootPairing) word r =
      typeF4RootPairing.weylGroupToPerm (typeF4RootPairing_base.wordProd word) r := by
  induction word with
  | nil => rfl
  | cons i word ih =>
    simp only [reflectionWord, RootPairing.Base.wordProd_cons, map_mul,
      Equiv.Perm.coe_mul, Function.comp_apply]
    change typeF4RootPairing.reflectionPerm i (reflectionWord word r) =
      typeF4RootPairing.reflectionPerm i
        (typeF4RootPairing.weylGroupToPerm (typeF4RootPairing_base.wordProd word) r)
    exact congrArg (typeF4RootPairing.reflectionPerm i) ih

private theorem word_root (word : List typeF4RootPairing_base.support) (r : F4Chevalley.Root) :
    (rootCurveTitsWord (S := CoefficientField 0) word).val *ᵥ Pi.single (Sum.inr r) 1 =
      Pi.single (Sum.inr (typeF4RootPairing.weylGroupToPerm
        (typeF4RootPairing_base.wordProd word) r)) 1 := by
  have h := congrArg (fun v : F4Chevalley.BasisIndex → ℤ =>
    (Int.castRingHom (CoefficientField 0)) ∘ v)
      (titsWord_mulVec_v (P := typeF4RootPairing) word r)
  have hm (A : Matrix F4Chevalley.BasisIndex F4Chevalley.BasisIndex ℤ)
      (v : F4Chevalley.BasisIndex → ℤ) :
      (Int.castRingHom (CoefficientField 0)) ∘ (A *ᵥ v) =
        A.map (Int.castRingHom (CoefficientField 0)) *ᵥ
          ((Int.castRingHom (CoefficientField 0)) ∘ v) := by
    ext i
    exact (Int.castRingHom (CoefficientField 0)).map_mulVec A v i
  have hs (z : ℤ) (v : F4Chevalley.BasisIndex → ℤ) :
      (Int.castRingHom (CoefficientField 0)) ∘ (z • v) =
        (z : CoefficientField 0) • ((Int.castRingHom (CoefficientField 0)) ∘ v) := by
    ext i
    simp
  simpa only [rootCurveTitsWord, specializeMatrix, hm, hs, v, cast_single,
    wordSign_cast, one_smul, reflectionWord_eq] using h

private theorem word_cartan (word : List typeF4RootPairing_base.support)
    (j : typeF4RootPairing_base.support) (r : F4Chevalley.Root) :
    (titsWord (P := typeF4RootPairing) word *ᵥ u j) (Sum.inr r) = 0 := by
  induction word generalizing r with
  | nil => simp [titsWord, u]
  | cons i word ih =>
    rw [titsWord, ← Matrix.mulVec_mulVec, Matrix.mulVec, dotProduct]
    apply Finset.sum_eq_zero
    intro k _
    cases k with
    | inl k =>
      have h := congrFun (titsLift_mulVec_u (P := typeF4RootPairing) i k) (Sum.inr r)
      have hz : titsLift (P := typeF4RootPairing) i (Sum.inr r) (Sum.inl k) = 0 := by
        simpa [u, Matrix.mulVec_single_one] using h
      rw [hz, zero_mul]
    | inr k => rw [ih k, mul_zero]

private theorem word_coordinate (word : List typeF4RootPairing_base.support)
    (v : F4Chevalley.BasisIndex → CoefficientField 0) (r : F4Chevalley.Root) :
    ((rootCurveTitsWord (S := CoefficientField 0) word).val *ᵥ v)
      (Sum.inr (typeF4RootPairing.weylGroupToPerm
        (typeF4RootPairing_base.wordProd word) r)) = v (Sum.inr r) := by
  let σ := typeF4RootPairing.weylGroupToPerm (typeF4RootPairing_base.wordProd word)
  let A : Matrix F4Chevalley.BasisIndex F4Chevalley.BasisIndex (CoefficientField 0) :=
    (rootCurveTitsWord (S := CoefficientField 0) word).val
  change (A *ᵥ v) (Sum.inr (σ r)) = _
  have he (c : F4Chevalley.BasisIndex) :
      A (Sum.inr (σ r)) c =
        if c = Sum.inr r then 1 else 0 := by
    cases c with
    | inl j =>
      have hz := word_cartan word j (σ r)
      simp only [u, Matrix.mulVec_single_one, Matrix.col_apply] at hz
      simp only [A, rootCurveTitsWord, specializeMatrix, Matrix.map_apply, hz,
        map_zero, reduceCtorEq, if_false]
    | inr t =>
      have h := congrFun (word_root word t) (Sum.inr (σ r))
      simp only [Matrix.mulVec_single_one, Matrix.col_apply, Pi.single_apply,
        Sum.inr.injEq] at h
      change _ = if σ r = σ t then 1 else 0 at h
      simpa only [σ.injective.eq_iff, Sum.inr.injEq, eq_comm] using h
  simp only [Matrix.mulVec, dotProduct, he]
  simp

private theorem weylLift_rootAction (s : LargeLocalSeeds.Side) :
    RootAction (weylLift 0 s)
      (typeF4RootPairing_base.wordProd ((sideWord s).map typeF4RootPairing_baseEquiv)) := by
  have hmat : matrix (weylLift 0 s) =
      (rootCurveTitsWord (S := CoefficientField 0)
        ((sideWord s).map typeF4RootPairing_baseEquiv)).val := by
    change ((toSplitGroup 0 (weylLift 0 s) : MatrixUnits 0)).val = _
    rw [toSplitGroup_weylLift, simpleWord_coe]
  constructor
  · intro r; rw [hmat]; exact word_root _ r
  · intro v r; rw [hmat]; exact word_coordinate _ v r

private theorem RootAction.mul {n k : Model 0} {w z : typeF4RootPairing.weylGroup}
    (hn : RootAction n w) (hk : RootAction k z) : RootAction (n * k) (w * z) := by
  constructor
  · intro r
    rw [map_mul, ← Matrix.mulVec_mulVec, hk.onRoot, hn.onRoot]
    rfl
  · intro v r
    rw [map_mul, ← Matrix.mulVec_mulVec]
    exact (hn.onCoordinate _ _).trans (hk.onCoordinate v r)

private theorem RootAction.inv {n : Model 0} {w : typeF4RootPairing.weylGroup}
    (hn : RootAction n w) : RootAction n⁻¹ w⁻¹ := by
  have cancel (v : F4Chevalley.BasisIndex → CoefficientField 0) :
      matrix n⁻¹ *ᵥ (matrix n *ᵥ v) = v := by
    rw [Matrix.mulVec_mulVec, ← map_mul, inv_mul_cancel, map_one, Matrix.one_mulVec]
  have cancel' (v : F4Chevalley.BasisIndex → CoefficientField 0) :
      matrix n *ᵥ (matrix n⁻¹ *ᵥ v) = v := by
    rw [Matrix.mulVec_mulVec, ← map_mul, mul_inv_cancel, map_one, Matrix.one_mulVec]
  constructor
  · intro r
    have h := cancel (Pi.single (Sum.inr (typeF4RootPairing.weylGroupToPerm w⁻¹ r)) 1)
    rw [hn.onRoot] at h
    simpa using h
  · intro v r
    have h := hn.onCoordinate (matrix n⁻¹ *ᵥ v)
      (typeF4RootPairing.weylGroupToPerm w⁻¹ r)
    rw [cancel'] at h
    simpa using h.symm

/-- Every element of the generated fixed Weyl subgroup has its actual root action. -/
theorem exists_rootAction (n : Model 0) (hn : n ∈ weylSubgroup 0) :
    ∃ w : typeF4RootPairing.weylGroup, RootAction n w := by
  induction hn using Subgroup.closure_induction with
  | mem n hn =>
    obtain ⟨s, rfl⟩ := hn
    exact ⟨_, weylLift_rootAction s⟩
  | one =>
    refine ⟨1, ⟨?_, ?_⟩⟩
    · intro r
      rw [map_one, Matrix.one_mulVec, map_one]
      rfl
    · intro v r
      rw [map_one, Matrix.one_mulVec, map_one]
      rfl
  | mul n k _ _ hn hk =>
    obtain ⟨w, hw⟩ := hn
    obtain ⟨z, hz⟩ := hk
    exact ⟨w * z, hw.mul hz⟩
  | inv n _ hn =>
    obtain ⟨w, hw⟩ := hn
    exact ⟨w⁻¹, hw.inv⟩

end ReeF4.Parabolics.Binary.FixedGeometry.WeylSeparation
