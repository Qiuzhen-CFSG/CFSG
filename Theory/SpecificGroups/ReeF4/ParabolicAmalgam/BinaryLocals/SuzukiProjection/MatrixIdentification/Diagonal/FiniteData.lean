public import Mathlib.Data.Fin.VecNotation
public import Mathlib.Tactic

/-!
# Finite certificate for the paired binary matrices

Rows are four-bit integers, with the least significant bit in column zero.
The table has 720 states, contains the identity, and is closed under the
four paired simple generators. These properties are checked in the kernel. Its diagonal entries lie in the list of twenty binary Suzuki Bruhat
matrices. The interpretation of these codes as actual matrices is proved in
`MatrixIdentification.Diagonal`.

The table is generated by `Diagonal/source/generate.py`; the generator is not
trusted. All three finite assertions below are checked by `decide +kernel`.
Source: the binary middle-node comparison for Aschbacher–Smith F.1.12(I)(5),
printed pp.263–264 of `refs/quasithin.pdf`.
-/

public section
namespace ReeF4.Parabolics.BinarySuzuki.MatrixIdentification.DiagonalCertificate

abbrev Row := Fin 16
abbrev Code := Row × Row × Row × Row
abbrev PairCode := Code × Code

@[expose] def rowBits (r : Row) (j : Fin 4) : Bool := r.val.testBit j.val

@[expose] def stepRow (r : Row) (i : Fin 4) : Row :=
  ![![0, 1, 6, 7, 4, 5, 2, 3, 8, 9, 14, 15, 12, 13, 10, 11],
    ![0, 3, 2, 1, 12, 15, 14, 13, 8, 11, 10, 9, 4, 7, 6, 5],
    ![0, 1, 2, 3, 6, 7, 4, 5, 8, 9, 10, 11, 14, 15, 12, 13],
    ![0, 1, 3, 2, 4, 5, 7, 6, 12, 13, 15, 14, 8, 9, 11, 10]] i r

@[expose] def step (c : Code) (i : Fin 4) : Code :=
  (stepRow c.1 i, stepRow c.2.1 i, stepRow c.2.2.1 i, stepRow c.2.2.2 i)

@[expose] def swap (i : Fin 4) : Fin 4 := ![1, 0, 3, 2] i

@[expose] def pairStep (c : PairCode) (i : Fin 4) : PairCode :=
  (step c.1 i, step c.2 (swap i))

@[expose] def identityCode : Code := (1, 2, 4, 8)

