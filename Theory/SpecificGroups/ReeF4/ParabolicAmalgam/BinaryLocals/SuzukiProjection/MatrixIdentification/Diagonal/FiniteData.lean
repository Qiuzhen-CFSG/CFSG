theorem state_zero : state 0 = (identityCode, identityCode) := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem transitions : ∀ (n : Fin 720) (i : Fin 4),
    next n.val i < 720 ∧ state (next n.val i) = pairStep (state n.val) i := by
  decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem diagonal_entries : ∀ n : Fin 720,
    (state n.val).1 = (state n.val).2 →
      ∃ k : Fin 20, (state n.val).1 = suzukiCode k := by
  decide +kernel

