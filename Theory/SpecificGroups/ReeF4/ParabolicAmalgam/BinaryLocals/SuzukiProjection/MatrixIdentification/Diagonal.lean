module

public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.SuzukiProjection.MatrixIdentification.Basic
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.SuzukiProjection.MatrixIdentification.Diagonal.FiniteData
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# The paired binary diagonal is Sz(2)

The diagonal of the subgroup generated by the four node-swapped B₂ matrix
pairs is exactly the concrete Suzuki subgroup over the binary coefficient
field. This calculation is independent of the F₄ representation comparison.

For the upper containment, decode the finite row codes in `Diagonal.FiniteData`
as matrices over `CoefficientField 0`. A checked table containing the identity
is closed under right multiplication by every paired generator and its inverse.
Closure induction therefore represents every element of `pairedSubgroup` in
the table. Injectivity of decoding makes each diagonal pair one of the twenty
listed Suzuki root or root–Weyl–root matrices.

For the reverse containment, explicit seven- and ten-letter words yield the
Suzuki root generator and Weyl element as diagonal pairs. The four binary root
elements are powers of that root generator, and the binary torus is trivial.
All finite certificates are checked by the kernel; no functionality of the
paired relation or fixed-point lifting is used.

Source: the binary middle-node Levi in Aschbacher–Smith F.1.12(I)(5) and its
q = 2 discussion, printed pp.263–264 (PDF pp.274–275), `refs/quasithin.pdf`.
This is the Sz(2) matrix calculation for the full Ree group, distinguished
from the D₁₀ quotient in the derived-group case F.1.12(I)(9).
-/

namespace ReeF4.Parabolics.BinarySuzuki.MatrixIdentification

open ReeF4 BenderSuzuki.MatrixGroups
open DiagonalCertificate

private noncomputable def decodeRow (r : Row) (j : Fin 4) : CoefficientField 0 :=
  if rowBits r j then 1 else 0

private noncomputable def decode (c : Code) : Matrix (Fin 4) (Fin 4) (CoefficientField 0) :=
  ![decodeRow c.1, decodeRow c.2.1, decodeRow c.2.2.1, decodeRow c.2.2.2]

private theorem decodeRow_injective : Function.Injective decodeRow := by
  intro r s h
  have hbits : rowBits r = rowBits s := by
    funext j
    have hj := congrFun h j
    cases hr : rowBits r j <;> cases hs : rowBits s j <;>
      simp_all [decodeRow]
  exact (by decide +kernel : Function.Injective rowBits) hbits

private theorem decode_injective : Function.Injective decode := by
  intro a b h
  have h0 := decodeRow_injective (congrFun h 0)
  have h1 := decodeRow_injective (congrFun h 1)
  have h2 := decodeRow_injective (congrFun h 2)
  have h3 := decodeRow_injective (congrFun h 3)
  exact Prod.ext h0 (Prod.ext h1 (Prod.ext h2 h3))

private theorem decode_identity : decode identityCode = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [decode, decodeRow, rowBits, Nat.testBit_eq_decide_div_mod_eq, identityCode]

set_option maxHeartbeats 2000000 in
private theorem decodeRow_step (r : Row) (i : Fin 4) (k : Fin 4) :
    decodeRow (stepRow r i) k =
      ∑ j, decodeRow r j * generatorMatrix i j k := by
  fin_cases r <;> fin_cases i <;> fin_cases k <;>
    norm_num [stepRow, decodeRow, rowBits, Nat.testBit_eq_decide_div_mod_eq,
      generatorMatrix, Fin.sum_univ_four, CharTwo.add_self_eq_zero, Matrix.cons_val_two, Matrix.cons_val_three]

private theorem decode_step (c : Code) (i : Fin 4) :
    decode (step c i) = decode c * generatorMatrix i := by
  ext j k
  fin_cases j <;> exact decodeRow_step _ i k

private noncomputable def bit (n j : Nat) : CoefficientField 0 :=
  if n.testBit j then 1 else 0

private noncomputable def suzukiElement (k : Fin 20) : BinaryGL :=
  if k.val < 4 then SuzukiRootGL 0 (bit k.val 0) (bit k.val 1)
  else SuzukiRootGL 0 (bit ((k.val - 4) % 4) 0) (bit ((k.val - 4) % 4) 1) *
    SuzukiWeylGL 0 *
    SuzukiRootGL 0 (bit ((k.val - 4) / 4) 0) (bit ((k.val - 4) / 4) 1)

private theorem suzukiElement_mem (k : Fin 20) :
    suzukiElement k ∈ SuzukiMatrixSubgroup 0 := by
  have hr (a b : CoefficientField 0) : SuzukiRootGL 0 a b ∈ SuzukiMatrixSubgroup 0 :=
    Subgroup.subset_closure (Or.inl ⟨a, b, rfl⟩)
  have hw : SuzukiWeylGL 0 ∈ SuzukiMatrixSubgroup 0 :=
    Subgroup.subset_closure (Or.inr (Or.inr rfl))
  unfold suzukiElement
  split_ifs
  · exact hr _ _
  · exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (hr _ _) hw) (hr _ _)

private noncomputable def suzukiMatrix (k : Fin 20) :
    Matrix (Fin 4) (Fin 4) (CoefficientField 0) :=
  if k.val < 4 then SuzukiRootMatrix 0 (bit k.val 0) (bit k.val 1)
  else SuzukiRootMatrix 0 (bit ((k.val - 4) % 4) 0) (bit ((k.val - 4) % 4) 1) *
    SuzukiWeylMatrix 0 *
    SuzukiRootMatrix 0 (bit ((k.val - 4) / 4) 0) (bit ((k.val - 4) / 4) 1)

private theorem suzukiElement_val (k : Fin 20) :
    (suzukiElement k).val = suzukiMatrix k := by
  unfold suzukiElement suzukiMatrix
  split_ifs <;> rfl

set_option maxHeartbeats 4000000 in
private theorem decode_suzukiCode (k : Fin 20) :
    decode (suzukiCode k) = (suzukiElement k).val := by
  rw [suzukiElement_val]
  fin_cases k <;> ext i j <;> fin_cases i <;> fin_cases j <;>
    norm_num [suzukiCode, decode, decodeRow, rowBits, Nat.testBit_eq_decide_div_mod_eq,
      suzukiMatrix, bit, SuzukiRootMatrix, SuzukiWeylMatrix, Matrix.mul_apply,
      Fin.sum_univ_four, CharTwo.add_self_eq_zero, Matrix.cons_val_two, Matrix.cons_val_three]

private def Represents (c : PairCode) (g : BinaryGL × BinaryGL) : Prop :=
  decode c.1 = g.1.val ∧ decode c.2 = g.2.val

private theorem represents_step (c : PairCode) (g : BinaryGL × BinaryGL)
    (h : Represents c g) (i : Fin 4) :
    Represents (pairStep c i) (g * pairedGenerator i) := by
  constructor
  · change decode (step c.1 i) = g.1.val * generatorMatrix i
    rw [decode_step, h.1]
  · change decode (step c.2 (swapIndex i)) = g.2.val * generatorMatrix (swapIndex i)
    rw [decode_step, h.2]

private theorem pairedGenerator_inv (i : Fin 4) : (pairedGenerator i)⁻¹ = pairedGenerator i := by
  apply Prod.ext <;> apply Units.ext <;> rfl

private theorem pairedSubgroup_represented (g : BinaryGL × BinaryGL)
    (hg : g ∈ pairedSubgroup) : ∃ n : Fin 720, Represents (state n.val) g := by
  have step_closed (g : BinaryGL × BinaryGL) (i : Fin 4)
      (h : ∃ n : Fin 720, Represents (state n.val) g) :
      ∃ n : Fin 720, Represents (state n.val) (g * pairedGenerator i) := by
    obtain ⟨n, hn⟩ := h
    obtain ⟨hlt, heq⟩ := transitions n i
    refine ⟨⟨next n.val i, hlt⟩, ?_⟩
    change Represents (state (next n.val i)) _
    rw [heq]
    exact represents_step _ _ hn i
  induction hg using Subgroup.closure_induction_right with
  | one =>
    refine ⟨0, ?_⟩
    change Represents (state 0) 1
    rw [state_zero]
    exact ⟨decode_identity, decode_identity⟩
  | mul_right x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hy
    exact step_closed x i ih
  | mul_inv_cancel x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hy
    rw [pairedGenerator_inv]
    exact step_closed x i ih

/-- Every diagonal pair decodes to an explicit Suzuki matrix. -/
public theorem pairedDiagonal_le_suzuki : pairedDiagonal ≤ SuzukiMatrixSubgroup 0 := by
  intro g hg
  obtain ⟨n, hn⟩ := pairedSubgroup_represented (g, g) hg
  have hd : (state n.val).1 = (state n.val).2 :=
    decode_injective (hn.1.trans hn.2.symm)
  obtain ⟨k, hk⟩ := diagonal_entries n hd
  have heq : g = suzukiElement k := by
    apply Units.ext
    exact hn.1.symm.trans ((congrArg decode hk).trans (decode_suzukiCode k))
  rw [heq]
  exact suzukiElement_mem k

/-- Lists are evaluated from right to left, one right multiplication per step. -/
private noncomputable def pairWord : List (Fin 4) → BinaryGL × BinaryGL
  | [] => 1
  | i :: w => pairWord w * pairedGenerator i

private def codeWord : List (Fin 4) → PairCode
  | [] => (identityCode, identityCode)
  | i :: w => pairStep (codeWord w) i

private theorem word_represents (w : List (Fin 4)) : Represents (codeWord w) (pairWord w) := by
  induction w with
  | nil => exact ⟨decode_identity, decode_identity⟩
  | cons i w ih => exact represents_step _ _ ih i

private theorem pairWord_mem (w : List (Fin 4)) : pairWord w ∈ pairedSubgroup := by
  induction w with
  | nil => exact Subgroup.one_mem _
  | cons i w ih => exact Subgroup.mul_mem _ ih (Subgroup.subset_closure ⟨i, rfl⟩)

private theorem diagonal_of_word (w : List (Fin 4)) (c : Code) (g : BinaryGL)
    (hc : codeWord w = (c, c)) (hg : decode c = g.val) : g ∈ pairedDiagonal := by
  have h := word_represents w
  rw [hc] at h
  have heq : pairWord w = (g, g) := by
    apply Prod.ext
    · exact Units.ext (h.1.symm.trans hg)
    · exact Units.ext (h.2.symm.trans hg)
  change (g, g) ∈ pairedSubgroup
  rw [← heq]
  exact pairWord_mem w

/-- The left-to-right word `[0, 1, 3, 1, 0, 1, 3]` gives the diagonal root generator. -/
public theorem suzukiRoot_mem_pairedDiagonal : SuzukiRootGL 0 1 0 ∈ pairedDiagonal := by
  apply diagonal_of_word [3, 1, 0, 1, 3, 1, 0] (11, 14, 12, 8)
  · decide +kernel
  · ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [decode, decodeRow, rowBits, Nat.testBit_eq_decide_div_mod_eq,
        SuzukiRootGL, SuzukiRootMatrix]

/-- The left-to-right word `[0, 1, 2, 0, 3, 1, 2, 0, 3, 1]` gives the diagonal Weyl element. -/
public theorem suzukiWeyl_mem_pairedDiagonal : SuzukiWeylGL 0 ∈ pairedDiagonal := by
  apply diagonal_of_word [1, 3, 0, 2, 1, 3, 0, 2, 1, 0] (8, 4, 2, 1)
  · decide +kernel
  · ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [decode, decodeRow, rowBits, Nat.testBit_eq_decide_div_mod_eq,
        SuzukiWeylGL, SuzukiWeylMatrix]

private theorem binaryRoot_mem (a b : CoefficientField 0) :
    SuzukiRootGL 0 a b ∈ pairedDiagonal := by
  have h00 : SuzukiRootGL 0 0 0 = 1 := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [SuzukiRootGL, SuzukiRootMatrix]
  have h01 : SuzukiRootGL 0 0 1 = SuzukiRootGL 0 1 0 ^ 2 := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [SuzukiRootGL, SuzukiRootMatrix, pow_two, Matrix.mul_apply,
        Fin.sum_univ_four, CharTwo.add_self_eq_zero, Matrix.cons_val_two, Matrix.cons_val_three]
  have h11 : SuzukiRootGL 0 1 1 = SuzukiRootGL 0 1 0 ^ 3 := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [SuzukiRootGL, SuzukiRootMatrix, pow_succ, Matrix.mul_apply,
        Fin.sum_univ_four, CharTwo.add_self_eq_zero, Matrix.cons_val_two, Matrix.cons_val_three]
  rcases binaryScalar_cases a with rfl | rfl <;>
    rcases binaryScalar_cases b with rfl | rfl
  · rw [h00]; exact Subgroup.one_mem _
  · rw [h01]; exact Subgroup.pow_mem _ suzukiRoot_mem_pairedDiagonal _
  · exact suzukiRoot_mem_pairedDiagonal
  · rw [h11]; exact Subgroup.pow_mem _ suzukiRoot_mem_pairedDiagonal _

/-- The binary Suzuki root, torus and Weyl generators all lie in the paired diagonal. -/
public theorem suzuki_le_pairedDiagonal : SuzukiMatrixSubgroup 0 ≤ pairedDiagonal := by
  apply (Subgroup.closure_le _).mpr
  rintro g (⟨a, b, rfl⟩ | ⟨u, rfl⟩ | rfl)
  · exact binaryRoot_mem a b
  · have hu : u = 1 := by
      apply Units.ext
      rcases binaryScalar_cases u.val with h | h
      · exact (u.ne_zero h).elim
      · exact h
    rw [hu]
    have heq : SuzukiTorusGL 0 1 = 1 := by
      ext i j
      fin_cases i <;> fin_cases j <;> simp [SuzukiTorusGL, SuzukiTorusMatrix]
    rw [heq]
    exact Subgroup.one_mem _
  · exact suzukiWeyl_mem_pairedDiagonal

/-- The diagonal of the node-swapped binary B₂ generator pairs is exactly the
full concrete Suzuki subgroup Sz(2). -/
public theorem pairedDiagonal_eq_suzuki : pairedDiagonal = SuzukiMatrixSubgroup 0 :=
  le_antisymm pairedDiagonal_le_suzuki suzuki_le_pairedDiagonal

end ReeF4.Parabolics.BinarySuzuki.MatrixIdentification
