/-!
# Positive middle-subsystem root curves in the binary Levi

The positive F₄ roots outside the Suzuki radical are exactly the four positive
roots in the middle B₂ plane. Two are simple; the others are the reflections
of one middle simple root in the other. Their root curves therefore belong
to the subgroup generated by the signed simple roots at nodes 1 and 2.

The canonical integral operators may use arbitrary reduced Weyl routes.
We compare their divided powers with the one-letter middle-node routes using
integral root-space proportionality and primitivity. The resulting integral
signs disappear in characteristic two, giving equality of the actual root
matrices before applying subgroup closure under conjugation.

This supplies the subsystem-generation calculation in the parabolic Levi
construction underlying Aschbacher–Smith F.1.12(I)(5), printed pp.263–264
(PDF pp.274–275) of `refs/quasithin.pdf`. The integral Tits construction and
route comparisons are developed in `IntegralRootCurveSimpleGeneration` and
`ReeF4.WordRelations.RouteComparison`.
-/

public section
noncomputable section

namespace ReeF4.Parabolics.BinarySuzuki

open Theory.AlgebraicGroup StandardRootSystem
open RootPairing.IntegralGeckConstruction
open RootPairing.SimpleGeckGroup
open scoped Matrix

private local instance rootGenerationIndexNeg : InvolutiveNeg F4Chevalley.Root :=
  typeF4RootPairing.indexNeg

private theorem rootCurve_eq_route (r : F4Chevalley.Root) (hr : typeF4RootPairing_base.IsPos r)
    (w : List typeF4RootPairing_base.support) (j : typeF4RootPairing_base.support)
    (hw : reflectionWord (P := typeF4RootPairing) w j = r) (t : CoefficientField 0) :
    F4Chevalley.rootCurve r t =
      rootCurveTitsWord w * positiveUnit j t * (rootCurveTitsWord w)⁻¹ := by
  apply Units.ext
  change 1 + t • specializeMatrix (rootDividedPower (P := typeF4RootPairing)
      (b := typeF4RootPairing_base) r 1) +
      t ^ 2 • specializeMatrix (rootDividedPower (P := typeF4RootPairing)
        (b := typeF4RootPairing_base) r 2) +
      t ^ 3 • specializeMatrix (rootDividedPower (P := typeF4RootPairing)
        (b := typeF4RootPairing_base) r 3) = _
  have hd (n : ℕ) : specializeMatrix (S := CoefficientField 0)
      (rootDividedPower (P := typeF4RootPairing) (b := typeF4RootPairing_base) r n) =
      specializeMatrix (transportedMatrix w (eDividedPower j n)) := by
    rw [rootDividedPower_of_pos r hr]
    exact WordRelations.RouteComparison.specialize_transported_eDividedPower_eq
      _ w _ j n ((rootRoute (P := typeF4RootPairing)
        (b := typeF4RootPairing_base) r).target.trans hw.symm)
  rw [hd, hd, hd]
  simp only [specializeMatrix_transportedMatrix]
  change _ = specializeMatrix (titsWord (P := typeF4RootPairing) w) *
    positiveMatrix j t * specializeMatrix (titsWordInv (P := typeF4RootPairing) w)
  have hTU := (rootCurveTitsWord (S := CoefficientField 0) w).val_inv
  simp only [rootCurveTitsWord] at hTU
  simp only [positiveMatrix_formula, Matrix.mul_add, Matrix.add_mul,
    Matrix.mul_smul, Matrix.smul_mul, specializeMatrix]
  simp only [specializeMatrix] at hTU
  noncomm_ring [hTU]

private lemma positive_coefficients {r : F4Chevalley.Root}
    (hr : typeF4RootPairing_base.IsPos r) (i : Fin 4) :
    0 ≤ typeF4SimpleCoefficient r.val i := by
  have hs (j : Fin 4) :
      typeF4SimpleCoefficient (typeF4SimpleRoot j) i = if j = i then 1 else 0 := by
    fin_cases i <;> fin_cases j <;> norm_num [typeF4SimpleRoot, typeF4SimpleCoefficient, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  apply hr.induction_on_add
  · intro r hr
    obtain ⟨j, hj⟩ := typeF4RootPairing_baseEquiv.surjective ⟨r, hr⟩
    have h : typeF4SimpleRoot j = r.val := congrArg (fun x => x.val.val) hj
    rw [← h, hs]
    split <;> norm_num
  · intro r s t h hr hs'
    change t.val = r.val + s.val at h
    have ha (x y : Vec 4) : typeF4SimpleCoefficient (x + y) i =
        typeF4SimpleCoefficient x i + typeF4SimpleCoefficient y i := by
      fin_cases i <;> simp [typeF4SimpleCoefficient] <;> ring
    rw [h, ha]
    obtain ⟨j, hj⟩ := typeF4RootPairing_baseEquiv.surjective ⟨s, hs'⟩
    have h : typeF4SimpleRoot j = s.val := congrArg (fun x => x.val.val) hj
    rw [← h, hs]
    split <;> linarith

open LargeLocalSeeds

private lemma positive_middle_coordinates (r : F4Chevalley.Root)
    (hr : typeF4RootPairing_base.IsPos r) (hn : ¬ IsRadicalRoot .suzuki r) :
    r.val = ![0, 0, 1, -1] ∨ r.val = ![0, 0, 0, 1] ∨
      r.val = ![0, 0, 1, 0] ∨ r.val = ![0, 0, 1, 1] := by
  have hout (i : Fin 4) (hi : i ∉ leviNodes .suzuki) :
      typeF4SimpleCoefficient r.val i = 0 := by
    by_contra h
    exact hn ⟨hr, i, hi, h⟩
  have h0 := hout 0 (by simp [leviNodes])
  have h3 := hout 3 (by simp [leviNodes])
  have hp1 := positive_coefficients hr 1
  have hp2 := positive_coefficients hr 2
  simp only [typeF4SimpleCoefficient] at h0 h3 hp1 hp2
  have hz0 : r.val 0 = 0 := by linarith
  have hz1 : r.val 1 = 0 := by linarith
  have hp : 0 ≤ r.val 2 := by linarith
  have hq : 0 ≤ r.val 2 + r.val 3 := by linarith
  clear hr hn hout h0 h3 hp1 hp2
  rcases r.property with (hpair | hunit) | hhalf
  · rcases hpair with ⟨i, j, hij, a, b, ha, hb, he⟩
    have hsign (x : ℝ) (hx : x ∈ ({-1, 1} : Set ℝ)) : x = -1 ∨ x = 1 := by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hx
    rcases hsign a ha with rfl | rfl <;> rcases hsign b hb with rfl | rfl
    all_goals
      fin_cases i <;> fin_cases j <;>
        simp_all [basisVector, funext_iff, Fin.forall_fin_succ] <;> norm_num at *
  · rcases hunit with ⟨i, he | he⟩ <;> fin_cases i <;>
      simp_all [basisVector, funext_iff, Fin.forall_fin_succ] <;> norm_num at *
  · rcases hhalf with ⟨ε, he⟩
    have hz := congrFun he 0
    cases hε : ε 0 <;> norm_num [halfSignVector, hε, hz0] at hz

private lemma reflection_middle_short :
    (typeF4RootPairing.reflectionPerm (typeF4SimpleRootIndex 1)
      (typeF4SimpleRootIndex 2)).val = ![0, 0, 1, 0] := by
  change typeF4RootPairing.root _ = _
  rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_root,
    typeF4RootPairing_simpleIndex_pairing]
  norm_num [typeF4CartanMatrix, typeF4SimpleRoot, funext_iff, Fin.forall_fin_succ, Fin.ext_iff]

private lemma reflection_middle_long :
    (typeF4RootPairing.reflectionPerm (typeF4SimpleRootIndex 2)
      (typeF4SimpleRootIndex 1)).val = ![0, 0, 1, 1] := by
  change typeF4RootPairing.root _ = _
  rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_root,
    typeF4RootPairing_simpleIndex_pairing]
  norm_num [typeF4CartanMatrix, typeF4SimpleRoot, funext_iff, Fin.forall_fin_succ, Fin.ext_iff]

open Subgroup ReeF4.Parabolics.Binary.FixedGeometry

private lemma simple_mem_splitLevi (j : Fin 4) (hj : j ∈ leviNodes .suzuki)
    (t : CoefficientField 0) : rootGeneratorInGroup 0 (typeF4SimpleRootIndex j) t ∈
      splitLevi :=
  subset_closure ⟨_, t, ⟨j, hj, Or.inl rfl⟩, rfl⟩

private lemma weyl_mem_splitLevi (j : Fin 4) (hj : j ∈ leviNodes .suzuki) :
    weylWord 0 (typeF4SimpleRootIndex j) 1 ∈ splitLevi := by
  have hp := simple_mem_splitLevi j hj 1
  have hn : rootGeneratorInGroup 0 (-typeF4SimpleRootIndex j) (-1) ∈ splitLevi :=
    subset_closure ⟨_, -1, ⟨j, hj, Or.inr rfl⟩, rfl⟩
  simpa only [weylWord, inv_one] using splitLevi.mul_mem (splitLevi.mul_mem hp hn) hp

private lemma word_mem_splitLevi (l : List (Fin 4))
    (hl : ∀ i ∈ l, i ∈ leviNodes .suzuki) : simpleWord 0 l ∈ splitLevi := by
  induction l with
  | nil => exact splitLevi.one_mem
  | cons i l ih =>
    exact splitLevi.mul_mem (weyl_mem_splitLevi i (hl i (by simp)))
      (ih fun j hj => hl j (by simp [hj]))

private lemma mem_splitLevi_of_route (r : F4Chevalley.Root)
    (hr : typeF4RootPairing_base.IsPos r) (l : List (Fin 4)) (j : Fin 4)
    (hl : ∀ i ∈ l, i ∈ leviNodes .suzuki) (hj : j ∈ leviNodes .suzuki)
    (hroot : reflectionWord (P := typeF4RootPairing) (l.map typeF4RootPairing_baseEquiv)
      (typeF4RootPairing_baseEquiv j) = r) (t : CoefficientField 0) :
    rootGeneratorInGroup 0 r t ∈ splitLevi := by
  have he : rootGeneratorInGroup 0 r t =
      simpleWord 0 l * rootGeneratorInGroup 0 (typeF4SimpleRootIndex j) t *
        (simpleWord 0 l)⁻¹ := by
    apply Subtype.ext
    change F4Chevalley.rootCurve r t =
      (simpleWord 0 l : MatrixUnits 0) * F4Chevalley.rootCurve (typeF4SimpleRootIndex j) t *
        (simpleWord 0 l : MatrixUnits 0)⁻¹
    rw [simpleWord_coe, rootCurve_eq_route r hr _ _ hroot]
    have hs : F4Chevalley.rootCurve (typeF4SimpleRootIndex j) t =
        positiveUnit (typeF4RootPairing_baseEquiv j) t := by
      change rootCurveUnit (integralChevalleyRootOperators (P := typeF4RootPairing)
        (b := typeF4RootPairing_base)) (typeF4SimpleRootIndex j) t = _
      rw [← typeF4RootPairing_baseEquiv_val j, rootCurveUnit_simple]
    rw [hs]
  rw [he]
  exact splitLevi.mul_mem (splitLevi.mul_mem (word_mem_splitLevi l hl)
    (simple_mem_splitLevi j hj t)) (splitLevi.inv_mem (word_mem_splitLevi l hl))

/-- Every positive root curve outside the Suzuki radical belongs to the actual
Levi generated by the four signed middle simple roots. This discharges the
subsystem-generation premise of the split factorization calculation. -/
theorem rootGenerator_mem_splitLevi_of_pos_not_radical (r : F4Chevalley.Root) (t : CoefficientField 0)
    (hr : typeF4RootPairing_base.IsPos r) (hn : ¬ IsRadicalRoot .suzuki r) :
    rootGeneratorInGroup 0 r t ∈ splitLevi := by
  rcases positive_middle_coordinates r hr hn with h | h | h | h
  · have he : r = typeF4SimpleRootIndex 1 := Subtype.ext h
    rw [he]
    exact simple_mem_splitLevi 1 (by simp [leviNodes]) t
  · have he : r = typeF4SimpleRootIndex 2 := Subtype.ext h
    rw [he]
    exact simple_mem_splitLevi 2 (by simp [leviNodes]) t
  · apply mem_splitLevi_of_route r hr [1] 2 (by simp [leviNodes])
      (by simp [leviNodes]) _ t
    apply Subtype.ext
    exact reflection_middle_short.trans h.symm
  · apply mem_splitLevi_of_route r hr [2] 1 (by simp [leviNodes])
      (by simp [leviNodes]) _ t
    apply Subtype.ext
    exact reflection_middle_long.trans h.symm

end ReeF4.Parabolics.BinarySuzuki
