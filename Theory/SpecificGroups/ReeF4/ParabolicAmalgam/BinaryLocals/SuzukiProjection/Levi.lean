module

public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.RootData

/-!
# The middle-node Levi in the binary Ree seed

Inside the actual split F₄ matrix group over the binary field, take the subgroup
generated by the positive and negative simple roots at nodes 1 and 2. It lies
in the Suzuki-side seed and is preserved by the exceptional twist, since that
twist interchanges these two nodes. Its intersection with the full fixed group
²F₄(2) is the fixed Levi used by the binary local projection.
The transposed root-coroot pairing shows that duality preserves the middle
root plane, so the complementary positive-root radical is twist-stable too.

These are concrete root subgroups. Their complementarity with the specified
radical and the identification of the fixed Levi with Suzuki matrices remain
separate matrix calculations. Source: the Levi construction underlying
Aschbacher–Smith F.1.12(I)(5), printed pp.263–264 (PDF pp.274–275) of
`refs/quasithin.pdf`.
-/

@[expose] public section
noncomputable section

namespace ReeF4.Parabolics.BinarySuzuki

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open LargeLocalSeeds Subgroup

noncomputable local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg

/-- The four signed simple roots generating the middle-node Levi. -/
def IsLeviGeneratorRoot (r : F4Chevalley.Root) : Prop :=
  ∃ i ∈ leviNodes .suzuki, r = typeF4SimpleRootIndex i ∨ r = -typeF4SimpleRootIndex i

/-- The split middle-node Levi in the genuine F₄ matrix carrier. -/
def splitLevi : Subgroup (SplitGroup 0) :=
  closure {x | ∃ (r : F4Chevalley.Root) (t : CoefficientField 0),
    IsLeviGeneratorRoot r ∧ x = rootGeneratorInGroup 0 r t}

theorem splitLevi_le_seed : splitLevi ≤ splitSeed 0 .suzuki := by
  apply (closure_le _).mpr
  rintro x ⟨r, t, ⟨i, hi, hr⟩, rfl⟩
  apply Subgroup.subset_closure
  refine ⟨r, t, ?_, rfl⟩
  rcases hr with rfl | rfl
  · exact Or.inl (typeF4RootPairing_base.isPos_of_mem_support
      (typeF4RootPairing_baseEquiv i).property)
  · exact Or.inr ⟨i, hi, rfl⟩

theorem splitLevi_twist_mem {x : SplitGroup 0} (hx : x ∈ splitLevi) :
    reeTwist 0 x ∈ splitLevi := by
  have h : splitLevi ≤ splitLevi.comap (reeTwist 0) := by
    apply (closure_le _).mpr
    rintro x ⟨r, t, ⟨i, hi, hr⟩, rfl⟩
    change reeTwist 0 (rootGeneratorInGroup 0 r t) ∈ splitLevi
    rw [reeTwist_rootGenerator]
    apply Subgroup.subset_closure
    refine ⟨_, _, ⟨Fin.revPerm i, (rev_mem_leviNodes .suzuki i).mpr hi, ?_⟩, rfl⟩
    rcases hr with rfl | rfl
    · exact Or.inl (exceptionalRootPermutation_simple i)
    · exact Or.inr (exceptionalRootPermutation_neg_simple i)
  exact h hx

theorem splitLevi_invariant :
    splitLevi.map (reeAutomorphism 0).toMonoidHom = splitLevi := by
  apply le_antisymm
  · rintro x ⟨y, hy, rfl⟩
    simpa only [MulEquiv.coe_toMonoidHom, reeAutomorphism_apply] using
      splitLevi_twist_mem hy
  · intro x hx
    refine ⟨reeTwist 0 x, splitLevi_twist_mem hx, ?_⟩
    simpa only [MulEquiv.coe_toMonoidHom, reeAutomorphism_apply] using
      reeTwist_involutive 0 x

/-- The Levi as a subgroup of the split seed. -/
def splitLeviInSeed : Subgroup (splitSeed 0 .suzuki) :=
  splitLevi.subgroupOf (splitSeed 0 .suzuki)

/-- The root radical as a subgroup of the split seed. -/
def splitRadicalInSeed : Subgroup (splitSeed 0 .suzuki) :=
  (splitRadical 0 .suzuki).subgroupOf (splitSeed 0 .suzuki)

/-- The fixed middle-node Levi in the full ²F₄(2). -/
def levi : Subgroup (Model 0) := splitLevi.comap (toSplitGroup 0)

theorem levi_le_seed : levi ≤ seed 0 .suzuki := comap_mono splitLevi_le_seed

/-- The fixed Levi viewed inside the fixed seed. -/
def leviInSeed : Subgroup (seed 0 .suzuki) := levi.subgroupOf (seed 0 .suzuki)

/-- Forget fixedness while retaining membership in the specified split seed. -/
def toSplitSeed : seed 0 .suzuki →* splitSeed 0 .suzuki where
  toFun x := ⟨toSplitGroup 0 x.val, x.property⟩
  map_one' := Subtype.ext (map_one (toSplitGroup 0))
  map_mul' x y := Subtype.ext (map_mul (toSplitGroup 0) x.val y.val)

private theorem dual_simple_pairing (r : F4Chevalley.Root) (i : Fin 4) :
    typeF4CorootScale (typeF4SimpleRootIndex (Fin.revPerm i)) *
        dot (exceptionalRootPermutation r).val (typeF4SimpleRoot i.rev) =
      typeF4CorootScale r * dot (typeF4SimpleRoot i) r.val := by
  change typeF4CorootScale (typeF4SimpleRootIndex (Fin.revPerm i)) *
        dot (exceptionalRootPermutation r).val
          (typeF4SimpleRootIndex (Fin.revPerm i)).val =
      typeF4CorootScale r * dot (typeF4SimpleRootIndex i).val r.val
  rw [← typeF4RootPairing_pairing, ← typeF4RootPairing_pairing,
    ← exceptionalRootPermutation_simple,
    ← typeF4RootPairing.algebraMap_pairingIn ℤ,
    ← typeF4RootPairing.algebraMap_pairingIn ℤ,
    WordRelations.exceptionalRootPermutation_pairingIn]

private theorem dual_middle_plane (r : F4Chevalley.Root)
    (h0 : r.val 0 = 0) (h1 : r.val 1 = 0) :
    (exceptionalRootPermutation r).val 0 = 0 ∧
      (exceptionalRootPermutation r).val 1 = 0 := by
  have h00 := dual_simple_pairing r 0
  have h01 := dual_simple_pairing r 1
  have h02 := dual_simple_pairing r 2
  have h03 := dual_simple_pairing r 3
  simp only [typeF4CorootScale, typeF4SimpleRootIndex_mem_pair_iff] at h00 h01 h02 h03
  classical
  by_cases hl : r.val ∈ pairRoots 4 <;>
    norm_num [hl, typeF4SimpleRoot, dot, Fin.sum_univ_four, basisVector, Fin.revPerm,
      Fin.rev, h0, h1, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.cons_val_three] at h00 h01 h02 h03 <;>
    constructor <;> nlinarith

private theorem outer_coeff_zero_iff (r : F4Chevalley.Root) :
    (∀ i, i ∉ leviNodes .suzuki → typeF4SimpleCoefficient r.val i = 0) ↔
      r.val 0 = 0 ∧ r.val 1 = 0 := by
  constructor
  · intro h
    have h0 := h 0 (by simp [leviNodes])
    have h3 := h 3 (by simp [leviNodes])
    simp only [typeF4SimpleCoefficient] at h0 h3
    constructor <;> linarith
  · rintro ⟨h0, h1⟩ i hi
    fin_cases i <;> simp_all [leviNodes, typeF4SimpleCoefficient]

/-- Exceptional duality preserves the positive roots outside the middle-node subsystem. -/
theorem isRadicalRoot_duality (r : F4Chevalley.Root)
    (hr : IsRadicalRoot .suzuki r) :
    IsRadicalRoot .suzuki (exceptionalRootPermutation r) := by
  have hp := ((typeF4RootPairing.isPositiveRootDuality_iff
    typeF4RootPairing_base exceptionalRootPermutation).mp
      exceptionalRootPermutation_spec).2.1 r
  refine ⟨hp.mp hr.1, ?_⟩
  by_contra he
  push Not at he
  have hp := (outer_coeff_zero_iff (exceptionalRootPermutation r)).mp he
  have hq := dual_middle_plane (exceptionalRootPermutation r) hp.1 hp.2
  rw [exceptionalRootPermutation_involutive r] at hq
  obtain ⟨i, hi, hn⟩ := hr.2
  exact hn ((outer_coeff_zero_iff r).mpr hq i hi)

/-- The specified binary radical is stable under the actual Ree twist. -/
theorem splitRadical_twist_mem {x : SplitGroup 0}
    (hx : x ∈ splitRadical 0 .suzuki) :
    reeTwist 0 x ∈ splitRadical 0 .suzuki := by
  have h : splitRadical 0 .suzuki ≤ (splitRadical 0 .suzuki).comap (reeTwist 0) := by
    apply (closure_le _).mpr
    rintro x ⟨r, t, hr, rfl⟩
    change reeTwist 0 (rootGeneratorInGroup 0 r t) ∈ splitRadical 0 .suzuki
    rw [reeTwist_rootGenerator]
    exact subset_closure ⟨_, _, isRadicalRoot_duality r hr, rfl⟩
  exact h hx

theorem splitRadical_invariant :
    (splitRadical 0 .suzuki).map (reeAutomorphism 0).toMonoidHom =
      splitRadical 0 .suzuki := by
  apply le_antisymm
  · rintro x ⟨y, hy, rfl⟩
    simpa only [MulEquiv.coe_toMonoidHom, reeAutomorphism_apply] using
      splitRadical_twist_mem hy
  · intro x hx
    refine ⟨reeTwist 0 x, splitRadical_twist_mem hx, ?_⟩
    simpa only [MulEquiv.coe_toMonoidHom, reeAutomorphism_apply] using
      reeTwist_involutive 0 x

end ReeF4.Parabolics.BinarySuzuki
