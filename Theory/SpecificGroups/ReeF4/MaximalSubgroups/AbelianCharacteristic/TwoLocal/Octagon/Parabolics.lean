module

public import Theory.SpecificGroups.ReeF4.MaximalSubgroups.AbelianCharacteristic.TwoLocal.Geometry
public import Theory.SpecificGroups.ReeF4.MaximalSubgroups.AbelianCharacteristic.TwoLocal.ParabolicComparison
public import Theory.SpecificGroups.ReeF4.SectionGeometry.CoreFree.TitsSystem

/-!
# Both full Ree parabolics in the concrete Tits system

The fixed Suzuki Levi has two Bruhat cells. Their positive factors and entire
Levi torus lie in the Borel; their sole Weyl factor is the middle-node word
`[1,2,1,2]`. Fixed Levi–radical factorization therefore places the entire
Suzuki seed in the Borel joined with that word. Adding the complementary
torus identifies the full Suzuki parabolic.

Together with the existing end-node calculation, this identifies both
singleton standard parabolics with the converse's actual full parabolics.
The standard-parabolic lattice theorem then identifies their intersection
with the Borel. No simplicity or geometric conclusion is assumed.

Source: GLS3 2.3.4–5 and 2.6.4–6, `refs/KGroup/GLS3/chapter2.tex`.
-/

public section
noncomputable section
namespace ReeF4.MaximalSubgroups.AbelianCharacteristic.TwoLocalGeometry
open Subgroup LargeLocalSeeds Parabolics Parabolics.Binary.FixedGeometry
open SectionGeometry.BNPair
open LocalBlockInput.PairRigidity
open LocalBlockInput.PairRigidity.FixedCollection
open LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
open LocalBlockInput.PairRigidity.LocalIndices

private theorem suzuki_seed_le_borel_sup_weyl (m : ℕ) :
    seed m .suzuki ≤ borel m ⊔ zpowers (weylLift m .suzuki) := by
  let d := canonicalLocalBlockInput m
  let H := borel m ⊔ zpowers (weylLift m .suzuki)
  have hU {u : d.fixedGroup} (hu : u ∈ standardUnipotent d) : d.modelEquiv u ∈ H := by
    apply mem_sup_left
    apply unipotent_le_borel m
    change toSplitGroup m (d.modelEquiv u) ∈ splitUnipotent m
    rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
    exact hu
  have hL {l : d.fixedGroup} (hl : l ∈ fixedLevi d .suzuki) : d.modelEquiv l ∈ H := by
    obtain ⟨a, ha, b, hb, n, e, he⟩ := suzukiLeviBruhatCover_of_normalForms d
      (suzukiSplitLeviNormalForm m) (suzuki_fixedNormalizerForm d) l hl
    let t : d.fixedGroup := ⟨SuzukiGaussData.torusFactor n,
      SuzukiNormalizer.torusFactor_fixed d n⟩
    have ht : d.modelEquiv t ∈ H := by
      apply mem_sup_left
      apply (show fixedTorus m ≤ borel m from comap_mono le_sup_right)
      change toSplitGroup m (d.modelEquiv t) ∈ splitTorus m
      rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
      exact SuzukiGaussData.torusFactor_mem n
    have heq : l = a * t * (if e then relativeWeyl d .suzuki else 1) * b := by
      apply Subtype.ext
      simpa only [Subgroup.coe_mul, apply_ite, Subgroup.coe_one] using he
    rw [heq, map_mul, map_mul, map_mul]
    refine H.mul_mem (H.mul_mem (H.mul_mem
      (hU (simpleBlock_positive_le d .suzuki ha)) ht) ?_)
      (hU (simpleBlock_positive_le d .suzuki hb))
    cases e with
    | false => simpa only [Bool.false_eq_true, ↓reduceIte, map_one] using H.one_mem
    | true =>
      simpa only [↓reduceIte, modelEquiv_relativeWeyl] using
        (show weylLift m .suzuki ∈ H from mem_sup_right (mem_zpowers _))
  intro x hx
  have hx' : d.modelEquiv.symm x ∈ standardSeed d .suzuki := by
    change (d.modelEquiv.symm x).val ∈ splitSeed m .suzuki
    rw [modelEquiv_symm_coe]
    simpa only [seed, mem_comap, toSplitGroup_apply] using hx
  obtain ⟨l, hl, r, hr, he⟩ := exists_fixed_levi_radical_factors d .suzuki _ hx'
  have hh := H.mul_mem (hL hl) (hU (standardRadical_le_unipotent d .suzuki hr))
  rw [← map_mul, he, MulEquiv.apply_symm_apply] at hh
  exact hh

/-- The full Suzuki parabolic is generated by its Borel and middle-node Weyl word. -/
theorem suzuki_parabolic_eq_borel_sup_weyl (m : ℕ) :
    Parabolics.parabolic m .suzuki = borel m ⊔ zpowers (weylLift m .suzuki) := by
  apply le_antisymm
  · rw [parabolic_eq_seed_sup_borel]
    exact sup_le (suzuki_seed_le_borel_sup_weyl m) le_sup_left
  · exact sup_le (borel_le_parabolic m .suzuki)
      (zpowers_le.mpr (seed_le_parabolic m .suzuki (weylLift_mem_seed m .suzuki)))

attribute [local instance] borel_inf_normalizerWords_normal

/-- Both singleton standard parabolics equal the actual full converse parabolics. -/
theorem standardParabolic_singleton_eq_parabolic (m : ℕ) (hm : 1 ≤ m) (s : Side) :
    (titsSystem m).standardParabolic {simpleReflection m s} =
      ConverseParabolics.parabolic m s := by
  rw [parabolic_eq_rootParabolic]
  let T := titsSystem m
  have hcell : weylLift m s ∈ T.bruhatCell (simpleReflection m s) :=
    T.representative_mem_bruhatCell _ (simpleLift m s) rfl
  apply le_antisymm
  · apply T.standardParabolic_le (Parabolics.parabolic m s) (borel_le_parabolic m s)
    rintro w (rfl : w = simpleReflection m s)
    exact T.bruhatCell_subset_of_mem (Parabolics.parabolic m s) (borel_le_parabolic m s)
      hcell (seed_le_parabolic m s (weylLift_mem_seed m s))
  · have hgen : Parabolics.parabolic m s = borel m ⊔ zpowers (weylLift m s) := by
      cases s with
      | suzuki => exact suzuki_parabolic_eq_borel_sup_weyl m
      | linear => exact linear_parabolic_eq_borel_sup_weyl m hm
    rw [hgen]
    exact sup_le (T.B_le_standardParabolic _)
      (zpowers_le.mpr (T.bruhatCell_subset_standardParabolic_of_mem
        (Set.mem_singleton _) hcell))


/-- The Suzuki parabolic omits the linear relative reflection. -/
theorem titsSystem_suzukiParabolic (m : ℕ) (hm : 1 ≤ m) :
    (titsSystem m).standardParabolic
      ((titsSystem m).S \ {simpleReflection m .linear}) =
        ConverseParabolics.parabolic m .suzuki := by
  have hne := simpleReflection_linear_ne_suzuki_of_separation m
    (weylLift_linear_inv_mul_suzuki_not_mem_borel m)
  have hS : simpleReflections m \ {simpleReflection m .linear} =
      {simpleReflection m .suzuki} := by
    rw [simpleReflections_eq_pair, Set.pair_comm]
    exact Set.insert_sdiff_eq_singleton hne.symm
  exact (congrArg (titsSystem m).standardParabolic hS).trans
    (standardParabolic_singleton_eq_parabolic m hm .suzuki)

/-- The two full parabolics intersect precisely in the root-defined Borel. -/
theorem parabolic_inf_eq_borel (m : ℕ) (hm : 1 ≤ m) :
    ConverseParabolics.parabolic m .linear ⊓ ConverseParabolics.parabolic m .suzuki =
      borel m := by
  let T := titsSystem m
  let H := ConverseParabolics.parabolic m .linear ⊓ ConverseParabolics.parabolic m .suzuki
  have hB : T.B ≤ H := by
    apply le_inf <;> rw [parabolic_eq_rootParabolic] <;> exact borel_le_parabolic m _
  have hclass := T.subgroup_eq_standardParabolic_simpleIndices H hB
  have hI (s : Side) : ({simpleReflection m s} : Set (WeylQuotient m)) ⊆ T.S :=
    Set.singleton_subset_iff.mpr (simpleReflection_mem m s)
  have hlin : T.simpleIndices H ⊆ {simpleReflection m .linear} := by
    apply (T.standardParabolic_le_iff (T.simpleIndices_subset H) (hI .linear)).mp
    rw [← hclass]
    change H ≤ (titsSystem m).standardParabolic {simpleReflection m .linear}
    rw [standardParabolic_singleton_eq_parabolic m hm]
    exact inf_le_left
  have hsuz : T.simpleIndices H ⊆ {simpleReflection m .suzuki} := by
    apply (T.standardParabolic_le_iff (T.simpleIndices_subset H) (hI .suzuki)).mp
    rw [← hclass]
    change H ≤ (titsSystem m).standardParabolic {simpleReflection m .suzuki}
    rw [standardParabolic_singleton_eq_parabolic m hm]
    exact inf_le_right
  have hempty : T.simpleIndices H = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro s hs
    exact simpleReflection_linear_ne_suzuki_of_separation m
      (weylLift_linear_inv_mul_suzuki_not_mem_borel m) ((hlin hs).symm.trans (hsuz hs))
  change H = T.B
  rw [hclass, hempty, T.standardParabolic_empty]

end ReeF4.MaximalSubgroups.AbelianCharacteristic.TwoLocalGeometry
