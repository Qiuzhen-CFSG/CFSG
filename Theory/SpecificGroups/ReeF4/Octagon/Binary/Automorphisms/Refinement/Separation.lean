/-- The final colors distinguish every pair of actual vertex labels. -/
public theorem finalColor_injective :
    Function.Injective (fun v : Vertex => color14 v.val) := by
  intro v w he
  apply Fin.ext
  simpa only [inverse_color v.val v.isLt, inverse_color w.val w.isLt]
    using congrArg inverseColor he

