/-- The point labels retain the existing 1755-coset numbering. -/
def point (p : Fin 1755) : Vertex := ⟨p.val, by omega⟩

/-- Line labels occupy the second interval. -/
def line (l : Fin 2925) : Vertex := ⟨1755+l.val, by omega⟩

/-- The literal bipartite graph determined by the three-point line rows. -/
def graph : SimpleGraph Vertex where
  Adj i j :=
    (i.val < 1755 ∧ 1755 ≤ j.val ∧ i.val ∈ adjacency j.val) ∨
    (j.val < 1755 ∧ 1755 ≤ i.val ∧ j.val ∈ adjacency i.val)
  symm := ⟨by intro i j h; exact h.symm⟩
  loopless := ⟨by intro i h; rcases h with h | h <;> omega⟩

theorem point_line_adj_iff (p : Fin 1755) (l : Fin 2925) :
    graph.Adj (point p) (line l) ↔ p.val ∈ adjacency (1755+l.val) := by
  change (_ ∧ _ ∧ _) ∨ (_ ∧ _ ∧ _) ↔ _
  have hp := p.isLt
  simp only [point, line]
  constructor
  · intro h; rcases h with h | h
    · exact h.2.2
    · omega
  · intro h; exact Or.inl ⟨hp, by omega, h⟩

theorem point_point_not_adj (p q : Fin 1755) : ¬ graph.Adj (point p) (point q) := by
  change ¬ ((_ ∧ _ ∧ _) ∨ (_ ∧ _ ∧ _))
  have hp := p.isLt; have hq := q.isLt
  simp only [point]
  omega

theorem line_line_not_adj (p q : Fin 2925) : ¬ graph.Adj (line p) (line q) := by
  change ¬ ((_ ∧ _ ∧ _) ∨ (_ ∧ _ ∧ _))
  simp only [line]
  omega

