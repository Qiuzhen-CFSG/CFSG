def points (i : Fin 2925) : List ℕ := FiniteGraph.adjacency (1755+i.val)
def move (a : Letter ParrottGenerator) (p : ℕ) : ℕ :=
  (R1Certificate.table ⟨p % 1755, Nat.mod_lt _ (by decide)⟩ a).val

def keyOf (s : Finset ℕ) : ℕ :=
  s.sum id + 8192 * s.sum (fun p => p*p) + 137438953472 * s.prod id

def Valid (i : Fin 2925) : Prop :=
  (points i).Forall (fun p => p < 1755) ∧
  keyInverse (keyOf (points i).toFinset) = i.val ∧
  (if i.val = 0 then points i = [0,1,3] else
    (parent i).val < i.val ∧
    ((points (parent i)).map (move (letter i))).toFinset = (points i).toFinset)

instance (i : Fin 2925) : Decidable (Valid i) := by unfold Valid; infer_instance

