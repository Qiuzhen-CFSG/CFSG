module

public import Theory.SpecificGroups.ReeF4.FiniteCarrier

/-!
# Entrywise Frobenius on the finite split F4 group

The integral divided-power coefficients are fixed by every coefficient ring
homomorphism. Thus entrywise Frobenius sends the root curve `x_r(t)` to
`x_r(t²)`. Subgroup-closure induction restricts this matrix-unit homomorphism
to the split F4 carrier. Injectivity on entries and finiteness then give a
multiplicative equivalence.

This is the field-automorphism construction for root-generated Chevalley groups
in Steinberg, *Lectures on Chevalley Groups*. It supplies the squaring map used
in the exceptional characteristic-two construction of the large Ree groups.
-/

open scoped Matrix

@[expose] public section

namespace ReeF4

open Theory.AlgebraicGroup
open RootPairing.IntegralGeckConstruction

/-- Entrywise squaring as a ring homomorphism on the matrix algebra. -/
noncomputable def matrixFrobenius (m : ℕ) : MatrixCarrier m →+* MatrixCarrier m :=
  (frobenius (CoefficientField m) 2).mapMatrix

@[simp] theorem matrixFrobenius_entry (m : ℕ) (x : MatrixCarrier m)
    (i j : F4Chevalley.BasisIndex) :
    matrixFrobenius m x i j = x i j ^ 2 := rfl

/-- The induced homomorphism on matrix units. -/
noncomputable def matrixUnitsFrobenius (m : ℕ) : MatrixUnits m →* MatrixUnits m :=
  Units.map (matrixFrobenius m).toMonoidHom

@[simp] theorem matrixUnitsFrobenius_entry (m : ℕ) (x : MatrixUnits m)
    (i j : F4Chevalley.BasisIndex) :
    (matrixUnitsFrobenius m x : MatrixCarrier m) i j =
      (x : MatrixCarrier m) i j ^ 2 := rfl

/-- Naturality of root curves under coefficient field homomorphisms. -/
theorem rootCurve_map (m : ℕ)
    (f : CoefficientField m →+* CoefficientField m)
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    Units.map f.mapMatrix.toMonoidHom (F4Chevalley.rootCurve r t) =
      F4Chevalley.rootCurve r (f t) := by
  apply Units.ext
  change (↑(F4Chevalley.rootCurve r t) : MatrixCarrier m).map f = _
  rw [F4Chevalley.rootCurve_matrix_formula, F4Chevalley.rootCurve_matrix_formula]
  ext i j
  simp [Matrix.map_apply, Matrix.add_apply, Matrix.smul_apply,
    specializeMatrix, Matrix.one_apply, apply_ite f]

@[simp] theorem matrixUnitsFrobenius_rootCurve (m : ℕ)
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    matrixUnitsFrobenius m (F4Chevalley.rootCurve r t) =
      F4Chevalley.rootCurve r (t ^ 2) :=
  rootCurve_map m (frobenius (CoefficientField m) 2) r t

theorem matrixUnitsFrobenius_mem (m : ℕ) {x : MatrixUnits m}
    (hx : x ∈ SplitGroup m) : matrixUnitsFrobenius m x ∈ SplitGroup m := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
      rcases hx with ⟨⟨r, t⟩, rfl⟩
      simpa only [rootGenerator_apply, matrixUnitsFrobenius_rootCurve] using
        rootGenerator_mem m (r, t ^ 2)
  | one => simp
  | mul x y _ _ hx hy => simpa using (SplitGroup m).mul_mem hx hy
  | inv x _ hx => simpa using (SplitGroup m).inv_mem hx

/-- Entrywise Frobenius restricted to the group generated by the root curves. -/
noncomputable def splitFrobenius (m : ℕ) : SplitGroup m →* SplitGroup m :=
  ((matrixUnitsFrobenius m).comp (SplitGroup m).subtype).codRestrict
    (SplitGroup m) (fun x => matrixUnitsFrobenius_mem m x.property)

@[simp] theorem splitFrobenius_coe (m : ℕ) (x : SplitGroup m) :
    (splitFrobenius m x : MatrixUnits m) = matrixUnitsFrobenius m x.val := rfl

@[simp] theorem splitFrobenius_rootGenerator (m : ℕ)
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    splitFrobenius m (rootGeneratorInGroup m r t) =
      rootGeneratorInGroup m r (t ^ 2) := by
  apply Subtype.ext
  exact matrixUnitsFrobenius_rootCurve m r t

@[simp] theorem splitFrobenius_entry (m : ℕ) (x : SplitGroup m)
    (i j : F4Chevalley.BasisIndex) :
    ((splitFrobenius m x).val : MatrixCarrier m) i j =
      (x.val : MatrixCarrier m) i j ^ 2 := rfl

theorem splitFrobenius_injective (m : ℕ) : Function.Injective (splitFrobenius m) := by
  intro x y h
  apply Subtype.ext
  apply Units.ext
  ext i j
  apply (frobenius (CoefficientField m) 2).injective
  exact congrArg (fun z : SplitGroup m => (z.val : MatrixCarrier m) i j) h

theorem splitFrobenius_bijective (m : ℕ) : Function.Bijective (splitFrobenius m) :=
  Finite.injective_iff_bijective.mp (splitFrobenius_injective m)

/-- The field automorphism of the finite split F4 group. -/
noncomputable def splitFrobeniusEquiv (m : ℕ) : SplitGroup m ≃* SplitGroup m :=
  MulEquiv.ofBijective (splitFrobenius m) (splitFrobenius_bijective m)

@[simp] theorem splitFrobeniusEquiv_apply (m : ℕ) (x : SplitGroup m) :
    splitFrobeniusEquiv m x = splitFrobenius m x := rfl

@[simp] theorem splitFrobeniusEquiv_rootGenerator (m : ℕ)
    (r : F4Chevalley.Root) (t : CoefficientField m) :
    splitFrobeniusEquiv m (rootGeneratorInGroup m r t) =
      rootGeneratorInGroup m r (t ^ 2) :=
  splitFrobenius_rootGenerator m r t

@[simp] theorem splitFrobeniusEquiv_entry (m : ℕ) (x : SplitGroup m)
    (i j : F4Chevalley.BasisIndex) :
    ((splitFrobeniusEquiv m x).val : MatrixCarrier m) i j =
      (x.val : MatrixCarrier m) i j ^ 2 := rfl

end ReeF4
