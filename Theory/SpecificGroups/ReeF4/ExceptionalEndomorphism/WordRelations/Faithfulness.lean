module

public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Coordinates
public import Theory.SpecificGroups.ReeF4.Field
public import Theory.AlgebraicGroup.RootSystems.AlgebraicGroups.F4IntegralChevalleyRepresentation
public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Faithfulness.RestrictedAdjoint.Transport
public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Faithfulness.RestrictedAdjoint.Unconditional
public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Faithfulness.ShortOperators

/-!
# Faithfulness assembly on the short F4 ideal

If a matrix fixes the short ideal, restricted adjoint transport makes it commute
with each short root operator. The images of these operators lie in that ideal,
so every short root operator kills every displacement of the matrix. Their
proved zero common kernel forces the matrix to be the identity on all 52
coordinates.

The operator geometry and restricted transport are proved for the actual
routed Geck operators. The final theorems discharge both coefficient premises
and establish faithfulness for the subgroup generated by all root curves, in
both the comparison-matrix and coordinate-vector formulations. The short ideal
contains every geometrically short root coordinate and the simple Cartan
coordinates numbered 2 and 3. No simplicity or exceptional endomorphism is used.

The representation is Geck's integral Cartan-plus-root construction, following
Steinberg's *Lectures on Chevalley Groups*, specialized to the Ree fields.
-/

public section

open scoped Classical Matrix
open Theory.AlgebraicGroup StandardRootSystem

namespace ReeF4.WordRelations.Faithfulness

open Adjoint Adjoint.PositiveSimple RestrictedAdjoint

/-- Restricted adjoint transport and the proved short-operator geometry detect
every matrix fixing the short ideal, including its action on long coordinates. -/
theorem eq_one_of_short_adjoint_transport (m : ℕ)
    (g : (Matrix Coordinate Coordinate (CoefficientField m))ˣ)
    (heq : EquivariantOnShort m g)
    (hfix : (g : Matrix Coordinate Coordinate (CoefficientField m)) * quotientToIdeal =
      quotientToIdeal) : g = 1 := by
  let E (s : typeF4Roots) := (F4Chevalley.integralOperators.rootOperator s).map
    (Int.castRingHom (CoefficientField m))
  have hcolumns := (mul_quotientToIdeal_eq_iff _).mp hfix
  have hcomm (s : typeF4Roots) (hs : IsShortRoot s) : E s * g = g * E s := by
    have h := heq (Pi.single (Sum.inr s) 1) (shortSupported_single _ hs)
    have hfixed : (g : Matrix Coordinate Coordinate (CoefficientField m)) *ᵥ
        Pi.single (Sum.inr s) 1 = Pi.single (Sum.inr s) 1 :=
      fixes_supported_vector IsShortCoordinate _ hcolumns _ (shortSupported_single _ hs)
    simpa only [hfixed, adjointMap_root_single] using h
  have hleft (s : typeF4Roots) (hs : IsShortRoot s) :
      (g : Matrix Coordinate Coordinate (CoefficientField m)) * E s = E s := by
    ext i j
    exact congrFun (fixes_supported_vector IsShortCoordinate _ hcolumns
      (fun k => E s k j) (fun k hk =>
        ShortOperators.coefficientField_rootOperator_image m s hs k hk j)) i
  have hright (s : typeF4Roots) (hs : IsShortRoot s) :
      E s * (g : Matrix Coordinate Coordinate (CoefficientField m)) = E s :=
    (hcomm s hs).trans (hleft s hs)
  apply Units.ext
  have hm : (g : Matrix Coordinate Coordinate (CoefficientField m)) - 1 = 0 := by
    ext i j
    have hz := ShortOperators.coefficientField_rootOperator_commonKernel m
      (fun k => ((g : Matrix Coordinate Coordinate (CoefficientField m)) - 1) k j) (by
        intro s hs
        have hprod : E s * ((g : Matrix Coordinate Coordinate (CoefficientField m)) - 1) = 0 := by
          rw [mul_sub, hright s hs, mul_one, sub_self]
        exact congrArg (fun A : Matrix Coordinate Coordinate (CoefficientField m) =>
          fun k => A k j) hprod)
    exact congrFun hz i
  exact sub_eq_zero.mp hm

/-- Assembly for the actual all-root generated group, conditional precisely on
the first two short-root coefficient families. -/
theorem eq_one_of_short_coefficients (m : ℕ)
    (h1 : ∀ (i : typeF4RootPairing_base.support) (r : typeF4Roots), IsShortRoot r →
      CoefficientIdentity m i (Sum.inr r) 1)
    (h2 : ∀ (i : typeF4RootPairing_base.support) (r : typeF4Roots), IsShortRoot r →
      CoefficientIdentity m i (Sum.inr r) 2)
    (g : (Matrix Coordinate Coordinate (CoefficientField m))ˣ)
    (hg : g ∈ Subgroup.closure (Set.range
      (fun rt : F4Chevalley.Root × CoefficientField m => F4Chevalley.rootCurve rt.1 rt.2)))
    (hfix : (g : Matrix Coordinate Coordinate (CoefficientField m)) * quotientToIdeal =
      quotientToIdeal) : g = 1 :=
  eq_one_of_short_adjoint_transport m g
    (generated_equivariantOnShort_of_coefficients m h1 h2 g hg) hfix

/-- The coordinate-vector formulation of the same conditional assembly. -/
theorem eq_one_of_fixes_short_coordinates_of_coefficients (m : ℕ)
    (h1 : ∀ (i : typeF4RootPairing_base.support) (r : typeF4Roots), IsShortRoot r →
      CoefficientIdentity m i (Sum.inr r) 1)
    (h2 : ∀ (i : typeF4RootPairing_base.support) (r : typeF4Roots), IsShortRoot r →
      CoefficientIdentity m i (Sum.inr r) 2)
    (g : (Matrix Coordinate Coordinate (CoefficientField m))ˣ)
    (hg : g ∈ Subgroup.closure (Set.range
      (fun rt : F4Chevalley.Root × CoefficientField m => F4Chevalley.rootCurve rt.1 rt.2)))
    (hfix : ∀ j, IsShortCoordinate j →
      (g : Matrix Coordinate Coordinate (CoefficientField m)) *ᵥ Pi.single j 1 = Pi.single j 1) :
    g = 1 := by
  apply eq_one_of_short_coefficients m h1 h2 g hg
  apply (mul_quotientToIdeal_eq_iff _).mpr
  intro j hj i
  have h := congrFun (hfix j hj) i
  simpa only [Matrix.mulVec_single_one, Matrix.col_apply, Pi.single_apply] using h

/-- The actual root-generated F4 matrix group acts faithfully on the short
ideal, expressed as the image of the quotient-to-ideal comparison matrix. -/
theorem eq_one_of_mul_quotientToIdeal_eq (m : ℕ)
    (g : (Matrix Coordinate Coordinate (CoefficientField m))ˣ)
    (hg : g ∈ Subgroup.closure (Set.range
      (fun rt : F4Chevalley.Root × CoefficientField m => F4Chevalley.rootCurve rt.1 rt.2)))
    (hfix : (g : Matrix Coordinate Coordinate (CoefficientField m)) * quotientToIdeal =
      quotientToIdeal) : g = 1 :=
  eq_one_of_short_adjoint_transport m g (generated_equivariantOnShort m g hg) hfix

/-- Fixing every geometrically short root vector and both short simple Cartan
vectors forces an element of the actual root-generated F4 group to be one. -/
theorem eq_one_of_fixes_short_coordinates (m : ℕ)
    (g : (Matrix Coordinate Coordinate (CoefficientField m))ˣ)
    (hg : g ∈ Subgroup.closure (Set.range
      (fun rt : F4Chevalley.Root × CoefficientField m => F4Chevalley.rootCurve rt.1 rt.2)))
    (hfix : ∀ j, IsShortCoordinate j →
      (g : Matrix Coordinate Coordinate (CoefficientField m)) *ᵥ Pi.single j 1 = Pi.single j 1) :
    g = 1 := by
  apply eq_one_of_mul_quotientToIdeal_eq m g hg
  apply (mul_quotientToIdeal_eq_iff _).mpr
  intro j hj i
  have h := congrFun (hfix j hj) i
  simpa only [Matrix.mulVec_single_one, Matrix.col_apply, Pi.single_apply] using h

end ReeF4.WordRelations.Faithfulness
