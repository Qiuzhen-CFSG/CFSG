module

public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Faithfulness.RestrictedAdjoint.Positive
public import Theory.AlgebraicGroup.RootSystems.IntegralRootCurveSimpleGeneration

/-!
# Restricted adjoint transport through the actual generated group

Restricted equivariance is closed under products and inverses when both the
matrix and its inverse preserve short support. Opposition supplies negative
simple transport from positive simple transport. The equality of the actual
all-root subgroup and the simple-curve subgroup then gives transport for every
generated matrix, conditional only on the first two short-root coefficients.

The generation theorem uses the canonical integral Tits routes, with the
conventions of Geck's construction and Steinberg's Chevalley groups.
-/

@[expose] public section

open scoped Matrix
open Theory.AlgebraicGroup StandardRootSystem
open RootPairing.IntegralGeckConstruction RootPairing.SimpleGeckGroup

namespace ReeF4.WordRelations.Faithfulness.RestrictedAdjoint

open Adjoint Adjoint.PositiveSimple

variable {K : Type*} [CommRing K]

/-- Preservation of the actual short-coordinate subspace. -/
def PreservesShort (g : (Matrix Coordinate Coordinate K)ˣ) : Prop :=
  ∀ v, ShortSupported v → ShortSupported ((g : Matrix Coordinate Coordinate K) *ᵥ v)

theorem preservesShort_one : PreservesShort (1 : (Matrix Coordinate Coordinate K)ˣ) := by
  intro v hv
  simpa only [Units.val_one, Matrix.one_mulVec] using hv

theorem preservesShort_mul {g h : (Matrix Coordinate Coordinate K)ˣ}
    (hg : PreservesShort g) (hh : PreservesShort h) : PreservesShort (g * h) := by
  intro v hv
  simpa only [Units.val_mul, ← Matrix.mulVec_mulVec] using hg _ (hh v hv)

theorem equivariantOnShort_mul (m : ℕ)
    (g h : (Matrix Coordinate Coordinate (CoefficientField m))ˣ)
    (hhp : PreservesShort h) (hg : EquivariantOnShort m g) (hh : EquivariantOnShort m h) :
    EquivariantOnShort m (g * h) := by
  intro v hv
  change adjointMap m (((g : Matrix Coordinate Coordinate (CoefficientField m)) *
      (h : Matrix Coordinate Coordinate (CoefficientField m))) *ᵥ v) *
      ((g : Matrix Coordinate Coordinate (CoefficientField m)) * h) =
    ((g : Matrix Coordinate Coordinate (CoefficientField m)) * h) * adjointMap m v
  rw [← Matrix.mulVec_mulVec, ← mul_assoc, hg _ (hhp v hv), mul_assoc, hh v hv,
    ← mul_assoc]

theorem equivariantOnShort_inv (m : ℕ)
    (g : (Matrix Coordinate Coordinate (CoefficientField m))ˣ)
    (hgp : PreservesShort g⁻¹) (hg : EquivariantOnShort m g) :
    EquivariantOnShort m g⁻¹ := by
  intro v hv
  have h := hg ((↑g⁻¹ : Matrix Coordinate Coordinate (CoefficientField m)) *ᵥ v) (hgp v hv)
  rw [Matrix.mulVec_mulVec, Units.mul_inv, Matrix.one_mulVec] at h
  apply (Units.mul_right_inj g).mp
  simp only [← mul_assoc, ← h, Units.mul_inv_cancel_right, Units.mul_inv, one_mul]

/-- The subgroup of matrices preserving the short ideal and its adjoint transport. -/
def transportSubgroup (m : ℕ) :
    Subgroup (Matrix Coordinate Coordinate (CoefficientField m))ˣ where
  carrier := {g | PreservesShort g ∧ PreservesShort g⁻¹ ∧ EquivariantOnShort m g}
  one_mem' := ⟨preservesShort_one, by simpa using preservesShort_one, by
    intro v _; simp⟩
  mul_mem' := by
    intro g h hg hh
    exact ⟨preservesShort_mul hg.1 hh.1,
      by simpa only [mul_inv_rev] using preservesShort_mul hh.2.1 hg.2.1,
      equivariantOnShort_mul m g h hh.1 hg.2.2 hh.2.2⟩
  inv_mem' := by
    intro g hg
    exact ⟨hg.2.1, by simpa only [inv_inv] using hg.1,
      equivariantOnShort_inv m g hg.2.1 hg.2.2⟩

theorem omega_mem_transportSubgroup (m : ℕ) :
    omegaUnit (K := CoefficientField m) ∈ transportSubgroup m := by
  refine ⟨fun _ hv => shortSupported_omega hv, ?_, ?_⟩
  · intro v hv
    simpa only [omegaUnit_inv_val] using shortSupported_omega hv
  · intro v _
    exact omega_equivariant m v

/-- Negative restricted transport follows from positive transport by opposition. -/
theorem negative_equivariantOnShort_of_positive
    (m : ℕ) (i : typeF4RootPairing_base.support) (t : CoefficientField m)
    (hp : EquivariantOnShort m (positiveUnit i t)) :
    EquivariantOnShort m (negativeUnit i t) := by
  have he : positiveUnit i t ∈ transportSubgroup m :=
    ⟨fun _ hv => shortSupported_positive i t hv,
      by simpa only [positiveUnit_inv] using
        (show PreservesShort (positiveUnit i (-t)) from
          fun _ hv => shortSupported_positive i (-t) hv), hp⟩
  have ho := omega_mem_transportSubgroup m
  have h := (transportSubgroup m).mul_mem ((transportSubgroup m).mul_mem ho he)
    ((transportSubgroup m).inv_mem ho)
  rw [← negativeUnit_eq_omega_conjugate] at h
  exact h.2.2

/-- Every matrix generated by the actual root curves has restricted adjoint
transport once the first two short-root coefficient families are supplied. -/
theorem generated_equivariantOnShort_of_coefficients
    (m : ℕ)
    (h1 : ∀ (i : typeF4RootPairing_base.support) (r : typeF4Roots), IsShortRoot r →
      CoefficientIdentity m i (Sum.inr r) 1)
    (h2 : ∀ (i : typeF4RootPairing_base.support) (r : typeF4Roots), IsShortRoot r →
      CoefficientIdentity m i (Sum.inr r) 2)
    (g : (Matrix Coordinate Coordinate (CoefficientField m))ˣ)
    (hg : g ∈ Subgroup.closure (Set.range
      (fun rt : F4Chevalley.Root × CoefficientField m => F4Chevalley.rootCurve rt.1 rt.2))) :
    EquivariantOnShort m g := by
  have hpos (i : typeF4RootPairing_base.support) (t : CoefficientField m) :
      positiveUnit i t ∈ transportSubgroup m :=
    ⟨fun _ hv => shortSupported_positive i t hv,
      by simpa only [positiveUnit_inv] using
        (show PreservesShort (positiveUnit i (-t)) from
          fun _ hv => shortSupported_positive i (-t) hv),
      positive_equivariantOnShort_of_coefficients m i t (h1 i) (h2 i)⟩
  have hneg (i : typeF4RootPairing_base.support) (t : CoefficientField m) :
      negativeUnit i t ∈ transportSubgroup m :=
    ⟨fun _ hv => shortSupported_negative i t hv,
      by simpa only [negativeUnit_inv] using
        (show PreservesShort (negativeUnit i (-t)) from
          fun _ hv => shortSupported_negative i (-t) hv),
      negative_equivariantOnShort_of_positive m i t (hpos i t).2.2⟩
  have hle : RootPairing.SimpleGeckGroup.subgroup typeF4RootPairing_base (CoefficientField m) ≤
      transportSubgroup m := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨s, i⟩, t, rfl⟩
    cases s
    · exact hneg i t
    · exact hpos i t
  change g ∈ allRootCurveSubgroup typeF4RootPairing_base (CoefficientField m) at hg
  rw [allRootCurveSubgroup_eq_simpleSubgroup] at hg
  exact (hle hg).2.2

end ReeF4.WordRelations.Faithfulness.RestrictedAdjoint
