module

public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Faithfulness.RestrictedAdjoint.Transport
public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Faithfulness.AdjointEquivariance.PositiveSimple.RootLinear
public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Faithfulness.AdjointEquivariance.PositiveSimple.RootHigher

/-!
# Unconditional adjoint transport on the short F4 ideal

The proved degree-one root coefficients discharge the premise of the quadratic
coefficient theorem. Restricting both coefficient families to short roots then
gives adjoint transport on the short-coordinate subspace for every element of
the subgroup generated by the actual F4 root curves. Support invariance,
opposition and generation by simple curves are proved in `Transport`.

All operators are the routed operators of Geck's integral Cartan-plus-root
construction, following Steinberg's *Lectures on Chevalley Groups*. Neither
simplicity nor an exceptional endomorphism is assumed.
-/

public section

open Theory.AlgebraicGroup

namespace ReeF4.WordRelations.Faithfulness.RestrictedAdjoint

open Adjoint.PositiveSimple

/-- Every matrix in the actual root-generated group intertwines the adjoint
map on the short-coordinate ideal, with all coefficient premises discharged. -/
theorem generated_equivariantOnShort
    (m : ℕ)
    (g : (Matrix Coordinate Coordinate (CoefficientField m))ˣ)
    (hg : g ∈ Subgroup.closure (Set.range
      (fun rt : F4Chevalley.Root × CoefficientField m => F4Chevalley.rootCurve rt.1 rt.2))) :
    EquivariantOnShort m g :=
  generated_equivariantOnShort_of_coefficients m
    (fun i r _ => positive_root_coefficient_one m i r)
    (fun i r _ => (positive_root_coefficients_two_four m i
      (positive_root_coefficient_one m i)).1 r) g hg

end ReeF4.WordRelations.Faithfulness.RestrictedAdjoint
