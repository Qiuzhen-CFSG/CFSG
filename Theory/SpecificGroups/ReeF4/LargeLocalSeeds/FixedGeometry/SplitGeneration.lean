module

public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.RootSubgroups
public import Theory.AlgebraicGroup.RootSystems.IntegralRootCurveSimpleGeneration

/-!
# Generation by the two split Ree local factors

The two exceptional node orbits partition the four simple nodes. Their split
seeds therefore contain every negative simple root curve, as well as all
positive root curves. The checked integral Tits-word formulas express every
root curve in the subgroup generated by the signed simple curves. Hence the
two split seeds generate the actual split F₄ matrix carrier.

This is only the split generation step. The analogous assertion for fixed
subgroups requires a separate argument. Source: Steinberg, *Lectures on
Chevalley Groups*, the root-generation construction; Aschbacher–Smith
F.1.12(I)(5), printed pp.263–264 of `refs/quasithin.pdf`.
-/

public section

namespace ReeF4.LargeLocalSeeds
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem Subgroup
open RootPairing.IntegralGeckConstruction
noncomputable local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg

private theorem mem_leviNodes_either (i : Fin 4) :
    i ∈ leviNodes .suzuki ∨ i ∈ leviNodes .linear := by
  fin_cases i <;> simp [leviNodes]

/-- The two split root-defined seeds generate the split matrix group. -/
theorem splitSeed_sup_eq_top (m : ℕ) :
    splitSeed m .suzuki ⊔ splitSeed m .linear = ⊤ := by
  let H := splitSeed m .suzuki ⊔ splitSeed m .linear
  have hpos (r : F4Chevalley.Root) (t : CoefficientField m)
      (hr : typeF4RootPairing_base.IsPos r) : rootGeneratorInGroup m r t ∈ H :=
    Subgroup.mem_sup_left (Subgroup.subset_closure ⟨r, t, Or.inl hr, rfl⟩)
  have hneg (i : Fin 4) (t : CoefficientField m) :
      rootGeneratorInGroup m (-typeF4SimpleRootIndex i) t ∈ H := by
    rcases mem_leviNodes_either i with hi | hi
    · exact Subgroup.mem_sup_left (Subgroup.subset_closure
        ⟨_, t, Or.inr ⟨i, hi, rfl⟩, rfl⟩)
    · exact Subgroup.mem_sup_right (Subgroup.subset_closure
        ⟨_, t, Or.inr ⟨i, hi, rfl⟩, rfl⟩)
  have hs : allRootCurveSubgroup typeF4RootPairing_base (CoefficientField m) ≤
      H.map (SplitGroup m).subtype := by
    rw [allRootCurveSubgroup_eq_simpleSubgroup]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨s, i⟩, t, rfl⟩
    cases s
    · change RootPairing.SimpleGeckGroup.negativeUnit i t ∈ _
      rw [← rootCurveUnit_neg_simple]
      obtain ⟨j, rfl⟩ := typeF4RootPairing_baseEquiv.surjective i
      exact ⟨rootGeneratorInGroup m (-typeF4SimpleRootIndex j) t, hneg j t, rfl⟩
    · change RootPairing.SimpleGeckGroup.positiveUnit i t ∈ _
      rw [← rootCurveUnit_simple]
      exact ⟨rootGeneratorInGroup m i t,
        hpos i t (typeF4RootPairing_base.isPos_of_mem_support i.property), rfl⟩
  apply top_unique
  intro x _
  have hx : (x : MatrixUnits m) ∈ allRootCurveSubgroup typeF4RootPairing_base
      (CoefficientField m) := x.property
  obtain ⟨y, hy, he⟩ := hs hx
  exact (Subtype.ext he : y = x) ▸ hy

end ReeF4.LargeLocalSeeds

end
