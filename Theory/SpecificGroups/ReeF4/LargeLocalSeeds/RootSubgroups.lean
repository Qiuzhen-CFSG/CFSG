module

public import Theory.SpecificGroups.ReeF4.LocalBlockInput
public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.RootDuality.Negation

/-!
# Root subgroups for the two large Ree local factors

The middle nodes of the numbered F₄ diagram form the B₂ Levi subsystem;
the two end nodes form A₁ × A₁. The exceptional involution preserves each
pair. Adjoin the corresponding negative simple root groups to the positive
unipotent group, then take fixed points of the exceptional field twist.
These are candidates for the local factors with Suzuki and SL₂ quotients,
respectively. No complementary parabolic torus is adjoined.

The declarations here establish twist stability and containment only. The
Sylow, generation, quotient and radical calculations are separate theorems.
In particular, taking fixed points does not automatically preserve generation.

Source: Aschbacher–Smith, F.1.12(I)(5) and (II), printed pp.263–264;
the root construction uses the standard exceptional F₄ twist.
-/

@[expose] public section

namespace ReeF4.LargeLocalSeeds

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem Subgroup

noncomputable local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg

/-- The two orbits of simple nodes under exceptional diagram reversal. -/
inductive Side where
  | suzuki
  | linear
  deriving DecidableEq

def leviNodes : Side → Set (Fin 4)
  | .suzuki => {1, 2}
  | .linear => {0, 3}

theorem rev_mem_leviNodes (s : Side) (i : Fin 4) :
    Fin.revPerm i ∈ leviNodes s ↔ i ∈ leviNodes s := by
  cases s <;> fin_cases i <;> simp [leviNodes, Fin.revPerm, Fin.rev]

/-- Positive roots together with the opposite simple roots in the Levi pair. -/
def IsSeedRoot (s : Side) (r : F4Chevalley.Root) : Prop :=
  typeF4RootPairing_base.IsPos r ∨
    ∃ i ∈ leviNodes s, r = -typeF4SimpleRootIndex i

private theorem positive_duality (r : F4Chevalley.Root) :
    typeF4RootPairing_base.IsPos r ↔
      typeF4RootPairing_base.IsPos (exceptionalRootPermutation r) :=
  ((typeF4RootPairing.isPositiveRootDuality_iff
    typeF4RootPairing_base exceptionalRootPermutation).mp
      exceptionalRootPermutation_spec).2.1 r

theorem isSeedRoot_duality (s : Side) (r : F4Chevalley.Root)
    (hr : IsSeedRoot s r) : IsSeedRoot s (exceptionalRootPermutation r) := by
  rcases hr with hp | ⟨i, hi, rfl⟩
  · exact Or.inl ((positive_duality r).mp hp)
  · exact Or.inr ⟨Fin.revPerm i, (rev_mem_leviNodes s i).mpr hi,
      exceptionalRootPermutation_neg_simple i⟩

/-- The split positive root subgroup, inside the actual matrix carrier. -/
noncomputable def splitUnipotent (m : ℕ) : Subgroup (SplitGroup m) :=
  closure {x | ∃ (r : F4Chevalley.Root) (t : CoefficientField m),
    typeF4RootPairing_base.IsPos r ∧ x = rootGeneratorInGroup m r t}

/-- The split local factor generated by U and the selected negative roots. -/
noncomputable def splitSeed (m : ℕ) (s : Side) : Subgroup (SplitGroup m) :=
  closure {x | ∃ (r : F4Chevalley.Root) (t : CoefficientField m),
    IsSeedRoot s r ∧ x = rootGeneratorInGroup m r t}

theorem splitUnipotent_le_splitSeed (m : ℕ) (s : Side) :
    splitUnipotent m ≤ splitSeed m s := by
  apply Subgroup.closure_mono
  rintro x ⟨r, t, hr, rfl⟩
  exact ⟨r, t, Or.inl hr, rfl⟩

private theorem twist_map_eq_of_le {m : ℕ} (d : LocalBlockInput m)
    (K : Subgroup (SplitGroup m)) (hK : K.map d.twist.toMonoidHom ≤ K) :
    K.map d.twist.toMonoidHom = K := by
  apply le_antisymm hK
  intro x hx
  refine ⟨d.twist x, hK (mem_map_of_mem _ hx), ?_⟩
  change d.twist (d.twist x) = x
  have he := DFunLike.congr_fun d.twist_sq x
  simpa only [pow_two, MulAut.mul_apply, MulAut.one_apply] using he

theorem splitUnipotent_twist {m : ℕ} (d : LocalBlockInput m) :
    (splitUnipotent m).map d.twist.toMonoidHom = splitUnipotent m := by
  apply twist_map_eq_of_le d
  rw [map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro x ⟨r, t, hr, rfl⟩
  change d.twist (rootGeneratorInGroup m r t) ∈ splitUnipotent m
  rw [d.twist_root]
  exact Subgroup.subset_closure ⟨_, _, (positive_duality r).mp hr, rfl⟩

theorem splitSeed_twist {m : ℕ} (d : LocalBlockInput m) (s : Side) :
    (splitSeed m s).map d.twist.toMonoidHom = splitSeed m s := by
  apply twist_map_eq_of_le d
  rw [map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro x ⟨r, t, hr, rfl⟩
  change d.twist (rootGeneratorInGroup m r t) ∈ splitSeed m s
  rw [d.twist_root]
  exact Subgroup.subset_closure ⟨_, _, isSeedRoot_duality s r hr, rfl⟩

/-- The concrete positive fixed subgroup. Its Sylow property is not assumed. -/
noncomputable def standardUnipotent {m : ℕ} (d : LocalBlockInput m) :
    Subgroup d.fixedGroup := (splitUnipotent m).subgroupOf d.fixedGroup

/-- The concrete fixed local factors, before conjugating to a supplied Sylow. -/
noncomputable def standardSeed {m : ℕ} (d : LocalBlockInput m) (s : Side) :
    Subgroup d.fixedGroup := (splitSeed m s).subgroupOf d.fixedGroup

theorem standardUnipotent_le_seed {m : ℕ} (d : LocalBlockInput m) (s : Side) :
    standardUnipotent d ≤ standardSeed d s :=
  fun _ hx => splitUnipotent_le_splitSeed m s hx

/-- Positive roots outside the selected Levi subsystem. -/
def IsRadicalRoot (s : Side) (r : F4Chevalley.Root) : Prop :=
  typeF4RootPairing_base.IsPos r ∧
    ∃ i, i ∉ leviNodes s ∧ typeF4SimpleCoefficient r.val i ≠ 0

/-- A specified root-generated radical candidate, not a definition by O₂. -/
noncomputable def splitRadical (m : ℕ) (s : Side) : Subgroup (SplitGroup m) :=
  closure {x | ∃ (r : F4Chevalley.Root) (t : CoefficientField m),
    IsRadicalRoot s r ∧ x = rootGeneratorInGroup m r t}

theorem splitRadical_le_unipotent (m : ℕ) (s : Side) :
    splitRadical m s ≤ splitUnipotent m := by
  apply Subgroup.closure_mono
  rintro x ⟨r, t, hr, rfl⟩
  exact ⟨r, t, hr.1, rfl⟩

noncomputable def standardRadical {m : ℕ} (d : LocalBlockInput m) (s : Side) :
    Subgroup d.fixedGroup := (splitRadical m s).subgroupOf d.fixedGroup

theorem standardRadical_le_unipotent {m : ℕ} (d : LocalBlockInput m) (s : Side) :
    standardRadical d s ≤ standardUnipotent d :=
  fun _ hx => splitRadical_le_unipotent m s hx

theorem standardRadical_le_seed {m : ℕ} (d : LocalBlockInput m) (s : Side) :
    standardRadical d s ≤ standardSeed d s :=
  (standardRadical_le_unipotent d s).trans (standardUnipotent_le_seed d s)

/-- The root-defined radical viewed inside its local factor. Identifying this
subgroup with the intrinsic two-core is a separate calculation. -/
noncomputable def seedRadical {m : ℕ} (d : LocalBlockInput m) (s : Side) :
    Subgroup (standardSeed d s) :=
  (standardRadical d s).subgroupOf (standardSeed d s)

theorem seedRadical_map {m : ℕ} (d : LocalBlockInput m) (s : Side) :
    (seedRadical d s).map (standardSeed d s).subtype = standardRadical d s :=
  map_subgroupOf_eq_of_le (standardRadical_le_seed d s)

end ReeF4.LargeLocalSeeds

end
