module

public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.LinearCore.CommutatorGeneration.FixedGenerators
public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.LinearCore.CommutatorGeneration.CentralQuotient
public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.LinearCore.CommutatorGeneration.TorusAction
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.OuterLocal.SuzukiCommutators.NormalGeneration.MatrixRelations
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# The linear Ree radical is generated by local commutators

For a large Ree field, let K be the fixed seed with end-node A₁ × A₁ Levi
and R its specified root radical. We prove R ≤ [R,K]. The commutator [R,K]
is normal in K without requiring normality of R. In its quotient all radical
curves are central. The literal Ree root relations and the end-node torus
then kill all seven main curves. The fixed-coordinate generation theorem
covers every radical element, including the B₂ central parameters.

This supplies the independent commutator input to `LinearCore.Reduction`.
No projection, perfectness, intrinsic two-core or block exclusion is assumed.

Source: Aschbacher–Smith F.1.12(II), printed pp.263–264 (PDF pp.274–275),
and the root equations in GLS3 2.4.5(d) and Table 2.4.
-/

public section
noncomputable section
namespace ReeF4.LargeLocalSeeds
open LinearCommutators Subgroup
open Parabolics.OuterLocal.SuzukiCommutators.NormalGeneration
open scoped commutatorElement

private theorem exists_scalar {m : ℕ} (hm : 1 ≤ m) :
    ∃ c : CoefficientField m, c ≠ 0 ∧ c ≠ 1 := by
  classical
  by_contra! h
  have hsub : (Finset.univ : Finset (CoefficientField m)) ⊆ {0, 1} := by
    intro t _
    by_cases ht : t = 0
    · simp [ht]
    · simp [h t ht]
  have hcard := Finset.card_le_card hsub
  have hlarge : 2 ^ 3 ≤ 2 ^ (2 * m + 1) :=
    Nat.pow_le_pow_right (by decide) (by omega)
  simp only [Finset.card_univ, Finset.card_insert_of_notMem (by simp :
    (0 : CoefficientField m) ∉ ({1} : Finset (CoefficientField m))),
    Finset.card_singleton, ← Nat.card_eq_fintype_card, field_card] at hcard
  omega

/-- Every element of the actual fixed linear radical is generated by its
commutators with the fixed linear seed, for all large Ree fields. -/
theorem seedRadical_linear_le_commutator {m : ℕ} (hm : 1 ≤ m) (d : LocalBlockInput m) :
    seedRadical d .linear ≤
      ⁅seedRadical d .linear, (⊤ : Subgroup (standardSeed d .linear))⁆ := by
  let K := standardSeed d .linear
  let R := seedRadical d .linear
  let C : Subgroup K := ⁅R, ⊤⁆
  have hn : C.Normal := normalizer_eq_top_iff.mp
    (top_unique (normalizer_commutator_ge_right R ⊤))
  let := hn
  let q : K →* K ⧸ C := QuotientGroup.mk' C
  let x := fun i t => q (rootElement d i t)
  let y := fun i t => q (centralElement d i t)
  let j : K →* SplitGroup m := d.fixedGroup.subtype.comp (standardSeed d .linear).subtype
  have hj : Function.Injective j := Subtype.val_injective.comp Subtype.val_injective
  have hr : RootRelations m (rootElement d) (centralElement d) :=
    RootRelations.of_injective j hj (rootWord_relations m)
  have hcentral (i : Fin 8) (hi : i ≠ 7) (t) (g : K ⧸ C) : Commute (x i t) g := by
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective C g
    have hmem : ⁅rootElement d i t, g⁆ ∈ C :=
      commutator_mem_commutator (rootElement_mem_radical d i hi t) (mem_top g)
    have he : q ⁅rootElement d i t, g⁆ = 1 := (QuotientGroup.eq_one_iff _).mpr hmem
    apply commutatorElement_eq_one_iff_mul_comm.mp
    simpa only [x, commutatorElement_def, map_mul, map_inv] using he
  have h1add (t u) : x 1 (t + u) = x 1 t * x 1 u := by
    have he : rootElement d 1 (t + u) = rootElement d 1 t * rootElement d 1 u :=
      Subtype.ext (Subtype.ext (rootWord_odd_add m 1 (by decide) t u))
    exact (congrArg q he).trans (map_mul q _ _)
  have hy0add (t u) : y 0 (t + u) = y 0 t * y 0 u := by
    have he : centralElement d 0 (t + u) = centralElement d 0 t * centralElement d 0 u :=
      Subtype.ext (Subtype.ext (centralWord_zero_add m t u))
    exact (congrArg q he).trans (map_mul q _ _)
  have h0mul (t u) : x 0 t * x 0 u = x 0 (t + u) * y 0 (titsEnd m t * u) := by
    have he : rootElement d 0 t * rootElement d 0 u =
        rootElement d 0 (t + u) * centralElement d 0 (titsEnd m t * u) :=
      Subtype.ext (Subtype.ext (MatrixRelations.rootWord_even_mul m 0 (by decide) t u))
    simpa only [map_mul] using congrArg q he
  obtain ⟨c, hc0, hc1⟩ := exists_scalar hm
  let u : (CoefficientField m)ˣ := Units.mk0 c hc0
  let h := endTorusElement d u
  have hscale (t) : x 0 (c⁻¹ * t) = x 0 t := by
    have hs : h * rootElement d 0 t * h⁻¹ = rootElement d 0 (c⁻¹ * t) :=
      Subtype.ext (Subtype.ext (endTorusWord_scaling m u t))
    calc
      _ = q (h * rootElement d 0 t * h⁻¹) := congrArg q hs.symm
      _ = q h * x 0 t * (q h)⁻¹ := by simp only [map_mul, map_inv, x]
      _ = x 0 t := (hcentral 0 (by decide) t (q h)).symm.mul_inv_cancel
  have hkill := central_rootImages_eq_one m c hc0 hc1 x y (hr.map q) hcentral
    h1add hy0add h0mul c⁻¹ (fun he => hc1 (inv_eq_one.mp he)) hscale
  apply (radical_eq_closure d).le.trans
  apply (closure_le _).mpr
  rintro z ⟨i, hi, t, rfl⟩
  change rootElement d i t ∈ C
  exact (QuotientGroup.eq_one_iff _).mp (hkill i hi t)

end ReeF4.LargeLocalSeeds
