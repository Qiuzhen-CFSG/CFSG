module

public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.SuzukiCore.LeviProjection.MatrixGraph
public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.SuzukiCore.LeviProjection.MatrixDiagonal.SymplecticGraph
public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.MatrixIdentification

/-!
# The general twisted B₂ matrix diagonal

`SymplecticGraph` identifies the paired subgroup with the graph of the actual
exceptional symplectic automorphism and proves full diagonal coverage. Here
that coverage gives an equivalence with the fixed symplectic group. The
completed fixed-matrix identification then identifies this diagonal with the
concrete subgroup generated by the Suzuki root, torus, and Weyl matrices.

Source: Aschbacher–Smith F.1.12(I)(5), printed p.263 (PDF p.274), and
GLS3 §2.4, Table 2.4 type V. No ambient Ree representation is used here.
-/

@[expose] public noncomputable section

namespace ReeF4.LargeLocalSeeds.SuzukiLeviProjection.MatrixDiagonal

open Theory.SpecificGroups.SymplecticFour
open Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual

/-- The diagonal coverage expressed as an equivalence of concrete subgroups. -/
def fixedDiagonalEquiv (m : ℕ) :
    (graphFieldAut (F := CoefficientField m) m).fixedSubgroup ≃* pairedDiagonal m := by
  let f : (graphFieldAut (F := CoefficientField m) m).fixedSubgroup →* MatrixGroup m :=
    (coordinatesHom m).comp (graphFieldAut (F := CoefficientField m) m).fixedSubgroup.subtype
  have hf (g : (graphFieldAut (F := CoefficientField m) m).fixedSubgroup) :
      f g ∈ pairedDiagonal m := by
    rw [pairedDiagonal_eq_map_fixed]
    exact ⟨g.val, g.property, rfl⟩
  refine MulEquiv.ofBijective (f.codRestrict (pairedDiagonal m) hf) ⟨?_, ?_⟩
  · intro g h he
    apply Subtype.ext
    exact coordinatesHom_injective m (congrArg Subtype.val he)
  · rintro ⟨A, hA⟩
    rw [pairedDiagonal_eq_map_fixed] at hA
    obtain ⟨g, hg, hA⟩ := hA
    exact ⟨⟨g, hg⟩, Subtype.ext hA⟩

@[simp] theorem fixedDiagonalEquiv_val (m : ℕ)
    (g : (graphFieldAut (F := CoefficientField m) m).fixedSubgroup) :
    (fixedDiagonalEquiv m g).val = coordinatesHom m g.val := rfl

/-- A compatible identification of the genuine fixed symplectic matrices with
the actual Suzuki subgroup supplies the requested diagonal equality. All graph
functionality and fixed-point coverage have already been proved above. -/
theorem pairedDiagonal_eq_suzuki_of_fixed_equiv (m : ℕ)
    (e : (graphFieldAut (F := CoefficientField m) m).fixedSubgroup ≃*
      BenderSuzuki.MatrixGroups.SuzukiMatrixGroup m)
    (he : ∀ g, (e g).val.val = matrixCoordinates (RingEquiv.refl (CoefficientField m)) g.val) :
    pairedDiagonal m = BenderSuzuki.MatrixGroups.SuzukiMatrixSubgroup m := by
  rw [pairedDiagonal_eq_map_fixed]
  ext A
  rw [Subgroup.mem_map]
  constructor
  · rintro ⟨g, hg, rfl⟩
    have hcoords : coordinatesHom m g = (e ⟨g, hg⟩).val :=
      Units.ext (he ⟨g, hg⟩).symm
    rw [hcoords]
    exact (e ⟨g, hg⟩).property
  · intro hA
    obtain ⟨g, hg⟩ := e.surjective ⟨A, hA⟩
    refine ⟨g.val, g.property, ?_⟩
    apply Units.ext
    exact (he g).symm.trans
      (congrArg (fun z : BenderSuzuki.MatrixGroups.SuzukiMatrixGroup m => z.val.val) hg)

/-- The generated twisted B₂ diagonal is the concrete Suzuki matrix subgroup. -/
theorem pairedDiagonal_eq_suzuki (m : ℕ) :
    pairedDiagonal m = BenderSuzuki.MatrixGroups.SuzukiMatrixSubgroup m :=
  pairedDiagonal_eq_suzuki_of_fixed_equiv m
    (Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.fixedSuzukiEquiv m)
    (Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.fixedSuzukiEquiv_matrix m)

end ReeF4.LargeLocalSeeds.SuzukiLeviProjection.MatrixDiagonal
