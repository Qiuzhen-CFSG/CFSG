module

public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.FixedGeometry.SeedInvariance
public import Theory.SpecificGroups.ReeF4.MaximalSubgroups.AbelianCharacteristic.TwoLocal.ParabolicComparison

/-!
# Two-power stability of the full Ree parabolics

For `m ≥ 1`, a two-power automorphism preserving the specified positive
subgroup preserves both full parabolics. Transport the proved fixed-seed
invariance through the matrix-preserving `LocalBlockInput.modelEquiv`.
The root Borel is the full normalizer of the positive subgroup, so it too
is invariant. Each full parabolic is generated by its seed and this Borel;
the comparison of torus words identifies it with the converse parabolic,
retaining the complementary torus.

The current seed-invariance theorem has no simplicity, Sylow, or seed-quotient
premises: its proved two-power innerness argument has discharged its geometric
inputs. Consequently this assembly needs neither quasisimplicity nor local
characteristic two. In particular it applies to the inherited quasisimple
carrier in E.6.8 without adding a simplicity or quotient-identification premise.
The marked version uses the literal inverse-equivalence images that define
the parabolics on the source component.

Source: Aschbacher–Smith, E.6.8, printed pp.247–248 (PDF pp.258–259),
and F.1.12(I)(5), printed pp.263–264 of `refs/quasithin.pdf`.
This is the invariant-parabolic ingredient of the Ree exclusion; the
local block exclusions and final source-family assembly are separate.
-/

public section

namespace ReeF4.ConverseParabolics

open Subgroup LargeLocalSeeds
open Parabolics.OuterLocal.LargeAutomorphisms
open MaximalSubgroups.AbelianCharacteristic.TwoLocalGeometry

private theorem map_eq_self_of_invariant {G : Type*} [Group G]
    (H : Subgroup G) (a : MulAut G) (h : ∀ x, x ∈ H ↔ a x ∈ H) :
    H.map a.toMonoidHom = H := by
  ext x
  rw [mem_map_equiv]
  simpa only [a.apply_symm_apply] using h (a.symm x)

private theorem invariant_of_map_eq_self {G : Type*} [Group G]
    (H : Subgroup G) (a : MulAut G) (h : H.map a.toMonoidHom = H) :
    ∀ x, x ∈ H ↔ a x ∈ H := by
  intro x
  have hx := mem_map_iff_mem (f := a.toMonoidHom) a.injective (K := H) (x := x)
  rw [h] at hx
  exact hx.symm

private theorem rootSeed_invariant {m : ℕ} (hm : 1 ≤ m)
    (a : MulAut (Model m)) (ha : ∃ n : ℕ, a ^ (2 ^ n) = 1)
    (hU : ∀ x, x ∈ Parabolics.unipotent m ↔ a x ∈ Parabolics.unipotent m) :
    ∀ s x, x ∈ Parabolics.seed m s ↔ a x ∈ Parabolics.seed m s := by
  let d := canonicalLocalBlockInput m
  let b := MulAut.congr d.modelEquiv.symm a
  have hb : ∃ n : ℕ, b ^ (2 ^ n) = 1 := by
    obtain ⟨n, hn⟩ := ha
    refine ⟨n, ?_⟩
    dsimp only [b]
    rw [← map_pow, hn, map_one]
  have hmemU (y : d.fixedGroup) :
      y ∈ standardUnipotent d ↔ d.modelEquiv y ∈ Parabolics.unipotent m := by
    rw [← modelEquiv_map_standardUnipotent d]
    exact (mem_map_iff_mem d.modelEquiv.injective).symm
  have hbU : ∀ y, y ∈ standardUnipotent d ↔ b y ∈ standardUnipotent d := by
    intro y
    rw [hmemU, hmemU]
    simpa only [b, MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.symm_symm,
      MulEquiv.apply_symm_apply] using hU (d.modelEquiv y)
  intro s x
  have h := standardSeed_invariant_of_twoPower hm d b hb hbU s (d.modelEquiv.symm x)
  rw [← modelEquiv_map_standardSeed d s]
  simpa only [mem_map_equiv, b, MulAut.congr_apply, MulEquiv.trans_apply,
    MulEquiv.symm_symm, MulEquiv.apply_symm_apply] using h

/-- A two-power automorphism preserving the standard positive subgroup fixes
each full parabolic, including its complementary torus. No simplicity or
characteristic-two premise is needed. -/
theorem parabolic_invariant_of_twoPower {m : ℕ} (hm : 1 ≤ m)
    (a : MulAut (Model m)) (ha : ∃ n : ℕ, a ^ (2 ^ n) = 1)
    (hU : ∀ x, x ∈ unipotent m ↔ a x ∈ unipotent m) :
    ∀ s x, x ∈ parabolic m s ↔ a x ∈ parabolic m s := by
  rw [unipotent_eq_rootUnipotent] at hU
  have hUmap := map_eq_self_of_invariant (Parabolics.unipotent m) a hU
  have hB : (Parabolics.borel m).map a.toMonoidHom = Parabolics.borel m := by
    rw [← Parabolics.unipotent_normalizer_eq_borel, map_equiv_normalizer_eq, hUmap]
  have hseed := rootSeed_invariant hm a ha hU
  intro s
  rw [parabolic_eq_rootParabolic, Parabolics.parabolic_eq_seed_sup_borel]
  apply invariant_of_map_eq_self
  rw [Subgroup.map_sup, map_eq_self_of_invariant _ a (hseed s), hB]

/-- Transport to the exact parabolics marked on a source component. In E.6.8,
`S` is the component's intersection with the acting Sylow two-subgroup, and
`e` is the actual model equivalence aligned with the positive subgroup.
Thus every two-power action preserving that intersection fixes both marked
full parabolics. -/
theorem marked_parabolic_invariant_of_twoPower {G : Type*} [Group G]
    {m : ℕ} (hm : 1 ≤ m) (e : G ≃* Model m) (S : Subgroup G)
    (hS : S.map e.toMonoidHom = unipotent m)
    (a : MulAut G) (ha : ∃ n : ℕ, a ^ (2 ^ n) = 1)
    (hU : ∀ x, x ∈ S ↔ a x ∈ S) :
    ∀ s x, x ∈ (parabolic m s).map e.symm.toMonoidHom ↔
      a x ∈ (parabolic m s).map e.symm.toMonoidHom := by
  let b := MulAut.congr e a
  have hb : ∃ n : ℕ, b ^ (2 ^ n) = 1 := by
    obtain ⟨n, hn⟩ := ha
    refine ⟨n, ?_⟩
    dsimp only [b]
    rw [← map_pow, hn, map_one]
  have hbU : ∀ x, x ∈ unipotent m ↔ b x ∈ unipotent m := by
    intro x
    rw [← hS, mem_map_equiv, mem_map_equiv]
    simpa only [b, MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.symm_symm,
      MulEquiv.symm_apply_apply] using hU (e.symm x)
  have hP := parabolic_invariant_of_twoPower hm b hb hbU
  intro s x
  rw [mem_map_equiv, mem_map_equiv]
  simpa only [b, MulAut.congr_apply, MulEquiv.trans_apply, MulEquiv.symm_symm,
    MulEquiv.symm_apply_apply] using hP s (e x)

end ReeF4.ConverseParabolics
