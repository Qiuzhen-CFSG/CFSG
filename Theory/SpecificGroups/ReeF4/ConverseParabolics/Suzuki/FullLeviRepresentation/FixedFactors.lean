module
public import Theory.SpecificGroups.ReeF4.ConverseParabolics.Suzuki.Levi
public import Theory.SpecificGroups.ReeF4.LargeLocalSeeds.SuzukiCore.LeviProjection

/-!
# Fixed subsystem and torus factors in the full Suzuki Levi

The complete coroot torus normalizes both signed middle-node root blocks and
hence their subsystem Levi. Both split factors are twist invariant. Their
intersection has odd order, so the involution on the set of factorizations
of a fixed element has a fixed point. Consequently the actual full fixed
Levi is generated by the fixed subsystem and the full fixed torus.

This specializes the odd-intersection argument of
`ParabolicAmalgam/Geometry/FixedProducts.lean` to the subsystem Levi.
No assertion that fixed points preserve arbitrary generated subgroups is used.

Source: GLS3, Theorem 2.6.5(f,g), `refs/KGroup/GLS3/chapter2.tex`;
Aschbacher–Smith F.1.12(I)(5), printed p.263.
-/

@[expose] public noncomputable section
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction Subgroup
open scoped Pointwise
namespace ReeF4.ConverseParabolics.SuzukiFullLeviRepresentation
open Parabolics LargeLocalSeeds
open LocalBlockInput.PairRigidity FixedCollection.SeedGeneration
open SuzukiLevi (fullLevi splitFullLevi)

/-- The fixed subsystem Levi included into the unchanged Ree model. -/
def seedLeviHom (m : ℕ) : fixedLevi (canonicalLocalBlockInput m) .suzuki →* Model m :=
  (canonicalLocalBlockInput m).modelEquiv.toMonoidHom.comp
    (fixedLevi (canonicalLocalBlockInput m) .suzuki).subtype

theorem seedLeviHom_injective (m : ℕ) : Function.Injective (seedLeviHom m) :=
  (canonicalLocalBlockInput m).modelEquiv.injective.comp Subtype.val_injective

theorem seedLeviHom_range (m : ℕ) : (seedLeviHom m).range =
    (splitLevi m .suzuki).comap (toSplitGroup m) := by
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    change toSplitGroup m ((canonicalLocalBlockInput m).modelEquiv y.val) ∈ splitLevi m .suzuki
    rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
    exact y.property
  · intro hx
    let d := canonicalLocalBlockInput m
    have hy : d.modelEquiv.symm x ∈ fixedLevi d .suzuki := by
      change (d.modelEquiv.symm x).val ∈ splitLevi m .suzuki
      rw [modelEquiv_symm_coe]
      simpa only [mem_comap, toSplitGroup_apply] using hx
    exact ⟨⟨d.modelEquiv.symm x, hy⟩, d.modelEquiv.apply_symm_apply x⟩

theorem seedLeviHom_le_fullLevi (m : ℕ) : (seedLeviHom m).range ≤ fullLevi m := by
  rw [seedLeviHom_range]
  exact comap_mono le_sup_left

private theorem diagonal_normalizes_block (m : ℕ) (s : Side) (p : Bool) :
    diagonalTorus m ≤ normalizer (splitSimpleBlock m s p : Set (SplitGroup m)) := by
  rw [le_normalizer_iff]
  intro z hz x hx
  obtain ⟨u, hu⟩ := hz
  change (MulAut.conj z) x ∈ _
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨r, t, hr, rfl⟩ := hx
    apply Subgroup.subset_closure
    refine ⟨r, ((integralChevalleyRootScale (P := typeF4RootPairing) u⁻¹ r :
      (CoefficientField m)ˣ) : CoefficientField m) * t, hr, ?_⟩
    apply Subtype.ext
    change z.val * F4Chevalley.rootCurve r t * z.val⁻¹ = _
    change diagonalTorusHom m u = z.val at hu
    rw [← hu]
    have he := F4Chevalley.rootCurve_torus_conjugation u⁻¹ r t
    simpa only [← diagonalTorusHom_apply, map_inv, inv_inv, rootGeneratorInGroup_coe] using he
  | one => simpa only [map_one] using (one_mem _)
  | mul x y _ _ hx hy => simpa only [map_mul] using mul_mem hx hy
  | inv x _ hx => simpa only [map_inv] using inv_mem hx

/-- The full coroot torus normalizes the middle-node subsystem Levi. -/
theorem splitTorus_normalizes_levi (m : ℕ) :
    splitTorus m ≤ normalizer (splitLevi m .suzuki : Set (SplitGroup m)) := by
  rw [splitTorus_eq_diagonalTorus]
  exact (le_inf (diagonal_normalizes_block m .suzuki true)
    (diagonal_normalizes_block m .suzuki false)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)

private theorem fixed_factors {G : Type*} [Group G] [Finite G] (φ : MulAut G)
    (hφ : φ ^ 2 = 1) (A B : Subgroup G)
    (hA : A.map φ.toMonoidHom = A) (hB : B.map φ.toMonoidHom = B)
    (hodd : Odd (Nat.card (A ⊓ B : Subgroup G)))
    (x : G) (hx : φ x = x) (hprod : x ∈ (A : Set G) * (B : Set G)) :
    ∃ a ∈ A, ∃ b ∈ B, φ a = a ∧ φ b = b ∧ a * b = x := by
  let S := Subgroup.zpowers φ
  have hS : IsPGroup 2 S := by
    apply IsPGroup.of_card_dvd_pow (n := 1)
    simpa only [S, Nat.card_zpowers, pow_one] using orderOf_dvd_of_pow_eq_one hφ
  have hinv (H : Subgroup G) (hH : H.map φ.toMonoidHom = H) : IsInvariant S G H := by
    have hφH : φ • H = H := hH
    refine ⟨fun s g => ?_⟩
    have hsH : (s : MulAut G) • H = H := smul_eq_self_of_mem_zpowers s.property hφH
    change g ∈ H ↔ (s : MulAut G) • g ∈ H
    simpa only [hsH] using
      (Subgroup.smul_mem_pointwise_smul_iff (a := (s : MulAut G)) (x := g) (S := H)).symm
  let := hinv A hA
  let := hinv B hB
  have hfixed : x ∈ fixedPointSubgroup S G :=
    fun s => smul_eq_self_of_mem_zpowers s.property hx
  obtain ⟨a, ha, b, hb, hab⟩ := Set.mem_mul.mp
    (fixed_mem_mul_of_odd_inf hS A B hodd hfixed hprod)
  exact ⟨a, ha.1, b, hb.1, ha.2 ⟨φ, mem_zpowers φ⟩,
    hb.2 ⟨φ, mem_zpowers φ⟩, hab⟩

/-- Fixed points of the split Levi–torus product admit fixed factors.
Oddness of their intersection supplies the fixed factorization. -/
theorem fullLevi_eq_seedLevi_sup_torus (m : ℕ) :
    fullLevi m = (seedLeviHom m).range ⊔ fixedTorus m := by
  apply le_antisymm
  · intro x hx
    let d := canonicalLocalBlockInput m
    have hprod : toSplitGroup m x ∈ (splitLevi m .suzuki : Set (SplitGroup m)) *
        (splitTorus m : Set (SplitGroup m)) := by
      rwa [← coe_mul_of_right_le_normalizer_left _ _ (splitTorus_normalizes_levi m)]
    have hφ : d.twist ^ 2 = 1 := by
      apply MulEquiv.ext
      intro z
      exact DFunLike.congr_fun d.twist_sq z
    have ht : (splitTorus m).map d.twist.toMonoidHom = splitTorus m := by
      rw [d.twist_eq_reeAutomorphism]
      exact splitTorus_invariant m
    have hodd : Odd (Nat.card (splitTorus m)) := by
      rw [splitTorus_eq_diagonalTorus]
      exact diagonalTorus_odd_card m
    have hfix : d.twist (toSplitGroup m x) = toSplitGroup m x := by
      rw [d.twist_eq_reeAutomorphism, reeAutomorphism_apply]
      exact reeTwist_toSplitGroup m x
    obtain ⟨a, ha, t, ht, hfa, hft, he⟩ := fixed_factors d.twist hφ _ _
      (splitLevi_twist d .suzuki) ht
      (hodd.of_dvd_nat (card_dvd_of_le (inf_le_right :
        splitLevi m .suzuki ⊓ splitTorus m ≤ splitTorus m))) _ hfix hprod
    let a' : d.fixedGroup := ⟨a, hfa⟩
    let t' : d.fixedGroup := ⟨t, hft⟩
    have ha' : d.modelEquiv a' ∈ (seedLeviHom m).range := ⟨⟨a', ha⟩, rfl⟩
    have ht' : d.modelEquiv t' ∈ fixedTorus m := by
      change toSplitGroup m (d.modelEquiv t') ∈ splitTorus m
      rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
      exact ht
    have he' : d.modelEquiv a' * d.modelEquiv t' = x := by
      apply toSplitGroup_injective m
      rw [map_mul, toSplitGroup_apply, toSplitGroup_apply,
        LocalBlockInput.modelEquiv_coe, LocalBlockInput.modelEquiv_coe]
      exact he
    rw [← he']
    exact mul_mem_sup ha' ht'
  · exact sup_le (seedLeviHom_le_fullLevi m)
      (SuzukiLevi.fixedTorus_le_fullLevi m)

end ReeF4.ConverseParabolics.SuzukiFullLeviRepresentation
