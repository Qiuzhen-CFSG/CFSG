module

public import Theory.SpecificGroups.ReeF4.SectionGeometry.CoreFree.LinearRadical.Normality
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.Geometry.FixedProducts
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration

/-!
# Factoring the full Suzuki-side Ree parabolic

Adjoin the full coroot torus to the middle-node B₂ subsystem Levi, and
intersect with the actual Ree fixed group. Every element of the Suzuki
parabolic is a product of an element of its specified radical and an element
of this full Levi. The proof uses the checked fixed factorization of the seed,
the odd-torus fixed factorization, and relative normality of the radical.
It does not infer fixed generation merely from split generation.

This publishes the actual full Levi for its separate representation and radical
action calculations. It makes no assertion of faithful action.

Source: GLS3, Theorem 2.6.5(g), `refs/KGroup/GLS3/chapter2.tex`.
-/

@[expose] public section
noncomputable section

namespace ReeF4.ConverseParabolics.SuzukiLevi

open LargeLocalSeeds Parabolics Subgroup
open SectionGeometry.LinearRadical (radical_subgroupOf_normal radical_le_parabolic)

/-- The middle-node subsystem Levi together with the full complementary torus. -/
def splitFullLevi (m : ℕ) : Subgroup (SplitGroup m) :=
  LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration.splitLevi m .suzuki ⊔ splitTorus m

/-- The full Levi as its actual fixed intersection in the Ree model. -/
def fullLevi (m : ℕ) : Subgroup (Model m) :=
  (splitFullLevi m).comap (toSplitGroup m)

theorem fullLevi_le_parabolic (m : ℕ) : fullLevi m ≤ parabolic m .suzuki :=
  comap_mono (sup_le_sup_right
    (LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration.splitLevi_le_seed m .suzuki) _)

theorem fixedTorus_le_fullLevi (m : ℕ) : fixedTorus m ≤ fullLevi m :=
  comap_mono le_sup_right

private theorem seed_le_fullLevi_sup_radical (m : ℕ) :
    seed m .suzuki ≤ fullLevi m ⊔ radical m .suzuki := by
  intro x hx
  let d := canonicalLocalBlockInput m
  have hx' : d.modelEquiv.symm x ∈ standardSeed d .suzuki := by
    change (d.modelEquiv.symm x).val ∈ splitSeed m .suzuki
    rw [modelEquiv_symm_coe]
    simpa only [seed, mem_comap, toSplitGroup_apply] using hx
  obtain ⟨l, hl, r, hr, he⟩ :=
    LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration.exists_fixed_levi_radical_factors
      d .suzuki (d.modelEquiv.symm x) hx'
  have hl' : d.modelEquiv l ∈ fullLevi m := by
    change toSplitGroup m (d.modelEquiv l) ∈ splitFullLevi m
    rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
    exact mem_sup_left hl
  have hr' : d.modelEquiv r ∈ radical m .suzuki := by
    change toSplitGroup m (d.modelEquiv r) ∈ splitRadical m .suzuki
    rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
    exact hr
  have he' : d.modelEquiv l * d.modelEquiv r = x := by
    rw [← map_mul, he, d.modelEquiv.apply_symm_apply]
  rw [← he']
  exact mul_mem_sup hl' hr'

/-- The full fixed parabolic is generated by its actual radical and full Levi. -/
theorem parabolic_eq_radical_sup_fullLevi (m : ℕ) :
    parabolic m .suzuki = radical m .suzuki ⊔ fullLevi m := by
  apply le_antisymm
  · rw [parabolic_eq_seed_sup_fixedTorus_of_splitTorus m .suzuki
      (by rw [splitTorus_eq_diagonalTorus]; exact diagonalTorus_le_seed_normalizer m .suzuki)
      (by rw [splitTorus_eq_diagonalTorus]; exact diagonalTorus_odd_card m)]
    apply sup_le
    · simpa only [sup_comm] using seed_le_fullLevi_sup_radical m
    · exact (fixedTorus_le_fullLevi m).trans le_sup_right
  · exact sup_le (radical_le_parabolic m .suzuki) (fullLevi_le_parabolic m)

/-- Every parabolic element has a radical factor followed by a full Levi factor. -/
theorem exists_radical_fullLevi_factors (m : ℕ) (x : Model m)
    (hx : x ∈ parabolic m .suzuki) :
    ∃ r ∈ radical m .suzuki, ∃ l ∈ fullLevi m, r * l = x := by
  let P := parabolic m .suzuki
  let R := (radical m .suzuki).subgroupOf P
  let L := (fullLevi m).subgroupOf P
  let : R.Normal := radical_subgroupOf_normal m .suzuki
  have hsup : R ⊔ L = ⊤ := by
    dsimp only [R, L]
    rw [← subgroupOf_sup (radical_le_parabolic m .suzuki) (fullLevi_le_parabolic m),
      ← parabolic_eq_radical_sup_fullLevi, subgroupOf_self]
  have hx' : (⟨x, hx⟩ : P) ∈ R ⊔ L := by rw [hsup]; trivial
  obtain ⟨r, hr, l, hl, he⟩ := mem_sup_of_normal_left.mp hx'
  exact ⟨r.val, hr, l.val, hl, congrArg Subtype.val he⟩

end ReeF4.ConverseParabolics.SuzukiLevi
