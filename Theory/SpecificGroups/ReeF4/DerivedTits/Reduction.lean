module

public import Theory.SpecificGroups.ReeF4.Model
public import Theory.SpecificGroups.Tits.FiniteSimple
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.GroupTheory.IsPerfect

/-!
# A faithful presentation image in the binary Ree derived subgroup

Parrott's presented group is perfect: its certified simplicity and composite
order exclude a trivial commutator subgroup. Consequently a nontrivial
realization of its generators is faithful and has perfect image. If the
ambient finite group has order less than three times the presentation's order,
this image has index at most two. Every commutator belongs to a subgroup of
index at most two, while a perfect subgroup lies in the ambient commutator
subgroup. These two containments identify the image with the derived subgroup.

For the actual binary Ree group, the last theorem takes ten elements of the
split F4 matrix group, their exceptional fixed-point equations, all 37 Parrott
relations, a nonidentity image, and the ambient size bound. It constructs the
requested equivalence from these inputs. Neither the matrix realization nor
the size bound is established here; the unconditional comparison remains a
separate assembly obligation. In particular, the full `Model 0` is not
identified with the simple Tits group.

Sources: Parrott, *A Characterization of the Tits' Simple Group* (1972), §5,
printed p.683, transcribed in
`refs/original/n-group-global/parrott-tits-presentation.md`; GLS3, §§2.2--2.4,
for the exceptional fixed-point construction and Bruhat structure. The
presentation's order and simplicity come from `Tits.FiniteSimple` and its
certified equivalence `Tits.parrottFiniteImageEquiv`.
-/

public section

namespace ReeF4.DerivedTits

/-- The certified simple Tits presentation is perfect. -/
theorem parrott_perfect : Group.IsPerfect Tits.ParrottGroup := by
  constructor
  rcases (inferInstance : (commutator Tits.ParrottGroup).Normal).eq_bot_or_eq_top with h | h
  · let : IsMulCommutative Tits.ParrottGroup := (commutator_eq_bot_iff _).mp h
    have hp : (Nat.card Tits.ParrottGroup).Prime :=
      Group.is_simple_iff_prime_card.mp inferInstance
    rw [Tits.parrottGroup_card] at hp
    have hd := (Nat.dvd_prime hp).mp (by norm_num : 2 ∣ 17971200)
    omega
  · exact h

/-- A nonidentity generator image makes a realization of Parrott's presentation
faithful, using the already certified simplicity of the presentation. -/
theorem parrottLift_injective {G : Type*} [Group G]
    (g : Tits.ParrottGenerator → G) (hrel : Tits.SatisfiesParrottRelations g)
    (hne : ∃ i, g i ≠ 1) : Function.Injective (Tits.parrottLift g hrel) := by
  let f := Tits.parrottLift g hrel
  apply f.ker_eq_bot_iff.mp
  rcases f.normal_ker.eq_bot_or_eq_top with h | h
  · exact h
  · obtain ⟨i, hi⟩ := hne
    have hf : f = 1 := f.ker_eq_top_iff.mp h
    apply (hi ?_).elim
    rw [← Tits.parrottLift_generator g hrel i]
    change f _ = 1
    rw [hf]
    rfl

private theorem eq_commutator_of_perfect_of_index_le_two {G : Type*} [Group G] [Finite G]
    (H : Subgroup G) [Group.IsPerfect H] (hindex : H.index ≤ 2) : H = commutator G := by
  apply le_antisymm
  · rw [← H.commutator_eq_self]
    exact Subgroup.commutator_mono le_top le_top
  · have hpos := H.index_ne_zero_of_finite
    have hcases : H.index = 1 ∨ H.index = 2 := by omega
    rcases hcases with h | h
    · rw [Subgroup.index_eq_one.mp h]
      exact le_top
    · rw [commutator_def]
      apply Subgroup.commutator_le.mpr
      intro x _ y _
      simp only [commutatorElement_def, H.mul_mem_iff_of_index_two h, H.inv_mem_iff]
      tauto

/-- A faithful Tits image of index less than three is exactly the ambient
derived subgroup. The full ambient order and the exact index are unnecessary. -/
theorem range_eq_commutator_of_card_lt {G : Type*} [Group G] [Finite G]
    (f : Tits.ParrottGroup →* G) (hf : Function.Injective f)
    (hcard : Nat.card G < 3 * 17971200) : f.range = commutator G := by
  let : Group.IsPerfect Tits.ParrottGroup := parrott_perfect
  let : Group.IsPerfect f.range := Group.IsPerfect.range f
  apply eq_commutator_of_perfect_of_index_le_two
  have hrange : Nat.card f.range = 17971200 := by
    exact (Nat.card_congr (MonoidHom.ofInjective hf).toEquiv).symm.trans
      Tits.parrottGroup_card
  have hi := f.range.card_mul_index
  rw [hrange] at hi
  omega

/-- The image of a realization is precisely the subgroup generated by its ten
assigned elements, with no extra generation premise. -/
theorem parrottLift_range_eq_closure {G : Type*} [Group G]
    (g : Tits.ParrottGenerator → G) (hrel : Tits.SatisfiesParrottRelations g) :
    (Tits.parrottLift g hrel).range = Subgroup.closure (Set.range g) := by
  have hgen : Subgroup.closure (Set.range Tits.parrottGenerator) = ⊤ :=
    PresentedGroup.closure_range_of _
  rw [MonoidHom.range_eq_map, ← hgen, MonoidHom.map_closure, ← Set.range_comp]
  congr 2
  funext i
  exact Tits.parrottLift_generator g hrel i

/-- A nontrivial realization and the size bound construct the multiplicative
equivalence, including both faithfulness and surjectivity onto the derived group. -/
noncomputable def equivOfAssignment {G : Type*} [Group G] [Finite G]
    (g : Tits.ParrottGenerator → G) (hrel : Tits.SatisfiesParrottRelations g)
    (hne : ∃ i, g i ≠ 1) (hcard : Nat.card G < 3 * 17971200) :
    commutator G ≃* Tits.ParrottGroup :=
  (MulEquiv.subgroupCongr (range_eq_commutator_of_card_lt
    (Tits.parrottLift g hrel) (parrottLift_injective g hrel hne) hcard)).symm.trans
    (MonoidHom.ofInjective (parrottLift_injective g hrel hne)).symm

/-- Exceptional fixed points among the split matrices give elements of the
actual binary Ree carrier, preserving the underlying matrices. -/
noncomputable def fixedAssignment
    (g : Tits.ParrottGenerator → SplitGroup 0)
    (hfix : ∀ i, reeTwist 0 (g i) = g i) : Tits.ParrottGenerator → Model 0 :=
  fun i => ⟨g i, (mem_fixedSubgroup 0 (g i)).mpr (hfix i)⟩

/-- The fixed-point assignment preserves the specified split matrices. -/
@[simp] theorem toSplitGroup_fixedAssignment
    (g : Tits.ParrottGenerator → SplitGroup 0)
    (hfix : ∀ i, reeTwist 0 (g i) = g i) (i : Tits.ParrottGenerator) :
    toSplitGroup 0 (fixedAssignment g hfix i) = g i := by
  rw [toSplitGroup_apply]
  rfl

/-- Equations verified in the split matrices hold in the fixed-point carrier. -/
theorem fixedAssignment_relations
    (g : Tits.ParrottGenerator → SplitGroup 0)
    (hfix : ∀ i, reeTwist 0 (g i) = g i)
    (hrel : Tits.SatisfiesParrottRelations g) :
    Tits.SatisfiesParrottRelations (fixedAssignment g hfix) := by
  have he : (toSplitGroup 0).comp (FreeGroup.lift (fixedAssignment g hfix)) =
      FreeGroup.lift g := by
    apply FreeGroup.ext_hom
    intro i
    simp only [MonoidHom.comp_apply, FreeGroup.lift_apply_of, toSplitGroup_fixedAssignment]
  intro i
  apply toSplitGroup_injective 0
  change ((toSplitGroup 0).comp (FreeGroup.lift (fixedAssignment g hfix)))
    (Tits.parrottRelator i) = toSplitGroup 0 1
  rw [he, hrel i, map_one]

/-- Conditional assembly from genuine split F4 matrices. The matrix assignment
and ambient size bound must both be constructed before using this to assert the
unconditional derived-group comparison. -/
theorem nonempty_derived_equiv_of_split_assignment
    (g : Tits.ParrottGenerator → SplitGroup 0)
    (hfix : ∀ i, reeTwist 0 (g i) = g i)
    (hrel : Tits.SatisfiesParrottRelations g) (hne : ∃ i, g i ≠ 1)
    (hcard : Nat.card (Model 0) < 3 * 17971200) :
    Nonempty (commutator (Model 0) ≃* Tits.ParrottGroup) := by
  have hn : ∃ i, fixedAssignment g hfix i ≠ 1 := by
    obtain ⟨i, hi⟩ := hne
    refine ⟨i, fun h => hi ?_⟩
    exact congrArg Subtype.val h
  exact ⟨equivOfAssignment (fixedAssignment g hfix)
    (fixedAssignment_relations g hfix hrel) hn hcard⟩

end ReeF4.DerivedTits
