/-- All ten binary words equal the literal matrices in the published presentation. -/
theorem generator_val (g : Tits.ParrottGenerator) :
    (generator g).val = Binary.generatorMatrix g := by
  cases g

  · change (weylWord [1, 2, 1, 2]).val = _
    simp only [weylWord, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, Units.val_mul, weyl_val_1, weyl_val_2]
    rw [product063, product064, product065]
    rfl

  · change (weylWord [0, 3]).val = _
    simp only [weylWord, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, Units.val_mul, weyl_val_0, weyl_val_3]
    rw [product066]
    rfl

  · change (relative 0 * relative 0).val = _
    simp only [Units.val_mul, relative_val_0, relative_val_0]
    exact product067

  · exact relative_val_1

  · change (relative 0 * relative 2).val = _
    simp only [Units.val_mul, relative_val_0, relative_val_2]
    exact product068

  · exact relative_val_3

  · change (relative 0 * relative 4).val = _
    simp only [Units.val_mul, relative_val_0, relative_val_4]
    exact product069

  · exact relative_val_5

  · change (relative 6 * (relative 0)⁻¹).val = _
    simp only [Units.val_mul, relative_val_6, inverse_relative_val]
    exact product070

  · exact relative_val_7


