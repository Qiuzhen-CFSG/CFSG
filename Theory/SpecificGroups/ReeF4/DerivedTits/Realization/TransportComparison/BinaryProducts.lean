module
public import Theory.SpecificGroups.ReeF4.DerivedTits.Realization.SimpleData
public import Theory.SpecificGroups.ReeF4.DerivedTits.Realization.TransportComparison.Routes

/-!
# Binary products along the certified Weyl routes

The binary words use exactly the signed simple tables, the positive-root routes,
and Parrott's substitutions. Literal intermediate rows make every multiplication
an independent kernel check using `Thompson.BinaryMatrix.decode_mul`.
The generation script is a discovery aid; it contributes no proof assumption.

Source: Parrott (1972), p.683, and GLS3 §§2.3–2.4. See the adjacent
`source/generate_products.py` and `Realization/source/README.md`.
-/

@[expose] public section
namespace ReeF4.DerivedTits.Realization.TransportComparison
namespace Products
open Thompson.BinaryMatrix

set_option maxRecDepth 10000

abbrev BinaryUnit := (Matrix (Fin 52) (Fin 52) (ZMod 2))ˣ

def weyl (i : Fin 4) : BinaryUnit :=
  Binary.simpleAssignment false i * Binary.simpleAssignment true i * Binary.simpleAssignment false i

def weylWord (w : List (Fin 4)) : BinaryUnit := (w.map weyl).prod

def transported (w : List (Fin 4)) (i : Fin 4) : BinaryUnit :=
  weylWord w * Binary.simpleAssignment false i * (weylWord w)⁻¹

def root (i : Fin 24) : BinaryUnit := transported (routeWord i) (routeSimple i)

def pair (i : Fin 4) : BinaryUnit := root (pairIndex i 0) * root (pairIndex i 1)

def quartet (i : Fin 4) : BinaryUnit :=
  root (quartetIndex i 0) * root (quartetIndex i 1) * root (quartetIndex i 3)

def relative : Fin 8 → BinaryUnit :=
  ![quartet 0, pair 1, quartet 3, pair 3, quartet 1, pair 2, quartet 2, pair 0]

def generator : Tits.ParrottGenerator → BinaryUnit
  | .r1 => weylWord [1,2,1,2]
  | .r8 => weylWord [0,3]
  | .s1 => relative 0 * relative 0
  | .s2 => relative 1
  | .s3 => relative 0 * relative 2
  | .s4 => relative 3
  | .s5 => relative 0 * relative 4
  | .s6 => relative 5
  | .s7 => relative 6 * (relative 0)⁻¹
  | .s8 => relative 7

@[simp] theorem simple_inv (b : Bool) (i : Fin 4) :
    (Binary.simpleAssignment b i)⁻¹ = Binary.simpleAssignment b i := by
  apply Units.ext
  rfl

@[simp] theorem weyl_inv (i : Fin 4) : (weyl i)⁻¹ = weyl i := by
  simp [weyl, mul_inv_rev, mul_assoc]

theorem transported_nil (i : Fin 4) : transported [] i = Binary.simpleAssignment false i := by
  simp [transported, weylWord]

theorem transported_cons (i : Fin 4) (w : List (Fin 4)) (j : Fin 4) :
    transported (i :: w) j = weyl i * transported w j * weyl i := by
  simp [transported, weylWord, mul_inv_rev, mul_assoc]

@[simp] theorem root_inv (i : Fin 24) : (root i)⁻¹ = root i := by
  simp [root, transported, mul_inv_rev, mul_assoc]


