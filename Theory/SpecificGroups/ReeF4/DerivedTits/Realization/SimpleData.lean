/-- The proposed eight signed simple-root matrices at parameter one. -/
@[expose] public def simpleMatrix (negative : Bool) (i : Fin 4) :
    Matrix (Fin 52) (Fin 52) (ZMod 2) :=
  Thompson.BinaryMatrix.decode 52 (simpleRows negative i)

/-- Parameter-one simple elements are involutions in the binary tables. -/
public theorem simpleMatrix_sq (negative : Bool) (i : Fin 4) :
    simpleMatrix negative i * simpleMatrix negative i = 1 := by
  cases negative <;> fin_cases i <;>
    exact Thompson.BinaryMatrix.decode_mul_one 52 _ _ (by decide +kernel)

/-- The signed simple tables as units, with their checked inverses. -/
@[expose] public def simpleAssignment (negative : Bool) (i : Fin 4) :
    (Matrix (Fin 52) (Fin 52) (ZMod 2))ˣ where
  val := simpleMatrix negative i
  inv := simpleMatrix negative i
  val_inv := by exact simpleMatrix_sq negative i
  inv_val := by exact simpleMatrix_sq negative i

end ReeF4.DerivedTits.Realization.Binary

namespace ReeF4.DerivedTits.Realization

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
noncomputable section

/-- The actual signed simple root, in Bourbaki node order. -/
@[expose] public def signedSimpleRoot (negative : Bool) (i : Fin 4) : F4Chevalley.Root :=
  letI := typeF4RootPairing.indexNeg
  if negative then -(typeF4SimpleRootIndex i) else typeF4SimpleRootIndex i

/-- The exact eight entrywise comparisons needed before Weyl transport.
This property is not asserted by the data or by the arithmetic certificates. -/
@[expose] public def SimpleMatrixComparison (e : F4Chevalley.BasisIndex ≃ Fin 52) : Prop :=
  ∀ (negative : Bool) (i : Fin 4),
    Matrix.reindex e e (F4Chevalley.rootCurve (signedSimpleRoot negative i)
      (1 : CoefficientField 0)).val =
        (Binary.simpleMatrix negative i).map binaryScalar

end
end ReeF4.DerivedTits.Realization
