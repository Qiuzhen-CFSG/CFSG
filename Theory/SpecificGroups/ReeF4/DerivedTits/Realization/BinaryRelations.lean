/-- The literal matrices, with their checked inverses, as matrix units. -/
@[expose] public def assignment (i : Tits.ParrottGenerator) :
    (Matrix (Fin 52) (Fin 52) (ZMod 2))ˣ where
  val := generatorMatrix i
  inv := inverseMatrix i
  val_inv := by exact generator_inverse i
  inv_val := by exact inverse_generator i

@[simp] public theorem assignment_val (i : Tits.ParrottGenerator) :
    (assignment i).val = generatorMatrix i := rfl

@[simp] public theorem assignment_inv_val (i : Tits.ParrottGenerator) :
    ((assignment i)⁻¹).val = inverseMatrix i := rfl

