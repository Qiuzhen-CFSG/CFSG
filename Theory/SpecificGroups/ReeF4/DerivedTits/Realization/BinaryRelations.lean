/-- A concrete off-diagonal entry witnesses a nonidentity generator. -/
public theorem s8_entry : generatorMatrix .s8 0 28 = 1 := by decide +kernel

public theorem assignment_nontrivial : ∃ i, assignment i ≠ 1 := by
  refine ⟨.s8, ?_⟩
  intro h
  have he := congrArg (fun a : (Matrix (Fin 52) (Fin 52) (ZMod 2))ˣ => a.val 0 28) h
  change generatorMatrix .s8 0 28 = (1 : Matrix (Fin 52) (Fin 52) (ZMod 2)) 0 28 at he
  rw [s8_entry] at he
  exact one_ne_zero (he.trans (Matrix.one_apply_ne (by decide)))

