module

public import Theory.SpecificGroups.ReeF4.SectionGeometry.CoreFree.TitsSystem.Torus
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.LinearLeviGeneration

/-!
# The linear Ree parabolic is generated by the Borel and its end-node word

The established fixed end-node Levi calculation includes its entire torus and
uses no simplicity assumption. The fixed Levi–radical factorization extends
this to the seed. The matrix-preserving model equivalence transports this
calculation to `Model m`. Adding the complementary fixed torus then gives
`P_linear = ⟨B, n_linear⟩`, where `n_linear` is the word `[0,3]`.

This generation identity is independent of the BN-pair axioms. Once that
system is constructed, it identifies the linear standard parabolic with the
root-defined one; the omitted relative simple reflection is the Suzuki word
`[1,2,1,2]`.

Source: GLS3 2.3.4–8, 2.4, 2.6.5–6,
`refs/KGroup/GLS3/chapter2.tex`.
-/

public section
noncomputable section
namespace ReeF4.SectionGeometry.BNPair

open Subgroup LargeLocalSeeds Parabolics Parabolics.Binary.FixedGeometry
open LocalBlockInput.PairRigidity.FixedCollection
open LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration

/-- The local-block comparison preserves the specified fixed Weyl word. -/
theorem modelEquiv_relativeWeyl {m : ℕ} (d : LocalBlockInput m) (s : Side) :
    d.modelEquiv (relativeWeyl d s) = weylLift m s := by
  apply toSplitGroup_injective m
  rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe, relativeWeyl_val,
    toSplitGroup_weylLift]

/-- The actual end-node seed is generated by its positive fixed subgroup and
its Weyl word, including all elements of its fixed Levi torus. -/
theorem seed_linear_eq_unipotent_sup_weyl (m : ℕ) (hm : 1 ≤ m) :
    seed m .linear = unipotent m ⊔ zpowers (weylLift m .linear) := by
  apply le_antisymm
  · let d := canonicalLocalBlockInput m
    let H := unipotent m ⊔ zpowers (weylLift m .linear)
    have hU : standardUnipotent d ≤ H.comap d.modelEquiv.toMonoidHom := by
      intro u hu
      apply mem_sup_left
      change toSplitGroup m (d.modelEquiv u) ∈ splitUnipotent m
      rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
      exact hu
    have hW : zpowers (relativeWeyl d .linear) ≤ H.comap d.modelEquiv.toMonoidHom := by
      apply zpowers_le.mpr
      change d.modelEquiv (relativeWeyl d .linear) ∈ H
      rw [modelEquiv_relativeWeyl]
      exact mem_sup_right (mem_zpowers _)
    have hseed := standardSeed_le_unipotent_sup_zpowers_of_fixedLevi d .linear
      (fixedLevi_linear_le hm d)
    intro x hx
    have hx' : d.modelEquiv.symm x ∈ standardSeed d .linear := by
      change (d.modelEquiv.symm x).val ∈ splitSeed m .linear
      rw [modelEquiv_symm_coe]
      simpa only [seed, mem_comap, toSplitGroup_apply] using hx
    have hh := (sup_le hU hW) (hseed hx')
    change d.modelEquiv (d.modelEquiv.symm x) ∈ H at hh
    simpa only [MulEquiv.apply_symm_apply] using hh
  · exact sup_le (unipotent_le_seed m .linear) (zpowers_le.mpr (weylLift_mem_seed m .linear))

/-- The root-defined linear parabolic has exactly the end-node simple generator. -/
theorem linear_parabolic_eq_borel_sup_weyl (m : ℕ) (hm : 1 ≤ m) :
    parabolic m .linear = borel m ⊔ zpowers (weylLift m .linear) := by
  apply le_antisymm
  · rw [parabolic_eq_seed_sup_borel, seed_linear_eq_unipotent_sup_weyl m hm]
    exact sup_le (sup_le_sup_right (unipotent_le_borel m) _) le_sup_left
  · exact sup_le (borel_le_parabolic m .linear)
      (zpowers_le.mpr (seed_le_parabolic m .linear (weylLift_mem_seed m .linear)))

end ReeF4.SectionGeometry.BNPair
