module

public import Theory.SpecificGroups.ReeF4.SectionGeometry.CoreFree.TitsSystem.Basic
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.Geometry.CorootRealization
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.Geometry.Overlap.Bruhat

/-!
# Borel generation and torus intersection in the concrete Ree group

Coroot realization identifies the split word torus with the diagonal torus,
so the existing fixed-product theorem applies without additional hypotheses.
The split Bruhat uniqueness theorem then identifies the intersection of the
Borel and the normalizer words with that torus. Taking fixed intersections
gives the exact finite intersection. Fixed Bruhat coverage also proves that
the Borel and normalizer words generate the full fixed group.

No residual or simplicity assumption enters these statements, even at `m=0`.
Normality of the intersection in the normalizer is a separate root calculation.

Source: GLS3 2.3.4(a–c), 2.3.5, and 2.6.5,
`refs/KGroup/GLS3/chapter2.tex`.
-/

public section
namespace ReeF4.SectionGeometry.BNPair

open Theory.AlgebraicGroup
open Subgroup LargeLocalSeeds Parabolics
open LocalBlockInput.PairNormalization.OppositionCell.FixedBruhatCover
open scoped Pointwise

/-- The coroot word torus normalizes the split positive root subgroup. -/
theorem splitTorus_normalizes_unipotent (m : ℕ) :
    splitTorus m ≤ normalizer (splitUnipotent m : Set (SplitGroup m)) := by
  rw [splitTorus_eq_diagonalTorus]
  exact diagonalTorus_le_unipotent_normalizer m

/-- The coroot torus has odd order in characteristic two. -/
theorem splitTorus_card_odd (m : ℕ) : Odd (Nat.card (splitTorus m)) := by
  rw [splitTorus_eq_diagonalTorus]
  exact diagonalTorus_odd_card m

/-- Fixed factorization retains the full fixed torus of the Borel. -/
theorem borel_eq_unipotent_sup_fixedTorus (m : ℕ) :
    borel m = unipotent m ⊔ fixedTorus m :=
  borel_eq_unipotent_sup_fixedTorus_of_splitTorus m
    (splitTorus_normalizes_unipotent m) (splitTorus_card_odd m)

/-- The whole fixed parabolic is generated by its fixed seed and the Borel. -/
theorem parabolic_eq_seed_sup_borel (m : ℕ) (s : Side) :
    parabolic m s = seed m s ⊔ borel m := by
  apply parabolic_eq_seed_sup_borel_of_splitTorus m s
  · rw [splitTorus_eq_diagonalTorus]
    exact diagonalTorus_le_seed_normalizer m s
  · exact splitTorus_card_odd m

/-- Uniqueness of the split middle matrix identifies the torus intersection. -/
theorem splitBorel_inf_normalizerWords (m : ℕ) :
    splitBorel m ⊓ splitNormalizerWords m = splitTorus m := by
  apply le_antisymm
  · intro n hn
    have hprod : n ∈ (splitUnipotent m : Set (SplitGroup m)) *
        (splitTorus m : Set (SplitGroup m)) := by
      rw [← coe_mul_of_right_le_normalizer_left _ _ (splitTorus_normalizes_unipotent m)]
      exact hn.1
    obtain ⟨u, hu, t, ht, he⟩ := hprod
    have htn : t = n := middle_representative_unique
      hu (splitTorus_le_splitNormalizerWords m ht) (rightUnipotent t).one_mem
      (splitUnipotent m).one_mem hn.2 (rightUnipotent n).one_mem
      (by simpa only [mul_one, one_mul] using he)
    exact htn ▸ ht
  · exact le_inf le_sup_right (splitTorus_le_splitNormalizerWords m)

/-- The actual Borel–normalizer intersection is exactly the fixed coroot torus. -/
theorem borel_inf_normalizerWords (m : ℕ) :
    borel m ⊓ normalizerWords m = fixedTorus m := by
  change (splitBorel m).comap (toSplitGroup m) ⊓
    (splitNormalizerWords m).comap (toSplitGroup m) =
      (splitTorus m).comap (toSplitGroup m)
  rw [← comap_inf, splitBorel_inf_normalizerWords]

/-- Fixed Bruhat coverage gives generation in the full exceptional fixed group. -/
theorem borel_sup_normalizerWords (m : ℕ) : borel m ⊔ normalizerWords m = ⊤ := by
  apply top_unique
  intro g _
  obtain ⟨u, hu, n, hn, v, hv, rfl⟩ := Parabolics.Overlap.exists_fixed_normal_form m g
  exact (borel m ⊔ normalizerWords m).mul_mem
    (mul_mem_sup (unipotent_le_borel m hu) hn)
    (mem_sup_left (unipotent_le_borel m hv))

/-- The generation axiom in the exact convention of `TitsSystem`. -/
theorem borel_normalizerWords_generate (m : ℕ) :
    closure ((borel m : Set (Model m)) ∪ (normalizerWords m : Set (Model m))) = ⊤ := by
  rw [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq, borel_sup_normalizerWords]

end ReeF4.SectionGeometry.BNPair
