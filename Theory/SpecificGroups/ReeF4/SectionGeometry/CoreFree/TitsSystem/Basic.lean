module

public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.BinaryLocals.FixedGeometry.WeylLifts
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.OppositionCell.FixedBruhatCover.Basic
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.Geometry.FixedProducts

/-!
# Concrete normalizer words and relative reflections for the Ree BN-pair

The split normalizer is the existing subgroup generated by nonzero rank-one
Weyl words. Intersecting it with the full exceptional fixed group retains its
torus. The two simple relative lifts are the already constructed fixed words
`[0,3]` and `[1,2,1,2]`; both are involutions in characteristic two.

This module defines the concrete groups and representatives independently of
any BN-pair assertion. Torus containment and twist stability follow on the
word generators. The quotient normality and exchange calculations remain
separate obligations.

Source: GLS3, 2.3.2–4, `refs/KGroup/GLS3/chapter2.tex`.
-/

@[expose] public section
noncomputable section
namespace ReeF4.SectionGeometry.BNPair

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open Subgroup LargeLocalSeeds Parabolics Parabolics.Binary.FixedGeometry
open LocalBlockInput.PairNormalization.OppositionCell.FixedBruhatCover

local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg

/-- The full fixed intersection of the actual split rank-one-word subgroup. -/
def normalizerWords (m : ℕ) : Subgroup (Model m) :=
  (splitNormalizerWords m).comap (toSplitGroup m)

@[simp] theorem mem_normalizerWords (m : ℕ) (n : Model m) :
    n ∈ normalizerWords m ↔ toSplitGroup m n ∈ splitNormalizerWords m := Iff.rfl

/-- The two existing rank-one word conventions agree at every nonzero parameter. -/
theorem rankOneRepresentative_eq_weylWord (m : ℕ) (r : F4Chevalley.Root)
    (t : (CoefficientField m)ˣ) :
    rankOneRepresentative m r t = weylWord m r t := by
  simp only [rankOneRepresentative, weylWord, Units.val_inv_eq_inv_val]

theorem weylWord_mem_splitNormalizerWords (m : ℕ) (r : F4Chevalley.Root)
    (t : (CoefficientField m)ˣ) : weylWord m r t ∈ splitNormalizerWords m := by
  rw [← rankOneRepresentative_eq_weylWord]
  exact rankOneRepresentative_mem m r t

/-- Every coroot word belongs to the split normalizer-word subgroup. -/
theorem splitTorus_le_splitNormalizerWords (m : ℕ) :
    splitTorus m ≤ splitNormalizerWords m := by
  apply (closure_le _).mpr
  rintro x ⟨r, t, rfl⟩
  exact (splitNormalizerWords m).mul_mem (weylWord_mem_splitNormalizerWords m r t)
    (weylWord_mem_splitNormalizerWords m r (-1))

theorem fixedTorus_le_normalizerWords (m : ℕ) : fixedTorus m ≤ normalizerWords m :=
  comap_mono (splitTorus_le_splitNormalizerWords m)

/-- The word-defined split normalizer is invariant under the actual Ree twist. -/
theorem splitNormalizerWords_invariant (m : ℕ) :
    (splitNormalizerWords m).map (reeAutomorphism m).toMonoidHom =
      splitNormalizerWords m := by
  have hmem (n : SplitGroup m) (hn : n ∈ splitNormalizerWords m) :
      reeAutomorphism m n ∈ splitNormalizerWords m := by
    simpa only [LocalBlockInput.twist_eq_reeAutomorphism] using
      twist_mem_splitNormalizerWords (canonicalLocalBlockInput m) hn
  apply le_antisymm
  · rintro x ⟨n, hn, rfl⟩
    exact hmem n hn
  · intro n hn
    refine ⟨reeAutomorphism m n, hmem n hn, ?_⟩
    simpa only [MulEquiv.coe_toMonoidHom, reeAutomorphism_apply] using reeTwist_involutive m n

private theorem simpleWord_mem_splitNormalizerWords (m : ℕ) (l : List (Fin 4)) :
    simpleWord m l ∈ splitNormalizerWords m := by
  induction l with
  | nil => exact (splitNormalizerWords m).one_mem
  | cons i l ih =>
    exact (splitNormalizerWords m).mul_mem
      (weylWord_mem_splitNormalizerWords m (typeF4SimpleRootIndex i) 1) ih

/-- Both fixed orbit words lie in the fixed normalizer-word subgroup. -/
theorem weylLift_mem_normalizerWords (m : ℕ) (s : Side) :
    weylLift m s ∈ normalizerWords m := by
  rw [mem_normalizerWords, toSplitGroup_weylLift]
  exact simpleWord_mem_splitNormalizerWords m (sideWord s)

/-- A chosen lift with its membership in the concrete normalizer. -/
def simpleLift (m : ℕ) (s : Side) : normalizerWords m :=
  ⟨weylLift m s, weylLift_mem_normalizerWords m s⟩

@[simp] theorem simpleLift_coe (m : ℕ) (s : Side) :
    (simpleLift m s : Model m) = weylLift m s := rfl

private theorem rootGenerator_mul_self (m : ℕ) (r : F4Chevalley.Root)
    (t : CoefficientField m) : rootGeneratorInGroup m r t * rootGeneratorInGroup m r t = 1 := by
  apply Subtype.ext
  change F4Chevalley.rootCurve r t * F4Chevalley.rootCurve r t = 1
  rw [← F4Chevalley.rootCurve_add, CharTwo.add_self_eq_zero, F4Chevalley.rootCurve_zero]

private theorem weylWord_one_mul_self (m : ℕ) (r : F4Chevalley.Root) :
    weylWord m r 1 * weylWord m r 1 = 1 := by
  simp only [weylWord, inv_one]
  have ha := rootGenerator_mul_self m r 1
  have hb := rootGenerator_mul_self m (-r) (-1)
  calc
    _ = rootGeneratorInGroup m r 1 * rootGeneratorInGroup m (-r) (-1) *
        (rootGeneratorInGroup m r 1 * rootGeneratorInGroup m r 1) *
        rootGeneratorInGroup m (-r) (-1) * rootGeneratorInGroup m r 1 := by group
    _ = 1 := by rw [ha, mul_one, mul_assoc (rootGeneratorInGroup m r 1), hb, mul_one, ha]

private theorem simpleWord_reverse (m : ℕ) (l : List (Fin 4)) :
    simpleWord m l.reverse = (simpleWord m l)⁻¹ := by
  induction l with
  | nil => simp [simpleWord]
  | cons i l ih =>
    have hi : (weylWord m (typeF4SimpleRootIndex i) 1)⁻¹ =
        weylWord m (typeF4SimpleRootIndex i) 1 :=
      inv_eq_of_mul_eq_one_left (weylWord_one_mul_self m _)
    simp only [List.reverse_cons, simpleWord, List.map_append, List.prod_append,
      List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
      mul_inv_rev] at ih ⊢
    rw [ih, hi]

/-- The longest word in either exceptional node orbit is an involution. -/
theorem weylLift_sq (m : ℕ) (s : Side) : weylLift m s ^ 2 = 1 := by
  have hrev : (sideWord s).map Fin.revPerm = (sideWord s).reverse := by
    cases s <;> decide
  have hinv : (simpleWord m (sideWord s))⁻¹ = simpleWord m (sideWord s) := by
    rw [← simpleWord_reverse, ← hrev, ← reeTwist_simpleWord, sideWord_fixed]
  apply toSplitGroup_injective m
  rw [map_pow, map_one, toSplitGroup_weylLift, pow_two]
  nth_rw 1 [← hinv]
  exact inv_mul_cancel _

theorem simpleLift_sq (m : ℕ) (s : Side) : simpleLift m s ^ 2 = 1 :=
  Subtype.ext (weylLift_sq m s)

/-- The fixed torus is contained in the Borel–normalizer intersection. -/
theorem fixedTorus_le_intersection (m : ℕ) :
    fixedTorus m ≤ borel m ⊓ normalizerWords m :=
  le_inf (fixedTorus_le_borel m) (fixedTorus_le_normalizerWords m)

end ReeF4.SectionGeometry.BNPair
