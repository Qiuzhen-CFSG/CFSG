module
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.FieldAction
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.Geometry.DiagonalTorus
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockParameters.Basic
public import Theory.GroupTheory.SolvableOuterQuotient

/-!
# Field action on the actual Ree diagonal torus

The torus here is the intersection of the integral F₄ diagonal matrix torus
with the actual exceptional-twist fixed group. Its elements have the explicit
simple-coroot coordinates of `Parabolics.diagonalTorusHom`. Frobenius squares
every matrix entry, hence squares every element of this torus. Iteration gives
the common power `2^k` on the whole torus.

We also name the subgroup of actual automorphisms generated by inner
conjugations and twist-compatible diagonal conjugations. Realizing each
compatible diagonal matrix in the fixed group identifies this inner-diagonal
subgroup with the inner subgroup. That realization is an explicit premise of
the realization theorem; independence of field and inner-diagonal automorphisms
is separate. Every inner-diagonal automorphism is nevertheless implemented by
conjugation by an actual invertible matrix, without a fixed-group realization.
These definitions apply to the full fixed group at `m = 0`, which is not the
Tits simple carrier.

Source: Aschbacher–Smith, Lemma A.3.15(5), printed pp.50–51, and the proof of
Proposition 1.3.4, printed p.511 (`refs/quasithin.pdf`); GLS3, §§2.4–2.5,
for the diagonal and field conventions (`refs/KGroup/GLS3/chapter2.tex`).
-/

@[expose] public section

open Subgroup Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
namespace ReeF4.Cartan
open LocalBlockInput.PairRigidity.BlockParameters
variable {m : ℕ}
/-- The actual fixed diagonal torus, as a subgroup of the Ree carrier. -/
noncomputable def torus (d : LocalBlockInput m) : Subgroup d.fixedGroup :=
  (Parabolics.diagonalTorus m).subgroupOf d.fixedGroup

/-- Membership is witnessed by the four simple-coroot coordinates. -/
theorem torus_coordinates (d : LocalBlockInput m) (x : d.fixedGroup) :
    x ∈ torus d ↔ ∃ u : Parabolics.TorusParameter m,
      Parabolics.diagonalTorusHom m u = x.val.val := Iff.rfl

/-- The matrix of a torus element is diagonal with its Chevalley weights. -/
theorem torus_matrix (d : LocalBlockInput m) {x : d.fixedGroup}
    (hx : x ∈ torus d) : ∃ u : Parabolics.TorusParameter m,
      (x.val.val : MatrixCarrier m) = Matrix.diagonal
        (fun a => (chevalleyBasisTorusUnit (P := typeF4RootPairing) u a : CoefficientField m)) := by
  obtain ⟨u, hu⟩ := (torus_coordinates d x).mp hx
  refine ⟨u, ?_⟩
  rw [← hu, Parabolics.diagonalTorusHom_apply,
    F4Chevalley.torusConjugation.torusElement_apply]
  rfl

/-- The actual field automorphism squares every torus element. -/
theorem field_torus (d : LocalBlockInput m) {x : d.fixedGroup}
    (hx : x ∈ torus d) : d.fieldAutomorphism x = x ^ 2 := by
  obtain ⟨u, hu⟩ := torus_matrix d hx
  apply Subtype.ext
  apply Subtype.ext
  apply Units.ext
  ext i j
  rw [d.fieldAutomorphism_entry]
  change (x.val.val : MatrixCarrier m) i j ^ 2 =
    ((x.val.val : MatrixCarrier m) ^ 2) i j
  simp only [hu, pow_two, Matrix.diagonal_mul_diagonal, Matrix.diagonal_apply]
  split_ifs <;> simp

/-- Iterated field action has a single exponent on the entire torus. -/
theorem field_torus_pow (d : LocalBlockInput m) {x : d.fixedGroup}
    (hx : x ∈ torus d) (k : ℕ) :
    (d.fieldAutomorphism ^ k) x = x ^ (2 ^ k) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', MulAut.mul_apply, ih, map_pow, field_torus d hx,
      ← pow_mul, pow_succ']

/-- Every element of the cyclic field subgroup has one common power on the
whole torus, including elements specified by negative Frobenius powers. -/
theorem field_subgroup_torus_power (d : LocalBlockInput m) (a : MulAut d.fixedGroup)
    (ha : a ∈ zpowers d.fieldAutomorphism) :
    ∃ k : ℕ, ∀ x ∈ torus d, a x = x ^ (2 ^ k) := by
  obtain ⟨k, hk⟩ :=
    (isOfFinOrder_of_finite d.fieldAutomorphism).mem_powers_iff_mem_zpowers.mpr ha
  refine ⟨k, ?_⟩
  intro x hx
  rw [← hk]
  exact field_torus_pow d hx k

/-- Inner conjugations together with actual twist-compatible diagonal conjugations. -/
noncomputable def innerDiagonal (d : LocalBlockInput m) : Subgroup (MulAut d.fixedGroup) :=
  MulAut.innerSubgroup d.fixedGroup ⊔ closure
    {a | ∃ (u : TorusParameters m) (hu : TwistCompatible u), a = fixedTorusConj d u hu}

/-- Every inner automorphism is inner-diagonal. -/
theorem inner_le_innerDiagonal (d : LocalBlockInput m) :
    MulAut.innerSubgroup d.fixedGroup ≤ innerDiagonal d := le_sup_left

/-- Each compatible diagonal conjugation belongs to the generated subgroup. -/
theorem diagonal_mem_innerDiagonal (d : LocalBlockInput m)
    (u : TorusParameters m) (hu : TwistCompatible u) :
    fixedTorusConj d u hu ∈ innerDiagonal d := by
  apply mem_sup_right
  exact subset_closure ⟨u, hu, rfl⟩

private def matrixInduced (d : LocalBlockInput m) : Subgroup (MulAut d.fixedGroup) where
  carrier := {a | ∃ g : MatrixUnits m, ∀ x : d.fixedGroup,
    (a x).val.val = g * x.val.val * g⁻¹}
  one_mem' := ⟨1, fun x => by simp⟩
  mul_mem' := by
    rintro a b ⟨g, hg⟩ ⟨h, hh⟩
    refine ⟨g * h, fun x => ?_⟩
    rw [MulAut.mul_apply, hg, hh]
    simp only [mul_inv_rev, mul_assoc]
  inv_mem' := by
    rintro a ⟨g, hg⟩
    refine ⟨g⁻¹, fun x => ?_⟩
    have he := hg (a⁻¹ x)
    rw [MulAut.apply_inv_self] at he
    rw [inv_inv, he]
    simp only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one]

/-- Inner-diagonal automorphisms act by actual matrix conjugation. The matrix
need not be shown to belong to the root-generated fixed group for this fact. -/
theorem innerDiagonal_matrix_conjugation (d : LocalBlockInput m) (a : MulAut d.fixedGroup)
    (ha : a ∈ innerDiagonal d) :
    ∃ g : MatrixUnits m, ∀ x : d.fixedGroup, (a x).val.val = g * x.val.val * g⁻¹ := by
  have hle : innerDiagonal d ≤ matrixInduced d := by
    apply sup_le
    · rintro a ⟨g, rfl⟩
      exact ⟨g.val.val, fun x => rfl⟩
    · apply (closure_le _).mpr
      rintro a ⟨u, hu, rfl⟩
      refine ⟨(torusMatrix u)⁻¹, fun x => ?_⟩
      rw [fixedTorusConj_coe, inv_inv]
  exact hle ha

/-- Fixed diagonal realization removes diagonal outer automorphisms. -/
theorem innerDiagonal_eq_inner_of_realization (d : LocalBlockInput m)
    (hr : ∀ u : TorusParameters m, TwistCompatible u →
      ∃ g : d.fixedGroup, g.val.val = (torusMatrix u)⁻¹) :
    innerDiagonal d = MulAut.innerSubgroup d.fixedGroup := by
  apply sup_eq_left.mpr
  apply (closure_le _).mpr
  rintro a ⟨u, hu, rfl⟩
  obtain ⟨g, hg⟩ := hr u hu
  refine ⟨g, ?_⟩
  apply MulEquiv.ext
  intro x
  apply Subtype.ext
  apply Subtype.ext
  rw [fixedTorusConj_coe]
  change g.val.val * x.val.val * g.val.val⁻¹ = _
  rw [hg, inv_inv]

end ReeF4.Cartan
