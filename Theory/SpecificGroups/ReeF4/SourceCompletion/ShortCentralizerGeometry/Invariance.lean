module
public import Theory.SpecificGroups.ReeF4.SourceCompletion.ShortCentralizerGeometry.Radical
public import Theory.SpecificGroups.ReeF4.ConverseParabolics.SylowAlignment
public import Theory.SpecificGroups.ReeF4.SourceCompletion.Centers


/-!
# Invariance of the literal long-root plane under full endpoint automorphisms

The plane is generated by the central long-root line of the native Sylow
and its linear Weyl conjugate. Sylow conjugacy inside the full linear
parabolic reduces any automorphism preserving that parabolic to one fixing
the Sylow and hence its center. Parabolic normalization then preserves the
whole plane. This includes the outer automorphisms in a marked extension.

Source: Aschbacher--Smith F.4.42, printed p.295 (`refs/quasithin.pdf`).
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace ReeF4.SourceCompletion.ShortCentralizerGeometry
open LargeLocalSeeds Parabolics EvenInvolutionGeometry ElementaryTwoBound
open Parabolics.Binary.FixedGeometry SectionGeometry.BNPair
open NormalizedRootCentralizers.CenterExponent
open ElementaryTwoBound.Replacement.CentralizerGeometry

private theorem plane_generated (m : ℕ) :
    Replacement.V m = longRootGroup m ⊔
      (longRootGroup m).map (MulAut.conj (weylLift m .linear)).toMonoidHom := by
  have h4 : longRootGroup m ≤ Replacement.V m := by
    intro v hv
    obtain ⟨b,rfl⟩ := (mem_longRootGroup m _).mp hv
    exact (mem_V_iff m _).mpr ⟨0,b,by simp; rfl⟩
  have hw : (longRootGroup m).map (MulAut.conj (weylLift m .linear)).toMonoidHom ≤ Replacement.V m := by
    rintro _ ⟨v,hv,rfl⟩
    exact (mem_normalizer_iff.mp (weyl_normalizes_plane m) v).mp (h4 hv)
  apply le_antisymm _ (sup_le h4 hw)
  intro v hv
  obtain ⟨a,b,rfl⟩ := (mem_V_iff m v).mp hv
  apply (longRootGroup m ⊔ (longRootGroup m).map
    (MulAut.conj (weylLift m .linear)).toMonoidHom).mul_mem
  · exact (show longRootGroup m ≤ _ from le_sup_left) ((mem_longRootGroup m _).mpr ⟨b,rfl⟩)
  · apply (show (longRootGroup m).map (MulAut.conj (weylLift m .linear)).toMonoidHom ≤ _ from le_sup_right)
    refine ⟨longRootElement m a,(mem_longRootGroup m _).mpr ⟨a,rfl⟩,?_⟩
    have hh := weyl_conjugate_plane m 0 a
    change weylLift m .linear * longRootElement m a * (weylLift m .linear)⁻¹ = _
    rw [show longRootElement m a = centralElement m 4 a from Subtype.ext (by rfl)]
    simpa only [centralElement_zero,mul_one,one_mul] using hh

/-- Any native automorphism stabilizing the whole linear parabolic preserves
its literal long-root plane. Sylow conjugacy reduces to an automorphism
fixing U and hence its center; the plane is generated by two such lines. -/
theorem automorphism_preserves_plane {m : ℕ} (hm : 0 < m)
    (a : MulAut (Model m))
    (hP : (parabolic m .linear).map a.toMonoidHom = parabolic m .linear) :
    (Replacement.V m).map a.toMonoidHom = Replacement.V m := by
  let P := parabolic m .linear
  obtain ⟨U,hU⟩ := ConverseParabolics.exists_sylow_eq_unipotent m
  have hUn : (U : Subgroup (Model m)) = unipotent m :=
    hU.trans (MaximalSubgroups.AbelianCharacteristic.TwoLocalGeometry.unipotent_eq_rootUnipotent m)
  have hUP : (U : Subgroup (Model m)) ≤ P := by
    rw [hUn]
    exact (unipotent_le_localFactor m .linear).trans (localFactor_le_parabolic m .linear)
  have haUP : ((a • U : Sylow 2 (Model m)) : Subgroup (Model m)) ≤ P := by
    change (U : Subgroup (Model m)).map a.toMonoidHom ≤ P
    exact (map_mono hUP).trans_eq hP
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq P ((a • U).subtype haUP) (U.subtype hUP)
  have hUa : (unipotent m).map ((MulAut.conj g.val) * a).toMonoidHom = unipotent m := by
    have he := congrArg (fun S : Sylow 2 P => (S : Subgroup P).map P.subtype) hg
    rw [Sylow.smul_subtype] at he
    simp only [Sylow.coe_subtype] at he
    rw [map_subgroupOf_eq_of_le (Sylow.smul_le haUP g),
      map_subgroupOf_eq_of_le hUP] at he
    change ((U : Subgroup (Model m)).map a.toMonoidHom).map
      (MulAut.conj g.val).toMonoidHom = (U : Subgroup (Model m)) at he
    rw [show (MulAut.conj g.val * a).toMonoidHom =
      (MulAut.conj g.val).toMonoidHom.comp a.toMonoidHom from rfl, ←map_map, ←hUn]
    exact he
  let b : MulAut (Model m) := MulAut.conj g.val * a
  have hbP : P.map b.toMonoidHom = P := by
    rw [show b.toMonoidHom = (MulAut.conj g.val).toMonoidHom.comp a.toMonoidHom from rfl,
      ←map_map,hP]
    exact mem_normalizer_iff_map_conj_eq.mp (P.le_normalizer g.property)
  have hbZ : (longRootGroup m).map b.toMonoidHom = longRootGroup m := by
    rw [←unipotent_center_eq_longRootGroup m hm]
    let e : unipotent m ≃* unipotent m :=
      (unipotent m).equivMapOfInjective b.toMonoidHom b.injective |>.trans (MulEquiv.subgroupCongr hUa)
    apply le_antisymm
    · rintro _ ⟨_,⟨z,hz,rfl⟩,rfl⟩
      exact ⟨e z, (characteristic_iff_le_comap.mp inferInstance e) hz,rfl⟩
    · rintro _ ⟨z,hz,rfl⟩
      refine ⟨(e.symm z).val,⟨e.symm z,?_,rfl⟩,?_⟩
      · exact (characteristic_iff_le_comap.mp inferInstance e.symm) hz
      · exact congrArg Subtype.val (e.apply_symm_apply z)
  have hbV : (Replacement.V m).map b.toMonoidHom ≤ Replacement.V m := by
    rw [plane_generated m] at ⊢
    rw [Subgroup.map_sup]
    rw [←plane_generated m]
    apply sup_le (hbZ.le.trans (by rw [plane_generated]; exact le_sup_left))
    rintro _ ⟨_,⟨v,hv,rfl⟩,rfl⟩
    have hwP : b (weylLift m .linear) ∈ P := by
      rw [←hbP]
      exact mem_map_of_mem _ (by
        exact (seed_le_parabolic m .linear) (weylLift_mem_seed m .linear))
    change b (weylLift m .linear * v * (weylLift m .linear)⁻¹) ∈ Replacement.V m
    rw [map_mul,map_mul,map_inv]
    exact (mem_normalizer_iff.mp (parabolic_normalizes_plane m hm hwP) _).mp
      ((show (longRootGroup m).map b.toMonoidHom ≤ Replacement.V m from
        hbZ.le.trans (by rw [plane_generated]; exact le_sup_left)) (mem_map_of_mem _ hv))
  have haV : (Replacement.V m).map a.toMonoidHom ≤ Replacement.V m := by
    intro y hy
    obtain ⟨x,hx,rfl⟩ := hy
    have hh := hbV (mem_map_of_mem b.toMonoidHom hx)
    have hn := parabolic_normalizes_plane m hm g.property
    have he : a x = g.val⁻¹ * b x * g.val := by
      change a x = g.val⁻¹ * (g.val * a x * g.val⁻¹) * g.val
      group
    change a x ∈ Replacement.V m
    rw [he]
    exact (mem_normalizer_iff.mp (inv_mem hn) _).mp hh
  exact eq_of_le_of_card_ge haV (card_map_of_injective a.injective).ge

end ReeF4.SourceCompletion.ShortCentralizerGeometry
