module
public import Theory.SpecificGroups.ReeF4.SourceCompletion.Automorphisms
public import Theory.SpecificGroups.ReeF4.SmallCompletion.Native
public import Theory.GroupTheory.PResidual.PrimeToMonotone

/-!
# Odd outer degree and Sylow subgroups in general Ree extensions

The common inner–field expression covers the entire native automorphism
group. Its outer quotient is therefore cyclic of order dividing 2m+1.
Every intermediate group containing the native inner image has the same
odd-degree restriction. The two root-defined local factors generate the
native group and are literal prime-to-two residuals, so O^{2′} of each
extension is exactly the native inner subgroup. Injectivity of conjugation
then gives the exact extension order and transports native Sylow subgroups.
No simplicity, ambient recognition or order-bound hypothesis is used.

These are the positive-parameter Ree inputs to Aschbacher–Smith F.4.29,38
and the same-extension count in F.4.43, printed pp.289,294,296.
-/

public noncomputable section
namespace ReeF4.SourceCompletion
open Subgroup Parabolics Parabolics.OuterLocal Parabolics.OuterLocal.LargeAutomorphisms

private theorem field_surjective {N : Type*} [Group N] (φ : MulAut N)
    (h : ∀ a : MulAut N, ∃ (g : N) (k : ℕ), a = MulAut.conj g * φ^k) :
    Function.Surjective ((QuotientGroup.mk' (MulAut.innerSubgroup N)).comp
      (zpowers φ).subtype) := by
  intro q
  obtain ⟨a,rfl⟩ := QuotientGroup.mk'_surjective (MulAut.innerSubgroup N) q
  obtain ⟨g,k,rfl⟩ := h a
  refine ⟨⟨φ^k,pow_mem (mem_zpowers φ) k⟩,?_⟩
  change QuotientGroup.mk' _ (φ^k) = QuotientGroup.mk' _ (MulAut.conj g * φ^k)
  have hg : QuotientGroup.mk' (MulAut.innerSubgroup N) (MulAut.conj g) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr ⟨g,rfl⟩
  rw [map_mul,hg,one_mul]

/-- The full native outer automorphism group is cyclic, including q=8. -/
theorem outer_cyclic (m : ℕ) (hm : 0 < m) : IsCyclic (MulAut.Outer (Model m)) :=
  isCyclic_of_surjective _ (field_surjective (fieldAutomorphism m) (inner_field m hm))

/-- Its actual order divides the coefficient-field degree. -/
theorem outer_card_dvd_degree (m : ℕ) (hm : 0 < m) :
    Nat.card (MulAut.Outer (Model m)) ∣ 2*m+1 := by
  have hh := card_dvd_of_surjective _ (field_surjective (fieldAutomorphism m) (inner_field m hm))
  rw [Nat.card_zpowers] at hh
  exact hh.trans (orderOf_dvd_of_pow_eq_one (fieldAutomorphism_period m))

/-- The native group is generated by its literal prime-to-two local residuals. -/
theorem native_primeToResidual (m : ℕ) : primeToResidual 2 (Model m) = ⊤ := by
  apply top_unique
  rw [←seed_sup_eq_top m,seed_eq_localFactor,seed_eq_localFactor]
  exact sup_le (map_primeToResidual_le_of_hom 2 (parabolic m .suzuki).subtype)
    (map_primeToResidual_le_of_hom 2 (parabolic m .linear).subtype)

/-- The outer index of any native automorphism subgroup divides the same degree. -/
theorem extension_inner_index_dvd {m : ℕ} (hm : 0 < m)
    (E : Subgroup (MulAut (Model m))) :
    ((MulAut.innerSubgroup (Model m)).subgroupOf E).index ∣ 2*m+1 :=
  ((MulAut.innerSubgroup (Model m)).relIndex_dvd_index_of_normal E).trans
    (outer_card_dvd_degree m hm)

/-- Every such relative outer index is odd. -/
theorem extension_inner_index_odd {m : ℕ} (hm : 0 < m)
    (E : Subgroup (MulAut (Model m))) :
    Odd ((MulAut.innerSubgroup (Model m)).subgroupOf E).index :=
  (show Odd (2*m+1) from ⟨m,rfl⟩).of_dvd_nat (extension_inner_index_dvd hm E)

private theorem base_range {N : Type*} [Group N] (E : Subgroup (MulAut N))
    (hi : MulAut.innerSubgroup N ≤ E) :
    ((MulAut.conj : N →* MulAut N).codRestrict E (fun g => hi ⟨g,rfl⟩)).range =
      (MulAut.innerSubgroup N).subgroupOf E := by
  ext a
  constructor
  · rintro ⟨g,rfl⟩
    exact ⟨g,rfl⟩
  · rintro ⟨g,hg⟩
    exact ⟨g,Subtype.ext hg⟩

/-- For a full extension, O^{2′} is exactly the native inner subgroup. -/
theorem extension_primeToResidual {m : ℕ} (hm : 0 < m)
    (E : Subgroup (MulAut (Model m))) (hi : MulAut.innerSubgroup (Model m) ≤ E) :
    primeToResidual 2 E = (MulAut.innerSubgroup (Model m)).subgroupOf E := by
  apply le_antisymm (primeToResidual_le _ (extension_inner_index_odd hm E).coprime_two_left)
  let f := (MulAut.conj : Model m →* MulAut (Model m)).codRestrict E (fun g => hi ⟨g,rfl⟩)
  have hh := map_primeToResidual_le_of_hom 2 f
  rw [native_primeToResidual,←MonoidHom.range_eq_map] at hh
  exact (base_range E hi) ▸ hh

/-- The literal quotient of an extension by its inner subgroup is cyclic. -/
theorem extension_outer_cyclic {m : ℕ} (hm : 0 < m)
    (E : Subgroup (MulAut (Model m))) :
    IsCyclic (E ⧸ (MulAut.innerSubgroup (Model m)).subgroupOf E) := by
  let := outer_cyclic m hm
  let f := (QuotientGroup.mk' (MulAut.innerSubgroup (Model m))).comp E.subtype
  have hk : f.ker = (MulAut.innerSubgroup (Model m)).subgroupOf E := by
    ext a
    exact QuotientGroup.eq_one_iff a.val
  let e := (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
    (QuotientGroup.quotientKerEquivRange f)
  exact isCyclic_of_injective e.toMonoidHom e.injective

/-- The order uses the actual outer index of this same extension carrier. -/
theorem extension_card_factor {m : ℕ} (hm : 0 < m)
    (E : Subgroup (MulAut (Model m))) (hi : MulAut.innerSubgroup (Model m) ≤ E) :
    Nat.card E = ((MulAut.innerSubgroup (Model m)).subgroupOf E).index * Nat.card (Model m) := by
  let f := (MulAut.conj : Model m →* MulAut (Model m)).codRestrict E (fun g => hi ⟨g,rfl⟩)
  have hf : Function.Injective f :=
    (MonoidHom.injective_codRestrict _ _ _).mpr (SmallCompletion.conj_injective m hm)
  have hc : Nat.card ((MulAut.innerSubgroup (Model m)).subgroupOf E) = Nat.card (Model m) := by
    rw [←base_range E hi]
    exact (Nat.card_congr (MonoidHom.ofInjective hf).toEquiv).symm
  exact ((MulAut.innerSubgroup (Model m)).subgroupOf E).index_mul_card.symm.trans
    (congrArg (_ * ·) hc)

/-- A native Sylow remains Sylow under the marked inner embedding into an extension. -/
theorem extension_sylow {m : ℕ} (hm : 0 < m)
    (E : Subgroup (MulAut (Model m))) (hi : MulAut.innerSubgroup (Model m) ≤ E)
    (S : Sylow 2 (Model m)) :
    ∃ T : Sylow 2 E, (T : Subgroup E) = (S : Subgroup (Model m)).map
      ((MulAut.conj : Model m →* MulAut (Model m)).codRestrict E (fun g => hi ⟨g,rfl⟩)) := by
  let f := (MulAut.conj : Model m →* MulAut (Model m)).codRestrict E (fun g => hi ⟨g,rfl⟩)
  have hf : Function.Injective f :=
    (MonoidHom.injective_codRestrict _ _ _).mpr (SmallCompletion.conj_injective m hm)
  have hn : ¬ 2 ∣ ((S : Subgroup (Model m)).map f).index := by
    rw [index_map_of_injective _ hf,base_range E hi]
    exact Nat.Prime.not_dvd_mul Nat.prime_two S.not_dvd_index
      (extension_inner_index_odd hm E).not_two_dvd_nat
  exact ⟨(S.isPGroup'.map f).toSylow hn,rfl⟩
end ReeF4.SourceCompletion
