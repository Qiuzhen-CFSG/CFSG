/-- The five coordinates visible in the fourth-power test. -/
abbrev Coordinates := Fin 4 × Bool × Bool × Bool × Fin 4

def normalWord (t : Coordinates) : List (Fin 7) :=
  List.replicate t.1.val 1 ++ (if t.2.1 then [2] else []) ++
    (if t.2.2.1 then [3,3] else []) ++ (if t.2.2.2.1 then [4] else []) ++
      List.replicate t.2.2.2.2.val 5

def output (ρ σ τ ε : Bool) : Coordinates :=
  (if Bool.xor τ ε then 3 else 1, !σ, Bool.xor (Bool.xor ρ σ) τ, τ,
    if Bool.xor (Bool.xor (!σ) τ) ε then 3 else 1)

include hr in
/-- A checked fourth-power computation for the two outer Suzuki letters. -/
theorem fourth_output (ρ σ τ ε : Bool)
    (hi : ∀ i, evalWord x (images ρ σ τ ε i) = f (x i)) :
    evalWord x (normalWord (output ρ σ τ ε)) =
      f (f (f (f (evalWord x [1,5])))) := by
  cases ρ <;> cases σ <;> cases τ <;> cases ε
  · exact fourth_0000 x f hr hi
  · exact fourth_0001 x f hr hi
  · exact fourth_0010 x f hr hi
  · exact fourth_0011 x f hr hi
  · exact fourth_0100 x f hr hi
  · exact fourth_0101 x f hr hi
  · exact fourth_0110 x f hr hi
  · exact fourth_0111 x f hr hi
  · exact fourth_1000 x f hr hi
  · exact fourth_1001 x f hr hi
  · exact fourth_1010 x f hr hi
  · exact fourth_1011 x f hr hi
  · exact fourth_1100 x f hr hi
  · exact fourth_1101 x f hr hi
  · exact fourth_1110 x f hr hi
  · exact fourth_1111 x f hr hi

include hr in
/-- Coordinate separation and the rank-one fourth-power identity force all four bits. -/
theorem rigidity (ρ σ τ ε : Bool)
    (hi : ∀ i, evalWord x (images ρ σ τ ε i) = f (x i))
    (hsep : Function.Injective (fun t : Coordinates => evalWord x (normalWord t)))
    (hfour : f (f (f (f (evalWord x [1,5])))) = evalWord x [1,5]) :
    ρ = true ∧ σ = true ∧ τ = false ∧ ε = false := by
  have hc : output ρ σ τ ε = (1,false,false,false,1) :=
    hsep ((fourth_output x f hr ρ σ τ ε hi).trans hfour)
  cases ρ <;> cases σ <;> cases τ <;> cases ε <;>
    simp_all [output]
end ReeF4.RootPresentationRecognition.BinaryEndRigidity
