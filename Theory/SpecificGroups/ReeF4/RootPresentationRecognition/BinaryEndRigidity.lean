/-!
# Four binary coefficients forced by the rank-one relation

The seven interior root generators have a fixed order and collection table.
The candidate Suzuki action has four remaining binary coefficients after its
three leading coordinates are determined. Explicit word rewrites calculate
its fourth power after reflection, and unique root coordinates force all four
coefficients. Every finite certificate is checked in the kernel; the rule
soundness theorem applies in any ambient group.

Source: Fong--Seitz II (1974), Section 10, (10.36)--(10.41), expressed in the
native triangular Suzuki charts. Letters, from zero to six, are
L0(1), S2(1,0), L2(1), S1(1,0), L3(1), S3(1,0), L1(1).
-/

@[expose] public section
namespace ReeF4.RootPresentationRecognition.BinaryEndRigidity
open Theory.GroupTheory WordRewrite

/-- Letters are L0,S2,L2,S1,L3,S3,L1, in this order. -/
def rules : Fin 28 → Rule 7 := ![⟨[0,0],[]⟩,
  ⟨[1,1,1,1],[]⟩,
  ⟨[2,2],[]⟩,
  ⟨[3,3,3,3],[]⟩,
  ⟨[4,4],[]⟩,
  ⟨[5,5,5,5],[]⟩,
  ⟨[6,6],[]⟩,
  ⟨[1,0],[0,1]⟩,
  ⟨[2,0],[0,2]⟩,
  ⟨[2,1],[1,2]⟩,
  ⟨[3,0],[0,3,1,1]⟩,
  ⟨[3,1],[1,3,2]⟩,
  ⟨[3,2],[2,3]⟩,
  ⟨[4,0],[0,4]⟩,
  ⟨[4,1],[1,4,3,3]⟩,
  ⟨[4,2],[2,4]⟩,
  ⟨[4,3],[3,4]⟩,
  ⟨[5,0],[0,5,2,1,1]⟩,
  ⟨[5,1],[1,5]⟩,
  ⟨[5,2],[2,5,3,3]⟩,
  ⟨[5,3],[3,5,4]⟩,
  ⟨[5,4],[4,5]⟩,
  ⟨[6,0],[0,6,4,2]⟩,
  ⟨[6,1],[1,6,4,5,5]⟩,
  ⟨[6,2],[2,6]⟩,
  ⟨[6,3],[3,6,5,5]⟩,
  ⟨[6,4],[4,6]⟩,
  ⟨[6,5],[5,6]⟩]

def actor (ρ σ τ ε : Bool) : Fin 7 → List (Fin 7) :=
  ![[0,1,1,1,2] ++ (if ρ then [3,3] else []) ++
      (if σ then [4] else []) ++ (if τ then [5,5,5] else [5]) ++ [6],
    [1] ++ (if ε then [3] else [3,3,3]) ++ [4] ++
      (if ε then [5,5,5] else [5]),
    [4,3,3,2], [3], [5,5,4], [5,6], [6]]

/-- Right conjugation after reflection reverses the seven letters. -/
def images (ρ σ τ ε : Bool) (i : Fin 7) : List (Fin 7) :=
  actor ρ σ τ ε i.rev

variable {G : Type*} [Group G] (x : Fin 7 → G) (f : G →* G)
  (hr : ∀ i, evalWord x (rules i).lhs = evalWord x (rules i).rhs)

