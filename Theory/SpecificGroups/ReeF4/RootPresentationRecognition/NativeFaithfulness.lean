module
public import Theory.SpecificGroups.ReeF4.RootPresentationRecognition.GlobalRealizations
public import Theory.SpecificGroups.ReeF4.RootPresentationRecognition.GlobalGeneration

/-!
# NativeFaithfulness

Internal Bruhat collection reduces the constructed native evaluation kernel to the Borel. The proved angular presentation and full Cartan separation kill that kernel for every m, including zero.

Source: GLS3 2.3.5--8 and Table 2.4; Steinberg, section 11, Lemmas 62--64.
The source fields, local equations and exhaustive row selection remain source
producer obligations; binary type tags do not supply these data.
-/

@[expose] public noncomputable section

namespace ReeF4.RootPresentationRecognition.Global
open Subgroup Theory.GroupTheory OrderedRootPresentation
open SignedGeometry WeylPresentation CentralCovers.TwoPrimary
open CentralCovers.OddPrimary.Order SectionGeometry.BNPair

/-- The known full model is generated by this precise finite alphabet. -/
theorem native_whole (m : ℕ) : (native m).whole = ⊤ := by
  apply top_unique
  rw [← borel_normalizerWords_generate m]
  apply (closure_le _).mpr
  intro g hg
  rcases hg with hg | hg
  · exact (native m).borel_le_whole ((native_borel m).symm ▸ hg)
  · obtain ⟨t,ht,w,hw,rfl⟩ := exists_torus_weyl m hg
    rw [← NormalizerPresentation.weyl_range] at hw
    obtain ⟨v,rfl⟩ := hw
    exact mul_mem ((native m).borel_le_whole ((native m).torus_mem_borel ⟨t,ht⟩))
      ((native m).weyl_mem_whole v)

/-- Evaluation in the full native carrier, constructed from the finite relators. -/
def nativeEval (m : ℕ) : Presentation.Group m →* Model m :=
  Presentation.eval (native m) (native_relations m)

@[simp] theorem nativeEval_torus (m : ℕ) (t : Parabolics.fixedTorus m) :
    nativeEval m (Presentation.torus m t) = t := Presentation.eval_torus _ _ t
@[simp] theorem nativeEval_weyl (m : ℕ) (w : Weyl) :
    nativeEval m (Presentation.weyl m w) = NormalizerPresentation.weyl m w := Presentation.eval_weyl _ _ w

theorem nativeEval_surjective (m : ℕ) : Function.Surjective (nativeEval m) := by
  apply MonoidHom.range_eq_top.mp
  rw [nativeEval,Presentation.eval_range,native_whole]

private theorem nativeEval_positive (m : ℕ) (a : AngularPresentation.Presentation m) :
    nativeEval m (Presentation.positiveMap m a) = AngularPresentation.nativeEval m a :=
  DFunLike.congr_fun (Presentation.eval_positiveMap (native m) (native_relations m)) a

/-- The abstract positive kernel is killed by the already proved angular presentation. -/
theorem nativeEval_unipotent_kernel (m : ℕ) (u : Presentation.Group m)
    (hu : u ∈ (Presentation.generators m).unipotent) (he : nativeEval m u = 1) : u = 1 := by
  rw [← Presentation.positiveMap_range] at hu
  obtain ⟨a,rfl⟩ := hu
  have ha : a = 1 := (AngularPresentation.nativeEval_bijective m).injective
    (by apply Subtype.ext; simpa only [nativeEval_positive,map_one,coe_one] using he)
  rw [ha,map_one]

theorem nativeEval_unipotent_mem (m : ℕ) (u : Presentation.Group m)
    (hu : u ∈ (Presentation.generators m).unipotent) : nativeEval m u ∈ Parabolics.unipotent m := by
  rw [← Presentation.positiveMap_range] at hu
  obtain ⟨a,rfl⟩ := hu
  rw [nativeEval_positive]
  exact (AngularPresentation.nativeEval m a).property

/-- Full-Cartan/positive separation proves faithfulness on the entire abstract Borel. -/
theorem nativeEval_borel_kernel (m : ℕ) (b : Presentation.Group m)
    (hb : b ∈ (Presentation.generators m).borel) (he : nativeEval m b = 1) : b = 1 := by
  obtain ⟨t,u,hu,rfl⟩ := ((Presentation.generators m).mem_borel_iff (Presentation.relations m) b).mp hb
  change nativeEval m (Presentation.torus m t * u) = 1 at he
  change Presentation.torus m t * u = 1
  rw [map_mul,nativeEval_torus] at he
  have htU : (t : Model m) ∈ Parabolics.unipotent m := by
    rw [eq_inv_of_mul_eq_one_left he]
    exact (Parabolics.unipotent m).inv_mem (nativeEval_unipotent_mem m u hu)
  have ht : (t : Model m) = 1 := SourceBorel.native_disjoint.symm.le_bot ⟨t.property,htU⟩
  have hu1 : u = 1 := nativeEval_unipotent_kernel m u hu (by simpa only [ht,one_mul] using he)
  have ht1 : t = 1 := Subtype.ext ht
  rw [ht1,hu1,map_one,mul_one]

/-- A literal native Weyl word lies in B only when its dihedral parameter is 1. -/
theorem native_weyl_mem_borel (m : ℕ) (w : Weyl)
    (hw : NormalizerPresentation.weyl m w ∈ Parabolics.borel m) : w = 1 := by
  have hW : NormalizerPresentation.weyl m w ∈ Parabolics.Binary.FixedGeometry.weylSubgroup m := by
    rw [← NormalizerPresentation.weyl_range]
    exact ⟨w,rfl⟩
  have hT : NormalizerPresentation.weyl m w ∈ Parabolics.fixedTorus m := by
    rw [← borel_inf_normalizerWords]
    exact ⟨hw,NormalizerPresentation.weyl_le_normalizerWords m hW⟩
  have he : NormalizerPresentation.weyl m w = 1 := (fixedTorus_disjoint_weylSubgroup m).le_bot ⟨hT,hW⟩
  exact NormalizerPresentation.weyl_injective m (he.trans (map_one _).symm)

/-- Global faithfulness uses internal Bruhat existence and native Borel/Weyl
separation. It does not use simplicity, perfectness, or an assumed central kernel. -/
theorem nativeEval_injective (m : ℕ) : Function.Injective (nativeEval m) := by
  apply (injective_iff_map_eq_one _).mpr
  intro g hg
  obtain ⟨a,b,s,k,ha,hb,hk,rfl⟩ := Presentation.bruhat m g
  have hB {c : Presentation.Group m} (hc : c ∈ (Presentation.generators m).borel) :
      nativeEval m c ∈ Parabolics.borel m := by
    rw [← native_borel]
    exact Presentation.eval_mem_borel (native m) (native_relations m) hc
  have hw : NormalizerPresentation.weyl m (alternating s k) ∈ Parabolics.borel m := by
    have he : NormalizerPresentation.weyl m (alternating s k) =
        (nativeEval m a)⁻¹ * (nativeEval m b)⁻¹ := by
      change nativeEval m (a * Presentation.weyl m (alternating s k) * b) = 1 at hg
      rw [map_mul,map_mul,nativeEval_weyl] at hg
      calc
        _ = (nativeEval m a)⁻¹ *
          (nativeEval m a * NormalizerPresentation.weyl m (alternating s k) * nativeEval m b) *
            (nativeEval m b)⁻¹ := by group
        _ = _ := by rw [hg,mul_one]
    rw [he]
    exact mul_mem (inv_mem (hB ha)) (inv_mem (hB hb))
  have hw1 := native_weyl_mem_borel m (alternating s k) hw
  change a * Presentation.weyl m (alternating s k) * b = 1
  rw [hw1,map_one,mul_one] at hg ⊢
  exact nativeEval_borel_kernel m (a*b) (mul_mem ha hb) hg

/-- The explicit finite presentation is the full Ree model for every m, including zero. -/
def nativeEquiv (m : ℕ) : Presentation.Group m ≃* Model m :=
  MulEquiv.ofBijective (nativeEval m) ⟨nativeEval_injective m,nativeEval_surjective m⟩

end ReeF4.RootPresentationRecognition.Global
