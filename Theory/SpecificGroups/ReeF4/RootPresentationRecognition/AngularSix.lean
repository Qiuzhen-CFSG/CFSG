module
public import Theory.SpecificGroups.ReeF4.RootPresentationRecognition.AngularSuffix

/-!
# The six-root interval before the last linear root

The six interior root groups are generated by their main field curves. The
native interval commutator bounds make their join stable under the first Suzuki
root. A homomorphism out of this join intertwines that whole action once it
intertwines inverse-main actors on the six main curves. This separates the
opposite Suzuki equation from the independent last linear-root equation.

Source: Steinberg, Lectures on Chevalley Groups, §11; Fong--Seitz II, Section 10.
-/

@[expose] public noncomputable section
namespace ReeF4.RootPresentationRecognition.AngularSix
open Subgroup Theory.GroupTheory OrderedRootPresentation CentralCovers.TwoPrimary
open ElementaryTwoBound.RootCalculations NormalizedRootCentralizers.CenterExponent
variable (m : ℕ)

abbrev order : List PositiveTables.Root := [.inl 1,.inr 3,.inl 3,.inr 1,.inl 2,.inr 2]

theorem member (i : PositiveTables.Root) : i ∈ order ↔ 0 < rootIndex i ∧ rootIndex i < 7 := by
  cases i with
  | inl i => fin_cases i <;> simp [order,rootIndex,positive_pair_indices,positive_quartet_indices]
  | inr i => fin_cases i <;> simp [order,rootIndex,positive_pair_indices,positive_quartet_indices]

theorem member_suffix (i : PositiveTables.Root) (hi : i ∈ order) :
    i ∈ AngularSuffix.suffixOrder := by
  apply (AngularSuffix.suffix_member i).mpr
  intro h
  subst i
  have h := (member _).mp hi
  simp [rootIndex,positive_quartet_indices,Sum.elim] at h

abbrev Carrier := join (AngularPresentation.Parameter m) (AngularPresentation.nativeRoot m) order

def root (i : PositiveTables.Root) (hi : i ∈ order) :
    AngularPresentation.Parameter m i →* Carrier m :=
  (AngularPresentation.nativeRoot m i).codRestrict _ (fun a =>
    range_le_join _ _ _ hi ⟨a,rfl⟩)

private theorem main_val (i : PositiveTables.Root) (t : CoefficientField m) :
    (AngularSuffix.mainParameter m i t : Model m) = mainElement m (rootIndex i) t := by
  cases i with
  | inl i => exact PositiveTables.pair_main i t
  | inr i =>
    change (PositiveTables.quartet m i t 0 : Model m) = _
    rw [PositiveTables.quartet_blockPoint,blockPoint,centralElement_zero,mul_one]

private def generators : Set (Model m) :=
  {g | ∃ i ∈ order, ∃ t : CoefficientField m, (AngularSuffix.mainParameter m i t : Model m) = g}

private theorem closure_generators : closure (generators m) = Carrier m := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨i,hi,t,rfl⟩
    exact range_le_join _ _ _ hi ⟨AngularSuffix.mainParameter m i t,rfl⟩
  · apply join_le
    intro i hi
    rintro _ ⟨a,rfl⟩
    have hle : closure (Set.range (AngularSuffix.mainParameter m i)) ≤
        (closure (generators m)).comap (AngularPresentation.nativeRoot m i) := by
      apply (closure_le _).mpr
      rintro _ ⟨t,rfl⟩
      exact subset_closure ⟨i,hi,t,rfl⟩
    rw [AngularSuffix.root_main_generate] at hle
    exact hle (mem_top a)

private theorem normalizes_of_right_commutators {G : Type*} [Group G] [Finite G]
    (S : Set G) (a : G)
    (h : ∀ b ∈ S, a⁻¹ * b⁻¹ * a * b ∈ closure S) :
    a ∈ normalizer (closure S : Set G) := by
  have hc : closure S ≤ (closure S).comap (MulAut.conj a⁻¹).toMonoidHom := by
    apply (closure_le _).mpr
    intro b hb
    change a⁻¹ * b * (a⁻¹)⁻¹ ∈ closure S
    have he : a⁻¹ * b * (a⁻¹)⁻¹ = b * (a⁻¹ * b⁻¹ * a * b)⁻¹ := by group
    rw [he]
    exact mul_mem (subset_closure hb) (inv_mem (h b hb))
  let f : closure S → closure S := fun b => ⟨_, hc b.property⟩
  have hf : Function.Injective f := by
    intro b c he
    apply Subtype.ext
    exact (MulAut.conj a⁻¹).injective (congrArg Subtype.val he)
  have hs := Finite.surjective_of_injective hf
  apply inv_mem_iff.mp
  apply mem_normalizer_iff.mpr
  intro b
  constructor
  · exact fun hb => hc hb
  · intro hb
    obtain ⟨c, he⟩ := hs ⟨_, hb⟩
    have he' : c.val = b := (MulAut.conj a⁻¹).injective (congrArg Subtype.val he)
    exact he' ▸ c.property

theorem first_normalizes : ElementaryTwoBound.X m 0 ≤ normalizer (Carrier m : Set (Model m)) := by
  apply (closure_le _).mpr
  rintro _ ⟨a,rfl⟩
  rw [← closure_generators]
  apply normalizes_of_right_commutators
  rintro _ ⟨i,hi,t,rfl⟩
  rw [closure_generators,main_val]
  have hb := (member i).mp hi
  apply TailRelations.BaseIntervals.main_commutator_mem m 0 (rootIndex i) hb.1
  intro k hk0 hki
  have hk : sourceIndex k ∈ order := (member _).mpr (by
    rw [rootIndex_sourceIndex]
    exact ⟨hk0,lt_trans hki hb.2⟩)
  simpa only [AngularPresentation.nativeRoot,range_subtype,rootIndex_sourceIndex] using
    (range_le_join (AngularPresentation.Parameter m) (AngularPresentation.nativeRoot m) order hk)

theorem le_suffix : Carrier m ≤ AngularSuffix.Carrier m := by
  apply join_le
  intro i hi
  exact range_le_join _ _ _ (member_suffix i hi)

def inclusion : Carrier m →* AngularSuffix.Carrier m := Subgroup.inclusion (le_suffix m)

def firstAction : AngularPresentation.Parameter m (.inr 0) →* MulAut (Carrier m) :=
  (Carrier m).normalizerMonoidHom.comp
    ((AngularPresentation.nativeRoot m (.inr 0)).codRestrict _ (fun a => by
      apply first_normalizes m
      have h := a.property
      change (a : Model m) ∈ ElementaryTwoBound.X m (rootIndex (.inr 0)) at h
      change (a : Model m) ∈ ElementaryTwoBound.X m 0
      simpa only [rootIndex,Sum.elim,positive_quartet_indices,Matrix.cons_val_zero] using h))

@[simp] theorem inclusion_root (i : PositiveTables.Root) (hi : i ∈ order)
    (a : AngularPresentation.Parameter m i) :
    inclusion m (root m i hi a) = AngularSuffix.root m i (member_suffix i hi) a := rfl

@[simp] theorem inclusion_firstAction (a : AngularPresentation.Parameter m (.inr 0))
    (v : Carrier m) : inclusion m (firstAction m a v) =
      AngularSuffix.firstAction m a (inclusion m v) := rfl

theorem hom_ext {G : Type*} [Group G] (f g : Carrier m →* G)
    (h : ∀ i (hi : i ∈ order) a, f (root m i hi a) = g (root m i hi a)) : f = g := by
  have hle : Carrier m ≤ (f.eqLocus g).map (Carrier m).subtype := by
    apply join_le
    intro i hi
    rintro _ ⟨a,rfl⟩
    exact ⟨root m i hi a,h i hi a,rfl⟩
  apply MonoidHom.ext
  intro v
  obtain ⟨z,hz,he⟩ := hle v.property
  have hzv : z = v := Subtype.ext he
  subst z
  exact hz

theorem firstAction_intertwining {G : Type*} [Group G]
    (s : AngularPresentation.Parameter m (.inr 0) →* G) (f : Carrier m →* G)
    (h : ∀ (a : CoefficientField m) (i : PositiveTables.Root) (hi : i ∈ order)
      (y : CoefficientField m),
      f (firstAction m (AngularSuffix.mainParameter m (.inr 0) a)⁻¹
        (root m i hi (AngularSuffix.mainParameter m i y))) =
        s (AngularSuffix.mainParameter m (.inr 0) a)⁻¹ *
          f (root m i hi (AngularSuffix.mainParameter m i y)) *
          (s (AngularSuffix.mainParameter m (.inr 0) a)⁻¹)⁻¹) :
    ∀ a v, f (firstAction m a v) = s a * f v * (s a)⁻¹ := by
  have hwhole (a : CoefficientField m) :
      (AngularSuffix.mainParameter m (.inr 0) a)⁻¹ ∈ intertwiningSubgroup (firstAction m) s f := by
    let A := (AngularSuffix.mainParameter m (.inr 0) a)⁻¹
    let F : Carrier m →* G := f.comp (firstAction m A).toMonoidHom
    let J : Carrier m →* G := (MulAut.conj (s A)).toMonoidHom.comp f
    have he : F = J := by
      apply hom_ext m
      intro i hi b
      have hr : F.comp (root m i hi) = J.comp (root m i hi) := by
        apply MonoidHom.eq_of_eqOn_dense (AngularSuffix.root_main_generate m i)
        rintro _ ⟨y,rfl⟩
        exact h a i hi y
      exact congrArg (fun z : AngularPresentation.Parameter m i →* G => z b) hr
    intro v
    exact congrArg (fun z : Carrier m →* G => z v) he
  apply intertwining_of_generators (firstAction m) s f
    (Set.range (AngularSuffix.mainParameter m (.inr 0))) (AngularSuffix.root_main_generate m (.inr 0))
  rintro _ ⟨a,rfl⟩
  have hi := (intertwiningSubgroup (firstAction m) s f).inv_mem (hwhole a)
  change AngularSuffix.mainParameter m (.inr 0) a ∈ intertwiningSubgroup (firstAction m) s f
  simpa only [inv_inv] using hi
end ReeF4.RootPresentationRecognition.AngularSix

