module
public import Theory.SpecificGroups.ReeF4.RootPresentationRecognition.BorelCollection

/-!
# BruhatCollection

An internal double-cell induction collects arbitrary words from the finite equations. Ascents use the signed root table and descents use the literal linear and Suzuki Gauss identities.

Source: GLS3 2.3.5--8 and Table 2.4; Steinberg, section 11, Lemmas 62--64.
The source fields, local equations and exhaustive row selection remain source
producer obligations; binary type tags do not supply these data.
-/

@[expose] public noncomputable section

namespace ReeF4.RootPresentationRecognition.Global.Data
open Subgroup SignedGeometry WeylPresentation
variable {m : ℕ} {G : Type*} [Group G] (d : Global.Data m G) (R : d.Relations)

/-- A double cell with one of the sixteen actual dihedral representatives.
The repeated identity and longest labels are harmless at this existence stage. -/
def Covered (g : G) : Prop := ∃ (a b : G) (s : Bool) (k : ℕ),
  a ∈ d.borel ∧ b ∈ d.borel ∧ k ≤ 8 ∧ g = a * d.n (alternating s k) * b

theorem covered_one : d.Covered 1 :=
  ⟨1,1,false,0,one_mem _,one_mem _,by omega,by simp [alternating_zero]⟩

theorem covered_left (b : G) (hb : b ∈ d.borel) {g : G} (hg : d.Covered g) :
    d.Covered (b*g) := by
  obtain ⟨a,c,s,k,ha,hc,hk,rfl⟩ := hg
  exact ⟨b*a,c,s,k,mul_mem hb ha,hc,hk,by simp only [mul_assoc]⟩

theorem covered_right (b : G) (hb : b ∈ d.borel) {g : G} (hg : d.Covered g) :
    d.Covered (g*b) := by
  obtain ⟨a,c,s,k,ha,hc,hk,rfl⟩ := hg
  exact ⟨a,c*b,s,k,ha,mul_mem hc hb,hk,by simp only [mul_assoc]⟩

include R in
theorem covered_ascent (s : Bool) (k : ℕ) (hk : k < 8)
    (a : AngularPresentation.Parameter m (SignedCharts.simpleIndex s)) :
    d.Covered (d.reflection s * d.simpleRoot s a * d.n (alternating (!s) k)) := by
  refine ⟨1,(d.n (alternating (!s) k))⁻¹ * d.simpleRoot s a * d.n (alternating (!s) k),
    s,k+1,one_mem _,d.ascent R s ⟨k,hk⟩ a,by omega,?_⟩
  simp only [alternating,map_mul,one_mul]
  group

include R in
/-- Gauss gives the descending step, including nonabelian Suzuki parameters. -/
theorem covered_descent (s : Bool) (k : ℕ) (hk : k < 8)
    (a : AngularPresentation.Parameter m (SignedCharts.simpleIndex s)) :
    d.Covered (d.reflection s * d.simpleRoot s a * d.n (alternating s (k+1))) := by
  by_cases ha : a = 1
  · subst a
    refine ⟨1,1,!s,k,one_mem _,one_mem _,by omega,?_⟩
    simp only [map_one,alternating,map_mul,mul_one,one_mul]
    rw [← mul_assoc,d.reflection_sq,one_mul]
  · obtain ⟨b,c,t,he⟩ := d.simple_exchange R s a ha
    refine ⟨d.simpleRoot s b * d.h t,
      (d.n (alternating (!s) k))⁻¹ * d.simpleRoot s c * d.n (alternating (!s) k),s,k+1,
      mul_mem (d.root_mem_borel _ _) (d.torus_mem_borel _),d.ascent R s ⟨k,hk⟩ c,by omega,?_⟩
    simp only [alternating,map_mul]
    change _ * (d.reflection s * _) = _ * (d.reflection s * _) * _
    rw [← mul_assoc,he]
    group

include R in
theorem covered_transition (s start : Bool) (k : ℕ) (hk : k ≤ 8)
    (a : AngularPresentation.Parameter m (SignedCharts.simpleIndex s)) :
    d.Covered (d.reflection s * d.simpleRoot s a * d.n (alternating start k)) := by
  by_cases he : start = s
  · subst start
    cases k with
    | zero => simpa only [alternating_zero] using d.covered_ascent R s 0 (by omega) a
    | succ k => exact d.covered_descent R s k (by omega) a
  · have hs : start = !s := by cases start <;> cases s <;> simp_all
    subst start
    by_cases hlast : k = 8
    · subst k
      rw [alternating_longest (!s), ← alternating_longest s]
      exact d.covered_descent R s 7 (by omega) a
    · exact d.covered_ascent R s k (by omega) a

include R in
theorem covered_reflection (s : Bool) {g : G} (hg : d.Covered g) :
    d.Covered (d.reflection s * g) := by
  obtain ⟨a,b,start,k,ha,hb,hk,rfl⟩ := hg
  obtain ⟨c,hc,t,he⟩ := d.reflection_borel R s a ha
  have h := d.covered_right b hb (d.covered_left c hc (d.covered_transition R s start k hk t))
  have he' : d.reflection s * (a * d.n (alternating start k) * b) =
      c * (d.reflection s * d.simpleRoot s t * d.n (alternating start k)) * b := by
    calc
      _ = (d.reflection s * a) * d.n (alternating start k) * b := by group
      _ = _ := by rw [he]; group
  rw [he']
  exact h

/-- The subgroup generated by the full positive Borel and the two literal lifts. -/
def whole : Subgroup G := closure ((d.borel : Set G) ∪ Set.range d.reflection)

include R in
/-- Global word reduction is proved internally from the finite local equations.
No Bruhat decomposition or model homomorphism is assumed in the target group. -/
theorem bruhat_collection {g : G} (hg : g ∈ d.whole) : d.Covered g := by
  induction hg using Subgroup.closure_induction_left with
  | one => exact d.covered_one
  | mul_left x hx y _ ih =>
    rcases hx with hx | ⟨s,rfl⟩
    · exact d.covered_left x hx ih
    · exact d.covered_reflection R s ih
  | inv_mul_cancel x hx y _ ih =>
    rcases hx with hx | ⟨s,rfl⟩
    · exact d.covered_left x⁻¹ (inv_mem hx) ih
    · rw [d.reflection_inv]
      exact d.covered_reflection R s ih

end ReeF4.RootPresentationRecognition.Global.Data
