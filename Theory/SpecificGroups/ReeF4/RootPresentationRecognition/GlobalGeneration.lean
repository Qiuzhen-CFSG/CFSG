module
public import Theory.SpecificGroups.ReeF4.RootPresentationRecognition.BruhatCollection
public import Theory.SpecificGroups.ReeF4.RootPresentationRecognition.GlobalPresentation

/-!
# GlobalGeneration

The finite signed equations express negative letters by opposition. Thus internal Bruhat collection covers the universal presentation, and its constructed evaluation has exactly the generated image.

Source: GLS3 2.3.5--8 and Table 2.4; Steinberg, section 11, Lemmas 62--64.
The source fields, local equations and exhaustive row selection remain source
producer obligations; binary type tags do not supply these data.
-/

@[expose] public noncomputable section

namespace ReeF4.RootPresentationRecognition.Global.Data
open Subgroup SignedGeometry WeylPresentation
variable {m : ℕ} {G : Type*} [Group G] (d : Global.Data m G) (R : d.Relations)

theorem borel_le_whole : d.borel ≤ d.whole := fun _ h => subset_closure (Or.inl h)

theorem weyl_mem_whole (w : Weyl) : d.n w ∈ d.whole := by
  have hw : w ∈ closure (Set.range simple) := by rw [simple_generate]; trivial
  induction hw using Subgroup.closure_induction with
  | mem w hw => obtain ⟨s,rfl⟩ := hw; exact subset_closure (Or.inr ⟨s,rfl⟩)
  | one => rw [map_one]; exact one_mem _
  | mul w v _ _ hw hv => rw [map_mul]; exact mul_mem hw hv
  | inv w _ hw => rw [map_inv]; exact inv_mem hw

include R in
/-- Opposition expresses every negative root letter using positive letters
and the same literal dihedral subgroup. -/
theorem negative_root (i : PositiveTables.Root) (a : AngularPresentation.Parameter m i) :
    d.x false i a = d.n opposition * d.x true i a * (d.n opposition)⁻¹ := by
  obtain ⟨v,rfl⟩ := (PositiveTables.rootChartEquiv m i).surjective a
  cases i with
  | inl i =>
    have he := equivariant false d.n d.pair R.pair opposition (true,i) v
    rw [action_opposition] at he
    exact he.symm
  | inr i =>
    have he := equivariant true d.n
      (fun r (v : CoefficientField m × CoefficientField m) => d.quartet r v.1 v.2)
      (fun s r v => R.quartet s r v.1 v.2) opposition (true,i) v
    rw [action_opposition] at he
    exact he.symm

include R in
theorem root_mem_whole (p : Bool) (i : PositiveTables.Root) (a : AngularPresentation.Parameter m i) :
    d.x p i a ∈ d.whole := by
  cases p
  · rw [d.negative_root R]
    exact mul_mem (mul_mem (d.weyl_mem_whole _) (d.borel_le_whole (d.root_mem_borel _ _)))
      (inv_mem (d.weyl_mem_whole _))
  · exact d.borel_le_whole (d.root_mem_borel _ _)

end ReeF4.RootPresentationRecognition.Global.Data

namespace ReeF4.RootPresentationRecognition.Global.Presentation
open Subgroup Theory.GroupTheory OrderedRootPresentation
open SignedGeometry WeylPresentation CentralCovers.TwoPrimary
variable {m : ℕ} {G : Type*} [_root_.Group G] (d : Data m G) (R : d.Relations)

/-- Every abstract generator lies in the subgroup collected by Bruhat induction. -/
theorem whole_eq_top (m : ℕ) : (generators m).whole = ⊤ := by
  apply top_unique
  intro g _
  apply PresentedGroup.generated_by _ _ _ g
  intro z
  rcases z with ⟨p,i,a⟩ | t | w
  · exact (generators m).root_mem_whole (relations m) p i a
  · exact (generators m).borel_le_whole ((generators m).torus_mem_borel t)
  · exact (generators m).weyl_mem_whole w

/-- Abstract global normal forms follow solely from the explicit finite relators. -/
theorem bruhat (m : ℕ) (g : Group m) : (generators m).Covered g :=
  (generators m).bruhat_collection (relations m) ((whole_eq_top m).symm ▸ mem_top g)

/-- The evaluation image is exactly the group generated by the original
positive roots, full Cartan and two literal simple lifts. -/
theorem eval_range : (eval d R).range = d.whole := by
  apply le_antisymm
  · rintro _ ⟨g,rfl⟩
    apply PresentedGroup.generated_by _ (d.whole.comap (eval d R)) _ g
    intro z
    rcases z with ⟨p,i,a⟩ | t | w
    · change eval d R (root m p i a) ∈ d.whole
      rw [eval_root]
      exact d.root_mem_whole R p i a
    · change eval d R (torus m t) ∈ d.whole
      rw [eval_torus]
      exact d.borel_le_whole (d.torus_mem_borel t)
    · change eval d R (weyl m w) ∈ d.whole
      rw [eval_weyl]
      exact d.weyl_mem_whole w
  · apply (closure_le _).mpr
    intro g hg
    rcases hg with hg | ⟨s,rfl⟩
    · have hB : d.borel ≤ (eval d R).range := by
        apply sup_le
        · apply join_le
          intro i _
          rintro _ ⟨a,rfl⟩
          exact ⟨root m true i a,eval_root d R true i a⟩
        · rintro _ ⟨t,rfl⟩
          exact ⟨torus m t,eval_torus d R t⟩
      exact hB hg
    · exact ⟨weyl m (simple s),eval_weyl d R (simple s)⟩

/-- The positive evaluation is the map from the previously proved angular presentation. -/
def positiveMap (m : ℕ) : AngularPresentation.Presentation m →* Group m :=
  OrderedRootPresentation.eval (AngularPresentation.table m) (relations m).positive

@[simp] theorem positiveMap_root (m : ℕ) (i : PositiveTables.Root) (a : AngularPresentation.Parameter m i) :
    positiveMap m (OrderedRootPresentation.root (AngularPresentation.table m) i a) = root m true i a :=
  OrderedRootPresentation.eval_root _ _ i a

theorem positiveMap_range (m : ℕ) : (positiveMap m).range = (generators m).unipotent :=
  OrderedRootPresentation.eval_range _ _ AngularPresentation.order_nodup mem_sourceOrder

/-- Composing evaluations agrees on every positive word, by the presentation generators. -/
theorem eval_positiveMap : (eval d R).comp (positiveMap m) =
    OrderedRootPresentation.eval (AngularPresentation.table m) R.positive := by
  apply PresentedGroup.ext
  rintro ⟨i,a⟩
  change eval d R (positiveMap m (OrderedRootPresentation.root (AngularPresentation.table m) i a)) = _
  rw [positiveMap_root,eval_root]
  exact (OrderedRootPresentation.eval_root _ _ i a).symm

/-- Evaluation carries the whole abstract Borel into the actual realization Borel. -/
theorem eval_mem_borel {b : Group m} (hb : b ∈ (generators m).borel) : eval d R b ∈ d.borel := by
  have hle : (generators m).borel ≤ d.borel.comap (eval d R) := by
    apply sup_le
    · apply join_le
      intro i _
      rintro _ ⟨a,rfl⟩
      change eval d R (root m true i a) ∈ d.borel
      rw [eval_root]
      exact d.root_mem_borel _ _
    · rintro _ ⟨t,rfl⟩
      change eval d R (torus m t) ∈ d.borel
      rw [eval_torus]
      exact d.torus_mem_borel t
  exact hle hb

end ReeF4.RootPresentationRecognition.Global.Presentation
