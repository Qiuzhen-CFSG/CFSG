include hr in
theorem rigidity (r s e t v w ε : Bool)
    (hi : ∀ i, evalWord x (images r s e t v w ε i) = f (x i))
    (hsep : Function.Injective (fun p : Coordinates => evalWord x (normalWord p)))
    (hfour : f (f (f (f (evalWord x [1,5])))) = evalWord x [1,5])
    (hsquare : evalWord x (actor r s e t v w ε 0) *
      evalWord x (actor r s e t v w ε 0) = 1) :
    r = true ∧ s = true ∧ e = false ∧ t = true ∧ v = true ∧ w = false ∧ ε = false := by
  obtain ⟨rfl, rfl, rfl, rfl, rfl, he⟩ :=
    fourth_constraints x f hr r s e t v w ε hi hsep hfour
  subst ε
  cases s
  · have hc := execute_sound x rules hr squareCert
      ((actor true false false true true false true 0) ++
        (actor true false false true true false true 0))
    change evalWord x (actor true false false true true false true 0) *
      evalWord x (actor true false false true true false true 0) = 1 at hsquare
    rw [squareCheck,evalWord_append,hsquare] at hc
    have he : ((0,false,2,false,0) : Coordinates) = (0,false,0,false,0) := hsep hc
    have hf : (2 : Fin 4) = 0 := congrArg (fun p : Coordinates => p.2.2.1) he
    contradiction
  · decide

end ReeF4.RootPresentationRecognition.BinaryEndSupportRigidity
