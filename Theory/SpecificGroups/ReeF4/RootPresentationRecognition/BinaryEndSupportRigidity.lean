module
public import Theory.SpecificGroups.ReeF4.RootPresentationRecognition.BinaryEndRigidity

/-!
# Binary end coefficients from their full support

The seven root letters satisfy the interior collection rules. An ambient
endomorphism with the candidate generator images is tested on the product of
the two outer Suzuki letters. Checked word rewrites give a fourth-power output
whose five coordinates are explicit parity expressions. Coordinate uniqueness
leaves two candidates; preservation of the first linear generator's square
eliminates the second. No leading coefficient premise is needed.

Source: Fong--Seitz II (1974), Section 10, (10.27)--(10.41), in the native
triangular chart convention. All finite rewrite certificates use kernel checks.
-/

@[expose] public section
namespace ReeF4.RootPresentationRecognition.BinaryEndSupportRigidity
open Theory.GroupTheory WordRewrite BinaryEndRigidity

def actor (r s e t v w ε : Bool) : Fin 7 → List (Fin 7) :=
  ![[0] ++ (if r then [1,1,1] else [1]) ++ (if s then [2] else []) ++
      (if e then [3] else []) ++ (if t then [3,3] else []) ++
      (if v then [4] else []) ++ (if w then [5,5,5] else [5]) ++ [6],
    [1] ++ (if ε then [3] else [3,3,3]) ++ [4] ++
      (if ε then [5,5,5] else [5]),
    [4,3,3,2], [3], [5,5,4], [5,6], [6]]

def images (r s e t v w ε : Bool) (i : Fin 7) : List (Fin 7) :=
  actor r s e t v w ε i.rev

abbrev Coordinates := Fin 4 × Bool × Fin 4 × Bool × Fin 4

def normalWord (p : Coordinates) : List (Fin 7) :=
  List.replicate p.1.val 1 ++ (if p.2.1 then [2] else []) ++
    List.replicate p.2.2.1.val 3 ++ (if p.2.2.2.1 then [4] else []) ++
      List.replicate p.2.2.2.2.val 5


def output (r s e t v w ε : Bool) : Coordinates :=
  (if Bool.xor (Bool.xor (Bool.xor (Bool.xor r s) e) w) ε then 3 else 1,
    Bool.xor (Bool.xor r e) v,
    if Bool.xor (Bool.xor t v) w then (if e then 3 else 2) else (if e then 1 else 0),
    !(Bool.xor r w),
    if !(Bool.xor (Bool.xor (Bool.xor (Bool.xor r s) v) w) ε) then 3 else 1)

variable {G : Type*} [Group G] (x : Fin 7 → G) (f : G →* G)
  (hr : ∀ i, evalWord x (rules i).lhs = evalWord x (rules i).rhs)

