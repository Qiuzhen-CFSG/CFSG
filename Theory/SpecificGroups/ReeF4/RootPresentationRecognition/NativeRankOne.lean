module
public import Theory.SpecificGroups.ReeF4.RootPresentationRecognition.RankOne
public import Theory.SpecificGroups.ReeF4.SmallCompletion.TorusAction
public import Theory.SpecificGroups.ReeF4.CentralCovers.OddPrimary.Order.TorusCardinality
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.FixedCollection.SeedGeneration.SuzukiLeviGeneration
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairRigidity.BlockGeometry.ParabolicRecognition.LocalIndices.SuzukiCover.Normalization

/-!
# Literal Suzuki and Cartan relations for the Ree presentation

Both signed type V charts live in the actual full `Model m`. The Gauss torus
parameter is obtained from the fixed two-coroot word through the same full
Cartan equivalence used for all torus letters. Consequently the existing
52-dimensional Gauss identity gives the finite relation needed by abstract
rank-one word reduction. The latter is applied to the subgroup generated by
the negative simple block, the entire Cartan, and its literal reflection.

Every statement includes `m = 0`; the displayed square detects the cyclic
order-four behavior of its Suzuki block. These are local presentation
relations and rank-one collection, not the mixed relative-root table or a
presentation of the full Ree group.

Source: GLS3 2.3.4–8, Table 2.4 type V, and 2.4.7–8,
`refs/KGroup/GLS3/chapter2.tex`; Steinberg §11, Lemmas 62–64,
`refs/KGroup/GLS3/Chapter2St1.tex`.
-/
@[expose] public noncomputable section
namespace ReeF4.RootPresentationRecognition
open Subgroup LargeLocalSeeds Parabolics
open LocalBlockInput.PairRigidity LocalBlockInput.PairRigidity.BlockParameters.FieldRecovery
open LocalBlockInput.PairRigidity.LocalIndices
open LocalBlockInput.PairRigidity.LocalIndices.SuzukiGaussData
open LocalBlockInput.PairRigidity.FixedCollection.SeedGeneration
open CentralCovers.OddPrimary.Order
variable {m : ℕ}

/-- The full two-dimensional Cartan parameter space. -/
abbrev TorusParameter (m : ℕ) := (CoefficientField m)ˣ × (CoefficientField m)ˣ

/-- The actual signed relative simple-root intersection in `Model m`. -/
def rootBlock (m : ℕ) (s : Side) (p : Bool) : Subgroup (Model m) :=
  (splitSimpleBlock m s p).comap (toSplitGroup m)

/-- The native type V root word, with both parameters retained. -/
def suzuki (m : ℕ) (p : Bool) (t u : CoefficientField m) : Model m :=
  (canonicalLocalBlockInput m).modelEquiv ((suzukiCoordinates _).element p t u)

@[simp] theorem suzuki_split (p : Bool) (t u : CoefficientField m) :
    toSplitGroup m (suzuki m p t u) = suzukiWord m p t u :=
  (toSplitGroup_apply m _).trans ((canonicalLocalBlockInput m).modelEquiv_coe _)

theorem suzuki_mem (p : Bool) (t u : CoefficientField m) :
    suzuki m p t u ∈ rootBlock m .suzuki p := by
  change toSplitGroup m (suzuki m p t u) ∈ splitSimpleBlock m .suzuki p
  rw [suzuki_split]
  exact (suzukiCoordinates (canonicalLocalBlockInput m)).suzuki_mem p t u

theorem suzuki_injective (p : Bool) : Function.Injective
    (fun a : CoefficientField m × CoefficientField m => suzuki m p a.1 a.2) := by
  intro a b hab
  apply (suzukiCoordinates (canonicalLocalBlockInput m)).suzuki_injective p
  simpa only [suzuki_split] using congrArg (toSplitGroup m) hab

theorem suzuki_cover (p : Bool) (x : Model m) (hx : x ∈ rootBlock m .suzuki p) :
    ∃ t u, suzuki m p t u = x := by
  let d := canonicalLocalBlockInput m
  have hx' : d.modelEquiv.symm x ∈ simpleBlock d .suzuki p := by
    change (d.modelEquiv.symm x).val ∈ splitSimpleBlock m .suzuki p
    rw [modelEquiv_symm_coe]
    simpa only [rootBlock, mem_comap, toSplitGroup_apply] using hx
  obtain ⟨t, u, he⟩ := (suzukiCoordinates d).element_cover p hx'
  exact ⟨t, u, (congrArg d.modelEquiv he).trans (d.modelEquiv.apply_symm_apply x)⟩

@[simp] theorem suzuki_zero (p : Bool) : suzuki m p 0 0 = 1 := by
  apply mul_left_cancel (a := suzuki m p 0 0)
  have he := (suzukiCoordinates (canonicalLocalBlockInput m)).suzuki_mul p 0 0 0 0
  apply toSplitGroup_injective m
  simpa only [map_mul, suzuki_split, map_zero, zero_add, zero_pow (by decide : 2 ≠ 0),
    zero_mul, mul_one] using he

/-- The nonlinear type V multiplication, for both signs and every field. -/
theorem suzuki_mul (p : Bool) (t u v w : CoefficientField m) :
    suzuki m p t u * suzuki m p v w =
      suzuki m p (t+v) (u+w+titsEnd m t*v) := by
  apply toSplitGroup_injective m
  rw [map_mul, suzuki_split, suzuki_split, suzuki_split]
  simpa only [theta_sq] using
    (suzukiCoordinates (canonicalLocalBlockInput m)).suzuki_mul p t u v w

/-- The inverse correction retains the nonlinear second coordinate. -/
theorem suzuki_inv (p : Bool) (t u : CoefficientField m) :
    (suzuki m p t u)⁻¹ = suzuki m p t (u+titsEnd m t*t) := by
  apply inv_eq_of_mul_eq_one_right
  rw [suzuki_mul]
  simp [← add_assoc, CharTwo.add_self_eq_zero]

/-- The same full torus parametrization is used in every root and Gauss relation. -/
def torus (m : ℕ) : TorusParameter m →* Model m :=
  (fixedTorus m).subtype.comp (fixedTorusEquiv m).toMonoidHom

theorem torus_range (m : ℕ) : (torus m).range = fixedTorus m := by
  ext x
  constructor
  · rintro ⟨t, rfl⟩
    exact (fixedTorusEquiv m t).property
  · intro hx
    obtain ⟨t, ht⟩ := (fixedTorusEquiv m).surjective ⟨x, hx⟩
    exact ⟨t, congrArg Subtype.val ht⟩

theorem torus_injective (m : ℕ) : Function.Injective (torus m) :=
  Subtype.val_injective.comp (fixedTorusEquiv m).injective

/-- The full Cartan acts by the signed type V characters, including its central parameter. -/
theorem torus_suzuki (a : TorusParameter m) (p : Bool) (t u : CoefficientField m) :
    torus m a * suzuki m p t u * (torus m a)⁻¹ =
      suzuki m p ((signedScale a.2 p : CoefficientField m)*t)
        ((signedScale (centralScale a.2) p : CoefficientField m)*u) := by
  apply toSplitGroup_injective m
  rw [map_mul, map_mul, map_inv, suzuki_split, suzuki_split]
  apply Subtype.ext
  have ht : (toSplitGroup m (torus m a)).val =
      (BlockParameters.torusMatrix (blockTorus a.1 a.2))⁻¹ :=
    ConverseParabolics.FullLeviRepresentation.torusElement_matrix a.1 a.2
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, ht]
  exact blockTorus_suzukiWord a.1 a.2 p t u

/-- Literal reflection lifts, not merely their quotient classes. -/
def reflection (m : ℕ) (s : Side) : Model m := (SmallCompletion.reflection m s).val

theorem reflection_sq (m : ℕ) (s : Side) : reflection m s * reflection m s = 1 := by
  simpa only [reflection, pow_two, Subgroup.coe_mul, Subgroup.coe_one] using
    congrArg Subtype.val (SmallCompletion.reflection_sq m s)

@[simp] theorem reflection_split (m : ℕ) (s : Side) :
    toSplitGroup m (reflection m s) = Binary.FixedGeometry.simpleWord m (Binary.FixedGeometry.sideWord s) :=
  Binary.FixedGeometry.toSplitGroup_weylLift m s

/-- The native full-torus reflection table, expressed in the two field units. -/
def torusReflection (m : ℕ) (s : Side) : MulAut (TorusParameter m) :=
  (fixedTorusEquiv m).trans ((SmallCompletion.torusReflection m s).trans (fixedTorusEquiv m).symm)

theorem reflection_torus (s : Side) (t : TorusParameter m) :
    reflection m s * torus m t * (reflection m s)⁻¹ = torus m (torusReflection m s t) := by
  change _ = ((fixedTorusEquiv m) ((fixedTorusEquiv m).symm
    (SmallCompletion.torusReflection m s (fixedTorusEquiv m t)))).val
  rw [MulEquiv.apply_symm_apply]
  rfl

/-- Fixedness of the two-coroot Gauss word in the actual full carrier. -/
def suzukiTorus (a : (CoefficientField m)ˣ) : fixedTorus m :=
  ⟨(canonicalLocalBlockInput m).modelEquiv
    ⟨SuzukiGaussData.torusFactor a, SuzukiNormalizer.torusFactor_fixed _ a⟩,
    by
      change toSplitGroup m ((canonicalLocalBlockInput m).modelEquiv _) ∈ splitTorus m
      rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe]
      exact torusFactor_mem a⟩

/-- Canonical Gauss parameter in the same full two-dimensional torus. -/
def suzukiTau (a : (CoefficientField m)ˣ) : TorusParameter m :=
  (fixedTorusEquiv m).symm (suzukiTorus a)

@[simp] theorem torus_suzukiTau (a : (CoefficientField m)ˣ) :
    toSplitGroup m (torus m (suzukiTau a)) = SuzukiGaussData.torusFactor a := by
  change toSplitGroup m ((fixedTorusEquiv m) ((fixedTorusEquiv m).symm (suzukiTorus a))).val = _
  rw [MulEquiv.apply_symm_apply]
  exact (toSplitGroup_apply m _).trans ((canonicalLocalBlockInput m).modelEquiv_coe _)

/-- The literal Gauss relation, with the prescribed norm and reciprocal parameters. -/
theorem suzuki_gauss (t u : CoefficientField m) (hn : norm t u ≠ 0) :
    reflection m .suzuki * suzuki m false t u =
      suzuki m false (negativeFirst t u) (negativeSecond t u) *
        torus m (suzukiTau (Units.mk0 (norm t u) hn)) *
          suzuki m true (positiveFirst t u) (positiveSecond t u) := by
  apply toSplitGroup_injective m
  simpa only [map_mul, reflection_split, Binary.FixedGeometry.sideWord, suzuki_split,
    torus_suzukiTau] using Ambient.splitIdentity m t u hn

/-- Conjugation uses the identical two coordinates at the opposite sign. -/
theorem reflection_suzuki (t u : CoefficientField m) :
    reflection m .suzuki * suzuki m false t u * reflection m .suzuki =
      suzuki m true t u := by
  let d := canonicalLocalBlockInput m
  have hw : d.modelEquiv (suzukiPanelWeyl d) = reflection m .suzuki := by
    apply toSplitGroup_injective m
    rw [toSplitGroup_apply, LocalBlockInput.modelEquiv_coe, reflection_split]
    rfl
  have he := congrArg d.modelEquiv
    (suzukiPanelWeyl_conj_negative d (suzukiCoordinates d) t u)
  simpa only [map_mul, map_inv, hw, suzukiPanelWeyl_inv, suzuki] using he

/-- The finite local relation in the form used by abstract word reduction. -/
theorem suzuki_gauss_conjugate (t u : CoefficientField m) (hn : norm t u ≠ 0) :
    reflection m .suzuki * suzuki m false t u * reflection m .suzuki =
      suzuki m false (negativeFirst t u) (negativeSecond t u) *
        torus m (suzukiTau (Units.mk0 (norm t u) hn)) * reflection m .suzuki *
          suzuki m false (positiveFirst t u) (positiveSecond t u) := by
  rw [suzuki_gauss t u hn, ← reflection_suzuki]
  simp only [mul_assoc, reflection_sq, mul_one]

/-- The native torus used in collection is the entire fixed Cartan. -/
theorem torus_normalizes_suzuki_negative (m : ℕ) :
    fixedTorus m ≤ normalizer (rootBlock m .suzuki false) := by
  rw [le_normalizer_iff]
  intro t ht u hu
  let d := canonicalLocalBlockInput m
  have ht' : d.modelEquiv.symm t ∈ suzukiPanelTorus d := by
    change (d.modelEquiv.symm t).val ∈ splitTorus m
    rw [modelEquiv_symm_coe]
    simpa only [fixedTorus, mem_comap, toSplitGroup_apply] using ht
  have hu' : d.modelEquiv.symm u ∈ simpleBlock d .suzuki false := by
    change (d.modelEquiv.symm u).val ∈ splitSimpleBlock m .suzuki false
    rw [modelEquiv_symm_coe]
    simpa only [rootBlock, mem_comap, toSplitGroup_apply] using hu
  have he := (mem_normalizer_iff.mp
    (suzukiPanelTorus_le_negative_normalizer d (splitTorus_eq_diagonalTorus m) ht')
      (d.modelEquiv.symm u)).mp hu'
  change toSplitGroup m (t*u*t⁻¹) ∈ splitSimpleBlock m .suzuki false
  simpa only [map_mul, map_inv, toSplitGroup_apply, simpleBlock, mem_subgroupOf,
    Subgroup.coe_mul, Subgroup.coe_inv, modelEquiv_symm_coe] using he

/-- Native rank-one collection from the verified finite equations. The torus
here includes the complementary Cartan factor, not only the Suzuki Levi torus. -/
theorem suzuki_rankOne_normalForm (g : Model m)
    (hg : g ∈ rootBlock m .suzuki false ⊔ fixedTorus m ⊔ zpowers (reflection m .suzuki)) :
    RankOne.NormalForm (rootBlock m .suzuki false) (fixedTorus m)
      (reflection m .suzuki) g := by
  apply RankOne.normalForm_of_mem _ _ _ (torus_normalizes_suzuki_negative m)
    (SmallCompletion.reflection_mem_normalizer_fixedTorus m .suzuki)
    (reflection_sq m .suzuki) ?_ hg
  intro x hx hx1
  obtain ⟨t, u, rfl⟩ := suzuki_cover false x hx
  have htu : t ≠ 0 ∨ u ≠ 0 := by
    by_contra! h
    exact hx1 (by rw [h.1, h.2, suzuki_zero])
  have hn := norm_ne_zero t u htu
  refine ⟨suzuki m false (negativeFirst t u) (negativeSecond t u), suzuki_mem _ _ _,
    torus m (suzukiTau (Units.mk0 (norm t u) hn)), ?_,
    suzuki m false (positiveFirst t u) (positiveSecond t u), suzuki_mem _ _ _,
    suzuki_gauss_conjugate t u hn⟩
  rw [← torus_range]
  exact ⟨_, rfl⟩

/-- The binary type V square is the nonzero central parameter. -/
theorem binary_suzuki_square (p : Bool) :
    suzuki 0 p 1 0 * suzuki 0 p 1 0 = suzuki 0 p 0 1 := by
  rw [suzuki_mul]
  simp only [CharTwo.add_self_eq_zero, map_one, zero_add, one_mul]

/-- In particular the binary Suzuki chart cannot be replaced by an additive pair. -/
theorem binary_suzuki_square_ne_one (p : Bool) :
    suzuki 0 p 1 0 * suzuki 0 p 1 0 ≠ 1 := by
  rw [binary_suzuki_square, ← suzuki_zero (m := 0) p]
  intro he
  have hp := @suzuki_injective 0 p (0, 1) (0, 0) he
  exact one_ne_zero (congrArg Prod.snd hp)

/-- Every type V root element has fourth power one, including the binary block. -/
theorem suzuki_fourth (p : Bool) (t u : CoefficientField m) :
    suzuki m p t u ^ 4 = 1 := by
  have hs : suzuki m p t u ^ 2 = suzuki m p 0 (titsEnd m t*t) := by
    rw [pow_two, suzuki_mul]
    simp only [CharTwo.add_self_eq_zero, zero_add]
  change suzuki m p t u ^ (2*2) = 1
  rw [pow_mul, hs, pow_two, suzuki_mul]
  simp only [map_zero, zero_mul, CharTwo.add_self_eq_zero, suzuki_zero]

end ReeF4.RootPresentationRecognition
