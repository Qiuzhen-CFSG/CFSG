module

public import Theory.GroupTheory.SylowOddIndexBound
public import Mathlib.GroupTheory.IndexNormal
public import Mathlib.GroupTheory.GroupAction.SubMulAction
public import Mathlib.GroupTheory.Perm.Fin

/-!
# A fixed point for a four-point action with a transposition Sylow image

If the image of a Sylow two-subgroup is generated by the transposition
`(2 3)`, the whole image fixes 0 or 1. The image has order two or six by
Lagrange's theorem and its Sylow index. In the order-six case its subgroup
of order three is normal. A nontrivial three-cycle has a unique fixed
point, which must therefore be fixed by the whole image.

This elementary permutation argument uses only Sylow's and Cauchy's
classical theorems. The three-cycle fixed-point check is kernel verified
on the 24 permutations of four points.
-/

namespace SymmetricFour

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
private theorem unique_fixed_cube : ∀ g : Equiv.Perm (Fin 4),
    g ^ 3 = 1 → g ≠ 1 → ∃! i, g i = i := by
  simp only [ExistsUnique]
  decide

/-- Every subgroup of order six in the symmetric group on four points fixes a point. -/
public theorem exists_fixed_of_card_eq_six (H : Subgroup (Equiv.Perm (Fin 4)))
    (hcard : Nat.card H = 6) : ∃ i, ∀ g : H, (g : Equiv.Perm (Fin 4)) i = i := by
  classical
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' (G := H) 3 (by rw [hcard]; decide)
  let C := Subgroup.zpowers g
  have hCcard : Nat.card C = 3 := by rw [Nat.card_zpowers, hg]
  have hCindex : C.index = 2 := by
    have hm := C.card_mul_index
    rw [hCcard, hcard] at hm
    omega
  let : C.Normal := Subgroup.normal_of_index_eq_two hCindex
  have hg3 : (g : Equiv.Perm (Fin 4)) ^ 3 = 1 := by
    have hpow := pow_orderOf_eq_one g
    rw [hg] at hpow
    exact congrArg Subtype.val hpow
  have hgne : (g : Equiv.Perm (Fin 4)) ≠ 1 := by
    intro h
    have he : g = 1 := Subtype.ext h
    simp [he] at hg
  obtain ⟨i, hi, huniq⟩ := unique_fixed_cube g hg3 hgne
  have hCfix : C ≤ MulAction.stabilizer H i := Subgroup.zpowers_le.mpr hi
  have hifix : i ∈ MulAction.fixedPoints C (Fin 4) := fun c => hCfix c.property
  refine ⟨i, fun a => huniq _ ?_⟩
  have hafix := smul_mem_fixedPoints_of_normal a hifix
  exact hafix ⟨g, Subgroup.mem_zpowers g⟩

/-- A subgroup with Sylow two-subgroup generated by `(2 3)` fixes 0 or 1. -/
public theorem fixes_zero_or_one_of_sylow_swap (H : Subgroup (Equiv.Perm (Fin 4))) (P : Sylow 2 H)
    (hP : (P : Subgroup H).map H.subtype = Subgroup.zpowers (Equiv.swap (2 : Fin 4) 3)) :
    (∀ g ∈ H, g 0 = 0) ∨ (∀ g ∈ H, g 1 = 1) := by
  have hswap : orderOf (Equiv.swap (2 : Fin 4) 3) = 2 :=
    orderOf_eq_prime (by decide) (by decide)
  have hPcard : Nat.card P = 2 := by
    rw [← Subgroup.card_map_of_injective H.subtype_injective, hP, Nat.card_zpowers, hswap]
  have hcard : Nat.card (Equiv.Perm (Fin 4)) = 24 := by
    norm_num [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  have hindex : P.index ∣ 3 :=
    P.index_dvd_of_card_dvd_mul_prime_pow (n := 3) (by
      simpa only [hcard, show 3 * 2 ^ 3 = 24 from rfl] using H.card_subgroup_dvd_card)
  have hTle : Subgroup.zpowers (Equiv.swap (2 : Fin 4) 3) ≤ H := by
    rw [← hP]
    exact Subgroup.map_subtype_le _
  rcases (Nat.dvd_prime Nat.prime_three).mp hindex with hindex | hindex
  · have htop := Subgroup.index_eq_one.mp hindex
    have he : H = Subgroup.zpowers (Equiv.swap (2 : Fin 4) 3) := by
      simpa [htop, ← MonoidHom.range_eq_map] using hP
    left
    have hh : H ≤ MulAction.stabilizer (Equiv.Perm (Fin 4)) (0 : Fin 4) := by
      rw [he]
      exact Subgroup.zpowers_le.mpr (by decide)
    exact fun g hg => hh hg
  · have hc : Nat.card H = 6 := by
      have hm := (P : Subgroup H).card_mul_index
      rw [hPcard, hindex] at hm
      exact hm.symm
    obtain ⟨i, hi⟩ := exists_fixed_of_card_eq_six H hc
    have hti := hi ⟨Equiv.swap 2 3, hTle (Subgroup.mem_zpowers _)⟩
    have his : i = 0 ∨ i = 1 := (by decide : ∀ i : Fin 4,
      Equiv.swap (2 : Fin 4) 3 i = i → i = 0 ∨ i = 1) i hti
    rcases his with rfl | rfl
    · exact Or.inl (fun g hg => hi ⟨g, hg⟩)
    · exact Or.inr (fun g hg => hi ⟨g, hg⟩)

/-- A four-point action whose Sylow image is generated by `(2 3)` fixes 0 or 1. -/
public theorem hom_fixes_zero_or_one_of_sylow_swap {G : Type*} [Group G] [Finite G]
    (f : G →* Equiv.Perm (Fin 4)) (P : Sylow 2 G)
    (hP : (P : Subgroup G).map f = Subgroup.zpowers (Equiv.swap (2 : Fin 4) 3)) :
    (∀ g, f g 0 = 0) ∨ (∀ g, f g 1 = 1) := by
  let R := P.mapSurjective f.rangeRestrict_surjective
  have hR : (R : Subgroup f.range).map f.range.subtype =
      Subgroup.zpowers (Equiv.swap (2 : Fin 4) 3) := by
    change ((P.mapSurjective f.rangeRestrict_surjective : Sylow 2 f.range) :
      Subgroup f.range).map f.range.subtype = _
    rw [Sylow.coe_mapSurjective, Subgroup.map_map]
    exact hP
  rcases fixes_zero_or_one_of_sylow_swap f.range R hR with h | h
  · exact Or.inl (fun g => h (f g) ⟨g, rfl⟩)
  · exact Or.inr (fun g => h (f g) ⟨g, rfl⟩)
end SymmetricFour
