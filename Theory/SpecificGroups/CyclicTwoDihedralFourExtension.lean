module
public import Theory.SpecificGroups.CyclicTwoDihedralFourPlanes
public import Mathlib.GroupTheory.IndexNormal
public import Theory.SpecificGroups.AffineEight.Basic
public import Theory.GroupTheory.IndexTwoExtensionEquivalence

/-!
# Identifying an actual C₂ × D₈ index-two extension

An actual embedded C₂ × D₈ subgroup of index two is assumed to be both
its first-factor involution centralizer and the normalizer of its canonical
elementary eight subgroup. The ambient group then contains an element of
order eight whose centralizer is exactly its cyclic subgroup. The final
theorem identifies the extension with the explicit affine group of the
cyclic group of order eight, retaining all elementary-eight coordinates.

Conjugation outside the embedded subgroup moves the first-factor involution
by the unique nonidentity square and moves the reflection out of its
centralizer. Finite calculations on the sixteen-element model, together
with the identity that the square of conjugation is conjugation by the
square, force the chosen element or its reflection translate to have order
eight. Its square has order four in the model. The centralizer of that
square is generated by it and the first-factor involution; the latter does
not commute with any element outside the embedded subgroup. Index two then
gives the full cyclic centralizer.

For the full identification, finite arithmetic realizes every compatible
conjugation/square tuple in the actual affine model. One of two source
coordinate choices is needed: the identity or multiplication of the
rotation by the central C₂ generator. Both fix the canonical elementary
eight pointwise. The index-two extension comparison then gives an actual
ambient equivalence matching the adjusted subgroup equivalence, with all
action and square equations proved rather than assumed.

This elementary extension calculation isolates a local input for the
order-32 branch of Kurzweil–Stellmacher, The Theory of Finite Groups,
Chapter 12, printed p.367, and Fong's self-centralizing order-eight Sylow
hypothesis (J. Algebra 6 (1967), pp.65–76). No global recognition theorem,
extra Z condition, or external classification of groups of order32 is used.
The abstract extension-comparison theorem is the proved ABG II.3
Proposition3 construction in `Theory.GroupTheory.IndexTwoExtensionEquivalence`.
-/

set_option synthInstance.maxSize 1024
namespace CyclicTwoDihedralFour
private abbrev Model := Multiplicative (ZMod 2) × DihedralGroup 4
private def a : Model := (1, .r 1)
private def b : Model := (1, .sr 0)
private def c : Model := (Multiplicative.ofAdd 1, 1)
private def z : Model := a ^ 2
private def word (u v w d : Model) : Model :=
  w ^ d.1.toAdd.val * match d.2 with
  | .r j => u ^ j.val
  | .sr j => v * u ^ j.val

private theorem word_eq : ∀ d : Model, word a b c d = d := by decide
private theorem pow_four : ∀ d : Model, d ^ 4 = 1 := by decide
private theorem square_unique : ∀ d : Model, d ^ 2 ≠ 1 → d ^ 2 = z := by decide
private theorem center_points : ∀ d : Model, d ∈ Subgroup.center Model →
    d ≠ 1 → d ≠ z → d ≠ c → d = c * z := by decide
private theorem centralizer_order_four : ∀ k d : Model,
    k ^ 2 ≠ 1 → d * k = k * d → ∃ n : Fin 4, d = k ^ n.val ∨ d = k ^ n.val * c := by
  decide

set_option maxRecDepth 200000 in
set_option maxHeartbeats 4000000 in
private theorem square_choice : ∀ u v k : Model,
    u ^ 2 = z → v ^ 2 = 1 → v * b ≠ b * v →
    word u v (c * z) u = k * a * k⁻¹ →
    word u v (c * z) v = k * b * k⁻¹ →
    word u v (c * z) k = k →
    k ^ 2 ≠ 1 ∨ (v * k * b) ^ 2 ≠ 1 := by
  decide

set_option maxRecDepth 200000 in
set_option maxHeartbeats 4000000 in
private theorem eight_stable : ∀ u v d : Model,
    u ^ 2 = z → v * b = b * v → d * b = b * d →
      word u v (c * z) d * b = b * word u v (c * z) d := by
  decide

private theorem word_map (e : Model ≃* Model) (d : Model) :
    e d = word (e a) (e b) (e c) d := by
  conv_lhs => rw [← word_eq d]
  rcases d with ⟨d, j | j⟩ <;> simp only [word, map_mul, map_pow]

private theorem aut_z (e : Model ≃* Model) : e z = z := by
  have h : (e a) ^ 2 ≠ 1 := by
    rw [← map_pow]
    intro he
    have hne : a ^ 2 ≠ 1 := by decide
    exact hne (e.injective (he.trans (e.map_one).symm))
  simpa only [z, map_pow] using square_unique (e a) h

private theorem aut_c (e : Model ≃* Model) (hne : e c ≠ c) : e c = c * z := by
  apply center_points (e c)
  · exact (Subgroup.centerCongr e ⟨c, by decide⟩).property
  · exact fun h => (by decide : c ≠ 1) (e.injective (h.trans e.map_one.symm))
  · intro h
    apply (by decide : c ≠ z)
    apply e.injective
    exact h.trans (aut_z e).symm
  · exact hne


private theorem conjugation_on_range
    {S : Type*} [Group S] (i : Model →* S) (hi : Function.Injective i)
    (hindex : i.range.index = 2) (r : S) :
    ∃ e : Model ≃* Model, ∀ d, i (e d) = r * i d * r⁻¹ := by
  let T := i.range
  let _ : T.Normal := T.normal_of_index_eq_two hindex
  let f := MonoidHom.ofInjective hi
  let u : T ≃* T := T.normalizerMonoidHom ⟨r, by rw [T.normalizer_eq_top]; trivial⟩
  refine ⟨(f.trans u).trans f.symm, ?_⟩
  intro d
  change i (f.symm (u (f d))) = _
  rw [MonoidHom.apply_ofInjective_symm]
  rfl

private theorem image_b_outside
    {S : Type*} [Group S] [Finite S] (i : Model →* S) (_hi : Function.Injective i)
    (_hindex : i.range.index = 2) (r : S) (hr : r ∉ i.range)
    (e : Model ≃* Model) (he : ∀ d, i (e d) = r * i d * r⁻¹)
    (hec : e c = c * z)
    (hN : Subgroup.normalizer
      ((Subgroup.centralizer ({b} : Set Model)).map i : Set S) = i.range) :
    e b * b ≠ b * e b := by
  intro hcomm
  let A := (Subgroup.centralizer ({b} : Set Model)).map i
  have hstable : A.map (MulAut.conj r).toMonoidHom ≤ A := by
    rintro x ⟨y, ⟨d, hd, rfl⟩, rfl⟩
    refine ⟨e d, ?_, he d⟩
    change d ∈ Subgroup.centralizer ({b} : Set Model) at hd
    change e d ∈ Subgroup.centralizer ({b} : Set Model)
    rw [Subgroup.mem_centralizer_singleton_iff] at hd ⊢
    rw [word_map, hec]
    exact eight_stable (e a) (e b) d (by simpa only [z, map_pow] using aut_z e) hcomm hd
  have hsame : A.map (MulAut.conj r).toMonoidHom = A :=
    Subgroup.eq_of_le_of_card_ge hstable ((Subgroup.card_map_of_injective
      (K := A) (f := (MulAut.conj r).toMonoidHom) (MulAut.conj r).injective).ge)
  have hrN : r ∈ Subgroup.normalizer (A : Set S) := by
    rw [Subgroup.mem_normalizer_iff]
    intro x
    constructor
    · intro hx
      have : r * x * r⁻¹ ∈ A.map (MulAut.conj r).toMonoidHom := ⟨x, hx, rfl⟩
      rwa [hsame] at this
    · intro hx
      rw [← hsame] at hx
      obtain ⟨y, hy, hyx⟩ := hx
      have hyx' : y = x := (MulAut.conj r).injective hyx
      exact hyx' ▸ hy
  exact hr (hN ▸ hrN)


private theorem order_eight_of_square
    {S : Type*} [Group S] (i : Model →* S) (hi : Function.Injective i)
    (x : S) (k : Model) (hk : i k = x ^ 2) (hkk : k ^ 2 ≠ 1) :
    orderOf x = 8 := by
  have hx4 : x ^ 4 ≠ 1 := by
    intro h
    apply hkk
    apply hi
    rw [map_pow, hk, ← pow_mul]
    simpa only [map_one] using h
  have hx8 : x ^ 8 = 1 := by
    have h := congrArg i (pow_four k)
    rw [map_pow, hk, ← pow_mul, map_one] at h
    exact h
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact orderOf_eq_prime_pow (p := 2) (n := 2) hx4 hx8

private theorem exists_order_eight
    {S : Type*} [Group S] [Finite S] (i : Model →* S) (hi : Function.Injective i)
    (hindex : i.range.index = 2)
    (hC : Subgroup.centralizer ({i c} : Set S) = i.range)
    (hN : Subgroup.normalizer
      ((Subgroup.centralizer ({b} : Set Model)).map i : Set S) = i.range) :
    ∃ x : S, orderOf x = 8 := by
  classical
  have hproper : i.range ≠ ⊤ := by intro h; simp [h] at hindex
  obtain ⟨r, hr⟩ := SetLike.exists_not_mem_of_ne_top i.range hproper
  obtain ⟨e, he⟩ := conjugation_on_range i hi hindex r
  have hrc : r * i c ≠ i c * r := by
    intro h
    apply hr
    rw [← hC, Subgroup.mem_centralizer_singleton_iff]
    exact h
  have hec : e c = c * z := by
    apply aut_c e
    intro h
    apply hrc
    have hh := he c
    rw [h] at hh
    exact (eq_mul_inv_iff_mul_eq.mp hh).symm
  have heb := image_b_outside i hi hindex r hr e he hec hN
  obtain ⟨k, hk⟩ := i.range.sq_mem_of_index_two hindex r
  have he2 (d : Model) : e (e d) = k * d * k⁻¹ := by
    apply hi
    rw [he, he, map_mul, map_mul, map_inv, hk]
    simp only [pow_two]
    group
  have hek : e k = k := by
    apply hi
    rw [he, hk]
    group
  have hsq := square_choice (e a) (e b) k
    (by simpa only [z, map_pow] using aut_z e)
    (by rw [← map_pow]; exact congrArg e (by decide : b ^ 2 = 1) |>.trans e.map_one)
    heb
    (by rw [← hec, ← word_map]; exact he2 a)
    (by rw [← hec, ← word_map]; exact he2 b)
    (by rw [← hec, ← word_map]; exact hek)
  rcases hsq with h | h
  · exact ⟨r, order_eight_of_square i hi r k hk h⟩
  · refine ⟨r * i b, order_eight_of_square i hi _ (e b * k * b) ?_ h⟩
    rw [map_mul, map_mul, he, hk]
    simp only [pow_two]
    group


private theorem order_eight_centralizer
    {S : Type*} [Group S] (i : Model →* S) (hi : Function.Injective i)
    (hindex : i.range.index = 2)
    (hC : Subgroup.centralizer ({i c} : Set S) = i.range)
    (x : S) (hx : orderOf x = 8) :
    Subgroup.centralizer ({x} : Set S) = Subgroup.zpowers x := by
  have hx4 : x ^ 4 ≠ 1 := by
    intro h
    have hh := orderOf_dvd_of_pow_eq_one h
    rw [hx] at hh
    norm_num at hh
  have hxout : x ∉ i.range := by
    rintro ⟨d, hd⟩
    apply hx4
    rw [← hd, ← map_pow, pow_four, map_one]
  have hxc : x * i c ≠ i c * x := by
    intro h
    exact hxout (hC ▸ Subgroup.mem_centralizer_singleton_iff.mpr h)
  obtain ⟨k, hk⟩ := i.range.sq_mem_of_index_two hindex x
  have hkk : k ^ 2 ≠ 1 := by
    intro h
    apply hx4
    have hh := congrArg i h
    rw [map_pow, hk, ← pow_mul, map_one] at hh
    exact hh
  have hinner (d : Model) (hd : i d * x = x * i d) : i d ∈ Subgroup.zpowers x := by
    have hdk : d * k = k * d := by
      apply hi
      rw [map_mul, map_mul, hk]
      calc
        i d * x ^ 2 = (i d * x) * x := by simp only [pow_two, mul_assoc]
        _ = (x * i d) * x := by rw [hd]
        _ = x ^ 2 * i d := by rw [mul_assoc, hd]; simp only [pow_two, mul_assoc]
    obtain ⟨n, hn | hn⟩ := centralizer_order_four k d hkk hdk
    · rw [hn, map_pow, hk]
      exact Subgroup.pow_mem _ (Subgroup.pow_mem _ (Subgroup.mem_zpowers x) 2) n.val
    · have hcomm : x * i c = i c * x := by
        rw [hn, map_mul, map_pow, hk] at hd
        have hxp : (x ^ 2) ^ n.val * x = x * (x ^ 2) ^ n.val := by group
        apply mul_left_cancel (a := (x ^ 2) ^ n.val)
        calc
          (x ^ 2) ^ n.val * (x * i c) = ((x ^ 2) ^ n.val * x) * i c := (mul_assoc _ _ _).symm
          _ = (x * (x ^ 2) ^ n.val) * i c := by rw [hxp]
          _ = x * ((x ^ 2) ^ n.val * i c) := mul_assoc _ _ _
          _ = ((x ^ 2) ^ n.val * i c) * x := hd.symm
          _ = (x ^ 2) ^ n.val * (i c * x) := mul_assoc _ _ _
      exact (hxc hcomm).elim
  apply le_antisymm
  · intro y hy
    have hyx := Subgroup.mem_centralizer_singleton_iff.mp hy
    by_cases hyT : y ∈ i.range
    · obtain ⟨d, rfl⟩ := hyT
      exact hinner d hyx
    · have hyxT : y * x⁻¹ ∈ i.range := by
        rw [i.range.mul_mem_iff_of_index_two hindex, Subgroup.inv_mem_iff]
        simp only [hyT, hxout]
      obtain ⟨d, hd⟩ := hyxT
      have hcomm : i d * x = x * i d := by
        rw [hd]
        calc
          y * x⁻¹ * x = y := by group
          _ = x * y * x⁻¹ := eq_mul_inv_iff_mul_eq.mpr hyx
          _ = x * (y * x⁻¹) := by group
      have hmem := hinner d hcomm
      have hout := (Subgroup.zpowers x).mul_mem hmem (Subgroup.mem_zpowers x)
      simpa only [hd, inv_mul_cancel_right] using hout
  · exact Subgroup.zpowers_le.mpr (Subgroup.mem_centralizer_singleton_iff.mpr rfl)

public theorem exists_selfcentralizing_order_eight
    {S : Type*} [Group S] [Finite S]
    (i : Multiplicative (ZMod 2) × DihedralGroup 4 →* S)
    (hi : Function.Injective i) (hindex : i.range.index = 2)
    (hC : Subgroup.centralizer
      ({i (Multiplicative.ofAdd 1, 1)} : Set S) = i.range)
    (hN : Subgroup.normalizer
      ((Subgroup.centralizer ({(1, DihedralGroup.sr 0)} :
        Set (Multiplicative (ZMod 2) × DihedralGroup 4))).map i : Set S) = i.range) :
    ∃ x : S, orderOf x = 8 ∧ Subgroup.centralizer ({x} : Set S) = Subgroup.zpowers x := by
  obtain ⟨x, hx⟩ := exists_order_eight i hi hindex hC hN
  exact ⟨x, hx, order_eight_centralizer i hi hindex hC x hx⟩


private def rotationTwist : Model ≃* Model where
  toFun d := (d.1 * Multiplicative.ofAdd (match d.2 with
    | .r j => (j.val : ZMod 2)
    | .sr j => (j.val : ZMod 2)), d.2)
  invFun d := (d.1 * Multiplicative.ofAdd (match d.2 with
    | .r j => (j.val : ZMod 2)
    | .sr j => (j.val : ZMod 2)), d.2)
  left_inv := by decide
  right_inv := by decide
  map_mul' := by decide

private def embeddingChoice (choice : Bool) : Model ≃* Model :=
  if choice then rotationTwist else MulEquiv.refl _

private theorem embeddingChoice_fixes_eight : ∀ choice d,
    d * b = b * d → embeddingChoice choice d = d := by decide

set_option maxRecDepth 200000 in
set_option maxHeartbeats 8000000 in
private theorem affine_realization : ∀ u v k : Model,
    u ^ 2 = z → v ^ 2 = 1 → v * b ≠ b * v →
    word u v (c * z) u = k * a * k⁻¹ →
    word u v (c * z) v = k * b * k⁻¹ →
    word u v (c * z) k = k →
    ∃ choice : Bool, ∃ x : AffineEight.Model, x.left.toAdd.val % 2 = 1 ∧
      x ^ 2 = AffineEight.evenEmbedding (embeddingChoice choice k) ∧
      ∀ d : Model,
        x * AffineEight.evenEmbedding (embeddingChoice choice d) * x⁻¹ =
          AffineEight.evenEmbedding (embeddingChoice choice (word u v (c * z) d)) := by
  decide


/-- Identify the actual extension with the affine cyclic-eight group, retaining
its elementary-eight coordinates and explicitly recording the possible twist. -/
public theorem exists_mulEquiv_affineEight
    {S : Type*} [Group S] [Finite S]
    (i : Multiplicative (ZMod 2) × DihedralGroup 4 →* S)
    (hi : Function.Injective i) (hindex : i.range.index = 2)
    (hC : Subgroup.centralizer
      ({i (Multiplicative.ofAdd 1, 1)} : Set S) = i.range)
    (hN : Subgroup.normalizer
      ((Subgroup.centralizer ({(1, DihedralGroup.sr 0)} :
        Set (Multiplicative (ZMod 2) × DihedralGroup 4))).map i : Set S) = i.range) :
    ∃ e : S ≃* AffineEight.Model,
      ∃ j : (Multiplicative (ZMod 2) × DihedralGroup 4) ≃*
        (Multiplicative (ZMod 2) × DihedralGroup 4),
        (∀ d ∈ Subgroup.centralizer ({(1, DihedralGroup.sr 0)} :
          Set (Multiplicative (ZMod 2) × DihedralGroup 4)), j d = d) ∧
        (∀ d, e (i d) = AffineEight.evenEmbedding (j d)) := by
  classical
  have hproper : i.range ≠ ⊤ := by intro h; simp [h] at hindex
  obtain ⟨r, hr⟩ := SetLike.exists_not_mem_of_ne_top i.range hproper
  obtain ⟨α, hα⟩ := conjugation_on_range i hi hindex r
  have hrc : r * i c ≠ i c * r := by
    intro h
    exact hr (hC ▸ Subgroup.mem_centralizer_singleton_iff.mpr h)
  have hαc : α c = c * z := by
    apply aut_c α
    intro h
    have hh := hα c
    rw [h] at hh
    exact hrc (eq_mul_inv_iff_mul_eq.mp hh).symm
  have hαb := image_b_outside i hi hindex r hr α hα hαc hN
  obtain ⟨k, hk⟩ := i.range.sq_mem_of_index_two hindex r
  have hα2 (d : Model) : α (α d) = k * d * k⁻¹ := by
    apply hi
    rw [hα, hα, map_mul, map_mul, map_inv, hk]
    simp only [pow_two]
    group
  have hαk : α k = k := by
    apply hi
    rw [hα, hk]
    group
  obtain ⟨choice, x, hxodd, hxsq, hxact⟩ := affine_realization (α a) (α b) k
    (by simpa only [z, map_pow] using aut_z α)
    (by rw [← map_pow]; exact congrArg α (by decide : b ^ 2 = 1) |>.trans α.map_one)
    hαb
    (by rw [← hαc, ← word_map]; exact hα2 a)
    (by rw [← hαc, ← word_map]; exact hα2 b)
    (by rw [← hαc, ← word_map]; exact hαk)
  let j := embeddingChoice choice
  have hactModel (d : Model) :
      AffineEight.evenEmbedding (j (α d)) =
        x * AffineEight.evenEmbedding (j d) * x⁻¹ := by
    have hh := hxact d
    rw [← hαc, ← word_map] at hh
    exact hh.symm
  have hxout : x ∉ AffineEight.evenEmbedding.range := by
    rw [AffineEight.mem_evenEmbedding_range_iff, hxodd]
    decide
  let _ : i.range.Normal := i.range.normal_of_index_eq_two hindex
  let _ : AffineEight.evenEmbedding.range.Normal :=
    AffineEight.evenEmbedding.range.normal_of_index_eq_two AffineEight.evenEmbedding_data.1
  let f := MonoidHom.ofInjective hi
  let fA := MonoidHom.ofInjective AffineEight.evenEmbedding_injective
  let eN : i.range ≃* AffineEight.evenEmbedding.range := f.symm.trans (j.trans fA)
  have heN (d : Model) :
      (eN ⟨i d, ⟨d, rfl⟩⟩ : AffineEight.Model) = AffineEight.evenEmbedding (j d) := by
    change AffineEight.evenEmbedding (j (f.symm (f d))) = _
    rw [f.symm_apply_apply]
  obtain ⟨e, he, _⟩ := Subgroup.exists_mulEquiv_of_index_two_extensions
    i.range AffineEight.evenEmbedding.range hindex AffineEight.evenEmbedding_data.1
    r x hr hxout eN (by
      have hsub : (⟨r ^ 2, i.range.sq_mem_of_index_two hindex r⟩ : i.range) =
          ⟨i k, ⟨k, rfl⟩⟩ := Subtype.ext hk.symm
      rw [hsub, heN]
      exact hxsq.symm) (by
      intro n
      obtain ⟨d, hd⟩ := n.property
      have hn : n = ⟨i d, ⟨d, rfl⟩⟩ := Subtype.ext hd.symm
      subst n
      have hsub : (⟨r * i d * r⁻¹,
          (inferInstance : i.range.Normal).conj_mem (i d) ⟨d, rfl⟩ r⟩ : i.range) =
          ⟨i (α d), ⟨α d, rfl⟩⟩ := Subtype.ext (hα d).symm
      rw [hsub, heN, heN]
      exact hactModel d)
  refine ⟨e, j, ?_, ?_⟩
  · intro d hd
    exact embeddingChoice_fixes_eight choice d
      (Subgroup.mem_centralizer_singleton_iff.mp hd)
  · intro d
    exact (he ⟨i d, ⟨d, rfl⟩⟩).trans (heN d)

end CyclicTwoDihedralFour
