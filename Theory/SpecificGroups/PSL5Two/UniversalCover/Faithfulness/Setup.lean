module

public import Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness.RootCalculus

/-!
# Subgroups for the binary degree-five Bruhat argument

The upper subgroup is generated by the ten positive roots. The Weyl subgroup
is generated by the literal three-letter coordinate-swap words. Removing a
simple root gives the upper complement needed for the elementary Bruhat step.
These are subgroups of the published presented group, not matrix preimages;
injectivity of their matrix maps remains a separate mathematical assertion.

Source: the type A₄ Steinberg/Bruhat argument for GLS98 §6.1 and
Aschbacher–Smith I.1.3, printed p.407.
-/

@[expose] public section

namespace Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness

/-- The ten strictly upper roots. -/
def positiveRoots : Set Root := {r | r.val.1 < r.val.2}

/-- The subgroup generated inside the presentation by its positive roots. -/
def upperSubgroup : Subgroup SteinbergGroup :=
  Subgroup.closure (generator '' positiveRoots)

/-- The literal coordinate transposition word. -/
def weylGenerator (r : Root) : SteinbergGroup :=
  weylWord generator r.val.1 r.val.2 r.property

/-- The coordinate-swap subgroup of the presentation. -/
def weylSubgroup : Subgroup SteinbergGroup :=
  Subgroup.closure (Set.range weylGenerator)

/-- A simple positive root in type A₄. -/
def simpleRoot (a : Fin 4) : Root :=
  root a.castSucc a.succ (by intro he; have hv := congrArg Fin.val he; simp at hv)

/-- The upper subgroup with one simple root omitted. -/
def upperComplement (a : Fin 4) : Subgroup SteinbergGroup :=
  Subgroup.closure (generator '' (positiveRoots \ {simpleRoot a}))

theorem generator_mem_upper {r : Root} (hr : r ∈ positiveRoots) :
    generator r ∈ upperSubgroup :=
  Subgroup.subset_closure ⟨r, hr, rfl⟩

theorem simpleRoot_positive (a : Fin 4) : simpleRoot a ∈ positiveRoots := by
  change a.val < a.val + 1
  omega

theorem simpleRoot_mem_upper (a : Fin 4) : generator (simpleRoot a) ∈ upperSubgroup :=
  generator_mem_upper (simpleRoot_positive a)

theorem upperComplement_le (a : Fin 4) : upperComplement a ≤ upperSubgroup :=
  Subgroup.closure_mono (Set.image_mono Set.sdiff_subset)

theorem weylGenerator_mem_weyl (r : Root) : weylGenerator r ∈ weylSubgroup :=
  Subgroup.subset_closure ⟨r, rfl⟩

theorem weylGenerator_inv (r : Root) : (weylGenerator r)⁻¹ = weylGenerator r :=
  weylWord_inv generator_relations _ _ _

theorem weylGenerator_conj_generator (r s : Root) :
    MulAut.conj (weylGenerator r) (generator s) =
      generator (permuteRoot (Equiv.swap r.val.1 r.val.2) s) :=
  weylWord_conj_generator generator_relations _ _ _ _

theorem weylGenerator_conj_weylGenerator (r s : Root) :
    MulAut.conj (weylGenerator r) (weylGenerator s) =
      weylGenerator (permuteRoot (Equiv.swap r.val.1 r.val.2) s) :=
  weylWord_conj_weylWord generator_relations _ _ _ _ _ _

/-- Every Weyl word permutes the roots by an actual coordinate permutation. -/
theorem weyl_conj_generator {w : SteinbergGroup} (hw : w ∈ weylSubgroup) :
    ∃ σ : Equiv.Perm (Fin 5), ∀ r : Root,
      MulAut.conj w (generator r) = generator (permuteRoot σ r) := by
  have step (z : SteinbergGroup) (r : Root)
      (hz : ∃ σ : Equiv.Perm (Fin 5), ∀ s : Root,
        MulAut.conj z (generator s) = generator (permuteRoot σ s)) :
      ∃ σ : Equiv.Perm (Fin 5), ∀ s : Root,
        MulAut.conj (z * weylGenerator r) (generator s) = generator (permuteRoot σ s) := by
    obtain ⟨σ, hσ⟩ := hz
    refine ⟨σ * Equiv.swap r.val.1 r.val.2, fun s => ?_⟩
    rw [map_mul]
    change MulAut.conj z (MulAut.conj (weylGenerator r) (generator s)) = _
    rw [weylGenerator_conj_generator, hσ]
    rfl
  induction hw using Subgroup.closure_induction_right with
  | one =>
    refine ⟨1, fun r => ?_⟩
    simp only [map_one, MulAut.one_apply]
    rfl
  | mul_right z _ y hy ih =>
    obtain ⟨r, rfl⟩ := hy
    exact step z r ih
  | mul_inv_cancel z _ y hy ih =>
    obtain ⟨r, rfl⟩ := hy
    rw [weylGenerator_inv]
    exact step z r ih

/-- The exact upper-complement factorization needed by the Bruhat step. -/
def UpperFactorization : Prop :=
  ∀ (a : Fin 4) (u : upperSubgroup), ∃ (e : Bool) (v : upperComplement a),
    u.val = (if e then generator (simpleRoot a) else 1) * v.val

/-- The double-coset covering to be established from the presentation. -/
def BruhatCover : Prop :=
  ∀ g : SteinbergGroup, ∃ (u : upperSubgroup) (w : weylSubgroup) (v : upperSubgroup),
    g = u.val * w.val * v.val

end Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness
