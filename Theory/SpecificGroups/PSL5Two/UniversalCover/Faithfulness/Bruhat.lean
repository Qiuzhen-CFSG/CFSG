module

public import Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness.Setup

/-!
# Bruhat coverage from simple-root upper factorization

In the binary degree-five Steinberg presentation, the positive root elements
and the four adjacent Weyl swaps generate the group. Assuming the explicit
`UpperFactorization` contract, every element has the form `u * w * v`, with
both outer factors in the upper subgroup and the middle factor in the Weyl
subgroup.

For the multiplication step, an adjacent swap normalizes the upper complement
with its simple root omitted. After factoring the last upper factor, Weyl
conjugation transports that simple root. If the transported root is positive,
its generator is absorbed on the left. If it is negative, the identity
`xα * sα = x₋α * xα` transports the opposite root to a positive one instead.
Word induction then proves the covering entirely inside the presented group.

This is the conditional normal-form input to the PSL₅(2) faithfulness argument
underlying Aschbacher–Smith I.1.3, printed p.407, and GLS98 §6.1. The parent
argument separately establishes upper factorization and the faithful
restrictions to the upper and Weyl subgroups.
-/

public section

open scoped commutatorElement
namespace Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness

private theorem simple_swap_complement (a : Fin 4) (r : Root)
    (hr : r ∈ positiveRoots \ {simpleRoot a}) :
    permuteRoot (Equiv.swap a.castSucc a.succ) r ∈ positiveRoots \ {simpleRoot a} := by
  exact (by
    simp only [positiveRoots, Set.mem_sdiff, Set.mem_ofPred_eq, Set.mem_singleton_iff]
    decide : ∀ (a : Fin 4) (r : Root), r ∈ positiveRoots \ {simpleRoot a} →
      permuteRoot (Equiv.swap a.castSucc a.succ) r ∈ positiveRoots \ {simpleRoot a}) a r hr

private theorem generator_reverse_eq (r : Root) :
    generator (root r.val.2 r.val.1 r.property.symm) =
      generator r * weylGenerator r * generator r := by
  rcases r with ⟨⟨i, j⟩, hij⟩
  simp only [weylGenerator, weylWord, root, mul_assoc, generator_relations.mul_self_assoc,
    generator_relations.mul_self, mul_one]

private theorem generator_mul_weyl (r : Root) : generator r * weylGenerator r =
    generator (root r.val.2 r.val.1 r.property.symm) * generator r := by
  rcases r with ⟨⟨i, j⟩, hij⟩
  simp only [weylGenerator, weylWord, root, mul_assoc, generator_relations.mul_self_assoc]

private theorem weylGenerator_mul_self (r : Root) : weylGenerator r * weylGenerator r = 1 := by
  nth_rw 1 [← weylGenerator_inv r]
  exact inv_mul_cancel _

/-- An adjacent Weyl swap preserves the subgroup generated by all other positive roots. -/
theorem simpleWeyl_conj_mem_upperComplement (a : Fin 4) {v : SteinbergGroup}
    (hv : v ∈ upperComplement a) :
    MulAut.conj (weylGenerator (simpleRoot a)) v ∈ upperComplement a := by
  induction hv using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨r, hr, rfl⟩ := hx
    rw [weylGenerator_conj_generator]
    exact Subgroup.subset_closure ⟨_, simple_swap_complement a r hr, rfl⟩
  | one => simpa only [map_one] using (upperComplement a).one_mem
  | mul x y hx hy ihx ihy =>
    simpa only [map_mul] using (upperComplement a).mul_mem ihx ihy
  | inv x hx ih =>
    simpa only [map_inv] using (upperComplement a).inv_mem ih

/-- The simple Weyl word normalizes the literal upper complement in the presentation. -/
theorem simpleWeyl_mem_normalizer_upperComplement (a : Fin 4) :
    weylGenerator (simpleRoot a) ∈ Subgroup.normalizer (upperComplement a : Set SteinbergGroup) := by
  apply Subgroup.mem_normalizer_iff.mpr
  intro v
  change v ∈ upperComplement a ↔
    MulAut.conj (weylGenerator (simpleRoot a)) v ∈ upperComplement a
  constructor
  · exact simpleWeyl_conj_mem_upperComplement a
  · intro hv
    have hh := simpleWeyl_conj_mem_upperComplement a hv
    have hs : MulAut.conj (weylGenerator (simpleRoot a)) *
        MulAut.conj (weylGenerator (simpleRoot a)) = 1 := by
      rw [← map_mul, weylGenerator_mul_self, map_one]
    have he := congrArg (fun f : MulAut SteinbergGroup => f v) hs
    change MulAut.conj (weylGenerator (simpleRoot a))
      (MulAut.conj (weylGenerator (simpleRoot a)) v) = v at he
    exact he ▸ hh

/-- The positive roots and the four adjacent swaps generate the presented group. -/
theorem closure_positiveRoots_simpleWeyl :
    Subgroup.closure (generator '' positiveRoots ∪
      Set.range (fun a : Fin 4 => weylGenerator (simpleRoot a))) = ⊤ := by
  let H := Subgroup.closure (generator '' positiveRoots ∪
    Set.range (fun a : Fin 4 => weylGenerator (simpleRoot a)))
  have hpos (r : Root) (hr : r ∈ positiveRoots) : generator r ∈ H :=
    Subgroup.subset_closure (Or.inl ⟨r, hr, rfl⟩)
  have hadj (a : Fin 4) :
      generator (root a.succ a.castSucc (simpleRoot a).property.symm) ∈ H := by
    change generator (root (simpleRoot a).val.2 (simpleRoot a).val.1 _) ∈ H
    rw [generator_reverse_eq (simpleRoot a)]
    exact H.mul_mem (H.mul_mem (hpos _ (simpleRoot_positive a))
      (Subgroup.subset_closure (Or.inr ⟨a, rfl⟩))) (hpos _ (simpleRoot_positive a))
  have hneg : ∀ (i j : Fin 5) (hji : j < i), generator (root i j (ne_of_gt hji)) ∈ H := by
    intro i
    induction i using Fin.induction with
    | zero => intro j hj; exact (Fin.not_lt_zero j hj).elim
    | succ a ih =>
      intro j hj
      by_cases he : j = a.castSucc
      · subst j; exact hadj a
      have hja : j < a.castSucc := by
        have hne : j.val ≠ a.castSucc.val := fun h => he (Fin.ext h)
        simp only [Fin.lt_def, Fin.val_succ, Fin.val_castSucc] at *
        omega
      rw [← generator_relations.chain a.succ a.castSucc j
        (simpleRoot a).property.symm (ne_of_gt hja) (ne_of_gt hj)]
      have hc := ih j hja
      simpa only [commutatorElement_def] using
        H.mul_mem (H.mul_mem (H.mul_mem (hadj a) hc) (H.inv_mem (hadj a))) (H.inv_mem hc)
  apply top_unique
  rw [← closure_range_generator]
  apply (Subgroup.closure_le (K := H)).mpr
  rintro _ ⟨r, rfl⟩
  rcases lt_or_gt_of_ne r.property with hr | hr
  · exact hpos r hr
  · exact hneg r.val.1 r.val.2 hr

private def InBruhat (g : SteinbergGroup) : Prop :=
  ∃ (u : upperSubgroup) (w : weylSubgroup) (v : upperSubgroup),
    g = u.val * w.val * v.val

private theorem inBruhat_mul_upper {g t : SteinbergGroup}
    (hg : InBruhat g) (ht : t ∈ upperSubgroup) : InBruhat (g * t) := by
  obtain ⟨u, w, v, rfl⟩ := hg
  exact ⟨u, w, ⟨v.val * t, upperSubgroup.mul_mem v.property ht⟩, mul_assoc _ _ _⟩

private theorem weyl_mul_generator (w : weylSubgroup)
    (σ : Equiv.Perm (Fin 5))
    (hσ : ∀ r : Root, MulAut.conj w.val (generator r) = generator (permuteRoot σ r))
    (r : Root) : w.val * generator r = generator (permuteRoot σ r) * w.val := by
  rw [← hσ, MulAut.conj_apply, mul_assoc, inv_mul_cancel, mul_one]

private theorem inBruhat_mul_simple (hfactor : UpperFactorization)
    {g : SteinbergGroup} (hg : InBruhat g) (a : Fin 4) :
    InBruhat (g * weylGenerator (simpleRoot a)) := by
  obtain ⟨u, w, v, hg⟩ := hg
  obtain ⟨e, c, hc⟩ := hfactor a v
  let d : upperSubgroup := ⟨MulAut.conj (weylGenerator (simpleRoot a)) c.val,
    upperComplement_le a ((Subgroup.mem_normalizer_iff.mp
      (simpleWeyl_mem_normalizer_upperComplement a) c.val).mp c.property)⟩
  let s : weylSubgroup := ⟨weylGenerator (simpleRoot a), weylGenerator_mem_weyl _⟩
  have hcs : c.val * s.val = s.val * d.val := by
    dsimp [s, d]
    simp only [weylGenerator_inv, ← mul_assoc,
      weylGenerator_mul_self, one_mul]
  have hred : g * s.val =
      u.val * (w.val * (if e then generator (simpleRoot a) else 1) * s.val) * d.val := by
    simp only [hg, hc, mul_assoc, hcs]
  change InBruhat (g * s.val)
  cases e with
  | false =>
    refine ⟨u, w * s, d, ?_⟩
    simpa only [Bool.false_eq_true, ↓reduceIte, mul_one, Subgroup.coe_mul] using hred
  | true =>
    simp only [↓reduceIte] at hred
    obtain ⟨σ, hσ⟩ := weyl_conj_generator w.property
    let r := simpleRoot a
    by_cases hpos : permuteRoot σ r ∈ positiveRoots
    · let b : upperSubgroup := ⟨generator (permuteRoot σ r), generator_mem_upper hpos⟩
      refine ⟨u * b, w * s, d, ?_⟩
      rw [hred, weyl_mul_generator w σ hσ r]
      simp only [Subgroup.coe_mul, b, mul_assoc]
    · let q := root r.val.2 r.val.1 r.property.symm
      have hq : permuteRoot σ q ∈ positiveRoots := by
        change σ r.val.2 < σ r.val.1
        change ¬σ r.val.1 < σ r.val.2 at hpos
        exact lt_of_le_of_ne (le_of_not_gt hpos) (σ.injective.ne r.property).symm
      let b : upperSubgroup := ⟨generator (permuteRoot σ q), generator_mem_upper hq⟩
      let x : upperSubgroup := ⟨generator r, simpleRoot_mem_upper a⟩
      refine ⟨u * b, w, x * d, ?_⟩
      rw [hred]
      change u.val * (w.val * generator r * weylGenerator r) * d.val = _
      rw [mul_assoc w.val, generator_mul_weyl, ← mul_assoc w.val,
        weyl_mul_generator w σ hσ q]
      simp only [Subgroup.coe_mul, b, x, mul_assoc]

/-- Simple-root upper factorization gives Bruhat coverage in the literal presentation. -/
theorem bruhatCover_of_upperFactorization (hfactor : UpperFactorization) : BruhatCover := by
  intro g
  have hg : g ∈ Subgroup.closure (generator '' positiveRoots ∪
      Set.range (fun a : Fin 4 => weylGenerator (simpleRoot a))) := by
    rw [closure_positiveRoots_simpleWeyl]
    trivial
  change InBruhat g
  have step (g y : SteinbergGroup) (hg : InBruhat g)
      (hy : y ∈ generator '' positiveRoots ∪
        Set.range (fun a : Fin 4 => weylGenerator (simpleRoot a))) : InBruhat (g * y) := by
    rcases hy with ⟨r, hr, rfl⟩ | ⟨a, rfl⟩
    · exact inBruhat_mul_upper hg (generator_mem_upper hr)
    · exact inBruhat_mul_simple hfactor hg a
  induction hg using Subgroup.closure_induction_right with
  | one => exact ⟨1, 1, 1, by simp⟩
  | mul_right g _ y hy ih => exact step g y ih hy
  | mul_inv_cancel g _ y hy ih =>
    have hinv : y⁻¹ = y := by
      rcases hy with ⟨r, _, rfl⟩ | ⟨a, rfl⟩
      · exact generator_relations.inv r
      · exact weylGenerator_inv _
    rw [hinv]
    exact step g y ih hy

end Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness
