module

public import Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness.Setup
public import Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness.MatrixSeparation
public import Theory.SpecificGroups.SymmetricCoxeterRecognition

/-!
# Faithfulness of the coordinate-swap subgroup

The adjacent Weyl words satisfy the type A₄ Coxeter relations: involutivity
handles the diagonal, and the exact conjugation formulas give both the braid
and distant relations. The symmetric-group presentation therefore supplies a
homomorphism from `Sym(Fin 5)` into the actual binary Steinberg group.

Its range is the subgroup generated by all twenty Weyl words, since every
ordered root is a coordinate permutation of the first simple root and the
homomorphism realizes that permutation by conjugation. Its composite with the
matrix map is `σ ↦ σ⁻¹.permMatrix`; the inverse accounts for Mathlib's matrix
multiplication convention. Injectivity of permutation matrices then proves
faithfulness on this entire Weyl subgroup.

This supplies the Weyl-factor input to the Bruhat kernel reduction for the
PSL₅(2) presentation. Source context: Aschbacher–Smith I.1.3, printed p.407,
and GLS98 §6.1. This is a presentation step, not the full multiplier assembly.
-/

@[expose] public section

namespace Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness

private theorem pair_cube (r s : Root)
    (h : permuteRoot (Equiv.swap r.val.1 r.val.2) s =
      permuteRoot (Equiv.swap s.val.1 s.val.2) r) :
    (weylGenerator r * weylGenerator s) ^ 3 = 1 := by
  have hb : weylGenerator r * weylGenerator s * weylGenerator r =
      weylGenerator s * weylGenerator r * weylGenerator s := by
    simpa only [MulAut.conj_apply, weylGenerator_inv] using
      (weylGenerator_conj_weylGenerator r s).trans
        ((congrArg weylGenerator h).trans
          (weylGenerator_conj_weylGenerator s r).symm)
  calc
    (weylGenerator r * weylGenerator s) ^ 3 =
        (weylGenerator r * weylGenerator s * weylGenerator r) *
          (weylGenerator s * weylGenerator r * weylGenerator s) := by
      simp only [pow_succ, pow_zero, one_mul, mul_assoc]
    _ = (weylGenerator s * weylGenerator r * weylGenerator s) *
          (weylGenerator s * weylGenerator r * weylGenerator s) := by rw [hb]
    _ = (weylGenerator s * weylGenerator r * weylGenerator s)⁻¹ *
          (weylGenerator s * weylGenerator r * weylGenerator s) := by
      simp only [mul_inv_rev, weylGenerator_inv, mul_assoc]
    _ = 1 := inv_mul_cancel _

private theorem pair_square (r s : Root)
    (h : permuteRoot (Equiv.swap r.val.1 r.val.2) s = s) :
    (weylGenerator r * weylGenerator s) ^ 2 = 1 := by
  have hc : weylGenerator r * weylGenerator s * weylGenerator r = weylGenerator s := by
    simpa only [MulAut.conj_apply, weylGenerator_inv, h] using
      weylGenerator_conj_weylGenerator r s
  calc
    (weylGenerator r * weylGenerator s) ^ 2 =
        (weylGenerator r * weylGenerator s * weylGenerator r) * weylGenerator s := by
      simp only [pow_succ, pow_zero, one_mul, mul_assoc]
    _ = weylGenerator s * weylGenerator s := by rw [hc]
    _ = 1 := by simpa only [weylGenerator_inv] using inv_mul_cancel (weylGenerator s)

/-- The actual adjacent Weyl words satisfy all type A₄ Coxeter relations. -/
theorem weylAdjacent_isLiftable :
    CoxeterMatrix.IsLiftable (CoxeterMatrix.A 4) (fun a => weylGenerator (simpleRoot a)) := by
  intro i j
  by_cases hij : i = j
  · subst j
    simpa only [CoxeterMatrix.diagonal, pow_one, weylGenerator_inv] using
      inv_mul_cancel (weylGenerator (simpleRoot i))
  · change (weylGenerator (simpleRoot i) * weylGenerator (simpleRoot j)) ^
      (if i = j then 1 else if j.val + 1 = i.val ∨ i.val + 1 = j.val then 3 else 2) = 1
    rw [if_neg hij]
    split_ifs with ha
    · apply pair_cube
      fin_cases i <;> fin_cases j <;> norm_num at ha
      all_goals decide
    · apply pair_square
      fin_cases i <;> fin_cases j <;> norm_num at hij
      all_goals norm_num at ha
      all_goals decide

/-- The symmetric-group homomorphism specified by the adjacent Weyl words. -/
noncomputable def weylPermutationLift : Equiv.Perm (Fin 5) →* SteinbergGroup :=
  Theory.GroupTheory.SymmetricCoxeterRecognition.lift 0
    (fun a => weylGenerator (simpleRoot a)) weylAdjacent_isLiftable

/-- The homomorphism preserves the specified adjacent-transposition marking. -/
theorem weylPermutationLift_adjacent (a : Fin 4) :
    weylPermutationLift (Equiv.swap a.castSucc a.succ) = weylGenerator (simpleRoot a) :=
  Theory.GroupTheory.SymmetricCoxeterRecognition.lift_adjacent 0 _ weylAdjacent_isLiftable a

private theorem lift_conj (σ : Equiv.Perm (Fin 5)) :
    ∀ r : Root, MulAut.conj (weylPermutationLift σ) (weylGenerator r) =
      weylGenerator (permuteRoot σ r) := by
  have hm : σ ∈ Submonoid.closure
      (Set.range fun a : Fin 4 => Equiv.swap a.castSucc a.succ) := by
    rw [Equiv.Perm.mclosure_swap_castSucc_succ]
    trivial
  induction hm using Submonoid.closure_induction with
  | mem p hp =>
    obtain ⟨a, rfl⟩ := hp
    intro r
    rw [weylPermutationLift_adjacent]
    exact weylGenerator_conj_weylGenerator (simpleRoot a) r
  | one =>
    intro r
    simp only [map_one, MulAut.one_apply]
    rfl
  | mul p q _ _ ip iq =>
    intro r
    rw [map_mul, map_mul]
    change MulAut.conj (weylPermutationLift p)
      (MulAut.conj (weylPermutationLift q) (weylGenerator r)) = _
    rw [iq, ip]
    rfl

private theorem exists_perm_root (r : Root) :
    ∃ σ : Equiv.Perm (Fin 5), permuteRoot σ (simpleRoot 0) = r := by
  let i := r.val.1
  let j := r.val.2
  let τ := Equiv.swap (0 : Fin 5) i
  have hj : τ j ≠ 0 := by
    intro he
    have hi : τ i = 0 := Equiv.swap_apply_right _ _
    exact r.property (τ.injective (hi.trans he.symm))
  refine ⟨τ * Equiv.swap 1 (τ j), ?_⟩
  apply Subtype.ext
  apply Prod.ext
  · change τ (Equiv.swap 1 (τ j) 0) = i
    rw [Equiv.swap_apply_of_ne_of_ne (by decide) hj.symm]
    exact Equiv.swap_apply_left _ _
  · change τ (Equiv.swap 1 (τ j) 1) = j
    rw [Equiv.swap_apply_left]
    exact Equiv.swap_apply_self _ _ _

/-- All twenty Weyl generators lie in the image of the adjacent presentation. -/
theorem weylPermutationLift_range : weylPermutationLift.range = weylSubgroup := by
  apply le_antisymm
  · rw [weylPermutationLift, Theory.GroupTheory.SymmetricCoxeterRecognition.lift_range]
    apply Subgroup.closure_mono
    rintro _ ⟨a, rfl⟩
    exact ⟨simpleRoot a, rfl⟩
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨r, rfl⟩
    obtain ⟨σ, hσ⟩ := exists_perm_root r
    rw [← hσ, ← lift_conj]
    exact weylPermutationLift.range.mul_mem
      (weylPermutationLift.range.mul_mem ⟨σ, rfl⟩
        ⟨Equiv.swap (0 : Fin 5) 1, weylPermutationLift_adjacent 0⟩)
      (weylPermutationLift.range.inv_mem ⟨σ, rfl⟩)

/-- The matrix image uses the inverse permutation, so multiplication is preserved. -/
theorem matrixMap_weylPermutationLift (σ : Equiv.Perm (Fin 5)) :
    (matrixMap (weylPermutationLift σ) : Matrix (Fin 5) (Fin 5) (ZMod 2)) =
      σ⁻¹.permMatrix (ZMod 2) := by
  have hh : (Matrix.SpecialLinearGroup.coeMonoidHom.comp
      (matrixMap.comp weylPermutationLift)) =
        (Matrix.permMatrixHom : Equiv.Perm (Fin 5) →* Matrix (Fin 5) (Fin 5) (ZMod 2)) := by
    apply MonoidHom.eq_of_eqOn_denseM (Equiv.Perm.mclosure_swap_castSucc_succ 4)
    rintro _ ⟨a, rfl⟩
    change (matrixMap (weylPermutationLift (Equiv.swap a.castSucc a.succ)) :
      Matrix (Fin 5) (Fin 5) (ZMod 2)) = _
    rw [weylPermutationLift_adjacent]
    simpa only [weylGenerator, simpleRoot, root, Matrix.permMatrixHom_apply, Equiv.swap_inv] using
      matrixMap_weylWord a.castSucc a.succ (simpleRoot a).property
  exact DFunLike.congr_fun hh σ

private theorem permMatrix_injective :
    Function.Injective (fun σ : Equiv.Perm (Fin 5) => σ.permMatrix (ZMod 2)) := by
  intro σ τ he
  have hp := PEquiv.toMatrix_injective he
  apply Equiv.ext
  intro i
  have hi := congrArg (fun e : PEquiv (Fin 5) (Fin 5) => e i) hp
  simpa using hi

/-- The literal matrix map is faithful on the subgroup generated by all
coordinate-swap words of the binary Steinberg presentation. -/
theorem matrixMap_weylSubgroup_injective :
    Function.Injective (matrixMap.comp weylSubgroup.subtype) := by
  intro x y hxy
  obtain ⟨σ, hσ⟩ := (show x.val ∈ weylPermutationLift.range by
    rw [weylPermutationLift_range]; exact x.property)
  obtain ⟨τ, hτ⟩ := (show y.val ∈ weylPermutationLift.range by
    rw [weylPermutationLift_range]; exact y.property)
  have hm : (σ⁻¹).permMatrix (ZMod 2) = (τ⁻¹).permMatrix (ZMod 2) := by
    rw [← matrixMap_weylPermutationLift, ← matrixMap_weylPermutationLift, hσ, hτ]
    exact congrArg (fun z : SL => (z : Matrix (Fin 5) (Fin 5) (ZMod 2))) hxy
  have he : σ = τ := inv_injective (permMatrix_injective hm)
  apply Subtype.ext
  rw [← hσ, ← hτ, he]

end Theory.SpecificGroups.PSL5Two.UniversalCover.Faithfulness
