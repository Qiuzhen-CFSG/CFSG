module

public import Theory.SpecificGroups.PSL3Three.GraphWitnesses.EightCentralizers.GraphModel.Coverage
public import Theory.SpecificGroups.PSL3Three.GraphWitnesses.EightCentralizers.GraphModel.IsotropicLines
public import Theory.SpecificGroups.PSL3Three.GraphWitnesses.EightCentralizers.Reduction
public import Theory.SpecificGroups.PSL3Three.GraphWitnesses.EightCentralizers.SymmetricFour
/-!
# The marked full graph centralizer in Aut(PSL₃(3))

Inverse transpose fixes the actual monomial subgroup, whose action on four
isotropic lines identifies it with S₄. Scalar determinant correction and the
proved automorphism normal form cover every automorphism by an inner actor
or an inner actor times inverse transpose. For a commuting actor the inner
conjugator is itself graph-fixed, since PSL₃(3) has trivial center.

The graph automorphism is outer: if it were conjugation by x, then x would
be central in its fixed S₄, forcing the graph automorphism to be the identity.
Multiplication consequently identifies the full automorphism centralizer
with the direct product of its graph-generated C₂ and this S₄. The two
marking equations retain the literal graph automorphism and conjugation map.

`graphFixedEquivSymmetricFour` and `graph_centralizer_split` discharge the
parameters `e` and `hsplit` of the elementary-eight witness assembly in
`EightCentralizers.eight_witness_of_graph_centralizer_calculations`.
Source: Guralnick--Malle, Classification of 2F-modules I, Proposition 4.2,
manuscript p.10.
-/

public section

open Subgroup Matrix.PSL3.OuterSolvable
namespace Matrix.PSL3Three.GraphWitnesses.EightCentralizers.GraphModel

local notation "τ" => graph (ZMod 3)

/-- The concrete inverse-transpose automorphism has order exactly two. -/
theorem graph_orderOf : orderOf τ = 2 := by
  apply orderOf_eq_prime (graph_sq (ZMod 3))
  intro h
  let t : SL := ⟨!![1, 1, 0; 0, 1, 0; 0, 0, 1], by decide⟩
  have hf : τ (project t) = project t := by
    rw [h]
    rfl
  have hs : graphSL (ZMod 3) t = t := project_injective hf
  have hn : t ∉ monomialSL := by
    rw [mem_monomialSL_iff_columns]
    decide
  exact hn ((graphSL_fixed_iff_monomial t).mp hs)

/-- The literal cyclic subgroup generated by inverse transpose is C₂. -/
theorem graphPowers_card : Nat.card (zpowers τ) = 2 := by
  rw [Nat.card_zpowers, graph_orderOf]

private theorem graphFixed_center_eq_bot : center (τ).fixedSubgroup = ⊥ := by
  apply eq_bot_iff.mpr
  intro x hx
  apply graphFixedEquivSymmetricFour.injective
  have he : graphFixedEquivSymmetricFour x ∈ center (Equiv.Perm (Fin 4)) := by
    rw [mem_center_iff]
    intro y
    obtain ⟨z, rfl⟩ := graphFixedEquivSymmetricFour.surjective y
    simpa only [← map_mul] using congrArg graphFixedEquivSymmetricFour
      (mem_center_iff.mp hx z)
  simpa only [symmetricFour_center_eq_bot, mem_bot, map_one] using he

/-- Inverse transpose is outside the actual inner automorphism subgroup. -/
theorem graph_not_inner : τ ∉ MulAut.innerSubgroup PSL := by
  rintro ⟨x, hx⟩
  have hfix : x ∈ (τ).fixedSubgroup := by
    rw [MulAut.mem_fixedSubgroup, ← hx]
    simp
  have hz : (⟨x, hfix⟩ : (τ).fixedSubgroup) ∈ center (τ).fixedSubgroup := by
    rw [mem_center_iff]
    intro y
    apply Subtype.ext
    have he : x * y.val * x⁻¹ = y.val := by
      change MulAut.conj x y.val = y.val
      rw [hx]
      exact (MulAut.mem_fixedSubgroup _ _).mp y.property
    exact ((mul_inv_eq_iff_eq_mul).mp he).symm
  have hx1 : x = 1 := congrArg Subtype.val
    (show (⟨x, hfix⟩ : (τ).fixedSubgroup) = 1 from
      by simpa only [graphFixed_center_eq_bot, mem_bot] using hz)
  have ht : τ = 1 := by rw [← hx, hx1, map_one]
  have := graph_orderOf
  rw [ht, orderOf_one] at this
  omega

private theorem commute_conj_graph_iff (x : PSL) :
    Commute (MulAut.conj x) τ ↔ τ x = x := by
  constructor
  · intro h
    apply MulAut.conj_injective_of_center_eq_bot psl_center_eq_bot
    have he : MulAut.conj (τ x) = τ * MulAut.conj x * τ⁻¹ := by ext y; simp
    rw [he, ← h.eq, mul_inv_cancel_right]
  · intro hx
    show MulAut.conj x * τ = τ * MulAut.conj x
    ext y
    simp only [MulAut.mul_apply, MulAut.conj_apply, map_mul, map_inv, hx]

/-- The split required by the elementary-eight witness, with no coverage premise. -/
theorem graph_centralizer_split (a : MulAut PSL) (_h : Commute a τ) :
    ∃ x : PSL, a = MulAut.conj x ∨ a = MulAut.conj x * τ :=
  automorphism_inner_or_inner_graph a

private theorem graphPower_cases (z : zpowers τ) : z.val = 1 ∨ z.val = τ := by
  classical
  have hz := mem_zpowers_iff_mem_range_orderOf.mp z.property
  rw [graph_orderOf] at hz
  obtain ⟨n, hn, he⟩ := Finset.mem_image.mp hz
  have hn' : n = 0 ∨ n = 1 := by have := Finset.mem_range.mp hn; omega
  rcases hn' with rfl | rfl
  · exact Or.inl (by simpa using he.symm)
  · exact Or.inr (by simpa using he.symm)

/-- The full centralizer inside the automorphism group of the actual PSL₃(3). -/
@[expose] def graphCentralizer : Subgroup (MulAut PSL) := centralizer {τ}

/-- Inner automorphisms from the literal fixed subgroup lie in the graph centralizer. -/
theorem conj_mem_graphCentralizer (x : (τ).fixedSubgroup) :
    MulAut.conj x.val ∈ graphCentralizer :=
  mem_centralizer_singleton_iff.mpr ((commute_conj_graph_iff x.val).mpr
    ((MulAut.mem_fixedSubgroup _ _).mp x.property)).eq

private theorem power_mem_graphCentralizer (z : zpowers τ) : z.val ∈ graphCentralizer := by
  rcases graphPower_cases z with h | h
  · rw [h]; exact graphCentralizer.one_mem
  · rw [h]; exact mem_centralizer_singleton_iff.mpr rfl

private theorem power_commute_conj (z : zpowers τ) (x : (τ).fixedSubgroup) :
    Commute z.val (MulAut.conj x.val) := by
  rcases graphPower_cases z with h | h
  · rw [h]; exact Commute.one_left _
  · rw [h]; exact ((commute_conj_graph_iff x.val).mpr
    ((MulAut.mem_fixedSubgroup _ _).mp x.property)).symm

/-- Multiplication of the two marked, commuting factors in the full centralizer. -/
@[expose] def centralizerProductHom : zpowers τ × (τ).fixedSubgroup →* graphCentralizer where
  toFun p := ⟨MulAut.conj p.2.val * p.1.val, by
    exact graphCentralizer.mul_mem
      (conj_mem_graphCentralizer p.2) (power_mem_graphCentralizer p.1)⟩
  map_one' := Subtype.ext (by simp)
  map_mul' p q := by
    apply Subtype.ext
    change MulAut.conj (p.2.val * q.2.val) * (p.1.val * q.1.val) =
      (MulAut.conj p.2.val * p.1.val) * (MulAut.conj q.2.val * q.1.val)
    rw [map_mul]
    exact (power_commute_conj p.1 q.2).symm.mul_mul_mul_comm _ _

private theorem centralizerProductHom_injective : Function.Injective centralizerProductHom := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply eq_bot_iff.mpr
  intro p hp
  have he : MulAut.conj p.2.val * p.1.val = 1 := congrArg Subtype.val hp
  have hz : p.1.val = 1 := by
    rcases graphPower_cases p.1 with h | h
    · exact h
    · exfalso
      apply graph_not_inner
      refine ⟨p.2.val⁻¹, ?_⟩
      rw [map_inv]
      apply inv_eq_of_mul_eq_one_right
      simpa only [h] using he
  have hx : p.2.val = 1 := by
    apply MulAut.conj_injective_of_center_eq_bot psl_center_eq_bot
    simpa only [hz, mul_one, map_one] using he
  exact Prod.ext (Subtype.ext hz) (Subtype.ext hx)

private theorem centralizerProductHom_surjective : Function.Surjective centralizerProductHom := by
  intro a
  have ha : Commute a.val τ := mem_centralizer_singleton_iff.mp a.property
  obtain ⟨x, hx | hx⟩ := graph_centralizer_split a.val ha
  · have hfix : x ∈ (τ).fixedSubgroup := (MulAut.mem_fixedSubgroup _ _).mpr
      ((commute_conj_graph_iff x).mp (hx ▸ ha))
    refine ⟨(1, ⟨x, hfix⟩), ?_⟩
    apply Subtype.ext
    change MulAut.conj x * 1 = a.val
    simpa only [mul_one] using hx.symm
  · have hcomm : Commute (MulAut.conj x) τ := by
      have he : (MulAut.conj x * τ) * τ = (τ * MulAut.conj x) * τ := by
        simpa only [hx, mul_assoc] using ha.eq
      exact mul_right_cancel he
    have hfix : x ∈ (τ).fixedSubgroup := (MulAut.mem_fixedSubgroup _ _).mpr
      ((commute_conj_graph_iff x).mp hcomm)
    exact ⟨(⟨τ, mem_zpowers _⟩, ⟨x, hfix⟩), Subtype.ext hx.symm⟩

/-- The actual centralizer is the direct product of the graph involution and S₄. -/
noncomputable def graphCentralizerEquiv : graphCentralizer ≃*
    zpowers τ × Equiv.Perm (Fin 4) :=
  (MulEquiv.ofBijective centralizerProductHom
    ⟨centralizerProductHom_injective, centralizerProductHom_surjective⟩).symm.trans
      (MulEquiv.prodCongr (MulEquiv.refl _) graphFixedEquivSymmetricFour)

/-- The product coordinates retain the literal factors. -/
theorem graphCentralizerEquiv_product (z : zpowers τ) (x : (τ).fixedSubgroup) :
    graphCentralizerEquiv (centralizerProductHom (z, x)) =
      (z, graphFixedEquivSymmetricFour x) := by
  change (MulEquiv.prodCongr (MulEquiv.refl _) graphFixedEquivSymmetricFour)
    ((MulEquiv.ofBijective centralizerProductHom
      ⟨centralizerProductHom_injective, centralizerProductHom_surjective⟩).symm
        ((MulEquiv.ofBijective centralizerProductHom
          ⟨centralizerProductHom_injective, centralizerProductHom_surjective⟩) (z, x))) = _
  rw [MulEquiv.symm_apply_apply]
  rfl

/-- Inverse transpose is the marked generator of the first factor. -/
theorem graphCentralizerEquiv_graph :
    graphCentralizerEquiv ⟨τ, mem_centralizer_singleton_iff.mpr rfl⟩ =
      (⟨τ, mem_zpowers _⟩, 1) := by
  have hp : centralizerProductHom (⟨τ, mem_zpowers _⟩, 1) =
      ⟨τ, mem_centralizer_singleton_iff.mpr rfl⟩ := by
    apply Subtype.ext
    change MulAut.conj (1 : PSL) * τ = τ
    rw [map_one, one_mul]
  rw [← hp]
  simpa only [map_one] using graphCentralizerEquiv_product ⟨τ, mem_zpowers _⟩ 1

/-- Conjugation by a graph-fixed element is marked in the S₄ factor. -/
theorem graphCentralizerEquiv_conj (x : (τ).fixedSubgroup) :
    graphCentralizerEquiv ⟨MulAut.conj x.val, conj_mem_graphCentralizer x⟩ =
      (1, graphFixedEquivSymmetricFour x) := by
  have hp : centralizerProductHom (1, x) =
      ⟨MulAut.conj x.val, conj_mem_graphCentralizer x⟩ := by
    apply Subtype.ext
    change MulAut.conj x.val * 1 = MulAut.conj x.val
    exact mul_one _
  rw [← hp]
  exact graphCentralizerEquiv_product 1 x

end Matrix.PSL3Three.GraphWitnesses.EightCentralizers.GraphModel
