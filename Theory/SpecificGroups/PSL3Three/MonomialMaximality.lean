/-- The specified monomialSL is a proper subgroup. -/
public theorem monomialSL_ne_top : monomialSL ≠ ⊤ := by
  have h : ambientGenerators 1 ∉ monomialSL := by
    rw [mem_monomialSL_iff_columns]
    decide
  intro heq
  exact h (heq.symm ▸ Subgroup.mem_top _)

/-- The concrete monomialSL is maximal in SL₃(3). -/
public theorem isCoatom_monomialSL : IsCoatom monomialSL :=
  isCoatom_of_matrixCertificate monomialSL monomialSL_ne_top
    gen inverse hinverse hgen rep table htable doubleRep index left right hdouble
    extension hextension

