/-- The specified singerNormalizerSL is a proper subgroup. -/
public theorem singerNormalizerSL_ne_top : singerNormalizerSL ≠ ⊤ := by
  have h : ambientGenerators 1 ∉ singerNormalizerSL := by
    rw [mem_singerNormalizerSL_iff]
    decide
  intro heq
  exact h (heq.symm ▸ Subgroup.mem_top _)

/-- The concrete singerNormalizerSL is maximal in SL₃(3). -/
public theorem isCoatom_singerNormalizerSL : IsCoatom singerNormalizerSL :=
  isCoatom_of_matrixCertificate singerNormalizerSL singerNormalizerSL_ne_top
    gen inverse hinverse hgen rep table htable doubleRep index left right hdouble
    extension hextension

