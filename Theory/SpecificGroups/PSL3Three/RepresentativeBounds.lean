module

public import Theory.SpecificGroups.PSL3Three.FiniteModel
public import Theory.GroupTheory.SubgroupEnumeration

/-!
# Explicit subgroup representatives and candidate bounds for SL₃(3)

This module supplies fifty generator lists, each lying in one of the four
concrete candidate subgroups. Determinants and candidate membership are checked
by kernel reduction. A fifty-first node is the whole group. The trivial node
and all candidate bounds are proved here; completeness of the family is a
separate extension-certificate obligation.

The lists were obtained from GAP's `ConjugacyClassesSubgroups(SL(3,3))`, then
conjugated into the candidates using ordinary matrix multiplication. GAP is
only a witness generator: neither its class enumeration nor subgroup orders
are used as premises. In particular the two order-24 nodes remain distinct.
The codes use the row-major encoding in `FiniteModel`; candidate tests use
Lean's column action.

Source: GLS III, Theorem 6.5.3(a–c), with the proper-subgroup restriction;
see also `SubgroupEnumeration` for the enumeration soundness argument.
-/

namespace Matrix.PSL3Three.CertifiedEnumeration

/-- The four concrete candidates, in line, plane, monomial, Singer order. -/
@[expose] public def candidate : Fin 4 → Subgroup SL :=
  ![lineStabilizerSL, planeStabilizerSL, monomialSL, singerNormalizerSL]

public instance decidableCandidateMembership (i : Fin 4) (g : SL) :
    Decidable (g ∈ candidate i) := by
  refine Fin.cases ?_ (Fin.cases ?_ (Fin.cases ?_ (Fin.cases ?_ (fun j => Fin.elim0 j)))) i <;>
    dsimp [candidate] <;> infer_instance

