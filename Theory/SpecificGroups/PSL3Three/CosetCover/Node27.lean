  rw [properNode_eq_wordSubgroup]
  exact table.sound ambientGenerator ambientInverse ambientGenerator_inv
    ambient_wordSubgroup_eq_top (nodeGenerator 27) (symmInv (n := (generatorCodes 27).length))
    (nodeGenerator_inv 27) rep valid
