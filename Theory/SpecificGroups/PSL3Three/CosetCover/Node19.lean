public theorem det : ∀ j, codeDet (codes j) = 1 := by
  have h := checkRange_fin (by decide : 0 < 351)
    (fun j => (codeDet (codes j)).val == 1) (checkRange_append (checkRange_append detCheck_0 (checkRange_append detCheck_1 detCheck_2)) (checkRange_append detCheck_3 (checkRange_append detCheck_4 detCheck_5)))
  intro j
  apply Fin.ext
  exact beq_iff_eq.mp (h j)
