    (fun j => (codeDet (codes j)).val == 1) (checkRange_append (checkRange_append detCheck_0 detCheck_1) (checkRange_append detCheck_2 (checkRange_append detCheck_3 detCheck_4)))
  intro j
  apply Fin.ext
  exact beq_iff_eq.mp (h j)
