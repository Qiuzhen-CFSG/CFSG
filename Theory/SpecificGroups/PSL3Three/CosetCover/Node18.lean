    (fun j => (codeDet (codes j)).val == 1) (checkRange_append (checkRange_append detCheck_0 (checkRange_append detCheck_1 detCheck_2)) (checkRange_append (checkRange_append detCheck_3 detCheck_4) (checkRange_append detCheck_5 detCheck_6)))
