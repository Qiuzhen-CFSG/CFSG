public theorem det : ∀ j, codeDet (codes j) = 1 := by
  have h := checkRange_fin (by decide : 0 < 234)
    (fun j => (codeDet (codes j)).val == 1) (checkRange_append (checkRange_append detCheck_0 detCheck_1) (checkRange_append detCheck_2 detCheck_3))
  intro j
  apply Fin.ext
  exact beq_iff_eq.mp (h j)
