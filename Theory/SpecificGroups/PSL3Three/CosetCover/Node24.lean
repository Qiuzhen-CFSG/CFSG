  rw [properNode_eq_wordSubgroup]
  exact table.sound ambientGenerator ambientInverse ambientGenerator_inv
    ambient_wordSubgroup_eq_top (nodeGenerator 24) (symmInv (n := (generatorCodes 24).length))
    (nodeGenerator_inv 24) rep valid
