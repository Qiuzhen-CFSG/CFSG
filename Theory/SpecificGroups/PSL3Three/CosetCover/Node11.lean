@[expose] public def wordCodes : Fin 8 → MatrixCode := fun j =>
  ((.branch 4 (.branch 2 (.branch 1 (.leaf 6643) (.leaf 6725)) (.branch 3 (.leaf 4862) (.leaf 4618))) (.branch 6 (.branch 5 (.leaf 2674) (.leaf 2432)) (.branch 7 (.leaf 13205) (.leaf 13285)))) : Lean.RArray MatrixCode).get j.val
set_option maxHeartbeats 4000000 in
public theorem wordEval : ∀ j, (evalWord (nodeGenerator 11) (words j)).val =
