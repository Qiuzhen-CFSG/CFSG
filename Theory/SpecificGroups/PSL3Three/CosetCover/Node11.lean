@[expose] public def next : Fin 702 → Fin 4 → Fin 702 := fun j =>
  ((.branch 11 (.branch 5 (.branch 2 (.branch 1 (.leaf nextBlock0) (.leaf nextBlock1)) (.branch 3 (.leaf nextBlock2) (.branch 4 (.leaf nextBlock3) (.leaf nextBlock4)))) (.branch 8 (.branch 6 (.leaf nextBlock5) (.branch 7 (.leaf nextBlock6) (.leaf nextBlock7))) (.branch 9 (.leaf nextBlock8) (.branch 10 (.leaf nextBlock9) (.leaf nextBlock10))))) (.branch 16 (.branch 13 (.branch 12 (.leaf nextBlock11) (.leaf nextBlock12)) (.branch 14 (.leaf nextBlock13) (.branch 15 (.leaf nextBlock14) (.leaf nextBlock15)))) (.branch 19 (.branch 17 (.leaf nextBlock16) (.branch 18 (.leaf nextBlock17) (.leaf nextBlock18))) (.branch 20 (.leaf nextBlock19) (.branch 21 (.leaf nextBlock20) (.leaf nextBlock21)))))) : Lean.RArray (Lean.RArray (Fin 4 → Fin 702))).get (j.val / 32) |>.get (j.val % 32)
@[expose] public def factorIndex : Fin 702 → Fin 4 → Fin 8 := fun j =>
  ((.branch 11 (.branch 5 (.branch 2 (.branch 1 (.leaf factorBlock0) (.leaf factorBlock1)) (.branch 3 (.leaf factorBlock2) (.branch 4 (.leaf factorBlock3) (.leaf factorBlock4)))) (.branch 8 (.branch 6 (.leaf factorBlock5) (.branch 7 (.leaf factorBlock6) (.leaf factorBlock7))) (.branch 9 (.leaf factorBlock8) (.branch 10 (.leaf factorBlock9) (.leaf factorBlock10))))) (.branch 16 (.branch 13 (.branch 12 (.leaf factorBlock11) (.leaf factorBlock12)) (.branch 14 (.leaf factorBlock13) (.branch 15 (.leaf factorBlock14) (.leaf factorBlock15)))) (.branch 19 (.branch 17 (.leaf factorBlock16) (.branch 18 (.leaf factorBlock17) (.leaf factorBlock18))) (.branch 20 (.leaf factorBlock19) (.branch 21 (.leaf factorBlock20) (.leaf factorBlock21)))))) : Lean.RArray (Lean.RArray (Fin 4 → Fin 8))).get (j.val / 32) |>.get (j.val % 32)
@[expose] public def table : RightCosetTable 4 4 702 where
  base := 0
  next := next
  factor := fun j k => words (factorIndex j k)
@[expose] public def transitionCheck (j : Fin 702) : Bool :=
  matrixEq ((rep j).val * (ambientGenerator 0).val)
    (decodeMatrix (wordCodes (factorIndex j 0)) * (rep (next j 0)).val) &&
  matrixEq ((rep j).val * (ambientGenerator 1).val)
    (decodeMatrix (wordCodes (factorIndex j 1)) * (rep (next j 1)).val) &&
  matrixEq ((rep j).val * (ambientGenerator 2).val)
    (decodeMatrix (wordCodes (factorIndex j 2)) * (rep (next j 2)).val) &&
  matrixEq ((rep j).val * (ambientGenerator 3).val)
    (decodeMatrix (wordCodes (factorIndex j 3)) * (rep (next j 3)).val)
@[expose] public def rowCheck (k : Nat) : Bool := transitionCheck ⟨k % 702, Nat.mod_lt _ (by decide)⟩
set_option maxHeartbeats 4000000 in
