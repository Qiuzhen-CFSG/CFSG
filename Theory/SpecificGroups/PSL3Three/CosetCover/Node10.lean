public theorem checked : ∀ j, transitionCheck j = true :=
  checkRange_fin (by decide) transitionCheck (checkRange_append (checkRange_append (checkRange_append rowCheck_0 rowCheck_1) (checkRange_append rowCheck_2 (checkRange_append rowCheck_3 rowCheck_4))) (checkRange_append (checkRange_append rowCheck_5 (checkRange_append rowCheck_6 rowCheck_7)) (checkRange_append rowCheck_8 (checkRange_append rowCheck_9 rowCheck_10))))
public theorem transitions : ∀ j k, (rep j).val * (ambientGenerator k).val =
    decodeMatrix (wordCodes (factorIndex j k)) * (rep (next j k)).val := by
  intro j k
  have h := checked j
  simp only [transitionCheck, Bool.and_eq_true] at h
  fin_cases k
  · exact matrixEq_sound h.1.1.1
  · exact matrixEq_sound h.1.1.2
  · exact matrixEq_sound h.1.2
  · exact matrixEq_sound h.2
public theorem valid : table.Valid ambientGenerator (nodeGenerator 10) rep := by
  constructor
  · decide +kernel
  · intro j k
    apply Subtype.ext
    change (rep j).val * (ambientGenerator k).val =
      (evalWord (nodeGenerator 10) (words (factorIndex j k))).val * (rep (next j k)).val
    rw [wordEval]
    exact transitions j k
public theorem cover : RightCosetCover (properNode 10) rep := by
  rw [properNode_eq_wordSubgroup]
  exact table.sound ambientGenerator ambientInverse ambientGenerator_inv
    ambient_wordSubgroup_eq_top (nodeGenerator 10) (symmInv (n := (generatorCodes 10).length))
    (nodeGenerator_inv 10) rep valid
end Matrix.PSL3Three.CertifiedEnumeration.Cosets10
