module
public import Theory.SpecificGroups.PSL3Three.InvolutionResidual
public import Theory.SpecificGroups.PSL3Three.GraphWitnesses.Conjugacy
public import Theory.SpecificGroups.PSL3Three.GraphWitnesses.EightCentralizers.GraphModel
public import Theory.GroupAction.AutomorphismFixerTransport
/-!
# The cyclic-four residual fixer in Aut(PSL₃(3))

An outer automorphism can first be adjusted to fix the marked involution,
then adjusted inside its GL₂(3) centralizer to fix the two-residual pointwise.
An outer involution has fixed subgroup S₄, so cannot fix that entire SL₂(3)
residual. The inner pointwise fixer is generated by the original involution;
the inner-or-graph normal form now forces the full fixer to be cyclic of
order four. Its outer generator squares to conjugation by the marked z.

Source: Aschbacher--Smith, Lemma 2.5.15, printed pp.558--559. The final
transport retains this square equation on any equivalent component carrier.
-/

public section
open Subgroup Theory.GroupTheory Matrix.PSL3.OuterSolvable
namespace Matrix.PSL3Three
open GraphWitnesses GraphWitnesses.EightCentralizers GraphWitnesses.EightCentralizers.GraphModel
local notation "τ" => graph (ZMod 3)
private abbrev I := MulAut.innerSubgroup PSL
private abbrev fixer (z : PSL) := fixingSubgroup (MulAut PSL) (GLTwoThreeLocal.residual z : Set PSL)

private theorem powers_cases {G : Type*} [Group G] [Finite G] (z x : G) (hz : orderOf z = 2)
    (hx : x ∈ zpowers z) : x = 1 ∨ x = z := by
  classical
  have h := mem_zpowers_iff_mem_range_orderOf.mp hx
  rw [hz] at h
  obtain ⟨n, hn, he⟩ := Finset.mem_image.mp h
  have hn' : n = 0 ∨ n = 1 := by have := Finset.mem_range.mp hn; omega
  rcases hn' with rfl | rfl
  · exact Or.inl (by simpa using he.symm)
  · exact Or.inr (by simpa using he.symm)

private theorem inner_fixer_cases (z : PSL) (hz : orderOf z = 2)
    (a : MulAut PSL) (ha : a ∈ fixer z) (hi : a ∈ I) :
    a = 1 ∨ a = MulAut.conj z := by
  obtain ⟨g, rfl⟩ := hi
  have hg : g ∈ centralizer (GLTwoThreeLocal.residual z : Set PSL) := by
    intro r hr
    have hf := (mem_fixingSubgroup_iff _).mp ha r hr
    change g * r * g⁻¹ = r at hf
    exact (mul_inv_eq_iff_eq_mul.mp hf).symm
  rw [(involution_residual_structure z hz).2.1] at hg
  rcases powers_cases z g hz hg with rfl | rfl
  · exact Or.inl (map_one MulAut.conj)
  · exact Or.inr rfl

private theorem outer_form (a : MulAut PSL) (ha : a ∉ I) :
    ∃ g : PSL, a = MulAut.conj g * τ := by
  obtain ⟨g, hg | hg⟩ := automorphism_inner_or_inner_graph a
  · exact (ha ⟨g, hg.symm⟩).elim
  · exact ⟨g, hg⟩

private theorem outer_difference_inner (a b : MulAut PSL) (ha : a ∉ I) (hb : b ∉ I) :
    a * b⁻¹ ∈ I := by
  obtain ⟨g, rfl⟩ := outer_form a ha
  obtain ⟨h, rfl⟩ := outer_form b hb
  refine ⟨g * h⁻¹, ?_⟩
  rw [map_mul, map_inv]
  group

private theorem outer_fixer_exists (z : PSL) (hz : orderOf z = 2) :
    ∃ a ∈ fixer z, a ∉ I := by
  have hs : IsConj (equiv.symm (τ z)) (equiv.symm z) :=
    Matrix.SL3.involutions_isConj (ZMod 3) _ _
      ((equiv.symm.orderOf_eq _).trans (((graph (ZMod 3)).orderOf_eq z).trans hz))
      ((equiv.symm.orderOf_eq z).trans hz) (by decide)
  have hp : IsConj (τ z) z := by
    obtain ⟨s, hs⟩ := isConj_iff.mp hs
    refine isConj_iff.mpr ⟨equiv s, ?_⟩
    simpa only [map_mul, map_inv, equiv.apply_symm_apply] using congrArg equiv hs
  obtain ⟨g, hg⟩ := isConj_iff.mp hp
  let b := MulAut.conj g * τ
  have hbz : b z = z := hg
  obtain ⟨c, hc⟩ := GLTwoThreeLocal.adjust_to_fix_residual z
    (involutionCentralizerEquivGL z hz) b hbz
  let a := MulAut.conj c.val⁻¹ * b
  refine ⟨a, (mem_fixingSubgroup_iff _).mpr hc, ?_⟩
  intro hi
  apply graph_not_inner
  have he : τ = MulAut.conj g⁻¹ * MulAut.conj c.val * a := by
    dsimp only [a, b]
    rw [map_inv, map_inv]
    group
  rw [he]
  exact I.mul_mem (I.mul_mem ⟨g⁻¹, rfl⟩ ⟨c.val, rfl⟩) hi

private noncomputable def outerInvolutionFixedEquiv (a : MulAut PSL)
    (ha : orderOf a = 2) (hi : a ∉ I) : a.fixedSubgroup ≃* Equiv.Perm (Fin 4) := by
  refine Classical.choice ?_
  obtain ⟨u, hu⟩ := outer_involution_graph_conjugate a ha hi
  have he : MulAut.congr u τ = a := by
    rw [hu]
    apply MulEquiv.ext
    intro x
    rfl
  exact ⟨(MulEquiv.subgroupCongr (congrArg MulAut.fixedSubgroup he.symm)).trans
    ((MulAut.fixedSubgroupCongr u τ).symm.trans graphFixedEquivSymmetricFour)⟩

private theorem outer_fixer_ne_involution (z : PSL) (hz : orderOf z = 2)
    (a : MulAut PSL) (ha : a ∈ fixer z) (hi : a ∉ I) : orderOf a ≠ 2 := by
  intro hao
  let e := outerInvolutionFixedEquiv a hao hi
  let R := GLTwoThreeLocal.residual z
  have hRa : R ≤ a.fixedSubgroup := by
    intro r hr
    exact (MulAut.mem_fixedSubgroup _ _).mpr ((mem_fixingSubgroup_iff _).mp ha r hr)
  have hcardR : Nat.card R = 24 := by
    obtain ⟨d⟩ := (involution_residual_structure z hz).1
    rw [Nat.card_congr d.toEquiv, Nat.card_eq_fintype_card]
    decide +kernel
  have hcarda : Nat.card a.fixedSubgroup = 24 := by
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card]
    decide +kernel
  have heq : R = a.fixedSubgroup := eq_of_le_of_card_ge hRa (by omega)
  have hzR : z ∈ R := GLTwoThreeLocal.centralElement_mem_residual z
    (involutionCentralizerEquivGL z hz) hz
  let zf : a.fixedSubgroup := ⟨z, heq ▸ hzR⟩
  have hzc : zf ∈ center a.fixedSubgroup := by
    rw [mem_center_iff]
    intro r
    exact Subtype.ext (mem_centralizer_singleton_iff.mp
      (GLTwoThreeLocal.residual_le z (show r.val ∈ R by rw [heq]; exact r.property)))
  have hezc : e zf ∈ center (Equiv.Perm (Fin 4)) := by
    rw [mem_center_iff]
    intro y
    obtain ⟨x, rfl⟩ := e.surjective y
    simpa only [← map_mul] using congrArg e (mem_center_iff.mp hzc x)
  have hz1 : z = 1 := by
    have h : e zf = 1 := by simpa only [symmetricFour_center_eq_bot, mem_bot] using hezc
    exact congrArg Subtype.val (e.injective (h.trans (e.map_one).symm))
  simp [hz1] at hz

/-- The full automorphism fixer of the actual residual is generated by an outer
order-four automorphism whose square is the original inner involution. -/
theorem involution_residual_fixer_cyclic_four (z : PSL) (hz : orderOf z = 2) :
    ∃ y : MulAut PSL, y ∉ MulAut.innerSubgroup PSL ∧ orderOf y = 4 ∧
      y ^ 2 = MulAut.conj z ∧
      fixingSubgroup (MulAut PSL) (GLTwoThreeLocal.residual z : Set PSL) = zpowers y := by
  obtain ⟨y, hy, hout⟩ := outer_fixer_exists z hz
  have hy2F : y ^ 2 ∈ fixer z := (fixer z).pow_mem hy 2
  have hy2I : y ^ 2 ∈ I := by
    have hinv : y⁻¹ ∉ I := fun h => hout (I.inv_mem h)
    simpa only [inv_inv, pow_two] using outer_difference_inner y y⁻¹ hout hinv
  have hy2 : y ^ 2 = MulAut.conj z := by
    rcases inner_fixer_cases z hz _ hy2F hy2I with h | h
    · exact (outer_fixer_ne_involution z hz y hy hout
        (orderOf_eq_prime h (fun h1 => hout (h1 ▸ I.one_mem)))).elim
    · exact h
  have hzconj : orderOf (MulAut.conj z) = 2 :=
    (orderOf_injective MulAut.conj (MulAut.conj_injective_of_center_eq_bot psl_center_eq_bot) z).trans hz
  have hy4 : orderOf y = 4 := by
    have hp : y ^ 4 = 1 := by
      rw [show 4 = 2 * 2 by rfl, pow_mul, hy2]
      exact hzconj ▸ pow_orderOf_eq_one (MulAut.conj z)
    have hd := orderOf_dvd_of_pow_eq_one hp
    have hn : y ^ 2 ≠ 1 := by
      rw [hy2]
      intro h
      rw [h, orderOf_one] at hzconj
      omega
    have hord := Nat.le_of_dvd (by decide : 0 < 4) hd
    interval_cases h : orderOf y <;> norm_num [h] at hd
    · have h' := pow_orderOf_eq_one y
      rw [h] at h'
      simp at h'
      exact (hn (by simp [h'])).elim
    · exact (hn (by simpa only [h] using pow_orderOf_eq_one y)).elim
    · rfl
  refine ⟨y, hout, hy4, hy2, le_antisymm ?_ (zpowers_le.mpr hy)⟩
  intro a ha
  by_cases hai : a ∈ I
  · rcases inner_fixer_cases z hz a ha hai with rfl | h
    · exact (zpowers y).one_mem
    · rw [h, ← hy2]
      exact (zpowers y).pow_mem (mem_zpowers y) 2
  · have hdiffF := (fixer z).mul_mem ha ((fixer z).inv_mem hy)
    have hdiffI := outer_difference_inner a y hai hout
    have hdiff : a * y⁻¹ ∈ zpowers y := by
      rcases inner_fixer_cases z hz _ hdiffF hdiffI with h | h
      · rw [h]; exact (zpowers y).one_mem
      · rw [h, ← hy2]; exact (zpowers y).pow_mem (mem_zpowers y) 2
    have h := (zpowers y).mul_mem hdiff (mem_zpowers y)
    simpa only [inv_mul_cancel_right] using h

/-- In particular the full pointwise residual fixer is cyclic of order four. -/
theorem involution_residual_fixer_structure (z : PSL) (hz : orderOf z = 2) :
    IsCyclic (fixingSubgroup (MulAut PSL) (GLTwoThreeLocal.residual z : Set PSL)) ∧
    Nat.card (fixingSubgroup (MulAut PSL) (GLTwoThreeLocal.residual z : Set PSL)) = 4 := by
  obtain ⟨y, _, hy, _, he⟩ := involution_residual_fixer_cyclic_four z hz
  rw [he]
  exact ⟨inferInstance, by rw [Nat.card_zpowers, hy]⟩

/-- The generator, its square marking and the full fixer transport together. -/
theorem involution_residual_fixer_cyclic_four_of_equiv {K : Type*} [Group K]
    (e : K ≃* PSL) (z : K) (hz : orderOf z = 2) :
    ∃ y : MulAut K, y ∉ MulAut.innerSubgroup K ∧ orderOf y = 4 ∧
      y ^ 2 = MulAut.conj z ∧
      fixingSubgroup (MulAut K) (GLTwoThreeLocal.residual z : Set K) = zpowers y := by
  obtain ⟨y, hout, hy, hy2, hfix⟩ := involution_residual_fixer_cyclic_four (e z)
    ((e.orderOf_eq z).trans hz)
  let a := MulAut.congr e
  let x := a.symm y
  have hax : a x = y := a.apply_symm_apply y
  refine ⟨x, ?_, (a.symm.orderOf_eq y).trans hy, ?_, ?_⟩
  · rintro ⟨g, hg⟩
    apply hout
    refine ⟨e g, ?_⟩
    rw [← MulAut.congr_conj, hg]
    exact hax
  · apply a.injective
    rw [map_pow, hax, hy2]
    exact (MulAut.congr_conj e z).symm
  · apply Subgroup.map_injective (f := a.toMonoidHom) a.injective
    rw [MulAut.map_fixingSubgroup_congr, GLTwoThreeLocal.map_residual, hfix, MonoidHom.map_zpowers]
    exact congrArg zpowers hax.symm

end Matrix.PSL3Three
