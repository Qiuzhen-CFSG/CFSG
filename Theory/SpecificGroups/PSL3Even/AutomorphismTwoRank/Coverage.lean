module

public import Theory.SpecificGroups.PSL3Even.AutomorphismTwoRank.Coverage.RootRigidity
public import Theory.SpecificGroups.PSL3Even.AutomorphismTwoRank.Coverage.OppositePair
public import Theory.SpecificGroups.PSL3Even.AutomorphismTwoRank.Coverage.RootOrientation

/-!
# Standard automorphism coverage for binary PSL₃

An inner correction preserves both specified opposite unipotent subgroups.
The characteristic-two plane geometry orients the six coordinate root groups
after an opposition-graph correction. Their additive coordinate maps then
reconstruct a genuine coefficient-field automorphism and a diagonal
conjugation. Every correction belongs to the concrete standard subgroup,
which therefore equals the full automorphism group when |F| = 2ⁿ and n > 1.

Source: the generation assertion of GLS3, Theorem 2.5.12(a), with the actual
matrix actions of §2.7 in `refs/KGroup/GLS3/chapter2.tex`, lines 1111–1115.
This is the coverage input to the binary PSL₃ automorphism-rank calculation
used by Aschbacher–Smith 16.3.9, printed p.1180.
-/

public section

open scoped MatrixGroups
open Matrix.PSL3.OuterSolvable Matrix.PSL3.OuterSolvable.OddPrimeCoverage
namespace Matrix.PSL3Even.AutomorphismCoverage
variable (F : Type*) [Field F] [Finite F]

/-- Conditional coverage assembly. Opposite-pair normalization and the field
reconstruction are proved; root orientation remains the explicit input. -/
theorem standard_eq_top_of_root_orientation {n : ℕ}
    (hn : 0 < n) (hF : Nat.card F = 2^n)
    (orient : ∀ α : MulAut PSL(3,F), PreservesUnipotentPair F α →
      ∃ ε : Fin 2, PreservesRootGroups ((oppositionGraph F ^ (ε : ℕ))⁻¹ * α)) :
    standard F = ⊤ := by
  apply top_unique
  intro α _
  obtain ⟨g,hg⟩ := exists_inner_preserves_pair F hn hF α
  obtain ⟨ε,hε⟩ := orient (MulAut.conj g * α) hg
  have hβ := mem_standard_of_preservesRootGroups _ hε
  have hγ := (standard F).pow_mem (oppositionGraph_mem_standard F) (ε : ℕ)
  have hδ : MulAut.conj g * α ∈ standard F := by
    simpa only [mul_inv_cancel_left] using (standard F).mul_mem hγ hβ
  have hi : MulAut.conj g ∈ standard F := inner_le_standard F ⟨g,rfl⟩
  simpa only [inv_mul_cancel_left] using (standard F).mul_mem ((standard F).inv_mem hi) hδ

/-- Every automorphism of PSL₃ over a finite binary field of order greater than
two belongs to the subgroup generated by linear conjugations, entrywise field
automorphisms and inverse transpose. This is the generation assertion of
GLS3 Theorem 2.5.12(a) for this family, with the concrete matrix actions of §2.7. -/
theorem standard_eq_top {n : ℕ} (hn : 1 < n) (hF : Nat.card F = 2^n) :
    standard F = ⊤ :=
  standard_eq_top_of_root_orientation F (by omega) hF
    (exists_oppositionGraph_preserves_roots F hn hF)

end Matrix.PSL3Even.AutomorphismCoverage
