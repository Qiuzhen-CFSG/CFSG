module

public import Theory.SpecificGroups.PSL3.OuterSolvable.StandardQuotient
public import Theory.GroupTheory.PrimeRankHom
public import Theory.GroupTheory.PrimeRankZero
public import Theory.SpecificGroups.PSL3Even.AutomorphismTwoRank.ElementaryKernel
public import Theory.SpecificGroups.PSL3Even.OuterElementaryRank.FixedRanks.FieldDescent
public import Theory.SpecificGroups.PSL3Even.OuterElementaryRank.FixedRanks.GraphConjugacy
public import Theory.SpecificGroups.PSL3Even.OuterElementaryRank.FixedRanks.GraphFieldDescent

/-!
# Two-rank of the standard automorphisms of binary PSL₃

The determinant kernel acts by inner automorphisms, so the order of the
diagonal outer image divides the order of the field's unit group. Over a
binary field this image has odd order. Its relative quotient in the standard
outer image is abelian and generated by the cyclic field image and the graph
involution. The field image therefore has index at most two, giving two-rank
at most two; the odd diagonal kernel contributes no additional two-rank.

All maps are the actual linear, coefficient and inverse-transpose actions on
SL₃/Z(SL₃). No coverage of arbitrary automorphisms is needed. The cardinality
bound four applies to elementary two-subgroup images, not the entire standard
outer group, whose field and diagonal factors can have larger order.

For field degree n > 1, an elementary subgroup contained in the inner group
has rank at most 2n. Otherwise choose an outer involution. The actual field,
graph and graph-field fixed groups have two-rank at most n, and the faithful
inner-kernel estimate bounds the actor rank by n+2 ≤ 2n. The descent theorems
retain the whole fixed groups, including PSL₃(2) and PSU₃(2) at degree two.

Source: GLS3, Theorem 2.5.12(b–e,i) and §2.7,
`refs/KGroup/GLS3/chapter2.tex`; Aschbacher–Smith 16.1.4, printed p.1171,
the rank inspection in 16.3.9, p.1180, and the G.9 rank table, p.356.
The outer-image bound also supplies the corresponding premise in
`PSL3Even/OuterElementaryRank/Reduction.lean`.
-/

public section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
namespace Matrix.PSL3.OuterSolvable

variable (F : Type*) [Field F]

/-- Determinant factorization controls the order of the actual diagonal image. -/
theorem innerDiagonalOuter_card_dvd_units :
    Nat.card (innerDiagonalOuter F) ∣ Nat.card Fˣ := by
  let d : GL (Fin 3) F →* Fˣ := GeneralLinearGroup.det
  let f := (linearOuterAction F).rangeRestrict
  have hk : d.ker ≤ f.ker := by
    simpa only [d, f, MonoidHom.ker_rangeRestrict] using det_ker_le_linearOuterAction_ker F
  exact (Subgroup.card_dvd_of_surjective (QuotientGroup.lift d.ker f hk)
    (QuotientGroup.lift_surjective_of_surjective d.ker f
      (linearOuterAction F).rangeRestrict_surjective hk)).trans
    (Subgroup.card_dvd_of_injective (QuotientGroup.kerLift d)
      (QuotientGroup.kerLift_injective d))

/-- The diagonal outer image has odd order over every binary field. -/
theorem innerDiagonalOuter_odd_of_two_power_card {n : ℕ}
    (hn : 0 < n) (hF : Nat.card F = 2 ^ n) :
    Odd (Nat.card (innerDiagonalOuter F)) := by
  have hu : Odd (Nat.card Fˣ) := by
    rw [Nat.card_units, hF, Nat.odd_iff]
    have hp : 0 < (2 : ℕ) ^ n := pow_pos (by decide) _
    have hd := Nat.mod_eq_zero_of_dvd (dvd_pow_self 2 (Nat.ne_of_gt hn))
    omega
  exact hu.of_dvd_nat (innerDiagonalOuter_card_dvd_units F)

variable [Finite F]

/-- The genuine field–graph quotient has two-rank at most two. -/
theorem standardOuterQuotient_two_rank_le : primeRank 2 (StandardOuterQuotient F) ≤ 2 := by
  let := standardOuterQuotient_isMulCommutative F
  let := fieldStandardQuotient_isCyclic F
  let C := (fieldStandardQuotient F).range
  have hi : C.index ≤ 2 ^ 1 := by
    have hd : C.index ∣ 2 := by
      have hg := standardOuterQuotient_generators F
      have he : C.index = C.relIndex (Subgroup.zpowers (graphStandardQuotient F)) := by
        rw [← Subgroup.relIndex_top_right, ← hg]
        exact Subgroup.relIndex_sup_left _ _
      rw [he]
      exact (Subgroup.relIndex_dvd_card _ _).trans (by
        rw [Nat.card_zpowers]
        exact orderOf_dvd_of_pow_eq_one (graphStandardQuotient_sq F))
    exact (Nat.le_of_dvd (by decide) hd).trans (by decide)
  have hr : primeRank 2 C ≤ 1 :=
    (Classical.choice (inferInstance : Nonempty (Sylow 2 C))).primeRank_le_one_of_isCyclic
      inferInstance
  exact (primeRank_le_add_of_index_le C hi).trans (Nat.add_le_add_right hr 1)

/-- The standard image in the literal Aut/Inn quotient has two-rank at most two. -/
theorem standardOuter_two_rank_le_of_two_power_card {n : ℕ}
    (hn : 0 < n) (hF : Nat.card F = 2 ^ n) :
    primeRank 2 (standardOuter F) ≤ 2 := by
  let N := (innerDiagonalOuter F).subgroupOf (standardOuter F)
  have hD : primeRank 2 (innerDiagonalOuter F) = 0 := by
    apply PrimeRank.eq_zero_iff_not_dvd_card.mpr
    exact (innerDiagonalOuter_odd_of_two_power_card F hn hF).not_two_dvd_nat
  have hN : primeRank 2 N = 0 :=
    (primeRank_equiv 2 (Subgroup.subgroupOfEquivOfLe
      (innerDiagonalOuter_le_standardOuter F))).trans hD
  have hr := primeRank_le_ker_add (p := 2) (QuotientGroup.mk' N)
  rw [QuotientGroup.ker_mk', hN, zero_add] at hr
  exact hr.trans (standardOuterQuotient_two_rank_le F)

/-- Characteristic-two formulation without a chosen field degree. -/
theorem standardOuter_two_rank_le [CharP F 2] :
    primeRank 2 (standardOuter F) ≤ 2 := by
  let := Fintype.ofFinite F
  obtain ⟨n, _, hn⟩ := FiniteField.card F 2
  exact standardOuter_two_rank_le_of_two_power_card F n.pos
    (by simpa only [Nat.card_eq_fintype_card] using hn)

/-- Every elementary standard actor has at most four images modulo inner
automorphisms, using the same quotient map as the fixed-group rank reduction. -/
theorem standard_elementary_outer_image_card_le_four {n : ℕ}
    (hn : 0 < n) (hF : Nat.card F = 2 ^ n)
    (E : Subgroup (MulAut PSL(3,F))) [IsElementaryAbelian 2 E]
    (hE : E ≤ standard F) :
    Nat.card (E.map (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F)))) ≤ 4 := by
  let Q := E.map (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F)))
  have hQ : Q ≤ standardOuter F := Subgroup.map_mono hE
  let : IsElementaryAbelian 2 Q := IsElementaryAbelian.map _
  have hc := (primeRank_le_iff_elementary_card_le (standardOuter F)).mp
    (standardOuter_two_rank_le_of_two_power_card F hn hF)
    (Q.subgroupOf (standardOuter F)) (IsElementaryAbelian.subgroupOf hQ)
  change Nat.card Q ≤ 2 ^ 2
  rwa [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hQ).toEquiv] at hc

private theorem standard_outer_fixed_bound {n : ℕ} (hn : 0 < n)
    (hF : Nat.card F = 2 ^ n) (a : MulAut PSL(3,F))
    (ha : a ∈ standard F) (hs : a ^ 2 = 1)
    (ho : a ∉ MulAut.innerSubgroup PSL(3,F)) : primeRank 2 a.fixedSubgroup ≤ n := by
  obtain ⟨g, σ, h | h⟩ := Matrix.PSL3.CartanActions.NormalizerForm.standard_factorization
    F field_linearConj graph_linearConj_exists field_commute_graph a ha
  · by_cases hσ : σ = 1
    · have he : a = linearConj F g := by simpa [hσ] using h
      exact (ho (he ▸ Matrix.PSL3.OddInvolutionFixed.linearConj_involution_inner g
        (he ▸ hs))).elim
    · subst a
      exact (Matrix.PSL3Even.OuterElementaryRank.FixedRanks.semilinear_field_fixed_rank
        hn hF g σ hσ hs).le
  · by_cases hσ : σ = 1
    · have he : a = linearConj F g * graph F := by simpa [hσ] using h
      rw [he]
      exact Matrix.PSL3Even.OuterElementaryRank.FixedRanks.graph_involution_fixed_rank
        hn hF g (he ▸ hs)
    · subst a
      exact (Matrix.PSL3Even.OuterElementaryRank.FixedRanks.GraphFieldDescent.fixed_rank_le
        hn hF g σ hσ hs).trans (Nat.sub_le n 1)

/-- The actual linear–field–graph automorphism subgroup of PSL₃(2ⁿ) has
 two-rank at most 2n for n > 1. No automorphism-coverage or rank premise is used. -/
theorem standard_two_rank_le_of_two_power_card {n : ℕ}
    (hn : 1 < n) (hF : Nat.card F = 2 ^ n) :
    primeRank 2 (standard F) ≤ 2 * n := by
  have hnpos : 0 < n := by omega
  have hc : center PSL(3,F) = ⊥ := by
    let := Atlas.sl_perfect (F := F) 3 (by decide)
    exact Group.IsPerfect.center_quotient_center_eq_bot (SpecialLinearGroup (Fin 3) F)
  let e : PSL(3,F) ≃* MulAut.innerSubgroup PSL(3,F) :=
    MonoidHom.ofInjective (MulAut.conj_injective_of_center_eq_bot hc)
  have hinner : primeRank 2 (MulAut.innerSubgroup PSL(3,F)) = 2 * n :=
    (primeRank_equiv 2 e).symm.trans (Matrix.PSL3Even.two_rank F hnpos hF)
  apply (primeRank_le_iff_elementary_card_le (standard F)).mpr
  intro E hE
  let := hE
  let A := E.map (standard F).subtype
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.map _
  have hAS : A ≤ standard F := Subgroup.map_subtype_le E
  have hA : primeRank 2 A ≤ 2 * n := by
    by_cases hAI : A ≤ MulAut.innerSubgroup PSL(3,F)
    · exact (primeRank_le_of_injective 2 (Subgroup.inclusion hAI)
        (Subgroup.inclusion_injective hAI)).trans hinner.le
    · obtain ⟨a, ha, hna⟩ := Set.not_subset.mp hAI
      have hs : a ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian a ha
      have hfixed := standard_outer_fixed_bound F hnpos hF a (hAS ha) hs hna
      have houter : primeRank 2
          (A.map (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3,F)))) ≤ 2 :=
        (primeRank_le_of_injective 2 (Subgroup.inclusion (Subgroup.map_mono hAS))
          (Subgroup.inclusion_injective (Subgroup.map_mono hAS))).trans
          (standardOuter_two_rank_le_of_two_power_card F hnpos hF)
      have hr := elementary_automorphism_two_rank_le hc A a ha
      omega
  have htop : IsElementaryAbelian 2 (⊤ : Subgroup A) := {
    toIsMulCommutative := inferInstance
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun x =>
      Subtype.ext (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 A) x.val)) }
  have hcard := (primeRank_le_iff_elementary_card_le A).mp hA ⊤ htop
  rw [Subgroup.card_top] at hcard
  simpa only [A, Subgroup.card_map_of_injective (standard F).subtype_injective] using hcard


end Matrix.PSL3.OuterSolvable
