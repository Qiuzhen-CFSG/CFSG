module

public import Theory.SpecificGroups.PSL3.EvenInnerCentralizers.MarkedInvariants
public import Theory.SpecificGroups.PSL3.NormalizedRootCentralizers.LinearBorel
public import Theory.GroupTheory.SylowKernelCore
public import Theory.Quasithin.EvenCharacteristic

/-!
# Recovering the PSL₃ Sylow subgroup from squares

Every nontrivial subgroup of the highest root has the same centralizer. Its
two-core is the marked upper-unitriangular Sylow subgroup. The subgroup generated
by squares is invariant under every automorphism preserving the original
subgroup. Consequently a subgroup of this Sylow with a nonidentity square
intrinsically determines the Sylow, including under graph and field automorphisms.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
§5.3.5–7, printed p.660, and the PSL₃ lower obstruction in E.1.14(1), p.214.
-/

@[expose] public section

open scoped MatrixGroups
open Subgroup Matrix.PSL3 Matrix.PSL3.LinearThree
open Matrix.PSL3Even.UnipotentGeometry
namespace Matrix.PSL3Even.LargePlaneNormalizers
variable (F : Type*) [Field F] [CharP F 2]

omit [CharP F 2] in
private theorem center_eq_projectiveCenter :
    (center (unipotent F)).map (unipotent F).subtype = projectiveCenter F :=
  marked_center F (unipotent F) (unipotentEquiv F)

private theorem centralizer_nonzero_center (z : PSL(3,F))
    (hz : z ∈ projectiveCenter F) (hne : z ≠ 1) :
    centralizer ({z} : Set PSL(3,F)) = centralizer (projectiveCenter F : Set PSL(3,F)) := by
  simpa only [center_eq_projectiveCenter, top_inf_eq] using
    NormalizedRootCentralizers.uniform (⊤ : Subgroup PSL(3,F)) z
      (by rwa [center_eq_projectiveCenter]) hne

private theorem centralizer_center :
    centralizer (projectiveCenter F : Set PSL(3,F)) = EvenInnerCentralizers.centralizer F := by
  symm
  apply centralizer_nonzero_center
  · exact (mem_projectiveCenter F _).mpr ⟨1, rfl⟩
  · exact EvenInnerCentralizers.root_ne_one F

/-- Every nonidentity highest-root element has the marked full centralizer. -/
theorem centralizer_singleton_eq_of_mem_center (z : PSL(3,F))
    (hz : z ∈ projectiveCenter F) (hne : z ≠ 1) :
    centralizer ({z} : Set PSL(3,F)) = EvenInnerCentralizers.centralizer F :=
  (centralizer_nonzero_center F z hz hne).trans (centralizer_center F)

/-- Every nontrivial subgroup of the highest root has the same full inner centralizer. -/
theorem centralizer_eq_of_le_center (D : Subgroup PSL(3,F))
    (hD : D ≤ projectiveCenter F) (hne : D ≠ ⊥) :
    centralizer (D : Set PSL(3,F)) = EvenInnerCentralizers.centralizer F := by
  obtain ⟨⟨z,hz⟩,hnz⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
  have hnz : z ≠ 1 := fun h => hnz (Subtype.ext h)
  apply le_antisymm
  · calc
      centralizer (D : Set PSL(3,F)) ≤ centralizer ({z} : Set PSL(3,F)) :=
        centralizer_le (Set.singleton_subset_iff.mpr hz)
      _ = centralizer (projectiveCenter F : Set PSL(3,F)) :=
        centralizer_nonzero_center F z (hD hz) hnz
      _ = EvenInnerCentralizers.centralizer F := centralizer_center F
  · rw [← centralizer_center F]
    exact centralizer_le hD

/-- The two-core recovers the marked Sylow subgroup from any nonzero subgroup of its center. -/
theorem centralizer_twoCore [Finite F] (D : Subgroup PSL(3,F))
    (hD : D ≤ projectiveCenter F) (hne : D ≠ ⊥)
    {f : ℕ} (hf : 0 < f) (hF : Nat.card F = 2^f) :
    (centralizer (D : Set PSL(3,F))).pCoreIn 2 = unipotent F := by
  rw [centralizer_eq_of_le_center F D hD hne, pCoreIn,
    EvenInnerCentralizers.MarkedInvariants.twoCore_eq_unipotent F hF hf,
    ← MonoidHom.range_comp]
  exact projective_range F

section Squares
variable {H K : Type*} [Group H] [Group K]

/-- The characteristic subgroup generated by the squares of a subgroup. -/
def squares (Q : Subgroup H) : Subgroup H :=
  closure ((fun x : H => x ^ 2) '' (Q : Set H))

theorem squares_map (Q : Subgroup H) (e : H ≃* K) :
    (squares Q).map e.toMonoidHom = squares (Q.map e.toMonoidHom) := by
  unfold squares
  rw [MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨_,⟨x,hx,rfl⟩,rfl⟩
    exact ⟨e x, mem_map_of_mem _ hx, (map_pow e x 2).symm⟩
  · rintro ⟨_,⟨x,hx,rfl⟩,rfl⟩
    exact ⟨x^2,⟨x,hx,rfl⟩,map_pow e x 2⟩

end Squares

private theorem squares_le_center (Q : Subgroup PSL(3,F)) (hQ : Q ≤ unipotent F) :
    squares Q ≤ projectiveCenter F := by
  rw [squares, closure_le]
  rintro _ ⟨x,hx,rfl⟩
  have hxr : x ∈ (projective F).range := by rw [projective_range]; exact hQ hx
  obtain ⟨u,rfl⟩ := hxr
  change (projective F u)^2 ∈ projectiveCenter F
  rw [← map_pow]
  apply mem_map_of_mem
  simp [mem_Z, pow_two, CharTwo.add_self_eq_zero]

/-- Every automorphism preserving a subgroup with a nonidentity square preserves
its marked Sylow subgroup. This includes outer automorphisms. -/
theorem map_unipotent_of_square_ne_one [Finite F] (Q : Subgroup PSL(3,F))
    (hQ : Q ≤ unipotent F) (hn : ∃ x ∈ Q, x ^ 2 ≠ 1)
    {f : ℕ} (hf : 0 < f) (hF : Nat.card F = 2^f)
    (α : MulAut PSL(3,F)) (hα : Q.map α.toMonoidHom = Q) :
    (unipotent F).map α.toMonoidHom = unipotent F := by
  have hnD : squares Q ≠ ⊥ := by
    obtain ⟨x,hx,hnx⟩ := hn
    intro he
    have hm : x^2 ∈ squares Q := subset_closure ⟨x,hx,rfl⟩
    rw [he, mem_bot] at hm
    exact hnx hm
  have hc := centralizer_twoCore F (squares Q) (squares_le_center F Q hQ) hnD hf hF
  rw [← hc, map_pCoreIn_of_injective 2 _ _ α.injective,
    Theory.Quasithin.map_centralizer, squares_map, hα]

end Matrix.PSL3Even.LargePlaneNormalizers
