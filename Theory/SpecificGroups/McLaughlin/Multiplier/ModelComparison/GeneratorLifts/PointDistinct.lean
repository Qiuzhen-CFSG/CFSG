theorem pointFingerprintValues_length : pointFingerprintValues.length = 275 := by decide

def pointFingerprintValue (i : Fin 275) : ℤ :=
  pointFingerprintValues.get ⟨i.val, by rw [pointFingerprintValues_length]; exact i.isLt⟩

def pointFingerprintInverse (z : ℤ) : ℕ := pointFingerprintValues.idxOf z

private def FingerprintCertificate (i : Fin 275) : Prop :=
  pointFingerprint (pointVectors i) = pointFingerprintValue i ∧
  pointFingerprintInverse (pointFingerprintValue i) = i.val

private instance fingerprintCertificate_decidable (i : Fin 275) :
    Decidable (FingerprintCertificate i) := by
  unfold FingerprintCertificate
  infer_instance

private theorem fingerprintCert0 : ∀ j : Fin 25, FingerprintCertificate (pointBlock 0 j) := by
  apply allFin
  decide +kernel

private theorem fingerprintCert1 : ∀ j : Fin 25, FingerprintCertificate (pointBlock 1 j) := by
  apply allFin
