  apply allFin
  decide +kernel

private theorem fingerprintCertAll (x : Fin 275) : FingerprintCertificate x := by
  apply allPointBlocks FingerprintCertificate _ x
  intro b
  fin_cases b
  · exact fingerprintCert0
  · exact fingerprintCert1
  · exact fingerprintCert2
  · exact fingerprintCert3
  · exact fingerprintCert4
  · exact fingerprintCert5
  · exact fingerprintCert6
  · exact fingerprintCert7
  · exact fingerprintCert8
  · exact fingerprintCert9
  · exact fingerprintCert10

theorem pointFingerprint_checked (i : Fin 275) :
    pointFingerprint (pointVectors i) = pointFingerprintValue i := (fingerprintCertAll i).1

theorem pointFingerprintInverse_checked (i : Fin 275) :
    pointFingerprintInverse (pointFingerprintValue i) = i.val := (fingerprintCertAll i).2

theorem pointVectors_injective : Function.Injective pointVectors := by
  intro i j h
  apply Fin.ext
  have he := congrArg (pointFingerprintInverse ∘ pointFingerprint) h
  simpa only [Function.comp_apply, pointFingerprint_checked, pointFingerprintInverse_checked] using he

