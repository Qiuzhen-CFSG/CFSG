module

public import Theory.SpecificGroups.McLaughlin.Multiplier.ModelComparison.PermutationOrder.Tables
import Mathlib.Tactic.FinCases

/-!
# McL stabilizer generators certified in the original pair

Part of the lower-bound certificate for the literal `McLG1-p275B0` carrier.
The witness generator in `source/` is untrusted; Lean checks every finite
identity. Source permutations and their action convention are in
`Theory/SpecificGroups/LeechRelated/AtlasCarriers/McL.lean`.
-/

@[expose] public section
namespace Theory.SpecificGroups.McLaughlin.Multiplier.ModelComparison.PermutationOrder
open Theory.GroupTheory Sporadic.LeechRelated.McL
set_option maxRecDepth 100000

def p2Map : Fin 275 → Fin 275 := unpack 
def p2InvMap : Fin 275 → Fin 275 := unpack 
theorem p2_left : ∀ x, p2InvMap (p2Map x) = x := by
  apply allFin
  decide +kernel

def p2 : Equiv.Perm (Fin 275) :=
  tablePerm p2Map p2InvMap p2_left (rightInverse_of_leftInverse_fin p2_left)

def word2 : List (Fin 4) := [2, 2, 1, 2, 1, 3, 3, 1, 2, 1, 3, 3, 1, 3, 1, 1, 3, 3, 1, 2, 1, 2, 2, 1, 3, 3, 1, 2, 1, 3, 1, 3, 3, 3, 1, 3, 0, 3, 0, 2, 2, 0, 3, 3, 0, 2, 0, 2, 0, 2, 2]

theorem word2_eq : evalWord originalGen word2 = p2 := by
  apply Equiv.ext
  apply allFin
  decide +kernel

theorem p2_mem : p2 ∈ generated :=
  word2_eq ▸ word_mem originalGen generated originalGen_mem word2

