module

public import Theory.SpecificGroups.McLaughlin.Multiplier.ModelComparison.PermutationOrder.Counting
import Mathlib.Tactic.FinCases

/-!
# Packed tables for the two defining McL permutations

Part of the lower-bound certificate for the literal `McLG1-p275B0` carrier.
The witness generator in `source/` is untrusted; Lean checks every finite
identity. Source permutations and their action convention are in
`Theory/SpecificGroups/LeechRelated/AtlasCarriers/McL.lean`.
-/

@[expose] public section
namespace Theory.SpecificGroups.McLaughlin.Multiplier.ModelComparison.PermutationOrder
open Theory.GroupTheory Sporadic.LeechRelated.McL
set_option maxRecDepth 100000

/-- Nine bits per image, with a total decoding function. -/
def unpack (code : Nat) (x : Fin 275) : Fin 275 :=
  ⟨(code >>> (9 * x.val)) % 512 % 275, Nat.mod_lt _ (by decide)⟩

def p0Map : Fin 275 → Fin 275 := unpack 
def p0InvMap : Fin 275 → Fin 275 := unpack 
theorem p0_left : ∀ x, p0InvMap (p0Map x) = x := by
  apply allFin
  decide +kernel

def p0 : Equiv.Perm (Fin 275) :=
  tablePerm p0Map p0InvMap p0_left (rightInverse_of_leftInverse_fin p0_left)

theorem p0_eq_generator : p0 = generatorA := by
  apply Equiv.ext
  apply allFin
  decide +kernel

theorem p0_mem : p0 ∈ generated := by
  rw [p0_eq_generator]
  exact Subgroup.subset_closure (by simp)

def p1Map : Fin 275 → Fin 275 := unpack 
def p1InvMap : Fin 275 → Fin 275 := unpack 
theorem p1_left : ∀ x, p1InvMap (p1Map x) = x := by
  apply allFin
  decide +kernel

def p1 : Equiv.Perm (Fin 275) :=
  tablePerm p1Map p1InvMap p1_left (rightInverse_of_leftInverse_fin p1_left)

theorem p1_eq_generator : p1 = generatorB := by
  apply Equiv.ext
  apply allFin
  decide +kernel

theorem p1_mem : p1 ∈ generated := by
  rw [p1_eq_generator]
  exact Subgroup.subset_closure (by simp)

def originalGen (i : Fin 4) : Equiv.Perm (Fin 275) :=
  match i.val with
  | 0 => p0
  | 1 => p0⁻¹
  | 2 => p1
  | _ => p1⁻¹

theorem originalGen_mem (i : Fin 4) : originalGen i ∈ generated := by
  fin_cases i
  · exact p0_mem
  · exact generated.inv_mem p0_mem
  · exact p1_mem
  · exact generated.inv_mem p1_mem

end Theory.SpecificGroups.McLaughlin.Multiplier.ModelComparison.PermutationOrder
