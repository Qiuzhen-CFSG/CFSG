/-- A left inverse for the images of the base letter. -/
def imageIndex (x : Fin 275) : Fin 275 :=
  ⟨( >>> (9 * x.val)) % 512 % 275, Nat.mod_lt _ (by decide)⟩

theorem imageIndex_rep : ∀ i, imageIndex (rep i 0) = i := by
  apply allFin
  decide +kernel

theorem card_step : 275 * Nat.card (stabilizer 1) ≤ Nat.card (stabilizer 0) := by
  apply orbit_mul_card_le (k := 0) (by decide) rep
  · intro i
    exact word_mem gen (stabilizer 0) gen_mem (repWord i)
  · exact Function.LeftInverse.injective imageIndex_rep

end Level0
