set_option maxRecDepth 100000

namespace Level0

def gen (i : Fin 4) : Equiv.Perm (Fin 275) :=
  match i.val with
  | 0 => p0
  | 1 => p0⁻¹
  | 2 => p1
  | _ => p1⁻¹

theorem gen_mem_generated (i : Fin 4) : gen i ∈ generated := by
  fin_cases i
  · exact p0_mem
  · exact generated.inv_mem p0_mem
  · exact p1_mem
  · exact generated.inv_mem p1_mem

theorem gen_mem (i : Fin 4) : gen i ∈ stabilizer 0 := by
  refine ⟨gen_mem_generated i, fun j hj => ?_⟩
  exact (Nat.not_lt_zero _ hj).elim

