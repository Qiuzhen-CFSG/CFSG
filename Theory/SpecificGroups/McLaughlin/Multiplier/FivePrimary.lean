module

public import Theory.SpecificGroups.McLaughlin.Multiplier.FivePrimary.Elements
public import Theory.SpecificGroups.McLaughlin.Multiplier.Basic
public import Theory.GroupTheory.PGroup.HeisenbergPair
public import Theory.GroupTheory.PerfectCentralCoverSimultaneousInversion

/-!
# Excluding five from perfect central kernels over McLaughlin

The checked ATLAS words generate a noncommutative Heisenberg group of order
125. The specified comparison with the Leech triangle stabilizer transports
its proved order to the permutation carrier, making this subgroup Sylow.
A checked ambient word inverts both generators and fixes their commutator.
Simultaneous-inversion transfer therefore excludes five from every finite
perfect central kernel. The comparison is the only additional premise.

This is a direct local alternative to Griess's U3(5)-subgroup argument,
Arch. Math. 48 (1987), p.31, doi:10.1007/BF01196350. It supplies the
five-primary part of the McL entry of Aschbacher–Smith I.1.4(2), printed
p.408. The A.2.19 application is in `FivePrimary.Source`, which imports
the multiplier parent separately to preserve an acyclic import boundary.
-/

namespace Theory.SpecificGroups.McLaughlin.Multiplier.FivePrimary
open Sporadic.LeechRelated.McL Atlas.Sporadic.McLaughlin Subgroup
open Elements

/-- The actual subgroup generated by the two certified ATLAS words. -/
@[expose] public def subgroup : Subgroup Carrier := closure ({x, y} : Set Carrier)

public theorem card_subgroup : Nat.card subgroup = 5 ^ 3 := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  exact PrimeCubePair.card_closure_pair x y x_fifth y_fifth commutator_fifth
    x_commute_commutator.symm y_commute_commutator.symm xy_ne_yx

/-- The model comparison certifies that the word subgroup has index prime to five. -/
public theorem not_five_dvd_index (comparison : Carrier ≃* Model) :
    ¬ 5 ∣ subgroup.index := by
  intro h
  have hd : 625 ∣ Nat.card Carrier := by
    rw [← subgroup.card_mul_index, card_subgroup]
    exact Nat.mul_dvd_mul_left 125 h
  rw [Nat.card_congr comparison.toEquiv, card_factorization] at hd
  norm_num at hd

/-- The literal word subgroup, certified Sylow using the specified comparison. -/
@[expose] public noncomputable def sylow (comparison : Carrier ≃* Model) :
    Sylow 5 Carrier :=
  letI : Fact (Nat.Prime 5) := ⟨by decide⟩
  (IsPGroup.of_card card_subgroup).toSylow (not_five_dvd_index comparison)

/-- Five is absent from every finite perfect central kernel over the permutation carrier. -/
public theorem not_five_dvd_card_kernel_carrier
    (comparison : Carrier ≃* Model)
    {E : Type*} [Group E] [Finite E]
    (f : PerfectCentralCovering.Cover E Carrier) :
    ¬ 5 ∣ Nat.card f.toMonoidHom.ker := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  let : Group.IsPerfect E := f.isPerfect
  exact PerfectCentralCovering.not_dvd_card_kernel_of_simultaneous_inversion
    f.toMonoidHom f.surjective f.ker_le_center
    (by decide : Nat.Coprime 5 2) (sylow comparison) x y r rfl
    x_fifth y_fifth commutator_ne_one x_commute_commutator y_commute_commutator
    r_inverts_x r_inverts_y r_commute_commutator

end Theory.SpecificGroups.McLaughlin.Multiplier.FivePrimary

namespace Theory.SpecificGroups.McLaughlin.Multiplier
open Sporadic.LeechRelated.McL Atlas.Sporadic.McLaughlin PerfectCentralCovering

/-- The five-primary exclusion for every finite perfect central cover of the
Leech triangle-stabilizer model, under the specified carrier comparison. -/
public theorem not_five_dvd_card_kernel
    (comparison : Carrier ≃* Model)
    {E : Type*} [Group E] [Finite E] (f : Cover E Model) :
    ¬ 5 ∣ Nat.card f.toMonoidHom.ker := by
  let g : Cover E Carrier := {
    toMonoidHom := comparison.symm.toMonoidHom.comp f.toMonoidHom
    surjective := comparison.symm.surjective.comp f.surjective
    isPerfect := f.isPerfect
    ker_le_center := by
      rw [MonoidHom.ker_comp_of_injective _ _ comparison.symm.injective]
      exact f.ker_le_center }
  have hk : g.toMonoidHom.ker = f.toMonoidHom.ker :=
    MonoidHom.ker_comp_of_injective _ _ comparison.symm.injective
  rw [← hk]
  exact FivePrimary.not_five_dvd_card_kernel_carrier comparison g

/-- Application to the constructed universal covering used by the multiplier assembly. -/
public theorem not_five_dvd_universal_kernel (comparison : Carrier ≃* Model) :
    ¬ 5 ∣ Nat.card (universalProjection Model).ker :=
  not_five_dvd_card_kernel comparison (universalCover Model)

end Theory.SpecificGroups.McLaughlin.Multiplier
