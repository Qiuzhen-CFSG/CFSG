/-- Packed columns of the actual ambient generator selected by the producer. -/
def generatorColumns (b : Bool) : ℕ → ℕ := if b then columnsB else columnsA

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem columnsA_checked :
    allBelow 111 (fun k => columnsA k == encode 111 (generatorEntry false k)) = true := by
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem columnsB_checked :
    allBelow 111 (fun k => columnsB k == encode 111 (generatorEntry true k)) = true := by
  decide +kernel

/-- The external packing is verified against the fixed matrices. -/
theorem generatorColumns_eq_encode (b : Bool) (k : ℕ) (hk : k < 111) :
    generatorColumns b k = encode 111 (generatorEntry b k) := by
  cases b
  · exact beq_iff_eq.mp (allBelow_sound columnsA_checked k hk)
  · exact beq_iff_eq.mp (allBelow_sound columnsB_checked k hk)

theorem generatorEntry_le (b : Bool) (k i : ℕ) : generatorEntry b k i ≤ 4 := by
  unfold generatorEntry
  have := Nat.mod_lt ((if b then atlasBRows else atlasARows) (Fin.ofNat 111 i) / 5^k)
    (by decide : 0 < 5)
  omega
end Lyons.OrderCertificate.PlaneOrbitArithmetic
