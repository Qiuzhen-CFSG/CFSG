/-- The actual matrix orbit certificate, with no outstanding premises. -/
public def pairOrbitCertificate : PairOrbitCertificate where
  matrix := matrix
  injective := matrix_injective
  map_A k := by rw [image_A]; exact matrix_map_A k
  map_B k := by rw [image_B]; exact matrix_map_B k

