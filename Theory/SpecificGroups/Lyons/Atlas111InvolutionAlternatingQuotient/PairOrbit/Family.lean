/-!
# Fifty-five distinct matrices on unordered pairs

The family selects the saved matrices in lexicographic pair order. A finite
kernel check proves injectivity of the four-entry fingerprint in row zero;
equality of matrices then implies equality of their indices.

Source: GLS3 section 5.3, Lyons table, printed p.278. The attributed ATLAS
candidate data and their conventions are documented in `../source/README.md`.
-/

namespace Lyons.SimplicityCertificate.AlternatingQuotient.PairOrbit
open Atlas111WordCertificate

@[expose] public def matrix (k : Fin 55) : AtlasMatrix :=
  decode (![rows00, rows01, rows02, rows03, rows04, rows05, rows06, rows07, rows08, rows09, rows10, rows11, rows12, rows13, rows14, rows15, rows16, rows17, rows18, rows19, rows20, rows21, rows22, rows23, rows24, rows25, rows26, rows27, rows28, rows29, rows30, rows31, rows32, rows33, rows34, rows35, rows36, rows37, rows38, rows39, rows40, rows41, rows42, rows43, rows44, rows45, rows46, rows47, rows48, rows49, rows50, rows51, rows52, rows53, rows54] k)

private def fingerprint (k : Fin 55) : Fin 4 → ZMod 5 :=
  fun j => matrix k 0 ⟨j.val, lt_trans j.isLt (by decide)⟩

set_option maxRecDepth 10000 in
private theorem fingerprint_injective : Function.Injective fingerprint := by
  decide +kernel

public theorem matrix_injective : Function.Injective matrix := by
  intro i j h
  apply fingerprint_injective
  exact congrArg (fun M : AtlasMatrix => fun c : Fin 4 =>
    M 0 ⟨c.val, lt_trans c.isLt (by decide)⟩) h

end Lyons.SimplicityCertificate.AlternatingQuotient.PairOrbit
