module
public import Mathlib.GroupTheory.PresentedGroup

/-!
# The five-generator presentation from Gebhardt's Lyons construction

The three relator lists transcribe Section 3B, pp.335–336 of V. Gebhardt,
"Two Short Presentations for Lyons' Sporadic Simple Group", Experimental
Mathematics 9 (2000), 333–338, DOI 10.1080/10586458.2000.10504410.
The archival text is available at
https://www.maths.tcd.ie/EMIS/journals/EM/restricted/9/9.3/gebhardt.ps .

The alphabet is `a,b,c,d,z`, indexed by `0,1,2,3,4`. Capital letters mean
inverses, conjugation means `x^y = y⁻¹*x*y`, and the commutator means
`[x,y] = x⁻¹*y⁻¹*x*y`. Equations become relators `lhs * rhs⁻¹`.
The lists have 9, 7 and 9 entries, respectively; the distinguished subgroup
is generated by `a,b,c,d`. The source's generator names are unrelated to the
two ATLAS standard generators in `Atlas111Group`.

Three inverse marks in the outer relations were corrected against the printed
page; see `GebhardtMatrixSource/source-corrections.md` and its retained image.

This module defines a presented group, without asserting its order, simplicity,
or identification with the matrix group. A coset cover in this presentation
and a surjective realization in the matrices are separate proof obligations.
All word definitions are exposed for proof-producing enumeration and direct
relation checking. Spaces in the word strings serve only as visual separators.
-/

namespace Lyons.Gebhardt
@[expose] public section
abbrev Alphabet := Fin 5
/-- Decode the ten signed generator letters; separators contribute the identity. -/
def letter : Char → FreeGroup Alphabet
  | 'a' => FreeGroup.of 0 | 'A' => (FreeGroup.of 0)⁻¹
  | 'b' => FreeGroup.of 1 | 'B' => (FreeGroup.of 1)⁻¹
  | 'c' => FreeGroup.of 2 | 'C' => (FreeGroup.of 2)⁻¹
  | 'd' => FreeGroup.of 3 | 'D' => (FreeGroup.of 3)⁻¹
  | 'z' => FreeGroup.of 4 | 'Z' => (FreeGroup.of 4)⁻¹
  | _ => 1
/-- A written group word, with capital letters denoting inverses. -/
def word (s : String) : FreeGroup Alphabet := (s.toList.map letter).prod
/-- Right conjugation, the convention used in the source. -/
def conjugate (x y : FreeGroup Alphabet) := y⁻¹ * x * y
/-- The source commutator convention. -/
def commutatorWord (x y : FreeGroup Alphabet) := x⁻¹ * y⁻¹ * x * y
/-- Turn an equation into a relator. -/
def equationRelator (x y : FreeGroup Alphabet) := x * y⁻¹

/-- `R_H₂`: the five `R_H₃` relations followed by four more. -/
def parabolicRelators : List (FreeGroup Alphabet) := [
  word "a" ^ 8, word "b" ^ 5, word "ab" ^ 4,
  commutatorWord (word "aa") (word "b"), commutatorWord (word "a") (word "b") ^ 3,
  word "c" ^ 5,
  equationRelator (conjugate (word "c") (word "aa")) (word "ccc"),
  equationRelator (conjugate (word "c") (word "ba")) (conjugate (word "c") (word "aab") * word "cb cB"),
  equationRelator (conjugate (word "c") (word "bb")) (word "cc" * conjugate (word "c") (word "B") *
    (conjugate (word "c") (word "b"))⁻¹ ^ 2)]

/-- The seven additional `R_H₁` relations. -/
def localRelators : List (FreeGroup Alphabet) := [
  equationRelator (conjugate (word "aBa") (word "d")) (word "aBaaaaa"),
  equationRelator (conjugate (word "bbA") (word "d")) (word "AAbbA"),
  equationRelator (conjugate (word "baCbaBBa") (word "dcd")) (word "AbABaBBa cBcbaC"),
  equationRelator (conjugate (word "aaCbaCbAB") (word "dcd")) (word "AABA BcBcbb"),
  equationRelator (conjugate (word "bbacba") (word "dcAbcd")) (word "AbABA BBcABCba"),
  equationRelator (conjugate (word "aCCb") (word "dcAbcd")) (word "AAAAbb CBaBcaB"),
  word "cACaCAcaDCACacAcdcaCACacd"]

/-- The nine additional `R_G` relations. -/
def outerRelators : List (FreeGroup Alphabet) := [
  equationRelator (conjugate (word "a") (word "z")) (word "AAA"),
  equationRelator (conjugate (word "a") (word "zdz")) (word "aaa"),
  equationRelator (conjugate (word "CDcbabb cbcbCd") (word "zdz"))
    (word "Cbcc aCbDca CbCBB cA cDcbb cdaDCDcbAb"),
  equationRelator (commutatorWord (word "z") (word "DCbaBDcDCdCBaB cDcd")) (word "bcBC"),
  equationRelator (conjugate (word "a") (word "zdBz")) (word "ADC bCC aB cAbb cB cACdBA"),
  equationRelator (conjugate (word "CADCbaBaC bcaCDcdacBabac") (word "zdBz"))
    (word "AcAAA CBBCdCa Cbb cBcACdBCDCbabdcA"),
  equationRelator (conjugate (word "AbdcABabACBca") (word "zdcdz")) (word "CaaabCB A cDCbAB"),
  equationRelator (conjugate (word "DcbAB") (word "zdcdz")) (word "acAbaCbcaCBABabDcaCBCa"),
  word "aDCbAA DCBB CdC aCaC bAccB cDca cBaD ZbzBz"]

/-- The complete 25-relator set of Section 3B. -/
def relators : Set (FreeGroup Alphabet) :=
  {r | r ∈ parabolicRelators ++ localRelators ++ outerRelators}
/-- The abstract presented group; no finite-group identification is assumed. -/
abbrev Presentation := PresentedGroup relators
/-- Canonical generators of the presentation. -/
abbrev generator : Alphabet → Presentation := PresentedGroup.of

/-- The subgroup generated by the first four presentation generators. -/
def localSubgroup : Subgroup Presentation :=
  Subgroup.closure (generator '' {i | i.val < 4})

/-- The abstract presentation generators generate their group. -/
theorem closure_range_generator : Subgroup.closure (Set.range generator) = ⊤ :=
  PresentedGroup.closure_range_of relators

/-- Only the first four generator images need to be checked for subgroup inclusion. -/
theorem localSubgroup_map_le {G : Type*} [Group G]
    (f : Presentation →* G) (K : Subgroup G)
    (h : ∀ i : Alphabet, i.val < 4 → f (generator i) ∈ K) :
    localSubgroup.map f ≤ K := by
  rw [Subgroup.map_le_iff_le_comap]
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, hi, rfl⟩
  exact h i hi

end
end Lyons.Gebhardt
