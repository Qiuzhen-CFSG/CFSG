module

public import Theory.SpecificGroups.Lyons.GebhardtLocalTowerSetup
public import Theory.SpecificGroups.Lyons.GebhardtLocalBaseCertificate
import Mathlib.Data.ZMod.QuotientGroup
import Mathlib.Tactic.FinCases
/-!
# The order bound for Gebhardt's two-generator bottom subgroup

The first five literal relations of the 25-relator presentation yield the
certified sixty-coset cover in `GebhardtLocalBaseCertificate`. In the actual
subgroup generated by `a,b`, the cyclic subgroup generated by `a` is finite
of order at most eight. The cover therefore proves finiteness and the upper
bound `8 * 60 = 480`, without assuming a finite realization of the presentation.

Source: V. Gebhardt, "Two Short Presentations for Lyons' Sporadic Simple
Group", Experimental Mathematics 9 (2000), 333–338, Section 3B.
-/

namespace Lyons.Gebhardt
open Subgroup.CosetWordCertificate
private def baseGenerator (b : Bool) : LocalTower.base :=
  ⟨generator (if b then 1 else 0), LocalTower.generator_mem 2 _ (by cases b <;> decide)⟩
private theorem base_relators (r : Fin 5) :
    eval baseGenerator (BaseCertificate.relatorWord r) = 1 := by
  apply Subtype.ext
  have hi : r.val < parabolicRelators.length := by
    change r.val < 9
    omega
  have h := LocalTower.parabolicRelator_eq_one (parabolicRelators[r.val])
    (List.getElem_mem hi)
  fin_cases r <;>
    simpa [BaseCertificate.relatorWord, eval, FreeGroup.lift_mk, baseGenerator,
      parabolicRelators, word, letter, commutatorWord, map_mul, map_inv, map_pow,
      PresentedGroup.of, pow_succ, mul_assoc] using h
private theorem base_generates :
    Subgroup.closure (Set.range baseGenerator) = ⊤ := by
  apply Subgroup.map_injective LocalTower.base.subtype_injective
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  change Subgroup.closure _ = Subgroup.closure _
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨b, rfl⟩, rfl⟩
    exact ⟨(if b then 1 else 0), by cases b <;> decide, rfl⟩
  · rintro ⟨i, hi, rfl⟩
    have h : i = 0 ∨ i = 1 := by
      have : i.val < 2 := hi
      fin_cases i <;> simp_all
    rcases h with rfl | rfl
    · exact ⟨baseGenerator false, ⟨false, rfl⟩, rfl⟩
    · exact ⟨baseGenerator true, ⟨true, rfl⟩, rfl⟩
private theorem base_a_pow : baseGenerator false ^ 8 = 1 := by
  have h := base_relators 0
  simpa [BaseCertificate.relatorWord, eval, FreeGroup.lift_mk, pow_succ, mul_assoc] using h
/-- The two-generator bottom of the literal Gebhardt local tower is finite
and has order at most 480. -/
public theorem localTowerBase_finite_card_le : Finite LocalTower.base ∧ Nat.card LocalTower.base ≤ 480 := by
  have hf : IsOfFinOrder (baseGenerator false) :=
    isOfFinOrder_iff_pow_eq_one.mpr ⟨8, by decide, base_a_pow⟩
  have : Finite (Subgroup.zpowers (baseGenerator false)) := hf.finite_zpowers.to_subtype
  have hc := (BaseCertificate.cover baseGenerator (Subgroup.zpowers (baseGenerator false))
    (Subgroup.mem_zpowers _) base_relators).finite_card_le base_generates
  refine ⟨hc.1, hc.2.trans ?_⟩
  rw [Nat.card_zpowers, Nat.card_fin]
  exact Nat.mul_le_mul_right 60 (orderOf_le_of_pow_eq_one (by decide) base_a_pow)
end Lyons.Gebhardt
