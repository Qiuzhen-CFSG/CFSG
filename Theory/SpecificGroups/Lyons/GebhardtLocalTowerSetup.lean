module

public import Theory.SpecificGroups.Lyons.GebhardtPresentation
public import Mathlib.GroupTheory.Index

/-!
# The local subgroup tower in Gebhardt's presentation

The first two, three and four generators give the tower
`⟨a,b⟩ ≤ ⟨a,b,c⟩ ≤ ⟨a,b,c,d⟩`. This module fixes its subgroups in the
literal 25-relator presentation and provides relation and inclusion interfaces.
The order bound 480 and the two index bounds 3125 and 3906 are separate
mathematical obligations. Positive relative indices certify finite quotients;
an upper bound on the natural-number index alone would not do so.

Source: V. Gebhardt, "Two Short Presentations for Lyons' Sporadic Simple
Group", Experimental Mathematics 9 (2000), 333–338, Section 3B.
-/

namespace Lyons.Gebhardt.LocalTower
public section

/-- The subgroup generated by the first `n` canonical generators. -/
@[expose] def subgroup (n : ℕ) : Subgroup Presentation :=
  Subgroup.closure (generator '' {i | i.val < n})

/-- The two-generator bottom of the local tower. -/
abbrev base : Subgroup Presentation := subgroup 2

/-- The three-generator parabolic subgroup in the local tower. -/
abbrev parabolic : Subgroup Presentation := subgroup 3

theorem generator_mem (n : ℕ) (i : Alphabet) (hi : i.val < n) :
    generator i ∈ subgroup n :=
  Subgroup.subset_closure ⟨i, hi, rfl⟩

theorem subgroup_mono {m n : ℕ} (h : m ≤ n) : subgroup m ≤ subgroup n := by
  apply Subgroup.closure_mono
  rintro _ ⟨i, hi, rfl⟩
  exact ⟨i, lt_of_lt_of_le hi h, rfl⟩

theorem subgroup_four : subgroup 4 = localSubgroup := rfl

theorem base_le_parabolic : base ≤ parabolic := subgroup_mono (by decide)

theorem parabolic_le_local : parabolic ≤ localSubgroup := subgroup_mono (by decide)

/-- The first nine defining relations hold in the full presentation. -/
theorem parabolicRelator_eq_one (r : FreeGroup Alphabet) (hr : r ∈ parabolicRelators) :
    PresentedGroup.mk relators r = 1 := by
  apply PresentedGroup.one_of_mem
  simp only [relators, Set.mem_ofPred_eq, List.mem_append]
  exact Or.inl (Or.inl hr)

/-- The next seven defining relations hold in the full presentation. -/
theorem localRelator_eq_one (r : FreeGroup Alphabet) (hr : r ∈ localRelators) :
    PresentedGroup.mk relators r = 1 := by
  apply PresentedGroup.one_of_mem
  simp only [relators, Set.mem_ofPred_eq, List.mem_append]
  exact Or.inl (Or.inr hr)

end
end Lyons.Gebhardt.LocalTower
