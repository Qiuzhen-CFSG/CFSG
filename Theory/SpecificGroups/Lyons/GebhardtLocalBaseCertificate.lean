/-- An upper-bound certificate in every group satisfying the five relations. -/
public def cover {G : Type*} [Group G] (g : Bool → G) (H : Subgroup G)
    (ha : g false ∈ H) (hr : ∀ r : Fin 5, eval g (relatorWord r) = 1) :
    Subgroup.GeneratorCosetCover H g (Fin 60) :=
  generatorCosetCover survivor 0 (eval_nil g) destination (transitions g H ha hr)

