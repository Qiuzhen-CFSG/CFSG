private def representative {G : Type*} [Group G] (g : Bool → G) (i : Nat) : G :=
  eval g (representativeWord i)

private theorem eval_rotate {G : Type*} [Group G] (g : Bool → G)
    (w : Word Bool) (h : eval g w = 1) (n : Nat) :
    eval g (w.rotate n) = 1 := by
  simp only [eval, FreeGroup.lift_mk, List.map_rotate] at *
  exact List.prod_rotate_eq_one_of_prod_eq_one h n

private theorem relator_variant {G : Type*} [Group G] (g : Bool → G)
    (hr : ∀ r : Fin 5, eval g (relatorWord r) = 1)
    (r : Fin 5) (inv : Bool) (offset : Nat) :
    eval g ((if inv then FreeGroup.invRev (relatorWord r) else relatorWord r).rotate offset) = 1 := by
  apply eval_rotate
  cases inv
  · exact hr r
  · simp only [if_true, eval_invRev, hr, inv_one]

