/-- Packed coefficient vector of the annihilator polynomial. -/
@[expose] public def qPacked : ℕ := 

@[expose] public def coefficients (j : Fin 111) : ZMod 5 := (digit qPacked j.val : ZMod 5)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
public theorem q_small : small 111 qPacked = true := by
  decide +kernel

/-- Append the two independent coordinate functionals to the first 109 rows. -/
@[expose] public def nRows (i : Fin 111) : ℕ :=
  if i.val < 109 then rRows i else if i = 109 then oneRows 0 else oneRows 2

@[expose] public def nMatrix : AtlasMatrix := decode nRows

public theorem n_small (i : Fin 111) : small 111 (nRows i) = true := by
  unfold nRows
  split_ifs
  · exact r_small i
  · decide +kernel
  · decide +kernel

