module

public import Theory.SpecificGroups.Lyons.Atlas111Inverse
public import Mathlib.Data.Matrix.Basic
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# A concrete matrix model for the Lyons group

The carrier is the subgroup of invertible 111 × 111 matrices over `ZMod 5`
generated by the two fixed ATLAS matrices. Their inverse identities are proved
in `Atlas111Inverse`, so both generators are actual units. Finiteness follows
from the faithful inclusion into the finite matrix algebra. Noncommutativity
is witnessed by entry `(0, 0)` of the two generator products.

Source: R. A. Wilson et al., ATLAS of Finite Group Representations,
representation `LyG1-f5r111B0`,
https://brauer.maths.qmul.ac.uk/Atlas/v3/matrep/LyG1-f5r111B0
The original data, attribution and transcription script are in `Atlas111Source/`.

This module constructs the finite group and certifies noncommutativity. Its
order and simplicity require separate proofs about this fixed carrier.
-/

namespace Lyons

/-- The first ATLAS matrix, with a proved inverse. -/
@[expose] public def atlasA : AtlasMatrixˣ :=
  Units.mkOfMulEqOne atlasAMatrix atlasAInvMatrix atlasAMatrix_mul_inverse

/-- The second ATLAS matrix, with a proved inverse. -/
@[expose] public def atlasB : AtlasMatrixˣ :=
  Units.mkOfMulEqOne atlasBMatrix atlasBInvMatrix atlasBMatrix_mul_inverse

/-- The subgroup generated by the fixed ATLAS matrices. -/
@[expose] public def atlasSubgroup : Subgroup AtlasMatrixˣ :=
  Subgroup.closure {atlasA, atlasB}

/-- The fixed carrier for the Lyons matrix model. -/
@[expose] public def LyonsGroup : Type := atlasSubgroup
  deriving Group

public instance : Finite LyonsGroup :=
  Finite.of_injective (fun x : LyonsGroup => (x.val.val : AtlasMatrix))
    (fun _ _ h => Subtype.ext (Units.ext h))

public theorem atlasA_mem : atlasA ∈ atlasSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

public theorem atlasB_mem : atlasB ∈ atlasSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The first generator as an element of the concrete group. -/
@[expose] public def generatorA : LyonsGroup := ⟨atlasA, atlasA_mem⟩

/-- The second generator as an element of the concrete group. -/
@[expose] public def generatorB : LyonsGroup := ⟨atlasB, atlasB_mem⟩

/-- The faithful matrix representation furnished by the construction. -/
@[expose] public def matrixRepresentation : LyonsGroup →* AtlasMatrix where
  toFun x := x.val.val
  map_one' := rfl
  map_mul' _ _ := rfl

public theorem matrixRepresentation_injective : Function.Injective matrixRepresentation :=
  fun _ _ h => Subtype.ext (Units.ext h)

@[simp] public theorem matrixRepresentation_generatorA :
    matrixRepresentation generatorA = atlasAMatrix := rfl

@[simp] public theorem matrixRepresentation_generatorB :
    matrixRepresentation generatorB = atlasBMatrix := rfl

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem matrix_products_differ :
    (atlasAMatrix * atlasBMatrix) 0 0 ≠ (atlasBMatrix * atlasAMatrix) 0 0 := by
  decide +kernel

/-- The two specified generators do not commute. -/
public theorem generators_not_commute : generatorA * generatorB ≠ generatorB * generatorA := by
  intro h
  apply matrix_products_differ
  have hm := congrArg matrixRepresentation h
  simp only [map_mul, matrixRepresentation_generatorA, matrixRepresentation_generatorB] at hm
  exact congrArg (fun m : AtlasMatrix => m 0 0) hm

public instance : Nontrivial LyonsGroup :=
  ⟨⟨generatorA * generatorB, generatorB * generatorA, generators_not_commute⟩⟩

/-- The concrete matrix group is nonabelian. -/
public theorem not_isMulCommutative : ¬ IsMulCommutative LyonsGroup :=
  fun h => generators_not_commute (h.is_comm.comm generatorA generatorB)

end Lyons
