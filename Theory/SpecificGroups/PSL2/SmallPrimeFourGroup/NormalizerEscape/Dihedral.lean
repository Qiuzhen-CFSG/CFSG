module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Theory.GroupTheory.NormalizingInvolutionCard
public import Mathlib.GroupTheory.Subgroup.Simple
public import Mathlib.GroupTheory.IndexNormal
import Mathlib.Tactic

/-!
# Reflection centralizers in maximal odd dihedral pairs

For two involutions a,b, the powers of ab form the rotation subgroup and b
inverts it. The generated subgroup is the disjoint union of that subgroup
and its reflection coset. If its order is twice an odd number, only 1 and b
centralize b. In a simple ambient group a nontrivial maximal subgroup is
self-normalizing. Thus, in any faithful index-two overgroup, at most four
normalizer elements centralize the marked reflection.

This supplies the small-normalizer bound in Guralnick--Malle,
*Classification of 2F-modules I*, Proposition 4.1, manuscript pp.8--9.
-/

public section
open Subgroup
open scoped Pointwise
namespace Theory.PSL2.SmallPrimeFourGroup

/-- The reflection centralizer in a group generated by two involutions,
with order twice an odd number, is the reflection subgroup. -/
theorem pair_reflection_centralizer_le {G : Type*} [Group G] [Finite G]
    (a b : G) (ha : a ^ 2 = 1) (hb : b ^ 2 = 1)
    (hlarge : 4 < Nat.card (closure ({a, b} : Set G)))
    (hmod : Nat.card (closure ({a, b} : Set G)) % 4 = 2) :
    closure ({a, b} : Set G) ⊓ centralizer ({b} : Set G) ≤ zpowers b := by
  classical
  let R := zpowers (a * b)
  have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_left (by simpa [pow_two] using ha)
  have hbi : b⁻¹ = b := inv_eq_of_mul_eq_one_left (by simpa [pow_two] using hb)
  have hir : (MulAut.conj b) (a * b) = (a * b)⁻¹ := by
    change b * (a * b) * b⁻¹ = (a * b)⁻¹
    rw [mul_inv_rev, hai, hbi]
    calc
      _ = b * a * (b * b) := by group
      _ = b * a := by rw [← pow_two, hb, mul_one]
  have hinv (u : G) (hu : u ∈ R) : b * u * b⁻¹ = u⁻¹ := by
    obtain ⟨n, rfl⟩ := mem_zpowers_iff.mp hu
    change (MulAut.conj b) ((a * b) ^ n) = _
    rw [map_zpow, hir, inv_zpow]
  have hD : closure ({a, b} : Set G) = R ⊔ zpowers b := by
    apply le_antisymm
    · apply (closure_le _).mpr
      simp only [Set.insert_subset_iff, Set.singleton_subset_iff]
      have hbmem : b ∈ R ⊔ zpowers b := mem_sup_right (mem_zpowers b)
      refine ⟨?_, hbmem⟩
      have := mul_mem (mem_sup_left (mem_zpowers (a * b))) (inv_mem hbmem)
      simpa using this
    · apply sup_le
      · apply zpowers_le.mpr
        exact mul_mem (subset_closure (by simp)) (subset_closure (by simp))
      · exact zpowers_le.mpr (subset_closure (by simp))
  have hbR : b ∉ R := by
    intro hbin
    have hc : b * (a * b) = (a * b) * b :=
      congrArg Subtype.val (IsMulCommutative.is_comm.comm
        (⟨b, hbin⟩ : R) ⟨a * b, mem_zpowers _⟩)
    have hri : (a * b)⁻¹ = a * b := by
      rw [← hinv (a * b) (mem_zpowers _), hc]
      simp
    have hr2 : (a * b) ^ 2 = 1 := by
      rw [pow_two]
      exact mul_eq_one_iff_eq_inv.mpr hri.symm
    have heq : closure ({a, b} : Set G) = R := by
      rw [hD, sup_eq_left.mpr (zpowers_le.mpr hbin)]
    have hd : Nat.card R ∣ 2 := by
      rw [Nat.card_zpowers]
      exact orderOf_dvd_of_pow_eq_one hr2
    have hle := Nat.le_of_dvd (by decide : 0 < 2) hd
    rw [heq] at hlarge
    omega
  have hbN : b ∈ normalizer (R : Set G) := by
    rw [mem_normalizer_iff_map_conj_eq]
    apply eq_of_le_of_card_ge
    · rintro x ⟨u, hu, rfl⟩
      change b * u * b⁻¹ ∈ R
      rw [hinv u hu]
      exact inv_mem hu
    · rw [card_map_of_injective (MulAut.conj b).injective]
  have hcard : Nat.card (closure ({a, b} : Set G)) = 2 * Nat.card R := by
    rw [hD, card_sup_zpowers_of_normalizing_involution R b hb hbR hbN]
  have hodd : Odd (Nat.card R) := by
    rw [hcard] at hmod
    exact Nat.odd_iff.mpr (by omega)
  have hfixed (u : G) (hu : u ∈ R) (hc : u * b = b * u) : u = 1 := by
    have hui : u⁻¹ = u := by
      rw [← hinv u hu, ← hc]
      simp
    have hu2 : (⟨u, hu⟩ : R) ^ 2 = 1 := by
      apply Subtype.ext
      change u ^ 2 = 1
      rw [pow_two]
      exact mul_eq_one_iff_eq_inv.mpr hui.symm
    have hord : orderOf (⟨u, hu⟩ : R) ∣ 2 := orderOf_dvd_of_pow_eq_one hu2
    have hdiv := Nat.dvd_gcd (orderOf_dvd_natCard (⟨u, hu⟩ : R)) hord
    rw [hodd.coprime_two_right.gcd_eq_one] at hdiv
    have h1 := orderOf_eq_one_iff.mp (Nat.dvd_one.mp hdiv)
    exact congrArg Subtype.val h1
  have hcases (z : G) (hz : z ∈ zpowers b) : z = 1 ∨ z = b := by
    have hfin : IsOfFinOrder b := isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by decide, hb⟩
    have hb1 : b ≠ 1 := fun h => hbR (h ▸ R.one_mem)
    rw [hfin.mem_zpowers_iff_mem_range_orderOf, orderOf_eq_prime hb hb1] at hz
    obtain ⟨i, hi, hiz⟩ := Finset.mem_image.mp hz
    have hi2 := Finset.mem_range.mp hi
    have hi' : i = 0 ∨ i = 1 := by omega
    rcases hi' with rfl | rfl
    · exact Or.inl (by simpa using hiz.symm)
    · exact Or.inr (by simpa using hiz.symm)
  intro x hx
  have hxprod : x ∈ (R : Set G) * (zpowers b : Set G) := by
    rw [← coe_mul_of_right_le_normalizer_left R (zpowers b) (zpowers_le.mpr hbN)]
    exact hD ▸ hx.1
  obtain ⟨u, hu, v, hv, rfl⟩ := hxprod
  rcases hcases v hv with hv1 | hvb
  · rw [hv1] at hx ⊢
    simp only [mul_one] at hx ⊢
    have hu1 := hfixed u hu (mem_centralizer_singleton_iff.mp hx.2)
    rw [hu1]
    exact (zpowers b).one_mem
  · rw [hvb] at hx ⊢
    have hc := mem_centralizer_singleton_iff.mp hx.2
    have hub : u * b = b * u := by
      apply mul_right_cancel (b := b)
      simpa only [mul_assoc] using hc
    have hu1 := hfixed u hu hub
    simp [hu1]

/-- In an index-two overgroup of a simple group, the normalizer of a maximal
odd dihedral pair has at most four elements centralizing its reflection. -/
theorem pair_normalizer_centralizer_card_le_four
    {G H : Type*} [Group G] [Finite G] [IsSimpleGroup G] [Group H] [Finite H]
    (j : G →* H) (hj : Function.Injective j) (hi : j.range.index = 2)
    (a b : G) (ha2 : a ^ 2 = 1) (hb1 : b ≠ 1) (hb2 : b ^ 2 = 1)
    (hmax : IsCoatom (closure ({a, b} : Set G)))
    (hlarge : 4 < Nat.card (closure ({a, b} : Set G)))
    (hmod : Nat.card (closure ({a, b} : Set G)) % 4 = 2) :
    Nat.card (normalizer ((closure ({a, b} : Set G)).map j : Set H) ⊓
      centralizer ({j b} : Set H) : Subgroup H) ≤ 4 := by
  let D := closure ({a, b} : Set G)
  let W := normalizer (D.map j : Set H) ⊓ centralizer ({j b} : Set H)
  have hbD : b ∈ D := subset_closure (by simp)
  have hDN : normalizer (D : Set G) = D := by
    by_contra hne
    have ht : normalizer (D : Set G) = ⊤ :=
      hmax.lt_iff.mp (lt_of_le_of_ne D.le_normalizer (Ne.symm hne))
    have hn : D.Normal := normalizer_eq_top_iff.mp ht
    rcases hn.eq_bot_or_eq_top with hbot | htop
    · exact hb1 (mem_bot.mp (hbot ▸ hbD))
    · exact hmax.ne_top htop
  have hpre : W.comap j ≤ zpowers b := by
    intro x hx
    have hxn : x ∈ normalizer (D : Set G) := by
      have hx' : x ∈ (normalizer (D.map j : Set H)).comap j := hx.1
      rw [comap_normalizer_eq_of_le_range (D.map_le_range j),
        comap_map_eq_self_of_injective hj] at hx'
      exact hx'
    have hxc : x ∈ centralizer ({b} : Set G) := by
      apply mem_centralizer_singleton_iff.mpr
      apply hj
      simpa only [map_mul] using mem_centralizer_singleton_iff.mp hx.2
    apply pair_reflection_centralizer_le a b ha2 hb2 hlarge hmod
    constructor
    · change x ∈ D
      exact hDN.le hxn
    · exact hxc
  have hprecard : Nat.card (W.comap j) ≤ 2 := by
    have hh := card_le_of_le hpre
    rwa [Nat.card_zpowers, orderOf_eq_prime hb2 hb1] at hh
  let I := j.range
  let : I.Normal := I.normal_of_index_eq_two hi
  have hindex : (I.subgroupOf W).index ≤ 2 := by
    have hd : (I.subgroupOf W).index ∣ 2 := by
      simpa only [I, hi, relIndex] using I.relIndex_dvd_index_of_normal W
    exact Nat.le_of_dvd (by decide) hd
  have hcard : Nat.card (I.subgroupOf W) = Nat.card (W.comap j) := by
    calc
      _ = Nat.card ((I ⊓ W).subgroupOf W) := by rw [inf_subgroupOf_right]
      _ = Nat.card (I ⊓ W : Subgroup H) :=
        Nat.card_congr (subgroupOfEquivOfLe inf_le_right).toEquiv
      _ = Nat.card ((W.comap j).map j) := by rw [map_comap_eq]
      _ = Nat.card (W.comap j) := card_map_of_injective hj
  have hc := (I.subgroupOf W).card_mul_index
  rw [hcard] at hc
  change Nat.card W ≤ 4
  nlinarith

end Theory.PSL2.SmallPrimeFourGroup
