module
public import Theory.SpecificGroups.PSL2.AutomorphismModel
public import Mathlib.LinearAlgebra.Projectivization.PSL.PSL2

/-!
# Involution generation in characteristic-two PSL₂

Every transvection over a field of characteristic two is either the identity
or an involution. Transvection generation of SL₂ passes through the canonical
quotient and proves that all involutions generate PSL₂. This includes the
small field GF(2), where the group is S₃ and perfectness cannot be used.

Source application: GLS, volume 4, Chapter 2, Proposition 16.5, identifying
the distinguished circle of a common involution centralizer with the fixed
subgroup of a binary field involution.
-/

namespace Theory.PSL2
open Subgroup Matrix

/-- The characteristic-two projective group is generated by its involutions. -/
public theorem closure_involutions_eq_top
    (K : Type*) [Field K] [CharP K 2] :
    closure {x : Group K | orderOf x = 2} = ⊤ := by
  apply top_unique
  intro x _
  obtain ⟨A,rfl⟩ := quotientMap_surjective K x
  apply Matrix.SL2.transvection_induction
    (fun A => quotientMap K A ∈ closure {x : Group K | orderOf x = 2}) ?_ ?_ A
  · intro i j hij c
    by_cases hc : c = 0
    · subst c
      rw [SpecialLinearGroup.transvection_coeff_zero,map_one]
      exact one_mem _
    · apply subset_closure
      apply orderOf_eq_prime
      · rw [← map_pow,pow_two,← SpecialLinearGroup.transvection_add,
          CharTwo.add_self_eq_zero,SpecialLinearGroup.transvection_coeff_zero,map_one]
      · intro he
        have ht : SpecialLinearGroup.transvection hij c ∈
            center (SpecialLinearGroup (Fin 2) K) := (QuotientGroup.eq_one_iff _).mp he
        exact hc ((SpecialLinearGroup.transvection_mem_center_iff hij c).mp ht)
  · intro A B hA hB
    rw [map_mul]
    exact mul_mem hA hB

/-- Involution generation transported through an actual projective matrix model. -/
public theorem closure_involutions_eq_top_of_equiv
    {H K : Type*} [_root_.Group H] [Field K] [CharP K 2]
    (e : H ≃* Group K) : closure {x : H | orderOf x = 2} = ⊤ := by
  apply Subgroup.map_injective (f := e.toMonoidHom) e.injective
  rw [MonoidHom.map_closure,← MonoidHom.range_eq_map,MonoidHom.range_eq_top.mpr e.surjective]
  have himage : e.toMonoidHom '' {x : H | orderOf x = 2} = {x : Group K | orderOf x = 2} := by
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      exact (e.orderOf_eq y).trans hy
    · intro hx
      exact ⟨e.symm x,(e.symm.orderOf_eq x).trans hx,e.apply_symm_apply x⟩
  rw [himage]
  exact closure_involutions_eq_top K

end Theory.PSL2
