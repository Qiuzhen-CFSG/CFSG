module

public import Theory.SpecificGroups.PSL2.QuinticQuadraticRestriction
public import Theory.SpecificGroups.PSL2.QuadraticElementaryFieldLayer
public import GorensteinWalter.NormalPSL2ToPGammaL2Apply

/-!
# Whole quadratic field fusion in the actual normal-component extension

The prescribed normal PSL₂ model determines the semilinear conjugation
embedding. An elementary subgroup containing an element with nontrivial
coefficient action lies in the extension generated by that same element
and the original component. Restriction to this actual subgroup supplies
whole-subgroup fusion back into the original Sylow, outside the original
quintic two-core. No fixed-centralizer, diagonal, or subgroup-placement
hypothesis is supplied by a caller.

This proves the quadratic field-action row of the final paragraph of
Aschbacher--Smith 6.1.4, printed p.666.
-/

public section
open Subgroup GorensteinWalter
open scoped MatrixGroups
namespace Theory.PSL2

/-- The actual faithful conjugation action on a normal quadratic PSL₂
component gives a single inner conjugator for the entire elementary subgroup. -/
theorem quintic_quadratic_extension_whole_fusion
    {G : Type} [Group G] [Finite G]
    {F : Type} [Field F] [Finite F] {p : ℕ} [Fact p.Prime]
    (ho : Odd p) (hF : Nat.card F = p ^ 2)
    (N : Subgroup G) [N.Normal] (e : N ≃* PSL(2,F))
    (hC : centralizer (N : Set G) = ⊥)
    (T : Sylow 2 G) (X : Subgroup G) (hXN : X ≤ N) (hfive : Nat.card X = 5)
    (hTX : (T : Subgroup G) ≤ normalizer X)
    (A : Subgroup G) (hA : IsElementaryAbelian 2 A) (hAne : A ≠ ⊥)
    (hAT : A ≤ (T : Subgroup G)) (a : G) (haA : a ∈ A)
    (hf : let hodd : IsOddPrimePower (Nat.card F) := ⟨p, 2, Fact.out, ho, by decide, hF⟩
          let hc : 3 < Nat.card F := by
            have hp := (Fact.out : p.Prime).two_le; rw [hF]; nlinarith
          (normalPSL2ToPGammaL2 N F hodd hc e
            (pGammaL2ToMulAutPSL2_surjective F hF hodd hc) a).right ≠ 1) :
    ∃ g ∈ N, A.map (MulAut.conj g).toMonoidHom ≤ (T : Subgroup G) ∧
      ¬ A.map (MulAut.conj g).toMonoidHom ≤ (X ⊔ (T : Subgroup G)).pCoreIn 2 := by
  let hodd : IsOddPrimePower (Nat.card F) := ⟨p, 2, Fact.out, ho, by decide, hF⟩
  have hc : 3 < Nat.card F := by
    have hp := (Fact.out : p.Prime).two_le; rw [hF]; nlinarith
  let hs := pGammaL2ToMulAutPSL2_surjective F hF hodd hc
  let f := normalPSL2ToPGammaL2 N F hodd hc e hs
  have hfi : Function.Injective f := normalPSL2ToPGammaL2_injective N F hodd hc e hC hs
  have hfn (n : N) : f n = SemidirectProduct.inl
      (Matrix.ProjectiveSpecialLinearGroup.toPGL (e n)) :=
    normalPSL2ToPGammaL2_apply_subtype N F hodd hc e hs n
  have hNmap : N.map f = pGammaL2PSLRange F := by
    apply le_antisymm
    · rintro _ ⟨n, hn, rfl⟩
      rw [hfn ⟨n, hn⟩]
      exact ⟨e ⟨n, hn⟩, rfl⟩
    · rintro _ ⟨n, rfl⟩
      refine ⟨e.symm n, (e.symm n).property, ?_⟩
      rw [hfn]
      simp only [e.apply_symm_apply, MonoidHom.comp_apply]
  have hAH : A ≤ N ⊔ zpowers a := by
    apply (map_le_map_iff_of_injective (f := f) hfi).mp
    rw [Subgroup.map_sup, hNmap, MonoidHom.map_zpowers]
    let : IsElementaryAbelian 2 A := hA
    exact quadratic_elementary_le_inner_sup_field ho hF (A.map f)
      (IsElementaryAbelian.map f) (f a) (mem_map_of_mem f haA) hf
  have hx : orderOf (f a) = 2 := by
    apply orderOf_eq_prime_iff.mpr
    constructor
    · let : IsElementaryAbelian 2 A := hA
      rw [← map_pow, elemPow_eq_one_of_isElementaryAbelian a haA, map_one]
    · intro he
      exact hf (congrArg SemidirectProduct.right he)
  have hmark : MulAut.congr e (MulAut.conjNormal a) =
      pGammaL2ToMulAutPSL2 F hodd hc (f a) := by
    exact ((pGammaL2EquivMulAutPSL2 F hodd hc hs).apply_symm_apply _).symm
  exact quintic_quadratic_restricted_whole_fusion ho hF N e hC T X hXN hfive hTX
    A hA hAne a haA (hAT haA) hAH (f a) hx hf hmark

end Theory.PSL2
