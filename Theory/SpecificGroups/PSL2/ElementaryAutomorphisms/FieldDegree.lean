module

public import Theory.SpecificGroups.PSL2.ElementaryAutomorphisms.FieldAction
public import Mathlib.FieldTheory.Finite.GaloisField
/-!
# The fixed field of a nontrivial binary field involution

The cyclic group generated by the field involution has order two. The fixed
field theorem gives extension degree two, and cardinality then identifies the
fixed field with GF(2^m), with n = 2m and m positive. No simplicity restriction
is imposed on the smaller parameter; m = 1 is included.

Source: the finite-field input in GLS, Volume 4, Chapter 4, Lemma 3.4(c).
Adapted from the corresponding `BenderSuzuki.ZD.Linear` module; the
original campaign proofs are preserved. This extension has only Theory and
Mathlib imports and also supplies GLS, Volume 2, Theorem 26.24.
-/

namespace Theory.PSL2
public theorem binary_fixedField_model {n : ℕ} (hn : 0 < n)
    (σ : BinaryField n ≃+* BinaryField n)
    (hs : Function.Involutive σ) (hne : σ ≠ RingEquiv.refl _) :
    ∃ m : ℕ, 0 < m ∧ n = 2 * m ∧
      Nonempty (FixedBy.subfield (BinaryField n) σ ≃+* BinaryField m) := by
  let K := BinaryField n
  let H := Subgroup.zpowers σ
  let F := FixedPoints.subfield H K
  have ho : orderOf σ = 2 := orderOf_eq_prime (by ext x; exact hs x) hne
  have : Finite H := Finite.of_injective
    (fun g : H => (g.val : K → K)) (fun a b h => Subtype.ext (DFunLike.coe_injective h))
  let : Fintype H := Fintype.ofFinite H
  have hd : Module.finrank F K = 2 := by
    rw [FixedPoints.finrank_eq_card, Fintype.card_eq_nat_card, Nat.card_zpowers, ho]
  have hF : F = FixedBy.subfield K σ := by
    ext x
    change (∀ g : H, g • x = x) ↔ σ x = x
    constructor
    · intro hx
      exact hx ⟨σ, Subgroup.mem_zpowers σ⟩
    · intro hx g
      exact smul_eq_self_of_mem_zpowers g.property hx
  let : Fintype F := Fintype.ofFinite F
  obtain ⟨m, _, hm⟩ := FiniteField.card F 2
  have hcard : Nat.card K = 2 ^ (2 * (m : ℕ)) := by
    rw [Module.natCard_eq_pow_finrank (K := F), hd, Nat.card_eq_fintype_card, hm,
      ← pow_mul, Nat.mul_comm]
  have hnm : n = 2 * (m : ℕ) := by
    apply Nat.pow_right_injective (by decide : 1 < 2)
    exact (GaloisField.card 2 n (Nat.ne_of_gt hn)).symm.trans hcard
  have hm' : Nat.card (FixedBy.subfield K σ) = 2 ^ (m : ℕ) := by
    rw [← hF, Nat.card_eq_fintype_card, hm]
  let : Fintype (FixedBy.subfield K σ) := Fintype.ofFinite _
  let : Fintype (BinaryField m) := Fintype.ofFinite _
  refine ⟨m, m.pos, hnm, ⟨FiniteField.ringEquivOfCardEq ?_⟩⟩
  rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card, hm',
    GaloisField.card 2 (m : ℕ) m.ne_zero]
end Theory.PSL2

namespace Theory.PSL2

/-- For a nontrivial involution in characteristic two, the additive trace image
is exactly the fixed field. Thus the action has fixed points; the relevant
calculation is surjectivity onto them, not a fixed-point-free action. -/
public theorem fixed_iff_exists_add_conjugate {K : Type*} [Field K] [CharP K 2]
    (σ : K ≃+* K) (hs : Function.Involutive σ) (hne : σ ≠ RingEquiv.refl K)
    (x : K) : σ x = x ↔ ∃ y : K, y + σ y = x := by
  constructor
  · intro hx
    obtain ⟨t, ht⟩ : ∃ t, σ t ≠ t := by
      by_contra h
      apply hne
      ext t
      exact not_not.mp (not_exists.mp h t)
    have hd : t + σ t ≠ 0 := by
      intro h
      apply ht
      calc
        σ t = t + (t + σ t) := by rw [← add_assoc, CharTwo.add_self_eq_zero, zero_add]
        _ = t := by rw [h, add_zero]
    have hdσ : σ (t + σ t) = t + σ t := by rw [map_add, hs, add_comm]
    let u := t / (t + σ t)
    have hu : u + σ u = 1 := by
      dsimp [u]
      rw [map_div₀, hdσ, ← add_div, div_self hd]
    refine ⟨x * u, ?_⟩
    rw [map_mul, hx, ← mul_add, hu, mul_one]
  · rintro ⟨y, rfl⟩
    rw [map_add, hs, add_comm]

/-- The fixed field has the square-root cardinality, including the GF(2) case. -/
public theorem binary_fixedField_card {n : ℕ} (hn : 0 < n)
    (σ : BinaryField n ≃+* BinaryField n)
    (hs : Function.Involutive σ) (hne : σ ≠ RingEquiv.refl _) :
    Nat.card (FixedBy.subfield (BinaryField n) σ) = 2 ^ (n / 2) := by
  obtain ⟨m, hm, hnm, ⟨e⟩⟩ := binary_fixedField_model hn σ hs hne
  have hhalf : n / 2 = m := by omega
  rw [hhalf, Nat.card_congr e.toEquiv]
  exact GaloisField.card 2 m hm.ne'

/-- Nontrivial binary field involutions force an even field degree. -/
public theorem even_of_binary_field_involution {n : ℕ} (hn : 0 < n)
    (σ : BinaryField n ≃+* BinaryField n)
    (hs : Function.Involutive σ) (hne : σ ≠ RingEquiv.refl _) : Even n := by
  obtain ⟨m, _, hnm, _⟩ := binary_fixedField_model hn σ hs hne
  exact ⟨m, by omega⟩

end Theory.PSL2
