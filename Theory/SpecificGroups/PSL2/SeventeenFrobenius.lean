module

public import BenderSuzuki.Converse.PSL2
public import Theory.GroupTheory.NormalizedSupCard
public import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic

/-!
# The actual Frobenius subgroup of order 17·8 in PSL₂(17)

The root generator is the image of `!![1,1;0,1]`, and the complement
is generated by the image of `diag(6,3)`. The latter has projective order
eight and conjugates the root generator to its square. Thus the cyclic
subgroups of orders seventeen and eight form a subgroup of order 136.
Its complement acts without fixed points on the nonidentity kernel elements;
the only finite check is the eight possible powers modulo seventeen.

These are literal elements of the projective special linear matrix quotient.
The compatible-cover transfer and the degree-eight Jordan calculations used
in K.2 remain separate from this construction.

Source: Guralnick--Malle, *Classification of 2F-modules I*, Proposition 4.1,
manuscript p.9; Aschbacher--Smith K.2, printed p.453.
-/

public section
open Matrix Subgroup BenderSuzuki.Converse BenderSuzuki.MatrixGroups
namespace Theory.PSL2.SeventeenFrobenius
local instance : Fact (Nat.Prime 17) := ⟨by decide⟩
abbrev F := ZMod 17
abbrev Model := Matrix.ProjectiveSpecialLinearGroup (Fin 2) F
private def complementLift : Matrix.SpecialLinearGroup (Fin 2) F :=
  ⟨!![6, 0; 0, 3], by norm_num [Matrix.det_fin_two]; decide⟩
noncomputable def root : Model := BenderSuzuki.Converse.pi F (uni 1)
noncomputable def generator : Model := BenderSuzuki.Converse.pi F complementLift

private lemma uni_pow (a : F) (n : ℕ) : uni a ^ n = uni (n * a) := by
  induction n with
  | zero => simp [uni_zero]
  | succ n ih => rw [pow_succ, ih, uni_mul_uni]; congr 1; push_cast; ring

lemma root_order : orderOf root = 17 := by
  apply orderOf_eq_prime
  · rw [root, ← map_pow, uni_pow]
    rw [show (↑(17 : ℕ) : F) * 1 = 0 by decide, uni_zero, map_one]
  · intro hx
    have hc : uni (1 : F) ∈ center (Matrix.SpecialLinearGroup (Fin 2) F) :=
      (QuotientGroup.eq_one_iff _).mp hx
    obtain ⟨a, _, he⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hc
    have h01 := congrArg (fun m : Matrix (Fin 2) (Fin 2) F => m 0 1) he
    norm_num at h01

lemma generator_pow_eight : generator ^ 8 = 1 := by
  rw [generator, ← map_pow]
  apply (QuotientGroup.eq_one_iff _).mpr
  apply Matrix.SpecialLinearGroup.mem_center_iff.mpr
  refine ⟨-1, by norm_num, ?_⟩
  change Matrix.scalar (Fin 2) (-1 : F) = (complementLift ^ 8).val
  decide

lemma generator_pow_four_ne_one : generator ^ 4 ≠ 1 := by
  intro he
  rw [generator, ← map_pow] at he
  have hc := (QuotientGroup.eq_one_iff (complementLift ^ 4)).mp he
  obtain ⟨a, _, he⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hc
  have h00 := congrArg (fun m : Matrix (Fin 2) (Fin 2) F => m 0 0) he
  have h11 := congrArg (fun m : Matrix (Fin 2) (Fin 2) F => m 1 1) he
  have hne : (complementLift ^ 4).val 0 0 ≠ (complementLift ^ 4).val 1 1 := by decide
  apply hne
  exact (by simpa using h00.symm.trans h11)

lemma generator_order : orderOf generator = 8 :=
  orderOf_eq_prime_pow (p := 2) (n := 2) generator_pow_four_ne_one generator_pow_eight

lemma generator_conjugates_root : generator * root * generator⁻¹ = root ^ 2 := by
  change BenderSuzuki.Converse.pi F complementLift * BenderSuzuki.Converse.pi F (uni 1) *
    (BenderSuzuki.Converse.pi F complementLift)⁻¹ = (BenderSuzuki.Converse.pi F (uni 1)) ^ 2
  rw [← map_inv, ← map_mul, ← map_mul, ← map_pow, uni_pow,
    Borel_conj_uni (show complementLift ∈ Borel F by rw [mem_Borel_iff]; rfl)]
  congr 2


/-- The cyclic root subgroup of order seventeen. -/
noncomputable def kernel : Subgroup Model := zpowers root

instance kernel_commutative : IsMulCommutative kernel := by
  exact Subgroup.zpowers_isMulCommutative root
/-- The cyclic split-torus complement of order eight. -/
noncomputable def complement : Subgroup Model := zpowers generator
/-- The concrete subgroup generated by the root and torus actors. -/
noncomputable def borel : Subgroup Model := kernel ⊔ complement

lemma kernel_card : Nat.card kernel = 17 := by rw [kernel, Nat.card_zpowers, root_order]
lemma complement_card : Nat.card complement = 8 := by rw [complement, Nat.card_zpowers, generator_order]

lemma complement_normalizes : complement ≤ normalizer (kernel : Set Model) := by
  rw [complement, zpowers_le, mem_normalizer_iff_map_conj_eq, kernel,
    MonoidHom.map_zpowers]
  change zpowers (generator * root * generator⁻¹) = zpowers root
  rw [generator_conjugates_root]
  apply le_antisymm
  · exact zpowers_le.mpr (npow_mem_zpowers root 2)
  · apply zpowers_le.mpr
    have he : (root ^ 2) ^ 9 = root := by
      rw [← pow_mul, show 2 * 9 = 17 + 1 by decide, pow_add,
        show root ^ 17 = 1 by simpa only [root_order] using pow_orderOf_eq_one root, pow_one, one_mul]
    have hm := npow_mem_zpowers (root ^ 2) 9
    rw [he] at hm
    exact hm

lemma borel_card : Nat.card borel = 136 := by
  rw [borel, card_sup_eq_mul_of_normalizes_of_disjoint kernel complement
    complement_normalizes (disjoint_of_coprime_natCard (by rw [kernel_card, complement_card]; decide)),
    kernel_card, complement_card]

lemma generator_pow_conjugates_root (i : ℕ) : generator ^ i * root * (generator ^ i)⁻¹ = root ^ (2 ^ i) := by
  induction i with
  | zero => simp
  | succ i ih =>
    calc
      generator ^ (i + 1) * root * (generator ^ (i + 1))⁻¹ =
          generator * (generator ^ i * root * (generator ^ i)⁻¹) * generator⁻¹ := by rw [pow_succ']; group
      _ = generator * root ^ (2 ^ i) * generator⁻¹ := by rw [ih]
      _ = (generator * root * generator⁻¹) ^ (2 ^ i) := map_pow (MulAut.conj generator) root (2 ^ i)
      _ = root ^ (2 ^ (i + 1)) := by rw [generator_conjugates_root, ← pow_mul, pow_succ']

/-- Every nonidentity complement element fixes only the identity in the kernel. -/
lemma complement_free (c : complement) (hc : c ≠ 1) (k : kernel)
    (hfix : (c : Model) * k * (c : Model)⁻¹ = k) : k = 1 := by
  classical
  obtain ⟨i, hi, hci⟩ := Finset.mem_image.mp
    (mem_zpowers_iff_mem_range_orderOf.mp c.property)
  obtain ⟨j, hj, hkj⟩ := Finset.mem_image.mp
    (mem_zpowers_iff_mem_range_orderOf.mp k.property)
  have hi8 : i < 8 := by simpa only [Finset.mem_range, generator_order] using hi
  have hj17 : j < 17 := by simpa only [Finset.mem_range, root_order] using hj
  have hi0 : i ≠ 0 := by
    intro h
    apply hc
    apply Subtype.ext
    change (c : Model) = 1
    simpa only [h, pow_zero] using hci.symm
  have he : root ^ (2 ^ i * j) = root ^ j := by
    have hh := map_pow (MulAut.conj (generator ^ i)) root j
    change generator ^ i * root ^ j * (generator ^ i)⁻¹ = (generator ^ i * root * (generator ^ i)⁻¹) ^ j at hh
    rw [generator_pow_conjugates_root, ← pow_mul] at hh
    rw [← hci, ← hkj] at hfix
    exact hh.symm.trans hfix
  have hm : (2 ^ i * j) % 17 = j := by
    have hh := (pow_eq_pow_iff_modEq.mp he)
    change (2 ^ i * j) % orderOf root = j % orderOf root at hh
    rwa [root_order, Nat.mod_eq_of_lt hj17] at hh
  have hnum : ∀ i : Fin 8, i.val ≠ 0 → ∀ j : Fin 17,
      (2 ^ i.val * j.val) % 17 = j.val → j.val = 0 := by decide
  have hj0 : j = 0 := hnum ⟨i, hi8⟩ hi0 ⟨j, hj17⟩ hm
  apply Subtype.ext
  change (k : Model) = 1
  rw [← hkj, hj0, pow_zero]
end Theory.PSL2.SeventeenFrobenius
