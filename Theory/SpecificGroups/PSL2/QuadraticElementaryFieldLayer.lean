module

public import Theory.SpecificGroups.PSL2.SquareFieldInvolutionLayers
public import Theory.ElementaryAbelian.Basic

/-!
# Whole elementary subgroups containing a quadratic field involution

In an odd quadratic semilinear group, an elementary subgroup containing a
field involution lies in the subgroup generated by that involution and the
canonical inner PSL₂. Indeed every field involution has inner linear part;
applying this also to its products with the linear elements of the elementary
subgroup removes their possible diagonal coordinate. The coefficient group
has order two, so the entire outer image is the marked field line.

This keeps the full elementary subgroup in the final fusion step of
Aschbacher--Smith 6.1.4, printed p.666.
-/

public section
open Subgroup GorensteinWalter
open scoped MatrixGroups
namespace Theory.PSL2

/-- A quadratic field involution captures the full elementary subgroup in
its extension of the original canonical inner component. -/
theorem quadratic_elementary_le_inner_sup_field
    {F : Type*} [Field F] [Finite F] {p : ℕ} [Fact p.Prime]
    (ho : Odd p) (hF : Nat.card F = p ^ 2)
    (A : Subgroup (PGammaL2 F)) (hA : IsElementaryAbelian 2 A)
    (a : PGammaL2 F) (ha : a ∈ A) (hf : a.right ≠ 1) :
    A ≤ pGammaL2PSLRange F ⊔ zpowers a := by
  let hodd : IsOddPrimePower (Nat.card F) := ⟨p, 2, Fact.out, ho, by decide, hF⟩
  let : Fact (IsOddPrimePower (Nat.card F)) := ⟨hodd⟩
  let : IsElementaryAbelian 2 A := hA
  let J := (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := F)).range
  let q := pGammaL2OuterProduct F
  have hfield (b : PGammaL2 F) (hb : b ∈ A) (hbf : b.right ≠ 1) :
      (q b).1 = 1 := by
    have hb1 : b ≠ 1 := fun he => hbf (congrArg SemidirectProduct.right he)
    have hbo : orderOf b = 2 := orderOf_eq_prime_iff.mpr
      ⟨elemPow_eq_one_of_isElementaryAbelian b hb, hb1⟩
    exact (QuotientGroup.eq_one_iff b.left).mpr
      (semilinear_involution_left_mem_psl hodd b hbo hbf)
  have hqa : (q a).1 = 1 := hfield a ha hf
  have hlinear (b : PGammaL2 F) (hb : b ∈ A) : (q b).1 = 1 := by
    by_cases hbf : b.right = 1
    · have hab : (a * b).right ≠ 1 := by
        simpa only [SemidirectProduct.mul_right, hbf, mul_one] using hf
      have hh := hfield (a * b) (A.mul_mem ha hb) hab
      rw [map_mul, Prod.fst_mul, hqa, one_mul] at hh
      exact hh
    · exact hfield b hb hbf
  have hker : q.ker = pGammaL2PSLRange F := pGammaL2OuterProduct_ker F
  intro b hb
  by_cases hbf : b.right = 1
  · apply (show pGammaL2PSLRange F ≤ pGammaL2PSLRange F ⊔ zpowers a from le_sup_left)
    rw [← hker]
    apply MonoidHom.mem_ker.mpr
    exact Prod.ext (hlinear b hb) hbf
  · obtain ⟨z, _, hz⟩ := (Nat.card_eq_two_iff' (1 : F ≃+* F)).mp
        (FiniteField.card_ringAut_of_card_prime_pow (Fact.out : p.Prime) hF)
    have hba : b.right = a.right := (hz b.right hbf).trans (hz a.right hf).symm
    have hqba : q b = q a := Prod.ext ((hlinear b hb).trans hqa.symm) hba
    have hc : b * a⁻¹ ∈ pGammaL2PSLRange F := by
      rw [← hker]
      apply MonoidHom.mem_ker.mpr
      rw [map_mul, map_inv, hqba, mul_inv_cancel]
    have hc' := (show pGammaL2PSLRange F ≤ pGammaL2PSLRange F ⊔ zpowers a from le_sup_left) hc
    have ha' := (show zpowers a ≤ pGammaL2PSLRange F ⊔ zpowers a from le_sup_right) (mem_zpowers a)
    simpa only [inv_mul_cancel_right] using (pGammaL2PSLRange F ⊔ zpowers a).mul_mem hc' ha'

end Theory.PSL2
