private theorem coords_complete_check : ∀ a b c d e f : ZMod 3,
    quadratic ![a,b,c,d,e,f] = -1 →
    coords (lookup ![a,b,c,d,e,f]) = ![a,b,c,d,e,f] ∨
      coords (lookup ![a,b,c,d,e,f]) = -![a,b,c,d,e,f] := by
  decide +kernel

theorem coords_complete (v : Space) (hv : quadratic v = -1) :
    ∃ i, coords i = v ∨ coords i = -v := by
  have he : ![v 0,v 1,v 2,v 3,v 4,v 5] = v := by
    funext i; fin_cases i <;> rfl
  refine ⟨lookup v, ?_⟩
  simpa only [he] using coords_complete_check (v 0) (v 1) (v 2) (v 3) (v 4) (v 5)
    (by simpa only [he] using hv)
