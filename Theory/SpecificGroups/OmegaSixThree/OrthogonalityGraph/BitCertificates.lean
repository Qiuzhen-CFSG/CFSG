def common (i j : Fin 117) : BitVec 117 := rows i &&& rows j

def entry (i j : Fin 117) (k : Nat) : Fin 117 :=
  ⟨((witnesses i >>> (56*j.val + 7*k)) % 128) % 117, Nat.mod_lt _ (by decide)⟩
def root (i j : Fin 117) : Fin 117 := entry i j 0
def second (i j : Fin 117) : Fin 117 := entry i j 1
def witness (i j : Fin 117) (k : Fin 6) : Fin 117 := entry i j (k.val + 2)
def cover (f : Fin 6 → Fin 117) : BitVec 117 :=
  (List.finRange 6).foldr (fun k b => rows (f k) ||| b) 0

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem root_check : ∀ i j : Fin 117, (common i j).getLsbD (root i j) = true := by
  intro i
  fin_cases i <;> decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem centers_check : ∀ i j : Fin 117, i ≠ j → (rows i).getLsbD j = false →
    (common i j &&& rows (root i j)).getLsbD (second i j) = true ∧
    common i j &&& (rows (root i j) ||| rows (second i j)) = common i j := by
  intro i
  fin_cases i <;> decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem edge_check : ∀ i j : Fin 117, (rows i).getLsbD j = true →
    (∀ k, (common i j).getLsbD (witness i j k) = true) ∧
    cover (witness i j) = BitVec.allOnes 117 := by
  intro i
  fin_cases i <;> decide +kernel
end OmegaSixThree.OrthogonalityGraph.Certificate
