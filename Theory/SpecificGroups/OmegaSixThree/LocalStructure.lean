module

public import Theory.LinearAlgebra.QuadraticForm.SixTernaryCoordinates
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.Tactic.FinCases

/-!
# The concrete six-dimensional ternary orthogonal model

This file records the elementary part of the `D₃(3)` model used in §F.5 of
Aschbacher--Smith.  The ambient group is defined directly as the subgroup of
linear equivalences preserving the displayed diagonal quadratic function, and
`omegaPlusSixThree` is its derived subgroup.  In particular, no isomorphism or
transitivity assertion is built into a structure: all membership statements
below are proved from the coordinate formula.

The definitions are deliberately independent of the algebraic-group model.
They are useful for the local calculations in F.5.1--F.5.3 and for consumers
which only need the concrete action on the natural six-dimensional module.
-/

@[expose] public section

namespace OmegaSixThree

open SixTernaryCoordinates
open scoped commutatorElement

abbrev Space := SixTernaryCoordinates.Space
abbrev LinearGroup := Space ≃ₗ[ZMod 3] Space

/-! ## The orthogonal and Omega subgroups -/

/-- The full subgroup of linear equivalences preserving the diagonal form. -/
def orthogonalGroup : Subgroup LinearGroup where
  carrier := {g | ∀ v, quadratic (g v) = quadratic v}
  one_mem' := by intro v; rfl
  mul_mem' := by
    intro g h hg hh v
    rw [LinearEquiv.mul_apply, hg, hh]
  inv_mem' := by
    intro g hg v
    have h := hg (g⁻¹ v)
    simpa using h.symm

@[simp] theorem mem_orthogonalGroup_iff (g : LinearGroup) :
    g ∈ orthogonalGroup ↔ ∀ v, quadratic (g v) = quadratic v := Iff.rfl

/-- The derived subgroup of the concrete plus-type orthogonal group. -/
def commutatorWord (a b : LinearGroup) : LinearGroup :=
  a * b * a⁻¹ * b⁻¹

def omegaPlusSixThree : Subgroup LinearGroup :=
  Subgroup.closure {g | ∃ a b : LinearGroup, a ∈ orthogonalGroup ∧
    b ∈ orthogonalGroup ∧ commutatorWord a b = g}

theorem omegaPlusSixThree_le_orthogonalGroup :
    omegaPlusSixThree ≤ orthogonalGroup :=
  (by
    change Subgroup.closure _ ≤ orthogonalGroup
    apply (Subgroup.closure_le orthogonalGroup).2
    rintro g ⟨a, b, ha, hb, rfl⟩
    dsimp [commutatorWord]
    exact orthogonalGroup.mul_mem (orthogonalGroup.mul_mem
      (orthogonalGroup.mul_mem ha hb) (orthogonalGroup.inv_mem ha))
      (orthogonalGroup.inv_mem hb))

theorem signChange_mem_orthogonalGroup (J : Finset (Fin 6)) :
    signChange J ∈ orthogonalGroup := by
  rw [mem_orthogonalGroup_iff]
  intro v
  exact quadratic_signChange J v

theorem graphInvolution_mem_orthogonalGroup :
    graphInvolution ∈ orthogonalGroup := by
  rw [mem_orthogonalGroup_iff]
  intro v
  exact quadratic_graphInvolution v

theorem graphInvolution_sq : graphInvolution * graphInvolution = 1 := by
  ext v i
  fin_cases i <;> simp [LinearEquiv.mul_apply, graphInvolution_apply]

theorem commutatorWord_mem_omegaPlusSixThree {a b : LinearGroup}
    (ha : a ∈ orthogonalGroup) (hb : b ∈ orthogonalGroup) :
    commutatorWord a b ∈ omegaPlusSixThree := by
  apply Subgroup.subset_closure
  exact ⟨a, b, ha, hb, rfl⟩

theorem pairSignChange_mem_omegaPlusSixThree :
    signChange {0, 1} ∈ omegaPlusSixThree := by
  have h0 : signChange ({0, 2} : Finset (Fin 6)) ∈ orthogonalGroup :=
    signChange_mem_orthogonalGroup _
  have hg : graphInvolution ∈ orthogonalGroup := graphInvolution_mem_orthogonalGroup
  apply Subgroup.subset_closure
  refine ⟨signChange {0, 2}, graphInvolution, h0, hg, ?_⟩
  change ⁅signChange ({0, 2} : Finset (Fin 6)), graphInvolution⁆ = signChange {0, 1}
  rw [commutator_signChange_graphInvolution]
  simp only [show ¬((0 ∈ ({0, 2} : Finset (Fin 6))) ↔
      (1 ∈ ({0, 2} : Finset (Fin 6)))) by decide, if_false]

theorem signChange_graphInvolution_commute_iff (J : Finset (Fin 6)) :
    Commute (signChange J) graphInvolution ↔ (0 ∈ J ↔ 1 ∈ J) :=
  commute_signChange_graphInvolution_iff J

/-! ## The monomial 2-subgroup -/

/-- The subgroup generated by the even sign changes fixing the last coordinate.

This is the concrete `Q̇₂` from F.5.2.1.  We retain the closure presentation
because it is stable under the ambient linear-group coercions and exposes the
source's central-product calculations without choosing coordinates for a
quotient.
-/
def qTwo : Subgroup LinearGroup :=
  Subgroup.closure {g | ∃ J : Finset (Fin 6),
    5 ∉ J ∧ Even J.card ∧ g = signChange J}

theorem qTwo_le_orthogonalGroup : qTwo ≤ orthogonalGroup := by
  change Subgroup.closure _ ≤ orthogonalGroup
  apply (Subgroup.closure_le orthogonalGroup).2
  rintro g ⟨J, h5, heven, rfl⟩
  exact signChange_mem_orthogonalGroup J

theorem qTwo_commutator_graph_closure :
    Subgroup.closure {g : LinearGroup | ∃ J : Finset (Fin 6),
      5 ∉ J ∧ Even J.card ∧ ⁅signChange J, graphInvolution⁆ = g} =
      Subgroup.closure {signChange {0, 1}} := by
  exact commutator_closure

theorem qTwo_contains_pairSignChange : signChange {0, 1} ∈ qTwo := by
  apply Subgroup.subset_closure
  refine ⟨{0, 1}, ?_, ?_, rfl⟩ <;> decide

theorem signChange_mul_commute (J K : Finset (Fin 6)) :
    signChange J * signChange K = signChange K * signChange J := by
  ext v i
  by_cases hJ : i ∈ J <;> by_cases hK : i ∈ K <;>
    simp [LinearEquiv.mul_apply, signChange_apply, hJ, hK]

theorem qTwo_isMulCommutative : IsMulCommutative qTwo := by
  apply Subgroup.isMulCommutative_closure
  rintro g ⟨J, hJ5, hJeven, rfl⟩ h ⟨L, hL5, hLeven, rfl⟩
  exact signChange_mul_commute J L

/-! ## The standard F.5.1 and F.5.8 coordinates -/

def e (i : Fin 6) : Space := Pi.single i 1

def standardTriple : Finset Space :=
  {e 5, (e 0 - e 1), (e 0 + e 1)}

/-- The polar orthogonality relation for the displayed diagonal form.  The
factor `2` in the polar form is omitted; over `ZMod 3` this does not change
its zero set. -/
def bilinear (v w : Space) : ZMod 3 :=
  v 0 * w 0 + v 1 * w 1 + v 2 * w 2 + v 3 * w 3 + v 4 * w 4 - v 5 * w 5

theorem standardTriple_pairwise_bilinear_zero :
    bilinear (e 5) (e 0 - e 1) = 0 ∧
      bilinear (e 5) (e 0 + e 1) = 0 ∧
      bilinear (e 0 - e 1) (e 0 + e 1) = 0 := by
  simp [bilinear, e]

theorem quadratic_e (i : Fin 6) (hi : i ≠ 5) : quadratic (e i) = 1 := by
  fin_cases i <;> simp_all [quadratic, e]

theorem quadratic_e5 : quadratic (e 5) = -1 := by
  decide

theorem standardTriple_pairwise_orthogonal :
    (e 5) 0 = 0 ∧
      (e 0 - e 1) 1 = -1 ∧
      (e 0 + e 1) 1 = 1 := by
  simp [e]

theorem standardTriple_mem_normMinusOne :
    e 5 ∈ {v : Space | quadratic v = -1} ∧
      e 0 - e 1 ∈ {v : Space | quadratic v = -1} ∧
      e 0 + e 1 ∈ {v : Space | quadratic v = -1} := by
  simp [quadratic, e]
  decide

theorem standardTriple_isMutuallyOrthogonal :
    quadratic (e 5) = -1 ∧ quadratic (e 0 - e 1) = -1 ∧
      quadratic (e 0 + e 1) = -1 ∧
      bilinear (e 5) (e 0 - e 1) = 0 ∧
      bilinear (e 5) (e 0 + e 1) = 0 ∧
      bilinear (e 0 - e 1) (e 0 + e 1) = 0 := by
  have hq := standardTriple_mem_normMinusOne
  have hb := standardTriple_pairwise_bilinear_zero
  rcases hq with ⟨hq5, hq1, hq2⟩
  rcases hb with ⟨hb1, hb2, hb3⟩
  exact ⟨hq5, hq1, hq2, hb1, hb2, hb3⟩

theorem standardTriple_distinct :
    e 5 ≠ e 0 - e 1 ∧ e 5 ≠ e 0 + e 1 ∧ e 0 - e 1 ≠ e 0 + e 1 := by
  constructor
  · intro h
    have := congrFun h 5
    simp [e] at this
  constructor
  · intro h
    have := congrFun h 5
    simp [e] at this
  · intro h
    have := congrFun h 1
    have hn : (-1 : ZMod 3) ≠ 1 := by decide
    exact hn (by simpa [e] using this)

/-! ## Small, reusable local consequences -/

theorem graphInvolution_fixed_coordinates (v : Space) :
    graphInvolution v = v ↔ v 0 = v 1 ∧ v 5 = 0 :=
  graphInvolution_fixed_iff v

theorem graphInvolution_neg_coordinates (v : Space) :
    graphInvolution v = -v ↔
      v 1 = -v 0 ∧ v 2 = 0 ∧ v 3 = 0 ∧ v 4 = 0 :=
  graphInvolution_neg_iff v

end OmegaSixThree
