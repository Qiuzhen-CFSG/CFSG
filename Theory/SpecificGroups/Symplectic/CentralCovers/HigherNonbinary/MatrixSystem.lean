module

public import Theory.SpecificGroups.PSp4Three.ProjectiveGeometry
public import Mathlib.Algebra.CharP.Two
public import Mathlib.GroupTheory.IsPerfect

/-!
# The matrix amalgam for nonbinary symplectic central covers

The nodes are the simple-root SL₂ subgroups in the literal symplectic
matrix group. A short-root element is written as a product of three
commuting transvections; the last node is the long-root hyperbolic plane.
The two-node groups are their joins, with the actual subgroup inclusions.

Central matrices are scalar, and in characteristic two their scalar is
one. Thus the natural central quotient is an isomorphism, with its
projection formula recorded explicitly. This comparison alone makes no
assertion about universal central covers.

These definitions fix the matrix conventions for the rank-two presentation
and local splitting steps toward GLS3 §6.1, Theorem 6.1.4, type C in even
characteristic. The amalgam route is the Curtis–Tits presentation of GLS3
§2.9. The transvection implementation is the existing ATLAS-attributed
port in `PSp4Three`, valid in every rank and field universe.
-/

@[expose] public noncomputable section

open Matrix Matrix.PSp4Three Subgroup

namespace Theory.SpecificGroups.Symplectic.CentralCovers.HigherNonbinary

variable {r : ℕ} {F : Type*} [Field F]

/-- The short-root matrix with action
`eⱼ ↦ eⱼ + t eᵢ`, `fᵢ ↦ fᵢ - t fⱼ` when `i ≠ j`. -/
def shortRoot (i j : Fin r) (t : F) : Sp r F :=
  transvection (e i + f j) t * transvection (e i) (-t) * transvection (f j) (-t)

/-- Positive simple-root elements, ordered along the type-C diagram. -/
def positiveRoot (i : Fin r) (t : F) : Sp r F :=
  if h : i.val + 1 < r then shortRoot i ⟨i.val + 1, h⟩ t
  else transvection (e i) t

/-- Negative simple-root elements in the same matrix convention. -/
def negativeRoot (i : Fin r) (t : F) : Sp r F :=
  if h : i.val + 1 < r then shortRoot ⟨i.val + 1, h⟩ i t
  else transvection (f i) t

/-- The actual subgroup generated by an opposite pair of simple roots. -/
def rankOne (i : Fin r) : Subgroup (Sp r F) :=
  closure (Set.range (positiveRoot (F := F) i) ∪ Set.range (negativeRoot i))

/-- The two-node subgroup; the diagonal case is allowed. -/
def rankTwo (i j : Fin r) : Subgroup (Sp r F) := rankOne i ⊔ rankOne j

def leftInclusion (i j : Fin r) : rankOne (F := F) i →* rankTwo (F := F) i j :=
  inclusion le_sup_left

def rightInclusion (i j : Fin r) : rankOne (F := F) j →* rankTwo (F := F) i j :=
  inclusion le_sup_right

/-- Triviality of the matrix center, without a simplicity assumption. -/
theorem center_eq_bot [CharP F 2] (hr : 0 < r) : center (Sp r F) = ⊥ := by
  apply bot_unique
  intro g hg
  obtain ⟨a, ha⟩ := central_is_scalar (n := r) (F := F) g hg
  let i : Fin r := ⟨0, hr⟩
  have hs := preserves g (e (F := F) i) (f (F := F) i)
  have hvec (v : Vector r F) : g.val *ᵥ v = a • v :=
    (Matrix.PSp4Three.smul_eq_mulVec g v).symm.trans (ha v)
  rw [hvec, hvec] at hs
  have hsq : a ^ 2 = 1 := by
    simpa only [map_smul, LinearMap.smul_apply, smul_eq_mul,
      form_f_right, e, Pi.single_eq_same, mul_one, pow_two] using hs
  have haone : a = 1 := CharTwo.sq_injective (by simpa using hsq)
  apply ext_action
  intro x
  simpa [haone] using ha x

/-- The isomorphism is the literal quotient projection. -/
def projectiveEquiv [CharP F 2] (hr : 0 < r) : Sp r F ≃* PSp r F :=
  ((QuotientGroup.quotientMulEquivOfEq (center_eq_bot hr)).trans
    QuotientGroup.quotientBot).symm

@[simp] theorem projectiveEquiv_apply [CharP F 2] (hr : 0 < r) (g : Sp r F) :
    projectiveEquiv hr g = QuotientGroup.mk' (center (Sp r F)) g := rfl

/-- Perfectness supplied on the projective carrier also holds on the native
matrix group via the proved quotient comparison. -/
theorem native_isPerfect [CharP F 2] [Group.IsPerfect (PSp r F)] (hr : 0 < r) :
    Group.IsPerfect (Sp r F) :=
  Group.IsPerfect.ofSurjective (f := (projectiveEquiv (F := F) hr).symm.toMonoidHom)
    (projectiveEquiv (F := F) hr).symm.surjective

end Theory.SpecificGroups.Symplectic.CentralCovers.HigherNonbinary
