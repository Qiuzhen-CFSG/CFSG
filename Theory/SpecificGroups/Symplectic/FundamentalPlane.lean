module

public import Theory.SpecificGroups.PSp4Three.ProjectiveGeometry
public import Theory.SpecificGroups.Symplectic.TheoremDRootNormalizer.RankOne
public import Theory.GroupTheory.PResidual.PrimeTo
public import Theory.GroupTheory.PrimeRankWitness
public import Theory.SpecificGroups.SL2.DefiningRank
public import Mathlib.Tactic

/-!
# Fundamental hyperbolic plane in the symplectic central quotient

The natural space is split by the explicit `headTail` isometry into its first
hyperbolic plane and its orthogonal complement. The two full symplectic factors
commute. Scalar-center rigidity proves that each factor embeds in the central
quotient (the first factor requires a nonzero complement). Noncommuting tail
transvections prove that the first factor is proper.

Every homomorphic image of Sp is generated by defining-characteristic elements.
Thus the complementary factor embeds in the literal prime-to-characteristic
residual of the fundamental centralizer. Independent diagonal shears give rank
at least `k * d` for complement rank `k` over a field of order `r^d`.

Source application: Aschbacher–Smith, *The Classification of Quasithin Groups*,
A.2.17, printed p.39 of `refs/quasithin.pdf`. This module proves containment in
the residual, not the reverse centralizer containment. It uses the existing
ATLAS-attributed matrix and transvection APIs in `PSp4Three`; those APIs are
characteristic-independent and do not require rank two.
-/

@[expose] public noncomputable section

open Matrix
open Matrix.PSp4Three
namespace Theory.SpecificGroups.Symplectic.FundamentalPlane
variable {F : Type*} [Field F]

def pairCoord : Vector 1 F ≃ₗ[F] (F × F) :=
  (headTail 0).trans (LinearEquiv.prodUnique (R := F) (M := F × F) (M₂ := Vector 0 F))

@[simp] theorem pairCoord_apply (x : Vector 1 F) :
    pairCoord x = (headTail 0 x).1 := by
  rfl

def pairAction (g : Sp 1 F) : (F × F) ≃ₗ[F] (F × F) :=
  (pairCoord (F := F)).symm.trans ((toLinear g).trans (pairCoord (F := F)))

def firstLinear (k : ℕ) (g : Sp 1 F) : Vector (k+1) F ≃ₗ[F] Vector (k+1) F := by
  let h : Vector (k+1) F ≃ₗ[F] (F × F) × Vector k F := headTail k
  exact h.trans (((pairAction g).prodCongr (LinearEquiv.refl F (Vector k F))).trans h.symm)

theorem firstLinear_apply (k : ℕ) (g : Sp 1 F) (x : Vector (k+1) F) :
    headTail k (firstLinear k g x) =
      (pairAction g (headTail k x).1, (headTail k x).2) := by
  simp [firstLinear]

theorem pair_form (x y : F × F) :
    form ((pairCoord (F := F)).symm x) ((pairCoord (F := F)).symm y) =
      x.1 * y.2 - x.2 * y.1 := by
  rw [form_headTail]
  simp [pairCoord]

theorem pairAction_preserves (g : Sp 1 F) (u v : F × F) :
    (pairAction g u).1 * (pairAction g v).2 - (pairAction g u).2 * (pairAction g v).1 =
      u.1 * v.2 - u.2 * v.1 := by
  rw [← pair_form, ← pair_form]
  change form (g • (pairCoord (F := F)).symm u)
      (g • (pairCoord (F := F)).symm v) = _
  exact preserves g _ _

theorem firstLinear_preserves (k : ℕ) (g : Sp 1 F) (x y : Vector (k+1) F) :
    form (firstLinear k g x) (firstLinear k g y) = form x y := by
  rw [form_headTail, form_headTail, firstLinear_apply, firstLinear_apply]
  rw [pairAction_preserves]

theorem pairAction_one : pairAction (1 : Sp 1 F) = LinearEquiv.refl F (F × F) := by
  ext x <;> simp [pairAction]

theorem pairAction_mul (g h : Sp 1 F) : pairAction (g*h) = (pairAction h).trans (pairAction g) := by
  apply LinearEquiv.ext
  intro x
  simp only [pairAction, LinearEquiv.trans_apply]
  apply Prod.ext
  · change ((headTail 0) ((g*h) • (pairCoord.symm x))).1.1 = _
    simp only [pairCoord.symm_apply_apply, toLinear_apply]
    rw [← mul_smul]
    simp only [pairCoord_apply]
  · change ((headTail 0) ((g*h) • (pairCoord.symm x))).1.2 = _
    simp only [pairCoord.symm_apply_apply, toLinear_apply]
    rw [← mul_smul]
    simp only [pairCoord_apply]

theorem firstLinear_one (k : ℕ) : firstLinear k (1 : Sp 1 F) = LinearEquiv.refl F _ := by
  let h : Vector (k+1) F ≃ₗ[F] (F × F) × Vector k F := headTail k
  rw [show firstLinear k (1 : Sp 1 F) = h.trans
    (((pairAction (1 : Sp 1 F)).prodCongr (LinearEquiv.refl F _)).trans h.symm) by rfl]
  rw [pairAction_one]
  ext x; simp

theorem firstLinear_mul (k : ℕ) (g h : Sp 1 F) :
    firstLinear k (g*h) = (firstLinear k h).trans (firstLinear k g) := by
  let c : Vector (k+1) F ≃ₗ[F] (F × F) × Vector k F := headTail k
  rw [show firstLinear k (g*h) = c.trans
    (((pairAction (g*h)).prodCongr (LinearEquiv.refl F _)).trans c.symm) by rfl]
  rw [show (firstLinear k h).trans (firstLinear k g) = c.trans
    (((pairAction h).prodCongr (LinearEquiv.refl F _)).trans
      (((pairAction g).prodCongr (LinearEquiv.refl F _)).trans c.symm)) by rfl]
  rw [pairAction_mul]
  ext x; simp

/-- The rank-one symplectic factor on the marked hyperbolic plane. -/
def firstHom (k : ℕ) : Sp 1 F →* Sp (k+1) F where
  toFun g := ofLinear (firstLinear k g) (firstLinear_preserves k g)
  map_one' := by
    apply ext_action
    intro x
    rw [ofLinear_apply, firstLinear_one]
    simp
  map_mul' g h := by
    apply ext_action
    intro x
    rw [mul_smul, ofLinear_apply, ofLinear_apply]
    rw [firstLinear_mul]
    simp [LinearEquiv.trans_apply]

/-- The complementary symplectic group, fixing the first hyperbolic plane. -/
abbrev tailHom (k : ℕ) : Sp k F →* Sp (k+1) F := extendHom

@[simp] theorem firstHom_headTail (k : ℕ) (g : Sp 1 F) (x : Vector (k+1) F) :
    headTail k (firstHom k g • x) =
      (pairAction g (headTail k x).1, (headTail k x).2) := by
  change headTail k (ofLinear (firstLinear k g) (firstLinear_preserves k g) • x) = _
  rw [ofLinear_apply, firstLinear_apply]

@[simp] theorem tailHom_headTail (k : ℕ) (g : Sp k F) (x : Vector (k+1) F) :
    headTail k (tailHom k g • x) =
      ((headTail k x).1, g • (headTail k x).2) := by
  change headTail k (ofLinear (extendLinear g) (extendLinear_preserves g) • x) = _
  rw [ofLinear_apply, extendLinear_headTail]

theorem tailHom_injective (k : ℕ) : Function.Injective (tailHom (F := F) k) :=
  (pairStabilizer k F).subtype_injective.comp pairStabilizerEquiv.symm.injective

theorem firstHom_injective (k : ℕ) : Function.Injective (firstHom (F := F) k) := by
  intro g h he
  apply ext_action
  intro x
  have hh := congrArg (fun a : Sp (k+1) F =>
    (headTail k (a • (headTail k).symm (pairCoord x, 0))).1) he
  simp only [firstHom_headTail, LinearEquiv.apply_symm_apply] at hh
  apply pairCoord.injective
  simpa only [pairAction, LinearEquiv.trans_apply, LinearEquiv.symm_apply_apply,
    toLinear_apply] using hh

theorem factors_commute (k : ℕ) (g : Sp 1 F) (h : Sp k F) :
    Commute (firstHom k g) (tailHom k h) := by
  apply ext_action
  intro x
  apply (headTail k).injective
  simp only [mul_smul, firstHom_headTail, tailHom_headTail]

def projectFirst (k : ℕ) : Sp 1 F →* PSp (k+1) F := projection.comp (firstHom k)
def projectTail (k : ℕ) : Sp k F →* PSp (k+1) F := projection.comp (tailHom k)

theorem projectTail_injective (k : ℕ) : Function.Injective (projectTail (F := F) k) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro g hg
  have hc : tailHom k g ∈ Subgroup.center (Sp (k+1) F) :=
    (QuotientGroup.eq_one_iff _).mp hg
  obtain ⟨a, ha⟩ := central_is_scalar _ hc
  have h0 := congrArg (fun x => (headTail k x).1.1) (ha (e 0))
  simp only [tailHom_headTail, map_smul, headTail_e, Prod.smul_fst,
    smul_eq_mul, mul_one] at h0
  have ha1 : a = 1 := h0.symm
  apply tailHom_injective k
  apply ext_action
  intro x
  rw [map_one, one_smul, ha, ha1, one_smul]

theorem projectFirst_injective (k : ℕ) (hk : 0 < k) :
    Function.Injective (projectFirst (F := F) k) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro g hg
  have hc : firstHom k g ∈ Subgroup.center (Sp (k+1) F) :=
    (QuotientGroup.eq_one_iff _).mp hg
  obtain ⟨a, ha⟩ := central_is_scalar _ hc
  let i : Fin k := ⟨0, hk⟩
  have h0 := congrArg (fun x => (headTail k x).2 (.inl i))
    (ha ((headTail k).symm (0, e i)))
  simp only [firstHom_headTail, LinearEquiv.apply_symm_apply, map_smul,
    Prod.smul_snd, Pi.smul_apply, smul_eq_mul] at h0
  have ha1 : a = 1 := by simpa [Matrix.PSp4Three.e] using h0.symm
  apply firstHom_injective k
  apply ext_action
  intro x
  rw [map_one, one_smul, ha, ha1, one_smul]

theorem project_factors_commute (k : ℕ) (g : Sp 1 F) (h : Sp k F) :
    Commute (projectFirst k g) (projectTail k h) :=
  (factors_commute k g h).map projection

/-- The genuine SL₂ map, with the two coordinates explicitly reindexed. -/
def fundamental (k : ℕ) : SpecialLinearGroup (Fin 2) F →* PSp (k+1) F :=
  (projectFirst k).comp Theory.SpecificGroups.SymplecticRoot.rankOneEquivSL.symm.toMonoidHom

theorem fundamental_range (k : ℕ) :
    (fundamental (F := F) k).range = (projectFirst k).range := by
  ext x
  constructor
  · rintro ⟨g, rfl⟩
    exact ⟨Theory.SpecificGroups.SymplecticRoot.rankOneEquivSL.symm g, rfl⟩
  · rintro ⟨g, rfl⟩
    refine ⟨Theory.SpecificGroups.SymplecticRoot.rankOneEquivSL g, ?_⟩
    simp [fundamental]

theorem fundamental_injective (k : ℕ) (hk : 0 < k) :
    Function.Injective (fundamental (F := F) k) :=
  (projectFirst_injective k hk).comp
    Theory.SpecificGroups.SymplecticRoot.rankOneEquivSL.symm.injective

/-- The centralizer is taken inside the actual projective matrix quotient. -/
def centralizer (k : ℕ) : Subgroup (PSp (k+1) F) :=
  Subgroup.centralizer (fundamental (F := F) k).range.carrier

theorem projectTail_mem_centralizer (k : ℕ) (g : Sp k F) :
    projectTail k g ∈ centralizer k := by
  rw [centralizer, fundamental_range, Subgroup.mem_centralizer_iff]
  rintro _ ⟨h, rfl⟩
  exact (project_factors_commute k h g).eq

def tailToCentralizer (k : ℕ) : Sp k F →* centralizer (F := F) k :=
  (projectTail k).codRestrict _ (projectTail_mem_centralizer k)

theorem transvection_pow (k : ℕ) (v : Vector k F) (a : F) (m : ℕ) :
    transvection v a ^ m = transvection v (m • a) := by
  induction m with
  | zero => simp
  | succ m ih => rw [pow_succ, ih, succ_nsmul, transvection_add]

theorem image_mem_residual (k : ℕ) {r : ℕ} [CharP F r]
    {G : Type*} [Group G] (j : Sp k F →* G) (g : Sp k F) :
    j g ∈ Subgroup.primeToResidual r G := by
  have h : transvectionGroup k F ≤ (Subgroup.primeToResidual r G).comap j := by
    apply (Subgroup.closure_le _).mpr
    rintro t ⟨v, a, rfl⟩
    apply Subgroup.mem_primeToResidual_of_pow (n := 1)
    rw [pow_one, ← map_pow, transvection_pow]
    have hz : r • a = 0 := by simp [nsmul_eq_mul]
    rw [hz, Matrix.PSp4Three.transvection_zero, map_one]
  exact h (mem_transvectionGroup k g)

def residual (k r : ℕ) : Subgroup (centralizer (F := F) k) :=
  Subgroup.primeToResidual r (centralizer k)

def tailToResidual (k r : ℕ) [CharP F r] : Sp k F →* residual (F := F) k r :=
  (tailToCentralizer k).codRestrict _ (image_mem_residual k (tailToCentralizer k))

theorem tailToResidual_injective (k r : ℕ) [CharP F r] :
    Function.Injective (tailToResidual (F := F) k r) := by
  intro a b h
  apply projectTail_injective k
  exact congrArg (fun x : residual k r => x.val.val) h

def diagonalShear (k : ℕ) : Multiplicative (Fin k → F) →* Sp k F where
  toFun v := ⟨fromBlocks 1 (diagonal v.toAdd) 0 1, by
    rw [SymplecticGroup.fromBlocks_mem_iff]
    simp⟩
  map_one' := by apply Subtype.ext; simp
  map_mul' v w := by
    apply Subtype.ext
    change fromBlocks 1 (diagonal (v.toAdd + w.toAdd)) 0 1 =
      fromBlocks 1 (diagonal v.toAdd) 0 1 * fromBlocks 1 (diagonal w.toAdd) 0 1
    simp only [fromBlocks_multiply, one_mul, mul_one,
      zero_mul, mul_zero, add_zero, zero_add]
    congr 1
    ext i j
    by_cases hij : i = j <;> simp [hij, add_comm]

theorem diagonalShear_injective (k : ℕ) : Function.Injective (diagonalShear (F := F) k) := by
  intro v w h
  change v.toAdd = w.toAdd
  funext i
  have hh := congrArg (fun g : Sp k F => g.val (.inl i) (.inr i)) h
  simpa [diagonalShear] using hh

theorem rank_mul_fieldExponent_le_residual [Finite F] (k : ℕ) {r d : ℕ}
    [Fact r.Prime] [CharP F r] (hcard : Nat.card F = r ^ d) :
    k * d ≤ primeRank r (residual (F := F) k r) := by
  apply primeRank_ge_of_elementary_embedding (A := Multiplicative (Fin k → F))
    (f := (tailToResidual k r).comp (diagonalShear k))
  · intro v
    change r • v.toAdd = 0
    ext i
    simp [nsmul_eq_mul]
  · change Nat.card (Fin k → F) = _
    rw [Nat.card_fun, Nat.card_fin, hcard, ← pow_mul, Nat.mul_comm d k]
  · exact (tailToResidual_injective k r).comp (diagonalShear_injective k)

theorem dimension_of_residual_rank [Finite F] (k : ℕ) (hk : 0 < k) {r d : ℕ}
    [Fact r.Prime] [CharP F r] (hcard : Nat.card F = r ^ d) (hd : 0 < d)
    (hJ : primeRank r (residual (F := F) k r) ≤ 1) : k = 1 ∧ d = 1 := by
  have h := (rank_mul_fieldExponent_le_residual k hcard).trans hJ
  have hk' : k ≤ k * d := Nat.le_mul_of_pos_right k hd
  have hd' : d ≤ k * d := Nat.le_mul_of_pos_left d hk
  omega

theorem plane_transvections_not_commute (k : ℕ) (i : Fin k) :
    ¬ Commute (transvection (Matrix.PSp4Three.e (F := F) i) 1)
      (transvection (Matrix.PSp4Three.f (F := F) i) (1 : F)) := by
  intro h
  have hh := congrArg (fun g : Sp k F => (g • Matrix.PSp4Three.e (F := F) i) (.inl i)) h.eq
  simp [mul_smul, transvection_apply, Matrix.PSp4Three.e,
    Matrix.PSp4Three.f, form_apply, Pi.single_apply] at hh

theorem projectFirst_proper (k : ℕ) (hk : 0 < k) :
    (projectFirst (F := F) k).range ≠ ⊤ := by
  intro ht
  let i : Fin k := ⟨0, hk⟩
  let a : Sp k F := transvection (Matrix.PSp4Three.e i) 1
  let b : Sp k F := transvection (Matrix.PSp4Three.f i) 1
  have ha : projectTail k a ∈ (projectFirst k).range := by rw [ht]; trivial
  obtain ⟨g, hg⟩ := ha
  have hc := (project_factors_commute k g b).eq
  rw [hg, ← map_mul, ← map_mul] at hc
  exact plane_transvections_not_commute k i ((projectTail_injective k) hc)

/-- A nontrivial orthogonal complement makes the fundamental SL₂ proper. -/
theorem fundamental_proper (k : ℕ) (hk : 0 < k) :
    (fundamental (F := F) k).range ≠ ⊤ := by
  rw [fundamental_range]
  exact projectFirst_proper k hk

/-- The fundamental central involution survives the projective ambient quotient. -/
theorem fundamental_involution (k : ℕ) (hk : 0 < k) {r : ℕ}
    [Fact r.Prime] [CharP F r] (hr : r ≠ 2) :
    let : Fact (Even (Fintype.card (Fin 2))) := ⟨by decide⟩
    fundamental (F := F) k (-1) ≠ 1 ∧ fundamental (F := F) k (-1) ^ 2 = 1 := by
  let : Fact (Even (Fintype.card (Fin 2))) := ⟨by decide⟩
  exact SpecialLinearGroup.map_neg_one_isInvolution hr (fundamental k)
    (fundamental_injective k hk)

end Theory.SpecificGroups.Symplectic.FundamentalPlane
