module

public import Theory.SpecificGroups.Janko1.Model.Presentation.OrderBound.Relators
public import Theory.SpecificGroups.Janko1.Model.Presentation.OrderBound.Certificate.Checked
public import Theory.SpecificGroups.Janko1.Model.Presentation.OrderBound.Certificate.Shape
public import Theory.SpecificGroups.Janko1.Model.Presentation.Comparison

/-!
# A certified upper bound for the full J₁ presentation

The third ATLAS relation bounds the cyclic subgroup generated by `ab` by
seven. A kernel checked Todd–Coxeter trace gives 25,080 coset representatives
and proves their transitions inside the abstract presented group. The resulting
surjection from the subgroup times the representatives bounds its order by
175,560. Applying the existing comparison theorem makes the literal map to
the certified matrix model bijective.

The only relator loops in the trace are the five ATLAS words, their cyclic
rotations and inverses, and the redundant generator definition `c = ab`.
No permutation or matrix computation supplies an upper bound on the
presentation. The untrusted producer, exact data and reproduction instructions
are in `OrderBound/Source/`.

Source: ATLAS of Finite Group Representations, `J1G1-P1`,
https://brauer.maths.qmul.ac.uk/Atlas/v3/pres/J1G1-P1
(inspected 8 October 2026).
-/

namespace Janko1.PresentationBound
open Subgroup.CosetWordCertificate
open Certificate

/-- Actual signed-generator transitions on 25,080 representatives modulo `⟨ab⟩`. -/
public def cosetCover :
    Subgroup.GeneratorCosetCover cyclic presentationGenerator (Fin 25080) where
  repr i := definitions.repr generator (survivor i)
  initial := 0
  initial_eq := by change definitions.repr generator 0 = 1; simp
  step i a := by
    have h := all_hold certificate_valid _ (hlt i (a,true))
    rw [hshape] at h
    obtain ⟨z, hz⟩ := h
    refine ⟨z, dest i (a,true), ?_⟩
    cases a <;> simpa [eval_letter, embed, generator] using hz
  inv_step i a := by
    have h := all_hold certificate_valid _ (hlt i (a,false))
    rw [hshape] at h
    obtain ⟨z, hz⟩ := h
    refine ⟨z, dest i (a,false), ?_⟩
    cases a <;> simpa [eval_letter, embed, generator] using hz

end Janko1.PresentationBound

namespace Janko1

/-- The full five-relator ATLAS presentation is finite of order at most 175,560. -/
public theorem atlasPresentation_finite_card_le :
    Finite AtlasPresentation ∧ Nat.card AtlasPresentation ≤ 175560 := by
  obtain ⟨hfin, hcard⟩ := PresentationBound.cyclic_bound
  let : Finite PresentationBound.cyclic := hfin
  have hg : Subgroup.closure (Set.range presentationGenerator) = ⊤ :=
    PresentedGroup.closure_range_of (Set.range atlasRelator)
  obtain ⟨hf, hb⟩ := PresentationBound.cosetCover.finite_card_le hg
  refine ⟨hf, hb.trans ?_⟩
  simpa only [Nat.card_fin] using Nat.mul_le_mul_right 25080 hcard

/-- The canonical presentation map is unconditionally bijective. -/
public theorem presentationToModel_bijective : Function.Bijective presentationToModel :=
  presentationToModel_bijective_of_bound atlasPresentation_finite_card_le

/-- The literal full ATLAS presentation and the certified matrix model are isomorphic. -/
public noncomputable def presentationEquivModel : AtlasPresentation ≃* Model :=
  MulEquiv.ofBijective presentationToModel presentationToModel_bijective

@[simp] public theorem presentationEquivModel_generator (i : Bool) :
    presentationEquivModel (presentationGenerator i) = modelGenerator i :=
  presentationToModel_generator i

end Janko1
