module

public import Theory.SpecificGroups.Janko1.Model.Basic
public import Theory.SpecificGroups.Janko1.Model.Certification.NormalSubgroups
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.Perm.Cycle.Type
public import Mathlib.GroupTheory.Subgroup.Simple

/-!
# Order and simplicity of the explicit J₁ model

The standard involution normally generates the matrix group: in a quotient
where it vanishes, the remaining generator has both order dividing three and
order dividing seven, so it too vanishes. This is the algebraic part of the
intrinsic simplicity certificate. The imported matrix and Sylow certificates
prove the exact order and that every nontrivial normal subgroup contains an
involution conjugate to the standard one. Together these prove simplicity.

The generator relations come from the ATLAS matrices recorded in `Basic`.
-/

namespace Janko1

/-- Any homomorphism killing the standard involution kills the entire model. -/
public theorem hom_eq_one_of_a_eq_one {H : Type*} [Group H] (f : Model →* H)
    (ha : f a = 1) : f = 1 := by
  have hb3 : f b ^ 3 = 1 := by
    simpa only [map_pow, map_one] using congrArg f b_pow_three
  have hb7 : f b ^ 7 = 1 := by
    simpa only [map_pow, map_mul, map_one, ha, one_mul] using
      congrArg f ab_pow_seven
  have hb6 : f b ^ 6 = 1 := by
    calc
      f b ^ 6 = (f b ^ 3) ^ 2 := pow_mul _ 3 2
      _ = 1 := by rw [hb3, one_pow]
  have hb : f b = 1 := by
    simpa only [show (7 : ℕ) = 6 + 1 from rfl, pow_succ, hb6, one_mul] using hb7
  exact hom_ext f 1 (by simpa using ha) (by simpa using hb)

/-- A normal subgroup containing the standard involution is the whole model. -/
public theorem normal_eq_top_of_a_mem (N : Subgroup Model) [N.Normal]
    (ha : a ∈ N) : N = ⊤ := by
  have hf : QuotientGroup.mk' N = 1 :=
    hom_eq_one_of_a_eq_one (QuotientGroup.mk' N) (by
      exact (QuotientGroup.eq_one_iff _).mpr ha)
  apply (Subgroup.eq_top_iff' N).mpr
  intro x
  have hx : x ∈ (QuotientGroup.mk' N).ker := by
    apply MonoidHom.mem_ker.mpr
    exact congrFun (congrArg DFunLike.coe hf) x
  simpa only [QuotientGroup.ker_mk'] using hx

/-- The normal closure of the standard involution is the whole model. -/
public theorem normalClosure_a_eq_top :
    Subgroup.normalClosure ({a} : Set Model) = ⊤ := by
  apply normal_eq_top_of_a_mem
  exact Subgroup.subset_normalClosure (Set.mem_singleton a)

/-- Two sufficient finite simplicity certificates are evenness of nontrivial
normal subgroups and fusion of involutions. Both must be certified for the
concrete matrix group; neither follows just from the presentation. -/
public theorem isSimpleGroup_of_even_normal_and_involution_fusion
    (heven : ∀ N : Subgroup Model, N.Normal → N ≠ ⊥ → 2 ∣ Nat.card N)
    (hfuse : ∀ x : Model, orderOf x = 2 → ∃ g : Model, g * x * g⁻¹ = a) :
    IsSimpleGroup Model := by
  constructor
  intro N hN
  by_cases hbot : N = ⊥
  · exact Or.inl hbot
  · let : N.Normal := hN
    have hp : Fact (Nat.Prime 2) := ⟨by decide⟩
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := N) 2 (heven N hN hbot)
    obtain ⟨g, hg⟩ := hfuse x (by simpa only [Subgroup.orderOf_coe] using hx)
    have ha : a ∈ N := by
      rw [← hg]
      exact hN.conj_mem x.val x.property g
    exact Or.inr (normal_eq_top_of_a_mem N ha)

/-- Every involution of the explicit matrix model is conjugate to `a`. -/
public theorem involution_fusion (x : Model) (hx : orderOf x = 2) :
    ∃ g : Model, g * x * g⁻¹ = a :=
  involution_fusion_of_card card_model x hx

/-- The group generated by the two explicit ATLAS matrices is simple. -/
public instance modelSimpleGroup : IsSimpleGroup Model :=
  isSimpleGroup_of_even_normal_and_involution_fusion even_card_normal involution_fusion

end Janko1
