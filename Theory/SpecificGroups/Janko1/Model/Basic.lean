module

public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
public import Mathlib.Data.ZMod.Basic
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.IsPerfect
public import Mathlib.GroupTheory.Abelianization.Defs

/-!
# The seven-dimensional matrix construction of J₁

We use the explicit standard generators of the ATLAS representation
`J1G1-f11r7B0`, over the prime field of order 11. The model is their generated
subgroup in GL₇(11). Its inclusion is faithful and its carrier is finite.
The generator orders and all five relators of the ATLAS presentation
`J1G1-P1` are checked by kernel reduction of the displayed matrices. The
(2,3,7) relations also prove that this generated group is perfect.

Sources: R. A. Wilson, S. J. Nickerson and J. N. Bray, *ATLAS of Finite Group
Representations*, https://brauer.maths.qmul.ac.uk/Atlas/v3/spor/J1/;
representation https://brauer.maths.qmul.ac.uk/Atlas/v3/matrep/J1G1-f11r7B0,
with numerical data in `/Atlas/spor/J1/mtx/J1G1-f11r7B0.m1` and `.m2`;
presentation https://brauer.maths.qmul.ac.uk/Atlas/v3/pres/J1G1-P1.
Data retrieved 3 October 2026. Entries are transcribed row by row, without
transposition; multiplication is ordinary matrix multiplication.

The construction uses neither a classification predicate nor an order-based
recognition principle. The relations checked here are identities in this
specific matrix group, not a claim that arbitrary groups satisfying these
relations are isomorphic to it. Its exact cardinality and simplicity require
separate structural certificates.
-/

namespace Janko1

set_option maxRecDepth 10000
set_option maxHeartbeats 1600000

/-- The ambient matrix group for the standard seven-dimensional construction. -/
public abbrev Ambient := Matrix.GeneralLinearGroup (Fin 7) (ZMod 11)

/-- First ATLAS standard generator, in row-major order. -/
@[expose] public def matrixA : Matrix (Fin 7) (Fin 7) (ZMod 11) :=
  !![0, 7, 9, 9, 10, 7, 9;
     7, 0, 1, 4, 3, 3, 4;
     9, 1, 2, 8, 3, 6, 2;
     9, 4, 8, 10, 1, 6, 0;
     10, 3, 3, 1, 8, 9, 1;
     7, 3, 6, 6, 9, 1, 3;
     9, 4, 2, 0, 1, 3, 0]

/-- Second ATLAS standard generator, in row-major order. -/
@[expose] public def matrixB : Matrix (Fin 7) (Fin 7) (ZMod 11) :=
  !![5, 7, 1, 8, 5, 8, 2;
     10, 4, 10, 0, 3, 3, 8;
     5, 10, 8, 9, 1, 2, 1;
     2, 3, 3, 6, 1, 2, 9;
     7, 4, 7, 2, 10, 7, 3;
     3, 9, 0, 4, 2, 3, 5;
     3, 4, 3, 3, 9, 4, 9]

private theorem matrixA_mul_self : matrixA * matrixA = 1 := by decide +kernel

private theorem matrixB_cube : matrixB * matrixB * matrixB = 1 := by decide +kernel

/-- The first generator is an invertible matrix, with itself as inverse. -/
@[expose] public def ambientA : Ambient :=
  ⟨matrixA, matrixA, by exact matrixA_mul_self, by exact matrixA_mul_self⟩

/-- The second generator is an invertible matrix, with its square as inverse. -/
@[expose] public def ambientB : Ambient :=
  ⟨matrixB, matrixB * matrixB, by simpa only [mul_assoc] using matrixB_cube,
    by exact matrixB_cube⟩

/-- The subgroup generated by the two specified matrices. -/
@[expose] public def matrixGroup : Subgroup Ambient :=
  Subgroup.closure {ambientA, ambientB}

/-- The actual carrier of the J₁ matrix construction. -/
@[expose] public def Model : Type := matrixGroup
  deriving Group

/-- Finiteness follows from the finite ambient matrix ring. -/
public instance modelFinite : Finite Model := inferInstanceAs (Finite matrixGroup)

/-- The first standard generator inside the constructed group. -/
@[expose] public def a : Model :=
  ⟨ambientA, Subgroup.subset_closure (by simp)⟩

/-- The second standard generator inside the constructed group. -/
@[expose] public def b : Model :=
  ⟨ambientB, Subgroup.subset_closure (by simp)⟩

/-- The faithful seven-dimensional representation of the constructed group. -/
@[expose] public def inclusion : Model →* Ambient := matrixGroup.subtype

public theorem inclusion_injective : Function.Injective inclusion := Subtype.val_injective

@[simp] public theorem inclusion_a : inclusion a = ambientA := rfl

@[simp] public theorem inclusion_b : inclusion b = ambientB := rfl

/-- These two elements generate the whole carrier, not merely a subgroup of it. -/
public theorem closure_pair_eq_top : Subgroup.closure ({a, b} : Set Model) = ⊤ := by
  have hs : ({a, b} : Set Model) =
      (inclusion ⁻¹' ({ambientA, ambientB} : Set Ambient)) := by
    ext x
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_preimage]
    constructor
    · rintro (rfl | rfl) <;> simp
    · rintro (ha | hb)
      · exact Or.inl (inclusion_injective ha)
      · exact Or.inr (inclusion_injective hb)
  rw [hs]
  exact Subgroup.closure_closure_coe_preimage

/-- Homomorphisms out of the model are determined by its two generators. -/
@[ext] public theorem hom_ext {H : Type*} [Group H] (f g : Model →* H)
    (ha : f a = g a) (hb : f b = g b) : f = g := by
  apply MonoidHom.eq_of_eqOn_dense closure_pair_eq_top
  intro x hx
  rcases hx with rfl | hx
  · exact ha
  · exact Set.mem_singleton_iff.mp hx ▸ hb

public theorem a_pow_two : a ^ 2 = 1 := by
  apply Subtype.ext
  apply Units.ext
  change matrixA ^ 2 = 1
  decide +kernel

public theorem b_pow_three : b ^ 3 = 1 := by
  apply Subtype.ext
  apply Units.ext
  change matrixB ^ 3 = 1
  decide +kernel

public theorem ab_pow_seven : (a * b) ^ 7 = 1 := by
  apply Subtype.ext
  apply Units.ext
  change (matrixA * matrixB) ^ 7 = 1
  decide +kernel

public theorem abab_sq_pow_nineteen : (a * b * a * b ^ 2) ^ 19 = 1 := by
  apply Subtype.ext
  apply Units.ext
  change (matrixA * matrixB * matrixA * matrixB ^ 2) ^ 19 = 1
  decide +kernel

public theorem a_ne_one : a ≠ 1 := by
  intro h
  have h' := congrArg (fun x : Model => (inclusion x).val) h
  exact (by decide +kernel : matrixA ≠ 1) h'

public theorem b_ne_one : b ≠ 1 := by
  intro h
  have h' := congrArg (fun x : Model => (inclusion x).val) h
  exact (by decide +kernel : matrixB ≠ 1) h'

public theorem ab_ne_one : a * b ≠ 1 := by
  intro h
  have h' := congrArg (fun x : Model => (inclusion x).val) h
  exact (by decide +kernel : matrixA * matrixB ≠ 1) h'

public theorem abab_sq_ne_one : a * b * a * b ^ 2 ≠ 1 := by
  intro h
  have h' := congrArg (fun x : Model => (inclusion x).val) h
  exact (by decide +kernel : matrixA * matrixB * matrixA * matrixB ^ 2 ≠ 1) h'

public instance modelNontrivial : Nontrivial Model := ⟨⟨a, 1, a_ne_one⟩⟩

public theorem orderOf_a : orderOf a = 2 := orderOf_eq_prime a_pow_two a_ne_one

public theorem orderOf_b : orderOf b = 3 := orderOf_eq_prime b_pow_three b_ne_one

public theorem orderOf_ab : orderOf (a * b) = 7 := by
  have : Fact (Nat.Prime 7) := ⟨by decide⟩
  exact orderOf_eq_prime ab_pow_seven ab_ne_one

public theorem orderOf_abab_sq : orderOf (a * b * a * b ^ 2) = 19 := by
  have : Fact (Nat.Prime 19) := ⟨by decide⟩
  exact orderOf_eq_prime abab_sq_pow_nineteen abab_sq_ne_one

/-- The fourth defining relator of the ATLAS presentation `J1G1-P1`. -/
public theorem atlas_relator_four : (a * b * (a * b * a * b⁻¹) ^ 3) ^ 5 = 1 := by
  apply Subtype.ext
  apply Units.ext
  change (matrixA * matrixB * (matrixA * matrixB * matrixA *
    (matrixB * matrixB)) ^ 3) ^ 5 = 1
  decide +kernel

/-- The fifth defining relator of the ATLAS presentation `J1G1-P1`. -/
public theorem atlas_relator_five :
    (a * b * (a * b * a * b⁻¹) ^ 6 * a * b * a * b * (a * b⁻¹) ^ 2) ^ 2 = 1 := by
  apply Subtype.ext
  apply Units.ext
  change (matrixA * matrixB * (matrixA * matrixB * matrixA * (matrixB * matrixB)) ^ 6 *
    matrixA * matrixB * matrixA * matrixB * (matrixA * (matrixB * matrixB)) ^ 2) ^ 2 = 1
  decide +kernel

/-- The (2,3,7) generator relations force every abelian image to be trivial. -/
public theorem hom_to_commGroup_eq_one {H : Type*} [CommGroup H] (f : Model →* H) :
    f = 1 := by
  have ha2 : f a ^ 2 = 1 := by simpa only [map_pow, map_one] using congrArg f a_pow_two
  have hb3 : f b ^ 3 = 1 := by simpa only [map_pow, map_one] using congrArg f b_pow_three
  have hab7 : (f a * f b) ^ 7 = 1 := by
    simpa only [map_pow, map_mul, map_one] using congrArg f ab_pow_seven
  have ha6 : f a ^ 6 = 1 := by
    calc
      _ = (f a ^ 2) ^ 3 := pow_mul _ 2 3
      _ = 1 := by rw [ha2, one_pow]
  have hb6 : f b ^ 6 = 1 := by
    calc
      _ = (f b ^ 3) ^ 2 := pow_mul _ 3 2
      _ = 1 := by rw [hb3, one_pow]
  have hab6 : (f a * f b) ^ 6 = 1 := by rw [mul_pow, ha6, hb6, one_mul]
  have hab : f a * f b = 1 := by
    simpa only [show (7 : ℕ) = 6 + 1 from rfl, pow_succ, hab6, one_mul] using hab7
  have ha3 : f a ^ 3 = 1 := by
    have h := congrArg (fun x : H => x ^ 3) hab
    simpa only [mul_pow, hb3, mul_one, one_pow] using h
  have ha : f a = 1 := by
    simpa only [show (3 : ℕ) = 2 + 1 from rfl, pow_succ, ha2, one_mul] using ha3
  have hb : f b = 1 := by simpa only [ha, one_mul] using hab
  exact hom_ext f 1 ha hb

/-- The explicit matrix group is perfect. -/
public instance modelPerfect : Group.IsPerfect Model where
  commutator_eq_top := by
    rw [← Abelianization.ker_of, hom_to_commGroup_eq_one (Abelianization.of : Model →* Abelianization Model)]
    exact MonoidHom.ker_one

/-- In particular the constructed group is nonsolvable. -/
public theorem not_isSolvable : ¬ Group.IsSolvable Model := Group.IsPerfect.not_isSolvable Model

end Janko1
