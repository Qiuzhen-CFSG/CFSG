module

public import Theory.SpecificGroups.Janko1.Model.NormalizerCentralizerGeneration.Certificate

/-!
# J₁ is generated by an involution centralizer and a Sylow normalizer

The concrete certificate gives the result for one Sylow two-subgroup
containing the standard involution `a`. Every Sylow two-subgroup is abelian,
so any two such Sylow subgroups lie in `C(a)`. Sylow conjugacy within `C(a)`
transports the certified generation equality to the prescribed subgroup.

This discharges exactly the `hgenerate` premise of
`CFSG.Quasithin.ChapterE.JankoOne.generated_of_centralizer_calculations`.
The separate centralizer-member calculation is not used here.

Source: Aschbacher--Smith, E.1.14(5), printed p.214, citing Asc82a,
Lemma 4.9; GLS3, Table 5.3f and the following Janko-group discussion.
-/

open Subgroup
namespace Janko1.NormalizerCentralizerGeneration
private theorem sylow_le_centralizer (T : Sylow 2 Model) (ha : a ∈ (T : Subgroup Model)) :
    (T : Subgroup Model) ≤ centralizer ({a} : Set Model) := by
  let := SylowTwo.elementary T
  intro x hx
  apply mem_centralizer_singleton_iff.mpr
  exact congrArg (fun t : T => (t : Model)) (mul_comm' (⟨x,hx⟩ : T) ⟨a,ha⟩)

private theorem transport (P T : Sylow 2 Model) (haP : a ∈ (P : Subgroup Model))
    (haT : a ∈ (T : Subgroup Model))
    (hP : centralizer ({a} : Set Model) ⊔ normalizer (P : Set Model) = ⊤) :
    centralizer ({a} : Set Model) ⊔ normalizer (T : Set Model) = ⊤ := by
  let C := centralizer ({a} : Set Model)
  have hPC : (P : Subgroup Model) ≤ C := sylow_le_centralizer P haP
  have hTC : (T : Subgroup Model) ≤ C := sylow_le_centralizer T haT
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq C (P.subtype hPC) (T.subtype hTC)
  have hg' : (g : Model) • P = T := Sylow.subtype_injective
    (hP := Sylow.smul_le hPC g) (hQ := hTC) ((Sylow.smul_subtype hPC g).symm.trans hg)
  have hmap : (P : Subgroup Model).map (MulAut.conj (g : Model)).toMonoidHom = T :=
    congrArg (fun S : Sylow 2 Model => (S : Subgroup Model)) hg'
  let H := C ⊔ normalizer (T : Set Model)
  have hgH : (g : Model) ∈ H := (show C ≤ H from le_sup_left) g.property
  have hN : normalizer (P : Set Model) ≤ H := by
    intro n hn
    have hn' : (g : Model) * n * (g : Model)⁻¹ ∈ normalizer (T : Set Model) := by
      change (MulAut.conj (g : Model)) n ∈ normalizer ((T : Subgroup Model) : Set Model)
      rw [← hmap, ← map_equiv_normalizer_eq]
      exact mem_map_of_mem _ hn
    have hm := H.mul_mem (H.mul_mem (H.inv_mem hgH) ((show normalizer (T : Set Model) ≤ H from le_sup_right) hn')) hgH
    have he : (g : Model)⁻¹ * ((g : Model) * n * (g : Model)⁻¹) * g = n := by group
    rw [he] at hm
    exact hm
  apply top_unique
  rw [← hP]
  exact sup_le le_sup_left hN
end Janko1.NormalizerCentralizerGeneration

namespace Janko1

/-- The centralizer of the standard involution and the normalizer of any
Sylow two-subgroup containing it generate the actual GL₇(11) model of J₁. -/
public theorem centralizer_sup_normalizer_eq_top (T : Sylow 2 Model)
    (ha : a ∈ (T : Subgroup Model)) :
    centralizer ({a} : Set Model) ⊔ normalizer (T : Set Model) = ⊤ := by
  obtain ⟨P, haP, hP⟩ := NormalizerCentralizerGeneration.exists_sylow
  exact NormalizerCentralizerGeneration.transport P T haP ha hP

end Janko1
