module

public import Theory.SpecificGroups.BinaryLinear.Parabolics
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.LinearAlgebra.FiniteDimensional.Basic
public import Mathlib.Tactic.Module

/-!
# The two radicals of a nested binary flag

For W < U, the elementary radicals of the two maximal parabolics both
lie in the flag stabilizer. When W has dimension two, their intersection
is generated by mutual commutators. Given a vector y in U outside W,
choose a functional α vanishing on W with α(y) = 1. Each rank-one map
from V/U to W is the commutator of the transvections wα and yβ. A basis
of W expresses an arbitrary intersection element as two such maps.

This is the concrete cross-term calculation for block upper-triangular
matrices with successive block dimensions 2, 1, 2. It supplies the radical
identity used in Aschbacher–Smith 2.3.9(7), printed pp.525–526.
-/

public section

open Subgroup
open scoped commutatorElement
namespace BinaryLinear
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- A one-step binary parabolic radical is abelian. -/
theorem radical_commutative (W : Submodule (ZMod 2) V) :
    ⁅radical W, radical W⁆ = ⊥ := by
  apply commutator_eq_bot_iff_le_centralizer.mpr
  intro g hg
  rw [mem_centralizer_iff]
  intro h hh
  ext v
  have hg' := hg.1 (h v - v) (hh.2 v)
  have hh' := hh.1 (g v - v) (hg.2 v)
  simp only [map_sub] at hg' hh'
  change h (g v) = g (h v)
  rw [sub_eq_iff_eq_add] at hg' hh'
  rw [hg', hh']
  abel

/-- The radical at W stabilizes every larger subspace. -/
theorem radical_le_nested_parabolic {W U : Submodule (ZMod 2) V} (hWU : W ≤ U) :
    radical W ≤ parabolic U := by
  intro g hg v
  constructor
  · intro hv
    have hh := U.sub_mem hv (hWU (hg.2 v))
    simpa using hh
  · intro hv
    have hh := U.add_mem (hWU (hg.2 v)) hv
    simpa using hh

/-- The radical at U stabilizes every smaller subspace. -/
theorem radical_le_smaller_parabolic {W U : Submodule (ZMod 2) V} (hWU : W ≤ U) :
    radical U ≤ parabolic W := by
  intro g hg v
  constructor
  · intro hv
    have hh := hg.1 (g v) (hWU hv)
    have : g v = v := g.injective hh
    rwa [this] at hv
  · intro hv
    rwa [hg.1 v (hWU hv)]

private theorem transvection_cross_commutator (w y : V)
    (α β : V →ₗ[ZMod 2] ZMod 2)
    (hαw : α w = 0) (hβw : β w = 0) (hβy : β y = 0) (hαy : α y = 1) :
    ⁅transvection w α hαw, transvection y β hβy⁆ = transvection w β hβw := by
  ext v
  change (v + β v • y + α (v + β v • y) • w +
    β (v + β v • y + α (v + β v • y) • w) • y +
    α (v + β v • y + α (v + β v • y) • w +
      β (v + β v • y + α (v + β v • y) • w) • y) • w) = v + β v • w
  simp only [map_add, map_smul, hαw, hβw, hβy, hαy, smul_eq_mul, mul_zero,
    mul_one, add_zero]
  match_scalars <;> ring_nf <;>
    simp only [show (2 : ZMod 2) = 0 by decide, show (3 : ZMod 2) = 1 by decide,
      mul_zero, mul_one, zero_add]

/-- The common radical is generated by cross commutators when the smaller space has dimension two. -/
theorem radical_inf_le_commutator_of_finrank_two
    {W U : Submodule (ZMod 2) V} [FiniteDimensional (ZMod 2) W]
    (hdim : Module.finrank (ZMod 2) W = 2) (hWU : W < U) :
    radical W ⊓ radical U ≤ ⁅radical W, radical U⁆ := by
  classical
  obtain ⟨y, hyU, hyW⟩ := SetLike.exists_of_lt hWU
  obtain ⟨α, hαy, hαW⟩ := W.exists_le_ker_of_notMem hyW
  have hαy1 : α y = 1 := (by decide : ∀ a : ZMod 2, a ≠ 0 → a = 1) _ hαy
  intro g hg
  let d : V →ₗ[ZMod 2] W := (g.toLinearMap - LinearMap.id).codRestrict W hg.1.2
  let b : Module.Basis (Fin 2) (ZMod 2) W := Module.finBasisOfFinrankEq (ZMod 2) W hdim
  let β (i : Fin 2) : V →ₗ[ZMod 2] ZMod 2 := (b.coord i).comp d
  have hβU (i : Fin 2) : U ≤ (β i).ker := by
    intro u hu
    have hdu : d u = 0 := by
      apply Subtype.ext
      change g u - u = 0
      rw [hg.2.1 u hu, sub_self]
    change b.coord i (d u) = 0
    rw [hdu, map_zero]
  let t (i : Fin 2) : GL V := transvection (b i : V) (β i) (hβU i (hWU.le (b i).property))
  have ht (i : Fin 2) : t i ∈ ⁅radical W, radical U⁆ := by
    rw [show t i = ⁅transvection (b i : V) α (hαW (b i).property),
      transvection y (β i) (hβU i hyU)⁆ from
      (transvection_cross_commutator _ _ _ _ _ _ _ hαy1).symm]
    exact commutator_mem_commutator (transvection_mem (b i).property hαW)
      (transvection_mem hyU (hβU i))
  have he : g = t 0 * t 1 := by
    ext v
    have hsum := congrArg (fun w : W => (w : V)) (b.sum_repr (d v))
    simp only [Fin.sum_univ_two, Submodule.coe_add, Submodule.coe_smul] at hsum
    change β 0 v • (b 0 : V) + β 1 v • (b 1 : V) = g v - v at hsum
    change g v = v + β 1 v • (b 1 : V) + β 0 (v + β 1 v • (b 1 : V)) • (b 0 : V)
    have hβ01 : β 0 (b 1 : V) = 0 := hβU 0 (hWU.le (b 1).property)
    simp only [map_add, map_smul, hβ01, smul_zero, add_zero]
    rw [eq_sub_iff_add_eq] at hsum
    rw [← hsum]
    abel
  rw [he]
  exact mul_mem (ht 0) (ht 1)

end BinaryLinear
