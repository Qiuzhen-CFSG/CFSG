module

public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
public import Mathlib.Data.ZMod.Basic
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Marked root subgroups around a transvection in SL₅(2)

The root I+E₀₄ centralizes the positive unitriangular subgroup. The two
rectangular subgroups, for cuts 2+3 and 3+2, give a concrete candidate for
the missing marked comparison in Aschbacher–Smith 12.7.7. Their normalizers
inside the transvection centralizer are defined literally. The seven row
and column roots define the kernel, and the two marked four-groups are
⟨I+E₀₄,I+E₁₄⟩ and ⟨I+E₀₄,I+E₀₃⟩.

This module proves only the basic containments and that the specified root
is an involution. The Sylow, extraspecial, action, order, normalizer and
extension assertions are not built into the definitions. In particular,
no comparison with the Sylow subgroup of another group is assumed.

Sources: Aschbacher, *Sporadic Groups* (1994), §39 and Theorem 44.4;
Aschbacher–Smith, combined manuscript (1 March 2004), 12.7.7, pp.841–842.
-/

@[expose] public section
open Subgroup
namespace BinaryLinear.TransvectionFiveLocal

/-- The literal binary degree-five special linear group. -/
abbrev SL := Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)

def root {i j : Fin 5} (h : i < j) : SL :=
  Matrix.SpecialLinearGroup.transvection (ne_of_lt h) 1

/-- The elementary transvection I+E₀₄ used in Asc94 44.4. -/
def transvection : SL := root (show (0 : Fin 5) < 4 by decide)

def centralizer : Subgroup SL := Subgroup.centralizer ({transvection} : Set SL)

/-- Generated by all positive elementary roots; the intended Sylow model. -/
def upper : Subgroup SL := closure {a | ∃ (i j : Fin 5) (h : i < j), a = root h}

/-- The seven root directions of the extraspecial kernel. Its structure is
a separate obligation, not part of this definition. -/
def kernel : Subgroup SL :=
  closure {a | ∃ (i j : Fin 5) (h : i < j), (i = 0 ∨ j = 4) ∧ a = root h}

/-- The elementary rectangular root subgroup for the cut k+(5−k). -/
def rectangle (k : ℕ) : Subgroup SL :=
  closure {a | ∃ (i j : Fin 5) (h : i < j), i.val < k ∧ k ≤ j.val ∧ a = root h}

abbrev V := rectangle 2
abbrev U := rectangle 3

/-- The central column factor, with natural action by the middle Levi. -/
def naturalFactor : Subgroup SL :=
  closure {a | ∃ (i : Fin 5) (h : i < 4), a = root h}

/-- The central row factor, with dual action by the middle Levi. -/
def dualFactor : Subgroup SL :=
  closure {a | ∃ (j : Fin 5) (h : 0 < j), a = root h}

def V₁ : Subgroup SL := closure {transvection, root (show (1 : Fin 5) < 4 by decide)}
def U₁ : Subgroup SL := closure {transvection, root (show (0 : Fin 5) < 3 by decide)}

def pointLocal : Subgroup SL := centralizer ⊓ normalizer (V : Set SL)
def planeLocal : Subgroup SL := centralizer ⊓ normalizer (U : Set SL)

theorem transvection_orderOf : orderOf transvection = 2 :=
  orderOf_eq_prime (by decide) (by decide)

theorem kernel_le_upper : kernel ≤ upper := by
  apply closure_mono
  rintro a ⟨i, j, h, _, rfl⟩
  exact ⟨i, j, h, rfl⟩

theorem rectangle_le_upper (k : ℕ) : rectangle k ≤ upper := by
  apply closure_mono
  rintro a ⟨i, j, h, _, _, rfl⟩
  exact ⟨i, j, h, rfl⟩

theorem naturalFactor_le_kernel : naturalFactor ≤ kernel := by
  apply closure_mono
  rintro a ⟨i, h, rfl⟩
  exact ⟨i, 4, h, Or.inr rfl, rfl⟩

theorem dualFactor_le_kernel : dualFactor ≤ kernel := by
  apply closure_mono
  rintro a ⟨j, h, rfl⟩
  exact ⟨0, j, h, Or.inl rfl, rfl⟩

theorem transvection_mem_kernel : transvection ∈ kernel :=
  subset_closure ⟨0, 4, by decide, Or.inl rfl, rfl⟩

/-- Every positive elementary root commutes with I+E₀₄. -/
theorem upper_le_centralizer : upper ≤ centralizer := by
  apply (closure_le centralizer).mpr
  rintro a ⟨i, j, h, rfl⟩
  apply mem_centralizer_singleton_iff.mpr
  exact (by decide : ∀ (i j : Fin 5) (h : i < j),
    root h * transvection = transvection * root h) i j h

end BinaryLinear.TransvectionFiveLocal
