module

public import Theory.SpecificGroups.BinaryLinear.TransvectionFiveLocal.Defs
public import Theory.ElementaryAbelian.ExtraspecialEquiv
import Mathlib.LinearAlgebra.Matrix.Block
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Ring

/-!
# The literal seven-root transvection kernel

Seven binary coordinates give exactly the subgroup generated by the first-row
and last-column roots in SL₅(2). The cross term is the natural pairing of the
three row and three column coordinates. Its center is precisely the marked
transvection line, and its central quotient is elementary abelian. Thus this
literal kernel is extraspecial of order128. This is a model calculation only;
no comparison with an original ambient Sylow subgroup is asserted.

Source: Aschbacher, Sporadic Groups,39.1; the model used in the missing
marked comparison of Aschbacher--Smith12.7.7, printed p.841.
-/

namespace BinaryLinear.TransvectionFiveLocal
open Subgroup
private abbrev F := ZMod 2

@[ext] private structure Coordinates where
  z : F
  a : F
  b : F
  c : F
  d : F
  e : F
  f : F
  deriving DecidableEq

private def coordinatesEquiv : Coordinates ≃ F × F × F × F × F × F × F where
  toFun x := (x.z,x.a,x.b,x.c,x.d,x.e,x.f)
  invFun x := ⟨x.1,x.2.1,x.2.2.1,x.2.2.2.1,x.2.2.2.2.1,x.2.2.2.2.2.1,x.2.2.2.2.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
private instance : Fintype Coordinates := Fintype.ofEquiv _ coordinatesEquiv.symm
private instance coordinateMul : Mul Coordinates := ⟨fun x y =>
  ⟨x.z+y.z+x.a*y.d+x.b*y.e+x.c*y.f,
    x.a+y.a,x.b+y.b,x.c+y.c,x.d+y.d,x.e+y.e,x.f+y.f⟩⟩
private instance coordinateOne : One Coordinates := ⟨⟨0,0,0,0,0,0,0⟩⟩
private instance coordinateInv : Inv Coordinates := ⟨fun x =>
  ⟨-x.z+x.a*x.d+x.b*x.e+x.c*x.f,-x.a,-x.b,-x.c,-x.d,-x.e,-x.f⟩⟩
private instance coordinateGroup : Group Coordinates where
  mul_assoc x y w := by
    apply Coordinates.ext
    · change (x.z+y.z+x.a*y.d+x.b*y.e+x.c*y.f)+w.z+
        (x.a+y.a)*w.d+(x.b+y.b)*w.e+(x.c+y.c)*w.f =
        x.z+(y.z+w.z+y.a*w.d+y.b*w.e+y.c*w.f)+
        x.a*(y.d+w.d)+x.b*(y.e+w.e)+x.c*(y.f+w.f)
      ring
    all_goals exact add_assoc _ _ _
  one_mul x := by
    apply Coordinates.ext
    · change 0+x.z+0*x.d+0*x.e+0*x.f=x.z
      ring
    all_goals exact zero_add _
  mul_one x := by
    apply Coordinates.ext
    · change x.z+0+x.a*0+x.b*0+x.c*0=x.z
      ring
    all_goals exact add_zero _
  inv_mul_cancel x := by
    apply Coordinates.ext
    · change (-x.z+x.a*x.d+x.b*x.e+x.c*x.f)+x.z+
        (-x.a)*x.d+(-x.b)*x.e+(-x.c)*x.f=0
      ring
    all_goals exact neg_add_cancel _

@[simp] private theorem mul_z (x y : Coordinates) : (x*y).z=x.z+y.z+x.a*y.d+x.b*y.e+x.c*y.f := rfl
@[simp] private theorem mul_a (x y : Coordinates) : (x*y).a=x.a+y.a := rfl
@[simp] private theorem mul_b (x y : Coordinates) : (x*y).b=x.b+y.b := rfl
@[simp] private theorem mul_c (x y : Coordinates) : (x*y).c=x.c+y.c := rfl
@[simp] private theorem mul_d (x y : Coordinates) : (x*y).d=x.d+y.d := rfl
@[simp] private theorem mul_e (x y : Coordinates) : (x*y).e=x.e+y.e := rfl
@[simp] private theorem mul_f (x y : Coordinates) : (x*y).f=x.f+y.f := rfl

private def matrix (x : Coordinates) : Matrix (Fin 5) (Fin 5) F :=
  !![1,x.a,x.b,x.c,x.z; 0,1,0,0,x.d; 0,0,1,0,x.e; 0,0,0,1,x.f; 0,0,0,0,1]
private theorem matrix_det (x : Coordinates) : (matrix x).det = 1 := by
  have hu : (matrix x).IsUpperTriangular := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [matrix]
  rw [Matrix.det_of_isUpperTriangular hu]
  simp [matrix,Fin.prod_univ_succ]

private def embedding : Coordinates →* SL where
  toFun x := ⟨matrix x,matrix_det x⟩
  map_one' := by
    apply Subtype.ext
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  map_mul' x y := by
    apply Subtype.ext
    change matrix (x*y)=matrix x * matrix y
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [matrix,Matrix.mul_apply,Fin.sum_univ_succ]
    all_goals ring

private theorem embedding_injective : Function.Injective embedding := by
  intro x y he
  have hm := congrArg Subtype.val he
  exact Coordinates.ext
    (congrFun (congrFun hm 0) 4)
    (congrFun (congrFun hm 0) 1)
    (congrFun (congrFun hm 0) 2)
    (congrFun (congrFun hm 0) 3)
    (congrFun (congrFun hm 1) 4)
    (congrFun (congrFun hm 2) 4)
    (congrFun (congrFun hm 3) 4)

private theorem parameter_mem (i j : Fin 5) (h : i < j)
    (hr : i=0 ∨ j=4) (v : F) :
    Matrix.SpecialLinearGroup.transvection (ne_of_lt h) v ∈ kernel := by
  rcases (by decide : ∀ v : F, v=0 ∨ v=1) v with hv | hv
  · rw [hv,Matrix.SpecialLinearGroup.transvection_coeff_zero]
    exact one_mem _
  · rw [hv]
    exact subset_closure ⟨i,j,h,hr,rfl⟩

private def atom (i : Fin 7) (v : F) : Coordinates :=
  match i.val with
  | 0 => ⟨v,0,0,0,0,0,0⟩
  | 1 => ⟨0,v,0,0,0,0,0⟩
  | 2 => ⟨0,0,v,0,0,0,0⟩
  | 3 => ⟨0,0,0,v,0,0,0⟩
  | 4 => ⟨0,0,0,0,v,0,0⟩
  | 5 => ⟨0,0,0,0,0,v,0⟩
  | _ => ⟨0,0,0,0,0,0,v⟩

private theorem atom_mem (i : Fin 7) (v : F) : embedding (atom i v) ∈ kernel := by
  fin_cases i
  · change embedding (atom 0 v) ∈ kernel
    have he : embedding (atom 0 v) = Matrix.SpecialLinearGroup.transvection
        (by decide : (0:Fin 5)≠4) v := by
      apply Subtype.ext
      change matrix (atom 0 v) = _
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [matrix,atom,Matrix.SpecialLinearGroup.transvection_coe,
          Matrix.single]
    rw [he]
    exact parameter_mem 0 4 (by decide) (by simp) v
  · change embedding (atom 1 v) ∈ kernel
    have he : embedding (atom 1 v) = Matrix.SpecialLinearGroup.transvection
        (by decide : (0:Fin 5)≠1) v := by
      apply Subtype.ext
      change matrix (atom 1 v) = _
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [matrix,atom,Matrix.SpecialLinearGroup.transvection_coe,
          Matrix.single]
    rw [he]
    exact parameter_mem 0 1 (by decide) (by simp) v
  · change embedding (atom 2 v) ∈ kernel
    have he : embedding (atom 2 v) = Matrix.SpecialLinearGroup.transvection
        (by decide : (0:Fin 5)≠2) v := by
      apply Subtype.ext
      change matrix (atom 2 v) = _
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [matrix,atom,Matrix.SpecialLinearGroup.transvection_coe,
          Matrix.single]
    rw [he]
    exact parameter_mem 0 2 (by decide) (by simp) v
  · change embedding (atom 3 v) ∈ kernel
    have he : embedding (atom 3 v) = Matrix.SpecialLinearGroup.transvection
        (by decide : (0:Fin 5)≠3) v := by
      apply Subtype.ext
      change matrix (atom 3 v) = _
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [matrix,atom,Matrix.SpecialLinearGroup.transvection_coe,
          Matrix.single]
    rw [he]
    exact parameter_mem 0 3 (by decide) (by simp) v
  · change embedding (atom 4 v) ∈ kernel
    have he : embedding (atom 4 v) = Matrix.SpecialLinearGroup.transvection
        (by decide : (1:Fin 5)≠4) v := by
      apply Subtype.ext
      change matrix (atom 4 v) = _
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [matrix,atom,Matrix.SpecialLinearGroup.transvection_coe,
          Matrix.single]
    rw [he]
    exact parameter_mem 1 4 (by decide) (by simp) v
  · change embedding (atom 5 v) ∈ kernel
    have he : embedding (atom 5 v) = Matrix.SpecialLinearGroup.transvection
        (by decide : (2:Fin 5)≠4) v := by
      apply Subtype.ext
      change matrix (atom 5 v) = _
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [matrix,atom,Matrix.SpecialLinearGroup.transvection_coe,
          Matrix.single]
    rw [he]
    exact parameter_mem 2 4 (by decide) (by simp) v
  · change embedding (atom 6 v) ∈ kernel
    have he : embedding (atom 6 v) = Matrix.SpecialLinearGroup.transvection
        (by decide : (3:Fin 5)≠4) v := by
      apply Subtype.ext
      change matrix (atom 6 v) = _
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [matrix,atom,Matrix.SpecialLinearGroup.transvection_coe,
          Matrix.single]
    rw [he]
    exact parameter_mem 3 4 (by decide) (by simp) v

private theorem embedding_mem (x : Coordinates) : embedding x ∈ kernel := by
  have hx : x = atom 4 x.d * atom 5 x.e * atom 6 x.f *
      atom 1 x.a * atom 2 x.b * atom 3 x.c * atom 0 x.z := by
    apply Coordinates.ext <;>
      simp [atom]
  rw [hx]
  simp only [map_mul]
  repeat' apply kernel.mul_mem
  all_goals exact atom_mem _ _

private theorem embedding_range : embedding.range=kernel := by
  apply le_antisymm
  · rintro _ ⟨x,rfl⟩
    exact embedding_mem x
  · apply (closure_le embedding.range).mpr
    rintro g ⟨i,j,h,hr,rfl⟩
    have hc : ∀ (i j : Fin 5) (h : i<j), (i=0 ∨ j=4) →
        ∃ k : Fin 7, embedding (atom k 1) = root h := by decide +kernel
    obtain ⟨k,hk⟩ := hc i j h hr
    exact ⟨atom k 1,hk⟩

private noncomputable def kernelEquiv : Coordinates ≃* kernel :=
  (MonoidHom.ofInjective embedding_injective).trans
    (MulEquiv.subgroupCongr embedding_range)

private theorem coordinates_card : Nat.card Coordinates=128 := by
  rw [Nat.card_congr coordinatesEquiv]
  simp

private theorem center_iff (x : Coordinates) : x ∈ center Coordinates ↔
    x.a=0 ∧ x.b=0 ∧ x.c=0 ∧ x.d=0 ∧ x.e=0 ∧ x.f=0 := by
  rw [mem_center_iff]
  revert x
  decide +kernel

private def centerEquiv : center Coordinates ≃ F where
  toFun x := x.val.z
  invFun z := ⟨⟨z,0,0,0,0,0,0⟩,(center_iff _).mpr ⟨rfl,rfl,rfl,rfl,rfl,rfl⟩⟩
  left_inv x := by
    apply Subtype.ext
    obtain ⟨ha,hb,hc,hd,he,hf⟩ := (center_iff x.val).mp x.property
    apply Coordinates.ext
    · rfl
    all_goals first | exact ha.symm | exact hb.symm | exact hc.symm |
      exact hd.symm | exact he.symm | exact hf.symm
  right_inv _ := rfl

private theorem center_card : Nat.card (center Coordinates)=2 :=
  (Nat.card_congr centerEquiv).trans (Nat.card_zmod 2)

private theorem square_central (x : Coordinates) : x^2 ∈ center Coordinates := by
  rw [center_iff]
  revert x
  decide +kernel

private theorem coordinates_extraspecial : IsExtraspecial 2 Coordinates := by
  have hs (q : Coordinates ⧸ center Coordinates) : q^2=1 := by
    induction q using QuotientGroup.induction_on with
    | H x =>
      rw [←QuotientGroup.mk_pow,QuotientGroup.eq_one_iff]
      exact square_central x
  have hi (q : Coordinates ⧸ center Coordinates) : q⁻¹=q :=
    inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hs q)
  refine ⟨center_card,?_,QuotientGroup.nontrivial_iff.mpr ?_⟩
  · refine { is_comm := ⟨?_⟩
             exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hs }
    intro a b
    simpa only [hi] using mul_inv_rev a b
  · intro ht
    have hh := center_card
    rw [ht,Nat.card_congr topEquiv.toEquiv,coordinates_card] at hh
    exact (by decide : ¬ (128 : ℕ)=2) hh

/-- The actual subgroup generated by the seven marked roots has order128. -/
public theorem kernel_card : Nat.card kernel=128 :=
  (Nat.card_congr kernelEquiv.toEquiv).symm.trans coordinates_card

/-- The literal seven-root subgroup is extraspecial, with its full central quotient. -/
public theorem kernel_extraspecial : IsExtraspecial 2 kernel :=
  IsExtraspecial.of_mulEquiv kernelEquiv coordinates_extraspecial

/-- Its embedded center is exactly the original marked transvection line. -/
public theorem kernel_center : (center kernel).map kernel.subtype = zpowers transvection := by
  have ht : transvection ∈ (center kernel).map kernel.subtype := by
    refine ⟨⟨transvection,transvection_mem_kernel⟩,mem_center_iff.mpr ?_,rfl⟩
    intro x
    apply Subtype.ext
    exact mem_centralizer_singleton_iff.mp
      (upper_le_centralizer (kernel_le_upper x.property))
  apply Eq.symm
  apply eq_of_le_of_card_ge (zpowers_le.mpr ht)
  rw [card_map_of_injective kernel.subtype_injective,
    kernel_extraspecial.center_order_p, Nat.card_zpowers,transvection_orderOf]

end BinaryLinear.TransvectionFiveLocal
