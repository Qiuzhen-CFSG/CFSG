module
public import Theory.SpecificGroups.BinaryLinear.FiveFlagGeometry.MaximalOvergroups

/-!
# Choosing an escaping rank-one binary parabolic

For a fixed Sylow two-subgroup of GL₅(2), the genuine overgroup theorem
identifies its overgroups with subsets of the four flag cuts. Deleting one
cut gives a cover of the Sylow. If a Sylow overgroup C is not contained in
another overgroup D, one of these covers lies in C and escapes D.

A normal two-group kernel lies in the prescribed Sylow. The subgroup
correspondence therefore lifts both cover minimality and escape through
any surjection with such a kernel. Reconstructing the full flag from its
invariant subspaces also proves that the prescribed Sylow is self-normalizing.

Source: Aschbacher--Smith, the rank-one parabolic choice in 10.2.9,
printed p.753, combined manuscript of 1 March 2004.
-/

@[expose] public noncomputable section
open Subgroup BinaryLinear.OuterCyclic
namespace BinaryLinear.FiveFlagGeometry
open MaximalOvergroups SylowOvergroups

private theorem fullFlag_covBy_node (b : FiveBasis) (i : Fin 4) :
    flagStabilizer b Set.univ ⋖ flagStabilizer b {i}ᶜ := by
  have hlt : flagStabilizer b Set.univ < flagStabilizer b {i}ᶜ := by
    apply lt_iff_le_not_ge.mpr
    constructor
    · exact (flag_le_iff b _ _).mpr (Set.subset_univ _)
    · intro h
      exact ((flag_le_iff b _ _).mp h (Set.mem_univ i)) (Set.mem_singleton i)
  refine ⟨hlt,?_⟩
  intro Q hBQ hQP
  obtain ⟨s,hs⟩ := overgroup_eq_flag b Q hBQ.le
  have hslo : {i}ᶜ ⊆ s := (flag_le_iff b _ _).mp (hs.symm.le.trans hQP.le)
  have hi : i ∈ s := by
    by_contra hi
    have hsub : s ⊆ {i}ᶜ := by
      intro j hj hji
      exact hi (hji ▸ hj)
    have he : s = {i}ᶜ := Set.Subset.antisymm hsub hslo
    exact hQP.ne (hs.trans (congrArg (flagStabilizer b) he))
  have hall : s = Set.univ := by
    apply Set.eq_univ_of_forall
    intro j
    by_cases hj : j = i
    · exact hj ▸ hi
    · exact hslo hj
  exact hBQ.ne (hs.trans (congrArg (flagStabilizer b) hall)).symm

/-- A Sylow overgroup escaping D contains a rank-one Sylow overgroup escaping D.
This uses the genuine flag lattice, not an assumption that arbitrary subgroup
lattices are generated by their atoms. -/
theorem exists_rankOne_escaping (S : Sylow 2 (LinearGroup 5))
    (C D : Subgroup (LinearGroup 5)) (hSC : (S : Subgroup _) ≤ C)
    (hSD : (S : Subgroup _) ≤ D) (hCD : ¬ C ≤ D) :
    ∃ P : Subgroup (LinearGroup 5), (S : Subgroup _) ⋖ P ∧ P ≤ C ∧ ¬ P ≤ D := by
  obtain ⟨b,hb⟩ := sylow_eq_flagStabilizer S
  obtain ⟨s,hs⟩ := overgroup_eq_flag b C (hb ▸ hSC)
  obtain ⟨d,hd⟩ := overgroup_eq_flag b D (hb ▸ hSD)
  have hds : ¬ d ⊆ s := by
    intro h
    apply hCD
    rw [hs,hd,flag_le_iff]
    exact h
  obtain ⟨i,hid,his⟩ := Set.not_subset.mp hds
  refine ⟨flagStabilizer b {i}ᶜ,hb ▸ fullFlag_covBy_node b i,?_,?_⟩
  · rw [hs,flag_le_iff]
    intro j hjs hji
    exact his (hji ▸ hjs)
  · intro h
    rw [hd,flag_le_iff] at h
    exact h hid (Set.mem_singleton i)

/-- The rank-one choice lifts through a two-group kernel. In particular the
lower endpoint is the prescribed full Sylow, not an arbitrary two-subgroup. -/
theorem exists_rankOne_escaping_of_two_kernel {H : Type*} [Group H] [Finite H]
    (f : H →* LinearGroup 5) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) (S : Sylow 2 H) (C D : Subgroup H)
    (hSC : (S : Subgroup H) ≤ C) (hSD : (S : Subgroup H) ≤ D) (hCD : ¬ C ≤ D) :
    ∃ P : Subgroup H, (S : Subgroup H) ⋖ P ∧ P ≤ C ∧ ¬ P ≤ D := by
  have hker : f.ker ≤ (S : Subgroup H) := hk.le_sylow_of_normal S
  have himage : ¬ C.map f ≤ D.map f := by
    intro h
    apply hCD
    have hh := comap_mono (f := f) h
    rw [comap_map_eq,comap_map_eq,sup_of_le_left (hker.trans hSC),
      sup_of_le_left (hker.trans hSD)] at hh
    exact hh
  obtain ⟨P,hcov,hPC,hPD⟩ := exists_rankOne_escaping
    (S.mapSurjective hf) (C.map f) (D.map f) (map_mono hSC) (map_mono hSD) himage
  have hSP : (S : Subgroup H) ≤ P.comap f := map_le_iff_le_comap.mp hcov.le
  have hPker : f.ker ≤ P.comap f := hker.trans hSP
  refine ⟨P.comap f,?_,?_,?_⟩
  · apply covBy_iff_lt_and_eq_or_eq.mpr
    constructor
    · refine lt_of_le_of_ne hSP ?_
      intro he
      have hh := congrArg (Subgroup.map f) he
      rw [map_comap_eq_self_of_surjective hf] at hh
      exact hcov.ne hh
    · intro X hSX hXP
      have hh := (covBy_iff_lt_and_eq_or_eq.mp hcov).2 (X.map f)
        (map_mono hSX) ((map_mono hXP).trans_eq (map_comap_eq_self_of_surjective hf P))
      rcases hh with h | h
      · exact Or.inl (map_injective_of_ker_le f (hker.trans hSX) hker h)
      · apply Or.inr
        apply map_injective_of_ker_le f (hker.trans hSX) hPker
        rwa [map_comap_eq_self_of_surjective hf]
  · have hh := comap_mono (f := f) hPC
    rw [comap_map_eq,sup_of_le_left (hker.trans hSC)] at hh
    exact hh
  · intro h
    apply hPD
    have hh := map_mono (f := f) h
    rwa [map_comap_eq_self_of_surjective hf] at hh

/-- A binary full flag has no extra normalizer: dimensions distinguish its
four invariant cuts and their preservation fixes the whole flag. -/
theorem normalizer_sylow_eq (S : Sylow 2 (LinearGroup 5)) :
    normalizer ((S : Subgroup (LinearGroup 5)) : Set (LinearGroup 5)) = S := by
  obtain ⟨b,hb⟩ := sylow_eq_flagStabilizer S
  apply le_antisymm _ (S : Subgroup (LinearGroup 5)).le_normalizer
  intro g hg
  have he := mem_normalizer_iff_map_conj_eq.mp hg
  change (S : Subgroup (LinearGroup 5)).map (MulAut.conj g).toMonoidHom = S at he
  rw [hb,flagStabilizer_map_conj] at he
  rw [hb,mem_flagStabilizer_iff]
  intro i _ v
  have hspace : flagSpace b i = flagSpace (b.map g) i :=
    (BinaryLinear.InvariantNodeActions.cutSpace_eq_of_fullFlag_le b (b.map g)
      Set.univ he.symm.le i (Set.mem_univ i)).symm
  rw [flagSpace_map] at hspace
  constructor
  · intro hv
    rw [hspace] at hv
    obtain ⟨w,hw,he⟩ := hv
    exact g.injective he ▸ hw
  · intro hv
    rw [hspace]
    exact ⟨v,hv,rfl⟩

/-- The same normalizer equality survives a two-group kernel. -/
theorem normalizer_sylow_eq_of_two_kernel {H : Type*} [Group H] [Finite H]
    (f : H →* LinearGroup 5) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) (S : Sylow 2 H) :
    normalizer ((S : Subgroup H) : Set H) = S := by
  have hker : f.ker ≤ (S : Subgroup H) := hk.le_sylow_of_normal S
  apply le_antisymm _ (S : Subgroup H).le_normalizer
  intro x hx
  have hm : f x ∈ normalizer ((S : Subgroup H).map f : Set (LinearGroup 5)) :=
    (S : Subgroup H).le_normalizer_map f (mem_map_of_mem f hx)
  have he := normalizer_sylow_eq (S.mapSurjective hf)
  change normalizer ((S : Subgroup H).map f : Set (LinearGroup 5)) =
    (S : Subgroup H).map f at he
  rw [he] at hm
  have hx' : x ∈ ((S : Subgroup H).map f).comap f := hm
  rwa [comap_map_eq,sup_of_le_left hker] at hx'

end BinaryLinear.FiveFlagGeometry
