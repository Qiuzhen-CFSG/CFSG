module
public import Theory.SpecificGroups.BinaryLinear.FiveFlagGeometry.SylowOvergroups
public import Theory.GroupTheory.PResidual.PrimeToMonotone
public import Theory.GroupTheory.PResidual.PrimeToTransport

/-!
# Cubic residual supplements in binary five-dimensional parabolics

Every subgroup of GL₅(2) containing a Sylow two-subgroup is generated by
that Sylow subgroup and its three-prime residual. In standard coordinates,
Bruhat exhaustion identifies both the subgroup and the proposed supplement
as partial-flag stabilizers. An absent cut contributes an adjacent swap;
its product with the corresponding upper transvection has cube one. Thus
the residual supplies every missing swap. Conjugation handles an arbitrary
Sylow, and a two-kernel quotient lifts the result without changing subgroups.

The concrete consumer is the plane-centralizer equality in the constrained
branch of Aschbacher--Smith 10.2.9, printed pp.752--753. This calculation
works for every partial flag, before selecting the rank-five or rank-ten
module.
-/

public section
open Subgroup
namespace BinaryLinear.FiveFlagGeometry
open OuterCyclic SylowOvergroups

private noncomputable def upperRoot (k : Fin 4) : LinearGroup 5 :=
  slEquivLinear 5 (Matrix.SpecialLinearGroup.transvection
    (show k.castSucc ≠ k.succ by simp [Fin.ext_iff]) (1 : ZMod 2))

private lemma upperRoot_apply (k : Fin 4) (v : Space 5) :
    upperRoot k v = v + Pi.single k.castSucc (v k.succ) := by
  simp only [upperRoot, slEquivLinear_apply, Matrix.SpecialLinearGroup.transvection_coe,
    Matrix.add_mulVec, Matrix.single_mulVec_eq, Matrix.one_mulVec]
  congr 1
  ext i
  by_cases hi : i = k.castSucc <;> simp [hi]

private lemma upperRoot_basis (k : Fin 4) (j : Fin 5) :
    upperRoot k (standardBasis j) =
      if j = k.succ then standardBasis j + standardBasis k.castSucc else standardBasis j := by
  rw [upperRoot_apply]
  by_cases h : j = k.succ
  · subst j
    simp [standardBasis, Pi.basisFun_apply]
  · simp [h, standardBasis, Pi.basisFun_apply, Ne.symm h]

private lemma upperRoot_mem (k : Fin 4) : upperRoot k ∈ standardBorel := by
  apply (mem_standardBorel_iff _).mpr
  intro i j hji
  have hm : matrix (upperRoot k) = 1 + Matrix.single k.castSucc k.succ 1 := by
    simp [matrix, upperRoot, Matrix.SpecialLinearGroup.transvection_coe]
  rw [hm]
  simp only [Matrix.add_apply, Matrix.one_apply, Matrix.single_apply]
  change j.val < i.val at hji
  have hij : i ≠ j := by intro h; subst j; omega
  have hs : ¬ (k.castSucc = i ∧ k.succ = j) := by
    rintro ⟨rfl,rfl⟩
    simp only [Fin.val_castSucc,Fin.val_succ] at hji
    omega
  simp [hij,hs]

private lemma swap_mem_iff (cuts : Set (Fin 4)) (k : Fin 4) :
    permutation (Equiv.swap k.castSucc k.succ) ∈ flagStabilizer standardBasis cuts ↔
      k ∉ cuts := by
  constructor
  · intro hs hk
    have h := ((mem_flagStabilizer_iff _ _ _).mp hs k hk (standardBasis k.castSucc)).mpr
      ((basis_mem_flagSpace_iff _ _ _).mpr le_rfl)
    rw [permutation_basis, Equiv.swap_apply_left, basis_mem_flagSpace_iff] at h
    simp at h
  · intro hk
    apply (mem_standard_flagStabilizer_iff _ _).mpr
    intro r hr i j hi hj
    rw [matrix_apply, permutation_basis]
    have hne : i ≠ Equiv.swap k.castSucc k.succ j := by
      intro he
      subst i
      by_cases h₁ : j = k.castSucc
      · subst j
        rw [Equiv.swap_apply_left] at hi
        have hrk : r = k := Fin.ext (by simp only [Fin.val_succ, Fin.val_castSucc] at *; omega)
        exact hk (hrk ▸ hr)
      · by_cases h₂ : j = k.succ
        · subst j
          rw [Equiv.swap_apply_right] at hi
          simp only [Fin.val_succ, Fin.val_castSucc] at *
          omega
        · rw [Equiv.swap_apply_of_ne_of_ne h₁ h₂] at hi
          omega
    simp [standardBasis, Pi.basisFun_apply, hne]

private lemma root_swap_cube (k : Fin 4) :
    (upperRoot k * permutation (Equiv.swap k.castSucc k.succ)) ^ 3 = 1 := by
  apply standardBasis.ext'
  intro j
  change upperRoot k (permutation _ (upperRoot k (permutation _
    (upperRoot k (permutation _ (standardBasis j)))))) = standardBasis j
  have hn : k.castSucc ≠ k.succ := by simp [Fin.ext_iff]
  by_cases h₁ : j = k.castSucc
  · subst j
    simp only [permutation_basis, Equiv.swap_apply_left, upperRoot_basis, if_true,
      map_add, Equiv.swap_apply_right, if_neg hn]
    ext r
    simp only [Pi.add_apply]
    ring_nf
    simp only [show (2 : ZMod 2) = 0 by decide, show (3 : ZMod 2) = 1 by decide,
      mul_zero, mul_one, zero_add]
  · by_cases h₂ : j = k.succ
    · subst j
      simp only [permutation_basis, Equiv.swap_apply_right, upperRoot_basis, if_neg hn,
        Equiv.swap_apply_left, if_true, map_add]
      ext r
      simp only [Pi.add_apply]
      ring_nf
      simp only [show (2 : ZMod 2) = 0 by decide, mul_zero, zero_add]
    · simp only [permutation_basis, Equiv.swap_apply_of_ne_of_ne h₁ h₂,
        upperRoot_basis, if_neg h₂]

private theorem standard_cubic_generation (P Q : Subgroup (LinearGroup 5))
    (hBP : standardBorel ≤ P) (hBQ : standardBorel ≤ Q) (hQP : Q ≤ P)
    (hc : ∀ x ∈ P, x ^ 3 = 1 → x ∈ Q) : Q = P := by
  obtain ⟨pc,hpc⟩ := standard_overgroups_of_bruhat hasBruhatDecomposition P hBP
  obtain ⟨qc,hqc⟩ := standard_overgroups_of_bruhat hasBruhatDecomposition Q hBQ
  apply le_antisymm hQP
  rw [hpc,hqc]
  apply flagStabilizer_antitone
  intro k hk
  by_contra hn
  have hs : permutation (Equiv.swap k.castSucc k.succ) ∈ P := by
    rw [hpc]
    exact (swap_mem_iff pc k).mpr hn
  have hx : upperRoot k * permutation (Equiv.swap k.castSucc k.succ) ∈ Q :=
    hc _ (P.mul_mem (hBP (upperRoot_mem k)) hs) (root_swap_cube k)
  have hsQ := (Q.mul_mem_cancel_left (hBQ (upperRoot_mem k))).mp hx
  rw [hqc] at hsQ
  exact ((swap_mem_iff qc k).mp hsQ) hk

/-- A Sylow overgroup is generated by the Sylow subgroup and its cubic
prime-to residual. This includes all partial flag types. -/
theorem embedded_primeToResidual_sup_sylow (S : Sylow 2 (LinearGroup 5))
    (P : Subgroup (LinearGroup 5)) (hSP : (S : Subgroup _) ≤ P) :
    (primeToResidual 3 P).map P.subtype ⊔ (S : Subgroup _) = P := by
  let : Finite (LinearGroup 5) :=
    Finite.of_injective (fun g : LinearGroup 5 => (g : Space 5 → Space 5))
      DFunLike.coe_injective
  have hstandard (P : Subgroup (LinearGroup 5)) (hBP : standardBorel ≤ P) :
      (primeToResidual 3 P).map P.subtype ⊔ standardBorel = P := by
    apply standard_cubic_generation P _ hBP le_sup_right (sup_le (map_subtype_le _) hBP)
    intro x hx hpow
    apply (le_sup_left : (primeToResidual 3 P).map P.subtype ≤ _)
    refine ⟨⟨x,hx⟩, mem_primeToResidual_of_pow (n := 1) ?_, rfl⟩
    exact Subtype.ext (by simpa using hpow)
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq (LinearGroup 5) standardSylow S
  have hS : standardBorel.map (MulAut.conj g).toMonoidHom = (S : Subgroup _) := by
    change ((g • standardSylow : Sylow 2 (LinearGroup 5)) : Subgroup (LinearGroup 5)) = _
    rw [hg]
  let e := MulAut.conj g
  let Q := P.map e.symm.toMonoidHom
  have hBQ : standardBorel ≤ Q := by
    intro x hx
    apply mem_map_equiv.mpr
    apply hSP
    rw [←hS]
    exact mem_map_of_mem _ hx
  have hQP : Q.map e.toMonoidHom = P :=
    (Subgroup.map_symm_eq_iff_map_eq Q (e := e) (H := P)).mp rfl
  have h := congrArg (Subgroup.map e.toMonoidHom) (hstandard Q hBQ)
  rw [Subgroup.map_sup, map_embedded_primeToResidual_of_hom, hQP, hS] at h
  exact h

/-- Lift the supplement through a two-kernel quotient, retaining its actual
Sylow and subgroup. This is the form used on the original point centralizer. -/
theorem embedded_primeToResidual_sup_sylow_of_two_kernel
    {H : Type*} [Group H] [Finite H]
    (f : H →* LinearGroup 5) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) (S : Sylow 2 H) (P : Subgroup H)
    (hSP : (S : Subgroup H) ≤ P) :
    (primeToResidual 3 P).map P.subtype ⊔ (S : Subgroup H) = P := by
  have hkS := hk.le_sylow_of_normal S
  apply map_injective_of_ker_le f (hkS.trans le_sup_right) (hkS.trans hSP)
  rw [Subgroup.map_sup,map_embedded_primeToResidual_of_hom]
  exact embedded_primeToResidual_sup_sylow (S.mapSurjective hf) (P.map f)
    (map_mono hSP)

end BinaryLinear.FiveFlagGeometry
