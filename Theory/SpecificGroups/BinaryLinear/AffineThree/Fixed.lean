module

public import Theory.SpecificGroups.BinaryLinear.AffineThree.Actions

/-!
# The distinguished cubic Sylow subgroup and its fixed core

The affine centralizer has order 192, so the explicit block-diagonal cubic
generates a Sylow three-subgroup. Its fixed subgroup in the intrinsic two-core
is exactly the line generated by the marked first-coordinate translation.
This proves the literal fixed-subgroup condition of I.4.6(b), p.417.
-/

@[expose] public section
open Subgroup
namespace BinaryLinear.Affine.ThreeLocal
open ThreeCore

def centralPoint : Q := ⟨1,0,0,0,0⟩
def point : H := embed centralPoint

theorem point_marking : (point : Model 3) = SemidirectProduct.inl e0 := by
  apply SemidirectProduct.ext
  · rfl
  · apply Subtype.ext
    ext i j
    fin_cases i <;> fin_cases j <;> rfl

theorem centralPoint_order : orderOf centralPoint = 2 := by
  apply orderOf_eq_prime
  · decide +kernel
  · decide +kernel

theorem center_eq_zpowers : center Q = zpowers centralPoint := by
  have hz : centralPoint ∈ center Q := (center_iff _).mpr ⟨rfl,rfl,rfl,rfl⟩
  symm
  apply eq_of_le_of_card_ge (zpowers_le.mpr hz)
  rw [Nat.card_zpowers, centralPoint_order, center_card]

theorem card_H : Nat.card H = 192 := by
  have h := (pCore 2 H).index_mul_card
  have hq : (pCore 2 H).index = 6 := by
    rw [index_eq_card, Nat.card_congr quotientEquiv.toEquiv]
    simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  rw [hq,core_card] at h
  exact h.symm

noncomputable def cubicSylow : Sylow 3 H := by
  have hc : Nat.card (zpowers cubicActor) = 3 := by
    rw [Nat.card_zpowers,cubicActor_order]
  refine (IsPGroup.of_card (G := zpowers cubicActor) (p := 3) (n := 1) (by simpa only [pow_one] using hc)).toSylow ?_
  have hi := (zpowers cubicActor).index_mul_card
  rw [hc,card_H] at hi
  have hh : (zpowers cubicActor).index = 64 := by omega
  rw [hh]
  decide

theorem cubic_fixed : pCore 2 H ⊓ centralizer (cubicSylow : Set H) = zpowers point := by
  have hc : centralizer (cubicSylow : Set H) = centralizer ({cubicActor} : Set H) := by
    change centralizer (zpowers cubicActor : Set H) = _
    rw [zpowers_eq_closure,centralizer_closure]
  have hr : embed.range = pCore 2 H := range_embed.trans kernel_eq_core
  have he : pCore 2 H ⊓ centralizer ({cubicActor} : Set H) = (center Q).map embed := by
    ext x
    constructor
    · rintro ⟨hx,hc⟩
      obtain ⟨q,rfl⟩ := hr.symm ▸ hx
      have hcomm := mem_centralizer_singleton_iff.mp hc
      rw [cubic_intertwines] at hcomm
      have hfix := embed_injective (mul_right_cancel hcomm)
      exact ⟨q,(cubic_fixed_iff q).mp hfix.symm,rfl⟩
    · rintro ⟨q,hq,rfl⟩
      refine ⟨hr ▸ (show embed q ∈ embed.range from ⟨q,rfl⟩), ?_⟩
      apply mem_centralizer_singleton_iff.mpr
      rw [cubic_intertwines, (cubic_fixed_iff q).mpr hq]
  rw [hc,he,center_eq_zpowers,MonoidHom.map_zpowers]
  rfl

end BinaryLinear.Affine.ThreeLocal
