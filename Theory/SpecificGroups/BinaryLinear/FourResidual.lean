module

public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Theory.PGroupCore
public import Theory.AtlasPort.ExceptionalIsomorphisms.Order20160A8
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple

/-!
# Prime-to-three generation of a binary linear four cover

A finite two-perfect group with two-core quotient SL₄(2) is its own
prime-to-three residual. The checked A₈ comparison supplies simplicity and
the quotient order is divisible by three. The general simple-quotient
residual theorem then absorbs the two-core.

This is the intrinsic residual calculation needed in Aschbacher–Smith,
combined manuscript of 1 March 2004, 13.6.23(1), printed p.933. Identifying
the ambient centralizer residual additionally requires relative subnormality
and prime-to-three index; this theorem does not assume or assert those.
The imported exceptional comparison retains its ATLAS attribution and license.
-/

public section
open Subgroup
open scoped MatrixGroups

namespace BinaryLinear

/-- A two-perfect cover of the actual SL₄(2) model is generated by its
three-elements, even when its two-core is nontrivial. -/
theorem primeToResidual_three_eq_top_of_four_quotient
    {H : Type*} [Group H] [Finite H] (hH : IsPPerfect 2 H)
    (e : H ⧸ pCore 2 H ≃* SL(4, ZMod 2)) :
    primeToResidual 3 H = ⊤ := by
  let eA := e.trans (Atlas.Order20160A8.sl4TwoEquivPSL.trans
    Atlas.Comparisons.Exceptional.psl4TwoEquivAlt8)
  let : IsSimpleGroup (alternatingGroup (Fin 8)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup (H ⧸ pCore 2 H) := eA.isSimpleGroup
  apply primeToResidual_eq_top_of_simple_quotient 3 2 (pCore 2 H)
    pCore_isPGroup hH
  rw [Nat.card_congr e.toEquiv, Atlas.Order20160A8.sl4Two_card]
  decide

end BinaryLinear
