module

public import Theory.SpecificGroups.BinaryLinear.OrderedResidualConjugators.ResidualUpper.Generation

/-!
# Recognition of binary minimal-parabolic two-residuals

The literal minimal flag stabilizer is generated by the upper elementary
matrices and its one lower simple root. The cubic actor and incident roots
form a normal subgroup of this elementary group, and the quotient is a
two-group. Thus they generate exactly the embedded two-residual.

The argument is uniform in the dimension, and in particular covers the
source dimensions three, four and five. Substituting the equality into
the explicit-root calculation proves the successive residual-join identity.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
Lemma 12.8.10(5), printed p.854 (PDF p.871), `refs/quasithin.pdf`.
-/

public section

namespace BinaryLinear.OrderedResidualConjugators
open OuterCyclic InvariantNodeActions

/-- Relative normality in the actual minimal parabolic. -/
theorem rootNode_normal_minimalParabolic {m : ℕ} (b : Basis m) (i : Fin m) :
    ((rootNode b i).subgroupOf (minimalParabolic b i)).Normal := by
  rw [ResidualUpper.minimalParabolic_eq_elementaryParabolic]
  exact ResidualUpper.rootNode_normal_elementaryParabolic b i

/-- Every element of the intrinsic two-residual is generated by the cubic
actor and the incident roots. -/
theorem nodeResidual_le_rootNode {m : ℕ} (b : Basis m) (i : Fin m) :
    nodeResidual b i ≤ rootNode b i :=
  ResidualUpper.nodeResidual_le_of_elementary_generation b i
    (ResidualUpper.minimalParabolic_le_elementaryParabolic b i)

/-- Exact recognition of the embedded two-residual of the literal node. -/
theorem nodeResidual_eq_rootNode {m : ℕ} (b : Basis m) (i : Fin m) :
    nodeResidual b i = rootNode b i :=
  le_antisymm (nodeResidual_le_rootNode b i) (rootNode_le_nodeResidual b i)

/-- The source's initial residual joins are exactly the explicit root joins. -/
theorem initialResiduals_eq_initialRootNodes {m : ℕ} (b : Basis m) (r : ℕ) :
    initialResiduals b r = initialRootNodes b r := by
  apply iSup_congr
  intro i
  apply iSup_congr
  intro _
  exact nodeResidual_eq_rootNode b i

/-- The proved residual recognition discharges the model premise of the
successive-join calculation, with the specified right conjugation. -/
theorem initialResiduals_successor {m : ℕ} (b : Basis m) (r : ℕ)
    (hpos : 1 ≤ r) (hr : r < m) :
    initialResiduals b (r + 1) = initialResiduals b r ⊔
      (initialResiduals b r).map (MulAut.conj ((adjacentSwap b ⟨r, hr⟩)⁻¹)).toMonoidHom :=
  initialResiduals_successor_of_nodeResidual_le b (nodeResidual_le_rootNode b) r hpos hr

end BinaryLinear.OrderedResidualConjugators
