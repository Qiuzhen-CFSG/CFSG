module
public import Theory.SpecificGroups.BinaryLinear.OrderedResidualConjugators.ResidualUpper
public import Theory.GroupTheory.PResidual.TwoKernelComparison

/-!
# Cubic residuals of the binary minimal parabolics

A binary minimal flag stabilizer is generated by the full flag stabilizer
and the cubic actor on its omitted two-dimensional block. The flag group
is a two-group, so the prime-to-three residual supplements it and absorbs
the two-residual. The converse containment holds in every finite group.
Thus the two residuals coincide on each literal minimal parabolic.

This is the residual calculation placing the selected Y₂ and Y₃ in
L₀ = O^{3′}(M_L) in Aschbacher--Smith, 15.1.29, printed pp.1103--1104
of `refs/quasithin.pdf`.
-/

public section
open Subgroup
open BinaryLinear BinaryLinear.OuterCyclic BinaryLinear.InvariantNodeActions
open BinaryLinear.OrderedResidualConjugators.ResidualUpper

namespace BinaryLinear.OrderedResidualConjugators

/-- The cubic residual supplements the actual full flag stabilizer. -/
theorem minimalParabolic_cubic_supplement {m : ℕ} (b : Basis m) (i : Fin m) :
    minimalParabolic b i =
      (primeToResidual 3 (minimalParabolic b i)).map (minimalParabolic b i).subtype ⊔
        cutStabilizer b Set.univ := by
  let P := minimalParabolic b i
  let R := (primeToResidual 3 P).map P.subtype
  let B := cutStabilizer b Set.univ
  have hBP : B ≤ P := (cutStabilizer_le_iff b Set.univ {i}ᶜ).mpr (Set.subset_univ _)
  apply le_antisymm _ (sup_le (map_subtype_le _) hBP)
  apply (minimalParabolic_le_elementaryParabolic b i).trans
  apply (closure_le _).mpr
  rintro g ⟨r,s,hrs,hr | ⟨rfl,rfl⟩,rfl⟩
  · exact mem_sup_right (root_mem_cutStabilizer b Set.univ r s hrs
      (by intro j _ hj; omega))
  · have hi : i.castSucc ≠ i.succ := by simp [Fin.ext_iff]
    have hcP : cubic b i.castSucc i.succ hi ∈ P :=
      P.mul_mem (root_mem_minimalParabolic b i _ _ hi (Or.inl (by simp)))
        (root_mem_minimalParabolic b i _ _ hi.symm (Or.inr ⟨rfl,rfl⟩))
    have hc : cubic b i.castSucc i.succ hi ∈ R := by
      refine ⟨⟨_,hcP⟩,mem_primeToResidual_of_pow (p := 3) (n := 1) ?_,rfl⟩
      exact Subtype.ext (by simpa using cubic_cube b i.castSucc i.succ hi)
    have hu : root b i.castSucc i.succ hi ∈ B :=
      root_mem_cutStabilizer b Set.univ _ _ hi (by intro j _ hj; simp_all; omega)
    have hh := (R ⊔ B).mul_mem ((R ⊔ B).inv_mem (mem_sup_right hu)) (mem_sup_left hc)
    change root b i.succ i.castSucc hrs ∈ R ⊔ B
    simpa only [cubic,inv_mul_cancel_left] using hh

/-- O² and O^{3′} coincide on the literal binary minimal parabolic. -/
theorem minimalParabolic_twoResidual_eq_cubic {m : ℕ} (b : Basis m) (i : Fin m) :
    pResidual 2 (minimalParabolic b i) = primeToResidual 3 (minimalParabolic b i) := by
  let : Finite (LinearGroup (m + 1)) := Finite.of_injective
    (fun g : LinearGroup (m + 1) => (g : Space (m + 1) → Space (m + 1)))
    DFunLike.coe_injective
  let P := minimalParabolic b i
  let B := cutStabilizer b Set.univ
  have hBP : B ≤ P := (cutStabilizer_le_iff b Set.univ {i}ᶜ).mpr (Set.subset_univ _)
  have hsup : primeToResidual 3 P ⊔ B.subgroupOf P = ⊤ := by
    apply map_injective P.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hBP,
      ←MonoidHom.range_eq_map,range_subtype]
    exact (minimalParabolic_cubic_supplement b i).symm
  have hp : IsPGroup 2 (P ⧸ primeToResidual 3 P) :=
    isPGroup_quotient_of_sup_eq_top _ (B.subgroupOf P)
      (fullFlag_isPGroup b).comap_subtype hsup
  exact le_antisymm (sInf_le ⟨inferInstance,hp⟩) primeToResidual_three_le_twoResidual
end BinaryLinear.OrderedResidualConjugators
