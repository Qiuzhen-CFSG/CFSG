module
public import Theory.SpecificGroups.BinaryLinear.PointStabilizerRank
public import Theory.SpecificGroups.BinaryLinear.FiveFlagGeometry.Residuals.Endpoints
public import Theory.SpecificGroups.BinaryLinear.FourResidual

/-!
# The binary five-dimensional point parabolic

The stabilizer of a nonzero natural point has two-core quotient SL₄(2).
The actual line parabolic is perfect, including its unipotent radical,
so its simple quotient of order divisible by three also proves that it
equals its prime-to-three residual.

These are the two model inputs used to identify the original K_I in
Aschbacher--Smith, 15.2.23(a), printed p.1117. The quotient is the intrinsic
two-core quotient, rather than an independently chosen section.
-/

public section
open Subgroup Theory.GroupTheory
namespace BinaryLinear.PointStabilizerRank
open SmallParabolicLevi OuterCyclic
private instance {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Finite V] :
    Finite (BinaryLinear.GL V) :=
  Finite.of_injective (fun g : BinaryLinear.GL V => (g : V → V)) DFunLike.coe_injective

/-- The actual natural point stabilizer has two-core quotient SL₄(2). -/
theorem five_point_quotient (v : Fin 5 → ZMod 2) (hv : v ≠ 0) :
    Nonempty ((MulAction.stabilizer (Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)) v ⧸
      pCore 2 (MulAction.stabilizer (Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)) v)) ≃*
        Matrix.SpecialLinearGroup (Fin 4) (ZMod 2)) := by
  let e := naturalStabilizerEquiv 5 v
  suffices h : Nonempty ((MulAction.stabilizer (BinaryLinear.GL (Space 5)) v ⧸
      pCore 2 (MulAction.stabilizer (BinaryLinear.GL (Space 5)) v)) ≃*
        Matrix.SpecialLinearGroup (Fin 4) (ZMod 2)) by
    obtain ⟨f⟩ := h
    exact ⟨(QuotientGroup.congr _ _ e (pCore_map_iso 2 e)).trans f⟩
  rw [stabilizer_eq_parabolic]
  let W := Submodule.span (ZMod 2) {v}
  have hW : Module.finrank (ZMod 2) W = 1 := finrank_span_singleton hv
  have hQ : Module.finrank (ZMod 2) (Space 5 ⧸ W) = 4 := by
    have h := W.finrank_quotient_add_finrank
    rw [Module.finrank_fin_fun] at h
    change Module.finrank (ZMod 2) ((Fin 5 → ZMod 2) ⧸ W) = 4
    omega
  let a := (Module.finBasisOfFinrankEq (ZMod 2) W hW).equivFun
  let b := (Module.finBasisOfFinrankEq (ZMod 2) (Space 5 ⧸ W) hQ).equivFun
  let : Unique (LinearGroup 1) :=
    { default := 1
      uniq := fun _g => (slEquivLinear 1).symm.injective (Subsingleton.elim _ _) }
  exact ⟨(quotientTwoCoreEquivOfCoordinates W a b).trans
    ((MulEquiv.uniqueProd (N := LinearGroup 1) (M := LinearGroup 4)).trans
      (slEquivLinear 4).symm)⟩

/-- The actual point parabolic is generated by its three-elements. -/
theorem five_point_primeToResidual (v : Fin 5 → ZMod 2) (hv : v ≠ 0) :
    primeToResidual 3 (MulAction.stabilizer
      (Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)) v) = ⊤ := by
  let P := MulAction.stabilizer (Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)) v
  have hp : Group.IsPerfect (MulAction.stabilizer (BinaryLinear.GL (Space 5)) v) := by
    rw [stabilizer_eq_parabolic]
    exact FiveFlagGeometry.pointParabolic_isPerfect hv
  let := hp
  let : Group.IsPerfect P := Group.IsPerfect.ofSurjective
    (f := (naturalStabilizerEquiv 5 v).symm.toMonoidHom)
    (naturalStabilizerEquiv 5 v).symm.surjective
  obtain ⟨e⟩ := five_point_quotient v hv
  apply BinaryLinear.primeToResidual_three_eq_top_of_four_quotient (e := e)
  intro N hN hq
  let : N.Normal := hN
  by_contra hne
  let : Nontrivial (P ⧸ N) := QuotientGroup.nontrivial_iff.mpr hne
  let : Group.IsPerfect (P ⧸ N) :=
    Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective N)
  let : Group.IsNilpotent (P ⧸ N) := hq.isNilpotent
  exact Group.IsPerfect.not_isSolvable (P ⧸ N) inferInstance

end BinaryLinear.PointStabilizerRank
