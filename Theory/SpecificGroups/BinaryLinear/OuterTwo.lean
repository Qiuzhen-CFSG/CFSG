module
public import Theory.SpecificGroups.BinaryLinear.OuterCyclic

/-!
# Outer two-groups for the binary linear groups of degrees four and five

The proved inner-or-graph description puts every outer coset in the
subgroup generated by inverse transpose. Its square is one. Transport
through the actual special-linear comparison gives the same result for
SL₄(2) and SL₅(2). The Chapter 10 point-centralizer residual calculation
uses the degree-five instance.

Source: GLS3, Theorem 2.5.12(b--e,i) and §2.7;
`refs/KGroup/GLS3/chapter2.tex`, as in the imported automorphism theorem.
-/

public section
open Subgroup Theory.GroupTheory
namespace BinaryLinear.OuterCyclic
/-- The graph coset has order at most two; hence the entire outer group is a two-group. -/
theorem linear_outer_isTwoGroup {n : ℕ} (hn : n = 4 ∨ n = 5) :
    IsPGroup 2 (MulAut.Outer (LinearGroup n)) := by
  let q := QuotientGroup.mk' (MulAut.innerSubgroup (LinearGroup n))
  intro x
  obtain ⟨a,rfl⟩ := QuotientGroup.mk'_surjective (MulAut.innerSubgroup (LinearGroup n)) x
  obtain ⟨g,ha | ha⟩ := inner_graph hn a
  all_goals have hi : q (MulAut.conj g) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr ⟨g,rfl⟩
  · refine ⟨1,?_⟩
    change q a ^ (2 ^ 1) = 1
    rw [ha,hi,one_pow]
  · refine ⟨1,?_⟩
    change q a ^ (2 ^ 1) = 1
    rw [ha,map_mul,hi,mul_one,pow_one,←map_pow,graphLinear_sq,map_one]

theorem sl_outer_isTwoGroup {n : ℕ} (hn : n = 4 ∨ n = 5) :
    IsPGroup 2 (MulAut.Outer (Matrix.SpecialLinearGroup (Fin n) (ZMod 2))) :=
  (linear_outer_isTwoGroup hn).of_equiv (MulAut.outerCongr (slEquivLinear n)).symm
end BinaryLinear.OuterCyclic

