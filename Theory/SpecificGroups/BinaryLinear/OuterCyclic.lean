module

public import Theory.SpecificGroups.BinaryLinear.OuterCyclic.Geometry
public import Theory.SpecificGroups.BinaryLinear.OuterCyclic.PointRigidity
public import Theory.SpecificGroups.BinaryLinear.OuterCyclic.RadicalOrientation
public import Theory.GroupTheory.SolvableOuterQuotient
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# Cyclic outer groups of PSL₄(2) and PSL₅(2)

For the actual binary linear group in dimensions four and five, every
automorphism preserves the point radicals after a possible inverse transpose,
by `RadicalOrientation`. An automorphism preserving those radicals is inner,
by `PointRigidity`. Inverse transpose has square one, so every automorphism
is inner or inverse transpose times inner. Its actual Aut/Inn quotient is
therefore generated by the inverse-transpose coset. The proved binary matrix
comparison transfers this conclusion to PSLₙ(2).

The general conditional reductions remain available. The final theorems
discharge both geometric premises for n=4 and n=5, without requiring
simplicity or perfectness hypotheses or determining the exact outer order.

Source: GLS3, Theorem 2.5.12(b–e,i) and §2.7,
`refs/KGroup/GLS3/chapter2.tex`, lines 1111–1115. Over the binary field
the field and diagonal factors are trivial, leaving the graph factor.
-/

@[expose] public section

open scoped MatrixGroups

namespace BinaryLinear.OuterCyclic

private theorem outer_isCyclic_of_inner_graph {G : Type*} [Group G] (τ : MulAut G)
    (h : ∀ a : MulAut G, ∃ g : G, a = MulAut.conj g ∨ a = τ * MulAut.conj g) :
    IsCyclic (MulAut.Outer G) := by
  let q := QuotientGroup.mk' (MulAut.innerSubgroup G)
  refine ⟨q τ, ?_⟩
  intro x
  obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (MulAut.innerSubgroup G) x
  obtain ⟨g, hg⟩ := h a
  have hi : q (MulAut.conj g) = 1 := by
    change QuotientGroup.mk (MulAut.conj g) = 1
    rw [QuotientGroup.eq_one_iff]
    exact ⟨g, rfl⟩
  rcases hg with rfl | rfl
  · exact ⟨0, by simpa only [zpow_zero] using hi.symm⟩
  · refine ⟨1, ?_⟩
    change (q τ) ^ (1 : ℤ) = q (τ * MulAut.conj g)
    rw [zpow_one, map_mul, hi, mul_one]

/-- Point-radical reconstruction implies inner/inverse-transpose coverage. -/
theorem inner_graph_of_point_geometry {n : ℕ}
    (hcover : ∀ a : MulAut (LinearGroup n),
      PreservesPointRadicals a ∨ PreservesPointRadicals (graphLinear n * a))
    (hrigid : ∀ a : MulAut (LinearGroup n), PreservesPointRadicals a →
      ∃ g : LinearGroup n, a = MulAut.conj g)
    (a : MulAut (LinearGroup n)) :
    ∃ g : LinearGroup n, a = MulAut.conj g ∨ a = graphLinear n * MulAut.conj g := by
  rcases hcover a with ha | ha
  · obtain ⟨g, hg⟩ := hrigid a ha
    exact ⟨g, Or.inl hg⟩
  · obtain ⟨g, hg⟩ := hrigid (graphLinear n * a) ha
    refine ⟨g, Or.inr ?_⟩
    rw [← hg, ← mul_assoc, ← pow_two, graphLinear_sq, one_mul]

/-- Geometric coverage and rigidity imply cyclicity of the actual Aut/Inn
quotient of the linear group. -/
theorem linear_outer_isCyclic_of_point_geometry {n : ℕ}
    (hcover : ∀ a : MulAut (LinearGroup n),
      PreservesPointRadicals a ∨ PreservesPointRadicals (graphLinear n * a))
    (hrigid : ∀ a : MulAut (LinearGroup n), PreservesPointRadicals a →
      ∃ g : LinearGroup n, a = MulAut.conj g) :
    IsCyclic (MulAut.Outer (LinearGroup n)) :=
  outer_isCyclic_of_inner_graph (graphLinear n) (inner_graph_of_point_geometry hcover hrigid)

/-- Transport the conditional cyclicity result to the genuine projective quotient.
This is not an unconditional automorphism theorem for PSLₙ(2). -/
theorem psl_outer_isCyclic_of_point_geometry {n : ℕ} (hn : 0 < n)
    (hcover : ∀ a : MulAut (LinearGroup n),
      PreservesPointRadicals a ∨ PreservesPointRadicals (graphLinear n * a))
    (hrigid : ∀ a : MulAut (LinearGroup n), PreservesPointRadicals a →
      ∃ g : LinearGroup n, a = MulAut.conj g) :
    IsCyclic (MulAut.Outer PSL(n, ZMod 2)) := by
  let : IsCyclic (MulAut.Outer (LinearGroup n)) :=
    linear_outer_isCyclic_of_point_geometry hcover hrigid
  exact (MulAut.outerCongr (projectiveEquivLinear hn)).isCyclic.mpr inferInstance

/-- In dimensions four and five, every automorphism of the binary linear group
is inner or inverse transpose times inner. -/
theorem inner_graph {n : ℕ} (hn : n = 4 ∨ n = 5) (a : MulAut (LinearGroup n)) :
    ∃ g : LinearGroup n, a = MulAut.conj g ∨ a = graphLinear n * MulAut.conj g :=
  inner_graph_of_point_geometry (preservesPointRadicals_or_graph hn)
    (eq_conj_of_preservesPointRadicals hn) a

/-- The actual outer quotient of the binary linear group is cyclic in
dimensions four and five. -/
theorem linear_outer_isCyclic {n : ℕ} (hn : n = 4 ∨ n = 5) :
    IsCyclic (MulAut.Outer (LinearGroup n)) :=
  outer_isCyclic_of_inner_graph (graphLinear n) (inner_graph hn)

/-- The actual outer automorphism groups of PSL₄(2) and PSL₅(2) are cyclic. -/
theorem psl_outer_isCyclic {n : ℕ} (hn : n = 4 ∨ n = 5) :
    IsCyclic (MulAut.Outer PSL(n, ZMod 2)) :=
  psl_outer_isCyclic_of_point_geometry (by omega)
    (preservesPointRadicals_or_graph hn) (eq_conj_of_preservesPointRadicals hn)

end BinaryLinear.OuterCyclic
