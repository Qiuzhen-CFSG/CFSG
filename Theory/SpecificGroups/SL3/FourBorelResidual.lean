module
public import Theory.SpecificGroups.PSL3.CartanActions.BorelResidual
public import Theory.GroupTheory.PResidual.PrimeToPerfect
/-!
# Cubic generation of a full SL₃(4) Borel

The full Sylow normalizer is two-perfect and its two-core quotient is
F₄× × F₄×. The two-kernel/three-quotient argument therefore makes its
prime-to-three residual the entire normalizer, retaining the scalar center.

Source: Aschbacher–Smith 12.6.31, printed pp.836–837. The matrix Borel
calculations use the attributed ATLAS port in the imported modules.
-/
public section
open Subgroup
open scoped MatrixGroups
namespace Matrix.SL3
/-- The full field-four Borel is generated by its three-elements, including scalars. -/
theorem four_sylowNormalizer_primeToResidual {F : Type*} [Field F] [Finite F]
    (hF : Nat.card F = 4) (P : Sylow 2 SL(3,F)) :
    primeToResidual 3 (normalizer (P : Set SL(3,F))) = ⊤ := by
  let N := normalizer (P : Set SL(3,F))
  have hc : Nat.card (N ⧸ pCore 2 N) = 3 ^ 2 := by
    rw [Nat.card_congr (Matrix.PSL3.CartanActions.BorelQuotient.sylowSLNormalizerQuotientEquiv
      F (by decide : 0 < 2) hF P).toEquiv,Nat.card_prod,Nat.card_units,hF]
    norm_num
  exact primeToResidual_eq_top_of_pGroup_quotient 3 2 (pCore 2 N) pCore_isPGroup
    ((IsPGroup.iff_card (p := 3)).mpr ⟨2,hc⟩)
    ((pResidual_eq_top_iff 2 N).mp
      (Matrix.PSL3.CartanActions.BorelQuotient.sylowSLNormalizer_twoResidual
        F (by decide : 0 < 2) hF (by omega) P))
end Matrix.SL3
