/-!
# Determinants in semisimple three-dimensional centralizers

An invariant line in a semisimple three-dimensional module has an invariant
complement, and scaling that line gives any prescribed determinant.  When the
characteristic polynomial has no root, it is an irreducible cubic; the module
is then one-dimensional over the cubic field generated by the endomorphism,
and finite-field norm surjectivity gives the same conclusion.
-/

open Polynomial Module.End

set_option linter.style.haveILetI false
set_option linter.unnecessarySimpa false

noncomputable section

namespace Theory.SpecificGroups.SL3.PRegularClasses

variable {F : Type*} [Field F]

private theorem exists_commuting_det_of_invariant_line
    {V : Type*} [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (f : Module.End F V) (U : Submodule F V) (hUinv : U ∈ f.invtSubmodule)
    (hf : f.IsSemisimple) (d : F)
    (hU : Module.finrank F U = 1) :
    ∃ c : Module.End F V, c * f = f * c ∧ LinearMap.det c = d := by
  obtain ⟨q, hqinv, hcomp⟩ := Module.End.isSemisimple_iff.mp hf _ hUinv
  let e := U.prodEquivOfIsCompl q hcomp
  let frp : U →ₗ[F] U := LinearMap.restrict f hUinv
  let frq : q →ₗ[F] q := LinearMap.restrict f hqinv
  let fp := frp.prodMap frq
  let g : (U × q) →ₗ[F] (U × q) :=
    (d • LinearMap.id).prodMap LinearMap.id
  have heq : f.comp e.toLinearMap = e.toLinearMap.comp fp := by
    apply LinearMap.ext
    intro z
    rcases z with ⟨x, y⟩
    change f ((x : V) + (y : V)) = (frp x : V) + (frq y : V)
    rw [map_add]
    rfl
  have hgcomm : g.comp fp = fp.comp g := by
    apply LinearMap.ext
    intro z
    rcases z with ⟨x, y⟩
    change (d • frp x, frq y) = (frp (d • x), frq y)
    simp
  let c : Module.End F V := e.toLinearMap.comp (g.comp e.symm.toLinearMap)
  have hccomm : c.comp f = f.comp c := by
    ext v
    have heq' := congrArg e.symm (LinearMap.congr_fun heq (e.symm v))
    have heq'' : e.symm (f v) = fp (e.symm v) := by simpa using heq'
    simp only [c, LinearMap.comp_apply]
    calc
      e (g (e.symm (f v))) = e (g (fp (e.symm v))) := by rw [heq'']
      _ = e (fp (g (e.symm v))) := by
        have hgc := LinearMap.congr_fun hgcomm (e.symm v)
        change g (fp (e.symm v)) = fp (g (e.symm v)) at hgc
        exact congrArg e hgc
      _ = f (e (g (e.symm v))) := by
        exact (LinearMap.congr_fun heq (g (e.symm v))).symm
      _ = f (c v) := rfl
  have hcdet : LinearMap.det c = d := by
    have hconj : LinearMap.det c = LinearMap.det g := by
      simpa [c, LinearMap.comp_assoc] using LinearMap.det_conj g e
    rw [hconj, LinearMap.det_prodMap, LinearMap.det_smul,
      LinearMap.det_id, hU, pow_one]
    simp
  exact ⟨c, hccomm, hcdet⟩

private theorem exists_commuting_det_of_irreducible_cubic [Finite F]
    (f : Module.End F (Fin 3 → F)) (p : Polynomial F)
    (hp : Irreducible p) (hroot : Polynomial.aeval f p = 0)
    (hdim : p.natDegree = 3) (d : F) :
    ∃ c : Module.End F (Fin 3 → F), c * f = f * c ∧ LinearMap.det c = d := by
  letI : Fact (Irreducible p) := ⟨hp⟩
  let φ : AdjoinRoot p →ₐ[F] Module.End F (Fin 3 → F) :=
    Ideal.Quotient.liftₐ (Ideal.span {p}) (Polynomial.aeval f) (by
      intro q hq
      rcases Ideal.mem_span_singleton.mp hq with ⟨r, rfl⟩
      rw [map_mul, hroot, zero_mul])
  letI : Module (AdjoinRoot p) (Fin 3 → F) := Module.compHom (Fin 3 → F) φ.toRingHom
  letI : IsScalarTower F (AdjoinRoot p) (Fin 3 → F) :=
    IsScalarTower.of_algebraMap_smul (fun r x => by
      change φ (algebraMap F (AdjoinRoot p) r) x = r • x
      rw [φ.commutes]
      rfl)
  letI : Module.Finite F (AdjoinRoot p) := (AdjoinRoot.powerBasis hp.ne_zero).finite
  letI : Finite (AdjoinRoot p) := Module.finite_of_finite F
  letI : Module.Free (AdjoinRoot p) (Fin 3 → F) := Module.Free.of_divisionRing _ _
  letI : Module.Finite (AdjoinRoot p) (Fin 3 → F) := Module.Finite.of_finite
  have hfinS : Module.finrank F (AdjoinRoot p) = 3 := by
    rw [(AdjoinRoot.powerBasis hp.ne_zero).finrank]
    simp [hdim]
  have hfinV : Module.finrank F (Fin 3 → F) = 3 := by simp
  have hfinrank : Module.finrank (AdjoinRoot p) (Fin 3 → F) = 1 := by
    have hmul := Module.finrank_mul_finrank F (AdjoinRoot p) (Fin 3 → F)
    rw [hfinS, hfinV] at hmul
    omega
  obtain ⟨s, hs⟩ := (FiniteField.norm_surjective F (AdjoinRoot p)) d
  let g : (Fin 3 → F) →ₗ[AdjoinRoot p] (Fin 3 → F) :=
    LinearMap.lsmul (AdjoinRoot p) _ s
  have hdetS : LinearMap.det g = s := by
    change LinearMap.det (s • (LinearMap.id : (Fin 3 → F) →ₗ[AdjoinRoot p] (Fin 3 → F))) = s
    rw [LinearMap.det_smul, LinearMap.det_id, hfinrank, pow_one, mul_one]
  have hdetF : LinearMap.det (g.restrictScalars F) = d := by
    rw [LinearMap.det_restrictScalars, hdetS, hs]
  let c : Module.End F (Fin 3 → F) := g.restrictScalars F
  have hφroot : φ (AdjoinRoot.root p) = f := by
    change Polynomial.aeval f Polynomial.X = f
    exact Polynomial.aeval_X f
  have hcφ : c = φ s := by
    ext x
    rfl
  refine ⟨c, ?_, hdetF⟩
  rw [hcφ]
  rw [← hφroot]
  simpa only [map_mul] using congrArg φ (mul_comm s (AdjoinRoot.root p))

private theorem matrix_of_commuting_end
    (A : Matrix (Fin 3) (Fin 3) F) (c : Module.End F (Fin 3 → F))
    (h : c * Matrix.toLin' A = Matrix.toLin' A * c) :
    (LinearMap.toMatrix' c) * A = A * (LinearMap.toMatrix' c) := by
  simpa only [Module.End.mul_eq_comp, LinearMap.toMatrix'_comp,
    LinearMap.toMatrix'_toLin'] using congrArg LinearMap.toMatrix' h

public theorem exists_commuting_det_of_isSemisimple [Finite F] [CharP F 2]
    (A : Matrix (Fin 3) (Fin 3) F)
    (hA : Module.End.IsSemisimple (Matrix.toLin' A)) :
    ∀ d : F, d ≠ 0 →
      ∃ C : Matrix (Fin 3) (Fin 3) F, C * A = A * C ∧ C.det = d := by
  intro d hd
  let f : Module.End F (Fin 3 → F) := Matrix.toLin' A
  have hV : Module.finrank F (Fin 3 → F) = 3 := by simp
  by_cases hroot : ∃ μ : F, f.HasEigenvalue μ
  · obtain ⟨μ, hμ⟩ := hroot
    obtain ⟨v, hv⟩ := hμ.exists_hasEigenvector
    let U := Submodule.span F {v}
    have hUinv : U ∈ f.invtSubmodule := by
      rw [Module.End.mem_invtSubmodule]
      intro x hx
      obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hx
      change f (r • v) ∈ U
      rw [map_smul, hv.apply_eq_smul, smul_smul]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self v)
    have hU1 : Module.finrank F U = 1 := finrank_span_singleton hv.2
    obtain ⟨c, hc, hdet⟩ := exists_commuting_det_of_invariant_line f U hUinv hA d hU1
    refine ⟨LinearMap.toMatrix' c, matrix_of_commuting_end A c hc, ?_⟩
    calc
      (LinearMap.toMatrix' c).det = LinearMap.det (Matrix.toLin' (LinearMap.toMatrix' c)) :=
        (LinearMap.det_toLin' _).symm
      _ = LinearMap.det c := by rw [Matrix.toLin'_toMatrix']
      _ = d := hdet
  · have hnotroot : ∀ μ : F, ¬(f.charpoly.IsRoot μ) := by
      intro μ hμ
      apply hroot
      exact ⟨μ, (Module.End.hasEigenvalue_iff_isRoot_charpoly f μ).mpr hμ⟩
    let p := f.charpoly
    have hdeg : p.natDegree ∈ Finset.Icc 1 3 := by
      rw [LinearMap.charpoly_natDegree]
      simp [hV]
    have hp : Irreducible p := Polynomial.irreducible_of_degree_le_three_of_not_isRoot hdeg hnotroot
    have hrootp : Polynomial.aeval f p = 0 := f.aeval_self_charpoly
    obtain ⟨c, hc, hdet⟩ := exists_commuting_det_of_irreducible_cubic f p hp hrootp
      (by simp [p, LinearMap.charpoly_natDegree, hV]) d
    refine ⟨LinearMap.toMatrix' c, matrix_of_commuting_end A c ?_, ?_⟩
    · simpa [f] using hc
    · calc
        (LinearMap.toMatrix' c).det = LinearMap.det (Matrix.toLin' (LinearMap.toMatrix' c)) :=
          (LinearMap.det_toLin' _).symm
        _ = LinearMap.det c := by rw [Matrix.toLin'_toMatrix']
        _ = d := hdet

end Theory.SpecificGroups.SL3.PRegularClasses
