module

public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.F4Identification.Words

/-!
# Literal two-node words in the F4 matrix cover

Each pair of numbered simple roots gives a free word group, its inclusion in
the common word group, and its image in the actual F4 matrix cover. The local
relators are exactly the identity words in these images. Their normal closure
is contained in the global kernel; the reverse containment is the substantive
F4 presentation theorem and is not asserted here.

These interfaces separate the source presentation from constructions of local
actions on the folded E6 complement. The assembly in `ComplementRepresentation`
uses both results. The source route is GLS3 §2.9.3 (the Curtis--Tits amalgam),
with the central version checked on the actual integral Geck carrier, for the
inclusions in Aschbacher--Smith A.2.17, printed p.39.
-/

@[expose] public section
noncomputable section
namespace TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation

variable (F : Type*) [Field F]

/-- The second Boolean selects one of the two nodes; the first is the root sign. -/
abbrev PairWord := FreeGroup (Bool × Bool × F)

def pairNode (i j : Fin 4) (k : Bool) : Fin 4 := if k then i else j

def pairInclusion (i j : Fin 4) : PairWord F →* Word F :=
  FreeGroup.lift fun x => FreeGroup.of (x.1, pairNode i j x.2.1, x.2.2)

omit [Field F] in
@[simp] theorem pairInclusion_of (i j : Fin 4) (s k : Bool) (t : F) :
    pairInclusion F i j (FreeGroup.of (s, k, t)) =
      FreeGroup.of (s, pairNode i j k, t) := FreeGroup.lift_apply_of

/-- Evaluation uses the existing signed F4 curves, with their original parameter. -/
def pairEvaluation (i j : Fin 4) : PairWord F →* Cover F :=
  (coverEvaluation F).comp (pairInclusion F i j)

@[simp] theorem pairEvaluation_of (i j : Fin 4) (s k : Bool) (t : F) :
    pairEvaluation F i j (FreeGroup.of (s, k, t)) =
      coverSimple F s (pairNode i j k) t := by
  simp [pairEvaluation]

/-- A subgroup of the literal cover, not an abstract rank-two group tag. -/
def pairSubgroup (i j : Fin 4) : Subgroup (Cover F) := (pairEvaluation F i j).range

def pairEvaluationRange (i j : Fin 4) : PairWord F →* pairSubgroup F i j :=
  (pairEvaluation F i j).rangeRestrict

def pairGenerator (i j : Fin 4) (s k : Bool) (t : F) : pairSubgroup F i j :=
  pairEvaluationRange F i j (FreeGroup.of (s, k, t))

@[simp] theorem pairGenerator_val (i j : Fin 4) (s k : Bool) (t : F) :
    (pairGenerator F i j s k t).val = coverSimple F s (pairNode i j k) t :=
  pairEvaluation_of F i j s k t

theorem pairEvaluationRange_surjective (i j : Fin 4) :
    Function.Surjective (pairEvaluationRange F i j) := by
  rintro ⟨g, w, hw⟩
  exact ⟨w, Subtype.ext hw⟩

/-- Precisely the subgroup generated by the two signed simple-root curves. -/
theorem pairSubgroup_eq_closure (i j : Fin 4) :
    pairSubgroup F i j = Subgroup.closure
      (Set.range fun x : Bool × Bool × F => coverSimple F x.1 (pairNode i j x.2.1) x.2.2) := by
  have he : pairEvaluation F i j =
      FreeGroup.lift (fun x : Bool × Bool × F =>
        coverSimple F x.1 (pairNode i j x.2.1) x.2.2) := by
    apply FreeGroup.ext_hom
    rintro ⟨s, k, t⟩
    simp
  rw [pairSubgroup, he, FreeGroup.range_lift_eq_closure]

/-- All identity relations supported on at most two numbered simple roots. -/
def pairRelators : Set (Word F) :=
  {w | ∃ (i j : Fin 4) (v : PairWord F),
    pairEvaluation F i j v = 1 ∧ pairInclusion F i j v = w}

def pairRelationSubgroup : Subgroup (Word F) := Subgroup.normalClosure (pairRelators F)

/-- This elementary containment does not assert the Curtis--Tits presentation. -/
theorem pairRelationSubgroup_le : pairRelationSubgroup F ≤ (coverEvaluation F).ker := by
  apply Subgroup.normalClosure_le_normal
  rintro _ ⟨i, j, v, hv, rfl⟩
  exact hv

/-- Local marked homomorphisms give the required vanishing on local relations. -/
theorem kills_pairRelators_of_local_homs {G : Type*} [Group G]
    (ψ : Word F →* G)
    (ρ : ∀ i j : Fin 4, pairSubgroup F i j →* G)
    (hρ : ∀ (i j : Fin 4) (s k : Bool) (t : F),
      ρ i j (pairGenerator F i j s k t) =
        ψ (FreeGroup.of (s, pairNode i j k, t))) :
    pairRelationSubgroup F ≤ ψ.ker := by
  apply Subgroup.normalClosure_le_normal
  rintro _ ⟨i, j, v, hv, rfl⟩
  have he : (ρ i j).comp (pairEvaluationRange F i j) =
      ψ.comp (pairInclusion F i j) := by
    apply FreeGroup.ext_hom
    rintro ⟨s, k, t⟩
    simpa only [MonoidHom.comp_apply, pairInclusion_of, pairGenerator] using hρ i j s k t
  have hv' : pairEvaluationRange F i j v = 1 := Subtype.ext hv
  change (ψ.comp (pairInclusion F i j)) v = 1
  rw [← he]
  change ρ i j (pairEvaluationRange F i j v) = 1
  rw [hv', map_one]

/-- A proved source presentation and local actions assemble to an action of the
actual cover. Neither the presentation nor the local actions is supplied here. -/
def descendOfPairPresentation {G : Type*} [Group G]
    (hpresentation : (coverEvaluation F).ker = pairRelationSubgroup F)
    (ψ : Word F →* G)
    (ρ : ∀ i j : Fin 4, pairSubgroup F i j →* G)
    (hρ : ∀ (i j : Fin 4) (s k : Bool) (t : F),
      ρ i j (pairGenerator F i j s k t) =
        ψ (FreeGroup.of (s, pairNode i j k, t))) : Cover F →* G :=
  (coverEvaluation F).liftOfSurjective (coverEvaluation_surjective F)
    ⟨ψ, hpresentation ▸ kills_pairRelators_of_local_homs F ψ ρ hρ⟩

@[simp] theorem descendOfPairPresentation_evaluation {G : Type*} [Group G]
    (hpresentation : (coverEvaluation F).ker = pairRelationSubgroup F)
    (ψ : Word F →* G)
    (ρ : ∀ i j : Fin 4, pairSubgroup F i j →* G)
    (hρ : ∀ (i j : Fin 4) (s k : Bool) (t : F),
      ρ i j (pairGenerator F i j s k t) =
        ψ (FreeGroup.of (s, pairNode i j k, t))) (w : Word F) :
    descendOfPairPresentation F hpresentation ψ ρ hρ (coverEvaluation F w) = ψ w :=
  MonoidHom.liftOfRightInverse_comp_apply _ _ _ _ _

end TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
