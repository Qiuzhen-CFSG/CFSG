module

public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.F4Identification.WordDescent.ComplementRepresentation.PairPresentation.RootTransport

/-!
# Local paths for marked normalizer transport

The subgroup generated by the parameter-one Tits lifts is enough for the
chosen root routes. We distinguish this subgroup in the actual matrix cover
from its lift to the pair completion. A local normalizer path factors an
actual matrix into two-node Tits words, and records their successive actions
on signed simple-root elements with their literal parameters.

Every such path lifts to the completion: its individual steps hold in the
faithfully embedded actual pair subgroups. Faithfulness of the lifted Tits
normalizer then identifies that lift with any prescribed normalizer word.
This gives marked route coherence, and hence the plane-relation consumer,
conditionally on normalizer faithfulness and existence of local paths.
Neither of those two source obligations is asserted in this module.

Source: GLS3, Theorem 2.9.3 and Lemma 2.9.4,
`refs/KGroup/GLS3/chapter2.tex`, lines 1393--1454. In particular, the path
existence obligation includes the root-stabilizer case; abstract rooted
Matsumoto connectivity alone does not discharge it. No global injectivity
of completion evaluation or presentation theorem is used.
-/

@[expose] public section
noncomputable section
namespace TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
open Theory.AlgebraicGroup.StandardRootSystem

variable (F : Type*) [Field F]

/-- The lifted subgroup generated just by the parameter-one Tits elements. -/
def transportNormalizer : Subgroup (PairCompletion F) :=
  Subgroup.closure (Set.range fun i : typeF4RootPairing_base.support =>
    pairQuotient F (transportTitsWord F [i]))

/-- The corresponding concrete matrix subgroup. -/
def coverTransportNormalizer : Subgroup (Cover F) :=
  Subgroup.closure (Set.range fun i : typeF4RootPairing_base.support =>
    coverEvaluation F (transportTitsWord F [i]))

theorem transportTitsWord_mem_normalizer (w : List typeF4RootPairing_base.support) :
    pairQuotient F (transportTitsWord F w) ∈ transportNormalizer F := by
  induction w with
  | nil => simp
  | cons i w ih =>
    have hi : pairQuotient F (transportTitsWord F [i]) ∈ transportNormalizer F :=
      Subgroup.subset_closure ⟨i, rfl⟩
    simpa only [← map_mul, ← transportTitsWord_append, List.singleton_append] using
      (transportNormalizer F).mul_mem hi ih

theorem completionEvaluation_mem_coverTransportNormalizer
    {g : PairCompletion F} (hg : g ∈ transportNormalizer F) :
    completionEvaluation F g ∈ coverTransportNormalizer F := by
  have hle : transportNormalizer F ≤
      (coverTransportNormalizer F).comap (completionEvaluation F) := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact Subgroup.subset_closure ⟨i, rfl⟩
  exact hle hg

theorem coverEvaluation_transportTitsWord_mem_normalizer
    (w : List typeF4RootPairing_base.support) :
    coverEvaluation F (transportTitsWord F w) ∈ coverTransportNormalizer F :=
  completionEvaluation_mem_coverTransportNormalizer F (transportTitsWord_mem_normalizer F w)

/-- The two normalizers are related by the literal completion evaluation. -/
theorem transportNormalizer_map_evaluation :
    (transportNormalizer F).map (completionEvaluation F) = coverTransportNormalizer F := by
  rw [transportNormalizer, MonoidHom.map_closure, ← Set.range_comp]
  rfl

/-- The first source obligation is injectivity only on the lifted Tits normalizer. -/
def TransportNormalizerFaithful : Prop :=
  Set.InjOn (completionEvaluation F) (transportNormalizer F)

/-- Equality of actual pair words lifts by the defining local relations. -/
theorem pairQuotient_eq_of_pairEvaluation_eq (i j : Fin 4) (v w : PairWord F)
    (h : pairEvaluation F i j v = pairEvaluation F i j w) :
    pairQuotient F (pairInclusion F i j v) =
      pairQuotient F (pairInclusion F i j w) := by
  have he : pairEvaluationRange F i j v = pairEvaluationRange F i j w := Subtype.ext h
  simpa only [pairEmbedding_evaluation] using congrArg (pairEmbedding F i j) he

/-- The marked local step, with exactly the original Tits multiplication order. -/
theorem pairQuotient_local_transport (i j : Fin 4) (v : List Bool)
    (s k z l : Bool) (t u : F)
    (h : pairEvaluation F i j (pairTransportTitsWord F v) *
        coverSimple F s (pairNode i j k) t *
        (pairEvaluation F i j (pairTransportTitsWord F v))⁻¹ =
      coverSimple F z (pairNode i j l) u) :
    pairQuotient F (transportTitsWord F (pairTransportNodes i j v)) *
        pairQuotient F (FreeGroup.of (s, pairNode i j k, t)) *
        (pairQuotient F (transportTitsWord F (pairTransportNodes i j v)))⁻¹ =
      pairQuotient F (FreeGroup.of (z, pairNode i j l, u)) := by
  have he : pairEvaluation F i j (pairTransportRouteWord F v s k t) =
      pairEvaluation F i j (FreeGroup.of (z, l, u)) := by
    simpa only [pairTransportRouteWord, map_mul, map_inv, pairEvaluation_of] using h
  have hl := pairQuotient_eq_of_pairEvaluation_eq F i j _ _ he
  simpa only [pairInclusion_pairTransportRouteWord, pairInclusion_of,
    transportRouteWord, map_mul, map_inv] using hl

/-- An actual-matrix factorization into two-node conjugation steps. The
intermediate marked elements are signed simple roots; a whole rank-two
segment is allowed in one step. Composition is `m * n`, so `n` acts first. -/
inductive NormalizerTransportPath :
    Cover F → (Bool × Fin 4 × F) → (Bool × Fin 4 × F) → Prop
  | refl (x) : NormalizerTransportPath 1 x x
  | localStep (i j : Fin 4) (v : List Bool) (s k z l : Bool) (t u : F)
      (h : pairEvaluation F i j (pairTransportTitsWord F v) *
          coverSimple F s (pairNode i j k) t *
          (pairEvaluation F i j (pairTransportTitsWord F v))⁻¹ =
        coverSimple F z (pairNode i j l) u) :
      NormalizerTransportPath (pairEvaluation F i j (pairTransportTitsWord F v))
        (s, pairNode i j k, t) (z, pairNode i j l, u)
  | trans {n m x y z} (hn : NormalizerTransportPath n x y)
      (hm : NormalizerTransportPath m y z) : NormalizerTransportPath (m * n) x z

/-- The independent geometric obligation, stated entirely in the actual cover.
The identity-element case is unnecessary and is handled by local relations. -/
def HasNormalizerTransportPaths : Prop :=
  ∀ (n : Cover F), n ∈ coverTransportNormalizer F →
    ∀ (s z : Bool) (i j : Fin 4) (t u : F), coverSimple F s i t ≠ 1 →
      n * coverSimple F s i t * n⁻¹ = coverSimple F z j u →
      NormalizerTransportPath F n (s, i, t) (z, j, u)

/-- Lift all steps of a matrix path through the faithful actual pair subgroups. -/
theorem NormalizerTransportPath.lift {n : Cover F} {x y : Bool × Fin 4 × F}
    (h : NormalizerTransportPath F n x y) :
    ∃ g : PairCompletion F, g ∈ transportNormalizer F ∧
      completionEvaluation F g = n ∧
      g * pairQuotient F (FreeGroup.of x) * g⁻¹ = pairQuotient F (FreeGroup.of y) := by
  induction h with
  | refl x => exact ⟨1, (transportNormalizer F).one_mem, map_one _, by simp⟩
  | localStep i j v s k z l t u h =>
    refine ⟨pairQuotient F (transportTitsWord F (pairTransportNodes i j v)),
      transportTitsWord_mem_normalizer F _, ?_,
      pairQuotient_local_transport F i j v s k z l t u h⟩
    rw [completionEvaluation_quotient, ← pairInclusion_pairTransportTitsWord]
    rfl
  | @trans n m x y z hn hm ihn ihm =>
    obtain ⟨a, ha, hea, hca⟩ := ihn
    obtain ⟨b, hb, heb, hcb⟩ := ihm
    refine ⟨b * a, (transportNormalizer F).mul_mem hb ha, ?_, ?_⟩
    · rw [map_mul, heb, hea]
    · calc
        (b * a) * _ * (b * a)⁻¹ =
            b * (a * pairQuotient F (FreeGroup.of x) * a⁻¹) * b⁻¹ := by group
        _ = _ := by rw [hca, hcb]

/-- Normalizer faithfulness makes the path lift agree with the prescribed lift. -/
theorem NormalizerTransportPath.conjugate (hf : TransportNormalizerFaithful F)
    {n : Cover F} {x y : Bool × Fin 4 × F} (h : NormalizerTransportPath F n x y)
    {g : PairCompletion F} (hg : g ∈ transportNormalizer F)
    (he : completionEvaluation F g = n) :
    g * pairQuotient F (FreeGroup.of x) * g⁻¹ = pairQuotient F (FreeGroup.of y) := by
  obtain ⟨g', hg', he', hc⟩ := h.lift F
  have heq : g = g' := hf hg hg' (he.trans he'.symm)
  exact heq ▸ hc

/-- A single simple-root identity is already a rank-one defining relation. -/
theorem pairQuotient_simple_eq_one_of_coverSimple_eq_one (s : Bool) (i : Fin 4) (t : F)
    (h : coverSimple F s i t = 1) :
    pairQuotient F (FreeGroup.of (s, i, t)) = 1 := by
  have he : pairEvaluation F i i (FreeGroup.of (s, true, t)) = pairEvaluation F i i 1 := by
    simpa only [pairEvaluation_of, pairNode, ite_self, map_one] using h
  simpa only [pairInclusion_of, pairNode, ite_self, map_one] using
    pairQuotient_eq_of_pairEvaluation_eq F i i _ _ he

/-- The identity route case needs neither normalizer faithfulness nor geometry. -/
theorem pairQuotient_route_eq_one_of_evaluation_eq_one
    (w : List typeF4RootPairing_base.support) (s : Bool) (i : Fin 4) (t : F)
    (h : coverEvaluation F (transportRouteWord F w s i t) = 1) :
    pairQuotient F (transportRouteWord F w s i t) = 1 := by
  have hx : coverSimple F s i t = 1 := by
    apply (MulAut.conj (coverEvaluation F (transportTitsWord F w))).injective
    simpa only [transportRouteWord, map_mul, map_inv, coverEvaluation_of,
      MulAut.conj_apply, mul_one, mul_inv_cancel] using h
  simp only [transportRouteWord, map_mul, map_inv,
    pairQuotient_simple_eq_one_of_coverSimple_eq_one F s i t hx, mul_one, mul_inv_cancel]

@[simp] theorem pairQuotient_transportRouteWord_zero
    (w : List typeF4RootPairing_base.support) (s : Bool) (i : Fin 4) :
    pairQuotient F (transportRouteWord F w s i 0) = 1 := by
  apply pairQuotient_route_eq_one_of_evaluation_eq_one
  have hx : coverSimple F s i 0 = 1 := by
    cases s <;> simp [coverSimple]
  simp only [transportRouteWord, map_mul, map_inv, coverEvaluation_of, hx,
    mul_one, mul_inv_cancel]

/-- The two genuine source inputs suffice for marked transport coherence. -/
theorem transportCoherent_of_normalizerFaithful_and_paths
    (hf : TransportNormalizerFaithful F) (hp : HasNormalizerTransportPaths F) :
    TransportCoherent F := by
  intro w v s z i j t u h
  by_cases hzero : coverEvaluation F (transportRouteWord F w s i t) = 1
  · rw [pairQuotient_route_eq_one_of_evaluation_eq_one F w s i t hzero,
      pairQuotient_route_eq_one_of_evaluation_eq_one F v z j u (h.symm.trans hzero)]
  let a := pairQuotient F (transportTitsWord F w)
  let b := pairQuotient F (transportTitsWord F v)
  have ha := transportTitsWord_mem_normalizer F w
  have hb := transportTitsWord_mem_normalizer F v
  have hg : b⁻¹ * a ∈ transportNormalizer F :=
    (transportNormalizer F).mul_mem ((transportNormalizer F).inv_mem hb) ha
  have hn := completionEvaluation_mem_coverTransportNormalizer F hg
  have hx : coverSimple F s i t ≠ 1 := by
    intro he
    apply hzero
    simp only [transportRouteWord, map_mul, map_inv, coverEvaluation_of, he,
      mul_one, mul_inv_cancel]
  have hc : completionEvaluation F (b⁻¹ * a) * coverSimple F s i t *
      (completionEvaluation F (b⁻¹ * a))⁻¹ = coverSimple F z j u := by
    have he := congrArg
      (fun q => (coverEvaluation F (transportTitsWord F v))⁻¹ * q *
        coverEvaluation F (transportTitsWord F v)) h
    simp only [transportRouteWord, map_mul, map_inv, coverEvaluation_of] at he
    dsimp only [a, b]
    simp only [map_mul, map_inv, completionEvaluation_quotient]
    calc
      _ = (coverEvaluation F (transportTitsWord F v))⁻¹ *
          (coverEvaluation F (transportTitsWord F w) * coverSimple F s i t *
            (coverEvaluation F (transportTitsWord F w))⁻¹) *
          coverEvaluation F (transportTitsWord F v) := by group
      _ = _ := by rw [he]; group
  have hpath := hp _ hn s z i j t u hx hc
  have hl := hpath.conjugate F hf hg rfl
  have he := congrArg (fun q => b * q * b⁻¹) hl
  simp only [transportRouteWord, map_mul, map_inv]
  change a * _ * a⁻¹ = b * _ * b⁻¹
  calc
    _ = b * ((b⁻¹ * a) * _ * (b⁻¹ * a)⁻¹) * b⁻¹ := by group
    _ = _ := he

/-- Application to the exact plane-relation consumer; charts remain independent. -/
theorem rootTransport_planes_of_normalizerFaithful_paths_and_charts
    (hf : TransportNormalizerFaithful F) (hp : HasNormalizerTransportPaths F)
    (hcharts : HasPairPlaneCharts F) (a b : typeF4Roots) (v : RootPlaneWord F a b)
    (hv : rootPlaneEvaluation F a b v = 1) :
    rootTransport F (rootPlaneInclusion F a b v) = 1 :=
  rootTransport_planes_of_coherence_and_charts F
    (transportCoherent_of_normalizerFaithful_and_paths F hf hp) hcharts a b v hv

end TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
