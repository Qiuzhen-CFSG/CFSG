module
public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.F4Identification.WordDescent.ComplementRepresentation.PairPresentation.RootPlanePresentation.TorusFaithfulness

/-!
# Reducing all coroot words to the four simple families

Every literal six-letter coroot word acts diagonally, with exponent given by
pairing with its coroot. For positive roots this follows by transporting the
simple-root calculation along the chosen integral Tits word. The integral
Cartan-root involution gives the negative-root calculation. The grading
transport identities suffice; no comparison of arbitrary root-operator routes
or signs is assumed.

The coroot reflection formula is an equality of these actual matrices. All
three coroot words in that formula lie in one complete root plane, so the
identity holds in the plane completion. Reflection induction then puts every
coroot in the subgroup generated by the four simple coroot families. This is
the Lemma 38 step of Steinberg's presentation argument, over every field.

The final conditional theorem applies the reduction and torus faithfulness to
the exact all-root kernel equality. The global Bruhat normal-form placement of
the kernel in the all-coroot subgroup remains an explicit, independent premise.
Source: Steinberg, *Lectures on Chevalley Groups*, §3, printed pp.40–42,
Lemma 38 and Theorem 8 (`refs/KGroup/GLS3/Chapter2St1.tex`, lines 1116–1128).
-/

@[expose] public section
noncomputable section
namespace TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
open RootPairing.SimpleGeckGroup
open ExceptionalSplit.TheoremDRootNormalizer
attribute [local instance] Classical.decEq
local instance : Fintype typeF4Roots := Fintype.ofFinite _
local instance : InvolutiveNeg typeF4Roots := typeF4RootPairing.indexNeg
private abbrev P := typeF4RootPairing
private abbrev b := typeF4RootPairing_base
private abbrev Idx := b.support ⊕ typeF4Roots
variable (F : Type*) [Field F]

private def corootDiagonal (r : typeF4Roots) (t : Fˣ) : (Matrix Idx Idx F)ˣ where
  val := Matrix.diagonal fun a => (t ^ chevalleyBasisWeight (P := P) a r : Fˣ)
  inv := Matrix.diagonal fun a => ((t ^ chevalleyBasisWeight (P := P) a r)⁻¹ : Fˣ)
  val_inv := by
    rw [Matrix.diagonal_mul_diagonal]
    trans Matrix.diagonal (fun _ : Idx => (1 : F))
    · apply congrArg Matrix.diagonal
      funext a
      exact (t ^ chevalleyBasisWeight (P := P) a r).val_inv
    · exact Matrix.diagonal_one
  inv_val := by
    rw [Matrix.diagonal_mul_diagonal]
    trans Matrix.diagonal (fun _ : Idx => (1 : F))
    · apply congrArg Matrix.diagonal
      funext a
      exact (t ^ chevalleyBasisWeight (P := P) a r).inv_val
    · exact Matrix.diagonal_one

private theorem corootDiagonal_simple (i : b.support) (t : Fˣ) :
    corootDiagonal F i t = integralChevalleyTorusElement (P := P)
      (integralChevalleySimpleCorootParameter i t⁻¹) := by
  apply Units.ext
  apply congrArg Matrix.diagonal
  funext a
  congr 1
  simp [chevalleyBasisTorusUnit, integralChevalleySimpleCorootParameter]

private theorem corootDiagonal_transport
    (A : (Matrix Idx Idx F)ˣ) (B : Matrix Idx Idx ℤ)
    (σ : typeF4Roots → typeF4Roots)
    (hA : A.val = specializeMatrix B)
    (hB : RespectsChevalleyGrading (P := P) B σ)
    (r : typeF4Roots) (t : Fˣ) :
    A * corootDiagonal F (σ r) t * A⁻¹ = corootDiagonal F r t := by
  apply (mul_right_cancel_iff (a := A)).mp
  rw [inv_mul_cancel_right]
  apply Units.ext
  change A.val * Matrix.diagonal _ = Matrix.diagonal _ * A.val
  rw [hA]
  ext row col
  simp only [Matrix.mul_diagonal, Matrix.diagonal_mul]
  by_cases hz : B row col = 0
  · simp [specializeMatrix, hz]
  · rw [hB row col hz r]
    exact mul_comm _ _

private theorem corootDiagonal_word (word : List b.support) (r : typeF4Roots) (t : Fˣ) :
    rootCurveTitsWord (P := P) (S := F) word * corootDiagonal F r t *
      (rootCurveTitsWord (P := P) (S := F) word)⁻¹ =
      corootDiagonal F (reflectionWord (P := P) word r) t := by
  have h := corootDiagonal_transport F (rootCurveTitsWord (P := P) (S := F) word)
    (titsWord (P := P) word) (inverseReflectionWord (P := P) word) rfl
    (titsWord_respectsChevalleyGrading word) (reflectionWord (P := P) word r) t
  simpa only [inverseReflectionWord_right_inverse] using h

private def omegaUnit : (Matrix Idx Idx F)ˣ where
  val := specializeMatrix (omegaMatrix (P := P) (b := b))
  inv := specializeMatrix (omegaMatrix (P := P) (b := b))
  val_inv := by rw [← specializeMatrix_mul, omegaMatrix_sq, specializeMatrix_one]
  inv_val := by rw [← specializeMatrix_mul, omegaMatrix_sq, specializeMatrix_one]

private theorem omega_positive (i : b.support) (t : F) :
    omegaUnit F * positiveUnit i t * (omegaUnit F)⁻¹ = negativeUnit i t := by
  apply Units.ext
  change specializeMatrix (omegaMatrix (P := P) (b := b)) * positiveMatrix i t *
    specializeMatrix (omegaMatrix (P := P) (b := b)) = negativeMatrix i t
  have hsq := (omegaUnit F).val_inv
  simp only [omegaUnit] at hsq
  simp only [positiveMatrix_formula, negativeMatrix_formula, fDividedPower,
    Matrix.map_mul, Matrix.mul_add, Matrix.add_mul, Matrix.mul_smul, Matrix.smul_mul]
  change _ = 1 + t • (specializeMatrix (omegaMatrix (P := P) (b := b)) *
      specializeMatrix (eDividedPower i 1) * specializeMatrix (omegaMatrix (P := P) (b := b))) +
    t ^ 2 • (specializeMatrix (omegaMatrix (P := P) (b := b)) *
      specializeMatrix (eDividedPower i 2) * specializeMatrix (omegaMatrix (P := P) (b := b))) +
    t ^ 3 • (specializeMatrix (omegaMatrix (P := P) (b := b)) *
      specializeMatrix (eDividedPower i 3) * specializeMatrix (omegaMatrix (P := P) (b := b)))
  noncomm_ring [hsq]

private theorem omega_negative (i : b.support) (t : F) :
    omegaUnit F * negativeUnit i t * (omegaUnit F)⁻¹ = positiveUnit i t := by
  rw [← omega_positive]
  have hsq : omegaUnit F * omegaUnit F = 1 := Units.ext (omegaUnit F).val_inv
  have hinv : (omegaUnit F)⁻¹ = omegaUnit F := rfl
  rw [hinv]
  calc
    omegaUnit F * (omegaUnit F * positiveUnit i t * omegaUnit F) * omegaUnit F =
        (omegaUnit F * omegaUnit F) * positiveUnit i t * (omegaUnit F * omegaUnit F) := by group
    _ = _ := by rw [hsq, one_mul, mul_one]

private theorem matrixH_neg_simple (i : b.support) (t : Fˣ) :
    matrixH (b := b) (F := F) (-i) t = corootDiagonal F (-i) t := by
  have he : matrixH (b := b) (F := F) (-i) t =
      omegaUnit F * matrixH (b := b) (F := F) i t * (omegaUnit F)⁻¹ := by
    change matrixH (b := b) (F := F) (-i) t =
      MulAut.conj (omegaUnit F) (matrixH (b := b) (F := F) i t)
    simp only [matrixH, matrixN, map_mul, neg_neg, rootCurveUnit_simple,
      rootCurveUnit_neg_simple, MulAut.conj_apply, omega_positive, omega_negative]
  rw [he, rootPlane_matrixH_simple, ← corootDiagonal_simple]
  have h := corootDiagonal_transport F (omegaUnit F) (omegaMatrix (P := P) (b := b))
    (-·) rfl omegaMatrix_respectsChevalleyGrading (-i) t
  simpa only [neg_neg] using h

private theorem matrixH_diagonal_pos (r : typeF4Roots) (hr : b.IsPos r) (t : Fˣ) :
    matrixH (b := b) (F := F) r t = corootDiagonal F r t := by
  let route := rootRoute (P := P) (b := b) r
  have hn : ¬ b.IsPos (-r) := (RootPairing.Base.IsPos.neg_iff_not b r).not.mpr (not_not.mpr hr)
  have he : matrixH (b := b) (F := F) r t =
      rootCurveTitsWord (S := F) route.word * matrixH (b := b) (F := F) route.simple t *
        (rootCurveTitsWord (S := F) route.word)⁻¹ := by
    let c := MulAut.conj (rootCurveTitsWord (P := P) (S := F) route.word)
    have hx (s : F) :
        rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) r s =
          c (rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) route.simple s) := by
      rw [rootCurveUnit_of_pos r hr, rootCurveUnit_simple]
      rfl
    have hy (s : F) :
        rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) (-r) s =
          c (rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) (-route.simple) s) := by
      rw [rootCurveUnit_of_neg (-r) hn, rootCurveUnit_neg_simple, neg_neg]
      rfl
    change matrixH (b := b) (F := F) r t = c (matrixH (b := b) (F := F) route.simple t)
    simp only [matrixH, matrixN, map_mul, hx, hy]

  rw [he, rootPlane_matrixH_simple, ← corootDiagonal_simple, corootDiagonal_word, route.target]

private theorem matrixH_diagonal_neg (r : typeF4Roots) (hr : ¬ b.IsPos r) (t : Fˣ) :
    matrixH (b := b) (F := F) r t = corootDiagonal F r t := by
  let route := rootRoute (P := P) (b := b) (-r)
  have hn : b.IsPos (-r) := (RootPairing.Base.IsPos.neg_iff_not b r).mpr hr
  have he : matrixH (b := b) (F := F) r t =
      rootCurveTitsWord (S := F) route.word * matrixH (b := b) (F := F) (-route.simple) t *
        (rootCurveTitsWord (S := F) route.word)⁻¹ := by
    let c := MulAut.conj (rootCurveTitsWord (P := P) (S := F) route.word)
    have hx (s : F) :
        rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) r s =
          c (rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) (-route.simple) s) := by
      rw [rootCurveUnit_of_neg r hr, rootCurveUnit_neg_simple]
      rfl
    have hy (s : F) :
        rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) (-r) s =
          c (rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) route.simple s) := by
      rw [rootCurveUnit_of_pos (-r) hn, rootCurveUnit_simple]
      rfl
    change matrixH (b := b) (F := F) r t = c (matrixH (b := b) (F := F) (-route.simple) t)
    simp only [matrixH, matrixN, map_mul, neg_neg, hx, hy]

  rw [he, matrixH_neg_simple, corootDiagonal_word, reflectionWord_neg, route.target, neg_neg]

private theorem matrixH_diagonal (r : typeF4Roots) (t : Fˣ) :
    matrixH (b := b) (F := F) r t = corootDiagonal F r t := by
  by_cases hr : b.IsPos r
  · exact matrixH_diagonal_pos F r hr t
  · exact matrixH_diagonal_neg F r hr t

private theorem weight_neg (a : Idx) (r : typeF4Roots) :
    chevalleyBasisWeight (P := P) a (-r) = -chevalleyBasisWeight (P := P) a r := by
  cases a with
  | inl i => simp [chevalleyBasisWeight]
  | inr s => exact P.pairingIn_reflectionPerm_self_right ℤ s r

private theorem weight_reflect (a : Idx) (r s : typeF4Roots) :
    chevalleyBasisWeight (P := P) a (P.reflectionPerm s r) =
      chevalleyBasisWeight (P := P) a r -
        P.pairingIn ℤ s r * chevalleyBasisWeight (P := P) a s := by
  cases a with
  | inl i => simp [chevalleyBasisWeight]
  | inr k =>
    change P.pairingIn ℤ k (P.reflectionPerm s r) = _
    apply FaithfulSMul.algebraMap_injective ℤ ℝ
    simp only [map_sub, map_mul, RootPairing.algebraMap_pairingIn, chevalleyBasisWeight]
    simp only [← P.root_coroot_eq_pairing, P.coroot_reflectionPerm,
      P.coreflection_apply_coroot, map_sub, map_smul, smul_eq_mul]

private theorem corootDiagonal_neg (r : typeF4Roots) (t : Fˣ) :
    corootDiagonal F (-r) t = corootDiagonal F r t⁻¹ := by
  apply Units.ext
  apply congrArg Matrix.diagonal
  funext a
  rw [weight_neg, zpow_neg, inv_zpow]

private theorem corootDiagonal_reflect (r s : typeF4Roots) (t : Fˣ) :
    corootDiagonal F (P.reflectionPerm s r) t =
      corootDiagonal F r t * corootDiagonal F s (t ^ (-P.pairingIn ℤ s r)) := by
  apply Units.ext
  change Matrix.diagonal _ = Matrix.diagonal _ * Matrix.diagonal _
  rw [Matrix.diagonal_mul_diagonal]
  apply congrArg Matrix.diagonal
  funext a
  simp only [weight_reflect, zpow_sub, zpow_mul, zpow_neg, Units.val_mul, inv_zpow]

/-- The image of the actual six-letter coroot word for an arbitrary root. -/
def completionRootCoroot (r : typeF4Roots) (t : Fˣ) : RootPlaneCompletion F :=
  rootPlaneQuotient F (rootHWord F r t)

/-- The all-coroot subgroup in Steinberg's normal-form theorem. -/
def completionAllCorootSubgroup : Subgroup (RootPlaneCompletion F) :=
  Subgroup.closure (Set.range fun rt : typeF4Roots × Fˣ => completionRootCoroot F rt.1 rt.2)

private theorem rootHWord_matrixH (r : typeF4Roots) (t : Fˣ) :
    (rootEvaluation F (rootHWord F r t)).val = matrixH (b := b) (F := F) r t := by
  simp only [rootHWord, rootNWord, map_mul, rootEvaluation_of, Subgroup.coe_mul]
  rfl

/-- The actual coroot word is diagonal, with the integral coroot pairing as
exponent. This includes every root and every unit over every field. -/
theorem rootHWord_matrix_entries (r : typeF4Roots) (t : Fˣ) :
    ((rootEvaluation F (rootHWord F r t)).val).val =
      Matrix.diagonal (fun a : typeF4RootPairing_base.support ⊕ typeF4Roots =>
        ((t ^ chevalleyBasisWeight (P := typeF4RootPairing) a r : Fˣ) : F)) := by
  rw [rootHWord_matrixH, matrixH_diagonal]
  rfl

/-- Opposite coroots invert their parameter, using a literal rank-one relation. -/
theorem completionRootCoroot_neg (r : typeF4Roots) (t : Fˣ) :
    completionRootCoroot F (-r) t = completionRootCoroot F r t⁻¹ := by
  apply rootPlaneQuotient_eq_of_plane F r r
    (rootHWord_mem_plane F _ _ _ (rootPlane_neg_mem (rootPlane_left _ _)) _)
    (rootHWord_mem_plane F _ _ _ (rootPlane_left _ _) _)
  apply Subtype.ext
  rw [rootHWord_matrixH, rootHWord_matrixH, matrixH_diagonal, matrixH_diagonal,
    corootDiagonal_neg]

private theorem reflection_mem_plane (r s : typeF4Roots) :
    P.reflectionPerm s r ∈ rootPlane r s := by
  change P.root (P.reflectionPerm s r) ∈ Submodule.span ℝ {P.root r, P.root s}
  rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply]
  exact Submodule.sub_mem _ (rootPlane_left r s)
    (Submodule.smul_mem _ _ (rootPlane_right r s))

/-- A reflected coroot is the product of the original and reflecting coroots.
The exponent uses the coroot reflection coefficient, with its literal order. -/
theorem completionRootCoroot_reflect (r s : typeF4Roots) (t : Fˣ) :
    completionRootCoroot F (typeF4RootPairing.reflectionPerm s r) t =
      completionRootCoroot F r t *
        completionRootCoroot F s (t ^ (-typeF4RootPairing.pairingIn ℤ s r)) := by
  change rootPlaneQuotient F _ = rootPlaneQuotient F _ * rootPlaneQuotient F _
  rw [← map_mul]
  apply rootPlaneQuotient_eq_of_plane F r s
    (rootHWord_mem_plane F _ _ _ (reflection_mem_plane r s) _)
    (Subgroup.mul_mem _ (rootHWord_mem_plane F _ _ _ (rootPlane_left _ _) _)
      (rootHWord_mem_plane F _ _ _ (rootPlane_right _ _) _))
  apply Subtype.ext
  simp only [map_mul, Subgroup.coe_mul, rootHWord_matrixH, matrixH_diagonal]
  exact corootDiagonal_reflect F r s t

/-- Steinberg Lemma 38 for the plane completion: every actual coroot belongs to
its subgroup generated by the four simple coroot families. -/
theorem completionRootCoroot_mem_simple (r : typeF4Roots) (t : Fˣ) :
    completionRootCoroot F r t ∈ completionCorootSubgroup F := by
  suffices h : ∀ t : Fˣ, completionRootCoroot F r t ∈ completionCorootSubgroup F from h t
  apply b.induction_reflect r
  · intro i hi u
    change completionRootCoroot F (-i) u ∈ _
    rw [completionRootCoroot_neg]
    exact hi u⁻¹
  · intro i hi u
    let j : Fin 4 := typeF4RootPairing_baseEquiv.symm ⟨i, hi⟩
    have hj : sourceIndex j = i := congrArg Subtype.val
      (typeF4RootPairing_baseEquiv.apply_symm_apply ⟨i, hi⟩)
    rw [← hj]
    exact Subgroup.subset_closure ⟨(j, u), rfl⟩
  · intro i j hi hj u
    rw [completionRootCoroot_reflect]
    apply Subgroup.mul_mem _ (hi u)
    let k : Fin 4 := typeF4RootPairing_baseEquiv.symm ⟨j, hj⟩
    have hk : sourceIndex k = j := congrArg Subtype.val
      (typeF4RootPairing_baseEquiv.apply_symm_apply ⟨j, hj⟩)
    rw [← hk]
    exact Subgroup.subset_closure ⟨(k, _), rfl⟩

/-- The all-root and simple-root coroot subgroups agree in the plane completion. -/
theorem completionAllCorootSubgroup_eq :
    completionAllCorootSubgroup F = completionCorootSubgroup F := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨r, t⟩, rfl⟩
    exact completionRootCoroot_mem_simple F r t
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨i, t⟩, rfl⟩
    exact Subgroup.subset_closure ⟨(sourceIndex i, t), rfl⟩

/-- Apply the proved coroot reduction and torus faithfulness to the original
presentation consumer. Only the global normal-form kernel placement remains. -/
theorem ker_eq_rootPlaneRelationSubgroup_of_all_coroot_reduction
    (h : (rootCompletionEvaluation F).ker ≤ completionAllCorootSubgroup F) :
    (rootEvaluation F).ker = rootPlaneRelationSubgroup F := by
  apply ker_eq_rootPlaneRelationSubgroup_of_coroot_reduction F
  simpa only [completionAllCorootSubgroup_eq] using h

end TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
