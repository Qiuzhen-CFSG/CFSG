module

public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.F4Identification.WordDescent.ComplementRepresentation.PairPresentation.RootTransport.NormalizerCoherence.ParameterOneFaithfulness.CoxeterReduction

/-!
# Parameter-one normalizer faithfulness: assembly interface

The Coxeter reduction proves restricted normalizer faithfulness from
normalization and matrix faithfulness of the subgroup generated by the four
Tits squares. This module connects that result to the original marked-route
consumer. Those two sign-torus facts remain to be proved; path existence is a
separate source input. No unconditional faithfulness or coherence is claimed.

Source: GLS3, Theorem 2.9.3, `refs/KGroup/GLS3/chapter2.tex`, lines 1429--1441.
-/

@[expose] public section
noncomputable section
namespace TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
variable (F : Type*) [Field F]

/-- The literal marked-route consumer, with only the independent path input
and the two remaining sign-torus calculations explicit. -/
theorem transportCoherent_of_signTorus_and_paths
    (hn : transportNormalizer F ≤ Subgroup.normalizer (transportSignTorus F : Set (PairCompletion F)))
    (ht : Set.InjOn (completionEvaluation F) (transportSignTorus F))
    (hp : HasNormalizerTransportPaths F) : TransportCoherent F :=
  transportCoherent_of_normalizerFaithful_and_paths F
    (transportNormalizerFaithful_of_signTorus F hn ht) hp


end TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
