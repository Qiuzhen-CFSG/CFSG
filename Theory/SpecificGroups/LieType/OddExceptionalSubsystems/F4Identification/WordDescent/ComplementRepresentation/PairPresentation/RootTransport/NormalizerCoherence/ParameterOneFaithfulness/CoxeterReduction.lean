module

public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.F4Identification.WordDescent.ComplementRepresentation.PairPresentation.RootTransport.NormalizerCoherence
public import Theory.AlgebraicGroup.RootSystems.WeylGroupCoxeterPresentation

/-!
# Parameter-one Tits relations and reduction to the sign torus

Inside the literal two-node completion, let `n_i` be the positive Tits lift
`x_i(1) x_{-i}(-1) x_i(1)` and let H be generated by the four squares `n_i²`.
The actual pair embeddings lift the integral fourth-power, square-commutation,
and braid identities to the completion. Every element of the Tits normalizer
therefore has a positive word, with inverse generators represented by cubes.

The root-coordinate block detects the Weyl permutation of any such word over
every field, including characteristic three. Assuming only normalization of H,
Coxeter deletion in the literal quotient N/H puts every evaluation-kernel
word in H. Faithfulness on H then proves faithfulness on N. Normality is
relative to N; no ambient normality in the whole completion is asserted.
Cancellation deletes `n_i²` only in N/H, retaining the square in H itself.

The remaining source inputs are the conjugation formulas for these squares
and faithfulness of their diagonal matrices. They are explicit premises here,
not a proof of the unconditional normalizer theorem.

Source: GLS3, Theorem 2.9.3, normalizer argument in
`refs/KGroup/GLS3/chapter2.tex`, lines 1429--1441.
-/

@[expose] public section
noncomputable section
namespace TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
open Theory.AlgebraicGroup
open Matrix
attribute [local instance] Classical.decEq
local instance : Fintype typeF4Roots := Fintype.ofFinite _
variable (F : Type*) [Field F]

/-- The literal positive parameter-one lift of a simple reflection. -/
def transportGenerator (i : typeF4RootPairing_base.support) : PairCompletion F :=
  pairQuotient F (transportTitsWord F [i])

/-- Only the four square corrections, inside the original completion. -/
def transportSignTorus : Subgroup (PairCompletion F) :=
  Subgroup.closure (Set.range fun i : typeF4RootPairing_base.support =>
    transportGenerator F i ^ 2)

theorem transportGenerator_mem (i : typeF4RootPairing_base.support) :
    transportGenerator F i ∈ transportNormalizer F :=
  transportTitsWord_mem_normalizer F [i]

theorem transportSignTorus_le_normalizer : transportSignTorus F ≤ transportNormalizer F := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  exact (transportNormalizer F).pow_mem (transportGenerator_mem F i) 2

theorem transportGenerator_sq_mem (i : typeF4RootPairing_base.support) :
    transportGenerator F i ^ 2 ∈ transportSignTorus F :=
  Subgroup.subset_closure ⟨i, rfl⟩

private theorem exists_pair_nodes (i j : typeF4RootPairing_base.support)
    (w : List typeF4RootPairing_base.support) (hw : ∀ k ∈ w, k = i ∨ k = j) :
    ∃ v : List Bool, pairTransportNodes (typeF4RootPairing_baseEquiv.symm i)
      (typeF4RootPairing_baseEquiv.symm j) v = w := by
  induction w with
  | nil => exact ⟨[], rfl⟩
  | cons k w ih =>
    obtain ⟨v, hv⟩ := ih (fun q hq => hw q (List.mem_cons_of_mem _ hq))
    rcases hw k (List.mem_cons_self) with hki | hkj
    · refine ⟨true :: v, ?_⟩
      simpa [pairTransportNodes, pairNode, sourceIndex, hki] using congrArg (List.cons k) hv
    · refine ⟨false :: v, ?_⟩
      simpa [pairTransportNodes, pairNode, sourceIndex, hkj] using congrArg (List.cons k) hv

/-- Matrix equalities between words in two chosen lifts hold in the completion. -/
theorem transportWords_eq_of_two_nodes (i j : typeF4RootPairing_base.support)
    (w v : List typeF4RootPairing_base.support)
    (hw : ∀ k ∈ w, k = i ∨ k = j) (hv : ∀ k ∈ v, k = i ∨ k = j)
    (he : coverEvaluation F (transportTitsWord F w) =
      coverEvaluation F (transportTitsWord F v)) :
    pairQuotient F (transportTitsWord F w) = pairQuotient F (transportTitsWord F v) := by
  obtain ⟨w', rfl⟩ := exists_pair_nodes i j w hw
  obtain ⟨v', rfl⟩ := exists_pair_nodes i j v hv
  rw [← pairInclusion_pairTransportTitsWord, ← pairInclusion_pairTransportTitsWord] at he ⊢
  exact pairQuotient_eq_of_pairEvaluation_eq F _ _ _ _ he

@[simp] theorem transport_word_cons (i : typeF4RootPairing_base.support)
    (w : List typeF4RootPairing_base.support) :
    pairQuotient F (transportTitsWord F (i :: w)) =
      transportGenerator F i * pairQuotient F (transportTitsWord F w) := by
  rw [show i :: w = [i] ++ w from rfl, transportTitsWord_append, map_mul]
  rfl

private theorem cover_word_eq_of_integral
    (w v : List typeF4RootPairing_base.support)
    (h : titsWord (P := typeF4RootPairing) w = titsWord v) :
    coverEvaluation F (transportTitsWord F w) = coverEvaluation F (transportTitsWord F v) := by
  apply Subtype.ext
  rw [coverEvaluation_transportTitsWord, coverEvaluation_transportTitsWord]
  apply Units.ext
  change specializeMatrix (S := F) (titsWord w) = specializeMatrix (S := F) (titsWord v)
  rw [h]

private theorem lift_square_eq_cancellation (i : typeF4RootPairing_base.support) :
    titsLift i * titsLift i = titsCancellation i := by
  simpa only [List.nil_append, titsWord, Matrix.one_mul, Matrix.mul_one] using
    titsWord_insert_cancellation [] [] i

/-- The square correction is an involution, so a lift has fourth power one. -/
theorem transportGenerator_pow_four (i : typeF4RootPairing_base.support) :
    transportGenerator F i ^ 4 = 1 := by
  have hm : titsWord (P := typeF4RootPairing) [i, i, i, i] = titsWord [] := by
    simpa only [← lift_square_eq_cancellation, titsWord, Matrix.mul_one, Matrix.mul_assoc] using
      titsCancellation_mul_self i
  have h := transportWords_eq_of_two_nodes F i i [i, i, i, i] []
    (by simp) (by simp) (cover_word_eq_of_integral F _ _ hm)
  simpa [transport_word_cons, pow_succ, mul_assoc] using h

private theorem integral_cancellations_commute (i j : typeF4RootPairing_base.support) :
    titsCancellation i * titsCancellation j = titsCancellation j * titsCancellation i := by
  let := typeF4RootPairing.indexNeg
  apply Matrix.ext_of_mulVec_single
  intro k
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  rcases k with k | k
  · change titsCancellation i *ᵥ (titsCancellation j *ᵥ u k) =
      titsCancellation j *ᵥ (titsCancellation i *ᵥ u k)
    simp only [titsCancellation_mulVec_u]
  · change titsCancellation i *ᵥ (titsCancellation j *ᵥ v k) =
      titsCancellation j *ᵥ (titsCancellation i *ᵥ v k)
    simp only [titsCancellation_mulVec_v, Matrix.mulVec_smul, smul_smul]
    rw [mul_comm]

/-- Commutation is lifted from the actual two-node subgroup. -/
theorem transportGenerator_sq_commute (i j : typeF4RootPairing_base.support) :
    Commute (transportGenerator F i ^ 2) (transportGenerator F j ^ 2) := by
  have hm : titsWord (P := typeF4RootPairing) [i, i, j, j] = titsWord [j, j, i, i] := by
    simpa only [← lift_square_eq_cancellation, titsWord, Matrix.mul_one, Matrix.mul_assoc] using
      integral_cancellations_commute i j
  have h := transportWords_eq_of_two_nodes F i j [i, i, j, j] [j, j, i, i]
    (by simp) (by simp) (cover_word_eq_of_integral F _ _ hm)
  simpa only [transport_word_cons, transportTitsWord_nil, map_one, mul_one,
    Commute, SemiconjBy, pow_two, mul_assoc] using h

/-- Every normalizer element has a positive Tits word; inverses use cubes. -/
theorem transportNormalizer_exists_word {g : PairCompletion F}
    (hg : g ∈ transportNormalizer F) :
    ∃ w : List typeF4RootPairing_base.support, pairQuotient F (transportTitsWord F w) = g := by
  induction hg using Subgroup.closure_induction'' with
  | mem x hx => obtain ⟨i, rfl⟩ := hx; exact ⟨[i], rfl⟩
  | inv_mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    refine ⟨[i, i, i], ?_⟩
    change _ = (transportGenerator F i)⁻¹
    apply mul_right_cancel (b := transportGenerator F i)
    simpa [transport_word_cons, pow_succ, mul_assoc] using transportGenerator_pow_four F i
  | one => exact ⟨[], by simp⟩
  | mul x y hx hy ihx ihy =>
    obtain ⟨w, rfl⟩ := ihx
    obtain ⟨v, rfl⟩ := ihy
    exact ⟨w ++ v, by rw [transportTitsWord_append, map_mul]⟩

private theorem alternatingWord_nodes {B : Type*} (i j : B) (n : ℕ) :
    ∀ k ∈ CoxeterSystem.alternatingWord i j n, k = i ∨ k = j := by
  induction n generalizing i j with
  | zero => simp [CoxeterSystem.alternatingWord]
  | succ n ih =>
    intro k hk
    simp only [CoxeterSystem.alternatingWord, List.concat_eq_append,
      List.mem_append, List.mem_singleton] at hk
    rcases hk with hk | rfl
    · exact (ih j i k hk).symm
    · exact Or.inr rfl

/-- The exact rank-two Tits braid relations in the pair completion. -/
theorem transport_braid (C : CoxeterMatrix typeF4RootPairing_base.support)
    (hC : ∀ i j, C i j = orderOf
      (typeF4RootPairing_base.simpleReflection i * typeF4RootPairing_base.simpleReflection j))
    (i j : typeF4RootPairing_base.support) :
    pairQuotient F (transportTitsWord F (CoxeterSystem.braidWord C i j)) =
      pairQuotient F (transportTitsWord F (CoxeterSystem.braidWord C j i)) := by
  apply transportWords_eq_of_two_nodes F i j
    _ _ (alternatingWord_nodes i j _) (fun k hk => (alternatingWord_nodes j i _ k hk).symm)
  exact cover_word_eq_of_integral F _ _ (titsWord_braidWord_eq_of_orders C hC i j)

private theorem root_reflectionWord (w : List typeF4RootPairing_base.support)
    (k : typeF4Roots) :
    typeF4RootPairing.root (reflectionWord w k) =
      typeF4RootPairing_base.wordProd w • typeF4RootPairing.root k := by
  induction w with
  | nil => simp [reflectionWord, RootPairing.Base.wordProd_nil]
  | cons i w ih =>
    rw [reflectionWord, typeF4RootPairing.root_reflectionPerm, ih,
      RootPairing.Base.wordProd_cons, mul_smul]
    rfl

/-- An identity matrix has trivial Weyl word even in characteristic three:
look at the root-coordinate diagonal entries of its signed permutation block. -/
theorem wordProd_eq_one_of_coverEvaluation_eq_one
    (w : List typeF4RootPairing_base.support)
    (he : coverEvaluation F (transportTitsWord F w) = 1) :
    typeF4RootPairing_base.wordProd w = 1 := by
  let := typeF4RootPairing.indexNeg
  have hm : specializeMatrix (S := F) (titsWord (P := typeF4RootPairing) w) = 1 := by
    have h := congrArg (fun g : Cover F => g.val.val) he
    simpa only [coverEvaluation_transportTitsWord, rootCurveTitsWord,
      Subgroup.coe_one, Units.val_one] using h
  have hr (k : typeF4Roots) : reflectionWord (P := typeF4RootPairing) w k = k := by
    by_contra hne
    have hc := congrFun (titsWord_mulVec_v (P := typeF4RootPairing) w k) (Sum.inr k)
    have hz : titsWord (P := typeF4RootPairing) w (Sum.inr k) (Sum.inr k) = 0 := by
      simpa [v, Matrix.mulVec_single, Pi.single_apply, Ne.symm hne] using hc
    have hf := congrArg (fun A => A (Sum.inr k) (Sum.inr k)) hm
    simp [specializeMatrix, hz] at hf
  apply Subtype.ext
  apply RootPairing.Equiv.weightHom_injective
  apply LinearEquiv.toLinearMap_injective
  apply typeF4RootPairing_base.toWeightBasis.ext
  intro i
  change typeF4RootPairing_base.wordProd w •
    typeF4RootPairing_base.toWeightBasis i = typeF4RootPairing_base.toWeightBasis i
  rw [RootPairing.Base.toWeightBasis_apply, ← root_reflectionWord, hr]


/-- A single generator-conjugation calculation suffices for relative normality.
The reverse conjugation uses the already proved fourth-power relation. -/
theorem transportSignTorus_normalized_of_generators
    (hconj : ∀ i j : typeF4RootPairing_base.support,
      transportGenerator F i * transportGenerator F j ^ 2 * (transportGenerator F i)⁻¹ ∈
        transportSignTorus F) :
    transportNormalizer F ≤ Subgroup.normalizer (transportSignTorus F : Set (PairCompletion F)) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  change transportGenerator F i ∈ Subgroup.normalizer (transportSignTorus F : Set (PairCompletion F))
  have hforward : ∀ x ∈ transportSignTorus F,
      transportGenerator F i * x * (transportGenerator F i)⁻¹ ∈ transportSignTorus F := by
    intro x hx
    have hle : transportSignTorus F ≤ (transportSignTorus F).comap
        (MulAut.conj (transportGenerator F i)).toMonoidHom := by
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨j, rfl⟩
      exact hconj i j
    exact hle hx
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · exact hforward x
  · intro hx
    have h := hforward _ (hforward _ (hforward _ hx))
    have he : transportGenerator F i *
        (transportGenerator F i *
          (transportGenerator F i * (transportGenerator F i * x * (transportGenerator F i)⁻¹) *
            (transportGenerator F i)⁻¹) * (transportGenerator F i)⁻¹) *
              (transportGenerator F i)⁻¹ = x := by
      calc
        _ = (transportGenerator F i ^ 4) * x * (transportGenerator F i ^ 4)⁻¹ := by
          simp only [pow_succ, pow_zero, one_mul]
          group
        _ = x := by rw [transportGenerator_pow_four]; simp
    exact he ▸ h

/-- Relative normality is in the generated Tits subgroup, not the completion. -/
theorem transportSignTorus_normal_subgroupOf
    (hn : transportNormalizer F ≤ Subgroup.normalizer (transportSignTorus F : Set (PairCompletion F))) :
    ((transportSignTorus F).subgroupOf (transportNormalizer F)).Normal :=
  (Subgroup.normal_subgroupOf_iff_le_normalizer
    (transportSignTorus_le_normalizer F)).mpr hn

/-- Coxeter deletion puts any word of trivial Weyl product in the sign torus.
The quotient is formed inside the literal transport normalizer. -/
theorem transport_word_mem_signTorus_of_wordProd_eq_one
    (hn : transportNormalizer F ≤ Subgroup.normalizer (transportSignTorus F : Set (PairCompletion F)))
    (w : List typeF4RootPairing_base.support)
    (hw : typeF4RootPairing_base.wordProd w = 1) :
    pairQuotient F (transportTitsWord F w) ∈ transportSignTorus F := by
  let H := (transportSignTorus F).subgroupOf (transportNormalizer F)
  let : H.Normal := transportSignTorus_normal_subgroupOf F hn
  let q := QuotientGroup.mk' H
  let l : List typeF4RootPairing_base.support → transportNormalizer F :=
    fun v => ⟨pairQuotient F (transportTitsWord F v), transportTitsWord_mem_normalizer F v⟩
  have happ (v z) : l (v ++ z) = l v * l z := by
    apply Subtype.ext
    change pairQuotient F (transportTitsWord F (v ++ z)) =
      pairQuotient F (transportTitsWord F v) * pairQuotient F (transportTitsWord F z)
    rw [transportTitsWord_append, map_mul]
  have hnil : l [] = 1 := Subtype.ext (by simp [l])
  have hsq (i) : q (l [i, i]) = 1 := by
    apply (QuotientGroup.eq_one_iff _).mpr
    change pairQuotient F (transportTitsWord F [i, i]) ∈ transportSignTorus F
    simpa only [transport_word_cons, transportTitsWord_nil, map_one, mul_one, pow_two] using
      transportGenerator_sq_mem F i
  obtain ⟨C, cs, hC, hs⟩ := typeF4RootPairing_base.weylGroup_coxeterPresentation
  have hstep {v z} (hm : CoxeterMove C v z) : q (l v) = q (l z) := by
    rcases hm with ⟨a, b, i, rfl, rfl⟩ | ⟨a, b, i, j, rfl, rfl⟩
    · simp only [happ, map_mul, hsq, mul_one]
    · have he : l (CoxeterSystem.braidWord C i j) =
          l (CoxeterSystem.braidWord C j i) :=
        Subtype.ext (transport_braid F C hC i j)
      simp only [happ, map_mul, he]
  have hp := typeF4RootPairing_base.wordProd_one_reflTransGen_nil C hC w hw
  have hpath {v z} (hp : Relation.ReflTransGen (CoxeterMove C) v z) :
      q (l v) = q (l z) := by
    induction hp with
    | refl => rfl
    | tail hp hm ih => exact ih.trans (hstep hm)
  have he := hpath hp
  have hk : q (l w) = 1 := by simpa only [hnil, map_one] using he
  change l w ∈ H
  exact (QuotientGroup.eq_one_iff (l w)).mp hk

/-- The two remaining torus inputs imply the requested restricted faithfulness.
No injectivity on the whole pair completion is used. -/
theorem transportNormalizerFaithful_of_signTorus
    (hn : transportNormalizer F ≤ Subgroup.normalizer (transportSignTorus F : Set (PairCompletion F)))
    (ht : Set.InjOn (completionEvaluation F) (transportSignTorus F)) :
    TransportNormalizerFaithful F := by
  have hker {g : PairCompletion F} (hg : g ∈ transportNormalizer F)
      (he : completionEvaluation F g = 1) : g = 1 := by
    obtain ⟨w, rfl⟩ := transportNormalizer_exists_word F hg
    have hw := wordProd_eq_one_of_coverEvaluation_eq_one F w he
    exact ht (transport_word_mem_signTorus_of_wordProd_eq_one F hn w hw)
      (Subgroup.one_mem _) (he.trans (map_one _).symm)
  intro x hx y hy he
  apply mul_inv_eq_one.mp
  apply hker ((transportNormalizer F).mul_mem hx ((transportNormalizer F).inv_mem hy))
  rw [map_mul, map_inv, he, mul_inv_cancel]

end TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
