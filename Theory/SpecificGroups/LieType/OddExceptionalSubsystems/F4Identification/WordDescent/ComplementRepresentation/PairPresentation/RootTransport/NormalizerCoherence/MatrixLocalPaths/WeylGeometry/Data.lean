/-- Initial state of a signed simple root. -/
def markState (x : Mark) : Fin 48 :=
  ⟨(if x.1 then 0 else 4) + x.2.val, by split <;> omega⟩

lemma routeMark_markState (x : Mark) : routeMark (markState x) = x := by
  rcases x with ⟨s, i⟩
  cases s <;> fin_cases i <;> rfl

lemma routeWord_markState (x : Mark) : routeWord (markState x) = [] := by
  rcases x with ⟨s, i⟩
  cases s <;> fin_cases i <;> rfl

