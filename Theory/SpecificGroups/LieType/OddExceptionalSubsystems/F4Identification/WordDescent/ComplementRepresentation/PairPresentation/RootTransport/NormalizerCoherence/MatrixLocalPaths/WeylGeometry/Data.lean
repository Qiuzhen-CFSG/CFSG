private lemma routeCoeff_eq (r : Fin 48) :
    wordCoeff (routeWord r) (markCoeff (routeMark r)) = routeCoeff r := by
  have hc : ∀ r : Fin 48,
      wordCoeff (routeWord r) (markCoeff (routeMark r)) = routeCoeff r := by decide
  exact hc r

lemma route_terminal (r : Fin 48) (x : Mark)
    (h : wordCoeff (routeWord r) (markCoeff (routeMark r)) = markCoeff x) :
    routeWord r = [] ∧ routeMark r = x := by
  have ht : ∀ (r : Fin 48) (s : Bool) (i : Fin 4),
      routeCoeff r = markCoeff (s, i) →
        routeWord r = [] ∧ routeMark r = (s, i) := by decide
  rw [routeCoeff_eq] at h
  exact ht r x.1 x.2 h

