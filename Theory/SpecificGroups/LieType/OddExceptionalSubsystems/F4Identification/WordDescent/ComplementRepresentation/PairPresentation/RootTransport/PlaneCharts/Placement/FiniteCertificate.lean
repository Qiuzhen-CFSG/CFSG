def coefficient (v : Fin 4 → ℤ) : Fin 4 → ℤ :=
  ![v 0 + v 1, 2 * v 0 + v 1 + v 2, 3 * v 0 + v 1 + v 2 + v 3, 2 * v 0]

def InPlane (a : Fin 48) (i j : Fin 4) : Prop :=
  ∀ k : Fin 4, k ≠ i → k ≠ j → coefficient (coords a) k = 0

instance finitePlacementInPlaneDecidable (a : Fin 48) (i j : Fin 4) : Decidable (InPlane a i j) :=
  inferInstanceAs (Decidable (∀ k : Fin 4, k ≠ i → k ≠ j → coefficient (coords a) k = 0))

def Valid (a b : Fin 48) : Prop :=
  let c := certificate a b
  if c.1 = 0 then InPlane a c.2.1 c.2.2 ∧ InPlane b c.2.1 c.2.2
  else (certificate (reflect c.2.1 a) (reflect c.2.1 b)).1 < c.1

instance finitePlacementValidDecidable (a b : Fin 48) : Decidable (Valid a b) := by unfold Valid; infer_instance

/-- Every pair is in a standard plane or admits a strictly decreasing reflection. -/
theorem valid : ∀ a b : Fin 48, Valid a b := by decide +kernel

/-- The table satisfies the Euclidean reflection formula after clearing denominators. -/
theorem reflection_valid : ∀ i : Fin 4, ∀ a : Fin 48, ∀ k : Fin 4,
    4 * coords (reflect i a) k = 4 * coords a k -
      (if i.val < 2 then 1 else 2) *
        (∑ t : Fin 4, coords a t * simple i t) * simple i k := by decide +kernel


theorem pair_coverage : ∀ i j : Fin 4, i ≠ j → ∀ s t : Bool,
    ∃ a : Fin 48, ∀ k : Fin 4, coords a k =
      (if k = i then (if s then 2 else -2) else 0) +
      (if k = j then (if t then 2 else -2) else 0) := by decide +kernel

theorem unit_coverage : ∀ i : Fin 4, ∀ s : Bool,
    ∃ a : Fin 48, ∀ k : Fin 4, coords a k =
      (if k = i then (if s then 2 else -2) else 0) := by decide +kernel

theorem half_coverage : ∀ ε : Fin 4 → Bool,
    ∃ a : Fin 48, ∀ k : Fin 4, coords a k =
      (if ε k then 1 else -1) := by decide +kernel

