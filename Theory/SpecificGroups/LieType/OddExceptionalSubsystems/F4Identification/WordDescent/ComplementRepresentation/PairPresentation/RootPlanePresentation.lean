module

public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.F4Identification.WordDescent.ComplementRepresentation.PairPresentation.RootPlanes

/-!
# The all-root plane completion and its coroot words

The quotient by the literal plane relations contains each actual plane subgroup
faithfully: equality of two plane words is tested by their matrix evaluations.
In particular this applies to the six-letter coroot words, with the source
convention `h_r(t) = n_r(t) n_r(-1)`.

The remaining normal-form obligation is to put the comparison kernel in the
subgroup generated by the four simple coroot families. The companion torus
calculation can then eliminate that kernel. This module does not assert the
normal-form theorem. Source: Steinberg, *Lectures on Chevalley Groups*, §3,
printed pp.40–42 and Theorem 8 (`refs/KGroup/GLS3/Chapter2St1.tex`).
-/

@[expose] public section
noncomputable section
namespace TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
open Theory.AlgebraicGroup.StandardRootSystem
attribute [local instance] Classical.decEq
local instance : Fintype typeF4Roots := Fintype.ofFinite _
local instance : InvolutiveNeg typeF4Roots := typeF4RootPairing.indexNeg

variable (F : Type*) [Field F]

instance rootPlaneRelationSubgroup_normal : (rootPlaneRelationSubgroup F).Normal :=
  inferInstanceAs (Subgroup.normalClosure (rootPlaneRelators F)).Normal

abbrev RootPlaneCompletion := RootWord F ⧸ rootPlaneRelationSubgroup F

def rootPlaneQuotient : RootWord F →* RootPlaneCompletion F :=
  QuotientGroup.mk' (rootPlaneRelationSubgroup F)

@[simp] theorem rootPlaneQuotient_eq_one_iff (w : RootWord F) :
    rootPlaneQuotient F w = 1 ↔ w ∈ rootPlaneRelationSubgroup F :=
  QuotientGroup.eq_one_iff w

def rootCompletionEvaluation : RootPlaneCompletion F →* Cover F :=
  QuotientGroup.lift (rootPlaneRelationSubgroup F) (rootEvaluation F)
    (rootPlaneRelationSubgroup_le F)

@[simp] theorem rootCompletionEvaluation_quotient (w : RootWord F) :
    rootCompletionEvaluation F (rootPlaneQuotient F w) = rootEvaluation F w := rfl

theorem rootCompletionEvaluation_surjective :
    Function.Surjective (rootCompletionEvaluation F) := by
  intro g
  obtain ⟨w, rfl⟩ := rootEvaluation_surjective F g
  exact ⟨rootPlaneQuotient F w, rfl⟩

/-- All equalities supported on one complete plane hold in the completion. -/
theorem rootPlaneQuotient_eq_of_plane (a b : typeF4Roots) {v w : RootWord F}
    (hv : v ∈ (rootPlaneInclusion F a b).range)
    (hw : w ∈ (rootPlaneInclusion F a b).range)
    (he : rootEvaluation F v = rootEvaluation F w) :
    rootPlaneQuotient F v = rootPlaneQuotient F w := by
  obtain ⟨v, rfl⟩ := hv
  obtain ⟨w, rfl⟩ := hw
  apply div_eq_one.mp
  rw [← map_div, ← map_div]
  apply (rootPlaneQuotient_eq_one_iff F _).mpr
  apply Subgroup.subset_normalClosure
  refine ⟨a, b, v / w, ?_, rfl⟩
  change rootEvaluation F (rootPlaneInclusion F a b (v / w)) = 1
  simpa only [map_div, div_eq_one] using he

omit [Field F] in
theorem rootLetter_mem_plane (a b r : typeF4Roots) (hr : r ∈ rootPlane a b) (t : F) :
    FreeGroup.of (r, t) ∈ (rootPlaneInclusion F a b).range :=
  ⟨FreeGroup.of (⟨r, hr⟩, t), rootPlaneInclusion_of F a b ⟨r, hr⟩ t⟩

omit F [Field F] in
theorem rootPlane_neg_mem {a b r : typeF4Roots} (hr : r ∈ rootPlane a b) :
    -r ∈ rootPlane a b := by
  change typeF4RootPairing.root (typeF4RootPairing.reflectionPerm r r) ∈
    Submodule.span ℝ {typeF4RootPairing.root a, typeF4RootPairing.root b}
  rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self]
  exact Submodule.neg_mem _ hr

omit F [Field F] in
theorem rootPlane_left (a b : typeF4Roots) : a ∈ rootPlane a b :=
  Submodule.subset_span (by simp)

omit F [Field F] in
theorem rootPlane_right (a b : typeF4Roots) : b ∈ rootPlane a b :=
  Submodule.subset_span (by simp)

/-- The literal three-letter Weyl word. -/
def rootNWord (r : typeF4Roots) (t : F) : RootWord F :=
  FreeGroup.of (r, t) * FreeGroup.of (-r, -t⁻¹) * FreeGroup.of (r, t)

/-- The six-letter coroot word, without identifying it with a diagonal yet. -/
def rootHWord (r : typeF4Roots) (t : Fˣ) : RootWord F :=
  rootNWord F r t * rootNWord F r (-1)

theorem rootNWord_mem_plane (a b r : typeF4Roots) (hr : r ∈ rootPlane a b) (t : F) :
    rootNWord F r t ∈ (rootPlaneInclusion F a b).range := by
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _ (rootLetter_mem_plane F a b r hr t)
      (rootLetter_mem_plane F a b (-r) (rootPlane_neg_mem hr) (-t⁻¹)))
    (rootLetter_mem_plane F a b r hr t)

theorem rootHWord_mem_plane (a b r : typeF4Roots) (hr : r ∈ rootPlane a b) (t : Fˣ) :
    rootHWord F r t ∈ (rootPlaneInclusion F a b).range :=
  Subgroup.mul_mem _ (rootNWord_mem_plane F a b r hr t)
    (rootNWord_mem_plane F a b r hr (-1))

/-- Simple coroots in the all-root completion retain their actual parameters. -/
def completionCoroot (i : Fin 4) (t : Fˣ) : RootPlaneCompletion F :=
  rootPlaneQuotient F (rootHWord F (sourceIndex i) t)

/-- The subgroup appearing in the normal-form kernel reduction. -/
def completionCorootSubgroup : Subgroup (RootPlaneCompletion F) :=
  Subgroup.closure (Set.range fun it : Fin 4 × Fˣ => completionCoroot F it.1 it.2)

end TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation
