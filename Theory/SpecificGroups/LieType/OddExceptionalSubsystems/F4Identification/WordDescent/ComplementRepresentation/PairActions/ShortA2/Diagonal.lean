module

public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.F4Identification.WordDescent.ComplementRepresentation.PairActions.Transport
public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.F4Identification.WordDescent.ComplementRepresentation.Coordinates

/-!
# The diagonal action of the two E6 end chains

The signed curves at nodes 1 and 0 generate a literal E6 subgroup. Each
element of this subgroup commutes with the diagram image of every other
element: the two chains (1,0) and (4,5) are disconnected. Thus multiplication
by the diagram image is a homomorphism. On generators it is exactly the
folded product defining F4 nodes 2 and 3, with the same sign and parameter.
Word generation puts its image inside the existing folded subgroup.

Restriction gives an unconditional action of this E6 chain subgroup on the
complement, together with its literal antisymmetric-column comparison. The
argument uses no division and no irreducibility; characteristic three is
included. `ShortA2` uses this action to reduce the target model comparison to
a marked representation on just the first E6 chain. It does not identify this
chain with the F4 cover subgroup.

Source: GLS3 §§2.3--2.6, especially the common-lattice construction in 2.6.2
(`refs/KGroup/GLS3/chapter2.tex`), for the inclusions used in Aschbacher--Smith
A.2.17, printed p.39 of `refs/quasithin.pdf`.
-/

@[expose] public section
noncomputable section
namespace TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation.ShortA2
open WordDescent Theory.AlgebraicGroup.StandardRootSystem

variable (F : Type*) [Field F]

/-- True selects folded node 2, whose chosen E6 representative is node 1. -/
def leftNode (k : Bool) : Fin 6 := if k then 1 else 0

def leftEvaluation : PairWord F →* splitCarrier F :=
  FreeGroup.lift fun x => simpleRoot F x.1 (leftNode x.2.1) x.2.2

@[simp] theorem leftEvaluation_of (s k : Bool) (t : F) :
    leftEvaluation F (FreeGroup.of (s, k, t)) = simpleRoot F s (leftNode k) t :=
  FreeGroup.lift_apply_of

/-- The actual matrix subgroup generated by the signed curves at nodes 1 and 0. -/
def leftSubgroup : Subgroup (splitCarrier F) := (leftEvaluation F).range

def leftGenerator (s k : Bool) (t : F) : leftSubgroup F :=
  (leftEvaluation F).rangeRestrict (FreeGroup.of (s, k, t))

@[simp] theorem leftGenerator_val (s k : Bool) (t : F) :
    (leftGenerator F s k t).val = simpleRoot F s (leftNode k) t :=
  leftEvaluation_of F s k t

private theorem leftRoot_commute_diagram (s k z l : Bool) (t u : F) :
    Commute (simpleRoot F s (leftNode k) t)
      (pinnedDiagram F (simpleRoot F z (leftNode l) u)) := by
  rw [simpleRoot_diagram]
  have hn : leftNode k ≠ typeE6DiagramPermutation (leftNode l) := by
    cases k <;> cases l <;> decide
  have hc : typeE6CartanMatrix (typeE6DiagramPermutation (leftNode l)) (leftNode k) = 0 := by
    cases k <;> cases l <;> decide
  cases s <;> cases z
  · exact simpleRoot_commute F false _ _ hn hc t u
  · exact (simpleRoot_opposite_commute F _ _ hn.symm u t).symm
  · exact simpleRoot_opposite_commute F _ _ hn t u
  · exact simpleRoot_commute F true _ _ hn hc t u

/-- Disconnectedness of the two end chains, for all elements and both signs. -/
theorem left_commute_diagram (g h : leftSubgroup F) :
    Commute (g : splitCarrier F) (pinnedDiagram F (h : splitCarrier F)) := by
  obtain ⟨v, hv⟩ := g.property
  obtain ⟨w, hw⟩ := h.property
  rw [← hv, ← hw]
  clear hv hw
  induction v using FreeGroup.induction_on with
  | C1 => simp only [map_one]; exact Commute.one_left _
  | of c =>
    induction w using FreeGroup.induction_on with
    | C1 => simp only [map_one]; exact Commute.one_right _
    | of d =>
      rcases c with ⟨s, k, t⟩
      rcases d with ⟨z, l, u⟩
      simpa only [leftEvaluation_of] using leftRoot_commute_diagram F s k z l t u
    | inv_of d hd => simpa only [map_inv] using hd.inv_right
    | mul v w hv hw => simpa only [map_mul] using hv.mul_right hw
  | inv_of c hc => simpa only [map_inv] using hc.inv_left
  | mul v w hv hw => simpa only [map_mul] using hv.mul_left hw

/-- Multiplication by the pinned diagram image on the first E6 chain. -/
def diagonalCarrier : leftSubgroup F →* splitCarrier F where
  toFun g := g.val * pinnedDiagram F g.val
  map_one' := by simp
  map_mul' g h := by
    simp only [Subgroup.coe_mul, map_mul]
    exact (left_commute_diagram F h g).mul_mul_mul_comm _ _

@[simp] theorem diagonalCarrier_generator (s k : Bool) (t : F) :
    diagonalCarrier F (leftGenerator F s k t) =
      (f4Simple F s (pairNode 2 3 k) t).val := by
  change (leftGenerator F s k t).val *
    pinnedDiagram F (leftGenerator F s k t).val = _
  rw [leftGenerator_val, simpleRoot_diagram]
  cases k <;> rfl

theorem diagonalCarrier_evaluation (w : PairWord F) :
    diagonalCarrier F ((leftEvaluation F).rangeRestrict w) =
      (foldedEvaluation F (pairInclusion F 2 3 w)).val := by
  have h : (diagonalCarrier F).comp (leftEvaluation F).rangeRestrict =
      (splitSubgroup F).subtype.comp ((foldedEvaluation F).comp (pairInclusion F 2 3)) := by
    apply FreeGroup.ext_hom
    rintro ⟨s, k, t⟩
    change diagonalCarrier F ((leftEvaluation F).rangeRestrict (FreeGroup.of (s, k, t))) =
      (foldedEvaluation F (pairInclusion F 2 3 (FreeGroup.of (s, k, t)))).val
    rw [pairInclusion_of, foldedEvaluation_of]
    exact diagonalCarrier_generator F s k t
  exact DFunLike.congr_fun h w

theorem diagonalCarrier_mem (g : leftSubgroup F) :
    diagonalCarrier F g ∈ splitSubgroup F := by
  obtain ⟨w, rfl⟩ := (leftEvaluation F).rangeRestrict_surjective g
  rw [diagonalCarrier_evaluation]
  exact (foldedEvaluation F (pairInclusion F 2 3 w)).property

/-- The diagonal image lands in the literal folded subgroup. -/
def diagonal : leftSubgroup F →* splitSubgroup F :=
  (diagonalCarrier F).codRestrict (splitSubgroup F) (diagonalCarrier_mem F)

@[simp] theorem diagonal_generator (s k : Bool) (t : F) :
    diagonal F (leftGenerator F s k t) = f4Simple F s (pairNode 2 3 k) t :=
  Subtype.ext (diagonalCarrier_generator F s k t)

/-- A genuine complementary action, with domain the actual first E6 chain. -/
def complementAction : leftSubgroup F →* (complementSpace F ≃ₗ[F] complementSpace F) :=
  (eigenspaceAction F (-1)).comp (diagonal F)

@[simp] theorem complementAction_generator (s k : Bool) (t : F) :
    complementAction F (leftGenerator F s k t) =
      eigenspaceAction F (-1) (f4Simple F s (pairNode 2 3 k) t) := by
  rw [complementAction, MonoidHom.comp_apply, diagonal_generator]

theorem complementAction_generator_column (s k : Bool) (t : F) (c r : Index) :
    (complementAction F (leftGenerator F s k t) (antiVector F c) : Space F) r =
      foldedMatrix F (f4Simple F s (pairNode 2 3 k) t) r c -
        foldedMatrix F (f4Simple F s (pairNode 2 3 k) t) r
          (typeE6PinnedIndexEquiv c) := by
  rw [complementAction_generator, eigenspaceAction_antiVector]

end TwistedE6.FoldedSubsystem.F4Identification.ComplementRepresentation.ShortA2
