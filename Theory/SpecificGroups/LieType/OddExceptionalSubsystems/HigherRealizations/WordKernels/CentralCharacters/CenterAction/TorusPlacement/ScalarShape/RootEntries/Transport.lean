module

public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.HigherRealizations.WordKernels.CentralCharacters.CenterAction.TorusPlacement.ResidueDiagonal
public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.HigherRealizations.WordKernels.CentralCharacters.CenterAction.TorusPlacement.ScalarShape.Operators
public import Theory.SpecificGroups.LieType.OddExceptionalSubsystems.HigherRealizations.WordKernels.CentralCharacters.CenterAction.TorusPlacement.ScalarShape.FixedRows

/-!
# Transport of diagonal E6 root entries

The integral Tits action transports root basis vectors up to a unit sign.
Consequently a diagonal matrix centralizing the six signed curves has constant
entries along each E6 reflection orbit. The coefficient one from a negative
simple operator and the established Cartan normalization fix the six simple
root entries at one in the literal E7 and E8 word representations.

A second transport argument propagates preservation of a bilinear form from
literal generators through multiplication and inversion of evaluated words.
For a diagonal word, a nonzero pairing between two coordinates then forces
their scalars to be reciprocal. The actual E7 and E8 applications retain the
form and its generator invariance as explicit construction obligations.

The residue anchors fix the negative-weight convention: the seventh simple
root has residue minus one and its opposite has residue plus one. These
lemmas feed `RootEntries`, which still requires residue constancy and an
opposite-root pairing; they do not establish those representation inputs.

Sources: GLS3 §§1.12.5–6 and 2.6.2, for the subsystem construction used in
Aschbacher–Smith A.2.17, printed p.39.
-/

@[expose] public section

noncomputable section
namespace TwistedE6.FoldedSubsystem.HigherRealizations.CentralCharacters.CenterAction.TorusPlacement.ScalarShape
open RootPairing.IntegralGeckConstruction RootPairing.SimpleGeckGroup
open Theory.AlgebraicGroup.StandardRootSystem
attribute [local instance] Classical.decEq

section Generic
variable {ι R M N F : Type*} [Field R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [P.IsCrystallographic] [P.IsReduced]
  {b : P.Base} [Fintype ι] [DecidableEq ι] [Field F]

private theorem map_eUnipotent_curve (i : b.support) (t : ℤ) :
    (eUnipotent i t).map (Int.castRingHom F) =
      (simpleFamily (b := b)).curve (true, i) (t : F) := by
  ext r c
  simp only [eUnipotent, IntegralCubicFamily.curve, IntegralCubicFamily.coefficient,
    simpleFamily, Matrix.map_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul,
    Int.coe_castRingHom, Int.cast_add, Int.cast_mul, Int.cast_pow]
  simp [Matrix.one_apply]

private theorem map_fUnipotent_curve (i : b.support) (t : ℤ) :
    (fUnipotent i t).map (Int.castRingHom F) =
      (simpleFamily (b := b)).curve (false, i) (t : F) := by
  ext r c
  simp only [fUnipotent, IntegralCubicFamily.curve, IntegralCubicFamily.coefficient,
    simpleFamily, Matrix.map_apply, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul,
    Int.coe_castRingHom, Int.cast_add, Int.cast_mul, Int.cast_pow]
  simp [Matrix.one_apply]

/-- A centralizer of both signed curves centralizes their actual Tits lift. -/
theorem commute_titsLift_of_curves (A : Matrix (b.support ⊕ ι) (b.support ⊕ ι) F)
    (i : b.support)
    (hc : ∀ s t, Commute A ((simpleFamily (b := b)).curve (s, i) t)) :
    Commute A ((titsLift i).map (Int.castRingHom F)) := by
  rw [titsLift, Matrix.map_mul, Matrix.map_mul, map_eUnipotent_curve,
    map_fUnipotent_curve]
  exact ((hc true _).mul_right (hc false _)).mul_right (hc true _)

/-- A nonzero signed reflection entry transports a commuting diagonal entry. -/
theorem diagonal_root_entry_reflection
    (A : Matrix (b.support ⊕ ι) (b.support ⊕ ι) F) (hd : A.IsDiag)
    (i : b.support) (hc : Commute A ((titsLift i).map (Int.castRingHom F))) (r : ι) :
    A (Sum.inr (P.reflectionPerm i r)) (Sum.inr (P.reflectionPerm i r)) =
      A (Sum.inr r) (Sum.inr r) := by
  apply diagonal_entries_eq_of_commute hd hc
  have h := congrFun (titsLift_mulVec_v (b := b) i r) (Sum.inr (P.reflectionPerm i r))
  simp only [v, Matrix.mulVec_single_one, Pi.smul_apply, smul_eq_mul,
    Pi.single_eq_same, mul_one, Matrix.col_apply] at h
  change ((titsLift i (Sum.inr (P.reflectionPerm i r)) (Sum.inr r) : ℤ) : F) ≠ 0
  rw [h]
  simp

/-- Root entries are constant on every orbit generated by the selected reflections. -/
theorem diagonal_root_entry_reflectionWord {κ : Type*} (j : κ → b.support)
    (A : Matrix (b.support ⊕ ι) (b.support ⊕ ι) F) (hd : A.IsDiag)
    (hc : ∀ k, Commute A ((titsLift (j k)).map (Int.castRingHom F)))
    (l : List κ) (r : ι) :
    A (Sum.inr (reflectionWord (l.map j) r)) (Sum.inr (reflectionWord (l.map j) r)) =
      A (Sum.inr r) (Sum.inr r) := by
  induction l with
  | nil => rfl
  | cons k l ih =>
    exact (diagonal_root_entry_reflection A hd (j k) (hc k) _).trans ih

/-- The coefficient one from the negative simple root ties its root entry to Cartan. -/
theorem diagonal_simple_root_eq_cartan
    (A : Matrix (b.support ⊕ ι) (b.support ⊕ ι) F) (hd : A.IsDiag)
    (i : b.support)
    (hc : Commute A ((simpleFamily (b := b)).coefficient (false, i) 1)) :
    A (Sum.inr i) (Sum.inr i) = A (Sum.inl i) (Sum.inl i) := by
  symm
  apply diagonal_entries_eq_of_commute hd hc
  simp [IntegralCubicFamily.coefficient, simpleFamily, fDividedPower_one, fMatrix]
end Generic

local instance : Fintype typeE7Roots := Fintype.ofFinite _
local instance : Fintype typeE8Roots := Fintype.ofFinite _
variable (F : Type*) [Field F]

/-- The central word commutes with each of its twelve literal generating curves. -/
theorem e7Six_commute_simple_curve (w : SixNodeWord F)
    (hc : ∀ z, Commute (e7Six F w) (e7Six F z)) (s : Bool) (i : Fin 6) (t : F) :
    Commute (e7Six F w).val.val
      ((simpleFamily (b := typeE7RootPairing_base)).curve (s, e7Node i) t) := by
  have h := ((hc (FreeGroup.of (s, i, t))).map (Subgroup.subtype _)).map (Units.coeHom _)
  simpa [e7Six_of, e7Simple, e7Node, signedSimple_val] using h

/-- The E8 analogue uses the same six letters and the ambient E8 matrices. -/
theorem e8Six_commute_simple_curve (w : SixNodeWord F)
    (hc : ∀ z, Commute (e8Six F w) (e8Six F z)) (s : Bool) (i : Fin 6) (t : F) :
    Commute (e8Six F w).val.val
      ((simpleFamily (b := typeE8RootPairing_base)).curve (s, e8Node i) t) := by
  have h := ((hc (FreeGroup.of (s, i, t))).map (Subgroup.subtype _)).map (Units.coeHom _)
  simpa [e8Six_of, e8Simple, e8Node, signedSimple_val] using h

/-- All root entries in one E6 reflection orbit agree in the E7 realization. -/
theorem e7Six_diagonal_root_reflectionWord (w : SixNodeWord F)
    (hc : ∀ z, Commute (e7Six F w) (e7Six F z)) (hd : (e7Six F w).val.val.IsDiag)
    (l : List (Fin 6)) (r : typeE7Roots) :
    (e7Six F w).val.val
        (Sum.inr (reflectionWord (l.map e7Node) r))
        (Sum.inr (reflectionWord (l.map e7Node) r)) =
      (e7Six F w).val.val (Sum.inr r) (Sum.inr r) := by
  apply diagonal_root_entry_reflectionWord e7Node _ hd _ l r
  intro i
  exact commute_titsLift_of_curves _ (e7Node i) (fun s t => e7Six_commute_simple_curve F w hc s i t)

/-- All root entries in one E6 reflection orbit agree in the E8 realization. -/
theorem e8Six_diagonal_root_reflectionWord (w : SixNodeWord F)
    (hc : ∀ z, Commute (e8Six F w) (e8Six F z)) (hd : (e8Six F w).val.val.IsDiag)
    (l : List (Fin 6)) (r : typeE8Roots) :
    (e8Six F w).val.val
        (Sum.inr (reflectionWord (l.map e8Node) r))
        (Sum.inr (reflectionWord (l.map e8Node) r)) =
      (e8Six F w).val.val (Sum.inr r) (Sum.inr r) := by
  apply diagonal_root_entry_reflectionWord e8Node _ hd _ l r
  intro i
  exact commute_titsLift_of_curves _ (e8Node i) (fun s t => e8Six_commute_simple_curve F w hc s i t)

/-- The six positive subsystem root entries are one. -/
theorem e7Six_diagonal_simple_root_eq_one (hodd : Odd (ringChar F)) (w : SixNodeWord F)
    (hc : ∀ z, Commute (e7Six F w) (e7Six F z)) (hd : (e7Six F w).val.val.IsDiag)
    (i : Fin 6) : (e7Six F w).val.val (Sum.inr (e7Node i)) (Sum.inr (e7Node i)) = 1 := by
  rw [diagonal_simple_root_eq_cartan _ hd (e7Node i)
    ((e7Six_central_iff_operators F hodd w).mp hc false i)]
  exact e7Six_diagonal_cartan_eq_one F hodd w hc hd _

/-- The six positive subsystem root entries are one in E8 as well. -/
theorem e8Six_diagonal_simple_root_eq_one (hodd : Odd (ringChar F)) (w : SixNodeWord F)
    (hc : ∀ z, Commute (e8Six F w) (e8Six F z)) (hd : (e8Six F w).val.val.IsDiag)
    (i : Fin 6) : (e8Six F w).val.val (Sum.inr (e8Node i)) (Sum.inr (e8Node i)) = 1 := by
  rw [diagonal_simple_root_eq_cartan _ hd (e8Node i)
    ((e8Six_central_iff_operators F hodd w).mp hc false i)]
  exact e8Six_diagonal_cartan_eq_one F hodd w hc hd _


section MatrixForms
variable {n α F : Type*} [Fintype n] [DecidableEq n] [Field F]

private theorem inverse_preserves_form (A : (Matrix n n F)ˣ) (B : Matrix n n F)
    (h : A.val.transpose * B * A.val = B) :
    (A⁻¹).val.transpose * B * (A⁻¹).val = B := by
  calc
    _ = (A⁻¹).val.transpose * (A.val.transpose * B * A.val) * (A⁻¹).val := by rw [h]
    _ = (A.val * (A⁻¹).val).transpose * B * (A.val * (A⁻¹).val) := by
      rw [Matrix.transpose_mul]
      noncomm_ring
    _ = B := by simp

omit [DecidableEq n] in
private theorem product_preserves_form (A C B : Matrix n n F)
    (hA : A.transpose * B * A = B) (hC : C.transpose * B * C = B) :
    (A * C).transpose * B * (A * C) = B := by
  calc
    _ = C.transpose * (A.transpose * B * A) * C := by
      rw [Matrix.transpose_mul]
      noncomm_ring
    _ = B := by rw [hA, hC]

/-- Generator invariance propagates to the literal matrix value of every free word. -/
theorem eval_preserves_form (v : FreeGroup α →* (Matrix n n F)ˣ) (B : Matrix n n F)
    (h : ∀ x, (v (FreeGroup.of x)).val.transpose * B * (v (FreeGroup.of x)).val = B)
    (w : FreeGroup α) : (v w).val.transpose * B * (v w).val = B := by
  induction w using FreeGroup.induction_on with
  | C1 => simp
  | of x => exact h x
  | inv_of x hx => simpa only [map_inv] using inverse_preserves_form (v (FreeGroup.of x)) B hx
  | mul x y hx hy => simpa only [map_mul, Units.val_mul] using product_preserves_form _ _ B hx hy

/-- A preserved nonzero pairing between two diagonal coordinates forces reciprocal scalars. -/
theorem diagonal_pair_eq_one_of_preserves_form (A B : Matrix n n F)
    (hd : A.IsDiag) (h : A.transpose * B * A = B) (r c : n) (hB : B r c ≠ 0) :
    A r r * A c c = 1 := by
  have hh := congrArg (fun X : Matrix n n F => X r c) h
  rw [← hd.diagonal_diag] at hh
  simp only [Matrix.diagonal_transpose, Matrix.diagonal_mul, Matrix.mul_diagonal,
    Matrix.diag_apply] at hh
  apply mul_right_cancel₀ hB
  calc
    (A r r * A c c) * B r c = A r r * B r c * A c c := by ring
    _ = 1 * B r c := by simpa using hh
end MatrixForms

/-- A constructed generator-invariant form supplies the exact opposite-pair premise in E7. -/
theorem e7Six_diagonal_extra_pair_of_form (F : Type*) [Field F]
    (w : SixNodeWord F) (hd : (e7Six F w).val.val.IsDiag)
    (B : Matrix (typeE7RootPairing_base.support ⊕ typeE7Roots)
      (typeE7RootPairing_base.support ⊕ typeE7Roots) F)
    (hB : let r : typeE7Roots := typeE7RootPairing_baseEquiv 6
      B (Sum.inr (typeE7RootPairing.reflectionPerm r r)) (Sum.inr r) ≠ 0)
    (hgen : ∀ s i t, let A :=
      (simpleFamily (b := typeE7RootPairing_base)).curve (s, e7Node i) t
      A.transpose * B * A = B) :
    let r : typeE7Roots := typeE7RootPairing_baseEquiv 6
    (e7Six F w).val.val
        (Sum.inr (typeE7RootPairing.reflectionPerm r r))
        (Sum.inr (typeE7RootPairing.reflectionPerm r r)) *
      (e7Six F w).val.val (Sum.inr r) (Sum.inr r) = 1 := by
  apply diagonal_pair_eq_one_of_preserves_form _ B hd _ _ _ hB
  apply eval_preserves_form ((ExceptionalSplit.rootGenerated _ _ F).subtype.comp (e7Six F)) B
  rintro ⟨s, i, t⟩
  simpa [e7Six_of, e7Simple, e7Node, signedSimple_val] using hgen s i t

/-- The analogous constructed form supplies the E8 opposite-pair premise. -/
theorem e8Six_diagonal_extra_pair_of_form (F : Type*) [Field F]
    (w : SixNodeWord F) (hd : (e8Six F w).val.val.IsDiag)
    (B : Matrix (typeE8RootPairing_base.support ⊕ typeE8Roots)
      (typeE8RootPairing_base.support ⊕ typeE8Roots) F)
    (hB : let r : typeE8Roots := typeE8RootPairing_baseEquiv 6
      B (Sum.inr (typeE8RootPairing.reflectionPerm r r)) (Sum.inr r) ≠ 0)
    (hgen : ∀ s i t, let A :=
      (simpleFamily (b := typeE8RootPairing_base)).curve (s, e8Node i) t
      A.transpose * B * A = B) :
    let r : typeE8Roots := typeE8RootPairing_baseEquiv 6
    (e8Six F w).val.val
        (Sum.inr (typeE8RootPairing.reflectionPerm r r))
        (Sum.inr (typeE8RootPairing.reflectionPerm r r)) *
      (e8Six F w).val.val (Sum.inr r) (Sum.inr r) = 1 := by
  apply diagonal_pair_eq_one_of_preserves_form _ B hd _ _ _ hB
  apply eval_preserves_form ((ExceptionalSplit.rootGenerated _ _ F).subtype.comp (e8Six F)) B
  rintro ⟨s, i, t⟩
  simpa [e8Six_of, e8Simple, e8Node, signedSimple_val] using hgen s i t


section Residues
variable {ι R M N : Type*} [Field R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [P.IsCrystallographic] [P.IsReduced]
  {b : P.Base} [Fintype ι] [DecidableEq ι]

omit [P.IsReduced] [Fintype ι] [DecidableEq ι] in
/-- The opposite root has the opposite balanced central residue. -/
theorem centralResidue_opposite (j : Fin 6 → b.support) (r : ι) :
    balancedResidue (centralExponent j (Sum.inr (P.reflectionPerm r r))) =
      -balancedResidue (centralExponent j (Sum.inr r)) := by
  let := P.indexNeg
  have hneg (q : ι) : P.pairingIn ℤ (-r) q = -P.pairingIn ℤ r q := by
    apply FaithfulSMul.algebraMap_injective ℤ R
    rw [map_neg, P.algebraMap_pairingIn]
    simp only [← P.root_coroot_eq_pairing, P.indexNeg_neg,
      P.root_reflectionPerm, P.reflection_apply_self, LinearMap.neg_apply, map_neg]
    rw [P.algebraMap_pairingIn, P.root_coroot_eq_pairing]
  have hn : centralExponent j (Sum.inr (-r)) = -centralExponent j (Sum.inr r) := by
    simp only [centralExponent, chevalleyBasisWeight, hneg]
    ring
  change balancedResidue (centralExponent j (Sum.inr (-r))) = _
  rw [hn]
  unfold balancedResidue
  omega
end Residues

/-- Three residue classes, one fixed entry and an opposite pair give a common unit. -/
theorem exists_unit_of_residue_constancy {ι F : Type*} [Field F]
    (a : ι → F) (c : ι → ℤ) (rzero rminus rplus : ι)
    (hrange : ∀ r, c r = -1 ∨ c r = 0 ∨ c r = 1)
    (hz : c rzero = 0) (hm : c rminus = -1) (hp : c rplus = 1)
    (hzero : a rzero = 1) (hpair : a rplus * a rminus = 1)
    (hconstant : ∀ r t, c r = c t → a r = a t) :
    ∃ u : Fˣ, ∀ r, a r = ((u ^ c r : Fˣ) : F) := by
  let u : Fˣ := ⟨a rplus, a rminus, hpair, (mul_comm _ _).trans hpair⟩
  refine ⟨u, fun r => ?_⟩
  rcases hrange r with h | h | h
  · rw [h, zpow_neg_one]
    exact hconstant r rminus (h.trans hm.symm)
  · rw [h, zpow_zero, Units.val_one]
    exact (hconstant r rzero (h.trans hz.symm)).trans hzero
  · rw [h, zpow_one]
    exact hconstant r rplus (h.trans hp.symm)

/-- The first selected simple root anchors residue zero in E7. -/
theorem e7_centralResidue_first :
    balancedResidue (centralExponent e7Node (Sum.inr (e7Node 0))) = 0 := by
  have h (k : Fin 6) : typeE7RootPairing.pairingIn ℤ (e7Node 0) (e7Node k) =
      typeE6CartanMatrix 0 k :=
    (typeE7RootPairing_base_cartan_apply _ _).trans (e7_cartan_restrict 0 k)
  simp only [centralExponent, chevalleyBasisWeight, h]
  norm_num [typeE6CartanMatrix, balancedResidue, Fin.ext_iff]

/-- The first selected simple root anchors residue zero in E8. -/
theorem e8_centralResidue_first :
    balancedResidue (centralExponent e8Node (Sum.inr (e8Node 0))) = 0 := by
  have h (k : Fin 6) : typeE8RootPairing.pairingIn ℤ (e8Node 0) (e8Node k) =
      typeE6CartanMatrix 0 k :=
    (typeE8RootPairing_base_cartan_apply _ _).trans (e8_cartan_restrict 0 k)
  simp only [centralExponent, chevalleyBasisWeight, h]
  norm_num [typeE6CartanMatrix, balancedResidue, Fin.ext_iff]

/-- The extra simple root has residue minus one, fixing the parameter convention. -/
theorem e7_centralResidue_extra :
    balancedResidue (centralExponent e7Node
      (Sum.inr (typeE7RootPairing_baseEquiv 6))) = -1 := by
  have h (k : Fin 6) : typeE7RootPairing.pairingIn ℤ
      (typeE7RootPairing_baseEquiv 6) (e7Node k) =
      typeE7CartanMatrix 6 (k.castLE (by decide)) :=
    typeE7RootPairing_base_cartan_apply 6 (k.castLE (by decide))
  simp only [centralExponent, chevalleyBasisWeight, h]
  norm_num [typeE7CartanMatrix, balancedResidue, Fin.ext_iff]

/-- E8 uses the identical extra-root convention. -/
theorem e8_centralResidue_extra :
    balancedResidue (centralExponent e8Node
      (Sum.inr (typeE8RootPairing_baseEquiv 6))) = -1 := by
  have h (k : Fin 6) : typeE8RootPairing.pairingIn ℤ
      (typeE8RootPairing_baseEquiv 6) (e8Node k) =
      typeE8CartanMatrix 6 (k.castLE (by decide)) :=
    typeE8RootPairing_base_cartan_apply 6 (k.castLE (by decide))
  simp only [centralExponent, chevalleyBasisWeight, h]
  norm_num [typeE8CartanMatrix, balancedResidue, Fin.ext_iff]

end TwistedE6.FoldedSubsystem.HigherRealizations.CentralCharacters.CenterAction.TorusPlacement.ScalarShape
