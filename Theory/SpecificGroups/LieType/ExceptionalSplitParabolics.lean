module

public import Theory.SpecificGroups.LieType.TheoremDRootNormalizer.CorootTorus

/-!
# Root-defined maximal parabolics for the split exceptional carriers

Fix a simple root j. The candidate maximal parabolic contains every positive
root group, the actual coroot torus, and the negative simple root groups at
nodes other than j. Its candidate radical is generated by the positive roots
whose j-coordinate is nonzero. All groups are subgroups of the literal central
quotient in `ExceptionalSplitModels`, using its root elements and projection.

These definitions do not assert Sylow maximality, overgroup placement,
relative normality, or centralizer bounds. Those are separate geometric
obligations. Sources: GLS III, Definition 2.6.4 and Theorems 2.6.5–2.6.7;
Aschbacher–Smith B.1.13, printed p.74.
-/

@[expose] public section

noncomputable section
namespace ExceptionalSplit.Parabolics

open Subgroup TheoremDRootNormalizer

variable {ι R M N : Type*} [Field R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) [Fintype ι] [DecidableEq ι]
  (F : Type*) [Field F] [Finite F] [CharP F 2]

/-- The subgroup generated by the indicated literal quotient root elements. -/
def rootGroups (A : Set ι) : Subgroup (Model P b F) :=
  closure {g | ∃ r ∈ A, ∃ t : F, g = rootElement P b F r t}

omit [Finite F] [CharP F 2] in
theorem rootGroups_mono {A B : Set ι} (h : A ⊆ B) :
    rootGroups P b F A ≤ rootGroups P b F B := by
  apply Subgroup.closure_mono
  rintro g ⟨r, hr, t, rfl⟩
  exact ⟨r, h hr, t, rfl⟩

/-- The positive-root subgroup in the actual central quotient. -/
def positive : Subgroup (Model P b F) := rootGroups P b F {r | b.IsPos r}

/-- The coroot torus, mapped through the model's specified central projection. -/
def torus : Subgroup (Model P b F) :=
  ((projection P b F).comp (elementaryTorus (P := P) (b := b) (F := F))).range

/-- The negative simple root factors with the marked node omitted. -/
def negativeSimple (j : b.support) : Subgroup (Model P b F) :=
  let _ := P.indexNeg
  rootGroups P b F {r | ∃ i : b.support, i ≠ j ∧ r = -(i : ι)}

/-- The maximal standard parabolic candidate with omitted simple node j. -/
def maximal (j : b.support) : Subgroup (Model P b F) :=
  (positive P b F ⊔ torus P b F) ⊔ negativeSimple P b F j

theorem positive_le_maximal (j : b.support) : positive P b F ≤ maximal P b F j :=
  le_sup_left.trans le_sup_left

theorem torus_le_maximal (j : b.support) : torus P b F ≤ maximal P b F j :=
  le_sup_right.trans le_sup_left

variable [P.IsRootSystem]

/-- The positive roots outside the Levi subsystem generate the radical candidate. -/
def radical (j : b.support) : Subgroup (Model P b F) :=
  rootGroups P b F {r | b.IsPos r ∧ b.toWeightBasis.repr (P.root r) j ≠ 0}

omit [Finite F] [CharP F 2] in
theorem radical_le_positive (j : b.support) : radical P b F j ≤ positive P b F :=
  rootGroups_mono P b F (fun _ h => h.1)

theorem radical_le_maximal (j : b.support) : radical P b F j ≤ maximal P b F j :=
  (radical_le_positive P b F j).trans (positive_le_maximal P b F j)

end ExceptionalSplit.Parabolics
