module

public import Theory.AlgebraicGroup.RootSystems.TypeE6PinnedDiagram
public import Theory.AlgebraicGroup.RootSystems.IntegralRootCurveSimpleGeneration

/-!
# The split E6 carrier and its pinned diagram involution

The carrier is the subgroup of matrix units generated by every canonical
integral E6 root curve. Equality with the simple-root generated subgroup
allows the explicit index permutation to restrict to it. On all roots the
formulas transport the actual chosen Tits word and its signed simple
operator; they make no assertion that two arbitrary routes have equal signs.

This is the split carrier for GLS3 §§2.1–2.3. Taking graph–field fixed points,
the characteristic-prime residual and the central quotient are later steps.
-/

namespace TwistedE6

open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction

@[expose] public section
noncomputable section

abbrev Index := typeE6PinnedIndex
abbrev Pairing := typeE6RootPairing
abbrev Base := typeE6RootPairing_base
abbrev Operators := IntegralChevalleyRootOperators Pairing Base

def operators : Operators := integralChevalleyRootOperators (P := Pairing) (b := Base)

variable (F : Type*) [CommRing F]

abbrev Ambient := (Matrix Index Index F)ˣ

/-- The subgroup generated by every canonical root-curve value. -/
def splitCarrier : Subgroup (Ambient F) :=
  Subgroup.closure (Set.range fun p : typeE6Roots × F =>
    rootCurveUnit (S := F) operators p.1 p.2)

@[simp] theorem rootCurveUnit_mem_splitCarrier (r : typeE6Roots) (t : F) :
    rootCurveUnit (S := F) operators r t ∈ splitCarrier F :=
  Subgroup.subset_closure ⟨(r, t), rfl⟩

theorem splitCarrier_eq_closure_range :
    splitCarrier F = Subgroup.closure (Set.range fun p : typeE6Roots × F =>
      rootCurveUnit (S := F) operators p.1 p.2) := rfl

theorem splitCarrier_eq_simple :
    splitCarrier F = RootPairing.SimpleGeckGroup.subgroup Base F :=
  allRootCurveSubgroup_eq_simpleSubgroup

instance splitCarrier_group : Group (splitCarrier F) := inferInstance
instance splitCarrier_finite [Finite F] : Finite (splitCarrier F) := inferInstance
noncomputable instance splitCarrier_fintype [Fintype F] : Fintype (splitCarrier F) :=
  Fintype.ofFinite _

/-- The ambient diagram action, with its literal row and column permutation. -/
def pinnedAmbientAction : Ambient F →* Ambient F := (typeE6PinnedUnitsEquiv F).toMonoidHom

@[simp] theorem pinnedAmbientAction_apply (g : Ambient F) (i j : Index) :
    ((pinnedAmbientAction F g : Ambient F) : Matrix Index Index F) i j =
      (g : Matrix Index Index F)
        (typeE6PinnedIndexEquiv.symm i) (typeE6PinnedIndexEquiv.symm j) := rfl

@[simp] theorem pinnedAmbientAction_twice (g : Ambient F) :
    pinnedAmbientAction F (pinnedAmbientAction F g) = g := typeE6PinnedUnitsEquiv_twice F g

theorem pinnedAmbientAction_mem {g : Ambient F} (hg : g ∈ splitCarrier F) :
    pinnedAmbientAction F g ∈ splitCarrier F := by
  rw [splitCarrier_eq_simple] at hg ⊢
  have h : RootPairing.SimpleGeckGroup.subgroup Base F ≤
      (RootPairing.SimpleGeckGroup.subgroup Base F).comap (pinnedAmbientAction F) := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨s, i⟩, t, rfl⟩
    cases s
    · change typeE6PinnedUnitsEquiv F (RootPairing.SimpleGeckGroup.negativeUnit i t) ∈
        RootPairing.SimpleGeckGroup.subgroup Base F
      rw [typeE6Pinned_negativeUnit]
      exact RootPairing.SimpleGeckGroup.negativeUnit_mem _ _
    · change typeE6PinnedUnitsEquiv F (RootPairing.SimpleGeckGroup.positiveUnit i t) ∈
        RootPairing.SimpleGeckGroup.subgroup Base F
      rw [typeE6Pinned_positiveUnit]
      exact RootPairing.SimpleGeckGroup.positiveUnit_mem _ _
  exact h hg

/-- The actual pinned diagram involution on the all-root generated split carrier. -/
def pinnedDiagram : splitCarrier F ≃* splitCarrier F where
  toFun g := ⟨pinnedAmbientAction F g, pinnedAmbientAction_mem F g.property⟩
  invFun g := ⟨pinnedAmbientAction F g, pinnedAmbientAction_mem F g.property⟩
  left_inv g := Subtype.ext (pinnedAmbientAction_twice F g)
  right_inv g := Subtype.ext (pinnedAmbientAction_twice F g)
  map_mul' g h := Subtype.ext ((pinnedAmbientAction F).map_mul g h)

@[simp] theorem pinnedDiagram_val (g : splitCarrier F) :
    (pinnedDiagram F g).val = typeE6PinnedUnitsEquiv F g.val := rfl

@[simp] theorem pinnedDiagram_twice (g : splitCarrier F) :
    pinnedDiagram F (pinnedDiagram F g) = g :=
  Subtype.ext (pinnedAmbientAction_twice F g)

/-- Entrywise formula used to commute the diagram action with field Frobenius. -/
theorem pinnedDiagram_entry (g : splitCarrier F) (i j : Index) :
    ((pinnedDiagram F g).val : Matrix Index Index F) i j =
      (g.val : Matrix Index Index F) (typeE6PinnedIndexEquiv i) (typeE6PinnedIndexEquiv j) :=
  typeE6PinnedUnitsEquiv_apply F g.val i j

/-- A canonical root curve as an element of the split carrier. -/
def rootElement (r : typeE6Roots) (t : F) : splitCarrier F :=
  ⟨rootCurveUnit operators r t, rootCurveUnit_mem_splitCarrier F r t⟩

@[simp] theorem pinnedDiagram_positive (i : Base.support) (t : F) :
    pinnedDiagram F (rootElement F i t) =
      rootElement F (typeE6DiagramBasePermutation i) t := by
  apply Subtype.ext
  change typeE6PinnedUnitsEquiv F (rootCurveUnit _ i t) = rootCurveUnit _ _ t
  change typeE6PinnedUnitsEquiv F
    (rootCurveUnit (integralChevalleyRootOperators (P := Pairing) (b := Base)) i t) =
    rootCurveUnit (integralChevalleyRootOperators (P := Pairing) (b := Base)) _ t
  rw [rootCurveUnit_simple, rootCurveUnit_simple, typeE6Pinned_positiveUnit]

@[simp] theorem pinnedDiagram_negative (i : Base.support) (t : F) :
    let := Pairing.indexNeg
    pinnedDiagram F (rootElement F (-i : typeE6Roots) t) =
      rootElement F (-(typeE6DiagramBasePermutation i) : typeE6Roots) t := by
  let := Pairing.indexNeg
  apply Subtype.ext
  change typeE6PinnedUnitsEquiv F
    (rootCurveUnit (integralChevalleyRootOperators (P := Pairing) (b := Base)) (-i : typeE6Roots) t) =
    rootCurveUnit (integralChevalleyRootOperators (P := Pairing) (b := Base)) _ t
  rw [rootCurveUnit_neg_simple, rootCurveUnit_neg_simple, typeE6Pinned_negativeUnit]

private theorem diagram_pairing (i j : typeE6Roots) :
    typeE6RootPairing.pairing (typeE6DiagramEquiv.indexEquiv i)
      (typeE6DiagramEquiv.indexEquiv j) = typeE6RootPairing.pairing i j := by
  have ht := congrArg (fun f : typeE6RootSpan →ₗ[ℝ] ℝ => f (typeE6RootPairing.root i))
    (RootPairing.Hom.weight_coweight_transpose_apply typeE6RootPairing typeE6RootPairing
      (typeE6RootPairing.coroot (typeE6DiagramEquiv.indexEquiv j)) typeE6DiagramEquiv.toHom)
  change typeE6RootPairing.toLinearMap (typeE6DiagramEquiv.weightMap (typeE6RootPairing.root i))
    (typeE6RootPairing.coroot (typeE6DiagramEquiv.indexEquiv j)) =
    typeE6RootPairing.toLinearMap (typeE6RootPairing.root i)
      (typeE6DiagramEquiv.coweightMap (typeE6RootPairing.coroot (typeE6DiagramEquiv.indexEquiv j))) at ht
  rw [typeE6Diagram_weight_root,
    RootPairing.Hom.coroot_coweightMap_apply, Equiv.symm_apply_apply] at ht
  exact ht

private theorem diagram_reflection (i j : typeE6Roots) :
    typeE6DiagramEquiv.indexEquiv (typeE6RootPairing.reflectionPerm i j) =
      typeE6RootPairing.reflectionPerm (typeE6DiagramEquiv.indexEquiv i)
        (typeE6DiagramEquiv.indexEquiv j) := by
  apply typeE6RootPairing.root.injective
  rw [← typeE6Diagram_weight_root]
  simp only [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_root,
    map_sub, map_smul, typeE6Diagram_weight_root, diagram_pairing]

theorem pinnedDiagram_reflectionWord (word : List typeE6RootPairing_base.support)
    (r : typeE6Roots) :
    reflectionWord (P := typeE6RootPairing) (word.map typeE6DiagramBasePermutation)
      (typeE6DiagramEquiv.indexEquiv r) =
    typeE6DiagramEquiv.indexEquiv (reflectionWord (P := typeE6RootPairing) word r) := by
  induction word with
  | nil => rfl
  | cons i word ih =>
    simp only [List.map_cons, reflectionWord, ih, diagram_reflection,
      typeE6DiagramEquiv_simple]

/-- The transported chosen word ends at the actual diagram image of the root. -/
theorem pinnedDiagram_route_target (r : typeE6Roots) :
    reflectionWord (P := typeE6RootPairing)
      ((rootRoute (P := typeE6RootPairing) (b := typeE6RootPairing_base) r).word.map
        typeE6DiagramBasePermutation)
      (typeE6DiagramBasePermutation
        (rootRoute (P := typeE6RootPairing) (b := typeE6RootPairing_base) r).simple) =
      typeE6DiagramEquiv.indexEquiv r := by
  rw [← typeE6DiagramEquiv_simple, pinnedDiagram_reflectionWord,
    (rootRoute (P := typeE6RootPairing) (b := typeE6RootPairing_base) r).target]

/-- The route from the negative simple source ends at the diagram image as well. -/
theorem pinnedDiagram_negative_route_target (r : typeE6Roots) :
    let := typeE6RootPairing.indexNeg
    reflectionWord (P := typeE6RootPairing)
      ((rootRoute (P := typeE6RootPairing) (b := typeE6RootPairing_base) (-r)).word.map
        typeE6DiagramBasePermutation)
      (-(typeE6DiagramBasePermutation
        (rootRoute (P := typeE6RootPairing) (b := typeE6RootPairing_base) (-r)).simple) :
          typeE6Roots) = typeE6DiagramEquiv.indexEquiv r := by
  let := typeE6RootPairing.indexNeg
  dsimp only
  rw [reflectionWord_neg, pinnedDiagram_route_target, typeE6Diagram_neg, neg_neg]

/-- Every Tits word is transported letter by letter, with its actual operator signs. -/
theorem pinnedDiagram_titsWord (word : List Base.support) :
    typeE6PinnedUnitsEquiv F (rootCurveTitsWord (P := Pairing) word) =
      rootCurveTitsWord (P := Pairing) (word.map typeE6DiagramBasePermutation) := by
  induction word with
  | nil => simp
  | cons i word ih =>
    simp only [rootCurveTitsWord_cons, List.map_cons, map_mul,
      typeE6Pinned_positiveUnit, typeE6Pinned_negativeUnit, ih]

/-- Exact transported-route formula for any positive canonical root curve. -/
theorem pinnedDiagram_rootCurve_of_pos (r : typeE6Roots) (hr : Base.IsPos r) (t : F) :
    typeE6PinnedUnitsEquiv F (rootCurveUnit operators r t) =
      rootCurveTitsWord (P := Pairing)
        ((rootRoute (P := Pairing) (b := Base) r).word.map typeE6DiagramBasePermutation) *
      RootPairing.SimpleGeckGroup.positiveUnit
        (typeE6DiagramBasePermutation (rootRoute (P := Pairing) (b := Base) r).simple) t *
      (rootCurveTitsWord (P := Pairing)
        ((rootRoute (P := Pairing) (b := Base) r).word.map typeE6DiagramBasePermutation))⁻¹ := by
  unfold operators
  rw [rootCurveUnit_of_pos r hr]
  simp only [map_mul, map_inv, pinnedDiagram_titsWord, typeE6Pinned_positiveUnit]

/-- Exact negative-root formula, retaining the negative simple source operator. -/
theorem pinnedDiagram_rootCurve_of_neg (r : typeE6Roots) (hr : ¬ Base.IsPos r) (t : F) :
    let := Pairing.indexNeg
    typeE6PinnedUnitsEquiv F (rootCurveUnit operators r t) =
      rootCurveTitsWord (P := Pairing)
        ((rootRoute (P := Pairing) (b := Base) (-r)).word.map typeE6DiagramBasePermutation) *
      RootPairing.SimpleGeckGroup.negativeUnit
        (typeE6DiagramBasePermutation (rootRoute (P := Pairing) (b := Base) (-r)).simple) t *
      (rootCurveTitsWord (P := Pairing)
        ((rootRoute (P := Pairing) (b := Base) (-r)).word.map typeE6DiagramBasePermutation))⁻¹ := by
  let := Pairing.indexNeg
  unfold operators
  rw [rootCurveUnit_of_neg r hr]
  simp only [map_mul, map_inv, pinnedDiagram_titsWord, typeE6Pinned_negativeUnit]

/-- The first simple-root element witnesses that the involution is nonidentity. -/
theorem pinnedDiagram_moves_positive_zero [Nontrivial F] :
    pinnedDiagram F (rootElement F (typeE6RootPairing_baseEquiv 0) 1) ≠
      rootElement F (typeE6RootPairing_baseEquiv 0) 1 := by
  intro h
  have hu := congrArg Subtype.val h
  change typeE6PinnedUnitsEquiv F
    (rootCurveUnit (integralChevalleyRootOperators (P := Pairing) (b := Base))
      (typeE6RootPairing_baseEquiv 0) 1) =
    rootCurveUnit (integralChevalleyRootOperators (P := Pairing) (b := Base))
      (typeE6RootPairing_baseEquiv 0) 1 at hu
  rw [rootCurveUnit_simple] at hu
  exact typeE6Pinned_moves_positive_zero hu

theorem pinnedDiagram_ne_one [Nontrivial F] : pinnedDiagram F ≠ 1 := by
  intro h
  apply pinnedDiagram_moves_positive_zero F
  rw [h]
  rfl

end
end
end TwistedE6
