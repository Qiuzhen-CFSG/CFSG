module

public import Theory.SpecificGroups.LieType.TheoremDRootNormalizer.TwistedE6.Coordinates
import Mathlib.Tactic

/-!
# Folded coroot words in the genuine twisted E6 subgroup

For each of the four diagram orbits, the word
`x(t) y(-t⁻¹) x(t)` is formed from the actual folded root curves in the
subgroup generated by two-elements. Orthogonality separates the two
ordinary rank-one words for each paired orbit {0,5} and {1,4}. Multiplying
by the word at -1 then gives the corresponding coroot diagonal; its
parameter is inverted to match the integral Geck matrix convention.

The product of the four orbit words realizes all published folded torus
coordinates in the defining-characteristic subgroup. Injectivity of the
ambient inclusion proves the homomorphism laws from the diagonal formula.
Thus this construction supplies the torus-lifting input to the twisted E6
root-normalizer obstruction, without a membership or model-comparison premise.

Source: GLS3 §§2.2–2.4, especially Table 2.4.7 and the characteristic-prime
subgroup convention in §2.2 (`refs/KGroup/GLS3/chapter2.tex`). The fixed-field
parameters specialize the paired formula `hα(t) hβ(t^q)` to `t^q = t`.
The intended application is the torus obstruction in Aschbacher–Smith
A.2.18, printed p.40 (`refs/quasithin.pdf`).
-/

public section

open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
open ExceptionalSplit.TheoremDRootNormalizer
namespace TwistedE6.TheoremDRootNormalizer
noncomputable section
attribute [local instance] Classical.decEq

private def splitN (m : ℕ) (i : Fin 6) (t : CoefficientField 2 m) :
    rootGeneratedSubgroup 2 m :=
  splitSimple m true i t * splitSimple m false i (-t⁻¹) * splitSimple m true i t

private theorem splitN_val (m : ℕ) (i : Fin 6) (t : CoefficientField 2 m) :
    (splitN m i t).val = matrixN (b := Base) (simpleIndex i) t := by
  let := Pairing.indexNeg
  simp only [splitN, Subgroup.coe_mul, splitSimple_val, matrixN,
    rootCurveUnit_simple, rootCurveUnit_neg_simple]
  rfl

private theorem split_cross_commute (m : ℕ) (i j : Fin 6)
    (hij : i ≠ j) (hc : typeE6CartanMatrix j i = 0)
    (s r : Bool) (t u : CoefficientField 2 m) :
    Commute (splitSimple m s i t) (splitSimple m r j u) := by
  cases s <;> cases r
  · exact splitSimple_commute m false i j hij hc t u
  · exact (splitSimple_opposite_commute m j i hij.symm u t).symm
  · exact splitSimple_opposite_commute m i j hij t u
  · exact splitSimple_commute m true i j hij hc t u

private theorem splitN_commute (m : ℕ) (i j : Fin 6)
    (hij : i ≠ j) (hc : typeE6CartanMatrix j i = 0)
    (t u : CoefficientField 2 m) : Commute (splitN m i t) (splitN m j u) := by
  unfold splitN
  apply Commute.mul_left
  · apply Commute.mul_left
    · exact ((split_cross_commute m i j hij hc true true _ _).mul_right
        (split_cross_commute m i j hij hc true false _ _)).mul_right
        (split_cross_commute m i j hij hc true true _ _)
    · exact ((split_cross_commute m i j hij hc false true _ _).mul_right
        (split_cross_commute m i j hij hc false false _ _)).mul_right
        (split_cross_commute m i j hij hc false true _ _)
  · exact ((split_cross_commute m i j hij hc true true _ _).mul_right
      (split_cross_commute m i j hij hc true false _ _)).mul_right
      (split_cross_commute m i j hij hc true true _ _)

private theorem splitN_pair (m : ℕ) (i j : Fin 6)
    (hij : i ≠ j) (hc : typeE6CartanMatrix j i = 0)
    (t : CoefficientField 2 m) :
    (splitSimple m true i t * splitSimple m true j t) *
        (splitSimple m false i (-t⁻¹) * splitSimple m false j (-t⁻¹)) *
        (splitSimple m true i t * splitSimple m true j t) =
      splitN m i t * splitN m j t := by
  rw [((split_cross_commute m i j hij hc false true _ _).symm).mul_mul_mul_comm]
  rw [(((split_cross_commute m i j hij hc true true _ _).symm).mul_left
    (split_cross_commute m i j hij hc true false _ _).symm).mul_mul_mul_comm]
  simp only [splitN, mul_assoc]

private def splitH (m : ℕ) (i : Fin 6) (u : (CoefficientField 2 m)ˣ) :
    rootGeneratedSubgroup 2 m :=
  splitN m i (↑u⁻¹) * splitN m i (-1)

private theorem splitH_val (m : ℕ) (i : Fin 6) (u : (CoefficientField 2 m)ˣ) :
    (splitH m i u).val = integralChevalleyTorusElement (P := Pairing)
      (integralChevalleySimpleCorootParameter (simpleIndex i) u) := by
  simp only [splitH, Subgroup.coe_mul, splitN_val]
  exact (matrixH_simple (simpleIndex i) u⁻¹).trans (by rw [inv_inv])

private def foldedN (m : ℕ) (i : Fin 4) (t : FixedField m) :
    definingCharacteristicSubgroup 2 m :=
  foldedRoot m true i t * foldedRoot m false i (-t⁻¹) * foldedRoot m true i t

private theorem foldedN_ambient (m : ℕ) (i : Fin 4) (t : FixedField m) :
    ambientInclusion m (foldedN m i t) =
      (![splitN m 0 t * splitN m 5 t,
        splitN m 1 t * splitN m 4 t,
        splitN m 2 t, splitN m 3 t] i).val := by
  simp only [foldedN, map_mul, foldedRoot_ambient]
  rw [← Subgroup.coe_mul, ← Subgroup.coe_mul]
  apply congrArg Subtype.val
  fin_cases i
  · simpa [foldedSplit]
      using splitN_pair m 0 5 (by decide) (by decide) t
  · simpa [foldedSplit]
      using splitN_pair m 1 4 (by decide) (by decide) t
  · simp [foldedSplit, splitN]
  · simp [foldedSplit, splitN]

private def foldedH (m : ℕ) (i : Fin 4) (u : (FixedField m)ˣ) :
    definingCharacteristicSubgroup 2 m :=
  foldedN m i (↑u⁻¹) * foldedN m i (-1)

private def orbitCorootParameter (m : ℕ) (i : Fin 4) (u : (FixedField m)ˣ) :
    Base.support → (CoefficientField 2 m)ˣ :=
  let p := fun j => integralChevalleySimpleCorootParameter (simpleIndex j) (coefficientUnit m u)
  ![p 0 * p 5, p 1 * p 4, p 2, p 3] i

private theorem foldedH_ambient (m : ℕ) (i : Fin 4) (u : (FixedField m)ˣ) :
    ambientInclusion m (foldedH m i u) =
      integralChevalleyTorusElement (P := Pairing) (orbitCorootParameter m i u) := by
  have hp (j k : Fin 6) (hjk : j ≠ k) (hc : typeE6CartanMatrix k j = 0) :
      (splitN m j (↑(coefficientUnit m u)⁻¹) * splitN m k (↑(coefficientUnit m u)⁻¹)) *
          (splitN m j (-1) * splitN m k (-1)) =
        splitH m j (coefficientUnit m u) * splitH m k (coefficientUnit m u) :=
    (splitN_commute m j k hjk hc (-1) _).symm.mul_mul_mul_comm _ _
  simp only [foldedH, map_mul, foldedN_ambient]
  fin_cases i
  · change ((splitN m 0 _ * splitN m 5 _).val *
      (splitN m 0 _ * splitN m 5 _).val) = _
    rw [← Subgroup.coe_mul]
    simp only [Units.val_inv_eq_inv_val, Subfield.coe_inv, Subfield.coe_neg,
      Subfield.coe_one, coefficientUnit_val] at *
    rw [hp 0 5 (by decide) (by decide), Subgroup.coe_mul, splitH_val, splitH_val,
      ← integralChevalleyTorusElement_mul]
    rfl
  · change ((splitN m 1 _ * splitN m 4 _).val *
      (splitN m 1 _ * splitN m 4 _).val) = _
    rw [← Subgroup.coe_mul]
    simp only [Units.val_inv_eq_inv_val, Subfield.coe_inv, Subfield.coe_neg,
      Subfield.coe_one, coefficientUnit_val] at *
    rw [hp 1 4 (by decide) (by decide), Subgroup.coe_mul, splitH_val, splitH_val,
      ← integralChevalleyTorusElement_mul]
    rfl
  · simpa [orbitCorootParameter, splitH, Units.val_inv_eq_inv_val] using
      splitH_val m 2 (coefficientUnit m u)
  · simpa [orbitCorootParameter, splitH, Units.val_inv_eq_inv_val] using
      splitH_val m 3 (coefficientUnit m u)

private theorem orbitCorootParameter_product (m : ℕ) (a : Fin 4 → (FixedField m)ˣ) :
    orbitCorootParameter m 0 (a 0) * orbitCorootParameter m 1 (a 1) *
        orbitCorootParameter m 2 (a 2) * orbitCorootParameter m 3 (a 3) =
      foldedParameters m a := by
  have he (j k : Fin 6) : simpleIndex j = simpleIndex k ↔ j = k :=
    typeE6RootPairing_baseEquiv.injective.eq_iff
  funext j
  obtain ⟨k, rfl⟩ := typeE6RootPairing_baseEquiv.surjective j
  change _ = foldedParameters m a (simpleIndex k)
  rw [foldedParameters_simple]
  simp only [orbitCorootParameter, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val, Pi.mul_apply,
    integralChevalleySimpleCorootParameter, he]
  fin_cases k <;> simp [orbitIndex]

private def foldedTorusWord (m : ℕ) (a : Fin 4 → (FixedField m)ˣ) :
    definingCharacteristicSubgroup 2 m :=
  foldedH m 0 (a 0) * foldedH m 1 (a 1) * foldedH m 2 (a 2) * foldedH m 3 (a 3)

private theorem foldedTorusWord_ambient (m : ℕ) (a : Fin 4 → (FixedField m)ˣ) :
    ambientInclusion m (foldedTorusWord m a) = foldedTorusMatrix m a := by
  simp only [foldedTorusWord, map_mul, foldedH_ambient,
    ← integralChevalleyTorusElement_mul]
  rw [orbitCorootParameter_product]
  rfl

/-- The four folded coroots, as words in the genuine defining-characteristic subgroup. -/
def foldedTorus (m : ℕ) :
    (Fin 4 → (FixedField m)ˣ) →* definingCharacteristicSubgroup 2 m where
  toFun := foldedTorusWord m
  map_one' := by
    apply ambientInclusion_injective m
    rw [foldedTorusWord_ambient, map_one, map_one]
  map_mul' a b := by
    apply ambientInclusion_injective m
    simp only [foldedTorusWord_ambient, map_mul]

/-- The lifted torus has exactly the published folded diagonal coordinates. -/
@[simp] theorem foldedTorus_ambient (m : ℕ) (a : Fin 4 → (FixedField m)ˣ) :
    ambientInclusion m (foldedTorus m a) = foldedTorusMatrix m a :=
  foldedTorusWord_ambient m a

end
end TwistedE6.TheoremDRootNormalizer
