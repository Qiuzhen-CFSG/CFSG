module

public import Theory.SpecificGroups.LieType.TheoremDRootNormalizer.TwistedE6.FixedField
public import Theory.SpecificGroups.LieType.TwistedE6Model
public import Theory.SpecificGroups.LieType.TheoremDRootNormalizer.CorootTorus
public import Theory.AlgebraicGroup.RootSystems.SimpleGeckGroup.Commutation
public import Theory.AlgebraicGroup.RootSystems.Dynkin
import Mathlib.Tactic

/-!
# Folded root curves in the defining-characteristic subgroup of twisted E6

The four positive and negative curves use the diagram orbits {0,5}, {1,4},
{2}, {3} with coefficients in the actual q-Frobenius fixed subfield.
Cartan connectivity establishes E6 irreducibility, so the integral Geck
commutation relations apply. Paired curves are fixed by the pinned
involution and are involutions in characteristic two. They therefore lift
into the literal subgroup generated by two-elements, before the center
quotient. Their additive homomorphisms retain all fixed parameters.

Source: GLS3 §§2.2–2.4, especially Table 2.4 and the root-group construction
(`refs/KGroup/GLS3/chapter2.tex`). These are the root curves used in the
Aschbacher–Smith A.2.18 torus obstruction, printed p.40.
-/

@[expose] public section

open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
namespace TwistedE6.TheoremDRootNormalizer
noncomputable section
attribute [local instance] Classical.decEq

theorem pairing_irreducible : Pairing.IsIrreducible := by
  apply Theory.AlgebraicGroup.isIrreducible_of_cartan_connected _ Base
  · exact ⟨_, (typeE6RootPairing_baseEquiv 0).property⟩
  · intro s t
    obtain ⟨i, rfl⟩ := typeE6RootPairing_baseEquiv.surjective s
    obtain ⟨j, rfl⟩ := typeE6RootPairing_baseEquiv.surjective t
    let edge := fun u v : Fin 6 => typeE6CartanMatrix u v ≠ 0
    have hto (k : Fin 6) : Relation.ReflTransGen edge k 2 := by
      fin_cases k
      · exact (Relation.ReflTransGen.single (show edge 0 1 by decide)).tail (by decide)
      · exact .single (by decide)
      · exact .refl
      · exact .single (by decide)
      · exact .single (by decide)
      · exact (Relation.ReflTransGen.single (show edge 5 4 by decide)).tail (by decide)
    have hfrom (k : Fin 6) : Relation.ReflTransGen edge 2 k := by
      fin_cases k
      · exact (Relation.ReflTransGen.single (show edge 2 1 by decide)).tail (by decide)
      · exact .single (by decide)
      · exact .refl
      · exact .single (by decide)
      · exact .single (by decide)
      · exact (Relation.ReflTransGen.single (show edge 2 4 by decide)).tail (by decide)
    exact Relation.ReflTransGen.lift typeE6RootPairing_baseEquiv
      (fun a b hab => by
        change Base.cartanMatrix (typeE6RootPairing_baseEquiv a) (typeE6RootPairing_baseEquiv b) ≠ 0
        rw [typeE6RootPairing_base_cartan_apply]
        exact hab)
      _ _ ((hto i).trans (hfrom j))

local instance : Pairing.IsIrreducible := pairing_irreducible

abbrev simpleIndex (i : Fin 6) : Base.support := typeE6RootPairing_baseEquiv i

def splitSimple (m : ℕ) (s : Bool) (i : Fin 6) (t : CoefficientField 2 m) :
    rootGeneratedSubgroup 2 m :=
  let := Pairing.indexNeg
  if s then rootElement (CoefficientField 2 m) (simpleIndex i) t else rootElement (CoefficientField 2 m) (-(simpleIndex i) : typeE6Roots) t

@[simp] theorem splitSimple_val (m : ℕ) (s : Bool) (i : Fin 6) (t : CoefficientField 2 m) :
    (splitSimple m s i t).val =
      (RootPairing.SimpleGeckGroup.simpleFamily (b := Base)).unit (s, simpleIndex i) t := by
  let := Pairing.indexNeg
  cases s
  · exact rootCurveUnit_neg_simple (simpleIndex i) t
  · exact rootCurveUnit_simple (simpleIndex i) t

@[simp] theorem splitSimple_zero (m : ℕ) (s : Bool) (i : Fin 6) : splitSimple m s i 0 = 1 := by
  apply Subtype.ext
  simp [splitSimple_val]

theorem splitSimple_add (m : ℕ) (s : Bool) (i : Fin 6) (t u : CoefficientField 2 m) :
    splitSimple m s i (t + u) = splitSimple m s i t * splitSimple m s i u := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, splitSimple_val]
  exact (RootPairing.SimpleGeckGroup.simpleFamily (b := Base)).unit_add _ t u

theorem splitSimple_twist (m : ℕ) (s : Bool) (i : Fin 6) (t : FixedField m) :
    graphFieldTwist 2 m (splitSimple m s i t) =
      splitSimple m s (typeE6DiagramPermutation i) t := by
  let := Pairing.indexNeg
  cases s
  · change graphFieldTwist 2 m (rootElement (CoefficientField 2 m) (-(simpleIndex i) : typeE6Roots) t) =
      rootElement (CoefficientField 2 m) (-(simpleIndex (typeE6DiagramPermutation i)) : typeE6Roots) t
    rw [graphFieldTwist_negative, fixedField_pow]
    congr 2
    exact congrArg Subtype.val (typeE6DiagramBasePermutation_numbered i)
  · change graphFieldTwist 2 m (rootElement (CoefficientField 2 m) (simpleIndex i) t) =
      rootElement (CoefficientField 2 m) (simpleIndex (typeE6DiagramPermutation i)) t
    rw [graphFieldTwist_positive, fixedField_pow]
    congr 1
    exact congrArg Subtype.val (typeE6DiagramBasePermutation_numbered i)

theorem splitSimple_commute (m : ℕ) (s : Bool) (i j : Fin 6)
    (hij : i ≠ j) (hc : typeE6CartanMatrix j i = 0) (t u : CoefficientField 2 m) :
    Commute (splitSimple m s i t) (splitSimple m s j u) := by
  have hn : simpleIndex i ≠ simpleIndex j := fun h => hij (typeE6RootPairing_baseEquiv.injective h)
  have hz : Base.cartanMatrix (simpleIndex j) (simpleIndex i) = 0 :=
    (typeE6RootPairing_base_cartan_apply j i).trans hc
  apply Subtype.ext
  simp only [Subgroup.coe_mul, splitSimple_val]
  cases s
  · exact congrArg Subtype.val
      (RootPairing.SimpleGeckGroup.commute_negative_negative_of_cartan_eq_zero
        (simpleIndex i) (simpleIndex j) hn hz t u).eq
  · exact congrArg Subtype.val
      (RootPairing.SimpleGeckGroup.commute_positive_positive_of_cartan_eq_zero
        (simpleIndex i) (simpleIndex j) hn hz t u).eq

theorem splitSimple_opposite_commute (m : ℕ) (i j : Fin 6)
    (hij : i ≠ j) (t u : CoefficientField 2 m) :
    Commute (splitSimple m true i t) (splitSimple m false j u) := by
  apply Subtype.ext
  simp only [Subgroup.coe_mul, splitSimple_val]
  exact congrArg Subtype.val (RootPairing.SimpleGeckGroup.commute_positive_negative
    (simpleIndex i) (simpleIndex j)
    (fun h => hij (typeE6RootPairing_baseEquiv.injective h)) t u).eq

def foldedSplit (m : ℕ) (s : Bool) (i : Fin 4) (t : FixedField m) :
    rootGeneratedSubgroup 2 m :=
  ![splitSimple m s 0 t * splitSimple m s 5 t,
    splitSimple m s 1 t * splitSimple m s 4 t,
    splitSimple m s 2 t, splitSimple m s 3 t] i

theorem foldedSplit_add (m : ℕ) (s : Bool) (i : Fin 4) (t u : FixedField m) :
    foldedSplit m s i (t + u) = foldedSplit m s i t * foldedSplit m s i u := by
  have h (a b : Fin 6) (hne : a ≠ b) (hc : typeE6CartanMatrix b a = 0) :
      splitSimple m s a ((t + u : FixedField m) : CoefficientField 2 m) *
        splitSimple m s b ((t + u : FixedField m) : CoefficientField 2 m) =
      (splitSimple m s a t * splitSimple m s b t) *
        (splitSimple m s a u * splitSimple m s b u) := by
    simp only [Subfield.coe_add, splitSimple_add]
    exact (splitSimple_commute m s a b hne hc u t).mul_mul_mul_comm _ _
  fin_cases i
  · exact h 0 5 (by decide) (by decide)
  · exact h 1 4 (by decide) (by decide)
  · exact splitSimple_add m s 2 t u
  · exact splitSimple_add m s 3 t u

@[simp] theorem foldedSplit_zero (m : ℕ) (s : Bool) (i : Fin 4) : foldedSplit m s i 0 = 1 := by
  fin_cases i <;> simp [foldedSplit]

theorem foldedSplit_fixed (m : ℕ) (s : Bool) (i : Fin 4) (t : FixedField m) :
    graphFieldTwist 2 m (foldedSplit m s i t) = foldedSplit m s i t := by
  fin_cases i
  · change graphFieldTwist 2 m (splitSimple m s 0 t * splitSimple m s 5 t) = _
    rw [map_mul, splitSimple_twist, splitSimple_twist]
    exact (splitSimple_commute m s 5 0 (by decide) (by decide) t t).eq
  · change graphFieldTwist 2 m (splitSimple m s 1 t * splitSimple m s 4 t) = _
    rw [map_mul, splitSimple_twist, splitSimple_twist]
    exact (splitSimple_commute m s 4 1 (by decide) (by decide) t t).eq
  · simp [foldedSplit, splitSimple_twist, typeE6DiagramPermutation]
  · simp [foldedSplit, splitSimple_twist, typeE6DiagramPermutation]

def foldedFixed (m : ℕ) (s : Bool) (i : Fin 4) (t : FixedField m) : rationalFixedSubgroup 2 m :=
  ⟨(foldedSplit m s i t).val,
    (mem_rationalFixedSubgroup_iff 2 m _).mpr (foldedSplit_fixed m s i t)⟩

theorem foldedFixed_add (m : ℕ) (s : Bool) (i : Fin 4) (t u : FixedField m) :
    foldedFixed m s i (t + u) = foldedFixed m s i t * foldedFixed m s i u :=
  Subtype.ext (congrArg (fun g : rootGeneratedSubgroup 2 m => g.val) (foldedSplit_add m s i t u))

@[simp] theorem foldedFixed_zero (m : ℕ) (s : Bool) (i : Fin 4) : foldedFixed m s i 0 = 1 :=
  Subtype.ext (congrArg (fun g : rootGeneratedSubgroup 2 m => g.val) (foldedSplit_zero m s i))

theorem foldedFixed_square (m : ℕ) (s : Bool) (i : Fin 4) (t : FixedField m) :
    foldedFixed m s i t ^ 2 = 1 := by
  rw [pow_two, ← foldedFixed_add, CharTwo.add_self_eq_zero, foldedFixed_zero]

def foldedRoot (m : ℕ) (s : Bool) (i : Fin 4) (t : FixedField m) : definingCharacteristicSubgroup 2 m :=
  ⟨foldedFixed m s i t,
    Subgroup.mem_primePowerGenerated_of_pow (n := 1) (by
      simpa only [pow_one] using foldedFixed_square m s i t)⟩

def ambientInclusion (m : ℕ) : definingCharacteristicSubgroup 2 m →* AmbientGroup 2 m :=
  (rationalFixedSubgroup 2 m).subtype.comp (definingCharacteristicSubgroup 2 m).subtype

theorem ambientInclusion_injective (m : ℕ) : Function.Injective (ambientInclusion m) :=
  Subtype.val_injective.comp Subtype.val_injective

@[simp] theorem foldedRoot_ambient (m : ℕ) (s : Bool) (i : Fin 4) (t : FixedField m) :
    ambientInclusion m (foldedRoot m s i t) = (foldedSplit m s i t).val := rfl

theorem foldedRoot_add (m : ℕ) (s : Bool) (i : Fin 4) (t u : FixedField m) :
    foldedRoot m s i (t + u) = foldedRoot m s i t * foldedRoot m s i u :=
  Subtype.ext (foldedFixed_add m s i t u)

@[simp] theorem foldedRoot_zero (m : ℕ) (s : Bool) (i : Fin 4) : foldedRoot m s i 0 = 1 :=
  Subtype.ext (foldedFixed_zero m s i)

def foldedRootHom (m : ℕ) (s : Bool) (i : Fin 4) :
    Multiplicative (FixedField m) →* definingCharacteristicSubgroup 2 m where
  toFun x := foldedRoot m s i x.toAdd
  map_one' := foldedRoot_zero m s i
  map_mul' x y := foldedRoot_add m s i x.toAdd y.toAdd

end
end TwistedE6.TheoremDRootNormalizer
