module

public import Theory.SpecificGroups.LieType.ExceptionalSplitModels
public import Theory.AlgebraicGroup.RootSystems.IntegralRootCurveSimpleGeneration
public import Theory.GroupTheory.PrimePowerGenerated

/-!
# Generation of the split exceptional central quotients

The actual matrix group is generated by its positive and negative simple
root curves, using the signed integral Tits-word construction. Passing through
the literal central projection proves that homomorphisms from the quotient
are determined by those curves. In particular the positive and negative
root subgroups generate the quotient, and in characteristic p it is generated
by p-elements.

These are generation statements for the carriers in `ExceptionalSplitModels`.
They do not assert that the positive subgroup is Sylow or classify abstract
automorphisms. They provide the generation step for those later calculations,
including over the prime fields.

Sources: Steinberg, *Lectures on Chevalley Groups*, Sections 3 and 10
(`refs/KGroup/GLS3/Chapter2St1.tex`, automorphism proof steps (1)--(4));
GLS3 §§2.1--2.3 for the elementary group and central-quotient conventions.
-/

@[expose] public section
noncomputable section
namespace ExceptionalSplit
open RootPairing.IntegralGeckConstruction

variable {ι R M N : Type*} [Field R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [P.IsCrystallographic] [P.IsReduced]
  {b : P.Base} [Fintype ι] [DecidableEq ι]
  {F : Type*} [Field F]

/-- Containing both signed simple-root curves suffices to contain the entire elementary matrix group. -/
theorem rootGenerated_le_of_simple
    (H : Subgroup (Matrix (b.support ⊕ ι) (b.support ⊕ ι) F)ˣ)
    (hpos : ∀ (i : b.support) (t : F),
      rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) i t ∈ H)
    (hneg : let := P.indexNeg; ∀ (i : b.support) (t : F),
      rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) (-i : ι) t ∈ H) :
    rootGenerated P b F ≤ H := by
  let := P.indexNeg
  change allRootCurveSubgroup b F ≤ H
  rw [allRootCurveSubgroup_eq_simpleSubgroup]
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨⟨s, i⟩, t, rfl⟩
  cases s
  · change RootPairing.SimpleGeckGroup.negativeUnit i t ∈ H
    simpa only [rootCurveUnit_neg_simple] using hneg i t
  · change RootPairing.SimpleGeckGroup.positiveUnit i t ∈ H
    simpa only [rootCurveUnit_simple] using hpos i t

/-- The signed simple roots generate inside the literal elementary subgroup. -/
theorem elementary_subgroup_eq_top_of_simple (H : Subgroup (rootGenerated P b F))
    (hpos : ∀ (i : b.support) (t : F), elementaryRoot P b F i t ∈ H)
    (hneg : let := P.indexNeg; ∀ (i : b.support) (t : F),
      elementaryRoot P b F (-i : ι) t ∈ H) : H = ⊤ := by
  let := P.indexNeg
  have hle : rootGenerated P b F ≤ H.map (rootGenerated P b F).subtype := by
    apply rootGenerated_le_of_simple
    · intro i t
      exact ⟨elementaryRoot P b F i t, hpos i t, rfl⟩
    · dsimp only
      intro i t
      exact ⟨elementaryRoot P b F (-i : ι) t, hneg i t, rfl⟩
  apply top_unique
  intro x _
  obtain ⟨y, hy, hyx⟩ := hle x.property
  exact (Subtype.ext hyx : y = x) ▸ hy

/-- The same signed curves generate after taking the center quotient. -/
theorem model_subgroup_eq_top_of_simple (H : Subgroup (Model P b F))
    (hpos : ∀ (i : b.support) (t : F), rootElement P b F i t ∈ H)
    (hneg : let := P.indexNeg; ∀ (i : b.support) (t : F),
      rootElement P b F (-i : ι) t ∈ H) : H = ⊤ := by
  have he : H.comap (projection P b F) = ⊤ :=
    elementary_subgroup_eq_top_of_simple _ hpos hneg
  apply top_unique
  intro x _
  obtain ⟨y, rfl⟩ := projection_surjective P b F x
  exact (show y ∈ H.comap (projection P b F) by rw [he]; trivial)

/-- Homomorphisms on the actual central quotient are determined by its signed simple-root parameters. -/
theorem model_hom_ext_simple {A : Type*} [Monoid A]
    (f g : Model P b F →* A)
    (hpos : ∀ (i : b.support) (t : F), f (rootElement P b F i t) =
      g (rootElement P b F i t))
    (hneg : let := P.indexNeg; ∀ (i : b.support) (t : F),
      f (rootElement P b F (-i : ι) t) = g (rootElement P b F (-i : ι) t)) :
    f = g := by
  have he := model_subgroup_eq_top_of_simple (f.eqLocus g) hpos hneg
  exact MonoidHom.ext fun x => show x ∈ f.eqLocus g from he ▸ Subgroup.mem_top x

/-- The subgroup generated by every positive root, in the central quotient. -/
def positiveRootSubgroup : Subgroup (Model P b F) :=
  Subgroup.closure {x | ∃ (r : ι) (t : F), b.IsPos r ∧ rootElement P b F r t = x}

/-- The subgroup generated by every negative root, in the central quotient. -/
def negativeRootSubgroup : Subgroup (Model P b F) :=
  Subgroup.closure {x | ∃ (r : ι) (t : F), ¬ b.IsPos r ∧ rootElement P b F r t = x}

theorem rootElement_mem_positive {r : ι} (hr : b.IsPos r) (t : F) :
    rootElement P b F r t ∈ positiveRootSubgroup (P := P) (b := b) :=
  Subgroup.subset_closure ⟨r, t, hr, rfl⟩

theorem rootElement_mem_negative {r : ι} (hr : ¬ b.IsPos r) (t : F) :
    rootElement P b F r t ∈ negativeRootSubgroup (P := P) (b := b) :=
  Subgroup.subset_closure ⟨r, t, hr, rfl⟩

/-- The two opposite root subgroups generate the actual central quotient. -/
theorem positive_sup_negative_eq_top :
    positiveRootSubgroup (P := P) (b := b) (F := F) ⊔ negativeRootSubgroup = ⊤ := by
  let := P.indexNeg
  apply model_subgroup_eq_top_of_simple
  · intro i t
    exact Subgroup.mem_sup_left (rootElement_mem_positive (b.isPos_of_mem_support i.property) t)
  · dsimp only
    intro i t
    apply Subgroup.mem_sup_right
    apply rootElement_mem_negative
    rw [RootPairing.Base.IsPos.neg_iff_not]
    exact not_not.mpr (b.isPos_of_mem_support i.property)

theorem rootElement_nsmul (r : ι) (t : F) (n : ℕ) :
    rootElement P b F r (n • t) = rootElement P b F r t ^ n := by
  induction n with
  | zero => simp only [zero_nsmul, rootElement_zero, pow_zero]
  | succ n ih => rw [succ_nsmul, rootElement_add, ih, pow_succ]

/-- Every root parameter is killed by the coefficient characteristic. -/
theorem rootElement_pow_char (p : ℕ) [CharP F p] (r : ι) (t : F) :
    rootElement P b F r t ^ p = 1 := by
  rw [← rootElement_nsmul, nsmul_eq_mul, CharP.cast_eq_zero F p, zero_mul,
    rootElement_zero]

/-- The elementary central quotient is generated by characteristic-prime elements: this is the O^{p′} convention. -/
theorem model_primePowerGenerated (p : ℕ) [CharP F p] :
    Subgroup.primePowerGenerated p (Model P b F) = ⊤ := by
  apply model_subgroup_eq_top_of_simple
  · intro i t
    apply Subgroup.mem_primePowerGenerated_of_pow (n := 1)
    simpa only [pow_one] using rootElement_pow_char p (i : ι) t
  · let := P.indexNeg
    dsimp only
    intro i t
    apply Subgroup.mem_primePowerGenerated_of_pow (n := 1)
    simpa only [pow_one] using rootElement_pow_char p (-i : ι) t

end ExceptionalSplit
