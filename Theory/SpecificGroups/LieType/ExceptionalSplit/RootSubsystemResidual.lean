module
public import Theory.SpecificGroups.LieType.ExceptionalSplit.RootGeneration
public import Theory.GroupTheory.PResidual.PrimeToMonotone

/-!
# Residuals and central kernels of literal root subgroups

Any chosen family of integral Chevalley root curves generates a group equal
to its own prime-to-characteristic residual. Every root parameter has order
killed by the characteristic, so the residual contains the generators; this
argument requires neither perfectness nor a finite-field order formula.
The same statement descends through the actual central projection.

The restricted projection has kernel exactly the intersection with the
ambient elementary group's center. In particular, its faithfulness must be
proved separately from faithfulness of a representation before projection.
`F4RootCentralizer.Subsystem` applies these results to the roots orthogonal
to the specified long root in the actual F4 adjoint lattice.

Source: the common-lattice subsystem construction in GLS3 §2.6
(`refs/KGroup/GLS3/chapter2.tex`); the residual convention is that of
Aschbacher–Smith A.2.17, printed p.39 of `refs/quasithin.pdf`.
-/

@[expose] public noncomputable section
namespace ExceptionalSplit
open RootPairing.IntegralGeckConstruction

variable {ι R M N : Type*} [Field R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [P.IsCrystallographic] [P.IsReduced]
  {b : P.Base} [Fintype ι] [DecidableEq ι]
  {F : Type*} [Field F]

/-- The subgroup of the elementary matrix group generated by the specified roots. -/
def elementaryRootSubgroup (S : Set ι) : Subgroup (rootGenerated P b F) :=
  Subgroup.closure {x | ∃ r ∈ S, ∃ t : F, elementaryRoot P b F r t = x}

/-- Every root curve from the selected set belongs to its generated subgroup. -/
theorem elementaryRoot_mem_subgroup {S : Set ι} {r : ι} (hr : r ∈ S) (t : F) :
    elementaryRoot P b F r t ∈ elementaryRootSubgroup (P := P) (b := b) S :=
  Subgroup.subset_closure ⟨r, hr, t, rfl⟩

/-- The elementary root parameter, before taking the central quotient, is killed by the characteristic. -/
theorem elementaryRoot_pow_char (p : ℕ) [CharP F p] (r : ι) (t : F) :
    elementaryRoot P b F r t ^ p = 1 := by
  have hn (n : ℕ) : elementaryRoot P b F r (n • t) =
      elementaryRoot P b F r t ^ n := by
    induction n with
    | zero => simp only [zero_nsmul, elementaryRoot_zero, pow_zero]
    | succ n ih => rw [succ_nsmul, elementaryRoot_add, ih, pow_succ]
  rw [← hn, nsmul_eq_mul, CharP.cast_eq_zero F p, zero_mul, elementaryRoot_zero]

/-- Root-generated subgroups are their own prime-to-characteristic residuals. -/
theorem elementaryRootSubgroup_primeToResidual (p : ℕ) [CharP F p] (S : Set ι) :
    Subgroup.primeToResidual p (elementaryRootSubgroup (P := P) (b := b) (F := F) S) = ⊤ := by
  let K := elementaryRootSubgroup (P := P) (b := b) (F := F) S
  have hK : K ≤ (Subgroup.primeToResidual p K).map K.subtype := by
    apply (Subgroup.closure_le _).mpr
    rintro x ⟨r, hr, t, rfl⟩
    let y : K := ⟨elementaryRoot P b F r t, elementaryRoot_mem_subgroup hr t⟩
    refine ⟨y, Subgroup.mem_primeToResidual_of_pow (n := 1) ?_, rfl⟩
    apply Subtype.ext
    change elementaryRoot P b F r t ^ (p ^ 1) = 1
    simpa only [pow_one] using elementaryRoot_pow_char p r t
  apply top_unique
  intro x _
  obtain ⟨y, hy, hyx⟩ := hK x.property
  exact (Subtype.ext hyx : y = x) ▸ hy

/-- The image of the same root subgroup in the literal central quotient. -/
def projectedRootSubgroup (S : Set ι) : Subgroup (Model P b F) :=
  (elementaryRootSubgroup (P := P) (b := b) S).map (projection P b F)

/-- The restriction of the actual central projection to a chosen root subgroup. -/
def rootSubgroupProjection (S : Set ι) :
    elementaryRootSubgroup (P := P) (b := b) (F := F) S →*
      projectedRootSubgroup (P := P) (b := b) (F := F) S :=
  (projection P b F).subgroupMap _

/-- The restricted central projection is onto the projected root subgroup. -/
theorem rootSubgroupProjection_surjective (S : Set ι) :
    Function.Surjective (rootSubgroupProjection (P := P) (b := b) (F := F) S) :=
  (projection P b F).subgroupMap_surjective _

/-- The root-subgroup image is also generated by defining-characteristic elements. -/
theorem projectedRootSubgroup_primeToResidual (p : ℕ) [CharP F p] (S : Set ι) :
    Subgroup.primeToResidual p (projectedRootSubgroup (P := P) (b := b) (F := F) S) = ⊤ := by
  have h := Subgroup.map_primeToResidual_le_of_hom p
    (rootSubgroupProjection (P := P) (b := b) (F := F) S)
  rw [elementaryRootSubgroup_primeToResidual,
    Subgroup.map_top_of_surjective _ (rootSubgroupProjection_surjective S)] at h
  exact top_unique h

/-- The exact central kernel, relative to the chosen elementary root subgroup. -/
theorem rootSubgroupProjection_ker (S : Set ι) :
    (rootSubgroupProjection (P := P) (b := b) (F := F) S).ker =
      (Subgroup.center (rootGenerated P b F)).subgroupOf
        (elementaryRootSubgroup (P := P) (b := b) (F := F) S) := by
  ext x
  change (rootSubgroupProjection S x = 1) ↔ _
  rw [Subtype.ext_iff]
  exact projection_eq_one_iff P b F x.val

/-- Projection is faithful precisely when the root subgroup misses the ambient center. -/
theorem rootSubgroupProjection_injective_iff (S : Set ι) :
    Function.Injective (rootSubgroupProjection (P := P) (b := b) (F := F) S) ↔
      Disjoint (elementaryRootSubgroup (P := P) (b := b) (F := F) S)
        (Subgroup.center (rootGenerated P b F)) := by
  rw [← MonoidHom.ker_eq_bot_iff, rootSubgroupProjection_ker]
  rw [Subgroup.subgroupOf_eq_bot, disjoint_comm]

end ExceptionalSplit
end
