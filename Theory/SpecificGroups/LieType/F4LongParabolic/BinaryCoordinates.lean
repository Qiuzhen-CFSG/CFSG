private theorem decode_commute (a b : Array ℕ)
    (h : ∀ i : Fin 52, rowProduct a[i.val]! b 52 = rowProduct b[i.val]! a 52) :
    decode 52 a * decode 52 b = decode 52 b * decode 52 a := by
  ext i j
  change (∑ k : Fin 52, bit a[i.val]! k.val * bit b[k.val]! j.val) =
    ∑ k : Fin 52, bit b[i.val]! k.val * bit a[k.val]! j.val
  rw [Fin.sum_univ_eq_sum_range (fun k => bit a[i.val]! k * bit b[k]! j.val),
    Fin.sum_univ_eq_sum_range (fun k => bit b[i.val]! k * bit a[k]! j.val),
    ← bit_rowProduct, ← bit_rowProduct, h i]

