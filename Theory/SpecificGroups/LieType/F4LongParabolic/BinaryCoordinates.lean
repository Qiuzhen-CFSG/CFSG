  let f := (MulAut.conj (root i)).toMonoidHom
  have hm : H.map f ≤ H := by
    rw [map_le_iff_le_comap]
    apply (closure_le _).mpr
    intro u hu
    rcases hu with rfl | rfl
    · change root i * h * (root i)⁻¹ ∈ H
      rw [all_root_h, mul_inv_cancel_right]
      split
      · exact H.mul_mem (subset_closure (by simp)) (subset_closure (by simp))
      · exact subset_closure (by simp)
    · change root i * z * (root i)⁻¹ ∈ H
      rw [all_root_z, mul_inv_cancel_right]
      exact subset_closure (by simp)
  exact conjugation_map_eq_of_square H (root i) (Units.ext (root_square i)) hm

theorem D_centralizes_H : D ≤ centralizer (H : Set Matˣ) := by
  exact (commutator_mono le_rfl (le_centralizer_iff.mp H_centralizes_A)).trans
    (le_normalizer_iff_commutator_le_right.mp
      (E_normalizes_H.trans (normalizer_le_normalizer_centralizer H)))

def L : Subgroup Matˣ := A ⊔ D

def Q : Subgroup Matˣ := ⁅E,L⁆

theorem h_mem_Q : h ∈ Q := by
  apply (commutator_mono le_rfl (show A ≤ L from le_sup_left))
  have hDD : ⁅D,D⁆ ≤ D := (commutator_le_sup (H₁ := D) (H₂ := D)).trans (sup_le le_rfl le_rfl)
  have hDDD : ⁅⁅D,D⁆,D⁆ ≤ D :=
    (commutator_le_sup (H₁ := ⁅D,D⁆) (H₂ := D)).trans (sup_le hDD le_rfl)
  exact hDDD h_mem_third

theorem h_centralizes_L : h ∈ centralizer (L : Set Matˣ) := by
  have hLH : L ≤ centralizer (H : Set Matˣ) :=
    sup_le (le_centralizer_iff.mp H_centralizes_A) D_centralizes_H
  exact (le_centralizer_iff.mp hLH) (subset_closure (by simp))

theorem original_component_fixed_factor_not_central :
    ¬ Q ⊓ centralizer (L : Set Matˣ) ≤ centralizer (E : Set Matˣ) := by
  intro hc
  exact h_does_not_commute_x (hc ⟨h_mem_Q,h_centralizes_L⟩ x (root_mem _)).symm


end Theory.SpecificGroups.LieType.F4LongParabolic.BinaryCoordinates
