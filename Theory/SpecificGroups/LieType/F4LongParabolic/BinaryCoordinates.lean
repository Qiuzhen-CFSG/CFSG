private theorem conjugation_map_eq_of_square {G : Type*} [Group G]
    (K : Subgroup G) (g : G) (hg : g * g = 1)
    (hm : K.map (MulAut.conj g).toMonoidHom ≤ K) :
    K.map (MulAut.conj g).toMonoidHom = K := by
  apply le_antisymm hm
  intro x hx
  refine ⟨(MulAut.conj g) x, hm (mem_map_of_mem _ hx), ?_⟩
  change g * (g * x * g⁻¹) * g⁻¹ = x
  calc
    _ = (g * g) * x * (g * g)⁻¹ := by group
    _ = x := by rw [hg]; simp

theorem E_normalizes_H : E ≤ normalizer (H : Set Matˣ) := by
