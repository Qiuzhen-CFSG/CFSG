module
public import Theory.SpecificGroups.ReeF4.Model.LocalBlock
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.WeylOpposition
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.Disjoint
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Characteristic subgroups in a long-A2 parabolic of split F4

Let U be the positive root subgroup and P the subgroup generated by U and
negative simple roots at nodes zero and one. No nontrivial characteristic
subgroup of U is normal in P. Exceptional duality preserves U and reverses
the diagram. It therefore supplies the other two negative root normalizers.
The Coxeter opposition word then places the subgroup in both U and its
opposite, whose intersection is trivial.

The literal intrinsic two-subgroup `positiveInParabolic` is retained for the
MS3 application. This proves no quotient, radical, or classification assertion.

Sources: Steinberg's exceptional F4 root automorphism (GLS3 1.15.4(b)),
positive/negative separation (GLS3 2.3.8(c)); the MS3 condition in
Aschbacher--Smith C.1.31, printed p.135, and the F4 examples of
Meierfrankenfeld--Stellmacher (1993), printed p.831.
-/

public section
noncomputable section
namespace Theory.SpecificGroups.LieType.F4LongParabolic
open Subgroup Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open ReeF4 ReeF4.LargeLocalSeeds ReeF4.LocalBlockInput.PairNormalization
local instance rootNeg : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg

@[expose] def longParabolic (m : ℕ) : Subgroup (SplitGroup m) :=
  splitUnipotent m ⊔ closure {x | ∃ (i : Fin 4) (t : CoefficientField m),
    i.val < 2 ∧ x = rootGeneratorInGroup m (-typeF4SimpleRootIndex i) t}

private theorem characteristic_map_stable {G : Type*} [Group G]
    (S : Subgroup G) (C : Subgroup S) [C.Characteristic]
    (a : MulAut G) (ha : S.map a.toMonoidHom = S) :
    (C.map S.subtype).map a.toMonoidHom = C.map S.subtype := by
  let b : MulAut S := (a.subgroupMap S).trans (MulEquiv.subgroupCongr ha)
  have hb := characteristic_iff_map_eq.mp (inferInstance : C.Characteristic) b
  have hm := congrArg (map S.subtype) hb
  have he : S.subtype.comp b.toMonoidHom = a.toMonoidHom.comp S.subtype := by
    ext x
    exact (MulEquiv.subgroupCongr_apply ha _).trans (MulEquiv.coe_subgroupMap_apply a S x)
  simpa only [map_map, he] using hm

/-- MS3 for the positive root subgroup, with normality relative to its actual parabolic. -/
theorem characteristic_normal_eq_bot (m : ℕ) (C : Subgroup (splitUnipotent m))
    [C.Characteristic]
    (hn : ((C.map (splitUnipotent m).subtype).subgroupOf (longParabolic m)).Normal) :
    C = ⊥ := by
  let S := splitUnipotent m
  let X := C.map S.subtype
  let d := canonicalLocalBlockInput m
  have hXS : X ≤ S := map_subtype_le C
  have hXP : X ≤ longParabolic m := hXS.trans le_sup_left
  have hPN : longParabolic m ≤ normalizer (X : Set (SplitGroup m)) :=
    (normal_subgroupOf_iff_le_normalizer hXP).mp hn
  have hSN : S ≤ normalizer (X : Set (SplitGroup m)) := le_sup_left.trans hPN
  have hXmap : X.map d.twist.toMonoidHom = X :=
    characteristic_map_stable S C d.twist (splitUnipotent_twist d)
  have hNstable {x : SplitGroup m} (hx : x ∈ normalizer (X : Set (SplitGroup m))) :
      d.twist x ∈ normalizer (X : Set (SplitGroup m)) := by
    rw [← hXmap]
    exact (le_normalizer_map d.twist.toMonoidHom) (mem_map_of_mem _ hx)
  have hp (i : Fin 4) : rootGeneratorInGroup m (typeF4SimpleRootIndex i) 1 ∈
      normalizer (X : Set (SplitGroup m)) :=
    hSN (subset_closure ⟨_, 1, typeF4RootPairing_base.isPos_of_mem_support
      (typeF4RootPairing_baseEquiv i).property, rfl⟩)
  have hnfirst (i : Fin 4) (hi : i.val < 2) :
      rootGeneratorInGroup m (-typeF4SimpleRootIndex i) 1 ∈
        normalizer (X : Set (SplitGroup m)) :=
    hPN (mem_sup_right (subset_closure ⟨i, 1, hi, rfl⟩))
  have ht (i : Fin 4) :
      d.twist (rootGeneratorInGroup m (-typeF4SimpleRootIndex i) 1) =
        rootGeneratorInGroup m (-typeF4SimpleRootIndex (Fin.revPerm i)) 1 := by
    rw [d.twist_root, exceptionalRootPermutation_neg_simple]
    congr 1
    simp only [one_pow]
    by_cases hr : IsLongRoot (-typeF4SimpleRootIndex i)
    · exact exceptionalParameter_of_long hr 1
    · simpa only [one_pow] using exceptionalParameter_of_short hr (1 : CoefficientField m)
  have hnall (i : Fin 4) : rootGeneratorInGroup m (-typeF4SimpleRootIndex i) 1 ∈
      normalizer (X : Set (SplitGroup m)) := by
    fin_cases i
    · exact hnfirst 0 (by decide)
    · exact hnfirst 1 (by decide)
    · have he := hNstable (hnfirst 1 (by decide))
      rw [ht] at he
      have hi : (Fin.revPerm (1 : Fin 4)) = ⟨2, by decide⟩ := by decide
      exact congrArg (fun j : Fin 4 => rootGeneratorInGroup m
        (-typeF4SimpleRootIndex j) (1 : CoefficientField m) ∈
        normalizer (X : Set (SplitGroup m))) hi ▸ he
    · have he := hNstable (hnfirst 0 (by decide))
      rw [ht] at he
      have hi : (Fin.revPerm (0 : Fin 4)) = ⟨3, by decide⟩ := by decide
      exact congrArg (fun j : Fin 4 => rootGeneratorInGroup m
        (-typeF4SimpleRootIndex j) (1 : CoefficientField m) ∈
        normalizer (X : Set (SplitGroup m))) hi ▸ he
  have hl (i : Fin 4) : simpleLift m i ∈ normalizer (X : Set (SplitGroup m)) :=
    mul_mem (mul_mem (hp i) (hnall i)) (hp i)
  have hw : splitOpposition m ∈ normalizer (X : Set (SplitGroup m)) :=
    pow_mem (mul_mem (mul_mem (mul_mem (hl 0) (hl 1)) (hl 2)) (hl 3)) 6
  have hXneg : X ≤ LocalBlockInput.splitNegativeUnipotent m := by
    rw [← splitOpposition_map_unipotent]
    have he : X.map (MulAut.conj (splitOpposition m)).toMonoidHom = X :=
      mem_normalizer_iff_map_conj_eq.mp hw
    exact he ▸ map_mono hXS
  have hzero : X = ⊥ := by
    apply le_bot_iff.mp
    intro x hx
    exact (disjoint_def.mp (splitUnipotent_disjoint_negative m)) (hXS hx) (hXneg hx)
  exact (map_eq_bot_iff_of_injective C S.subtype_injective).mp hzero


/-- The positive subgroup inside the actual long-A2 parabolic. -/
@[expose] def positiveInParabolic (m : ℕ) : Subgroup (longParabolic m) :=
  (splitUnipotent m).subgroupOf (longParabolic m)

/-- The intrinsic positive subgroup is a two-group. No Sylow claim is made here. -/
theorem positiveInParabolic_isPGroup (m : ℕ) : IsPGroup 2 (positiveInParabolic m) :=
  (splitUnipotent_isPGroup m).of_equiv
    (subgroupOfEquivOfLe (show splitUnipotent m ≤ longParabolic m from le_sup_left)).symm

end Theory.SpecificGroups.LieType.F4LongParabolic
