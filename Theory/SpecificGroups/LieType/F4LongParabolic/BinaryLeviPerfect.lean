/-- The specified long-A2 Levi is perfect, without a quotient or simplicity assumption. -/
theorem A_isPerfect : Group.IsPerfect A := by
  apply Subgroup.isPerfect_iff.mpr
  apply le_antisymm (commutator_le_self A)
  apply (closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  fin_cases i
  · change levi (0 : Fin 4) ∈ ⁅A,A⁆
    rw [← leviPerfectWord_0]
    exact commutator_mem_commutator (levi_mem 3)
      (A.mul_mem (A.mul_mem (levi_mem 2) (levi_mem 0)) (levi_mem 2))
  · change levi (1 : Fin 4) ∈ ⁅A,A⁆
    rw [← leviPerfectWord_1]
    exact commutator_mem_commutator (levi_mem 2)
      (A.mul_mem (A.mul_mem (levi_mem 3) (levi_mem 1)) (levi_mem 3))
  · change levi (2 : Fin 4) ∈ ⁅A,A⁆
    rw [← leviPerfectWord_2]
    exact commutator_mem_commutator (levi_mem 1)
      (A.mul_mem (A.mul_mem (levi_mem 0) (levi_mem 2)) (levi_mem 0))
  · change levi (3 : Fin 4) ∈ ⁅A,A⁆
    rw [← leviPerfectWord_3]
    exact commutator_mem_commutator (levi_mem 0)
      (A.mul_mem (A.mul_mem (levi_mem 1) (levi_mem 3)) (levi_mem 1))
