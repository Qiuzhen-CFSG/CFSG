def word (a : SL) : List (Fin 4) := (wordTable[binaryCode a]!).map (fun k => ⟨k % 4, Nat.mod_lt _ (by decide)⟩)
set_option maxRecDepth 10000 in
theorem word_result : ∀ a : SL, ((word a).map source).prod = a := by 
  decide +kernel
set_option maxRecDepth 10000 in
theorem matrix_one : matrix 1 = 1 := by 
  decide +kernel
set_option maxRecDepth 10000 in
theorem next_source0 : ∀ a : SL, index (a * source 0) = step0 (index a) := by 
  decide +kernel
set_option maxRecDepth 10000 in
theorem next_source1 : ∀ a : SL, index (a * source 1) = step1 (index a) := by 
  decide +kernel
set_option maxRecDepth 10000 in
theorem next_source2 : ∀ a : SL, index (a * source 2) = step2 (index a) := by 
  decide +kernel
set_option maxRecDepth 10000 in
theorem next_source3 : ∀ a : SL, index (a * source 3) = step3 (index a) := by 
  decide +kernel
set_option maxRecDepth 10000 in
theorem recover : ∀ a : SL,
    !![matrix a 6 6, matrix a 6 8, matrix a 6 10;
       matrix a 8 6, matrix a 8 8, matrix a 8 10;
       matrix a 10 6, matrix a 10 8, matrix a 10 10] = a.val := by
  decide +kernel
theorem generator_mul (a : SL) (k : Fin 4) :
    matrix (a * source k) = matrix a * (levi k).val := by
  have hr (r : Fin 52) : rowProduct (rowValue (rowCode (index a) r)) (leviRows k) 52 =
      rowValue (rowCode (index (a * source k)) r) := by
    fin_cases k
    · change rowProduct (rowValue (rowCode (index a) r)) (leviRows 0) 52 = rowValue (rowCode (index (a * source 0)) r)
      rw [next_source0, rowChecked0, codeChecked0]
    · change rowProduct (rowValue (rowCode (index a) r)) (leviRows 1) 52 = rowValue (rowCode (index (a * source 1)) r)
      rw [next_source1, rowChecked1, codeChecked1]
    · change rowProduct (rowValue (rowCode (index a) r)) (leviRows 2) 52 = rowValue (rowCode (index (a * source 2)) r)
      rw [next_source2, rowChecked2, codeChecked2]
    · change rowProduct (rowValue (rowCode (index a) r)) (leviRows 3) 52 = rowValue (rowCode (index (a * source 3)) r)
      rw [next_source3, rowChecked3, codeChecked3]
  ext i j
  change bit (rowValue (rowCode (index (a * source k)) i)) j.val =
    ∑ t : Fin 52, bit (rowValue (rowCode (index a) i)) t.val * bit (leviRows k)[t.val]! j.val
  rw [Fin.sum_univ_eq_sum_range (fun t => bit (rowValue (rowCode (index a) i)) t * bit (leviRows k)[t]! j.val),
    ← bit_rowProduct, hr]

private theorem word_mul (a : SL) (w : List (Fin 4)) :
    matrix (a * (w.map source).prod) =
      matrix a * (w.map (fun k => (levi k).val)).prod := by
  induction w generalizing a with
  | nil => simp
  | cons k w ih =>
    simp only [List.map_cons, List.prod_cons, ← mul_assoc]
    rw [ih, generator_mul]
theorem matrix_mul (a b : SL) : matrix (a * b) = matrix a * matrix b := by
  have hw := word_mul 1 (word b)
  simp only [one_mul, word_result, matrix_one] at hw
  rw [← word_result b, word_mul, ← hw, word_result]
def matrixHom : SL →* Mat where
  toFun := matrix
  map_one' := matrix_one
  map_mul' := matrix_mul
def representation : SL →* Matˣ := matrixHom.toHomUnits
@[simp] theorem representation_val (a : SL) : (representation a).val = matrix a := rfl
@[simp] theorem representation_source (k : Fin 4) : representation (source k) = levi k := by
  apply Units.ext
  exact (show matrix (source k) = (levi k).val from by
    simpa only [one_mul, matrix_one] using generator_mul 1 k)
theorem representation_injective : Function.Injective representation := by
  intro a b hab
  have hm : matrix a = matrix b := congrArg Units.val hab
  apply Subtype.ext
  rw [← recover a, ← recover b, hm]
theorem representation_range : representation.range = A := by
  apply le_antisymm
  · rintro _ ⟨a,rfl⟩
    rw [← word_result a, map_list_prod, List.map_map]
    apply A.list_prod_mem
    intro x hx
    obtain ⟨k,_,rfl⟩ := List.mem_map.mp hx
    simpa only [Function.comp_apply, representation_source] using levi_mem k
  · apply (closure_le _).mpr
    rintro _ ⟨k,rfl⟩
    exact ⟨source k,representation_source k⟩
end LeviModel
/-- The actual four-generator matrix Levi is the binary special linear group. -/
public noncomputable def leviEquiv : A ≃* Matrix.PSL3Two.SL :=
  ((MonoidHom.ofInjective LeviModel.representation_injective).trans
    (MulEquiv.subgroupCongr LeviModel.representation_range)).symm

end Theory.SpecificGroups.LieType.F4LongParabolic.BinaryCoordinates
