private theorem list_map_getBang {α β : Type} [Inhabited α] [Inhabited β]
    (f : α → β) (xs : List α) (i : ℕ) (hi : i < xs.length) :
    (xs.map f)[i]! = f xs[i]! := by
  simp [getElem!_pos, hi]
private theorem table_lookup
    (cs : Array (Array ℕ)) (ns : Array ℕ) (f : ℕ → ℕ) (i r : ℕ)
    (hi : i < cs.size) (hn : i < ns.size)
    (hr : r < (cs[i]!).size) (hs : r < (cs[ns[i]! % 168]!).size)
    (he : cs.toList.map (fun rs => rs.toList.map f) =
      ns.toList.map (fun k => (cs[k % 168]!).toList.map (fun c => c % 141))) :
    f (cs[i]!)[r]! = (cs[ns[i]! % 168]!)[r]! % 141 := by
  have hh := congrArg (fun ls : List (List ℕ) => (ls[i]!)[r]!) he
  rw [list_map_getBang _ _ _ hi, list_map_getBang _ _ _ hn] at hh
  simp only [Array.getElem!_toList] at hh
  rw [list_map_getBang _ _ _ hr, list_map_getBang _ _ _ hs] at hh
  simpa only [Array.getElem!_toList] using hh
