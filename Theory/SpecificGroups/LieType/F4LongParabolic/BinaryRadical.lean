private theorem levi_root_relation (l : Fin 4) (r : Fin 21) :
    levi l * root r = ((conjugateWord l r).map root).prod * levi l := by
  fin_cases l
  · exact levi_root_relation_0 r
  · exact levi_root_relation_1 r
  · exact levi_root_relation_2 r
  · exact levi_root_relation_3 r

/-- The literal signed A2 generators normalize the radical. -/
theorem A_normalizes_E : A ≤ normalizer (E : Set Matˣ) := by
  apply (closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  apply mem_normalizer_iff_map_conj_eq.mpr
  let f := (MulAut.conj (levi i)).toMonoidHom
  have hm : E.map f ≤ E := by
    rw [map_le_iff_le_comap]
    apply (closure_le _).mpr
    rintro _ ⟨j, rfl⟩
    change levi i * root j * (levi i)⁻¹ ∈ E
    rw [levi_root_relation, mul_inv_cancel_right]
    apply E.list_prod_mem
    intro x hx
    obtain ⟨k, _, rfl⟩ := List.mem_map.mp hx
    exact root_mem k
  apply le_antisymm hm
  intro x hx
  refine ⟨f x, hm (mem_map_of_mem f hx), ?_⟩
  change levi i * (levi i * x * (levi i)⁻¹) * (levi i)⁻¹ = x
  have hi : levi i * levi i = 1 := Units.ext (levi_square i)
  calc
    _ = (levi i * levi i) * x * (levi i * levi i)⁻¹ := by group
    _ = x := by rw [hi]; simp

/-- The original matrix overgroup is generated by its radical and long Levi. -/
@[expose] def P : Subgroup Matˣ := E ⊔ A

theorem E_le_core : E ≤ P.pCoreIn 2 :=
  le_pCoreIn_of_normalizes E_isPGroup le_sup_left
    (sup_le E.le_normalizer A_normalizes_E)

/-- L is the literal join of the Levi and its radical commutator. -/
theorem L_le_P : L ≤ P := sup_le le_sup_right
  (Subgroup.commutator_le_sup E A)

/-- Even the actual original two-core fails to fix the original commutator
fixed subgroup. This assertion retains a concrete matrix overgroup; it does
not assert the unproved remaining MS hypotheses. -/
theorem original_core_fixed_factor_not_central :
    ¬ ⁅P.pCoreIn 2,L⁆ ⊓ centralizer (L : Set Matˣ) ≤
      centralizer (P.pCoreIn 2 : Set Matˣ) := by
  intro hc
  have hh : h ∈ ⁅P.pCoreIn 2,L⁆ := commutator_mono E_le_core le_rfl h_mem_Q
  have hx : x ∈ P.pCoreIn 2 := E_le_core (root_mem 13)
  exact h_does_not_commute_x ((hc ⟨hh,h_centralizes_L⟩) x hx).symm
end Theory.SpecificGroups.LieType.F4LongParabolic.BinaryCoordinates
