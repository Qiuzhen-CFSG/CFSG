/-!
# The binary long-A2 radical and its original two-core action

The 21 positive radical matrices strictly raise a fixed integral grading,
so E is a two-group. Explicit conjugation words show that all four signed
long-A2 generators normalize E. Thus E lies in the actual two-core of
P = E join A. The previously checked element h of [E,L] centralizes L but
is moved by E; it consequently gives a noncentral fixed element of
[O2(P),L] as well. All subgroups and actions retain these original matrices.

This removes the two-group and normalization premises from the concrete
diagnostic. It does not identify E with all of O2(P), or certify the remaining
MS hypotheses. The source-boundary application is in MS93.OriginalAction.

Source: the F4 Geck coordinates of A02ParabolicSections.SourceLevi.F4,
GLS3 1.12 and 2.6; the original action distinction in Aschbacher--Smith
C.1.34(4), printed pp.136--137, and MS93's F4 examples, printed p.831.
-/
public section
set_option linter.unusedSimpArgs false
open Subgroup Thompson.BinaryMatrix
namespace Theory.SpecificGroups.LieType.F4LongParabolic.BinaryCoordinates
open Theory.GroupTheory.GradedMatrixTwoGroup

private def degree : Fin 52 → ℤ := ![0, 0, 0, 0, -8, 8, -3, 3, -2, 2, -1, 1, -11, -5, 5, 11, -10, -6, 6, 10, -9, -7, 7, 9, -5, -1, 1, 5, -4, -2, 2, 4, -3, -1, 1, 3, -7, -6, -5, -4, -4, -3, -2, -1, 1, 2, 3, 4, 4, 5, 6, 7]

private theorem root_raises (r : Fin 21) : Raises degree ((root r).val - 1) := by
  change ∀ i j : Fin 52, degree i ≤ degree j →
    bit (rootRows r)[i.val]! j.val - (1 : Mat) i j = 0
  fin_cases r <;> decide +kernel

/-- The 21 radical generators form a two-group by their positive grading. -/
theorem E_isPGroup : IsPGroup 2 E := by
  apply closure_isPGroup degree
  rintro _ ⟨i, rfl⟩
  exact root_raises i

private theorem decode_product_eq (a b c d : Array ℕ)
    (h : ∀ i : Fin 52, rowProduct a[i.val]! b 52 = rowProduct c[i.val]! d 52) :
    decode 52 a * decode 52 b = decode 52 c * decode 52 d := by
  ext i j
  change (∑ k : Fin 52, bit a[i.val]! k.val * bit b[k.val]! j.val) =
    ∑ k : Fin 52, bit c[i.val]! k.val * bit d[k.val]! j.val
  rw [Fin.sum_univ_eq_sum_range (fun k => bit a[i.val]! k * bit b[k]! j.val),
    Fin.sum_univ_eq_sum_range (fun k => bit c[i.val]! k * bit d[k]! j.val),
    ← bit_rowProduct, ← bit_rowProduct, h i]

