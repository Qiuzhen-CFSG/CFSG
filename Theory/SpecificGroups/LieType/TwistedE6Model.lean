module

public import Theory.SpecificGroups.LieType.TwistedE6GraphField
public import Theory.SpecificGroups.LieType.TwistedE6SplitCarrier
public import Theory.GroupTheory.PrimePowerGenerated
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.Algebra.IsPrimePow

/-!
# The finite twisted E6 carrier

For `q = p^(m+1)`, use the integral E6 Chevalley root curves over `GF(q²)`.
The specified pinned diagram involution commutes with entrywise q-Frobenius;
their composite restricts to an involution of the all-root generated group.
Inside its fixed points take the subgroup generated by p-elements, then divide
by its own center. These steps keep the elementary and central-quotient
conventions explicit, rather than retaining diagonal automorphisms of the
full rational adjoint group. All prime powers, including q = 2, are allowed.

The proof of stability uses equality with the simple-root generated group
and functoriality of integral polynomial root curves. The graph action and
its signed Tits-word transport are constructed in `TwistedE6SplitCarrier`.

Sources: GLS3 §§2.1–2.3, especially standard form 2.2.3, the root-group
construction in Remarks 2.2.5, and the central-quotient convention of 2.2.6
(`refs/KGroup/GLS3/chapter2.tex`). Theorem 2.2.7 has no twisted E6 exception.
This module constructs the carrier and its finite group structure; order and
simplicity are separate results.
-/

@[expose] public section
noncomputable section

namespace TwistedE6

open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction

variable (p : ℕ) [Fact p.Prime] (m : ℕ)

/-- The concrete split E6 root-generated subgroup over the quadratic field. -/
abbrev rootGeneratedSubgroup : Subgroup (AmbientGroup p m) :=
  splitCarrier (CoefficientField p m)

/-- Coefficient Frobenius preserves the all-root generated carrier. -/
theorem ambientFieldTwist_mem {g : AmbientGroup p m}
    (hg : g ∈ rootGeneratedSubgroup p m) :
    ambientFieldTwist p m g ∈ rootGeneratedSubgroup p m := by
  change g ∈ splitCarrier (CoefficientField p m) at hg
  change ambientFieldTwist p m g ∈ splitCarrier (CoefficientField p m)
  rw [splitCarrier_eq_simple] at hg ⊢
  exact (RootPairing.SimpleGeckGroup.simpleFamily (b := Base)).mapUnits_mem
    (fieldTwist p m).toRingHom hg

/-- q-Frobenius restricted to the split E6 group. -/
def splitFieldTwist : rootGeneratedSubgroup p m ≃* rootGeneratedSubgroup p m where
  toFun g := ⟨ambientFieldTwist p m g, ambientFieldTwist_mem p m g.property⟩
  invFun g := ⟨ambientFieldTwist p m g, ambientFieldTwist_mem p m g.property⟩
  left_inv g := Subtype.ext (ambientFieldTwist_twice p m g)
  right_inv g := Subtype.ext (ambientFieldTwist_twice p m g)
  map_mul' g h := Subtype.ext ((ambientFieldTwist p m).map_mul g h)

@[simp] theorem splitFieldTwist_val (g : rootGeneratedSubgroup p m) :
    (splitFieldTwist p m g).val = ambientFieldTwist p m g.val := rfl

@[simp] theorem splitFieldTwist_twice (g : rootGeneratedSubgroup p m) :
    splitFieldTwist p m (splitFieldTwist p m g) = g :=
  Subtype.ext (ambientFieldTwist_twice p m g)

theorem splitDiagram_field_commute (g : rootGeneratedSubgroup p m) :
    pinnedDiagram (CoefficientField p m) (splitFieldTwist p m g) =
      splitFieldTwist p m (pinnedDiagram (CoefficientField p m) g) :=
  Subtype.ext (ambientDiagram_field_commute p m g)

/-- The actual pinned graph–field automorphism of the E6 root-generated group. -/
def graphFieldTwist : rootGeneratedSubgroup p m ≃* rootGeneratedSubgroup p m :=
  (splitFieldTwist p m).trans (pinnedDiagram (CoefficientField p m))

@[simp] theorem graphFieldTwist_val (g : rootGeneratedSubgroup p m) :
    (graphFieldTwist p m g).val = ambientGraphFieldTwist p m g.val := rfl

@[simp] theorem graphFieldTwist_twice (g : rootGeneratedSubgroup p m) :
    graphFieldTwist p m (graphFieldTwist p m g) = g :=
  Subtype.ext (ambientGraphFieldTwist_twice p m g)

private theorem field_positive (i : Base.support) (t : CoefficientField p m) :
    ambientFieldTwist p m (RootPairing.SimpleGeckGroup.positiveUnit i t) =
      RootPairing.SimpleGeckGroup.positiveUnit i (fieldTwist p m t) :=
  (RootPairing.SimpleGeckGroup.simpleFamily (b := Base)).mapUnits_unit
    (fieldTwist p m).toRingHom (true, i) t

private theorem field_negative (i : Base.support) (t : CoefficientField p m) :
    ambientFieldTwist p m (RootPairing.SimpleGeckGroup.negativeUnit i t) =
      RootPairing.SimpleGeckGroup.negativeUnit i (fieldTwist p m t) :=
  (RootPairing.SimpleGeckGroup.simpleFamily (b := Base)).mapUnits_unit
    (fieldTwist p m).toRingHom (false, i) t

/-- The positive simple pinning is permuted and its parameter raised to q. -/
@[simp] theorem graphFieldTwist_positive (i : Base.support) (t : CoefficientField p m) :
    graphFieldTwist p m (rootElement (CoefficientField p m) i t) =
      rootElement (CoefficientField p m) (typeE6DiagramBasePermutation i)
        (t ^ parameter p m) := by
  apply Subtype.ext
  change typeE6PinnedUnitsEquiv _
    (ambientFieldTwist p m (rootCurveUnit
      (integralChevalleyRootOperators (P := Pairing) (b := Base)) i t)) =
    rootCurveUnit (integralChevalleyRootOperators (P := Pairing) (b := Base)) _ _
  rw [rootCurveUnit_simple, rootCurveUnit_simple, field_positive,
    typeE6Pinned_positiveUnit, fieldTwist_apply]

/-- The negative simple pinning obeys the same graph–field formula. -/
@[simp] theorem graphFieldTwist_negative (i : Base.support) (t : CoefficientField p m) :
    let := Pairing.indexNeg
    graphFieldTwist p m (rootElement (CoefficientField p m) (-i : typeE6Roots) t) =
      rootElement (CoefficientField p m) (-(typeE6DiagramBasePermutation i) : typeE6Roots)
        (t ^ parameter p m) := by
  let := Pairing.indexNeg
  apply Subtype.ext
  change typeE6PinnedUnitsEquiv _
    (ambientFieldTwist p m (rootCurveUnit
      (integralChevalleyRootOperators (P := Pairing) (b := Base)) (-i : typeE6Roots) t)) =
    rootCurveUnit (integralChevalleyRootOperators (P := Pairing) (b := Base)) _ _
  rw [rootCurveUnit_neg_simple, rootCurveUnit_neg_simple, field_negative,
    typeE6Pinned_negativeUnit, fieldTwist_apply]

/-- The graph–field involution is nontrivial, including at q = 2. -/
theorem graphFieldTwist_moves_positive_zero :
    graphFieldTwist p m
      (rootElement (CoefficientField p m) (typeE6RootPairing_baseEquiv 0) 1) ≠
      rootElement (CoefficientField p m) (typeE6RootPairing_baseEquiv 0) 1 := by
  simpa only [graphFieldTwist_positive, one_pow, pinnedDiagram_positive] using
    pinnedDiagram_moves_positive_zero (CoefficientField p m)

theorem graphFieldTwist_ne_one : graphFieldTwist p m ≠ 1 := by
  intro h
  apply graphFieldTwist_moves_positive_zero p m
  rw [h]
  rfl

/-- Graph–field fixed points, with membership in the E6 group imposed. -/
def rationalFixedSubgroup : Subgroup (AmbientGroup p m) :=
  rootGeneratedSubgroup p m ⊓ ambientFixedSubgroup p m

theorem mem_rationalFixedSubgroup (g : AmbientGroup p m) :
    g ∈ rationalFixedSubgroup p m ↔
      g ∈ rootGeneratedSubgroup p m ∧ ambientGraphFieldTwist p m g = g := Iff.rfl

/-- Fixed points can equivalently be taken after restricting the automorphism. -/
theorem mem_rationalFixedSubgroup_iff (g : rootGeneratedSubgroup p m) :
    g.val ∈ rationalFixedSubgroup p m ↔ graphFieldTwist p m g = g := by
  rw [mem_rationalFixedSubgroup]
  exact ⟨fun h => Subtype.ext h.2,
    fun h => ⟨g.property, congrArg Subtype.val h⟩⟩

/-- Entrywise equations for the fixed points of the actual E6 root group. -/
theorem mem_rationalFixedSubgroup_iff_entries (g : AmbientGroup p m) :
    g ∈ rationalFixedSubgroup p m ↔ g ∈ rootGeneratedSubgroup p m ∧
      ∀ i j : typeE6PinnedIndex,
        ((g : Matrix _ _ (CoefficientField p m))
          (typeE6PinnedIndexEquiv i) (typeE6PinnedIndexEquiv j)) ^ parameter p m =
            (g : Matrix _ _ (CoefficientField p m)) i j := by
  rw [mem_rationalFixedSubgroup, ambientGraphFieldTwist_eq_self_iff]
  simp only [fieldTwist_apply]

/-- The subgroup generated by the characteristic-prime elements of the fixed
group, namely O^{p′}, rather than the residual with p-group quotient. -/
def definingCharacteristicSubgroup : Subgroup (rationalFixedSubgroup p m) :=
  Subgroup.primePowerGenerated p (rationalFixedSubgroup p m)

theorem definingCharacteristicSubgroup_eq_closure_orderOf :
    definingCharacteristicSubgroup p m =
      Subgroup.closure {g : rationalFixedSubgroup p m | ∃ n : ℕ, orderOf g = p ^ n} :=
  Subgroup.primePowerGenerated_eq_closure_orderOf p

/-- The central-quotient version of the twisted E6 construction. -/
def Model : Type :=
  definingCharacteristicSubgroup p m ⧸
    Subgroup.center (definingCharacteristicSubgroup p m)

instance modelGroup : Group (Model p m) := by
  unfold Model
  infer_instance

instance modelFinite : Finite (Model p m) := by
  unfold Model
  infer_instance

/-- The canonical central quotient map. -/
def toModel : definingCharacteristicSubgroup p m →* Model p m :=
  QuotientGroup.mk' _

theorem toModel_surjective : Function.Surjective (toModel p m) :=
  QuotientGroup.mk'_surjective _

theorem toModel_ker :
    (toModel p m).ker = Subgroup.center (definingCharacteristicSubgroup p m) :=
  QuotientGroup.ker_mk' _

@[simp] theorem toModel_eq_one (g : definingCharacteristicSubgroup p m) :
    toModel p m g = 1 ↔ g ∈ Subgroup.center (definingCharacteristicSubgroup p m) :=
  QuotientGroup.eq_one_iff g

theorem model_primePowerGenerated :
    Subgroup.primePowerGenerated p (Model p m) = ⊤ :=
  Subgroup.primePowerGenerated_eq_top_of_surjective p (toModel p m)
    (toModel_surjective p m) (Subgroup.primePowerGenerated_self p)

theorem parameter_isPrimePow : IsPrimePow (parameter p m) :=
  (isPrimePow_nat_iff _).mpr ⟨p, m + 1, Fact.out, Nat.succ_pos m, rfl⟩

/-- Every finite-field order occurs among the parameters of this construction. -/
theorem exists_parameter (q : ℕ) (hq : IsPrimePow q) :
    ∃ p m : ℕ, p.Prime ∧ parameter p m = q := by
  obtain ⟨p, f, hp, hf, hq⟩ := (isPrimePow_nat_iff q).mp hq
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hf)
  exact ⟨p, m, hp, hq⟩

end TwistedE6
