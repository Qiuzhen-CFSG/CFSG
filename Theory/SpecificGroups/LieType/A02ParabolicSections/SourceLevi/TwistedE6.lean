module
public import Theory.SpecificGroups.LieType.A02ParabolicSections.SourceLevi.E6
public import Theory.SpecificGroups.LieType.A02ParabolicSections.SourceLevi.RankOne
public import Theory.SpecificGroups.LieType.TheoremDRootNormalizer.TwistedE6.Roots

/-!
# The actual binary symplectic section of twisted E6

The existing folded root curves belong to the actual subgroup generated by
two-elements in the pinned graph-field fixed group. Their faithful inclusion
into the split root group transports the checked Sp6(2) relations and the
centralizing root word. At each fixed simple node, the rank-one involution
braid detects noncentrality after quotienting by this subgroup's own center.

Thus the first symplectic generator survives that exact quotient and the
specified conjugate root involution has a proper normalizer containing the
faithful symplectic image. Every parameter q = 2^(m+1), including q=2, is
covered without a full-fixed-group identification or an assumed Levi section.

Sources: GLS3 §§1.12, 2.2–2.4, 2.6; Aschbacher–Smith A.2.18, printed p.40.
-/

@[expose] public section
noncomputable section
namespace Theory.SpecificGroups.LieType.SourceLevi.Twisted
open Theory.AlgebraicGroup.StandardRootSystem
open _root_.TwistedE6 _root_.TwistedE6.TheoremDRootNormalizer
open RootPairing.IntegralGeckConstruction
attribute [local instance] Classical.decEq
local instance : Fintype typeE6Roots := Fintype.ofFinite _
local instance : InvolutiveNeg typeE6Roots := typeE6RootPairing.indexNeg

abbrev Cover (m : ℕ) := definingCharacteristicSubgroup 2 m
abbrev Split (m : ℕ) := ExceptionalSplit.rootGenerated typeE6RootPairing
  typeE6RootPairing_base (CoefficientField 2 m)

def splitInclusion (m : ℕ) : Cover m →* Split m where
  toFun x := ⟨ambientInclusion m x, by
    exact ((mem_rationalFixedSubgroup 2 m _).mp x.val.property).1⟩
  map_one' := Subtype.ext (map_one (ambientInclusion m))
  map_mul' x y := Subtype.ext (map_mul (ambientInclusion m) x y)

theorem splitInclusion_injective (m : ℕ) : Function.Injective (splitInclusion m) := by
  intro x y h
  exact ambientInclusion_injective m (congrArg (fun z : Split m => z.val) h)

/-- The source's four diagram orbits in the order used by the Sp6 presentation. -/
def generator (m : ℕ) : Fin 8 → Cover m :=
  ![foldedRoot m true 3 1, foldedRoot m false 3 1,
    foldedRoot m true 2 1, foldedRoot m false 2 1,
    foldedRoot m true 1 1, foldedRoot m false 1 1,
    foldedRoot m true 0 1, foldedRoot m false 0 1]

theorem splitInclusion_generator (m : ℕ) (j : Fin 8) :
    splitInclusion m (generator m j) = E6.generator (CoefficientField 2 m) j := by
  fin_cases j <;> rfl

def a (m : ℕ) : Cover m := generator m 2
def b (m : ℕ) : Cover m := (E6.WordCertificates.bWord.map (generator m)).prod
def w (m : ℕ) : Cover m := (E6.WordCertificates.wWord.map (generator m)).prod
def z (m : ℕ) : Cover m := w m * generator m 0 * (w m)⁻¹

private theorem splitInclusion_a (m : ℕ) :
    splitInclusion m (a m) = E6.a (CoefficientField 2 m) := splitInclusion_generator m 2

private theorem splitInclusion_b (m : ℕ) :
    splitInclusion m (b m) = E6.b (CoefficientField 2 m) := by
  simp only [b, E6.b, map_list_prod, List.map_map]
  congr 1

private theorem splitInclusion_w (m : ℕ) :
    splitInclusion m (w m) = E6.w (CoefficientField 2 m) := by
  simp only [w, E6.w, map_list_prod, List.map_map]
  congr 1

private theorem splitInclusion_z (m : ℕ) :
    splitInclusion m (z m) = E6.z (CoefficientField 2 m) := by
  simp only [z, E6.z, map_mul, map_inv, splitInclusion_w, splitInclusion_generator]

open SymplecticSix.UniversalDoubleCover

theorem relators (m : ℕ) (i : Fin 7) : KernelPresentation.word (a m) (b m) i = 1 := by
  apply splitInclusion_injective m
  rw [KernelPresentation.map_word, splitInclusion_a, splitInclusion_b, E6.relators, map_one]

theorem commute_a_z (m : ℕ) : Commute (a m) (z m) := by
  apply splitInclusion_injective m
  simp only [map_mul, splitInclusion_a, splitInclusion_z]
  exact E6.commute_a_z (CoefficientField 2 m)

theorem commute_b_z (m : ℕ) : Commute (b m) (z m) := by
  apply splitInclusion_injective m
  simp only [map_mul, splitInclusion_b, splitInclusion_z]
  exact E6.commute_b_z (CoefficientField 2 m)

private theorem generator_square (m : ℕ) (j : Fin 8) : generator m j ^ 2 = 1 := by
  have h (s : Bool) (i : Fin 4) : foldedRoot m s i 1 ^ 2 = 1 :=
    Subtype.ext (foldedFixed_square m s i 1)
  fin_cases j <;> simp only [generator, Matrix.cons_val, Fin.reduceFinMk]
  · exact h true 3
  · exact h false 3
  · exact h true 2
  · exact h false 2
  · exact h true 1
  · exact h false 1
  · exact h true 0
  · exact h false 0

private theorem generator_zero_braid (m : ℕ) :
    generator m 0 * generator m 1 * generator m 0 =
      generator m 1 * generator m 0 * generator m 1 := by
  apply splitInclusion_injective m
  simpa only [map_mul, splitInclusion_generator] using
    E6.generator_zero_braid (CoefficientField 2 m)

private theorem generator_two_braid (m : ℕ) :
    generator m 2 * generator m 3 * generator m 2 =
      generator m 3 * generator m 2 * generator m 3 := by
  apply splitInclusion_injective m
  simpa only [map_mul, splitInclusion_generator] using
    E6.generator_two_braid (CoefficientField 2 m)

private theorem generator_zero_distinct (m : ℕ) : generator m 0 ≠ generator m 1 := by
  intro h
  apply E6.generator_zero_distinct (CoefficientField 2 m)
  simpa only [splitInclusion_generator] using congrArg (splitInclusion m) h

private theorem generator_two_distinct (m : ℕ) : generator m 2 ≠ generator m 3 := by
  intro h
  apply E6.generator_two_distinct (CoefficientField 2 m)
  simpa only [splitInclusion_generator] using congrArg (splitInclusion m) h

def modelA (m : ℕ) : Model 2 m := toModel 2 m (a m)
def modelB (m : ℕ) : Model 2 m := toModel 2 m (b m)
def modelZ (m : ℕ) : Model 2 m := toModel 2 m (z m)

theorem modelA_ne_one (m : ℕ) : modelA m ≠ 1 :=
  RankOne.image_ne_one
    (by simpa only [a, pow_two] using generator_square m 2)
    (by simpa only [pow_two] using generator_square m 3)
    (generator_two_braid m) (generator_two_distinct m)

theorem modelZ_not_mem_center (m : ℕ) : modelZ m ∉ Subgroup.center (Model 2 m) := by
  have h0 : toModel 2 m (generator m 0) ∉ Subgroup.center (Model 2 m) :=
    RankOne.image_not_mem_center
      (by simpa only [pow_two] using generator_square m 0)
      (by simpa only [pow_two] using generator_square m 1)
      (generator_zero_braid m) (generator_zero_distinct m)
  intro hc
  have h := (inferInstance : (Subgroup.center (Model 2 m)).Normal).conj_mem'
    (modelZ m) hc (toModel 2 m (w m))
  have he : (toModel 2 m (w m))⁻¹ * modelZ m * toModel 2 m (w m) =
      toModel 2 m (generator m 0) := by
    simp only [modelZ, z, map_mul, map_inv]
    group
  exact h0 (he ▸ h)

theorem modelZ_order (m : ℕ) : orderOf (modelZ m) = 2 := by
  apply orderOf_eq_prime_iff.mpr
  constructor
  · have hz : z m ^ 2 = 1 := by
      rw [z, conj_pow, generator_square]
      group
    exact (map_pow (toModel 2 m) (z m) 2).symm.trans
      ((congrArg (toModel 2 m) hz).trans (map_one _))
  · intro h
    exact modelZ_not_mem_center m (h ▸ (Subgroup.center _).one_mem)

/-- The binary symplectic section in the actual twisted E6 central quotient,
inside a proper involution centralizer, for every parameter including q=2. -/
def normalizerSection (m : ℕ) : NormalizerSection (Model 2 m) (SymplecticSix.PSp (ZMod 2)) :=
  Sp6Presentation.normalizerSection (modelA m) (modelB m) (modelZ m)
    (fun i => by
      change KernelPresentation.word (toModel 2 m (a m)) (toModel 2 m (b m)) i = 1
      rw [← KernelPresentation.map_word, relators, map_one])
    (modelA_ne_one m) (modelZ_order m) (modelZ_not_mem_center m)
    ((commute_a_z m).map (toModel 2 m)) ((commute_b_z m).map (toModel 2 m))

theorem normalizerSection_twoSubgroup (m : ℕ) :
    (normalizerSection m).twoSubgroup = Subgroup.zpowers (modelZ m) :=
  Sp6Presentation.normalizerSection_twoSubgroup _ _ _ _ _ _ _ _ _

end Theory.SpecificGroups.LieType.SourceLevi.Twisted
end
