module

public import Theory.SpecificGroups.LieType.ExceptionalSplit.RootGeneration
public import Theory.GroupTheory.PResidual.PrimeTo
public import Theory.SpecificGroups.SymplecticSix.ThreeRank
public import Theory.Quasithin.Rank

/-!
# The literal F₄ fundamental root-pair carrier

For the finite split carrier, the fundamental rank-one candidate is the
subgroup generated by the two opposite Chevalley root curves.  This file
records that subgroup and the source's literal `O^{p'}` residual of its
centralizer.  The rank obstruction is proved for an actual embedding into
that residual; constructing the rank-one `SL₂` map and identifying the
residual with `Sp₆` are separate structural inputs.

The carrier is the central quotient `ExceptionalSplit.F4 F`, so all
centralizers below are taken in that concrete quotient.  In particular, the
residual uses `Subgroup.primeToResidual`, as in Aschbacher--Smith A.2.17.
-/

@[expose] public section
noncomputable section

namespace ExceptionalSplit

open RootPairing.IntegralGeckConstruction
open Theory.AlgebraicGroup.StandardRootSystem

attribute [local instance] Classical.decEq
local instance f4OddFundamentalRootsFintype : Fintype typeF4Roots := Fintype.ofFinite _

variable {F : Type*} [Field F]

local instance f4OddFundamentalRootsInvolutiveNeg : InvolutiveNeg typeF4Roots := typeF4RootPairing.indexNeg

/-- The subgroup generated by the two opposite root curves at a fundamental
root.  This is the literal carrier used for a fundamental rank-one subgroup;
no abstract `SL₂` identification is built into the definition. -/
public def f4FundamentalRootPair (i : typeF4RootPairing_base.support) :
    Subgroup (F4 F) :=
  Subgroup.closure
    (Set.range (rootElement typeF4RootPairing typeF4RootPairing_base F i) ∪
      Set.range (fun t : F =>
        rootElement typeF4RootPairing typeF4RootPairing_base F (-i : typeF4Roots) t))

public theorem f4FundamentalRootPair_mem (i : typeF4RootPairing_base.support)
    (t : F) : rootElement typeF4RootPairing typeF4RootPairing_base F i t ∈
      f4FundamentalRootPair (F := F) i := by
  exact Subgroup.subset_closure (Set.mem_union_left _ ⟨t, rfl⟩)

public theorem f4FundamentalRootPair_neg_mem
    (i : typeF4RootPairing_base.support) (t : F) :
    rootElement typeF4RootPairing typeF4RootPairing_base F (-i : typeF4Roots) t ∈
      f4FundamentalRootPair (F := F) i := by
  exact Subgroup.subset_closure (Set.mem_union_right _ ⟨t, rfl⟩)

/-- The literal complementary residual centralizer from A.2.17. -/
public abbrev f4FundamentalCentralizer
    (i : typeF4RootPairing_base.support) : Subgroup (F4 F) :=
  Subgroup.centralizer (f4FundamentalRootPair (F := F) i : Set (F4 F))

public def f4FundamentalResidual (p : ℕ)
    (i : typeF4RootPairing_base.support) :
    Subgroup (f4FundamentalCentralizer (F := F) i) :=
  Subgroup.primeToResidual p
    (f4FundamentalCentralizer (F := F) i)

end ExceptionalSplit

namespace ExceptionalSplit.F4OddFundamentalCentralizer

open Theory.AlgebraicGroup.StandardRootSystem

variable {F : Type*} [Field F] [Finite F]

/-- An actual `Sp₆(F)` embedding into the literal residual centralizer is
incompatible with the source bound `m₃ ≤ 1`.  The embedding is an explicit
argument so that the eventual centralizer construction must discharge this
premise rather than hide it in a record or an order comparison. -/
public theorem no_three_rank_one_residual
    (p : ℕ) (i : typeF4RootPairing_base.support)
    (hrank : primeRank 3
      (ExceptionalSplit.f4FundamentalResidual (F := F) p i) ≤ 1)
    (f : Matrix.symplecticGroup (Fin 3) F →*
      ExceptionalSplit.f4FundamentalResidual (F := F) p i)
    (hf : Function.Injective f) : False := by
  have hthree := Theory.SpecificGroups.SymplecticSix.ThreeRank.three_le_primeRank
    (F := F)
  have hmap := primeRank_le_of_injective 3 f hf
  omega

end ExceptionalSplit.F4OddFundamentalCentralizer

end
