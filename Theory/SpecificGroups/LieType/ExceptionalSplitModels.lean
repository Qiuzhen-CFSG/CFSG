module

public import Theory.AlgebraicGroup.Borel.IntegralChevalleyRootCurves
public import Theory.AlgebraicGroup.RootSystems.F4RootPairing
public import Theory.AlgebraicGroup.RootSystems.TypeE6RootPairing
public import Theory.AlgebraicGroup.RootSystems.E7RootPairing
public import Theory.AlgebraicGroup.RootSystems.TypeE8RootPairing
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.Subgroup.Center

/-!
# Split exceptional finite Chevalley groups

`F4 F`, `E6 F`, `E7 F`, and `E8 F` are constructed from the standard
root pairings and their specified bases.  On the integral adjoint Chevalley
lattice (simple-coroot coordinates plus root coordinates), specialize each
root's divided-power exponential to `F`, generate the matrix subgroup, and
quotient by its center.  Finiteness follows from the finite matrix ring when
`F` is finite.  The root elements and the central projection are exposed for
subsequent structural arguments.

This is the elementary root-generated group over `F`; taking all rational
points of an adjoint algebraic group instead could adjoin diagonal outer
automorphisms.  The central quotient uses the simple-group convention rather
than a simply connected central cover.  The integral construction imposes no
restriction on the characteristic, including 2 and 3.  In these four families
every finite field order is in the simple parameter range; no order or
simplicity theorem is asserted by this construction module.

Sources: Steinberg, *Lectures on Chevalley Groups*, Sections 1 and 3
(the admissible-lattice construction); GLS3, Remark 2.2.5(f), Theorems
2.2.6 and 2.2.7, and Definition 2.2.8 (`refs/KGroup/GLS3/chapter2.tex`).
-/

@[expose] public section

noncomputable section

namespace ExceptionalSplit

open RootPairing.IntegralGeckConstruction
open Theory.AlgebraicGroup.StandardRootSystem

section Construction

variable {ι R M N : Type*} [Field R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) [Fintype ι] [DecidableEq ι]
  (F : Type*) [Field F]

/-- The elementary adjoint matrix subgroup generated by all root parameters. -/
def rootGenerated : Subgroup (Matrix (b.support ⊕ ι) (b.support ⊕ ι) F)ˣ :=
  Subgroup.closure (Set.range fun rt : ι × F =>
    rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) rt.1 rt.2)

/-- Every specialized integral root element belongs to the generated group. -/
theorem root_mem (r : ι) (t : F) :
    rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) r t ∈
      rootGenerated P b F :=
  Subgroup.subset_closure ⟨(r, t), rfl⟩

/-- The generated subgroup is contained in exactly those subgroups containing
all its Chevalley root elements. -/
theorem rootGenerated_le_iff
    (H : Subgroup (Matrix (b.support ⊕ ι) (b.support ⊕ ι) F)ˣ) :
    rootGenerated P b F ≤ H ↔
      ∀ r t, rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) r t ∈ H := by
  rw [rootGenerated, Subgroup.closure_le]
  constructor
  · intro h r t
    exact h ⟨(r, t), rfl⟩
  · rintro h _ ⟨⟨r, t⟩, rfl⟩
    exact h r t

/-- A root element in the elementary matrix group, before taking its center quotient. -/
def elementaryRoot (r : ι) (t : F) : rootGenerated P b F :=
  ⟨rootCurveUnit (integralChevalleyRootOperators (P := P) (b := b)) r t,
    root_mem P b F r t⟩

@[simp] theorem elementaryRoot_zero (r : ι) : elementaryRoot P b F r 0 = 1 := by
  apply Subtype.ext
  exact rootCurveUnit_zero _ _

theorem elementaryRoot_add (r : ι) (s t : F) :
    elementaryRoot P b F r (s + t) =
      elementaryRoot P b F r s * elementaryRoot P b F r t := by
  apply Subtype.ext
  exact rootCurveUnit_add _ _ _ _

/-- The central quotient of the elementary adjoint matrix group. -/
abbrev Model := rootGenerated P b F ⧸ Subgroup.center (rootGenerated P b F)

instance modelGroup : Group (Model P b F) := inferInstance

instance modelFinite [Finite F] : Finite (Model P b F) := by
  infer_instance

/-- The canonical central quotient map from the concrete matrix group. -/
def projection : rootGenerated P b F →* Model P b F :=
  QuotientGroup.mk' (Subgroup.center (rootGenerated P b F))

theorem projection_surjective : Function.Surjective (projection P b F) :=
  QuotientGroup.mk'_surjective _

/-- The projection kills precisely the center of the elementary matrix group. -/
@[simp] theorem projection_eq_one_iff (g : rootGenerated P b F) :
    projection P b F g = 1 ↔ g ∈ Subgroup.center (rootGenerated P b F) :=
  QuotientGroup.eq_one_iff g

/-- The image of a Chevalley root element in the central quotient. -/
def rootElement (r : ι) (t : F) : Model P b F :=
  projection P b F (elementaryRoot P b F r t)

@[simp] theorem rootElement_zero (r : ι) : rootElement P b F r 0 = 1 := by
  simp [rootElement]

theorem rootElement_add (r : ι) (s t : F) :
    rootElement P b F r (s + t) = rootElement P b F r s * rootElement P b F r t := by
  simp only [rootElement, elementaryRoot_add, map_mul]

end Construction

attribute [local instance] Classical.decEq

local instance : Fintype typeF4Roots := Fintype.ofFinite _
local instance : Fintype typeE6Roots := Fintype.ofFinite _
local instance : Fintype typeE7Roots := Fintype.ofFinite _
local instance : Fintype typeE8Roots := Fintype.ofFinite _

/-- The split group F₄ over F, in the central-quotient convention. -/
abbrev F4 (F : Type*) [Field F] := Model typeF4RootPairing typeF4RootPairing_base F

/-- The split group E₆ over F, in the central-quotient convention. -/
abbrev E6 (F : Type*) [Field F] := Model typeE6RootPairing typeE6RootPairing_base F

/-- The split group E₇ over F, in the central-quotient convention. -/
abbrev E7 (F : Type*) [Field F] := Model typeE7RootPairing typeE7RootPairing_base F

/-- The split group E₈ over F, in the central-quotient convention. -/
abbrev E8 (F : Type*) [Field F] := Model typeE8RootPairing typeE8RootPairing_base F


end ExceptionalSplit
