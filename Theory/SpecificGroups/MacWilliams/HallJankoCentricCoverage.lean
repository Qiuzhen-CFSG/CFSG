/-!
# Maximal-child coverage of the Hall–Janko centric nodes

Every maximal subgroup of a node has relative index two. Its membership on
that node's four generators is a nonzero binary signature, and Schreier's
lemma reconstructs it using the least true bit as transversal pivot.

For all 142 nodes and all 15 nonzero signatures, explicit positive words
identify the branch with a listed node, or generator transitions certify a
containing mask that excludes an element centralizing every branch generator.
The latter branch cannot be centric. All finite equations are kernel checked;
only noncentricity prunes descent, including below nodes with Frattini witnesses.

The eight branch generators are ordered false × Fin 4, then true × Fin 4.
A displayed code `⟨1⟩` is coordinate one; the group identity has coordinate zero.

Source: the presentation in `SylowPresentations`; Janko–Thompson, Math. Z.
113 (1970), Theorem 1.4, p.386 and application p.395; MacWilliams,
Trans. AMS 150 (1970), DOI 10.1090/S0002-9947-1970-0276324-3.
-/

open Theory.GroupTheory.SubgroupEnumeration
namespace MacWilliamsSylow.HallJankoCoordinates.CentricCensus
set_option maxRecDepth 10000
private def signature (k : Fin 15) (a : Fin 4) : Bool := (k.val + 1).testBit a.val
private def pivot : Fin 15 → Fin 4 := ![0,1,0,2,0,1,0,3,0,1,0,2,0,1,0]
private def encode (a : Fin 8) : Bool × Fin 4 := (decide (4 ≤ a.val), ⟨a.val % 4, Nat.mod_lt _ (by decide)⟩)
private theorem encode_surj : Function.Surjective encode := by decide +kernel
private def branch (i : Fin 142) (k : Fin 15) : Fin 8 → Code :=
  binarySchreierGenerator (generators i) (generators i (pivot k)) (signature k) ∘ encode
private theorem branch_range (i : Fin 142) (k : Fin 15) :
    Set.range (branch i k) = Set.range (binarySchreierGenerator (generators i) (generators i (pivot k)) (signature k)) :=
  encode_surj.range_comp _
private theorem signature_complete : ∀ σ : Fin 4 → Bool, (∃ j, σ j = true) → ∃ k, σ = signature k := by decide +kernel
private theorem pivot_true : ∀ k, signature k (pivot k) = true := by decide +kernel
private inductive Certificate where
  | listed (j : Fin 142) (words : ClosureWords 8 4)
  | excluded (mask : Nat) (c : Code)
private def Certificate.Valid (s : Fin 8 → Code) : Certificate → Prop
  | .listed j words => words.Valid s (generators j) (MonoidHom.id Code)
  | .excluded mask c =>
    mask.testBit (1 : Code).toFin.val = true ∧
    (∀ x : Code, mask.testBit x.toFin.val = true → ∀ a : Fin 8,
      mask.testBit (x * s a).toFin.val = true ∧ mask.testBit (x * (s a)⁻¹).toFin.val = true) ∧
    mask.testBit c.toFin.val = false ∧ (∀ a, s a * c = c * s a)
private instance (s : Fin 8 → Code) (cert : Certificate) : Decidable (cert.Valid s) := by
  cases cert <;> unfold Certificate.Valid <;> infer_instance
private theorem Certificate.sound (s : Fin 8 → Code) (cert : Certificate) (hv : cert.Valid s)
    (hcent : Subgroup.centralizer (Subgroup.closure (Set.range s) : Set Code) ≤ Subgroup.closure (Set.range s)) :
    ∃ j, Subgroup.closure (Set.range s) = node j := by
  cases cert with
  | listed j words =>
    refine ⟨j, ?_⟩
    simpa only [Subgroup.map_id, node] using words.sound s (generators j) (MonoidHom.id Code) hv
  | excluded mask c =>
    obtain ⟨h1, ht, hc, hcomm⟩ := hv
    have hmem : ∀ x ∈ Subgroup.closure (Set.range s), mask.testBit x.toFin.val = true := by
      intro x hx
      apply Subgroup.closure_induction_right (p := fun x _ => mask.testBit x.toFin.val = true) h1 _ _ hx
      · rintro y _ _ ⟨a, rfl⟩ hy
        exact (ht y hy a).1
      · rintro y _ _ ⟨a, rfl⟩ hy
        exact (ht y hy a).2
    have hcentral : c ∈ Subgroup.centralizer (Subgroup.closure (Set.range s) : Set Code) := by
      rw [Subgroup.centralizer_closure]
      apply Subgroup.mem_centralizer_iff.mpr
      rintro _ ⟨a, rfl⟩
      exact hcomm a
    have := hmem c (hcent hcentral)
    rw [hc] at this
    contradiction
private theorem maximal_branch (i : Fin 142) (H : Subgroup Code) (hmax : H ⋖ node i) :
    ∃ k, Subgroup.closure (Set.range (branch i k)) = H := by
  classical
  have hG : IsPGroup 2 Code := IsPGroup.of_card (n := 7) card
  let σ : Fin 4 → Bool := fun a => decide (generators i a ∉ H)
  have hσ : ∀ a, σ a = true ↔ generators i a ∉ H := fun a => by simp [σ]
  have hn : ∃ a, σ a = true := by
    by_contra hh
    push Not at hh
    have hle : node i ≤ H := by
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨a, rfl⟩
      by_contra ha
      exact hh a ((hσ a).mpr ha)
    exact hmax.lt.not_ge hle
  obtain ⟨k, hk⟩ := signature_complete σ hn
  refine ⟨k, ?_⟩
  rw [branch_range]
  apply binarySchreier_eq_relative hmax.le (relIndex_two_of_covBy hG hmax)
    (generators i) rfl _ (Subgroup.subset_closure ⟨pivot k, rfl⟩)
  · exact (hσ (pivot k)).mp (hk.symm ▸ pivot_true k)
  · intro a
    rw [← hk]
    exact hσ a

