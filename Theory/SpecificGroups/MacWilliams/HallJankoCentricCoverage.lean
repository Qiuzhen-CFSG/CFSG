/-- Every centric maximal child of a census node is exactly a listed node. -/
public theorem maximal_coverage (i : Fin 142) (H : Subgroup Code)
    (hmax : H ⋖ node i) (hcent : Subgroup.centralizer (H : Set Code) ≤ H) :
    ∃ j : Fin 142, H = node j := by
  obtain ⟨k, hk⟩ := maximal_branch i H hmax
  subst H
  exact branch_coverage i k hcent

