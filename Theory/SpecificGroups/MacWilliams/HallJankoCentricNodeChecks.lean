module

public import Theory.SpecificGroups.MacWilliams.HallJankoCentricNodes
public import Theory.GroupTheory.PGroup.Omega
public import Theory.Frattini.PGroup

/-!
# Local alternatives for the Hall–Janko centric nodes

For each of the 142 fixed census nodes, this module certifies either an outside
normalizer element acting trivially modulo the Frattini subgroup, or one of the
three structural alternatives involving the marked normal four. The 74 outside
witnesses have displacement words consisting of two squares (padded with the
identity). Squares belong to the Frattini subgroup of a finite 2-group.

The other 68 nodes are checked by commuting with their four generators: 49 have
omega-center equal to the marked four, 17 have the ambient center, and two are
elementary abelian of order 16. All finite certificates are kernel checked;
neither census coverage nor an ambient radical hypothesis is used here.

Source: the presentation in `SylowPresentations`; Janko–Thompson, Math. Z.
113 (1970), Theorem 1.4, p.386 and application p.395; MacWilliams,
Trans. AMS 150 (1970), DOI 10.1090/S0002-9947-1970-0276324-3.
-/

namespace MacWilliamsSylow.HallJankoCoordinates.CentricCensus

private def Alternative (U : Subgroup Code) : Prop :=
  (∃ g : Subgroup.normalizer (U : Set Code), (g : Code) ∉ U ∧
    ∀ x : U, x⁻¹ * U.normalizerMonoidHom g x ∈ frattini U) ∨
  (four ≤ U ∧
    ((((omega₁ (Subgroup.center U) (p := 2)).map (Subgroup.center U).subtype).map
          U.subtype = four) ∨
      (Subgroup.center U).map U.subtype = Subgroup.center Code ∨
      (IsElementaryAbelian 2 U ∧ Nat.card U = 16)))

private def centerTest (i : Fin 142) (x : Code) : Prop :=
  x ∈ node i ∧ ∀ j : Fin 4, generators i j * x = x * generators i j

private instance (i : Fin 142) (x : Code) : Decidable (centerTest i x) :=
  inferInstanceAs (Decidable (_ ∧ _))

private theorem center_image_mem (U : Subgroup Code) (x : Code) :
    x ∈ (Subgroup.center U).map U.subtype ↔
      x ∈ U ∧ x ∈ Subgroup.centralizer (U : Set Code) := by
  constructor
  · rintro ⟨z, hz, rfl⟩
    refine ⟨z.property, ?_⟩
    intro y hy
    exact congrArg Subtype.val ((Subgroup.mem_center_iff.mp hz) ⟨y, hy⟩)
  · rintro ⟨hx, hc⟩
    refine ⟨⟨x, hx⟩, Subgroup.mem_center_iff.mpr ?_, rfl⟩
    intro y
    exact Subtype.ext (hc y y.property)

private theorem centerTest_iff (i : Fin 142) (x : Code) :
    centerTest i x ↔ x ∈ (Subgroup.center (node i)).map (node i).subtype := by
  rw [center_image_mem]
  change (_ ∧ _) ↔ (_ ∧ x ∈ Subgroup.centralizer (↑(Subgroup.closure (Set.range (generators i))) : Set Code))
  rw [Subgroup.centralizer_closure]
  simp only [Subgroup.mem_centralizer_iff, Set.forall_mem_range]

private theorem centerTest_zero (x : Code) :
    centerTest 0 x ↔ x ∈ Subgroup.center Code := by
  rw [centerTest_iff, center_image_mem, node_zero]
  simp [Subgroup.mem_centralizer_iff, Subgroup.mem_center_iff]

private theorem omega_image_mem (i : Fin 142) (x : Code) :
    x ∈ (((omega₁ (Subgroup.center (node i)) (p := 2)).map
      (Subgroup.center (node i)).subtype).map (node i).subtype) ↔
      centerTest i x ∧ x ^ 2 = 1 := by
  constructor
  · rintro ⟨y, ⟨z, hz, rfl⟩, rfl⟩
    refine ⟨(centerTest_iff i _).mpr ⟨z.val, z.property, rfl⟩, ?_⟩
    let : IsElementaryAbelian 2 (omega₁ (Subgroup.center (node i)) (p := 2)) :=
      IsElementaryAbelian.omega₁_of_isMulCommutative _
    have h := elemPow_eq_one_of_isElementaryAbelian (p := 2) z hz
    exact congrArg (fun a : Subgroup.center (node i) => ((a : node i) : Code)) h
  · rintro ⟨hc, hp⟩
    obtain ⟨y, hy, rfl⟩ := (centerTest_iff i x).mp hc
    refine ⟨y, ⟨⟨y, hy⟩, ?_, rfl⟩, rfl⟩
    apply Subgroup.subset_closure
    change (⟨y, hy⟩ : Subgroup.center (node i)) ^ (2 ^ 1) = 1
    apply Subtype.ext
    apply Subtype.ext
    simpa using hp

private theorem center_alternative (i : Fin 142)
    (hf : ∀ x : Code, x ∈ four → x ∈ node i)
    (hc : ∀ x : Code, centerTest i x ↔ centerTest 0 x) : Alternative (node i) := by
  refine Or.inr ⟨hf, Or.inr (Or.inl ?_)⟩
  ext x
  exact (centerTest_iff i x).symm.trans ((hc x).trans (centerTest_zero x))

private theorem omega_alternative (i : Fin 142)
    (hc : ∀ x : Code, centerTest i x ∧ x ^ 2 = 1 ↔ x ∈ four) : Alternative (node i) := by
  refine Or.inr ⟨?_, Or.inl ?_⟩
  · intro x hx
    exact ((hc x).mpr hx).1.1
  · ext x
    exact (omega_image_mem i x).trans (hc x)

private theorem elementary_alternative (i : Fin 142)
    (hf : ∀ x : Code, x ∈ four → x ∈ node i)
    (hc : ∀ x : Code, x ∈ node i → ∀ j : Fin 4,
      generators i j * x = x * generators i j)
    (hp : ∀ x : Code, x ∈ node i → x ^ 2 = 1)
    (hn : Fintype.card (node i) = 16) : Alternative (node i) := by
  refine Or.inr ⟨hf, Or.inr (Or.inr ⟨?_, ?_⟩)⟩
  · refine { toIsMulCommutative := ?_,
             exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
    · apply isMulCommutative_iff.mpr
      intro x y
      have hx := (center_image_mem (node i) x).mp
        ((centerTest_iff i x).mp ⟨x.property, hc x x.property⟩)
      exact Subtype.ext (hx.2 y y.property).symm
    · intro x
      exact Subtype.ext (hp x x.property)
  · simpa only [Nat.card_eq_fintype_card] using hn

-- The square factors are lifted into the node before applying the Frattini lemma.
private theorem witness_alternative (i : Fin 142) (g : Code) (a b : Code → Code)
    (hg : g ∉ node i)
    (hn : ∀ x : Code, x ∈ node i ↔ g * x * g⁻¹ ∈ node i)
    (hw : ∀ x : Code, x ∈ node i →
      a x ∈ node i ∧ b x ∈ node i ∧ x⁻¹ * g * x * g⁻¹ = (a x)^2 * (b x)^2) :
    Alternative (node i) := by
  let U := node i
  let g' : Subgroup.normalizer (U : Set Code) := ⟨g, hn⟩
  refine Or.inl ⟨g', hg, ?_⟩
  intro x
  obtain ⟨ha, hb, he⟩ := hw x x.property
  let : Fact (IsPGroup 2 U) :=
    ⟨(IsPGroup.of_card (show Nat.card Code = 2 ^ 7 from card)).to_subgroup U⟩
  have he' : x⁻¹ * U.normalizerMonoidHom g' x =
      (⟨a x, ha⟩ : U) ^ 2 * (⟨b x, hb⟩ : U) ^ 2 := by
    apply Subtype.ext
    change (x : Code)⁻¹ * (g * x * g⁻¹) = (a x)^2 * (b x)^2
    simpa only [mul_assoc] using he
  rw [he']
  exact (frattini U).mul_mem (pth_power_mem_frattini_of_isPGroup (p := 2) _)
    (pth_power_mem_frattini_of_isPGroup (p := 2) _)


