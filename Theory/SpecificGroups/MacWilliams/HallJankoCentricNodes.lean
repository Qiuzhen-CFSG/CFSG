public instance (i : Fin 142) (x : Code) : Decidable (x ∈ node i) :=
  decidable_of_iff ((mask i).testBit x.toFin.val = true) (mem_node i x).symm

/-- The starting node of the descent is the whole coordinate group. -/
public theorem node_zero : node 0 = ⊤ := by
  apply top_unique
  intro x _
  exact (mem_node 0 x).mpr ((by decide +kernel :
    ∀ y : Code, (mask 0).testBit y.toFin.val = true) x)

