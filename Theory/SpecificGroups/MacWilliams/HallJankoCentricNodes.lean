/-- The concrete node is the subgroup generated by its four displayed codes. -/
@[expose] public def node (i : Fin 142) : Subgroup Code :=
  Subgroup.closure (Set.range (generators i))

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
/-- Kernel-checked membership in every census node. -/
public theorem mem_node (i : Fin 142) (x : Code) :
    x ∈ node i ↔ (mask i).testBit x.toFin.val = true := by
  fin_cases i
  · exact mem_closure_range_iff_of_word_certificate generators0
      (fun y => mask0.testBit y.toFin.val = true)
      (fun y => words0[y.toFin.val]!) check0.1
