@[expose] public def member (i : Fin 84) (g : Model) : Prop :=
  (mask i).testBit (coordinateCode g) = true

public instance (i : Fin 84) (g : Model) : Decidable (member i g) :=
  inferInstanceAs (Decidable (_ = _))

set_option maxHeartbeats 8000000 in
private theorem closed : ∀ i : Fin 84,
    member i 1 ∧ (∀ a b : Model, member i a → member i b → member i (a * b)) ∧
    (∀ a : Model, member i a → member i a⁻¹) := by decide +kernel

@[expose] public def node (i : Fin 84) : Subgroup Model where
  carrier := member i
  one_mem' := by exact (closed i).1
  mul_mem' := by exact (closed i).2.1 _ _
  inv_mem' := by exact (closed i).2.2 _

public instance (i : Fin 84) : DecidablePred (· ∈ node i) :=
  fun g => inferInstanceAs (Decidable (member i g))

