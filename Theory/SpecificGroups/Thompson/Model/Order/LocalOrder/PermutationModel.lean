module

public import Theory.SpecificGroups.Thompson.Model.Order.Subgroup
public import Mathlib.GroupTheory.Perm.Finite

/-!
# A concrete 819-point permutation group for the local order certificate

The tables come from the action of the two exact local words on 819 subspaces
of a 26-dimensional section of the original binary representation. GAP and
Python produced witnesses only. This module checks that the tables are
permutations; it does not assert the representation comparison or group order.
Those are separate mathematical obligations.

The fixed witness data and their conventions are recorded in
`LocalOrder/source/action_witness.json` and `LocalOrder/source/README.md`.
Both GAP point maps are inverted here to convert a right action into Lean's
left-action multiplication convention without reversing group words.
-/

namespace Thompson.OrderCertificate.LocalAction
set_option maxRecDepth 10000


@[expose] public def aMapPacked : ℕ := 

@[expose] public def aMap (i : Fin 819) : Fin 819 :=
  ⟨(aMapPacked >>> (10 * i.val)) % 1024 % 819, Nat.mod_lt _ (by decide)⟩

@[expose] public def aInvPacked : ℕ := 

@[expose] public def aInv (i : Fin 819) : Fin 819 :=
  ⟨(aInvPacked >>> (10 * i.val)) % 1024 % 819, Nat.mod_lt _ (by decide)⟩

public theorem a_left : ∀ i, aInv (aMap i) = i := by
  decide +kernel

public theorem a_right : ∀ i, aMap (aInv i) = i := by
  decide +kernel

/-- The certified left-action permutation table of local generator `a`. -/
@[expose] public def permA : Equiv.Perm (Fin 819) where
  toFun := aMap
  invFun := aInv
  left_inv := a_left
  right_inv := a_right

@[expose] public def bMapPacked : ℕ := 

@[expose] public def bMap (i : Fin 819) : Fin 819 :=
  ⟨(bMapPacked >>> (10 * i.val)) % 1024 % 819, Nat.mod_lt _ (by decide)⟩

@[expose] public def bInvPacked : ℕ := 

@[expose] public def bInv (i : Fin 819) : Fin 819 :=
  ⟨(bInvPacked >>> (10 * i.val)) % 1024 % 819, Nat.mod_lt _ (by decide)⟩

public theorem b_left : ∀ i, bInv (bMap i) = i := by
  decide +kernel

public theorem b_right : ∀ i, bMap (bInv i) = i := by
  decide +kernel

/-- The certified left-action permutation table of local generator `b`. -/
@[expose] public def permB : Equiv.Perm (Fin 819) where
  toFun := bMap
  invFun := bInv
  left_inv := b_left
  right_inv := b_right

/-- The fixed small permutation subgroup. Neither its order nor its
comparison with the 248-dimensional group is assumed in this definition. -/
@[expose] public def permutationSubgroup : Subgroup (Equiv.Perm (Fin 819)) :=
  Subgroup.closure {permA, permB}

end Thompson.OrderCertificate.LocalAction
