module

public import Theory.SpecificGroups.Thompson.Model.Simplicity.ClassCoverage.Reduction

/-!
# A concrete two-local candidate in the Thompson matrix model

The outputs of `ThG1-max2W1` are `a` and a conjugate of `(abbab)^2`.
We define their actual matrix-word subgroup, without assuming its identification
as `2^5.L_5(2)`, its order, or a census of its involutions. A subgroup of order
`2^15` inside this candidate and ambient fusion of its involutions suffice for
the coverage argument in `ClassCoverage.Twos`.

Source: https://brauer.maths.qmul.ac.uk/Atlas/v3/subgroup/ThG1-max2W1 .
The original straight-line program is preserved in `Twos/source/`.
-/

@[expose] public section

namespace Thompson.Simplicity.TwoLocal

/-- Register 7 at the end of the conjugator calculation in `ThG1-max2W1`. -/
def conjugator : Model :=
  (generatorA * generatorB) ^ 15 * (generatorA * generatorB ^ 2) ^ 9 *
    (generatorA * generatorB) ^ 12 * (generatorA * generatorB ^ 2) ^ 16 *
    (generatorA * generatorB) ^ 17

/-- The first output register is unchanged by the source program. -/
def localA : Model := generatorA

/-- The second output of the source program, with right conjugation. -/
def localB : Model :=
  conjugator⁻¹ * ((generatorA * generatorB ^ 2) * (generatorA * generatorB)) ^ 2 *
    conjugator

/-- The actual subgroup generated by the two source words. -/
def localSubgroup : Subgroup Model := Subgroup.closure {localA, localB}

theorem localA_mem : localA ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

theorem localB_mem : localB ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The first generator is the already certified matrix involution. -/
theorem orderOf_localA : orderOf localA = 2 := orderOf_primeRepresentative_zero

/-- The second generator is a conjugate of the fixed squared-commutator word.
This identifies words only; it makes no additional order assertion. -/
theorem localB_eq_conjugate :
    localB = conjugator⁻¹ * primeRepresentative 4 * conjugator := by
  have ha : generatorA⁻¹ = generatorA :=
    inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using generatorA_sq)
  have hb : generatorB⁻¹ = generatorB ^ 2 :=
    inv_eq_of_mul_eq_one_right (by simpa only [pow_succ'] using generatorB_cube)
  simp [localB, primeRepresentative, commutatorWord, ha, hb, mul_assoc]

/-- The exact local fusion obligation. Conjugators belong to the actual
ambient matrix group, and no ATLAS class completeness is assumed. -/
def LocalFusion : Prop :=
  ∀ y : Model, y ∈ localSubgroup → orderOf y = 2 →
    ∃ g : Model, generatorA = g * y * g⁻¹

end Thompson.Simplicity.TwoLocal
