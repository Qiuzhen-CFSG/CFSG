module

public import Theory.SpecificGroups.Thompson.Model.Simplicity.ClassCoverage.Reduction

/-!
# A concrete three-local candidate in the Thompson matrix model

The two generators are the outputs of `ThG1-max6W1`, transcribed without any
recognition assumption. Its proposed order is `944784 = 16 * 3^10`. Thus an
order certificate and fusion of its order-three elements suffice for ambient
coverage. The first generator is a conjugate of the certified involution.

Source: https://brauer.maths.qmul.ac.uk/Atlas/v3/subgroup/ThG1-max6W1 .
The original program and transcription notes are in `Threes/source/`.
-/

@[expose] public section
namespace Thompson.Simplicity.ThreeLocal

/-- The conjugator for the first output of the source program. -/
def conjugatorA : Model :=
  (generatorA * generatorB) ^ 8 * (generatorA * generatorB ^ 2) ^ 6

/-- First output of `ThG1-max6W1`. -/
def localA : Model := conjugatorA⁻¹ * generatorA * conjugatorA

/-- Register 7 before the cube in `ThG1-max6W1`. -/
def localBBase : Model :=
  let r3 := generatorA * generatorB
  let r4 := r3 * generatorB
  let r5 := r3 * r4
  let r6 := r5 * r5
  let r5' := r6 * r4
  let r6' := r3 * r3
  r6' * r5'

/-- The conjugator for the second output of the source program. -/
def conjugatorB : Model :=
  (generatorA * generatorB ^ 2) ^ 13 * (generatorA * generatorB) ^ 5

/-- Second output of `ThG1-max6W1`. -/
def localB : Model := conjugatorB⁻¹ * localBBase ^ 3 * conjugatorB

/-- The actual subgroup of the fixed matrix group generated by these words. -/
def localSubgroup : Subgroup Model := Subgroup.closure {localA, localB}

theorem localA_mem : localA ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

theorem localB_mem : localB ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The source program's first output is a nontrivial involution. -/
theorem orderOf_localA : orderOf localA = 2 := by
  simpa only [localA, MulAut.conj_apply, inv_inv] using
    (MulEquiv.orderOf_eq (MulAut.conj conjugatorA⁻¹) generatorA).trans
      orderOf_primeRepresentative_zero

/-- The three prescribed indices, excluding every other prime representative. -/
def representativeIndex : Fin 3 → Fin 9 := ![1, 2, 3]

/-- The concrete fusion obligation, with conjugators in the ambient model. -/
def LocalFusion : Prop :=
  ∀ y : Model, y ∈ localSubgroup → orderOf y = 3 →
    ∃ (i : Fin 3) (k : ℕ) (g : Model),
      primeRepresentative (representativeIndex i) = g * y ^ k * g⁻¹

end Thompson.Simplicity.ThreeLocal
