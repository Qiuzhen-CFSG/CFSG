module

public import Theory.SpecificGroups.Thompson.Model.Simplicity.ClassCoverage.Reduction

/-!
# Candidate five-local words in the Thompson matrix model

The two ATLAS programs `ThG1-max9W1` and `ThG1-max10W1` supply words for
candidate five-local subgroups. From the first pair `u,v` we take
`x = (u*v)^4`, `y = u⁻¹*x*u`, and `z = x⁻¹*y⁻¹*x*y`.
The proposed Sylow subgroup is generated by `x,y`, with candidate normal
forms `x^i*y^j*z^k` for `0 ≤ i,j,k < 5`.

This module defines the words and proves their elementary membership facts;
it makes no claim about their orders, distinctness, or fusion. Those claims
require certificates against the fixed matrices. The original programs and
provenance are in `Fives/source/`.
-/

@[expose] public section

namespace Thompson.Simplicity.Fives

/-- First output of the ATLAS program `ThG1-max9W1`. -/
def localU : Model :=
  let ab := generatorA * generatorB
  let abb := ab * generatorB
  let t := ab ^ 8 * abb ^ 5 * ab ^ 7
  t⁻¹ * (ab ^ 4 * (ab * abb) ^ 2 * abb) ^ 10 * t

/-- Second output of the ATLAS program `ThG1-max9W1`. -/
def localV : Model :=
  let ab := generatorA * generatorB
  let abb := ab * generatorB
  let t := ab ^ 16 * abb ^ 11
  t⁻¹ * (ab ^ 4 * abb) ^ 5 * t

/-- First output of `ThG1-max10W1`, available for ambient fusion witnesses. -/
def fusionU : Model :=
  let ab := generatorA * generatorB
  let abb := ab * generatorB
  let t := ab ^ 3 * abb ^ 15
  t⁻¹ * generatorA * t

/-- Second output of `ThG1-max10W1`, available for ambient fusion witnesses. -/
def fusionV : Model :=
  let ab := generatorA * generatorB
  let abb := ab * generatorB
  let t := abb ^ 8 * ab ^ 9
  t⁻¹ * (ab ^ 5 * generatorB) ^ 5 * t

def localX : Model := (localU * localV) ^ 4
def localY : Model := localU⁻¹ * localX * localU
def localZ : Model := commutatorWord localX localY

/-- Central and noncentral candidates for the two local cyclic orbits. -/
def localRepresentative : Fin 2 → Model := ![localZ, localX]

/-- The fixed subgroup whose order and fusion are to be certified. -/
def localSubgroup : Subgroup Model := Subgroup.closure {localX, localY}

abbrev Coordinates := Fin 5 × Fin 5 × Fin 5

/-- Candidate normal forms, in the order `x^i*y^j*z^k`. -/
def normalForm (t : Coordinates) : Model :=
  localX ^ t.1.val * localY ^ t.2.1.val * localZ ^ t.2.2.val

theorem localX_mem : localX ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

theorem localY_mem : localY ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)

theorem localZ_mem : localZ ∈ localSubgroup :=
  localSubgroup.mul_mem
    (localSubgroup.mul_mem
      (localSubgroup.mul_mem (localSubgroup.inv_mem localX_mem)
        (localSubgroup.inv_mem localY_mem)) localX_mem) localY_mem

theorem normalForm_mem (t : Coordinates) : normalForm t ∈ localSubgroup :=
  localSubgroup.mul_mem
    (localSubgroup.mul_mem (localSubgroup.pow_mem localX_mem _)
      (localSubgroup.pow_mem localY_mem _)) (localSubgroup.pow_mem localZ_mem _)

/-- The map to be certified bijective; bijectivity proves both the order
125 and exhaustiveness of the normal forms. -/
def normalFormElement (t : Coordinates) : localSubgroup :=
  ⟨normalForm t, normalForm_mem t⟩

theorem normalForm_zero : normalForm (0, 0, 0) = 1 := by
  simp [normalForm]

end Thompson.Simplicity.Fives
