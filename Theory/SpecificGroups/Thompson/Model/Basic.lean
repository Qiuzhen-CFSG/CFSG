module

public import Theory.SpecificGroups.Thompson.Model.AtlasData
public import Mathlib.Algebra.Group.Submonoid.Basic
public import Mathlib.Algebra.GroupWithZero.Units.Fintype
public import Mathlib.Data.Matrix.Basic

/-!
# A fixed finite matrix carrier for the Thompson group

We take the units of the submonoid generated by the two explicit ATLAS
matrices `ThG1-f2r248B0`. This fixes the carrier without choosing an arbitrary
group, using classification, or assuming any numerical or simplicity result.
Its faithful matrix representation gives finiteness immediately.

Taking units makes the definition independent of the proofs of the generator
identities. After those identities are established, every element of the
generated submonoid is a unit, identifying this carrier with the usual group
generated by the two matrices. The exact order, noncommutativity, and simplicity
are separate certification results, not consequences asserted in this module.

The source data and attribution are in `AtlasData.lean` and `source/README.md`.
-/

namespace Thompson

/-- The multiplicative submonoid generated by the two published ATLAS matrices. -/
@[expose] public def atlasMonoid : Submonoid AtlasMatrix :=
  Submonoid.closure {atlasA, atlasB}

/-- The fixed matrix carrier. Certification as the simple Thompson group is separate. -/
public abbrev Model := atlasMonoidˣ

public instance modelFinite : Finite Model := inferInstance

/-- The faithful matrix representation of the fixed carrier. -/
@[expose] public def matrixHom : Model →* AtlasMatrix :=
  atlasMonoid.subtype.comp (Units.coeHom atlasMonoid)

public theorem matrixHom_injective : Function.Injective matrixHom := by
  intro x y h
  apply Units.ext
  exact Subtype.ext h

/-- Every representing matrix is a product of the two source matrices. -/
public theorem matrixHom_mem (g : Model) : matrixHom g ∈ atlasMonoid :=
  (g.val).property

public theorem atlasA_mem : atlasA ∈ atlasMonoid :=
  Submonoid.subset_closure (Set.mem_insert _ _)

public theorem atlasB_mem : atlasB ∈ atlasMonoid :=
  Submonoid.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

set_option maxRecDepth 10000 in
set_option maxHeartbeats 4000000 in
/-- The source matrices fail to commute already at entry `(0, 3)`.
The reduction is checked by the Lean kernel. -/
public theorem atlas_mul_entry_ne :
    (atlasA * atlasB) 0 3 ≠ (atlasB * atlasA) 0 3 := by
  decide +kernel

/-- Noncommutativity of the concrete source matrices. To transfer this to
`Model`, the matrices must additionally be certified as units of `atlasMonoid`. -/
public theorem atlas_mul_ne : atlasA * atlasB ≠ atlasB * atlasA := by
  intro h
  exact atlas_mul_entry_ne (congrFun (congrFun h 0) 3)

end Thompson
