module

public import Theory.SpecificGroups.Thompson.Model.Basic
public import Theory.SpecificGroups.Thompson.Model.GeneratorCertificates.Involution
public import Theory.SpecificGroups.Thompson.Model.GeneratorCertificates.OrderThree
public import Mathlib.Algebra.Group.Subgroup.Basic

/-!
# Certified generators of the Thompson matrix model

Kernel-checked packed binary arithmetic proves the ATLAS relations `a² = 1`
and `b³ = 1`. Their explicit inverses put both matrices in the fixed carrier
`atlasMonoidˣ`. Induction on positive words lifts every matrix in `atlasMonoid`
to the subgroup generated by these units. Consequently the whole monoid consists
of units, these two units generate `Model`, and the faithful representation
identifies it with the usual group generated by the two matrices. The source
matrices' noncommutativity then proves that this group is nonabelian.

Source: the ATLAS representation `ThG1-f2r248B0`; provenance and original files
are recorded in `Model/source/README.md`. No order or simplicity claim is used.
-/

set_option maxRecDepth 2048

namespace Thompson

/-- The certified ATLAS involution in the fixed carrier. -/
@[expose] public def generatorA : Model where
  val := ⟨atlasA, atlasA_mem⟩
  inv := ⟨atlasA, atlasA_mem⟩
  val_inv := Subtype.ext (by change atlasA * atlasA = 1; simpa only [pow_two] using atlasA_sq)
  inv_val := Subtype.ext (by change atlasA * atlasA = 1; simpa only [pow_two] using atlasA_sq)

/-- The certified ATLAS element of order dividing three in the fixed carrier. -/
@[expose] public def generatorB : Model where
  val := ⟨atlasB, atlasB_mem⟩
  inv := ⟨atlasB ^ 2, atlasMonoid.pow_mem atlasB_mem 2⟩
  val_inv := Subtype.ext (by change atlasB * atlasB ^ 2 = 1; rw [← pow_succ']; exact atlasB_cube)
  inv_val := Subtype.ext (by change atlasB ^ 2 * atlasB = 1; rw [← pow_succ]; exact atlasB_cube)

public theorem matrixHom_generatorA : matrixHom generatorA = atlasA := rfl
public theorem matrixHom_generatorB : matrixHom generatorB = atlasB := rfl

private theorem lift_word (x : AtlasMatrix) (hx : x ∈ atlasMonoid) :
    ∃ u : Model, matrixHom u = x ∧ u ∈ Subgroup.closure {generatorA, generatorB} := by
  induction hx using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with rfl | hx
    · exact ⟨generatorA, rfl, Subgroup.subset_closure (Set.mem_insert _ _)⟩
    · obtain rfl : x = atlasB := hx
      exact ⟨generatorB, rfl, Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)⟩
  | one => exact ⟨1, map_one _, Subgroup.one_mem _⟩
  | mul x y hx hy hix hiy =>
    obtain ⟨u, hu, huc⟩ := hix
    obtain ⟨v, hv, hvc⟩ := hiy
    exact ⟨u * v, by rw [map_mul, hu, hv], Subgroup.mul_mem _ huc hvc⟩

/-- Every positive word in the ATLAS matrices is already a unit of their monoid. -/
public theorem atlasMonoid_isUnit (x : atlasMonoid) : IsUnit x := by
  obtain ⟨u, hu, _⟩ := lift_word x.val x.property
  exact ⟨u, Subtype.ext hu⟩

/-- The two certified ATLAS generators generate the entire fixed model. -/
public theorem closure_generators : Subgroup.closure {generatorA, generatorB} = ⊤ := by
  apply top_unique
  intro g _
  obtain ⟨u, hu, huc⟩ := lift_word (matrixHom g) (matrixHom_mem g)
  rwa [matrixHom_injective hu] at huc

/-- The generators fail to commute, witnessed by the original matrix entry. -/
public theorem generator_mul_ne : generatorA * generatorB ≠ generatorB * generatorA := by
  intro h
  apply atlas_mul_ne
  simpa only [map_mul, matrixHom_generatorA, matrixHom_generatorB] using congrArg matrixHom h

public theorem exists_matrixHom_eq_iff (x : AtlasMatrix) :
    (∃ u : Model, matrixHom u = x) ↔ x ∈ atlasMonoid := by
  constructor
  · rintro ⟨u, rfl⟩
    exact matrixHom_mem u
  · intro hx
    obtain ⟨u, hu⟩ := atlasMonoid_isUnit ⟨x, hx⟩
    exact ⟨u, congrArg Subtype.val hu⟩

/-- Taking units did not discard any element of the generated matrix monoid. -/
public noncomputable def modelEquivAtlasMonoid : Model ≃* atlasMonoid :=
  MulEquiv.ofBijective (Units.coeHom atlasMonoid)
    ⟨Units.val_injective, fun x => atlasMonoid_isUnit x⟩

/-- The fixed Thompson matrix model is nonabelian. -/
public theorem model_not_isMulCommutative : ¬ IsMulCommutative Model := by
  intro h
  exact generator_mul_ne ((isMulCommutative_iff.mp h) _ _)

/-- The certified group generator has square one. -/
public theorem generatorA_sq : generatorA ^ 2 = 1 := by
  apply matrixHom_injective
  rw [map_pow, matrixHom_generatorA, map_one, atlasA_sq]

/-- The certified group generator has cube one. -/
public theorem generatorB_cube : generatorB ^ 3 = 1 := by
  apply matrixHom_injective
  rw [map_pow, matrixHom_generatorB, map_one, atlasB_cube]

/-- The faithful representation has exactly the original generated monoid as image. -/
public theorem matrixHom_mrange : MonoidHom.mrange matrixHom = atlasMonoid := by
  ext x
  exact exists_matrixHom_eq_iff x

end Thompson
