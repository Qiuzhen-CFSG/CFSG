module

public import Theory.SpecificGroups.LinearHigher.TorusAction

/-!
# Subgroups for higher linear presentation faithfulness

The positive, Weyl and torus subgroups are generated by literal words in
`SteinbergGroup n F`. They are not preimages of subgroups of SL. The
normal-form contracts separate positive-root collection, Bruhat coverage
and faithfulness on the Weyl subgroup. Their proofs are still required
before the conditional assembly gives presentation faithfulness.

Source: Steinberg, *Lectures on Chevalley Groups*, §§3 and 6, Lemmas
36–38 and Theorem 8, printed pp.69–71; local transcription
`refs/KGroup/GLS3/Chapter2St1.tex`.
-/

@[expose] public section

namespace Theory.SpecificGroups.LinearHigher.PresentationFaithfulness
open SteinbergWords

variable (n : ℕ) (F : Type*) [Field F]

/-- The subgroup generated by all positive root groups in the presentation. -/
def upperSubgroup : Subgroup (SteinbergGroup n F) :=
  Subgroup.closure {g | ∃ (r : Root n) (a : F), r.val.1 < r.val.2 ∧ g = generator r a}

/-- The subgroup generated by the nonzero-parameter Weyl words. -/
def weylSubgroup : Subgroup (SteinbergGroup n F) :=
  Subgroup.closure {g | ∃ (r : Root n) (t : Fˣ),
    g = weylWord generator r.val.1 r.val.2 r.property t}

/-- The subgroup generated by all root torus words. -/
def torusSubgroup : Subgroup (SteinbergGroup n F) :=
  Subgroup.closure {g | ∃ (r : Root n) (t : Fˣ),
    g = torusWord generator r.val.1 r.val.2 r.property t}

/-- Delete a single root from the positive generating family. -/
def upperComplement (r : Root n) : Subgroup (SteinbergGroup n F) :=
  Subgroup.closure {g | ∃ (s : Root n) (a : F),
    s.val.1 < s.val.2 ∧ s ≠ r ∧ g = generator s a}

/-- A simple root has consecutive coordinate indices. -/
def IsSimpleRoot (r : Root n) : Prop := r.val.2.val = r.val.1.val + 1

/-- Factoring off any specified simple root from a positive word. -/
def UpperFactorization : Prop :=
  ∀ (r : Root n), IsSimpleRoot n r → ∀ u : upperSubgroup n F,
    ∃ (a : F) (v : upperComplement n F r), u.val = generator r a * v.val

/-- Coverage by the literal positive and Weyl subgroups. -/
def BruhatCover : Prop :=
  ∀ g : SteinbergGroup n F,
    ∃ (u : upperSubgroup n F) (w : weylSubgroup n F) (v : upperSubgroup n F),
      g = u.val * w.val * v.val

/-- Faithfulness on the positive subgroup, as in Steinberg Lemma 36. -/
def UpperFaithful : Prop := Function.Injective (matrixMap.comp (upperSubgroup n F).subtype)

/-- Faithfulness on the subgroup of monomial words, retaining its torus. -/
def WeylFaithful : Prop := Function.Injective (matrixMap.comp (weylSubgroup n F).subtype)

variable {n F}

theorem generator_mem_upper {r : Root n} (hr : r.val.1 < r.val.2) (a : F) :
    generator r a ∈ upperSubgroup n F :=
  Subgroup.subset_closure ⟨r, a, hr, rfl⟩

theorem weylWord_mem_weyl (i j : Fin n) (hij : i ≠ j) (t : Fˣ) :
    weylWord generator i j hij t ∈ weylSubgroup n F :=
  Subgroup.subset_closure ⟨root i j hij, t, rfl⟩

theorem torusWord_mem_torus (i j : Fin n) (hij : i ≠ j) (t : Fˣ) :
    torusWord generator i j hij t ∈ torusSubgroup n F :=
  Subgroup.subset_closure ⟨root i j hij, t, rfl⟩

theorem torusSubgroup_le_weyl : torusSubgroup n F ≤ weylSubgroup n F := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨r, t, rfl⟩
  exact (weylSubgroup n F).mul_mem
    (weylWord_mem_weyl _ _ _ t) (weylWord_mem_weyl _ _ _ (-1))

theorem upperComplement_le (r : Root n) : upperComplement n F r ≤ upperSubgroup n F := by
  apply Subgroup.closure_mono
  rintro g ⟨s, a, hs, _, rfl⟩
  exact ⟨s, a, hs, rfl⟩

end Theory.SpecificGroups.LinearHigher.PresentationFaithfulness
