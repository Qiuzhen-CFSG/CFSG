module

public import Theory.LinearAlgebra.SpecialLinearDeterminantKernel
public import Theory.SpecificGroups.SL2.SylowUniqueMaximal
public import Theory.SpecificGroups.SL2.SylowConsequences

/-!
# Recognition from two generating five-subgroups

Two distinct defining-characteristic Sylow subgroups generate SL₂ over a
finite field. After conjugating the first to the upper root group, a
proper join would lie in its Borel; the Sylow normalizer intersection
then forces the second Sylow to equal the first.

For a faithful action on a prime plane over F₅, five-elements have trivial
determinant. Thus two distinct order-five subgroups generating the acting
group yield an equivalence with SL₂(5). This is the opposite-five-subgroup
calculation used before Aschbacher–Smith J.4.8, printed p.443.
-/

public section
open Matrix Subgroup
open scoped MatrixGroups
namespace Matrix.SpecialLinearGroup
variable {F : Type*} [Field F] [Finite F] (p : ℕ) [Fact p.Prime] [CharP F p]

theorem sylow_sup_eq_top (P Q : Sylow p SL(2,F)) (hne : P≠Q) :
    (P : Subgroup SL(2,F)) ⊔ Q=⊤ := by
  let U := upperUnipotentSylow F p
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq SL(2,F) P U
  let f := (MulAut.conj g).toMonoidHom
  have hPm : (P : Subgroup SL(2,F)).map f=(U : Subgroup SL(2,F)) :=
    congrArg Sylow.toSubgroup hg
  by_contra hproper
  have hK : ((P : Subgroup SL(2,F)) ⊔ Q).map f≠⊤ := by
    intro ht
    apply hproper
    apply Subgroup.map_injective (f:=f) (MulAut.conj g).injective
    rw [ht,map_top_of_surjective _ (MulAut.conj g).surjective]
  have hU : upperUnipotent F≤((P : Subgroup SL(2,F)) ⊔ Q).map f := by
    change (U : Subgroup SL(2,F))≤_
    rw [← hPm]
    exact map_mono le_sup_left
  have hN := overgroup_le_rankOneBorel hU hK
  have hQN : (Q : Subgroup SL(2,F)).map f≤normalizer (U : Set SL(2,F)) :=
    (map_mono le_sup_right).trans hN
  have hi := (Q.isPGroup'.map f).inf_normalizer_sylow U
  rw [inf_eq_left.mpr hQN] at hi
  have hle : (Q : Subgroup SL(2,F)).map f≤(P : Subgroup SL(2,F)).map f := by
    rw [hPm]
    exact hi.symm ▸ inf_le_right
  have hQP := (map_le_map_iff_of_injective (MulAut.conj g).injective).mp hle
  apply hne
  exact Sylow.ext (Q.is_maximal' P.isPGroup' hQP)

end Matrix.SpecialLinearGroup

namespace Matrix.SpecialLinearGroup
private instance : Fact (Nat.Prime 5) := ⟨by decide⟩

theorem five_subgroup_sup_eq_top (A B : Subgroup SL(2,ZMod 5))
    (hA : Nat.card A=5) (hB : Nat.card B=5) (hne : A≠B) : A⊔B=⊤ := by
  obtain ⟨P,hP⟩ := (IsPGroup.of_card (p:=5) (n:=1) hA).exists_le_sylow
  obtain ⟨Q,hQ⟩ := (IsPGroup.of_card (p:=5) (n:=1) hB).exists_le_sylow
  have hc (R : Sylow 5 SL(2,ZMod 5)) : Nat.card R=5 := by
    rw [← Nat.card_congr (sylowEquivAdditive (ZMod 5) 5 R).toEquiv]
    exact Nat.card_zmod 5
  have hAP : A=(P : Subgroup SL(2,ZMod 5)) := eq_of_le_of_card_ge hP (by rw [hA,hc P])
  have hBQ : B=(Q : Subgroup SL(2,ZMod 5)) := eq_of_le_of_card_ge hQ (by rw [hB,hc Q])
  rw [hAP,hBQ]
  apply sylow_sup_eq_top 5 P Q
  intro he
  apply hne
  rw [hAP,hBQ,he]

/-- Two distinct order-five subgroups generating a faithfully represented
group force its representation to be the entire determinant-one plane group. -/
theorem surjective_of_five_generators {K : Type*} [Group K]
    (A B : Subgroup K) (hA : Nat.card A=5) (hB : Nat.card B=5)
    (hne : A≠B) (hgen : A⊔B=⊤) (ρ : K→*SL(2,ZMod 5)) (hρ : Function.Injective ρ) :
    Function.Surjective ρ := by
  have hAm : Nat.card (A.map ρ)=5 := (card_map_of_injective hρ).trans hA
  have hBm : Nat.card (B.map ρ)=5 := (card_map_of_injective hρ).trans hB
  have hnem : A.map ρ≠B.map ρ := fun he => hne (Subgroup.map_injective hρ he)
  have ht := five_subgroup_sup_eq_top (A.map ρ) (B.map ρ) hAm hBm hnem
  rw [← Subgroup.map_sup,hgen,← MonoidHom.range_eq_map] at ht
  exact MonoidHom.range_eq_top.mp ht

end Matrix.SpecialLinearGroup

namespace Matrix.GeneralLinearGroup
open scoped MatrixGroups
private instance : Fact (Nat.Prime 5) := ⟨by decide⟩

private theorem det_eq_one_on_five {K : Type*} [Group K] [Finite K]
    (A : Subgroup K) (hA : Nat.card A=5) (ρ : K→*GL (Fin 2) (ZMod 5))
    (x:K) (hx:x∈A) : det (ρ x)=1 := by
  have hx5 : x^5=1 := by
    have he := pow_card_eq_one' (x := (⟨x,hx⟩:A))
    rw [hA] at he
    exact congrArg Subtype.val he
  have h5 : (det (ρ x))^5=1 := by rw [← map_pow,← map_pow,hx5,map_one,map_one]
  have h4 : (det (ρ x))^4=1 := by
    have he := pow_card_eq_one' (x := det (ρ x))
    norm_num only [Nat.card_units,Nat.card_zmod] at he
    exact he
  exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp
    (show orderOf (det (ρ x))∣1 from Nat.dvd_gcd
      (orderOf_dvd_of_pow_eq_one h5) (orderOf_dvd_of_pow_eq_one h4)))

/-- A faithful prime-plane action of a group generated by two distinct
five-subgroups recognizes the actual group as SL₂(5). -/
theorem equiv_sl2_of_five_generators {K : Type*} [Group K] [Finite K]
    (A B : Subgroup K) (hA : Nat.card A=5) (hB : Nat.card B=5)
    (hne : A≠B) (hgen : A⊔B=⊤) (ρ : K→*GL (Fin 2) (ZMod 5))
    (hρ : Function.Injective ρ) : Nonempty (K≃*SL(2,ZMod 5)) := by
  let d := det.comp ρ
  have hker : d.ker=⊤ := by
    apply top_unique
    rw [← hgen]
    exact sup_le (fun x hx => det_eq_one_on_five A hA ρ x hx)
      (fun x hx => det_eq_one_on_five B hB ρ x hx)
  have hd (x:K) : ρ x∈det.ker := by
    change d x=1
    exact show x∈d.ker from hker.symm ▸ mem_top x
  let e := Matrix.SpecialLinearGroup.determinantKernelEquiv (Fin 2) (ZMod 5)
  let r := ρ.codRestrict det.ker hd
  have hr : Function.Injective r := fun x y he => hρ (congrArg Subtype.val he)
  let f : K→*SL(2,ZMod 5) := e.symm.toMonoidHom.comp r
  have hf : Function.Injective f := e.symm.injective.comp hr
  exact ⟨MulEquiv.ofBijective f ⟨hf,
    Matrix.SpecialLinearGroup.surjective_of_five_generators A B hA hB hne hgen f hf⟩⟩

end Matrix.GeneralLinearGroup
