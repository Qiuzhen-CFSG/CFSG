module

public import Theory.SpecificGroups.SL2.EvenBorelResidual
public import Theory.FieldTheory.BinaryTorusInvolution
public import Theory.AtlasPort.ExceptionalIsomorphisms.FieldTransportLaws
public import Theory.GroupAction.Defs

/-!
# Field involutions on the actual even PSL₂ torus

Coefficientwise field transport intertwines the determinant-one diagonal
map with the unit-group field action. Thus its torus displacement image
has order 2^m+1 over a field of order 2^(2m). Fixing the three-residual
of this actual projective torus forces m = 1 or m = 3.

The displacement image lies in the action commutator of the Borel with
the cyclic subgroup generated by this field automorphism. It has odd
order, so it injects into that commutator modulo its two-core. For m > 1
this proves that the commutator quotient has order greater than three.
The actor here is the pure field automorphism; reduction of an arbitrary
outer actor to its induced torus action remains a separate calculation.

Source: Aschbacher–Smith, proof of 13.8.20, printed p.954. The coefficient
transport is the existing licensed ATLAS construction, imported through
`FieldTransportLaws`; no alternate projective model is introduced.
-/

@[expose] public section

open scoped MatrixGroups
open Subgroup BenderSuzuki.Converse Atlas
namespace Matrix.ProjectiveSpecialLinearGroup.EvenBorelResidual.FieldInvolution
open OddBorel FiniteField.BinaryTorusInvolution
variable (F : Type*) [Field F]

theorem field_torusHom (σ : F ≃+* F) (u : Fˣ) :
    fieldEquivPSL 2 σ (torusHom F u) = torusHom F (Units.map σ.toMonoidHom u) := by
  change fieldEquivPSL 2 σ (QuotientGroup.mk' _ (tor u)) = QuotientGroup.mk' _ _
  rw [fieldEquivPSL_mk]
  apply congrArg (QuotientGroup.mk' _)
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [fieldEquivSL, Matrix.SpecialLinearGroup.map_apply_coe, tor_val]

theorem torus_displacement (σ : F ≃+* F) (u : Fˣ) :
    torusHom F (displacement σ u) =
      fieldEquivPSL 2 σ (torusHom F u) * (torusHom F u)⁻¹ := by
  rw [field_torusHom]
  exact (torusHom F).map_mul _ _ |>.trans (by rw [map_inv])

def torusDisplacement (σ : F ≃+* F) : Subgroup PSL(2,F) :=
  (displacement σ).range.map (torusHom F)

theorem mem_torusDisplacement (σ : F ≃+* F) (x : PSL(2,F)) :
    x ∈ torusDisplacement F σ ↔
      ∃ u : Fˣ, fieldEquivPSL 2 σ (torusHom F u) * (torusHom F u)⁻¹ = x := by
  constructor
  · rintro ⟨v, ⟨u, rfl⟩, hx⟩
    exact ⟨u, (torus_displacement F σ u).symm.trans hx⟩
  · rintro ⟨u, hu⟩
    exact ⟨displacement σ u, ⟨u, rfl⟩, (torus_displacement F σ u).trans hu⟩

variable [Finite F] [CharP F 2]

theorem card_torusDisplacement (σ : F ≃+* F) {m : ℕ} (hm : 0 < m)
    (hF : Nat.card F = 2 ^ (2 * m))
    (hσ : ∀ x : F, σ x = x ^ (2 ^ m)) :
    Nat.card (torusDisplacement F σ) = 2 ^ m + 1 := by
  rw [torusDisplacement,
    Nat.card_congr (equivMapOfInjective (displacement σ).range (torusHom F)
      ((pi_injective (F := F)).comp (torHom_injective (F := F)))).toEquiv.symm]
  exact card_displacement σ hm hF hσ

theorem half_degree_of_fixed_torus_residual (σ : F ≃+* F) {m : ℕ} (hm : 0 < m)
    (hF : Nat.card F = 2 ^ (2 * m))
    (hσ : ∀ x : F, σ x = x ^ (2 ^ m))
    (hfix : ∀ u ∈ pResidual 3 (complement F),
      fieldEquivPSL 2 σ (u : PSL(2,F)) = u) : m = 1 ∨ m = 3 := by
  apply half_degree_of_fixed_residual σ hm hF hσ
  intro u hu
  have hmem : torusEquiv F u ∈ pResidual 3 (complement F) :=
    map_pResidual_le 3 (torusEquiv F).toMonoidHom (mem_map_of_mem _ hu)
  have h := hfix (torusEquiv F u) hmem
  change fieldEquivPSL 2 σ (torusHom F u) = torusHom F u at h
  rw [field_torusHom] at h
  exact (pi_injective (F := F)).comp (torHom_injective (F := F)) h

theorem torusDisplacement_card_gt_three (σ : F ≃+* F) {m : ℕ} (hm : 1 < m)
    (hF : Nat.card F = 2 ^ (2 * m))
    (hσ : ∀ x : F, σ x = x ^ (2 ^ m)) :
    3 < Nat.card (torusDisplacement F σ) := by
  rw [card_torusDisplacement F σ (by omega) hF hσ]
  have := Nat.pow_lt_pow_right (by decide : 1 < (2 : ℕ)) hm
  norm_num at this
  omega

omit [Finite F] [CharP F 2] in
theorem torusDisplacement_le_commutator (σ : F ≃+* F) :
    torusDisplacement F σ ≤ commutatorSubgroup (zpowers (fieldEquivPSL 2 σ))
      PSL(2,F) (borel F) := by
  intro x hx
  obtain ⟨u, rfl⟩ := (mem_torusDisplacement F σ x).mp hx
  apply Subgroup.subset_closure
  refine ⟨⟨fieldEquivPSL 2 σ, mem_zpowers _⟩, torusHom F u,
    (show complement F ≤ borel F from le_sup_right)
      (show torusHom F u ∈ complement F from ⟨u, rfl⟩), ?_⟩
  change fieldEquivPSL 2 σ (torusHom F u) * (torusHom F u)⁻¹ =
    (torusHom F u)⁻¹ * fieldEquivPSL 2 σ (torusHom F u)
  rw [field_torusHom, ← map_inv, ← map_mul, ← map_mul, mul_comm]

private theorem odd_subgroup_card_le_quotient_twoCore
    {G : Type*} [Group G] [Finite G] (D Q : Subgroup G)
    (hDQ : D ≤ Q) (hodd : Odd (Nat.card D)) :
    Nat.card D ≤ Nat.card (Q ⧸ pCore 2 Q) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hdis : Disjoint (D.subgroupOf Q) (pCore 2 Q) := by
    apply disjoint_of_coprime_natCard
    rw [Nat.card_congr (subgroupOfEquivOfLe hDQ).toEquiv]
    obtain ⟨k, hk⟩ := (pCore_isPGroup (p := 2) (G := Q)).exists_card_eq
    rw [hk]
    exact hodd.coprime_two_right.pow_right k
  let f := (QuotientGroup.mk' (pCore 2 Q)).comp (inclusion hDQ)
  have hinj : Function.Injective f := by
    apply (MonoidHom.ker_eq_bot_iff f).mp
    apply eq_bot_iff.mpr
    intro x hx
    have hxQ : inclusion hDQ x ∈ pCore 2 Q := (QuotientGroup.eq_one_iff _).mp hx
    have he := disjoint_def.mp hdis (show inclusion hDQ x ∈ D.subgroupOf Q from x.property) hxQ
    exact (show x = (1 : D) from Subtype.ext (congrArg (fun q : Q => q.val) he))
  exact Nat.card_le_card_of_injective f hinj

theorem commutator_quotient_card_gt_three (σ : F ≃+* F) {m : ℕ} (hm : 1 < m)
    (hF : Nat.card F = 2 ^ (2 * m))
    (hσ : ∀ x : F, σ x = x ^ (2 ^ m)) :
    let D := commutatorSubgroup (zpowers (fieldEquivPSL 2 σ)) PSL(2,F) (borel F)
    3 < Nat.card (D ⧸ pCore 2 D) := by
  have hodd : Odd (Nat.card (torusDisplacement F σ)) := by
    rw [card_torusDisplacement F σ (by omega) hF hσ, Nat.odd_iff]
    have hp : (2 : ℕ) ^ m % 2 = 0 := by simp [Nat.pow_mod, show m ≠ 0 by omega]
    omega
  exact (torusDisplacement_card_gt_three F σ hm hF hσ).trans_le
    (odd_subgroup_card_le_quotient_twoCore _ _ (torusDisplacement_le_commutator F σ) hodd)

end Matrix.ProjectiveSpecialLinearGroup.EvenBorelResidual.FieldInvolution
