module
public import Theory.SpecificGroups.SL2.Affine.Action

/-!
# Commutator generation of the natural SL₂ module

The upper and lower elementary matrices give each coordinate vector as a
single displacement. Consequently these displacements generate the additive
plane over any field, without choosing a nontrivial scalar or dropping the
binary field. This supplies the natural-section movement used in
Aschbacher–Smith 8.2.9, printed p.720.
-/
public section
open Matrix Subgroup
open scoped MatrixGroups
namespace Matrix.SL2
variable (F : Type*) [Field F]

/-- The natural plane is generated by the displacements of its literal SL₂ action. -/
theorem naturalAction_displacements_generate
    (D : Subgroup (Multiplicative (Fin 2 → F)))
    (hD : ∀ g w, naturalAction F g w * w⁻¹ ∈ D) : D = ⊤ := by
  let u : SL(2,F) := ⟨!![1,1;0,1], by simp [det_fin_two]⟩
  let l : SL(2,F) := ⟨!![1,0;1,1], by simp [det_fin_two]⟩
  have hu (a : F) : Multiplicative.ofAdd (![a,0] : Fin 2 → F) ∈ D := by
    convert hD u (Multiplicative.ofAdd ![0,a]) using 1
    apply Multiplicative.toAdd.injective
    rw [toAdd_mul,toAdd_inv,naturalAction_apply]
    ext j
    fin_cases j <;> simp [u]
  have hl (a : F) : Multiplicative.ofAdd (![0,a] : Fin 2 → F) ∈ D := by
    convert hD l (Multiplicative.ofAdd ![a,0]) using 1
    apply Multiplicative.toAdd.injective
    rw [toAdd_mul,toAdd_inv,naturalAction_apply]
    ext j
    fin_cases j <;> simp [l]
  apply top_unique
  intro v _
  convert D.mul_mem (hu (v.toAdd 0)) (hl (v.toAdd 1)) using 1
  apply Multiplicative.toAdd.injective
  ext j
  fin_cases j <;> simp

end Matrix.SL2
