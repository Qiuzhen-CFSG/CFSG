module

public import Theory.SpecificGroups.SL2.Affine.Action
public import Theory.GroupTheory.Commutator.RelativeGeneration

/-!
# Invariant subgroups of a nonsplit affine plane preimage

The natural translation quotient is additively irreducible. If its full
preimage is generated by commutators and the projection kernel is central,
every proper normal subgroup of that preimage lies in the actual kernel.
-/

namespace Matrix.SL2
open Subgroup
variable {E F : Type*} [Group E] [Field F]

private theorem normal_translation_subgroup (A : Subgroup (Affine F)) [A.Normal]
    (hA : A≤translations F) : A=⊥ ∨ A=translations F := by
  let V := A.comap (SemidirectProduct.inl : Multiplicative (Fin 2 → F) →* Affine F)
  have hi : ∀ g v, v∈V → naturalAction F g v∈V := by
    intro g v hv
    change SemidirectProduct.inl (naturalAction F g v)∈A
    have hh := (inferInstance : A.Normal).conj_mem _ hv (SemidirectProduct.inr g)
    simpa only [conjugate_inl, SemidirectProduct.right_inr] using hh
  rcases naturalAction_irreducible F V hi with hb | ht
  · left
    apply bot_unique
    intro x hx
    obtain ⟨v,rfl⟩ := (range_inl_eq_translations F).symm ▸ hA hx
    have hv : v∈V := hx
    have hv1 := mem_bot.mp (hb ▸ hv)
    simp [hv1]
  · right
    apply le_antisymm hA
    intro x hx
    obtain ⟨v,rfl⟩ := (range_inl_eq_translations F).symm ▸ hx
    exact (show v∈V from ht ▸ mem_top v)

/-- Normal subgroups in the full translation preimage are central-kernel
subgroups or the whole preimage, when that preimage equals its commutator. -/
public theorem invariant_preimage_le_kernel_or_eq
    (f : E →* Affine F) (hf : Function.Surjective f) (hk : f.ker≤center E)
    (hcomm : ⁅(translations F).comap f,(⊤ : Subgroup E)⁆=(translations F).comap f)
    (A : Subgroup E) [A.Normal] (hA : A≤(translations F).comap f) :
    A≤f.ker ∨ A=(translations F).comap f := by
  let : (A.map f).Normal := Normal.map inferInstance f hf
  rcases normal_translation_subgroup (A.map f) (map_le_iff_le_comap.mpr hA) with hb | ht
  · exact Or.inl ((map_eq_bot_iff A).mp hb)
  · right
    have hsup : A⊔f.ker=(translations F).comap f := by
      rw [←comap_map_eq,ht]
    have hck : ⁅f.ker,(⊤ : Subgroup E)⁆=⊥ := by
      apply commutator_eq_bot_iff_le_centralizer.mpr
      intro x hx y _
      exact mem_center_iff.mp (hk hx) y
    have hle : (translations F).comap f≤A := by
      rw [←hcomm,←hsup]
      exact commutator_sup_le_of_relative_normal ⊤ A f.ker ⊤ A
        (by simp only [A.normalizer_eq_top]; exact le_rfl) le_top le_top
        (commutator_le_left A ⊤) (by rw [hck]; exact bot_le)
    exact le_antisymm hA hle

end Matrix.SL2
