module

public import Theory.SpecificGroups.SL2.BinaryTetrahedralQuotient
public import Theory.GroupTheory.PResidual.Defs
public import Theory.PGroupCore

/-!
# The two-residual and two-core of SL₂(3)

The binary tetrahedral presentation is generated by the cubic generator and
its conjugates, so it has no nontrivial two-group quotient. Its projection
onto C₃ has quaternion kernel, which is exactly its two-core. Transport keeps
the actual matrix group, rather than substituting a group of order 24.

This is the factor calculation in Aschbacher, *Sporadic Groups* (1994),
Hypothesis 45.1 and Lemma 45.2, printed pp.242–243.
-/

public section
open Subgroup
namespace GLS3.Chapter5.SchurPresentation

theorem binaryTetrahedral_twoPerfect : IsPPerfect 2 BinaryTetrahedral := by
  intro N hN hp
  let := hN
  let f := QuotientGroup.mk' N
  have ht : f binaryT = 1 := by
    apply orderOf_eq_one_iff.mp
    have hd : orderOf (f binaryT) ∣ 3 := by
      apply orderOf_dvd_of_pow_eq_one
      rw [← map_pow, binaryT_cube, map_one]
    exact Nat.eq_one_of_dvd_coprimes (hp.orderOf_coprime (by decide : Nat.Coprime 2 3) _) dvd_rfl hd
  have hi : f binaryI = 1 := by
    have hh := congrArg f binary_commutator_eq_conjugate
    simp only [map_mul, map_inv, map_pow, ht, one_pow, inv_one, mul_one, one_mul,
      inv_mul_cancel] at hh
    exact hh.symm
  have hj : f binaryJ = 1 := by
    have hh := congrArg f binary_commutator_pair_eq_conjugate
    simp only [map_mul, map_inv, map_pow, ht, hi, one_pow, inv_one, mul_one, one_mul] at hh
    exact hh.symm
  have hf : f = 1 := binary_hom_ext f 1 hi hj ht
  apply top_unique
  intro x _
  exact (QuotientGroup.eq_one_iff x).mp (show f x = 1 from DFunLike.congr_fun hf x)

/-- The actual quaternion kernel is the full two-core. -/
theorem binaryTetrahedral_twoCore_eq :
    pCore 2 BinaryTetrahedral =
      (SemidirectProduct.inl : QuaternionGroup 2 →* BinaryTetrahedral).range := by
  let i : QuaternionGroup 2 →* BinaryTetrahedral := SemidirectProduct.inl
  let r : BinaryTetrahedral →* Multiplicative (ZMod 3) := SemidirectProduct.rightHom
  have hn : i.range.Normal := by
    rw [SemidirectProduct.range_inl_eq_ker_rightHom]
    infer_instance
  have hq : IsPGroup 2 (QuaternionGroup 2) := IsPGroup.of_card (n := 3) (by
    rw [Nat.card_eq_fintype_card]; norm_num [QuaternionGroup.card])
  have hi : IsPGroup 2 i.range := hq.of_surjective i.rangeRestrict i.rangeRestrict_surjective
  have hc : IsPGroup 3 (Multiplicative (ZMod 3)) := IsPGroup.of_card (n := 1) (by
    rw [Nat.card_eq_fintype_card]; rfl)
  have hm : (pCore 2 BinaryTetrahedral).map r = ⊥ := by
    have hd := IsPGroup.disjoint_of_coprime (pCore_isPGroup.map r)
      (hc.to_subgroup ⊤) (by decide : Nat.Coprime 2 3)
    simpa using hd
  apply le_antisymm
  · rw [SemidirectProduct.range_inl_eq_ker_rightHom]
    intro z hz
    have hh : r z ∈ (pCore 2 BinaryTetrahedral).map r := ⟨z, hz, rfl⟩
    rwa [hm, mem_bot] at hh
  · exact le_sSup ⟨hn, hi⟩

theorem sl23_twoPerfect : IsPPerfect 2 SL23 :=
  binaryTetrahedral_twoPerfect.of_surjective binaryTetrahedralEquivSL.toMonoidHom
    binaryTetrahedralEquivSL.surjective

noncomputable def sl23_twoCoreEquiv : pCore 2 SL23 ≃* QuaternionGroup 2 :=
  ((pCore 2 BinaryTetrahedral).equivMapOfInjective
    binaryTetrahedralEquivSL.toMonoidHom binaryTetrahedralEquivSL.injective |>.trans
      (MulEquiv.subgroupCongr (pCore_map_iso 2 binaryTetrahedralEquivSL))).symm.trans
    ((MulEquiv.subgroupCongr binaryTetrahedral_twoCore_eq).trans
      (MonoidHom.ofInjective SemidirectProduct.inl_injective).symm)

theorem sl23_card_eq : Nat.card SL23 = 24 :=
  (Nat.card_congr binaryTetrahedralEquivSL.toEquiv).symm.trans binaryTetrahedral_card

theorem sl23_center_card : Nat.card (center SL23) = 2 :=
  (Nat.card_congr (centerCongr binaryTetrahedralEquivSL).toEquiv).symm.trans
    binaryTetrahedral_center_card

end GLS3.Chapter5.SchurPresentation
