module

public import Mathlib.GroupTheory.SpecificGroups.Quaternion
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.Tactic

/-!
# The derived kernel of a central quaternion extension

For a central extension of a generalized quaternion group, the kernel misses
the derived subgroup. Lifts r and s of the standard generators generate
modulo the central kernel, and the derived subgroup is contained in the
cyclic group generated by [s,r]. The relation s² = rⁿ modulo the kernel
forces [s,r]ⁿ = 1. Its image has order n, so the map is injective on this
cyclic group.

The generating and conjugation argument adapts the checked proof in
`Theory.GroupTheory.Commutator.CentralDihedral`; the extra quaternion relation
strengthens its bound to a trivial derived kernel. Together with central
Sylow transfer, this proves the two-primary splitting needed for SL₂.

Source: the elementary quaternion-cover calculation underlying GLS3 §6.1
and Aschbacher–Smith I.1.1–3, printed p.407. Only the two-primary consequence
is used; no full Schur-multiplier computation is assumed.
-/

open scoped commutatorElement
open Subgroup

namespace CentralExtension

private theorem quaternion_conj {n : ℕ} :
    (QuaternionGroup.xa 0 : QuaternionGroup n) * QuaternionGroup.a 1 *
      (QuaternionGroup.xa 0)⁻¹ = (QuaternionGroup.a 1)⁻¹ := by
  have hi : (QuaternionGroup.a 1 : QuaternionGroup n)⁻¹ = QuaternionGroup.a (-1) := by
    symm
    apply eq_inv_of_mul_eq_one_left
    simp
  apply mul_inv_eq_iff_eq_mul.mpr
  rw [hi]
  simp

private theorem commutator_conj_relations
    {G : Type*} [Group G] (r s : G)
    (hs : s ^ 2 ∈ center G)
    (hr : s * r * s⁻¹ * r ∈ center G) :
    Commute r ⁅s, r⁆ ∧ s * ⁅s, r⁆ * s⁻¹ = ⁅s, r⁆⁻¹ := by
  let a := s * r * s⁻¹ * r
  have hform : s * r * s⁻¹ = a * r⁻¹ := by dsimp [a]; group
  have hacomm : Commute a r := (mem_center_iff.mp hr r).symm
  have htcomm : Commute (s * r * s⁻¹) r := by
    rw [hform]
    exact hacomm.mul_left (Commute.refl r).inv_left
  have hrc : Commute r ⁅s, r⁆ := by
    change r * (s * r * s⁻¹ * r⁻¹) = (s * r * s⁻¹ * r⁻¹) * r
    calc
      r * (s * r * s⁻¹ * r⁻¹) = (r * (s * r * s⁻¹)) * r⁻¹ := by group
      _ = ((s * r * s⁻¹) * r) * r⁻¹ := by rw [htcomm.eq]
      _ = (s * r * s⁻¹ * r⁻¹) * r := by group
  have hsconj : s * (s * r * s⁻¹) * s⁻¹ = r := by
    calc
      s * (s * r * s⁻¹) * s⁻¹ = s ^ 2 * r * (s ^ 2)⁻¹ := by
        simp only [pow_two]; group
      _ = r := by rw [← (mem_center_iff.mp hs r)]; group
  refine ⟨hrc, ?_⟩
  calc
    s * ⁅s, r⁆ * s⁻¹ =
        (s * (s * r * s⁻¹) * s⁻¹) * (s * r * s⁻¹)⁻¹ := by
          simp only [commutatorElement_def]; group
    _ = r * (s * r * s⁻¹)⁻¹ := by rw [hsconj]
    _ = ⁅s, r⁆⁻¹ := by simp only [commutatorElement_def]; group

private theorem eq_top_of_quaternion_lifts
    {G : Type*} [Group G] {n : ℕ} [NeZero n]
    (f : G →* QuaternionGroup n) (r s : G)
    (hr : f r = QuaternionGroup.a 1) (hs : f s = QuaternionGroup.xa 0)
    (H : Subgroup G) (hker : f.ker ≤ H) (hrH : r ∈ H) (hsH : s ∈ H) :
    H = ⊤ := by
  apply top_unique
  intro g _
  have lift_mem (d : G) (hd : d ∈ H) (hfd : f d = f g) : g ∈ H := by
    have hk : g * d⁻¹ ∈ f.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hfd, mul_inv_cancel]
    simpa using H.mul_mem (hker hk) hd
  cases hfg : f g with
  | a i =>
      apply lift_mem (r ^ i.val) (H.pow_mem hrH i.val)
      simp [map_pow, hr, hfg]
  | xa i =>
      apply lift_mem (s * r ^ i.val) (H.mul_mem hsH (H.pow_mem hrH i.val))
      simp [map_pow, hr, hs, hfg]

private theorem derived_le_lift_commutator
    {G : Type*} [Group G] {n : ℕ} [NeZero n]
    (f : G →* QuaternionGroup n) (hker : f.ker ≤ center G)
    (r s : G) (hr : f r = QuaternionGroup.a 1) (hs : f s = QuaternionGroup.xa 0) :
    _root_.commutator G ≤ zpowers ⁅s, r⁆ ∧
      s * ⁅s, r⁆ * s⁻¹ = ⁅s, r⁆⁻¹ := by
  have hsr : s * r * s⁻¹ * r ∈ center G := by
    apply hker
    rw [MonoidHom.mem_ker, map_mul, map_mul, map_mul, map_inv, hr, hs]
    rw [quaternion_conj, inv_mul_cancel]
  have hs2 : s ^ 2 ∈ center G := by
    let a := s * r * s⁻¹ * r
    have hform : s * r * s⁻¹ = a * r⁻¹ := by dsimp [a]; group
    have har : Commute a r := (mem_center_iff.mp hsr r).symm
    have has : s * a * s⁻¹ = a := by
      have hh : s * a = a * s := mem_center_iff.mp hsr s
      rw [hh]; group
    have hconj : s ^ 2 * r * (s ^ 2)⁻¹ = r := by
      calc
        s ^ 2 * r * (s ^ 2)⁻¹ = s * (s * r * s⁻¹) * s⁻¹ := by
          simp only [pow_two]; group
        _ = s * (a * r⁻¹) * s⁻¹ := by rw [hform]
        _ = (s * a * s⁻¹) * (s * r * s⁻¹)⁻¹ := by group
        _ = a * (a * r⁻¹)⁻¹ := by rw [has, hform]
        _ = r := by rw [mul_inv_rev, inv_inv, ← mul_assoc, har.eq]; group
    have htop : centralizer ({s ^ 2} : Set G) = ⊤ := by
      apply eq_top_of_quaternion_lifts f r s hr hs
      · intro k hk
        exact mem_centralizer_singleton_iff.mpr (mem_center_iff.mp (hker hk) _).symm
      · exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hconj).symm
      · apply mem_centralizer_singleton_iff.mpr
        simp [pow_two, mul_assoc]
    apply mem_center_iff.mpr
    intro x
    exact mem_centralizer_singleton_iff.mp (show x ∈ centralizer ({s ^ 2} : Set G) by rw [htop]; trivial)
  obtain ⟨hrc, hsc⟩ := commutator_conj_relations r s hs2 hsr
  let C : Subgroup G := zpowers ⁅s, r⁆
  have hnorm : C.Normal := by
    apply normalizer_eq_top_iff.mp
    apply eq_top_of_quaternion_lifts f r s hr hs
    · intro k hk
      rw [mem_normalizer_iff_map_conj_eq]
      dsimp [C]
      rw [MonoidHom.map_zpowers]
      congr 1
      change k * ⁅s, r⁆ * k⁻¹ = ⁅s, r⁆
      rw [← mem_center_iff.mp (hker hk) ⁅s, r⁆]
      group
    · rw [mem_normalizer_iff_map_conj_eq]
      dsimp [C]
      rw [MonoidHom.map_zpowers]
      congr 1
      change r * ⁅s, r⁆ * r⁻¹ = ⁅s, r⁆
      rw [hrc.eq]
      group
    · rw [mem_normalizer_iff_map_conj_eq]
      dsimp [C]
      rw [MonoidHom.map_zpowers]
      change zpowers (s * ⁅s, r⁆ * s⁻¹) = zpowers ⁅s, r⁆
      rw [hsc, zpowers_inv]
  let : C.Normal := hnorm
  let q : G →* G ⧸ C := QuotientGroup.mk' C
  have hqcomm : Commute (q s) (q r) := by
    apply commutatorElement_eq_one_iff_mul_comm.mp
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr (mem_zpowers ⁅s, r⁆)
  have hqker (k : G) (hk : k ∈ f.ker) : q k ∈ center (G ⧸ C) := by
    rw [mem_center_iff]
    intro y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective C y
    simpa only [map_mul] using congrArg q (mem_center_iff.mp (hker hk) x)
  have hqcentral (a : G) (har : Commute (q a) (q r))
      (has : Commute (q a) (q s)) : q a ∈ center (G ⧸ C) := by
    have hH : (centralizer ({q a} : Set (G ⧸ C))).comap q = ⊤ := by
      apply eq_top_of_quaternion_lifts f r s hr hs
      · intro k hk
        exact mem_centralizer_singleton_iff.mpr (mem_center_iff.mp (hqker k hk) (q a)).symm
      · exact mem_centralizer_singleton_iff.mpr har.eq.symm
      · exact mem_centralizer_singleton_iff.mpr has.eq.symm
    rw [mem_center_iff]
    intro y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective C y
    have hx : q x ∈ centralizer ({q a} : Set (G ⧸ C)) := by
      change x ∈ (centralizer ({q a} : Set (G ⧸ C))).comap q
      rw [hH]; trivial
    exact mem_centralizer_singleton_iff.mp hx
  have hqr := hqcentral r (Commute.refl _) hqcomm.symm
  have hqs := hqcentral s hqcomm (Commute.refl _)
  have htop : (center (G ⧸ C)).comap q = ⊤ :=
    eq_top_of_quaternion_lifts f r s hr hs _ hqker hqr hqs
  have habel : IsMulCommutative (G ⧸ C) := by
    apply center_eq_top_iff.mp
    apply top_unique
    intro y _
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective C y
    change x ∈ (center (G ⧸ C)).comap q
    rw [htop]; trivial
  exact ⟨Normal.quotient_commutative_iff_commutator_le.mp habel, hsc⟩


/-- A central quaternion extension has trivial derived kernel. -/
public theorem ker_inf_commutator_eq_bot_of_quaternion
    {G : Type*} [Group G] [Finite G] {n : ℕ} [NeZero n]
    (f : G →* QuaternionGroup n) (hf : Function.Surjective f)
    (hker : f.ker ≤ center G) :
    f.ker ⊓ _root_.commutator G = ⊥ := by
  obtain ⟨r, hr⟩ := hf (QuaternionGroup.a 1)
  obtain ⟨s, hs⟩ := hf (QuaternionGroup.xa 0)
  obtain ⟨hderived, hconj⟩ := derived_le_lift_commutator f hker r s hr hs
  have hk : r ^ n * (s ^ 2)⁻¹ ∈ f.ker := by
    simp [MonoidHom.mem_ker, hr, hs]
  have hsn : Commute s (r ^ n) := by
    have hh := mem_center_iff.mp (hker hk) s
    change s * (r ^ n * (s ^ 2)⁻¹) = (r ^ n * (s ^ 2)⁻¹) * s at hh
    have he : (r ^ n * (s ^ 2)⁻¹) * s = (r ^ n * s) * (s ^ 2)⁻¹ := by
      simp only [pow_two]; group
    rw [he, ← mul_assoc] at hh
    exact mul_right_cancel hh
  have hrc : Commute r ⁅s, r⁆ := by
    have hz := hker (show s * r * s⁻¹ * r ∈ f.ker by
      rw [MonoidHom.mem_ker, map_mul, map_mul, map_mul, map_inv, hr, hs]
      rw [quaternion_conj, inv_mul_cancel])
    have hh := mem_center_iff.mp hz r
    simp only [commutatorElement_def]
    change r * (s * r * s⁻¹ * r⁻¹) = (s * r * s⁻¹ * r⁻¹) * r
    have he : r * (s * r * s⁻¹) = (s * r * s⁻¹) * r := by
      apply mul_right_cancel (b := r)
      simpa only [mul_assoc] using hh
    calc
      r * (s * r * s⁻¹ * r⁻¹) = (r * (s * r * s⁻¹)) * r⁻¹ := by group
      _ = ((s * r * s⁻¹) * r) * r⁻¹ := by rw [he]
      _ = (s * r * s⁻¹ * r⁻¹) * r := by group
  have hpow : ⁅s, r⁆ ^ n = 1 := by
    have hform : s * r * s⁻¹ = ⁅s, r⁆ * r := by
      simp only [commutatorElement_def]; group
    have hh : ⁅s, r⁆ ^ n * r ^ n = r ^ n := by
      rw [← hrc.symm.mul_pow, ← hform, conj_pow, hsn.eq]
      group
    exact mul_right_cancel (hh.trans (one_mul _).symm)
  have horder : orderOf (f ⁅s, r⁆) = n := by
    have he : f ⁅s, r⁆ = ((QuaternionGroup.a 1) ^ 2)⁻¹ := by
      rw [map_commutatorElement, commutatorElement_def, hr, hs]
      rw [quaternion_conj]
      group
    rw [he, orderOf_inv, orderOf_pow, QuaternionGroup.orderOf_a_one]
    simp
  apply (f.ker ⊓ _root_.commutator G).eq_bot_iff_forall.mpr
  intro x hx
  obtain ⟨i, rfl⟩ := mem_zpowers_iff.mp (hderived hx.2)
  have hi : (n : ℤ) ∣ i := by
    rw [← horder, orderOf_dvd_iff_zpow_eq_one]
    rw [← map_zpow]
    exact hx.1
  obtain ⟨j, rfl⟩ := hi
  rw [zpow_mul, zpow_natCast, hpow, one_zpow]

end CentralExtension
