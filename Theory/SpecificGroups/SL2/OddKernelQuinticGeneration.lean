module
public import Theory.GroupTheory.SolvableTwoFiveInvolution
public import Theory.GroupTheory.GeneralizedFitting.PerfectCoreTwoExtension.SolvableKernel
public import Theory.GroupTheory.NormalSylowQuotientAction
public import Theory.GroupTheory.SylowCoprimeEquivalence
public import Theory.SpecificGroups.GL2.ProjectiveFourGroupObstruction
public import GorensteinWalter.SL2ProjectiveCover

/-!
# Excluding odd-by-SL₂ containers in quintic generation

An odd kernel preserves the unique involution in each SL₂ Sylow. Its
restriction to a perfect subgroup with simple two-core quotient is both
odd and a two-group, hence trivial. Thus that subgroup also has a unique
involution. The actor–Sylow intersection fixes this involution by the
solvable two-five lemma. The original subgroup, Sylow and actor generate
the ambient group, making the involution central and contradicting its
trivial two-core.

This uses the actual odd kernel and the original subgroup inclusions;
no splitting, field-five identification or center–Frattini equality is
assumed. Source application: Aschbacher–Smith A.3.6(3–4) and 5.2.2,
printed pp.43–45 and 648–649.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
namespace Theory.SpecificGroups.SL2.OddKernel

private theorem sl2_involution_eq {F : Type*} [Field F]
    (h2 : (2 : F) ≠ 0) (x : SL(2,F)) (hx : orderOf x = 2) : x = -1 := by
  have hp : x ^ 2 = 1 := by simpa only [hx] using pow_orderOf_eq_one x
  have hd : (Matrix.SpecialLinearGroup.toGL x).det = 1 := by apply Units.ext; exact x.property
  rcases Matrix.GeneralLinearGroup.eq_one_or_neg_one_of_sq_eq_one_of_det_eq_one h2
      (Matrix.SpecialLinearGroup.toGL x) (by rw [←map_pow,hp,map_one]) hd with he | he
  · have he' : x = 1 := Matrix.SpecialLinearGroup.toGL_injective (by simpa using he)
    simp [he'] at hx
  · exact Subtype.ext (congrArg Units.val he)

private theorem odd_sl2_sylow
    {Y F : Type*} [Group Y] [Finite Y] [Field F] [Finite F]
    (f : Y →* SL(2,F)) (hf : Function.Surjective f)
    (hk : Nat.Coprime 2 (Nat.card f.ker)) (ho : Odd (Nat.card F))
    (S : Sylow 2 Y) :
    8 ∣ Nat.card S ∧
      (∀ x y : S, orderOf x = 2 → orderOf y = 2 → x = y) := by
  let P := S.mapSurjective hf
  let e : S ≃* P := Sylow.equivOfSurjectiveCoprime f hf hk S P
  have h8 : 8 ∣ Nat.card SL(2,F) := by
    rw [GorensteinWalter.sl2_card_formula]
    have hh : 8 ∣ Nat.card F ^ 2 - 1 := by
      have hmod : Nat.card F % 2 = 1 := Nat.odd_iff.mp ho
      have hsq : Nat.card F ^ 2 % 8 = 1 := by
        rcases (show Nat.card F % 8 = 1 ∨ Nat.card F % 8 = 3 ∨
            Nat.card F % 8 = 5 ∨ Nat.card F % 8 = 7 by omega) with hh | hh | hh | hh <;>
          simp [Nat.pow_mod,hh]
      exact Nat.dvd_of_mod_eq_zero (by omega)
    exact dvd_mul_of_dvd_right hh _
  constructor
  · rw [Nat.card_congr e.toEquiv]
    exact P.pow_dvd_card_of_pow_dvd_card (n := 3) h8
  · intro x y hx hy
    apply e.injective
    apply Subtype.ext
    have h2 := GorensteinWalter.two_ne_zero_of_odd_card F ho
    exact (sl2_involution_eq h2 (e x) ((orderOf_coe _).trans ((e.orderOf_eq _).trans hx))).trans
      (sl2_involution_eq h2 (e y) ((orderOf_coe _).trans ((e.orderOf_eq _).trans hy))).symm

/-- An odd-by-SL₂ normal subgroup containing the original perfect section
cannot occur in a core-free group generated by that section and a solvable
actor–Sylow join whose odd part divides five. -/
theorem not_generated_by_five_actor
    {Y F : Type*} [Group Y] [Finite Y] [Field F] [Finite F]
    (K R D : Subgroup Y) [K.Normal] [Group.IsPerfect R]
    [IsSimpleGroup (R ⧸ pCore 2 R)] (hRK : R ≤ K)
    (P : Sylow 2 Y) (hPR : (P : Subgroup Y) ≤ normalizer (R : Set Y))
    (f : K →* SL(2,F)) (hf : Function.Surjective f)
    (hk : Nat.Coprime 2 (Nat.card f.ker)) [Group.IsSolvable f.ker]
    (ho : Odd (Nat.card F)) (hReven : 2 ∣ Nat.card R)
    (hzero : pCore 2 Y = ⊥) (hgen : R ⊔ (D ⊔ (P : Subgroup Y)) = ⊤)
    (hs : Group.IsSolvable (D ⊔ (P : Subgroup Y) : Subgroup Y))
    {a : ℕ} (hd : Nat.card (D ⊔ (P : Subgroup Y) : Subgroup Y) ∣ 2^a*5) : False := by
  let fR := f.comp (inclusion hRK)
  have hker : fR.ker = f.ker.comap (inclusion hRK) := rfl
  let : Group.IsSolvable fR.ker := by
    rw [hker]
    apply Group.isSolvable_of_isSolvable_injective (f := (inclusion hRK).subgroupComap f.ker)
    intro x y hxy
    apply Subtype.ext
    apply (inclusion_injective hRK)
    exact congrArg Subtype.val hxy
  have hRcop : Nat.Coprime 2 (Nat.card fR.ker) := by
    rw [hker]
    exact hk.of_dvd_right (card_comap_dvd_of_injective _ _ (inclusion_injective hRK))
  have hfR : Function.Injective fR := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    apply card_eq_one.mp
    exact (PerfectCoreTwoExtension.ker_isTwoGroup fR).card_eq_or_dvd.resolve_right
      (Nat.prime_two.coprime_iff_not_dvd.mp hRcop)
  have hRunique (x y : R) (hx : orderOf x = 2) (hy : orderOf y = 2) : x = y := by
    apply hfR
    have h2 := GorensteinWalter.two_ne_zero_of_odd_card F ho
    exact (sl2_involution_eq h2 (fR x) ((orderOf_injective fR hfR x).trans hx)).trans
      (sl2_involution_eq h2 (fR y) ((orderOf_injective fR hfR y).trans hy)).symm
  obtain ⟨Q,hQ⟩ := NormalSylowQuotientAction.intersection_sylow P R hPR
  obtain ⟨w,hw⟩ := exists_prime_orderOf_dvd_card' (G := Q) 2
    (Q.dvd_card_of_dvd_card hReven)
  let zR : R := w.val
  let z : Y := zR.val
  have hzR : orderOf zR = 2 := (orderOf_coe w).trans hw
  have hz : orderOf z = 2 := (orderOf_coe zR).trans hzR
  have hzP : z ∈ P := by
    have hwQ : zR ∈ (Q : Subgroup R) := w.property
    rw [hQ] at hwQ
    exact hwQ
  have hzK : z ∈ K := hRK zR.property
  let J := (D ⊔ (P : Subgroup Y)).subgroupOf K
  obtain ⟨S,hS⟩ := P.exists_subgroupOf_eq_of_normal K
  have hSJ : (S : Subgroup K) ≤ J := by rw [hS]; exact comap_mono le_sup_right
  have hzS : (⟨z,hzK⟩ : K) ∈ S := by
    change (⟨z,hzK⟩ : K) ∈ (S : Subgroup K)
    rw [hS]
    exact hzP
  let zS : S := ⟨⟨z,hzK⟩,hzS⟩
  have hzSorder : orderOf zS = 2 :=
    (orderOf_coe zS).symm.trans ((orderOf_coe (⟨z,hzK⟩ : K)).symm.trans hz)
  have hJs : Group.IsSolvable J := by
    let := hs
    let g : J →* (D ⊔ (P : Subgroup Y) : Subgroup Y) :=
      { toFun := fun x => ⟨x.val.val,x.property⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl }
    apply Group.isSolvable_of_isSolvable_injective (f := g)
    intro x y hh
    exact Subtype.ext (Subtype.ext
      (congrArg (fun v : (D ⊔ (P : Subgroup Y) : Subgroup Y) => (v : Y)) hh))
  have hJd : Nat.card J ∣ 2^a*5 :=
    (card_comap_dvd_of_injective _ K.subtype K.subtype_injective).trans hd
  obtain ⟨h8,hu⟩ := odd_sl2_sylow f hf hk ho S
  let SJ := S.subtype hSJ
  let eSJ : SJ ≃* S := subgroupOfEquivOfLe hSJ
  have h8J : 8 ∣ Nat.card J := h8.trans (card_dvd_of_le hSJ)
  have hcentral (x : Y) (hx : x ∈ R ∨ x ∈ (P : Subgroup Y)) : x*z*x⁻¹=z := by
    have hn : x ∈ normalizer (R : Set Y) := hx.elim (fun hx => R.le_normalizer hx) (fun hx => hPR hx)
    have hm : x*z*x⁻¹ ∈ R := (mem_normalizer_iff.mp hn z).mp zR.property
    have hh := congrArg Subtype.val (hRunique ⟨_,hm⟩ zR
      ((orderOf_coe _).symm.trans (((MulAut.conj x).orderOf_eq z).trans hz)) hzR)
    exact hh
  have hD (x : Y) (hx : x ∈ D) : x*z*x⁻¹=z := by
    let b : MulAut K := MulAut.conjNormal x
    have hJ : J.map b.toMonoidHom = J := by
      ext y
      rw [mem_map_equiv]
      change (b.symm y).val ∈ D ⊔ (P : Subgroup Y) ↔ y.val ∈ D ⊔ (P : Subgroup Y)
      rw [MulAut.conjNormal_symm_apply]
      exact ((mem_normalizer_iff''.mp ((D ⊔ (P : Subgroup Y)).le_normalizer
        (show x ∈ D ⊔ (P : Subgroup Y) from (show D ≤ D ⊔ (P : Subgroup Y) from le_sup_left) hx))) y.val).symm
    let ψ : MulAut J := (J.equivMapOfInjective b.toMonoidHom b.injective).trans
      (MulEquiv.subgroupCongr hJ)
    have hh := Theory.GroupTheory.TwoFive.fixed_involution hJs hJd h8J SJ
      (fun u v hu' hv' => eSJ.injective (hu (eSJ u) (eSJ v)
        ((eSJ.orderOf_eq u).trans hu') ((eSJ.orderOf_eq v).trans hv')))
      (eSJ.symm zS) ((eSJ.symm.orderOf_eq _).trans hzSorder) ψ
    exact congrArg (fun v : J => v.val.val) hh
  have hzcenter : z ∈ center Y := by
    have hall : R ⊔ (D ⊔ (P : Subgroup Y)) ≤ centralizer ({z} : Set Y) := by
      refine sup_le ?_ (sup_le ?_ ?_)
      · intro x hx
        exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp (hcentral x (.inl hx)))
      · intro x hx
        exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp (hD x hx))
      · intro x hx
        exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp (hcentral x (.inr hx)))
    rw [hgen] at hall
    exact mem_center_iff.mpr (fun x => mem_centralizer_singleton_iff.mp (hall (mem_top x)))
  let Z := zpowers z
  have hZc : Z ≤ center Y := zpowers_le.mpr hzcenter
  let : Z.Normal := ⟨fun x hx g => by
    have hh := mem_center_iff.mp (hZc hx) g
    simpa only [hh,mul_inv_cancel_right] using hx⟩
  have hZp : IsPGroup 2 Z := IsPGroup.of_card (n := 1) (by simpa only [Z,Nat.card_zpowers,pow_one] using hz)
  have hZ : Z ≤ pCore 2 Y := le_sSup ⟨inferInstance,hZp⟩
  have hz1 : z = 1 := mem_bot.mp (hzero ▸ hZ (mem_zpowers z))
  simp [hz1] at hz


end Theory.SpecificGroups.SL2.OddKernel
