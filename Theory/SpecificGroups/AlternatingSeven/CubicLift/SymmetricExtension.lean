module
public import Theory.SpecificGroups.AlternatingSeven.CubicLift
public import Theory.SpecificGroups.SymmetricSeven.ThreePairsCubic

/-!
# Cubic lifts under the original ambient conjugation action

A normal quasisimple odd-center A₇ cover carries the restriction of the
original seven-letter permutation map. Any prescribed two-subgroup
normalizing an even cubic image admits an invariant lift of order three.
The actual three-pair cubic supplies the natural-module consumer, including
subgroups generated by fewer than three of the disjoint swaps.

Source: Aschbacher–Smith C.1.24, printed pp.130–131. The literal
permutation map and ambient conjugation action are retained; the central
three-kernel is allowed.
-/

public section

open Subgroup Equiv Theory.GroupTheory
namespace Theory.SpecificGroups.AlternatingSeven.CubicLift
open GLS3.Chapter5
variable {G : Type*} [Group G] [Finite G]

/-- Lift a selected cubic for the actual ambient two-group action. -/
theorem exists_ambient_cubic (L : Subgroup G) [L.Normal] [IsQuasisimple L]
    (e : L ⧸ center L ≃* alternatingGroup (Fin 7)) (hodd : Odd (Nat.card (center L)))
    (q : G →* Perm (Fin 7))
    (hqL : ∀ x : L, q x = (alternatingQuotientHom e x : Perm (Fin 7)))
    (R : Subgroup G) (hpR : IsPGroup 2 R)
    (c : Perm (Fin 7)) (hc : orderOf c = 3) (hce : c ∈ alternatingGroup (Fin 7))
    (hnorm : R.map q ≤ normalizer (zpowers c : Set (Perm (Fin 7)))) :
    ∃ Y : Subgroup G, Y ≤ L ∧ Nat.card Y = 3 ∧
      R ≤ normalizer (Y : Set G) ∧ Y.map q = zpowers c := by
  let z : alternatingGroup (Fin 7) := ⟨c,hce⟩
  let P := zpowers z
  have hP : Nat.card P = 3 := by
    rw [Nat.card_zpowers,←Subgroup.orderOf_coe z]
    exact hc
  have hPm : P.map (alternatingGroup (Fin 7)).subtype = zpowers c := MonoidHom.map_zpowers _ z
  let ρ : R →* MulAut L := MulAut.conjNormal.comp R.subtype
  have hstable : ∀ a : R, ∀ x : L, alternatingQuotientHom e x ∈ P →
      alternatingQuotientHom e (ρ a x) ∈ P := by
    intro a x hx
    have hx' : q (x:G) ∈ zpowers c := by
      rw [hqL x,←hPm]
      exact mem_map_of_mem (alternatingGroup (Fin 7)).subtype hx
    have ha : q (a:G) ∈ R.map q := mem_map_of_mem q a.property
    have hy := le_normalizer_iff.mp hnorm (q (a:G)) ha (q (x:G)) hx'
    have he : (alternatingQuotientHom e (ρ a x) : Perm (Fin 7)) =
        q (a:G)*q (x:G)*(q (a:G))⁻¹ := by
      rw [←hqL (ρ a x)]
      change q ((a:G)*(x:G)*(a:G)⁻¹)=_
      rw [map_mul,map_mul,map_inv]
    have hmem : (alternatingQuotientHom e (ρ a x) : Perm (Fin 7)) ∈
        P.map (alternatingGroup (Fin 7)).subtype := by rwa [hPm,he]
    obtain ⟨y,hy,hey⟩ := hmem
    exact (Subtype.ext hey : y = alternatingQuotientHom e (ρ a x)) ▸ hy
  obtain ⟨M,hM,hMp,_,hMi⟩ := exists_invariant_lift_of_odd_center e hodd ρ hpR P hP hstable
  let Y := M.map L.subtype
  have hY : R ≤ normalizer (Y : Set G) := by
    apply le_normalizer_iff.mpr
    intro a ha x hx
    obtain ⟨x,hx,rfl⟩ := hx
    exact ⟨ρ ⟨a,ha⟩ x,hMi ⟨a,ha⟩ x hx,rfl⟩
  have hm : Y.map q = zpowers c := by
    have hf : q.comp L.subtype =
        (alternatingGroup (Fin 7)).subtype.comp (alternatingQuotientHom e) :=
      MonoidHom.ext hqL
    change (M.map L.subtype).map q=zpowers c
    rw [map_map,hf,←map_map,hMp,hPm]
  exact ⟨Y,map_subtype_le M,(card_map_of_injective L.subtype_injective).trans hM,hY,hm⟩

/-- The literal three-pair cubic has an invariant order-three lift in the original cover. -/
theorem exists_pair_cubic (L : Subgroup G) [L.Normal] [IsQuasisimple L]
    (e : L ⧸ center L ≃* alternatingGroup (Fin 7)) (hodd : Odd (Nat.card (center L)))
    (q : G →* Perm (Fin 7))
    (hqL : ∀ x : L, q x = (alternatingQuotientHom e x : Perm (Fin 7)))
    (R : Subgroup G) (hpR : IsPGroup 2 R)
    (hR : R.map q ≤ Representation.AlternatingSevenConjugatePair.ElementaryGeometry.pairElementary) :
    ∃ Y : Subgroup G, Y ≤ L ∧ Nat.card Y = 3 ∧
      R ≤ normalizer (Y : Set G) ∧
      Y.map q = zpowers SymmetricSeven.ThreePairsCubic.cubic :=
  exists_ambient_cubic L e hodd q hqL R hpR
    SymmetricSeven.ThreePairsCubic.cubic
    SymmetricSeven.ThreePairsCubic.cubic_order
    SymmetricSeven.ThreePairsCubic.cubic_even
    (hR.trans SymmetricSeven.ThreePairsCubic.pairElementary_normalizes_cubic)

end Theory.SpecificGroups.AlternatingSeven.CubicLift
