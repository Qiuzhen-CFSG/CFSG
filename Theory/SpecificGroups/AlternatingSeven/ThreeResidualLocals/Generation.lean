module

public import Theory.GroupTheory.PrimePowerGenerated
public import Mathlib.GroupTheory.Perm.Cycle.Type
import Mathlib.Tactic

/-!
# Three-prime residuals in a faithful seven-point action

Every cycle of a three-element has length a power of three and at most seven,
hence has length three. Thus every three-element is killed by three. This
identifies the prime-power-generated subgroup with the closure of elements of
order three, and supplies that generation property to any actual residual.

Source: the convention O^{3'} used in Aschbacher–Smith 15.3.43(a),(e), printed
pp.1139–1140. The residual here is primePowerGenerated, not a three-core or O^3.
-/

public section

open Subgroup
namespace AlternatingSeven.ThreeResidualLocals

private theorem cube_eq_one_of_three_power (t : Equiv.Perm (Fin 7))
    {n : ℕ} (ht : t ^ (3 ^ n) = 1) : t ^ 3 = 1 := by
  apply Equiv.Perm.pow_prime_eq_one_iff.mpr
  intro c hc
  have hc7 : c ≤ 7 := (Multiset.le_sum_of_mem hc).trans (by simpa using t.sum_cycleType_le)
  obtain ⟨k, _, hk⟩ := (Nat.dvd_prime_pow (by decide : Nat.Prime 3)).mp
    ((Equiv.Perm.dvd_of_mem_cycleType hc).trans (orderOf_dvd_of_pow_eq_one ht))
  have hk1 : k ≤ 1 := by
    by_contra h
    have hh : 3 ^ 2 ≤ 3 ^ k := Nat.pow_le_pow_right (by decide) (by omega)
    omega
  have hc2 := Equiv.Perm.two_le_of_mem_cycleType hc
  interval_cases k <;> norm_num at hk ⊢ <;> omega

/-- In a faithful action on seven points, the three-prime residual is generated by
order-three elements; there are no elements of order nine. -/
theorem map_primePowerGenerated_eq_order_three_closure
    {G : Type*} [Group G] (f : G →* Equiv.Perm (Fin 7))
    (hf : Function.Injective f) (K : Subgroup G) :
    (primePowerGenerated 3 K).map K.subtype =
      closure {g : G | g ∈ K ∧ orderOf g = 3} := by
  rw [map_primePowerGenerated_subtype]
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro g ⟨hg, n, hn⟩
    have h3 : g ^ 3 = 1 := hf (by
      rw [map_pow, map_one]
      apply cube_eq_one_of_three_power (f g)
      rw [← map_pow, hn, map_one])
    have hd := orderOf_dvd_of_pow_eq_one h3
    rcases (Nat.dvd_prime (by decide : Nat.Prime 3)).mp hd with h | h
    · rw [orderOf_eq_one_iff.mp h]
      exact one_mem _
    · exact subset_closure ⟨hg, h⟩
  · apply Subgroup.closure_mono
    rintro g ⟨hg, ho⟩
    refine ⟨hg, 1, ?_⟩
    rw [pow_one, ← ho]
    exact pow_orderOf_eq_one g

/-- The actual residual equality supplies the order-three generation hypothesis for
intrinsic recognition. -/
theorem order_three_generated_of_residual_eq
    {G : Type*} [Group G] (f : G →* Equiv.Perm (Fin 7))
    (hf : Function.Injective f) (Y B : Subgroup G)
    (hY : Y = (primePowerGenerated 3 B).map B.subtype) :
    closure {g : G | g ∈ Y ∧ orderOf g = 3} = Y := by
  have hB : closure {g : G | g ∈ B ∧ orderOf g = 3} = Y :=
    (map_primePowerGenerated_eq_order_three_closure f hf B).symm.trans hY.symm
  apply le_antisymm
  · exact (closure_le _).mpr (fun _ h => h.1)
  · calc
      Y = closure {g : G | g ∈ B ∧ orderOf g = 3} := hB.symm
      _ ≤ closure {g : G | g ∈ Y ∧ orderOf g = 3} := by
        apply Subgroup.closure_mono
        rintro g ⟨hg, ho⟩
        refine ⟨?_, ho⟩
        rw [← hB]
        exact subset_closure ⟨hg, ho⟩

end AlternatingSeven.ThreeResidualLocals
