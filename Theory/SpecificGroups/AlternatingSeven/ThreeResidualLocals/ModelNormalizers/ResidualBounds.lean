module

public import Theory.SpecificGroups.AlternatingSeven.ThreeResidualLocals.ModelNormalizers.WordModels
import Mathlib.Tactic

/-!
# Generation bounds for the concrete three-prime residuals

Each A₄ model is generated by two cubic elements: if its displayed generators
are `x,y`, both `x` and `x*y` have cube one, and `y = x⁻¹*(x*y)`.
For the two four-point models the disjoint cycle `(4 5 6)` also normalizes the
model. Consequently the residual contains A₄ × C₃, strictly larger than either
of those A₄ embeddings. Upper bounds are separate action calculations.

Source: Aschbacher–Smith 15.3.43, printed p.1140; model coordinates from 1.1.5(3)(d).
-/

@[expose] public section
open Equiv Subgroup
namespace AlternatingSeven.ThreeResidualLocals

/-- The cubic permutation on the complementary three points. -/
def tailThree : Perm7 := swap 4 5 * swap 5 6

/-- The common candidate residual of the natural and diagonal models. -/
def expandedFour : Subgroup Perm7 := naturalFour ⊔ zpowers tailThree

private theorem pairClosure_le_residual_of_cubes
    (B : Subgroup Perm7) (x y : Perm7) (hx : x ∈ B) (hy : y ∈ B)
    (hx3 : x ^ 3 = 1) (hxy3 : (x * y) ^ 3 = 1) :
    closure ({x, y} : Set Perm7) ≤ (primePowerGenerated 3 B).map B.subtype := by
  rw [map_primePowerGenerated_subtype]
  let R := closure {g : Perm7 | g ∈ B ∧ ∃ n : ℕ, g ^ (3 ^ n) = 1}
  have hxR : x ∈ R := subset_closure ⟨hx, 1, by simpa using hx3⟩
  have hxyR : x * y ∈ R := subset_closure ⟨B.mul_mem hx hy, 1, by simpa using hxy3⟩
  apply (closure_le _).mpr
  rw [Set.pair_subset_iff]
  refine ⟨hxR, ?_⟩
  simpa using R.mul_mem (R.inv_mem hxR) hxyR

theorem naturalFour_le_threeResidual (B : Subgroup Perm7) (hB : naturalFour ≤ B) :
    naturalFour ≤ (primePowerGenerated 3 B).map B.subtype := by
  apply pairClosure_le_residual_of_cubes B naturalThree fourFlip
  · exact hB (subset_closure (by simp))
  · exact hB (subset_closure (by simp))
  · decide +kernel
  · decide +kernel

theorem diagonalFour_le_threeResidual (B : Subgroup Perm7) (hB : diagonalFour ≤ B) :
    diagonalFour ≤ (primePowerGenerated 3 B).map B.subtype := by
  apply pairClosure_le_residual_of_cubes B diagonalThree fourFlip
  · exact hB (subset_closure (by simp))
  · exact hB (subset_closure (by simp))
  · decide +kernel
  · decide +kernel

theorem pairedFour_le_threeResidual (B : Subgroup Perm7) (hB : pairedFour ≤ B) :
    pairedFour ≤ (primePowerGenerated 3 B).map B.subtype := by
  apply pairClosure_le_residual_of_cubes B pairedThree fourFlip
  · exact hB (subset_closure (by simp))
  · exact hB (subset_closure (by simp))
  · decide +kernel
  · decide +kernel

theorem expandedFour_le_threeResidual (B : Subgroup Perm7) (hB : expandedFour ≤ B) :
    expandedFour ≤ (primePowerGenerated 3 B).map B.subtype := by
  apply sup_le
  · exact naturalFour_le_threeResidual B (le_sup_left.trans hB)
  · apply zpowers_le.mpr
    rw [map_primePowerGenerated_subtype]
    exact subset_closure ⟨hB (mem_sup_right (mem_zpowers tailThree)), 1, by decide +kernel⟩

private theorem natural_normalizer_generators :
    naturalThree ∈ normalizer (naturalFour : Set Perm7) ∧
    fourFlip ∈ normalizer (naturalFour : Set Perm7) ∧
    tailThree ∈ normalizer (naturalFour : Set Perm7) := by
  change naturalThree ∈ normalizer (closure {naturalThree, fourFlip} : Set Perm7) ∧
    fourFlip ∈ normalizer (closure {naturalThree, fourFlip} : Set Perm7) ∧
    tailThree ∈ normalizer (closure {naturalThree, fourFlip} : Set Perm7)
  simp only [mem_normalizer_pair_closure_iff]
  change (naturalThree * naturalThree * naturalThree⁻¹ ∈ naturalFour ∧
    naturalThree * fourFlip * naturalThree⁻¹ ∈ naturalFour) ∧
    (fourFlip * naturalThree * fourFlip⁻¹ ∈ naturalFour ∧
    fourFlip * fourFlip * fourFlip⁻¹ ∈ naturalFour) ∧
    (tailThree * naturalThree * tailThree⁻¹ ∈ naturalFour ∧
    tailThree * fourFlip * tailThree⁻¹ ∈ naturalFour)
  rw [naturalFour_eq_explicit]
  decide +kernel

private theorem diagonal_normalizer_generators :
    naturalThree ∈ normalizer (diagonalFour : Set Perm7) ∧
    fourFlip ∈ normalizer (diagonalFour : Set Perm7) ∧
    tailThree ∈ normalizer (diagonalFour : Set Perm7) := by
  change naturalThree ∈ normalizer (closure {diagonalThree, fourFlip} : Set Perm7) ∧
    fourFlip ∈ normalizer (closure {diagonalThree, fourFlip} : Set Perm7) ∧
    tailThree ∈ normalizer (closure {diagonalThree, fourFlip} : Set Perm7)
  simp only [mem_normalizer_pair_closure_iff]
  change (naturalThree * diagonalThree * naturalThree⁻¹ ∈ diagonalFour ∧
    naturalThree * fourFlip * naturalThree⁻¹ ∈ diagonalFour) ∧
    (fourFlip * diagonalThree * fourFlip⁻¹ ∈ diagonalFour ∧
    fourFlip * fourFlip * fourFlip⁻¹ ∈ diagonalFour) ∧
    (tailThree * diagonalThree * tailThree⁻¹ ∈ diagonalFour ∧
    tailThree * fourFlip * tailThree⁻¹ ∈ diagonalFour)
  rw [diagonalFour_eq_explicit]
  decide +kernel

theorem expandedFour_le_natural_normalizer :
    expandedFour ≤ normalizer (naturalFour : Set Perm7) := by
  apply sup_le
  · exact (closure_le _).mpr (by simpa only [Set.pair_subset_iff, SetLike.mem_coe] using
      (And.intro natural_normalizer_generators.1 natural_normalizer_generators.2.1))
  · exact zpowers_le.mpr natural_normalizer_generators.2.2

theorem expandedFour_le_diagonal_normalizer :
    expandedFour ≤ normalizer (diagonalFour : Set Perm7) := by
  apply sup_le
  · exact (closure_le _).mpr (by simpa only [Set.pair_subset_iff, SetLike.mem_coe] using
      (And.intro diagonal_normalizer_generators.1 diagonal_normalizer_generators.2.1))
  · exact zpowers_le.mpr diagonal_normalizer_generators.2.2

theorem expandedFour_le_alternating : expandedFour ≤ alternatingGroup (Fin 7) := by
  apply sup_le models_le_alternating.1
  apply zpowers_le.mpr
  norm_num [tailThree, Perm.mem_alternatingGroup, map_mul, Perm.sign_swap]
  decide

theorem tailThree_not_mem_naturalFour : tailThree ∉ naturalFour := by
  rw [naturalFour_eq_explicit]
  decide +kernel

theorem tailThree_not_mem_diagonalFour : tailThree ∉ diagonalFour := by
  rw [diagonalFour_eq_explicit]
  decide +kernel

theorem expandedFour_ne_naturalFour : expandedFour ≠ naturalFour := by
  intro h
  exact tailThree_not_mem_naturalFour (h ▸ mem_sup_right (mem_zpowers tailThree))

theorem expandedFour_ne_diagonalFour : expandedFour ≠ diagonalFour := by
  intro h
  exact tailThree_not_mem_diagonalFour (h ▸ mem_sup_right (mem_zpowers tailThree))

theorem expandedFour_le_natural_threeResidual (J : Subgroup Perm7)
    (hJ : alternatingGroup (Fin 7) ≤ J) :
    expandedFour ≤ (primePowerGenerated 3 (J ⊓ normalizer (naturalFour : Set Perm7) : Subgroup Perm7)).map
      (J ⊓ normalizer (naturalFour : Set Perm7)).subtype :=
  expandedFour_le_threeResidual _
    (le_inf (expandedFour_le_alternating.trans hJ) expandedFour_le_natural_normalizer)

theorem expandedFour_le_diagonal_threeResidual (J : Subgroup Perm7)
    (hJ : alternatingGroup (Fin 7) ≤ J) :
    expandedFour ≤ (primePowerGenerated 3 (J ⊓ normalizer (diagonalFour : Set Perm7) : Subgroup Perm7)).map
      (J ⊓ normalizer (diagonalFour : Set Perm7)).subtype :=
  expandedFour_le_threeResidual _
    (le_inf (expandedFour_le_alternating.trans hJ) expandedFour_le_diagonal_normalizer)

theorem pairedFour_le_paired_threeResidual (J : Subgroup Perm7)
    (hJ : alternatingGroup (Fin 7) ≤ J) :
    pairedFour ≤ (primePowerGenerated 3 (J ⊓ normalizer (pairedFour : Set Perm7) : Subgroup Perm7)).map
      (J ⊓ normalizer (pairedFour : Set Perm7)).subtype :=
  pairedFour_le_threeResidual _
    (le_inf (models_le_alternating.2.2.trans hJ) le_normalizer)

end AlternatingSeven.ThreeResidualLocals
