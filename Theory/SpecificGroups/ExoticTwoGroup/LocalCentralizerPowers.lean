module

public import Theory.SpecificGroups.ExoticTwoGroup.LocalModel
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Characteristic lines in the two exotic involution centralizers

The fourth powers in the centralizer of `t` and the squares in the
centralizer of `z₀` take precisely the values `1` and `a²b²`. These finite
identities are kernel-checked in the coordinate model. Since the subgroup
generated by fixed-degree powers is characteristic, they exhibit the
required characteristic line in both centralizers.

Source: Janko–Thompson, Math. Z. 113 (1970), p.396. The power descriptions
make the characteristicity calculation explicit.
-/

namespace ExoticTwoGroup.LocalModel
local instance : DecidableEq Model := inferInstance
set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
public theorem t_fourth_powers : ∀ y : Model, y*t=t*y →
    y^4=1 ∨ y^4=a^2*b^2 := by decide +kernel
set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
public theorem t_fourth_root : ∃ y : Model, y*t=t*y ∧ y^4=a^2*b^2 := by decide +kernel
set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
public theorem z₀_square_powers : ∀ y : Model, y*z₀=z₀*y →
    y^2=1 ∨ y^2=a^2*b^2 := by decide +kernel
set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
public theorem z₀_square_root : ∃ y : Model, y*z₀=z₀*y ∧ y^2=a^2*b^2 := by decide +kernel

open Subgroup
private theorem line_of_powers {G : Type*} [Group G]
    (C : Subgroup G) (z : G) (n : ℕ)
    (hp : ∀ y : G, y ∈ C → y^n=1 ∨ y^n=z)
    (hr : ∃ y : G, y ∈ C ∧ y^n=z) :
    ∃ K : Subgroup C, K.Characteristic ∧ K.map C.subtype = zpowers z := by
  let K := closure (Set.range (fun y : C => y ^ n))
  refine ⟨K, closure_range_pow_characteristic n, le_antisymm ?_ ?_⟩
  · rw [map_le_iff_le_comap]
    apply (closure_le _).mpr
    rintro _ ⟨y, rfl⟩
    change (y : G) ^ n ∈ zpowers z
    rcases hp y y.property with h | h
    · rw [h]; exact one_mem _
    · rw [h]; exact mem_zpowers _
  · apply zpowers_le.mpr
    obtain ⟨y, hy, he⟩ := hr
    exact ⟨(⟨y,hy⟩ : C) ^ n, subset_closure ⟨⟨y,hy⟩,rfl⟩, he⟩

public theorem characteristic_line : ∀ x ∈ ({t,z₀} : Set Model),
    ∃ K : Subgroup (centralizer ({x} : Set Model)), K.Characteristic ∧
      K.map (centralizer ({x} : Set Model)).subtype = zpowers (a^2*b^2) := by
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · apply line_of_powers _ _ 4
    · intro y hy
      exact t_fourth_powers y (mem_centralizer_singleton_iff.mp hy)
    · obtain ⟨y,hy,he⟩ := t_fourth_root
      exact ⟨y,mem_centralizer_singleton_iff.mpr hy,he⟩
  · apply line_of_powers _ _ 2
    · intro y hy
      exact z₀_square_powers y (mem_centralizer_singleton_iff.mp hy)
    · obtain ⟨y,hy,he⟩ := z₀_square_root
      exact ⟨y,mem_centralizer_singleton_iff.mpr hy,he⟩
end ExoticTwoGroup.LocalModel
