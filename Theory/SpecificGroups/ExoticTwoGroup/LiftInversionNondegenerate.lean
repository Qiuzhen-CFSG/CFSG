module
public import Theory.SpecificGroups.ExoticTwoGroup.LiftCorrection
public import Theory.Frattini.BinarySquares
public import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Tactic

/-!
# Nondegeneracy of the inversion commutator from the Frattini identity

In an exotic action frame, the centralizer of the marked four is generated
by the base, the two inner involutions, and the inversion lift. Indeed, the
swap normalizes this subgroup and its square belongs to the base, giving
at most two cosets. Independence of the basis squares shows that the swap
does not centralize the four.

If the first inversion commutator belongs to the four, coordinate parity
forces the second to belong there as well. The five generators then have
commuting involutory images modulo the four. Every square in its centralizer
therefore belongs to the four. Since the Frattini subgroup of a finite
two-group is generated by squares, identifying that Frattini subgroup with
the order-sixteen base gives a contradiction. The Frattini identity is an
explicit input, and no involutory normalization of the inversion lift is used.

The coordinate calculations adapt the private calculations in
`LiftInversionNormalization` without changing that module's public boundary.
Source: MacWilliams, Trans. AMS 150 (1970), §4 (xii), printed pp.392–393;
Janko–Thompson, Math. Z. 113 (1970), 1.4(c), printed p.386.
-/

set_option linter.unusedSimpArgs false
set_option maxRecDepth 2048
open Subgroup
namespace ExoticTwoGroup.ActionFrame
variable {P : Type*} [Group P] {D W B : Subgroup P}
variable (f : ActionFrame D W B)
private def word (i j : ZMod 4) : P := f.a ^ i.val * f.b ^ j.val
private theorem word_zero : f.word 0 0 = 1 := by norm_num [word]
private theorem word_a : f.word 1 0 = f.a := by change f.a ^ 1 * f.b ^ 0 = f.a; simp
private theorem word_b : f.word 0 1 = f.b := by change f.a ^ 0 * f.b ^ 1 = f.b; simp
private theorem word_mul (i j k l : ZMod 4) :
    f.word i j * f.word k l = f.word (i+k) (j+l) := by
  unfold word
  rw [(f.ab.symm.pow_pow j.val k.val).mul_mul_mul_comm, ← pow_add, ← pow_add]
  simpa only [ZMod.val_add] using
    congrArg₂ (· * ·) (pow_eq_pow_mod (i.val + k.val) f.a_four)
      (pow_eq_pow_mod (j.val + l.val) f.b_four)
private theorem word_inv (i j : ZMod 4) : (f.word i j)⁻¹ = f.word (-i) (-j) := by
  apply inv_eq_of_mul_eq_one_right
  rw [f.word_mul]
  simpa using f.word_zero
private theorem word_pow (i j : ZMod 4) (n : ℕ) :
    f.word i j ^ n = f.word ((n : ZMod 4)*i) ((n : ZMod 4)*j) := by
  induction n with
  | zero => simp [f.word_zero]
  | succ n ih => rw [pow_succ, ih, f.word_mul]; simp [Nat.cast_add, add_mul]
private theorem word_injective [IsMulCommutative D] (hD : Nat.card D = 16)
    (i j k l : ZMod 4) (h : f.word i j = f.word k l) : i = k ∧ j = l := by
  have hh := (f.base_word_eq_iff hD ⟨i.val, ZMod.val_lt i⟩ ⟨j.val, ZMod.val_lt j⟩
    ⟨k.val, ZMod.val_lt k⟩ ⟨l.val, ZMod.val_lt l⟩).mp h
  exact ⟨ZMod.val_injective 4 (congrArg Fin.val hh.1),
    ZMod.val_injective 4 (congrArg Fin.val hh.2)⟩
private theorem word_g₂ (i j : ZMod 4) :
    (MulAut.conj f.g₂) (f.word i j) = f.word (-i) (2*i-j) := by
  simp only [word, map_mul, map_pow]
  change (f.g₂ * f.a * f.g₂⁻¹) ^ i.val * (f.g₂ * f.b * f.g₂⁻¹) ^ j.val = _
  rw [f.g₂_a, f.g₂_b]
  rw [← f.word_a, ← f.word_b, f.word_inv, f.word_pow, f.word_mul,
    f.word_inv, f.word_pow, f.word_pow, f.word_mul]
  simp [word, show (1 : ZMod 4).val = 1 from rfl, sub_eq_add_neg, mul_comm]
private theorem word_g₁ (i j : ZMod 4) :
    (MulAut.conj f.g₁) (f.word i j) = f.word (-i+2*j) (-j) := by
  simp only [word, map_mul, map_pow]
  change (f.g₁ * f.a * f.g₁⁻¹) ^ i.val * (f.g₁ * f.b * f.g₁⁻¹) ^ j.val = _
  rw [f.g₁_a, f.g₁_b]
  rw [← f.word_a, ← f.word_b, f.word_inv, f.word_pow,
    f.word_inv, f.word_pow, f.word_mul, f.word_pow, f.word_mul]
  simp [word, show (1 : ZMod 4).val = 1 from rfl, mul_comm]

private theorem exists_word [IsMulCommutative D] {x : P} (hx : x ∈ D) :
    ∃ i j : ZMod 4, f.word i j = x := by
  obtain ⟨i, j, hij⟩ := f.exists_base_word hx
  refine ⟨i.val, j.val, ?_⟩
  simpa only [word, ZMod.val_natCast, Nat.mod_eq_of_lt i.isLt,
    Nat.mod_eq_of_lt j.isLt] using hij
private theorem word_even_mem_four {i j : ZMod 4} (hi : i = 0 ∨ i = 2)
    (hj : j = 0 ∨ j = 2) : f.word i j ∈ W := by
  have ha : f.a ^ 2 ∈ W := f.four.ge (subset_closure (by simp))
  have hb : f.b ^ 2 ∈ W := f.four.ge (subset_closure (by simp))
  rcases hi with rfl | rfl <;> rcases hj with rfl | rfl <;>
    norm_num only [word, show (2 : ZMod 4).val = 2 from rfl, ZMod.val_zero,
      pow_zero, one_mul, mul_one] <;>
    first | exact W.one_mem | exact ha | exact hb | exact W.mul_mem ha hb
private theorem commutator_inverted {z g : P} (hg : g ^ 2 = 1) :
    (MulAut.conj g) (z * g * z⁻¹ * g⁻¹) = (z * g * z⁻¹ * g⁻¹)⁻¹ := by
  have hi : g⁻¹ = g := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hg)
  simp only [MulAut.conj_apply, mul_inv_rev, inv_inv]
  calc
    _ = g * z * g * z⁻¹ * (g ^ 2)⁻¹ := by simp only [pow_two]; group
    _ = _ := by rw [hg]; simp only [inv_one, mul_one, hi, mul_assoc]

private theorem second_commutator_mem_four [D.Normal] [IsMulCommutative D]
    [IsElementaryAbelian 2 W]
    (hDC : centralizer (D : Set P) ≤ D) (hD : Nat.card D = 16)
    (hn : f.z₀ * f.g₁ * f.z₀⁻¹ * f.g₁⁻¹ ∈ W) :
    f.z₀ * f.g₂ * f.z₀⁻¹ * f.g₂⁻¹ ∈ W := by
  obtain ⟨i,j,hij⟩ := f.exists_word (f.z_commutator_mem_base hDC f.g₁)
  obtain ⟨k,l,hkl⟩ := f.exists_word (f.z_commutator_mem_base hDC f.g₂)
  have h₂ := commutator_inverted (z := f.z₀) f.g₂_two
  rw [← hkl, f.word_g₂, f.word_inv] at h₂
  have hrel : f.word i j * (MulAut.conj f.g₁) (f.word k l) =
      f.word k l * (MulAut.conj f.g₂) (f.word i j) := by
    rw [hij, hkl]
    change _ * (f.g₁ * _ * f.g₁⁻¹) = _ * (f.g₂ * _ * f.g₂⁻¹)
    calc
      _ = f.z₀ * (f.g₁ * f.g₂) * f.z₀⁻¹ * (f.g₁ * f.g₂)⁻¹ := by group
      _ = _ := by rw [f.g₁g₂.eq]; group
  rw [f.word_g₁, f.word_g₂, f.word_mul, f.word_mul] at hrel
  have hs : f.word (2*i) (2*j) = f.word 0 0 := by
    have hh := elemPow_eq_one_of_isElementaryAbelian (p := 2) _ hn
    rw [← hij, f.word_pow] at hh
    simpa only [Nat.cast_ofNat, f.word_zero] using hh
  have hi := (f.word_injective hD _ _ _ _ hs).1
  have hk := (by decide : ∀ k l : ZMod 4, 2*k-l = -l → k = 0 ∨ k = 2)
    k l (f.word_injective hD _ _ _ _ h₂).2
  have hl := (by decide : ∀ i k l : ZMod 4, 2*i = 0 →
    (k = 0 ∨ k = 2) → i+(-k+2*l) = k + -i → l = 0 ∨ l = 2)
    i k l hi hk (f.word_injective hD _ _ _ _ hrel).1
  exact hkl ▸ f.word_even_mem_four hk hl

private theorem two_coset_cover (H : Subgroup P) (t : P)
    (ht : ∀ x ∈ H, t * x * t⁻¹ ∈ H) (htsq : t ^ 2 ∈ H)
    {s : Set P} (hgen : closure s = ⊤) (hs : ∀ x ∈ s, x ∈ H ∨ x = t) :
    ∀ x : P, x ∈ H ∨ x * t⁻¹ ∈ H := by
  intro x
  have hx : x ∈ closure s := hgen ▸ mem_top x
  induction hx using Subgroup.closure_induction'' with
  | mem x hx =>
    rcases hs x hx with hx | rfl
    · exact Or.inl hx
    · exact Or.inr (by simp)
  | inv_mem x hx =>
    rcases hs x hx with hx | rfl
    · exact Or.inl (H.inv_mem hx)
    · exact Or.inr (by simpa only [pow_two, mul_inv_rev] using H.inv_mem htsq)
  | one => exact Or.inl H.one_mem
  | mul x y hx hy ihx ihy =>
    rcases ihx with hx | hx <;> rcases ihy with hy | hy
    · exact Or.inl (H.mul_mem hx hy)
    · exact Or.inr (by simpa only [mul_assoc] using H.mul_mem hx hy)
    · exact Or.inr (by
        convert H.mul_mem hx (ht y hy) using 1; group)
    · exact Or.inl (by
        convert H.mul_mem (H.mul_mem hx (ht _ hy)) htsq using 1;
          simp only [pow_two]; group)

/-- The four-centralizer is generated by the base, the inner complement,
and the inversion lift. -/
public theorem centralizer_four_eq_closure [D.Normal] [IsMulCommutative D]
    [IsMulCommutative B] [IsElementaryAbelian 2 W]
    (hDC : centralizer (D : Set P) ≤ D) (hD : Nat.card D = 16)
    (hWD : W ≤ D) (hWB : W ≤ B) :
    centralizer (W : Set P) = closure ({f.a, f.b, f.g₁, f.g₂, f.z₀} : Set P) := by
  let H := closure ({f.a, f.b, f.g₁, f.g₂, f.z₀} : Set P)
  have ha : f.a ∈ D := f.base.ge (subset_closure (by simp))
  have hb : f.b ∈ D := f.base.ge (subset_closure (by simp))
  have haH : f.a ∈ H := subset_closure (by simp)
  have hbH : f.b ∈ H := subset_closure (by simp)
  have hg₁H : f.g₁ ∈ H := subset_closure (by simp)
  have hg₂H : f.g₂ ∈ H := subset_closure (by simp)
  have hzH : f.z₀ ∈ H := subset_closure (by simp)
  have hDH : D ≤ H := by
    rw [f.base]
    exact (closure_le _).mpr (by
      intro x hx
      rcases (by simpa using hx : x = f.a ∨ x = f.b) with rfl | rfl
      · exact haH
      · exact hbH)
  have hHC : H ≤ centralizer (W : Set P) := by
    apply (closure_le _).mpr
    intro x hx
    rcases (by simpa using hx : x = f.a ∨ x = f.b ∨ x = f.g₁ ∨
      x = f.g₂ ∨ x = f.z₀) with rfl | rfl | rfl | rfl | rfl
    · exact centralizer_le hWD (D.le_centralizer ha)
    · exact centralizer_le hWD (D.le_centralizer hb)
    · exact centralizer_le hWB (B.le_centralizer f.g₁_mem)
    · exact centralizer_le hWB (B.le_centralizer f.g₂_mem)
    · intro w hw
      have hi : w⁻¹ = w := inv_eq_of_mul_eq_one_right
        (by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) w hw)
      exact (mul_inv_eq_iff_eq_mul.mp ((f.z_inverts_base (hWD hw)).trans hi)).symm
  have ht : ∀ x ∈ H, f.t * x * f.t⁻¹ ∈ H := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
      rcases (by simpa using hx : x = f.a ∨ x = f.b ∨ x = f.g₁ ∨
        x = f.g₂ ∨ x = f.z₀) with rfl | rfl | rfl | rfl | rfl
      · simpa only [f.t_a] using hbH
      · simpa only [f.t_b] using haH
      · simpa only [inv_mul_cancel_right] using
          H.mul_mem (hDH (f.t_g₁_defect_mem_base hDC)) hg₂H
      · let d := f.t * f.g₁ * f.t⁻¹ * f.g₂⁻¹
        have hd : d ∈ D := f.t_g₁_defect_mem_base hDC
        have htd : f.t * d * f.t⁻¹ ∈ D := (inferInstance : D.Normal).conj_mem _ hd _
        have hts : f.t ^ 2 ∈ H := hDH (f.t_sq_mem_base hDC)
        convert H.mul_mem (H.inv_mem (hDH htd))
          (H.mul_mem (H.mul_mem hts hg₁H) (H.inv_mem hts)) using 1
        dsimp only [d]
        simp only [pow_two]
        group
      · convert H.mul_mem (H.inv_mem (hDH (f.z_commutator_mem_base hDC f.t))) hzH using 1
        group
    | one => simp
    | mul x y hx hy ihx ihy =>
      simpa only [← conj_mul] using H.mul_mem ihx ihy
    | inv x hx ih =>
      simpa only [← conj_inv] using H.inv_mem ih
  have htC : f.t ∉ centralizer (W : Set P) := by
    intro htC
    have haW : f.a ^ 2 ∈ W := f.four.ge (subset_closure (by simp))
    have hfix : f.t * f.a ^ 2 * f.t⁻¹ = f.a ^ 2 := by
      rw [← htC _ haW, mul_inv_cancel_right]
    have hswap : f.t * f.a ^ 2 * f.t⁻¹ = f.b ^ 2 := by
      change (MulAut.conj f.t) (f.a ^ 2) = _
      rw [map_pow]
      change (f.t * f.a * f.t⁻¹) ^ 2 = _
      rw [f.t_a]
    have hh := (f.base_word_eq_iff hD 2 0 0 2).mp
      (by simpa using hfix.symm.trans hswap)
    exact (by decide : (2 : Fin 4) ≠ 0) hh.1
  apply le_antisymm
  · intro x hx
    rcases two_coset_cover H f.t ht (hDH (f.t_sq_mem_base hDC)) f.generate
      (by
        intro y hy
        rcases (by simpa using hy : y = f.a ∨ y = f.b ∨ y = f.g₁ ∨
          y = f.g₂ ∨ y = f.t ∨ y = f.z₀) with rfl | rfl | rfl | rfl | rfl | rfl
        · exact Or.inl haH
        · exact Or.inl hbH
        · exact Or.inl hg₁H
        · exact Or.inl hg₂H
        · exact Or.inr rfl
        · exact Or.inl hzH) x with hxH | hxH
    · exact hxH
    · exact (htC (by
        simpa only [mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel, mul_one] using
          (centralizer (W : Set P)).mul_mem
            ((centralizer (W : Set P)).inv_mem (hHC hxH)) hx)).elim
  · exact hHC

private theorem image_square_of_generators {Q : Type*} [Group Q]
    (q : P →* Q) (s : Set P)
    (hsq : ∀ x ∈ s, q x ^ 2 = 1)
    (hcomm : ∀ x ∈ s, ∀ y ∈ s, Commute (q x) (q y)) :
    ∀ x ∈ closure s, q x ^ 2 = 1 := by
  let K := closure (q '' s)
  have : IsMulCommutative K := isMulCommutative_closure (by
    rintro _ ⟨x,hx,rfl⟩ _ ⟨y,hy,rfl⟩
    exact (hcomm x hx y hy).eq)
  have hmem {x : P} (hx : x ∈ closure s) : q x ∈ K := by
    change q x ∈ closure (q '' s)
    rw [← MonoidHom.map_closure]
    exact mem_map_of_mem q hx
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem x hx => exact hsq x hx
  | one => simp
  | mul x y hx hy ihx ihy =>
    have hc : Commute (q x) (q y) := K.le_centralizer (hmem hy) _ (hmem hx)
    rw [map_mul, hc.mul_pow, ihx, ihy, one_mul]
  | inv x hx ih => rw [map_inv, inv_pow, ih, inv_one]

private theorem square_mem_four_of_degenerate [D.Normal] [W.Normal]
    [IsMulCommutative D] [IsMulCommutative B] [IsElementaryAbelian 2 W]
    (hDC : centralizer (D : Set P) ≤ D) (hD : Nat.card D = 16)
    (hWD : W ≤ D) (hWB : W ≤ B)
    (hDO : (omega₁ D (p := 2)).map D.subtype = W)
    (hn : f.z₀ * f.g₁ * f.z₀⁻¹ * f.g₁⁻¹ ∈ W) :
    ∀ x ∈ centralizer (W : Set P), x ^ 2 ∈ W := by
  let q := QuotientGroup.mk' W
  have haW : f.a ^ 2 ∈ W := f.four.ge (subset_closure (by simp))
  have hbW : f.b ^ 2 ∈ W := f.four.ge (subset_closure (by simp))
  have hsquare {x : P} (hx : x ^ 2 ∈ W) : q x ^ 2 = 1 := by
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff (N := W) (x := x ^ 2)).mpr hx
  have ha : q f.a ^ 2 = 1 := hsquare haW
  have hb : q f.b ^ 2 = 1 := hsquare hbW
  have hai : (q f.a)⁻¹ = q f.a :=
    inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using ha)
  have hbi : (q f.b)⁻¹ = q f.b :=
    inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hb)
  have hcomm {x y : P} (h : x * y * x⁻¹ * y⁻¹ ∈ W) : Commute (q x) (q y) := by
    have hh : q (x * y * x⁻¹ * y⁻¹) = 1 :=
      (QuotientGroup.eq_one_iff (N := W) (x := x * y * x⁻¹ * y⁻¹)).mpr h
    simp only [map_mul, map_inv] at hh
    exact (mul_inv_eq_iff_eq_mul.mp (mul_inv_eq_iff_eq_mul.mp hh)).trans (by simp)
  have hconj {x y : P} (h : q (x * y * x⁻¹) = q y) : Commute (q x) (q y) := by
    simp only [map_mul, map_inv] at h
    exact mul_inv_eq_iff_eq_mul.mp h
  have h₁a : Commute (q f.g₁) (q f.a) := hconj (by rw [f.g₁_a, map_inv, hai])
  have h₁b : Commute (q f.g₁) (q f.b) := hconj (by
    rw [f.g₁_b, map_mul, map_pow, map_inv, ha, one_mul, hbi])
  have h₂a : Commute (q f.g₂) (q f.a) := hconj (by
    rw [f.g₂_a, map_mul, map_pow, map_inv, hb, mul_one, hai])
  have h₂b : Commute (q f.g₂) (q f.b) := hconj (by rw [f.g₂_b, map_inv, hbi])
  have hza : Commute (q f.z₀) (q f.a) := hconj (by rw [f.z₀_a, map_inv, hai])
  have hzb : Commute (q f.z₀) (q f.b) := hconj (by rw [f.z₀_b, map_inv, hbi])
  have hz₁ : Commute (q f.z₀) (q f.g₁) := hcomm hn
  have hz₂ : Commute (q f.z₀) (q f.g₂) :=
    hcomm (f.second_commutator_mem_four hDC hD hn)
  have hab := f.ab.map q
  have h₁₂ := f.g₁g₂.map q
  intro x hx
  apply (QuotientGroup.eq_one_iff (N := W) (x := x ^ 2)).mp
  change q (x ^ 2) = 1
  rw [map_pow]
  rw [f.centralizer_four_eq_closure hDC hD hWD hWB] at hx
  apply image_square_of_generators q _ _ _ x hx
  · intro y hy
    rcases (by simpa using hy : y = f.a ∨ y = f.b ∨ y = f.g₁ ∨
      y = f.g₂ ∨ y = f.z₀) with rfl | rfl | rfl | rfl | rfl
    · exact ha
    · exact hb
    · rw [← map_pow, f.g₁_two, map_one]
    · rw [← map_pow, f.g₂_two, map_one]
    · exact hsquare (f.z_sq_mem_four hDC hDO)
  · intro y hy z hz
    rcases (by simpa using hy : y = f.a ∨ y = f.b ∨ y = f.g₁ ∨
      y = f.g₂ ∨ y = f.z₀) with rfl | rfl | rfl | rfl | rfl <;>
    rcases (by simpa using hz : z = f.a ∨ z = f.b ∨ z = f.g₁ ∨
      z = f.g₂ ∨ z = f.z₀) with rfl | rfl | rfl | rfl | rfl <;>
    first | exact Commute.refl _ | assumption | exact hab.symm | exact h₁₂.symm |
      exact h₁a.symm | exact h₁b.symm | exact h₂a.symm | exact h₂b.symm |
      exact hza.symm | exact hzb.symm | exact hz₁.symm | exact hz₂.symm

/-- The Frattini identity for the four-centralizer excludes a degenerate
inversion commutator. No assumption on the inversion square is required. -/
public theorem inversion_commutator_not_mem_four_of_frattini
    [Finite P] [D.Normal] [W.Normal] [IsMulCommutative D]
    [IsMulCommutative B] [IsElementaryAbelian 2 W]
    (hP : IsPGroup 2 P) (hD : Nat.card D = 16) (hW : Nat.card W = 4)
    (hWD : W ≤ D) (hWB : W ≤ B)
    (hDC : centralizer (D : Set P) ≤ D)
    (hDO : (omega₁ D (p := 2)).map D.subtype = W)
    (hPhi : D = (frattini (centralizer (W : Set P))).map
      (centralizer (W : Set P)).subtype) :
    f.z₀ * f.g₁ * f.z₀⁻¹ * f.g₁⁻¹ ∉ W := by
  intro hn
  have hDW : D ≤ W := by
    rw [hPhi, map_le_iff_le_comap,
      (hP.to_subgroup (centralizer (W : Set P))).frattini_eq_closure_squares]
    apply (closure_le _).mpr
    rintro _ ⟨x, rfl⟩
    exact f.square_mem_four_of_degenerate hDC hD hWD hWB hDO hn x.val x.property
  have hc := Subgroup.card_le_of_le hDW
  rw [hD, hW] at hc
  omega

end ExoticTwoGroup.ActionFrame
