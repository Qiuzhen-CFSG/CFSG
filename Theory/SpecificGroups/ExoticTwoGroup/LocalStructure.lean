module

public import Theory.SpecificGroups.ExoticTwoGroup.Presentation
public import Mathlib.GroupTheory.Subgroup.Centralizer
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Structural interface for the exotic two-group exclusion

The core is generated by the first four generators, the central involution is
`a²b²`, and the index-two subgroup centralizing the normal four is generated
by the core and `z₀`. The fields below isolate the finite presentation
computations on Janko--Thompson, Math. Z. 113 (1970), p.396.

This is an explicit hypothesis interface, not an assertion that the
computations hold. Its construction is a separate obligation. The ambient
exclusion consumes this interface without changing the generator presentation.
-/

namespace ExoticTwoGroup.Presentation

variable {P : Type*} [Group P]

/-- The special subgroup of order 64 in the printed argument. -/
public abbrev core (d : ExoticTwoGroup.Presentation P) : Subgroup P :=
  Subgroup.closure ({d.a, d.b, d.g₁, d.g₂} : Set P)

/-- The fixed involution in the normal four. -/
public abbrev centralInvolution (d : ExoticTwoGroup.Presentation P) : P :=
  d.a ^ 2 * d.b ^ 2

/-- The normal four given in the presentation. -/
public abbrev four (d : ExoticTwoGroup.Presentation P) : Subgroup P :=
  Subgroup.closure ({d.a ^ 2, d.b ^ 2} : Set P)

/-- The index-two centralizer of the normal four. -/
public abbrev evenSubgroup (d : ExoticTwoGroup.Presentation P) : Subgroup P :=
  Subgroup.closure ({d.a, d.b, d.g₁, d.g₂, d.z₀} : Set P)

/-- Finite centralizer and involution-class computations required for exclusion. -/
public structure LocalStructure (d : ExoticTwoGroup.Presentation P) : Prop where
  central_order : orderOf d.centralInvolution = 2
  central_mem : d.centralInvolution ∈ Subgroup.center P
  t_order : orderOf d.t = 2
  z₀_order : orderOf d.z₀ = 2
  even_index : d.evenSubgroup.index = 2
  even_eq_centralizer : d.evenSubgroup = Subgroup.centralizer (d.four : Set P)
  even_classes : ∀ x : P, orderOf x = 2 → x ∈ d.evenSubgroup →
    x ∈ d.core ∨ IsConj x d.z₀
  odd_classes : ∀ x : P, orderOf x = 2 → x ∉ d.evenSubgroup →
    IsConj x d.t ∨ IsConj x (d.t * d.z₀)
  t_not_even : d.t ∉ d.evenSubgroup
  z₀_mem_even : d.z₀ ∈ d.evenSubgroup
  t_centralizer_card : Nat.card (Subgroup.centralizer ({d.t} : Set P)) = 32
  tz₀_centralizer_card : Nat.card (Subgroup.centralizer ({d.t * d.z₀} : Set P)) = 32
  z₀_centralizer_card : Nat.card (Subgroup.centralizer ({d.z₀} : Set P)) = 16
  characteristic_line : ∀ x ∈ ({d.t, d.z₀} : Set P),
    ∃ K : Subgroup (Subgroup.centralizer ({x} : Set P)), K.Characteristic ∧
      K.map (Subgroup.centralizer ({x} : Set P)).subtype =
        Subgroup.zpowers d.centralInvolution

end ExoticTwoGroup.Presentation
