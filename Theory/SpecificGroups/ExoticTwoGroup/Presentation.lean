module

public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.SetTheory.Cardinal.Finite

/-!
# The exotic two-group presentation of order 256

This is the generator interface for the exceptional two-group in
Janko–Thompson, Math. Z. 113 (1970), 1.4(c), printed p.386. The base is
generated by commuting elements `a,b` of order dividing four. Two commuting
involutions `g₁,g₂` act on it, and a further four-group `t,z₀` acts on that
extension. All conjugations below are written explicitly, avoiding a choice
of commutator convention. The source uses `x^y = y⁻¹*x*y` and
`[x,y] = x⁻¹*y⁻¹*x*y`; the acting generators here are involutions.

The data include generation and order 256. They are hypotheses for local
computations, not a recognition or existence assertion. Recognition from
ambient fusion is a separate obligation, as is exclusion as a Sylow group.
The normal four in applications is the subgroup generated by `a²,b²`.
-/

namespace ExoticTwoGroup

/-- Six generators, their explicit relations, generation, and order for
the exceptional group in Janko–Thompson 1.4(c). -/
public structure Presentation (P : Type*) [Group P] where
  a : P
  b : P
  g₁ : P
  g₂ : P
  t : P
  z₀ : P
  a_four : a ^ 4 = 1
  b_four : b ^ 4 = 1
  ab : Commute a b
  g₁_two : g₁ ^ 2 = 1
  g₂_two : g₂ ^ 2 = 1
  g₁g₂ : Commute g₁ g₂
  g₁_a : g₁ * a * g₁⁻¹ = a⁻¹
  g₁_b : g₁ * b * g₁⁻¹ = a ^ 2 * b⁻¹
  g₂_a : g₂ * a * g₂⁻¹ = a⁻¹ * b ^ 2
  g₂_b : g₂ * b * g₂⁻¹ = b⁻¹
  t_two : t ^ 2 = 1
  z₀_two : z₀ ^ 2 = 1
  tz₀ : Commute t z₀
  z₀_a : z₀ * a * z₀⁻¹ = a⁻¹
  z₀_b : z₀ * b * z₀⁻¹ = b⁻¹
  z₀_g₁ : z₀ * g₁ * z₀⁻¹ = a * g₁
  z₀_g₂ : z₀ * g₂ * z₀⁻¹ = b * g₂
  t_a : t * a * t⁻¹ = b
  t_b : t * b * t⁻¹ = a
  t_g₁ : t * g₁ * t⁻¹ = g₂
  t_g₂ : t * g₂ * t⁻¹ = g₁
  generate : Subgroup.closure ({a, b, g₁, g₂, t, z₀} : Set P) = ⊤
  card : Nat.card P = 256

end ExoticTwoGroup
