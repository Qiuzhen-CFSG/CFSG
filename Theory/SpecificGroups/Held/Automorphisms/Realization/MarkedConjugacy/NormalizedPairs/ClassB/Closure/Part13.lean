/-- Every original representative in this bounded interval is closed. -/
public theorem closedAt (i : Fin 11025)
    (hi : 3328 ≤ i.val ∧ i.val < 3584) : ClosedAt i := by
  have h : ∀ j : Fin 16, Fast.block (3328 + j.val * 16) 16 = true := by
    intro j
    fin_cases j
    · exact block00
    · exact block01
    · exact block02
    · exact block03
