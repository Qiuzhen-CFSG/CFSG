theorem roundTrip (s : Fin 19) (p : Fin 2058) :
    point (inverseIndex s) (point s p) = p ∧ point s (point (inverseIndex s) p) = p := by
  fin_cases s
  · exact roundTrip0 p
  · exact roundTrip1 p
  · exact roundTrip2 p
  · exact roundTrip3 p
  · exact roundTrip4 p
  · exact roundTrip5 p
  · exact roundTrip6 p
  · exact roundTrip7 p
  · exact roundTrip8 p
  · exact roundTrip9 p
  · exact roundTrip10 p
  · exact roundTrip11 p
  · exact roundTrip12 p
  · exact roundTrip13 p
  · exact roundTrip14 p
  · exact roundTrip15 p
  · exact roundTrip16 p
  · exact roundTrip17 p
  · exact roundTrip18 p

def perm (s : Fin 19) : Equiv.Perm (Fin 2058) where
  toFun := point s
  invFun := point (inverseIndex s)
  left_inv p := (roundTrip s p).1
  right_inv p := (roundTrip s p).2

