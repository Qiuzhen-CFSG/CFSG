theorem step (s : Fin 16) :
    perm ⟨s.val + 1, by omega⟩ = perm 1 * perm ⟨s.val, by omega⟩ := by
  fin_cases s
  · exact step0
  · exact step1
  · exact step2
  · exact step3
  · exact step4
  · exact step5
  · exact step6
  · exact step7
  · exact step8
  · exact step9
  · exact step10
  · exact step11
  · exact step12
  · exact step13
  · exact step14
  · exact step15

def powPerm (j : Fin 17) : Equiv.Perm (Fin 2058) := perm ⟨j.val, by omega⟩

theorem powPerm_eq (j : Fin 17) : powPerm j = (atlasA * atlasB) ^ j.val := by
  suffices h : ∀ (n : Nat) (hn : n < 17), perm ⟨n, by omega⟩ = (atlasA * atlasB) ^ n from h j.val j.isLt
  intro n
  induction n with
  | zero => intro hn; exact perm_eq_0
  | succ n ih =>
    intro hn
    rw [step ⟨n, by omega⟩, perm_eq_1, ih (by omega), pow_succ']

