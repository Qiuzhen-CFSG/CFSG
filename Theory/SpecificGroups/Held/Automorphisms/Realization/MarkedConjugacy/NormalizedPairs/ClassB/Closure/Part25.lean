/-- Every original representative in this bounded interval is closed. -/
public theorem closedAt (i : Fin 11025)
    (hi : 6400 ≤ i.val ∧ i.val < 6656) : ClosedAt i := by
  have h : ∀ j : Fin 16, Fast.block (6400 + j.val * 16) 16 = true := by
    intro j
    fin_cases j
    · exact block00
    · exact block01
    · exact block02
    · exact block03
    · exact block04
    · exact block05
    · exact block06
    · exact block07
    · exact block08
    · exact block09
    · exact block10
    · exact block11
    · exact block12
    · exact block13
    · exact block14
    · exact block15
  have hj : (i.val - 6400) / 16 < 16 := by omega
  exact Fast.block_sound (h ⟨(i.val - 6400) / 16, hj⟩) i (by dsimp only; omega)

