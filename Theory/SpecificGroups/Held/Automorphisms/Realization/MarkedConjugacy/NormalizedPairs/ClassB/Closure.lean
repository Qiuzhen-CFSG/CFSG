/-!
# Complete closure of the second Held involution class

All 11025 representatives satisfy the original transition equations, checked
in bounded kernel reductions. Together with the separate completed rejection
certificate this discharges the ClassB class-calculation premise.
Source: the retained HeG1-P1.M and HeG1-p2058B0 tables.
-/

namespace Held.Realization.MarkedConjugacy.NormalizedPairs.ClassB

/-- The complete four-point closure certificate for the original family. -/
public theorem closedAt_all (i : Fin 11025) : ClosedAt i := by
  have h : ∀ j : Fin 44, ∀ i : Fin 11025,
      j.val * 256 ≤ i.val ∧ i.val < (j.val + 1) * 256 → ClosedAt i := by
    intro j
    fin_cases j
    · exact Closure.Part00.closedAt
    · exact Closure.Part01.closedAt
    · exact Closure.Part02.closedAt
    · exact Closure.Part03.closedAt
    · exact Closure.Part04.closedAt
    · exact Closure.Part05.closedAt
    · exact Closure.Part06.closedAt
    · exact Closure.Part07.closedAt
    · exact Closure.Part08.closedAt
    · exact Closure.Part09.closedAt
    · exact Closure.Part10.closedAt
    · exact Closure.Part11.closedAt
    · exact Closure.Part12.closedAt
    · exact Closure.Part13.closedAt
    · exact Closure.Part14.closedAt
    · exact Closure.Part15.closedAt
    · exact Closure.Part16.closedAt
    · exact Closure.Part17.closedAt
    · exact Closure.Part18.closedAt
    · exact Closure.Part19.closedAt
    · exact Closure.Part20.closedAt
    · exact Closure.Part21.closedAt
    · exact Closure.Part22.closedAt
    · exact Closure.Part23.closedAt
    · exact Closure.Part24.closedAt
    · exact Closure.Part25.closedAt
    · exact Closure.Part26.closedAt
    · exact Closure.Part27.closedAt
    · exact Closure.Part28.closedAt
    · exact Closure.Part29.closedAt
    · exact Closure.Part30.closedAt
    · exact Closure.Part31.closedAt
    · exact Closure.Part32.closedAt
    · exact Closure.Part33.closedAt
    · exact Closure.Part34.closedAt
    · exact Closure.Part35.closedAt
    · exact Closure.Part36.closedAt
    · exact Closure.Part37.closedAt
    · exact Closure.Part38.closedAt
    · exact Closure.Part39.closedAt
    · exact Closure.Part40.closedAt
    · exact Closure.Part41.closedAt
    · exact Closure.Part42.closedAt
    · exact Closure.Part43.closedAt
  exact h ⟨i.val / 256, by omega⟩ i (by dsimp only; omega)

end Held.Realization.MarkedConjugacy.NormalizedPairs.ClassB
