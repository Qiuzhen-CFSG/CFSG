module

public import Theory.SpecificGroups.Held.Automorphisms.Realization.MarkedConjugacy.NormalizedPairs.Contracts
/-!
# Checked point evaluation for the first Held involution class

The packed generator tables below are checked against the literal ATLAS
permutations. Binary words denote actual elements of `Held.He`; the forward
and backward evaluators agree with their actions. The row soundness theorem
turns either a moved point of source relator 1 or 3 into rejection, or the
three literal marked fixed-point equations into `PairFixes`.

Source: `Held/Model/Source/HeG1-P1.M` and `HeG1-p2058B0.g1/.g2`.
The source permutations have been inverted to convert right to left actions.
The code generator is retained in `ClassA/Source/generate.py`.
-/

namespace Held.Realization.MarkedConjugacy.NormalizedPairs.ClassA
@[expose] public def bitsA : Nat := 
@[expose] public def fastA (p : Nat) : Nat := (bitsA >>> (12*p)) % 4096
@[expose] public def bitsB : Nat := 
@[expose] public def fastB (p : Nat) : Nat := (bitsB >>> (12*p)) % 4096
@[expose] public def bitsBi : Nat := 
@[expose] public def fastBi (p : Nat) : Nat := (bitsBi >>> (12*p)) % 4096
@[expose] public def word : Nat → Nat → He
  | 0, _ => 1
  | n+1, c => if c ≤ 1 then 1 else (if c % 2 = 0 then a else b) * word n (c / 2)
@[expose] public def value (c : Nat) : He := word 27 c * a * (word 27 c)⁻¹

@[expose] public def fw : Nat → Nat → Nat → Nat
  | 0, _, p => p
  | n+1, c, p => if c ≤ 1 then p else
      (if c % 2 = 0 then fastA else fastB) (fw n (c/2) p)
@[expose] public def bw : Nat → Nat → Nat → Nat
  | 0, _, p => p
  | n+1, c, p => if c ≤ 1 then p else
      bw n (c/2) ((if c % 2 = 0 then fastA else fastBi) p)
@[expose] public def eval (c : Nat) (p : Nat) : Nat := fw 27 c (fastA (bw 27 c p))
@[expose] public def cp : Nat → Nat → Nat
  | 0, p => p
  | n+1, p => fastA (fastB (cp n p))
@[expose] public def ci : Nat → Nat → Nat
  | 0, p => p
  | n+1, p => fastBi (fastA (ci n p))
@[expose] public def yp (c k : Nat) (p : Nat) := eval c (cp k p)
@[expose] public def yi (c k : Nat) (p : Nat) := ci k (eval c p)
@[expose] public def iterate (f : Nat → Nat) : Nat → Nat → Nat
 | 0, p => p
 | n+1, p => f (iterate f n p)
@[expose] public def w (c k : Nat) (p : Nat) :=
 yp c k (eval c (yp c k (eval c (yi c k (eval c (yp c k (eval c (yp c k p))))))))
@[expose] public def wi (c k : Nat) (p : Nat) :=
 yi c k (eval c (yi c k (eval c (yp c k (eval c (yi c k (eval c (yi c k p))))))))
@[expose] public def rowTest (c k r pn : Nat) : Prop :=
 let p := pn % 2058
 if r = 0 then
   eval c p = p ∧ yi c k (yi c k (eval c (yp c k (yp c k p)))) = p ∧
   yp c k (yp c k (eval c (yi c k (yi c k p)))) = p
 else if r = 1 then iterate (yp c k) 7 p ≠ p
 else eval c (wi c k (eval c (w c k p))) ≠ p
public instance (c k r p : Nat) : Decidable (rowTest c k r p) := by unfold rowTest; infer_instance

@[expose] public def edgeTest (c ca cb : Nat) : Prop :=
 ∀ t : Fin 4,
   let p := t.val
   fastA (eval c (fastA p)) = eval ca p ∧ fastB (eval c (fastBi p)) = eval cb p
public instance (c ca cb : Nat) : Decidable (edgeTest c ca cb) := inferInstanceAs (Decidable (∀ _, _))

set_option maxRecDepth 16000 in
public theorem fast_correct : ∀ p : Fin 2058,
    fastA p.val = (atlasA p).val ∧ fastB p.val = (atlasB p).val ∧
      fastBi p.val = (atlasB⁻¹ p).val := by decide +kernel

public theorem fw_correct (n c : Nat) (p : Fin 2058) :
    fw n c p.val = (representation (word n c) p).val := by
  induction n generalizing c p with
  | zero => rfl
  | succ n ih =>
    simp only [fw, word]
    split_ifs with h0 h1
    · rfl
    · rw [ih]
      exact (fast_correct _).1
    · rw [ih]
      exact (fast_correct _).2.1

public theorem bw_correct (n c : Nat) (p : Fin 2058) :
    bw n c p.val = ((representation (word n c))⁻¹ p).val := by
  induction n generalizing c p with
  | zero => rfl
  | succ n ih =>
    simp only [bw, word]
    split_ifs with h0 h1
    · rfl
    · rw [(fast_correct _).1]
      exact ih _ (atlasA p)
    · rw [(fast_correct _).2.2]
      exact ih _ (atlasB⁻¹ p)

public theorem eval_correct (c : Nat) (p : Fin 2058) :
    eval c p.val = (representation (value c) p).val := by
  unfold eval value
  rw [bw_correct, (fast_correct _).1, fw_correct]
  rfl

public theorem eval_inv_correct (c : Nat) (p : Fin 2058) :
    eval c p.val = ((representation (value c))⁻¹ p).val := by
  unfold eval value
  rw [bw_correct, (fast_correct _).1, fw_correct]
  rfl

public theorem cp_correct (n : Nat) (p : Fin 2058) :
    cp n p.val = (representation ((a*b)^n) p).val := by
  induction n generalizing p with
  | zero => rfl
  | succ n ih =>
    rw [cp, ih, (fast_correct _).2.1, (fast_correct _).1, pow_succ']
    rfl

public theorem ci_correct (n : Nat) (p : Fin 2058) :
    ci n p.val = ((representation ((a*b)^n))⁻¹ p).val := by
  induction n generalizing p with
  | zero => rfl
  | succ n ih =>
    rw [ci, ih, (fast_correct _).1, (fast_correct _).2.2, pow_succ]
    rfl

public theorem yp_correct (c k : Nat) (p : Fin 2058) :
    yp c k p.val = (representation (value c * (a*b)^k) p).val := by
  rw [yp, cp_correct, eval_correct]
  rfl

public theorem yi_correct (c k : Nat) (p : Fin 2058) :
    yi c k p.val = ((representation (value c * (a*b)^k))⁻¹ p).val := by
  rw [yi, eval_inv_correct, ci_correct]
  rfl

public theorem iterate_correct (f : Nat → Nat) (g : Equiv.Perm (Fin 2058))
    (h : ∀ p : Fin 2058, f p.val = (g p).val) (n : Nat) (p : Fin 2058) :
    iterate f n p.val = ((g^n) p).val := by
  induction n with
  | zero => rfl
  | succ n ih => rw [iterate, ih, h, pow_succ']; rfl


set_option maxRecDepth 4096 in
public theorem rowTest_sound (c k r pn : Nat) (h : rowTest c k r pn) :
    (∃ (r : Fin 7) (p : Fin 2058),
      representation (relationWord (value c) (value c * (a*b)^k) r) p ≠ p) ∨
    ∃ p : Fin 2058, PairFixes (value c) (value c * (a*b)^k) p := by
  let p : Fin 2058 := ⟨pn % 2058, Nat.mod_lt _ (by decide)⟩
  change (if r = 0 then
    eval c p.val = p.val ∧ yi c k (yi c k (eval c (yp c k (yp c k p.val)))) = p.val ∧
      yp c k (yp c k (eval c (yi c k (yi c k p.val)))) = p.val
    else if r = 1 then iterate (yp c k) 7 p.val ≠ p.val
    else eval c (wi c k (eval c (w c k p.val))) ≠ p.val) at h
  by_cases h0 : r = 0
  · rw [if_pos h0] at h
    simp only [yp_correct, yi_correct, eval_correct] at h
    exact Or.inr ⟨p, Fin.ext h.1, Fin.ext h.2.1, Fin.ext h.2.2⟩
  · rw [if_neg h0] at h
    by_cases h1 : r = 1
    · rw [if_pos h1, iterate_correct _ _ (yp_correct c k)] at h
      exact Or.inl ⟨1, p, fun he => h (congrArg Fin.val he)⟩
    · rw [if_neg h1] at h
      simp only [w, wi, yp_correct, yi_correct, eval_correct] at h
      exact Or.inl ⟨3, p, fun he => h (congrArg Fin.val he)⟩

public theorem edgeTest_sound (c ca cb : Nat) (h : edgeTest c ca cb) :
    (∀ t : Fin 4, representation (a * value c * a⁻¹) ⟨t.val, by omega⟩ =
      representation (value ca) ⟨t.val, by omega⟩) ∧
    (∀ t : Fin 4, representation (b * value c * b⁻¹) ⟨t.val, by omega⟩ =
      representation (value cb) ⟨t.val, by omega⟩) := by
  constructor
  · intro t
    have ht := (h t).1
    have hf := fast_correct (⟨t.val, by omega⟩ : Fin 2058)
    rw [hf.1, eval_correct, (fast_correct _).1, eval_correct ca ⟨t.val, by omega⟩] at ht
    exact Fin.ext ht
  · intro t
    have ht := (h t).2
    have hf := fast_correct (⟨t.val, by omega⟩ : Fin 2058)
    rw [hf.2.2, eval_correct, (fast_correct _).2.1, eval_correct cb ⟨t.val, by omega⟩] at ht
    exact Fin.ext ht

end Held.Realization.MarkedConjugacy.NormalizedPairs.ClassA
