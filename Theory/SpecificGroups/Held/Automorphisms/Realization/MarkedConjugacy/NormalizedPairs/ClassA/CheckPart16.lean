private theorem block260 : checkBlock 260 = true := by
  decide +kernel

set_option maxRecDepth 16000 in
private theorem block261 : checkBlock 261 = true := by
  decide +kernel

set_option maxRecDepth 16000 in
private theorem block262 : checkBlock 262 = true := by
  decide +kernel

set_option maxRecDepth 16000 in
private theorem block263 : checkBlock 263 = true := by
