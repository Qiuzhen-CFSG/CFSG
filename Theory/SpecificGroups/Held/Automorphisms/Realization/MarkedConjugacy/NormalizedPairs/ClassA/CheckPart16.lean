module

public import Theory.SpecificGroups.Held.Automorphisms.Realization.MarkedConjugacy.NormalizedPairs.ClassA.Checking
import Mathlib.Tactic.FinCases

/-!
# Checked first-class rows, batch 16

These sixteen blocks check both generator edges at the four-point base
and both normalized-pair exponents. All computation uses kernel reduction.
Source: the retained ATLAS HeG1-p2058B0 tables; generated by
`ClassA/Source/generate.py`.

Proof elaboration is serialized within this module because each reduction
has a measured memory cost. Separate modules can be built in bounded batches.
-/

set_option Elab.async false

namespace Held.Realization.MarkedConjugacy.NormalizedPairs.ClassA

set_option maxRecDepth 16000 in
private theorem block256 : checkBlock 256 = true := by
  decide +kernel

set_option maxRecDepth 16000 in
private theorem block257 : checkBlock 257 = true := by
  decide +kernel

set_option maxRecDepth 16000 in
private theorem block258 : checkBlock 258 = true := by
  decide +kernel

set_option maxRecDepth 16000 in
private theorem block259 : checkBlock 259 = true := by
  decide +kernel

