module

public import Theory.SpecificGroups.Held.Automorphisms.Realization.MarkedSubgroup
public import Theory.SpecificGroups.Held.Automorphisms.Realization.MarkedConjugacy.SeventeenSylow.Centralizer
public import Theory.SpecificGroups.Held.Automorphisms.Realization.MarkedConjugacy.SeventeenSylow.Preservation

/-!
# The marked cyclic subgroup of order seventeen is Sylow in Held

Kernel-checked row transformations prove that the exact Held generators
preserve the published degree-2058 graph. The centralizer calculation then
bounds the centralizer of `a*b` by 255. Since a subgroup of order 17² is
abelian, no such subgroup can contain `⟨a*b⟩`. Thus seventeen does not divide
the cyclic subgroup's index.

This concrete calculation needs no simplicity, perfectness, marked-subgroup
index bound, or assumed global group order. In particular it applies under
the hypotheses of the marked-subgroup conjugacy construction.

Source: ATLAS HeG1-p2058B0, with generator convention and retained data in
`Held/Model/Source`; John Bray's `HeG1-P1.M` supplies the marked words.
-/

namespace Held.Realization.MarkedConjugacy

/-- The exact cyclic subgroup generated by the product of Held's standard
generators has index prime to seventeen. -/
public theorem seventeen_cyclic_index_not_dvd :
    ¬ 17 ∣ (Subgroup.zpowers (Held.a * Held.b)).index :=
  Seventeen.cyclic_index_not_dvd_of_centralizer_bound
    (Seventeen.centralizer_card_le Seventeen.permutationGroup_le_preservingGroup)

end Held.Realization.MarkedConjugacy
