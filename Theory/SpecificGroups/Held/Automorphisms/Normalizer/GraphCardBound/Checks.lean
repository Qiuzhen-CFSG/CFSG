  have h4 := check22_4 x
  have h5 := check22_5 x
  have h6 := check22_6 x
  have h7 := check22_7 x
  have h8 := check22_8 x
  have h9 := check22_9 x
  have h10 := check22_10 x
  have h11 := check22_11 x
  have h12 := check22_12 x
  have h13 := check22_13 x
  have h14 := check22_14 x
  have h15 := check22_15 x
  have h16 := check22_16 x
  omega

