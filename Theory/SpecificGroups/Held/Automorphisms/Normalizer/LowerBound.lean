  (if i.val < 2 then (if i.val < 1 then (a) * (b)⁻¹ * (a) * (b) * (a)⁻¹ else (b)⁻¹ * (a) * (b) * (a) * (b)⁻¹ * (a)⁻¹ * (b)) else (if i.val < 3 then (b)⁻¹ * (b)⁻¹ * (b)⁻¹ * (a) * (b) * (b) * (b) else (a) * (b) * (b) * (a) * (b) * (b) * (a)⁻¹ * (b) * (b)))

private theorem rawGen1_fix : ∀ i, rawGen1 i • (0 : Fin 2058) = 0 := by
  decide +kernel

private def gen1 (i : Fin 4) : Stabilizer1 :=
  ⟨rawGen1 i, rawGen1_fix i⟩

