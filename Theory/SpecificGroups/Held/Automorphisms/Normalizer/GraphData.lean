/-- The finite relation produced from the specified permutation words. -/
@[expose] public def Adj (x y : Fin 2058) : Prop :=
  (rowMask x).testBit y.val = true

public instance (x y : Fin 2058) : Decidable (Adj x y) :=
  inferInstanceAs (Decidable ((_ : Bool) = true))

/-- All permutations preserving the candidate relation. This is the full
preserving group, with no restriction to chosen generators. -/
@[expose] public def preservingGroup : Subgroup (Equiv.Perm (Fin 2058)) where
  carrier := {σ | ∀ x y, Adj (σ x) (σ y) ↔ Adj x y}
  one_mem' := by intro x y; rfl
  mul_mem' := by
    intro σ τ hσ hτ x y
    exact (hσ (τ x) (τ y)).trans (hτ x y)
  inv_mem' := by
    intro σ hσ x y
    change Adj (σ.symm x) (σ.symm y) ↔ Adj x y
    simpa only [Equiv.apply_symm_apply] using
      (hσ (σ.symm x) (σ.symm y)).symm

