/-- Held preserves the full published relation, without extra premises. -/
public theorem held_le_preservingGroup : permutationGroup ≤ preservingGroup := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  rcases hg with rfl | rfl
  · exact atlasA_mem_preservingGroup
  · exact atlasB_mem_preservingGroup

