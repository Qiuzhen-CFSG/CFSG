/-- The exact ATLAS generator `A` preserves every adjacency bit. -/
public theorem atlasA_mem_preservingGroup : atlasA ∈ preservingGroup := by
  apply preserve atlasA weightsA weightsA_spec
  intro x
  rw [← transformA_eq, rowsA]

