module

public import Theory.SpecificGroups.Held.Automorphisms.InvolutionFixedData.Inner.Coverage.Forest
public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Tables2

/-!
# A packed Held generator for finite fusion checks

The first generator and the second involution already have certified packed
permutation tables. Here the second ATLAS generator is packed as well, avoiding
repeated evaluation of its original piecewise table in long conjugators.
All inverse and comparison identities are checked on every letter by the kernel.

Source: the unchanged `Held/Model/Source/HeG1-p2058B0.g2`, with the same
right-to-left action conversion as `Held.Model.PermutationData`.
Reproduction: `FiniteFusion/Source/generate_checks.py`.
-/

namespace Held.InvolutionFixedData.Coverage.FiniteFusion
open TwoLocalCandidates.Cores

@[expose] public def bForward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def bBackward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 8192 in
set_option maxHeartbeats 1600000 in
@[expose] public def bTable : Equiv.Perm (Fin 2058) where
  toFun := bForward
  invFun := bBackward
  left_inv := by apply allLetters; decide +kernel
  right_inv := by apply allLetters; decide +kernel

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2400000 in
public theorem bTable_eq : bTable = atlasB := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

/-- The existing packed table for the first ATLAS generator. -/
public theorem aTable_eq : Tables0.p0 = atlasA := Tables0.p0_eq

/-- The existing packed table for the literal second involution representative. -/
public theorem zTable_eq : Tables2.p2 = representation (TwoLocalCandidates.max5First ^ 4) := by
  rw [Tables2.p2_eq]
  simp [embedding, coreGenerator, coreWord, localGenerator]

end Held.InvolutionFixedData.Coverage.FiniteFusion
