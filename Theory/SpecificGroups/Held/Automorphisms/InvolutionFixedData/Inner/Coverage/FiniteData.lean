module

public import Theory.SpecificGroups.Held.Automorphisms.InvolutionFixedData.Inner.Coverage.Words

/-!
# Candidate finite data for Held involution fusion

The 191 selected binary words form a proposed conjugation forest with 25 roots.
A nonroot's parent precedes it. The proposed edge is conjugation by one of the
four actual representative generators. At each root a literal Held word is
proposed to conjugate either `a` or `max5First ^ 4` to that root.

Only the combinatorial parent ordering is proved here. Neither the edge
identities nor the root identities are asserted. `InvolutionIndices` separately
checks that any binary word of order two occurs among these 191 indices.

Source: GLS3 Table 5.3p and the unchanged ATLAS HeG1-p2058B0 cycle data.
`Source/discover.py` reproduces the candidate data with left-action permutations;
`Source/generate_data.py` writes these definitions. See `Source/README.md`.
-/

namespace Held.InvolutionFixedData.Coverage
open TwoLocalCandidates.MaximalNormalizerCatalogue.IntrinsicEnumeration

/-- Binary word index at a proposed forest vertex. -/
@[expose] public def forestIndex (i : Fin 191) : Fin 1024 :=
  ⟨( >>> (10 * i.val)) % 1024 % 1024,
    Nat.mod_lt _ (by decide)⟩

/-- Proposed parent vertex; roots are their own parents. -/
@[expose] public def forestParent (i : Fin 191) : Fin 191 :=
  ⟨( >>> (8 * i.val)) % 256 % 191,
    Nat.mod_lt _ (by decide)⟩

/-- Index of the representative generator proposed to conjugate parent to child. -/
@[expose] public def forestGenerator (i : Fin 191) : Fin 4 :=
  ⟨(96780944531035778797542160362898554483450779908954626765809548428185785201954529267303058482252696659924190558004 >>> (2 * i.val)) % 4 % 4,
    Nat.mod_lt _ (by decide)⟩

/-- Root number of the proposed conjugation component. -/
@[expose] public def forestRoot (i : Fin 191) : Fin 25 :=
  ⟨(235466429241006458098661188802543760589498372027547996796419424285031145638114603170808609860781555523965185371754434292352265475504319662234565691382028693325028021749116583452428030756081630597681859890243467902836774730600658707034394226278605272808174282461177851064677705992751808512 >>> (5 * i.val)) % 32 % 25,
    Nat.mod_lt _ (by decide)⟩

/-- Binary word index of each of the 25 proposed roots. -/
@[expose] public def rootIndex (i : Fin 25) : Fin 1024 :=
  ⟨(905454547639600438285960649541133212111685214065730386365351547860580043778 >>> (10 * i.val)) % 1024 % 1024,
    Nat.mod_lt _ (by decide)⟩

/-- Proposed inverse index for words that occur in the forest. -/
@[expose] public def forestRow (i : Fin 1024) : Fin 191 :=
  ⟨( >>> (8 * i.val)) % 256 % 191,
    Nat.mod_lt _ (by decide)⟩

/-- A point proposed to be moved by the square of a word outside the forest. -/
@[expose] public def squareWitness (i : Fin 1024) : Fin 2058 :=
  ⟨( >>> (12 * i.val)) % 4096 % 2058,
    Nat.mod_lt _ (by decide)⟩

/-- Every vertex either has an earlier parent or is the corresponding root.
This certifies the combinatorial termination of forest induction only. -/
public theorem forest_parent_lt_or_root (i : Fin 191) :
    (forestParent i).val < i.val ∨ forestIndex i = rootIndex (forestRoot i) := by
  have h : ∀ i : Fin 191,
      (forestParent i).val < i.val ∨ forestIndex i = rootIndex (forestRoot i) := by
    decide +kernel
  exact h i

/-- Proposed class: zero selects a, and one selects max5First to the fourth power. -/
@[expose] public def rootClass (i : Fin 25) : Fin 2 :=
  ⟨(29048728 >>> (1 * i.val)) % 2 % 2,
    Nat.mod_lt _ (by decide)⟩

/-- Exponent used in the proposed root conjugator. -/
@[expose] public def rootHalf (i : Fin 25) : Fin 32 :=
  ⟨(11010723470988293892461907289050482755 >>> (5 * i.val)) % 32 % 32,
    Nat.mod_lt _ (by decide)⟩

/-- Short signed words in the two original ATLAS generators. -/
@[expose] public def rootShiftWord : Fin 25 → List ℤ
  | 0 => [2, 2]
  | 1 => [2]
  | 2 => [-2, 1, 2, 1, 1, -2, 2, 2, -2, 1, 2, 1]
  | 3 => []
  | 4 => [2, 2]
  | 5 => [2, 2]
  | 6 => []
  | 7 => [2]
  | 8 => [2]
  | 9 => [-2, -2, -2]
  | 10 => []
  | 11 => []
  | 12 => [2]
  | 13 => []
  | 14 => [1, 2, -2, 1, 1, 2, 1, 2, 1, 1, -2, 2]
  | 15 => [-2, -2, 2, -2, 1, -2, -2, 1, 2, 1, -2, -2]
  | 16 => []
  | 17 => []
  | 18 => [2]
  | 19 => []
  | 20 => [2]
  | 21 => [2]
  | 22 => [-2, -2]
  | 23 => [2]
  | _ => [2]

/-- The actual Held element represented by a root's short word. -/
@[expose] public def rootShift (j : Fin 25) : He :=
  ((rootShiftWord j).map (fun k =>
    if k.natAbs = 1 then a ^ k else b ^ (if k < 0 then (-1 : ℤ) else 1))).prod

/-- The selected literal representative; the selection asserts no conjugacy. -/
@[expose] public def rootRepresentative (j : Fin 25) : He :=
  if rootClass j = 0 then a else TwoLocalCandidates.max5First ^ 4

/-- A concrete candidate conjugator, discovered using an odd-order product of
involutions. Its claimed conjugation equation must still be checked. -/
@[expose] public def rootConjugator (j : Fin 25) : He :=
  ((normalForm (rootIndex j)).val * MulAut.conj (rootShift j) (rootRepresentative j)) ^
    (rootHalf j).val * rootShift j

end Held.InvolutionFixedData.Coverage
