module

public import Theory.SpecificGroups.Held.Automorphisms.InvolutionFixedData.Inner.TwoA.Model
public import Theory.SpecificGroups.Held.Model.FourPointBase
import Mathlib.Tactic.FinCases

/-!
# Four literal words in the Held 2A centralizer

The four words are the unchanged words found by the saved Bray-search
experiment. Their commutation with Held.a is proved on the certified
four-point base of the original degree-2058 representation. Consequently,
their generated subgroup lies in the literal fixed subgroup. Exhaustion
and the order 161280 are reduced to separate upper and lower bounds;
neither bound is asserted here.

Source: GLS3 Table 5.3p, printed p.277. The retained discovery data,
action conventions and reproduction information are in `Source/`.
-/

@[expose] public section
namespace Held.InvolutionFixedData.TwoA.CentralizerCertificate
set_option maxRecDepth 4096

def generator : Fin 4 → He := ![
  a,
  a * b * a * b ^ (5 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (2 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (-4 : ℤ) * a⁻¹ * b ^ (-2 : ℤ) * a⁻¹ * b ^ (-4 : ℤ) * a⁻¹ * b ^ (-4 : ℤ) * a⁻¹ * b ^ (-5 : ℤ) * a⁻¹ * b⁻¹ * a * b * a * b ^ (5 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (2 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (-4 : ℤ) * a⁻¹ * b ^ (-2 : ℤ) * a⁻¹ * b ^ (-4 : ℤ) * a⁻¹ * b ^ (-4 : ℤ) * a⁻¹ * b ^ (-5 : ℤ) * a⁻¹ * b⁻¹ * a * b * a * b ^ (5 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (2 : ℤ) * a * b ^ (4 : ℤ),
  a * b ^ (2 : ℤ) * a * b ^ (2 : ℤ) * a * b ^ (-2 : ℤ) * a⁻¹ * b ^ (-2 : ℤ) * a * b ^ (2 : ℤ) * a * b ^ (2 : ℤ) * a * b ^ (-2 : ℤ) * a⁻¹ * b ^ (-2 : ℤ) * a * b ^ (2 : ℤ) * a * b ^ (2 : ℤ),
  a * b ^ (6 : ℤ) * a * b * a * b ^ (3 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (2 : ℤ) * a * b ^ (6 : ℤ) * a * b ^ (-6 : ℤ) * a⁻¹ * b ^ (-2 : ℤ) * a⁻¹ * b ^ (-4 : ℤ) * a⁻¹ * b ^ (-3 : ℤ) * a⁻¹ * b⁻¹ * a⁻¹ * b ^ (-6 : ℤ) * a * b ^ (6 : ℤ) * a * b * a * b ^ (3 : ℤ) * a * b ^ (4 : ℤ) * a * b ^ (2 : ℤ) * a * b ^ (6 : ℤ)]

theorem generator_commute (i : Fin 4) : Commute (generator i) a := by
  change generator i * a = a * generator i
  apply Held.eq_of_four_point_images
  fin_cases i <;> decide +kernel

theorem generator_mem (i : Fin 4) : generator i ∈ centralizer := by
  rw [centralizer_eq, Subgroup.mem_centralizer_singleton_iff]
  exact (generator_commute i).eq

/-- The subgroup generated by the four fixed words, before any exhaustion proof. -/
def generated : Subgroup He := Subgroup.closure (Set.range generator)

theorem generator_mem_generated (i : Fin 4) : generator i ∈ generated :=
  Subgroup.subset_closure (Set.mem_range_self i)

theorem generated_le_centralizer : generated ≤ centralizer := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  exact generator_mem i

/-- The four literal words regarded as elements of the fixed subgroup. -/
def centralizerGenerator (i : Fin 4) : centralizer := ⟨generator i, generator_mem i⟩

/-- Cardinal bounds suffice for exhaustion, with both finite bounds still explicit. -/
theorem generated_eq_centralizer_of_bounds
    (hl : 161280 ≤ Nat.card generated) (hu : Nat.card centralizer ≤ 161280) :
    generated = centralizer :=
  Subgroup.eq_of_le_of_card_ge generated_le_centralizer (hu.trans hl)

theorem centralizer_card_of_bounds
    (hl : 161280 ≤ Nat.card generated) (hu : Nat.card centralizer ≤ 161280) :
    Nat.card centralizer = 161280 :=
  Nat.le_antisymm hu (hl.trans (Subgroup.card_le_of_le generated_le_centralizer))
end Held.InvolutionFixedData.TwoA.CentralizerCertificate
