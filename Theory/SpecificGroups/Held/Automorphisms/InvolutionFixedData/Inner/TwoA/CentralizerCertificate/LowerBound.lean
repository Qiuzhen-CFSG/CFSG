private def gen0 (i : Fin 4) : generated := ⟨generator i, generator_mem_generated i⟩
private def signed0 (i : Fin 8) : generated :=
  if i.val < 4 then gen0 ⟨i.val % 4, Nat.mod_lt _ (by decide)⟩
  else (gen0 ⟨i.val % 4, Nat.mod_lt _ (by decide)⟩)⁻¹

