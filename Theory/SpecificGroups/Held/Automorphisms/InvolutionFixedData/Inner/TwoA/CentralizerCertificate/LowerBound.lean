private theorem tree0_valid : ∀ i, i = 0 ∨
    (depth0 (parent0 i) < depth0 i ∧
      signed0 (step0 i) • point0 (parent0 i) = point0 i) := by
  have h : ∀ q : Fin 27, ∀ r : Fin 32,
      let i : Fin 840 := ⟨(q.val * 32 + r.val) % 840, Nat.mod_lt _ (by decide)⟩
      i = 0 ∨ (depth0 (parent0 i) < depth0 i ∧
        signed0 (step0 i) • point0 (parent0 i) = point0 i) := by
    intro q
    exact Fin.cases tree0_block0 (Fin.cases tree0_block1 (Fin.cases tree0_block2 (Fin.cases tree0_block3 (Fin.cases tree0_block4 (Fin.cases tree0_block5 (Fin.cases tree0_block6 (Fin.cases tree0_block7 (Fin.cases tree0_block8 (Fin.cases tree0_block9 (Fin.cases tree0_block10 (Fin.cases tree0_block11 (Fin.cases tree0_block12 (Fin.cases tree0_block13 (Fin.cases tree0_block14 (Fin.cases tree0_block15 (Fin.cases tree0_block16 (Fin.cases tree0_block17 (Fin.cases tree0_block18 (Fin.cases tree0_block19 (Fin.cases tree0_block20 (Fin.cases tree0_block21 (Fin.cases tree0_block22 (Fin.cases tree0_block23 (Fin.cases tree0_block24 (Fin.cases tree0_block25 (Fin.cases tree0_block26 (fun i => Fin.elim0 i))))))))))))))))))))))))))) q
  intro i
  have hi := h ⟨i.val / 32, by omega⟩ ⟨i.val % 32, Nat.mod_lt _ (by decide)⟩
  have he : i.val / 32 * 32 + i.val % 32 = i.val := by omega
  simpa only [he, Nat.mod_eq_of_lt i.isLt] using hi

private theorem reach0 : ∀ i, ∃ g : generated, g • (0 : Fin 2058) = point0 i :=
  MulAction.exists_smul_eq_of_orbit_tree signed0 0 point0 parent0 step0 depth0 (by decide +kernel) tree0_valid

private abbrev S1 := ↥(MulAction.stabilizer generated (0 : Fin 2058))
private def raw1 : Fin 2 → generated := ![
  (gen0 0)⁻¹ * gen0 2 * gen0 3 * gen0 2,
  gen0 1 * gen0 2 * gen0 2 * (gen0 3)⁻¹]
private theorem raw1_fix : ∀ i, raw1 i • (0 : Fin 2058) = 0 := by decide +kernel
private def gen1 (i : Fin 2) : S1 := ⟨raw1 i, raw1_fix i⟩
private def signed1 (i : Fin 4) : S1 :=
  if i.val < 2 then gen1 ⟨i.val % 2, Nat.mod_lt _ (by decide)⟩
  else (gen1 ⟨i.val % 2, Nat.mod_lt _ (by decide)⟩)⁻¹

private def point1Raw (i : Fin 96) : ℕ := (0x8078027fa7f37e777877073d7157086ec6e76d86cd69667b67665664363f62b62560e5e55e45af5a458957557356a56255b5445054b747446e45d4394284143f03e73de3c73ba39a37d3543082fe2fb2ee2e62dc2c82ba28e24523823321d21c20e1ff1b61a91a61a119919518418216b12912512311a1010e20c90c40c20ba09508807d07807106304504402c004001 >>> (12 * i.val)) % 4096

private def point1 (i : Fin 96) : Fin 2058 :=
  ⟨point1Raw i % 2058, Nat.mod_lt _ (by decide)⟩

private def parent1Raw (i : Fin 96) : ℕ := (0x2209d064a49450842445185594090305b005c723d8061e54a23300489cd6cba52b8d534c01481b066ad3548ebd87c3a6237e3aca613392cc962c6b62d381cb2559aad405a6934f0683f3934020765830b8436900 >>> (7 * i.val)) % 128

private def parent1 (i : Fin 96) : Fin 96 :=
  ⟨parent1Raw i % 96, Nat.mod_lt _ (by decide)⟩

private def step1Raw (i : Fin 96) : ℕ := (0xccd5f42c85843c4c61c324a1997a5945db358791ae903b4c >>> (2 * i.val)) % 4

private def step1 (i : Fin 96) : Fin 4 :=
  ⟨step1Raw i % 4, Nat.mod_lt _ (by decide)⟩

private def depth1 (i : Fin 96) : ℕ := (0x96dd636a56e2a918ec96488d72d72485d96c8e4ad38ec4f2b228e5ae571ca9c6cb92c720 >>> (3 * i.val)) % 8

private theorem point1_injective : Function.Injective point1 := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  decide +kernel

private theorem tree1_block0 : ∀ r : Fin 32,
    let i : Fin 96 := ⟨0 * 32 + r.val, by omega⟩
    i = 0 ∨ (depth1 (parent1 i) < depth1 i ∧
      signed1 (step1 i) • point1 (parent1 i) = point1 i) := by
  decide +kernel

private theorem tree1_block1 : ∀ r : Fin 32,
    let i : Fin 96 := ⟨1 * 32 + r.val, by omega⟩
    i = 0 ∨ (depth1 (parent1 i) < depth1 i ∧
      signed1 (step1 i) • point1 (parent1 i) = point1 i) := by
  decide +kernel

private theorem tree1_block2 : ∀ r : Fin 32,
    let i : Fin 96 := ⟨2 * 32 + r.val, by omega⟩
    i = 0 ∨ (depth1 (parent1 i) < depth1 i ∧
      signed1 (step1 i) • point1 (parent1 i) = point1 i) := by
  decide +kernel

private theorem tree1_valid : ∀ i, i = 0 ∨
    (depth1 (parent1 i) < depth1 i ∧
      signed1 (step1 i) • point1 (parent1 i) = point1 i) := by
  have h : ∀ q : Fin 3, ∀ r : Fin 32,
      let i : Fin 96 := ⟨q.val * 32 + r.val, by omega⟩
      i = 0 ∨ (depth1 (parent1 i) < depth1 i ∧
        signed1 (step1 i) • point1 (parent1 i) = point1 i) := by
    exact Fin.cases tree1_block0 (Fin.cases tree1_block1
      (Fin.cases tree1_block2 (fun i => Fin.elim0 i)))
  intro i
  have hi := h ⟨i.val / 32, by omega⟩ ⟨i.val % 32, Nat.mod_lt _ (by decide)⟩
  have he : i.val / 32 * 32 + i.val % 32 = i.val := by omega
  simpa only [he] using hi

private theorem reach1 : ∀ i, ∃ g : S1, g • (1 : Fin 2058) = point1 i :=
  MulAction.exists_smul_eq_of_orbit_tree signed1 1 point1 parent1 step1 depth1 (by decide +kernel) tree1_valid

private abbrev S2 := ↥(MulAction.stabilizer S1 (1 : Fin 2058))
private def raw2 : S1 := gen1 0 * (gen1 1)⁻¹ * gen1 0 * gen1 1 * gen1 0
private theorem raw2_fix : raw2 • (1 : Fin 2058) = 1 := by decide +kernel
private def stabilizerElement {G X : Type*} [Group G] [MulAction G X]
    (b : X) (g : G) (h : g • b = b) : MulAction.stabilizer G b := ⟨g, h⟩
private def gen2 : S2 := stabilizerElement (1 : Fin 2058) raw2 raw2_fix
private def point2 : Fin 2 → Fin 2058 := ![2, 645]
private theorem point2_injective : Function.Injective point2 := by decide +kernel
private theorem reach2 : ∀ i, ∃ g : S2, g • (2 : Fin 2058) = point2 i := by
  intro i
  fin_cases i
  · exact ⟨1, rfl⟩
  · exact ⟨gen2, by decide +kernel⟩

/-- Three explicit orbit certificates give 840 · 96 · 2 distinct cosets. -/
theorem generated_card_lower : 161280 ≤ Nat.card generated := by
  have h0 := MulAction.card_lower_bound_of_reachable (G := generated) (0 : Fin 2058) point0 point0_injective reach0
  have h1 := MulAction.card_lower_bound_of_reachable (G := S1) (1 : Fin 2058) point1 point1_injective reach1
  have h2 := MulAction.card_lower_bound_of_reachable (G := S2) (2 : Fin 2058) point2 point2_injective reach2
  have hp : 0 < Nat.card (MulAction.stabilizer S2 (2 : Fin 2058)) := Nat.card_pos
  change 840 * Nat.card S1 ≤ Nat.card generated at h0
  change 96 * Nat.card S2 ≤ Nat.card S1 at h1
  omega

