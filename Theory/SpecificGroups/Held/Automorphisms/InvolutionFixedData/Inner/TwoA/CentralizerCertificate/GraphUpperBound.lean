  intro σ hσ hf x
  rw [weight0_spec, weight0_spec]
  have hc := graphColor_invariant (n := 0) (bs := []) (by
    intro σ hσ hf b hb
    simp at hb) σ hσ hf x
  change graphColor [] (σ x).val = graphColor [] x.val at hc
  rw [hc]

private theorem inv1 : graphInvariant 1 weight1 := by
  intro σ hσ hf x
  rw [weight1_spec, weight1_spec]
