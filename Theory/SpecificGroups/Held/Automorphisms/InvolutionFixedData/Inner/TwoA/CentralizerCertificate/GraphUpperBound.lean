/-!
# Certified upper bound for the literal Held graph centralizer

The finite certificate refines the colors given by the fixed involution `atlasA`,
adjacency to its image, and adjacency signatures to the already fixed points.
The selected color cells and neighbor counts are kernel checked against the
retained degree-2058 relation. Orbit--stabilizer and the four-point graph base
then give `1680 * 96 * 2 = 322560`.

The source data and reproducibility notes are in `CentralizerCertificate/Source`.
No group-order or subgroup-exhaustion assertion is used.
-/

@[expose] public section
namespace Held.InvolutionFixedData.TwoA.CentralizerCertificate
open Subgroup Held.NormalizerGraph Held.NormalizerGraph.CardBound
open scoped BigOperators
set_option maxRecDepth 16384

/-- A color invariant under graph permutations centralizing `atlasA`. -/
public def graphInvariant (n : ℕ) (w : ℕ → ℕ) : Prop :=
  ∀ σ ∈ graphCentralizer, Fixes n σ → ∀ x, w (σ x).val = w x.val

/-- The initial color records fixedness and adjacency to the `atlasA` image. -/
public def graphColorF (bs : List (Fin 2058)) (x : Fin 2058) : ℕ :=
  (if x = atlasA x then 2 else 0) +
    (if Adj x (atlasA x) then 1 else 0) + 4 * baseSignature bs x

public def graphColor (bs : List (Fin 2058)) (x : ℕ) : ℕ :=
  graphColorF bs ⟨x % 2058, Nat.mod_lt _ (by decide)⟩

private theorem graphColor_val (bs : List (Fin 2058)) (x : Fin 2058) :
    graphColor bs x.val = graphColorF bs x := by
  simp only [graphColor, Nat.mod_eq_of_lt x.isLt]

private theorem commute_apply (σ : Equiv.Perm (Fin 2058)) (hσ : σ ∈ graphCentralizer)
    (x : Fin 2058) : σ (atlasA x) = atlasA (σ x) := by
  have hc : Commute σ atlasA := Subgroup.mem_centralizer_singleton_iff.mp hσ.2
  have he := congrArg (fun p : Equiv.Perm (Fin 2058) => p x) hc.eq
  simpa only [Equiv.Perm.mul_apply] using he

private theorem graphColor_invariant {n : ℕ} {bs : List (Fin 2058)}
    (hbase : ∀ σ ∈ graphCentralizer, Fixes n σ → ∀ b ∈ bs, σ b = b) :
    graphInvariant n (fun x => graphColor bs x) := by
  intro σ hσ hf x
  have hc := commute_apply σ hσ x
  have heq : (σ x = atlasA (σ x)) ↔ (x = atlasA x) := by
    constructor
    · intro h
      apply σ.injective
      calc
        σ x = atlasA (σ x) := h
        _ = σ (atlasA x) := (commute_apply σ hσ x).symm
    · intro h
      calc
        σ x = σ (atlasA x) := congrArg σ h
        _ = atlasA (σ x) := commute_apply σ hσ x
  have ha : Adj (σ x) (atlasA (σ x)) ↔ Adj x (atlasA x) := by
    simpa only [← commute_apply σ hσ x] using hσ.1 x (atlasA x)
  have hb := baseSignature_invariant bs σ hσ.1
    (fun b hb' => hbase σ hσ hf b hb') x
  change graphColor bs (σ x).val = graphColor bs x.val
  rw [graphColor_val, graphColor_val]
  simp only [graphColorF, heq, ha, hb]

private def allUpTo (f : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | n + 1 => allUpTo f n && f n

private theorem allUpTo_eq_true (f : ℕ → Bool) (n : ℕ) :
    allUpTo f n = true ↔ ∀ i < n, f i = true := by
  induction n with
  | zero => simp [allUpTo]
  | succ n ih =>
    simp only [allUpTo, Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h, hn⟩ i hi
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
      · exact h i hi
      · exact hn
    · intro h
      exact ⟨fun i hi => h i (Nat.lt_succ_of_lt hi), h n (Nat.lt_succ_self n)⟩

private def vertex (i : ℕ) : Fin 2058 :=
  ⟨i % 2058, Nat.mod_lt _ (by decide)⟩

private theorem checked_forall (P : Fin 2058 → Prop) [DecidablePred P]
    (h : allUpTo (fun i => decide (P (vertex i))) 2058 = true) : ∀ x, P x := by
  intro x
  have hx := of_decide_eq_true ((allUpTo_eq_true _ _).mp h x.val x.isLt)
  simpa only [vertex, Nat.mod_eq_of_lt x.isLt] using hx

