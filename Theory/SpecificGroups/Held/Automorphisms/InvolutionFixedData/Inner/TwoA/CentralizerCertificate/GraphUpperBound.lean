public def neighborCount (S : Finset (Fin 2058)) (x : Fin 2058) : ℕ :=
  ∑ y ∈ S, if Adj x y then 1 else 0

private theorem neighborCount_invariant {n : ℕ} {w : ℕ → ℕ}
    (hw : graphInvariant n w) (S : Finset (Fin 2058)) (a : ℕ)
    (hS : ∀ x, x ∈ S ↔ w x.val = a)
    (σ : Equiv.Perm (Fin 2058)) (hσ : σ ∈ graphCentralizer) (hf : Fixes n σ)
    (x : Fin 2058) : neighborCount S (σ x) = neighborCount S x := by
  unfold neighborCount
  symm
  apply Finset.sum_bij (fun y _ => σ y)
  · intro y hy
    apply (hS _).mpr
    rw [hw σ hσ hf]
    exact (hS _).mp hy
  · intro y _ z _ h
    exact σ.injective h
  · intro y hy
    refine ⟨σ.symm y, ?_, σ.apply_symm_apply y⟩
    apply (hS _).mpr
    have he := hw σ hσ hf (σ.symm y)
    rw [σ.apply_symm_apply] at he
    exact he.symm.trans ((hS _).mp hy)
  · intro y _
    simp only [hσ.1 x y]

private theorem narrow_function {n : ℕ} {w v : ℕ → ℕ}
    (hw : graphInvariant n w) (f : Fin 2058 → ℕ)
    (hf : ∀ σ ∈ graphCentralizer, Fixes n σ → ∀ x, f (σ x) = f x)
    (a s : ℕ)
    (hc : ∀ x : Fin 2058,
      v x.val = if w x.val = a ∧ f x = s then 1 else 0) :
    graphInvariant n v := by
  intro σ hσ hfix x
  rw [hc, hc, hw σ hσ hfix x, hf σ hσ hfix x]

private theorem fixed_bases1 (σ : Equiv.Perm (Fin 2058)) (hσ : σ ∈ graphCentralizer)
    (hf : Fixes 1 σ) : ∀ b ∈ ([0, 373] : List (Fin 2058)), σ b = b := by
  intro b hb
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hb
  rcases hb with rfl | rfl
  · exact hf 0 (by decide)
  · have he := commute_apply σ hσ 0
    rw [hf 0 (by decide)] at he
    simpa only [show atlasA 0 = (373 : Fin 2058) by decide] using he

