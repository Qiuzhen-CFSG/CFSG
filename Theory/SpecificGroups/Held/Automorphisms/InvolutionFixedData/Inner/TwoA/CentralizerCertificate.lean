module

public import Theory.SpecificGroups.Held.Automorphisms.InvolutionFixedData.Inner.TwoA.Model
public import Theory.SpecificGroups.Held.Automorphisms.InvolutionFixedData.Inner.TwoA.CentralizerCertificate.LowerBound
public import Theory.SpecificGroups.Held.Automorphisms.InvolutionFixedData.Inner.TwoA.CentralizerCertificate.Parity
public import Theory.SpecificGroups.Held.Automorphisms.InvolutionFixedData.Inner.TwoA.CentralizerCertificate.GraphUpperBound

/-!
# Generation and order of the literal Held 2A centralizer

The four literal words belong to the centralizer and generate at least 161280
elements, by checked orbit trees. The checked odd outer permutation gives two
disjoint copies of the Held centralizer inside the full graph centralizer.
The certified graph bound of 322560 therefore proves that the four words
generate the literal fixed subgroup of conjugation by Held.a, of order 161280.

All finite assertions are kernel checked; no Held order or subgroup exhaustion
is assumed. The retained candidate data and their relation to the certificates
are documented in `CentralizerCertificate/Source/README.md`. The perfect-cover
structure in the source row is a separate downstream obligation.

Source: GLS3 Table 5.3p, printed p.277; the exact ATLAS degree-2058 action.
-/

public section
namespace Held.InvolutionFixedData.TwoA.CentralizerCertificate

/-- An unconditional lower bound for the literal fixed subgroup. -/
theorem centralizer_card_lower : 161280 ≤ Nat.card centralizer :=
  generated_card_lower.trans (Subgroup.card_le_of_le generated_le_centralizer)

/-- Both requested conclusions follow once the independent graph bound is certified. -/
theorem centralizer_certificate_of_graph_bound
    (hu : Nat.card graphCentralizer ≤ 322560) :
    generated = centralizer ∧ Nat.card centralizer = 161280 :=
  centralizer_certificate_of_bounds generated_card_lower hu

/-- The four literal words exhaust the fixed subgroup, whose order is 161280. -/
theorem centralizer_certificate :
    generated = centralizer ∧ Nat.card centralizer = 161280 :=
  centralizer_certificate_of_graph_bound graphCentralizer_card_le

/-- The subgroup generated by the four retained words is the literal fixed subgroup. -/
theorem generated_eq_centralizer : generated = centralizer :=
  centralizer_certificate.1

/-- The literal fixed subgroup of conjugation by Held.a has order 161280. -/
theorem centralizer_card : Nat.card centralizer = 161280 :=
  centralizer_certificate.2

/-- The generated subgroup has the same certified order. -/
theorem generated_card : Nat.card generated = 161280 := by
  rw [generated_eq_centralizer]
  exact centralizer_card

end Held.InvolutionFixedData.TwoA.CentralizerCertificate
