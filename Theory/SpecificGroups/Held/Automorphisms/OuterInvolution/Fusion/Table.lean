module

public import Theory.SpecificGroups.Held.Automorphisms.OuterInvolution.Fusion.Words
public import Theory.SpecificGroups.Held.Automorphisms.InvolutionFixedData.Inner.Coverage.Words
import Mathlib.Tactic.FinCases

/-!
# Checked permutation table for the outer Sylow involution

The table is compared with the literal conjugate of the published outer
representative on all 2058 letters. Its inverse laws are also kernel checked.
Source: the exact ATLAS HeG1-p2058B0 permutations; GLS3 Table 5.3p.
-/

namespace Held.OuterInvolution.Fusion
open Held.TwoLocalCandidates.Cores

@[expose] public def outerFun (x : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * x.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def outerPerm : Equiv.Perm (Fin 2058) where
  toFun := outerFun
  invFun := outerFun
  left_inv := by apply allLetters; decide +kernel
  right_inv := by apply allLetters; decide +kernel

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2400000 in
public theorem outerPerm_eq : outerPerm = outer.val := by
  change outerPerm = (atlasA * atlasB⁻¹) ^ 4 * implementer ^ 5 *
    ((atlasA * atlasB⁻¹) ^ 4)⁻¹
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def generatorPerm : Fin 4 → Equiv.Perm (Fin 2058)
  | 0 => LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables.g0
  | 1 => LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables.g1
  | 2 => LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables.g2
  | 3 => LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables.g3

public theorem generatorPerm_eq (i : Fin 4) :
    generatorPerm i = representation (LocalPairs.SylowGeometry.Calculations.generator i) := by
  fin_cases i
  · exact LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables.g0_eq
  · exact LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables.g1_eq
  · exact LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables.g2_eq
  · exact LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables.g3_eq

public theorem oddWord_val (n : Fin 1024) : (oddWord n).val =
    InvolutionFixedData.Coverage.normalPerm n * outerPerm := by
  change representation
    (TwoLocalCandidates.MaximalNormalizerCatalogue.IntrinsicEnumeration.normalForm n).val *
      outer.val = _
  rw [InvolutionFixedData.Coverage.normalForm_representation, outerPerm_eq]

end Held.OuterInvolution.Fusion
