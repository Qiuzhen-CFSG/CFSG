module

public import Theory.SpecificGroups.Held.Automorphisms.OuterInvolution.Fusion.Words

/-!
# Proposed finite conjugation tree for the outer Held coset

The 64 indices form one tree rooted at the identity binary word times the
outer involution. Each parent precedes its child; each edge proposes conjugation
by one of the four inner Sylow generators. Only the combinatorial assertions
are proved here. Pointwise identities and square witnesses are checked separately.
Source: GLS3 Table 5.3p; the literal ATLAS degree-2058 permutations.
-/

namespace Held.OuterInvolution.Fusion

@[expose] public def forestIndex (i : Fin 64) : Fin 1024 :=
  ⟨(1501231366451553986784967417089318080232154234130971968877833399599508988460784874147451408698060695365435312769700441419981956646652240474824163432711368933918960735764878956206095009207819264 >>> (10 * i.val)) % 1024 % 1024, Nat.mod_lt _ (by decide)⟩

@[expose] public def forestParent (i : Fin 64) : Fin 64 :=
  ⟨(32472512908377152190137360534920416087140760697258846719998336872399410250406673838110813619956953244800655455944704 >>> (6 * i.val)) % 64 % 64, Nat.mod_lt _ (by decide)⟩

@[expose] public def forestGenerator (i : Fin 64) : Fin 4 :=
  ⟨(337942582505058451292428621499922086116 >>> (2 * i.val)) % 4 % 4, Nat.mod_lt _ (by decide)⟩

@[expose] public def forestRow (i : Fin 1024) : Fin 64 :=
  ⟨( >>> (6 * i.val)) % 64 % 64, Nat.mod_lt _ (by decide)⟩

@[expose] public def squareWitness (i : Fin 1024) : Fin 2058 :=
  ⟨( >>> (12 * i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

public theorem forest_root : forestIndex 0 = 0 := by decide +kernel

public theorem forest_parent_lt (i : Fin 64) (hi : i ≠ 0) :
    (forestParent i).val < i.val := by
  have h : ∀ i : Fin 64, i ≠ 0 → (forestParent i).val < i.val := by decide +kernel
  exact h i hi

end Held.OuterInvolution.Fusion
