module
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.ElementaryWords
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.CentralWord
public import Theory.SpecificGroups.Held.TwoLocalCandidates
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.AmbientIdentities.RankFourKernel.Checks
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.AmbientIdentities.RankFourKernel.Orbit
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# The two Held rank-four short-orbit kernels

For each actual subgroup in catalogue rows 9 and 11, the pointwise kernel on
all two-point orbits in the degree-2058 action is exactly row 0, generated by
the common involution. Binary collection and checked permutation evaluations
prove both inclusions. The ambient normalizer preserves this kernel, so it
centralizes its unique nonidentity element. Together with the cyclic row-zero
case, this proves the centralizer bound for the first three distinguished rows.

No simplicity, Held order, full elementary-subgroup enumeration, or additional
model hypothesis is needed. This supplies the rank-four input to the separate
five-normalizer assembly; it does not assert that the entire catalogue is complete.

Source: GLS3 Table 5.3p; the unchanged ATLAS HeG1-p2058B0 catalogue words.
Discovery evidence and witness reproduction are retained in `RankFourKernel/source`.
-/

namespace Held.TwoLocalCandidates.MaximalNormalizerCatalogue
open Subgroup MulAction RankFourKernel

private theorem witness_short (k : Fin 2) (t : Fin 3) :
    witness k t ∈ shortPoints (ambient (row k)) := by
  have he : orbit (ambient (row k)) (witness k t) = {witness k t, partner k t} := by
    ext y
    constructor
    · rintro ⟨g, rfl⟩
      obtain ⟨n, hn⟩ := normalForm_cover k g.property
      have hh := (witness_checks k t).2.1 n
      rw [permForm_eq, hn] at hh
      exact hh
    · intro hy
      rcases hy with rfl | hy
      · exact mem_orbit_self _
      · obtain ⟨i, hi⟩ := (witness_checks k t).2.2
        refine ⟨⟨gen k i, gen_mem k i⟩, ?_⟩
        rw [perm_eq] at hi
        exact hi.trans hy.symm
  change (orbit (ambient (row k)) (witness k t)).ncard = 2
  rw [he]
  exact Set.ncard_pair (witness_checks k t).1

private theorem centralWord_fixes_short (k : Fin 2) :
    centralWord ∈ fixingSubgroup He (shortPoints (ambient (row k))) := by
  have h := fixes_short_of_generator_test (ambient (row k))
    ⟨gen k 3, gen_mem k 3⟩
    (fun i : Fin 3 => ⟨gen k ⟨i.val, by omega⟩, gen_mem k _⟩) (by
      intro x hx
      have hh := short_test k x
      simp only [perm_eq] at hh
      exact hh hx)
  simpa only [gen_three] using h

/-- The kernel on the union of all two-point orbits is the common involution subgroup. -/
public theorem rankFour_short_orbit_kernel (k : Fin 2) :
    ambient (row k) ⊓ fixingSubgroup He (shortPoints (ambient (row k))) = ambient 0 := by
  rw [ambient_zero_eq_zpowers]
  apply le_antisymm
  · intro x hx
    obtain ⟨n, hn⟩ := normalForm_cover k hx.1
    have hsep : n = 0 ∨ n = 8 := by
      apply separation_check k n
      intro t
      rw [permForm_eq, hn]
      exact (mem_fixingSubgroup_iff He).mp hx.2 _ (witness_short k t)
    rcases hsep with rfl | rfl
    · rw [← hn, normalForm_zero]
      exact one_mem _
    · rw [← hn, normalForm_eight]
      exact mem_zpowers _
  · apply zpowers_le.mpr
    exact ⟨gen_three k ▸ gen_mem k 3, centralWord_fixes_short k⟩

public theorem ambient_nine_short_orbit_kernel :
    ambient 9 ⊓ fixingSubgroup He {x : Fin 2058 | Nat.card (orbit (ambient 9) x) = 2} =
      ambient 0 := rankFour_short_orbit_kernel 0

public theorem ambient_eleven_short_orbit_kernel :
    ambient 11 ⊓ fixingSubgroup He {x : Fin 2058 | Nat.card (orbit (ambient 11) x) = 2} =
      ambient 0 := rankFour_short_orbit_kernel 1

private theorem rankFour_row_normalizer (k : Fin 2) :
    normalizer (ambient (row k) : Set He) ≤ centralizer ({centralWord} : Set He) := by
  have hn := normalizer_preserves_short_kernel (ambient (row k))
  rw [rankFour_short_orbit_kernel, ambient_zero_eq_zpowers,
    normalizer_zpowers_eq_centralizer_of_order_two _ centralWord_order] at hn
  exact hn

/-- The first three distinguished ambient normalizers centralize the actual common involution. -/
public theorem rankFour_normalizer_le_centralizer (k : Fin 5) (hk : k.val < 3) :
    normalizer (ambient (distinguished k) : Set He) ≤ centralizer ({centralWord} : Set He) := by
  fin_cases k
  · change normalizer (ambient 0 : Set He) ≤ _
    rw [ambient_zero_eq_zpowers,
      normalizer_zpowers_eq_centralizer_of_order_two _ centralWord_order]
  · exact rankFour_row_normalizer 0
  · exact rankFour_row_normalizer 1
  · norm_num at hk
  · norm_num at hk

end Held.TwoLocalCandidates.MaximalNormalizerCatalogue
