namespace Held.TwoLocalCandidates.MaximalNormalizerCatalogue.IntrinsicEnumeration.ExtensionChecks

/-- Every literal Held extension branch passes its rejection-or-acceptance check. -/
public theorem branchAction_true (i : Option (Fin 22)) (n : Fin 1024) :
    branchAction i n = true := by
  cases i with
  | none => exact Branches.row00 n
  | some i =>
    fin_cases i
    · exact Branches.row01 n
    · exact Branches.row02 n
