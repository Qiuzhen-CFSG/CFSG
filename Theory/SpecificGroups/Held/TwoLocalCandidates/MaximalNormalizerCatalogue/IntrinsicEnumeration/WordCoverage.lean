module

public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.IntrinsicEnumeration.Words
public import Theory.SpecificGroups.Held.LocalPairs.SylowGeometry.Calculations.TwoGroup
public import Theory.GroupTheory.CyclicExtension
import Mathlib.Tactic.FinCases

/-!
# Coverage of the intrinsic Held binary words

The fixed representative is generated by the ten checked polycyclic words. The
ascending series from `TwoGroup` gives normalizing cyclic extensions. Nine
factors are involutions; the square of the tenth is the certified product of
factors one and two, so the same binary collection still covers the final
extension. Collection is performed in reverse order, exactly the order of the
literal `pcWord` entries and their least-significant-bit convention.

Source: the retained `pc.g` and `pcRelations.g` data for the fixed Held
representative, with all identities checked in the degree-2058 permutation
carrier. GAP discovery data is not used as a proof.
-/
@[expose] public section

namespace Held.TwoLocalCandidates.MaximalNormalizerCatalogue.IntrinsicEnumeration
open LocalPairs.SylowGeometry.Calculations
open LocalPairs.SylowGeometry.Calculations.TwoGroup
open LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables
open Theory.GroupTheory

private def desc : (k : Nat) → k ≤ 10 → Nat → He
  | 0, _, _ => 1
  | k + 1, hk, b =>
      pcGenerator ⟨k, by omega⟩ ^ (b / 2 ^ k % 2) *
        desc k (by omega) (b % 2 ^ k)

private theorem desc_succ (k : Nat) (hk : k + 1 ≤ 10) (b : Nat) :
    desc (k + 1) hk b =
      pcGenerator ⟨k, by omega⟩ ^ (b / 2 ^ k % 2) *
        desc k (by omega) (b % 2 ^ k) := rfl

private theorem pc_sq_small (i : Fin 9) : pcGenerator ⟨i.val, by omega⟩ ^ 2 = (1 : He) := by
  fin_cases i
  ·
    apply representation_injective
    rw [map_pow, map_one, ← pcTable_eq]
    apply Equiv.ext
    apply Held.TwoLocalCandidates.Cores.allLetters
    decide +kernel
  ·
    apply representation_injective
    rw [map_pow, map_one, ← pcTable_eq]
    apply Equiv.ext
    apply Held.TwoLocalCandidates.Cores.allLetters
    decide +kernel
  ·
    apply representation_injective
    rw [map_pow, map_one, ← pcTable_eq]
    apply Equiv.ext
    apply Held.TwoLocalCandidates.Cores.allLetters
    decide +kernel
  ·
    apply representation_injective
    rw [map_pow, map_one, ← pcTable_eq]
    apply Equiv.ext
    apply Held.TwoLocalCandidates.Cores.allLetters
    decide +kernel
  ·
    apply representation_injective
    rw [map_pow, map_one, ← pcTable_eq]
    apply Equiv.ext
    apply Held.TwoLocalCandidates.Cores.allLetters
    decide +kernel
  ·
    apply representation_injective
    rw [map_pow, map_one, ← pcTable_eq]
    apply Equiv.ext
    apply Held.TwoLocalCandidates.Cores.allLetters
    decide +kernel
  ·
    apply representation_injective
    rw [map_pow, map_one, ← pcTable_eq]
    apply Equiv.ext
    apply Held.TwoLocalCandidates.Cores.allLetters
    decide +kernel
  ·
    apply representation_injective
    rw [map_pow, map_one, ← pcTable_eq]
    apply Equiv.ext
    apply Held.TwoLocalCandidates.Cores.allLetters
    decide +kernel
  ·
    apply representation_injective
    rw [map_pow, map_one, ← pcTable_eq]
    apply Equiv.ext
    apply Held.TwoLocalCandidates.Cores.allLetters
    decide +kernel

private theorem pc_square_relation :
    pcGenerator 9 ^ 2 = pcGenerator 1 * pcGenerator 2 := by
  apply representation_injective
  rw [map_pow, map_mul, ← pcTable_eq, ← pcTable_eq, ← pcTable_eq]
  apply Equiv.ext
  apply Held.TwoLocalCandidates.Cores.allLetters
  decide +kernel

private theorem pc_square_mem_prefix (i : Fin 10) :
    pcGenerator i ^ 2 ∈ Subgroup.generatorPrefix pcGenerator i.val := by
  fin_cases i
  · have hsq : pcGenerator 0 ^ 2 = (1 : He) := by
      simpa using pc_sq_small ⟨0, by decide⟩
    have hsq' : pcGenerator ((fun i => i) ⟨0, by decide⟩) ^ 2 = (1 : He) := by
      convert hsq using 1
      congr 1
    rw [hsq']
    exact Subgroup.one_mem _
  · have hsq : pcGenerator 1 ^ 2 = (1 : He) := by
      simpa using pc_sq_small ⟨1, by decide⟩
    have hsq' : pcGenerator ((fun i => i) ⟨1, by decide⟩) ^ 2 = (1 : He) := by
      convert hsq using 1
      congr 1
    rw [hsq']
    exact Subgroup.one_mem _
  · have hsq : pcGenerator 2 ^ 2 = (1 : He) := by
      simpa using pc_sq_small ⟨2, by decide⟩
    have hsq' : pcGenerator ((fun i => i) ⟨2, by decide⟩) ^ 2 = (1 : He) := by
      convert hsq using 1
      congr 1
    rw [hsq']
    exact Subgroup.one_mem _
  · have hsq : pcGenerator 3 ^ 2 = (1 : He) := by
      simpa using pc_sq_small ⟨3, by decide⟩
    have hsq' : pcGenerator ((fun i => i) ⟨3, by decide⟩) ^ 2 = (1 : He) := by
      convert hsq using 1
      congr 1
    rw [hsq']
    exact Subgroup.one_mem _
  · have hsq : pcGenerator 4 ^ 2 = (1 : He) := by
      simpa using pc_sq_small ⟨4, by decide⟩
    have hsq' : pcGenerator ((fun i => i) ⟨4, by decide⟩) ^ 2 = (1 : He) := by
      convert hsq using 1
      congr 1
    rw [hsq']
    exact Subgroup.one_mem _
  · have hsq : pcGenerator 5 ^ 2 = (1 : He) := by
      simpa using pc_sq_small ⟨5, by decide⟩
    have hsq' : pcGenerator ((fun i => i) ⟨5, by decide⟩) ^ 2 = (1 : He) := by
      convert hsq using 1
      congr 1
    rw [hsq']
    exact Subgroup.one_mem _
  · have hsq : pcGenerator 6 ^ 2 = (1 : He) := by
      simpa using pc_sq_small ⟨6, by decide⟩
    have hsq' : pcGenerator ((fun i => i) ⟨6, by decide⟩) ^ 2 = (1 : He) := by
      convert hsq using 1
      congr 1
    rw [hsq']
    exact Subgroup.one_mem _
  · have hsq : pcGenerator 7 ^ 2 = (1 : He) := by
      simpa using pc_sq_small ⟨7, by decide⟩
    have hsq' : pcGenerator ((fun i => i) ⟨7, by decide⟩) ^ 2 = (1 : He) := by
      convert hsq using 1
      congr 1
    rw [hsq']
    exact Subgroup.one_mem _
  · have hsq : pcGenerator 8 ^ 2 = (1 : He) := by
      simpa using pc_sq_small ⟨8, by decide⟩
    have hsq' : pcGenerator ((fun i => i) ⟨8, by decide⟩) ^ 2 = (1 : He) := by
      convert hsq using 1
      congr 1
    rw [hsq']
    exact Subgroup.one_mem _
  · change pcGenerator 9 ^ 2 ∈ Subgroup.generatorPrefix pcGenerator 9
    rw [pc_square_relation]
    apply Subgroup.mul_mem
    · exact (Subgroup.generatorPrefix_le pcGenerator 9 _).mp le_rfl 1 (by decide)
    · exact (Subgroup.generatorPrefix_le pcGenerator 9 _).mp le_rfl 2 (by decide)

private theorem pc_norm_prefix (k : Fin 10) :
    pcGenerator k ∈ Subgroup.normalizer
      (Subgroup.generatorPrefix pcGenerator k.val : Set He) := by
  exact TwoGroup.pcGenerator_normalizes_prefix k

private theorem prefix_succ (k : Nat) (hk : k + 1 ≤ 10) :
    Subgroup.generatorPrefix pcGenerator (k + 1) =
      Subgroup.zpowers (pcGenerator ⟨k, by omega⟩) ⊔
        Subgroup.generatorPrefix pcGenerator k := by
  unfold Subgroup.generatorPrefix
  apply le_antisymm
  · apply (Subgroup.generatorPrefix_le _ _ _).mpr
    intro j hj
    by_cases hlt : j.val < k
    · exact Subgroup.mem_sup_right
        ((Subgroup.generatorPrefix_le pcGenerator k _).mp le_rfl j hlt)
    · have he : j.val = k := by omega
      have heq : j = ⟨k, by omega⟩ := Fin.ext he
      rw [heq]
      exact Subgroup.mem_sup_left (Subgroup.mem_zpowers _)
  · apply sup_le
    · apply Subgroup.zpowers_le.mpr
      have hm := (Subgroup.generatorPrefix_le pcGenerator (k + 1) _).mp le_rfl
        (⟨k, by omega⟩ : Fin 10) (by change k < k + 1; omega)
      exact hm
    · apply (Subgroup.generatorPrefix_le _ _ _).mpr
      intro j hj
      change j.val < k at hj
      have hj' : j.val < k + 1 := Nat.lt_trans hj (Nat.lt_succ_self k)
      exact Subgroup.mem_closure_of_mem ⟨j, hj', rfl⟩

private theorem prefix_succ_mem_closure (k : Nat) (hk : k + 1 ≤ 10)
    {x : He} (hx : x ∈ Subgroup.generatorPrefix pcGenerator (k + 1)) :
    x ∈ Subgroup.closure (insert (pcGenerator ⟨k, by omega⟩)
      (pcGenerator '' {j : Fin 10 | j.val < k})) := by
  have hle : Subgroup.generatorPrefix pcGenerator (k + 1) ≤
      Subgroup.closure (insert (pcGenerator ⟨k, by omega⟩)
        (pcGenerator '' {j : Fin 10 | j.val < k})) := by
    apply (Subgroup.generatorPrefix_le _ _ _).mpr
    intro j hj
    by_cases hlt : j.val < k
    · exact Subgroup.subset_closure (Set.mem_insert_of_mem _ ⟨j, hlt, rfl⟩)
    · have he : j.val = k := by omega
      have heq : j = ⟨k, by omega⟩ := Fin.ext he
      rw [heq]
      exact Subgroup.subset_closure (Set.mem_insert _ _)
  exact hle hx

private theorem norm_mem_prefix (k : Nat) (hk : k + 1 ≤ 10)
    (b : He) (hb : b ∈ Subgroup.generatorPrefix pcGenerator k) :
    pcGenerator ⟨k, by omega⟩ * b * (pcGenerator ⟨k, by omega⟩)⁻¹ ∈
      Subgroup.generatorPrefix pcGenerator k := by
  change b ∈ Subgroup.generatorPrefix pcGenerator k at hb
  change pcGenerator ⟨k, by omega⟩ * b * (pcGenerator ⟨k, by omega⟩)⁻¹ ∈
    Subgroup.generatorPrefix pcGenerator k
  have hnorm := pc_norm_prefix (⟨k, by omega⟩ : Fin 10)
  have h := (Subgroup.mem_normalizer_iff.mp hnorm b).mp hb
  change _ ∈ Subgroup.generatorPrefix pcGenerator k at h
  exact h

private theorem desc_mem_prefix : ∀ (k : Nat) (hk : k ≤ 10) (b : Nat),
    desc k hk b ∈ Subgroup.generatorPrefix pcGenerator k
  | 0, _, _ => by simp [Subgroup.generatorPrefix, desc]
  | k + 1, hk, b => by
      rw [desc_succ k hk b, prefix_succ k hk]
      apply Subgroup.mul_mem
      · exact Subgroup.mem_sup_left
          ((Subgroup.zpowers _).pow_mem (Subgroup.mem_zpowers _) _)
      · exact Subgroup.mem_sup_right (desc_mem_prefix k (by omega) (b % 2 ^ k))

private theorem desc_surj : ∀ (k : Nat) (hk : k ≤ 10) (x : He),
    x ∈ Subgroup.generatorPrefix pcGenerator k →
    ∃ b < 2 ^ k, desc k hk b = x
  | 0, _, x, hx => by
      have : x = 1 := by simpa [Subgroup.generatorPrefix] using hx
      exact ⟨0, by simp, this.symm⟩
  | k + 1, hk, x, hx => by
      have hclosure := prefix_succ_mem_closure k hk hx
      have hconj : ∀ y ∈ pcGenerator '' {j : Fin 10 | j.val < k},
          pcGenerator ⟨k, by omega⟩ * y * (pcGenerator ⟨k, by omega⟩)⁻¹ ∈
            Subgroup.generatorPrefix pcGenerator k := by
        rintro y ⟨j, hj, rfl⟩
        change j.val < k at hj
        have hj' : pcGenerator j ∈ Subgroup.generatorPrefix pcGenerator k :=
          (Subgroup.generatorPrefix_le pcGenerator k _).mp le_rfl j hj
        have hnorm := pc_norm_prefix (⟨k, by omega⟩ : Fin 10)
        have h := (Subgroup.mem_normalizer_iff.mp hnorm (pcGenerator j)).mp hj'
        change _ ∈ Subgroup.generatorPrefix pcGenerator k at h
        exact h
      obtain ⟨y, hy, e, he⟩ := exists_mul_pow_of_mem_closure_insert
        (pcGenerator '' {j : Fin 10 | j.val < k})
        (pcGenerator ⟨k, by omega⟩) 4 (by decide)
        (TwoGroup.pcGenerator_pow_four ⟨k, by omega⟩)
        hconj hclosure
      have finish_one (y : He)
          (hy : y ∈ Subgroup.closure (pcGenerator '' {j : Fin 10 | j.val < k}))
          (he : y * pcGenerator ⟨k, by omega⟩ = x) :
          ∃ b < 2 ^ (k + 1), desc (k + 1) hk b = x := by
        let z := (pcGenerator ⟨k, by omega⟩)⁻¹ * y *
            pcGenerator ⟨k, by omega⟩
        have hnorm := pc_norm_prefix (⟨k, by omega⟩ : Fin 10)
        have hnormInv := (Subgroup.normalizer (Subgroup.generatorPrefix pcGenerator k : Set He)).inv_mem hnorm
        have hz : z ∈ Subgroup.generatorPrefix pcGenerator k := by
          have hy0 : y ∈ Subgroup.generatorPrefix pcGenerator k :=
            by simpa [Subgroup.generatorPrefix] using hy
          have h := (Subgroup.mem_normalizer_iff.mp hnormInv y).mp hy0
          simpa [z] using h
        obtain ⟨m, hm, hmy⟩ := desc_surj k (by omega) z hz
        let n := 2 ^ k + m
        refine ⟨n, by omega, ?_⟩
        rw [desc_succ k hk n]
        have hdiv : n / 2 ^ k % 2 = 1 := by
          dsimp [n]
          have hpow : 0 < 2 ^ k := by positivity
          have hq : m / 2 ^ k = 0 := Nat.div_eq_of_lt hm
          rw [Nat.add_div_left _ hpow, hq]
        have hmod : n % 2 ^ k = m := by
          dsimp [n]
          simp [Nat.mod_eq_of_lt hm]
        rw [hdiv, hmod, pow_one]
        have hzy : pcGenerator ⟨k, by omega⟩ * z = y *
            pcGenerator ⟨k, by omega⟩ := by
          dsimp [z]
          simp [mul_assoc]
        rw [hmy, hzy]
        exact he
      fin_cases e
      · obtain ⟨m, hm, hmy⟩ := desc_surj k (by omega) y
          (by simpa [Subgroup.generatorPrefix] using hy)
        refine ⟨m, by omega, ?_⟩
        rw [desc_succ k hk m]
        simp only [Nat.mod_eq_of_lt hm, Nat.div_eq_of_lt hm]
        simpa [hmy] using he
      · exact finish_one y hy (by simpa [pow_one] using he)
      · have hy' : y * pcGenerator ⟨k, by omega⟩ ^ 2 ∈
            Subgroup.generatorPrefix pcGenerator k := by
          apply Subgroup.mul_mem
          · simpa [Subgroup.generatorPrefix] using hy
          · exact pc_square_mem_prefix (⟨k, by omega⟩ : Fin 10)
        obtain ⟨m, hm, hmy⟩ := desc_surj k (by omega) _ hy'
        refine ⟨m, by omega, ?_⟩
        rw [desc_succ k hk m]
        simp only [Nat.mod_eq_of_lt hm, Nat.div_eq_of_lt hm]
        exact hmy.trans he
      · let y' := y * pcGenerator ⟨k, by omega⟩ ^ 2
        have hy' : y' ∈ Subgroup.generatorPrefix pcGenerator k := by
          dsimp [y']
          apply Subgroup.mul_mem
          · simpa [Subgroup.generatorPrefix] using hy
          · exact pc_square_mem_prefix (⟨k, by omega⟩ : Fin 10)
        exact finish_one y' (by simpa [Subgroup.generatorPrefix] using hy') (by
          simpa [y', pow_succ, mul_assoc] using he)


private theorem literalWord_pcGenerator (i : Fin 10) :
    (word (pcWord i)).val = pcGenerator ⟨9 - i.val, by omega⟩ := by
  fin_cases i <;>
    simp [word, letter, pcWord, pcGenerator, mul_assoc] <;> rfl

private def reverseBits (n : Fin 1024) : Fin 1024 :=
  ⟨(n.val % 2) * 512 + (n.val / 2 % 2) * 256 +
    (n.val / 4 % 2) * 128 + (n.val / 8 % 2) * 64 +
    (n.val / 16 % 2) * 32 + (n.val / 32 % 2) * 16 +
    (n.val / 64 % 2) * 8 + (n.val / 128 % 2) * 4 +
    (n.val / 256 % 2) * 2 + (n.val / 512 % 2), by omega⟩

private theorem reverseBits_digits (n : Fin 1024) :
    [
      n.val / 512 % 2,
      n.val % 512 / 256 % 2,
      n.val % 512 % 256 / 128 % 2,
      n.val % 512 % 256 % 128 / 64 % 2,
      n.val % 512 % 256 % 128 % 64 / 32 % 2,
      n.val % 512 % 256 % 128 % 64 % 32 / 16 % 2,
      n.val % 512 % 256 % 128 % 64 % 32 % 16 / 8 % 2,
      n.val % 512 % 256 % 128 % 64 % 32 % 16 % 8 / 4 % 2,
      n.val % 512 % 256 % 128 % 64 % 32 % 16 % 8 % 4 / 2 % 2,
      n.val % 512 % 256 % 128 % 64 % 32 % 16 % 8 % 4 % 2 / 1 % 2] =
    ((List.finRange 10).map (fun i => (reverseBits n).val / 2 ^ i.val % 2)) := by
  revert n
  decide +kernel

set_option maxRecDepth 8192 in
private theorem desc_eq_normalForm (n : Fin 1024) :
    desc 10 (by decide) n.val = (normalForm (reverseBits n)).val := by
  have hv : (normalForm (reverseBits n)).val =
      ((List.finRange 10).map (fun i => pcGenerator ⟨9 - i.val, by omega⟩ ^
        ((reverseBits n).val / 2 ^ i.val % 2))).prod := by
    change representative.subtype (normalForm (reverseBits n)) = _
    simp only [normalForm, map_list_prod, List.map_map]
    apply congrArg List.prod
    apply List.map_congr_left
    intro i _
    rw [Function.comp_apply, map_pow]
    rw [show representative.subtype (word (pcWord i)) = _ from literalWord_pcGenerator i]
  rw [hv]
  have h := congrArg (fun es : List Nat =>
    (List.zipWith (fun (i : Fin 10) e => pcGenerator i ^ e)
      [9,8,7,6,5,4,3,2,1,0] es).prod) (reverseBits_digits n)
  exact h

private theorem prefix_ten : Subgroup.generatorPrefix pcGenerator 10 = representative := by
  rw [← pcClosure_eq_representative]
  unfold Subgroup.generatorPrefix
  congr 1
  ext x
  simp only [Set.mem_image, Set.mem_ofPred_eq, Set.mem_range]
  exact ⟨fun ⟨i, _, h⟩ => ⟨i, h⟩, fun ⟨i, h⟩ => ⟨i, i.isLt, h⟩⟩

public theorem normalForm_surjective : Function.Surjective normalForm := by
  intro x
  have hx : x.val ∈ Subgroup.generatorPrefix pcGenerator 10 := by
    rw [prefix_ten]
    exact x.property
  obtain ⟨b, hb, he⟩ := desc_surj 10 (by decide) x.val hx
  let n : Fin 1024 := ⟨b, hb⟩
  refine ⟨reverseBits n, Subtype.ext ?_⟩
  exact (desc_eq_normalForm n).symm.trans he

end Held.TwoLocalCandidates.MaximalNormalizerCatalogue.IntrinsicEnumeration
