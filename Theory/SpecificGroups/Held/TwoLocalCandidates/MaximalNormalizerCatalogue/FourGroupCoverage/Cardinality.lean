private theorem images_eq (j : Fin 18) : ∀ i : Fin 5,
    representation (five (largeRow j) i : He) (testPoint j) = images j i := by
  fin_cases j
  · exact images_0
  · exact images_1
  · exact images_2
  · exact images_3
  · exact images_4
  · exact images_5
  · exact images_6
  · exact images_7
  · exact images_8
  · exact images_9
  · exact images_10
  · exact images_11
  · exact images_12
  · exact images_13
  · exact images_14
  · exact images_15
  · exact images_16
  · exact images_17

private theorem images_injective (j : Fin 18) : Function.Injective (images j) := by
  have h : ∀ j : Fin 18, Function.Injective (images j) := by decide
  exact h j

private theorem five_injective (j : Fin 18) : Function.Injective (five (largeRow j)) := by
  intro a b h
  apply images_injective j
  rw [← images_eq j a, ← images_eq j b, h]

/-- The first literal row has order two, by the common involution certificate. -/
public theorem entry_zero_card : Nat.card (entry 0) = 2 := by
  have hmap : Nat.card (ambient 0) = Nat.card (entry 0) :=
    card_map_of_injective representative.subtype_injective
  rw [← hmap, ambient_zero_eq_zpowers, Nat.card_zpowers, centralWord_order]

/-- Five literal elements exclude every row after the three four-group rows. -/
public theorem five_le_entry_card (j : Fin 22) (hj : 4 ≤ j.val) :
    5 ≤ Nat.card (entry j) := by
  obtain ⟨k, rfl⟩ : ∃ k : Fin 18, j = largeRow k := by
    refine ⟨⟨j.val - 4, by omega⟩, ?_⟩
    apply Fin.ext
    dsimp [largeRow]
    omega
  let f : Fin 5 → entry (largeRow k) := fun i => ⟨five (largeRow k) i, five_mem _ i⟩
  have hf : Function.Injective f := fun a b h =>
    five_injective k (congrArg Subtype.val h)
  simpa only [Nat.card_fin] using Nat.card_le_card_of_injective f hf

/-- Cardinality four forces exactly one of the three eligible row indices.
This implication does not assume the unproved exhaustive enumeration. -/
public theorem entry_card_four_rows (j : Fin 22) (hcard : Nat.card (entry j) = 4) :
    j = 1 ∨ j = 2 ∨ j = 3 := by
  have hjlt : j.val < 4 := by
    by_contra! h
    have := five_le_entry_card j h
    omega
  have hjne : j ≠ 0 := by
    intro h
    subst j
    rw [entry_zero_card] at hcard
    omega
  omega

end Held.TwoLocalCandidates.MaximalNormalizerCatalogue
