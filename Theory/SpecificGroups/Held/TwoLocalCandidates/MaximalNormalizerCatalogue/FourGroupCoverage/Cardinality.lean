module

public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.ElementaryWords
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.CentralWord

/-!
# Cardinality filtering for the Held four-group cover

Row zero is the cyclic group of order two generated by the certified common
involution. In each row from 4 to 21, the identity, the first three generators,
and the product of the first two generators are distinct. This is certified by
their five different images of one point in the actual degree-2058 action.
Consequently an entry of order four must be row 1, 2 or 3. No enumeration,
elementary-abelian claim or exact order for a larger row is assumed here.

The image equations are checked separately before the small numerical
injectivity check, to avoid repeated evaluation of long permutation words.
Source application: Aschbacher--Smith, 15.3.43, printed p.1140;
GLS3 Table 5.3p and the literal ATLAS HeG1-p2058B0 action.
-/

namespace Held.TwoLocalCandidates.MaximalNormalizerCatalogue
open Subgroup LocalPairs.SylowGeometry.Calculations

private def rowGenerator (j : Fin 22) (i : ℕ) : representative :=
  word ((generatorWords j)[i]?.getD [])

private theorem rowGenerator_mem (j : Fin 22) (i : ℕ) :
    rowGenerator j i ∈ entry j := by
  unfold rowGenerator
  cases h : (generatorWords j)[i]? with
  | none => exact (entry j).one_mem
  | some w => exact word_mem_entry j w (List.mem_of_getElem? h)

private def five (j : Fin 22) : Fin 5 → representative :=
  ![1, rowGenerator j 0, rowGenerator j 1, rowGenerator j 2,
    rowGenerator j 0 * rowGenerator j 1]

private theorem five_mem (j : Fin 22) (i : Fin 5) : five j i ∈ entry j := by
  fin_cases i
  · exact (entry j).one_mem
  · exact rowGenerator_mem j 0
  · exact rowGenerator_mem j 1
  · exact rowGenerator_mem j 2
  · exact (entry j).mul_mem (rowGenerator_mem j 0) (rowGenerator_mem j 1)

private def largeRow (j : Fin 18) : Fin 22 := ⟨j.val + 4, by omega⟩

private def testPoint (j : Fin 18) : Fin 2058 :=
  if j = 1 ∨ j = 6 then 2 else if j = 7 ∨ j = 16 then 1 else 0

private def images : Fin 18 → Fin 5 → Fin 2058
  | 0 => ![0, 374, 1455, 1395, 919]
  | 1 => ![2, 751, 1951, 596, 1939]
  | 2 => ![0, 355, 581, 1395, 374]
  | 3 => ![0, 334, 581, 1395, 1730]
  | 4 => ![0, 1395, 732, 1640, 1853]
  | 5 => ![0, 732, 374, 1455, 334]
  | 6 => ![2, 876, 751, 1951, 1432]
  | 7 => ![1, 1508, 1888, 1158, 1592]
  | 8 => ![0, 1514, 355, 581, 1044]
  | 9 => ![0, 829, 355, 581, 371]
  | 10 => ![0, 1514, 355, 581, 1044]
  | 11 => ![0, 355, 581, 1395, 374]
  | 12 => ![0, 1395, 732, 1640, 1853]
  | 13 => ![0, 334, 732, 1640, 374]
  | 14 => ![0, 1514, 355, 581, 1044]
  | 15 => ![0, 829, 334, 732, 1044]
  | 16 => ![1, 356, 1158, 987, 1172]
  | _ => ![0, 1715, 1419, 334, 1796]

section ImageChecks
set_option maxRecDepth 4096

private theorem images_0 : ∀ i : Fin 5,
    representation (five (largeRow 0) i : He) (testPoint 0) = images 0 i := by
  decide +kernel

