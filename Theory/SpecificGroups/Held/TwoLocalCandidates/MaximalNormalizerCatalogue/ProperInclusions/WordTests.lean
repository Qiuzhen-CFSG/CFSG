module

public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.ElementaryWords
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.CentralWord

/-!
# Word tests for the Held normalizer catalogue

The ambient image of a row is generated by the same words in Held. Generator
conjugation therefore proves normalizer membership. In the opposite direction,
a common fixed point, or an invariant pair, detects failure to normalize.
These tests concern the actual degree-2058 permutation action.

Source: the literal ATLAS HeG1-p2058B0 words and the catalogue discovery data;
GLS3 Table 5.3p and Aschbacher–Smith condition E, printed pp.3–4 and 481–482.
-/

open Subgroup
open scoped Pointwise
namespace Held.TwoLocalCandidates.MaximalNormalizerCatalogue.ProperInclusions
open LocalPairs.SylowGeometry.Calculations

/-- Four literal Held elements used to separate normalizers. Their membership
in the containing normalizers is proved by generator conjugation. -/
@[expose] public def witness : Fin 4 → He
  | 0 => conjugator 0 * (a * b ^ 3) * (conjugator 0)⁻¹
  | 1 => conjugator 3 * a * (conjugator 3)⁻¹
  | 2 => conjugator 3 * LocalPairs.PairCoverage.localWord true * (conjugator 3)⁻¹
  | _ => a

public theorem ambient_le_iff (j : Fin 22) (K : Subgroup He) : ambient j ≤ K ↔
    ∀ w ∈ generatorWords j, (word w : He) ∈ K := by
  rw [ambient, Subgroup.map_le_iff_le_comap, entry, Subgroup.closure_le]
  constructor
  · intro h w hw
    exact h ⟨w, hw, rfl⟩
  · rintro h x ⟨w, hw, rfl⟩
    exact h w hw

@[expose] public def rowElement (j : Fin 22) (i : ℕ) : He :=
  word ((generatorWords j)[i]?.getD [])

public theorem rowElement_mem (j : Fin 22) (i : ℕ) : rowElement j i ∈ ambient j := by
  unfold rowElement
  cases h : (generatorWords j)[i]? with
  | none => exact (ambient j).one_mem
  | some w =>
    exact Subgroup.mem_map_of_mem _ (word_mem_entry j w (List.mem_of_getElem? h))

@[expose] public def rowProduct (j : Fin 22) (is : List ℕ) : He := (is.map (rowElement j)).prod

public theorem rowProduct_mem (j : Fin 22) (is : List ℕ) : rowProduct j is ∈ ambient j := by
  apply Subgroup.list_prod_mem
  intro x hx
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
  exact rowElement_mem j i

public theorem mem_normalizer_of_words (j : Fin 22) (g : He)
    (h : ∀ w ∈ generatorWords j, g * (word w : He) * g⁻¹ ∈ ambient j) :
    g ∈ normalizer (ambient j : Set He) := by
  apply Subgroup.mem_normalizer_fintype
  exact (ambient_le_iff j ((ambient j).comap (MulAut.conj g).toMonoidHom)).mpr h

public theorem not_mem_normalizer_of_fixed_point (j : Fin 22) (g : He) (x : Fin 2058)
    (hfix : ∀ w ∈ generatorWords j, representation (word w : He) x = x)
    (i : ℕ) (hmoved : representation (rowElement j i) (representation g x) ≠ representation g x) :
    g ∉ normalizer (ambient j : Set He) := by
  have hle : ambient j ≤ MulAction.stabilizer He x := (ambient_le_iff j _).mpr hfix
  intro hg
  have hc : g⁻¹ * rowElement j i * g ∈ ambient j := by
    apply (hg (g⁻¹ * rowElement j i * g)).mpr
    simpa only [SetLike.mem_coe, mul_assoc, mul_inv_cancel, mul_one, mul_inv_cancel_left] using
      rowElement_mem j i
  have hfixed := MulAction.mem_stabilizer_iff.mp (hle hc)
  apply hmoved
  change rowElement j i • (g • x) = g • x
  calc
    rowElement j i • (g • x) = g • ((g⁻¹ * rowElement j i * g) • x) := by
      simp only [mul_smul, smul_inv_smul]
    _ = g • x := congrArg (fun y => g • y) hfixed

end Held.TwoLocalCandidates.MaximalNormalizerCatalogue.ProperInclusions

open Subgroup
open scoped Pointwise
namespace Held.TwoLocalCandidates.MaximalNormalizerCatalogue.ProperInclusions

public theorem not_mem_normalizer_of_pair (j : Fin 22) (g : He) (p q : Fin 2058)
    (hpair : ∀ w ∈ generatorWords j,
      (representation (word w : He) p = p ∧ representation (word w : He) q = q) ∨
      (representation (word w : He) p = q ∧ representation (word w : He) q = p))
    (i : ℕ) (hmoved :
      representation (g * rowElement j i * g⁻¹) p ≠ p ∧
      representation (g * rowElement j i * g⁻¹) p ≠ q) :
    g ∉ normalizer (ambient j : Set He) := by
  have hle : ambient j ≤ MulAction.stabilizer He ({p, q} : Set (Fin 2058)) := by
    apply (ambient_le_iff j _).mpr
    intro w hw
    rw [MulAction.mem_stabilizer_iff, Set.smul_set_insert, Set.smul_set_singleton]
    change {representation (word w : He) p, representation (word w : He) q} = {p, q}
    rcases hpair w hw with ⟨hp, hq⟩ | ⟨hp, hq⟩
    · rw [hp, hq]
    · rw [hp, hq, Set.pair_comm]
  intro hg
  have hc : g * rowElement j i * g⁻¹ ∈ ambient j :=
    (hg (rowElement j i)).mp (rowElement_mem j i)
  have hstab := MulAction.mem_stabilizer_iff.mp (hle hc)
  have hm : representation (g * rowElement j i * g⁻¹) p ∈ ({p, q} : Set (Fin 2058)) := by
    rw [← hstab]
    exact ⟨p, by simp, rfl⟩
  exact hm.elim hmoved.1 hmoved.2

end Held.TwoLocalCandidates.MaximalNormalizerCatalogue.ProperInclusions
