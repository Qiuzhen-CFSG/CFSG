module

public import Theory.PGroupCore
public import Mathlib.GroupTheory.Index

/-!
# Characteristic spans detected by centralizer index

An automorphism identifies the centralizers of an element and its image, and
therefore preserves their indices. The subgroup generated by elements with
centralizer index at most two is characteristic. Applying this inside a two-core
and using transitivity of characteristicity gives the centralizer certificate.

This is the intrinsic device for the concrete Held rows 1, 3, and 5, in the
context of GLS3 Table 5.3p. The two-core identification and the finite span
identity remain explicit; no candidate list is assumed exhaustive.
-/

open Subgroup
namespace Held.TwoLocalCandidates.MaximalNormalizerCatalogue.E64Containment.CentralizerCertificates

/-- The subgroup generated by elements whose centralizers have index at most two. -/
@[expose] public noncomputable def indexTwoSpan (G : Type*) [Group G] : Subgroup G :=
  closure {x | (centralizer ({x} : Set G)).index ≤ 2}

/-- Centralizer index is intrinsic, so its generating span is characteristic. -/
public theorem indexTwoSpan_characteristic (G : Type*) [Group G] :
    (indexTwoSpan G).Characteristic := by
  apply characteristic_iff_le_comap.mpr
  intro f
  apply (closure_le _).mpr
  intro x hx
  apply subset_closure
  have hC : (centralizer ({f x} : Set G)).comap f.toMonoidHom =
      centralizer ({x} : Set G) := by
    ext y
    simp only [mem_comap, mem_centralizer_singleton_iff, MulEquiv.coe_toMonoidHom,
      ← map_mul, f.injective.eq_iff]
  have hi := (centralizer ({f x} : Set G)).index_comap_of_surjective (f := f.toMonoidHom) f.surjective
  rw [hC] at hi
  change (centralizer ({f x} : Set G)).index ≤ 2
  rw [← hi]
  exact hx

private theorem characteristic_subgroupOf_trans {G : Type*} [Group G]
    (E Q C : Subgroup G) (hEQ : E ≤ Q) (hQC : Q ≤ C)
    (hE : (E.subgroupOf Q).Characteristic)
    (hQ : (Q.subgroupOf C).Characteristic) : (E.subgroupOf C).Characteristic := by
  let : (Q.subgroupOf C).Characteristic := hQ
  let e := subgroupOfEquivOfLe hQC
  apply characteristic_iff_le_comap.mpr
  intro a x hx
  let xQ : Q := ⟨x, hEQ hx⟩
  let b : MulAut Q := MulAut.congr e (MulAut.characteristic (Q.subgroupOf C) a)
  have h := characteristic_iff_le_comap.mp hE b (show xQ ∈ E.subgroupOf Q from hx)
  exact h

/-- Recover characteristicity from a concrete two-core and its intrinsic span. -/
public theorem characteristic_of_core_and_span {G : Type*} [Group G] (E Q C : Subgroup G)
    (hEQ : E ≤ Q) (hQC : Q ≤ C)
    (hcore : Q.subgroupOf C = pCore 2 C)
    (hspan : indexTwoSpan Q = E.subgroupOf Q) : (E.subgroupOf C).Characteristic := by
  apply characteristic_subgroupOf_trans E Q C hEQ hQC
  · rw [← hspan]
    exact indexTwoSpan_characteristic Q
  · rw [hcore]
    infer_instance

end Held.TwoLocalCandidates.MaximalNormalizerCatalogue.E64Containment.CentralizerCertificates
