/-- Every element of the full row-5 centralizer is included in this bound. -/
public theorem centralizer_card_le (hp : IsPGroup 2 representative) :
    Nat.card (Subgroup.centralizer (ambient 5 : Set He)) ≤ 128 := by
  have hi : Function.Injective (fun i => fingerprint tests (witness (codes i) : He)) := by
    intro i k h
    apply key_injective
    simpa only [← fastFingerprint_eq, ← fastWitness_eq, signature_check] using h
  have h := mul_card_centralizer_le hp 5 tests tests_mem codes hi
  omega

