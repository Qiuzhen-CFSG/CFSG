module

public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.ElementaryWords
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.CentralWord

/-!+# Normalizer-invariant permutation signatures in Held

Conjugation transports fixed points bijectively. Consequently the normalizer
of a subgroup preserves the subgroup generated by elements having a specified
fixed-point count. It also preserves the number of elements with 154 fixed
points whose left translate has 154 fixed points.

These constructions reduce five E64-containment rows to smaller rows once
their literal finite reconstruction identities have been certified. No
reconstruction identity or normalizer containment for a particular row is
assumed by the invariance theorems below.

Sources: the literal ATLAS degree-2058 action; GLS3 Table 5.3p; the unchanged
catalogue words in `MaximalNormalizerCatalogue/source/discovery.json`.
-/

namespace Held.TwoLocalCandidates.MaximalNormalizerCatalogue.E64Containment
open Subgroup

/-- The number of fixed points in the actual degree-2058 action. -/
@[expose] public def fixedPointCount (x : He) : ℕ :=
  Fintype.card {v : Fin 2058 // representation x v = v}

private def fixedPointEquiv (g x : He) :
    {v : Fin 2058 // representation x v = v} ≃
      {v : Fin 2058 // representation (g * x * g⁻¹) v = v} where
  toFun v := ⟨g • v.val, by
    change (g * x * g⁻¹) • (g • v.val) = g • v.val
    have hv : x • v.val = v.val := v.property
    simp only [mul_smul, inv_smul_smul, hv]⟩
  invFun v := ⟨g⁻¹ • v.val, by
    change x • (g⁻¹ • v.val) = g⁻¹ • v.val
    have hv : (g * x * g⁻¹) • v.val = v.val := v.property
    simpa only [mul_smul, inv_smul_smul] using congrArg (g⁻¹ • ·) hv⟩
  left_inv v := Subtype.ext (inv_smul_smul g v.val)
  right_inv v := Subtype.ext (smul_inv_smul g v.val)

public theorem fixedPointCount_conj (g x : He) :
    fixedPointCount (g * x * g⁻¹) = fixedPointCount x :=
  (Fintype.card_congr (fixedPointEquiv g x)).symm

/-- Generate a subgroup from elements with the specified fixed-point count. -/
@[expose] public def fixedPointSpan (H : Subgroup He) (n : ℕ) : Subgroup He :=
  closure {x | x ∈ H ∧ fixedPointCount x = n}

public theorem normalizer_le_fixedPointSpan (H : Subgroup He) (n : ℕ) :
    normalizer (H : Set He) ≤ normalizer (fixedPointSpan H n : Set He) := by
  apply le_normalizer_closure_iff.mpr
  intro g hg x hx
  exact subset_closure ⟨(hg x).mp hx.1, (fixedPointCount_conj g x).trans hx.2⟩

/-- Count the 154-fixed-point elements whose left translate also has 154 fixed points. -/
@[expose] public noncomputable def overlapCount (H : Subgroup He) (x : He) : ℕ :=
  Nat.card {y : H // fixedPointCount y.val = 154 ∧ fixedPointCount (x * y.val) = 154}

public theorem overlapCount_conj (H : Subgroup He) (g : He)
    (hg : g ∈ normalizer (H : Set He)) (x : He) :
    overlapCount H (g * x * g⁻¹) = overlapCount H x := by
  let a : MulAut H := H.normalizerMonoidHom ⟨g, hg⟩
  apply Eq.symm
  apply Nat.card_congr (Equiv.subtypeEquiv a.toEquiv _)
  intro y
  change (fixedPointCount y.val = 154 ∧ fixedPointCount (x * y.val) = 154) ↔
    (fixedPointCount (g * y.val * g⁻¹) = 154 ∧
      fixedPointCount ((g * x * g⁻¹) * (g * y.val * g⁻¹)) = 154)
  rw [show (g * x * g⁻¹) * (g * y.val * g⁻¹) = g * (x * y.val) * g⁻¹ by
    simp only [mul_assoc, inv_mul_cancel_left]]
  rw [fixedPointCount_conj, fixedPointCount_conj]

/-- Generate a subgroup from elements with the specified translation-overlap count. -/
@[expose] public noncomputable def overlapSpan (H : Subgroup He) (n : ℕ) : Subgroup He :=
  closure {x | x ∈ H ∧ overlapCount H x = n}

public theorem normalizer_le_overlapSpan (H : Subgroup He) (n : ℕ) :
    normalizer (H : Set He) ≤ normalizer (overlapSpan H n : Set He) := by
  apply le_normalizer_closure_iff.mpr
  intro g hg x hx
  exact subset_closure ⟨(hg x).mp hx.1, (overlapCount_conj H g hg x).trans hx.2⟩

end Held.TwoLocalCandidates.MaximalNormalizerCatalogue.E64Containment
