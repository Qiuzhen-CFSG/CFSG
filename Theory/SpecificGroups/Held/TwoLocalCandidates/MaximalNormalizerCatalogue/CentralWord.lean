module

public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.ElementaryWords
public import Theory.SpecificGroups.Held.Model.FourPointBase
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# The common involution in the Held subgroup table

The common word is a nonidentity involution centralizing the four generators
of the fixed representative. The square and commutations are checked on Held's
certified four-point base, then closure extends centralization to the subgroup.
The first table entry is exactly the subgroup generated by this actual word.
This supplies the central involution for the first ambient-normalizer calculation;
it does not assert that the representative has no other central elements.

Source: the ATLAS degree-2058 action and GLS3 Table 5.3p (the 2B centralizer).
The common word is retained in the companion subgroup discovery data.
-/

namespace Held.TwoLocalCandidates.MaximalNormalizerCatalogue
open Subgroup LocalPairs.SylowGeometry.Calculations

@[expose] public def centralWord : He := word commonWord

set_option maxRecDepth 4096 in
set_option maxHeartbeats 1000000 in
public theorem centralWord_sq : centralWord ^ 2 = 1 := by
  apply eq_of_four_point_images
  decide +kernel

set_option maxRecDepth 4096 in
set_option maxHeartbeats 2000000 in
public theorem centralWord_commutes_generator (j : Fin 4) :
    centralWord * generator j = generator j * centralWord := by
  apply eq_of_four_point_images
  have h : ∀ j : Fin 4, ∀ x : Fin 4,
      representation (centralWord * generator j) ⟨x.val, by omega⟩ =
        representation (generator j * centralWord) ⟨x.val, by omega⟩ := by
    decide +kernel
  exact h j

public theorem representative_le_centralizer_centralWord :
    representative ≤ centralizer ({centralWord} : Set He) := by
  apply (closure_le _).mpr
  rintro _ ⟨j, rfl⟩
  exact mem_centralizer_singleton_iff.mpr (centralWord_commutes_generator j).symm

public theorem entry_zero_eq_zpowers : entry 0 = zpowers (word commonWord) := by
  change closure {x : representative | ∃ w ∈ [commonWord], word w = x} = _
  rw [zpowers_eq_closure]
  congr 1
  ext x
  simp only [Set.mem_ofPred_eq, List.mem_singleton, exists_eq_left, Set.mem_singleton_iff]
  exact eq_comm

public theorem ambient_zero_eq_zpowers : ambient 0 = zpowers centralWord := by
  unfold ambient
  rw [entry_zero_eq_zpowers, MonoidHom.map_zpowers]
  rfl

public theorem centralWord_ne_one : centralWord ≠ 1 := by
  intro h
  apply ambient_ne_bot 0
  rw [ambient_zero_eq_zpowers, h, zpowers_one_eq_bot]

public theorem centralWord_order : orderOf centralWord = 2 :=
  (Nat.dvd_prime Nat.prime_two).mp (orderOf_dvd_of_pow_eq_one centralWord_sq) |>.resolve_left
    (fun h => centralWord_ne_one (orderOf_eq_one_iff.mp h))

end Held.TwoLocalCandidates.MaximalNormalizerCatalogue
