/-- The literal max5 subgroup contains at least 21504 elements. -/
public theorem max5_card_lower_bound : 21504 ≤ Nat.card max5 := by
  have h0 := orbit_lower (G := S0) (0 : Fin 2058) point0 point0_injective reach0
  have h1 := orbit_lower (G := S1) (1 : Fin 2058) point1 point1_injective reach1
  have h2 := orbit_lower (G := S2) (2 : Fin 2058) point2 point2_injective reach2
  have hp : 0 < Nat.card (MulAction.stabilizer S2 (2 : Fin 2058)) := Nat.card_pos
  have hm : max5.map representation = tableGroup := by
    rw [max5_map]
    have he0 : representation max5First = p0 := p0_eq.symm
    have he1 : representation max5Second = p1 := p1_eq.symm
    exact congrArg Subgroup.closure
      (congrArg₂ (fun x y : Equiv.Perm (Fin 2058) => ({x, y} : Set (Equiv.Perm (Fin 2058))))
        he0 he1)
  have he := Nat.card_congr (max5.equivMapOfInjective representation representation_injective).toEquiv
  rw [hm] at he
  change 1344 * Nat.card S1 ≤ Nat.card S0 at h0
  change 8 * Nat.card S2 ≤ Nat.card S1 at h1
  change Nat.card max5 = Nat.card S0 at he
  omega
end Held.TwoLocalCandidates.CentralInvolutionBounds
