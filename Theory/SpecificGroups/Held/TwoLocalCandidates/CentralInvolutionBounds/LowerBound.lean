/-!
# An orbit certificate for the max5 lower bound

Schreier words in the literal two max5 generators give orbit trees of sizes
1344, 8 and 2 at vertices 0, 1 and 2. Every tree edge and stabilizer membership
is checked by kernel reduction using the published permutation tables.
Orbit–stabilizer gives the lower bound without an ambient group order.
Source: ATLAS HeG1-max5W1 and GLS3 Table 5.3p.
-/
namespace Held.TwoLocalCandidates.CentralInvolutionBounds
open Cores Cores.Tables2
private theorem orbit_lower {G X : Type*} [Group G] [MulAction G X]
    [Finite G] {m : ℕ} (b : X) (point : Fin m → X)
    (hi : Function.Injective point)
    (hr : ∀ i, ∃ g : G, g • b = point i) :
    m * Nat.card (MulAction.stabilizer G b) ≤ Nat.card G := by
  classical
  choose rep hrep using hr
  have hinj : Function.Injective (fun z : Fin m × MulAction.stabilizer G b =>
      rep z.1 * z.2.val) := by
    rintro ⟨i, g⟩ ⟨j, h⟩ heq
    have hij : i = j := hi (by
      have he := congrArg (fun k : G => k • b) heq
      simpa only [mul_smul, MulAction.mem_stabilizer_iff.mp g.property,
        MulAction.mem_stabilizer_iff.mp h.property, hrep] using he)
    subst j
    have hgh : g = h := Subtype.ext (mul_left_cancel heq)
    subst h
    rfl
  simpa only [Nat.card_prod, Nat.card_fin] using Nat.card_le_card_of_injective _ hinj

private theorem orbit_tree {G X : Type*} [Group G] [MulAction G X]
    {m r : ℕ} [NeZero m] (gen : Fin r → G) (b : X) (point : Fin m → X)
    (parent : Fin m → Fin m) (step : Fin m → Fin r) (depth : Fin m → ℕ)
    (hbase : point 0 = b)
    (hstep : ∀ i, i = 0 ∨ (depth (parent i) < depth i ∧
      gen (step i) • point (parent i) = point i)) :
    ∀ i, ∃ g : G, g • b = point i := by
  suffices h : ∀ n : ℕ, ∀ i, depth i = n → ∃ g : G, g • b = point i from
    fun i => h (depth i) i rfl
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro i hi
    rcases hstep i with rfl | ⟨hd, hs⟩
    · exact ⟨1, by simpa using hbase.symm⟩
    · obtain ⟨g, hg⟩ := ih (depth (parent i)) (by omega) (parent i) rfl
      exact ⟨gen (step i) * g, by rw [mul_smul, hg, hs]⟩


private def tableGroup : Subgroup (Equiv.Perm (Fin 2058)) := Subgroup.closure {p0, p1}
private abbrev S0 := ↥tableGroup
private def gen0 (i : Fin 2) : S0 :=
  if i.val = 0 then ⟨p0, Subgroup.subset_closure (Set.mem_insert _ _)⟩
  else ⟨p1, Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)⟩
private def signedGen0 (i : Fin 4) : S0 :=
  (if i.val < 2 then (if i.val < 1 then gen0 0 else gen0 1) else (if i.val < 3 then (gen0 0)⁻¹ else (gen0 1)⁻¹))

