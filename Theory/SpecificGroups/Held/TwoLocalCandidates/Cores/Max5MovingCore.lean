module

public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Max5PointComparison
public import Theory.SpecificGroups.Held.RankOneLocalPair.Maximal.MatrixQuotient

/-!
# The moving two-core of the literal Held max5

The seven checked core words have 128 distinct products, distinguished on
letters 0 and 1 of the actual Held representation. This identifies their
closure with the intrinsic two-core. The checked commutator relations then
put its derived subgroup in the central line. The local conjugation relations
make the whole two-core generated by its commutators with max5.
-/

public section
open Subgroup
open scoped commutatorElement
namespace Held.TwoLocalCandidates.Cores
open Tables2

private def bitWord (n : Fin 128) : List (Fin 7) :=
  (List.finRange 7).filter (fun j => n.val.testBit j.val)

private def wordElement (n : Fin 128) : subgroup 2 := coreProduct 2 (bitWord n)

private def tableGenerator : Fin 7 → Equiv.Perm (Fin 2058)
  | 0 => p2 | 1 => p3 | 2 => p4 | 3 => p5 | 4 => p6 | 5 => p7 | 6 => p8

private def wordPermutation (n : Fin 128) : Equiv.Perm (Fin 2058) :=
  ((bitWord n).map tableGenerator).prod

private theorem tableGenerator_eq (j : Fin 7) :
    tableGenerator j = embedding 2 (coreGenerator 2 j) := by
  fin_cases j
  · exact p2_eq
  · exact p3_eq
  · exact p4_eq
  · exact p5_eq
  · exact p6_eq
  · exact p7_eq
  · exact p8_eq

private theorem wordPermutation_eq (n : Fin 128) :
    wordPermutation n = embedding 2 (wordElement n) := by
  simp only [wordPermutation,wordElement,coreProduct,map_list_prod,List.map_map]
  congr 1
  apply List.map_congr_left
  intro j _
  exact tableGenerator_eq j

set_option maxRecDepth 8192 in
set_option maxHeartbeats 1600000 in
private theorem wordPair_injective : Function.Injective
    (fun n : Fin 128 => (wordPermutation n 0,wordPermutation n 1)) := by
  decide +kernel

private theorem core_card_lower : 128 ≤ Nat.card (core 2) := by
  let f : Fin 128 → core 2 := fun n => ⟨wordElement n,coreProduct_mem 2 _⟩
  have hf : Function.Injective f := by
    intro m n he
    apply wordPair_injective
    have hh : wordPermutation m = wordPermutation n := by
      rw [wordPermutation_eq,wordPermutation_eq]
      exact congrArg (embedding 2) (congrArg Subtype.val he)
    exact congrArg (fun p : Equiv.Perm (Fin 2058) => (p 0,p 1)) hh
  simpa only [Nat.card_fin] using Nat.card_le_card_of_injective f hf

private theorem core_eq_pCore : core 2 = pCore 2 (subgroup 2) := by
  have hle : core 2 ≤ pCore 2 (subgroup 2) := le_sSup ⟨core_normal 2,core_isPGroup 2⟩
  apply eq_of_le_of_card_ge hle
  have hc : Nat.card (pCore 2 (subgroup 2)) = 128 := by
    change Nat.card (pCore 2 max5) = 128
    rw [←RankOneLocalPair.MatrixQuotient.kernel_eq_pCore]
    exact RankOneLocalPair.MatrixQuotient.kernel_card
  rw [hc]
  exact core_card_lower

private theorem central_generator : coreGenerator 2 0 ∈ center (subgroup 2) := by
  have hv : coreGenerator 2 0 = localGenerator 2 0 ^ 4 := by
    simp only [coreGenerator,coreWord,List.map_cons,List.map_nil,List.prod_cons,
      List.prod_nil,mul_one,zpow_ofNat]
  rw [hv]
  apply mem_center_iff.mpr
  intro a
  apply Subtype.ext
  exact mem_centralizer_singleton_iff.mp
    (CentralInvolutionBounds.max5_le_centralizer a.property)

private theorem core_derived_central : ⁅core 2,core 2⁆ ≤ center (subgroup 2) := by
  let q := QuotientGroup.mk' (center (subgroup 2))
  have hz : q (coreGenerator 2 0) = 1 := (QuotientGroup.eq_one_iff _).mpr central_generator
  have hcomm (k j : Fin 7) :
      q (coreGenerator 2 k) * q (coreGenerator 2 j) =
        q (coreGenerator 2 j) * q (coreGenerator 2 k) := by
    rcases lt_trichotomy j.val k.val with hlt | he | hlt
    · have hh := congrArg q (internalConjugation 2 k j hlt)
      simp only [map_mul,map_inv,map_pow,hz,one_pow,one_mul] at hh
      exact mul_inv_eq_iff_eq_mul.mp hh
    · have hj : j=k := Fin.ext he
      rw [hj]
    · have hh := congrArg q (internalConjugation 2 j k hlt)
      simp only [map_mul,map_inv,map_pow,hz,one_pow,one_mul] at hh
      exact (mul_inv_eq_iff_eq_mul.mp hh).symm
  have hc : IsMulCommutative ((core 2).map q) := by
    rw [core,MonoidHom.map_closure]
    apply isMulCommutative_closure
    rintro _ ⟨_,⟨k,rfl⟩,rfl⟩ _ ⟨_,⟨j,rfl⟩,rfl⟩
    exact hcomm k j
  have hzq : (⁅core 2,core 2⁆).map q = ⊥ := by
    rw [map_commutator]
    exact commutator_eq_bot_iff_le_centralizer.mpr
      (le_centralizer_iff_isMulCommutative.mpr hc)
  simpa only [q,Subgroup.map_eq_bot_iff,QuotientGroup.ker_mk'] using hzq

private theorem core_fully_moved : ⁅core 2,(⊤ : Subgroup (subgroup 2))⁆ = core 2 := by
  let := core_normal 2
  let R := ⁅core 2,(⊤ : Subgroup (subgroup 2))⁆
  let q := QuotientGroup.mk' R
  have hconj (g : subgroup 2) (x : subgroup 2) (hx : x ∈ core 2) :
      q (g*x*g⁻¹) = q x := by
    have hk : ⁅g,x⁆ ∈ R := by
      change ⁅g,x⁆ ∈ ⁅core 2,(⊤ : Subgroup (subgroup 2))⁆
      rw [commutator_comm]
      exact commutator_mem_commutator (mem_top g) hx
    have hh := (QuotientGroup.eq_one_iff _).mpr hk
    change q (g*x*g⁻¹*x⁻¹)=1 at hh
    simpa only [map_mul,map_inv,mul_inv_eq_one] using hh
  have hrel (k : Fin 2) (j : Fin 7) :
      q (coreProduct 2 (conjugateWord 2 k j)) = q (coreGenerator 2 j) := by
    rw [←localConjugation]
    exact hconj _ _ (coreGenerator_mem _ _)
  have hz : q (coreGenerator 2 0)=1 := by
    have hh := congrArg q (internalConjugation 2 4 1 (by decide))
    rw [hconj _ _ (coreGenerator_mem 2 1)] at hh
    change q (coreGenerator 2 1)=q (coreGenerator 2 0 ^ 1 * coreGenerator 2 1) at hh
    simpa only [map_mul,map_pow,pow_one,mul_eq_right] using hh.symm
  have h21 : q (coreGenerator 2 2)=q (coreGenerator 2 1) := by
    simpa only [conjugateWord,coreProduct,List.map_cons,List.map_nil,List.prod_cons,
      List.prod_nil,mul_one] using hrel 0 1
  have h31 : q (coreGenerator 2 3)=q (coreGenerator 2 1) := by
    simpa only [conjugateWord,coreProduct,List.map_cons,List.map_nil,List.prod_cons,
      List.prod_nil,mul_one] using hrel 1 1
  have h42 : q (coreGenerator 2 4)=q (coreGenerator 2 2) := by
    simpa only [conjugateWord,coreProduct,List.map_cons,List.map_nil,List.prod_cons,
      List.prod_nil,mul_one] using hrel 1 2
  have h53 : q (coreGenerator 2 5)=q (coreGenerator 2 3) := by
    simpa only [conjugateWord,coreProduct,List.map_cons,List.map_nil,List.prod_cons,
      List.prod_nil,mul_one] using hrel 1 3
  have h64 : q (coreGenerator 2 6)=q (coreGenerator 2 4) := by
    simpa only [conjugateWord,coreProduct,List.map_cons,List.map_nil,List.prod_cons,
      List.prod_nil,mul_one] using hrel 1 4
  have h1 : q (coreGenerator 2 1)=1 := by
    have hh := hrel 0 4
    simp only [conjugateWord,coreProduct,List.map_cons,List.map_nil,List.prod_cons,
      List.prod_nil,mul_one,map_mul,hz,one_mul,h21,h53,h31,h42] at hh
    exact mul_right_cancel (hh.trans (one_mul _).symm)
  apply le_antisymm (commutator_le_left _ _)
  apply (closure_le _).mpr
  rintro _ ⟨j,rfl⟩
  apply (QuotientGroup.eq_one_iff _).mp
  fin_cases j
  · exact hz
  · exact h1
  · exact h21.trans h1
  · exact h31.trans h1
  · exact h42.trans (h21.trans h1)
  · exact h53.trans (h31.trans h1)
  · exact h64.trans (h42.trans (h21.trans h1))

private theorem core_derived_ne_bot : ⁅core 2,core 2⁆ ≠ ⊥ := by
  intro hb
  have hc := commutator_eq_bot_iff_le_centralizer.mp hb
  have hmul := hc (coreGenerator_mem 2 4) _ (coreGenerator_mem 2 1)
  have hh := internalConjugation 2 4 1 (by decide)
  change coreGenerator 2 4 * coreGenerator 2 1 * (coreGenerator 2 4)⁻¹ =
    coreGenerator 2 0 ^ 1 * coreGenerator 2 1 at hh
  rw [←hmul,mul_inv_cancel_right,pow_one] at hh
  have hz : coreGenerator 2 0=1 := mul_right_cancel (hh.symm.trans (one_mul _).symm)
  have hh := congrArg (fun x : subgroup 2 => embedding 2 x (0 : Fin 2058)) hz
  change embedding 2 (coreGenerator 2 0) 0 = embedding 2 1 0 at hh
  rw [←p2_eq,map_one] at hh
  exact (by decide +kernel : p2 0 ≠ (0 : Fin 2058)) hh

/-- The actual moving two-core has a nontrivial derived subgroup fixed by max5. -/
theorem max5_moving_core_derived :
    let R := ⁅pCore 2 (subgroup 2),(⊤ : Subgroup (subgroup 2))⁆
    ⁅R,R⁆ ≠ ⊥ ∧ ⁅⁅R,R⁆,(⊤ : Subgroup (subgroup 2))⁆ = ⊥ := by
  dsimp only
  rw [←core_eq_pCore,core_fully_moved]
  exact ⟨core_derived_ne_bot,commutator_eq_bot_iff_le_centralizer.mpr
    (by simpa only [coe_top,centralizer_univ] using core_derived_central)⟩

end Held.TwoLocalCandidates.Cores
