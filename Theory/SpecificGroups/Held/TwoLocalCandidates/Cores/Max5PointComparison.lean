/-!
# Held's max5 and normalized binary-three sections

The checked generator relations make the abelianization of max5 trivial.
Its graph core centralizer is generated by the central fourth power of the
first generator, so the center of its intrinsic two-core is central in max5.
A subgroup normalized by a full Sylow two-subgroup whose order has a factor
168 must therefore be max5 itself: adjoining the Sylow gives all of max5,
and the resulting two-group quotient of this perfect group is trivial.

Source: GLS3 Table 5.3p, the literal ATLAS max5 generators; used for the
Held comparison in Aschbacher--Smith A.3.12 and 10.2.9.
-/

public section
open Subgroup
open Held.TwoLocalCandidates Held.TwoLocalCandidates.Cores
namespace Held.TwoLocalCandidates
open Cores.Tables2

private theorem generators_trivial {A : Type*} [CommGroup A] (x y : A)
    (hx : x ^ 16 = 1) (hy : y ^ 3 = 1)
    (hw : (x * y⁻¹) ^ 4 = 1)
    (hc : x * (y * x^2 * y * x * y * x * y * x⁻¹ * y⁻¹) * x⁻¹ =
      x^4 * (x^2 * y * x * y * x * y * x⁻¹) * (y^2 * x * y * x * y * x * y⁻¹)) :
    x = 1 ∧ y = 1 := by
  let a := Additive.ofMul x
  let b := Additive.ofMul y
  have h16 : (16 : ℤ) • a = 0 := by
    have h := congrArg Additive.ofMul hx
    simpa only [ofMul_pow,ofMul_one,Int.reduceNeg,ofNat_zsmul] using h
  have h3 : (3 : ℤ) • b = 0 := by
    have h := congrArg Additive.ofMul hy
    simpa only [ofMul_pow,ofMul_one,ofNat_zsmul] using h
  have hconj := congrArg Additive.ofMul hc
  simp only [ofMul_mul,ofMul_pow,ofMul_inv] at hconj
  change a + (b + (2 : ℕ) • a + b + a + b + a + b + -a + -b) + -a =
    (4 : ℕ) • a + ((2 : ℕ) • a + b + a + b + a + b + -a) +
      ((2 : ℕ) • b + a + b + a + b + a + -b) at hconj
  abel_nf at hconj
  have h7 : (7 : ℤ) • a = 0 := by
    have hh := sub_eq_zero.mpr hconj.symm
    abel_nf at hh
    simpa only [h3,add_zero] using hh
  have ha : a = 0 := calc
    a = (7 : ℤ) • ((7 : ℤ) • a) - (3 : ℤ) • ((16 : ℤ) • a) := by abel
    _ = 0 := by rw [h7,h16]; simp
  have h4 : (4 : ℤ) • b = 0 := by
    have h := congrArg Additive.ofMul hw
    simp only [ofMul_pow,ofMul_mul,ofMul_inv,ofMul_one] at h
    change (4 : ℕ) • (a + -b) = 0 at h
    rw [ha,zero_add] at h
    simpa only [smul_neg,neg_eq_zero,ofNat_zsmul] using h
  have hb : b = 0 := calc
    b = (4 : ℤ) • b - (3 : ℤ) • b := by abel
    _ = 0 := by rw [h4,h3]; simp
  exact ⟨ha,hb⟩

public theorem max5_perfect : Group.IsPerfect (subgroup 2) := by
  let f : subgroup 2 →* Abelianization (subgroup 2) := Abelianization.of
  have hx16 : localGenerator 2 0 ^ 16 = 1 := by
    simpa only [coreGenerator,coreWord,List.map_cons,List.map_nil,List.prod_cons,
      List.prod_nil,mul_one,zpow_ofNat,←pow_mul] using coreGenerator_pow_four 2 0
  have hc : localGenerator 2 0 *
      (localGenerator 2 1 * localGenerator 2 0^2 * localGenerator 2 1 *
        localGenerator 2 0 * localGenerator 2 1 * localGenerator 2 0 *
        localGenerator 2 1 * (localGenerator 2 0)⁻¹ * (localGenerator 2 1)⁻¹) *
      (localGenerator 2 0)⁻¹ =
      localGenerator 2 0^4 *
      (localGenerator 2 0^2 * localGenerator 2 1 * localGenerator 2 0 *
        localGenerator 2 1 * localGenerator 2 0 * localGenerator 2 1 * (localGenerator 2 0)⁻¹) *
      (localGenerator 2 1^2 * localGenerator 2 0 * localGenerator 2 1 *
        localGenerator 2 0 * localGenerator 2 1 * localGenerator 2 0 * (localGenerator 2 1)⁻¹) := by
    simpa only [coreProduct,conjugateWord,coreGenerator,coreWord,List.map_cons,
      List.map_nil,List.prod_cons,List.prod_nil,mul_one,zpow_ofNat,zpow_neg_one,
      pow_one,mul_assoc] using localConjugation 2 0 4
  obtain ⟨hx,hy⟩ := generators_trivial (f (localGenerator 2 0)) (f (localGenerator 2 1))
    (by rw [←map_pow,hx16,map_one])
    (by rw [←map_pow,max5_second_cube,map_one])
    (by rw [←map_inv,←map_mul,←map_pow,max5_alternate_fourth,map_one])
    (by simpa only [map_mul,map_pow,map_inv] using congrArg f hc)
  constructor
  apply top_unique
  rw [←localGenerator_closure 2,←Abelianization.ker_of]
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨j,rfl⟩
  apply MonoidHom.mem_ker.mpr
  fin_cases j
  · exact hx
  · exact hy

public theorem max5_core_center_central :
    (center (pCore 2 (subgroup 2))).map (pCore 2 (subgroup 2)).subtype ≤ center (subgroup 2) := by
  have hcore : core 2 ≤ pCore 2 (subgroup 2) :=
    le_sSup ⟨core_normal 2,core_isPGroup 2⟩
  have hz : coreGenerator 2 0 ∈ center (subgroup 2) := by
    have hv : coreGenerator 2 0 = localGenerator 2 0 ^ 4 := by
      simp only [coreGenerator,coreWord,List.map_cons,List.map_nil,List.prod_cons,
        List.prod_nil,mul_one,zpow_ofNat]
    rw [hv]
    apply mem_center_iff.mpr
    intro a
    apply Subtype.ext
    exact mem_centralizer_singleton_iff.mp
      (CentralInvolutionBounds.max5_le_centralizer a.property)
  have hC : centralizer (core 2 : Set (subgroup 2)) ≤ center (subgroup 2) := by
    intro a ha
    obtain ⟨k,hk⟩ := mem_zpowers_iff.mp
      (Max5Centralizer.graphCentralizer_le_zpowers (Max5Centralizer.embedding_mem a ha))
    have he : coreGenerator 2 0 ^ k = a := by
      apply embedding_injective 2
      rw [map_zpow,←p2_eq,←Max5Centralizer.z,Max5Centralizer.z_eq]
      exact hk
    rw [←he]
    exact (center _).zpow_mem hz k
  rintro _ ⟨z,hz,rfl⟩
  apply hC
  intro r hr
  exact congrArg Subtype.val (mem_center_iff.mp hz ⟨r,hcore hr⟩)

public theorem max5_normalized_subgroup_top (S : Sylow 2 (subgroup 2))
    (B : Subgroup (subgroup 2)) (hn : (S : Subgroup (subgroup 2)) ≤ normalizer (B : Set (subgroup 2)))
    (h168 : 168 ∣ Nat.card B) : B = ⊤ := by
  have hc : Nat.card (subgroup 2) = 21504 := InvolutionFixedData.TwoB.max5_card
  have hs : Nat.card S = 1024 := by rw [S.card_eq_multiplicity,hc]; decide +kernel
  have hJ : B ⊔ (S : Subgroup (subgroup 2)) = ⊤ := by
    apply eq_top_of_card_eq
    apply Nat.dvd_antisymm
    · exact (B ⊔ (S : Subgroup (subgroup 2))).card_subgroup_dvd_card
    · rw [hc]
      have h1 := h168.trans (card_dvd_of_le (show B ≤ B ⊔ (S : Subgroup _) from le_sup_left))
      have h2 : 1024 ∣ Nat.card ↥(B ⊔ (S : Subgroup (subgroup 2))) :=
        hs ▸ card_dvd_of_le (show (S : Subgroup _) ≤ B ⊔ (S : Subgroup _) from le_sup_right)
      simpa only [show Nat.lcm 168 1024 = 21504 from by decide] using Nat.lcm_dvd h1 h2
  have hnormal : B.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [←hJ]
    exact sup_le B.le_normalizer hn
  let := hnormal
  have hd : Nat.card ((subgroup 2) ⧸ B) ∣ 2^7 := by
    apply Nat.dvd_of_mul_dvd_mul_left (by decide : 0 < 168)
    have hh := Nat.mul_dvd_mul_right h168 (Nat.card ((subgroup 2) ⧸ B))
    rw [←index_eq_card,B.card_mul_index,hc] at hh
    exact hh
  have hp : IsPGroup 2 ((subgroup 2) ⧸ B) := isPGroup_iff_card_dvd_pow.mpr ⟨7,hd⟩
  let : Group.IsNilpotent ((subgroup 2) ⧸ B) := hp.isNilpotent
  let : Group.IsPerfect (subgroup 2) := max5_perfect
  exact top_le_iff.mp (le_of_isPerfect_of_solvable_quotient ⊤ B)
end Held.TwoLocalCandidates
