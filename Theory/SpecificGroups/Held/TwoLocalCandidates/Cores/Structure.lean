module

public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Relations0
public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Relations1
public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Relations2
public import Theory.GroupTheory.PGroup.GeneratorSeries
import Mathlib.Tactic.FinCases

/-!
# Normal two-subgroups in Held's three literal local candidates

The checked power and triangular conjugation identities show that the seven
word generators generate a two-group. Conjugation by each of the two defining
local generators preserves their closure, proving normality intrinsically
in the candidate. Self-centralization is a separate finite calculation.

Source: GLS3 Table 5.3p, the two E64.(3.S6) classes and the
extraspecial 2^(1+6).L3(2) centralizer; ATLAS max3, max4 and max5.
-/

namespace Held.TwoLocalCandidates.Cores

public theorem coreGenerator_pow_four (i : Fin 3) (j : Fin 7) :
    coreGenerator i j ^ 4 = 1 := by
  fin_cases i
  · exact powers0 j
  · exact powers1 j
  · exact powers2 j

public theorem internalConjugation (i : Fin 3) (k j : Fin 7) (h : j.val < k.val) :
    coreGenerator i k * coreGenerator i j * (coreGenerator i k)⁻¹ =
      coreGenerator i 0 ^ (if commutatorBit i k j then 1 else 0) * coreGenerator i j := by
  fin_cases i
  · exact internalConjugation0 k j h
  · exact internalConjugation1 k j h
  · exact internalConjugation2 k j h

public theorem localConjugation (i : Fin 3) (k : Fin 2) (j : Fin 7) :
    localGenerator i k * coreGenerator i j * (localGenerator i k)⁻¹ =
      coreProduct i (conjugateWord i k j) := by
  fin_cases i
  · exact localConjugation0 k j
  · exact localConjugation1 k j
  · exact localConjugation2 k j

public theorem coreProduct_mem (i : Fin 3) (w : List (Fin 7)) :
    coreProduct i w ∈ core i := by
  apply Subgroup.list_prod_mem
  intro x hx
  obtain ⟨j, _, rfl⟩ := List.mem_map.mp hx
  exact coreGenerator_mem i j

/-- Each generator normalizes the subgroup generated by its predecessors. -/
public theorem coreGenerator_normalizes_prefix (i : Fin 3) (k : Fin 7) :
    coreGenerator i k ∈ Subgroup.normalizer
      (Subgroup.generatorPrefix (coreGenerator i) k.val : Set (subgroup i)) := by
  unfold Subgroup.generatorPrefix
  apply Subgroup.mem_normalizer_closure_of_conjugates
  rintro _ ⟨j, hj, rfl⟩
  change _ ∈ Subgroup.generatorPrefix (coreGenerator i) k.val
  rw [internalConjugation i k j hj]
  have hm (t : Fin 7) (ht : t.val < k.val) :
      coreGenerator i t ∈ Subgroup.generatorPrefix (coreGenerator i) k.val :=
    (Subgroup.generatorPrefix_le _ _ _).mp le_rfl t ht
  exact (Subgroup.generatorPrefix _ _).mul_mem
    ((Subgroup.generatorPrefix _ _).pow_mem (hm 0 (lt_of_le_of_lt (Nat.zero_le j.val) hj)) _) (hm j hj)

/-- The actual word-defined closure is a two-group, with no order assumption. -/
public theorem core_isPGroup (i : Fin 3) : IsPGroup 2 (core i) :=
  Subgroup.isPGroup_closure_of_normalizing_generators (coreGenerator i)
    (fun j => ⟨2, coreGenerator_pow_four i j⟩) (coreGenerator_normalizes_prefix i)

/-- Normality is inside the literal candidate, not in the ambient Held group. -/
public theorem core_normal (i : Fin 3) : (core i).Normal := by
  apply Subgroup.normalizer_eq_top_iff.mp
  apply top_unique
  rw [← localGenerator_closure i]
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨k, rfl⟩
  apply Subgroup.mem_normalizer_closure_of_conjugates
  rintro _ ⟨j, rfl⟩
  rw [localConjugation]
  exact coreProduct_mem i _

end Held.TwoLocalCandidates.Cores
