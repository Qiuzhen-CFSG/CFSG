module

public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.TablesSupport

/-!
# Checked lookup tables for Held local candidate 1

Each table is checked on all 2058 letters against its actual word in the
ATLAS candidate. Packing is only an evaluation optimization. The generator
script and source words are retained in `Cores/source`.
Source: ATLAS HeG1-p2058B0; GLS3 Table 5.3p.
-/

namespace Held.TwoLocalCandidates.Cores.Tables1

@[expose] public def forward0 (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def backward0 (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 8192 in
set_option maxHeartbeats 1600000 in
@[expose] public def p0 : Equiv.Perm (Fin 2058) where
  toFun := forward0
  invFun := backward0
  left_inv := by apply allLetters; decide +kernel
  right_inv := by apply allLetters; decide +kernel

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2400000 in
public theorem p0_eq : p0 = embedding 1 (localGenerator 1 0) := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

