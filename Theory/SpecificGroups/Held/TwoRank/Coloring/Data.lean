module

public import Theory.SpecificGroups.Held.TwoRank.Extension

/-!
# Finite data for the Held Sylow-extension coloring

The sixty-four rows cover the elements of square one among the 2048 actual
binary words. Repetition pads each row to twelve positions. `position` points
to a word's row and slot; for the remaining words, `squareWitness` records a
point moved by the square. These are proposed data, with all coverage and
noncommutation claims checked separately. The cached outside action is also
checked against the actual normalizer element before use.

Source: the degree-2058 ATLAS Held action; regenerate with `Source/generate.py`.
-/

@[expose] public section
namespace Held.TwoRank.Coloring

def outsideAction (x : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * x.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

def classIndex (c : Fin 64) (i : Fin 12) : Fin 2048 :=
  ⟨( >>> (11 * (12 * c.val + i.val))) % 2048,
    Nat.mod_lt _ (by decide)⟩

def position (n : Fin 2048) : Fin 64 × Fin 12 :=
  let v := ( >>> (10 * n.val)) % 1024
  (⟨v % 64, Nat.mod_lt _ (by decide)⟩, ⟨v / 64 % 12, Nat.mod_lt _ (by decide)⟩)

def squareWitness (n : Fin 2048) : Fin 2058 :=
  ⟨( >>> (2 * n.val)) % 4, by omega⟩

end Held.TwoRank.Coloring
