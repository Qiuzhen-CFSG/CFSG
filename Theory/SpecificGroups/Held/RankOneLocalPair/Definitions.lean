module

public import Theory.SpecificGroups.Held.Model.Basic
public import Theory.GroupTheory.SolvableOuterQuotient
public import Theory.PGroupCore
public import Mathlib.LinearAlgebra.Matrix.ProjectiveSpecialLinearGroup
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.GroupTheory.Sylow
public import Mathlib.Order.Atoms

/-!
# The Held local-pair construction contracts

The first Sylow overgroup is maximal, has order 21504 or 43008, and has a
normal PSL₃(2) in its intrinsic two-core quotient. The second is solvable
and has order divisible by nine. These are literal subgroup and quotient
conditions, with no E-generation assumption.

The two construction contracts concern subgroups of the actual Aut(He)
containing Inn(He), generated by Inn(He) and their specified Sylow group.
This retains possible outer extensions without assuming an ambient model
isomorphism. Neither construction contract is asserted here.

Source: Aschbacher--Smith E.1.14(4), refs/quasithin.pdf, printed p.214;
ATLAS HeG1-max5W1, Hed2G1-max4W1, and Hed2G1-max8W1.
-/

@[expose] public section

namespace Held.RankOneLocalPair
open Subgroup

/-- The literal two-core quotient contains a normal PSL₃(2), with two-group quotient.
The normality witness supplies the group structure on the second quotient. -/
def HasPSL3TwoCoreQuotient (H : Type*) [Group H] : Prop :=
  ∃ (J : Subgroup (H ⧸ pCore 2 H)) (hJ : J.Normal),
    let := hJ
    Nonempty (J ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) ∧
      IsPGroup 2 ((H ⧸ pCore 2 H) ⧸ J)

/-- The exact local pair needed for the Held branch; it assumes no E-generation bound. -/
structure IsLocalPair {G : Type*} [Group G] (T P B : Subgroup G) : Prop where
  maximal : IsCoatom P
  card : Nat.card P = 21504 ∨ Nat.card P = 43008
  sylow_le_first : T ≤ P
  sylow_le_second : T ≤ B
  nine_dvd : 9 ∣ Nat.card B
  solvable : Group.IsSolvable B
  quotient : HasPSL3TwoCoreQuotient P

/-- The maximal-subgroup calculation required in every actual inner overgroup.
This is a contract for a separate concrete construction, not a proved model fact. -/
def MaximalOvergroups : Prop :=
  ∀ (A : Subgroup (MulAut He)), MulAut.innerSubgroup He ≤ A →
    ∀ (S : Sylow 2 A), (MulAut.innerSubgroup He).subgroupOf A ⊔ (S : Subgroup A) = ⊤ →
      ∃ P : Subgroup A, IsCoatom P ∧ (Nat.card P = 21504 ∨ Nat.card P = 43008) ∧
        (S : Subgroup A) ≤ P ∧ HasPSL3TwoCoreQuotient P

/-- The independent solvable Sylow-overgroup calculation in the same actual groups.
Its witnesses need not use the same conjugator as the maximal-subgroup construction. -/
def SolvableOvergroups : Prop :=
  ∀ (A : Subgroup (MulAut He)), MulAut.innerSubgroup He ≤ A →
    ∀ (S : Sylow 2 A), (MulAut.innerSubgroup He).subgroupOf A ⊔ (S : Subgroup A) = ⊤ →
      ∃ B : Subgroup A, (S : Subgroup A) ≤ B ∧ 9 ∣ Nat.card B ∧ Group.IsSolvable B

end Held.RankOneLocalPair
