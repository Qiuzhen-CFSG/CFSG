module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.SylowOvergroups.RepresentativeChecks.Actions
public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Tables2
public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Tables0

/-!
# Evaluating the max5 cover equations

Signed ATLAS words act by the already certified packed generator tables.
The two additional tables encode the fixed alignment conjugator; their
certificates are in `Conjugator`. `rowCheck` compares the four point images
needed by `Held.eq_of_four_point_images`. Its soundness for the actual cover
words is proved in `Evaluation`.

Source: ATLAS HeG1-p2058B0 and HeG1-max5W1, with the inverted left-action
convention in Held/Model/Source/README.md. The supplied candidate words are
in ../source/cover.json; generated data have no independent authority.
-/

open Held Held.TwoLocalCandidates
open Held.LocalPairs.PairCoverage.SylowOvergroups
open Held.LocalPairs.PairCoverage.SylowOvergroups.RepresentativeVerification


set_option Elab.async false

@[expose] public section
namespace Held.RankOneLocalPair.ConcreteMaximality.CoverCertificate

def inverseWordAction {α : Type*} (x xi y yi : α → α) : List (Bool × ℤ) → α → α
  | [], t => t
  | (b, Int.ofNat n) :: w, t =>
      inverseWordAction x xi y yi w ((if b then yi else xi)^[n] t)
  | (b, Int.negSucc n) :: w, t =>
      inverseWordAction x xi y yi w ((if b then y else x)^[n+1] t)

theorem inverseWordAction_eq {α : Type*} (x y : Equiv.Perm α)
    (w : List (Bool × ℤ)) (t : α) :
    inverseWordAction x (x⁻¹ : Equiv.Perm α) y (y⁻¹ : Equiv.Perm α) w t =
      (wordEval x y w)⁻¹ t := by
  induction w generalizing t with
  | nil => rfl
  | cons v w ih =>
    rcases v with ⟨b,n⟩
    cases b <;> cases n <;>
      simp only [inverseWordAction, wordEval, Bool.false_eq_true, if_false, if_true,
        Int.ofNat_eq_natCast, zpow_natCast, zpow_negSucc, mul_inv_rev,
        ← inv_pow, inv_inv, Equiv.Perm.mul_apply, Equiv.Perm.coe_pow, ih]

def firstConjugatorWord : List (Bool × ℤ) :=
    [(true, 1), (false, 1), (true, -2), (false, 1), (true, -4), (false, 1),
      (true, -1), (false, -1), (true, -1), (false, -1), (true, 1)]
def secondConjugatorWord : List (Bool × ℤ) :=
    [(false, 1), (true, 1), (false, 1), (true, 1), (false, 1),
    (true, 2), (false, 1), (true, 1), (false, -1), (true, 1), (false, -1),
    (true, 1), (false, -1), (true, -1), (false, -1), (true, -2)]

def conjugatorAction (t : Fin 2058) : Fin 2058 :=
  wordAction fastA (fastA⁻¹ : Equiv.Perm _) Cores.Tables0.p1
    (Cores.Tables0.p1⁻¹ : Equiv.Perm _) firstConjugatorWord
    (wordAction fastA (fastA⁻¹ : Equiv.Perm _) fastB
      (fastB⁻¹ : Equiv.Perm _) secondConjugatorWord t)

def conjugatorInverseAction (t : Fin 2058) : Fin 2058 :=
  inverseWordAction fastA (fastA⁻¹ : Equiv.Perm _) fastB
    (fastB⁻¹ : Equiv.Perm _) secondConjugatorWord
    (inverseWordAction fastA (fastA⁻¹ : Equiv.Perm _) Cores.Tables0.p1
      (Cores.Tables0.p1⁻¹ : Equiv.Perm _) firstConjugatorWord t)

/-- A candidate lookup table; its agreement with the literal word is proved below. -/
def conjugatorTable : Fin 2058 → Fin 2058 := packedAction 

def conjugatorInverseTable : Fin 2058 → Fin 2058 := packedAction 

def rawLeft (rw : List (Bool × ℤ)) (hw : List Bool) (sw : List (Bool × ℤ))
    (t : Fin 2058) : Fin 2058 :=
  conjugatorInverseTable (wordAction (packedAction packA) (packedAction packA)
    (packedAction packB) (packedAction packBi) rw (conjugatorTable
      (hw.foldl (fun t b => if b then Cores.Tables2.backward1 t else
        Cores.Tables2.backward0 t)
        (inverseWordAction fastA (fastA⁻¹ : Equiv.Perm _) fastB
          (fastB⁻¹ : Equiv.Perm _) sw t))))

def rawCheck (rw : List (Bool × ℤ)) (hw : List Bool) (sw : List (Bool × ℤ)) : Bool :=
  (List.range 4).all fun i =>
    let p : Fin 2058 := ⟨i % 2058, Nat.mod_lt _ (by decide)⟩
    rawLeft rw hw sw (Cores.Tables2.forward2 p) == Cores.Tables2.forward2 (rawLeft rw hw sw p)


/-- The literal words consumed by one computation. -/
abbrev Row := List (Bool × ℤ) × List Bool × List (Bool × ℤ)

def rowCheck (r : Row) : Bool := rawCheck r.1 r.2.1 r.2.2

end Held.RankOneLocalPair.ConcreteMaximality.CoverCertificate
