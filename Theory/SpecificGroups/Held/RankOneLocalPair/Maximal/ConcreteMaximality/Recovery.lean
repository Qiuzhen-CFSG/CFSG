set_option maxRecDepth 10000 in
private theorem checked : ∀ i : Fin 33, ∀ j : Fin 4,
    eval (fastGenerators i.succ) (candidates i) ⟨j.val, by omega⟩ =
      fastB ⟨j.val, by omega⟩ := by
  decide +kernel

/-- Every fixed outside representative, adjoined to max5, recovers Held.b. -/
public theorem recoveryChecks : RecoveryChecks := by
  intro i
  apply recovery_of_word _ (candidates i)
  apply Held.eq_of_four_point_images
  rw [map_eval, ← fastGenerators_eq]
  change ∀ j : Fin 4, eval (fastGenerators i.succ) (candidates i)
    ⟨j.val, by omega⟩ = atlasB ⟨j.val, by omega⟩
  rw [← fastB_eq]
  exact checked i

end Held.RankOneLocalPair.ConcreteMaximality
