module

public import Theory.SpecificGroups.Held.RankOneLocalPair.Maximal.ConcreteMaximality.Data
public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Tables2

/-!
# Recovering Held's standard generator from each max5 representative

For each of the 33 nonidentity representatives fixed in `Data`, an explicit
signed word in `max5First`, `max5Second`, and that representative equals `b`.
The equations are checked on the proved four-point base, using the certified
permutation tables. Subgroup closure then gives `RecoveryChecks`, the recovery
premise of `ConcreteMaximality.max5_isCoatom_of_checks`.

The discovery words use ATLAS HeG1-max5W1 and HeG1-p2058B0. Inverting the
source right-action permutations gives Lean's left action with unchanged word
order. The complete words and generator are retained in `Recovery/source`;
GAP and Python supply no trusted assertion. Source context: the maximal local
in Aschbacher–Smith E.1.14(4), printed p.214. The independent double-coset
cover is left to the absolute-maximality assembly.
-/

open Held Held.TwoLocalCandidates
open Held.LocalPairs.PairCoverage.SylowOvergroups
open Held.LocalPairs.PairCoverage.SylowOvergroups.RepresentativeVerification
namespace Held.RankOneLocalPair.ConcreteMaximality

private def eval {G : Type*} [Group G] (gs : Fin 3 → G) (w : List (Fin 3 × ℤ)) : G :=
  (w.map fun s => gs s.1 ^ s.2).prod

private theorem map_eval {G H : Type*} [Group G] [Group H] (f : G →* H)
    (gs : Fin 3 → G) (w : List (Fin 3 × ℤ)) :
    f (eval gs w) = eval (fun j => f (gs j)) w := by
  simp only [eval, map_list_prod, List.map_map, Function.comp_def, map_zpow]

private def generators (i : Fin 34) : Fin 3 → He :=
  ![max5First, max5Second, shortRepresentative i]

private def fastGenerators (i : Fin 34) : Fin 3 → Equiv.Perm (Fin 2058) :=
  ![Cores.Tables2.p0, Cores.Tables2.p1, wordEval fastA fastB (shortWord i)]

private theorem fastGenerators_eq (i : Fin 34) :
    fastGenerators i = fun j => representation (generators i j) := by
  funext j
  fin_cases j
  · exact Cores.Tables2.p0_eq
  · exact Cores.Tables2.p1_eq
  · change wordEval fastA fastB (shortWord i) =
      representation (wordEval a b (shortWord i))
    rw [map_wordEval, fastA_eq, fastB_eq]
    rfl

private theorem eval_mem {G : Type*} [Group G] (K : Subgroup G)
    (gs : Fin 3 → G) (hgs : ∀ j, gs j ∈ K) (w : List (Fin 3 × ℤ)) :
    eval gs w ∈ K := by
  apply K.list_prod_mem
  intro x hx
  obtain ⟨⟨j, n⟩, _, rfl⟩ := List.mem_map.mp hx
  exact K.zpow_mem (hgs j) n

private theorem recovery_of_word (i : Fin 34) (w : List (Fin 3 × ℤ))
    (h : eval (generators i) w = b) :
    b ∈ Subgroup.closure (insert (shortRepresentative i) (max5 : Set He)) := by
  rw [← h]
  apply eval_mem
  intro j
  apply Subgroup.subset_closure
  fin_cases j
  · exact Set.mem_insert_of_mem _ max5First_mem
  · exact Set.mem_insert_of_mem _ max5Second_mem
  · exact Set.mem_insert _ _

