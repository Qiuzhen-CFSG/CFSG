/-- Candidate representative index for an old cover row. -/
def coverIndex (j : Fin 4831) : Fin 34 := (CandidateData.coverRow j).1

/-- A positive word in the two literal max5 generators. -/
def rightWord (j : Fin 4831) : List Bool := (CandidateData.coverRow j).2

def rightFactor (j : Fin 4831) : He :=
  ((rightWord j).map fun i => if i then max5Second else max5First).prod

/-- The forced left factor in the proposed double-coset equation. -/
def leftFactor (j : Fin 4831) : He :=
  transport (representative j) * (rightFactor j)⁻¹ *
    (shortRepresentative (coverIndex j))⁻¹

/-- The 4,831 literal centralizer-membership equations still to be checked. -/
def CoverChecks : Prop :=
  ∀ j : Fin 4831, leftFactor j * max5First ^ 4 = max5First ^ 4 * leftFactor j

/-- The 33 literal outside representatives must each recover the generator b. -/
def RecoveryChecks : Prop :=
  ∀ i : Fin 33, b ∈ Subgroup.closure
    (insert (shortRepresentative i.succ) (max5 : Set He))

end Held.RankOneLocalPair.ConcreteMaximality
