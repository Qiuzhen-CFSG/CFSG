module

public import Theory.SpecificGroups.Held.AutomorphismLocalPair.Definitions
public import Theory.SpecificGroups.Held.LocalPairs.SylowGeometry.Calculations
public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Max5Centralizer
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.AmbientIdentities.Max5Upper
public import Theory.Quasithin.EvenCharacteristic

/-!
# The first canonical Held local and the literal seed for the second

The center of the fixed four-generator Sylow subgroup has order two and is
generated by the catalogue's checked central word. Its centralizer is the
published conjugate of ATLAS max5. The proved normal, self-centralizing max5
two-subgroup therefore gives characteristic two for the first local, and
Sylow conjugacy gives the assertion for every Held Sylow.

For the second local we publish the literal join of catalogue rows 20 and 21.
Identifying this join with `largeSeed representative`, and certifying its
normalizer's core and generation, are separate finite calculations.
Source: GLS3 Table 5.3p; Aschbacher--Smith, printed p.526.
-/

@[expose] public section

namespace Held.AutomorphismLocalPair
open Subgroup LocalPairs.SylowGeometry.Calculations
open TwoLocalCandidates TwoLocalCandidates.MaximalNormalizerCatalogue

/-- The actual verified Sylow subgroup with the four published word generators. -/
noncomputable def representativeSylow : Sylow 2 He :=
  Classical.choose (exists_representative_sylow representative_isPGroup
    InnerNormalizer.normalizer_eq)

theorem representativeSylow_coe : (representativeSylow : Subgroup He) = representative :=
  Classical.choose_spec (exists_representative_sylow representative_isPGroup
    InnerNormalizer.normalizer_eq)

theorem exists_conjugate_representative (T : Sylow 2 He) :
    ∃ g : He, representative.map (MulAut.conj g).toMonoidHom = (T : Subgroup He) := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq He representativeSylow T
  refine ⟨g, ?_⟩
  have h := congrArg (fun U : Sylow 2 He => (U : Subgroup He)) hg
  change (representativeSylow : Subgroup He).map (MulAut.conj g).toMonoidHom = _ at h
  rwa [representativeSylow_coe] at h

/-- The literal subgroup generated by the two final rows of the catalogue. -/
def representativeLargeSeed : Subgroup He := ambient 20 ⊔ ambient 21

theorem representativeLargeSeed_le : representativeLargeSeed ≤ representative :=
  sup_le (ambient_le_representative 20) (ambient_le_representative 21)

/-- Its actual normalizer in the original Held carrier. -/
def representativeLargeLocal : Subgroup He := normalizer (representativeLargeSeed : Set He)

theorem representativeLargeSeed_isPGroup : IsPGroup 2 representativeLargeSeed :=
  representative_isPGroup.to_le representativeLargeSeed_le

/-- The intrinsic version of the explicit order-256 candidate, without an order claim. -/
def representativeLargeKernel : Subgroup representativeLargeLocal :=
  representativeLargeSeed.subgroupOf representativeLargeLocal

instance representativeLargeKernel_normal : representativeLargeKernel.Normal :=
  (normal_subgroupOf_iff_le_normalizer representativeLargeSeed.le_normalizer).mpr le_rfl

theorem representativeLargeKernel_isPGroup : IsPGroup 2 representativeLargeKernel :=
  representativeLargeSeed_isPGroup.comap_subtype

theorem representativeLargeKernel_le_pCore :
    representativeLargeKernel ≤ pCore 2 representativeLargeLocal :=
  le_sSup ⟨inferInstance, representativeLargeKernel_isPGroup⟩

theorem representativeLargeKernel_map :
    representativeLargeKernel.map representativeLargeLocal.subtype = representativeLargeSeed :=
  map_subgroupOf_eq_of_le representativeLargeSeed.le_normalizer

/-- The exact conjugation action of the normalizer on the word-defined seed. -/
def representativeLargeAction : representativeLargeLocal →* MulAut representativeLargeSeed :=
  representativeLargeSeed.normalizerMonoidHom

/-- The actual quotient map for the subsequent structure calculation. -/
def representativeLargeProjection : representativeLargeLocal →*
    representativeLargeLocal ⧸ representativeLargeKernel :=
  QuotientGroup.mk' representativeLargeKernel

theorem representativeLargeProjection_ker :
    representativeLargeProjection.ker = representativeLargeKernel := QuotientGroup.ker_mk' _

theorem representative_centerSeed : centerSeed representative = zpowers centralWord := by
  have hz : centralWord ∈ centerSeed representative := by
    apply (mem_centerSeed _ _).mpr
    refine ⟨(word commonWord).property, ?_⟩
    intro y hy
    exact mem_centralizer_singleton_iff.mp (representative_le_centralizer_centralWord hy)
  apply (eq_of_le_of_card_ge (zpowers_le.mpr hz) ?_).symm
  rw [centerSeed, card_map_of_injective representative.subtype_injective,
    representative_center_card_of_centralizer_bound representative_isPGroup
      representative_fullCentralizer_card_le_two,
    Nat.card_zpowers, centralWord_order]

/-- Exact identification of the first canonical local with the verified max5 conjugate. -/
theorem representative_centerLocal :
    centerLocal representative = max5.map (MulAut.conj (conjugator 0)).toMonoidHom := by
  have hcenter : centerLocal representative = centralizer ({centralWord} : Set He) := by
    rw [centerLocal, representative_centerSeed, zpowers_eq_closure, centralizer_closure]
  rw [hcenter]
  apply le_antisymm (centralWord_centralizer_le representative_isPGroup)
  rintro _ ⟨x, hx, rfl⟩
  apply mem_centralizer_singleton_iff.mpr
  have hc := mem_centralizer_singleton_iff.mp (CentralInvolutionBounds.max5_le_centralizer hx)
  have hm := congrArg (MulAut.conj (conjugator 0)) hc
  simpa only [map_mul, conjugator_zero_max5First_four, MulEquiv.coe_toMonoidHom] using hm

theorem max5_selfCentralizingCore :
    centralizer (pCore 2 max5 : Set max5) ≤ pCore 2 max5 := by
  have hle : Cores.core 2 ≤ pCore 2 (subgroup 2) :=
    le_sSup ⟨Cores.core_normal 2, Cores.core_isPGroup 2⟩
  exact (centralizer_le hle).trans (Cores.max5_selfCentralizing.trans hle)

theorem representative_centerLocal_selfCentralizingCore :
    centralizer (pCore 2 (centerLocal representative) : Set (centerLocal representative)) ≤
      pCore 2 (centerLocal representative) := by
  rw [representative_centerLocal]
  exact (Theory.Quasithin.centralizer_pCore_map_le_iff 2
    (MulAut.conj (conjugator 0)) max5).mpr max5_selfCentralizingCore

/-- No automorphism realization, simplicity, or ambient Held order is needed. -/
theorem centerLocal_selfCentralizingCore (T : Sylow 2 He) :
    centralizer (pCore 2 (centerLocal T) : Set (centerLocal T)) ≤
      pCore 2 (centerLocal T) := by
  obtain ⟨g, hg⟩ := exists_conjugate_representative T
  rw [← hg, centerLocal_map]
  exact (Theory.Quasithin.centralizer_pCore_map_le_iff 2
    (MulAut.conj g) (centerLocal representative)).mpr
      representative_centerLocal_selfCentralizingCore

end Held.AutomorphismLocalPair
