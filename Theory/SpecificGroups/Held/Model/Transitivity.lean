private theorem predecessor_decreases : ∀ x : Fin 2058,
    x = 0 ∨ distance (predecessor x) < distance x := by
  decide +kernel

/-- Every letter is reached from zero by an element of the concrete group. -/
public theorem exists_move_zero (x : Fin 2058) : ∃ g : He, representation g 0 = x := by
  suffices h : ∀ n : ℕ, ∀ y : Fin 2058, distance y = n →
      ∃ g : He, representation g 0 = y from h (distance x) x rfl
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro y hy
    rcases predecessor_decreases y with hzero | hlt
    · exact ⟨1, by simpa using hzero.symm⟩
    · obtain ⟨g, hg⟩ := ih (distance (predecessor y)) (by omega) (predecessor y) rfl
      by_cases ha : useA y = true
      · refine ⟨a * g, ?_⟩
        rw [map_mul, Equiv.Perm.mul_apply, hg]
        change atlasA (predecessor y) = y
        simp [predecessor, ha]
      · refine ⟨b * g, ?_⟩
        rw [map_mul, Equiv.Perm.mul_apply, hg]
        change atlasB (predecessor y) = y
        simp [predecessor, ha]

end Transitivity

/-- The faithful defining action of Held is transitive. -/
public instance : MulAction.IsPretransitive He (Fin 2058) :=
  (MulAction.isPretransitive_iff_base (G := He) (0 : Fin 2058)).mpr
    Transitivity.exists_move_zero

end Held
