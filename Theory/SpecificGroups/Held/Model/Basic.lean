module

public import Theory.SpecificGroups.Held.Model.Relations
public import Mathlib.Algebra.Group.Subgroup.Map

/-!
# The concrete Held permutation group

The carrier is the subgroup generated by the two explicitly given permutations
in the ATLAS degree-2058 representation `HeG1-p2058B0`. It inherits its group
structure and finiteness from the symmetric group. The generator orders and
all seven relations were checked against the tables in `Relations`.

Source: https://brauer.maths.qmul.ac.uk/Atlas/v3/permrep/HeG1-p2058B0 .
This construction uses neither classification nor recognition from an order.
-/

namespace Held

/-- The subgroup generated by the exact ATLAS degree-2058 permutations. -/
@[expose] public def permutationGroup : Subgroup (Equiv.Perm (Fin 2058)) :=
  Subgroup.closure {atlasA, atlasB}

/-- The concrete Held carrier, for statements such as `Nonempty (G ≃* Held.He)`. -/
public abbrev He : Type := ↥permutationGroup

/-- The first distinguished generator as an element of the model. -/
@[expose] public def a : He :=
  ⟨atlasA, Subgroup.subset_closure (Set.mem_insert _ _)⟩

/-- The second distinguished generator as an element of the model. -/
@[expose] public def b : He :=
  ⟨atlasB, Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)⟩

/-- The faithful defining permutation representation. -/
@[expose] public def representation : He →* Equiv.Perm (Fin 2058) :=
  permutationGroup.subtype

public theorem representation_injective : Function.Injective representation :=
  Subtype.val_injective

/-- The two distinguished elements generate the whole concrete group. -/
public theorem closure_pair : Subgroup.closure ({a, b} : Set He) = ⊤ := by
  apply Subgroup.map_injective representation_injective
  rw [MonoidHom.map_closure]
  simp only [Set.image_insert_eq, Set.image_singleton]
  change permutationGroup = (⊤ : Subgroup He).map permutationGroup.subtype
  rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]

public theorem relations (i : Fin 7) : relationWord a b i = 1 := by
  apply representation_injective
  rw [map_relationWord, map_one]
  exact atlas_relations i

public theorem a_sq : a ^ 2 = 1 := relations 0

public theorem b_pow_seven : b ^ 7 = 1 := relations 1

public theorem ab_pow_seventeen : (a * b) ^ 17 = 1 := relations 2

public theorem a_ne_one : a ≠ 1 :=
  fun h => atlasA_ne_one (congrArg representation h)

public instance : Nontrivial He := ⟨⟨a, 1, a_ne_one⟩⟩

public theorem orderOf_a : orderOf a = 2 := by
  rw [← orderOf_injective representation representation_injective]
  exact orderOf_atlasA

public theorem orderOf_b : orderOf b = 7 := by
  rw [← orderOf_injective representation representation_injective]
  exact orderOf_atlasB

public theorem orderOf_ab : orderOf (a * b) = 17 := by
  rw [← orderOf_injective representation representation_injective]
  exact orderOf_atlasAB

end Held
