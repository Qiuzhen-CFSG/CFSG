module

public import Theory.SpecificGroups.Held.LocalPairs.SylowGeometry.Calculations.InnerNormalizer.GraphBound.Basic
public import Mathlib.GroupTheory.Perm.Cycle.Type

/-!
# The explicit odd representative graph symmetry

The permutation is exactly the candidate in `InnerNormalizer/Source/odd.json`, published
with the representative color data. No identification with
a full normalizer is used. Two reversing involutions certify its sign from their
fixed-point counts; every permutation identity is checked by the kernel.
-/

namespace Held.LocalPairs.SylowGeometry.Calculations.InnerNormalizer.GraphBound
open Held.NormalizerGraph Held.NormalizerGraph.CardBound

@[expose] public def oddMap (x : Fin 2058) : Fin 2058 :=
  ⟨(( >>> (12*x.val)) % 4096) % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def oddInv (x : Fin 2058) : Fin 2058 :=
  ⟨(( >>> (12*x.val)) % 4096) % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def reverse0 (x : Fin 2058) : Fin 2058 :=
  ⟨(( >>> (12*x.val)) % 4096) % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def reverse1 (x : Fin 2058) : Fin 2058 :=
  ⟨(( >>> (12*x.val)) % 4096) % 2058, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
private theorem inverse_checks : ∀ x, oddInv (oddMap x) = x ∧ oddMap (oddInv x) = x := by
  apply checked_forall
  decide +kernel

@[expose] public def oddPermutation : Equiv.Perm (Fin 2058) where
  toFun := oddMap
  invFun := oddInv
  left_inv x := by exact (inverse_checks x).1
  right_inv x := by exact (inverse_checks x).2

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
private theorem involution0_check : ∀ x, reverse0 (reverse0 x) = x := by
  apply checked_forall
  decide +kernel

private def involution0 : Equiv.Perm (Fin 2058) where
  toFun := reverse0
  invFun := reverse0
  left_inv := involution0_check
  right_inv := involution0_check

private theorem square0 : involution0 ^ 2 = 1 := by
  apply Equiv.ext
  intro x
  exact involution0_check x

private theorem fixed0 : Fintype.card (Function.fixedPoints involution0) = 2 := by
  rw [Fintype.card_subtype, ← List.toFinset_finRange 2058,
    (List.nodup_finRange 2058).card_eq_countP]
  set_option maxRecDepth 16384 in
  set_option maxHeartbeats 8000000 in
  decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
private theorem involution1_check : ∀ x, reverse1 (reverse1 x) = x := by
  apply checked_forall
  decide +kernel

private def involution1 : Equiv.Perm (Fin 2058) where
  toFun := reverse1
  invFun := reverse1
  left_inv := involution1_check
  right_inv := involution1_check

private theorem square1 : involution1 ^ 2 = 1 := by
  apply Equiv.ext
  intro x
  exact involution1_check x

private theorem fixed1 : Fintype.card (Function.fixedPoints involution1) = 264 := by
  rw [Fintype.card_subtype, ← List.toFinset_finRange 2058,
    (List.nodup_finRange 2058).card_eq_countP]
  set_option maxRecDepth 16384 in
  set_option maxHeartbeats 8000000 in
  decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
private theorem odd_factorization : oddPermutation = involution0 * involution1 := by
  have h : ∀ x, oddMap x = reverse0 (reverse1 x) := by
    apply checked_forall
    decide +kernel
  exact Equiv.ext h

public theorem odd_sign : Equiv.Perm.sign oddPermutation = -1 := by
  rw [odd_factorization, map_mul, Equiv.Perm.sign_of_pow_two_eq_one square0,
    Equiv.Perm.sign_of_pow_two_eq_one square1, fixed0, fixed1]
  decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
public theorem odd_colors : ∀ x, orbitSizeLabel (oddPermutation x) = orbitSizeLabel x := by
  apply checked_forall
  decide +kernel

end Held.LocalPairs.SylowGeometry.Calculations.InnerNormalizer.GraphBound
