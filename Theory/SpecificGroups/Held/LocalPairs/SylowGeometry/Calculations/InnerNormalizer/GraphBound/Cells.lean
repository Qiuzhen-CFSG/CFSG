    decide +kernel
  have hback : ∀ x : Fin 2058, w3 x.val = 58566 → x ∈ c3_4Points := by
    apply checked_forall
    decide +kernel
  intro x
  change x ∈ c3_4Points ↔ w3 x.val = 58566
  exact ⟨fun hx => of_decide_eq_true (List.all_eq_true.mp hall x hx), hback x⟩

