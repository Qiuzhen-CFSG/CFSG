module

public import Theory.SpecificGroups.Held.Automorphisms.Normalizer.GraphData
public import Mathlib.GroupTheory.Perm.Sign
public import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# Candidate orbit-size coloring for the Held representative

The labels are computed from the four literal words published in
`Calculations/Representative`. They are candidate data: this module does not
assert that they equal orbit cardinalities. `Source/generate_data.py` reproduces
the table from the unchanged ATLAS permutations; `Source/orbits.json` retains
the zero-based candidate orbits.

The associated groups preserve the existing Held graph and this coloring.
Their definitions make no order claim. A separate finite graph certificate
and the actual orbit-cardinality identification are needed by the normalizer
argument. Source context: GLS3 Table 5.3p and ATLAS HeG1-p2058B0.
-/

namespace Held.LocalPairs.SylowGeometry.Calculations.InnerNormalizer

/-- Candidate orbit cardinalities, packed into ten-bit fields. -/
@[expose] public def orbitSizeLabel (x : Fin 2058) : ℕ :=
  ( >>> (10 * x.val)) % 1024

/-- All permutations preserving the candidate orbit-size coloring. -/
@[expose] public def colorPreservingGroup : Subgroup (Equiv.Perm (Fin 2058)) where
  carrier := {σ | ∀ x, orbitSizeLabel (σ x) = orbitSizeLabel x}
  one_mem' := by intro x; rfl
  mul_mem' := by
    intro σ τ hσ hτ x
    exact (hσ (τ x)).trans (hτ x)
  inv_mem' := by
    intro σ hσ x
    change orbitSizeLabel (σ.symm x) = orbitSizeLabel x
    simpa only [Equiv.apply_symm_apply] using (hσ (σ.symm x)).symm

/-- Graph symmetries that also preserve the candidate orbit-size coloring. -/
@[expose] public def coloredGraphGroup : Subgroup (Equiv.Perm (Fin 2058)) :=
  Held.NormalizerGraph.preservingGroup ⊓ colorPreservingGroup

/-- The even permutations in the colored graph group. -/
@[expose] public def evenColoredGraphGroup : Subgroup (Equiv.Perm (Fin 2058)) :=
  coloredGraphGroup ⊓ Equiv.Perm.sign.ker

end Held.LocalPairs.SylowGeometry.Calculations.InnerNormalizer
