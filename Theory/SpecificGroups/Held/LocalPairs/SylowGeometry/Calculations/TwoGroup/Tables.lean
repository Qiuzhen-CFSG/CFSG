/-- Checked lookup permutation of each short word. -/
@[expose] public def pcTable : Fin 10 → Equiv.Perm (Fin 2058)
  | 0 => c0
  | 1 => c1
  | 2 => c2
  | 3 => c3
  | 4 => c4
  | 5 => c5
  | 6 => c6
  | 7 => c7
  | 8 => c8
  | 9 => c9

public theorem pcTable_eq (i : Fin 10) : pcTable i = representation (pcGenerator i) := by
  fin_cases i
  · exact c0_eq
  · exact c1_eq
  · exact c2_eq
  · exact c3_eq
  · exact c4_eq
  · exact c5_eq
  · exact c6_eq
  · exact c7_eq
  · exact c8_eq
  · exact c9_eq

