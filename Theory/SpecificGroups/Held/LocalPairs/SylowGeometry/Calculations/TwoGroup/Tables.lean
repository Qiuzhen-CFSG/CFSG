import Mathlib.Tactic.FinCases

/-!
# Checked tables for the Held two-series

Each lookup permutation is checked on all 2058 letters, including both
inverse laws, and proved equal to its literal Held word. The retained
Python generator only proposes tables; the Lean kernel certifies them.
The max3 generator table is reused from the already checked local cores.
Source: ATLAS HeG1-p2058B0, HeG1-max3W1; `TwoGroup/Source/generate.py`.
-/

namespace Held.LocalPairs.SylowGeometry.Calculations.TwoGroup.Tables
open Held.TwoLocalCandidates.Cores

private theorem localTable_eq : Tables0.p1 =
    representation (PairCoverage.localWord false) := Tables0.p1_eq

private theorem representation_evalLocalWord (w : List ℤ) :
    representation (evalLocalWord w) =
      (w.map (fun k => if k.natAbs = 1 then atlasA ^ k else
        Tables0.p1 ^ (if k < 0 then (-1 : ℤ) else 1))).prod := by
  simp only [evalLocalWord, map_list_prod, List.map_map, Function.comp_def,
    apply_ite representation, map_zpow, ← localTable_eq]
  rfl

@[expose] public def g0_forward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def g0_backward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 8192 in
set_option maxHeartbeats 1600000 in
@[expose] public def g0 : Equiv.Perm (Fin 2058) where
  toFun := g0_forward
  invFun := g0_backward
  left_inv := by apply Held.TwoLocalCandidates.Cores.allLetters; decide +kernel
  right_inv := by apply Held.TwoLocalCandidates.Cores.allLetters; decide +kernel

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2400000 in
public theorem g0_eq : g0 = representation (generator 0) := by
  rw [generator, representation_evalLocalWord]
  apply Equiv.ext
  apply allLetters
  decide +kernel

