module

public import Theory.SpecificGroups.Held.LocalPairs.SylowGeometry.ThreePrimeOvergroups.Seed.Tables

/-!
# Certified reachability in each Held seed orbit

Finite certificates for the exact eight Held seed words from `../Source/seed_words.json`.
Sources: ATLAS HeG1-p2058B0; GLS3 Table 5.3p. The external discovery and
generation scripts only propose data; all identities are checked by Lean.
-/

namespace Held.LocalPairs.SylowGeometry.ThreePrimeOvergroups.Seed

open Held.TwoLocalCandidates.Cores

private def wordStep (t : Fin 17) : He :=
  if t.val = 0 then 1 else
  if t.val ≤ 8 then seedGenerator ⟨(t.val-1) % 8, Nat.mod_lt _ (by decide)⟩ else
    (seedGenerator ⟨(t.val-9) % 8, Nat.mod_lt _ (by decide)⟩)⁻¹

private def tableStep (t : Fin 17) : Equiv.Perm (Fin 2058) :=
  if t.val = 0 then 1 else
  if t.val ≤ 8 then seedTable ⟨(t.val-1) % 8, Nat.mod_lt _ (by decide)⟩ else
    (seedTable ⟨(t.val-9) % 8, Nat.mod_lt _ (by decide)⟩)⁻¹

private theorem tableStep_eq (t : Fin 17) : tableStep t = representation (wordStep t) := by
  unfold wordStep tableStep
  split
  · exact (map_one _).symm
  · split
    · exact seedTable_eq _
    · rw [map_inv, seedTable_eq]

private theorem wordStep_mem (t : Fin 17) : wordStep t ∈ seedSubgroup := by
  unfold wordStep
  split
  · exact seedSubgroup.one_mem
  · split
    · exact Subgroup.subset_closure (Set.mem_range_self _)
    · exact seedSubgroup.inv_mem (Subgroup.subset_closure (Set.mem_range_self _))

private def pathWord (x : Fin 2058) : List (Fin 17) :=
  List.ofFn (fun k : Fin 5 =>
    ⟨((( >>> (25 * x.val)) >>> (5 * k.val)) % 32) % 17,
      Nat.mod_lt _ (by decide)⟩)

private def pathElement (x : Fin 2058) : He :=
  ((pathWord x).map wordStep).prod

private theorem pathElement_mem (x : Fin 2058) : pathElement x ∈ seedSubgroup := by
  apply Subgroup.list_prod_mem
  intro y hy
  obtain ⟨t, _, rfl⟩ := List.mem_map.mp hy
  exact wordStep_mem t

private def orbitRepresentative : Fin 24 → Fin 2058 :=
  ![447,11,754,141,215,0,107,209,8,29,45,131,4,14,34,41,72,3,5,10,18,2,6,1]

set_option maxRecDepth 8192 in
private theorem orbitLabel_lt : ∀ x : Fin 2058, orbitLabel x < 24 := by
  apply allLetters
  decide +kernel

private def orbitIndex (x : Fin 2058) : Fin 24 := ⟨orbitLabel x, orbitLabel_lt x⟩

set_option maxRecDepth 8192 in
private theorem reach_table : ∀ x : Fin 2058,
    (((pathWord x).map tableStep).prod) (orbitRepresentative (orbitIndex x)) = x := by
  apply allLetters
  decide +kernel

private theorem reach_action (x : Fin 2058) :
    representation (pathElement x) (orbitRepresentative (orbitIndex x)) = x := by
  simpa only [pathElement, map_list_prod, List.map_map, Function.comp_def,
    ← tableStep_eq] using reach_table x

end Held.LocalPairs.SylowGeometry.ThreePrimeOvergroups.Seed

namespace Held.LocalPairs.SylowGeometry.ThreePrimeOvergroups
open Seed

/-- The seed subgroup acts transitively on each fiber of the published labeling. -/
public theorem seed_orbit_reachability (x y : Fin 2058) (hxy : orbitLabel x = orbitLabel y) :
    ∃ g : seedSubgroup, g • x = y := by
  let wx : seedSubgroup := ⟨pathElement x, pathElement_mem x⟩
  let wy : seedSubgroup := ⟨pathElement y, pathElement_mem y⟩
  refine ⟨wy * wx⁻¹, ?_⟩
  have hidx : orbitIndex x = orbitIndex y := Fin.ext hxy
  have hx : wx • orbitRepresentative (orbitIndex x) = x := reach_action x
  have hy : wy • orbitRepresentative (orbitIndex x) = y := by
    rw [hidx]
    exact reach_action y
  rw [← hx, mul_smul, inv_smul_smul, hy]

end Held.LocalPairs.SylowGeometry.ThreePrimeOvergroups
