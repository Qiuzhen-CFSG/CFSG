/-- All factorizations in the specified consecutive row interval. -/
public theorem block00 (j : Fin 4831) (e : Bool)
    (hlo : 0 ≤ 2 * j.val + e.toNat)
    (hhi : 2 * j.val + e.toNat < 512) :
    Theory.GroupTheory.DoubleCosetTransitions.Covered markedSubgroup representative
      (representative j * middle 1 e * move 1) := by
  by_cases h0 : 2 * j.val + e.toNat < 16
  · exact covered_of_checkRows 0 16 data0 checked0 j e (by omega) h0
  by_cases h1 : 2 * j.val + e.toNat < 32
  · exact covered_of_checkRows 16 16 data1 checked1 j e (by omega) h1
  by_cases h2 : 2 * j.val + e.toNat < 48
