@[expose] public def subgroupWord (i : Fin 1024) : List (Fin 4) :=
  (subgroupWordTexts[i.val]!).toList.map fun c => ⟨(c.toNat - 48) % 4, Nat.mod_lt _ (by decide)⟩

@[expose] public def subgroupElement (i : Fin 1024) : He :=
  ((subgroupWord i).map markedGenerator).prod

/-- Every proposed factor is actually in the marked subgroup. -/
public theorem subgroupElement_mem (i : Fin 1024) : subgroupElement i ∈ markedSubgroup := by
  apply markedSubgroup.list_prod_mem
  intro x hx
  obtain ⟨j, _, rfl⟩ := List.mem_map.mp hx
  exact markedGenerator_mem j

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets
