private theorem block18_eq (j : ℕ) : wordBlock18[j]! = wordList18[j]! := by
  rw [wordBlock18, ← Array.getElem!_toList, Array.toList_map]
  rfl

/-- A list-based evaluation view of exactly the published representative words. -/
@[expose] public def fastRepresentativeWord (i : Fin 4831) : List (Bool × ℤ) :=
  match i.val / 256 with
  | 0 => wordList00[i.val % 256]!
  | 1 => wordList01[i.val % 256]!
  | 2 => wordList02[i.val % 256]!
  | 3 => wordList03[i.val % 256]!
  | 4 => wordList04[i.val % 256]!
  | 5 => wordList05[i.val % 256]!
  | 6 => wordList06[i.val % 256]!
  | 7 => wordList07[i.val % 256]!
  | 8 => wordList08[i.val % 256]!
  | 9 => wordList09[i.val % 256]!
  | 10 => wordList10[i.val % 256]!
  | 11 => wordList11[i.val % 256]!
  | 12 => wordList12[i.val % 256]!
  | 13 => wordList13[i.val % 256]!
  | 14 => wordList14[i.val % 256]!
  | 15 => wordList15[i.val % 256]!
  | 16 => wordList16[i.val % 256]!
  | 17 => wordList17[i.val % 256]!
  | 18 => wordList18[i.val % 256]!
  | _ => []

/-- The evaluation view preserves every word and every index. -/
public theorem representativeWord_eq_fast (i : Fin 4831) :
    representativeWord i = fastRepresentativeWord i := by
  simp only [representativeWord, fastRepresentativeWord,
    block00_eq, block01_eq, block02_eq, block03_eq, block04_eq, block05_eq, block06_eq, block07_eq, block08_eq, block09_eq, block10_eq, block11_eq, block12_eq, block13_eq, block14_eq, block15_eq, block16_eq, block17_eq, block18_eq]
  split <;> simp_all
  rw [Nat.div_eq_of_lt ‹i.val < 256›]
  rfl

public theorem representative_eq_fast (i : Fin 4831) :
    representative i = wordEval a b (fastRepresentativeWord i) := by
  rw [representative, representativeWord_eq_fast]

