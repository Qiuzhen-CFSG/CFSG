/-- Both middle-factor transitions for representative indices in [1792, 2048). -/
public theorem block07 (j : Fin 4831) (lo : 1792 ≤ j.val) (hi : j.val < 2048)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 1792, by omega⟩ e
  have hj : (⟨1792 + (j.val - 1792), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

