/-- Both middle-factor transitions for representative indices in [2816, 3072). -/
public theorem block11 (j : Fin 4831) (lo : 2816 ≤ j.val) (hi : j.val < 3072)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 2816, by omega⟩ e
  have hj : (⟨2816 + (j.val - 2816), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

