/-- Both middle-factor transitions for representative indices in [4096, 4352). -/
public theorem block16 (j : Fin 4831) (lo : 4096 ≤ j.val) (hi : j.val < 4352)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 4096, by omega⟩ e
  have hj : (⟨4096 + (j.val - 4096), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
