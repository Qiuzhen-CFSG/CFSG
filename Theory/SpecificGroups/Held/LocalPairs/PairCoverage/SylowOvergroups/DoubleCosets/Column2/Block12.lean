/-- Both middle-factor transitions for representative indices in [3072, 3328). -/
public theorem block12 (j : Fin 4831) (lo : 3072 ≤ j.val) (hi : j.val < 3328)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 3072, by omega⟩ e
  have hj : (⟨3072 + (j.val - 3072), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

