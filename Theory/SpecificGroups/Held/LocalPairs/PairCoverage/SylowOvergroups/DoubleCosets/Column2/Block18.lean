/-- Both middle-factor transitions for representative indices in [4608, 4831). -/
public theorem block18 (j : Fin 4831) (lo : 4608 ≤ j.val) (_hi : j.val < 4831)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 4608, by omega⟩ e
  have hj : (⟨4608 + (j.val - 4608), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
