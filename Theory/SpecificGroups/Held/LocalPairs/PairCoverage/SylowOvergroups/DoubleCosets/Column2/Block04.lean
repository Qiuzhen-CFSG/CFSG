/-- Both middle-factor transitions for representative indices in [1024, 1280). -/
public theorem block04 (j : Fin 4831) (lo : 1024 ≤ j.val) (hi : j.val < 1280)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 1024, by omega⟩ e
  have hj : (⟨1024 + (j.val - 1024), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
