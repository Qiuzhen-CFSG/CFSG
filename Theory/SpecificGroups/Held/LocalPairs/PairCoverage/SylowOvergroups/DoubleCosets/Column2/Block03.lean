/-- Both middle-factor transitions for representative indices in [768, 1024). -/
public theorem block03 (j : Fin 4831) (lo : 768 ≤ j.val) (hi : j.val < 1024)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 768, by omega⟩ e
  have hj : (⟨768 + (j.val - 768), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
