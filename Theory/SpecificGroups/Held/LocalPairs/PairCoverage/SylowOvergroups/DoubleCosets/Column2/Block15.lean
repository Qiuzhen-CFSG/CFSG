public theorem block15 (j : Fin 4831) (lo : 3840 ≤ j.val) (hi : j.val < 4096)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 3840, by omega⟩ e
  have hj : (⟨3840 + (j.val - 3840), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

