/-- Both middle-factor transitions for representative indices in [256, 512). -/
public theorem block01 (j : Fin 4831) (lo : 256 ≤ j.val) (hi : j.val < 512)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 256, by omega⟩ e
  have hj : (⟨256 + (j.val - 256), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
