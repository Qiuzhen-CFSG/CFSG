public theorem block17 (j : Fin 4831) (lo : 4352 ≤ j.val) (hi : j.val < 4608)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 4352, by omega⟩ e
  have hj : (⟨4352 + (j.val - 4352), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

