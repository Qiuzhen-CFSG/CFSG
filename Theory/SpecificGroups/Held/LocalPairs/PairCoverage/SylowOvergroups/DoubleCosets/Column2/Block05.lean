/-- Both middle-factor transitions for representative indices in [1280, 1536). -/
public theorem block05 (j : Fin 4831) (lo : 1280 ≤ j.val) (hi : j.val < 1536)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 1280, by omega⟩ e
  have hj : (⟨1280 + (j.val - 1280), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
