/-- Both middle-factor transitions for representative indices in [2048, 2304). -/
public theorem block08 (j : Fin 4831) (lo : 2048 ≤ j.val) (hi : j.val < 2304)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 2048, by omega⟩ e
  have hj : (⟨2048 + (j.val - 2048), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
