/-- Both middle-factor transitions for representative indices in [512, 768). -/
public theorem block02 (j : Fin 4831) (lo : 512 ≤ j.val) (hi : j.val < 768)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 512, by omega⟩ e
  have hj : (⟨512 + (j.val - 512), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
