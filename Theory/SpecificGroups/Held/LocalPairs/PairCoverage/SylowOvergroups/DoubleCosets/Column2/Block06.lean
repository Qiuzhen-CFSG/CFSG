/-- Both middle-factor transitions for representative indices in [1536, 1792). -/
public theorem block06 (j : Fin 4831) (lo : 1536 ≤ j.val) (hi : j.val < 1792)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 1536, by omega⟩ e
  have hj : (⟨1536 + (j.val - 1536), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
