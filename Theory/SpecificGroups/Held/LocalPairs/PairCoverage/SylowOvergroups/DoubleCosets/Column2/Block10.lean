/-- Both middle-factor transitions for representative indices in [2560, 2816). -/
public theorem block10 (j : Fin 4831) (lo : 2560 ≤ j.val) (hi : j.val < 2816)
    (e : Bool) :
    Covered markedSubgroup representative (representative j * middle 2 e * move 2) := by
  have h := localBlock ⟨j.val - 2560, by omega⟩ e
  have hj : (⟨2560 + (j.val - 2560), by omega⟩ : Fin 4831) = j := by
    apply Fin.ext
    exact Nat.add_sub_of_le lo
  simpa only [hj] using h

end Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.Column2
