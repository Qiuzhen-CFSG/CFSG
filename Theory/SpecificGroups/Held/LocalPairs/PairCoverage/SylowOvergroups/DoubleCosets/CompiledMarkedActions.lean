    by_cases h1280 : p.val < 1408
    · exact markCheck_sound 3 1280 128 checked_3_1280 p (by omega) h1280
    by_cases h1408 : p.val < 1536
    · exact markCheck_sound 3 1408 128 checked_3_1408 p (by omega) h1408
