    · exact markCheck_sound 0 1024 128 checked_0_1024 p (by omega) h1024
    by_cases h1152 : p.val < 1280
    · exact markCheck_sound 0 1152 128 checked_0_1152 p (by omega) h1152
    by_cases h1280 : p.val < 1408
    · exact markCheck_sound 0 1280 128 checked_0_1280 p (by omega) h1280
