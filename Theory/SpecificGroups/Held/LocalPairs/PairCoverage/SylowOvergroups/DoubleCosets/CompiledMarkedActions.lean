/-!
# Certified marked actions for Held double-coset transitions

Four packed forward functions are checked against the literal marked words
on every one of the 2058 letters. Short positive subgroup words can then use
these functions without repeatedly expanding each marked generator. The
additional 24 point values compile the three fixed moves and their middle
factors only on the four base points where transition checks need them.

The soundness lemmas identify all evaluations with the existing Held carrier;
the four-point group base is used only for actual group elements. Candidate
data come from the existing ATLAS HeG1-p2058B0 tables, the unchanged marking,
and `SylowOvergroups/source/representatives.json` via the source generator.
-/

namespace Held.LocalPairs.PairCoverage.SylowOvergroups.DoubleCosets.CompiledActions
open Held.LocalPairs.PairCoverage.SylowOvergroups.RepresentativeVerification

set_option Elab.async false

/-- The four marked forward functions, without permutation structure overhead. -/
@[expose] public def markTable (i : Fin 4) : Fin 2058 → Fin 2058 :=
  packedAction (match i.val with | 0 =>  | 1 =>  | 2 =>  | _ => )

private def wordMark (i : Fin 4) : Fin 2058 → Fin 2058 :=
  wordAction fastA (fastA⁻¹ : Equiv.Perm _) Held.TwoLocalCandidates.Cores.Tables0.p1
    (Held.TwoLocalCandidates.Cores.Tables0.p1⁻¹ : Equiv.Perm _) (generatorWords i)

private def markCheck (i : Fin 4) (start count : ℕ) : Bool :=
  (List.range count).all fun t =>
    let p : Fin 2058 := ⟨(start + t) % 2058, Nat.mod_lt _ (by decide)⟩
    markTable i p == wordMark i p

private theorem markCheck_sound (i : Fin 4) (start count : ℕ)
    (h : markCheck i start count = true) (p : Fin 2058)
    (hlo : start ≤ p.val) (hhi : p.val < start + count) :
    markTable i p = wordMark i p := by
  have hp := List.all_eq_true.mp h (p.val - start)
    (List.mem_range.mpr (show p.val - start < count by omega))
  have he : (⟨(start + (p.val - start)) % 2058, Nat.mod_lt _ (by decide)⟩ : Fin 2058) = p := by
    apply Fin.ext
    change (start + (p.val - start)) % 2058 = p.val
    omega
  simpa only [he, beq_iff_eq] using hp

