    by_cases h128 : p.val < 256
    · exact markCheck_sound 3 128 128 checked_3_128 p (by omega) h128
    by_cases h256 : p.val < 384
    · exact markCheck_sound 3 256 128 checked_3_256 p (by omega) h256
    by_cases h384 : p.val < 512
