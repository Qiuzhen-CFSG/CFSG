    exact markCheck_sound 3 2048 10 checked_3_2048 p (by omega) p.isLt

/-- Each compiled marked action equals the actual Held representation. -/
public theorem markTable_eq (i : Fin 4) (p : Fin 2058) :
    markTable i p = representation (markedGenerator i) p := by
  rw [markTable_eq_word, wordMark, wordAction_eq, fastA_eq,
    representation_markedGenerator]
  rfl

/-- Evaluation of a positive subgroup word using the compiled marked actions. -/
@[expose] public def subgroupAction (i : Fin 1024) (p : Fin 2058) : Fin 2058 :=
  (subgroupWord i).foldr markTable p

public theorem subgroupAction_eq (i : Fin 1024) (p : Fin 2058) :
    subgroupAction i p = representation (subgroupElement i) p := by
  simp only [subgroupAction, subgroupElement, map_list_prod, List.map_map, Function.comp_def]
  generalize subgroupWord i = w
  induction w with
  | nil => rfl
  | cons i w ih =>
    rw [List.foldr_cons, List.map_cons, List.prod_cons, Equiv.Perm.mul_apply, ih, markTable_eq]

/-- Fixed inputs for the three transition columns at their four base points. -/
@[expose] public def seed (i : Fin 3) (e : Bool) (p : Fin 4) : Fin 2058 :=
  ⟨((217619182600364584519484128970476542235955871579681760328313486808653084332286925557760 >>> (12 * (8 * i.val + 4 * e.toNat + p.val))) % 4096) % 2058,
    Nat.mod_lt _ (by decide)⟩

private def rawMove (i : Fin 3) : Fin 2058 → Fin 2058 :=
  wordAction fastA (fastA⁻¹ : Equiv.Perm _) fastB (fastB⁻¹ : Equiv.Perm _) (moveWord i)

set_option maxRecDepth 16384 in
set_option maxHeartbeats 4000000 in
private theorem seed_checked : ∀ (i : Fin 3) (e : Bool) (p : Fin 4),
    seed i e p = (if e then markTable (toggleIndex i) else id)
      (rawMove i ⟨p.val, by omega⟩) := by
  decide +kernel

/-- The fixed inputs are literal point values of the actual middle/move products. -/
public theorem seed_eq (i : Fin 3) (e : Bool) (p : Fin 4) :
    seed i e p = representation (middle i e * move i) ⟨p.val, by omega⟩ := by
  have hm : ∀ q : Fin 2058, rawMove i q = representation (move i) q := by
    intro q
    rw [rawMove, wordAction_eq, fastA_eq, fastB_eq, representation_move]
    rfl
  rw [seed_checked, hm, map_mul, Equiv.Perm.mul_apply]
  cases e <;> simp only [middle, Bool.false_eq_true, if_false, if_true,
    map_one, Equiv.Perm.one_apply, id_eq, markTable_eq]

