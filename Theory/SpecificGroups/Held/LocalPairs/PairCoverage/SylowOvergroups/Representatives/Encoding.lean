module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.SylowOvergroups.Marking

/-!
# Compact encoding of the fixed candidate words

The eighteen ASCII letters record the exact generator/exponent pairs in
`source/representatives.json`. Ordinary Lean definitions decode the text;
subsequent kernel checks evaluate the original signed words. This is data
compression only and proves no group-theoretic property.

Generated by `source/generate_representatives.py` from the retained GAP data.
-/

namespace Held.LocalPairs.PairCoverage.SylowOvergroups

@[expose] public def decodeLetter : Char → Bool × ℤ
  | 'a' => (Bool.false, Int.negSucc 2)
  | 'b' => (Bool.false, Int.negSucc 1)
  | 'c' => (Bool.false, Int.negSucc 0)
  | 'd' => (Bool.false, Int.ofNat 1)
  | 'e' => (Bool.false, Int.ofNat 2)
  | 'f' => (Bool.false, Int.ofNat 3)
  | 'g' => (Bool.true, Int.negSucc 5)
  | 'h' => (Bool.true, Int.negSucc 4)
  | 'i' => (Bool.true, Int.negSucc 3)
  | 'j' => (Bool.true, Int.negSucc 2)
  | 'k' => (Bool.true, Int.negSucc 1)
  | 'l' => (Bool.true, Int.negSucc 0)
  | 'm' => (Bool.true, Int.ofNat 1)
  | 'n' => (Bool.true, Int.ofNat 2)
  | 'o' => (Bool.true, Int.ofNat 3)
  | 'p' => (Bool.true, Int.ofNat 4)
  | 'q' => (Bool.true, Int.ofNat 5)
  | 'r' => (Bool.true, Int.ofNat 6)
  | _ => (Bool.false, Int.ofNat 0)

@[expose] public def decodeWord (s : String) : List (Bool × ℤ) :=
  s.toList.map decodeLetter

end Held.LocalPairs.PairCoverage.SylowOvergroups
