@[expose] public def representativeText (i : Fin 4831) : String :=
  match i.val / 256 with
  | 0 => textBlock00[i.val % 256]!
  | 1 => textBlock01[i.val % 256]!
  | 2 => textBlock02[i.val % 256]!
  | 3 => textBlock03[i.val % 256]!
  | 4 => textBlock04[i.val % 256]!
  | 5 => textBlock05[i.val % 256]!
  | 6 => textBlock06[i.val % 256]!
  | 7 => textBlock07[i.val % 256]!
  | 8 => textBlock08[i.val % 256]!
  | 9 => textBlock09[i.val % 256]!
  | 10 => textBlock10[i.val % 256]!
  | 11 => textBlock11[i.val % 256]!
  | 12 => textBlock12[i.val % 256]!
  | 13 => textBlock13[i.val % 256]!
  | 14 => textBlock14[i.val % 256]!
  | 15 => textBlock15[i.val % 256]!
  | 16 => textBlock16[i.val % 256]!
  | 17 => textBlock17[i.val % 256]!
  | 18 => textBlock18[i.val % 256]!
  | _ => ""

private theorem mapDecodeWord_getElem! (ss : Array String) (i : ℕ) :
    (ss.map decodeWord)[i]! = decodeWord ss[i]! := by
  simp only [getElem!_def, Array.getElem?_map]
  cases ss[i]? <;> rfl

set_option maxRecDepth 4096 in
/-- Selection before decoding preserves every original signed word. -/
public theorem representativeWord_eq_decodeText (i : Fin 4831) :
    representativeWord i = decodeWord (representativeText i) := by
  unfold representativeWord representativeText
  split <;> simp_all only
  · exact mapDecodeWord_getElem! textBlock00 _
  · exact mapDecodeWord_getElem! textBlock01 _
  · exact mapDecodeWord_getElem! textBlock02 _
  · exact mapDecodeWord_getElem! textBlock03 _
  · exact mapDecodeWord_getElem! textBlock04 _
  · exact mapDecodeWord_getElem! textBlock05 _
  · exact mapDecodeWord_getElem! textBlock06 _
  · exact mapDecodeWord_getElem! textBlock07 _
  · exact mapDecodeWord_getElem! textBlock08 _
  · exact mapDecodeWord_getElem! textBlock09 _
  · exact mapDecodeWord_getElem! textBlock10 _
  · exact mapDecodeWord_getElem! textBlock11 _
  · exact mapDecodeWord_getElem! textBlock12 _
  · exact mapDecodeWord_getElem! textBlock13 _
  · exact mapDecodeWord_getElem! textBlock14 _
  · exact mapDecodeWord_getElem! textBlock15 _
  · exact mapDecodeWord_getElem! textBlock16 _
  · exact mapDecodeWord_getElem! textBlock17 _
  · exact mapDecodeWord_getElem! textBlock18 _
  · rfl

end Held.LocalPairs.PairCoverage.SylowOvergroups.RepresentativeVerification
