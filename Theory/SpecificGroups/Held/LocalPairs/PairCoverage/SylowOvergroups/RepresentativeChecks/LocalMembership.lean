/-- All thirty selected rows belong to their actual aligned local overgroups. -/
public theorem localChecks : LocalChecks := by
  intro j b h
  unfold localBranch at h
  split at h
  · have hj : j = 0 := Fin.ext ‹j.val = 0›
    subst j
    cases Option.some.inj h
    exact representative_zero_mem
  · have hj : j = 1 := Fin.ext ‹j.val = 1›
    subst j
    cases Option.some.inj h
    exact local_mem_0001
  · have hj : j = 2 := Fin.ext ‹j.val = 2›
    subst j
    cases Option.some.inj h
    exact local_mem_0002
