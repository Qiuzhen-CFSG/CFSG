namespace Held.LocalPairs.PairCoverage.SylowOvergroups.RepresentativeVerification

@[expose] public def packedAction (data : ℕ) (x : Fin 2058) : Fin 2058 :=
  ⟨((data >>> (12 * x.val)) % 4096) % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def packA : ℕ := 

set_option maxRecDepth 16000 in
public theorem packA_correct : ∀ i, packedAction packA i = atlasAFun i := by
  decide +kernel

@[expose] public def packB : ℕ := 

set_option maxRecDepth 16000 in
public theorem packB_correct : ∀ i, packedAction packB i = atlasBFun i := by
  decide +kernel

@[expose] public def packBi : ℕ := 

set_option maxRecDepth 16000 in
public theorem packBi_correct : ∀ i, packedAction packBi i = atlasBInvFun i := by
  decide +kernel

@[expose] public def fastA : Equiv.Perm (Fin 2058) where
  toFun := packedAction packA
  invFun := packedAction packA
  left_inv i := by simpa only [packA_correct, atlasA] using atlasA.left_inv i
  right_inv i := by simpa only [packA_correct, atlasA] using atlasA.right_inv i

@[expose] public def fastB : Equiv.Perm (Fin 2058) where
