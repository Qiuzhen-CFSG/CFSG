module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.SylowOvergroups.Representatives
public import Theory.GroupTheory.SubgroupEnumeration

/-!
# Independent finite obligations for Held Sylow-pair placement

The predicates here specify tests on actual elements of the fixed Held
carrier. `Covers` requires a factorization of every element, and
`RepresentativeChecks` requires actual local membership or a forbidden
prime-order element in the generated subgroup. The accompanying search
data are candidates only; none of these predicates is assumed as an axiom.
The placement assembly must prove all of them and the marked two-group fact.

Sources: the ATLAS permutation and local-subgroup programs; see `source/README.md`.
-/

public section
namespace Held.LocalPairs.PairCoverage.SylowOvergroups
open Subgroup Theory.GroupTheory.SubgroupEnumeration

/-- A forbidden prime order in the subgroup generated by the marked subgroup and r. -/
@[expose] def HasPrimeObstruction (r : He) : Prop :=
  ∃ p : ℕ, Nat.Prime p ∧ p ≠ 2 ∧ p ≠ 3 ∧
    ∃ x ∈ markedSubgroup ⊔ zpowers r, orderOf x = p

/-- All 4,831 candidate tests, independently of double-coset exhaustiveness. -/
@[expose] def RepresentativeChecks : Prop :=
  ∀ j : Fin 4831, representative j ∈ alignedOvergroup false ∨
    representative j ∈ alignedOvergroup true ∨ HasPrimeObstruction (representative j)

/-- The exact remaining exhaustive factorization obligation. -/
@[expose] def Covers : Prop := DoubleCosetCover markedSubgroup representative

/-- A power identity and a nonidentity check suffice for an obstruction.
The witness still has to belong to the actual generated subgroup. -/
theorem hasPrimeObstruction_of_pow (r x : He) (p : ℕ) (hp : Nat.Prime p)
    (hp2 : p ≠ 2) (hp3 : p ≠ 3) (hx : x ∈ markedSubgroup ⊔ zpowers r)
    (hpow : x ^ p = 1) (hne : x ≠ 1) : HasPrimeObstruction r := by
  let _ : Fact p.Prime := ⟨hp⟩
  exact ⟨p, hp, hp2, hp3, x, hx, orderOf_eq_prime hpow hne⟩

end Held.LocalPairs.PairCoverage.SylowOvergroups
