module
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.KernelUpperBound.Checks0
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.KernelUpperBound.Checks1
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.KernelUpperBound.StabilizerChain
/-!
# The complete native six-point kernel of the Held locals

The envelope generated by the exact word core and the distinguished element
of exponent three is normal in the literal local subgroup: the two original
generators normalize it by the checked conjugation equations. In the quotient,
five conjugate involutions generate and satisfy the adjacent relations. Their
explicitly marked native action is faithful by the six-point stabilizer chain.
Thus every element of the native kernel belongs to the envelope.

The certificate uses full-degree permutation equalities and symbolic group
rewriting, with no order-64 or order-192 assumption. Final commutator and
pair-containment assembly belongs to the existing CoreKernel consumer.

Sources: GLS3 Table 5.3p; unchanged ATLAS max3/max4 and degree-2058 data;
quasithin printed pp.509–511 and 747–748, in the retained Held branch.
-/

namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.RepresentativeGeometry.CoreKernel
open Subgroup KernelUpperBound
private theorem envelope_normal (i : Bool) : (kernelEnvelope i).Normal := by
  have he : kernelEnvelope i = closure ((wordCore i : Set (localOvergroup i)) ∪ {kernelThird i}) := by
    rw [Subgroup.closure_union, Subgroup.closure_eq, ← zpowers_eq_closure]
    rfl
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← generator_closure i]
  apply (closure_le _).mpr
  rintro _ ⟨k, rfl⟩
  rw [he]
  apply mem_normalizer_closure_of_conjugates
  intro y hy
  rw [← he]
  rcases hy with hy | hy
  · exact (show wordCore i ≤ kernelEnvelope i from le_sup_left)
      ((wordCore_normal i).conj_mem y hy (generator i k))
  · have hy' : y = kernelThird i := hy
    subst y
    cases i <;> rcases (show k = 0 ∨ k = 1 from by fin_cases k <;> decide) with rfl | rfl
    · rw [Checks0.normalize0]; exact correction_mem _ _ _
    · rw [Checks0.normalize1]; exact correction_mem _ _ _
    · rw [Checks1.normalize0]; exact correction_mem _ _ _
    · rw [Checks1.normalize1]; exact correction_mem _ _ _

attribute [local instance] envelope_normal
private abbrev Q (i : Bool) := localOvergroup i ⧸ kernelEnvelope i
private def q (i : Bool) : localOvergroup i →* Q i := QuotientGroup.mk' _
private def s (i : Bool) (k : Fin 5) : Q i := q i (adjacent i k)
private theorem q_correction (i : Bool) (w : List (Fin 7)) (e : Nat) : q i (correction i w e) = 1 :=
  (QuotientGroup.eq_one_iff _).mpr (correction_mem i w e)

private theorem s_square (i : Bool) (k : Fin 5) : ev (s i) [k,k] = ev (s i) [] := by
  simpa only [ev, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
    s, map_mul, map_one] using congrArg (q i) (adjacent_square i k)

private theorem s_commute (i : Bool) (a b : Fin 5)
    (h : a.val + 1 < b.val ∨ b.val + 1 < a.val) :
    ev (s i) [a,b] = ev (s i) [b,a] := by
  have h02 : s i 0 * s i 2 = s i 2 * s i 0 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.commute02
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.commute02
  have h03 : s i 0 * s i 3 = s i 3 * s i 0 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.commute03
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.commute03
  have h04 : s i 0 * s i 4 = s i 4 * s i 0 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.commute04
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.commute04
  have h13 : s i 1 * s i 3 = s i 3 * s i 1 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.commute13
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.commute13
  have h14 : s i 1 * s i 4 = s i 4 * s i 1 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.commute14
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.commute14
  have h24 : s i 2 * s i 4 = s i 4 * s i 2 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.commute24
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.commute24
  have hc (a b : Fin 5) (h : a.val + 1 < b.val) :
      s i a * s i b = s i b * s i a := by
    fin_cases a <;> fin_cases b <;> norm_num at h
    · exact h02
    · exact h03
    · exact h04
    · exact h13
    · exact h14
    · exact h24
  simp only [ev, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
  exact h.elim (hc a b) (fun h => (hc b a h).symm)

private theorem s_braid (i : Bool) (a b : Fin 5)
    (h : a.val + 1 = b.val ∨ b.val + 1 = a.val) :
    ev (s i) [a,b,a] = ev (s i) [b,a,b] := by
  have h01 : s i 0 * s i 1 * s i 0 = s i 1 * s i 0 * s i 1 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.braid0
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.braid0
  have h12 : s i 1 * s i 2 * s i 1 = s i 2 * s i 1 * s i 2 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.braid1
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.braid1
  have h23 : s i 2 * s i 3 * s i 2 = s i 3 * s i 2 * s i 3 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.braid2
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.braid2
  have h34 : s i 3 * s i 4 * s i 3 = s i 4 * s i 3 * s i 4 := by
    cases i
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.braid3
    · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.braid3
  have hb (a b : Fin 5) (h : a.val + 1 = b.val) :
      s i a * s i b * s i a = s i b * s i a * s i b := by
    fin_cases a <;> fin_cases b <;> norm_num at h
    · exact h01
    · exact h12
    · exact h23
    · exact h34
  simp only [ev, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, ← mul_assoc]
  exact h.elim (hb a b) (fun h => (hb b a h).symm)

private theorem s_closure (i : Bool) : closure (Set.range (s i)) = ⊤ := by
  let H := closure (Set.range (s i))
  have hs (k : Fin 5) : s i k ∈ H := subset_closure (Set.mem_range_self k)
  have hc : q i (cycle i) ∈ H := by
    have he : q i (cycle i) = s i 0 * s i 1 * s i 2 * s i 3 * s i 4 := by
      cases i
      · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q false) Checks0.cycle_relation
      · simpa only [s, map_mul, q_correction, one_mul] using congrArg (q true) Checks1.cycle_relation
    rw [he]
    exact H.mul_mem (H.mul_mem (H.mul_mem (H.mul_mem (hs 0) (hs 1)) (hs 2)) (hs 3)) (hs 4)
  have h0 : q i (generator i 0) ∈ H := by
    simpa only [s, adjacent, Fin.val_zero, pow_zero, one_mul, inv_one, mul_one] using hs 0
  have h1 : q i (generator i 1) ∈ H := by
    by_cases hi : i = true
    · have hc' : cycle i = generator i 0 * generator i 1 := by unfold cycle; exact if_pos hi
      rw [hc', map_mul] at hc
      exact (H.mul_mem_cancel_left h0).mp hc
    · have hc' : cycle i = generator i 1 := by unfold cycle; exact if_neg hi
      exact (congrArg (fun z => q i z ∈ H) hc').mp hc
  have hpre : (⊤ : Subgroup (localOvergroup i)) ≤ H.comap (q i) := by
    rw [← generator_closure i]
    apply (closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    rcases (show k = 0 ∨ k = 1 from by fin_cases k <;> decide) with rfl | rfl
    · exact h0
    · exact h1
  apply top_unique
  intro x _
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (kernelEnvelope i) x
  exact hpre (mem_top y)

private def mark (i : Bool) : Equiv.Perm (Fin 6) where
  toFun := if i then ![0,5,3,1,4,2] else ![2,5,3,1,4,0]
  invFun := if i then ![0,3,5,2,4,1] else ![5,3,0,2,4,1]
  left_inv := by cases i <;> decide
  right_inv := by cases i <;> decide

private noncomputable def markedAction (i : Bool) : localOvergroup i →* Equiv.Perm (Fin 6) :=
  (mark i).symm.permCongrHom.toMonoidHom.comp (SixPoint.action i)

private theorem markedAction_adjacent (i : Bool) (k : Fin 5) :
    markedAction i (adjacent i k) = swapGen k := by
  have hg0 : SixPoint.action i (generator i 0) = SixPoint.first i := by
    cases i <;> exact SixPoint.action_first _
  have hg1 : SixPoint.action i (generator i 1) = SixPoint.second i := by
    cases i <;> exact SixPoint.action_second _
  have hc : SixPoint.action i (cycle i) =
      if i then SixPoint.first i * SixPoint.second i else SixPoint.second i := by
    cases i <;> simp only [cycle, Bool.false_eq_true, ↓reduceIte, map_mul, hg0, hg1]
  unfold markedAction
  simp only [MonoidHom.comp_apply, adjacent, map_mul, map_inv, map_pow, hg0, hc]
  cases i <;> fin_cases k <;> decide +kernel

private noncomputable def quotientAction (i : Bool) : Q i →* Equiv.Perm (Fin 6) :=
  QuotientGroup.lift (kernelEnvelope i) (markedAction i) (by
    intro x hx
    change (mark i).symm.permCongrHom (SixPoint.action i x) = 1
    rw [show SixPoint.action i x = 1 from kernelEnvelope_le_ker i hx, map_one])

private theorem quotientAction_s (i : Bool) (k : Fin 5) : quotientAction i (s i k) = swapGen k :=
  markedAction_adjacent i k

/-- The actual native six-point kernel is exhausted by the word core and the
specified element of exponent three, inside the literal local subgroup. -/
public theorem nativeKernel_le_kernelEnvelope (i : Bool) : (SixPoint.action i).ker ≤ kernelEnvelope i := by
  intro x hx
  apply (QuotientGroup.eq_one_iff x).mp
  apply faithful_of_relations (s i) (quotientAction i) (s_closure i) (quotientAction_s i)
    (s_square i) (s_commute i) (s_braid i)
  change (mark i).symm.permCongrHom (SixPoint.action i x) = 1
  rw [show SixPoint.action i x = 1 from hx, map_one]
end Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.RepresentativeGeometry.CoreKernel
