module
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.KernelUpperBound.Model

/-!
# Checked adjacent-involution tables for Held local 0

Each table is a conjugate of the actual first ATLAS generator by a power
of the chosen native six-cycle. All 2058 coordinates are kernel checked.
Packing is an evaluation optimization, not an additional group model.
Source: unchanged ATLAS HeG1-p2058B0 and max3/max4 programs; GLS3 Table 5.3p.
-/

namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.RepresentativeGeometry.CoreKernel.KernelUpperBound.Tables0
open Held.TwoLocalCandidates
set_option maxRecDepth 8192

@[expose] public def forward0 (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def p0 : Equiv.Perm (Fin 2058) where
  toFun := forward0
  invFun := forward0
  left_inv := by apply Cores.allLetters; decide +kernel
  right_inv := by apply Cores.allLetters; decide +kernel

public theorem p0_eq : p0 = representation (adjacent false 0).val := by
  rw [representation_adjacent]
  apply Equiv.ext
  apply Cores.allLetters
  decide +kernel

