module
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.Words

/-!
# Lookup certificates for the two-generators of Held pair (0, 0)

The packed permutations are checked against the published literal words on all
2058 letters. Their role is to keep the subsequent core-membership checks small.
Source: unchanged ATLAS degree-2058 permutations and LocalActions.Candidates;
GLS3 Table 5.3p. The generator script preserves the already-inverted GAP action.
-/

namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.RepresentativeGeometry.CoreKernel.TwoTables00
open Held.TwoLocalCandidates
open LocalActions.RepresentativeImages
set_option maxRecDepth 8192

private theorem first_table : Cores.Tables0.p0 = atlasA := Cores.Tables0.p0_eq

@[expose] public def forward0 (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def backward0 (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 2400000 in
@[expose] public def p0 : Equiv.Perm (Fin 2058) where
  toFun := forward0
  invFun := backward0
  left_inv := by apply Cores.allLetters; decide +kernel
  right_inv := by apply Cores.allLetters; decide +kernel

set_option maxHeartbeats 2400000 in
public theorem p0_eq : p0 = representation (twoGenerator false 0 0).val := by
  change p0 = representation (LocalActions.evalLocalWord false (LocalActions.twoWord false 0 0))
  rw [representation_evalLocalWord]
  simp only [LocalActions.twoWord, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
    Bool.false_eq_true, if_false, if_true, ← Local0.localPerm_eq, ← first_table]
  apply Equiv.ext
  apply Cores.allLetters
  decide +kernel

