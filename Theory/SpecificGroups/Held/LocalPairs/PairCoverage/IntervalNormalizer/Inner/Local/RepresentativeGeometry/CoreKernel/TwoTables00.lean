@[expose] public def generatorPerm (k : Fin 4) : Equiv.Perm (Fin 2058) := ![p0, p1, p2, p3] k

public theorem representation_generator (k : Fin 4) :
    representation (twoGenerator false 0 k).val = generatorPerm k := by
  fin_cases k
  · exact p0_eq.symm
  · exact p1_eq.symm
  · exact p2_eq.symm
  · exact p3_eq.symm

set_option maxHeartbeats 2400000 in
public theorem coreWord_spec (k : Fin 7) :
    ((twoWord false 0 k).map (fun t => (twoGenerator false 0 t.1).val ^ t.2)).prod =
      (coreGenerator false k).val := by
  apply representation_injective
  simp only [map_list_prod, List.map_map, Function.comp_def, map_zpow,
    representation_coreGenerator, representation_generator]
  fin_cases k <;> apply Equiv.ext <;> apply Cores.allLetters <;> decide +kernel

