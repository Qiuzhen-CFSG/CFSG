module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.LocalActions.RepresentativeImages.Words

/-!
# Words for normal two-subgroups of the Held pair residuals

The pair alphabet is exactly [r₀,r₁,t₀,t₁,t₂,t₃]. The ten-letter alphabet
consists of r₀,r₁ and tₖ rₗ tₖ⁻¹, in that order. Eight short words in these
conjugates will generate a normal two-subgroup of the actual two-residual.
The finite relations are certified in the descendants, in the unchanged
ATLAS degree-2058 representation (whose GAP permutations are already inverted).

Sources: GLS3 Table 5.3p; the literal ATLAS max3/max4 words retained in
LocalActions.Candidates; quasithin printed pp.509–511 and 747–748.
The discovery tables are only proposed identities, checked separately in Lean.
-/

@[expose] public section
open Subgroup
namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.RepresentativeGeometry.ResidualRoots

/-- The original six-letter pair alphabet, without dropping redundant generators. -/
def pairWord (i : Bool) (j : Fin 2) : Fin 6 → List (Bool × ℤ)
  | 0 => LocalActions.oddWord i j 0
  | 1 => LocalActions.oddWord i j 1
  | 2 => LocalActions.twoWord i j 0
  | 3 => LocalActions.twoWord i j 1
  | 4 => LocalActions.twoWord i j 2
  | 5 => LocalActions.twoWord i j 3

def pairGenerator (i : Bool) (j : Fin 2) (k : Fin 6) : Held.He :=
  LocalActions.evalLocalWord i (pairWord i j k)

/-- Conjugation is x*y*x⁻¹, not the opposite GAP convention. -/
def conjugates {G : Type*} [Group G] (g : Fin 6 → G) : Fin 10 → G
  | 0 => g 0
  | 1 => g 1
  | 2 => g 2 * g 0 * (g 2)⁻¹
  | 3 => g 2 * g 1 * (g 2)⁻¹
  | 4 => g 3 * g 0 * (g 3)⁻¹
  | 5 => g 3 * g 1 * (g 3)⁻¹
  | 6 => g 4 * g 0 * (g 4)⁻¹
  | 7 => g 4 * g 1 * (g 4)⁻¹
  | 8 => g 5 * g 0 * (g 5)⁻¹
  | 9 => g 5 * g 1 * (g 5)⁻¹

def evalSigned {G : Type*} [Group G] (g : Fin 10 → G) (w : List (Fin 10 × Bool)) : G :=
  (w.map fun t => if t.2 then (g t.1)⁻¹ else g t.1).prod

