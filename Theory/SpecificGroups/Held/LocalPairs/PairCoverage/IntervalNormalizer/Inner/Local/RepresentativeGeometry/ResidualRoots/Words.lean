def generator (i : Bool) (j : Fin 2) (k : Fin 8) : Held.He :=
  evalSigned (conjugates (pairGenerator i j)) (generatorWord i j k)

def product (i : Bool) (j : Fin 2) (w : List (Fin 8)) : Held.He :=
  (w.map (generator i j)).prod

def group (i : Bool) (j : Fin 2) : Subgroup Held.He :=
  closure (Set.range (generator i j))

