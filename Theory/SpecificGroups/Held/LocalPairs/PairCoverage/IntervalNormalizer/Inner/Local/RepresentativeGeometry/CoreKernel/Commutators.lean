module
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.CommutatorChecks00
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.CommutatorChecks01
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.CommutatorChecks10
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.CommutatorChecks11

/-!
# The literal Held word core is generated by its odd commutators

The checked products recover every core generator. Relative normality gives
the reverse inclusion. This does not identify the word core with O₂(M).
Source: GLS3 Table 5.3p; the unchanged ATLAS max3/max4 words and permutations.
-/

public section
open Subgroup
open scoped commutatorElement
namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.RepresentativeGeometry.CoreKernel
theorem commutatorWord_spec (i : Bool) (j : Fin 2) (k : Fin 7) :
    ((commutatorWord i j k).map (fun t =>
      ⁅(coreGenerator i t.1).val, (oddGenerator i j t.2).val⁆)).prod =
        (coreGenerator i k).val := by
  cases i <;> fin_cases j
  · exact CommutatorChecks00.check k
  · exact CommutatorChecks01.check k
  · exact CommutatorChecks10.check k
  · exact CommutatorChecks11.check k

theorem wordCore_commutator (i : Bool) (j : Fin 2) :
    ⁅ambientWordCore i, LocalActions.candidateOdd i j⁆ = ambientWordCore i := by
  apply le_antisymm
  · rw [commutator_comm]
    exact le_normalizer_iff_commutator_le_right.mp
      ((LocalActions.candidateOdd_le_localOvergroup i j).trans
        (localOvergroup_le_normalizer_ambientWordCore i))
  · rw [ambientWordCore_eq_closure]
    apply (closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    change (coreGenerator i k).val ∈ _
    rw [← commutatorWord_spec i j k]
    apply Subgroup.list_prod_mem
    intro x hx
    obtain ⟨t, _, rfl⟩ := List.mem_map.mp hx
    exact commutator_mem_commutator
      (show (coreGenerator i t.1).val ∈ closure (Set.range (fun k => (coreGenerator i k).val))
        from subset_closure (Set.mem_range_self t.1))
      (LocalActions.RepresentativeImages.oddGenerator_mem i j t.2)

end Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.RepresentativeGeometry.CoreKernel
