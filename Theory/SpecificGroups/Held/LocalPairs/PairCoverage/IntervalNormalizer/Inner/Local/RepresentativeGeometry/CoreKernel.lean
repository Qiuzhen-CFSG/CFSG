module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.Actions

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.Commutators
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.KernelUpperBound
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.Membership
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Local.RepresentativeGeometry.CoreKernel.Reduction

/-!
# Core commutators and kernel containment for the literal Held pairs

The native six-point kernel is exactly the envelope generated by the word core
and the distinguished cube-one element, by the checked adjacent relations and
stabilizer chain. In the quotient by the word core, the intrinsic two-core maps
into a cyclic three-group and hence is trivial. Thus the word core is O₂(M).
The checked word-core commutators and envelope containments then give the
two-core commutator equality and native kernel containment for all four literal
pairs, with normality relative to M throughout.

Sources: GLS3 Table 5.3p; unchanged ATLAS max3/max4 and degree-2058 data;
quasithin printed pp.509–511 and 747–748, in the retained Held branch.
-/

public section
open Subgroup
namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.RepresentativeGeometry.CoreKernel

theorem localTwoCore_commutator_of_kernelEnvelope (i : Bool) (j : Fin 2)
    (hk : (SixPoint.action i).ker ≤ kernelEnvelope i) :
    ⁅localTwoCore i, LocalActions.candidateOdd i j⁆ = localTwoCore i := by
  have hC : ambientWordCore i = localTwoCore i :=
    congrArg (fun H : Subgroup (localOvergroup i) => H.map (localOvergroup i).subtype)
      (wordCore_eq_pCore_of_kernel i hk)
  rw [← hC]
  exact wordCore_commutator i j

theorem nativeKernel_le_pairProduct_of_kernelEnvelope (i : Bool) (j : Fin 2)
    (hk : (SixPoint.action i).ker ≤ kernelEnvelope i) :
    (SixPoint.action i).ker ≤ (pairProduct i j).subgroupOf (localOvergroup i) :=
  hk.trans (kernelEnvelope_le_pairProduct i j)

/-- The envelope exhausts the kernel of the actual native six-point action. -/
theorem nativeKernel_eq_kernelEnvelope (i : Bool) :
    (SixPoint.action i).ker = kernelEnvelope i :=
  le_antisymm (nativeKernel_le_kernelEnvelope i) (kernelEnvelope_le_ker i)

/-- The existing word core is the intrinsic two-core of the literal local group. -/
theorem wordCore_eq_pCore (i : Bool) : wordCore i = pCore 2 (localOvergroup i) :=
  wordCore_eq_pCore_of_kernel i (nativeKernel_le_kernelEnvelope i)

/-- Each published odd candidate generates the entire local two-core by
commutators. -/
theorem localTwoCore_commutator (i : Bool) (j : Fin 2) :
    ⁅localTwoCore i, LocalActions.candidateOdd i j⁆ = localTwoCore i :=
  localTwoCore_commutator_of_kernelEnvelope i j (nativeKernel_le_kernelEnvelope i)

/-- Each literal pair product contains the native kernel, inside its local
overgroup. -/
theorem nativeKernel_le_pairProduct (i : Bool) (j : Fin 2) :
    (SixPoint.action i).ker ≤ (pairProduct i j).subgroupOf (localOvergroup i) :=
  nativeKernel_le_pairProduct_of_kernelEnvelope i j (nativeKernel_le_kernelEnvelope i)

end Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.RepresentativeGeometry.CoreKernel
