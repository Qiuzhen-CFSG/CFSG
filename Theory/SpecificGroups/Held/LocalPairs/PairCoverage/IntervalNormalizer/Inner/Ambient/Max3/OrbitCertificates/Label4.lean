namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3.OrbitCertificates.Label4

@[expose] public def data : Data where
  componentCode := 
  rootCode := 0x3b022d1e019317b1600b409d08603b03602c02201901501100d00b00a008007006004003002001000
  treeCode := 
  sizeCode := 0x401002040100201008020100100202010040400801008010040202002008004040

set_option maxRecDepth 16384 in
set_option maxHeartbeats 16000000 in
private theorem invariant : ∀ (e : Bool) (j : Fin 4) (x : Fin 2058),
    data.component (wordAction 4 e j x) = data.component x := by
  decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 16000000 in
private theorem tree : ∀ x : Fin 2058, x = data.root (data.component x) ∨
    (data.depth (data.parent x) < data.depth x ∧
      data.component (data.parent x) = data.component x ∧
      wordAction 4 (data.edgeSide x) (data.edgeIndex x) (data.parent x) = x) := by
  decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 16000000 in
private theorem sizes : ∀ c : Fin 36,
    (List.finRange 2058).countP (fun x => data.component x == c) = data.size c := by
  decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 16000000 in
private theorem labels : ∀ x : Fin 2058,
    orbitSizeLabel 4 x = data.size (data.component x) := by
  decide +kernel

public theorem valid : Valid 4 data := ⟨invariant, tree, sizes, labels⟩

end Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3.OrbitCertificates.Label4
