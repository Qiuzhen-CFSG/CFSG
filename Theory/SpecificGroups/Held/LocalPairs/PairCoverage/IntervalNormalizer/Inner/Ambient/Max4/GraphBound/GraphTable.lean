module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max4.GraphBound.Basic

/-!
# A packed lookup for the unchanged Held relation

This is only a computational representation of `GraphData.rowMask`. Equality
with every original row is kernel checked. Blocks of 32 rows avoid repeated
instantiation of the original large comparison tree during finite checks.
Generated from the unchanged ATLAS-derived graph by `Source/generate_graph_table.py`.

-/

namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max4.GraphBound
open Held.NormalizerGraph Held.NormalizerGraph.CardBound

@[expose] public def fastRow (x : Fin 2058) : ℕ :=
  let s := x.val / 32
  ((if s < 32 then (if s < 16 then (if s < 8 then (if s < 4 then (if s < 2 then (if s < 1 then  else ) else (if s < 3 then  else )) else (if s < 6 then (if s < 5 then  else ) else (if s < 7 then  else ))) else (if s < 12 then (if s < 10 then (if s < 9 then  else ) else (if s < 11 then  else )) else (if s < 14 then (if s < 13 then  else ) else (if s < 15 then  else )))) else (if s < 24 then (if s < 20 then (if s < 18 then (if s < 17 then  else ) else (if s < 19 then  else )) else (if s < 22 then (if s < 21 then  else ) else (if s < 23 then  else ))) else (if s < 28 then (if s < 26 then (if s < 25 then  else ) else (if s < 27 then  else )) else (if s < 30 then (if s < 29 then  else ) else (if s < 31 then  else ))))) else (if s < 48 then (if s < 40 then (if s < 36 then (if s < 34 then (if s < 33 then  else ) else (if s < 35 then  else )) else (if s < 38 then (if s < 37 then  else ) else (if s < 39 then  else ))) else (if s < 44 then (if s < 42 then (if s < 41 then  else ) else (if s < 43 then  else )) else (if s < 46 then (if s < 45 then  else ) else (if s < 47 then  else )))) else (if s < 56 then (if s < 52 then (if s < 50 then (if s < 49 then  else ) else (if s < 51 then  else )) else (if s < 54 then (if s < 53 then  else ) else (if s < 55 then  else ))) else (if s < 60 then (if s < 58 then (if s < 57 then  else ) else (if s < 59 then  else )) else (if s < 62 then (if s < 61 then  else ) else (if s < 63 then  else (if s < 64 then  else ))))))) >>> (2058*(x.val % 32))) % 2^2058

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
public theorem fastRow_eq : ∀ x : Fin 2058, fastRow x = rowMask x := by
  apply checked_forall
  decide +kernel

public theorem adj_iff_fast (x y : Fin 2058) :
    Adj x y ↔ (fastRow x).testBit y.val = true := by
  rw [fastRow_eq]
  rfl

public theorem checked_graph (σ : Equiv.Perm (Fin 2058)) (lo hi : ℕ)
    (h : allUpTo (fun i =>
      if lo ≤ i ∧ i < hi then
        allUpTo (fun k => decide
          ((fastRow (σ (vertex i))).testBit (σ (vertex k)).val =
            (fastRow (vertex i)).testBit (vertex k).val)) 2058
      else true) 2058 = true) :
    ∀ x : Fin 2058, lo ≤ x.val → x.val < hi → ∀ y,
      Adj (σ x) (σ y) ↔ Adj x y := by
  intro x hl hu y
  have hb := checked_pairs (fun x y =>
    (fastRow (σ x)).testBit (σ y).val = (fastRow x).testBit y.val) lo hi h x hl hu y
  rw [adj_iff_fast, adj_iff_fast, hb]

end Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max4.GraphBound
