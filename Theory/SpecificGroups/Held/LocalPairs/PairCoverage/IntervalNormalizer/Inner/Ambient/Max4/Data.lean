module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Representatives
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.CoreWitness
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Reduction
public import Theory.SpecificGroups.Held.Automorphisms.Normalizer.GraphData
public import Mathlib.GroupTheory.Perm.Sign
public import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# Seven candidate max4 interval subgroups and their orbit colors

The entries are the literal Schreier closures in the already aligned max4
representative. The masks, in binary with coordinate zero least significant,
are 1, 2, 3, 12, 13, 14, 15; the pivot is their first true coordinate.
`Schreier` proves why these seven suffice, including arbitrary initial pivots.

The packed colors are candidate orbit sizes, generated by `Source/generate.py`
from the unchanged ATLAS permutations and published representative words.
Their identification with actual orbit cardinalities, graph-group bounds,
and local normalizer witnesses are separate proof obligations. In particular,
`bound` is just a numerical target and asserts no subgroup order.

Sources: GLS3 Table 5.3p; ATLAS HeG1-p2058B0 and max4;
SylowGeometry/Calculations/Source/words.json and the existing conjugator 3.
-/

@[expose] public section
namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max4

/-- Nonzero masks whose last two bits agree. -/
def mask : Fin 7 → Fin 4 → Bool
  | 0 => ![true, false, false, false]
  | 1 => ![false, true, false, false]
  | 2 => ![true, true, false, false]
  | 3 => ![false, false, true, true]
  | 4 => ![true, false, true, true]
  | 5 => ![false, true, true, true]
  | 6 => ![true, true, true, true]

/-- A true pivot for each of the seven masks. -/
def pivot : Fin 7 → Fin 4 := ![0, 1, 0, 2, 0, 1, 0]

/-- The actual degree-2058 subgroups, not abstract family tags. -/
def candidate (j : Fin 7) : Subgroup He := entry true (pivot j) (mask j)

/-- Target bounds for the seven normalizer calculations. -/
def bound : Fin 7 → ℕ := ![3072, 3072, 1024, 1024, 3072, 1024, 1024]

/-- Candidate orbit sizes, stored as ten-bit fields. -/
def orbitSizeLabel (j : Fin 7) (x : Fin 2058) : ℕ :=
  ((match j with
    | 0 => 
    | 1 => 
    | 2 => 
    | 3 => 
    | 4 => 
    | 5 => 
    | 6 => 
  ) >>> (10 * x.val)) % 1024

/-- Permutations preserving the candidate orbit-size coloring. -/
def colorPreservingGroup (j : Fin 7) : Subgroup (Equiv.Perm (Fin 2058)) where
  carrier := {σ | ∀ x, orbitSizeLabel j (σ x) = orbitSizeLabel j x}
  one_mem' := by intro x; rfl
  mul_mem' := by
    intro σ τ hσ hτ x
    exact (hσ (τ x)).trans (hτ x)
  inv_mem' := by
    intro σ hσ x
    change orbitSizeLabel j (σ.symm x) = orbitSizeLabel j x
    simpa only [Equiv.apply_symm_apply] using (hσ (σ.symm x)).symm

/-- Symmetries of the actual Held graph preserving these colors. -/
def coloredGraphGroup (j : Fin 7) : Subgroup (Equiv.Perm (Fin 2058)) :=
  Held.NormalizerGraph.preservingGroup ⊓ colorPreservingGroup j

/-- The even part, which contains all represented inner normalizers once the
orbit-size identification is proved. -/
def evenColoredGraphGroup (j : Fin 7) : Subgroup (Equiv.Perm (Fin 2058)) :=
  coloredGraphGroup j ⊓ Equiv.Perm.sign.ker

end Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max4
