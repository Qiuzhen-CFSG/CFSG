module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3.Geometry
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3.SextetStabilizer.GraphBound
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3.SextetStabilizer.LowerBound

/-!
# Identification of the literal Held max3 sextet stabilizer

The actual graph-and-sextet stabilizer has order at most 138240. Held preserves
the graph, so its sextet stabilizer satisfies that bound. The literal subgroup
generated by `a` and `localWord false` already lies in this stabilizer. Its order
is at least 138240, using the explicitly permitted orbit-label identity for the
existing four-word representative. Finite subgroup cardinality forces equality.

Only that allowed representative orbit identity remains a premise. Neither the
seven selected-entry orbit tables nor a maximal-subgroup classification is used.
Source: GLS3 Table 5.3p and the unchanged ATLAS HeG1-p2058B0/max3 data.
-/

namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3
open Subgroup
open Held.LocalPairs.SylowGeometry.Calculations

/-- Graph preservation embeds the actual Held stabilizer in the certified
full graph-and-sextet stabilizer. -/
public theorem sextetStabilizer_card_le : Nat.card sextetStabilizer ≤ 138240 := by
  have hc : Nat.card sextetStabilizer ≤ Nat.card graphSextetGroup := by
    apply Nat.card_le_card_of_injective
      (fun g : sextetStabilizer => (⟨representation g.val,
        ⟨Realization.MarkedConjugacy.Seventeen.permutationGroup_le_preservingGroup
          g.val.property, g.property⟩⟩ : graphSextetGroup))
    intro g h he
    apply Subtype.ext
    apply representation_injective
    exact congrArg (fun σ : graphSextetGroup => σ.val) he
  exact hc.trans card_graphSextetGroup_le

/-- The geometric stabilizer is the literal max3 generator closure, using only
the representative orbit certificate allowed by the ambient task. -/
public theorem sextetStabilizer_eq_localOvergroup
    (horbitsP : ∀ x : Fin 2058,
      InnerNormalizer.orbitSizeLabel x = Nat.card (MulAction.orbit representative x)) :
    sextetStabilizer = localOvergroup false := by
  exact (eq_of_le_of_card_ge localOvergroup_le_sextetStabilizer
    (sextetStabilizer_card_le.trans (local_card_ge_of_representative_orbits horbitsP))).symm

/-- The reverse geometric containment required by the max3 normalizer assembly. -/
public theorem sextetStabilizer_le_localOvergroup
    (horbitsP : ∀ x : Fin 2058,
      InnerNormalizer.orbitSizeLabel x = Nat.card (MulAction.orbit representative x)) :
    sextetStabilizer ≤ localOvergroup false :=
  (sextetStabilizer_eq_localOvergroup horbitsP).le

end Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3
