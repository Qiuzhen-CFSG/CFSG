/-!
# Finite orbit certificate for max3 mask 8

The data propose a spanning forest for the eight literal Schreier generators.
The four kernel checks establish generator invariance, reachability, component
cardinalities, and agreement with the existing orbit-size labels.
Source: ATLAS HeG1-p2058B0/max3 and the representative words; reproduce with
`OrbitCertificates/Source/generate.py`. No assertion trusts this generator.
-/

namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3.OrbitCertificates.Label3

@[expose] public def data : Data where
  componentCode := 
  rootCode := 0x3b02cf25122d1f61e019317b16011a0d709d08606704c04103b03602c02201901601100f00d00b00a009008007006005004002001000
  treeCode := 
  sizeCode := 0x10020100202002040080101004010080200804010010020200804040100200401004008040100804008004040

set_option maxRecDepth 16384 in
set_option maxHeartbeats 16000000 in
private theorem invariant : ∀ (e : Bool) (j : Fin 4) (x : Fin 2058),
    data.component (wordAction 3 e j x) = data.component x := by
  decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 16000000 in
private theorem tree : ∀ x : Fin 2058, x = data.root (data.component x) ∨
    (data.depth (data.parent x) < data.depth x ∧
      data.component (data.parent x) = data.component x ∧
      wordAction 3 (data.edgeSide x) (data.edgeIndex x) (data.parent x) = x) := by
  decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 16000000 in
private theorem sizes : ∀ c : Fin 36,
    (List.finRange 2058).countP (fun x => data.component x == c) = data.size c := by
  decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 16000000 in
private theorem labels : ∀ x : Fin 2058,
    orbitSizeLabel 3 x = data.size (data.component x) := by
  decide +kernel

public theorem valid : Valid 3 data := ⟨invariant, tree, sizes, labels⟩

end Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3.OrbitCertificates.Label3
