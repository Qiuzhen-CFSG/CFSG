module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3.Selection
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3.Geometry
public import Theory.SpecificGroups.Held.Automorphisms.Normalizer.GraphData
public import Mathlib.GroupTheory.Perm.Sign
public import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# Candidate orbit colors for the seven max3 entries

These tables are computed from the exact eight Schreier words in each
`selectedEntry`. The data do not assert their identification with actual
orbits. That is the separate OrbitCertificates obligation. Likewise no
order or geometric containment of a colored graph group is asserted here.

`Source/generate_orbits.py` reproduces these labels and the zero-based orbit
lists in `Source/orbits.json` from the unchanged ATLAS sources. All groups
below are actual subgroups of the degree-2058 permutation group.
Sources: ATLAS HeG1-p2058B0/max3; GLS3 Table 5.3p.
-/

public section
namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3

/-- Packed candidate orbit-size tables; correctness is a separate certificate. -/
@[expose] def packedOrbitSizes : Fin 7 → ℕ
  | 0 => 
  | 1 => 
  | 2 => 
  | 3 => 
  | 4 => 
  | 5 => 
  | 6 => 

/-- Candidate orbit cardinalities of the selected entry, in ten-bit fields. -/
@[expose] def orbitSizeLabel (t : Fin 7) (x : Fin 2058) : ℕ :=
  (packedOrbitSizes t >>> (10 * x.val)) % 1024

/-- Permutations preserving precisely the proposed orbit-size coloring. -/
@[expose] def colorPreservingGroup (t : Fin 7) : Subgroup (Equiv.Perm (Fin 2058)) where
  carrier := {σ | ∀ x, orbitSizeLabel t (σ x) = orbitSizeLabel t x}
  one_mem' := by intro x; rfl
  mul_mem' := by
    intro σ τ hσ hτ x
    exact (hσ (τ x)).trans (hτ x)
  inv_mem' := by
    intro σ hσ x
    change orbitSizeLabel t (σ.symm x) = orbitSizeLabel t x
    simpa only [Equiv.apply_symm_apply] using (hσ (σ.symm x)).symm

/-- Symmetries of the published Held relation and the proposed coloring. -/
@[expose] def coloredGraphGroup (t : Fin 7) : Subgroup (Equiv.Perm (Fin 2058)) :=
  Held.NormalizerGraph.preservingGroup ⊓ colorPreservingGroup t

/-- Its even subgroup; the parity restriction is needed for mask 12. -/
@[expose] def evenColoredGraphGroup (t : Fin 7) : Subgroup (Equiv.Perm (Fin 2058)) :=
  coloredGraphGroup t ⊓ Equiv.Perm.sign.ker

end Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max3
