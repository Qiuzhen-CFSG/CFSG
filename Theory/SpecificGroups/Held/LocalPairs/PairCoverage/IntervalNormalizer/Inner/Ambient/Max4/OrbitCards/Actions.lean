/-!
# Checked tables for the aligned Held max4 generators

We evaluate the existing words using the original ATLAS permutations.
The intermediate local word and conjugator are tabulated first, then each of
the four aligned generators is checked at all 2058 letters. Inverse tables
are checked and transported by injectivity. Thus `action` is the action of
the actual eight Schreier generators, with no group-order premise.

Sources: unchanged ATLAS HeG1-p2058B0; the representative words and conjugator
in `Max4/Source/README.md`. `Source/generate.py` reproduces the untrusted balanced lookup tables.
-/

-- Finite checks are serialized to keep their transient kernel memory bounded.
set_option Elab.async false

namespace Held.LocalPairs.PairCoverage.IntervalNormalizer.Inner.Ambient.Max4.OrbitCards
open Held.LocalPairs.SylowGeometry.Calculations
open Held.TwoLocalCandidates.MaximalNormalizerCatalogue (conjugator conjugatorWord)

/-- Small coordinate blocks, with the last block wrapping at the endpoint. -/
@[expose] public def point (b : Fin 33) (i : Fin 64) : Fin 2058 :=
  ⟨(64 * b.val + i.val) % 2058, Nat.mod_lt _ (by decide)⟩

/-- Checking all blocks checks every point of the original carrier. -/
public theorem checkPoints (P : Fin 2058 → Prop)
    (h : ∀ b i, P (point b i)) : ∀ x, P x := by
  intro x
  let b : Fin 33 := ⟨x.val / 64, by omega⟩
  let i : Fin 64 := ⟨x.val % 64, Nat.mod_lt _ (by decide)⟩
  have hx : point b i = x := by
    apply Fin.ext
    dsimp only [point, b, i]
    omega
  simpa only [hx] using h b i

private def evalPair (p q : Equiv.Perm (Fin 2058)) (w : List ℤ) :
    Equiv.Perm (Fin 2058) :=
  (w.map (fun k => if k.natAbs = 1 then p ^ k else
    q ^ (if k < 0 then (-1 : ℤ) else 1))).prod

private def evalAction (p q : Equiv.Perm (Fin 2058)) : List ℤ → Fin 2058 → Fin 2058
  | [], x => x
  | k :: w, x =>
    let y := evalAction p q w x
    if k.natAbs = 1 then (if k < 0 then p.symm y else p y)
    else (if k < 0 then q.symm y else q y)

private theorem evalAction_eq (p q : Equiv.Perm (Fin 2058)) (w : List ℤ) (x : Fin 2058) :
    evalAction p q w x = evalPair p q w x := by
  induction w generalizing x with
  | nil => rfl
  | cons k w ih =>
    by_cases hk : k.natAbs = 1
    · rcases Int.natAbs_eq_iff.mp hk with h | h
      · subst k
        simp [evalAction, evalPair, Equiv.Perm.mul_apply, ih]
      · subst k
        simp [evalAction, evalPair, Equiv.Perm.mul_apply, ih]
    · by_cases hn : k < 0 <;>
        simp [evalAction, evalPair, hk, hn, Equiv.Perm.mul_apply, ih]

private theorem evalPair_map (p q : He) (w : List ℤ) :
    evalPair (representation p) (representation q) w =
      representation ((w.map (fun k => if k.natAbs = 1 then p ^ k else
        q ^ (if k < 0 then (-1 : ℤ) else 1))).prod) := by
  unfold evalPair
  rw [map_list_prod, List.map_map]
  congr 1
  apply List.map_congr_left
  intro k hk
  by_cases h : k.natAbs = 1
  · simp only [Function.comp_apply, if_pos h, map_zpow]
  · simp only [Function.comp_apply, if_neg h, map_zpow]

private def fastLocal : Equiv.Perm (Fin 2058) :=
  ((atlasA * atlasB ^ 5) * (atlasA * atlasB ^ 3)) *
    ((atlasA * atlasB ^ 4) * (atlasA * atlasB ^ 6))

private def fastConjugator : Equiv.Perm (Fin 2058) :=
  evalPair atlasA atlasB (conjugatorWord 3)

