  apply checkPoints
  intro b
  fin_cases b <;> decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
private theorem fixed_correct_3 : ∀ x : Fin 2058,
    fixedAction false 3 x = fastFixed 3 x := by
  simp only [fastFixed, Equiv.Perm.mul_apply, ← evalAction_eq]
  apply checkPoints
  intro b
  fin_cases b <;> decide +kernel

private theorem fixed_correct (i : Fin 4) (x : Fin 2058) :
    fixedAction false i x = representation (fixedGenerator true i) x := by
  rw [← fastFixed_eq]
  fin_cases i
  · exact fixed_correct_0 x
  · exact fixed_correct_1 x
  · exact fixed_correct_2 x
  · exact fixed_correct_3 x

set_option maxRecDepth 16384 in
private theorem inverse_check : ∀ i x, fixedAction false i (fixedAction true i x) = x := by
  intro i
  apply checkPoints
  intro b
  fin_cases i <;> fin_cases b <;> decide +kernel

private theorem representation_inv_cancel (g : He) (x : Fin 2058) :
    representation g (representation (g⁻¹) x) = x := by
  rw [map_inv]
  exact Equiv.apply_symm_apply _ _

private theorem inverse_correct (i : Fin 4) (x : Fin 2058) :
    fixedAction true i x = representation ((fixedGenerator true i)⁻¹) x := by
  apply (representation (fixedGenerator true i)).injective
  calc
    representation (fixedGenerator true i) (fixedAction true i x) =
        fixedAction false i (fixedAction true i x) := (fixed_correct i _).symm
    _ = x := inverse_check i x
    _ = representation (fixedGenerator true i)
        (representation ((fixedGenerator true i)⁻¹) x) :=
      (representation_inv_cancel _ _).symm

@[expose] public def action (j : Fin 7) (r : Fin 8) (x : Fin 2058) : Fin 2058 :=
  let e := decide (4 ≤ r.val)
  let i : Fin 4 := ⟨r.val % 4, Nat.mod_lt _ (by decide)⟩
  let y := if e != mask j i then fixedAction true (pivot j) x else x
  let z := fixedAction false i y
  if e then fixedAction false (pivot j) z else z

public theorem action_eq (j : Fin 7) (r : Fin 8) (x : Fin 2058) :
    action j r x = schreierGenerator j r • x := by
  change action j r x = representation (schreierGenerator j r) x
  unfold action schreierGenerator Subgroup.indexTwoGenerator
  generalize decide (4 ≤ r.val) = e
  generalize (⟨r.val % 4, Nat.mod_lt _ (by decide)⟩ : Fin 4) = i
  cases e <;> cases hm : mask j i <;>
    simp [fixed_correct, inverse_correct, hm, Equiv.Perm.mul_apply]

