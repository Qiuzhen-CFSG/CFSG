@[expose] public def fixedAction (back : Bool) (i : Fin 4) (x : Fin 2058) : Fin 2058 :=
  ⟨tableData back i x % 2058, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
private theorem fixed_correct_0 : ∀ x : Fin 2058,
    fixedAction false 0 x = fastFixed 0 x := by
  simp only [fastFixed, Equiv.Perm.mul_apply, ← evalAction_eq]
  apply checkPoints
  intro b
  fin_cases b <;> decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
private theorem fixed_correct_1 : ∀ x : Fin 2058,
    fixedAction false 1 x = fastFixed 1 x := by
  simp only [fastFixed, Equiv.Perm.mul_apply, ← evalAction_eq]
  apply checkPoints
  intro b
  fin_cases b <;> decide +kernel

set_option maxRecDepth 16384 in
set_option maxHeartbeats 8000000 in
private theorem fixed_correct_2 : ∀ x : Fin 2058,
    fixedAction false 2 x = fastFixed 2 x := by
