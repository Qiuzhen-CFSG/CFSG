module

public import Theory.SpecificGroups.Held.LocalPairs.Basic
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.PResidual.FiniteImage

/-!
# Residuals for the Held pair calculation

If R has odd order and S is a two-group, O²(⟨R,S⟩) is the normal closure
of R inside ⟨R,S⟩. Indeed, every odd-order element dies in any two-group
quotient, and the quotient by that normal closure is generated by S.
No ambient normality of R is required, nor is permutability needed here.

We also transport the embedded residual and its two-core through actual
automorphisms of Held. These equations allow calculations at conjugate
pairs to be used with the original embedded subgroups.

Source: Aschbacher–Smith, printed pp.509–511, 725 and 747–748, with O²
and O₂ kept distinct. These lemmas justify the residual used by the local
calculation; they do not assert any interval-normalizer inclusion.
-/

public section

open Subgroup
namespace Held.LocalPairs

/-- The relative normal closure used in the local calculations is exactly O²(RS). -/
theorem residual_eq_normalClosure (S R : Subgroup He) (hS : IsPGroup 2 S)
    (hR : Nat.Coprime 2 (Nat.card R)) :
    residual S R =
      (normalClosure (R.subgroupOf (R ⊔ S) : Set (R ⊔ S : Subgroup He))).map
        (R ⊔ S).subtype := by
  let K := R ⊔ S
  let C := normalClosure (R.subgroupOf K : Set K)
  have hcard : Nat.card (R.subgroupOf K) = Nat.card R :=
    Nat.card_congr (subgroupOfEquivOfLe (show R ≤ K from le_sup_left)).toEquiv
  have hRc : R.subgroupOf K ≤ pResidual 2 K := by
    intro x hx
    apply mem_pResidual_of_orderOf_coprime
    exact (hcard ▸ hR).of_dvd_right ((R.subgroupOf K).orderOf_dvd_natCard hx)
  have hCS : C ⊔ S.subgroupOf K = ⊤ := by
    apply top_unique
    have he : R.subgroupOf K ⊔ S.subgroupOf K = ⊤ := by
      rw [← subgroupOf_sup le_sup_left le_sup_right]
      exact subgroupOf_self _
    rw [← he]
    exact sup_le_sup le_normalClosure le_rfl
  have hquot : IsPGroup 2 (K ⧸ C) :=
    isPGroup_quotient_of_sup_eq_top C (S.subgroupOf K)
      (hS.of_equiv (subgroupOfEquivOfLe (show S ≤ K from le_sup_right)).symm) hCS
  have he : pResidual 2 K = C :=
    le_antisymm (sInf_le ⟨inferInstance, hquot⟩) (normalClosure_le_normal hRc)
  exact congrArg (map K.subtype) he

/-- Automorphisms transport the relative residual, embedded in the same carrier. -/
theorem residual_map (S R : Subgroup He) (e : MulAut He) :
    (residual S R).map e.toMonoidHom =
      residual (S.map e.toMonoidHom) (R.map e.toMonoidHom) := by
  rw [residual, map_embedded_pResidual, Subgroup.map_sup]
  rfl

/-- Transport the two-core of the residual as well as the residual itself. -/
theorem twoCore_map (S R : Subgroup He) (e : MulAut He) :
    (twoCore S R).map e.toMonoidHom =
      twoCore (S.map e.toMonoidHom) (R.map e.toMonoidHom) := by
  let eU : residual S R ≃* (residual S R).map e.toMonoidHom := e.subgroupMap _
  change ((pCore 2 (residual S R)).map (residual S R).subtype).map e.toMonoidHom = _
  calc
    _ = ((pCore 2 (residual S R)).map eU.toMonoidHom).map
        ((residual S R).map e.toMonoidHom).subtype := by
      rw [map_map, map_map]
      rfl
    _ = (pCore 2 ((residual S R).map e.toMonoidHom)).map
        ((residual S R).map e.toMonoidHom).subtype := by rw [pCore_map_iso]
    _ = _ := by rw [residual_map]; rfl

/-- Preserving the join suffices to preserve its residual. -/
theorem automorphismNormalizer_join_le (S R : Subgroup He) :
    automorphismNormalizer (R ⊔ S) ≤ automorphismNormalizer (residual S R) := by
  intro e he
  change (R ⊔ S).map e.toMonoidHom = R ⊔ S at he
  change (residual S R).map e.toMonoidHom = residual S R
  rw [residual, map_embedded_pResidual, he]

/-- A normalizer inclusion calculated at an automorphic image descends to
the original subgroups. Both normalizers are in the full automorphism group. -/
theorem automorphismNormalizer_le_of_map (e : MulAut He) (U V : Subgroup He)
    (h : automorphismNormalizer (U.map e.toMonoidHom) ≤
      automorphismNormalizer (V.map e.toMonoidHom)) :
    automorphismNormalizer U ≤ automorphismNormalizer V := by
  intro a ha
  have haU := (mem_automorphism_stabilizer_iff U a).mp ha
  have hconj : MulAut.congr e a ∈ automorphismNormalizer (U.map e.toMonoidHom) := by
    apply (mem_automorphism_stabilizer_iff _ _).mpr
    intro y
    obtain ⟨x, rfl⟩ := e.surjective y
    simpa only [MulAut.congr_apply, MulEquiv.trans_apply, e.symm_apply_apply,
      mem_map_equiv] using haU x
  apply (mem_automorphism_stabilizer_iff _ _).mpr
  intro x
  have hx := (mem_automorphism_stabilizer_iff _ _).mp (h hconj) (e x)
  simpa only [MulAut.congr_apply, MulEquiv.trans_apply, e.symm_apply_apply,
    mem_map_equiv] using hx

end Held.LocalPairs
