module

public import Theory.SpecificGroups.Held.Model.Basic

/-!
# The two ATLAS local subgroups used for Held pairs

These are literal subgroups of the fixed degree-2058 carrier, generated by
the outputs of `HeG1-max3W1` and `HeG1-max4W1`. The definitions do not assert
their orders, structures, maximality, or exhaustiveness.

GAP acts on the right, whereas Lean composes functions on the left. The
existing Held carrier already inverts each imported GAP permutation, so
the order of letters in the programs is preserved. Reversing their order
again would use the wrong convention. The first output generator is `Held.a`.

Sources: ATLAS, https://brauer.maths.qmul.ac.uk/Atlas/spor/He/words/HeG1-max3W1
and https://brauer.maths.qmul.ac.uk/Atlas/spor/He/words/HeG1-max4W1;
GLS3, Table 5.3p. The original programs and the translation are retained
in the adjacent `source` directory.
-/

@[expose] public section

namespace Held.LocalPairs.PairCoverage

/-- Second output of the ATLAS program: false selects max3, true max4. -/
def localWord (i : Bool) : He :=
  ((a * b ^ 5) * (a * b ^ (if i then 2 else 3))) * ((a * b ^ 4) * (a * b ^ 6))

/-- The actual local subgroup; its structural properties are separate theorems. -/
def localOvergroup (i : Bool) : Subgroup He :=
  Subgroup.closure {a, localWord i}

theorem a_mem_localOvergroup (i : Bool) : a ∈ localOvergroup i :=
  Subgroup.subset_closure (Set.mem_insert _ _)

theorem localWord_mem_localOvergroup (i : Bool) : localWord i ∈ localOvergroup i :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)

/-- The definition uses the same permutations as the fixed ambient carrier. -/
theorem representation_localWord (i : Bool) :
    representation (localWord i) =
      ((atlasA * atlasB ^ 5) * (atlasA * atlasB ^ (if i then 2 else 3))) *
        ((atlasA * atlasB ^ 4) * (atlasA * atlasB ^ 6)) := by
  simp only [localWord, map_mul, map_pow]
  rfl

/-- Written in the original, uninverted permutation functions, the GAP
product composes its four factors in reverse order. Inverting that result
recovers precisely the local word in the existing Lean carrier. -/
theorem representation_localWord_eq_inverse_rightWord (i : Bool) :
    representation (localWord i) =
      (((atlasB⁻¹ ^ 6 * atlasA⁻¹) * (atlasB⁻¹ ^ 4 * atlasA⁻¹)) *
        ((atlasB⁻¹ ^ (if i then 2 else 3) * atlasA⁻¹) *
          (atlasB⁻¹ ^ 5 * atlasA⁻¹)))⁻¹ := by
  simp only [representation_localWord, mul_inv_rev, inv_pow, inv_inv, mul_assoc]

/-- Literal permutation image, without any recognition by order. -/
theorem localOvergroup_map (i : Bool) :
    (localOvergroup i).map representation =
      Subgroup.closure {atlasA, representation (localWord i)} := by
  rw [localOvergroup, MonoidHom.map_closure]
  simp only [Set.image_insert_eq, Set.image_singleton]
  rfl

end Held.LocalPairs.PairCoverage
