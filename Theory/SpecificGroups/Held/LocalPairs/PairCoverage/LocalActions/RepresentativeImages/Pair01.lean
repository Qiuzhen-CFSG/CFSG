@[expose] public def odd0 : Equiv.Perm (Fin 2058) where
  toFun := odd0Forward
  invFun := odd0Backward
  left_inv := by apply allLetters; decide +kernel
  right_inv := by apply allLetters; decide +kernel

set_option maxHeartbeats 2400000 in
public theorem odd0_eq : odd0 = representation (oddGenerator false 1 0) := by
  unfold oddGenerator
  rw [representation_evalLocalWord]
  simp only [oddWord, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
    Bool.false_eq_true, if_false, if_true, ← Local0.localPerm_eq]
  apply Equiv.ext
  apply allLetters
