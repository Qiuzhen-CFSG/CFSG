set_option maxHeartbeats 2400000 in
public theorem odd0_cube : oddGenerator false 1 0 ^ 3 = 1 := by
  apply representation_injective
  rw [map_pow, map_one, ← odd0_eq]
  apply Equiv.ext
  apply allLetters
