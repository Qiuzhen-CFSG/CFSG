module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.LocalActions.RepresentativeImages.PureActors.Support
public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Tables0

/-!
# Packed ambient generators for the pure Held actors

The tables are evaluation aids; their identities are checked on every
one of the 2058 letters by Lean kernel reduction. The ambient word uses
only Held's two generators and the already certified ATLAS outer implementer.
Source: the unchanged HeG1-p2058B0 carrier, HeG1-a2W1, GLS3 Table 5.3p,
and quasithin pp.509–511. See source/README.md for the discovery provenance.
-/

namespace Held.LocalPairs.PairCoverage.LocalActions.RepresentativeImages.PureActors
set_option maxRecDepth 8192

namespace AmbientTables

public theorem packedA_eq : Held.TwoLocalCandidates.Cores.Tables0.p0 = atlasA :=
  Held.TwoLocalCandidates.Cores.Tables0.p0_eq

@[expose] public def packedBForward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def packedBBackward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 2400000 in
@[expose] public def packedB : Equiv.Perm (Fin 2058) where
  toFun := packedBForward
  invFun := packedBBackward
  left_inv := by apply allLetters; decide +kernel
  right_inv := by apply allLetters; decide +kernel

set_option maxHeartbeats 2400000 in
public theorem packedB_eq : packedB = atlasB := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

@[expose] public def packedCForward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def packedCBackward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 2400000 in
@[expose] public def packedC : Equiv.Perm (Fin 2058) where
  toFun := packedCForward
  invFun := packedCBackward
  left_inv := by apply allLetters; decide +kernel
  right_inv := by apply allLetters; decide +kernel

set_option maxHeartbeats 2400000 in
public theorem packedC_eq : packedC = Held.OuterInvolution.implementer := by
  apply Equiv.ext
  apply allLetters
  decide +kernel

end AmbientTables
end Held.LocalPairs.PairCoverage.LocalActions.RepresentativeImages.PureActors
