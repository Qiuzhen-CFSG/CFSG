/-!
# Pure Held actor 0: ambient normalization

The tables are evaluation aids; their identities are checked on every
one of the 2058 letters by Lean kernel reduction. The ambient word uses
only Held's two generators and the already certified ATLAS outer implementer.
Source: the unchanged HeG1-p2058B0 carrier, HeG1-a2W1, GLS3 Table 5.3p,
and quasithin pp.509–511. See source/README.md for the discovery provenance.
-/

namespace Held.LocalPairs.PairCoverage.LocalActions.RepresentativeImages.PureActors
set_option maxRecDepth 8192

namespace Actor0
open Subgroup

@[expose] public def permForward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

@[expose] public def permBackward (v : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * v.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 2400000 in
@[expose] public def perm : Equiv.Perm (Fin 2058) where
  toFun := permForward
  invFun := permBackward
  left_inv := by apply allLetters; decide +kernel
  right_inv := by apply allLetters; decide +kernel

set_option maxHeartbeats 2400000 in
public theorem perm_eq_word : perm =
    (atlasB ^ (2 : ℤ)) *
    (atlasA ^ (1 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (1 : ℤ)) *
    (atlasB ^ (2 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (-1 : ℤ)) *
    (atlasB ^ (2 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (-1 : ℤ)) *
    (atlasB ^ (-1 : ℤ)) *
    (atlasA ^ (-1 : ℤ)) *
    (atlasB ^ (1 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (1 : ℤ)) *
    (atlasB ^ (1 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (1 : ℤ)) *
    (atlasB ^ (1 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (-2 : ℤ)) *
    (atlasB ^ (-1 : ℤ)) *
    (atlasA ^ (-1 : ℤ)) *
    (atlasB ^ (-2 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (1 : ℤ)) *
    (atlasA ^ (-1 : ℤ)) *
    (atlasB ^ (-1 : ℤ)) *
    (atlasA ^ (-1 : ℤ)) *
    (atlasB ^ (-2 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (1 : ℤ)) *
    (atlasB ^ (-1 : ℤ)) *
    (atlasA ^ (1 : ℤ)) *
    (atlasB ^ (2 : ℤ)) *
    (atlasA ^ (1 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (1 : ℤ)) *
    (atlasB ^ (1 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (1 : ℤ)) *
    (atlasA ^ (1 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (2 : ℤ)) *
    (atlasB ^ (-1 : ℤ)) *
    (Held.OuterInvolution.implementer ^ (2 : ℤ)) := by
  rw [← AmbientTables.packedA_eq, ← AmbientTables.packedB_eq, ← AmbientTables.packedC_eq]
  apply Equiv.ext
  apply allLetters
  decide +kernel

public theorem perm_mem_normalizer :
    perm ∈ normalizer (permutationGroup : Set (Equiv.Perm (Fin 2058))) := by
  rw [perm_eq_word]
  have ha := permutationGroup.le_normalizer a.property
  have hb := permutationGroup.le_normalizer b.property
  have hc := Held.OuterInvolution.implementer_mem_normalizer
  exact (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (zpow_mem hb (2 : ℤ)) (zpow_mem ha (1 : ℤ))) (zpow_mem hc (1 : ℤ))) (zpow_mem hb (2 : ℤ))) (zpow_mem hc (-1 : ℤ))) (zpow_mem hb (2 : ℤ))) (zpow_mem hc (-1 : ℤ))) (zpow_mem hb (-1 : ℤ))) (zpow_mem ha (-1 : ℤ))) (zpow_mem hb (1 : ℤ))) (zpow_mem hc (1 : ℤ))) (zpow_mem hb (1 : ℤ))) (zpow_mem hc (1 : ℤ))) (zpow_mem hb (1 : ℤ))) (zpow_mem hc (-2 : ℤ))) (zpow_mem hb (-1 : ℤ))) (zpow_mem ha (-1 : ℤ))) (zpow_mem hb (-2 : ℤ))) (zpow_mem hc (1 : ℤ))) (zpow_mem ha (-1 : ℤ))) (zpow_mem hb (-1 : ℤ))) (zpow_mem ha (-1 : ℤ))) (zpow_mem hb (-2 : ℤ))) (zpow_mem hc (1 : ℤ))) (zpow_mem hb (-1 : ℤ))) (zpow_mem ha (1 : ℤ))) (zpow_mem hb (2 : ℤ))) (zpow_mem ha (1 : ℤ))) (zpow_mem hc (1 : ℤ))) (zpow_mem hb (1 : ℤ))) (zpow_mem hc (1 : ℤ))) (zpow_mem ha (1 : ℤ))) (zpow_mem hc (2 : ℤ))) (zpow_mem hb (-1 : ℤ))) (zpow_mem hc (2 : ℤ)))

end Actor0
