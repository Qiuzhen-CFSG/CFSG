def rightRepresentative (i : Bool) (r : Fin 135) : He :=
  representative i (rightData i r).1 * evalPowers (evenGenerator i) (rightData i r).2

/-- Positive local generators, then their inverses. -/
def localLetter (i : Bool) : Fin 4 → He
  | 0 => a
  | 1 => localWord i
  | 2 => a⁻¹
  | 3 => (localWord i)⁻¹

