/-- The exhaustive row test: membership in an aligned product, or a literal
prime-five obstruction. Coverage of the rows is proved separately. -/
theorem representative_alternative (i : Bool) (r : Fin 17) :
    representative i r ∈ alignedProduct i 0 ∨
      representative i r ∈ alignedProduct i 1 ∨ orderOf (obstruction i r) = 5 := by
  cases i <;> fin_cases r
  · exact Or.inl good_false_0
  · exact Or.inl good_false_1
  · exact Or.inl good_false_2
  · exact Or.inl good_false_3
  · exact Or.inr (Or.inr obstruction_false_4)
  · exact Or.inr (Or.inr obstruction_false_5)
  · exact Or.inr (Or.inr obstruction_false_6)
  · exact Or.inr (Or.inr obstruction_false_7)
  · exact Or.inr (Or.inr obstruction_false_8)
  · exact Or.inr (Or.inl good_false_9)
  · exact Or.inr (Or.inl good_false_10)
  · exact Or.inr (Or.inr obstruction_false_11)
  · exact Or.inr (Or.inr obstruction_false_12)
  · exact Or.inr (Or.inr obstruction_false_13)
  · exact Or.inr (Or.inr obstruction_false_14)
  · exact Or.inr (Or.inr obstruction_false_15)
  · exact Or.inr (Or.inr obstruction_false_16)
  · exact Or.inl good_true_0
  · exact Or.inl good_true_1
  · exact Or.inl good_true_2
  · exact Or.inl good_true_3
  · exact Or.inr (Or.inr obstruction_true_4)
  · exact Or.inr (Or.inr obstruction_true_5)
  · exact Or.inr (Or.inr obstruction_true_6)
  · exact Or.inr (Or.inr obstruction_true_7)
  · exact Or.inr (Or.inr obstruction_true_8)
  · exact Or.inr (Or.inr obstruction_true_9)
  · exact Or.inr (Or.inr obstruction_true_10)
  · exact Or.inr (Or.inr obstruction_true_11)
  · exact Or.inr (Or.inr obstruction_true_12)
  · exact Or.inr (Or.inl good_true_13)
  · exact Or.inr (Or.inl good_true_14)
  · exact Or.inr (Or.inr obstruction_true_15)
  · exact Or.inr (Or.inr obstruction_true_16)

end Held.LocalPairs.PairCoverage.LocalActions.Exhaustion.SubgroupCover
