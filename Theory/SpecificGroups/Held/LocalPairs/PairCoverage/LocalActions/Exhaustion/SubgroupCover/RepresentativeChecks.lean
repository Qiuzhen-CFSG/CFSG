module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.LocalActions.Exhaustion.SubgroupCover.RepresentativeChecks.Images
public import Theory.SpecificGroups.Held.Model.FourPointBase
public import Mathlib.Tactic.FinCases

/-!
# Checked alignment and prime-five obstructions

The marked two-subgroup lies in both aligned products. Each of the 17
literal representatives either belongs to one of those products or adjoins
an explicit element of order five. All word identities are checked on the
proved four-point base of the actual Held permutation group, using kernel
reduction. No subgroup or ambient group order is assumed.

Sources: discovery.json and the factor words generated by source/Generate.g;
ATLAS HeG1-p2058B0 and GLS3 Table 5.3p.
-/

@[expose] public section
namespace Held.LocalPairs.PairCoverage.LocalActions.Exhaustion.SubgroupCover
open Subgroup RepresentativeChecks

set_option maxRecDepth 8192

private theorem alignment_identity (i : Bool) (k : Fin 4) :
    alignment i * evenGenerator i k * (alignment i)⁻¹ =
      evalPowers (productGenerator i 1) (alignmentFactor i k) := by
  cases i <;> fin_cases k <;> apply eq_of_four_point_images <;>
    simp only [map_mul, map_inv, alignment, rep_local,
      ← fastEven_eq, rep_powers, ← fastProduct_eq] <;> decide +kernel

/-- Both aligned products contain the actual marked two-subgroup. -/
theorem marked_le_aligned (i : Bool) (j : Fin 2) :
    candidateTwo i 0 ≤ alignedProduct i j := by
  fin_cases j
  · exact le_sup_right
  · apply (closure_le _).mpr
    rintro x ⟨k, rfl⟩
    change alignment i * evenGenerator i k * (alignment i)⁻¹ ∈ candidateProduct i 1
    rw [alignment_identity]
    exact evalPowers_mem _ _ (productGenerator_mem i 1) _

/-- Transfer the product-word certificate before specializing the long words.
This keeps conjugation and subgroup-comap reduction at an abstract boundary. -/
private theorem aligned_mem_of_word (i : Bool) (r : Fin 17)
    (h : alignment i * representative i r * (alignment i)⁻¹ =
      evalPowers (productGenerator i 1) (membershipWord i r)) :
    representative i r ∈ alignedProduct i 1 := by
  change alignment i * representative i r * (alignment i)⁻¹ ∈ candidateProduct i 1
  rw [h]
  exact evalPowers_mem (candidateProduct i 1) (productGenerator i 1)
    (productGenerator_mem i 1) (membershipWord i r)

