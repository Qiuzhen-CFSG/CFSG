private theorem obstruction_false_4 : orderOf (obstruction false 4) = 5 := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  apply orderOf_eq_prime
  · apply eq_of_four_point_images
    simp only [map_pow, map_one, obstruction, rep_powers, ← fastExtension_eq]
    decide +kernel
  · intro h
    have he : ∀ t : Fin 4,
        representation (obstruction false 4) ⟨t.val, by omega⟩ =
          representation 1 ⟨t.val, by omega⟩ :=
      fun t => congrArg (fun x : He => representation x ⟨t.val, by omega⟩) h
    simp only [obstruction, rep_powers, ← fastExtension_eq, map_one] at he
    revert he
    decide +kernel

