module

public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.LocalActions.Candidates
public import Mathlib.GroupTheory.Sylow

/-!
# Concrete obligations for local Held pair exhaustion

The product is the join of the published literal candidates. Its order is
an independent finite calculation. The coverage
obligation concerns all subgroups of odd relative index with prime divisors
in {2,3}; it does not assume that the odd complement is elementary abelian.

These are specifications, not certificates. The exhaustion assembly must
construct both before claiming simultaneous conjugacy. No global Held
order, maximal-subgroup recognition, or automorphism realization is needed.

Sources: Aschbacher–Smith, printed pp.509–511; GLS3 Table 5.3p; candidate
words and discovery calculations in ../source/Explore.g and Explore.txt.
-/

@[expose] public section
namespace Held.LocalPairs.PairCoverage.LocalActions.Exhaustion
open Subgroup

/-- The actual subgroup generated by a published candidate pair. -/
def candidateProduct (i : Bool) (j : Fin 2) : Subgroup He :=
  candidateOdd i j ⊔ candidateTwo i j

theorem candidateProduct_le_localOvergroup (i : Bool) (j : Fin 2) :
    candidateProduct i j ≤ localOvergroup i :=
  sup_le (candidateOdd_le_localOvergroup i j) (candidateTwo_le_localOvergroup i j)

/-- Exact orders of the two literal factors and their actual join. -/
def CandidateOrders : Prop :=
  ∀ (i : Bool) (j : Fin 2),
    Nat.card (candidateTwo i j) = 1024 ∧
    Nat.card (candidateOdd i j) = 9 ∧
    Nat.card (candidateProduct i j) = 9216

/-- The two relative normalizers multiply onto the whole candidate product.
This will follow from the candidate orders, rather than an additional calculation.
Both factors are required to belong to that product, not just to Held. -/
def NormalizerFactorization : Prop :=
  ∀ (i : Bool) (j : Fin 2) (x : He), x ∈ candidateProduct i j →
    ∃ u ∈ candidateProduct i j, u ∈ normalizer (candidateOdd i j : Set He) ∧
      ∃ v ∈ candidateProduct i j, v ∈ normalizer (candidateTwo i j : Set He) ∧
        x = u * v

/-- Local subgroup coverage, before any choice of an odd complement.
Relative index is taken inside the literal local overgroup. -/
def LocalProductCover : Prop :=
  ∀ (i : Bool) (K : Subgroup He), K ≤ localOvergroup i →
    ¬ 2 ∣ K.relIndex (localOvergroup i) →
    (∀ p : ℕ, p.Prime → p ∣ Nat.card K → p = 2 ∨ p = 3) →
    ∃ (j : Fin 2) (g : He), g ∈ localOvergroup i ∧
      K.map (MulAut.conj g).toMonoidHom ≤ candidateProduct i j

end Held.LocalPairs.PairCoverage.LocalActions.Exhaustion
