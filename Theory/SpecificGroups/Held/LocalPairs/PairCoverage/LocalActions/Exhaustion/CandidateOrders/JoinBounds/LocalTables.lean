def local1_backward (x : ℕ) : ℕ :=
  local1_backward_blocks (x / 16) / 4096 ^ (x % 16) % 4096 % 2058

def local1 : Equiv.Perm (Fin 2058) where
  toFun x := ⟨local1_forward x.val, Nat.mod_lt _ (by decide)⟩
  invFun x := ⟨local1_backward x.val, Nat.mod_lt _ (by decide)⟩
  left_inv := by
    intro x
    apply Fin.ext
    exact eq_of_check (fun x => local1_backward (local1_forward x)) id
      (by decide +kernel) x.val x.isLt
  right_inv := by
    intro x
    apply Fin.ext
    exact eq_of_check (fun x => local1_forward (local1_backward x)) id
      (by decide +kernel) x.val x.isLt

private theorem local1_word : local1 =
    ((aTable * bTable ^ 5) * (aTable * bTable ^ 2)) *
      ((aTable * bTable ^ 4) * (aTable * bTable ^ 6)) := by
  apply Equiv.ext
  intro x
  apply Fin.ext
  exact eq_of_check (fun x => local1_forward (x)) (fun x => aTable_forward (bTable_forward (bTable_forward (bTable_forward (bTable_forward (bTable_forward (aTable_forward (bTable_forward (bTable_forward (aTable_forward (bTable_forward (bTable_forward (bTable_forward (bTable_forward (aTable_forward (bTable_forward (bTable_forward (bTable_forward (bTable_forward (bTable_forward (bTable_forward (x))))))))))))))))))))))
    (by decide +kernel) x.val x.isLt

theorem local1_eq : local1 = representation (localWord true) := by
  rw [representation_localWord, ← aTable_eq, ← bTable_eq]
  exact local1_word

def localTable : Bool → Equiv.Perm (Fin 2058)
  | false => local0
  | true => local1

theorem localTable_eq (i : Bool) : localTable i = representation (localWord i) := by
  cases i
  · exact local0_eq
  · exact local1_eq

theorem map_local_word (i : Bool) (w : List (Bool × ℤ)) :
    representation (evalLocalWord i w) =
      (w.map (fun t => (if t.1 then localTable i else aTable) ^ t.2)).prod := by
  simp only [evalLocalWord, map_list_prod, List.map_map, Function.comp_def,
    apply_ite representation, map_zpow, localTable_eq, aTable_eq]
  rfl

end Held.LocalPairs.PairCoverage.LocalActions.Exhaustion.JoinBounds.LocalTables
