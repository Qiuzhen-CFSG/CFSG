def bTable : Equiv.Perm (Fin 2058) where
  toFun x := ⟨bTable_forward x.val, Nat.mod_lt _ (by decide)⟩
  invFun x := ⟨bTable_backward x.val, Nat.mod_lt _ (by decide)⟩
  left_inv := by
    intro x
    apply Fin.ext
    exact eq_of_check (fun x => bTable_backward (bTable_forward x)) id
      (by decide +kernel) x.val x.isLt
  right_inv := by
    intro x
    apply Fin.ext
    exact eq_of_check (fun x => bTable_forward (bTable_backward x)) id
      (by decide +kernel) x.val x.isLt

theorem bTable_eq : bTable = atlasB := by
  apply Equiv.ext
  intro x
  apply Fin.ext
  change bTable_forward x.val = (atlasB x).val
  have h := eq_of_check bTable_forward
    (fun n => (atlasB ⟨n % 2058, Nat.mod_lt _ (by decide)⟩).val)
    (by decide +kernel) x.val x.isLt
  simpa only [Nat.mod_eq_of_lt x.isLt] using h

