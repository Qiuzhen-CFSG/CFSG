module
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.IntrinsicEnumeration.ExtensionChecks.Action

/-! Finite certificates for a complement to the literal row-nine elementary
subgroup of the native Held Sylow. Every identity is checked on the already
proved faithful four-point base of the original degree-2058 action. -/
namespace Held.TransvectionCentralizer.SylowComplement
open TwoLocalCandidates.MaximalNormalizerCatalogue
open IntrinsicEnumeration ExtensionChecks

private def index (i : Fin 64) : Fin 1024 :=
  ⟨(4477650938015123153837747767992018453570956276780307153275632731691736565063220155324081191574983256087813551753623681097674521706761123123824573491856609398928702150820273288763958399578681344 >>> (10*i.val)) % 1024, Nat.mod_lt _ (by decide)⟩
private def productIndex (i j : Fin 64) : Fin 64 :=
  ⟨( >>> (6*(64*i.val+j.val))) % 64, Nat.mod_lt _ (by decide)⟩
private def inverseIndex (i : Fin 64) : Fin 64 :=
  ⟨(39383222764461833574019147001920677051694118474305452974449322256129117712057443158994093895679310407010695071121472 >>> (6*i.val)) % 64, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 8192 in
set_option maxHeartbeats 10000000 in
private theorem multiplication_check : ∀ i j : Fin 64,
    sameAction (normalFormAction (index (productIndex i j)))
      (normalFormAction (index i) * normalFormAction (index j)) = true := by
  decide +kernel

set_option maxRecDepth 8192 in
private theorem inverse_check : ∀ i : Fin 64,
    sameAction (normalFormAction (index (inverseIndex i)) * normalFormAction (index i)) 1 = true := by
  decide +kernel

private theorem index_injective : Function.Injective index := by
  apply StrictMono.injective
  apply Fin.strictMono_iff_lt_succ.mpr
  decide +kernel

private theorem disjoint_check : ∀ i : Fin 64, index i ∈ members (some 9) → index i = 0 := by
  decide +kernel

end Held.TransvectionCentralizer.SylowComplement
