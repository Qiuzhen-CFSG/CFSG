module

public import Theory.SpecificGroups.Held.Model.Presentation
public import Theory.SpecificGroups.Held.Model.Transitivity
public import Mathlib.GroupTheory.Index

/-!
# The source subgroup M₁ in the Held presentation

The abstract subgroup is generated by `x`, `x^(y²)` and `x^(y⁻²)`, with
right conjugation `x^g = g⁻¹*x*g` as in the retained Magma source. Its image
fixes point 1206 in the ATLAS numbering, or 1205 in the zero-based Lean
representation. These three fixed-point identities are checked by the kernel.
The inverse image of the full point stabilizer has index 2058, by the already
proved transitivity of the concrete action and surjectivity of the presentation
map. This does not yet compute the index or order of the abstract subgroup.

Source: John Bray's ATLAS `HeG1-P1.M`, the definition of `M1`, retained in
`Theory/SpecificGroups/Held/Model/Source/`. The source's presentation-identification
argument uses the trivial multiplier; none of that argument is used here.
-/

namespace Held.CentralCovers.TwoPrimary.FaithfulPresentation

/-- The first generator of the actual seven-relator presentation. -/
public abbrev x : Presentation := PresentedGroup.of 0

/-- The second generator of the actual seven-relator presentation. -/
public abbrev y : Presentation := PresentedGroup.of 1

/-- The literal source subgroup `M1`, formed in the abstract presentation. -/
@[expose] public def m1 : Subgroup Presentation :=
  Subgroup.closure {x, (y ^ 2)⁻¹ * x * y ^ 2, y ^ 2 * x * (y ^ 2)⁻¹}

/-- The restriction of the canonical presentation map to the source subgroup. -/
public def m1Map : m1 →* He := presentationMap.comp m1.subtype

/-- Evaluation of the restricted map in the original presentation. -/
@[simp] public theorem m1Map_apply (g : m1) : m1Map g = presentationMap g := by rfl

/-- The source point 1206, converted to Lean's zero-based numbering. -/
@[expose] public def point : Fin 2058 := 1205

/-- The full inverse image of the concrete point stabilizer. This is not
definitionally the source subgroup `m1`. -/
@[expose] public def pointStabilizer : Subgroup Presentation :=
  (MulAction.stabilizer He point).comap presentationMap

/-- The seven relators hold in the abstract presented group itself. -/
public theorem presentation_relations (i : Fin 7) : relationWord x y i = 1 := by
  have h := PresentedGroup.one_of_mem (rels := definingRelators)
    (show relationWord (FreeGroup.of 0) (FreeGroup.of 1) i ∈
      definingRelators from ⟨i, rfl⟩)
  rw [map_relationWord] at h
  exact h

/-- Transitivity gives the exact index of the full inverse-image stabilizer,
without any finiteness assumption on the abstract presentation. -/
public theorem pointStabilizer_index : pointStabilizer.index = 2058 := by
  rw [pointStabilizer, Subgroup.index_comap_of_surjective _ presentationMap_surjective,
    MulAction.index_stabilizer_of_transitive]
  exact Nat.card_fin 2058

/-- Each literal source generator fixes the marked point in the concrete model. -/
public theorem m1_le_pointStabilizer : m1 ≤ pointStabilizer := by
  rw [m1, Subgroup.closure_le]
  intro z hz
  rcases hz with rfl | hz
  · change representation (presentationMap (PresentedGroup.of 0)) point = point
    rw [presentationMap_of]
    change atlasA point = point
    decide +kernel
  rcases hz with rfl | hz
  · change representation (presentationMap ((y ^ 2)⁻¹ * x * y ^ 2)) point = point
    simp only [map_mul, map_pow, map_inv, x, y, presentationMap_of]
    change ((atlasB ^ 2)⁻¹ * atlasA * atlasB ^ 2) point = point
    decide +kernel
  rw [Set.mem_singleton_iff] at hz
  subst z
  change representation (presentationMap (y ^ 2 * x * (y ^ 2)⁻¹)) point = point
  simp only [map_mul, map_pow, map_inv, x, y, presentationMap_of]
  change (atlasB ^ 2 * atlasA * (atlasB ^ 2)⁻¹) point = point
  decide +kernel

end Held.CentralCovers.TwoPrimary.FaithfulPresentation
