module

public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.FaithfulPresentation.Setup
public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.FaithfulPresentation.M1Cosets.SchreierCertificate
public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.FaithfulPresentation.M1Cosets.TietzeTransfer
public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.FaithfulPresentation.M1Cosets.ReducedEnumeration

/-!
# A certified 2058-coset cover of the abstract Held presentation

The source subgroup M₁ is generated by `x`, `(y²)⁻¹*x*y²`, and
`y²*x*(y²)⁻¹`. All 14409 initial Schreier relations hold in the abstract
presentation. The checked Tietze transfer yields the 49 reduced relations,
and the residual enumeration places all 17 surviving symbols in M₁ from
membership of the three literal subgroup generators. The elimination
equations then recover membership of all 2062 Schreier symbols.

Their abstract edge identities give a cover by 2058 representatives, with
every transition justified by equality modulo M₁. All certificate premises
are discharged here; no finiteness or faithfulness assumption is needed.

Source: John Bray's ATLAS `HeG1-P1.M`, the definition and index claim for
`M1`, retained with attribution in `Held/Model/Source/`. Conjugation and
permutation paths use the source's right-action conventions. The source's
multiplier argument is not used. Certificate provenance and the checked
rewriting rules are documented in `M1Cosets/source/README.md` and
`M1Cosets/TietzeTransfer/source/README.md`.
-/

namespace Held.CentralCovers.TwoPrimary.FaithfulPresentation.M1Cosets

/-- Every Schreier symbol belongs to the literal source subgroup M₁. -/
public theorem schreier_symbol_mem (n : Fin 2062) : Schreier.symbol (n.val + 1) ∈ m1 := by
  apply TietzeTransfer.generators_mem_of_initial Schreier.symbol
    Schreier.initialRelator_eval m1 ?_ n
  exact Reduced.generators_mem_of_relators
    (TietzeTransfer.reduced_relators_of_initial Schreier.symbol Schreier.initialRelator_eval)
    ⟨Schreier.protected_mem 0, Schreier.protected_mem 1, Schreier.protected_mem 2⟩

/-- The unconditional 2058-representative cover in the abstract presentation. -/
public def cosetCover : Subgroup.GeneratorCosetCover m1 PresentedGroup.of (Fin 2058) :=
  Schreier.coverOfSymbolMem schreier_symbol_mem

end Held.CentralCovers.TwoPrimary.FaithfulPresentation.M1Cosets
