  (if i < 1024 then (if i < 512 then (if i < 256 then (if i < 128 then (if i < 64 then (if i < 32 then symbolEdge0 i else symbolEdge32 i) else (if i < 96 then symbolEdge64 i else symbolEdge96 i)) else (if i < 192 then (if i < 160 then symbolEdge128 i else symbolEdge160 i) else (if i < 224 then symbolEdge192 i else symbolEdge224 i))) else (if i < 384 then (if i < 320 then (if i < 288 then symbolEdge256 i else symbolEdge288 i) else (if i < 352 then symbolEdge320 i else symbolEdge352 i)) else (if i < 448 then (if i < 416 then symbolEdge384 i else symbolEdge416 i) else (if i < 480 then symbolEdge448 i else symbolEdge480 i)))) else (if i < 768 then (if i < 640 then (if i < 576 then (if i < 544 then symbolEdge512 i else symbolEdge544 i) else (if i < 608 then symbolEdge576 i else symbolEdge608 i)) else (if i < 704 then (if i < 672 then symbolEdge640 i else symbolEdge672 i) else (if i < 736 then symbolEdge704 i else symbolEdge736 i))) else (if i < 896 then (if i < 832 then (if i < 800 then symbolEdge768 i else symbolEdge800 i) else (if i < 864 then symbolEdge832 i else symbolEdge864 i)) else (if i < 960 then (if i < 928 then symbolEdge896 i else symbolEdge928 i) else (if i < 992 then symbolEdge960 i else symbolEdge992 i))))) else (if i < 1536 then (if i < 1280 then (if i < 1152 then (if i < 1088 then (if i < 1056 then symbolEdge1024 i else symbolEdge1056 i) else (if i < 1120 then symbolEdge1088 i else symbolEdge1120 i)) else (if i < 1216 then (if i < 1184 then symbolEdge1152 i else symbolEdge1184 i) else (if i < 1248 then symbolEdge1216 i else symbolEdge1248 i))) else (if i < 1408 then (if i < 1344 then (if i < 1312 then symbolEdge1280 i else symbolEdge1312 i) else (if i < 1376 then symbolEdge1344 i else symbolEdge1376 i)) else (if i < 1472 then (if i < 1440 then symbolEdge1408 i else symbolEdge1440 i) else (if i < 1504 then symbolEdge1472 i else symbolEdge1504 i)))) else (if i < 1792 then (if i < 1664 then (if i < 1600 then (if i < 1568 then symbolEdge1536 i else symbolEdge1568 i) else (if i < 1632 then symbolEdge1600 i else symbolEdge1632 i)) else (if i < 1728 then (if i < 1696 then symbolEdge1664 i else symbolEdge1696 i) else (if i < 1760 then symbolEdge1728 i else symbolEdge1760 i))) else (if i < 1920 then (if i < 1856 then (if i < 1824 then symbolEdge1792 i else symbolEdge1824 i) else (if i < 1888 then symbolEdge1856 i else symbolEdge1888 i)) else (if i < 1984 then (if i < 1952 then symbolEdge1920 i else symbolEdge1952 i) else (if i < 2016 then symbolEdge1984 i else (if i < 2048 then symbolEdge2016 i else symbolEdge2048 i)))))))

/-- The source right action; Held's stored permutations use the left action. -/
def destination (i : Fin 2058) (a : Letter (Fin 2)) : Fin 2058 :=
  if a.1 = 0 then atlasAFun i
  else if a.2 then atlasBInvFun i else atlasBFun i

/-- Positive edge word, omitting tree edges. -/
def positiveWord (i : Fin 2058) (a : Fin 2) : Word Nat :=
  let n := positiveIndex i.val a
  if n = 0 then [] else [(n, true)]

/-- Negative edges use the inverse of the corresponding positive edge. -/
def edgeWord (i : Fin 2058) (a : Letter (Fin 2)) : Word Nat :=
  if a.2 then positiveWord i a.1
  else FreeGroup.invRev (positiveWord (destination i a) a.1)

/-- Schreier rewriting along the candidate transition table. -/
def traceWord (i : Fin 2058) : Word (Fin 2) → Word Nat
  | [] => []
  | a :: w => edgeWord i a ++ traceWord (destination i a) w

/-- All initial relators, in the exact order of the retained discovery data. -/
def initialRelator (i : Fin 14409) : Word Nat :=
  if i.val < 14406 then
    reduce (traceWord (Fin.ofNat 2058 (i.val / 7)) (relatorWord (Fin.ofNat 7 i.val)))
  else
    reduce (traceWord 1205 (subgroupWord (Fin.ofNat 3 (i.val - 14406)))) ++
      [(i.val - 14405, false)]

/-- Interpret each symbol as an explicit word in the abstract two generators. -/
def symbolWord (n : Nat) : Word (Fin 2) :=
  if n = 0 then []
  else if n < 4 then subgroupWord (Fin.ofNat 3 (n - 1))
  else if n < 2063 then
    let e := symbolEdge (n - 4)
    representativeWord e.1.val ++ [(e.2, true)] ++
      FreeGroup.invRev (representativeWord (destination e.1 (e.2, true)).val)
  else []

def symbol (n : Nat) : Presentation := eval PresentedGroup.of (symbolWord n)

def representative (i : Fin 2058) : Presentation :=
  eval PresentedGroup.of (representativeWord i.val)

/-- The three protected symbols are exactly the literal M₁ words. -/
theorem protected_mem (i : Fin 3) : symbol (i.val + 1) ∈ m1 := by
  fin_cases i
  · exact subgroupWord_mem 0
  · exact subgroupWord_mem 1
  · exact subgroupWord_mem 2

end Held.CentralCovers.TwoPrimary.FaithfulPresentation.M1Cosets.Schreier
