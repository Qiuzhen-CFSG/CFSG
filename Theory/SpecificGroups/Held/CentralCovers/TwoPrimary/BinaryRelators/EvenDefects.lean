module

public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.BinaryRelators.Normalization
public import Theory.GroupTheory.PerfectTriangle
public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.BinaryRelators.EvenDefects.CubicTriangle
public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.BinaryRelators.EvenDefects.Comparison
public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.BinaryRelators.EvenDefects.Elimination

/-!
# Exact even relators for normalized Held lifts

The checked Schreier-word comparison gives `r0 = r5`. Two further checked
central-tail constraints give `r0 * r6 = r0 * r5 * r6 = 1`, so `r5 = 1` and
then `r0 = 1`. This proves the square and sixth-power relators directly from
the normalized source words, without identifying their presentation. The first
central constraint also gives the final-word relation `r6 = 1`.

The normalized relations imply that the subgroup generated by the two lifts is
perfect: their orders divide four and seven, while their product has order
dividing seventeen. In an abelian image, the product also has order dividing
twenty-eight, so both generators become trivial by coprimality.

The supporting perfectness result and the word calculations require neither a
generation assumption on the ambient group nor its finiteness or perfectness.
The final theorem retains the finite perfect ambient contract of its consumer.

Source: the literal relators of John Bray's ATLAS `HeG1-P1.M`, retained in
`Theory/SpecificGroups/Held/Model/Source/`, and the elementary abelianization
argument in `Theory.GroupTheory.PerfectTriangle`. No identification of the
presentation or multiplier statement is used.
-/

namespace Held.CentralCovers.TwoPrimary.BinaryRelators

/-- Normalized lifts generate a perfect subgroup in any ambient group. -/
public theorem normalized_generated_isPerfect {E : Type*} [Group E]
    {z x y : E} (h : Normalized z x y) :
    Group.IsPerfect (Subgroup.closure ({x, y} : Set E)) := by
  have hx : x ^ 4 = 1 := by
    rw [show 4 = 2 * 2 from rfl, pow_mul]
    rcases h.defects 0 with hx | hx
    · change x ^ 2 = 1 at hx
      rw [hx, one_pow]
    · change x ^ 2 = z at hx
      rw [hx, h.square]
  exact Group.isPerfect_closure_pair_of_coprime_triangle x y
    (m := 4) (n := 7) (k := 17) (by decide) (by decide)
    hx h.seventh h.seventeenth

/-- Both even-power defects in the normalized ATLAS relators vanish. -/
public theorem even_defects (E : Type*) [Group E] [Finite E] [Group.IsPerfect E]
    (z x y : E) (h : Normalized z x y) :
    relationWord x y 0 = 1 ∧ relationWord x y 5 = 1 := by
  have h5 := EvenDefects.sixth_defect_eq_one z x y h
  exact ⟨(EvenDefects.square_eq_sixth_defect z x y h).trans h5, h5⟩

/-- The same checked central constraint also eliminates the final-word defect. -/
public theorem EvenDefects.final_defect_eq_one {E : Type*} [Group E] (z x y : E)
    (h : Normalized z x y) : relationWord x y 6 = 1 := by
  have ht : relationWord x y 0 * relationWord x y 6 = 1 := by
    simpa [EvenDefects.Comparison.tails, EvenDefects.Comparison.tailCenter,
      EvenDefects.Comparison.maskBit, EvenDefects.Comparison.centralDefect] using
      EvenDefects.Elimination.Certificate.tail_nine h
  rw [EvenDefects.square_eq_sixth_defect z x y h,
    EvenDefects.sixth_defect_eq_one z x y h, one_mul] at ht
  exact ht

end Held.CentralCovers.TwoPrimary.BinaryRelators
