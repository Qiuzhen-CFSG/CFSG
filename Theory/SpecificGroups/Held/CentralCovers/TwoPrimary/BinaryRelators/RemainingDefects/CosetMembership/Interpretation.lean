module

public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.BinaryRelators.Normalization
public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.BinaryRelators.RemainingDefects.Centralizer
public import Theory.SpecificGroups.Held.CentralCovers.TwoPrimary.BinaryRelators.RemainingDefects.CosetMembership.Rules
import Theory.GroupTheory.CosetEnumeration
import Mathlib.Tactic.Group
import Mathlib.Tactic.FinCases

/-!+# Interpreting the certificate in actual right cosets

The points of the word-action system are equivalence classes for
`a = h*b`, with `h` in the subgroup generated by the nine seeds and `z`.
Right multiplication is well-defined on these classes. Each relator acts
trivially because all its conjugates belong to that subgroup, by
`relator_conjugate_mem_span`. No normality of the seed subgroup is assumed.

Literal word evaluation is compared here with every relator and every seed
from John Bray's ATLAS `HeG1-P1.M` and `RemainingDefects.Centralizer`.
-/

namespace Held.CentralCovers.TwoPrimary.BinaryRelators.RemainingDefects.CosetMembership
open Theory.GroupTheory.CosetEnumeration (Related)
universe u
variable {E : Type u} [Group E]

private def value (x y : E) : Fin 4 → E
  | 0 => x
  | 1 => x⁻¹
  | 2 => y
  | _ => y⁻¹

private def eval (x y : E) (w : Word) : E := (w.map (value x y)).prod

private theorem eval_relator (x y : E) (r : Fin 7) :
    eval x y (relator r) = Held.relationWord x y r := by
  fin_cases r <;> dsimp [relator, eval, value, Held.relationWord] <;>
    simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, value,
      pow_succ, pow_zero, mul_inv_rev, inv_inv, mul_one, one_mul, mul_assoc]

private theorem eval_seed (x y : E) (r : Fin 9) :
    eval x y (seed r) = centralizerSeed x y r := by
  fin_cases r <;> dsimp [seed, eval, value, centralizerSeed, centralizerWord] <;>
    simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, value,
      pow_succ, pow_zero, mul_inv_rev, inv_inv, mul_one, one_mul, mul_assoc]

private theorem eval_target (x y : E) :
    eval x y target = centralizerWord x y := by
  dsimp [target, eval, value, centralizerWord]
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, value,
      pow_succ, pow_zero, mul_inv_rev, mul_one, one_mul, mul_assoc]

private def cosets (H : Subgroup E) : Setoid E where
  r := Related H
  iseqv := ⟨Related.refl H, Related.symm, Related.trans⟩

private def cosetStep (x y : E) (H : Subgroup E) :
    Quotient (cosets H) → Fin 4 → Quotient (cosets H) := fun q c =>
  Quotient.map (fun a => a * value x y c)
    (fun _ _ h => Related.mul_right (H := H) h _) q

private theorem coset_walk (x y : E) (H : Subgroup E) (a : E) (w : Word) :
    walk (cosetStep x y H) (Quotient.mk (cosets H) a) w =
      Quotient.mk (cosets H) (a * eval x y w) := by
  induction w generalizing a with
  | nil => simp [walk, eval]
  | cons c w ih =>
    change walk (cosetStep x y H) (Quotient.mk (cosets H) (a * value x y c)) w = _
    rw [ih]
    simp only [eval, List.map_cons, List.prod_cons, mul_assoc]

private def cosetSystem (z x y : E) (h : Normalized z x y) :
    System (Quotient (cosets (centralizerSpan z x y))) where
  step := cosetStep x y (centralizerSpan z x y)
  undo := by
    intro q c
    induction q using Quotient.inductionOn with
    | h a =>
      change Quotient.mk _ ((a * value x y c) * value x y (flip c)) = Quotient.mk _ a
      congr 1
      fin_cases c <;> simp [value, flip, mul_assoc]
  origin := Quotient.mk _ 1
  relators := by
    intro r q
    induction q using Quotient.inductionOn with
    | h a =>
      rw [coset_walk, eval_relator]
      apply Quotient.sound
      exact ⟨a * Held.relationWord x y r * a⁻¹,
        relator_conjugate_mem_span z x y h a r, by simp [mul_assoc]⟩
  seeds := by
    intro r
    rw [coset_walk, eval_seed, one_mul]
    apply Quotient.sound
    exact ⟨centralizerSeed x y r, Subgroup.subset_closure (Or.inl ⟨r, rfl⟩),
      (mul_one _).symm⟩

/-- A universally checked word-action certificate proves membership in the
actual subgroup, including when the relators have central binary defects. -/
public theorem membership_of_action (z x y : E) (h : Normalized z x y)
    (certificate : ∀ (C : Type u) (s : System C),
      walk s.step s.origin target = s.origin) :
    centralizerWord x y ∈ centralizerSpan z x y := by
  have he := certificate _ (cosetSystem z x y h)
  change walk (cosetStep x y (centralizerSpan z x y)) (Quotient.mk _ 1) target =
    Quotient.mk _ 1 at he
  rw [coset_walk, eval_target, one_mul] at he
  obtain ⟨a, ha, heq⟩ := Quotient.exact he
  have ht : centralizerWord x y = a := by simpa only [mul_one] using heq
  exact ht.symm ▸ ha

end Held.CentralCovers.TwoPrimary.BinaryRelators.RemainingDefects.CosetMembership
