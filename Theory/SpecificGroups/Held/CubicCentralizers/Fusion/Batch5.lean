module
public import Theory.SpecificGroups.Held.CubicCentralizers.Base
import Mathlib.Tactic.FinCases
/-! Checked inner conjugators for normal forms 26–26 in the
literal Sylow-three subgroup. Every table is proved equal to a word in the
Held generators. Source: ATLAS HeG1-p2058B0; Aschbacher–Smith 2.4.25, p.543. -/
public section
namespace Held.CubicCentralizers
open OddCubeCandidates.CardinalityCertificates
set_option Elab.async false
set_option maxRecDepth 16384
private def f26Map (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f26InvMap (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f26Perm : Equiv.Perm (Fin 2058) where
  toFun := f26Map
  invFun := f26InvMap
  left_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
  right_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
private def f26Word {G : Type*} [Group G] (a b : G) : G := b * a * (b ^ (-2 : ℤ)) * a * (b ^ (2 : ℤ)) * a * (b ^ (-2 : ℤ)) * a * (b ^ (3 : ℤ)) * a⁻¹ * (b ^ (-2 : ℤ)) * a⁻¹ * b * a⁻¹ * (b ^ (-2 : ℤ)) * a * b * a * b⁻¹ * a * (b ^ (2 : ℤ)) * a * (b ^ (3 : ℤ)) * a * (b ^ (2 : ℤ)) * a * b * a * b⁻¹ * a * (b ^ (-2 : ℤ)) * a * (b ^ (-2 : ℤ)) * a⁻¹ * b * a⁻¹ * (b ^ (3 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a
private theorem f26Perm_eq : f26Perm = f26Word fastA fastB := by
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
private def f26 : He := f26Word a b
private theorem f26_representation : representation f26 = f26Perm := by
  have ha : representation a = atlasA := rfl
  have hb : representation b = atlasB := rfl
  simp only [f26,f26Word,map_mul,map_inv,map_zpow,ha,hb]
  rw [←fastA_eq,←fastB_eq]
  exact f26Perm_eq.symm
theorem fusion26 : IsConj z (normalForm 26) := by
  apply isConj_iff.mpr
  refine ⟨f26,?_⟩
  apply representation_injective
  simp only [map_mul,map_inv,map_pow,f26_representation,normalForm,
    representation_x,representation_y,representation_z]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel

end Held.CubicCentralizers
