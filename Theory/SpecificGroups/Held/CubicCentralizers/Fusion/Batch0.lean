module
public import Theory.SpecificGroups.Held.CubicCentralizers.Base
import Mathlib.Tactic.FinCases
/-! Checked inner conjugators for normal forms 1–5 in the
literal Sylow-three subgroup. Every table is proved equal to a word in the
Held generators. Source: ATLAS HeG1-p2058B0; Aschbacher–Smith 2.4.25, p.543. -/
public section
namespace Held.CubicCentralizers
open OddCubeCandidates.CardinalityCertificates
set_option Elab.async false
set_option maxRecDepth 16384
theorem fusion1 : IsConj x (normalForm 1) := by
  have h : normalForm 1 = x := by
    norm_num [normalForm]
  rw [h]
private def f2Map (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f2InvMap (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f2Perm : Equiv.Perm (Fin 2058) where
  toFun := f2Map
  invFun := f2InvMap
  left_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
  right_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
private def f2Word {G : Type*} [Group G] (a b : G) : G := (b ^ (-3 : ℤ)) * a⁻¹ * (b ^ (3 : ℤ)) * a⁻¹ * (b ^ (2 : ℤ)) * a * b * a * (b ^ (-3 : ℤ)) * a * (b ^ (3 : ℤ)) * a * (b ^ (3 : ℤ)) * a * (b ^ (2 : ℤ)) * a * b * a * (b ^ (-2 : ℤ)) * a * b⁻¹ * a * b * a * b⁻¹ * a * b * a * (b ^ (2 : ℤ)) * a * (b ^ (-2 : ℤ)) * a⁻¹ * b * a⁻¹ * b⁻¹ * a⁻¹ * b * a
private theorem f2Perm_eq : f2Perm = f2Word fastA fastB := by
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
private def f2 : He := f2Word a b
private theorem f2_representation : representation f2 = f2Perm := by
  have ha : representation a = atlasA := rfl
  have hb : representation b = atlasB := rfl
  simp only [f2,f2Word,map_mul,map_inv,map_zpow,ha,hb]
  rw [←fastA_eq,←fastB_eq]
  exact f2Perm_eq.symm
theorem fusion2 : IsConj x (normalForm 2) := by
  apply isConj_iff.mpr
  refine ⟨f2,?_⟩
  apply representation_injective
  simp only [map_mul,map_inv,map_pow,f2_representation,normalForm,
    representation_x,representation_y,representation_z]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel

