module
public import Theory.SpecificGroups.Held.CubicCentralizers.Base
import Mathlib.Tactic.FinCases
/-! Checked inner conjugators for normal forms 6–10 in the
literal Sylow-three subgroup. Every table is proved equal to a word in the
Held generators. Source: ATLAS HeG1-p2058B0; Aschbacher–Smith 2.4.25, p.543. -/
public section
namespace Held.CubicCentralizers
open OddCubeCandidates.CardinalityCertificates
set_option Elab.async false
set_option maxRecDepth 16384
private def f6Map (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f6InvMap (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f6Perm : Equiv.Perm (Fin 2058) where
  toFun := f6Map
  invFun := f6InvMap
  left_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
  right_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
private def f6Word {G : Type*} [Group G] (a b : G) : G := (b ^ (-2 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * (b ^ (-3 : ℤ)) * a⁻¹ * b * a⁻¹ * b⁻¹ * a⁻¹ * (b ^ (3 : ℤ)) * a⁻¹ * (b ^ (2 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * b⁻¹ * a⁻¹ * (b ^ (2 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * (b ^ (-3 : ℤ)) * a⁻¹ * (b ^ (-3 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹
private theorem f6Perm_eq : f6Perm = f6Word fastA fastB := by
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
private def f6 : He := f6Word a b
private theorem f6_representation : representation f6 = f6Perm := by
  have ha : representation a = atlasA := rfl
  have hb : representation b = atlasB := rfl
  simp only [f6,f6Word,map_mul,map_inv,map_zpow,ha,hb]
  rw [←fastA_eq,←fastB_eq]
  exact f6Perm_eq.symm
theorem fusion6 : IsConj x (normalForm 6) := by
  apply isConj_iff.mpr
  refine ⟨f6,?_⟩
  apply representation_injective
  simp only [map_mul,map_inv,map_pow,f6_representation,normalForm,
    representation_x,representation_y,representation_z]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel

