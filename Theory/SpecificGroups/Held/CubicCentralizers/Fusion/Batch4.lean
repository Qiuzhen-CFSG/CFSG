public section
namespace Held.CubicCentralizers
open OddCubeCandidates.CardinalityCertificates
set_option Elab.async false
set_option maxRecDepth 16384
private def f21Map (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f21InvMap (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f21Perm : Equiv.Perm (Fin 2058) where
  toFun := f21Map
  invFun := f21InvMap
  left_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
  right_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
private def f21Word {G : Type*} [Group G] (a b : G) : G := (b ^ (-2 : ℤ)) * a⁻¹ * (b ^ (2 : ℤ)) * a⁻¹ * (b ^ (-2 : ℤ)) * a⁻¹ * (b ^ (2 : ℤ)) * a⁻¹ * (b ^ (-2 : ℤ)) * a * (b ^ (3 : ℤ)) * a * (b ^ (2 : ℤ)) * a * b * a * b⁻¹ * a * (b ^ (-2 : ℤ)) * a * (b ^ (-2 : ℤ)) * a⁻¹ * b * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * (b ^ (-2 : ℤ)) * a⁻¹ * (b ^ (2 : ℤ)) * a * b * a * (b ^ (-2 : ℤ)) * a * b * a * b⁻¹ * a * (b ^ (2 : ℤ)) * a * (b ^ (-3 : ℤ)) * a⁻¹ * (b ^ (-4 : ℤ)) * a⁻¹ * b⁻¹ * (a ^ (-2 : ℤ)) * (b ^ (2 : ℤ)) * a * b * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * (a ^ (-2 : ℤ)) * b⁻¹ * a⁻¹ * b * a * (b ^ (-3 : ℤ)) * a⁻¹ * (b ^ (-4 : ℤ)) * a⁻¹ * b⁻¹ * (a ^ (-2 : ℤ)) * (b ^ (-2 : ℤ)) * a⁻¹ * b * a⁻¹ * (b ^ (-4 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * (a ^ (-3 : ℤ)) * (b ^ (2 : ℤ)) * a * b * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a * b * a * b⁻¹ * a * (b ^ (3 : ℤ)) * a * (b ^ (-2 : ℤ)) * a⁻¹
private theorem f21Perm_eq : f21Perm = f21Word fastA fastB := by
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
private def f21 : He := f21Word a b
private theorem f21_representation : representation f21 = f21Perm := by
  have ha : representation a = atlasA := rfl
  have hb : representation b = atlasB := rfl
  simp only [f21,f21Word,map_mul,map_inv,map_zpow,ha,hb]
  rw [←fastA_eq,←fastB_eq]
  exact f21Perm_eq.symm
theorem fusion21 : IsConj x (normalForm 21) := by
  apply isConj_iff.mpr
  refine ⟨f21,?_⟩
  apply representation_injective
  simp only [map_mul,map_inv,map_pow,f21_representation,normalForm,
    representation_x,representation_y,representation_z]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel

