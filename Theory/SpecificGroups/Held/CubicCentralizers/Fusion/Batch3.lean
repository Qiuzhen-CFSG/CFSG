module
public import Theory.SpecificGroups.Held.CubicCentralizers.Base
import Mathlib.Tactic.FinCases
/-! Checked inner conjugators for normal forms 16–20 in the
literal Sylow-three subgroup. Every table is proved equal to a word in the
Held generators. Source: ATLAS HeG1-p2058B0; Aschbacher–Smith 2.4.25, p.543. -/
public section
namespace Held.CubicCentralizers
open OddCubeCandidates.CardinalityCertificates
set_option Elab.async false
set_option maxRecDepth 16384
private def f16Map (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f16InvMap (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def f16Perm : Equiv.Perm (Fin 2058) where
  toFun := f16Map
  invFun := f16InvMap
  left_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
  right_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
private def f16Word {G : Type*} [Group G] (a b : G) : G := b * a * b * a * (b ^ (3 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * b⁻¹ * a * b * a * b⁻¹ * a * (b ^ (-2 : ℤ)) * a * b⁻¹ * a * (b ^ (-3 : ℤ)) * a⁻¹ * (b ^ (2 : ℤ)) * a⁻¹ * b * a⁻¹ * (b ^ (-3 : ℤ)) * a⁻¹ * b * a⁻¹ * (b ^ (3 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b * a * (b ^ (-3 : ℤ)) * a⁻¹ * (b ^ (-4 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * (b ^ (-2 : ℤ)) * a⁻¹ * b * a⁻¹ * (b ^ (-4 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * (a ^ (-3 : ℤ)) * (b ^ (2 : ℤ)) * a * b * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * (a ^ (-2 : ℤ)) * (b ^ (-2 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹
private theorem f16Perm_eq : f16Perm = f16Word fastA fastB := by
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
private def f16 : He := f16Word a b
private theorem f16_representation : representation f16 = f16Perm := by
  have ha : representation a = atlasA := rfl
  have hb : representation b = atlasB := rfl
  simp only [f16,f16Word,map_mul,map_inv,map_zpow,ha,hb]
  rw [←fastA_eq,←fastB_eq]
  exact f16Perm_eq.symm
theorem fusion16 : IsConj z (normalForm 16) := by
  apply isConj_iff.mpr
  refine ⟨f16,?_⟩
  apply representation_injective
  simp only [map_mul,map_inv,map_pow,f16_representation,normalForm,
    representation_x,representation_y,representation_z]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel

