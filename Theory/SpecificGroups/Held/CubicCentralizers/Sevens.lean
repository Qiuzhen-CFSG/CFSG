module
public import Theory.SpecificGroups.Held.CubicCentralizers.Base
import Mathlib.Tactic.FinCases
/-! Native order-seven words centralize each of the two cubic seeds.
Packed permutation tables are compared to words in the actual Held generators;
orders and commuting identities are checked pointwise by the kernel.
Source: ATLAS HeG1-p2058B0; Aschbacher–Smith 2.4.25, p.543. -/
public section
namespace Held.CubicCentralizers
open OddCubeCandidates.CardinalityCertificates
local instance : Fact (Nat.Prime 7) := ⟨by decide⟩
set_option Elab.async false
set_option maxRecDepth 16384
private def seven0Map (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def seven0InvMap (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12*i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩
private def seven0Perm : Equiv.Perm (Fin 2058) where
  toFun := seven0Map
  invFun := seven0InvMap
  left_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
  right_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
private def seven0Word {G : Type*} [Group G] (a b : G) : G := (b ^ (3 : ℤ)) * a * b * a * b * a * (b ^ (3 : ℤ)) * a * (b ^ (-2 : ℤ)) * a * (b ^ (2 : ℤ)) * (a ^ (2 : ℤ)) * b * a * b * a * b⁻¹ * a⁻¹ * (b ^ (-2 : ℤ)) * a * b⁻¹ * a * (b ^ (-2 : ℤ)) * a * (b ^ (3 : ℤ)) * a * (b ^ (-2 : ℤ)) * a * b * a * b⁻¹ * a * (b ^ (-2 : ℤ)) * a⁻¹ * b * a⁻¹ * b⁻¹ * a⁻¹ * (b ^ (2 : ℤ)) * a * b * a * (b ^ (-3 : ℤ)) * a * b⁻¹ * a * (b ^ (2 : ℤ))
private theorem seven0Perm_eq : seven0Perm = seven0Word fastA fastB := by
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
private def seven0 : He := seven0Word a b
private theorem seven0_representation : representation seven0 = seven0Perm := by
  have ha : representation a = atlasA := rfl
  have hb : representation b = atlasB := rfl
  simp only [seven0,seven0Word,map_mul,map_inv,map_zpow,ha,hb]
  rw [←fastA_eq,←fastB_eq]
  exact seven0Perm_eq.symm
private theorem seven0_pow : seven0^7=1 := by
  apply representation_injective
  rw [map_pow,map_one,seven0_representation]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
private theorem seven0_ne : seven0 ≠ 1 := by
  intro h
  have hp := congrArg (fun g : He => representation g 0) h
  rw [seven0_representation,map_one] at hp
  have hn : seven0Perm 0 ≠ 0 := by decide +kernel
  exact hn hp
private theorem seven0_commute : Commute seven0 x := by
  apply representation_injective
  simp only [map_mul,seven0_representation,representation_x]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
theorem exists_seven_centralizing_x : ∃ g : He, orderOf g = 7 ∧ Commute g x :=
  ⟨seven0,orderOf_eq_prime seven0_pow seven0_ne,seven0_commute⟩

private def seven1Map (i : Fin 2058) : Fin 2058 :=
