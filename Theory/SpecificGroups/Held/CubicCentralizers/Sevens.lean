private def seven1Perm : Equiv.Perm (Fin 2058) where
  toFun := seven1Map
  invFun := seven1InvMap
  left_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
  right_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
private def seven1Word {G : Type*} [Group G] (a b : G) : G := b * a * b * a * (b ^ (3 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * (b ^ (-3 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * (b ^ (-3 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b⁻¹ * a⁻¹ * b * a⁻¹ * (b ^ (-2 : ℤ)) * a⁻¹ * b * a⁻¹ * b⁻¹ * a⁻¹ * (b ^ (-3 : ℤ)) * a⁻¹ * (b ^ (2 : ℤ)) * a⁻¹ * (b ^ (-3 : ℤ)) * a⁻¹ * (b ^ (-2 : ℤ)) * a⁻¹ * b⁻¹ * a⁻¹ * (b ^ (-2 : ℤ)) * a⁻¹
private theorem seven1Perm_eq : seven1Perm = seven1Word fastA fastB := by
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
private def seven1 : He := seven1Word a b
private theorem seven1_representation : representation seven1 = seven1Perm := by
  have ha : representation a = atlasA := rfl
  have hb : representation b = atlasB := rfl
  simp only [seven1,seven1Word,map_mul,map_inv,map_zpow,ha,hb]
  rw [←fastA_eq,←fastB_eq]
  exact seven1Perm_eq.symm
private theorem seven1_pow : seven1^7=1 := by
  apply representation_injective
  rw [map_pow,map_one,seven1_representation]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
private theorem seven1_ne : seven1 ≠ 1 := by
  intro h
  have hp := congrArg (fun g : He => representation g 0) h
  rw [seven1_representation,map_one] at hp
  have hn : seven1Perm 0 ≠ 0 := by decide +kernel
  exact hn hp
private theorem seven1_commute : Commute seven1 z := by
  apply representation_injective
  simp only [map_mul,seven1_representation,representation_z]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel
theorem exists_seven_centralizing_z : ∃ g : He, orderOf g = 7 ∧ Commute g z :=
  ⟨seven1,orderOf_eq_prime seven1_pow seven1_ne,seven1_commute⟩

end Held.CubicCentralizers
