theorem fastLocalThree_eq : fastLocalThree =
    ((atlasA * atlasB ^ 5) * (atlasA * atlasB ^ 3)) *
      ((atlasA * atlasB ^ 4) * (atlasA * atlasB ^ 6)) := by
  rw [← fastA_eq, ← fastB_eq]
  apply Equiv.ext
  apply allPoints
  intro q
  fin_cases q <;> apply allFin <;> decide +kernel

