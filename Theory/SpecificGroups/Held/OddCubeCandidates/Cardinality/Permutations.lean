private def threeDecode (i : Fin 2058) : ℕ :=
  ( >>> (5 * i.val)) % 32

private theorem three_decode : ∀ i j k : Fin 3,
    threeDecode ((threeX ^ i.val * threeY ^ j.val * threeZ ^ k.val) 0) =
      i.val + 3 * j.val + 9 * k.val := by
  apply allFin
  decide +kernel

theorem three_normalForm_injective : Function.Injective
    (fun t : Fin 3 × Fin 3 × Fin 3 =>
      threeX ^ t.1.val * threeY ^ t.2.1.val * threeZ ^ t.2.2.val) := by
  rintro ⟨i, j, k⟩ ⟨i', j', k'⟩ h
  have he := congrArg (fun g : Equiv.Perm (Fin 2058) => threeDecode (g 0)) h
  change threeDecode ((threeX ^ i.val * threeY ^ j.val * threeZ ^ k.val) 0) =
    threeDecode ((threeX ^ i'.val * threeY ^ j'.val * threeZ ^ k'.val) 0) at he
  rw [three_decode, three_decode] at he
  have hi : i = i' := Fin.ext (by omega)
  have hj : j = j' := Fin.ext (by omega)
  have hk : k = k' := Fin.ext (by omega)
  simp only [hi, hj, hk]

