/-!
# Concrete permutation certificates for Held's two odd subgroups

Compact lookup tables represent exactly the already defined generators.
Equality to those words, all group relations, and a left inverse to the
normal-form action on point zero are checked by Lean's kernel. The tables
are only a computational implementation of the original degree-2058 action.
No ambient group order or identification theorem is used.

Source: GLS3 Table 5.3p; the original ATLAS HeG1-p2058B0 cycles retained in
Held/Model/Source, and the discovery words in OddCubeCandidates/source.
Run Cardinality/source/generate.py from the repository root to reproduce
this file. The correction is z = y⁻¹*x⁻¹*y*x, so y*x = x*y*z;
this is the inverse of GAP's commutator used in the discovery transcript.
-/

@[expose] public section
namespace Held.OddCubeCandidates.CardinalityCertificates

set_option maxRecDepth 4096

def checkFin {n : ℕ} (f : Fin n → Bool) : Bool :=
  (List.range n).all (fun i => if h : i < n then f ⟨i, h⟩ else true)

theorem allFin {n : ℕ} (P : Fin n → Prop) [DecidablePred P]
    (h : checkFin (fun i => decide (P i)) = true) : ∀ i, P i := by
  intro i
  have hi := List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt)
  simpa only [dif_pos i.isLt, decide_eq_true_eq] using hi

theorem allPoints (P : Fin 2058 → Prop)
    (h : ∀ q : Fin 17, ∀ r : Fin 128,
      P ⟨(q.val * 128 + r.val) % 2058, Nat.mod_lt _ (by decide)⟩) : ∀ i, P i := by
  intro i
  have hi := h ⟨i.val / 128, by omega⟩ ⟨i.val % 128, Nat.mod_lt _ (by decide)⟩
  have he : i.val / 128 * 128 + i.val % 128 = i.val := by omega
  simpa only [he, Nat.mod_eq_of_lt i.isLt] using hi

def fastAMap (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

def fastAInvMap (i : Fin 2058) : Fin 2058 :=
  ⟨( >>> (12 * i.val)) % 4096 % 2058, Nat.mod_lt _ (by decide)⟩

def fastA : Equiv.Perm (Fin 2058) where
  toFun := fastAMap
  invFun := fastAInvMap
  left_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel
  right_inv := by
    apply allPoints
    intro q
    fin_cases q <;> apply allFin <;> decide +kernel

