module

public import Theory.SpecificGroups.Suzuki.SchurEightCover.AtlasModel
public import Theory.SpecificGroups.Suzuki.SchurCoverReduction
public import Theory.GroupTheory.PerfectCentralCoverKernelLowerBound

/-!+# A finite fourfold perfect central cover of Sz(8)

The group `E` is the subgroup of `Sym(Fin 2080)` generated by the two
checked ATLAS permutations. Their relations prove perfectness, and two
explicit central involutions generate a subgroup of order four. The block
action has exactly this kernel. Its marked matrix comparison identifies
the quotient with the literal `SuzukiMatrixGroup 1`, giving `cover`.

The universal projection therefore has kernel order divisible by four.
This supplies the lower bound in Aschbacher--Smith I.1.3(5), printed p.407
(PDF p.418 of `refs/quasithin.pdf`), and GLS3 section 6.1, Table 6.1.3.
The separate upper bound is needed to certify universality. In particular,
`cover` and `cover_kernel_card` discharge the fourfold-cover premises of
the Chapter I Suzuki theorem `exceptional_conclusions_of_rootLift`.

The construction and its original numerical attribution are retained in
`SchurEightCover/AtlasModel/source/README.md`. No group-family label or
externally asserted group order enters the proof.
-/

@[expose] public section
namespace BenderSuzuki.MatrixGroups.SchurEightCover

/-- The actual degree-2080 permutation subgroup, with inherited group and
finiteness instances. -/
abbrev E : Type := AtlasModel.E

/-- Perfectness follows from the checked relations on the two generators. -/
theorem isPerfect : Group.IsPerfect E := inferInstance

/-- The checked quotient and matrix comparison give a cover of native Sz(8). -/
noncomputable def cover : PerfectCentralCovering.Cover E (SuzukiMatrixGroup 1) :=
  AtlasModel.cover

/-- The projection is the original quotient map followed by the native comparison. -/
theorem cover_toMonoidHom :
    cover.toMonoidHom = AtlasModel.quotientEquiv.toMonoidHom.comp
      (QuotientGroup.mk' AtlasModel.kernel) :=
  AtlasModel.cover_toMonoidHom

theorem cover_apply (x : E) :
    cover.toMonoidHom x = AtlasModel.quotientEquiv (QuotientGroup.mk x) :=
  AtlasModel.cover_apply x

/-- The same projection retains the literal block action and its matrix image. -/
theorem cover_apply_eq_matrix_action (x : E) :
    cover.toMonoidHom x =
      AtlasModel.MatrixComparison.equiv (AtlasModel.BlockComparison.action x) :=
  AtlasModel.cover_apply_eq_matrix_action x

theorem cover_surjective : Function.Surjective cover.toMonoidHom :=
  AtlasModel.cover_surjective

theorem cover_ker_le_center : cover.toMonoidHom.ker ≤ Subgroup.center E :=
  AtlasModel.cover_ker_le_center

/-- The kernel is precisely the subgroup generated by the two central involutions. -/
theorem cover_kernel : cover.toMonoidHom.ker = AtlasModel.kernel :=
  AtlasModel.cover_kernel

theorem cover_kernel_card : Nat.card cover.toMonoidHom.ker = 4 :=
  AtlasModel.cover_kernel_card

/-- The universal lift onto the constructed cover surjects on kernels. -/
theorem four_dvd_universalKernel_card : 4 ∣ Nat.card (SchurCover.Kernel 1) := by
  let := SchurCover.isPerfect 1 (by decide)
  simpa only [cover_kernel_card] using cover.kernel_card_dvd_universal

/-- The concrete cover supplies the exceptional multiplier's lower bound. -/
theorem four_le_universalKernel_card : 4 ≤ Nat.card (SchurCover.Kernel 1) :=
  Nat.le_of_dvd Nat.card_pos four_dvd_universalKernel_card

end BenderSuzuki.MatrixGroups.SchurEightCover
