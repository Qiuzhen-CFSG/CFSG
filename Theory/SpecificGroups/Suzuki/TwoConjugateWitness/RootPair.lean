/-!
# Two opposite elementary subgroups in a Suzuki group

A nontrivial root involution and the standard Weyl involution have an odd-order
product: an even product would have a central involution, contradicting the
root centralizer bound. Taking a square root in that odd cyclic group puts the
Weyl involution inside the subgroup generated by the original elementary
subgroup and its Weyl conjugate.

If the elementary subgroup has order greater than two, solvable containment
excludes that generated subgroup. A Borel containing it is pinned down by its
root involution, while every elementary subgroup of a torus normalizer has
order at most two. Nonsolvable Suzuki subgroup recognition then identifies
the actual generated subgroup, including divisibility of its field degree.

Source: Aschbacher--Smith, E.2.7, printed p.218, Bender-group paragraph;
Huppert--Blackburn III, XI.3.12(e) and XI.11.15.
-/

public section
noncomputable section
namespace BenderSuzuki.MatrixGroups
open Subgroup PFAppendixIII

private theorem weyl_not_borel (m : ℕ) (hm : 0 < m) :
    suzukiWeyl m ∉ SuzukiBorelSubgroup m := by
  intro h
  have he : suzukiWeyl m • suzukiOvoidInfinity m = suzukiOvoidInfinity m := by
    simpa only [suzukiBorelSubgroup_eq_stabilizer m hm, MulAction.mem_stabilizer_iff] using h
  rw [suzukiWeyl_smul_infinity] at he
  exact suzukiOvoidInfinity_ne_zero m he.symm

private theorem root_mul_weyl_odd {m : ℕ} (hm : 0 < m)
    {u : SuzukiMatrixGroup m} (hu : u ∈ SuzukiRootSubgroup m)
    (hi : IsInvolution u) : Odd (orderOf (u * suzukiWeyl m)) := by
  have hw : IsInvolution (suzukiWeyl m) :=
    ⟨suzukiWeyl_ne_one m, by simpa only [pow_two] using suzukiWeyl_sq m⟩
  have hne : u ≠ suzukiWeyl m := by
    intro he
    apply weyl_not_borel m hm
    rw [← he, suzukiBorelSubgroup_eq_sup]
    exact (show SuzukiRootSubgroup m ≤ SuzukiRootSubgroup m ⊔ SuzukiSplitTorus m from le_sup_left) hu
  rw [← Nat.not_even_iff_odd]
  rintro ⟨k, hk⟩
  obtain ⟨hz, hzu, hzw⟩ := External.Suzuki.V.suzuki_ch5_proposition_1_2_iii
    hi hw hne (show orderOf (u * suzukiWeyl m) = 2 * k by omega)
  have hzR := suzukiRootSubgroup_centralizer_le m hm hu hi.ne_one
    (mem_centralizer_singleton_iff.mpr hzu.eq)
  have hwR := suzukiRootSubgroup_centralizer_le m hm hzR hz.ne_one
    (mem_centralizer_singleton_iff.mpr hzw.symm.eq)
  exact weyl_not_borel m hm (by rw [suzukiBorelSubgroup_eq_sup]; exact (show SuzukiRootSubgroup m ≤ SuzukiRootSubgroup m ⊔ SuzukiSplitTorus m from le_sup_left) hwR)

/-- The Weyl element is internal to the pair generated by any nontrivial
root elementary subgroup and its Weyl conjugate. -/
theorem suzuki_weyl_mem_elementary_pair {m : ℕ} (hm : 0 < m)
    (V : Subgroup (SuzukiMatrixGroup m)) [IsElementaryAbelian 2 V]
    (hV : V ≤ SuzukiRootSubgroup m) (hne : V ≠ ⊥) :
    suzukiWeyl m ∈ V ⊔ V.map (MulAut.conj (suzukiWeyl m)).toMonoidHom := by
  obtain ⟨u, huV, hu⟩ := V.bot_or_exists_ne_one.resolve_left hne
  have hi : IsInvolution u := ⟨hu, elemPow_eq_one_of_isElementaryAbelian u huV⟩
  have ho := root_mul_weyl_odd hm (hV huV) hi
  let I := V ⊔ V.map (MulAut.conj (suzukiWeyl m)).toMonoidHom
  have huI : u ∈ I := (show V ≤ I from le_sup_left) huV
  have hconj : MulAut.conj (suzukiWeyl m) u ∈ I :=
    (show V.map (MulAut.conj (suzukiWeyl m)).toMonoidHom ≤ I from le_sup_right) (mem_map_of_mem _ huV)
  have hs : (u * suzukiWeyl m) ^ 2 ∈ I := by
    simpa only [pow_two, MulAut.conj_apply, suzukiWeyl_inv, mul_assoc] using I.mul_mem huI hconj
  obtain ⟨k, hk⟩ := exists_pow_eq_pow_two_mul (pow_orderOf_eq_one (u * suzukiWeyl m)) ho 1
  have hp : u * suzukiWeyl m ∈ I := by
    rw [← pow_one (u * suzukiWeyl m), hk, pow_mul]
    exact I.pow_mem hs k
  have huu : u * u = 1 := by simpa only [pow_two] using hi.sq_eq_one
  simpa only [← mul_assoc, huu, one_mul] using I.mul_mem huI hp

private theorem elementary_card_le_nonsplit_normalizer
    {m : ℕ} (hm : 0 < m) {T : Subgroup (SuzukiMatrixGroup m)}
    (hT : IsSuzukiMaximalNonsplit m T)
    (A : Subgroup (SuzukiMatrixGroup m)) [IsElementaryAbelian 2 A]
    (hA : A ≤ normalizer (T : Set (SuzukiMatrixGroup m))) : Nat.card A ≤ 2 := by
  let N := normalizer (T : Set (SuzukiMatrixGroup m))
  let T' := T.subgroupOf N
  let f : A →* N := inclusion hA
  have hodd : Odd (Nat.card T') := by
    rw [Nat.card_congr (subgroupOfEquivOfLe T.le_normalizer).toEquiv]
    apply Odd.of_dvd_nat _ hT.card_dvd
    exact ((even_two.pow_of_ne_zero (by omega : 2 * m + 1 ≠ 0)).pow_of_ne_zero
      (by decide : 2 ≠ 0)).add_odd odd_one
  obtain ⟨k, hk⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_card_eq
  have hcop : Nat.Coprime (Nat.card A) (Nat.card T') := by
    rw [hk]
    exact hodd.coprime_two_left.pow_left k
  let q := (QuotientGroup.mk' T').comp f
  have hq : Function.Injective q := by
    apply (injective_iff_map_eq_one q).mpr
    intro x hx
    have hxT : f x ∈ T' := (QuotientGroup.eq_one_iff (f x)).mp hx
    have hd : orderOf x ∣ Nat.card T' := by
      rw [← orderOf_injective f (inclusion_injective hA) x]
      exact T'.orderOf_dvd_natCard hxT
    exact orderOf_eq_one_iff.mp
      (Nat.eq_one_of_dvd_coprimes hcop (orderOf_dvd_natCard x) hd)
  let : IsCyclic (N ⧸ T') := (hT.normalizer_quotient hm).1
  let : IsCyclic A := isCyclic_of_injective q hq
  apply Nat.le_of_dvd (by decide : 0 < 2)
  rw [← IsCyclic.exponent_eq_card]
  exact IsElementaryAbelian.exponent_dvd_p 2 A

private theorem root_involution_mem_of_borel {m : ℕ} (hm : 0 < m)
    {x : SuzukiMatrixGroup m} (hx : x ∈ SuzukiBorelSubgroup m) (hi : IsInvolution x) :
    x ∈ SuzukiRootSubgroup m := by
  have hi' : IsInvolution (⟨x, hx⟩ : SuzukiBorelSubgroup m) :=
    ⟨fun h => hi.ne_one (congrArg Subtype.val h), Subtype.ext hi.sq_eq_one⟩
  have hxC : x ∈ (involutionCore (SuzukiBorelSubgroup m)).map
      (SuzukiBorelSubgroup m).subtype := by
    refine ⟨⟨x, hx⟩, ?_, rfl⟩
    rw [involutionCore_eq_closure]
    exact subset_closure hi'
  rw [suzukiBorel_involutionCore_image m hm] at hxC
  exact omegaOneAmbient_le _ hxC

/-- An elementary root subgroup of order greater than two and its opposite
Weyl conjugate generate an actual nonsolvable subgroup. -/
theorem suzuki_elementary_pair_not_isSolvable {m : ℕ} (hm : 0 < m)
    (V : Subgroup (SuzukiMatrixGroup m)) [IsElementaryAbelian 2 V]
    (hV : V ≤ SuzukiRootSubgroup m) (hcard : 2 < Nat.card V) :
    ¬ Group.IsSolvable (V ⊔ V.map (MulAut.conj (suzukiWeyl m)).toMonoidHom : Subgroup _) := by
  have hne : V ≠ ⊥ := by intro he; rw [he, card_bot] at hcard; omega
  let H := V ⊔ V.map (MulAut.conj (suzukiWeyl m)).toMonoidHom
  have hwH : suzukiWeyl m ∈ H := suzuki_weyl_mem_elementary_pair hm V hV hne
  intro hsol
  let : Group.IsSolvable H := hsol
  obtain ⟨T⟩ := exists_suzukiNonsplitTorusPair m hm
  obtain ⟨g, hB | hsplit | hplus | hminus⟩ := suzukiStandardContainment_of_isSolvable hm T H
  · obtain ⟨z, hzV, hz⟩ := V.bot_or_exists_ne_one.resolve_left hne
    have hzI : IsInvolution z := ⟨hz, elemPow_eq_one_of_isElementaryAbelian z hzV⟩
    have hgzI : IsInvolution ((MulAut.conj g) z) :=
      ⟨fun he => hz ((MulAut.conj g).injective (he.trans (map_one _).symm)),
        by rw [← map_pow, hzI.sq_eq_one, map_one]⟩
    have hgzR := root_involution_mem_of_borel hm
      (hB (mem_map_of_mem _ (show z ∈ H from (show V ≤ H from le_sup_left) hzV))) hgzI
    have hg : g ∈ SuzukiBorelSubgroup m := by
      by_contra hg
      exact hgzI.ne_one (disjoint_def.mp (suzukiRootSubgroup_disjoint_conjugate m hm g hg)
        hgzR (mem_map_of_mem _ (hV hzV)))
    have hgw := hB (mem_map_of_mem (MulAut.conj g).toMonoidHom hwH)
    have hh := (SuzukiBorelSubgroup m).mul_mem
      ((SuzukiBorelSubgroup m).mul_mem ((SuzukiBorelSubgroup m).inv_mem hg) hgw) hg
    apply weyl_not_borel m hm
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_mul_cancel_left,
      mul_assoc, inv_mul_cancel, mul_one] using hh
  · have hd := card_dvd_of_le ((map_mono (show V ≤ H from le_sup_left)).trans hsplit)
    rw [card_map_of_injective (MulAut.conj g).injective,
      suzukiSplitTorus_normalizer_card m hm] at hd
    obtain ⟨k, hk⟩ := (IsElementaryAbelian.isPGroup 2 V).exists_card_eq
    have hodd : Odd (2 ^ (2*m+1) - 1) :=
      Nat.Even.sub_odd Nat.one_le_two_pow (even_two.pow_of_ne_zero (by omega)) odd_one
    have hcop : Nat.Coprime (Nat.card V) (2 ^ (2*m+1) - 1) := by
      rw [hk]; exact hodd.coprime_two_left.pow_left k
    exact (not_le_of_gt hcard) (Nat.le_of_dvd (by decide) (hcop.dvd_of_dvd_mul_right hd))
  · let A := V.map (MulAut.conj g).toMonoidHom
    let : IsElementaryAbelian 2 A := IsElementaryAbelian.map _
    have hc := elementary_card_le_nonsplit_normalizer hm T.plus_maximal A
      ((map_mono (show V ≤ H from le_sup_left)).trans hplus)
    rw [card_map_of_injective (MulAut.conj g).injective] at hc
    omega
  · let A := V.map (MulAut.conj g).toMonoidHom
    let : IsElementaryAbelian 2 A := IsElementaryAbelian.map _
    have hc := elementary_card_le_nonsplit_normalizer hm T.minus_maximal A
      ((map_mono (show V ≤ H from le_sup_left)).trans hminus)
    rw [card_map_of_injective (MulAut.conj g).injective] at hc
    omega

/-- Recognition and field-degree divisibility for the literal subgroup
generated by the two elementary root conjugates. -/
theorem suzuki_elementary_pair_recognition {m : ℕ} (hm : 0 < m)
    (V : Subgroup (SuzukiMatrixGroup m)) [IsElementaryAbelian 2 V]
    (hV : V ≤ SuzukiRootSubgroup m) (hcard : 2 < Nat.card V) :
    ∃ k : ℕ, 0 < k ∧ (2 * k + 1 ∣ 2 * m + 1) ∧
      Nonempty ((V ⊔ V.map (MulAut.conj (suzukiWeyl m)).toMonoidHom : Subgroup _) ≃*
        SuzukiMatrixGroup k) := by
  let H := V ⊔ V.map (MulAut.conj (suzukiWeyl m)).toMonoidHom
  obtain ⟨k, hk, ⟨e⟩⟩ := External.suzukiSubgroup_exists_mulEquiv_of_not_isSolvable
    hm H (suzuki_elementary_pair_not_isSolvable hm V hV hcard)
  refine ⟨k, hk, suzukiMatrixGroup_degree_dvd_of_card_dvd hk hm ?_, ⟨e⟩⟩
  rw [← Nat.card_congr e.toEquiv]
  exact H.card_subgroup_dvd_card

