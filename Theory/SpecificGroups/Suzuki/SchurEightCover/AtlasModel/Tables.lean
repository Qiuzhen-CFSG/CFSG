module

public import Mathlib.Data.Fintype.Perm

/-!
# Numerical tables for the degree-2080 Suzuki cover candidate

The source permutations are `4Sz8d3G1-p2080B0`. We extract and centrally
correct a generating pair using the words recorded in `source/generate.py`.
The original data and attribution are retained in `source/`.

Points are zero-based indices in `Fin 2080`. Quantifying separately over
`Fin 32` and `Fin 65` checks them at indices `65*i+j`. Splitting each
lookup into 32 small definitions keeps kernel checks small.
These are just numerical functions; bijectivity and the identities used
mathematically are proved in `Data` and `Relations`.
-/

@[expose] public section
namespace BenderSuzuki.MatrixGroups.SchurEightCover.AtlasModel.Data

abbrev Point := Fin 2080

def fromNat (n : ℕ) : Point := ⟨n % 2080, Nat.mod_lt _ (by decide)⟩

def toNat (p : Point) : ℕ := p.val

/-- Check all points using two small finite quantifiers. -/
theorem forall_fromNat {P : Point → Prop}
    (h : ∀ i : Fin 32, ∀ j : Fin 65, P (fromNat (i.val * 65 + j.val))) :
    ∀ p, P p := by
  intro p
  have hi : p.val / 65 < 32 := by omega
  have hj : p.val % 65 < 65 := Nat.mod_lt _ (by decide)
  have he : fromNat ((p.val / 65) * 65 + p.val % 65) = p := by
    apply Fin.ext
    dsimp [fromNat]
    omega
  simpa only [he] using h ⟨p.val / 65, hi⟩ ⟨p.val % 65, hj⟩

