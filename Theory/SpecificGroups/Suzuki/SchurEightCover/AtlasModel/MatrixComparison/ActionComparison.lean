module
public import Theory.SpecificGroups.Suzuki.SchurEightCover.AtlasModel.BlockModel
public import Theory.SpecificGroups.Suzuki.SchurEightCover.AtlasModel.MatrixComparison.Pair
public import Theory.SpecificGroups.Suzuki.SchurEightCover.AtlasModel.MatrixComparison.ActionComparison.Faithfulness
/-!
# The marked block-to-matrix equivalence for Sz(8)

The simultaneous subgroup generated by the two pairs of published generators
projects onto both `BlockModel.Model` and `PairModel`. The checked row-line
compatibility relation holds throughout this subgroup. Distinct row lines
make the matrix projection injective; the five-line frame and determinant-one
argument make the permutation projection injective. Composing these two
isomorphisms gives the marked equivalence without group-order, native-generation,
or degree-2080 block-kernel assumptions.

The exported generator formulas discharge the action-comparison premise of
the parent's `equivOfComparisons`. Native generation and final native assembly
remain independent of this module. Source: Aschbacher–Smith I.1.1 and I.1.3(5),
printed p.407; numerical attribution in `AtlasModel/source/README.md`, with
reproduction and proof details in `ActionComparison/source/README.md`.
-/

public section
namespace BenderSuzuki.MatrixGroups.SchurEightCover.AtlasModel.MatrixComparison.ActionComparison
open Matrix

private theorem pair_det (g : PairModel) : (g.val : Mat).det = 1 := by
  have hle : pairSubgroup ≤ (GeneralLinearGroup.det : GL8 →* F8ˣ).ker := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    rcases hx with rfl | rfl
    · exact Units.ext matrixA_det
    · exact Units.ext matrixB_det
  exact congrArg Units.val (hle g.property)

/-- Simultaneous words in the two marked pairs, with ordinary multiplication. -/
private def joint : Subgroup (BlockModel.Model × PairModel) :=
  Subgroup.closure {(BlockModel.generatorA, pairA), (BlockModel.generatorB, pairB)}

private def jointA : joint :=
  ⟨(BlockModel.generatorA, pairA), Subgroup.subset_closure (by simp)⟩
private def jointB : joint :=
  ⟨(BlockModel.generatorB, pairB), Subgroup.subset_closure (by simp)⟩

private def leftProjection : joint →* BlockModel.Model :=
  (MonoidHom.fst _ _).comp joint.subtype
private def rightProjection : joint →* PairModel :=
  (MonoidHom.snd _ _).comp joint.subtype

private theorem joint_compatible (x : joint) : Compatible x.val.1.val x.val.2.val := by
  obtain ⟨x, hx⟩ := x
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
    rcases hy with rfl | rfl
    · exact generatorA_rows
    · exact generatorB_rows
  | one => exact compatible_one
  | mul x y hx hy ihx ihy => exact ihx.mul ihy
  | inv x hx ih => exact ih.inv

private theorem leftProjection_surjective : Function.Surjective leftProjection := by
  rintro ⟨h, hh⟩
  induction hh using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact ⟨jointA, rfl⟩
    · exact ⟨jointB, rfl⟩
  | one => exact ⟨1, leftProjection.map_one⟩
  | mul x y hx hy ihx ihy =>
    obtain ⟨a, ha⟩ := ihx
    obtain ⟨b, hb⟩ := ihy
    exact ⟨a * b, by rw [map_mul, ha, hb]; rfl⟩
  | inv x hx ih =>
    obtain ⟨a, ha⟩ := ih
    exact ⟨a⁻¹, by rw [map_inv, ha]; rfl⟩

private theorem rightProjection_surjective : Function.Surjective rightProjection := by
  rintro ⟨h, hh⟩
  induction hh using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact ⟨jointA, rfl⟩
    · exact ⟨jointB, rfl⟩
  | one => exact ⟨1, rightProjection.map_one⟩
  | mul x y hx hy ihx ihy =>
    obtain ⟨a, ha⟩ := ihx
    obtain ⟨b, hb⟩ := ihy
    exact ⟨a * b, by rw [map_mul, ha, hb]; rfl⟩
  | inv x hx ih =>
    obtain ⟨a, ha⟩ := ih
    exact ⟨a⁻¹, by rw [map_inv, ha]; rfl⟩

private theorem leftProjection_injective : Function.Injective leftProjection := by
  apply (injective_iff_map_eq_one leftProjection).mpr
  intro x hx
  have hp : x.val.1.val = 1 := congrArg Subtype.val hx
  have hc : Compatible 1 x.val.2.val := by simpa [hp] using joint_compatible x
  have hg : x.val.2 = 1 := Subtype.ext (hc.matrix_eq_one (pair_det x.val.2))
  exact Subtype.ext (Prod.ext hx hg)

private theorem rightProjection_injective : Function.Injective rightProjection := by
  apply (injective_iff_map_eq_one rightProjection).mpr
  intro x hx
  have hg : x.val.2.val = 1 := congrArg Subtype.val hx
  have hc : Compatible x.val.1.val 1 := by simpa [hg] using joint_compatible x
  have hp : x.val.1 = 1 := Subtype.ext hc.perm_eq_one
  exact Subtype.ext (Prod.ext hp hx)

private noncomputable def leftEquiv : joint ≃* BlockModel.Model :=
  MulEquiv.ofBijective leftProjection ⟨leftProjection_injective, leftProjection_surjective⟩
private noncomputable def rightEquiv : joint ≃* PairModel :=
  MulEquiv.ofBijective rightProjection ⟨rightProjection_injective, rightProjection_surjective⟩

/-- The checked marked identification of the block model with the matrix pair. -/
noncomputable def equiv : BlockModel.Model ≃* PairModel := leftEquiv.symm.trans rightEquiv

theorem equiv_generatorA : equiv BlockModel.generatorA = pairA := by
  have h : leftEquiv.symm BlockModel.generatorA = jointA := by
    apply leftEquiv.injective
    exact leftEquiv.apply_symm_apply BlockModel.generatorA
  change rightEquiv (leftEquiv.symm BlockModel.generatorA) = pairA
  rw [h]
  rfl

theorem equiv_generatorB : equiv BlockModel.generatorB = pairB := by
  have h : leftEquiv.symm BlockModel.generatorB = jointB := by
    apply leftEquiv.injective
    exact leftEquiv.apply_symm_apply BlockModel.generatorB
  change rightEquiv (leftEquiv.symm BlockModel.generatorB) = pairB
  rw [h]
  rfl

/-- The equivalence respects the literal row lines and the inverse-right convention. -/
theorem equiv_compatible (g : BlockModel.Model) : Compatible g.val (equiv g).val := by
  have h := joint_compatible (leftEquiv.symm g)
  have hp : (leftEquiv.symm g).val.1 = g := leftEquiv.apply_symm_apply g
  change Compatible g.val (leftEquiv.symm g).val.2.val
  simpa only [hp] using h

/-- The faithful left permutation action of the explicit matrix pair. -/
noncomputable def action : PairModel →* Equiv.Perm (Fin 65) :=
  BlockModel.subgroup.subtype.comp equiv.symm.toMonoidHom

theorem action_injective : Function.Injective action :=
  Subtype.val_injective.comp equiv.symm.injective

theorem action_compatible (g : PairModel) : Compatible (action g) g.val := by
  have h := equiv_compatible (equiv.symm g)
  rw [equiv.apply_symm_apply] at h
  exact h

theorem action_pairA : action pairA = BlockModel.a := by
  change (equiv.symm pairA).val = BlockModel.a
  rw [← equiv_generatorA, equiv.symm_apply_apply]
  rfl

theorem action_pairB : action pairB = BlockModel.b := by
  change (equiv.symm pairB).val = BlockModel.b
  rw [← equiv_generatorB, equiv.symm_apply_apply]
  rfl

end BenderSuzuki.MatrixGroups.SchurEightCover.AtlasModel.MatrixComparison.ActionComparison
