module
public import Theory.SpecificGroups.Suzuki.SchurEightCover.AtlasModel.Relations
public import Theory.GroupTheory.PerfectCentralCover
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators

/-!
# A concrete perfect group with a central Klein four subgroup

Let E be the subgroup of Sym(2080) generated by the two checked permutations.
The (2,4,5,7) generator relations force its abelianization to be trivial.
The two explicitly evaluated presentation defects are distinct central
involutions, so they generate a central subgroup of order four.

The literal quotient map is therefore a finite perfect central fourfold
cover of E/K. Identifying E/K with the native Suzuki matrix group remains
separate from this construction; no ATLAS family label is used as a theorem.
Source: Aschbacher--Smith I.1.1 and I.1.3(5), printed p.407, and the ATLAS
presentation and numerical data attributed in `source/README.md`.
-/

namespace BenderSuzuki.MatrixGroups.SchurEightCover.AtlasModel

private theorem abelian_trivial {C : Type*} [CommGroup C] (a b : C)
    (ha : a ^ 2 = 1) (hb : b ^ 4 = 1)
    (hab : (a * b) ^ 5 = 1) (habb : (a * b ^ 2) ^ 7 = 1) :
    a = 1 ∧ b = 1 := by
  have hab4 : (a * b) ^ 4 = 1 := by
    rw [mul_pow, show (4 : ℕ) = 2 * 2 from rfl, pow_mul, ha, one_pow]
    simpa using hb
  have hab1 : a * b = 1 := by
    have hd : orderOf (a * b) ∣ Nat.gcd 4 5 := Nat.dvd_gcd
      (orderOf_dvd_of_pow_eq_one hab4) (orderOf_dvd_of_pow_eq_one hab)
    exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp hd)
  have hb7 : b ^ 7 = 1 := by simpa [pow_two, ← mul_assoc, hab1] using habb
  have hb1 : b = 1 := by
    have hd : orderOf b ∣ Nat.gcd 4 7 := Nat.dvd_gcd
      (orderOf_dvd_of_pow_eq_one hb) (orderOf_dvd_of_pow_eq_one hb7)
    exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp hd)
  exact ⟨by simpa [hb1] using hab1, hb1⟩

@[expose] public section
open Data

def subgroup : Subgroup (Equiv.Perm Point) := Subgroup.closure {a, b}
abbrev E := subgroup

def generatorA : E := ⟨a, Subgroup.subset_closure (by simp)⟩
def generatorB : E := ⟨b, Subgroup.subset_closure (by simp)⟩

theorem generators_closure : Subgroup.closure {generatorA, generatorB} = ⊤ := by
  apply Subgroup.map_injective subgroup.subtype_injective
  rw [MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton]
  change subgroup = (⊤ : Subgroup E).map subgroup.subtype
  rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]

instance instIsPerfect : Group.IsPerfect E := by
  let q : E →* Abelianization E := Abelianization.of
  have ha : generatorA ^ 2 = 1 := Subtype.ext a_sq
  have hb : generatorB ^ 4 = 1 := Subtype.ext b_fourth
  have hab : (generatorA * generatorB) ^ 5 = 1 := Subtype.ext ab_fifth
  have habb : (generatorA * generatorB ^ 2) ^ 7 = 1 := Subtype.ext abb_seventh
  have h := abelian_trivial (q generatorA) (q generatorB)
    (by rw [← map_pow, ha, map_one]) (by rw [← map_pow, hb, map_one])
    (by rw [← map_mul, ← map_pow, hab, map_one])
    (by rw [← map_pow, ← map_mul, ← map_pow, habb, map_one])
  refine ⟨top_le_iff.mp ?_⟩
  rw [← generators_closure, ← Abelianization.ker_of, Subgroup.closure_le]
  intro x hx
  rcases hx with rfl | rfl
  · exact h.1
  · exact h.2

/-- First of the two source-presentation defects, evaluated in the actual group. -/
def centralZ : E :=
  (generatorA * generatorB * generatorA * generatorB ^ 2 * generatorA *
    generatorB ^ 2 * generatorA * generatorB⁻¹) ^ 5

/-- Second independent source-presentation defect. -/
def centralW : E :=
  (generatorA * generatorB * generatorA * generatorB⁻¹ * generatorA *
    generatorB ^ 2) ^ 7

theorem coe_centralZ : (centralZ : Equiv.Perm Point) = z := z_word.symm
theorem coe_centralW : (centralW : Equiv.Perm Point) = w := w_word.symm

private theorem central_of_commute_generators (x : E)
    (ha : Commute (x : Equiv.Perm Point) a) (hb : Commute (x : Equiv.Perm Point) b) :
    x ∈ Subgroup.center E := by
  have hx : (x : Equiv.Perm Point) ∈ Subgroup.centralizer (subgroup : Set (Equiv.Perm Point)) := by
    rw [subgroup, Subgroup.centralizer_closure]
    intro y hy
    rcases hy with rfl | rfl
    · exact ha.eq.symm
    · exact hb.eq.symm
  exact Subgroup.mem_center_iff.mpr fun y => Subtype.ext (hx y y.property)

theorem centralZ_mem_center : centralZ ∈ Subgroup.center E := by
  apply central_of_commute_generators
  · rw [coe_centralZ]; exact z_commute_a
  · rw [coe_centralZ]; exact z_commute_b

theorem centralW_mem_center : centralW ∈ Subgroup.center E := by
  apply central_of_commute_generators
  · rw [coe_centralW]; exact w_commute_a
  · rw [coe_centralW]; exact w_commute_b

/-- The actual subgroup generated by the two checked central involutions. -/
def kernel : Subgroup E := Subgroup.closure {centralZ, centralW}

theorem kernel_le_center : kernel ≤ Subgroup.center E := by
  apply (Subgroup.closure_le _).mpr
  intro x hx
  rcases hx with rfl | rfl
  · exact centralZ_mem_center
  · exact centralW_mem_center

instance kernel_normal : kernel.Normal where
  conj_mem n hn g := by
    have hc := Subgroup.mem_center_iff.mp (kernel_le_center hn) g
    simpa [hc, mul_assoc] using hn

instance kernel_isKleinFour : IsKleinFour kernel := by
  apply Subgroup.isKleinFour_closure_pair
  · apply Subtype.ext
    change (centralZ : Equiv.Perm Point) * centralZ = 1
    rw [coe_centralZ]
    exact z_sq
  · apply Subtype.ext
    change (centralW : Equiv.Perm Point) * centralW = 1
    rw [coe_centralW]
    exact w_sq
  · intro h
    have h' := congrArg (fun x : E => (x : Equiv.Perm Point) 0) h
    rw [coe_centralZ] at h'
    exact z_ne_one h'
  · intro h
    have h' := congrArg (fun x : E => (x : Equiv.Perm Point) 0) h
    rw [coe_centralW] at h'
    exact w_ne_one h'
  · intro h
    have h' := congrArg (fun x : E => (x : Equiv.Perm Point) 0) h
    rw [coe_centralZ, coe_centralW] at h'
    exact z_ne_w h'
  · exact (Subgroup.mem_center_iff.mp centralZ_mem_center centralW).symm

theorem kernel_card : Nat.card kernel = 4 := IsKleinFour.card_four

abbrev Quotient := E ⧸ kernel

/-- The literal quotient map, already a finite perfect central fourfold cover. -/
def quotientCover : PerfectCentralCovering.Cover E Quotient where
  toMonoidHom := QuotientGroup.mk' kernel
  surjective := QuotientGroup.mk'_surjective kernel
  isPerfect := inferInstance
  ker_le_center := by simpa only [QuotientGroup.ker_mk'] using kernel_le_center

theorem quotientCover_kernel_card : Nat.card quotientCover.toMonoidHom.ker = 4 := by
  change Nat.card (QuotientGroup.mk' kernel).ker = 4
  rw [QuotientGroup.ker_mk']
  exact kernel_card

end
end BenderSuzuki.MatrixGroups.SchurEightCover.AtlasModel
