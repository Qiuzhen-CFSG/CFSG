module

public import Theory.SpecificGroups.Suzuki.SchurEightCover.AtlasModel.Group
public import Theory.SpecificGroups.Suzuki.SchurEightCover.AtlasModel.BlockModel
public import Theory.SpecificGroups.Suzuki.SchurEightCover.AtlasModel.BlockComparison.Kernel

/-!
# The marked equivalence from the central quotient to the block action

The literal degree-2080 generated group acts on its 65 checked blocks. The
connected eight-neighbor graph proves that the kernel of this action is exactly
the subgroup generated by the two central involutions. The first isomorphism
theorem therefore identifies the literal quotient with `BlockModel.Model`,
preserving the two published generators.

This proof uses no asserted group order and is independent of the native matrix
comparison. Source context: Aschbacher--Smith I.1.1 and I.1.3(5), printed p.407.
Numerical provenance and reproducible certificates are documented in
`AtlasModel/source/README.md` and `BlockComparison/source/README.md`.
-/

namespace BenderSuzuki.MatrixGroups.SchurEightCover.AtlasModel.BlockComparison

/-- The actual quotient/block-action comparison. -/
public noncomputable def equiv : AtlasModel.Quotient ≃* BlockModel.Model :=
  QuotientGroup.liftEquiv kernel action_surjective action_ker_eq_kernel.symm

public theorem equiv_mk (g : E) : equiv (QuotientGroup.mk g) = action g := by
  exact QuotientGroup.liftEquiv_mk kernel action_surjective action_ker_eq_kernel.symm g

public theorem equiv_generatorA :
    equiv (QuotientGroup.mk generatorA) = BlockModel.generatorA := by
  rw [equiv_mk, action_generatorA]

public theorem equiv_generatorB :
    equiv (QuotientGroup.mk generatorB) = BlockModel.generatorB := by
  rw [equiv_mk, action_generatorB]

end BenderSuzuki.MatrixGroups.SchurEightCover.AtlasModel.BlockComparison
