module

public import Mathlib.FieldTheory.Finite.Basic
public import Mathlib.Algebra.CharP.Two
public import Mathlib.GroupTheory.Index
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Linarith

/-!
# The mixed torus pairing over the field of eight elements

The two layers of the Suzuki root group have torus weights 1 and 5.
An invariant additive pairing therefore has the form `b x z = b 1 (x²z)`.
The Jacobi relation for the root commutator `y*z⁴ + z*y⁴`, evaluated at
`1,t,t²` with `t` outside the prime field, says that `b 1 1 = 0`.
Consequently its image has at most four elements.

These are finite-field calculations, independent of a covering group. The
application to the literal universal kernel is assembled in `SchurEightUpper`;
constructing its mixed commutator pairing and proving generation are separate
mathematical obligations.

Sources: the root product and torus formulas in Huppert--Blackburn III,
XI.3.1; the upper-bound part of Aschbacher--Smith I.1.3(5), printed p.407
(PDF p.418) of `refs/quasithin.pdf`, and GLS3 §6.1. This calculation uses
neither a multiplier table nor a covering-kernel bound.
-/

namespace BenderSuzuki.MatrixGroups.SchurCover.EightPairing
variable {K : Type*} [Field K] [Finite K] [CharP K 2]

omit [CharP K 2] in
private theorem pow_seven (hK : Nat.card K = 8) (x : K) (hx : x ≠ 0) : x ^ 7 = 1 := by
  let : Fintype K := Fintype.ofFinite K
  simpa only [Fintype.card_eq_nat_card, hK] using FiniteField.pow_card_sub_one_eq_one x hx

private theorem moore (hK : Nat.card K = 8) (t : K) (ht0 : t ≠ 0) (ht1 : t ≠ 1) :
    1 ^ 2 * (t * (t ^ 2) ^ 4 + t ^ 2 * t ^ 4) +
      t ^ 2 * (t ^ 2 * 1 ^ 4 + 1 * (t ^ 2) ^ 4) +
      (t ^ 2) ^ 2 * (1 * t ^ 4 + t * 1 ^ 4) = 1 := by
  have ht7 := pow_seven hK t ht0
  have hs : t ^ 6 + t ^ 5 + t ^ 4 + t ^ 3 + t ^ 2 + t + 1 = 0 := by
    apply (mul_eq_zero.mp (show (t - 1) *
        (t ^ 6 + t ^ 5 + t ^ 4 + t ^ 3 + t ^ 2 + t + 1) = 0 from ?_)).resolve_left
      (sub_ne_zero.mpr ht1)
    linear_combination ht7
  have h8 : t ^ 8 = t := by simp only [pow_succ, ht7, one_mul]
  have h9 : t ^ 9 = t ^ 2 := by rw [show 9 = 8 + 1 from rfl, pow_succ, h8, pow_two]
  have h10 : t ^ 10 = t ^ 3 := by rw [show 10 = 9 + 1 from rfl, pow_succ, h9, ← pow_succ]
  calc
    _ = t ^ 9 + t ^ 6 + t ^ 4 + t ^ 10 + t ^ 8 + t ^ 5 := by ring
    _ = 1 := by
      rw [h8, h9, h10]
      linear_combination (norm := ring_nf) hs
      simp [CharTwo.two_eq_zero]

variable {A : Type*} [AddCommGroup A]

/-- Invariance for the literal root-quotient and root-center torus weights. -/
@[expose] public def TorusInvariant (b : K →+ (K →+ A)) : Prop :=
  ∀ (t : Kˣ) x z, b ((t : K) * x) ((t : K) ^ 5 * z) = b x z

/-- The additive Hall--Witt relation for the Suzuki root commutator. -/
@[expose] public def Jacobi (b : K →+ (K →+ A)) : Prop :=
  ∀ x y z, b x (y * z ^ 4 + z * y ^ 4) +
    b y (z * x ^ 4 + x * z ^ 4) + b z (x * y ^ 4 + y * x ^ 4) = 0

omit [CharP K 2] in
/-- Every value belongs to the image of the row at one. -/
public theorem normalize (hK : Nat.card K = 8) (b : K →+ (K →+ A))
    (hi : TorusInvariant b) (x z : K) : b x z = b 1 (x ^ 2 * z) := by
  by_cases hx : x = 0
  · subst x
    simp
  · have h := hi (Units.mk0 x hx) 1 (x ^ 2 * z)
    have he : x ^ 5 * (x ^ 2 * z) = z := by
      rw [← mul_assoc, ← pow_add, pow_seven hK x hx, one_mul]
    simpa only [Units.val_mk0, mul_one, he] using h

/-- Jacobi kills the prime-field generator in the normalized row. -/
public theorem one_one_eq_zero (hK : Nat.card K = 8) (b : K →+ (K →+ A))
    (hi : TorusInvariant b) (hj : Jacobi b) : b 1 1 = 0 := by
  obtain ⟨t, ht0, ht1⟩ := ENat.exists_ne_ne_of_three_le
    (α := K) (by simp only [ENat.card_eq_coe_natCard, hK]; norm_num) 0 1
  have h := hj 1 t (t ^ 2)
  rw [normalize hK b hi 1 _, normalize hK b hi t _,
    normalize hK b hi (t ^ 2) _] at h
  rw [← map_add, ← map_add, moore hK t ht0 ht1] at h
  exact h

/-- The normalized row has kernel of order at least two. -/
public theorem range_card_le_four (hK : Nat.card K = 8) (b : K →+ (K →+ A))
    (hi : TorusInvariant b) (hj : Jacobi b) : Nat.card (b 1).range ≤ 4 := by
  have he := one_one_eq_zero hK b hi hj
  have hker : 2 ≤ Nat.card (b 1).ker := by
    have : Nontrivial (b 1).ker := ⟨⟨⟨1, he⟩, 0,
      fun h => one_ne_zero (congrArg Subtype.val h)⟩⟩
    exact Nat.succ_le_of_lt Finite.one_lt_card
  have hmul := (b 1).ker.card_mul_index
  rw [AddSubgroup.index_ker, hK] at hmul
  nlinarith

omit [CharP K 2] in
/-- The subgroup generated by all pairing values is already one row image. -/
public theorem closure_eq_range (hK : Nat.card K = 8) (b : K →+ (K →+ A))
    (hi : TorusInvariant b) :
    AddSubgroup.closure {v | ∃ x z, b x z = v} = (b 1).range := by
  apply le_antisymm
  · rw [AddSubgroup.closure_le]
    rintro v ⟨x, z, rfl⟩
    exact ⟨x ^ 2 * z, (normalize hK b hi x z).symm⟩
  · rintro v ⟨z, rfl⟩
    exact AddSubgroup.subset_closure ⟨1, z, rfl⟩

/-- A group generated by such a pairing has order at most four. -/
public theorem card_le_four_of_generated (hK : Nat.card K = 8) (b : K →+ (K →+ A))
    (hi : TorusInvariant b) (hj : Jacobi b)
    (hg : AddSubgroup.closure {v | ∃ x z, b x z = v} = ⊤) : Nat.card A ≤ 4 := by
  rw [closure_eq_range hK b hi] at hg
  have hh := range_card_le_four hK b hi hj
  simpa only [hg, AddSubgroup.card_top] using hh

end BenderSuzuki.MatrixGroups.SchurCover.EightPairing
