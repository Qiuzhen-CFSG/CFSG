module

public import Theory.SpecificGroups.Suzuki.RootOvoidGeometry

/-!
# Orders of Suzuki ovoid derangements

An ovoid derangement has odd order: otherwise a power is an involution, whose
unique fixed point would also be fixed by the original element. An odd-order
element commuting with a nonidentity element fixes its fixed points pointwise,
since there are at most two. Consequently every nonidentity element of the
cyclic subgroup generated by a derangement is again a derangement. The free
cyclic action shows that its order divides the ovoid degree `q² + 1`.

Conversely, a nonidentity element whose order divides `q² + 1` has no fixed
point, by coprimality with the Borel order. The same fixed-point argument makes
its centralizer act freely, so the centralizer order also divides `q² + 1`.
These proofs use no nonsplit tori or classification.

Source: Huppert--Blackburn, *Finite Groups III*, XI.3.10(b),(g), pp. 191--192.
-/

namespace BenderSuzuki.MatrixGroups

private theorem card_dvd_of_free {G X : Type*} [Group G] [Finite G]
    [Finite X] [MulAction G X]
    (h : ∀ (g : G) (a : X), g • a = a → g = 1) : Nat.card G ∣ Nat.card X := by
  classical
  let : IsCancelSMul G X := isCancelSMul_iff_eq_one_of_smul_eq.mpr h
  let : Fintype G := Fintype.ofFinite G
  let : Fintype X := Fintype.ofFinite X
  let : ∀ g : G, Fintype (MulAction.fixedBy X g) := fun _ => Fintype.ofFinite _
  have hsum : (∑ g : G, Nat.card (MulAction.fixedBy X g)) = Nat.card X := by
    rw [Finset.sum_eq_single 1]
    · simp [MulAction.fixedBy_one_eq_univ]
    · intro g _ hg
      have he : MulAction.fixedBy X g = ∅ := by
        ext a
        simp only [Set.mem_empty_iff_false, iff_false]
        exact fun ha => hg (h g a ha)
      simp [he]
    · simp
  have hc : Nat.card X = Nat.card (Quotient (MulAction.orbitRel G X)) * Nat.card G := by
    rw [← hsum]
    simpa [Nat.card_eq_fintype_card] using
      MulAction.sum_card_fixedBy_eq_card_orbits_mul_card_group G X
  rw [hc]
  exact dvd_mul_left _ _

private theorem odd_commuting_fixed (m : ℕ) (hm : 0 < m)
    (x y : SuzukiMatrixGroup m) (hx : Odd (orderOf x)) (hy : y ≠ 1)
    (hcomm : Commute y x) (a : SuzukiOvoid m) (ha : y • a = a) : x • a = a := by
  have hb : y • (x • a) = x • a := by
    rw [← mul_smul, hcomm.eq, mul_smul, ha]
  have hc : y • (x • (x • a)) = x • (x • a) := by
    rw [← mul_smul, hcomm.eq, mul_smul, hb]
  by_cases he : x • a = a
  · exact he
  have hs : x • (x • a) = a := by
    by_contra hne
    have hbc : x • a ≠ x • (x • a) := by
      intro hh
      exact he ((MulAction.injective x) hh).symm
    exact suzukiOvoid_at_most_two_fixed m hm y hy a (x • a) (x • (x • a))
      (Ne.symm he) (Ne.symm hne) hbc ha hb hc
  obtain ⟨k, hk⟩ := exists_pow_eq_pow_two_mul (pow_orderOf_eq_one x) hx 1
  have hpow : (x ^ 2) ^ k • a = a :=
    smul_eq_self_of_mem_zpowers ((Subgroup.zpowers (x ^ 2)).pow_mem (Subgroup.mem_zpowers _) k)
      (by simpa [pow_two, mul_smul] using hs)
  simpa only [← pow_mul, ← hk, pow_one] using hpow

/-- Every ovoid derangement has odd order. -/
public theorem suzukiOvoid_derangement_odd (m : ℕ) (hm : 0 < m)
    (x : SuzukiMatrixGroup m) (hx : ∀ a : SuzukiOvoid m, x • a ≠ a) :
    Odd (orderOf x) := by
  rw [← Nat.not_even_iff_odd, even_iff_two_dvd]
  intro hd
  let y := x ^ (orderOf x / 2)
  have hy : orderOf y = 2 := orderOf_pow_orderOf_div (orderOf_pos x).ne' hd
  obtain ⟨a, ha, hu⟩ := suzukiOvoid_involution_unique_fixed m hm y hy
  have hcomm : Commute y x := (Commute.refl x).pow_left _
  apply hx a
  apply hu
  rw [← mul_smul, hcomm.eq, mul_smul, ha]

/-- The order of an ovoid derangement divides the degree `q² + 1`. -/
public theorem suzukiOvoid_derangement_order_dvd (m : ℕ) (hm : 0 < m)
    (x : SuzukiMatrixGroup m) (hx : ∀ a : SuzukiOvoid m, x • a ≠ a) :
    orderOf x ∣ (2 ^ (2 * m + 1)) ^ 2 + 1 := by
  rw [← suzukiOvoid_card, ← Nat.card_zpowers]
  apply card_dvd_of_free (X := SuzukiOvoid m)
  intro y a ha
  apply Subtype.ext
  by_contra hy
  have hcomm : Commute (y : SuzukiMatrixGroup m) x := by
    obtain ⟨k, hk⟩ := y.property
    rw [← hk]
    exact (Commute.refl x).zpow_left k
  exact hx a (odd_commuting_fixed m hm x y (suzukiOvoid_derangement_odd m hm x hx) hy hcomm a ha)

private theorem degree_odd (m : ℕ) : Odd ((2 ^ (2 * m + 1)) ^ 2 + 1) := by
  apply Even.add_one
  exact (even_two.pow_of_ne_zero (by omega)).pow_of_ne_zero (by decide)

private theorem degree_coprime_borel (m : ℕ) :
    Nat.Coprime ((2 ^ (2 * m + 1)) ^ 2 + 1)
      ((2 ^ (2 * m + 1)) ^ 2 * (2 ^ (2 * m + 1) - 1)) := by
  let q := 2 ^ (2 * m + 1)
  have hq : 1 ≤ q := Nat.one_le_pow _ _ (by decide)
  have heven : Even q := even_two.pow_of_ne_zero (by omega)
  have hodd : Odd (q - 1) := by
    rw [Nat.odd_iff]
    have hmod := (Nat.even_iff.mp heven)
    omega
  have hcp : Nat.Coprime (q ^ 2 + 1) (q - 1) := by
    have heq : q ^ 2 + 1 = 2 + (q + 1) * (q - 1) := by
      have := Nat.sub_add_cancel hq
      nlinarith
    rw [heq, Nat.coprime_add_mul_right_left]
    exact hodd.coprime_two_left
  have hcp₂ : Nat.Coprime (q ^ 2 + 1) (q ^ 2) :=
    Nat.coprime_self_add_left.mpr (Nat.coprime_one_left _)
  exact hcp₂.mul_right hcp

/-- The ovoid degree and the Borel order are coprime. -/
public theorem suzukiOvoid_degree_coprime_borel (m : ℕ) :
    Nat.Coprime ((2 ^ (2 * m + 1)) ^ 2 + 1)
      ((2 ^ (2 * m + 1)) ^ 2 * (2 ^ (2 * m + 1) - 1)) :=
  degree_coprime_borel m

private theorem order_dvd_borel_of_fixed (m : ℕ) (hm : 0 < m)
    (x : SuzukiMatrixGroup m) (a : SuzukiOvoid m) (ha : x • a = a) :
    orderOf x ∣ (2 ^ (2 * m + 1)) ^ 2 * (2 ^ (2 * m + 1) - 1) := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (SuzukiMatrixGroup m)
    (suzukiOvoidInfinity m) a
  have hc : Nat.card (MulAction.stabilizer (SuzukiMatrixGroup m) a) =
      (2 ^ (2 * m + 1)) ^ 2 * (2 ^ (2 * m + 1) - 1) := by
    rw [← Nat.card_congr (MulAction.stabilizerEquivStabilizer hg.symm).toEquiv,
      ← suzukiBorelSubgroup_eq_stabilizer m hm, suzukiBorelSubgroup_card m hm]
  let y : MulAction.stabilizer (SuzukiMatrixGroup m) a := ⟨x, ha⟩
  rw [← hc, show orderOf x = orderOf y from Subgroup.orderOf_coe y]
  exact orderOf_dvd_natCard y

/-- A nonidentity element of order dividing `q² + 1` is an ovoid derangement. -/
public theorem suzukiOvoid_derangement_of_order_dvd (m : ℕ) (hm : 0 < m)
    (x : SuzukiMatrixGroup m) (hx : x ≠ 1)
    (hd : orderOf x ∣ (2 ^ (2 * m + 1)) ^ 2 + 1) :
    ∀ a : SuzukiOvoid m, x • a ≠ a := by
  intro a ha
  apply hx
  apply orderOf_eq_one_iff.mp
  exact Nat.eq_one_of_dvd_coprimes (degree_coprime_borel m) hd
    (order_dvd_borel_of_fixed m hm x a ha)

/-- The centralizer of a nonidentity element of order dividing `q² + 1`
has order dividing `q² + 1`. -/
public theorem suzukiMatrixGroup_centralizer_card_dvd (m : ℕ) (hm : 0 < m)
    (x : SuzukiMatrixGroup m) (hx : x ≠ 1)
    (hd : orderOf x ∣ (2 ^ (2 * m + 1)) ^ 2 + 1) :
    Nat.card (Subgroup.centralizer {x}) ∣ (2 ^ (2 * m + 1)) ^ 2 + 1 := by
  rw [← suzukiOvoid_card]
  apply card_dvd_of_free (X := SuzukiOvoid m)
  intro y a ha
  apply Subtype.ext
  by_contra hy
  have hcomm : Commute (y : SuzukiMatrixGroup m) x :=
    Subgroup.mem_centralizer_singleton_iff.mp y.property
  exact suzukiOvoid_derangement_of_order_dvd m hm x hx hd a
    (odd_commuting_fixed m hm x y ((degree_odd m).of_dvd_nat hd) hy hcomm a ha)

end BenderSuzuki.MatrixGroups
