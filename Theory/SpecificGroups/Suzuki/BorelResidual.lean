module
public import Theory.SpecificGroups.Suzuki.RootOvoidGeometry
public import Theory.SpecificGroups.Suzuki.FieldTorus
public import Theory.GroupTheory.PResidual.FiniteImage

/-!
# The two-residual and normalized two-subgroups of a Suzuki Borel

The odd split torus normally generates the Borel: every element outside the
root group is conjugate into the torus, and a root element is the quotient
of two elements outside the root group. Thus the Borel is its own two-residual.
A two-subgroup normalized by the Borel lies in its Sylow root group, by
maximality of Sylow subgroups. These statements also retain both coordinates
of the product Borel.

Source: Huppert--Blackburn III, XI.3.3 and XI.3.10; application to
Aschbacher--Smith, 13.6.6, printed p.927 (PDF p.944).
-/

public section
namespace BenderSuzuki.MatrixGroups
open Subgroup

private theorem root_le_borel (m : ℕ) : SuzukiRootSubgroup m ≤ SuzukiBorelSubgroup m := by
  rw [suzukiBorelSubgroup_eq_sup]; exact le_sup_left

private theorem torus_le_borel (m : ℕ) : SuzukiSplitTorus m ≤ SuzukiBorelSubgroup m := by
  rw [suzukiBorelSubgroup_eq_sup]; exact le_sup_right

private theorem borel_le_of_torus_le (m : ℕ) (hm : 0 < m)
    (N : Subgroup (SuzukiMatrixGroup m))
    (hn : SuzukiBorelSubgroup m ≤ normalizer (N : Set (SuzukiMatrixGroup m)))
    (ht : SuzukiSplitTorus m ≤ N) : SuzukiBorelSubgroup m ≤ N := by
  have hout (b : SuzukiMatrixGroup m) (hb : b ∈ SuzukiBorelSubgroup m)
      (hbu : b ∉ SuzukiRootSubgroup m) : b ∈ N := by
    obtain ⟨r, hr⟩ := suzukiBorelSubgroup_conjugate_into_split m hm b hb hbu
    exact (mem_normalizer_iff''.mp (hn (root_le_borel m r.property)) b).mpr (ht hr)
  have hcard : 1 < Nat.card (SuzukiSplitTorus m) := by
    rw [suzukiSplitTorus_card m hm]
    have hq : 2 ^ 3 ≤ 2 ^ (2 * m + 1) := Nat.pow_le_pow_right (by decide) (by omega)
    omega
  let : Nontrivial (SuzukiSplitTorus m) := Finite.one_lt_card_iff_nontrivial.mp hcard
  obtain ⟨t, htne⟩ := exists_ne (1 : SuzukiSplitTorus m)
  have htu : (t : SuzukiMatrixGroup m) ∉ SuzukiRootSubgroup m := by
    intro h
    exact htne (Subtype.ext (mem_bot.mp ((suzukiRootSubgroup_disjoint_splitTorus m hm).le_bot
      ⟨h, t.property⟩)))
  intro x hx
  by_cases hxu : x ∈ SuzukiRootSubgroup m
  · have hxt : x * t ∉ SuzukiRootSubgroup m := by
      intro h
      exact htu (by
        simpa using (SuzukiRootSubgroup m).mul_mem
          ((SuzukiRootSubgroup m).inv_mem hxu) h)
    simpa using N.mul_mem
      (hout (x * t) ((SuzukiBorelSubgroup m).mul_mem hx (torus_le_borel m t.property)) hxt)
      (N.inv_mem (ht t.property))
  · exact hout x hx hxu

/-- The entire concrete Borel is generated by its odd-order elements. -/
theorem suzukiBorel_pResidual_eq_top (m : ℕ) (hm : 0 < m) :
    pResidual 2 (SuzukiBorelSubgroup m) = ⊤ := by
  let B := SuzukiBorelSubgroup m
  let R := (pResidual 2 B).map B.subtype
  have hn : B ≤ normalizer (R : Set (SuzukiMatrixGroup m)) := by
    have h := (pResidual 2 B).le_normalizer_map B.subtype
    intro b hb
    exact h ⟨⟨b, hb⟩, by rw [normalizer_eq_top]; trivial, rfl⟩
  have ht : SuzukiSplitTorus m ≤ R := by
    intro t ht
    let b : B := ⟨t, torus_le_borel m ht⟩
    have hord : orderOf b ∣ Nat.card (SuzukiSplitTorus m) := by
      simpa only [b, orderOf_mk] using orderOf_dvd_natCard (⟨t, ht⟩ : SuzukiSplitTorus m)
    have hb : b ∈ pResidual 2 B := mem_pResidual_of_orderOf_coprime
      ((Nat.prime_two.coprime_iff_not_dvd.mpr
        (splitTorus_card_odd m hm).not_two_dvd_nat).of_dvd_right hord)
    exact mem_map_of_mem B.subtype hb
  have hBR := borel_le_of_torus_le m hm R hn ht
  apply top_unique
  intro b _
  obtain ⟨r, hr, he⟩ := hBR b.property
  exact (Subtype.ext he : r = b) ▸ hr

/-- Both factors of the concrete product Borel survive in its two-residual. -/
theorem suzukiBorel_prod_pResidual_eq_top (m : ℕ) (hm : 0 < m) :
    pResidual 2 ((SuzukiBorelSubgroup m).prod (SuzukiBorelSubgroup m)) = ⊤ := by
  let B := SuzukiBorelSubgroup m
  let D := B.prod B
  let f : B →* D :=
    { toFun := fun x => ⟨(x, 1), x.property, B.one_mem⟩
      map_one' := rfl
      map_mul' := fun _ _ => Subtype.ext (by simp) }
  let g : B →* D :=
    { toFun := fun x => ⟨(1, x), B.one_mem, x.property⟩
      map_one' := rfl
      map_mul' := fun _ _ => Subtype.ext (by simp) }
  have hf (b : B) : f b ∈ pResidual 2 D := by
    apply map_pResidual_le 2 f
    apply mem_map_of_mem
    rw [suzukiBorel_pResidual_eq_top m hm]
    trivial
  have hg (b : B) : g b ∈ pResidual 2 D := by
    apply map_pResidual_le 2 g
    apply mem_map_of_mem
    rw [suzukiBorel_pResidual_eq_top m hm]
    trivial
  apply top_unique
  intro x _
  have he : f ⟨x.val.1, x.property.1⟩ * g ⟨x.val.2, x.property.2⟩ = x := by
    ext <;> simp [f, g]
  rw [← he]
  exact mul_mem (hf _) (hg _)

/-- A two-subgroup normalized by the Borel lies in the root group. -/
theorem suzuki_twoSubgroup_le_root_of_borel_normalizes (m : ℕ) (hm : 0 < m)
    (P : Subgroup (SuzukiMatrixGroup m)) (hP : IsPGroup 2 P)
    (hn : SuzukiBorelSubgroup m ≤ normalizer (P : Set (SuzukiMatrixGroup m))) :
    P ≤ SuzukiRootSubgroup m := by
  obtain ⟨U, hU⟩ := suzukiRootSubgroup_isSylow m hm
  have hUP : (U : Subgroup (SuzukiMatrixGroup m)) ≤ normalizer (P : Set _) :=
    hU ▸ (root_le_borel m).trans hn
  have he := U.is_maximal' (U.isPGroup'.to_sup_of_normal_right' hP hUP) le_sup_left
  exact (show P ≤ (U : Subgroup (SuzukiMatrixGroup m)) ⊔ P from le_sup_right).trans
    (he.le.trans hU.le)

/-- The same bound keeps both literal coordinates of a normalized two-subgroup. -/
theorem suzuki_pair_twoSubgroup_le_root_of_borel_normalizes (m : ℕ) (hm : 0 < m)
    (P : Subgroup (SuzukiMatrixGroup m × SuzukiMatrixGroup m)) (hP : IsPGroup 2 P)
    (hn : (SuzukiBorelSubgroup m).prod (SuzukiBorelSubgroup m) ≤
      normalizer (P : Set (SuzukiMatrixGroup m × SuzukiMatrixGroup m))) :
    P ≤ (SuzukiRootSubgroup m).prod (SuzukiRootSubgroup m) := by
  apply le_prod_iff.mpr
  constructor
  · apply suzuki_twoSubgroup_le_root_of_borel_normalizes m hm _ (hP.map _)
    intro b hb
    exact P.le_normalizer_map (MonoidHom.fst _ _)
      (mem_map_of_mem _ (hn (show (b, 1) ∈ (SuzukiBorelSubgroup m).prod _ from
        ⟨hb, one_mem _⟩)))
  · apply suzuki_twoSubgroup_le_root_of_borel_normalizes m hm _ (hP.map _)
    intro b hb
    exact P.le_normalizer_map (MonoidHom.snd _ _)
      (mem_map_of_mem _ (hn (show (1, b) ∈ (SuzukiBorelSubgroup m).prod _ from
        ⟨one_mem _, hb⟩)))

end BenderSuzuki.MatrixGroups
