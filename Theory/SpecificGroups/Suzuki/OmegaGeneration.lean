module

public import Theory.SpecificGroups.Suzuki.BorelInvolutionCore
public import Theory.SpecificGroups.Suzuki.TwoRank
public import Theory.SpecificGroups.Suzuki.SubgroupParameters
public import BenderSuzuki.External.Huppert.XI.SubgroupSolvable
public import BenderSuzuki.External.Huppert.XI.SubgroupNonsolvable

/-!
# Generation by the Suzuki root omega

The subgroup generated by the root center and an element outside the Borel
cannot be solvable. Solvable-subgroup containment puts it in a conjugate Borel
or a torus normalizer. A nontrivial root involution pins down the former Borel,
while the latter normalizers have two-parts at most four and cannot contain
an elementary subgroup of order q ≥ 8.

Nonsolvable-subgroup recognition now makes the generated subgroup a Suzuki
group. Its elementary subgroup of order q forces its field degree to be at
least the ambient degree; divisibility of group orders forces the opposite
inequality. Equal parameters give equality with the entire group.

Source: GLS, Volume 4, Chapter 4, Lemma 3.2(h), using the subgroup theorems
of Huppert--Blackburn, Finite Groups III, XI.3.12(e) and XI.11.15. The generator
is the first omega of the root group, not the whole root group.
-/

namespace BenderSuzuki.MatrixGroups
open Subgroup PFAppendixIII Theory.GroupTheory

private theorem root_involution_mem_of_borel {m : ℕ} (hm : 0 < m)
    {x : SuzukiMatrixGroup m} (hx : x ∈ SuzukiBorelSubgroup m) (hi : IsInvolution x) :
    x ∈ SuzukiRootSubgroup m := by
  have hi' : IsInvolution (⟨x, hx⟩ : SuzukiBorelSubgroup m) :=
    ⟨fun h => hi.ne_one (congrArg Subtype.val h), Subtype.ext hi.sq_eq_one⟩
  have hxC : x ∈ (involutionCore (SuzukiBorelSubgroup m)).map
      (SuzukiBorelSubgroup m).subtype := by
    refine ⟨⟨x, hx⟩, ?_, rfl⟩
    rw [involutionCore_eq_closure]
    exact subset_closure hi'
  rw [suzukiBorel_involutionCore_image m hm] at hxC
  exact omegaOneAmbient_le _ hxC

private theorem omega_not_le_small {m : ℕ} (hm : 0 < m)
    (N : Subgroup (SuzukiMatrixGroup m)) (g : SuzukiMatrixGroup m)
    (hN : ∃ n, Odd n ∧ Nat.card N = 4 * n) :
    ¬ (omegaOneAmbient (SuzukiRootSubgroup m)).map (MulAut.conj g).toMonoidHom ≤ N := by
  intro hle
  have hdiv := card_dvd_of_le hle
  rw [card_map_of_injective (MulAut.conj g).injective,
    suzukiRootSubgroup_omega_card m hm] at hdiv
  obtain ⟨n, hn, hN⟩ := hN
  rw [hN] at hdiv
  have hd : 2 ^ (2 * m + 1) ∣ 4 :=
    (hn.coprime_two_right.symm.pow_left _).dvd_of_dvd_mul_right hdiv
  have hle4 := Nat.le_of_dvd (by decide : 0 < 4) hd
  have hle8 : 8 ≤ 2 ^ (2*m+1) := by
    exact (show 8 = (2:ℕ)^3 by norm_num).trans_le
      (Nat.pow_le_pow_right (by decide) (by omega))
  omega

private theorem omega_outside_not_solvable {m : ℕ} (hm : 0 < m)
    (t : SuzukiMatrixGroup m) (htB : t ∉ SuzukiBorelSubgroup m) :
    ¬ Group.IsSolvable (omegaOneAmbient (SuzukiRootSubgroup m) ⊔ zpowers t : Subgroup _) := by
  intro hsol
  let H := omegaOneAmbient (SuzukiRootSubgroup m) ⊔ zpowers t
  let : Group.IsSolvable H := hsol
  obtain ⟨T⟩ := exists_suzukiNonsplitTorusPair m hm
  obtain ⟨g, hB | hsplit | hplus | hminus⟩ := suzukiStandardContainment_of_isSolvable hm T H
  · have hE : omegaOneAmbient (SuzukiRootSubgroup m) ≠ ⊥ := by
      intro he
      have hh := suzukiRootSubgroup_omega_card m hm
      rw [he, card_bot] at hh
      have hp := one_lt_pow₀ (by decide : 1 < (2:ℕ)) (by omega : 2*m+1 ≠ 0)
      omega
    obtain ⟨z, hzE, hz⟩ := (omegaOneAmbient (SuzukiRootSubgroup m)).bot_or_exists_ne_one.resolve_left hE
    have hzU := omegaOneAmbient_le _ hzE
    let := suzukiRootSubgroup_omega_elementary m hm
    have hzI : IsInvolution z := ⟨hz, elemPow_eq_one_of_isElementaryAbelian z hzE⟩
    have hgzI : IsInvolution ((MulAut.conj g) z) :=
      ⟨fun he => hz ((MulAut.conj g).injective (he.trans (map_one _).symm)),
        by rw [← map_pow, hzI.sq_eq_one, map_one]⟩
    have hgzU := root_involution_mem_of_borel hm
      (hB (mem_map_of_mem _ (show z ∈ H from (show omegaOneAmbient (SuzukiRootSubgroup m) ≤ H from le_sup_left) hzE))) hgzI
    have hg : g ∈ SuzukiBorelSubgroup m := by
      by_contra hg
      exact hgzI.ne_one (disjoint_def.mp (suzukiRootSubgroup_disjoint_conjugate m hm g hg)
        hgzU (mem_map_of_mem _ hzU))
    have hgt := hB (mem_map_of_mem (MulAut.conj g).toMonoidHom
      (show t ∈ H from (show zpowers t ≤ H from le_sup_right) (mem_zpowers t)))
    have hh := (SuzukiBorelSubgroup m).mul_mem
      ((SuzukiBorelSubgroup m).mul_mem ((SuzukiBorelSubgroup m).inv_mem hg) hgt) hg
    apply htB
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_mul_cancel_left,
      mul_assoc, inv_mul_cancel, mul_one] using hh
  · have hdiv := card_dvd_of_le ((map_mono (show omegaOneAmbient (SuzukiRootSubgroup m) ≤ H from le_sup_left)).trans hsplit)
    rw [card_map_of_injective (MulAut.conj g).injective,
      suzukiRootSubgroup_omega_card m hm, suzukiSplitTorus_normalizer_card m hm] at hdiv
    have hodd : Odd (2 ^ (2*m+1) - 1) :=
      Nat.Even.sub_odd Nat.one_le_two_pow (even_two.pow_of_ne_zero (by omega)) odd_one
    have hd : 2 ^ (2*m+1) ∣ 2 :=
      (hodd.coprime_two_right.symm.pow_left _).dvd_of_dvd_mul_right hdiv
    have hh := Nat.le_of_dvd (by decide : 0 < 2) hd
    have hbig : 2 < 2 ^ (2*m+1) := by
      calc
        2 = (2:ℕ)^1 := by norm_num
        _ < _ := Nat.pow_lt_pow_right (by decide) (by omega)
    omega
  · apply omega_not_le_small hm _ g ?_
      ((map_mono (show omegaOneAmbient (SuzukiRootSubgroup m) ≤ H from le_sup_left)).trans hplus)
    refine ⟨Nat.card T.plus, ?_, ?_⟩
    · apply Odd.of_dvd_nat _ T.plus_maximal.card_dvd
      exact (even_two.pow_of_ne_zero (by omega)).pow_of_ne_zero (by decide) |>.add_odd odd_one
    · have hc := relIndex_mul_card_of_le (le_normalizer (H := T.plus))
      rw [T.plus_maximal.normalizer_index_eq_four hm] at hc
      exact hc.symm
  · apply omega_not_le_small hm _ g ?_
      ((map_mono (show omegaOneAmbient (SuzukiRootSubgroup m) ≤ H from le_sup_left)).trans hminus)
    refine ⟨Nat.card T.minus, ?_, ?_⟩
    · apply Odd.of_dvd_nat _ T.minus_maximal.card_dvd
      exact (even_two.pow_of_ne_zero (by omega)).pow_of_ne_zero (by decide) |>.add_odd odd_one
    · have hc := relIndex_mul_card_of_le (le_normalizer (H := T.minus))
      rw [T.minus_maximal.normalizer_index_eq_four hm] at hc
      exact hc.symm

private theorem eq_top_of_omega_le_of_not_solvable {m : ℕ} (hm : 0 < m)
    (H : Subgroup (SuzukiMatrixGroup m))
    (hE : omegaOneAmbient (SuzukiRootSubgroup m) ≤ H) (hsol : ¬ Group.IsSolvable H) : H = ⊤ := by
  obtain ⟨k, hk, ⟨e⟩⟩ := External.suzukiSubgroup_exists_mulEquiv_of_not_isSolvable hm H hsol
  have hdiv : Nat.card (SuzukiMatrixGroup k) ∣ Nat.card (SuzukiMatrixGroup m) := by
    rw [← Nat.card_congr e.toEquiv]
    exact H.card_subgroup_dvd_card
  have hkm : 2*k+1 ≤ 2*m+1 := Nat.le_of_dvd (by omega)
    (suzukiMatrixGroup_degree_dvd_of_card_dvd hk hm hdiv)
  let E := omegaOneAmbient (SuzukiRootSubgroup m)
  let : IsElementaryAbelian 2 E := suzukiRootSubgroup_omega_elementary m hm
  let : IsElementaryAbelian 2 (E.subgroupOf H) := IsElementaryAbelian.subgroupOf hE
  let V := (E.subgroupOf H).map e.toMonoidHom
  have hV : IsElementaryAbelian 2 V := IsElementaryAbelian.map _
  have hcardV : Nat.card V = 2 ^ (2*m+1) := by
    rw [card_map_of_injective e.injective,
      Nat.card_congr (subgroupOfEquivOfLe hE).toEquiv]
    exact suzukiRootSubgroup_omega_card m hm
  have hle : Nat.card V ≤ 2 ^ (2*k+1) :=
    (primeRank_le_iff_elementary_card_le (SuzukiMatrixGroup k)).mp
      (suzuki_two_rank k hk).le V hV
  rw [hcardV] at hle
  have hmk := (Nat.pow_le_pow_iff_right (by decide : 1 < (2:ℕ))).mp hle
  have hkeq : k = m := by omega
  subst k
  exact H.eq_top_of_card_eq (Nat.card_congr e.toEquiv)

/-- The root omega and any element outside its Borel generate the whole Suzuki group. -/
public theorem suzukiRootSubgroup_omega_sup_zpowers_eq_top (m : ℕ) (hm : 0 < m)
    (t : SuzukiMatrixGroup m) (htB : t ∉ SuzukiBorelSubgroup m) :
    omegaOneAmbient (SuzukiRootSubgroup m) ⊔ zpowers t = ⊤ :=
  eq_top_of_omega_le_of_not_solvable hm _ le_sup_left (omega_outside_not_solvable hm t htB)

end BenderSuzuki.MatrixGroups
