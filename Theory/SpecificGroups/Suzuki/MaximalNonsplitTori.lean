module

public import Theory.SpecificGroups.Suzuki.NonsplitLinear
public import Theory.SpecificGroups.Suzuki.OvoidLocalStructure
public import Theory.SpecificGroups.Suzuki.SubgroupParameters
public import BenderSuzuki.External.Huppert.XI.theorem_3_6
import Mathlib.GroupTheory.Transfer

/-!
# Maximal nonsplit subgroups of Suzuki groups

Maximality here is among subgroups of order dividing `q² + 1`, not among
all proper subgroups. The linear theorem makes these subgroups cyclic.
The ovoid centralizer bound then identifies every maximal such subgroup
with the centralizer of each of its nonidentity elements. Consequently
distinct maximal nonsplit subgroups intersect trivially. Their prime divisors
supply cyclic ambient Sylow subgroups, proving the Hall property. Sylow
conjugacy then makes the orders of nonconjugate maximal subgroups coprime,
and the orders of a finite representative family multiply to `q² + 1`.

The root conjugates, split-torus conjugates, and nonsplit conjugates form a
partition, with unique subgroup membership away from the identity. The
normalizer action lies in the cyclic group generated by `u ↦ u^q`, whose
square is inversion. Burnside transfer and XI.3.6 exclude a trivial
normalizer quotient; its order is therefore two or four. No final torus
orders or subgroup classification are assumed.

Source: Huppert--Blackburn, *Finite Groups III*, XI.3.10(b)--(h),
printed pp. 191--192, using the linear input of step (a).
-/

namespace BenderSuzuki.MatrixGroups

/-- Maximal among the subgroups whose orders divide the ovoid degree. -/
public def IsSuzukiMaximalNonsplit (m : ℕ) (U : Subgroup (SuzukiMatrixGroup m)) : Prop :=
  Maximal (fun V : Subgroup (SuzukiMatrixGroup m) =>
    Nat.card V ∣ (2 ^ (2 * m + 1)) ^ 2 + 1) U

/-- The defining order bound for a maximal nonsplit subgroup. -/
public theorem IsSuzukiMaximalNonsplit.card_dvd {m : ℕ}
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U) :
    Nat.card U ∣ (2 ^ (2 * m + 1)) ^ 2 + 1 := hU.1

/-- Every maximal nonsplit subgroup is cyclic. -/
public theorem IsSuzukiMaximalNonsplit.isCyclic {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U) :
    IsCyclic U :=
  suzukiMatrixGroup_isCyclic_of_card_dvd_sq_add_one m hm U hU.card_dvd

private theorem nonsplit_le_centralizer {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)}
    (hU : Nat.card U ∣ (2 ^ (2 * m + 1)) ^ 2 + 1)
    {x : SuzukiMatrixGroup m} (hx : x ∈ U) : U ≤ Subgroup.centralizer {x} := by
  let :=  suzukiMatrixGroup_isCyclic_of_card_dvd_sq_add_one m hm U hU
  exact (Subgroup.le_centralizer U).trans
    (Subgroup.centralizer_le (Set.singleton_subset_iff.mpr hx))

/-- A nonidentity nonsplit element has a maximal nonsplit centralizer. -/
public theorem suzukiCentralizer_isMaximalNonsplit (m : ℕ) (hm : 0 < m)
    (x : SuzukiMatrixGroup m) (hx : x ≠ 1)
    (hd : orderOf x ∣ (2 ^ (2 * m + 1)) ^ 2 + 1) :
    IsSuzukiMaximalNonsplit m (Subgroup.centralizer {x}) := by
  refine ⟨suzukiMatrixGroup_centralizer_card_dvd m hm x hx hd, ?_⟩
  intro V hV hle
  apply nonsplit_le_centralizer hm hV
  exact hle (Subgroup.mem_centralizer_singleton_iff.mpr rfl)

/-- The centralizer of any nonidentity member is the whole maximal subgroup. -/
public theorem IsSuzukiMaximalNonsplit.centralizer_eq {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U)
    {x : SuzukiMatrixGroup m} (hxU : x ∈ U) (hx : x ≠ 1) :
    Subgroup.centralizer {x} = U := by
  have hd : orderOf x ∣ (2 ^ (2 * m + 1)) ^ 2 + 1 :=
    (Subgroup.orderOf_dvd_natCard U hxU).trans hU.card_dvd
  have hle := nonsplit_le_centralizer hm hU.card_dvd hxU
  exact le_antisymm (hU.2 (suzukiMatrixGroup_centralizer_card_dvd m hm x hx hd) hle) hle

/-- A nonsplit subgroup is contained in a maximal one. -/
public theorem exists_suzukiMaximalNonsplit_ge (m : ℕ)
    (V : Subgroup (SuzukiMatrixGroup m))
    (hV : Nat.card V ∣ (2 ^ (2 * m + 1)) ^ 2 + 1) :
    ∃ U, V ≤ U ∧ IsSuzukiMaximalNonsplit m U :=
  Finite.exists_le_maximal hV

/-- There are nonidentity elements whose orders divide the ovoid degree. -/
public theorem exists_suzuki_nonsplit_element (m : ℕ) (hm : 0 < m) :
    ∃ x : SuzukiMatrixGroup m, x ≠ 1 ∧ orderOf x ∣ (2 ^ (2 * m + 1)) ^ 2 + 1 := by
  have hpos : 0 < (2 : ℕ) ^ (2 * m + 1) := by positivity
  obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd
    (show (2 ^ (2 * m + 1)) ^ 2 + 1 ≠ 1 by nlinarith)
  let : Fact p.Prime := ⟨hp⟩
  have hpG : p ∣ Nat.card (SuzukiMatrixGroup m) := by
    rw [suzukiMatrixGroup_card m hm]
    exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left hpd _) _
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := SuzukiMatrixGroup m) p hpG
  refine ⟨x, ?_, hx ▸ hpd⟩
  intro h
  rw [h, orderOf_one] at hx
  exact hp.ne_one hx.symm

/-- Maximal nonsplit subgroups are nontrivial. -/
public theorem IsSuzukiMaximalNonsplit.ne_bot {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U) : U ≠ ⊥ := by
  intro hbot
  obtain ⟨x, hx, hd⟩ := exists_suzuki_nonsplit_element m hm
  have hle : Subgroup.zpowers x ≤ U := hU.2 (by simpa using hd) (by rw [hbot]; exact bot_le)
  exact hx (by simpa [hbot] using hle (Subgroup.mem_zpowers x))

/-- Two maximal nonsplit subgroups sharing a nonidentity member are equal. -/
public theorem IsSuzukiMaximalNonsplit.eq_of_common {m : ℕ} (hm : 0 < m)
    {U V : Subgroup (SuzukiMatrixGroup m)}
    (hU : IsSuzukiMaximalNonsplit m U) (hV : IsSuzukiMaximalNonsplit m V)
    {x : SuzukiMatrixGroup m} (hxU : x ∈ U) (hxV : x ∈ V) (hx : x ≠ 1) : U = V :=
  (hU.centralizer_eq hm hxU hx).symm.trans (hV.centralizer_eq hm hxV hx)

/-- Distinct maximal nonsplit subgroups intersect trivially. -/
public theorem IsSuzukiMaximalNonsplit.disjoint {m : ℕ} (hm : 0 < m)
    {U V : Subgroup (SuzukiMatrixGroup m)}
    (hU : IsSuzukiMaximalNonsplit m U) (hV : IsSuzukiMaximalNonsplit m V)
    (hne : U ≠ V) : Disjoint U V := by
  rw [Subgroup.disjoint_def]
  intro x hxU hxV
  by_contra hx
  exact hne (hU.eq_of_common hm hV hxU hxV hx)

/-- Conjugation preserves maximal nonsplit subgroups. -/
public theorem IsSuzukiMaximalNonsplit.map_conj {m : ℕ}
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U)
    (g : SuzukiMatrixGroup m) :
    IsSuzukiMaximalNonsplit m (U.map (MulAut.conj g).toMonoidHom) := by
  let f := (MulAut.conj g).toMonoidHom
  have hf : Function.Injective f := (MulAut.conj g).injective
  have hsur : Function.Surjective f := (MulAut.conj g).surjective
  refine ⟨?_, ?_⟩
  · change Nat.card (U.map f) ∣ _
    simpa only [Subgroup.card_map_of_injective hf] using hU.card_dvd
  · intro V hV hle
    have hcard : Nat.card (V.comap f) = Nat.card V := by
      rw [← Subgroup.card_map_of_injective hf,
        Subgroup.map_comap_eq_self_of_surjective hsur]
    have hback : V.comap f ≤ U :=
      hU.2 (by simpa only [hcard] using hV) (Subgroup.map_le_iff_le_comap.mp hle)
    simpa only [Subgroup.map_comap_eq_self_of_surjective hsur] using
      Subgroup.map_mono (f := f) hback

/-- A maximal nonsplit subgroup is its own centralizer. -/
public theorem IsSuzukiMaximalNonsplit.centralizer_subgroup_eq {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U) :
    Subgroup.centralizer (U : Set (SuzukiMatrixGroup m)) = U := by
  let := hU.isCyclic hm
  obtain ⟨x, hxU, hx⟩ := U.bot_or_exists_ne_one.resolve_left (hU.ne_bot hm)
  apply le_antisymm ?_ (Subgroup.le_centralizer U)
  exact (Subgroup.centralizer_le (Set.singleton_subset_iff.mpr hxU)).trans
    (hU.centralizer_eq hm hxU hx).le

/-- Sylow subgroups for primes dividing the ovoid degree are nonsplit. -/
public theorem suzukiSylow_card_dvd_degree (m : ℕ) (hm : 0 < m)
    {p : ℕ} [Fact p.Prime] (hp : p ∣ (2 ^ (2 * m + 1)) ^ 2 + 1)
    (P : Sylow p (SuzukiMatrixGroup m)) :
    Nat.card P ∣ (2 ^ (2 * m + 1)) ^ 2 + 1 := by
  obtain ⟨n, hn⟩ := P.isPGroup'.exists_card_eq
  have hcop : Nat.Coprime (Nat.card P)
      ((2 ^ (2 * m + 1)) ^ 2 * (2 ^ (2 * m + 1) - 1)) := by
    rw [hn]
    exact ((suzukiOvoid_degree_coprime_borel m).of_dvd_left hp).pow_left n
  apply hcop.dvd_of_dvd_mul_right
  have hcard := (P : Subgroup (SuzukiMatrixGroup m)).card_subgroup_dvd_card
  rwa [suzukiMatrixGroup_card m hm, mul_assoc] at hcard

/-- A maximal nonsplit subgroup contains an ambient Sylow subgroup for
each prime dividing its order. -/
public theorem IsSuzukiMaximalNonsplit.exists_sylow_le {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U)
    {p : ℕ} [hp : Fact p.Prime] (hpU : p ∣ Nat.card U) :
    ∃ P : Sylow p (SuzukiMatrixGroup m), (P : Subgroup (SuzukiMatrixGroup m)) ≤ U := by
  obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' (G := U) p hpU
  have horder : orderOf (u : SuzukiMatrixGroup m) = p := (Subgroup.orderOf_coe u).trans hu
  have hne : (u : SuzukiMatrixGroup m) ≠ 1 := by
    intro h
    rw [h, orderOf_one] at horder
    exact hp.out.ne_one horder.symm
  have hpgroup : IsPGroup p (Subgroup.zpowers (u : SuzukiMatrixGroup m)) := by
    apply IsPGroup.of_card (n := 1)
    simpa only [Nat.card_zpowers, pow_one] using horder
  obtain ⟨P, hP⟩ := hpgroup.exists_le_sylow
  have hd := suzukiSylow_card_dvd_degree m hm (hpU.trans hU.card_dvd) P
  refine ⟨P, ?_⟩
  have hcentral := nonsplit_le_centralizer hm hd (hP (Subgroup.mem_zpowers _))
  exact hcentral.trans (hU.centralizer_eq hm u.property hne).le

/-- Maximal nonsplit subgroups are Hall subgroups: order and index are coprime. -/
public theorem IsSuzukiMaximalNonsplit.card_coprime_index {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U) :
    Nat.Coprime (Nat.card U) U.index := by
  by_contra h
  obtain ⟨p, hp, hpU, hpI⟩ := Nat.Prime.not_coprime_iff_dvd.mp h
  let : Fact p.Prime := ⟨hp⟩
  obtain ⟨P, hP⟩ := hU.exists_sylow_le hm hpU
  exact P.not_dvd_index (hpI.trans (Subgroup.index_dvd_of_le hP))

/-- The normalizer of any nontrivial subgroup of a maximal nonsplit subgroup
normalizes that maximal subgroup. This is the local input to transfer. -/
public theorem IsSuzukiMaximalNonsplit.normalizer_le {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U)
    {P : Subgroup (SuzukiMatrixGroup m)} (hP : P ≤ U) (hPne : P ≠ ⊥) :
    Subgroup.normalizer (P : Set (SuzukiMatrixGroup m)) ≤
      Subgroup.normalizer (U : Set (SuzukiMatrixGroup m)) := by
  obtain ⟨x, hxP, hx⟩ := P.bot_or_exists_ne_one.resolve_left hPne
  intro g hg
  rw [Subgroup.mem_normalizer_iff_map_conj_eq] at hg ⊢
  change P.map (MulAut.conj g).toMonoidHom = P at hg
  have hxmap : x ∈ U.map (MulAut.conj g).toMonoidHom := by
    apply Subgroup.map_mono hP
    rwa [hg]
  exact (hU.map_conj g).eq_of_common hm hU hxmap (hP hxP) hx

/-- Maximal nonsplit subgroups whose orders share a prime are conjugate. -/
public theorem IsSuzukiMaximalNonsplit.conjugate_of_prime_dvd {m : ℕ} (hm : 0 < m)
    {U V : Subgroup (SuzukiMatrixGroup m)}
    (hU : IsSuzukiMaximalNonsplit m U) (hV : IsSuzukiMaximalNonsplit m V)
    {p : ℕ} [Fact p.Prime] (hpU : p ∣ Nat.card U) (hpV : p ∣ Nat.card V) :
    ∃ g : SuzukiMatrixGroup m, V = U.map (MulAut.conj g).toMonoidHom := by
  obtain ⟨P, hP⟩ := hU.exists_sylow_le hm hpU
  obtain ⟨Q, hQ⟩ := hV.exists_sylow_le hm hpV
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (SuzukiMatrixGroup m) P Q
  have hmap : (P : Subgroup (SuzukiMatrixGroup m)).map (MulAut.conj g).toMonoidHom = Q := by
    exact congrArg Sylow.toSubgroup hg
  have hQne : (Q : Subgroup (SuzukiMatrixGroup m)) ≠ ⊥ :=
    Q.ne_bot_of_dvd_card (hpV.trans V.card_subgroup_dvd_card)
  obtain ⟨x, hxQ, hx⟩ := (Q : Subgroup (SuzukiMatrixGroup m)).bot_or_exists_ne_one.resolve_left hQne
  refine ⟨g, hV.eq_of_common hm (hU.map_conj g) (hQ hxQ) ?_ hx⟩
  apply Subgroup.map_mono hP
  rwa [hmap]

/-- Nonconjugate maximal nonsplit subgroups have coprime orders. -/
public theorem IsSuzukiMaximalNonsplit.card_coprime_of_not_conjugate {m : ℕ} (hm : 0 < m)
    {U V : Subgroup (SuzukiMatrixGroup m)}
    (hU : IsSuzukiMaximalNonsplit m U) (hV : IsSuzukiMaximalNonsplit m V)
    (hne : ¬ ∃ g : SuzukiMatrixGroup m, V = U.map (MulAut.conj g).toMonoidHom) :
    Nat.Coprime (Nat.card U) (Nat.card V) := by
  by_contra h
  obtain ⟨p, hp, hpU, hpV⟩ := Nat.Prime.not_coprime_iff_dvd.mp h
  let : Fact p.Prime := ⟨hp⟩
  exact hne (hU.conjugate_of_prime_dvd hm hV hpU hpV)

/-- Equal orders determine the conjugacy class of maximal nonsplit subgroups. -/
public theorem IsSuzukiMaximalNonsplit.conjugate_of_card_eq {m : ℕ} (hm : 0 < m)
    {U V : Subgroup (SuzukiMatrixGroup m)}
    (hU : IsSuzukiMaximalNonsplit m U) (hV : IsSuzukiMaximalNonsplit m V)
    (hcard : Nat.card U = Nat.card V) :
    ∃ g : SuzukiMatrixGroup m, V = U.map (MulAut.conj g).toMonoidHom := by
  obtain ⟨p, hp, hpU⟩ := Nat.exists_prime_and_dvd
    (fun h => hU.ne_bot hm (Subgroup.card_eq_one.mp h))
  let : Fact p.Prime := ⟨hp⟩
  exact hU.conjugate_of_prime_dvd hm hV hpU (hcard ▸ hpU)

/-- Every nonidentity nonsplit element belongs to exactly one maximal
nonsplit subgroup. -/
public theorem existsUnique_suzukiMaximalNonsplit (m : ℕ) (hm : 0 < m)
    (x : SuzukiMatrixGroup m) (hx : x ≠ 1)
    (hd : orderOf x ∣ (2 ^ (2 * m + 1)) ^ 2 + 1) :
    ∃! U : Subgroup (SuzukiMatrixGroup m), IsSuzukiMaximalNonsplit m U ∧ x ∈ U := by
  refine ⟨Subgroup.centralizer {x},
    ⟨suzukiCentralizer_isMaximalNonsplit m hm x hx hd,
      Subgroup.mem_centralizer_singleton_iff.mpr rfl⟩, ?_⟩
  intro U hU
  exact (hU.1.centralizer_eq hm hU.2 hx).symm

/-- All elements are covered by root conjugates, split-torus conjugates,
and maximal nonsplit subgroups. -/
public theorem suzukiMaximalNonsplit_element_coverage (m : ℕ) (hm : 0 < m)
    (x : SuzukiMatrixGroup m) :
    (∃ k : SuzukiMatrixGroup m,
      x ∈ (SuzukiRootSubgroup m).map (MulAut.conj k).toMonoidHom) ∨
    (∃ k : SuzukiMatrixGroup m,
      x ∈ (SuzukiSplitTorus m).map (MulAut.conj k).toMonoidHom) ∨
    (∃ U : Subgroup (SuzukiMatrixGroup m), IsSuzukiMaximalNonsplit m U ∧ x ∈ U) := by
  obtain hroot | hsplit | ⟨hder, hd⟩ := suzukiOvoid_element_coverage m hm x
  · exact Or.inl hroot
  · exact Or.inr (Or.inl hsplit)
  · have hx : x ≠ 1 := by
      intro hx
      exact hder (suzukiOvoidInfinity m) (by simp [hx])
    exact Or.inr (Or.inr (existsUnique_suzukiMaximalNonsplit m hm x hx hd).exists)

/-- The subgroups in the Suzuki partition, before choosing representatives
of the nonsplit conjugacy classes. -/
public def SuzukiPartitionMember (m : ℕ) (U : Subgroup (SuzukiMatrixGroup m)) : Prop :=
  (∃ g, U = (SuzukiRootSubgroup m).map (MulAut.conj g).toMonoidHom) ∨
  (∃ g, U = (SuzukiSplitTorus m).map (MulAut.conj g).toMonoidHom) ∨
  IsSuzukiMaximalNonsplit m U

/-- The three types of member of the Suzuki partition. -/
public theorem suzukiPartitionMember_iff (m : ℕ) (U : Subgroup (SuzukiMatrixGroup m)) :
    SuzukiPartitionMember m U ↔
      (∃ g, U = (SuzukiRootSubgroup m).map (MulAut.conj g).toMonoidHom) ∨
      (∃ g, U = (SuzukiSplitTorus m).map (MulAut.conj g).toMonoidHom) ∨
      IsSuzukiMaximalNonsplit m U := Iff.rfl

private theorem maximal_disjoint_fixed {m : ℕ} (hm : 0 < m)
    {U V : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U)
    (hV : ∀ x ∈ V, ∃ a : SuzukiOvoid m, x • a = a) : Disjoint U V := by
  rw [Subgroup.disjoint_def]
  intro x hxU hxV
  by_contra hx
  obtain ⟨a, ha⟩ := hV x hxV
  exact suzukiOvoid_derangement_of_order_dvd m hm x hx
    ((U.orderOf_dvd_natCard hxU).trans hU.card_dvd) a ha

private theorem root_split_conjugates_disjoint (m : ℕ) (hm : 0 < m)
    (g h : SuzukiMatrixGroup m) :
    Disjoint ((SuzukiRootSubgroup m).map (MulAut.conj g).toMonoidHom)
      ((SuzukiSplitTorus m).map (MulAut.conj h).toMonoidHom) := by
  apply Subgroup.disjoint_of_coprime_natCard
  rw [Subgroup.card_map_of_injective (MulAut.conj g).injective,
    Subgroup.card_map_of_injective (MulAut.conj h).injective,
    suzukiRootSubgroup_card m hm, suzukiSplitTorus_card m hm]
  have hodd : Odd (2 ^ (2 * m + 1) - 1) := by
    have heven : Even ((2 : ℕ) ^ (2 * m + 1)) := even_two.pow_of_ne_zero (show 2 * m + 1 ≠ 0 by omega)
    have hp : 0 < (2 : ℕ) ^ (2 * m + 1) := by positivity
    rw [Nat.odd_iff]
    have := Nat.even_iff.mp heven
    omega
  exact (hodd.coprime_two_left.pow_left _).pow_left _

/-- Any two distinct members of the Suzuki partition intersect trivially. -/
public theorem SuzukiPartitionMember.disjoint {m : ℕ} (hm : 0 < m)
    {U V : Subgroup (SuzukiMatrixGroup m)}
    (hU : SuzukiPartitionMember m U) (hV : SuzukiPartitionMember m V)
    (hne : U ≠ V) : Disjoint U V := by
  have hroot (g : SuzukiMatrixGroup m) (x : SuzukiMatrixGroup m)
      (hx : x ∈ (SuzukiRootSubgroup m).map (MulAut.conj g).toMonoidHom) :
      ∃ a : SuzukiOvoid m, x • a = a :=
    (suzukiOvoid_fixed_point_iff_mem_conjugate m hm x).mpr ⟨g, Or.inl hx⟩
  have hsplit (g : SuzukiMatrixGroup m) (x : SuzukiMatrixGroup m)
      (hx : x ∈ (SuzukiSplitTorus m).map (MulAut.conj g).toMonoidHom) :
      ∃ a : SuzukiOvoid m, x • a = a :=
    (suzukiOvoid_fixed_point_iff_mem_conjugate m hm x).mpr ⟨g, Or.inr hx⟩
  rcases hU with ⟨g, rfl⟩ | ⟨g, rfl⟩ | hU <;>
    rcases hV with ⟨h, rfl⟩ | ⟨h, rfl⟩ | hV
  · exact suzukiRootSubgroup_conjugates_disjoint m hm g h hne
  · exact root_split_conjugates_disjoint m hm g h
  · exact (maximal_disjoint_fixed hm hV (hroot g)).symm
  · exact (root_split_conjugates_disjoint m hm h g).symm
  · exact suzukiSplitTorus_conjugates_disjoint m hm g h hne
  · exact (maximal_disjoint_fixed hm hV (hsplit g)).symm
  · exact maximal_disjoint_fixed hm hU (hroot h)
  · exact maximal_disjoint_fixed hm hU (hsplit h)
  · exact hU.disjoint hm hV hne

/-- Every nonidentity element belongs to a unique subgroup in the partition. -/
public theorem suzukiPartition_existsUnique (m : ℕ) (hm : 0 < m)
    (x : SuzukiMatrixGroup m) (hx : x ≠ 1) :
    ∃! U : Subgroup (SuzukiMatrixGroup m), SuzukiPartitionMember m U ∧ x ∈ U := by
  have hex : ∃ U : Subgroup (SuzukiMatrixGroup m), SuzukiPartitionMember m U ∧ x ∈ U := by
    obtain ⟨g, hg⟩ | ⟨g, hg⟩ | ⟨U, hU, hxU⟩ :=
      suzukiMaximalNonsplit_element_coverage m hm x
    · exact ⟨_, Or.inl ⟨g, rfl⟩, hg⟩
    · exact ⟨_, Or.inr (Or.inl ⟨g, rfl⟩), hg⟩
    · exact ⟨U, Or.inr (Or.inr hU), hxU⟩
  obtain ⟨U, hU, hxU⟩ := hex
  refine ⟨U, ⟨hU, hxU⟩, ?_⟩
  intro V hV
  by_contra hne
  exact hx (Subgroup.disjoint_def.mp (hV.1.disjoint hm hU hne) hV.2 hxU)

/-- A finite transversal of the conjugacy classes of maximal nonsplit subgroups. -/
public structure SuzukiNonsplitRepresentatives (m : ℕ) where
  subgroups : Finset (Subgroup (SuzukiMatrixGroup m))
  maximal : ∀ U ∈ subgroups, IsSuzukiMaximalNonsplit m U
  not_conjugate : ∀ U ∈ subgroups, ∀ V ∈ subgroups, U ≠ V →
    ¬ ∃ g : SuzukiMatrixGroup m, V = U.map (MulAut.conj g).toMonoidHom
  covers : ∀ V, IsSuzukiMaximalNonsplit m V →
    ∃ U ∈ subgroups, ∃ g : SuzukiMatrixGroup m, V = U.map (MulAut.conj g).toMonoidHom

/-- A finite family of representatives exists without knowing the torus orders. -/
public theorem exists_suzukiNonsplitRepresentatives (m : ℕ) (hm : 0 < m) :
    Nonempty (SuzukiNonsplitRepresentatives m) := by
  classical
  let : Fintype (Subgroup (SuzukiMatrixGroup m)) := Fintype.ofFinite _
  let s : Finset ℕ := (Finset.univ.filter (IsSuzukiMaximalNonsplit m)).image
    (fun U : Subgroup (SuzukiMatrixGroup m) => Nat.card U)
  have hs (n : ℕ) : n ∈ s ↔
      ∃ U : Subgroup (SuzukiMatrixGroup m), IsSuzukiMaximalNonsplit m U ∧ Nat.card U = n := by
    simp [s]
  have hex (i : s) : ∃ U : Subgroup (SuzukiMatrixGroup m),
      IsSuzukiMaximalNonsplit m U ∧ Nat.card U = i.val := (hs i.val).mp i.property
  choose U hU hc using hex
  refine ⟨⟨Finset.univ.image U, ?_, ?_, ?_⟩⟩
  · intro V hV
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hV
    exact hU i
  · intro V hV W hW hne
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hV
    obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hW
    rintro ⟨g, hg⟩
    have hij : i = j := by
      apply Subtype.ext
      rw [← hc i, ← hc j, hg, Subgroup.card_map_of_injective (MulAut.conj g).injective]
    exact hne (congrArg U hij)
  · intro V hV
    let i : s := ⟨Nat.card V, (hs _).mpr ⟨V, hV, rfl⟩⟩
    exact ⟨U i, Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩,
      (hU i).conjugate_of_card_eq hm hV (hc i)⟩

/-- Distinct representatives have pairwise coprime orders. -/
public theorem SuzukiNonsplitRepresentatives.card_pairwise_coprime {m : ℕ} (hm : 0 < m)
    (R : SuzukiNonsplitRepresentatives m) :
    ∀ U ∈ R.subgroups, ∀ V ∈ R.subgroups, U ≠ V → Nat.Coprime (Nat.card U) (Nat.card V) := by
  intro U hU V hV hne
  exact (R.maximal U hU).card_coprime_of_not_conjugate hm (R.maximal V hV)
    (R.not_conjugate U hU V hV hne)

private theorem prod_dvd_of_pairwise_coprime {α : Type*} (s : Finset α) (f : α → ℕ) (n : ℕ)
    (hcop : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → Nat.Coprime (f a) (f b))
    (hd : ∀ a ∈ s, f a ∣ n) : (∏ a ∈ s, f a) ∣ n := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    rw [Finset.prod_insert ha]
    apply Nat.Coprime.mul_dvd_of_dvd_of_dvd
      (Nat.Coprime.prod_right (fun b hb => hcop a (by simp) b (by simp [hb]) (by
        intro h; exact ha (h ▸ hb)))) (hd a (by simp))
    exact ih (fun b hb c hc => hcop b (by simp [hb]) c (by simp [hc]))
      (fun b hb => hd b (by simp [hb]))

/-- The orders of the representatives multiply to the ovoid degree. -/
public theorem SuzukiNonsplitRepresentatives.prod_card {m : ℕ} (hm : 0 < m)
    (R : SuzukiNonsplitRepresentatives m) :
    (∏ U ∈ R.subgroups, Nat.card U) = (2 ^ (2 * m + 1)) ^ 2 + 1 := by
  apply Nat.dvd_antisymm
  · exact prod_dvd_of_pairwise_coprime R.subgroups (fun U : Subgroup (SuzukiMatrixGroup m) => Nat.card U) _
      (R.card_pairwise_coprime hm) (fun U hU => (R.maximal U hU).card_dvd)
  · apply (Nat.dvd_iff_prime_pow_dvd_dvd _ _).mpr
    intro p k hp hpk
    by_cases hk : k = 0
    · simp [hk]
    have hpd : p ∣ (2 ^ (2 * m + 1)) ^ 2 + 1 :=
      (dvd_pow_self p hk).trans hpk
    let : Fact p.Prime := ⟨hp⟩
    let P : Sylow p (SuzukiMatrixGroup m) := default
    have hP := suzukiSylow_card_dvd_degree m hm hpd P
    obtain ⟨V, hPV, hV⟩ := exists_suzukiMaximalNonsplit_ge m P hP
    obtain ⟨U, hUR, g, hg⟩ := R.covers V hV
    have hpG : p ^ k ∣ Nat.card (SuzukiMatrixGroup m) := by
      rw [suzukiMatrixGroup_card m hm]
      exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left hpk _) _
    have hpV := (P.pow_dvd_card_of_pow_dvd_card hpG).trans (Subgroup.card_dvd_of_le hPV)
    rw [hg, Subgroup.card_map_of_injective (MulAut.conj g).injective] at hpV
    exact hpV.trans (Finset.dvd_prod_of_mem (fun U : Subgroup (SuzukiMatrixGroup m) => Nat.card U) hUR)

/-- The partition may equivalently use all conjugates of any chosen
representative family. -/
public theorem suzukiPartitionMember_iff_representatives {m : ℕ}
    (R : SuzukiNonsplitRepresentatives m) (V : Subgroup (SuzukiMatrixGroup m)) :
    SuzukiPartitionMember m V ↔
      (∃ g, V = (SuzukiRootSubgroup m).map (MulAut.conj g).toMonoidHom) ∨
      (∃ g, V = (SuzukiSplitTorus m).map (MulAut.conj g).toMonoidHom) ∨
      (∃ U ∈ R.subgroups, ∃ g, V = U.map (MulAut.conj g).toMonoidHom) := by
  constructor
  · rintro (h | h | h)
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (R.covers V h))
  · rintro (h | h | ⟨U, hU, g, rfl⟩)
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr ((R.maximal U hU).map_conj g))

/-- The conjugates of the root group, split torus and a finite nonsplit
representative family form a partition away from the identity. -/
public theorem SuzukiNonsplitRepresentatives.partition_existsUnique {m : ℕ} (hm : 0 < m)
    (R : SuzukiNonsplitRepresentatives m) (x : SuzukiMatrixGroup m) (hx : x ≠ 1) :
    ∃! V : Subgroup (SuzukiMatrixGroup m),
      ((∃ g, V = (SuzukiRootSubgroup m).map (MulAut.conj g).toMonoidHom) ∨
        (∃ g, V = (SuzukiSplitTorus m).map (MulAut.conj g).toMonoidHom) ∨
        (∃ U ∈ R.subgroups, ∃ g, V = U.map (MulAut.conj g).toMonoidHom)) ∧ x ∈ V := by
  obtain ⟨V, ⟨hV, hxV⟩, huniq⟩ := suzukiPartition_existsUnique m hm x hx
  refine ⟨V, ⟨(suzukiPartitionMember_iff_representatives R V).mp hV, hxV⟩, ?_⟩
  intro W hW
  exact huniq W ⟨(suzukiPartitionMember_iff_representatives R W).mpr hW.1, hW.2⟩

private theorem nonsplit_normalizer_action {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U) :
    IsCyclic U.normalizerMonoidHom.range ∧ Nat.card U.normalizerMonoidHom.range ∣ 4 := by
  let := hU.isCyclic hm
  let := IsCyclic.commGroup (α := U)
  let q := 2 ^ (2 * m + 1)
  have hcop : Nat.Coprime (Nat.card U) q := by
    apply Nat.Coprime.of_dvd_left hU.card_dvd
    exact Nat.Coprime.of_dvd_right (dvd_pow_self q (by decide : 2 ≠ 0))
      (Nat.coprime_self_add_left.mpr (Nat.coprime_one_left (q ^ 2)))
  let β : MulAut U := { powCoprime hcop with map_mul' := fun a b => mul_pow a b q }
  have hβ (u : U) : β u = u ^ q := rfl
  have hβpow (i : ℕ) (u : U) : (β ^ i) u = u ^ (q ^ i) := by
    induction i generalizing u with
    | zero => simp
    | succ i ih =>
      rw [pow_succ, MulAut.mul_apply, hβ, ih, ← pow_mul, pow_succ']
  have hβsq (u : U) : (β ^ 2) u = u⁻¹ := by
    rw [hβpow]
    apply eq_inv_of_mul_eq_one_left
    rw [← pow_succ]
    exact orderOf_dvd_iff_pow_eq_one.mp
      ((orderOf_dvd_natCard u).trans hU.card_dvd)
  have hβfour : β ^ 4 = 1 := by
    apply MulEquiv.ext
    intro u
    change (β ^ (2 + 2)) u = u
    rw [pow_add, MulAut.mul_apply, hβsq, hβsq, inv_inv]
  have hrange : U.normalizerMonoidHom.range ≤ Subgroup.zpowers β := by
    rintro a ⟨g, rfl⟩
    obtain ⟨i, _, hi⟩ :=
      suzukiMatrixGroup_normalizer_eq_frobenius_pow_of_card_dvd_sq_add_one m hm U
        (hU.ne_bot hm) hU.card_dvd (g : SuzukiMatrixGroup m)⁻¹
        ((Subgroup.normalizer (U : Set (SuzukiMatrixGroup m))).inv_mem g.property)
    have heq : U.normalizerMonoidHom g = β ^ i := by
      apply MulEquiv.ext
      intro u
      apply Subtype.ext
      have h := hi (u : SuzukiMatrixGroup m) u.property
      rw [hβpow]
      change (g : SuzukiMatrixGroup m) * (u : SuzukiMatrixGroup m) *
        (g : SuzukiMatrixGroup m)⁻¹ = (u : SuzukiMatrixGroup m) ^ (q ^ i)
      simpa only [inv_inv] using h
    rw [heq]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _
  refine ⟨Subgroup.isCyclic_of_le hrange, ?_⟩
  have hd := Subgroup.card_dvd_of_le hrange
  rw [Nat.card_zpowers] at hd
  exact hd.trans (orderOf_dvd_of_pow_eq_one hβfour)

/-- The normalizer quotient is cyclic and has order dividing four. -/
public theorem IsSuzukiMaximalNonsplit.normalizer_quotient {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U) :
    IsCyclic ((Subgroup.normalizer (U : Set (SuzukiMatrixGroup m))) ⧸
      U.subgroupOf (Subgroup.normalizer (U : Set (SuzukiMatrixGroup m)))) ∧
    Nat.card ((Subgroup.normalizer (U : Set (SuzukiMatrixGroup m))) ⧸
      U.subgroupOf (Subgroup.normalizer (U : Set (SuzukiMatrixGroup m)))) ∣ 4 := by
  have hk : U.normalizerMonoidHom.ker =
      U.subgroupOf (Subgroup.normalizer (U : Set (SuzukiMatrixGroup m))) := by
    rw [Subgroup.normalizerMonoidHom_ker, hU.centralizer_subgroup_eq hm]
  have h := nonsplit_normalizer_action hm hU
  let e := (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
    (QuotientGroup.quotientKerEquivRange U.normalizerMonoidHom)
  refine ⟨e.isCyclic.mpr h.1, ?_⟩
  rw [Nat.card_congr e.toEquiv]
  exact h.2

/-- Burnside transfer excludes a self-normalizing maximal nonsplit subgroup. -/
public theorem IsSuzukiMaximalNonsplit.normalizer_index_ne_one {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U) :
    U.relIndex (Subgroup.normalizer (U : Set (SuzukiMatrixGroup m))) ≠ 1 := by
  intro hindex
  have hN := Subgroup.relIndex_eq_one.mp hindex
  obtain ⟨p, hp, hpU⟩ := Nat.exists_prime_and_dvd
    (fun h => hU.ne_bot hm (Subgroup.card_eq_one.mp h))
  let : Fact p.Prime := ⟨hp⟩
  let := (External.huppert_blackburn_XI_3_6 m hm).1
  let := hU.isCyclic hm
  obtain ⟨P, hP⟩ := hU.exists_sylow_le hm hpU
  have hPne := P.ne_bot_of_dvd_card (hpU.trans U.card_subgroup_dvd_card)
  have hNP : Subgroup.normalizer (P : Set (SuzukiMatrixGroup m)) ≤
      Subgroup.centralizer (P : Set (SuzukiMatrixGroup m)) :=
    (hU.normalizer_le hm hP hPne).trans (hN.trans
      ((Subgroup.le_centralizer U).trans (Subgroup.centralizer_le hP)))
  let f := MonoidHom.transferSylow P hNP
  have hc := MonoidHom.ker_transferSylow_isComplement' P hNP
  rcases (inferInstance : f.ker.Normal).eq_bot_or_eq_top with hk | hk
  · have hinj : Function.Injective f := (MonoidHom.ker_eq_bot_iff f).mp hk
    let := suzukiMatrixGroup_isCyclic_of_card_dvd_sq_add_one m hm P
      (suzukiSylow_card_dvd_degree m hm (hpU.trans hU.card_dvd) P)
    let := isCyclic_of_injective f hinj
    exact External.suzukiMatrixGroup_not_isSolvable m hm inferInstance
  · have hd := hc.disjoint
    change Disjoint f.ker (P : Subgroup (SuzukiMatrixGroup m)) at hd
    rw [hk, top_disjoint] at hd
    exact hPne hd

/-- Every maximal nonsplit normalizer quotient has order two or four. -/
public theorem IsSuzukiMaximalNonsplit.normalizer_index {m : ℕ} (hm : 0 < m)
    {U : Subgroup (SuzukiMatrixGroup m)} (hU : IsSuzukiMaximalNonsplit m U) :
    U.relIndex (Subgroup.normalizer (U : Set (SuzukiMatrixGroup m))) = 2 ∨
    U.relIndex (Subgroup.normalizer (U : Set (SuzukiMatrixGroup m))) = 4 := by
  have hd := (hU.normalizer_quotient hm).2
  change U.relIndex (Subgroup.normalizer (U : Set (SuzukiMatrixGroup m))) ∣ 4 at hd
  have hn := hU.normalizer_index_ne_one hm
  have hcases : ∀ n : ℕ, n ∣ 4 → n = 1 ∨ n = 2 ∨ n = 4 := by
    intro n hn
    have hle := Nat.le_of_dvd (by decide : 0 < 4) hn
    interval_cases n <;> norm_num at *
  exact (hcases _ hd).resolve_left hn

