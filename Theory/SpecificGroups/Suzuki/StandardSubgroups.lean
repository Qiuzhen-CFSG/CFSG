module

public import BenderSuzuki.External.Huppert.XI.theorem_3_3

/-!
# Standard subgroups of the concrete Suzuki group

The root group, split torus and Borel subgroup are the restrictions to the
Suzuki matrix group of the corresponding matrix closures. Their basic
structure is transported from the coordinate calculations of
Huppert--Blackburn, *Finite Groups III*, XI.3.1 and XI.3.3.

The root group has order `q²` and exponent four. The split torus is cyclic
of order `q - 1`, normalizes the root group, and meets it trivially. Their
product is the Borel subgroup, of order `q²(q - 1)`. These named subgroups
supply the common interface for the torus and subgroup classification.
-/

namespace BenderSuzuki.MatrixGroups

open PFAppendixIII
open scoped Pointwise LinearAlgebra.Projectivization

/-- The root subgroup closure in the ambient general linear group. -/
@[expose] public noncomputable def SuzukiRootClosure (m : ℕ) :
    Subgroup (GL (Fin 4) (BinaryGaloisField (2 * m + 1))) :=
  Subgroup.closure {A | ∃ a b, A = SuzukiRootGL m a b}

/-- The split torus closure in the ambient general linear group. -/
@[expose] public noncomputable def SuzukiSplitTorusClosure (m : ℕ) :
    Subgroup (GL (Fin 4) (BinaryGaloisField (2 * m + 1))) :=
  Subgroup.closure {A | ∃ x, A = SuzukiTorusGL m x}

/-- The standard root subgroup of the Suzuki matrix group. -/
@[expose] public noncomputable def SuzukiRootSubgroup (m : ℕ) :
    Subgroup (SuzukiMatrixGroup m) :=
  (SuzukiRootClosure m).subgroupOf (SuzukiMatrixSubgroup m)

/-- The standard split torus of the Suzuki matrix group. -/
@[expose] public noncomputable def SuzukiSplitTorus (m : ℕ) :
    Subgroup (SuzukiMatrixGroup m) :=
  (SuzukiSplitTorusClosure m).subgroupOf (SuzukiMatrixSubgroup m)

/-- The standard Borel subgroup, restricted from the matrix closures. -/
@[expose] public noncomputable def SuzukiBorelSubgroup (m : ℕ) :
    Subgroup (SuzukiMatrixGroup m) :=
  (SuzukiRootClosure m ⊔ SuzukiSplitTorusClosure m).subgroupOf
    (SuzukiMatrixSubgroup m)

public theorem suzukiRootClosure_le (m : ℕ) :
    SuzukiRootClosure m ≤ SuzukiMatrixSubgroup m := by
  rw [SuzukiRootClosure, Subgroup.closure_le]
  intro A hA
  exact Subgroup.subset_closure (Or.inl hA)

public theorem suzukiSplitTorusClosure_le (m : ℕ) :
    SuzukiSplitTorusClosure m ≤ SuzukiMatrixSubgroup m := by
  rw [SuzukiSplitTorusClosure, Subgroup.closure_le]
  intro A hA
  exact Subgroup.subset_closure (Or.inr (Or.inl hA))

/-- The Borel is generated by the standard root group and split torus. -/
public theorem suzukiBorelSubgroup_eq_sup (m : ℕ) :
    SuzukiBorelSubgroup m = SuzukiRootSubgroup m ⊔ SuzukiSplitTorus m :=
  Subgroup.subgroupOf_sup (suzukiRootClosure_le m) (suzukiSplitTorusClosure_le m)

/-- Membership in the root group is given by the two root coordinates. -/
public theorem mem_suzukiRootSubgroup_iff (m : ℕ) (g : SuzukiMatrixGroup m) :
    g ∈ SuzukiRootSubgroup m ↔
      ∃ a b, (g : GL (Fin 4) (BinaryGaloisField (2 * m + 1))) =
        SuzukiRootGL m a b := by
  let K := BinaryGaloisField (2 * m + 1)
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
  have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) :=
    iterateFrobeniusEquiv_def K 2 (m + 1)
  exact External.suzukiRootGL_mem_closure_iff m pi
    (External.binaryGaloisField_tits_formula_sq m pi hpi) hpi g

/-- Membership in the split torus is given by a nonzero field parameter. -/
public theorem mem_suzukiSplitTorus_iff (m : ℕ) (g : SuzukiMatrixGroup m) :
    g ∈ SuzukiSplitTorus m ↔
      ∃ x, (g : GL (Fin 4) (BinaryGaloisField (2 * m + 1))) =
        SuzukiTorusGL m x :=
  External.suzukiTorusGL_mem_closure_iff m g

private theorem coordinate_structure (m : ℕ) (hm : 0 < m) :
    IsPGroup 2 (SuzukiRootClosure m) ∧
    (∀ x : SuzukiRootClosure m, x ^ 4 = 1) ∧
    Nat.card (SuzukiRootClosure m) = (2 ^ (2 * m + 1)) ^ 2 ∧
    Nonempty ((BinaryGaloisField (2 * m + 1))ˣ ≃* SuzukiSplitTorusClosure m) ∧
    Disjoint (SuzukiRootClosure m) (SuzukiSplitTorusClosure m) := by
  let K := BinaryGaloisField (2 * m + 1)
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
  have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) :=
    iterateFrobeniusEquiv_def K 2 (m + 1)
  rcases External.huppert_blackburn_XI_3_1 m hm pi
      (External.binaryGaloisField_tits_formula_sq m pi hpi) with
    ⟨_, _, hp, hpow, _, _, hcard, _, _, _, _, ⟨e, _⟩, _, hdisjoint, _⟩
  exact ⟨hp, hpow, hcard, ⟨e⟩, hdisjoint⟩

/-- The standard root group is a `2`-group. -/
public theorem suzukiRootSubgroup_isPGroup (m : ℕ) (hm : 0 < m) :
    IsPGroup 2 (SuzukiRootSubgroup m) :=
  (coordinate_structure m hm).1.of_equiv
    (Subgroup.subgroupOfEquivOfLe (suzukiRootClosure_le m)).symm

/-- Every element of the standard root group has fourth power one. -/
public theorem suzukiRootSubgroup_pow_four (m : ℕ) (hm : 0 < m)
    (x : SuzukiRootSubgroup m) : x ^ 4 = 1 := by
  let e : SuzukiRootSubgroup m ≃* SuzukiRootClosure m :=
    Subgroup.subgroupOfEquivOfLe (suzukiRootClosure_le m)
  apply e.injective
  rw [map_pow, map_one]
  exact (coordinate_structure m hm).2.1 (e x)

/-- The standard root group has order `q²`. -/
public theorem suzukiRootSubgroup_card (m : ℕ) (hm : 0 < m) :
    Nat.card (SuzukiRootSubgroup m) = (2 ^ (2 * m + 1)) ^ 2 := by
  exact (Nat.card_congr
    (Subgroup.subgroupOfEquivOfLe (suzukiRootClosure_le m)).toEquiv).trans
      (coordinate_structure m hm).2.2.1

/-- The standard root subgroup is a Sylow `2`-subgroup. -/
public theorem suzukiRootSubgroup_isSylow (m : ℕ) (hm : 0 < m) :
    ∃ P : Sylow 2 (SuzukiMatrixGroup m),
      (P : Subgroup (SuzukiMatrixGroup m)) = SuzukiRootSubgroup m := by
  let q := 2 ^ (2 * m + 1)
  have hqpos : 0 < q := by dsimp [q]; positivity
  have hqeven : Even q := even_two.pow_of_ne_zero (by omega)
  have hgcard : Nat.card (SuzukiMatrixGroup m) = (q ^ 2 + 1) * q ^ 2 * (q - 1) := by
    let K := BinaryGaloisField (2 * m + 1)
    let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
    have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) :=
      iterateFrobeniusEquiv_def K 2 (m + 1)
    exact (External.huppert_blackburn_XI_3_3 m hm pi hpi).2.2.2.2.2.2.1
  have hi : (SuzukiRootSubgroup m).index = (q ^ 2 + 1) * (q - 1) := by
    apply Nat.mul_left_cancel (pow_pos hqpos 2)
    calc
      q ^ 2 * (SuzukiRootSubgroup m).index = Nat.card (SuzukiMatrixGroup m) := by
        rw [← suzukiRootSubgroup_card m hm]
        exact (SuzukiRootSubgroup m).card_mul_index
      _ = q ^ 2 * ((q ^ 2 + 1) * (q - 1)) := by rw [hgcard]; ring
  have hodd : Odd (SuzukiRootSubgroup m).index := by
    rw [hi]
    exact (hqeven.pow_of_ne_zero (by decide : 2 ≠ 0)).add_one.mul
      (Nat.Even.sub_odd hqpos hqeven odd_one)
  have hnot : ¬ 2 ∣ (SuzukiRootSubgroup m).index := by
    intro h
    exact (Nat.not_even_iff_odd.mpr hodd) (even_iff_two_dvd.mpr h)
  exact ⟨(suzukiRootSubgroup_isPGroup m hm).toSylow hnot, rfl⟩

/-- The split torus is isomorphic to the multiplicative group of the field. -/
public theorem suzukiSplitTorus_equiv_units (m : ℕ) (hm : 0 < m) :
    Nonempty ((BinaryGaloisField (2 * m + 1))ˣ ≃* SuzukiSplitTorus m) := by
  obtain ⟨e⟩ := (coordinate_structure m hm).2.2.2.1
  exact ⟨e.trans (Subgroup.subgroupOfEquivOfLe (suzukiSplitTorusClosure_le m)).symm⟩

public theorem suzukiSplitTorus_isCyclic (m : ℕ) (hm : 0 < m) :
    IsCyclic (SuzukiSplitTorus m) := by
  obtain ⟨e⟩ := suzukiSplitTorus_equiv_units m hm
  exact e.isCyclic.mp inferInstance

public theorem suzukiSplitTorus_card (m : ℕ) (hm : 0 < m) :
    Nat.card (SuzukiSplitTorus m) = 2 ^ (2 * m + 1) - 1 := by
  obtain ⟨e⟩ := suzukiSplitTorus_equiv_units m hm
  rw [Nat.card_congr e.symm.toEquiv, Nat.card_units]
  congr 1
  exact GaloisField.card 2 (2 * m + 1) (by omega)

/-- The root group and split torus have trivial intersection. -/
public theorem suzukiRootSubgroup_disjoint_splitTorus (m : ℕ) (hm : 0 < m) :
    Disjoint (SuzukiRootSubgroup m) (SuzukiSplitTorus m) := by
  have hd := (coordinate_structure m hm).2.2.2.2
  apply disjoint_iff.mpr
  apply le_antisymm ?_ bot_le
  intro x hx
  apply Subgroup.mem_bot.mpr
  apply Subtype.ext
  exact Subgroup.mem_bot.mp (hd.le_bot ⟨hx.1, hx.2⟩)

/-- The split torus normalizes the root subgroup. -/
public theorem suzukiSplitTorus_le_normalizer_root (m : ℕ) :
    SuzukiSplitTorus m ≤ Subgroup.normalizer (SuzukiRootSubgroup m) := by
  let K := BinaryGaloisField (2 * m + 1)
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
  have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) :=
    iterateFrobeniusEquiv_def K 2 (m + 1)
  have hn := External.suzukiTorusClosure_le_normalizer_rootClosure m pi
    (External.binaryGaloisField_tits_formula_sq m pi hpi) hpi
  exact (Subgroup.comap_mono hn).trans
    (Subgroup.le_normalizer_comap (SuzukiMatrixSubgroup m).subtype)

/-- The root subgroup is normal in the Borel. -/
public theorem suzukiRootSubgroup_normal_in_borel (m : ℕ) :
    ((SuzukiRootSubgroup m).subgroupOf (SuzukiBorelSubgroup m)).Normal := by
  apply Subgroup.normal_subgroupOf_of_le_normalizer
  rw [suzukiBorelSubgroup_eq_sup]
  exact sup_le Subgroup.le_normalizer (suzukiSplitTorus_le_normalizer_root m)

/-- The Borel has order `q²(q - 1)`. -/
public theorem suzukiBorelSubgroup_card (m : ℕ) (hm : 0 < m) :
    Nat.card (SuzukiBorelSubgroup m) =
      (2 ^ (2 * m + 1)) ^ 2 * (2 ^ (2 * m + 1) - 1) := by
  let F := SuzukiRootSubgroup m
  let H := SuzukiSplitTorus m
  have hd : Disjoint F H := suzukiRootSubgroup_disjoint_splitTorus m hm
  have hn : H ≤ Subgroup.normalizer F := suzukiSplitTorus_le_normalizer_root m
  let f : F × H → ↥(F ⊔ H) := fun z =>
    ⟨(z.1 : SuzukiMatrixGroup m) * z.2, Subgroup.mul_mem_sup z.1.property z.2.property⟩
  have hi : Function.Injective f := by
    intro x y h
    exact Subgroup.mul_injective_of_disjoint hd (congrArg Subtype.val h)
  have hs : Function.Surjective f := by
    intro b
    have hb : (b : SuzukiMatrixGroup m) ∈ (F : Set (SuzukiMatrixGroup m)) * (H : Set (SuzukiMatrixGroup m)) := by
      rw [← Subgroup.coe_mul_of_right_le_normalizer_left F H hn]
      exact b.property
    obtain ⟨x, hx, y, hy, hxy⟩ := hb
    exact ⟨(⟨x, hx⟩, ⟨y, hy⟩), Subtype.ext hxy⟩
  rw [suzukiBorelSubgroup_eq_sup]
  calc
    Nat.card ↥(F ⊔ H) = Nat.card (F × H) :=
      Nat.card_congr (Equiv.ofBijective f ⟨hi, hs⟩).symm
    _ = Nat.card F * Nat.card H := Nat.card_prod F H
    _ = _ := by rw [suzukiRootSubgroup_card m hm, suzukiSplitTorus_card m hm]

/-- The standard Borel is the stabilizer of the point at infinity. -/
public theorem mem_suzukiBorelSubgroup_iff_fix_infinity
    (m : ℕ) (hm : 0 < m) (g : SuzukiMatrixGroup m) :
    g ∈ SuzukiBorelSubgroup m ↔
      (Matrix.GeneralLinearGroup.toLin
        (g : GL (Fin 4) (BinaryGaloisField (2 * m + 1)))).toLinearEquiv •
        Projectivization.mk (BinaryGaloisField (2 * m + 1))
          (![1, 0, 0, 0] : Fin 4 → BinaryGaloisField (2 * m + 1))
          (by simp) =
        Projectivization.mk (BinaryGaloisField (2 * m + 1))
          (![1, 0, 0, 0] : Fin 4 → BinaryGaloisField (2 * m + 1))
          (by simp) := by
  let K := BinaryGaloisField (2 * m + 1)
  let pi : K ≃+* K := iterateFrobeniusEquiv K 2 (m + 1)
  have hpi : ∀ x : K, pi x = x ^ (2 ^ (m + 1)) :=
    iterateFrobeniusEquiv_def K 2 (m + 1)
  exact ((External.huppert_blackburn_XI_3_3 m hm pi hpi).2.2.2.2.2.2.2 g).symm

end BenderSuzuki.MatrixGroups
