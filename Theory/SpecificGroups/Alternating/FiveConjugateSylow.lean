module
public import Theory.SpecificGroups.Alternating.FiveInvolutionFusion
public import Theory.SpecificGroups.PSL2.SylowFixedQuotients.Five
public import Theory.Representation.BinaryPermutation.CubicFixedSpace.Five

/-!
# Completing an elementary subgroup of A₅ to a Sylow four-group

A nontrivial elementary two-subgroup has order two or four. In the first
case, involution fusion carries it to one standard double transposition;
a conjugate supplies the other generator of a Klein four-group. Transport
back preserves the original subgroup and the actual conjugating element.

Source application: Aschbacher–Smith, 12.2.19, printed p.801, the quadratic
four-group generated by the two commuting images of V.
-/

@[expose] public section
open Subgroup
namespace Theory.SpecificGroups.Alternating.FiveConjugateSylow
open BinaryPermutation.CubicFixedSpace.Five
local notation "A5" => alternatingGroup (Fin 5)

private theorem first_order : orderOf first = 2 :=
  orderOf_eq_prime (by decide) (by decide +kernel)

private theorem second_order : orderOf second = 2 :=
  orderOf_eq_prime (by decide) (by decide +kernel)

theorem exists_conjugate_generating_sylow (E : Subgroup A5)
    [IsElementaryAbelian 2 E] (hne : E ≠ ⊥) :
    ∃ g : A5, ∃ P : Sylow 2 A5,
      E ⊔ E.map (MulAut.conj g).toMonoidHom = (P : Subgroup A5) := by
  obtain ⟨P,hP⟩ := (IsElementaryAbelian.isPGroup 2 E).exists_le_sylow
  have hfour := Theory.PSL2.SylowFixedQuotients.alternating_sylow_card P
  have hd : Nat.card E ∣ 4 := hfour ▸ card_dvd_of_le hP
  have hc : Nat.card E = 2 ∨ Nat.card E = 4 := by
    have he : Nat.card E ≠ 1 := fun hh => hne (Subgroup.card_eq_one.mp hh)
    have hp := Nat.card_pos (α := E)
    have hl := Nat.le_of_dvd (by decide : 0 < 4) hd
    have : Nat.card E = 1 ∨ Nat.card E = 2 ∨ Nat.card E = 4 := by
      obtain ⟨k, hk, he⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp
        (show Nat.card E ∣ 2 ^ 2 from hd)
      interval_cases k <;> simp_all
    tauto
  rcases hc with hc | hc
  · obtain ⟨a,ha,ha1⟩ := E.bot_or_exists_ne_one.resolve_left hne
    have hao : orderOf a = 2 := orderOf_eq_prime
      (elemPow_eq_one_of_isElementaryAbelian a ha) ha1
    obtain ⟨g,hg⟩ := isConj_iff.mp (alternatingGroup.five_involutions_isConj a first hao first_order)
    have he : E.map (MulAut.conj g).toMonoidHom = zpowers first := by
      symm
      apply eq_of_le_of_card_ge
      · exact zpowers_le.mpr (hg ▸ mem_map_of_mem (MulAut.conj g).toMonoidHom ha)
      · rw [card_map_of_injective (MulAut.conj g).injective, hc, Nat.card_zpowers, first_order]
    obtain ⟨b,hb⟩ := isConj_iff.mp
      (alternatingGroup.five_involutions_isConj first second first_order second_order)
    have heb : (E.map (MulAut.conj g).toMonoidHom).map (MulAut.conj b).toMonoidHom =
        zpowers second := by
      rw [he, MonoidHom.map_zpowers]
      exact congrArg zpowers hb
    obtain ⟨Q,hQ⟩ := klein_isPGroup.exists_le_sylow
    have hgen : zpowers first ⊔ zpowers second = (Q : Subgroup A5) := by
      have hi : zpowers first ⊔ zpowers second ≤ (Q : Subgroup A5) :=
        sup_le (zpowers_le.mpr (hQ first_mem)) (zpowers_le.mpr (hQ second_mem))
      apply eq_of_le_of_card_ge hi
      have hd := card_dvd_of_le hi
      rw [Theory.PSL2.SylowFixedQuotients.alternating_sylow_card] at hd ⊢
      have hl : 2 ≤ Nat.card (zpowers first ⊔ zpowers second : Subgroup A5) := by
        rw [← first_order, ← Nat.card_zpowers]
        exact card_le_of_le le_sup_left
      have hn : Nat.card (zpowers first ⊔ zpowers second : Subgroup A5) ≠ 2 := by
        intro hh
        have hh' : zpowers first = zpowers first ⊔ zpowers second :=
          eq_of_le_of_card_ge le_sup_left (by rw [hh, Nat.card_zpowers, first_order])
        have hm : second ∈ zpowers first := hh'.symm ▸ mem_sup_right (mem_zpowers second)
        have hm' : second = 1 ∨ second = first := by
          rw [mem_zpowers_iff_mem_range_orderOf, first_order] at hm
          obtain ⟨n,hn,he⟩ := Finset.mem_image.mp hm
          have hn' := Finset.mem_range.mp hn
          rcases (by omega : n = 0 ∨ n = 1) with rfl | rfl
          · exact Or.inl (by simpa only [pow_zero] using he.symm)
          · exact Or.inr (by simpa only [pow_one] using he.symm)
        rcases hm' with hm' | hm'
        · exact (by decide +kernel : second ≠ 1) hm'
        · exact (by decide +kernel : second ≠ first) hm'
      have hu := Nat.le_of_dvd (by decide : 0 < 4) hd
      obtain ⟨k, hk, he⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp
        (show Nat.card (zpowers first ⊔ zpowers second : Subgroup A5) ∣ 2 ^ 2 from hd)
      interval_cases k <;> simp_all
    let c := (MulAut.conj g).symm b
    let R := Q.mapSurjective (f := (MulAut.conj g).symm.toMonoidHom) (MulAut.conj g).symm.surjective
    refine ⟨c,R,?_⟩
    apply map_injective (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective
    rw [Subgroup.map_sup, he]
    have hcomm : (E.map (MulAut.conj c).toMonoidHom).map (MulAut.conj g).toMonoidHom =
        (E.map (MulAut.conj g).toMonoidHom).map (MulAut.conj b).toMonoidHom := by
      rw [map_map,map_map]
      apply congrArg (fun f : A5 →* A5 => E.map f)
      apply MonoidHom.ext
      intro x
      change g * (c * x * c⁻¹) * g⁻¹ = b * (g * x * g⁻¹) * b⁻¹
      change g * ((g⁻¹ * b * g) * x * (g⁻¹ * b * g)⁻¹) * g⁻¹ = _
      group
    rw [hcomm, heb, hgen]
    change (Q : Subgroup A5) = ((Q : Subgroup A5).map
      (MulAut.conj g).symm.toMonoidHom).map (MulAut.conj g).toMonoidHom
    rw [map_map]
    simp
  · have he : E = (P : Subgroup A5) := eq_of_le_of_card_ge hP (by omega)
    refine ⟨1,P,?_⟩
    have hi : (MulAut.conj (1 : A5)).toMonoidHom = MonoidHom.id A5 := by ext a; simp
    rw [hi, map_id, sup_idem, he]
end Theory.SpecificGroups.Alternating.FiveConjugateSylow

