module
public import Theory.SpecificGroups.AlternatingSixNormalizer
public import Theory.Alternating.Aut
public import Theory.GroupTheory.SolvableOuterQuotient

/-!
# Symmetric-eight extensions forced by normalized two-subgroups

A nontrivial two-subgroup of S8 normalized by an even subgroup with a
factor five has trivial even intersection: the A8 two-local normalizers
are prime to five. It consequently has order two, and the involution
centralizer orders force its generator to be a transposition.

Faithful conjugation on a self-centralizing normal A8 extends its actual
marking into S8. The normalized two-subgroup supplies a transposition, so
this embedding is onto. Its normalizer meets every Sylow two-subgroup in
index at least four, since a transposition centralizer has order 1440
whereas a Sylow two-subgroup of S8 has order 128.

The consumer is the literal K_v S/O2(K_v S) quotient in original 12.6.17.
Source: Aschbacher--Smith, combined manuscript of 1 March 2004,
printed p.827, using the binary-four two-local geometry and Aut(A8)=S8.
-/

public noncomputable section
open Subgroup Equiv Theory.GroupTheory
namespace Theory.SpecificGroups.Alternating.EightSectionExtension

private theorem normalized_two_even_intersection
    (Q N : Subgroup (Perm (Fin 8))) (hQ : IsPGroup 2 Q)
    (hN : N ≤ alternatingGroup (Fin 8)) (hn : N ≤ normalizer (Q : Set _))
    (h5 : 5 ∣ Nat.card N) : Q ⊓ alternatingGroup (Fin 8) = ⊥ := by
  have he : Q.subgroupOf (alternatingGroup (Fin 8)) = ⊥ := by
    by_contra he
    apply AlternatingSixNormalizer.eight_five_not_dvd_normalizer _ hQ.comap_subtype he
    have hNN : N.subgroupOf (alternatingGroup (Fin 8)) ≤
        normalizer (Q.subgroupOf (alternatingGroup (Fin 8)) : Set _) := by
      intro x hx
      apply mem_normalizer_iff.mpr
      intro y
      exact mem_normalizer_iff.mp (hn hx) y.val
    have hc : Nat.card (N.subgroupOf (alternatingGroup (Fin 8))) = Nat.card N :=
      Nat.card_congr (subgroupOfEquivOfLe hN).toEquiv
    exact (hc.symm ▸ h5).trans (card_dvd_of_le hNN)
  have hh := congrArg (map (alternatingGroup (Fin 8)).subtype) he
  simpa only [subgroupOf_map_subtype,Subgroup.map_bot] using hh

/-- A nontrivial two-subgroup normalized by an even subgroup with a factor five
is generated by a transposition. -/
theorem normalized_two_is_transposition
    (Q N : Subgroup (Perm (Fin 8))) (hQ : IsPGroup 2 Q) (hne : Q ≠ ⊥)
    (hN : N ≤ alternatingGroup (Fin 8)) (hn : N ≤ normalizer (Q : Set _))
    (h5 : 5 ∣ Nat.card N) :
    ∃ t : Perm (Fin 8), t.IsSwap ∧ Q = zpowers t ∧
      normalizer (Q : Set _) ≤ centralizer ({t} : Set _) := by
  have he := normalized_two_even_intersection Q N hQ hN hn h5
  have hcard : Nat.card Q = 2 := by
    let f := Perm.sign.comp Q.subtype
    have hf : Function.Injective f := by
      apply (MonoidHom.ker_eq_bot_iff f).mp
      apply bot_unique
      intro x hx
      apply Subtype.ext
      apply mem_bot.mp
      rw [←he]
      exact ⟨x.property,Perm.mem_alternatingGroup.mpr hx⟩
    have hl := Nat.card_le_card_of_injective f hf
    have hgt : 1 < Nat.card Q := Finite.one_lt_card_iff_nontrivial.mpr
      ((nontrivial_iff_ne_bot Q).mpr hne)
    have hc : Nat.card (ℤˣ) = 2 := by simp [Nat.card_eq_fintype_card]
    rw [hc] at hl
    omega
  obtain ⟨t,ht,hall⟩ := (Nat.card_eq_two_iff' (1 : Q)).mp hcard
  have ht0 : (t : Perm (Fin 8)) ≠ 1 := fun hh => ht (Subtype.ext hh)
  have ht2 : (t : Perm (Fin 8)) ^ 2 = 1 := by
    have hh : t ^ Nat.card Q = 1 := pow_card_eq_one'
    rw [hcard] at hh
    exact congrArg Subtype.val hh
  have hNC : normalizer (Q : Set _) ≤ centralizer ({(t : Perm (Fin 8))} : Set _) :=
    (normalizer_le_centralizer_of_card_two Q hcard).trans
      (centralizer_le (Set.singleton_subset_iff.mpr t.property))
  have hfive := h5.trans (card_dvd_of_le (hn.trans hNC))
  have hcycle := Perm.cycleType_of_pow_prime_eq_one ht2
  have hs := (t : Perm (Fin 8)).sum_cycleType_le
  rw [hcycle,Multiset.sum_replicate] at hs
  have hp : 0 < (t : Perm (Fin 8)).cycleType.card := by
    apply Nat.pos_of_ne_zero
    intro hh
    exact ht0 (Perm.cycleType_eq_zero.mp (Multiset.card_eq_zero.mp hh))
  have hb : (t : Perm (Fin 8)).cycleType.card ≤ 4 := by
    simp only [nsmul_eq_mul,Nat.cast_id,Fintype.card_fin] at hs
    omega
  have h1 : (t : Perm (Fin 8)).cycleType.card = 1 := by
    rw [Perm.nat_card_centralizer,hcycle] at hfive
    interval_cases hh : (t : Perm (Fin 8)).cycleType.card <;>
      first | rfl | norm_num [Nat.factorial] at hfive
  refine ⟨t,Perm.isSwap_iff_cycleType.mpr (by rw [hcycle,h1]; rfl),?_,hNC⟩
  apply le_antisymm _ (zpowers_le.mpr t.property)
  intro q hq
  by_cases hq1 : q = 1
  · simpa only [hq1] using (zpowers (t : Perm (Fin 8))).one_mem
  · have hqt := congrArg Subtype.val (hall ⟨q,hq⟩ (fun hh => hq1 (congrArg Subtype.val hh)))
    change q = (t : Perm (Fin 8)) at hqt
    rw [hqt]
    exact mem_zpowers (t : Perm (Fin 8))

/-- Faithful conjugation on the marked normal A8, including its exact image. -/
theorem exists_embedding {G : Type*} [Group G]
    (B : Subgroup G) [B.Normal] (eB : B ≃* alternatingGroup (Fin 8))
    (hc : centralizer (B : Set G) = ⊥) :
    ∃ f : G →* Perm (Fin 8), Function.Injective f ∧
      (∀ b : B, f b = (eB b).val) ∧ B.map f = alternatingGroup (Fin 8) := by
  let c : Perm (Fin 8) ≃* MulAut (alternatingGroup (Fin 8)) :=
    MulEquiv.ofBijective MulAut.conjNormal
      (GroupTheory.AutAlternating.aut_alternatingGroup_bijective_conj 8 (by decide) (by decide))
  let f : G →* Perm (Fin 8) :=
    c.symm.toMonoidHom.comp ((MulAut.congr eB).toMonoidHom.comp MulAut.conjNormal)
  have hf : Function.Injective f := c.symm.injective.comp
    ((MulAut.congr eB).injective.comp (MulAut.conjNormal_injective_of_centralizer_eq_bot B hc))
  have hfb (b : B) : f b = (eB b : Perm (Fin 8)) := by
    apply c.injective
    change c (c.symm ((MulAut.congr eB) (MulAut.conjNormal (b : G)))) =
      MulAut.conjNormal (eB b : Perm (Fin 8))
    rw [c.apply_symm_apply,MulAut.conjNormal_val,MulAut.congr_conj,MulAut.conjNormal_val]
  refine ⟨f,hf,hfb,?_⟩
  ext x
  constructor
  · rintro ⟨b,hb,rfl⟩
    rw [hfb ⟨b,hb⟩]
    exact (eB ⟨b,hb⟩).property
  · intro hx
    obtain ⟨b,hb⟩ := eB.surjective ⟨x,hx⟩
    exact ⟨b,b.property,(hfb b).trans (congrArg Subtype.val hb)⟩

/-- The normalized two-subgroup forces the full symmetric extension, with
its original A8 marking and its transposition retained. -/
theorem exists_symmetric_equiv {G : Type*} [Group G] [Finite G]
    (B N Q : Subgroup G) [B.Normal] (eB : B ≃* alternatingGroup (Fin 8))
    (hc : centralizer (B : Set G) = ⊥)
    (hNB : N ≤ B) (h5 : 5 ∣ Nat.card N)
    (hQ : IsPGroup 2 Q) (hne : Q ≠ ⊥) (hn : N ≤ normalizer (Q : Set G)) :
    ∃ e : G ≃* Perm (Fin 8), (∀ b : B, e b = (eB b).val) ∧
      B.map e.toMonoidHom = alternatingGroup (Fin 8) ∧
      ∃ t : Perm (Fin 8), t.IsSwap ∧ Q.map e.toMonoidHom = zpowers t ∧
        normalizer (Q.map e.toMonoidHom : Set _) ≤ centralizer ({t} : Set _) := by
  obtain ⟨f,hf,hfb,hB⟩ := exists_embedding B eB hc
  obtain ⟨t,ht,hQeq,hNC⟩ := normalized_two_is_transposition (Q.map f) (N.map f)
    (hQ.map _) (fun hh => hne ((map_eq_bot_iff_of_injective _ hf).mp hh))
    ((map_mono hNB).trans_eq hB) ((map_mono hn).trans (Q.le_normalizer_map f))
    (by rwa [card_map_of_injective hf])
  have htR : t ∈ f.range := (map_le_range f Q) (hQeq.symm ▸ mem_zpowers t)
  have hAlt : alternatingGroup (Fin 8) ≤ f.range := hB ▸ map_le_range f B
  have hsurj : Function.Surjective f := by
    intro p
    have hp : p ∈ f.range := by
      rcases Int.units_eq_one_or (Perm.sign p) with hp | hp
      · exact hAlt (Perm.mem_alternatingGroup.mpr hp)
      · have hpt : p * t ∈ f.range := hAlt (Perm.mem_alternatingGroup.mpr (by
          rw [map_mul,hp,ht.sign_eq]; norm_num))
        simpa only [mul_inv_cancel_right] using f.range.mul_mem hpt (f.range.inv_mem htR)
    exact hp
  exact ⟨MulEquiv.ofBijective f ⟨hf,hsurj⟩,hfb,hB,t,ht,hQeq,hNC⟩

/-- The transposition normalizer has index at least four in every Sylow two-subgroup. -/
theorem transposition_normalizer_index
    (Q : Subgroup (Perm (Fin 8))) (t : Perm (Fin 8)) (ht : t.IsSwap)
    (hN : normalizer (Q : Set _) ≤ centralizer ({t} : Set _))
    (P : Sylow 2 (Perm (Fin 8))) :
    4 ≤ (normalizer (Q : Set _)).relIndex (P : Subgroup (Perm (Fin 8))) := by
  let N := normalizer (Q : Set (Perm (Fin 8)))
  have hP : Nat.card P = 128 := by
    rw [P.card_eq_multiplicity]
    have hc : Nat.card (Perm (Fin 8)) = 40320 := by
      rw [Nat.card_eq_fintype_card,Fintype.card_perm,Fintype.card_fin]
      decide
    rw [hc,show 40320 = 2^7*315 from rfl,
      Nat.factorization_mul (by decide) (by decide),Nat.factorization_pow]
    norm_num [Nat.prime_two.factorization,
      Nat.factorization_eq_zero_of_not_dvd (by decide : ¬ 2 ∣ 315)]
  have hC : Nat.card (centralizer ({t} : Set (Perm (Fin 8)))) = 1440 := by
    rw [Perm.nat_card_centralizer,Perm.isSwap_iff_cycleType.mp ht]
    norm_num [Nat.factorial]
  have h128 : Nat.card (N ⊓ (P : Subgroup (Perm (Fin 8))) : Subgroup _) ∣ 128 :=
    hP ▸ card_dvd_of_le inf_le_right
  have h1440 : Nat.card (N ⊓ (P : Subgroup (Perm (Fin 8))) : Subgroup _) ∣ 1440 :=
    hC ▸ card_dvd_of_le (inf_le_left.trans hN)
  have h32 : Nat.card (N ⊓ (P : Subgroup (Perm (Fin 8))) : Subgroup _) ≤ 32 :=
    Nat.le_of_dvd (by decide) (show Nat.card (N ⊓ (P : Subgroup (Perm (Fin 8))) : Subgroup _) ∣ 32 from
      Nat.dvd_gcd h128 h1440)
  have hm := (N.subgroupOf (P : Subgroup (Perm (Fin 8)))).card_mul_index
  rw [Nat.card_congr (subgroupOfEquivOfLe (show N ⊓ (P : Subgroup (Perm (Fin 8))) ≤
    (P : Subgroup (Perm (Fin 8))) from inf_le_right)).symm.toEquiv] at h32
  rw [inf_subgroupOf_right] at h32
  change Nat.card (N.subgroupOf (P : Subgroup (Perm (Fin 8)))) * N.relIndex (P : Subgroup (Perm (Fin 8))) = _ at hm
  rw [hP] at hm
  change 4 ≤ N.relIndex (P : Subgroup (Perm (Fin 8)))
  nlinarith

/-- The literal A8 extension and the normalized two-subgroup force the
source's lower bound, independent of any presumed whole-group identification. -/
theorem four_le_normalizer_index {G : Type*} [Group G] [Finite G]
    (B N Q : Subgroup G) [B.Normal] (eB : B ≃* alternatingGroup (Fin 8))
    (hc : centralizer (B : Set G) = ⊥)
    (hNB : N ≤ B) (h5 : 5 ∣ Nat.card N)
    (hQ : IsPGroup 2 Q) (hne : Q ≠ ⊥) (hn : N ≤ normalizer (Q : Set G))
    (P : Sylow 2 G) : 4 ≤ (normalizer (Q : Set G)).relIndex (P : Subgroup G) := by
  obtain ⟨e,_,_,t,ht,_,hN⟩ := exists_symmetric_equiv B N Q eB hc hNB h5 hQ hne hn
  have hh := transposition_normalizer_index (Q.map e.toMonoidHom) t ht hN
    (P.mapSurjective (f := e.toMonoidHom) e.surjective)
  change 4 ≤ (normalizer (Q.map e.toMonoidHom : Set _)).relIndex
    ((P : Subgroup G).map e.toMonoidHom) at hh
  rwa [←map_equiv_normalizer_eq,relIndex_map_map,
    (MonoidHom.ker_eq_bot_iff e.toMonoidHom).mpr e.injective,sup_bot_eq,sup_bot_eq] at hh

end Theory.SpecificGroups.Alternating.EightSectionExtension

namespace Theory.SpecificGroups.Alternating.EightSectionExtension
open Subgroup
variable {G : Type*} [Group G]

/-- A subgroup with a factor five inside a marked A8 has trivial two-core. -/
theorem twoCore_eq_bot_of_five (B N : Subgroup G)
    (eB : B ≃* alternatingGroup (Fin 8)) (hNB : N ≤ B) (h5 : 5 ∣ Nat.card N) :
    pCore 2 N = ⊥ := by
  let f : N →* alternatingGroup (Fin 8) := eB.toMonoidHom.comp (inclusion hNB)
  have hf : Function.Injective f := eB.injective.comp (inclusion_injective hNB)
  by_contra hne
  have hQ : (pCore 2 N).map f ≠ ⊥ :=
    fun hh => hne ((map_eq_bot_iff_of_injective _ hf).mp hh)
  apply Theory.SpecificGroups.AlternatingSixNormalizer.eight_five_not_dvd_normalizer
    ((pCore 2 N).map f) (pCore_isPGroup.map f) hQ
  have hn : f.range ≤ normalizer ((pCore 2 N).map f : Set (alternatingGroup (Fin 8))) := by
    simpa only [normalizer_eq_top,←MonoidHom.range_eq_map] using (pCore 2 N).le_normalizer_map f
  have hc : Nat.card f.range = Nat.card N := Nat.card_congr (MonoidHom.ofInjective hf).toEquiv.symm
  exact (hc.symm ▸ h5).trans (card_dvd_of_le hn)
end Theory.SpecificGroups.Alternating.EightSectionExtension
