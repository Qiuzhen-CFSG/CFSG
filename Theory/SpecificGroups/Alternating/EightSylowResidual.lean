/-!
# Residuals in Sylow two-overgroups of A₈

For every subgroup H of A₈ containing a full Sylow two-subgroup,
O²(H) = O^{3′}(H). Transport to the actual binary linear four-space, conjugate
the Sylow to the upper unitriangular group, and apply Bruhat elimination.
An overgroup is generated by the upper group and its available adjacent swaps.
Each swap is an upper transvection times a cubic element, so the quotient by
O^{3′}(H) is a two-group. The reverse inclusion holds in every finite group.

This intrinsic model calculation supplies the missing input to the literal
quotient-image consumer `omega_local_residuals_eq_of_alternatingEight_sylow_residuals`
in `CFSG.Quasithin.Chapter12.Section02.RecognitionSource.FusionReducibleNormalizerAmbientResidual`.
It is the model residual step used in Aschbacher–Smith 3.3.21(e), printed p.596;
it does not assert the surrounding source contradiction or identify its module.
-/

namespace BinaryLinear.FourSylowResidual
open OuterCyclic Subgroup

private theorem residuals_of_equiv {G K : Type*} [Group G] [Finite G] [Group K]
    (e : G ≃* K) (h : pResidual 2 G = primeToResidual 3 G) :
    pResidual 2 K = primeToResidual 3 K := by
  have hh := congrArg (fun U : Subgroup G => U.map e.toMonoidHom) h
  rwa [map_pResidual_of_surjective 2 e.toMonoidHom e.surjective,
    map_primeToResidual e] at hh

/-- The comparison for every Sylow overgroup in the actual binary linear model. -/
public theorem sylow_overgroup_residuals (S : Sylow 2 (LinearGroup 4))
    (H : Subgroup (LinearGroup 4)) (hSH : (S : Subgroup _) ≤ H) :
    pResidual 2 H = primeToResidual 3 H := by
  let : Finite (LinearGroup 4) := Finite.of_injective
    (fun g : LinearGroup 4 => (g : Space 4 → Space 4)) DFunLike.coe_injective
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (LinearGroup 4) standardSylow S
  let e := MulAut.conj g
  have hmap : standardBorel.map e.toMonoidHom = (S : Subgroup (LinearGroup 4)) := by
    rw [← standardSylow_coe]
    change ((g • standardSylow : Sylow 2 (LinearGroup 4)) : Subgroup (LinearGroup 4)) =
      (S : Subgroup (LinearGroup 4))
    rw [hg]
  let Q := H.map e.symm.toMonoidHom
  have hBQ : standardBorel ≤ Q := by
    intro b hb
    apply Subgroup.mem_map_equiv.mpr
    exact hSH (hmap ▸ Subgroup.mem_map.mpr ⟨b, hb, rfl⟩)
  exact residuals_of_equiv (e.symm.subgroupMap H).symm (borel_overgroup_residuals Q hBQ)

end BinaryLinear.FourSylowResidual

namespace AlternatingEight
open Subgroup BinaryLinear.OuterCyclic

/-- Every subgroup of the concrete alternating group A₈ containing a full
Sylow two-subgroup has equal two-residual and prime-to-three residual. -/
public theorem sylow_overgroup_residuals
    (S : Sylow 2 (alternatingGroup (Fin 8)))
    (H : Subgroup (alternatingGroup (Fin 8))) (hSH : (S : Subgroup _) ≤ H) :
    pResidual 2 H = primeToResidual 3 H := by
  let : Finite (LinearGroup 4) := Finite.of_injective
    (fun g : LinearGroup 4 => (g : Space 4 → Space 4)) DFunLike.coe_injective
  let e : alternatingGroup (Fin 8) ≃* LinearGroup 4 :=
    Atlas.Comparisons.Exceptional.alt8EquivPSL4Two.trans (projectiveEquivLinear (by decide))
  have h := BinaryLinear.FourSylowResidual.sylow_overgroup_residuals
    (S.mapSurjective (f := e.toMonoidHom) e.surjective) (H.map e.toMonoidHom)
    (Subgroup.map_mono (f := e.toMonoidHom) hSH)
  exact BinaryLinear.FourSylowResidual.residuals_of_equiv (e.subgroupMap H).symm h

end AlternatingEight
