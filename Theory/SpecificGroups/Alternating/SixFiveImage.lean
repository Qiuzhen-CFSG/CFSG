module

public import Theory.GroupTheory.SolvableRadical.NormalTwoExtension
public import Theory.GroupTheory.PCoreFrattiniTransport
public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Theory.GroupAction.SimpleCosets
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple
public import Mathlib.Tactic.NormNum

/-!
# Images of perfect A₅ two-extensions in A₆

A subgroup of A₆ with two-core quotient A₅ has trivial two-core: its
order is sixty times a power of two, and a nontrivial core would give an
impossible index-three subgroup of the simple group A₆. Thus a perfect
group with two-core quotient A₅, mapped into A₆ with solvable kernel,
has actual image A₅. The equivalence preserves the quotient projection.
Such a perfect group is also its own prime-to-three residual.

These are the image and residual-inclusion steps of Aschbacher--Smith,
3.3.22, printed p.598. No assertion about ambient fusion is used.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
namespace Theory.SpecificGroups.Alternating.SixFiveImage
local notation "A6" => alternatingGroup (Fin 6)
local notation "A5" => alternatingGroup (Fin 5)
/-- A two-extension of A₅ inside A₆ has trivial two-core. -/
theorem twoCore_eq_bot (B : Subgroup A6) (e : (B ⧸ pCore 2 B) ≃* A5) :
    pCore 2 B = ⊥ := by
  have hcard : Nat.card A6 = 360 := by
    rw [nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  have hquot : Nat.card (B ⧸ pCore 2 B) = 60 := by
    rw [Nat.card_congr e.toEquiv, nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  have hB : Nat.card B = 60 * Nat.card (pCore 2 B) := by
    rw [card_eq_card_quotient_mul_card_subgroup (pCore 2 B), hquot]
  have hd : Nat.card (pCore 2 B) ∣ 6 := by
    have h := B.card_subgroup_dvd_card
    rw [hB, hcard] at h
    exact Nat.dvd_of_mul_dvd_mul_left (by decide : 0 < 60) h
  have hcop : Nat.Coprime (Nat.card (pCore 2 B)) 3 := by
    obtain ⟨n, hn⟩ := (pCore_isPGroup (p := 2) (G := B)).exists_card_eq
    rw [hn]
    exact (by decide : Nat.Coprime 2 3).pow_left n
  have hd2 : Nat.card (pCore 2 B) ∣ 2 := hcop.dvd_mul_right.mp hd
  rcases (Nat.dvd_prime Nat.prime_two).mp hd2 with h1 | h2
  · exact card_eq_one.mp h1
  have hi : B.index = 3 := by
    have h := B.card_mul_index
    rw [hB, h2, hcard] at h
    omega
  have hne : B ≠ ⊤ := by
    intro he
    rw [he, index_top] at hi
    contradiction
  let : IsSimpleGroup A6 := alternatingGroup.isSimpleGroup (by simp)
  have h := B.card_dvd_factorial_index_of_simple hne
  rw [hcard, hi] at h
  norm_num [Nat.factorial] at h

variable {K : Type*} [Group K] [Finite K]
/-- The restricted solvable kernel is exactly the original two-core. -/
theorem image_ker_eq_core (q : K →* A6) (A : Subgroup K) [Group.IsPerfect A]
    [Group.IsSolvable (q.subgroupMap A).ker]
    (e : (A ⧸ pCore 2 A) ≃* A5) : (q.subgroupMap A).ker = pCore 2 A := by
  let : IsSimpleGroup A5 := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup (A ⧸ pCore 2 A) := e.isSimpleGroup
  have hle : (q.subgroupMap A).ker ≤ pCore 2 A := by
    rw [← radical_eq_core_of_perfect_simple_core_quotient]
    exact le_solvableRadical _ inferInstance inferInstance
  have hk : IsPGroup 2 (q.subgroupMap A).ker :=
    pCore_isPGroup.of_injective (inclusion hle) (inclusion_injective hle)
  have hbot := twoCore_eq_bot (A.map q)
    (((q.subgroupMap A).pCoreQuotientEquiv (q.subgroupMap_surjective A) hk).symm.trans e)
  have h := (q.subgroupMap A).comap_pCore_of_ker_isPGroup (q.subgroupMap_surjective A) hk
  rwa [hbot] at h

/-- The actual subgroup image is A₅, using its original quotient marking. -/
def imageEquiv (q : K →* A6) (A : Subgroup K) [Group.IsPerfect A]
    [Group.IsSolvable (q.subgroupMap A).ker]
    (e : (A ⧸ pCore 2 A) ≃* A5) : A.map q ≃* A5 :=
  ((QuotientGroup.quotientKerEquivOfSurjective (q.subgroupMap A)
    (q.subgroupMap_surjective A)).symm.trans
      (QuotientGroup.quotientMulEquivOfEq (image_ker_eq_core q A e))).trans e

/-- The image identification commutes with the original projection. -/
theorem imageEquiv_apply (q : K →* A6) (A : Subgroup K) [Group.IsPerfect A]
    [Group.IsSolvable (q.subgroupMap A).ker]
    (e : (A ⧸ pCore 2 A) ≃* A5) (x : A) :
    imageEquiv q A e ((q.subgroupMap A) x) = e (QuotientGroup.mk' (pCore 2 A) x) := by
  let d := QuotientGroup.quotientKerEquivOfSurjective (q.subgroupMap A)
    (q.subgroupMap_surjective A)
  have hd : d (QuotientGroup.mk' (q.subgroupMap A).ker x) = (q.subgroupMap A) x := rfl
  change e ((QuotientGroup.quotientMulEquivOfEq (image_ker_eq_core q A e))
    (d.symm ((q.subgroupMap A) x))) = _
  rw [← hd, MulEquiv.symm_apply_apply]
  rfl

variable [Group.IsPerfect K]
/-- A perfect two-extension of A₅ is generated by its three-elements. -/
theorem primeToThreeResidual_eq_top (e : (K ⧸ pCore 2 K) ≃* A5) :
    primeToResidual 3 K = ⊤ := by
  let : IsSimpleGroup A5 := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup (K ⧸ pCore 2 K) := e.isSimpleGroup
  have hp : IsPPerfect 2 K := by
    intro N hN hquot
    let := hN
    have hs : Subsingleton (K ⧸ N) := by
      by_contra! hn
      exact Group.IsPerfect.not_isNilpotent (K ⧸ N) hquot.isNilpotent
    apply eq_top_iff.mpr
    intro x _
    exact (QuotientGroup.eq_one_iff x).mp (Subsingleton.elim _ _)
  apply primeToResidual_eq_top_of_simple_quotient 3 2 (pCore 2 K) pCore_isPGroup hp
  rw [Nat.card_congr e.toEquiv, nat_card_alternatingGroup]
  norm_num [Nat.factorial]
end Theory.SpecificGroups.Alternating.SixFiveImage
