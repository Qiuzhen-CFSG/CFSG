/-!
# The 9-point mixed-pair count

The complete centralizer table leaves 45 four-transposition and 38
double-transposition involutions. The kernel checks each product order by
checking its defining power and every smaller positive power, then checks the
half-order equation. Summing the 45 disjoint rows gives 555 ordered pairs.
The order data use four bits per entry; all entries are at most twelve.

Source: Aschbacher, “A 2-local characterization of M12”, Proposition 3.3, p.38.
-/

namespace alternatingGroup.EightNineInvolutionCounts.Nine
open Equiv Equiv.Perm
open Theory.GroupTheory.TwoInvolutionClassOrder

private def productOrderData (i : Fin 45) : ℕ :=
  #[761387512729312711571931015040712161569818210, 761387512729312711571931015040712161569818210, 761385334922291531229702734687092518175254114, 762127955817089851397826676843357794728166950, 762127955817089851397826676843357794728166950, 761570445683144046745786906797844487215392294, 761384609030766716886780634016425096184611430, 761384609030766716886780634016425096184611430, 761383885897628034173361174258740331163034214, 761387512729312731374135940328404012813798050, 761387512729312731374135940328404012813798050, 761385334922294244131777499091904132844636834, 762125074715398215193192663022361919787682410, 762125074715398215193192663022361919787682410, 761569725407721137694628299579561000930011754, 761384609030766697084575777904089490836964010, 761384609030766697084575777904089490836964010, 761384606173048230322444947896855369198355114, 762127955817170981031405580245398798446381610, 762127955817170981031405580245398798446381610, 761570445694258806546096672887032137262582314, 762125074715479325024566641136843013531421350, 762125074715479325024566641136843013531421350, 761569725418833184592863301264068977577323174, 761384609030685587253200623808468634514506410, 761384609030685587253200623808468634514506410, 761199495389971621009891947782259392762888874, 762127955817170961229199400580372172091181610, 762127955817170961229199400580372172091181610, 761570442869649296358439348864478598245141034, 762125074715479344826770381222292457333245610, 762125074715479344826770381222292457333245610, 761569002318806191158197106358660628759340714, 761387512729231601740556958525382926522403490, 761387512729231601740556958525382926522403490, 761200221314608124631569526912381013777992354, 761384608986459117032763902583288717116229290, 761384608986459117032763902583288717116229290, 761383885886429409380391715201269349677950634, 761384608986459117032763971758513021759834790, 761384608986459117032763971758513021759834790, 761384606161846932231810575009824534279121574, 761384608986459117032762795777522792619887210, 761384608986459117032762795777522792619887210, 761199495367820495683770529439832302122592874][i.val]!

private def productOrder (i : Fin 45) (j : Fin 38) : ℕ :=
  (productOrderData i >>> (4 * j.val)) % 16

private theorem productOrder_check : ∀ (i : Fin 45) (j : Fin 38),
    0 < productOrder i j ∧
    (perm (zIndex i) * perm (tIndex j)) ^ productOrder i j = 1 ∧
    ∀ m : Fin (productOrder i j), 0 < m.val →
      (perm (zIndex i) * perm (tIndex j)) ^ m.val ≠ 1 := by
  decide +kernel

private theorem productOrder_eq (i : Fin 45) (j : Fin 38) :
    orderOf (perm (zIndex i) * perm (tIndex j)) = productOrder i j :=
  orderOf_eq_of_finite_check _ _ (productOrder_check i j).1
    (productOrder_check i j).2.1 (productOrder_check i j).2.2

private def rowCount (i : Fin 45) : ℕ :=
  #[12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13, 12, 12, 13][i.val]!

private theorem rowCount_correct : ∀ i : Fin 45,
    (Finset.univ.filter (fun j : Fin 38 =>
      (perm (zIndex i) * perm (tIndex j)) ^ (productOrder i j / 2) =
        (t9 : Perm (Fin 9)))).card = rowCount i := by
  decide +kernel

/-- The actual ambient alternating-group mixed-pair count. -/
public theorem kappa_eq : kappa z9 t9 t9 = 555 := by
  rw [kappa_eq_sum z9 t9 t9 z9_order t9_order z9_not_conjugate_t9
    zClassEquiv tClassEquiv
    (fun i j => (perm (zIndex i) * perm (tIndex j)) ^ (productOrder i j / 2) =
      (t9 : Perm (Fin 9)))
    (fun i j => halfOrder_eq_iff_of_order _ _ _ _ (productOrder_eq i j))]
  simp only [rowCount_correct]
  decide +kernel

end alternatingGroup.EightNineInvolutionCounts.Nine
