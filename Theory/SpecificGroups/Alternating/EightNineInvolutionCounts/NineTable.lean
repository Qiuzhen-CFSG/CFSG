def digit (v : ℕ) (j : Fin N) : Fin N := ⟨v / N ^ j.val % N, Nat.mod_lt _ (by decide)⟩
theorem inverse_check : ∀ c : Fin M, (∀ j, digit (invRaw c) (digit (raw c) j) = j) ∧
    (∀ j, digit (raw c) (digit (invRaw c) j) = j) := by decide +kernel
def perm (c : Fin M) : Perm (Fin N) where
  toFun := digit (raw c)
  invFun := digit (invRaw c)
  left_inv := (inverse_check c).1
  right_inv := (inverse_check c).2
theorem even_check : ∀ c : Fin M, sign (perm c) = 1 := by decide +kernel
theorem sorted_check : ∀ c : Fin 479, raw c.castSucc < raw c.succ := by decide +kernel
theorem encode_check : ∀ c : Fin M, (∑ j : Fin N, (perm c j).val * N ^ j.val) = raw c := by decide +kernel
def zIndex (i : Fin 45) : Fin M := #[0, 1, 2, 32, 33, 34, 48, 49, 50, 100, 101, 102, 132, 133, 134, 148, 149, 150, 208, 209, 210, 236, 237, 238, 256, 257, 258, 360, 361, 362, 372, 373, 374, 376, 377, 378, 384, 385, 386, 412, 413, 414, 448, 449, 450][i.val]!
def tIndex (i : Fin 38) : Fin M := #[3, 35, 51, 58, 59, 103, 135, 151, 158, 159, 211, 239, 259, 262, 263, 363, 375, 379, 382, 383, 387, 394, 395, 415, 422, 423, 451, 454, 455, 458, 459, 470, 471, 474, 475, 476, 477, 478][i.val]!
theorem types_check : ∀ c : Fin M,
    ((perm c * perm c = 1 ∧ (perm c).support.card = 8) ↔ ∃ i, zIndex i = c) ∧
    ((perm c * perm c = 1 ∧ (perm c).support.card = 4) ↔ ∃ i, tIndex i = c) := by decide +kernel


theorem commuting_check : ∀ c : Fin M,
    perm c * (t9 : Perm (Fin N)) = (t9 : Perm (Fin N)) * perm c := by
  decide +kernel

theorem perm_injective : Function.Injective perm := by
  intro i j h
  have he := congrArg (fun p : Perm (Fin N) => ∑ k : Fin N, (p k).val * N ^ k.val) h
  rw [encode_check, encode_check] at he
  exact (Fin.strictMono_iff_lt_succ.mpr sorted_check).injective he

def centralizerElement (c : Fin M) : Subgroup.centralizer ({t9} : Set A9) :=
  ⟨⟨perm c, mem_alternatingGroup.mpr (even_check c)⟩,
    Subgroup.mem_centralizer_singleton_iff.mpr (Subtype.ext (commuting_check c))⟩

/-- Exhaustiveness follows from the centralizer order, not from an unchecked search. -/
noncomputable def centralizerEquiv : Fin M ≃ Subgroup.centralizer ({t9} : Set A9) :=
  Equiv.ofBijective centralizerElement ((Nat.bijective_iff_injective_and_card _).mpr
    ⟨fun _ _ h => perm_injective (congrArg (fun x => x.val.val) h),
      by rw [Nat.card_fin, card_centralizer_t9]⟩)

theorem zIndex_injective : Function.Injective zIndex := by decide +kernel
theorem tIndex_injective : Function.Injective tIndex := by decide +kernel

noncomputable def zClassEquiv : Fin 45 ≃ CentralizerClass z9 t9 :=
  centralizerClassEquiv z9 t9 centralizerEquiv zIndex zIndex_injective (fun c => by
    rw [z9_isConj]
    change (perm c).cycleType = Multiset.replicate 4 2 ↔ _
    rw [cycleType_replicate_two_iff _ (by decide)]
    exact (types_check c).1)

noncomputable def tClassEquiv : Fin 38 ≃ CentralizerClass t9 t9 :=
  centralizerClassEquiv t9 t9 centralizerEquiv tIndex tIndex_injective (fun c => by
    rw [t9_isConj]
    change (perm c).cycleType = Multiset.replicate 2 2 ↔ _
    rw [cycleType_replicate_two_iff _ (by decide)]
    exact (types_check c).2)

