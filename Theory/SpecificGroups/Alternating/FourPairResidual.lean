module
public import Theory.GroupTheory.CComponent.ThreeResidual.CenterlessNormal
public import Theory.GroupTheory.PResidual.PrimeToMonotone
public import Theory.SpecificGroups.Alternating.FourPairOuter
public import Theory.SpecificGroups.Alternating.QuasithinBounds

/-!
# A normal pair of A₄ groups is the cubic residual at rank two

Each A₄ factor is generated by cubic elements; hence so is their product.
The literal pair has trivial center, three-rank two, and outer automorphism
group of order eight. Therefore in an ambient group of three-rank at most
two, a normal embedded copy has index prime to three and is O^{3′}.
Extra factors of order prime to three are allowed and killed by the residual.

Source: Aschbacher–Smith 13.5.6, printed p.917.
-/

public section
open Subgroup Theory.GroupTheory
namespace AlternatingFourPair

theorem single_threeResidual : primeToResidual 3 A = ⊤ := by
  have hc : c3 ∈ primeToResidual 3 A := mem_primeToResidual_of_pow (n := 1) (by simpa using c_cube)
  rcases normalA4 (primeToResidual 3 A) with hb | hb | ht
  · rw [hb,mem_bot] at hc
    exact (c_order_ne hc).elim
  · rw [hb] at hc
    exact (show c3 ∉ K by decide) hc |>.elim
  · exact ht

theorem pair_threeResidual : primeToResidual 3 Model = ⊤ := by
  have hl := map_primeToResidual_le_of_hom 3 (MonoidHom.inl A A)
  have hr := map_primeToResidual_le_of_hom 3 (MonoidHom.inr A A)
  rw [single_threeResidual, ←MonoidHom.range_eq_map] at hl hr
  apply top_unique
  intro x _
  have h1 := hl (show (x.1,1) ∈ (MonoidHom.inl A A).range from ⟨x.1,rfl⟩)
  have h2 := hr (show (1,x.2) ∈ (MonoidHom.inr A A).range from ⟨x.2,rfl⟩)
  simpa using mul_mem h1 h2

theorem pair_threeRank : primeRank 3 Model = 2 := by
  change primeRank 3 (A × A)=2
  rw [primeRank_prod_eq_add,GLS3.Chapter5.PRank.alternating_primeRank_of_odd_prime 4 3 (by decide) (by decide)]

variable {G : Type*} [Group G] [Finite G]

theorem residual_eq_of_normal_pair (X : Subgroup G) [X.Normal]
    (e : X ≃* Model) (hG : primeRank 3 G ≤ 2) : primeToResidual 3 G = X := by
  have hz : center X = ⊥ := by
    apply eq_bot_iff.mpr
    intro x hx
    have he := (Subgroup.centerCongr e ⟨x,hx⟩).property
    change e x ∈ center Model at he
    rw [center_eq_bot,mem_bot] at he
    apply mem_bot.mpr
    exact e.injective (he.trans (map_one e).symm)
  have hr : 2 ≤ primeRank 3 X := by rw [primeRank_equiv 3 e,pair_threeRank]
  have ho : Nat.Coprime 3 (Nat.card (MulAut.Outer X)) := by
    rw [Nat.card_congr (MulAut.outerCongr e).toEquiv,card_outer_pair]
    decide
  have hg : primeToResidual 3 X = ⊤ := by
    apply (Subgroup.map_injective (f := e.toMonoidHom) e.injective)
    rw [map_primeToResidual, pair_threeResidual, map_top_of_surjective _ e.surjective]
  exact primeToResidual_eq_of_centerless_normal_rank_two X hz hr hG ho hg
end AlternatingFourPair
