module
public import Theory.SpecificGroups.Triality.SylowParabolicExtensions
public import Theory.SpecificGroups.Triality.SubnormalRadicalActions.CentralRootSquare.SquareWitness
public import Theory.GroupTheory.GeneralizedFitting.SelfCentralizingPrimeCore
public import Theory.GroupTheory.PResidual.PrimeToTransport

/-!
# Generating parabolic residuals in binary triality

The two subsystem tori generate the full torus, so the two local factors
generate the genuine graph-field carrier. For q > 2 these perfect factors
are exactly the solvable residuals of their parabolics. Their full radicals
are generated by Levi commutators and are not elementary abelian. Both
factors have generalized Fitting subgroup equal to their two-core and are
invariant under every automorphism preserving the marked Sylow subgroup.

These are the intrinsic inputs to the higher-field argument of
Aschbacher--Smith 15.1.20(3), printed p.1096. Root calculations and model
provenance are inherited from the genuine triality construction, as in
GLS3 §§2.4,2.6 and Aschbacher--Smith F.1.12(I)(4), printed pp.263--264.
-/

public section

open Subgroup Theory.GroupTheory
namespace Triality.Standard.Parabolics
open ConcreteBruhat ConcreteBruhat.TorusCoordinates RadicalCoordinates

/-- The two actual local factors generate the carrier, including at q = 2. -/
theorem localFactor_sup_eq_top (P : Parameters) (hp : P.prime = 2) :
    localFactor P .arms ⊔ localFactor P .central = ⊤ := by
  have ht : torus P ≤ localFactor P .arms ⊔ localFactor P .central := by
    intro t ht
    obtain ⟨⟨x,y⟩,he⟩ := (torusMulEquiv P hp).surjective ⟨t,ht⟩
    have he' := congrArg Subtype.val he
    rw [torusMulEquiv_val] at he'
    change toCarrier P (orbitElementary P hp (x,y)) = t at he'
    rw [←he']
    change toCarrier P (foldedTorusElementary P hp .arms x *
      foldedTorusElementary P hp .central y) ∈ _
    rw [map_mul]
    exact mul_mem (mem_sup_left (levi_le_localFactor P hp .arms
      (LeviCommutators.torusActor_mem_levi P hp .arms x)))
      (mem_sup_right (levi_le_localFactor P hp .central
        (LeviCommutators.torusActor_mem_levi P hp .central y)))
  apply top_unique
  rw [←parabolic_sup_binary P hp]
  rw [parabolic_eq_localFactor_sup_torus P hp .arms,
    parabolic_eq_localFactor_sup_torus P hp .central]
  exact sup_le (sup_le le_sup_left ht) (sup_le le_sup_right ht)

/-- For q > 2 the full parabolic has exactly this embedded solvable residual. -/
theorem parabolic_solvableResidual_map (P : Parameters) (hp : P.prime = 2)
    (hq : 2 < P.q) (a : Node) :
    (solvableResidual (parabolic P a)).map (parabolic P a).subtype = localFactor P a := by
  let := localFactor_isPerfect P hp hq a
  let := parabolic_quotient_isCyclic P hp a
  apply le_antisymm
  · have h := map_mono (f := (parabolic P a).subtype)
      (solvableResidual_le_of_solvable_quotient ((localFactor P a).subgroupOf (parabolic P a)))
    simpa only [map_subgroupOf_eq_of_le (localFactor_le_parabolic P a)] using h
  · exact le_map_solvableResidual_of_isPerfect _ _ (localFactor_le_parabolic P a)

/-- Sylow-preserving automorphisms fix each local factor. -/
theorem localFactor_map_eq_of_unipotent_invariant (P : Parameters) (hp : P.prime = 2)
    (a : Node) (β : MulAut (Carrier P))
    (hβ : (unipotent P).map β.toMonoidHom = unipotent P) :
    (localFactor P a).map β.toMonoidHom = localFactor P a := by
  unfold localFactor
  rw [map_embedded_primeToResidual_of_hom,
    parabolic_map_eq_of_unipotent_invariant P hp a β hβ]

/-- Each local factor has self-centralizing two-core and F* = O₂. -/
theorem localFactor_generalizedFitting (P : Parameters) (hp : P.prime = 2) (a : Node) :
    generalizedFitting (localFactor P a) = pCore 2 (localFactor P a) := by
  apply generalizedFitting_eq_pCore_of_selfCentralizing 2
  intro x hx
  rw [localFactor_twoCore_eq P hp a]
  apply parabolic_centralizer_radical_le P hp a
  refine ⟨localFactor_le_parabolic P a x.property, ?_⟩
  intro y hy
  have hc := hx ⟨y,radical_le_localFactor P hp a hy⟩
    ((localFactor_twoCore_eq P hp a).symm ▸ hy)
  exact congrArg Subtype.val hc

/-- The whole radical is the image of the intrinsic core commutator for q > 2. -/
theorem localFactor_core_commutator_map (P : Parameters) (hp : P.prime = 2)
    (hq : 2 < P.q) (a : Node) :
    (⁅pCore 2 (localFactor P a), (⊤ : Subgroup (localFactor P a))⁆).map
      (localFactor P a).subtype = radical P a := by
  rw [map_commutator,localFactor_twoCore_map P hp a,
    ←MonoidHom.range_eq_map,range_subtype]
  apply le_antisymm
  · exact le_normalizer_iff_commutator_le_left.mp
      ((localFactor_le_parabolic P a).trans
        ((normal_subgroupOf_iff_le_normalizer (radical_le_parabolic P a)).mp
          (radical_normal P a)))
  · exact (commutator_radical_levi_eq P hp hq a).ge.trans
      (commutator_mono le_rfl (levi_le_localFactor P hp a))

/-- Both radicals fail the elementary condition required of a short block. -/
theorem radical_not_elementary (P : Parameters) (hp : P.prime = 2) (a : Node) :
    ¬ IsElementaryAbelian 2 (radical P a) := by
  intro he
  let := he
  cases a with
  | arms =>
    have hc : Nat.card (center (radical P .arms)) = Nat.card (radical P .arms) := by
      rw [center_eq_top,card_top]
    rw [card_center_radical_arms P hp,radical_arms_card P hp] at hc
    have hh : P.q < P.q^9 := lt_self_pow₀ (by have := P.q_ge_two; omega) (by decide)
    omega
  | central =>
    obtain ⟨r,hr,hs⟩ := CentralRootSquare.radical_exists_square_ne_one P hp
    exact hs (elemPow_eq_one_of_isElementaryAbelian r hr)
end Triality.Standard.Parabolics
