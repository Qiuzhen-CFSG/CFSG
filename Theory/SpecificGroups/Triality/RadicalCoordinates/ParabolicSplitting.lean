module

public import Theory.SpecificGroups.Triality.RadicalCoordinates.PositiveNormalization
public import Theory.SpecificGroups.Triality.RadicalCoordinates.FullLeviDefinitions
public import Theory.SpecificGroups.Triality.LeviIdentification
public import Theory.SpecificGroups.Triality.RadicalCoordinates.ParabolicSplitting.Normalization
public import Theory.SpecificGroups.Triality.RadicalCoordinates.FullLevi

/-!
# The triality parabolic and local residual splittings

The full split Levi subgroup is the join of the subsystem group and the torus.
Once the root radical is relatively normal and disjoint from this full Levi,
uniqueness of the product forces factors of a graph-field fixed element to be
fixed. The radical factor is elementary because it is a two-element, so this
factorization descends through the actual elementary group and central quotient.

Both the descended root radical and subsystem Levi lie in the local residual.
For the Levi this uses transvection generation, including PSL₂(2), rather than
perfectness. Relative normality and the Levi's trivial two-core also give their
trivial intersection. Finally an odd torus quotient identifies the residual.

The concrete Weyl and torus actions prove radical normality. The full Levi
fixed-point structure then discharges all inputs to the original conditional
assembly, giving the local residual decomposition for both nodes, including
q = 2. The original normal-closure radical is identified with the supported
root product. The full parabolic decomposition retains the torus.

Source: GLS3 2.6.4–5, with full Levi H M_J and residual radical times M_J
(`refs/KGroup/GLS3/chapter2.tex`); Aschbacher–Smith F.1.11–12, pp.262–264
(`refs/quasithin.pdf`).
-/

@[expose] public section
noncomputable section
open scoped Pointwise MatrixGroups
namespace Triality.Standard.RadicalCoordinates
open Parabolics ConcreteBruhat

theorem splitParabolic_eq_root_sup_fullLevi_of_normal (P : Parameters)
    (hp : P.prime = 2) (a : Node)
    (hN : ((rootSubgroup P a).subgroupOf (splitParabolic P a)).Normal) :
    splitParabolic P a = rootSubgroup P a ⊔ splitFullLevi P a := by
  rw [splitParabolic_eq_radical_sup_levi_sup_torus,
    splitRadical_eq_rootSubgroup_of_normal P hp a hN]
  rfl

theorem descendedRootSubgroup_le_parabolic (P : Parameters) (hp : P.prime = 2)
    (a : Node) : descendSubgroup P (rootSubgroup P a) ≤ parabolic P a :=
  (descendedRootSubgroup_le_radical P hp a).trans (radical_le_parabolic P a)

/-- Every root-radical element lies in the prime-to-two residual by its two-power order. -/
theorem descendedRootSubgroup_le_localFactor (P : Parameters) (hp : P.prime = 2)
    (a : Node) : descendSubgroup P (rootSubgroup P a) ≤ localFactor P a := by
  intro g hg
  obtain ⟨n, hn⟩ := isPGroup_descendedRootSubgroup P hp a ⟨g, hg⟩
  apply mem_localFactor_of_pow P a g (descendedRootSubgroup_le_parabolic P hp a hg) n
  rw [hp]
  exact congrArg (fun x : descendSubgroup P (rootSubgroup P a) => (x : Carrier P)) hn

private theorem levi_le_localFactor_of_equiv {F : Type*} [Field F] [CharP F 2]
    (P : Parameters) (hp : P.prime = 2) (a : Node)
    (e : levi P a ≃* PSL(2, F)) : levi P a ≤ localFactor P a := by
  let e' := (Theory.PSL2.sl2QuotientEquiv F).trans e.symm
  let f : SL(2, F) →* parabolic P a :=
    (Subgroup.inclusion (levi_le_parabolic P a)).comp e'.toMonoidHom
  intro g hg
  obtain ⟨x, hx⟩ := e'.surjective ⟨g, hg⟩
  refine ⟨f x, ?_, ?_⟩
  · rw [hp]
    exact Matrix.SL2.map_mem_primeToResidual 2 f x
  · exact congrArg Subtype.val hx

/-- The actual subsystem Levi is generated by two-elements. This includes
the central PSL₂(2), whose perfectness is neither needed nor asserted. -/
theorem levi_le_localFactor (P : Parameters) (hp : P.prime = 2) (a : Node) :
    levi P a ≤ localFactor P a := by
  cases a
  · let : CharP (ExtensionField P) 2 :=
      hp ▸ inferInstanceAs (CharP (ExtensionField P) P.prime)
    exact levi_le_localFactor_of_equiv P hp .arms (leviArmsEquivPSL2 P hp)
  · let : CharP (GaloisField P.prime P.exponent) 2 :=
      hp ▸ inferInstanceAs (CharP (GaloisField P.prime P.exponent) P.prime)
    exact levi_le_localFactor_of_equiv P hp .central (leviCentralEquivPSL2 P hp)

/-- Normality of the radical alone suffices for its intersection with the
subsystem Levi: that intersection is a normal two-subgroup of the Levi. -/
theorem disjoint_descendedRootSubgroup_levi_of_normal (P : Parameters)
    (hp : P.prime = 2) (a : Node)
    (hN : ((rootSubgroup P a).subgroupOf (splitParabolic P a)).Normal) :
    Disjoint (descendSubgroup P (rootSubgroup P a)) (levi P a) := by
  let U := descendSubgroup P (rootSubgroup P a)
  have hUP := descendedRootSubgroup_le_parabolic P hp a
  have hUN : (U.subgroupOf (parabolic P a)).Normal :=
    descendSubgroup_normal P
      ((rootSubgroup_le_splitRadical P hp a).trans (splitRadical_le_splitParabolic P a)) hN
  have hUL : (U.subgroupOf (levi P a)).Normal :=
    Subgroup.normal_subgroupOf_of_le_normalizer ((levi_le_parabolic P a).trans
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hUP).mp hUN))
  have hcore : U.subgroupOf (levi P a) ≤ pCore 2 (levi P a) :=
    le_sSup ⟨hUL, (isPGroup_descendedRootSubgroup P hp a).comap_subtype⟩
  rw [levi_twoCore_eq_bot P a hp] at hcore
  apply Subgroup.disjoint_def.mpr
  intro g hg hl
  exact congrArg Subtype.val (Subgroup.mem_bot.mp (hcore (show
    (⟨g, hl⟩ : levi P a) ∈ U.subgroupOf (levi P a) from hg)))

/-- Uniqueness, not preservation of joins by fixed points, forces the two
full-parabolic factors of a fixed element to be fixed. -/
theorem root_fullLevi_factors_fixed (P : Parameters) (hp : P.prime = 2) (a : Node)
    (hN : ((rootSubgroup P a).subgroupOf (splitParabolic P a)).Normal)
    (hd : Disjoint (rootSubgroup P a) (splitFullLevi P a))
    (u l : SplitGroup P) (hu : u ∈ rootSubgroup P a) (hl : l ∈ splitFullLevi P a)
    (hfix : graphFieldAutomorphism P (u * l) = u * l) :
    u ∈ fixedSubgroup P ∧ l ∈ fixedSubgroup P := by
  have hRI : (rootSubgroup P a).map (graphFieldAutomorphism P).toMonoidHom =
      rootSubgroup P a := by
    rw [← splitRadical_eq_rootSubgroup_of_normal P hp a hN, splitRadical_invariant]
  have huF : graphFieldAutomorphism P u ∈ rootSubgroup P a := by
    rw [← hRI]
    exact ⟨u, hu, rfl⟩
  have hlF : graphFieldAutomorphism P l ∈ splitFullLevi P a := by
    rw [← splitFullLevi_invariant P a]
    exact ⟨l, hl, rfl⟩
  have he : (⟨graphFieldAutomorphism P u, huF⟩, ⟨graphFieldAutomorphism P l, hlF⟩) =
      ((⟨u, hu⟩, ⟨l, hl⟩) : rootSubgroup P a × splitFullLevi P a) :=
    Subgroup.mul_injective_of_disjoint hd ((map_mul _ u l).symm.trans hfix)
  exact ⟨congrArg (fun x : rootSubgroup P a × splitFullLevi P a => x.1.val) he,
    congrArg (fun x : rootSubgroup P a × splitFullLevi P a => x.2.val) he⟩

/-- Descend the unique split product through elementary fixed points. -/
theorem parabolic_eq_root_sup_fullLevi_of_split (P : Parameters)
    (hp : P.prime = 2) (a : Node)
    (hN : ((rootSubgroup P a).subgroupOf (splitParabolic P a)).Normal)
    (hd : Disjoint (rootSubgroup P a) (splitFullLevi P a)) :
    parabolic P a = descendSubgroup P (rootSubgroup P a) ⊔
      descendSubgroup P (splitFullLevi P a) := by
  have hRP := (rootSubgroup_le_splitRadical P hp a).trans (splitRadical_le_splitParabolic P a)
  have hLN : splitFullLevi P a ≤ Subgroup.normalizer (rootSubgroup P a) :=
    (splitFullLevi_le_splitParabolic P a).trans
      ((Subgroup.normal_subgroupOf_iff_le_normalizer hRP).mp hN)
  have hprod : (splitParabolic P a : Set (SplitGroup P)) =
      (rootSubgroup P a : Set (SplitGroup P)) * splitFullLevi P a :=
    (congrArg (fun H : Subgroup (SplitGroup P) => (H : Set (SplitGroup P)))
      (splitParabolic_eq_root_sup_fullLevi_of_normal P hp a hN)).trans
        (Subgroup.coe_mul_of_right_le_normalizer_left _ _ hLN)
  apply le_antisymm
  · rintro g ⟨x, hx, rfl⟩
    have hx' : elementaryInclusion P x ∈
        (rootSubgroup P a : Set (SplitGroup P)) * splitFullLevi P a :=
      (Set.ext_iff.mp hprod (elementaryInclusion P x)).mp hx
    obtain ⟨u, hu, l, hl, he⟩ := hx'
    have hfix : graphFieldAutomorphism P (u * l) = u * l :=
      (congrArg (graphFieldAutomorphism P) he).trans (x.val.property.trans he.symm)
    have huf := (root_fullLevi_factors_fixed P hp a hN hd u l hu hl hfix).1
    let uf : fixedSubgroup P := ⟨u, huf⟩
    let ue : ElementaryGroup P := ⟨uf, fixedRootSubgroup_le_elementary P hp a hu⟩
    let le : ElementaryGroup P := ue⁻¹ * x
    have hle : elementaryInclusion P le = l := by
      change u⁻¹ * elementaryInclusion P x = l
      rw [← he, inv_mul_cancel_left]
    have hprod : toCarrier P ue * toCarrier P le = toCarrier P x :=
      (map_mul (toCarrier P) ue le).symm.trans
        (congrArg (toCarrier P) (mul_inv_cancel_left ue x))
    rw [← hprod]
    apply Subgroup.mul_mem
    · exact Subgroup.mem_sup_left ⟨ue, hu, rfl⟩
    · apply Subgroup.mem_sup_right
      refine ⟨le, ?_, rfl⟩
      change elementaryInclusion P le ∈ splitFullLevi P a
      exact hle.symm ▸ hl
  · exact sup_le (descendedRootSubgroup_le_parabolic P hp a)
      (descendSubgroup_mono P (splitFullLevi_le_splitParabolic P a))

private theorem residual_eq_of_odd_torus {G : Type*} [Group G]
    (p : ℕ) (H K T : Subgroup G) (hKH : K ≤ H) (hTH : T ≤ H)
    (hgen : H = K ⊔ T) (hN : (K.subgroupOf H).Normal)
    (hodd : Nat.Coprime p (Nat.card T))
    (hK : K ≤ (Subgroup.primeToResidual p H).map H.subtype) :
    (Subgroup.primeToResidual p H).map H.subtype = K := by
  let N := K.subgroupOf H
  let T' := T.subgroupOf H
  let : N.Normal := hN
  have htop : N ⊔ T' = ⊤ := by
    rw [← Subgroup.subgroupOf_sup hKH hTH, ← hgen, Subgroup.subgroupOf_self]
  have hcT : Nat.Coprime p (Nat.card T') := by
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hTH).toEquiv]
    exact hodd
  have hindex : Nat.Coprime p N.index := by
    rw [← Subgroup.relIndex_top_right N, ← htop, Subgroup.relIndex_sup_left]
    exact hcT.coprime_dvd_right (Subgroup.relIndex_dvd_card N T')
  apply le_antisymm _ hK
  have h := Subgroup.map_mono (f := H.subtype) (Subgroup.primeToResidual_le N hindex)
  exact h.trans_eq (Subgroup.map_subgroupOf_eq_of_le hKH)

/-- The remaining full-Levi inputs imply the requested local residual
decomposition. In particular the torus is retained until its odd quotient
is removed by the defining property of the residual. -/
theorem localFactor_eq_root_sup_levi_of_fullLevi (P : Parameters)
    (hp : P.prime = 2) (a : Node)
    (hN : ((rootSubgroup P a).subgroupOf (splitParabolic P a)).Normal)
    (hd : Disjoint (rootSubgroup P a) (splitFullLevi P a))
    (hfull : descendSubgroup P (splitFullLevi P a) = levi P a ⊔ torus P)
    (hTL : torus P ≤ Subgroup.normalizer (levi P a))
    (hodd : Odd (Nat.card (torus P))) :
    localFactor P a = descendSubgroup P (rootSubgroup P a) ⊔ levi P a := by
  let U := descendSubgroup P (rootSubgroup P a)
  let K := U ⊔ levi P a
  have hUP : U ≤ parabolic P a := descendedRootSubgroup_le_parabolic P hp a
  have hKP : K ≤ parabolic P a := sup_le hUP (levi_le_parabolic P a)
  have hTP : torus P ≤ parabolic P a := (torus_le_borel P).trans (borel_le_parabolic P a)
  have hgen : parabolic P a = K ⊔ torus P := by
    rw [parabolic_eq_root_sup_fullLevi_of_split P hp a hN hd, hfull, ← sup_assoc]
  have hUN : (U.subgroupOf (parabolic P a)).Normal :=
    descendSubgroup_normal P
      ((rootSubgroup_le_splitRadical P hp a).trans (splitRadical_le_splitParabolic P a)) hN
  have hTN : torus P ≤ Subgroup.normalizer K :=
    (le_inf (hTP.trans ((Subgroup.normal_subgroupOf_iff_le_normalizer hUP).mp hUN))
      hTL).trans (Subgroup.normalizer_inf_normalizer_le_normalizer_sup U (levi P a))
  have hKN : (K.subgroupOf (parabolic P a)).Normal := by
    apply (Subgroup.normal_subgroupOf_iff_le_normalizer hKP).mpr
    rw [hgen]
    exact sup_le K.le_normalizer hTN
  exact residual_eq_of_odd_torus P.prime (parabolic P a) K (torus P) hKP hTP hgen hKN
    (by simpa only [hp] using hodd.coprime_two_left)
    (sup_le (descendedRootSubgroup_le_localFactor P hp a) (levi_le_localFactor P hp a))

/-- The parabolic normal closure is exactly the positive root product outside
the Levi subsystem of GLS3 Definition 2.6.4. -/
theorem splitRadical_eq_rootSubgroup (P : Parameters) (hp : P.prime = 2) (a : Node) :
    splitRadical P a = rootSubgroup P a :=
  splitRadical_eq_rootSubgroup_of_normal P hp a (rootSubgroup_normal P hp a)

/-- Identification survives the original elementary restriction and central quotient. -/
theorem radical_eq_descendedRootSubgroup (P : Parameters) (hp : P.prime = 2) (a : Node) :
    radical P a = descendSubgroup P (rootSubgroup P a) := by
  unfold radical
  rw [splitRadical_eq_rootSubgroup P hp a]

theorem disjoint_rootSubgroup_splitFullLevi (P : Parameters) (hp : P.prime = 2)
    (a : Node) : Disjoint (rootSubgroup P a) (splitFullLevi P a) :=
  disjoint_rootSubgroup_splitFullLevi_of_normal P hp a (rootSubgroup_normal P hp a)

theorem splitParabolic_eq_root_sup_fullLevi (P : Parameters) (hp : P.prime = 2)
    (a : Node) : splitParabolic P a = rootSubgroup P a ⊔ splitFullLevi P a :=
  splitParabolic_eq_root_sup_fullLevi_of_normal P hp a (rootSubgroup_normal P hp a)

/-- The full parabolic retains the torus in its full Levi factor. Fixed points
are handled by the proved uniqueness of the radical/Levi factors. -/
theorem parabolic_eq_root_sup_levi_sup_torus (P : Parameters) (hp : P.prime = 2)
    (a : Node) : parabolic P a =
      descendSubgroup P (rootSubgroup P a) ⊔ (levi P a ⊔ torus P) := by
  rw [parabolic_eq_root_sup_fullLevi_of_split P hp a (rootSubgroup_normal P hp a)
    (disjoint_rootSubgroup_splitFullLevi P hp a), descendSubgroup_splitFullLevi P hp a]

/-- The embedded prime-to-two residual is the radical times the subsystem Levi,
including the central PSL₂(2) case. -/
theorem localFactor_eq_root_sup_levi (P : Parameters) (hp : P.prime = 2) (a : Node) :
    localFactor P a = descendSubgroup P (rootSubgroup P a) ⊔ levi P a := by
  apply localFactor_eq_root_sup_levi_of_fullLevi P hp a (rootSubgroup_normal P hp a)
    (disjoint_rootSubgroup_splitFullLevi P hp a) (descendSubgroup_splitFullLevi P hp a)
    (torus_le_normalizer_levi P hp a)
  rw [TorusCoordinates.card_torus P hp]
  exact TorusCoordinates.odd_torus_order P hp

theorem disjoint_descendedRootSubgroup_levi (P : Parameters) (hp : P.prime = 2)
    (a : Node) : Disjoint (descendSubgroup P (rootSubgroup P a)) (levi P a) :=
  disjoint_descendedRootSubgroup_levi_of_normal P hp a (rootSubgroup_normal P hp a)

/-- The local residual decomposition in the original radical API. -/
theorem localFactor_eq_radical_sup_levi (P : Parameters) (hp : P.prime = 2) (a : Node) :
    localFactor P a = radical P a ⊔ levi P a := by
  rw [radical_eq_descendedRootSubgroup P hp a, localFactor_eq_root_sup_levi P hp a]

theorem disjoint_radical_levi (P : Parameters) (hp : P.prime = 2) (a : Node) :
    Disjoint (radical P a) (levi P a) := by
  rw [radical_eq_descendedRootSubgroup P hp a]
  exact disjoint_descendedRootSubgroup_levi P hp a

end Triality.Standard.RadicalCoordinates
