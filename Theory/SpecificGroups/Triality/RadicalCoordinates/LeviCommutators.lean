module

public import Theory.SpecificGroups.Triality.RadicalCoordinates.LeviCommutators.Motion
public import Theory.SpecificGroups.Triality.RadicalCoordinates.LeviCommutators.TorusMotion
public import Theory.SpecificGroups.Triality.RadicalCoordinates.LeviCommutators.CentralHigherGeneration

/-!
# Assembly of triality radical generation by Levi commutators

The supported fixed normal form reduces each radical root product to five
folded root groups. Four have nonzero torus weights. For the arms node the
remaining highest root comes from the exchange of the two other singleton
groups. For the central node the remaining short-root orbit requires the
higher-root generation calculation. The concrete torus actions and folded
exchange calculations discharge both inputs when the characteristic is two
and q > 2.

The final theorem proves U ≤ [U, levi] for each descended radical root
product U, without a normalization or generation premise. Identifying U
with the radical and obtaining the reverse inclusion from relative
normality belong to the radical assembly. This is the commutator-generation
ingredient of the local perfectness assertion in F.1.12(II).

Sources: GLS3 §§2.4 and 2.6 (`refs/KGroup/GLS3/chapter2.tex`);
Aschbacher–Smith F.1.12(II), printed pp.263–264 (`refs/quasithin.pdf`).
-/

public section
noncomputable section
namespace Triality.Standard.RadicalCoordinates.LeviCommutators
open Parabolics

/-- Four nontrivial torus weights suffice on the arms. The highest-root
factor is generated internally, without an extra center or normality premise. -/
theorem arms_le_commutator_of_motion (P : Parameters) (hp : P.prime = 2)
    (hs : ∀ i : Fin 3, i ≠ 0 → ShortTorusMotion P hp .arms i)
    (hl : ∀ i : Fin 3, i ≠ 2 → LongTorusMotion P hp .arms i) :
    descendSubgroup P (rootSubgroup P .arms) ≤
      ⁅descendSubgroup P (rootSubgroup P .arms), levi P .arms⁆ := by
  let H := ⁅descendSubgroup P (rootSubgroup P .arms), levi P .arms⁆
  have h0 (t : fixedField P) : long P hp 0 t ∈ H :=
    long_mem_commutator_of_motion P hp .arms 0 trivial (hl 0 (by decide)) t
  have h1 (t : fixedField P) : long P hp 1 t ∈ H :=
    long_mem_commutator_of_motion P hp .arms 1 trivial (hl 1 (by decide)) t
  apply descendedRoot_le_of_folded P hp .arms
  · intro i hi t
    exact short_mem_commutator_of_motion P hp .arms i hi (hs i hi) t
  · intro i _ t
    fin_cases i
    · exact h0 t
    · exact h1 t
    · exact long_two_mem_of_zero_one P hp H h0 h1 t

/-- The central higher-root calculation is independent of torus motion: any
subgroup containing the other four supported root groups contains the fifth.
Its explicit premise is to be discharged by the folded exchange calculation. -/
theorem central_le_commutator_of_motion (P : Parameters) (hp : P.prime = 2)
    (hs : ∀ i : Fin 3, i ≠ 2 → ShortTorusMotion P hp .central i)
    (hl : ∀ i : Fin 3, i ≠ 0 → LongTorusMotion P hp .central i)
    (hhigher : ∀ H : Subgroup (Carrier P),
      (∀ t, short P hp 0 t ∈ H) → (∀ t, short P hp 1 t ∈ H) →
      (∀ t, long P hp 1 t ∈ H) → (∀ t, long P hp 2 t ∈ H) →
      ∀ t, short P hp 2 t ∈ H) :
    descendSubgroup P (rootSubgroup P .central) ≤
      ⁅descendSubgroup P (rootSubgroup P .central), levi P .central⁆ := by
  let H := ⁅descendSubgroup P (rootSubgroup P .central), levi P .central⁆
  have h0 (t : ExtensionField P) : short P hp 0 t ∈ H :=
    short_mem_commutator_of_motion P hp .central 0 trivial (hs 0 (by decide)) t
  have h1 (t : ExtensionField P) : short P hp 1 t ∈ H :=
    short_mem_commutator_of_motion P hp .central 1 trivial (hs 1 (by decide)) t
  have hlong (i : Fin 3) (hi : i ≠ 0) (t : fixedField P) : long P hp i t ∈ H :=
    long_mem_commutator_of_motion P hp .central i hi (hl i hi) t
  apply descendedRoot_le_of_folded P hp .central
  · intro i _ t
    fin_cases i
    · exact h0 t
    · exact h1 t
    · exact hhigher H h0 h1 (hlong 1 (by decide)) (hlong 2 (by decide)) t
  · exact hlong

/-- The arms radical root product is generated by commutators with its actual
subsystem Levi when the characteristic is two and q > 2. -/
theorem arms_le_commutator (P : Parameters) (hp : P.prime = 2) (hq : 2 < P.q) :
    descendSubgroup P (rootSubgroup P .arms) ≤
      ⁅descendSubgroup P (rootSubgroup P .arms), levi P .arms⁆ :=
  arms_le_commutator_of_motion P hp
    (shortTorusMotion_arms P hp hq) (longTorusMotion_arms P hp hq)

/-- The central radical root product is generated by commutators with its
actual subsystem Levi, including its torus-fixed higher short-root group. -/
theorem central_le_commutator (P : Parameters) (hp : P.prime = 2) (hq : 2 < P.q) :
    descendSubgroup P (rootSubgroup P .central) ≤
      ⁅descendSubgroup P (rootSubgroup P .central), levi P .central⁆ :=
  central_le_commutator_of_motion P hp
    (shortTorusMotion_central P hp hq) (longTorusMotion_central P hp hq)
    (central_higher_generation P hp hq)

/-- For either node of genuine characteristic-two triality with q > 2, the
descended radical root product U satisfies U ≤ [U, levi]. All torus-motion
and higher-root generation inputs are discharged by the concrete Geck model. -/
theorem descendedRootSubgroup_le_commutator (P : Parameters) (hp : P.prime = 2)
    (hq : 2 < P.q) (a : Node) :
    descendSubgroup P (rootSubgroup P a) ≤
      ⁅descendSubgroup P (rootSubgroup P a), levi P a⁆ := by
  cases a with
  | arms => exact arms_le_commutator P hp hq
  | central => exact central_le_commutator P hp hq

end Triality.Standard.RadicalCoordinates.LeviCommutators
