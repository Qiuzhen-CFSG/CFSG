module

public import Theory.SpecificGroups.Triality.StandardModel
public import Theory.GroupTheory.PResidual.PrimeTo

/-!
# Root-defined subgroups for the genuine triality carrier

Start with the pinned simple curves in the split D4 group over GF(q³). The
positive curves and simple-coroot words define a split Borel candidate. Adjoin
negative simple curves in either the three-arm orbit or the central-vertex orbit.
The graph-field automorphism permutes these generators; its cube is one, proving
invariance of all three subgroups. Restrict to elementary fixed points and then
use the actual central quotient to define the finite subgroup candidates.

The three-arm orbit is first: its expected Levi factor is L₂(q³); the central
vertex has expected Levi factor L₂(q). The local factors are embedded O^{p′}
of the finite parabolics, separately from the whole parabolics. Their normality
is relative to those parabolics. No Sylow assertion, exact Borel intersection,
Levi identification, or radical order is asserted here. In particular, descent
of intersections has an explicit central-kernel containment hypothesis.

Sources: GLS3 §§2.3–2.6 (`refs/KGroup/GLS3/chapter2.tex`); Aschbacher–Smith,
F.1.11 and F.1.12(I)(4), printed pp. 262–264 (`refs/quasithin.pdf`). The remaining
root decomposition and local calculations must establish these candidates as
the source parabolics. The auxiliary `Triality.Model` is never used.
-/

@[expose] public section

open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.SimpleGeckGroup
namespace Triality.Standard.Parabolics
noncomputable section

/-- Numbered positive simple-root curves of the genuine split D4 group. -/
def positiveRoot (P : Parameters) (i : Fin 4) (t : ExtensionField P) : SplitGroup P :=
  positive (typeDRootPairing_baseEquiv 2 i) t

def negativeRoot (P : Parameters) (i : Fin 4) (t : ExtensionField P) : SplitGroup P :=
  negative (typeDRootPairing_baseEquiv 2 i) t

@[simp] theorem graphField_positiveRoot (P : Parameters) (i : Fin 4)
    (t : ExtensionField P) :
    graphFieldAutomorphism P (positiveRoot P i t) =
      positiveRoot P (typeD4DiagramPermutation i) (fieldFrobenius P t) := by
  simp [positiveRoot]

@[simp] theorem graphField_negativeRoot (P : Parameters) (i : Fin 4)
    (t : ExtensionField P) :
    graphFieldAutomorphism P (negativeRoot P i t) =
      negativeRoot P (typeD4DiagramPermutation i) (fieldFrobenius P t) := by
  simp [negativeRoot]

/-- The standard rank-one Weyl word, only used with nonzero parameters below. -/
def weylWord (P : Parameters) (i : Fin 4) (t : ExtensionField P) : SplitGroup P :=
  positiveRoot P i t * negativeRoot P i (-t⁻¹) * positiveRoot P i t

/-- A simple-coroot torus word. -/
def torusWord (P : Parameters) (i : Fin 4) (t : (ExtensionField P)ˣ) : SplitGroup P :=
  weylWord P i t * weylWord P i (-1)

@[simp] theorem graphField_weylWord (P : Parameters) (i : Fin 4)
    (t : ExtensionField P) :
    graphFieldAutomorphism P (weylWord P i t) =
      weylWord P (typeD4DiagramPermutation i) (fieldFrobenius P t) := by
  simp only [weylWord, map_mul, graphField_positiveRoot, graphField_negativeRoot,
    map_neg, map_inv₀]

@[simp] theorem graphField_torusWord (P : Parameters) (i : Fin 4)
    (t : (ExtensionField P)ˣ) :
    graphFieldAutomorphism P (torusWord P i t) =
      torusWord P (typeD4DiagramPermutation i) (Units.map (fieldFrobenius P).toMonoidHom t) := by
  simp [torusWord]

/-- Positive simple roots generate the split positive unipotent candidate. -/
def positiveSubgroup (P : Parameters) : Subgroup (SplitGroup P) :=
  Subgroup.closure {g | ∃ i t, g = positiveRoot P i t}

/-- The split Borel candidate is generated by positive curves and coroot words. -/
def splitBorel (P : Parameters) : Subgroup (SplitGroup P) :=
  positiveSubgroup P ⊔ Subgroup.closure {g | ∃ i t, g = torusWord P i t}

/-- The two diagram orbits, ordered for F.1.12(I)(4). -/
inductive Node where
  | arms
  | central
  deriving DecidableEq

def Node.support : Node → Set (Fin 4)
  | .arms => {i | i ≠ 1}
  | .central => {1}

@[simp] theorem Node.diagram_mem (a : Node) (i : Fin 4) :
    typeD4DiagramPermutation i ∈ a.support ↔ i ∈ a.support := by
  cases a <;> fin_cases i <;> simp [Node.support, typeD4DiagramPermutation]

/-- Adjoin the negative simple roots of one diagram orbit to the split Borel. -/
def splitParabolic (P : Parameters) (a : Node) : Subgroup (SplitGroup P) :=
  splitBorel P ⊔ Subgroup.closure {g | ∃ i ∈ a.support, ∃ t, g = negativeRoot P i t}

private theorem stable_closure {G : Type*} [Group G] (f : G →* G) (s : Set G)
    (h : ∀ x ∈ s, f x ∈ s) :
    ∀ x ∈ Subgroup.closure s, f x ∈ Subgroup.closure s := by
  change Subgroup.closure s ≤ (Subgroup.closure s).comap f
  apply (Subgroup.closure_le _).mpr
  intro x hx
  exact Subgroup.subset_closure (h x hx)

private theorem invariant_of_cube {G : Type*} [Group G] (f : G ≃* G)
    (hf : ∀ x, f (f (f x)) = x) (H : Subgroup G)
    (h : ∀ x ∈ H, f x ∈ H) : H.map f.toMonoidHom = H := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    exact h x hx
  · intro x hx
    exact ⟨f (f x), h _ (h _ hx), hf x⟩

theorem positiveSubgroup_invariant (P : Parameters) :
    (positiveSubgroup P).map (graphFieldAutomorphism P).toMonoidHom =
      positiveSubgroup P := by
  apply invariant_of_cube _ (graphFieldAutomorphism_three P)
  apply stable_closure (graphFieldAutomorphism P).toMonoidHom
  rintro x ⟨i, t, rfl⟩
  exact ⟨typeD4DiagramPermutation i, fieldFrobenius P t, graphField_positiveRoot P i t⟩

theorem splitBorel_invariant (P : Parameters) :
    (splitBorel P).map (graphFieldAutomorphism P).toMonoidHom = splitBorel P := by
  rw [splitBorel, Subgroup.map_sup, positiveSubgroup_invariant]
  congr 1
  apply invariant_of_cube _ (graphFieldAutomorphism_three P)
  apply stable_closure (graphFieldAutomorphism P).toMonoidHom
  rintro x ⟨i, t, rfl⟩
  exact ⟨typeD4DiagramPermutation i, Units.map (fieldFrobenius P).toMonoidHom t,
    graphField_torusWord P i t⟩

theorem splitParabolic_invariant (P : Parameters) (a : Node) :
    (splitParabolic P a).map (graphFieldAutomorphism P).toMonoidHom =
      splitParabolic P a := by
  rw [splitParabolic, Subgroup.map_sup, splitBorel_invariant]
  congr 1
  apply invariant_of_cube _ (graphFieldAutomorphism_three P)
  apply stable_closure (graphFieldAutomorphism P).toMonoidHom
  rintro x ⟨i, hi, t, rfl⟩
  exact ⟨typeD4DiagramPermutation i, (a.diagram_mem i).mpr hi,
    fieldFrobenius P t, graphField_negativeRoot P i t⟩

/-- Inclusion of the elementary fixed-point group into the split matrix group. -/
def elementaryInclusion (P : Parameters) : ElementaryGroup P →* SplitGroup P :=
  (fixedSubgroup P).subtype.comp (elementarySubgroup P).subtype

/-- Restrict a split subgroup to elementary fixed points, then take its image in
 the actual central quotient. No injectivity of that quotient is presumed. -/
def descendSubgroup (P : Parameters) (H : Subgroup (SplitGroup P)) :
    Subgroup (Carrier P) :=
  (H.comap (elementaryInclusion P)).map (toCarrier P)

theorem descendSubgroup_mono (P : Parameters) {H K : Subgroup (SplitGroup P)}
    (h : H ≤ K) : descendSubgroup P H ≤ descendSubgroup P K :=
  Subgroup.map_mono (Subgroup.comap_mono h)

/-- The positive subgroup in the adjoint graph-field carrier. -/
def unipotent (P : Parameters) : Subgroup (Carrier P) :=
  descendSubgroup P (positiveSubgroup P)

def borel (P : Parameters) : Subgroup (Carrier P) :=
  descendSubgroup P (splitBorel P)

def parabolic (P : Parameters) (a : Node) : Subgroup (Carrier P) :=
  descendSubgroup P (splitParabolic P a)

theorem unipotent_le_borel (P : Parameters) : unipotent P ≤ borel P :=
  descendSubgroup_mono P le_sup_left

theorem borel_le_parabolic (P : Parameters) (a : Node) : borel P ≤ parabolic P a :=
  descendSubgroup_mono P le_sup_left

/-- The embedded prime-to-characteristic residual O^{p′} of the parabolic.
It is separate from the full parabolic and from its solvable residual. -/
def localFactor (P : Parameters) (a : Node) : Subgroup (Carrier P) :=
  (Subgroup.primeToResidual P.prime (parabolic P a)).map (parabolic P a).subtype

theorem localFactor_le_parabolic (P : Parameters) (a : Node) :
    localFactor P a ≤ parabolic P a := by
  rintro _ ⟨g, _, rfl⟩
  exact g.property

/-- Every p-element of the finite parabolic belongs to its local factor. -/
theorem mem_localFactor_of_pow (P : Parameters) (a : Node) (g : Carrier P)
    (hg : g ∈ parabolic P a) (n : ℕ) (hpow : g ^ (P.prime ^ n) = 1) :
    g ∈ localFactor P a := by
  refine ⟨⟨g, hg⟩, Subgroup.mem_primeToResidual_of_pow (n := n) ?_, rfl⟩
  exact Subtype.ext hpow

@[simp] theorem localFactor_subgroupOf (P : Parameters) (a : Node) :
    (localFactor P a).subgroupOf (parabolic P a) =
      Subgroup.primeToResidual P.prime (parabolic P a) := by
  change ((Subgroup.primeToResidual P.prime (parabolic P a)).map
    (parabolic P a).subtype).comap (parabolic P a).subtype = _
  exact Subgroup.comap_map_eq_self_of_injective (parabolic P a).subtype_injective _

/-- Normality is relative to the parabolic, not to the ambient triality group. -/
instance localFactor_normal (P : Parameters) (a : Node) :
    ((localFactor P a).subgroupOf (parabolic P a)).Normal := by
  rw [localFactor_subgroupOf]
  infer_instance

/-- Descent preserves intersection once both subgroups contain the actual
central kernel upstairs. This condition still needs proof for the root Borels. -/
theorem descendSubgroup_inf_of_center_le (P : Parameters)
    (H K : Subgroup (SplitGroup P))
    (hH : Subgroup.center (ElementaryGroup P) ≤ H.comap (elementaryInclusion P))
    (hK : Subgroup.center (ElementaryGroup P) ≤ K.comap (elementaryInclusion P)) :
    descendSubgroup P (H ⊓ K) = descendSubgroup P H ⊓ descendSubgroup P K := by
  apply Subgroup.comap_injective (toCarrier_surjective P)
  have hker : (toCarrier P).ker = Subgroup.center (ElementaryGroup P) := by
    ext g
    exact toCarrier_eq_one P g
  simp only [descendSubgroup, Subgroup.comap_inf, Subgroup.comap_map_eq, hker,
    sup_eq_left.mpr hH, sup_eq_left.mpr hK, sup_eq_left.mpr (le_inf hH hK)]

end
end Triality.Standard.Parabolics
