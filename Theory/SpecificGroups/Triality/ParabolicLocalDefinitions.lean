module

public import Theory.SpecificGroups.Triality.RootParabolics

/-!
# Root candidates for the triality Levi decomposition

The split Levi subgroup is generated by the positive and negative simple curves
in the chosen diagram orbit. The radical candidate is generated by parabolic
conjugates of positive simple curves outside that orbit. Conjugation proves
relative normality, and partitioning the simple generators proves generation
of the parabolic by this candidate, the Levi, and the torus.

These definitions use the genuine D4 matrices. Identification of the radical
candidate with the positive-root product of GLS3 Definition 2.6.4, its order,
and a Levi decomposition still require root calculations. None is assumed here.
Source: `refs/KGroup/GLS3/chapter2.tex`, §§2.4 and 2.6.
-/

@[expose] public section
noncomputable section
namespace Triality.Standard.Parabolics

theorem positiveRoot_mem_positiveSubgroup (P : Parameters) (i : Fin 4)
    (t : ExtensionField P) : positiveRoot P i t ∈ positiveSubgroup P :=
  Subgroup.subset_closure ⟨i, t, rfl⟩

theorem positiveRoot_mem_splitParabolic (P : Parameters) (a : Node) (i : Fin 4)
    (t : ExtensionField P) : positiveRoot P i t ∈ splitParabolic P a :=
  (show positiveSubgroup P ≤ splitParabolic P a from
    le_sup_left.trans le_sup_left) (positiveRoot_mem_positiveSubgroup P i t)

theorem negativeRoot_mem_splitParabolic (P : Parameters) (a : Node) (i : Fin 4)
    (hi : i ∈ a.support) (t : ExtensionField P) :
    negativeRoot P i t ∈ splitParabolic P a :=
  (show Subgroup.closure {g | ∃ i ∈ a.support, ∃ t, g = negativeRoot P i t} ≤
    splitParabolic P a from le_sup_right) (Subgroup.subset_closure ⟨i, hi, t, rfl⟩)

/-- The subsystem subgroup on the chosen orbit, before graph-field descent. -/
def splitLevi (P : Parameters) (a : Node) : Subgroup (SplitGroup P) :=
  Subgroup.closure {g | ∃ i ∈ a.support, ∃ t,
    g = positiveRoot P i t ∨ g = negativeRoot P i t}

/-- Normal closure inside the split parabolic, expressed by ambient conjugates.
It is a candidate until the positive-root product calculation is proved. -/
def splitRadical (P : Parameters) (a : Node) : Subgroup (SplitGroup P) :=
  Subgroup.closure {g | ∃ x ∈ splitParabolic P a, ∃ i ∉ a.support, ∃ t,
    g = x * positiveRoot P i t * x⁻¹}

theorem splitLevi_le_splitParabolic (P : Parameters) (a : Node) :
    splitLevi P a ≤ splitParabolic P a := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, hi, t, rfl | rfl⟩
  · exact positiveRoot_mem_splitParabolic P a i t
  · exact negativeRoot_mem_splitParabolic P a i hi t

theorem splitRadical_le_splitParabolic (P : Parameters) (a : Node) :
    splitRadical P a ≤ splitParabolic P a := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨x, hx, i, _, t, rfl⟩
  exact (splitParabolic P a).mul_mem
    ((splitParabolic P a).mul_mem hx (positiveRoot_mem_splitParabolic P a i t))
    ((splitParabolic P a).inv_mem hx)

theorem positiveRoot_mem_splitRadical (P : Parameters) (a : Node) (i : Fin 4)
    (hi : i ∉ a.support) (t : ExtensionField P) :
    positiveRoot P i t ∈ splitRadical P a := by
  apply Subgroup.subset_closure
  exact ⟨1, (splitParabolic P a).one_mem, i, hi, t, by simp⟩

instance splitRadical_normal (P : Parameters) (a : Node) :
    ((splitRadical P a).subgroupOf (splitParabolic P a)).Normal := by
  apply (Subgroup.normal_subgroupOf_iff (splitRadical_le_splitParabolic P a)).mpr
  intro u k hu hk
  have h : splitRadical P a ≤
      (splitRadical P a).comap (MulAut.conj k).toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    rintro g ⟨x, hx, i, hi, t, rfl⟩
    apply Subgroup.subset_closure
    refine ⟨k * x, (splitParabolic P a).mul_mem hk hx, i, hi, t, ?_⟩
    simp [MulAut.conj_apply, mul_assoc]
  exact h hu

private theorem invariant_closure_of_cube {G : Type*} [Group G]
    (f : G ≃* G) (hf : ∀ x, f (f (f x)) = x) (s : Set G)
    (hs : ∀ x ∈ s, f x ∈ s) :
    (Subgroup.closure s).map f.toMonoidHom = Subgroup.closure s := by
  have h : Subgroup.closure s ≤ (Subgroup.closure s).comap f.toMonoidHom := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    exact Subgroup.subset_closure (hs x hx)
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    exact h hx
  · intro x hx
    exact ⟨f (f x), h (h hx), hf x⟩

theorem splitLevi_invariant (P : Parameters) (a : Node) :
    (splitLevi P a).map (graphFieldAutomorphism P).toMonoidHom = splitLevi P a := by
  apply invariant_closure_of_cube _ (graphFieldAutomorphism_three P)
  rintro g ⟨i, hi, t, rfl | rfl⟩
  · exact ⟨_, (a.diagram_mem i).mpr hi, _, Or.inl (graphField_positiveRoot P i t)⟩
  · exact ⟨_, (a.diagram_mem i).mpr hi, _, Or.inr (graphField_negativeRoot P i t)⟩

theorem splitRadical_invariant (P : Parameters) (a : Node) :
    (splitRadical P a).map (graphFieldAutomorphism P).toMonoidHom =
      splitRadical P a := by
  apply invariant_closure_of_cube _ (graphFieldAutomorphism_three P)
  rintro g ⟨x, hx, i, hi, t, rfl⟩
  refine ⟨graphFieldAutomorphism P x, ?_,
    Theory.AlgebraicGroup.StandardRootSystem.typeD4DiagramPermutation i, ?_,
    fieldFrobenius P t, ?_⟩
  · rw [← splitParabolic_invariant P a]
    exact ⟨x, hx, rfl⟩
  · exact fun h => hi ((a.diagram_mem i).mp h)
  · simp

/-- A generation statement only; disjointness and the radical product formula
are separate mathematical obligations. -/
theorem splitParabolic_eq_radical_sup_levi_sup_torus (P : Parameters) (a : Node) :
    splitParabolic P a = splitRadical P a ⊔
      (splitLevi P a ⊔ Subgroup.closure {g | ∃ i t, g = torusWord P i t}) := by
  apply le_antisymm
  · apply sup_le
    · apply sup_le
      · apply (Subgroup.closure_le _).mpr
        rintro g ⟨i, t, rfl⟩
        by_cases hi : i ∈ a.support
        · exact Subgroup.mem_sup_right (Subgroup.mem_sup_left (Subgroup.subset_closure
            ⟨i, hi, t, Or.inl rfl⟩))
        · exact Subgroup.mem_sup_left (positiveRoot_mem_splitRadical P a i hi t)
      · exact le_sup_right.trans le_sup_right
    · apply (Subgroup.closure_le _).mpr
      rintro g ⟨i, hi, t, rfl⟩
      exact Subgroup.mem_sup_right (Subgroup.mem_sup_left (Subgroup.subset_closure ⟨i, hi, t, Or.inr rfl⟩))
  · exact sup_le (splitRadical_le_splitParabolic P a)
      (sup_le (splitLevi_le_splitParabolic P a) (le_sup_right.trans le_sup_left))

/-- The descended subsystem subgroup. -/
def levi (P : Parameters) (a : Node) : Subgroup (Carrier P) :=
  descendSubgroup P (splitLevi P a)

/-- The descended root-defined radical candidate. -/
def radical (P : Parameters) (a : Node) : Subgroup (Carrier P) :=
  descendSubgroup P (splitRadical P a)

theorem levi_le_parabolic (P : Parameters) (a : Node) : levi P a ≤ parabolic P a :=
  descendSubgroup_mono P (splitLevi_le_splitParabolic P a)

theorem radical_le_parabolic (P : Parameters) (a : Node) : radical P a ≤ parabolic P a :=
  descendSubgroup_mono P (splitRadical_le_splitParabolic P a)

private theorem normal_map_comap {G A B : Type*} [Group G] [Group A] [Group B]
    (f : A →* G) (g : A →* B) {N H : Subgroup G}
    (hNH : N ≤ H) (hN : (N.subgroupOf H).Normal) :
    (((N.comap f).map g).subgroupOf ((H.comap f).map g)).Normal := by
  apply (Subgroup.normal_subgroupOf_iff (Subgroup.map_mono
    (Subgroup.comap_mono hNH))).mpr
  rintro u x ⟨u₀, hu, rfl⟩ ⟨x₀, hx, rfl⟩
  refine ⟨x₀ * u₀ * x₀⁻¹, ?_, by simp⟩
  change f (x₀ * u₀ * x₀⁻¹) ∈ N
  simp only [map_mul, map_inv]
  exact (Subgroup.normal_subgroupOf_iff hNH).mp hN _ _ hu hx

/-- Relative normality descends through the elementary fixed points and the
actual central quotient; no ambient normality or injectivity is needed. -/
theorem descendSubgroup_normal (P : Parameters) {N H : Subgroup (SplitGroup P)}
    (hNH : N ≤ H) (hN : (N.subgroupOf H).Normal) :
    ((descendSubgroup P N).subgroupOf (descendSubgroup P H)).Normal :=
  normal_map_comap (elementaryInclusion P) (toCarrier P) hNH hN

instance radical_normal (P : Parameters) (a : Node) :
    ((radical P a).subgroupOf (parabolic P a)).Normal :=
  descendSubgroup_normal P (splitRadical_le_splitParabolic P a) (by infer_instance)

end Triality.Standard.Parabolics
