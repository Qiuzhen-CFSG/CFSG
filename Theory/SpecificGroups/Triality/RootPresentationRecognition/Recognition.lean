module
public import Theory.SpecificGroups.Triality.RootPresentationRecognition.TorusModel
public import Theory.SpecificGroups.Triality.RootPresentationRecognition.FaithfulEvaluation
public import Theory.SpecificGroups.Triality.StandardTwoRank.Derived

/-!
# Recognition by the explicit finite triality presentation

The native relations construct evaluation from the universal presentation to
the genuine graph-field carrier. Abstract Bruhat collection and faithful native
Borel coordinates prove this evaluation is an equivalence. Evaluation into any
nontrivial group generated by the prescribed signed roots is then surjective;
simplicity of the known model makes it injective. No simplicity, order, model
map or presentation faithfulness is assumed of the unknown group.

The resulting equivalence preserves all twelve root maps, both parameterized
Weyl words, the full torus and the positive subgroup. Every positive binary
exponent is included, in particular q=2 and q=4.
Source: GLS3 2.3.5 and the literal relations 2.4.5, 2.4.7–8. This is the
presentation converse proved by collection, not a converse assumed from 2.4.8.
-/

@[expose] public noncomputable section
namespace Triality.Standard.RootPresentationRecognition
variable {n : ℕ} {hn : 0 < n}
local notation "P" => binaryParameters n hn

namespace Presentation
/-- Evaluation into the genuine graph-field carrier, constructed from its checked relations. -/
def modelHom : Universal n hn →* BinaryCarrier n hn :=
  lift (SignedModel.roots n hn) (TorusModel.relations n hn)

/-- The finite presentation is the genuine carrier, with no faithfulness premise. -/
def modelEquiv : Universal n hn ≃* BinaryCarrier n hn :=
  equivOfRootImages modelHom (lift_short (SignedModel.roots n hn) (TorusModel.relations n hn)) (lift_long (SignedModel.roots n hn) (TorusModel.relations n hn))

@[simp] theorem modelEquiv_short (s i t) :
    modelEquiv (roots.shortSigned s i t) = (SignedModel.roots n hn).shortSigned s i t :=
  lift_short (SignedModel.roots n hn) (TorusModel.relations n hn) s i t
@[simp] theorem modelEquiv_long (s i t) :
    modelEquiv (roots.longSigned s i t) = (SignedModel.roots n hn).longSigned s i t :=
  lift_long (SignedModel.roots n hn) (TorusModel.relations n hn) s i t
@[simp] theorem modelEquiv_nA (t) :
    modelEquiv (roots.nA t) = (SignedModel.roots n hn).nA t := lift_nA (SignedModel.roots n hn) (TorusModel.relations n hn) t
@[simp] theorem modelEquiv_nB (t) :
    modelEquiv (roots.nB t) = (SignedModel.roots n hn).nB t := lift_nB (SignedModel.roots n hn) (TorusModel.relations n hn) t
@[simp] theorem modelEquiv_torus (p) :
    modelEquiv (roots.torus p) = (SignedModel.roots n hn).torus p := lift_torus (SignedModel.roots n hn) (TorusModel.relations n hn) p
end Presentation

namespace SignedRoots
variable {Y : Type*} [Group Y] (L : SignedRoots (n := n) (hn := hn) Y) (R : L.Relations)

/-- Model evaluation in any group satisfying the explicit relations. -/
def modelHom : BinaryCarrier n hn →* Y :=
  (Presentation.lift L R).comp Presentation.modelEquiv.symm.toMonoidHom

@[simp] theorem modelHom_short (s i t) :
    L.modelHom R ((SignedModel.roots n hn).shortSigned s i t) = L.shortSigned s i t := by
  rw [← Presentation.modelEquiv_short]
  simp only [modelHom, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply, Presentation.lift_short]
@[simp] theorem modelHom_long (s i t) :
    L.modelHom R ((SignedModel.roots n hn).longSigned s i t) = L.longSigned s i t := by
  rw [← Presentation.modelEquiv_long]
  simp only [modelHom, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply, Presentation.lift_long]
@[simp] theorem modelHom_nA (t) :
    L.modelHom R ((SignedModel.roots n hn).nA t) = L.nA t := by
  rw [← Presentation.modelEquiv_nA]
  simp only [modelHom, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply, Presentation.lift_nA]
@[simp] theorem modelHom_nB (t) :
    L.modelHom R ((SignedModel.roots n hn).nB t) = L.nB t := by
  rw [← Presentation.modelEquiv_nB]
  simp only [modelHom, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply, Presentation.lift_nB]
@[simp] theorem modelHom_torus (p) :
    L.modelHom R ((SignedModel.roots n hn).torus p) = L.torus p := by
  rw [← Presentation.modelEquiv_torus]
  simp only [modelHom, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply, Presentation.lift_torus]

theorem modelHom_surjective (hg : L.signedClosure = ⊤) : Function.Surjective (L.modelHom R) :=
  (Presentation.lift_surjective L R hg).comp Presentation.modelEquiv.symm.surjective

/-- Only simplicity of the known model is used; the target merely is nontrivial. -/
theorem modelHom_injective [Nontrivial Y] (hg : L.signedClosure = ⊤) :
    Function.Injective (L.modelHom R) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  rcases (inferInstance : (L.modelHom R).ker.Normal).eq_bot_or_eq_top with h | h
  · exact h
  · obtain ⟨y,hy⟩ := exists_ne (1 : Y)
    obtain ⟨x,rfl⟩ := L.modelHom_surjective R hg y
    exact (hy (show x ∈ (L.modelHom R).ker by rw [h]; trivial)).elim

/-- Root-marked recognition from the map-free presentation and generation. -/
def equivalence [Nontrivial Y] (hg : L.signedClosure = ⊤) : Y ≃* BinaryCarrier n hn :=
  (MulEquiv.ofBijective (L.modelHom R)
    ⟨L.modelHom_injective R hg,L.modelHom_surjective R hg⟩).symm

variable [Nontrivial Y] (hg : L.signedClosure = ⊤)
@[simp] theorem equivalence_short (s i t) :
    L.equivalence R hg (L.shortSigned s i t) = (SignedModel.roots n hn).shortSigned s i t := by
  apply (L.equivalence R hg).symm.injective
  exact ((L.equivalence R hg).symm_apply_apply _).trans (L.modelHom_short R s i t).symm
@[simp] theorem equivalence_long (s i t) :
    L.equivalence R hg (L.longSigned s i t) = (SignedModel.roots n hn).longSigned s i t := by
  apply (L.equivalence R hg).symm.injective
  exact ((L.equivalence R hg).symm_apply_apply _).trans (L.modelHom_long R s i t).symm
@[simp] theorem equivalence_nA (t) :
    L.equivalence R hg (L.nA t) = (SignedModel.roots n hn).nA t := by
  apply (L.equivalence R hg).symm.injective
  exact ((L.equivalence R hg).symm_apply_apply _).trans (L.modelHom_nA R t).symm
@[simp] theorem equivalence_nB (t) :
    L.equivalence R hg (L.nB t) = (SignedModel.roots n hn).nB t := by
  apply (L.equivalence R hg).symm.injective
  exact ((L.equivalence R hg).symm_apply_apply _).trans (L.modelHom_nB R t).symm
@[simp] theorem equivalence_torus (p) :
    L.equivalence R hg (L.torus p) = (SignedModel.roots n hn).torus p := by
  apply (L.equivalence R hg).symm.injective
  exact ((L.equivalence R hg).symm_apply_apply _).trans (L.modelHom_torus R p).symm

theorem equivalence_factor (i : Fin 6) (v : PositiveParameters n hn) :
    L.equivalence R hg (L.positive.factor i v) = (nativePositiveRoots n hn).factor i v := by
  fin_cases i <;> first | exact L.equivalence_short R hg true _ _ | exact L.equivalence_long R hg true _ _
theorem equivalence_product (v : PositiveParameters n hn) :
    L.equivalence R hg (L.positive.product v) = (nativePositiveRoots n hn).product v := by
  simp only [PositiveRoots.product,map_list_prod,List.map_ofFn,Function.comp_def,
    L.equivalence_factor R hg]

/-- The same equivalence preserves the entire six-root positive subgroup. -/
theorem equivalence_positive :
    L.positive.positiveClosure.map (L.equivalence R hg).toMonoidHom = Parabolics.unipotent P := by
  rw [← native_positiveClosure n hn]
  ext y
  constructor
  · rintro ⟨x,hx,rfl⟩
    obtain ⟨v,rfl⟩ := (L.positive.mem_positiveClosure_iff R.positiveRelations x).mp hx
    rw [MulEquiv.coe_toMonoidHom,L.equivalence_product R hg]
    exact ((nativePositiveRoots n hn).mem_positiveClosure_iff (native_relations n hn) _).mpr ⟨v,rfl⟩
  · intro hy
    obtain ⟨v,rfl⟩ := ((nativePositiveRoots n hn).mem_positiveClosure_iff (native_relations n hn) y).mp hy
    exact ⟨L.positive.product v,(L.positive.mem_positiveClosure_iff R.positiveRelations _).mpr ⟨v,rfl⟩,
      L.equivalence_product R hg v⟩
end SignedRoots
end Triality.Standard.RootPresentationRecognition
