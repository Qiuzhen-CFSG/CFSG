module

public import Theory.SpecificGroups.Triality.RootPresentationRecognition.SignedRelations

/-!
# The signed folded Weyl relations

The two simple words act on all twelve folded roots. In the literal orbit
marking, the arm reflection sends C(s) to D(F²(s)) and D(s) to C(F(s)).
The negative roots retain these same parameter shifts. These relations reduce
signed-root generation to the positive subgroup and the two simple words;
no homomorphism to the model or order bound is an input.

Source: GLS3 2.4.2 and 2.4.8(e), using the orbit origins of
`RadicalCoordinates/LeviCommutators/FoldedRoots.lean`.
-/

@[expose] public noncomputable section
namespace Triality.Standard.RootPresentationRecognition.SignedRoots
variable {n : ℕ} {hn : 0 < n} {Y : Type*} [Group Y]
local notation "P" => binaryParameters n hn

/-- `true` is the positive sign. -/
def shortSigned (L : SignedRoots (n := n) (hn := hn) Y) (s : Bool)
    (i : Fin 3) (t : ExtensionField P) : Y :=
  if s then L.shortValue i t else L.negativeShortValue i t

def longSigned (L : SignedRoots (n := n) (hn := hn) Y) (s : Bool)
    (i : Fin 3) (t : fixedField P) : Y :=
  if s then L.longValue i t else L.negativeLongValue i t

/-- Left conjugation by the two *defined* simple root words. -/
structure ActionRelations (L : SignedRoots (n := n) (hn := hn) Y) : Prop where
  arms_short0 : ∀ s t, L.nA 1 * L.shortSigned s 0 t * (L.nA 1)⁻¹ = L.shortSigned (!s) 0 t
  arms_short1 : ∀ s t, L.nA 1 * L.shortSigned s 1 t * (L.nA 1)⁻¹ =
    L.shortSigned s 2 (fieldFrobenius P (fieldFrobenius P t))
  arms_short2 : ∀ s t, L.nA 1 * L.shortSigned s 2 t * (L.nA 1)⁻¹ =
    L.shortSigned s 1 (fieldFrobenius P t)
  arms_long : ∀ s i t, L.nA 1 * L.longSigned s i t * (L.nA 1)⁻¹ =
    L.longSigned s (![1, 0, 2] i) t
  central_short : ∀ s i t, L.nB 1 * L.shortSigned s i t * (L.nB 1)⁻¹ =
    L.shortSigned s (![1, 0, 2] i) t
  central_long0 : ∀ s t, L.nB 1 * L.longSigned s 0 t * (L.nB 1)⁻¹ = L.longSigned (!s) 0 t
  central_long1 : ∀ s t, L.nB 1 * L.longSigned s 1 t * (L.nB 1)⁻¹ = L.longSigned s 2 t
  central_long2 : ∀ s t, L.nB 1 * L.longSigned s 2 t * (L.nB 1)⁻¹ = L.longSigned s 1 t

/-- The subgroup generated by all twelve signed root ranges. -/
def signedClosure (L : SignedRoots (n := n) (hn := hn) Y) : Subgroup Y :=
  L.positive.positiveClosure ⊔ Subgroup.closure
    (Set.range (fun z : Fin 3 × ExtensionField P => L.negativeShortValue z.1 z.2) ∪
     Set.range (fun z : Fin 3 × fixedField P => L.negativeLongValue z.1 z.2))

/-- Only the two unit-parameter Weyl words are adjoined to the positive subgroup. -/
def simpleClosure (L : SignedRoots (n := n) (hn := hn) Y) : Subgroup Y :=
  L.positive.positiveClosure ⊔ Subgroup.closure {L.nA 1, L.nB 1}

private theorem positive_short_mem (L : SignedRoots (n := n) (hn := hn) Y)
    (i : Fin 3) (t : ExtensionField P) : L.shortValue i t ∈ L.positive.positiveClosure := by
  have h : ∀ i : Fin 3, ∃ a : Fin 6 × PositiveParameters n hn,
      L.positive.factor a.1 a.2 = L.shortValue i t := by
    intro i
    fin_cases i
    · exact ⟨(0, (fun _ => t, 0)), rfl⟩
    · exact ⟨(2, (fun _ => t, 0)), rfl⟩
    · exact ⟨(3, (fun _ => t, 0)), rfl⟩
  exact Subgroup.subset_closure (h i)

private theorem positive_long_mem (L : SignedRoots (n := n) (hn := hn) Y)
    (i : Fin 3) (t : fixedField P) : L.longValue i t ∈ L.positive.positiveClosure := by
  have h : ∀ i : Fin 3, ∃ a : Fin 6 × PositiveParameters n hn,
      L.positive.factor a.1 a.2 = L.longValue i t := by
    intro i
    fin_cases i
    · exact ⟨(1, (0, fun _ => t)), rfl⟩
    · exact ⟨(4, (0, fun _ => t)), rfl⟩
    · exact ⟨(5, (0, fun _ => t)), rfl⟩
  exact Subgroup.subset_closure (h i)

private theorem conj_mem {H : Subgroup Y} {g x : Y} (hg : g ∈ H) (hx : x ∈ H) :
    g * x * g⁻¹ ∈ H := H.mul_mem (H.mul_mem hg hx) (H.inv_mem hg)

/-- All negative roots follow from the two simple conjugations; cubicity removes
exactly the Frobenius shift needed to reach D with its original parameter. -/
theorem signedClosure_eq_simpleClosure (L : SignedRoots (n := n) (hn := hn) Y)
    (h : L.ActionRelations) : L.signedClosure = L.simpleClosure := by
  have ha : L.nA 1 ∈ L.simpleClosure :=
    Subgroup.mem_sup_right (Subgroup.subset_closure (by simp))
  have hb : L.nB 1 ∈ L.simpleClosure :=
    Subgroup.mem_sup_right (Subgroup.subset_closure (by simp))
  have hA (t : ExtensionField P) : L.negativeShortValue 0 t ∈ L.simpleClosure := by
    have he := h.arms_short0 true t
    simp only [shortSigned, Bool.not_true, Bool.false_eq_true, if_true, if_false] at he
    rw [← he]
    exact conj_mem ha (Subgroup.mem_sup_left (positive_short_mem L 0 t))
  have hB (t : fixedField P) : L.negativeLongValue 0 t ∈ L.simpleClosure := by
    have he := h.central_long0 true t
    simp only [longSigned, Bool.not_true, Bool.false_eq_true, if_true, if_false] at he
    rw [← he]
    exact conj_mem hb (Subgroup.mem_sup_left (positive_long_mem L 0 t))
  have hC (t : ExtensionField P) : L.negativeShortValue 1 t ∈ L.simpleClosure := by
    have he := h.central_short false 0 t
    have he' : L.nB 1 * L.negativeShortValue 0 t * (L.nB 1)⁻¹ =
        L.negativeShortValue 1 t := by simpa [shortSigned] using he
    simpa only [he'] using conj_mem hb (hA t)
  have hD (t : ExtensionField P) : L.negativeShortValue 2 t ∈ L.simpleClosure := by
    have he := h.arms_short1 false (fieldFrobenius P t)
    simp only [shortSigned, Bool.false_eq_true, if_false, fieldFrobenius_three] at he
    rw [← he]
    exact conj_mem ha (hC _)
  have hE (t : fixedField P) : L.negativeLongValue 1 t ∈ L.simpleClosure := by
    have he := h.arms_long false 0 t
    have he' : L.nA 1 * L.negativeLongValue 0 t * (L.nA 1)⁻¹ =
        L.negativeLongValue 1 t := by simpa [longSigned] using he
    simpa only [he'] using conj_mem ha (hB t)
  have hF (t : fixedField P) : L.negativeLongValue 2 t ∈ L.simpleClosure := by
    have he := h.central_long1 false t
    have he' : L.nB 1 * L.negativeLongValue 1 t * (L.nB 1)⁻¹ =
        L.negativeLongValue 2 t := by simpa [longSigned] using he
    simpa only [he'] using conj_mem hb (hE t)
  apply le_antisymm
  · refine sup_le le_sup_left ((Subgroup.closure_le _).mpr ?_)
    rintro g (⟨⟨i, t⟩, rfl⟩ | ⟨⟨i, t⟩, rfl⟩)
    · fin_cases i <;> first | exact hA t | exact hC t | exact hD t
    · fin_cases i <;> first | exact hB t | exact hE t | exact hF t
  · have hnegS (t : ExtensionField P) : L.negativeShortValue 0 t ∈ L.signedClosure :=
      Subgroup.mem_sup_right (Subgroup.subset_closure (Or.inl ⟨(0,t), rfl⟩))
    have hnegL (t : fixedField P) : L.negativeLongValue 0 t ∈ L.signedClosure :=
      Subgroup.mem_sup_right (Subgroup.subset_closure (Or.inr ⟨(0,t), rfl⟩))
    refine sup_le le_sup_left ((Subgroup.closure_le _).mpr ?_)
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact Subgroup.mul_mem _ (Subgroup.mul_mem _
        (Subgroup.mem_sup_left (positive_short_mem L 0 _)) (hnegS _))
        (Subgroup.mem_sup_left (positive_short_mem L 0 _))
    · exact Subgroup.mul_mem _ (Subgroup.mul_mem _
        (Subgroup.mem_sup_left (positive_long_mem L 0 _)) (hnegL _))
        (Subgroup.mem_sup_left (positive_long_mem L 0 _))

end Triality.Standard.RootPresentationRecognition.SignedRoots
