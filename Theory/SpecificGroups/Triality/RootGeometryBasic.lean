module

public import Theory.SpecificGroups.Triality.RootParabolics

/-!
# Elementary root calculations for the triality parabolics

The addition laws for the actual pinned Geck curves imply that each simple-root
value is killed by the characteristic prime. The two split parabolic candidates
generate the split group because their negative simple roots exhaust the D4 base.
This last assertion is upstairs: fixed points do not in general preserve joins.

These are preliminary calculations for GLS3 §§2.3–2.6
(`refs/KGroup/GLS3/chapter2.tex`). They do not assert a root normal form or a
Bruhat decomposition, nor that a group generated by p-elements is a p-group.
-/

public section

open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.SimpleGeckGroup
namespace Triality.Standard.Parabolics
noncomputable section

theorem positiveRoot_add (P : Parameters) (i : Fin 4) (s t : ExtensionField P) :
    positiveRoot P i (s + t) = positiveRoot P i s * positiveRoot P i t :=
  Subtype.ext (positiveUnit_add _ s t)

theorem negativeRoot_add (P : Parameters) (i : Fin 4) (s t : ExtensionField P) :
    negativeRoot P i (s + t) = negativeRoot P i s * negativeRoot P i t :=
  Subtype.ext (negativeUnit_add _ s t)

theorem positiveRoot_zero (P : Parameters) (i : Fin 4) :
    positiveRoot P i 0 = 1 := by
  apply mul_left_cancel (a := positiveRoot P i 0)
  simpa only [zero_add, mul_one] using (positiveRoot_add P i 0 0).symm

theorem negativeRoot_zero (P : Parameters) (i : Fin 4) :
    negativeRoot P i 0 = 1 := by
  apply mul_left_cancel (a := negativeRoot P i 0)
  simpa only [zero_add, mul_one] using (negativeRoot_add P i 0 0).symm

theorem positiveRoot_pow (P : Parameters) (i : Fin 4) (t : ExtensionField P) (k : ℕ) :
    positiveRoot P i t ^ k = positiveRoot P i (k • t) := by
  induction k with
  | zero => simp [positiveRoot_zero]
  | succ k ih => rw [pow_succ, ih, succ_nsmul, positiveRoot_add]

theorem negativeRoot_pow (P : Parameters) (i : Fin 4) (t : ExtensionField P) (k : ℕ) :
    negativeRoot P i t ^ k = negativeRoot P i (k • t) := by
  induction k with
  | zero => simp [negativeRoot_zero]
  | succ k ih => rw [pow_succ, ih, succ_nsmul, negativeRoot_add]

/-- A pinned positive curve consists of elements killed by the characteristic. -/
theorem positiveRoot_pow_prime (P : Parameters) (i : Fin 4) (t : ExtensionField P) :
    positiveRoot P i t ^ P.prime = 1 := by
  rw [positiveRoot_pow, nsmul_eq_mul, CharP.cast_eq_zero, zero_mul,
    positiveRoot_zero]

/-- A pinned negative curve consists of elements killed by the characteristic. -/
theorem negativeRoot_pow_prime (P : Parameters) (i : Fin 4) (t : ExtensionField P) :
    negativeRoot P i t ^ P.prime = 1 := by
  rw [negativeRoot_pow, nsmul_eq_mul, CharP.cast_eq_zero, zero_mul,
    negativeRoot_zero]

/-- Generation of the split group, before taking graph-field fixed points. -/
theorem splitParabolic_sup (P : Parameters) :
    splitParabolic P .arms ⊔ splitParabolic P .central = ⊤ := by
  let H := splitParabolic P .arms ⊔ splitParabolic P .central
  have hp (i : Fin 4) (t : ExtensionField P) : positiveRoot P i t ∈ H := by
    apply (show splitParabolic P .arms ≤ H from le_sup_left)
    apply (show splitBorel P ≤ splitParabolic P .arms from le_sup_left)
    apply (show positiveSubgroup P ≤ splitBorel P from le_sup_left)
    exact Subgroup.subset_closure ⟨i, t, rfl⟩
  have hn (i : Fin 4) (t : ExtensionField P) : negativeRoot P i t ∈ H := by
    by_cases hi : i = 1
    · apply (show splitParabolic P .central ≤ H from le_sup_right)
      exact Subgroup.mem_sup_right (Subgroup.subset_closure ⟨i, hi, t, rfl⟩)
    · apply (show splitParabolic P .arms ≤ H from le_sup_left)
      exact Subgroup.mem_sup_right (Subgroup.subset_closure ⟨i, hi, t, rfl⟩)
  have hgen : subgroup (typeDRootPairing_base 2) (ExtensionField P) ≤
      H.map (subgroup (typeDRootPairing_base 2) (ExtensionField P)).subtype := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨s, i⟩, t, rfl⟩
    obtain ⟨j, rfl⟩ := (typeDRootPairing_baseEquiv 2).surjective i
    cases s
    · exact ⟨negativeRoot P j t, hn j t, rfl⟩
    · exact ⟨positiveRoot P j t, hp j t, rfl⟩
  apply top_unique
  intro g _
  obtain ⟨x, hx, he⟩ := hgen g.property
  have he' : x = g := Subtype.ext he
  exact he' ▸ hx

end
end Triality.Standard.Parabolics
