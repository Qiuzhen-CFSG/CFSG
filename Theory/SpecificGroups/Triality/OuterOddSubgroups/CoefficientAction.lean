module

public import Theory.SpecificGroups.Triality.StandardModel

/-!
# Cubic coefficient actions on the standard triality carrier

Automorphisms of GF(q³) commute with the defining graph-field map. Restrict
entrywise action to its fixed points, then to the subgroup generated by
p-elements, and finally descend through that subgroup's own center. This gives
an action on the exact carrier from `StandardModel` for every parameter record.

The descent is adapted from the saved triality outer-two development
`Theory/SpecificGroups/Triality/CoefficientAutomorphisms.lean` (workspace
`fa133d5f612b4c2294c41ae1d9ba2604`), retaining its entrywise action and elementary
central-quotient conventions. The separate namespace and module preserve that
owner's files. No parabolic or Levi structure is used here.

Source: GLS3 §2.5, especially 2.5.12(d) and 2.5.13, in
`refs/KGroup/GLS3/chapter2.tex`. This constructs the actions, without asserting
that they exhaust the outer automorphisms or act faithfully on the quotient.
-/

@[expose] public section
noncomputable section
namespace Triality.Standard.OuterOdd
open RootPairing.SimpleGeckGroup
open Theory.AlgebraicGroup.StandardRootSystem

section FunctorLaws
variable {ι R M N : Type*} [CommRing R] [IsDomain R] [CharZero R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [P.IsCrystallographic] [P.IsReduced]
  {b : P.Base} [Fintype ι] [DecidableEq ι]
  {S : Type*} [CommRing S]

private theorem coefficient_equiv_one (g : RootPairing.SimpleGeckGroup.Carrier b S) : equiv (1 : S ≃+* S) g = g := by
  apply Subtype.ext
  apply Units.ext
  rfl

private theorem coefficient_equiv_mul (e f : S ≃+* S) (g : RootPairing.SimpleGeckGroup.Carrier b S) :
    equiv (e * f) g = equiv e (equiv f g) := by
  apply Subtype.ext
  apply Units.ext
  rfl

private theorem coefficient_equiv_commute (e f : S ≃+* S)
    (h : ∀ t, e (f t) = f (e t)) (g : RootPairing.SimpleGeckGroup.Carrier b S) :
    equiv e (equiv f g) = equiv f (equiv e g) := by
  apply Subtype.ext
  apply Units.ext
  ext i j
  exact h _

end FunctorLaws

/-- The full cubic coefficient-field automorphism group, not Aut(GF(q)). -/
abbrev CoefficientAut (P : Parameters) := ExtensionField P ≃+* ExtensionField P

/-- Entrywise action on the split D4 group. -/
def coefficientSplit (P : Parameters) (e : CoefficientAut P) : SplitGroup P ≃* SplitGroup P :=
  equiv e

@[simp] theorem coefficientSplit_positive (P : Parameters) (e : CoefficientAut P)
    (i : (typeDRootPairing_base 2).support) (t : ExtensionField P) :
    coefficientSplit P e (positive i t) =
      positive i (e t) := equiv_positive e _ t

@[simp] theorem coefficientSplit_negative (P : Parameters) (e : CoefficientAut P)
    (i : (typeDRootPairing_base 2).support) (t : ExtensionField P) :
    coefficientSplit P e (negative i t) =
      negative i (e t) := equiv_negative e _ t

/-- Coefficient automorphisms commute with the graph-field defining map. -/
theorem coefficientSplit_graphField (P : Parameters) (e : CoefficientAut P)
    (g : SplitGroup P) :
    graphFieldAutomorphism P (coefficientSplit P e g) =
      coefficientSplit P e (graphFieldAutomorphism P g) := by
  have hf (x : SplitGroup P) :
      fieldAutomorphism P (coefficientSplit P e x) =
        coefficientSplit P e (fieldAutomorphism P x) :=
    coefficient_equiv_commute (fieldFrobenius P) e
      (fun t => (map_pow e t P.q).symm) x
  change fieldAutomorphism P (diagramAutomorphism P (coefficientSplit P e g)) = _
  rw [show diagramAutomorphism P (coefficientSplit P e g) =
    coefficientSplit P e (diagramAutomorphism P g) from diagramEquiv_equiv _ _ _ e g]
  exact hf _

private theorem restrict_mem_iff {G : Type*} [Group G] (e : G ≃* G)
    (H : Subgroup G) (h : ∀ x, e x ∈ H ↔ x ∈ H) :
    H.map e.toMonoidHom = H := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact (h y).mpr hy
  · intro hx
    exact ⟨e.symm x, (h _).mp (by simpa using hx), e.apply_symm_apply x⟩

/-- Restrict an automorphism to an invariant subgroup, retaining its pointwise formula. -/
def restrictCoefficientSubgroup {G : Type*} [Group G] (e : G ≃* G) (H : Subgroup G)
    (h : H.map e.toMonoidHom = H) : H ≃* H where
  toFun (x : H) := ⟨e (x : G), h.le ⟨x, x.property, rfl⟩⟩
  invFun (x : H) := ⟨e.symm (x : G), by
    obtain ⟨y, hy, he⟩ := h.ge x.property
    have he' : e.symm (x : G) = y := by
      change e y = (x : G) at he
      rw [← he, e.symm_apply_apply]
    exact he'.symm ▸ hy⟩
  left_inv x := Subtype.ext (e.symm_apply_apply (x : G))
  right_inv x := Subtype.ext (e.apply_symm_apply (x : G))
  map_mul' x y := Subtype.ext (map_mul e (x : G) (y : G))

/-- Restriction to the actual graph-field fixed-point subgroup. -/
def coefficientFixed (P : Parameters) (e : CoefficientAut P) :
    fixedSubgroup P ≃* fixedSubgroup P :=
  restrictCoefficientSubgroup (coefficientSplit P e) _ (by
    apply restrict_mem_iff
    intro g
    simp only [mem_fixedSubgroup, coefficientSplit_graphField]
    exact (coefficientSplit P e).injective.eq_iff)

@[simp] theorem coefficientFixed_val (P : Parameters) (e : CoefficientAut P)
    (g : fixedSubgroup P) :
    (coefficientFixed P e g : SplitGroup P) = coefficientSplit P e g := rfl

theorem map_power_generated {G : Type*} [Group G] (p : ℕ) (e : G ≃* G) :
    (Subgroup.closure {g : G | ∃ n : ℕ, g ^ (p ^ n) = 1}).map e.toMonoidHom =
      Subgroup.closure {g : G | ∃ n : ℕ, g ^ (p ^ n) = 1} := by
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨n, hn⟩, rfl⟩
    exact ⟨n, by rw [← map_pow, hn, map_one]⟩
  · rintro ⟨n, hn⟩
    exact ⟨e.symm x, ⟨n, by rw [← map_pow, hn, map_one]⟩, e.apply_symm_apply x⟩

/-- Restriction to the subgroup generated by p-elements, before central quotient. -/
def coefficientElementary (P : Parameters) (e : CoefficientAut P) :
    ElementaryGroup P ≃* ElementaryGroup P :=
  restrictCoefficientSubgroup (coefficientFixed P e) _
    (map_power_generated P.prime (coefficientFixed P e))

@[simp] theorem coefficientElementary_val (P : Parameters) (e : CoefficientAut P)
    (g : ElementaryGroup P) :
    (coefficientElementary P e g : fixedSubgroup P) = coefficientFixed P e g := rfl

/-- The coefficient automorphism of the genuine adjoint triality carrier. -/
def coefficientCarrier (P : Parameters) (e : CoefficientAut P) : Carrier P ≃* Carrier P :=
  QuotientGroup.congr _ _ (coefficientElementary P e)
    (Subgroup.characteristic_iff_map_eq.mp (inferInstance :
      (Subgroup.center (ElementaryGroup P)).Characteristic) _)

@[simp] theorem coefficientCarrier_toCarrier (P : Parameters) (e : CoefficientAut P)
    (g : ElementaryGroup P) :
    coefficientCarrier P e (toCarrier P g) = toCarrier P (coefficientElementary P e g) := rfl

@[simp] theorem coefficientSplit_one (P : Parameters) (g : SplitGroup P) :
    coefficientSplit P 1 g = g := by
  exact coefficient_equiv_one g

@[simp] theorem coefficientSplit_mul (P : Parameters) (e f : CoefficientAut P)
    (g : SplitGroup P) :
    coefficientSplit P (e * f) g = coefficientSplit P e (coefficientSplit P f g) := by
  exact coefficient_equiv_mul e f g

@[simp] theorem coefficientElementary_one (P : Parameters) (g : ElementaryGroup P) :
    coefficientElementary P 1 g = g := by
  apply Subtype.ext
  change coefficientFixed P 1 (g : fixedSubgroup P) = g
  apply Subtype.ext
  change coefficientSplit P 1 (g : fixedSubgroup P).val = _
  exact coefficientSplit_one P _

theorem coefficientElementary_mul (P : Parameters) (e f : CoefficientAut P)
    (g : ElementaryGroup P) :
    coefficientElementary P (e * f) g =
      coefficientElementary P e (coefficientElementary P f g) := by
  apply (elementarySubgroup P).subtype_injective
  simp only [Subgroup.coe_subtype, coefficientElementary_val]
  apply (fixedSubgroup P).subtype_injective
  simp only [Subgroup.coe_subtype, coefficientFixed_val, coefficientSplit_mul]

/-- The full coefficient automorphism group acts on the adjoint carrier. -/
def coefficientAction (P : Parameters) : CoefficientAut P →* MulAut (Carrier P) where
  toFun := coefficientCarrier P
  map_one' := by
    apply MulEquiv.ext
    intro x
    obtain ⟨g, rfl⟩ := toCarrier_surjective P x
    simp
  map_mul' e f := by
    apply MulEquiv.ext
    intro x
    obtain ⟨g, rfl⟩ := toCarrier_surjective P x
    change coefficientCarrier P (e * f) (toCarrier P g) =
      coefficientCarrier P e (coefficientCarrier P f (toCarrier P g))
    exact (coefficientCarrier_toCarrier P (e * f) g).trans
      ((congrArg (toCarrier P) (coefficientElementary_mul P e f g)).trans
        ((coefficientCarrier_toCarrier P e (coefficientElementary P f g)).symm.trans
          (congrArg (coefficientCarrier P e) (coefficientCarrier_toCarrier P f g).symm)))

end Triality.Standard.OuterOdd
