module

public import Theory.SpecificGroups.Triality.SimplyConnectedModel.GraphField.Pinning
public import Theory.GroupTheory.FixedElementaryTransport

/-!
# The concrete Spin graph-field action and finite carriers

On the actual Clifford Spin D4 group over an algebraically closed field of
characteristic two, `sigma k n` is literally graph followed by `2^n` Frobenius.
The separately regular maps compose to `regularSigma`. Root generation proves
commutation, and the order-three diagram action gives cube `2^(3*n)` Frobenius.
Thus fixed points form a finite group for every `n > 0`, including `n = 1`.

`FixedGroup`, `ElementaryGroup`, and `Carrier` keep the full fixed group, its
subgroup generated by two-elements, and the quotient by that subgroup's own
center distinct. They are identified with the exact definitions and inclusion
in `SteinbergTensors.Orientation` and `FixedElementaryTransport`. On fixed
points the field action equals the inverse graph action, fixing the convention
for representation-theoretic exponent overflow.

This constructs the early finite carrier without simple/universal geometry,
Borel big cells, rational representations, or a comparison with a second model.
Sources: GLS3, Chapter 1, §1.15; Chapter 2, §§2.1–2.3; Steinberg, §12
(`refs/KGroup/GLS3/Chapter2St2.tex`).
-/

@[expose] public section
noncomputable section
namespace Triality.SimplyConnected.GraphField
open Theory Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open Theory.GroupTheory Triality.RestrictedWeights Pinning
variable (k : Type*) [Field k] [IsAlgClosed k] [CharP k 2]

/-- The literal graph-then-field point automorphism, for `q = 2^n`. -/
def sigma (n : ℕ) : MulAut (Points k) :=
  (Diagram.pinnedAut k).trans (frobeniusPointAut k n)

@[simp] theorem sigma_apply (n : ℕ) (g : Points k) :
    sigma k n g = frobeniusPointAut k n (Diagram.pinnedAut k g) := rfl

/-- Regularity is supplied by the actual Frobenius lift and regular diagram map. -/
def regularSigma (n : ℕ) : AlgebraicGroup.Morphism (groupVariety k) (groupVariety k) :=
  (regularFrobeniusLift k n).comp (Diagram.pinnedIso k).hom

@[simp] theorem regularSigma_onPoints (n : ℕ) (g : Points k) :
    (regularSigma k n).onPoints g = sigma k n g :=
  regularFrobeniusLift_onPoints k n (Diagram.pinnedAut k g)

theorem regularSigma_realizes (n : ℕ) :
    IsAlgebraicRealization (sigma k n) (regularSigma k n) :=
  fun g => (regularSigma_onPoints k n g).symm

/-- The graph-field formula holds on every actual root, with the forward root cycle. -/
theorem sigma_rootPoint (n : ℕ) (r : RootIndex) (a : k) :
    sigma k n (rootPoint k r a) =
      rootPoint k (typeD4DiagramEquiv.indexEquiv r) (a ^ (2 ^ n)) := by
  rw [sigma_apply, diagram_rootPoint, frobenius_rootPoint]

/-- Over the algebraic closure the cube is the `2^(3*n)` Frobenius. -/
theorem sigma_cube (n : ℕ) (g : Points k) :
    sigma k n (sigma k n (sigma k n g)) = frobeniusPointAut k (3 * n) g := by
  calc
    _ = frobeniusPointAut k n (frobeniusPointAut k n (frobeniusPointAut k n g)) := by
      simp only [sigma_apply, ← frobenius_diagram_commute, Diagram.pinnedAut_cube]
    _ = frobeniusPointAut k (3 * n) g := by
      rw [← frobeniusPointAut_add_apply, ← frobeniusPointAut_add_apply]
      congr 2
      omega

theorem sigma_pow_three (n : ℕ) : sigma k n ^ 3 = frobeniusPointAut k (3 * n) := by
  ext g
  exact sigma_cube k n g

omit [IsAlgClosed k] [CharP k 2] in
private theorem morphism_cube {K : Variety k} [AlgebraicGroup K]
    (f h : AlgebraicGroup.Morphism K K)
    (hc : ∀ g, f.onPoints (f.onPoints (f.onPoints g)) = h.onPoints g) :
    f.comp (f.comp f) = h := AlgebraicGroup.Morphism.ext _ _ (funext hc)

/-- The same cube identity holds as an equality of regular algebraic morphisms. -/
theorem regularSigma_cube (n : ℕ) :
    (regularSigma k n).comp ((regularSigma k n).comp (regularSigma k n)) =
      regularFrobeniusLift k (3 * n) := by
  apply morphism_cube
  intro g
  simp only [regularSigma_onPoints, regularFrobeniusLift_onPoints, sigma_cube]

/-- The regular Frobenius point map as a monoid endomorphism, for taking iterates. -/
def frobeniusEnd (n : ℕ) : Monoid.End (Points k) :=
  (regularFrobeniusLift k n).onPoints

@[simp] theorem frobeniusEnd_apply (n : ℕ) (g : Points k) :
    frobeniusEnd k n g = frobeniusPointAut k n g := regularFrobeniusLift_onPoints k n g

/-- Powers of the one-step regular Frobenius give exactly the chosen exponent maps. -/
theorem frobenius_onPoints_pow (n : ℕ) :
    frobeniusEnd k 1 ^ n = frobeniusEnd k n := by
  induction n with
  | zero =>
      ext g
      exact (frobeniusEnd_apply k 0 g).trans (frobeniusPointAut_zero_apply k g) |>.symm
  | succ n ih =>
      rw [pow_succ', ih]
      ext g
      change frobeniusEnd k 1 (frobeniusEnd k n g) = frobeniusEnd k (n + 1) g
      simp only [frobeniusEnd_apply]
      rw [Nat.add_comm n 1, frobeniusPointAut_add_apply]

/-- The point map is exactly the composition used by `SteinbergTensors.Orientation`. -/
theorem sigma_toMonoidHom (n : ℕ) :
    (sigma k n).toMonoidHom =
      (frobeniusEnd k 1 ^ n).comp (Diagram.pinnedAut k).toMonoidHom := by
  rw [frobenius_onPoints_pow]
  ext g
  exact (regularFrobeniusLift_onPoints k n (Diagram.pinnedAut k g)).symm

/-- All fixed points, before taking the subgroup generated by two-elements. -/
def fixedSubgroup (n : ℕ) : Subgroup (Points k) :=
  FixedElementary.fixedSubgroup (sigma k n)

/-- The source `O^{2′}` inside the full fixed group. -/
def elementarySubgroup (n : ℕ) : Subgroup (fixedSubgroup k n) :=
  FixedElementary.elementarySubgroup 2 (sigma k n)

abbrev FixedGroup (n : ℕ) : Type _ := fixedSubgroup k n
abbrev ElementaryGroup (n : ℕ) : Type _ := elementarySubgroup k n

/-- Quotient the elementary group by its own center, also at exponent one. -/
abbrev Carrier (n : ℕ) :=
  ElementaryGroup k n ⧸ Subgroup.center (ElementaryGroup k n)

/-- The literal inclusion of the elementary group in the actual Spin points. -/
def elementaryInclusion (n : ℕ) : ElementaryGroup k n →* Points k :=
  (fixedSubgroup k n).subtype.comp (elementarySubgroup k n).subtype

/-- The canonical central quotient map from the elementary group. -/
def toCarrier (n : ℕ) : ElementaryGroup k n →* Carrier k n :=
  QuotientGroup.mk' (Subgroup.center (ElementaryGroup k n))

@[simp] theorem mem_fixedSubgroup (n : ℕ) (g : Points k) :
    g ∈ fixedSubgroup k n ↔ frobeniusPointAut k n (Diagram.pinnedAut k g) = g := Iff.rfl

/-- Fixed points inject into the ordinary `2^(3*n)` Frobenius fixed group. -/
theorem fixedSubgroup_le_frobeniusFixedSubgroup (n : ℕ) :
    fixedSubgroup k n ≤ frobeniusFixedSubgroup k (3 * n) := by
  intro g hg
  change sigma k n g = g at hg
  change frobeniusPointAut k (3 * n) g = g
  rw [← sigma_cube, hg, hg, hg]

/-- The source fixed-point inclusion used for finiteness. -/
def fixedInclusion (n : ℕ) : FixedGroup k n →* frobeniusFixedSubgroup k (3 * n) :=
  Subgroup.inclusion (fixedSubgroup_le_frobeniusFixedSubgroup k n)

theorem fixedInclusion_injective (n : ℕ) : Function.Injective (fixedInclusion k n) :=
  Subgroup.inclusion_injective (fixedSubgroup_le_frobeniusFixedSubgroup k n)

/-- No lower bound stronger than positivity is needed: this includes `n = 1`. -/
theorem fixed_finite (n : ℕ) (hn : 0 < n) : Finite (FixedGroup k n) := by
  let := finite_frobeniusFixedSubgroup k (3 * n) (by omega)
  exact Finite.of_injective (fixedInclusion k n) (fixedInclusion_injective k n)

theorem elementary_finite (n : ℕ) (hn : 0 < n) : Finite (ElementaryGroup k n) := by
  let := fixed_finite k n hn
  infer_instance

theorem carrier_finite (n : ℕ) (hn : 0 < n) : Finite (Carrier k n) := by
  let := elementary_finite k n hn
  infer_instance

/-- The regular graph-field map is Steinberg for every positive exponent. -/
theorem regularSigma_isSteinberg (n : ℕ) (hn : 0 < n) :
    IsAlgebraicSteinbergEndomorphism (regularSigma k n) := by
  constructor
  · intro g
    obtain ⟨h, hh⟩ := (sigma k n).surjective g
    exact ⟨h, (regularSigma_onPoints k n h).trans hh⟩
  · have h : Finite {g : Points k | sigma k n g = g} := fixed_finite k n hn
    simpa only [regularSigma_onPoints] using h

theorem sigma_mem_steinbergAutomorphismSet (n : ℕ) (hn : 0 < n) :
    sigma k n ∈ SteinbergAutomorphismSet (groupVariety k) :=
  ⟨regularSigma k n, regularSigma_realizes k n, regularSigma_isSteinberg k n hn⟩

/-- At exponent overflow the field map is the inverse graph map. -/
theorem field_eq_inverse_graph (n : ℕ) (g : FixedGroup k n) :
    frobeniusPointAut k n (g : Points k) = (Diagram.pinnedAut k).symm g :=
  SteinbergTensors.field_eq_inverse_graph (Diagram.pinnedAut k)
    (frobeniusPointAut k n).toMonoidHom (frobenius_diagram_commute k n) g.property

/-- The same inverse-wrap identity on the actual elementary inclusion. -/
theorem elementary_field_eq_inverse_graph (n : ℕ) (g : ElementaryGroup k n) :
    frobeniusPointAut k n (elementaryInclusion k n g) =
      (Diagram.pinnedAut k).symm (elementaryInclusion k n g) :=
  field_eq_inverse_graph k n g.val

/-- Exact equality with the fixed subgroup used by the representation interface. -/
theorem fixedSubgroup_eq_orientation (n : ℕ) :
    fixedSubgroup k n = SteinbergTensors.graphFieldFixedSubgroup
      (Diagram.pinnedAut k) (regularFrobeniusLift k 1).onPoints n := by
  unfold fixedSubgroup FixedElementary.fixedSubgroup SteinbergTensors.graphFieldFixedSubgroup
  rw [sigma_toMonoidHom]
  rfl

/-- The canonical comparison keeps every ambient Spin point unchanged. -/
def orientationFixedEquiv (n : ℕ) :
    FixedGroup k n ≃* SteinbergTensors.graphFieldFixedSubgroup
      (Diagram.pinnedAut k) (regularFrobeniusLift k 1).onPoints n :=
  MulEquiv.subgroupCongr (fixedSubgroup_eq_orientation k n)

@[simp] theorem orientationFixedEquiv_val (n : ℕ) (g : FixedGroup k n) :
    (orientationFixedEquiv k n g : Points k) = g := rfl

/-- The fixed-point identification takes precisely the two-generated subgroups to each other. -/
theorem map_elementarySubgroup_orientation (n : ℕ) :
    (elementarySubgroup k n).map (orientationFixedEquiv k n).toMonoidHom =
      SteinbergTensors.graphFieldElementarySubgroup
        (Diagram.pinnedAut k) (regularFrobeniusLift k 1).onPoints n :=
  FixedElementary.map_powClosure 2 (orientationFixedEquiv k n)

/-- Restriction to the actual elementary groups. -/
def orientationElementaryEquiv (n : ℕ) :
    ElementaryGroup k n ≃* SteinbergTensors.graphFieldElementarySubgroup
      (Diagram.pinnedAut k) (regularFrobeniusLift k 1).onPoints n :=
  ((orientationFixedEquiv k n).subgroupMap (elementarySubgroup k n)).trans
    (MulEquiv.subgroupCongr (map_elementarySubgroup_orientation k n))

/-- The comparison commutes with the exact inclusion used to restrict representations. -/
theorem elementaryInclusion_eq_orientation (n : ℕ) :
    elementaryInclusion k n =
      (SteinbergTensors.elementaryInclusion (Diagram.pinnedAut k)
        (regularFrobeniusLift k 1).onPoints n).comp
          (orientationElementaryEquiv k n).toMonoidHom := by
  ext g
  rfl

/-- The quotient is literally the carrier of `FixedElementaryTransport`. -/
def carrierEquivFixedElementary (n : ℕ) :
    Carrier k n ≃* FixedElementary.Carrier 2 (sigma k n) := MulEquiv.refl _

/-- The orientation comparison descends by the elementary groups' own centers. -/
def orientationCarrierEquiv (n : ℕ) : Carrier k n ≃*
    (SteinbergTensors.graphFieldElementarySubgroup
      (Diagram.pinnedAut k) (regularFrobeniusLift k 1).onPoints n ⧸
      Subgroup.center (SteinbergTensors.graphFieldElementarySubgroup
        (Diagram.pinnedAut k) (regularFrobeniusLift k 1).onPoints n)) :=
  QuotientGroup.congr _ _ (orientationElementaryEquiv k n)
    (FixedElementary.map_center (orientationElementaryEquiv k n))

@[simp] theorem orientationCarrierEquiv_toCarrier (n : ℕ) (g : ElementaryGroup k n) :
    orientationCarrierEquiv k n (toCarrier k n g) =
      QuotientGroup.mk (orientationElementaryEquiv k n g) := rfl

/-- Finiteness in the exact form consumed by the finite-restriction geometry. -/
theorem orientation_fixed_finite (n : ℕ) (hn : 0 < n) :
    Finite (SteinbergTensors.graphFieldFixedSubgroup
      (Diagram.pinnedAut k) (regularFrobeniusLift k 1).onPoints n) := by
  rw [← fixedSubgroup_eq_orientation]
  exact fixed_finite k n hn

end Triality.SimplyConnected.GraphField
