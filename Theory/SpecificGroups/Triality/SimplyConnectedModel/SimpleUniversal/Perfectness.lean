module

public import Theory.SpecificGroups.Triality.SimplyConnectedModel.PinningTorus.PointGeneration
public import Mathlib.GroupTheory.IsPerfect
import Mathlib.Tactic

/-!
# Perfectness of the concrete Spin D4 point group

Choose a coroot parameter whose square is not one. Conjugation by that coroot
expresses each positive simple root element as a commutator, by dividing its
parameter by the nonzero scaling difference. Pinned Weyl conjugation handles
the negative simple roots, and their proved generation gives perfectness.
In particular, the derived subgroup required by algebraic simplicity is
nontrivial. No classification or simplicity theorem is used.

Source: GLS3, 1.10.1(a) and 1.12.1(g,h),
`refs/KGroup/GLS3/Chapter1.tex`.
-/

@[expose] public section
noncomputable section
namespace Triality.SimplyConnected
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem Pinning
open scoped commutatorElement
universe u
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]

/-- Each positive simple root element is a single commutator of Spin points. -/
theorem positiveSimplePoint_is_commutator (i : Fin 4) (a : k) :
    ∃ g h : Points k, positiveSimplePoint k i a = ⁅g, h⁆ := by
  obtain ⟨t, ht⟩ := exists_unit_zpow_ne_one (k := k) (z := 2) (by norm_num)
  have ht' : (t : k) ^ (2 : ℤ) ≠ 1 := by
    intro he
    apply ht
    apply Units.val_injective
    simpa using he
  let b := a / ((t : k) ^ (2 : ℤ) - 1)
  refine ⟨(simpleCoroot k i t)⁻¹, positiveSimplePoint k i b, ?_⟩
  rw [commutatorElement_def, inv_inv,
    simpleCoroot_positiveSimplePoint_conjugation]
  simp only [typeDCartanMatrix, ↓reduceIte]
  change rootPoint k (simpleRoot i) a =
    rootPoint k (simpleRoot i) ((t : k) ^ (2 : ℤ) * b) *
      (rootPoint k (simpleRoot i) b)⁻¹
  rw [← rootPoint_neg, ← rootPoint_add]
  congr 1
  symm
  calc
    (t : k) ^ (2 : ℤ) * b + -b = ((t : k) ^ (2 : ℤ) - 1) * b := by ring
    _ = a := mul_div_cancel₀ a (sub_ne_zero.mpr ht')

/-- Every positive simple root group lies in the abstract derived subgroup. -/
theorem positiveSimplePoint_mem_commutator (i : Fin 4) (a : k) :
    positiveSimplePoint k i a ∈ commutator (Points k) := by
  obtain ⟨g, h, he⟩ := positiveSimplePoint_is_commutator k i a
  rw [he, commutator_def]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top h)

/-- Pinned reflection puts the negative simple root groups in the derived subgroup. -/
theorem negativeSimplePoint_mem_commutator (i : Fin 4) (a : k) :
    negativeSimplePoint k i a ∈ commutator (Points k) := by
  have h := (inferInstance : (commutator (Points k)).Normal).conj_mem
    (positiveSimplePoint k i a) (positiveSimplePoint_mem_commutator k i a)
    (simpleNormalizer k i)⁻¹
  simpa only [inv_inv, simpleNormalizer_rootPoint_conjugation,
    reflection_self_negativeRoot] using h

/-- The concrete Spin point group is generated by its commutators. -/
theorem commutator_eq_top : commutator (Points k) = ⊤ := by
  apply top_unique
  rw [← simplePointSubgroup_eq_top k]
  apply (Subgroup.closure_le _).mpr
  rintro _ (⟨⟨i, a⟩, rfl⟩ | ⟨⟨i, a⟩, rfl⟩)
  · exact positiveSimplePoint_mem_commutator k i a
  · exact negativeSimplePoint_mem_commutator k i a

/-- Perfectness of the actual Clifford Spin point group in characteristic two. -/
instance pointsPerfect : Group.IsPerfect (Points k) :=
  ⟨commutator_eq_top k⟩

/-- The nontrivial-derived-subgroup clause of algebraic simplicity. -/
theorem derived_ne_bot :
    ⁅(⊤ : Subgroup (Points k)), (⊤ : Subgroup (Points k))⁆ ≠ ⊥ := by
  change commutator (Points k) ≠ ⊥
  rw [commutator_eq_top]
  exact top_ne_bot

end Triality.SimplyConnected
