module

public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.Candidates
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.Tangents
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.BorelCertification
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.ProductDensity
public import Theory.AlgebraicGroup.Borel.OppositeBigCell

/-!
# Opposite Borels and the big cell on the concrete Clifford Spin group

The positive and negative subgroups are generated by the actual pinned root
curves on the closed Clifford Spin carrier. Their closedness, connectedness,
relative normality and exact torus/root decompositions are established in
`Candidates`; the positive set has the original twelve-root ordering.
`BorelCertification` proves maximal connected solvability by invariant flags
and triangular saturation, identifies the unipotent radicals, and proves that
the two Borels intersect in exactly the fixed coroot torus. `Tangents` and
`ProductDensity` prove density from the surjective differential of the regular
multiplication map.

Here these results construct `bigCell` for the exact `Pinning.pinnedRootData`
and its published positive system, with no additional geometric premises.
The compatible Borel/root witnesses give both exact pointwise `T * U`
decompositions. Connectedness of Spin makes it irreducible, so the dense
product of the two closed subgroups is also open.

Source: GLS3, Chapter 1, Theorems 1.11.2 and 1.11.4, and Steinberg (6.2) in
`refs/KGroup/GLS3/Chapter2St2.tex`.
-/

public section
noncomputable section

namespace Triality.SimplyConnected.OppositeBorels

open Theory.AlgebraicGroup Pinning
open scoped Pointwise

universe u
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]

/-- The source Borel/root witness for the prescribed twelve positive roots. -/
@[expose]
def positiveBorelWitness :
    IsBorelOfPositiveSystem (pinnedRootData k) (pinnedRootData k).positive
      (positiveCandidate k) where
  unipotent := positiveUnipotent k
  root_generated := rootGenerated_toSubgroup k (positiveRoots k)
  borel := positiveCandidate_isBorel k
  radical := positiveCandidate_unipotentRadical k
  torus_unipotent_generate := torusRootGenerated_toSubgroup k (positiveRoots k)

/-- The source Borel/root witness for the negatives of the same positive roots. -/
@[expose]
def negativeBorelWitness :
    IsBorelOfPositiveSystem (pinnedRootData k)
      ((pinnedRootData k).neg ⁻¹' (pinnedRootData k).positive)
      (negativeCandidate k) where
  unipotent := negativeUnipotent k
  root_generated := rootGenerated_toSubgroup k (negativeRoots k)
  borel := negativeCandidate_isBorel k
  radical := negativeCandidate_unipotentRadical k
  torus_unipotent_generate := torusRootGenerated_toSubgroup k (negativeRoots k)

/-- Compatible positive and opposite Borels on the fixed Clifford carrier. -/
@[expose]
def borelOppositeData :
    RealizedRootBorelOppositeData (CorootTorus.closedSubgroup k)
      (pinnedRootData k) (pinnedRootData k).positive where
  positive := pinnedRootData_positive_isPositiveSystem k
  B := positiveCandidate k
  Bopp := negativeCandidate k
  B_isBorel := positiveCandidate_isBorel k
  Bopp_isBorel := negativeCandidate_isBorel k
  positive_witness := positiveBorelWitness k
  opposite_witness := negativeBorelWitness k

/-- The opposite-Borel big cell for the actual Spin torus and numbered D4
root data. All Borel, radical, intersection and density obligations are proved. -/
@[expose]
def bigCell :
    OppositeBorelBigCell (CorootTorus.closedSubgroup k)
      (pinnedRootData k) (pinnedRootData k).positive where
  data := borelOppositeData k
  intersection_eq_torus := candidate_intersection_eq_torus k
  product_dense := candidates_product_dense k

/-- The positive Borel is exactly the fixed torus times its positive-root group. -/
theorem positive_decomposition (x : Points k) :
    x ∈ (bigCell k).data.B ↔ ∃ t u,
      t ∈ CorootTorus.closedSubgroup k ∧
      u ∈ RootSubgroupGenerated (pinnedRootData k) (pinnedRootData k).positive ∧
      x = t * u :=
  (bigCell k).positive_decomposition x

/-- The opposite Borel has the corresponding negative-root decomposition. -/
theorem negative_decomposition (x : Points k) :
    x ∈ (bigCell k).data.Bopp ↔ ∃ t u,
      t ∈ CorootTorus.closedSubgroup k ∧
      u ∈ RootSubgroupGenerated (pinnedRootData k)
        ((pinnedRootData k).neg ⁻¹' (pinnedRootData k).positive) ∧
      x = t * u :=
  (bigCell k).negative_decomposition x

/-- The dense opposite-Borel product is an open subset of the actual Spin group. -/
theorem candidates_product_open :
    IsOpen (((positiveCandidate k).toSubgroup : Set (Points k)) *
      ((negativeCandidate k).toSubgroup : Set (Points k))) := by
  let : PreirreducibleSpace (Points k) :=
    ⟨(connectedAlgebraicGroup_irreducible (groupVariety k)
      (SimplyConnected.isConnected k)).2⟩
  exact (bigCell k).product_open

end Triality.SimplyConnected.OppositeBorels
