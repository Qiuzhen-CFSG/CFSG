module
public import Theory.AlgebraicGroup.RootSystems.EvenOrthogonalElementaryGeneration
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.PinningTorus.RootPoints
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.PinningTorus.CorootPoints
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.PinningTorus.PointGeneration.Weyl

/-!
# Generation of the pinned Spin D4 points

The Weyl identities show, by reflection induction on the actual D4 base, that
the positive and negative simple root groups generate every root group. The
faithful natural action then transfers concrete elementary generation of the
orthogonal commutator group to generation of all Spin points. The orthogonal
proof uses coordinate elimination and even factorization into anisotropic
symmetries; no abstract semisimple root-generation theorem is used.

The imported `Weyl` module proves the pinned root, coroot, and normalizer-word
conjugation equations. Source: GLS3, §§1.10–1.12, especially 1.12.1(h–j).
-/

@[expose] public section
noncomputable section
namespace Triality.SimplyConnected.Pinning
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
universe u
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]

/-- The subgroup generated by the eight signed simple root groups. -/
def simplePointSubgroup : Subgroup (Points k) :=
  Subgroup.closure
    (Set.range (fun p : Fin 4 × k => positiveSimplePoint k p.1 p.2) ∪
      Set.range (fun p : Fin 4 × k => negativeSimplePoint k p.1 p.2))

/-- The subgroup generated by all twenty-four root groups. -/
def allRootPointSubgroup : Subgroup (Points k) :=
  Subgroup.closure (Set.range fun p : RootIndex × k => rootPoint k p.1 p.2)

theorem positiveSimplePoint_mem (i : Fin 4) (a : k) :
    positiveSimplePoint k i a ∈ simplePointSubgroup k :=
  Subgroup.subset_closure (Or.inl ⟨(i, a), rfl⟩)

theorem negativeSimplePoint_mem (i : Fin 4) (a : k) :
    negativeSimplePoint k i a ∈ simplePointSubgroup k :=
  Subgroup.subset_closure (Or.inr ⟨(i, a), rfl⟩)

theorem simpleNormalizer_mem (i : Fin 4) :
    simpleNormalizer k i ∈ simplePointSubgroup k := by
  exact (simplePointSubgroup k).mul_mem
    ((simplePointSubgroup k).mul_mem (positiveSimplePoint_mem k i _)
      (negativeSimplePoint_mem k i _)) (positiveSimplePoint_mem k i _)

theorem rootPoint_mem_simplePointSubgroup (r : RootIndex) (a : k) :
    rootPoint k r a ∈ simplePointSubgroup k := by
  have h : (∀ a, rootPoint k r a ∈ simplePointSubgroup k) ∧
      (∀ a, rootPoint k (negativeRoot r) a ∈ simplePointSubgroup k) := by
    apply (typeDRootPairing_base 2).induction_reflect r
    · intro s hs
      simpa only [reflection_self_negativeRoot, negativeRoot_negativeRoot] using hs.symm
    · intro s hs
      obtain ⟨i, hi⟩ := (typeDRootPairing_baseEquiv 2).surjective ⟨s, hs⟩
      have his : simpleRoot i = s := congrArg Subtype.val hi
      rw [← his]
      exact ⟨positiveSimplePoint_mem k i, negativeSimplePoint_mem k i⟩
    · intro s j hs hj
      obtain ⟨i, hi⟩ := (typeDRootPairing_baseEquiv 2).surjective ⟨j, hj⟩
      have hij : simpleRoot i = j := congrArg Subtype.val hi
      rw [← hij]
      have hconj (s : RootIndex) (a : k) (ha : rootPoint k s a ∈ simplePointSubgroup k) :
          rootPoint k ((typeDRootPairing 2).reflectionPerm (simpleRoot i) s) a ∈
            simplePointSubgroup k := by
        rw [← simpleNormalizer_rootPoint_conjugation]
        exact (simplePointSubgroup k).mul_mem
          ((simplePointSubgroup k).mul_mem
            ((simplePointSubgroup k).inv_mem (simpleNormalizer_mem k i)) ha)
          (simpleNormalizer_mem k i)
      refine ⟨fun a => hconj s a (hs.1 a), fun a => ?_⟩
      rw [← reflection_negativeRoot]
      exact hconj (negativeRoot s) a (hs.2 a)
  exact h.1 a

/-- Weyl conjugation reduces all-root generation to the signed simple groups. -/
theorem allRootPointSubgroup_eq_simplePointSubgroup :
    allRootPointSubgroup k = simplePointSubgroup k := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨r, a⟩, rfl⟩
    exact rootPoint_mem_simplePointSubgroup k r a
  · apply (Subgroup.closure_le _).mpr
    rintro _ (⟨⟨i, a⟩, rfl⟩ | ⟨⟨i, a⟩, rfl⟩)
    · exact Subgroup.subset_closure ⟨(simpleRoot i, a), rfl⟩
    · exact Subgroup.subset_closure ⟨(negativeSimpleRoot i, a), rfl⟩

/-- Transport of a concrete orthogonal generation theorem through the faithful
natural action. The orthogonal premise is discharged separately. -/
theorem simplePointSubgroup_eq_top_of_orthogonal_generation
    (hgen : Subgroup.closure (Set.range fun p : RootIndex × k =>
        evenOrthogonalRootQuadraticPoint 4 p.1 p.2) =
      commutator (quadraticIsometrySubgroup (quadraticForm k))) :
    simplePointSubgroup k = ⊤ := by
  apply top_unique
  intro g _
  have hle : Subgroup.closure (Set.range fun p : RootIndex × k =>
      evenOrthogonalRootQuadraticPoint 4 p.1 p.2) ≤
        (simplePointSubgroup k).map (naturalAction k) := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨r, a⟩, rfl⟩
    exact ⟨rootPoint k r a, rootPoint_mem_simplePointSubgroup k r a,
      naturalAction_rootPoint k r a⟩
  have hg : naturalAction k g ∈ Subgroup.closure (Set.range fun p : RootIndex × k =>
      evenOrthogonalRootQuadraticPoint 4 p.1 p.2) := by
    rw [hgen]
    exact (toOmega k g).property
  obtain ⟨x, hx, he⟩ := hle hg
  exact (naturalAction_injective k he) ▸ hx

/-- The eight signed simple root groups generate the concrete Spin point group
over every algebraically closed field of characteristic two. -/
theorem simplePointSubgroup_eq_top : simplePointSubgroup k = ⊤ :=
  simplePointSubgroup_eq_top_of_orthogonal_generation k
    (evenOrthogonalRoot_closure_eq_commutator (k := k))

/-- All twenty-four root groups generate the same concrete Spin point group. -/
theorem allRootPointSubgroup_eq_top : allRootPointSubgroup k = ⊤ := by
  rw [allRootPointSubgroup_eq_simplePointSubgroup, simplePointSubgroup_eq_top]

end Triality.SimplyConnected.Pinning
