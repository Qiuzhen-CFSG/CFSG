module

public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.Candidates
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.BorelCertification.Triangular
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.BorelCertification.SolvableFlags
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.BorelCertification.TriangularSaturation
public import Theory.AlgebraicGroup.Borel.Defs
public import Theory.AlgebraicGroup.Unipotent.Radical

/-!
# Borel subgroups, unipotent radicals and opposite separation in Spin

The matrix calculations prove solvability and unipotence for the actual
closed Clifford subgroups. Lie–Kolchin and the classification of their two
invariant flags force every connected solvable overgroup to be triangular.
Triangular saturation then puts every point of that overgroup in the candidate,
proving Borel maximality for the prescribed positive and negative roots.

In either connected solvable candidate, an existing
unipotent radical contains the root-generated subgroup. The exact `T * U`
factorization and the trivial intersection of a torus with a unipotent subgroup
force equality. Thus radical maximality is established without assuming Borel
maximality. Opposite separation also gives the exact torus intersection.

Source: GLS3, Theorems 1.11.2 and 1.11.4
(`refs/KGroup/GLS3/Chapter1.tex`), and Steinberg (6.2)(a-b)
(`refs/KGroup/GLS3/Chapter2St2.tex`).
-/

@[expose] public section
noncomputable section
namespace Triality.SimplyConnected.OppositeBorels
open Theory.AlgebraicGroup Pinning
universe u
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]
local instance (S : ClosedSubgroup (groupVariety k)) : AlgebraicGroup S.carrierVariety :=
  S.carrierAlgebraicGroup

namespace BorelCertification
/-- Each concrete signed candidate is maximal among connected solvable closed
subgroups: flag rigidity makes an overgroup triangular, and triangular
saturation places all of its points back in the candidate. -/
theorem candidate_isBorel (negative : Bool) :
    IsBorelSubgroup (candidate k negative) := by
  refine ⟨torusRootGenerated_connected k (signedRoots k negative),
    candidate_solvable k negative, ?_⟩
  intro S hc hs hBS
  apply SetLike.coe_injective
  apply Set.Subset.antisymm ?_ hBS
  intro g hg
  exact triangular_mem_candidate k negative g
    (connected_solvable_overgroup_triangular k negative S hc hs hBS g hg)

/-- The published root-generated subgroup is exactly the candidate's
unipotent radical. No Borel maximality premise is used. -/
lemma candidate_radical (negative : Bool) :
    IsUnipotentRadicalOf (candidate k negative) (unipotent k negative) := by
  have hc := torusRootGenerated_connected k (signedRoots k negative)
  have hs := candidate_solvable k negative
  obtain ⟨W, hW, _⟩ :=
    exists_unipotentRadical_of_connected_solvable (candidate k negative) hc hs
  have hUW : unipotent k negative ≤ W :=
    hW.contains_unipotent_closedSubgroup hc hs
      (rootGenerated_le_torusRootGenerated k (signedRoots k negative))
      (unipotent_isUnipotent k negative)
  have hWU : W ≤ unipotent k negative := by
    intro x hx
    obtain ⟨t, v, ht, hv, htv⟩ :=
      (mem_torusRootGenerated_iff k (signedRoots k negative) x).mp (hW.1 hx)
    have htW : t ∈ W.toSubgroup := by
      have h := W.toSubgroup.mul_mem hx (W.toSubgroup.inv_mem (hUW hv))
      simpa only [htv, mul_inv_cancel_right] using h
    have ht1 : t = 1 := by
      apply Subgroup.mem_bot.mp
      rw [← subtorus_inf_unipotent_eq_bot (CorootTorus.closedSubgroup k) W
        (CorootTorus.isSubtorus k) hW.2.1]
      exact ⟨ht, htW⟩
    rw [htv, ht1, one_mul]
    exact hv
  have hWUeq : W = unipotent k negative :=
    SetLike.coe_injective (Set.Subset.antisymm hWU hUW)
  rwa [hWUeq] at hW
end BorelCertification

/-- The Borel subgroup determined by the original prescribed positive roots. -/
theorem positiveCandidate_isBorel : IsBorelSubgroup (positiveCandidate k) :=
  BorelCertification.candidate_isBorel k false

/-- The opposite Borel subgroup determined by the genuine negative roots. -/
theorem negativeCandidate_isBorel : IsBorelSubgroup (negativeCandidate k) :=
  BorelCertification.candidate_isBorel k true

/-- Solvability of the concrete positive torus-and-root subgroup. -/
theorem positiveCandidate_isSolvable :
    Group.IsSolvable (Variety.Point (positiveCandidate k).carrierVariety) :=
  BorelCertification.candidate_solvable k false

/-- Solvability of the concrete negative torus-and-root subgroup. -/
theorem negativeCandidate_isSolvable :
    Group.IsSolvable (Variety.Point (negativeCandidate k).carrierVariety) :=
  BorelCertification.candidate_solvable k true

/-- Unipotence of the subgroup generated by the prescribed positive roots. -/
theorem positiveUnipotent_isUnipotent :
    IsUnipotentAlgebraicGroup (positiveUnipotent k).carrierVariety :=
  BorelCertification.unipotent_isUnipotent k false

/-- Unipotence of the subgroup generated by the prescribed negative roots. -/
theorem negativeUnipotent_isUnipotent :
    IsUnipotentAlgebraicGroup (negativeUnipotent k).carrierVariety :=
  BorelCertification.unipotent_isUnipotent k true

/-- The actual unipotent radical of the positive candidate, including maximality. -/
theorem positiveCandidate_unipotentRadical :
    IsUnipotentRadicalOf (positiveCandidate k) (positiveUnipotent k) :=
  BorelCertification.candidate_radical k false

/-- The actual unipotent radical of the negative candidate, including maximality. -/
theorem negativeCandidate_unipotentRadical :
    IsUnipotentRadicalOf (negativeCandidate k) (negativeUnipotent k) :=
  BorelCertification.candidate_radical k true

/-- Upper unitriangular and lower triangular Spin points intersect trivially. -/
theorem positiveUnipotent_disjoint_negativeCandidate :
    Disjoint (positiveUnipotent k).toSubgroup (negativeCandidate k).toSubgroup :=
  BorelCertification.opposite_disjoint k

/-- The two published candidates intersect in exactly the fixed coroot torus. -/
theorem candidate_intersection_eq_torus :
    (positiveCandidate k).toSubgroup ⊓ (negativeCandidate k).toSubgroup =
      (CorootTorus.closedSubgroup k).toSubgroup :=
  intersection_eq_torus_of_disjoint k (positiveUnipotent_disjoint_negativeCandidate k)

end Triality.SimplyConnected.OppositeBorels
