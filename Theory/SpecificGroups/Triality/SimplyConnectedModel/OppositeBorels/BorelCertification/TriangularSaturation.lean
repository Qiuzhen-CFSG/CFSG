module
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.BorelCertification.Triangular
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.BorelCertification.TriangularSaturation.Elimination
public import Theory.SpecificGroups.Triality.SimplyConnectedModel.OppositeBorels.BorelCertification.TriangularSaturation.Shears

/-!
# Triangular saturation of the concrete signed Spin candidates

A triangular point of the closed Clifford Spin group belongs to the subgroup
generated by the fixed coroot torus and the roots of the chosen sign. First,
actual coroot products normalize the four diagonal pivots. Six difference-root
operations clear the first diagonal block. Preservation of the quadratic form
then identifies the remaining matrix as an alternating shear, which is a product
of six sum roots. Faithfulness of the natural action gives equality on Spin
points. Exchanging the hyperbolic halves treats the genuine negative roots by
the same argument.

Together with `candidate_triangular`, this gives the exact membership
criterion for both published candidates. Borel maximality is a separate
conclusion owned by the parent certification; no Borel or Bruhat theorem,
or regular inverse to the Spin cover, enters this proof.

Source: the concrete type-D calculation underlying GLS3 Theorem 1.11.2 and
Steinberg (6.2)(a-b), `refs/KGroup/GLS3/Chapter1.tex` and `Chapter2St2.tex`.
-/

open Theory Theory.AlgebraicGroup
open Triality.SimplyConnected Triality.SimplyConnected.Pinning
open Triality.SimplyConnected.Pinning.NaturalCoefficients
open Triality.Standard.PositiveCoordinates
open scoped BigOperators
@[expose] public section
noncomputable section
namespace Triality.SimplyConnected.OppositeBorels.BorelCertification
set_option linter.unusedSimpArgs false
universe u
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]
namespace Saturation

private lemma parameter_matrix (negative : Bool) (c : Fin 4 → kˣ) :
    blockMatrix k negative (CorootTorus.parameter k c) =
      Matrix.diagonal (fun q => (diagonalEntry k (CorootTorus.diagonal k c) (swapOrder negative q) : k)) := by
  ext p q
  change pointMatrix k (CorootTorus.parameter k c) (swapOrder negative p) (swapOrder negative q) = _
  rw [pointMatrix_apply, CorootTorus.naturalAction_parameter, diagonal_basis]
  by_cases h : p = q
  · subst q
    simp [Module.Basis.coord_apply]
  · have hs := (swapOrder negative).injective.ne h
    simp [Module.Basis.coord_apply, h, hs, Ne.symm hs, Matrix.diagonal_apply]

/-- Ordinary diagonal coordinates are realized by actual Spin coroot products,
with inversion of all four coordinates for the negative ordered basis. -/
private lemma exists_torus_matrix (negative : Bool) (d : Fin 4 → kˣ) :
    ∃ t : Points k, t ∈ CorootTorus.closedSubgroup k ∧
      blockMatrix k negative t = Matrix.diagonal (fun q => (diagonalEntry k d q : k)) := by
  let d' : Fin 4 → kˣ := if negative then d⁻¹ else d
  obtain ⟨c, hc⟩ := CorootTorus.diagonal_surjective k d'
  refine ⟨CorootTorus.parameter k c, CorootTorus.parameter_mem k c, ?_⟩
  rw [parameter_matrix, hc]
  congr 1
  funext q
  cases negative <;> cases q <;> simp [d', swapOrder, diagonalEntry]

/-- A triangular Spin point can be multiplied by the fixed coroot torus so
that the first diagonal block has diagonal one. -/
private lemma normalize_diagonal (negative : Bool) (g : Points k)
    (hg : tTriangular 8 (matrix k negative g)) :
    ∃ t : Points k, t ∈ CorootTorus.closedSubgroup k ∧
      tTriangular 8 (matrix k negative (t * g)) ∧
      ∀ i : Fin 4, blockMatrix k negative (t * g) (.inl i) (.inl i) = 1 := by
  let d : Fin 4 → kˣ := fun i =>
    (Units.mk0 (blockMatrix k negative g (.inl i) (.inl i))
      (diagonal_ne_zero k negative g hg (.inl i)))⁻¹
  obtain ⟨t, ht, htm⟩ := exists_torus_matrix k negative d
  refine ⟨t, ht, ?_, ?_⟩
  · rw [map_mul]
    exact tTriangular_mul 8
      (candidate_triangular k negative t (torus_le_torusRootGenerated k _ ht)) hg
  · intro i
    rw [map_mul, htm, Matrix.diagonal_mul]
    simp [diagonalEntry, d, diagonal_ne_zero k negative g hg (.inl i)]

private lemma normalized_mem_unipotent (negative : Bool) (g : Points k)
    (hg : tTriangular 8 (matrix k negative g))
    (hdiag : ∀ i : Fin 4, blockMatrix k negative g (.inl i) (.inl i) = 1) :
    g ∈ unipotent k negative := by
  obtain ⟨x, hx, hA⟩ := first_block_elimination k negative g
    (triangular_blocks k negative g hg).1 hdiag
  have htri : tTriangular 8 (matrix k negative (x * g)) := by
    rw [map_mul]
    exact tTriangular_mul 8 (unipotent_unitriangular k negative x hx).1 hg
  have hxg := residual_mem k negative (x * g) hA
    (triangular_blocks k negative (x * g) htri).2
  have h := (unipotent k negative).toSubgroup.mul_mem
    ((unipotent k negative).toSubgroup.inv_mem hx) hxg
  rw [inv_mul_cancel_left] at h
  exact h

end Saturation

/-- Every triangular point of the actual Clifford Spin group belongs to the
fixed torus-and-same-sign-root candidate. -/
theorem triangular_mem_candidate (negative : Bool) (g : Points k)
    (hg : tTriangular 8 (matrix k negative g)) :
    g ∈ candidate k negative := by
  obtain ⟨t, ht, htri, hdiag⟩ := Saturation.normalize_diagonal k negative g hg
  have hU := Saturation.normalized_mem_unipotent k negative (t * g) htri hdiag
  have htC : t ∈ candidate k negative := torus_le_torusRootGenerated k _ ht
  have hC : t * g ∈ candidate k negative := rootGenerated_le_torusRootGenerated k _ hU
  have h := (candidate k negative).toSubgroup.mul_mem
    ((candidate k negative).toSubgroup.inv_mem htC) hC
  rw [inv_mul_cancel_left] at h
  exact h

/-- The prescribed positive or negative candidate is exactly the corresponding
triangular subgroup on Spin points. This is a pointwise equality, with no
regular inverse to the Spin cover asserted or used. -/
theorem mem_candidate_iff_triangular (negative : Bool) (g : Points k) :
    g ∈ candidate k negative ↔ tTriangular 8 (matrix k negative g) :=
  ⟨candidate_triangular k negative g, triangular_mem_candidate k negative g⟩

end Triality.SimplyConnected.OppositeBorels.BorelCertification
