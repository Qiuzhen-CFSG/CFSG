module

public import Theory.SpecificGroups.Triality.SimplyConnectedModel.PinningTorus
public import Theory.AlgebraicGroup.RootSubgroups.FixedTorusConnectedGeneration
public import Theory.AlgebraicGroup.RootSubgroups.TorusGeneratedNormalizer
public import Theory.SpecificGroups.Triality.PositiveRootCoordinates.Roots

/-!
# Closed connected subgroups attached to the pinned Spin roots

For a set of the actual pinned roots, construct its generated subgroup as a
closed connected subgroup of the Clifford Spin carrier. Adjoining the fixed
coroot torus preserves closedness and connectedness. Torus normalization gives
the exact pointwise `T * U` decomposition, without assuming that the result is
a Borel or that the root-generated subgroup is its unipotent radical.

The two canonical candidates use precisely the positive system of
`Pinning.pinnedRootData` and its negative. Borel maximality, unipotent-radical
identification, torus intersection and big-cell density are separate results.

The proof uses finite-word generation by connected closed algebraic subgroups;
it does not transport algebraic structure through the Spin-to-Omega point
bijection. Source: GLS3, Chapter 1, Theorem 1.11.2, and Steinberg (6.2) in
`refs/KGroup/GLS3/Chapter2St2.tex`.
-/

@[expose] public section
noncomputable section
namespace Triality.SimplyConnected.OppositeBorels
open Theory.AlgebraicGroup Pinning
open scoped Pointwise
universe u
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]

private theorem root_connected (r : (pinnedRootData k).Root) :
    _root_.IsConnected ((pinnedRootData k).rootSubgroup r : Set (Points k)) := by
  let X := (pinnedRootData k).rootSubgroup r
  let : ConnectedSpace (Variety.Point X.carrierVariety) :=
    connectedSpace_iff_univ.mpr
      ((pinnedRootData_isRealization k).2.2.1 r).1.2.isConnected
  change _root_.IsConnected (X.toSubgroup : Set (Points k))
  rw [← X.range_inclusion]
  exact isConnected_range X.inclusion.toVariety.continuous

/-- Connectedness of the actual coroot torus as an ambient subset. -/
theorem torus_connected :
    _root_.IsConnected (CorootTorus.closedSubgroup k : Set (Points k)) := by
  let T := CorootTorus.closedSubgroup k
  let : ConnectedSpace (Variety.Point T.carrierVariety) :=
    connectedSpace_iff_univ.mpr (CorootTorus.isSubtorus k).isConnected
  change _root_.IsConnected (T.toSubgroup : Set (Points k))
  rw [← T.range_inclusion]
  exact isConnected_range T.inclusion.toVariety.continuous

private theorem root_union (A : Set (pinnedRootData k).Root) :
    (⋃ a : A, ((pinnedRootData k).rootSubgroup a.1 : Set (Points k))) =
      ⋃ a ∈ A, ((pinnedRootData k).rootSubgroup a : Set (Points k)) := by
  ext x
  simp

/-- Root-generated subgroups of the concrete Spin carrier are Zariski closed. -/
theorem rootGenerated_isZariskiClosed (A : Set (pinnedRootData k).Root) :
    IsZariskiClosed (groupVariety k)
      (RootSubgroupGenerated (pinnedRootData k) A : Set (Points k)) := by
  have h := closure_iUnion_connected_closedSubgroup_isZariskiClosed
    (fun a : A => (pinnedRootData k).rootSubgroup a.1)
    (fun a => root_connected k a.1)
  rw [root_union] at h
  exact h

/-- The actual closed subgroup generated by a selected set of pinned roots. -/
def rootGenerated (A : Set (pinnedRootData k).Root) : ClosedSubgroup (groupVariety k) :=
  ClosedSubgroup.ofSubgroup (RootSubgroupGenerated (pinnedRootData k) A)
    (rootGenerated_isZariskiClosed k A)

@[simp] theorem rootGenerated_toSubgroup (A : Set (pinnedRootData k).Root) :
    (rootGenerated k A).toSubgroup = RootSubgroupGenerated (pinnedRootData k) A := rfl

/-- These subgroups are connected because every generating root group is. -/
theorem rootGenerated_connected (A : Set (pinnedRootData k).Root) :
    _root_.IsConnected (rootGenerated k A : Set (Points k)) := by
  have h := closure_iUnion_connected_closedSubgroup_isConnected
    (fun a : A => (pinnedRootData k).rootSubgroup a.1)
    (fun a => root_connected k a.1)
  rw [root_union] at h
  exact h

private def torusRootFamily (A : Set (pinnedRootData k).Root) :
    Option A → ClosedSubgroup (groupVariety k)
  | none => CorootTorus.closedSubgroup k
  | some a => (pinnedRootData k).rootSubgroup a.1

private theorem torusRootFamily_connected (A : Set (pinnedRootData k).Root)
    (a : Option A) :
    _root_.IsConnected (torusRootFamily k A a : Set (Points k)) := by
  cases a with
  | none => exact torus_connected k
  | some a => exact root_connected k a.1

private theorem torusRootFamily_generated (A : Set (pinnedRootData k).Root) :
    Subgroup.closure (⋃ a, (torusRootFamily k A a : Set (Points k))) =
      (CorootTorus.closedSubgroup k).toSubgroup ⊔
        RootSubgroupGenerated (pinnedRootData k) A := by
  have hu : (⋃ a, (torusRootFamily k A a : Set (Points k))) =
      (CorootTorus.closedSubgroup k : Set (Points k)) ∪
        ⋃ a ∈ A, ((pinnedRootData k).rootSubgroup a : Set (Points k)) := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_union]
    constructor
    · rintro ⟨a, ha⟩
      cases a with
      | none => exact Or.inl ha
      | some a => exact Or.inr ⟨a.1, a.2, ha⟩
    · rintro (hx | ⟨a, ha, hx⟩)
      · exact ⟨none, hx⟩
      · exact ⟨some ⟨a, ha⟩, hx⟩
  rw [hu, Subgroup.closure_union]
  rw [show Subgroup.closure (CorootTorus.closedSubgroup k : Set (Points k)) =
    (CorootTorus.closedSubgroup k).toSubgroup from Subgroup.closure_eq _]
  rfl

/-- Adjoining the fixed coroot torus gives a Zariski-closed subgroup. -/
theorem torusRootGenerated_isZariskiClosed (A : Set (pinnedRootData k).Root) :
    IsZariskiClosed (groupVariety k)
      (((CorootTorus.closedSubgroup k).toSubgroup ⊔
        RootSubgroupGenerated (pinnedRootData k) A : Subgroup (Points k)) :
          Set (Points k)) := by
  rw [← torusRootFamily_generated]
  exact closure_iUnion_connected_closedSubgroup_isZariskiClosed
    (torusRootFamily k A) (torusRootFamily_connected k A)

/-- The closed subgroup generated by the coroot torus and the selected roots. -/
def torusRootGenerated (A : Set (pinnedRootData k).Root) : ClosedSubgroup (groupVariety k) :=
  ClosedSubgroup.ofSubgroup
    ((CorootTorus.closedSubgroup k).toSubgroup ⊔ RootSubgroupGenerated (pinnedRootData k) A)
    (torusRootGenerated_isZariskiClosed k A)

@[simp] theorem torusRootGenerated_toSubgroup (A : Set (pinnedRootData k).Root) :
    (torusRootGenerated k A).toSubgroup =
      (CorootTorus.closedSubgroup k).toSubgroup ⊔ (rootGenerated k A).toSubgroup := rfl

/-- The torus-and-root subgroup is connected. -/
theorem torusRootGenerated_connected (A : Set (pinnedRootData k).Root) :
    _root_.IsConnected (torusRootGenerated k A : Set (Points k)) :=
  isConnected_sup_rootSubgroupGenerated (CorootTorus.closedSubgroup k)
    (torus_connected k) (pinnedRootData k) (pinnedRootData_isRealization k) A

/-- The fixed coroot torus normalizes each root-generated subgroup. -/
theorem torus_normalizes_rootGenerated (A : Set (pinnedRootData k).Root) :
    (CorootTorus.closedSubgroup k).toSubgroup ≤
      Subgroup.normalizer ((rootGenerated k A).toSubgroup : Set (Points k)) :=
  torus_le_rootSubgroupGenerated_normalizer (pinnedRootData k)
    (pinnedRootData_isRealization k) A

/-- Equality with the pointwise product, without any Borel hypothesis. -/
theorem torusRootGenerated_eq_mul (A : Set (pinnedRootData k).Root) :
    (torusRootGenerated k A : Set (Points k)) =
      (CorootTorus.closedSubgroup k : Set (Points k)) *
        (rootGenerated k A : Set (Points k)) :=
  Subgroup.coe_mul_of_left_le_normalizer_right _ _ (torus_normalizes_rootGenerated k A)

/-- The source `T * U` decomposition on the actual closed Spin subgroup. -/
theorem mem_torusRootGenerated_iff (A : Set (pinnedRootData k).Root) (x : Points k) :
    x ∈ torusRootGenerated k A ↔ ∃ t u,
      t ∈ CorootTorus.closedSubgroup k ∧
      u ∈ RootSubgroupGenerated (pinnedRootData k) A ∧ x = t * u := by
  change x ∈ (torusRootGenerated k A : Set (Points k)) ↔ _
  rw [torusRootGenerated_eq_mul]
  constructor
  · rintro ⟨t, ht, u, hu, htu⟩
    exact ⟨t, u, ht, hu, htu.symm⟩
  · rintro ⟨t, u, ht, hu, rfl⟩
    exact Set.mul_mem_mul ht hu

/-- The positive system remains exactly the published numbered D4 system. -/
abbrev positiveRoots : Set (pinnedRootData k).Root := (pinnedRootData k).positive

/-- The corresponding opposite root set. -/
abbrev negativeRoots : Set (pinnedRootData k).Root :=
  (pinnedRootData k).neg ⁻¹' positiveRoots k

/-- The concrete closed subgroup generated by the twelve positive roots. -/
abbrev positiveUnipotent : ClosedSubgroup (groupVariety k) :=
  rootGenerated k (positiveRoots k)

/-- The concrete closed subgroup generated by the twelve negative roots. -/
abbrev negativeUnipotent : ClosedSubgroup (groupVariety k) :=
  rootGenerated k (negativeRoots k)

/-- The closed connected positive Borel candidate `T U+`. -/
abbrev positiveCandidate : ClosedSubgroup (groupVariety k) :=
  torusRootGenerated k (positiveRoots k)

/-- The closed connected opposite Borel candidate `T U-`. -/
abbrev negativeCandidate : ClosedSubgroup (groupVariety k) :=
  torusRootGenerated k (negativeRoots k)

/-- Both signs exhaust the roots of the same pinning. -/
theorem positive_union_negative :
    positiveRoots k ∪ negativeRoots k = Set.univ :=
  (pinnedRootData_positive_isPositiveSystem k).2.1

/-- A root cannot have both signs. -/
theorem positive_inter_negative :
    positiveRoots k ∩ negativeRoots k = ∅ :=
  (pinnedRootData_positive_isPositiveSystem k).1

/-- The canonical twelve-root ordering transported to the pinned root datum. -/
def positiveRoot (i : Fin 12) : (pinnedRootData k).Root :=
  pinnedRootIndex k (Triality.Standard.PositiveCoordinates.rootIndex i)

/-- The list of twelve positive roots has exactly the prescribed support. -/
theorem range_positiveRoot : Set.range (positiveRoot k) = positiveRoots k := by
  ext r
  constructor
  · rintro ⟨i, rfl⟩
    exact Triality.Standard.PositiveCoordinates.rootIndex_positive i
  · intro hr
    change r.down ∈ {s | (Theory.AlgebraicGroup.StandardRootSystem.typeDRootPairing_base 2).IsPos s} at hr
    rw [← Triality.Standard.PositiveCoordinates.range_rootIndex] at hr
    obtain ⟨i, hi⟩ := hr
    exact ⟨i, ULift.ext _ _ hi⟩

/-- No positive root appears twice in the twelve-root ordering. -/
theorem positiveRoot_injective : Function.Injective (positiveRoot k) := by
  intro i j h
  exact Triality.Standard.PositiveCoordinates.rootIndex_injective (congrArg ULift.down h)

/-- Every pinned root point lies in the subgroup generated by its selected root. -/
theorem rootPoint_mem_rootGenerated (A : Set (pinnedRootData k).Root)
    (r : RootIndex) (hr : pinnedRootIndex k r ∈ A) (a : k) :
    rootPoint k r a ∈ rootGenerated k A := by
  apply rootSubgroup_le_RootSubgroupGenerated (pinnedRootData k) hr
  exact (mem_rootClosedSubgroup_iff k r _).mpr ⟨a, rfl⟩

/-- Both candidates contain the fixed torus, before any maximality argument. -/
theorem torus_le_torusRootGenerated (A : Set (pinnedRootData k).Root) :
    CorootTorus.closedSubgroup k ≤ torusRootGenerated k A :=
  (show (CorootTorus.closedSubgroup k).toSubgroup ≤
    (torusRootGenerated k A).toSubgroup from le_sup_left)

/-- The selected root subgroup lies in the torus-and-root candidate. -/
theorem rootGenerated_le_torusRootGenerated (A : Set (pinnedRootData k).Root) :
    rootGenerated k A ≤ torusRootGenerated k A :=
  (show (rootGenerated k A).toSubgroup ≤
    (torusRootGenerated k A).toSubgroup from le_sup_right)

/-- Normality is relative to the candidate, not ambient Spin normality. -/
theorem rootGenerated_normal_in_torusRootGenerated (A : Set (pinnedRootData k).Root) :
    ((rootGenerated k A).toSubgroup.subgroupOf
      (torusRootGenerated k A).toSubgroup).Normal := by
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer le_sup_right).mpr
  exact sup_le (torus_normalizes_rootGenerated k A) Subgroup.le_normalizer

/-- The actual twelve-root set, with its canonical ordering. -/
def positiveRootEquiv : Fin 12 ≃ positiveRoots k := by
  let f : Fin 12 → positiveRoots k := fun i => ⟨positiveRoot k i, by
    rw [← range_positiveRoot]
    exact Set.mem_range_self i⟩
  apply Equiv.ofBijective f
  constructor
  · intro i j h
    exact positiveRoot_injective k (congrArg Subtype.val h)
  · intro r
    have hr : r.1 ∈ Set.range (positiveRoot k) := by
      simpa only [range_positiveRoot] using r.2
    obtain ⟨i, hi⟩ := hr
    exact ⟨i, Subtype.ext hi⟩

/-- There are exactly twelve positive pinned roots. -/
theorem positiveRoots_card : Nat.card (positiveRoots k) = 12 := by
  rw [← Nat.card_congr (positiveRootEquiv k)]
  exact Nat.card_fin 12

/-- All pinned root groups generate the full concrete Spin point group. -/
theorem rootGenerated_univ_eq_top : (rootGenerated k Set.univ).toSubgroup = ⊤ := by
  apply top_unique
  rw [← allRootPointSubgroup_eq_top k]
  rw [allRootPointSubgroup, Subgroup.closure_le]
  rintro x ⟨⟨r, a⟩, rfl⟩
  exact rootPoint_mem_rootGenerated k Set.univ r (Set.mem_univ _) a

/-- The positive and negative root groups together generate all Spin points.
This is a generation statement, not big-cell density. -/
theorem positiveUnipotent_sup_negativeUnipotent :
    (positiveUnipotent k).toSubgroup ⊔ (negativeUnipotent k).toSubgroup = ⊤ := by
  change RootSubgroupGenerated (pinnedRootData k) (positiveRoots k) ⊔
    RootSubgroupGenerated (pinnedRootData k) (negativeRoots k) = ⊤
  rw [← RootSubgroupGenerated_union, positive_union_negative]
  exact rootGenerated_univ_eq_top k

/-- The two torus-and-root candidates generate the ambient group. -/
theorem positiveCandidate_sup_negativeCandidate :
    (positiveCandidate k).toSubgroup ⊔ (negativeCandidate k).toSubgroup = ⊤ := by
  apply top_unique
  rw [← positiveUnipotent_sup_negativeUnipotent k]
  exact sup_le_sup le_sup_right le_sup_right

/-- Separation of the positive root factor from the negative candidate gives
exactly the fixed-torus intersection. The separation premise is still explicit. -/
theorem intersection_eq_torus_of_disjoint
    (hsep : Disjoint (positiveUnipotent k).toSubgroup (negativeCandidate k).toSubgroup) :
    (positiveCandidate k).toSubgroup ⊓ (negativeCandidate k).toSubgroup =
      (CorootTorus.closedSubgroup k).toSubgroup := by
  apply le_antisymm
  · intro x hx
    obtain ⟨t, u, ht, hu, hxu⟩ :=
      (mem_torusRootGenerated_iff k (positiveRoots k) x).mp hx.1
    have htneg : t ∈ negativeCandidate k :=
      torus_le_torusRootGenerated k (negativeRoots k) ht
    have huneg : u ∈ (negativeCandidate k).toSubgroup := by
      have h := (negativeCandidate k).toSubgroup.mul_mem
        ((negativeCandidate k).toSubgroup.inv_mem htneg) hx.2
      simpa only [hxu, inv_mul_cancel_left] using h
    have huone := Subgroup.disjoint_def.mp hsep hu huneg
    rw [hxu, huone, mul_one]
    exact ht
  · intro x hx
    exact ⟨torus_le_torusRootGenerated k (positiveRoots k) hx,
      torus_le_torusRootGenerated k (negativeRoots k) hx⟩

end Triality.SimplyConnected.OppositeBorels
