module

public import Theory.SpecificGroups.Triality.SimplyConnectedModel.Frobenius.PointAction

/-!
# Semilinear Clifford functoriality for the split Spin carrier

A field automorphism on the standard hyperbolic coordinates extends to a ring
endomorphism of the Clifford algebra. To apply the algebra-hom universal
property, the target is a separate copy with scalar action twisted by that
field automorphism. The resulting map preserves Clifford conjugation, the even
subalgebra, and the subgroup generated by invertible vectors, hence the genuine
Spin group.

In every finite Clifford basis its coordinates are explicit semilinear sums;
no prime-field property of the chosen basis is assumed. On the four-plane
carrier, Clifford conjugation identifies the induced point homomorphism with
the already constructed ordinary Frobenius point automorphism. These are the
algebraic inputs to regularity, the nonnegative-exponent part of GLS3 1.15.4(a)
and §§2.1–2.2, specialized to the concrete split D4 carrier.
-/

public section

open Theory.AlgebraicGroup CliffordAlgebra
open Theory.AlgebraicGroup.HyperbolicFieldAutomorphisms
noncomputable section
universe u
namespace Triality.SimplyConnected.RegularLift
variable {k : Type u} [Field k]

private def Twist (r : ℕ) (_σ : k ≃+* k) :=
  CliffordAlgebra (hyperbolicForm (k := k) r)

private instance (r : ℕ) (σ : k ≃+* k) : Ring (Twist r σ) :=
  inferInstanceAs (Ring (CliffordAlgebra (hyperbolicForm (k := k) r)))

private instance (r : ℕ) (σ : k ≃+* k) : Algebra k (Twist r σ) :=
  Algebra.compHom (CliffordAlgebra (hyperbolicForm (k := k) r)) σ.toRingHom

private def untwist (r : ℕ) (σ : k ≃+* k) :
    Twist r σ ≃+* CliffordAlgebra (hyperbolicForm (k := k) r) :=
  { Equiv.refl _ with
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl }

private def twistedVector (r : ℕ) (σ : k ≃+* k) :
    HyperbolicSpace k r →ₗ[k] Twist r σ where
  toFun v := (untwist r σ).symm (ι (hyperbolicForm (k := k) r) (coordinates r σ v))
  map_add' v w := by simp
  map_smul' a v := by
    apply (untwist r σ).injective
    change ι (hyperbolicForm (k := k) r) (coordinates r σ (a • v)) =
      σ a • ι (hyperbolicForm (k := k) r) (coordinates r σ v)
    rw [coordinates_smul, map_smul]

private def twistedLift (r : ℕ) (σ : k ≃+* k) :
    CliffordAlgebra (hyperbolicForm (k := k) r) →ₐ[k] Twist r σ :=
  CliffordAlgebra.lift (hyperbolicForm (k := k) r) ⟨twistedVector r σ, fun v => by
    apply (untwist r σ).injective
    change ι (hyperbolicForm (k := k) r) (coordinates r σ v) *
      ι (hyperbolicForm (k := k) r) (coordinates r σ v) =
        algebraMap k _ (σ (hyperbolicForm r v))
    rw [ι_sq_scalar, coordinates_form]⟩

/-- The semilinear extension of coordinatewise field automorphism to the Clifford algebra. -/
def cliffordMap (r : ℕ) (σ : k ≃+* k) :
    CliffordAlgebra (hyperbolicForm (k := k) r) →+*
      CliffordAlgebra (hyperbolicForm (k := k) r) :=
  (untwist r σ).toRingHom.comp (twistedLift r σ).toRingHom

@[simp] theorem cliffordMap_ι (r : ℕ) (σ : k ≃+* k) (v : HyperbolicSpace k r) :
    cliffordMap r σ (ι (hyperbolicForm (k := k) r) v) =
      ι (hyperbolicForm (k := k) r) (coordinates r σ v) := by
  change untwist r σ (twistedLift r σ (ι (hyperbolicForm (k := k) r) v)) = _
  rw [twistedLift, CliffordAlgebra.lift_ι_apply]
  exact (untwist r σ).apply_symm_apply _

@[simp] theorem cliffordMap_algebraMap (r : ℕ) (σ : k ≃+* k) (a : k) :
    cliffordMap r σ (algebraMap k _ a) = algebraMap k _ (σ a) := by
  exact congrArg (untwist r σ) ((twistedLift r σ).commutes a)

theorem cliffordMap_smul (r : ℕ) (σ : k ≃+* k) (a : k)
    (x : CliffordAlgebra (hyperbolicForm (k := k) r)) :
    cliffordMap r σ (a • x) = σ a • cliffordMap r σ x := by
  simp only [Algebra.smul_def, map_mul, cliffordMap_algebraMap]

@[simp] theorem cliffordMap_star (r : ℕ) (σ : k ≃+* k)
    (x : CliffordAlgebra (hyperbolicForm (k := k) r)) :
    cliffordMap r σ (star x) = star (cliffordMap r σ x) := by
  induction x using CliffordAlgebra.induction with
  | algebraMap a => simp
  | ι v => simp
  | mul x y hx hy => simp [hx, hy]
  | add x y hx hy => simp [hx, hy]

theorem cliffordMap_mem_even (r : ℕ) (σ : k ≃+* k)
    (x : CliffordAlgebra (hyperbolicForm (k := k) r))
    (hx : x ∈ even (hyperbolicForm (k := k) r)) :
    cliffordMap r σ x ∈ even (hyperbolicForm (k := k) r) := by
  change x ∈ evenOdd (hyperbolicForm (k := k) r) 0 at hx
  induction x, hx using CliffordAlgebra.even_induction (hyperbolicForm (k := k) r) with
  | algebraMap a =>
    rw [cliffordMap_algebraMap]
    exact (even (hyperbolicForm (k := k) r)).algebraMap_mem _
  | add x y hx hy ihx ihy =>
    rw [map_add]
    exact add_mem ihx ihy
  | ι_mul_ι_mul v w x hx ih =>
    simp only [map_mul, cliffordMap_ι]
    exact (even (hyperbolicForm (k := k) r)).mul_mem
      (ι_mul_ι_mem_evenOdd_zero _ _ _) ih

theorem cliffordMap_mem_lipschitz (r : ℕ) (σ : k ≃+* k)
    (x : (CliffordAlgebra (hyperbolicForm (k := k) r))ˣ)
    (hx : x ∈ lipschitzGroup (hyperbolicForm (k := k) r)) :
    Units.map (cliffordMap r σ).toMonoidHom x ∈ lipschitzGroup (hyperbolicForm (k := k) r) := by
  have hmap : lipschitzGroup (hyperbolicForm (k := k) r) ≤
      (lipschitzGroup (hyperbolicForm (k := k) r)).comap
        (Units.map (cliffordMap r σ).toMonoidHom) := by
    apply (Subgroup.closure_le _).2
    rintro u ⟨v, hv⟩
    apply Subgroup.subset_closure
    refine ⟨coordinates r σ v, ?_⟩
    change ι (hyperbolicForm (k := k) r) (coordinates r σ v) = cliffordMap r σ u
    rw [← hv, cliffordMap_ι]
  exact hmap hx

theorem cliffordMap_mem_spin (r : ℕ) (σ : k ≃+* k)
    (x : spinGroup (hyperbolicForm (k := k) r)) :
    cliffordMap r σ x ∈ spinGroup (hyperbolicForm (k := k) r) := by
  refine ⟨⟨?_, ?_⟩, cliffordMap_mem_even r σ x (spinGroup.mem_even x.prop)⟩
  · change (↑(Units.map (cliffordMap r σ).toMonoidHom (spinGroup.toUnits x)) :
      CliffordAlgebra (hyperbolicForm (k := k) r)) ∈ _
    apply lipschitzGroup.coe_mem_iff_mem.2
    exact cliffordMap_mem_lipschitz r σ (spinGroup.toUnits x)
      (spinGroup.units_mem_lipschitzGroup x.prop)
  · constructor
    · rw [← cliffordMap_star, ← map_mul, spinGroup.star_mul_self_of_mem x.prop, map_one]
    · rw [← cliffordMap_star, ← map_mul, spinGroup.mul_star_self_of_mem x.prop, map_one]

/-- Restriction to the genuine generated Clifford Spin group. -/
def spinMap (r : ℕ) (σ : k ≃+* k) :
    spinGroup (hyperbolicForm (k := k) r) →* spinGroup (hyperbolicForm (k := k) r) where
  toFun x := ⟨cliffordMap r σ x, cliffordMap_mem_spin r σ x⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' _x _y := Subtype.ext (map_mul _ _ _)

@[simp] theorem spinMap_coe (r : ℕ) (σ : k ≃+* k)
    (x : spinGroup (hyperbolicForm (k := k) r)) :
    (spinMap r σ x : CliffordAlgebra (hyperbolicForm (k := k) r)) =
      cliffordMap r σ x := by rfl

open scoped BigOperators

theorem cliffordMap_eq_sum (r : ℕ) (σ : k ≃+* k) {d : ℕ}
    (e : Module.Basis (Fin d) k (CliffordAlgebra (hyperbolicForm (k := k) r)))
    (x : CliffordAlgebra (hyperbolicForm (k := k) r)) :
    cliffordMap r σ x = ∑ j, σ (e.repr x j) • cliffordMap r σ (e j) := by
  calc
    cliffordMap r σ x = cliffordMap r σ (∑ j, e.repr x j • e j) :=
      congrArg (cliffordMap r σ) (e.sum_repr x).symm
    _ = _ := by simp only [map_sum, cliffordMap_smul]

theorem cliffordMap_mul_repr (r : ℕ) (σ : k ≃+* k) {d : ℕ}
    (e : Module.Basis (Fin d) k (CliffordAlgebra (hyperbolicForm (k := k) r)))
    (x y : CliffordAlgebra (hyperbolicForm (k := k) r)) (i : Fin d) :
    e.repr (cliffordMap r σ x * y) i =
      ∑ j, σ (e.repr x j) * e.repr (cliffordMap r σ (e j) * y) i := by
  rw [cliffordMap_eq_sum r σ e x, Finset.sum_mul]
  simp only [Algebra.smul_mul_assoc, map_sum, map_smul, Finsupp.coe_finsetSum,
    Finset.sum_apply, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul]

variable (k) [IsAlgClosed k]

/-- Transport the Clifford Spin homomorphism to the exact closed carrier. -/
def pointHom (σ : k ≃+* k) : Points k →* Points k :=
  (pointEquiv k).symm.toMonoidHom.comp
    ((spinMap 4 σ).comp (pointEquiv k).toMonoidHom)

@[simp] theorem pointEquiv_pointHom (σ : k ≃+* k) (g : Points k) :
    pointEquiv k (pointHom k σ g) = spinMap 4 σ (pointEquiv k g) := by
  simp [pointHom]

theorem pointHom_naturalAction (σ : k ≃+* k) (g : Points k)
    (v : QuadraticSpace k) :
    coordinates 4 σ ((naturalAction k g).1 v) =
      (naturalAction k (pointHom k σ g)).1 (coordinates 4 σ v) := by
  apply CliffordAlgebra.ι_injective_of_actionForm (quadraticForm k)
    (standardHyperbolicSplit 4).actionForm
  rw [← cliffordMap_ι, naturalAction_clifford, naturalAction_clifford]
  change cliffordMap 4 σ
      ((pointEquiv k g : CliffordAlgebra (quadraticForm k)) * ι (quadraticForm k) v *
        star (pointEquiv k g : CliffordAlgebra (quadraticForm k))) =
    (pointEquiv k (pointHom k σ g) : CliffordAlgebra (quadraticForm k)) *
      ι (quadraticForm k) (coordinates 4 σ v) *
        star (pointEquiv k (pointHom k σ g) : CliffordAlgebra (quadraticForm k))
  simp only [map_mul, cliffordMap_ι, cliffordMap_star, pointEquiv_pointHom, spinMap_coe]

theorem pointHom_frobenius [CharP k 2] (n : ℕ) :
    pointHom k (iterateFrobeniusEquiv k 2 n) = (frobeniusPointAut k n).toMonoidHom := by
  apply MonoidHom.ext
  exact congrFun (eq_frobeniusPointAut_of_naturalAction k n
    (pointHom k (iterateFrobeniusEquiv k 2 n))
    (pointHom_naturalAction k (iterateFrobeniusEquiv k 2 n)))

end Triality.SimplyConnected.RegularLift
