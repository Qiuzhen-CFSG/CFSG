module

public import Theory.SpecificGroups.Triality.ConcreteBruhat.Weyl.RootConjugation.RootCurves
public import Theory.SpecificGroups.Triality.ConcreteBruhat.Torus.Diagonal.CorootWords

/-!
# Simple Weyl normalization of the original coroot-word torus

The proved diagonal formula for each original coroot word combines with the
full-lattice Tits matrix. The integer Cartan reflection identity then proves
nᵢ hⱼ(t) nᵢ⁻¹ = hⱼ(t) hᵢ(t^(-aⱼᵢ)). This only uses the four coroot words;
no identification or parametrization of the whole torus is needed.

Each simple Weyl word is its own inverse in characteristic two. Conjugation
therefore preserves the subgroup generated by the coroot words in both
directions, including for the smallest parameter q = 2.

Source: GLS3 1.12.1(i), 2.3.8 and 2.4.8(f)
(`refs/KGroup/GLS3/Chapter1.tex` and `refs/KGroup/GLS3/chapter2.tex`).
-/

@[expose] public section

open Theory.AlgebraicGroup.StandardRootSystem
open Triality.Standard.Parabolics.RankOneMatrices
open RootPairing.IntegralGeckConstruction
open Triality.Standard.PositiveCoordinates.SumExchangeData
namespace Triality.Standard.ConcreteBruhat.RootConjugation
open Parabolics
noncomputable section
local instance : DecidableEq LatticeIndex := fun a b => instDecidableEqSum a b

open TorusCoordinates
open scoped BigOperators
private lemma weight_enumeration (i : Fin 4) (r : Fin 24) :
    corootWeight i (latticeEnumeration (.inr r)) = rootPairing r i := by
  change (typeDRootPairing 2).pairingIn ℤ (rootEnumeration r)
    (typeDSimpleRootIndex 2 i) = _
  apply FaithfulSMul.algebraMap_injective ℤ ℝ
  rw [RootPairing.algebraMap_pairingIn, ← rootEnumeration_simpleIndex,
    typeDRootPairing_pairing]
  change (∑ k : Fin 4, _ * _) = _
  simp only [← typeDRootPairing_root_val, rootCoords_spec]
  simp [rootPairing, Int.cast_mul, mul_comm]

private lemma reindex_coroot (P : Parameters) (i : Fin 4) (t : (ExtensionField P)ˣ) :
    Matrix.reindexRingEquiv (ExtensionField P) latticeEnumeration.symm
      (corootDiagonal P i t) =
      Matrix.diagonal (Sum.elim (fun _ : Fin 4 => 1)
        (fun r : Fin 24 => t.val ^ rootPairing r i)) := by
  ext a b
  change (if latticeEnumeration a = latticeEnumeration b then
    t.val ^ corootWeight i (latticeEnumeration a) else 0) = _
  simp only [latticeEnumeration.injective.eq_iff]
  by_cases h : a = b
  · subst b
    cases a with
    | inl a => simp [corootWeight, latticeEnumeration]
    | inr a => simp [weight_enumeration]
  · simp [h]

private lemma pairing_reflection (i j : Fin 4) (r : Fin 24) :
    rootPairing r j = rootPairing (reflectionTable i r) j +
      (-typeDCartanMatrix 2 j i) * rootPairing (reflectionTable i r) i := by
  revert i j r
  decide +kernel

private lemma tits_coroot (P : Parameters) (hp : P.prime = 2)
    (i j : Fin 4) (t : (ExtensionField P)ˣ) :
    let := rankOneExtensionCharTwo P hp
    (scalarMap (ExtensionField P)).mapMatrix (binaryTits i) *
        Matrix.reindexRingEquiv _ latticeEnumeration.symm (corootDiagonal P j t) =
      (Matrix.reindexRingEquiv _ latticeEnumeration.symm (corootDiagonal P j t) *
        Matrix.reindexRingEquiv _ latticeEnumeration.symm
          (corootDiagonal P i (t ^ (-typeDCartanMatrix 2 j i)))) *
        (scalarMap (ExtensionField P)).mapMatrix (binaryTits i) := by
  let := rankOneExtensionCharTwo P hp
  simp only [reindex_coroot, Matrix.diagonal_mul_diagonal]
  ext a b
  simp only [Matrix.mul_diagonal, Matrix.diagonal_mul, RingHom.mapMatrix_apply,
    Matrix.map_apply]
  rcases a with a | a <;> rcases b with b | b
  · simp
  · simp [binaryTits]
  · simp [binaryTits]
  · simp only [binaryTits, Sum.elim_inr]
    by_cases h : a = reflectionTable i b
    · subst a
      simp only [if_true, map_one, one_mul, mul_one]
      rw [← Units.val_zpow_eq_zpow_val, ← Units.val_zpow_eq_zpow_val,
        ← Units.val_zpow_eq_zpow_val, ← Units.val_mul, ← zpow_mul, ← zpow_add,
        ← pairing_reflection]
    · simp [h]

private lemma weyl_torus_intertwine (P : Parameters) (hp : P.prime = 2)
    (i j : Fin 4) (t : (ExtensionField P)ˣ) :
    weylWord P i 1 * torusWord P j t =
      (torusWord P j t * torusWord P i (t ^ (-typeDCartanMatrix 2 j i))) *
        weylWord P i 1 := by
  let := rankOneExtensionCharTwo P hp
  apply Subtype.ext
  apply Units.ext
  apply (Matrix.reindexRingEquiv (ExtensionField P) latticeEnumeration.symm).injective
  change Matrix.reindexRingEquiv _ latticeEnumeration.symm (_ * _) =
    Matrix.reindexRingEquiv _ latticeEnumeration.symm ((_ * _) * _)
  simp only [map_mul, weylWord_matrix P hp, torusWord_val P hp]
  exact tits_coroot P hp i j t

/-- The Cartan reflection equation for the original simple-coroot words. -/
theorem weylWord_torusWord_conjugation (P : Parameters) (hp : P.prime = 2)
    (i j : Fin 4) (t : (ExtensionField P)ˣ) :
    weylWord P i 1 * torusWord P j t * (weylWord P i 1)⁻¹ =
      torusWord P j t * torusWord P i (t ^ (-typeDCartanMatrix 2 j i)) := by
  rw [weyl_torus_intertwine P hp, mul_inv_cancel_right]

/-- The characteristic-two simple Weyl word equals its inverse. -/
theorem weylWord_one_inv (P : Parameters) (hp : P.prime = 2) (i : Fin 4) :
    (weylWord P i 1)⁻¹ = weylWord P i 1 := by
  let := rankOneExtensionCharTwo P hp
  apply Subtype.ext
  simp only [weylWord, positiveRoot, negativeRoot, Subgroup.coe_inv, Subgroup.coe_mul,
    RootPairing.SimpleGeckGroup.positive, RootPairing.SimpleGeckGroup.negative, inv_one]
  simp only [mul_inv_rev, RootPairing.SimpleGeckGroup.positiveUnit_inv,
    RootPairing.SimpleGeckGroup.negativeUnit_inv, CharTwo.neg_eq, mul_assoc]

private lemma normalizes_closure_of_inv_eq_self {G : Type*} [Group G]
    (w : G) (hw : w⁻¹ = w) (s : Set G)
    (h : ∀ g ∈ s, w * g * w⁻¹ ∈ Subgroup.closure s) :
    w ∈ Subgroup.normalizer (Subgroup.closure s) := by
  have hc : Subgroup.closure s ≤
      (Subgroup.closure s).comap (MulAut.conj w).toMonoidHom :=
    (Subgroup.closure_le _).mpr h
  rw [Subgroup.mem_normalizer_iff]
  intro g
  constructor
  · exact fun hg => hc hg
  · intro hg
    have hh := hc hg
    change w * (w * g * w⁻¹) * w⁻¹ ∈ Subgroup.closure s at hh
    have hh' : w⁻¹ * (w * g * w⁻¹) * w ∈ Subgroup.closure s := by
      simpa only [hw] using hh
    simpa only [mul_assoc, inv_mul_cancel, mul_one, inv_mul_cancel_left] using hh'

/-- Each simple Weyl word normalizes the original coroot-word subgroup. -/
theorem weylWord_mem_normalizer_splitTorus (P : Parameters) (hp : P.prime = 2) (i : Fin 4) :
    weylWord P i 1 ∈ Subgroup.normalizer (splitTorus P) := by
  apply normalizes_closure_of_inv_eq_self _ (weylWord_one_inv P hp i)
  rintro _ ⟨j, t, rfl⟩
  rw [weylWord_torusWord_conjugation P hp]
  exact (splitTorus P).mul_mem (Subgroup.subset_closure ⟨j, t, rfl⟩)
    (Subgroup.subset_closure ⟨i, _, rfl⟩)

end
end Triality.Standard.ConcreteBruhat.RootConjugation
