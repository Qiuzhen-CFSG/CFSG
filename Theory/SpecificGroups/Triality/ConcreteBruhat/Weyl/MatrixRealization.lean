module

public import Theory.SpecificGroups.Triality.ConcreteBruhat.Weyl.Basic
public import Theory.SpecificGroups.Triality.ConcreteBruhat.LatticeInstances
public import Theory.SpecificGroups.Triality.ConcreteBruhat.Weyl.MatrixRealization.LatticeAction

/-!
# The actual split D₄ Weyl group in the binary Geck matrices

The subgroup generated by the four simple matrix words is multiplicatively
isomorphic to the group generated by the four literal root reflections. Each
matrix word realizes a unique root permutation. The root and coroot spanning
families show that this permutation determines its entire 28-dimensional matrix;
this proves injectivity without discarding the Cartan coordinates. The simple
reflections generate the target, giving surjectivity.

The actual graph-field automorphism permutes the simple matrix words in the
same way that the diagram automorphism conjugates the root reflections. Equality
on these generators proves equivariance on the whole subgroup. All statements
include `q = 2`. No realization certificate or torus-normalizer assertion is used.

Source: the D₄ reflection construction and GLS3 §§2.3–2.4
(`refs/KGroup/GLS3/chapter2.tex`).
-/

public section
open Theory.AlgebraicGroup.StandardRootSystem
open Triality.Standard.Parabolics.RankOneMatrices
open Triality.Standard.PositiveCoordinates.SumExchangeData
open RootPairing.IntegralGeckConstruction
open Matrix

namespace Triality.Standard.ConcreteBruhat
open MatrixRealization
open Parabolics
noncomputable section
attribute [local instance] instDecidableEqLatticeIndex

private def splitWeylHom (P : Parameters) (hp : P.prime = 2) :
    splitWeylSubgroup P →* rootWeylGroup where
  toFun g := (exists_realizes P hp g).choose
  map_one' := Realizes.permutation_unique (exists_realizes P hp 1).choose_spec (realizes_one P)
  map_mul' g h := Realizes.permutation_unique (exists_realizes P hp (g * h)).choose_spec
    (realizes_mul (exists_realizes P hp g).choose_spec (exists_realizes P hp h).choose_spec)

private lemma splitWeylHom_realizes (P : Parameters) (hp : P.prime = 2)
    (g : splitWeylSubgroup P) : Realizes P g.val (splitWeylHom P hp g) :=
  (exists_realizes P hp g).choose_spec

private lemma splitWeylHom_simple (P : Parameters) (hp : P.prime = 2) (i : Fin 4) :
    splitWeylHom P hp (splitWeylGenerator P i) = rootWeylGenerator i :=
  Realizes.permutation_unique (splitWeylHom_realizes P hp _) (realizes_simple P hp i)

private lemma splitWeylHom_injective (P : Parameters) (hp : P.prime = 2) :
    Function.Injective (splitWeylHom P hp) := by
  intro g h he
  apply Subtype.ext
  apply Realizes.matrix_unique (splitWeylHom_realizes P hp g)
  rw [he]
  exact splitWeylHom_realizes P hp h

private lemma root_generators_dense : Subgroup.closure (Set.range rootWeylGenerator) = ⊤ := by
  apply Subgroup.map_injective rootWeylGroup.subtype_injective
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  rw [← Set.range_comp]
  rfl

private lemma splitWeylHom_surjective (P : Parameters) (hp : P.prime = 2) :
    Function.Surjective (splitWeylHom P hp) := by
  have h : ⊤ ≤ (splitWeylHom P hp).range := by
    rw [← root_generators_dense]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨splitWeylGenerator P i, splitWeylHom_simple P hp i⟩
  exact fun w => h (Subgroup.mem_top w)

/-- The actual split Geck Weyl subgroup is the literal D₄ reflection group.
The construction is faithful on all 28 Geck coordinates, also when `q = 2`. -/
def splitWeylEquiv (P : Parameters) (hp : P.prime = 2) :
    splitWeylSubgroup P ≃* rootWeylGroup :=
  MulEquiv.ofBijective (splitWeylHom P hp)
    ⟨splitWeylHom_injective P hp, splitWeylHom_surjective P hp⟩

@[simp] theorem splitWeylEquiv_generator (P : Parameters) (hp : P.prime = 2) (i : Fin 4) :
    splitWeylEquiv P hp (splitWeylGenerator P i) = rootWeylGenerator i :=
  splitWeylHom_simple P hp i

/-- Both spanning families transform by the Weyl permutation. -/
theorem splitWeylEquiv_realizes (P : Parameters) (hp : P.prime = 2)
    (g : splitWeylSubgroup P) : Realizes P g.val (splitWeylEquiv P hp g) :=
  splitWeylHom_realizes P hp g

/-- Every entry of the full matrix is determined by the literal Weyl permutation. -/
theorem splitWeylEquiv_matrix_column (P : Parameters) (hp : P.prime = 2)
    (g : splitWeylSubgroup P) (a b : Index) :
    matrix P g.val a b = match b with
      | .inl j => corootVector (ExtensionField P)
          (rootAction (splitWeylEquiv P hp g) (simpleIndex j)) a
      | .inr r => if a = .inr (rootAction (splitWeylEquiv P hp g) r) then 1 else 0 :=
  (splitWeylEquiv_realizes P hp g).matrix_column a b

/-- Root columns in the original, un-reindexed Geck matrix. -/
theorem splitWeylEquiv_root_column (P : Parameters) (hp : P.prime = 2)
    (g : splitWeylSubgroup P) (a : LatticeIndex) (r : TypeDRootIndex 4) :
    g.val.val.val a (.inr r) =
      if a = .inr ((splitWeylEquiv P hp g).val r) then 1 else 0 :=
  (splitWeylEquiv_realizes P hp g).root_column a r

private lemma subtype_generators_dense {G I : Type*} [Group G]
    (H : Subgroup G) (s : I → H)
    (h : Subgroup.closure (Set.range (fun i => (s i).val)) = H) :
    Subgroup.closure (Set.range s) = ⊤ := by
  apply Subgroup.map_injective H.subtype_injective
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, Subgroup.range_subtype,
    ← Set.range_comp]
  exact h

private lemma split_generators_dense (P : Parameters) :
    Subgroup.closure (Set.range (splitWeylGenerator P)) = ⊤ := by
  apply subtype_generators_dense
  change Subgroup.closure (Set.range (fun i => weylWord P i 1)) =
    Subgroup.closure {g | ∃ i, g = weylWord P i 1}
  congr 1
  ext g
  exact exists_congr (fun _ => eq_comm)

private lemma graphField_generator (P : Parameters) (i : Fin 4) :
    splitWeylGraphField P (splitWeylGenerator P i) =
      splitWeylGenerator P (typeD4DiagramPermutation i) := by
  apply Subtype.ext
  simp [splitWeylGenerator]

private lemma diagram_reflection (i : Fin 4) :
    rootReflection (typeD4DiagramPermutation i) =
      typeD4DiagramEquiv.indexEquiv * rootReflection i * typeD4DiagramEquiv.indexEquiv⁻¹ := by
  have hr (r s : TypeDRootIndex 4) :
      typeD4DiagramEquiv.indexEquiv ((typeDRootPairing 2).reflectionPerm r s) =
        (typeDRootPairing 2).reflectionPerm (typeD4DiagramEquiv.indexEquiv r)
          (typeD4DiagramEquiv.indexEquiv s) := by
    apply (typeDRootPairing 2).root.injective
    rw [← diagram_weight_root, RootPairing.root_reflectionPerm,
      RootPairing.reflection_apply, map_sub, map_smul, diagram_weight_root,
      diagram_weight_root, RootPairing.root_coroot'_eq_pairing,
      ← typeD4DiagramEquiv.pairing_eq s r, RootPairing.root_reflectionPerm,
      RootPairing.reflection_apply_root]
  apply Equiv.ext
  intro r
  change (typeDRootPairing 2).reflectionPerm _ r =
    typeD4DiagramEquiv.indexEquiv ((typeDRootPairing 2).reflectionPerm _
      (typeD4DiagramEquiv.indexEquiv.symm r))
  rw [hr, typeD4DiagramEquiv_numbered, Equiv.apply_symm_apply]

/-- Graph-field action on the matrices agrees with diagram conjugation on roots. -/
theorem splitWeylEquiv_graphField (P : Parameters) (hp : P.prime = 2)
    (w : splitWeylSubgroup P) :
    (splitWeylEquiv P hp (splitWeylGraphField P w)).val =
      typeD4DiagramEquiv.indexEquiv * (splitWeylEquiv P hp w).val *
        typeD4DiagramEquiv.indexEquiv⁻¹ := by
  let f : splitWeylSubgroup P →* Equiv.Perm (TypeDRootIndex 4) :=
    rootWeylGroup.subtype.comp
      ((splitWeylEquiv P hp).toMonoidHom.comp (splitWeylGraphField P).toMonoidHom)
  let g : splitWeylSubgroup P →* Equiv.Perm (TypeDRootIndex 4) :=
    (MulAut.conj typeD4DiagramEquiv.indexEquiv).toMonoidHom.comp
      (rootWeylGroup.subtype.comp (splitWeylEquiv P hp).toMonoidHom)
  have he : f = g := by
    apply MonoidHom.eq_of_eqOn_dense (split_generators_dense P)
    rintro _ ⟨i, rfl⟩
    change (splitWeylEquiv P hp (splitWeylGraphField P (splitWeylGenerator P i))).val =
      typeD4DiagramEquiv.indexEquiv *
        (splitWeylEquiv P hp (splitWeylGenerator P i)).val * typeD4DiagramEquiv.indexEquiv⁻¹
    have hl := (congrArg (splitWeylEquiv P hp) (graphField_generator P i)).trans
      (splitWeylEquiv_generator P hp (typeD4DiagramPermutation i))
    have hr := congrArg (fun v : rootWeylGroup =>
      typeD4DiagramEquiv.indexEquiv * v.val * typeD4DiagramEquiv.indexEquiv⁻¹)
        (splitWeylEquiv_generator P hp i)
    exact (congrArg Subtype.val hl).trans ((diagram_reflection i).trans hr.symm)
  exact DFunLike.congr_fun he w

/-- Pointwise diagram compatibility in the form consumed by the split Bruhat inputs. -/
theorem splitWeylEquiv_graphField_index (P : Parameters) (hp : P.prime = 2)
    (w : splitWeylSubgroup P) (r : TypeDRootIndex 4) :
    (splitWeylEquiv P hp (splitWeylGraphField P w)).val (typeD4DiagramEquiv.indexEquiv r) =
      typeD4DiagramEquiv.indexEquiv ((splitWeylEquiv P hp w).val r) := by
  have h := congrArg (fun v : Equiv.Perm (TypeDRootIndex 4) =>
    v (typeD4DiagramEquiv.indexEquiv r)) (splitWeylEquiv_graphField P hp w)
  simpa only [Equiv.Perm.mul_apply, Equiv.Perm.inv_def, Equiv.symm_apply_apply] using h

end
end Triality.Standard.ConcreteBruhat
