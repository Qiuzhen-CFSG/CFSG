module

public import Theory.SpecificGroups.Triality.ConcreteBruhat.RootData
public import Mathlib.GroupTheory.SpecificGroups.Dihedral
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Concrete candidates for the triality Bruhat decomposition

These subgroups and representatives use actual simple Geck words and the
actual elementary central quotient. The split Weyl candidate is generated by
all four simple Weyl words. The two relative representatives use the arm and
central folded words, indexed by the twelve-element dihedral group.

Only the definitions and their elementary containment/evaluation properties
are established here. Identifying the normalizer quotient with the dihedral
group, constructing the full Bruhat normal form, and counting cells remain
separate matrix and collection arguments.

Source: GLS3 2.3.4–8 and Definition 2.6.4
(`refs/KGroup/GLS3/chapter2.tex`).
-/

@[expose] public section
noncomputable section
open scoped Pointwise
namespace Triality.Standard.ConcreteBruhat
open Parabolics
open Theory.AlgebraicGroup.StandardRootSystem

/-- The actual coroot-word subgroup in the split Geck group. -/
def splitTorus (P : Parameters) : Subgroup (SplitGroup P) :=
  Subgroup.closure {g | ∃ i t, g = torusWord P i t}

/-- The subgroup of actual simple Weyl matrices; no Weyl identification is assumed. -/
def splitWeylSubgroup (P : Parameters) : Subgroup (SplitGroup P) :=
  Subgroup.closure {g | ∃ i : Fin 4, g = weylWord P i 1}

/-- Split normalizer candidate, with the torus and Weyl words both explicit. -/
def splitNormalizer (P : Parameters) : Subgroup (SplitGroup P) :=
  splitTorus P ⊔ splitWeylSubgroup P

/-- The simple D4 reflections acting on the literal root indices. -/
def rootReflection (i : Fin 4) : Equiv.Perm (TypeDRootIndex 4) :=
  (typeDRootPairing 2).reflectionPerm (typeDSimpleRootIndex 2 i)

/-- The geometric D4 Weyl group, kept distinct from its matrix realization. -/
def rootWeylGroup : Subgroup (Equiv.Perm (TypeDRootIndex 4)) :=
  Subgroup.closure (Set.range rootReflection)

/-- The torus in the elementary central quotient, via the original descent. -/
def torus (P : Parameters) : Subgroup (Carrier P) := descendSubgroup P (splitTorus P)

/-- The two intended relative simple reflections in the dihedral index group. -/
def relativeReflection : Node → DihedralGroup 6
  | .arms => .sr 0
  | .central => .sr 1

/-- Explicit elementary representatives, using rotation `arms * central`. -/
def weylElementary (P : Parameters) (hp : P.prime = 2) : DihedralGroup 6 → ElementaryGroup P
  | .r i => (simpleElementary P hp .arms * simpleElementary P hp .central) ^ i.val
  | .sr i => simpleElementary P hp .arms *
      (simpleElementary P hp .arms * simpleElementary P hp .central) ^ i.val

/-- The same words as literal split Geck matrices. -/
def splitRepresentative (P : Parameters) (hp : P.prime = 2) (w : DihedralGroup 6) :
    SplitGroup P := elementaryInclusion P (weylElementary P hp w)

/-- The representatives in the actual carrier, without presuming multiplicativity. -/
def weylRepresentative (P : Parameters) (hp : P.prime = 2) (w : DihedralGroup 6) :
    Carrier P := toCarrier P (weylElementary P hp w)

/-- Relative normalizer candidate. Its intersection with B still requires proof. -/
def normalizerCandidate (P : Parameters) (hp : P.prime = 2) : Subgroup (Carrier P) :=
  torus P ⊔ Subgroup.closure (Set.range (simpleRepresentative P hp))

/-- A double coset of B through the explicitly given matrix word. -/
def cell (P : Parameters) (hp : P.prime = 2) (w : DihedralGroup 6) : Set (Carrier P) :=
  (borel P : Set (Carrier P)) * {weylRepresentative P hp w} * (borel P : Set (Carrier P))

theorem splitTorus_le_splitBorel (P : Parameters) : splitTorus P ≤ splitBorel P := le_sup_right

theorem torus_le_borel (P : Parameters) : torus P ≤ borel P :=
  descendSubgroup_mono P (splitTorus_le_splitBorel P)

theorem relativeReflection_ne (a b : Node) (h : a ≠ b) :
    relativeReflection a ≠ relativeReflection b := by
  cases a <;> cases b <;> first | exact (h rfl).elim | decide

theorem relativeReflection_involution (a : Node) :
    relativeReflection a ≠ 1 ∧ relativeReflection a ^ 2 = 1 := by
  cases a <;> decide

private theorem involution_word {G : Type*} [Group G] (x y : G) (h : x ^ 2 = 1) :
    x * (x * y) ^ 1 = y := by
  rw [pow_one, ← mul_assoc, ← pow_two, h, one_mul]

theorem weylElementary_simple (P : Parameters) (hp : P.prime = 2) (a : Node) :
    weylElementary P hp (relativeReflection a) = simpleElementary P hp a := by
  cases a with
  | arms => simp [relativeReflection, weylElementary]
  | central =>
    exact involution_word (simpleElementary P hp .arms) (simpleElementary P hp .central)
      (simpleElementary_sq P hp .arms)

@[simp] theorem weylRepresentative_simple (P : Parameters) (hp : P.prime = 2) (a : Node) :
    weylRepresentative P hp (relativeReflection a) = simpleRepresentative P hp a :=
  congrArg (toCarrier P) (weylElementary_simple P hp a)

@[simp] theorem weylElementary_one (P : Parameters) (hp : P.prime = 2) :
    weylElementary P hp 1 = 1 := by
  change (_ : ElementaryGroup P) ^ (0 : ZMod 6).val = 1
  simp

@[simp] theorem weylRepresentative_one (P : Parameters) (hp : P.prime = 2) :
    weylRepresentative P hp 1 = 1 := by
  simp [weylRepresentative]

theorem simpleRepresentative_mem_normalizer (P : Parameters) (hp : P.prime = 2) (a : Node) :
    simpleRepresentative P hp a ∈ normalizerCandidate P hp :=
  Subgroup.mem_sup_right (Subgroup.subset_closure (Set.mem_range_self a))

theorem mem_cell_iff (P : Parameters) (hp : P.prime = 2) (w : DihedralGroup 6)
    (g : Carrier P) : g ∈ cell P hp w ↔
      ∃ b₁ ∈ borel P, ∃ b₂ ∈ borel P, g = b₁ * weylRepresentative P hp w * b₂ := by
  constructor
  · rintro ⟨_, ⟨b₁, hb₁, n, hn, rfl⟩, b₂, hb₂, rfl⟩
    rw [Set.mem_singleton_iff] at hn
    subst n
    exact ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  · rintro ⟨b₁, hb₁, b₂, hb₂, rfl⟩
    exact ⟨_, ⟨b₁, hb₁, _, Set.mem_singleton _, rfl⟩, b₂, hb₂, rfl⟩

@[simp] theorem cell_one (P : Parameters) (hp : P.prime = 2) :
    cell P hp 1 = (borel P : Set (Carrier P)) := by
  ext g
  rw [mem_cell_iff, weylRepresentative_one]
  constructor
  · rintro ⟨b₁, hb₁, b₂, hb₂, rfl⟩
    simpa using (borel P).mul_mem hb₁ hb₂
  · intro hg
    exact ⟨g, hg, 1, (borel P).one_mem, by simp⟩

theorem simple_cell_subset_parabolic (P : Parameters) (hp : P.prime = 2) (a : Node) :
    cell P hp (relativeReflection a) ⊆ parabolic P a := by
  intro g hg
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := (mem_cell_iff P hp _ g).mp hg
  rw [weylRepresentative_simple]
  exact (parabolic P a).mul_mem
    ((parabolic P a).mul_mem (borel_le_parabolic P a hb₁)
      (simpleRepresentative_mem_parabolic P hp a)) (borel_le_parabolic P a hb₂)

end Triality.Standard.ConcreteBruhat
end
