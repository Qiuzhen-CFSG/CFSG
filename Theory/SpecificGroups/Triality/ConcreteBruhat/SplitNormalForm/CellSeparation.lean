module

public import Theory.SpecificGroups.Triality.ConcreteBruhat.SplitNormalForm.CellSeparation.SimpleNegative
public import Theory.SpecificGroups.Triality.ConcreteBruhat.SplitNormalForm.CellSeparation.Opposite
public import Theory.SpecificGroups.Triality.ConcreteBruhat.SplitNormalForm.CellSeparation.NegativeHeight
public import Theory.SpecificGroups.Triality.ConcreteBruhat.SplitNormalForm.CellSeparation.WeylRootColumns
public import Theory.SpecificGroups.Triality.ConcreteBruhat.Torus.Diagonal

/-!
# Matrix separation for split D4 Bruhat coordinates

For every binary parameter, the literal split Borel meets the split normalizer
in the split torus, and two four-factor coordinates with the same Weyl index
and evaluation are equal. The negative-simple and simple-Weyl nonmembership
results are also re-exported here.

The actual coroot parametrization makes every torus matrix diagonal. Positive
matrices raise height, while negative matrices lower it; this separates the
Borel from the negative subgroup and proves uniqueness within a Weyl cell.
The root-column formula for the supplied Weyl representatives makes an upper
Weyl matrix fix all roots, giving the normalizer intersection. Thus all matrix
premises of the conditional separation lemmas are discharged from the concrete
Geck model. The only remaining input is the published Weyl/torus `Inputs`.

Source: GLS3 2.3.4–5, 2.3.8 and §2.4, `refs/KGroup/GLS3/chapter2.tex`.
-/

public section
namespace Triality.Standard.ConcreteBruhat.SplitNormalForm.CellSeparation
noncomputable section
open Parabolics
attribute [local instance] matrixLatticeDecidableEq

/-- Every element of the actual split torus has an upper matrix, since its
coroot-coordinate product is diagonal. -/
theorem upper_torus (P : Parameters) (hp : P.prime = 2) (t : splitTorus P) :
    Upper (matrix P t.val) := by
  have ht : t.val ∈ Set.range (TorusCoordinates.product P) := by
    rw [TorusCoordinates.range_product P hp]
    exact t.property
  obtain ⟨a, ha⟩ := ht
  intro i j hij _
  rw [← ha]
  change (TorusCoordinates.product P a).val.val i j = 0
  rw [TorusCoordinates.product_val P hp]
  exact Matrix.diagonal_apply_ne _ hij

/-- The Borel-normalizer intersection in the literal binary split D4 group. -/
theorem borel_inf_normalizer (n : ℕ) (hn : 0 < n)
    (D : Inputs (binaryParameters n hn)) :
    splitBorel (binaryParameters n hn) ⊓ splitNormalizer _ = splitTorus _ :=
  borel_inf_normalizer_of_matrix_entries n hn D
    (upper_torus _ rfl) (matrix_lift_root_pivot_ne_zero n hn D)

/-- The split Borel is disjoint from the subgroup generated by all canonical
negative root curves. -/
theorem borel_inf_negative (n : ℕ) (hn : 0 < n)
    (D : Inputs (binaryParameters n hn)) :
    Disjoint (splitBorel (binaryParameters n hn)) (negativeSubgroup _) :=
  borel_inf_negative_of_matrix_entries n hn D
    (upper_torus _ rfl) (negative_rootCurve_lowers _)

/-- Four-factor coordinates with equal Weyl indices and evaluations coincide,
including over the smallest binary parameter field. -/
theorem coordinates_injective (n : ℕ) (hn : 0 < n)
    (D : Inputs (binaryParameters n hn))
    {a b : Coordinates (binaryParameters n hn)} (hw : a.weyl = b.weyl)
    (he : evaluate D a = evaluate D b) : a = b :=
  coordinates_injective_of_matrix_entries n hn D
    (upper_torus _ rfl) (negative_rootCurve_lowers _) hw he

end
end Triality.Standard.ConcreteBruhat.SplitNormalForm.CellSeparation
