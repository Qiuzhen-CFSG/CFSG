module

public import Theory.SpecificGroups.Triality.ConcreteBruhat.SplitNormalForm.CellSeparation.Upper

/-!
# Opposite root support and uniqueness within one Weyl cell

The negative subgroup is the closure of the literal canonical negative root
curves. A height-lowering bound on those curves extends to their closure.
Together with upper torus matrices this proves that its intersection with the
Borel is trivial. The supplied left-conjugation formula takes inversion-supported
right factors into this subgroup. Comparing two four-factor expressions then
cancels the right factors, and the existing positive/torus disjointness cancels
the left factors.

The negative-root height bound and upper torus support remain explicit premises
of the conditional separation theorem. No cell coverage or Tits system is used.
Source: GLS3 2.3.5 and 2.3.8(c), `refs/KGroup/GLS3/chapter2.tex`.
-/

@[expose] public section
namespace Triality.Standard.ConcreteBruhat.SplitNormalForm.CellSeparation
noncomputable section
open Parabolics PositiveCoordinates.Injectivity Parabolics.RankOneMatrices
open Theory.AlgebraicGroup.StandardRootSystem
attribute [local instance] matrixLatticeDecidableEq

/-- The subgroup generated by all canonical negative root curves. -/
def negativeSubgroup (P : Parameters) : Subgroup (SplitGroup P) :=
  Subgroup.closure {g | ∃ (r : TypeDRootIndex 4),
    ¬ (typeDRootPairing_base 2).IsPos r ∧ ∃ t, g = rootCurve P r t}

lemma rootCurve_zero (P : Parameters) (r : TypeDRootIndex 4) :
    rootCurve P r 0 = 1 :=
  Subtype.ext (RootPairing.IntegralGeckConstruction.rootCurveUnit_zero _ _)

lemma rootCurve_inv (P : Parameters) (r : TypeDRootIndex 4) (t : ExtensionField P) :
    (rootCurve P r t)⁻¹ = rootCurve P r (-t) :=
  Subtype.ext (RootPairing.IntegralGeckConstruction.rootCurveUnit_inv _ _ _)

lemma lowers_mul {P : Parameters} {a b : SplitGroup P}
    (ha : Raises (fun i => -degree i) 1 (matrix P a - 1))
    (hb : Raises (fun i => -degree i) 1 (matrix P b - 1)) :
    Raises (fun i => -degree i) 1 (matrix P (a * b) - 1) := by
  rw [map_mul]
  have h := raises_prod_sub_one (fun i => -degree i) 1 (by norm_num)
    [matrix P a, matrix P b]
  simp only [List.prod_cons, List.prod_nil, mul_one] at h
  apply h
  intro A hA
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hA
  rcases hA with rfl | rfl
  · exact ha
  · exact hb

lemma negative_lowers_of_root_entries (P : Parameters)
    (hneg : ∀ (r : TypeDRootIndex 4), ¬ (typeDRootPairing_base 2).IsPos r →
      ∀ t : ExtensionField P, Raises (fun i => -degree i) 1 (matrix P (rootCurve P r t) - 1))
    {g : SplitGroup P} (hg : g ∈ negativeSubgroup P) :
    Raises (fun i => -degree i) 1 (matrix P g - 1) := by
  induction hg using Subgroup.closure_induction'' with
  | one => simpa only [map_one, sub_self] using raises_zero (fun i => -degree i) 1
  | mem g hg =>
      obtain ⟨r, hr, t, rfl⟩ := hg
      exact hneg r hr t
  | inv_mem g hg =>
      obtain ⟨r, hr, t, rfl⟩ := hg
      rw [rootCurve_inv]
      exact hneg r hr (-t)
  | mul a b _ _ ha hb => exact lowers_mul ha hb

lemma borel_inf_negative_of_matrix_entries (n : ℕ) (hn : 0 < n)
    (D : Inputs (binaryParameters n hn))
    (ht : ∀ t : splitTorus (binaryParameters n hn), Upper (matrix _ t.val))
    (hneg : ∀ (r : TypeDRootIndex 4), ¬ (typeDRootPairing_base 2).IsPos r →
      ∀ t : ExtensionField (binaryParameters n hn),
        Raises (fun i => -degree i) 1 (matrix _ (rootCurve _ r t) - 1)) :
    Disjoint (splitBorel (binaryParameters n hn)) (negativeSubgroup _) := by
  apply Subgroup.disjoint_def.mpr
  intro g hg hnmem
  exact eq_one_of_upper_of_lowers _ (upper_borel n hn D ht hg)
    (negative_lowers_of_root_entries _ hneg hnmem)

private lemma conjugate_list_prod_mem {G : Type*} [Group G]
    (H : Subgroup G) (n : G) (l : List G)
    (h : ∀ x ∈ l, n * x * n⁻¹ ∈ H) : n * l.prod * n⁻¹ ∈ H := by
  induction l with
  | nil => simpa only [List.prod_nil, mul_one, mul_inv_cancel] using H.one_mem
  | cons x l ih =>
      have hx := h x (List.mem_cons_self)
      have hl := ih (fun y hy => h y (List.mem_cons_of_mem x hy))
      have hm := H.mul_mem hx hl
      simpa only [List.prod_cons, mul_assoc, inv_mul_cancel_left] using hm

/-- Inversion support puts the conjugated right factor in the negative subgroup. -/
lemma conjugate_supported_mem_negative {P : Parameters} (D : Inputs P)
    (w : rootWeylGroup) (a : PositiveCoordinates.Coordinates P) (ha : Supported P w a) :
    D.lift w * PositiveCoordinates.orderedProduct P a * (D.lift w)⁻¹ ∈ negativeSubgroup P := by
  apply conjugate_list_prod_mem
  intro g hg
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hg
  have hc : D.lift w * PositiveCoordinates.curve P i (a i) * (D.lift w)⁻¹ =
      rootCurve P (w.val (PositiveCoordinates.rootIndex i)) (a i) :=
    D.conjugate_root w (PositiveCoordinates.rootIndex i) (a i)
  rw [hc]
  by_cases hi : (typeDRootPairing_base 2).IsPos (w.val (PositiveCoordinates.rootIndex i))
  · rw [ha i hi, rootCurve_zero]
    exact (negativeSubgroup P).one_mem
  · exact Subgroup.subset_closure ⟨_, hi, a i, rfl⟩

/-- Uniqueness inside one Weyl cell from torus support and negative-root entries. -/
lemma coordinates_injective_of_matrix_entries (n : ℕ) (hn : 0 < n)
    (D : Inputs (binaryParameters n hn))
    (ht : ∀ t : splitTorus (binaryParameters n hn), Upper (matrix _ t.val))
    (hneg : ∀ (r : TypeDRootIndex 4), ¬ (typeDRootPairing_base 2).IsPos r →
      ∀ t : ExtensionField (binaryParameters n hn),
        Raises (fun i => -degree i) 1 (matrix _ (rootCurve _ r t) - 1))
    {a b : Coordinates (binaryParameters n hn)} (hw : a.weyl = b.weyl)
    (he : evaluate D a = evaluate D b) : a = b := by
  let A := a.left.val * a.torus.val
  let B := b.left.val * b.torus.val
  let v := PositiveCoordinates.orderedProduct (binaryParameters n hn) a.right
  let v' := PositiveCoordinates.orderedProduct (binaryParameters n hn) b.right
  let N := D.lift a.weyl
  have he' : A * N * v = B * N * v' := by
    simpa only [evaluate, hw, A, B, N, v, v'] using he
  have hA : A ∈ splitBorel _ := (splitBorel _).mul_mem
    (Subgroup.mem_sup_left a.left.property) (splitTorus_le_splitBorel _ a.torus.property)
  have hB : B ∈ splitBorel _ := (splitBorel _).mul_mem
    (Subgroup.mem_sup_left b.left.property) (splitTorus_le_splitBorel _ b.torus.property)
  have hz : N * v * v'⁻¹ * N⁻¹ = A⁻¹ * B := by
    calc
      _ = A⁻¹ * (A * N * v) * v'⁻¹ * N⁻¹ := by group
      _ = A⁻¹ * (B * N * v') * v'⁻¹ * N⁻¹ := by rw [he']
      _ = _ := by group
  have hzn : N * v * v'⁻¹ * N⁻¹ ∈ negativeSubgroup _ := by
    have hav := conjugate_supported_mem_negative D a.weyl a.right a.supported
    have hbv := conjugate_supported_mem_negative D a.weyl b.right (hw.symm ▸ b.supported)
    have h := (negativeSubgroup _).mul_mem hav ((negativeSubgroup _).inv_mem hbv)
    convert h using 1
    dsimp [N, v, v']
    group
  have hz1 : N * v * v'⁻¹ * N⁻¹ = 1 :=
    Subgroup.disjoint_def.mp (borel_inf_negative_of_matrix_entries n hn D ht hneg)
      ((hz.symm ▸ (splitBorel _).mul_mem ((splitBorel _).inv_mem hA) hB)) hzn
  have hv : v = v' := by
    have h := mul_inv_eq_one.mp hz1
    have h' : v * v'⁻¹ = 1 := by
      apply mul_left_cancel (a := N)
      simpa only [mul_assoc, mul_one] using h
    exact mul_inv_eq_one.mp h'
  have hr : a.right = b.right := PositiveCoordinates.orderedProduct_injective _ hv
  have hAB : A = B := by
    rw [hv] at he'
    exact mul_right_cancel (mul_right_cancel he')
  have hp : (a.left, a.torus) = (b.left, b.torus) :=
    Subgroup.mul_injective_of_disjoint D.positive_disjoint_torus hAB
  exact Coordinates.ext (congrArg Prod.fst hp) (congrArg Prod.snd hp) hw hr

end
end Triality.Standard.ConcreteBruhat.SplitNormalForm.CellSeparation
