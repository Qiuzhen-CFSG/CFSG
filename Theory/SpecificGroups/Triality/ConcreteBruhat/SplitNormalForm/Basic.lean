module

public import Theory.SpecificGroups.Triality.ConcreteBruhat.SplitNormalForm.RankOne

/-!
# Cells and original parabolic generators for split D4

Proposed normal forms lie in their indicated Borel double cosets. The identity
cell already has a unique normal form by the disjoint positive/torus
factorization. Pinned rank-one conjugation identifies the original parabolic
generators with the images of the corresponding root Weyl subgroup.

This supplies the base case and the generator boundary for the remaining
collection and separation arguments. Source: GLS3 2.3.5 and Definition 2.6.4,
`refs/KGroup/GLS3/chapter2.tex`.
-/

@[expose] public section
noncomputable section
namespace Triality.Standard.ConcreteBruhat.SplitNormalForm
open Parabolics

theorem supported_one_iff (P : Parameters) (a : PositiveCoordinates.Coordinates P) :
    Supported P 1 a ↔ a = fun _ => 0 := by
  constructor
  · intro ha
    funext i
    exact ha i (PositiveCoordinates.rootIndex_positive i)
  · rintro rfl i _
    rfl

@[simp] theorem cell_one {P : Parameters} (D : Inputs P) :
    cell D 1 = (splitBorel P : Set (SplitGroup P)) := by
  ext g
  constructor
  · rintro ⟨b₁, hb₁, b₂, hb₂, rfl⟩
    change b₁ * D.lift 1 * b₂ ∈ splitBorel P
    rw [map_one, mul_one]
    exact (splitBorel P).mul_mem hb₁ hb₂
  · intro hg
    exact ⟨g, hg, 1, (splitBorel P).one_mem, by simp only [map_one, mul_one]⟩

theorem evaluate_mem_cell (n : ℕ) (hn : 0 < n) (D : Inputs (binaryParameters n hn))
    (a : Coordinates (binaryParameters n hn)) : evaluate D a ∈ cell D a.weyl := by
  refine ⟨a.left.val * a.torus.val,
    (splitBorel _).mul_mem (Subgroup.mem_sup_left a.left.property)
      (splitTorus_le_splitBorel _ a.torus.property),
    PositiveCoordinates.orderedProduct _ a.right, ?_, rfl⟩
  apply (show positiveSubgroup (binaryParameters n hn) ≤ splitBorel _ from le_sup_left)
  change PositiveCoordinates.orderedProduct (binaryParameters n hn) a.right ∈
    (positiveSubgroup (binaryParameters n hn) : Set (SplitGroup (binaryParameters n hn)))
  rw [← PositiveCoordinates.range_orderedProduct_binary n hn]
  exact Set.mem_range_self a.right

/-- The identity-Weyl coordinates are exactly a positive and a torus factor. -/
def identityCoordinates (P : Parameters) (a : positiveSubgroup P × splitTorus P) :
    Coordinates P where
  left := a.1
  torus := a.2
  weyl := 1
  right := fun _ => 0
  supported := (supported_one_iff _ _).mpr rfl

@[simp] theorem evaluate_identityCoordinates {P : Parameters} (D : Inputs P)
    (a : positiveSubgroup P × splitTorus P) :
    evaluate D (identityCoordinates P a) = a.1.val * a.2.val := by
  simp only [evaluate, identityCoordinates, map_one, PositiveCoordinates.orderedProduct_zero,
    mul_one]

theorem eq_identityCoordinates_of_weyl_eq_one {P : Parameters} (a : Coordinates P)
    (hw : a.weyl = 1) : a = identityCoordinates P (a.left, a.torus) := by
  have hv := a.supported
  rw [hw, supported_one_iff] at hv
  exact Coordinates.ext rfl rfl hw hv

/-- Uniqueness of the proposed coordinates in the identity cell. -/
theorem identity_coordinates_injective {P : Parameters} (D : Inputs P)
    {a b : Coordinates P} (ha : a.weyl = 1) (hb : b.weyl = 1)
    (hab : evaluate D a = evaluate D b) : a = b := by
  have hea := eq_identityCoordinates_of_weyl_eq_one a ha
  have heb := eq_identityCoordinates_of_weyl_eq_one b hb
  have ha' : evaluate D a = a.left.val * a.torus.val :=
    (congrArg (evaluate D) hea).trans (evaluate_identityCoordinates D _)
  have hb' : evaluate D b = b.left.val * b.torus.val :=
    (congrArg (evaluate D) heb).trans (evaluate_identityCoordinates D _)
  have hp : (a.left, a.torus) = (b.left, b.torus) :=
    Subgroup.mul_injective_of_disjoint D.positive_disjoint_torus
      (ha'.symm.trans (hab.trans hb'))
  exact hea.trans ((congrArg (identityCoordinates P) hp).trans heb.symm)

/-- Every original Borel element has exactly one identity-Weyl normal form. -/
theorem existsUnique_identity_coordinates {P : Parameters} (D : Inputs P)
    (g : splitBorel P) : ∃! a : Coordinates P, a.weyl = 1 ∧ evaluate D a = g.val := by
  obtain ⟨p, hp, _⟩ := D.existsUnique_borel_factors g
  refine ⟨identityCoordinates P p, ⟨rfl, ?_⟩, ?_⟩
  · simpa only [evaluate_identityCoordinates] using hp
  · intro a ha
    apply identity_coordinates_injective D ha.1 rfl
    rw [ha.2, evaluate_identityCoordinates, hp]

theorem map_parabolicWeyl {P : Parameters} (D : Inputs P) (a : Node) :
    (parabolicWeyl a).map D.lift =
      Subgroup.closure {g | ∃ i ∈ a.support, g = weylWord P i 1} := by
  rw [parabolicWeyl, MonoidHom.map_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨w, ⟨i, hi, rfl⟩, rfl⟩
    exact ⟨i, hi, D.lift_simple i⟩
  · rintro ⟨i, hi, rfl⟩
    exact ⟨rootWeylGenerator i, ⟨i, hi, rfl⟩, D.lift_simple i⟩

/-- The original split parabolic is generated by the Borel and precisely its
marked root Weyl subgroup. Cell saturation remains to be proved. -/
theorem splitParabolic_eq_borel_sup_map (P : Parameters) (hp : P.prime = 2)
    (D : Inputs P) (a : Node) :
    splitParabolic P a = splitBorel P ⊔ (parabolicWeyl a).map D.lift := by
  rw [map_parabolicWeyl, splitParabolic_eq_borel_sup_weyl P hp a]

/-- The easy direction of parabolic cell coverage, on the original subgroup. -/
theorem cell_subset_splitParabolic (P : Parameters) (hp : P.prime = 2)
    (D : Inputs P) (a : Node) {w : rootWeylGroup} (hw : w ∈ parabolicWeyl a) :
    cell D w ⊆ splitParabolic P a := by
  rintro g ⟨b₁, hb₁, b₂, hb₂, rfl⟩
  have hlift : D.lift w ∈ splitParabolic P a := by
    rw [splitParabolic_eq_borel_sup_map P hp D a]
    exact Subgroup.mem_sup_right ⟨w, hw, rfl⟩
  exact (splitParabolic P a).mul_mem
    ((splitParabolic P a).mul_mem (Subgroup.mem_sup_left hb₁) hlift)
    (Subgroup.mem_sup_left hb₂)

end Triality.Standard.ConcreteBruhat.SplitNormalForm
