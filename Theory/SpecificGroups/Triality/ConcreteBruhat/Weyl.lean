module

public import Theory.SpecificGroups.Triality.ConcreteBruhat.Weyl.Basic
public import Theory.SpecificGroups.Triality.ConcreteBruhat.Weyl.FoldedRealization
public import Theory.SpecificGroups.Triality.ConcreteBruhat.Weyl.Conjugation
public import Theory.SpecificGroups.Triality.ElementaryCentralKernel

/-!
# The concrete split and folded triality Weyl groups

The actual split Geck Weyl subgroup is the literal D₄ reflection group; the
identification respects graph-field action, conjugates all canonical integral
root curves, and normalizes the original coroot-word torus. Its fixed subgroup
is exactly the twelve-element dihedral group through the published words.

The elementary group embeds into the split matrix group and, in characteristic
two, into its own central quotient. Transport through these actual injections
proves that the published carrier words are multiplicative and faithful. They
exhaust the subgroup generated by the two folded simple representatives, whose
product has order six. The normalizer-quotient and Tits-system assembly belongs
to the Bruhat development.

Source: the central-kernel convention of GLS3 §2.2 and Weyl identification of
§§2.3–2.4 (`refs/KGroup/GLS3/chapter2.tex`). Includes q = 2.
-/

@[expose] public section

namespace Triality.Standard.ConcreteBruhat
open Parabolics
open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
noncomputable section

private theorem elementaryInclusion_injective (P : Parameters) :
    Function.Injective (elementaryInclusion P) :=
  fun _ _ h => Subtype.ext (Subtype.ext h)

private theorem elementary_eq_iff (P : Parameters) (hp : P.prime = 2)
    (x y : ElementaryGroup P) :
    toCarrier P x = toCarrier P y ↔ elementaryInclusion P x = elementaryInclusion P y :=
  (ElementaryCentralKernel.toCarrier_injective P hp).eq_iff.trans
    (elementaryInclusion_injective P).eq_iff.symm

/-- Equality of the published carrier words is exactly equality of their split matrices. -/
theorem weylRepresentative_eq_iff_split (P : Parameters) (hp : P.prime = 2)
    (v w : DihedralGroup 6) :
    weylRepresentative P hp v = weylRepresentative P hp w ↔
      splitRepresentative P hp v = splitRepresentative P hp w :=
  elementary_eq_iff P hp (weylElementary P hp v) (weylElementary P hp w)

/-- Descent introduces no extra relation in a product of the published words. -/
theorem weylRepresentative_mul_iff_split (P : Parameters) (hp : P.prime = 2)
    (v w : DihedralGroup 6) :
    weylRepresentative P hp (v * w) = weylRepresentative P hp v * weylRepresentative P hp w ↔
      splitRepresentative P hp (v * w) = splitRepresentative P hp v * splitRepresentative P hp w := by
  exact (congrArg₂ (· = ·) rfl
    (map_mul (toCarrier P) (weylElementary P hp v) (weylElementary P hp w)).symm).to_iff.trans
    ((elementary_eq_iff P hp (weylElementary P hp (v * w))
      (weylElementary P hp v * weylElementary P hp w)).trans
        (congrArg₂ (· = ·) rfl
          (map_mul (elementaryInclusion P) (weylElementary P hp v)
            (weylElementary P hp w))).to_iff)

/-- Faithfulness may be proved on the split matrices before the central quotient. -/
theorem weylRepresentative_injective_iff_split (P : Parameters) (hp : P.prime = 2) :
    Function.Injective (weylRepresentative P hp) ↔
      Function.Injective (splitRepresentative P hp) := by
  constructor
  · intro h v w hvw
    exact h ((weylRepresentative_eq_iff_split P hp v w).mpr hvw)
  · intro h v w hvw
    exact h ((weylRepresentative_eq_iff_split P hp v w).mp hvw)

/-- The actual central quotient preserves the order of every published word. -/
theorem orderOf_weylRepresentative_eq_split (P : Parameters) (hp : P.prime = 2)
    (w : DihedralGroup 6) :
    orderOf (weylRepresentative P hp w) = orderOf (splitRepresentative P hp w) := by
  exact (orderOf_injective (toCarrier P) (ElementaryCentralKernel.toCarrier_injective P hp) _).trans
    (orderOf_injective (elementaryInclusion P) (elementaryInclusion_injective P) _).symm

/-- In particular the product of the two folded simple reflections keeps its order. -/
theorem orderOf_simpleProduct_eq_split (P : Parameters) (hp : P.prime = 2) :
    orderOf (simpleRepresentative P hp .arms * simpleRepresentative P hp .central) =
      orderOf (weylWord P 0 1 * weylWord P 2 1 * weylWord P 3 1 * weylWord P 1 1) := by
  have h := (orderOf_injective (toCarrier P)
    (ElementaryCentralKernel.toCarrier_injective P hp)
    (simpleElementary P hp .arms * simpleElementary P hp .central)).trans
    (orderOf_injective (elementaryInclusion P) (elementaryInclusion_injective P)
      (simpleElementary P hp .arms * simpleElementary P hp .central)).symm
  simpa only [map_mul, elementaryInclusion_simple_arms, elementaryInclusion_simple_central,
    simpleRepresentative] using h


/-- The published representatives are multiplicative in the actual central quotient. -/
theorem weylRepresentative_mul (P : Parameters) (hp : P.prime = 2)
    (v w : DihedralGroup 6) :
    weylRepresentative P hp (v * w) = weylRepresentative P hp v * weylRepresentative P hp w :=
  (weylRepresentative_mul_iff_split P hp v w).mpr (splitRepresentative_mul P hp v w)

/-- The central quotient is faithful on the published Weyl words. -/
theorem weylRepresentative_injective (P : Parameters) (hp : P.prime = 2) :
    Function.Injective (weylRepresentative P hp) :=
  (weylRepresentative_injective_iff_split P hp).mpr (splitRepresentative_injective P hp)

/-- The original carrier representatives, now equipped with their multiplication law. -/
def weylRepresentativeHom (P : Parameters) (hp : P.prime = 2) :
    DihedralGroup 6 →* Carrier P where
  toFun := weylRepresentative P hp
  map_one' := weylRepresentative_one P hp
  map_mul' := weylRepresentative_mul P hp

@[simp] theorem weylRepresentativeHom_apply (P : Parameters) (hp : P.prime = 2)
    (w : DihedralGroup 6) : weylRepresentativeHom P hp w = weylRepresentative P hp w := rfl

/-- All element orders survive passage from the dihedral group to the carrier. -/
theorem orderOf_weylRepresentative (P : Parameters) (hp : P.prime = 2)
    (w : DihedralGroup 6) : orderOf (weylRepresentative P hp w) = orderOf w :=
  (orderOf_weylRepresentative_eq_split P hp w).trans (orderOf_splitRepresentative P hp w)

/-- The two actual folded simple representatives have product of order six. -/
theorem orderOf_simpleProduct (P : Parameters) (hp : P.prime = 2) :
    orderOf (simpleRepresentative P hp .arms * simpleRepresentative P hp .central) = 6 :=
  (orderOf_simpleProduct_eq_split P hp).trans (orderOf_splitSimpleProduct P hp)

/-- The image consists of the entire subgroup generated by the two published simple words. -/
theorem weylRepresentativeHom_range (P : Parameters) (hp : P.prime = 2) :
    (weylRepresentativeHom P hp).range =
      Subgroup.closure (Set.range (simpleRepresentative P hp)) := by
  apply le_antisymm
  · rintro x ⟨w, rfl⟩
    let H := Subgroup.closure (Set.range (simpleRepresentative P hp))
    have ha : simpleRepresentative P hp .arms ∈ H :=
      Subgroup.subset_closure (Set.mem_range_self _)
    have hc : simpleRepresentative P hp .central ∈ H :=
      Subgroup.subset_closure (Set.mem_range_self _)
    cases w with
    | r i =>
      simpa only [weylRepresentativeHom_apply, weylRepresentative, weylElementary,
        map_pow, map_mul, simpleRepresentative] using H.pow_mem (H.mul_mem ha hc) i.val
    | sr i =>
      simpa only [weylRepresentativeHom_apply, weylRepresentative, weylElementary,
        map_pow, map_mul, simpleRepresentative] using
        H.mul_mem ha (H.pow_mem (H.mul_mem ha hc) i.val)
  · apply (Subgroup.closure_le _).mpr
    rintro x ⟨a, rfl⟩
    exact ⟨relativeReflection a, weylRepresentative_simple P hp a⟩

/-- The relative Weyl subgroup of the carrier, on its original simple generators. -/
def weylDihedralEquiv (P : Parameters) (hp : P.prime = 2) :
    DihedralGroup 6 ≃* Subgroup.closure (Set.range (simpleRepresentative P hp)) :=
  (MonoidHom.ofInjective (f := weylRepresentativeHom P hp)
    (weylRepresentative_injective P hp)).trans
      (MulEquiv.subgroupCongr (weylRepresentativeHom_range P hp))

@[simp] theorem weylDihedralEquiv_val (P : Parameters) (hp : P.prime = 2)
    (w : DihedralGroup 6) :
    (weylDihedralEquiv P hp w).val = weylRepresentative P hp w := rfl

@[simp] theorem weylDihedralEquiv_sr_zero (P : Parameters) (hp : P.prime = 2) :
    (weylDihedralEquiv P hp (.sr 0)).val = simpleRepresentative P hp .arms :=
  weylRepresentative_simple P hp .arms

@[simp] theorem weylDihedralEquiv_sr_one (P : Parameters) (hp : P.prime = 2) :
    (weylDihedralEquiv P hp (.sr 1)).val = simpleRepresentative P hp .central :=
  weylRepresentative_simple P hp .central

/-- The actual relative Weyl subgroup in the carrier has order twelve. -/
theorem relativeWeylSubgroup_card (P : Parameters) (hp : P.prime = 2) :
    Nat.card (Subgroup.closure (Set.range (simpleRepresentative P hp))) = 12 := by
  rw [← Nat.card_congr (weylDihedralEquiv P hp).toEquiv, DihedralGroup.nat_card]


/-- Conjugation by a published folded word has its exact published root action,
for every positive or negative canonical root and every extension-field parameter. -/
theorem splitRepresentative_rootCurveUnit_conjugation (P : Parameters) (hp : P.prime = 2)
    (w : DihedralGroup 6) (r : TypeDRootIndex 4) (t : ExtensionField P) :
    (splitRepresentative P hp w).val *
        rootCurveUnit (integralChevalleyRootOperators (b := typeDRootPairing_base 2)) r t *
        (splitRepresentative P hp w).val⁻¹ =
      rootCurveUnit (integralChevalleyRootOperators (b := typeDRootPairing_base 2))
        ((rootRepresentative w).val r) t :=
  (splitWeyl_rootCurveUnit_conjugation P hp (fixedSplitRepresentative P hp w).val r t).trans
    (congrArg (fun v : rootWeylGroup =>
      rootCurveUnit (integralChevalleyRootOperators (b := typeDRootPairing_base 2))
        (v.val r) t) (splitWeylEquiv_representative P hp w))

/-- Each published folded word normalizes the original split coroot torus. -/
theorem splitRepresentative_mem_normalizer_splitTorus (P : Parameters) (hp : P.prime = 2)
    (w : DihedralGroup 6) : splitRepresentative P hp w ∈ Subgroup.normalizer (splitTorus P) :=
  splitWeylSubgroup_le_normalizer_splitTorus P hp (splitRepresentative_mem P hp w)

end
end Triality.Standard.ConcreteBruhat
