module

public import Theory.SpecificGroups.Triality.ConcreteBruhat.Torus.Diagonal.CorootWords

/-!
# Faithful multiplicative coordinates on the split triality torus

The original four coroot words are the integral-weight diagonals on the actual
Geck lattice. Diagonal multiplication proves multiplicativity and commutation.
For an element in the coordinate kernel, the simple-root entries say that the
three arm parameters have the same square, equal to the central parameter.
Square injectivity in characteristic two identifies all three arms; the central
root entry then forces their common value to be one. This proves faithfulness
also when q = 2. Each coroot generator is a single-coordinate product, so the
image is exactly the original subgroup generated by these words.

The resulting `product_mul`, `product_injective`, and `range_product` supply
the explicit matrix inputs of `Torus.Count` and `Torus.FixedWords`.

Source: the adjoint kernel criterion of GLS3 1.12.1(f)(2) and the torus
construction in §§2.3–2.4 (`refs/KGroup/GLS3/Chapter1.tex` and
`refs/KGroup/GLS3/chapter2.tex`). All identities use the code's original
n(t)n(-1) convention, computed in `Diagonal.CorootWords`.
-/

@[expose] public section

open Matrix
open Theory.AlgebraicGroup.StandardRootSystem
namespace Triality.Standard.ConcreteBruhat.TorusCoordinates
open Parabolics Parabolics.RankOneMatrices
noncomputable section
local instance : DecidableEq LatticeIndex := fun a b => instDecidableEqSum a b

/-- Simple-root weights are the entries of the original D₄ Cartan matrix. -/
lemma corootWeight_simple (i j : Fin 4) :
    corootWeight i (.inr (typeDSimpleRootIndex 2 j)) = typeDCartanMatrix 2 j i :=
  typeDRootPairing_base_cartanMatrix 2 j i

lemma torusWord_one (P : Parameters) (hp : P.prime = 2) (i : Fin 4) :
    torusWord P i 1 = 1 := by
  apply Subtype.ext
  apply Units.ext
  rw [torusWord_val P hp]
  simp [corootDiagonal]

lemma torusWord_mul (P : Parameters) (hp : P.prime = 2) (i : Fin 4)
    (t u : (ExtensionField P)ˣ) :
    torusWord P i (t * u) = torusWord P i t * torusWord P i u := by
  apply Subtype.ext
  apply Units.ext
  change (torusWord P i (t * u)).val.val =
    (torusWord P i t).val.val * (torusWord P i u).val.val
  simp only [torusWord_val P hp, corootDiagonal, Matrix.diagonal_mul_diagonal,
    Units.val_mul, mul_zpow]

lemma torusWord_commute (P : Parameters) (hp : P.prime = 2) (i j : Fin 4)
    (t u : (ExtensionField P)ˣ) : Commute (torusWord P i t) (torusWord P j u) := by
  apply Subtype.ext
  apply Units.ext
  change (torusWord P i t).val.val * (torusWord P j u).val.val =
    (torusWord P j u).val.val * (torusWord P i t).val.val
  rw [torusWord_val P hp, torusWord_val P hp]
  exact (Matrix.commute_diagonal _ _).eq

/-- The entire matrix of the four-word product. -/
lemma product_val (P : Parameters) (hp : P.prime = 2) (a : Coordinates P) :
    (product P a).val.val = Matrix.diagonal (fun r =>
      (a 0).val ^ corootWeight 0 r * (a 2).val ^ corootWeight 2 r *
      (a 3).val ^ corootWeight 3 r * (a 1).val ^ corootWeight 1 r) := by
  change (torusWord P 0 (a 0)).val.val * (torusWord P 2 (a 2)).val.val *
    (torusWord P 3 (a 3)).val.val * (torusWord P 1 (a 1)).val.val = _
  simp only [torusWord_val P hp, corootDiagonal, Matrix.diagonal_mul_diagonal]

/-- The original ordered product is multiplicative in its four unit parameters. -/
lemma product_mul (P : Parameters) (hp : P.prime = 2) (a b : Coordinates P) :
    product P (a * b) = product P a * product P b := by
  apply Subtype.ext
  apply Units.ext
  change (product P (a * b)).val.val = (product P a).val.val * (product P b).val.val
  simp only [product_val P hp, Matrix.diagonal_mul_diagonal, Pi.mul_apply,
    Units.val_mul, mul_zpow]
  congr 1
  funext r
  ring

lemma product_one (P : Parameters) (hp : P.prime = 2) : product P 1 = 1 := by
  simp [product, torusWord_one P hp]

/-- Coroot-coordinate multiplication as a homomorphism into the actual split group. -/
def productHom (P : Parameters) (hp : P.prime = 2) : Coordinates P →* SplitGroup P where
  toFun := product P
  map_one' := product_one P hp
  map_mul' := product_mul P hp

/-- The actual coroot-coordinate kernel is trivial in characteristic two. -/
lemma product_eq_one_iff (P : Parameters) (hp : P.prime = 2) (a : Coordinates P) :
    product P a = 1 ↔ a = 1 := by
  constructor
  · intro ha
    let := rankOneExtensionCharTwo P hp
    have h (j : Fin 4) := congrArg (fun g : SplitGroup P =>
      g.val.val (.inr (typeDSimpleRootIndex 2 j)) (.inr (typeDSimpleRootIndex 2 j))) ha
    simp only [product_val P hp, Matrix.diagonal_apply_eq, corootWeight_simple] at h
    have h0 : (a 0).val ^ 2 = (a 1).val := by
      apply (div_eq_one_iff_eq (a 1).ne_zero).mp
      simpa [typeDCartanMatrix, div_eq_mul_inv] using h 0
    have h2 : (a 2).val ^ 2 = (a 1).val := by
      apply (div_eq_one_iff_eq (a 1).ne_zero).mp
      simpa [typeDCartanMatrix, div_eq_mul_inv] using h 2
    have h3 : (a 3).val ^ 2 = (a 1).val := by
      apply (div_eq_one_iff_eq (a 1).ne_zero).mp
      simpa [typeDCartanMatrix, div_eq_mul_inv] using h 3
    have h02 : (a 0).val = (a 2).val := CharTwo.sq_injective (h0.trans h2.symm)
    have h03 : (a 0).val = (a 3).val := CharTwo.sq_injective (h0.trans h3.symm)
    have hc : (a 0).val⁻¹ * (a 0).val⁻¹ * (a 0).val⁻¹ * ((a 0).val ^ 2) ^ 2 = 1 := by
      simpa [typeDCartanMatrix, ← h0, ← h02, ← h03] using h 1
    have hred (t : (ExtensionField P)ˣ) :
        t.val⁻¹ * t.val⁻¹ * t.val⁻¹ * (t.val ^ 2) ^ 2 = t.val := by
      field_simp
    rw [hred] at hc
    have h1 : (a 1).val = 1 := by rw [← h0, hc]; simp
    funext j
    apply Units.ext
    fin_cases j
    · exact hc
    · exact h1
    · exact h02.symm.trans hc
    · exact h03.symm.trans hc
  · rintro rfl
    exact product_one P hp

/-- Faithfulness includes every binary parameter, including exponent one. -/
lemma product_injective (P : Parameters) (hp : P.prime = 2) :
    Function.Injective (product P) := by
  exact (injective_iff_map_eq_one (productHom P hp)).mpr
    (fun a ha => (product_eq_one_iff P hp a).mp ha)

lemma product_single (P : Parameters) (hp : P.prime = 2)
    (i : Fin 4) (t : (ExtensionField P)ˣ) :
    product P (Function.update 1 i t) = torusWord P i t := by
  fin_cases i <;> simp [product, torusWord_one P hp]

/-- The image is the originally defined subgroup generated by the coroot words. -/
lemma range_product (P : Parameters) (hp : P.prime = 2) :
    Set.range (product P) = (splitTorus P : Set (SplitGroup P)) := by
  apply Set.Subset.antisymm
  · rintro _ ⟨a, rfl⟩
    exact product_mem P a
  · change splitTorus P ≤ (productHom P hp).range
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, t, rfl⟩
    exact ⟨Function.update 1 i t, product_single P hp i t⟩

/-- The faithful coroot coordinates identify the actual generated split torus. -/
def splitTorusMulEquiv (P : Parameters) (hp : P.prime = 2) :
    Coordinates P ≃* splitTorus P :=
  MulEquiv.ofBijective ((productHom P hp).codRestrict (splitTorus P) (product_mem P)) (by
    constructor
    · intro a b h
      exact product_injective P hp (congrArg Subtype.val h)
    · intro t
      have ht : t.val ∈ Set.range (product P) := by
        rw [range_product P hp]
        exact t.property
      obtain ⟨a, ha⟩ := ht
      exact ⟨a, Subtype.ext ha⟩)

@[simp] lemma splitTorusMulEquiv_val (P : Parameters) (hp : P.prime = 2)
    (a : Coordinates P) : (splitTorusMulEquiv P hp a).val = product P a := rfl

end
end Triality.Standard.ConcreteBruhat.TorusCoordinates
