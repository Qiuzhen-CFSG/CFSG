module

public import Theory.SpecificGroups.Triality.ConcreteBruhat.Candidates
public import Theory.SpecificGroups.Triality.ConcreteBruhat.FixedDescent
public import Theory.SpecificGroups.Triality.ConcreteBruhat.RelativeNormalizer
public import Theory.SpecificGroups.Triality.ConcreteBruhat.Tits
public import Theory.SpecificGroups.Triality.ConcreteBruhat.FixedCellCount
public import Theory.AlgebraicGroup.BNPair.StandardParabolicCore

/-!
# Concrete binary triality Bruhat geometry

The actual folded Geck root words yield a Tits system on the original
triality carrier, whose Borel is exactly the original descended Borel. Its
relative Weyl group is dihedral of order twelve, generated by the distinct
three-arm and central reflections. The imported fixed normal form identifies
its cells with the graph-field fixed split cells.

The two-cell root-parabolic coverage identifies each original parabolic with
its singleton standard parabolic, using the abstract standard-parabolic API.
The same coverage shows that adjoining its negative folded roots to the Borel
generates the parabolic; these generators have characteristic-power order.
Finally the actual fixed-cell count and torus order give the global odd index
of the unipotent subgroup. All results include q = 2.

The earlier conditional assembly lemmas retain their interfaces below; every
extra premise is discharged in the unconditional conclusions at the end.

Sources: GLS3 2.3.4–8 and 2.6.4–8 (`refs/KGroup/GLS3/chapter2.tex`);
Aschbacher–Smith F.1.4–12 (`refs/quasithin.pdf`).
-/

public section
noncomputable section
namespace Triality.Standard.ConcreteBruhat
open Parabolics
open Theory.AlgebraicGroup

/-- Two-cell coverage is enough to prove generation by the actual negative
folded roots; their characteristic-power identities are unconditional. -/
theorem negativeGenerators_generate_of_cell_cover (P : Parameters) (hp : P.prime = 2)
    (a : Node)
    (hcover : ∀ g ∈ parabolic P a,
      g ∈ borel P ∨ g ∈ cell P hp (relativeReflection a)) :
    borel P ⊔ Subgroup.closure (negativeGenerators P hp a) = parabolic P a := by
  apply le_antisymm (borel_sup_negativeGenerators_le P hp a)
  rw [borel_sup_negativeGenerators_eq]
  intro g hg
  rcases hcover g hg with hb | hc
  · exact Subgroup.mem_sup_left hb
  · obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := (mem_cell_iff P hp _ g).mp hc
    rw [weylRepresentative_simple]
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _ (Subgroup.mem_sup_left hb₁)
        (Subgroup.mem_sup_right (Subgroup.subset_closure (Set.mem_singleton _))))
      (Subgroup.mem_sup_left hb₂)

/-- The exact generator contract consumed by the local-factor supplementation
lemma, with two-cell geometric coverage as its input. -/
theorem exists_characteristic_power_generators_of_cell_cover
    (P : Parameters) (hp : P.prime = 2) (a : Node)
    (hcover : ∀ g ∈ parabolic P a,
      g ∈ borel P ∨ g ∈ cell P hp (relativeReflection a)) :
    ∃ s : Set (Carrier P), borel P ⊔ Subgroup.closure s = parabolic P a ∧
      ∀ g ∈ s, ∃ k : ℕ, g ^ (P.prime ^ k) = 1 :=
  ⟨negativeGenerators P hp a, negativeGenerators_generate_of_cell_cover P hp a hcover,
    negativeGenerators_characteristic_power P hp a⟩

private theorem standardParabolic_singleton_eq_sup {G : Type*} [Group G]
    (T : TitsSystem (X := G)) (n : T.N) :
    T.standardParabolic {QuotientGroup.mk' ((T.B ⊓ T.N).subgroupOf T.N) n} =
      T.B ⊔ Subgroup.closure {(n : G)} := by
  let s := QuotientGroup.mk' ((T.B ⊓ T.N).subgroupOf T.N) n
  have hncell : (n : G) ∈ T.bruhatCell s := T.representative_mem_bruhatCell s n rfl
  apply le_antisymm
  · apply T.standardParabolic_le _ le_sup_left
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst t
    exact T.bruhatCell_subset_of_mem _ le_sup_left hncell
      (Subgroup.mem_sup_right (Subgroup.subset_closure (Set.mem_singleton _)))
  · apply sup_le (T.B_le_standardParabolic _)
    apply (Subgroup.closure_le _).mpr
    intro g hg
    rw [Set.mem_singleton_iff] at hg
    subst g
    exact T.bruhatCell_subset_standardParabolic_of_mem (Set.mem_singleton s) hncell

/-- A compatible Tits system and two-cell coverage identify the root parabolic
with its singleton standard parabolic. -/
theorem parabolic_eq_standardParabolic_of_cell_cover
    (P : Parameters) (hp : P.prime = 2) (a : Node)
    (T : TitsSystem (X := Carrier P)) (hB : T.B = borel P)
    (n : T.N) (hn : (n : Carrier P) = simpleRepresentative P hp a)
    (hcover : ∀ g ∈ parabolic P a,
      g ∈ borel P ∨ g ∈ cell P hp (relativeReflection a)) :
    parabolic P a =
      T.standardParabolic {QuotientGroup.mk' ((T.B ⊓ T.N).subgroupOf T.N) n} := by
  rw [standardParabolic_singleton_eq_sup, hB, hn,
    ← borel_sup_negativeGenerators_eq]
  exact (negativeGenerators_generate_of_cell_cover P hp a hcover).symm

/-- The actual negative folded roots generate the original root parabolic over
its Borel, with no remaining coverage assumption. -/
theorem negativeGenerators_generate (P : Parameters) (hp : P.prime = 2) (a : Node) :
    borel P ⊔ Subgroup.closure (negativeGenerators P hp a) = parabolic P a := by
  obtain ⟨n, hn, rfl⟩ := (exists_binaryParameters_iff P).mpr hp
  exact negativeGenerators_generate_of_cell_cover _ rfl a
    (FoldedCellGeometry.parabolic_cell_cover n hn a)

/-- Unconditional generator input for the parent's local-factor supplementation
argument. The witnesses are the actual negative folded root elements. -/
theorem exists_characteristic_power_generators
    (P : Parameters) (hp : P.prime = 2) (a : Node) :
    ∃ s : Set (Carrier P), borel P ⊔ Subgroup.closure s = parabolic P a ∧
      ∀ g ∈ s, ∃ k : ℕ, g ^ (P.prime ^ k) = 1 :=
  ⟨negativeGenerators P hp a, negativeGenerators_generate P hp a,
    negativeGenerators_characteristic_power P hp a⟩

/-- The original arm and central root parabolics are exactly the singleton
standard parabolics of the constructed Tits system. -/
theorem parabolic_eq_standardParabolic (n : ℕ) (hn : 0 < n) (a : Node) :
    parabolic (binaryParameters n hn) a =
      (titsSystem n hn).standardParabolic {simpleReflection n hn a} := by
  rw [simpleReflection_eq_mk n hn a]
  exact parabolic_eq_standardParabolic_of_cell_cover _ rfl a (titsSystem n hn) rfl
    ⟨simpleRepresentative _ rfl a, simpleRepresentative_mem_normalizer _ rfl a⟩ rfl
    (FoldedCellGeometry.parabolic_cell_cover n hn a)

/-- The global unipotent index follows from the actual Borel cells and torus,
without a group-order or Sylow hypothesis. -/
theorem unipotent_index (P : Parameters) (hp : P.prime = 2) :
    (unipotent P).index = ((P.q ^ 3 - 1) * (P.q - 1)) *
      ((P.q ^ 3 + 1) * (P.q + 1) * (P.q ^ 8 + P.q ^ 4 + 1)) := by
  rw [← Subgroup.relIndex_mul_index (unipotent_le_borel P), borel_relIndex P hp,
    FixedCellCount.borel_index_of_char_two P hp]

/-- The counted Borel index is odd in characteristic two. -/
theorem odd_borel_index (P : Parameters) (hp : P.prime = 2) :
    Odd (borel P).index := by
  rw [FixedCellCount.borel_index_of_char_two P hp]
  have hq : Even P.q := by
    rw [Parameters.q, hp]
    exact (show Even (2 : ℕ) by decide).pow_of_ne_zero (Nat.ne_of_gt P.exponent_pos)
  exact ((hq.pow_of_ne_zero (by decide)).add_one.mul hq.add_one).mul
    (((hq.pow_of_ne_zero (by decide)).add (hq.pow_of_ne_zero (by decide))).add_one)

/-- The genuine unipotent subgroup has odd index in the original carrier. -/
theorem odd_unipotent_index (P : Parameters) (hp : P.prime = 2) :
    Odd (unipotent P).index := by
  rw [← Subgroup.relIndex_mul_index (unipotent_le_borel P)]
  exact (odd_borel_relIndex P hp).mul (odd_borel_index P hp)

/-- The smallest parameter is covered by the same root and Bruhat calculation. -/
theorem unipotent_index_two :
    (unipotent (binaryParameters 1 (by decide))).index = 51597 := by
  rw [unipotent_index _ rfl]
  norm_num [binaryParameters_q]

end Triality.Standard.ConcreteBruhat
