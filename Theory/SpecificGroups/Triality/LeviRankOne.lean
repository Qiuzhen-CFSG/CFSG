module
public import Theory.SpecificGroups.Triality.ParabolicLocalDefinitions
public import Theory.SpecificGroups.Triality.LeviFields

/-!
# Pinning and generation for triality rank-one maps

The interfaces below specify faithful SL₂ maps taking the two elementary
transvections to the genuine positive and negative simple Geck curves, and
commutation of the curves on distinct arms. These matrix facts are explicit
inputs, not assumed instances or source-theorem conclusions.

Transvection induction proves exact range, graph-field equivariance, and
commutation of the full arm images from those inputs. Thus no separate
fixed-point or Levi identification is hidden in the interface.

Source: GLS3 §§2.4 and 2.6, particularly the subsystem argument in 2.6.2
(`refs/KGroup/GLS3/chapter2.tex`).
-/

@[expose] public section
noncomputable section
open Matrix
open scoped MatrixGroups
open Theory.AlgebraicGroup.StandardRootSystem
namespace Triality.Standard.Parabolics

/-- Pinned rank-one maps into the genuine split D4 group. The positive and
negative transvections must map to the specified Geck curves. This interface
contains no Levi identification or graph-field fixed-point assertion. -/
structure PinnedRankOneMaps (P : Parameters) where
  hom : Fin 4 → SL(2, ExtensionField P) →* SplitGroup P
  injective : ∀ i, Function.Injective (hom i)
  positive : ∀ i t, hom i (SpecialLinearGroup.transvection (i := (0 : Fin 2))
    (j := 1) (by decide) t) = positiveRoot P i t
  negative : ∀ i t, hom i (SpecialLinearGroup.transvection (i := (1 : Fin 2))
    (j := 0) (by decide) t) = negativeRoot P i t

/-- The three curve commutations needed for the pairwise orthogonal arms.
The reversed mixed-sign relation follows by symmetry. -/
structure ArmRootCommutation (P : Parameters) : Prop where
  positive_positive : ∀ i j : Fin 4, i ≠ 1 → j ≠ 1 → i ≠ j →
    ∀ t u, Commute (positiveRoot P i t) (positiveRoot P j u)
  positive_negative : ∀ i j : Fin 4, i ≠ 1 → j ≠ 1 → i ≠ j →
    ∀ t u, Commute (positiveRoot P i t) (negativeRoot P j u)
  negative_negative : ∀ i j : Fin 4, i ≠ 1 → j ≠ 1 → i ≠ j →
    ∀ t u, Commute (negativeRoot P i t) (negativeRoot P j u)

/-- SL₂ generation with the two specified transvection directions. -/
theorem sl2_root_induction {F : Type*} [Field F] (Q : SL(2, F) → Prop)
    (hpos : ∀ t, Q (SpecialLinearGroup.transvection (i := (0 : Fin 2))
      (j := 1) (by decide) t))
    (hneg : ∀ t, Q (SpecialLinearGroup.transvection (i := (1 : Fin 2))
      (j := 0) (by decide) t))
    (hmul : ∀ g h, Q g → Q h → Q (g * h)) (g : SL(2, F)) : Q g := by
  apply Matrix.SL2.transvection_induction Q ?_ hmul g
  intro i j hij t
  fin_cases i <;> fin_cases j
  · exact (hij rfl).elim
  · exact hpos t
  · exact hneg t
  · exact (hij rfl).elim

namespace PinnedRankOneMaps
variable {P : Parameters} (D : PinnedRankOneMaps P)

/-- The range is exactly the subgroup generated by the two pinned curves. -/
theorem range_hom (i : Fin 4) :
    (D.hom i).range = Subgroup.closure {g | ∃ t,
      g = positiveRoot P i t ∨ g = negativeRoot P i t} := by
  apply le_antisymm
  · rintro _ ⟨g, rfl⟩
    apply sl2_root_induction (fun g => D.hom i g ∈ _) ?_ ?_ ?_ g
    · intro t
      rw [D.positive]
      exact Subgroup.subset_closure ⟨t, Or.inl rfl⟩
    · intro t
      rw [D.negative]
      exact Subgroup.subset_closure ⟨t, Or.inr rfl⟩
    · intro g h hg hh
      simpa only [map_mul] using Subgroup.mul_mem _ hg hh
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨t, rfl | rfl⟩
    · exact ⟨_, D.positive i t⟩
    · exact ⟨_, D.negative i t⟩

/-- Pinning forces equivariance for the actual graph-field automorphism. -/
theorem graphField_hom (i : Fin 4) (g : SL(2, ExtensionField P)) :
    graphFieldAutomorphism P (D.hom i g) =
      D.hom (typeD4DiagramPermutation i)
        (SpecialLinearGroup.map (fieldFrobenius P).toRingHom g) := by
  have htrans {j k : Fin 2} (hjk : j ≠ k) (t : ExtensionField P) :
      SpecialLinearGroup.map (fieldFrobenius P).toRingHom
        (SpecialLinearGroup.transvection hjk t) =
      SpecialLinearGroup.transvection hjk (fieldFrobenius P t) := by
    apply Subtype.ext
    change Matrix.map (1 + Matrix.single j k t) (fieldFrobenius P) =
      1 + Matrix.single j k (fieldFrobenius P t)
    ext a b
    simp only [Matrix.map_apply, Matrix.add_apply, Matrix.one_apply,
      Matrix.single_apply, map_add]
    split_ifs <;> simp only [map_one, map_zero]
  apply sl2_root_induction (fun g => graphFieldAutomorphism P (D.hom i g) =
    D.hom (typeD4DiagramPermutation i)
      (SpecialLinearGroup.map (fieldFrobenius P).toRingHom g)) ?_ ?_ ?_ g
  · intro t
    exact (congrArg (graphFieldAutomorphism P) (D.positive i t)).trans
      ((graphField_positiveRoot P i t).trans
        ((D.positive _ _).symm.trans
          (congrArg (D.hom _) (htrans (by decide : (0 : Fin 2) ≠ 1) t).symm)))
  · intro t
    exact (congrArg (graphFieldAutomorphism P) (D.negative i t)).trans
      ((graphField_negativeRoot P i t).trans
        ((D.negative _ _).symm.trans
          (congrArg (D.hom _) (htrans (by decide : (1 : Fin 2) ≠ 0) t).symm)))
  · intro g h hg hh
    simp only [map_mul, hg, hh]

/-- The central split Levi is already the range of its pinned rank-one map. -/
theorem range_central : (D.hom 1).range = splitLevi P .central := by
  rw [D.range_hom]
  congr 1
  ext g
  simp only [Node.support, Set.mem_singleton_iff, exists_eq_left, Set.mem_ofPred_eq]

/-- The commuting root curves force the whole two rank-one images to commute. -/
theorem commute (C : ArmRootCommutation P) (i j : Fin 4)
    (hi : i ≠ 1) (hj : j ≠ 1) (hij : i ≠ j)
    (g h : SL(2, ExtensionField P)) : Commute (D.hom i g) (D.hom j h) := by
  apply sl2_root_induction (fun g => Commute (D.hom i g) (D.hom j h)) ?_ ?_ ?_ g
  · intro t
    rw [D.positive]
    apply sl2_root_induction (fun h => Commute (positiveRoot P i t) (D.hom j h))
      ?_ ?_ ?_ h
    · intro u
      rw [D.positive]
      exact C.positive_positive i j hi hj hij t u
    · intro u
      rw [D.negative]
      exact C.positive_negative i j hi hj hij t u
    · intro a b ha hb
      simpa only [map_mul] using ha.mul_right hb
  · intro t
    rw [D.negative]
    apply sl2_root_induction (fun h => Commute (negativeRoot P i t) (D.hom j h))
      ?_ ?_ ?_ h
    · intro u
      rw [D.positive]
      exact (C.positive_negative j i hj hi hij.symm u t).symm
    · intro u
      rw [D.negative]
      exact C.negative_negative i j hi hj hij t u
    · intro a b ha hb
      simpa only [map_mul] using ha.mul_right hb
  · intro a b ha hb
    simpa only [map_mul] using ha.mul_left hb

end PinnedRankOneMaps
end Triality.Standard.Parabolics
