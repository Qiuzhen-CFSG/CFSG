def supportMatrix {F : Type*} [Zero F] [One F] (l : List (Fin 28 × Fin 28)) :
    Matrix (Fin 28) (Fin 28) F := fun r c => if (r, c) ∈ l then 1 else 0

def constantMatrix {F : Type*} [Zero F] [One F] (k : Fin 4) :
    Matrix (Fin 28) (Fin 28) F := supportMatrix (constantSupport k)

set_option maxRecDepth 8000 in
set_option maxHeartbeats 16000000 in
lemma root_constant_binary (s : Bool) :
    rootMatrix (F := ZMod 2) 1 s 1 = constantMatrix (if s then 0 else 1) := by
  revert s
  decide +kernel

set_option maxRecDepth 8000 in
set_option maxHeartbeats 16000000 in
lemma arm_pair_binary (s : Bool) :
    rootMatrix (F := ZMod 2) 0 s 1 * rootMatrix 2 s 1 =
      supportMatrix (armPairSupport (if s then 0 else 1)) := by
  revert s
  decide +kernel

set_option maxRecDepth 8000 in
set_option maxHeartbeats 16000000 in
lemma arm_triple_binary (s : Bool) :
    (supportMatrix (F := ZMod 2) (armPairSupport (if s then 0 else 1))) *
      rootMatrix 3 s 1 = constantMatrix (if s then 2 else 3) := by
  revert s
  decide +kernel

end Triality.Standard.ElementaryCentralKernel.FixedRootCommutant
