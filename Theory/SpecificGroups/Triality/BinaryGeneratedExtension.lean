module
public import Theory.SpecificGroups.Triality.CubicComponentAction
public import Theory.SpecificGroups.Triality.ParabolicOuterTwo.Extensions
public import Theory.GroupTheory.GeneralizedFitting.SimpleTwoQuotient
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# Cubic and two-group generation around binary triality

In a group of three-rank at most two, the actual cubic subgroups lie in
any normal copy of genuine ³D₄(2). The component's prime-to-three residual
identity proves this containment; no choice of an inner representative is
used. If cubic actors, the component and a two-subgroup generate the group,
the quotient by the component is consequently a two-group. When the ambient
two-core is trivial, the component centralizer vanishes and the absence of
outer two-automorphisms identifies the component with the entire group.

This applies to the literal two-core quotient in the smaller changed-Sylow
branch of Aschbacher–Smith 5.2.2, printed p.648. The intrinsic cubic-action
input is A.3.18, pp.51–53; the automorphism calculation is GLS3 2.5.12.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace Triality.Standard.BinaryGeneratedExtension
variable {G : Type*} [Group G] [Finite G]

/-- The original cubic subgroup is contained in a normal binary triality component. -/
theorem cubic_subgroup_le (K D : Subgroup G) [K.Normal]
    (e : K ≃* BinaryCarrier 1 Nat.zero_lt_one)
    (hr : primeRank 3 G ≤ 2) (hD : IsPGroup 3 D) : D ≤ K := by
  let : IsSimpleGroup K := e.isSimpleGroup
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := e.symm.toMonoidHom) e.symm.surjective
  have hz : center K = ⊥ := by
    apply bot_unique
    intro k hk
    have he : e k = 1 := by
      have hm : e k ∈ center (BinaryCarrier 1 Nat.zero_lt_one) :=
        (centerCongr e ⟨k,hk⟩).property
      simpa only [binaryCarrier_center_eq_bot,mem_bot] using hm
    exact e.map_eq_one_iff.mp he
  let ec : (K ⧸ center K) ≃* BinaryCarrier 1 Nat.zero_lt_one :=
    ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).trans e
  let : IsQuasisimple K := ⟨ec.isSimpleGroup⟩
  have hK : IsComponent G K := ⟨(inferInstance : K.Normal).isSubnormal,inferInstance⟩
  have heq := (CubicComponentAction.component_eq_primeClosure_and_residual hr hK
    (by rw [hz,card_bot]; decide) 1 Nat.zero_lt_one ec).2
  rw [heq]
  intro x hx
  obtain ⟨m,hm⟩ := hD ⟨x,hx⟩
  exact mem_primeToResidual_of_pow (congrArg Subtype.val hm)

/-- Binary triality has no reduced extension generated by cubic and two-subgroups. -/
theorem eq_top_of_generated (K D S : Subgroup G) [K.Normal]
    (e : K ≃* BinaryCarrier 1 Nat.zero_lt_one)
    (hr : primeRank 3 G ≤ 2) (hcore : pCore 2 G = ⊥)
    (hD : IsPGroup 3 D) (hS : IsPGroup 2 S)
    (hgen : D ⊔ K ⊔ S = ⊤) : K = ⊤ := by
  have hDK := cubic_subgroup_le K D e hr hD
  have hKS : K ⊔ S = ⊤ := by simpa only [sup_eq_right.mpr hDK] using hgen
  have hquot : IsPGroup 2 (G ⧸ K) := isPGroup_quotient_of_sup_eq_top K S hS hKS
  let : IsSimpleGroup K := e.isSimpleGroup
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := e.symm.toMonoidHom) e.symm.surjective
  have hC := centralizer_eq_bot_of_simple_two_quotient K
    (Group.IsPerfect.not_isMulCommutative K) hquot hcore
  exact ParabolicOuterTwo.normalExtension_eq_top_at_two K e hC hquot
end Triality.Standard.BinaryGeneratedExtension
