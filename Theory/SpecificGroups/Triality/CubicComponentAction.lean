module
public import Theory.SpecificGroups.Triality.OddGraphFixedPoints.Overgroups
public import Theory.GroupAction.ComponentRankAction.ResidualSource
public import Theory.GroupTheory.PrimeRankFixedJoin

/-!
# Cubic actors and residuals of genuine binary triality components

An automorphism overgroup containing all inner automorphisms and an outer
three-divisor contains a pure coefficient actor of order three. The proved
root-word calculation gives an elementary nine fixed by that actor. Its
faithful inner image and the outer actor generate an elementary 27, which
contradicts cubic rank at most two. Thus all cubic prime-power actors in
the actual component action are inner.

The literal action range has rank at most two by the coprime centralizer
argument. A.3.18 consequently identifies the original component with both
the subgroup generated by cubic elements and the prime-to-three residual.
The argument includes ³D₄(2) and retains the central quotient of the original
component; simplicity and perfectness of the model come from that component.

Source: Aschbacher--Smith A.2.6 and A.3.18, printed pp.33--34,51--53;
the application in 14.2.15 is on printed pp.985--986. The imported fixed
nine and coefficient coverage retain their GLS root-model references.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace Triality.Standard.CubicComponentAction

private theorem fixed_nine_actor_rank_three
    {B : Type*} [Group B] [Finite B] (hz : center B = ⊥)
    (U : Subgroup (MulAut B)) (hU : MulAut.innerSubgroup B ≤ U)
    (a : MulAut B) (ha : a ∈ U) (hoa : orderOf a = 3)
    (houter : a ∉ MulAut.innerSubgroup B)
    (E : Subgroup B) (hE : IsElementaryAbelian 3 E)
    (hc : Nat.card E = 9) (hfix : E ≤ a.fixedSubgroup) :
    3 ≤ primeRank 3 U := by
  let := hE
  let f : B →* U := MulAut.conj.codRestrict U (fun g => hU ⟨g,rfl⟩)
  have hf : Function.Injective f := fun _ _ hh =>
    MulAut.conj_injective_of_center_eq_bot hz (congrArg Subtype.val hh)
  let F := E.map f
  let : IsElementaryAbelian 3 F := IsElementaryAbelian.map f
  let x : U := ⟨a,ha⟩
  have hx : orderOf x = 3 := (orderOf_injective U.subtype U.subtype_injective x).symm.trans hoa
  have hxF : x ∉ F := by
    rintro ⟨g,_,hg⟩
    exact houter ⟨g,congrArg Subtype.val hg⟩
  have hFfix : F ≤ centralizer ({x} : Set U) := by
    rintro _ ⟨g,hg,rfl⟩
    apply mem_centralizer_singleton_iff.mpr
    apply Subtype.ext
    apply MulEquiv.ext
    intro y
    have hgfix := (MulAut.mem_fixedSubgroup _ _).mp (hfix hg)
    change g * a y * g⁻¹ = a (g * y * g⁻¹)
    rw [map_mul,map_mul,map_inv,hgfix]
  have hcF : Nat.card F = 3^2 := by rw [card_map_of_injective hf,hc]; norm_num
  exact IsElementaryAbelian.primeRank_ge_of_fixed_join F x hx hxF hFfix hcF

/-- Cubic prime-power elements of a rank-two automorphism overgroup are inner. -/
theorem primePower_actor_inner (n : ℕ) (hn : 0 < n)
    [IsSimpleGroup (BinaryCarrier n hn)] [Group.IsPerfect (BinaryCarrier n hn)]
    (U : Subgroup (MulAut (BinaryCarrier n hn)))
    (hU : MulAut.innerSubgroup (BinaryCarrier n hn) ≤ U)
    (hr : primeRank 3 U ≤ 2)
    (a : MulAut (BinaryCarrier n hn)) (ha : a ∈ U)
    (m : ℕ) (hm : a^(3^m) = 1) :
    a ∈ MulAut.innerSubgroup (BinaryCarrier n hn) := by
  by_contra houter
  let q := QuotientGroup.mk' (MulAut.innerSubgroup (BinaryCarrier n hn))
  have hq : (q a)^(3^m) = 1 := by rw [←map_pow,hm,map_one]
  have hp : IsPGroup 3 (zpowers (q a)) := IsPGroup.of_card_dvd_pow (n := m)
    (by rw [Nat.card_zpowers]; exact orderOf_dvd_of_pow_eq_one hq)
  have hd : 3 ∣ orderOf (q a) := by
    have hh := hp.card_eq_or_dvd.resolve_left (by
      intro hc
      have hb : zpowers (q a) = ⊥ := card_eq_one.mp hc
      exact houter ((QuotientGroup.eq_one_iff a).mp (mem_bot.mp (hb ▸ mem_zpowers (q a)))))
    simpa only [Nat.card_zpowers] using hh
  obtain ⟨d,hdU,ho,hninner,E,hE,hc,hfixed⟩ :=
    OddGraph.exists_graph_representative_in_overgroup n hn U hU a ha hd
  have hz : center (BinaryCarrier n hn) = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (center (BinaryCarrier n hn)) inferInstance with hh | hh
    · exact hh
    · exact (Group.IsPerfect.not_isMulCommutative _ (center_eq_top_iff.mp hh)).elim
  have hthree := fixed_nine_actor_rank_three hz
    U hU _ hdU ho hninner E hE hc hfixed
  omega

/-- The source A.3.18 identity for the original component and its genuine triality marking. -/
theorem component_eq_primeClosure_and_residual
    {G : Type*} [Group G] [Finite G]
    (hG : primeRank 3 G ≤ 2) {L : Subgroup G} (hL : IsComponent G L)
    (hz : Nat.Coprime 3 (Nat.card (center L)))
    (n : ℕ) (hn : 0 < n) (e : (L ⧸ center L) ≃* BinaryCarrier n hn) :
    L = closure {x : G | orderOf x = 3} ∧ L = primeToResidual 3 G := by
  let := hL.2
  let : IsSimpleGroup (L ⧸ center L) := IsQuasisimple.simple
  let : IsSimpleGroup (BinaryCarrier n hn) := e.symm.isSimpleGroup
  let : Group.IsPerfect (BinaryCarrier n hn) := Group.IsPerfect.ofSurjective
    (f := e.toMonoidHom.comp (QuotientGroup.mk' (center L)))
    (e.surjective.comp (QuotientGroup.mk'_surjective _))
  have hrmodel : 2 ≤ primeRank 3 (BinaryCarrier n hn) := by
    let E := ElementaryNine.subgroup (binaryParameters n hn) rfl
    let : IsElementaryAbelian 3 E := ElementaryNine.subgroup_elementary _ _
    exact IsElementaryAbelian.primeRank_ge_of_card E (ElementaryNine.card_subgroup _ _)
  have hr : 2 ≤ primeRank 3 L := by
    rw [←primeRank_equiv 3 e] at hrmodel
    exact hrmodel.trans (primeRank_quotient_le_of_coprime 3 (center L) hz)
  apply Theory.GroupAction.ComponentRankAction.component_eq_primeClosure_and_residual
    hL hz hr hG e
  intro a ha m hm
  exact primePower_actor_inner n hn _
    (Theory.GroupAction.ComponentRankAction.inner_le_range L e)
    (Theory.GroupAction.ComponentRankAction.range_rank_le_two L e hz hr hG) a ha m hm

end Triality.Standard.CubicComponentAction
