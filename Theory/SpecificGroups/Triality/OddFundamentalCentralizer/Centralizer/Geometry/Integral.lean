open Parabolics.RankOneMatrices

def orderedIndex (i : Fin 4) : FlatIndex → Ix
  | .inl k => ⟨k.val, by omega⟩
  | .inr r => ⟨4 + (rootOrderTable i r).val, by omega⟩

set_option maxRecDepth 4000 in
lemma linear_entry (i : Fin 4) (b : Bool) (r s : FlatIndex) :
    matrix (linear i b) (orderedIndex i r) (orderedIndex i s) =
      if b then eData i r s else fData i r s := by
  revert i b r s
  decide +kernel

set_option maxRecDepth 4000 in
lemma quadratic_entry (i : Fin 4) (b : Bool) (r s : FlatIndex) :
    matrix (quadratic i b) (orderedIndex i r) (orderedIndex i s) =
      if b then (if r = .inr 0 ∧ s = .inr 1 then 1 else 0)
      else (if r = .inr 1 ∧ s = .inr 0 then 1 else 0) := by
  revert i b r s
  decide +kernel

set_option maxRecDepth 4000 in
lemma upperOne_eq (i : Fin 4) :
    matrix (upperOne i) = 1 + matrix (linear i true) + matrix (quadratic i true) := by
  revert i
  decide +kernel

set_option maxRecDepth 4000 in
lemma lowerMinusOne_eq (i : Fin 4) :
    matrix (lowerMinusOne i) = 1 - matrix (linear i false) + matrix (quadratic i false) := by
  revert i
  decide +kernel

set_option maxRecDepth 4000 in
lemma weylMiddle_eq (i : Fin 4) :
    matrix (upperOne i) * matrix (lowerMinusOne i) = matrix (weylMiddle i) := by
  apply matrix_mul
  revert i
  decide +kernel

set_option maxRecDepth 4000 in
lemma weyl_eq (i : Fin 4) :
    matrix (weylMiddle i) * matrix (upperOne i) = matrix (weyl i) := by
  apply matrix_mul
  revert i
  decide +kernel

set_option maxRecDepth 4000 in
lemma prefixTwo_eq : matrix (weyl 1) * matrix (weyl 0) = matrix prefixTwo := by
  apply matrix_mul
  decide +kernel

set_option maxRecDepth 4000 in
lemma prefixThree_eq : matrix prefixTwo * matrix (weyl 2) = matrix prefixThree := by
  apply matrix_mul
  decide +kernel

set_option maxRecDepth 4000 in
lemma highestWeyl_eq : matrix prefixThree * matrix (weyl 3) = matrix highestWeyl := by
  apply matrix_mul
  decide +kernel

set_option maxRecDepth 4000 in
lemma highest_linear (b : Bool) :
    matrix highestWeyl * matrix (linear 1 b) =
      matrix (highestLinear b) * matrix highestWeyl := by
  apply matrix_intertwine
  revert b
  decide +kernel

set_option maxRecDepth 4000 in
lemma highest_quadratic (b : Bool) :
    matrix highestWeyl * matrix (quadratic 1 b) =
      matrix (highestQuadratic b) * matrix highestWeyl := by
  apply matrix_intertwine
  revert b
  decide +kernel

/-- The two divided-power coefficients, selected by degree. -/
def coefficient (i : Fin 4) (b d : Bool) : Rows :=
  if d then linear i b else quadratic i b

def highestCoefficient (b d : Bool) : Rows :=
  if d then highestLinear b else highestQuadratic b

set_option maxRecDepth 4000 in
lemma highest_coefficient_commute (i : Fin 4) (hi : i ≠ 1) (b c d e : Bool) :
    Commute (matrix (highestCoefficient b d)) (matrix (coefficient i c e)) := by
  apply matrix_intertwine
  revert i hi b c d e
  decide +kernel

set_option maxRecDepth 4000 in
lemma weyl_sq (i : Fin 4) : matrix (weyl i) * matrix (weyl i) = matrix (scalar i) := by
  apply matrix_mul
  revert i
  decide +kernel

set_option maxRecDepth 4000 in
lemma scalar_arms (i : Fin 4) (hi : i ≠ 1) : matrix (scalar i) = matrix (scalar 0) := by
  revert i hi
  decide +kernel

set_option maxRecDepth 4000 in
lemma highest_scalar : matrix highestWeyl * matrix (scalar 1) =
    matrix (scalar 0) * matrix highestWeyl := by
  apply matrix_intertwine
  decide +kernel

end Triality.Standard.OddFundamentalCentralizer.Geometry.Integral
