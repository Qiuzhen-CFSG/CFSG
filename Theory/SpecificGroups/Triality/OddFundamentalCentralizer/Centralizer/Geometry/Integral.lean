module
public import Theory.SpecificGroups.Triality.LeviRankOneMatrices.Comparison

/-!
# Sparse integral certificates for the D4 complementary subsystem

All tables describe operators on the full four-Cartan-plus-twenty-four-root
lattice, in the root enumeration of `LeviRankOneMatrices.Coordinates`.
Sparse row multiplication is proved equal to ordinary matrix multiplication;
the certificates are then checked by kernel reduction over ℤ. No finite-field
specialization or unchecked computation is used.

The word is n₁ n₀ n₂ n₃. It takes the central root to the highest root, whose
positive and negative divided powers commute with all three arm subsystems.
Sources: GLS3 §§2.4 and 2.6, and Aschbacher–Smith A.2.17, printed p.39.
-/

@[expose] public section
open Matrix
namespace Triality.Standard.OddFundamentalCentralizer.Geometry.Integral
abbrev Ix := Fin 28
abbrev Rows := Ix → List (Ix × ℤ)

def rowEntry : List (Ix × ℤ) → Ix → ℤ
  | [], _ => 0
  | (k,a)::l, c => (if k = c then a else 0) + rowEntry l c

def rowProduct (l : List (Ix × ℤ)) (B : Rows) (c : Ix) : ℤ :=
  (l.map fun x => x.2 * rowEntry (B x.1) c).sum

def matrix (A : Rows) : Matrix Ix Ix ℤ := fun r c => rowEntry (A r) c

private lemma rowEntry_mul (l : List (Ix × ℤ)) (B : Rows) (c : Ix) :
    (∑ k, rowEntry l k * rowEntry (B k) c) = rowProduct l B c := by
  induction l with
  | nil => simp [rowEntry, rowProduct]
  | cons x l ih =>
    rcases x with ⟨k,a⟩
    simp [rowEntry, add_mul, Finset.sum_add_distrib, ih, rowProduct, ite_mul]

lemma matrix_mul (A B C : Rows)
    (h : ∀ r c, rowProduct (A r) B c = rowEntry (C r) c) :
    matrix A * matrix B = matrix C := by
  ext r c
  exact (rowEntry_mul (A r) B c).trans (h r c)

lemma matrix_intertwine (A B C D : Rows)
    (h : ∀ r c, rowProduct (A r) B c = rowProduct (C r) D c) :
    matrix A * matrix B = matrix C * matrix D := by
  ext r c
  exact (rowEntry_mul (A r) B c).trans ((h r c).trans (rowEntry_mul (C r) D c).symm)

