module

public import Theory.SpecificGroups.Triality.Parameters
public import Theory.AlgebraicGroup.RootSystems.TypeD4DiagramTriality
public import Theory.AlgebraicGroup.RootSystems.SimpleGeckGroup.Diagram
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.GroupTheory.Subgroup.Center

/-!
# The standard triality carrier ³D₄(q)

For an arbitrary prime power `q = p^f`, form the split D4 Chevalley group on
Geck's integral Cartan-plus-root lattice over `GF(p^(3*f))`. The pinned diagram
permutation cycles the three arms `0, 2, 3` and fixes vertex `1`. Its action on
all roots and Cartan coordinates reindexes the integral divided powers, so it
restricts to an automorphism of the group generated by the positive and negative
simple-root curves. The coefficient q-Frobenius commutes with this diagram
automorphism, and their composite has cube one.

Take the subgroup generated by p-elements in the graph-field fixed points, then
its quotient by its own center. This retains the elementary and adjoint
conventions explicitly. In particular, the construction uses neither a p-core
nor the residual with p-group quotient. The integral curves work in every
characteristic; the parameters include q = 2, with no extra derived-subgroup
operation. The family predicates require actual multiplicative equivalences to
these carriers.

Sources: GLS3 §§1.12, 2.1–2.3, especially the graph-field standard form 2.2.3,
the finite root-group construction discussed in Remarks 2.2.5, and the central
quotient convention in 2.2.6 (`refs/KGroup/GLS3/chapter2.tex`). Aschbacher–Smith,
Remark A.2.4 (`refs/quasithin.pdf`), lists the characteristic-two specialization
among the rank-two families. Order and simplicity are separate results.

This construction is independent of `Triality.Model`, whose small coordinate
block and inner permutation action do not construct the D4 diagram twist.
-/

@[expose] public section
noncomputable section

namespace Triality.Standard
open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.SimpleGeckGroup RootPairing.IntegralGeckConstruction

/-- The split adjoint D4 Chevalley group over the cubic extension, generated by
positive and negative simple-root Geck curves on the full Cartan-plus-root lattice. -/
abbrev SplitGroup (P : Parameters) :=
  RootPairing.SimpleGeckGroup.Carrier (typeDRootPairing_base 2) (ExtensionField P)

/-- The pinned order-three D4 diagram action on the split group. -/
def diagramAutomorphism (P : Parameters) : SplitGroup P ≃* SplitGroup P :=
  diagramEquiv typeD4DiagramEquiv typeD4DiagramBasePermutation typeD4DiagramEquiv_simple

/-- The coefficient q-Frobenius on the split group. -/
def fieldAutomorphism (P : Parameters) : SplitGroup P ≃* SplitGroup P :=
  equiv (fieldFrobenius P)

/-- The graph-field automorphism defining triality. -/
def graphFieldAutomorphism (P : Parameters) : SplitGroup P ≃* SplitGroup P :=
  (diagramAutomorphism P).trans (fieldAutomorphism P)

@[simp] theorem diagramAutomorphism_positive (P : Parameters)
    (i : (typeDRootPairing_base 2).support) (t : ExtensionField P) :
    diagramAutomorphism P (positive i t) = positive (typeD4DiagramBasePermutation i) t :=
  diagramEquiv_positive _ _ _ i t

@[simp] theorem diagramAutomorphism_negative (P : Parameters)
    (i : (typeDRootPairing_base 2).support) (t : ExtensionField P) :
    diagramAutomorphism P (negative i t) = negative (typeD4DiagramBasePermutation i) t :=
  diagramEquiv_negative _ _ _ i t

@[simp] theorem fieldAutomorphism_positive (P : Parameters)
    (i : (typeDRootPairing_base 2).support) (t : ExtensionField P) :
    fieldAutomorphism P (positive i t) = positive i (t ^ P.q) :=
  equiv_positive _ i t

@[simp] theorem fieldAutomorphism_negative (P : Parameters)
    (i : (typeDRootPairing_base 2).support) (t : ExtensionField P) :
    fieldAutomorphism P (negative i t) = negative i (t ^ P.q) :=
  equiv_negative _ i t

/-- On each positive simple root the graph-field map permutes the root and
raises its parameter to the q-th power. -/
@[simp] theorem graphFieldAutomorphism_positive (P : Parameters)
    (i : (typeDRootPairing_base 2).support) (t : ExtensionField P) :
    graphFieldAutomorphism P (positive i t) =
      positive (typeD4DiagramBasePermutation i) (t ^ P.q) := by
  simp [graphFieldAutomorphism]

@[simp] theorem graphFieldAutomorphism_negative (P : Parameters)
    (i : (typeDRootPairing_base 2).support) (t : ExtensionField P) :
    graphFieldAutomorphism P (negative i t) =
      negative (typeD4DiagramBasePermutation i) (t ^ P.q) := by
  simp [graphFieldAutomorphism]

/-- The graph and field parts commute on the whole split group. -/
theorem diagram_field_commute (P : Parameters) (g : SplitGroup P) :
    diagramAutomorphism P (fieldAutomorphism P g) =
      fieldAutomorphism P (diagramAutomorphism P g) :=
  diagramEquiv_equiv _ _ _ _ g

/-- The diagram action has cube one on the entire matrix group. -/
theorem diagramAutomorphism_three (P : Parameters) (g : SplitGroup P) :
    diagramAutomorphism P (diagramAutomorphism P (diagramAutomorphism P g)) = g :=
  diagramEquiv_three _ _ _ typeD4DiagramEquiv_three typeD4DiagramBasePermutation_three g

/-- The cubic coefficient extension makes the third field iterate trivial. -/
theorem fieldAutomorphism_three (P : Parameters) (g : SplitGroup P) :
    fieldAutomorphism P (fieldAutomorphism P (fieldAutomorphism P g)) = g :=
  equiv_three (fieldFrobenius P) (fieldFrobenius_three P) g

/-- The graph-field action has cube one over GF(q^3). -/
theorem graphFieldAutomorphism_three (P : Parameters) (g : SplitGroup P) :
    graphFieldAutomorphism P (graphFieldAutomorphism P (graphFieldAutomorphism P g)) = g := by
  simp only [graphFieldAutomorphism, MulEquiv.trans_apply]
  simp only [diagram_field_commute, diagramAutomorphism_three, fieldAutomorphism_three]

theorem graphFieldAutomorphism_pow_three (P : Parameters) :
    graphFieldAutomorphism P ^ 3 = 1 := by
  apply MulEquiv.ext
  intro g
  exact graphFieldAutomorphism_three P g

/-- The graph-field fixed points inside the split D4 group over GF(q^3). -/
def fixedSubgroup (P : Parameters) : Subgroup (SplitGroup P) :=
  MonoidHom.eqLocus (graphFieldAutomorphism P).toMonoidHom (MonoidHom.id _)

@[simp] theorem mem_fixedSubgroup (P : Parameters) (g : SplitGroup P) :
    g ∈ fixedSubgroup P ↔ graphFieldAutomorphism P g = g := Iff.rfl

/-- The elementary fixed-point subgroup: generated by all elements killed by
some power of the characteristic prime. This is the p-generated convention
O^{p′} of GLS3 §2.2, not the p-core or O^p. -/
def elementarySubgroup (P : Parameters) : Subgroup (fixedSubgroup P) :=
  Subgroup.closure {g | ∃ n : ℕ, g ^ (P.prime ^ n) = 1}

/-- The elementary triality group before central quotient. -/
abbrev ElementaryGroup (P : Parameters) := elementarySubgroup P

/-- Every p-element of the fixed-point group lies in its elementary subgroup. -/
theorem mem_elementarySubgroup_of_pow (P : Parameters) (g : fixedSubgroup P)
    (n : ℕ) (h : g ^ (P.prime ^ n) = 1) : g ∈ elementarySubgroup P :=
  Subgroup.subset_closure ⟨n, h⟩

/-- The adjoint triality carrier ³D₄(q): the central quotient of the elementary
fixed-point group for the genuine D4 graph-field action. -/
def Carrier (P : Parameters) := ElementaryGroup P ⧸ Subgroup.center (ElementaryGroup P)

instance carrierGroup (P : Parameters) : Group (Carrier P) := inferInstanceAs
  (Group (ElementaryGroup P ⧸ Subgroup.center (ElementaryGroup P)))

instance carrierFinite (P : Parameters) : Finite (Carrier P) := inferInstanceAs
  (Finite (ElementaryGroup P ⧸ Subgroup.center (ElementaryGroup P)))

/-- The canonical map to the adjoint carrier. -/
def toCarrier (P : Parameters) : ElementaryGroup P →* Carrier P :=
  QuotientGroup.mk' (Subgroup.center (ElementaryGroup P))

theorem toCarrier_surjective (P : Parameters) : Function.Surjective (toCarrier P) :=
  QuotientGroup.mk'_surjective _

@[simp] theorem toCarrier_eq_one (P : Parameters) (g : ElementaryGroup P) :
    toCarrier P g = 1 ↔ g ∈ Subgroup.center (ElementaryGroup P) :=
  QuotientGroup.eq_one_iff g

/-- Membership at a specified field order requires an actual group isomorphism
to the constructed carrier, with no parity restriction on that field order. -/
def IsTrialityGroupAt (q : ℕ) (G : Type*) [Group G] : Prop :=
  ∃ P : Parameters, P.q = q ∧ Nonempty (G ≃* Carrier P)

/-- Membership in the full triality family, for every prime power. -/
def IsTrialityGroup (G : Type*) [Group G] : Prop :=
  ∃ P : Parameters, Nonempty (G ≃* Carrier P)

theorem isTrialityGroupAt_carrier (P : Parameters) : IsTrialityGroupAt P.q (Carrier P) :=
  ⟨P, rfl, ⟨MulEquiv.refl _⟩⟩

theorem isTrialityGroup_carrier (P : Parameters) : IsTrialityGroup (Carrier P) :=
  ⟨P, ⟨MulEquiv.refl _⟩⟩

/-- Every prime power, including 2 and odd prime powers, has a carrier. -/
theorem exists_carrier (q : ℕ) (hq : IsPrimePow q) :
    ∃ P : Parameters, P.q = q ∧ IsTrialityGroupAt q (Carrier P) := by
  obtain ⟨P, rfl⟩ := exists_parameters q hq
  exact ⟨P, rfl, isTrialityGroupAt_carrier P⟩

theorem IsTrialityGroupAt.isPrimePow {q : ℕ} {G : Type*} [Group G]
    (h : IsTrialityGroupAt q G) : IsPrimePow q := by
  obtain ⟨P, rfl, _⟩ := h
  exact P.q_isPrimePow

theorem IsTrialityGroupAt.of_mulEquiv {q : ℕ} {G H : Type*} [Group G] [Group H]
    (h : IsTrialityGroupAt q G) (e : H ≃* G) : IsTrialityGroupAt q H := by
  obtain ⟨P, hq, ⟨f⟩⟩ := h
  exact ⟨P, hq, ⟨e.trans f⟩⟩

theorem isTrialityGroupAt_mulEquiv_iff {q : ℕ} {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) : IsTrialityGroupAt q G ↔ IsTrialityGroupAt q H :=
  ⟨fun h => h.of_mulEquiv e.symm, fun h => h.of_mulEquiv e⟩

theorem IsTrialityGroup.of_mulEquiv {G H : Type*} [Group G] [Group H]
    (h : IsTrialityGroup G) (e : H ≃* G) : IsTrialityGroup H := by
  obtain ⟨P, ⟨f⟩⟩ := h
  exact ⟨P, ⟨e.trans f⟩⟩

theorem isTrialityGroup_mulEquiv_iff {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) : IsTrialityGroup G ↔ IsTrialityGroup H :=
  ⟨fun h => h.of_mulEquiv e.symm, fun h => h.of_mulEquiv e⟩

theorem isTrialityGroup_iff_exists_fieldOrder (G : Type*) [Group G] :
    IsTrialityGroup G ↔ ∃ q, IsTrialityGroupAt q G := by
  constructor
  · rintro ⟨P, h⟩
    exact ⟨P.q, P, rfl, h⟩
  · rintro ⟨q, P, _, h⟩
    exact ⟨P, h⟩

end Triality.Standard
