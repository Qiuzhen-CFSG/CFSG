module

public import Theory.SpecificGroups.Triality.EvenFieldFixedResidual.NormalForm.UnipotentCocycle.RootAction

/-!
# The positive D4 root filtration

The subgroup at stage `k` is generated by the canonical integral Geck curves
whose positions are at least `k`. Root height is nondecreasing in this order,
so every exchange correction lies strictly after both exchanged positions.
Applying the filtered word collector on this restricted support proves that
all earlier coordinates vanish. Unique coordinates then give the trivial
intersection of the leading root subgroup with the next tail.

Each tail is invariant under conjugation by every positive root curve and
under the literal coefficient automorphisms. These facts, together with the
leading-root factorization, are the layers used by split-positive cocycle
lifting. The stage-zero subgroup is the original `positiveSubgroup`.

Sources: GLS3 §§2.3–2.5 (`refs/KGroup/GLS3/chapter2.tex`), in the field
convention of 2.5.13 and 2.5.17; Aschbacher–Smith 16.1.3–4, printed p.1171
(`refs/quasithin.pdf`).
-/

public section

open Theory.AlgebraicGroup.StandardRootSystem
open Triality.Standard Triality.Standard.PositiveCoordinates
noncomputable section
namespace Triality.Standard.EvenField.NormalForm.UnipotentCocycle.SplitPositive

/-- The subgroup generated by the roots at positions at least `k`. -/
@[expose] def tail (P : Parameters) (k : ℕ) : Subgroup (SplitGroup P) :=
  Subgroup.closure {g | ∃ (i : Fin 12) (t : ExtensionField P), k ≤ i.val ∧ curve P i t = g}

lemma curve_mem_tail (P : Parameters) {k : ℕ} (i : Fin 12) (t : ExtensionField P)
    (hi : k ≤ i.val) : curve P i t ∈ tail P k :=
  Subgroup.subset_closure ⟨i, t, hi, rfl⟩

lemma tail_antitone (P : Parameters) {k l : ℕ} (h : k ≤ l) : tail P l ≤ tail P k :=
  Subgroup.closure_mono (by rintro g ⟨i, t, hi, rfl⟩; exact ⟨i, t, h.trans hi, rfl⟩)

lemma tail_twelve (P : Parameters) : tail P 12 = ⊥ := by
  apply le_antisymm _ bot_le
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i, t, hi, rfl⟩
  omega

private lemma height_monotone : Monotone collectionHeight := by
  intro i j hij
  change i.val ≤ j.val at hij
  fin_cases i <;> fin_cases j <;> norm_num [collectionHeight] at *

private lemma index_sum_gt {i j r : Fin 12}
    (h : (typeDRootPairing 2).root (rootIndex r) =
      (typeDRootPairing 2).root (rootIndex i) +
        (typeDRootPairing 2).root (rootIndex j)) : i.val < r.val ∧ j.val < r.val := by
  have hh := collectionHeight_sum_gt h
  constructor
  · by_contra hn
    have := height_monotone (show r ≤ i from Nat.le_of_not_gt hn)
    omega
  · by_contra hn
    have := height_monotone (show r ≤ j from Nat.le_of_not_gt hn)
    omega

lemma tail_zero (n : ℕ) (hn : 0 < n) :
    tail (binaryParameters n hn) 0 = Parabolics.positiveSubgroup (binaryParameters n hn) := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨i, t, _, rfl⟩
    exact curve_mem_positiveSubgroup_of_sumExchange _ (sumExchange_binary n hn) i t
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨i, t, rfl⟩
    rw [← curve_simple]
    exact curve_mem_tail _ _ _ (Nat.zero_le _)

private lemma tail_word (P : Parameters) (k : ℕ) {g : SplitGroup P} (hg : g ∈ tail P k) :
    ∃ word : List (Fin 12 × ExtensionField P),
      (∀ z ∈ word, k ≤ z.1.val) ∧ FilteredCollection.wordProduct (curve P) word = g := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨i, t, hi, rfl⟩ := hg
    exact ⟨[(i,t)], by simpa, by simp [FilteredCollection.wordProduct]⟩
  | one => exact ⟨[], by simp, by simp [FilteredCollection.wordProduct]⟩
  | mul g h _ _ hg hh =>
    obtain ⟨v, hv, rfl⟩ := hg
    obtain ⟨w, hw, rfl⟩ := hh
    exact ⟨v ++ w, by intro z hz; exact (List.mem_append.mp hz).elim (hv z) (hw z), by simp [FilteredCollection.wordProduct]⟩
  | inv g _ hg =>
    obtain ⟨w, hw, rfl⟩ := hg
    refine ⟨(w.map fun z => (z.1, -z.2)).reverse, ?_, ?_⟩
    · intro z hz
      obtain ⟨a, ha, rfl⟩ := List.mem_map.mp (List.mem_reverse.mp hz)
      exact hw a ha
    · simp only [FilteredCollection.wordProduct, List.map_reverse, List.map_map,
        List.prod_inv_reverse]
      congr 2
      apply List.map_congr_left
      intro z _
      exact (curve_inv P z.1 z.2).symm

private lemma product_filter (P : Parameters) (a : Coordinates P) (k : ℕ) (l : List (Fin 12)) :
    (l.map fun i => curve P i (if k ≤ i.val then a i else 0)).prod =
      ((l.filter fun i => k ≤ i.val).map fun i => curve P i (a i)).prod := by
  induction l with
  | nil => simp
  | cons i l ih =>
    by_cases h : k ≤ i.val <;> simp [h, ih]

private lemma tail_coordinates (n : ℕ) (hn : 0 < n) (k : ℕ)
    {g : SplitGroup (binaryParameters n hn)} (hg : g ∈ tail (binaryParameters n hn) k) :
    ∃ a : Coordinates (binaryParameters n hn),
      (∀ i, i.val < k → a i = 0) ∧ orderedProduct (binaryParameters n hn) a = g := by
  classical
  let P := binaryParameters n hn
  let order := (List.finRange 12).filter fun i => k ≤ i.val
  obtain ⟨w, hw, rfl⟩ := tail_word P k hg
  have hswap : ∀ (i j : Fin 12) (a b : ExtensionField P),
      i ∈ order → j ∈ order → i ≠ j →
      ∃ correction : List (Fin 12 × ExtensionField P),
        (∀ z ∈ correction, z.1 ∈ order ∧
          max (collectionHeight i) (collectionHeight j) < collectionHeight z.1) ∧
        curve P i a * curve P j b =
          curve P j b * curve P i a * FilteredCollection.wordProduct (curve P) correction := by
    intro i j a b hi _ hij
    by_cases h : ∃ r : Fin 12, (typeDRootPairing 2).root (rootIndex r) =
        (typeDRootPairing 2).root (rootIndex i) + (typeDRootPairing 2).root (rootIndex j)
    · obtain ⟨r, hr⟩ := h
      refine ⟨[(r,a*b)], ?_, ?_⟩
      · intro z hz
        have hz' : z = (r,a*b) := by simpa using hz
        subst z
        refine ⟨?_, collectionHeight_sum_gt hr⟩
        have hi' : k ≤ i.val := by simpa [order] using hi
        have := (index_sum_gt hr).1
        simp [order, show k ≤ r.val by omega]
      · simpa [FilteredCollection.wordProduct] using sumExchange_binary n hn i j r hr a b
    · exact ⟨[], by simp, by simpa [FilteredCollection.wordProduct] using
        (nonsumCommute_binary n hn i j hij h a b).eq⟩
  obtain ⟨a, ha⟩ := FilteredCollection.filteredCollection_exists_params
    collectionHeight (curve P) order ((List.nodup_finRange 12).filter _)
    6 (fun i _ => collectionHeight_lt_six i)
    (fun i a b => (curve_add P i a b).symm) hswap w
    (by intro z hz; simpa [order] using hw z hz)
  refine ⟨fun i => if k ≤ i.val then a i else 0, ?_, ?_⟩
  · intro i hi
    simp [show ¬ k ≤ i.val by omega]
  · simpa only [orderedProduct, List.ofFn_eq_map, product_filter] using ha.symm

private lemma ordered_single (P : Parameters) (i : Fin 12) (t : ExtensionField P) :
    orderedProduct P (fun j => if j = i then t else 0) = curve P i t := by
  classical
  rw [orderedProduct, List.ofFn_eq_map,
    List.prod_map_eq_pow_single i]
  · simp
  · intro j hj _
    simp [hj]

lemma curve_mem_tail_succ (n : ℕ) (hn : 0 < n) (i : Fin 12)
    (t : ExtensionField (binaryParameters n hn))
    (ht : curve (binaryParameters n hn) i t ∈ tail (binaryParameters n hn) (i.val+1)) : t = 0 := by
  obtain ⟨a, ha, he⟩ := tail_coordinates n hn (i.val+1) ht
  have he' := orderedProduct_injective_binary n hn (he.trans (ordered_single _ i t).symm)
  have hai := congrFun he' i
  simpa [ha i (by omega)] using hai.symm


private lemma ordered_eq_filter (P : Parameters) (a : Coordinates P) (k : ℕ)
    (ha : ∀ i : Fin 12, i.val < k → a i = 0) :
    orderedProduct P a = (((List.finRange 12).filter fun i => k ≤ i.val).map
      fun i => curve P i (a i)).prod := by
  have he : a = fun i => if k ≤ i.val then a i else 0 := by
    funext i
    split_ifs with hi
    · rfl
    · exact ha i (by omega)
  conv_lhs => rw [he]
  exact product_filter P a k (List.finRange 12)

lemma tail_factor (n : ℕ) (hn : 0 < n) (i : Fin 12)
    {g : SplitGroup (binaryParameters n hn)} (hg : g ∈ tail (binaryParameters n hn) i.val) :
    ∃ t w, w ∈ tail (binaryParameters n hn) (i.val+1) ∧
      g = curve (binaryParameters n hn) i t * w := by
  obtain ⟨a, ha, rfl⟩ := tail_coordinates n hn i.val hg
  have hs : (List.finRange 12).filter (fun j => i.val ≤ j.val) =
      i :: (List.finRange 12).filter (fun j => i.val+1 ≤ j.val) := by
    fin_cases i <;> decide
  rw [ordered_eq_filter _ a i.val ha, hs, List.map_cons, List.prod_cons]
  refine ⟨a i, _, ?_, rfl⟩
  apply Subgroup.list_prod_mem
  intro x hx
  obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hx
  exact curve_mem_tail _ j (a j) (by simpa using hj)

private lemma conjugate_of_exchange {G : Type*} [Group G] (x y z : G)
    (h : y * x⁻¹ = x⁻¹ * y * z) : x * y * x⁻¹ = y * z := by
  calc
    x * y * x⁻¹ = x * (y * x⁻¹) := mul_assoc _ _ _
    _ = x * (x⁻¹ * y * z) := congrArg (x * ·) h
    _ = y * z := by group

lemma curve_conj_tail (n : ℕ) (hn : 0 < n) (k : ℕ) (i : Fin 12)
    (a : ExtensionField (binaryParameters n hn))
    {g : SplitGroup (binaryParameters n hn)} (hg : g ∈ tail (binaryParameters n hn) k) :
    curve (binaryParameters n hn) i a * g * (curve (binaryParameters n hn) i a)⁻¹ ∈
      tail (binaryParameters n hn) k := by
  let P := binaryParameters n hn
  suffices h : tail P k ≤ (tail P k).comap (MulAut.conj (curve P i a)).toMonoidHom from h hg
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨j, b, hj, rfl⟩
  change curve P i a * curve P j b * (curve P i a)⁻¹ ∈ tail P k
  by_cases he : i = j
  · subst j
    have hc : curve P i a * curve P i b = curve P i b * curve P i a := by
      rw [← curve_add, ← curve_add, add_comm a b]
    rw [hc, mul_inv_cancel_right]
    exact curve_mem_tail P i b hj
  by_cases h : ∃ r : Fin 12, (typeDRootPairing 2).root (rootIndex r) =
      (typeDRootPairing 2).root (rootIndex j) + (typeDRootPairing 2).root (rootIndex i)
  · obtain ⟨r, hr⟩ := h
    have heq : curve P i a * curve P j b * (curve P i a)⁻¹ =
        curve P j b * curve P r (b * -a) := by
      apply conjugate_of_exchange
      simpa only [curve_inv P i a] using sumExchange_binary n hn j i r hr b (-a)
    rw [heq]
    apply Subgroup.mul_mem _ (curve_mem_tail P j b hj)
    exact curve_mem_tail P r _ (by have := (index_sum_gt hr).1; omega)
  · have hc := nonsumCommute_binary n hn j i (Ne.symm he) h b a
    rw [← hc.eq, mul_inv_cancel_right]
    exact curve_mem_tail P j b hj

lemma coefficient_tail (P : Parameters) (e : OuterOdd.CoefficientAut P) (k : ℕ)
    {g : SplitGroup P} (hg : g ∈ tail P k) :
    OuterOdd.coefficientSplit P e g ∈ tail P k := by
  suffices h : tail P k ≤ (tail P k).comap (OuterOdd.coefficientSplit P e).toMonoidHom from h hg
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, t, hi, rfl⟩
  change OuterOdd.coefficientSplit P e (curve P i t) ∈ tail P k
  rw [coefficientSplit_curve]
  exact curve_mem_tail P i _ hi

end Triality.Standard.EvenField.NormalForm.UnipotentCocycle.SplitPositive
