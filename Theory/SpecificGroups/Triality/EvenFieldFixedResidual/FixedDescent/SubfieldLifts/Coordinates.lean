module

public import Theory.SpecificGroups.Triality.PositiveRootCoordinates
public import Theory.SpecificGroups.Triality.ConcreteBruhat.Torus.Diagonal

/-!
# Coefficient maps and descent of split D4 factors

The literal entrywise Geck-group map preserves the twelve ordered positive
root curves and the four coroot words. Uniqueness of those coordinates makes
fixed positive and torus elements products of words with fixed parameters.
Lifting these parameters through a field embedding therefore gives elements
of the smaller root-generated group. The Weyl words already use only prime
field coefficients and lift without any fixedness hypothesis.

These are the factorwise steps of subfield descent used in `NormalForm`.
No generation statement is inferred just from taking fixed points, and no
simplicity or perfectness of the smaller group is needed.

Source: GLS3 §§2.2–2.6, especially the coordinate statements 2.3.5 and
2.3.8 (`refs/KGroup/GLS3/chapter2.tex`); the field case of Aschbacher–Smith
16.1.4(4), printed p.1171 (`refs/quasithin.pdf`).
-/

open Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
open Triality.Standard Triality.Standard.Parabolics
open Triality.Standard.ConcreteBruhat
@[expose] public section
noncomputable section
namespace Triality.Standard.EvenField.SubfieldLifts
local instance coefficientMatrixIndexDecidableEq :
    DecidableEq ((typeDRootPairing_base 2).support ⊕ TypeDRootIndex (2 + 2)) := instDecidableEqSum

/-- The coefficient homomorphism sends each integral positive curve to the same curve. -/
theorem map_curve (P Q : Parameters) (f : ExtensionField P →+* ExtensionField Q)
    (i : Fin 12) (t : ExtensionField P) :
    RootPairing.SimpleGeckGroup.map f (PositiveCoordinates.curve P i t) =
      PositiveCoordinates.curve Q i (f t) := by
  apply Subtype.ext
  apply Units.ext
  change (1 + t • specializeMatrix _ + t ^ 2 • specializeMatrix _ +
      t ^ 3 • specializeMatrix _ : Matrix
        ((typeDRootPairing_base 2).support ⊕ TypeDRootIndex (2 + 2))
        ((typeDRootPairing_base 2).support ⊕ TypeDRootIndex (2 + 2)) (ExtensionField P)).map f =
    1 + f t • specializeMatrix _ + (f t) ^ 2 • specializeMatrix _ +
      (f t) ^ 3 • specializeMatrix _
  ext a b
  simp [specializeMatrix, Matrix.one_apply, Matrix.map_apply, apply_ite f]

/-- Entrywise coefficient mapping preserves the published twelve-root product order. -/
theorem map_orderedProduct (P Q : Parameters)
    (f : ExtensionField P →+* ExtensionField Q) (a : PositiveCoordinates.Coordinates P) :
    RootPairing.SimpleGeckGroup.map f (PositiveCoordinates.orderedProduct P a) =
      PositiveCoordinates.orderedProduct Q (fun i => f (a i)) := by
  simp only [PositiveCoordinates.orderedProduct, map_list_prod, List.map_ofFn]
  apply congrArg List.prod
  apply congrArg List.ofFn
  funext i
  exact map_curve P Q f i (a i)

/-- The rank-one Weyl word is natural in the coefficient field. -/
theorem map_weylWord (P Q : Parameters) (f : ExtensionField P →+* ExtensionField Q)
    (i : Fin 4) (t : ExtensionField P) :
    RootPairing.SimpleGeckGroup.map f (weylWord P i t) = weylWord Q i (f t) := by
  simp [weylWord, positiveRoot, negativeRoot]

/-- The literal coroot word is natural, including its unit parameter. -/
theorem map_torusWord (P Q : Parameters) (f : ExtensionField P →+* ExtensionField Q)
    (i : Fin 4) (t : (ExtensionField P)ˣ) :
    RootPairing.SimpleGeckGroup.map f (torusWord P i t) =
      torusWord Q i (Units.map f.toMonoidHom t) := by
  simp only [torusWord, map_mul, map_weylWord, map_neg, map_one, Units.coe_map]
  rfl

/-- The four-coroot product is natural without changing its order. -/
theorem map_torusProduct (P Q : Parameters) (f : ExtensionField P →+* ExtensionField Q)
    (a : TorusCoordinates.Coordinates P) :
    RootPairing.SimpleGeckGroup.map f (TorusCoordinates.product P a) =
      TorusCoordinates.product Q (fun i => Units.map f.toMonoidHom (a i)) := by
  simp only [TorusCoordinates.product, map_mul, map_torusWord]

/-- Coefficient maps preserve the subgroup generated by the positive simple roots. -/
theorem map_mem_positive (P Q : Parameters) (f : ExtensionField P →+* ExtensionField Q)
    {x : SplitGroup P} (hx : x ∈ positiveSubgroup P) :
    RootPairing.SimpleGeckGroup.map f x ∈ positiveSubgroup Q := by
  have h : positiveSubgroup P ≤ (positiveSubgroup Q).comap
      (RootPairing.SimpleGeckGroup.map f) := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, t, rfl⟩
    change RootPairing.SimpleGeckGroup.map f (positiveRoot P i t) ∈ positiveSubgroup Q
    change RootPairing.SimpleGeckGroup.map f
      (RootPairing.SimpleGeckGroup.positive (typeDRootPairing_baseEquiv 2 i) t) ∈ _
    rw [RootPairing.SimpleGeckGroup.map_positive]
    exact Subgroup.subset_closure ⟨i, f t, rfl⟩
  exact h hx

/-- Coefficient maps preserve the subgroup generated by the coroot words. -/
theorem map_mem_torus (P Q : Parameters) (f : ExtensionField P →+* ExtensionField Q)
    {x : SplitGroup P} (hx : x ∈ splitTorus P) :
    RootPairing.SimpleGeckGroup.map f x ∈ splitTorus Q := by
  have h : splitTorus P ≤ (splitTorus Q).comap (RootPairing.SimpleGeckGroup.map f) := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, t, rfl⟩
    change RootPairing.SimpleGeckGroup.map f (torusWord P i t) ∈ splitTorus Q
    rw [map_torusWord]
    exact Subgroup.subset_closure ⟨i, _, rfl⟩
  exact h hx

/-- Every split Weyl representative has prime-field coefficients. -/
theorem map_weyl_fixed (P : Parameters) (e : ExtensionField P ≃+* ExtensionField P)
    {x : SplitGroup P} (hx : x ∈ splitWeylSubgroup P) :
    RootPairing.SimpleGeckGroup.map e.toRingHom x = x := by
  have h : splitWeylSubgroup P ≤ MulAut.fixedSubgroup (RootPairing.SimpleGeckGroup.equiv e) := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    apply (MulAut.mem_fixedSubgroup _ _).mpr
    change RootPairing.SimpleGeckGroup.map e.toRingHom (weylWord P i 1) = weylWord P i 1
    rw [map_weylWord, map_one]
  exact (MulAut.mem_fixedSubgroup _ _).mp (h hx)

/-- All split Weyl words lift along any coefficient-field embedding. -/
theorem weyl_le_range (P Q : Parameters) (f : ExtensionField P →+* ExtensionField Q) :
    splitWeylSubgroup Q ≤ (RootPairing.SimpleGeckGroup.map f).range := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  exact ⟨weylWord P i 1, (map_weylWord P Q f i 1).trans (by rw [map_one])⟩

/-- A fixed nonzero scalar lifts to a unit in the smaller field. -/
private theorem unit_lift (P Q : Parameters) (f : ExtensionField P →+* ExtensionField Q)
    (e : ExtensionField Q ≃+* ExtensionField Q)
    (hfield : ∀ t, e t = t → ∃ s, f s = t)
    (t : (ExtensionField Q)ˣ) (ht : Units.map e.toMonoidHom t = t) :
    ∃ s : (ExtensionField P)ˣ, Units.map f.toMonoidHom s = t := by
  obtain ⟨s, hs⟩ := hfield t.val (congrArg Units.val ht)
  have hs0 : s ≠ 0 := by
    intro h
    exact t.ne_zero (hs.symm.trans (h ▸ map_zero f))
  exact ⟨Units.mk0 s hs0, Units.ext hs⟩

/-- Uniqueness of positive coordinates turns fixed scalars into an actual group lift. -/
theorem positive_lift (n : ℕ) (hn : 0 < n) (P : Parameters)
    (f : ExtensionField P →+* ExtensionField (binaryParameters n hn))
    (e : ExtensionField (binaryParameters n hn) ≃+* ExtensionField (binaryParameters n hn))
    (hfield : ∀ t, e t = t → ∃ s, f s = t)
    (x : positiveSubgroup (binaryParameters n hn))
    (hx : RootPairing.SimpleGeckGroup.map e.toRingHom x.val = x.val) :
    x.val ∈ (RootPairing.SimpleGeckGroup.map f).range := by
  obtain ⟨a, ha, _⟩ := PositiveCoordinates.existsUnique_orderedProduct_binary n hn x
  have hfix : (fun i => e (a i)) = a :=
    PositiveCoordinates.orderedProduct_injective _
      ((map_orderedProduct _ _ e.toRingHom a).symm.trans
        ((congrArg (RootPairing.SimpleGeckGroup.map e.toRingHom) ha).trans (hx.trans ha.symm)))
  choose b hb using fun i => hfield (a i) (congrFun hfix i)
  refine ⟨PositiveCoordinates.orderedProduct P b, ?_⟩
  rw [map_orderedProduct]
  exact (congrArg (PositiveCoordinates.orderedProduct _) (funext hb)).trans ha

/-- Faithful coroot coordinates descend the actual torus in characteristic two. -/
theorem torus_lift (Q : Parameters) (hq : Q.prime = 2) (P : Parameters)
    (f : ExtensionField P →+* ExtensionField Q)
    (e : ExtensionField Q ≃+* ExtensionField Q)
    (hfield : ∀ t, e t = t → ∃ s, f s = t)
    (x : splitTorus Q) (hx : RootPairing.SimpleGeckGroup.map e.toRingHom x.val = x.val) :
    x.val ∈ (RootPairing.SimpleGeckGroup.map f).range := by
  obtain ⟨a, ha⟩ := (TorusCoordinates.range_product Q hq).ge x.property
  have hfix : (fun i => Units.map e.toMonoidHom (a i)) = a :=
    TorusCoordinates.product_injective Q hq
      ((map_torusProduct _ _ e.toRingHom a).symm.trans
        ((congrArg (RootPairing.SimpleGeckGroup.map e.toRingHom) ha).trans (hx.trans ha.symm)))
  choose b hb using fun i => unit_lift P Q f e hfield (a i) (congrFun hfix i)
  refine ⟨TorusCoordinates.product P b, ?_⟩
  rw [map_torusProduct]
  exact (congrArg (TorusCoordinates.product Q) (funext hb)).trans ha

end Triality.Standard.EvenField.SubfieldLifts
