module

public import Theory.GroupTheory.PerfectCentralCoverLocalSplitting
public import Theory.GroupTheory.NormalizedSupCard

/-!
# Two cubic relation defects and central transfer

A local product of chosen lifts need not be a homomorphism. If all of its
multiplication errors lie in the subgroup generated by two central elements
whose cubes are one, quotienting by those elements gives an actual section.
Their subgroup has order dividing nine. Transfer over a subgroup of index
prime to three then excludes 27 from the full perfect central kernel.

This works with arbitrary finite covering kernels, including mixed-prime
kernels. The construction of the local lifts and the index calculation remain
separate obligations. The concrete consumer is `ThreePrimary.lean` for the
PSU₄(3) row of Aschbacher--Smith I.1.4(5), printed p.408; see also GLS3 §6.1.
-/

public section
open Subgroup
namespace PerfectCentralCovering

variable {E G : Type*} [Group E] [Group G]

/-- Lifts of a literal local subgroup, with multiplication controlled by
two central cubic errors. No kernel cardinal bound is part of this data. -/
structure CubicDefectLift (f : Cover E G) (P : Subgroup G) where
  z : E
  w : E
  z_mem : z ∈ f.toMonoidHom.ker
  w_mem : w ∈ f.toMonoidHom.ker
  z_cube : z ^ 3 = 1
  w_cube : w ^ 3 = 1
  lift : P → E
  projects : ∀ x, f.toMonoidHom (lift x) = x
  multiplicative : ∀ x y, lift (x * y) * (lift x * lift y)⁻¹ ∈ zpowers z ⊔ zpowers w

namespace CubicDefectLift

variable {f : Cover E G} {P : Subgroup G} (L : CubicDefectLift f P)

/-- The subgroup generated by the two actual relation errors. -/
abbrev defect : Subgroup E := zpowers L.z ⊔ zpowers L.w

theorem defect_le_kernel : L.defect ≤ f.toMonoidHom.ker :=
  sup_le (zpowers_le.mpr L.z_mem) (zpowers_le.mpr L.w_mem)

theorem defect_normal : L.defect.Normal :=
  ⟨fun x hx g => by
    rw [mem_center_iff.mp (f.ker_le_center (L.defect_le_kernel hx)) g,
      mul_inv_cancel_right]
    exact hx⟩

/-- Centrality and the two cube identities bound the entire defect subgroup. -/
theorem defect_card_dvd_nine [Finite E] : Nat.card L.defect ∣ 9 := by
  have hn : zpowers L.w ≤ normalizer (zpowers L.z : Set E) :=
    (zpowers_le.mpr (f.ker_le_center L.w_mem)).trans (center_le_normalizer _)
  have he := card_mul_eq_card_inf_mul_card_sup_of_normalizes
    (zpowers L.z) (zpowers L.w) hn
  have hd : Nat.card L.defect ∣ Nat.card (zpowers L.z) * Nat.card (zpowers L.w) := by
    rw [he]
    exact dvd_mul_left _ _
  have hz : Nat.card (zpowers L.z) ∣ 3 := by
    rw [Nat.card_zpowers]
    exact orderOf_dvd_of_pow_eq_one L.z_cube
  have hw : Nat.card (zpowers L.w) ∣ 3 := by
    rw [Nat.card_zpowers]
    exact orderOf_dvd_of_pow_eq_one L.w_cube
  exact hd.trans (Nat.mul_dvd_mul hz hw)

/-- Killing the actual relation errors gives a section with the original projection. -/
theorem exists_quotient_section :
    ∃ (_hN : L.defect.Normal) (s : P →* E ⧸ L.defect),
      (f.quotientKernelSubgroup L.defect L.defect_le_kernel).toMonoidHom.comp s =
        P.subtype := by
  let hN := L.defect_normal
  let q := QuotientGroup.mk' L.defect
  have hm (x y : P) : q (L.lift (x * y)) = q (L.lift x) * q (L.lift y) := by
    have h := (QuotientGroup.eq_one_iff _).mpr (L.multiplicative x y)
    change q (L.lift (x * y) * (L.lift x * L.lift y)⁻¹) = 1 at h
    simpa only [map_mul, map_inv, mul_inv_eq_one] using h
  let s : P →* E ⧸ L.defect :=
    { toFun := fun x => q (L.lift x)
      map_one' := by
        apply mul_left_cancel (a := q (L.lift 1))
        simpa only [one_mul, mul_one] using (hm 1 1).symm
      map_mul' := hm }
  refine ⟨hN, s, MonoidHom.ext fun x => ?_⟩
  exact L.projects x

include L in
/-- Two central cubic relation errors bound the three-part of any perfect
central kernel, provided the literal local subgroup has index prime to three. -/
theorem not_twentySeven_dvd_kernel [Finite E] [Finite G]
    (hi : ¬ 3 ∣ P.index) : ¬ 27 ∣ Nat.card f.toMonoidHom.ker := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  obtain ⟨hN, s, hs⟩ := exists_quotient_section L
  let : L.defect.Normal := hN
  have hb : Nat.card L.defect ≤ 9 := Nat.le_of_dvd (by decide) L.defect_card_dvd_nine
  intro hd
  have hD : 3 ^ 3 ∣ Nat.card L.defect :=
    (f.prime_pow_dvd_kernel_iff_of_quotient_section L.defect L.defect_le_kernel P hi s hs 3).mp hd
  have h27 := Nat.le_of_dvd (Nat.card_pos (α := L.defect)) hD
  norm_num at h27
  omega

end CubicDefectLift
end PerfectCentralCovering
