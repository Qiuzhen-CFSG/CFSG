module

public import Theory.SpecificGroups.ClassicalUnitary.UnitaryFourThree.IsotropicStabilizers.Coordinates

/-!
# The positive unitary subgroup used by the three-primary calculation

Work with the actual antidiagonal Hermitian form over `FiniteField.Nine`.
The coordinate subgroup is generated by its upper unitriangular SU matrices.
Project to the actual image in PGL, then transport along the proved Hermitian
model equivalence to the prescribed identity-form carrier `Carrier 4`.

This fixes the maps shared by the separate index and lifted-relation
calculations. Its Sylow property and index are not assumed or asserted here.
Source: the defining-prime local calculation for Aschbacher--Smith I.1.4(5),
printed p.408; GLS3 §6.1 and the classical unitary conventions in chapter 2.
-/

public noncomputable section
namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary

open Theory.SpecificGroups.ClassicalUnitary
open UnitaryFourThree UnitaryFourThree.IsotropicStabilizers

abbrev S := UnitaryFourThree.Carrier 4
abbrev CoordinateSU := coordinateForm.specialSubgroup

/-- The coordinate upper unitriangular special unitary matrices. -/
@[expose] def positiveGenerators : Set CoordinateSU :=
  {g | (∀ i j : Fin 4, j < i → g.val.val i j = 0) ∧
    ∀ i : Fin 4, g.val.val i i = 1}

/-- The positive subgroup before taking the scalar quotient. -/
@[expose] def positiveSU : Subgroup CoordinateSU := Subgroup.closure positiveGenerators

/-- The actual change-of-form equivalence, including the projective scalar quotient. -/
@[expose] def coordinateEquiv : CoordinateCarrier ≃* S :=
  Classical.choice (UnitaryFourThree.exists_model_equiv coordinateForm
    FiniteField.Nine.natCard coordinateForm_conj_cube)

/-- The marked projection of the coordinate SU group onto the task's fixed carrier. -/
@[expose] def coordinateProjection : CoordinateSU →* S :=
  coordinateEquiv.toMonoidHom.comp
    (UnitaryFourFlag.project FiniteField.Nine coordinateForm)

theorem coordinateProjection_surjective : Function.Surjective coordinateProjection :=
  coordinateEquiv.surjective.comp
    (UnitaryFourFlag.project_surjective FiniteField.Nine coordinateForm)

/-- The literal subgroup on which the lifted root products will be defined. -/
@[expose] def positive : Subgroup S := positiveSU.map coordinateProjection

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary
