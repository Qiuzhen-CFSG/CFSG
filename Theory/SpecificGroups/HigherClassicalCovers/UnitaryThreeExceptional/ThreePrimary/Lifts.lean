module

public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.Coordinates
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.DefectTransfer
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.Lifts.FiniteRelations
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.Lifts.LiftedRelations
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.Lifts.PresentationIdentification

/-!
# Cubic-defect lifts on the positive unitary subgroup

The six marked roots generate the entire prescribed positive subgroup, and
their six cube relations and fifteen descending swaps give its presentation.
Normalized root lifts satisfy those relations modulo the subgroup generated
by two central cubic elements: the first collection error and the mixed
commutator. Evaluating the presentation in that quotient and choosing
representatives gives CubicDefectLift on the original positive subgroup.

Both inputs to the conditional assembly are proved here using the imported
root calculations. This supplies the order-27 lifting premise `hlifts` of
`ThreePrimary.not_twentySeven_dvd_kernel_of_order27_lifts`. The local result
in fact needs neither finiteness nor a restriction on the covering degree.
The positive subgroup's prime-to-three index remains a separate input to
that consumer.

Source: the three-primary part of Aschbacher--Smith I.1.4(5), printed p.408,
and GLS3 §6.1. The scalar quotient and coordinateProjection are unchanged.
-/

public section
namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary
open PerfectCentralCovering

/-- The two independent finite obligations suffice for the literal lifting contract. -/
theorem nonempty_cubicDefectLift_of_finiteRelations
    (hp : Function.Bijective RootLifts.presentationProjection)
    {E : Type*} [Group E] (f : Cover E S)
    (hrelations : Nonempty (RootLifts.FiniteDefectRelations f)) :
    Nonempty (CubicDefectLift f positive) := by
  obtain ⟨D⟩ := hrelations
  exact D.nonempty_cubicDefectLift hp

/-- Actual lifts on the entire marked positive subgroup, with every product
error generated by two central cubic elements. Both the presentation and
the lifted relations are discharged by the unitary root calculations. -/
theorem nonempty_cubicDefectLift {E : Type*} [Group E] (f : Cover E S) :
    Nonempty (CubicDefectLift f positive) :=
  nonempty_cubicDefectLift_of_finiteRelations
    RootLifts.presentationProjection_bijective f
    (RootLifts.nonempty_finiteDefectRelations f)

/-- The exact degree-27 premise `hlifts` in
`not_twentySeven_dvd_kernel_of_order27_lifts`. The stronger local construction
does not use the covering degree or an exponent assumption on the kernel. -/
theorem nonempty_cubicDefectLift_of_order27
    {E : Type*} [Group E] [Finite E] (f : Cover E S)
    (_hcard : Nat.card f.toMonoidHom.ker = 27) :
    Nonempty (CubicDefectLift f positive) :=
  nonempty_cubicDefectLift f

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary
