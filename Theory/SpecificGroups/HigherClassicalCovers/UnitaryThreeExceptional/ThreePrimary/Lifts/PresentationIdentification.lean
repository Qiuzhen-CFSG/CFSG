module

public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.Lifts.Presentation
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.Lifts.PresentationIdentification.Collection
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.Lifts.PresentationIdentification.Matrices

/-!
# Identification of the marked positive unitary presentation

Every abstract presentation word has six ternary exponents. The same six
root powers give every element of the published positive SU subgroup, and
their matrix entries distinguish all exponent tuples even after the scalar
quotient. Hence the original marked presentation projection is bijective.

This supplies exactly the presentation premise `hp` in
`ThreePrimary.nonempty_cubicDefectLift_of_finiteRelations`; construction of
the cubic root defects remains the responsibility of that theorem's owner.
Source: Aschbacher--Smith I.1.4(5), printed p.408, and GLS3 §6.1, with the
antidiagonal unitary conventions of GLS3 chapter 2.
-/

@[expose] public noncomputable section
namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.RootLifts

/-- The matrix product uses exactly the generator order in the abstract normal form. -/
theorem ternaryWord_rootSU (v : Parameters) : ternaryWord rootSU v = rootProduct v := by
  simp [ternaryWord, rootProduct, List.ofFn_succ, mul_assoc]

private theorem ternaryWord_mem {G : Type*} [Group G] {n : ℕ} (H : Subgroup G)
    (x : Fin n → G) (hx : ∀ i, x i ∈ H) (v : Fin n → Fin 3) :
    ternaryWord x v ∈ H := by
  apply H.list_prod_mem
  intro a ha
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp ha
  exact H.pow_mem (hx i) _

/-- The published positive subgroup is generated by the six literal SU roots. -/
theorem positiveSU_eq_closure_roots : positiveSU = Subgroup.closure (Set.range rootSU) := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    obtain ⟨v, rfl⟩ := positiveGenerator_normal_form g hg
    rw [← ternaryWord_rootSU]
    exact ternaryWord_mem (Subgroup.closure (Set.range rootSU)) rootSU
      (fun i => Subgroup.subset_closure (Set.mem_range_self i)) v
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨i, rfl⟩
    exact rootSU_mem i

/-- Every element of the entire positive SU subgroup has the marked normal form. -/
theorem positiveSU_normal_form (g : CoordinateSU) (hg : g ∈ positiveSU) :
    ∃ v : Parameters, rootProduct v = g := by
  rw [positiveSU_eq_closure_roots] at hg
  obtain ⟨v,hv⟩ := normal_form_of_root_relations rootSU rootSU_cube rootSU_swap g hg
  exact ⟨v, (ternaryWord_rootSU v).symm.trans hv⟩

/-- Taking the scalar quotient does not identify two marked normal forms. -/
theorem projectedRootProduct_injective :
    Function.Injective (fun v : Parameters => coordinateProjection (rootProduct v)) := by
  intro v w h
  apply rootProduct_injective
  apply coordinateProjection_injective_at_unit_entry (he := h)
  · rw [rootProduct_matrix]; rfl
  · rw [rootProduct_matrix]; rfl

/-- The fixed scalar projection is faithful on the entire upper unitriangular subgroup. -/
theorem positiveSU_projection_injective :
    Function.Injective (coordinateProjection.comp positiveSU.subtype) := by
  rintro ⟨g,hg⟩ ⟨h,hh⟩ he
  obtain ⟨v,rfl⟩ := positiveSU_normal_form g hg
  obtain ⟨w,rfl⟩ := positiveSU_normal_form h hh
  apply Subtype.ext
  exact congrArg rootProduct (projectedRootProduct_injective he)

/-- The abstract normal form projects to the same six actual root matrices. -/
theorem presentationProjection_ternaryWord (v : Parameters) :
    (presentationProjection (ternaryWord presentationRoot v) : S) =
      coordinateProjection (rootProduct v) := by
  change (positive.subtype.comp presentationProjection) (ternaryWord presentationRoot v) = _
  rw [map_ternaryWord, ← ternaryWord_rootSU, map_ternaryWord]
  congr 1
  funext i
  change (presentationProjection (PresentedGroup.of i) : S) = coordinateProjection (rootSU i)
  rw [presentationProjection_of]
  rfl

/-- Completeness of the six cubes and fifteen swaps for the marked projection. -/
theorem presentationProjection_injective : Function.Injective presentationProjection := by
  intro x y h
  obtain ⟨v,rfl⟩ := presentation_normal_form x
  obtain ⟨w,rfl⟩ := presentation_normal_form y
  have hs := congrArg (fun z : positive => (z : S)) h
  rw [presentationProjection_ternaryWord, presentationProjection_ternaryWord] at hs
  rw [projectedRootProduct_injective hs]

/-- The marked presentation maps onto the entire published positive subgroup. -/
theorem presentationProjection_surjective : Function.Surjective presentationProjection := by
  rintro ⟨g,hg⟩
  obtain ⟨u,hu,rfl⟩ := hg
  obtain ⟨v,rfl⟩ := positiveSU_normal_form u hu
  refine ⟨ternaryWord presentationRoot v, ?_⟩
  exact Subtype.ext (presentationProjection_ternaryWord v)

/-- Identification of the literal finite root presentation, with all six generators marked.
This discharges `hp` in `ThreePrimary.nonempty_cubicDefectLift_of_finiteRelations`. -/
theorem presentationProjection_bijective : Function.Bijective presentationProjection :=
  ⟨presentationProjection_injective, presentationProjection_surjective⟩

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.RootLifts
