module

public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.Coordinates
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.PrimePowerReduction
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary.DefectTransfer

/-!
# Reduction of the PSU₄(3) three-primary upper bound to local root lifts

If 27 divides the kernel of a finite perfect central cover, a central quotient
is again a perfect cover of the same actual projective unitary group and has
kernel order exactly 27. On this quotient it suffices to construct products
of root lifts whose errors are generated by two central cubic elements.
Killing those elements gives a section on the prescribed positive subgroup;
its prime-to-three index then supplies the transfer contradiction.

The theorem here is conditional: the positive subgroup's index and the
degree-27 lifted-relation construction must still be proved. It does not
establish Aschbacher--Smith I.1.4(5), printed p.408, or the three-primary
multiplier entry in GLS3 §6.1. The eventual unconditional theorem will
discharge `h3` in `UnitaryThreeExceptional.kernel_card_dvd_thirtySix_of_primary_bounds`.
The parent assembly is deliberately not imported, avoiding a cycle.
-/

public section
namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary
open PerfectCentralCovering

universe u

/-- Concrete local lifts for degree 27 suffice for every finite perfect
cover of the fixed matrix carrier, including all mixed-prime kernels. -/
theorem not_twentySeven_dvd_kernel_of_order27_lifts
    (hindex : ¬ 3 ∣ positive.index)
    (hlifts : ∀ (D : Type u) [Group D] [Finite D] (g : Cover D S),
      Nat.card g.toMonoidHom.ker = 27 → Nonempty (CubicDefectLift g positive))
    {E : Type u} [Group E] [Finite E] (f : Cover E S) :
    ¬ 27 ∣ Nat.card f.toMonoidHom.ker := by
  let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  apply f.not_primePower_dvd_card_kernel_of_no_primePower_kernel (p := 3) 3
  intro D _ _ g hg
  obtain ⟨L⟩ := hlifts D g hg
  exact L.not_twentySeven_dvd_kernel hindex (hg ▸ dvd_rfl)

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreePrimary
