module

public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreeCover.Construction

/-!
# The central three-point blocks of the degree-756 action

The 252 labels below enumerate the orbits of the displayed central subgroup.
Generator compatibility and the two central identities are kernel-checked.
No identification of the generated block group with PSU₄(3) is asserted here.
The numbers are derived from `ThreeCover/source/permutations.json`, retaining
its inverse-table convention for Lean's left actions. Source: ATLAS U₄(3),
representation `9U43D8G1-p756aB0`; Aschbacher–Smith I.1.4(5), printed p.408.
-/

@[expose] public section
namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreeCover.BlockAction

set_option Elab.async false

abbrev Block := Fin 252

def blockOf (p : Point) : Block :=
  ⟨(( : Nat) >>> (8 * p.val)) % 256 % 252, Nat.mod_lt _ (by decide)⟩

def representative (p : Block) : Point :=
  ⟨(( : Nat) >>> (10 * p.val)) % 1024 % 756, Nat.mod_lt _ (by decide)⟩

def unpackBlock (code : Nat) (p : Block) : Block :=
  ⟨(code >>> (8 * p.val)) % 256 % 252, Nat.mod_lt _ (by decide)⟩

def blockAFn : Block → Block := unpackBlock 
def blockBFn : Block → Block := unpackBlock 
def blockBInvFn : Block → Block := unpackBlock 

private theorem a_involutive : Function.Involutive blockAFn := by
  change ∀ p, blockAFn (blockAFn p) = p
  decide +kernel
private theorem b_left_inverse : Function.LeftInverse blockBInvFn blockBFn := by
  change ∀ p, blockBInvFn (blockBFn p) = p
  decide +kernel
private theorem b_right_inverse : Function.RightInverse blockBInvFn blockBFn := by
  change ∀ p, blockBFn (blockBInvFn p) = p
  decide +kernel

/-- The induced first generator on the 252 central blocks. -/
def blockA : Equiv.Perm Block := ⟨blockAFn, blockAFn, by exact a_involutive, by exact a_involutive⟩

/-- The induced second generator on the 252 central blocks. -/
def blockB : Equiv.Perm Block := ⟨blockBFn, blockBInvFn, by exact b_left_inverse, by exact b_right_inverse⟩

/-- A literal permutation group, without an attached family identification. -/
def blockGenerated : Subgroup (Equiv.Perm Block) :=
  Subgroup.closure ({blockA, blockB} : Set (Equiv.Perm Block))

abbrev Model := blockGenerated

def generatorA : Model := ⟨blockA, Subgroup.subset_closure (Set.mem_insert _ _)⟩
def generatorB : Model :=
  ⟨blockB, Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)⟩

theorem blockOf_representative : ∀ p, blockOf (representative p) = p := by decide +kernel

theorem blockOf_surjective : Function.Surjective blockOf :=
  fun p => ⟨representative p, blockOf_representative p⟩

theorem blockOf_a : ∀ p, blockOf (a p) = blockA (blockOf p) := by decide +kernel

theorem blockOf_b : ∀ p, blockOf (b p) = blockB (blockOf p) := by decide +kernel

theorem blockOf_z₁ : ∀ p, blockOf (z₁ p) = blockOf p := by decide +kernel

theorem blockOf_z₂ : ∀ p, blockOf (z₂ p) = blockOf p := by decide +kernel

/-- The nine central elements independently realize every pair of images of
points 0 and 1 within their respective blocks. -/
theorem central_base_images (p q : Point)
    (hp : blockOf p = blockOf 0) (hq : blockOf q = blockOf 1) :
    ∃ t : KernelCoordinates, (kernelEmbedding t).val 0 = p ∧
      (kernelEmbedding t).val 1 = q := by
  have h₀ : ∀ p : Point, blockOf p = blockOf 0 → p = 0 ∨ p = 371 ∨ p = 396 := by
    decide +kernel
  have h₁ : ∀ q : Point, blockOf q = blockOf 1 → q = 1 ∨ q = 251 ∨ q = 274 := by
    decide +kernel
  rcases h₀ p hp with rfl | rfl | rfl <;>
    rcases h₁ q hq with rfl | rfl | rfl <;>
      simp only [kernelEmbedding_val] <;> decide +kernel

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreeCover.BlockAction
