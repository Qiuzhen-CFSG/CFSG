module

public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreeCover.PermutationData
public import Theory.GroupTheory.PerfectCentralCover
public import Mathlib.GroupTheory.Abelianization.Defs
public import Mathlib.Data.ZMod.Basic

/-!
# A concrete perfect group with a central elementary subgroup of order nine

The two displayed permutations generate `Carrier`. Their relations force every
abelian image to be trivial. Two explicit seventh powers commute with both
generators and have order dividing three; their values at points 0 and 1
prove that they generate a copy of C₃ × C₃. Thus quotienting by that displayed
subgroup gives an actual finite perfect central cover with the desired kernel.

Identifying the quotient with the literal PSU₄(3) image is a separate, still
needed theorem. No unitary identification or recognition by order is assumed
in this module. The construction is the lower-cover part of Aschbacher–Smith
I.1.4(5), printed p.408; see also GLS3 Table 6.1.3. Numerical provenance is in
`PermutationData` and `source/README.md`.
-/

public section
namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreeCover

open PerfectCentralCovering
open scoped IsMulCommutative

private theorem abelian_trivial {G : Type*} [CommGroup G] (x y : G)
    (hx : x^2=1) (hy : y^6=1) (hxy : (x*y)^7=1)
    (hw : (x*y*x*y^2*x*y^3)^21=1) : x=1 ∧ y=1 := by
  have hp6 : (x*y)^6=1 := by
    rw [mul_pow, show (6:ℕ)=2*3 from rfl, pow_mul, hx, one_pow]
    simpa using hy
  have hp : x*y=1 := by
    have h := hxy
    rw [show (7:ℕ)=6+1 from rfl, pow_succ, hp6, one_mul] at h
    exact h
  have hxx : x*x=1 := by simpa only [pow_two] using hx
  have hyy : y=x := by
    apply mul_left_cancel (a := x)
    exact hp.trans hxx.symm
  have hx3 : x^3=x := by rw [pow_succ, hx, one_mul]
  have hw' : (x*y*x*y^2*x*y^3)=x := by
    rw [hyy, hx, hx3, hxx, one_mul, mul_one, hxx, one_mul]
  rw [hw'] at hw
  have hx21 : x^21=x := by
    rw [show (21:ℕ)=2*10+1 from rfl, pow_succ, pow_mul, hx, one_pow, one_mul]
  rw [hx21] at hw
  exact ⟨hw, hyy.trans hw⟩

private theorem perfect_of_relations {G : Type*} [Group G] (a b : G)
    (ha : a^2=1) (hb : b^6=1) (hab : (a*b)^7=1)
    (hw : (a*b*a*b^2*a*b^3)^21=1) :
    Group.IsPerfect (Subgroup.closure ({a,b}:Set G)) := by
  let H := Subgroup.closure ({a,b}:Set G)
  let aH : H := ⟨a, Subgroup.subset_closure (Set.mem_insert _ _)⟩
  let bH : H := ⟨b, Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)⟩
  have hgen : Subgroup.closure ({aH,bH}:Set H)=⊤ := by
    apply Subgroup.map_injective H.subtype_injective
    rw [MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton]
    change H=(⊤:Subgroup H).map H.subtype
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  have hA : aH^2=1 := Subtype.ext ha
  have hB : bH^6=1 := Subtype.ext hb
  have hAB : (aH*bH)^7=1 := Subtype.ext hab
  have hW : (aH*bH*aH*bH^2*aH*bH^3)^21=1 := Subtype.ext hw
  have hp := abelian_trivial (Abelianization.of aH) (Abelianization.of bH)
    (by simpa using congrArg Abelianization.of hA)
    (by simpa using congrArg Abelianization.of hB)
    (by simpa using congrArg Abelianization.of hAB)
    (by simpa using congrArg Abelianization.of hW)
  refine ⟨top_unique ?_⟩
  rw [← Abelianization.ker_of, ← hgen, Subgroup.closure_le]
  intro z hz
  rcases hz with rfl | hz
  · exact hp.1
  · exact (Set.mem_singleton_iff.mp hz) ▸ hp.2

private def cubicHom {G : Type*} [Group G] (z : G) (hz : z^3=1) :
    Multiplicative (ZMod 3) →* G where
  toFun t := z ^ t.toAdd.val
  map_one' := by simp
  map_mul' x y := by
    change z ^ (x.toAdd+y.toAdd).val = _
    rw [ZMod.val_add, ← pow_add]
    exact (pow_eq_pow_mod _ hz).symm

/-- The subgroup generated by the two certified permutations. -/
@[expose] def generated : Subgroup Perm := Subgroup.closure ({a, b} : Set Perm)

/-- A concrete carrier, independent of any group-family label. -/
abbrev Carrier := generated

private theorem a_mem : a ∈ generated :=
  Subgroup.subset_closure (Set.mem_insert _ _)

private theorem b_mem : b ∈ generated :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)

/-- Perfectness follows from the displayed relations, not a group order calculation. -/
instance carrierPerfect : Group.IsPerfect Carrier := by
  apply perfect_of_relations a b a_sq b_six ab_seven
  rw [show (21 : ℕ) = 7 * 3 from rfl, pow_mul, ← z₂_word, z₂_cube]

/-- Finiteness is inherited from the permutation group. -/
theorem carrier_finite : Finite Carrier := inferInstance

private theorem z₁_mem : z₁ ∈ generated := by
  rw [z₁_word]
  exact generated.pow_mem
    (generated.mul_mem (generated.mul_mem (generated.mul_mem a_mem b_mem) a_mem)
      (generated.pow_mem b_mem 3)) 7

private theorem z₂_mem : z₂ ∈ generated := by
  rw [z₂_word]
  exact generated.pow_mem
    (generated.mul_mem
      (generated.mul_mem
        (generated.mul_mem (generated.mul_mem (generated.mul_mem a_mem b_mem) a_mem)
          (generated.pow_mem b_mem 2)) a_mem)
      (generated.pow_mem b_mem 3)) 7

private theorem central_of_generators (z : Perm) (hz : z ∈ generated)
    (ha : Commute z a) (hb : Commute z b) :
    (⟨z, hz⟩ : Carrier) ∈ Subgroup.center Carrier := by
  have hc : z ∈ Subgroup.centralizer ({a, b} : Set Perm) := by
    intro x hx
    rcases hx with rfl | hx
    · exact ha.eq.symm
    · exact (Set.mem_singleton_iff.mp hx) ▸ hb.eq.symm
  have hc' : z ∈ Subgroup.centralizer (generated : Set Perm) := by
    simpa only [generated, Subgroup.centralizer_closure] using hc
  apply Subgroup.mem_center_iff.mpr
  intro x
  exact Subtype.ext (hc' x.val x.property)

/-- The first marked central element. -/
def central₁ : Subgroup.center Carrier :=
  ⟨⟨z₁, z₁_mem⟩, central_of_generators z₁ z₁_mem z₁_commute_a z₁_commute_b⟩

/-- The second marked central element. -/
def central₂ : Subgroup.center Carrier :=
  ⟨⟨z₂, z₂_mem⟩, central_of_generators z₂ z₂_mem z₂_commute_a z₂_commute_b⟩

private theorem central₁_cube : central₁ ^ 3 = 1 := by
  apply Subtype.ext
  exact Subtype.ext z₁_cube

private theorem central₂_cube : central₂ ^ 3 = 1 := by
  apply Subtype.ext
  exact Subtype.ext z₂_cube

abbrev KernelCoordinates := Multiplicative (ZMod 3) × Multiplicative (ZMod 3)

/-- The marked two-dimensional elementary group maps into the actual center. -/
def toCenter : KernelCoordinates →* Subgroup.center Carrier :=
  (cubicHom central₁ central₁_cube).coprod (cubicHom central₂ central₂_cube)

/-- Inclusion of the two central coordinates in the permutation carrier. -/
def kernelEmbedding : KernelCoordinates →* Carrier :=
  (Subgroup.center Carrier).subtype.comp toCenter

@[simp] theorem kernelEmbedding_val (t : KernelCoordinates) :
    (kernelEmbedding t).val = z₁ ^ t.1.toAdd.val * z₂ ^ t.2.toAdd.val := by rfl

private theorem coordinates_separate :
    Function.Injective (fun t : KernelCoordinates =>
      ((z₁ ^ t.1.toAdd.val * z₂ ^ t.2.toAdd.val) (0 : Point),
       (z₁ ^ t.1.toAdd.val * z₂ ^ t.2.toAdd.val) (1 : Point))) := by
  change ∀ x y : KernelCoordinates, _ → x = y
  decide +kernel

/-- Values on just two points certify independence of the two central generators. -/
theorem kernelEmbedding_injective : Function.Injective kernelEmbedding := by
  intro x y h
  apply coordinates_separate
  simpa only [kernelEmbedding_val] using
    congrArg (fun g : Carrier => (g.val 0, g.val 1)) h

/-- The displayed elementary subgroup, with both independent factors retained. -/
@[expose] def centralSubgroup : Subgroup Carrier := kernelEmbedding.range

theorem centralSubgroup_le_center : centralSubgroup ≤ Subgroup.center Carrier := by
  rintro x ⟨t, rfl⟩
  exact (toCenter t).property

instance centralSubgroup_normal : centralSubgroup.Normal where
  conj_mem x hx g := by
    rw [(Subgroup.mem_center_iff.mp (centralSubgroup_le_center hx)) g,
      mul_inv_cancel_right]
    exact hx

/-- The actual quotient by the displayed elementary central subgroup. -/
abbrev Projective := Carrier ⧸ centralSubgroup

/-- The marked coordinate equivalence does not use a cardinality calculation. -/
noncomputable def coordinatesEquiv : KernelCoordinates ≃* centralSubgroup :=
  MulEquiv.ofBijective kernelEmbedding.rangeRestrict
    ⟨fun _ _ h => kernelEmbedding_injective
      (congrArg (fun z : centralSubgroup => (z : Carrier)) h),
      kernelEmbedding.rangeRestrict_surjective⟩

/-- An unconditional perfect central cover of the explicit quotient. -/
def quotientCover : Cover Carrier Projective where
  toMonoidHom := QuotientGroup.mk' centralSubgroup
  surjective := QuotientGroup.mk'_surjective _
  isPerfect := inferInstance
  ker_le_center := by
    rw [QuotientGroup.ker_mk']
    exact centralSubgroup_le_center

/-- Its literal kernel is the independent product C₃ × C₃. -/
noncomputable def quotientKernelEquiv :
    quotientCover.toMonoidHom.ker ≃* KernelCoordinates :=
  (MulEquiv.subgroupCongr (QuotientGroup.ker_mk' centralSubgroup)).trans
    coordinatesEquiv.symm

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreeCover
