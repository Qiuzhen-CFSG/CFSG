module

public import Mathlib.Data.Fintype.Perm
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Permutations for an exceptional unitary covering candidate

Four permutations on 756 points are stored as packed natural numbers (ten bits
per image). The inverse and word identities below are checked by kernel
reduction. The generated group is not identified with a unitary cover here.

The generators were found in the second derived subgroup of the ATLAS
representation `9U43D8G1-p756aB0`. Numerical data and their provenance are
retained in `source/`; no external group calculation is used as a proof.
GAP uses right actions, so the tables give inverses of its permutations.
Source: R. A. Wilson et al., ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/clas/U43/ ; the intended mathematical
application is Aschbacher–Smith I.1.4(5), printed p.408, and GLS3 Table 6.1.3.
-/

@[expose] public section
namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreeCover

-- Sequential declaration checking avoids retaining several large reductions together.
set_option Elab.async false

abbrev Point := Fin 756
abbrev Perm := Equiv.Perm Point

def unpack (n : Nat) (i : Point) : Point :=
  ⟨((n >>> (10 * i.val)) % 1024) % 756, Nat.mod_lt _ (by decide)⟩

def aCode : Nat := 

def aFn : Point → Point := unpack aCode

private theorem aFn_involutive : ∀ i, aFn (aFn i) = i := by decide +kernel

/-- The first generator, an involution. -/
def a : Perm where
  toFun := aFn
  invFun := aFn
  left_inv := by exact aFn_involutive
  right_inv := by exact aFn_involutive

theorem a_sq : a ^ 2 = 1 := by
  apply Equiv.ext
  exact aFn_involutive

def bCode : Nat := 

def bFn : Point → Point := unpack bCode

def bInvCode : Nat := 

def bInvFn : Point → Point := unpack bInvCode

private theorem bFn_inverse : ∀ i, bInvFn (bFn i) = i := by decide +kernel

/-- The second generator, of order dividing six. -/
def b : Perm where
  toFun := bFn
  invFun := bInvFn
  left_inv := by exact bFn_inverse
  right_inv := by
    exact Function.LeftInverse.rightInverse_of_surjective bFn_inverse
      (Finite.surjective_of_injective (Function.LeftInverse.injective bFn_inverse))

theorem b_six : b ^ 6 = 1 := by decide +kernel

theorem ab_seven : (a * b) ^ 7 = 1 := by decide +kernel

def z₁Code : Nat := 

def z₁Fn : Point → Point := unpack z₁Code

private theorem z₁Fn_cube : ∀ i, z₁Fn (z₁Fn (z₁Fn i)) = i := by
  decide +kernel

/-- A displayed central element, with membership in the generated group proved below. -/
def z₁ : Perm where
  toFun := z₁Fn
  invFun := z₁Fn ∘ z₁Fn
  left_inv := by exact z₁Fn_cube
  right_inv := by exact z₁Fn_cube

theorem z₁_cube : z₁ ^ 3 = 1 := by
  apply Equiv.ext
  exact z₁Fn_cube

def z₂Code : Nat := 

def z₂Fn : Point → Point := unpack z₂Code

private theorem z₂Fn_cube : ∀ i, z₂Fn (z₂Fn (z₂Fn i)) = i := by
  decide +kernel

/-- A displayed central element, with membership in the generated group proved below. -/
def z₂ : Perm where
  toFun := z₂Fn
  invFun := z₂Fn ∘ z₂Fn
  left_inv := by exact z₂Fn_cube
  right_inv := by exact z₂Fn_cube

theorem z₂_cube : z₂ ^ 3 = 1 := by
  apply Equiv.ext
  exact z₂Fn_cube

/-- The first central element is an explicit seventh power. -/
theorem z₁_word : z₁ = (a * b * a * b ^ 3) ^ 7 := by decide +kernel

/-- The second central element is independent of the first. -/
theorem z₂_word : z₂ = (a * b * a * b ^ 2 * a * b ^ 3) ^ 7 := by decide +kernel

theorem z₁_commute_a : Commute z₁ a := by
  change z₁ * a = a * z₁
  decide +kernel

theorem z₁_commute_b : Commute z₁ b := by
  change z₁ * b = b * z₁
  decide +kernel

theorem z₂_commute_a : Commute z₂ a := by
  change z₂ * a = a * z₂
  decide +kernel

theorem z₂_commute_b : Commute z₂ b := by
  change z₂ * b = b * z₂
  decide +kernel

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryThreeExceptional.ThreeCover
