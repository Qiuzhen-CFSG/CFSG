def decodeFour (k : ℕ) : F := ⟨(k % 2 : ℕ), ((k / 2) % 2 : ℕ)⟩

def unitaryPrefix (r : Fin 11) (k : ℕ) : Matrix (Fin 4) (Fin 4) F :=
  fun i j => decodeFour (unitaryPrefixCode r (Fin.ofNat 25 k) / 4 ^ (4*i.val+j.val) % 4)

def symplecticPrefix (r : Fin 11) (k : ℕ) :
    Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) (ZMod 3) :=
  fun i j => (symplecticPrefixCode r (Fin.ofNat 25 k) /
    3 ^ (4*(symplecticCoordinate i).val+(symplecticCoordinate j).val) % 3 : ℕ)

