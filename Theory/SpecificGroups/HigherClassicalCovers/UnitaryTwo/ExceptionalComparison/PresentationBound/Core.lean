module

public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryTwo.ExceptionalComparison.Words
public import Theory.GroupTheory.CosetWordCertificateBoolean
public import Mathlib.Data.ZMod.QuotientGroup

/-!
# The cyclic subgroup for the exceptional presentation bound

The second literal relator is `b⁶`. Consequently the subgroup generated by
the second canonical generator has at most six elements, without any ambient
finiteness assumption. A certified cover with 4320 representatives will give
the bound 25920 needed for the exceptional comparison.

Source purpose: GLS3 §2.2, the exceptional-isomorphism table; the comparison
is used for Aschbacher–Smith I.1.4(1), printed p.408.
-/

@[expose] public section
namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryTwo.ExceptionalComparison.PresentationBound

open Subgroup.CosetWordCertificate

abbrev generator : Fin 2 → Presentation := PresentedGroup.of

def cyclic : Subgroup Presentation := Subgroup.zpowers (generator 1)

theorem relator_eval (i : Fin 11) : eval generator (relatorWord i) = 1 :=
  presentation_relator i

theorem generator_pow_six : generator 1 ^ 6 = 1 := by
  simpa [eval, relatorWord, FreeGroup.lift_mk, List.prod_cons, pow_succ, mul_assoc]
    using relator_eval 1

theorem cyclic_bound : Finite cyclic ∧ Nat.card cyclic ≤ 6 := by
  have hx : IsOfFinOrder (generator 1) :=
    isOfFinOrder_iff_pow_eq_one.mpr ⟨6, by decide, generator_pow_six⟩
  refine ⟨hx.finite_zpowers.to_subtype, ?_⟩
  change Nat.card (Subgroup.zpowers (generator 1)) ≤ 6
  rw [Nat.card_zpowers]
  exact orderOf_le_of_pow_eq_one (by decide) generator_pow_six

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryTwo.ExceptionalComparison.PresentationBound
