module

public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryTwo.ExceptionalComparison.PresentationBound.Realization
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryTwo.ExceptionalComparison.PresentationBound.Certificate.Checked
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryTwo.ExceptionalComparison.PresentationBound.Certificate.Shape

/-!
# Finite upper bound for the exceptional comparison presentation

The second literal relator bounds the cyclic subgroup generated by `b` by
six. A kernel-checked coset-word certificate supplies 4320 representatives
modulo that subgroup, with all four signed-generator transitions proved as
word consequences of the eleven literal relators. The resulting surjection
from the subgroup times the representatives proves finiteness and the bound
25920. No order or action of a matrix image is used to bound the presentation.

The untrusted producer and its reproduction instructions are retained in
`PresentationBound/Source/`. The proof applies the six-rule soundness theorem
of `Theory.GroupTheory.CosetWordCertificate` to ordinary kernel computations.

Source application: the exceptional-isomorphism table in GLS3 §2.2,
and Aschbacher–Smith I.1.4(1), printed p.408. The comparison with the actual
matrix groups remains in the separate comparison assembly.
-/

public section
namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryTwo.ExceptionalComparison

namespace PresentationBound
open Subgroup.CosetWordCertificate Certificate

/-- The literal presented group is covered by 4320 cosets of `⟨b⟩`. -/
def cosetCover : Subgroup.GeneratorCosetCover cyclic generator (Fin 4320) := by
  have hinit : definitions.repr generator (survivor (0 : Fin 4320)) = 1 := by
    have hs : survivor (0 : Fin 4320) = 0 := by decide +kernel
    rw [hs]
    exact definitions.repr_zero _
  exact coverOfFacts facts survivor 0 hinit dest output hshape
    (by intro i a; exact all_hold certificate_valid _ (hlt i a))

end PresentationBound

/-- Finiteness and the required upper bound for the eleven literal relators. -/
theorem presentation_finite_card_le :
    Finite Presentation ∧ Nat.card Presentation ≤ 25920 := by
  obtain ⟨hfin, hcard⟩ := PresentationBound.cyclic_bound
  let : Finite PresentationBound.cyclic := hfin
  obtain ⟨hf, hb⟩ := PresentedGroup.finite_card_le_of_cosetCover
    PresentationBound.cyclic PresentationBound.cosetCover
  refine ⟨hf, hb.trans ?_⟩
  simpa only [Nat.card_fin] using Nat.mul_le_mul_right 4320 hcard

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryTwo.ExceptionalComparison
