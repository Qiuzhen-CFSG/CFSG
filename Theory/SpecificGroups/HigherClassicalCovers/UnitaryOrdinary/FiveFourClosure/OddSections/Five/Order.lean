module
public import Theory.SpecificGroups.HigherClassicalCovers.UnitaryOrdinary.FiveFourClosure.OddSections.Five.Model
public import Theory.GroupTheory.NormalizedSupCard

/-!
# Order of the monomial five-subgroup of SU₅(4)

The literal coordinate five-cycle has order five because the permutation-matrix
homomorphism is injective. A permutation matrix in the diagonal torus must fix
every coordinate: its entry in row `i`, column `σ⁻¹ i` is one, whereas a diagonal
matrix has zero there unless `σ⁻¹ i = i`. Thus the torus meets the cyclic subgroup
trivially. The cycle normalizes the torus, so multiplication gives the product
cardinality `5⁴ * 5 = 5⁵` for their join.

This supplies the monomial-order premise of the five-primary transfer argument
for Aschbacher--Smith I.1.4(4), `refs/quasithin.pdf`, printed p.408 (PDF p.419).
See also GLS III Section 6.1, `refs/KGroup/GLS3/chapter6.tex`. The ambient order
bound and the permutation-equivariant torus lift are separate inputs to that
argument.
-/

public section
open Matrix Subgroup BenderSuzuki.MatrixGroups

namespace Theory.SpecificGroups.HigherClassicalCovers.UnitaryOrdinary.FiveFourClosure.OddSections.Five

variable {F : Type*} [Field F] [CharP F 2]

/-- The actual coordinate five-cycle in the special unitary group has order five. -/
theorem orderOf_cycle (J : HermitianForm 5 F) (hJ : J.form = 1) :
    orderOf (cycle J hJ) = 5 := by
  rw [cycle, orderOf_injective _ (permutation_injective J hJ),
    (isCycle_finRotate (n := 3)).orderOf, support_finRotate]
  simp

/-- The cyclic subgroup generated by the coordinate five-cycle has five elements. -/
theorem card_zpowers_cycle (J : HermitianForm 5 F) (hJ : J.form = 1) :
    Nat.card (zpowers (cycle J hJ)) = 5 := by
  rw [Nat.card_zpowers, orderOf_cycle]

/-- A coordinate permutation belongs to the literal diagonal torus exactly when
it is the identity permutation. -/
theorem permutation_mem_torus_iff (J : HermitianForm 5 F) (hJ : J.form = 1)
    (hconj : ∀ x, J.conj x = x^4) (σ : Equiv.Perm (Fin 5)) :
    permutation J hJ σ ∈ torus J hJ hconj ↔ σ = 1 := by
  constructor
  · rintro ⟨a, ha⟩
    suffices hi : σ⁻¹ = 1 by simpa using congrArg Inv.inv hi
    apply Equiv.ext
    intro i
    change σ.symm i = i
    by_contra hi
    have he := congrArg (fun A : J.specialSubgroup => A.val.val i (σ⁻¹ i)) ha
    simp [diagonal_val, permutation_val, Matrix.submatrix, Matrix.one_apply,
      hi, Ne.symm] at he
  · rintro rfl
    simp

/-- The torus has trivial intersection with the cyclic coordinate-permutation subgroup. -/
theorem torus_disjoint_cycle (J : HermitianForm 5 F) (hJ : J.form = 1)
    (hconj : ∀ x, J.conj x = x^4) :
    Disjoint (torus J hJ hconj) (zpowers (cycle J hJ)) := by
  apply Subgroup.disjoint_def.mpr
  intro g ht hg
  obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hg
  change (permutation J hJ (finRotate 5)) ^ k ∈ torus J hJ hconj at ht
  rw [← map_zpow] at ht
  have hp := (permutation_mem_torus_iff J hJ hconj _).mp ht
  change (permutation J hJ (finRotate 5)) ^ k = 1
  rw [← map_zpow, hp, map_one]

/-- The actual monomial subgroup of SU₅(4) has order `5⁵`. This discharges the
cardinality premise of `monomial_index_prime_to_five_of_card` in the parent module. -/
theorem card_monomial [Finite F] (J : HermitianForm 5 F) (hJ : J.form = 1)
    (hconj : ∀ x, J.conj x = x^4) (hcard : Nat.card F = 16) :
    Nat.card (monomial J hJ hconj) = 5^5 := by
  rw [monomial, card_sup_eq_mul_of_normalizes_of_disjoint _ _
    (zpowers_le.mpr (permutation_mem_normalizer J hJ hconj (finRotate 5)))
    (torus_disjoint_cycle J hJ hconj), card_torus J hJ hconj hcard,
    card_zpowers_cycle]
  norm_num

end Theory.SpecificGroups.HigherClassicalCovers.UnitaryOrdinary.FiveFourClosure.OddSections.Five
