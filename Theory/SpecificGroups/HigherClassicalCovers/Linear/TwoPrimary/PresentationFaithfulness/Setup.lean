module

public import Theory.SpecificGroups.LinearHigher.RootCalculus

/-!
# The literal subgroups for degree-four Bruhat collection

The upper, monomial and torus subgroups below are generated inside the
Steinberg presentation. They are not preimages of matrix subgroups. The
separate collection and separation contracts expose the two steps needed
by the kernel argument, without assuming faithfulness of the presentation.

Source: Steinberg, *Lectures on Chevalley Groups*, §6, Lemmas 36–38 and
Theorem 8(b), printed pp.69–71; GLS3 §2.9, printed pp.97–98.
-/

@[expose] public section

namespace Theory.SpecificGroups.HigherClassicalCovers.Linear.TwoPrimaryFaithfulness

open Theory.SpecificGroups.LinearHigher SteinbergWords

variable {F : Type*} [Field F]

/-- The literal rank-one torus word in degree four. -/
abbrev torus (i j : Fin 4) (hij : i ≠ j) (t : Fˣ) : SteinbergGroup 4 F :=
  torusWord generator i j hij t

variable (F)

/-- The subgroup generated by the six positive root groups. -/
def upperSubgroup : Subgroup (SteinbergGroup 4 F) :=
  Subgroup.closure {g | ∃ (r : Root 4) (a : F), r.val.1 < r.val.2 ∧ g = generator r a}

/-- The subgroup generated by every nonzero-parameter Weyl word. -/
def weylSubgroup : Subgroup (SteinbergGroup 4 F) :=
  Subgroup.closure {g | ∃ (r : Root 4) (t : Fˣ),
    g = weylWord generator r.val.1 r.val.2 r.property t}

/-- The subgroup generated by all twelve root tori. -/
def torusSubgroup : Subgroup (SteinbergGroup 4 F) :=
  Subgroup.closure {g | ∃ (r : Root 4) (t : Fˣ), g = torus r.val.1 r.val.2 r.property t}

/-- Bruhat coverage by the actual positive and Weyl subgroups. -/
def BruhatCover : Prop :=
  ∀ g : SteinbergGroup 4 F,
    ∃ (u : upperSubgroup F) (w : weylSubgroup F) (v : upperSubgroup F),
      g = u.val * w.val * v.val

/-- Faithfulness restricted to the positive subgroup (Steinberg Lemma 36). -/
def UpperFaithful : Prop :=
  Function.Injective (matrixMap.comp (upperSubgroup F).subtype)

/-- A kernel element in the Weyl subgroup belongs to the literal torus subgroup. -/
def WeylKernelInTorus : Prop :=
  ∀ w : SteinbergGroup 4 F, w ∈ weylSubgroup F → matrixMap w = 1 → w ∈ torusSubgroup F

/-- Upper unipotent and monomial matrix images intersect only at the identity.
This assertion does not assume either restricted matrix map is faithful. -/
def UpperWeylSeparation : Prop :=
  ∀ u w : SteinbergGroup 4 F, u ∈ upperSubgroup F → w ∈ weylSubgroup F →
    matrixMap u = matrixMap w → matrixMap w = 1

variable {F}

theorem generator_mem_upper {r : Root 4} (hr : r.val.1 < r.val.2) (a : F) :
    generator r a ∈ upperSubgroup F :=
  Subgroup.subset_closure ⟨r, a, hr, rfl⟩

theorem weylWord_mem_weyl (i j : Fin 4) (hij : i ≠ j) (t : Fˣ) :
    weylWord generator i j hij t ∈ weylSubgroup F :=
  Subgroup.subset_closure ⟨root i j hij, t, rfl⟩

theorem torus_mem_torusSubgroup (i j : Fin 4) (hij : i ≠ j) (t : Fˣ) :
    torus i j hij t ∈ torusSubgroup F :=
  Subgroup.subset_closure ⟨root i j hij, t, rfl⟩

theorem torusSubgroup_le_weyl : torusSubgroup F ≤ weylSubgroup F := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨r, t, rfl⟩
  exact (weylSubgroup F).mul_mem
    (weylWord_mem_weyl _ _ _ t) (weylWord_mem_weyl _ _ _ (-1))

end Theory.SpecificGroups.HigherClassicalCovers.Linear.TwoPrimaryFaithfulness
