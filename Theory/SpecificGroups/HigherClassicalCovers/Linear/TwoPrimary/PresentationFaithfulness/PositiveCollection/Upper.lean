module

public import Theory.SpecificGroups.HigherClassicalCovers.Linear.TwoPrimary.PresentationFaithfulness.Setup

/-!
# Positive-root collection in the degree-four Steinberg presentation

Every positive word collects to
`x₂₃(f) x₁₃(e) x₁₂(d) x₀₃(c) x₀₂(b) x₀₁(a)` using the additive
and three-index commutator relations. Descending row order makes these six
parameters precisely the six entries above the matrix diagonal. This proves
faithfulness on the literal subgroup generated by the positive roots.

That restricted faithfulness then verifies the three simple-root/complement
factorizations by their matrix entries. These factorizations feed the Bruhat
word induction in `PositiveCollection.lean`. Everything holds over any field.

Source: Steinberg, *Lectures on Chevalley Groups*, §6, Lemma 36, printed p.69,
and the §3 Bruhat argument (`refs/KGroup/GLS3/Chapter2St1.tex`). The degree-three
implementation in `PSL3/UniversalProjection/Faithfulness/Bruhat/Upper.lean`
provides the collection pattern.
-/

@[expose] public section

open Theory.SpecificGroups.LinearHigher SteinbergWords
namespace Theory.SpecificGroups.HigherClassicalCovers.Linear.TwoPrimaryFaithfulness
variable {F : Type*} [Field F]
namespace PositiveCollection
abbrev x01 (a : F) := generator (root (0 : Fin 4) 1 (by decide)) a
abbrev x02 (a : F) := generator (root (0 : Fin 4) 2 (by decide)) a
abbrev x03 (a : F) := generator (root (0 : Fin 4) 3 (by decide)) a
abbrev x12 (a : F) := generator (root (1 : Fin 4) 2 (by decide)) a
abbrev x13 (a : F) := generator (root (1 : Fin 4) 3 (by decide)) a
abbrev x23 (a : F) := generator (root (2 : Fin 4) 3 (by decide)) a
private theorem commute_01_02 (a b : F) : Commute (x01 a) (x02 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_01_03 (a b : F) : Commute (x01 a) (x03 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_01_23 (a b : F) : Commute (x01 a) (x23 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_02_03 (a b : F) : Commute (x02 a) (x03 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_02_12 (a b : F) : Commute (x02 a) (x12 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_02_13 (a b : F) : Commute (x02 a) (x13 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_03_12 (a b : F) : Commute (x03 a) (x12 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_03_13 (a b : F) : Commute (x03 a) (x13 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_03_23 (a b : F) : Commute (x03 a) (x23 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_12_13 (a b : F) : Commute (x12 a) (x13 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem commute_13_23 (a b : F) : Commute (x13 a) (x23 b) :=
  generator_relations.commute _ _ _ _ (by decide) (by decide)
private theorem exchange_012 (a b : F) :
    x01 a * x12 b = x12 b * x02 (a * b) * x01 a := by
  have h := generator_relations.conj_chain (0 : Fin 4) 1 2
    (by decide) (by decide) (by decide) a b
  rw [(commute_02_12 (a * b) b).eq] at h
  exact mul_inv_eq_iff_eq_mul.mp h
private theorem exchange_013 (a b : F) :
    x01 a * x13 b = x13 b * x03 (a * b) * x01 a := by
  have h := generator_relations.conj_chain (0 : Fin 4) 1 3
    (by decide) (by decide) (by decide) a b
  rw [(commute_03_13 (a * b) b).eq] at h
  exact mul_inv_eq_iff_eq_mul.mp h
private theorem exchange_023 (a b : F) :
    x02 a * x23 b = x23 b * x03 (a * b) * x02 a := by
  have h := generator_relations.conj_chain (0 : Fin 4) 2 3
    (by decide) (by decide) (by decide) a b
  rw [(commute_03_23 (a * b) b).eq] at h
  exact mul_inv_eq_iff_eq_mul.mp h
private theorem exchange_123 (a b : F) :
    x12 a * x23 b = x23 b * x13 (a * b) * x12 a := by
  have h := generator_relations.conj_chain (1 : Fin 4) 2 3
    (by decide) (by decide) (by decide) a b
  rw [(commute_13_23 (a * b) b).eq] at h
  exact mul_inv_eq_iff_eq_mul.mp h

def normal (a b c d e f : F) : SteinbergGroup 4 F :=
  x23 f * x13 e * x12 d * x03 c * x02 b * x01 a

private theorem normal_zero : normal (0 : F) 0 0 0 0 0 = 1 := by
  simp [normal, x01, x02, x03, x12, x13, x23, generator_relations.zero]

private theorem normal_mul_01 (a b c d e f t : F) :
    normal a b c d e f * x01 t = normal (a+t) b c d e f := by
  simp only [normal, mul_assoc, x01, generator_relations.add]

private theorem normal_mul_02 (a b c d e f t : F) :
    normal a b c d e f * x02 t = normal a (b+t) c d e f := by
  simp only [normal, mul_assoc]
  rw [(commute_01_02 a t).eq, ← mul_assoc (x02 b), generator_relations.add]

private theorem normal_mul_03 (a b c d e f t : F) :
    normal a b c d e f * x03 t = normal a b (c+t) d e f := by
  simp only [normal, mul_assoc]
  rw [(commute_01_03 a t).eq, ← mul_assoc (x02 b), (commute_02_03 b t).eq]
  simp only [mul_assoc]
  rw [← mul_assoc (x03 c), generator_relations.add]

private theorem normal_mul_12 (a b c d e f t : F) :
    normal a b c d e f * x12 t = normal a (b+a*t) c (d+t) e f := by
  simp only [normal, mul_assoc]
  rw [exchange_012, ← mul_assoc (x02 b), ← mul_assoc (x02 b),
    (commute_02_12 b t).eq]
  simp only [mul_assoc]
  rw [← mul_assoc (x03 c), (commute_03_12 c t).eq]
  simp only [mul_assoc]
  rw [← mul_assoc (x12 d), generator_relations.add,
    ← mul_assoc (x02 b), generator_relations.add]

private theorem normal_mul_13 (a b c d e f t : F) :
    normal a b c d e f * x13 t = normal a b (c+a*t) d (e+t) f := by
  simp only [normal, mul_assoc]
  rw [exchange_013, ← mul_assoc (x02 b), ← mul_assoc (x02 b),
    (commute_02_13 b t).eq]
  simp only [mul_assoc]
  rw [← mul_assoc (x03 c), (commute_03_13 c t).eq]
  simp only [mul_assoc]
  rw [← mul_assoc (x12 d), (commute_12_13 d t).eq]
  simp only [mul_assoc]
  rw [← mul_assoc (x13 e), generator_relations.add,
    ← mul_assoc (x02 b), (commute_02_03 b (a*t)).eq]
  simp only [mul_assoc]
  rw [← mul_assoc (x03 c), generator_relations.add]

private theorem normal_mul_23 (a b c d e f t : F) :
    normal a b c d e f * x23 t = normal a b (c+b*t) d (e+d*t) (f+t) := by
  simp only [normal, mul_assoc]
  rw [(commute_01_23 a t).eq, ← mul_assoc (x02 b), exchange_023]
  simp only [mul_assoc]
  rw [← mul_assoc (x03 c), (commute_03_23 c t).eq]
  simp only [mul_assoc]
  rw [← mul_assoc (x12 d), exchange_123]
  simp only [mul_assoc]
  rw [← mul_assoc (x13 e), (commute_13_23 e t).eq]
  simp only [mul_assoc]
  rw [← mul_assoc (x23 f), generator_relations.add,
    ← mul_assoc (x13 e), generator_relations.add,
    ← mul_assoc (x03 c), generator_relations.add]

theorem exists_normal {g : SteinbergGroup 4 F} (hg : g ∈ upperSubgroup F) :
    ∃ a b c d e f : F, g = normal a b c d e f := by
  have step (g : SteinbergGroup 4 F)
      (ih : ∃ a b c d e f : F, g = normal a b c d e f)
      (r : Root 4) (hr : r.val.1 < r.val.2) (t : F) :
      ∃ a b c d e f : F, g * generator r t = normal a b c d e f := by
    obtain ⟨a,b,c,d,e,f,rfl⟩ := ih
    obtain ⟨⟨i,j⟩,hij⟩ := r
    fin_cases i <;> fin_cases j <;> first
    | exact (by contradiction)
    | exact ⟨a+t,b,c,d,e,f,normal_mul_01 a b c d e f t⟩
    | exact ⟨a,b+t,c,d,e,f,normal_mul_02 a b c d e f t⟩
    | exact ⟨a,b,c+t,d,e,f,normal_mul_03 a b c d e f t⟩
    | exact ⟨a,b+a*t,c,d+t,e,f,normal_mul_12 a b c d e f t⟩
    | exact ⟨a,b,c+a*t,d,e+t,f,normal_mul_13 a b c d e f t⟩
    | exact ⟨a,b,c+b*t,d,e+d*t,f+t,normal_mul_23 a b c d e f t⟩
  induction hg using Subgroup.closure_induction_right with
  | one => exact ⟨0,0,0,0,0,0,normal_zero.symm⟩
  | mul_right g _ y hy ih =>
    obtain ⟨r,a,hr,rfl⟩ := hy
    exact step g ih r hr a
  | mul_inv_cancel g _ y hy ih =>
    obtain ⟨r,a,hr,rfl⟩ := hy
    rw [← generator_relations.neg]
    exact step g ih r hr (-a)

theorem matrix_normal (a b c d e f : F) :
    (matrixMap (normal a b c d e f) : Matrix (Fin 4) (Fin 4) F) =
      !![1,a,b,c; 0,1,d,e; 0,0,1,f; 0,0,0,1] := by
  simp only [normal, x01, x02, x03, x12, x13, x23, map_mul, matrixMap_generator,
    Matrix.SpecialLinearGroup.coe_mul, matrixRoot,
    Matrix.SpecialLinearGroup.transvection_coe]
  simp only [root, Matrix.add_mul, Matrix.mul_add, one_mul, mul_one]
  simp only [Matrix.single_mul_single_of_ne _ _ _ _ (by decide : (3 : Fin 4) ≠ 1),
    Matrix.single_mul_single_of_ne _ _ _ _ (by decide : (3 : Fin 4) ≠ 0),
    Matrix.single_mul_single_of_ne _ _ _ _ (by decide : (2 : Fin 4) ≠ 0),
    zero_mul, add_zero]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.single]
end PositiveCollection

/-- The matrix map is injective on the literal positive-root subgroup. -/
theorem upperFaithful : UpperFaithful F := by
  intro g h he
  obtain ⟨a,b,c,d,e,f,hg⟩ := PositiveCollection.exists_normal g.property
  obtain ⟨a',b',c',d',e',f',hh⟩ := PositiveCollection.exists_normal h.property
  change matrixMap g.val = matrixMap h.val at he
  rw [hg, hh] at he
  have hm := congrArg (fun z : Matrix.SpecialLinearGroup (Fin 4) F =>
    (z : Matrix (Fin 4) (Fin 4) F)) he
  rw [PositiveCollection.matrix_normal, PositiveCollection.matrix_normal] at hm
  have ha : a = a' := congrArg (fun z : Matrix (Fin 4) (Fin 4) F => z 0 1) hm
  have hb : b = b' := congrArg (fun z : Matrix (Fin 4) (Fin 4) F => z 0 2) hm
  have hc : c = c' := congrArg (fun z : Matrix (Fin 4) (Fin 4) F => z 0 3) hm
  have hd : d = d' := congrArg (fun z : Matrix (Fin 4) (Fin 4) F => z 1 2) hm
  have he : e = e' := congrArg (fun z : Matrix (Fin 4) (Fin 4) F => z 1 3) hm
  have hf : f = f' := congrArg (fun z : Matrix (Fin 4) (Fin 4) F => z 2 3) hm
  apply Subtype.ext
  rw [hg, hh, ha, hb, hc, hd, he, hf]
namespace PositiveCollection

abbrev simpleRoot (k : Fin 3) : Root 4 := root k.castSucc k.succ (by
  intro he
  have := congrArg Fin.val he
  simp only [Fin.val_castSucc, Fin.val_succ] at this
  omega)

def complement (k : Fin 3) : Subgroup (SteinbergGroup 4 F) :=
  Subgroup.closure {g | ∃ (r : Root 4) (a : F),
    r.val.1 < r.val.2 ∧ r ≠ simpleRoot k ∧ g = generator r a}

theorem complement_le (k : Fin 3) : complement (F := F) k ≤ upperSubgroup F := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨r,a,hr,_,rfl⟩
  exact generator_mem_upper hr a

theorem complement_generator (k : Fin 3) (r : Root 4)
    (hr : r.val.1 < r.val.2) (hne : r ≠ simpleRoot k) (a : F) :
    generator r a ∈ complement (F := F) k :=
  Subgroup.subset_closure ⟨r,a,hr,hne,rfl⟩

private theorem upper_eq_of_matrix_eq {g h : SteinbergGroup 4 F}
    (hg : g ∈ upperSubgroup F) (hh : h ∈ upperSubgroup F)
    (he : matrixMap g = matrixMap h) : g = h := by
  have hsub : (⟨g,hg⟩ : upperSubgroup F) = ⟨h,hh⟩ := upperFaithful he
  exact congrArg Subtype.val hsub

theorem factor_simple (k : Fin 3) {g : SteinbergGroup 4 F}
    (hg : g ∈ upperSubgroup F) :
    ∃ (a : F) (c : complement (F := F) k), g = generator (simpleRoot k) a * c.val := by
  obtain ⟨a,b,c,d,e,f,rfl⟩ := exists_normal hg
  fin_cases k
  · have hc : normal 0 (b-a*d) (c-a*e) d e f ∈ complement (F := F) 0 := by
      simp only [normal, x01, generator_relations.zero, mul_one]
      repeat first
      | apply (complement 0).mul_mem
      | exact complement_generator 0 _ (by decide) (by decide) _
    refine ⟨a, ⟨normal 0 (b-a*d) (c-a*e) d e f, hc⟩, ?_⟩
    apply upper_eq_of_matrix_eq hg
      ((upperSubgroup F).mul_mem (generator_mem_upper (by decide) _) (complement_le 0 hc))
    apply Subtype.ext
    simp only [map_mul, matrixMap_generator, Matrix.SpecialLinearGroup.coe_mul,
      matrix_normal, matrixRoot, Matrix.SpecialLinearGroup.transvection_coe]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [simpleRoot, root, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.single,
        Matrix.one_apply]
  · have hc : normal a b c 0 (e-d*f) f ∈ complement (F := F) 1 := by
      simp only [normal, x12, generator_relations.zero, mul_one]
      repeat first
      | apply (complement 1).mul_mem
      | exact complement_generator 1 _ (by decide) (by decide) _
    refine ⟨d, ⟨normal a b c 0 (e-d*f) f, hc⟩, ?_⟩
    apply upper_eq_of_matrix_eq hg
      ((upperSubgroup F).mul_mem (generator_mem_upper (by decide) _) (complement_le 1 hc))
    apply Subtype.ext
    simp only [map_mul, matrixMap_generator, Matrix.SpecialLinearGroup.coe_mul,
      matrix_normal, matrixRoot, Matrix.SpecialLinearGroup.transvection_coe]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [simpleRoot, root, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.single,
        Matrix.one_apply]
  · have hc : normal a b c d e 0 ∈ complement (F := F) 2 := by
      simp only [normal, x23, generator_relations.zero, one_mul]
      repeat first
      | apply (complement 2).mul_mem
      | exact complement_generator 2 _ (by decide) (by decide) _
    refine ⟨f, ⟨normal a b c d e 0, hc⟩, ?_⟩
    apply upper_eq_of_matrix_eq hg
      ((upperSubgroup F).mul_mem (generator_mem_upper (by decide) _) (complement_le 2 hc))
    apply Subtype.ext
    simp only [map_mul, matrixMap_generator, Matrix.SpecialLinearGroup.coe_mul,
      matrix_normal, matrixRoot, Matrix.SpecialLinearGroup.transvection_coe]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [simpleRoot, root, Matrix.mul_apply, Fin.sum_univ_succ, Matrix.single,
        Matrix.one_apply]
end PositiveCollection
end Theory.SpecificGroups.HigherClassicalCovers.Linear.TwoPrimaryFaithfulness
