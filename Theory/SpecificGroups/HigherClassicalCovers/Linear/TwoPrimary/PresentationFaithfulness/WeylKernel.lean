module

public import Theory.SpecificGroups.HigherClassicalCovers.Linear.TwoPrimary.PresentationFaithfulness.Tori
public import Theory.Alternating.theorem_5_2_1_2

/-!
# The degree-four Weyl kernel lies in the literal torus

The subgroup generated by all root torus words is normal inside the subgroup
of Weyl words. In their relative quotient the parameters disappear, inverse
and reversed-root Weyl words agree, and the three adjacent generators satisfy
the type A₃ Coxeter relations. Signed conjugation in the actual Steinberg
presentation proves these relations; no involution assertion is made about
the Weyl lifts themselves.

The type-A normal-form bound gives at most 24 elements in this quotient.
Every Weyl matrix has a unique supporting coordinate permutation, and these
permutations give a surjection from the quotient to `Sym(Fin 4)`. The bound
makes that map injective. Thus a Weyl word with identity matrix has trivial
torus coset. This argument works over any field and uses neither Bruhat
coverage nor faithfulness on any other subgroup.

The cardinal bound is the general `TypeANormalForm` theorem in
`Theory.Alternating.theorem_5_2_1_2`, specialized to rank three. The relative
normality argument follows the checked degree-three proof in
`PSL3/UniversalProjection/Faithfulness/Bruhat/Weyl.lean`; the matrix support
calculation follows `PresentationFaithfulness/Separation.lean`.

Source: Steinberg, *Lectures on Chevalley Groups*, §3, Lemma 22, printed
pp.32–33; §6, Lemmas 37–38 and Theorem 8(b), printed pp.69–71
(`refs/KGroup/GLS3/Chapter2St1.tex`). The separate `WeylKernel.Application`
module substitutes this result into the literal degree-four Bruhat reduction.
-/

@[expose] public section

namespace Theory.SpecificGroups.HigherClassicalCovers.Linear.TwoPrimaryFaithfulness
open Theory.SpecificGroups.LinearHigher SteinbergWords
open Matrix.SpecialLinearGroup
open scoped MatrixGroups
variable {F : Type*} [Field F]

private theorem weyl_conj_torus_formula
    (i j k l : Fin 4) (hij : i ≠ j) (hkl : k ≠ l) (s : Fˣ) :
    MulAut.conj (weylWord generator k l hkl 1) (torus i j hij s) =
      (torus k l hkl (rootWeight i j s (root k l hkl)))⁻¹ * torus i j hij s := by
  have he : torus i j hij s *
      (MulAut.conj (weylWord generator k l hkl 1) (torus i j hij s))⁻¹ =
      torus k l hkl (rootWeight i j s (root k l hkl)) := by
    calc
      _ = MulAut.conj (torus i j hij s) (weylWord generator k l hkl 1) *
          (weylWord generator k l hkl 1)⁻¹ := by
        simp [MulAut.conj_apply, mul_assoc]
      _ = _ := by
        rw [torus_conj_weyl, mul_one, weylWord_inv generator_relations]
        rfl
  calc
    _ = (torus i j hij s *
        (MulAut.conj (weylWord generator k l hkl 1) (torus i j hij s))⁻¹)⁻¹ *
        torus i j hij s := by group
    _ = _ := by rw [he]

private theorem weyl_parameter (i j : Fin 4) (hij : i ≠ j) (t : Fˣ) :
    weylWord generator i j hij t =
      torus i j hij t * weylWord generator i j hij 1 := by
  simp [torus, torusWord, ← weylWord_inv generator_relations, mul_assoc]

private theorem conj_torus_mem (i j : Fin 4) (hij : i ≠ j)
    {g : SteinbergGroup 4 F} (hg : g ∈ torusSubgroup F) :
    MulAut.conj (weylWord generator i j hij 1) g ∈ torusSubgroup F := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨r, t, rfl⟩ := hg
    rw [weyl_conj_torus_formula]
    exact (torusSubgroup F).mul_mem
      ((torusSubgroup F).inv_mem (torus_mem_torusSubgroup _ _ _ _))
      (torus_mem_torusSubgroup _ _ _ _)
  | one => simp
  | mul g h _ _ ihg ihh => simpa using (torusSubgroup F).mul_mem ihg ihh
  | inv g _ ih => simpa only [map_inv] using (torusSubgroup F).inv_mem ih

private theorem weyl_one_normalizes (i j : Fin 4) (hij : i ≠ j) :
    weylWord generator i j hij (1 : Fˣ) ∈ Subgroup.normalizer (torusSubgroup F) := by
  rw [Subgroup.mem_normalizer_iff]
  intro g
  constructor
  · exact conj_torus_mem i j hij
  · intro hg
    have hi : (weylWord generator i j hij (1 : Fˣ))⁻¹ =
        torus i j hij (-1) * weylWord generator i j hij 1 := by
      rw [weylWord_inv generator_relations, weyl_parameter i j hij (-1)]
    have he : MulAut.conj (weylWord generator i j hij (1 : Fˣ))⁻¹
        (MulAut.conj (weylWord generator i j hij 1) g) = g := by
      simp [MulAut.conj_apply, mul_assoc]
    rw [← he, hi]
    simpa [MulAut.conj_apply, mul_inv_rev, mul_assoc] using
      (torusSubgroup F).mul_mem
        ((torusSubgroup F).mul_mem (torus_mem_torusSubgroup i j hij (-1))
          (conj_torus_mem i j hij hg))
        ((torusSubgroup F).inv_mem (torus_mem_torusSubgroup i j hij (-1)))

private theorem weyl_normalizes : weylSubgroup F ≤ Subgroup.normalizer (torusSubgroup F) := by
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨r, t, rfl⟩
  rw [weyl_parameter r.val.1 r.val.2 r.property t]
  apply Subgroup.mul_mem
  · exact (torusSubgroup F).le_normalizer
      (torus_mem_torusSubgroup r.val.1 r.val.2 r.property t)
  · exact weyl_one_normalizes (F := F) r.val.1 r.val.2 r.property

private theorem weyl_reverse (i j : Fin 4) (hij : i ≠ j) :
    weylWord generator j i hij.symm (1 : Fˣ) =
      (weylWord generator i j hij 1)⁻¹ := by
  have hc : MulAut.conj (weylWord generator i j hij (1 : Fˣ))
      (weylWord generator i j hij 1) = weylWord generator j i hij.symm (-1) := by
    conv_lhs => arg 2; unfold weylWord
    rw [map_mul, map_mul]
    rw [weylWord_conj_root generator_relations (by decide),
      weylWord_conj_opposite_root generator_relations (by decide)]
    simp [weylWord]
  have he : weylWord generator i j hij (1 : Fˣ) =
      weylWord generator j i hij.symm (-1) := by
    simpa [MulAut.conj_apply] using hc
  rw [he, weylWord_inv generator_relations, neg_neg]

private instance torus_normal_in_weyl :
    ((torusSubgroup F).subgroupOf (weylSubgroup F)).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer weyl_normalizes

private abbrev WeylQuotient (F : Type*) [Field F] :=
  (weylSubgroup F) ⧸ (torusSubgroup F).subgroupOf (weylSubgroup F)

private def quotientMap : weylSubgroup F →* WeylQuotient F :=
  QuotientGroup.mk' _

private def liftW (i j : Fin 4) (hij : i ≠ j) (t : Fˣ) : weylSubgroup F :=
  ⟨weylWord generator i j hij t, weylWord_mem_weyl i j hij t⟩

private theorem quotient_parameter (i j : Fin 4) (hij : i ≠ j) (t : Fˣ) :
    quotientMap (liftW i j hij t) = quotientMap (liftW i j hij 1) := by
  apply QuotientGroup.eq_iff_div_mem.mpr
  change weylWord generator i j hij t / weylWord generator i j hij 1 ∈ torusSubgroup F
  rw [div_eq_mul_inv, weyl_parameter i j hij t, mul_inv_cancel_right]
  exact torus_mem_torusSubgroup i j hij t

private theorem quotient_involution (i j : Fin 4) (hij : i ≠ j) :
    (quotientMap (liftW i j hij (1 : Fˣ)))⁻¹ = quotientMap (liftW i j hij 1) := by
  rw [← map_inv]
  have hi : (liftW i j hij (1 : Fˣ))⁻¹ = liftW i j hij (-1) := by
    apply Subtype.ext
    exact weylWord_inv generator_relations i j hij 1
  rw [hi, quotient_parameter]

private theorem quotient_reverse (i j : Fin 4) (hij : i ≠ j) :
    quotientMap (liftW j i hij.symm (1 : Fˣ)) = quotientMap (liftW i j hij 1) := by
  rw [← quotient_involution i j hij, ← map_inv]
  congr 1
  exact Subtype.ext (weyl_reverse i j hij)

private theorem conj_weyl_chain (i j k : Fin 4)
    (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    MulAut.conj (weylWord generator i j hij (1 : Fˣ))
      (weylWord generator j k hjk 1) = weylWord generator i k hik 1 := by
  conv_lhs => arg 2; unfold weylWord
  rw [map_mul, map_mul,
    weylWord_conj_other_outgoing generator_relations i j k hij hik hjk,
    weylWord_conj_incoming generator_relations i j k hij hik.symm hjk.symm]
  simp [weylWord]

private theorem conj_weyl_chain_reverse (i j k : Fin 4)
    (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    MulAut.conj (weylWord generator j k hjk (1 : Fˣ))
      (weylWord generator i j hij 1) = weylWord generator i k hik (-1) := by
  conv_lhs => arg 2; unfold weylWord
  rw [map_mul, map_mul,
    weylWord_conj_other_incoming generator_relations j k i hjk hij hik,
    weylWord_conj_outgoing generator_relations j k i hjk hij.symm hik.symm]
  simp [weylWord]

private theorem quotient_chain (i j k : Fin 4)
    (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    quotientMap (liftW i k hik (1 : Fˣ)) =
      quotientMap (liftW i j hij 1) * quotientMap (liftW j k hjk 1) *
        quotientMap (liftW i j hij 1) := by
  have he : liftW i k hik (1 : Fˣ) =
      liftW i j hij 1 * liftW j k hjk 1 * (liftW i j hij 1)⁻¹ :=
    Subtype.ext (conj_weyl_chain i j k hij hik hjk).symm
  rw [he, map_mul, map_mul, map_inv, quotient_involution]

private theorem quotient_braid (i j k : Fin 4)
    (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    quotientMap (liftW i j hij (1 : Fˣ)) * quotientMap (liftW j k hjk 1) *
      quotientMap (liftW i j hij 1) =
    quotientMap (liftW j k hjk 1) * quotientMap (liftW i j hij 1) *
      quotientMap (liftW j k hjk 1) := by
  have he : liftW i k hik (-1 : Fˣ) =
      liftW j k hjk 1 * liftW i j hij 1 * (liftW j k hjk 1)⁻¹ :=
    Subtype.ext (conj_weyl_chain_reverse i j k hij hik hjk).symm
  have hq := congrArg quotientMap he
  rw [quotient_parameter, quotient_chain i j k hij hik hjk,
    map_mul, map_mul, map_inv, quotient_involution] at hq
  exact hq

private theorem quotient_distant :
    Commute (quotientMap (liftW 0 1 (by decide) (1 : Fˣ)))
      (quotientMap (liftW 2 3 (by decide) 1)) := by
  apply Commute.map
  apply Subtype.ext
  change Commute (weylWord generator 0 1 (by decide) (1 : Fˣ))
    (weylWord generator 2 3 (by decide) 1)
  simp only [weylWord]
  repeat' apply Commute.mul_left
  all_goals repeat' apply Commute.mul_right
  all_goals exact generator_relations.commute _ _ _ _ (by decide) (by decide)

private theorem pair_cube {G : Type*} [Group G] (a b : G)
    (ha : a⁻¹ = a) (hb : b⁻¹ = b) (hab : a * b * a = b * a * b) :
    (a * b) ^ 3 = 1 := by
  calc
    _ = (a * b * a) * (b * a * b) := by simp only [pow_succ, pow_zero, one_mul, mul_assoc]
    _ = (b * a * b)⁻¹ * (b * a * b) := by rw [hab]; simp only [mul_inv_rev, ha, hb, mul_assoc]
    _ = 1 := inv_mul_cancel _

private def simpleQ (i : Fin 3) : WeylQuotient F :=
  ![quotientMap (liftW 0 1 (by decide) 1),
    quotientMap (liftW 1 2 (by decide) 1),
    quotientMap (liftW 2 3 (by decide) 1)] i

private theorem simpleQ_inv (i : Fin 3) : (simpleQ (F := F) i)⁻¹ = simpleQ i := by
  fin_cases i <;> exact quotient_involution _ _ _

private theorem simpleQ_isLiftable : CoxeterMatrix.IsLiftable (CoxeterMatrix.A 3)
    (simpleQ (F := F)) := by
  have hs (i : Fin 3) : simpleQ (F := F) i * simpleQ i = 1 := by
    simpa only [simpleQ_inv] using inv_mul_cancel (simpleQ (F := F) i)
  have hab := pair_cube _ _ (quotient_involution (F := F) 0 1 (by decide))
    (quotient_involution (F := F) 1 2 (by decide))
    (quotient_braid (F := F) 0 1 2 (by decide) (by decide) (by decide))
  have hbc := pair_cube _ _ (quotient_involution (F := F) 1 2 (by decide))
    (quotient_involution (F := F) 2 3 (by decide))
    (quotient_braid (F := F) 1 2 3 (by decide) (by decide) (by decide))
  have hba := pair_cube _ _ (quotient_involution (F := F) 1 2 (by decide))
    (quotient_involution (F := F) 0 1 (by decide))
    (quotient_braid (F := F) 0 1 2 (by decide) (by decide) (by decide)).symm
  have hcb := pair_cube _ _ (quotient_involution (F := F) 2 3 (by decide))
    (quotient_involution (F := F) 1 2 (by decide))
    (quotient_braid (F := F) 1 2 3 (by decide) (by decide) (by decide)).symm
  have hc : Commute (simpleQ (F := F) 0) (simpleQ 2) := quotient_distant
  have hac : (simpleQ (F := F) 0 * simpleQ 2) ^ 2 = 1 := by
    rw [hc.mul_pow, pow_two, pow_two, hs, hs, one_mul]
  have hca : (simpleQ (F := F) 2 * simpleQ 0) ^ 2 = 1 := by
    rw [hc.symm.mul_pow, pow_two, pow_two, hs, hs, one_mul]
  intro i j
  fin_cases i <;> fin_cases j
  all_goals norm_num only [CoxeterMatrix.A, Matrix.of_apply, Fin.reduceFinMk,
    Fin.val_zero, Fin.val_one, Fin.val_two, reduceIte, pow_one]
  · exact hs 0
  · exact hab
  · exact hac
  · exact hba
  · exact hs 1
  · exact hbc
  · exact hca
  · exact hcb
  · exact hs 2

private def coxeterLift : (CoxeterMatrix.A 3).Group →* WeylQuotient F :=
  (CoxeterMatrix.A 3).toCoxeterSystem.lift ⟨simpleQ, simpleQ_isLiftable⟩

private theorem coxeterLift_simple (i : Fin 3) :
    coxeterLift ((CoxeterMatrix.A 3).simple i) = simpleQ (F := F) i :=
  (CoxeterMatrix.A 3).toCoxeterSystem.lift_apply_simple simpleQ_isLiftable i

private theorem quotient_generator_mem_range (i j : Fin 4) (hij : i ≠ j) (t : Fˣ) :
    quotientMap (liftW i j hij t) ∈ (coxeterLift (F := F)).range := by
  rw [quotient_parameter]
  have hs (k : Fin 3) : simpleQ (F := F) k ∈ (coxeterLift (F := F)).range :=
    ⟨(CoxeterMatrix.A 3).simple k, coxeterLift_simple k⟩
  have hab : quotientMap (liftW 0 2 (by decide) (1 : Fˣ)) ∈ coxeterLift.range := by
    rw [quotient_chain 0 1 2 (by decide) (by decide) (by decide)]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (hs 0) (hs 1)) (hs 0)
  have hbc : quotientMap (liftW 1 3 (by decide) (1 : Fˣ)) ∈ coxeterLift.range := by
    rw [quotient_chain 1 2 3 (by decide) (by decide) (by decide)]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (hs 1) (hs 2)) (hs 1)
  have habc : quotientMap (liftW 0 3 (by decide) (1 : Fˣ)) ∈ coxeterLift.range := by
    rw [quotient_chain 0 1 3 (by decide) (by decide) (by decide)]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (hs 0) hbc) (hs 0)
  fin_cases i <;> fin_cases j
  · exact (hij rfl).elim
  · exact hs 0
  · exact hab
  · exact habc
  · exact (quotient_reverse (F := F) 0 1 (by decide)).symm ▸ (hs 0)
  · exact (hij rfl).elim
  · exact hs 1
  · exact hbc
  · exact (quotient_reverse (F := F) 0 2 (by decide)).symm ▸ (hab)
  · exact (quotient_reverse (F := F) 1 2 (by decide)).symm ▸ (hs 1)
  · exact (hij rfl).elim
  · exact hs 2
  · exact (quotient_reverse (F := F) 0 3 (by decide)).symm ▸ (habc)
  · exact (quotient_reverse (F := F) 1 3 (by decide)).symm ▸ (hbc)
  · exact (quotient_reverse (F := F) 2 3 (by decide)).symm ▸ (hs 2)
  · exact (hij rfl).elim

private theorem coxeterLift_surjective : Function.Surjective (coxeterLift (F := F)) := by
  have hm {g : SteinbergGroup 4 F} (hg : g ∈ weylSubgroup F) :
      quotientMap ⟨g, hg⟩ ∈ (coxeterLift (F := F)).range := by
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
      obtain ⟨r, t, rfl⟩ := hg
      exact quotient_generator_mem_range r.val.1 r.val.2 r.property t
    | one => exact Subgroup.one_mem _
    | mul g h hg hh ihg ihh =>
      change quotientMap (⟨g, hg⟩ * ⟨h, hh⟩) ∈ _
      rw [map_mul]
      exact Subgroup.mul_mem _ ihg ihh
    | inv g hg ih =>
      change quotientMap (⟨g, hg⟩⁻¹) ∈ _
      rw [map_inv]
      exact Subgroup.inv_mem _ ih
  intro q
  obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective
    ((torusSubgroup F).subgroupOf (weylSubgroup F)) q
  exact hm w.property
private def supported (s : Equiv.Perm (Fin 4)) (M : Matrix (Fin 4) (Fin 4) F) : Prop :=
  ∀ i j, i ≠ s j → M i j = 0

private theorem supported_mul {s t : Equiv.Perm (Fin 4)}
    {A B : Matrix (Fin 4) (Fin 4) F} (ha : supported s A) (hb : supported t B) :
    supported (s * t) (A * B) := by
  intro i j hij
  rw [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro k _
  by_cases hk : k = t j
  · subst k
    rw [ha i (t j) hij, zero_mul]
  · rw [hb k j hk, mul_zero]

private theorem supported_weyl (r : Root 4) (t : Fˣ) :
    supported (Equiv.swap r.val.1 r.val.2)
      (matrixMap (weylWord generator r.val.1 r.val.2 r.property t) : Matrix (Fin 4) (Fin 4) F) := by
  obtain ⟨⟨i, j⟩, hij⟩ := r
  intro k l hkl
  simp only [weylWord, map_mul, matrixMap_generator, coe_mul, matrixRoot]
  change (Matrix.transvection i j (t : F) *
    Matrix.transvection j i (-((t⁻¹ : Fˣ) : F)) * Matrix.transvection i j (t : F)) k l = 0
  by_cases hki : k = i <;> by_cases hkj : k = j <;>
    by_cases hli : l = i <;> by_cases hlj : l = j
  all_goals try {subst_vars; contradiction}
  all_goals subst_vars
  all_goals simp_all only [Matrix.mul_assoc, Matrix.transvection_mul_apply_same,
    Matrix.transvection_mul_apply_of_ne, ne_eq, not_false_eq_true]
  all_goals simp_all [Equiv.swap_apply_def, Matrix.transvection, Matrix.single,
    Matrix.one_apply, eq_comm]

private theorem weyl_matrix {w : SteinbergGroup 4 F} (hw : w ∈ weylSubgroup F) :
    ∃ s : Equiv.Perm (Fin 4), supported s (matrixMap w : Matrix (Fin 4) (Fin 4) F) := by
  induction hw using Subgroup.closure_induction_left with
  | one => exact ⟨1, by intro i j hij; simpa using Matrix.one_apply_ne (show i ≠ j from hij)⟩
  | mul_left x hx y _ ih =>
    obtain ⟨r, t, rfl⟩ := hx
    obtain ⟨s, hs⟩ := ih
    exact ⟨Equiv.swap r.val.1 r.val.2 * s, by
      simpa using supported_mul (supported_weyl r t) hs⟩
  | inv_mul_cancel x hx y _ ih =>
    obtain ⟨r, t, rfl⟩ := hx
    rw [weylWord_inv generator_relations]
    obtain ⟨s, hs⟩ := ih
    exact ⟨Equiv.swap r.val.1 r.val.2 * s, by
      simpa using supported_mul (supported_weyl r (-t)) hs⟩

private theorem supported_one : supported (1 : Equiv.Perm (Fin 4)) (1 : Matrix (Fin 4) (Fin 4) F) := by
  intro i j hij
  exact Matrix.one_apply_ne hij

private theorem supported_unique {s t : Equiv.Perm (Fin 4)}
    {A : Matrix.SpecialLinearGroup (Fin 4) F}
    (hs : supported s (A : Matrix (Fin 4) (Fin 4) F))
    (ht : supported t (A : Matrix (Fin 4) (Fin 4) F)) : s = t := by
  apply Equiv.ext
  intro j
  by_contra hst
  apply A.det_ne_zero
  apply Matrix.det_eq_zero_of_column_eq_zero j
  intro i
  by_cases his : i = s j
  · exact ht i j (fun he => hst (his.symm.trans he))
  · exact hs i j his

private noncomputable def permutationMap : weylSubgroup F →* Equiv.Perm (Fin 4) where
  toFun w := (weyl_matrix w.property).choose
  map_one' := by
    apply supported_unique (weyl_matrix (weylSubgroup F).one_mem).choose_spec
    simpa only [map_one, coe_one] using (supported_one (F := F))
  map_mul' w v := by
    apply supported_unique (weyl_matrix (w * v).property).choose_spec
    simpa only [Subgroup.coe_mul, map_mul, coe_mul] using
      (supported_mul (weyl_matrix w.property).choose_spec (weyl_matrix v.property).choose_spec)

private theorem permutationMap_supported (w : weylSubgroup F) :
    supported (permutationMap w) (matrixMap w.val : Matrix (Fin 4) (Fin 4) F) := (weyl_matrix w.property).choose_spec

private theorem permutationMap_liftW (i j : Fin 4) (hij : i ≠ j) (t : Fˣ) :
    permutationMap (liftW i j hij t) = Equiv.swap i j :=
  supported_unique (permutationMap_supported _) (supported_weyl (root i j hij) t)

private theorem permutationMap_surjective : Function.Surjective (permutationMap (F := F)) := by
  intro p
  have hm : p ∈ Submonoid.closure
      (Set.range fun i : Fin 3 => Equiv.swap i.castSucc i.succ) := by
    rw [Equiv.Perm.mclosure_swap_castSucc_succ]
    trivial
  change p ∈ (permutationMap (F := F)).range
  induction hm using Submonoid.closure_induction with
  | mem p hp =>
    obtain ⟨i, rfl⟩ := hp
    exact ⟨liftW i.castSucc i.succ (ne_of_lt i.castSucc_lt_succ) 1,
      permutationMap_liftW _ _ _ _⟩
  | one => exact Subgroup.one_mem _
  | mul p q _ _ hp hq => exact Subgroup.mul_mem _ hp hq

private theorem torus_le_permutation_ker :
    (torusSubgroup F).subgroupOf (weylSubgroup F) ≤ permutationMap.ker := by
  have hm {g : SteinbergGroup 4 F} (hg : g ∈ torusSubgroup F) :
      permutationMap ⟨g, torusSubgroup_le_weyl hg⟩ = 1 := by
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
      obtain ⟨r, t, rfl⟩ := hg
      change permutationMap (liftW r.val.1 r.val.2 r.property t *
        liftW r.val.1 r.val.2 r.property (-1)) = 1
      rw [map_mul, permutationMap_liftW, permutationMap_liftW, Equiv.swap_mul_self]
    | one => exact map_one permutationMap
    | mul g h hg hh ihg ihh =>
      change permutationMap (⟨g, torusSubgroup_le_weyl hg⟩ *
        ⟨h, torusSubgroup_le_weyl hh⟩) = 1
      rw [map_mul, ihg, ihh, one_mul]
    | inv g hg ih =>
      change permutationMap (⟨g, torusSubgroup_le_weyl hg⟩⁻¹) = 1
      rw [map_inv, ih, inv_one]
  intro g hg
  exact hm hg

private noncomputable def quotientPermutation : WeylQuotient F →* Equiv.Perm (Fin 4) :=
  QuotientGroup.lift _ permutationMap torus_le_permutation_ker

private theorem quotientPermutation_mk (w : weylSubgroup F) :
    quotientPermutation (quotientMap w) = permutationMap w := rfl

private theorem quotientPermutation_injective :
    Function.Injective (quotientPermutation (F := F)) := by
  let : Finite ((CoxeterMatrix.A 3).Group) :=
    GLS3.Chapter5.SchurPresentation.TypeANormalForm.group_finite 3
  let : Finite (WeylQuotient F) := Finite.of_surjective coxeterLift coxeterLift_surjective
  have hs : Function.Surjective (quotientPermutation (F := F)) := by
    intro p
    obtain ⟨w, rfl⟩ := permutationMap_surjective (F := F) p
    exact ⟨quotientMap w, rfl⟩
  apply (hs.bijective_of_nat_card_le ?_).1
  calc
    Nat.card (WeylQuotient F) ≤ Nat.card ((CoxeterMatrix.A 3).Group) :=
      Nat.card_le_card_of_surjective coxeterLift coxeterLift_surjective
    _ ≤ (4 : ℕ).factorial := GLS3.Chapter5.SchurPresentation.TypeANormalForm.natCard_group_le_factorial 3
    _ = Nat.card (Equiv.Perm (Fin 4)) := by rw [Nat.card_perm, Nat.card_fin]

/-- The matrix kernel in the literal Weyl subgroup is contained in its literal torus. -/
theorem weylKernelInTorus : WeylKernelInTorus F := by
  intro w hw hmap
  have hp : permutationMap ⟨w, hw⟩ = 1 := by
    apply supported_unique (A := matrixMap w) (permutationMap_supported _)
    rw [hmap]
    exact supported_one
  have hq : quotientMap (⟨w, hw⟩ : weylSubgroup F) = 1 := by
    apply quotientPermutation_injective
    rw [quotientPermutation_mk, map_one, hp]
  exact (QuotientGroup.eq_one_iff (⟨w, hw⟩ : weylSubgroup F)).mp hq

end Theory.SpecificGroups.HigherClassicalCovers.Linear.TwoPrimaryFaithfulness
