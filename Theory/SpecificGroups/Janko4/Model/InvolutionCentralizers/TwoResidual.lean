/-!
# The literal two-residual quotient of a two-central J4 centralizer

The native full first centralizer has quotient 3.M22.2 by its two-core.
Its two-residual therefore has intrinsic two-core quotient the genuine
perfect triple Mathieu cover. The two-central marking excludes the second
centralizer by its index. Fixed-point lifting through a central quotient,
using the original pointwise fixed Sylow, transports this exact quotient
to a covering component without removing its covering center.

A two-perfect group with this core quotient is generated by its cubic
elements. This supplies containment in the original prime-to-three residual
in the source consumer. All native matrix data retain their ATLAS attribution.
Source: Aschbacher--Smith, proof of 15.2.15, printed p.1118, refs/quasithin.pdf;
GLS3 Table 5.3i for the full centralizer extension.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Sporadic.Mathieu
namespace Janko4.InvolutionCentralizers
attribute [local irreducible] modelGroup matrixA matrixB

private theorem cover_twoCore_eq_bot : pCore 2 M22TripleCover = ⊥ := by
  have hd : Nat.card (pCore 2 M22TripleCover) ∣ 3 := by
    rw [←M22TripleCover.center_card]
    exact card_dvd_of_le (IsQuasisimple.pCore_le_center 2)
  apply card_eq_one.mp
  exact (pCore_isPGroup (p := 2) (G := M22TripleCover)).card_eq_or_dvd.resolve_right
    (fun h => (by decide : ¬ 2 ∣ 3) (h.trans hd))

/-- The literal two-residual of the first J4 centralizer has the genuine triple-cover quotient. -/
def first_twoResidualCoreQuotientEquiv :
    (pResidual 2 First.centralizer ⧸ pCore 2 (pResidual 2 First.centralizer)) ≃*
      M22TripleCover := by
  let D := First.centralizer ⧸ pCore 2 First.centralizer
  let j : M22TripleCover →* D := First.tripleCoverQuotientExtension.inl
  have hr : pResidual 2 D = j.range := by
    apply le_antisymm
    · rw [show j.range = First.tripleCoverQuotientExtension.rightHom.ker from
        First.tripleCoverQuotientExtension.range_inl_eq_ker_rightHom]
      apply pResidual_le_ker_of_isPGroup
      exact IsPGroup.of_card (n := 1) (by simp)
    · let : Group.IsPerfect j.range := Group.IsPerfect.range j
      apply le_pResidual_of_isPPerfect
      intro N hN hq
      let : N.Normal := hN
      by_contra hne
      let : Nontrivial (j.range ⧸ N) := QuotientGroup.nontrivial_iff.mpr hne
      let : Group.IsPerfect (j.range ⧸ N) :=
        Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective N)
      let : Group.IsNilpotent (j.range ⧸ N) := hq.isNilpotent
      exact Group.IsPerfect.not_isSolvable (j.range ⧸ N) inferInstance
  let e := (MulEquiv.subgroupCongr hr).trans
    (MonoidHom.ofInjective (f := j) First.tripleCoverQuotientExtension.inl_injective).symm
  let eq := QuotientGroup.congr _ _ e (pCore_map_iso 2 e)
  let q := QuotientGroup.mk' (pCore 2 First.centralizer)
  have hk : IsPGroup 2 q.ker := by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup
  exact (q.pResidualCoreQuotientEquiv (QuotientGroup.mk'_surjective _) hk).trans
    (eq.trans ((QuotientGroup.quotientMulEquivOfEq cover_twoCore_eq_bot).trans
      QuotientGroup.quotientBot))

/-- The two-central marking selects the first centralizer, preserving its full cover. -/
theorem twoCentral_equiv_first (t : Model) (ht : orderOf t = 2)
    (hc : DoubleCoverCentralizer.TwoCentral t) :
    Nonempty (centralizer ({t} : Set Model) ≃* First.centralizer) := by
  rcases centralizer_equiv_first_or_second t ht with hf | hs
  · exact hf
  · obtain ⟨e⟩ := hs
    have horder := (centralizer ({t} : Set Model)).card_mul_index
    rw [Nat.card_congr e.toEquiv,Second.ambient_card,Cardinality.model_card] at horder
    have hdiv : 2 ∣ (centralizer ({t} : Set Model)).index := by
      omega
    exact (hc.not_dvd_centralizer_index hdiv).elim

/-- The original inner Sylow-fixing action retains the literal two-residual quotient upstairs. -/
theorem fixed_twoResidualCoreQuotient
    {X : Type*} [Group X] [Finite X]
    (hZ : pCore 2 X ≤ center X)
    (e : (X ⧸ pCore 2 X) ≃* Model)
    (a : MulAut X) (ha : orderOf a = 2) (P : Sylow 2 X)
    (hP : ∀ x ∈ P, a x = x)
    (t : Model) (ht : orderOf t = 2) (hc : DoubleCoverCentralizer.TwoCentral t)
    (heq : ∀ x, e (QuotientGroup.mk' (pCore 2 X) (a x)) =
      t * e (QuotientGroup.mk' (pCore 2 X) x) * t⁻¹) :
    Nonempty ((pResidual 2 a.fixedSubgroup ⧸ pCore 2 (pResidual 2 a.fixedSubgroup)) ≃*
      M22TripleCover) := by
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 X))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : q.ker = pCore 2 X := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  let f := MulAut.fixedSubgroupMap a (MulAut.conj t) q heq
  have hf : Function.Surjective f :=
    MulAut.fixedSubgroupMap_surjective_of_sylow_fixed a (MulAut.conj t) q hq
      (hk ▸ hZ) heq (ha ▸ pow_orderOf_eq_one a) P hP
  have hkf : IsPGroup 2 f.ker := by
    have he : f.ker = q.ker.subgroupOf a.fixedSubgroup := by
      ext x
      change f x = 1 ↔ q x = 1
      exact Subtype.ext_iff
    rw [he,hk]
    exact pCore_isPGroup.comap_subtype
  obtain ⟨ec⟩ := twoCentral_equiv_first t ht hc
  let ef : (MulAut.conj t).fixedSubgroup ≃* First.centralizer :=
    (MulEquiv.subgroupCongr (MulAut.fixedSubgroup_conj t)).trans ec
  let er := ef.subgroupMap (pResidual 2 (MulAut.conj t).fixedSubgroup)
  let er' := er.trans (MulEquiv.subgroupCongr (map_pResidual 2 ef))
  let eq := QuotientGroup.congr _ _ er' (pCore_map_iso 2 er')
  exact ⟨(f.pResidualCoreQuotientEquiv hf hkf).trans
    (eq.trans first_twoResidualCoreQuotientEquiv)⟩

/-- A two-perfect group above the full triple cover is generated by its cubic elements. -/
theorem cubic_generated_of_twoPerfect_cover
    {D : Type*} [Group D] [Finite D] (hd : IsPPerfect 2 D)
    (e : (D ⧸ pCore 2 D) ≃* M22TripleCover) : primeToResidual 3 D = ⊤ := by
  have hc : primeToResidual 3 M22TripleCover = ⊤ := by
    rcases IsQuasisimple.normal_le_center_or_eq_top (primeToResidual 3 M22TripleCover)
      with h | h
    · have hh := (primeToResidual_index_coprime (G := M22TripleCover) 3).coprime_dvd_right
        (index_dvd_of_le h)
      rw [index_eq_card,Nat.card_congr M22TripleCover.centralQuotientEquiv.toEquiv,m22_order] at hh
      norm_num at hh
    · exact h
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 D))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : q.ker = pCore 2 D := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  have hm : (primeToResidual 3 D).map q = ⊤ := by
    rw [map_primeToResidual_of_surjective 3 q hq,hc]
  have hs : primeToResidual 3 D ⊔ pCore 2 D = ⊤ := by
    have hh := congrArg (Subgroup.comap q) hm
    rwa [comap_map_eq,hk,comap_top] at hh
  exact hd _ inferInstance (isPGroup_quotient_of_sup_eq_top _ _ pCore_isPGroup hs)

end Janko4.InvolutionCentralizers


