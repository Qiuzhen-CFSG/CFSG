module

public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Threes.LocalCertificates.Assembly
public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Threes.LocalCertificates.NormalForms
public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Threes.LocalCertificates.Conjugacy

/-!
# Local certificates for the concrete J4 three-subgroup

The certified generator transitions make the 27 normal forms exhaustive in the
subgroup generated by `u` and `v`. Their certified distinctness gives subgroup
order 27. The explicit conjugacy witnesses then cover every element of order
three by one of the two local representatives, with power exponent one.

All matrix identities are kernel-checked in the imported certificate modules.
The words and ATLAS source attribution are in `Threes.LocalModel`; no ambient
group order, simplicity, or recognition theorem is used.
-/

public section

namespace Janko4.Simplicity

/-- Every element of the concrete local subgroup has one of the 27 normal forms. -/
theorem threeLocal_exhaustive
    (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1) :
    ∀ y : Model, y ∈ threeLocalSubgroup hA hB →
      ∃ t, threeLocalNormalForm hA hB t = y :=
  threeLocal_exhaustive_of_transitions hA hB
    (threeLocalNormalForm_mul_u hA hB) (threeLocalNormalForm_mul_v hA hB)

/-- The subgroup generated by the two concrete local words has order 27. -/
theorem threeLocal_card
    (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1) :
    Nat.card (threeLocalSubgroup hA hB) = 27 :=
  threeLocal_card_of_normal_forms hA hB
    (threeLocalNormalForm_injective hA hB) (threeLocal_exhaustive hA hB)

/-- The two local representatives cover every order-three element of the subgroup. -/
theorem threeLocal_coverage
    (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1) :
    ∀ y : Model, y ∈ threeLocalSubgroup hA hB → orderOf y = 3 →
      ∃ i k g, threeLocalRepresentative hA hB i = g * y ^ k * g⁻¹ :=
  threeLocal_coverage_of_normal_forms hA hB
    (threeLocal_exhaustive hA hB) (threeLocalNormalForm_conjugacy hA hB)

end Janko4.Simplicity
