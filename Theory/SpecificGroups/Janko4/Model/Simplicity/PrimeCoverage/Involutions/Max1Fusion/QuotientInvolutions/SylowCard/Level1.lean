module

public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.QuotientInvolutions.SylowCard.Data2

/-!
# Exact Sylow candidate stabilizer count, level 1

Exact Schreier transitions for the fixed `SylowData` generators. The tables
are generated by `source/generate.py`; every finite identity is kernel checked.
The generic word-subgroup bijection proves the count, without trusting the
external enumeration used to discover these witnesses.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

@[expose] public section
namespace Janko4.Simplicity.Max1Fusion.QuotientInvolutions.SylowCardCertificate
open Theory.GroupTheory

def repWords1 : Fin 8 → List (Fin 3) :=
  ![[], [0], [1], [1, 0], [2, 0], [0, 1, 0], [1, 2, 0], [1, 0, 1, 0]]

def rep1 (i : Fin 8) := evalWord gen1 (repWords1 i)

def point1 : Fin 8 → Fin 24 := ![1, 14, 17, 11, 13, 16, 4, 6]

def act1 : Fin 3 → Fin 8 → Fin 8 :=
  ![![1, 0, 4, 5, 2, 3, 7, 6], ![2, 3, 0, 1, 6, 7, 4, 5], ![0, 4, 2, 3, 1, 7, 6, 5]]

def factor1 : Fin 3 → Fin 8 → List (Fin 4) :=
  ![![[], [], [3], [], [2], [], [2], [3]], ![[], [], [], [], [], [], [], []], ![[0], [], [1], [1], [], [3], [1], [2]]]

theorem step1 : ∀ i r,
    gen1 i * rep1 r = rep1 (act1 i r) * evalWord gen2 (factor1 i r) := by
  decide +kernel

theorem card1 : Nat.card group1 = 8 * Nat.card group2 := by
  apply wordSubgroup_card_eq_mul_next gen1 inv1 inverse1
    gen2 inv2 inverse2 rep1 act1 factor1 1 point1 0
  · intro r; exact ⟨repWords1 r, rfl⟩
  · exact inclusion2
  · rfl
  · decide +kernel
  · decide +kernel
  · exact wordSubgroup_fix_of_gen_fix gen2 inv2 inverse2
      (by decide +kernel)
  · exact step1

end Janko4.Simplicity.Max1Fusion.QuotientInvolutions.SylowCardCertificate
