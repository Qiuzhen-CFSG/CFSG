module

public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.QuotientInvolutions.SylowCard.Data1

/-!
# Sylow candidate stabilizer generators, level 2

Exact Schreier transitions for the fixed `SylowData` generators. The tables
are generated by `source/generate.py`; every finite identity is kernel checked.
The generic word-subgroup bijection proves the count, without trusting the
external enumeration used to discover these witnesses.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

@[expose] public section
namespace Janko4.Simplicity.Max1Fusion.QuotientInvolutions.SylowCardCertificate
open Theory.GroupTheory

def p2_0 : Equiv.Perm (Fin 24) where
  toFun := ![0, 1, 5, 23, 4, 2, 16, 19, 15, 12, 22, 11, 9, 14, 13, 8, 6, 17, 18, 7, 20, 21, 10, 3]
  invFun := ![0, 1, 5, 23, 4, 2, 16, 19, 15, 12, 22, 11, 9, 14, 13, 8, 6, 17, 18, 7, 20, 21, 10, 3]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def p2_1 : Equiv.Perm (Fin 24) where
  toFun := ![0, 1, 9, 19, 11, 12, 16, 23, 8, 2, 22, 4, 5, 13, 14, 15, 6, 17, 20, 3, 18, 21, 10, 7]
  invFun := ![0, 1, 9, 19, 11, 12, 16, 23, 8, 2, 22, 4, 5, 13, 14, 15, 6, 17, 20, 3, 18, 21, 10, 7]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def p2_2 : Equiv.Perm (Fin 24) where
  toFun := ![0, 1, 3, 12, 14, 19, 16, 2, 18, 23, 22, 13, 7, 4, 11, 20, 6, 17, 15, 9, 8, 21, 10, 5]
  invFun := ![0, 1, 7, 2, 13, 23, 16, 12, 20, 19, 22, 14, 3, 11, 4, 18, 6, 17, 8, 5, 15, 21, 10, 9]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def p2_3 : Equiv.Perm (Fin 24) where
  toFun := ![0, 1, 7, 2, 13, 23, 16, 12, 20, 19, 22, 14, 3, 11, 4, 18, 6, 17, 8, 5, 15, 21, 10, 9]
  invFun := ![0, 1, 3, 12, 14, 19, 16, 2, 18, 23, 22, 13, 7, 4, 11, 20, 6, 17, 15, 9, 8, 21, 10, 5]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def gen2 : Fin 4 → Equiv.Perm (Fin 24) := ![p2_0, p2_1, p2_2, p2_3]

def inv2 : Fin 4 → Fin 4 := ![0, 1, 3, 2]

theorem inverse2 : ∀ i, gen2 (inv2 i) = (gen2 i)⁻¹ := by
  decide +kernel

def group2 := wordSubgroup gen2 inv2 inverse2

def words2 : Fin 4 → List (Fin 3) := ![[2], [1, 2, 1], [1, 0, 2, 0], [0, 2, 0, 1]]

theorem words2_eq : ∀ i, gen2 i = evalWord gen1 (words2 i) := by
  decide +kernel

theorem inclusion2 : group2 ≤ group1 := by
  apply wordSubgroup_le_of_gen_mem
  intro i
  exact ⟨words2 i, (words2_eq i).symm⟩


end Janko4.Simplicity.Max1Fusion.QuotientInvolutions.SylowCardCertificate
