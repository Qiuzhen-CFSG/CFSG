module

public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.QuotientInvolutions.SylowData

/-!
# Sylow candidate stabilizer generators, level 0

Exact Schreier transitions for the fixed `SylowData` generators. The tables
are generated by `source/generate.py`; every finite identity is kernel checked.
The generic word-subgroup bijection proves the count, without trusting the
external enumeration used to discover these witnesses.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

@[expose] public section
namespace Janko4.Simplicity.Max1Fusion.QuotientInvolutions.SylowCardCertificate
open Theory.GroupTheory

def p0_0 : Equiv.Perm (Fin 24) where
  toFun := ![0, 14, 2, 3, 6, 7, 4, 5, 8, 9, 22, 16, 23, 17, 1, 15, 11, 13, 20, 19, 18, 21, 10, 12]
  invFun := ![0, 14, 2, 3, 6, 7, 4, 5, 8, 9, 22, 16, 23, 17, 1, 15, 11, 13, 20, 19, 18, 21, 10, 12]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def p0_1 : Equiv.Perm (Fin 24) where
  toFun := ![23, 11, 22, 20, 17, 8, 13, 15, 5, 18, 19, 1, 21, 6, 16, 7, 14, 4, 9, 10, 3, 12, 2, 0]
  invFun := ![23, 11, 22, 20, 17, 8, 13, 15, 5, 18, 19, 1, 21, 6, 16, 7, 14, 4, 9, 10, 3, 12, 2, 0]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def p0_2 : Equiv.Perm (Fin 24) where
  toFun := ![0, 17, 2, 7, 13, 9, 16, 3, 20, 5, 10, 14, 12, 4, 11, 18, 6, 1, 15, 19, 8, 21, 22, 23]
  invFun := ![0, 17, 2, 7, 13, 9, 16, 3, 20, 5, 10, 14, 12, 4, 11, 18, 6, 1, 15, 19, 8, 21, 22, 23]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def p0_3 : Equiv.Perm (Fin 24) where
  toFun := ![0, 1, 5, 23, 4, 2, 16, 19, 15, 12, 22, 11, 9, 14, 13, 8, 6, 17, 18, 7, 20, 21, 10, 3]
  invFun := ![0, 1, 5, 23, 4, 2, 16, 19, 15, 12, 22, 11, 9, 14, 13, 8, 6, 17, 18, 7, 20, 21, 10, 3]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

def gen0 : Fin 4 → Equiv.Perm (Fin 24) := ![p0_0, p0_1, p0_2, p0_3]

def inv0 : Fin 4 → Fin 4 := ![0, 1, 2, 3]

theorem inverse0 : ∀ i, gen0 (inv0 i) = (gen0 i)⁻¹ := by
  decide +kernel

def group0 := wordSubgroup gen0 inv0 inverse0

theorem gen0_eq : gen0 = (fun i => (sylowGenerator i).val) := by
  decide +kernel


end Janko4.Simplicity.Max1Fusion.QuotientInvolutions.SylowCardCertificate
