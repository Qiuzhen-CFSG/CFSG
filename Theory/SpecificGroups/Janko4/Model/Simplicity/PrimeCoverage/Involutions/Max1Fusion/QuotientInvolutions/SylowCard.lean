module

public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.QuotientInvolutions.SylowData
public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.QuotientInvolutions.SylowCard.Level0
public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.QuotientInvolutions.SylowCard.Level1
public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.QuotientInvolutions.SylowCard.Level2

/-!
# Order of the fixed star Sylow candidate

The faithful permutation image of `sylowCandidate` has a certified stabilizer
chain with successive indices 16, 8, and 8, ending in the trivial subgroup.
Each step uses explicit word representatives, distinct orbit points, and a
complete Schreier transition table. Thus its order is 16 * 8 * 8 = 1024.

The fixed generators and their ATLAS word provenance are in `SylowData` and
`QuotientInvolutions/source/sylow.json`. The certificate generator is saved in
`SylowCard/source/generate.py`; its computations supply witnesses only.
-/

public section
namespace Janko4.Simplicity.Max1Fusion.QuotientInvolutions
open Cardinality.QuotientCount.Image Theory.GroupTheory SylowCardCertificate

private theorem image_eq : sylowCandidate.map StarGroup.subtype = group0 := by
  rw [sylowCandidate, MonoidHom.map_closure, ← Set.range_comp]
  change Subgroup.closure (Set.range (fun i => (sylowGenerator i).val)) = group0
  rw [← gen0_eq]
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨[i], by simp [evalWord]⟩
  · rintro g ⟨w, rfl⟩
    exact StarOrderCertificate.word_mem gen0 (Subgroup.closure (Set.range gen0))
      (fun i => Subgroup.subset_closure ⟨i, rfl⟩) w

/-- The exact order of the fixed subgroup generated by `sylowGenerator`. -/
theorem sylowCandidate_card : Nat.card sylowCandidate = 1024 := by
  have hlast : Nat.card group3 = 1 := wordSubgroup_fin_zero_card gen3 inv3 inverse3
  have hperm : Nat.card group0 = 1024 := by
    rw [card0, card1, card2, hlast]
  calc
    Nat.card sylowCandidate = Nat.card (sylowCandidate.map StarGroup.subtype) :=
      Nat.card_congr (sylowCandidate.equivMapOfInjective
        StarGroup.subtype StarGroup.subtype_injective).toEquiv
    _ = 1024 := by rw [image_eq, hperm]

end Janko4.Simplicity.Max1Fusion.QuotientInvolutions
