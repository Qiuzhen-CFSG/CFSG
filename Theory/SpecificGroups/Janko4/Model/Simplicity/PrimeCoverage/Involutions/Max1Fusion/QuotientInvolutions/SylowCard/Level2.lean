module

public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.QuotientInvolutions.SylowCard.Data3

/-!
# Exact Sylow candidate stabilizer count, level 2

Exact Schreier transitions for the fixed `SylowData` generators. The tables
are generated by `source/generate.py`; every finite identity is kernel checked.
The generic word-subgroup bijection proves the count, without trusting the
external enumeration used to discover these witnesses.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

@[expose] public section
namespace Janko4.Simplicity.Max1Fusion.QuotientInvolutions.SylowCardCertificate
open Theory.GroupTheory

def repWords2 : Fin 8 → List (Fin 4) :=
  ![[], [0], [1], [2], [3], [1, 0], [2, 0], [3, 0]]

def rep2 (i : Fin 8) := evalWord gen2 (repWords2 i)

def point2 : Fin 8 → Fin 24 := ![2, 5, 9, 3, 7, 12, 19, 23]

def act2 : Fin 4 → Fin 8 → Fin 8 :=
  ![![1, 0, 5, 7, 6, 2, 4, 3], ![2, 5, 0, 6, 7, 1, 3, 4], ![3, 6, 7, 5, 0, 4, 2, 1], ![4, 7, 6, 0, 5, 3, 1, 2]]

def factor2 : Fin 4 → Fin 8 → List (Fin 0) :=
  ![![[], [], [], [], [], [], [], []], ![[], [], [], [], [], [], [], []], ![[], [], [], [], [], [], [], []], ![[], [], [], [], [], [], [], []]]

theorem step2 : ∀ i r,
    gen2 i * rep2 r = rep2 (act2 i r) * evalWord gen3 (factor2 i r) := by
  decide +kernel

theorem card2 : Nat.card group2 = 8 * Nat.card group3 := by
  apply wordSubgroup_card_eq_mul_next gen2 inv2 inverse2
    gen3 inv3 inverse3 rep2 act2 factor2 2 point2 0
  · intro r; exact ⟨repWords2 r, rfl⟩
  · exact inclusion3
  · rfl
  · decide +kernel
  · decide +kernel
  · exact wordSubgroup_fix_of_gen_fix gen3 inv3 inverse3
      (by intro i; exact Fin.elim0 i)
  · exact step2

end Janko4.Simplicity.Max1Fusion.QuotientInvolutions.SylowCardCertificate
