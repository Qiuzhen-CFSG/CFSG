module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.AdequateLocal
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FirstGenerator.OddIndex.CentralizerSylow
public import Theory.GroupAction.ElementarySylowFixerBound

/-!
# Elementary pointwise Sylow fixers of J₄

The literal involution centralizer supplies an ambient Sylow subgroup whose
center is generated by that involution. Sylow conjugacy transfers its order
two center to every Sylow subgroup. Full intrinsic automorphism innerness
then excludes a faithful elementary four-group of pointwise Sylow fixers.

Source: GLS3 Table 5.3i, and Aschbacher–Smith, 1.1.5(3)(f), pp.501–503,
as used in the proof of 13.6.6, p.927. Centerlessness can be inherited from
the actual component quotient; no additional simplicity certification is used.
-/

public section
open Subgroup
namespace Janko4
open OuterReduction OuterReduction.OddIndex
attribute [local irreducible] modelGroup matrixA matrixB

theorem sylow_center_card_two (S : Sylow 2 Model) : Nat.card (center S) = 2 := by
  obtain ⟨P⟩ := Sylow.nonempty (p := 2) (G := centralizer ({a} : Set Model))
  obtain ⟨T, hT⟩ := centralizer_sylow_is_ambient P
  rw [Nat.card_congr (centerCongr (S.equiv T)).toEquiv]
  rw [hT, ← card_map_of_injective
    (((P : Subgroup (centralizer ({a} : Set Model))).map
      (centralizer ({a} : Set Model)).subtype).subtype_injective),
    centralizer_sylow_center, Nat.card_zpowers, orderOf_a]

theorem sylow_center_isCyclic (S : Sylow 2 Model) : IsCyclic (center S) :=
  isCyclic_of_card_dvd_prime (p := 2) (by rw [sylow_center_card_two])

theorem elementary_sylow_fixer_card_le_two (hZ : center Model = ⊥)
    (S : Sylow 2 Model) (A : Subgroup (MulAut Model)) [IsElementaryAbelian 2 A]
    (hfix : ∀ b ∈ A, ∀ x ∈ S, b x = x) : Nat.card A ≤ 2 := by
  let _ := sylow_center_isCyclic S
  exact Theory.GroupAction.elementary_sylow_fixer_card_le_two_of_inner S hZ
    (fun b _ _ => AdequateLocal.exists_eq_conj b) A hfix

end Janko4
