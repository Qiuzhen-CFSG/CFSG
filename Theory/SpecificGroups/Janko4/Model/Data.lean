/-- Decode a binary matrix from its row bitsets. -/
def decodeRows (rows : Vector ℕ 112) : BinaryMatrix :=
  fun i j => if (rows.get i).testBit j.val then 1 else 0

/-- First ATLAS matrix (Type I generator a). -/
def matrixA : BinaryMatrix := decodeRows aRows

/-- Second ATLAS matrix (Type I generator b). -/
def matrixB : BinaryMatrix := decodeRows bRows

end Janko4
