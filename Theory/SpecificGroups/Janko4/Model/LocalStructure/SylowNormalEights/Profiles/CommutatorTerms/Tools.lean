module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SylowNormalEights.Profiles.Collection
/-!
# Extending the finite generator commutator calculations

A one-sided conjugation bound on generators gives relative normalization,
using finiteness of the presented group. Closure induction then extends both
variables of a generator commutator bound. The final assembly uses these facts
for the literal centralizer, derived and third-term generating sequences.
No lower bound on the order of the presentation is used.

Source: elementary subgroup commutator identities, with the presentation and
mask conventions of `SylowNormalEights/source/README.md`.
-/

@[expose] public section
open scoped commutatorElement
namespace Janko4.LocalStructure.SylowNormalEights.Presentation.Profiles.CommutatorTerms

private theorem closure_normalizes_of_generator_commutators {G : Type*} [Group G]
    [Finite G] (s t : Set G)
    (h : ∀ x ∈ s, ∀ y ∈ t, ⁅x, y⁆ ∈ Subgroup.closure s) :
    Subgroup.closure t ≤ Subgroup.normalizer (Subgroup.closure s) := by
  apply (Subgroup.closure_le _).mpr
  intro y hy
  apply Subgroup.mem_normalizer_fintype
  intro x hx
  have hc : Subgroup.closure s ≤ (Subgroup.closure s).comap (MulAut.conj y) := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    change y * x * y⁻¹ ∈ Subgroup.closure s
    have he : y * x * y⁻¹ = ⁅x, y⁆⁻¹ * x := by simp [commutatorElement_def, mul_assoc]
    rw [he]
    exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (h x hx y hy)) (Subgroup.subset_closure hx)
  exact hc hx

private theorem commutator_closures_le {G : Type*} [Group G]
    (s t : Set G) (K : Subgroup G)
    (hs : Subgroup.closure s ≤ Subgroup.normalizer K)
    (ht : Subgroup.closure t ≤ Subgroup.normalizer K)
    (h : ∀ x ∈ s, ∀ y ∈ t, ⁅x, y⁆ ∈ K) :
    ⁅Subgroup.closure s, Subgroup.closure t⁆ ≤ K := by
  apply Subgroup.commutator_le.mpr
  intro x hx y hy
  have hx' : ∀ y ∈ t, ⁅x, y⁆ ∈ K := by
    induction hx using Subgroup.closure_induction with
    | mem x hx => exact h x hx
    | one => intro y _; simp
    | mul a b ha _ ia ib =>
      intro y hy
      rw [commutatorElement_mul_left_eq_conj_mul]
      exact K.mul_mem ((Subgroup.mem_normalizer_iff.mp (hs ha) _).mp (ib y hy)) (ia y hy)
    | inv a ha ih =>
      intro y hy
      rw [commutatorElement_inv_left, ← commutatorElement_inv]
      have hh := (Subgroup.mem_normalizer_iff.mp (hs (Subgroup.inv_mem _ ha)) _).mp
        (K.inv_mem (ih y hy))
      simpa only [inv_inv] using hh
  induction hy using Subgroup.closure_induction with
  | mem y hy => exact hx' y hy
  | one => simp
  | mul a b ha _ ia ib =>
    rw [commutatorElement_mul_right_eq_mul_conj, mul_assoc, mul_assoc]
    simpa only [mul_assoc] using K.mul_mem ia ((Subgroup.mem_normalizer_iff.mp (ht ha) _).mp ib)
  | inv a ha ih =>
    rw [commutatorElement_inv_right, ← commutatorElement_inv]
    have hh := (Subgroup.mem_normalizer_iff.mp (ht (Subgroup.inv_mem _ ha)) _).mp (K.inv_mem ih)
    simpa only [inv_inv] using hh

/-- Subgroup generated by a finite list of literal normal forms. -/
def maskClosure (l : List (Fin (2 ^ 21))) : Subgroup Carrier :=
  Subgroup.closure {x | x ∈ l.map normalForm}

theorem normalForm_mem (l : List (Fin (2 ^ 21))) (a : Fin (2 ^ 21)) (ha : a ∈ l) :
    normalForm a ∈ maskClosure l :=
  Subgroup.subset_closure (List.mem_map.mpr ⟨a, ha, rfl⟩)

theorem maskClosure_le (l : List (Fin (2 ^ 21))) (K : Subgroup Carrier)
    (h : ∀ a ∈ l, normalForm a ∈ K) : maskClosure l ≤ K := by
  apply (Subgroup.closure_le _).mpr
  intro x hx
  obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hx
  exact h a ha

theorem maskProduct_mem (K : Subgroup Carrier) (l : List (Fin (2 ^ 21)))
    (h : ∀ a ∈ l, normalForm a ∈ K) : wordValue (l.flatMap maskWord) ∈ K := by
  induction l with
  | nil => exact K.one_mem
  | cons a l ih =>
    rw [List.flatMap_cons, wordValue_append, wordValue_maskWord]
    exact K.mul_mem (h a List.mem_cons_self)
      (ih (fun b hb => h b (List.mem_cons_of_mem a hb)))

/-- A collected product gives a membership certificate without counting. -/
theorem product_mem (l factors : List (Fin (2 ^ 21))) (a : Fin (2 ^ 21)) (fuel : ℕ)
    (hf : ∀ b ∈ factors, b ∈ l)
    (hc : collect fuel (factors.flatMap maskWord) = maskWord a) :
    normalForm a ∈ maskClosure l := by
  have he := wordValue_eq_of_collect fuel _ _ hc
  rw [wordValue_maskWord] at he
  rw [← he]
  exact maskProduct_mem _ factors (fun b hb => normalForm_mem l b (hf b hb))

/-- The same product certificate in an arbitrary subgroup. -/
theorem product_mem_of_mem (K : Subgroup Carrier) (factors : List (Fin (2 ^ 21)))
    (a : Fin (2 ^ 21)) (fuel : ℕ)
    (hf : ∀ b ∈ factors, normalForm b ∈ K)
    (hc : collect fuel (factors.flatMap maskWord) = maskWord a) : normalForm a ∈ K := by
  have he := wordValue_eq_of_collect fuel _ _ hc
  rw [wordValue_maskWord] at he
  rw [← he]
  exact maskProduct_mem K factors hf

theorem inverse_mem (K : Subgroup Carrier) (a b : Fin (2 ^ 21)) (fuel : ℕ)
    (ha : normalForm a ∈ K)
    (hc : collect fuel (inverseWord (maskWord a)) = maskWord b) : normalForm b ∈ K := by
  have he := wordValue_eq_of_collect fuel _ _ hc
  rw [wordValue_inverseWord, wordValue_maskWord, wordValue_maskWord] at he
  rw [← he]
  exact K.inv_mem ha

theorem comm_mem_swap (K : Subgroup Carrier) (a b : Carrier)
    (h : ⁅a, b⁆ ∈ K) : ⁅b, a⁆ ∈ K := by
  rw [← commutatorElement_inv]
  exact K.inv_mem h

theorem normalizes (s t : List (Fin (2 ^ 21)))
    (h : ∀ a ∈ s, ∀ b ∈ t, ⁅normalForm a, normalForm b⁆ ∈ maskClosure s) :
    maskClosure t ≤ Subgroup.normalizer (maskClosure s) := by
  apply closure_normalizes_of_generator_commutators
  intro x hx y hy
  obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hx
  obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hy
  exact h a ha b hb

theorem commutator_le (s t : List (Fin (2 ^ 21))) (K : Subgroup Carrier)
    (hs : maskClosure s ≤ Subgroup.normalizer K)
    (ht : maskClosure t ≤ Subgroup.normalizer K)
    (h : ∀ a ∈ s, ∀ b ∈ t, ⁅normalForm a, normalForm b⁆ ∈ K) :
    ⁅maskClosure s, maskClosure t⁆ ≤ K := by
  apply commutator_closures_le _ _ K hs ht
  intro x hx y hy
  obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hx
  obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hy
  exact h a ha b hb

/-- Finite generator data with the relative-normalization obligations included. -/
theorem assemble (c d t : List (Fin (2 ^ 21)))
    (hd : maskClosure d ≤ ⁅maskClosure c, maskClosure c⁆)
    (ht : maskClosure t ≤ ⁅maskClosure d, maskClosure c⁆)
    (htd : maskClosure t ≤ maskClosure d)
    (hcc : ∀ a ∈ c, ∀ b ∈ c, ⁅normalForm a, normalForm b⁆ ∈ maskClosure d)
    (hdc : ∀ a ∈ d, ∀ b ∈ c, ⁅normalForm a, normalForm b⁆ ∈ maskClosure t)
    (htc : ∀ a ∈ t, ∀ b ∈ c, ⁅normalForm a, normalForm b⁆ ∈ maskClosure t) :
    ⁅maskClosure c, maskClosure c⁆ = maskClosure d ∧
      ⁅maskClosure d, maskClosure c⁆ = maskClosure t := by
  have hdn := normalizes d c (fun a ha b hb => htd (hdc a ha b hb))
  have htn := normalizes t c htc
  have hdc' : maskClosure d ≤ maskClosure c := hd.trans (Subgroup.commutator_le_self _)
  exact ⟨le_antisymm (commutator_le c c _ hdn hdn hcc) hd,
    le_antisymm (commutator_le d c _ (hdc'.trans htn) htn hdc) ht⟩

/-- Mask form of the literal third-term generator lists. -/
def thirdMasks (i : Fin 3) : List (Fin (2 ^ 21)) :=
  ![[512, 16384, 65536, 131072, 262144, 524288, 1048576],
    [64, 512, 2048, 16384, 32768, 65536, 131072, 262144, 524288, 1048576],
    [64, 512, 2048, 16384, 65536, 131072, 262144, 524288, 1048576]] i

theorem thirdMasks_closure (i : Fin 3) : maskClosure (thirdMasks i) = thirdCandidate i := by
  have hw : (thirdMasks i).map maskWord = (thirdIndices i).map (fun a => [a]) :=
    (by decide +kernel : ∀ i : Fin 3,
      (thirdMasks i).map maskWord = (thirdIndices i).map (fun a => [a])) i
  have he := congrArg (List.map wordValue) hw
  simp only [List.map_map, Function.comp_def, wordValue_maskWord,
    wordValue_cons, wordValue_nil, mul_one] at he
  unfold maskClosure thirdCandidate
  rw [he]

end Janko4.LocalStructure.SylowNormalEights.Presentation.Profiles.CommutatorTerms
