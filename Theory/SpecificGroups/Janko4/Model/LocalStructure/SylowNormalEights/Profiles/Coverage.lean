module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SylowNormalEights.Profiles.Coverage.FiniteCatalogue
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SylowNormalEights.Profiles.Coverage.UpperCenter

/-!
# The upper-center normal-eight catalogue

`Coverage.normal_eight_in_upperCube` classifies every normal eight in
the literal subgroup generated by `g17,g18,g19,g20`. The checked commutator
tests in `Coverage.UpperCenter` place the third upper center in that subgroup.
Combining these results proves the exact `CatalogueCoverage` contract under
only the order-2²¹ hypothesis, which supplies normal-form uniqueness.

Source context and literal-word provenance are documented in
`Coverage/FiniteCatalogue.lean` and `SylowNormalEights/source/README.md`.
-/

public section

namespace Janko4.LocalStructure.SylowNormalEights.Presentation.Profiles
/-- Reduce coverage to the upper-center bound and the finite normal-eight classification. -/
theorem catalogueCoverage_of_upperCenter_bound (hcard : Nat.card Carrier = 2 ^ 21)
    (hupper : Subgroup.upperCentralSeries Carrier 3 ≤ Coverage.upperCube) : CatalogueCoverage := by
  intro A hnormal _ hsize hle
  exact Coverage.normal_eight_in_upperCube hcard A hnormal hsize (hle.trans hupper)

/-- Every normal elementary abelian eight in the third upper center is one of
the three literal family entries. The order hypothesis is the only premise. -/
theorem catalogueCoverage_of_card (hcard : Nat.card Carrier = 2 ^ 21) : CatalogueCoverage :=
  catalogueCoverage_of_upperCenter_bound hcard (Coverage.upperCentralSeries_le_upperCube hcard)

end Janko4.LocalStructure.SylowNormalEights.Presentation.Profiles
