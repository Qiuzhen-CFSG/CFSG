module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SylowNormalEights.Catalogue

/-!
# Literal candidates for the centralizer calculation

These subgroups use the ascending binary masks in `../source/profile-data.json`.
The centralizer and derived rows are only definitions, chosen by the untrusted
GAP discovery recorded in that directory. Their equality with the full
centralizers and actual commutator subgroups is a separate obligation.

The proposed third terms use single canonical generators; `ThirdOrders`
proves their orders from collection and uniqueness. That counting assertion
does not identify them with the actual lower-central terms.

Source context: Kleidman–Wilson (1988), pp. 484–510; conventions and provenance
are documented in `SylowNormalEights/source/README.md`.
-/

@[expose] public section
namespace Janko4.LocalStructure.SylowNormalEights.Presentation.Profiles

/-- Ascending binary masks for the proposed full centralizers. -/
def centralizerMasks (i : Fin 3) : List (Fin (2 ^ 21)) :=
  ![[1179937, 2, 176200, 1312272, 32832, 128, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576],
    [1765409, 130, 4, 1105480, 1377808, 64, 1777920, 344576, 664576, 1198080, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576],
    [33, 130, 132, 1489992, 1312272, 1376320, 1634560, 344576, 525312, 1263616, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576]] i

/-- Ascending binary masks for the proposed derived subgroups. -/
def derivedMasks (i : Fin 3) : List (Fin (2 ^ 21)) :=
  ![[176200, 32832, 606720, 1263616, 16384, 32768, 65536, 131072, 262144, 524288, 1048576],
    [1105480, 1377808, 32832, 344576, 1319936, 804864, 16384, 32768, 65536, 131072, 262144, 524288, 1048576],
    [1105480, 1639952, 1638464, 606720, 1090560, 67584, 16384, 32768, 65536, 131072, 262144, 524288, 1048576]] i

/-- Canonical generator indices for the proposed third lower-central terms. -/
def thirdIndices (i : Fin 3) : List (Fin 21) :=
  ![[9, 14, 16, 17, 18, 19, 20],
    [6, 9, 11, 14, 15, 16, 17, 18, 19, 20],
    [6, 9, 11, 14, 16, 17, 18, 19, 20]] i

/-- The subgroup generated by each proposed full-centralizer sequence. -/
def centralizerCandidate (i : Fin 3) : Subgroup Carrier :=
  Subgroup.closure {x | x ∈ (centralizerMasks i).map normalForm}

/-- The subgroup generated by each proposed derived sequence. -/
def derivedCandidate (i : Fin 3) : Subgroup Carrier :=
  Subgroup.closure {x | x ∈ (derivedMasks i).map normalForm}

/-- The subgroup generated by each proposed third-term sequence. -/
def thirdCandidate (i : Fin 3) : Subgroup Carrier :=
  Subgroup.closure {x | x ∈ (thirdIndices i).map generator}

end Janko4.LocalStructure.SylowNormalEights.Presentation.Profiles
