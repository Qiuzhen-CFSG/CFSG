/-- The complete right-multiplication table for the eight representatives. -/
theorem steps (a : Fin 8) (g : Fin 21) :
    ∃ b : Fin 8, normalForm (representatives 0 a) * generator g *
      (normalForm (representatives 0 b))⁻¹ ∈ centralizerCandidate 0 := by
  fin_cases a
  · exact steps_0 g
  · exact steps_1 g
  · exact steps_2 g
  · exact steps_3 g
  · exact steps_4 g
  · exact steps_5 g
  · exact steps_6 g
  · exact steps_7 g

