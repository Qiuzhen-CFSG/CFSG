module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SylowNormalEights.Presentation
public import Theory.GroupTheory.CentralizerLowerCentralCard

/-!
# Marked candidates for the three normal eights

The three candidate subgroups are generated by `{g18,g19,g20}`,
`{g17,g19,g20}`, and `{g17*g18,g19,g20}`, with zero-based generator indices.
These are actual subgroups of the universal presentation, not family tags.
Their completeness and centralizer orders remain separate proof obligations.

The order-2²¹ consistency premise can be discharged by a surjective matrix
realization, since `Presentation.card_le` already proves the upper bound.
It also makes the binary normal forms unique; no multiplication table of size
2²¹ is part of this interface.

Source: the candidate generators from the saved `NormalEightProfiles.g`
exploration; see `source/README.md`. GAP output is used only to choose words.
-/

@[expose] public section
namespace Janko4.LocalStructure.SylowNormalEights.Presentation

/-- The marked generators, in the order of the proposed invariant values. -/
def familyGenerator (i : Fin 3) : Fin 3 → Carrier :=
  ![![generator 18, generator 19, generator 20],
    ![generator 17, generator 19, generator 20],
    ![generator 17 * generator 18, generator 19, generator 20]] i

/-- The three literal generated subgroups of the presentation. -/
def family (i : Fin 3) : Subgroup Carrier :=
  Subgroup.closure (Set.range (familyGenerator i))

/-- Expected orders of the third lower-central terms of the full centralizers. -/
def profileOrder (i : Fin 3) : ℕ := ![128, 1024, 512] i

/-- The outstanding upper-center catalogue assertion on this precise presentation. -/
def CatalogueCoverage : Prop :=
  ∀ A : Subgroup Carrier, A.Normal → IsElementaryAbelian 2 A →
    Nat.card A = 8 → A ≤ Subgroup.upperCentralSeries Carrier 3 →
      ∃ i, A = family i

/-- The outstanding full-centralizer calculation, with Mathlib's index convention. -/
def CentralizerProfiles : Prop :=
  ∀ i, Subgroup.centralizerLowerCentralCard (family i) 2 = profileOrder i

/-- Consistency at the full order makes the already-surjective forms unique. -/
theorem normalForm_bijective_of_card (hcard : Nat.card Carrier = 2 ^ 21) :
    Function.Bijective normalForm :=
  normalForm_surjective.bijective_of_nat_card_le (by rw [Nat.card_fin, hcard])

end Janko4.LocalStructure.SylowNormalEights.Presentation
