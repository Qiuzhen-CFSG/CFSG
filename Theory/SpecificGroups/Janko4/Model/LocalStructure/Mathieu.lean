module

public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder
public import Theory.Mathieu.M24.TwoLocalExtensions
public import Theory.ElementaryAbelian.Basic

/-!
# The concrete E2048.M24 local subgroup of J4

The binary-coordinate certificates make the specified normal closure elementary
abelian. The action-image and quotient orders are equal, so the descended
conjugation action is faithful. Combining this action with the certified star
comparison and its explicit relabeling gives an actual M24 quotient isomorphism.
Simplicity of M24 then identifies the normal closure with the full two-core.
In particular that core is nontrivial and self-centralizing.

All statements refer to the subgroup generated by the literal ATLAS
`J4G1-max1W1` program, documented in `Cardinality.Subgroup`. These are the
intrinsic local facts from GLS3, Table 5.3i, needed by the J4 case in
Aschbacher–Smith 2.3.9(7), printed p.526. We do not assert splitting, Sylow
containment in the ambient model, or the existence of a generating local cover.
-/

@[expose] public section

open Subgroup
open Janko4 Janko4.Cardinality Janko4.Cardinality.QuotientCount

namespace Janko4.LocalStructure
variable (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1)

private def quotientAction : LocalQuotient hA hB →* ActionImage hA hB :=
  QuotientGroup.lift (localKernel hA hB) (action hA hB).rangeRestrict (by
    intro n hn
    apply Subtype.ext
    exact localKernel_le_action_ker_certified hA hB hn)

private theorem quotientAction_bijective : Function.Bijective (quotientAction hA hB) := by
  have hs : Function.Surjective (quotientAction hA hB) :=
    QuotientGroup.lift_surjective_of_surjective _ _
      (action hA hB).rangeRestrict_surjective _
  exact hs.bijective_of_nat_card_le (by
    rw [localQuotient_card, actionImage_card])

/-- Faithfulness of the quotient action follows from the two independent counts. -/
theorem action_ker_eq_localKernel : (action hA hB).ker = localKernel hA hB := by
  apply le_antisymm
  · intro g hg
    apply (QuotientGroup.eq_one_iff g).mp
    apply (quotientAction_bijective hA hB).1
    change (action hA hB).rangeRestrict g = quotientAction hA hB 1
    rw [map_one]
    exact Subtype.ext hg
  · exact localKernel_le_action_ker_certified hA hB

/-- The actual quotient, identified through its conjugation action and star relabeling. -/
noncomputable def localQuotientEquivM24 : LocalQuotient hA hB ≃* Sporadic.Mathieu.M24 :=
  (quotientEquivImage hA hB (action_ker_eq_localKernel hA hB)).trans
    ((Image.actionImageEquivStarGroup hA hB).trans Image.starGroupEquivM24)

/-- The binary normal closure is self-centralizing inside the concrete local subgroup. -/
theorem centralizer_localKernel :
    centralizer (localKernel hA hB : Set (max1Subgroup hA hB)) = localKernel hA hB := by
  rw [← action_ker_eq_centralizer, action_ker_eq_localKernel]

/-- The coordinates preserve XOR multiplication, so the kernel is elementary abelian. -/
theorem localKernel_elementary : IsElementaryAbelian 2 (localKernel hA hB) := by
  refine {
    toIsMulCommutative := ⟨⟨fun x y => Subtype.ext
      (Image.localKernel_commute hA hB x x.property y y.property)⟩⟩
    exponent_dvd_p := ?_ }
  apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
  intro x
  obtain ⟨v, rfl⟩ := Image.coordinates_surjective hA hB x
  rw [pow_two, Image.coordinates_mul]
  apply Subtype.ext
  simp [Image.coordinates_val, KernelCount.binaryProduct_zero]

/-- No additional normal two-subgroup remains above the certified binary kernel. -/
theorem localKernel_eq_twoCore : localKernel hA hB = pCore 2 (max1Subgroup hA hB) := by
  let f := (localQuotientEquivM24 hA hB).toMonoidHom.comp
    (QuotientGroup.mk' (localKernel hA hB))
  have hs : Function.Surjective f := (localQuotientEquivM24 hA hB).surjective.comp
    (QuotientGroup.mk'_surjective _)
  have hk : f.ker = localKernel hA hB := by
    ext x
    change localQuotientEquivM24 hA hB (QuotientGroup.mk' _ x) = 1 ↔ _
    rw [map_eq_one_iff _ (localQuotientEquivM24 hA hB).injective]
    exact QuotientGroup.eq_one_iff x
  have hp : IsPGroup 2 f.ker := by
    rw [hk]
    exact IsPGroup.of_card (n := 11) (localKernel_card hA hB)
  have he := Sporadic.Mathieu.ker_eq_twoCore_of_surjective_m24 f hs hp
  rwa [hk] at he

/-- The certified order 2048 excludes the trivial kernel. -/
theorem localKernel_ne_bot : localKernel hA hB ≠ ⊥ := by
  intro h
  have hc := localKernel_card hA hB
  rw [h, Subgroup.card_bot] at hc
  norm_num at hc

/-- The quotient isomorphism is compatible with the actual left-conjugation action. -/
theorem localQuotientEquivM24_apply (g : max1Subgroup hA hB) :
    localQuotientEquivM24 hA hB (QuotientGroup.mk' (localKernel hA hB) g) =
      Image.starGroupEquivM24 (Image.actionImageEquivStarGroup hA hB
        ((action hA hB).rangeRestrict g)) := by
  rfl

/-- The concrete local subgroup supplies one Mathieu factor with its binary kernel retained. -/
theorem max1_hasMathieuTwoLayer : Sporadic.Mathieu.HasMathieuTwoLayer (max1Subgroup hA hB) := by
  refine ⟨localKernel hA hB, inferInstance,
    IsPGroup.of_card (n := 11) (localKernel_card hA hB),
    ⊤, inferInstance, 1, ?_, ?_⟩
  · exact ⟨Subgroup.topEquiv.trans ((localQuotientEquivM24 hA hB).trans
      (MulEquiv.funUnique (Fin 1) Sporadic.Mathieu.M24).symm)⟩
  · let := QuotientGroup.subsingleton_quotient_top (G := LocalQuotient hA hB)
    intro g
    exact ⟨0, Subsingleton.elim _ _⟩

end Janko4.LocalStructure

end
