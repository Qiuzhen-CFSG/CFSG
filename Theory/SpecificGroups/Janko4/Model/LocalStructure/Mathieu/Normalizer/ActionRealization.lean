module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.MathieuSeedCentralizer.AmbientOrder
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.LowerBound
public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.KernelOrbits

/-!
# Realizing the ambient action on the literal max1 kernel

Let M be the subgroup generated by the ATLAS max1 words and E its embedded
binary kernel. An ambient normalizer element sends the seed into E. The
certified two-orbit cover inside M sends this conjugate to the seed or to
`kernelPair`. The latter alternative is impossible: its ambient fusion to a
would identify full centralizers, whereas C(a) contains the max2 subgroup of
order at least 21799895040 and the seed centralizer has order at most 1816657920.

In the seed alternative a local correction centralizes the seed. The proved
full seed-centralizer bound places this correction in M, hence the original
normalizer element is itself in M and realizes its own action on every e in E.
The membership argument stays private; the parent normalizer assembly can
consume the action realization together with its separate centralizer result.

Source: GLS3, Table 5.3i, printed p.270, and the literal ATLAS `J4G1-max1W1`
program documented in `Cardinality.Subgroup`. All comparisons use the actual
matrix carrier and embedded subgroups; no ambient order or simplicity result
is required.
-/

public section

open Subgroup Janko4 Janko4.Cardinality
namespace Janko4.LocalStructure.MathieuNormalizer
open OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
open Simplicity.Max1Fusion
attribute [local irreducible] modelGroup matrixA matrixB max1Subgroup localKernel localKernelSeed
local notation "M" => max1Subgroup matrixA_mul_self matrixB_pow_four
local notation "E" => Subgroup.map (Subgroup.subtype M) (localKernel matrixA_mul_self matrixB_pow_four)
local notation "t" => (localKernelSeed matrixA_mul_self matrixB_pow_four : Model)

private theorem first_centralizer_card_ge :
    21799895040 ≤ Nat.card (centralizer ({Janko4.a} : Set Model)) := by
  have hm := Subgroup.card_le_of_le (Subgroup.map_le_range
    (f := centralizerToModel) localSubgroup)
  rw [Subgroup.card_map_of_injective centralizerToModel_injective,
    centralizerToModel_range] at hm
  exact sourceSubgroup_card_ge.trans
    (card_sourceSubgroup_eq_localSubgroup.le.trans hm)

private theorem first_not_isConj_seed : ¬ IsConj Janko4.a t := by
  intro h
  obtain ⟨g, hg⟩ := isConj_iff.mp h
  have hc := map_centralizer_le_centralizer_image ({Janko4.a} : Set Model)
    (MulAut.conj g).toMonoidHom
  rw [Set.image_singleton] at hc
  change (centralizer ({Janko4.a} : Set Model)).map (MulAut.conj g).toMonoidHom ≤
    centralizer ({g * Janko4.a * g⁻¹} : Set Model) at hc
  rw [hg] at hc
  have hcard := Subgroup.card_le_of_le hc
  rw [Subgroup.card_map_of_injective (MulAut.conj g).injective] at hcard
  have hupper := MathieuSeedCentralizer.ambientSeedCentralizer_card_le
  have hlower := first_centralizer_card_ge
  change Nat.card (centralizer ({t} : Set Model)) ≤ 1816657920 at hupper
  omega

private theorem seed_ne_one : t ≠ 1 := by
  intro ht
  obtain ⟨g, hg⟩ := seed_fuses_second matrixA_mul_self matrixB_pow_four
  rw [ht, mul_one, mul_inv_cancel] at hg
  have ho := Simplicity.involutionRepresentative_one_orderOf matrixA_mul_self matrixB_pow_four
  change orderOf (Simplicity.word (Simplicity.a matrixA_mul_self)
    (Simplicity.b matrixB_pow_four) "ababb" ^ 5) = 2 at ho
  rw [hg, orderOf_one] at ho
  omega

private theorem normalizer_mem_max1 (g : Model)
    (hg : g ∈ normalizer (E : Set Model)) : g ∈ M := by
  have ht : t ∈ E := ⟨_, localKernelSeed_mem _ _, rfl⟩
  have hu : g * t * g⁻¹ ∈ E := (mem_normalizer_iff.mp hg t).mp ht
  have hu_ne : g * t * g⁻¹ ≠ 1 := by
    intro he
    apply seed_ne_one
    have he' := congrArg (fun w : Model => g⁻¹ * w * g) he
    simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one] using he'
  obtain ⟨z, hz, hzu⟩ := hu
  have hz_ne : z ≠ 1 := by
    intro he
    apply hu_ne
    rw [← hzu, he, map_one]
  obtain ⟨m, hm | hm⟩ := kernel_nonidentity_orbits matrixA_mul_self matrixB_pow_four z hz hz_ne
  · have he := congrArg (fun w : M => (w : Model)) hm
    change t = (m : Model) * (z : Model) * (m : Model)⁻¹ at he
    change (z : Model) = g * t * g⁻¹ at hzu
    rw [hzu] at he
    have hc : (m : Model) * g ∈ MathieuSeedCentralizer.ambientSeedCentralizer
        matrixA_mul_self matrixB_pow_four := by
      apply mem_centralizer_singleton_iff.mpr
      have he' : t = ((m : Model) * g) * t * ((m : Model) * g)⁻¹ := by
        simpa only [mul_inv_rev, mul_assoc] using he
      exact (mul_inv_eq_iff_eq_mul.mp he'.symm)
    have hmg := MathieuSeedCentralizer.ambientSeedCentralizer_le_max1_of_card_le
      matrixA_mul_self matrixB_pow_four
      MathieuSeedCentralizer.ambientSeedCentralizer_card_le hc
    have := Subgroup.mul_mem M (Subgroup.inv_mem M m.property) hmg
    simpa only [inv_mul_cancel_left] using this
  · have he := congrArg (fun w : M => (w : Model)) hm
    change (kernelPair matrixA_mul_self matrixB_pow_four : Model) =
      (m : Model) * (z : Model) * (m : Model)⁻¹ at he
    change (z : Model) = g * t * g⁻¹ at hzu
    rw [hzu] at he
    have htp : IsConj t (kernelPair matrixA_mul_self matrixB_pow_four : Model) :=
      isConj_iff.mpr ⟨(m : Model) * g, by
        simpa only [mul_inv_rev, mul_assoc] using he.symm⟩
    obtain ⟨k, hk⟩ := pair_fuses_first matrixA_mul_self matrixB_pow_four
    have hpa : IsConj (kernelPair matrixA_mul_self matrixB_pow_four : Model) Janko4.a :=
      isConj_iff.mpr ⟨k, hk.symm⟩
    exact (first_not_isConj_seed (htp.trans hpa).symm).elim

/-- Every ambient normalizer action on the actual embedded local kernel is
realized by an element of the literal max1 subgroup. -/
theorem localKernel_action_realization (g : Model)
    (hg : g ∈ normalizer (E : Set Model)) :
    ∃ h ∈ M, ∀ e ∈ E, g * e * g⁻¹ = h * e * h⁻¹ := by
  exact ⟨g, normalizer_mem_max1 g hg, fun _ _ => rfl⟩

end Janko4.LocalStructure.MathieuNormalizer
