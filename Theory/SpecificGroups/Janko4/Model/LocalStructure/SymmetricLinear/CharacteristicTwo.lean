module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SymmetricLinear.CharacteristicTwo.Coordinates
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SymmetricLinear.CharacteristicTwo.NormalClosure
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SymmetricLinear.CharacteristicTwo.Commutant
public import Theory.LinearAlgebra.BinaryTriangularPGroup
public import Theory.PGroupCore
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Characteristic two for the literal J₄ max4 subgroup

The subgroup `Q` is the intrinsic normal closure of `(x*y²)^6`, with `x,y`
the literal ATLAS outputs. The certified invariant flag makes Q a two-group.
The commutant of eleven certified conjugates is lower triangular in the
supplied binary basis, so C_max4(Q) is a normal two-group. Both lie in
the intrinsic two-core, giving C_max4(O₂(max4)) ≤ O₂(max4).

The conditional reductions retain their public interfaces. The final theorem
`max4_twoCore_centralizer_le` discharges every premise using the imported
`Basis`, `NormalClosure` and `Commutant` certificates, including the faithful
change of basis and the literal word-centralizer transport.

Source: Aschbacher–Smith, Theorem 0.1.2(5), printed p.4; condition E on
pp.3–4 and 481–482, and the sporadic Sylow-overgroup discussion A.3.12,
pp.47–48. ATLAS provenance is retained beside `SymmetricLinear.Model`.
-/

@[expose] public section

namespace Janko4.LocalStructure.SymmetricLinear.CharacteristicTwo
open Coordinates

/-- The finite matrix commutant certificate controls the entire intrinsic
centralizer, not merely the subgroup generated by the eleven elements. -/
theorem centralizer_seedNormalClosure_isPGroup_of_matrix_certificates
    (hr : decodeRows basisRows * decodeRows basisInverseRows = 1)
    (hl : decodeRows basisInverseRows * decodeRows basisRows = 1)
    (heval : ∀ k : Fin 11,
      coordinates (seedConjugate k.val) = decodeRows (conjugateRows.get k))
    (hcommutant : ∀ M : BinaryMatrix,
      (∀ k : Fin 11, Commute M (decodeRows (conjugateRows.get k))) →
        ∀ i j, i < j → M i j = 0) :
    IsPGroup 2 (Subgroup.centralizer (seedNormalClosure : Set max4Subgroup)) := by
  let C := Subgroup.centralizer (seedNormalClosure : Set max4Subgroup)
  let f := (coordinateHom hr hl).comp C.subtype
  apply IsPGroup.of_injective_binary_lowerTriangular f
    ((coordinateHom_injective hr hl).comp Subtype.val_injective)
  intro g
  apply hcommutant
  intro k
  change Commute (coordinateHom hr hl (g : max4Subgroup))
    (decodeRows (conjugateRows.get k))
  rw [← heval k, ← coordinateHom_apply hr hl]
  have hc : Commute (g : max4Subgroup) (seedConjugate k.val) :=
    (g.property _ (seedConjugate_mem_normalClosure k.val)).symm
  exact hc.map (coordinateHom hr hl)

end Janko4.LocalStructure.SymmetricLinear.CharacteristicTwo

namespace Janko4.LocalStructure.SymmetricLinear
open CharacteristicTwo CharacteristicTwo.Coordinates

/-- Assembly of the exact intrinsic two-core bound from the two independent
matrix certificate families. All displayed premises still require proofs. -/
theorem max4_twoCore_centralizer_le_of_matrix_certificates
    (hQ : IsPGroup 2 seedNormalClosure)
    (hr : decodeRows basisRows * decodeRows basisInverseRows = 1)
    (hl : decodeRows basisInverseRows * decodeRows basisRows = 1)
    (heval : ∀ k : Fin 11,
      coordinates (seedConjugate k.val) = decodeRows (conjugateRows.get k))
    (hcommutant : ∀ M : BinaryMatrix,
      (∀ k : Fin 11, Commute M (decodeRows (conjugateRows.get k))) →
        ∀ i j, i < j → M i j = 0) :
    Subgroup.centralizer (pCore 2 max4Subgroup : Set max4Subgroup) ≤
      pCore 2 max4Subgroup := by
  have hQle : seedNormalClosure ≤ pCore 2 max4Subgroup :=
    le_sSup ⟨inferInstance, hQ⟩
  have hCle : Subgroup.centralizer (seedNormalClosure : Set max4Subgroup) ≤
      pCore 2 max4Subgroup :=
    le_sSup ⟨inferInstance,
      centralizer_seedNormalClosure_isPGroup_of_matrix_certificates hr hl heval hcommutant⟩
  exact (Subgroup.centralizer_le hQle).trans hCle

/-- The actual inverse certificates discharge the change-of-basis premises.
The two remaining certificate families are the intrinsic normal-closure
calculation (including the eleven word evaluations) and the commutant bound. -/
theorem max4_twoCore_centralizer_le_of_normalClosure_and_commutant
    (hQ : IsPGroup 2 seedNormalClosure)
    (heval : ∀ k : Fin 11,
      coordinates (seedConjugate k.val) = decodeRows (conjugateRows.get k))
    (hcommutant : ∀ M : BinaryMatrix,
      (∀ k : Fin 11, Commute M (decodeRows (conjugateRows.get k))) →
        ∀ i j, i < j → M i j = 0) :
    Subgroup.centralizer (pCore 2 max4Subgroup : Set max4Subgroup) ≤
      pCore 2 max4Subgroup :=
  max4_twoCore_centralizer_le_of_matrix_certificates hQ
    basis_mul_basisInverse basisInverse_mul_basis heval hcommutant

/-- The literal ATLAS max4 subgroup has a self-centralizing intrinsic two-core.
The normal-closure, word-evaluation and commutant premises are all certified. -/
theorem max4_twoCore_centralizer_le :
    Subgroup.centralizer (pCore 2 max4Subgroup : Set max4Subgroup) ≤
      pCore 2 max4Subgroup :=
  max4_twoCore_centralizer_le_of_normalClosure_and_commutant
    seedNormalClosure_isPGroup seedConjugate_coordinates commuting_matrices_lowerTriangular

end Janko4.LocalStructure.SymmetricLinear
