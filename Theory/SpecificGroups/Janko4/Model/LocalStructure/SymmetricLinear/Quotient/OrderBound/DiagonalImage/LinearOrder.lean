module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SymmetricLinear.Quotient.OrderBound.DiagonalImage.Factors
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SymmetricLinear.Quotient.OrderBound.DiagonalImage.LinearOrder.Transitions
public import Theory.GroupTheory.SubgroupClosureFinite

/-!
# Order of the full diagonal linear factor

The 168 full matrices form a right-transition table for the two literal linear
factor generators. A checked spanning tree places every listed matrix in the
actual generated subgroup. Checked inverse transitions then cover the subgroup,
and the marked three-dimensional block distinguishes the listed matrices. Thus
the actual subgroup has order 168, with no recognition assumption.

The final theorem applies this count to the literal diagonal image through
`factorHom`; it leaves the independent symmetric-factor count to its owner.
Source: ATLAS J4G1-f2r112B0 and J4G1-max4W1; Aschbacher--Smith, printed
p.511/PDF p.528. See LinearOrder/source/README.md.
-/

public section
namespace Janko4.LocalStructure.SymmetricLinear.OrderBound.DiagonalFactors
namespace LinearEnumeration

private def generator (j : Fin 2) : BinaryMatrixˣ :=
  if j = 0 then linearFirst else linearSecond

private theorem generator_matrix (j : Fin 2) :
    (generator j : BinaryMatrix) = decodeRows (generatorRows j) := by
  fin_cases j <;> rfl

private theorem generator_mem (j : Fin 2) : generator j ∈ linearFactor := by
  fin_cases j <;> apply Subgroup.subset_closure <;> simp [generator]

private theorem generator_range : Set.range generator = {linearFirst, linearSecond} := by
  ext x
  constructor
  · rintro ⟨j, rfl⟩
    fin_cases j <;> simp [generator]
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

/-- The checked tree supplies actual subgroup elements, not just a numerical bound. -/
private theorem exists_matrix (i : Fin 168) :
    ∃ x : linearFactor, ((x : BinaryMatrixˣ) : BinaryMatrix) = decodeRows (rows i) := by
  suffices h : ∀ n (hn : n < 168), ∃ x : linearFactor,
      ((x : BinaryMatrixˣ) : BinaryMatrix) = decodeRows (rows ⟨n, hn⟩) from h i.val i.isLt
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn
    let i : Fin 168 := ⟨n, hn⟩
    change ∃ x : linearFactor, ((x : BinaryMatrixˣ) : BinaryMatrix) = decodeRows (rows i)
    by_cases hz : i = 0
    · refine ⟨1, ?_⟩
      change (1 : BinaryMatrix) = decodeRows (rows i)
      rw [hz, zero_matrix]
    · obtain ⟨hlt, heq⟩ := tree i hz
      obtain ⟨x, hx⟩ := ih (parent i).val hlt (parent i).isLt
      refine ⟨x * ⟨generator (edge i), generator_mem (edge i)⟩, ?_⟩
      change ((x : BinaryMatrixˣ) : BinaryMatrix) * (generator (edge i) : BinaryMatrix) =
        decodeRows (rows i)
      rw [hx, generator_matrix, matrix_transition, heq]

private noncomputable def representative (i : Fin 168) : linearFactor :=
  Classical.choose (exists_matrix i)

private theorem representative_matrix (i : Fin 168) :
    ((representative i : BinaryMatrixˣ) : BinaryMatrix) = decodeRows (rows i) :=
  Classical.choose_spec (exists_matrix i)

private theorem representative_injective : Function.Injective representative := by
  intro i j h
  apply matrices_injective
  change decodeRows (rows i) = decodeRows (rows j)
  rw [← representative_matrix i, ← representative_matrix j, h]

private theorem representative_surjective : Function.Surjective representative := by
  have hbase : (representative 0 : BinaryMatrixˣ) = 1 := by
    apply Units.val_injective
    exact (representative_matrix 0).trans zero_matrix
  have hnext : ∀ i j, (representative i : BinaryMatrixˣ) * generator j =
      (representative (next i j) : BinaryMatrixˣ) := by
    intro i j
    apply Units.val_injective
    change ((representative i : BinaryMatrixˣ) : BinaryMatrix) *
      (generator j : BinaryMatrix) = _
    rw [representative_matrix, generator_matrix, matrix_transition, representative_matrix]
  have hcover := Theory.GroupTheory.SubgroupEnumeration.closure_range_subset_range_of_transitions
    generator (fun i => (representative i : BinaryMatrixˣ)) 0 next prev hbase hnext next_prev
  intro x
  have hx : (x : BinaryMatrixˣ) ∈ Subgroup.closure (Set.range generator) := by
    rw [generator_range]
    exact x.property
  obtain ⟨i, hi⟩ := hcover hx
  exact ⟨i, Subtype.ext hi⟩

/-- The full 112-dimensional matrices give a bijective enumeration of the subgroup. -/
theorem card_eq : Nat.card linearFactor = 168 := by
  have h := Nat.card_eq_of_bijective representative
    ⟨representative_injective, representative_surjective⟩
  simpa using h.symm

end LinearEnumeration

/-- The actual subgroup generated by the two literal linear factors has order 168. -/
theorem linearFactor_card : Nat.card linearFactor = 168 := LinearEnumeration.card_eq

/-- Unconditional divisibility required by the diagonal-image assembly. -/
theorem linearFactor_card_dvd : Nat.card linearFactor ∣ 168 := by
  rw [linearFactor_card]

/-- Apply the full-matrix count to the actual simultaneous diagonal image. -/
theorem diagonalImage_card_dvd_symmetricFactor_mul_168 :
    Nat.card diagonalImage ∣ Nat.card symmetricFactor * 168 := by
  have h := diagonalImage_card_dvd_of_cover factorHom
    diagonalFirst_mem_factorHom diagonalSecond_mem_factorHom
  simpa only [Nat.card_prod, linearFactor_card] using h

end Janko4.LocalStructure.SymmetricLinear.OrderBound.DiagonalFactors
