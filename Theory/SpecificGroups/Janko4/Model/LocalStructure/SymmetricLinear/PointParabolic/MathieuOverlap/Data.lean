module
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SymmetricLinear.CoreCenter.Size
public import Mathlib.Algebra.Group.Units.Hom
public import Theory.ElementaryAbelian.AbelianNormalClosure
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.SymmetricLinear.PointParabolic

/-!
# Certified words for the max4 point-parabolic Mathieu intersection

These are literal words in the ATLAS max4 outputs, evaluated in the existing
28-dimensional restriction and the actual S₅ × SL₃(2) quotient. The faithful
combination detects equality in the native subgroup. Packed multiplication
identities are checked by the Lean kernel.

Source: ATLAS J4G1-max4W1 and J4G1-f2r112B0, with attribution in Model.Data
and SymmetricLinear.Model; Aschbacher–Smith 12.5.3–4, printed pp.818–819.
-/

public noncomputable section
namespace Janko4.LocalStructure.SymmetricLinear
open Subgroup CharacteristicTwo SylowTwoPart SylowTwoPart.KernelCardinality

lemma faithful_of_binary_surjective {G : Type*} [Group G] {n m : ℕ}
    (f : G →* Matrix (Fin n) (Fin n) (ZMod 2)) (w : Fin m → G)
    (r c : Fin m → Fin n)
    (hc : ∀ i, c i < r i)
    (hp : ∀ i j, i ≤ j → OrderedBinaryProducts.RowPrefix (r i) (f (w j)))
    (hv : ∀ i, f (w i) (r i) (c i) = 1)
    (hz : ∀ i j, i < j → f (w j) (r i) (c i) = 0)
    (hsurj : Function.Surjective (fun b : Fin m → Fin 2 =>
      (List.ofFn (fun i => w i ^ (b i).val)).prod)) : Function.Injective f := by
  let F := f.toHomUnits
  have hinj := OrderedBinaryProducts.binary_injective
    (Units.coeHom (Matrix (Fin n) (Fin n) (ZMod 2))) m (fun i => F (w i)) r c hc hp hv hz
  intro a b hab
  obtain ⟨u, rfl⟩ := hsurj a
  obtain ⟨v, rfl⟩ := hsurj b
  have he : F ((List.ofFn (fun i => w i ^ (u i).val)).prod) =
      F ((List.ofFn (fun i => w i ^ (v i).val)).prod) := Units.ext hab
  simp only [map_list_prod, List.map_ofFn, Function.comp_def, map_pow] at he
  exact congrArg (fun b : Fin m → Fin 2 =>
    (List.ofFn (fun i => w i ^ (b i).val)).prod) (hinj he)

lemma seed_representation_injective : Function.Injective seedRepresentation := by
  apply faithful_of_binary_surjective seedRepresentation pivotWord pivotRow pivotColumn
    column_lt_row _ _ _ binaryProduct_bijective.surjective
  · intro i j hij
    rw [image_pivotWord seedConjugate_coordinates]
    exact pivot_prefix i j hij
  · intro i
    rw [image_pivotWord seedConjugate_coordinates]
    exact pivot_value i
  · intro i j hij
    rw [image_pivotWord seedConjugate_coordinates]
    exact later_value i j hij

lemma eq_of_small_and_quotient (a b : max4Subgroup)
    (hr : representation a = representation b)
    (hq : max4Projection a = max4Projection b) : a = b := by
  have hk : a * b⁻¹ ∈ seedNormalClosure := by
    rw [seedNormalClosure_eq_twoCore, ← max4Projection_kernel_eq_twoCore]
    change max4Projection (a * b⁻¹) = 1
    simp only [map_mul, map_inv, hq, mul_inv_cancel]
  have he : seedRepresentation ⟨a * b⁻¹, hk⟩ = seedRepresentation 1 := by
    change representation (a * b⁻¹) = representation 1
    rw [map_mul, hr, ← map_mul, mul_inv_cancel]
  have h := congrArg Subtype.val (seed_representation_injective he)
  exact mul_inv_eq_one.mp h


