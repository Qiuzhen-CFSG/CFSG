@[expose] def identityRows : Vector ℕ 28 := #v[1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216, 33554432, 67108864, 134217728]
lemma decode_identity : decode identityRows = 1 := by
  have h : ∀ i : Fin 28, identityRows.get i = 2 ^ i.val := by decide +kernel
  ext i j
  simp [decode, h, GeneratorCertificates.bit, Nat.testBit_two_pow,
    Matrix.one_apply, Fin.ext_iff]
lemma inverse_image (g : max4Subgroup) (a b : Vector ℕ 28)
    (ha : representation g = decode a) (hab : decode a * decode b = 1) :
    representation g⁻¹ = decode b := by
  calc
    representation g⁻¹ = representation g⁻¹ * 1 := (mul_one _).symm
    _ = representation g⁻¹ * (representation g * decode b) := by rw [ha, hab]
    _ = decode b := by rw [← mul_assoc, ← map_mul, inv_mul_cancel, map_one, one_mul]
lemma quotient_pivotWord (i : Fin 15) :
    max4Projection (pivotWord i : max4Subgroup) = 1 := by
  change (pivotWord i : max4Subgroup) ∈ max4Projection.ker
  rw [max4Projection_kernel_eq_twoCore, ← seedNormalClosure_eq_twoCore]
  exact (pivotWord i).property
