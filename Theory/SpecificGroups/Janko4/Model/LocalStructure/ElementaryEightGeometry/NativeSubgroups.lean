module
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryEightGeometry.LiftRelations
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryEightGeometry.QuotientGeometry
public import Theory.ElementaryAbelian.Join
public import Theory.GroupTheory.NormalizedSupCard

/-!
# Native elementary subgroups of order 256

The four corrected lifts in each unprimed Figure 2 row are independent
commuting involutions. Their full fixed subgroup in the original local kernel
has order sixteen and meets the lift group trivially. Their join, embedded by
the original max1 inclusion, is therefore elementary of order 256. Its entire
quotient image includes the Figure 1 pair permutation. These concrete groups
are inputs to the remaining ambient centralizer and fusion calculations.
Source: Kleidman--Wilson (1988), Figures 1/2 and Propositions 2.3.4--2.3.5.
-/

set_option backward.isDefEq.respectTransparency true
@[expose] public noncomputable section
namespace Janko4.LocalStructure.ElementaryEightGeometry
open Subgroup Cardinality KernelCount QuotientCount.Image SylowCore SylowCore.Transport
attribute [local irreducible] modelGroup matrixA matrixB localKernel max1Subgroup localX localY basis
local notation "L" => SylowCore.Local
local notation "E" => localKernel matrixA_mul_self matrixB_pow_four
local notation "π" => starProjection matrixA_mul_self matrixB_pow_four

def liftClosure (r : Fin 2) : Subgroup L := closure (Set.range (correctedGenerator r))

theorem correctedGenerator_mem (r : Fin 2) (j : Fin 4) : correctedGenerator r j ∈ liftClosure r :=
  subset_closure (Set.mem_range_self j)

theorem liftClosure_projection (r : Fin 2) :
    (liftClosure r).map π = pairRowImage (r.castLE (by decide)) := by
  rw [liftClosure, MonoidHom.map_closure, ← Set.range_comp]
  congr 2
  funext j
  exact correctedGenerator_projection r j

private theorem product_projection (r : Fin 2) (v : Fin 4 → Bool) :
    π (binaryProduct (correctedGenerator r) v) =
      binaryProduct (pairRowGenerator (r.castLE (by decide))) v := by
  rw [map_binaryProduct]
  simp only [correctedGenerator_projection]

private theorem products_injective (r : Fin 2) :
    Function.Injective (binaryProduct (correctedGenerator r)) := by
  intro v w h
  apply pairRow_binaryProduct_injective r
  simpa only [product_projection] using congrArg π h

theorem liftClosure_card (r : Fin 2) : Nat.card (liftClosure r) = 16 :=
  card_closure_binaryProduct _ (correctedGenerator_square r)
    (correctedGenerator_commute r) (products_injective r)

instance liftClosure_elementary (r : Fin 2) : IsElementaryAbelian 2 (liftClosure r) := by
  let : IsMulCommutative (closure (Set.range (correctedGenerator r))) :=
    isMulCommutative_closure (by
      rintro _ ⟨i,rfl⟩ _ ⟨j,rfl⟩
      exact correctedGenerator_commute r i j)
  apply IsElementaryAbelian.closure_of_isMulCommutative
  rintro _ ⟨j,rfl⟩
  simpa only [pow_two] using correctedGenerator_square r j

theorem liftClosure_projection_injective (r : Fin 2) :
    Set.InjOn π (liftClosure r : Set L) := by
  intro x hx y hy hxy
  obtain ⟨v,rfl⟩ := (mem_closure_iff_binaryProduct _
    (correctedGenerator_square r) (correctedGenerator_commute r) x).mp hx
  obtain ⟨w,rfl⟩ := (mem_closure_iff_binaryProduct _
    (correctedGenerator_square r) (correctedGenerator_commute r) y).mp hy
  have hvw : v = w := pairRow_binaryProduct_injective r
    (by simpa only [product_projection] using hxy)
  rw [hvw]

/-- The full kernel fixed subgroup of the four displayed lifts. -/
def centralKernel (r : Fin 2) : Subgroup L :=
  ((centralizer (liftClosure r : Set L)).subgroupOf E).map (E).subtype

theorem centralKernel_le_kernel (r : Fin 2) : centralKernel r ≤ E := map_subtype_le _

theorem centralKernel_le_centralizer (r : Fin 2) :
    centralKernel r ≤ centralizer (liftClosure r : Set L) := by
  rintro x ⟨y,hy,rfl⟩
  exact hy

theorem centralKernel_card (r : Fin 2) : Nat.card (centralKernel r) = 16 := by
  rw [centralKernel, card_map_of_injective (E).subtype_injective]
  exact pairRow_kernel_centralizer_card _ _ (liftClosure_projection r)

instance centralKernel_elementary (r : Fin 2) : IsElementaryAbelian 2 (centralKernel r) := by
  let : IsElementaryAbelian 2 E := localKernel_elementary _ _
  refine { toIsMulCommutative := ⟨⟨?_⟩⟩, exponent_dvd_p := ?_ }
  · intro a b
    apply Subtype.ext
    exact setLike_mul_comm (centralKernel_le_kernel r a.property)
      (centralKernel_le_kernel r b.property)
  · apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
    intro a
    apply Subtype.ext
    exact elemPow_eq_one_of_isElementaryAbelian (p := 2) (a : L)
      (centralKernel_le_kernel r a.property)

/-- The literal native subgroup generated by the row and every centralizing kernel element. -/
def localEight (r : Fin 2) : Subgroup L := liftClosure r ⊔ centralKernel r

/-- Its embedding in the original J4 model. -/
def nativeEight (r : Fin 2) : Subgroup Model := (localEight r).map (L).subtype

instance localEight_elementary (r : Fin 2) : IsElementaryAbelian 2 (localEight r) :=
  IsElementaryAbelian.sup_of_le_centralizer (centralKernel_le_centralizer r)

instance nativeEight_elementary (r : Fin 2) : IsElementaryAbelian 2 (nativeEight r) :=
  IsElementaryAbelian.map_subtype

theorem liftClosure_disjoint_kernel (r : Fin 2) : Disjoint (liftClosure r) E := by
  apply disjoint_iff_inf_le.mpr
  intro x hx
  apply mem_bot.mpr
  apply liftClosure_projection_injective r hx.1 (liftClosure r).one_mem
  rw [map_one]
  apply MonoidHom.mem_ker.mp
  rw [starProjection_ker]
  exact hx.2

theorem localEight_card (r : Fin 2) : Nat.card (localEight r) = 256 := by
  rw [localEight, card_sup_eq_mul_of_normalizes_of_disjoint _ _
    ((centralKernel_le_centralizer r).trans (centralizer_le_normalizer _))
    ((liftClosure_disjoint_kernel r).mono_right (centralKernel_le_kernel r)),
    liftClosure_card, centralKernel_card]

theorem nativeEight_card (r : Fin 2) : Nat.card (nativeEight r) = 256 := by
  rw [nativeEight, card_map_of_injective (L).subtype_injective, localEight_card]

theorem localEight_projection (r : Fin 2) :
    (localEight r).map π = pairRowImage (r.castLE (by decide)) := by
  have hk : (centralKernel r).map π = ⊥ := by
    apply (Subgroup.map_eq_bot_iff _).mpr
    rw [starProjection_ker]
    exact centralKernel_le_kernel r
  rw [localEight, Subgroup.map_sup, hk, sup_bot_eq, liftClosure_projection]

theorem nativeEight_le_local (r : Fin 2) : nativeEight r ≤ L := map_subtype_le _

/-- The subgroup has the exact whole source-row image through the original quotient. -/
theorem nativeEight_projection (r : Fin 2) :
    ((nativeEight r).subgroupOf L).map π = pairRowImage (r.castLE (by decide)) := by
  have hs : (nativeEight r).subgroupOf L = localEight r := by
    change ((localEight r).map (L).subtype).comap (L).subtype = _
    exact comap_map_eq_self_of_injective (L).subtype_injective _
  rw [hs]
  exact localEight_projection r

end Janko4.LocalStructure.ElementaryEightGeometry
