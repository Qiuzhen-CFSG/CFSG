/-- The exact whole images: (b), (c), (d), (c′), and (d′), with the marked pair.
The proper (b) subgroups already lie in a conjugate of (a). -/
@[expose] def exactRow : Fin 5 → Subgroup StarGroup :=
  ![pairRowImage 0,NonsingularC.wholeImage,pairRowImage 1,
    NonsingularC.primedImage,pairRowImage 3]

private def targetImage : Fin 6 → Subgroup StarGroup :=
  ![boxImage,pairRowImage 0,NonsingularC.wholeImage,pairRowImage 1,
    NonsingularC.primedImage,pairRowImage 3]
private def targetGenerator (t : Fin 6) (j : Fin 5) : StarGroup :=
  ![FigureA.wholeGenerator,
    fun j => pairRowGenerator 0 ⟨j.val % 4,Nat.mod_lt _ (by decide)⟩,
    fun j => NonsingularC.wholeGenerator ⟨j.val % 4,Nat.mod_lt _ (by decide)⟩,
    fun j => pairRowGenerator 1 ⟨j.val % 4,Nat.mod_lt _ (by decide)⟩,
    fun j => NonsingularC.primedGenerator ⟨(if j.val < 3 then j.val else 0),by split_ifs <;> omega⟩,
    fun j => ![starElement 3,starElement 4,pairPermutation,starElement 3,starElement 3] j] t j

private theorem target_closure (t : Fin 6) :
    closure (Set.range (targetGenerator t)) = targetImage t := by
  fin_cases t
  · rfl
  all_goals
    apply le_antisymm
    · apply (closure_le _).mpr
      rintro _ ⟨j,rfl⟩
      fin_cases j
      all_goals first | exact subset_closure ⟨0,rfl⟩ | exact subset_closure ⟨1,rfl⟩ |
        exact subset_closure ⟨2,rfl⟩ | exact subset_closure ⟨3,rfl⟩
    · apply (closure_le _).mpr
      rintro _ ⟨j,rfl⟩
      fin_cases j
      all_goals first | exact subset_closure ⟨0,rfl⟩ | exact subset_closure ⟨1,rfl⟩ |
        exact subset_closure ⟨2,rfl⟩ | exact subset_closure ⟨3,rfl⟩ | exact one_mem _

private theorem targetGenerator_mem (t : Fin 6) (j : Fin 5) :
    targetGenerator t j ∈ targetImage t := by
  rw [← target_closure]
  exact subset_closure (Set.mem_range_self j)

