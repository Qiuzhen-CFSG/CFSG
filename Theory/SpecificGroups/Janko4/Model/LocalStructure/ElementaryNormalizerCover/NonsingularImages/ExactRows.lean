private def sourcePermutation (r : Fin 3) (s : Fin 16) (j : Fin 4) : Equiv.Perm (Fin 24) where
  toFun := sourcePoint r s j
  invFun := sourcePoint r s j
  left_inv := by revert r s j; decide +kernel
  right_inv := by revert r s j; decide +kernel
private theorem spaceGenerator_val : ∀ r s j,
    (spaceGenerator r s j).val = sourcePermutation r s j := by decide +kernel

private theorem forward_points : ∀ (r : Fin 3) (s : Fin 16) (j : Fin 4) (x : Fin 24),
    (MulAut.conj (conjugatorPermutation (conjugatorIndex r s)) (sourcePermutation r s j)) x =
      (binaryProduct (targetPermutation (targetIndex r s))
        (fun i => (forwardMask r s j).val.testBit i.val)) x := by decide +kernel
private theorem reverse_points : ∀ (r : Fin 3) (s : Fin 16), targetIndex r s ≠ 0 →
    ∀ (j : Fin 5) (x : Fin 24),
    (targetPermutation (targetIndex r s) j) x =
      (MulAut.conj (conjugatorPermutation (conjugatorIndex r s))
        (binaryProduct (sourcePermutation r s) (fun i => (reverseMask r s j).val.testBit i.val))) x := by
  decide +kernel

private theorem forward_generator (r : Fin 3) (s : Fin 16) (j : Fin 4) :
    MulAut.conj (nativeConjugator (conjugatorIndex r s)) (spaceGenerator r s j) =
      binaryProduct (targetGenerator (targetIndex r s))
        (fun i => (forwardMask r s j).val.testBit i.val) := by
  apply Subtype.ext
  change (nativeConjugator _).val * (spaceGenerator r s j).val * (nativeConjugator _).val⁻¹ =
    StarGroup.subtype (binaryProduct (targetGenerator (targetIndex r s))
      (fun i => (forwardMask r s j).val.testBit i.val))
  rw [map_binaryProduct]
  simp only [subtype_apply,targetGenerator_val,spaceGenerator_val]
  exact Equiv.ext (forward_points r s j)

private theorem reverse_generator (r : Fin 3) (s : Fin 16) (ht : targetIndex r s ≠ 0) (j : Fin 5) :
    targetGenerator (targetIndex r s) j =
      MulAut.conj (nativeConjugator (conjugatorIndex r s))
        (binaryProduct (spaceGenerator r s) (fun i => (reverseMask r s j).val.testBit i.val)) := by
  apply Subtype.ext
  change (targetGenerator _ j).val = (nativeConjugator _).val *
    StarGroup.subtype (binaryProduct (spaceGenerator r s)
      (fun i => (reverseMask r s j).val.testBit i.val)) * (nativeConjugator _).val⁻¹
  rw [map_binaryProduct]
  simp only [subtype_apply,targetGenerator_val,spaceGenerator_val]
  exact Equiv.ext (reverse_points r s ht j)

private theorem space_forward (r : Fin 3) (s : Fin 16) :
    (spaceGroup r s).map (MulAut.conj (nativeConjugator (conjugatorIndex r s))).toMonoidHom ≤
      targetImage (targetIndex r s) := by
  apply map_le_iff_le_comap.mpr
  apply (closure_le _).mpr
  rintro _ ⟨j,rfl⟩
  change MulAut.conj (nativeConjugator (conjugatorIndex r s)) (spaceGenerator r s j) ∈
    targetImage (targetIndex r s)
  rw [forward_generator]
  exact binaryProduct_mem _ _ _ (targetGenerator_mem _)

private theorem space_reverse (r : Fin 3) (s : Fin 16) (ht : targetIndex r s ≠ 0) :
    targetImage (targetIndex r s) ≤
      (spaceGroup r s).map (MulAut.conj (nativeConjugator (conjugatorIndex r s))).toMonoidHom := by
  rw [← target_closure]
  apply (closure_le _).mpr
  rintro _ ⟨j,rfl⟩
  exact ⟨_,binaryProduct_mem _ _ _ (fun i => subset_closure (Set.mem_range_self i)),
    (reverse_generator r s ht j).symm⟩

/-- All proper binary subspaces either extend into the literal (a) image or
are the entire applicable primed row. The original pair is retained by the
native conjugator. -/
theorem subgroup_box_or_exact (A : Subgroup StarGroup) (r : Fin 3)
    (hA : A ≤ fullImage r) (hp : pairPermutation ∈ A) :
    ∃ g : imageContainer,
      A ≤ boxImage.map (MulAut.conj (g : StarGroup)).toMonoidHom ∨
      ∃ k : Fin 5, A = (exactRow k).map (MulAut.conj (g : StarGroup)).toMonoidHom := by
  obtain ⟨s,rfl⟩ := subgroup_exact_space A r hA hp
  let u : imageContainer := ⟨nativeConjugator (conjugatorIndex r s),nativeConjugator_mem _⟩
  refine ⟨u⁻¹,?_⟩
  have forward := space_forward r s
  by_cases ht : targetIndex r s = 0
  · left
    intro x hx
    refine ⟨(MulAut.conj (u : StarGroup)) x,?_,by simp [mul_assoc]⟩
    have h := forward (mem_map_of_mem (MulAut.conj (u : StarGroup)).toMonoidHom hx)
    simpa only [ht,targetImage,Matrix.cons_val_zero,MulEquiv.coe_toMonoidHom,SetLike.mem_coe] using h
  · right
    have hh := le_antisymm forward (space_reverse r s ht)
    have hex : ∃ k : Fin 5, targetIndex r s = k.succ := by
      exact ⟨⟨(targetIndex r s).val-1,by have := (targetIndex r s).isLt; have := Fin.pos_iff_ne_zero.mpr ht; omega⟩,
        Fin.ext (by simp only [Fin.val_succ]; have := Fin.pos_iff_ne_zero.mpr ht; omega)⟩
    obtain ⟨k,hk⟩ := hex
    refine ⟨k,?_⟩
    have htarget : targetImage (targetIndex r s) = exactRow k := by
      rw [hk]
      fin_cases k <;> rfl
    rw [htarget] at hh
    rw [← hh,map_map]
    have he : (MulAut.conj (↑(u⁻¹) : StarGroup)).toMonoidHom.comp
        (MulAut.conj (nativeConjugator (conjugatorIndex r s))).toMonoidHom = MonoidHom.id _ := by
      ext x
      simp [u,mul_assoc]
    rw [he,map_id]

private theorem conjugation_map_comp (B : Subgroup StarGroup) (g h : StarGroup) :
    (B.map (MulAut.conj h).toMonoidHom).map (MulAut.conj g).toMonoidHom =
      B.map (MulAut.conj (g*h)).toMonoidHom := by
  rw [map_map]
  apply congrArg (fun f : StarGroup →* StarGroup => B.map f)
  ext x
  simp [mul_assoc]

/-- Outside the literal (a) container, exhaustive selection gives EQUALITY
with a whole unprimed or primed row. Every conjugator preserves the original
seed pair and centralizes its marked pair permutation. -/
theorem elementary_container_exact_rows (A : Subgroup StarGroup)
    [IsElementaryAbelian 2 A] (hA : A ≤ imageContainer) (hp : pairPermutation ∈ A) :
    ∃ g : imageContainer,
      A ≤ boxImage.map (MulAut.conj (g : StarGroup)).toMonoidHom ∨
      ∃ k : Fin 5, A = (exactRow k).map (MulAut.conj (g : StarGroup)).toMonoidHom := by
  obtain ⟨k,u,hu⟩ := elementary_container_source_rows A hA
  by_cases hk : k = 0
  · subst k
    exact ⟨u,Or.inl hu⟩
  obtain ⟨r,hr⟩ : ∃ r : Fin 3, k = r.succ := by
    exact ⟨⟨k.val-1,by have := k.isLt; have := Fin.pos_iff_ne_zero.mpr hk; omega⟩,
      Fin.ext (by simp only [Fin.val_succ]; have := Fin.pos_iff_ne_zero.mpr hk; omega)⟩
  subst k
  let B := A.map (MulAut.conj (u : StarGroup)⁻¹).toMonoidHom
  have hB : B ≤ fullImage r := by
    rw [fullImage_eq_sourceRow]
    rintro _ ⟨x,hx,rfl⟩
    obtain ⟨y,hy,he⟩ := hu hx
    rw [← he]
    simpa [mul_assoc] using hy
  have hback : B.map (MulAut.conj (u : StarGroup)).toMonoidHom = A := by
    rw [conjugation_map_comp,mul_inv_cancel]
    change A.map (MonoidHom.id _) = A
    exact map_id A
  have hpB : pairPermutation ∈ B := by
    have hc := mem_centralizer_singleton_iff.mp u.property.1
    have he : MulAut.conj (u : StarGroup)⁻¹ pairPermutation = pairPermutation := by
      change (u : StarGroup)⁻¹ * pairPermutation * ((u : StarGroup)⁻¹)⁻¹ = _
      rw [inv_inv,mul_assoc,← hc,inv_mul_cancel_left]
    exact he ▸ mem_map_of_mem (MulAut.conj (u : StarGroup)⁻¹).toMonoidHom hp
  obtain ⟨v,hv⟩ := subgroup_box_or_exact B r hB hpB
  refine ⟨u*v,?_⟩
  rcases hv with h | ⟨k,h⟩
  · left
    have h' := map_mono (f := (MulAut.conj (u : StarGroup)).toMonoidHom) h
    rwa [hback,conjugation_map_comp] at h'
  · right
    refine ⟨k,?_⟩
    have h' := congrArg (fun C : Subgroup StarGroup => C.map (MulAut.conj (u : StarGroup)).toMonoidHom) h
    rwa [hback,conjugation_map_comp] at h'

end Janko4.LocalStructure.ElementaryNormalizerCover.NonsingularImages.Refinement
