def evaluate (w : List (Fin 4)) : StarGroup := evalWord generator w
private def evaluatePoint (w : List (Fin 4)) : Equiv.Perm (Fin 24) :=
  evalWord (fun i => (generator i).val) w
private theorem evaluate_table : ∀ i, (fun x => evaluatePoint (words i) x) = point i := by
  decide +kernel
private theorem point_step : ∀ a i x, point (step a i) x = (generator a).val (point i x) := by
  decide +kernel
private def pointKey (i : Fin 128) : ℕ :=
  (List.finRange 24).foldl (fun n x => n * 24 + (point i x).val) 0
private theorem pointKey_lt_succ : ∀ i : Fin 127,
    pointKey i.castSucc < pointKey i.succ := by decide +kernel
private theorem point_injective : Function.Injective point := by
  intro i j h
  apply (Fin.strictMono_iff_lt_succ.mpr pointKey_lt_succ).injective
  unfold pointKey
  rw [h]

theorem evaluate_mem (w : List (Fin 4)) : evaluate w ∈ candidate := by
  induction w with
  | nil => exact candidate.one_mem
  | cons a w ih => exact candidate.mul_mem (generator_mem a) ih
private theorem evaluate_val (w : List (Fin 4)) : (evaluate w).val = evaluatePoint w := by
  induction w with
  | nil => rfl
  | cons a w ih => change (generator a).val * (evaluate w).val = _; rw [ih]; rfl

def element (i : Fin 128) : candidate := ⟨evaluate (words i), evaluate_mem _⟩
theorem element_apply (i : Fin 128) (x : Fin 24) : (element i).val.val x = point i x := by
  change (evaluate (words i)).val x = _
  rw [evaluate_val]
  exact congrFun (evaluate_table i) x

theorem element_injective : Function.Injective element := by
  intro i j h
  apply point_injective
  funext x
  rw [← element_apply, ← element_apply, h]
theorem element_zero : element 0 = 1 := by
  apply Subtype.ext
  rfl

theorem element_step (a : Fin 4) (i : Fin 128) :
    (element (step a i) : StarGroup) = generator a * element i := by
  apply Subtype.ext
  apply Equiv.ext
  intro x
  change (element (step a i)).val.val x = (generator a).val ((element i).val.val x)
  rw [element_apply,element_apply,point_step]

private theorem step_surjective (a : Fin 4) : Function.Surjective (step a) := by
  apply Finite.surjective_of_injective
  intro i j h
  apply element_injective
  apply Subtype.ext
  apply mul_left_cancel (a := generator a)
  rw [← element_step,← element_step,h]

theorem element_surjective : Function.Surjective element := by
  intro x
  have hex : ∃ i, (element i : StarGroup) = x := by
    apply closure_induction_left (s := Set.range generator)
      (p := fun y _ => ∃ i, (element i : StarGroup) = y) ?_ ?_ ?_ x.property
    · exact ⟨0,congrArg Subtype.val element_zero⟩
    · rintro g ⟨a,rfl⟩ y _ ⟨i,rfl⟩
      exact ⟨step a i,element_step a i⟩
    · rintro g ⟨a,rfl⟩ y _ ⟨i,rfl⟩
      obtain ⟨j,hj⟩ := step_surjective a i
      refine ⟨j,?_⟩
      rw [← hj,element_step,inv_mul_cancel_left]
  obtain ⟨i,hi⟩ := hex
  exact ⟨i,Subtype.ext hi⟩

theorem candidate_card : Nat.card candidate = 128 := by
  rw [← Nat.card_congr (Equiv.ofBijective element ⟨element_injective,element_surjective⟩),Nat.card_fin]

end Janko4.LocalStructure.ElementaryNormalizerCover.NonsingularImages
