private theorem native_word : ∀ i, evalWord alphabet (nativeWord i) = nativePermutation i := by
  decide +kernel

def nativeElement (i : Fin 12) : StarGroup := ⟨nativePermutation i, by
  rw [← native_word]
  apply StarOrderCertificate.word_mem alphabet StarGroup
  intro j
  fin_cases j
  · exact subset_closure (by simp [alphabet])
  · exact subset_closure (by simp [alphabet])
  · exact StarGroup.inv_mem (subset_closure (by simp))
  · exact StarGroup.inv_mem (subset_closure (by simp))⟩

def generator (i : Fin 4) : StarGroup := nativeElement (i.castLE (by decide))
def orbitRep (i : Fin 8) : StarGroup := nativeElement ⟨i.val + 4, by omega⟩
def movingPair : Fin 8 → Finset (Fin 24) := ![{0,1}, {2,3}, {6,23}, {9,22}, {10,18}, {11,12}, {13,21}, {19,20}]
def pairCentralizer : Subgroup StarGroup := centralizer ({pairPermutation} : Set StarGroup)
def imageContainer : Subgroup StarGroup :=
  pairCentralizer ⊓ InvolutionCentralizers.Second.starPairStabilizer

theorem orbitRep_mem (i : Fin 8) : orbitRep i ∈ pairCentralizer := by
  apply mem_centralizer_singleton_iff.mpr
  apply Subtype.ext
  revert i
  decide +kernel

theorem orbitRep_pair (i : Fin 8) :
    orbitRep i • InvolutionCentralizers.Second.starPair = movingPair i := by
  revert i
  decide +kernel

theorem movingPair_injective : Function.Injective movingPair := by decide +kernel

theorem movingPair_exhaustive (i : Fin 24) (hi : pairPermutation.val i ≠ i) :
    ∃ j, ({i, pairPermutation.val i} : Finset (Fin 24)) = movingPair j := by
  revert i
  decide +kernel

theorem generator_mem_container (i : Fin 4) : generator i ∈ imageContainer := by
  constructor
  · apply mem_centralizer_singleton_iff.mpr
    apply Subtype.ext
    revert i
    decide +kernel
  · change generator i • InvolutionCentralizers.Second.starPair = InvolutionCentralizers.Second.starPair
    revert i
    decide +kernel

def candidate : Subgroup StarGroup := closure (Set.range generator)
theorem generator_mem (i : Fin 4) : generator i ∈ candidate := subset_closure (Set.mem_range_self i)
theorem candidate_le_container : candidate ≤ imageContainer :=
  by
  apply (Subgroup.closure_le imageContainer).mpr
  rintro _ ⟨i,rfl⟩
  exact generator_mem_container i
