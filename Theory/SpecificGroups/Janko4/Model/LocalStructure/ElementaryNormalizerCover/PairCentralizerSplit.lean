module
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.FourGroupGeometry

/-!
# Direct factors in nonsingular four-group centralizers

For a commuting pair of involutions with nonzero intrinsic pairing, the two
actual residual characters give a surjection from the full ambient pair
centralizer onto a binary plane. Its kernel is the intersection of the embedded
solvable residuals of the two FULL involution centralizers. The original
four-group maps bijectively onto this plane, and centralizes the kernel.
Ambient multiplication therefore gives their direct-product equivalence.

The kernel identification includes relative normality, index four and transport
under ambient conjugation. Every subgroup between the four-group and its
centralizer splits along this same intersection. The elementary-subgroup
consumer applies this simultaneously to X and C(X), retaining both literal
factors. It supplies the central four-group factor in the nonsingular rows;
the complementary factors' further structure requires the native geometry.

Source: Kleidman--Wilson, *The Maximal Subgroups of J4* (1988), Corollary 1.1.4
and Table 1, p.487; Section 2.3, p.492. The native residuals and intrinsic
symmetry come from the independent, checked outer-half development.
-/

set_option backward.isDefEq.respectTransparency true
public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace Janko4.LocalStructure.ElementaryNormalizerCover
open LargeCenterRadicals.OuterHalf
attribute [local irreducible] modelGroup matrixA matrixB

/-- The actual subgroup generated by the marked commuting pair. -/
@[expose] def pairGroup (x y : Model) : Subgroup Model := closure ({x, y} : Set Model)
/-- Its full ambient centralizer. -/
@[expose] def pairCentralizer (x y : Model) : Subgroup Model := centralizer (pairGroup x y : Set Model)
/-- The intersection of the two embedded full-centralizer residuals. -/
@[expose] def pairInnerKernel (x y : Model) : Subgroup Model :=
  (solvableResidual (centralizer ({x} : Set Model))).map (centralizer ({x} : Set Model)).subtype ⊓
  (solvableResidual (centralizer ({y} : Set Model))).map (centralizer ({y} : Set Model)).subtype

private theorem mem_pairCentralizer (x y c : Model) :
    c ∈ pairCentralizer x y ↔ Commute x c ∧ Commute y c := by
  simp only [pairCentralizer, pairGroup, centralizer_closure, mem_centralizer_iff,
    Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · intro h
    exact ⟨h x (Or.inl rfl), h y (Or.inr rfl)⟩
  · rintro ⟨hx, hy⟩ z (rfl | rfl) <;> assumption

theorem pairGroup_le_centralizer (x y : Model) (hc : Commute x y) :
    pairGroup x y ≤ pairCentralizer x y := by
  apply (closure_le _).mpr
  intro z hz
  rcases hz with he | he
  · rw [he]; exact (mem_pairCentralizer x y x).mpr ⟨Commute.refl _, hc.symm⟩
  · rw [he]; exact (mem_pairCentralizer x y y).mpr ⟨hc, Commute.refl _⟩

abbrev PairOuterCoordinates := Multiplicative (ZMod 2) × Multiplicative (ZMod 2)

/-- The two intrinsic outer characters, in the order dual to the generators. -/
@[expose] def pairOuterCharacter (x y : Model) (hx : orderOf x = 2) (hy : orderOf y = 2) :
    pairCentralizer x y →* PairOuterCoordinates where
  toFun c := (Multiplicative.ofAdd (outerValue y c), Multiplicative.ofAdd (outerValue x c))
  map_one' := by simp
  map_mul' c d := by
    apply Prod.ext
    · exact congrArg Multiplicative.ofAdd (outerValue_mul_right y hy c d
        ((mem_pairCentralizer x y c).mp c.property).2
        ((mem_pairCentralizer x y d).mp d.property).2)
    · exact congrArg Multiplicative.ofAdd (outerValue_mul_right x hx c d
        ((mem_pairCentralizer x y c).mp c.property).1
        ((mem_pairCentralizer x y d).mp d.property).1)

private theorem pair_char_injective (x y : Model) (hx : orderOf x = 2) (hy : orderOf y = 2)
    (hc : Commute x y) (hn : ¬ InnerRelated x y) :
    Function.Injective ((pairOuterCharacter x y hx hy).comp
      (inclusion (pairGroup_le_centralizer x y hc))) := by
  have hx1 : x ≠ 1 := by intro he; simp [he] at hx
  have hy1 : y ≠ 1 := by intro he; simp [he] at hy
  have hnr : ¬ InnerRelated y x := fun h => hn ((innerRelated_symm x y hx hy hc).mpr h)
  have hyy : outerValue y y = 0 := (outerValue_eq_zero_iff _ _ hy1).mpr (innerRelated_self y hy)
  have hxy : outerValue x y = 1 := by simp [outerValue, hx1, hn]
  have hyx : outerValue y x = 1 := by simp [outerValue, hy1, hnr]
  apply (injective_iff_map_eq_one _).mpr
  intro u hu
  have hu' : outerValue y u = 0 ∧ outerValue x u = 0 := by
    exact ⟨congrArg (fun b : PairOuterCoordinates => b.1.toAdd) hu, congrArg (fun b : PairOuterCoordinates => b.2.toAdd) hu⟩
  have huforms := (mem_closure_pair_iff x y
    (by simpa only [pow_two, hx] using pow_orderOf_eq_one x)
    (by simpa only [pow_two, hy] using pow_orderOf_eq_one y) hc u).mp u.property
  rcases huforms with he | he | he | he
  · exact Subtype.ext he
  · have hh := hu'.1; rw [he, hyx] at hh; exact (one_ne_zero hh).elim
  · have hh := hu'.2; rw [he, hxy] at hh; exact (one_ne_zero hh).elim
  · have hh := hu'.1
    rw [he, outerValue_mul_right y hy x y hc.symm (Commute.refl _), hyx, hyy, add_zero] at hh
    exact (one_ne_zero hh).elim

private theorem pair_char_bijective (x y : Model) (hx : orderOf x = 2) (hy : orderOf y = 2)
    (hc : Commute x y) (hn : ¬ InnerRelated x y) :
    Function.Bijective ((pairOuterCharacter x y hx hy).comp
      (inclusion (pairGroup_le_centralizer x y hc))) := by
  have hne : x ≠ y := by intro he; subst y; exact hn (innerRelated_self x hx)
  have hcard := (isKleinFour_closure_pair_of_orderOf x y hx hy hne hc).card_four
  apply (Nat.bijective_iff_injective_and_card _).mpr
  exact ⟨pair_char_injective x y hx hy hc hn, by
    change Nat.card (closure ({x,y} : Set Model)) = Nat.card PairOuterCoordinates
    rw [hcard]; simp [PairOuterCoordinates]⟩


/-- The second direct factor is the literal intersection of embedded residuals. -/
theorem pairInnerKernel_le_centralizer (x y : Model) :
    pairInnerKernel x y ≤ pairCentralizer x y := by
  intro c hc
  apply (mem_pairCentralizer x y c).mpr
  exact ⟨(mem_centralizer_singleton_iff.mp (map_subtype_le _ hc.1)).symm,
    (mem_centralizer_singleton_iff.mp (map_subtype_le _ hc.2)).symm⟩

/-- The two residual characters have exactly the stated intrinsic kernel. -/
theorem pairOuterCharacter_eq_one_iff (x y : Model) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (c : pairCentralizer x y) :
    pairOuterCharacter x y hx hy c = 1 ↔ (c : Model) ∈ pairInnerKernel x y := by
  have hx1 : x ≠ 1 := by intro he; simp [he] at hx
  have hy1 : y ≠ 1 := by intro he; simp [he] at hy
  change (Multiplicative.ofAdd (outerValue y c), Multiplicative.ofAdd (outerValue x c)) = (1,1) ↔
    InnerRelated x c ∧ InnerRelated y c
  rw [Prod.mk.injEq]
  change (outerValue y c = 0 ∧ outerValue x c = 0) ↔ _
  rw [outerValue_eq_zero_iff _ _ hx1, outerValue_eq_zero_iff _ _ hy1, and_comm]


/-- The relative kernel equality uses the literal subgroup-of-centralizer map. -/
theorem pairOuterCharacter_kernel (x y : Model) (hx : orderOf x = 2) (hy : orderOf y = 2) :
    (pairOuterCharacter x y hx hy).ker =
      (pairInnerKernel x y).subgroupOf (pairCentralizer x y) := by
  ext c
  exact pairOuterCharacter_eq_one_iff x y hx hy c

/-- Relative normality is in the full pair centralizer. -/
theorem pairInnerKernel_normal (x y : Model) (hx : orderOf x = 2) (hy : orderOf y = 2) :
    ((pairInnerKernel x y).subgroupOf (pairCentralizer x y)).Normal := by
  rw [← pairOuterCharacter_kernel x y hx hy]
  infer_instance

/-- Both independent outer coordinates occur in the actual four-group. -/
theorem pairOuterCharacter_surjective (x y : Model) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (hc : Commute x y) (hn : ¬ InnerRelated x y) :
    Function.Surjective (pairOuterCharacter x y hx hy) := by
  intro v
  obtain ⟨u,hu⟩ := (pair_char_bijective x y hx hy hc hn).2 v
  exact ⟨inclusion (pairGroup_le_centralizer x y hc) u,hu⟩

/-- The complementary subgroup has index four in the FULL ambient pair centralizer. -/
theorem pairInnerKernel_index (x y : Model) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (hc : Commute x y) (hn : ¬ InnerRelated x y) :
    ((pairInnerKernel x y).subgroupOf (pairCentralizer x y)).index = 4 := by
  rw [← pairOuterCharacter_kernel x y hx hy, index_ker,
    MonoidHom.range_eq_top.mpr (pairOuterCharacter_surjective x y hx hy hc hn), card_top]
  simp [PairOuterCoordinates]

/-- Ambient conjugation carries the actual residual factor with the pair. -/
theorem pairInnerKernel_map (x y : Model) (e : Model ≃* Model) :
    (pairInnerKernel x y).map e.toMonoidHom = pairInnerKernel (e x) (e y) := by
  ext c
  rw [mem_map_equiv]
  change (InnerRelated x (e.symm c) ∧ InnerRelated y (e.symm c)) ↔
    (InnerRelated (e x) c ∧ InnerRelated (e y) c)
  simpa only [e.apply_symm_apply] using
    (innerRelated_equiv e x (e.symm c)).symm.and
      (innerRelated_equiv e y (e.symm c)).symm

/-- The actual multiplication map from the four-group and the residual intersection. -/
@[expose] def pairCentralizerProduct (x y : Model) (hc : Commute x y) :
    pairGroup x y × pairInnerKernel x y →* pairCentralizer x y where
  toFun v := ⟨(v.1 : Model) * v.2,
    mul_mem (pairGroup_le_centralizer x y hc v.1.property)
      (pairInnerKernel_le_centralizer x y v.2.property)⟩
  map_one' := Subtype.ext (one_mul 1)
  map_mul' v w := by
    apply Subtype.ext
    have hcomm : (w.1 : Model) * v.2 = v.2 * w.1 :=
      pairInnerKernel_le_centralizer x y v.2.property w.1 w.1.property
    change ((v.1 : Model) * w.1) * ((v.2 : Model) * w.2) =
      ((v.1 : Model) * v.2) * ((w.1 : Model) * w.2)
    calc
      _ = (v.1 : Model) * ((w.1 : Model) * v.2) * w.2 := by group
      _ = (v.1 : Model) * ((v.2 : Model) * w.1) * w.2 := by rw [hcomm]
      _ = _ := by group

private theorem pair_product_bijective (x y : Model) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (hc : Commute x y) (hn : ¬ InnerRelated x y) :
    Function.Bijective (pairCentralizerProduct x y hc) := by
  let inc := inclusion (pairGroup_le_centralizer x y hc)
  let incK := inclusion (pairInnerKernel_le_centralizer x y)
  let chi := pairOuterCharacter x y hx hy
  have hK (k : pairInnerKernel x y) : chi (incK k) = 1 :=
    (pairOuterCharacter_eq_one_iff x y hx hy _).mpr k.property
  have hsplit (v : pairGroup x y × pairInnerKernel x y) :
      pairCentralizerProduct x y hc v = inc v.1 * incK v.2 := rfl
  constructor
  · intro v w he
    have hh := congrArg chi he
    rw [hsplit, hsplit, map_mul, map_mul, hK, hK, mul_one, mul_one] at hh
    have hfst := (pair_char_bijective x y hx hy hc hn).1 hh
    apply Prod.ext hfst
    apply Subtype.ext
    have hv := congrArg Subtype.val he
    change (v.1 : Model) * v.2 = (w.1 : Model) * w.2 at hv
    rw [hfst] at hv
    exact mul_left_cancel hv
  · intro c
    obtain ⟨u, hu⟩ := (pair_char_bijective x y hx hy hc hn).2 (chi c)
    change chi (inc u) = chi c at hu
    have hk : chi ((inc u)⁻¹ * c) = 1 := by rw [map_mul, map_inv, hu, inv_mul_cancel]
    let k : pairInnerKernel x y := ⟨(u : Model)⁻¹ * c,
      (pairOuterCharacter_eq_one_iff x y hx hy _).mp hk⟩
    exact ⟨(u,k), Subtype.ext (mul_inv_cancel_left (u : Model) (c : Model))⟩

/-- A nonsingular native four-group is a direct factor of its FULL ambient
centralizer. The complementary factor is the literal two-residual intersection. -/
noncomputable def pairCentralizerProductEquiv (x y : Model) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (hc : Commute x y) (hn : ¬ InnerRelated x y) :
    pairGroup x y × pairInnerKernel x y ≃* pairCentralizer x y :=
  MulEquiv.ofBijective (pairCentralizerProduct x y hc) (pair_product_bijective x y hx hy hc hn)

section
attribute [local irreducible] pairGroup pairCentralizer pairInnerKernel pairCentralizerProductEquiv

/-- This equivalence uses the original ambient multiplication map. -/
@[simp] theorem pairCentralizerProductEquiv_apply (x y : Model) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (hc : Commute x y) (hn : ¬ InnerRelated x y)
    (u : pairGroup x y) (k : pairInnerKernel x y) :
    (pairCentralizerProductEquiv x y hx hy hc hn (u,k) : Model) = (u : Model) * k := by
  unfold pairCentralizerProductEquiv
  rfl

/-- The order formula retains the actual native complementary subgroup. -/
theorem pairCentralizer_card (x y : Model) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (hc : Commute x y) (hn : ¬ InnerRelated x y) :
    Nat.card (pairCentralizer x y) = 4 * Nat.card (pairInnerKernel x y) := by
  rw [← Nat.card_congr (pairCentralizerProductEquiv x y hx hy hc hn).toEquiv, Nat.card_prod]
  have hne : x ≠ y := by intro he; subst y; exact hn (innerRelated_self x hx)
  rw [show Nat.card (pairGroup x y) = 4 from
    by simpa only [pairGroup] using
      (isKleinFour_closure_pair_of_orderOf x y hx hy hne hc).card_four]


end

/-- The native four-group meets its residual factor trivially. -/
theorem pairInnerKernel_disjoint (x y : Model) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (hc : Commute x y) (hn : ¬ InnerRelated x y) :
    Disjoint (pairGroup x y) (pairInnerKernel x y) := by
  apply Subgroup.disjoint_def.mpr
  intro c hcU hcK
  have hh := (pairOuterCharacter_eq_one_iff x y hx hy
    ⟨c,pairGroup_le_centralizer x y hc hcU⟩).mpr hcK
  have hi := (pair_char_bijective x y hx hy hc hn).1
    (a₁ := ⟨c,hcU⟩) (a₂ := 1)
  have he : (⟨c,hcU⟩ : pairGroup x y) = 1 := hi (hh.trans (map_one _).symm)
  exact congrArg Subtype.val he

/-- Every subgroup between the nonsingular pair and its centralizer splits
along the SAME embedded residual intersection. -/
theorem pair_overgroup_split (x y : Model) (hx : orderOf x = 2)
    (hy : orderOf y = 2) (hc : Commute x y) (hn : ¬ InnerRelated x y)
    (S : Subgroup Model) (hUS : pairGroup x y ≤ S) (hSC : S ≤ pairCentralizer x y) :
    S = pairGroup x y ⊔ (S ⊓ pairInnerKernel x y) := by
  apply le_antisymm ?_ (sup_le hUS inf_le_left)
  intro s hs
  obtain ⟨v,hv⟩ := (pair_product_bijective x y hx hy hc hn).2 ⟨s,hSC hs⟩
  have he : (v.1 : Model) * v.2 = s := congrArg Subtype.val hv
  have hkS : (v.2 : Model) ∈ S := by
    have hm := S.mul_mem (S.inv_mem (hUS v.1.property)) hs
    rwa [← he, inv_mul_cancel_left] at hm
  rw [← he]
  exact mul_mem
    ((le_sup_left : pairGroup x y ≤ pairGroup x y ⊔ (S ⊓ pairInnerKernel x y)) v.1.property)
    ((le_sup_right : S ⊓ pairInnerKernel x y ≤ pairGroup x y ⊔ (S ⊓ pairInnerKernel x y))
      ⟨hkS,v.2.property⟩)

/-- The Section 2.3 elementary-subgroup consumer: BOTH X and its full
centralizer split along the chosen nonsingular pair, with literal factors. -/
theorem elementary_pair_centralizer_decomposition
    (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (x y : Model) (hx : orderOf x = 2) (hy : orderOf y = 2)
    (hxX : x ∈ X) (hyX : y ∈ X) (hn : ¬ InnerRelated x y) :
    X = pairGroup x y ⊔ (X ⊓ pairInnerKernel x y) ∧
      centralizer (X : Set Model) = pairGroup x y ⊔
        (centralizer (X : Set Model) ⊓ pairInnerKernel x y) ∧
      Disjoint (pairGroup x y) (pairInnerKernel x y) := by
  have hUX : pairGroup x y ≤ X := (closure_le _).mpr (by
    rintro z (rfl | rfl) <;> assumption)
  have hc : Commute x y := congrArg Subtype.val
    (mul_comm (⟨x,hxX⟩ : X) ⟨y,hyX⟩)
  have hXC : centralizer (X : Set Model) ≤ pairCentralizer x y := centralizer_le hUX
  exact ⟨pair_overgroup_split x y hx hy hc hn X hUX (X.le_centralizer.trans hXC),
    pair_overgroup_split x y hx hy hc hn _ (hUX.trans X.le_centralizer) hXC,
    pairInnerKernel_disjoint x y hx hy hc hn⟩

end Janko4.LocalStructure.ElementaryNormalizerCover
