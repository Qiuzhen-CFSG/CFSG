module
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.ExtraspecialOrbit
public import Theory.SpecificGroups.Janko4.Model.InvolutionCentralizers.First.Core
public import Theory.SpecificGroups.Janko4.Model.InvolutionCentralizers.Second
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FirstGenerator.OddIndex.CentralizerSylow
public import Theory.GroupTheory.MaximalTwoLocalElementary
public import Theory.GroupTheory.PCoreLocalSetup
public import Theory.GroupTheory.CharacteristicCentralizerSylow
public import Theory.GroupTheory.SylowKernelCore

/-!
# The mixed extraspecial-core branch of the J4 normalizer argument

The literal first-centralizer two-core is extraspecial, its embedded center
is generated by a, and its full normalizer is the first centralizer. Conjugacy
carries this embedded core to the actual two-core of the conjugate centralizer.
The certified full centralizer orders distinguish the native 2A and 2B classes.

If an elementary X lies in such a core, contains its central involution and
contains a 2B-element, the orbit argument in `ExtraspecialOrbit` constructs
a proper nontrivial pure-2A subgroup Y normalized by the whole N(X). When
N(X) is maximal among two-locals, N(Y) equals N(X). No full ambient Sylow
containment or subgroup-coatom hypothesis is used.

Source: Kleidman--Wilson, *The Maximal Subgroups of J4* (1988),
Proposition 2.2.3, p.491, the mixed extraspecial residual configuration.
This replaces its transvection-group reducibility step after the geometric
placement and central-involution enlargement. Those two earlier geometric
steps, the pure-2A normalizer analysis, and the other Section 2 configurations
are not asserted here. The native core and centralizer certificates retain
the source attribution of the imported modules.
-/

public noncomputable section
open Subgroup
namespace Janko4.LocalStructure.ElementaryNormalizerCover
attribute [local irreducible] Janko4.modelGroup Janko4.matrixA Janko4.matrixB

/-- The actual ambient image of O₂(C_Model(a)). -/
abbrev firstCore : Subgroup Model := InvolutionCentralizers.First.centralizer.pCoreIn 2

/-- Extraspeciality transported through the literal centralizer inclusion. -/
theorem firstCore_extraspecial : IsExtraspecial 2 firstCore := by
  exact IsExtraspecial.of_mulEquiv
    ((pCore 2 InvolutionCentralizers.First.centralizer).equivMapOfInjective
      InvolutionCentralizers.First.centralizer.subtype Subtype.val_injective)
    InvolutionCentralizers.First.centralizer_twoCore_extraspecial

/-- The marked central involution belongs to the full embedded two-core. -/
theorem a_mem_firstCore : a ∈ firstCore := by
  have he : IsElementaryAbelian 2 (zpowers a) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one a_pow_two
  have hc : zpowers a ≤ InvolutionCentralizers.First.centralizer :=
    zpowers_le.mpr (mem_centralizer_singleton_iff.mpr (Commute.refl a))
  have hn : InvolutionCentralizers.First.centralizer ≤ normalizer (zpowers a : Set Model) := by
    intro g hg
    rw [mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
    congr 1
    change g * a * g⁻¹ = a
    rw [mem_centralizer_singleton_iff.mp hg, mul_inv_cancel_right]
  exact le_pCoreIn_of_normalizes (IsElementaryAbelian.isPGroup 2 (zpowers a)) hc hn (mem_zpowers a)

/-- The marked involution is central in that same embedded core. -/
theorem a_central_in_firstCore : (⟨a, a_mem_firstCore⟩ : firstCore) ∈ center firstCore := by
  apply mem_center_iff.mpr
  intro x
  apply Subtype.ext
  exact mem_centralizer_singleton_iff.mp
    (pCoreIn_le 2 InvolutionCentralizers.First.centralizer x.property)

/-- The embedded core center is precisely the marked involution subgroup. -/
theorem firstCore_center : (center firstCore).map firstCore.subtype = zpowers a := by
  let := firstCore_extraspecial
  symm
  apply eq_of_le_of_card_ge (zpowers_le.mpr
    (mem_map_of_mem firstCore.subtype a_central_in_firstCore))
  rw [card_map_of_injective firstCore.subtype_injective,
    IsExtraspecial.center_order_p 2 firstCore, Nat.card_zpowers]
  change 2 ≤ orderOf a
  rw [orderOf_a]

/-- The whole ambient core normalizer is the literal first centralizer. -/
theorem normalizer_firstCore : normalizer (firstCore : Set Model) =
    InvolutionCentralizers.First.centralizer := by
  apply le_antisymm
  · calc
      normalizer (firstCore : Set Model) ≤
          normalizer ((center firstCore).map firstCore.subtype : Set Model) :=
        Subgroup.normalizer_le_normalizer_characteristic_image firstCore (center firstCore)
      _ = InvolutionCentralizers.First.centralizer := by
        rw [firstCore_center, normalizer_zpowers_eq_centralizer_of_order_two a orderOf_a]
  · exact InvolutionCentralizers.First.centralizer.le_normalizer.trans
      (Subgroup.normalizer_le_normalizer_characteristic_image
        InvolutionCentralizers.First.centralizer (pCore 2 InvolutionCentralizers.First.centralizer))

/-- The first centralizer is a two-local, witnessed by its actual extraspecial core. -/
theorem firstCentralizer_isTwoLocal : IsTwoLocal InvolutionCentralizers.First.centralizer := by
  let := firstCore_extraspecial
  refine ⟨firstCore, ?_, IsExtraspecial.isPGroup 2 firstCore, normalizer_firstCore.symm⟩
  intro h
  have ha1 : a = 1 := mem_bot.mp (h ▸ a_mem_firstCore)
  have ho := orderOf_a
  rw [ha1, orderOf_one] at ho
  contradiction

/-- Conjugation preserves the actual ambient core, including its inclusion map. -/
theorem firstCore_conjugate (g : Model) :
    firstCore.map (MulAut.conj g).toMonoidHom =
      (centralizer ({MulAut.conj g a} : Set Model)).pCoreIn 2 := by
  change (InvolutionCentralizers.First.centralizer.pCoreIn 2).map _ = _
  rw [map_pCoreIn_of_injective 2 _ _ (MulAut.conj g).injective]
  have hc : InvolutionCentralizers.First.centralizer.map (MulAut.conj g).toMonoidHom =
      centralizer ({MulAut.conj g a} : Set Model) := by
    ext x
    rw [mem_map_equiv, mem_centralizer_singleton_iff, mem_centralizer_singleton_iff]
    constructor
    · intro hx
      simpa only [map_mul, MulEquiv.apply_symm_apply] using congrArg (MulAut.conj g) hx
    · intro hx
      apply (MulAut.conj g).injective
      simpa only [map_mul, MulEquiv.apply_symm_apply] using hx
  rw [hc]

/-- The two specified native involutions have different full centralizer orders. -/
theorem first_not_isConj_second : ¬ IsConj a (InvolutionCentralizers.Second.seed : Model) := by
  intro h
  have hc := Subgroup.card_centralizer_eq_of_isConj _ _ h
  have hs : Nat.card (centralizer ({(InvolutionCentralizers.Second.seed : Model)} : Set Model)) =
      1816657920 := InvolutionCentralizers.Second.ambient_card
  rw [OuterReduction.OddIndex.modelCentralizer_card, hs] at hc
  norm_num at hc

/-- The mixed core configuration has a smaller invariant pure-2A subgroup. -/
theorem mixed_conjugate_core_reduction (g : Model) (X : Subgroup Model)
    [IsElementaryAbelian 2 X]
    (hX : X ≤ firstCore.map (MulAut.conj g).toMonoidHom)
    (hz : MulAut.conj g a ∈ X)
    (hB : ∃ b ∈ X, IsConj (InvolutionCentralizers.Second.seed : Model) b) :
    ∃ Y : Subgroup Model, Y ≠ ⊥ ∧ Y < X ∧ IsElementaryAbelian 2 Y ∧
      normalizer (X : Set Model) ≤ normalizer (Y : Set Model) ∧
      ∀ y ∈ Y, y ≠ 1 → IsConj a y := by
  let Q := firstCore.map (MulAut.conj g).toMonoidHom
  let e : firstCore ≃* Q := firstCore.equivMapOfInjective
    (MulAut.conj g).toMonoidHom (MulAut.conj g).injective
  let : IsExtraspecial 2 Q := IsExtraspecial.of_mulEquiv e firstCore_extraspecial
  let z : Q := e ⟨a, a_mem_firstCore⟩
  have hzc : z ∈ center Q := (Subgroup.centerCongr e ⟨⟨a, a_mem_firstCore⟩,
    a_central_in_firstCore⟩).property
  have hz1 : z ≠ 1 := by
    intro hh
    have ha1 : a = 1 := congrArg (fun x : firstCore => (x : Model))
      (e.injective (hh.trans (map_one e).symm))
    have ho := orderOf_a
    rw [ha1, orderOf_one] at ho
    contradiction
  have ha : IsConj a (z : Model) := isConj_iff.mpr ⟨g, rfl⟩
  obtain ⟨b, hb, hbclass⟩ := hB
  have hb1 : (⟨b, hb⟩ : X) ≠ 1 := by
    intro hh
    have hb0 : b = 1 := congrArg (fun x : X => (x : Model)) hh
    obtain ⟨c, hc⟩ := isConj_iff.mp hbclass
    have ho := (MulAut.conj c).orderOf_eq (InvolutionCentralizers.Second.seed : Model)
    change orderOf (c * (InvolutionCentralizers.Second.seed : Model) * c⁻¹) = _ at ho
    rw [hc, InvolutionCentralizers.Second.seed_order, hb0, orderOf_one] at ho
    contradiction
  obtain ⟨Y, hY, hYX, hYE, hN, hclass⟩ := extraspecial_pure_reduction Q X hX z hzc hz1 hz
    ⟨b, hb⟩ hb1 (fun hh => first_not_isConj_second (ha.trans (hh.trans hbclass.symm)))
  exact ⟨Y, hY, hYX, hYE, hN, fun y hy hy1 => ha.trans (hclass y hy hy1)⟩

/-- At maximal two-local level the smaller pure group has the same full normalizer. -/
theorem maximal_normalizer_mixed_conjugate_core_reduction
    (g : Model) (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hX : X ≤ firstCore.map (MulAut.conj g).toMonoidHom)
    (hz : MulAut.conj g a ∈ X)
    (hB : ∃ b ∈ X, IsConj (InvolutionCentralizers.Second.seed : Model) b)
    (hM : IsMaximalTwoLocal (normalizer (X : Set Model))) :
    ∃ Y : Subgroup Model, Y ≠ ⊥ ∧ Y < X ∧ IsElementaryAbelian 2 Y ∧
      normalizer (X : Set Model) = normalizer (Y : Set Model) ∧
      ∀ y ∈ Y, y ≠ 1 → IsConj a y := by
  obtain ⟨Y, hY, hYX, hYE, hN, hclass⟩ := mixed_conjugate_core_reduction g X hX hz hB
  let := hYE
  exact ⟨Y, hY, hYX, hYE,
    hM.eq_of_le ⟨Y, hY, IsElementaryAbelian.isPGroup 2 Y, rfl⟩ hN, hclass⟩

/-- The source application in the intrinsic O₂(C(t)), for any actual 2A-involution t. -/
theorem maximal_normalizer_mixed_involution_core_reduction
    (t : Model) (ht : IsConj a t) (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hX : X ≤ (centralizer ({t} : Set Model)).pCoreIn 2) (htX : t ∈ X)
    (hB : ∃ b ∈ X, IsConj (InvolutionCentralizers.Second.seed : Model) b)
    (hM : IsMaximalTwoLocal (normalizer (X : Set Model))) :
    ∃ Y : Subgroup Model, Y ≠ ⊥ ∧ Y < X ∧ IsElementaryAbelian 2 Y ∧
      normalizer (X : Set Model) = normalizer (Y : Set Model) ∧
      ∀ y ∈ Y, y ≠ 1 → IsConj a y := by
  obtain ⟨g, hg⟩ := isConj_iff.mp ht
  have hg' : MulAut.conj g a = t := hg
  apply maximal_normalizer_mixed_conjugate_core_reduction g X
  · rwa [firstCore_conjugate, hg']
  · rwa [hg']
  · exact hB
  · exact hM

end Janko4.LocalStructure.ElementaryNormalizerCover
