module
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.BoxImages
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.MixedFourNormalizers
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.PureTwoA.Ordinary
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.MathieuForm

/-!
# The cyclic quotient case of the native box

If the literal box image is generated by the marked pair permutation, the
orthogonal factor of the seed and an outer partner lies in the Mathieu kernel.
That kernel has zero intrinsic form. Nondegeneracy therefore kills the entire
orthogonal factor, and the original elementary subgroup has order four.

When this four-group has a first-class involution, the existing mixed-pair
classification places its whole normalizer in the literal max1 or source-max2
row. The pure-second four-group case is retained; the quotient marking alone
does not identify the signed native lift used in the separate BBB obstruction.
Source: Kleidman--Wilson (1988), Section 2.3 and Figure 2(a), p.492.
-/

set_option backward.isDefEq.respectTransparency true
public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace Janko4.LocalStructure.ElementaryNormalizerCover.BoxPair
open Cardinality.QuotientCount.Image
open ElementaryEightGeometry hiding Local
open InvolutionCentralizers.Second LargeCenterRadicals.OuterHalf
attribute [local irreducible] modelGroup matrixA matrixB Cardinality.max1Subgroup Cardinality.localKernel

private theorem pair_square : pairPermutation * pairPermutation = 1 := by
  apply Subtype.ext
  decide +kernel
private theorem pair_order : orderOf pairPermutation = 2 := by
  apply orderOf_eq_prime
  · simpa only [pow_two] using pair_square
  · intro h
    have he := congrArg (fun p : StarGroup => p.val 0) h
    change (1 : Fin 24) = 0 at he
    contradiction

theorem residual_zero_eq : BoxImages.residualImage 0 = zpowers pairPermutation := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨j,rfl⟩
    fin_cases j
    · exact mem_zpowers _
    · change BoxImages.rawElement 0 ∈ _
      rw [BoxImages.raw_zero]
      exact one_mem _
    · change BoxImages.rawElement 0 ∈ _
      rw [BoxImages.raw_zero]
      exact one_mem _
  · exact zpowers_le.mpr (subset_closure ⟨0,rfl⟩)

private theorem mem_residual_zero (p : StarGroup) (hp : p ∈ BoxImages.residualImage 0) :
    p = 1 ∨ p = pairPermutation := by
  rw [residual_zero_eq,mem_zpowers_iff_mem_range_orderOf,pair_order] at hp
  obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp hp
  have hi' : i < 2 := Finset.mem_range.mp hi
  interval_cases i <;> simp

private theorem nonsingular_pair_eq_of_zero_factor
    (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hns : (intrinsicElementaryForm X).Nondegenerate)
    (x y : Model) (hx : orderOf x = 2) (hy : orderOf y = 2)
    (hxX : x ∈ X) (hyX : y ∈ X) (hn : ¬ InnerRelated x y)
    (hzero : ∀ k ∈ X ⊓ pairInnerKernel x y, ∀ l ∈ X ⊓ pairInnerKernel x y,
      outerValue k l = 0) : X = pairGroup x y := by
  have hs := (elementary_pair_centralizer_decomposition X x y hx hy hxX hyX hn).1
  have hb : X ⊓ pairInnerKernel x y = ⊥ := by
    apply eq_bot_iff.mpr
    intro k hk
    by_cases hk1 : k = 1
    · exact mem_bot.mpr hk1
    have hk2 : orderOf k = 2 := orderOf_eq_prime
      (elemPow_eq_one_of_isElementaryAbelian (p := 2) _ hk.1) hk1
    let R := (solvableResidual (centralizer ({k} : Set Model))).map
      (centralizer ({k} : Set Model)).subtype
    have hRX : X ≤ R := by
      rw [hs]
      apply sup_le
      · apply (closure_le _).mpr
        rintro u (hu | hu)
        · rw [hu]
          change InnerRelated k x
          exact (innerRelated_symm x k hx hk2 (setLike_mul_comm hxX hk.1)).mp hk.2.1
        · rw [hu]
          change InnerRelated k y
          exact (innerRelated_symm y k hy hk2 (setLike_mul_comm hyX hk.1)).mp hk.2.2
      · intro l hl
        exact (outerValue_eq_zero_iff _ _ hk1).mp (hzero k hk l hl)
    have hrad : k ∈ formRadical X := ⟨hk.1,fun l hl =>
      (outerValue_eq_zero_iff _ _ hk1).mpr (hRX hl)⟩
    rwa [(formRadical_eq_bot_iff X).mpr hns] at hrad
  rw [hb,sup_bot_eq] at hs
  exact hs

private theorem inner_factor_le_kernel (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hs : (seed : Model) ∈ X)
    (himage : (X.subgroupOf Local).map starHom = BoxImages.residualImage 0)
    (z : Model) : X ⊓ pairInnerKernel (seed : Model) z ≤ embeddedKernel := by
  have hXL : X ≤ Local := X.le_centralizer.trans
    ((centralizer_le (Set.singleton_subset_iff.mpr hs)).trans ambient_le_max1)
  intro k hk
  let k0 : Local := ⟨k,hXL hk.1⟩
  have hkC : k0 ∈ localCentralizer := by
    apply mem_centralizer_singleton_iff.mpr
    apply Subtype.ext
    exact congrArg (fun u : X => (u : Model)) (mul_comm (⟨k,hk.1⟩ : X) ⟨seed,hs⟩)
  have hfix : (starHom k0).val 0 = 0 :=
    ((innerRelated_second_iff_star ⟨k0,hkC⟩).mp hk.2.1).1
  have hm : starHom k0 ∈ BoxImages.residualImage 0 :=
    himage ▸ mem_map_of_mem starHom (show k0 ∈ X.subgroupOf Local from hk.1)
  have he : starHom k0 = 1 := by
    rcases mem_residual_zero _ hm with h | h
    · exact h
    · rw [h] at hfix
      change (1 : Fin 24) = 0 at hfix
      contradiction
  have hkE : k0 ∈ Cardinality.localKernel matrixA_mul_self matrixB_pow_four := by
    rw [← MathieuHallActors.projection_ker,MonoidHom.mem_ker,
      M22Images.KernelAction.projection_star,he,map_one]
  exact mem_map_of_mem max1.subtype hkE

theorem source_pair_eq (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hs : (seed : Model) ∈ X)
    (hns : (intrinsicElementaryForm X).Nondegenerate)
    (himage : (X.subgroupOf Local).map starHom = BoxImages.residualImage 0) :
    ∃ z : Local, (z : Model) ∈ X ∧ starHom z = pairPermutation ∧
      X = pairGroup (seed : Model) (z : Model) ∧ Nat.card X = 4 := by
  have hp : pairPermutation ∈ (X.subgroupOf Local).map starHom := by
    rw [himage,residual_zero_eq]
    exact mem_zpowers _
  obtain ⟨z,hz,hp⟩ := hp
  have hz1 : (z : Model) ≠ 1 := by
    intro he
    have he' : z = 1 := Subtype.ext he
    have hh := hp
    rw [he',map_one] at hh
    have ho := pair_order
    rw [← hh,orderOf_one] at ho
    contradiction
  have hz2 : orderOf (z : Model) = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian (p := 2) _ hz) hz1
  have hn : ¬ InnerRelated (seed : Model) (z : Model) := by
    have hh := LinearFive.Geometry.not_inner_of_star_swap z 0 1 (by decide)
      (by rw [hp]; rfl) (by rw [hp]; rfl)
    have he : LinearFive.kernelValue (pairLabel 0 1) = seed :=
      Simplicity.Max1Fusion.KernelOrbits.maskValue_one _ _
    rwa [he] at hh
  have he : X = pairGroup (seed : Model) (z : Model) := by
    apply nonsingular_pair_eq_of_zero_factor X hns _ _ seed_order hz2 hs hz hn
    intro k hk l hl
    have hkE := inner_factor_le_kernel X hs himage (z : Model) hk
    have hlE := inner_factor_le_kernel X hs himage (z : Model) hl
    exact congrArg (fun B : LinearMap.BilinForm (ZMod 2) (Additive embeddedKernel) =>
      B (Additive.ofMul ⟨k,hkE⟩) (Additive.ofMul ⟨l,hlE⟩)) embeddedKernel_intrinsicForm_zero
  refine ⟨z,hz,hp,he,?_⟩
  rw [he]
  exact (isKleinFour_closure_pair_of_orderOf _ _ seed_order hz2
    (fun h => hn (h ▸ innerRelated_self (seed : Model) seed_order))
    (setLike_mul_comm hs hz)).card_four

private theorem four_mixed_normalizer (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hns : (intrinsicElementaryForm X).Nondegenerate) (hcard : Nat.card X = 4)
    (hmax : IsMaximalTwoLocal (normalizer (X : Set Model)))
    (x : Model) (hx : x ∈ X) (hxa : IsConj a x) :
    (∃ g : Model, normalizer (X : Set Model) =
      InvolutionCentralizers.First.centralizer.map (MulAut.conj g).toMonoidHom) ∨
    (∃ g : Model, normalizer (X : Set Model) = max1.map (MulAut.conj g).toMonoidHom) := by
  have hx1 : x ≠ 1 := by
    intro he
    have ha := isConj_one_left.mp (he ▸ hxa)
    have ho := orderOf_a
    rw [ha,orderOf_one] at ho
    contradiction
  have hx2 : orderOf x = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian (p := 2) _ hx) hx1
  let x0 : Additive X := Additive.ofMul ⟨x,hx⟩
  have hx0 : x0 ≠ 0 := fun he => hx1
    (congrArg (fun w : Additive X => (w.toMul : Model)) he)
  have hex : ∃ y : Additive X, intrinsicElementaryForm X x0 y ≠ 0 := by
    by_contra! hn
    exact hx0 (hns.1 x0 hn)
  obtain ⟨y0,hy0⟩ := hex
  let y : Model := y0.toMul
  have hyX : y ∈ X := y0.toMul.property
  have hy1 : y ≠ 1 := by
    intro he
    apply hy0
    change outerValue x y = 0
    rw [he,outerValue_one_right]
  have hy2 : orderOf y = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian (p := 2) _ hyX) hy1
  have hc : Commute x y := setLike_mul_comm hx hyX
  have hn : ¬ InnerRelated x y := fun h =>
    hy0 ((outerValue_eq_zero_iff x y hx1).mpr h)
  have hne : x ≠ y := fun h => hn (h ▸ innerRelated_self x hx2)
  have hgen : closure ({x,y} : Set Model) = X := eq_of_le_of_card_ge
    ((closure_le _).mpr (by rintro z (rfl | rfl) <;> assumption))
    (by rw [hcard,(isKleinFour_closure_pair_of_orderOf x y hx2 hy2 hne hc).card_four])
  exact maximal_noninner_first_pair_normalizer _ hmax x y hxa hy2 hc hn
    (congrArg (fun A : Subgroup Model => normalizer (A : Set Model)) hgen.symm)

/-- Row zero is a four-group. If it has a first-class element, its whole
normalizer is one of the two native involution locals. -/
theorem source_pair_mixed_maximal (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hs : (seed : Model) ∈ X)
    (hns : (intrinsicElementaryForm X).Nondegenerate)
    (himage : (X.subgroupOf Local).map starHom = BoxImages.residualImage 0)
    (hmax : IsMaximalTwoLocal (normalizer (X : Set Model)))
    (hfirst : ∃ x ∈ X, IsConj a x) :
    (∃ g : Model, normalizer (X : Set Model) =
      InvolutionCentralizers.First.centralizer.map (MulAut.conj g).toMonoidHom) ∨
    (∃ g : Model, normalizer (X : Set Model) = max1.map (MulAut.conj g).toMonoidHom) := by
  obtain ⟨_,_,_,_,hcard⟩ := source_pair_eq X hs hns himage
  obtain ⟨x,hx,hxa⟩ := hfirst
  exact four_mixed_normalizer X hns hcard hmax x hx hxa

/-- The mixed pair endpoint is expressed using the two literal final cover rows. -/
theorem source_pair_mixed_native (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hs : (seed : Model) ∈ X)
    (hns : (intrinsicElementaryForm X).Nondegenerate)
    (himage : (X.subgroupOf Local).map starHom = BoxImages.residualImage 0)
    (hmax : IsMaximalTwoLocal (normalizer (X : Set Model)))
    (hfirst : ∃ x ∈ X, IsConj a x) :
    ∃ g : Model, normalizer (X : Set Model) = max1.map (MulAut.conj g).toMonoidHom ∨
      normalizer (X : Set Model) =
        OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.sourceSubgroup.map
          (MulAut.conj g).toMonoidHom := by
  rcases source_pair_mixed_maximal X hs hns himage hmax hfirst with ⟨g,hg⟩ | ⟨g,hg⟩
  · open OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData in
    refine ⟨g*h⁻¹,Or.inr ?_⟩
    rw [PureTwoA.firstCentralizer_eq_source_conjugate,map_map] at hg
    have he : (MulAut.conj g).toMonoidHom.comp (MulAut.conj h⁻¹).toMonoidHom =
        (MulAut.conj (g*h⁻¹)).toMonoidHom := by ext x; simp [mul_assoc]
    rwa [he] at hg
  · exact ⟨g,Or.inl hg⟩

end Janko4.LocalStructure.ElementaryNormalizerCover.BoxPair
