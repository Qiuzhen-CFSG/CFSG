def lowImage (v : Fin 192) (a : Fin 32) : ℕ :=
  (lowData (block v) (offset v) >>> (11 * a.val)) % 2048

def highImage (v : Fin 192) (b : Fin 64) : ℕ :=
  (highData (block v) (offset v) >>> (11 * b.val)) % 2048

def lowPart (m : Fin 2048) : Fin 32 := ⟨m.val % 32, Nat.mod_lt _ (by decide)⟩
def highPart (m : Fin 2048) : Fin 64 := ⟨m.val / 32, by omega⟩

def fastImage (v : Fin 192) (m : Fin 2048) : ℕ :=
  lowImage v (lowPart m) ^^^ highImage v (highPart m)

def lowCheck (v : Fin 192) : Bool := (List.finRange 32).all (fun a =>
  lowImage v a == maskImage (row v) a.val)

def highCheck (v : Fin 192) : Bool := (List.finRange 64).all (fun b =>
  highImage v b == maskImage (row v) (b.val * 32))

def fastFixedCheck (v : Fin 192) : Bool := (List.finRange 2048).all (fun m =>
  (fastImage v m != m.val) || fixedBit v m)

private theorem split_checked : (List.finRange 2048).all
    (fun m => decide (m.val = (lowPart m).val ^^^ ((highPart m).val * 32))) = true := by
  decide +kernel

theorem split_mask (m : Fin 2048) :
    m.val = (lowPart m).val ^^^ ((highPart m).val * 32) :=
  of_decide_eq_true (List.all_eq_true.mp split_checked m (List.mem_finRange _))

theorem fastImage_spec (v : Fin 192) (hl : lowCheck v = true) (hh : highCheck v = true)
    (m : Fin 2048) : fastImage v m = maskImage (row v) m.val := by
  have h1 := beq_iff_eq.mp (List.all_eq_true.mp hl (lowPart m) (List.mem_finRange _))
  have h2 := beq_iff_eq.mp (List.all_eq_true.mp hh (highPart m) (List.mem_finRange _))
  rw [fastImage, h1, h2, ← maskImage_xor, ← split_mask]

end Janko4.LocalStructure.ElementaryNormalizerCover.ElementaryBound
