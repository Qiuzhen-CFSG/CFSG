module
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.PureTwoA.NativeExtensions.CommonCenter
import Mathlib.Tactic.Group

/-!
# One literal model for every common order-four completion

Two short words in the native max1 generators conjugate x to first-class
lifts of the two common-image generators. Kernel transitivity proves that
every first-class lift in an actual occurring fiber belongs to the common
completion. The fixed kernel and literal quotient then show that every
full common-image completion equals the same subgroup generated by these
two native lifts and the 32-element common space.

This exhausts the actual lift and kernel choices for this completion.
The final consumer places the intrinsic double centralizer in that fixed
128-group while preserving the WHOLE original normalizer. No preservation
of the completion by that normalizer is claimed; intrinsic rank geometry
is still needed to distinguish its central involution.
Source: Kleidman--Wilson (1988), Section 2.1, p.489; native words use the
existing certified ATLAS max1 generators and Mathieu projection.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace Janko4.LocalStructure.ElementaryNormalizerCover.PureTwoA.NativeExtensions
open Cardinality KernelCount QuotientCount.Image
open Simplicity.Max1Fusion Simplicity.Max1Fusion.KernelOrbits
open ElementaryEightGeometry NativePair NativePair.Stabilizer LinearFive InvolutionCentralizers.Second
open M22Images.KernelAction InvolutionCentralizers.Second.FiveAction DisplacementActions
attribute [local irreducible] modelGroup matrixA matrixB Cardinality.max1Subgroup
  Cardinality.localKernel basis localX localY
set_option backward.isDefEq.respectTransparency true

@[expose] def commonAlphabet : Fin 4 → M :=
  ![localX matrixA_mul_self matrixB_pow_four,localY matrixA_mul_self matrixB_pow_four,
    (localX matrixA_mul_self matrixB_pow_four)⁻¹,(localY matrixA_mul_self matrixB_pow_four)⁻¹]

@[expose] def commonLiftWord : Fin 2 → List (Fin 4) :=
  ![[0,1,0,3,0,1,0,3,0,3,0,3,0,3,0,3,0,1,0,3,0,1,0,1,0,3,0,1],
    [0,1,0,3,0,1,0,3,0,3,0,3,0,1,0,1,0,3,0,1,0,1,0,3,0,1]]

/-- Two actual first-class lifts, given as conjugates of the original x. -/
@[expose] def commonLift (i : Fin 2) : M :=
  (MulAut.conj (evalWord commonAlphabet (commonLiftWord i)))
    (localX matrixA_mul_self matrixB_pow_four)

private theorem alphabet_projection (i : Fin 4) :
    (starHom (commonAlphabet i)).val = alphabet i := by
  fin_cases i
  · exact actionImageEquivStarGroup_x _ _
  · exact actionImageEquivStarGroup_y _ _
  · change (starHom (localX matrixA_mul_self matrixB_pow_four)⁻¹).val = starX⁻¹
    rw [map_inv]
    exact congrArg Inv.inv (actionImageEquivStarGroup_x _ _)
  · change (starHom (localY matrixA_mul_self matrixB_pow_four)⁻¹).val = starY⁻¹
    rw [map_inv]
    exact congrArg Inv.inv (actionImageEquivStarGroup_y _ _)

private theorem word_projection (w : List (Fin 4)) :
    (starHom (evalWord commonAlphabet w)).val = evalWord alphabet w := by
  induction w with
  | nil => simp only [evalWord,map_one,Subgroup.coe_one]
  | cons i w ih => simp only [evalWord,map_mul,Subgroup.coe_mul,alphabet_projection,ih]

theorem commonLift_projection (i : Fin 2) : starHom (commonLift i) =
    element (pureIndex 1 i.castSucc) := by
  apply Subtype.ext
  have hx : (starHom (localX matrixA_mul_self matrixB_pow_four)).val = starX :=
    actionImageEquivStarGroup_x _ _
  simp only [commonLift,MulAut.conj_apply,map_mul,map_inv,Subgroup.coe_mul,
    Subgroup.coe_inv,word_projection,hx]
  revert i
  decide +kernel

theorem commonLift_first (i : Fin 2) : IsConj a (commonLift i : Model) := by
  have hx := (outside_first_iff 0).mpr (Or.inl rfl)
  have he : outsideRepresentative matrixA_mul_self matrixB_pow_four 0 =
      localX matrixA_mul_self matrixB_pow_four := by
    simp [outsideRepresentative,outsideMask,binaryProduct_zero]
  rw [he] at hx
  exact hx.trans (isConj_iff.mpr ⟨((evalWord commonAlphabet (commonLiftWord i) : M) : Model),rfl⟩)

/-- Every first-class lift of an image already occurring in the actual
subgroup lies in its common completion. -/
theorem common_first_fiber_mem (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hpair : nativePair ≤ X) (hpure : ∀ v ∈ X, v ≠ 1 → IsConj a v)
    (i : Fin 3) (z : M) (hz : (z : Model) ∈ X)
    (hzq : starHom z = element (pureIndex 1 i))
    (t : M) (ht : IsConj a (t : Model)) (htq : starHom t = starHom z) :
    (t : Model) ∈ commonCompletion X := by
  have hp1 : ∀ i : Fin 3, element (pureIndex 1 i) ≠ 1 := by
    intro i he
    have hh := congrArg (fun p : StarGroup => p.val 0) he
    have hn : ∀ i : Fin 3, (element (pureIndex 1 i)).val 0 ≠ 0 := by decide +kernel
    exact hn i hh
  have hzk : z ∉ max1Kernel := by
    intro h
    exact hp1 i (hzq.symm.trans (MonoidHom.mem_ker.mp (starHom_ker.symm ▸ h)))
  obtain ⟨u,hu,he⟩ := pure_extension_lift_fiber_transitive X hpair hpure z hz hzk t ht htq
  obtain ⟨n,hn⟩ := maskValue_surjective matrixA_mul_self matrixB_pow_four ⟨u,hu⟩
  have hnu : kernelValue n.val = u := congrArg Subtype.val hn
  have hz2 : z * z = 1 := by
    apply Subtype.ext
    simpa only [pow_two,Subgroup.coe_mul,Subgroup.coe_one] using
      elemPow_eq_one_of_isElementaryAbelian (p := 2) (z : Model) hz
  have hzi : z⁻¹ = z := inv_eq_of_mul_eq_one_left hz2
  have hui : u⁻¹ = u := hnu ▸ inv_eq_of_mul_eq_one_left (kernelValue_square _)
  obtain ⟨j,hj⟩ := displacement_coordinates 1 i n
  rw [common_displacement] at hj
  have hd : z⁻¹ * u * z * u⁻¹ = kernelValue (displacementMask 0 0 j) := by
    have hc := kernel_conjugation z n.val
    change z * kernelValue n.val * z⁻¹ = kernelValue (SylowCore.starMask (starHom z) n.val) at hc
    rw [hnu,hzq,hzi] at hc
    rw [hzi,hui,hc,← hnu,← kernelValue_xor]
    exact congrArg kernelValue (by simpa only [Nat.xor_eq] using hj)
  have ht' : t = z * kernelValue (displacementMask 0 0 j) := by
    rw [← hd,← he]
    change u * z * u⁻¹ = _
    group
  rw [ht']
  exact (commonCompletion X).mul_mem (mem_sup_left hz)
    (mem_sup_right ((mem_commonSpace _).mpr ⟨j,rfl⟩))

/-- A fixed subgroup in the original ambient model, independent of X and
of all its lift and kernel choices. -/
@[expose] def commonModel : Subgroup Model :=
  commonSpace ⊔ closure (Set.range (fun i : Fin 2 => (commonLift i : Model)))

/-- Exhaustive actual-lift identification in the common order-four case:
every completion is literally this same native subgroup. -/
theorem commonCompletion_eq_commonModel (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hpair : nativePair ≤ X) (hpure : ∀ v ∈ X, v ≠ 1 → IsConj a v)
    (himage : (X.subgroupOf M).map starHom = pureBlock 1) :
    commonCompletion X = commonModel := by
  have hXM := (elementary_overgroup_placement X hpair).1
  have hHM : commonCompletion X ≤ M :=
    sup_le hXM (commonSpace_le_kernel.trans (map_subtype_le _))
  have hKH : commonModel ≤ commonCompletion X := by
    refine sup_le le_sup_right ((closure_le _).mpr ?_)
    rintro _ ⟨i,rfl⟩
    obtain ⟨z,hz,hzq⟩ := himage.symm ▸ pureIndex_mem 1 i.castSucc
    exact common_first_fiber_mem X hpair hpure i.castSucc z hz hzq
      (commonLift i) (commonLift_first i) ((commonLift_projection i).trans hzq.symm)
  have hKq : pureBlock 1 ≤ (commonModel.subgroupOf M).map starHom := by
    apply (closure_le _).mpr
    rintro _ ⟨i,rfl⟩
    exact ⟨commonLift i,mem_sup_right (subset_closure ⟨i,rfl⟩),commonLift_projection i⟩
  apply le_antisymm ?_ hKH
  intro v hv
  let z : M := ⟨v,hHM hv⟩
  have hzq : starHom z ∈ pureBlock 1 := by
    rw [← himage,← commonCompletion_image X hXM]
    exact mem_map_of_mem starHom hv
  obtain ⟨u,hu,huq⟩ := hKq hzq
  have hk : z * u⁻¹ ∈ max1Kernel := by
    rw [← starHom_ker]
    apply MonoidHom.mem_ker.mpr
    rw [map_mul,map_inv,huq,mul_inv_cancel]
  have hd : ((z * u⁻¹ : M) : Model) ∈ commonSpace := by
    rw [← commonCompletion_kernel X hpair himage]
    exact ⟨(commonCompletion X).mul_mem hv ((commonCompletion X).inv_mem (hKH hu)),
      mem_map_of_mem M.subtype hk⟩
  have hmem := commonModel.mul_mem (mem_sup_left hd) hu
  change ((z : Model) * (u : Model)⁻¹) * (u : Model) ∈ commonModel at hmem
  simpa only [inv_mul_cancel_right] using hmem

/-- The actual intrinsic replacement is contained in one fixed native
128-group and has exactly the original whole normalizer. -/
theorem common_four_native_replacement (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hpair : nativePair ≤ X) (hpure : ∀ v ∈ X, v ≠ 1 → IsConj a v)
    (hpos : (X.subgroupOf M).map starHom ≤ imageBlock 1)
    (hfour : Nat.card ((X.subgroupOf M).map starHom) = 4)
    (hmax : IsMaximalTwoLocal (normalizer (X : Set Model))) :
    let Z := centralizer (centralizer (X : Set Model) : Set Model)
    X ≤ Z ∧ IsElementaryAbelian 2 Z ∧ (∀ z ∈ Z, z ≠ 1 → IsConj a z) ∧
      Z ≤ commonModel ∧ Nat.card commonModel = 128 ∧
      (kernelValue 1257 : Model) ∈ Z ∧
      normalizer (Z : Set Model) = normalizer (X : Set Model) := by
  have h := common_four_intrinsic_replacement X hpair hpure hpos hfour hmax
  rwa [commonCompletion_eq_commonModel X hpair hpure
    (pure_position_image_eq X hpair hpure 1 hpos hfour)] at h

end Janko4.LocalStructure.ElementaryNormalizerCover.PureTwoA.NativeExtensions
