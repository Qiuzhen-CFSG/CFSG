private theorem rank_upper {r : ℕ} (rows : Vector ℕ 112) (b : Fin r → ℕ)
    (c : Fin 112 → ℕ) (hc : ∀ i, combine b (c i) = rows.get i) :
    (decodeRows rows).rank ≤ r := by
  have he : decodeRows rows = (decode c : Matrix (Fin 112) (Fin r) (ZMod 2)) * decode b := by
    rw [← decode_combine]
    exact congrArg decode (funext fun i => (hc i).symm)
  rw [he]
  exact (Matrix.rank_mul_le_right _ _).trans (by
    simpa using Matrix.rank_le_card_height (decode b : Matrix (Fin r) (Fin 112) (ZMod 2)))

