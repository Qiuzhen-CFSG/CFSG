/-- The actual kernel pair in the ninth lift cannot have native-pair rank twenty. -/
theorem ninth_kernel_pairRank_le (i j : Fin 7) :
    pairRank (kernelValue (ninthPureMask i)) (kernelValue (ninthPureMask j)) ≤ 16 := by
  fin_cases i <;> fin_cases j
  · change pairRank (kernelValue 457) (kernelValue 457) ≤ 16
    rw [kernel_pairRank_self]
    decide
  · change pairRank (kernelValue 457) (kernelValue 641) ≤ 16
    exact pair_bound_1
  · change pairRank (kernelValue 457) (kernelValue 840) ≤ 16
    calc
      pairRank (kernelValue 457) (kernelValue 840) = pairRank (kernelValue 457) (kernelValue 641) := (kernel_pairRank_xor 457 840).symm
      _ ≤ 16 := pair_bound_1
  · change pairRank (kernelValue 457) (kernelValue 1098) ≤ 16
    exact pair_bound_2
