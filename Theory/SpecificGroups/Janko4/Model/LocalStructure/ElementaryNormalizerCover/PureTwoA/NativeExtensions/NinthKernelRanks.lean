private theorem kernel_matrix_square (m : ℕ) :
    toMatrix (kernelValue m : Model) * toMatrix (kernelValue m : Model) = 1 := by
  rw [← map_mul]
  simpa only [Subgroup.coe_mul,Subgroup.coe_one,map_one] using
    congrArg (fun u : M => toMatrix (u : Model)) (kernelValue_square m)

private theorem matrix_sub_eq_add (A B : Matrix (Fin 112) (Fin 112) (ZMod 2)) : A - B = A + B := by
  ext i j
  exact ZModModule.sub_eq_add _ _

private theorem displacement_product_xor (A B : Matrix (Fin 112) (Fin 112) (ZMod 2))
    (hA : A * A = 1) : (A - 1) * (A * B - 1) = (A - 1) * (B - 1) := by
  simp only [matrix_sub_eq_add, add_mul, mul_add, one_mul, mul_one]
  rw [← mul_assoc, hA, one_mul]
  abel

private theorem displacement_product_comm (A B : Matrix (Fin 112) (Fin 112) (ZMod 2))
    (hAB : A * B = B * A) : (A - 1) * (B - 1) = (B - 1) * (A - 1) := by
  simp only [matrix_sub_eq_add, add_mul, mul_add, one_mul, mul_one]
  rw [hAB]
  abel

private theorem kernel_pairRank_xor (m n : ℕ) :
    pairRank (kernelValue m) (kernelValue (m ^^^ n)) =
      pairRank (kernelValue m) (kernelValue n) := by
  unfold pairRank
  have he : toMatrix (kernelValue (m ^^^ n) : Model) =
      toMatrix (kernelValue m : Model) * toMatrix (kernelValue n : Model) := by
    rw [← map_mul]
    exact congrArg (fun u : M => toMatrix (u : Model)) (kernelValue_xor m n)
  rw [he]
  exact congrArg Matrix.rank (displacement_product_xor _ _ (kernel_matrix_square m))

private theorem kernel_pairRank_comm (m n : ℕ) :
    pairRank (kernelValue m) (kernelValue n) =
      pairRank (kernelValue n) (kernelValue m) := by
  unfold pairRank
  have he : toMatrix (kernelValue m : Model) * toMatrix (kernelValue n : Model) =
      toMatrix (kernelValue n : Model) * toMatrix (kernelValue m : Model) := by
    rw [← map_mul,← map_mul]
    exact congrArg (fun u : M => toMatrix (u : Model))
      ((kernelValue_xor m n).symm.trans ((congrArg kernelValue (Nat.xor_comm m n)).trans (kernelValue_xor n m)))
  exact congrArg Matrix.rank (displacement_product_comm _ _ he)

private theorem kernel_pairRank_self (m : ℕ) : pairRank (kernelValue m) (kernelValue m) = 0 := by
  have h := kernel_pairRank_xor m 0
  simpa only [Nat.xor_zero,kernelValue_zero,pairRank,Subgroup.coe_one,map_one,sub_self,mul_zero,Matrix.rank_zero] using h

