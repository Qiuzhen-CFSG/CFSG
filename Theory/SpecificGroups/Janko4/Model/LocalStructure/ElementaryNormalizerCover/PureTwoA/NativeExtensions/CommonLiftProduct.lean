/-- The product of the two fixed common lifts is first-class, via a literal
kernel conjugator and the third first-class image lift. -/
theorem commonLift_product_first : IsConj a ((commonLift 0 * commonLift 1 : M) : Model) := by
  have hc := kernel_conjugation thirdLift 172
  change thirdLift * kernelValue 172 * thirdLift⁻¹ =
    kernelValue (SylowCore.starMask (starHom thirdLift) 172) at hc
  rw [third_projection,show SylowCore.starMask (element 79) 172 = 502 from by decide +kernel] at hc
  have ht2 : thirdLift * thirdLift = 1 := by
    change (MulAut.conj _) _ * (MulAut.conj _) _ = _
    rw [← map_mul,localX_mul_self,map_one]
  have hti : thirdLift⁻¹ = thirdLift := inv_eq_of_mul_eq_one_left ht2
  have he : (MulAut.conj (kernelValue 172)) thirdLift = thirdLift * kernelValue 346 := by
    have hd : kernelValue 346 = thirdLift⁻¹ * kernelValue 172 * thirdLift * (kernelValue 172)⁻¹ := by
      rw [hti,inv_eq_of_mul_eq_one_left (kernelValue_square 172)]
      rw [hti] at hc
      rw [hc,← kernelValue_xor]
      rfl
    rw [hd]
    simp only [MulAut.conj_apply]
    group
  rw [common_pair_product,← he]
  exact third_first.trans (isConj_iff.mpr ⟨(kernelValue 172 : Model),rfl⟩)

/-- The fixed common lifts commute in the original max1 group. -/
theorem commonLift_commute : Commute (commonLift 0) (commonLift 1) := by
  have sq (i : Fin 2) : commonLift i * commonLift i = 1 := by
    change (MulAut.conj _) _ * (MulAut.conj _) _ = _
    rw [← map_mul,localX_mul_self,map_one]
  have hp : (commonLift 0 * commonLift 1)^2 = 1 := by
    apply Subtype.ext
    have h := commonLift_product_first.pow 2
    rw [show a^2 = 1 from orderOf_a ▸ pow_orderOf_eq_one a,isConj_one_right] at h
    exact h
  have hi := inv_eq_of_mul_eq_one_left (show (commonLift 0 * commonLift 1) *
    (commonLift 0 * commonLift 1) = 1 from by simpa only [pow_two] using hp)
  rw [mul_inv_rev,inv_eq_of_mul_eq_one_left (sq 0),inv_eq_of_mul_eq_one_left (sq 1)] at hi
  exact hi.symm

