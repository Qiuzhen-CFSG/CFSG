private def thirdLift : M := (MulAut.conj (evalWord commonAlphabet cw8))
  (localX matrixA_mul_self matrixB_pow_four)
private theorem common_pair_product : commonLift 0 * commonLift 1 = thirdLift * kernelValue 346 := by
  apply representation_injective matrixA_mul_self matrixB_pow_four
  have h0 : ρ (commonLift 0) = decodeRows lift0Rows := eval_lift0
  have h1 : ρ (commonLift 1) = decodeRows lift1Rows := eval_lift1
  rw [map_mul,map_mul,h0,h1,show ρ thirdLift = decodeRows lift2Rows from eval_lift2,eval_m346]
