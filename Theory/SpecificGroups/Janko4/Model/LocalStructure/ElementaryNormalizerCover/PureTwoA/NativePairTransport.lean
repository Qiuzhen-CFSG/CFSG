module
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.PureTwoA.NativePairRanks
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.M22Images.KernelAction
public import Theory.SpecificGroups.Janko4.Model.LocalStructure.ElementaryNormalizerCover.FourGroupGeometry

/-!
# Transporting pure census row 7 to the native binary kernel

The three nonzero elements generated by masks 818 and 1449 belong to
the first involution class. The pure-pair census therefore puts the
marked pair in row 2 or row 7. The displacement-product rank, 20 versus
16, excludes row 2. One ambient conjugator consequently identifies row 7,
its full centralizer and its full normalizer with the native pair.

This supplies a literal kernel placement for the row-7 branch of the
pure-first normalizer argument. It uses no identification with the printed
MOG labels or the printed centralizer order. Source: Kleidman--Wilson
(1988), Table 1 and Section 2.1, pp.487--489; the native census words and
matrix certificates fix all conventions.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace Janko4.LocalStructure.ElementaryNormalizerCover.PureTwoA.NativePair
open Cardinality QuotientCount.Image KernelCount LocalInvolutionCensus
open Simplicity.Max1Fusion Simplicity.Max1Fusion.KernelOrbits
open LinearFive InvolutionCentralizers.Second
attribute [local irreducible] modelGroup matrixA matrixB max1Subgroup localKernel basis
set_option backward.isDefEq.respectTransparency true

private theorem first_of_nonpair (m : ℕ) (hm : m < 2048) (h0 : m ≠ 0)
    (hn : ∀ i j : Fin 24, pairLabel i j ≠ m) :
    IsConj a (kernelValue m : Model) := by
  have hm1 : kernelValue m ≠ 1 := by
    intro he
    exact h0 (kernelValue_injective hm (by decide) (he.trans kernelValue_zero.symm))
  obtain ⟨g, hg | hg⟩ := kernel_nonidentity_orbits matrixA_mul_self matrixB_pow_four
    (kernelValue m) (maskValue _ _ _).property hm1
  · have hback : g⁻¹ * kernelValue 1 * (g⁻¹)⁻¹ = kernelValue m := by
      rw [show kernelValue 1 = localKernelSeed matrixA_mul_self matrixB_pow_four from
        maskValue_one _ _, hg]
      simp [mul_assoc]
    have hp := congrArg Subtype.val (starHom_pair g⁻¹ 0 1)
    change g⁻¹ * kernelValue 1 * (g⁻¹)⁻¹ =
      kernelValue (pairLabel ((starHom g⁻¹).val 0) ((starHom g⁻¹).val 1)) at hp
    exact (hn _ _ (kernelValue_injective (pairLabel_lt _ _) hm (hp.symm.trans hback))).elim
  · obtain ⟨q, hq⟩ := pair_fuses_first matrixA_mul_self matrixB_pow_four
    have hc : IsConj (kernelValue m : Model) (kernelPair matrixA_mul_self matrixB_pow_four : Model) :=
      M.subtype.map_isConj (isConj_iff.mpr ⟨g, hg.symm⟩)
    exact (hc.trans (isConj_iff.mpr ⟨q, hq.symm⟩)).symm

theorem first_is_first : IsConj a (kernelValue 818 : Model) :=
  first_of_nonpair 818 (by decide) (by decide) (by decide +kernel)

theorem second_is_first : IsConj a (kernelValue 1449 : Model) :=
  first_of_nonpair 1449 (by decide) (by decide) (by decide +kernel)

theorem product_is_first : IsConj a ((kernelValue 818 : Model) * (kernelValue 1449 : Model)) := by
  change IsConj a ((kernelValue 818 * kernelValue 1449 : M) : Model)
  rw [← kernelValue_xor]
  exact first_of_nonpair 1691 (by decide) (by decide) (by decide +kernel)

/-- The marked native pair is simultaneously conjugate to census row 7. -/
theorem row_seven_conjugator :
    ∃ g : Model, (MulAut.conj g) a = (kernelValue 818 : Model) ∧
      (MulAut.conj g) (eH (representative 7)) = (kernelValue 1449 : Model) := by
  obtain ⟨i, g, hi, hx, hy⟩ := pure_first_pair_coverage
    (kernelValue 818) (kernelValue 1449)
    ((kernelValue_commute 818 1449).map M.subtype)
    first_is_first second_is_first product_is_first
  rcases hi with rfl | rfl
  · have hr := pairRank_conj g a (eH (representative 2))
    rw [hx, hy, native_pairRank, row_two_pairRank] at hr
    norm_num at hr
  · exact ⟨g, hx, hy⟩

/-- The literal four-group in the native elementary kernel of max1. -/
@[expose] def nativePair : Subgroup Model :=
  closure ({(kernelValue 818 : Model), (kernelValue 1449 : Model)} : Set Model)

theorem nativePair_le_max1 : nativePair ≤ M := by
  apply (closure_le _).mpr
  rintro x (rfl | rfl) <;> exact (kernelValue _).property

/-- One conjugator transports the pair and both full ambient local groups. -/
theorem row_seven_geometry :
    ∃ g : Model,
      nativePair = (firstFourGroup 7).map (MulAut.conj g).toMonoidHom ∧
      centralizer (nativePair : Set Model) =
        (centralizer (firstFourGroup 7 : Set Model)).map (MulAut.conj g).toMonoidHom ∧
      normalizer (nativePair : Set Model) =
        (normalizer (firstFourGroup 7 : Set Model)).map (MulAut.conj g).toMonoidHom := by
  obtain ⟨g, hx, hy⟩ := row_seven_conjugator
  have he : (firstFourGroup 7).map (MulAut.conj g).toMonoidHom = nativePair := by
    rw [firstFourGroup, MonoidHom.map_closure, Set.image_pair]
    change closure ({(MulAut.conj g) a, (MulAut.conj g) (eH (representative 7))} : Set Model) = _
    rw [hx, hy]
    rfl
  refine ⟨g, he.symm, ?_, ?_⟩
  · rw [← he]
    exact (map_centralizer_equiv (firstFourGroup 7 : Set Model) (MulAut.conj g)).symm
  · rw [← he]
    exact (map_equiv_normalizer_eq (firstFourGroup 7) (MulAut.conj g)).symm

/-- The row-7 branch of the census has an actual placement inside max1. -/
theorem row_seven_placement :
    ∃ g : Model, (firstFourGroup 7).map (MulAut.conj g).toMonoidHom ≤ M ∧
      (centralizer (firstFourGroup 7 : Set Model)).map (MulAut.conj g).toMonoidHom =
        centralizer (nativePair : Set Model) ∧
      (normalizer (firstFourGroup 7 : Set Model)).map (MulAut.conj g).toMonoidHom =
        normalizer (nativePair : Set Model) := by
  obtain ⟨g, he, hc, hn⟩ := row_seven_geometry
  exact ⟨g, he.symm.trans_le nativePair_le_max1, hc.symm, hn.symm⟩

end Janko4.LocalStructure.ElementaryNormalizerCover.PureTwoA.NativePair
