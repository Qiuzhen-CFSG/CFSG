def Candidate (n : ℕ) (x : Mask) : Prop :=
  (prefixSpan n).all (fun y =>
    decide (inK (xor x y) = inK (xor (siftingBasis n) y) ∧
    orbitColor (xor x y) = orbitColor (xor (siftingBasis n) y))) = true
instance (n : ℕ) (x : Mask) : Decidable (Candidate n x) := by
  unfold Candidate
  infer_instance

