theorem prefix_succ : ∀ n : Fin 8, prefixSpan (n.val+1) =
    prefixSpan n.val ++ (prefixSpan n.val).map (xor (siftingBasis n.val)) := by decide +kernel

theorem basis_not_prefix : ∀ n : Fin 8, siftingBasis n.val ∉ prefixSpan n.val := by decide +kernel

theorem bitBasis_mem_prefix : ∀ i : Fin 8, bitBasis i ∈ prefixSpan 8 := by decide +kernel

theorem candidate_covered : ∀ (n : Fin 8) (x : Mask), Candidate n.val x →
    ∃ j : Fin 64, transversalLevel j = n ∧ transversalTarget j = x := by decide +kernel

theorem transversal_image : ∀ j : Fin 64,
    linear (transversalColumns j) (siftingBasis (transversalLevel j).val) = transversalTarget j := by decide +kernel

private theorem transversal_fixes_check : ∀ j : Fin 64,
    (prefixSpan (transversalLevel j).val).all (fun y => decide (linear (transversalColumns j) y = y)) = true := by decide +kernel

theorem transversal_fixes (j : Fin 64) (y : Mask) (hy : y ∈ prefixSpan (transversalLevel j).val) :
    linear (transversalColumns j) y = y := by
  exact of_decide_eq_true ((List.all_eq_true.mp (transversal_fixes_check j)) y hy)

theorem transversal_word_basis : ∀ (j : Fin 64) (i : Fin 8),
    wordAction (transversalWord j) (bitBasis i) = linear (transversalColumns j) (bitBasis i) := by decide +kernel

end Janko4.LocalStructure.ElementaryNormalizerCover.PureTwoA.EightAutomizer
