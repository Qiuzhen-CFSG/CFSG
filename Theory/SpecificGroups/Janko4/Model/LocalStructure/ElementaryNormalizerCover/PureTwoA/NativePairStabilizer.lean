![[], [0], [1], [1, 0], [1, 1], [0, 1], [4, 2], [4, 2, 0], [4, 2, 1], [4, 4, 4], [1, 4, 2], [0, 4, 2], [2, 0], [2], [4, 4], [2, 1], [2, 0, 1], [2, 1, 1], [1, 0, 4], [1, 1, 4], [4, 1, 2], [2, 4, 2], [4, 1, 2, 1], [1, 1, 4, 1], [1, 3, 4, 1], [3, 0, 4, 1], [3, 1, 4], [3, 0, 4], [1, 3, 4], [1, 3, 4, 0], [0, 1, 3], [1, 1, 3], [0, 1, 3, 1], [1, 4, 4, 3], [3, 1, 1, 2], [1, 1, 3, 1], [3, 4, 1], [4, 3, 2], [3, 4], [3, 4, 0], [3, 4, 1, 1], [3, 4, 0, 1], [1, 3, 0], [1, 3], [3, 1, 2], [4, 4, 3], [1, 3, 1, 0], [1, 3, 1], [4, 3, 1], [4, 3, 1, 0], [4, 3], [4, 3, 0], [1, 4, 3], [0, 4, 3], [3, 2, 1], [3, 4, 4], [3, 2], [3, 2, 0], [3, 2, 1, 1], [3, 2, 0, 1], [0, 1, 2], [1, 1, 2], [4, 1, 4, 1], [1, 1, 2, 1], [4, 1, 4], [4, 0, 4], [0, 4], [1, 4], [1, 2, 4], [1, 4, 1], [0, 4, 1], [2, 0, 4], [4, 4, 4, 3], [3, 4, 2, 1], [4, 1, 3], [3, 4, 2], [4, 1, 3, 1], [3, 1, 4, 2], [3, 0], [3], [3, 1, 0], [3, 1], [3, 0, 1], [3, 1, 1], [1, 2, 0], [1, 2], [2, 1, 2], [4, 4, 2], [1, 4, 4], [1, 2, 1], [4, 0], [4], [2, 4], [4, 1], [4, 0, 1], [4, 1, 1]]
def evaluatePoint (w : List (Fin 5)) : Equiv.Perm (Fin 24) :=
  evalWord (fun i => (generator i).val) w
private theorem evaluate_table : ∀ i, (fun x => evaluatePoint (words i) x) = point i := by
  decide +kernel
def pointKey (i : Fin 96) : ℕ :=
  (List.finRange 24).foldl (fun n x => n * 24 + (point i x).val) 0
private theorem pointKey_lt_succ : ∀ i : Fin 95,
    pointKey i.castSucc < pointKey i.succ := by decide +kernel
private theorem point_injective : Function.Injective point := by
  intro i j h
  apply (Fin.strictMono_iff_lt_succ.mpr pointKey_lt_succ).injective
  unfold pointKey
  rw [h]

/-- Ninety-six actual Mathieu permutations generated by the five fixed words. -/
def element (i : Fin 96) : StarGroup := evalWord generator (words i)

private theorem evaluate_val (w : List (Fin 5)) :
    (evalWord generator w).val = evaluatePoint w := by
  induction w with
  | nil => rfl
  | cons a w ih => change (generator a).val * (evalWord generator w).val = _; rw [ih]; rfl

private theorem element_apply (i : Fin 96) (x : Fin 24) : (element i).val x = point i x := by
  change (evalWord generator (words i)).val x = _
  rw [evaluate_val]
  exact congrFun (evaluate_table i) x

theorem element_injective : Function.Injective element := by
  intro i j h
  apply point_injective
  funext x
  rw [← element_apply, ← element_apply, h]

/-- Every enumerated permutation belongs to any subgroup containing the five generators. -/
theorem element_mem (B : Subgroup StarGroup) (hB : ∀ j, generator j ∈ B) (i : Fin 96) :
    element i ∈ B := by
  have hw (w : List (Fin 5)) : evalWord generator w ∈ B := by
    induction w with
    | nil => exact B.one_mem
    | cons a w ih => exact B.mul_mem (hB a) ih
  exact hw (words i)

end Janko4.LocalStructure.ElementaryNormalizerCover.PureTwoA.NativePair.Stabilizer
