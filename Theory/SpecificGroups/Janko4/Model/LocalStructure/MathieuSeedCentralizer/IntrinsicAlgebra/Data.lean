def adaptedMatrix : BinaryMatrix := fun i j => bit (adaptedColumns.get j) i.val

def adaptedInverse : BinaryMatrix := decodeMatrixRows adaptedInverseRows

def firstIndex (i : Fin 56) : Fin 112 := ⟨i.val, by omega⟩
def secondIndex (i : Fin 56) : Fin 112 := ⟨56 + i.val, by omega⟩

def kernelColumns : Matrix (Fin 112) (Fin 56) (ZMod 2) :=
  adaptedMatrix.submatrix id firstIndex

def liftColumns : Matrix (Fin 112) (Fin 56) (ZMod 2) :=
  adaptedMatrix.submatrix id secondIndex

/-- The upper-left block in precisely the saved adapted coordinates. -/
def restrictionBlock (g : BinaryMatrix) : SmallMatrix :=
  (adaptedInverse * g * adaptedMatrix).submatrix firstIndex firstIndex

def wallMatrix : SmallMatrix := decodeMatrixRows wallRows

def wallInverse : SmallMatrix := decodeMatrixRows wallInverseRows

def ambientRadicalForm (i : Fin 10) : BinaryMatrix :=
  ∑ j : Fin 1221, bit (radicalCoefficients.get i) j.val • exteriorBasisForm j

def smallExteriorIndex (i j : Fin 56) : ℕ :=
  i.val * (111 - i.val) / 2 + (j.val - i.val - 1)

def decodeSmallExterior (r : ℕ) : SmallMatrix := fun i j =>
  if i < j then bit r (smallExteriorIndex i j)
  else if j < i then bit r (smallExteriorIndex j i)
  else 0

def descendedRadicalForm (i : Fin 10) : SmallMatrix :=
  decodeSmallExterior (radicalWords.get i)

def operator (i : Fin 10) : SmallMatrix := decodeFlat (operatorWords.get i)

def operatorSpace : Submodule (ZMod 2) SmallMatrix :=
  Submodule.span (ZMod 2) (Set.range operator)

def algebraBasis (i : Fin 56) : SmallMatrix := decodeFlat (algebraBasisWords.get i)

def algebraSpan : Submodule (ZMod 2) SmallMatrix :=
  Submodule.span (ZMod 2) (Set.range algebraBasis)

def generatedAlgebra : Subalgebra (ZMod 2) SmallMatrix :=
  Algebra.adjoin (ZMod 2) (Set.range operator)

def operatorMonomial (s : Finset (Fin 10)) : SmallMatrix :=
  ((s.sort (· ≤ ·)).map operator).prod

def homogeneousSpace (d : ℕ) : Submodule (ZMod 2) SmallMatrix :=
  Submodule.span (ZMod 2) {a | ∃ s : Finset (Fin 10), s.card = d ∧ operatorMonomial s = a}

def cyclicVector : SmallColumn := Pi.single 0 1

