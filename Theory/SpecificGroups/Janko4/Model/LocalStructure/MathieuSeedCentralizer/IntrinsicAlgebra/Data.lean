abbrev SmallColumn := Fin 56 → ZMod 2
abbrev SmallMatrix := Matrix (Fin 56) (Fin 56) (ZMod 2)

def bit (r i : ℕ) : ZMod 2 := if r.testBit i then 1 else 0

def decodeMatrixRows {n : ℕ} (r : Vector ℕ n) : Matrix (Fin n) (Fin n) (ZMod 2) :=
  fun i j => bit (r.get i) j.val

def decodeFlat (r : ℕ) : SmallMatrix := fun i j => bit r (56 * i.val + j.val)

