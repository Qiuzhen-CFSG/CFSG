private theorem decode_adapted : adaptedMatrix = decodeRows wallAdaptedRows := by
  decide +kernel

private theorem decode_inverse : adaptedInverse = decodeRows adaptedInverseRows := rfl

private theorem decode_displacement : displacementMatrix = decodeRows wallDisplacementRows := by
  rw [displacementMatrix, seed_matrix]
  decide +kernel

private theorem decode_adapted_transpose : adaptedMatrixᵀ = decodeRows adaptedColumns := rfl

private theorem inverse_product : packedMul adaptedInverseRows wallAdaptedRows = packedOne :=
  packedMul_eq_of_rows _ _ _ (by simp only [packedOne, get_ofFn]; decide +kernel)

private theorem product_inverse : packedMul wallAdaptedRows adaptedInverseRows = packedOne :=
  packedMul_eq_of_rows _ _ _ (by simp only [packedOne, get_ofFn]; decide +kernel)

theorem adaptedInverse_mul_adaptedMatrix : adaptedInverse * adaptedMatrix = 1 := by
  rw [decode_inverse, decode_adapted, ← decode_packedMul, inverse_product, decode_packedOne]

theorem adaptedMatrix_mul_adaptedInverse : adaptedMatrix * adaptedInverse = 1 := by
  rw [decode_inverse, decode_adapted, ← decode_packedMul, product_inverse, decode_packedOne]

private theorem displacement_product :
    packedMul wallDisplacementRows wallAdaptedRows = wallDisplacementAdaptedRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

private theorem normal_product :
    packedMul adaptedInverseRows wallDisplacementAdaptedRows = wallNormalRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

/-- The square-zero normal form, in the original order of the adapted columns. -/
def displacementNormalForm : BinaryMatrix := fun i j =>
  if i.val < 56 ∧ j.val = 56 + i.val then 1 else 0

theorem displacement_normalForm :
    adaptedInverse * displacementMatrix * adaptedMatrix = displacementNormalForm := by
  rw [Matrix.mul_assoc, decode_inverse, decode_displacement, decode_adapted,
    ← decode_packedMul, displacement_product, ← decode_packedMul, normal_product]
  decide +kernel

private theorem displacement_mul_adapted :
    displacementMatrix * adaptedMatrix = decodeRows wallDisplacementAdaptedRows := by
  rw [decode_displacement, decode_adapted, ← decode_packedMul, displacement_product]

theorem displacement_mul_kernelColumns : displacementMatrix * kernelColumns = 0 := by
  change displacementMatrix * adaptedMatrix.submatrix id firstIndex = 0
  have h := Matrix.submatrix_mul displacementMatrix adaptedMatrix id id firstIndex
    Function.bijective_id
  simp only [Matrix.submatrix_id_id] at h
  rw [← h, displacement_mul_adapted]
  decide +kernel

theorem displacement_mul_liftColumns : displacementMatrix * liftColumns = kernelColumns := by
  change displacementMatrix * adaptedMatrix.submatrix id secondIndex = kernelColumns
  have h := Matrix.submatrix_mul displacementMatrix adaptedMatrix id id secondIndex
    Function.bijective_id
  simp only [Matrix.submatrix_id_id] at h
  rw [← h, displacement_mul_adapted]
  decide +kernel

/-- The last adapted columns are the standard coordinates 0,...,54,56. -/
def liftIndex (j : Fin 56) : Fin 112 := ⟨if j.val < 55 then j.val else 56, by split <;> omega⟩

theorem liftColumns_standard :
    liftColumns = fun i j => if i = liftIndex j then 1 else 0 := by
  have h : ∀ (i : Fin 112) (j : Fin 56),
      liftColumns i j = if i = liftIndex j then 1 else 0 := by
    change ∀ (i : Fin 112) (j : Fin 56),
      bit (adaptedColumns.get (secondIndex j)) i.val = if i = liftIndex j then 1 else 0
    decide +kernel
  exact Matrix.ext h

private theorem transpose_form_product :
    packedMul adaptedColumns invariantFormRows = wallTransposeFormRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

private theorem adapted_form_product :
    packedMul wallTransposeFormRows wallAdaptedRows = wallAdaptedFormRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

private theorem adapted_form :
    adaptedMatrixᵀ * invariantForm * adaptedMatrix = decodeRows wallAdaptedFormRows := by
  rw [decode_adapted_transpose, decode_adapted]
  change decodeRows adaptedColumns * decodeRows invariantFormRows * _ = _
  rw [← decode_packedMul, transpose_form_product, ← decode_packedMul, adapted_form_product]

theorem adapted_form_topLeft :
    (adaptedMatrixᵀ * invariantForm * adaptedMatrix).submatrix firstIndex firstIndex = 0 := by
  rw [adapted_form]
  decide +kernel

theorem adapted_form_topRight :
    (adaptedMatrixᵀ * invariantForm * adaptedMatrix).submatrix firstIndex secondIndex = wallMatrix := by
  rw [adapted_form]
  decide +kernel

theorem adapted_form_bottomLeft :
    (adaptedMatrixᵀ * invariantForm * adaptedMatrix).submatrix secondIndex firstIndex = wallMatrix := by
  rw [adapted_form]
  decide +kernel

/-- Symmetry is certified for the literal saved matrix. -/
theorem wallMatrix_transpose : wallMatrixᵀ = wallMatrix := by decide +kernel

private def smallPackedRow (x : ℕ) (ys : Vector ℕ 56) : ℕ :=
  xorList (List.ofFn (fun k : Fin 56 => if x.testBit k.val then ys.get k else 0))

private theorem small_product (xs ys zs : Vector ℕ 56)
    (h : ∀ i : Fin 56, smallPackedRow (xs.get i) ys = zs.get i) :
    decodeMatrixRows xs * decodeMatrixRows ys = decodeMatrixRows zs := by
  funext i j
  change (∑ k : Fin 56, bit (xs.get i) k.val * bit (ys.get k) j.val) =
    GeneratorCertificates.bit (zs.get i) j.val
  rw [← h i]
  rw [smallPackedRow, bit_xorList, List.map_ofFn, List.sum_ofFn]
  apply Finset.sum_congr rfl
  intro k _
  simp only [bit, GeneratorCertificates.bit]
  cases h : (xs.get i).testBit k.val <;> simp [h]

private def smallOneRows : Vector ℕ 56 := Vector.ofFn (fun i => 2^i.val)

private theorem decode_smallOne : decodeMatrixRows smallOneRows = (1 : SmallMatrix) := by
  funext i j
  simp only [decodeMatrixRows, smallOneRows, get_ofFn, bit, Nat.testBit_two_pow,
    decide_eq_true_eq, Matrix.one_apply, Fin.ext_iff]

theorem wallInverse_mul_wallMatrix : wallInverse * wallMatrix = 1 := by
  rw [← decode_smallOne]
  exact small_product _ _ _ (by simp only [smallOneRows, get_ofFn]; decide +kernel)

theorem wallMatrix_mul_wallInverse : wallMatrix * wallInverse = 1 := by
  rw [← decode_smallOne]
  exact small_product _ _ _ (by simp only [smallOneRows, get_ofFn]; decide +kernel)

