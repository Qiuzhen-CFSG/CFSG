lemma operatorColumns_spec (i : Fin 10) (j k : Fin 56) :
    bit ((operatorColumns.get i).get k) j.val = operator i j k := by
  have h : ∀ (i : Fin 10) (j k : Fin 56),
      (((operatorColumns.get i).get k).testBit j.val) =
        (operatorWords.get i).testBit (56*j.val+k.val) := by decide +kernel
  exact congrArg (fun b => if b then (1 : ZMod 2) else 0) (h i j k)

lemma basisColumns_spec (i j : Fin 56) :
    bit (basisColumns.get i) j.val = gradedBasis i j 0 := by
  have h : ∀ (i j : Fin 56), (basisColumns.get i).testBit j.val =
      (basisWords.get i).testBit (56*j.val) := by decide +kernel
  exact congrArg (fun b => if b then (1 : ZMod 2) else 0) (h i j)

lemma actionCoordinates_degree (i : Fin 10) (j k : Fin 56)
    (h : ((actionCoordinates.get i).get j).testBit k.val = true) :
    (basisSet k).card = (basisSet j).card + 1 := by
  have hc : ∀ (i : Fin 10) (j k : Fin 56),
      ((actionCoordinates.get i).get j).testBit k.val = true →
        (basisSet k).card = (basisSet j).card + 1 := by decide +kernel
  exact hc i j k h

