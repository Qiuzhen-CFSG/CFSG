module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.MathieuSeedCentralizer.KernelBound.ShearRigidity.PairingKernel.Reduction

/-!
# All selected symmetry coefficient equations

These finite identities certify the witnesses in Data.lean by kernel reduction.
They are generated by source/generate.py; no external evaluator is trusted.
-/

public section
set_option Elab.async false
set_option maxRecDepth 10000
namespace Janko4.LocalStructure.MathieuSeedCentralizer.KernelBound.ShearRigidity.PairingCertificate
open Coordinates GeneratorCertificates
open OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.LinearMembership FiniteAlgebra

-- Traverse the packed table once, without repeated array lookups.
private def checkBits (r p q : ℕ) : List ℕ → Bool
  | [] => true
  | w :: ws => (r.testBit 0 == (w.testBit p != w.testBit q)) && checkBits (r >>> 1) p q ws

private theorem checkBits_ofFn {n : ℕ} (r p q : ℕ) (w : Fin n → ℕ) :
    checkBits r p q (List.ofFn w) = true ↔
      ∀ k, r.testBit k.val = ((w k).testBit p != (w k).testBit q) := by
  induction n generalizing r with
  | zero => simp [checkBits]
  | succ n ih =>
    rw [List.ofFn_succ, checkBits, Bool.and_eq_true, ih, Fin.forall_fin_succ]
    simp only [beq_iff_eq, Nat.testBit_shiftRight, Fin.val_zero, Fin.val_succ]
    simp only [Nat.add_comm]

private theorem checkBits_sound {n : ℕ} (r p q : ℕ) (w : Vector ℕ n)
    (h : checkBits r p q w.toList = true) (k : Fin n) :
    r.testBit k.val = ((w.get k).testBit p != (w.get k).testBit q) := by
  rw [← ofFn_get] at h
  exact (checkBits_ofFn r p q w.get).mp h k

private def listEquationCheck (e : Fin 614) : Bool :=
  checkBits (equations.get e)
    (56 * (positions.get e).1.val + (positions.get e).2.val)
    (56 * (positions.get e).2.val + (positions.get e).1.val) pairedWords.toList

private theorem listEquationCheck_sound (e : Fin 614) (h : listEquationCheck e = true) :
    EquationChecks e := checkBits_sound _ _ _ _ h

set_option maxHeartbeats 5000000 in
private theorem equationChecks0 : ∀ j : Fin 4,
    EquationChecks ⟨(0 + j.val) % 614, Nat.mod_lt _ (by decide)⟩ := by
  have h : ∀ j : Fin 4,
      listEquationCheck ⟨(0 + j.val) % 614, Nat.mod_lt _ (by decide)⟩ = true := by
    decide +kernel
  intro j
  exact listEquationCheck_sound _ (h j)

