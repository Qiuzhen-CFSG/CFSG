  have h : ∀ b : Fin 77, ∀ j : Fin 8,
      ProductChecks ⟨(8 * b.val + j.val) % 616, Nat.mod_lt _ (by decide)⟩ := by
    intro b
    fin_cases b
    · exact productChecks0
    · exact productChecks1
    · exact productChecks2
    · exact productChecks3
    · exact productChecks4
    · exact productChecks5
    · exact productChecks6
    · exact productChecks7
    · exact productChecks8
    · exact productChecks9
    · exact productChecks10
