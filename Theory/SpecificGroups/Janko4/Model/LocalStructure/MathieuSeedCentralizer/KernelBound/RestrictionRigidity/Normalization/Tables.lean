def normalBasis (i : Fin 56) : HalfMatrix := decodeHalf (normalWords.get i)

def deviation (i : Fin 10) : HalfMatrix := normalBasis ⟨i.val + 1, by omega⟩

def squareWords : Vector ℕ 45 :=
  Vector.ofFn (fun i => alternativeBasisWords.get ⟨i.val + 11, by omega⟩)

lemma squareWords_decode (i : Fin 45) : decodeHalf (squareWords.get i) = squareBasis i := by
  rw [squareWords, get_ofFn]
  rfl

lemma normalBasis_zero : normalBasis 0 = 1 := by decide +kernel

lemma normalBasis_square (i : Fin 45) : normalBasis ⟨i.val + 11, by omega⟩ = squareBasis i := by
  have h : ∀ i : Fin 45, normalWords.get ⟨i.val + 11, by omega⟩ =
      alternativeBasisWords.get ⟨i.val + 11, by omega⟩ := by decide +kernel
  exact congrArg decodeHalf (h i)

lemma original_coordinates : ∀ i : Fin 56,
    combination normalWords (originalCoordinates.get i) = algebraBasisWords.get i := by
  decide +kernel

lemma normal_original_coordinates : ∀ i : Fin 56,
    combination algebraBasisWords (normalOriginalCoordinates.get i) = normalWords.get i := by
  decide +kernel

lemma alternative_coordinates : ∀ i : Fin 56,
    combination normalWords (alternativeCoordinates.get i) = alternativeBasisWords.get i := by
  decide +kernel

lemma normal_alternative_coordinates : ∀ i : Fin 56,
    combination alternativeBasisWords (normalAlternativeCoordinates.get i) = normalWords.get i := by
  decide +kernel

