def annihilator : HalfMatrix := decodeHalf 

set_option maxRecDepth 10000 in
private theorem annihilator_products : ∀ (j : Fin 55) (r : Fin 56),
    scan (wordRow (normalWords.get ⟨j.val + 1, by omega⟩) r)
      (List.ofFn (wordRow )) = wordRow 0 r := by
  decide +kernel

theorem normalBasis_annihilator (j : Fin 55) :
