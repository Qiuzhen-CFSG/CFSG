/-- The alternative list, with no assertion yet that it is a basis. -/
def alternativeBasis (i : Fin 56) : HalfMatrix := decodeHalf (alternativeBasisWords.get i)

/-- The ten displayed degree-one operators. -/
def radicalGenerator (i : Fin 10) : HalfMatrix := alternativeBasis ⟨i.val + 1, by omega⟩

/-- The displayed 45 generators proposed for radical-square. -/
def squareBasis (i : Fin 45) : HalfMatrix := alternativeBasis ⟨i.val + 11, by omega⟩

/-- The exact literal span used by normalization and separation. The definition
alone does not identify this subspace with an algebraic radical-square. -/
def squareSpan : Submodule (ZMod 2) HalfMatrix :=
  Submodule.span (ZMod 2) (Set.range squareBasis)

/-- The restriction of the source witness form, pending source-space calibration. -/
def testForm : HalfMatrix := decodeHalf testFormWord

/-- The residual operator singled out by the proposed separation calculation. -/
def topOperator : HalfMatrix := decodeHalf topOperatorWord

