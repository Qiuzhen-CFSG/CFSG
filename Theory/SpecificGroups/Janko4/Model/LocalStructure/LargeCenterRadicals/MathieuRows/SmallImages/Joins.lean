namespace Janko4.LocalStructure.LargeCenterRadicals.MathieuRows.SmallImages
open ElementaryNormalizerCover.ElementaryBound
attribute [local irreducible] check

def join0 : Tree := .branch 124 piece0 piece1

theorem join0_checked : check keep neighbors masks join0 [0, 124, 130, 139, 140, 146, 152, 156, 171, 172, 173, 174, 175, 187, 188]  = true := by
  have hl : ([0, 124, 130, 139, 140, 146, 152, 156, 171, 172, 173, 174, 175, 187, 188] : List (Fin 192)).filter (fun a => a != (124 : Fin 192)) = [0, 130, 139, 140, 146, 152, 156, 171, 172, 173, 174, 175, 187, 188] := by
    decide +kernel
  have hr : ([0, 124, 130, 139, 140, 146, 152, 156, 171, 172, 173, 174, 175, 187, 188] : List (Fin 192)).filter (fun a => (neighbors (124 : Fin 192)).testBit a.val) = [0, 124, 130, 139, 140, 146, 152, 156, 171, 172, 173, 174, 175, 187, 188] := by
    decide +kernel
  have hw :  &&& masks (124 : Fin 192) =  := by
    decide +kernel
  rw [join0, check, Bool.and_eq_true, hl, hr, hw]
  exact ⟨piece0_checked, piece1_checked⟩

