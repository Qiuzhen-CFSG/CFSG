    conjugator * (sourceRepresentative 4 : Model) * conjugator⁻¹ = InvolutionCentralizers.Second.seed := by
  apply mul_inv_eq_iff_eq_mul.mpr
  apply toMatrix_injective
  change toMatrix (word0 * (sourceRepresentative 4 : Model)) = toMatrix ((InvolutionCentralizers.Second.seed : Model) * word0)
