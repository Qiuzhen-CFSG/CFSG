module
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalInvolutionCensus.QuotientCensus.Core

/-!
# Multiplication-program data for the quotient census

The program starts with 1, X, Y, and Y inverse. Each later entry is a product
of two earlier entries. The three commuting-subgroup tables, Sylow table,
and conjugating words are all selections from this program. `Program` checks
every product and hence certifies membership in the actual quotient Q.
The untrusted generator and witnesses are retained in `source/`.
-/

set_option maxRecDepth 100000

@[expose] public section
namespace Janko4.Cardinality.LocalInvolutionCensus.QuotientCensus
open OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
open LowerBound QuotientOrderCertificate

def codeNatData : Fin 58 → ℕ :=
  ![, , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , ]

def codeNat (i : Fin 7392) : ℕ :=
  (codeNatData (Fin.ofNat 58 (i.val / 128)) >>> (144 * (i.val % 128))) % 22300745198530623141535718272648361505980416

def code (i : Fin 7392) : BitVec 144 := BitVec.ofNat 144 (codeNat i)

def leftNatData : Fin 58 → ℕ :=
  ![, , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , ]

def leftNat (i : Fin 7392) : ℕ :=
  (leftNatData (Fin.ofNat 58 (i.val / 128)) >>> (13 * (i.val % 128))) % 8192

def left (i : Fin 7392) : Fin 7392 := Fin.ofNat 7392 (leftNat i)

def rightNatData : Fin 58 → ℕ :=
  ![, , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , , ]

def rightNat (i : Fin 7392) : ℕ :=
  (rightNatData (Fin.ofNat 58 (i.val / 128)) >>> (13 * (i.val % 128))) % 8192

def right (i : Fin 7392) : Fin 7392 := Fin.ofNat 7392 (rightNat i)

abbrev programCheck (i : Fin 7392) : Prop :=
  if i.val < 4 then (basic (Fin.ofNat 4 i.val)).val.val = decode (code i)
  else left i < i ∧ right i < i ∧ mulCheck (code (left i)) (code (right i)) (code i)

end Janko4.Cardinality.LocalInvolutionCensus.QuotientCensus
