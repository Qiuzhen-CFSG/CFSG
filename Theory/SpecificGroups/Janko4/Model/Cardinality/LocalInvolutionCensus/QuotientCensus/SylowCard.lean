module
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalInvolutionCensus.QuotientCensus.FiniteData
import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalInvolutionCensus.QuotientCensus.SylowCard.Checks

/-!+# The quotient Sylow candidate has exactly 256 elements

The published multiplication tree places each table entry in the subgroup
generated by the four fixed quotient elements. Checked right transitions by
generators and inverses exhaust that subgroup. The sorted matrix codes give
256 distinct entries, so the subgroup has order 256 without an ambient-order
hypothesis. Promotion to a Sylow subgroup belongs to the quotient census
assembly, where the quotient order is available.

The local census supports the group-order estimates in Aschbacher--Smith,
`refs/quasithin.pdf`, printed pp.64--65, A.6.1--4. These two finite-table
conclusions do not assert those source theorems. Matrix and witness provenance
is recorded in `QuotientCensus/source/README.md`.
-/

public section
namespace Janko4.Cardinality.LocalInvolutionCensus.QuotientCensus.SylowTable

private theorem table_root : table 0 = 1 := by
  change element (tableIndex 0) = 1
  rw [CardChecks.root, element_zero]

private theorem generator_inverse (a : Fin 4) :
    element (genInvIndex a) = (gen a)⁻¹ := by
  apply eq_inv_of_mul_eq_one_right
  exact (productCheck_sound (CardChecks.inverses a)).trans element_zero

private theorem table_step (a : Fin 4) (i : Fin 256) :
    table i * gen a = table (step a i) :=
  productCheck_sound (CardChecks.forward a i)

private theorem table_stepInv (a : Fin 4) (i : Fin 256) :
    table i * (gen a)⁻¹ = table (stepInv a i) := by
  rw [← generator_inverse a]
  exact productCheck_sound (CardChecks.backward a i)

private theorem table_mem (i : Fin 256) : table i ∈ candidate := by
  apply tree_mem candidate gen table parent letter
  · intro a
    exact Subgroup.subset_closure (Set.mem_range_self a)
  · exact table_root
  · exact CardChecks.parent_lt
  · intro j hj
    exact productCheck_sound (CardChecks.tree j hj)

/-- The fixed table exhausts the actual subgroup generated by the four words. -/
theorem candidate_covered : ∀ v : Q, v ∈ candidate → ∃ i : Fin 256, v = table i :=
  table_covers gen table step stepInv table_root table_step table_stepInv

private theorem sorted_table_injective : Function.Injective (fun i => table (sorted i)) := by
  apply table_injective (fun i => table (sorted i)) (fun i => code (tableIndex (sorted i)))
  · intro i
    exact element_val (tableIndex (sorted i))
  · exact CardChecks.sorted_lt

/-- The actual four-generator subgroup of the quotient has order 256. -/
theorem candidate_card : Nat.card candidate = 256 := by
  let f : Fin 256 → candidate := fun i => ⟨table i, table_mem i⟩
  have hf : Function.Surjective f := by
    intro v
    obtain ⟨i, hi⟩ := candidate_covered v.val v.property
    exact ⟨i, Subtype.ext hi.symm⟩
  have hupper : Nat.card candidate ≤ 256 := by
    simpa only [Nat.card_fin] using Nat.card_le_card_of_surjective f hf
  let g : Fin 256 → candidate := fun i => f (sorted i)
  have hg : Function.Injective g := by
    intro i j hij
    exact sorted_table_injective (congrArg Subtype.val hij)
  have hlower : 256 ≤ Nat.card candidate := by
    simpa only [Nat.card_fin] using Nat.card_le_card_of_injective g hg
  exact Nat.le_antisymm hupper hlower

end Janko4.Cardinality.LocalInvolutionCensus.QuotientCensus.SylowTable
