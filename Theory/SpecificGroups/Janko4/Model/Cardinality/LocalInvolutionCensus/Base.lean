module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.Conjugacy
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.Kernel

/-!
# The literal carriers for the max2 involution census

The group `H` is the subgroup generated by the certified, conjugated ATLAS
max2 words inside the literal centralizer of the first matrix generator.
Its embedding `eH` sends its distinguished involution `zH` to that generator.
The second ambient representative `t` is the seed in the separate max1 subgroup.
In particular it is not the word called `t` in the max2 bridge.

The three sets below use conjugacy in `Model`. Their eventual orbit covers
use conjugacy in `H`; the lemmas here justify passage from local conjugacy
to ambient conjugacy, including multiplication by `zH`.

Source motivation: Aschbacher--Smith, `refs/quasithin.pdf`, printed pp.64--65,
A.6.1--4. These are the local versions of B₁(z), C₂(z), and C₁(z). No equality
of `H` with the full centralizer is assumed or asserted.
-/

@[expose] public section
namespace Janko4.Cardinality.LocalInvolutionCensus

open OuterReduction.FixedGenerator.NormalizerSquares
open TwoCoreCentralizerData

/-- The actual subgroup of the literal involution centralizer. -/
abbrev H := localSubgroup

/-- The actual inclusion into the matrix group. -/
def eH : H →* Model := centralizerToModel.comp localSubgroup.subtype

/-- The central involution in the local carrier. -/
abbrev zH : H := subgroupInvolution

/-- Its image in the matrix group. -/
def z : Model := eH zH

/-- The literal max1 seed used as the second ambient representative. -/
def t : Model := localKernelSeed matrixA_mul_self matrixB_pow_four

theorem eH_injective : Function.Injective eH :=
  centralizerToModel_injective.comp Subtype.val_injective

@[simp] theorem eH_zH : eH zH = Janko4.a := rfl

@[simp] theorem z_eq_a : z = Janko4.a := rfl

theorem zH_mem_center : zH ∈ Subgroup.center H := by
  rw [Subgroup.mem_center_iff]
  intro u
  apply Subtype.ext
  exact (Subgroup.mem_center_iff.mp centralInvolution_mem_center) u

theorem zH_pow_two : zH ^ 2 = 1 := by
  simpa only [orderOf_subgroupInvolution] using pow_orderOf_eq_one zH

theorem orderOf_zH : orderOf zH = 2 := orderOf_subgroupInvolution

theorem orderOf_z : orderOf z = 2 :=
  (orderOf_injective eH eH_injective zH).trans orderOf_zH

/-- Every local element commutes with the marked ambient involution. -/
theorem eH_commute_z (u : H) : Commute (eH u) z := by
  change eH u * eH zH = eH zH * eH u
  simpa only [map_mul] using congrArg eH ((Subgroup.mem_center_iff.mp zH_mem_center) u)

/-- The exact conjugation formula for the original ATLAS coordinates. -/
theorem eH_sourceSubgroupEquivLocal (u : sourceSubgroup) :
    eH (sourceSubgroupEquivLocal u) = h⁻¹ * (u : Model) * h :=
  sourceSubgroupEquivLocal_apply u

/-- Two first-class involutions differing by the marked central involution. -/
def aa : Set H := {u | IsConj z (eH u) ∧ IsConj z (eH (u * zH))}

/-- A second-class involution whose marked translate is first-class. -/
def ba : Set H := {u | IsConj t (eH u) ∧ IsConj z (eH (u * zH))}

/-- Two second-class involutions differing by the marked central involution. -/
def bb : Set H := {u | IsConj t (eH u) ∧ IsConj t (eH (u * zH))}

/-- A conjugacy class for conjugation inside the actual local subgroup. -/
def localClass (r : H) : Set H := {u | IsConj r u}

theorem eH_isConj {u v : H} (huv : IsConj u v) : IsConj (eH u) (eH v) :=
  eH.map_isConj huv

theorem isConj_mul_zH {u v : H} (huv : IsConj u v) :
    IsConj (u * zH) (v * zH) := by
  obtain ⟨g, hg⟩ := isConj_iff.mp huv
  apply isConj_iff.mpr
  refine ⟨g, ?_⟩
  have hz := (Subgroup.mem_center_iff.mp zH_mem_center) g⁻¹
  calc
    g * (u * zH) * g⁻¹ = (g * u * g⁻¹) * zH := by
      simp only [mul_assoc, hz]
    _ = v * zH := by rw [hg]

theorem ambient_pair_of_isConj {p q : Model} {r u : H}
    (hr : IsConj p (eH r) ∧ IsConj q (eH (r * zH))) (hu : IsConj r u) :
    IsConj p (eH u) ∧ IsConj q (eH (u * zH)) :=
  ⟨hr.1.trans (eH_isConj hu), hr.2.trans (eH_isConj (isConj_mul_zH hu))⟩

end Janko4.Cardinality.LocalInvolutionCensus
