namespace Janko4.Cardinality.LocalInvolutionCensus.FiberCensus.Forest.Edges.PackedRows
open OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
open LowerBound KernelSeparation Janko4.GeneratorCertificates

theorem fastNodes_eq (k : Fin 11) (n : ℕ) :
    fastNodes k n = ((nodes k)[n]?).getD (0, 0, 0) := by
  have h := congrArg (fun l : List (ℕ × ℕ × ℕ) => l[n]?.getD (0, 0, 0)) (nodes_checked k)
  simp only [List.getElem?_map, Array.getElem?_toList] at h
  by_cases hn : n < fiberBound k
  · simpa only [List.getElem?_range hn, Option.map_some, Option.getD_some] using h
  · have hr : (List.range (fiberBound k))[n]? = none :=
      List.getElem?_eq_none (by simpa only [List.length_range] using Nat.le_of_not_gt hn)
    simpa only [hr, Option.map_none, Option.getD_none, fastNodes, if_neg hn] using h

/-- Child mask, parent mask, and actor index, in the original convention. -/
noncomputable def fastTuple (k : Fin 11) (n : ℕ) : ℕ × ℕ × ℕ :=
  ((fastNodes k n).1 % 8192,
    (fastNodes k (fastNodes k n).2.1).1 % 8192, (fastNodes k n).2.2)

end Janko4.Cardinality.LocalInvolutionCensus.FiberCensus.Forest.Edges.PackedRows
