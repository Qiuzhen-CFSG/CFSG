def inverseFactorRows (i : Fin 13) : Vector ℕ 112 :=
  Vector.ofFn (fun k => inverseFactorEntry i.val k.val)

/-- A reduction-friendly spelling of right multiplication by an inverse factor. -/
def fastInverseRow (r : ℕ) (i : Fin 13) : ℕ :=
  xorList (List.ofFn (fun k : Fin 112 =>
    if r.testBit k.val then inverseFactorEntry i.val k.val else 0))

theorem fastInverseRow_eq (r : ℕ) (i : Fin 13) :
    fastInverseRow r i = packedRow r (inverseFactorRows i) := by
  simp only [fastInverseRow, packedRow, inverseFactorRows, get_ofFn]

