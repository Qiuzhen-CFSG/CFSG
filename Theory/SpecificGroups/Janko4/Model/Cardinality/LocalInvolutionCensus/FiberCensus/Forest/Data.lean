/-- The literal subgroup actors, in exactly the saved index convention. -/
def sourceActors (j : Fin 4) : List sourceSubgroup :=
  if j = 0 then [sourceX, sourceY]
  else (List.ofFn LowerBound.kernelFactor) ++ (actorWords j).map sourceWord

noncomputable def maskAt (k : Fin 11) (n : ℕ) : Fin 8192 :=
  Fin.ofNat 8192 ((nodes k)[n]?.getD (0, 0, 0)).1

noncomputable def parentAt (k : Fin 11) (n : ℕ) : ℕ :=
  ((nodes k)[n]?.getD (0, 0, 0)).2.1

noncomputable def actorIndexAt (k : Fin 11) (n : ℕ) : ℕ :=
  ((nodes k)[n]?.getD (0, 0, 0)).2.2

/-- Every chosen actor belongs to the actual source subgroup by construction. -/
noncomputable def actorAt (k : Fin 11) (n : ℕ) : sourceSubgroup :=
  (sourceActors (fiberIndex k)).getD (actorIndexAt k n) 1

theorem nodes_size (k : Fin 11) : (nodes k).size = fiberBound k := by
  exact (show ∀ k : Fin 11, (nodes k).size = fiberBound k from by decide +kernel) k

/-- This checks that the array labels are precisely the existing public lists. -/
theorem nodes_masks (k : Fin 11) :
    (nodes k).toList.map (fun e => Fin.ofNat 8192 e.1) = masks k := by
  exact (show ∀ k : Fin 11,
    (nodes k).toList.map (fun e => Fin.ofNat 8192 e.1) = masks k
    from by decide +kernel) k

theorem root_mask (k : Fin 11) : maskAt k 0 = kernelIndex k := by
  exact (show ∀ k : Fin 11, maskAt k 0 = kernelIndex k from by decide +kernel) k

private theorem nodes_valid (k : Fin 11) :
    (nodes k).toList.zipIdx.all (fun e =>
      decide (e.2 = 0 ∨ e.1.2.1 < e.2) &&
      decide (e.1.2.2 < (sourceActors (fiberIndex k)).length)) = true := by
  exact (show ∀ k : Fin 11,
    (nodes k).toList.zipIdx.all (fun e =>
      decide (e.2 = 0 ∨ e.1.2.1 < e.2) &&
      decide (e.1.2.2 < (sourceActors (fiberIndex k)).length)) = true
    from by decide +kernel) k

private theorem node_valid (k : Fin 11) (n : Fin (fiberBound k)) :
    (n.val = 0 ∨ parentAt k n.val < n.val) ∧
      actorIndexAt k n.val < (sourceActors (fiberIndex k)).length := by
  have hn : n.val < (nodes k).size := by simpa only [nodes_size] using n.isLt
  have hm : ((nodes k)[n.val], n.val) ∈ (nodes k).toList.zipIdx := by
    apply List.mk_mem_zipIdx_iff_getElem?.mpr
    rw [Array.getElem?_toList, Array.getElem?_eq_getElem hn]
  have hc := (List.all_eq_true.mp (nodes_valid k)) _ hm
  simpa only [parentAt, actorIndexAt, Array.getElem?_eq_getElem hn,
    Option.getD_some, Bool.and_eq_true, decide_eq_true_eq] using hc

theorem parent_lt (k : Fin 11) (n : Fin (fiberBound k)) (hn : n.val ≠ 0) :
    parentAt k n.val < n.val :=
  (node_valid k n).1.resolve_left hn

theorem actorIndex_lt (k : Fin 11) (n : Fin (fiberBound k)) :
    actorIndexAt k n.val < (sourceActors (fiberIndex k)).length :=
  (node_valid k n).2

