/-- Ordered coordinate lists, with the representative mask first. -/
noncomputable def masks (k : Fin 11) : List (Fin 8192) :=
  (maskCodes k).map (fun n => Fin.ofNat 8192 n)

set_option maxRecDepth 10000 in
/-- Only a list length is asserted, not a conjugacy class size. -/
theorem masks_length (k : Fin 11) : (masks k).length = fiberBound k := by
  have hc : ∀ k : Fin 11, (masks k).length = fiberBound k := by decide +kernel
  exact hc k

/-- Repetitions would only make this bound weaker; no distinctness is assumed. -/
theorem masks_card_le (k : Fin 11) :
    Nat.card {m : Fin 8192 // m ∈ masks k} ≤ fiberBound k := by
  classical
  rw [Nat.card_eq_fintype_card,
    Fintype.card_of_subtype (masks k).toFinset (fun _ => List.mem_toFinset)]
  exact (masks k).toFinset_card_le.trans (masks_length k).le

end Janko4.Cardinality.LocalInvolutionCensus.FiberCensus
