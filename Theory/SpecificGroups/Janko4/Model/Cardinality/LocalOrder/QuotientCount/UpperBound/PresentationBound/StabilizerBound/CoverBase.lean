/-!
# Certified recursive stabilizer cosets

Generated by `source/generate_covers.py` from the explicit Todd–Coxeter traces
in `source/cover*.json`. Data lookups are balanced and contain explicit words;
no proof history is recomputed. The subgroup loops use actual membership,
and every other deduction uses the checked coset-word calculus.
-/

@[expose] public section
namespace Janko4.Cardinality.QuotientCount.UpperBound.PresentationBound.StabilizerChain
open Subgroup.CosetWordCertificate

/-- Balanced lookup for certificate data. -/
def lookupBranch {α : Type*} (cutoff : Nat) (left right : Nat → α) (i : Nat) : α :=
  if i < cutoff then left i else right i

/-- A word in the subgroup gives a loop at the identity representative. -/
theorem holds_subgroup_word {α G : Type*} [Group G] (H : Subgroup G)
    (g : α → G) (ρ : Nat → G) (hroot : ρ 0 = 1) (w : Word α)
    (hw : eval g w ∈ H) : Holds H g ρ ⟨0, w, 0⟩ :=
  ⟨⟨eval g w, hw⟩, by simp [hroot]⟩

end Janko4.Cardinality.QuotientCount.UpperBound.PresentationBound.StabilizerChain
