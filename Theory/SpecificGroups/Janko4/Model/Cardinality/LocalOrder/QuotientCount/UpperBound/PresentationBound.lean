module

public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.QuotientCount.UpperBound.PresentationBound.FirstStabilizer
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.QuotientCount.UpperBound.PresentationBound.CosetCover
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.QuotientCount.UpperBound.PresentationBound.LiftedRelations
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.QuotientCount.UpperBound.PresentationBound.StabilizerBound

/-!
# Cardinal bound for the fixed local presentation

The 47-relator presentation is covered by 24 right cosets of the subgroup
specified in `FirstStabilizer`. A finite auxiliary presentation surjects onto
that subgroup because its 43 relations hold there. Its certified bound
10200960 therefore yields the bound 244823040.

The three certificate inputs are explicit and independent: the coset cover,
the auxiliary presentation bound, and the lifted relations. None is inferred
from a permutation image or an external order calculation. The theorem
`presentation_bound` assembles all three certificates. See the adjacent
`PresentationBound/source/README.md` for the presentation data and provenance.
-/

namespace Janko4.Cardinality.QuotientCount.UpperBound.PresentationBound
open Subgroup.CosetWordCertificate

/-- Lifted relations give a homomorphism from the short auxiliary presentation. -/
public def stabilizerHom (hrels : StabilizerRelations) :
    StabilizerPresentation →* Presentation :=
  PresentedGroup.toGroup (f := subgroupGenerator) (by
    rintro _ ⟨i, rfl⟩
    exact hrels i)

/-- The image is exactly the subgroup generated by the ten specified words. -/
public theorem stabilizerHom_range (hrels : StabilizerRelations) :
    (stabilizerHom hrels).range = firstSubgroup := by
  rw [MonoidHom.range_eq_map, ← PresentedGroup.closure_range_of
    (Set.range stabilizerRelatorWord), MonoidHom.map_closure, ← Set.range_comp]
  congr 1
  apply congrArg Set.range
  funext i
  exact PresentedGroup.toGroup.of _

/-- The auxiliary presentation bounds its image, once its relations are lifted. -/
public theorem firstSubgroup_bound (hrels : StabilizerRelations)
    (hbound : Finite StabilizerPresentation ∧ Nat.card StabilizerPresentation ≤ 10200960) :
    Finite firstSubgroup ∧ Nat.card firstSubgroup ≤ 10200960 := by
  let := hbound.1
  let f := stabilizerHom hrels
  have hfinite : Finite f.range := Finite.of_surjective _ f.rangeRestrict_surjective
  have hcard : Nat.card f.range ≤ 10200960 :=
    (Nat.card_le_card_of_surjective _ f.rangeRestrict_surjective).trans hbound.2
  have hr : f.range = firstSubgroup := stabilizerHom_range hrels
  exact hr ▸ ⟨hfinite, hcard⟩

/-- The exact remaining certificate contracts for the requested upper bound. -/
public theorem presentation_bound_of_firstStabilizer
    (hrels : StabilizerRelations)
    (hbound : Finite StabilizerPresentation ∧ Nat.card StabilizerPresentation ≤ 10200960)
    (cover : Subgroup.GeneratorCosetCover firstSubgroup PresentedGroup.of (Fin 24)) :
    Finite Presentation ∧ Nat.card Presentation ≤ 244823040 := by
  obtain ⟨hfinite, hcard⟩ := firstSubgroup_bound hrels hbound
  let := hfinite
  obtain ⟨hfiniteP, hcardP⟩ := PresentedGroup.finite_card_le_of_cosetCover firstSubgroup cover
  refine ⟨hfiniteP, hcardP.trans ?_⟩
  simpa only [Nat.card_fin] using Nat.mul_le_mul_right 24 hcard

/-- The fixed 47-relator presentation is finite of order at most 244823040. -/
public theorem presentation_bound :
    Finite Presentation ∧ Nat.card Presentation ≤ 244823040 :=
  presentation_bound_of_firstStabilizer stabilizer_relations
    stabilizer_presentation_bound firstSubgroup_cosetCover

end Janko4.Cardinality.QuotientCount.UpperBound.PresentationBound
