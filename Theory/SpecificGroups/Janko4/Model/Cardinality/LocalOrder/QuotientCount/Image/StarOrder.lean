module

public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.QuotientCount.Image.StarOrder.Upper
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.QuotientCount.Image.StarOrder.Lower

/-!
# Order of the concrete star permutation group

The saved star relabeling conjugates both generators into the verified Witt
S(5,8,24) automorphism group M24; explicit standard-generator words certify
this embedding. Independently, a stabilizer-transversal certificate constructs
244823040 distinct elements of the star group. The known M24 order supplies
the matching upper bound. No claim about generation from standard-generator
membership alone is used.

The concrete data originate in the ATLAS J4 local conjugation exploration;
see `StarData` and `StarOrder/source/` for attribution and reproducibility.
-/

namespace Janko4.Cardinality.QuotientCount.Image

/-- The group generated by the two certified star permutations has M24 order. -/
public theorem starGroup_order : Nat.card StarGroup = 244823040 :=
  Nat.le_antisymm StarOrderCertificate.starGroup_card_le
    StarOrderCertificate.starGroup_card_ge

/-- The explicit relabeling identifies the star group with the full Witt-design
 automorphism group, after the independent transversal lower bound. -/
public noncomputable def starGroupEquivM24 : StarGroup ≃* Sporadic.Mathieu.M24 :=
  MulEquiv.ofBijective StarOrderCertificate.starToM24
    (StarOrderCertificate.starToM24_injective.bijective_of_nat_card_le (by
      rw [Sporadic.Mathieu.m24_order, starGroup_order]))

/-- This identification is the specified conjugation on the 24-point action. -/
public theorem starGroupEquivM24_apply (g : StarGroup) :
    (starGroupEquivM24 g : Equiv.Perm (Fin 24)) =
      MulAut.conj StarOrderCertificate.relabel (g : Equiv.Perm (Fin 24)) := by
  unfold starGroupEquivM24
  rfl

end Janko4.Cardinality.QuotientCount.Image
