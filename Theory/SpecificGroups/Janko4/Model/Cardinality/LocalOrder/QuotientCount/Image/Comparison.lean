module

public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.QuotientCount.Image.Coordinates
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.QuotientCount.Image.StarData

/-!
# Comparing local conjugation with the 24-star action

The actual conjugation image is multiplicatively equivalent to the subgroup
of permutations of 24 stars generated by `starX` and `starY`.

First, evaluation of binary masks takes XOR to multiplication in the actual
local kernel. Thus the finite pair-label identities intertwine the certified
right-conjugation actions; inversion gives the required left-conjugation
convention. The subgroup generated by the paired generators consequently
preserves these evaluated labels. Both projections have their prescribed
ranges and trivial kernels: the labels distinguish star permutations, while
the basis-pair labels and generation distinguish actual conjugations.

This comparison uses neither a group-order calculation nor an identification
with M24. Source: the ATLAS `J4G1-max1W1` conjugation tables and the star-label
certificate documented in `Image.Coordinates` and `Image.StarData`.
-/

set_option maxRecDepth 10000
set_option backward.isDefEq.respectTransparency true
public section

namespace Janko4.Cardinality.QuotientCount.Image
open KernelCount
variable (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1)
attribute [local irreducible] basis modelGroup matrixA matrixB localKernel
  max1Subgroup localX localY localKernelSeed

private def maskValue (m : ℕ) : localKernel hA hB :=
  coordinates hA hB (fun i => m.testBit i.val)

private lemma maskValue_zero : maskValue hA hB 0 = 1 := by
  apply Subtype.ext
  simp [maskValue, coordinates_val, binaryProduct_zero]

private lemma maskValue_xor (m n : ℕ) :
    maskValue hA hB (Nat.xor m n) = maskValue hA hB m * maskValue hA hB n := by
  change maskValue hA hB (m ^^^ n) = _
  simp only [maskValue, coordinates_mul, Nat.testBit_xor]

private lemma maskValue_fold (l : List ℕ) :
    maskValue hA hB (l.foldr Nat.xor 0) = (l.map (maskValue hA hB)).prod := by
  induction l with
  | nil => exact maskValue_zero hA hB
  | cons a l ih => simpa only [List.foldr_cons, List.map_cons, List.prod_cons,
      maskValue_xor] using congrArg (maskValue hA hB a * ·) ih

private lemma maskValue_maskImage (masks : Fin 11 → ℕ) (m : ℕ) :
    (maskValue hA hB (maskImage masks m) : max1Subgroup hA hB) =
      binaryProduct (fun i => binaryProduct (basis hA hB)
        (fun j => (masks i).testBit j.val)) (fun i => m.testBit i.val) := by
  rw [maskImage, maskValue_fold]
  simp only [List.map_ofFn, SubmonoidClass.coe_list_prod]
  rw [binaryProduct]
  congr 1
  congr 1
  funext i
  dsimp only [Function.comp_apply]
  split_ifs
  · rfl
  · change (maskValue hA hB 0 : max1Subgroup hA hB) = 1
    rw [maskValue_zero]
    rfl

private lemma right_compatible_x (i j : Fin 24) :
    action hA hB (localX hA hB)⁻¹ (maskValue hA hB (pairLabel i j)) =
      maskValue hA hB (pairLabel (rightX i) (rightX j)) := by
  apply Subtype.ext
  rw [action_apply, inv_inv, pairLabel_rightX, maskValue_maskImage]
  exact right_conj_coordinates_x hA hB _

private lemma right_compatible_y (i j : Fin 24) :
    action hA hB (localY hA hB)⁻¹ (maskValue hA hB (pairLabel i j)) =
      maskValue hA hB (pairLabel (rightY i) (rightY j)) := by
  apply Subtype.ext
  rw [action_apply, inv_inv, pairLabel_rightY, maskValue_maskImage]
  exact right_conj_coordinates_y hA hB _

private def Compatible (p : Equiv.Perm (localKernel hA hB) × Equiv.Perm (Fin 24)) : Prop :=
  ∀ i j, p.1 (maskValue hA hB (pairLabel i j)) =
    maskValue hA hB (pairLabel (p.2 i) (p.2 j))

private lemma compatible_inv {p : Equiv.Perm (localKernel hA hB) × Equiv.Perm (Fin 24)}
    (h : Compatible hA hB p) : Compatible hA hB p⁻¹ := by
  intro i j
  apply p.1.injective
  simpa using (h (p.2⁻¹ i) (p.2⁻¹ j)).symm

private def paired : Subgroup (Equiv.Perm (localKernel hA hB) × Equiv.Perm (Fin 24)) :=
  Subgroup.closure {(action hA hB (localX hA hB), starX),
    (action hA hB (localY hA hB), starY)}

private lemma paired_compatible (p) (hp : p ∈ paired hA hB) : Compatible hA hB p := by
  induction hp using Subgroup.closure_induction with
  | mem p hp =>
    rcases Set.mem_insert_iff.mp hp with rfl | hp
    · have hr : Compatible hA hB (action hA hB (localX hA hB)⁻¹, rightX) :=
        right_compatible_x hA hB
      simpa only [Prod.inv_mk, ← map_inv, inv_inv, starX] using compatible_inv hA hB hr
    · obtain rfl := Set.mem_singleton_iff.mp hp
      have hr : Compatible hA hB (action hA hB (localY hA hB)⁻¹, rightY) :=
        right_compatible_y hA hB
      simpa only [Prod.inv_mk, ← map_inv, inv_inv, starY] using compatible_inv hA hB hr
  | one => intro i j; rfl
  | mul p q hp hq ip iq =>
    intro i j
    change p.1 (q.1 _) = _
    rw [iq, ip]
    rfl
  | inv p hp ih => exact compatible_inv hA hB ih

private def firstProjection : paired hA hB →* Equiv.Perm (localKernel hA hB) :=
  (MonoidHom.fst _ _).comp (paired hA hB).subtype

private def secondProjection : paired hA hB →* Equiv.Perm (Fin 24) :=
  (MonoidHom.snd _ _).comp (paired hA hB).subtype

private lemma firstProjection_range : (firstProjection hA hB).range = ActionImage hA hB := by
  rw [firstProjection, MonoidHom.range_comp, Subgroup.range_subtype, paired,
    MonoidHom.map_closure, Set.image_pair]
  exact (action_range_generated hA hB).symm

private lemma secondProjection_range : (secondProjection hA hB).range = StarGroup := by
  rw [secondProjection, MonoidHom.range_comp, Subgroup.range_subtype, paired,
    MonoidHom.map_closure, Set.image_pair]
  rfl

private lemma maskValue_injective_bounded {m n : ℕ} (hm : m < 2048) (hn : n < 2048)
    (h : maskValue hA hB m = maskValue hA hB n) : m = n := by
  have hb := coordinates_injective hA hB h
  apply Nat.eq_of_testBit_eq
  intro j
  by_cases hj : j < 11
  · exact congrFun hb ⟨j, hj⟩
  · have hp : 2^11 ≤ 2^j := Nat.pow_le_pow_right (by decide) (by omega)
    rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le hm hp),
      Nat.testBit_lt_two_pow (lt_of_lt_of_le hn hp)]

private lemma firstProjection_injective : Function.Injective (firstProjection hA hB) := by
  apply (injective_iff_map_eq_one _).mpr
  intro p hp
  have hc := paired_compatible hA hB p.val p.property
  have hf : p.val.1 = 1 := hp
  have hs : p.val.2 = 1 := by
    apply permutation_eq_one_of_pairLabel
    intro i j
    apply maskValue_injective_bounded hA hB (pairLabel_lt _ _) (pairLabel_lt _ _)
    simpa only [hf, Equiv.Perm.one_apply] using (hc i j).symm
  apply Subtype.ext
  exact Prod.ext hf hs

private lemma maskValue_basis (i : Fin 11) :
    (maskValue hA hB (2 ^ i.val) : max1Subgroup hA hB) = basis hA hB i := by
  simp only [maskValue, coordinates_val, Nat.testBit_two_pow]
  convert binaryProduct_single (basis hA hB) i using 2
  funext j
  simp only [Fin.ext_iff, eq_comm]

private lemma secondProjection_injective : Function.Injective (secondProjection hA hB) := by
  apply (injective_iff_map_eq_one _).mpr
  intro p hp
  have hs : p.val.2 = 1 := hp
  have hc := paired_compatible hA hB p.val p.property
  have hr : p.val.1 ∈ ActionImage hA hB := by
    rw [← firstProjection_range hA hB]
    exact ⟨p, rfl⟩
  obtain ⟨g, hg⟩ := hr
  have hfix : ∀ i, (MulAut.conj g) (basis hA hB i) = basis hA hB i := by
    intro i
    have hi := hc (basisPair i).1 (basisPair i).2
    rw [hs] at hi
    simp only [Equiv.Perm.one_apply, pairLabel_basisPair, ← hg] at hi
    have hv := congrArg (fun n : localKernel hA hB => (n : max1Subgroup hA hB)) hi
    simpa only [action_apply, maskValue_basis, MulAut.conj_apply] using hv
  have hall : Set.EqOn (MulAut.conj g).toMonoidHom (MonoidHom.id _)
      (Subgroup.closure (Set.range (basis hA hB))) := by
    apply MonoidHom.eqOn_closure
    rintro a ⟨i, rfl⟩
    exact hfix i
  have hf : p.val.1 = 1 := by
    rw [← hg]
    apply Equiv.ext
    intro n
    apply Subtype.ext
    exact hall (by rw [closure_basis_eq_localKernel hA hB]; exact n.property)
  apply Subtype.ext
  exact Prod.ext hf hs

/-- The actual left-conjugation image is the certified 24-star group. -/
noncomputable def actionImageEquivStarGroup : ActionImage hA hB ≃* StarGroup :=
  (MulEquiv.subgroupCongr (firstProjection_range hA hB)).symm.trans
    ((MulEquiv.ofBijective (firstProjection hA hB).rangeRestrict
      ⟨(MonoidHom.rangeRestrict_injective_iff).mpr (firstProjection_injective hA hB),
        (firstProjection hA hB).rangeRestrict_surjective⟩).symm.trans
      ((MulEquiv.ofBijective (secondProjection hA hB).rangeRestrict
        ⟨(MonoidHom.rangeRestrict_injective_iff).mpr (secondProjection_injective hA hB),
          (secondProjection hA hB).rangeRestrict_surjective⟩).trans
        (MulEquiv.subgroupCongr (secondProjection_range hA hB))))

private theorem actionImageEquivStarGroup_paired (p : paired hA hB) :
    (actionImageEquivStarGroup hA hB
      ⟨firstProjection hA hB p,
        by rw [← firstProjection_range hA hB]; exact ⟨p, rfl⟩⟩).val =
      secondProjection hA hB p := by
  let e := MulEquiv.ofBijective (firstProjection hA hB).rangeRestrict
      ⟨(MonoidHom.rangeRestrict_injective_iff).mpr (firstProjection_injective hA hB),
        (firstProjection hA hB).rangeRestrict_surjective⟩
  change (secondProjection hA hB) (e.symm (e p)) = secondProjection hA hB p
  rw [e.symm_apply_apply]

/-- The comparison preserves the first marked generator, including the
left-conjugation convention. -/
theorem actionImageEquivStarGroup_x :
    (actionImageEquivStarGroup hA hB
      ((action hA hB).rangeRestrict (localX hA hB))).val = starX := by
  exact actionImageEquivStarGroup_paired hA hB
    ⟨(action hA hB (localX hA hB), starX),
      Subgroup.subset_closure (Set.mem_insert _ _)⟩

/-- The comparison preserves the second marked generator, including the
left-conjugation convention. -/
theorem actionImageEquivStarGroup_y :
    (actionImageEquivStarGroup hA hB
      ((action hA hB).rangeRestrict (localY hA hB))).val = starY := by
  exact actionImageEquivStarGroup_paired hA hB
    ⟨(action hA hB (localY hA hB), starY),
      Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)⟩

end Janko4.Cardinality.QuotientCount.Image
