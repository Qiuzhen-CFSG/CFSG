module

public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.Kernel
public import Mathlib.GroupTheory.GroupAction.ConjAct
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# The local conjugation image

The normal closure `N` of `(xy)^14` in the concrete local subgroup `H`
admits the canonical left conjugation action. Its image is generated by
the images of the two ATLAS local generators. The action kernel is exactly
`C_H(N)`, so identifying the image alone does not identify `H/N`.

The final lemmas provide two certification routes: prove `C_H(N) = N`, or
prove that the image has the proposed order and give a matching upper bound
for `H/N`. Neither concrete certificate is asserted here.

Source of the local generators: the ATLAS `J4G1-max1W1` program documented
in `Cardinality.Subgroup`. The action convention is `z ↦ g*z*g⁻¹`;
recorded right-conjugation permutation tables must therefore be inverted.
-/

@[expose] public section
namespace Janko4.Cardinality.QuotientCount

variable (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1)

/-- Left conjugation on the actual normal closure, as permutations. -/
def action : max1Subgroup hA hB →* Equiv.Perm (localKernel hA hB) :=
  (MulAut.toPerm _).comp MulAut.conjNormal

@[simp] theorem action_apply (g : max1Subgroup hA hB) (n : localKernel hA hB) :
    (action hA hB g n : max1Subgroup hA hB) = g * n * g⁻¹ := rfl

/-- The actual image, rather than a group specified by an expected order. -/
abbrev ActionImage := (action hA hB).range

theorem action_range_generated :
    (action hA hB).range = Subgroup.closure
      {action hA hB (localX hA hB), action hA hB (localY hA hB)} := by
  rw [MonoidHom.range_eq_map, ← localXY_generate hA hB,
    MonoidHom.map_closure, Set.image_pair]

theorem mem_action_ker_iff (g : max1Subgroup hA hB) :
    g ∈ (action hA hB).ker ↔
      ∀ n ∈ localKernel hA hB, n * g = g * n := by
  change action hA hB g = 1 ↔ _
  constructor
  · intro hg n hn
    have he := congrArg (fun p : Equiv.Perm (localKernel hA hB) =>
      ((p ⟨n, hn⟩ : localKernel hA hB) : max1Subgroup hA hB)) hg
    change g * n * g⁻¹ = n at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  · intro hg
    apply Equiv.ext
    intro n
    apply Subtype.ext
    change g * n * g⁻¹ = n
    exact mul_inv_eq_iff_eq_mul.mpr (hg n n.property).symm

theorem action_ker_eq_centralizer :
    (action hA hB).ker = Subgroup.centralizer (localKernel hA hB : Set _) := by
  ext g
  rw [Subgroup.mem_centralizer_iff]
  exact mem_action_ker_iff hA hB g

/-- Commutativity of the normal closure makes the action descend to `H/N`. -/
theorem localKernel_le_action_ker
    (hcomm : ∀ (n : max1Subgroup hA hB), n ∈ localKernel hA hB →
      ∀ (m : max1Subgroup hA hB), m ∈ localKernel hA hB →
      n * m = m * n) :
    localKernel hA hB ≤ (action hA hB).ker := by
  intro n hn
  exact (mem_action_ker_iff hA hB n).mpr (fun m hm => hcomm m hm n hn)

/-- A centralizer certificate identifies the quotient with the action image. -/
noncomputable def quotientEquivImage
    (hker : (action hA hB).ker = localKernel hA hB) :
    LocalQuotient hA hB ≃* ActionImage hA hB :=
  (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
    (QuotientGroup.quotientKerEquivRange (action hA hB))

theorem card_of_kernel_eq
    (hker : (action hA hB).ker = localKernel hA hB)
    (himage : Nat.card (ActionImage hA hB) = 244823040) :
    Nat.card (LocalQuotient hA hB) = 244823040 :=
  (Nat.card_congr (quotientEquivImage hA hB hker).toEquiv).trans himage

/-- An image certificate supplies a lower bound, provided that `N` acts trivially. -/
theorem image_card_le_quotient_card
    (hkill : localKernel hA hB ≤ (action hA hB).ker) :
    Nat.card (ActionImage hA hB) ≤ Nat.card (LocalQuotient hA hB) := by
  have hkill' : localKernel hA hB ≤ (action hA hB).rangeRestrict.ker := by
    intro n hn
    apply Subtype.ext
    exact hkill hn
  exact Nat.card_le_card_of_surjective
    (QuotientGroup.lift (localKernel hA hB) (action hA hB).rangeRestrict hkill')
    (QuotientGroup.lift_surjective_of_surjective _ _
      (action hA hB).rangeRestrict_surjective hkill')

/-- A quotient upper bound can replace a separate action-faithfulness proof. -/
theorem card_of_image_and_upper_bound
    (hkill : localKernel hA hB ≤ (action hA hB).ker)
    (himage : Nat.card (ActionImage hA hB) = 244823040)
    (hupper : Nat.card (LocalQuotient hA hB) ≤ 244823040) :
    Nat.card (LocalQuotient hA hB) = 244823040 := by
  apply Nat.le_antisymm hupper
  rw [← himage]
  exact image_card_le_quotient_card hA hB hkill

end Janko4.Cardinality.QuotientCount
