/-- Bounded binary search; its retraction law is checked independently. -/
def recoverAux : ℕ → ℕ → ℕ → ℕ → ℕ
  | 0, _, _, _ => 0
  | fuel + 1, r, lo, hi =>
    let mid := (lo + hi) / 2
    let m := sortedMask mid
    if r = row m then m
    else if r < row m then recoverAux fuel r lo mid
    else recoverAux fuel r (mid + 1) hi

def recover (r : ℕ) : ℕ := recoverAux 12 r 0 2048

