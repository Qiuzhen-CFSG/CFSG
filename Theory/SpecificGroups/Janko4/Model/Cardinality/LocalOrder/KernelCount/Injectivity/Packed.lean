set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem basisEntry_eq : ∀ (n : Fin 11) (k : Fin 112),
    basisEntry n.val k.val = (basisRows n).get k := by
  decide +kernel

def fastPackedRow (x : ℕ) (n : Fin 11) : ℕ :=
  xorList (List.ofFn (fun k : Fin 112 =>
    if x.testBit k.val then basisEntry n.val k.val else 0))

theorem fastPackedRow_eq (x : ℕ) (n : Fin 11) :
    fastPackedRow x n = packedRow x (basisRows n) := by
  simp only [fastPackedRow, packedRow, basisEntry_eq]

end Janko4.Cardinality.KernelCount.Injectivity
