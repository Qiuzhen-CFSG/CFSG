module

public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.Kernel
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.KernelCount
public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder.QuotientCount
public import Theory.Mathieu.M24.Properties.Order

/-!
# Counting the concrete ATLAS local subgroup through its normal subgroup

The normal closure of `(xy)^14` in the matrix subgroup has order `2^11` by a
binary matrix certificate. A conjugation image gives the quotient's lower
bound, while a checked presentation and its relators give the matching upper
bound of `244823040`. Multiplying these certified cardinalities gives the
order of the concrete ATLAS subgroup.

Source for the proposed local structure:
https://brauer.maths.qmul.ac.uk/Atlas/v3/subgroup/J4G1-max1W1 .
-/

public section
namespace Janko4.Cardinality

/-- Multiply the orders of the concrete normal closure and its quotient.
This also permits a direct quotient counting certificate instead of an M24
identification. -/
theorem max1Subgroup_card_of_local_factors
    (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1)
    (hkernel : Nat.card (localKernel hA hB) = 2048)
    (hquotient : Nat.card (LocalQuotient hA hB) = 244823040) :
    Nat.card (max1Subgroup hA hB) = 501397585920 := by
  calc
    Nat.card (max1Subgroup hA hB) =
        Nat.card (localKernel hA hB) * (localKernel hA hB).index :=
      (localKernel hA hB).card_mul_index.symm
    _ = 501397585920 := by
      change Nat.card (localKernel hA hB) * Nat.card (LocalQuotient hA hB) = _
      rw [hkernel, hquotient]

/-- Assemble the local order from certificates for the specified normal
closure and its quotient. This is not an unconditional order certification. -/
theorem max1Subgroup_card_of_kernel_quotient
    (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1)
    (hkernel : Nat.card (localKernel hA hB) = 2048)
    (e : LocalQuotient hA hB ≃* Sporadic.Mathieu.M24) :
    Nat.card (max1Subgroup hA hB) = 501397585920 := by
  apply max1Subgroup_card_of_local_factors hA hB hkernel
  exact
    (Nat.card_congr e.toEquiv).trans Sporadic.Mathieu.m24_order

/-- The concrete subgroup generated by the ATLAS `J4G1-max1W1` words has
order `2^11 * 244823040`. -/
theorem max1Subgroup_card
    (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1) :
    Nat.card (max1Subgroup hA hB) = 501397585920 :=
  max1Subgroup_card_of_local_factors hA hB
    (localKernel_card hA hB) (localQuotient_card hA hB)

end Janko4.Cardinality
