module

public import Theory.SpecificGroups.Janko4.Model.Cardinality.Cosets.FixedVector
public import Mathlib.GroupTheory.DoubleCoset
public import Mathlib.Order.Atoms

/-!
# Criteria for identifying the concrete J₄ vector stabilizer

Write `H` for the subgroup generated by the two literal ATLAS program outputs.
The checked fixed-vector calculations give `H ≤ K < G`, where `K` is the
stabilizer of `cosetBaseVector`. Thus a proof that `H` is maximal would identify
`K`. Alternatively, a cover of the actual matrix group by double cosets `H r H`
reduces the identification to checking the representatives: any representative
fixing the base vector must lie in `H`. Cancellation of the two factors from
`H ≤ K` proves this criterion without a group order or an orbit count.

These are conditional criteria, not a claim that the concrete stabilizer has
been identified. No maximality proof or double-coset cover is supplied here.
The source matrices and program are documented in `Model.Data` and
`Cardinality.Subgroup`; the fixed-vector computations are in `Cosets.FixedVector`.
-/

public section
namespace Janko4.Cardinality

/-- The computed motion by the second source generator makes the stabilizer
proper, independently of any cardinality calculation. -/
theorem cosetVectorStabilizer_ne_top (hB : matrixB ^ 4 = 1) :
    cosetVectorStabilizer ≠ ⊤ := by
  intro he
  exact sourceB_not_mem_cosetVectorStabilizer hB (he.symm ▸ Subgroup.mem_top _)

/-- Maximality must be proved in the actual matrix carrier. Together with the
checked fixed vector and its motion, it implies the desired reverse inclusion. -/
theorem cosetVectorStabilizer_le_max1Subgroup_of_isCoatom
    (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1)
    (hmax : IsCoatom (max1Subgroup hA hB)) :
    cosetVectorStabilizer ≤ max1Subgroup hA hB := by
  exact ((hmax.le_iff_eq (cosetVectorStabilizer_ne_top hB)).mp
    (max1Subgroup_le_cosetVectorStabilizer hA hB)).le

/-- An actual double-coset cover identifies the stabilizer if all of its
representatives that fix the vector belong to the proposed subgroup.
Vector-orbit coverage alone does not supply the `hcover` hypothesis. -/
theorem cosetVectorStabilizer_le_max1Subgroup_of_doubleCosets
    (hA : matrixA * matrixA = 1) (hB : matrixB ^ 4 = 1)
    {ι : Type*} (repr : ι → Model)
    (hcover : ∀ g : Model, ∃ i,
      g ∈ DoubleCoset.doubleCoset (repr i)
        (max1Subgroup hA hB) (max1Subgroup hA hB))
    (hfixed : ∀ i, vectorRight cosetBaseVector (repr i) = cosetBaseVector →
      repr i ∈ max1Subgroup hA hB) :
    cosetVectorStabilizer ≤ max1Subgroup hA hB := by
  intro g hg
  obtain ⟨i, hi⟩ := hcover g
  obtain ⟨a, ha, b, hb, rfl⟩ := DoubleCoset.mem_doubleCoset.mp hi
  have hle := max1Subgroup_le_cosetVectorStabilizer hA hB
  have hr : repr i ∈ cosetVectorStabilizer :=
    (cosetVectorStabilizer.mul_mem_cancel_left (hle ha)).mp
      ((cosetVectorStabilizer.mul_mem_cancel_right (hle hb)).mp hg)
  exact (max1Subgroup hA hB).mul_mem
    ((max1Subgroup hA hB).mul_mem ha (hfixed i hr)) hb

end Janko4.Cardinality
