module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.LinearNormalizer.Reduction
public import Theory.Mathieu.M22.Properties.AutomorphismCoverage

/-!
# Automorphism coverage on the perfect core quotient

Assume that the actual derived subgroup of the binary matrix group is perfect,
is generated by CD and D², and has central quotient isomorphic to the concrete
M₂₂. Then conjugation by the original matrix group realizes every automorphism
of that quotient.

The scalar word commutes with both even generators, hence with the core.
Conjugation by C moves it, so is not inner; perfectness detects this on the
central quotient. The image also contains every inner automorphism. The proved
M₂₂ design-automorphism coverage and its two-coset normal form then exhaust the
automorphism group. We transport the action through the supplied equivalence
and back, without any recognition or normalizer assumption.

The matrices and their ATLAS attribution are retained in
`../LinearModel/source/`. The M₂₂ automorphism input is proved in
`Theory.Mathieu.M22.Properties.AutomorphismCoverage`, with its source reference
to GLS3, Table 5.3c, Note 1. This is a conditional matrix-model helper;
perfectness, generation and the M₂₂ equivalence remain the assembly owner's
obligations.
-/

open Sporadic.Mathieu

private theorem m22_aut_normalForm (a : MulAut M22) :
    ∃ h : M22, a = MulAut.conj h ∨
      a = MulAut.conj h * m22DesignAutToAut m22OuterDesignAut := by
  obtain ⟨g, rfl⟩ := m22DesignAutToAut_surjective a
  obtain ⟨h, hh | hh⟩ := m22DesignAut_normalForm g
  · refine ⟨h, Or.inl ?_⟩
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    rw [m22DesignAutToAut_apply_perm, hh]
    rfl
  · refine ⟨h, Or.inr ?_⟩
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    rw [m22DesignAutToAut_apply_perm, hh]
    change ((h : Equiv.Perm (Fin 22)) * m22OddPairSwap) * x.val *
      ((h : Equiv.Perm (Fin 22)) * m22OddPairSwap)⁻¹ =
      (h : Equiv.Perm (Fin 22)) *
        ((m22DesignAutToAut m22OuterDesignAut x : M22) : Equiv.Perm (Fin 22)) *
        (h : Equiv.Perm (Fin 22))⁻¹
    rw [m22DesignAutToAut_apply_perm]
    change _ = (h : Equiv.Perm (Fin 22)) *
      (m22OddPairSwap * x.val * m22OddPairSwap⁻¹) * (h : Equiv.Perm (Fin 22))⁻¹
    group

private theorem m22_aut_subgroup_eq_top (H : Subgroup (MulAut M22))
    (hinner : ∀ x : M22, MulAut.conj x ∈ H)
    (houter : ∃ a ∈ H, ¬ ∃ x : M22, a = MulAut.conj x) : H = ⊤ := by
  obtain ⟨a, ha, hna⟩ := houter
  obtain ⟨x, hx | hx⟩ := m22_aut_normalForm a
  · exact (hna ⟨x, hx⟩).elim
  · have ho : m22DesignAutToAut m22OuterDesignAut ∈ H := by
      have h := H.mul_mem (H.inv_mem (hinner x)) ha
      rwa [hx, inv_mul_cancel_left] at h
    apply top_unique
    intro b _
    obtain ⟨y, hy | hy⟩ := m22_aut_normalForm b
    · rw [hy]
      exact hinner y
    · rw [hy]
      exact H.mul_mem (hinner y) ho

namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel

private theorem scalarUnit_mem_center_of_generated
    (hgen : derivedGroup = Subgroup.closure {coreA, coreB}) :
    (⟨scalarUnit, scalarUnit_mem_derivedGroup⟩ : derivedGroup) ∈
      Subgroup.center derivedGroup := by
  have hA : Commute scalarUnit coreA := by
    apply Units.ext
    change (scalarUnit : Matrix12) * (coreA : Matrix12) =
      (coreA : Matrix12) * (scalarUnit : Matrix12)
    rw [coe_scalarUnit, coe_coreA]
    exact ((Commute.one_left matrixA).add_left matrixJ_commute_A).eq
  have hB : Commute scalarUnit coreB := by
    apply Units.ext
    change (scalarUnit : Matrix12) * (coreB : Matrix12) =
      (coreB : Matrix12) * (scalarUnit : Matrix12)
    rw [coe_scalarUnit, coe_coreB]
    exact ((Commute.one_left matrixB).add_left matrixJ_commute_B).eq
  have hc : scalarUnit ∈ Subgroup.centralizer (derivedGroup : Set Matrix12ˣ) := by
    rw [hgen, Subgroup.centralizer_closure]
    apply Subgroup.mem_centralizer_iff.mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact hA.eq.symm
    · rw [Set.mem_singleton_iff] at hx
      subst x
      exact hB.eq.symm
  apply Subgroup.mem_center_iff.mpr
  intro x
  exact Subtype.ext (Subgroup.mem_centralizer_iff.mp hc x.val x.property)

private theorem derivedConjugation_unitC_not_inner
    (hgen : derivedGroup = Subgroup.closure {coreA, coreB}) :
    ¬ ∃ x : derivedGroup,
      derivedConjugation ⟨unitC, unitC_mem_actionGroup⟩ = MulAut.conj x := by
  rintro ⟨x, hx⟩
  let z : derivedGroup := ⟨scalarUnit, scalarUnit_mem_derivedGroup⟩
  have hz : z ∈ Subgroup.center derivedGroup := scalarUnit_mem_center_of_generated hgen
  have hfix : derivedConjugation ⟨unitC, unitC_mem_actionGroup⟩ z = z := by
    rw [hx]
    change x * z * x⁻¹ = z
    rw [Subgroup.mem_center_iff.mp hz x, mul_assoc, mul_inv_cancel, mul_one]
  have hv := congrArg Subtype.val hfix
  change unitC * scalarUnit * unitC⁻¹ = scalarUnit at hv
  rw [unitC_conj_scalarUnit] at hv
  apply scalarUnit_ne_one
  apply mul_left_cancel (a := scalarUnit)
  simpa only [pow_two, mul_one] using hv

/-- The perfect core's central quotient receives every automorphism, conditional
on its generation by the two even words and an actual equivalence with M₂₂. -/
public theorem derivedQuotientConjugation_surjective_of_equiv
    [Group.IsPerfect derivedGroup]
    (hgen : derivedGroup = Subgroup.closure {coreA, coreB})
    (e : derivedGroup ⧸ Subgroup.center derivedGroup ≃* M22) :
    Function.Surjective derivedQuotientConjugation := by
  let ρ : actionGroup →* MulAut M22 :=
    (MulAut.centralQuotientAction e).comp derivedConjugation
  have hinner (y : M22) : MulAut.conj y ∈ ρ.range := by
    obtain ⟨q, rfl⟩ := e.surjective y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (Subgroup.center derivedGroup) q
    let g : actionGroup := ⟨x.val, derivedGroup_le_actionGroup x.property⟩
    have hg : derivedConjugation g = MulAut.conj x := by
      apply MulEquiv.ext
      intro z
      exact Subtype.ext rfl
    refine ⟨g, ?_⟩
    change MulAut.centralQuotientAction e (derivedConjugation g) = _
    rw [hg, MulAut.centralQuotientAction_conj]
  have houter : ∃ a ∈ ρ.range, ¬ ∃ x : M22, a = MulAut.conj x := by
    let c : actionGroup := ⟨unitC, unitC_mem_actionGroup⟩
    refine ⟨ρ c, ⟨c, rfl⟩, ?_⟩
    intro h
    apply derivedConjugation_unitC_not_inner hgen
    exact (MulAut.centralQuotientAction_inner_iff e (derivedConjugation c)).mp h
  have hsurj : Function.Surjective ρ :=
    MonoidHom.range_eq_top.mp (m22_aut_subgroup_eq_top ρ.range hinner houter)
  intro a
  obtain ⟨g, hg⟩ := hsurj (MulAut.congr e a)
  exact ⟨g, (MulAut.congr e).injective hg⟩

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel
