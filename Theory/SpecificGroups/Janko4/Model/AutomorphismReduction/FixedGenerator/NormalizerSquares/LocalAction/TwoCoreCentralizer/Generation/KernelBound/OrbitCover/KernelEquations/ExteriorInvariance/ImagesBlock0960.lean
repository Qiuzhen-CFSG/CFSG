/-!
# Ambient generator images of basis forms 960 through 983

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA0960 : ℕ := 

private def imageA0960 : ℕ := 

private def coefficientsA0960 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0960 :
    flatMatrix transposeA * flatMatrix (basisFlat 960) =
      flatMatrix middleA0960 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0960 :
    flatMatrix middleA0960 * flatMatrix ambientA =
      flatMatrix imageA0960 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0960 :
    combination coefficientsA0960 = imageA0960 := by decide +kernel

private theorem preservedA0960 :
    formPullback matrixUnitA (exteriorBasisForm 960) ∈ exteriorFormSpace := by
  rw [← basis_decode (960 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 960) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0960, rightA0960,
    ← reconstructA0960]
  exact combination_mem coefficientsA0960

