private def middleA0672 : ℕ := 

private def imageA0672 : ℕ := 

private def coefficientsA0672 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0672 :
    flatMatrix transposeA * flatMatrix (basisFlat 672) =
      flatMatrix middleA0672 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0672 :
    flatMatrix middleA0672 * flatMatrix ambientA =
      flatMatrix imageA0672 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0672 :
    combination coefficientsA0672 = imageA0672 := by decide +kernel

private theorem preservedA0672 :
    formPullback matrixUnitA (exteriorBasisForm 672) ∈ exteriorFormSpace := by
  rw [← basis_decode (672 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 672) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0672, rightA0672,
    ← reconstructA0672]
  exact combination_mem coefficientsA0672

