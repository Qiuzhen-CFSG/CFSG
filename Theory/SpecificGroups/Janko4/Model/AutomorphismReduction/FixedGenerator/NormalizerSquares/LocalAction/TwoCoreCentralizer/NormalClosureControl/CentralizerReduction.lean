module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.NormalClosureControl.TwoGroup

/-!
# Two independent bounds for the relative seed centralizer

Let H be the subgroup generated by the conjugated max2 outputs and N the
normal closure in H of the order-four seed. Conjugation gives an action of
H on N, with kernel C_H(N). To bound this centralizer it suffices to show
that the action kernel lies in N and that the intrinsic center of N is
contained in the powers of the distinguished involution. These are separate
obligations: the generator relations proving that N is a two-group do not
control elements of H outside N.

This module proves only the conditional assembly and exposes the actual
matrix commutation test through the faithful representation. No generation
of the full involution centralizer or quotient faithfulness is assumed.
Source motivation: GLS3 Table 5.3i, printed p.270; the literal ATLAS word
provenance and conjugating element are certified in `Max2Bridge`.
-/

@[expose] public section

namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData

/-- Conjugation on the published normal closure by its relative overgroup. -/
def localNormalClosureAction : localSubgroup →* MulAut localNormalClosure :=
  MulAut.conjNormal

theorem localNormalClosureAction_ker : localNormalClosureAction.ker =
    Subgroup.centralizer (localNormalClosure : Set localSubgroup) :=
  MulAut.conjNormal_ker_eq_centralizer localNormalClosure

/-- The same relative centralizer, tested using the certified word matrices.
The quantified element still belongs to H, not to all ambient matrix units. -/
theorem mem_localNormalClosure_centralizer_iff_matrices (z : localSubgroup) :
    z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup) ↔
      ∀ i, decodeRows (NormalClosureControl.Certificates.basisRows i) *
          NormalClosureControl.representation z =
        NormalClosureControl.representation z *
          decodeRows (NormalClosureControl.Certificates.basisRows i) := by
  rw [mem_localNormalClosure_centralizer_iff]
  constructor
  · intro hz i
    simpa only [map_mul, NormalClosureControl.representation_basis] using
      congrArg NormalClosureControl.representation (hz i)
  · intro hz i
    apply NormalClosureControl.representation_injective
    simpa only [map_mul, NormalClosureControl.representation_basis] using hz i

/-- Independent bounds on the action kernel and the intrinsic center combine
into the full relative centralizer bound. Both premises remain obligations. -/
theorem localNormalClosure_centralizer_eq_zpowers_of_bounds
    (hkernel : localNormalClosureAction.ker ≤ localNormalClosure)
    (hcenter : localNormalClosure ⊓
      Subgroup.centralizer (localNormalClosure : Set localSubgroup) ≤
      Subgroup.zpowers subgroupInvolution) :
    Subgroup.centralizer (localNormalClosure : Set localSubgroup) =
      Subgroup.zpowers subgroupInvolution := by
  apply le_antisymm ?_ zpowers_involution_le_localNormalClosure_centralizer
  intro z hz
  rw [localNormalClosureAction_ker] at hkernel
  exact hcenter ⟨hkernel hz, hz⟩

/-- The relative centralizer exponent follows once the two independent bounds
have actually been discharged. -/
theorem localNormalClosure_centralizer_pow_two_of_bounds
    (hkernel : localNormalClosureAction.ker ≤ localNormalClosure)
    (hcenter : localNormalClosure ⊓
      Subgroup.centralizer (localNormalClosure : Set localSubgroup) ≤
      Subgroup.zpowers subgroupInvolution) :
    ∀ z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup), z ^ 2 = 1 := by
  intro z hz
  rw [localNormalClosure_centralizer_eq_zpowers_of_bounds hkernel hcenter] at hz
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
  rw [← zpow_natCast, ← zpow_mul, mul_comm k, zpow_mul, zpow_natCast,
    NormalClosureControl.involution_pow_two, one_zpow]

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
