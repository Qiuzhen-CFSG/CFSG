theorem checks032 (k : ℕ) (hlo : 32 ≤ k) (hhi : k < 48) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_032, dot_032⟩
  · exact ⟨transport_033, dot_033⟩
  · exact ⟨transport_034, dot_034⟩
  · exact ⟨transport_035, dot_035⟩
  · exact ⟨transport_036, dot_036⟩
  · exact ⟨transport_037, dot_037⟩
  · exact ⟨transport_038, dot_038⟩
  · exact ⟨transport_039, dot_039⟩
  · exact ⟨transport_040, dot_040⟩
  · exact ⟨transport_041, dot_041⟩
  · exact ⟨transport_042, dot_042⟩
  · exact ⟨transport_043, dot_043⟩
  · exact ⟨transport_044, dot_044⟩
  · exact ⟨transport_045, dot_045⟩
  · exact ⟨transport_046, dot_046⟩
  · exact ⟨transport_047, dot_047⟩

