module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.ImageBound.Orbit
public import Mathlib.LinearAlgebra.StdBasis

/-!
# The 693 binary vectors and their sum relation

The packed coordinate table is transcribed from `ImageBound/source/column.json`, computed
from the ATLAS matrices with the literal a acting on columns. The data below
are definitions, not assumptions. Kernel checks prove distinctness and spanning
and identify the packed sum relation with addition of binary vectors.
The two packed literals are reproduced by `OrbitBound/source/generate_tables.py`.
Twelve bits encode each coordinate vector; ten bits encode each inverse-table
vertex index. Packing keeps the kernel checks small.

This module does not identify these coordinates with the canonical homology
quotient. That separate identification must be supplied before using this graph
to bound the linear stabilizer of `distinguishedOrbit`.
-/

@[expose] public section
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.OrbitGeometry

/-- Boolean traversal of a finite coordinate type for kernel certificates. -/
def checkFin {n : ℕ} (f : Fin n → Bool) : Bool :=
  (List.range n).all (fun i => if h : i < n then f ⟨i, h⟩ else true)

/-- Soundness of the Boolean finite traversal. -/
theorem allFin {n : ℕ} (P : Fin n → Prop) [DecidablePred P]
    (h : checkFin (fun i => decide (P i)) = true) : ∀ i, P i := by
  intro i
  have hi := List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt)
  simpa only [dif_pos i.isLt, decide_eq_true_eq] using hi

/-- Two finite traversals, avoiding proof-valued enumeration in pairwise checks. -/
theorem allFin₂ {n m : ℕ} (P : Fin n → Fin m → Prop) [∀ i j, Decidable (P i j)]
    (h : checkFin (fun i => checkFin (fun j => decide (P i j))) = true) :
    ∀ i j, P i j := by
  intro i
  apply allFin
  have hi := List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt)
  simpa only [dif_pos i.isLt] using hi

abbrev CoordinateSpace := Fin 12 → ZMod 2
abbrev Vertex := Fin 693

/-- Bit i is coordinate i of a binary column. -/
def vectorOfCode (n : ℕ) : CoordinateSpace :=
  fun i => if n.testBit i.val then 1 else 0

/-- The sorted coordinate values in the source certificate. -/
def code (i : Vertex) : ℕ :=
  ( >>> (12 * i.val)) % 4096

/-- The complete coordinate table, in sorted order. -/
def codes : Array ℕ := Array.ofFn code

/-- The corresponding binary coordinate columns. -/
def vector (i : Vertex) : CoordinateSpace := vectorOfCode (code i)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
theorem code_lt (i : Vertex) : code i < 2 ^ 12 := by
  exact Nat.mod_lt _ (by decide)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
private theorem code_lt_succ : ∀ i : Fin 692, code i.castSucc < code i.succ := by
  apply allFin
  decide +kernel

theorem code_injective : Function.Injective code :=
  (Fin.strictMono_iff_lt_succ.mpr code_lt_succ).injective

theorem vectorOfCode_injective :
    Function.Injective (fun n : Fin (2 ^ 12) => vectorOfCode n.val) := by
  intro n m h
  apply Fin.ext
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < 12
  · have he := congrFun h ⟨i, hi⟩
    dsimp [vectorOfCode] at he
    cases hn : n.val.testBit i <;> cases hm : m.val.testBit i <;> simp_all
  · have hp : 2 ^ 12 ≤ 2 ^ i := Nat.pow_le_pow_right (by decide) (by omega)
    rw [Nat.testBit_lt_two_pow (n.isLt.trans_le hp),
      Nat.testBit_lt_two_pow (m.isLt.trans_le hp)]

set_option maxRecDepth 10000 in
theorem vector_injective : Function.Injective vector := by
  intro i j h
  apply code_injective
  exact congrArg Fin.val (vectorOfCode_injective (a₁ := ⟨code i, code_lt i⟩)
    (a₂ := ⟨code j, code_lt j⟩) h)

theorem vectorOfCode_xor (n m : ℕ) :
    vectorOfCode (n ^^^ m) = vectorOfCode n + vectorOfCode m := by
  ext i
  simp only [vectorOfCode, Nat.testBit_xor, Pi.add_apply]
  cases n.testBit i.val <;> cases m.testBit i.val <;> decide

/-- A packed membership table for the listed coordinate values. -/
def membershipMask : ℕ := 

/-- Packed inverse-table witness for membership; only its checked specification is used. -/
private def lookup (n : ℕ) : Vertex :=
  ⟨(( >>> (10 * n)) % 1024) % 693, Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem membership_check : ∀ n : Fin (2 ^ 12),
    membershipMask.testBit n.val = true ↔ code (lookup n.val) = n.val := by
  apply allFin
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
private theorem code_mem_check : ∀ i : Vertex,
    membershipMask.testBit (code i) = true := by
  apply allFin
  decide +kernel

theorem mem_mask_iff (n : ℕ) (hn : n < 2 ^ 12) :
    membershipMask.testBit n = true ↔ ∃ i : Vertex, code i = n := by
  constructor
  · intro h
    exact ⟨lookup n, (membership_check ⟨n, hn⟩).mp h⟩
  · rintro ⟨i, rfl⟩
    exact code_mem_check i

/-- Two listed columns are adjacent when their sum is listed again. -/
def Adj (i j : Vertex) : Prop :=
  membershipMask.testBit (code i ^^^ code j) = true

instance (i j : Vertex) : Decidable (Adj i j) :=
  inferInstanceAs (Decidable ((_ : Bool) = true))

theorem adj_iff (i j : Vertex) :
    Adj i j ↔ ∃ k : Vertex, vector k = vector i + vector j := by
  rw [Adj, mem_mask_iff _ (Nat.xor_lt_two_pow (code_lt i) (code_lt j))]
  constructor
  · rintro ⟨k, hk⟩
    exact ⟨k, by rw [vector, hk, vectorOfCode_xor]; rfl⟩
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    apply congrArg Fin.val (vectorOfCode_injective (a₁ := ⟨code k, code_lt k⟩)
      (a₂ := ⟨code i ^^^ code j, Nat.xor_lt_two_pow (code_lt i) (code_lt j)⟩) ?_)
    exact hk.trans (vectorOfCode_xor _ _).symm

theorem adj_symm (i j : Vertex) : Adj i j ↔ Adj j i := by
  rw [adj_iff, adj_iff, add_comm]

theorem not_adj_self (i : Vertex) : ¬ Adj i i := by
  simp only [Adj, Nat.xor_self]
  decide +kernel

/-- All permutations preserving the sum relation, with no generator restriction. -/
def preservingGroup : Subgroup (Equiv.Perm Vertex) where
  carrier := {σ | ∀ i j, Adj (σ i) (σ j) ↔ Adj i j}
  one_mem' := by intro i j; rfl
  mul_mem' := by
    intro σ τ hσ hτ i j
    exact (hσ (τ i) (τ j)).trans (hτ i j)
  inv_mem' := by
    intro σ hσ i j
    simpa using (hσ (σ⁻¹ i) (σ⁻¹ j)).symm

private def spanningWitness : Fin 12 → Finset Vertex := ![
  {1, 2},
  {0, 2, 4},
  {0, 1, 5},
  {0, 1, 2, 4, 5},
  {2, 4, 5},
  {0, 2, 5, 7},
  {0, 1, 2, 4, 5, 16},
  {21},
  {0, 1, 4, 41},
  {85},
  {1, 2, 4, 5, 181},
  {0, 2, 4, 341}
]

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
private theorem spanning_check : ∀ i : Fin 12,
    (Pi.single i 1 : CoordinateSpace) = ∑ j ∈ spanningWitness i, vector j := by
  apply allFin
  decide +kernel

/-- The listed vectors span all twelve coordinate directions. -/
theorem span_vectors : Submodule.span (ZMod 2) (Set.range vector) = ⊤ := by
  apply Submodule.eq_top_iff'.mpr
  intro v
  have hs (i : Fin 12) :
      (Pi.single i 1 : CoordinateSpace) ∈ Submodule.span (ZMod 2) (Set.range vector) := by
    rw [spanning_check]
    exact Submodule.sum_mem _ (fun j _ => Submodule.subset_span ⟨j, rfl⟩)
  rw [← Finset.univ_sum_single v]
  apply Submodule.sum_mem
  intro i _
  have he : (Pi.single i (v i) : CoordinateSpace) = v i • Pi.single i 1 := by
    ext j
    by_cases h : j = i <;> simp [h]
  rw [he]
  exact Submodule.smul_mem _ _ (hs i)

/-- The exact identification required to connect this finite geometry to the
actual local-subgroup orbit in the canonical homology quotient. -/
def IsOrbitCoordinates (e : NaturalHomology ≃ₗ[ZMod 2] CoordinateSpace) : Prop :=
  ∀ v : NaturalHomology, v ∈ distinguishedOrbit ↔ e v ∈ Set.range vector

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.OrbitGeometry
