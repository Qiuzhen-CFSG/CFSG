module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.Comparison.QuotientAction
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Max2Bridge
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.Comparison.CenterOrder.InvolutionCensus.Reduction
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.Comparison.CenterOrder.InvolutionCensus.CommutatorForm
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.NormalClosureControl.ActionKernel
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.NormalClosureControl.IntrinsicCenter

/-!
# The relative max2 involution census

Let H be the subgroup of the literal involution centralizer generated by the
certified max2 words and N its relative seed normal closure. Every element
of C_H(N) is either the identity or the distinguished central involution.

The certified conjugation-kernel bound puts every element of C_H(N) in N.
The independent intrinsic-center bound then puts it in the powers of the
distinguished involution, whose order is two. The two concrete bounds
discharge every premise of `localSeedCentralizer_cases_of_bounds`.

`localSeedCentralizer_involution_cases` retains the square-one hypothesis
needed by the center-order consumer. The stronger `localSeedCentralizer_cases`
also covers all other elements of the relative centralizer.

Source motivation: GLS3, Table 5.3i, printed p.270. No identification with
the source's two-core or full involution centralizer is assumed.
-/

public section

namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreComparison

open TwoCoreCentralizerData

/-- The full relative centralizer consists of the identity and the distinguished
involution. The kernel and intrinsic-center bounds are both discharged. -/
theorem localSeedCentralizer_cases (z : localSubgroup)
    (hz : z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup)) :
    z = 1 ∨ z = subgroupInvolution :=
  localSeedCentralizer_cases_of_bounds localNormalClosureAction_ker_le
    localNormalClosure_inf_centralizer_le_zpowers z hz

set_option linter.unusedVariables false in
/-- Every square-one element centralizing the seed normal closure is the
identity or the distinguished involution, in the actual generated subgroup.
The redundant square-one hypothesis is retained for the consumer's interface. -/
theorem localSeedCentralizer_involution_cases (z : localSubgroup)
    (hz : z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup))
    (hpow : z ^ 2 = 1) : z = 1 ∨ z = subgroupInvolution :=
  localSeedCentralizer_cases z hz

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreComparison
