theorem checks048 (k : ℕ) (hlo : 48 ≤ k) (hhi : k < 64) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_048, dot_048⟩
  · exact ⟨transport_049, dot_049⟩
  · exact ⟨transport_050, dot_050⟩
  · exact ⟨transport_051, dot_051⟩
  · exact ⟨transport_052, dot_052⟩
  · exact ⟨transport_053, dot_053⟩
  · exact ⟨transport_054, dot_054⟩
  · exact ⟨transport_055, dot_055⟩
  · exact ⟨transport_056, dot_056⟩
  · exact ⟨transport_057, dot_057⟩
  · exact ⟨transport_058, dot_058⟩
  · exact ⟨transport_059, dot_059⟩
  · exact ⟨transport_060, dot_060⟩
  · exact ⟨transport_061, dot_061⟩
  · exact ⟨transport_062, dot_062⟩
  · exact ⟨transport_063, dot_063⟩

