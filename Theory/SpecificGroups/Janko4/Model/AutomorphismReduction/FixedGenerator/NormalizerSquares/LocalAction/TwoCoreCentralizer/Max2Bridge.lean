module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCore
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Evaluations

/-!+# The second ATLAS local subgroup inside the literal involution centralizer

The matrix certificates put the conjugates of the `J4G1-max2W1` outputs
inside `involutionCentralizer`. The conjugating word takes `(XYXYY)^22`
to the literal first generator, so that generator belongs to the subgroup
generated by the conjugated outputs. Equality with the whole involution
centralizer and the structure of its two-core are separate obligations.

Source: online ATLAS, `J4G1-max2W1`, attributed in `Words`; GLS3,
Table 5.3i, printed p.270, motivates the expected local structure.
-/

@[expose] public section

namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData

/-- The explicit bridge sends the local word involution to the first generator. -/
theorem conjugates_t : h⁻¹ * t * h = a := by
  apply toMatrix_injective
  change toMatrix ta = toMatrix a
  rw [eval_ta, toMatrix_a]
  rfl

theorem cx_commute_a : cx * a = a * cx := by
  apply toMatrix_injective
  change toMatrix cxa = toMatrix acx
  rw [eval_cxa, eval_acx]
  rfl

theorem cy_commute_a : cy * a = a * cy := by
  apply toMatrix_injective
  change toMatrix cya = toMatrix acy
  rw [eval_cya, eval_acy]
  rfl

/-- First conjugated ATLAS output in the actual centralizer. -/
def localX : involutionCentralizer :=
  ⟨toAmbient cx, (mem_involutionCentralizer_iff _).mpr ⟨cx.property, by
    simpa only [map_mul, toAmbient_a] using congrArg toAmbient cx_commute_a⟩⟩

/-- Second conjugated ATLAS output in the actual centralizer. -/
def localY : involutionCentralizer :=
  ⟨toAmbient cy, (mem_involutionCentralizer_iff _).mpr ⟨cy.property, by
    simpa only [map_mul, toAmbient_a] using congrArg toAmbient cy_commute_a⟩⟩

/-- The subgroup generated by these two literal elements; full generation
of the involution centralizer is not assumed. -/
def localSubgroup : Subgroup involutionCentralizer :=
  Subgroup.closure {localX, localY}

theorem localX_mem : localX ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert _ _)

theorem localY_mem : localY ∈ localSubgroup :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

theorem local_word_eq_centralInvolution :
    (localX * localY * localX * localY * localY) ^ 22 = centralInvolution := by
  let f := MulAut.conj h⁻¹
  have hx : f w10 = cx := by simp only [f, MulAut.conj_apply, inv_inv]; rfl
  have hy : f w14 = cy := by simp only [f, MulAut.conj_apply, inv_inv]; rfl
  have ht : f t = a := by
    simpa only [f, MulAut.conj_apply, inv_inv] using conjugates_t
  have he : (cx * cy * cx * cy * cy) ^ 22 = a := by
    simpa only [t, xyxyy, xyxy, xyx, xy, map_pow, map_mul, hx, hy] using ht
  apply Subtype.ext
  change (toAmbient cx * toAmbient cy * toAmbient cx * toAmbient cy * toAmbient cy) ^ 22 =
    matrixUnitA
  simpa only [map_pow, map_mul, toAmbient_a] using congrArg toAmbient he

theorem centralInvolution_mem_localSubgroup : centralInvolution ∈ localSubgroup := by
  rw [← local_word_eq_centralInvolution]
  exact localSubgroup.pow_mem
    (localSubgroup.mul_mem
      (localSubgroup.mul_mem
        (localSubgroup.mul_mem
          (localSubgroup.mul_mem localX_mem localY_mem) localX_mem) localY_mem) localY_mem) 22

/-- The two generators in the carrier of the generated subgroup. -/
def subgroupX : localSubgroup := ⟨localX, localX_mem⟩
def subgroupY : localSubgroup := ⟨localY, localY_mem⟩

/-- A specific word whose normal closure is the candidate extraspecial subgroup. -/
def localSeed : localSubgroup :=
  (subgroupX * subgroupY * subgroupX * subgroupY * subgroupY) ^ 11

/-- Normal closure in the generated local subgroup, not in the ambient group.
Its two-group property and centralizer still require concrete proofs. -/
def localNormalClosure : Subgroup localSubgroup :=
  Subgroup.normalClosure {localSeed}

instance localNormalClosure_normal : localNormalClosure.Normal :=
  inferInstanceAs (Subgroup.normalClosure {localSeed}).Normal

theorem localSeed_mem_normalClosure : localSeed ∈ localNormalClosure :=
  Subgroup.subset_normalClosure (Set.mem_singleton _)

/-- The distinguished central involution, in this particular local subgroup. -/
def subgroupInvolution : localSubgroup :=
  ⟨centralInvolution, centralInvolution_mem_localSubgroup⟩

theorem localSeed_sq : localSeed ^ 2 = subgroupInvolution := by
  apply Subtype.ext
  change ((localX * localY * localX * localY * localY) ^ 11) ^ 2 = centralInvolution
  rw [← pow_mul]
  exact local_word_eq_centralInvolution

theorem subgroupInvolution_mem_normalClosure : subgroupInvolution ∈ localNormalClosure := by
  rw [← localSeed_sq]
  exact localNormalClosure.pow_mem localSeed_mem_normalClosure 2

theorem orderOf_subgroupInvolution : orderOf subgroupInvolution = 2 := by
  rw [← orderOf_injective localSubgroup.subtype Subtype.val_injective]
  exact orderOf_centralInvolution

/-- The normal-closure seed is an element of order four, with square the
certified central involution. Its conjugates still need a two-group proof. -/
theorem orderOf_localSeed : orderOf localSeed = 4 := by
  apply orderOf_eq_prime_pow (p := 2) (n := 1)
  · intro he
    have hi : subgroupInvolution = 1 := localSeed_sq.symm.trans he
    have hc := orderOf_subgroupInvolution
    rw [hi, orderOf_one] at hc
    exact (by decide : (1 : ℕ) ≠ 2) hc
  · have hi : subgroupInvolution ^ 2 = 1 := by
      simpa only [orderOf_subgroupInvolution] using pow_orderOf_eq_one subgroupInvolution
    rw [← localSeed_sq, ← pow_mul] at hi
    exact hi

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
