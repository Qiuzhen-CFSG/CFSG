/-!
# Ambient generator images of basis forms 456 through 479

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA0456 : ℕ := 

private def imageA0456 : ℕ := 

private def coefficientsA0456 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0456 :
    flatMatrix transposeA * flatMatrix (basisFlat 456) =
      flatMatrix middleA0456 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0456 :
    flatMatrix middleA0456 * flatMatrix ambientA =
      flatMatrix imageA0456 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0456 :
    combination coefficientsA0456 = imageA0456 := by decide +kernel

private theorem preservedA0456 :
    formPullback matrixUnitA (exteriorBasisForm 456) ∈ exteriorFormSpace := by
  rw [← basis_decode (456 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 456) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0456, rightA0456,
    ← reconstructA0456]
  exact combination_mem coefficientsA0456

