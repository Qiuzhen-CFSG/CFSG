def combination (c : ℕ) : ℕ :=
  xorList (List.ofFn (fun k : Fin 1221 =>
    if c.testBit k.val then basisFlat k.val else 0))

theorem combination_mem (c : ℕ) : flatMatrix (combination c) ∈ exteriorFormSpace := by
  apply flatMatrix_xorList_mem
  intro x hx
  obtain ⟨k, rfl⟩ := List.mem_ofFn.mp hx
  split
  · rw [basis_decode]
    exact exteriorBasisForm_mem k
  · rw [flatMatrix_zero]
    exact exteriorFormSpace.zero_mem

