theorem checks112 (k : ℕ) (hlo : 112 ≤ k) (hhi : k < 128) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_112, dot_112⟩
  · exact ⟨transport_113, dot_113⟩
  · exact ⟨transport_114, dot_114⟩
  · exact ⟨transport_115, dot_115⟩
  · exact ⟨transport_116, dot_116⟩
  · exact ⟨transport_117, dot_117⟩
  · exact ⟨transport_118, dot_118⟩
  · exact ⟨transport_119, dot_119⟩
  · exact ⟨transport_120, dot_120⟩
  · exact ⟨transport_121, dot_121⟩
  · exact ⟨transport_122, dot_122⟩
  · exact ⟨transport_123, dot_123⟩
  · exact ⟨transport_124, dot_124⟩
  · exact ⟨transport_125, dot_125⟩
  · exact ⟨transport_126, dot_126⟩
  · exact ⟨transport_127, dot_127⟩

