/-!
# Ambient generator images of basis forms 768 through 791

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA0768 : ℕ := 

private def imageA0768 : ℕ := 

private def coefficientsA0768 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0768 :
    flatMatrix transposeA * flatMatrix (basisFlat 768) =
      flatMatrix middleA0768 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0768 :
    flatMatrix middleA0768 * flatMatrix ambientA =
      flatMatrix imageA0768 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0768 :
    combination coefficientsA0768 = imageA0768 := by decide +kernel

private theorem preservedA0768 :
    formPullback matrixUnitA (exteriorBasisForm 768) ∈ exteriorFormSpace := by
  rw [← basis_decode (768 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 768) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0768, rightA0768,
    ← reconstructA0768]
  exact combination_mem coefficientsA0768

