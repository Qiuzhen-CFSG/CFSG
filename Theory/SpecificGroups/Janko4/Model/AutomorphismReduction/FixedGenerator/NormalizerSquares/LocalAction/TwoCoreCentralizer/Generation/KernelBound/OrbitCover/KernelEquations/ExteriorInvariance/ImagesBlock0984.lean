/-!
# Ambient generator images of basis forms 984 through 1007

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA0984 : ℕ := 

private def imageA0984 : ℕ := 

private def coefficientsA0984 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0984 :
    flatMatrix transposeA * flatMatrix (basisFlat 984) =
      flatMatrix middleA0984 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0984 :
    flatMatrix middleA0984 * flatMatrix ambientA =
      flatMatrix imageA0984 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0984 :
    combination coefficientsA0984 = imageA0984 := by decide +kernel

private theorem preservedA0984 :
    formPullback matrixUnitA (exteriorBasisForm 984) ∈ exteriorFormSpace := by
  rw [← basis_decode (984 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 984) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0984, rightA0984,
    ← reconstructA0984]
  exact combination_mem coefficientsA0984

