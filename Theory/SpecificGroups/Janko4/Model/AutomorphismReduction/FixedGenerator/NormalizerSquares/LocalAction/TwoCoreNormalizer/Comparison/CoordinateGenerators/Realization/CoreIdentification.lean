module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.Comparison.CoordinateGenerators.Realization.NormalClosure
public import Theory.ElementaryAbelian.ExtraspecialSuitableLift

/-!
# Identifying the seed normal closure with the literal two-core

Write H for the generated local subgroup, N for its seed normal closure,
and P = O₂(H). The actual quotient action is on N/⟨t⟩. The checked equality
Z(N) = ⟨t⟩ and extraspeciality show that an element of its kernel can be
multiplied by an element of N to centralize N.

The exponent-two hypothesis makes D = C_H(N) abelian. Since every element
of P has such an inner twist, D centralizes P. Thus the factor left by a
twist of an element of P lies in Z(P). Full local generation transports the
assumed order of Z(O₂(C)) to Z(P), which is consequently generated by t and
lies in N. This proves P = N and the requested equality inside C.

The general subgroup steps are kept abstract to avoid unfolding the concrete
matrix-group instances during elaboration. All four model hypotheses remain
explicit: quotient-kernel control, the center order, full local generation,
and the exponent of the relative centralizer.

Source motivation: GLS3, Table 5.3i, printed p.270, the 2A centralizer entry
in `refs/KGroup/GLS3/Chapter5(sec3-).tex`. The normal closure and quotient action
are the concrete constructions imported through `Realization.NormalClosure`.
-/

public section

open Subgroup
set_option maxRecDepth 4000
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreComparison.CoordinateGenerators.Realization
open TwoCoreCentralizerData

private theorem exists_inner_twist_mem_centralizer (g : localSubgroup)
    (hg : g ∈ OuterImageComparison.quotientAction.ker) :
    ∃ r : localNormalClosure,
      g * (r : localSubgroup) ∈ centralizer (localNormalClosure : Set localSubgroup) := by
  let : IsExtraspecial 2 localNormalClosure := normalClosure_extraspecial
  have hfix (z : localNormalClosure) (hz : z ∈ center localNormalClosure) :
      localNormalClosureAction g z = z := by
    rw [normalClosure_center] at hz
    obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hz
    rw [map_zpow, OuterImageComparison.action_centralWord]
  have hmod (n : localNormalClosure) (_hn : n ∈ (⊤ : Subgroup localNormalClosure)) :
      localNormalClosureAction g n * n⁻¹ ∈ center localNormalClosure := by
    rw [normalClosure_center]
    apply (QuotientGroup.eq_one_iff _).mp
    change OuterImageComparison.projection (localNormalClosureAction g n * n⁻¹) = 1
    rw [map_mul, map_inv, ← OuterImageComparison.quotientAction_projection]
    rw [show OuterImageComparison.quotientAction g = 1 from hg]
    exact mul_inv_cancel _
  obtain ⟨r, hr⟩ := extraspecial_two_exists_inner_twist_fixing_subgroup
    (⊤ : Subgroup localNormalClosure) le_top (localNormalClosureAction g) hfix hmod
  refine ⟨r, ?_⟩
  rw [← localNormalClosureAction_ker]
  apply MulEquiv.ext
  intro n
  have h := congrArg (fun v : localNormalClosure => (v : localSubgroup))
    (hr n (mem_top n))
  apply Subtype.ext
  change (g * (r : localSubgroup)) * (n : localSubgroup) *
      (g * (r : localSubgroup))⁻¹ = n
  change g * ((r : localSubgroup) * (n : localSubgroup) * (r : localSubgroup)⁻¹) * g⁻¹ = n at h
  simpa only [mul_inv_rev, mul_assoc] using h

private theorem subgroup_commutes_of_pow_two {G : Type*} [Group G]
    (D : Subgroup G) (hpow : ∀ z ∈ D, z ^ 2 = 1)
    {x y : G} (hx : x ∈ D) (hy : y ∈ D) : Commute x y := by
  have hp (d : D) : orderOf d ∣ 2 := by
    apply orderOf_dvd_iff_pow_eq_one.mpr
    exact Subtype.ext (hpow d d.property)
  exact congrArg Subtype.val (Commute.of_orderOf_dvd_two hp (⟨x, hx⟩ : D) ⟨y, hy⟩)

private theorem core_center_card_congr {G K : Type*} [Group G] [Group K]
    (e : G ≃* K) :
    Nat.card (center (pCore 2 G)) = Nat.card (center (pCore 2 K)) := by
  let eP : pCore 2 G ≃* pCore 2 K :=
    (e.subgroupMap (pCore 2 G)).trans (MulEquiv.subgroupCongr (pCore_map_iso 2 e))
  exact Nat.card_congr (Subgroup.centerCongr eP).toEquiv

private theorem center_image_le_of_card_two {G : Type*} [Group G]
    (N P : Subgroup G) [Finite P] (hNP : N ≤ P)
    (t : G) (htN : t ∈ N) (htZ : t ∈ center G) (ht2 : orderOf t = 2)
    (hc : Nat.card (center P) = 2) : (center P).map P.subtype ≤ N := by
  let tP : P := ⟨t, hNP htN⟩
  have htPZ : tP ∈ center P := by
    apply mem_center_iff.mpr
    intro x
    exact Subtype.ext (mem_center_iff.mp htZ x)
  have horder : orderOf tP = 2 := by
    rw [← orderOf_injective P.subtype Subtype.val_injective]
    exact ht2
  have hZ : center P = zpowers tP := by
    apply Eq.symm
    apply eq_of_le_of_card_ge (zpowers_le.mpr htPZ)
    rw [hc, Nat.card_zpowers, horder]
  rw [hZ]
  rintro x ⟨z, hz, rfl⟩
  obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hz
  exact N.zpow_mem htN k

private theorem le_of_twists_center {G : Type*} [Group G]
    (N P : Subgroup G) (hNP : N ≤ P)
    (hcenter : (center P).map P.subtype ≤ N)
    (hpow : ∀ z ∈ centralizer (N : Set G), z ^ 2 = 1)
    (htwist : ∀ x ∈ P, ∃ r : N, x * (r : G) ∈ centralizer (N : Set G)) :
    P ≤ N := by
  intro x hx
  obtain ⟨r, hr⟩ := htwist x hx
  have hdP : x * (r : G) ∈ P := P.mul_mem hx (hNP r.property)
  have hdZ : (⟨x * (r : G), hdP⟩ : P) ∈ center P := by
    apply mem_center_iff.mpr
    intro y
    obtain ⟨s, hs⟩ := htwist y y.property
    have hds : Commute (x * (r : G)) (s : G) :=
      (mem_centralizer_iff.mp hr s s.property).symm
    have hdy : Commute (x * (r : G)) ((y : G) * (s : G)) :=
      subgroup_commutes_of_pow_two (centralizer (N : Set G)) hpow hr hs
    apply Subtype.ext
    change (y : G) * (x * (r : G)) = (x * (r : G)) * (y : G)
    simpa only [mul_inv_cancel_right] using (hdy.mul_right hds.inv_right).symm.eq
  have hdN : x * (r : G) ∈ N := hcenter (mem_map.mpr ⟨⟨_, hdP⟩, hdZ, rfl⟩)
  simpa only [mul_inv_cancel_right] using N.mul_mem hdN (N.inv_mem r.property)

private theorem image_eq_core_of_twists {C : Type*} [Group C] [Finite C]
    (H : Subgroup C) (N : Subgroup H)
    (hNP : N ≤ pCore 2 H) (t : H) (htN : t ∈ N)
    (htZ : t ∈ center H) (ht2 : orderOf t = 2)
    (hcenter : Nat.card (center (pCore 2 C)) = 2) (hgen : H = ⊤)
    (hpow : ∀ z ∈ centralizer (N : Set H), z ^ 2 = 1)
    (htwist : ∀ x ∈ pCore 2 H, ∃ r : N,
      x * (r : H) ∈ centralizer (N : Set H)) :
    N.map H.subtype = pCore 2 C := by
  let P := pCore 2 H
  let e : H ≃* C := (MulEquiv.subgroupCongr hgen).trans Subgroup.topEquiv
  have hc : Nat.card (center P) = 2 := (core_center_card_congr e).trans hcenter
  have hZ : (center P).map P.subtype ≤ N :=
    center_image_le_of_card_two N P hNP t htN htZ ht2 hc
  have hPN : P ≤ N := le_of_twists_center N P hNP hZ hpow htwist
  have he : e.toMonoidHom = H.subtype := rfl
  have hmap := pCore_map_iso 2 e
  change P.map e.toMonoidHom = pCore 2 C at hmap
  rw [he, le_antisymm hPN hNP] at hmap
  exact hmap

/-- Quotient-kernel control and the stated center and centralizer hypotheses
identify the actual seed normal closure with the literal involution two-core. -/
theorem normalClosureImage_eq_twoCore_of_quotient_kernel
    (hkernel : pCore 2 localSubgroup ≤ OuterImageComparison.quotientAction.ker)
    (hcenter : Nat.card (center involutionTwoCore) = 2)
    (hgen : localSubgroup = ⊤)
    (hpow : ∀ z ∈ centralizer (localNormalClosure : Set localSubgroup), z ^ 2 = 1) :
    localNormalClosure.map localSubgroup.subtype = involutionTwoCore := by
  exact image_eq_core_of_twists localSubgroup localNormalClosure
    (le_sSup ⟨localNormalClosure_normal, localNormalClosure_isPGroup⟩)
    subgroupInvolution subgroupInvolution_mem_normalClosure NormalClosureControl.involution_mem_center
    orderOf_subgroupInvolution hcenter hgen hpow
    (fun x hx => exists_inner_twist_mem_centralizer x (hkernel hx))
end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreComparison.CoordinateGenerators.Realization
