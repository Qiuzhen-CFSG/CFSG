private theorem context_valid :
    Valid context level3Subgroup (PresentedGroup.of : Fin 2 → Level3)
      (definitions.repr PresentedGroup.of) := by
  apply definitions.valid
  · intro a ha
    exact Bool.noConfusion ha
  · intro r
    dsimp only [relatorWords]
    split
    · exact level3_relator _
    · exact eval_nil _

private theorem seed_valid : ∀ n, n < 0 →
