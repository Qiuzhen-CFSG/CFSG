theorem checks064 (k : ℕ) (hlo : 64 ≤ k) (hhi : k < 80) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_064, dot_064⟩
  · exact ⟨transport_065, dot_065⟩
  · exact ⟨transport_066, dot_066⟩
  · exact ⟨transport_067, dot_067⟩
  · exact ⟨transport_068, dot_068⟩
  · exact ⟨transport_069, dot_069⟩
  · exact ⟨transport_070, dot_070⟩
  · exact ⟨transport_071, dot_071⟩
  · exact ⟨transport_072, dot_072⟩
  · exact ⟨transport_073, dot_073⟩
  · exact ⟨transport_074, dot_074⟩
  · exact ⟨transport_075, dot_075⟩
  · exact ⟨transport_076, dot_076⟩
  · exact ⟨transport_077, dot_077⟩
  · exact ⟨transport_078, dot_078⟩
  · exact ⟨transport_079, dot_079⟩

