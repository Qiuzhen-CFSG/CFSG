def factorRows (n : Fin 13) : Vector ℕ 112 :=
  Vector.ofFn (fun k => entry n.val k.val)

def fastRow (x : ℕ) (n : Fin 13) : ℕ :=
  xorList (List.ofFn (fun k : Fin 112 =>
    if x.testBit k.val then entry n.val k.val else 0))

theorem fastRow_eq (x : ℕ) (n : Fin 13) :
    fastRow x n = packedRow x (factorRows n) := by
  simp only [fastRow, packedRow, factorRows, get_ofFn]

