/-!
# Multiplication and masking for the packed tensor checks

A block of 64 input bits is copied at spacing 124 and masked at spacing 125.
At each surviving position there is exactly one input bit, so two such blocks
expand all 128 bits used by `spreadFast 16`. The proof checks the two literal
masks and proves equality with the existing recurrence for every natural input.
This speeds up the unconditional output checks without changing their contract.

Source and ATLAS conventions: `../../../../source/README.md` and
`../source/README.md`. The mask construction was developed in the preserved
`Scratch/J4ContractionChecks` experiment of workspace
`8b4b787179434a40bdb57e3a54e35f3b`; every identity is proved below.
-/

@[expose] public section
open Janko4.GeneratorCertificates
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.PolynomialCertificate.PullbackCoefficients.PackedTable.ContractionChecks

def copies : ℕ → ℕ → ℕ
  | 0, _ => 0
  | n+1, x => 2^124 * copies n x + x

theorem testBit_spread125 (n x a b : ℕ) (hb : b < 125) :
    (spread 125 n x).testBit (125*a+b) =
      (decide (a < n) && decide (b = 0) && x.testBit a) := by
  induction n generalizing x a with
  | zero => simp [spread]
  | succ n ih =>
    rw [spread]
    have hlo : (if x.testBit 0 then 1 else 0) < 2^125 := by split <;> decide
    rw [Nat.testBit_two_pow_mul_add _ hlo]
    cases a with
    | zero =>
      simp only [Nat.mul_zero, Nat.zero_add, hb, if_true, Nat.zero_lt_succ,
        decide_true, Bool.true_and]
      cases h : x.testBit 0
      · simp
      · simp only [Bool.and_true, if_true]
        change (2^0 : ℕ).testBit b = decide (b = 0)
        simp only [Nat.testBit_two_pow, eq_comm]
    | succ a =>
      have hge : ¬125*(a+1)+b < 125 := by omega
      have hsub : 125*(a+1)+b-125 = 125*a+b := by omega
      simp only [hge, if_false, hsub, ih (x >>> 1) a, Nat.testBit_shiftRight]
      simp only [Nat.add_comm 1, Nat.succ_lt_succ_iff]

theorem testBit_copies (n x a b : ℕ) (hx : x < 2^124) (hb : b < 124) :
    (copies n x).testBit (124*a+b) = (decide (a < n) && x.testBit b) := by
  induction n generalizing a with
  | zero => simp [copies]
  | succ n ih =>
    rw [copies, Nat.testBit_two_pow_mul_add _ hx]
    cases a with
    | zero => simp [hb]
    | succ a =>
      have hge : ¬124*(a+1)+b < 124 := by omega
      have hsub : 124*(a+1)+b-124 = 124*a+b := by omega
      simp only [hge, if_false, hsub, ih, Nat.succ_lt_succ_iff]

theorem copies_mul (n x : ℕ) : x * copies n 1 = copies n x := by
  induction n with
  | zero => simp [copies]
  | succ n ih => simp only [copies, Nat.mul_add, Nat.mul_one, ← ih]; ring

theorem spread64_mul_mask (x : ℕ) :
    spread 125 64 x =
      ((x % 2^64) * copies 64 1) &&& spread 125 64 (2^64-1) := by
  apply Nat.eq_of_testBit_eq
  intro j
  let a := j / 125
  let b := j % 125
  have hb : b < 125 := Nat.mod_lt _ (by decide)
  have hj : j = 125*a+b := (Nat.div_add_mod j 125).symm
  rw [hj, Nat.testBit_and, testBit_spread125 _ _ _ _ hb,
    testBit_spread125 _ _ _ _ hb, copies_mul]
  by_cases ha : a < 64
  · simp only [ha, decide_true, Bool.true_and]
    by_cases hb0 : b = 0
    · simp only [hb0, decide_true, Bool.true_and, Nat.add_zero]
      have he : 125*a = 124*a+a := by omega
      rw [he, testBit_copies _ _ _ _ (by omega) (by omega)]
      simp only [ha, decide_true, Bool.true_and, Nat.testBit_mod_two_pow]
      have ht : (2^64-1).testBit a = true := by
        rw [Nat.testBit_two_pow_sub_one]
        simp [ha]
      simp only [ht, Bool.and_true]
    · simp [hb0]
  · simp [ha]
def copyMask : ℕ := 
def selectMask : ℕ := 

def spreadWide (x : ℕ) : ℕ :=
  ((x % 2^64 * copyMask) &&& selectMask) +
    2^8000 * ((((x >>> 64) % 2^64) * copyMask) &&& selectMask)

set_option exponentiation.threshold 10000 in
set_option maxRecDepth 10000 in
theorem spreadWide_eq (x : ℕ) : spreadFast 16 x = spreadWide x := by
  have hr : copies 64 1 = copyMask := by decide +kernel
  have hm : spread 125 64 (2^64-1) = selectMask := by decide +kernel
  rw [spreadFast_eq]
  change spread 125 (64+64) x = _
  have h1 := spread64_mul_mask x
  have h2 := spread64_mul_mask (x >>> 64)
  rw [hr, hm] at h1 h2
  rw [spread_add, h1, h2]
  rfl

def tensorWide (xs ys : Vector ℕ 50) : ℕ :=
  xorList (List.ofFn (fun k : Fin 50 =>
    spreadWide (xs.get k) * (ys.get k % 2^125)))

theorem tensorWide_eq (xs ys : Vector ℕ 50) : tensorFast xs ys = tensorWide xs ys := by
  simp only [tensorFast, outerFast, spreadWide_eq, tensorWide]

def contractWide (w : ℕ) (C D : ColumnCoefficients) (rev : Bool) : ℕ :=
  xorList (List.ofFn (fun u : Fin 50 =>
    xorList (List.ofFn (fun v : Fin 50 =>
      if (weightRow w u).testBit v.val then
        if u < v then
          if rev then tensorWide (D.get v) (C.get u)
          else tensorWide (C.get u) (D.get v)
        else 0
      else 0))))

theorem contractWide_eq (w : ℕ) (C D : ColumnCoefficients) (rev : Bool) :
    contract w (rawBlockFast C D rev) = contractWide w C D rev := by
  simp only [contract, rowProduct, rawBlockFast, get_ofFn, tensorWide_eq, contractWide]

