/-- Decode successive rows of lengths n,n-1,...,1. -/
def symmetricPositionAux : ℕ → ℕ → ℕ × ℕ
  | 0, k => (0, k)
  | n + 1, k => if k < n + 1 then (0, k) else
      let p := symmetricPositionAux n (k - (n + 1))
      (p.1 + 1, p.2 + 1)

def symmetricPositions (k : Fin 1275) : Fin 50 × Fin 50 :=
  let p := symmetricPositionAux 50 k.val
  (⟨p.1 % 50, Nat.mod_lt _ (by decide)⟩, ⟨p.2 % 50, Nat.mod_lt _ (by decide)⟩)

/-- The lexicographic upper-triangle index, including the diagonal.
The harmless modulus makes this definition total; both inverse equations
are checked in Parameters. -/
def symmetricEntry (i j : Fin 50) : Fin 1275 :=
  ⟨((min i j).val * (101 - (min i j).val) / 2 +
      ((max i j).val - (min i j).val)) % 1275, Nat.mod_lt _ (by decide)⟩

abbrev Parameter := Fin 1275 → ZMod 2

def symmetricMatrix (x : Parameter) : RestrictionMatrix :=
  fun i j => x (symmetricEntry i j)

def parametersOf (M : RestrictionMatrix) : Parameter :=
  fun k => M (symmetricPositions k).1 (symmetricPositions k).2

def shearOfParameter (x : Parameter) : RestrictionMatrix :=
  pairingInverse * symmetricMatrix x

def testEffect (t : Fin 2) (x : Parameter) : RestrictionMatrix :=
  (shearOfParameter x)ᵀ * testIU t + (testIU t)ᵀ * shearOfParameter x


