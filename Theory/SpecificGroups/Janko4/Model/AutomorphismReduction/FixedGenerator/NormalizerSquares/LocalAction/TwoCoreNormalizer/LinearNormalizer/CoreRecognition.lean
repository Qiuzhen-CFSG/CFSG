/-!
# Recognition of the explicit binary perfect core

The literal commutator subgroup of the specified binary matrix group is
generated by CD and D² and is perfect. Its action on the 22 endpoint stars of
the 231 scalar lines has image equal to the existing concrete Mathieu group
M₂₂. Projective rigidity identifies its kernel with its three-element center,
so the first isomorphism theorem gives the actual central-quotient equivalence.

All construction and rigidity inputs are discharged below. The original ATLAS
matrices and attribution are retained in `../LinearModel/source/`; the finite
projective witnesses and action conventions are recorded in
`CoreRecognition/source/README.md`.
-/

@[expose] public section
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel

/-- The two even words also generate the core as an internal group. -/
theorem coreGenerators_closure_eq_top :
    Subgroup.closure {coreGeneratorA, coreGeneratorB} = ⊤ := by
  apply Subgroup.map_injective derivedGroup.subtype_injective
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  simp only [Set.image_insert_eq, Set.image_singleton]
  change Subgroup.closure {coreA, coreB} = derivedGroup
  exact derivedGroup_eq_closure.symm

/-- Matching the two generator images already determines the full range. -/
theorem coreAction_range_eq_M22 (f : derivedGroup →* Equiv.Perm (Fin 22))
    (ha : f coreGeneratorA = corePermA) (hb : f coreGeneratorB = corePermB) :
    f.range = Sporadic.Mathieu.M22 := by
  rw [MonoidHom.range_eq_map, ← coreGenerators_closure_eq_top, MonoidHom.map_closure,
    Set.image_insert_eq, Set.image_singleton, ha, hb, corePerm_closure_eq_M22]

/-- The projective rigidity input identifies the exact action kernel. -/
theorem coreAction_ker_eq_center (f : derivedGroup →* Equiv.Perm (Fin 22))
    (hfix : ∀ x : derivedGroup, f x = 1 ↔ FixesCoreLines (x : Matrix12ˣ))
    (hrigid : ∀ u : Matrix12ˣ, Commute (u : Matrix12) matrixJ → FixesCoreLines u →
      u = 1 ∨ u = scalarUnit ∨ u = scalarUnit ^ 2) :
    f.ker = Subgroup.center derivedGroup := by
  apply le_antisymm
  · intro x hx
    have hline := (hfix x).mp (MonoidHom.mem_ker.mp hx)
    apply (mem_center_derivedGroup_iff x).mpr
    rcases hrigid x (derivedGroup_commute_matrixJ x) hline with h | h | h
    · exact Or.inl (Subtype.ext h)
    · exact Or.inr (Or.inl (Subtype.ext h))
    · exact Or.inr (Or.inr (Subtype.ext h))
  · rw [center_derivedGroup_eq_zpowers]
    apply Subgroup.zpowers_le.mpr
    exact MonoidHom.mem_ker.mpr ((hfix coreScalar).mpr scalarUnit_fixesCoreLines)

/-- Conditional assembly of the actual central-quotient equivalence.

The action and the projective rigidity statement are separate construction
obligations; no recognition conclusion is an input to this reduction. -/
noncomputable def derivedQuotientEquivM22_of_action
    (f : derivedGroup →* Equiv.Perm (Fin 22))
    (ha : f coreGeneratorA = corePermA) (hb : f coreGeneratorB = corePermB)
    (hfix : ∀ x : derivedGroup, f x = 1 ↔ FixesCoreLines (x : Matrix12ˣ))
    (hrigid : ∀ u : Matrix12ˣ, Commute (u : Matrix12) matrixJ → FixesCoreLines u →
      u = 1 ∨ u = scalarUnit ∨ u = scalarUnit ^ 2) :
    derivedGroup ⧸ Subgroup.center derivedGroup ≃* Sporadic.Mathieu.M22 :=
  (QuotientGroup.quotientMulEquivOfEq (coreAction_ker_eq_center f hfix hrigid).symm).trans
    ((QuotientGroup.quotientKerEquivRange f).trans
      (MulEquiv.subgroupCongr (coreAction_range_eq_M22 f ha hb)))

/-- The constructed projective action has exactly the concrete Mathieu group as image. -/
theorem corePermutationAction_range_eq_M22 :
    corePermutationAction.range = Sporadic.Mathieu.M22 :=
  coreAction_range_eq_M22 corePermutationAction
    corePermutationAction_coreGeneratorA corePermutationAction_coreGeneratorB

/-- The constructed projective action has exactly the core's center as kernel. -/
theorem corePermutationAction_ker_eq_center :
    corePermutationAction.ker = Subgroup.center derivedGroup :=
  coreAction_ker_eq_center corePermutationAction
    corePermutationAction_eq_one_iff projective_fixed_units

/-- The central quotient of the literal perfect matrix core is the concrete M₂₂. -/
noncomputable def derivedQuotientEquivM22 :
    derivedGroup ⧸ Subgroup.center derivedGroup ≃* Sporadic.Mathieu.M22 :=
  derivedQuotientEquivM22_of_action corePermutationAction
    corePermutationAction_coreGeneratorA corePermutationAction_coreGeneratorB
    corePermutationAction_eq_one_iff projective_fixed_units

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel
