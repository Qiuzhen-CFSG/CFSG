theorem checks000 (k : ℕ) (hlo : 0 ≤ k) (hhi : k < 16) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_000, dot_000⟩
  · exact ⟨transport_001, dot_001⟩
  · exact ⟨transport_002, dot_002⟩
  · exact ⟨transport_003, dot_003⟩
  · exact ⟨transport_004, dot_004⟩
  · exact ⟨transport_005, dot_005⟩
  · exact ⟨transport_006, dot_006⟩
  · exact ⟨transport_007, dot_007⟩
  · exact ⟨transport_008, dot_008⟩
  · exact ⟨transport_009, dot_009⟩
  · exact ⟨transport_010, dot_010⟩
  · exact ⟨transport_011, dot_011⟩
  · exact ⟨transport_012, dot_012⟩
  · exact ⟨transport_013, dot_013⟩
  · exact ⟨transport_014, dot_014⟩
  · exact ⟨transport_015, dot_015⟩

