private def middleA0648 : ℕ := 

private def imageA0648 : ℕ := 

private def coefficientsA0648 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0648 :
    flatMatrix transposeA * flatMatrix (basisFlat 648) =
      flatMatrix middleA0648 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0648 :
    flatMatrix middleA0648 * flatMatrix ambientA =
      flatMatrix imageA0648 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0648 :
    combination coefficientsA0648 = imageA0648 := by decide +kernel

private theorem preservedA0648 :
    formPullback matrixUnitA (exteriorBasisForm 648) ∈ exteriorFormSpace := by
  rw [← basis_decode (648 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 648) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0648, rightA0648,
    ← reconstructA0648]
  exact combination_mem coefficientsA0648

