/-!
# Ambient generator images of basis forms 288 through 311

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA0288 : ℕ := 

private def imageA0288 : ℕ := 

private def coefficientsA0288 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0288 :
    flatMatrix transposeA * flatMatrix (basisFlat 288) =
      flatMatrix middleA0288 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0288 :
    flatMatrix middleA0288 * flatMatrix ambientA =
      flatMatrix imageA0288 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0288 :
    combination coefficientsA0288 = imageA0288 := by decide +kernel

private theorem preservedA0288 :
    formPullback matrixUnitA (exteriorBasisForm 288) ∈ exteriorFormSpace := by
  rw [← basis_decode (288 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 288) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0288, rightA0288,
    ← reconstructA0288]
  exact combination_mem coefficientsA0288

