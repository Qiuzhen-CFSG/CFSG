/-- Row-major packed matrix, with 50 bits in each of its 50 rows. -/
def affineDirection (k : Fin 124) : Matrix (Fin 50) (Fin 50) (ZMod 2) :=
  fun i j => if (affineDirectionRows.get k).testBit (50 * i.val + j.val) then 1 else 0

/-- The linear span of the displayed directions, without group-theoretic assumptions. -/
def affineDirections : Submodule (ZMod 2) (Matrix (Fin 50) (Fin 50) (ZMod 2)) :=
  Submodule.span (ZMod 2) (Set.range affineDirection)

/-- An intermediate restriction to be established from the original invariants. -/
def AffineRestriction (g : BinaryMatrixˣ) : Prop :=
  restrictionMatrix g - 1 ∈ affineDirections

