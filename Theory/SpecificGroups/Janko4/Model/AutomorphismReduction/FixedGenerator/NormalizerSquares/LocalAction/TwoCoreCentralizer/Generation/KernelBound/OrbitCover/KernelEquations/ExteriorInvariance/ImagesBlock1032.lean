module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.KernelBound.OrbitCover.KernelEquations.ExteriorInvariance.Basis

/-!
# Ambient generator images of basis forms 1032 through 1055

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA1032 : ℕ := 

private def imageA1032 : ℕ := 

private def coefficientsA1032 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA1032 :
    flatMatrix transposeA * flatMatrix (basisFlat 1032) =
      flatMatrix middleA1032 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA1032 :
    flatMatrix middleA1032 * flatMatrix ambientA =
      flatMatrix imageA1032 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA1032 :
    combination coefficientsA1032 = imageA1032 := by decide +kernel

private theorem preservedA1032 :
    formPullback matrixUnitA (exteriorBasisForm 1032) ∈ exteriorFormSpace := by
  rw [← basis_decode (1032 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 1032) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA1032, rightA1032,
    ← reconstructA1032]
  exact combination_mem coefficientsA1032

