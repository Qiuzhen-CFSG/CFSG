module
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.LinearNormalizer.Core
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.LinearNormalizer.Centralizer
public import Mathlib.GroupTheory.IsPerfect
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.Data.Int.GCD
public import Mathlib.Tactic.Group


/-!
# Generation, perfectness, and center of the binary even-word core

The literal commutator subgroup of the ATLAS matrix group is generated by
`A = CD` and `B = D²`: conjugation by `C` preserves their closure and the
remaining quotient is cyclic. The certified relations of orders 11, 2, 11,
and 12 then kill both generators in its abelianization. The previously
computed matrix commutant identifies its center with the three scalar units.

These are intrinsic facts about the specified matrices, without a recognition
assumption. The original ATLAS data and attribution are retained in
`../../LinearModel/source/`; `../Centralizer.lean` supplies the scalar certificate.
-/

@[expose] public section
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel

private theorem c_inv : unitC⁻¹ = unitC := by apply Units.ext; rfl

private theorem c_mul_c : unitC * unitC = 1 := by
  simpa only [pow_two] using unitC_pow_two

theorem coreB_pow_two : coreB ^ 2 = 1 := by
  simpa only [coreB, ← pow_mul] using unitD_pow_four

theorem unitC_conj_coreA : unitC * coreA * unitC⁻¹ = coreB * coreA⁻¹ := by
  simp only [coreA, coreB, pow_two, mul_inv_rev, c_inv]
  simp only [← mul_assoc, c_mul_c, one_mul, mul_inv_cancel_right]

theorem unitC_conj_coreB : unitC * coreB * unitC⁻¹ = coreA * coreB * coreA⁻¹ := by
  simp only [coreA, coreB, pow_two, mul_inv_rev]
  group

private theorem d_eq_ca : unitD = unitC * coreA := by
  simp only [coreA, ← mul_assoc, c_mul_c, one_mul]

private abbrev L : Subgroup Matrix12ˣ := Subgroup.closure {coreA, coreB}
private theorem a_mem : coreA ∈ L := Subgroup.subset_closure (Or.inl rfl)
private theorem b_mem : coreB ∈ L := Subgroup.subset_closure (Or.inr rfl)
private theorem l_le_derived : L ≤ derivedGroup := by
  apply (Subgroup.closure_le _).mpr
  rintro x (rfl | rfl)
  · exact coreA_mem_derivedGroup
  · exact coreB_mem_derivedGroup

private theorem involution_normalizes_closure {G : Type*} [Group G]
    (c : G) (s : Set G) (hc : c * c = 1)
    (hs : ∀ x ∈ s, c * x * c⁻¹ ∈ Subgroup.closure s) :
    c ∈ Subgroup.normalizer (Subgroup.closure s : Set G) := by
  let K := Subgroup.closure s
  have h : K ≤ K.comap (MulAut.conj c).toMonoidHom :=
    (Subgroup.closure_le _).mpr hs
  apply Subgroup.mem_normalizer_iff.mpr
  intro x
  constructor
  · exact fun hx => h hx
  · intro hx
    have hh := h hx
    change c * (c * x * c⁻¹) * c⁻¹ ∈ K at hh
    have he : c * (c * x * c⁻¹) * c⁻¹ = x := by
      calc
        _ = (c * c) * x * (c * c)⁻¹ := by group
        _ = x := by rw [hc, one_mul, inv_one, mul_one]
    rwa [he] at hh

private theorem c_normalizes : unitC ∈ Subgroup.normalizer (L : Set Matrix12ˣ) := by
  apply involution_normalizes_closure unitC _ c_mul_c
  rintro x (rfl | rfl)
  · rw [unitC_conj_coreA]
    exact L.mul_mem b_mem (L.inv_mem a_mem)
  · rw [unitC_conj_coreB]
    exact L.mul_mem (L.mul_mem a_mem b_mem) (L.inv_mem a_mem)

private theorem action_normalizes : actionGroup ≤ (Subgroup.normalizer L) := by
  apply (Subgroup.closure_le _).mpr
  rintro x (rfl | rfl)
  · exact c_normalizes
  · have h : unitC * coreA ∈ Subgroup.normalizer (L : Set Matrix12ˣ) :=
      (Subgroup.normalizer (L : Set Matrix12ˣ)).mul_mem c_normalizes (L.le_normalizer a_mem)
    exact d_eq_ca.symm ▸ h

/-- The actual derived subgroup is generated by the two even words. -/
theorem derivedGroup_eq_closure : derivedGroup = Subgroup.closure {coreA, coreB} := by
  apply le_antisymm _ l_le_derived
  let N := L.subgroupOf actionGroup
  have : N.Normal := Subgroup.normal_subgroupOf_of_le_normalizer action_normalizes
  let c : actionGroup := ⟨unitC, unitC_mem_actionGroup⟩
  have hsup : N ⊔ Subgroup.zpowers c = ⊤ := by
    apply top_unique
    intro x _
    have hh : actionGroup ≤ (N ⊔ Subgroup.zpowers c).map actionGroup.subtype := by
      apply (Subgroup.closure_le _).mpr
      rintro y (rfl | rfl)
      · exact Subgroup.mem_map.mpr ⟨c, Subgroup.mem_sup_right (Subgroup.mem_zpowers c), rfl⟩
      · let a : actionGroup := ⟨coreA, derivedGroup_le_actionGroup coreA_mem_derivedGroup⟩
        exact Subgroup.mem_map.mpr ⟨c * a,
          (N ⊔ Subgroup.zpowers c).mul_mem
            (Subgroup.mem_sup_right (Subgroup.mem_zpowers c)) (Subgroup.mem_sup_left (show a ∈ N from a_mem)), d_eq_ca.symm⟩
    obtain ⟨y, hy, hxy⟩ := Subgroup.mem_map.mp (hh x.property)
    exact (Subtype.ext hxy : y = x) ▸ hy
  have hc : _root_.commutator actionGroup ≤ N :=
    Subgroup.Normal.commutator_le_of_self_sup_commutative_eq_top hsup inferInstance
  rw [derivedGroup, ← Subgroup.map_subtype_commutator]
  exact (Subgroup.map_mono hc).trans_eq
    (Subgroup.map_subgroupOf_eq_of_le (l_le_derived.trans derivedGroup_le_actionGroup))

/-- The product relation follows by conjugating the inverse of A. -/
theorem coreAB_pow_eleven : (coreA * coreB) ^ 11 = 1 := by
  have h : coreA * coreB = unitC * coreA⁻¹ * unitC⁻¹ := by
    have h3 : unitD * unitD ^ 2 = unitD⁻¹ := by
      apply eq_inv_of_mul_eq_one_right
      calc
        unitD * (unitD * unitD ^ 2) = unitD ^ 4 := by group
        _ = 1 := unitD_pow_four
    simp only [coreA, coreB, mul_inv_rev, c_inv]
    rw [mul_assoc, h3]
    simp only [mul_assoc, c_mul_c, mul_one]
  rw [h, conj_pow, inv_pow, coreA_pow_eleven, inv_one, mul_one, mul_inv_cancel]

/-- The scalar word of order three supplies the remaining perfectness relation. -/
theorem coreAAB_pow_twelve : (coreA ^ 2 * coreB) ^ 12 = 1 := by
  simpa only [scalarUnit, pow_two, ← pow_mul] using scalarUnit_pow_three

/-- The first even word inside the actual derived subgroup. -/
def coreGeneratorA : derivedGroup := ⟨coreA, coreA_mem_derivedGroup⟩
/-- The second even word inside the actual derived subgroup. -/
def coreGeneratorB : derivedGroup := ⟨coreB, coreB_mem_derivedGroup⟩

private theorem abelianization_generators :
    Abelianization.of coreGeneratorA = 1 ∧ Abelianization.of coreGeneratorB = 1 := by
  let f : derivedGroup →* Abelianization derivedGroup := Abelianization.of
  have ha : f coreGeneratorA ^ 11 = 1 := by rw [← map_pow, show coreGeneratorA ^ 11 = 1 from Subtype.ext coreA_pow_eleven, map_one]
  have hb : f coreGeneratorB ^ 2 = 1 := by rw [← map_pow, show coreGeneratorB ^ 2 = 1 from Subtype.ext coreB_pow_two, map_one]
  have hab : (f coreGeneratorA * f coreGeneratorB) ^ 11 = 1 := by
    rw [← map_mul, ← map_pow, show (coreGeneratorA * coreGeneratorB) ^ 11 = 1 from Subtype.ext coreAB_pow_eleven, map_one]
  have hb11 : f coreGeneratorB ^ 11 = 1 := by simpa only [mul_pow, ha, one_mul] using hab
  have hb1 : f coreGeneratorB = 1 := (pow_eq_one_iff_of_coprime (by decide : Nat.Coprime 2 11)).mp ⟨hb, hb11⟩
  have hab12 : (f coreGeneratorA ^ 2 * f coreGeneratorB) ^ 12 = 1 := by
    rw [← map_pow, ← map_mul, ← map_pow,
      show (coreGeneratorA ^ 2 * coreGeneratorB) ^ 12 = 1 from Subtype.ext coreAAB_pow_twelve, map_one]
  have ha24 : f coreGeneratorA ^ 24 = 1 := by simpa only [hb1, mul_one, ← pow_mul] using hab12
  exact ⟨(pow_eq_one_iff_of_coprime (by decide : Nat.Coprime 11 24)).mp ⟨ha, ha24⟩, hb1⟩

/-- The even-word core has trivial abelianization. -/
instance derivedGroup_isPerfect : Group.IsPerfect derivedGroup := by
  apply Subgroup.isPerfect_iff.mpr
  apply le_antisymm (Subgroup.commutator_le_self _)
  conv_lhs => rw [derivedGroup_eq_closure]
  apply (Subgroup.closure_le _).mpr
  rintro x (rfl | rfl)
  · rw [← Subgroup.map_subtype_commutator]
    refine Subgroup.mem_map.mpr ⟨coreGeneratorA, ?_, rfl⟩
    rw [← Abelianization.ker_of]
    exact abelianization_generators.1
  · rw [← Subgroup.map_subtype_commutator]
    refine Subgroup.mem_map.mpr ⟨coreGeneratorB, ?_, rfl⟩
    rw [← Abelianization.ker_of]
    exact abelianization_generators.2


/-- The scalar word, regarded as an element of the actual derived subgroup. -/
def coreScalar : derivedGroup := ⟨scalarUnit, scalarUnit_mem_derivedGroup⟩

theorem coe_coreScalar : (coreScalar : Matrix12ˣ) = scalarUnit := rfl

theorem coreScalar_pow_three : coreScalar ^ 3 = 1 :=
  Subtype.ext scalarUnit_pow_three

theorem coreScalar_ne_one : coreScalar ≠ 1 := by
  intro h
  have he := congrArg (fun x : derivedGroup => (x : Matrix12ˣ)) h
  rw [coe_coreScalar, Subgroup.coe_one] at he
  exact scalarUnit_ne_one he

private theorem scalar_commutes_A : Commute scalarUnit coreA := by
  apply Units.ext
  change (scalarUnit : Matrix12) * (coreA : Matrix12) =
    (coreA : Matrix12) * (scalarUnit : Matrix12)
  rw [coe_scalarUnit, coe_coreA]
  exact ((Commute.one_left matrixA).add_left matrixJ_commute_A).eq

private theorem scalar_commutes_B : Commute scalarUnit coreB := by
  apply Units.ext
  change (scalarUnit : Matrix12) * (coreB : Matrix12) =
    (coreB : Matrix12) * (scalarUnit : Matrix12)
  rw [coe_scalarUnit, coe_coreB]
  exact ((Commute.one_left matrixB).add_left matrixJ_commute_B).eq

/-- The certified scalar really is central in the perfect core. -/
theorem coreScalar_mem_center : coreScalar ∈ Subgroup.center derivedGroup := by
  have h : derivedGroup ≤ Subgroup.centralizer {scalarUnit} := by
    rw [derivedGroup_eq_closure, Subgroup.closure_le]
    rintro x (rfl | rfl)
    · exact Subgroup.mem_centralizer_iff.mpr (by
        intro y hy
        rcases Set.mem_singleton_iff.mp hy with rfl
        exact scalar_commutes_A.eq)
    · exact Subgroup.mem_centralizer_iff.mpr (by
        intro y hy
        rcases Set.mem_singleton_iff.mp hy with rfl
        exact scalar_commutes_B.eq)
  apply Subgroup.mem_center_iff.mpr
  intro x
  apply Subtype.ext
  exact ((Subgroup.mem_centralizer_iff.mp (h x.property)) scalarUnit (Set.mem_singleton _)).symm

/-- No additional central elements exist: the matrix commutant has only three units. -/
theorem mem_center_derivedGroup_iff (x : derivedGroup) :
    x ∈ Subgroup.center derivedGroup ↔ x = 1 ∨ x = coreScalar ∨ x = coreScalar ^ 2 := by
  constructor
  · intro hx
    have hA : Commute ((x : Matrix12ˣ) : Matrix12) matrixA := by
      change ((x : Matrix12ˣ) : Matrix12) * matrixA = matrixA * (x : Matrix12ˣ)
      have he := congrArg (fun v : derivedGroup => ((v : Matrix12ˣ) : Matrix12))
        (Subgroup.mem_center_iff.mp hx coreGeneratorA)
      change (coreA : Matrix12) * (x : Matrix12ˣ) = (x : Matrix12ˣ) * (coreA : Matrix12) at he
      simpa only [coe_coreA] using he.symm
    have hB : Commute ((x : Matrix12ˣ) : Matrix12) matrixB := by
      change ((x : Matrix12ˣ) : Matrix12) * matrixB = matrixB * (x : Matrix12ˣ)
      have he := congrArg (fun v : derivedGroup => ((v : Matrix12ˣ) : Matrix12))
        (Subgroup.mem_center_iff.mp hx coreGeneratorB)
      change (coreB : Matrix12) * (x : Matrix12ˣ) = (x : Matrix12ˣ) * (coreB : Matrix12) at he
      simpa only [coe_coreB] using he.symm
    rcases commuting_matrix_cases hA hB with he | he | he | he
    · exact False.elim (Units.ne_zero (x : Matrix12ˣ) he)
    · exact Or.inl (Subtype.ext (Units.ext he))
    · exact Or.inr (Or.inr (Subtype.ext (Units.ext (he.trans coe_scalarUnit_sq.symm))))
    · exact Or.inr (Or.inl (Subtype.ext (Units.ext (he.trans coe_scalarUnit.symm))))
  · rintro (rfl | rfl | rfl)
    · exact (Subgroup.center derivedGroup).one_mem
    · exact coreScalar_mem_center
    · exact (Subgroup.center derivedGroup).pow_mem coreScalar_mem_center 2

/-- The exact center of the literal derived subgroup. -/
theorem center_derivedGroup_eq_zpowers :
    Subgroup.center derivedGroup = Subgroup.zpowers coreScalar := by
  apply le_antisymm
  · intro x hx
    rcases (mem_center_derivedGroup_iff x).mp hx with rfl | rfl | rfl
    · exact (Subgroup.zpowers coreScalar).one_mem
    · exact Subgroup.mem_zpowers coreScalar
    · exact (Subgroup.zpowers coreScalar).pow_mem (Subgroup.mem_zpowers coreScalar) 2
  · exact Subgroup.zpowers_le.mpr coreScalar_mem_center

/-- Every element of the core is linear for the scalar operator J. -/
theorem derivedGroup_commute_matrixJ (x : derivedGroup) :
    Commute ((x : Matrix12ˣ) : Matrix12) matrixJ := by
  change ((x : Matrix12ˣ) : Matrix12) * matrixJ = matrixJ * (x : Matrix12ˣ)
  have hz := (Subgroup.center derivedGroup).pow_mem coreScalar_mem_center 2
  have he := congrArg (fun v : derivedGroup => ((v : Matrix12ˣ) : Matrix12))
    (Subgroup.mem_center_iff.mp hz x)
  change ((x : Matrix12ˣ) : Matrix12) * ((scalarUnit ^ 2 : Matrix12ˣ) : Matrix12) =
    ((scalarUnit ^ 2 : Matrix12ˣ) : Matrix12) * (x : Matrix12ˣ) at he
  rwa [coe_scalarUnit_sq] at he

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel
