/-- A row decoder in the 50-dimensional coordinate module. -/
def decodeRestrictionRows (rows : Vector ℕ 50) : RestrictionMatrix :=
  fun i j => if (rows.get i).testBit j.val then 1 else 0

/-- Embed the proposed displacement coordinates in the original column module. -/
def restrictionEmbedding : Matrix (Fin 112) (Fin 50) (ZMod 2) :=
  fun i j => binaryColumn (restrictionColumns.get j) i

/-- The displayed dual coordinate extractor. -/
def restrictionExtraction : Matrix (Fin 50) (Fin 112) (ZMod 2) :=
  fun i j => binaryColumn (restrictionDualRows.get i) j

/-- Chosen lifts of the displacement columns. -/
def restrictionLifts : Matrix (Fin 112) (Fin 50) (ZMod 2) :=
  fun i j => binaryColumn (restrictionLiftColumns.get j) i

/-- The candidate displacement pairing, in the displayed coordinates. -/
def restrictionPairing : RestrictionMatrix := decodeRestrictionRows restrictionPairingRows

/-- The matrix extracted from an ambient matrix, without a preservation assertion. -/
def restrictionMatrix (g : BinaryMatrix) : RestrictionMatrix :=
  restrictionExtraction * g * restrictionEmbedding

/-- Restrict an ambient bilinear form to the displayed columns. -/
def restrictionForm (R : BinaryMatrix) : RestrictionMatrix :=
  restrictionEmbeddingᵀ * R * restrictionEmbedding

/-- Restrictions of the original 1221 exterior forms; no new ambient invariant. -/
def restrictionExteriorSpace : Submodule (ZMod 2) RestrictionMatrix :=
  Submodule.span (ZMod 2) (Set.range (fun i : Fin 1221 => restrictionForm (exteriorBasisForm i)))

/-- The first nine exterior forms suffice in the proposed finite certificate. -/
def restrictionTestForm (i : Fin 9) : RestrictionMatrix :=
  restrictionForm (exteriorBasisForm ⟨i.val, by omega⟩)

/-- The original column represented by the zeroth column of a restricted matrix. -/
def restrictionImage (S : RestrictionMatrix) : NaturalModule :=
  restrictionEmbedding *ᵥ (S *ᵥ Pi.single 0 1)

