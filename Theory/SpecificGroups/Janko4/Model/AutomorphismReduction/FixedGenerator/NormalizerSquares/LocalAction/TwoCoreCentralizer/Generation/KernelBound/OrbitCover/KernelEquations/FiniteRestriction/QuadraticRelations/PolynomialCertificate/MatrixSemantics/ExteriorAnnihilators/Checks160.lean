theorem checks160 (k : ℕ) (hlo : 160 ≤ k) (hhi : k < 176) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_160, dot_160⟩
  · exact ⟨transport_161, dot_161⟩
  · exact ⟨transport_162, dot_162⟩
  · exact ⟨transport_163, dot_163⟩
  · exact ⟨transport_164, dot_164⟩
  · exact ⟨transport_165, dot_165⟩
  · exact ⟨transport_166, dot_166⟩
  · exact ⟨transport_167, dot_167⟩
  · exact ⟨transport_168, dot_168⟩
  · exact ⟨transport_169, dot_169⟩
  · exact ⟨transport_170, dot_170⟩
  · exact ⟨transport_171, dot_171⟩
  · exact ⟨transport_172, dot_172⟩
  · exact ⟨transport_173, dot_173⟩
  · exact ⟨transport_174, dot_174⟩
  · exact ⟨transport_175, dot_175⟩

