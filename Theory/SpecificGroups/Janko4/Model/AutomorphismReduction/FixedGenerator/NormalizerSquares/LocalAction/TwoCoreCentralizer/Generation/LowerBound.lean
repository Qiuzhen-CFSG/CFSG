/-!
# Assembly of the source max2 subgroup lower bound

The certified row-subquotient homomorphism kills the seed, so the 8192
distinct prescribed products lie in its kernel. Its image contains the
explicit quotient subgroup, whose three certified orbit trees give order
at least 2016 * 165 * 8 = 2661120. The kernel--image cardinality formula
therefore gives 21799895040 as an unconditional lower bound for the literal
closure of the original ATLAS outputs `w10` and `w14`.

Source: the unchanged ATLAS `TwoCoreCentralizer/source/J4G1-max2W1`;
GLS3, Table 5.3i, printed p.270, motivates 21799895040.
-/

public section
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData

/-- The three concrete certificates needed for the original word subgroup's order bound. -/
theorem sourceSubgroup_card_ge_of_quotient_certificates
    (hinj : Function.Injective LowerBound.kernelProduct)
    (hquot : 2661120 ≤ Nat.card LowerBound.quotientSubgroup)
    (f : sourceSubgroup →* LowerBound.QuotientMatrixˣ)
    (hx : f LowerBound.sourceX = LowerBound.quotientX)
    (hy : f LowerBound.sourceY = LowerBound.quotientY) :
    21799895040 ≤ Nat.card sourceSubgroup := by
  have hk : 8192 ≤ Nat.card f.ker :=
    LowerBound.kernel_card_ge_of_injective hinj f
      (LowerBound.map_sourceSeed_eq_one f hx hy)
  have hi : 2661120 ≤ Nat.card f.range := hquot.trans
    (Subgroup.card_le_of_le (LowerBound.quotientSubgroup_le_range f hx hy))
  rw [← f.ker.card_mul_index, Subgroup.index_ker]
  exact Nat.mul_le_mul hk hi

/-- The subgroup generated by the original ATLAS max2 outputs has at least
21799895040 elements. All kernel and quotient certificates are discharged. -/
theorem sourceSubgroup_card_ge : 21799895040 ≤ Nat.card sourceSubgroup :=
  sourceSubgroup_card_ge_of_quotient_certificates
    LowerBound.kernelProduct_injective LowerBound.quotientSubgroup_card_ge
    LowerBound.quotientMap LowerBound.quotientMap_sourceX LowerBound.quotientMap_sourceY

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
