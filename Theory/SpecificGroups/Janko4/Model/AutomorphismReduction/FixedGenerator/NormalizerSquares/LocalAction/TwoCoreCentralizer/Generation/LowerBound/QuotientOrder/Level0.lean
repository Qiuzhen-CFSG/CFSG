module

import Mathlib.Tactic.FinCases
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.LowerBound.QuotientOrder.Generators

/-!
# Certified right-row orbit tree of length 2016

The packed points have a checked left inverse, so they are distinct.
Table entries are extracted from natural-number bit fields; the finite checks
use a natural-number loop to avoid dependent enumeration overhead.
Every non-root point has a smaller parent and is its parent's right product
by a generator in the required stabilizer. The general tree lemma therefore
gives 2016 distinct cosets. See `source/README.md` and `source/generate.py`.
-/

set_option maxRecDepth 100000

@[expose] public section
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.LowerBound.QuotientOrderCertificate

private theorem forall_fin_of_range {n : ℕ} [NeZero n]
    (P : Fin n → Prop) [DecidablePred P]
    (h : (List.range n).all (fun i => decide (P (Fin.ofNat n i))) = true) : ∀ i, P i := by
  intro i
  have hi := of_decide_eq_true (List.all_eq_true.mp h i.val (List.mem_range.mpr i.isLt))
  simpa only [Fin.ofNat_val_eq_self] using hi

private def pointTable : ℕ := 

private def parentTable : ℕ := 

private def letterTable : ℕ := 

private def indexTable : ℕ := 

private def code (i : Fin 2016) : BitVec 12 :=
  BitVec.ofNat 12 (pointTable >>> (12 * i.val))
private def point (i : Fin 2016) : Row := row (code i)
private def parent (i : Fin 2016) : Fin 2016 :=
  Fin.ofNat 2016 ((parentTable >>> (11 * i.val)) % 2048)
private def letter (i : Fin 2016) : Fin 3 :=
  Fin.ofNat 3 ((letterTable >>> (2 * i.val)) % 4)
private def index (v : BitVec 12) : Fin 2016 :=
  Fin.ofNat 2016 ((indexTable >>> (11 * v.toNat)) % 2048)

private theorem parent_lt : ∀ i, i ≠ 0 → parent i < i := by
  apply forall_fin_of_range
  decide +kernel

private theorem edge : ∀ i, i ≠ 0 →
    right (point (parent i)) (gen0 (letter i)) = point i := by
  have h : ∀ i, i ≠ 0 →
      packedRow (code (parent i)).toNat (genRows0 (letter i)) =
        (code i).toNat := by
    apply forall_fin_of_range
    decide +kernel
  intro i hi
  change Matrix.vecMul (row (code (parent i))) (gen0 (letter i)).val =
    row (code i)
  rw [gen0_val]
  exact vecMul_eq_of_packed _ _ _ (h i hi)

private theorem point_injective : Function.Injective point := by
  have h : Function.LeftInverse index code := by
    apply forall_fin_of_range
    decide +kernel
  exact row_injective.comp h.injective

theorem level0_bound : 2016 * Nat.card firstStabilizer ≤ Nat.card quotientSubgroup := by
  apply tree_card_mul_le quotientSubgroup firstStabilizer inf_le_left gen0 gen0_mem
    point parent letter parent_lt edge point_injective
  intro g
  exact g.property.2

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.LowerBound.QuotientOrderCertificate
