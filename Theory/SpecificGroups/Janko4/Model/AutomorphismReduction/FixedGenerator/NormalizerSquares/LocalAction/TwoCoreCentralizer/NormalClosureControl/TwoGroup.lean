module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.NormalClosureControl.Structure
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.NormalClosureControl.Certificates.Relations

/-!
# The max2 seed normal closure is a two-group

The certified conjugation tables make the span of the thirteen words normal
inside the subgroup generated by the two max2 outputs. Each word belongs to
the seed normal closure, and the span contains the seed, so these subgroups
coincide. The certified commutators and conjugacy-derived squares show that
the quotient by the distinguished central involution has exponent two.
Consequently the seed normal closure has exponent dividing four.

All normality and centralizers here are relative to `localSubgroup`. No
identification with the whole involution centralizer, no count of normal
forms, and no faithfulness assertion about the twelve-dimensional quotient
is used. Source motivation: GLS3 Table 5.3i, printed p.270; the concrete ATLAS
word and matrix provenance is documented in `TwoCoreCentralizer.Words`.
-/

public section

namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData

open NormalClosureControl

/-- The finite word family generates precisely the published relative normal closure. -/
theorem localNormalClosure_eq_span : localNormalClosure = span := by
  symm
  apply span_eq_normalClosure
  · intro i
    rw [basis_action_x]
    exact maskProduct_mem span basis
      (fun j => Subgroup.subset_closure (Set.mem_range_self j)) _
  · intro i
    rw [basis_action_y]
    exact maskProduct_mem span basis
      (fun j => Subgroup.subset_closure (Set.mem_range_self j)) _

/-- Every element of the relative seed normal closure has fourth power one. -/
theorem localNormalClosure_pow_four (z : localSubgroup) (hz : z ∈ localNormalClosure) :
    z ^ 4 = 1 := by
  rw [localNormalClosure_eq_span] at hz
  exact closure_pow_four subgroupInvolution basis involution_mem_center
    involution_pow_two basis_square basis_commutator hz

/-- The normal closure is a two-group, without assuming the ATLAS local shape. -/
theorem localNormalClosure_isPGroup : IsPGroup 2 localNormalClosure := by
  intro z
  refine ⟨2, ?_⟩
  apply Subtype.ext
  exact localNormalClosure_pow_four z z.property

/-- Centralizing the normal closure is equivalent to commuting with its thirteen
certified generators. This retains the relative ambient group `localSubgroup`. -/
theorem mem_localNormalClosure_centralizer_iff (z : localSubgroup) :
    z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup) ↔
      ∀ i, basis i * z = z * basis i := by
  rw [localNormalClosure_eq_span]
  change z ∈ Subgroup.centralizer
    (Subgroup.closure (Set.range basis) : Set localSubgroup) ↔ _
  rw [Subgroup.centralizer_closure]
  constructor
  · intro hz i
    exact hz (basis i) (Set.mem_range_self i)
  · intro hz g hg
    obtain ⟨i, rfl⟩ := hg
    exact hz i

/-- The distinguished involution and all its powers centralize the normal closure. -/
theorem zpowers_involution_le_localNormalClosure_centralizer :
    Subgroup.zpowers subgroupInvolution ≤
      Subgroup.centralizer (localNormalClosure : Set localSubgroup) := by
  apply Subgroup.zpowers_le.mpr
  exact (Subgroup.center_le_centralizer _) involution_mem_center

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
