theorem checks224 (k : ℕ) (hlo : 224 ≤ k) (hhi : k < 237) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_224, dot_224⟩
  · exact ⟨transport_225, dot_225⟩
  · exact ⟨transport_226, dot_226⟩
  · exact ⟨transport_227, dot_227⟩
  · exact ⟨transport_228, dot_228⟩
  · exact ⟨transport_229, dot_229⟩
  · exact ⟨transport_230, dot_230⟩
  · exact ⟨transport_231, dot_231⟩
  · exact ⟨transport_232, dot_232⟩
  · exact ⟨transport_233, dot_233⟩
  · exact ⟨transport_234, dot_234⟩
  · exact ⟨transport_235, dot_235⟩
  · exact ⟨transport_236, dot_236⟩

