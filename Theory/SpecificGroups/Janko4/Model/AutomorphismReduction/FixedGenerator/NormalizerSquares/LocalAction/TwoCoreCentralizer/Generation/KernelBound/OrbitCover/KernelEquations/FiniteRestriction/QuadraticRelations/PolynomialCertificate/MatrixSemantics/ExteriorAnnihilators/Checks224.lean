private theorem transport_224 : ∀ i : Fin 112,
    transportRow (weights.get 224) i = flatRow (duals.get 224) i.val := by
  change ∀ i : Fin 112, transportRow  i = flatRow  i.val
  decide +kernel

set_option maxRecDepth 10000 in
private theorem dot_224 : ∀ a : Fin 1221,
    flatDot (duals.get 224) (basisFlat a.val) = false := by
  change ∀ a : Fin 1221, flatDot  (basisFlat a.val) = false
  decide +kernel

