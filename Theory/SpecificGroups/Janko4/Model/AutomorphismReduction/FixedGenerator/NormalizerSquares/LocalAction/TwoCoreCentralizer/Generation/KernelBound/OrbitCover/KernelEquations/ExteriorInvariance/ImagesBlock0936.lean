private def coefficientsA0936 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0936 :
    flatMatrix transposeA * flatMatrix (basisFlat 936) =
      flatMatrix middleA0936 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0936 :
    flatMatrix middleA0936 * flatMatrix ambientA =
      flatMatrix imageA0936 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0936 :
    combination coefficientsA0936 = imageA0936 := by decide +kernel

private theorem preservedA0936 :
    formPullback matrixUnitA (exteriorBasisForm 936) ∈ exteriorFormSpace := by
  rw [← basis_decode (936 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 936) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0936, rightA0936,
    ← reconstructA0936]
  exact combination_mem coefficientsA0936

