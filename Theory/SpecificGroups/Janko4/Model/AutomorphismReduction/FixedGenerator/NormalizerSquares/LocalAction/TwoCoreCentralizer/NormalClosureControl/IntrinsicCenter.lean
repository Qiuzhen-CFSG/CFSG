module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.NormalClosureControl.TwoGroup
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.NormalClosureControl.IntrinsicCenter.Pairing

/-!
# The intrinsic center of the max2 seed normal closure

Write an element of the relative normal closure as a binary product of the
thirteen certified generators times a power of the distinguished central
involution. If it centralizes the normal closure, its binary product does too.
The certified nondegenerate commutator pairing kills coordinates 1 through 12,
leaving only the central involution.

All subgroups and centralizers are relative to `localSubgroup`. This is the
intrinsic-center part of the local structure motivated by GLS3, Table 5.3i,
printed p.270. The full relative centralizer and identification with the source
local group are separate assertions.
-/

public section

namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
open NormalClosureControl NormalClosureControl.IntrinsicCenter
open Janko4.Cardinality.KernelCount

/-- The intrinsic center of the relative seed normal closure is contained in the
cyclic subgroup generated by the distinguished involution. -/
theorem localNormalClosure_inf_centralizer_le_zpowers : localNormalClosure ⊓ Subgroup.centralizer (localNormalClosure : Set localSubgroup) ≤
    Subgroup.zpowers subgroupInvolution := by
  intro g hg
  obtain ⟨v, hv⟩ := exists_binary_mod_center g hg.1
  have hp : binaryProduct basis v ∈
      Subgroup.centralizer (localNormalClosure : Set localSubgroup) := by
    have hr := zpowers_involution_le_localNormalClosure_centralizer hv
    have hm := (Subgroup.centralizer (localNormalClosure : Set localSubgroup)).mul_mem
      hg.2 ((Subgroup.centralizer (localNormalClosure : Set localSubgroup)).inv_mem hr)
    simpa only [mul_inv_rev, inv_inv, mul_inv_cancel_left] using hm
  have hne : subgroupInvolution ≠ 1 := by
    intro he
    have ho := orderOf_subgroupInvolution
    rw [he, orderOf_one] at ho
    exact (by decide : (1 : ℕ) ≠ 2) ho
  have hzero : ∀ i, pairing v (commutatorForm i) = false := by
    intro i
    have hc := (mem_localNormalClosure_centralizer_iff _).mp hp i
    have ht := binaryProduct_twist basis v (commutatorForm i) (basis i)
      subgroupInvolution involution_mem_center involution_pow_two (basis_twist i)
    rw [← hc] at ht
    have hb : bit subgroupInvolution (pairing v (commutatorForm i)) = 1 := by
      apply mul_left_cancel (a := basis i * binaryProduct basis v)
      simpa only [mul_one] using ht.symm
    cases he : pairing v (commutatorForm i) with
    | false => rfl
    | true => exact (hne (by simpa only [he, bit, Bool.true_eq, if_true] using hb)).elim
  have hr := radical v hzero
  have hprod : binaryProduct basis v = bit subgroupInvolution (v 0) := by
    have htail : (fun i : Fin 12 => v i.succ) = fun _ => false := by
      funext i
      exact hr i.succ (Fin.succ_ne_zero i)
    rw [binaryProduct_succ, htail, binaryProduct_zero, mul_one]
    rfl
  have hmem : binaryProduct basis v ∈ Subgroup.zpowers subgroupInvolution := by
    rw [hprod]
    unfold bit
    split_ifs
    · exact Subgroup.mem_zpowers _
    · exact (Subgroup.zpowers _).one_mem
  have hm := (Subgroup.zpowers subgroupInvolution).mul_mem hmem hv
  simpa only [mul_inv_cancel_left] using hm
end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData
