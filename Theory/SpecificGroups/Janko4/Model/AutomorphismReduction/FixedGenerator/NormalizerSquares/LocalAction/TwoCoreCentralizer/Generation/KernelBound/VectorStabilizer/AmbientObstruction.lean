module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.KernelBound.VectorAction

/-!
# An obstruction to an ambient proof of the J₄ vector-stabilizer bound

Write N = a - 1 and v = N e₀ in the published column convention. The map
T(w) = (N w)₀ v satisfies T² = NT = TN = 0. Hence 1 + T is an invertible
matrix commuting with a and fixing ker N pointwise. In particular it satisfies
the linear conditions characterizing the homology kernel and fixes v.

The literal entries v₀ = 1, v₁ = 0 and a₁₁ = 0 distinguish this matrix from
both 1 and a. Thus these linear conditions alone do not imply the proposed
stabilizer bound. No membership in the subgroup generated by a and b is
asserted, and this is not a counterexample to the bound in that subgroup.

The matrix data and bit convention come from the ATLAS representation recorded
in `Model.Data`. GLS3, Table 5.3i, printed p.270, motivates the centralizer
bound but does not identify this homology quotient or its vector stabilizer.
-/

public section
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound

attribute [local irreducible] naturalAction

private theorem baseVector_zero : (baseVector : NaturalModule) 0 = 1 := by
  change displacement (Pi.single 0 1) 0 = 1
  rw [displacement_apply, Pi.sub_apply, Matrix.mulVec_single_one]
  decide +kernel

private theorem baseVector_one : (baseVector : NaturalModule) 1 = 0 := by
  change displacement (Pi.single 0 1) 1 = 0
  rw [displacement_apply, Pi.sub_apply, Matrix.mulVec_single_one]
  decide +kernel

private def shearDisplacement : Module.End (ZMod 2) NaturalModule where
  toFun v := (displacement v 0) • (baseVector : NaturalModule)
  map_add' v w := by simp only [map_add, Pi.add_apply, add_smul]
  map_smul' r v := by
    simp only [map_smul, Pi.smul_apply, smul_smul, smul_eq_mul, RingHom.id_apply]

private theorem baseVector_fixed : displacement (baseVector : NaturalModule) = 0 :=
  baseVector.property

private theorem shearDisplacement_sq : shearDisplacement * shearDisplacement = 0 := by
  apply LinearMap.ext
  intro v
  funext i
  change displacement ((displacement v 0) • (baseVector : NaturalModule)) 0 *
    (baseVector : NaturalModule) i = 0
  rw [map_smul, baseVector_fixed, smul_zero]
  exact zero_mul _

private theorem shearDisplacement_mul_displacement : shearDisplacement * displacement = 0 := by
  apply LinearMap.ext
  intro v
  change (displacement (displacement v) 0) • (baseVector : NaturalModule) = 0
  have h := LinearMap.congr_fun displacement_sq v
  change displacement (displacement v) = 0 at h
  rw [h]
  exact zero_smul _ _

private theorem displacement_mul_shearDisplacement : displacement * shearDisplacement = 0 := by
  apply LinearMap.ext
  intro v
  change displacement ((displacement v 0) • (baseVector : NaturalModule)) = 0
  rw [map_smul, baseVector_fixed, smul_zero]

private theorem one_add_shearDisplacement_sq :
    (1 + shearDisplacement) * (1 + shearDisplacement) = 1 := by
  rw [add_mul, mul_add, mul_add, one_mul, one_mul, mul_one, shearDisplacement_sq,
    add_zero, add_assoc]
  have h : shearDisplacement + shearDisplacement = 0 := by
    apply LinearMap.ext
    intro v
    funext i
    exact CharTwo.add_self_eq_zero _
  rw [h, add_zero]

private def shearMatrix : BinaryMatrix := Matrix.toLinAlgEquiv'.symm (1 + shearDisplacement)

private theorem shearMatrix_sq : shearMatrix * shearMatrix = 1 := by
  apply Matrix.toLinAlgEquiv'.injective
  rw [map_mul, map_one]
  simpa only [shearMatrix, AlgEquiv.apply_symm_apply] using one_add_shearDisplacement_sq

private def ambientShear : BinaryMatrixˣ := ⟨shearMatrix, shearMatrix, shearMatrix_sq, shearMatrix_sq⟩

private theorem shearMatrix_mulVec (v : NaturalModule) :
    Matrix.mulVec shearMatrix v = v + (displacement v 0) • (baseVector : NaturalModule) := by
  change (Matrix.toLinAlgEquiv' shearMatrix) v = _
  rw [shearMatrix, AlgEquiv.apply_symm_apply]
  rfl

private theorem ambientShear_fixes (v : fixedVectors) :
    Matrix.mulVec (ambientShear : BinaryMatrix) (v : NaturalModule) = v := by
  rw [show (ambientShear : BinaryMatrix) = shearMatrix from rfl, shearMatrix_mulVec]
  have hv : displacement (v : NaturalModule) = 0 := v.property
  rw [hv]
  simp only [Pi.zero_apply, zero_smul, add_zero]

private theorem ambientShear_commutes : ambientShear * matrixUnitA = matrixUnitA * ambientShear := by
  have ha : Matrix.toLinAlgEquiv' matrixA = 1 + displacement := by
    apply LinearMap.ext
    intro v
    change Matrix.mulVec matrixA v = v + displacement v
    rw [displacement_apply]
    abel
  apply Units.ext
  change shearMatrix * matrixA = matrixA * shearMatrix
  apply Matrix.toLinAlgEquiv'.injective
  rw [map_mul, map_mul, ha]
  simp only [shearMatrix, AlgEquiv.apply_symm_apply, add_mul, mul_add, one_mul, mul_one,
    shearDisplacement_mul_displacement, displacement_mul_shearDisplacement, add_zero]
  abel

private theorem shearMatrix_entry (i j : Fin 112) :
    shearMatrix i j = (Pi.single j 1 : NaturalModule) i +
      displacement (Pi.single j 1) 0 * (baseVector : NaturalModule) i := rfl

private theorem shearMatrix_zero_zero : shearMatrix 0 0 = 0 := by
  rw [shearMatrix_entry, baseVector_zero]
  change 1 + (baseVector : NaturalModule) 0 * 1 = 0
  rw [baseVector_zero]
  decide

private theorem shearMatrix_one_one : shearMatrix 1 1 = 1 := by
  rw [shearMatrix_entry, baseVector_one]
  simp

private theorem ambientShear_ne_one : ambientShear ≠ 1 := by
  intro h
  have he := congrArg (fun u : BinaryMatrixˣ => (u : BinaryMatrix) 0 0) h
  change shearMatrix 0 0 = 1 at he
  rw [shearMatrix_zero_zero] at he
  exact zero_ne_one he

private theorem ambientShear_ne_matrixUnitA : ambientShear ≠ matrixUnitA := by
  intro h
  have he := congrArg (fun u : BinaryMatrixˣ => (u : BinaryMatrix) 1 1) h
  change shearMatrix 1 1 = matrixA 1 1 at he
  rw [shearMatrix_one_one, show matrixA 1 1 = 0 by decide +kernel] at he
  exact one_ne_zero he

private theorem ambientShear_homology_condition (v : fixedVectors) :
    Matrix.mulVec (ambientShear : BinaryMatrix) (v : NaturalModule) - v ∈
      displacementVectors := by
  rw [ambientShear_fixes, sub_self]
  exact displacementVectors.zero_mem

/-- The commutation, homology-kernel and vector-fixing tests admit an extra
ambient unit. Its membership in `matrixGroup` is not asserted. -/
theorem ambient_linear_conditions_insufficient :
    ∃ u : BinaryMatrixˣ,
      u * matrixUnitA = matrixUnitA * u ∧
      (∀ v : fixedVectors,
        Matrix.mulVec (u : BinaryMatrix) (v : NaturalModule) - v ∈ displacementVectors) ∧
      Matrix.mulVec (u : BinaryMatrix) (baseVector : NaturalModule) = baseVector ∧
      u ≠ 1 ∧ u ≠ matrixUnitA :=
  ⟨ambientShear, ambientShear_commutes, ambientShear_homology_condition,
    ambientShear_fixes baseVector, ambientShear_ne_one, ambientShear_ne_matrixUnitA⟩

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound
