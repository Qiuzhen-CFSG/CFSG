/-!
# Ambient generator images of basis forms 1176 through 1199

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA1176 : ℕ := 

private def imageA1176 : ℕ := 

private def coefficientsA1176 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA1176 :
    flatMatrix transposeA * flatMatrix (basisFlat 1176) =
      flatMatrix middleA1176 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA1176 :
    flatMatrix middleA1176 * flatMatrix ambientA =
      flatMatrix imageA1176 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA1176 :
    combination coefficientsA1176 = imageA1176 := by decide +kernel

private theorem preservedA1176 :
    formPullback matrixUnitA (exteriorBasisForm 1176) ∈ exteriorFormSpace := by
  rw [← basis_decode (1176 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 1176) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA1176, rightA1176,
    ← reconstructA1176]
  exact combination_mem coefficientsA1176

