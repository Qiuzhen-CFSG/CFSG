module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.ImageBound.OrbitBound.Refinement

/-!
# Certified invariant colors for the 693-vector sum graph

The six terminal color tables are exactly the partitions in
`ImageBound/source/refinement.json`, encoded with ten bits per vertex. Between
individualizations we refine by counts in selected invariant cells. A lookup
table compresses the pair (old color, neighbor count) to the new color. Every
update is checked over all vertices against `Refinement.neighborCount`, which
uses the actual `OrbitGeometry.Adj`; no JSON adjacency row is assumed correct.

The selected-cell schedule is generated by `GraphBound/source/generate.py`.
Checking lookup equations requires only one traversal per update, rather than
all pairs of vertices. Cell membership, distinctness, the five pivot-cell sizes,
and an inverse for the terminal coloring are also kernel-checked. The constant
initial coloring's cell has size 693 by the counting theorem in `Refinement`.

The source data and ATLAS attribution are described in
`ImageBound/source/README.md`. These certificates concern the full sum-graph
permutation group; their use for homology requires the separate coordinate
identification owned by `OrbitBound.Transport`.
-/

@[expose] public section

namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.OrbitGeometry.GraphBoundCertificate

open Refinement

set_option maxRecDepth 10000
set_option maxHeartbeats 10000000

private theorem refine_lookup {xs : List Vertex} {c d : Vertex → ℕ}
    (hc : Preserves xs c) (s : List Vertex) (hs : s.Nodup) (tag : ℕ)
    (hcell : ∀ x, x ∈ s ↔ c x = tag) (f : ℕ → ℕ → ℕ)
    (hd : ∀ x, d x = f (c x) (neighborCount s x)) : Preserves xs d := by
  apply preserves_count_refinement hc s hs tag hcell
  intro x y he hn
  rw [hd, hd, he, hn]

private theorem individualize_lookup {xs : List Vertex} {c d : Vertex → ℕ}
    (hc : Preserves xs c) (v : Vertex) (f : ℕ → Bool → ℕ)
    (hd : ∀ x, d x = f (c x) (decide (x = v))) : Preserves (v :: xs) d := by
  apply preserves_individualize hc v
  intro x y he hv
  simp only [hd, he, hv]

private theorem injective_lookup (c : Vertex → ℕ) (f : ℕ → ℕ)
    (he : ∀ x, f (c x) = x.val) : Function.Injective c := by
  intro x y h
  apply Fin.ext
  rw [← he, ← he, h]

private theorem size_cell (c : Vertex → ℕ) (v : Vertex) (s : List Vertex)
    (hs : s.Nodup) (hcell : ∀ x, x ∈ s ↔ c x = c v) : cellSize c v = s.length := by
  unfold cellSize
  have h : Finset.univ.filter (fun x => c x = c v) = s.toFinset := by
    ext x
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, List.mem_toFinset, hcell]
  rw [h, List.toFinset_card_of_nodup hs]
private def color0 (_ : Vertex) : ℕ := 0
private theorem preserves0 : Preserves [] color0 := by intro _ _ _; rfl

private def color1 (i : Vertex) : ℕ := ( >>> (10 * i.val)) % 1024
private def lookup1 (c n : ℕ) : ℕ := (0x1 >>> (10 * (c * 2 + n))) % 1024
private theorem preserves1 : Preserves [0] color1 := by
  apply individualize_lookup preserves0 0 (fun c b => lookup1 c (if b then 1 else 0))
  apply allFin
  decide +kernel

