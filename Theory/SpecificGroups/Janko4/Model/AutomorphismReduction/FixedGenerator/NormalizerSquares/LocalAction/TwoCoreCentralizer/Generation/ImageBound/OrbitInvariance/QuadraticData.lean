  packedMul_eq_of_rows _ _ _ (by decide +kernel)

private theorem conjugate_n : (matrixA - 1)ᵀ * matrix * (matrixA - 1) = decodeRows nConjRows := by
  rw [matrix, ← transpose_n, ← decode_n, mul_assoc]
  change decodeRows nTransRows * (decodeRows qRows * decodeRows nRows) = _
  rw [← decode_packedMul qRows nRows, product_qn, ← decode_packedMul nTransRows qnRows, product_nconj]

