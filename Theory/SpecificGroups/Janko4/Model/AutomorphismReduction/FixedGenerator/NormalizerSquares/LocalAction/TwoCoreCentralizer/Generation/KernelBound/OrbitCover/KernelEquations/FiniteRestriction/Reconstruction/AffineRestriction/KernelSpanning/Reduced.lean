theorem reconstruct_solution (S : RestrictionMatrix) (hS : RawEquations S) :
    flat S = ∑ k : Fin 127, flat S (free.get k) •
      (fun i => bit (bs.get k) i.val) :=
  reconstruct (flat S) free bs reducedRow (reduced_zero S hS) reduced_eq

