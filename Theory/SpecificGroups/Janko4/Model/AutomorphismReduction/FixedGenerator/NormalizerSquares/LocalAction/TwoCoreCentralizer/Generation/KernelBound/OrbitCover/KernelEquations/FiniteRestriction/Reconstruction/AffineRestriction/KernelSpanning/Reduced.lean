/-!
# Reconstruction from the free entries

Finite witness from the saved full Gaussian elimination. Every identity
is checked in Lean; see KernelSpanning/source/README.md.
-/

@[expose] public section
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.Reconstruction.AffineCertificate.KernelSpanning
open LinearMembership GeneratorCertificates Binary

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem reduced_index_bound (i : Fin 2500) (j : ℕ)
    (hj : reducedIndex i = some j) : j < 4746 := by
  have h : ∀ i : Fin 2500, ∀ j ∈ reducedIndex i, j < 4746 := by decide +kernel
  exact h i j (by simpa only [hj] using (show j ∈ some j from rfl))

theorem reduced_zero (S : RestrictionMatrix) (hS : RawEquations S) (i : Fin 2500) :
    ev (flat S) (reducedRow i) = 0 := by
  cases h : reducedIndex i with
  | none => simp only [reducedRow, h, Option.elim_none, ev_zero]
  | some j =>
    simpa only [reducedRow, h, Option.elim_some] using
      trace_zero S hS ⟨j, reduced_index_bound i j h⟩

set_option maxHeartbeats 800000 in
theorem reduced_eq (i : Fin 2500) : reducedRow i = 2 ^ i.val ^^^
