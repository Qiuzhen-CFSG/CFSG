theorem checks096 (k : ℕ) (hlo : 96 ≤ k) (hhi : k < 112) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_096, dot_096⟩
  · exact ⟨transport_097, dot_097⟩
  · exact ⟨transport_098, dot_098⟩
  · exact ⟨transport_099, dot_099⟩
  · exact ⟨transport_100, dot_100⟩
  · exact ⟨transport_101, dot_101⟩
  · exact ⟨transport_102, dot_102⟩
  · exact ⟨transport_103, dot_103⟩
  · exact ⟨transport_104, dot_104⟩
  · exact ⟨transport_105, dot_105⟩
  · exact ⟨transport_106, dot_106⟩
  · exact ⟨transport_107, dot_107⟩
  · exact ⟨transport_108, dot_108⟩
  · exact ⟨transport_109, dot_109⟩
  · exact ⟨transport_110, dot_110⟩
  · exact ⟨transport_111, dot_111⟩

