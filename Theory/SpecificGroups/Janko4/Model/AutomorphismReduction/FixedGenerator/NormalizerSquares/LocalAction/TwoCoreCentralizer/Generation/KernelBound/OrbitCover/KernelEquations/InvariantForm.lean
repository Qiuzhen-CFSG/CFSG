/-- A nonzero alternating form in the published column basis. -/
def invariantForm : BinaryMatrix := decodeRows invariantFormRows

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem transpose_A : matrixAᵀ = decodeRows aTransposeRows := by decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem transpose_B : matrixBᵀ = decodeRows bTransposeRows := by decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem mul_a_form : packedMul aTransposeRows invariantFormRows = aTransposeFormRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem mul_a_form_a : packedMul aTransposeFormRows aRows = invariantFormRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem mul_b_form : packedMul bTransposeRows invariantFormRows = bTransposeFormRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem mul_b_form_b : packedMul bTransposeFormRows bRows = invariantFormRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

theorem invariantForm_A : formPullback matrixUnitA invariantForm = invariantForm := by
  simp only [formPullback, coe_matrixUnitA]
  rw [transpose_A]
  change decodeRows aTransposeRows * decodeRows invariantFormRows * decodeRows aRows = _
  rw [← decode_packedMul, mul_a_form, ← decode_packedMul, mul_a_form_a]
  rfl

theorem invariantForm_B : formPullback matrixUnitB invariantForm = invariantForm := by
  simp only [formPullback, coe_matrixUnitB]
  rw [transpose_B]
  change decodeRows bTransposeRows * decodeRows invariantFormRows * decodeRows bRows = _
  rw [← decode_packedMul, mul_b_form, ← decode_packedMul, mul_b_form_b]
  rfl

/-- This invariant holds for every element of the actual generated matrix group. -/
theorem matrixGroup_preserves_invariantForm {g : BinaryMatrixˣ} (hg : g ∈ matrixGroup) :
    formPullback g invariantForm = invariantForm :=
  matrixGroup_le_formFixer invariantForm invariantForm_A invariantForm_B hg

