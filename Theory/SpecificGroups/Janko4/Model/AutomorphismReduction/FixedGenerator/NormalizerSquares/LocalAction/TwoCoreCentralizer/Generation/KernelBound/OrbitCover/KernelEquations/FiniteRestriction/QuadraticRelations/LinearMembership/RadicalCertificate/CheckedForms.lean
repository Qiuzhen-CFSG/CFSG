theorem radicalGenerator_mem (i : Fin 53) :
    radicalGenerator i ∈ exteriorRadical displacementVectors :=
  (witness_sound i (allWitnessChecks i)).1

theorem radicalGenerator_mixed (i : Fin 53) :
    mixedEvaluation (radicalGenerator i) = rectDecode 50 (radicalMixedRows.get i) :=
  (witness_sound i (allWitnessChecks i)).2.1

theorem radicalGenerator_factorization (i : Fin 53) :
    mixedEmbeddingᵀ * radicalGenerator i =
      mixedEvaluation (radicalGenerator i) * restrictionExtraction * (matrixA - 1) :=
  (witness_sound i (allWitnessChecks i)).2.2

theorem radicalSpan_le : radicalSpan ≤ exteriorRadical displacementVectors := by
  apply Submodule.span_le.mpr
  rintro _ ⟨i, rfl⟩
  exact radicalGenerator_mem i

