theorem checks144 (k : ℕ) (hlo : 144 ≤ k) (hhi : k < 160) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_144, dot_144⟩
  · exact ⟨transport_145, dot_145⟩
  · exact ⟨transport_146, dot_146⟩
  · exact ⟨transport_147, dot_147⟩
  · exact ⟨transport_148, dot_148⟩
  · exact ⟨transport_149, dot_149⟩
  · exact ⟨transport_150, dot_150⟩
  · exact ⟨transport_151, dot_151⟩
  · exact ⟨transport_152, dot_152⟩
  · exact ⟨transport_153, dot_153⟩
  · exact ⟨transport_154, dot_154⟩
  · exact ⟨transport_155, dot_155⟩
  · exact ⟨transport_156, dot_156⟩
  · exact ⟨transport_157, dot_157⟩
  · exact ⟨transport_158, dot_158⟩
  · exact ⟨transport_159, dot_159⟩

