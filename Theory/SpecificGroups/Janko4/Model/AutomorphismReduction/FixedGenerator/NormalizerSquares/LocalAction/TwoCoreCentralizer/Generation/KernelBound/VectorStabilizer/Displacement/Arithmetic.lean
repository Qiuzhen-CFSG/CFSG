module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.KernelBound.VectorStabilizer.Displacement.Data

/-!
# Transport for the displacement certificates

Packed XOR combinations are ordinary linear combinations. A checked identity
between coefficient rows reconstructs the entire kernel from free coordinates,
so no dimension count or external elimination result is used. These are the
algebraic bridges for the data generated by source/generate.py.
-/

public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.VectorStabilizer.Displacement
open OrbitCoverCoordinates OrbitCoverCoordinates.LinearMembership
open GeneratorCertificates LinearMembership.FiniteAlgebra

@[expose] def combination {n : ℕ} (B : Fin n → RestrictionMatrix) :
    (Fin n → ZMod 2) →ₗ[ZMod 2] RestrictionMatrix where
  toFun c := ∑ i, c i • B i
  map_add' c d := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' r c := by simp [Finset.smul_sum, smul_smul]

theorem packed_combination {n : ℕ} (w : Vector ℕ n) (c : ℕ) :
    packedMatrix (scan c w.toList) =
      combination (fun i => packedMatrix (w.get i)) (fun i => bit c i.val) := by
  ext i j
  simp only [packedMatrix, unflat, combination, LinearMap.coe_mk, AddHom.coe_mk,
    bit_scan, ev, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul]

/-- A full row-recovery identity proves completeness of a coefficient kernel. -/
theorem coefficient_kernel {n d r : ℕ} (rows : Vector ℕ r)
    (free : Vector (Fin n) d) (basis : Vector ℕ d)
    (recovery remainder : Vector ℕ n)
    (hrec : ∀ i, scan (recovery.get i) rows.toList = remainder.get i)
    (hrem : ∀ i : Fin n, remainder.get i = 2 ^ i.val ^^^
      xorList (List.ofFn (fun k : Fin d =>
        if (basis.get k).testBit i.val then 2 ^ (free.get k).val else 0)))
    (c : Fin n → ZMod 2) (hc : ∀ i, ev c (rows.get i) = 0) :
    c = ∑ k : Fin d, c (free.get k) • (fun i => bit (basis.get k) i.val) := by
  apply reconstruct c free basis (fun i => remainder.get i) _ hrem
  intro i
  rw [← hrec, ev_scan]
  simp only [hc, mul_zero, Finset.sum_const_zero]

/-- Matrix multiplication by a packed column, checked without scalar sums. -/
theorem packed_mulVec {m n : ℕ} (rows : Vector ℕ m) (column : Vector ℕ n)
    (v : Fin n → ZMod 2) (w : Fin m → ZMod 2)
    (hv : ∀ j, bit (column.get j) 0 = v j)
    (h : ∀ i, bit (scan (rows.get i) column.toList) 0 = w i) :
    rectDecode n rows *ᵥ v = w := by
  ext i
  rw [← h i, bit_scan]
  simp only [ev, hv, Matrix.mulVec, dotProduct, rectDecode]

theorem binary_scalar (c : ZMod 2) : c = 0 ∨ c = 1 := by
  have hc := ZMod.val_lt c
  have h : c.val = 0 ∨ c.val = 1 := by omega
  exact h.imp (fun h => ZMod.val_injective 2 (h.trans (by decide)))
    (fun h => ZMod.val_injective 2 (h.trans (by decide)))

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.VectorStabilizer.Displacement
