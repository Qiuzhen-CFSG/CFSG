theorem checks192 (k : ℕ) (hlo : 192 ≤ k) (hhi : k < 208) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_192, dot_192⟩
  · exact ⟨transport_193, dot_193⟩
  · exact ⟨transport_194, dot_194⟩
  · exact ⟨transport_195, dot_195⟩
  · exact ⟨transport_196, dot_196⟩
  · exact ⟨transport_197, dot_197⟩
  · exact ⟨transport_198, dot_198⟩
  · exact ⟨transport_199, dot_199⟩
  · exact ⟨transport_200, dot_200⟩
  · exact ⟨transport_201, dot_201⟩
  · exact ⟨transport_202, dot_202⟩
  · exact ⟨transport_203, dot_203⟩
  · exact ⟨transport_204, dot_204⟩
  · exact ⟨transport_205, dot_205⟩
  · exact ⟨transport_206, dot_206⟩
  · exact ⟨transport_207, dot_207⟩

