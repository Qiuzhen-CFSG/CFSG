module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.Comparison.QuotientAction
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Max2Bridge

/-!
# Separating the two bounds in the max2 involution census

Let H be the subgroup generated by the certified conjugated max2 words and
N the normal closure inside H of their order-four seed. The bridge gives a
nonidentity element of Z(N). An intrinsic center count controls centralizing
elements that belong to N; to cover all of H one must also put square-one
elements of the relative conjugation kernel into N.

These are conditional assembly lemmas. Neither missing bound is inferred
from the order of the seed or from the proposed ATLAS local shape. The main
involution census remains an obligation until both bounds are discharged.
The final lemma accepts an intrinsic subgroup containment directly, matching
the separate intrinsic-center and conjugation-kernel certificate contracts.

Source motivation: GLS3, Table 5.3i, printed p.270,
`refs/KGroup/GLS3/Chapter5(sec3-).tex`. The literal words and conjugacy
bridge are certified in `TwoCoreCentralizer.Max2Bridge`.
-/

public section

set_option autoImplicit false

namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreComparison

open TwoCoreCentralizerData

private theorem involution_central (z : localSubgroup) :
    z * subgroupInvolution = subgroupInvolution * z := by
  apply Subtype.ext
  exact (Subgroup.mem_center_iff.mp centralInvolution_mem_center) z

/-- The distinguished involution as an element of the actual seed center. -/
def seedCenterInvolution : Subgroup.center localNormalClosure :=
  ⟨⟨subgroupInvolution, subgroupInvolution_mem_normalClosure⟩, by
    rw [Subgroup.mem_center_iff]
    intro z
    exact Subtype.ext (involution_central z)⟩

theorem orderOf_seedCenterInvolution : orderOf seedCenterInvolution = 2 := by
  rw [← orderOf_injective (Subgroup.center localNormalClosure).subtype
    Subtype.val_injective]
  rw [← orderOf_injective localNormalClosure.subtype Subtype.val_injective]
  exact orderOf_subgroupInvolution

theorem seedCenterInvolution_ne_one : seedCenterInvolution ≠ 1 := by
  intro h
  have ho := orderOf_seedCenterInvolution
  rw [h, orderOf_one] at ho
  exact (by decide : (1 : ℕ) ≠ 2) ho

/-- The bridge already gives the lower bound on the intrinsic seed center. -/
theorem two_le_card_seedCenter : 2 ≤ Nat.card (Subgroup.center localNormalClosure) := by
  let f : Bool → Subgroup.center localNormalClosure :=
    fun b => if b then seedCenterInvolution else 1
  have hi : Function.Injective f := by
    intro a b hab
    cases a <;> cases b
    · rfl
    · exact False.elim (seedCenterInvolution_ne_one hab.symm)
    · exact False.elim (seedCenterInvolution_ne_one hab)
    · rfl
  simpa using Nat.card_le_card_of_injective f hi

/-- A center upper bound applies to centralizing elements known to lie in N.
The membership hypothesis is essential: the requested census ranges over H. -/
theorem localSeedCentralizer_cases_of_mem_normalClosure
    (hcenter : Nat.card (Subgroup.center localNormalClosure) = 2)
    (z : localSubgroup)
    (hz : z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup))
    (hN : z ∈ localNormalClosure) : z = 1 ∨ z = subgroupInvolution := by
  let c : Subgroup.center localNormalClosure := ⟨⟨z, hN⟩, by
    rw [Subgroup.mem_center_iff]
    intro n
    exact Subtype.ext (hz n n.property)⟩
  obtain ⟨w, hw, hall⟩ := (Nat.card_eq_two_iff'
    (1 : Subgroup.center localNormalClosure)).mp hcenter
  by_cases hc : c = 1
  · exact Or.inl (congrArg (fun x : Subgroup.center localNormalClosure =>
      ((x : localNormalClosure) : localSubgroup)) hc)
  · have hci : c = seedCenterInvolution :=
      (hall c hc).trans (hall seedCenterInvolution seedCenterInvolution_ne_one).symm
    exact Or.inr (congrArg (fun x : Subgroup.center localNormalClosure =>
      ((x : localNormalClosure) : localSubgroup)) hci)

/-- Only involutions in the relative action kernel need to be placed in N.
Both this containment and the intrinsic center count remain concrete obligations. -/
theorem localSeedCentralizer_involution_cases_of_kernel
    (hcenter : Nat.card (Subgroup.center localNormalClosure) = 2)
    (hkernel : ∀ z ∈ (MulAut.conjNormal :
      localSubgroup →* MulAut localNormalClosure).ker,
      z ^ 2 = 1 → z ∈ localNormalClosure)
    (z : localSubgroup)
    (hz : z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup))
    (hpow : z ^ 2 = 1) : z = 1 ∨ z = subgroupInvolution := by
  apply localSeedCentralizer_cases_of_mem_normalClosure hcenter z hz
  apply hkernel z ?_ hpow
  rwa [MulAut.conjNormal_ker_eq_centralizer]

/-- The stronger action-kernel bound yields the census for every centralizing
local element, without an order assumption. -/
theorem localSeedCentralizer_cases_of_kernel_le
    (hcenter : Nat.card (Subgroup.center localNormalClosure) = 2)
    (hkernel : (MulAut.conjNormal :
      localSubgroup →* MulAut localNormalClosure).ker ≤ localNormalClosure)
    (z : localSubgroup)
    (hz : z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup)) :
    z = 1 ∨ z = subgroupInvolution := by
  apply localSeedCentralizer_cases_of_mem_normalClosure hcenter z hz
  apply hkernel
  rwa [MulAut.conjNormal_ker_eq_centralizer]

/-- The cyclic subgroup of the certified involution has exactly these elements. -/
theorem subgroupInvolution_zpowers_cases (z : localSubgroup)
    (hz : z ∈ Subgroup.zpowers subgroupInvolution) :
    z = 1 ∨ z = subgroupInvolution := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, orderOf_subgroupInvolution] at hz
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hz
  have hn' : n = 0 ∨ n = 1 := by
    have := Finset.mem_range.mp hn
    omega
  rcases hn' with rfl | rfl
  · exact Or.inl (pow_zero _)
  · exact Or.inr (pow_one _)

/-- Assembly from the two concrete subgroup bounds. The first controls actors
outside N; the second controls Z(N). Neither bound is proved by this lemma.
Once supplied, they give the census without needing the square-one hypothesis. -/
theorem localSeedCentralizer_cases_of_bounds
    (hkernel : (MulAut.conjNormal :
      localSubgroup →* MulAut localNormalClosure).ker ≤ localNormalClosure)
    (hcenter : localNormalClosure ⊓
      Subgroup.centralizer (localNormalClosure : Set localSubgroup) ≤
      Subgroup.zpowers subgroupInvolution)
    (z : localSubgroup)
    (hz : z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup)) :
    z = 1 ∨ z = subgroupInvolution := by
  apply subgroupInvolution_zpowers_cases z
  rw [MulAut.conjNormal_ker_eq_centralizer] at hkernel
  exact hcenter ⟨hkernel hz, hz⟩

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreComparison
