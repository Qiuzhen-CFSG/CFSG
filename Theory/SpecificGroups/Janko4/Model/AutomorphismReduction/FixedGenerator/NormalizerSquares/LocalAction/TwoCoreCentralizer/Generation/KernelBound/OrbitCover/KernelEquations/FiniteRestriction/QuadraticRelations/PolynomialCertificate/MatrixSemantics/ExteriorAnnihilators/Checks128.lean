theorem checks128 (k : ℕ) (hlo : 128 ≤ k) (hhi : k < 144) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_128, dot_128⟩
  · exact ⟨transport_129, dot_129⟩
  · exact ⟨transport_130, dot_130⟩
  · exact ⟨transport_131, dot_131⟩
  · exact ⟨transport_132, dot_132⟩
  · exact ⟨transport_133, dot_133⟩
  · exact ⟨transport_134, dot_134⟩
  · exact ⟨transport_135, dot_135⟩
  · exact ⟨transport_136, dot_136⟩
  · exact ⟨transport_137, dot_137⟩
  · exact ⟨transport_138, dot_138⟩
  · exact ⟨transport_139, dot_139⟩
  · exact ⟨transport_140, dot_140⟩
  · exact ⟨transport_141, dot_141⟩
  · exact ⟨transport_142, dot_142⟩
  · exact ⟨transport_143, dot_143⟩

