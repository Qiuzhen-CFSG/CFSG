private theorem transport_128 : ∀ i : Fin 112,
    transportRow (weights.get 128) i = flatRow (duals.get 128) i.val := by
  change ∀ i : Fin 112, transportRow  i = flatRow  i.val
  decide +kernel

set_option maxRecDepth 10000 in
private theorem dot_128 : ∀ a : Fin 1221,
    flatDot (duals.get 128) (basisFlat a.val) = false := by
  change ∀ a : Fin 1221, flatDot  (basisFlat a.val) = false
  decide +kernel

