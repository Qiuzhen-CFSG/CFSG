/-!
# Ambient generator images of basis forms 696 through 719

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA0696 : ℕ := 

private def imageA0696 : ℕ := 

private def coefficientsA0696 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0696 :
    flatMatrix transposeA * flatMatrix (basisFlat 696) =
      flatMatrix middleA0696 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0696 :
    flatMatrix middleA0696 * flatMatrix ambientA =
      flatMatrix imageA0696 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0696 :
    combination coefficientsA0696 = imageA0696 := by decide +kernel

private theorem preservedA0696 :
    formPullback matrixUnitA (exteriorBasisForm 696) ∈ exteriorFormSpace := by
  rw [← basis_decode (696 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 696) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0696, rightA0696,
    ← reconstructA0696]
  exact combination_mem coefficientsA0696

