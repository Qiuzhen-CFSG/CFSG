/-!
# Ambient generator images of basis forms 1152 through 1175

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA1152 : ℕ := 

private def imageA1152 : ℕ := 

private def coefficientsA1152 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA1152 :
    flatMatrix transposeA * flatMatrix (basisFlat 1152) =
      flatMatrix middleA1152 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA1152 :
    flatMatrix middleA1152 * flatMatrix ambientA =
      flatMatrix imageA1152 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA1152 :
    combination coefficientsA1152 = imageA1152 := by decide +kernel

private theorem preservedA1152 :
    formPullback matrixUnitA (exteriorBasisForm 1152) ∈ exteriorFormSpace := by
  rw [← basis_decode (1152 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 1152) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA1152, rightA1152,
    ← reconstructA1152]
  exact combination_mem coefficientsA1152

