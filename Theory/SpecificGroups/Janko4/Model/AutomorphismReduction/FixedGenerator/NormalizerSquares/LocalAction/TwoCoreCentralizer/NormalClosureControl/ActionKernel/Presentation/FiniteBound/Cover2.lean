private theorem context_valid :
    Valid context level2Subgroup (PresentedGroup.of : Fin 3 → Level2)
      (definitions.repr PresentedGroup.of) := by
  apply definitions.valid
  · intro a ha
    exact Bool.noConfusion ha
  · intro r
    dsimp only [relatorWords]
    split
    · exact level2_relator _
    · exact eval_nil _

private theorem seed_valid : ∀ n, n < 2 →
    Holds level2Subgroup (PresentedGroup.of : Fin 3 → Level2)
      (definitions.repr PresentedGroup.of) (facts n) := by
  intro n hn
  interval_cases n
  · change Holds level2Subgroup PresentedGroup.of (definitions.repr PresentedGroup.of)
      ⟨0, level2ChildWord 0, 0⟩
    exact holds_subgroup_word _ _ _ (definitions.repr_zero _) _ (level2Generator_mem 0)
  · change Holds level2Subgroup PresentedGroup.of (definitions.repr PresentedGroup.of)
      ⟨0, level2ChildWord 1, 0⟩
    exact holds_subgroup_word _ _ _ (definitions.repr_zero _) _ (level2Generator_mem 1)

theorem all_hold : ∀ n, n < 31 →
    Holds level2Subgroup (PresentedGroup.of : Fin 3 → Level2)
      (definitions.repr PresentedGroup.of) (facts n) := by
  have hall2 := checkChunk_sound context_valid facts instructions 2 29
    seed_valid checked_2
  exact hall2

def index (i : Fin 3) : Nat :=
  Vector.get #v[0, 1, 2] i

def output (i : Fin 3) (a : Letter (Fin 3)) : Nat :=
  ((lookupBranch 9 (lookupBranch 4 (lookupBranch 2 (lookupBranch 1 (fun _ => 5) (fun _ => 12)) (lookupBranch 3 (fun _ => 0) (fun _ => 2))) (lookupBranch 6 (lookupBranch 5 (fun _ => 1) (fun _ => 3)) (lookupBranch 7 (fun _ => 7) (lookupBranch 8 (fun _ => 6) (fun _ => 24))))) (lookupBranch 13 (lookupBranch 11 (lookupBranch 10 (fun _ => 22) (fun _ => 16)) (lookupBranch 12 (fun _ => 17) (fun _ => 11))) (lookupBranch 15 (lookupBranch 14 (fun _ => 8) (fun _ => 21)) (lookupBranch 16 (fun _ => 25) (lookupBranch 17 (fun _ => 29) (fun _ => 30))))))) (i.val * 6 + 2 * a.1.val + if a.2 then 0 else 1)

def dest (i : Fin 3) (a : Letter (Fin 3)) : Fin 3 :=
  ((lookupBranch 9 (lookupBranch 4 (lookupBranch 2 (lookupBranch 1 (fun _ => 1) (fun _ => 2)) (lookupBranch 3 (fun _ => 0) (fun _ => 0))) (lookupBranch 6 (lookupBranch 5 (fun _ => 0) (fun _ => 0)) (lookupBranch 7 (fun _ => 2) (lookupBranch 8 (fun _ => 0) (fun _ => 2))))) (lookupBranch 13 (lookupBranch 11 (lookupBranch 10 (fun _ => 2) (fun _ => 1)) (lookupBranch 12 (fun _ => 1) (fun _ => 0))) (lookupBranch 15 (lookupBranch 14 (fun _ => 1) (fun _ => 1)) (lookupBranch 16 (fun _ => 1) (lookupBranch 17 (fun _ => 2) (fun _ => 2))))))) (i.val * 6 + 2 * a.1.val + if a.2 then 0 else 1)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 20000000 in
theorem output_shape : ∀ (i : Fin 3) (a : Letter (Fin 3)),
    facts (output i a) = ⟨index i, [a], index (dest i a)⟩ := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 20000000 in
theorem output_lt : ∀ (i : Fin 3) (a : Letter (Fin 3)),
    output i a < 31 := by decide +kernel

/-- A certified cover of the actual abstract presentation by its named subgroup. -/
noncomputable def cover :
    Subgroup.GeneratorCosetCover level2Subgroup PresentedGroup.of (Fin 3) :=
  coverOfFacts facts index 0 (definitions.repr_zero _) dest output output_shape
