/-!
# Ambient generator images of basis forms 792 through 815

Two packed products compute each pullback. A third kernel check
reconstructs the result as an XOR of the certified basis forms.
The ambient matrices are exactly Model.Data; coefficient witnesses
are generated from KernelEquations/source/discover.py.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.ExteriorInvariance
open GeneratorCertificates

private def middleA0792 : ℕ := 

private def imageA0792 : ℕ := 

private def coefficientsA0792 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0792 :
    flatMatrix transposeA * flatMatrix (basisFlat 792) =
      flatMatrix middleA0792 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0792 :
    flatMatrix middleA0792 * flatMatrix ambientA =
      flatMatrix imageA0792 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0792 :
    combination coefficientsA0792 = imageA0792 := by decide +kernel

private theorem preservedA0792 :
    formPullback matrixUnitA (exteriorBasisForm 792) ∈ exteriorFormSpace := by
  rw [← basis_decode (792 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 792) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0792, rightA0792,
    ← reconstructA0792]
  exact combination_mem coefficientsA0792

