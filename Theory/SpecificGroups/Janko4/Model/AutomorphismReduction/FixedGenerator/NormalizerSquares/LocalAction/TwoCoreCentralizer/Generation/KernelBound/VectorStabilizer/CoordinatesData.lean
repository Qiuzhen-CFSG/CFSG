/-- The proposed upper span for UU blocks of actual radical-K forms. -/
def radicalKUpperSpace : Submodule (ZMod 2) RestrictionMatrix :=
  Submodule.span (ZMod 2) (Set.range radicalKGenerator)

/-- Every actual exterior form with radical containing ker(A - 1) has its
