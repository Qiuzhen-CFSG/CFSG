def adaptedInverse : BinaryMatrix := rectDecode 112 adaptedInverseRows

def imageIndex (i : Fin 50) : Fin 112 := ⟨i.val, by omega⟩

def homologyIndex (i : Fin 12) : Fin 112 := ⟨50 + i.val, by omega⟩

def liftIndex (i : Fin 50) : Fin 112 := ⟨62 + i.val, by omega⟩

def imageProjection : Matrix (Fin 50) (Fin 112) (ZMod 2) :=
  adaptedInverse.submatrix imageIndex id

def homologyProjection : Matrix (Fin 12) (Fin 112) (ZMod 2) :=
  adaptedInverse.submatrix homologyIndex id

def liftProjection : Matrix (Fin 50) (Fin 112) (ZMod 2) :=
  adaptedInverse.submatrix liftIndex id

/-- B, the image component of the images of the mixed columns. -/
def upperMiddleBlock (g : BinaryMatrix) : Matrix (Fin 50) (Fin 12) (ZMod 2) :=
  imageProjection * g * mixedEmbedding

/-- C, the image component of the images of the lift columns. -/
def upperRightBlock (g : BinaryMatrix) : RestrictionMatrix :=
  imageProjection * g * restrictionLifts

/-- D, the mixed component of the images of the lift columns. -/
def middleRightBlock (g : BinaryMatrix) : MixedMatrix :=
  homologyProjection * g * restrictionLifts

