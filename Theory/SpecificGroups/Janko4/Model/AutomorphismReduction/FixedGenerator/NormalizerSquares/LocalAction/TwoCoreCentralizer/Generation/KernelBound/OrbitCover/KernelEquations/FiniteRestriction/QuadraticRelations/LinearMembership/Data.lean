/-- Forty concrete mixed matrices; their spanning property is a separate theorem. -/
def mixedGenerator (i : Fin 40) : MixedMatrix :=
  fun j k => if ((mixedGeneratorRows.get i).get j).testBit k.val then 1 else 0

def mixedSpace : Submodule (ZMod 2) MixedMatrix :=
  Submodule.span (ZMod 2) (Set.range mixedGenerator)

/-- Mixed evaluations on the displayed H columns and displacement lifts L. -/
def mixedEvaluation : BinaryMatrix →ₗ[ZMod 2] MixedMatrix where
  toFun R := mixedEmbeddingᵀ * R * restrictionLifts
  map_add' R S := by simp only [Matrix.mul_add, Matrix.add_mul]
  map_smul' c R := by simp only [Matrix.mul_smul, Matrix.smul_mul, RingHom.id_apply]

/-- The actual image of the actual radical-I exterior forms. -/
def mixedImageSpace : Submodule (ZMod 2) MixedMatrix :=
  (exteriorRadical displacementVectors).map mixedEvaluation

/-- Right multiplication preserving the displayed mixed-evaluation space. -/
def PreservesMixedSpace (S : RestrictionMatrix) : Prop :=
  ∀ M ∈ mixedSpace, M * S ∈ mixedSpace

