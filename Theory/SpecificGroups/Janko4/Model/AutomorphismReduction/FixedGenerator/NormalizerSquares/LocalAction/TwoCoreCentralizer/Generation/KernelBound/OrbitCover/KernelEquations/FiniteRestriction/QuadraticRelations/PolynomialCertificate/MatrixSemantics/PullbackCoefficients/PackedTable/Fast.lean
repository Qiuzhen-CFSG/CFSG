def outerFast (x y : ℕ) : ℕ := spreadFast 16 x * (y % 2^125)

theorem bit_outerFast (x y : ℕ) (a b : Fin 125) :
    bit (outerFast x y) (125*a.val+b.val) = bit x a.val * bit y b.val := by
  rw [outerFast, spreadFast_eq,
    bit_spread_mul _ _ _ _ _ _ (show a.val < 8*16 by omega) b.isLt
      (Nat.mod_lt _ (by decide)), bit_mod _ _ _ b.isLt]

def tensorFast (xs ys : Vector ℕ 50) : ℕ :=
  xorList (List.ofFn (fun k : Fin 50 => outerFast (xs.get k) (ys.get k)))

theorem bit_tensorFast (xs ys : Vector ℕ 50) (a b : Fin 125) :
    bit (tensorFast xs ys) (125*a.val+b.val) = bit (tensor xs ys) (125*a.val+b.val) := by
  simp only [tensorFast, tensor, bit_xorList, List.map_ofFn, List.sum_ofFn,
    Function.comp_apply, bit_outerFast, bit_outer]

def rawBlockFast (C D : ColumnCoefficients) (reverse : Bool) : ColumnCoefficients :=
  Vector.ofFn (fun u => Vector.ofFn (fun v => if u < v then
    if reverse then tensorFast (D.get v) (C.get u) else tensorFast (C.get u) (D.get v)
    else 0))

theorem contract_rawBlockFast (w : ℕ) (C D : ColumnCoefficients) (reverse : Bool)
    (a b : Fin 125) :
    bit (contract w (rawBlockFast C D reverse)) (125*a.val+b.val) =
      bit (contract w (rawBlock C D reverse)) (125*a.val+b.val) := by
  rw [bit_contract, bit_contract]
  apply Finset.sum_congr rfl
  intro u _
  apply Finset.sum_congr rfl
  intro v _
  simp only [rawBlockFast, rawBlock, get_ofFn]
  split_ifs <;> simp only [bit_tensorFast]

