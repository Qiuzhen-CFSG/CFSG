private def middleA0336 : ℕ := 

private def imageA0336 : ℕ := 

private def coefficientsA0336 : ℕ := 

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem leftA0336 :
    flatMatrix transposeA * flatMatrix (basisFlat 336) =
      flatMatrix middleA0336 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem rightA0336 :
    flatMatrix middleA0336 * flatMatrix ambientA =
      flatMatrix imageA0336 := by
  apply flatMatrix_mul
  change ∀ j : Fin 112, flatMulRow (flatRow  j.val)
     = flatRow  j.val
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem reconstructA0336 :
    combination coefficientsA0336 = imageA0336 := by decide +kernel

private theorem preservedA0336 :
    formPullback matrixUnitA (exteriorBasisForm 336) ∈ exteriorFormSpace := by
  rw [← basis_decode (336 : Fin 1221)]
  simp only [formPullback, coe_matrixUnitA]
  change matrixAᵀ * flatMatrix (basisFlat 336) * matrixA ∈ exteriorFormSpace
  rw [← transposeA_eq, ← ambientA_eq, leftA0336, rightA0336,
    ← reconstructA0336]
  exact combination_mem coefficientsA0336

