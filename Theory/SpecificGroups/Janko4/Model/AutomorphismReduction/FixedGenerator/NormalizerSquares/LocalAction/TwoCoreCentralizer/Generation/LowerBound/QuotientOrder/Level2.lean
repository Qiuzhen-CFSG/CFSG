private def point (i : Fin 8) : Row := row (points.get i)
private def parent (i : Fin 8) : Fin 8 := parents.get i
private def letter (i : Fin 8) : Fin 4 := letters.get i

private theorem parent_lt : ∀ i, i ≠ 0 → parent i < i := by decide +kernel

private theorem edge : ∀ i, i ≠ 0 →
    right (point (parent i)) (gen2 (letter i)) = point i := by
  have h : ∀ i, i ≠ 0 →
      packedRow (points.get (parent i)).toNat (genRows2 (letter i)) =
        (points.get i).toNat := by decide +kernel
  intro i hi
  change Matrix.vecMul (row (points.get (parent i))) (gen2 (letter i)).val =
    row (points.get i)
  rw [gen2_val]
  exact vecMul_eq_of_packed _ _ _ (h i hi)

private theorem point_injective : Function.Injective point := by
  have h : Function.LeftInverse (fun v : BitVec 12 => indices.get v.toFin) points.get := by
    decide +kernel
  exact row_injective.comp h.injective

theorem level2_bound : 8 ≤ Nat.card secondStabilizer := by
  have h := tree_card_mul_le secondStabilizer ⊥ bot_le gen2 gen2_mem
    point parent letter parent_lt edge point_injective
    (fun g => by
      have hg := g.property
      simp only [Subgroup.mem_bot] at hg
      simp only [hg, right_one])
  simpa using h

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.LowerBound.QuotientOrderCertificate
