module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreNormalizer.Comparison.QuotientAction
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Max2Bridge

/-!+# Reducing the order of the center of the literal J₄ two-core

Let C be the literal centralizer of `matrixUnitA` in `matrixGroup`, and let
Q = O₂(C). The distinguished involution belongs to Z(Q), so |Z(Q)| ≥ 2.

For the opposite bound, write H for the subgroup generated by the two
certified max2 words and N for the normal closure of their order-four seed
inside H. If H = C and N is a two-group, its image lies in Q. Thus an
element centralizing Q centralizes N. Centralizer control supplies its
square-one condition. A concrete calculation showing that the only
square-one elements of C_H(N) are 1 and the distinguished involution would
then give |Z(Q)| = 2.

The generation, two-group, and local involution calculation remain explicit
premises. In particular exponent two alone does not supply a cardinality
bound. No identification of N with Q is needed for this reduction.

Source: GLS3, Table 5.3i, printed p.270,
`refs/KGroup/GLS3/Chapter5(sec3-).tex`. The 2A centralizer has shape
Q₈⁶ # (3M₂₂ · 2). `Max2Bridge` certifies the conjugacy bridge to the
literal first generator; it does not assert generation or local structure.
-/

public section

namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreComparison

private theorem coe_mem_centralizer_of_mem_center {G : Type*} [Group G]
    (H : Subgroup G) {q : H} (hq : q ∈ Subgroup.center H) :
    (q : G) ∈ Subgroup.centralizer (H : Set G) := by
  intro n hn
  exact congrArg (fun x : H => (x : G)) (Subgroup.mem_center_iff.mp hq ⟨n, hn⟩)

/-- The literal first generator, now in the actual two-core. -/
@[expose] def twoCoreInvolution : involutionTwoCore :=
  ⟨centralInvolution, centralInvolution_mem_twoCore⟩

theorem twoCoreInvolution_mem_center :
    twoCoreInvolution ∈ Subgroup.center involutionTwoCore := by
  rw [Subgroup.mem_center_iff]
  intro q
  apply Subtype.ext
  exact Subgroup.mem_center_iff.mp centralInvolution_mem_center q

theorem orderOf_twoCoreInvolution : orderOf twoCoreInvolution = 2 := by
  rw [← orderOf_injective involutionTwoCore.subtype Subtype.val_injective]
  exact orderOf_centralInvolution

/-- The lower bound uses the actual involution and needs no local control premise. -/
theorem two_le_card_center : 2 ≤ Nat.card (Subgroup.center involutionTwoCore) := by
  calc
    2 = Nat.card (Subgroup.zpowers twoCoreInvolution) := by
      rw [Nat.card_zpowers, orderOf_twoCoreInvolution]
    _ ≤ Nat.card (Subgroup.center involutionTwoCore) :=
      Subgroup.card_le_of_le (Subgroup.zpowers_le.mpr twoCoreInvolution_mem_center)

/-- A sharp relative centralizer bound also bounds the intrinsic center of Q. -/
theorem center_card_two_of_centralizer_le
    (h : Subgroup.centralizer (involutionTwoCore : Set involutionCentralizer) ≤
      Subgroup.zpowers centralInvolution) :
    Nat.card (Subgroup.center involutionTwoCore) = 2 := by
  apply Nat.le_antisymm _ two_le_card_center
  have hle : (Subgroup.center involutionTwoCore).map involutionTwoCore.subtype ≤
      Subgroup.zpowers centralInvolution := by
    rintro z ⟨q, hq, rfl⟩
    exact h (coe_mem_centralizer_of_mem_center involutionTwoCore hq)
  calc
    Nat.card (Subgroup.center involutionTwoCore) =
        Nat.card ((Subgroup.center involutionTwoCore).map involutionTwoCore.subtype) :=
      (Subgroup.card_map_of_injective Subtype.val_injective).symm
    _ ≤ Nat.card (Subgroup.zpowers centralInvolution) := Subgroup.card_le_of_le hle
    _ = 2 := by rw [Nat.card_zpowers, orderOf_centralInvolution]

open TwoCoreCentralizerData in
/-- Conditional assembly using local generation, a normal two-subgroup, and
the concrete uniqueness of its centralizing involution. All three local
premises must be discharged to obtain the requested center-order theorem. -/
theorem center_card_two_of_max2_involutions
    (hcent : LocalTwoCoreCentralizerControl)
    (hgen : localSubgroup = ⊤)
    (hp : IsPGroup 2 localNormalClosure)
    (hinv : ∀ z ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup),
      z ^ 2 = 1 → z = 1 ∨ z = subgroupInvolution) :
    Nat.card (Subgroup.center involutionTwoCore) = 2 := by
  let e : localSubgroup ≃* involutionCentralizer :=
    (MulEquiv.subgroupCongr hgen).trans Subgroup.topEquiv
  let N := localNormalClosure.map e.toMonoidHom
  have hNn : N.Normal := localNormalClosure_normal.map e.toMonoidHom e.surjective
  have hNp : IsPGroup 2 N := hp.map e.toMonoidHom
  have hN : N ≤ involutionTwoCore := le_sSup ⟨hNn, hNp⟩
  apply center_card_two_of_centralizer_le
  intro z hz
  have hze : e.symm z ∈ Subgroup.centralizer
      (localNormalClosure : Set localSubgroup) := by
    intro n hn
    apply e.injective
    simpa only [map_mul, e.apply_symm_apply] using
      (Subgroup.centralizer_le hN hz) (e n) (Subgroup.mem_map.mpr ⟨n, hn, rfl⟩)
  have hpow : (e.symm z) ^ 2 = 1 := by
    apply e.injective
    simpa only [map_pow, map_one, e.apply_symm_apply] using hcent.2 z hz
  have he : e subgroupInvolution = centralInvolution := rfl
  rcases hinv (e.symm z) hze hpow with hi | hi
  · have hz1 : z = 1 := by
      simpa only [e.apply_symm_apply, map_one] using congrArg e hi
    rw [hz1]
    exact (Subgroup.zpowers centralInvolution).one_mem
  · have hza : z = centralInvolution := by
      simpa only [e.apply_symm_apply, he] using congrArg e hi
    rw [hza]
    exact Subgroup.mem_zpowers centralInvolution

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreComparison
