theorem checks080 (k : ℕ) (hlo : 80 ≤ k) (hhi : k < 96) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_080, dot_080⟩
  · exact ⟨transport_081, dot_081⟩
  · exact ⟨transport_082, dot_082⟩
  · exact ⟨transport_083, dot_083⟩
  · exact ⟨transport_084, dot_084⟩
  · exact ⟨transport_085, dot_085⟩
  · exact ⟨transport_086, dot_086⟩
  · exact ⟨transport_087, dot_087⟩
  · exact ⟨transport_088, dot_088⟩
  · exact ⟨transport_089, dot_089⟩
  · exact ⟨transport_090, dot_090⟩
  · exact ⟨transport_091, dot_091⟩
  · exact ⟨transport_092, dot_092⟩
  · exact ⟨transport_093, dot_093⟩
  · exact ⟨transport_094, dot_094⟩
  · exact ⟨transport_095, dot_095⟩

