module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.KernelBound.OrbitCover.KernelEquations.FiniteRestriction.Reconstruction.AffineData
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation.KernelBound.OrbitCover.KernelEquations.FiniteRestriction.QuadraticRelations.LinearMembership.Coordinates

/-!
# Witness coordinates for the affine restriction

The flag basis and two additional matrices are numerical witnesses from
the retained right-stabilizer calculation. The candidate space is defined
as the published affine direction space plus three scalar directions.
No containment of mixed-space preservers is asserted in this data module.
FlagChecks certifies the change of basis and triangular identities.

Source: ../source/README.md, flag_certificate.json and adjoint_algebra.json.
The latter matrices at zero-based indices 101 and 107 have scalar patterns
(1,0,0) and (0,1,0). ATLAS attribution and column convention are inherited
from Janko4/Model/Data.lean. All witness generation is untrusted.
-/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.Reconstruction.AffineCertificate
open LinearMembership GeneratorCertificates

def flagRows : Vector (ℕ) 50 :=
  ⟨#[1099511628801, 2199023257602, 4398046515204, 8796093030408, 17592186060816, 35184372121632, 70368744243264, 140737488486528, 281474976973056, 524488, 1049088, 2097517, 4194387, 562949961810495, 16778061, 33554744, 67109011, 134218527, 268435490, 536871352, 1073742030, 2147483655, 4294967307, 8589935150, 17179869653, 34359738923, 68719477043, 137438954460, 274877907100, 240, 549755814137, 26, 670, 534, 388, 255, 574, 739544993282, 334, 225, 223151008038, 1098576015938, 60566400808, 1021257342203, 534074692458, 959, 687142592023, 779336437817, 418396827592, 732740414606], rfl⟩

def flagInverseRows : Vector (ℕ) 50 :=
  ⟨#[35856534470656, 35504347152384, 586263035904, 372051542016, 35307315527680, 294742130688, 35242354147328, 367756574720, 932544774144, 947577159680, 129397107379712, 233000058439168, 303800833953280, 589430821818368, 968026591153664, 365957106288640, 148038297689088, 814455328736256, 460634201884160, 35246649115136, 947577160704, 904627488768, 855235366912, 435625228288000, 320511950848, 36109937573888, 35867271954432, 35257386663936, 35245038764032, 35743255232512, 878321860608, 405876506624, 552444362752, 35238604439552, 35775483740160, 105797124096, 35558638223360, 683570888704, 35833717456896, 36053029224448, 93678011862529, 267881635333634, 304318377512452, 589626779701256, 932896443026960, 365667732867104, 183267766934592, 814650212877440, 459771450328832, 471408748322816], rfl⟩

def scalarDirectionRows : Vector (ℕ) 2 :=
  ⟨#[, ], rfl⟩

def flagMatrix : RestrictionMatrix := rectDecode 50 flagRows
def flagInverse : RestrictionMatrix := rectDecode 50 flagInverseRows

def scalarDirection (k : Fin 2) : RestrictionMatrix :=
  fun i j => bit (scalarDirectionRows.get k) (50 * i.val + j.val)

/-- Conjugation to the displayed flag basis, defined before its inverse checks. -/
def flagConjugation : RestrictionMatrix →ₗ[ZMod 2] RestrictionMatrix where
  toFun S := flagInverse * S * flagMatrix
  map_add' S T := by simp only [Matrix.mul_add, Matrix.add_mul]
  map_smul' c S := by simp only [Matrix.mul_smul, Matrix.smul_mul, RingHom.id_apply]

/-- Identity and two directions separating the three scalar diagonal blocks. -/
def scalarLift : (Fin 3 → ZMod 2) →ₗ[ZMod 2] RestrictionMatrix where
  toFun a := a 0 • (1 : RestrictionMatrix) +
    a 1 • scalarDirection 0 + a 2 • scalarDirection 1
  map_add' a b := by
    simp only [Pi.add_apply, add_smul]
    abel
  map_smul' c a := by
    simp only [Pi.smul_apply, smul_add, smul_smul, RingHom.id_apply, smul_eq_mul]

/-- A concrete 127-generator candidate; its completeness is a separate obligation. -/
def candidateAlgebra : Submodule (ZMod 2) RestrictionMatrix :=
  affineDirections ⊔ LinearMap.range scalarLift

end Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.Reconstruction.AffineCertificate
