private def parent (i : Fin 165) : Fin 165 := parents.get i
private def letter (i : Fin 165) : Fin 4 := letters.get i

private theorem parent_lt : ∀ i, i ≠ 0 → parent i < i := by decide +kernel

private theorem edge : ∀ i, i ≠ 0 →
    right (point (parent i)) (gen1 (letter i)) = point i := by
  have h : ∀ i, i ≠ 0 →
      packedRow (points.get (parent i)).toNat (genRows1 (letter i)) =
        (points.get i).toNat := by decide +kernel
  intro i hi
  change Matrix.vecMul (row (points.get (parent i))) (gen1 (letter i)).val =
    row (points.get i)
  rw [gen1_val]
  exact vecMul_eq_of_packed _ _ _ (h i hi)

private theorem point_injective : Function.Injective point := by
  have h : Function.LeftInverse (fun v : BitVec 12 => indices.get v.toFin) points.get := by
    decide +kernel
  exact row_injective.comp h.injective

theorem level1_bound : 165 * Nat.card secondStabilizer ≤ Nat.card firstStabilizer := by
  apply tree_card_mul_le firstStabilizer secondStabilizer inf_le_left gen1 gen1_mem
    point parent letter parent_lt edge point_injective
  intro g
  exact g.property.2

