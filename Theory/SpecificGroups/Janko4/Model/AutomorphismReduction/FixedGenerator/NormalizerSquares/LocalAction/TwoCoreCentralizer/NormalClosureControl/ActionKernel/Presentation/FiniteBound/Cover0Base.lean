def representative (i : Nat) : Level0 := eval PresentedGroup.of (representativeWord i)

variable {G α : Type*} [_root_.Group G] {H : Subgroup G} {g : α → G} {ρ : Nat → G}

theorem appendFacts {i j k : Nat} {u v : Word α}
    (hu : Holds H g ρ ⟨i, u, j⟩) (hv : Holds H g ρ ⟨j, v, k⟩) :
    Holds H g ρ ⟨i, u ++ v, k⟩ := by
  obtain ⟨h, hh⟩ := hu
  obtain ⟨h', hh'⟩ := hv
  refine ⟨h * h', ?_⟩
  change ρ i * eval g (u ++ v) = (h.val * h'.val) * ρ k
  rw [eval_append, ← mul_assoc, hh, mul_assoc, hh', ← mul_assoc]

theorem scanFacts {i j k : Nat} {u v : Word α} {a : Letter α}
    (hu : Holds H g ρ ⟨i, u, j⟩) (hv : Holds H g ρ ⟨k, v, i⟩)
    (hw : Holds H g ρ ⟨i, (u ++ [a]) ++ v, i⟩) :
    Holds H g ρ ⟨j, [a], k⟩ := by
  obtain ⟨p, hp⟩ := hu
  obtain ⟨s, hs⟩ := hv
  obtain ⟨l, hl⟩ := hw
  change ρ i * eval g ((u ++ [a]) ++ v) = l.val * ρ i at hl
  change ρ i * eval g u = p.val * ρ j at hp
  change ρ k * eval g v = s.val * ρ i at hs
  refine ⟨p⁻¹ * l * s⁻¹, ?_⟩
  change ρ j * eval g [a] = (p.val⁻¹ * l.val * s.val⁻¹) * ρ k
  apply mul_right_cancel (b := eval g v)
  have hi : ρ i = s.val⁻¹ * (ρ k * eval g v) := by rw [hs]; simp
  have hj : ρ j = p.val⁻¹ * (ρ i * eval g u) := by rw [hp]; simp
  calc
    ρ j * eval g [a] * eval g v = p.val⁻¹ * (ρ i * eval g ((u ++ [a]) ++ v)) := by
      rw [hj, eval_append, eval_append]; simp only [mul_assoc]
    _ = (p.val⁻¹ * l.val * s.val⁻¹) * ρ k * eval g v := by
      rw [hl, hi]; simp only [mul_assoc]

private theorem generator_two :
    (PresentedGroup.of false : Level0) * PresentedGroup.of false = 1 := by
  have h := level0_relator 0
  change eval (PresentedGroup.of : Bool → Level0)
    [(false, true), (false, true)] = 1 at h
  simpa [eval_cons] using h

private theorem generator_three :
    (PresentedGroup.of true : Level0) * PresentedGroup.of true *
      PresentedGroup.of true = 1 := by
  have h := level0_relator 1
  change eval (PresentedGroup.of : Bool → Level0)
    [(true, true), (true, true), (true, true)] = 1 at h
  simpa [eval_cons, mul_assoc] using h

/-- An explicit subgroup tail supplies the required coset transition. -/
theorem special (i j : Nat) (a : Letter Bool) (tail : Word (Fin 7))
    (w : Word Bool) (flip : Bool) (shift : Nat)
    (he : LiftedRelations.adjust
      (FreeGroup.invRev ((representativeWord i ++ [a]) ++
        FreeGroup.invRev (representativeWord j)) ++
        LiftedRelations.substitute level0ChildWord tail) flip shift = w)
    (hw : LiftedRelations.Valid w) :
    Holds level0Subgroup PresentedGroup.of representative ⟨i, [a], j⟩ := by
  have hr := LiftedRelations.transfer (PresentedGroup.of : Bool → Level0)
    generator_two generator_three _ _ flip shift he hw
  rw [eval_append, eval_invRev, LiftedRelations.eval_substitute] at hr
  have ht : eval (PresentedGroup.of : Bool → Level0)
      ((representativeWord i ++ [a]) ++ FreeGroup.invRev (representativeWord j)) =
      eval level0Generator tail := inv_mul_eq_one.mp hr
  refine ⟨⟨eval level0Generator tail,
    eval_mem_of_generators_mem level0Subgroup level0Generator level0Generator_mem tail⟩, ?_⟩
  change eval (PresentedGroup.of : Bool → Level0) (representativeWord i) *
    eval PresentedGroup.of [a] =
    eval level0Generator tail * eval PresentedGroup.of (representativeWord j)
  simpa only [level0Generator, eval_append, eval_invRev, mul_assoc, inv_mul_cancel, mul_one] using
    congrArg (fun z : Level0 => z * eval (PresentedGroup.of : Bool → Level0)
      (representativeWord j)) ht

