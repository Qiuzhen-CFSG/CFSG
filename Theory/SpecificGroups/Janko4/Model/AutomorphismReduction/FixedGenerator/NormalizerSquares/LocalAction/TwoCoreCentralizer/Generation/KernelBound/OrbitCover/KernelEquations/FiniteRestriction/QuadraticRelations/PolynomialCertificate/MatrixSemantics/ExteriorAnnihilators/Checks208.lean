theorem checks208 (k : ℕ) (hlo : 208 ≤ k) (hhi : k < 224) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_208, dot_208⟩
  · exact ⟨transport_209, dot_209⟩
  · exact ⟨transport_210, dot_210⟩
  · exact ⟨transport_211, dot_211⟩
  · exact ⟨transport_212, dot_212⟩
  · exact ⟨transport_213, dot_213⟩
  · exact ⟨transport_214, dot_214⟩
  · exact ⟨transport_215, dot_215⟩
  · exact ⟨transport_216, dot_216⟩
  · exact ⟨transport_217, dot_217⟩
  · exact ⟨transport_218, dot_218⟩
  · exact ⟨transport_219, dot_219⟩
  · exact ⟨transport_220, dot_220⟩
  · exact ⟨transport_221, dot_221⟩
  · exact ⟨transport_222, dot_222⟩
  · exact ⟨transport_223, dot_223⟩

