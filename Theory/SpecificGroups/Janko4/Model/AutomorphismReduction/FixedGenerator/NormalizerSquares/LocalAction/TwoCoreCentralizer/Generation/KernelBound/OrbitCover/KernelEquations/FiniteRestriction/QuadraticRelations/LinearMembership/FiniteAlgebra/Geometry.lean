/-! Arithmetic certificates for the mixed-space annihilators and source rows.
See ../source/README.md for the exact finite contract and ATLAS conventions. -/

@[expose] public section
open scoped Matrix
namespace Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.Generation.KernelBound.OrbitCoverCoordinates.LinearMembership.FiniteAlgebra
open GeneratorCertificates

private theorem vectors_eq {α : Type*} {n : ℕ} (xs ys : α → Vector ℕ n)
    (h : ∀ i j, (xs i).get j = (ys i).get j) : ∀ i, xs i = ys i := by
  intro i
  apply Vector.ext
  intro j hj
  exact h i ⟨j,hj⟩

private theorem vector_eq {n : ℕ} (xs ys : Vector ℕ n)
    (h : ∀ j, xs.get j = ys.get j) : xs = ys := by
  apply Vector.ext
  intro j hj
  exact h ⟨j,hj⟩

/-- Apply a row block through an abstract predicate, so index transport never
unfolds the large concrete matrix tables. -/
private theorem block_apply {n a d : ℕ} (P : Fin n → Prop) (had : a + d ≤ n)
    (h : ∀ j : Fin d, P ⟨a + j.val, by omega⟩)
    (i : Fin n) (ha : a ≤ i.val) (hi : i.val < a + d) : P i := by
  have heq : (⟨a + (i.val - a), by omega⟩ : Fin n) = i := by
    apply Fin.ext
    change a + (i.val - a) = i.val
    omega
  simpa only [heq] using h ⟨i.val - a, by omega⟩

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem mixedMasks_checked : ∀ i : Fin 40,
    slices 12 50 (mixedMasks.get i) = mixedGeneratorRows.get i := by
  apply vectors_eq
  simp only [slices, get_ofFn]
  decide +kernel

