private theorem choiceLookup_flatten : choiceBlocks.flatten.take 2373 = sourceChoice := by
  apply Vector.toList_inj.mp
  rw [Vector.toList_take]
  change ((choiceBlocks.toArray.map Vector.toArray).flatten.toList).take 2373 = sourceChoice.toList
