theorem checks016 (k : ℕ) (hlo : 16 ≤ k) (hhi : k < 32) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_016, dot_016⟩
  · exact ⟨transport_017, dot_017⟩
  · exact ⟨transport_018, dot_018⟩
  · exact ⟨transport_019, dot_019⟩
  · exact ⟨transport_020, dot_020⟩
  · exact ⟨transport_021, dot_021⟩
  · exact ⟨transport_022, dot_022⟩
  · exact ⟨transport_023, dot_023⟩
  · exact ⟨transport_024, dot_024⟩
  · exact ⟨transport_025, dot_025⟩
  · exact ⟨transport_026, dot_026⟩
  · exact ⟨transport_027, dot_027⟩
  · exact ⟨transport_028, dot_028⟩
  · exact ⟨transport_029, dot_029⟩
  · exact ⟨transport_030, dot_030⟩
  · exact ⟨transport_031, dot_031⟩

