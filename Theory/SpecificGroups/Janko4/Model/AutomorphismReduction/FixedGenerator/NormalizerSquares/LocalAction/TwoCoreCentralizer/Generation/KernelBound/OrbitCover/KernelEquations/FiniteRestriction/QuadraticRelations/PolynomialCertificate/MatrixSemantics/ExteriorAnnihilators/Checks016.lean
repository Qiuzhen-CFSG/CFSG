private theorem transport_016 : ∀ i : Fin 112,
    transportRow (weights.get 16) i = flatRow (duals.get 16) i.val := by
  change ∀ i : Fin 112, transportRow  i = flatRow  i.val
  decide +kernel

set_option maxRecDepth 10000 in
private theorem dot_016 : ∀ a : Fin 1221,
    flatDot (duals.get 16) (basisFlat a.val) = false := by
  change ∀ a : Fin 1221, flatDot  (basisFlat a.val) = false
  decide +kernel

