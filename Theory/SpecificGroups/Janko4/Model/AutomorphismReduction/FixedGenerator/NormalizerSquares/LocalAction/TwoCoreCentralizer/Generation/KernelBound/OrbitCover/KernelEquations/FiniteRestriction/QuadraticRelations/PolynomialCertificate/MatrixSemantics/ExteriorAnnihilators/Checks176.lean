theorem checks176 (k : ℕ) (hlo : 176 ≤ k) (hhi : k < 192) (hk : k < 237) :
    (∀ i : Fin 112, transportRow (weights.get ⟨k, hk⟩) i =
      flatRow (duals.get ⟨k, hk⟩) i.val) ∧
    (∀ a : Fin 1221, flatDot (duals.get ⟨k, hk⟩) (basisFlat a.val) = false) := by
  interval_cases k
  · exact ⟨transport_176, dot_176⟩
  · exact ⟨transport_177, dot_177⟩
  · exact ⟨transport_178, dot_178⟩
  · exact ⟨transport_179, dot_179⟩
  · exact ⟨transport_180, dot_180⟩
  · exact ⟨transport_181, dot_181⟩
  · exact ⟨transport_182, dot_182⟩
  · exact ⟨transport_183, dot_183⟩
  · exact ⟨transport_184, dot_184⟩
  · exact ⟨transport_185, dot_185⟩
  · exact ⟨transport_186, dot_186⟩
  · exact ⟨transport_187, dot_187⟩
  · exact ⟨transport_188, dot_188⟩
  · exact ⟨transport_189, dot_189⟩
  · exact ⟨transport_190, dot_190⟩
  · exact ⟨transport_191, dot_191⟩

