/-- All elimination rows vanish whenever the selected source equations vanish. -/
theorem trace_vanish (x : Fin 2500 → ZMod 2)
    (hraw : ∀ k, ev x (rawMasks.get k) = 0) :
    ∀ i, ev x (traceRows.get i) = 0 := by
  let base : Vector ℕ 4750 := Vector.ofFn (fun i =>
    if i.val < 2375 then rawMasks.toArray[i.val]! else 0)
  let parents : Vector (List ℕ) 4750 := Vector.ofFn (fun i =>
    (traceParentBlocks.get ⟨i.val / 50, by omega⟩).get ⟨i.val % 50, by omega⟩)
  apply trace_sound x traceRows base parents
  · intro i
    simp only [base, get_ofFn]
    split_ifs with h
    · rw [getElem!_pos rawMasks.toArray i.val (by simpa using h)]
      exact hraw ⟨i.val,h⟩
    · exact ev_zero x
  · intro i
    have h := traceBlocks_checked ⟨i.val / 50, by omega⟩ ⟨i.val % 50, by omega⟩
    have hi : 50 * (i.val / 50) + i.val % 50 = i.val := by omega
    simp only [base, parents, get_ofFn]
    simpa only [Fin.val_mk, hi, Vector.get, Fin.val_cast,
      getElem!_pos traceRows.toArray i.val (by simp)] using h

