/-- The finite equations express every solution in the displayed kernel family. -/
theorem kernel_reconstruct (x : Fin 2500 → ZMod 2)
    (hraw : ∀ k, ev x (rawMasks.get k) = 0) :
    x = ∑ k : Fin 125, x (freeEntries.get k) • (fun i => bit (kernelMasks.get k) i.val) := by
  apply reconstruct x freeEntries kernelMasks reducedRow _ reducedRows_checked
  intro i
  unfold reducedRow
  by_cases h : reducedIndex.get i < 4750
  · rw [getElem!_pos traceRows.toArray (reducedIndex.get i) (by simpa using h)]
    exact trace_vanish x hraw ⟨reducedIndex.get i,h⟩
  · rw [getElem!_neg traceRows.toArray (reducedIndex.get i) (by simpa using h)]
    exact ev_zero x

