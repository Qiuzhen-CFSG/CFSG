module

public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.Max1RelativeRigidity.Core
public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.QuotientInvolutions
public import Theory.SpecificGroups.Janko4.Model.Simplicity.PrimeCoverage.Involutions.Max1Fusion.InvolutionFibers.Data
import Mathlib.Tactic.Group


/-!
# A one-line commutator image detects the actual max1 kernel

Let M be the literal ATLAS max1 subgroup and K its certified elementary
abelian kernel. If right conjugation by c has every displacement in the line
generated by the marked kernel pair, then c belongs to K.

An automorphism whose displacements lie in a binary line fixes that line and
squares to the identity. Faithfulness of the actual quotient action therefore
makes the image of c either trivial or an involution. Quotient conjugacy
preserves the two-value displacement bound. For each of the two certified
quotient involution representatives, two basis vectors have distinct nonzero
displacements, contradicting that bound. Their masks are 3 and 12 for x,
and 1795 and 1738 for (xy)^7. Mask injectivity certifies these distinctions in K.

The argument uses right conjugation, represented by the inverse element in
the descended left-conjugation action. It does not require a splitting of M.
The power-action calculation follows `Max1Fusion.InvolutionFibers`; its
published `qMasks_basis` certificate supplies the seventh-power action.

Source: literal ATLAS `J4G1-max1W1`, documented in `Cardinality.Subgroup`;
local structure motivation: GLS3, Table 5.3i.
-/

public section
namespace Janko4.Max1RelativeRigidity
open Cardinality Cardinality.KernelCount Cardinality.QuotientCount.Image
open Simplicity.Max1Fusion Simplicity.Max1Fusion.KernelOrbits
attribute [local irreducible] basis modelGroup matrixA matrixB localKernel
  max1Subgroup localX localY localKernelSeed

/-- The identity and one involution contain every displacement. -/
private def TwoValues {G : Type*} [Group G] (f : MulAut G) : Prop :=
  ∃ t : G, t * t = 1 ∧ ∀ e, f e = e ∨ f e = t * e

private theorem twoValues_square {G : Type*} [Group G] (f : MulAut G)
    (h : TwoValues f) : f ^ 2 = 1 := by
  obtain ⟨t, ht, h⟩ := h
  have hfix : f t = t := by
    rcases h t with h | h
    · exact h
    · have h1 : f t = 1 := h.trans ht
      have ht1 : t = 1 := f.injective (h1.trans (map_one f).symm)
      simpa only [ht1] using map_one f
  apply MulEquiv.ext
  intro e
  change f (f e) = e
  rcases h e with he | he
  · rw [he, he]
  · rw [he, map_mul, hfix, he, ← mul_assoc, ht, one_mul]

private theorem twoValues_conjugate {G : Type*} [Group G] (f a : MulAut G)
    (h : TwoValues f) : TwoValues (a * f * a⁻¹) := by
  obtain ⟨t, ht, h⟩ := h
  refine ⟨a t, ?_, ?_⟩
  · rw [← map_mul, ht, map_one]
  · intro e
    rcases h (a⁻¹ e) with he | he
    · exact Or.inl (by simpa using congrArg a he)
    · exact Or.inr (by simpa only [map_mul, MulAut.mul_apply,
        MulAut.apply_inv_self] using congrArg a he)

private theorem mem_zpowers_pair {G : Type*} [Group G] (t : G) (ht : t ^ 2 = 1)
    {e : G} (he : e ∈ Subgroup.zpowers t) : e = 1 ∨ e = t := by
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp he
  rw [zpow_eq_zpow_emod' n ht]
  have hn : n % 2 = 0 ∨ n % 2 = 1 := by omega
  rcases hn with hn | hn
  · norm_num [hn]
  · norm_num [hn]

/-- The genuine quotient action, retaining its multiplication on K. -/
private def quotientConj : M ⧸ K →* MulAut K :=
  QuotientGroup.lift K MulAut.conjNormal (by
    intro n hn
    apply MulEquiv.ext
    intro e
    have ha : Cardinality.QuotientCount.action matrixA_mul_self matrixB_pow_four n = 1 := by
      exact (show n ∈ (Cardinality.QuotientCount.action matrixA_mul_self matrixB_pow_four).ker from
        (LocalStructure.action_ker_eq_localKernel matrixA_mul_self matrixB_pow_four).symm ▸ hn)
    exact congrArg (fun f : Equiv.Perm K => f e) ha)

private theorem quotientConj_injective : Function.Injective quotientConj := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply le_antisymm _ bot_le
  intro q hq
  induction q using QuotientGroup.induction_on with
  | H c =>
    apply (QuotientGroup.eq_one_iff c).mpr
    change c ∈ localKernel matrixA_mul_self matrixB_pow_four
    rw [← LocalStructure.action_ker_eq_localKernel matrixA_mul_self matrixB_pow_four]
    change Cardinality.QuotientCount.action matrixA_mul_self matrixB_pow_four c = 1
    apply Equiv.ext
    intro e
    exact congrArg (fun f : MulAut K => f e) hq

private theorem quotientConj_right (c : M) (e : K) :
    (quotientConj ((QuotientGroup.mk' K c)⁻¹) e : M) = c⁻¹ * (e : M) * c := by
  change c⁻¹ * (e : M) * (c⁻¹)⁻¹ = _
  rw [inv_inv]

private abbrev E (m : ℕ) : K := maskValue matrixA_mul_self matrixB_pow_four m

private theorem E_zero : E 0 = 1 := maskValue_zero _ _

private theorem E_xor (m n : ℕ) : E (Nat.xor m n) = E m * E n :=
  maskValue_xor _ _ m n

private theorem E_inv (m : ℕ) : (E m)⁻¹ = E m := by
  apply inv_eq_of_mul_eq_one_left
  rw [← E_xor, show Nat.xor m m = 0 from Nat.xor_self m, E_zero]

private theorem E_injective {m n : ℕ} (hm : m < 2048) (hn : n < 2048)
    (h : E m = E n) : m = n :=
  congrArg Fin.val (@maskValue_injective ⟨m, hm⟩ ⟨n, hn⟩ h)

private theorem right_conj_xy_pow (n m : ℕ) :
    ((x * y)^n)⁻¹ * (E m : M) * (x * y)^n =
      (E ((Simplicity.Max1Fusion.InvolutionFibers.xyAction^[n]) m) : M) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ]
    calc
      _ = y⁻¹ * (x⁻¹ * (((x * y)^n)⁻¹ * (E m : M) * (x * y)^n) * x) * y := by
        group
      _ = _ := by
        rw [ih, right_conj_mask_x, right_conj_mask_y]
        exact congrArg (fun k => (E k : M))
          (Function.iterate_succ_apply' Simplicity.Max1Fusion.InvolutionFibers.xyAction n m).symm

private theorem displacement_x (m : ℕ) :
    quotientConj ((QuotientGroup.mk' K x)⁻¹) (E m) * (E m)⁻¹ =
      E (Nat.xor (maskImage xMasks m) m) := by
  have h : quotientConj ((QuotientGroup.mk' K x)⁻¹) (E m) = E (maskImage xMasks m) := by
    apply Subtype.ext
    rw [quotientConj_right]
    exact right_conj_mask_x _ _ m
  rw [h, E_inv, ← E_xor]

private theorem displacement_xy_seven (i : Fin 11) :
    quotientConj ((QuotientGroup.mk' K ((x * y)^7))⁻¹) (E (2 ^ i.val)) *
      (E (2 ^ i.val))⁻¹ =
      E (Nat.xor (Simplicity.Max1Fusion.InvolutionFibers.qMasks i) (2 ^ i.val)) := by
  have h : quotientConj ((QuotientGroup.mk' K ((x * y)^7))⁻¹) (E (2 ^ i.val)) =
      E (Simplicity.Max1Fusion.InvolutionFibers.qMasks i) := by
    apply Subtype.ext
    rw [quotientConj_right, right_conj_xy_pow,
      Simplicity.Max1Fusion.InvolutionFibers.qMasks_basis]
  rw [h, E_inv, ← E_xor]

private theorem twoValues_displacement {G : Type*} [Group G] (f : MulAut G)
    (h : TwoValues f) (a b : G) :
    f a * a⁻¹ = 1 ∨ f b * b⁻¹ = 1 ∨ f a * a⁻¹ = f b * b⁻¹ := by
  obtain ⟨t, _, h⟩ := h
  rcases h a with ha | ha
  · exact Or.inl (by rw [ha, mul_inv_cancel])
  rcases h b with hb | hb
  · exact Or.inr (Or.inl (by rw [hb, mul_inv_cancel]))
  · exact Or.inr (Or.inr (by rw [ha, hb]; simp only [mul_inv_cancel_right]))

private theorem distinct_masks_contradiction {m n : ℕ}
    (hm : m < 2048) (hn : n < 2048) (hm0 : m ≠ 0) (hn0 : n ≠ 0) (hmn : m ≠ n)
    (h : E m = 1 ∨ E n = 1 ∨ E m = E n) : False := by
  rw [← E_zero] at h
  rcases h with h | h | h
  · exact hm0 (E_injective hm (by decide) h)
  · exact hn0 (E_injective hn (by decide) h)
  · exact hmn (E_injective hm hn h)

-- Only two nonzero displacements are needed; no full rank computation is used.
private theorem not_twoValues_x :
    ¬ TwoValues (quotientConj ((QuotientGroup.mk' K x)⁻¹)) := by
  intro h
  have hd := twoValues_displacement _ h (E 1) (E 4)
  rw [displacement_x, displacement_x] at hd
  have h1 : Nat.xor (maskImage xMasks 1) 1 = 3 := by decide +kernel
  have h4 : Nat.xor (maskImage xMasks 4) 4 = 12 := by decide +kernel
  rw [h1, h4] at hd
  exact distinct_masks_contradiction (by decide) (by decide)
    (by decide) (by decide) (by decide) hd

private theorem not_twoValues_xy_seven :
    ¬ TwoValues (quotientConj ((QuotientGroup.mk' K ((x * y)^7))⁻¹)) := by
  intro h
  have hd := twoValues_displacement _ h (E (2^((1 : Fin 11).val)))
    (E (2^((2 : Fin 11).val)))
  rw [displacement_xy_seven, displacement_xy_seven] at hd
  have h1 : Nat.xor (Simplicity.Max1Fusion.InvolutionFibers.qMasks 1) (2^((1 : Fin 11).val)) =
      1795 := by decide +kernel
  have h2 : Nat.xor (Simplicity.Max1Fusion.InvolutionFibers.qMasks 2) (2^((2 : Fin 11).val)) =
      1738 := by decide +kernel
  rw [h1, h2] at hd
  exact distinct_masks_contradiction (by decide) (by decide)
    (by decide) (by decide) (by decide) hd

private theorem twoValues_of_commutator_image (c : M)
    (h : ∀ e : K, c⁻¹ * (e : M) * c * (e : M)⁻¹ ∈ Subgroup.zpowers v) :
    TwoValues (quotientConj ((QuotientGroup.mk' K c)⁻¹)) := by
  refine ⟨E 3, ?_, ?_⟩
  · rw [← E_xor, show Nat.xor 3 3 = 0 by decide, E_zero]
  · intro e
    rcases mem_zpowers_pair v (kernelPair_sq _ _) (h e) with he | he
    · apply Or.inl
      apply Subtype.ext
      rw [quotientConj_right]
      exact mul_inv_eq_one.mp he
    · apply Or.inr
      apply Subtype.ext
      rw [quotientConj_right]
      change c⁻¹ * (e : M) * c = (E 3 : M) * (e : M)
      rw [show (E 3 : M) = v from maskValue_three _ _]
      exact mul_inv_eq_iff_eq_mul.mp he

/-- A right-commutator image contained in the marked binary line forces
membership in the actual local kernel. -/
theorem mem_kernel_of_commutator_image (c : M)
    (h : ∀ e : K, c⁻¹ * (e : M) * c * (e : M)⁻¹ ∈ Subgroup.zpowers v) : c ∈ K := by
  have hc := twoValues_of_commutator_image c h
  have hs : ((QuotientGroup.mk' K c)⁻¹)^2 = 1 := by
    apply quotientConj_injective
    rw [map_pow, twoValues_square _ hc, map_one]
  have hs' : (QuotientGroup.mk' K c)^2 = 1 := by
    simpa only [inv_pow, inv_eq_one] using hs
  by_contra hn
  have hne : QuotientGroup.mk' K c ≠ 1 := by
    intro he
    exact hn ((QuotientGroup.eq_one_iff c).mp he)
  obtain ⟨g, hg | hg⟩ := quotient_involution_coverage matrixA_mul_self matrixB_pow_four
    (QuotientGroup.mk' K c) (orderOf_eq_prime hs' hne)
  · apply not_twoValues_x
    have hc' := twoValues_conjugate _ (quotientConj g) hc
    simpa only [hg, mul_inv_rev, inv_inv, map_mul, map_inv, mul_assoc] using hc'
  · apply not_twoValues_xy_seven
    have hc' := twoValues_conjugate _ (quotientConj g) hc
    simpa only [hg, mul_inv_rev, inv_inv, map_mul, map_inv, mul_assoc] using hc'

end Janko4.Max1RelativeRigidity
