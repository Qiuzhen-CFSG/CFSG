set_option maxHeartbeats 1000000 in
private theorem selected_columns : ∀ i j : Fin 112,
    decodeRows leftRows i j =
      (decodeRows (basisRows (selectedGenerator.get j)) + 1) i (selectedCoordinate.get j) := by
  change ∀ i j : Fin 112,
    (if (leftRows.get i).testBit j.val then (1 : ZMod 2) else 0) =
      (if ((basisRows (selectedGenerator.get j)).get i).testBit
        (selectedCoordinate.get j).val then 1 else 0) +
      (if i = selectedCoordinate.get j then 1 else 0)
  decide +kernel

set_option maxHeartbeats 1000000 in
private theorem product_packed : packedMul leftRows rightRows = projectionRows := by
  apply packed_of_list
  decide +kernel

set_option maxHeartbeats 1000000 in
private theorem projection_packed : ∀ i : Fin 112,
    projectionRows.get i = 2 ^ i.val ^^^
      (if i = 0 then 1383886125678978288045195946262397 else 0) := by
  decide +kernel

private theorem projection_matrix :
    decodeRows projectionRows =
      1 + vecMulVec (Pi.single (0 : Fin 112) (1 : ZMod 2)) cosetBaseVector := by
  funext i j
  change bit (projectionRows.get i) j.val = _
  rw [projection_packed, bit_xor]
  have hone : bit (2 ^ i.val) j.val = (1 : BinaryMatrix) i j := by
    simpa only [decodeRows, packedOne, get_ofFn] using
      congrFun (congrFun decode_packedOne i) j
  rw [hone]
  simp only [Matrix.add_apply, Matrix.vecMulVec_apply]
  congr 1
  by_cases hi : i = 0
  · subst i
    simp only [ite_true, Pi.single_eq_same, one_mul]
    rfl
  · simp [hi, bit]


attribute [local irreducible] leftRows rightRows projectionRows basisRows
  selectedGenerator selectedCoordinate cosetBaseVector

private theorem fixed_row_eq_of_columns
    (B : Fin 11 → Janko4.BinaryMatrix) (L R : Janko4.BinaryMatrix)
    (f : Fin 112 → Fin 11) (c : Fin 112 → Fin 112)
    (w v : Janko4.Cardinality.CosetVector)
    (hc : ∀ i j, L i j = (B (f j) + 1) i (c j))
    (hp : L * R = 1 + vecMulVec (Pi.single (0 : Fin 112) (1 : ZMod 2)) w)
    (hv : ∀ i, v ᵥ* B i = v) : v = v 0 • w := by
  have hz : v ᵥ* L = 0 := by
    funext j
    have he : (v ᵥ* L) j = (v ᵥ* (B (f j) + 1)) (c j) := by
      change (∑ i : Fin 112, v i * L i j) = ∑ i : Fin 112, v i * (B (f j) + 1) i (c j)
      apply Finset.sum_congr rfl
      intro i _
      rw [hc]
    rw [he, vecMul_add, hv, vecMul_one]
    exact CharTwo.add_self_eq_zero _
  have he : v ᵥ* (1 + vecMulVec (Pi.single (0 : Fin 112) (1 : ZMod 2)) w) = 0 := by
    rw [← hp, ← vecMul_vecMul, hz, zero_vecMul]
  rw [vecMul_add, vecMul_one, vecMul_vecMulVec, dotProduct_single_one] at he
  funext j
  exact CharTwo.add_eq_zero.mp (congrFun he j)

/-- The eleven actual kernel matrices have a single common fixed line. -/
public theorem fixed_row_eq (v : CosetVector)
    (hv : ∀ i : Fin 11, v ᵥ* decodeRows (basisRows i) = v) :
    v = v 0 • cosetBaseVector := by
  apply fixed_row_eq_of_columns (fun i => decodeRows (basisRows i))
    (decodeRows leftRows) (decodeRows rightRows)
    selectedGenerator.get selectedCoordinate.get cosetBaseVector v selected_columns _ hv
  rw [← decode_packedMul, product_packed, projection_matrix]

