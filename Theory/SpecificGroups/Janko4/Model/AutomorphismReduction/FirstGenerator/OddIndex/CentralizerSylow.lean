module
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.Generation
public import Theory.SpecificGroups.Janko4.Model.AutomorphismReduction.FixedGenerator.NormalizerSquares.LocalAction.TwoCoreCentralizer.NormalClosureControl
public import Theory.GroupTheory.CentralizerSylowPromotion

/-!
# Ambient Sylow two-subgroups from the literal J₄ involution centralizer

The certified max2 generators generate the entire centralizer C(a). Transport
of their seed normal closure therefore gives a normal two-subgroup N of C(a)
with C_C(a)(N) = ⟨a⟩ and a ∈ N. Every Sylow two-subgroup P of C(a) contains N,
so the center of its actual ambient image is exactly ⟨a⟩. Its normalizer fixes
a, and the centralizer Sylow-promotion theorem identifies that image with an
ambient Sylow subgroup, without conjugating it.

The matching certified lower and upper bounds give |C(a)| = 21799895040.
Its two-part is 2²¹, hence every ambient Sylow two-subgroup has order 2²¹.
No simplicity, perfectness, full model order, or automorphism conclusion is
used. Normality of N is only asserted inside C(a).

Source motivation: GLS3 Table 5.3i, printed p.270,
`refs/KGroup/GLS3/Chapter5(sec3-).tex`. The concrete matrices, max2 words, and
conjugacy bridge retain their ATLAS attribution in `TwoCoreCentralizer.Max2Bridge`.
-/

public section

open Janko4 Janko4.OuterReduction
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData

namespace Janko4.OuterReduction.OddIndex

attribute [local irreducible] modelGroup matrixA matrixB

private noncomputable def localEquivCentralizer :
    localSubgroup ≃* Subgroup.centralizer ({a} : Set Model) :=
  ((MulEquiv.subgroupCongr localSubgroup_eq_top).trans Subgroup.topEquiv).trans
    ((MonoidHom.ofInjective centralizerToModel_injective).trans
      (MulEquiv.subgroupCongr centralizerToModel_range))

@[simp] private theorem localEquivCentralizer_apply (x : localSubgroup) :
    (localEquivCentralizer x : Model) = centralizerToModel x := rfl

@[simp] private theorem localEquivCentralizer_involution :
    (localEquivCentralizer subgroupInvolution : Model) = a := rfl

private noncomputable def centralizerNormalClosure : Subgroup (Subgroup.centralizer ({a} : Set Model)) :=
  localNormalClosure.map localEquivCentralizer.toMonoidHom

private instance centralizerNormalClosure_normal : centralizerNormalClosure.Normal :=
  Subgroup.Normal.map inferInstance _ localEquivCentralizer.surjective

private theorem centralizerNormalClosure_isPGroup : IsPGroup 2 centralizerNormalClosure :=
  localNormalClosure_isPGroup.map _

private theorem centralizerNormalClosure_centralizer :
    Subgroup.centralizer (centralizerNormalClosure :
      Set (Subgroup.centralizer ({a} : Set Model))) =
      Subgroup.zpowers (localEquivCentralizer subgroupInvolution) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨y, rfl⟩ := localEquivCentralizer.surjective x
    have hy : y ∈ Subgroup.centralizer (localNormalClosure : Set localSubgroup) := by
      intro z hz
      apply localEquivCentralizer.injective
      simpa only [map_mul] using
        hx (localEquivCentralizer z) (Subgroup.mem_map_of_mem _ hz)
    rw [localNormalClosure_centralizer_eq_zpowers] at hy
    have hmap := Subgroup.mem_map_of_mem localEquivCentralizer.toMonoidHom hy
    rwa [MonoidHom.map_zpowers] at hmap
  · apply Subgroup.zpowers_le.mpr
    rintro _ ⟨z, hz, rfl⟩
    have hi : subgroupInvolution ∈
        Subgroup.centralizer (localNormalClosure : Set localSubgroup) := by
      rw [localNormalClosure_centralizer_eq_zpowers]
      exact Subgroup.mem_zpowers _
    exact (localEquivCentralizer.map_mul z subgroupInvolution).symm.trans
      ((congrArg localEquivCentralizer (hi z hz)).trans
        (localEquivCentralizer.map_mul subgroupInvolution z))

/-- The full literal matrix centralizer has the certified max2 order. -/
theorem centralizer_card : Nat.card involutionCentralizer = 21799895040 := by
  apply Nat.le_antisymm
  · exact Generation.centralizer_card_le_of_homology_bounds
      Generation.homologyAction_kernel_card_le Generation.homologyAction_image_card_le
  · exact (sourceSubgroup_card_ge.trans_eq card_sourceSubgroup_eq_localSubgroup).trans
      localSubgroup.card_le_card_group

/-- The same exact order for the centralizer inside the original model carrier. -/
theorem modelCentralizer_card :
    Nat.card (Subgroup.centralizer ({a} : Set Model)) = 21799895040 := by
  calc
    _ = Nat.card involutionCentralizer :=
      Nat.card_congr ((MonoidHom.ofInjective centralizerToModel_injective).trans
        (MulEquiv.subgroupCongr centralizerToModel_range)).toEquiv.symm
    _ = _ := centralizer_card

/-- The embedded center of every local Sylow subgroup is generated by the original involution. -/
theorem centralizer_sylow_center
    (P : Sylow 2 (Subgroup.centralizer ({a} : Set Model))) :
    let U := (P : Subgroup (Subgroup.centralizer ({a} : Set Model))).map
      (Subgroup.centralizer ({a} : Set Model)).subtype
    (Subgroup.center U).map U.subtype = Subgroup.zpowers a := by
  let C := Subgroup.centralizer ({a} : Set Model)
  let U : Subgroup Model := (P : Subgroup C).map C.subtype
  let z : C := localEquivCentralizer subgroupInvolution
  have hz : (z : Model) = a := localEquivCentralizer_involution
  have hNP : centralizerNormalClosure ≤ P :=
    centralizerNormalClosure_isPGroup.le_sylow_of_normal P
  have hzN : z ∈ centralizerNormalClosure :=
    Subgroup.mem_map_of_mem _ subgroupInvolution_mem_normalClosure
  have hzU : a ∈ U := ⟨z, hNP hzN, hz⟩
  have hmap : (Subgroup.zpowers z).map C.subtype = Subgroup.zpowers a := by
    rw [MonoidHom.map_zpowers]
    exact congrArg Subgroup.zpowers hz
  apply le_antisymm
  · rintro x ⟨y, hy, rfl⟩
    have hyC : (y : Model) ∈ C := Subgroup.map_subtype_le _ y.property
    let yC : C := ⟨y, hyC⟩
    have hyN : yC ∈ Subgroup.centralizer (centralizerNormalClosure : Set C) := by
      intro n hn
      have hnU : (n : Model) ∈ U := ⟨n, hNP hn, rfl⟩
      apply Subtype.ext
      exact congrArg (fun t : U => (t : Model))
        (Subgroup.mem_center_iff.mp hy ⟨n, hnU⟩)
    have hyz : yC ∈ Subgroup.zpowers z :=
      centralizerNormalClosure_centralizer ▸ hyN
    rw [← hmap]
    exact Subgroup.mem_map_of_mem C.subtype hyz
  · apply Subgroup.zpowers_le.mpr
    refine ⟨⟨a, hzU⟩, ?_, rfl⟩
    apply Subgroup.mem_center_iff.mpr
    intro y
    exact Subtype.ext (Subgroup.mem_centralizer_singleton_iff.mp
      (Subgroup.map_subtype_le _ y.property))

/-- Every Sylow two-subgroup of C(a) is ambient Sylow under the given inclusion. -/
theorem centralizer_sylow_is_ambient
    (P : Sylow 2 (Subgroup.centralizer ({a} : Set Model))) :
    ∃ S : Sylow 2 Model, (S : Subgroup Model) =
      (P : Subgroup (Subgroup.centralizer ({a} : Set Model))).map
        (Subgroup.centralizer ({a} : Set Model)).subtype :=
  Subgroup.exists_ambient_sylow_of_centralizer_center a orderOf_a P
    (centralizer_sylow_center P)

/-- The exact two-part of the certified involution centralizer order. -/
theorem centralizer_sylow_card
    (P : Sylow 2 (Subgroup.centralizer ({a} : Set Model))) :
    Nat.card P = 2 ^ 21 := by
  rw [P.card_eq_multiplicity, modelCentralizer_card]
  decide +kernel

/-- Every Sylow two-subgroup of the actual matrix model has order 2²¹. -/
theorem ambient_sylow_card (S : Sylow 2 Model) : Nat.card S = 2 ^ 21 := by
  obtain ⟨P⟩ := Sylow.nonempty (p := 2) (G := Subgroup.centralizer ({a} : Set Model))
  obtain ⟨T, hT⟩ := centralizer_sylow_is_ambient P
  calc
    Nat.card S = Nat.card T := Nat.card_congr (S.equiv T).toEquiv
    _ = Nat.card ((P : Subgroup (Subgroup.centralizer ({a} : Set Model))).map
        (Subgroup.centralizer ({a} : Set Model)).subtype) := by rw [← hT]
    _ = Nat.card P := Subgroup.card_map_of_injective Subtype.val_injective
    _ = 2 ^ 21 := centralizer_sylow_card P

/-- The model order is not divisible by 2²², without any simplicity hypothesis. -/
theorem model_two_part_bound : ¬ 2 ^ 22 ∣ Nat.card Model := by
  obtain ⟨S⟩ := Sylow.nonempty (p := 2) (G := Model)
  intro h
  have hd := S.pow_dvd_card_of_pow_dvd_card h
  rw [ambient_sylow_card S] at hd
  norm_num at hd

end Janko4.OuterReduction.OddIndex
