set_option maxHeartbeats 800000 in
theorem product_00 : packedMul Janko4.Simplicity.Max1Fusion.SeedCertificates.va4Rows Janko4.Simplicity.Max1Fusion.SeedCertificates.vaRows = gpRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

set_option maxHeartbeats 800000 in
theorem product_01 : packedMul gpRows gpiRows = packedOne :=
  packedMul_eq_of_rows _ _ _ (by
    simp only [packedOne, get_ofFn]
    decide +kernel)

set_option maxHeartbeats 800000 in
theorem product_02 : packedMul gpiRows Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.cxRows = cLeftRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

set_option maxHeartbeats 800000 in
theorem product_03 : packedMul cLeftRows gpRows = cRows :=
  packedMul_eq_of_rows _ _ _ (by decide +kernel)

set_option maxHeartbeats 800000 in
theorem product_04 : packedMul cRows ciRows = packedOne :=
  packedMul_eq_of_rows _ _ _ (by
    simp only [packedOne, get_ofFn]
    decide +kernel)

@[expose] def pair : Model := Simplicity.Max1Fusion.kernelPair matrixA_mul_self matrixB_pow_four

@[expose] def seed : Model := localKernelSeed matrixA_mul_self matrixB_pow_four

@[expose] def gp : Model := (pair * Janko4.a)^5

@[expose] def c : Model := gp⁻¹ *
  Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.cx * gp

theorem eval_pair : toMatrix pair = decodeRows
    Janko4.Simplicity.Max1Fusion.SeedCertificates.pairRows := by
  change representation matrixA_mul_self matrixB_pow_four
    (basis matrixA_mul_self matrixB_pow_four 0 * basis matrixA_mul_self matrixB_pow_four 1) = _
  rw [map_mul, representation_basis, representation_basis]
  exact decoded_product Simplicity.Max1Fusion.SeedCertificates.product_00

theorem eval_va : toMatrix (pair * Janko4.a) = decodeRows
    Janko4.Simplicity.Max1Fusion.SeedCertificates.vaRows := by
  rw [map_mul, eval_pair, toMatrix_a]
  exact decoded_product Simplicity.Max1Fusion.SeedCertificates.product_08

theorem eval_gp : toMatrix gp = decodeRows gpRows := by
  have h2 : toMatrix ((pair * Janko4.a)^2) = decodeRows
      Simplicity.Max1Fusion.SeedCertificates.va2Rows := by
    rw [map_pow, pow_two, eval_va]
    exact decoded_product Simplicity.Max1Fusion.SeedCertificates.product_09
  have h4 : toMatrix ((pair * Janko4.a)^4) = decodeRows
      Simplicity.Max1Fusion.SeedCertificates.va4Rows := by
    rw [show 4=2+2 from rfl, pow_add, map_mul, h2]
    exact decoded_product Simplicity.Max1Fusion.SeedCertificates.product_10
  rw [gp, show 5=4+1 from rfl, pow_add, pow_one, map_mul, h4, eval_va]
  exact decoded_product product_00

theorem eval_gpi : toMatrix gp⁻¹ = decodeRows gpiRows :=
  eval_inv toMatrix eval_gp (by rw [decoded_product product_01, decode_packedOne])

theorem eval_c : toMatrix c = decodeRows cRows := by
  rw [c, map_mul, map_mul, eval_gpi,
    OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreCentralizerData.eval_cx,
    eval_gp, decoded_product product_02, decoded_product product_03]

theorem eval_ci : toMatrix c⁻¹ = decodeRows ciRows :=
  eval_inv toMatrix eval_c (by rw [decoded_product product_04, decode_packedOne])

theorem eval_seed : toMatrix seed = decodeRows e0Rows :=
  representation_seed matrixA_mul_self matrixB_pow_four

end Janko4.AdequateLocal.Certificates
