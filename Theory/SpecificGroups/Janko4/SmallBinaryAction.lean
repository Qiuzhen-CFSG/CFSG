module

public import Theory.SpecificGroups.Janko4.Model.Cardinality.LocalOrder
public import Theory.SpecificGroups.Janko4.Model.GeneratorCertificates.MatrixResults
public import Theory.Representation.BinaryPrimeDegree
public import Theory.ElementaryAbelian.AutomorphismLinearEmbedding
public import Mathlib.GroupTheory.Subgroup.Simple

/-!
# Trivial actions of a simple J₄ copy on an elementary group of order 64

The certified subgroup generated by the ATLAS max1 words has order
501397585920, divisible by 23. Thus 23 divides the order of the actual J₄
matrix carrier. A nontrivial homomorphism from a simple copy of that carrier
to Aut(E₆₄) would be injective, hence give an embedding in GL₆(2). This is
impossible because the multiplicative order of 2 modulo 23 is 11.

Simplicity is an inherited hypothesis on the acting group. No simplicity,
full order, or maximal-subgroup classification of J₄ is assumed here.

Source application: Aschbacher–Smith, *The Classification of Quasithin
Groups*, A.3.14(10), pp.49–50, in the proof of 14.4.9, p.1010.
The concrete local-order certificates and their ATLAS sources are documented
in `Model.Cardinality.LocalOrder`.
-/

public section
namespace Janko4

/-- The certified local subgroup supplies the required prime divisor of
the actual J₄ carrier, without a full order theorem. -/
theorem twentyThree_dvd_card_model : 23 ∣ Nat.card Model := by
  apply dvd_trans (b := Nat.card (Cardinality.max1Subgroup matrixA_mul_self matrixB_pow_four))
  · rw [Cardinality.max1Subgroup_card]
    norm_num
  · exact Subgroup.card_subgroup_dvd_card _

/-- Every action of a finite simple copy of the concrete J₄ carrier on
an elementary abelian group of order 64 is trivial. -/
theorem hom_mulAut_eq_one_of_card_eq_sixtyFour
    {X E : Type*} [Group X] [Finite X] [IsSimpleGroup X]
    [Group E] [Finite E] [IsElementaryAbelian 2 E]
    (e : X ≃* Model) (hE : Nat.card E = 64) (f : X →* MulAut E) : f = 1 := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal f.ker (by infer_instance) with hker | hker
  · have hf := (MonoidHom.ker_eq_bot_iff f).mp hker
    obtain ⟨j, hj⟩ := IsElementaryAbelian.exists_injective_mulAut_generalLinear_of_card_le
      (p := 2) (n := 6) E (by rw [hE]; norm_num)
    have hd : 23 ∣ Nat.card X := by
      rw [Nat.card_congr e.toEquiv]
      exact twentyThree_dvd_card_model
    have hGL := Representation.BinaryPrimeDegree.orderOf_le_of_dvd_card_GL
      (by decide : Nat.Prime 23) (by decide : 23 ≠ 2)
      (hd.trans (Subgroup.card_dvd_of_injective (j.comp f) (hj.comp hf)))
    rw [Representation.BinaryPrimeDegree.orderOf_two_mod_twentyThree] at hGL
    omega
  · exact MonoidHom.ker_eq_top_iff.mp hker

end Janko4
