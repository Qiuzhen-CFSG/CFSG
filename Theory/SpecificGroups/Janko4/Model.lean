module

public import Theory.SpecificGroups.Janko4.Model.Data
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Algebra.GroupWithZero.Units.Fintype

/-!
# The concrete binary-matrix carrier for J₄

Take the subgroup of `GL(112, 2)` generated by the two explicit matrices in
ATLAS representation `J4G1-f2r112B0`. The source data, bit order, and file hashes
are documented in `Model.Data`. The ATLAS entry is
https://brauer.maths.qmul.ac.uk/Atlas/v3/spor/J4/ .

We specify the generating set as the inverse image of the two matrices under
the injective map from matrix units to matrices. This permits defining the
carrier independently of the proofs of invertibility. Subsequent certificates
must establish that both source matrices are units. This formulation makes
no choice of inverse and does not identify groups by their order.

The carrier has a group structure, is finite, and embeds faithfully into
matrices. These facts follow from the ambient finite matrix algebra and
subgroup closure. The intrinsic assertions of simplicity and the ATLAS order
are separate certification obligations; this module does not assert them.
In particular, this module alone is not a completed certification of J₄.
Recognition from local subgroup hypotheses is also a separate theorem.
-/

@[expose] public section

namespace Janko4

/-- Units whose underlying matrices are the two source generators. -/
def matrixGenerators : Set BinaryMatrixˣ :=
  {g | (g : BinaryMatrix) = matrixA ∨ (g : BinaryMatrix) = matrixB}

/-- The subgroup generated by the explicit ATLAS matrices. -/
def matrixGroup : Subgroup BinaryMatrixˣ := Subgroup.closure matrixGenerators

/-- Once the two source matrices are certified as units, the generating set
is precisely that pair of units. -/
theorem matrixGenerators_eq_pair (a b : BinaryMatrixˣ)
    (ha : (a : BinaryMatrix) = matrixA) (hb : (b : BinaryMatrix) = matrixB) :
    matrixGenerators = {a, b} := by
  ext g
  change ((g : BinaryMatrix) = matrixA ∨ (g : BinaryMatrix) = matrixB) ↔
    (g = a ∨ g = b)
  rw [← ha, ← hb]
  simp only [Units.val_inj]

theorem matrixGroup_eq_closure_pair (a b : BinaryMatrixˣ)
    (ha : (a : BinaryMatrix) = matrixA) (hb : (b : BinaryMatrix) = matrixB) :
    matrixGroup = Subgroup.closure {a, b} := by
  rw [matrixGroup, matrixGenerators_eq_pair a b ha hb]

/-- The concrete carrier, suitable for a conclusion `Nonempty (G ≃* Model)`.
Its intrinsic certification is independent of this definition. -/
def Model : Type := ↥matrixGroup

instance modelGroup : Group Model := inferInstanceAs (Group ↥matrixGroup)

instance modelFinite : Finite Model := inferInstanceAs (Finite ↥matrixGroup)

/-- The faithful inclusion into invertible binary matrices. -/
def toAmbient : Model →* BinaryMatrixˣ := matrixGroup.subtype

theorem toAmbient_injective : Function.Injective toAmbient :=
  Subtype.val_injective

/-- The underlying 112-dimensional binary matrix representation. -/
def toMatrix : Model →* BinaryMatrix := (Units.coeHom BinaryMatrix).comp toAmbient

theorem toMatrix_injective : Function.Injective toMatrix :=
  Units.val_injective.comp toAmbient_injective

/-- Any matrix unit equal to either source generator belongs to the model. -/
theorem generator_mem (g : BinaryMatrixˣ)
    (hg : (g : BinaryMatrix) = matrixA ∨ (g : BinaryMatrix) = matrixB) :
    g ∈ matrixGroup := Subgroup.subset_closure hg

/-- Realize a certified source generator as an element of the carrier. -/
def generator (g : BinaryMatrixˣ)
    (hg : (g : BinaryMatrix) = matrixA ∨ (g : BinaryMatrix) = matrixB) : Model :=
  ⟨g, generator_mem g hg⟩

@[simp] theorem toMatrix_generator (g : BinaryMatrixˣ)
    (hg : (g : BinaryMatrix) = matrixA ∨ (g : BinaryMatrix) = matrixB) :
    toMatrix (generator g hg) = (g : BinaryMatrix) := rfl

/-- Minimality of the subgroup generated by the two source matrices. -/
theorem matrixGroup_le_iff (H : Subgroup BinaryMatrixˣ) :
    matrixGroup ≤ H ↔ ∀ g : BinaryMatrixˣ,
      ((g : BinaryMatrix) = matrixA ∨ (g : BinaryMatrix) = matrixB) → g ∈ H :=
  Subgroup.closure_le H

end Janko4
