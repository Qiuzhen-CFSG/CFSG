module

public import Theory.SpecificGroups.UnitaryThree.OddTorusNormalizer.Frames
public import Theory.SpecificGroups.UnitaryThree.OddTorusNormalizer.Structure.PermutationAction
public import Theory.SpecificGroups.UnitaryThree.OddTorusNormalizer.Structure.InvolutionCalculus.Transport

/-!
# Fixed subgroups and commutators of frame-torus involutions

Given the published permutation action of an involution, the actual special
frame torus has fixed subgroup of order `q+1`; the projective fixed subgroup
has order `(q+1)/gcd(3,q+1)`. Both ambient subgroup commutators with the cyclic
subgroup generated by the involution are isomorphic to `C_(q+1)`.

Reindex to the first-two-coordinate swap. Its fixed image is the diagonal
factor: a projective scalar discrepancy has both square and cube one and
hence is trivial. The diagonal image has precisely the cubic scalar kernel
in the projective case. The commutator is the anti-diagonal image, which has
trivial intersection with that kernel. The proofs identify the literal
ambient intersections and subgroup commutators.

Source: GLS4, Chapter 4, Lemma 3.11(c), lines 585–603, and Chapter 2,
Lemma 17.4, lines 3145–3147. The existence of the frame action for arbitrary
normalizer involutions is a separate input, retained explicitly here.
-/

public section

open Subgroup BenderSuzuki.MatrixGroups HermitianForm HermitianForm.EvenInner
open scoped commutatorElement
namespace UnitaryThree.OddTorusNormalizer
variable {E : Type*} [Field E]

open InvolutionCalculus

private theorem cubic_bound_of_injective {A G : Type*} [CommGroup A] [Group G]
    (f : A × A →* G) (hf : Function.Injective f) :
    ∀ x, f x = 1 → x.1 = x.2 ∧ x.2 ^ 3 = 1 := by
  intro x hx
  have he : x = 1 := hf (hx.trans f.map_one.symm)
  rw [he]
  simp

private theorem reindexed_projective_kernel (J : HermitianForm 3 E)
    (P : OrthogonalFrame J) (τ : Equiv.Perm (Fin 3)) (x : normOne J × normOne J) :
    (projectivePairHom J P).comp (framePairEquiv J τ).toMonoidHom x = 1 ↔
      x.1 = x.2 ∧ x.2 ^ 3 = 1 := by
  change projectivePairHom J P (framePairEquiv J τ x) = 1 ↔ _
  rw [projectivePairHom_eq_one_iff, framePairEquiv_cubic_iff]

/-- The literal special torus centralizer is a single norm-one factor. -/
noncomputable def specialFrameTorus_involution_fixedEquivNormOne
    (J : HermitianForm 3 E) (P : OrthogonalFrame J) (t : J.specialSubgroup)
    (σ : Equiv.Perm (Fin 3)) (hσ : orderOf σ = 2)
    (ha : HasSpecialFrameAction J P t σ) :
    ↥(specialFrameTorus J P ⊓ centralizer {t}) ≃* normOne J := by
  let τ := Classical.choose (exists_swap_coordinates σ hσ)
  have hτ : σ * τ = τ * Equiv.swap 0 1 :=
    Classical.choose_spec (exists_swap_coordinates σ hσ)
  let f := (specialPairHom J P).comp (framePairEquiv J τ).toMonoidHom
  have hf : Function.Injective f := (specialPairHom_injective J P).comp
    (framePairEquiv J τ).injective
  have hr : f.range = specialFrameTorus J P :=
    (reindexed_range J _ τ).trans (specialPairHom_range J P)
  have hd : Function.Injective (diagonalMap f) := by
    intro a b h
    exact congrArg Prod.fst (hf h)
  have he : specialFrameTorus J P ⊓ centralizer {t} = (diagonalMap f).range := by
    rw [← hr]
    exact inf_centralizer_eq_diagonal_range f t (cubic_bound_of_injective f hf)
      (reindexed_action J _ t σ τ hτ ha)
  exact (MulEquiv.subgroupCongr he).trans (MonoidHom.ofInjective hd).symm

/-- The ambient special torus commutator is the injected anti-diagonal factor. -/
noncomputable def specialFrameTorus_involution_commutatorEquivNormOne
    (J : HermitianForm 3 E) (P : OrthogonalFrame J) (t : J.specialSubgroup)
    (ht : orderOf t = 2) (σ : Equiv.Perm (Fin 3)) (hσ : orderOf σ = 2)
    (ha : HasSpecialFrameAction J P t σ) :
    ↥⁅specialFrameTorus J P, zpowers t⁆ ≃* normOne J := by
  let τ := Classical.choose (exists_swap_coordinates σ hσ)
  have hτ : σ * τ = τ * Equiv.swap 0 1 :=
    Classical.choose_spec (exists_swap_coordinates σ hσ)
  let f := (specialPairHom J P).comp (framePairEquiv J τ).toMonoidHom
  have hf : Function.Injective f := (specialPairHom_injective J P).comp
    (framePairEquiv J τ).injective
  have hr : f.range = specialFrameTorus J P :=
    (reindexed_range J _ τ).trans (specialPairHom_range J P)
  exact (MulEquiv.subgroupCongr (congrArg (fun H => ⁅H, zpowers t⁆) hr.symm)).trans
    (commutatorEquiv f t ht (cubic_bound_of_injective f hf)
      (reindexed_action J _ t σ τ hτ ha))

/-- The literal projective fixed subgroup is the cubic-power image of the norm-one group. -/
noncomputable def projectiveFrameTorus_involution_fixedEquivCubeRange
    (J : HermitianForm 3 E) (P : OrthogonalFrame J)
    (t : ProjectiveSpecialUnitaryMatrixGroup J)
    (σ : Equiv.Perm (Fin 3)) (hσ : orderOf σ = 2)
    (ha : HasProjectiveFrameAction J P t σ) :
    ↥(projectiveFrameTorus J P ⊓ centralizer {t}) ≃*
      (powMonoidHom 3 : normOne J →* normOne J).range := by
  let τ := Classical.choose (exists_swap_coordinates σ hσ)
  have hτ : σ * τ = τ * Equiv.swap 0 1 :=
    Classical.choose_spec (exists_swap_coordinates σ hσ)
  let f := (projectivePairHom J P).comp (framePairEquiv J τ).toMonoidHom
  have hk : ∀ x, f x = 1 ↔ x.1 = x.2 ∧ x.2 ^ 3 = 1 :=
    reindexed_projective_kernel J P τ
  have hr : f.range = projectiveFrameTorus J P :=
    (reindexed_range J _ τ).trans (projectivePairHom_range J P)
  have he : projectiveFrameTorus J P ⊓ centralizer {t} = (diagonalMap f).range := by
    rw [← hr]
    exact inf_centralizer_eq_diagonal_range f t (fun x => (hk x).mp)
      (reindexed_action J _ t σ τ hτ ha)
  exact (MulEquiv.subgroupCongr he).trans (diagonalRangeEquivCubeRange f hk)

/-- The anti-diagonal commutator survives the projective scalar quotient injectively. -/
noncomputable def projectiveFrameTorus_involution_commutatorEquivNormOne
    (J : HermitianForm 3 E) (P : OrthogonalFrame J)
    (t : ProjectiveSpecialUnitaryMatrixGroup J)
    (ht : orderOf t = 2) (σ : Equiv.Perm (Fin 3)) (hσ : orderOf σ = 2)
    (ha : HasProjectiveFrameAction J P t σ) :
    ↥⁅projectiveFrameTorus J P, zpowers t⁆ ≃* normOne J := by
  let τ := Classical.choose (exists_swap_coordinates σ hσ)
  have hτ : σ * τ = τ * Equiv.swap 0 1 :=
    Classical.choose_spec (exists_swap_coordinates σ hσ)
  let f := (projectivePairHom J P).comp (framePairEquiv J τ).toMonoidHom
  have hr : f.range = projectiveFrameTorus J P :=
    (reindexed_range J _ τ).trans (projectivePairHom_range J P)
  exact (MulEquiv.subgroupCongr (congrArg (fun H => ⁅H, zpowers t⁆) hr.symm)).trans
    (commutatorEquiv f t ht (fun x => (reindexed_projective_kernel J P τ x).mp)
      (reindexed_action J _ t σ τ hτ ha))

/-- The centralizer order required in GLS4, Chapter 2, Lemma 17.4, in SU₃. -/
theorem specialFrameTorus_involution_centralizer_card [Finite E]
    (J : HermitianForm 3 E) (P : OrthogonalFrame J) (q : ℕ)
    (hcard : Nat.card E = q ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = q)
    (t : J.specialSubgroup) (σ : Equiv.Perm (Fin 3)) (hσ : orderOf σ = 2)
    (ha : HasSpecialFrameAction J P t σ) :
    Nat.card ↥(specialFrameTorus J P ⊓ centralizer {t}) = q + 1 := by
  rw [Nat.card_congr (specialFrameTorus_involution_fixedEquivNormOne J P t σ hσ ha).toEquiv]
  exact normOne_card J hcard
    (BenderSuzuki.External.huppert_II_10_4_conj_eq_frobenius J q hcard hfixed)

/-- The centralizer order required in GLS4, Chapter 2, Lemma 17.4, in PSU₃. -/
theorem projectiveFrameTorus_involution_centralizer_card [Finite E]
    (J : HermitianForm 3 E) (P : OrthogonalFrame J) (q : ℕ)
    (hcard : Nat.card E = q ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = q)
    (t : ProjectiveSpecialUnitaryMatrixGroup J)
    (σ : Equiv.Perm (Fin 3)) (hσ : orderOf σ = 2)
    (ha : HasProjectiveFrameAction J P t σ) :
    Nat.card ↥(projectiveFrameTorus J P ⊓ centralizer {t}) =
      (q + 1) / Nat.gcd 3 (q + 1) := by
  rw [Nat.card_congr
    (projectiveFrameTorus_involution_fixedEquivCubeRange J P t σ hσ ha).toEquiv,
    IsCyclic.card_powMonoidHom_range,
    normOne_card J hcard
      (BenderSuzuki.External.huppert_II_10_4_conj_eq_frobenius J q hcard hfixed),
    Nat.gcd_comm]

/-- GLS4, Chapter 4, Lemma 3.11(c), for the supplied special frame action. -/
noncomputable def specialFrameTorus_involution_commutatorEquiv [Finite E]
    (J : HermitianForm 3 E) (P : OrthogonalFrame J) (q : ℕ)
    (hcard : Nat.card E = q ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = q)
    (t : J.specialSubgroup) (ht : orderOf t = 2)
    (σ : Equiv.Perm (Fin 3)) (hσ : orderOf σ = 2)
    (ha : HasSpecialFrameAction J P t σ) :
    ↥⁅specialFrameTorus J P, zpowers t⁆ ≃* Multiplicative (ZMod (q + 1)) :=
  (specialFrameTorus_involution_commutatorEquivNormOne J P t ht σ hσ ha).trans
    (normOneEquivZMod J q hcard hfixed)

/-- GLS4, Chapter 4, Lemma 3.11(c), for the supplied projective frame action. -/
noncomputable def projectiveFrameTorus_involution_commutatorEquiv [Finite E]
    (J : HermitianForm 3 E) (P : OrthogonalFrame J) (q : ℕ)
    (hcard : Nat.card E = q ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = q)
    (t : ProjectiveSpecialUnitaryMatrixGroup J) (ht : orderOf t = 2)
    (σ : Equiv.Perm (Fin 3)) (hσ : orderOf σ = 2)
    (ha : HasProjectiveFrameAction J P t σ) :
    ↥⁅projectiveFrameTorus J P, zpowers t⁆ ≃* Multiplicative (ZMod (q + 1)) :=
  (projectiveFrameTorus_involution_commutatorEquivNormOne J P t ht σ hσ ha).trans
    (normOneEquivZMod J q hcard hfixed)

end UnitaryThree.OddTorusNormalizer
