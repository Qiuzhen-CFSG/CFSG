module

public import Theory.SpecificGroups.UnitaryThree.OddTorusNormalizer
public import Mathlib.GroupTheory.PGroup

/-!
# Prime commutators in the literal unitary frame normalizers

For an odd prime other than three, a p-subgroup in a frame-torus normalizer
lies in the torus: the quotient is the symmetric group of degree three.
If the subgroup is generated by its commutators with a normalizing involution,
it therefore lies in the cyclic commutator of that torus.

The special and projective carrier applications use the already constructed
frame and actual normalizer quotient. The no-Borel premise is retained;
there is deliberately no assertion for the prime three, where nonabelian
examples exist in SU₃(2) and SU₃(8).

Source: GLS IV, Chapter 4, Lemma 3.11(a–c); partial model calculation for the
terminal step of Chapter 2, Proposition 16.5.
-/

noncomputable section
open Subgroup BenderSuzuki.MatrixGroups
namespace UnitaryThree.OddTorusNormalizer

private theorem pSubgroup_le_of_normalizer_quotient_symmetric_three
    {G : Type*} [Group G] [Finite G] (A H : Subgroup G)
    (e : normalizer A ⧸ A.subgroupOf (normalizer A) ≃* Equiv.Perm (Fin 3))
    (hHN : H ≤ normalizer A) {p : ℕ} [Fact p.Prime]
    (hp2 : p ≠ 2) (hp3 : p ≠ 3) (hH : IsPGroup p H) : H ≤ A := by
  let f := e.toMonoidHom.comp (QuotientGroup.mk' (A.subgroupOf (normalizer A)))
  let HN := H.subgroupOf (normalizer A)
  let Q := HN.map f
  have hQ : IsPGroup p Q :=
    (hH.of_equiv (subgroupOfEquivOfLe hHN).symm).map f
  have hQcard : Nat.card Q = 1 := by
    rcases hQ.card_eq_or_dvd with hh | hh
    · exact hh
    · have hd : p ∣ 6 := hh.trans (by
        simpa [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial] using
          Q.card_subgroup_dvd_card)
      have hd' : p ∣ 2 * 3 := hd
      rcases (Fact.out : p.Prime).dvd_mul.mp hd' with h2 | h3
      · exact (hp2 ((Nat.dvd_prime Nat.prime_two).mp h2 |>.resolve_left
          (Fact.out : p.Prime).ne_one)).elim
      · exact (hp3 ((Nat.dvd_prime Nat.prime_three).mp h3 |>.resolve_left
          (Fact.out : p.Prime).ne_one)).elim
  have hbot : HN.map f = ⊥ := card_eq_one.mp hQcard
  have hker : HN ≤ f.ker := (Subgroup.map_eq_bot_iff _).mp hbot
  intro x hx
  have hh := hker (show (⟨x,hHN hx⟩ : normalizer A) ∈ HN from hx)
  change e (QuotientGroup.mk' (A.subgroupOf (normalizer A)) ⟨x,hHN hx⟩) = 1 at hh
  rw [← e.map_one, e.injective.eq_iff] at hh
  have hmem : (⟨x,hHN hx⟩ : normalizer A) ∈
      (QuotientGroup.mk' (A.subgroupOf (normalizer A))).ker := hh
  rw [QuotientGroup.ker_mk'] at hmem
  exact hmem

variable {E : Type*} [Field E] [Finite E]

/-- Away from the prime three, an actual special-unitary p-subgroup with
no isotropic fixed line and `R=[R,t]` is cyclic. -/
public theorem special_pSubgroup_commutator_isCyclic
    (J : HermitianForm 3 E) {n : ℕ} (hn : 2 ≤ n)
    (hcard : Nat.card E = (2 ^ n) ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = 2 ^ n)
    (R : Subgroup J.specialSubgroup) {p : ℕ} [Fact p.Prime]
    (hp2 : p ≠ 2) (hp3 : p ≠ 3) (hR : IsPGroup p R)
    (t : J.specialSubgroup) (ht : orderOf t = 2)
    (htR : t ∈ normalizer R) (hB : SpecialNoBorel J R)
    (hcomm : ⁅R,zpowers t⁆ = R) : IsCyclic R := by
  have hodd : Odd (Nat.card R) := by
    obtain ⟨k,hk⟩ := hR.exists_card_eq
    rw [hk]
    exact ((Fact.out : p.Prime).odd_of_ne_two hp2).pow
  obtain ⟨P,hN,_,⟨eN⟩,_,⟨eC⟩⟩ :=
    special_odd_subgroup_torus J hn hcard hfixed R hodd t ht htR hB
  have hRA : R ≤ specialFrameTorus J P :=
    pSubgroup_le_of_normalizer_quotient_symmetric_three _ _ eN
      (le_sup_left.trans hN) hp2 hp3 hR
  let : IsCyclic ↥⁅specialFrameTorus J P,zpowers t⁆ := eC.isCyclic.mpr inferInstance
  exact isCyclic_of_le (hcomm ▸ commutator_mono hRA le_rfl)

/-- The projective carrier satisfies the same prime restriction; the
literal commutator torus survives the scalar quotient injectively. -/
public theorem projective_pSubgroup_commutator_isCyclic
    (J : HermitianForm 3 E) {n : ℕ} (hn : 2 ≤ n)
    (hcard : Nat.card E = (2 ^ n) ^ 2)
    (hfixed : Nat.card {x : E // J.conj x = x} = 2 ^ n)
    (R : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) (hp3 : p ≠ 3) (hR : IsPGroup p R)
    (t : ProjectiveSpecialUnitaryMatrixGroup J) (ht : orderOf t = 2)
    (htR : t ∈ normalizer R) (hB : ProjectiveNoBorel J R)
    (hcomm : ⁅R,zpowers t⁆ = R) : IsCyclic R := by
  let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
    Finite.of_surjective J.specialToProjective J.specialToProjective_surjective
  have hodd : Odd (Nat.card R) := by
    obtain ⟨k,hk⟩ := hR.exists_card_eq
    rw [hk]
    exact ((Fact.out : p.Prime).odd_of_ne_two hp2).pow
  obtain ⟨P,hN,_,⟨eN⟩,_,⟨eC⟩⟩ :=
    projective_odd_subgroup_torus J hn hcard hfixed R hodd t ht htR hB
  have hRA : R ≤ projectiveFrameTorus J P :=
    pSubgroup_le_of_normalizer_quotient_symmetric_three _ _ eN
      (le_sup_left.trans hN) hp2 hp3 hR
  let : IsCyclic ↥⁅projectiveFrameTorus J P,zpowers t⁆ := eC.isCyclic.mpr inferInstance
  exact isCyclic_of_le (hcomm ▸ commutator_mono hRA le_rfl)

end UnitaryThree.OddTorusNormalizer
