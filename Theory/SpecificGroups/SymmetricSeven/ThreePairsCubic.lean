module

public import Theory.Representation.AlternatingSevenConjugatePair.ElementaryGeometry
public import Theory.Representation.BinaryPermutation.OffenderFixedSpace
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.GroupTheory.SubgroupConjugation

/-!
# Three disjoint transpositions and a cubic in S₇

The elementary eight generated by (01), (23), and (45) normalizes the
three-group generated by (016). Their join has order 24 and index three
over the eight. The cubic and the normalizer of the eight generate S₇.
On the natural binary module, the vector e₀ + e₁ is fixed by the eight,
while its cubic translate is moved by (01). All permutation checks concern
only the eight coordinate words or six short conjugators.

Source: Aschbacher–Smith, C.1.24, printed pp.130–131.
-/

@[expose] public section

open Subgroup Equiv Representation.BinaryOffender BinaryPermutation
open Representation.AlternatingSevenConjugatePair.ElementaryGeometry

namespace Theory.SpecificGroups.SymmetricSeven.ThreePairsCubic

abbrev Sym := Perm (Fin 7)

def cubic : Sym := swap 0 1 * swap 1 6

theorem cubic_cube : cubic ^ 3 = 1 := by decide +kernel

theorem cubic_order : orderOf cubic = 3 :=
  orderOf_eq_prime cubic_cube (by decide +kernel)

theorem cubic_even : cubic ∈ alternatingGroup (Fin 7) := by
  rw [Perm.mem_alternatingGroup]
  decide +kernel

theorem reflection_inverts_cubic : swap01 * cubic * swap01⁻¹ = cubic⁻¹ := by
  decide +kernel

theorem pairElementary_normalizes_cubic :
    pairElementary ≤ normalizer (zpowers cubic : Set Sym) := by
  rintro _ ⟨v, rfl⟩
  rw [mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
  have h : firstWord v * cubic * (firstWord v)⁻¹ = cubic ∨
      firstWord v * cubic * (firstWord v)⁻¹ = cubic⁻¹ :=
    (by decide +kernel : ∀ v : Triple,
      firstWord v * cubic * (firstWord v)⁻¹ = cubic ∨
      firstWord v * cubic * (firstWord v)⁻¹ = cubic⁻¹) v
  change zpowers (firstWord v * cubic * (firstWord v)⁻¹) = zpowers cubic
  rcases h with h | h
  · rw [h]
  · rw [h, zpowers_inv]

theorem local_card : Nat.card (zpowers cubic ⊔ pairElementary : Subgroup Sym) = 24 := by
  have hd : Disjoint (zpowers cubic) pairElementary := disjoint_of_coprime_natCard (by
    rw [Nat.card_zpowers, cubic_order, pairElementary_card]
    decide)
  rw [card_sup_eq_mul_of_normalizes_of_disjoint _ _ pairElementary_normalizes_cubic hd,
    Nat.card_zpowers, cubic_order, pairElementary_card]

theorem local_relIndex : pairElementary.relIndex (zpowers cubic ⊔ pairElementary) = 3 := by
  have h := relIndex_mul_relIndex (⊥ : Subgroup Sym) pairElementary
    (zpowers cubic ⊔ pairElementary) bot_le le_sup_right
  rw [relIndex_bot_left, relIndex_bot_left, pairElementary_card, local_card] at h
  omega

private def pairTransport (i : Fin 6) : Sym :=
  ![swap01, 1, swap23 * crossSwap, crossSwap,
    swap45 * (swap 0 4 * swap 1 5), swap 0 4 * swap 1 5] i

private theorem pairTransport_normalizes (i : Fin 6) :
    pairTransport i ∈ normalizer (pairElementary : Set Sym) := by
  apply mem_normalizer_iff_map_conj_eq.mpr
  apply eq_of_le_of_card_ge
  · rintro _ ⟨_, ⟨v, rfl⟩, rfl⟩
    exact (by decide +kernel : ∀ (i : Fin 6) (v : Triple),
      pairTransport i * firstWord v * (pairTransport i)⁻¹ ∈ pairElementary) i v
  · rw [card_map_of_injective (MulAut.conj (pairTransport i)).injective]

theorem normalizer_cubic_generate :
    normalizer (pairElementary : Set Sym) ⊔ zpowers cubic = ⊤ := by
  let N := normalizer (pairElementary : Set Sym) ⊔ zpowers cubic
  have hE : pairElementary ≤ N := pairElementary.le_normalizer.trans le_sup_left
  have hr : swap01 ∈ N := hE pairElementary_generators.1
  have hc : cubic ∈ N := (show zpowers cubic ≤ N from le_sup_right) (mem_zpowers cubic)
  have h16 : swap (1 : Fin 7) 6 ∈ N := by
    have he : swap01 * cubic = swap (1 : Fin 7) 6 := by decide +kernel
    rw [← he]
    exact N.mul_mem hr hc
  have hstar (i : Fin 6) : swap i.castSucc (6 : Fin 7) ∈ N := by
    have hg : pairTransport i ∈ N := (show normalizer (pairElementary : Set Sym) ≤ N from
      le_sup_left) (pairTransport_normalizes i)
    have he : pairTransport i * swap (1 : Fin 7) 6 * (pairTransport i)⁻¹ =
        swap i.castSucc (6 : Fin 7) :=
      (by decide +kernel : ∀ i : Fin 6,
        pairTransport i * swap (1 : Fin 7) 6 * (pairTransport i)⁻¹ =
          swap i.castSucc (6 : Fin 7)) i
    rw [← he]
    exact N.mul_mem (N.mul_mem hg h16) (N.inv_mem hg)
  apply top_unique
  rw [← Subgroup.closure_eq_top_of_mclosure_eq_top (Perm.mclosure_swap_castSucc_succ 6)]
  apply (Subgroup.closure_le _).mpr
  rintro x ⟨i, rfl⟩
  change swap i.castSucc i.succ ∈ N
  by_cases hi : i = 5
  · subst i
    exact hstar 5
  · have hi' : i.val + 1 < 6 := by omega
    let j : Fin 6 := ⟨i.val + 1, hi'⟩
    have he : swap i.castSucc (6 : Fin 7) * swap j.castSucc 6 * swap i.castSucc 6 =
        swap i.castSucc i.succ := by
      exact (by decide +kernel : ∀ (i j : Fin 6), j.val = i.val + 1 →
        swap i.castSucc (6 : Fin 7) * swap j.castSucc 6 * swap i.castSucc 6 =
          swap i.castSucc i.succ) i j rfl
    rw [← he]
    exact N.mul_mem (N.mul_mem (hstar i) (hstar j)) (hstar i)

def pairVector : core (Fin 7) :=
  ⟨Pi.single 0 1 + Pi.single 1 1, by simp [mem_core]; decide⟩

def pairPoint : natural (Fin 7) :=
  ⟨(constants (Fin 7)).mkQ pairVector.val, ⟨pairVector.val, pairVector.property, rfl⟩⟩

theorem pairPoint_fixed :
    pairPoint ∈ fixedSpace (naturalRepresentation (Fin 7)) pairElementary := by
  apply (mem_natural_fixedSpace_iff pairElementary pairVector).mpr
  rintro _ ⟨v, rfl⟩
  refine ⟨0, ?_⟩
  exact (by decide +kernel : ∀ (v : Triple) (i : Fin 7),
    pairVector.val ((firstWord v).symm i) - pairVector.val i = 0) v

theorem cubic_moves_pair_fixed :
    ¬fixedSpace (naturalRepresentation (Fin 7)) pairElementary ≤
      fixedSpace (naturalRepresentation (Fin 7)) (zpowers cubic) := by
  intro h
  have hc := (mem_natural_fixedSpace_iff (zpowers cubic) pairVector).mp
    (h pairPoint_fixed) cubic (mem_zpowers cubic)
  obtain ⟨c, hc⟩ := hc
  have h2 := hc 2
  have h0 := hc 0
  change (0 : ZMod 2) = c at h2
  change (0 : ZMod 2) - 1 = c at h0
  norm_num at h0
  exact zero_ne_one (h2.trans h0.symm)

theorem reflection_moves_cubic_pairPoint :
    naturalRepresentation (Fin 7) swap01 (naturalRepresentation (Fin 7) cubic pairPoint) ≠
      naturalRepresentation (Fin 7) cubic pairPoint := by
  intro h
  have hh := congrArg Subtype.val h
  change deletedRepresentation (Fin 7) swap01
    (deletedRepresentation (Fin 7) cubic ((constants (Fin 7)).mkQ pairVector.val)) =
      deletedRepresentation (Fin 7) cubic ((constants (Fin 7)).mkQ pairVector.val) at hh
  rw [deletedRepresentation_mk] at hh
  obtain ⟨c, hc⟩ := (deleted_fixed_iff swap01 (representation (Fin 7) cubic pairVector.val)).mp hh
  have h2 := hc 2
  have h0 := hc 0
  change (0 : ZMod 2) = c at h2
  change (1 : ZMod 2) - 0 = c at h0
  norm_num at h0
  exact zero_ne_one (h2.trans h0.symm)

end Theory.SpecificGroups.SymmetricSeven.ThreePairsCubic
