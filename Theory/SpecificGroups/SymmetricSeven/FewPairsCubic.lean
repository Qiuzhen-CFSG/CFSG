module

public import Theory.SpecificGroups.SymmetricSeven.ThreePairsCubic

/-!
# One or two disjoint transpositions and the seven-letter cubic

For the subgroup generated by (01), or by (01) and (23), the cubic (016)
again gives relative index three and generates S₇ with the subgroup's
normalizer. The same natural-module vector e₀ + e₁ is fixed, and its cubic
translate is moved by (01). Together with the three-pair construction,
these are the three nonempty disjoint-transposition cases.

The generation proof uses transpositions joining every letter to 6:
normalizers permute the paired letters and freely permute the unused letters.
Source: Aschbacher–Smith, C.1.24, printed pp.130–131.
-/

@[expose] public section

open Subgroup Equiv Representation.BinaryOffender BinaryPermutation
open Representation.AlternatingSevenConjugatePair.ElementaryGeometry

namespace Theory.SpecificGroups.SymmetricSeven.ThreePairsCubic

def pairOne : Subgroup Sym := zpowers swap01

def pairTwo : Subgroup Sym := zpowers swap01 ⊔ zpowers swap23

theorem pairOne_le_pairElementary : pairOne ≤ pairElementary :=
  zpowers_le.mpr pairElementary_generators.1

theorem pairTwo_le_pairElementary : pairTwo ≤ pairElementary :=
  sup_le pairOne_le_pairElementary (zpowers_le.mpr pairElementary_generators.2.1)

theorem reflection_mem_pairOne : swap01 ∈ pairOne := mem_zpowers swap01

theorem reflection_mem_pairTwo : swap01 ∈ pairTwo :=
  (show pairOne ≤ pairTwo from le_sup_left) reflection_mem_pairOne

theorem pairOne_normalizes_cubic : pairOne ≤ normalizer (zpowers cubic : Set Sym) :=
  pairOne_le_pairElementary.trans pairElementary_normalizes_cubic

theorem pairTwo_normalizes_cubic : pairTwo ≤ normalizer (zpowers cubic : Set Sym) :=
  pairTwo_le_pairElementary.trans pairElementary_normalizes_cubic

/-- Every subgroup of the elementary eight has relative index three in its
join with this cubic. -/
theorem local_relIndex_of_le_pairElementary (E : Subgroup Sym) (hE : E ≤ pairElementary) :
    E.relIndex (zpowers cubic ⊔ E) = 3 := by
  have hd : Disjoint (zpowers cubic) pairElementary := disjoint_of_coprime_natCard (by
    rw [Nat.card_zpowers, cubic_order, pairElementary_card]
    decide)
  have hcard := card_sup_eq_mul_of_normalizes_of_disjoint (zpowers cubic) E
    (hE.trans pairElementary_normalizes_cubic) (hd.mono_right hE)
  rw [Nat.card_zpowers, cubic_order] at hcard
  have h := relIndex_mul_relIndex (⊥ : Subgroup Sym) E (zpowers cubic ⊔ E)
    bot_le le_sup_right
  rw [relIndex_bot_left, relIndex_bot_left, hcard, mul_comm 3] at h
  exact Nat.eq_of_mul_eq_mul_left Nat.card_pos h

theorem pairOne_local_relIndex : pairOne.relIndex (zpowers cubic ⊔ pairOne) = 3 :=
  local_relIndex_of_le_pairElementary pairOne pairOne_le_pairElementary

theorem pairTwo_local_relIndex : pairTwo.relIndex (zpowers cubic ⊔ pairTwo) = 3 :=
  local_relIndex_of_le_pairElementary pairTwo pairTwo_le_pairElementary

theorem pairPoint_fixed_pairOne :
    pairPoint ∈ fixedSpace (naturalRepresentation (Fin 7)) pairOne := by
  intro a
  exact pairPoint_fixed ⟨a, pairOne_le_pairElementary a.property⟩

theorem pairPoint_fixed_pairTwo :
    pairPoint ∈ fixedSpace (naturalRepresentation (Fin 7)) pairTwo := by
  intro a
  exact pairPoint_fixed ⟨a, pairTwo_le_pairElementary a.property⟩

theorem cubic_moves_pairOne_fixed :
    ¬fixedSpace (naturalRepresentation (Fin 7)) pairOne ≤
      fixedSpace (naturalRepresentation (Fin 7)) (zpowers cubic) := by
  intro h
  apply cubic_moves_pair_fixed
  intro v hv
  exact h (fun a => hv ⟨a, pairOne_le_pairElementary a.property⟩)

theorem cubic_moves_pairTwo_fixed :
    ¬fixedSpace (naturalRepresentation (Fin 7)) pairTwo ≤
      fixedSpace (naturalRepresentation (Fin 7)) (zpowers cubic) := by
  intro h
  apply cubic_moves_pair_fixed
  intro v hv
  exact h (fun a => hv ⟨a, pairTwo_le_pairElementary a.property⟩)

private theorem eq_top_of_star (N : Subgroup Sym)
    (hstar : ∀ i : Fin 6, swap i.castSucc (6 : Fin 7) ∈ N) : N = ⊤ := by
  apply top_unique
  rw [← Subgroup.closure_eq_top_of_mclosure_eq_top (Perm.mclosure_swap_castSucc_succ 6)]
  apply (Subgroup.closure_le _).mpr
  rintro x ⟨i, rfl⟩
  change swap i.castSucc i.succ ∈ N
  by_cases hi : i = 5
  · subst i
    exact hstar 5
  · have hi' : i.val + 1 < 6 := by omega
    let j : Fin 6 := ⟨i.val + 1, hi'⟩
    have he : swap i.castSucc (6 : Fin 7) * swap j.castSucc 6 * swap i.castSucc 6 =
        swap i.castSucc i.succ :=
      (by decide +kernel : ∀ (i j : Fin 6), j.val = i.val + 1 →
        swap i.castSucc (6 : Fin 7) * swap j.castSucc 6 * swap i.castSucc 6 =
          swap i.castSucc i.succ) i j rfl
    rw [← he]
    exact N.mul_mem (N.mul_mem (hstar i) (hstar j)) (hstar i)

private theorem first_star (N : Subgroup Sym) (hr : swap01 ∈ N) (hc : cubic ∈ N) :
    swap (0 : Fin 7) 6 ∈ N ∧ swap (1 : Fin 7) 6 ∈ N := by
  have h16 : swap (1 : Fin 7) 6 ∈ N := by
    rw [← show swap01 * cubic = swap (1 : Fin 7) 6 by decide +kernel]
    exact N.mul_mem hr hc
  refine ⟨?_, h16⟩
  rw [← show swap01 * swap (1 : Fin 7) 6 * swap01 = swap (0 : Fin 7) 6 by decide +kernel]
  exact N.mul_mem (N.mul_mem hr h16) hr

theorem pairOne_normalizer_cubic_generate :
    normalizer (pairOne : Set Sym) ⊔ zpowers cubic = ⊤ := by
  let N := normalizer (pairOne : Set Sym) ⊔ zpowers cubic
  have hE : pairOne ≤ N := pairOne.le_normalizer.trans le_sup_left
  have hr : swap01 ∈ N := hE reflection_mem_pairOne
  have hc : cubic ∈ N := (show zpowers cubic ≤ N from le_sup_right) (mem_zpowers cubic)
  have hs := first_star N hr hc
  apply eq_top_of_star
  intro i
  by_cases hi : 2 ≤ i.val
  · apply (show normalizer (pairOne : Set Sym) ≤ N from le_sup_left)
    rw [mem_normalizer_iff_map_conj_eq, pairOne, MonoidHom.map_zpowers]
    change zpowers (swap i.castSucc 6 * swap01 * (swap i.castSucc 6)⁻¹) = zpowers swap01
    rw [(by decide +kernel : ∀ i : Fin 6, 2 ≤ i.val →
      swap i.castSucc 6 * swap01 * (swap i.castSucc 6)⁻¹ = swap01) i hi]
  · have hi' : i = 0 ∨ i = 1 := by omega
    rcases hi' with rfl | rfl
    · exact hs.1
    · exact hs.2

private def twoTransport (i : Fin 4) : Sym :=
  ![swap01, 1, swap23 * crossSwap, crossSwap] i

private theorem twoTransport_normalizes (i : Fin 4) :
    twoTransport i ∈ normalizer (pairTwo : Set Sym) := by
  have he :
      (twoTransport i * swap01 * (twoTransport i)⁻¹ = swap01 ∧
       twoTransport i * swap23 * (twoTransport i)⁻¹ = swap23) ∨
      (twoTransport i * swap01 * (twoTransport i)⁻¹ = swap23 ∧
       twoTransport i * swap23 * (twoTransport i)⁻¹ = swap01) :=
    (by decide +kernel : ∀ i : Fin 4,
      (twoTransport i * swap01 * (twoTransport i)⁻¹ = swap01 ∧
       twoTransport i * swap23 * (twoTransport i)⁻¹ = swap23) ∨
      (twoTransport i * swap01 * (twoTransport i)⁻¹ = swap23 ∧
       twoTransport i * swap23 * (twoTransport i)⁻¹ = swap01)) i
  rw [mem_normalizer_iff_map_conj_eq, pairTwo, Subgroup.map_sup,
    MonoidHom.map_zpowers, MonoidHom.map_zpowers]
  change zpowers (twoTransport i * swap01 * (twoTransport i)⁻¹) ⊔
    zpowers (twoTransport i * swap23 * (twoTransport i)⁻¹) = zpowers swap01 ⊔ zpowers swap23
  rcases he with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · rw [h1, h2]
  · rw [h1, h2, sup_comm]

theorem pairTwo_normalizer_cubic_generate :
    normalizer (pairTwo : Set Sym) ⊔ zpowers cubic = ⊤ := by
  let N := normalizer (pairTwo : Set Sym) ⊔ zpowers cubic
  have hE : pairTwo ≤ N := pairTwo.le_normalizer.trans le_sup_left
  have hr : swap01 ∈ N := hE reflection_mem_pairTwo
  have hc : cubic ∈ N := (show zpowers cubic ≤ N from le_sup_right) (mem_zpowers cubic)
  have h16 := (first_star N hr hc).2
  apply eq_top_of_star
  intro i
  by_cases hi : i.val < 4
  · let j : Fin 4 := ⟨i.val, hi⟩
    have hg : twoTransport j ∈ N :=
      (show normalizer (pairTwo : Set Sym) ≤ N from le_sup_left) (twoTransport_normalizes j)
    have he : twoTransport j * swap (1 : Fin 7) 6 * (twoTransport j)⁻¹ =
        swap i.castSucc (6 : Fin 7) :=
      (by decide +kernel : ∀ (j : Fin 4) (i : Fin 6), j.val = i.val →
        twoTransport j * swap (1 : Fin 7) 6 * (twoTransport j)⁻¹ =
          swap i.castSucc (6 : Fin 7)) j i rfl
    rw [← he]
    exact N.mul_mem (N.mul_mem hg h16) (N.inv_mem hg)
  · apply (show normalizer (pairTwo : Set Sym) ≤ N from le_sup_left)
    rw [mem_normalizer_iff_map_conj_eq, pairTwo, Subgroup.map_sup,
      MonoidHom.map_zpowers, MonoidHom.map_zpowers]
    have he : swap i.castSucc 6 * swap01 * (swap i.castSucc 6)⁻¹ = swap01 ∧
        swap i.castSucc 6 * swap23 * (swap i.castSucc 6)⁻¹ = swap23 :=
      (by decide +kernel : ∀ i : Fin 6, ¬i.val < 4 →
        swap i.castSucc 6 * swap01 * (swap i.castSucc 6)⁻¹ = swap01 ∧
        swap i.castSucc 6 * swap23 * (swap i.castSucc 6)⁻¹ = swap23) i hi
    change zpowers (swap i.castSucc 6 * swap01 * (swap i.castSucc 6)⁻¹) ⊔
      zpowers (swap i.castSucc 6 * swap23 * (swap i.castSucc 6)⁻¹) = zpowers swap01 ⊔ zpowers swap23
    rw [he.1, he.2]

end Theory.SpecificGroups.SymmetricSeven.ThreePairsCubic
