module

public import Theory.SpecificGroups.SymmetricSeven.LocalResidualRecognition.Coordinates
/-!
# The cubic residual of an index-three overgroup in S₇

The subgroup preserving the matching `{23,45}` has a unique expression
`cⁿb`, with `0 ≤ n < 3`, `c = (016)`, and `b` in the standard Sylow subgroup.
It therefore has order 48. Its normal subgroup generated by `c` has a
2-group quotient of order 16; conversely, every two-residual contains `c`
because its order is three. This computes the embedded residual and
identifies it with a conjugate of the published action on `{4,5,6}`.

The normality check uses only the 48 explicit words, and the order proof
uses a proved bijection rather than enumeration of S₇.
Source: Aschbacher–Smith, I.5 and the final proof of 15.3.1, printed p.1155.
-/

@[expose] public section

open Equiv Subgroup
open Theory.SpecificGroups.SymmetricSeven.LocalResidualModels
namespace Theory.SpecificGroups.SymmetricSeven.LocalResidualRecognition

private def smallCycle : S7 := swap 0 1 * swap 1 6
private theorem smallCycle_mem : smallCycle ∈ cubicOvergroup := by decide

private theorem cubic_triple (g : S7) (hg : g ∈ cubicOvergroup) :
    ({0,1,6} : Finset (Fin 7)).image g = {0,1,6} := by
  change ({{2,3},{4,5}} : Finset (Finset (Fin 7))).image (fun t => t.image g) = _ at hg
  have hu := congrArg (fun s : Finset (Finset (Fin 7)) => s.biUnion id) hg
  rw [Finset.image_biUnion] at hu
  have hfour : ({2,3,4,5} : Finset (Fin 7)).image g = {2,3,4,5} := by
    simpa only [Finset.biUnion_insert, Finset.singleton_biUnion, id_eq,
      Finset.image_insert, Finset.image_singleton, Finset.insert_union,
      Finset.singleton_union, Finset.union_empty] using hu
  have he : ({0,1,6} : Finset (Fin 7)) = Finset.univ \ {2,3,4,5} := by decide
  rw [he, Finset.image_sdiff _ _ g.injective, Finset.image_univ_of_surjective g.surjective, hfour]

private theorem cubic_fixed (g : S7) (hg : g ∈ cubicOvergroup) (h6 : g 6 = 6) :
    g ∈ standardTwo := by
  have ht := cubic_triple g hg
  have hd : ({0,1} : Finset (Fin 7)).image g = {0,1} := by
    have he : ({0,1} : Finset (Fin 7)) = {0,1,6} \ {6} := by decide
    rw [he, Finset.image_sdiff _ _ g.injective, ht]
    simp only [Finset.image_singleton, h6]

  have hs : ({{0,1},{2,3},{4,5}} : Finset (Finset (Fin 7))).image
      (fun t => t.image g) = {{0,1},{2,3},{4,5}} := by
    change ({{0,1}} ∪ {{2,3},{4,5}} : Finset (Finset (Fin 7))).image
      (fun t => t.image g) = _
    rw [Finset.image_union, Finset.image_singleton, hd]
    change ({{2,3},{4,5}} : Finset (Finset (Fin 7))).image (fun t => t.image g) = _ at hg
    rw [hg]
    rfl
  exact ⟨⟨h6, hd⟩, ⟨h6, hs⟩⟩


private def cubicWord (i : Fin 3 × Fin 16) : S7 := smallCycle ^ i.1.val * sylowWord i.2

private theorem cubicWord_mem (i : Fin 3 × Fin 16) : cubicWord i ∈ cubicOvergroup :=
  cubicOvergroup.mul_mem (cubicOvergroup.pow_mem smallCycle_mem _)
    (standardTwo_le_cubic (sylowWord_mem _))

private theorem cubicWord_injective : Function.Injective cubicWord := by
  intro i j hij
  have he := congrArg (fun g : S7 => g 6) hij
  change (smallCycle ^ i.1.val) (sylowWord i.2 6) = (smallCycle ^ j.1.val) (sylowWord j.2 6) at he
  have hi6 : sylowWord i.2 6 = 6 := (sylowWord_mem i.2).1.1
  have hj6 : sylowWord j.2 6 = 6 := (sylowWord_mem j.2).1.1
  rw [hi6, hj6] at he
  have hc : Function.Injective (fun n : Fin 3 => (smallCycle ^ n.val) (6 : Fin 7)) := by decide
  have hfirst := hc he
  have hsecond : i.2 = j.2 := by
    apply sylowWord_injective
    apply mul_left_cancel (a := smallCycle ^ i.1.val)
    change smallCycle ^ i.1.val * sylowWord i.2 = smallCycle ^ j.1.val * sylowWord j.2 at hij
    simpa only [hfirst] using hij
  exact Prod.ext hfirst hsecond

private theorem cubicWord_surjective : Function.Surjective
    (fun i => (⟨cubicWord i, cubicWord_mem i⟩ : cubicOvergroup)) := by
  intro g
  have ht : g.val 6 ∈ ({0,1,6} : Finset (Fin 7)) := by
    rw [← cubic_triple g.val g.property]
    exact Finset.mem_image_of_mem _ (by decide)
  have he : ∃ n : Fin 3, (smallCycle ^ n.val) (6 : Fin 7) = g.val 6 := by
    exact (show ∀ x : Fin 7, x ∈ ({0,1,6} : Finset (Fin 7)) →
      ∃ n : Fin 3, (smallCycle ^ n.val) 6 = x by decide) _ ht
  obtain ⟨n, hn⟩ := he
  let b := (smallCycle ^ n.val)⁻¹ * g.val
  have hbC : b ∈ cubicOvergroup := cubicOvergroup.mul_mem
    (cubicOvergroup.inv_mem (cubicOvergroup.pow_mem smallCycle_mem _)) g.property
  have hb6 : b 6 = 6 := by
    change (smallCycle ^ n.val).symm (g.val 6) = 6
    rw [← hn]
    exact (smallCycle ^ n.val).symm_apply_apply 6
  obtain ⟨i, hi⟩ := sylowEquiv.surjective ⟨b, cubic_fixed b hbC hb6⟩
  refine ⟨(n, i), Subtype.ext ?_⟩
  have he : sylowWord i = b := congrArg Subtype.val hi
  change smallCycle ^ n.val * sylowWord i = g.val
  rw [he]
  exact mul_inv_cancel_left _ _

private noncomputable def cubicEquiv : Fin 3 × Fin 16 ≃ cubicOvergroup :=
  Equiv.ofBijective _ ⟨fun _ _ h => cubicWord_injective (congrArg Subtype.val h),
    cubicWord_surjective⟩

theorem cubicOvergroup_card : Nat.card cubicOvergroup = 48 := by
  rw [← Nat.card_congr cubicEquiv, Nat.card_prod, Nat.card_fin, Nat.card_fin]


private theorem smallCycle_order : orderOf smallCycle = 3 :=
  orderOf_eq_prime (by decide : smallCycle ^ 3 = 1) (by decide : smallCycle ≠ 1)

private theorem cubic_normalizes_cycle : cubicOvergroup ≤ normalizer (zpowers smallCycle : Set S7) := by
  have hgen : ∀ g ∈ cubicOvergroup, g * smallCycle * g⁻¹ ∈ zpowers smallCycle := by
    intro g hg
    obtain ⟨i, hi⟩ := cubicEquiv.surjective ⟨g, hg⟩
    have he : cubicWord i = g := congrArg Subtype.val hi
    have ht : ∀ i : Fin 3 × Fin 16,
        cubicWord i * smallCycle * (cubicWord i)⁻¹ = smallCycle ∨
        cubicWord i * smallCycle * (cubicWord i)⁻¹ = smallCycle⁻¹ := by decide +kernel
    rw [← he]
    rcases ht i with hh | hh
    · rw [hh]; exact mem_zpowers smallCycle
    · rw [hh]; exact (zpowers smallCycle).inv_mem (mem_zpowers smallCycle)
  apply le_normalizer_iff.mpr
  intro g hg k hk
  obtain ⟨n, rfl⟩ := hk
  change (MulAut.conj g) (smallCycle ^ n) ∈ zpowers smallCycle
  rw [map_zpow]
  exact (zpowers smallCycle).zpow_mem (hgen g hg) n

private theorem residual_cubic : (pResidual 2 cubicOvergroup).map cubicOvergroup.subtype =
    zpowers smallCycle := by
  have hle : zpowers smallCycle ≤ cubicOvergroup := zpowers_le.mpr smallCycle_mem
  let N := (zpowers smallCycle).subgroupOf cubicOvergroup
  let _ : N.Normal := normal_subgroupOf_of_le_normalizer cubic_normalizes_cycle
  have hncard : Nat.card N = 3 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hle).toEquiv, Nat.card_zpowers, smallCycle_order]
  have hindex : N.index = 16 := by
    have hh := N.card_mul_index
    rw [hncard, cubicOvergroup_card] at hh
    omega
  have hp : IsPGroup 2 (cubicOvergroup ⧸ N) :=
    IsPGroup.of_card (n := 4) hindex
  apply le_antisymm
  · exact (map_mono (show pResidual 2 cubicOvergroup ≤ N from
      sInf_le ⟨inferInstance, hp⟩)).trans_eq (map_subgroupOf_eq_of_le hle)
  · apply zpowers_le.mpr
    let y : cubicOvergroup := ⟨smallCycle, smallCycle_mem⟩
    have hy : y ^ 3 = 1 := Subtype.ext (by decide : smallCycle ^ 3 = 1)
    have ho : Nat.Coprime 2 (orderOf y) :=
      Nat.Coprime.of_dvd_right (orderOf_dvd_of_pow_eq_one hy) (by decide)
    exact ⟨y, mem_pResidual_of_orderOf_coprime ho, rfl⟩

def cubicConjugator : S7 := swap 0 4 * swap 1 5

theorem residual_cubicOvergroup : (pResidual 2 cubicOvergroup).map cubicOvergroup.subtype =
    cubicResidual7.map (MulAut.conj cubicConjugator).toMonoidHom := by
  rw [residual_cubic, cubicResidual7, MonoidHom.map_zpowers]
  congr 1
  decide

end Theory.SpecificGroups.SymmetricSeven.LocalResidualRecognition
