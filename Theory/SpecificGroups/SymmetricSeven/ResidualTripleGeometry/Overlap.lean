module

public import Theory.SpecificGroups.SymmetricSeven.ResidualTripleGeometry.Pointwise
public import Theory.SpecificGroups.SymmetricSix.Parabolics.TwoCores.Duad.Calculation
public import Theory.GroupTheory.PCoreProduct

/-!
# The overlap quotient for the residual triple in S₇

The two residuals together with the standard Sylow generate the literal
S₄ × S₃ action on `{2,3,4,5}` and `{0,1,6}`. The action of S₄ on its three
double transpositions has Klein-four kernel. Together with the second
factor this gives a surjection onto S₃ × S₃ whose kernel is exactly the
intrinsic two-core. The resulting quotient equivalence retains its equation
on the original quotient map; the four-point factor comes first.

Source: Aschbacher–Smith, Lemma 14.4.11(2), printed p.1011
(combined manuscript of 1 March 2004).
-/

@[expose] public section
open Equiv Subgroup
open Theory.SpecificGroups.SymmetricSeven.LocalResidualModels
open Theory.SpecificGroups.SymmetricSeven.LocalResidualRecognition
open Theory.SpecificGroups.SymmetricSix
namespace Theory.SpecificGroups.SymmetricSeven.ResidualTripleGeometry
/-- The literal overlap generated by the two residual actors and the Sylow subgroup. -/
def overlap : Subgroup S7 := C ⊔ D ⊔ standardTwo

private theorem fourHom_le_overlap : fourHom.range ≤ overlap := by
  rintro g ⟨a, rfl⟩
  have ha : ∃ b : ResidualPairRecognition.A, ∃ n : Fin 2,
      a = b.val * (swap 0 1) ^ n.val :=
    (show ∀ a : S4, ∃ b : ResidualPairRecognition.A, ∃ n : Fin 2,
      a = b.val * (swap 0 1) ^ n.val by decide +kernel) a
  obtain ⟨b, n, rfl⟩ := ha
  rw [map_mul, map_pow]
  apply overlap.mul_mem
  · apply (show D ≤ overlap from le_sup_right.trans le_sup_left)
    rw [D_eq]
    exact ⟨b.val,b.property,rfl⟩
  · apply overlap.pow_mem
    exact (show standardTwo ≤ overlap from le_sup_right)
      (by decide)

private theorem threeHom_le_overlap : threeHom.range ≤ overlap := by
  rintro g ⟨a, rfl⟩
  have ha : ∃ b : S3, b.sign = 1 ∧ ∃ n : Fin 2, a = b * (swap 0 1) ^ n.val :=
    (show ∀ a : S3, ∃ b : S3, b.sign = 1 ∧ ∃ n : Fin 2,
      a = b * (swap 0 1) ^ n.val by decide +kernel) a
  obtain ⟨b, hb, n, rfl⟩ := ha
  rw [map_mul, map_pow]
  apply overlap.mul_mem
  · apply (show C ≤ overlap from le_sup_left.trans le_sup_left)
    rw [C_eq]
    exact ⟨b,hb,rfl⟩
  · apply overlap.pow_mem
    exact (show standardTwo ≤ overlap from le_sup_right)
      (by decide)

theorem overlap_eq_range : overlap = blockHom.range := by
  apply le_antisymm
  · apply sup_le
    · apply sup_le
      · rw [C_eq]
        rintro g ⟨a, ha, rfl⟩
        exact ⟨(1,a),rfl⟩
      · rw [D_eq]
        rintro g ⟨a, ha, rfl⟩
        exact ⟨(a,1),rfl⟩
    · intro g hg
      obtain ⟨i, hi⟩ := sylowEquiv.surjective ⟨g,hg⟩
      have he : sylowWord i = g := congrArg Subtype.val hi
      rw [← he]
      exact (show ∀ i : Fin 16, ∃ a : S4 × S3, blockHom a = sylowWord i by decide +kernel) i
  · rintro g ⟨⟨a,b⟩,rfl⟩
    have he : blockHom (a,b) = fourHom a * threeHom b := by
      change blockHom (a,b) = blockHom (a,1) * blockHom (1,b)
      rw [← map_mul]
      simp
    rw [he]
    exact overlap.mul_mem (fourHom_le_overlap ⟨a,rfl⟩) (threeHom_le_overlap ⟨b,rfl⟩)

/-- Coordinates on the actual overlap, in the order four-point then three-point factor. -/
noncomputable def overlapEquiv : overlap ≃* (S4 × S3) :=
  (MulEquiv.subgroupCongr overlap_eq_range).trans (MonoidHom.ofInjective blockHom_injective).symm

/-- Action on the three double transpositions of the four-point block, together
with the full action on the complementary three points. -/
noncomputable def overlapProjection : overlap →* S3 × S3 :=
  (DuadCalculation.quotientHom.prodMap (MonoidHom.id S3)).comp overlapEquiv.toMonoidHom

theorem overlapProjection_surjective : Function.Surjective overlapProjection := by
  change Function.Surjective ((DuadCalculation.quotientHom.prodMap (MonoidHom.id S3)) ∘ overlapEquiv)
  apply Function.Surjective.comp _ overlapEquiv.surjective
  rintro ⟨a,b⟩
  obtain ⟨x,rfl⟩ := DuadCalculation.quotientHom_surjective a
  exact ⟨(x,b),rfl⟩

private theorem three_core : pCore 2 S3 = ⊥ := by
  have h := ker_eq_twoCore_of_surjective_perm_three (MonoidHom.id S3)
    Function.surjective_id (by rw [MonoidHom.ker_id]; exact IsPGroup.of_card (n := 0) (by simp))
  exact h.symm.trans MonoidHom.ker_id

theorem overlapProjection_ker : overlapProjection.ker = pCore 2 overlap := by
  rw [overlapProjection, ← MonoidHom.comap_ker, MonoidHom.ker_prodMap,
    MonoidHom.ker_id]
  change (DuadCalculation.core.prod (⊥ : Subgroup S3)).comap overlapEquiv.toMonoidHom = _
  rw [DuadCalculation.core_eq, ← three_core, ← pCore_prod,
    ← pCore_map_iso 2 overlapEquiv]
  exact comap_map_eq_self_of_injective overlapEquiv.injective _

/-- The actual intrinsic two-core quotient is S₃ × S₃. -/
noncomputable def overlapQuotientEquiv : (overlap ⧸ pCore 2 overlap) ≃* (S3 × S3) :=
  (QuotientGroup.quotientMulEquivOfEq overlapProjection_ker.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective overlapProjection overlapProjection_surjective)

/-- The quotient equivalence is induced by the specified permutation action. -/
theorem overlapQuotientEquiv_mk (g : overlap) :
    overlapQuotientEquiv (QuotientGroup.mk' (pCore 2 overlap) g) = overlapProjection g := by
  rfl



end Theory.SpecificGroups.SymmetricSeven.ResidualTripleGeometry
