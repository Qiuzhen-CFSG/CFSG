module

public import Theory.SpecificGroups.PSU3.UniversalCover.Projection
public import Theory.GroupTheory.PerfectCentralCoverCyclicFixedBound

/-!
# The odd three-primary torus input for a perfect-cover kernel bound

Use a torus of odd exponent in the actual projective group, generated by
an exchanged commuting pair. Adjoining a normalizing cycle must give a
subgroup of index prime to three. The fixed subgroup of that cycle inside
the projective torus has order at most three. The commutator-map transfer
bound then excludes nine from every finite perfect central kernel.

For odd q the full norm-one torus has even order. The intended witness
therefore uses its three-primary part; no bound on that part's exponent is
imposed. The scalar cube-root quotient remains part of the fixed-subgroup
calculation. This module proves the covering implication; constructing the
matrix witness is a separate obligation.

Source: Aschbacher–Smith I.1.3(2), I.1.4(2), printed pp.407–408
(PDF pp.418–419); GLS3, Theorem 6.1.4 and Tables 6.1.2–3.
-/

public section

open Subgroup BenderSuzuki.MatrixGroups PerfectCentralCovering

namespace BenderSuzuki.MatrixGroups.HermitianForm.UniversalCover.OddKernelBound.OddCrossCharacteristic

variable {F : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)

/-- Explicit local subgroup and conjugation facts, with no covering premise. -/
structure ThreeTorus where
  torus : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)
  first : ProjectiveSpecialUnitaryMatrixGroup J
  second : ProjectiveSpecialUnitaryMatrixGroup J
  cycle : ProjectiveSpecialUnitaryMatrixGroup J
  swapper : ProjectiveSpecialUnitaryMatrixGroup J
  generate : closure ({first, second} : Set (ProjectiveSpecialUnitaryMatrixGroup J)) = torus
  commute : Commute first second
  swap_first : swapper * first * swapper⁻¹ = second
  swap_second : swapper * second * swapper⁻¹ = first
  exponent : ℕ
  coprime_two : exponent.Coprime 2
  first_pow : first ^ exponent = 1
  normalizes : cycle ∈ normalizer (torus : Set (ProjectiveSpecialUnitaryMatrixGroup J))
  index_prime_to_three : ¬ 3 ∣ (torus ⊔ zpowers cycle).index
  fixed_card_le : Nat.card (torus ⊓ centralizer ({cycle} :
    Set (ProjectiveSpecialUnitaryMatrixGroup J)) : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) ≤ 3

/-- The fixed-subgroup bound applied to the literal PSU₃ cover kernel. -/
theorem not_nine_dvd_kernel_of_three_torus (t : ThreeTorus J)
    {E : Type*} [Group E] [Finite E]
    (f : Cover E (ProjectiveSpecialUnitaryMatrixGroup J)) :
    ¬ 9 ∣ Nat.card f.toMonoidHom.ker :=
  f.not_primePower_dvd_kernel_of_swapped_torus_fixed
    t.torus t.first t.second t.cycle t.swapper t.generate t.commute
    t.swap_first t.swap_second t.coprime_two t.first_pow t.normalizes
    t.index_prime_to_three (lt_of_le_of_lt t.fixed_card_le (by decide : 3 < 3 ^ 2))

end BenderSuzuki.MatrixGroups.HermitianForm.UniversalCover.OddKernelBound.OddCrossCharacteristic
