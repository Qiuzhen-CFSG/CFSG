/-!
# The rank-two `q + 1` branch of the even-field large-prime bound

For `q = 2^n`, the projective frame torus has two norm-one coordinates.  A
Sylow subgroup of its product is generated by the two coordinate elements;
the determinant-one coordinate permutation swaps them.  The exact torus index
is `q^3 (q - 1) (q^2 - q + 1)`, so a prime `p > 3` dividing `q + 1` misses
that index.  The swapped lifts therefore commute in every perfect central
cover, and the abelian Sylow-preimage transfer lemma removes `p` from the
covering kernel.  The cyclic `q^2 - q + 1` Singer branch is intentionally
separate: it requires its own concrete torus construction.

Source: Aschbacher--Smith I.1.2--I.1.3 (PDF p.418), GLS3 Theorem 6.1.4 and
Tables 6.1.2--3.  The frame and permutation calculations use the checked
unitary-three normalizer modules.
-/

namespace BenderSuzuki.MatrixGroups.HermitianForm.UniversalCover.EvenKernelBound.LargePrimary
set_option maxHeartbeats 1000000
variable {F : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)

theorem projective_card {q : ℕ} (hcard : Nat.card F = q ^ 2)
    (hconj : ∀ x, J.conj x = x ^ q) :
    Nat.card (ProjectiveSpecialUnitaryMatrixGroup J) =
      (q ^ 3 + 1) * q ^ 3 * (q ^ 2 - 1) / Nat.gcd 3 (q + 1) := by
  have hfixed := card_fixed J hcard hconj
  obtain ⟨e⟩ := FormTransport.exists_projectiveEquiv J q hcard hfixed
  obtain ⟨_, _, _, _, _, _, _, _, hc, _⟩ :=
    huppert_II_10_12 (FormTransport.standardForm J) q hcard hfixed rfl
  exact (Nat.card_congr e.toEquiv).trans hc

private theorem cubic_factor {q : ℕ} (hq : 1 < q) :
    q ^ 3 + 1 = (q + 1) * (q ^ 2 - q + 1) := by
  have hs := Nat.sub_add_cancel (show q ≤ q ^ 2 by nlinarith)
  have hh := congrArg (fun a : ℕ => (q + 1) * a) hs
  nlinarith

theorem frameTorus_index (P : OrthogonalFrame J) {q : ℕ} (hq : 1 < q)
    (hcard : Nat.card F = q ^ 2) (hconj : ∀ x, J.conj x = x ^ q) :
    (projectiveFrameTorus J P).index = q ^ 3 * (q - 1) * (q ^ 2 - q + 1) := by
  have ht := projectiveFrameTorus_card J P q hcard (card_fixed J hcard hconj)
  have hG := projective_card J hcard hconj
  have hd := Nat.gcd_dvd_right 3 (q + 1)
  have hs : q ^ 2 - 1 = (q - 1) * (q + 1) := by
    simpa [mul_comm] using Nat.sq_sub_sq q 1
  have he : Nat.card (ProjectiveSpecialUnitaryMatrixGroup J) =
      Nat.card (projectiveFrameTorus J P) *
        (q ^ 3 * (q - 1) * (q ^ 2 - q + 1)) := by
    rw [hG, ht, cubic_factor hq, hs]
    calc
      _ = ((q + 1) * (q ^ 3 * (q - 1) * (q ^ 2 - q + 1))) * (q + 1) /
          Nat.gcd 3 (q + 1) := by congr 1; ring
      _ = _ := by rw [Nat.mul_div_assoc _ hd]; ring
  exact Nat.eq_of_mul_eq_mul_left Nat.card_pos
    ((projectiveFrameTorus J P).card_mul_index.trans he)

theorem not_dvd_frameTorus_index (P : OrthogonalFrame J) {q p : ℕ} (hq : 1 < q)
    (hp : p.Prime) (hp3 : 3 < p) (hd : p ∣ q + 1)
    (hcard : Nat.card F = q ^ 2) (hconj : ∀ x, J.conj x = x ^ q) :
    ¬ p ∣ (projectiveFrameTorus J P).index := by
  let : Fact p.Prime := ⟨hp⟩
  have hqmod : (q : ZMod p) = -1 := by
    have hz := (CharP.cast_eq_zero_iff (ZMod p) p (q + 1)).mpr hd
    push_cast at hz
    exact eq_neg_of_add_eq_zero_left hz
  intro hi
  rw [frameTorus_index J P hq hcard hconj] at hi
  have hh := (CharP.cast_eq_zero_iff (ZMod p) p _).mpr hi
  have hle : q ≤ q ^ 2 := by nlinarith
  push_cast [Nat.cast_sub (by omega : 1 ≤ q), Nat.cast_sub hle] at hh
  rw [hqmod] at hh
  have h6 : (6 : ZMod p) = 0 := by linear_combination hh
  have hd6 := (CharP.cast_eq_zero_iff (ZMod p) p 6).mp h6
  have : p = 2 ∨ p = 3 := by
    rcases hp.dvd_mul.mp (show p ∣ 2 * 3 from hd6) with h | h
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp h)
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp h)
  omega

private theorem pair_generates {A G : Type*} [Group A] [Group G]
    (f : A × A →* G) (U : Subgroup A) (z : U)
    (hz : ∀ u : U, u ∈ zpowers z) :
    closure ({f (z, 1), f (1, z)} : Set G) = (U.prod U).map f := by
  apply le_antisymm
  · apply (closure_le _).mpr
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact ⟨(z, 1), ⟨z.property, U.one_mem⟩, rfl⟩
    · exact ⟨(1, z), ⟨U.one_mem, z.property⟩, rfl⟩
  · rintro g ⟨⟨a, b⟩, ⟨ha, hb⟩, rfl⟩
    obtain ⟨i, hi⟩ := mem_zpowers_iff.mp (hz ⟨a, ha⟩)
    obtain ⟨j, hj⟩ := mem_zpowers_iff.mp (hz ⟨b, hb⟩)
    have hi' : (z : A) ^ i = a := congrArg Subtype.val hi
    have hj' : (z : A) ^ j = b := congrArg Subtype.val hj
    have he : f (a, b) = f ((z : A), 1) ^ i * f (1, (z : A)) ^ j := by
      rw [← map_zpow, ← map_zpow, ← map_mul]
      congr 1
      ext <;> simp [hi', hj']
    rw [he]
    exact mul_mem (zpow_mem (subset_closure (by simp)) i)
      (zpow_mem (subset_closure (by simp)) j)

omit [Finite F] in
private theorem permutation_swap [CharP F 2] (P : OrthogonalFrame J)
    (a b : normOne J) :
    J.specialToProjective (specialPermutation J P (Equiv.swap 0 1)) *
        projectivePairHom J P (a, b) *
        (J.specialToProjective (specialPermutation J P (Equiv.swap 0 1)))⁻¹ =
      projectivePairHom J P (b, a) := by
  have h := specialMonomialAction_action J P (monomialPermutation J P (Equiv.swap 0 1))
  rw [specialMonomialAction_permutation] at h
  have h' := HasSpecialFrameAction.projective J P _ _ h
  simpa [permuteFramePair, frameTriple, monomialPermutation] using h' (a, b)

theorem exists_frame_configuration {n p : ℕ} (hn : 2 ≤ n)
    (hp : p.Prime) (hp3 : 3 < p) (hd : p ∣ 2 ^ n + 1)
    (hcard : Nat.card F = (2 ^ n) ^ 2) (hconj : ∀ x, J.conj x = x ^ (2 ^ n)) :
    ∃ (Q : Sylow p (ProjectiveSpecialUnitaryMatrixGroup J))
      (x y s : ProjectiveSpecialUnitaryMatrixGroup J) (m : ℕ),
      closure ({x, y} : Set (ProjectiveSpecialUnitaryMatrixGroup J)) = (Q : Subgroup _) ∧
      m.Coprime 2 ∧ x ^ m = 1 ∧ Commute x y ∧
      s * x * s⁻¹ = y ∧ s * y * s⁻¹ = x := by
  let : Fact p.Prime := ⟨hp⟩
  let : CharP F 2 := frame_char_two n hcard
  have hq : 1 < 2 ^ n := lt_of_lt_of_le (by decide : 1 < 2 ^ 2)
    (Nat.pow_le_pow_right (by decide) hn)
  obtain ⟨C, hC⟩ := huppert_II_10_4_a_orthonormal_basis 3 J (2 ^ n)
    hcard (card_fixed J hcard hconj)
  let P : OrthogonalFrame J := ⟨C, hC⟩
  let U : Sylow p (normOne J) := Classical.choice inferInstance
  let R := (U : Subgroup (normOne J)).prod (U : Subgroup (normOne J))
  let H := R.map (projectivePairHom J P)
  have hi : ¬ p ∣ H.index := by
    rw [show H.index = (R ⊔ (projectivePairHom J P).ker).index *
        (projectivePairHom J P).range.index from index_map _ _, projectivePairHom_range]
    apply hp.not_dvd_mul _ (not_dvd_frameTorus_index J P hq hp hp3 hd hcard hconj)
    intro hh
    have hdR : p ∣ R.index := hh.trans (index_dvd_of_le le_sup_left)
    rw [index_prod] at hdR
    exact hp.not_dvd_mul U.not_dvd_index U.not_dvd_index hdR
  obtain ⟨k, hk⟩ := U.isPGroup'.exists_card_eq
  have hR : IsPGroup p R := by
    apply IsPGroup.of_card (n := k + k)
    dsimp [R]
    rw [Nat.card_congr (Subgroup.prodEquiv (U : Subgroup (normOne J))
      (U : Subgroup (normOne J))).toEquiv, Nat.card_prod, hk, pow_add]
  let Q := (hR.map (projectivePairHom J P)).toSylow hi
  obtain ⟨z, hz⟩ := IsCyclic.exists_generator (α := U)
  have hm : (Nat.card U).Coprime 2 := by
    rw [hk]
    exact ((Nat.prime_two.coprime_iff_not_dvd.mpr (by
      intro h
      have he := (Nat.prime_dvd_prime_iff_eq Nat.prime_two hp).mp h
      omega)).symm).pow_left k
  refine ⟨Q, projectivePairHom J P (z, 1), projectivePairHom J P (1, z),
    J.specialToProjective (specialPermutation J P (Equiv.swap 0 1)), Nat.card U,
    pair_generates _ _ z hz, hm, ?_, ?_, permutation_swap J P _ _, permutation_swap J P _ _⟩
  · rw [← map_pow]
    have hzpow : (z : normOne J) ^ Nat.card U = 1 :=
      congrArg Subtype.val (pow_card_eq_one' (x := z))
    have hpair : ((z : normOne J), (1 : normOne J)) ^ Nat.card U = 1 :=
      Prod.ext hzpow (one_pow _)
    rw [hpair, map_one]
  · exact (Commute.all ((z : normOne J), 1) (1, (z : normOne J))).map _

theorem not_dvd_cover_kernel_of_dvd_add_one {n p : ℕ} (hn : 2 ≤ n)
    (hp : p.Prime) (hp3 : 3 < p) (hd : p ∣ 2 ^ n + 1)
    (hcard : Nat.card F = (2 ^ n) ^ 2) (hconj : ∀ x, J.conj x = x ^ (2 ^ n))
    {E : Type*} [Group E] [Finite E]
    (f : Cover E (ProjectiveSpecialUnitaryMatrixGroup J)) :
    ¬ p ∣ Nat.card f.toMonoidHom.ker := by
  let : Fact p.Prime := ⟨hp⟩
  let : Group.IsPerfect E := f.isPerfect
  obtain ⟨Q, x, y, s, m, hQ, hm, hx, hxy, hsx, hsy⟩ :=
    exists_frame_configuration J hn hp hp3 hd hcard hconj
  obtain ⟨a, ha⟩ := f.surjective x
  obtain ⟨b, hb⟩ := f.surjective y
  have hab := CentralExtension.commute_lifts_of_swap f.toMonoidHom f.surjective
    f.ker_le_center x y s hm hx hxy hsx hsy a b ha hb
  exact not_dvd_card_kernel_of_abelian_sylow_preimage f.toMonoidHom f.surjective
    f.ker_le_center Q (CentralExtension.isMulCommutative_comap_of_pair_lifts
      f.toMonoidHom f.ker_le_center Q a b hab (by simpa only [ha, hb] using hQ))

theorem not_dvd_universal_kernel_of_dvd_add_one {n p : ℕ} (hn : 2 ≤ n)
    (hp : p.Prime) (hp3 : 3 < p) (hd : p ∣ 2 ^ n + 1)
    (hcard : Nat.card F = (2 ^ n) ^ 2) (hconj : ∀ x, J.conj x = x ^ (2 ^ n)) :
    ¬ p ∣ Nat.card (universalProjection (ProjectiveSpecialUnitaryMatrixGroup J)).ker := by
  have hq : 2 < 2 ^ n := lt_of_lt_of_le (by decide : 2 < 2 ^ 2)
    (Nat.pow_le_pow_right (by decide) hn)
  let := projective_isQuasisimple J hq hcard hconj
  exact not_dvd_cover_kernel_of_dvd_add_one J hn hp hp3 hd hcard hconj (universalCover _)

end BenderSuzuki.MatrixGroups.HermitianForm.UniversalCover.EvenKernelBound.LargePrimary

