module

public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.MatrixIdentification.Coordinates

/-!
# Suzuki generators are graph-field fixed

The explicit root, diagonal and Weyl matrices preserve the antidiagonal
symplectic form and satisfy the exterior-square minor equation. The Tits
identities proved in `Coordinates` reduce the generator calculations to
polynomial and inverse identities in characteristic two. Closure then embeds
the actual generated Suzuki subgroup in the genuine fixed subgroup.

Every calculation includes `m = 0`. The reverse inclusion requires a
separate reduction of arbitrary fixed matrices.

Source: Aschbacher--Smith 16.1.4(7), printed p.1171, and the Suzuki matrices
in Huppert--Blackburn III, XI.3.1--3.3 (upper-triangular convention).
-/

@[expose] public noncomputable section
namespace Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.MatrixIdentification
open BenderSuzuki.MatrixGroups Matrix

/-- The root matrix written with the Tits automorphism. -/
theorem rootMatrix_eq (m : ℕ) (a b : SuzukiField m) :
    SuzukiRootMatrix m a b =
      !![1,a,b,a^2 * suzukiTheta m a + a*b + suzukiTheta m b;
        0,1,suzukiTheta m a,a * suzukiTheta m a + b;
        0,0,1,a;
        0,0,0,1] := by
  simp only [SuzukiRootMatrix, suzukiTheta_apply, pow_add, pow_one]

/-- Suzuki root matrices preserve the symplectic form. -/
theorem rootMatrix_form (m : ℕ) (a b : SuzukiField m) :
    SuzukiRootMatrix m a b * suzukiForm * (SuzukiRootMatrix m a b).transpose =
      suzukiForm := by
  rw [rootMatrix_eq]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [suzukiForm, Matrix.mul_apply, Fin.sum_univ_four]
  all_goals ring_nf
  all_goals simp [CharTwo.two_eq_zero, show (4 : SuzukiField m) = 0 by
    have h : (2 : SuzukiField m) = 0 := CharTwo.two_eq_zero
    calc (4 : SuzukiField m) = 2 + 2 := by norm_num
         _ = 0 := by rw [h, add_zero]]

/-- The root matrices satisfy the twisted minor equation. -/
theorem rootMatrix_graph (m : ℕ) (a b : SuzukiField m) :
    coordinateGraph (SuzukiRootMatrix m a b) =
      (SuzukiRootMatrix m a b).map (suzukiTheta m) := by
  rw [rootMatrix_eq]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [coordinateGraph, coordinateFirst, coordinateSecond, Matrix.map_apply,
      suzukiTheta_twice, map_add, map_mul, map_pow]
  all_goals ring_nf
  all_goals simp [CharTwo.two_eq_zero]

/-- Every Suzuki root generator belongs to the actual fixed-matrix image. -/
theorem root_mem_fixedMatrixSubgroup (m : ℕ) (a b : SuzukiField m) :
    SuzukiRootGL m a b ∈ fixedMatrixSubgroup m := by
  rw [mem_fixedMatrixSubgroup_iff]
  exact ⟨rootMatrix_form m a b, rootMatrix_graph m a b⟩

/-- The diagonal generators preserve the symplectic form. -/
theorem torusMatrix_form (m : ℕ) (x : (SuzukiField m)ˣ) :
    SuzukiTorusMatrix m x * suzukiForm * (SuzukiTorusMatrix m x).transpose =
      suzukiForm := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [SuzukiTorusMatrix, suzukiForm, Matrix.mul_apply, Fin.sum_univ_four,
      pow_ne_zero _ x.ne_zero]

/-- The diagonal generators satisfy the twisted minor equation. -/
theorem torusMatrix_graph (m : ℕ) (x : (SuzukiField m)ˣ) :
    coordinateGraph (SuzukiTorusMatrix m x) =
      (SuzukiTorusMatrix m x).map (suzukiTheta m) := by
  have hs : ((x : SuzukiField m) ^ (2 ^ m)) ^ 2 = suzukiTheta m x := by
    rw [suzukiTheta_apply, ← pow_mul, ← pow_succ]
  have ht : suzukiTheta m ((x : SuzukiField m) ^ (2 ^ m)) = x :=
    suzukiTheta_half m x
  have ho : suzukiTheta m ((x : SuzukiField m) ^ (1 + 2 ^ m)) =
      x * ((x : SuzukiField m) ^ (2 ^ m)) ^ 2 := by
    rw [pow_add, pow_one, map_mul, ht, ← hs, mul_comm]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [coordinateGraph, coordinateFirst, coordinateSecond, SuzukiTorusMatrix,
      Matrix.map_apply, ho, ht]
  all_goals simp only [pow_add, pow_one, _root_.mul_inv_rev, pow_two]
  all_goals field_simp [pow_ne_zero _ x.ne_zero, x.ne_zero]

/-- Every Suzuki torus generator belongs to the actual fixed-matrix image. -/
theorem torus_mem_fixedMatrixSubgroup (m : ℕ) (x : (SuzukiField m)ˣ) :
    SuzukiTorusGL m x ∈ fixedMatrixSubgroup m := by
  rw [mem_fixedMatrixSubgroup_iff]
  exact ⟨torusMatrix_form m x, torusMatrix_graph m x⟩

/-- The Suzuki Weyl generator belongs to the actual fixed-matrix image. -/
theorem weyl_mem_fixedMatrixSubgroup (m : ℕ) :
    SuzukiWeylGL m ∈ fixedMatrixSubgroup m := by
  rw [mem_fixedMatrixSubgroup_iff]
  constructor
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [SuzukiWeylGL, SuzukiWeylMatrix, suzukiForm, Matrix.mul_apply, Fin.sum_univ_four]
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [SuzukiWeylGL, SuzukiWeylMatrix, coordinateGraph, coordinateFirst, coordinateSecond]

/-- The subgroup generated by the actual Suzuki matrices consists of fixed matrices. -/
theorem suzuki_le_fixedMatrixSubgroup (m : ℕ) :
    SuzukiMatrixSubgroup m ≤ fixedMatrixSubgroup m := by
  apply (Subgroup.closure_le (K := fixedMatrixSubgroup m)).mpr
  rintro A (⟨a,b,rfl⟩ | ⟨x,rfl⟩ | rfl)
  · exact root_mem_fixedMatrixSubgroup m a b
  · exact torus_mem_fixedMatrixSubgroup m x
  · exact weyl_mem_fixedMatrixSubgroup m

end Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.MatrixIdentification
