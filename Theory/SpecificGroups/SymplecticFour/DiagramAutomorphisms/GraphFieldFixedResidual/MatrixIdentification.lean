module

public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.Basic
public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.MatrixIdentification.Generators
public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.MatrixIdentification.ColumnReduction
public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual.MatrixIdentification.LineStabilizer

/-!
# The graph-field fixed group is the concrete Suzuki matrix group

`Coordinates` identifies the genuine fixed subgroup with its GL₄ image.
`Generators` proves that the concrete Suzuki subgroup lies in this image.
For the converse, `ColumnReduction` moves the first column onto the first
coordinate line using a Suzuki matrix, and `LineStabilizer` factors every
fixed matrix stabilizing that line into Suzuki torus and root generators.
Multiplication and cancellation combine these calculations into equality of
the actual subgroups. The resulting `fixedSuzukiEquiv` retains the literal
matrix formula for every parameter, including zero.

This establishes the fixed-group identification underlying source 16.1.4(7).
The subsequent residual calculation and the restriction to the derived carrier
in the binary exception belong to the parent assembly.

Source: Aschbacher--Smith 16.1.4(7) and 16.1.8, printed pp.1171--1173,
and the Suzuki matrix coordinates in Huppert--Blackburn III, XI.3.1--3.3.
-/

@[expose] public noncomputable section
namespace Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual
open MatrixIdentification BenderSuzuki.MatrixGroups

section Assembly
variable (m : ℕ)
variable (hreduce : ∀ A : GL (Fin 4) (SuzukiField m), A ∈ fixedMatrixSubgroup m →
  ∃ B : GL (Fin 4) (SuzukiField m), B ∈ SuzukiMatrixSubgroup m ∧
    (B * A).val 1 0 = 0 ∧ (B * A).val 2 0 = 0 ∧ (B * A).val 3 0 = 0)
variable (hstabilizer : ∀ A : GL (Fin 4) (SuzukiField m), A ∈ fixedMatrixSubgroup m →
  A.val 1 0 = 0 → A.val 2 0 = 0 → A.val 3 0 = 0 → A ∈ SuzukiMatrixSubgroup m)

include hreduce hstabilizer

/-- Column reduction and line-stabilizer reconstruction imply equality of the actual subgroups. -/
theorem fixedMatrixSubgroup_eq_suzuki_of_column_data :
    fixedMatrixSubgroup (F := SuzukiField m) m = SuzukiMatrixSubgroup m := by
  apply le_antisymm _ (suzuki_le_fixedMatrixSubgroup m)
  intro A hA
  obtain ⟨B, hB, h10, h20, h30⟩ := hreduce A hA
  have hBA : B * A ∈ fixedMatrixSubgroup m :=
    (fixedMatrixSubgroup m).mul_mem (suzuki_le_fixedMatrixSubgroup m hB) hA
  have hmem := hstabilizer (B * A) hBA h10 h20 h30
  exact (SuzukiMatrixSubgroup m).mul_mem_cancel_left hB |>.mp hmem

/-- The matrix-compatible equivalence conditional on the two remaining coordinate calculations. -/
def fixedSuzukiEquivOfColumnData :
    (graphFieldAut (F := SuzukiField m) m).fixedSubgroup ≃* SuzukiMatrixGroup m :=
  (fixedCoordinatesEquiv m).trans
    (MulEquiv.subgroupCongr (fixedMatrixSubgroup_eq_suzuki_of_column_data m hreduce hstabilizer))

/-- The conditional construction uses exactly the prescribed coordinate embedding. -/
theorem fixedSuzukiEquivOfColumnData_matrix
    (g : (graphFieldAut (F := SuzukiField m) m).fixedSubgroup) :
    ((fixedSuzukiEquivOfColumnData m hreduce hstabilizer g : GL (Fin 4) (SuzukiField m)) :
        Matrix (Fin 4) (Fin 4) (SuzukiField m)) =
      matrixCoordinates (RingEquiv.refl _) g.val := rfl
end Assembly

/-- The genuine fixed-matrix image is the subgroup generated by the Suzuki
root, torus and Weyl matrices, including at parameter zero. -/
theorem fixedMatrixSubgroup_eq_suzuki (m : ℕ) :
    fixedMatrixSubgroup (F := SuzukiField m) m = SuzukiMatrixSubgroup m :=
  fixedMatrixSubgroup_eq_suzuki_of_column_data m
    (fixed_first_column_reduction m) (fixed_line_stabilizer_mem_suzuki m)

/-- The graph-field fixed subgroup over the standard field is the actual Suzuki
matrix group, with no restriction on the parameter. -/
def fixedSuzukiEquiv (m : ℕ) :
    (graphFieldAut (F := SuzukiField m) m).fixedSubgroup ≃* SuzukiMatrixGroup m :=
  fixedSuzukiEquivOfColumnData m
    (fixed_first_column_reduction m) (fixed_line_stabilizer_mem_suzuki m)

/-- The Suzuki equivalence is precisely the prescribed reindexing of the
underlying symplectic matrix. -/
theorem fixedSuzukiEquiv_matrix (m : ℕ)
    (g : (graphFieldAut (F := SuzukiField m) m).fixedSubgroup) :
    ((fixedSuzukiEquiv m g : GL (Fin 4) (SuzukiField m)) :
        Matrix (Fin 4) (Fin 4) (SuzukiField m)) =
      matrixCoordinates (RingEquiv.refl _) (g : Sp (SuzukiField m)) :=
  fixedSuzukiEquivOfColumnData_matrix m
    (fixed_first_column_reduction m) (fixed_line_stabilizer_mem_suzuki m) g

end Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.GraphFieldFixedResidual
